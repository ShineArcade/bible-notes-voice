{"book": "ROM", "chapter": 8, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 274406, "verses": [{"verse": 1, "start": 300, "end": 6732, "text": "There is therefore now no condemnation to them which are in Christ Jesus, who walk not after the flesh, but after the Spirit.", "words": [[0, 300], [6, 477], [9, 637], [19, 1017], [23, 1297], [26, 1537], [39, 2197], [42, 2397], [47, 2577], [53, 2817], [57, 2957], [60, 3077], [67, 3257], [74, 3937], [78, 4117], [83, 4377], [87, 4617], [93, 4937], [97, 5097], [104, 5657], [108, 5797], [114, 6037], [118, 6197]]}, {"verse": 2, "start": 7182, "end": 12313, "text": "For the law of the Spirit of life in Christ Jesus has made me free from the law of sin and death.", "words": [[0, 7182], [4, 7269], [8, 7389], [12, 7589], [15, 7709], [19, 7849], [26, 8129], [29, 8369], [34, 8609], [37, 8749], [44, 9009], [50, 9449], [54, 9949], [59, 10129], [62, 10289], [67, 10629], [72, 10929], [76, 11069], [80, 11269], [83, 11349], [87, 11689], [91, 12029]]}, {"verse": 3, "start": 12763, "end": 22082, "text": "For what the law could not do, in that it was weak through the flesh, God sending his own Son in the likeness of sinful flesh, and for sin, condemned sin in the flesh:", "words": [[0, 12763], [4, 12885], [9, 13125], [13, 13285], [17, 13465], [23, 13685], [27, 13885], [31, 14545], [34, 14725], [39, 14925], [42, 15045], [46, 15205], [51, 15445], [59, 15665], [63, 15805], [70, 16445], [74, 16605], [82, 16905], [86, 17185], [90, 17425], [94, 17685], [97, 17845], [101, 17945], [110, 18325], [113, 18445], [120, 18765], [127, 19505], [131, 19625], [135, 19785], [140, 20675], [150, 20875], [154, 21075], [157, 21495], [161, 21595]]}, {"verse": 4, "start": 22532, "end": 28563, "text": "That the righteousness of the law might be fulfilled in us, who walk not after the flesh, but after the Spirit.", "words": [[0, 22532], [5, 22650], [9, 22790], [23, 23250], [26, 23590], [30, 23710], [34, 23970], [40, 24250], [43, 24450], [53, 24810], [56, 25130], [60, 25650], [64, 25830], [69, 26050], [73, 26350], [79, 26670], [83, 26830], [90, 27470], [94, 27670], [100, 27930], [104, 28070]]}, {"verse": 5, "start": 29013, "end": 35723, "text": "For they that are after the flesh do mind the things of the flesh; but they that are after the Spirit the things of the Spirit.", "words": [[0, 29013], [4, 29160], [9, 29440], [14, 29700], [18, 29880], [24, 30240], [28, 30460], [34, 30800], [37, 31060], [42, 31400], [46, 31700], [53, 32020], [56, 32300], [60, 32440], [67, 33243], [71, 33344], [76, 33524], [81, 33704], [85, 33844], [91, 34144], [95, 34344], [102, 34784], [106, 34844], [113, 35024], [116, 35184], [120, 35284]]}, {"verse": 6, "start": 36173, "end": 41001, "text": "For to be carnally minded is death; but to be spiritually minded is life and peace.", "words": [[0, 36173], [4, 36268], [7, 36388], [10, 36528], [19, 36988], [26, 37368], [29, 37688], [36, 38342], [40, 38519], [43, 38679], [46, 38779], [58, 39259], [65, 39679], [68, 39959], [73, 40239], [77, 40419]]}, {"verse": 7, "start": 41451, "end": 47537, "text": "Because the carnal mind is enmity against God: for it is not subject to the law of God, neither indeed can be.", "words": [[0, 41451], [8, 41657], [12, 41857], [19, 42197], [24, 42477], [27, 42697], [34, 43057], [42, 43357], [47, 44217], [51, 44326], [54, 44466], [57, 44586], [61, 44766], [69, 45146], [72, 45406], [76, 45506], [80, 45726], [83, 45846], [88, 46326], [96, 46546], [103, 46866], [107, 47146]]}, {"verse": 8, "start": 47987, "end": 50511, "text": "So then they that are in the flesh cannot please God.", "words": [[0, 47987], [3, 48082], [8, 48262], [13, 48442], [18, 48802], [22, 48922], [25, 49062], [29, 49142], [35, 49402], [42, 49702], [49, 50042]]}, {"verse": 9, "start": 50961, "end": 59951, "text": "But you are not in the flesh, but in the Spirit, if so be that the Spirit of God dwell in you. Now if any man have not the Spirit of Christ, he is none of his.", "words": [[0, 50961], [4, 51067], [8, 51167], [12, 51267], [16, 51407], [19, 51567], [23, 51647], [30, 52087], [34, 52227], [37, 52347], [41, 52487], [49, 53107], [52, 53247], [55, 53427], [58, 53587], [63, 54027], [67, 54147], [74, 54407], [77, 54587], [81, 54807], [87, 55107], [90, 55287], [95, 55782], [99, 56019], [102, 56279], [106, 56599], [110, 56939], [115, 57139], [119, 57319], [123, 57519], [130, 57819], [133, 57999], [141, 58859], [144, 58999], [147, 59159], [152, 59359], [155, 59539]]}, {"verse": 10, "start": 60401, "end": 66379, "text": "And if Christ be in you, the body is dead because of sin; but the Spirit is life because of righteousness.", "words": [[0, 60401], [4, 60500], [7, 60620], [14, 60900], [17, 61160], [20, 61320], [25, 61780], [29, 61860], [34, 62180], [37, 62400], [42, 62700], [50, 63100], [53, 63300], [58, 64038], [62, 64138], [66, 64258], [73, 64558], [76, 64758], [81, 65038], [89, 65438], [92, 65638]]}, {"verse": 11, "start": 66829, "end": 75977, "text": "But if the Spirit of him that raised up Jesus from the dead dwell in you, he that raised up Christ from the dead shall also give life to your mortal bodies by his Spirit that dwells in you.", "words": [[0, 66829], [4, 66911], [7, 67011], [11, 67131], [18, 67411], [21, 67571], [25, 67731], [30, 67931], [37, 68211], [40, 68371], [46, 68611], [51, 68871], [55, 69011], [60, 69231], [66, 69471], [69, 69671], [74, 70317], [77, 70474], [82, 70694], [89, 70954], [92, 71174], [99, 71434], [104, 71674], [108, 71814], [113, 72054], [119, 72254], [124, 72614], [129, 72834], [134, 73114], [137, 73334], [142, 73434], [149, 73694], [156, 74074], [159, 74294], [163, 74474], [170, 74814], [175, 75034], [182, 75454], [185, 75554]]}, {"verse": 12, "start": 76427, "end": 80913, "text": "Therefore, brethren, we are debtors, not to the flesh, to live after the flesh.", "words": [[0, 76427], [11, 76966], [21, 77786], [24, 77886], [28, 78006], [37, 78626], [41, 78886], [44, 79086], [48, 79186], [55, 79666], [58, 79746], [63, 80006], [69, 80326], [73, 80486]]}, {"verse": 13, "start": 81363, "end": 88581, "text": "For if you live after the flesh, you shall die: but if you through the Spirit do mortify the deeds of the body, you shall live.", "words": [[0, 81363], [4, 81469], [7, 81689], [11, 81849], [16, 82029], [22, 82329], [26, 82509], [33, 83089], [37, 83249], [43, 83449], [48, 84098], [52, 84217], [55, 84337], [59, 84877], [67, 85037], [71, 85197], [78, 85757], [81, 85857], [89, 86397], [93, 86537], [99, 86797], [102, 86997], [106, 87097], [112, 87757], [116, 87837], [122, 88097]]}, {"verse": 14, "start": 89031, "end": 93001, "text": "For as many as are led by the Spirit of God, they are the sons of God.", "words": [[0, 89031], [4, 89141], [7, 89281], [12, 89601], [15, 89801], [19, 89941], [23, 90141], [26, 90341], [30, 90521], [37, 90841], [40, 91001], [45, 91641], [50, 91801], [54, 91941], [58, 92061], [63, 92361], [66, 92561]]}, {"verse": 15, "start": 93451, "end": 100827, "text": "For you have not received the spirit of bondage again to fear; but you have received the Spirit of adoption, by which we cry, Abba, Father.", "words": [[0, 93451], [4, 93556], [8, 93676], [13, 93836], [17, 93976], [26, 94376], [30, 94576], [37, 94836], [40, 95056], [48, 95516], [54, 95776], [57, 95956], [63, 96689], [67, 96872], [71, 96992], [76, 97132], [85, 97512], [89, 97732], [96, 97952], [99, 98152], [109, 98632], [112, 98972], [118, 99172], [121, 99332], [126, 99892], [132, 100372]]}, {"verse": 16, "start": 101277, "end": 105364, "text": "The Spirit itself bears witness with our spirit, that we are the children of God:", "words": [[0, 101277], [4, 101396], [11, 101676], [18, 102016], [24, 102356], [32, 102716], [37, 102976], [41, 103156], [49, 103516], [54, 103996], [57, 104176], [61, 104296], [65, 104416], [74, 104756], [77, 104976]]}, {"verse": 17, "start": 105814, "end": 114055, "text": "And if children, then heirs; heirs of God, and joint-heirs with Christ; if so be that we suffer with him, that we may be also glorified together.", "words": [[0, 105814], [4, 105915], [7, 106015], [17, 106375], [22, 106920], [29, 107832], [35, 108002], [38, 108182], [43, 108462], [47, 108962], [59, 109462], [64, 109682], [72, 110528], [75, 110655], [78, 110895], [81, 110955], [86, 111095], [89, 111195], [96, 111455], [101, 111715], [106, 112075], [111, 112235], [114, 112355], [118, 112495], [121, 112615], [126, 112955], [136, 113515]]}, {"verse": 18, "start": 114505, "end": 120119, "text": "For I reckon that the sufferings of this present time are not worthy to be compared with the glory which shall be revealed in us.", "words": [[0, 114505], [4, 114629], [6, 114749], [13, 115009], [18, 115209], [22, 115309], [33, 115789], [36, 115909], [41, 116049], [49, 116349], [54, 116629], [58, 116809], [62, 117009], [69, 117329], [72, 117529], [75, 117649], [84, 118029], [89, 118209], [93, 118329], [99, 118649], [105, 118849], [111, 119089], [114, 119229], [123, 119589], [126, 119769]]}, {"verse": 19, "start": 120569, "end": 124949, "text": "For the earnest expectation of the creature waits for the manifestation of the sons of God.", "words": [[0, 120569], [4, 120679], [8, 120799], [16, 121079], [28, 121679], [31, 121999], [35, 122119], [44, 122419], [50, 122759], [54, 122939], [58, 123119], [72, 123659], [75, 123979], [79, 124079], [84, 124339], [87, 124519]]}, {"verse": 20, "start": 125399, "end": 131705, "text": "For the creature was made subject to vanity, not willingly, but by reason of him who has subjected the same in hope,", "words": [[0, 125399], [4, 125483], [8, 125603], [17, 125923], [21, 126163], [26, 126363], [34, 126743], [37, 127023], [45, 127683], [49, 127923], [60, 128803], [64, 128983], [67, 129163], [74, 129503], [77, 129703], [81, 129883], [85, 130033], [89, 130183], [99, 130623], [103, 130923], [108, 131163], [111, 131323]]}, {"verse": 21, "start": 132155, "end": 138600, "text": "Because the creature itself also shall be delivered from the bondage of corruption into the glorious liberty of the children of God.", "words": [[0, 132155], [8, 132357], [12, 132557], [21, 132897], [28, 133297], [33, 133717], [39, 133957], [42, 134077], [52, 134417], [57, 134657], [61, 134797], [69, 135197], [72, 135297], [83, 135737], [88, 136137], [92, 136337], [101, 136697], [109, 137117], [112, 137477], [116, 137597], [125, 137977], [128, 138217]]}, {"verse": 22, "start": 139050, "end": 143393, "text": "For we know that the whole creation groans and travails in pain together until now.", "words": [[0, 139050], [4, 139155], [7, 139295], [12, 139475], [17, 139695], [21, 139835], [27, 140035], [36, 140435], [43, 140935], [47, 141215], [56, 141755], [59, 141935], [64, 142155], [73, 142515], [79, 142895]]}, {"verse": 23, "start": 143843, "end": 154969, "text": "And not only they, but ourselves also, which have the firstfruits of the Spirit, even we ourselves groan within ourselves, waiting for the adoption, that is, the redemption of our body.", "words": [[0, 143843], [4, 143941], [8, 144141], [13, 144361], [19, 145021], [23, 145181], [33, 145641], [39, 146521], [45, 146721], [50, 146901], [54, 147231], [66, 147561], [69, 147721], [73, 147841], [81, 148541], [86, 148801], [89, 149061], [99, 149571], [105, 150081], [112, 150421], [123, 151001], [131, 151581], [135, 151821], [139, 151941], [149, 152781], [154, 152921], [158, 153613], [162, 153690], [173, 154090], [176, 154390], [180, 154530]]}, {"verse": 24, "start": 155419, "end": 161673, "text": "For we are saved by hope: but hope that is seen is not hope: for what a man sees, why does he yet hope for?", "words": [[0, 155419], [4, 155526], [7, 155666], [11, 155766], [17, 156106], [20, 156326], [26, 157012], [30, 157111], [35, 157271], [40, 157471], [43, 157591], [48, 157891], [51, 158131], [55, 158311], [61, 159141], [65, 159226], [70, 159386], [72, 159466], [76, 159626], [82, 160306], [86, 160566], [91, 160766], [94, 160926], [98, 161066], [103, 161266]]}, {"verse": 25, "start": 162123, "end": 166033, "text": "But if we hope for that we see not, then do we with patience wait for it.", "words": [[0, 162123], [4, 162258], [7, 162378], [10, 162498], [15, 162678], [19, 162838], [24, 163058], [27, 163258], [31, 163478], [36, 164238], [41, 164398], [44, 164598], [47, 164698], [52, 164838], [61, 165258], [66, 165598], [70, 165858]]}, {"verse": 26, "start": 166483, "end": 177015, "text": "Likewise the Spirit also helps our infirmities: for we know not what we should pray for as we ought: but the Spirit itself makes intercession for us with groanings which cannot be uttered.", "words": [[0, 166483], [9, 167062], [13, 167122], [20, 167442], [25, 167842], [31, 168162], [35, 168342], [48, 169340], [52, 169464], [55, 169624], [60, 169844], [64, 170184], [69, 170504], [72, 170684], [79, 170864], [84, 171144], [88, 171464], [91, 171684], [94, 171864], [101, 172665], [105, 172805], [109, 172965], [116, 173245], [123, 173685], [129, 174025], [142, 174725], [146, 175025], [149, 175285], [154, 175485], [164, 175965], [170, 176125], [177, 176405], [180, 176645]]}, {"verse": 27, "start": 177465, "end": 184631, "text": "And he that searches the hearts knows what is the mind of the Spirit, because he makes intercession for the saints according to the will of God.", "words": [[0, 177465], [4, 177628], [7, 177808], [12, 177988], [21, 178328], [25, 178588], [32, 178848], [38, 179228], [43, 179608], [46, 179728], [50, 179868], [55, 180168], [58, 180328], [62, 180428], [70, 180808], [78, 181388], [81, 181548], [87, 181728], [100, 182448], [104, 182708], [108, 182828], [115, 183108], [125, 183508], [128, 183748], [132, 183868], [137, 184048], [140, 184168]]}, {"verse": 28, "start": 185081, "end": 191558, "text": "And we know that all things work together for good to them that love God, to them who are the called according to his purpose.", "words": [[0, 185081], [4, 185227], [7, 185387], [12, 185627], [17, 185867], [21, 186147], [28, 186487], [33, 186787], [42, 187207], [46, 187427], [51, 187627], [54, 187807], [59, 188007], [64, 188207], [69, 188487], [74, 189187], [77, 189307], [82, 189467], [86, 189667], [90, 189827], [94, 190007], [101, 190187], [111, 190427], [114, 190827], [118, 190947]]}, {"verse": 29, "start": 192008, "end": 199893, "text": "For whom he did foreknow, he also did predestinate to be conformed to the image of his Son, that he might be the firstborn among many brethren.", "words": [[0, 192008], [4, 192107], [9, 192347], [12, 192487], [16, 192877], [26, 193267], [29, 193447], [34, 193867], [38, 194207], [51, 195007], [54, 195207], [57, 195327], [67, 196007], [70, 196087], [74, 196207], [80, 196507], [83, 196667], [87, 196787], [92, 197067], [97, 197487], [100, 197627], [106, 197827], [109, 198047], [113, 198187], [123, 198707], [129, 198987], [134, 199347]]}, {"verse": 30, "start": 200343, "end": 209862, "text": "Moreover whom he did predestinate, them he also called: and whom he called, them he also justified: and whom he justified, them he also glorified.", "words": [[0, 200343], [9, 200837], [14, 201117], [17, 201317], [21, 201557], [35, 202167], [40, 202777], [43, 202957], [48, 203257], [56, 204050], [60, 204171], [65, 204351], [68, 204511], [76, 204871], [81, 205311], [84, 205511], [89, 205831], [100, 206942], [104, 207087], [109, 207307], [112, 207467], [123, 208027], [128, 208587], [131, 208767], [136, 209087]]}, {"verse": 31, "start": 210312, "end": 215241, "text": "What shall we then say to these things? If God be for us, who can be against us?", "words": [[0, 210312], [5, 210490], [11, 210770], [14, 210950], [19, 211190], [23, 211510], [26, 211710], [32, 211930], [40, 212806], [43, 212941], [47, 213101], [50, 213301], [54, 213481], [58, 214041], [62, 214181], [66, 214341], [69, 214461], [77, 214781]]}, {"verse": 32, "start": 215691, "end": 222719, "text": "He that spared not his own Son, but delivered him up for us all, how shall he not with him also freely give us all things?", "words": [[0, 215745], [3, 215835], [8, 216035], [15, 216355], [19, 216575], [23, 216715], [27, 216855], [32, 217715], [36, 217875], [46, 218235], [50, 218475], [53, 218635], [57, 218835], [60, 219015], [65, 219675], [69, 219835], [75, 220055], [78, 220215], [82, 220435], [87, 220675], [91, 220855], [96, 221175], [103, 221575], [108, 221815], [111, 221955], [115, 222135]]}, {"verse": 33, "start": 223169, "end": 228066, "text": "Who shall lay any thing to the charge of God’s elect? It is God that justifies.", "words": [[0, 223169], [4, 223293], [10, 223513], [14, 223726], [18, 223940], [24, 224153], [27, 224593], [31, 224713], [38, 225093], [41, 225253], [47, 225653], [54, 226387], [57, 226507], [60, 226647], [64, 226927], [69, 227167]]}, {"verse": 34, "start": 228516, "end": 237849, "text": "Who is he that condemns? It is Christ that died, yes rather, that is risen again, who is even at the right hand of God, who also makes intercession for us.", "words": [[0, 228516], [4, 228622], [7, 228782], [10, 229042], [15, 229262], [25, 230275], [28, 230399], [31, 230559], [38, 230859], [43, 231159], [49, 231799], [53, 232079], [61, 232599], [66, 232759], [69, 232919], [75, 233179], [82, 233959], [86, 234099], [89, 234259], [94, 234559], [97, 234739], [101, 234859], [107, 235059], [112, 235219], [115, 235379], [120, 235859], [124, 235959], [129, 236279], [135, 236479], [148, 237159], [152, 237419]]}, {"verse": 35, "start": 238299, "end": 246766, "text": "Who shall separate us from the love of Christ? shall tribulation, or distress, or persecution, or famine, or nakedness, or peril, or sword?", "words": [[0, 238299], [4, 238443], [10, 238683], [19, 239123], [22, 239403], [27, 239603], [31, 239743], [36, 239963], [39, 240103], [47, 240998], [53, 241180], [66, 241800], [69, 241980], [79, 242360], [82, 242720], [95, 243220], [98, 243600], [106, 243940], [109, 244220], [120, 244820], [123, 245020], [130, 245320], [133, 245560]]}, {"verse": 36, "start": 247216, "end": 252806, "text": "As it is written, For your sake we are killed all the day long; we are accounted as sheep for the slaughter.", "words": [[0, 247216], [3, 247378], [6, 247498], [9, 247598], [18, 248238], [22, 248338], [27, 248498], [32, 248818], [35, 248998], [39, 249118], [46, 249438], [50, 249838], [54, 250018], [58, 250238], [64, 250983], [67, 251107], [71, 251337], [81, 251567], [84, 251767], [90, 252007], [94, 252227], [98, 252327]]}, {"verse": 37, "start": 253256, "end": 257677, "text": "No, in all these things we are more than conquerors through him that loved us.", "words": [[0, 253345], [4, 253435], [7, 253675], [11, 254035], [17, 254315], [24, 254715], [27, 255015], [31, 255175], [36, 255455], [41, 255695], [52, 256375], [60, 256555], [64, 256815], [69, 257035], [75, 257255]]}, {"verse": 38, "start": 258127, "end": 266643, "text": "For I am persuaded, that neither death, nor life, nor angels, nor principalities, nor powers, nor things present, nor things to come,", "words": [[0, 258127], [4, 258338], [6, 258658], [9, 258758], [20, 259158], [25, 259578], [33, 259878], [40, 260338], [44, 260698], [50, 261158], [54, 261438], [62, 261938], [66, 262418], [82, 263198], [86, 263618], [94, 264098], [98, 264518], [105, 264798], [114, 265298], [118, 265698], [125, 265978], [128, 266198]]}, {"verse": 39, "start": 267093, "end": 274005, "text": "Nor height, nor depth, nor any other creature, shall be able to separate us from the love of God, which is in Christ Jesus our Lord.", "words": [[0, 267093], [4, 267332], [12, 267692], [16, 268012], [23, 268432], [27, 268872], [31, 269212], [37, 269432], [47, 269732], [53, 270012], [56, 270172], [61, 270332], [64, 270512], [73, 270892], [76, 271152], [81, 271332], [85, 271452], [90, 271652], [93, 271752], [98, 272012], [104, 272512], [107, 272632], [110, 272752], [117, 272992], [123, 273352], [127, 273652]]}]}