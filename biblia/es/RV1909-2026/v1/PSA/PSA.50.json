{"book": "PSA", "chapter": 50, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 138989, "verses": [{"verse": 1, "start": 300, "end": 9635, "text": "Salmo de Asaf. EL Dios de dioses, Jehová, ha hablado, y convocado la tierra desde el nacimiento del sol hasta donde se pone.", "words": [[0, 300], [6, 752], [9, 912], [15, 1591], [18, 1778], [23, 2018], [26, 2425], [34, 2831], [42, 3238], [45, 3418], [54, 4118], [56, 4438], [66, 5158], [69, 5358], [76, 5818], [82, 6438], [85, 6778], [96, 7458], [100, 7678], [104, 8078], [110, 8618], [116, 8898], [119, 9138]]}, {"verse": 2, "start": 9985, "end": 14579, "text": "De Sion, perfección de hermosura, ha Dios resplandecido.", "words": [[0, 10266], [3, 10580], [9, 10893], [20, 11513], [23, 11693], [34, 12425], [37, 13156], [42, 13888]]}, {"verse": 3, "start": 14929, "end": 22927, "text": "Vendrá nuestro Dios, y no callará: fuego consumirá delante de él, y en derredor suyo habrá tempestad grande.", "words": [[0, 14929], [7, 15373], [15, 15613], [21, 16033], [23, 16333], [26, 16493], [35, 17450], [41, 17825], [51, 18685], [59, 19125], [62, 19305], [66, 19565], [68, 19885], [71, 20025], [80, 20565], [85, 21105], [91, 21465], [101, 22105]]}, {"verse": 4, "start": 23277, "end": 28040, "text": "Convocará a los cielos de arriba, y a la tierra, para juzgar a su pueblo.", "words": [[0, 23277], [10, 24003], [12, 24163], [16, 24303], [23, 24763], [26, 24883], [34, 25223], [36, 25463], [38, 25543], [41, 25603], [49, 26063], [54, 26643], [61, 27183], [63, 27283], [66, 27443]]}, {"verse": 5, "start": 28260, "end": 33216, "text": "Juntadme mis santos; los que hicieron conmigo pacto con sacrificio.", "words": [[0, 28507], [9, 28797], [13, 28937], [21, 30099], [25, 30216], [29, 30376], [38, 30756], [46, 31236], [52, 31816], [56, 32096]]}, {"verse": 6, "start": 33496, "end": 38307, "text": "Y declararán los cielos su justicia; porque Dios es el juez. (Selah.)", "words": [[0, 33496], [2, 33888], [13, 34318], [17, 34538], [24, 35018], [27, 35178], [37, 36159], [44, 36343], [49, 36623], [52, 36843], [55, 37003], [61, 38073]]}, {"verse": 7, "start": 38527, "end": 46404, "text": "Oye, pueblo mío, y hablaré: escucha, Israel, y testificaré contra ti: yo soy Dios, el Dios tuyo.", "words": [[0, 38527], [5, 38792], [12, 38972], [17, 39592], [19, 39812], [28, 40847], [37, 41444], [45, 41884], [47, 42244], [59, 43004], [66, 43244], [70, 44155], [73, 44317], [77, 44517], [83, 45157], [86, 45277], [91, 45477]]}, {"verse": 8, "start": 46754, "end": 52488, "text": "No te reprenderé sobre tus sacrificios, ni por tus holocaustos, que delante de mí están siempre.", "words": [[0, 46754], [3, 46878], [6, 47018], [17, 47638], [23, 47798], [27, 48018], [40, 49058], [43, 49218], [47, 49438], [51, 49598], [64, 50418], [68, 50578], [76, 50998], [79, 51138], [82, 51298], [88, 51558]]}, {"verse": 9, "start": 52838, "end": 57564, "text": "No tomaré de tu casa becerros, ni machos cabríos de tus apriscos.", "words": [[0, 52838], [3, 53021], [10, 53561], [13, 53701], [16, 53821], [21, 54081], [31, 54981], [34, 55381], [41, 55861], [49, 56441], [52, 56561], [56, 56681]]}, {"verse": 10, "start": 57914, "end": 62702, "text": "Porque mía es toda bestia del bosque, y los millares de animales en los collados.", "words": [[0, 57914], [7, 58118], [11, 58558], [14, 58778], [19, 58918], [26, 59478], [30, 59618], [38, 60138], [40, 60378], [44, 60518], [53, 60998], [56, 61158], [65, 61538], [68, 61798], [72, 61898]]}, {"verse": 11, "start": 63052, "end": 68294, "text": "Conozco todas las aves de los montes, y en mi poder están las fieras del campo.", "words": [[0, 63052], [8, 63553], [14, 63753], [18, 64033], [23, 64373], [26, 64473], [30, 64593], [38, 65413], [40, 65573], [43, 65713], [46, 65833], [52, 66253], [58, 66673], [62, 66913], [69, 67353], [73, 67493]]}, {"verse": 12, "start": 68644, "end": 74556, "text": "Si yo tuviese hambre, no te lo diría a ti: porque mío es el mundo y su plenitud.", "words": [[0, 68644], [3, 68844], [6, 69004], [14, 69364], [22, 70064], [25, 70184], [28, 70304], [31, 70424], [37, 70884], [39, 70964], [43, 71660], [50, 71822], [54, 72382], [57, 72662], [60, 72862], [66, 73222], [68, 73502], [71, 73622]]}, {"verse": 13, "start": 74906, "end": 79539, "text": "¿He de comer yo carne de toros, o de beber sangre de machos cabríos?", "words": [[0, 74906], [4, 75046], [7, 75186], [13, 75446], [16, 75766], [22, 76166], [25, 76346], [32, 76846], [34, 77206], [37, 77366], [43, 77626], [50, 78126], [53, 78326], [60, 78791]]}, {"verse": 14, "start": 79889, "end": 83975, "text": "Sacrifica a Dios alabanza, y paga tus votos al Altísimo.", "words": [[0, 79889], [10, 80538], [12, 80658], [17, 81098], [27, 81538], [29, 81898], [34, 82238], [38, 82438], [44, 82898], [47, 82998]]}, {"verse": 15, "start": 84325, "end": 89361, "text": "E invócame en el día de la angustia: te libraré, y tú me honrarás.", "words": [[0, 84325], [2, 84457], [11, 84977], [14, 85337], [17, 85457], [21, 85677], [24, 85817], [27, 85917], [37, 87053], [40, 87110], [49, 87610], [51, 88050], [54, 88230], [57, 88680]]}, {"verse": 16, "start": 89641, "end": 95820, "text": "Pero al malo dijo Dios: ¿Qué tienes tú que declarar mis leyes, y que tomar mi pacto en tu boca,", "words": [[0, 89641], [5, 89805], [8, 90025], [13, 90425], [18, 90665], [24, 91561], [29, 91676], [36, 92036], [39, 92316], [43, 92476], [52, 92996], [56, 93096], [63, 93556], [65, 93761], [69, 93861], [75, 94141], [78, 94341], [84, 94761], [87, 94841], [90, 94961]]}, {"verse": 17, "start": 96170, "end": 100173, "text": "Pues que tú aborreces el castigo, y echas a tu espalda mis palabras?", "words": [[0, 96170], [5, 96279], [9, 96399], [12, 96539], [22, 97039], [25, 97219], [34, 97859], [36, 98239], [42, 98499], [44, 98599], [47, 98679], [55, 99099], [59, 99219]]}, {"verse": 18, "start": 100523, "end": 105972, "text": "Si veías al ladrón, tú corrías con él; y con los adúlteros era tu parte.", "words": [[0, 100523], [3, 100732], [9, 101152], [12, 101372], [20, 101992], [23, 102092], [31, 102532], [35, 102752], [39, 103557], [41, 103677], [45, 103837], [49, 104157], [59, 104477], [63, 104937], [66, 105117]]}, {"verse": 19, "start": 106322, "end": 109979, "text": "Tu boca metías en mal, y tu lengua componía engaño.", "words": [[0, 106322], [3, 106401], [8, 106681], [15, 107121], [18, 107301], [23, 107621], [25, 107921], [28, 108061], [35, 108481], [44, 109061]]}, {"verse": 20, "start": 110329, "end": 116446, "text": "Tomabas asiento, y hablabas contra tu hermano; contra el hijo de tu madre ponías infamia.", "words": [[0, 110329], [8, 110746], [17, 111286], [19, 111766], [28, 112206], [35, 112466], [38, 112686], [47, 113696], [54, 113953], [57, 114113], [62, 114293], [65, 114433], [68, 114553], [74, 115103], [81, 115653]]}, {"verse": 21, "start": 116796, "end": 125647, "text": "Estas cosas hiciste, y yo he callado: pensabas que de cierto sería yo como tú: yo te reprenderé, y las pondré delante de tus ojos.", "words": [[0, 116796], [6, 117186], [12, 117466], [21, 118126], [23, 118306], [26, 118446], [29, 118546], [38, 119554], [47, 120051], [51, 120171], [54, 120351], [61, 120651], [67, 121091], [70, 121351], [75, 121591], [79, 122441], [82, 122603], [85, 122743], [97, 123443], [99, 123703], [103, 123843], [110, 124243], [118, 124623], [121, 124763], [125, 124883]]}, {"verse": 22, "start": 125997, "end": 131669, "text": "Entended ahora esto, los que os olvidáis de Dios; no sea que arrebate, sin que nadie libre.", "words": [[0, 125997], [9, 126479], [15, 126739], [21, 127099], [25, 127339], [29, 127519], [32, 127619], [41, 128079], [44, 128219], [50, 129192], [53, 129331], [57, 129531], [61, 129711], [71, 130251], [75, 130491], [79, 130651], [85, 130851]]}, {"verse": 23, "start": 132019, "end": 138589, "text": "El que sacrifica alabanza me honrará: y al que ordene su camino, le mostraré la salvación de Dios.", "words": [[0, 132019], [3, 132137], [7, 132237], [17, 132857], [26, 133477], [29, 133557], [38, 134772], [40, 134851], [43, 134951], [47, 135051], [54, 135431], [57, 135551], [65, 136011], [68, 136236], [77, 136856], [80, 137156], [90, 137696], [93, 137836]]}]}