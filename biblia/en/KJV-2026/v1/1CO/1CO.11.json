{"book": "1CO", "chapter": 11, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 205309, "verses": [{"verse": 1, "start": 300, "end": 3340, "text": "Be followers of me, even as I also am of Christ.", "words": [[0, 300], [3, 460], [13, 720], [16, 1100], [20, 1600], [25, 1800], [28, 2040], [30, 2180], [35, 2460], [38, 2720], [41, 2840]]}, {"verse": 2, "start": 3790, "end": 9614, "text": "Now I praise you, brethren, that you remember me in all things, and keep the ordinances, as I delivered them to you.", "words": [[0, 3790], [4, 3967], [6, 4167], [13, 4507], [18, 4707], [28, 5347], [33, 5447], [37, 5567], [46, 5887], [49, 6147], [52, 6287], [56, 6387], [64, 7007], [68, 7127], [73, 7327], [77, 7507], [89, 8047], [92, 8407], [94, 8617], [104, 8827], [109, 9147], [112, 9367]]}, {"verse": 3, "start": 10064, "end": 16931, "text": "But I would have you know, that the head of every man is Christ; and the head of the woman is the man; and the head of Christ is God.", "words": [[0, 10064], [4, 10162], [6, 10242], [12, 10402], [17, 10582], [21, 10762], [27, 10982], [32, 11442], [36, 11602], [41, 11782], [44, 11922], [50, 12202], [54, 12482], [57, 12662], [65, 13573], [69, 13694], [73, 13834], [78, 13994], [81, 14094], [85, 14214], [91, 14434], [94, 14614], [98, 14734], [103, 15450], [107, 15555], [111, 15675], [116, 15795], [119, 15895], [126, 16215], [129, 16435]]}, {"verse": 4, "start": 17381, "end": 21309, "text": "Every man praying or prophesying, having his head covered, dishonours his head.", "words": [[0, 17381], [6, 17717], [10, 18057], [18, 18437], [21, 18637], [34, 19317], [41, 19537], [45, 19757], [50, 19917], [59, 20377], [70, 20837], [74, 20957]]}, {"verse": 5, "start": 21759, "end": 28730, "text": "But every woman that prays or prophesies with her head uncovered dishonours her head: for that is even all one as if she were shaven.", "words": [[0, 21759], [4, 21856], [10, 22136], [16, 22416], [21, 22596], [27, 23016], [30, 23306], [41, 23596], [46, 23796], [50, 23936], [55, 24176], [65, 24556], [76, 25236], [80, 25356], [86, 25994], [90, 26098], [95, 26298], [98, 26478], [103, 26778], [107, 27078], [111, 27398], [114, 27718], [117, 27858], [121, 28168], [126, 28478]]}, {"verse": 6, "start": 29180, "end": 36847, "text": "For if the woman be not covered, let her also be shorn: but if it be a shame for a woman to be shorn or shaven, let her be covered.", "words": [[0, 29180], [4, 29279], [7, 29399], [11, 29519], [17, 29739], [20, 29939], [24, 30059], [33, 30799], [37, 30939], [41, 31119], [46, 31359], [49, 31539], [56, 32341], [60, 32437], [63, 32537], [66, 32657], [69, 32857], [71, 33037], [77, 33417], [81, 33757], [83, 33877], [89, 34057], [92, 34257], [95, 34357], [101, 34777], [104, 34977], [112, 35757], [116, 35937], [120, 36157], [123, 36337]]}, {"verse": 7, "start": 37297, "end": 44403, "text": "For a man indeed ought not to cover his head, since he is the image and glory of God: but the woman is the glory of the man.", "words": [[0, 37297], [4, 37422], [6, 37542], [10, 37822], [17, 38302], [23, 38622], [27, 38862], [30, 39062], [36, 39282], [40, 39482], [46, 39922], [52, 40282], [55, 40522], [58, 40642], [62, 40802], [68, 41082], [72, 41342], [78, 41622], [81, 41862], [86, 42607], [90, 42711], [94, 42831], [100, 43071], [103, 43251], [107, 43391], [113, 43711], [116, 43891], [120, 43991]]}, {"verse": 8, "start": 44853, "end": 47961, "text": "For the man is not of the woman; but the woman of the man.", "words": [[0, 44853], [4, 44937], [8, 45057], [12, 45277], [15, 45417], [19, 45597], [22, 45877], [26, 45997], [33, 46729], [37, 46872], [41, 47012], [47, 47252], [50, 47472], [54, 47592]]}, {"verse": 9, "start": 48411, "end": 51848, "text": "Neither was the man created for the woman; but the woman for the man.", "words": [[0, 48411], [8, 48592], [12, 48832], [16, 49012], [20, 49192], [28, 49652], [32, 49932], [36, 50052], [43, 50715], [47, 50833], [51, 50953], [57, 51173], [61, 51393], [65, 51513]]}, {"verse": 10, "start": 52298, "end": 56345, "text": "For this cause ought the woman to have power on her head because of the angels.", "words": [[0, 52298], [4, 52419], [9, 52699], [15, 52999], [21, 53419], [25, 53559], [31, 53819], [34, 54039], [39, 54239], [45, 54579], [48, 54779], [52, 54959], [57, 55219], [65, 55479], [68, 55699], [72, 55799]]}, {"verse": 11, "start": 56795, "end": 61480, "text": "Nevertheless neither is the man without the woman, neither the woman without the man, in the Lord.", "words": [[0, 56795], [13, 57432], [21, 57692], [24, 57912], [28, 58072], [32, 58312], [40, 58552], [44, 58752], [51, 59272], [59, 59552], [63, 59792], [69, 60032], [77, 60292], [81, 60512], [86, 60772], [89, 61012], [93, 61112]]}, {"verse": 12, "start": 61930, "end": 67140, "text": "For as the woman is of the man, even so is the man also by the woman; but all things of God.", "words": [[0, 61930], [4, 62054], [7, 62194], [11, 62334], [17, 62534], [20, 62734], [23, 62854], [27, 62974], [32, 63754], [37, 63954], [40, 64234], [43, 64394], [47, 64514], [51, 64714], [56, 65014], [59, 65234], [63, 65354], [70, 66024], [74, 66170], [78, 66310], [85, 66550], [88, 66730]]}, {"verse": 13, "start": 67590, "end": 71523, "text": "Judge in yourselves: is it comely that a woman pray to God uncovered?", "words": [[0, 67590], [6, 67810], [9, 68050], [21, 69144], [24, 69251], [27, 69471], [34, 69691], [39, 69951], [41, 70051], [47, 70301], [52, 70551], [55, 70711], [59, 70931]]}, {"verse": 14, "start": 71973, "end": 76790, "text": "Does not even nature itself teach you, that, if a man have long hair, it is a shame to him?", "words": [[0, 71973], [5, 72093], [9, 72293], [14, 72413], [21, 72773], [28, 73113], [34, 73413], [39, 73633], [45, 74133], [48, 74473], [50, 74593], [54, 74793], [59, 74933], [64, 75153], [70, 75473], [73, 75833], [76, 75953], [78, 76053], [84, 76293], [87, 76473]]}, {"verse": 15, "start": 77240, "end": 82097, "text": "But if a woman have long hair, it is 