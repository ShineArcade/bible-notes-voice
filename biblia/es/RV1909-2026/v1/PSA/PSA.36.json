{"book": "PSA", "chapter": 36, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 85411, "verses": [{"verse": 1, "start": 300, "end": 11379, "text": "Al Músico principal: Salmo de David, siervo del Señor. LA iniquidad del impío me dice al corazón: No hay temor de Dios delante de sus ojos.", "words": [[0, 300], [3, 489], [10, 949], [21, 2047], [27, 2492], [30, 2652], [37, 3432], [44, 3892], [48, 4072], [55, 5006], [58, 5105], [68, 5785], [72, 5985], [78, 6645], [81, 6805], [86, 7125], [89, 7305], [98, 8389], [101, 8694], [105, 8834], [111, 9174], [114, 9314], [119, 9654], [127, 10314], [130, 10474], [134, 10634]]}, {"verse": 2, "start": 11729, "end": 19320, "text": "Se lisonjea, por tanto, en sus propios ojos, hasta que su iniquidad sea hallada aborrecible.", "words": [[0, 11729], [3, 12203], [13, 12713], [17, 12853], [24, 13313], [27, 13613], [31, 13813], [39, 14413], [45, 15333], [51, 15613], [55, 15793], [58, 16363], [68, 16933], [72, 17593], [80, 18153]]}, {"verse": 3, "start": 19670, "end": 25637, "text": "Las palabras de su boca son iniquidad y fraude; no quiso entender para bien hacer.", "words": [[0, 19670], [4, 19779], [13, 20139], [16, 20379], [19, 20539], [24, 20839], [28, 21099], [38, 21919], [40, 22119], [48, 23053], [51, 23183], [57, 23563], [66, 24243], [71, 24643], [76, 24903]]}, {"verse": 4, "start": 25987, "end": 32055, "text": "Iniquidad piensa sobre su cama; está en camino no bueno, el mal no aborrece.", "words": [[0, 25987], [10, 26673], [17, 27213], [23, 27513], [26, 27733], [32, 28516], [37, 28704], [40, 28844], [47, 29184], [50, 29444], [57, 30224], [60, 30364], [64, 30624], [67, 31368]]}, {"verse": 5, "start": 32405, "end": 37265, "text": "Jehová, hasta los cielos es tu misericordia; tu verdad hasta las nubes.", "words": [[0, 32405], [8, 32905], [14, 33145], [18, 33345], [25, 33945], [28, 34225], [31, 34305], [45, 35597], [48, 35682], [55, 36002], [61, 36442], [65, 36622]]}, {"verse": 6, "start": 37615, "end": 45451, "text": "Tu justicia como los montes de Dios, tus juicios abismo grande: oh Jehová, al hombre y al animal conservas.", "words": [[0, 37615], [3, 37699], [12, 38379], [17, 38619], [21, 38799], [28, 39239], [31, 39359], [37, 39834], [41, 40309], [49, 40784], [56, 41259], [64, 42413], [67, 42633], [75, 42853], [78, 43253], [85, 43573], [87, 44033], [90, 44153], [97, 44433]]}, {"verse": 7, "start": 45801, "end": 54052, "text": "¡Cuán preciosa, oh Dios, es tu misericordia! Por eso los hijos de los hombres se amparan bajo la sombra de tus alas.", "words": [[0, 45801], [6, 46105], [16, 46585], [19, 47065], [25, 47305], [28, 47685], [31, 47765], [45, 49108], [49, 49232], [53, 49452], [57, 49692], [63, 49992], [66, 50172], [70, 50272], [78, 50672], [81, 51172], [89, 51912], [94, 52113], [97, 52332], [104, 52872], [107, 53032], [111, 53272]]}, {"verse": 8, "start": 54402, "end": 61178, "text": "Se embriagarán de la grasa de tu casa; y tú los abrevarás del torrente de tus delicias.", "words": [[0, 54402], [3, 54586], [15, 55406], [18, 55526], [21, 55646], [27, 56046], [30, 56186], [33, 56326], [39, 57174], [41, 57246], [44, 57566], [48, 57986], [58, 58806], [62, 59046], [71, 59686], [74, 59946], [78, 60206]]}, {"verse": 9, "start": 61528, "end": 66416, "text": "Porque contigo está el manantial de la vida: en tu luz veremos la luz.", "words": [[0, 61528], [7, 61751], [15, 62371], [20, 62611], [23, 62731], [33, 63351], [36, 63511], [39, 63651], [45, 64370], [48, 64517], [51, 64657], [55, 64957], [63, 65717], [66, 65877]]}, {"verse": 10, "start": 66766, "end": 72908, "text": "Extiende tu misericordia a los que te conocen, y tu justicia a los rectos de corazón.", "words": [[0, 66766], [9, 67406], [12, 67586], [25, 68546], [27, 68686], [31, 68826], [35, 68966], [38, 69086], [47, 69786], [49, 70126], [52, 70286], [61, 70926], [63, 71226], [67, 71406], [74, 72046], [77, 72166]]}, {"verse": 11, "start": 73258, "end": 78266, "text": "No venga contra mí pie de soberbia; y mano