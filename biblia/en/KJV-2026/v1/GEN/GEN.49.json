{"book": "GEN", "chapter": 49, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 233722, "verses": [{"verse": 1, "start": 300, "end": 7626, "text": "And Jacob called to his sons, and said, Gather yourselves together, that I may tell you that which shall befall you in the last days.", "words": [[0, 300], [4, 412], [10, 692], [17, 1092], [20, 1312], [24, 1492], [30, 1852], [34, 2312], [40, 3071], [47, 3452], [58, 3892], [68, 4312], [73, 4552], [75, 4692], [79, 4792], [84, 5072], [88, 5272], [93, 5452], [99, 5672], [105, 5932], [112, 6312], [116, 6472], [119, 6632], [123, 6732], [128, 7032]]}, {"verse": 2, "start": 8076, "end": 13222, "text": "Gather yourselves together, and hear, you sons of Jacob; and hearken to Israel your father.", "words": [[0, 8076], [7, 8373], [18, 8773], [28, 9193], [32, 9513], [38, 9833], [42, 10253], [47, 10513], [50, 10693], [57, 11503], [61, 11736], [69, 12006], [72, 12186], [79, 12686], [84, 12766]]}, {"verse": 3, "start": 13672, "end": 20815, "text": "¶ Reuben, you are my firstborn, my might, and the beginning of my strength, the excellency of dignity, and the excellency of power:", "words": [[2, 13866], [10, 14096], [14, 14236], [18, 14336], [21, 14496], [32, 15416], [35, 15536], [42, 16196], [46, 16256], [50, 16376], [60, 16656], [63, 16856], [66, 17036], [76, 17796], [80, 17876], [91, 18416], [94, 18576], [103, 18956], [107, 19476], [111, 19596], [122, 20136], [125, 20316]]}, {"verse": 4, "start": 21265, "end": 28530, "text": "Unstable as water, you shall not excel; because you went up to your father’s bed; then you defiled it: he went up to my couch.", "words": [[0, 21265], [9, 21767], [12, 22007], [19, 22607], [23, 22687], [29, 22887], [33, 23107], [40, 23904], [48, 24121], [52, 24341], [57, 24461], [60, 24661], [63, 24801], [68, 24921], [77, 25361], [82, 25966], [87, 26142], [91, 26302], [99, 26682], [103, 27235], [106, 27343], [111, 27503], [114, 27703], [117, 27863], [120, 28003]]}, {"verse": 5, "start": 28980, "end": 33187, "text": "¶ Simeon and Levi are brethren; instruments of cruelty are in their habitations.", "words": [[2, 28980], [9, 29446], [13, 29566], [18, 29786], [22, 29986], [32, 30895], [44, 31395], [47, 31535], [55, 31935], [59, 32115], [62, 32235], [68, 32335]]}, {"verse": 6, "start": 33637, "end": 44579, "text": "O my soul, come not you into their secret; to their assembly, my honour, be not you united: for in their anger they killed a man, and in their selfwill they dug down a wall.", "words": [[0, 33767], [2, 33897], [5, 33977], [11, 34457], [16, 34557], [20, 34817], [24, 35057], [29, 35337], [35, 35557], [43, 36361], [46, 36465], [52, 36645], [62, 37204], [65, 37565], [73, 37925], [76, 38024], [80, 38245], [84, 38605], [92, 39730], [96, 39862], [99, 40062], [105, 40282], [111, 40762], [116, 41009], [123, 41255], [125, 41502], [130, 42002], [134, 42262], [137, 42402], [143, 42822], [152, 43242], [157, 43482], [161, 43702], [166, 44022], [168, 44162]]}, {"verse": 7, "start": 45029, "end": 52652, "text": "Cursed be their anger, for it was fierce; and their wrath, for it was cruel: I will divide them in Jacob, and scatter them in Israel.", "words": [[0, 45029], [7, 45266], [10, 45546], [16, 45746], [23, 46126], [27, 46386], [30, 46526], [34, 46706], [42, 47569], [46, 47693], [52, 47893], [59, 48273], [63, 48573], [66, 48713], [70, 48853], [77, 49741], [79, 49881], [84, 50021], [91, 50341], [96, 50641], [99, 50761], [106, 51121], [110, 51501], [118, 51761], [123, 52021], [126, 52141]]}, {"verse": 8, "start": 53102, "end": 61252, "text": "¶ Judah, you are he whom your brethren shall praise: your hand shall be in the neck of your enemies; your father’s children shall bow down before you.", "words": [[2, 53102], [9, 53308], [13, 53528], [17, 54108], [20, 54228], [25, 54468], [30, 54628], [39, 55008], [45, 55348], [53, 56335], [58, 56462], [63, 56802], [69, 57042], [72, 57222], [75, 57342], [79, 57442], [84, 57662], [87, 57822], [92, 57962], [101, 58957], [106, 59045], [115, 59465], [124, 59765], [130, 59985], [134, 60245], [139, 60565], [146, 60865]]}, {"verse": 9, "start": 61702, "end": 69947, "text": "Judah is a lion’s whelp: from the prey, my son, you are gone up: he stooped down, he couched as a lion, and as an old lion; who shall rouse him up?", "words": [[0, 61702], [6, 61963], [9, 62243], [11, 62383], [18, 62758], [25, 63392], [30, 63492], [34, 63752], [40, 64012], [43, 64112], [48, 64512], [52, 64592], [56, 64752], [61, 64952], [65, 65562], [68, 65702], [76, 65882], [82, 66262], [85, 66262], [93, 66702], [96, 66782], [98, 66902], [104, 67122], [108, 67582], [111, 67742], [114, 67862], [118, 68022], [124, 68802], [128, 68886], [134, 69106], [140, 69466], [144, 69606]]}, {"verse": 10, "start": 70397, "end": 78986, "text": "The sceptre shall not depart from Judah, nor a lawgiver from between his feet, until Shiloh come; and to him shall the gathering of the people be.", "words": [[0, 70397], [4, 70658], [12, 70938], [18, 71198], [22, 71378], [29, 71718], [34, 71978], [41, 72638], [45, 72798], [47, 72958], [56, 73418], [61, 73638], [69, 73918], [73, 74198], [79, 74738], [85, 74998], [92, 75558], [98, 76218], [102, 76347], [105, 76507], [109, 76807], [115, 77267], [119, 77427], [129, 77827], [132, 78107], [136, 78247], [143, 78567]]}, {"verse": 11, "start": 79436, "end": 86660, "text": "Binding his foal to the vine, and his donkey’s colt to the choice vine; he washed his garments in wine, and his clothes in the blood of grapes:", "words": [[0, 79436], [8, 79781], [12, 80001], [17, 80221], [20, 80381], [24, 80501], [30, 81201], [34, 81261], [38, 81361], [47, 81701], [52, 82041], [55, 82261], [59, 82381], [66, 82621], [72, 83340], [75, 83411], [82, 83691], [86, 83851], [95, 84131], [98, 84371], [104, 84691], [108, 84921], [112, 85151], [120, 85381], [123, 85611], [127, 85791], [133, 85951], [136, 86091]]}, {"verse": 12, "start": 87110, "end": 90508, "text": "His eyes shall be red with wine, and his teeth white with milk.", "words": [[0, 87110], [4, 87211], [9, 87551], [15, 87791], [18, 87951], [22, 88231], [27, 88431], [33, 88991], [37, 89291], [41, 89411], [47, 89611], [53, 89911], [58, 90091]]}, {"verse": 13, "start": 90958, "end": 97289, "text": "¶ Zebulun shall dwell at the haven of the sea; and he shall be for a haven of ships; and his border shall be to Zidon.", "words": [[2, 90958], [10, 91534], [16, 91754], [22, 91994], [25, 92194], [29, 92294], [35, 92514], [38, 92714], [42, 92814], [47, 93524], [51, 93629], [54, 93689], [60, 93849], [63, 94089], [67, 94199], [69, 94309], [75, 94589], [78, 94769], [85, 95654], [89, 95778], [93, 95898], [100, 96138], [106, 96378], [109, 96558], [112, 96948]]}, {"verse": 14, "start": 97739, "end": 100765, "text": "¶ Issachar is a strong donkey couching down between two burdens:", "words": [[2, 97910], [11, 98120], [14, 98280], [16, 98400], [23, 98720], [30, 99100], [39, 99560], [44, 99760], [52, 100000], [56, 100240]]}, {"verse": 15, "start": 101215, "end": 107199, "text": "And he saw that rest was good, and the land that it was pleasant; and bowed his shoulder to bear, and became a servant to tribute.", "words": [[0, 101215], [4, 101317], [7, 101397], [11, 101597], [16, 101777], [21, 101977], [25, 102137], [31, 102397], [35, 102697], [39, 102797], [44, 102997], [49, 103117], [52, 103217], [56, 103357], [66, 104145], [70, 104292], [76, 104632], [80, 104692], [89, 104972], [92, 105212], [98, 105472], [102, 105872], [109, 106112], [111, 106272], [119, 106512], [122, 106672]]}, {"verse": 16, "start": 107649, "end": 110824, "text": "¶ Dan shall judge his people, as one of the tribes of Israel.", "words": [[2, 107649], [6, 107828], [12, 108108], [18, 108468], [22, 108628], [30, 109048], [33, 109468], [37, 109648], [40, 109768], [44, 109868], [51, 110128], [54, 110328]]}, {"verse": 17, "start": 111274, "end": 117075, "text": "Dan shall be a serpent by the way, an adder in the path, that bites the horse heels, so that his rider shall fall backward.", "words": [[0, 111274], [4, 111492], [10, 111753], [13, 111952], [15, 112053], [23, 112372], [26, 112633], [30, 112773], [35, 112992], [38, 113212], [44, 113553], [47, 113652], [51, 113732], [57, 114032], [62, 114273], [68, 114553], [72, 114792], [78, 114992], [85, 115333], [88, 115572], [93, 115712], [97, 115812], [103, 116032], [109, 116292], [114, 116532]]}, {"verse": 18, "start": 117525, "end": 119708, "text": "I have waited for your salvation, O LORD.", "words": [[0, 117525], [2, 117688], [7, 117868], [14, 118128], [18, 118368], [23, 118508], [34, 119248], [36, 119348]]}, {"verse": 19, "start": 120158, "end": 124120, "text": "¶ Gad, a troop shall overcome him: but he shall overcome at the last.", "words": [[2, 120311], [7, 120466], [9, 120621], [15, 120776], [21, 121036], [30, 121476], [35, 122249], [39, 122348], [42, 122548], [48, 122748], [57, 123228], [60, 123488], [64, 123608]]}, {"verse": 20, "start": 124570, "end": 128577, "text": "¶ Out of Asher his bread shall be fat, and he shall yield royal dainties.", "words": [[2, 124570], [6, 124714], [9, 124854], [15, 125374], [19, 125494], [25, 125714], [31, 125954], [34, 126114], [39, 126754], [43, 126834], [46, 127014], [52, 127234], [58, 127474], [64, 127834]]}, {"verse": 21, "start": 129027, "end": 132434, "text": "¶ Naphtali is a hind let loose: he gives goodly words.", "words": [[2, 129264], [11, 129534], [14, 129874], [16, 129994], [21, 130234], [25, 130394], [32, 131247], [35, 131307], [41, 131487], [48, 131887]]}, {"verse": 22, "start": 132884, "end": 138124, "text": "¶ Joseph is a fruitful bough, even a fruitful bough by a well; whose branches run over the wall:", "words": [[2, 132884], [9, 133106], [12, 133326], [14, 133426], [23, 133926], [30, 134426], [35, 134546], [37, 134706], [46, 135066], [52, 135426], [55, 135686], [57, 135786], [63, 136539], [69, 136637], [78, 137077], [82, 137357], [87, 137537], [91, 137657]]}, {"verse": 23, "start": 138574, "end": 142292, "text": "The archers have sorely grieved him, and shot at him, and hated him:", "words": [[0, 138574], [4, 138706], [12, 139166], [17, 139366], [24, 139826], [32, 140186], [37, 140346], [41, 140786], [46, 141086], [49, 141246], [54, 141426], [58, 141706], [64, 141946]]}, {"verse": 24, "start": 142742, "end": 151736, "text": "But his bow remained in strength, and the arms of his hands were made strong by the hands of the mighty God of Jacob; (from there is the shepherd, the stone of Israel:)", "words": [[0, 142742], [4, 142863], [8, 142963], [12, 143203], [21, 143643], [24, 143843], [34, 144203], [38, 144643], [42, 144743], [47, 145043], [50, 145183], [54, 145303], [60, 145583], [65, 145763], [70, 145943], [77, 146303], [80, 146543], [84, 146663], [90, 146903], [93, 147043], [97, 147163], [104, 147423], [108, 147763], [111, 147883], [118, 148703], [124, 148825], [130, 149085], [133, 149285], [137, 149425], [147, 150065], [151, 150185], [157, 150525], [160, 150685]]}, {"verse": 25, "start": 152186, "end": 163005, "text": "Even by the God of your father, who shall help you; and by the Almighty, who shall bless you with blessings of heaven above, blessings of the deep that lies under, blessings of the breasts, and of the womb:", "words": [[0, 152186], [5, 152402], [8, 152622], [12, 152722], [16, 152982], [19, 153122], [24, 153222], [32, 153542], [36, 153882], [42, 154062], [47, 154322], [52, 154833], [56, 154938], [59, 155118], [63, 155258], [73, 156118], [77, 156398], [83, 156578], [89, 156818], [93, 157058], [98, 157218], [108, 157498], [111, 157738], [118, 157978], [125, 158778], [135, 159098], [138, 159418], [142, 159538], [147, 159758], [152, 159978], [157, 160178], [164, 160858], [174, 161218], [177, 161518], [181, 161638], [190, 161998], [194, 162338], [197, 162438], [201, 162558]]}, {"verse": 26, "start": 163455, "end": 175335, "text": "The blessings of your father have prevailed above the blessings of my progenitors to the utmost bound of the everlasting hills: they shall be on the head of Joseph, and on the crown of the head of him that was separate from his brethren.", "words": [[0, 163455], [4, 163553], [14, 163833], [17, 164093], [22, 164213], [29, 164513], [34, 164773], [44, 165313], [50, 165613], [54, 165853], [64, 166173], [67, 166453], [70, 166613], [82, 167253], [85, 167473], [89, 167593], [96, 167873], [102, 168333], [105, 168533], [109, 168673], [121, 169033], [128, 170125], [133, 170245], [139, 170445], [142, 170625], [145, 170785], [149, 170905], [154, 171065], [157, 171185], [165, 171605], [169, 172225], [172, 172325], [176, 172445], [182, 172725], [185, 172905], [189, 173025], [194, 173205], [197, 173345], [201, 173565], [206, 173845], [210, 174005], [219, 174385], [224, 174625], [228, 174785]]}, {"verse": 27, "start": 175785, "end": 181927, "text": "¶ Benjamin shall ravin as a wolf: in the morning he shall devour the prey, and at night he shall divide the spoil.", "words": [[2, 175785], [11, 176162], [17, 176552], [23, 176942], [26, 177162], [28, 177262], [34, 177895], [37, 178049], [41, 178149], [49, 178429], [52, 178669], [58, 178889], [65, 179369], [69, 179509], [75, 179949], [79, 180209], [82, 180329], [88, 180549], [91, 180789], [97, 180949], [104, 181249], [108, 181449]]}, {"verse": 28, "start": 182277, "end": 192213, "text": "¶ All these are the twelve tribes of Israel: and this is it that their father spoke to them, and blessed them; every one according to his blessing he blessed them.", "words": [[2, 182277], [6, 182467], [12, 182747], [16, 183007], [20, 183147], [27, 183507], [34, 183967], [37, 184287], [45, 185184], [49, 185328], [54, 185528], [57, 185708], [60, 185848], [65, 186048], [71, 186208], [78, 186548], [84, 186928], [87, 187208], [93, 187468], [97, 188008], [105, 188328], [111, 189248], [117, 189382], [121, 189515], [131, 189915], [134, 190235], [138, 190455], [147, 191215], [150, 191355], [158, 191695]]}, {"verse": 29, "start": 192663, "end": 201443, "text": "And he charged them, and said to them, I am to be gathered to my people: bury me with my fathers in the cave that is in the field of Ephron the Hittite,", "words": [[0, 192663], [4, 192794], [7, 192914], [15, 193334], [21, 193674], [25, 193914], [30, 194234], [33, 194414], [39, 195699], [41, 195861], [44, 195961], [47, 196101], [50, 196201], [59, 196561], [62, 196801], [65, 196921], [73, 197656], [78, 197941], [81, 198061], [86, 198241], [89, 198421], [97, 198901], [100, 199001], [104, 199101], [109, 199341], [114, 199541], [117, 199681], [120, 199801], [124, 199901], [130, 200181], [133, 200321], [140, 200721], [144, 200861]]}, {"verse": 30, "start": 201893, "end": 212683, "text": "In the cave that is in the field of Machpelah, which is before Mamre, in the land of Canaan, which Abraham bought with the field of Ephron the Hittite for a possession of a buryingplace.", "words": [[0, 201893], [3, 202054], [7, 202154], [12, 202494], [17, 202714], [20, 202854], [23, 203014], [27, 203094], [33, 203374], [36, 203944], [47, 204514], [53, 204654], [56, 204774], [63, 205194], [70, 205694], [73, 206114], [77, 206234], [82, 206474], [85, 206634], [93, 207512], [99, 207674], [107, 208094], [114, 208514], [119, 208734], [123, 208904], [129, 209074], [132, 209234], [139, 209694], [143, 209984], [151, 210274], [155, 210714], [157, 210834], [168, 211214], [171, 211594], [173, 212169]]}, {"verse": 31, "start": 213133, "end": 220311, "text": "There they buried Abraham and Sarah his wife; there they buried Isaac and Rebekah his wife; and there I buried Leah.", "words": [[0, 213133], [6, 213557], [11, 213617], [18, 213937], [26, 214437], [30, 214717], [36, 215117], [40, 215197], [46, 215866], [52, 216122], [57, 216322], [64, 216642], [70, 217102], [74, 217482], [82, 217862], [86, 217942], [92, 218637], [96, 218870], [102, 219104], [104, 219337], [111, 219737]]}, {"verse": 32, "start": 220761, "end": 224486, "text": "The purchase of the field and of the cave that is in it was from the children of Heth.", "words": [[0, 220761], [4, 2