{"book": "GEN", "chapter": 43, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 346590, "verses": [{"verse": 1, "start": 300, "end": 2464, "text": "Y el hambre era grande en la tierra.", "words": [[0, 300], [2, 422], [5, 542], [12, 882], [16, 1102], [23, 1522], [26, 1662], [29, 1802]]}, {"verse": 2, "start": 2914, "end": 12301, "text": "Y aconteció que como acabaron de comer el trigo que trajeron de Egipto, les dijo su padre: Volved, y comprad para nosotros un poco de alimento.", "words": [[0, 2914], [2, 3205], [12, 3805], [16, 3985], [21, 4265], [30, 4825], [33, 5005], [39, 5265], [42, 5505], [48, 5925], [52, 6065], [61, 6625], [64, 6785], [72, 7745], [76, 7925], [81, 8225], [84, 8405], [91, 9475], [99, 9715], [101, 9895], [109, 10075], [114, 10375], [123, 10855], [126, 11295], [131, 11515], [134, 11695]]}, {"verse": 3, "start": 12651, "end": 21219, "text": "Y respondió Judá, diciendo: Aquel varón nos advirtió solemnemente, diciendo: No veréis mi rostro sin vuestro hermano con vosotros.", "words": [[0, 12651], [2, 12755], [12, 13415], [18, 13875], [28, 14854], [34, 15184], [40, 15524], [44, 15664], [53, 16164], [67, 16984], [77, 18073], [80, 18235], [87, 18615], [90, 18775], [97, 19255], [101, 19455], [109, 19855], [117, 20295], [121, 20435]]}, {"verse": 4, "start": 21669, "end": 26002, "text": "Si envías a nuestro hermano con nosotros, descenderemos y te compraremos alimento:", "words": [[0, 21669], [3, 21833], [10, 22193], [12, 22293], [20, 22473], [28, 22973], [32, 23093], [42, 23813], [56, 24353], [58, 24553], [61, 24653], [73, 25233]]}, {"verse": 5, "start": 26452, "end": 34044, "text": "Pero si no le envías, no descenderemos: porque aquel varón nos dijo: No veréis mi rostro sin vuestro hermano con vosotros.", "words": [[0, 26452], [5, 26592], [8, 26772], [11, 26912], [14, 27052], [22, 27632], [25, 27732], [40, 28931], [47, 29148], [53, 29568], [59, 29888], [63, 30048], [69, 30898], [72, 31060], [79, 31440], [82, 31600], [89, 32080], [93, 32280], [101, 32680], [109, 33120], [113, 33260]]}, {"verse": 6, "start": 34394, "end": 40114, "text": "Y dijo Israel: ¿Por qué me hicisteis tanto mal, diciendo al varón que teníais más hermano?", "words": [[0, 34394], [2, 34596], [7, 34836], [15, 35787], [20, 35911], [24, 36091], [27, 36231], [37, 36831], [43, 37011], [48, 37751], [57, 38271], [60, 38411], [66, 38731], [70, 38991], [78, 39251], [82, 39511]]}, {"verse": 7, "start": 40464, "end": 58711, "text": "Y ellos respondieron: Aquel varón nos preguntó expresamente por nosotros, y por nuestra familia, diciendo: ¿Vive aún vuestro padre? ¿tenéis otro hermano? y le respondimos conforme a estas palabras. ¿Podíamos nosotros saber que había de decir: Haced venir a vuestro hermano?", "words": [[0, 40464], [2, 40625], [8, 40905], [22, 42323], [28, 42641], [34, 42981], [38, 43121], [47, 43681], [60, 44301], [64, 44561], [74, 45041], [76, 45301], [80, 45501], [88, 45701], [97, 46321], [107, 47422], [113, 47677], [117, 47967], [125, 48307], [132, 49233], [140, 49598], [145, 49858], [154, 50973], [156, 51098], [159, 51198], [171, 51938], [180, 52308], [182, 52678], [188, 52858], [198, 53970], [208, 54334], [217, 54774], [223, 55214], [227, 55414], [233, 55614], [236, 55834], [243, 56931], [249, 57131], [255, 57551], [257, 57771], [265, 58111]]}, {"verse": 8, "start": 59161, "end": 71201, "text": "Entonces Judá dijo a Israel su padre: Envía al joven conmigo, y nos levantaremos e iremos, a fin de que vivamos y no muramos nosotros, y tú, y nuestros niños.", "words": [[0, 59161], [9, 60089], [14, 60889], [19, 60999], [21, 61109], [28, 61809], [31, 61889], [38, 62702], [44, 63120], [47, 63280], [53, 63600], [62, 64160], [64, 64640], [68, 64760], [81, 65500], [83, 65760], [91, 66300], [93, 66760], [97, 66960], [100, 67120], [104, 67240], [112, 67680], [114, 67920], [117, 68040], [125, 68420], [135, 68920], [137, 69520], [141, 69760], [143, 70220], [152, 70440]]}, {"verse": 9, "start": 71651, "end": 80735, "text": "Yo respondo por él; a mí me pedirás cuenta de él: si yo no te lo devuelvo y lo pongo delante de ti, seré para ti el culpable todos los días:", "words": [[0, 71651], [3, 71816], [12, 72356], [16, 72556], [20, 73132], [22, 73237], [25, 73377], [28, 73517], [36, 73977], [43, 74257], [46, 74517], [50, 75167], [53, 75262], [56, 75422], [59, 75522], [62, 75682], [65, 75822], [74, 76342], [76, 76402], [79, 76522], [85, 76862], [93, 77282], [96, 77442], [100, 78022], [105, 78442], [110, 78562], [113, 78842], [116, 78962], [125, 79542], [131, 79802], [135, 80122]]}, {"verse": 10, "start": 81185, "end": 85726, "text": "Que si no nos hubiéramos detenido, cierto ahora hubiéramos ya vuelto dos veces.", "words": [[0, 81185], [4, 81292], [7, 81412], [10, 81572], [14, 81732], [25, 82212], [35, 83232], [42, 83412], [48, 83792], [59, 84372], [62, 84532], [69, 84892], [73, 85032]]}, {"verse": 11, "start": 86076, "end": 102640, "text": "Entonces Israel su padre les respondió: Pues que así es, hacedlo; tomad de lo mejor de la tierra en vuestros vasos, y llevad a aquel varón un presente, un poco de bálsamo, y un poco de miel, aromas y mirra, nueces y almendras.", "words": [[0, 86076], [9, 86684], [16, 88084], [19, 88204], [25, 89024], [29, 89144], [40, 90465], [45, 90598], [49, 90778], [53, 90998], [57, 91718], [66, 92684], [72, 92969], [75, 93089], [78, 93189], [84, 93469], [87, 93629], [90, 93729], [97, 93989], [100, 94169], [109, 94509], [116, 95049], [118, 95349], [125, 95689], [127, 95789], [133, 96089], [139, 96449], [142, 96609], [152, 97469], [155, 97569], [160, 97809], [163, 97969], [172, 98469], [174, 98689], [177, 98789], [182, 98969], [185, 99169], [191, 99689], [198, 100009], [200, 100209], [207, 101003], [214, 101570], [216, 101830]]}, {"verse": 12, "start": 103090, "end": 111483, "text": "Y tomad en vuestras manos el doble de dinero, y llevad en vuestra mano el dinero vuelto en las bocas de vuestros costales; quizá fue un error.", "words": [[0, 103090], [2, 103212], [8, 103572], [11, 103672], [20, 104052], [26, 104352], [29, 104732], [35, 105052], [38, 105172], [46, 105552], [48, 106032], [55, 106372], [58, 106472], [66, 106812], [71, 107072], [74, 107292], [81, 107592], [88, 108032], [91, 108132], [95, 108272], [101, 108672], [104, 108832], [113, 109192], [123, 110273], [129, 110617], [133, 110797], [136, 110957]]}, {"verse": 13, "start": 111933, "end": 116257, "text": "Tomad también a vuestro hermano, y levantaos, y volved a aquel varón.", "words": [[0, 111933], [6, 112257], [14, 112557], [16, 112737], [24, 113017], [33, 113677], [35, 113837], [46, 114617], [48, 114910], [55, 115204], [57, 115497], [63, 115797]]}, {"verse": 14, "start": 116707, "end": 126745, "text": "Y el Dios Omnipotente os dé misericordias delante de aquel varón, y os suelte al otro vuestro hermano, y a este Benjamín. Y si he de ser privado de mis hijos, que así sea.", "words": [[0, 116707], [2, 116967], [5, 117067], [10, 117247], [22, 118067], [25, 118227], [28, 118367], [42, 119167], [50, 119587], [53, 119727], [59, 119967], [66, 120507], [68, 120827], [71, 120927], [78, 121307], [81, 121427], [86, 121607], [94, 121967], [103, 122567], [105, 122727], [107, 122767], [112, 122947], [122, 123895], [124, 124002], [127, 124182], [130, 124302], [133, 124342], [137, 124602], [145, 125142], [148, 125282], [152, 125422], [159, 126002], [163, 126062], [167, 126242]]}, {"verse": 15, "start": 127095, "end": 140046, "text": "Entonces tomaron aquellos varones el presente, y tomaron en su mano el doble de dinero, y a Benjamín; y se levantaron, y descendieron a Egipto, y se presentaron delante de José.", "words": [[0, 127095], [9, 127553], [17, 128193], [26, 128513], [34, 129113], [37, 129313], [47, 129733], [49, 130513], [57, 130953], [60, 131073], [63, 131233], [68, 131493], [71, 131653], [77, 132053], [80, 132233], [88, 132753], [90, 133269], [92, 133786], [102, 134540], [104, 134666], [107, 134746], [119, 135706], [121, 136166], [134, 136826], [136, 136986], [144, 137666], [146, 138026], [149, 138126], [161, 138866], [169, 139326], [172, 139486]]}, {"verse": 16, "start": 140496, "end": 153601, "text": "Y vio José a Benjamín con ellos, y dijo al mayordomo de su casa: Mete en casa a esos hombres, y degüella un animal, y prepáralo; porque estos hombres comerán conmigo al medio día.", "words": [[0, 140496], [2, 140655], [6, 140855], [11, 141255], [13, 141495], [22, 142055], [26, 142295], [33, 143115], [35, 143455], [40, 143815], [43, 144335], [53, 144855], [56, 144975], [59, 145095], [65, 145976], [70, 146320], [73, 146480], [78, 146800], [80, 147040], [85, 147220], [94, 147660], [96, 148200], [105, 148740], [108, 148880], [116, 149280], [118, 149880], [129, 150938], [136, 151139], [142, 151419], [150, 151819], [158, 152319], [166, 152759], [169, 153052], [175, 153346]]}, {"verse": 17, "start": 153951, "end": 159644, "text": "E hizo el hombre como José dijo; y metió aquel hombre a los hombres en casa de José.", "words": [[0, 153951], [2, 154073], [7, 154333], [10, 154533], [17, 154773], [22, 155053], [27, 155313], [33, 156252], [35, 156374], [41, 156694], [47, 157014], [54, 157314], [56, 157594], [60, 157774], [68, 158194], [71, 158534], [76, 158894], [79, 159134]]}, {"verse": 18, "start": 160094, "end": 178821, "text": "Y aquellos hombres tuvieron temor, cuando fueron metidos en casa de José, y decían: Por el dinero que fue vuelto en nuestros costales la primera vez nos han metido aquí, para revolver contra nosotros, y dar sobre nosotros, y tomarnos por siervos a nosotros, y a nuestros asnos.", "words": [[0, 160094], [2, 160386], [11, 160646], [19, 161206], [28, 161766], [35, 162266], [42, 162706], [49, 163066], [57, 163566], [60, 163806], [65, 164046], [68, 164266], [74, 164586], [76, 164866], [84, 165939], [88, 166061], [91, 166201], [98, 166481], [102, 166721], [106, 166921], [113, 167321], [116, 167421], [125, 167581], [134, 168861], [137, 169101], [145, 169381], [149, 169741], [153, 170041], [157, 170221], [164, 170661], [170, 170921], [175, 171501], [184, 172161], [191, 172461], [201, 172881], [203, 173481], [207, 173641], [213, 174001], [223, 174461], [225, 174921], [234, 175401], [238, 175621], [246, 176141], [248, 176301], [258, 177412], [260, 177541], [262, 177601], [271, 177861]]}, {"verse": 19, "start": 179271, "end": 184788, "text": "Y se llegaron al mayordomo de la casa de José, y le hablaron a la entrada de la casa.", "words": [[0, 179271], [2, 179394], [5, 179514], [14, 180034], [17, 180534], [27, 181034], [30, 181134], [33, 181254], [38, 181494], [41, 181674], [47, 181994], [49, 182594], [52, 182734], [61, 183274], [63, 183394], [66, 183474], [74, 183874], [77, 184154], [80, 184274]]}, {"verse": 20, "start": 185238, "end": 194427, "text": "Y dijeron: Ay, señor mío, nosotros en realidad de verdad descendimos al principio a comprar alimentos:", "words": [[0, 185238], [2, 185366], [11, 186359], [15, 186863], [21, 187063], [26, 188203], [35, 188523], [38, 188963], [47, 189443], [50, 189783], [57, 190123], [69, 191083], [72, 191323], [82, 191863], [84, 192163], [92, 192583]]}, {"verse": 21, "start": 194877, "end": 208026, "text": "Y aconteció que como vinimos al posada y abrimos nuestros costales, he aquí el dinero de cada uno estaba en la boca de su costal, nuestro dinero en su justo peso; y lo hemos devuelto en nuestras manos.", "words": [[0, 194877], [2, 195006], [12, 195746], [16, 195966], [21, 196246], [29, 196726], [32, 196946], [39, 197526], [41, 197666], [49, 198146], [58, 198326], [68, 199766], [71, 199866], [76, 200186], [79, 200366], [86, 200686], [89, 200886], [94, 201066], [98, 201366], [105, 201626], [108, 201826], [111, 201946], [116, 202166], [119, 202346], [122, 202486], [130, 203428], [138, 203655], [145, 204115], [148, 204315], [151, 204475], [157, 204795], [163, 205779], [165, 205908], [168, 206048], [174, 206248], [183, 206828], [186, 206928], [195, 207088]]}, {"verse": 22, "start": 208476, "end": 218003, "text": "Hemos también traído en nuestras manos otro dinero para comprar alimentos: nosotros no sabemos quién haya puesto nuestro dinero en nuestros costales.", "words": [[0, 208476], [6, 208715], [14, 209015], [21, 209575], [24, 209675], [33, 209855], [39, 210415], [44, 210895], [51, 211335], [56, 211615], [64, 212095], [75, 213478], [84, 213906], [87, 214086], [95, 214406], [101, 214786], [106, 215046], [113, 215426], [121, 215766], [128, 216386], [131, 216646], [140, 216886]]}, {"verse": 23, "start": 218453, "end": 230504, "text": "Y él respondió: Paz a vosotros, no temáis; vuestro Dios y el Dios de vuestro padre os dio el tesoro en vuestros costales: yo recibí vuestro dinero. Y les entregó a Simeón.", "words": [[0, 218453], [2, 218640], [5, 218820], [16, 219974], [20, 220104], [22, 220204], [32, 220624], [35, 221109], [43, 221842], [51, 222239], [56, 222439], [58, 222719], [61, 222839], [66, 223039], [69, 223239], [77, 223579], [83, 224019], [86, 224119], [90, 224299], [93, 224479], [100, 224919], [103, 225039], [112, 225359], [122, 226475], [125, 226677], [132, 227217], [140, 227517], [148, 228439], [150, 228603], [154, 228783], [162, 229523], [164, 229703]]}, {"verse": 24, "start": 230954, "end": 240011, "text": "Y metió aquel varón a aquellos hombres en casa de José: y les dio agua, y lavaron sus pies: y dio de comer a sus asnos.", "words": [[0, 230954], [2, 231082], [8, 231442], [14, 231802], [20, 232202], [22, 232382], [31, 232682], [39, 233222], [42, 233502], [47, 233822], [50, 234062], [56, 235048], [58, 235204], [62, 235324], [66, 235584], [72, 236124], [74, 236584], [82, 236984], [86, 237144], [92, 238045], [94, 238375], [98, 238535], [101, 238675], [107, 238915], [109, 239075], [113, 239195]]}, {"verse": 25, "start": 240461, "end": 248999, "text": "Y ellos prepararon el presente entretanto que venía José al medio día, porque habían oído que allí habían de comer pan.", "words": [[0, 240461], [2, 240606], [8, 240886], [19, 241726], [22, 241866], [31, 242826], [42, 243786], [46, 244006], [52, 244346], [57, 244706], [60, 245159], [66, 245613], [71, 246066], [78, 246446], [85, 246786], [90, 247246], [94, 247466], [99, 247686], [106, 248006], [109, 248186], [115, 248406]]}, {"verse": 26, "start": 249449, "end": 258571, "text": "Y vino José a casa, y ellos le trajeron el presente que tenían en su mano dentro de casa, y se inclinaron a él hasta tierra.", "words": [[0, 249449], [2, 249594], [7, 249814], [12, 250154], [14, 250394], [20, 251354], [22, 251434], [28, 251714], [31, 251894], [40, 252554], [43, 252674], [52, 253114], [56, 253454], [63, 253754], [66, 254054], [69, 254234], [74, 254534], [81, 254854], [84, 255134], [90, 255474], [92, 256074], [95, 256254], [106, 257054], [108, 257274], [111, 257454], [117, 257794]]}, {"verse": 27, "start": 259021, "end": 267499, "text": "Entonces les preguntó él cómo estaban, y dijo: ¿Vuestro padre, el anciano que dijisteis, lo pasa bien? ¿vive todavía?", "words": [[0, 259021], [9, 259601], [13, 260121], [22, 260801], [25, 260901], [30, 261181], [39, 261721], [41, 262241], [47, 263029], [56, 263456], [63, 263776], [66, 263976], [74, 264376], [78, 264516], [89, 265296], [92, 265556], [97, 265816], [103, 266558], [109, 266819]]}, {"verse": 28, "start": 267849, "end": 276291, "text": "Y ellos respondieron: Bien va a tu siervo nuestro padre; aún vive. Y se inclinaron, e hicieron reverencia.", "words": [[0, 267849], [2, 268010], [8, 268290], [22, 269708], [27, 270041], [30, 270301], [32, 270401], [35, 270521], [42, 270981], [50, 271161], [57, 272340], [61, 272628], [67, 273148], [69, 273345], [72, 273405], [84, 274225], [86, 274465], [95, 275205]]}, {"verse": 29, "start": 276741, "end": 290435, "text": "Y alzando él sus ojos vio a Benjamín su hermano, hijo de su madre, y dijo: ¿Es este vuestro hermano menor, de quien me hablasteis? Y dijo: Dios tenga misericordia de ti, hijo mío.", "words": [[0, 276741], [2, 277049], [10, 277349], [13, 277649], [17, 277809], [22, 278629], [26, 278829], [28, 278929], [37, 279289], [40, 279629], [49, 280509], [54, 280609], [57, 280789], [60, 280929], [67, 281669], [69, 281709], [75, 282404], [79, 282585], [84, 282845], [92, 283165], [100, 283505], [107, 283825], [110, 284345], [116, 284525], [119, 284665], [131, 285772], [133, 285901], [139, 286673], [144, 286911], [150, 287271], [163, 288111], [166, 288251], [170, 288751], [175, 288911]]}, {"verse": 30, "start": 290785, "end": 301967, "text": "Entonces José se apresuró, porque se conmovieron sus entrañas a causa de su hermano, y buscó donde llorar: y entró en su cámara, y lloró allí.", "words": [[0, 290785], [9, 291366], [14, 292126], [17, 292586], [27, 293326], [34, 293806], [37, 294006], [49, 294666], [53, 294846], [62, 295546], [64, 295726], [70, 295966], [73, 296286], [76, 296386], [85, 297226], [87, 297346], [93, 297846], [99, 298066], [107, 299173], [109, 299312], [115, 299732], [118, 299832], [121, 300012], [129, 300492], [131, 301072], [137, 301472]]}, {"verse": 31, "start": 302417, "end": 308588, "text": "Y lavó su rostro, y salió fuera, y se contuvo, y dijo: Servid la comida.", "words": [[0, 302417], [2, 302561], [7, 302961], [10, 303061], [18, 304201], [20, 304281], [26, 304621], [33, 305081], [35, 305681], [38, 305821], [47, 306421], [49, 306801], [55, 307788], [62, 307988], [65, 308088]]}, {"verse": 32, "start": 308938, "end": 324121, "text": "Y pusieron para él aparte, y separadamente para ellos, y aparte para los egipcios que con él comían: porque los egipcios no pueden comer pan con los hebreos, lo cual es abominación a los egipcios.", "words": [[0, 308938], [2, 309052], [11, 309472], [16, 309772], [19, 310012], [27, 311072], [29, 311172], [43, 311932], [48, 312312], [55, 312732], [57, 313272], [64, 313812], [69, 314032], [73, 314272], [82, 314972], [86, 315472], [90, 315752], [93, 315872], [101, 316949], [108, 317173], [112, 317373], [121, 317973], [124, 318193], [131, 318533], [137, 318913], [141, 319413], [145, 319693], [149, 319873], [158, 320913], [161, 321053], [166, 321413], [169, 321913], [181, 322833], [183, 323113], [187, 323233]]}, {"verse": 33, "start": 324571, "end": 334326, "text": "Y se sentaron delante de él, el mayor conforme a su edad, y el menor conforme a su edad; y estaban aquellos hombres atónitos mirándose el uno al otro.", "words": [[0, 324571], [2, 324733], [5, 324853], [14, 325373], [22, 325813], [25, 325973], [29, 326213], [32, 326453], [38, 326793], [47, 327493], [49, 327533], [52, 327653], [58, 327973], [60, 328113], [63, 328253], [69, 328573], [78, 329253], [80, 329313], [83, 329413], [89, 330258], [91, 330558], [99, 330898], [108, 331218], [116, 331638], [125, 332378], [135, 333158], [138, 333438], [142, 333638], [145, 333818]]}, {"verse": 34, "start": 334776, "end": 346190, "text": "Y él tomó comida de delante de sí para ellos; mas la porción de Benjamín era cinco veces como cualquiera de las de ellos. Y bebieron, y se alegraron con él.", "words": [[0, 334776], [2, 334941], [5, 335061], [10, 335461], [17, 335961], [20, 336161], [28, 336641], [31, 336821], [34, 337041], [39, 337321], [46, 338320], [50, 338668], [53, 338868], [61, 339328], [64, 339488], [73, 339968], [77, 340368], [83, 340788], [89, 341408], [94, 341908], [105, 342508], [108, 342688], [112, 342808], [115, 342988], [122, 343845], [124, 343963], [134, 344483], [136, 344803], [139, 344963], [149, 345563], [153, 345763]]}]}