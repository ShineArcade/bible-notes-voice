{"book": "ISA", "chapter": 53, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 143883, "verses": [{"verse": 1, "start": 300, "end": 5992, "text": "¿Quién ha creído a nuestro anuncio? ¿y sobre quién se ha manifestado el brazo de Jehová?", "words": [[0, 300], [7, 622], [10, 762], [17, 1262], [19, 1382], [27, 1542], [36, 2861], [39, 3008], [45, 3208], [51, 3588], [54, 3908], [57, 4028], [69, 4768], [72, 4888], [78, 5288], [81, 5408]]}, {"verse": 2, "start": 6442, "end": 18564, "text": "Y subirá cual renuevo delante de él, y como raíz de tierra seca: no hay parecer en él, ni hermosura: lo veremos, mas sin atractivo para que le deseemos.", "words": [[0, 6442], [2, 6686], [9, 7186], [14, 7426], [22, 8146], [30, 8646], [33, 8846], [37, 9066], [39, 9246], [44, 9486], [49, 10006], [52, 10166], [59, 10486], [65, 11435], [68, 11643], [72, 11943], [80, 12423], [83, 12783], [87, 13073], [90, 13363], [101, 14586], [104, 14731], [113, 15351], [117, 15791], [121, 16351], [131, 17051], [136, 17271], [140, 17431], [143, 17591]]}, {"verse": 3, "start": 19014, "end": 31847, "text": "Despreciado y desechado entre los hombres, varón de dolores, experimentado en quebranto: y como que escondimos de él el rostro, fue menospreciado, y no lo estimamos.", "words": [[0, 19014], [12, 20022], [14, 20162], [24, 20802], [30, 21042], [34, 21262], [43, 22282], [49, 22702], [52, 22902], [61, 23442], [75, 24562], [78, 24762], [89, 25995], [91, 26119], [96, 26379], [100, 26599], [111, 27299], [114, 27459], [117, 27619], [120, 27739], [128, 28639], [132, 29429], [147, 30219], [149, 30699], [152, 30899], [155, 31039]]}, {"verse": 4, "start": 32297, "end": 41830, "text": "Ciertamente llevó él nuestras enfermedades, y sufrió nuestros dolores; y nosotros le tuvimos por azotado, por herido de Dios y abatido.", "words": [[0, 32297], [12, 33101], [18, 33561], [21, 33701], [30, 34041], [44, 35081], [46, 35281], [53, 35721], [62, 35961], [71, 37232], [73, 37339], [82, 37679], [85, 38039], [93, 38419], [97, 38699], [106, 39739], [110, 39799], [117, 40299], [120, 40459], [125, 40759], [127, 41079]]}, {"verse": 5, "start": 42280, "end": 53579, "text": "Mas él herido fue por nuestras rebeliones, molido por nuestros pecados: el castigo de nuestra paz sobre él; y por su llaga fuimos nosotros curados.", "words": [[0, 42280], [4, 42689], [7, 43140], [14, 43580], [18, 43860], [22, 44200], [31, 44540], [43, 45960], [50, 46540], [54, 46780], [63, 47160], [72, 48451], [75, 48592], [83, 49052], [86, 49152], [94, 49352], [98, 49792], [104, 50092], [108, 50861], [110, 50966], [114, 51186], [117, 51456], [123, 51726], [130, 52166], [139, 52546]]}, {"verse": 6, "start": 54029, "end": 63450, "text": "Todos nosotros nos descarriamos como ovejas, cada cual se apartó por su camino: mas Jehová cargó en él el pecado de todos nosotros.", "words": [[0, 54029], [6, 54316], [15, 55056], [19, 55666], [32, 56276], [37, 56596], [45, 57536], [50, 57856], [55, 58136], [58, 58356], [65, 58876], [69, 59076], [72, 59256], [80, 60397], [84, 60637], [91, 60877], [97, 61297], [100, 61457], [103, 61617], [106, 61757], [113, 62217], [116, 62417], [122, 62657]]}, {"verse": 7, "start": 63900, "end": 75972, "text": "Angustiado él, y afligido, no abrió su boca: como cordero fue llevado al matadero; y como oveja delante de sus trasquiladores, enmudeció, y no abrió su boca.", "words": [[0, 63900], [11, 64584], [15, 64884], [17, 65104], [27, 65984], [30, 66204], [36, 66704], [39, 66884], [45, 67725], [50, 67914], [58, 68454], [62, 68694], [70, 69214], [73, 69394], [83, 70480], [85, 70585], [90, 70825], [96, 71445], [104, 71945], [107, 72105], [111, 72305], [127, 73165], [138, 74125], [140, 74645], [143, 74865], [149, 75245], [152, 75405]]}, {"verse": 8, "start": 76422, "end": 88279, "text": "De la cárcel y del juicio fue quitado; y su generación ¿quién la contará? Porque cortado fue de la tierra de los vivientes; por la rebelión de mi pueblo fue herido.", "words": [[0, 76422], [3, 76568], [6, 76708], [13, 77248], [15, 77388], [19, 77568], [26, 78048], [30, 78288], [39, 79336], [41, 79440], [44, 79600], [55, 80740], [62, 81080], [65, 81240], [74, 82357], [81, 82579], [89, 83219], [93, 83419], [96, 83559], [99, 83699], [106, 83939], [109, 84279], [113, 84419], [124, 85669], [128, 85791], [131, 86171], [140, 86551], [143, 86751], [146, 86871], [153, 87191], [157, 87531]]}, {"verse": 9, "start": 88729, "end": 99118, "text": "Y se dispuso con los impíos su sepultura, mas con los ricos fue en su muerte; porque nunca hizo él maldad, ni hubo engaño en su boca.", "words": [[0, 88729], [2, 88838], [5, 89188], [13, 89538], [17, 89678], [21, 89858], [28, 90618], [31, 90898], [42, 92178], [46, 92718], [50, 92938], [54, 93138], [60, 93518], [64, 93858], [67, 93998], [70, 94158], [78, 95134], [85, 95318], [91, 95558], [96, 95978], [99, 96138], [107, 96678], [110, 97458], [115, 97738], [122, 98218], [125, 98338], [128, 98498]]}, {"verse": 10, "start": 99568, "end": 116494, "text": "Con todo eso Jehová quiso quebrantarlo, sujetándole a padecimiento. Cuando haya puesto su vida en expiación por el pecado, verá linaje, vivirá por largos días, y la voluntad de Jehová será en su mano prosperada.", "words": [[0, 99568], [4, 99710], [9, 100030], [13, 100370], [20, 100910], [26, 101190], [40, 102790], [52, 103574], [54, 104358], [68, 105384], [75, 105548], [80, 105888], [87, 106208], [90, 106548], [95, 106868], [98, 107028], [108, 107728], [112, 107988], [115, 108108], [123, 108908], [128, 109708], [136, 110508], [143, 110888], [147, 111068], [154, 111588], [160, 112358], [162, 113128], [165, 113248], [174, 113908], [177, 114028], [184, 114528], [189, 114748], [192, 115028], [195, 115208], [200, 115508]]}, {"verse": 11, "start": 116794, "end": 127175, "text": "Del trabajo de su alma verá y será saciado; con su conocimiento justificará mi siervo justo a muchos, y él llevará las iniquidades de ellos.", "words": [[0, 116794], [4, 116998], [12, 117438], [15, 117638], [18, 117838], [23, 118058], [28, 118538], [30, 118998], [35, 119298], [44, 120619], [48, 120735], [51, 120895], [64, 121655], [76, 122435], [79, 122595], [86, 123035], [92, 123275], [94, 123535], [102, 124155], [104, 124475], [107, 124635], [115, 125075], [119, 125235], [131, 125895], [134, 126135]]}, {"verse": 12, "start": 127909, "end": 143253, "text": "Por tanto yo le daré parte con los grandes, y con los fuertes repartirá despojos; por cuanto derramó su vida hasta la muerte, y fue contado con los perversos, habiendo él llevado el pecado de muchos, y orado por los transgresores.", "words": [[0, 127909], [4, 128041], [10, 128901], [13, 129221], [16, 129361], [21, 129621], [27, 129941], [31, 130181], [35, 130321], [44, 130701], [46, 131341], [50, 131501], [54, 131661], [62, 132241], [72, 132901], [82, 134249], [86, 134393], [93, 134653], [101, 135213], [104, 135353], [109, 135653], [115, 135853], [118, 136013], [126, 136393], [128, 136913], [132, 137093], [140, 137653], [144, 137853], [148, 137973], [159, 138993], [168, 139453], [171, 139693], [179, 140153], [182, 140233], [189, 140593], [192, 140733], [200, 141053], [202, 141553], [208, 141913], [212, 142093], [216, 142673]]}]}