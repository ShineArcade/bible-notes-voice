{"book": "PSA", "chapter": 68, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 246232, "verses": [{"verse": 1, "start": 300, "end": 6525, "text": "Let God arise, let his enemies be scattered: let them also that hate him flee before him.", "words": [[0, 300], [4, 488], [8, 788], [15, 1908], [19, 2028], [23, 2168], [31, 2588], [34, 2848], [45, 3902], [49, 4045], [54, 4245], [59, 4585], [64, 4865], [69, 5125], [73, 5325], [78, 5625], [85, 5985]]}, {"verse": 2, "start": 6975, "end": 15633, "text": "As smoke is driven away, so drive them away: as wax melts before the fire, so let the wicked perish at the presence of God.", "words": [[0, 6975], [3, 7141], [9, 7501], [12, 7741], [19, 8041], [25, 8781], [28, 8921], [34, 9301], [39, 9581], [45, 10380], [48, 10531], [52, 10831], [58, 11231], [65, 11671], [69, 11931], [75, 12751], [78, 12991], [82, 13191], [86, 13331], [93, 13611], [100, 14131], [103, 14371], [107, 14491], [116, 14831], [119, 15111]]}, {"verse": 3, "start": 16083, "end": 22473, "text": "But let the righteous be glad; let them rejoice before God: yes, let them exceedingly rejoice.", "words": [[0, 16083], [4, 16192], [8, 16332], [12, 16492], [22, 16792], [25, 17132], [31, 18064], [35, 18192], [40, 18392], [48, 18812], [55, 19252], [60, 20237], [65, 20743], [69, 20843], [74, 21063], [86, 21703]]}, {"verse": 4, "start": 22923, "end": 31746, "text": "Sing to God, sing praises to his name: extol him that rides upon the heavens by his name Jah, and rejoice before him.", "words": [[0, 22923], [5, 23208], [8, 23448], [13, 24248], [18, 24408], [26, 24968], [29, 25208], [33, 25408], [39, 26268], [45, 26815], [49, 27035], [54, 27255], [60, 27615], [65, 27955], [69, 28215], [77, 28475], [80, 28815], [84, 29055], [89, 29605], [94, 30155], [98, 30435], [106, 30775], [113, 31235]]}, {"verse": 5, "start": 32196, "end": 37676, "text": "A father of the fatherless, and a judge of the widows, is God in his holy habitation.", "words": [[0, 32196], [2, 32277], [9, 32597], [12, 32877], [16, 32997], [28, 33617], [32, 34037], [34, 34157], [40, 34457], [43, 34717], [47, 34837], [55, 35357], [58, 35817], [62, 36137], [65, 36357], [69, 36497], [74, 36777]]}, {"verse": 6, "start": 38126, "end": 46576, "text": "God sets the solitary in families: he brings out those which are bound with chains: but the rebellious dwell in a dry land.", "words": [[0, 38126], [4, 38433], [9, 38713], [13, 38953], [22, 39453], [25, 39813], [35, 40847], [38, 40928], [45, 41228], [49, 41468], [55, 41788], [61, 42088], [65, 42208], [71, 42568], [76, 42808], [84, 43853], [88, 44010], [92, 44150], [103, 44830], [109, 45130], [112, 45450], [114, 45570], [118, 45890]]}, {"verse": 7, "start": 47026, "end": 52733, "text": "O God, when you went forth before your people, when you did march through the wilderness; Selah:", "words": [[0, 47073], [2, 47163], [7, 47703], [12, 47823], [16, 47963], [21, 48143], [27, 48463], [34, 48883], [39, 49103], [47, 49723], [52, 49823], [56, 49963], [60, 50183], [66, 50483], [74, 50763], [78, 50903], [90, 52359]]}, {"verse": 8, "start": 53183, "end": 61871, "text": "The earth shook, the heavens also dropped at the presence of God: even Sinai itself was moved at the presence of God, the God of Israel.", "words": [[0, 53183], [4, 53263], [10, 53623], [17, 53963], [21, 54203], [29, 54783], [34, 55063], [42, 55503], [45, 55683], [49, 55803], [58, 56123], [61, 56383], [66, 57246], [71, 57493], [77, 58073], [84, 58453], [88, 58813], [94, 59193], [97, 59373], [101, 59473], [110, 59773], [113, 60013], [118, 60733], [122, 60853], [126, 61133], [129, 61253]]}, {"verse": 9, "start": 62321, "end": 68539, "text": "You, O God, did send a plentiful rain, by which you did confirm your inheritance, when it was weary.", "words": [[0, 62321], [5, 62766], [7, 62846], [12, 63446], [16, 63606], [21, 64026], [23, 64166], [33, 64586], [39, 64946], [42, 65486], [48, 65726], [52, 65886], [56, 66126], [64, 66606], [69, 66826], [82, 67366], [87, 67766], [90, 67886], [94, 68006]]}, {"verse": 10, "start": 68989, "end": 75355, "text": "Your congregation has dwelt in it: you, O God, have prepared of your goodness for the poor.", "words": [[0, 68989], [5, 69153], [18, 69793], [22, 70233], [28, 70593], [31, 70753], [35, 71299], [40, 71857], [42, 71977], [47, 72917], [52, 73097], [61, 73577], [64, 73837], [69, 73977], [78, 74357], [82, 74677], [86, 74777]]}, {"verse": 11, "start": 75805, "end": 80275, "text": "The Lord gave the word: great was the company of those that published it.", "words": [[0, 75805], [4, 75904], [9, 76184], [14, 76484], [18, 76724], [24, 77565], [30, 77855], [34, 78155], [38, 78355], [46, 78695], [49, 78975], [55, 79215], [60, 79495], [70, 79835]]}, {"verse": 12, "start": 80725, "end": 85699, "text": "Kings of armies did flee apace: and she that stayed at home divided the spoil.", "words": [[0, 80725], [6, 80967], [9, 81187], [16, 81527], [20, 81847], [25, 82167], [32, 83097], [36, 83211], [40, 83451], [45, 83731], [52, 84031], [55, 84231], [60, 84471], [68, 84871], [72, 85151]]}, {"verse": 13, "start": 86149, "end": 93732, "text": "Though you have lain among the pots, yet shall you be as the wings of a dove covered with silver, and her feathers with yellow gold.", "words": [[0, 86149], [7, 86325], [11, 86505], [16, 86705], [21, 86985], [27, 87205], [31, 87445], [37, 88225], [41, 88565], [47, 88885], [51, 89085], [54, 89245], [57, 89445], [61, 89585], [67, 89865], [70, 90105], [72, 90225], [77, 90505], [85, 90925], [90, 91185], [98, 91945], [102, 92125], [106, 92265], [115, 92565], [120, 92885], [127, 93145]]}, {"verse": 14, "start": 94182, "end": 98446, "text": "When the Almighty scattered kings in it, it was white as snow in Salmon.", "words": [[0, 94182], [5, 94332], [9, 94432], [18, 94872], [28, 95352], [34, 95752], [37, 96012], [41, 96492], [44, 96592], [48, 96792], [54, 97092], [57, 97252], [62, 97612], [65, 97852]]}, {"verse": 15, "start": 98896, "end": 103609, "text": "The hill of God is as the hill of Bashan; a high hill as the hill of Bashan.", "words": [[0, 98896], [4, 98983], [9, 99163], [12, 99283], [16, 99563], [19, 99763], [22, 99923], [26, 100103], [31, 100303], [34, 100774], [42, 101486], [44, 101592], [49, 101892], [54, 102192], [57, 102472], [61, 102632], [66, 102792], [69, 103226]]}, {"verse": 16, "start": 104059, "end": 111111, "text": "Why do you leap, you high hills? this is the hill which God desires to dwell in; yes, the LORD will dwell in it for ever.", "words": [[0, 104059], [4, 104225], [7, 104365], [11, 104485], [17, 104905], [21, 105005], [26, 105285], [33, 106167], [38, 106335], [41, 106475], [45, 106635], [50, 106875], [56, 107115], [60, 107415], [68, 107915], [71, 108175], [77, 108435], [81, 109116], [86, 109463], [90, 109543], [95, 109783], [100, 109963], [106, 110183], [109, 110403], [112, 110659], [116, 110916]]}, {"verse": 17, "start": 111561, "end": 119290, "text": "The chariots of God are twenty thousand, even thousands of angels: the Lord is among them, as in Sinai, in the holy place.", "words": [[0, 111561], [4, 111641], [13, 112181], [16, 112301], [20, 112601], [24, 113034], [31, 113468], [41, 113901], [46, 114081], [56, 114621], [59, 114921], [67, 115944], [71, 116049], [76, 116309], [79, 116509], [85, 116769], [91, 117269], [94, 117449], [97, 117629], [104, 118209], [107, 118349], [111, 118449], [116, 118649]]}, {"verse": 18, "start": 119740, "end": 129897, "text": "You have ascended on high, you have led captivity captive: you have received gifts for men; yes, for the rebellious also, that the LORD God might dwell among them.", "words": [[0, 119740], [4, 119887], [9, 120027], [18, 120487], [21, 120687], [27, 121547], [31, 121647], [36, 121787], [40, 121987], [50, 122647], [59, 123685], [63, 123831], [68, 124051], [77, 124411], [83, 124751], [87, 125051], [92, 125769], [97, 126136], [101, 126216], [105, 126336], [116, 126896], [122, 127716], [127, 127836], [131, 127976], [136, 128176], [140, 128536], [146, 128856], [152, 129116], [158, 129396]]}, {"verse": 19, "start": 130347, "end": 136903, "text": "Blessed be the Lord, who daily loads us with benefits, even the God of our salvation. Selah.", "words": [[0, 130347], [8, 130617], [11, 130997], [15, 131177], [21, 131837], [25, 131997], [31, 132317], [37, 132657], [40, 132877], [45, 133077], [55, 134037], [60, 134337], [64, 134537], [68, 134797], [71, 134937], [75, 135097], [86, 136592]]}, {"verse": 20, "start": 137353, "end": 143341, "text": "He that is our God is the God of salvation; and to GOD the Lord belong the issues from death.", "words": [[0, 137353], [3, 137677], [8, 137897], [11, 138057], [15, 138237], [19, 138557], [22, 138897], [26, 139037], [30, 139257], [33, 139377], [44, 140449], [48, 140586], [51, 140706], [55, 141046], [59, 141306], [64, 141506], [71, 141866], [75, 142126], [82, 142486], [87, 142786]]}, {"verse": 21, "start": 143791, "end": 150825, "text": "But God shall wound the head of his enemies, and the hairy scalp of such a one as goes on still in his trespasses.", "words": [[0, 143791], [4, 143900], [8, 144220], [14, 144520], [20, 144900], [24, 145120], [29, 145360], [32, 145480], [36, 145620], [45, 146360], [49, 146600], [53, 146740], [59, 147000], [65, 147460], [68, 147700], [73, 147980], [75, 148100], [79, 148320], [82, 148520], [87, 148740], [90, 149080], [96, 149440], [99, 149660], [103, 149820]]}, {"verse": 22, "start": 151275, "end": 157684, "text": "The Lord said, I will bring again from Bashan, I will bring my people again from the depths of the sea:", "words": [[0, 151275], [4, 151371], [9, 151551], [15, 152364], [17, 152502], [22, 152642], [28, 152902], [34, 153202], [39, 153762], [47, 154322], [49, 154662], [54, 154802], [60, 155042], [63, 155242], [70, 155542], [76, 155882], [81, 156122], [85, 156242], [92, 156542], [95, 156782], [99, 156902]]}, {"verse": 23, "start": 158134, "end": 162978, "text": "That your foot may be dipped in the blood of your enemies, and the tongue of your dogs in the same.", "words": [[0, 158134], [5, 158262], [10, 158382], [15, 158682], [19, 158882], [22, 158982], [29, 159222], [32, 159442], [36, 159522], [42, 159742], [45, 159902], [50, 160022], [59, 160842], [63, 160962], [67, 161062], [74, 161242], [77, 161402], [82, 161522], [87, 161882], [90, 162062], [94, 162182]]}, {"verse": 24, "start": 163328, "end": 168982, "text": "They have seen your goings, O God; even the goings of my God, my King, in the sanctuary.", "words": [[0, 163328], [5, 163470], [10, 163630], [15, 163910], [20, 164130], [28, 164790], [30, 164850], [35, 165660], [40, 165882], [44, 166062], [51, 166542], [54, 166622], [57, 166802], [62, 167342], [65, 167442], [71, 167962], [74, 168042], [78, 168162]]}, {"verse": 25, "start": 169432, "end": 176024, "text": "The singers went before, the players on instruments followed after; among them were the young women playing with timbrels.", "words": [[0, 169432], [4, 169519], [12, 169819], [17, 170099], [25, 170739], [29, 170839], [37, 171139], [40, 171359], [52, 171819], [61, 172219], [68, 173139], [74, 173339], [79, 173659], [84, 173859], [88, 173999], [94, 174259], [100, 174559], [108, 174999], [113, 175239]]}, {"verse": 26, "start": 176474, "end": 180602, "text": "Bless God in the congregations, even the Lord, from the fountain of Israel.", "words": [[0, 176474], [6, 176724], [10, 177204], [13, 177404], [17, 177504], [32, 178484], [37, 178644], [41, 178844], [47, 179324], [52, 179464], [56, 179604], [65, 179884], [68, 180084]]}, {"verse": 27, "start": 181052, "end": 188618, "text": "There is little Benjamin with their ruler, the princes of Judah and their council, the princes of Zebulun, and the princes of Naphtali.", "words": [[0, 181052], [6, 181187], [9, 181327], [16, 181587], [25, 182027], [30, 182307], [36, 182507], [43, 183387], [47, 183447], [55, 183747], [58, 184047], [64, 184327], [68, 184647], [74, 184767], [83, 185667], [87, 185767], [95, 186087], [98, 186347], [107, 186967], [111, 187247], [115, 187347], [123, 187627], [126, 188146]]}, {"verse": 28, "start": 189068, "end": 194578, "text": "Your God has commanded your strength: strengthen, O God, that which you have wrought for us.", "words": [[0, 189068], [5, 189195], [9, 189515], [13, 189735], [23, 190115], [28, 190415], [38, 191292], [50, 191892], [52, 192052], [57, 192932], [62, 193092], [68, 193292], [72, 193532], [77, 193692], [85, 193992], [89, 194172]]}, {"verse": 29, "start": 195028, "end": 198738, "text": "Because of your temple at Jerusalem shall kings bring presents to you.", "words": [[0, 195028], [8, 195250], [11, 195490], [16, 195610], [23, 195970], [26, 196170], [36, 196930], [42, 197050], [48, 197430], [54, 197780], [63, 198130], [66, 198450]]}, {"verse": 30, "start": 199188, "end": 210343, "text": "Rebuke the company of spearmen, the multitude of the bulls, with the calves of the people, till every one submit himself with pieces of silver: scatter the people that delight in war.", "words": [[0, 199188], [7, 199821], [11, 199921], [19, 200301], [22, 200541], [32, 201181], [36, 201381], [46, 201881], [49, 202141], [53, 202261], [60, 202861], [65, 203001], [69, 203141], [76, 203541], [79, 203761], [83, 203881], [91, 204261], [96, 204634], [102, 205008], [106, 205381], [113, 205861], [121, 206341], [126, 206601], [133, 206961], [136, 207161], [144, 208094], [152, 208535], [156, 208715], [163, 208995], [168, 209215], [176, 209495], [179, 209755]]}, {"verse": 31, "start": 210793, "end": 216000, "text": "Princes shall come out of Egypt; Ethiopia shall soon stretch out her hands to God.", "words": [[0, 210793], [8, 211104], [14, 211484], [19, 211704], [23, 211924], [26, 212044], [33, 212920], [42, 213402], [48, 213882], [53, 214202], [61, 214542], [65, 214822], [69, 214982], [75, 215262], [78, 215462]]}, {"verse": 32, "start": 216450, "end": 221595, "text": "Sing to God, you kingdoms of the earth; O sing praises to the Lord; Selah:", "words": [[0, 216450], [5, 216696], [8, 216896], [13, 217256], 