{"book": "ISA", "chapter": 42, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 238727, "verses": [{"verse": 1, "start": 300, "end": 11107, "text": "He aquí mi siervo, yo le sostendré; mi escogido, en quien mi alma toma contentamiento: he puesto sobre él mi espíritu, dará justicia a las naciones.", "words": [[0, 345], [3, 425], [8, 665], [11, 845], [19, 1705], [22, 1945], [25, 2065], [36, 3375], [39, 3498], [49, 4138], [52, 4578], [58, 4718], [61, 4938], [66, 5178], [71, 5478], [87, 7187], [90, 7267], [97, 7527], [103, 7887], [106, 8107], [109, 8227], [119, 9247], [124, 9507], [133, 10107], [135, 10207], [139, 10347]]}, {"verse": 2, "start": 11813, "end": 15548, "text": "No clamará, ni alzará, ni hará oír su voz en las calles.", "words": [[0, 11813], [3, 11978], [12, 12518], [15, 12718], [23, 13278], [26, 13658], [31, 13938], [35, 14178], [38, 14358], [42, 14598], [45, 14718], [49, 14858]]}, {"verse": 3, "start": 16250, "end": 22014, "text": "No quebrará la caña cascada, ni apagará la mecha que humea: sacará el juicio a verdad.", "words": [[0, 16250], [3, 16411], [12, 16891], [15, 17011], [20, 17311], [29, 17911], [32, 18411], [40, 18931], [43, 18991], [49, 19311], [53, 19471], [60, 20532], [67, 20974], [70, 21034], [77, 21434], [79, 21554]]}, {"verse": 4, "start": 22748, "end": 30208, "text": "No se cansará, ni desmayará, hasta que ponga en la tierra juicio; y las islas esperarán su ley.", "words": [[0, 22748], [3, 22932], [6, 23152], [15, 23772], [18, 24292], [29, 25392], [35, 25752], [39, 25932], [45, 26352], [48, 26432], [51, 26552], [58, 26852], [66, 28177], [68, 28298], [72, 28458], [78, 28938], [88, 29678], [91, 29838]]}, {"verse": 5, "start": 30798, "end": 45480, "text": "Así dice el Dios Jehová, el Creador de los cielos, y el que los extiende; el que extiende la tierra y sus verduras; el que da aliento al pueblo que mora sobre ella, y espíritu a los que por ella andan:", "words": [[0, 30798], [4, 31042], [9, 31422], [12, 31582], [17, 31822], [25, 32822], [28, 32902], [36, 33522], [39, 33682], [43, 33822], [51, 34522], [53, 34822], [56, 34962], [60, 35082], [64, 35242], [74, 36542], [77, 36670], [81, 36810], [90, 37410], [93, 37590], [100, 38030], [102, 38190], [106, 38370], [116, 39682], [119, 39799], [123, 39953], [126, 40106], [134, 40746], [137, 40946], [144, 41226], [148, 41506], [153, 41866], [159, 42106], [165, 42506], [167, 43026], [176, 43906], [178, 44046], [182, 44146], [186, 44286], [190, 44486], [195, 44686]]}, {"verse": 6, "start": 45730, "end": 55091, "text": "Yo Jehová te he llamado en justicia, y te tendré por la mano; te guardaré y te pondré por pacto del pueblo, por luz de las naciones;", "words": [[0, 45730], [3, 45992], [10, 46472], [13, 46532], [16, 46652], [24, 46952], [27, 47192], [37, 47952], [39, 48432], [42, 48552], [49, 48972], [53, 49152], [56, 49312], [62, 50373], [65, 50451], [74, 51031], [76, 51411], [79, 51531], [86, 51931], [90, 52111], [96, 52591], [100, 52731], [108, 53431], [112, 53671], [116, 53891], [119, 54091], [123, 54251]]}, {"verse": 7, "start": 55777, "end": 64329, "text": "Para que abras ojos de ciegos, para que saques de la cárcel a los presos, y de casas de prisión a los que están de asiento en tinieblas.", "words": [[0, 55777], [5, 55939], [9, 56119], [15, 56499], [20, 56819], [23, 57099], [31, 57759], [36, 58219], [40, 58399], [47, 58799], [50, 58959], [53, 59079], [60, 59539], [62, 59639], [66, 59759], [74, 60399], [76, 60859], [79, 61039], [85, 61399], [88, 61519], [96, 62019], [98, 62219], [102, 62359], [106, 62499], [112, 62759], [115, 62919], [123, 63359], [126, 63539]]}, {"verse": 8, "start": 65009, "end": 72141, "text": "Yo Jehová: este es mi nombre; y a otro no daré mi gloria, ni mi alabanza a esculturas.", "words": [[0, 65300], [3, 65626], [11, 66504], [16, 66805], [19, 66945], [22, 67085], [30, 68373], [32, 68511], [34, 68611], [39, 68931], [42, 69171], [47, 69491], [50, 69551], [58, 70271], [61, 70431], [64, 70551], [73, 71131], [75, 71231]]}, {"verse": 9, "start": 72824, "end": 80674, "text": "Las cosas primeras he aquí vinieron, y yo anuncio nuevas cosas: antes que salgan a luz, yo os las haré notorias.", "words": [[0, 72824], [4, 72966], [10, 73266], [19, 73926], [22, 74126], [27, 74326], [37, 74846], [39, 75366], [42, 75506], [50, 75946], [57, 76226], [64, 77530], [70, 77814], [74, 78034], [81, 78474], [83, 78554], [88, 79154], [91, 79454], [94, 79574], [98, 79734], [103, 80034]]}, {"verse": 10, "start": 81308, "end": 92694, "text": "Cantad a Jehová un nuevo cántico, su alabanza desde el fin de la tierra; los que descendéis al mar, y lo que la llena, las islas y los habitantes de ellas.", "words": [[0, 81530], [7, 81790], [9, 81950], [16, 82370], [19, 82510], [25, 82750], [34, 84010], [37, 84150], [46, 84870], [52, 85130], [55, 85410], [59, 85670], [62, 85810], [65, 85910], [73, 86912], [77, 87018], [81, 87138], [92, 87738], [95, 87968], [100, 88198], [102, 89018], [105, 89158], [109, 89288], [112, 89418], [119, 90258], [123, 90378], [129, 90798], [131, 91258], [135, 91358], [146, 91938], [149, 92158]]}, {"verse": 11, "start": 93144, "end": 105504, "text": "Alcen la voz el desierto y sus ciudades, las aldeas donde habita Cedar: canten los habitantes de la Piedra, y desde la cumbre de los montes den voces de júbilo.", "words": [[0, 93144], [6, 93568], [9, 93788], [13, 94048], [16, 94348], [25, 94988], [27, 95188], [31, 95348], [41, 96488], [45, 96588], [52, 97328], [58, 97848], [65, 98444], [72, 99287], [79, 99753], [83, 99973], [94, 100653], [97, 100793], [100, 100913], [108, 101773], [110, 101933], [116, 102113], [119, 102313], [126, 102773], [129, 102913], [133, 103033], [140, 103693], [144, 104013], [150, 104553], [153, 104833]]}, {"verse": 12, "start": 105954, "end": 110344, "text": "Den gloria a Jehová, y prediquen sus loores en las islas.", "words": [[0, 106167], [4, 106413], [11, 106660], [13, 106940], [21, 107640], [23, 107820], [33, 108500], [37, 108840], [44, 109180], [47, 109420], [51, 109600]]}, {"verse": 13, "start": 110794, "end": 120031, "text": "Jehová saldrá como gigante, y como hombre de guerra despertará celo: gritará, voceará, se esforzará sobre sus enemigos.", "words": [[0, 110794], [7, 111219], [14, 111679], [19, 111839], [28, 112539], [30, 112919], [35, 113159], [42, 113559], [45, 113719], [52, 114059], [63, 114899], [69, 115949], [78, 116933], [87, 117713], [90, 117833], [100, 118633], [106, 118913], [110, 119193]]}, {"verse": 14, "start": 120331, "end": 130643, "text": "Desde el siglo he callado, tenido he silencio, y me he detenido: daré voces como la que está de parto; asolaré y devoraré juntamente.", "words": [[0, 120331], [6, 120595], [9, 120855], [15, 121195], [18, 121455], [27, 122455], [34, 122705], [37, 122955], [47, 123575], [49, 123995], [52, 124135], [55, 124275], [65, 125569], [70, 125892], [76, 126272], [81, 126532], [84, 126672], [88, 126812], [93, 127152], [96, 127492], [103, 128376], [111, 129013], [113, 129253], [122, 129713]]}, {"verse": 15, "start": 131334, "end": 139339, "text": "Tornaré en soledad montes y collados, haré secar toda su hierba; los ríos tornaré en islas, y secaré los estanques.", "words": [[0, 131334], [8, 131755], [11, 131855], [19, 132315], [26, 132915], [28, 133015], [38, 133935], [43, 134395], [49, 134795], [54, 134955], [57, 135235], [65, 136379], [69, 136509], [74, 136889], [82, 137409], [85, 137509], [92, 137849], [94, 138169], [101, 138549], [105, 138689]]}, {"verse": 16, "start": 140072, "end": 155414, "text": "Y guiaré los ciegos por camino que no sabían, les haré pisar por las sendas que no habían conocido; delante de ellos tornaré las tinieblas en luz, y los rodeos en llanura. Estas cosas les haré, y no los desampararé.", "words": [[0, 140072], [2, 140197], [9, 140557], [13, 140677], [20, 141197], [24, 141417], [31, 141817], [35, 142037], [38, 142197], [46, 143037], [50, 143197], [55, 143497], [61, 143837], [65, 143997], [69, 144197], [76, 144657], [80, 144777], [83, 144937], [90, 145177], [100, 146468], [108, 147108], [111, 147268], [117, 147468], [125, 148008], [129, 148168], [139, 148788], [142, 148928], [147, 149148], [149, 149548], [153, 149688], [160, 150208], [163, 150368], [172, 151442], [178, 151884], [184, 152224], [188, 152524], [194, 153144], [196, 153384], [199, 153564], [203, 153724]]}, {"verse": 17, "start": 155995, "end": 166878, "text": "Serán vueltos atrás, y en extremo confundidos, los que confían en las esculturas, y dicen a las estatuas de fundición: Vosotros sois nuestros dioses.", "words": [[0, 155995], [6, 156338], [14, 156778], [21, 157138], [23, 157658], [26, 157778], [34, 158378], [47, 159358], [51, 159978], [55, 160138], [63, 160738], [66, 160918], [70, 161078], [82, 161958], [84, 162458], [90, 162858], [92, 163158], [96, 163298], [105, 163858], [108, 163938], [119, 165039], [128, 165476], [133, 165856], [142, 166016]]}, {"verse": 18, "start": 167178, "end": 171162, "text": "Sordos, oíd; y vosotros ciegos, mirad para ver.", "words": [[0, 167493], [8, 167833], [13, 168695], [15, 168792], [24, 169252], [32, 170192], [38, 170532], [43, 170732]]}, {"verse": 19, "start": 171847, "end": 181088, "text": "¿Quién ciego, sino mi siervo? ¿quién sordo, como mi mensajero que envié? ¿quién ciego como el perfecto, y ciego como el siervo de Jehová,", "words": [[0, 171847], [7, 172071], [14, 172431], [19, 172711], [22, 172891], [30, 174090], [37, 174274], [44, 174694], [49, 174954], [52, 175134], [62, 175734], [66, 175934], [73, 176999], [80, 177218], [86, 177558], [91, 177798], [94, 177918], [104, 178818], [106, 178958], [112, 179318], [117, 179538], [120, 179788], [127, 180038], [130, 180158]]}, {"verse": 20, "start": 181757, "end": 186253, "text": "Que ve muchas cosas y no advierte, que abre los oídos y no oye?", "words": [[0, 181757], [4, 181853], [7, 181993], [14, 182233], [20, 182773], [22, 182993], [25, 183113], [35, 184073], [39, 184273], [44, 184493], [48, 184693], [54, 185333], [56, 185493], [59, 185673]]}, {"verse": 21, "start": 186827, "end": 192205, "text": "Jehová se complació por amor de su justicia en magnificar la ley y engrandecerla.", "words": [[0, 186827], [7, 187319], [10, 187399], [20, 188119], [24, 188339], [29, 188539], [32, 188759], [35, 188919], [44, 189579], [47, 189699], [58, 190359], [61, 190539], [65, 190819], [67, 191079]]}, {"verse": 22, "start": 192655, "end": 207569, "text": "Mas este es pueblo saqueado y pisoteado, todos ellos enlazados en cavernas y escondidos en cárceles: son puestos a saco, y no hay quien libre; hollados, y no hay quien diga, Restituid.", "words": [[0, 192655], [4, 192882], [9, 193482], [12, 193682], [19, 194202], [28, 194942], [30, 195062], [41, 196162], [47, 196382], [53, 196742], [63, 197602], [66, 197822], [75, 198602], [77, 198962], [88, 199622], [91, 199882], [101, 201071], [105, 201318], [113, 201898], [115, 201998], [121, 202538], [123, 202778], [126, 202958], [130, 203138], [136, 203378], [143, 204636], [153, 204926], [155, 205366], [158, 205546], [162, 205706], [168, 205926], [174, 206773]]}, {"verse": 23, "start": 208019, "end": 213757, "text": "¿Quién de vosotros oirá esto? ¿quién atenderá y escuchará en orden al porvenir?", "words": [[0, 208019], [7, 208243], [10, 208343], [19, 208823], [24, 209383], [30, 210289], [37, 210453], [46, 211273], [48, 211453], [58, 212053], [61, 212233], [67, 212493], [70, 212853]]}, {"verse": 24, "start": 214207, "end": 225740, "text": "¿Quién dio a Jacob en botín, y entregó a Israel a saqueadores? ¿No fue Jehová, contra quien pecamos? y no quisieron andar en sus caminos, ni oyeron su ley.", "words": [[0, 214207], [7, 214391], [11, 214671], [13, 214911], [19, 215271], [22, 215591], [29, 216231], [31, 216711], [39, 217351], [41, 217491], [48, 217971], [50, 218251], [63, 219475], [67, 219605], [71, 219825], [79, 220345], [86, 220585], [92, 220845], [101, 222126], [103, 222234], [106, 222334], [116, 222814], [122, 223114], [125, 223314], [129, 223454], [138, 224094], [141, 224534], [148, 224994], [151, 225154]]}, {"verse": 25, "start": 226190, "end": 238327, "text": "Por tanto derramó sobre él el furor de su ira, y fuerza de guerra; le puso fuego de todas partes, pero no entendió; y le encendió, mas no lo ha tomado en cuenta.", "words": [[0, 226190], [4, 226314], [10, 226714], [18, 227454], [24, 227714], [27, 228034], [30, 228314], [36, 228794], [39, 228934], [42, 229174], [47, 229814], [49, 230014], [56, 230494], [59, 230754], [67, 231609], [70, 231736], [75, 232076], [81, 232376], [84, 232616], [90, 232776], [98, 233856], [103, 234116], [106, 234316], [116, 235363], [118, 235484], [121, 235604], [131, 236604], [135, 236704], [138, 236904], [141, 237064], [144, 237184], [151, 237604], [154, 237744]]}]}