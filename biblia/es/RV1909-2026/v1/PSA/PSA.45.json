{"book": "PSA", "chapter": 45, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 135725, "verses": [{"verse": 1, "start": 300, "end": 16233, "text": "Al Músico principal: sobre Sosannim: para los hijos de Coré: Masquil: Canción de amores. REBOSA mi corazón palabra buena: refiero yo al Rey mis obras: mi lengua es pluma de escribiente muy ligero.", "words": [[0, 300], [3, 489], [10, 989], [21, 2078], [27, 2848], [37, 3839], [42, 4003], [46, 4183], [52, 4443], [55, 4663], [61, 5831], [70, 6478], [78, 6878], [81, 7078], [89, 8276], [96, 8586], [99, 8766], [107, 9406], [115, 9646], [122, 10916], [130, 11366], [133, 11586], [136, 11806], [140, 12086], [144, 12206], [151, 13020], [154, 13166], [161, 13566], [164, 13686], [170, 14126], [173, 14326], [185, 15006], [189, 15366]]}, {"verse": 2, "start": 16583, "end": 25695, "text": "Te has hermoseado más que los hijos de los hombres; la gracia se derramó en tus labios: por tanto Dios te ha bendecido para siempre.", "words": [[0, 16583], [3, 16907], [7, 17267], [18, 17627], [22, 17787], [26, 17967], [30, 18167], [36, 18427], [39, 18607], [43, 18727], [52, 19660], [55, 19960], [62, 20480], [65, 20620], [73, 21200], [76, 21280], [80, 21440], [88, 22210], [92, 22332], [98, 23212], [103, 23612], [106, 23852], [109, 24012], [119, 24632], [124, 24872]]}, {"verse": 3, "start": 26045, "end": 31535, "text": "Cíñete tu espada sobre el muslo, oh valiente, con tu gloria y con tu majestad.", "words": [[0, 26338], [7, 26668], [10, 26908], [17, 27468], [23, 27788], [26, 27988], [33, 28338], [36, 28688], [46, 29588], [50, 29948], [53, 30148], [60, 30688], [62, 30808], [66, 30988], [69, 31261]]}, {"verse": 4, "start": 31885, "end": 42004, "text": "Y en tu gloria sé prosperado: cabalga sobre palabra de verdad, y de humildad, y de justicia; y tu diestra te enseñará cosas terribles.", "words": [[0, 31885], [2, 32268], [5, 32388], [8, 32641], [15, 32895], [18, 33148], [30, 34303], [38, 34806], [44, 35126], [52, 35446], [55, 35746], [63, 36026], [65, 36646], [68, 36766], [78, 37526], [80, 37686], [83, 37786], [93, 38911], [95, 39061], [98, 39221], [106, 39721], [109, 39941], [118, 40541], [124, 40861]]}, {"verse": 5, "start": 42354, "end": 49757, "text": "Tus flechas agudas con que caerán pueblos debajo de ti, penetrarán en el corazón de los enemigos del Rey.", "words": [[0, 42378], [4, 42438], [12, 42838], [19, 43558], [23, 44038], [27, 44218], [34, 44678], [42, 45178], [49, 45558], [52, 45738], [56, 45998], [67, 47278], [70, 47478], [73, 47618], [81, 48098], [84, 48438], [88, 48558], [97, 49138], [101, 49338]]}, {"verse": 6, "start": 50107, "end": 56046, "text": "Tu trono, oh Dios, eterno y para siempre: vara de justicia la vara de tu reino.", "words": [[0, 50107], [3, 50194], [10, 50601], [13, 51007], [19, 51414], [26, 52094], [28, 52154], [33, 52374], [42, 53398], [47, 53763], [50, 53883], [59, 54696], [62, 54838], [67, 55078], [70, 55218], [73, 55398]]}, {"verse": 7, "start": 56396, "end": 65267, "text": "Amaste la justicia y aborreciste la maldad: por tanto te ungió Dios, el Dios tuyo, con óleo de gozo sobre tus compañeros.", "words": [[0, 56631], [7, 56881], [10, 57061], [19, 57821], [21, 58381], [33, 58941], [36, 59001], [44, 59793], [48, 59915], [54, 60195], [57, 60415], [63, 60795], [69, 61635], [72, 61775], [77, 61975], [83, 62815], [87, 63125], [92, 63435], [95, 63685], [100, 63935], [106, 64135], [110, 64315]]}, {"verse": 8, "start": 65617, "end": 73466, "text": "Mirra, áloe, y casia exhalan todos tus vestidos: en estancias de marfil te han recreado.", "words": [[0, 65893], [7, 66213], [13, 66813], [15, 67223], [21, 67633], [29, 68653], [35, 68953], [39, 69313], [49, 70467], [52, 70626], [62, 71326], [65, 71639], [72, 71953], [75, 72266], [79, 72486]]}, {"verse": 9, "start": 73816, "end": 79736, "text": "Hijas de reyes entre tus ilustres: está la reina a tu diestra con oro de Ofir.", "words": [[0, 73816], [6, 74257], [9, 74357], [15, 74737], [21, 75157], [25, 75517], [35, 76646], [40, 76986], [43, 77166], [49, 77606], [51, 77786], [54, 77926], [62, 78306], [66, 78606], [70, 78966], [73, 79206]]}, {"verse": 10, "start": 80086, "end": 86749, "text": "Oye, hija, y mira, e inclina tu oído; y olvida tu pueblo, y la casa de tu padre;", "words": [[0, 80086], [5, 80484], [11, 81304], [13, 81384], [19, 81664], [21, 82164], [29, 82904], [32, 83044], [38, 83802], [40, 83948], [47, 84368], [50, 84528], [58, 84928], [60, 85448], [63, 85588], [68, 85868], [71, 86068], [74, 86228]]}, {"verse": 11, "start": 87099, "end": 93120, "text": "Y deseará el rey tu hermosura: e inclínate a él, porque él es tu Señor.", "words": [[0, 87099], [2, 87359], [10, 87979], [13, 88239], [17, 88559], [20, 88679], [31, 89724], [33, 90344], [43, 90964], [45, 91184], [49, 91584], [56, 91884], [59, 92224], [62, 92524], [65, 92604]]}, {"verse": 12, "start": 93470, "end": 99572, "text": "Y las hijas de Tiro vendrán con presente; implorarán tu favor los ricos del pueblo.", "words": [[0, 93470], [2, 93597], [6, 93777], [12, 94177], [15, 94317], [20, 94737], [28, 95352], [32, 95492], [42, 96665], [53, 97469], [56, 97589], [62, 97849], [66, 98209], [72, 98609], [76, 98809]]}, {"verse": 13, "start": 99922, "end": 105991, "text": "Toda ilustre es de dentro la hija del rey: de brocado de oro es su vestido.", "words": [[0, 99922], [5, 100382], [13, 101082], [16, 101302], [19, 101462], [26, 101842], [29, 102132], [34, 102422], [38, 102622], [43, 103367], [46, 103495], [54, 103955], [57, 104195], [61, 104455], [64, 104895], [67, 105135]]}, {"verse": 14, "start": 106341, "end": 112936, "text": "Con vestidos bordados será llevada al rey; vírgenes en pos de ella: sus compañeras serán traídas a ti.", "words": [[0, 106341], [4, 106465], [13, 106865], [22, 107405], [27, 107705], [35, 108225], [38, 108405], [43, 109019], [52, 109457], [55, 109757], [59, 109937], [62, 110137], [68, 110821], [72, 110941], [83, 111401], [89, 111861], [97, 112521], [99, 112641]]}, {"verse": 15, "start": 113286, "end": 118621, "text": "Serán traídas con alegría y gozo: entrarán en el palacio del rey.", "words": [[0, 113286], [6, 113745], [14, 114325], [18, 114545], [26, 115365], [28, 115465], [34, 116266], [43, 117006], [46, 117226], [49, 117366], [57, 117926], [61, 118146]]}, {"verse": 16, "start": 118971, "end": 125370, "text": "En lugar de tus padres serán tus hijos, a quienes harás príncipes en toda la tierra.", "words": [[0, 118971], [3, 119140], [9, 119380], [12, 119640], [16, 119820], [23, 120280], [29, 120975], [33, 121135], [40, 121995], [42, 122275], [50, 122495], [56, 123115], [66, 123895], [69, 124135], [74, 124455], [77, 124675]]}, {"verse": 17, "start": 125720, "end": 135325, "text": "Haré perpetua la memoria de tu nombre en todas las generaciones: por lo cual te alabarán los pueblos eternamente y para siempre.", "words": [[0, 125720], [5, 126156], [14, 126956], [17, 127076], [25, 127556], [28, 127716], [31, 127876], [38, 128216], [41, 128576], [47, 128896], [51, 129196], [65, 130550], [69, 130694], [72, 130854], [77, 131174], [80, 131394], [89, 131994], [93, 132134], [101, 132694], [113, 133894], [115, 134194], [120, 134454]]}]}