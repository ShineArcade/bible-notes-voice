{"book": "LUK", "chapter": 21, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 300213, "verses": [{"verse": 1, "start": 300, "end": 6203, "text": "Y mirando, vio a los ricos que echaban sus ofrendas en la caja de las ofrendas.", "words": [[0, 300], [2, 438], [11, 898], [15, 1238], [17, 1358], [21, 1458], [27, 1838], [31, 2018], [39, 2378], [43, 2578], [52, 3178], [55, 3318], [58, 3458], [63, 3818], [66, 3938], [70, 4058]]}, {"verse": 2, "start": 6653, "end": 11504, "text": "Y vio también una viuda pobrecilla, que echaba allí dos monedas de poco valor.", "words": [[0, 6653], [2, 6653], [6, 6653], [14, 6653], [18, 6837], [24, 7217], [36, 8097], [40, 8557], [47, 9077], [52, 9397], [56, 9817], [64, 10557], [67, 10677], [72, 10917]]}, {"verse": 3, "start": 11954, "end": 16656, "text": "Y dijo: De verdad os digo, que esta pobre viuda echó más que todos:", "words": [[0, 11954], [2, 12098], [8, 12867], [11, 13014], [18, 13234], [21, 13474], [27, 14334], [31, 14534], [36, 14694], [42, 15001], [48, 15307], [53, 15614], [57, 15794], [61, 15954]]}, {"verse": 4, "start": 17106, "end": 25417, "text": "Porque todos estos, de lo que les sobra echaron para las ofrendas de Dios; pero esta de su pobreza echó todo el sustento que tenía.", "words": [[0, 17106], [7, 17312], [13, 17612], [20, 18032], [23, 18292], [26, 18412], [30, 18532], [34, 18812], [40, 19092], [48, 19552], [53, 19792], [57, 19992], [66, 20572], [69, 20692], [75, 21550], [80, 21692], [85, 21932], [88, 22132], [91, 22292], [99, 22792], [104, 23292], [109, 23752], [112, 23992], [121, 24512], [125, 24732]]}, {"verse": 5, "start": 25867, "end": 31514, "text": "Y a unos que decían del templo, que estaba adornado de hermosas piedras y dones, dijo:", "words": [[0, 25867], [2, 25974], [4, 26094], [9, 26314], [13, 26574], [20, 27074], [24, 27294], [32, 27954], [36, 28034], [43, 28334], [52, 29194], [55, 29354], [64, 29894], [72, 30394], [74, 30554], [81, 30954]]}, {"verse": 6, "start": 31964, "end": 38265, "text": "Estas cosas que veis, días vendrán que no quedará piedra sobre piedra que no sea destruida.", "words": [[0, 31964], [6, 32408], [12, 32768], [16, 33028], [22, 33488], [27, 34008], [35, 34668], [39, 34828], [42, 34988], [50, 35428], [57, 35968], [63, 36268], [70, 36808], [74, 36928], [77, 37088], [81, 37328]]}, {"verse": 7, "start": 38715, "end": 46936, "text": "Y le preguntaron, diciendo: Maestro, ¿cuándo será esto? ¿y qué señal habrá cuando estas cosas hayan de comenzar a ser hechas?", "words": [[0, 38715], [2, 38823], [5, 38903], [18, 39583], [28, 41351], [37, 42030], [45, 42330], [50, 42510], [56, 43354], [59, 43455], [63, 43575], [69, 44055], [75, 44355], [82, 44495], [88, 44815], [94, 45175], [100, 45575], [103, 45635], [112, 46155], [114, 46235], [118, 46415]]}, {"verse": 8, "start": 47286, "end": 59891, "text": "Él entonces dijo: Mirad, no seáis engañados; porque vendrán muchos en mi nombre, diciendo: Yo soy; y, El tiempo está cerca: por tanto, no vayáis en pos de ellos.", "words": [[0, 47286], [3, 47530], [12, 47990], [18, 49339], [25, 49659], [28, 49839], [34, 50019], [45, 51507], [52, 51724], [60, 52204], [67, 52544], [70, 52804], [73, 52964], [81, 53304], [91, 54404], [94, 54608], [99, 55367], [102, 55512], [105, 55632], [112, 56032], [117, 56272], [124, 57282], [128, 57389], [135, 58049], [138, 58309], [145, 58789], [148, 58959], [152, 59129], [155, 59369]]}, {"verse": 9, "start": 60341, "end": 70592, "text": "Pero cuando oigáis guerras y sediciones, no os espantéis; porque es necesario que estas cosas acontezcan primero; pero el fin no será inmediatamente.", "words": [[0, 60341], [5, 60489], [12, 60789], [19, 61429], [27, 61949], [29, 62109], [41, 63269], [44, 63469], [47, 63689], [58, 64941], [65, 65188], [68, 65308], [78, 65908], [82, 66088], [88, 66268], [94, 66568], [105, 67348], [114, 68299], [119, 68463], [122, 68563], [126, 68763], [129, 68963], [134, 69203]]}, {"verse": 10, "start": 71042, "end": 77086, "text": "Entonces les dijo: Se levantará nación contra nación, y reino contra reino;", "words": [[0, 71042], [9, 71518], [13, 72038], [19, 72869], [22, 73031], [32, 73551], [39, 73951], [46, 74311], [54, 74851], [56, 75401], [62, 75951], [69, 76541]]}, {"verse": 11, "start": 77536, "end": 86390, "text": "Y habrá grandes terremotos, y en varios lugares hambrunas y epidemias: y habrá espantos y grandes señales del cielo.", "words": [[0, 77536], [2, 77664], [8, 78004], [16, 78284], [28, 79244], [30, 79524], [33, 79664], [40, 79944], [48, 80384], [58, 81544], [60, 81784], [71, 83206], [73, 83286], [79, 83546], [88, 84346], [90, 84526], [98, 84846], [106, 85566], [110, 85786]]}, {"verse": 12, "start": 86840, "end": 100244, "text": "Pero antes de todas estas cosas os echarán mano, y perseguirán, entregándoos a las sinagogas y a las cárceles, siendo llevados a los reyes y a los gobernadores por causa de mi nombre.", "words": [[0, 86840], [5, 86981], [11, 87321], [14, 87521], [20, 87761], [26, 88121], [32, 88581], [35, 88781], [43, 89301], [49, 89741], [51, 90461], [64, 91581], [77, 92701], [79, 92881], [83, 93001], [93, 93861], [95, 94001], [97, 94061], [101, 94181], [111, 95326], [118, 95766], [127, 96366], [129, 96526], [133, 96666], [139, 97266], [141, 97566], [143, 97646], [147, 97766], [160, 98526], [164, 98826], [170, 99226], [173, 99526], [176, 99646]]}, {"verse": 13, "start": 100694, "end": 102839, "text": "Y os será para testimonio.", "words": [[0, 100752], [2, 100852], [5, 100952], [10, 101452], [15, 101732]]}, {"verse": 14, "start": 103289, "end": 107918, "text": "Poned pues en vuestros corazones no pensar antes cómo habéis de responder:", "words": [[0, 103415], [6, 103575], [11, 103815], [14, 104035], [23, 104395], [33, 105155], [36, 105635], [43, 105975], [49, 106375], [54, 106715], [61, 107055], [64, 107195]]}, {"verse": 15, "start": 108368, "end": 116032, "text": "Porque yo os daré boca y sabiduría, a la cual no podrán resistir ni contradecir todos los que se os opondrán.", "words": [[0, 108368], [7, 108592], [10, 108742], [13, 108892], [18, 109332], [23, 109592], [25, 109792], [36, 110552], [38, 110992], [41, 111032], [46, 111252], [49, 111452], [56, 111892], [65, 112442], [68, 112992], [80, 113892], [86, 114532], [90, 114852], [94, 115012], [97, 115192], [100, 115292]]}, {"verse": 16, "start": 116482, "end": 124856, "text": "Pero seréis entregados aun de vuestros padres, y hermanos, y parientes, y amigos; y matarán a algunos de vosotros.", "words": [[0, 116482], [5, 116647], [12, 117147], [23, 117887], [27, 118107], [30, 118287], [39, 118567], [47, 118987], [49, 119407], [59, 120127], [61, 120307], [72, 120967], [74, 121307], [82, 122356], [84, 122477], [92, 123137], [94, 123317], [102, 123677], [105, 123917]]}, {"verse": 17, "start": 125306, "end": 128763, "text": "Y seréis aborrecidos de todos por causa de mi nombre.", "words": [[0, 125306], [2, 125412], [9, 125812], [21, 126612], [24, 126772], [30, 127092], [34, 127432], [40, 127752], [43, 128032], [46, 128132]]}, {"verse": 18, "start": 129213, "end": 132071, "text": "Pero un pelo de vuestra cabeza no perecerá.", "words": [[0, 129213], [5, 129356], [8, 129536], [13, 129956], [16, 130216], [24, 130576], [31, 130956], [34, 131541]]}, {"verse": 19, "start": 132521, "end": 135626, "text": "En vuestra paciencia poseeréis vuestras almas.", "words": [[0, 132521], [3, 132822], [11, 133142], [21, 133802], [31, 134562], [40, 134982]]}, {"verse": 20, "start": 136076, "end": 143266, "text": "Y cuando veáis a Jerusalén rodeada de ejércitos, sabed entonces que su destrucción ha llegado.", "words": [[0, 136076], [2, 136181], [9, 136441], [15, 137001], [17, 137161], [27, 137881], [35, 138501], [38, 138721], [49, 139881], [55, 140361], [64, 140761], [68, 141201], [71, 141441], [83, 142301], [86, 142521]]}, {"verse": 21, "start": 143716, "end": 154769, "text": "Entonces los que estén en Judea, huyan a los montes; y los que estén en la ciudad, salgan; y los que estén en los campos, no entren en ella.", "words": [[0, 143716], [9, 144343], [13, 145023], [17, 145203], [23, 145563], [26, 145703], [33, 146263], [39, 146703], [41, 146923], [45, 147063], [53, 148116], [55, 148196], [59, 148316], [63, 148456], [69, 148736], [72, 148836], [75, 148916], [83, 149667], [91, 150665], [93, 150786], [97, 150926], [101, 151126], [107, 151466], [110, 151566], [114, 151706], [122, 152786], [125, 153226], [132, 153846], [135, 154226]]}, {"verse": 22, "start": 155219, "end": 161428, "text": "Porque estos son días de venganza: para que se cumplan todas las cosas que están escritas.", "words": [[0, 155219], [7, 155442], [13, 155762], [17, 156122], [22, 156422], [25, 156622], [35, 157794], [40, 157962], [44, 158102], [47, 158262], [55, 158822], [61, 159302], [65, 159682], [71, 160082], [75, 160282], [81, 160522]]}, {"verse": 23, "start": 161878, "end": 172752, "text": "Pero ¡ay de las embarazadas, y de las que amamantan en aquellos días! porque habrá gran angustia sobre la tierra e ira en este pueblo.", "words": [[0, 161878], [5, 162213], [9, 162583], [12, 163183], [16, 163343], [29, 164323], [31, 165023], [34, 165143], [38, 165323], [42, 165543], [52, 166623], [55, 166743], [64, 167023], [70, 168204], [77, 168410], [83, 168870], [88, 169270], [97, 170170], [103, 170410], [106, 170630], [113, 171070], [115, 171410], [119, 171810], [122, 171950], [127, 172130]]}, {"verse": 24, "start": 173202, "end": 185770, "text": "Y caerán a filo de espada, y serán llevados cautivos a todas las naciones: y Jerusalén será pisoteada por los gentiles, hasta que los tiempos de los gentiles sean cumplidos.", "words": [[0, 173202], [2, 173339], [9, 173899], [11, 173959], [16, 174339], [19, 174459], [27, 175059], [29, 175719], [35, 176039], [44, 176459], [53, 177079], [55, 177259], [61, 177559], [65, 177839], [75, 178994], [77, 179120], [87, 179900], [92, 180280], [102, 181020], [106, 181260], [110, 181420], [120, 182140], [126, 182640], [130, 182860], [134, 183000], [142, 183520], [145, 183620], [149, 183720], [158, 184300], [163, 184700]]}, {"verse": 25, "start": 186219, "end": 198537, "text": "Entonces habrá señales en el sol, y en la luna, y en las estrellas; y en la tierra angustia de gentes por la confusión del sonido del mar y de las olas:", "words": [[0, 186219], [9, 186701], [15, 187321], [23, 187961], [26, 188161], [29, 188321], [34, 189281], [36, 189321], [39, 189481], [42, 189641], [48, 190601], [50, 190641], [53, 190781], [57, 190961], [68, 192315], [70, 192725], [73, 192825], [76, 192965], [83, 193345], [92, 194225], [95, 194345], [102, 194805], [106, 195045], [109, 195165], [119, 195985], [123, 196225], [130, 196785], [134, 196985], [138, 197325], [140, 197565], [143, 197685], [147, 197825]]}, {"verse": 26, "start": 198987, "end": 210525, "text": "Desfalleciendo los hombres a causa del temor y expectación de las cosas que sobrevendrán al mundo: porque las potencias de los cielos serán conmovidas.", "words": [[0, 198987], [15, 200075], [19, 200315], [27, 200735], [29, 200975], [35, 201255], [39, 201575], [45, 202255], [47, 202555], [59, 203535], [62, 203755], [66, 203915], [72, 204395], [76, 204935], [89, 205835], [92, 205955], [99, 206838], [106, 207020], [110, 207240], [120, 207900], [123, 208080], [127, 208200], [134, 208820], [140, 209420]]}, {"verse": 27, "start": 210975, "end": 217463, "text": "Y entonces verán al Hijo del hombre, que vendrá en una nube con poder y majestad grande.", "words": [[0, 210975], [2, 211099], [11, 211499], [17, 212259], [20, 212519], [25, 212779], [29, 212939], [37, 213459], [41, 214059], [48, 214519], [51, 214639], [55, 214819], [60, 215219], [64, 215459], [70, 215919], [72, 216219], [81, 216759]]}, {"verse": 28, "start": 217913, "end": 225886, "text": "Y cuando estas cosas comiencen a hacerse, mirad, y levantad vuestras cabezas, porque vuestra redención está cerca.", "words": [[0, 217913], [2, 217998], [9, 218198], [15, 218458], [21, 218798], [31, 219458], [33, 219598], [42, 220158], [49, 220718], [51, 221388], [60, 222058], [69, 222498], [78, 223318], [85, 223738], [93, 224348], [103, 224958], [108, 225218]]}, {"verse": 29, "start": 226336, "end": 231533, "text": "Y les dijo una parábola: Mirad la higuera y todos los árboles:", "words": [[0, 226336], [2, 226465], [6, 226585], [11, 226845], [15, 227085], [25, 228234], [31, 228434], [34, 228554], [42, 229054], [44, 229214], [50, 229374], [54, 229654]]}, {"verse": 30, "start": 231983, "end": 236997, "text": "Cuando ya brotan, viéndolo, de vosotros mismos entendéis que el verano está ya cerca.", "words": [[0, 231983], [7, 231983], [10, 231983], [18, 231983], [28, 232509], [31, 232729], [40, 233169], [47, 233769], [57, 234309], [61, 234529], [64, 234649], [71, 235049], [76, 235289], [79, 235469]]}, {"verse": 31, "start": 237447, "end": 243803, "text": "Así también vosotros, cuando veáis que suceden estas cosas, sabed que está cerca el reino de Dios.", "words": [[0, 237447], [4, 237671], [12, 238011], [22, 238691], [29, 238851], [35, 239331], [39, 239511], [47, 240131], [53, 240351], [60, 241351], [66, 241771], [70, 241951], [75, 242111], [81, 242471], [84, 242731], [90, 243131], [93, 243291]]}, {"verse": 32, "start": 244253, "end": 249272, "text": "De cierto os digo, que no pasará esta generación hasta que todo sea hecho.", "words": [[0, 244253], [3, 244401], [10, 245021], [13, 245101], [19, 245301], [23, 245481], [26, 245681], [33, 246161], [38, 246501], [49, 247321], [55, 247881], [59, 248121], [64, 248341], [68, 248661]]}, {"verse": 33, "start": 249722, "end": 254370, "text": "El cielo y la tierra pasarán; pero mis palabras no pasarán.", "words": [[0, 249722], [3, 249864], [9, 250284], [11, 250564], [14, 250684], [21, 250964], [30, 252260], [35, 252384], [39, 252564], [48, 253004], [51, 253524]]}, {"verse": 34, "start": 254820, "end": 267269, "text": "Y mirad por vosotros, que vuestros corazones no sean cargados de glotonería y embriaguez, y de las preocupaciones de esta vida, y venga de repente sobre vosotros aquel día.", "words": [[0, 254820], [2, 254984], [8, 255384], [12, 255604], [22, 256224], [26, 256704], [35, 257104], [45, 257664], [48, 257884], [53, 258204], [62, 258824], [65, 259314], [76, 259804], [78, 260304], [90, 260804], [92, 261284], [95, 261657], [99, 262031], [114, 262404], [117, 262584], [122, 262824], [128, 263804], [130, 264064], [136, 264404], [139, 264544], [147, 264964], [153, 265504], [162, 266324], [168, 266764]]}, {"verse": 35, "start": 267719, "end": 274565, "text": "Porque como un lazo vendrá sobre todos los que habitan sobre la faz de toda la tierra.", "words": [[0, 267719], [7, 267961], [12, 268321], [15, 268521], [20, 268981], [27, 269481], [33, 269821], [39, 270341], [43, 270981], [47, 271201], [55, 271781], [61, 272081], [64, 272301], [68, 272701], [71, 273301], [76, 273561], [79, 273821]]}, {"verse": 36, "start": 275015, "end": 286544, "text": "Velad pues, orando en todo tiempo, que seáis tenidos por dignos de evitar todas estas cosas que han de venir, y de estar en pie delante del Hijo del hombre.", "words": [[0, 275015], [6, 275619], [12, 276159], [19, 276779], [22, 276979], [27, 277159], [35, 278299], [39, 278519], [45, 278979], [53, 279539], [57, 279819], [64, 280419], [67, 280559], [74, 280899], [80, 281439], [86, 281899], [92, 282339], [96, 282559], [100, 282699], [103, 282799], [110, 283139], [112, 283599], [115, 283759], [121, 284039], [124, 284279], [128, 284639], [136, 285239], [140, 285479], [145, 285739], [149, 285939]]}, {"verse": 37, "start": 286994, "end": 294087, "text": "Y enseñaba de día en el templo; y de noche saliendo, se estaba en el monte que se llama de los Olivos.", "words": [[0, 286994], [2, 287175], [11, 287915], [14, 288075], [18, 288315], [21, 288475], [24, 288595], [32, 289553], [34, 289679], [37, 289779], [43, 289999], [53, 290759], [56, 291299], [63, 291599], [66, 291759], [69, 291899], [75, 292219], [79, 292479], [82, 292599], [88, 292899], [91, 293059], [95, 293179]]}, {"verse": 38, "start": 294537, "end": 299813, "text": "Y todo el pueblo venía a él por la mañana, para oírle en el templo.", "words": [[0, 294537], [2, 294662], [7, 294922], [10, 295142], [17, 295462], [23, 296002], [25, 296282], [28, 296462], [32, 296682], [35, 296862], [43, 297322], [48, 298162], [54, 298862], [57, 299062], [60, 299202]]}]}