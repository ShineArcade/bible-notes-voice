{"book": "JHN", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 428307, "verses": [{"verse": 1, "start": 300, "end": 7962, "text": "Estaba entonces enfermo uno llamado Lázaro, de Betania, la aldea de María y de Marta su hermana.", "words": [[0, 300], [7, 684], [16, 1184], [24, 1984], [28, 2304], [36, 2664], [44, 3344], [47, 3824], [56, 5124], [59, 5204], [65, 5724], [68, 5884], [74, 6184], [76, 6544], [79, 6664], [85, 7104], [88, 7304]]}, {"verse": 2, "start": 8412, "end": 17346, "text": "(Y María, cuyo hermano Lázaro estaba enfermo, era la que ungió al Señor con perfume, y limpió sus pies con sus cabellos.)", "words": [[0, 8412], [3, 8538], [10, 8938], [15, 9418], [23, 9858], [30, 10358], [37, 10658], [46, 11858], [50, 12278], [53, 12478], [57, 12858], [63, 13238], [66, 13518], [72, 13898], [76, 14258], [85, 14878], [87, 15158], [94, 15678], [98, 15878], [103, 16098], [107, 16378], [111, 16518]]}, {"verse": 3, "start": 17796, "end": 24237, "text": "Enviaron, pues, sus hermanas a él, diciendo: Señor, he aquí, el que amas está enfermo.", "words": [[0, 17796], [10, 18324], [16, 18964], [20, 19084], [29, 19584], [31, 19784], [35, 19984], [45, 21090], [52, 21950], [55, 22070], [61, 22450], [64, 22830], [68, 23010], [73, 23350], [78, 23570]]}, {"verse": 4, "start": 24587, "end": 35050, "text": "Y oyéndolo Jesús, dijo: Esta enfermedad no es para muerte, sino para la gloria de Dios, para que el Hijo de Dios sea glorificado por ella.", "words": [[0, 24587], [2, 24931], [11, 25311], [18, 25551], [24, 26591], [29, 26818], [40, 27538], [43, 27678], [46, 27798], [51, 27998], [59, 29078], [64, 29458], [69, 29778], [72, 29938], [79, 30358], [82, 30518], [88, 31458], [93, 31778], [97, 31998], [100, 32278], [105, 32578], [108, 32738], [113, 33038], [117, 33438], [129, 34298], [133, 34538]]}, {"verse": 5, "start": 35500, "end": 39885, "text": "Y amaba Jesús a Marta, y a su hermana, y a Lázaro.", "words": [[0, 35500], [2, 35606], [8, 36046], [14, 36266], [16, 36546], [23, 37386], [25, 37766], [27, 37826], [30, 37986], [39, 39006], [41, 39319], [43, 39631]]}, {"verse": 6, "start": 40335, "end": 45561, "text": "Cuando oyó pues que estaba enfermo, se quedó aún dos días en aquel lugar donde estaba.", "words": [[0, 40335], [7, 40628], [11, 40958], [16, 41218], [20, 41398], [27, 41638], [36, 42298], [39, 42458], [45, 42778], [49, 43098], [53, 43318], [58, 43638], [61, 43918], [67, 44258], [73, 44518], [79, 44818]]}, {"verse": 7, "start": 46011, "end": 50895, "text": "Luego, después de esto, dijo a los discípulos: Vamos a Judea otra vez.", "words": [[0, 46011], [7, 46466], [15, 46666], [18, 46946], [24, 47486], [29, 47786], [31, 47946], [35, 48046], [47, 49184], [53, 49430], [55, 49590], [61, 50070], [66, 50330]]}, {"verse": 8, "start": 51345, "end": 57279, "text": "Le dicen los discípulos: Rabí, ahora procuraban los judíos apedrearte, ¿y otra vez vas allá?", "words": [[0, 51345], [3, 51565], [9, 51885], [13, 52145], [25, 53421], [31, 53591], [37, 53771], [48, 54391], [52, 54571], [59, 55161], [71, 55751], [74, 56111], [79, 56291], [83, 56631], [87, 56831]]}, {"verse": 9, "start": 57629, "end": 65143, "text": "Respondió Jesús: ¿No tiene el día doce horas? El que anda de día, no tropieza, porque ve la luz de este mundo.", "words": [[0, 57629], [10, 58118], [17, 59095], [21, 59199], [27, 59439], [30, 59639], [34, 59839], [39, 60039], [46, 61022], [49, 61174], [53, 61314], [58, 61474], [61, 61674], [66, 61954], [69, 62334], [79, 62954], [86, 63454], [89, 63654], [92, 63794], [96, 64054], [99, 64274], [104, 64454]]}, {"verse": 10, "start": 65593, "end": 70434, "text": "Pero el que anda de noche, tropieza, porque no hay luz en él.", "words": [[0, 65593], [5, 65739], [8, 65919], [12, 66079], [17, 66319], [20, 66499], [27, 66999], [37, 68179], [44, 68599], [47, 68839], [51, 69159], [55, 69479], [58, 70019]]}, {"verse": 11, "start": 70884, "end": 77272, "text": "Dicho esto, les dice después: Lázaro nuestro amigo duerme; pero voy a despertarle del sueño.", "words": [[0, 70884], [6, 71123], [12, 71363], [16, 71563], [21, 71823], [30, 72853], [37, 73590], [45, 73810], [51, 74170], [59, 75125], [64, 75289], [68, 75509], [70, 75609], [82, 76449], [86, 76589]]}, {"verse": 12, "start": 77722, "end": 83062, "text": "Dijeron entonces sus discípulos: Señor, si duerme, se recuperará.", "words": [[0, 77722], [8, 78268], [17, 78768], [21, 79128], [33, 81193], [40, 81673], [43, 81713], [51, 82053], [54, 82253]]}, {"verse": 13, "start": 83412, "end": 90062, "text": "Pero esto decía Jesús de la muerte de él: y ellos pensaron que hablaba del reposar del sueño.", "words": [[0, 83412], [5, 83555], [10, 83835], [16, 84255], [22, 84715], [25, 85175], [28, 85295], [35, 85595], [38, 85993], [42, 86618], [44, 86918], [50, 87158], [59, 87858], [63, 88058], [71, 88438], [75, 88618], [83, 89198], [87, 89338]]}, {"verse": 14, "start": 90512, "end": 95817, "text": "Entonces, pues, Jesús les dijo claramente: Lázaro ha muerto;", "words": [[0, 90512], [10, 91388], [16, 91908], [22, 92308], [26, 92708], [31, 93048], [43, 94243], [50, 94790], [53, 95190]]}, {"verse": 15, "start": 96267, "end": 102721, "text": "Y me alegro por vosotros, que yo no haya estado allí, para que creáis: pero vamos a él.", "words": [[0, 96267], [2, 96409], [5, 96529], [12, 96969], [16, 97209], [26, 97869], [30, 98489], [33, 98649], [36, 98829], [41, 99089], [48, 99409], [54, 99829], [59, 100389], [63, 100589], [71, 101723], [76, 101849], [82, 102109], [84, 102349]]}, {"verse": 16, "start": 103171, "end": 112440, "text": "Dijo entonces Tomás, el que se dice el Dídimo, a sus condiscípulos: Vamos también nosotros, para que muramos con él.", "words": [[0, 103171], [5, 103631], [14, 104151], [21, 105031], [24, 105271], [28, 105431], [31, 105591], [36, 105951], [39, 106351], [47, 107011], [49, 107471], [53, 108281], [68, 109274], [74, 109491], [82, 109811], [92, 110191], [97, 110551], [101, 110691], [109, 111071], [113, 111311]]}, {"verse": 17, "start": 112790, "end": 118227, "text": "Vino pues Jesús, y halló que había ya cuatro días que estaba en el sepulcro.", "words": [[0, 112790], [5, 113056], [10, 113316], [17, 114316], [19, 114616], [25, 115016], [29, 115236], [35, 115456], [38, 115676], [45, 116056], [50, 116536], [54, 116736], [61, 117016], [64, 117196], [67, 117336]]}, {"verse": 18, "start": 118677, "end": 123076, "text": "Y Betania estaba cerca de Jerusalén, como quince estadios;", "words": [[0, 118677], [2, 118903], [10, 119443], [17, 119863], [23, 120243], [26, 120503], [37, 121223], [42, 121643], [49, 122063]]}, {"verse": 19, "start": 123526, "end": 130107, "text": "Y muchos de los judíos habían venido a Marta y a María, a consolarlas de su hermano.", "words": [[0, 123526], [2, 123648], [9, 123948], [12, 124128], [16, 124248], [23, 124688], [30, 124888], [37, 125388], [39, 125508], [45, 125988], [47, 126328], [49, 126408], [56, 127208], [58, 127288], [70, 128088], [73, 128228], [76, 128348]]}, {"verse": 20, "start": 130557, "end": 137074, "text": "Entonces Marta, cuando oyó que Jesús venía, salió a encontrarle; pero María se estuvo en casa.", "words": [[0, 130557], [9, 130557], [16, 131176], [23, 131486], [27, 131796], [31, 131956], [37, 132196], [44, 133096], [50, 133556], [52, 133776], [65, 135146], [70, 135427], [76, 135727], [79, 135967], [86, 136287], [89, 136447]]}, {"verse": 21, "start": 137524, "end": 143820, "text": "Y Marta dijo a Jesús: Señor, si hubieses estado aquí, mi hermano no habría muerto;", "words": [[0, 137524], [2, 137806], [8, 138126], [13, 138346], [15, 138546], [22, 139413], [29, 140237], [32, 140358], [41, 140758], [48, 141078], [54, 141918], [57, 142058], [65, 142598], [68, 142758], [75, 143138]]}, {"verse": 22, "start": 144270, "end": 150240, "text": "Pero también sé ahora, que todo lo que pidas a Dios, Dios te lo dará.", "words": [[0, 144270], [5, 144421], [13, 144771], [16, 145121], [23, 145521], [27, 145981], [32, 146201], [35, 146401], [39, 146541], [45, 146841], [47, 147001], [53, 147721], [58, 147901], [61, 148141], [64, 148261]]}, {"verse": 23, "start": 150590, "end": 153835, "text": "Le dice Jesús: Resucitará tu hermano.", "words": [[0, 150590], [3, 150706], [8, 150966], [15, 152060], [26, 153042], [29, 153182]]}, {"verse": 24, "start": 154285, "end": 160366, "text": "Marta le dice: Yo sé que resucitará en la resurrección en el día postrero.", "words": [[0, 154285], [6, 154831], [9, 154971], [15, 155762], [18, 155945], [21, 156125], [25, 156285], [36, 157145], [39, 157325], [42, 157425], [55, 158305], [58, 158565], [61, 158705], [65, 158945]]}, {"verse": 25, "start": 160716, "end": 168201, "text": "Le dice Jesús: Yo soy la resurrección y la vida: el que cree en mí, aunque esté muerto, vivirá.", "words": [[0, 160716], [3, 160832], [8, 161092], [15, 162186], [18, 162371], [22, 162671], [25, 163331], [38, 164251], [40, 164491], [43, 164611], [49, 165399], [52, 165547], [56, 165687], [61, 166027], [64, 166407], [68, 167027], [75, 167207], [80, 167467], [88, 167834]]}, {"verse": 26, "start": 168651, "end": 174852, "text": "Y todo aquel que vive y cree en mí, no morirá eternamente. ¿Crees esto?", "words": [[0, 169258], [2, 169738], [7, 169958], [13, 170398], [17, 170498], [22, 170798], [24, 171058], [29, 171338], [32, 171678], [36, 171918], [39, 172378], [46, 172838], [59, 174076], [66, 174302]]}, {"verse": 27, "start": 175302, "end": 181449, "text": "Le dice: Sí, Señor; yo he creído que tú eres el Cristo, el Hijo de Dios, que has venido al mundo.", "words": [[0, 175302], [3, 175448], [9, 176210], [13, 176535], [20, 177312], [23, 177460], [26, 177560], [33, 177860], [37, 178020], [40, 178200], [45, 178420], [48, 178580], [56, 179300], [59, 179380], [64, 179600], [67, 179720], [73, 180280], [77, 180340], [81, 180500], [88, 180820], [91, 180960]]}, {"verse": 28, "start": 181799, "end": 190901, "text": "Habiendo dicho esto, fue y llamó a María su hermana, diciéndole en secreto: El Maestro está aquí y te llama.", "words": [[0, 181799], [9, 182187], [15, 182507], [21, 182807], [25, 183627], [27, 183867], [33, 184227], [35, 184327], [41, 184587], [44, 184927], [53, 186087], [64, 187007], [67, 187407], [76, 188513], [79, 188643], [87, 189223], [92, 189523], [97, 189923], [99, 190203], [102, 190343]]}, {"verse": 29, "start": 191251, "end": 195188, "text": "Ella, como lo oyó, se levanta rápidamente y viene a él.", "words": [[0, 191251], [6, 191476], [11, 191756], [14, 192046], [19, 192336], [22, 192936], [30, 193436], [42, 194156], [44, 194356], [50, 194596], [52, 194796]]}, {"verse": 30, "start": 195638, "end": 202396, "text": "(Que aún no había llegado Jesús a la aldea, pero estaba en aquel lugar donde Marta le había encontrado.)", "words": [[0, 195638], [5, 195740], [9, 195960], [12, 196200], [18, 196420], [26, 196880], [32, 197200], [34, 197580], [37, 197740], [44, 198340], [49, 198800], [56, 199100], [59, 199300], [65, 199600], [71, 199900], [77, 200260], [83, 200860], [86, 201180], [92, 201420]]}, {"verse": 31, "start": 202846, "end": 216479, "text": "Entonces los judíos que estaban en casa con ella, y la consolaban, cuando vieron que María se había levantado rápidamente, y había salido, la siguieron, diciendo: Va al sepulcro a llorar allí.", "words": [[0, 202846], [9, 203859], [13, 204119], [20, 204659], [24, 204779], [32, 205059], [35, 205219], [40, 205459], [44, 205759], [50, 206039], [52, 206519], [55, 206659], [67, 208059], [74, 208139], [81, 208479], [85, 208659], [91, 208919], [94, 209199], [100, 209399], [110, 209959], [123, 210819], [125, 211279], [131, 211499], [139, 212379], [142, 212479], [153, 213079], [163, 214556], [166, 214820], [169, 214980], [178, 215580], [180, 215760], [187, 216060]]}, {"verse": 32, "start": 216829, "end": 229261, "text": "Pero María, cuando vino donde estaba Jesús, viéndole, se derribó a sus pies, diciéndole: Señor, si hubieras estado aquí, no habría muerto mi hermano.", "words": [[0, 216829], [5, 216973], [12, 217333], [19, 217713], [24, 218093], [30, 218333], [37, 218713], [44, 219733], [54, 220633], [57, 220773], [65, 221333], [67, 221433], [71, 221593], [77, 222113], [89, 223232], [96, 224374], [99, 224514], [108, 224994], [115, 225354], [121, 226194], [124, 226314], [131, 226694], [138, 227054], [141, 227214]]}, {"verse": 33, "start": 229611, "end": 239615, "text": "Jesús entonces, como la vio llorando, y a los judíos que habían venido juntamente con ella llorando, se conmovió en espíritu, y se turbó,", "words": [[0, 229611], [6, 229941], [16, 230641], [21, 230821], [24, 230961], [28, 231161], [38, 231721], [40, 232201], [42, 232301], [46, 232401], [53, 232941], [57, 233061], [64, 233301], [71, 233741], [82, 234321], [86, 234511], [91, 234701], [101, 235861], [104, 235941], [113, 236601], [116, 236681], [126, 237741], [128, 237961], [131, 238101]]}, {"verse": 34, "start": 240065, "end": 244736, "text": "Y dijo: ¿Dónde le pusisteis? Le dicen: Señor, ven, y ve.", "words": [[0, 240256], [2, 240481], [8, 241007], [15, 241007], [18, 241007], [29, 242673], [32, 242995], [39, 243557], [46, 243812], [51, 244102], [53, 244442]]}, {"verse": 35, "start": 245086, "end": 246102, "text": "Y lloró Jesús.", "words": [[0, 245086], [2, 245273], [8, 245493]]}, {"verse": 36, "start": 246552, "end": 249975, "text": "Dijeron entonces los judíos: Mirad cómo le amaba.", "words": [[0, 246552], [8, 247097], [17, 247557], [21, 247837], [29, 248872], [35, 249170], [40, 249390], [43, 249550]]}, {"verse": 37, "start": 250325, "end": 256570, "text": "Y algunos de ellos dijeron: ¿No podía este que abrió los ojos al ciego, hacer que este no muriera?", "words": [[0, 250325], [2, 250446], [10, 250766], [13, 251006], [19, 251326], [28, 252629], [32, 252754], [38, 253034], [43, 253434], [47, 253574], [53, 253854], [57, 254014], [62, 254274], [65, 254514], [72, 255154], [78, 255394], [82, 255614], [87, 255834], [90, 255974]]}, {"verse": 38, "start": 256920, "end": 265538, "text": "Y Jesús, conmoviéndose otra vez en sí mismo, vino al sepulcro. Era una cueva, la cual tenía una piedra encima.", "words": [[0, 256920], [2, 257049], [9, 257809], [23, 258749], [28, 259049], [32, 259329], [35, 259529], [38, 259709], [45, 260809], [50, 261049], [53, 261249], [63, 262362], [67, 262548], [71, 262748], [78, 263488], [81, 263588], [86, 263808], [92, 264188], [96, 264428], [103, 264848]]}, {"verse": 39, "start": 265988, "end": 275597, "text": "Dice Jesús: Quitad la piedra. Marta, la hermana del que se había muerto, le dice: Señor, ya huele mal, porque lleva cuatro días muerto.", "words": [[0, 265988], [5, 266510], [12, 267470], [19, 267832], [22, 267992], [30, 268860], [37, 269427], [40, 269547], [48, 269780], [52, 270014], [56, 270247], [59, 270467], [65, 270667], [73, 271247], [76, 271347], [82, 272151], [89, 272469], [92, 272769], [98, 273109], [103, 273409], [110, 273829], [116, 274109], [123, 274409], [128, 274789]]}, {"verse": 40, "start": 275947, "end": 281274, "text": "Jesús le dice: ¿No te he dicho que, si crees, verás la gloria de Dios?", "words": [[0, 275947], [6, 276282], [9, 276522], [15, 277436], [19, 277561], [22, 277741], [25, 277821], [31, 278081], [36, 278321], [39, 278881], [46, 279481], [52, 280021], [55, 280141], [62, 280541], [65, 280681]]}, {"verse": 41, "start": 281724, "end": 293201, "text": "Entonces quitaron la piedra de donde el muerto había sido puesto. Y Jesús, alzando los ojos arriba, dijo: Padre, gracias te doy que me has oído.", "words": [[0, 281724], [9, 282415], [18, 283215], [21, 283395], [28, 283915], [31, 284055], [37, 284315], [40, 284535], [47, 284995], [53, 285215], [58, 285555], [66, 286592], [68, 286701], [75, 287541], [83, 288021], [87, 288241], [92, 288581], [100, 289441], [106, 290247], [113, 290913], [121, 291833], [124, 292013], [128, 292233], [132, 292313], [135, 292453], [139, 292593]]}, {"verse": 42, "start": 293651, "end": 301955, "text": "Que yo sabía que siempre me oyes; pero por causa de la multitud que está alrededor, lo dije, para que crean que tú me has enviado.", "words": [[0, 293651], [4, 293735], [7, 293875], [13, 294255], [17, 294375], [25, 294735], [28, 295015], [34, 295901], [39, 296045], [43, 296285], [49, 296625], [52, 296885], [55, 297265], [64, 297645], [68, 297825], [73, 298045], [84, 298905], [87, 299005], [93, 299305], [98, 299825], [102, 300025], [108, 300425], [112, 300585], [115, 300765], [118, 300965], [122, 301165]]}, {"verse": 43, "start": 302405, "end": 307589, "text": "Y habiendo dicho estas cosas, clamó a gran voz: Lázaro, ven fuera.", "words": [[0, 302405], [2, 302549], [11, 302889], [17, 303229], [23, 303449], [30, 304329], [36, 304769], [38, 304869], [43, 305009], [48, 305871], [56, 306837], [60, 306977]]}, {"verse": 44, "start": 308039, "end": 321550, "text": "Y el que había estado muerto, salió, atadas las manos y los pies con vendas; y su rostro estaba envuelto en un paño funerario. Les dice Jesús: Desatadle, y dejadle ir.", "words": [[0, 308039], [2, 308136], [5, 308216], [9, 308356], [15, 308576], [22, 308836], [30, 309476], [37, 310276], [44, 311136], [48, 311336], [54, 311736], [56, 311996], [60, 312136], [65, 312356], [69, 312576], [77, 313619], [79, 313723], [82, 313863], [89, 314443], [96, 314763], [105, 315463], [108, 315583], [111, 315743], [116, 316303], [127, 317791], [131, 317985], [136, 318178], [143, 319205], [154, 319983], [156, 320443], [164, 321063]]}, {"verse": 45, "start": 322000, "end": 330687, "text": "Entonces muchos de los judíos que habían venido a María, y habían visto lo que había hecho Jesús, creyeron en él.", "words": [[0, 322000], [9, 322803], [16, 323243], [19, 323463], [23, 323563], [30, 324023], [34, 324183], [41, 324423], [48, 324863], [50, 324943], [57, 325243], [59, 326043], [66, 326323], [72, 326763], [75, 327363], [79, 327503], [85, 327783], [91, 328083], [98, 329013], [107, 329943], [110, 330263]]}, {"verse": 46, "start": 331137, "end": 336206, "text": "Pero algunos de ellos fueron a los fariseos, y les dijeron lo que Jesús había hecho.", "words": [[0, 331137], [5, 331283], [13, 331643], [16, 331863], [22, 332143], [29, 332463], [31, 332723], [35, 332823], [45, 333563], [47, 333923], [51, 334063], [59, 334543], [62, 334683], [66, 334823], [72, 335103], [78, 335543]]}, {"verse": 47, "start": 336656, "end": 345831, "text": "Entonces los principales sacerdotes y los fariseos reunieron el Consejo, y decían: ¿Qué hacemos? porque este hombre hace muchas señales.", "words": [[0, 336656], [9, 337161], [13, 337661], [25, 338341], [36, 339021], [38, 339161], [42, 339301], [51, 340061], [61, 340821], [64, 341001], [73, 341621], [75, 341801], [83, 342863], [88, 342963], [97, 343921], [104, 344104], [109, 344284], [116, 344544], [121, 344804], [128, 345084]]}, {"verse": 48, "start": 346281, "end": 352218, "text": "Si le dejamos así, todos creerán en él: y vendrán los Romanos, y quitarán nuestro lugar y la nación.", "words": [[0, 346281], [3, 346402], [6, 346522], [14, 346862], [19, 347662], [25, 347802], [33, 348362], [36, 348462], [40, 349056], [42, 349172], [50, 349512], [54, 349632], [63, 350192], [65, 350452], [74, 350872], [82, 351052], [88, 351452], [90, 351612], [93, 351712]]}, {"verse": 49, "start": 352568, "end": 359014, "text": "Y Caifás, uno de ellos, sumo sacerdote de aquel año, les dijo: Vosotros no sabéis nada;", "words": [[0, 352568], [2, 352714], [10, 353714], [14, 353874], [17, 354074], [24, 354814], [29, 355194], [39, 355834], [42, 356034], [48, 356314], [53, 356554], [57, 356794], [63, 357569], [72, 357994], [75, 358194], [82, 358554]]}, {"verse": 50, "start": 359464, "end": 364866, "text": "Ni pensáis que nos conviene que un hombre muera por el pueblo, y no que toda la nación se pierda.", "words": [[0, 359464], [3, 359587], [11, 360087], [15, 360267], [19, 360427], [28, 360927], [32, 361107], [35, 361267], [42, 361507], [48, 361907], [52, 362107], [55, 362247], [63, 362647], [65, 363107], [68, 363247], [72, 363407], [77, 363587], [80, 363807], [87, 364167], [90, 364327]]}, {"verse": 51, "start": 365216, "end": 374580, "text": "Pero esto no lo dijo de sí mismo; sino que, como era el sumo sacerdote de aquel año, profetizó que Jesús había de morir por la nación:", "words": [[0, 365216], [5, 365361], [10, 365581], [13, 365781], [16, 365901], [21, 366181], [24, 366381], [27, 366521], [34, 367918], [39, 367918], [44, 367918], [49, 368105], [53, 368325], [56, 368485], [61, 369045], [71, 369745], [74, 369945], [80, 370245], [85, 371265], [95, 371865], [99, 372045], [105, 372405], [111, 372905], [114, 373185], [120, 373585], [124, 373745], [127, 373925]]}, {"verse": 52, "start": 375030, "end": 381893, "text": "Y no solamente por aquella nación, sino también para que juntase en uno los hijos de Dios que estaban dispersos.", "words": [[0, 375030], [2, 375176], [5, 375296], [15, 375676], [19, 376096], [27, 376436], [35, 377276], [40, 377596], [48, 378036], [53, 378356], [57, 378656], [65, 378956], [68, 379256], [72, 379456], [76, 379696], [82, 379996], [85, 380256], [90, 380476], [94, 380636], [102, 380896]]}, {"verse": 53, "start": 382343, "end": 385977, "text": "Así que, desde aquel día planeaban juntos matarle.", "words": [[0, 382343], [4, 382740], [9, 382940], [15, 383260], [21, 383680], [25, 383920], [35, 384640], [42, 385000]]}, {"verse": 54, "start": 386427, "end": 400351, "text": "Por tanto, Jesús ya no andaba abiertamente entre los judíos; sino que se alejó de allí a la región contigua al desierto, a una ciudad llamada Efraín: y estábase allí con sus discípulos.", "words": [[0, 386427], [4, 386571], [11, 386871], [17, 387391], [20, 388051], [23, 388271], [30, 388811], [43, 389691], [49, 390031], [53, 390251], [61, 391421], [66, 391619], [70, 391799], [73, 391959], [79, 392359], [82, 392479], [87, 392759], [89, 392939], [92, 393039], [99, 393649], [108, 394259], [111, 394339], [121, 395299], [123, 395499], [127, 395639], [134, 395979], [142, 396659], [150, 397886], [152, 398213], [161, 398573], [166, 398893], [170, 399133], [174, 399353]]}, {"verse": 55, "start": 400801, "end": 409099, "text": "Y la Pascua de los judíos estaba cerca: y muchos subieron de aquella tierra a Jerusalén antes de la Pascua, para purificarse;", "words": [[0, 400801], [2, 400928], [5, 401278], [12, 401628], [15, 401688], [19, 401828], [26, 402328], [33, 402608], [40, 403651], [42, 403776], [49, 404056], [58, 404676], [61, 404856], [69, 405216], [76, 405556], [78, 405856], [88, 406496], [94, 406836], [97, 407016], [100, 407116], [108, 407636], [113, 408036]]}, {"verse": 56, "start": 409549, "end": 416885, "text": "Y buscaban a Jesús, y hablaban los unos con los otros estando en el templo: ¿Qué os parece, que no vendrá a la fiesta?", "words": [[0, 409549], [2, 409713], [11, 410213], [13, 410353], [20, 410633], [22, 411393], [31, 411853], [35, 412033], [40, 412353], [44, 412673], [48, 412873], [54, 413253], [62, 413853], [65, 413993], [68, 414113], [76, 414945], [81, 415047], [84, 415167], [92, 415527], [96, 415707], [99, 415867], [106, 416207], [108, 416287], [111, 416327]]}, {"verse": 57, "start": 417235, "end": 427907, "text": "Y los principales sacerdotes y los fariseos habían dado mandamiento, que si alguno supiese dónde estuviera, lo manifestase, para que le prendiesen.", "words": [[0, 417235], [2, 417342], [6, 417462], [18, 418162], [29, 418882], [31, 419042], [35, 419162], [44, 419902], [51, 420322], [56, 420722], [69, 421502], [73, 421942], [76, 422082], [83, 422522], [91, 422962], [97, 423242], [108, 424542], [111, 424642], [124, 426102], [129, 426762], [133, 426922], [136, 427042]]}]}