{"book": "LUK", "chapter": 8, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 527727, "verses": [{"verse": 1, "start": 300, "end": 10669, "text": "Y aconteció después, que él caminaba por todas las ciudades y aldeas, predicando y anunciando el evangelio del reino de Dios, y los doce con él,", "words": [[0, 300], [2, 497], [12, 1497], [21, 2277], [25, 2537], [28, 2737], [37, 3317], [41, 3557], [47, 3857], [51, 4117], [60, 4717], [62, 4877], [70, 5437], [81, 6597], [83, 6757], [94, 7437], [97, 7557], [107, 8137], [111, 8317], [117, 8677], [120, 8817], [126, 9117], [128, 9517], [132, 9677], [137, 10077], [141, 10337]]}, {"verse": 2, "start": 11119, "end": 21825, "text": "Y algunas mujeres que habían sido curadas de malos espíritus y de enfermedades: María, que se llamaba Magdalena, de la cual habían salido siete demonios,", "words": [[0, 11119], [2, 11219], [10, 11459], [18, 11979], [22, 12219], [29, 12439], [34, 12759], [42, 13299], [45, 13479], [51, 13799], [61, 14799], [63, 14959], [66, 15079], [80, 16560], [87, 17186], [91, 17426], [94, 17546], [102, 17986], [113, 19206], [116, 19426], [119, 19546], [124, 19706], [131, 20006], [138, 20526], [144, 20846]]}, {"verse": 3, "start": 22275, "end": 30234, "text": "Y Juana, mujer de Chuza, administrador de Herodes, y Susana, y otras muchas que le servían con sus bienes.", "words": [[0, 22275], [2, 22435], [9, 23075], [15, 23175], [18, 23775], [25, 24375], [39, 25355], [42, 25575], [51, 26175], [53, 26595], [61, 27195], [63, 27655], [69, 27835], [76, 28195], [80, 28415], [83, 28535], [91, 29015], [95, 29235], [99, 29455]]}, {"verse": 4, "start": 30684, "end": 38140, "text": "Y como se juntó una gran multitud, y los que estaban en cada ciudad vinieron a él, dijo por una parábola:", "words": [[0, 30684], [2, 30830], [7, 31130], [10, 31310], [16, 31810], [20, 31990], [25, 32230], [35, 32950], [37, 33450], [41, 33610], [45, 33730], [53, 34050], [56, 34270], [61, 34510], [68, 34870], [77, 35550], [79, 35750], [83, 36370], [88, 36870], [92, 37170], [96, 37350]]}, {"verse": 5, "start": 38590, "end": 48768, "text": "Uno que sembraba, salió a sembrar su semilla; y sembrando, una parte cayó junto al camino, y fue pisoteada; y las aves del cielo la comieron.", "words": [[0, 38590], [4, 38760], [8, 38940], [18, 39600], [24, 40340], [26, 40480], [34, 40920], [37, 41140], [46, 42122], [48, 42244], [59, 42764], [63, 42944], [69, 43484], [74, 43724], [80, 43944], [83, 44164], [91, 44604], [93, 45124], [97, 45284], [108, 46531], [110, 46633], [114, 46773], [119, 47153], [123, 47353], [129, 47733], [132, 47973]]}, {"verse": 6, "start": 49218, "end": 54882, "text": "Y otra parte cayó sobre la piedra; y nacida, se secó, porque no tenía humedad.", "words": [[0, 49218], [2, 49518], [7, 49698], [13, 49998], [18, 50498], [24, 50738], [27, 50958], [35, 51902], [37, 52050], [45, 52550], [48, 52730], [54, 53230], [61, 53710], [64, 53890], [70, 54210]]}, {"verse": 7, "start": 55332, "end": 61579, "text": "Y otra parte cayó entre las espinas; y naciendo las espinas juntamente, la ahogaron.", "words": [[0, 55332], [2, 55451], [7, 55651], [13, 56091], [18, 56611], [24, 56891], [28, 57151], [37, 58275], [39, 58416], [48, 58936], [52, 59176], [60, 59576], [72, 60236], [75, 60576]]}, {"verse": 8, "start": 62029, "end": 73551, "text": "Y otra parte cayó en buena tierra, y cuando fue nacida, llevó fruto a ciento por uno. Diciendo estas cosas clamaba: El que tiene oídos para oír, oiga.", "words": [[0, 62029], [2, 62153], [7, 62313], [13, 62633], [18, 63073], [21, 63153], [27, 63333], [35, 64313], [37, 64493], [44, 64733], [48, 65013], [56, 65993], [62, 66353], [68, 66706], [70, 67060], [77, 67413], [81, 67773], [86, 68579], [95, 68963], [101, 69243], [107, 69881], [116, 70786], [119, 71091], [123, 71231], [129, 71571], [135, 72151], [140, 72371], [145, 73051]]}, {"verse": 9, "start": 74001, "end": 78721, "text": "Y sus discípulos le preguntaron, diciendo, qué era esta parábola.", "words": [[0, 74001], [2, 74088], [6, 74268], [17, 74908], [20, 75128], [33, 75788], [43, 76188], [47, 77208], [51, 77528], [56, 77848]]}, {"verse": 10, "start": 79171, "end": 90069, "text": "Y él dijo: A vosotros es dado conocer los misterios del reino de Dios; pero a los otros por parábolas, para que viendo no vean, y oyendo no entiendan.", "words": [[0, 79171], [2, 79335], [5, 79644], [11, 80199], [13, 80323], [22, 80843], [25, 81063], [30, 81363], [38, 82003], [42, 82243], [52, 82883], [56, 83183], [62, 83623], [65, 83783], [71, 84660], [76, 84803], [78, 84943], [82, 85083], [88, 85323], [92, 85643], [103, 86283], [108, 86803], [112, 86963], [119, 87263], [122, 87483], [128, 87983], [130, 88283], [137, 88683], [140, 89103]]}, {"verse": 11, "start": 90519, "end": 94533, "text": "Es pues esta la parábola: La semilla es la palabra de Dios.", "words": [[0, 90578], [3, 90668], [8, 90808], [13, 91428], [16, 91508], [26, 92636], [29, 92755], [37, 93215], [40, 93355], [43, 93435], [51, 93735], [54, 93975]]}, {"verse": 12, "start": 94983, "end": 105179, "text": "Y los de junto al camino, estos son los que oyen; y luego viene el diablo, y quita la palabra de su corazón, para que no crean y se salven.", "words": [[0, 94983], [2, 95090], [6, 95210], [9, 95370], [15, 95770], [18, 95870], [26, 96730], [32, 96910], [36, 97230], [40, 97390], [44, 97590], [50, 98457], [52, 98580], [58, 98780], [64, 99140], [67, 99380], [75, 99900], [77, 100620], [83, 100940], [86, 101080], [94, 101460], [97, 101680], [100, 101820], [109, 102380], [114, 103220], [118, 103360], [121, 103540], [127, 104100], [129, 104280], [132, 104400]]}, {"verse": 13, "start": 105629, "end": 118961, "text": "Y los de sobre la piedra, son los que habiendo oído, reciben la palabra con gozo; pero estos no tienen raíces; que creen por algún tiempo, y en el tiempo de la tentación se apartan.", "words": [[0, 105629], [2, 105753], [6, 105893], [9, 106053], [15, 106273], [18, 106493], [26, 107613], [30, 108013], [34, 108233], [38, 108513], [47, 108893], [53, 109633], [61, 110053], [64, 110233], [72, 110709], [76, 111185], [82, 111905], [87, 112050], [93, 112250], [96, 112490], [103, 112810], [111, 114100], [115, 114185], [121, 114665], [125, 114865], [131, 115145], [139, 115725], [141, 116365], [144, 116505], [147, 116625], [154, 117045], [157, 117185], [160, 117305], [170, 117885], [173, 118105]]}, {"verse": 14, "start": 119411, "end": 132334, "text": "Y la que cayó entre las espinas, estos son los que oyeron; pero yéndose, son ahogados de las preocupaciones y de las riquezas y de los placeres de la vida, y no llevan fruto.", "words": [[0, 119411], [2, 119714], [5, 119834], [9, 119994], [14, 120454], [20, 120714], [24, 120974], [33, 122234], [39, 122574], [43, 123054], [47, 123574], [51, 123754], [59, 124788], [64, 124954], [73, 125454], [77, 125794], [86, 126514], [89, 126674], [93, 126834], [108, 127794], [110, 128034], [113, 128154], [117, 128314], [126, 128954], [128, 129454], [131, 129554], [135, 129714], [144, 130214], [147, 130354], [150, 130454], [156, 130694], [158, 131194], [161, 131374], [168, 131754]]}, {"verse": 15, "start": 132784, "end": 141834, "text": "Pero la que en buena tierra, estos son los que con corazón bueno y recto retienen la palabra oída, y llevan fruto en paciencia.", "words": [[0, 132784], [5, 132971], [8, 133171], [12, 133331], [15, 133531], [21, 133711], [29, 134551], [35, 135231], [39, 135911], [43, 136151], [47, 136411], [51, 136751], [59, 137171], [65, 137591], [67, 138158], [73, 138724], [82, 139291], [85, 139411], [93, 139711], [99, 140111], [101, 140251], [108, 140551], [114, 140911], [117, 141031]]}, {"verse": 16, "start": 142284, "end": 152996, "text": "Ninguno que enciende la lámpara la cubre con vasija, o la pone debajo de la cama; pero la pone en un candelero, para que los que entran vean la luz.", "words": [[0, 142284], [8, 142907], [12, 143127], [21, 143747], [24, 143947], [32, 144427], [35, 144587], [41, 145027], [45, 145187], [53, 145807], [55, 146287], [58, 146387], [63, 146647], [70, 147067], [73, 147207], [76, 147327], [82, 148177], [87, 148340], [90, 148520], [95, 148840], [98, 149080], [101, 149200], [112, 149800], [117, 150300], [121, 150560], [125, 150980], [129, 151220], [136, 151720], [141, 152280], [144, 152500]]}, {"verse": 17, "start": 153446, "end": 162416, "text": "Porque no hay cosa oculta, que no haya de ser manifestada; ni cosa escondida, que no haya de ser entendida, y de venir a luz.", "words": [[0, 153446], [7, 153668], [10, 153908], [14, 154128], [19, 154408], [27, 155588], [31, 155828], [34, 156048], [39, 156408], [42, 156608], [46, 156848], [59, 158400], [62, 158490], [67, 158770], [78, 159550], [82, 159710], [85, 159890], [90, 160030], [93, 160230], [97, 160390], [108, 161150], [110, 161290], [113, 161430], [119, 161710], [121, 161850]]}, {"verse": 18, "start": 162866, "end": 172588, "text": "Mirad pues cómo oís; porque a todo el que tiene, se le dará; y a cualquiera que no tiene, aun lo que parece tener le será quitado.", "words": [[0, 163072], [6, 163322], [11, 163702], [16, 164310], [21, 165159], [28, 165442], [30, 165742], [35, 166102], [38, 166322], [42, 166422], [49, 166802], [52, 167022], [55, 167202], [61, 168028], [63, 168138], [65, 168198], [76, 168718], [80, 168878], [83, 169058], [90, 169538], [94, 170138], [97, 170338], [101, 170498], [108, 170838], [114, 171278], [117, 171618], [122, 171898]]}, {"verse": 19, "start": 173038, "end": 178683, "text": "Y vinieron a él su madre y hermanos; y no podían llegar a él por causa de la multitud.", "words": [[0, 173038], [2, 173164], [11, 173624], [13, 173844], [16, 173924], [19, 174124], [25, 174484], [27, 174784], [37, 175820], [39, 175949], [42, 176049], [49, 176449], [56, 176669], [58, 176869], [61, 177009], [65, 177209], [71, 177609], [74, 177849], [77, 177929]]}, {"verse": 20, "start": 179133, "end": 185019, "text": "Y le fue dado aviso, diciendo: Tu madre y tus hermanos están fuera, que quieren verte.", "words": [[0, 179133], [2, 179232], [5, 179332], [9, 179492], [14, 180082], [21, 180672], [31, 181880], [34, 181957], [40, 182317], [42, 182477], [46, 182617], [55, 183157], [61, 183397], [68, 184077], [72, 184177], [80, 184457]]}, {"verse": 21, "start": 185369, "end": 193446, "text": "Él entonces respondiendo, les dijo: Mi madre y mis hermanos son los que oyen la palabra de Dios, y la hacen.", "words": [[0, 185369], [3, 185856], [12, 186496], [26, 187136], [30, 187776], [36, 188441], [39, 188566], [45, 188886], [47, 189166], [51, 189326], [60, 189986], [64, 190306], [68, 190546], [72, 190766], [77, 191086], [80, 191226], [88, 191586], [91, 191806], [97, 192106], [99, 192726], [102, 192906]]}, {"verse": 22, "start": 193896, "end": 202197, "text": "Y aconteció un día que él entró en un barco con sus discípulos, y les dijo: Pasemos al otro lado del lago. Y partieron.", "words": [[0, 193896], [2, 194027], [12, 194687], [15, 194867], [19, 195107], [23, 195327], [26, 195567], [32, 195987], [35, 196087], [38, 196227], [44, 196647], [48, 196847], [52, 197047], [64, 197767], [66, 197987], [70, 198207], [76, 199023], [84, 199408], [87, 199628], [92, 199808], [97, 200068], [101, 200348], [107, 201231], [109, 201735]]}, {"verse": 23, "start": 202647, "end": 213200, "text": "Pero mientras ellos navegaban, él se durmió. Y sobrevino una tempestad de viento en el lago; y el barco se llenaba de agua, y peligraban.", "words": [[0, 202647], [5, 202771], [14, 203071], [20, 203431], [31, 204531], [34, 204831], [37, 204991], [45, 205971], [47, 206375], [57, 206815], [61, 206955], [71, 207835], [74, 208015], [81, 208475], [84, 208635], [87, 208795], [93, 209694], [95, 209822], [98, 209902], [104, 210382], [107, 210602], [115, 211042], [118, 211222], [124, 211622], [126, 212122]]}, {"verse": 24, "start": 213650, "end": 227513, "text": "Y llegándose a él, le despertaron, diciendo: ¡Maestro, Maestro, que perecemos! Y despertado él, reprendió al viento y a la tempestad del agua; y cesaron, y fue hecha bonanza.", "words": [[0, 213650], [2, 213919], [13, 214519], [15, 214699], [19, 215279], [22, 215379], [35, 216139], [45, 217331], [55, 217873], [64, 218393], [68, 218573], [79, 219751], [81, 219915], [92, 220995], [96, 221215], [106, 222335], [109, 222495], [116, 222895], [118, 223075], [120, 223155], [123, 223235], [133, 223895], [137, 224095], [143, 224908], [145, 225054], [154, 225654], [156, 226254], [160, 226474], [166, 226754]]}, {"verse": 25, "start": 227963, "end": 239687, "text": "Y les dijo: ¿Dónde está vuestra fe? Y atemorizados, se maravillaban, diciendo los unos a los otros: ¿Quién es este, que aun a los vientos y al agua manda, y le obedecen?", "words": [[0, 227963], [2, 228103], [6, 228243], [12, 229072], [19, 229414], [24, 229634], [32, 230014], [36, 230685], [38, 230828], [52, 231588], [55, 231848], [69, 232621], [78, 233395], [82, 234168], [87, 234348], [89, 234608], [93, 234748], [100, 235730], [107, 235969], [110, 236109], [116, 236449], [120, 236669], [124, 236889], [126, 236889], [130, 237169], [138, 237609], [140, 237789], [143, 237889], [148, 238089], [155, 238629], [157, 238909], [160, 239009]]}, {"verse": 26, "start": 240037, "end": 244714, "text": "Y navegaron a la tierra de los gadarenos, que está delante de Galilea.", "words": [[0, 240037], [2, 240158], [12, 240758], [14, 240858], [17, 240938], [24, 241298], [27, 241558], [31, 242168], [42, 242778], [46, 243078], [51, 243238], [59, 243698], [62, 243878]]}, {"verse": 27, "start": 245164, "end": 257492, "text": "Y saliendo él a tierra, le vino al encuentro de la ciudad un hombre que tenía demonios ya de mucho tiempo; y no vestía vestido, ni estaba en casa, sino por los sepulcros.", "words": [[0, 245164], [2, 245404], [11, 245984], [14, 246224], [16, 246344], [24, 247164], [27, 247404], [32, 247664], [35, 247844], [45, 248564], [48, 248664], [51, 248784], [58, 249124], [61, 249524], [68, 249844], [72, 250124], [78, 250404], [87, 251064], [90, 251324], [93, 251464], [99, 251664], [107, 252685], [109, 252827], [112, 252987], [119, 253447], [128, 254087], [131, 254747], [138, 255087], [141, 255287], [147, 255927], [152, 256167], [156, 256447], [160, 256607]]}, {"verse": 28, "start": 257942, "end": 270800, "text": "El cual, cuando vio a Jesús, exclamó y se postró delante de él, y dijo a gran voz: ¿Qué tengo yo contigo, Jesús, Hijo del Dios Altísimo? Te ruego que no me atormentes.", "words": [[0, 257942], [3, 258084], [9, 258444], [16, 258644], [20, 259064], [22, 259184], [29, 260064], [37, 260824], [39, 260964], [42, 261124], [49, 261584], [57, 262024], [60, 262244], [64, 262544], [66, 263384], [71, 263784], [73, 264024], [78, 264204], [83, 265102], [88, 265202], [94, 265522], [97, 265702], [106, 266262], [113, 267142], [118, 267362], [122, 267542], [127, 267742], [137, 268952], [140, 269054], [146, 269394], [150, 269574], [153, 269734], [156, 269874]]}, {"verse": 29, "start": 271150, "end": 288406, "text": "(Porque mandaba al espíritu inmundo que saliese del hombre: porque ya de mucho tiempo le arrebataba; y le guardaban preso con cadenas y grilletes; pero rompiendo las ataduras, era arrastrado por el demonio a los lugares desiertos.)", "words": [[0, 271150], [8, 271375], [16, 272075], [19, 272355], [28, 273055], [36, 273535], [40, 273735], [48, 274195], [52, 274455], [60, 275298], [67, 275661], [70, 275921], [73, 276061], [79, 276281], [86, 276681], [89, 276921], [101, 278231], [103, 278337], [106, 278457], [116, 278997], [122, 279597], [126, 279817], [134, 280437], [136, 280637], [147, 281852], [152, 282034], [162, 282794], [166, 282974], [176, 283694], [180, 284314], [191, 285374], [195, 285774], [198, 285974], [206, 286614], [208, 286774], [212, 286934], [220, 287394]]}, {"verse": 30, "start": 288856, "end": 297448, "text": "Y le preguntó Jesús, diciendo: ¿Qué nombre tienes? Y él dijo: Legión. Porque muchos demonios habían entrado en él.", "words": [[0, 288856], [2, 288971], [5, 289071], [14, 289611], [21, 289931], [31, 291318], [36, 291618], [43, 291878], [51, 292947], [53, 293110], [56, 293419], [62, 293924], [70, 294832], [77, 295037], [84, 295357], [93, 295997], [100, 296317], [108, 296897], [111, 297057]]}, {"verse": 31, "start": 297898, "end": 300928, "text": "Y le rogaban que no les mandase ir al abismo.", "words": [[0, 297898], [2, 298022], [5, 298142], [13, 298742], [17, 298962], [20, 299162], [24, 299342], [32, 299902], [35, 300142], [38, 300302]]}, {"verse": 32, "start": 301378, "end": 310366, "text": "Y había allí una manada de muchos cerdos que pacían en el monte; y le rogaron que los dejase entrar en ellos; y los dejó.", "words": [[0, 301378], [2, 301502], [8, 301762], [13, 302042], [17, 302262], [24, 302702], [27, 302902], [34, 303142], [41, 303882], [45, 304372], [52, 304862], [55, 305322], [58, 305462], [65, 306379], [67, 306503], [70, 306663], [78, 307263], [82, 307423], [86, 307583], [93, 308023], [100, 308423], [103, 308643], [110, 309557], [112, 309681], [116, 309841]]}, {"verse": 33, "start": 310816, "end": 320431, "text": "Y salidos los demonios del hombre, entraron en los cerdos; y la manada se arrojó de un despeñadero en el lago, y se ahogó.", "words": [[0, 310816], [2, 311086], [10, 311626], [14, 311826], [23, 312426], [27, 312546], [35, 312906], [44, 314026], [47, 314166], [51, 314366], [59, 315602], [61, 315725], [64, 315825], [71, 316225], [74, 316445], [81, 317045], [84, 317245], [87, 317405], [99, 318285], [102, 318405], [105, 318565], [111, 318965], [113, 319485], [116, 319665]]}, {"verse": 34, "start": 320881, "end": 329428, "text": "Y los pastores, cuando vieron lo que había acontecido, huyeron, y yendo dieron aviso en la ciudad y por los campos.", "words": [[0, 320881], [2, 321005], [6, 321125], [16, 321945], [23, 322245], [30, 322665], [33, 322825], [37, 322965], [43, 323245], [55, 324425], [64, 325485], [66, 325585], [72, 326385], [79, 326785], [85, 327185], [88, 327325], [91, 327445], [98, 327805], [100, 328245], [104, 328445], [108, 328585]]}, {"verse": 35, "start": 329878, "end": 344030, "text": "Y salieron a ver lo que había acontecido; y vinieron a Jesús, y hallaron sentado al hombre de quien habían salido los demonios, vestido, y en su juicio, a los pies de Jesús; y tuvieron miedo.", "words": [[0, 329878], [2, 330156], [11, 330656], [13, 330816], [17, 330996], [20, 331376], [24, 331496], [30, 331756], [42, 333002], [44, 333146], [53, 333586], [55, 333726], [62, 334086], [64, 334726], [73, 335366], [81, 335986], [84, 336146], [91, 336406], [94, 336666], [100, 336926], [107, 337266], [114, 337866], [118, 338046], [128, 338946], [137, 339606], [139, 340046], [142, 340166], [145, 340326], [153, 340886], [155, 341366], [159, 341486], [164, 341726], [167, 341886], [174, 342862], [176, 343059], [185, 343399]]}, {"verse": 36, "start": 344480, "end": 350230, "text": "Y les contaron los que lo habían visto, cómo había sido salvado aquel endemoniado.", "words": [[0, 344480], [2, 344624], [6, 344764], [15, 345484], [19, 345684], [23, 345864], [26, 345984], [33, 346224], [40, 346684], [45, 347384], [51, 347684], [56, 348044], [64, 348684], [70, 349184]]}, {"verse": 37, "start": 350680, "end": 362566, "text": "Entonces toda la multitud de la tierra de los gadarenos alrededor, le rogaron que se fuese de ellos; porque tenían gran temor. Y él, subiendo en el barco, se volvió.", "words": [[0, 350680], [9, 351477], [14, 351917], [17, 352177], [26, 352857], [29, 353077], [32, 353197], [39, 353537], [42, 353837], [46, 354017], [56, 354697], [67, 355307], [70, 355917], [78, 356457], [82, 356617], [85, 356757], [91, 357117], [94, 357277], [101, 358117], [108, 358451], [115, 358821], [120, 359101], [127, 360044], [129, 360207], [133, 360367], [142, 360947], [145, 361087], [148, 361207], [155, 361647], [158, 361927]]}, {"verse": 38, "start": 363016, "end": 371177, "text": "Y aquel hombre, de quien habían salido los demonios, le rogó para estar con él; pero Jesús le despidió, diciendo:", "words": [[0, 363016], [2, 363296], [8, 363556], [16, 363956], [19, 364196], [25, 364376], [32, 364716], [39, 365296], [43, 365456], [53, 366096], [56, 366496], [61, 366896], [66, 367116], [72, 367376], [76, 367676], [80, 368337], [85, 368601], [91, 368941], [94, 369401], [104, 370121]]}, {"verse": 39, "start": 371627, "end": 382643, "text": "Vuélvete a tu casa, y cuenta cuán grandes cosas ha hecho Dios contigo. Y él se fue, publicando por toda la ciudad cuán grandes cosas había hecho Jesús con él.", "words": [[0, 371627], [9, 372093], [11, 372193], [14, 372293], [20, 372633], [22, 372813], [29, 373173], [34, 373553], [42, 373973], [48, 374433], [51, 374853], [57, 375113], [62, 375333], [71, 376571], [73, 376708], [76, 376868], [79, 376968], [84, 377868], [95, 378628], [99, 378848], [104, 379088], [107, 379288], [114, 379628], [119, 380108], [127, 380568], [133, 380948], [139, 381328], [145, 381648], [151, 381968], [155, 382308]]}, {"verse": 40, "start": 383093, "end": 389589, "text": "Y aconteció que volviendo Jesús, le recibió la gente; porque todos le esperaban.", "words": [[0, 383093], [2, 383217], [12, 383877], [16, 384057], [26, 384597], [33, 385477], [36, 385717], [44, 386357], [47, 386477], [54, 387419], [61, 387604], [67, 388024], [70, 388544]]}, {"verse": 41, "start": 390039, "end": 400964, "text": "Y he aquí un varón, llamado Jairo, y que era dirigente de la sinagoga, vino, y cayendo a los pies de Jesús, le rogaba que entrase en su casa;", "words": [[0, 390039], [2, 390227], [5, 390407], [10, 390707], [13, 390907], [20, 391827], [28, 392267], [35, 393367], [37, 393407], [41, 393547], [45, 393707], [55, 394327], [58, 394487], [61, 394607], [71, 395667], [77, 396427], [79, 396587], [87, 397107], [89, 397207], [93, 397307], [98, 397567], [101, 397707], [108, 398127], [111, 398767], [118, 399287], [122, 399467], [130, 400027], [133, 400227], [136, 400387]]}, {"verse": 42, "start": 401414, "end": 409638, "text": "Porque tenía una hija única, como de doce años, y ella se estaba muriendo. Y yendo, la multitud lo apretaba.", "words": [[0, 401414], [7, 401619], [13, 402019], [17, 402399], [22, 402859], [29, 403759], [34, 403979], [37, 404199], [42, 404419], [48, 405379], [50, 405559], [55, 405779], [58, 405919], [65, 406199], [75, 407267], [77, 407431], [84, 407711], [87, 407891], [96, 408551], [99, 408831]]}, {"verse": 43, "start": 410088, "end": 419932, "text": "Y una mujer, que tenía flujo de sangre hacía ya doce años, la cual había gastado en médicos todos sus bienes, y por ninguno había podido ser curada,", "words": [[0, 410088], [2, 410229], [6, 410369], [13, 410729], [17, 411009], [23, 411289], [29, 411769], [32, 411849], [39, 412159], [45, 412469], [48, 412779], [53, 413089], [59, 413969], [62, 414049], [67, 414329], [73, 414849], [81, 415429], [84, 415549], [92, 416129], [98, 416469], [102, 416829], [110, 417429], [112, 417669], [116, 417869], [124, 418429], [130, 418589], [137, 419049], [141, 419229]]}, {"verse": 44, "start": 420382, "end": 427414, "text": "Llegándose por las espaldas, tocó el borde de su vestido; y luego se detuvo el flujo de su sangre.", "words": [[0, 420382], [11, 421055], [15, 421315], [19, 421515], [29, 422275], [34, 422895], [37, 423115], [43, 423495], [46, 423655], [49, 423835], [58, 424866], [60, 424974], [66, 425174], [69, 425434], [76, 425894], [79, 426094], [85, 426534], [88, 426634], [91, 426774]]}, {"verse": 45, "start": 427864, "end": 441128, "text": "Entonces Jesús dijo: ¿Quién es el que me ha tocado? Y negando todos, dijo Pedro y los que estaban con él: Maestro, la multitud te aprieta y oprime, y dices: ¿Quién es el que me ha tocado?", "words": [[0, 427864], [9, 428324], [15, 428804], [21, 429830], [28, 430074], [31, 430274], [34, 430394], [38, 430554], [41, 430734], [44, 430834], [52, 432041], [54, 432261], [62, 432481], [69, 433321], [74, 433741], [80, 434781], [82, 434861], [86, 434981], [90, 435121], [98, 435401], [102, 435701], [106, 436419], [115, 436919], [118, 437059], [127, 437559], [130, 437699], [138, 438179], [140, 438299], [148, 438739], [150, 438959], [157, 439880], [164, 440082], [167, 440182], [170, 440302], [174, 440402], [177, 440522], [180, 440622]]}, {"verse": 46, "start": 441478, "end": 447637, "text": "Y Jesús dijo: Me ha tocado alguien; porque yo he conocido que ha salido poder de mí.", "words": [[0, 441478], [2, 441605], [8, 441945], [14, 442974], [17, 443113], [20, 443213], [27, 443713], [36, 444818], [43, 445021], [46, 445261], [49, 445381], [58, 446021], [62, 446201], [65, 446321], [72, 446741], [78, 447021], [81, 447321]]}, {"verse": 47, "start": 448087, "end": 463932, "text": "Entonces, como la mujer vio que no se había ocultado, vino temblando, y postrándose delante de él le declaró delante de todo el pueblo la causa por qué le había tocado, y cómo luego había sido sana.", "words": [[0, 448087], [10, 449314], [15, 449554], [18, 449714], [24, 449974], [28, 450374], [32, 450574], [35, 450754], [38, 450954], [44, 451234], [54, 452514], [59, 452654], [70, 454034], [72, 454094], [84, 454894], [92, 455414], [95, 455614], [98, 456334], [101, 456434], [109, 456954], [117, 457514], [120, 457654], [125, 457894], [128, 458094], [135, 458474], [138, 459270], [144, 459597], [148, 459817], [152, 460037], [155, 460197], [161, 460437], [169, 460997], [171, 461757], [176, 462097], [182, 462517], [188, 462857], [193, 463237]]}, {"verse": 48, "start": 464382, "end": 469106, "text": "Y él le dijo: Hija, tu fe te ha salvado: ve en paz.", "words": [[0, 464382], [2, 464567], [5, 464727], [8, 464907], [14, 465779], [20, 466579], [23, 466699], [26, 466939], [29, 467119], [32, 467239], [41, 468378], [44, 468464], [47, 468551]]}, {"verse": 49, "start": 469556, "end": 479033, "text": "Estando aún él hablando, vino uno de la casa del dirigente de la sinagoga a decirle: Tu hija es muerta, no molestes al Maestro.", "words": [[0, 469556], [8, 470046], [12, 470286], [15, 470626], [25, 471706], [30, 472186], [34, 472586], [37, 472746], [40, 472886], [45, 473146], [49, 473466], [59, 474166], [62, 474326], [65, 474446], [74, 475106], [76, 475346], [85, 476393], [88, 476497], [93, 476757], [96, 476817], [104, 477597], [107, 477677], [116, 478197], [119, 478337]]}, {"verse": 50, "start": 479383, "end": 485612, "text": "Y oyéndolo Jesús, le respondió: No temas: cree solamente, y será salva.", "words": [[0, 479383], [2, 479752], [11, 480152], [18, 480572], [21, 480912], [32, 482347], [35, 482649], [42, 483196], [47, 483580], [58, 483920], [60, 484700], [65, 484960]]}, {"verse": 51, "start": 486062, "end": 495866, "text": "Y entrado en casa, no dejó entrar a nadie consigo, sino a Pedro, y a Jacobo, y a Juan, y al padre y a la madre de la muchacha.", "words": [[0, 486062], [2, 486224], [10, 486804], [13, 486944], [19, 487824], [22, 488184], [27, 488604], [34, 489004], [36, 489244], [42, 489664], [51, 490264], [56, 490784], [58, 491024], [65, 491364], [67, 491684], [69, 491764], [77, 492404], [79, 492584], [81, 492664], [87, 492944], [89, 493284], [92, 493404], [98, 493844], [100, 494384], [102, 494464], [105, 494564], [111, 494884], [114, 495044], [117, 495164]]}, {"verse": 52, "start": 496316, "end": 503575, "text": "Y lloraban todos, y se lamentaban por ella. Y él dijo: No lloréis; no es muerta, sino que duerme.", "words": [[0, 496316], [2, 496442], [11, 496842], [18, 497242], [20, 497522], [23, 497662], [34, 498302], [38, 498502], [44, 499257], [46, 499420], [49, 499729], [55, 500371], [58, 500491], [67, 501504], [70, 501610], [73, 501710], [81, 502510], [86, 502730], [90, 502930]]}, {"verse": 53, "start": 504025, "end": 507400, "text": "Y hacían burla de él, sabiendo que estaba muerta.", "words": [[0, 504025], [2, 504143], [9, 504563], [15, 505123], [18, 505303], [22, 505823], [31, 506243], [35, 506403], [42, 506623]]}, {"verse": 54, "start": 507850, "end": 513000, "text": "Pero él, tomándola de la mano, clamó, diciendo: Muchacha, levántate.", "words": [[0, 507850], [5, 507994], [9, 508734], [19, 509354], [22, 509474], [25, 509614], [31, 510134], [38, 510396], [48, 511891], [58, 512391]]}, {"verse": 55, "start": 513450, "end": 519419, "text": "Entonces su espíritu volvió, y se levantó luego: y él mandó que le diesen de comer.", "words": [[0, 513450], [9, 514236], [12, 514436], [21, 514996], [29, 515456], [31, 515576], [34, 515696], [42, 516216], [49, 517027], [51, 517209], [54, 517369], [60, 517829], [64, 517989], [67, 518309], [74, 518629], [77, 518849]]}, {"verse": 56, "start": 519869, "end": 527327, "text": "Y sus padres estaban atónitos; a los cuales él mandó, que a nadie dijesen lo que había sido hecho.", "words": [[0, 519869], [2, 519947], [6, 520107], [13, 520467], [21, 521127], [31, 522409], [33, 522536], [37, 522656], [44, 522896], [47, 523296], [54, 523776], [58, 524316], [60, 524456], [66, 524956], [74, 525456], [77, 525996], [81, 526156], [87, 526376], [92, 526756]]}]}