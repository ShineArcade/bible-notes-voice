{"book": "1CO", "chapter": 12, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 184433, "verses": [{"verse": 1, "start": 300, "end": 4459, "text": "Now concerning spiritual gifts, brethren, I would not have you ignorant.", "words": [[0, 300], [4, 533], [15, 993], [25, 1573], [32, 2213], [42, 3013], [44, 3093], [50, 3213], [54, 3373], [59, 3613], [63, 3773]]}, {"verse": 2, "start": 4909, "end": 9422, "text": "You know that you were Gentiles, carried away to these dumb idols, even as you were led.", "words": [[0, 4909], [4, 5055], [9, 5255], [14, 5455], [18, 5575], [23, 5675], [33, 6315], [41, 6655], [46, 6955], [49, 7155], [55, 7375], [60, 7655], [67, 8355], [72, 8555], [75, 8775], [79, 8895], [84, 9160]]}, {"verse": 3, "start": 9872, "end": 18915, "text": "Therefore I give you to understand, that no man speaking by the Spirit of God calls Jesus accursed: and that no man can say that Jesus is the Lord, but by the Holy Spirit.", "words": [[0, 9872], [10, 10135], [12, 10395], [17, 10575], [21, 10695], [24, 10835], [36, 11255], [41, 11995], [44, 12195], [48, 12375], [57, 12675], [60, 12915], [64, 13035], [71, 13275], [74, 13435], [78, 13655], [84, 13995], [90, 14415], [100, 15529], [104, 15626], [109, 15746], [112, 15926], [116, 16106], [120, 16286], [124, 16506], [129, 16666], [135, 16906], [138, 17166], [142, 17326], [148, 17786], [152, 17886], [155, 18046], [159, 18146], [164, 18386]]}, {"verse": 4, "start": 19365, "end": 22394, "text": "Now there are diversities of gifts, but the same Spirit.", "words": [[0, 19365], [4, 19602], [10, 19782], [14, 19862], [26, 20442], [29, 20642], [36, 21482], [40, 21602], [44, 21722], [49, 21922]]}, {"verse": 5, "start": 22844, "end": 25944, "text": "And there are differences of administrations, but the same Lord.", "words": [[0, 22844], [4, 22963], [10, 23103], [14, 23203], [26, 23543], [29, 23803], [46, 24443], [50, 25083], [54, 25203], [59, 25443]]}, {"verse": 6, "start": 26394, "end": 31463, "text": "And there are diversities of operations, but it is the same God which works all in all.", "words": [[0, 26394], [4, 26543], [10, 26703], [14, 26803], [26, 27383], [29, 27563], [41, 28543], [45, 28763], [48, 28883], [51, 29003], [55, 29163], [60, 29483], [64, 29763], [70, 30003], [76, 30323], [80, 30783], [83, 31103]]}, {"verse": 7, "start": 31913, "end": 35816, "text": "But the manifestation of the Spirit is given to every man for the profit of all.", "words": [[0, 31913], [4, 32021], [8, 32141], [22, 32781], [25, 33081], [29, 33201], [36, 33561], [39, 33801], [45, 33981], [48, 34181], [54, 34401], [58, 34661], [62, 34861], [66, 34961], [73, 35241], [76, 35441]]}, {"verse": 8, "start": 36266, "end": 42159, "text": "For to one is given by the Spirit the word of wisdom; to another the word of knowledge by the same Spirit;", "words": [[0, 36327], [4, 36417], [7, 36627], [11, 36837], [14, 37097], [20, 37357], [23, 37557], [27, 37737], [34, 37997], [38, 38297], [43, 38557], [46, 38657], [54, 39495], [57, 39596], [65, 39936], [69, 40336], [74, 40556], [77, 40676], [87, 41016], [90, 41236], [94, 41416], [99, 41616]]}, {"verse": 9, "start": 42609, "end": 47661, "text": "To another faith by the same Spirit; to another the gifts of healing by the same Spirit;", "words": [[0, 42609], [3, 42693], [11, 42973], [17, 43253], [20, 43493], [24, 43633], [29, 43813], [37, 44603], [40, 44720], [48, 45040], [52, 45540], [58, 45860], [61, 46100], [69, 46400], [72, 46620], [76, 46800], [81, 47020]]}, {"verse": 10, "start": 48111, "end": 58378, "text": "To another the working of miracles; to another prophecy; to another discerning of spirits; to another various kinds of tongues; to another the interpretation of tongues:", "words": [[0, 48111], [3, 48207], [11, 48467], [15, 48687], [23, 48987], [26, 49187], [36, 50176], [39, 50278], [47, 50538], [57, 51633], [60, 51773], [68, 52033], [79, 52653], [82, 52773], [91, 53654], [94, 53751], [102, 53931], [110, 54511], [116, 54811], [119, 54991], [128, 55829], [131, 55945], [139, 56605], [143, 56745], [158, 57405], [161, 57685]]}, {"verse": 11, "start": 58828, "end": 63783, "text": "But all these works that one and the selfsame Spirit, dividing to every man severally as he will.", "words": [[0, 58828], [4, 58932], [8, 59172], [14, 59372], [20, 59652], [25, 59892], [29, 60172], [33, 60332], [37, 60622], [46, 60912], [54, 61292], [63, 61872], [66, 62132], [72, 62432], [76, 62822], [86, 63212], [89, 63352], [92, 63472]]}, {"verse": 12, "start": 64233, "end": 71861, "text": "For as the body is one, and has many members, and all the members of that one body, being many, are one body: so also is Christ.", "words": [[0, 64336], [4, 64456], [7, 64756], [11, 64916], [16, 65196], [19, 65376], [24, 65676], [28, 65976], [32, 66196], [37, 66476], [46, 66816], [50, 67156], [54, 67396], [58, 67516], [66, 67756], [69, 67956], [74, 68096], [78, 68316], [84, 68556], [90, 68776], [96, 69076], [100, 69376], [104, 69616], [110, 70352], [113, 70536], [118, 70896], [121, 71236]]}, {"verse": 13, "start": 72311, "end": 81542, "text": "For by one Spirit are we all baptized into one body, whether we be Jews or Gentiles, whether we be bond or free; and have been all made to drink into one Spirit.", "words": [[0, 72311], [4, 72436], [7, 72596], [11, 72836], [18, 73136], [22, 73456], [25, 73636], [29, 73876], [38, 74256], [43, 74636], [47, 74876], [53, 75496], [61, 75716], [64, 75916], [67, 76036], [72, 76316], [75, 76596], [85, 77476], [93, 77656], [96, 77856], [99, 78086], [104, 78316], [107, 78396], [113, 79119], [117, 79241], [122, 79401], [127, 79521], [131, 79801], [136, 80021], [139, 80221], [145, 80481], [150, 80761], [154, 81001]]}, {"verse": 14, "start": 81992, "end": 84267, "text": "For the body is not one member, but many.", "words": [[0, 81992], [4, 82105], [8, 82245], [13, 82505], [16, 82665], [20, 82845], [24, 83085], [32, 83705], [36, 83865]]}, {"verse": 15, "start": 84717, "end": 90719, "text": "If the foot shall say, Because I am not the hand, I am not of the body; is it therefore not of the body?", "words": [[0, 84717], [3, 84841], [7, 84981], [12, 85181], [18, 85401], [23, 85841], [31, 86181], [33, 86421], [36, 86541], [40, 86701], [44, 86861], [50, 87381], [52, 87561], [55, 87701], [59, 87941], [62, 88161], [66, 88281], [72, 88973], [75, 89115], [78, 89235], [88, 89595], [92, 89855], [95, 90175], [99, 90315]]}, {"verse": 16, "start": 91169, "end": 97378, "text": "And if the ear shall say, Because I am not the eye, I am not of the body; is it therefore not of the body?", "words": [[0, 91169], [4, 91307], [7, 91407], [11, 91587], [15, 91847], [21, 92127], [26, 92727], [34, 93047], [36, 93267], [39, 93387], [43, 93547], [47, 93727], [52, 94267], [54, 94447], [57, 94567], [61, 94727], [64, 94867], [68, 94967], [74, 95725], [77, 95864], [80, 95984], [90, 96404], [94, 96644], [97, 96804], [101, 96924]]}, {"verse": 17, "start": 97828, "end": 103263, "text": "If the whole body were an eye, where were the hearing? If the whole were hearing, where were the smelling?", "words": [[0, 97828], [3, 97954], [7, 98094], [13, 98334], [18, 98734], [23, 98974], [26, 99134], [31, 99734], [37, 99874], [42, 100034], [46, 100174], [55, 100950], [58, 101075], [62, 101215], [68, 101415], [73, 101615], [82, 102235], [88, 102455], [93, 102635], [97, 102775]]}, {"verse": 18, "start": 103713, "end": 108033, "text": "But now has God set the members every one of them in the body, as it has pleased him.", "words": [[0, 103713], [4, 103869], [8, 104109], [12, 104329], [16, 104549], [20, 104789], [24, 104949], [32, 105469], [38, 105669], [42, 105889], [45, 105989], [50, 106149], [53, 106249], [57, 106329], [63, 106829], [66, 107149], [69, 107269], [73, 107389], [81, 107649]]}, {"verse": 19, "start": 108483, "end": 111013, "text": "And if they were all one member, where were the body?", "words": [[0, 108483], [4, 108624], [7, 108724], [12, 108884], [17, 109044], [21, 109304], [25, 109524], [33, 110184], [39, 110344], [44, 110504], [48, 110624]]}, {"verse": 20, "start": 111463, "end": 114585, "text": "But now are they many members, yet but one body.", "words": [[0, 111463], [4, 111583], [8, 111783], [12, 112043], [17, 112223], [22, 112503], [31, 113383], [35, 113623], [39, 113863], [43, 114103]]}, {"verse": 21, "start": 115035, "end": 120999, "text": "And the eye cannot say to the hand, I have no need of you: nor again the head to the feet, I have no need of you.", "words": [[0, 115035], [4, 115177], [8, 115367], [12, 115557], [19, 115797], [23, 116137], [26, 116297], [30, 116417], [36, 116877], [38, 117117], [43, 117277], [46, 117497], [51, 117697], [54, 117877], [59, 118443], [63, 118623], [69, 118903], [73, 119083], [78, 119263], [81, 119383], [85, 119483], [91, 119703], [93, 119963], [98, 120143], [101, 120383], [106, 120603], [109, 120783]]}, {"verse": 22, "start": 121449, "end": 125746, "text": "No, much more those members of the body, which seem to be more feeble, are necessary:", "words": [[0, 121449], [4, 121631], [9, 121851], [14, 122031], [20, 122251], [28, 122611], [31, 122831], [35, 122951], [41, 123231], [47, 123611], [52, 123851], [55, 124011], [58, 124131], [63, 124291], [71, 124851], [75, 125131]]}, {"verse": 23, "start": 126196, "end": 134833, "text": "And those members of the body, which we think to be less honourable, upon these we bestow more abundant honour; and our uncomely parts have more abundant comeliness.", "words": [[0, 126196], [4, 126343], [10, 126503], [18, 126823], [21, 127023], [25, 127143], [31, 127443], [37, 127983], [40, 128143], [46, 128323], [49, 128463], [52, 128583], [57, 128923], [69, 129263], [74, 129923], [80, 130203], [83, 130383], [90, 130723], [95, 130903], [104, 131353], [112, 132054], [116, 132177], [120, 132317], [129, 132897], [135, 133237], [140, 133457], [145, 133657], [154, 134017]]}, {"verse": 24, "start": 135283, "end": 142310, "text": "For our comely parts have no need: but God has tempered the body together, having given more abundant honour to that part which lacked:", "words": [[0, 135335], [4, 135395], [8, 135595], [15, 135795], [21, 136155], [26, 136395], [29, 136575], [35, 137250], [39, 137348], [43, 137628], [47, 137868], [56, 138328], [60, 138388], [65, 138608], [75, 139268], [82, 139488], [88, 139748], [93, 140008], [102, 140408], [109, 140808], [112, 141008], [117, 141188], [122, 141468], [128, 141788]]}, {"verse": 25, "start": 142760, "end": 147427, "text": "That there should be no schism in the body; but that the members should have the same care one for another.", "words": [[0, 142760], [5, 142860], [11, 142980], [18, 143140], [21, 143300], [24, 143500], [31, 143960], [34, 144140], [38, 144240], [44, 144896], [48, 145001], [53, 145141], [57, 145281], [65, 145561], [72, 145781], [77, 145941], [81, 146081], [86, 146301], [91, 146561], [95, 146781], [99, 146981]]}, {"verse": 26, "start": 147877, "end": 153629, "text": "And whether one member suffer, all the members suffer with it; or one member be honoured, all the members rejoice with it.", "words": [[0, 147877], [4, 148000], [12, 148200], [16, 148500], [23, 148720], [31, 149260], [35, 149420], [39, 149560], [47, 149740], [54, 150040], [59, 150300], [63, 150795], [66, 150878], [70, 151118], [77, 151338], [80, 151788], [90, 152238], [94, 152378], [98, 152538], [106, 152798], [114, 153178], [119, 153498]]}, {"verse": 27, "start": 154079, "end": 157572, "text": "Now you are the body of Christ, and members in particular.", "words": [[0, 154079], [4, 154357], [8, 154757], [12, 154917], [16, 155057], [21, 155377], [24, 155517], [32, 155857], [36, 156357], [44, 156637], [47, 156917]]}, {"verse": 28, "start": 158022, "end": 167984, "text": "And God has set some in the church, first apostles, secondarily prophets, thirdly teachers, after that miracles, then gifts of healings, helps, governments, diversities of tongues.", "words": [[0, 158022], [4, 158147], [8, 158407], [12, 158627], [16, 158847], [21, 159107], [24, 159227], [28, 159327], [36, 159887], [42, 160107], [52, 160887], [64, 161487], [74, 162267], [82, 162647], [92, 163247], [98, 163447], [103, 163647], [113, 164527], [118, 164687], [124, 164927], [127, 165127], [137, 165727], [144, 165967], [157, 166727], [169, 167287], [172, 167467]]}, {"verse": 29, "start": 168434, "end": 173967, "text": "Are all apostles? are all prophets? are all teachers? are all workers of miracles?", "words": [[0, 168434], [4, 168574], [8, 168814], [18, 169755], [22, 169896], [26, 170386], [36, 171118], [40, 171281], [44, 171521], [54, 172413], [58, 172575], [62, 172815], [70, 173155], [73, 173375]]}, {"verse": 30, "start": 174417, "end": 178700, "text": "Have all the gifts of healing? do all speak with tongues? do all interpret?", "words": [[0, 174417], [5, 174547], [9, 174767], [13, 174927], [19, 175127], [22, 175327], [31, 176093], [34, 176238], [38, 176518], [44, 176778], [49, 176978], [58, 177801], [61, 177980], [65, 178120]]}, {"verse": 31, "start": 179150, "end": 184033, "text": "But covet earnestly the best gifts: and yet show I to you a more excellent way.", "words": [[0, 179150], [4, 179348], [10, 179588], [20, 180068], [24, 180288], [29, 180468], [36, 181269], [40, 181393], [44, 181573], [49, 181853], [51, 182133], [54, 182333], [58, 182513], [60, 182753], [65, 183013], [75, 183513]]}]}