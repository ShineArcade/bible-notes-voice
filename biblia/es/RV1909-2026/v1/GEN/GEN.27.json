{"book": "GEN", "chapter": 27, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 413867, "verses": [{"verse": 1, "start": 300, "end": 15202, "text": "Y aconteció que cuando hubo Isaac envejecido, y sus ojos se oscurecieron quedando sin vista, llamó a Esaú, su hijo el mayor, y le dijo: Mi hijo. Y él respondió: Aquí estoy.", "words": [[0, 300], [2, 419], [12, 1119], [16, 1339], [23, 1599], [28, 2139], [34, 2539], [46, 3659], [48, 4239], [52, 4399], [57, 4739], [60, 5039], [73, 5839], [82, 6299], [86, 6519], [93, 7399], [99, 8019], [101, 8179], [107, 9039], [110, 9179], [115, 9439], [118, 9639], [125, 10559], [127, 10659], [130, 10779], [136, 11533], [139, 11732], [145, 12452], [147, 12634], [150, 12774], [161, 13819], [166, 14042]]}, {"verse": 2, "start": 15552, "end": 19636, "text": "Y él dijo: He aquí ya soy viejo, no sé el día de mi muerte:", "words": [[0, 15552], [2, 15740], [5, 15900], [11, 16669], [14, 16828], [19, 17188], [22, 17288], [26, 17468], [33, 18288], [36, 18368], [39, 18548], [42, 18688], [46, 18828], [49, 18968], [52, 19068]]}, {"verse": 3, "start": 20086, "end": 26097, "text": "Toma, pues, ahora tus armas, tu bolsa de flechas y tu arco, y sal al campo, y cázame algo;", "words": [[0, 20086], [6, 20353], [12, 20573], [18, 20933], [22, 21173], [29, 22013], [32, 22053], [38, 22433], [41, 22533], [49, 22973], [51, 23093], [54, 23253], [60, 23633], [62, 23973], [66, 24193], [69, 24393], [76, 24773], [78, 25193], [85, 25613]]}, {"verse": 4, "start": 26547, "end": 33410, "text": "Y hazme un guisado, como yo gusto, y tráemelo, y comeré; para que te bendiga mi alma antes que muera.", "words": [[0, 26547], [2, 26674], [8, 26954], [11, 27094], [20, 27594], [25, 27874], [28, 28094], [35, 28474], [37, 28814], [47, 29394], [49, 29674], [57, 30522], [62, 30666], [66, 30786], [69, 30926], [77, 31346], [80, 31506], [85, 31746], [91, 32106], [95, 32286]]}, {"verse": 5, "start": 33760, "end": 41558, "text": "Y Rebeca estaba oyendo, cuando hablaba Isaac a Esaú su hijo: y se fue Esaú al campo para cazar lo que había de traer.", "words": [[0, 33760], [2, 34017], [9, 34317], [16, 34577], [24, 35097], [31, 35357], [39, 35917], [45, 36197], [47, 36667], [52, 37137], [55, 37277], [61, 38072], [63, 38160], [66, 38260], [70, 38620], [75, 38980], [78, 39340], [84, 39700], [89, 40020], [95, 40340], [98, 40480], [102, 40620], [108, 40840], [111, 41040]]}, {"verse": 6, "start": 42008, "end": 51181, "text": "Entonces Rebeca habló a Jacob su hijo, diciendo: He aquí yo he oído a tu padre que hablaba con Esaú tu hermano, diciendo:", "words": [[0, 42008], [9, 43111], [16, 43851], [22, 44311], [24, 44391], [30, 44731], [33, 45051], [39, 45311], [49, 46359], [52, 46516], [57, 47356], [60, 47516], [63, 47656], [68, 47896], [70, 48036], [73, 48136], [79, 48436], [83, 48676], [91, 49116], [95, 49406], [100, 49696], [103, 49796], [112, 50396]]}, {"verse": 7, "start": 51631, "end": 56850, "text": "Tráeme caza, y hazme un guisado, para que coma, y te bendiga delante de Jehová antes que yo muera.", "words": [[0, 51823], [7, 52049], [13, 52276], [15, 52596], [21, 52856], [24, 52876], [33, 53356], [38, 53616], [42, 53776], [48, 54096], [50, 54336], [53, 54476], [61, 54856], [69, 55236], [72, 55506], [79, 55776], [85, 56076], [89, 56256], [92, 56376]]}, {"verse": 8, "start": 57300, "end": 61351, "text": "Ahora pues, hijo mío, obedece a mi voz en lo que te mando;", "words": [[0, 57300], [6, 57560], [12, 58220], [17, 58340], [22, 59200], [30, 59760], [32, 59860], [35, 59960], [39, 60240], [42, 60420], [45, 60500], [49, 60620], [52, 60760]]}, {"verse": 9, "start": 61801, "end": 70262, "text": "Ve ahora al ganado, y tráeme de allí dos buenos cabritos de las cabras, y haré de ellos comidas para tu padre, como él gusta;", "words": [[0, 61801], [3, 61941], [9, 62201], [12, 62421], [20, 62961], [22, 63461], [29, 63961], [32, 64121], [37, 64421], [41, 64781], [48, 65161], [57, 65741], [60, 65921], [64, 66081], [72, 66621], [74, 67161], [79, 67441], [82, 67521], [88, 67761], [96, 68241], [101, 68521], [104, 68701], [111, 69041], [116, 69501], [119, 69701]]}, {"verse": 10, "start": 70712, "end": 76977, "text": "Y tú las llevarás a tu padre, y comerá, para que te bendiga antes de su muerte.", "words": [[0, 70712], [2, 70826], [5, 70966], [9, 71166], [18, 71706], [20, 71806], [23, 71926], [30, 72266], [32, 72866], [40, 73406], [45, 73746], [49, 73926], [52, 74046], [60, 74546], [66, 74826], [69, 75026], [72, 75146]]}, {"verse": 11, "start": 77327, "end": 84313, "text": "Y Jacob dijo a Rebeca su madre: He aquí, Esaú mi hermano es hombre velloso, y yo lampiño:", "words": [[0, 77327], [2, 77491], [8, 77791], [13, 78611], [15, 78811], [22, 79231], [25, 79431], [32, 80278], [35, 80415], [41, 80875], [46, 81295], [49, 81375], [57, 81935], [60, 82095], [67, 82415], [76, 83075], [78, 83495], [81, 83655]]}, {"verse": 12, "start": 84763, "end": 90606, "text": "Quizá me palpará mi padre, y me tendrá por burlador, y traeré sobre mí maldición y no bendición.", "words": [[0, 84763], [6, 85089], [9, 85189], [17, 85669], [20, 85749], [27, 86089], [29, 86469], [32, 86589], [39, 86929], [43, 87259], [53, 87589], [55, 88049], [62, 88469], [68, 88669], [71, 88909], [81, 89489], [83, 89729], [86, 89869]]}, {"verse": 13, "start": 90956, "end": 100383, "text": "Y su madre respondió: Hijo mío, sobre mí tu maldición: solamente obedece a mi voz, y ve y tráemelos.", "words": [[0, 90956], [2, 91061], [5, 91181], [11, 91581], [22, 92945], [27, 93231], [32, 93911], [38, 94171], [41, 94491], [44, 94691], [55, 96002], [65, 96726], [73, 97386], [75, 97526], [78, 97646], [83, 98086], [85, 98406], [88, 98626], [90, 98806]]}, {"verse": 14, "start": 100733, "end": 108240, "text": "Entonces él fue, y tomó, y los trajo a su madre: y su madre hizo guisados, como su padre gustaba.", "words": [[0, 100733], [9, 101459], [12, 101679], [17, 101979], [19, 102359], [25, 102669], [27, 102979], [31, 103289], [37, 103599], [39, 103739], [42, 103859], [49, 104695], [51, 104817], [54, 104937], [60, 105217], [65, 105577], [75, 106337], [80, 106837], [83, 107017], [89, 107357]]}, {"verse": 15, "start": 108690, "end": 116642, "text": "Y tomó Rebeca los vestidos de Esaú su hijo mayor, los preciosos, que ella tenía en casa, y vistió a Jacob su hijo menor:", "words": [[0, 108690], [2, 108813], [7, 109153], [14, 109493], [18, 109673], [27, 110073], [30, 110343], [35, 110613], [38, 110753], [43, 110953], [50, 111793], [54, 111913], [65, 112913], [69, 113153], [74, 113353], [80, 113693], [83, 113873], [89, 114693], [91, 114753], [98, 115113], [100, 115273], [106, 115513], [109, 115853], [114, 116093]]}, {"verse": 16, "start": 117092, "end": 124409, "text": "E le hizo vestir sobre sus manos, y sobre la nuca donde no tenía vello, las pieles de los cabritos de las cabras;", "words": [[0, 117172], [2, 117282], [5, 117362], [10, 117682], [17, 118202], [23, 118482], [27, 118682], [34, 119122], [36, 119382], [42, 119622], [45, 119822], [50, 120142], [56, 120322], [59, 120582], [65, 120992], [72, 121402], [76, 121822], [83, 122502], [86, 122622], [90, 122762], [99, 123322], [102, 123522], [106, 123662]]}, {"verse": 17, "start": 124859, "end": 129744, "text": "Y entregó los guisados y el pan que había preparado, en mano de Jacob su hijo.", "words": [[0, 124859], [2, 125000], [10, 125520], [14, 125680], [23, 126200], [25, 126440], [28, 126580], [32, 126860], [36, 127080], [42, 127320], [53, 128000], [56, 128160], [61, 128380], [64, 128560], [70, 128880], [73, 129239]]}, {"verse": 18, "start": 130194, "end": 137263, "text": "Y él fue a su padre, y dijo: Padre mío: y él respondió: Aquí estoy, ¿quién eres, hijo mío?", "words": [[0, 130194], [2, 130355], [5, 130495], [9, 130695], [11, 130855], [14, 130975], [21, 131675], [23, 132077], [29, 132686], [35, 132965], [40, 133678], [42, 133860], [45, 134000], [56, 135045], [61, 135264], [68, 136204], [75, 136444], [81, 136604], [86, 136844]]}, {"verse": 19, "start": 137613, "end": 148081, "text": "Y Jacob dijo a su padre: Yo soy Esaú tu primogénito; he hecho como me dijiste: levántate ahora, y siéntate, y come de mi caza, para que me bendiga tu alma.", "words": [[0, 137857], [2, 138137], [8, 138417], [13, 138817], [15, 138917], [18, 139057], [25, 139929], [28, 140072], [32, 140345], [37, 140619], [40, 140892], [53, 142092], [56, 142216], [62, 142416], [67, 142636], [70, 142776], [79, 143680], [89, 144222], [96, 144541], [98, 144741], [108, 145282], [110, 145521], [115, 145741], [118, 145882], [121, 146111], [127, 146342], [132, 146861], [136, 147002], [139, 147102], [147, 147502], [150, 147682]]}, {"verse": 20, "start": 148431, "end": 159208, "text": "Entonces Isaac dijo a su hijo: ¿Cómo es que la hallaste tan pronto, hijo mío? Y él respondió: Porque Jehová tu Dios hizo que se encontrase delante de mí.", "words": [[0, 148431], [9, 148893], [15, 149673], [20, 150513], [22, 150753], [25, 150893], [31, 151633], [37, 151837], [40, 152057], [44, 152197], [47, 152357], [56, 152737], [60, 152937], [68, 153497], [73, 153617], [78, 154428], [80, 154610], [83, 154750], [94, 155795], [101, 156023], [108, 156583], [111, 156683], [116, 157243], [121, 157443], [125, 157643], [128, 157763], [139, 158343], [147, 158763], [150, 158923]]}, {"verse": 21, "start": 159558, "end": 166633, "text": "E Isaac dijo a Jacob: Acércate ahora, y te palparé, hijo mío, para saber si eres mi hijo Esaú, o no.", "words": [[0, 159848], [2, 160174], [8, 160501], [13, 160941], [15, 161061], [22, 161887], [31, 162404], [38, 162744], [40, 162884], [43, 163004], [52, 163544], [57, 163724], [62, 164124], [67, 164564], [73, 164864], [76, 165104], [81, 165304], [84, 165504], [89, 165814], [95, 166124], [97, 166344]]}, {"verse": 22, "start": 166983, "end": 176138, "text": "Y Jacob se acercó a su padre Isaac; y él le palpó, y dijo: La voz es la voz de Jacob, pero las manos, las manos de Esaú.", "words": [[0, 166983], [2, 167144], [8, 167384], [11, 167684], [18, 168224], [20, 168324], [23, 168464], [29, 168824], [36, 169806], [38, 169974], [41, 170194], [44, 170554], [51, 171214], [53, 171454], [59, 172216], [62, 172314], [66, 172574], [69, 172754], [72, 172934], [76, 173134], [79, 173254], [86, 173874], [91, 173994], [95, 174194], [102, 174914], [106, 175034], [112, 175354], [115, 175594]]}, {"verse": 23, "start": 176488, "end": 183671, "text": "Y no le conoció, porque sus manos eran vellosas como las manos de Esaú: y le bendijo.", "words": [[0, 176488], [2, 176630], [5, 176790], [8, 176950], [17, 177950], [24, 178470], [28, 178710], [34, 179130], [39, 179800], [48, 180470], [53, 180870], [57, 181050], [63, 181410], [66, 181690], [72, 182660], [74, 182785], [77, 182885]]}, {"verse": 24, "start": 184121, "end": 190824, "text": "Y dijo: ¿Eres tú mi hijo Esaú? Y Jacob respondió: Yo soy.", "words": [[0, 184121], [2, 184452], [8, 185269], [14, 185510], [17, 185810], [20, 185890], [25, 186150], [31, 188420], [33, 188585], [39, 188885], [50, 190173], [53, 190394]]}, {"verse": 25, "start": 191174, "end": 201861, "text": "Y dijo: Acércamela, y comeré de la caza de mi hijo, para que te bendiga mi alma; y él se la acercó, y comió: le trajo también vino, y bebió.", "words": [[0, 191174], [2, 191505], [8, 192322], [20, 193066], [22, 193326], [29, 193726], [32, 193786], [35, 193966], [40, 194146], [43, 194326], [46, 194446], [52, 194746], [57, 195286], [61, 195426], [64, 195546], [72, 195926], [75, 196086], [81, 196859], [83, 197021], [86, 197181], [89, 197361], [92, 197521], [100, 198241], [102, 198481], [109, 199471], [112, 199577], [118, 199937], [126, 200257], [132, 200797], [134, 201237]]}, {"verse": 26, "start": 202311, "end": 207088, "text": "Y le dijo Isaac su padre: Acércate ahora, y bésame, hijo mío.", "words": [[0, 202311], [2, 202477], [5, 202727], [10, 202977], [16, 203557], [19, 203777], [26, 204658], [35, 205175], [42, 205515], [44, 205775], [52, 206515], [57, 206635]]}, {"verse": 27, "start": 207438, "end": 219370, "text": "Y él se llegó, y le besó; y olió Isaac el olor de sus vestidos, y le bendijo, y dijo: Mira, el olor de mi hijo como el olor del campo que Jehová ha bendecido:", "words": [[0, 207438], [2, 207641], [5, 207821], [8, 208041], [15, 208361], [17, 208981], [20, 209327], [26, 209919], [28, 210144], [33, 210404], [39, 210844], [42, 211264], [47, 211604], [50, 211724], [54, 211924], [64, 212664], [66, 212904], [69, 213004], [78, 213904], [80, 214184], [86, 214998], [92, 215240], [95, 215480], [100, 215760], [103, 215900], [106, 216060], [111, 216320], [116, 216700], [119, 216900], [124, 217200], [128, 217360], [134, 217780], [138, 218120], [145, 218460], [148, 218580]]}, {"verse": 28, "start": 219820, "end": 225873, "text": "Dios, pues, te dé del rocío del cielo, y de lo mejor de la tierra, y abundancia de trigo y de mosto.", "words": [[0, 219820], [6, 220040], [12, 220400], [15, 220840], [18, 221040], [22, 221200], [28, 221620], [32, 221740], [39, 222220], [41, 222500], [44, 222600], [47, 222700], [53, 222980], [56, 223140], [59, 223240], [67, 223620], [69, 223960], [80, 224580], [83, 224760], [89, 225160], [91, 225260], [94, 225360]]}, {"verse": 29, "start": 226323, "end": 236658, "text": "Te sirvan pueblos, y naciones se inclinen a ti: sé señor de tus hermanos, y se inclinen a ti los hijos de tu madre: malditos los que te maldigan, y benditos los que te bendigan.", "words": [[0, 226323], [3, 226407], [10, 226767], [19, 227267], [21, 227367], [30, 227707], [33, 228047], [42, 228467], [44, 228567], [48, 229189], [51, 229447], [57, 229807], [60, 229987], [64, 230127], [74, 230767], [76, 230907], [79, 231047], [88, 231527], [90, 231607], [93, 231747], [97, 231907], [103, 232207], [106, 232427], [109, 232547], [116, 233314], [125, 233760], [129, 233940], [133, 234120], [136, 234240], [146, 234760], [148, 235040], [157, 235540], [161, 235720], [165, 235900], [168, 236020]]}, {"verse": 30, "start": 237008, "end": 249818, "text": "Y aconteció, luego que hubo Isaac acabado de bendecir a Jacob, y apenas había salido Jacob de delante de Isaac su padre, que Esaú su hermano vino de su caza.", "words": [[0, 237008], [2, 237176], [13, 237896], [19, 238156], [23, 238496], [28, 238896], [34, 239316], [42, 240136], [45, 240316], [54, 240936], [56, 241096], [63, 241536], [65, 242196], [72, 242736], [78, 243216], [85, 243776], [91, 244216], [94, 244456], [102, 244896], [105, 245076], [111, 245716], [114, 245816], [121, 246956], [125, 247203], [130, 247449], [133, 247696], [141, 248476], [146, 248896], [149, 249096], [152, 249465]]}, {"verse": 31, "start": 250268, "end": 259052, "text": "E hizo él también guisados, y trajo a su padre, y le dijo: Levántese mi padre, y coma de la caza de su hijo, para que me bendiga tu alma.", "words": [[0, 250268], [2, 250405], [7, 250685], [10, 250905], [18, 251225], [28, 251885], [30, 252085], [36, 252385], [38, 252485], [41, 252585], [48, 253525], [50, 253765], [53, 253885], [59, 254677], [69, 255217], [72, 255377], [79, 255717], [81, 255977], [86, 256257], [89, 256397], [92, 256557], [97, 256717], [100, 256897], [103, 257057], [109, 257337], [114, 257797], [118, 257917], [121, 258037], [129, 258437], [132, 258597]]}, {"verse": 32, "start": 259402, "end": 270897, "text": "Entonces Isaac su padre le dijo: ¿Quién eres tú? Y él dijo: Yo soy tu hijo, tu primogénito, Esaú.", "words": [[0, 259402], [9, 259888], [15, 261068], [18, 261288], [24, 261908], [27, 262008], [33, 262846], [40, 263041], [45, 263221], [49, 267100], [51, 267289], [54, 267449], [60, 268218], [63, 268404], [67, 268604], [70, 268824], [76, 269384], [79, 269444], [92, 270344]]}, {"verse": 33, "start": 271247, "end": 284435, "text": "Y se estremeció Isaac con grande estremecimiento, y dijo: ¿Quién es el que vino aquí, que cazó, y me trajo, y comí de todo antes que vinieses? Yo le bendije, y será bendito.", "words": [[0, 271247], [2, 271514], [5, 271634], [16, 272694], [22, 273254], [26, 274194], [33, 274654], [50, 275814], [52, 276334], [58, 277169], [65, 277381], [68, 277541], [71, 277661], [75, 277801], [80, 278021], [86, 278561], [90, 278861], [96, 279161], [98, 279361], [101, 279481], [108, 280201], [110, 280221], [115, 280641], [118, 280781], [123, 281001], [129, 281401], [133, 281681], [143, 282703], [146, 282847], [149, 282987], [158, 283447], [160, 283567], [165, 283767]]}, {"verse": 34, "start": 284785, "end": 294086, "text": "Como Esaú oyó las palabras de su padre, clamó con una muy grande y muy amarga exclamación, y le dijo: Bendíceme también a mí, padre mío.", "words": [[0, 284785], [5, 285012], [10, 285612], [14, 286032], [18, 286172], [27, 286552], [30, 286792], [33, 286932], [40, 287552], [46, 288172], [50, 288372], [54, 288592], [58, 288832], [65, 289232], [67, 289392], [71, 289552], [78, 290092], [91, 290912], [93, 291192], [96, 291292], [102, 292345], [112, 292645], [120, 292905], [122, 293145], [126, 293505], [132, 293745]]}, {"verse": 35, "start": 294436, "end": 298463, "text": "Y él dijo: Vino tu hermano con engaño, y tomó tu bendición.", "words": [[0, 294436], [2, 294624], [5, 294784], [11, 295553], [16, 295791], [19, 296011], [27, 296471], [31, 296591], [39, 297111], [41, 297391], [46, 297691], [49, 297771]]}, {"verse": 36, "start": 298813, "end": 311009, "text": "Y él respondió: Bien llamaron su nombre Jacob, que ya me ha engañado dos veces; se alzó con mi primogenitura, y he aquí ahora ha tomado mi bendición. Y dijo: ¿No has guardado bendición para mí?", "words": [[0, 298813], [2, 298995], [5, 299135], [16, 300179], [21, 300421], [30, 300821], [33, 301001], [40, 301241], [47, 301881], [51, 301941], [54, 302121], [57, 302241], [60, 302321], [69, 302761], [73, 302921], [80, 303928], [83, 304074], [88, 304394], [92, 304534], [95, 304654], [110, 305434], [112, 305914], [115, 306014], [120, 306254], [126, 306394], [129, 306534], [136, 307034], [139, 307154], [150, 308196], [152, 308527], [158, 309343], [162, 309484], [166, 309564], [175, 309944], [185, 310424], [190, 310644]]}, {"verse": 37, "start": 311359, "end": 324254, "text": "Isaac respondió y dijo a Esaú: He aquí yo le he puesto por señor tuyo, y le he dado por siervos a todos sus hermanos: de trigo y de vino le he provisto: ¿qué, pues, te haré a ti ahora, hijo mío?", "words": [[0, 311359], [6, 311810], [16, 313010], [18, 313230], [23, 313550], [25, 313650], [31, 314473], [34, 314613], [39, 315093], [42, 315193], [45, 315333], [48, 315413], [55, 315653], [59, 315893], [65, 316093], [71, 316593], [73, 317053], [76, 317193], [79, 317273], [84, 317453], [88, 317733], [96, 318113], [98, 318293], [104, 318493], [108, 318733], [118, 319712], [121, 319851], [127, 320231], [129, 320311], [132, 320431], [137, 320631], [140, 320831], [143, 320971], [153, 321947], [159, 322065], [165, 322345], [168, 322685], [173, 322945], [175, 323005], [178, 323125], [185, 323605], [190, 323765]]}, {"verse": 38, "start": 324604, "end": 334245, "text": "Y Esaú respondió a su padre: ¿No tienes más que una sola bendición, padre mío? bendíceme también a mí, padre mío. Y alzó Esaú su voz, y lloró.", "words": [[0, 324604], [2, 324909], [7, 325249], [17, 325809], [19, 325909], [22, 326009], [29, 326846], [33, 326969], [40, 327229], [44, 327469], [48, 327629], [52, 327769], [57, 328029], [68, 328769], [74, 329029], [79, 330007], [89, 330267], [97, 330547], [99, 330747], [103, 330827], [109, 331067], [114, 331942], [116, 332084], [121, 332554], [126, 333024], [129, 333164], [134, 333444], [136, 333704]]}, {"verse": 39, "start": 334695, "end": 343418, "text": "Entonces Isaac su padre habló y le dijo: He aquí será tu habitación en lo mejor de la tierra, y del rocío de los cielos de arriba;", "words": [[0, 334695], [9, 335311], [15, 336251], [18, 336351], [24, 336871], [30, 337271], [32, 337471], [35, 337591], [41, 338428], [44, 338518], [49, 338778], [54, 339018], [57, 339238], [68, 339858], [71, 339998], [74, 340098], [80, 340398], [83, 340518], [86, 340618], [94, 341058], [96, 341518], [100, 341698], [106, 342138], [109, 342258], [113, 342398], [120, 342778], [123, 342898]]}, {"verse": 40, "start": 343868, "end": 351557, "text": "Y por tu espada vivirás, y a tu hermano servirás: y sucederá cuando te fortalezcas, que descargarás su yugo de tu cerviz.", "words": [[0, 343868], [2, 343990], [6, 344150], [9, 344350], [16, 344770], [25, 345370], [27, 345570], [29, 345650], [32, 345770], [40, 346190], [50, 347241], [52, 347343], [61, 347923], [68, 348103], [71, 348323], [84, 349103], [88, 349543], [100, 350203], [103, 350403], [108, 350703], [111, 350823], [114, 351218]]}, {"verse": 41, "start": 351907, "end": 363732, "text": "Y aborreció Esaú a Jacob por la bendición con que le había bendecido, y dijo en su corazón: Llegarán los días del luto de mi padre, y yo mataré a Jacob mi hermano.", "words": [[0, 351907], [2, 352028], [12, 352658], [17, 353288], [19, 353488], [25, 353848], [29, 354268], [32, 354408], [42, 355028], [46, 355588], [50, 355788], [53, 355948], [59, 356208], [70, 357488], [72, 357588], [77, 357908], [80, 358068], [83, 358208], [92, 359204], [101, 359667], [105, 359847], [110, 360107], [114, 360387], [119, 360727], [122, 360847], [125, 360967], [132, 361327], [134, 361907], [137, 362087], [144, 362527], [146, 362627], [152, 363127], [155, 363207]]}, {"verse": 42, "start": 364082, "end": 376655, "text": "Y fueron dichas a Rebeca las palabras de Esaú su hijo mayor: y ella envió y llamó a Jacob su hijo menor, y le dijo: He aquí, Esaú tu hermano se consuela acerca de ti con la idea de matarte.", "words": [[0, 364082], [2, 364204], [9, 364484], [16, 365004], [18, 365144], [25, 365524], [29, 365684], [38, 366104], [41, 366494], [46, 366884], [49, 366984], [54, 367224], [61, 368102], [63, 368281], [68, 368501], [74, 369001], [76, 369201], [82, 369561], [84, 369641], [90, 370281], [93, 370401], [98, 370601], [105, 371161], [107, 371181], [110, 371301], [116, 372078], [119, 372138], [125, 372478], [130, 372818], [133, 373018], [141, 373518], [144, 373638], [153, 374238], [160, 374558], [163, 374878], [166, 375078], [170, 375338], [173, 375478], [178, 375698], [181, 375878]]}, {"verse": 43, "start": 377105, "end": 383173, "text": "Ahora pues, hijo mío, obedece a mi voz; levántate, y huye a Labán mi hermano, a Harán;", "words": [[0, 377105], [6, 377403], [12, 377983], [17, 378123], [22, 378703], [30, 379163], [32, 379283], [35, 379363], [40, 380162], [51, 380828], [53, 381088], [58, 381348], [60, 381578], [66, 381808], [69, 381888], [78, 382508], [80, 382864]]}, {"verse": 44, "start": 383623, "end": 388651, "text": "Y mora con él algunos días, hasta que el enojo de tu hermano se mitigue;", "words": [[0, 383623], [2, 383723], [7, 384023], [11, 384223], [14, 384383], [22, 384763], [28, 385643], [34, 385883], [38, 386103], [41, 386263], [47, 386603], [50, 386743], [53, 386863], [61, 387323], [64, 387443]]}, {"verse": 45, "start": 389101, "end": 400822, "text": "Hasta que se aplaque la ira de tu hermano contra ti, y se olvide de lo que le has hecho: yo enviaré entonces, y te traeré de allá: ¿por qué seré privada de vosotros ambos en un día?", "words": [[0, 389101], [6, 389301], [10, 389461], [13, 389621], [21, 390081], [24, 390241], [28, 390501], [31, 390601], [34, 390741], [42, 391201], [49, 391501], [53, 391801], [55, 392281], [58, 392421], [65, 392881], [68, 393001], [71, 393121], [75, 393241], [78, 393381], [82, 393581], [89, 394351], [92, 394538], [100, 394998], [110, 395418], [112, 396138], [115, 396278], [122, 396758], [125, 396818], [131, 397575], [136, 397679], [140, 397919], [145, 398279], [153, 398759], [156, 398919], [165, 399439], [171, 399879], [174, 400139], [177, 400279]]}, {"verse": 46, "start": 401172, "end": 413467, "text": "Y dijo Rebeca a Isaac: Fastidio tengo de mi vida, a causa de las hijas de Het. Si Jacob toma mujer de las hijas de Het, como estas, de las hijas de esta tierra, ¿para qué quiero la vida?", "words": [[0, 401172], [2, 401314], [7, 401587], [14, 401861], [16, 402134], [23, 403691], [32, 403991], [38, 404231], [41, 404411], [44, 404551], [50, 405151], [52, 405251], [58, 405511], [61, 405731], [65, 405871], [71, 406271], [74, 406611], [79, 407179], [82, 407343], [88, 407623], [93, 407943], [99, 408243], [102, 408443], [106, 408583], [112, 408943], [115, 409173], [120, 409403], [125, 409703], [132, 410423], [135, 410463], [139, 410583], [145, 410983], [148, 411103], [153, 411263], [161, 412263], [167, 412463], [171, 412623], [178, 412903], [181, 413043]]}]}