{"book": "ISA", "chapter": 24, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 221493, "verses": [{"verse": 1, "start": 300, "end": 8401, "text": "He aquí que Jehová vacía la tierra, y la desnuda, y trastorna su faz, y hace esparcir sus habitantes.", "words": [[0, 300], [3, 423], [8, 703], [12, 993], [19, 1283], [25, 1683], [28, 1823], [36, 2343], [38, 2923], [41, 3043], [50, 3663], [52, 3883], [62, 4663], [65, 4823], [70, 5303], [72, 6023], [77, 6303], [86, 7083], [90, 7323]]}, {"verse": 2, "start": 8851, "end": 26746, "text": "Y será como el pueblo, tal el sacerdote; como el siervo, tal su señor; como la criada, tal su señora; tal el que compra, como el que vende; tal el que da prestado, como el que toma prestado; tal el que da con usura, como el que lo recibe.", "words": [[0, 8851], [2, 9150], [7, 9350], [12, 9630], [15, 9790], [23, 10050], [27, 10390], [30, 10750], [41, 12138], [46, 12326], [49, 12486], [57, 12986], [61, 13266], [64, 13486], [71, 14360], [76, 14545], [79, 14705], [87, 15305], [91, 15625], [94, 15905], [102, 17054], [106, 17359], [109, 17679], [113, 17839], [121, 18399], [126, 18979], [129, 19139], [133, 19259], [140, 20198], [144, 20382], [147, 20602], [151, 20742], [154, 20902], [164, 21542], [169, 21802], [172, 21982], [176, 22082], [181, 22382], [191, 23530], [195, 23662], [198, 23832], [202, 24002], [205, 24172], [209, 24452], [216, 24952], [221, 25512], [224, 25692], [228, 25812], [231, 25972]]}, {"verse": 3, "start": 27196, "end": 34650, "text": "Del todo será vaciada la tierra, y enteramente saqueada; porque Jehová ha pronunciado esta palabra.", "words": [[0, 27196], [4, 27383], [9, 27763], [14, 28103], [22, 28663], [25, 28843], [33, 29303], [35, 29883], [47, 30643], [57, 31950], [64, 32175], [71, 32735], [74, 32855], [86, 33675], [91, 33855]]}, {"verse": 4, "start": 35100, "end": 42649, "text": "Se destruyó, cayó la tierra; enfermó, cayó el mundo; enfermaron los altos pueblos de la tierra.", "words": [[0, 35100], [3, 35237], [13, 36397], [18, 36737], [21, 36857], [29, 37838], [38, 38431], [43, 38831], [46, 38971], [53, 39835], [64, 40675], [68, 40835], [74, 41295], [82, 41755], [85, 41855], [88, 41975]]}, {"verse": 5, "start": 43099, "end": 52566, "text": "Y la tierra se contaminó bajo sus habitantes; porque traspasaron las leyes, falsearon el derecho, rompieron el pacto sempiterno.", "words": [[0, 43099], [2, 43186], [5, 43286], [12, 43606], [15, 43866], [25, 44606], [30, 44706], [34, 44986], [46, 46232], [53, 46397], [65, 47197], [69, 47377], [76, 48147], [86, 48917], [89, 49117], [98, 50077], [108, 50597], [111, 50817], [117, 51517]]}, {"verse": 6, "start": 53016, "end": 66045, "text": "Por esta causa la maldición consumió la tierra, y sus habitantes fueron asolados; por esta causa fueron consumidos los habitantes de la tierra, y se disminuyeron los hombres.", "words": [[0, 53016], [4, 53137], [9, 53337], [15, 53737], [18, 53937], [28, 54577], [37, 55257], [40, 55397], [48, 55857], [50, 56417], [54, 56557], [65, 57197], [72, 57477], [82, 58797], [86, 59159], [91, 59379], [97, 59899], [104, 60499], [115, 61459], [119, 61739], [130, 62439], [133, 62559], [136, 62659], [144, 63079], [146, 63799], [149, 63959], [162, 65059], [166, 65199]]}, {"verse": 7, "start": 66495, "end": 73887, "text": "Se perdió el vino, enfermó la vid, gimieron todos los que eran alegres de corazón.", "words": [[0, 66495], [3, 66700], [10, 67320], [13, 67600], [19, 68760], [27, 69560], [30, 69720], [35, 70510], [44, 71300], [50, 71760], [54, 72200], [58, 72380], [63, 72600], [71, 73040], [74, 73140]]}, {"verse": 8, "start": 74337, "end": 82125, "text": "Cesó el regocijo de los panderos, se acabó el estruendo de los que se alegran, paró la alegría del arpa.", "words": [[0, 74556], [5, 74816], [8, 74976], [17, 75696], [20, 75816], [24, 75916], [34, 77256], [37, 77356], [43, 77856], [46, 77996], [56, 78596], [59, 78816], [63, 78916], [67, 79076], [70, 79256], [79, 80196], [84, 80536], [87, 80716], [95, 81205], [99, 81694]]}, {"verse": 9, "start": 82575, "end": 87422, "text": "No beberán vino con cantar: la bebida será amarga a los que la beben.", "words": [[0, 82575], [3, 82741], [11, 83241], [16, 83521], [20, 83861], [28, 84939], [31, 85060], [38, 85440], [43, 85700], [50, 86360], [52, 86520], [56, 86620], [60, 86740], [63, 86880]]}, {"verse": 10, "start": 87872, "end": 94373, "text": "Quebrantada está la ciudad de la vanidad; toda casa se ha cerrado, porque no entre nadie.", "words": [[0, 87872], [12, 88796], [17, 89096], [20, 89316], [27, 89756], [30, 90136], [33, 90276], [42, 91291], [47, 91576], [52, 91896], [55, 92156], [58, 92296], [67, 92816], [74, 93156], [77, 93396], [83, 93716]]}, {"verse": 11, "start": 94823, "end": 102458, "text": "Voces sobre el vino en las calles; todo gozo se oscureció, se desterró la alegría de la tierra.", "words": [[0, 94823], [6, 95369], [12, 95829], [15, 96249], [20, 96529], [23, 96709], [27, 96849], [35, 97778], [40, 98120], [45, 98541], [48, 98700], [59, 99920], [62, 100041], [71, 100620], [74, 100821], [82, 101560], [85, 101681], [88, 101800]]}, {"verse": 12, "start": 102908, "end": 107974, "text": "En la ciudad quedó soledad, y con asolamiento fue herida la puerta.", "words": [[0, 102908], [3, 103077], [6, 103197], [13, 103657], [19, 104057], [28, 104837], [30, 105457], [34, 105677], [46, 106297], [50, 106657], [57, 107157], [60, 107277]]}, {"verse": 13, "start": 108424, "end": 116991, "text": "Porque así será en medio de la tierra, en medio de los pueblos, como olivo sacudido, como rebuscos acabada la vendimia.", "words": [[0, 108424], [7, 108684], [11, 108924], [16, 109284], [19, 109504], [25, 109784], [28, 109964], [31, 110084], [39, 111144], [42, 111204], [48, 111444], [51, 111604], [55, 111704], [64, 112264], [69, 112964], [75, 113664], [85, 114364], [90, 114444], [99, 115284], [107, 115984], [110, 116496]]}, {"verse": 14, "start": 117441, "end": 124529, "text": "Estos alzarán su voz, cantarán gozosos en la grandeza de Jehová, desde el mar darán voces.", "words": [[0, 117441], [6, 117851], [14, 118551], [17, 118731], [22, 119491], [31, 120011], [39, 120731], [42, 120891], [45, 121051], [54, 121691], [57, 121831], [65, 122571], [71, 122791], [74, 123071], [78, 123311], [84, 123851]]}, {"verse": 15, "start": 124979, "end": 132539, "text": "Glorificad por esto a Jehová en los valles: en islas del mar sea nombrado Jehová Dios de Israel.", "words": [[0, 125346], [11, 125746], [15, 125966], [20, 126206], [22, 126426], [29, 126826], [32, 126946], [36, 127086], [44, 128114], [47, 128454], [53, 128794], [57, 128994], [61, 129344], [65, 129694], [74, 130274], [81, 131194], [86, 131354], [89, 131694]]}, {"verse": 16, "start": 132989, "end": 145345, "text": "De lo último de la tierra oímos salmos: Gloria al justo. Y yo dije: ¡Mi flaqueza, mi flaqueza, ay de mí! Los traidores han traicionado; han tramado traiciones.", "words": [[0, 132989], [3, 133138], [6, 133298], [13, 133698], [16, 133898], [19, 134038], [26, 134398], [32, 134998], [40, 136372], [47, 136586], [50, 136799], [57, 137667], [59, 137792], [62, 138110], [68, 138665], [72, 139113], [82, 139593], [85, 139906], [95, 140220], [98, 140533], [101, 140693], [105, 141327], [109, 141413], [119, 141893], [123, 142213], [136, 143411], [140, 143731], [148, 144351]]}, {"verse": 17, "start": 145795, "end": 150173, "text": "Terror y sima y lazo sobre ti, oh habitante de la tierra.", "words": [[0, 145795], [7, 146177], [9, 146517], [14, 146797], [16, 147077], [21, 147357], [27, 147737], [31, 148137], [34, 148537], [44, 149197], [47, 149357], [50, 149477]]}, {"verse": 18, "start": 150623, "end": 165721, "text": "Y acontecerá que el que huirá de la voz del terror, caerá en la sima; y el que sale de en medio de la sima, será preso del lazo: porque de lo alto se abrieron ventanas, y temblarán los fundamentos de la tierra.", "words": [[0, 150623], [2, 150768], [13, 151628], [17, 151828], [20, 152108], [24, 152328], [30, 152988], [33, 153108], [36, 153228], [40, 153468], [44, 153648], [52, 154168], [58, 155108], [61, 155208], [64, 155558], [70, 156208], [72, 156329], [75, 156409], [79, 156549], [84, 156889], [87, 157129], [90, 157309], [96, 157569], [99, 157729], [102, 157979], [108, 158229], [113, 158809], [119, 159369], [123, 159549], [129, 160466], [136, 160648], [139, 160868], [142, 161008], [147, 161268], [150, 161488], [159, 161928], [169, 162648], [171, 163168], [181, 163788], [185, 163948], [197, 164768], [200, 164868], [203, 164988]]}, {"verse": 19, "start": 166171, "end": 174588, "text": "Se quebrantará del todo la tierra, enteramente desmenuzada será la tierra, en gran manera será la tierra conmovida.", "words": [[0, 166171], [3, 166355], [15, 167115], [19, 167315], [24, 167655], [27, 167895], [35, 168875], [47, 169515], [59, 170595], [64, 170835], [67, 171035], [75, 171995], [78, 172135], [83, 172335], [90, 172715], [95, 173035], [98, 173235], [105, 173535]]}, {"verse": 20, "start": 175038, "end": 187207, "text": "Temblará la tierra vacilando como un borracho, y será removida como una choza; y se agravará sobre ella su pecado, y caerá, y nunca más se levantará.", "words": [[0, 175038], [9, 175543], [12, 175643], [19, 176003], [29, 176763], [34, 177043], [37, 177223], [47, 177843], [49, 178303], [54, 178583], [63, 179543], [68, 179843], [72, 180103], [79, 181100], [81, 181225], [84, 181345], [93, 181965], [99, 182245], [104, 182525], [107, 182745], [115, 183325], [117, 183945], [124, 184645], [126, 184985], [132, 185245], [136, 185885], [139, 186265]]}, {"verse": 21, "start": 187657, "end": 197243, "text": "Y acontecerá en aquel día, que Jehová visitará sobre el ejército sublime en lo alto, y sobre los reyes de la tierra que hay sobre la tierra.", "words": [[0, 187657], [2, 187786], [13, 188626], [16, 188746], [22, 189106], [27, 189406], [31, 189986], [38, 190466], [47, 191086], [53, 191426], [56, 191746], [65, 192366], [73, 192946], [76, 193106], [79, 193266], [85, 193666], [87, 194186], [93, 194426], [97, 194646], [103, 195086], [106, 195206], [109, 195346], [116, 195666], [120, 195946], [124, 196106], [130, 196366], [133, 196606]]}, {"verse": 22, "start": 197693, "end": 207861, "text": "Y serán amontonados como se amontonan encarcelados en mazmorra, y en prisión quedarán encerrados, y serán visitados después de muchos días.", "words": [[0, 197693], [2, 197802], [8, 198222], [20, 199222], [25, 199642], [28, 199822], [38, 200522], [51, 201422], [54, 201862], [64, 202302], [66, 202722], [69, 202882], [77, 203582], [86, 204182], [98, 204922], [100, 205462], [106, 205782], [116, 206382], [124, 206662], [127, 206862], [134, 207062]]}, {"verse": 23, "start": 208311, "end": 221093, "text": "La luna se avergonzará, y el sol se confundirá, cuando Jehová de los ejércitos reine en el monte de Sion, y en Jerusalén, y delante de sus ancianos sea glorioso.", "words": [[0, 208311], [3, 208455], [8, 208775], [11, 208955], [24, 209755], [26, 210315], [29, 210495], [33, 210715], [36, 210955], [48, 211875], [55, 212435], [62, 213115], [65, 213195], [69, 213355], [79, 214195], [85, 215035], [88, 215315], [91, 215455], [97, 215775], [100, 215975], [106, 216475], [108, 216975], [111, 217175], [122, 218135], [124, 218535], [132, 218955], [135, 219115], [139, 219275], [148, 219935], [152, 220542]]}]}