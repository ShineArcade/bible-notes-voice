{"book": "ROM", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 109739, "verses": [{"verse": 1, "start": 300, "end": 8283, "text": "Toda alma se someta a las autoridades superiores; porque no hay autoridad sino de Dios; y las que son, de Dios son ordenadas.", "words": [[0, 300], [5, 564], [10, 764], [13, 944], [20, 1464], [22, 1544], [26, 1664], [38, 2284], [50, 3424], [57, 3627], [60, 3887], [64, 4087], [74, 4627], [79, 4947], [82, 5147], [88, 5868], [90, 5969], [94, 6089], [98, 6269], [103, 6549], [106, 6969], [111, 7189], [115, 7469]]}, {"verse": 2, "start": 8633, "end": 16137, "text": "Así que, el que se opone a la autoridad, a la ordenación de Dios resiste: y los que resisten, ellos mismos ganan condenación para sí.", "words": [[0, 8633], [4, 8857], [9, 9077], [12, 9197], [16, 9317], [19, 9457], [25, 9857], [27, 9977], [30, 10037], [41, 10817], [43, 10817], [46, 10877], [57, 11397], [60, 11577], [65, 11797], [74, 12782], [76, 12881], [80, 12981], [84, 13121], [94, 14001], [100, 14181], [107, 14501], [113, 14881], [125, 15481], [130, 15721]]}, {"verse": 3, "start": 16487, "end": 24317, "text": "Porque los magistrados no son para temor al que bien hace, sino al malo. ¿Quieres pues no temer la autoridad? haz lo bueno, y tendrás alabanza de ella;", "words": [[0, 16487], [7, 16671], [11, 16851], [23, 17511], [26, 17731], [30, 17971], [35, 18151], [41, 18551], [44, 18631], [48, 18771], [53, 18951], [59, 19471], [64, 19591], [67, 19771], [73, 20324], [82, 20641], [87, 20761], [90, 21001], [96, 21341], [99, 21461], [110, 22221], [114, 22406], [117, 22546], [124, 22846], [126, 23066], [134, 23456], [143, 23846], [146, 23986]]}, {"verse": 4, "start": 24667, "end": 34114, "text": "Porque es ministro de Dios para tu bien. Pero si haces lo malo, teme: porque no en vano lleva la espada; porque es ministro de Dios, vengador para castigo al que hace lo malo.", "words": [[0, 24667], [7, 24862], [10, 25002], [19, 25502], [22, 25602], [27, 25802], [32, 26062], [35, 26222], [41, 26840], [46, 26966], [49, 27166], [55, 27446], [58, 27606], [64, 28046], [70, 28666], [77, 28867], [80, 29087], [83, 29227], [88, 29467], [94, 29647], [97, 29807], [105, 30562], [112, 30766], [115, 30886], [124, 31346], [127, 31446], [133, 32046], [142, 32426], [147, 32626], [155, 33126], [158, 33246], [162, 33366], [167, 33546], [170, 33706]]}, {"verse": 5, "start": 34464, "end": 39982, "text": "Por lo cual es necesario que le estéis sujetos, no solamente por la ira, sino también por la conciencia.", "words": [[0, 34464], [4, 34584], [7, 34664], [12, 34824], [15, 34964], [25, 35444], [29, 35604], [32, 35704], [39, 36004], [48, 36904], [51, 37024], [61, 37304], [65, 37664], [68, 37804], [73, 38324], [78, 38544], [86, 38904], [90, 39104], [93, 39224]]}, {"verse": 6, "start": 40332, "end": 45536, "text": "Porque por esto pagáis también los tributos; porque son ministros de Dios que sirven a esto mismo.", "words": [[0, 40332], [7, 40532], [11, 40732], [16, 40912], [23, 41332], [31, 41632], [35, 41832], [45, 42802], [52, 42999], [56, 43259], [66, 43799], [69, 43919], [74, 44119], [78, 44319], [85, 44739], [87, 44819], [92, 44999]]}, {"verse": 7, "start": 45886, "end": 54134, "text": "Pagad a todos lo que debéis: al que tributo, tributo; al que impuesto, impuesto; al que temor, temor; al que honra, honra.", "words": [[0, 46058], [6, 46268], [8, 46368], [14, 46528], [17, 46788], [21, 46868], [29, 47629], [32, 47794], [36, 47914], [45, 48614], [54, 49484], [57, 49629], [61, 49749], [71, 50469], [81, 51469], [84, 51612], [88, 51969], [95, 52325], [102, 52902], [105, 53046], [109, 53166], [116, 53666]]}, {"verse": 8, "start": 54484, "end": 61333, "text": "No debáis a nadie nada, sino amaros unos a otros; porque el que ama al prójimo, cumplió la ley.", "words": [[0, 54484], [3, 54670], [10, 55090], [12, 55230], [18, 55490], [24, 56250], [29, 56390], [36, 56970], [41, 57270], [43, 57630], [50, 58379], [57, 58638], [60, 58878], [64, 59038], [68, 59258], [71, 59458], [80, 60038], [88, 60838], [91, 60958]]}, {"verse": 9, "start": 61683, "end": 74952, "text": "Porque: No adulterarás; no matarás; no hurtarás; no dirás falso testimonio; no codiciarás; y si hay algún otro mandamiento, en esta frase se resume: Amarás a tu prójimo como a ti mismo.", "words": [[0, 61683], [8, 62390], [11, 62582], [24, 63745], [27, 63909], [36, 64849], [39, 65330], [49, 66010], [52, 66130], [58, 66470], [64, 66830], [76, 67828], [79, 67975], [91, 69108], [93, 69220], [96, 69340], [100, 69480], [106, 69780], [111, 70000], [124, 70720], [127, 71040], [132, 71280], [138, 71680], [141, 71900], [149, 72744], [156, 73143], [158, 73223], [161, 73363], [169, 73883], [174, 74165], [176, 74448], [179, 74730]]}, {"verse": 10, "start": 75302, "end": 79784, "text": "El amor no hace mal al prójimo: así que, el cumplimiento de la ley es el amor.", "words": [[0, 75302], [3, 75425], [8, 75685], [11, 75965], [16, 76185], [20, 76505], [23, 76665], [32, 77539], [36, 77716], [41, 77896], [44, 77976], [57, 78596], [60, 78756], [63, 78876], [67, 79096], [70, 79256], [73, 79416]]}, {"verse": 11, "start": 80134, "end": 87674, "text": "Y esto, conociendo el tiempo, que es ya hora de levantarnos del sueño; porque ahora nos está más cerca nuestra salvación que cuando creímos.", "words": [[0, 80134], [2, 80275], [8, 80515], [19, 81155], [22, 81315], [30, 81695], [34, 81920], [37, 82120], [40, 82240], [45, 82420], [48, 82560], [60, 83140], [64, 83320], [71, 84068], [78, 84259], [84, 84519], [88, 84699], [93, 85039], [97, 85239], [103, 85599], [111, 85839], [121, 86559], [125, 86719], [132, 86959]]}, {"verse": 12, "start": 88024, "end": 94994, "text": "La noche ha pasado, y ha llegado el día: desechemos, pues, las obras de las tinieblas, y vistámonos las armas de luz.", "words": [[0, 88024], [3, 88143], [9, 88403], [12, 88643], [20, 89083], [22, 89383], [25, 89423], [33, 89843], [36, 89983], [41, 90584], [53, 91151], [59, 91471], [63, 91751], [