{"book": "ACT", "chapter": 28, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 294439, "verses": [{"verse": 1, "start": 300, "end": 5004, "text": "Y cuando escapamos, entonces supimos que la isla se llamaba Malta.", "words": [[0, 300], [2, 401], [9, 581], [20, 1221], [29, 1801], [37, 2556], [41, 2756], [44, 2916], [49, 3336], [52, 3736], [60, 4196]]}, {"verse": 2, "start": 5354, "end": 17119, "text": "Y los habitantes de la isla nos mostraron no poca humanidad; porque, encendido un fuego, nos recibieron a todos, a causa de la lluvia que venía, y del frío.", "words": [[0, 5354], [2, 5460], [6, 5580], [17, 6280], [20, 6440], [23, 6580], [28, 7000], [32, 7420], [42, 8180], [45, 8560], [50, 9020], [61, 10130], [69, 10375], [79, 11355], [82, 11555], [89, 12035], [93, 12340], [104, 13080], [106, 13220], [113, 13640], [115, 14200], [121, 14520], [124, 14740], [127, 14860], [134, 15240], [138, 15360], [145, 15880], [147, 16340], [151, 16500]]}, {"verse": 3, "start": 17469, "end": 27885, "text": "Entonces habiendo Pablo recogido algunas ramas, y habiéndolas puesto en el fuego, una víbora, huyendo del calor, le acometió a la mano.", "words": [[0, 17469], [9, 18071], [18, 18431], [24, 18851], [33, 19631], [41, 19931], [48, 20991], [50, 21351], [62, 21831], [69, 22331], [72, 22651], [75, 22771], [82, 23591], [86, 23751], [94, 24611], [102, 25051], [106, 25291], [113, 26111], [116, 26251], [125, 27011], [127, 27211], [130, 27291]]}, {"verse": 4, "start": 28235, "end": 41858, "text": "Y como los habitantes de la isla vieron la víbora colgando de su mano, decían los unos a los otros: Ciertamente este hombre es homicida, a quien, escapado del mar, la justicia no deja vivir.", "words": [[0, 28235], [2, 28359], [7, 28599], [11, 28759], [22, 29399], [25, 29559], [28, 29699], [33, 30059], [40, 30379], [43, 30579], [50, 31119], [59, 31659], [62, 31879], [65, 32059], [71, 32714], [78, 33314], [82, 33534], [87, 33874], [89, 34234], [93, 34434], [100, 35333], [112, 36067], [117, 36447], [124, 36827], [127, 37187], [137, 38187], [139, 38267], [146, 38807], [155, 39327], [159, 39527], [164, 40187], [167, 40267], [176, 40827], [179, 41047], [184, 41307]]}, {"verse": 5, "start": 42138, "end": 46377, "text": "Pero él, sacudiendo la víbora en el fuego, ningún mal padeció.", "words": [[0, 42138], [5, 42305], [9, 42925], [20, 43565], [23, 43745], [30, 44165], [33, 44305], [36, 44445], [43, 45005], [50, 45305], [54, 45665]]}, {"verse": 6, "start": 46727, "end": 59359, "text": "Pero ellos estaban esperando cuándo se había de hinchar, o caer muerto de repente; pero habiendo esperado mucho, y viendo que ningún mal le venía, cambiando de parecer, decían que era un dios.", "words": [[0, 46727], [5, 46874], [11, 47274], [19, 47994], [29, 48454], [36, 48794], [39, 49034], [45, 49234], [48, 49394], [57, 49914], [59, 50394], [64, 50734], [71, 51214], [74, 51374], [83, 52331], [88, 52473], [97, 52853], [106, 53293], [113, 53593], [115, 53733], [122, 53973], [126, 54133], [133, 54473], [137, 54913], [140, 55113], [147, 56093], [157, 56693], [160, 56853], [169, 57753], [176, 58313], [180, 58513], [184, 58653], [187, 58813]]}, {"verse": 7, "start": 59709, "end": 69340, "text": "En aquellos lugares había propiedades del principal de la isla, llamado Publio, el cual nos recibió y hospedó tres días con amabilidad.", "words": [[0, 59709], [3, 59833], [12, 60073], [20, 60613], [26, 60953], [38, 61693], [42, 61913], [52, 62433], [55, 62733], [58, 62873], [64, 63533], [72, 63933], [80, 65073], [83, 65173], [88, 65393], [92, 65633], [100, 66356], [102, 66478], [110, 66938], [115, 67258], [120, 67698], [124, 68058]]}, {"verse": 8, "start": 69690, "end": 81870, "text": "Y aconteció que el padre de Publio estaba en cama, enfermo de fiebres y de disentería: al cual Pablo entró, y después de haber orado, le puso las manos encima, y le sanó:", "words": [[0, 69690], [2, 69794], [12, 70494], [16, 70674], [19, 70814], [25, 71114], [28, 71394], [35, 71674], [42, 71934], [45, 72154], [51, 73014], [59, 73554], [62, 73674], [70, 74154], [72, 74334], [75, 74454], [87, 75659], [90, 75947], [95, 76107], [101, 76587], [108, 77287], [110, 77567], [118, 77867], [121, 78067], [127, 78247], [134, 78727], [137, 79147], [142, 79467], [146, 79627], [152, 79907], [160, 80567], [162, 81010], [165, 81453]]}, {"verse": 9, "start": 82220, "end": 88540, "text": "Y esto hecho, también los otros que en la isla tenían enfermedades, llegaban, y eran sanados:", "words": [[0, 82220], [2, 82356], [7, 82636], [14, 83056], [22, 83376], [26, 83636], [32, 83956], [36, 84196], [39, 84336], [42, 84476], [47, 84796], [54, 85136], [68, 86136], [78, 87016], [80, 87556], [85, 87756]]}, {"verse": 10, "start": 88890, "end": 95832, "text": "Los cuales también nos honraron con muchos obsequios; y cuando partimos, nos cargaron de las cosas necesarias.", "words": [[0, 88890], [4, 88995], [11, 89175], [19, 89535], [23, 90075], [32, 90615], [36, 90775], [43, 91135], [54, 92029], [56, 92249], [63, 92449], [73, 93429], [77, 93609], [86, 94169], [89, 94289], [93, 94429], [99, 94729]]}, {"verse": 11, "start": 96182, "end": 106847, "text": "Así que, pasados tres meses, navegamos en una nave alejandrina que había invernado en la isla, la cual tenía como emblema a Cástor y Pólux.", "words": [[0, 96182], [4, 96444], [9, 96724], [17, 97204], [22, 97484], [29, 98404], [39, 98984], [42, 99204], [46, 99384], [51, 99724], [63, 100724], [67, 100924], [73, 101244], [83, 102164], [86, 102284], [89, 102444], [95, 103284], [98, 103424], [103, 103624], [109, 104064], [114, 104344], [122, 105044], [124, 105204], [131, 105864], [133, 106393]]}, {"verse": 12, "start": 107197, "end": 111388, "text": "Y llegados a Siracusa, estuvimos allí tres días.", "words": [[0, 107197], [2, 107501], [11, 108001], [13, 108201], [23, 109441], [33, 110161], [38, 110381], [43, 110681]]}, {"verse": 13, "start": 111738, "end": 121052, "text": "De allí, costeando alrededor, vinimos a Regio; y otro día después, soplando el sur, vinimos al segundo día a Puteoli:", "words": [[0, 111738], [3, 111882], [9, 112342], [19, 112942], [30, 113842], [38, 114152], [40, 114462], [47, 115353], [49, 115497], [54, 115677], [58, 115997], [67, 116857], [76, 117437], [79, 117597], [84, 118257], [92, 118917], [95, 119137], [103, 119477], [107, 119917], [109, 120516]]}, {"verse": 14, "start": 121402, "end": 129072, "text": "Donde habiendo hallado hermanos, nos rogaron que quedásemos con ellos siete días; y luego vinimos a Roma;", "words": [[0, 121402], [6, 121646], [15, 122346], [23, 122806], [33, 123426], [37, 123946], [45, 124746], [49, 124906], [60, 125566], [64, 125786], [70, 125986], [76, 126386], [82, 127414], [84, 127540], [90, 127760], [98, 128340], [100, 128480]]}, {"verse": 15, "start": 129422, "end": 142120, "text": "De donde, oyendo de nosotros los hermanos, nos salieron a recibir hasta la plaza de Apio, y Las Tres Tabernas: a los cuales como Pablo vio, dio gracias a Dios, y tomó aliento.", "words": [[0, 129422], [3, 129585], [10, 130285], [17, 130905], [20, 131085], [29, 131565], [33, 131825], [43, 132705], [47, 132785], [56, 133285], [58, 133425], [66, 133845], [72, 134125], [75, 134245], [81, 134545], [84, 134705], [90, 135045], [92, 135405], [96, 135545], [101, 135745], [111, 136853], [113, 136946], [117, 137066], [124, 137566], [129, 137686], [135, 138086], [140, 139126], [144, 139406], [152, 139846], [154, 140186], [160, 140446], [162, 140966], [167, 141346]]}, {"verse": 16, "start": 142470, "end": 153900, "text": "Y como llegamos a Roma, el centurión entregó los presos al prefecto de los ejércitos, pero a Pablo fue permitido estar por sí, con un soldado que le guardase.", "words": [[0, 142470], [2, 142596], [7, 142816], [16, 143336], [18, 143516], [24, 144341], [27, 144481], [37, 145181], [45, 145861], [49, 146001], [56, 146601], [59, 146841], [68, 147561], [71, 147661], [75, 147801], [86, 148841], [91, 149081], [93, 149241], [99, 149621], [103, 150181], [113, 150821], [119, 151041], [123, 151401], [127, 151721], [131, 152241], [134, 152381], [142, 152901], [146, 153021], [149, 153141]]}, {"verse": 17, "start": 154250, "end": 172766, "text": "Y aconteció que tres días después, Pablo convocó a los principales de los judíos; a los cuales, luego que estuvieron juntos, les dijo: Yo, varones hermanos, no habiendo hecho nada contra el pueblo, ni contra los ritos de la patria, he sido entregado preso desde Jerusalén en manos de los Romanos;", "words": [[0, 154250], [2, 154354], [12, 155074], [16, 155234], [21, 155494], [26, 155814], [35, 156254], [41, 157154], [49, 157914], [51, 158034], [55, 158134], [67, 158834], [70, 158954], [74, 159074], [82, 160001], [84, 160241], [88, 160341], [96, 160701], [102, 161146], [106, 161446], [117, 161926], [125, 162546], [129, 162726], [135, 163412], [139, 163595], [147, 164015], [157, 164855], [160, 164955], [169, 165315], [175, 165575], [180, 165855], [187, 166215], [190, 166375], [198, 167075], [201, 167235], [208, 167555], [212, 167735], [218, 168135], [221, 168235], [224, 168335], [232, 169155], [235, 169235], [240, 169435], [250, 169975], [256, 170435], [262, 170575], [272, 171355], [275, 171535], [281, 171755], [284, 171955], [288, 172035]]}, {"verse": 18, "start": 173116, "end": 179213, "text": "Los cuales, habiéndome examinado, me querían soltar, por no haber en mí ninguna causa de muerte.", "words": [[0, 173116], [4, 173220], [12, 173820], [23, 174340], [34, 175400], [37, 175480], [45, 175950], [53, 176420], [57, 176700], [60, 176880], [66, 177140], [69, 177320], [72, 177500], [80, 178020], [86, 178480], [89, 178700]]}, {"verse": 19, "start": 179563, "end": 185213, "text": "Pero contradiciendo los judíos, fui forzado a apelar a César; no que tenga de qué acusar a mi nación.", "words": [[0, 179563], [5, 179704], [20, 180444], [24, 180624], [32, 181344], [36, 181544], [44, 182084], [46, 182204], [53, 182524], [55, 182604], [62, 183251], [65, 183389], [69, 183529], [75, 183769], [78, 183909], [82, 184069], [89, 184489], [91, 184569], [94, 184629]]}, {"verse": 20, "start": 185563, "end": 192292, "text": "Así que, por esta causa, os he llamado para veros y hablaros; porque por la esperanza de Israel estoy rodeado de esta cadena.", "words": [[0, 185563], [4, 185744], [9, 185884], [13, 186064], [18, 186224], [25, 186644], [28, 186964], [31, 187184], [39, 187444], [44, 187744], [50, 188104], [52, 188224], [62, 189045], [69, 189229], [73, 189429], [76, 189529], [86, 189949], [89, 190069], [96, 190449], [102, 190749], [110, 191289], [113, 191489], [118, 191689]]}, {"verse": 21, "start": 192572, "end": 202784, "text": "Entonces ellos le dijeron: Nosotros ni hemos recibido cartas tocante a ti de Judea, ni ha venido alguno de los hermanos que haya denunciado o hablado algún mal de ti.", "words": [[0, 192572], [9, 193050], [15, 193830], [18, 194290], [27, 195237], [36, 195642], [39, 195842], [45, 196002], [54, 196642], [61, 197062], [69, 197462], [71, 197602], [74, 197682], [77, 197802], [84, 198402], [87, 198802], [90, 198902], [97, 199202], [104, 199582], [107, 199642], [111, 199762], [120, 200282], [124, 200402], [129, 200602], [140, 201322], [142, 201462], [150, 201862], [156, 202122], [160, 202342], [163, 202502]]}, {"verse": 22, "start": 203134, "end": 209073, "text": "Pero querríamos oír de ti lo que piensas; porque sabemos que en todas partes se habla contra esta secta.", "words": [[0, 203134], [5, 203501], [16, 203981], [20, 204341], [23, 204441], [26, 204621], [29, 204741], [33, 204861], [42, 205782], [49, 205992], [57, 206412], [61, 206732], [64, 206852], [70, 207012], [77, 207532], [80, 207772], [86, 207952], [93, 208272], [98, 208532]]}, {"verse": 23, "start": 209353, "end": 227150, "text": "Y habiéndole señalado un día, vinieron a él muchos a la posada, a los cuales declaraba y testificaba el reino de Dios, persuadiéndoles lo concerniente a Jesús, por la ley de Moisés y por los profetas, desde la mañana hasta la tarde.", "words": [[0, 209353], [2, 209472], [13, 209992], [22, 210632], [25, 210792], [30, 211632], [39, 212212], [41, 212372], [44, 212512], [51, 212852], [53, 213112], [56, 213192], [64, 213752], [66, 213972], [70, 214072], [77, 214372], [87, 215572], [89, 215712], [101, 216492], [104, 216652], [110, 217032], [113, 217172], [119, 217852], [135, 218972], [138, 219622], [151, 220272], [153, 220432], [160, 221273], [164, 221417], [167, 221577], [171, 221857], [174, 221997], [181, 222517], [183, 223077], [187, 223277], [191, 223437], [201, 224617], [207, 225177], [210, 225497], [217, 225897], [223, 226317], [226, 226517]]}, {"verse": 24, "start": 227500, "end": 232640, "text": "Y algunos asentían a lo que se decía, pero algunos no creían.", "words": [[0, 227500], [2, 227740], [10, 228060], [19, 228960], [21, 229200], [24, 229300], [28, 229420], [31, 229560], [38, 230520], [43, 230760], [51, 231260], [54, 231900]]}, {"verse": 25, "start": 232990, "end": 243368, "text": "Y como fueron entre sí discordes, se fueron, diciendo Pablo esta palabra: Bien ha hablado el Espíritu Santo por el profeta Isaías a nuestros padres,", "words": [[0, 232990], [2, 233114], [7, 233374], [14, 233774], [20, 234154], [23, 234474], [34, 235474], [37, 235914], [45, 236854], [54, 237314], [60, 237934], [65, 238214], [74, 239118], [79, 239334], [82, 239514], [90, 239894], [93, 240014], [102, 240534], [108, 240814], [112, 241094], [115, 241214], [123, 241654], [130, 242174], [132, 242354], [141, 242474]]}, {"verse": 26, "start": 243718, "end": 252720, "text": "Diciendo: Ve a este pueblo, y diles: De oído oiréis, y no entenderéis; y viendo veréis, y no percibiréis:", "words": [[0, 243718], [10, 244597], [13, 244777], [15, 244957], [20, 245237], [28, 245617], [30, 246117], [37, 247257], [40, 247419], [45, 247979], [53, 248539], [55, 248919], [58, 249099], [71, 250382], [73, 250500], [80, 250840], [88, 251320], [90, 251620], [93, 251780]]}, {"verse": 27, "start": 253221, "end": 266495, "text": "Porque el corazón de este pueblo se ha vuelto insensible, y de los oídos oyeron pesadamente, y sus ojos taparon; porque no vean con los ojos, y oigan con los oídos, y entiendan de corazón, y se conviertan, y yo los sane.", "words": [[0, 253221], [7, 253401], [10, 253521], [18, 253901], [21, 254101], [26, 254241], [33, 254621], [36, 254861], [39, 254941], [46, 255241], [58, 255921], [60, 256156], [63, 256256], [67, 256376], [73, 256836], [80, 257196], [93, 258176], [95, 258436], [99, 258576], [104, 258836], [113, 259752], [120, 259939], [123, 260159], [128, 260419], [132, 260559], [136, 260699], [142, 261059], [144, 261619], [150, 261899], [154, 262119], [158, 262279], [165, 263059], [167, 263219], [177, 263739], [180, 263859], [189, 264299], [191, 264544], [194, 264684], [206, 265424], [208, 265724], [211, 265864], [215, 266004]]}, {"verse": 28, "start": 266845, "end": 272546, "text": "Os sea pues notorio que a los Gentiles es enviada esta salvación de Dios: y ellos oirán.", "words": [[0, 266879], [3, 266949], [7, 267169], [12, 267369], [20, 267909], [24, 268069], [26, 268169], [30, 268249], [39, 268809], [42, 269109], [50, 269649], [55, 269949], [65, 270549], [68, 270689], [74, 271415], [76, 271556], [82, 271776]]}, {"verse": 29, "start": 272826, "end": 278840, "text": "Y habiendo dicho esto, los judíos salieron, teniendo entre sí gran contienda.", "words": [[0, 272826], [2, 272949], [11, 273369], [17, 273689], [23, 274669], [27, 274809], [34, 275389], [44, 276464], [53, 276984], [59, 277264], [62, 277544], [67, 277844]]}, {"verse": 30, "start": 279190, "end": 285301, "text": "Pablo quedó dos años enteros en su casa de alquiler, y recibía a todos los que a él venían,", "words": [[0, 279190], [6, 279602], [12, 280002], [16, 280262], [21, 280522], [29, 281182], [32, 281342], [35, 281482], [40, 281742], [43, 281962], [53, 282442], [55, 282822], [63, 283462], [65, 283662], [71, 283922], [75, 284182], [79, 284382], [81, 284462], [84, 284582]]}, {"verse": 31, "start": 285651, "end": 294039, "text": "Predicando el reino de Dios y enseñando lo que es del Señor Jesucristo con toda libertad, sin impedimento.", "words": [[0, 285651], [11, 286315], [14, 286455], [20, 286835], [23, 286975], [28, 287355], [30, 287875], [40, 288575], [43, 288755], [47, 288935], [50, 289115], [54, 289255], [60, 289555], [71, 290475], [75, 290715], [80, 290975], [90, 292135], [94, 292555]]}]}