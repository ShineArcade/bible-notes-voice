{"book": "LUK", "chapter": 10, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 321016, "verses": [{"verse": 1, "start": 300, "end": 9387, "text": "After these things the Lord appointed other seventy also, and sent them two and two before his face into every city and place, where he himself would come.", "words": [[0, 300], [6, 555], [12, 775], [19, 1175], [23, 1395], [28, 1615], [38, 2115], [44, 2415], [52, 2935], [58, 3935], [62, 4195], [67, 4415], [72, 4635], [76, 4895], [80, 5035], [84, 5255], [91, 5535], [95, 5835], [100, 6155], [105, 6435], [111, 6835], [116, 7155], [120, 7375], [127, 7715], [133, 8075], [136, 8255], [144, 8655], [150, 8895]]}, {"verse": 2, "start": 9837, "end": 18892, "text": "Therefore said he to them, The harvest truly is great, but the labourers are few: pray therefore the Lord of the harvest, that he would send forth labourers into his harvest.", "words": [[0, 9837], [10, 10161], [15, 10501], [18, 10721], [21, 10921], [27, 11666], [31, 11756], [39, 12016], [45, 12396], [48, 12616], [55, 13076], [59, 13356], [63, 13646], [73, 13936], [77, 14036], [82, 14737], [87, 14917], [97, 15257], [101, 15497], [106, 15697], [109, 15817], [113, 15917], [122, 16237], [127, 16677], [130, 16797], [136, 16937], [141, 17177], [147, 17567], [157, 17957], [162, 18177], [166, 18377]]}, {"verse": 3, "start": 19342, "end": 23322, "text": "Go your ways: behold, I send you forth as lambs among wolves.", "words": [[0, 19342], [3, 19466], [8, 19606], [14, 20388], [22, 20926], [24, 21026], [29, 21326], [33, 21446], [39, 21746], [42, 22026], [48, 22466], [54, 22606]]}, {"verse": 4, "start": 23772, "end": 28277, "text": "Carry neither purse, nor bag, nor shoes: and salute no man by the way.", "words": [[0, 23772], [6, 23996], [14, 24236], [21, 24716], [25, 25036], [30, 25376], [34, 25736], [41, 26707], [45, 26832], [52, 27072], [55, 27352], [59, 27592], [62, 27812], [66, 27912]]}, {"verse": 5, "start": 28727, "end": 32825, "text": "And into whatever house you enter, first say, Peace be to this house.", "words": [[0, 28727], [4, 28865], [9, 29085], [18, 29405], [24, 29765], [28, 30005], [35, 30325], [41, 30685], [46, 31345], [52, 31665], [55, 31925], [58, 32105], [63, 32305]]}, {"verse": 6, "start": 33275, "end": 38970, "text": "And if the son of peace be there, your peace shall rest upon it: if not, it shall turn to you again.", "words": [[0, 33275], [4, 33379], [7, 33479], [11, 33599], [15, 33819], [18, 33919], [24, 34159], [27, 34419], [34, 34939], [39, 35159], [45, 35439], [51, 35699], [56, 35919], [61, 36199], [65, 36831], [68, 37000], [73, 37600], [76, 37740], [82, 37920], [87, 38160], [90, 38320], [94, 38480]]}, {"verse": 7, "start": 39420, "end": 47233, "text": "And in the same house remain, eating and drinking such things as they give: for the labourer is worthy of his hire. Go not from house to house.", "words": [[0, 39420], [4, 39584], [7, 39704], [11, 39844], [16, 40044], [22, 40344], [30, 40684], [37, 41344], [41, 41624], [50, 41924], [55, 42204], [62, 42484], [65, 42684], [70, 42824], [76, 43574], [80, 43657], [84, 43987], [93, 44317], [96, 44457], [103, 44757], [106, 44937], [110, 45037], [116, 45793], [119, 45913], [123, 46113], [128, 46333], [134, 46573], [137, 46753]]}, {"verse": 8, "start": 47683, "end": 52442, "text": "And into whatever city you enter, and they receive you, eat such things as are set before you:", "words": [[0, 47683], [4, 47800], [9, 47980], [18, 48240], [23, 48580], [27, 48760], [34, 49300], [38, 49400], [43, 49520], [51, 49880], [56, 50460], [60, 50600], [65, 50840], [72, 51160], [75, 51400], [79, 51540], [83, 51740], [90, 52040]]}, {"verse": 9, "start": 52892, "end": 58191, "text": "And heal the sick that are in it, and say to them, The kingdom of God is come near to you.", "words": [[0, 52892], [4, 53030], [9, 53310], [13, 53530], [18, 53810], [23, 54030], [27, 54170], [30, 54370], [34, 54850], [38, 55110], [42, 55370], [45, 55550], [51, 56090], [55, 56210], [63, 56510], [66, 56730], [70, 56990], [73, 57250], [78, 57450], [83, 57670], [86, 57870]]}, {"verse": 10, "start": 58641, "end": 65163, "text": "But into whatever city you enter, and they receive you not, go your ways out into the streets of the same, and say,", "words": [[0, 58641], [4, 58745], [9, 58945], [18, 59285], [23, 59625], [27, 59845], [34, 60145], [38, 60585], [43, 60705], [51, 61085], [55, 61265], [60, 61505], [63, 62145], [68, 62325], [73, 62565], [77, 62885], [82, 63125], [86, 63305], [94, 63585], [97, 63805], [101, 63905], [107, 64205], [111, 64625]]}, {"verse": 11, "start": 65613, "end": 75016, "text": "Even the very dust of your city, which clings on us, we do wipe off against you: notwithstanding be sure of this, that the kingdom of God is come near to you.", "words": [[0, 65613], [5, 65835], [9, 66035], [14, 66295], [19, 66595], [22, 66815], [27, 66955], [33, 67555], [39, 67755], [46, 68195], [49, 68395], [53, 69035], [56, 69135], [59, 69335], [64, 69655], [68, 69915], [76, 70255], [81, 71010], [97, 71754], [100, 72014], [105, 72314], [108, 72474], [114, 72874], [119, 72974], [123, 73074], [131, 73354], [134, 73574], [138, 73814], [141, 74054], [146, 74254], [151, 74494], [154, 74694]]}, {"verse": 12, "start": 75466, "end": 80988, "text": "But I say to you, that it shall be more tolerable in that day for Sodom, than for that city.", "words": [[0, 75466], [4, 75605], [6, 75745], [10, 76005], [13, 76205], [18, 76865], [23, 77045], [26, 77165], [32, 77325], [35, 77485], [40, 77705], [50, 78345], [53, 78545], [58, 78705], [62, 78965], [66, 79145], [73, 79725], [78, 80125], [82, 80305], [87, 80505]]}, {"verse": 13, "start": 81438, "end": 94331, "text": "Woe to you, Chorazin! woe to you, Bethsaida! for if the mighty works had been done in Tyre and Sidon, which have been done in you, they had a great while ago repented, sitting in sackcloth and ashes.", "words": [[0, 81438], [4, 81783], [7, 81863], [12, 82913], [22, 84499], [26, 84761], [29, 85023], [34, 85285], [45, 85845], [49, 85969], [52, 86109], [56, 86229], [63, 86469], [69, 86829], [73, 87049], [78, 87229], [83, 87429], [86, 87649], [91, 88089], [95, 88229], [102, 88989], [108, 89149], [113, 89329], [118, 89509], [123, 89729], [126, 89889], [131, 90549], [136, 90629], [140, 90769], [142, 90869], [148, 91089], [154, 91369], [158, 91629], [168, 92489], [176, 92769], [179, 92989], [189, 93609], [193, 93769]]}, {"verse": 14, "start": 94781, "end": 98984, "text": "But it shall be more tolerable for Tyre and Sidon at the judgment, than for you.", "words": [[0, 94781], [4, 94899], [7, 95019], [13, 95219], [16, 95399], [21, 95579], [31, 96139], [35, 96409], [40, 96679], [44, 97019], [50, 97359], [53, 97479], [57, 97559], [67, 97919], [72, 98399], [76, 98599]]}, {"verse": 15, "start": 99434, "end": 103485, "text": "And you, Capernaum, which are exalted to heaven, shall be thrust down to hell.", "words": [[0, 99434], [4, 99577], [9, 99917], [20, 100736], [26, 100876], [30, 101017], [38, 101437], [41, 101616], [49, 102116], [55, 102316], [58, 102437], [65, 102657], [70, 102977], [73, 103137]]}, {"verse": 16, "start": 103935, "end": 112178, "text": "He that hears you hears me; and he that despises you despises me; and he that despises me despises him that sent me.", "words": [[0, 103935], [3, 104130], [8, 104410], [14, 104710], [18, 105030], [24, 105350], [28, 106263], [32, 106382], [35, 106562], [40, 106742], [49, 107382], [53, 107662], [62, 108342], [66, 108991], [70, 109116], [73, 109296], [78, 109476], [87, 110036], [90, 110296], [99, 110996], [103, 111276], [108, 111536], [113, 111796]]}, {"verse": 17, "start": 112528, "end": 118150, "text": "¶ And the seventy returned again with joy, saying, Lord, even the demons are subject to us through your name.", "words": [[2, 112528], [6, 112666], [10, 112786], [18, 113126], [27, 113626], [33, 113926], [38, 114186], [43, 114706], [51, 115471], [57, 115941], [62, 116041], [66, 116221], [73, 116441], [77, 116621], [85, 116881], [88, 117121], [91, 117301], [99, 117541], [104, 117741]]}, {"verse": 18, "start": 118500, "end": 122467, "text": "And he said to them, I beheld Satan as lightning fall from heaven.", "words": [[0, 118500], [4, 118631], [7, 118751], [12, 118991], [15, 119191], [21, 119786], [23, 120006], [30, 120466], [36, 120826], [39, 121106], [49, 121406], [54, 121786], [59, 122006]]}, {"verse": 19, "start": 122917, "end": 130715, "text": "Behold, I give to you power to tread on serpents and scorpions, and over all the power of the enemy: and nothing shall by any means hurt you.", "words": [[0, 122917], [8, 123354], [10, 123414], [15, 123674], [18, 123854], [22, 123974], [28, 124294], [31, 124454], [37, 124754], [40, 124914], [49, 125414], [53, 125534], [64, 126154], [68, 126554], [73, 126754], [77, 127054], [81, 127194], [87, 127474], [90, 127634], [94, 127754], [101, 128454], [105, 128596], [113, 128856], [119, 129216], [122, 129416], [126, 129676], [132, 130036], [137, 130256]]}, {"verse": 20, "start": 131165, "end": 138872, "text": "Notwithstanding in this rejoice not, that the spirits are subject to you; but rather rejoice, because your names are written in heaven.", "words": [[0, 131498], [16, 131868], [19, 132108], [24, 132228], [32, 132848], [37, 133108], [42, 133728], [46, 133868], [54, 134228], [58, 134428], [66, 134768], [69, 135068], [74, 135688], [78, 135786], [85, 136046], [94, 136546], [102, 137246], [107, 137426], [113, 137786], [117, 137966], [125, 138186], [128, 138386]]}, {"verse": 21, "start": 139222, "end": 154146, "text": "¶ In that hour Jesus rejoiced in spirit, and said, I thank you, O Father, Lord of heaven and earth, that you have hid these things from the wise and prudent, and have revealed them to babes: even so, Father; for so it seemed good in your sight.", "words": [[2, 139222], [5, 139376], [10, 139556], [15, 140156], [21, 140456], [30, 141116], [33, 141255], [41, 141695], [45, 141975], [51, 142754], [53, 142878], [59, 143178], [64, 143438], [66, 143538], [74, 144378], [79, 144638], [82, 144798], [89, 145078], [93, 145258], [100, 145918], [105, 146058], [109, 146238], [114, 146358], [118, 146558], [124, 146778], [131, 147198], [136, 147438], [140, 147598], [145, 147938], [149, 148138], [158, 148918], [162, 148978], [167, 149098], [176, 149438], [181, 149718], [184, 149878], [191, 150764], [196, 151003], [200, 151523], [208, 152270], [212, 152400], [215, 152640], [218, 152800], [225, 153020], [230, 153320], [233, 153500], [238, 153620]]}, {"verse": 22, "start": 154596, "end": 165567, "text": "All things are delivered to me of my Father: and no man knows who the Son is, but the Father; and who the Father is, but the Son, and he to whom the Son will reveal him.", "words": [[0, 154596], [4, 154759], [11, 155038], [15, 155239], [25, 155579], [28, 155799], [31, 155919], [34, 156079], [37, 156239], [45, 157122], [49, 157245], [52, 157445], [56, 157685], [62, 158025], [66, 158285], [70, 158425], [74, 158705], [78, 159245], [82, 159365], [86, 159525], [94, 160370], [98, 160512], [102, 160652], [106, 160772], [113, 161072], [117, 161812], [121, 162152], [125, 162332], [130, 163072], [134, 163312], [137, 163612], [140, 163872], [145, 164052], [149, 164232], [153, 164512], [158, 164692], [165, 165052]]}, {"verse": 23, "start": 165917, "end": 172452, "text": "¶ And he turned him to his disciples, and said privately, Blessed are the eyes which see the things that you see:", "words": [[2, 165917], [6, 166047], [9, 166147], [16, 166387], [20, 166627], [23, 166827], [27, 166967], [38, 167507], [42, 168207], [47, 168427], [58, 169486], [66, 169756], [70, 170016], [74, 170156], [79, 170516], [85, 170816], [89, 171076], [93, 171236], [100, 171616], [105, 171856], [109, 171996]]}, {"verse": 24, "start": 172902, "end": 182618, "text": "For I tell you, that many prophets and kings have desired to see those things which you see, and have not seen them; and to hear those things which you hear, and have not heard them.", "words": [[0, 172902], [4, 173015], [6, 173155], [11, 173395], [16, 173635], [21, 173875], [26, 174095], [35, 174555], [39, 174795], [45, 175155], [50, 175355], [58, 175755], [61, 175995], [65, 176175], [71, 176395], [78, 176735], [84, 176975], [88, 177175], [93, 177495], [97, 177875], [102, 178015], [106, 178195], [111, 178535], [117, 179265], [121, 179389], [124, 179529], [129, 179749], [135, 179989], [142, 180329], [148, 180589], [152, 180769], [158, 181109], [162, 181589], [167, 181769], [171, 181969], [177, 182249]]}, {"verse": 25, "start": 182968, "end": 190704, "text": "¶ And, behold, a certain lawyer stood up, and tempted him, saying, Master, what shall I do to inherit eternal life?", "words": [[2, 182968], [7, 183116], [15, 184096], [17, 184356], [25, 184616], [32, 185016], [38, 185376], [42, 185636], [46, 185896], [54, 186216], [59, 186736], [67, 188037], [75, 188844], [80, 188984], [86, 189164], [88, 189264], [91, 189444], [94, 189584], [102, 189884], [110, 190264]]}, {"verse": 26, "start": 191054, "end": 194881, "text": "He said to him, What is written in the law? how do you read?", "words": [[0, 191054], [3, 191137], [8, 191337], [11, 191597], [16, 192178], [21, 192341], [24, 192521], [32, 192821], [35, 193061], [39, 193161], [44, 193940], [48, 194101], [51, 194261], [55, 194361]]}, {"verse": 27, "start": 195231, "end": 206393, "text": "And he answering said, You shall love the Lord your God with all your heart, and with all your soul, and with all your strength, and with all your mind; and your neighbour as yourself.", "words": [[0, 195231], [4, 195357], [7, 195477], [17, 196157], [23, 196824], [27, 196968], [33, 197168], [38, 197528], [42, 197688], [47, 197888], [52, 198108], [56, 198428], [61, 198628], [65, 198888], [70, 199068], [77, 199408], [81, 199868], [86, 200008], [90, 200228], [95, 200408], [101, 200748], [105, 201168], [110, 201328], [114, 201588], [119, 201748], [129, 202108], [133, 202588], [138, 202728], [142, 203008], [147, 203188], [153, 203943], [157, 204243], [162, 204483], [172, 204723], [175, 205023]]}, {"verse": 28, "start": 206743, "end": 211472, "text": "And he said to him, You have answered right: this do, and you shall live.", "words": [[0, 206743], [4, 206869], [7, 206969], [12, 207189], [15, 207389], [20, 208041], [24, 208172], [29, 208332], [38, 208692], [45, 209598], [50, 209762], [54, 210402], [58, 210522], [62, 210682], [68, 210902]]}, {"verse": 29, "start": 211822, "end": 216337, "text": "But he, willing to justify himself, said to Jesus, And who is my neighbour?", "words": [[0, 211822], [4, 211933], [8, 212073], [16, 212353], [19, 212573], [27, 213133], [36, 213753], [41, 214133], [44, 214333], [51, 215224], [55, 215364], [59, 215564], [62, 215724], [65, 216059]]}, {"verse": 30, "start": 216687, "end": 228273, "text": "And Jesus answering said, A certain man went down from Jerusalem to Jericho, and fell among thieves, which stripped him of his clothing, and wounded him, and departed, leaving him half dead.", "words": [[0, 216687], [4, 216832], [10, 217212], [20, 217752], [26, 218544], [28, 218664], [36, 218944], [40, 219304], [45, 219524], [50, 219844], [55, 220064], [65, 220644], [68, 220864], [77, 221984], [81, 222064], [86, 222364], [92, 222644], [101, 223124], [107, 223504], [116, 223804], [120, 224044], [123, 224184], [127, 224324], [137, 225124], [141, 225204], [149, 225504], [154, 226084], [158, 226124], [168, 227064], [176, 227264], [180, 227504], [185, 227764]]}, {"verse": 31, "start": 228623, "end": 234898, "text": "And by chance there came down a certain priest that way: and when he saw him, he passed by on the other side.", "words": [[0, 228623], [4, 228775], [7, 228955], [14, 229535], [20, 229615], [25, 229855], [30, 230175], [32, 230355], [40, 230535], [47, 230915], [52, 231255], [57, 231945], [61, 232054], [66, 232194], [69, 232334], [73, 232594], [78, 233094], [81, 233174], [88, 233494], [91, 233814], [94, 233994], [98, 234114], [104, 234254]]}, {"verse": 32, "start": 235198, "end": 241535, "text": "And likewise a Levite, when he was at the place, came and looked on him, and passed by on the other side.", "words": [[0, 235198], [4, 235343], [13, 236143], [15, 236603], [23, 237063], [28, 237203], [31, 237343], [35, 237523], [38, 237683], [42, 237803], [49, 238423], [54, 238663], [58, 238963], [65, 239163], [68, 239403], [73, 239843], [77, 239963], [84, 240243], [87, 240523], [90, 240703], [94, 240823], [100, 240963]]}, {"verse": 33, "start": 241985, "end": 248400, "text": "But a certain Samaritan, as he journeyed, came where he was: and when he saw him, he had compassion on him,", "words": [[0, 241985], [4, 242105], [6, 242245], [14, 242485], [25, 243225], [28, 243505], [31, 243625], [42, 244285], [47, 244465], [53, 244685], [56, 244805], [61, 245535], [65, 245701], [70, 245881], [73, 246061], [77, 246341], [82, 246981], [85, 247101], [89, 247301], [100, 247781], [103, 248101]]}, {"verse": 34, "start": 248850, "end": 257713, "text": "And went to him, and bound up his wounds, pouring in oil and wine, and set him on his own beast, and brought him to an inn, and took care of him.", "words": [[0, 248850], [4, 248994], [9, 249174], [12, 249354], [17, 249534], [21, 250094], [27, 250394], [30, 250574], [34, 250714], [42, 251634], [50, 251854], [53, 252034], [57, 252354], [61, 252594], [67, 252974], [71, 253454], [75, 253714], [79, 253874], [82, 254014], [86, 254174], [90, 254334], [97, 254714], [101, 255174], [109, 255394], [113, 255594], [116, 255714], [119, 255994], [124, 256574], [128, 256814], [133, 256974], [138, 257254], [141, 257434]]}, {"verse": 35, "start": 258163, "end": 269635, "text": "And on the next day when he departed, he took out two denarii, and gave them to the host, and said to him, Take care of him; and whatever you spend more, when I come again, I will repay you.", "words": [[0, 258163], [4, 258307], [7, 258407], [11, 258527], [16, 258767], [20, 259047], [25, 259227], [28, 259347], [38, 260047], [41, 260287], [46, 260447], [50, 260647], [54, 260887], [63, 261647], [67, 261967], [72, 262187], [77, 262427], [80, 262587], [84, 262727], [90, 263047], [94, 263527], [99, 263767], [102, 263947], [107, 264487], [112, 264707], [117, 264987], [120, 265167], [125, 265778], [129, 265922], [138, 266182], [142, 266422], [148, 266622], [154, 267362], [159, 267482], [161, 267602], [166, 267802], [173, 268562], [175, 268662], [180, 268822], [186, 269142]]}, {"verse": 36, "start": 270085, "end": 274991, "text": "Which now of these three, do you think, was neighbour to him that fell among the thieves?", "words": [[0, 270085], [6, 270221], [10, 270461], [13, 270661], [19, 270841], [26, 271321], [29, 271381], [33, 271501], [40, 272021], [44, 272301], [54, 272581], [57, 272861], [61, 273061], [66, 273261], [71, 273501], [77, 273741], [81, 273941]]}, {"verse": 37, "start": 275341, "end": 283309, "text": "And he said, He that showed mercy on him. Then said Jesus to him, Go, and do you likewise.", "words": [[0, 275341], [4, 275476], [7, 275616], [13, 277075], [16, 277199], [21, 277399], [28, 277639], [34, 278079], [37, 278299], [42, 278957], [47, 279159], [52, 279399], [58, 279739], [61, 280079], [66, 281133], [70, 281350], [74, 281750], [77, 281990], [81, 282550]]}, {"verse": 38, "start": 283659, "end": 291252, "text": "¶ Now it came to pass, as they went, that he entered into a certain village: and a certain woman named Martha received him into her house.", "words": [[2, 283659], [6, 283888], [9, 284048], [14, 284228], [17, 284388], [23, 284708], [26, 284928], [31, 285088], [37, 285388], [42, 285928], [45, 286068], [53, 286368], [58, 286628], [60, 286788], [68, 287028], [77, 288043], [81, 288166], [83, 288266], [91, 288506], [97, 288866], [103, 289166], [110, 289646], [119, 290086], [123, 290326], [128, 290526], [132, 290706]]}, {"verse": 39, "start": 291702, "end": 296885, "text": "And she had a sister called Mary, which also sat at Jesus’ feet, and heard his word.", "words": [[0, 291702], [4, 291841], [8, 291981], [12, 292161], [14, 292261], [21, 292561], [28, 292901], [34, 293841], [40, 294061], [45, 294441], [49, 294781], [52, 294901], [59, 295481], [65, 295681], [69, 295941], [75, 296181], [79, 296361]]}, {"verse": 40, "start": 297335, "end": 308138, "text": "But Martha was distracted about much serving, and came to him, and said, Lord, do you not care that my sister has left me to serve alone? bid her therefore that she help me.", "words": [[0, 297335], [4, 297708], [11, 298028], [15, 298328], [26, 298768], [32, 299208], [37, 299568], [46, 300008], [50, 300288], [55, 300568], [58, 300788], [63, 300968], [67, 301208], [73, 301882], [79, 302428], [82, 302468], [86, 302608], [90, 302808], [95, 303248], [100, 303608], [103, 303788], [110, 304088], [114, 304328], [119, 304528], [122, 304748], [125, 304908], [131, 305168], [138, 306104], [142, 306349], [146, 306569], [156, 307049], [161, 307309], [165, 307529], [170, 307749]]}, {"verse": 41, "start": 308488, "end": 314533, "text": "And Jesus answered and said to her, Martha, Martha, you are worried and troubled about many things:", "words": [[0, 308488], [4, 308636], [10, 308956], [19, 309536], [23, 309796], [28, 310016], [31, 310196], [36, 310781], [44, 311165], [52, 312185], [56, 312325], [60, 312465], [68, 312865], [72, 313045], [81, 313345], [87, 313605], [92, 313925]]}, {"verse": 42, "start": 314983, "end": 320616, "text": "But one thing is needful: and Mary has chosen that good part, which shall not be taken away from her.", "words": [[0, 314983], [4, 315257], [8, 315497], [14, 315777], [17, 316077], [26, 316983], [30, 317125], [35, 317365], [39, 317585], [46, 317985], [51, 318165], [56, 318365], [62, 318645], [68, 319045], [74, 319245], [78, 319445], [81, 319585], [87, 319845], [92, 320105], [97, 320325]]}]}