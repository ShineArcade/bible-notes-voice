{"book": "MRK", "chapter": 16, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 166839, "verses": [{"verse": 1, "start": 300, "end": 12004, "text": "Y como pasó el sábado, María Magdalena, y María madre de Jacobo, y Salomé, compraron especias aromáticas, para venir a ungirle.", "words": [[0, 300], [2, 444], [7, 724], [12, 1084], [15, 1324], [23, 1924], [29, 2844], [40, 3864], [42, 4564], [48, 4884], [54, 5424], [57, 5584], [65, 6504], [67, 6684], [75, 7424], [85, 8344], [94, 8944], [106, 9744], [111, 10484], [117, 10804], [119, 11415]]}, {"verse": 2, "start": 12454, "end": 18546, "text": "Y muy de mañana, el primer día de la semana, vienen al sepulcro, ya salido el sol.", "words": [[0, 12454], [2, 12578], [6, 12738], [9, 12898], [17, 13438], [20, 13538], [27, 13858], [31, 14178], [34, 14318], [37, 14458], [45, 15318], [52, 15838], [55, 16138], [65, 17198], [68, 17498], [75, 17858], [78, 18018]]}, {"verse": 3, "start": 18996, "end": 24296, "text": "Y decían entre sí: ¿Quién nos hará rodar la piedra de la puerta del sepulcro?", "words": [[0, 18996], [2, 19105], [9, 19625], [15, 19905], [19, 20637], [26, 20957], [30, 21097], [35, 21417], [41, 21897], [44, 22037], [51, 22537], [54, 22657], [57, 22777], [64, 23117], [68, 23397]]}, {"verse": 4, "start": 24646, "end": 29011, "text": "Y al mirar, vieron que la piedra había sido removida, aunque era muy grande.", "words": [[0, 24646], [2, 24775], [5, 24875], [12, 25275], [19, 25615], [23, 25775], [26, 25915], [33, 26355], [39, 26555], [44, 26935], [54, 27855], [61, 28015], [65, 28275], [69, 28435]]}, {"verse": 5, "start": 29461, "end": 39445, "text": "Y entradas en el sepulcro, vieron un joven sentado al lado derecho, cubierto de una larga túnica blanca; y se espantaron.", "words": [[0, 29461], [2, 29761], [11, 30321], [14, 30581], [17, 30741], [27, 31481], [34, 32321], [37, 32501], [43, 32961], [51, 33641], [54, 33821], [59, 34101], [68, 34601], [77, 35641], [80, 35961], [84, 36141], [90, 36561], [97, 37041], [105, 38052], [107, 38216], [110, 38336]]}, {"verse": 6, "start": 39895, "end": 50488, "text": "Pero él les dice: No os asustéis: buscáis a Jesús nazareno, el que fue crucificado; ha resucitado, no está aquí; he aquí el lugar en donde le pusieron.", "words": [[0, 39895], [5, 40060], [8, 40290], [12, 40520], [18, 41329], [21, 41531], [24, 41711], [34, 42794], [42, 43274], [44, 43434], [50, 43654], [60, 44374], [63, 44614], [67, 44734], [71, 44914], [84, 46385], [87, 46679], [99, 46972], [102, 47272], [107, 47492], [113, 48298], [116, 48378], [121, 48638], [124, 48918], [130, 49238], [133, 49518], [139, 49658], [142, 49838]]}, {"verse": 7, "start": 50938, "end": 57639, "text": "Pero id, decid a sus discípulos y a Pedro, que él va antes que vosotros a Galilea: allí le veréis, como os dijo.", "words": [[0, 50938], [5, 51097], [9, 51337], [15, 51577], [17, 51817], [21, 51977], [32, 52637], [34, 52777], [36, 52857], [43, 53417], [47, 53604], [50, 53790], [53, 53977], [59, 54237], [63, 54437], [72, 54877], [74, 55117], [83, 56039], [88, 56301], [91, 56421], [99, 56801], [104, 57101], [107, 57241]]}, {"verse": 8, "start": 57989, "end": 67441, "text": "Y ellas se fueron huyendo del sepulcro; porque las había tomado temblor y espanto; ni decían nada a nadie, porque tenían miedo.", "words": [[0, 57989], [2, 58173], [8, 58533], [11, 58993], [18, 59273], [26, 59913], [30, 60153], [40, 61427], [47, 61612], [51, 61812], [57, 62132], [64, 62612], [72, 63212], [74, 63372], [83, 64559], [86, 64707], [93, 65247], [98, 65607], [100, 65847], [107, 66127], [114, 66407], [121, 66787]]}, {"verse": 9, "start": 67891, "end": 78496, "text": "Pero como Jesús resucitó por la mañana, el primer día de la semana, apareció primeramente a María Magdalena, de la cual había echado siete demonios.", "words": [[0, 67891], [5, 68173], [10, 68353], [16, 69173], [25, 69993], [29, 70153], [32, 70293], [40, 70693], [43, 70913], [50, 71213], [54, 71533], [57, 71673], [60, 71813], [68, 7