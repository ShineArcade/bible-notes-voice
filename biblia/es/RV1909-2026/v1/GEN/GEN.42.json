{"book": "GEN", "chapter": 42, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 349966, "verses": [{"verse": 1, "start": 300, "end": 9125, "text": "Y viendo Jacob que en Egipto había alimentos, dijo a sus hijos: ¿Por qué os estáis mirando?", "words": [[0, 300], [2, 426], [9, 686], [15, 1066], [19, 1426], [22, 1726], [29, 2266], [35, 2506], [46, 3666], [51, 4026], [53, 4206], [57, 4346], [64, 5180], [69, 5322], [73, 5502], [76, 5642], [83, 5962]]}, {"verse": 2, "start": 9475, "end": 19040, "text": "Y dijo: He aquí, yo he oído que hay víveres en Egipto; descended allá, y comprad de allí para nosotros, para que podamos vivir, y no nos muramos.", "words": [[0, 9475], [2, 9604], [8, 10427], [11, 10517], [17, 10777], [20, 11057], [23, 11157], [28, 11457], [32, 11657], [36, 11817], [44, 12277], [47, 12377], [55, 13233], [65, 13738], [71, 14058], [73, 14578], [81, 15058], [84, 15158], [89, 15358], [94, 15598], [104, 16478], [109, 16798], [113, 16918], [121, 17338], [128, 17578], [130, 18098], [133, 18238], [137, 18398]]}, {"verse": 3, "start": 19390, "end": 23256, "text": "Y descendieron los diez hermanos de José a comprar trigo a Egipto.", "words": [[0, 19390], [2, 19496], [15, 20136], [19, 20429], [24, 20723], [33, 21016], [36, 21156], [41, 21416], [43, 21676], [51, 21976], [57, 22476], [59, 22596]]}, {"verse": 4, "start": 23706, "end": 32109, "text": "Mas Jacob no envió a Benjamín hermano de José con sus hermanos; porque dijo: No sea acaso que le acontezca algún desastre.", "words": [[0, 23706], [4, 23973], [10, 24533], [13, 24953], [19, 25333], [21, 25553], [30, 26173], [38, 26673], [41, 26753], [46, 27013], [50, 27293], [54, 27493], [64, 28355], [71, 28562], [77, 29415], [80, 29563], [84, 29803], [90, 30243], [94, 30423], [97, 30563], [107, 31203], [113, 31443]]}, {"verse": 5, "start": 32559, "end": 40079, "text": "Y vinieron los hijos de Israel a comprar entre los que venían: porque había hambre en la tierra de Canaán.", "words": [[0, 32559], [2, 32681], [11, 33161], [15, 33361], [21, 33681], [24, 33861], [31, 34241], [33, 34401], [41, 34941], [47, 35481], [51, 35701], [55, 35881], [63, 36907], [70, 37293], [76, 37773], [83, 38413], [86, 38693], [89, 38833], [96, 39153], [99, 39645]]}, {"verse": 6, "start": 40529, "end": 53135, "text": "Y José era el gobernador del país, quien vendía alimento a todo el pueblo: y llegaron los hermanos de José, y se inclinaron a él rostro por tierra.", "words": [[0, 40529], [2, 40657], [7, 41037], [11, 41797], [14, 42097], [25, 42857], [29, 43037], [35, 43577], [41, 44417], [48, 45057], [57, 45617], [59, 45857], [64, 46097], [67, 46297], [75, 47609], [77, 47715], [86, 48135], [90, 48335], [99, 48815], [102, 48915], [108, 49275], [110, 50135], [113, 50295], [124, 51195], [126, 51375], [129, 51575], [136, 52175], [140, 52395]]}, {"verse": 7, "start": 53585, "end": 68062, "text": "Y José como vio a sus hermanos, los conoció; mas hizo que no los conocía, y les habló ásperamente, y les dijo: ¿De dónde habéis venido? Ellos respondieron: De la tierra de Canaán a comprar alimentos.", "words": [[0, 53585], [2, 53850], [7, 54370], [12, 54530], [16, 54830], [18, 54950], [22, 55090], [32, 56010], [36, 56170], [45, 57271], [49, 57437], [54, 57604], [58, 57804], [61, 57964], [65, 58104], [74, 58744], [76, 58924], [80, 59084], [86, 59584], [99, 60404], [101, 60664], [105, 60784], [111, 61637], [115, 61794], [121, 61954], [128, 62314], [136, 63222], [142, 63589], [156, 65206], [159, 65348], [162, 65468], [169, 65788], [172, 66028], [179, 66468], [181, 66668], [189, 67028]]}, {"verse": 8, "start": 68512, "end": 73643, "text": "José, pues, conoció a sus hermanos; pero ellos no le conocieron.", "words": [[0, 68512], [6, 68940], [12, 69400], [20, 70160], [22, 70360], [26, 70480], [36, 71564], [41, 71730], [47, 72050], [50, 72630], [53, 72770]]}, {"verse": 9, "start": 74093, "end": 84025, "text": "Entonces se acordó José de los sueños que había tenido de ellos, y les dijo: Espías sois; habéis venido a ver las zonas desprotegidas del país.", "words": [[0, 74093], [9, 74870], [12, 75130], [19, 75630], [24, 75950], [27, 76150], [31, 76290], [38, 76790], [42, 76930], [48, 77130], [55, 77470], [58, 77770], [65, 78050], [67, 78350], [71, 78530], [77, 79399], [84, 79966], [90, 80860], [97, 81178], [104, 81578], [106, 81698], [110, 81818], [114, 81978], [120, 82338], [134, 83158], [138, 83358]]}, {"verse": 10, "start": 84375, "end": 91119, "text": "Y ellos le respondieron: No, señor mío: mas tus siervos han venido a comprar alimentos.", "words": [[0, 84375], [2, 84542], [8, 84902], [11, 85322], [25, 87569], [29, 87640], [35, 87712], [40, 88084], [44, 88084], [48, 88206], [56, 88826], [60, 89086], [67, 89546], [69, 89666], [77, 90026]]}, {"verse": 11, "start": 91569, "end": 98387, "text": "Todos nosotros somos hijos de un varón: somos hombres de verdad: tus siervos nunca fueron espías.", "words": [[0, 91569], [6, 91811], [15, 92291], [21, 92671], [27, 92991], [30, 93231], [33, 93781], [40, 94833], [46, 95069], [54, 95305], [57, 95541], [65, 96045], [69, 96149], [77, 96589], [83, 97069], [90, 97529]]}, {"verse": 12, "start": 98837, "end": 103211, "text": "Y él les dijo: No; a ver lo descubierto del país habéis venido.", "words": [[0, 98837], [2, 99021], [5, 99161], [9, 99341], [15, 100182], [19, 100842], [21, 100963], [25, 101083], [28, 101243], [40, 101843], [44, 102023], [49, 102303], [56, 102683]]}, {"verse": 13, "start": 103561, "end": 116437, "text": "Y ellos respondieron: Tus siervos somos doce hermanos, hijos de un varón en la tierra de Canaán; y he aquí el menor está hoy con nuestro padre, y otro no aparece.", "words": [[0, 103561], [2, 103725], [8, 103965], [22, 105497], [26, 105711], [34, 105924], [40, 106344], [45, 106884], [55, 107864], [61, 108064], [64, 108364], [67, 108504], [73, 109324], [76, 109524], [79, 109684], [86, 110064], [89, 110284], [97, 111304], [99, 111513], [102, 111633], [107, 111913], [110, 112073], [116, 112353], [121, 112633], [125, 112993], [129, 113213], [137, 113513], [144, 114193], [146, 114733], [151, 115033], [154, 115653]]}, {"verse": 14, "start": 116887, "end": 121647, "text": "Y José les dijo: Eso es lo que os he dicho, afirmando que sois espías:", "words": [[0, 116887], [2, 117089], [7, 117369], [11, 117649], [17, 118564], [21, 118789], [24, 118929], [27, 119049], [31, 119169], [34, 119309], [37, 119409], [44, 120029], [54, 120489], [58, 120629], [63, 120889]]}, {"verse": 15, "start": 122097, "end": 128203, "text": "En esto seréis probados: Vive Faraón que no saldréis de aquí, sino cuando vuestro hermano menor aquí venga.", "words": [[0, 122097], [3, 122264], [8, 122474], [15, 122894], [25, 123922], [30, 124127], [37, 124587], [41, 124727], [44, 124847], [53, 125347], [56, 125447], [62, 126027], [67, 126207], [74, 126447], [82, 126847], [90, 127227], [96, 127387], [101, 127687]]}, {"verse": 16, "start": 128653, "end": 139811, "text": "Enviad uno de vosotros, y traiga a vuestro hermano; y vosotros quedad presos, y vuestras palabras serán probadas, si hay verdad con vosotros: y si no, vive Faraón, que sois espías.", "words": [[0, 128653], [7, 129097], [11, 129257], [14, 129417], [24, 129977], [26, 130297], [33, 130697], [35, 130777], [43, 131097], [52, 131971], [54, 132096], [63, 132556], [70, 132996], [78, 133576], [80, 133856], [89, 134176], [98, 134516], [104, 134896], [114, 135436], [117, 135796], [121, 135936], [128, 136216], [132, 136496], [142, 137462], [144, 137589], [147, 137709], [151, 138009], [156, 138189], [164, 138709], [168, 138909], [173, 139169]]}, {"verse": 17, "start": 140161, "end": 142639, "text": "Y los juntó en la cárcel por tres días.", "words": [[0, 140161], [2, 140258], [6, 140388], [12, 140808], [15, 140868], [18, 141008], [25, 141388], [29, 141608], [34, 141948]]}, {"verse": 18, "start": 143089, "end": 148090, "text": "Y al tercer día les dijo José: Haced esto, y vivid: Yo temo a Dios:", "words": [[0, 143089], [2, 143193], [5, 143313], [12, 143613], [16, 144013], [20, 144213], [25, 144533], [31, 145501], [37, 145691], [43, 146071], [45, 146421], [52, 147018], [55, 147173], [60, 147533], [62, 147633]]}, {"verse": 19, "start": 148540, "end": 157421, "text": "Si sois hombres de verdad, quede preso en la casa de vuestra cárcel uno de vuestros hermanos; y vosotros id, llevad el alimento para el hambre de vuestra casa:", "words": [[0, 148540], [3, 148682], [8, 149022], [16, 149262], [19, 149502], [27, 150242], [33, 150462], [39, 150882], [42, 150942], [45, 151062], [50, 151322], [53, 151522], [61, 151862], [68, 152302], [72, 152602], [75, 152782], [84, 153122], [94, 154115], [96, 154222], [105, 154522], [109, 154822], [116, 155122], [119, 155422], [128, 155842], [133, 156142], [136, 156282], [143, 156522], [146, 156642], [154, 156962]]}, {"verse": 20, "start": 157871, "end": 166005, "text": "Pero habéis de traerme a vuestro hermano menor, y serán verificadas vuestras palabras, y no moriréis. Y ellos lo hicieron así.", "words": [[0, 157871], [5, 158012], [12, 158292], [15, 158412], [23, 158792], [25, 158932], [33, 159192], [41, 159592], [48, 159872], [50, 160272], [56, 160572], [68, 161192], [77, 161572], [87, 161992], [89, 162512], [92, 162652], [102, 163727], [104, 163891], [110, 164251], [113, 164751], [122, 165251]]}, {"verse": 21, "start": 166455, "end": 180831, "text": "Y decían el uno al otro: Verdaderamente hemos pecado contra nuestro hermano, que vimos la angustia de su alma cuando nos rogaba, y no le oímos: por eso ha venido sobre nosotros esta angustia.", "words": [[0, 166455], [2, 166543], [9, 167003], [12, 167183], [16, 167403], [19, 167603], [25, 168422], [40, 169308], [46, 169548], [53, 170068], [60, 170428], [68, 170668], [77, 171428], [81, 171708], [87, 171948], [90, 172168], [99, 172668], [102, 172808], [105, 173008], [110, 173308], [117, 173568], [121, 173888], [129, 174468], [131, 174888], [134, 175088], [137, 175228], [144, 176249], [148, 176371], [152, 176671], [155, 177011], [162, 177431], [168, 177691], [177, 178311], [182, 178951]]}, {"verse": 22, "start": 181281, "end": 191452, "text": "Entonces Rubén les respondió, diciendo: ¿No os hablé yo y dije: No pequéis contra el joven; y no escuchasteis? He aquí también su sangre es requerida.", "words": [[0, 181433], [9, 181619], [15, 181806], [19, 182106], [30, 182906], [40, 184538], [44, 184719], [47, 184879], [53, 185179], [56, 185399], [58, 185539], [64, 186257], [67, 186494], [75, 186764], [82, 187024], [85, 187204], [92, 187942], [94, 188040], [97, 188140], [111, 189421], [114, 189491], [119, 189711], [127, 189991], [130, 190271], [137, 190651], [140, 190831]]}, {"verse": 23, "start": 191802, "end": 196970, "text": "Y ellos no sabían que los entendía José, porque había intérprete entre ellos.", "words": [[0, 191802], [2, 191947], [8, 192167], [11, 192387], [18, 192827], [22, 192987], [26, 193147], [35, 193787], [41, 194427], [48, 194827], [54, 195167], [65, 196067], [71, 196327]]}, {"verse": 24, "start": 197420, "end": 208931, "text": "Y se apartó él de ellos, y lloró: después volvió a ellos, y les habló, y tomó de entre ellos a Simeón, y lo aprisionó a vista de ellos.", "words": [[0, 197420], [2, 197567], [5, 197647], [12, 198167], [15, 198467], [18, 198687], [25, 199007], [27, 199547], [34, 200301], [42, 200724], [49, 201764], [51, 201884], [58, 202184], [60, 202884], [64, 203064], [71, 203784], [73, 203984], [78, 204424], [81, 204544], [87, 204844], [93, 205184], [95, 205464], [103, 206044], [105, 206464], [108, 206644], [118, 207624], [120, 207764], [126, 208024], [129, 208304]]}, {"verse": 25, "start": 209381, "end": 222095, "text": "Y mandó José que llenaran sus sacos de trigo, y devolviesen el dinero de cada uno de ellos, poniéndolo en su saco, y les diesen comida para el camino: y se hizo así con ellos.", "words": [[0, 209381], [2, 209522], [8, 209982], [13, 210302], [17, 210542], [26, 211082], [30, 211362], [36, 211942], [39, 212042], [46, 212542], [48, 213002], [60, 213662], [63, 214002], [70, 214362], [73, 214602], [78, 214822], [82, 215142], [85, 215302], [92, 215882], [103, 216662], [106, 216802], [109, 216942], [115, 217682], [117, 217962], [121, 218102], [128, 218482], [135, 219002], [140, 219262], [143, 219422], [151, 220338], [153, 220467], [156, 220607], [161, 220887], [165, 221127], [169, 221427]]}, {"verse": 26, "start": 222545, "end": 226423, "text": "Y ellos pusieron su trigo sobre sus asnos, y se fueron de allí.", "words": [[0, 222545], [2, 222673], [8, 222873], [17, 223333], [20, 223553], [26, 223973], [32, 224273], [36, 224513], [43, 224993], [45, 225393], [48, 225513], [55, 225733], [58, 226013]]}, {"verse": 27, "start": 226873, "end": 234531, "text": "Y abriendo uno de ellos su saco para dar de comer a su asno en el posada, vio su dinero que estaba en la boca de su costal.", "words": [[0, 226873], [2, 226990], [11, 227530], [15, 227870], [18, 228070], [24, 228370], [27, 228590], [32, 229070], [37, 229290], [41, 229530], [44, 229730], [50, 229990], [52, 230190], [55, 230350], [60, 230750], [63, 230870], [66, 230990], [74, 231810], [78, 232130], [81, 232270], [88, 232650], [92, 232890], [99, 233110], [102, 233270], [105, 233390], [110, 233590], [113, 233770], [116, 233910]]}, {"verse": 28, "start": 234981, "end": 248464, "text": "Y dijo a sus hermanos: Mi dinero se me ha devuelto, y aquí está en mi saco. Se les sobresaltó entonces el corazón, y espantados dijeron el uno al otro: ¿Qué es esto que nos ha hecho Dios?", "words": [[0, 234981], [2, 235125], [7, 235445], [9, 235645], [13, 235785], [23, 236905], [26, 237031], [33, 237391], [36, 237671], [39, 237811], [42, 237911], [52, 238551], [54, 239051], [59, 239311], [64, 239631], [67, 239811], [70, 239951], [76, 240812], [79, 240959], [83, 241179], [94, 242159], [103, 242639], [106, 242979], [115, 243439], [117, 243939], [128, 244539], [136, 245079], [139, 245219], [143, 245419], [146, 245599], [152, 246439], [157, 246604], [160, 246804], [165, 247104], [169, 247284], [173, 247484], [176, 247664], [182, 247864]]}, {"verse": 29, "start": 248914, "end": 256849, "text": "Y venidos a Jacob su padre en tierra de Canaán, le contaron todo lo que les había acontecido, diciendo:", "words": [[0, 248914], [2, 249039], [10, 249479], [12, 249659], [18, 250339], [21, 250479], [27, 250819], [30, 251179], [37, 251539], [40, 251779], [48, 252799], [51, 252899], [60, 253479], [65, 253819], [68, 254199], [72, 254399], [76, 254579], [82, 254979], [94, 256019]]}, {"verse": 30, "start": 257299, "end": 263357, "text": "Aquel varón, señor de la tierra, nos habló ásperamente, y nos trató como a espías de la tierra:", "words": [[0, 257299], [6, 257627], [13, 257947], [19, 258247], [22, 258487], [25, 258607], [33, 259047], [37, 259687], [43, 260107], [56, 260927], [58, 261047], [62, 261167], [68, 261627], [73, 261867], [75, 262027], [82, 262547], [85, 262747], [88, 262847]]}, {"verse": 31, "start": 263807, "end": 269396, "text": "Y nosotros le dijimos: Somos hombres de verdad, nunca fuimos espías:", "words": [[0, 263807], [2, 264167], [11, 264487], [14, 264867], [23, 266394], [29, 266394], [37, 266813], [40, 267033], [48, 267433], [54, 267993], [61, 268724]]}, {"verse": 32, "start": 269846, "end": 279044, "text": "Somos doce hermanos, hijos de nuestro padre; uno no aparece, y el menor está hoy con nuestro padre en la tierra de Canaán.", "words": [[0, 269846], [6, 270344], [11, 270784], [21, 271424], [27, 271624], [30, 271904], [38, 272084], [45, 273166], [49, 273411], [52, 273771], [61, 274431], [63, 274991], [66, 275131], [72, 275471], [77, 275791], [81, 276071], [85, 276291], [93, 276671], [99, 277331], [102, 277531], [105, 277671], [112, 278031], [115, 278567]]}, {"verse": 33, "start": 279494, "end": 292543, "text": "Y aquel varón, señor de la tierra, nos dijo: En esto conoceré que sois hombres de verdad; dejad conmigo uno de vuestros hermanos, y tomad para el hambre de vuestras casas, y andad,", "words": [[0, 279494], [2, 279782], [8, 280062], [15, 280382], [21, 280702], [24, 280902], [27, 281042], [35, 281322], [39, 281702], [45, 282562], [48, 282706], [53, 282966], [62, 283686], [66, 283806], [71, 284186], [79, 284646], [82, 284926], [90, 285892], [96, 286583], [104, 287123], [108, 287423], [111, 287583], [120, 288003], [130, 288843], [132, 289063], [138, 289283], [143, 289643], [146, 289963], [153, 290323], [156, 290483], [165, 290803], [172, 291643], [174, 291883]]}, {"verse": 34, "start": 292993, "end": 304529, "text": "Y traedme a vuestro hermano el menor, para que yo sepa que no sois espías, sino hombres de verdad: así os daré a vuestro hermano, y negociaréis en la tierra.", "words": [[0, 292993], [2, 293142], [10, 293822], [12, 293942], [20, 294262], [28, 294702], [31, 294782], [38, 295802], [43, 296082], [47, 296222], [50, 296382], [55, 296762], [59, 296922], [62, 297102], [67, 297462], [75, 298582], [80, 298922], [88, 299462], [91, 299702], [99, 300613], [103, 300847], [106, 301067], [111, 301387], [113, 301407], [121, 301707], [130, 302527], [132, 302667], [144, 303487], [147, 303687], [150, 303847]]}, {"verse": 35, "start": 304979, "end": 316125, "text": "Y aconteció que vaciando ellos sus sacos, he aquí que en el saco de cada uno estaba el atado de su dinero: y viendo ellos y su padre los atados de su dinero, tuvieron temor.", "words": [[0, 304979], [2, 305107], [12, 305827], [16, 306027], [25, 306607], [31, 306907], [35, 307187], [42, 307787], [45, 308387], [50, 308727], [54, 308947], [57, 309127], [60, 309247], [65, 309707], [68, 309767], [73, 309947], [77, 310247], [84, 310547], [87, 310847], [93, 311147], [96, 311287], [99, 311427], [107, 312330], [109, 312434], [116, 312694], [122, 312954], [124, 313194], [127, 313334], [133, 313794], [137, 313914], [144, 314414], [147, 314574], [150, 314694], [158, 315054], [167, 315554]]}, {"verse": 36, "start": 316575, "end": 327774, "text": "Entonces su padre Jacob les dijo: Me habéis privado de mis hijos; José no aparece, ni Simeón tampoco, y a Benjamín le llevaréis: contra mí son todas estas cosas.", "words": [[0, 316575], [9, 317360], [12, 317580], [18, 318080], [24, 318700], [28, 318800], [34, 319567], [37, 319672], [44, 319892], [52, 320352], [55, 320472], [59, 320592], [66, 321462], [71, 321690], [74, 321930], [83, 322370], [86, 322690], [93, 323190], [102, 323610], [104, 324230], [106, 324310], [115, 324830], [118, 324930], [129, 325890], [136, 326227], [139, 326347], [143, 326547], [149, 326747], [155, 327047]]}, {"verse": 37, "start": 328124, "end": 336854, "text": "Y Rubén habló a su padre, diciendo: Harás morir a mis dos hijos, si no te lo devuelvo; entrégalo en mi mano, que yo te lo devolveré.", "words": [[0, 328124], [2, 328403], [8, 328713], [14, 329253], [16, 329353], [19, 329473], [26, 330413], [36, 331572], [42, 331833], [48, 332153], [50, 332213], [54, 332333], [58, 332473], [65, 332813], [68, 333133], [71, 333213], [74, 333353], [77, 333473], [87, 334616], [97, 334896], [100, 335016], [103, 335136], [109, 335736], [113, 335816], [116, 335976], [119, 336116], [122, 336216]]}, {"verse": 38, "start": 337204, "end": 349566, "text": "Y él dijo: No descenderá mi hijo con vosotros; que su hermano es muerto, y él solo ha quedado: y si le acontece algún desastre en el camino por donde vais, haréis descender mis canas con dolor a la sepultura.", "words": [[0, 337204], [2, 337392], [5, 337552], [11, 338321], [14, 338445], [25, 339065], [28, 339205], [33, 339425], [37, 339625], [47, 340694], [51, 340774], [54, 340934], [62, 341334], [65, 341454], [73, 341894], [75, 342214], [78, 342334], [83, 342614], [86, 342794], [95, 343612], [97, 343695], [100, 343775], [103, 343875], [112, 344275], [118, 344635], [127, 345175], [130, 345295], [133, 345375], [140, 345675], [144, 345935], [150, 346135], [156, 346915], [163, 347175], [173, 347635], [177, 347815], [183, 348195], [187, 348355], [193, 348635], [195, 348755], [198, 348855]]}]}