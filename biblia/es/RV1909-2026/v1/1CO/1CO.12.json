{"book": "1CO", "chapter": 12, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 202432, "verses": [{"verse": 1, "start": 300, "end": 4880, "text": "Y acerca de los dones espirituales, no quiero, hermanos, que ignoréis.", "words": [[0, 300], [2, 424], [9, 744], [12, 1024], [16, 1144], [22, 1544], [36, 2504], [39, 2824], [47, 3224], [57, 3924], [61, 4124]]}, {"verse": 2, "start": 5230, "end": 10649, "text": "Sabéis que cuando erais paganos, ibais, como erais llevados, a los ídolos mudos.", "words": [[0, 5230], [7, 5668], [11, 5848], [18, 6128], [24, 6488], [33, 7388], [40, 8168], [45, 8368], [51, 8628], [61, 9168], [63, 9428], [67, 9588], [74, 10068]]}, {"verse": 3, "start": 10999, "end": 20276, "text": "Por tanto os hago saber, que nadie que hable por Espíritu de Dios, llama maldito a Jesús; y nadie puede llamar a Jesús Señor, sino por Espíritu Santo.", "words": [[0, 10999], [4, 11106], [10, 11586], [13, 11806], [18, 11966], [25, 12346], [29, 12686], [35, 13006], [39, 13306], [45, 13626], [49, 13806], [58, 14386], [61, 14466], [67, 14746], [73, 15306], [81, 15926], [83, 16026], [90, 16790], [92, 16911], [98, 17131], [104, 17391], [111, 17831], [113, 17891], [119, 18091], [126, 18871], [131, 19051], [135, 19271], [144, 19771]]}, {"verse": 4, "start": 20626, "end": 24231, "text": "Ahora bien, hay diversidad de dones; pero el Espíritu es el mismo.", "words": [[0, 20626], [6, 20844], [12, 21084], [16, 21244], [27, 21804], [30, 21944], [37, 22713], [42, 22855], [45, 22975], [54, 23475], [57, 23595], [60, 23715]]}, {"verse": 5, "start": 24581, "end": 28189, "text": "Y hay diversidad de ministerios; pero el Señor es el mismo.", "words": [[0, 24581], [2, 24723], [6, 24823], [17, 25403], [20, 25563], [33, 26701], [38, 26845], [41, 26985], [47, 27265], [50, 27545], [53, 27665]]}, {"verse": 6, "start": 28539, "end": 34226, "text": "Y hay diversidad de actividades; pero el mismo Dios es el que obra todas las cosas en todos.", "words": [[0, 28539], [2, 28680], [6, 28780], [17, 29340], [20, 29500], [33, 30630], [38, 30782], [41, 30922], [47, 31222], [52, 31582], [55, 31862], [58, 31982], [62, 32142], [67, 32402], [73, 32702], [77, 33002], [83, 33322], [86, 33602]]}, {"verse": 7, "start": 34576, "end": 38476, "text": "Pero a cada uno le es dada manifestación del Espíritu para provecho.", "words": [[0, 34576], [5, 34720], [7, 34880], [12, 35020], [16, 35340], [19, 35540], [22, 35700], [27, 35940], [41, 36760], [45, 36960], [54, 37580], [59, 37740]]}, {"verse": 8, "start": 38826, "end": 46514, "text": "Porque a la verdad, a este es dada por el Espíritu palabra de sabiduría; a otro, palabra de conocimiento según el mismo Espíritu;", "words": [[0, 38826], [7, 39074], [9, 39154], [12, 39194], [20, 39954], [22, 40234], [27, 40534], [30, 40734], [35, 41014], [39, 41194], [42, 41314], [51, 41794], [59, 42274], [62, 42374], [73, 43334], [75, 43453], [81, 43733], [89, 44213], [92, 44453], [105, 45173], [111, 45473], [114, 45653], [120, 45853]]}, {"verse": 9, "start": 46864, "end": 52215, "text": "A otro, fe por el mismo Espíritu; y a otro, dones de sanidades por el mismo Espíritu;", "words": [[0, 46864], [2, 47009], [8, 47269], [11, 47849], [15, 48089], [18, 48209], [24, 48429], [34, 49322], [36, 49447], [38, 49527], [44, 49787], [50, 50187], [53, 50307], [63, 50847], [67, 51107], [70, 51227], [76, 51447]]}, {"verse": 10, "start": 52565, "end": 63175, "text": "A otro, operaciones de milagros; y a otro, profecía; y a otro, discernimiento de espíritus; y a otro, géneros de lenguas; y a otro, interpretación de lenguas.", "words": [[0, 52565], [2, 52761], [8, 52991], [20, 53891], [23, 54111], [33, 55008], [35, 55133], [37, 55213], [43, 55433], [53, 56495], [55, 56618], [57, 56718], [63, 56998], [78, 57958], [81, 58118], [92, 59074], [94, 59220], [96, 59300], [102, 59940], [110, 60320], [113, 60420], [122, 61229], [124, 61351], [126, 61501], [132, 61651], [147, 62411], [150, 62551]]}, {"verse": 11, "start": 63525, "end": 69865, "text": "Pero todas estas cosas obra uno y el mismo Espíritu, repartiendo individualmente a cada uno como quiere.", "words": [[0, 63525], [5, 63643], [11, 63903], [17, 64203], [23, 64563], [28, 65023], [32, 65383], [34, 65643], [37, 65743], [43, 66023], [53, 67043], [65, 67643], [81, 68503], [83, 68663], [88, 68803], [92, 69103], [97, 69363]]}, {"verse": 12, "start": 70215, "end": 79339, "text": "Porque de la manera que el cuerpo es uno, y tiene muchos miembros, pero todos los miembros del cuerpo, siendo muchos, son un cuerpo, así también Cristo.", "words": [[0, 70215], [7, 70446], [10, 70606], [13, 70726], [20, 71006], [24, 71226], [27, 71366], [34, 71606], [37, 71906], [42, 72206], [44, 72606], [50, 72866], [57, 73166], [67, 74226], [72, 74426], [78, 74666], [82, 74866], [91, 75326], [95, 75466], [103, 76126], [110, 76406], [118, 77226], [122, 77366], [125, 77526], [133, 78126], [137, 78346], [145, 78646]]}, {"verse": 13, "start": 79689, "end": 89404, "text": "Porque por un Espíritu somos todos bautizados en un cuerpo, sean judíos o griegos, sean siervos o libres; y todos hemos bebido de un mismo Espíritu.", "words": [[0, 79689], [7, 79902], [11, 80162], [14, 80282], [23, 80882], [29, 81162], [35, 81522], [46, 82342], [49, 82582], [52, 82702], [60, 83522], [65, 83722], [72, 84402], [74, 84562], [83, 85322], [88, 85712], [96, 86102], [98, 86282], [106, 87099], [108, 87219], [114, 87399], [120, 87699], [127, 88239], [130, 88359], [133, 88459], [139, 88699]]}, {"verse": 14, "start": 89754, "end": 92814, "text": "Pues ni tampoco el cuerpo es un miembro, sino muchos.", "words": [[0, 89754], [5, 89944], [8, 90224], [16, 90564], [19, 90824], [26, 91024], [29, 91304], [32, 91444], [41, 91924], [46, 92164]]}, {"verse": 15, "start": 93164, "end": 98880, "text": "Si dice el pie: Como no soy mano, no soy parte del cuerpo», ¿por eso no sería parte del cuerpo?", "words": [[0, 93164], [3, 93347], [8, 93587], [11, 93727], [16, 94353], [21, 94515], [24, 94675], [28, 94895], [34, 95455], [37, 95555], [41, 95735], [47, 96015], [51, 96255], [60, 97035], [65, 97215], [69, 97395], [72, 97515], [78, 97735], [84, 98055], [88, 98315]]}, {"verse": 16, "start": 99230, "end": 104486, "text": "Y si dice la oreja: Como no soy ojo, no soy parte del cuerpo», ¿por eso no sería parte del cuerpo?", "words": [[0, 99230], [2, 99358], [5, 99478], [10, 99738], [13, 99918], [20, 100648], [25, 100810], [28, 100970], [32, 101170], [37, 101630], [40, 101710], [44, 101890], [50, 102130], [54, 102370], [63, 102870], [68, 102990], [72, 103150], [75, 103270], [81, 103470], [87, 103770], [91, 104010]]}, {"verse": 17, "start": 104836, "end": 110668, "text": "Si todo el cuerpo fuese ojo, ¿dónde estaría el oído? Si todo fuese oído, ¿dónde estaría el olfato?", "words": [[0, 104836], [3, 104985], [8, 105185], [11, 105345], [18, 105585], [24, 105945], [29, 106465], [36, 106665], [44, 107005], [47, 107105], [53, 107702], [56, 107886], [61, 108126], [67, 108506], [73, 109386], [80, 109666], [88, 110006], [91, 110106]]}, {"verse": 18, "start": 111018, "end": 115186, "text": "Pero ahora Dios ha colocado los miembros cada uno de ellos en el cuerpo, como quiso.", "words": [[0, 111018], [5, 111158], [11, 111438], [16, 111718], [19, 111918], [28, 112398], [32, 112538], [41, 112958], [46, 113158], [50, 113378], [53, 113538], [59, 113738], [62, 113898], [65, 114018], [73, 114558], [78, 114698]]}, {"verse": 19, "start": 115536, "end": 118173, "text": "Que si todos fueran un miembro, ¿dónde estuviera el cuerpo?", "words": [[0, 115536], [4, 115616], [7, 115736], [13, 115956], [20, 116356], [23, 116436], [32, 117056], [39, 117236], [49, 117596], [52, 117696]]}, {"verse": 20, "start": 118523, "end": 121684, "text": "Pero ahora son muchos los miembros, pero el cuerpo es uno solo.", "words": [[0, 118523], [5, 118660], [11, 118880], [15, 119160], [22, 119480], [26, 119680], [36, 120260], [41, 120380], [44, 120500], [51, 120740], [54, 121000], [58, 121160]]}, {"verse": 21, "start": 122034, "end": 129382, "text": "Ni el ojo puede decir a la mano: No te necesito: ni asimismo la cabeza a los pies: No tengo necesidad de vosotros.", "words": [[0, 122034], [3, 122159], [6, 122299], [10, 122539], [16, 122759], [22, 123119], [24, 123279], [27, 123359], [33, 124007], [36, 124165], [39, 124265], [49, 125228], [52, 125355], [61, 125875], [64, 125995], [71, 126355], [73, 126575], [77, 126695], [83, 127472], [86, 127649], [92, 127949], [102, 128549], [105, 128669]]}, {"verse": 22, "start": 129732, "end": 134392, "text": "Antes, mucho más los miembros del cuerpo que parecen más débiles, son necesarios;", "words": [[0, 129732], [7, 130139], [13, 130459], [17, 130699], [21, 130879], [30, 131319], [34, 131439], [41, 131759], [45, 131959], [53, 132339], [57, 132579], [66, 132999], [70, 133439]]}, {"verse": 23, "start": 134742, "end": 144683, "text": "Y a aquellos del cuerpo que consideramos menos honrosos, a estos vestimos más dignamente; y a los que en nosotros son menos presentables, los tratamos con mayor decoro.", "words": [[0, 134742], [2, 134784], [4, 134864], [13, 135164], [17, 135384], [24, 135624], [28, 135804], [41, 136444], [47, 136944], [57, 137444], [59, 137864], [65, 138104], [74, 138624], [78, 138864], [90, 140126], [92, 140245], [94, 140305], [98, 140465], [102, 140555], [105, 140645], [114, 140965], [118, 141425], [124, 141665], [138, 142945], [142, 143125], [151, 143585], [155, 143805], [161, 144065]]}, {"verse": 24, "start": 145033, "end": 153562, "text": "Porque los que en nosotros son más presentables, no tienen necesidad: pero Dios ordenó el cuerpo, dando más abundante honor al que le faltaba;", "words": [[0, 145033], [7, 145213], [11, 145413], [15, 145503], [18, 145593], [27, 145953], [31, 146353], [35, 146533], [49, 147293], [52, 147733], [59, 147993], [70, 149053], [75, 149190], [80, 149430], [87, 149990], [90, 150130], [98, 150950], [104, 151210], [108, 151530], [118, 152170], [124, 152430], [127, 152650], [131, 152790], [134, 152890]]}, {"verse": 25, "start": 153912, "end": 159862, "text": "Para que no haya desavenencia en el cuerpo, sino que los miembros todos se interesen los unos por los otros.", "words": [[0, 153912], [5, 154077], [9, 154237], [12, 154417], [17, 154617], [30, 155417], [33, 155537], [36, 155637], [44, 156277], [49, 156577], [53, 156757], [57, 156897], [66, 157377], [72, 157637], [75, 157977], [85, 158477], [89, 158617], [94, 158877], [98, 159137], [102, 159297]]}, {"verse": 26, "start": 160212, "end": 168140, "text": "Por manera que si un miembro padece, todos los miembros a una se duelen; y si un miembro es honrado, todos los miembros a una se gozan.", "words": [[0, 160212], [4, 160304], [11, 160524], [15, 160744], [18, 160904], [21, 161064], [29, 161404], [37, 162304], [43, 162424], [47, 162704], [56, 162957], [58, 163211], [62, 163464], [65, 163684], [73, 164481], [75, 164599], [78, 164699], [81, 164839], [89, 165179], [92, 165299], [101, 166199], [107, 166359], [111, 166619], [120, 166846], [122, 167072], [126, 167299], [129, 167539]]}, {"verse": 27, "start": 168490, "end": 173556, "text": "Pues vosotros sois el cuerpo de Cristo, y cada uno de vosotros es miembro de él.", "words": [[0, 168490], [5, 168698], [14, 169338], [19, 169698], [22, 169798], [29, 170098], [32, 170318], [40, 171138], [42, 171178], [47, 171418], [51, 171678], [54, 171818], [63, 172298], [66, 172618], [74, 173098], [77, 173238]]}, {"verse": 28, "start": 173906, "end": 186623, "text": "Y a unos puso Dios en la iglesia, primeramente apóstoles, luego profetas, lo tercero maestros; luego los que hacen milagros; luego dones de sanidades, ayudas, capacidades de dirección, géneros de lenguas.", "words": [[0, 173906], [2, 174023], [4, 174103], [9, 174303], [14, 174743], [19, 175083], [22, 175223], [25, 175323], [34, 176143], [47, 176763], [58, 177603], [64, 177823], [74, 178763], [77, 178863], [85, 179323], [95, 180283], [101, 180473], [105, 180693], [109, 180833], [115, 181013], [125, 181932], [131, 182074], [137, 182474], [140, 182574], [151, 183454], [159, 183994], [171, 184554], [174, 184714], [185, 185574], [193, 185974], [196, 186074]]}, {"verse": 29, "start": 186973, "end": 192551, "text": "¿Son todos apóstoles? ¿son todos profetas? ¿todos maestros? ¿hacen todos milagros?", "words": [[0, 186973], [5, 187139], [11, 187419], [22, 188459], [27, 188631], [33, 188891], [43, 189911], [50, 190050], [60, 191180], [67, 191421], [73, 191681]]}, {"verse": 30, "start": 192901, "end": 197306, "text": "¿Tienen todos dones de sanidad? ¿hablan todos lenguas? ¿interpretan todos?", "words": [[0, 192901], [8, 193088], [14, 193348], [20, 193868], [23, 193968], [32, 194705], [40, 195006], [46, 195226], [55, 196174], [68, 196793]]}, {"verse": 31, "start": 197656, "end": 202032, "text": "Pero procurad los mejores dones: pero aun yo os muestro un camino más excelente.", "words": [[0, 197656], [5, 197956], [14, 198296], [18, 198436], [26, 198776], [33, 199612], [38, 199755], [42, 199985], [45, 200215], [48, 200445], [56, 200675], [59, 200775], [66, 201075], [70, 201275]]}]}