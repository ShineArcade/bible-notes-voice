{"book": "ROM", "chapter": 3, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 193232, "verses": [{"verse": 1, "start": 300, "end": 4377, "text": "¿Qué, pues, tiene más el judío? ¿o qué aprovecha la circuncisión?", "words": [[0, 300], [6, 424], [12, 1104], [18, 1244], [22, 1504], [25, 1644], [32, 2500], [35, 2657], [39, 2977], [49, 3297], [52, 3417]]}, {"verse": 2, "start": 4827, "end": 9968, "text": "Mucho en todas maneras. Lo primero ciertamente, que la palabra de Dios les ha sido confiada.", "words": [[0, 4827], [6, 5108], [9, 5268], [15, 5408], [24, 6488], [27, 6591], [35, 7051], [48, 7671], [52, 7791], [55, 7911], [63, 8231], [66, 8451], [71, 8671], [75, 8871], [78, 9031], [83, 9211]]}, {"verse": 3, "start": 10418, "end": 16576, "text": "¿Pues qué si algunos de ellos han sido incrédulos? ¿la incredulidad de ellos habrá hecho vana la verdad de Dios?", "words": [[0, 10418], [6, 10519], [10, 10699], [13, 10859], [21, 11179], [24, 11479], [30, 11679], [34, 11899], [39, 12159], [51, 13380], [55, 13464], [68, 14204], [71, 14344], [77, 14544], [83, 14924], [89, 15194], [94, 15464], [97, 15584], [104, 15844], [107, 16084]]}, {"verse": 4, "start": 17026, "end": 27646, "text": "En ninguna manera; antes bien sea Dios verdadero, pero todo hombre mentiroso; como está escrito: Para que seas justificado en tus dichos, y venzas cuando se te juzgue.", "words": [[0, 17026], [3, 17169], [11, 17489], [19, 18527], [25, 18987], [30, 19527], [34, 19667], [39, 19947], [50, 20747], [55, 20887], [60, 21147], [67, 21467], [78, 22633], [83, 22794], [88, 23034], [97, 23940], [102, 24077], [106, 24237], [111, 24477], [123, 25277], [126, 25377], [130, 25497], [138, 26017], [140, 26177], [147, 26537], [154, 26757], [157, 26977], [160, 27097]]}, {"verse": 5, "start": 28096, "end": 35865, "text": "Y si nuestra iniquidad pone de manifiesto la justicia de Dios, ¿qué diremos? ¿Será injusto Dios que da castigo? (hablo como hombre.)", "words": [[0, 28096], [2, 28213], [5, 28293], [13, 28573], [23, 29133], [28, 29393], [31, 29533], [42, 30133], [45, 30233], [54, 30753], [57, 30893], [63, 31573], [68, 31653], [77, 32595], [83, 32888], [91, 33368], [96, 33508], [100, 33728], [103, 33848], [112, 34879], [119, 35203], [124, 35383]]}, {"verse": 6, "start": 36315, "end": 39906, "text": "En ninguna manera: de otro modo ¿cómo juzgaría Dios el mundo?", "words": [[0, 36315], [3, 36476], [11, 36776], [19, 37684], [22, 37787], [27, 37947], [32, 38387], [38, 38527], [47, 39067], [52, 39247], [55, 39467]]}, {"verse": 7, "start": 40356, "end": 46512, "text": "Pero si la verdad de Dios por mi mentira creció a gloria suya, ¿por qué aun así yo soy juzgado como pecador?", "words": [[0, 40356], [5, 40493], [8, 40633], [11, 40753], [18, 40993], [21, 41273], [26, 41493], [30, 41773], [33, 41873], [41, 42313], [48, 42733], [50, 42833], [57, 43133], [63, 44153], [68, 44253], [72, 44433], [76, 44593], [80, 44833], [83, 44953], [87, 45153], [95, 45633], [100, 45873]]}, {"verse": 8, "start": 46962, "end": 56714, "text": "¿Y por qué no decir (como somos calumniados, y como algunos dicen que nosotros decimos): Hagamos males para que vengan bienes? la condenación de los cuales es justa.", "words": [[0, 46962], [3, 47067], [7, 47247], [11, 47407], [14, 47507], [20, 47867], [26, 48187], [32, 48717], [45, 49247], [47, 49707], [52, 49907], [60, 50227], [66, 50627], [70, 50807], [79, 51147], [89, 52285], [97, 52629], [103, 52989], [108, 53289], [112, 53429], [119, 53729], [127, 54645], [130, 54749], [142, 55349], [145, 55509], [149, 55649], [156, 55889], [159, 56189]]}, {"verse": 9, "start": 57164, "end": 65381, "text": "¿Qué pues? ¿Somos mejores que ellos? En ninguna manera: porque ya hemos acusado a judíos y a Gentiles, que todos están debajo de pecado.", "words": [[0, 57164], [5, 57281], [11, 58011], [18, 58252], [26, 58712], [30, 58992], [37, 59784], [40, 59902], [48, 60202], [56, 61111], [63, 61292], [66, 61512], [72, 61692], [80, 62232], [82, 62352], [89, 62792], [91, 63012], [93, 63232], [103, 63452], [107, 63672], [113, 63932], [119, 64332], [126, 64732], [129, 64872]]}, {"verse": 10, "start": 65831, "end": 68498, "text": "Como está escrito: No hay justo, ni aun uno;", "words": [[0, 65831], [5, 65992], [10, 66192], [19, 67060], [22, 67178], [26, 67278], [33, 67578], [36, 67878], [40, 68058]]}, {"verse": 11, "start": 68948, "end": 71986, "text": "No hay quien entienda, no hay quien busque a Dios;", "words": [[0, 68948], [3, 69131], [7, 69291], [13, 69511], [23, 70511], [26, 70651], [30, 70791], [36, 71011], [43, 71411], [45, 71511]]}, {"verse": 12, "start": 72436, "end": 78609, "text": "Todos se apartaron, todos juntos fueron hechos inútiles; no hay quien haga lo bueno, no hay ni aun uno:", "words": [[0, 72436], [6, 72615], [9, 72815], [20, 73755], [26, 73875], [33, 74235], [40, 74635], [47, 74995], [57, 76030], [60, 76151], [64, 76291], [70, 76471], [75, 76671], [78, 76831], [85, 77491], [88, 77651], [92, 77811], [95, 77971], [99, 78171]]}, {"verse": 13, "start": 79059, "end": 86142, "text": "Sepulcro abierto es su garganta; con sus lenguas tratan engañosamente; veneno de áspides está debajo de sus labios;", "words": [[0, 79059], [9, 79556], [17, 79996], [20, 80156], [23, 80276], [33, 81178], [37, 81324], [41, 81484], [49, 81924], [56, 82324], [71, 83614], [78, 83936], [81, 84056], [89, 84516], [94, 84836], [101, 85236], [104, 85376], [108, 85496]]}, {"verse": 14, "start": 86592, "end": 89285, "text": "Cuya boca está llena de maldiciones y de amargura;", "words": [[0, 86592], [5, 86827], [10, 87047], [15, 87327], [21, 87647], [24, 87747], [36, 88287], [38, 88587], [41, 88647]]}, {"verse": 15, "start": 89735, "end": 91859, "text": "Sus pies son ligeros a derramar sangre;", "words": [[0, 89735], [4, 89854], [9, 90134], [13, 90294], [21, 90814], [23, 90914], [32, 91334]]}, {"verse": 16, "start": 92309, "end": 95340, "text": "Quebrantamiento y desventura hay en sus caminos;", "words": [[0, 92309], [16, 93150], [18, 93330], [29, 94050], [33, 94330], [36, 94450], [40, 94610]]}, {"verse": 17, "start": 95790, "end": 97930, "text": "Y camino de paz no conocieron:", "words": [[0, 95790], [2, 96021], [9, 96291], [12, 96391], [16, 96811], [19, 97131]]}, {"verse": 18, "start": 98380, "end": 100873, "text": "No hay temor de Dios delante de sus ojos.", "words": [[0, 98380], [3, 98560], [7, 98740], [13, 99100], [16, 99240], [21, 99500], [29, 100000], [32, 100120], [36, 100260]]}, {"verse": 19, "start": 101323, "end": 109657, "text": "Pero sabemos que todo lo que la ley dice, a los que están en la ley lo dice, para que toda boca se tape, y que todo el mundo se sujete a Dios:", "words": [[0, 101323], [5, 101463], [13, 101843], [17, 102083], [22, 102343], [25, 102543], [29, 102643], [32, 102763], [36, 102963], [42, 103623], [44, 103883], [48, 104023], [52, 104163], [58, 104423], [61, 104563], [64, 104663], [68, 104863], [71, 104983], [77, 105623], [82, 105903], [86, 106083], [91, 106263], [96, 106623], [99, 106803], [105, 107622], [107, 107721], [111, 107821], [116, 108041], [119, 108221], [125, 108421], [128, 108601], [135, 109101], [137, 109181]]}, {"verse": 20, "start": 110107, "end": 117127, "text": "Porque por las obras de la ley ninguna carne se justificará delante de él; porque por la ley es el conocimiento del pecado.", "words": [[0, 110107], [7, 110312], [11, 110532], [15, 110692], [21, 110972], [24, 111172], [27, 111312], [31, 111792], [39, 112052], [45, 112512], [48, 112712], [60, 113352], [68, 113792], [71, 113932], [75, 114527], [82, 114708], [86, 114968], [89, 115108], [93, 115368], [96, 115608], [99, 115728], [112, 116348], [116, 116508]]}, {"verse": 21, "start": 117577, "end": 123706, "text": "Pero ahora, sin la ley, la justicia de Dios se ha manifestado, testificada por la ley y por los profetas:", "words": [[0, 117577], [5, 117717], [12, 118017], [16, 118257], [19, 118417], [24, 118917], [27, 118997], [36, 119537], [39, 119677], [44, 119937], [47, 120177], [50, 120277], [63, 121337], [75, 121997], [79, 122177], [82, 122337], [86, 122517], [88, 122717], [92, 122897], [96, 123017]]}, {"verse": 22, "start": 124156, "end": 130428, "text": "La justicia de Dios por la fe de Jesucristo, para todos los que creen en él; porque no hay diferencia;", "words": [[0, 124156], [3, 124266], [12, 124826], [15, 124986], [20, 125226], [24, 125546], [27, 125686], [30, 125846], [33, 125946], [45, 127066], [50, 127286], [56, 127546], [60, 127786], [64, 127966], [70, 128326], [73, 128446], [77, 129033], [84, 129235], [87, 129475], [91, 129655]]}, {"verse": 23, "start": 130878, "end": 134709, "text": "Por cuanto todos pecaron, y están destituídos de la gloria de Dios;", "words": [[0, 130878], [4, 130999], [11, 131199], [17, 131539], [26, 132199], [28, 132399], [34, 132699], [46, 133459], [49, 133639], [52, 133759], [59, 134099], [62, 134219]]}, {"verse": 24, "start": 135159, "end": 140743, "text": "Siendo justificados gratuitamente por su gracia, por la redención que es en Cristo Jesús;", "words": [[0, 135159], [7, 135453], [20, 136233], [34, 137033], [38, 137293], [41, 137453], [49, 138233], [53, 138513], [56, 138653], [66, 139173], [70, 139453], [73, 139633], [76, 139753], [83, 140033]]}, {"verse": 25, "start": 141193, "end": 152209, "text": "Al cual Dios ha propuesto en propiciación por la fe en su sangre, para manifestación de su justicia, en vista de haber pasado por alto, en su paciencia, los pecados pasados,", "words": [[0, 141193], [3, 141370], [8, 141590], [13, 141950], [16, 142230], [26, 142790], [29, 142930], [42, 143710], [46, 143950], [49, 144090], [52, 144310], [55, 144450], [58, 144570], [66, 145590], [71, 145630], [85, 146390], [88, 146530], [91, 146670], [101, 147710], [104, 147790], [110, 148050], [113, 148230], [119, 148370], [126, 148710], [130, 148970], [136, 149610], [139, 149690], [142, 149830], [153, 150888], [157, 151014], [165, 151434]]}, {"verse": 26, "start": 152659, "end": 160259, "text": "Con la mira de manifestar su justicia en este tiempo: para que él sea el justo, y el que justifica al que es de la fe de Jesús.", "words": [[0, 152659], [4, 152779], [7, 152919], [12, 153119], [15, 153279], [26, 153919], [29, 154079], [38, 154679], [41, 154799], [46, 155019], [54, 155934], [59, 156079], [63, 156239], [66, 156399], [70, 156619], [73, 156799], [80, 157159], [82, 157719], [85, 157799], [89, 157899], [99, 158579], [102, 158839], [106, 158999], [109, 159139], [112, 159219], [115, 159339], [118, 159499], [121, 159619]]}, {"verse": 27, "start": 160709, "end": 168385, "text": "¿Dónde pues está la jactancia? Es excluída. ¿Por cuál ley? ¿de las obras? No; sino por la ley de la fe.", "words": [[0, 160709], [7, 161027], [12, 161287], [17, 161627], [20, 161747], [31, 162838], [34, 162969], [44, 164041], [49, 164179], [54, 164359], [59, 165113], [63, 165250], [67, 165370], [74, 166229], [78, 166886], [83, 167111], [87, 167391], [90, 167531], [94, 167751], [97, 167871], [100, 168011]]}, {"verse": 28, "start": 168835, "end": 173115, "text": "Así que, concluímos ser el hombre justificado por fe sin las obras de la ley.", "words": [[0, 168835], [4, 169037], [9, 169177], [20, 169797], [24, 170057], [27, 170177], [34, 170377], [46, 171197], [50, 171397], [53, 171637], [57, 172037], [61, 172237], [67, 172497], [70, 172717], [73, 172837]]}, {"verse": 29, "start": 173565, "end": 179761, "text": "¿Es Dios solamente Dios de los judíos? ¿No es también Dios de los Gentiles? Cierto, también de los Gentiles.", "words": [[0, 173565], [4, 173711], [9, 173911], [19, 174311], [24, 174731], [27, 174891], [31, 175011], [39, 176021], [43, 176160], [46, 176320], [54, 176540], [59, 176800], [62, 176960], [66, 177080], [76, 178121], [84, 178382], [92, 178742], [95, 178922], [99, 179022]]}, {"verse": 30, "start": 180211, "end": 187298, "text": "Porque uno es Dios, el cual justificará por la fe la circuncisión, y por medio de la fe la incircuncisión.", "words": [[0, 180379], [7, 180719], [11, 180979], [14, 181179], [20, 181609], [23, 182039], [28, 182219], [40, 183019], [44, 183159], [47, 183319], [50, 183519], [53, 183659], [67, 184579], [69, 184979], [73, 185179], [79, 185519], [82, 185699], [85, 185839], [88, 186059], [91, 186179]]}, {"verse": 31, "start": 187748, "end": 192832, "text": "¿Luego deshacemos la ley por la fe? En ninguna manera; antes establecemos la ley.", "words": [[0, 187748], [7, 187974], [18, 188614], [21, 188774], [25, 188954], [29, 189154], [32, 189274], [36, 189917], [39, 190063], [47, 190383], [55, 191263], [61, 191583], [74, 192303], [77, 192523]]}]}