{"book": "JHN", "chapter": 14, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 247384, "verses": [{"verse": 1, "start": 300, "end": 4385, "text": "No se turbe vuestro corazón: creéis en Dios, creed también en mí.", "words": [[0, 300], [3, 487], [6, 667], [12, 1147], [20, 1547], [29, 2669], [36, 3568], [39, 3768], [45, 3897], [51, 4026], [59, 4155], [62, 4283]]}, {"verse": 2, "start": 4835, "end": 15006, "text": "En la casa de mi Padre muchas moradas hay: de otra manera os lo hubiera dicho: voy, pues, a preparar lugar para vosotros.", "words": [[0, 6524], [3, 6644], [6, 6784], [11, 7044], [14, 7284], [17, 7424], [23, 7924], [30, 8224], [38, 8762], [43, 9538], [46, 9686], [51, 9866], [58, 10246], [61, 10446], [64, 10626], [72, 10986], [79, 11842], [84, 12027], [90, 12307], [92, 12807], [101, 13467], [107, 13747], [112, 14067]]}, {"verse": 3, "start": 15456, "end": 22739, "text": "Y si me voy, y os preparo lugar, vendré otra vez y los llevaré conmigo. Así ustedes estarán donde yo esté.", "words": [[0, 15456], [2, 15563], [5, 15683], [8, 15843], [13, 16103], [15, 16363], [18, 16463], [26, 16923], [33, 17243], [40, 18043], [45, 18303], [49, 18683], [51, 18953], [55, 19223], [63, 19683], [72, 20701], [76, 21001], [84, 21301], [92, 21901], [98, 22081], [101, 22321]]}, {"verse": 4, "start": 23189, "end": 26633, "text": "Y sabéis a dónde yo voy; y sabéis el camino.", "words": [[0, 23189], [2, 23469], [9, 23776], [11, 24082], [17, 24389], [20, 24589], [25, 25271], [27, 25393], [34, 25833], [37, 25993]]}, {"verse": 5, "start": 27083, "end": 32926, "text": "Le dice Tomás: Señor, no sabemos a dónde vas: ¿cómo, pues, podemos saber el camino?", "words": [[0, 27083], [3, 27235], [8, 27495], [15, 28443], [22, 29085], [25, 29185], [33, 29545], [35, 29825], [41, 29985], [46, 30864], [53, 31060], [59, 31640], [67, 31880], [73, 32200], [76, 32360]]}, {"verse": 6, "start": 33276, "end": 40719, "text": "Jesús le dice: Yo soy el camino, y la verdad, y la vida: nadie viene al Padre, sino por mí.", "words": [[0, 33276], [6, 33609], [9, 33969], [15, 34762], [18, 34971], [22, 35211], [25, 35451], [33, 35971], [35, 36511], [38, 36651], [46, 37011], [48, 37451], [51, 37591], [57, 38399], [63, 38824], [69, 39084], [72, 39304], [79, 39664], [84, 40024], [88, 40324]]}, {"verse": 7, "start": 41169, "end": 48502, "text": "Si me conocieseis, también a mi Padre conocierais: y desde ahora le conocéis, y le habéis visto.", "words": [[0, 41169], [3, 41549], [6, 41979], [19, 42409], [27, 42889], [29, 43189], [32, 43329], [38, 44128], [51, 45201], [53, 45348], [59, 45527], [65, 45908], [68, 46108], [78, 46828], [80, 47388], [83, 47527], [90, 47828]]}, {"verse": 8, "start": 48952, "end": 52825, "text": "Le dice Felipe: Señor, muéstranos el Padre, y nos basta.", "words": [[0, 48952], [3, 49097], [8, 49397], [16, 50542], [23, 50784], [34, 51324], [37, 51484], [44, 52044], [46, 52184], [50, 52284]]}, {"verse": 9, "start": 53175, "end": 64663, "text": "Jesús le dice: ¿Tanto tiempo ha que estoy con vosotros, y no me has conocido, Felipe? El que me ha visto, ha visto al Padre; ¿cómo, pues, dices tú: Muéstranos el Padre?", "words": [[0, 53175], [6, 53509], [9, 53869], [15, 54661], [22, 54923], [29, 55233], [32, 55543], [36, 55643], [42, 55863], [46, 56163], [56, 56703], [58, 56943], [61, 57103], [64, 57263], [68, 57403], [78, 58083], [86, 58992], [89, 59082], [93, 59202], [96, 59342], [99, 59442], [106, 60082], [109, 60262], [115, 60522], [118, 60702], [125, 61606], [132, 61768], [138, 62448], [144, 62788], [148, 63449], [159, 64018], [162, 64118]]}, {"verse": 10, "start": 65113, "end": 76395, "text": "¿No crees que yo soy en el Padre, y el Padre en mí? Las palabras que yo os hablo, no las hablo de mí mismo: pero el Padre que está en mí, él hace las obras.", "words": [[0, 65113], [4, 65222], [10, 65562], [14, 65762], [17, 65962], [21, 66262], [24, 66462], [27, 66582], [34, 67022], [36, 67562], [39, 67702], [45, 68042], [48, 68422], [52, 69106], [56, 69235], [65, 69575], [69, 69895], [72, 70175], [75, 70355], [82, 71015], [85, 71115], [89, 71315], [95, 71715], [98, 71835], [101, 71995], [108, 72943], [113, 73085], [116, 73225], [122, 73645], [126, 73885], [131, 74105], [134, 74305], [138, 74945], [141, 75085], [146, 75485], [150, 75705]]}, {"verse": 11, "start": 76845, "end": 83797, "text": "Creedme que yo soy en el Padre, y el Padre en mí: de otra manera, creedme por las mismas obras.", "words": [[0, 77095], [8, 77345], [12, 77485], [15, 77645], [19, 77885], [22, 78065], [25, 78185], [32, 78625], [34, 79105], [37, 79245], [43, 79565], [46, 79845], [50, 80516], [53, 80606], [58, 80786], [66, 81706], [74, 82206], [78, 82486], [82, 82666], [89, 83066]]}, {"verse": 12, "start": 84247, "end": 94546, "text": "De cierto, de cierto os digo: El que en mí cree, las obras que yo hago también él las hará; y mayores que estas hará; porque yo voy al Padre.", "words": [[0, 84475], [3, 84735], [11, 84995], [14, 85255], [21, 85515], [24, 85715], [30, 86495], [33, 86677], [37, 86877], [40, 87117], [43, 87217], [49, 87597], [53, 88277], [59, 88817], [63, 89077], [66, 89297], [71, 89477], [79, 89897], [82, 90257], [86, 90577], [92, 91321], [94, 91566], [102, 92006], [106, 92206], [112, 92466], [118, 93155], [125, 93360], [128, 93600], [132, 93760], [135, 93940]]}, {"verse": 13, "start": 94996, "end": 102254, "text": "Y todo lo que pidáis al Padre en mi nombre, lo haré, para que el Padre sea glorificado en el Hijo.", "words": [[0, 94996], [2, 95114], [7, 95414], [10, 95714], [14, 95874], [21, 96334], [24, 96554], [30, 97114], [33, 97334], [36, 97534], [44, 98314], [47, 98534], [53, 99034], [58, 99594], [62, 99794], [65, 99954], [71, 100374], [75, 100574], [87, 101514], [90, 101634], [93, 101774]]}, {"verse": 14, "start": 102704, "end": 105715, "text": "Si algo pidáis en mi nombre, yo lo haré.", "words": [[0, 102704], [3, 102904], [8, 103234], [15, 103564], [18, 103804], [21, 104004], [29, 104824], [32, 105064], [35, 105284]]}, {"verse": 15, "start": 106165, "end": 109450, "text": "Si me amáis, guardad mis mandamientos;", "words": [[0, 106250], [3, 106370], [6, 106490], [13, 107510], [21, 108110], [25, 108270]]}, {"verse": 16, "start": 109900, "end": 115884, "text": "Y yo rogaré al Padre, y os dará otro Consolador, para que esté con vosotros para siempre:", "words": [[0, 109900], [2, 109900], [5, 110207], [12, 110847], [15, 110967], [22, 111527], [24, 111947], [27, 112127], [32, 112447], [37, 112787], [49, 113607], [54, 113867], [58, 114047], [63, 114207], [67, 114487], [76, 114947], [81, 115167]]}, {"verse": 17, "start": 116334, "end": 127693, "text": "Al Espíritu de verdad, al cual el mundo no puede recibir, porque no le ve, ni le conoce: pero vosotros le conocéis; porque está con vosotros, y será en vosotros.", "words": [[0, 116334], [3, 116498], [12, 117118], [15, 117218], [23, 117598], [26, 118438], [31, 118678], [34, 118998], [40, 119298], [43, 119598], [49, 119878], [58, 120498], [65, 121078], [68, 121338], [71, 121478], [75, 121698], [78, 122178], [81, 122358], [89, 123374], [94, 123658], [103, 124098], [106, 124298], [116, 125401], [123, 125565], [128, 125765], [132, 125985], [142, 126445], [144, 126605], [149, 126825], [152, 126985]]}, {"verse": 18, "start": 128143, "end": 131832, "text": "No os dejaré huérfanos: vendré a vosotros.", "words": [[0, 128143], [3, 128405], [6, 128525], [13, 128945], [24, 130058], [31, 130503], [33, 130623]]}, {"verse": 19, "start": 132282, "end": 140391, "text": "Aun un poquito, y el mundo no me verá más; pero vosotros me veréis; porque yo vivo, y vosotros también viviréis.", "words": [[0, 132282], [4, 132282], [7, 132489], [16, 132869], [18, 133309], [21, 133449], [27, 133769], [30, 134049], [33, 134209], [38, 134489], [43, 135273], [48, 135414], [57, 135874], [60, 136074], [68, 136926], [75, 137150], [78, 137390], [84, 137690], [86, 138270], [95, 138770], [103, 139210]]}, {"verse": 20, "start": 140841, "end": 147323, "text": "En aquel día vosotros conoceréis que yo estoy en mi Padre, y vosotros en mí, y yo en vosotros.", "words": [[0, 140841], [3, 140990], [9, 141310], [13, 141530], [22, 142090], [33, 142850], [37, 143010], [40, 143190], [46, 143430], [49, 143690], [52, 143850], [59, 144270], [61, 144850], [70, 145330], [73, 145570], [77, 145810], [79, 146190], [82, 146390], [85, 146510]]}, {"verse": 21, "start": 147773, "end": 158962, "text": "El que tiene mis mandamientos, y los guarda, aquel es el que me ama; y el que me ama, será amado de mi Padre, y yo le amaré, y me manifestaré a él.", "words": [[0, 147773], [3, 147901], [7, 148041], [13, 148361], [17, 148581], [31, 149461], [33, 149921], [37, 150061], [45, 150801], [51, 151121], [54, 151341], [57, 151721], [61, 151861], [64, 152021], [69, 152789], [71, 152933], [74, 153033], [78, 153173], [81, 153373], [86, 153613], [91, 154213], [97, 154913], [100, 155073], [103, 155213], [110, 156073], [112, 156173], [115, 156373], [118, 156553], [125, 157413], [127, 157453], [130, 157593], [142, 158393], [144, 158533]]}, {"verse": 22, "start": 159412, "end": 166102, "text": "Le dice Judas, no el Iscariote: Señor, ¿por qué te has de manifestar a nosotros, y no al mundo?", "words": [[0, 159412], [3, 159537], [8, 159797], [15, 160577], [18, 160977], [21, 161417], [32, 162599], [39, 163214], [44, 163314], [48, 163434], [51, 163614], [55, 163734], [58, 163834], [69, 164434], [71, 164514], [81, 164854], [83, 165354], [86, 165494], [89, 165614]]}, {"verse": 23, "start": 166452, "end": 176265, "text": "Respondió Jesús, y le dijo: El que me ama, mi palabra guardará; y mi Padre le amará, y vendremos a él, y haremos con él morada.", "words": [[0, 166452], [10, 167007], [17, 167327], [19, 167587], [22, 167707], [28, 168508], [31, 168652], [35, 168792], [38, 168992], [43, 169612], [46, 169732], [54, 170112], [64, 171318], [66, 171442], [69, 171562], [75, 172042], [78, 172182], [85, 172622], [87, 173062], [97, 173582], [99, 173822], [103, 174102], [105, 174622], [113, 175022], [117, 175342], [120, 175502]]}, {"verse": 24, "start": 176715, "end": 184956, "text": "El que no me ama, no guarda mis palabras: y la palabra que habéis oído, no es mía, sino del Padre que me envió.", "words": [[0, 176715], [3, 176847], [7, 176987], [10, 177167], [13, 177347], [18, 178087], [21, 178327], [28, 178787], [32, 178927], [42, 180132], [44, 180235], [47, 180355], [55, 180695], [59, 180975], [66, 181295], [72, 181675], [75, 181915], [78, 182075], [83, 182755], [88, 183115], [92, 183395], [98, 184055], [102, 184195], [105, 184375]]}, {"verse": 25, "start": 185406, "end": 189018, "text": "Estas cosas os he hablado estando con vosotros.", "words": [[0, 185406], [6, 185891], [12, 186251], [15, 186631], [18, 186911], [26, 187491], [34, 187931], [38, 188171]]}, {"verse": 26, "start": 189468, "end": 201568, "text": "Pero el Consolador, el Espíritu Santo, al cual el Padre enviará en mi nombre, él os enseñará todas las cosas, y os recordará todas las cosas que os he dicho.", "words": [[0, 189468], [5, 189652], [8, 189792], [20, 190792], [23, 190912], [32, 191532], [39, 192492], [42, 192632], [47, 192812], [50, 192992], [56, 193632], [64, 194312], [67, 194492], [70, 194652], [78, 195692], [81, 195952], [84, 196272], [93, 197052], [99, 197332], [103, 197632], [110, 198052], [112, 198692], [115, 198812], [125, 199552], [131, 199872], [135, 200152], [141, 200512], [145, 200752], [148, 200932], [151, 201052]]}, {"verse": 27, "start": 202018, "end": 210998, "text": "La paz os dejo, mi paz os doy: no como el mundo la da, yo os la doy. No se turbe vuestro corazón, ni tenga miedo.", "words": [[0, 202018], [3, 202142], [7, 202362], [10, 202522], [16, 203402], [19, 203662], [23, 203962], [26, 204102], [31, 204875], [34, 205061], [39, 205301], [42, 205481], [48, 205761], [51, 205981], [55, 206601], [58, 206901], [61, 207061], [64, 207221], [69, 207951], [72, 208098], [75, 208238], [81, 208698], [89, 209078], [98, 209578], [101, 210058], [107, 210378]]}, {"verse": 28, "start": 211448, "end": 224135, "text": "Habéis oído cómo yo os he dicho: Voy, y vengo a vosotros. Si me amaseis, ciertamente os gozaríais, porque he dicho que voy al Padre: porque el Padre mayor es que yo.", "words": [[0, 211448], [7, 211772], [12, 212112], [17, 212412], [20, 212625], [23, 212839], [26, 213052], [33, 214224], [38, 214609], [40, 215169], [46, 215449], [48, 215549], [58, 216584], [61, 216769], [64, 216989], [73, 217689], [85, 218329], [88, 218549], [99, 219689], [106, 219949], [109, 220209], [115, 220529], [119, 220729], [123, 220909], [126, 221089], [133, 222094], [140, 222434], [143, 222594], [149, 223014], [155, 223306], [158, 223599], [162, 223891]]}, {"verse": 29, "start": 224585, "end": 230552, "text": "Y ahora os lo he dicho antes que se haga; para que cuando se haga, creáis.", "words": [[0, 224585], [2, 224926], [8, 225186], [11, 225486], [14, 225646], [17, 225746], [23, 226026], [29, 226426], [33, 226626], [36, 226806], [42, 227619], [47, 227784], [51, 227924], [58, 228184], [61, 228524], [67, 229284]]}, {"verse": 30, "start": 231002, "end": 237922, "text": "Ya no hablaré mucho con vosotros: porque viene el príncipe de este mundo; pero no tiene nada en mí.", "words": [[0, 231002], [3, 231145], [6, 231325], [14, 231705], [20, 232005], [24, 232285], [34, 233418], [41, 233602], [47, 233922], [50, 234202], [59, 234922], [62, 235122], [67, 235322], [74, 236308], [79, 236452], [82, 236652], [88, 236892], [93, 237212], [96, 237472]]}, {"verse": 31, "start": 238372, "end": 246984, "text": "Pero para que conozca el mundo que amo al Padre, y como el Padre me dio el mandamiento, así hago. Levantaos, vamos de aquí.", "words": [[0, 238372], [5, 238556], [10, 239076], [14, 239256], [22, 239796], [25, 239916], [31, 240196], [35, 240476], [39, 240776], [42, 240956], [49, 241556], [51, 241736], [56, 241976], [59, 242136], [65, 242676], [68, 242816], [72, 243036], [75, 243196], [88, 243876], [92, 244236], [98, 245145], [109, 246093], [115, 246353], [118, 246513]]}]}