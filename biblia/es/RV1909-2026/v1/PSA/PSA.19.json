{"book": "PSA", "chapter": 19, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 106605, "verses": [{"verse": 1, "start": 300, "end": 8693, "text": "Al Músico principal: Salmo de David. LOS cielos cuentan la gloria de Dios, y la expansión denuncia la obra de sus manos.", "words": [[0, 300], [3, 465], [10, 885], [21, 1948], [27, 2467], [30, 2607], [37, 3352], [41, 3479], [48, 4079], [56, 4559], [59, 4739], [66, 5139], [69, 5279], [75, 5559], [77, 5819], [80, 5959], [90, 6659], [99, 7299], [102, 7479], [107, 7739], [110, 7919], [114, 8059]]}, {"verse": 2, "start": 9143, "end": 15599, "text": "El un día emite palabra al otro día, y la una noche a la otra noche declara sabiduría.", "words": [[0, 9143], [3, 9292], [6, 9432], [10, 9672], [16, 10172], [24, 10652], [27, 10952], [32, 11172], [37, 11972], [39, 12252], [42, 12372], [46, 12532], [52, 12872], [54, 13172], [57, 13272], [62, 13472], [68, 13892], [76, 14632]]}, {"verse": 3, "start": 16049, "end": 19601, "text": "No hay dicho, ni palabras, ni es oída su voz.", "words": [[0, 16049], [3, 16195], [7, 16335], [14, 16615], [17, 16795], [27, 17775], [30, 18095], [33, 18295], [38, 18755], [41, 18995]]}, {"verse": 4, "start": 20051, "end": 27900, "text": "Por toda la tierra salió su hilo, y al cabo del mundo sus palabras. En ellos puso tabernáculo para el sol.", "words": [[0, 20051], [4, 20175], [9, 20435], [12, 20655], [19, 20955], [25, 21495], [28, 21715], [34, 22355], [36, 22515], [39, 22675], [44, 22915], [48, 23155], [54, 23395], [58, 23675], [68, 24907], [71, 25074], [77, 25394], [82, 26154], [94, 26934], [99, 27254], [102, 27434]]}, {"verse": 5, "start": 28350, "end": 34815, "text": "Y él, como un novio que sale de su habitación nupcial, se alegra cual gigante para correr el camino.", "words": [[0, 28350], [2, 28534], [6, 28834], [11, 28994], [14, 29214], [20, 29694], [24, 29814], [29, 30094], [32, 30294], [35, 30474], [46, 31054], [55, 31894], [58, 32074], [65, 32404], [70, 32734], [78, 33354], [83, 33574], [90, 33914], [93, 34194]]}, {"verse": 6, "start": 35265, "end": 44188, "text": "De un extremo de los cielos es su salida, y su giro hasta la extremidad de ellos: y no hay quien se esconda de su calor.", "words": [[0, 35265], [3, 35431], [6, 35631], [14, 36431], [17, 36511], [21, 36671], [28, 37211], [31, 37411], [34, 37631], [42, 38211], [44, 38631], [47, 38811], [52, 39291], [58, 39591], [61, 39831], [72, 40571], [75, 40791], [82, 41602], [84, 41738], [87, 41938], [91, 42238], [97, 42498], [100, 42718], [108, 43278], [111, 43418], [114, 43598]]}, {"verse": 7, "start": 44638, "end": 51381, "text": "La ley de Jehová es perfecta, que vuelve el alma: el testimonio de Jehová, fiel, que hace sabio al pequeño.", "words": [[0, 44638], [3, 44744], [7, 44944], [10, 45104], [17, 45484], [20, 45564], [30, 46364], [34, 46444], [41, 46804], [44, 46984], [50, 47783], [53, 47930], [64, 48530], [67, 48630], [75, 49190], [81, 49770], [85, 49850], [90, 50030], [96, 50550], [99, 50670]]}, {"verse": 8, "start": 51831, "end": 59492, "text": "Los mandamientos de Jehová son rectos, que alegran el corazón: el precepto de Jehová, puro, que alumbra los ojos.", "words": [[0, 51831], [4, 51932], [17, 52572], [20, 52752], [27, 53152], [31, 53272], [39, 54012], [43, 54292], [51, 54852], [54, 55152], [63, 56247], [66, 56389], [75, 57109], [78, 57189], [86, 57789], [92, 58049], [96, 58209], [104, 58649], [108, 58809]]}, {"verse": 9, "start": 59942, "end": 66564, "text": "El temor de Jehová, limpio, que permanece para siempre; los juicios de Jehová son verdad, todos justos.", "words": [[0, 59942], [3, 60089], [9, 60469], [12, 60609], [20, 61029], [28, 61609], [32, 61729], [42, 62289], [47, 62489], [56, 63491], [60, 63743], [68, 64103], [71, 64283], [78, 64703], [82, 64783], [90, 65503], [96, 65823]]}, {"verse": 10, "start": 67014, "end": 74986, "text": "Deseables son más que el oro, y más que mucho oro afinado; y dulces más que miel, y que la que destila del panal.", "words": [[0, 67014], [10, 67639], [14, 67939], [18, 68179], [22, 68399], [25, 68599], [30, 68819], [32, 68999], [36, 69179], [40, 69319], [46, 69659], [50, 70099], [59, 71248], [61, 71375], [68, 71735], [72, 71955], [76, 72135], [82, 72555], [84, 73195], [88, 73335], [91, 73475], [95, 73615], [103, 74115], [107, 74275]]}, {"verse": 11, "start": 75436, "end": 80902, "text": "Tu siervo es además amonestado con ellos: en guardarlos hay grande recompensa.", "words": [[0, 75436], [3, 75540], [10, 76020], [13, 76200], [20, 76520], [31, 77440], [35, 77700], [42, 78652], [45, 78993], [56, 79373], [60, 79553], [67, 79853]]}, {"verse": 12, "start": 81352, "end": 86545, "text": "Los errores, ¿quién los entenderá? Líbrame de los que me son ocultos.", "words": [[0, 81352], [4, 81478], [13, 82598], [20, 82938], [24, 83078], [35, 84717], [43, 85127], [46, 85427], [50, 85567], [54, 85707], [57, 85847], [61, 86027]]}, {"verse": 13, "start": 86995, "end": 97422, "text": "Detén asimismo a tu siervo de las soberbias; no permitas que me dominen: entonces seré íntegro, y estaré limpio de gran rebelión.", "words": [[0, 87796], [6, 88236], [15, 88676], [17, 88836], [20, 88936], [27, 89436], [30, 89576], [34, 89736], [45, 90960], [48, 91280], [57, 91980], [61, 92120], [64, 92260], [73, 93276], [82, 93738], [87, 94198], [96, 95118], [98, 95298], [105, 95658], [112, 96178], [115, 96278], [120, 96518]]}, {"verse": 14, "start": 97872, "end": 106205, "text": "Sean gratos los dichos de mi boca y la meditación de mi corazón delante de ti, oh Jehová, roca mía, y redentor mío.", "words": [[0, 97872], [5, 98508], [12, 99178], [16, 99278], [23, 99638], [26, 99718], [29, 99838], [34, 100158], [36, 100598], [39, 100738], [50, 101458], [53, 101658], [56, 101758], [64, 102198], [72, 102758], [75, 102938], [79, 103158], [82, 103378], [90, 103845], [95, 104312], [100, 104778], [102, 105272], [111, 105766]]}]}