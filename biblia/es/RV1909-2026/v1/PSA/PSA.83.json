{"book": "PSA", "chapter": 83, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 108784, "verses": [{"verse": 1, "start": 300, "end": 7358, "text": "Canción: Salmo de Asaf. OH Dios, no tengas silencio: no calles, oh Dios, ni te estés quieto.", "words": [[0, 300], [9, 1377], [15, 1819], [18, 1999], [24, 2697], [27, 2777], [33, 3017], [36, 3327], [43, 3637], [53, 4773], [56, 5053], [64, 5363], [67, 5673], [73, 6273], [76, 6413], [79, 6553], [85, 6853]]}, {"verse": 2, "start": 7708, "end": 13154, "text": "Porque he aquí que rugen tus enemigos; y tus aborrecedores han alzado cabeza.", "words": [[0, 7764], [7, 7924], [10, 8204], [15, 8544], [19, 8854], [25, 9164], [29, 9404], [39, 10419], [41, 10619], [45, 11129], [59, 11639], [63, 11899], [70, 12399]]}, {"verse": 3, "start": 13504, "end": 20729, "text": "Sobre tu pueblo han consultado astuta y secretamente, y han entrado en consejo contra tus escondidos.", "words": [[0, 13504], [6, 13805], [9, 14025], [16, 14465], [20, 14725], [31, 15505], [38, 16005], [40, 16125], [54, 16885], [56, 17485], [60, 17645], [68, 18285], [71, 18445], [79, 19145], [86, 19525], [90, 19785]]}, {"verse": 4, "start": 21079, "end": 26888, "text": "Han dicho: Venid, y cortémoslos de ser pueblo, y no haya más memoria del nombre de Israel.", "words": [[0, 21336], [4, 21592], [11, 22022], [18, 22386], [20, 22836], [32, 23286], [35, 23486], [39, 23666], [47, 24466], [49, 24626], [52, 24746], [57, 24966], [61, 25206], [69, 25706], [73, 25886], [80, 26186], [83, 26366]]}, {"verse": 5, "start": 27168, "end": 32326, "text": "Por esto han conspirado de corazón a una, contra ti han hecho liga;", "words": [[0, 27168], [4, 27310], [9, 27610], [13, 28090], [24, 28910], [27, 29070], [35, 29510], [37, 29890], [42, 30470], [49, 31010], [52, 31170], [56, 31430], [62, 31650]]}, {"verse": 6, "start": 32676, "end": 38304, "text": "Las tiendas de los edomitas y de los ismaelitas, Moab y los agarenos;", "words": [[0, 32676], [4, 32801], [12, 33261], [15, 33361], [19, 33501], [28, 34101], [30, 34301], [33, 34401], [37, 34561], [49, 35661], [54, 36321], [56, 36486], [60, 37421]]}, {"verse": 7, "start": 38654, "end": 43174, "text": "Gebal, y Amón, y Amalec; los filisteos con los habitantes de Tiro.", "words": [[0, 38929], [7, 39239], [9, 39512], [15, 39785], [17, 40059], [25, 40492], [29, 40632], [39, 41472], [43, 41752], [47, 41872], [58, 42512], [61, 42652]]}, {"verse": 8, "start": 43524, "end": 51370, "text": "También el Assur se ha juntado con ellos: son por brazo a los hijos de Lot. (Selah.)", "words": [[0, 43524], [8, 43868], [11, 44328], [17, 44788], [20, 45248], [23, 45348], [31, 45908], [35, 46148], [42, 46900], [46, 47284], [50, 47524], [56, 48104], [58, 48324], [62, 48464], [68, 48764], [71, 49004], [76, 49667]]}, {"verse": 9, "start": 51720, "end": 57286, "text": "Hazles como a Madián; como a Sísara, como a Jabín en el arroyo de Cisón;", "words": [[0, 51720], [7, 51720], [12, 51941], [14, 52781], [22, 53802], [27, 53990], [29, 54300], [37, 54610], [42, 54930], [44, 55260], [50, 55590], [53, 55870], [56, 56180], [63, 56490], [66, 56670]]}, {"verse": 10, "start": 57636, "end": 62182, "text": "Que perecieron en Endor, fueron hechos estiércol para la tierra.", "words": [[0, 57636], [4, 58069], [15, 58539], [18, 58839], [25, 59279], [32, 59799], [39, 60259], [49, 61019], [54, 61319], [57, 61479]]}, {"verse": 11, "start": 62532, "end": 71541, "text": "Pon a ellos y a sus capitanes como a Oreb y como a Zeeb; y como a Zeba y como a Zalmuna, a todos sus príncipes;", "words": [[0, 62617], [4, 62737], [6, 62877], [12, 63237], [14, 63537], [16, 63677], [20, 63837], [30, 64677], [35, 64897], [37, 65177], [42, 65577], [44, 66037], [49, 66337], [51, 66803], [57, 67433], [59, 67540], [64, 67800], [66, 68100], [71, 68400], [73, 68540], [78, 68760], [80, 69260], [89, 69760], [91, 69880], [97, 70160], [101, 70560]]}, {"verse": 12, "start": 71891, "end": 75460, "text": "Que han dicho: Heredemos para nosotros las moradas de Dios.", "words": [[0, 71891], [4, 72013], [8, 72133], [15, 72805], [25, 73288], [30, 73528], [39, 73988], [43, 74248], [51, 74728], [54, 74928]]}, {"verse": 13, "start": 75740, "end": 81192, "text": "Dios mío, ponlos como a torbellinos; como a hojarascas delante del viento.", "words": [[0, 75740], [5, 75948], [10, 76428], [17, 76908], [22, 77494], [24, 78080], [37, 78827], [42, 79032], [44, 79462], [55, 79892], [63, 80332], [67, 80572]]}, {"verse": 14, "start": 81542, "end": 85787, "text": "Como fuego que quema el monte, como llama que abrasa las breñas.", "words": [[0, 81542], [5, 81707], [11, 82027], [15, 82307], [21, 82567], [24, 82707], [31, 83667], [36, 83827], [42, 84107], [46, 84457], [53, 84807], [57, 84947]]}, {"verse": 15, "start": 86137, "end": 90863, "text": "Persíguelos así con tu tempestad, y asómbralos con tu torbellino.", "words": [[0, 86137], [12, 87161], [16, 87461], [20, 87701], [23, 88131], [34, 88561], [36, 88981], [47, 89741], [51, 89921], [54, 90406]]}, {"verse": 16, "start": 91213, "end": 96154, "text": "Llena sus rostros de vergüenza; y busquen tu nombre, oh Jehová.", "words": [[0, 91213], [6, 91639], [10, 91839], [18, 92519], [21, 92699], [32, 93864], [34, 93988], [42, 94488], [45, 94668], [53, 95068], [56, 95468]]}, {"verse": 17, "start": 96504, "end": 102273, "text": "Sean afrentados y turbados para siempre; y sean deshonrados, y perezcan.", "words": [[0, 96504], [5, 96864], [16, 97724], [18, 97924], [27, 98464], [32, 98724], [41, 99826], [43, 99951], [48, 100211], [61, 101151], [63, 101371]]}, {"verse": 18, "start": 102623, "end": 108384, "text": "Y conozcan que tu nombre es JEHOVÁ; tú solo Altísimo sobre toda la tierra.", "words": [[0, 102623], [2, 102874], [11, 103474], [15, 103654], [18, 103814], [25, 104134], [28, 104534], [36, 105638], [39, 105743], [44, 106043], [53, 106763], [59, 107123], [64, 107423], [67, 107683]]}]}