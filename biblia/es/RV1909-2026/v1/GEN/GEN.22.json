{"book": "GEN", "chapter": 22, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 234988, "verses": [{"verse": 1, "start": 300, "end": 11479, "text": "Y aconteció después de estas cosas, que Dios puso a prueba a Abraham, y le dijo: Abraham. Y él respondió: Aquí estoy.", "words": [[0, 300], [2, 462], [12, 1242], [20, 1562], [23, 1822], [29, 2002], [36, 3142], [40, 3402], [45, 3602], [50, 4042], [52, 4162], [59, 4462], [61, 4882], [70, 5382], [72, 5942], [75, 6062], [81, 6842], [90, 8672], [92, 8839], [95, 8999], [106, 10096], [111, 10319]]}, {"verse": 2, "start": 11829, "end": 23020, "text": "Y dijo: Toma ahora tu hijo, tu único, Isaac, a quien amas, y vete a tierra de Moriah, y ofrécelo allí en holocausto sobre uno de los montes que yo te diré.", "words": [[0, 11829], [2, 11978], [8, 12822], [13, 13136], [19, 13316], [22, 13536], [28, 14176], [31, 14256], [38, 14896], [45, 15596], [47, 15656], [53, 15816], [59, 16696], [61, 16756], [66, 16996], [68, 17116], [75, 17376], [78, 17856], [86, 18336], [88, 18636], [97, 18936], [102, 19216], [105, 19376], [116, 19956], [122, 20256], [126, 20516], [129, 20636], [133, 20776], [140, 21256], [144, 21376], [147, 21516], [150, 21636]]}, {"verse": 3, "start": 23370, "end": 37540, "text": "Y Abraham se levantó muy de mañana, y aparejó su asno, y tomó consigo dos siervos suyos, y a Isaac su hijo: y cortó leña para el holocausto, y se levantó, y fue al lugar que Dios le dijo.", "words": [[0, 23370], [2, 23495], [10, 23855], [13, 24215], [21, 24775], [25, 24995], [28, 25135], [36, 25535], [38, 25835], [46, 26375], [49, 26555], [55, 27095], [57, 27655], [62, 27935], [70, 28335], [74, 28735], [82, 29215], [89, 29995], [91, 30125], [93, 30255], [99, 31135], [102, 31315], [108, 32049], [110, 32155], [116, 32595], [121, 32975], [126, 33255], [129, 33415], [141, 34055], [143, 34215], [146, 34295], [155, 35175], [157, 35455], [161, 35655], [164, 35955], [170, 36315], [174, 36555], [179, 36775], [182, 36975]]}, {"verse": 4, "start": 37990, "end": 43325, "text": "Al tercer día alzó Abraham sus ojos, y vio el lugar de lejos.", "words": [[0, 37990], [3, 38346], [10, 38626], [14, 39386], [19, 39866], [27, 40286], [31, 40566], [37, 40966], [39, 41566], [43, 41866], [46, 42146], [52, 42466], [55, 42666]]}, {"verse": 5, "start": 43775, "end": 53626, "text": "Entonces dijo Abraham a sus siervos: Esperad aquí con el asno, y yo y el muchacho iremos hasta allí, y adoraremos, y volveremos a vosotros.", "words": [[0, 43775], [9, 44352], [14, 44932], [22, 45532], [24, 45912], [28, 46052], [37, 47135], [45, 47613], [50, 47833], [54, 48033], [57, 48193], [63, 48553], [65, 48993], [68, 49233], [70, 49373], [73, 49453], [82, 49913], [89, 50313], [95, 50513], [101, 50833], [103, 51413], [115, 51933], [117, 52313], [128, 52853], [130, 52953]]}, {"verse": 6, "start": 53976, "end": 64321, "text": "Y tomó Abraham la leña del holocausto, y la puso sobre Isaac su hijo: y él tomó en su mano el fuego y el cuchillo; y fueron ambos juntos.", "words": [[0, 53976], [2, 54104], [7, 54504], [15, 55144], [18, 55544], [23, 55904], [27, 56104], [39, 56844], [41, 57284], [44, 57424], [49, 57784], [55, 58104], [61, 58544], [64, 58984], [70, 59746], [72, 59954], [75, 60074], [80, 60474], [83, 60554], [86, 60734], [91, 60974], [94, 61134], [100, 61474], [102, 61714], [105, 61834], [115, 62891], [117, 62988], [124, 63208], [130, 63528]]}, {"verse": 7, "start": 64771, "end": 82000, "text": "Entonces habló Isaac a Abraham su padre, y dijo: Padre mío. Y él respondió: Aquí estoy, mi hijo. Y él dijo: He aquí el fuego y la leña; mas ¿dónde está el cordero para el holocausto?", "words": [[0, 64771], [9, 65295], [15, 66015], [21, 66295], [23, 66835], [31, 67215], [34, 67515], [41, 67955], [43, 68615], [49, 69393], [55, 69672], [60, 70385], [62, 70552], [65, 70712], [76, 71809], [81, 72050], [88, 72510], [91, 72610], [97, 76640], [99, 76828], [102, 76988], [108, 77757], [111, 77899], [116, 78139], [119, 78279], [125, 78559], [127, 78779], [130, 78879], [136, 79650], [140, 79854], [147, 80034], [152, 80374], [155, 80514], [163, 80954], [168, 81174], [171, 81314]]}, {"verse": 8, "start": 82350, "end": 92875, "text": "Y respondió Abraham: Dios se proveerá de cordero para el holocausto, hijo mío. E iban juntos.", "words": [[0, 82350], [2, 82474], [12, 83134], [21, 84226], [26, 84493], [29, 84853], [38, 85213], [41, 85353], [49, 85773], [54, 86053], [57, 86213], [69, 87073], [74, 87213], [79, 91423], [81, 91607], [86, 91947]]}, {"verse": 9, "start": 93325, "end": 106125, "text": "Y cuando llegaron al lugar que Dios le había dicho, edificó allí Abraham un altar, y compuso la leña, y ató a Isaac su hijo, y lo puso en el altar sobre la leña.", "words": [[0, 93325], [2, 93413], [9, 93613], [18, 94233], [21, 94513], [27, 94913], [31, 95173], [36, 95453], [39, 95653], [45, 95893], [52, 96713], [60, 97433], [65, 97733], [73, 98293], [76, 98753], [83, 99193], [85, 99693], [93, 100153], [96, 100333], [102, 100813], [104, 101293], [108, 101673], [110, 101893], [116, 102333], [119, 102753], [125, 103602], [127, 103725], [130, 103845], [135, 104225], [138, 104365], [141, 104505], [147, 104865], [153, 105245], [156, 105485]]}, {"verse": 10, "start": 106575, "end": 112829, "text": "Y extendió Abraham su mano, y tomó el cuchillo, para degollar a su hijo.", "words": [[0, 106575], [2, 106931], [11, 107751], [19, 108371], [22, 108771], [28, 109171], [30, 109731], [35, 110071], [38, 110151], [48, 110751], [53, 111421], [62, 112091], [64, 112191], [67, 112371]]}, {"verse": 11, "start": 113279, "end": 122595, "text": "Entonces el ángel de Jehová le dio voces del cielo, y dijo: Abraham, Abraham. Y él respondió: Aquí estoy.", "words": [[0, 113279], [9, 113883], [12, 114503], [18, 114923], [21, 115063], [28, 115523], [31, 115583], [35, 115843], [41, 116343], [45, 116563], [52, 117003], [54, 117183], [60, 118488], [69, 119055], [78, 119852], [80, 120021], [83, 120141], [94, 121213], [99, 121436]]}, {"verse"