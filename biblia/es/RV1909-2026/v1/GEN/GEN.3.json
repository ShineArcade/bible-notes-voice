{"book": "GEN", "chapter": 3, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 227839, "verses": [{"verse": 1, "start": 300, "end": 12379, "text": "Pero la serpiente era astuta, más que todos los animales del campo que Jehová Dios había hecho; la cual dijo a la mujer: ¿Conque Dios os ha dicho: No comáis de todo árbol del huerto?", "words": [[0, 300], [5, 462], [8, 602], [18, 1202], [22, 1482], [30, 2522], [34, 2842], [38, 3022], [44, 3242], [48, 3502], [57, 3962], [61, 4222], [67, 4622], [71, 4842], [78, 5282], [83, 5422], [89, 5842], [96, 6840], [99, 6979], [104, 7199], [109, 7659], [111, 7819], [114, 7859], [121, 8839], [129, 8999], [134, 9239], [137, 9419], [140, 9539], [147, 10254], [150, 10420], [157, 10620], [160, 10820], [165, 11080], [171, 11480], [175, 11640]]}, {"verse": 2, "start": 12729, "end": 17832, "text": "Y la mujer respondió a la serpiente: Del fruto de los árboles del huerto comemos;", "words": [[0, 12729], [2, 12850], [5, 12950], [11, 13290], [21, 13890], [23, 13990], [26, 14050], [37, 15127], [41, 15292], [47, 15752], [50, 15892], [54, 16012], [62, 16512], [66, 16752], [73, 17072]]}, {"verse": 3, "start": 18282, "end": 25298, "text": "Pero del fruto del árbol que está en medio del huerto dijo Dios: No comeréis de él, ni le tocaréis, para que no muráis.", "words": [[0, 18282], [5, 18414], [9, 18594], [15, 18954], [19, 19134], [25, 19474], [29, 19614], [34, 19834], [37, 20014], [43, 20234], [47, 20434], [54, 20774], [59, 21034], [65, 21997], [68, 22164], [77, 22704], [80, 22904], [84, 23104], [87, 23344], [90, 23504], [100, 24084], [105, 24404], [109, 24544], [112, 24664]]}, {"verse": 4, "start": 25648, "end": 29549, "text": "Entonces la serpiente dijo a la mujer: No moriréis;", "words": [[0, 25648], [9, 26154], [12, 26634], [22, 27194], [27, 27514], [29, 27674], [32, 27734], [39, 28480], [42, 28760]]}, {"verse": 5, "start": 29999, "end": 36859, "text": "Mas sabe Dios que el día que comáis de él, serán abiertos vuestros ojos, y seréis como dioses sabiendo el bien y el mal.", "words": [[0, 29999], [4, 30197], [9, 30417], [14, 30717], [18, 31037], [21, 31177], [25, 31357], [29, 31517], [36, 31897], [39, 32057], [43, 32237], [49, 32597], [58, 33097], [67, 33477], [73, 33757], [75, 34237], [82, 34597], [87, 34797], [94, 35217], [103, 35757], [106, 35877], [111, 36137], [113, 36437], [116, 36557]]}, {"verse": 6, "start": 37209, "end": 52687, "text": "Y vio la mujer que el árbol era bueno para comer, y que era agradable a los ojos, y árbol codiciable para alcanzar la sabiduría; y tomó de su fruto, y comió; y dio también a su marido, el cual comió así como ella.", "words": [[0, 37209], [2, 37333], [6, 37553], [9, 37673], [15, 37993], [19, 38273], [22, 38473], [28, 38853], [32, 39133], [38, 39433], [43, 39713], [50, 40133], [52, 40593], [56, 40753], [60, 41033], [70, 41893], [72, 42013], [76, 42153], [82, 42493], [84, 43013], [90, 43393], [101, 44233], [106, 44573], [115, 45373], [118, 45473], [129, 46710], [131, 47020], [136, 47360], [139, 47440], [142, 47600], [149, 48020], [151, 48140], [158, 48978], [160, 49140], [164, 49280], [172, 49680], [174, 49840], [177, 49940], [185, 50820], [188, 50980], [193, 51160], [199, 51660], [203, 51920], [208, 52200]]}, {"verse": 7, "start": 53137, "end": 62194, "text": "Y fueron abiertos los ojos de ambos, y conocieron que estaban desnudos: entonces cosieron hojas de higuera, y se hicieron delantales.", "words": [[0, 53137], [2, 53225], [9, 53405], [18, 53965], [22, 54105], [27, 54405], [30, 54605], [37, 54945], [39, 55425], [50, 56045], [54, 56205], [62, 56525], [72, 57898], [81, 58379], [90, 58999], [96, 59319], [99, 59459], [108, 59919], [110, 60519], [113, 60659], [122, 61119]]}, {"verse": 8, "start": 62644, "end": 75363, "text": "Y oyeron la voz de Jehová Dios que se paseaba en el huerto al aire del día: y se escondió el hombre y su mujer de la presencia de Jehová Dios entre los árboles del huerto.", "words": [[0, 62644], [2, 62787], [9, 63287], [12, 63447], [16, 63727], [19, 63927], [26, 64467], [31, 65147], [35, 65307], [38, 65487], [46, 66247], [49, 66587], [52, 66747], [59, 67207], [62, 67607], [67, 67907], [71, 68187], [76, 69025], [78, 69189], [81, 69309], [90, 69989], [93, 70129], [100, 70429], [102, 70629], [105, 70749], [111, 71129], [114, 71269], [117, 71409], [127, 72049], [130, 72209], [137, 72909], [142, 73269], [148, 73749], [152, 74009], [160, 74509], [164, 74709]]}, {"verse": 9, "start": 75813, "end": 81365, "text": "Y llamó Jehová Dios al hombre, y le dijo: ¿Dónde estás tú?", "words": [[0, 75813], [2, 75923], [8, 76310], [15, 76696], [20, 77083], [23, 77343], [31, 77703], [33, 78203], [36, 78323], [42, 79121], [49, 79401], [55, 79641]]}, {"verse": 10, "start": 81715, "end": 87596, "text": "Y él respondió: Oí tu voz en el huerto, y tuve miedo, porque estaba desnudo; y me escondí.", "words": [[0, 81715], [2, 81897], [5, 82037], [16, 83082], [19, 83407], [22, 83507], [26, 83787], [29, 84067], [32, 84167], [40, 84527], [42, 84727], [47, 84967], [54, 85287], [61, 85587], [68, 85927], [77, 86877], [79, 86984], [82, 87044]]}, {"verse": 11, "start": 87946, "end": 94991, "text": "Y le dijo: ¿Quién te enseñó que estabas desnudo? ¿Has comido del árbol de que yo te mandé no comieses?", "words": [[0, 87946], [2, 88068], [5, 88168], [11, 88932], [18, 89217], [21, 89297], [28, 89797], [32, 89937], [40, 90377], [49, 91616], [54, 91835], [61, 92235], [65, 92475], [71, 92835], [74, 92995], [78, 93095], [81, 93255], [84, 93355], [90, 93795], [93, 93875]]}, {"verse": 12, "start": 95341, "end": 101334, "text": "Y el hombre respondió: La mujer que me diste por compañera me dio del árbol, y yo comí.", "words": [[0, 95341], [2, 95482], [5, 95582], [12, 95882], [23, 97189], [26, 97288], [32, 97528], [36, 97748], [39, 97868], [45, 98208], [49, 98368], [59, 98988], [62, 99148], [66, 99288], [70, 99428], [77, 99868], [79, 100108], [82, 100248]]}, {"verse": 13, "start": 101684, "end": 111764, "text": "Entonces Jehová Dios dijo a la mujer: ¿Qué es lo que has hecho? Y dijo la mujer: La serpiente me engañó, y comí.", "words": [[0, 101684], [9, 102209], [16, 103169], [21, 103489], [26, 104169], [28, 104329], [31, 104409], [38, 105238], [43, 105394], [46, 105674], [49, 105794], [53, 105934], [57, 106114], [64, 108026], [66, 108144], [71, 108424], [74, 108584], [81, 109401], [84, 109548], [94, 110148], [97, 110328], [105, 110968], [107, 111248]]}, {"verse": 14, "start": 112114, "end": 127151, "text": "Y Jehová Dios dijo a la serpiente: Por cuanto esto hiciste, maldita serás entre todas las bestias y entre todos los animales del campo; sobre tu pecho andarás, y polvo comerás todos los días de tu vida:", "words": [[0, 112114], [2, 112281], [9, 112821], [14, 113061], [19, 113921], [21, 114101], [24, 114161], [35, 115333], [39, 115471], [46, 115711], [51, 116131], [60, 117071], [68, 117591], [74, 118111], [80, 118471], [86, 118771], [90, 119031], [98, 119611], [100, 119871], [106, 120071], [112, 120411], [116, 120651], [125, 121031], [129, 121311], [136, 122473], [142, 122696], [145, 122876], [151, 123296], [160, 123896], [162, 124256], [168, 124696], [176, 125216], [182, 125476], [186, 125836], [191, 126096], [194, 126316], [197, 126416]]}, {"verse": 15, "start": 127601, "end": 137535, "text": "Y enemistad pondré entre ti y la mujer, y entre tu simiente y la simiente suya; esta te herirá en la cabeza, y tú le herirás en el talón.", "words": [[0, 127601], [2, 127761], [12, 128401], [19, 128861], [25, 129121], [28, 129461], [30, 129701], [33, 129801], [40, 130541], [42, 130721], [48, 130921], [51, 131101], [60, 131701], [62, 132021], [65, 132141], [74, 132641], [80, 133785], [85, 134085], [88, 134345], [95, 134725], [98, 134825], [101, 134905], [109, 135365], [111, 135785], [114, 135925], [117, 136125], [125, 136525], [128, 136685], [131, 136805]]}, {"verse": 16, "start": 137885, "end": 149219, "text": "A la mujer dijo: Multiplicaré en gran manera tus dolores y tus embarazos; con dolor darás a luz a tus hijos; y a tu marido será tu deseo, y él te dominará.", "words": [[0, 137885], [2, 137994], [5, 138094], [11, 138374], [17, 139407], [30, 140146], [33, 140286], [38, 140446], [45, 140846], [49, 141066], [57, 141646], [59, 141846], [63, 141986], [74, 143408], [78, 143529], [84, 143909], [90, 144409], [92, 144489], [96, 144589], [98, 144749], [102, 144889], [109, 146040], [111, 146143], [113, 146183], [116, 146283], [123, 146683], [128, 146923], [131, 147103], [138, 147963], [140, 148043], [143, 148163], [146, 148323]]}, {"verse": 17, "start": 149569, "end": 164725, "text": "Y al hombre dijo: Por cuanto obedeciste a la voz de tu mujer, y comiste del árbol de que te mandé diciendo, No comerás de él; maldita será la tierra por tu causa; con dolor comerás de ella todos los días de tu vida;", "words": [[0, 149569], [2, 149690], [5, 149830], [12, 150150], [18, 151102], [22, 151241], [29, 151851], [40, 152461], [42, 152601], [45, 152681], [49, 152941], [52, 153081], [55, 153201], [62, 153601], [64, 154081], [72, 154541], [76, 154801], [82, 155141], [85, 155261], [89, 155361], [92, 155501], [98, 155881], [108, 156721], [111, 156981], [119, 157521], [122, 157681], [126, 158554], [134, 159053], [139, 159313], [142, 159513], [149, 159793], [153, 160093], [156, 160233], [163, 161357], [167, 161533], [173, 161873], [181, 162473], [184, 162633], [189, 162833], [195, 163113], [199, 163433], [204, 163713], [207, 163913], [210, 164033]]}, {"verse": 18, "start": 165175, "end": 169456, "text": "Espinos y cardos te producirá, y comerás hierba del campo;", "words": [[0, 165175], [8, 165693], [10, 165873], [17, 166373], [20, 166473], [31, 167193], [33, 167573], [41, 168113], [48, 168533], [52, 168693]]}, {"verse": 19, "start": 169906, "end": 179907, "text": "En el sudor de tu rostro comerás el pan hasta que vuelvas a la tierra; porque de ella fuiste tomado: pues polvo eres, y al polvo volverás.", "words": [[0, 169906], [3, 170110], [6, 170350], [12, 170590], [15, 170730], [18, 170870], [25, 171350], [33, 171830], [36, 171950], [40, 172270], [46, 172830], [50, 173030], [58, 173490], [60, 173590], [63, 173670], [71, 174794], [78, 174978], [81, 175178], [86, 175398], [93, 175818], [101, 177062], [106, 177198], [112, 177618], [118, 177898], [120, 178338], [123, 178518], [129, 178918]]}, {"verse": 20, "start": 180257, "end": 186975, "text": "Y llamó el hombre el nombre de su mujer, Eva; por cuanto ella era madre de todos los vivientes.", "words": [[0, 180257], [2, 180385], [8, 180685], [11, 180825], [18, 181125], [21, 181465], [28, 181825], [31, 182025], [34, 182205], [41, 182544], [46, 183859], [50, 184019], [57, 184379], [62, 184679], [66, 185019], [72, 185399], [75, 185639], [81, 185879], [85, 186119]]}, {"verse": 21, "start": 187425, "end": 192859, "text": "Y Jehová Dios hizo al hombre y a su mujer túnicas de pieles, y los vistió.", "words": [[0, 187425], [2, 187568], [9, 188028], [14, 188208], [19, 188588], [22, 188808], [29, 189148], [31, 189648], [33, 189728], [36, 189848], [42, 190208], [50, 190988], [53, 191148], [61, 191748], [63, 192068], [67, 192208]]}, {"verse": 22, "start": 193309, "end": 208389, "text": "Y dijo Jehová Dios: He aquí el hombre es como uno de Nos sabiendo el bien y el mal: ahora, pues, porque no alargue su mano, y tome también del árbol de la vida, y coma, y viva para siempre:", "words": [[0, 193309], [2, 193430], [7, 194050], [14, 194590], [20, 195502], [23, 195592], [28, 195872], [31, 196132], [38, 196432], [41, 197032], [46, 197292], [50, 197572], [53, 197712], [57, 197852], [66, 198392], [69, 198612], [74, 198892], [76, 199312], [79, 199432], [84, 200342], [91, 200682], [97, 201022], [104, 201662], [107, 201922], [115, 202362], [118, 202522], [124, 202802], [126, 203362], [131, 203662], [139, 203962], [143, 204202], [149, 204522], [152, 204642], [155, 204762], [161, 205002], [163, 205522], [169, 205902], [171, 206402], [176, 206662], [181, 206842]]}, {"verse": 23, "start": 208739, "end": 214225, "text": "Y lo sacó Jehová del huerto de Edén, para que labrase la tierra de que fue tomado.", "words": [[0, 208739], [2, 208973], [5, 209243], [10, 209513], [17, 209783], [21, 209963], [28, 210403], [31, 210663], [37, 211023], [42, 211603], [46, 211783], [54, 212343], [57, 212543], [64, 212943], [67, 213143], [71, 213283], [75, 213483]]}, {"verse": 24, "start": 214675, "end": 227439, "text": "Echó, pues, fuera al hombre, y puso al oriente del huerto de Edén querubines, y una espada encendida que se revolvía a todos lados, para guardar el camino del árbol de la vida.", "words": [[0, 214845], [6, 215045], [12, 215825], [18, 216205], [21, 216545], [29, 216885], [31, 217425], [36, 217805], [39, 217985], [47, 218405], [51, 218665], [58, 219105], [61, 219305], [66, 219895], [78, 220485], [80, 221305], [84, 221465], [91, 221845], [101, 222545], [105, 222665], [108, 222825], [117, 223485], [119, 223625], [125, 223805], [132, 224768], [137, 224929], [145, 225469], [148, 225549], [155, 225889], [159, 226229], [165, 226629], [168, 226809], [171, 226929]]}]}