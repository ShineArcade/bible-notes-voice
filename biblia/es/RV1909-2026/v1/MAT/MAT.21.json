{"book": "MAT", "chapter": 21, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 414776, "verses": [{"verse": 1, "start": 300, "end": 9267, "text": "Y como se acercaron a Jerusalén, y vinieron a Betfagé, al monte de los Olivos, entonces Jesús envió dos discípulos,", "words": [[0, 300], [2, 401], [7, 601], [10, 801], [20, 1481], [22, 1601], [33, 2461], [35, 2721], [44, 3241], [46, 3791], [55, 4341], [58, 4721], [64, 5021], [67, 5221], [71, 5361], [79, 6221], [88, 6661], [94, 7281], [100, 8041], [104, 8341]]}, {"verse": 2, "start": 9717, "end": 20915, "text": "Diciéndoles: Id a la aldea que está delante de vosotros, y luego hallaréis una asna atada, y un pollino con ella: desatadla, y traédmelos.", "words": [[0, 9717], [13, 11083], [16, 11203], [18, 11463], [21, 11583], [27, 12023], [31, 12183], [36, 12363], [44, 12783], [47, 12943], [57, 13483], [59, 13943], [65, 14183], [75, 14903], [79, 15203], [84, 15823], [91, 16463], [93, 16883], [96, 17023], [104, 17463], [108, 17683], [114, 19367], [125, 19637], [127, 20299]]}, {"verse": 3, "start": 21365, "end": 27633, "text": "Y si alguno os dice algo, decid: El Señor los necesita. Y luego los dejará.", "words": [[0, 21365], [2, 21490], [5, 21610], [12, 22090], [15, 22210], [20, 22470], [26, 23210], [33, 24142], [36, 24286], [42, 24606], [46, 25027], [56, 26401], [58, 26524], [64, 26724], [68, 26984]]}, {"verse": 4, "start": 28083, "end": 34984, "text": "Y todo esto fue hecho, para que se cumpliese lo que fue dicho por el profeta, que dijo:", "words": [[0, 28083], [2, 28344], [7, 28584], [12, 28924], [16, 29204], [23, 29584], [28, 30204], [32, 30364], [35, 30524], [45, 31184], [48, 31404], [52, 31524], [56, 31724], [62, 32044], [66, 32324], [69, 32464], [78, 33224], [82, 33404]]}, {"verse": 5, "start": 35434, "end": 44900, "text": "Decid a la hija de Sion: He aquí, tu Rey viene a ti, manso, y sentado sobre una asna, y sobre un pollino, hijo de bestia de carga.", "words": [[0, 35434], [6, 35434], [8, 35634], [11, 35734], [16, 36114], [19, 36214], [25, 37177], [28, 37267], [34, 37487], [37, 37707], [41, 38087], [47, 38267], [49, 38487], [53, 39027], [60, 39627], [62, 39867], [70, 40427], [76, 40707], [80, 41007], [86, 41507], [88, 41907], [94, 42147], [97, 42347], [106, 43387], [111, 43527], [114, 43727], [121, 44127], [124, 44267]]}, {"verse": 6, "start": 45350, "end": 49575, "text": "Y los discípulos fueron, e hicieron como Jesús les mandó;", "words": [[0, 45350], [2, 45456], [6, 45576], [17, 46316], [25, 46756], [27, 47336], [36, 47856], [41, 48116], [47, 48496], [51, 49056]]}, {"verse": 7, "start": 50025, "end": 57033, "text": "Y trajeron el asna y el pollino, y pusieron sobre ellos sus mantos; y se sentó sobre ellos.", "words": [[0, 50025], [2, 50149], [11, 50769], [14, 50989], [19, 51429], [21, 51649], [24, 51809], [33, 52429], [35, 52909], [44, 53389], [50, 53709], [56, 54029], [60, 54582], [68, 55377], [70, 55502], [73, 55622], [79, 56042], [85, 56322]]}, {"verse": 8, "start": 57483, "end": 66950, "text": "Y la multitud, que era muy numerosa, tendía sus mantos en el camino: y otros cortaban ramas de los árboles, y los tendían por el camino.", "words": [[0, 57483], [2, 57569], [5, 57689], [15, 58229], [19, 58409], [23, 58569], [27, 58749], [37, 59389], [44, 60209], [48, 60409], [55, 60989], [58, 61149], [61, 61269], [69, 62240], [71, 62417], [77, 62637], [86, 63277], [92, 63917], [95, 64097], [99, 64217], [108, 64797], [110, 65217], [114, 65357], [122, 65917], [126, 66157], [129, 66257]]}, {"verse": 9, "start": 67400, "end": 78626, "text": "Y la gente que iba delante y la que iba detrás aclamaba diciendo: ¡Hosanna al Hijo de David! ¡Bendito el que viene en el nombre del Señor! ¡Hosanna en las alturas!", "words": [[0, 67400], [2, 67489], [5, 67609], [11, 67869], [15, 68089], [19, 68459], [27, 68829], [29, 69309], [32, 69429], [36, 69569], [40, 69809], [47, 70429], [56, 71449], [66, 72746], [75, 73016], [78, 73336], [83, 73556], [86, 73676], [93, 74406], [102, 74903], [105, 75003], [109, 75123], [115, 75443], [118, 75643], [121, 75763], [128, 76043], [132, 76243], [139, 77298], [148, 77548], [151, 77728], [155, 77848]]}, {"verse": 10, "start": 78976, "end": 85677, "text": "Y entrando él en Jerusalén, toda la ciudad se alborotó, diciendo: ¿Quién es este?", "words": [[0, 78976], [2, 79134], [11, 79674], [14, 80014], [17, 80214], [28, 81454], [33, 81654], [36, 81954], [43, 82314], [46, 82734], [56, 83854], [66, 84865], [73, 85106], [76, 85226]]}, {"verse": 11, "start": 86027, "end": 90832, "text": "Y la gente decía: Este es Jesús, el profeta, de Nazaret de Galilea.", "words": [[0, 86027], [2, 86129], [5, 86229], [11, 86589], [18, 87712], [23, 87953], [26, 88133], [33, 88493], [36, 88713], [45, 89533], [48, 89613], [56, 90053], [59, 90233]]}, {"verse": 12, "start": 91182, "end": 103117, "text": "Y entró Jesús en el templo de Dios, y echó fuera todos los que vendían y compraban en el templo, y volcó las mesas de los cambistas, y las sillas de los que vendían palomas;", "words": [[0, 91182], [2, 91326], [8, 91726], [14, 92066], [17, 92366], [20, 92506], [27, 92966], [30, 93046], [36, 93346], [38, 93616], [43, 93886], [49, 94206], [55, 94626], [59, 94946], [63, 95126], [71, 95686], [73, 95806], [83, 96546], [86, 96686], [89, 96866], [97, 97666], [99, 97806], [105, 98126], [109, 98446], [115, 98766], [118, 98986], [122, 99536], [133, 100344], [135, 100447], [139, 100607], [146, 101127], [149, 101527], [153, 101627], [157, 101767], [165, 102187]]}, {"verse": 13, "start": 103567, "end": 111712, "text": "Y les dice: Escrito está: Mi casa, casa de oración será llamada; pero vosotros cueva de ladrones la habéis hecho.", "words": [[0, 103567], [2, 103693], [6, 103833], [12, 104723], [20, 105323], [26, 106185], [29, 106350], [35, 106910], [40, 107110], [43, 107330], [51, 107802], [56, 108274], [65, 108988], [70, 109248], [79, 109718], [85, 110188], [88, 110308], [97, 110628], [100, 110948], [107, 111248]]}, {"verse": 14, "start": 112162, "end": 116617, "text": "Entonces vinieron a él ciegos y cojos en el templo, y los sanó.", "words": [[0, 112162], [9, 112599], [18, 113259], [20, 113419], [23, 113639], [30, 114199], [32, 114339], [38, 114719], [41, 114919], [44, 115059], [52, 115819], [54, 115959], [58, 116119]]}, {"verse": 15, "start": 117067, "end": 129122, "text": "Pero los príncipes de los sacerdotes y los escribas, viendo las maravillas que hacía, y a los muchachos aclamando en el templo y diciendo: ¡Hosanna al Hijo de David! se indignaron,", "words": [[0, 117067], [5, 117232], [9, 117412], [19, 118112], [22, 118232], [26, 118372], [37, 119152], [39, 119332], [43, 119472], [53, 120112], [60, 120605], [64, 121099], [75, 121592], [79, 121772], [86, 122192], [88, 122732], [90, 122812], [94, 122912], [104, 123472], [114, 124052], [117, 124172], [120, 124312], [127, 124872], [129, 124912], [139, 126188], [148, 126458], [151, 126778], [156, 126998], [159, 127118], [166, 127898], [169, 128115]]}, {"verse": 16, "start": 129572, "end": 142513, "text": "Y le dijeron: ¿Oyes lo que estos dicen? Y Jesús les dice: Sí: ¿nunca leísteis: De la boca de los niños y de los niños de pecho perfeccionaste la alabanza?", "words": [[0, 129572], [2, 129753], [5, 129833], [14, 131978], [20, 132261], [23, 132441], [27, 132601], [33, 132781], [40, 133816], [42, 133963], [48, 134323], [52, 134783], [58, 135696], [62, 136355], [69, 136779], [79, 137951], [82, 138391], [85, 138491], [90, 138711], [93, 138871], [97, 139011], [103, 139311], [105, 139551], [108, 139631], [112, 139751], [118, 139991], [121, 140191], [127, 140611], [142, 141511], [145, 141731]]}, {"verse": 17, "start": 142963, "end": 148062, "text": "Y dejándolos, se salió fuera de la ciudad, a Betania; y pasó allí la noche.", "words": [[0, 142963], [2, 143245], [14, 143945], [17, 144185], [23, 144525], [29, 144765], [32, 144965], [35, 145065], [43, 145385], [45, 145725], [54, 146625], [56, 146725], [61, 147035], [66, 147345], [69, 147525]]}, {"verse": 18, "start": 148512, "end": 151576, "text": "Y por la mañana volviendo a la ciudad, tuvo hambre.", "words": [[0, 148512], [2, 148638], [6, 148818], [9, 148978], [16, 149298], [26, 149958], [28, 150078], [31, 150138], [39, 150478], [44, 150858]]}, {"verse": 19, "start": 152026, "end": 165189, "text": "Y viendo una higuera cerca del camino, vino a ella, y no halló nada en ella, sino hojas solamente; y le dijo: Nunca más para siempre nazca de ti fruto. Y luego se secó la higuera.", "words": [[0, 152026], [2, 152149], [9, 152509], [13, 152909], [21, 153529], [27, 153869], [31, 154189], [39, 154669], [44, 155249], [46, 155449], [52, 155729], [54, 155949], [57, 156149], [63, 156469], [68, 156689], [71, 156949], [77, 157249], [82, 157589], [88, 158189], [99, 159500], [101, 159627], [104, 159727], [110, 160501], [116, 160860], [120, 161000], [125, 161220], [133, 161780], [139, 162113], [142, 162447], [145, 162780], [152, 163414], [154, 163511], [160, 163711], [163, 163951], [168, 164331], [171, 164471]]}, {"verse": 20, "start": 165639, "end": 174358, "text": "Y viendo esto los discípulos, maravillados decían: ¿Cómo se secó luego la higuera?", "words": [[0, 165639], [2, 165764], [9, 166064], [14, 166404], [18, 166604], [30, 167384], [43, 168484], [51, 169564], [57, 169748], [60, 169928], [65, 170308], [71, 170428], [74, 170668]]}, {"verse": 21, "start": 174708, "end": 189711, "text": "Y respondiendo Jesús les dijo: De cierto os digo, que si tenéis fe, y no dudáis, no sólo haréis esto de la higuera: sino que si a este monte decís: Quítate y échate en el mar, será hecho.", "words": [[0, 174800], [2, 174930], [15, 175910], [21, 176170], [25, 176410], [31, 177326], [34, 177491], [41, 177851], [44, 178311], [50, 179051], [54, 179371], [57, 179531], [64, 179991], [68, 180351], [70, 180711], [73, 180851], [81, 181971], [84, 182151], [89, 182491], [96, 182871], [101, 183151], [104, 183331], [107, 183756], [116, 184440], [121, 184660], [125, 184840], [128, 185020], [130, 185140], [135, 185340], [141, 185680], [148, 186886], [156, 187288], [158, 187568], [165, 187968], [168, 188108], [171, 188248], [176, 188808], [181, 189068]]}, {"verse": 22, "start": 190161, "end": 194657, "text": "Y todo lo que pidáis en oración, creyendo, lo recibiréis.", "words": [[0, 190161], [2, 190288], [7, 190588], [10, 190808], [14, 191108], [21, 191408], [24, 191588], [33, 192448], [43, 193168], [46, 193608]]}, {"verse": 23, "start": 195107, "end": 208774, "text": "Y cuando vino al templo, se llegaron a él cuando estaba enseñando, los príncipes de los sacerdotes y los ancianos del pueblo, diciendo: ¿Con qué autoridad haces esto? ¿y quién te dio esta autoridad?", "words": [[0, 195107], [2, 195212], [9, 195432], [14, 195712], [17, 195932], [25, 196832], [28, 196992], [37, 197472], [39, 197672], [42, 197872], [49, 198112], [56, 198632], [67, 199512], [71, 199992], [81, 200952], [84, 201092], [88, 201212], [99, 202132], [101, 202292], [105, 202452], [114, 202992], [118, 203112], [126, 203532], [136, 204996], [141, 205116], [145, 205356], [155, 205896], [161, 206276], [167, 207102], [170, 207230], [176, 207410], [179, 207590], [183, 207830], [188, 208090]]}, {"verse": 24, "start": 209124, "end": 218800, "text": "Y respondiendo Jesús, les dijo: Yo también os haré una pregunta, la cual si me decís, también yo os diré con qué autoridad hago esto.", "words": [[0, 209124], [2, 209246], [15, 210026], [22, 210386], [26, 210746], [32, 211658], [35, 211865], [43, 212185], [46, 212505], [51, 212805], [55, 212925], [65, 213945], [68, 214025], [73, 214185], [76, 214405], [79, 214545], [86, 215585], [94, 215885], [97, 216245], [100, 216465], [105, 216845], [109, 217025], [113, 217285], [123, 217985], [128, 218245]]}, {"verse": 25, "start": 219250, "end": 232196, "text": "El bautismo de Juan, ¿de dónde era? ¿del cielo, o de los hombres? Ellos entonces pensaron entre sí, diciendo: Si decimos, del cielo, nos dirá: ¿Por qué pues no le creísteis?", "words": [[0, 219250], [3, 219616], [12, 220156], [15, 220336], [21, 220876], [25, 221096], [31, 221336], [36, 222207], [41, 222453], [48, 222973], [50, 223453], [53, 223553], [57, 223673], [66, 224795], [72, 225120], [81, 225560], [90, 226460], [96, 226780], [100, 227520], [110, 228514], [113, 228627], [122, 229107], [126, 229287], [133, 229587], [137, 229827], [143, 230544], [148, 230686], [152, 230886], [157, 231106], [160, 231266], [163, 231386]]}, {"verse": 26, "start": 232646, "end": 238085, "text": "Y si decimos, de los hombres, tememos al pueblo; porque todos tienen a Juan por profeta.", "words": [[0, 232646], [2, 232769], [5, 232869], [14, 233349], [17, 233509], [21, 233649], [30, 233949], [38, 234549], [41, 234749], [49, 235699], [56, 236019], [62, 236379], [69, 236819], [71, 236979], [76, 237219], [80, 237439]]}, {"verse": 27, "start": 238435, "end": 246442, "text": "Y respondiendo a Jesús, dijeron: No sabemos. Y él también les dijo: Ni yo os digo con qué autoridad hago esto.", "words": [[0, 238435], [2, 238831], [15, 239261], [17, 239421], [24, 240161], [33, 241106], [36, 241263], [45, 242360], [47, 242524], [50, 242664], [58, 242944], [62, 243164], [68, 243927], [71, 244093], [74, 244333], [77, 244433], [82, 244633], [86, 244893], [90, 245073], [100, 245633], [105, 245933]]}, {"verse": 28, "start": 246892, "end": 255137, "text": "Pero, ¿qué os parece? Un hombre tenía dos hijos, y llegando al primero, le dijo: Hijo, ve hoy a trabajar en mi viña.", "words": [[0, 246892], [6, 247076], [11, 247316], [14, 247456], [22, 248365], [25, 248512], [32, 248752], [38, 249172], [42, 249532], [49, 249972], [51, 250512], [60, 250972], [63, 251092], [72, 251432], [75, 251672], [81, 252440], [87, 252843], [90, 253203], [94, 253583], [96, 253723], [105, 254163], [108, 254383], [111, 254543]]}, {"verse": 29, "start": 255587, "end": 260418, "text": "Y respondiendo él, dijo: No quiero; pero después, arrepentido, fue.", "words": [[0, 255587], [2, 255693], [15, 256453], [19, 256553], [25, 257385], [28, 257689], [36, 258555], [41, 258700], [50, 259060], [63, 259980]]}, {"verse": 30, "start": 260868, "end": 268940, "text": "Y llegando al otro, le dijo de la misma manera; y respondiendo él, dijo: Yo, señor, voy. Y no fue.", "words": [[0, 260868], [2, 260965], [11, 261405], [14, 261545], [20, 262185], [23, 262385], [28, 262685], [31, 262825], [34, 262945], [40, 263165], [48, 264344], [50, 264644], [63, 265364], [67, 265744], [73, 267063], [77, 267253], [84, 267673], [89, 268342], [91, 268466], [94, 268566]]}, {"verse": 31, "start": 269390, "end": 281792, "text": "¿Cuál de los dos hizo la voluntad de su padre? Dicen ellos: El primero. Les dice Jesús: De cierto os digo, que los publicanos y las prostitutas os van delante al reino de Dios.", "words": [[0, 269390], [6, 269754], [9, 269894], [13, 270054], [17, 270314], [22, 270754], [25, 270994], [34, 271614], [37, 271734], [40, 271894], [47, 272783], [53, 273091], [60, 274087], [63, 274167], [72, 275171], [76, 275281], [81, 275561], [88, 276671], [91, 276835], [98, 277155], [101, 277535], [107, 277915], [111, 278095], [115, 278255], [126, 278935], [128, 279095], [132, 279215], [144, 279915], [147, 280015], [151, 280215], [159, 280655], [162, 280795], [168, 281135], [171, 281295]]}, {"verse": 32, "start": 282242, "end": 297047, "text": "Porque vino a vosotros Juan en camino de justicia, y no le creísteis; y los publicanos y las prostitutas le creyeron; y vosotros, viendo esto, no os arrepentisteis después para creerle.", "words": [[0, 282242], [7, 282616], [12, 282896], [14, 283056], [23, 283496], [28, 283896], [31, 284376], [38, 284696], [41, 284936], [51, 285656], [53, 286096], [56, 286236], [59, 286356], [70, 287657], [72, 287802], [76, 287902], [87, 288622], [89, 288782], [93, 288922], [105, 289722], [108, 289882], [118, 290981], [120, 291091], [130, 291811], [137, 292091], [143, 292991], [146, 293191], [149, 293411], [164, 294611], [172, 294991], [177, 295351]]}, {"verse": 33, "start": 297497, "end": 314459, "text": "Oíd otra parábola: fue un hombre, padre de familia, el cual plantó una viña; y la rodeó con una cerca, y cavó en ella un lagar para prensar uvas, y edificó una torre, y la arrendó a labradores, y se fue lejos.", "words": [[0, 297497], [4, 297497], [9, 297877], [19, 299089], [23, 299252], [26, 299452], [34, 300212], [40, 300532], [43, 300752], [52, 301452], [55, 301592], [60, 301812], [67, 302612], [71, 302852], [77, 303918], [79, 304060], [82, 304370], [88, 304680], [92, 304880], [96, 305060], [103, 305500], [105, 306120], [110, 306740], [113, 306840], [118, 307020], [121, 307220], [127, 307680], [132, 307920], [140, 308540], [146, 309080], [148, 309880], [156, 310460], [160, 310620], [167, 311220], [169, 311580], [172, 311740], [180, 312440], [182, 312520], [194, 313160], [196, 313400], [199, 313540], [203, 313740]]}, {"verse": 34, "start": 314909, "end": 322736, "text": "Y cuando se acercó el tiempo de los frutos, envió sus siervos a los labradores, para que recibiesen sus frutos.", "words": [[0, 314909], [2, 315018], [9, 315258], [12, 315518], [19, 316058], [22, 316178], [29, 316498], [32, 316698], [36, 316838], [44, 317778], [50, 318318], [54, 318518], [62, 319078], [64, 319258], [68, 319398], [80, 320198], [85, 320879], [89, 321038], [100, 321778], [104, 322038]]}, {"verse": 35, "start": 323186, "end": 330598, "text": "Pero los labradores, tomando a los siervos, al uno hirieron, y al otro mataron, y al otro apedrearon.", "words": [[0, 323186], [5, 323334], [9, 323494], [21, 324134], [29, 324674], [31, 324754], [35, 324874], [44, 325374], [47, 325634], [51, 326434], [61, 327234], [63, 327354], [66, 327474], [71, 327694], [80, 328854], [82, 328894], [85, 329054], [90, 329334]]}, {"verse": 36, "start": 331048, "end": 337210, "text": "Envió de nuevo otros siervos, más que los primeros; e hicieron con ellos de la misma manera.", "words": [[0, 331048], [6, 331511], [9, 331631], [15, 331891], [21, 332331], [30, 332971], [34, 333291], [38, 333491], [42, 333631], [52, 334677], [54, 334813], [63, 335393], [67, 335633], [73, 335933], [76, 336113], [79, 336233], [85, 336433]]}, {"verse": 37, "start": 337660, "end": 343044, "text": "Y finalmente les envió su hijo, diciendo: Tendrán respeto a mi hijo.", "words": [[0, 337660], [2, 337914], [13, 338274], [17, 338774], [23, 339234], [26, 339454], [32, 339754], [42, 340915], [50, 341563], [58, 342263], [60, 342403], [63, 342543]]}, {"verse": 38, "start": 343494, "end": 352159, "text": "Pero los labradores, viendo al hijo, dijeron entre sí: Este es el heredero; venid, matémosle, y tomemos su herencia.", "words": [[0, 343494], [5, 343915], [9, 344115], [21, 344795], [28, 344955], [31, 345175], [37, 345495], [45, 345955], [51, 346195], [55, 346898], [60, 347184], [63, 347444], [66, 347982], [76, 348764], [83, 349250], [94, 350010], [96, 350430], [104, 350850], [107, 351330]]}, {"verse": 39, "start": 352609, "end": 356121, "text": "Y tomado, le echaron fuera de la viña, y le mataron.", "words": [[0, 352609], [2, 352732], [10, 353212], [13, 353412], [21, 353892], [27, 354172], [30, 354392], [33, 354532], [39, 354992], [41, 355192], [44, 355292]]}, {"verse": 40, "start": 356571, "end": 360957, "text": "Pues cuando venga el señor de la viña, ¿qué hará a aquellos labradores?", "words": [[0, 356571], [5, 356675], [12, 356995], [18, 357315], [21, 357415], [27, 357695], [30, 357935], [33, 358055], [39, 358655], [44, 358955], [49, 359205], [51, 359455], [60, 359815]]}, {"verse": 41, "start": 361407, "end": 370744, "text": "Le dicen: a los malos destruirá miserablemente, y su viña dará en arriendo a otros labradores, que le paguen el fruto a sus tiempos.", "words": [[0, 361407], [3, 361837], [10, 362526], [12, 362624], [16, 362724], [22, 363124], [32, 363704], [48, 364604], [50, 365124], [53, 365304], [58, 365644], [63, 365904], [66, 366004], [75, 366484], [77, 366604], [83, 366804], [95, 367504], [99, 367864], [102, 367984], [109, 368324], [112, 368534], [118, 368744], [120, 368824], [124, 368944]]}, {"verse": 42, "start": 371094, "end": 385801, "text": "Les dice Jesús: ¿Nunca leísteis en las Escrituras: La piedra que desecharon los que edificaban, esta fue hecha por piedra angular: por el Señor es hecho esto, y es cosa maravillosa en nuestros ojos?", "words": [[0, 371168], [4, 371278], [9, 371558], [16, 372668], [23, 373156], [32, 373956], [35, 374096], [39, 374256], [51, 375613], [54, 375720], [61, 376200], [65, 376340], [76, 377080], [80, 377280], [84, 377440], [96, 378540], [101, 378780], [105, 379020], [111, 379260], [115, 379500], [122, 379960], [131, 381055], [135, 381439], [138, 381599], [144, 381899], [147, 382199], [153, 382459], [159, 382859], [161, 383139], [164, 383299], [169, 383559], [181, 384619], [184, 384759], [193, 384999]]}, {"verse": 43, "start": 386251, "end": 392981, "text": "Por tanto os digo, que el reino de Dios será quitado de vosotros, y será dado a gente que haga los frutos de él.", "words": [[0, 386251], [4, 386377], [10, 386547], [13, 386717], [19, 387117], [23, 387357], [26, 387497], [32, 387897], [35, 388057], [40, 388297], [45, 388577], [53, 389137], [56, 389317], [66, 389857], [68, 390397], [73, 390637], [78, 390917], [80, 391077], [86, 391337], [90, 391597], [95, 391777], [99, 391997], [106, 392397], [109, 392597]]}, {"verse": 44, "start": 393431, "end": 400122, "text": "Y el que caiga sobre esta piedra, será quebrantado; y sobre quien ella caiga, lo aplastará.", "words": [[0, 393431], [2, 393538], [5, 393658], [9, 393818], [15, 394258], [21, 394558], [26, 394778], [34, 395338], [39, 396168], [52, 397246], [54, 397402], [60, 397662], [66, 397942], [71, 398262], [78, 398902], [81, 399512]]}, {"verse": 45, "start": 400572, "end": 408693, "text": "Y oyendo los príncipes de los sacerdotes y los fariseos sus parábolas, entendieron que hablaba de ellos.", "words": [[0, 401039], [2, 401519], [9, 401879], [13, 402099], [23, 402799], [26, 402939], [30, 403059], [41, 403959], [43, 404159], [47, 404299], [56, 405259], [60, 405459], [71, 406659], [83, 407379], [87, 407599], [95, 408039], [98, 408179]]}, {"verse": 46, "start": 409143, "end": 414376, "text": "Y buscando cómo echarle mano, temieron al pueblo; porque le tenían por profeta.", "words": [[0, 409143], [2, 409418], [11, 409718], [16, 410098], [24, 410505], [30, 410911], [39, 411318], [42, 411498], [50, 412487], [57, 412711], [60, 412871], [67, 413231], [71, 413551]]}]}