{"book": "1CO", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 211145, "verses": [{"verse": 1, "start": 300, "end": 6966, "text": "Porque no quiero, hermanos, que ignoréis que nuestros padres todos estuvieron bajo la nube, y todos pasaron el mar;", "words": [[0, 300], [7, 506], [10, 686], [18, 946], [28, 1906], [32, 2046], [41, 2546], [45, 2726], [54, 2926], [61, 3426], [67, 3786], [78, 4506], [83, 4706], [86, 4906], [92, 5246], [94, 5646], [100, 5866], [108, 6426], [111, 6606]]}, {"verse": 2, "start": 7416, "end": 10854, "text": "Y todos en Moisés fueron bautizados en la nube y en el mar;", "words": [[0, 7416], [2, 7536], [8, 7716], [11, 7976], [18, 8316], [25, 8656], [36, 9376], [39, 9576], [42, 9696], [47, 10016], [49, 10276], [52, 10396], [55, 10516]]}, {"verse": 3, "start": 11304, "end": 13974, "text": "Y todos comieron el mismo alimento espiritual;", "words": [[0, 11304], [2, 11411], [8, 11631], [17, 12191], [20, 12411], [26, 12691], [35, 13131]]}, {"verse": 4, "start": 14424, "end": 21949, "text": "Y todos bebieron la misma bebida espiritual; porque bebían de la piedra espiritual que los seguía, y la piedra era Cristo:", "words": [[0, 14424], [2, 14541], [8, 14781], [17, 15401], [20, 15581], [26, 15821], [33, 16281], [45, 17404], [52, 17621], [59, 18101], [62, 18241], [65, 18341], [72, 18701], [83, 19301], [87, 19481], [91, 19661], [99, 20241], [101, 20601], [104, 20741], [111, 21181], [115, 21341]]}, {"verse": 5, "start": 22399, "end": 26974, "text": "Pero de muchos de ellos no se agradó Dios; por lo cual fueron postrados en el desierto.", "words": [[0, 22399], [5, 22542], [8, 22682], [15, 22902], [18, 23162], [24, 23382], [27, 23562], [30, 23822], [37, 24082], [43, 24772], [47, 24877], [50, 24997], [55, 25217], [62, 25437], [72, 25977], [75, 26197], [78, 26317]]}, {"verse": 6, "start": 27424, "end": 32981, "text": "Pero estas cosas fueron en figura de nosotros, para que no codiciemos cosas malas, como ellos codiciaron.", "words": [[0, 27424], [5, 27547], [11, 27747], [17, 28147], [24, 28467], [27, 28687], [34, 28927], [37, 29127], [47, 29627], [52, 30187], [56, 30307], [59, 30427], [70, 31007], [76, 31207], [83, 31767], [88, 31987], [94, 32187]]}, {"verse": 7, "start": 33431, "end": 42222, "text": "Ni seáis honradores de ídolos, como algunos de ellos; según está escrito: Se sentó el pueblo a comer y a beber, y se levantaron a jugar.", "words": [[0, 33431], [3, 33577], [9, 33997], [20, 34677], [23, 34817], [31, 35397], [36, 35717], [44, 36117], [47, 36297], [54, 37109], [60, 37389], [65, 37629], [74, 38533], [77, 38638], [83, 39018], [86, 39118], [93, 39458], [95, 39638], [101, 39898], [103, 40118], [105, 40198], [112, 40438], [114, 40918], [117, 41018], [128, 41598], [130, 41698]]}, {"verse": 8, "start": 42672, "end": 48810, "text": "Ni practiquemos inmoralidad sexual, como algunos de ellos la practicaron, y cayeron en un día veintitrés mil.", "words": [[0, 42672], [3, 42808], [16, 43488], [28, 44188], [36, 44948], [41, 45108], [49, 45448], [52, 45628], [58, 45848], [61, 45968], [74, 46608], [76, 47008], [84, 47508], [87, 47588], [90, 47708], [94, 48095], [105, 48481]]}, {"verse": 9, "start": 49260, "end": 54255, "text": "Ni tentemos a Cristo, como también algunos de ellos le tentaron, y perecieron por las serpientes.", "words": [[0, 49260], [3, 49403], [12, 49823], [14, 50003], [22, 50323], [27, 50703], [35, 51063], [43, 51403], [46, 51623], [52, 51783], [55, 51943], [65, 52443], [67, 52703], [78, 53243], [82, 53383], [86, 53503]]}, {"verse": 10, "start": 54705, "end": 59229, "text": "Ni murmuréis, como algunos de ellos murmuraron, y perecieron por el destructor.", "words": [[0, 54705], [3, 54850], [14, 55510], [19, 55730], [27, 56170], [30, 56390], [36, 56610], [48, 57350], [50, 57530], [61, 58130], [65, 58350], [68, 58490]]}, {"verse": 11, "start": 59679, "end": 68233, "text": "Y estas cosas les acontecieron en figura; y son escritas para nuestra advertencia, a quienes han llegado los fines de los siglos.", "words": [[0, 59679], [2, 59775], [8, 59995], [14, 60395], [18, 60615], [31, 61335], [34, 61455], [42, 62280], [44, 62403], [48, 62543], [57, 63123], [62, 63323], [70, 63523], [83, 64463], [85, 64823], [93, 64983], [97, 65263], [105, 65643], [109, 65803], [115, 66043], [118, 66243], [122, 66383]]}, {"verse": 12, "start": 68683, "end": 71387, "text": "Así que, el que piensa estar firme, mire no caiga.", "words": [[0, 68683], [4, 68906], [9, 69066], [12, 69126], [16, 69246], [23, 69606], [29, 69826], [36, 70179], [41, 70533], [44, 70886]]}, {"verse": 13, "start": 71837, "end": 83171, "text": "No os ha tomado tentación, sino humana: pero fiel es Dios, que no os dejará ser tentados más de lo que podéis llevar; antes dará también juntamente con la tentación la salida, para que podáis aguantar.", "words": [[0, 71837], [3, 72018], [6, 72218], [9, 72318], [16, 72678], [27, 73258], [32, 73598], [40, 74452], [45, 74595], [50, 74895], [53, 75035], [59, 75455], [63, 75515], [66, 75675], [69, 75775], [76, 76135], [80, 76295], [89, 76755], [93, 76975], [96, 77135], [99, 77235], [103, 77335], [110, 77655], [118, 78438], [124, 78748], [129, 79128], [137, 79388], [148, 80008], [152, 80228], [155, 80348], [165, 80828], [168, 80968], [176, 81428], [181, 81988], [185, 82128], [192, 82468]]}, {"verse": 14, "start": 83621, "end": 86371, "text": "Por tanto, amados míos, huid de la idolatría.", "words": [[0, 83621], [4, 83708], [11, 84128], [18, 84428], [24, 85088], [29, 85388], [32, 85508], [35, 85608]]}, {"verse": 15, "start": 86821, "end": 89982, "text": "Como a sabios hablo; juzgad vosotros lo que digo.", "words": [[0, 86821], [5, 87188], [7, 87348], [14, 87688], [21, 88452], [28, 88877], [37, 89317], [40, 89497], [44, 89617]]}, {"verse": 16, "start": 90432, "end": 98519, "text": "La copa de bendición que bendecimos, ¿no es la comunión de la sangre de Cristo? El pan que partimos, ¿no es la comunión del cuerpo de Cristo?", "words": [[0, 90432], [3, 90550], [8, 90910], [11, 90990], [21, 91470], [25, 91630], [37, 92570], [41, 92850], [44, 92990], [47, 93090], [56, 93530], [59, 93670], [62, 93770], [69, 94070], [72, 94210], [80, 95109], [83, 95247], [87, 95447], [91, 95627], [101, 96147], [105, 96687], [108, 96847], [111, 96947], [120, 97367], [124, 97507], [131, 97787], [134, 97987]]}, {"verse": 17, "start": 98969, "end": 105659, "text": "Porque hay un solo pan, nosotros, siendo muchos, somos un cuerpo; pues todos participamos de ese mismo pan.", "words": [[0, 98969], [7, 99203], [11, 99403], [14, 99543], [19, 99783], [24, 100043], [34, 100923], [41, 101123], [49, 101603], [55, 102163], [58, 102443], [66, 103266], [71, 103364], [77, 103684], [90, 104544], [93, 104764], [97, 104924], [103, 105224]]}, {"verse": 18, "start": 106109, "end": 112065, "text": "Mirad a Israel según la carne: los que comen de los sacrificios ¿no son partícipes con el altar?", "words": [[0, 106264], [6, 106454], [8, 106574], [15, 106934], [21, 107214], [24, 107454], [31, 108245], [35, 108381], [39, 108601], [45, 108861], [48, 109041], [52, 109161], [64, 110021], [68, 110281], [72, 110481], [83, 111201], [87, 111401], [90, 111521]]}, {"verse": 19, "start": 112515, "end": 118602, "text": "¿Qué pues digo? ¿Que el ídolo es algo? ¿o que sea algo lo que es sacrificado a los ídolos?", "words": [[0, 112515], [5, 112636], [10, 112856], [16, 113672], [21, 113789], [24, 113929], [30, 114189], [33, 114409], [39, 115174], [42, 115272], [46, 115372], [50, 115552], [55, 115812], [58, 115992], [62, 116112], [65, 116232], [77, 116892], [79, 116992], [83, 117112]]}, {"verse": 20, "start": 119052, "end": 128445, "text": "Antes digo que lo que los Gentiles sacrifican, a los demonios lo sacrifican, y no a Dios: y no querría que vosotros fueseis partícipes con los demonios.", "words": [[0, 119240], [6, 119430], [11, 119670], [15, 119870], [18, 119990], [22, 120130], [26, 120290], [35, 120790], [47, 121750], [49, 122210], [53, 122370], [62, 122890], [65, 122990], [77, 123770], [79, 123930], [82, 124110], [84, 124250], [90, 125051], [92, 125149], [95, 125329], [103, 125509], [107, 125749], [116, 126149], [124, 126689], [135, 127389], [139, 127569], [143, 127729]]}, {"verse": 21, "start": 128895, "end": 137623, "text": "No podéis beber la copa del Señor, y la copa de los demonios: no podéis ser partícipes de la mesa del Señor, y de la mesa de los demonios.", "words": [[0, 128895], [3, 129033], [10, 129353], [16, 129653], [19, 129893], [24, 130233], [28, 130353], [35, 130753], [37, 131293], [40, 131433], [45, 131773], [48, 131873], [52, 131993], [62, 133020], [65, 133123], [72, 133463], [76, 133703], [87, 134463], [90, 134623], [93, 134743], [98, 135003], [102, 135183], [109, 135583], [111, 136103], [114, 136223], [117, 136323], [122, 136603], [125, 136763], [129, 136883]]}, {"verse": 22, "start": 138073, "end": 141961, "text": "¿O provocaremos a celo al Señor? ¿Somos más fuertes que él?", "words": [[0, 138073], [3, 138193], [16, 138873], [18, 139113], [23, 139433], [26, 139533], [33, 140445], [40, 140783], [44, 140943], [52, 141523], [56, 141643]]}, {"verse": 23, "start": 142411, "end": 148857, "text": "Todo me es lícito, pero no todo conviene: todo me es lícito, pero no todo edifica.", "words": [[0, 142411], [5, 142665], [8, 142955], [11, 143245], [19, 143535], [24, 143635], [27, 143795], [32, 144015], [42, 145097], [47, 145422], [50, 145787], [53, 146152], [61, 146517], [66, 146537], [69, 146717], [74, 146937]]}, {"verse": 24, "start": 149307, "end": 152280, "text": "Ninguno busque su propio bien, sino el del otro.", "words": [[0, 149307], [8, 149770], [15, 150170], [18, 150310], [25, 150610], [31, 151270], [36, 151530], [39, 151690], [43, 151830]]}, {"verse": 25, "start": 152730, "end": 158016, "text": "De todo lo que se vende en la carnicería, comed, sin preguntar nada por causa de la conciencia;", "words": [[0, 152730], [3, 152847], [8, 152967], [11, 153167], [15, 153267], [18, 153407], [24, 153687], [27, 153787], [30, 153887], [42, 154867], [49, 155427], [53, 155627], [63, 156147], [68, 156367], [72, 156647], [78, 156907], [81, 157127], [84, 157207]]}, {"verse": 26, "start": 158466, "end": 160974, "text": "Porque del Señor es la tierra y todo lo que la llena.", "words": [[0, 158466], [7, 158646], [11, 158806], [17, 159046], [20, 159246], [23, 159366], [30, 159666], [32, 159986], [37, 160186], [40, 160366], [44, 160486], [47, 160586]]}, {"verse": 27, "start": 161424, "end": 169626, "text": "Y si algún no creyente os invita, y queréis ir, de todo lo que se os pone delante comed, sin preguntar nada por causa de la conciencia.", "words": [[0, 161424], [2, 161528], [5, 161608], [11, 161928], [14, 162168], [23, 162688], [26, 162848], [34, 163648], [36, 163888], [44, 164248], [48, 164548], [51, 165088], [56, 165268], [59, 165468], [63, 165588], [66, 165708], [69, 165788], [74, 166121], [82, 166455], [89, 166788], [93, 167268], [103, 167808], [108, 168028], [112, 168268], [118, 168528], [121, 168748], [124, 168828]]}, {"verse": 28, "start": 170076, "end": 180323, "text": "Pero si alguien os dice: «Esto fue sacrificado a los ídolos», no lo comáis, en atención a quien os avisó y por motivos de conciencia; porque del Señor es la tierra y todo lo que la llena.", "words": [[0, 170076], [5, 170192], [8, 170392], [16, 170602], [19, 170812], [25, 171581], [31, 171817], [35, 172037], [47, 172717], [49, 172817], [53, 172937], [62, 173697], [65, 173777], [68, 173897], [76, 174697], [79, 174817], [88, 175157], [90, 175437], [96, 175577], [99, 175717], [105, 176177], [107, 176277], [111, 176417], [119, 176897], [122, 176977], [134, 178036], [141, 178200], [145, 178360], [151, 178620], [154, 178820], [157, 178920], [164, 179220], [166, 179360], [171, 179540], [174, 179720], [178, 179820], [181, 179920]]}, {"verse": 29, "start": 180773, "end": 187340, "text": "La conciencia, digo, no tuya, sino del otro. Pues ¿por qué ha de ser juzgada mi libertad por otra conciencia?", "words": [[0, 180859], [3, 180959], [15, 181559], [21, 182079], [24, 182259], [30, 182879], [35, 183139], [39, 183379], [45, 184076], [50, 184204], [55, 184424], [59, 184644], [62, 184764], [65, 184864], [69, 185044], [77, 185524], [80, 185684], [89, 186224], [93, 186384], [98, 186544]]}, {"verse": 30, "start": 187790, "end": 192854, "text": "Y si yo con agradecimiento participo, ¿por qué se habla mal de mí por lo que doy gracias?", "words": [[0, 187790], [2, 187928], [5, 188082], [8, 188235], [12, 188375], [27, 189115], [38, 190315], [43, 190395], [47, 190555], [50, 190695], [56, 190935], [60, 191135], [63, 191315], [66, 191515], [70, 191715], [73, 191855], [77, 191975], [81, 192175]]}, {"verse": 31, "start": 193304, "end": 198064, "text": "Si pues coméis, o bebéis, o hacéis otra cosa, hacedlo todo a gloria de Dios.", "words": [[0, 193304], [3, 193453], [8, 193693], [16, 194113], [18, 194273], [26, 194673], [28, 194873], [35, 195253], [40, 195453], [46, 196273], [54, 196733], [59, 196953], [61, 197113], [68, 197433], [71, 197573]]}, {"verse": 32, "start": 198514, "end": 202909, "text": "No seáis motivo de tropiezo a judíos, ni a Gentiles, ni a la iglesia de Dios:", "words": [[0, 198514], [3, 198682], [9, 198892], [16, 199332], [19, 199592], [28, 200112], [30, 200232], [38, 200812], [41, 200892], [43, 200972], [53, 201652], [56, 201732], [58, 201812], [61, 201892], [69, 202272], [72, 202412]]}, {"verse": 33, "start": 203359, "end": 210745, "text": "Como también yo en todas las cosas complazco a todos, no procurando mi propio beneficio, sino el de muchos, para que sean salvos.", "words": [[0, 203359], [5, 203515], [13, 203855], [16, 204055], [19, 204175], [25, 204335], [29, 204655], [35, 205155], [45, 205655], [47, 205755], [54, 206415], [57, 206555], [68, 207115], [71, 207295], [78, 207515], [89, 208355], [94, 208655], [97, 208835], [100, 208955], [108, 209235], [113, 209735], [117, 209875], [122, 210075]]}]}