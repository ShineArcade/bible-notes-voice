{"book": "ROM", "chapter": 12, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 135868, "verses": [{"verse": 1, "start": 300, "end": 9768, "text": "I beg you therefore, brethren, by the mercies of God, that you present your bodies a living sacrifice, holy, acceptable to God, which is your reasonable service.", "words": [[0, 300], [2, 445], [6, 685], [10, 925], [21, 1565], [31, 2245], [34, 2365], [38, 2505], [46, 2965], [49, 3085], [54, 3365], [59, 3765], [63, 3905], [71, 4225], [76, 4445], [83, 4825], [85, 5105], [92, 5345], [103, 5995], [109, 6645], [120, 7385], [123, 7745], [128, 8225], [134, 8365], [137, 8505], [142, 8645], [153, 9065]]}, {"verse": 2, "start": 10218, "end": 19371, "text": "And be not conformed to this world: but be transformed by the renewing of your mind, that you may prove what is that good, and acceptable, and perfect, will of God.", "words": [[0, 10218], [4, 10318], [7, 10438], [11, 10658], [21, 11278], [24, 11358], [29, 11518], [36, 12336], [40, 12452], [43, 12612], [55, 13052], [58, 13412], [62, 13532], [71, 13972], [74, 14072], [79, 14192], [85, 14552], [90, 14992], [94, 15132], [98, 15272], [104, 15592], [109, 15792], [112, 15932], [117, 16092], [123, 16392], [127, 16772], [139, 17252], [143, 17852], [152, 18252], [157, 18812], [160, 18952]]}, {"verse": 3, "start": 19821, "end": 31125, "text": "For I say, through the grace given to me, to every man that is among you, not to think of himself more highly than he ought to think; but to think soberly, according as God has dealt to every man the measure of faith.", "words": [[0, 19821], [4, 19925], [6, 20085], [11, 20305], [19, 20565], [23, 20725], [29, 21005], [35, 21325], [38, 21545], [42, 21965], [45, 22165], [51, 22505], [55, 22825], [60, 23005], [63, 23145], [69, 23385], [74, 23865], [78, 24065], [81, 24285], [87, 24465], [90, 24585], [98, 24945], [103, 25205], [110, 25505], [115, 25825], [118, 25985], [124, 26225], [127, 26405], [134, 27075], [138, 27216], [141, 27336], [147, 27536], [156, 28336], [166, 28636], [169, 28896], [173, 29096], [177, 29296], [183, 29516], [186, 29716], [192, 29996], [196, 30276], [200, 30436], [208, 30696], [211, 30816]]}, {"verse": 4, "start": 31575, "end": 35877, "text": "For as we have many members in one body, and all members have not the same office:", "words": [[0, 31575], [4, 31670], [7, 31810], [10, 31950], [15, 32110], [20, 32330], [28, 32650], [31, 32870], [35, 33090], [41, 33430], [45, 33850], [49, 34130], [57, 34470], [62, 34790], [66, 34950], [70, 35130], [75, 35350]]}, {"verse": 5, "start": 36327, "end": 41161, "text": "So we, being many, are one body in Christ, and every one members one of another.", "words": [[0, 36327], [3, 36783], [7, 37063], [13, 37203], [19, 37863], [23, 37963], [27, 38223], [32, 38523], [35, 38643], [43, 39343], [47, 39516], [53, 39690], [57, 39863], [65, 40243], [69, 40663], [72, 40783]]}, {"verse": 6, "start": 41611, "end": 49410, "text": "Having then gifts differing according to the grace that is given to us, whether prophecy, let us prophesy according to the proportion of faith;", "words": [[0, 41611], [7, 41832], [12, 42152], [18, 42492], [28, 43192], [38, 43452], [41, 43752], [45, 43892], [51, 44172], [56, 44492], [59, 44632], [65, 44852], [68, 45112], [72, 45592], [80, 45892], [90, 46892], [94, 47052], [97, 47362], [106, 47672], [116, 48112], [119, 48392], [123, 48512], [134, 48812], [137, 49052]]}, {"verse": 7, "start": 49860, "end": 54489, "text": "Or ministry, let us wait on our ministering: or he that teaches, on teaching;", "words": [[0, 49860], [3, 50003], [13, 50863], [17, 50983], [20, 51143], [25, 51403], [28, 51663], [32, 51783], [45, 52896], [48, 53034], [51, 53134], [56, 53294], [65, 53594], [68, 53934]]}, {"verse": 8, "start": 54939, "end": 64380, "text": "Or he that exhorts, on exhortation: he that gives, let him do it with simplicity; he that rules, with diligence; he that shows mercy, with cheerfulness.", "words": [[0, 54939], [3, 55059], [6, 55179], [11, 55359], [20, 56099], [23, 56399], [36, 57744], [39, 57837], [44, 58037], [51, 58537], [55, 58737], [59, 58937], [62, 59197], [65, 59337], [70, 59517], [82, 60581], [85, 60678], [90, 60838], [97, 61178], [102, 61478], [113, 62406], [116, 62472], [121, 62662], [127, 62852], [134, 63292], [139, 63532]]}, {"verse": 9, "start": 64830, "end": 69744, "text": "Let love be without hypocrisy. Abhor that which is evil; cleave to that which is good.", "words": [[0, 64830], [4, 64971], [9, 65211], [12, 65471], [20, 65771], [31, 67029], [37, 67239], [42, 67459], [48, 67679], [51, 67859], [57, 68503], [64, 68760], [67, 68860], [72, 69040], [78, 69240], [81, 69400]]}, {"verse": 10, "start": 70194, "end": 74636, "text": "Be kindly affectioned one to another with brotherly love; in honour preferring one another;", "words": [[0, 70194], [3, 70317], [10, 70637], [22, 71257], [26, 71417], [29, 71597], [37, 71877], [42, 72077], [52, 72477], [58, 73097], [61, 73252], [68, 73442], [79, 74002], [83, 74162]]}, {"verse": 11, "start": 75086, "end": 79083, "text": "Not slothful in business; fervent in spirit; serving the Lord;", "words": [[0, 75086], [4, 75250], [13, 75810], [16, 75930], [26, 76987], [34, 77227], [37, 77367], [45, 78147], [53, 78491], [57, 78671]]}, {"verse": 12, "start": 79533, "end": 84089, "text": "Rejoicing in hope; patient in tribulation; continuing instant in prayer;", "words": [[0, 79533], [10, 80110], [13, 80270], [19, 80930], [27, 81194], [30, 81414], [43, 82468], [54, 82890], [62, 83350], [65, 83670]]}, {"verse": 13, "start": 84539, "end": 88447, "text": "Distributing to the necessity of saints; given to hospitality.", "words": [[0, 84539], [13, 85239], [16, 85499], [20, 85639], [30, 86059], [33, 86319], [41, 87152], [47, 87391], [50, 87591]]}, {"verse": 14, "start": 88897, "end": 92188, "text": "Bless them which persecute you: bless, and curse not.", "words": [[0, 88897], [6, 89160], [11, 89420], [17, 89600], [27, 90200], [32, 90723], [39, 91007], [43, 91467], [49, 91687]]}, {"verse": 15, "start": 92638, "end": 95856, "text": "Rejoice with them that do rejoice, and weep with them that weep.", "words": [[0, 92638], [8, 93098], [13, 93258], [18, 93418], [23, 93598], [26, 93758], [35, 94138], [39, 94658], [44, 94998], [49, 95138], [54, 95278], [59, 95458]]}, {"verse": 16, "start": 96306, "end": 103733, "text": "Be of the same mind one toward another. Mind not high things, but condescend to men of low estate. Be not wise in your own conceits.", "words": [[0, 96306], [3, 96443], [6, 96563], [10, 96723], [15, 96903], [20, 97263], [24, 97443], [31, 97683], [40, 98548], [45, 98788], [49, 99008], [54, 99248], [62, 99748], [66, 99988], [77, 100608], [80, 100748], [84, 100928], [87, 101068], [91, 101268], [99, 102058], [102, 102138], [106, 102298], [111, 102598], [114, 102858], [119, 102978], [123, 103078]]}, {"verse": 17, "start": 104183, "end": 108980, "text": "Recompense to no man evil for evil. Provide things honest in the sight of all men.", "words": [[0, 104183], [11, 104763], [14, 104943], [17, 105143], [21, 105363], [26, 105743], [30, 106003], [36, 106676], [44, 107033], [51, 107193], [58, 107633], [61, 107853], [65, 107953], [71, 108193], [74, 108313], [78, 108553]]}, {"verse": 18, "start": 109430, "end": 114136, "text": "If it be possible, as much as lies in you, live peaceably with all men.", "words": [[0, 109430], [3, 109575], [6, 109675], [9, 109775], [19, 110715], [22, 110835], [27, 111095], [30, 111235], [35, 111435], [38, 111655], [43, 112235], [48, 112475], [58, 113155], [63, 113435], [67, 113675]]}, {"verse": 19, "start": 114586, "end": 124264, "text": "Dearly beloved, avenge not yourselves, but rather give place to wrath: for it is written, Vengeance is mine; I will repay, says the Lord.", "words": [[0, 114586], [7, 115003], [16, 115363], [23, 115923], [27, 116063], [39, 117003], [43, 117103], [50, 117403], [55, 117603], [61, 117863], [64, 118063], [71, 118813], [75, 118958], [78, 119058], [81, 119198], [90, 120019], [100, 120686], [103, 120866], [109, 122031], [111, 122160], [116, 122300], [123, 123588], [128, 123724], [132, 123884]]}, {"verse": 20, "start": 124714, "end": 131595, "text": "Therefore if your enemy hunger, feed him; if he thirst, give him drink: for in so doing you shall heap coals of fire on his head.", "words": [[0, 124714], [10, 125233], [13, 125333], [18, 125453], [24, 125733], [32, 126353], [37, 126493], [42, 127175], [45, 127313], [48, 127433], [56, 128013], [61, 128093], [65, 128253], [72, 128953], [76, 129058], [79, 129238], [82, 129418], [88, 129658], [92, 129898], [98, 130058], [103, 130258], [109, 130658], [112, 130738], [117, 130998], [120, 131158], [124, 131258]]}, {"verse": 21, "start": 132045, "end": 135468, "text": "Be not overcome of evil, but overcome evil with good.", "words": [[0, 132045], [3, 132160], [7, 132380], [16, 132860], [19, 133100], [25, 133660], [29, 133840], [38, 134320], [43, 134700], [48, 135020]]}]}