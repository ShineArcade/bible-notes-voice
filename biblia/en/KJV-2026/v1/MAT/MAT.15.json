{"book": "MAT", "chapter": 15, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 269629, "verses": [{"verse": 1, "start": 300, "end": 5167, "text": "Then came to Jesus scribes and Pharisees, which were of Jerusalem, saying,", "words": [[0, 300], [5, 486], [10, 786], [13, 986], [19, 1586], [27, 1926], [31, 2046], [42, 3206], [48, 3486], [53, 3726], [56, 3866], [67, 4646]]}, {"verse": 2, "start": 5417, "end": 11223, "text": "Why do your disciples transgress the tradition of the elders? for they wash not their hands when they eat bread.", "words": [[0, 5417], [4, 5661], [7, 5861], [12, 6021], [22, 6501], [33, 7141], [37, 7361], [47, 7841], [50, 8041], [54, 8181], [62, 8965], [66, 9035], [71, 9195], [76, 9495], [80, 9715], [86, 9955], [92, 10275], [97, 10475], [102, 10635], [106, 10815]]}, {"verse": 3, "start": 11573, "end": 17398, "text": "But he answered and said to them, Why do you also transgress the commandment of God by your tradition?", "words": [[0, 11573], [4, 11758], [7, 11938], [16, 12398], [20, 12718], [25, 12998], [28, 13198], [34, 13814], [38, 13980], [41, 14120], [45, 14260], [50, 14520], [61, 15140], [65, 15340], [77, 15860], [80, 16040], [84, 16340], [87, 16640], [92, 16780]]}, {"verse": 4, "start": 17848, "end": 25076, "text": "For God commanded, saying, Honour your father and mother: and, He that curses father or mother, let him die the death.", "words": [[0, 17848], [4, 17952], [8, 18152], [19, 18512], [27, 18992], [34, 19472], [39, 19692], [46, 19972], [50, 20252], [58, 21800], [63, 21800], [66, 21946], [71, 22146], [78, 22526], [85, 22866], [88, 23066], [96, 23566], [100, 23726], [104, 23866], [108, 24126], [112, 24266]]}, {"verse": 5, "start": 25526, "end": 31425, "text": "But you say, Whoever shall say to his father or his mother, It is a gift, by whatever you might be profited by me;", "words": [[0, 25526], [4, 25626], [8, 25786], [13, 26046], [21, 26306], [27, 26586], [31, 26806], [34, 26926], [38, 27066], [45, 27386], [48, 27626], [52, 27786], [60, 28506], [63, 28646], [66, 28786], [68, 28886], [74, 29186], [77, 29666], [86, 29906], [90, 30126], [96, 30266], [99, 30426], [108, 30846], [111, 31066]]}, {"verse": 6, "start": 31875, "end": 39543, "text": "And honour not his father or his mother, he shall be free. Thus have you made the commandment of God of none effect by your tradition.", "words": [[0, 31875], [4, 32090], [11, 32340], [15, 32580], [19, 32820], [26, 33160], [29, 33440], [33, 33660], [41, 34320], [44, 34400], [50, 34620], [53, 34780], [59, 35536], [64, 35760], [69, 36020], [73, 36140], [78, 36320], [82, 36460], [94, 37040], [97, 37200], [101, 37500], [104, 37660], [109, 38140], [116, 38400], [119, 38700], [124, 38840]]}, {"verse": 7, "start": 39993, "end": 43420, "text": "You hypocrites, well did Esaias prophesy of you, saying,", "words": [[0, 39993], [4, 40150], [16, 40790], [21, 40990], [25, 41410], [32, 41830], [41, 42250], [44, 42550], [49, 42870]]}, {"verse": 8, "start": 43870, "end": 49285, "text": "This people draws near to me with their mouth, and honours me with their lips; but their heart is far from me.", "words": [[0, 43870], [5, 44006], [12, 44306], [18, 44626], [23, 44886], [26, 45066], [29, 45206], [34, 45386], [40, 45526], [47, 45846], [51, 46186], [59, 46526], [62, 46766], [67, 46926], [73, 47066], [79, 47898], [83, 47995], [89, 48135], [95, 48375], [98, 48515], [102, 48795], [107, 49015]]}, {"verse": 9, "start": 49735, "end": 54638, "text": "But in vain they do worship me, teaching for doctrines the commandments of men.", "words": [[0, 49735], [4, 49839], [7, 50019], [12, 50299], [17, 50619], [20, 50879], [28, 51239], [32, 51999], [41, 52379], [45, 52679], [55, 53299], [59, 53439], [72, 53879], [75, 54219]]}, {"verse": 10, "start": 54988, "end": 59270, "text": "¶ And he called the multitude, and said to them, Hear, and understand:", "words": [[2, 54988], [6, 55110], [9, 55210], [16, 55490], [20, 55670], [31, 56150], [35, 56790], [40, 57030], [43, 57210], [49, 57755], [55, 58035], [59, 58335]]}, {"verse": 11, "start": 59720, "end": 65977, "text": "Not that which goes into the mouth defiles a man; but that which comes out of the mouth, this defiles a man.", "words": [[0, 59720], [4, 59880], [9, 60100], [15, 60300], [20, 60520], [25, 60780], [29, 60920], [35, 61240], [43, 61800], [45, 61939], [50, 62692], [54, 62792], [59, 62972], [65, 63172], [71, 63472], [75, 63812], [78, 63952], [82, 64052], [89, 64552], [94, 64872], [102, 65432], [104, 65552]]}, {"verse": 12, "start": 66327, "end": 72790, "text": "Then came his disciples, and said to him, Do you know that the Pharisees were offended, after they heard this saying?", "words": [[0, 66327], [5, 66610], [10, 66910], [14, 67170], [25, 68390], [29, 68510], [34, 68770], [37, 68970], [42, 69652], [45, 69730], [49, 69870], [54, 70010], [59, 70170], [63, 70270], [73, 70850], [78, 70970], [88, 71370], [94, 71690], [99, 71890], [105, 72110], [110, 72330]]}, {"verse": 13, "start": 73140, "end": 80079, "text": "But he answered and said, Every plant, which my heavenly Father has not planted, shall be rooted up.", "words": [[0, 73140], [4, 73267], [7, 73407], [16, 73827], [20, 74027], [26, 76163], [32, 76381], [39, 76721], [45, 76981], [48, 77161], [57, 77461], [64, 77821], [68, 78061], [72, 78241], [81, 78661], [87, 79181], [90, 79381], [97, 79621]]}, {"verse": 14, "start": 80529, "end": 88163, "text": "Let them alone: they are blind leaders of the blind. And if the blind lead the blind, both shall fall into the ditch.", "words": [[0, 80529], [4, 80650], [9, 80810], [16, 81669], [21, 81989], [25, 82089], [31, 82389], [39, 82889], [42, 83269], [46, 83389], [53, 84276], [57, 84440], [60, 84560], [64, 84680], [70, 85060], [75, 85400], [79, 85560], [86, 86280], [91, 86620], [97, 86960], [102, 87220], [107, 87480], [111, 87660]]}, {"verse": 15, "start": 88513, "end": 91903, "text": "Then answered Peter and said to him, Declare to us this parable.", "words": [[0, 88513], [5, 88685], [14, 89045], [20, 89325], [24, 89545], [29, 89705], [32, 89885], [37, 90593], [45, 90783], [48, 91063], [51, 91203], [56, 91383]]}, {"verse": 16, "start": 92253, "end": 95673, "text": "And Jesus said, Are you also yet without understanding?", "words": [[0, 92253], [4, 92375], [10, 92695], [16, 93622], [20, 93728], [24, 93848], [29, 94168], [33, 94448], [41, 94748]]}, {"verse": 17, "start": 96123, "end": 102337, "text": "Do not you yet understand, that whatever enters in at the mouth goes into the belly, and is cast out into the draught?", "words": [[0, 96123], [3, 96219], [7, 96379], [11, 96579], [15, 96799], [27, 97359], [32, 97919], [41, 98159], [48, 98559], [51, 98819], [54, 98939], [58, 99039], [64, 99299], [69, 99579], [74, 99859], [78, 99999], [85, 100279], [89, 100719], [92, 100839], [97, 101119], [101, 101419], [106, 101619], [110, 102004]]}, {"verse": 18, "start": 102787, "end": 107721, "text": "But those things which proceed out of the mouth come forth from the heart; and they defile the man.", "words": [[0, 102787], [4, 102871], [10, 103071], [17, 103451], [23, 103651], [31, 104091], [35, 104411], [38, 104531], [42, 104631], [48, 104911], [53, 105211], [59, 105491], [64, 105711], [68, 105831], [75, 106524], [79, 106642], [84, 106762], [91, 107202], [95, 107342]]}, {"verse": 19, "start": 108171, "end": 114782, "text": "For out of the heart proceed evil thoughts, murders, adulteries, fornications, thefts, false witness, blasphemies:", "words": [[0, 108171], [4, 108273], [8, 108393], [11, 108493], [15, 108573], [21, 108733], [29, 109113], [34, 109433], [44, 110173], [53, 110693], [65, 111473], [79, 112473], [87, 113073], [93, 113293], [102, 113973]]}, {"verse": 20, "start": 115232, "end": 120962, "text": "These are the things which defile a man: but to eat with unwashed hands defiles not a man.", "words": [[0, 115232], [6, 115418], [10, 115638], [14, 115738], [21, 116038], [27, 116278], [34, 116818], [36, 116938], [41, 117745], [45, 117842], [48, 117982], [52, 118162], [57, 118342], [66, 118942], [72, 119382], [80, 120082], [84, 120382], [86, 120562]]}, {"verse": 21, "start": 121312, "end": 126633, "text": "¶ Then Jesus went from there, and departed into the coasts of Tyre and Sidon.", "words": [[2, 121312], [7, 121594], [13, 121934], [18, 122334], [23, 122574], [30, 122934], [34, 123514], [43, 123894], [48, 124234], [52, 124414], [59, 125074], [62, 125154], [67, 125754], [71, 125874]]}, {"verse": 22, "start": 127083, "end": 139698, "text": "And, behold, a woman of Canaan came out of the same coasts, and cried to him, saying, Have mercy on me, O Lord, you Son of David; my daughter is severely tormented by a demon.", "words": [[0, 127083], [5, 127262], [13, 128122], [15, 128362], [21, 128642], [24, 128802], [31, 129282], [36, 129642], [40, 129902], [43, 130022], [47, 130162], [52, 130382], [60, 131142], [64, 131462], [70, 131822], [73, 132062], [78, 132482], [86, 133408], [91, 133588], [97, 133988], [100, 134268], [104, 134548], [106, 134648], [112, 135368], [116, 135508], [120, 135848], [123, 135988], [130, 136862], [133, 137030], [142, 137290], [145, 137550], [154, 138010], [164, 138730], [167, 138990], [169, 139110]]}, {"verse": 23, "start": 140048, "end": 147781, "text": "But he answered her not a word. And his disciples came and besought him, saying, Send her away; for she cries after us.", "words": [[0, 140048], [4, 140173], [7, 140273], [16, 140673], [20, 140893], [24, 141153], [26, 141353], [32, 142176], [36, 142339], [40, 142479], [50, 143019], [55, 143419], [59, 143759], [68, 144159], [73, 144539], [81, 145360], [86, 145537], [90, 145697], [96, 146459], [100, 146586], [104, 146726], [110, 147006], [116, 147366]]}, {"verse": 24, "start": 148131, "end": 154679, "text": "But he answered and said, I am not sent but to the lost sheep of the house of Israel.", "words": [[0, 148131], [4, 148258], [7, 148398], [16, 148818], [20, 149018], [26, 151154], [28, 151344], [31, 151444], [35, 151644], [40, 152004], [