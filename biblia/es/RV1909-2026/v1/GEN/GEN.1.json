{"book": "GEN", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 289436, "verses": [{"verse": 1, "start": 300, "end": 4091, "text": "En el principio creó Dios los cielos y la tierra.", "words": [[0, 300], [3, 466], [6, 586], [16, 1086], [21, 1846], [26, 2106], [30, 2486], [37, 3166], [39, 3366], [42, 3486]]}, {"verse": 2, "start": 4541, "end": 16624, "text": "Y la tierra estaba desordenada y vacía, y las tinieblas estaban sobre la superficie del abismo, y el Espíritu de Dios se movía sobre la superficie de las aguas.", "words": [[0, 4541], [2, 4644], [5, 4764], [12, 5104], [19, 5604], [31, 6544], [33, 6684], [40, 7724], [42, 7944], [46, 8124], [56, 8764], [64, 9144], [70, 9604], [73, 9804], [84, 10684], [88, 10844], [96, 11744], [98, 12044], [101, 12164], [110, 12844], [113, 12964], [118, 13284], [121, 13624], [127, 14164], [133, 14444], [136, 14664], [147, 15664], [150, 15784], [154, 15944]]}, {"verse": 3, "start": 17074, "end": 21057, "text": "Y dijo Dios: Sea la luz: y fue la luz.", "words": [[0, 17074], [2, 17218], [7, 17518], [13, 18396], [17, 18660], [20, 18860], [25, 19934], [27, 20061], [31, 20241], [34, 20421]]}, {"verse": 4, "start": 21507, "end": 26905, "text": "Y vio Dios que la luz era buena: y apartó Dios la luz de las tinieblas.", "words": [[0, 21507], [2, 21649], [6, 21849], [11, 22149], [15, 22409], [18, 22549], [22, 22809], [26, 23069], [33, 24009], [35, 24271], [42, 24831], [47, 25071], [50, 25451], [54, 25711], [57, 25891], [61, 26011]]}, {"verse": 5, "start": 27355, "end": 33467, "text": "Y llamó Dios a la luz Día, y a las tinieblas llamó Noche: y fue la tarde y la mañana un día.", "words": [[0, 27355], [2, 27462], [8, 27782], [13, 28022], [15, 28262], [18, 28342], [22, 28542], [27, 28902], [29, 29182], [31, 29495], [35, 29809], [45, 30122], [51, 30402], [58, 31360], [60, 31504], [64, 31664], [67, 31824], [73, 32124], [75, 32324], [78, 32424], [85, 32764], [88, 33004]]}, {"verse": 6, "start": 33917, "end": 40233, "text": "Y dijo Dios: Haya expansión en medio de las aguas, y separe las aguas de las aguas.", "words": [[0, 33917], [2, 34061], [7, 34361], [13, 35240], [18, 35444], [28, 36184], [31, 36344], [37, 36584], [40, 36764], [44, 36944], [51, 37504], [53, 37984], [60, 38464], [64, 38664], [70, 39064], [73, 39164], [77, 39324]]}, {"verse": 7, "start": 40583, "end": 51453, "text": "E hizo Dios la expansión, y apartó las aguas que estaban debajo de la expansión, de las aguas que estaban sobre la expansión: y fue así.", "words": [[0, 40583], [2, 40731], [7, 41011], [12, 41331], [15, 41531], [26, 42671], [28, 42951], [35, 43491], [39, 43691], [45, 44091], [49, 44211], [57, 44511], [64, 44931], [67, 45091], [70, 45211], [81, 46131], [84, 46451], [88, 46611], [94, 47071], [98, 47171], [106, 47511], [112, 47831], [115, 48011], [126, 50572], [128, 50688], [132, 50888]]}, {"verse": 8, "start": 51903, "end": 57467, "text": "Y llamó Dios a la expansión Cielos: y fue la tarde y la mañana el día segundo.", "words": [[0, 51903], [2, 51903], [8, 51903], [13, 51903], [15, 52035], [18, 52135], [28, 52895], [36, 54126], [38, 54283], [42, 54423], [45, 54603], [51, 54982], [53, 55442], [56, 55582], [63, 56363], [66, 56463], [70, 56683]]}, {"verse": 9, "start": 57917, "end": 66782, "text": "Y dijo Dios: Júntense las aguas que están debajo de los cielos en un lugar, y descúbrase la seca: y fue así.", "words": [[0, 57917], [2, 58062], [7, 58362], [13, 59240], [22, 59778], [26, 60018], [32, 60498], [36, 60618], [42, 60898], [49, 61378], [52, 61558], [56, 61658], [63, 62138], [66, 62278], [69, 62378], [76, 62698], [78, 63318], [89, 63998], [92, 64158], [98, 65901], [100, 66017], [104, 66217]]}, {"verse": 10, "start": 67232, "end": 73990, "text": "Y llamó Dios a la seca Tierra, y a la reunión de las aguas llamó Mares: y vio Dios que era bueno.", "words": [[0, 67232], [2, 67356], [8, 67696], [13, 67916], [15, 68156], [18, 68236], [23, 68576], [31, 69036], [33, 69536], [35, 69636], [38, 69736], [46, 70296], [49, 70436], [53, 70616], [59, 70976], [65, 71276], [72, 72163], [74, 72305], [78, 72525], [83, 72765], [87, 73225], [91, 73405]]}, {"verse": 11, "start": 74440, "end": 87296, "text": "Y dijo Dios: Produzca la tierra hierba verde, hierba que dé semilla; árbol de fruto que dé fruto según su género, cuya semilla esté en él, sobre la tierra: y fue así.", "words": [[0, 74440], [2, 74584], [7, 74884], [13, 75763], [22, 76342], [25, 76482], [32, 76782], [39, 77322], [46, 78142], [53, 78722], [57, 78862], [60, 79022], [69, 80265], [75, 80666], [78, 80806], [84, 81206], [88, 81346], [91, 81506], [97, 81966], [103, 82166], [106, 82386], [114, 83146], [119, 83526], [127, 83986], [132, 84246], [135, 84486], [139, 84686], [145, 85046], [148, 85246], [156, 86415], [158, 86530], [162, 86730]]}, {"verse": 12, "start": 87746, "end": 99524, "text": "Y produjo la tierra hierba verde que da semilla según su naturaleza, y árbol que da fruto, cuya semilla está en él, según su género: y vio Dios que era bueno.", "words": [[0, 87746], [2, 87851], [10, 88431], [13, 88611], [20, 88991], [27, 89551], [33, 89891], [37, 90151], [40, 90311], [48, 90891], [54, 91191], [57, 91471], [69, 92331], [71, 92771], [77, 93211], [81, 93431], [84, 93591], [91, 94151], [96, 94751], [104, 95191], [109, 95471], [112, 95711], [116, 96071], [122, 96431], [125, 96751], [133, 97697], [135, 97839], [139, 98059], [144, 98299], [148, 98759], [152, 98939]]}, {"verse": 13, "start": 99974, "end": 103135, "text": "Y fue la tarde y la mañana el día tercero.", "words": [[0, 99974], [2, 100100], [6, 100240], [9, 100400], [15, 100780], [17, 101520], [20, 101660], [27, 102000], [30, 102260], [34, 102400]]}, {"verse": 14, "start": 103585, "end": 114242, "text": "Y dijo Dios: Haya luminarias en la expansión de los cielos para separar el día de la noche; y sirvan de señales para las estaciones, para días y años;", "words": [[0, 103585], [2, 103729], [7, 104029], [13, 105204], [18, 105538], [29, 105871], [32, 106011], [35, 106091], [45, 106671], [48, 106811], [52, 106891], [59, 107371], [64, 107571], [72, 108091], [75, 108171], [79, 108371], [82, 108491], [85, 108591], [92, 109679], [94, 109776], [101, 110216], [104, 110336], [112, 110896], [117, 111136], [121, 111336], [133, 111996], [138, 112596], [143, 112956], [145, 113396]]}, {"verse": 15, "start": 114692, "end": 120987, "text": "Y sean por lumbreras en la expansión de los cielos para alumbrar sobre la tierra: y fue así.", "words": [[0, 114692], [2, 114793], [7, 115053], [11, 115273], [21, 115833], [24, 116073], [27, 116173], [37, 116813], [40, 116973], [44, 117093], [51, 117633], [56, 117973], [65, 118533], [71, 118813], [74, 118993], [82, 120106], [84, 120221], [88, 120421]]}, {"verse": 16, "start": 121437, "end": 133866, "text": "E hizo Dios las dos grandes luminarias; la luminaria mayor para que señorease en el día, y la luminaria menor para que señorease en la noche: hizo también las estrellas.", "words": [[0, 121437], [2, 121579], [7, 121879], [12, 122219], [16, 122599], [20, 122819], [28, 123079], [40, 124516], [43, 124621], [53, 125161], [59, 125541], [64, 126061], [68, 126561], [78, 127061], [81, 127381], [84, 127541], [89, 127881], [91, 128441], [94, 128581], [104, 129201], [110, 129541], [115, 129901], [119, 130371], [129, 130841], [132, 131041], [135, 131181], [142, 132179], [147, 132309], [155, 132629], [159, 132869]]}, {"verse": 17, "start": 134316, "end": 140283, "text": "Y las puso Dios en la expansión de los cielos, para alumbrar sobre la tierra,", "words": [[0, 134316], [2, 134436], [6, 134556], [11, 134916], [16, 135176], [19, 135436], [22, 135616], [32, 136436], [35, 136616], [39, 136736], [47, 137656], [52, 138036], [61, 138876], [67, 139296], [70, 139516]]}, {"verse": 18, "start": 140733, "end": 149350, "text": "Y para señorear en el día y en la noche, y para apartar la luz y las tinieblas: y vio Dios que era bueno.", "words": [[0, 140733], [2, 140839], [7, 141059], [16, 141939], [19, 142179], [22, 142359], [26, 142659], [28, 142899], [31, 143059], [34, 143239], [41, 143999], [43, 144079], [48, 144319], [56, 145159], [59, 145419], [63, 145799], [65, 146159], [69, 146279], [80, 147523], [82, 147665], [86, 147885], [91, 148125], [95, 148585], [99, 148765]]}, {"verse": 19, "start": 149800, "end": 152563, "text": "Y fue la tarde y la mañana el día cuarto.", "words": [[0, 149800], [2, 149908], [6, 150128], [9, 150488], [15, 150808], [17, 151108], [20, 151208], [27, 151548], [30, 151788], [34, 151908]]}, {"verse": 20, "start": 153013, "end": 161355, "text": "Y dijo Dios: Produzcan las aguas seres vivientes, y aves que vuelen sobre la tierra, en la abierta expansión de los cielos.", "words": [[0, 153013], [2, 153158], [7, 153458], [13, 154560], [23, 154820], [27, 155000], [33, 155480], [39, 155700], [50, 156360], [52, 156960], [57, 157220], [61, 157420], [68, 157780], [74, 157960], [77, 158140], [85, 158520], [88, 159040], [91, 159140], [99, 159560], [109, 160160], [112, 160320], [116, 160440]]}, {"verse": 21, "start": 161705, "end": 175275, "text": "Y creó Dios los grandes animales marinos, y todo ser viviente que se mueve, que las aguas produjeron según su género, y toda ave alada según su especie: y vio Dios que era bueno.", "words": [[0, 161705], [2, 161918], [7, 162172], [12, 162425], [16, 163085], [24, 163425], [33, 163965], [42, 164605], [44, 165145], [49, 165445], [53, 165765], [62, 166345], [66, 166545], [69, 166705], [76, 167225], [80, 167645], [84, 167845], [90, 168265], [101, 168985], [107, 169285], [110, 169585], [118, 170405], [120, 170585], [125, 170885], [129, 171365], [135, 171905], [141, 172245], [144, 172485], [153, 173448], [155, 173589], [159, 173809], [164, 174049], [168, 174509], [172, 174689]]}, {"verse": 22, "start": 175725, "end": 185370, "text": "Y Dios los bendijo diciendo: Fructificad y multiplicaos, y llenad las aguas en los mares, y las aves se multipliquen en la tierra.", "words": [[0, 175725], [2, 175848], [7, 176238], [1