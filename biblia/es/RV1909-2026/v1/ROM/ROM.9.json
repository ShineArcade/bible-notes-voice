{"book": "ROM", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 230354, "verses": [{"verse": 1, "start": 300, "end": 5874, "text": "Verdad digo en Cristo, no miento, dándome testimonio mi conciencia en el Espíritu Santo,", "words": [[0, 300], [7, 591], [12, 891], [15, 1091], [23, 1911], [26, 1991], [34, 2891], [42, 3271], [53, 3931], [56, 4031], [67, 4651], [70, 4791], [73, 4891], [82, 5391]]}, {"verse": 2, "start": 6224, "end": 9200, "text": "Que tengo gran tristeza y continuo dolor en mi corazón.", "words": [[0, 6224], [4, 6285], [10, 6485], [15, 6745], [24, 7385], [26, 7465], [35, 7985], [41, 8265], [44, 8425], [47, 8525]]}, {"verse": 3, "start": 9550, "end": 15451, "text": "Porque deseara yo mismo ser apartado de Cristo por mis hermanos, los que son mis parientes según la carne;", "words": [[0, 9550], [7, 9960], [15, 10370], [18, 10530], [24, 10770], [28, 11050], [37, 11550], [40, 11710], [47, 12030], [51, 12290], [55, 12430], [65, 13330], [69, 13510], [73, 13650], [77, 13810], [81, 13970], [91, 14490], [97, 14770], [100, 14950]]}, {"verse": 4, "start": 15801, "end": 22974, "text": "Que son israelitas, de los cuales es la adopción, y la gloria, y el pacto, y la entrega de la ley, y el culto, y las promesas;", "words": [[0, 15801], [4, 15896], [8, 16076], [20, 16776], [23, 16956], [27, 17076], [34, 17336], [37, 17636], [40, 17796], [50, 18336], [52, 18616], [55, 18736], [63, 19216], [65, 19436], [68, 19556], [75, 20096], [77, 20216], [80, 20316], [88, 20716], [91, 20776], [94, 20896], [99, 21136], [101, 21376], [104, 21496], [111, 21976], [113, 22096], [117, 22236]]}, {"verse": 5, "start": 23324, "end": 31914, "text": "Cuyos son los padres, y de los cuales es Cristo según la carne, el cual es Dios sobre todas las cosas, bendito por los siglos. Amén.", "words": [[0, 23324], [6, 23663], [10, 23803], [14, 23923], [22, 24303], [24, 24723], [27, 24823], [31, 24943], [38, 25223], [41, 25583], [48, 25983], [54, 26283], [57, 26483], [64, 27343], [67, 27403], [72, 27643], [75, 27843], [80, 28083], [86, 28383], [92, 28663], [96, 28963], [103, 29343], [111, 30363], [115, 30563], [119, 30723], [127, 31489]]}, {"verse": 6, "start": 32264, "end": 38495, "text": "Pero no es que la palabra de Dios haya faltado: porque no todos los que son de Israel son israelitas;", "words": [[0, 32264], [5, 32422], [8, 32602], [11, 32802], [15, 32922], [18, 33062], [26, 33402], [29, 33602], [34, 33862], [39, 34242], [48, 35220], [55, 35442], [58, 35662], [64, 36002], [68, 36282], [72, 36462], [76, 36702], [79, 36822], [86, 37142], [90, 37542]]}, {"verse": 7, "start": 38845, "end": 46049, "text": "Ni por ser simiente de Abraham, son todos hijos; pero: En Isaac te será llamada descendencia.", "words": [[0, 38845], [3, 38966], [7, 39126], [11, 39346], [20, 39866], [23, 40046], [32, 40466], [36, 40986], [42, 41286], [49, 42171], [55, 43039], [58, 43199], [64, 43609], [67, 44019], [72, 44279], [80, 44819]]}, {"verse": 8, "start": 46506, "end": 54522, "text": "Quiere decir: No los que son hijos de la carne, estos son los hijos de Dios; sino que los que son hijos de la promesa, son contados como descendientes.", "words": [[0, 46506], [7, 46682], [14, 47442], [17, 47581], [21, 47721], [25, 47841], [29, 48041], [35, 48241], [38, 48381], [41, 48481], [48, 48981], [54, 49201], [58, 49441], [62, 49561], [68, 49781], [71, 50001], [77, 50689], [82, 50873], [86, 51033], [90, 51153], [94, 51293], [98, 51453], [104, 51693], [107, 51833], [110, 51913], [119, 52433], [123, 52793], [132, 53313], [137, 53513]]}, {"verse": 9, "start": 54872, "end": 61322, "text": "Porque la palabra de la promesa es esta: Como en este tiempo vendré, y tendrá Sara un hijo.", "words": [[0, 54872], [7, 55076], [10, 55256], [18, 55596], [21, 55756], [24, 55856], [32, 56396], [35, 56696], [41, 57565], [46, 57762], [49, 57902], [54, 58102], [61, 58542], [69, 59122], [71, 59602], [78, 60062], [83, 60442], [86, 60822]]}, {"verse": 10, "start": 61771, "end": 67303, "text": "Y no solo esto, sino que también a Rebeca, habiendo concebido de uno, de Isaac nuestro padre,", "words": [[0, 61771], [2, 61873], [5, 61973], [10, 62193], [16, 62873], [21, 63033], [25, 63173], [33, 63453], [35, 63613], [43, 64273], [52, 64613], [62, 65193], [65, 65353], [70, 65993], [73, 66253], [79, 66513], [87, 66713]]}, {"verse": 11, "start": 67653, "end": 77839, "text": "(Porque no siendo aún nacidos, ni habiendo hecho aún ni bien ni mal, para que el propósito de Dios conforme a la elección, no por las obras sino por el que llama, permaneciese;)", "words": [[0, 67653], [8, 67819], [11, 68019], [18, 68299], [22, 68559], [31, 69199], [34, 69679], [43, 70059], [49, 70359], [53, 70619], [56, 70819], [61, 71099], [64, 71279], [69, 71599], [74, 72159], [78, 72299], [81, 72419], [91, 72939], [94, 73059], [99, 73259], [108, 73799], [110, 73859], [113, 73919], [123, 74830], [126, 74955], [130, 75155], [134, 75295], [140, 75595], [145, 76035], [149, 76255], [152, 76355], [156, 76475], [163, 76815]]}, {"verse": 12, "start": 78189, "end": 80498, "text": "Le fue dicho que el mayor serviría al menor.", "words": [[0, 78189], [3, 78309], [7, 78469], [13, 78769], [17, 78969], [20, 79069], [26, 79349], [35, 79969], [38, 80089]]}, {"verse": 13, "start": 80848, "end": 84383, "text": "Como está escrito: A Jacob amé, mas a Esaú aborrecí.", "words": [[0, 80848], [5, 80992], [10, 81152], [19, 81965], [21, 82103], [27, 82343], [32, 82803], [36, 83043], [38, 83223], [43, 83803]]}, {"verse": 14, "start": 84848, "end": 88804, "text": "¿Pues qué diremos? ¿Que hay injusticia en Dios? En ninguna manera.", "words": [[0, 84848], [6, 84993], [10, 85133], [19, 85983], [24, 86085], [28, 86265], [39, 86905], [42, 87105], [48, 87835], [51, 87956], [59, 88216]]}, {"verse": 15, "start": 89154, "end": 96635, "text": "Pero a Moisés dice: Tendré misericordia del que tendré misericordia, y me compadeceré del que me compadeceré.", "words": [[0, 89154], [5, 89275], [7, 89415], [14, 89715], [20, 90593], [27, 90915], [40, 91875], [44, 92035], [48, 92215], [55, 92615], [69, 93575], [71, 94015], [74, 94135], [86, 95175], [90, 95375], [94, 95535], [97, 95675]]}, {"verse": 16, "start": 97102, "end": 101590, "text": "Así que no es del que quiere, ni del que corre, sino de Dios que tiene misericordia.", "words": [[0, 97102], [4, 97277], [8, 97417], [11, 97597], [14, 97737], [18, 97837], [22, 97997], [30, 98357], [33, 98717], [37, 98877], [41, 98977], [48, 99697], [53, 99857], [56, 100037], [61, 100297], [65, 100497], [71, 100697]]}, {"verse": 17, "start": 101940, "end": 111099, "text": "Porque la Escritura dice de Faraón: Que para esto mismo te he levantado, para mostrar en ti mi poder, y que mi nombre sea anunciado por toda la tierra.", "words": [[0, 101940], [7, 102107], [10, 102267], [20, 102787], [25, 103007], [28, 103437], [36, 104033], [40, 104114], [45, 104354], [50, 104654], [56, 105014], [59, 105314], [62, 105414], [73, 106134], [78, 106714], [86, 107154], [89, 107434], [92, 107614], [95, 107754], [102, 108154], [104, 108339], [108, 108439], [111, 108599], [118, 108899], [122, 109219], [132, 109879], [136, 110099], [141, 110319], [144, 110519]]}, {"verse": 18, "start": 111561, "end": 116952, "text": "De manera que Dios tiene misericordia de quien él quiere; y endurece a quien él quiere endurecer.", "words": [[0, 111561], [3, 111666], [10, 111866], [14, 112146], [19, 112346], [25, 112786], [38, 113646], [41, 113766], [47, 113966], [50, 114126], [58, 114884], [60, 114985], [69, 115485], [71, 115625], [77, 115765], [80, 115945], [87, 116225]]}, {"verse": 19, "start": 117302, "end": 121970, "text": "Me dirás pues: ¿Por qué, pues, se enoja? porque ¿quién resistirá a su voluntad?", "words": [[0, 117302], [3, 117405], [9, 117665], [15, 118440], [20, 118561], [25, 118641], [31, 118721], [34, 119101], [41, 119921], [48, 120131], [55, 120391], [65, 121111], [67, 121191], [70, 121291]]}, {"verse": 20, "start": 122320, "end": 129582, "text": "Pero antes, oh hombre, ¿quién eres tú, para que disputes con Dios? Dirá el vaso de barro al que le labró: ¿Por qué me has hecho tal?", "words": [[0, 122320], [5, 122462], [12, 122712], [15, 122962], [23, 123542], [30, 123762], [35, 123942], [39, 124182], [44, 124402], [48, 124542], [57, 125162], [61, 125342], [67, 126089], [72, 126386], [75, 126486], [80, 126826], [83, 126926], [89, 127286], [92, 127406], [96, 127546], [99, 127646], [106, 128367], [111, 128506], [115, 128646], [118, 128786], [122, 128926], [128, 129126]]}, {"verse": 21, "start": 129932, "end": 136209, "text": "¿O no tiene potestad el alfarero para hacer de la misma masa un vaso para honra, y otro para vergüenza?", "words": [[0, 129932], [3, 130049], [6, 130309], [12, 130569], [21, 130829], [24, 131089], [33, 131569], [38, 131789], [44, 132089], [47, 132229], [50, 132349], [56, 132609], [61, 133049], [64, 133409], [69, 133789], [74, 134009], [81, 134629], [83, 134949], [88, 135189], [93, 135489]]}, {"verse": 22, "start": 136559, "end": 144941, "text": "¿Y qué, si Dios, queriendo mostrar la ira y dar a conocer su poder, soportó con mucha paciencia los vasos de ira preparados para muerte,", "words": [[0, 136559], [3, 136654], [8, 136794], [11, 136974], [17, 137854], [27, 138294], [35, 138714], [38, 138954], [42, 139354], [44, 139534], [48, 139694], [50, 139774], [58, 140194], [61, 140414], [68, 141214], [76, 141674], [80, 141854], [86, 142114], [96, 142674], [100, 142854], [106, 143254], [109, 143374], [113, 143614], [124, 144154], [129, 144354]]}, {"verse": 23, "start": 145291, "end": 152543, "text": "Y para hacer notorias las riquezas de su gloria, las mostró para con los vasos de misericordia que él ha preparado para gloria;", "words": [[0, 145291], [2, 145409], [7, 145629], [13, 145929], [22, 146489], [26, 146649], [35, 147169], [38, 147329], [41, 147489], [49, 148049], [53, 148529], [60, 148989], [65, 149229], [69, 149449], [73, 149609], [79, 149989], [82, 150089], [95, 150869], [99, 151029], [102, 151209], [105, 151289], [115, 151789], [120, 151989]]}, {"verse": 24, "start": 152893, "end": 159298, "text": "Los cuales también ha llamado, es decir, a nosotros, no sólo de los judíos, sino también de los Gentiles?", "words": [[0, 152893], [4, 152998], [11, 153238], [19, 153618], [22, 153838], [31, 154258], [34, 154698], [41, 155158], [43, 155458], [53, 156198], [56, 156358], [61, 156578], [64, 156738], [68, 156858], [76, 157638], [81, 157878], [89, 158218], [92, 158358], [96, 158498]]}, {"verse": 25, "start": 159648, "end": 166298, "text": "Como también en Oseas dice: Llamaré al que no era mi pueblo, pueblo mío; y a la no amada, amada.", "words": [[0, 159648], [5, 159791], [13, 160111], [16, 160441], [22, 160771], [28, 161429], [36, 161897], [39, 162057], [43, 162217], [46, 162397], [50, 162577], [53, 162757], [61, 163317], [68, 163677], [73, 164622], [75, 164748], [77, 164828], [80, 164908], [83, 165128], [90, 165788]]}, {"verse": 26, "start": 166801, "end": 174070, "text": "Y será, que en el lugar donde les fue dicho: Vosotros no sois pueblo mío: allí serán llamados hijos del Dios viviente.", "words": [[0, 166801], [2, 166904], [8, 167104], [12, 167344], [15, 167504], [18, 167604], [24, 167844], [30, 168044], [34, 168264], [38, 168444], [45, 169158], [54, 169636], [57, 169836], [62, 170116], [69, 170336], [74, 171294], [79, 171618], [85, 171898], [94, 172438], [100, 172738], [104, 173078], [109, 173318]]}, {"verse": 27, "start": 174420, "end": 182129, "text": "También Isaías clama tocante a Israel: Aunque sea el número de los hijos de Israel como la arena del mar, el remanente será salvo:", "words": [[0, 174420], [8, 174721], [15, 175341], [21, 175821], [29, 176051], [31, 176281], [39, 177174], [46, 177376], [50, 177676], [53, 177836], [60, 178036], [63, 178276], [67, 178416], [73, 178636], [76, 178856], [83, 179176], [88, 179476], [91, 179656], [97, 179916], [101, 180136], [106, 180736], [109, 180816], [119, 181316], [124, 181576]]}, {"verse": 28, "start": 182479, "end": 189428, "text": "Porque el Señor cumplirá su palabra por completo y sin demora en justicia; porque ejecutará prontamente su palabra sobre la tierra.", "words": [[0, 182479], [7, 182707], [10, 182807], [16, 183047], [25, 183627], [28, 183747], [36, 184087], [40, 184327], [49, 184787], [51, 184987], [55, 185237], [62, 185487], [65, 185607], [75, 186585], [82, 186791], [92, 187331], [104, 187891], [107, 188071], [115, 188451], [121, 188711], [124, 188891]]}, {"verse": 29, "start": 189778, "end": 200105, "text": "Y como antes dijo Isaías: Si el Señor de los ejércitos no nos hubiera dejado descendencia, como Sodoma habríamos venido a ser, y a Gomorra fuéramos semejantes.", "words": [[0, 189778], [2, 189876], [7, 190076], [13, 190356], [18, 190676], [26, 191713], [29, 191852], [32, 191972], [38, 192252], [41, 192472], [45, 192612], [55, 193272], [58, 193532], [62, 193732], [70, 194072], [77, 194492], [91, 195312], [96, 195852], [103, 196392], [113, 196812], [120, 197172], [122, 197332], [127, 197572], [129, 197899], [131, 198225], [139, 198552], [148, 199172]]}, {"verse": 30, "start": 200455, "end": 208740, "text": "¿Pues qué diremos? Que los Gentiles que no seguían justicia, han alcanzado la justicia, es decir, la justicia que es por la fe;", "words": [[0, 200455], [6, 200594], [10, 200734], [19, 201576], [23, 201660], [27, 201800], [36, 202300], [40, 202520], [43, 202660], [51, 203060], [61, 203800], [65, 204380], [75, 205040], [78, 205180], [88, 206120], [91, 206220], [98, 207080], [101, 207180], [110, 207760], [114, 207920], [117, 208080], [121, 208260], [124, 208400]]}, {"verse": 31, "start": 209090, "end": 213464, "text": "Pero Israel que seguía la ley de justicia, no ha llegado a la ley de justicia.", "words": [[0, 209090], [5, 209239], [12, 209639], [16, 209839], [23, 210199], [26, 210319], [30, 210539], [33, 210639], [43, 211659], [46, 211779], [49, 211899], [57, 212279], [59, 212379], [62, 212439], [66, 212639], [69, 212759]]}, {"verse": 32, "start": 213814, "end": 220837, "text": "¿Por qué? Porque la seguían no por fe, sino como por las obras de la ley: por lo cual tropezaron en la piedra de tropiezo,", "words": [[0, 213814], [5, 213932], [10, 214522], [17, 214703], [20, 214863], [28, 215303], [31, 215483], [35, 215683], [39, 216163], [44, 216463], [49, 216683], [53, 216883], [57, 217063], [63, 217323], [66, 217523], [69, 217663], [74, 218212], [78, 218340], [81, 218460], [86, 218740], [97, 219440], [100, 219580], [103, 219680], [110, 220040], [113, 220140]]}, {"verse": 33, "start": 221187, "end": 229704, "text": "Como está escrito: He aquí pongo en Sion piedra de tropiezo, y piedra de caída; y aquel que cree en ella, no será avergonzado.", "words": [[0, 221187], [5, 221351], [10, 221551], [19, 222453], [22, 222543], [27, 222763], [33, 223043], [36, 223323], [41, 223603], [48, 224183], [51, 224283], [61, 224983], [63, 225263], [70, 225703], [73, 225823], [80, 226825], [82, 226944], [88, 227224], [92, 227344], [97, 227644], [100, 227844], [106, 228084], [109, 228464], [114, 228704]]}]}