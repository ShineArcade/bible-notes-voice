{"book": "MRK", "chapter": 16, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 161674, "verses": [{"verse": 1, "start": 300, "end": 12004, "text": "Y como pasó el sábado, María Magdalena, y María madre de Jacobo, y Salomé, compraron especias aromáticas, para venir a ungirle.", "words": [[0, 300], [2, 444], [7, 724], [12, 1084], [15, 1324], [23, 1924], [29, 2844], [40, 3864], [42, 4564], [48, 4884], [54, 5424], [57, 5584], [65, 6504], [67, 6684], [75, 7424], [85, 8344], [94, 8944], [106, 9744], [111, 10484], [117, 10804], [119, 11415]]}, {"verse": 2, "start": 12354, "end": 18446, "text": "Y muy de mañana, el primer día de la semana, vienen al sepulcro, ya salido el sol.", "words": [[0, 12354], [2, 12478], [6, 12638], [9, 12798], [17, 13338], [20, 13438], [27, 13758], [31, 14078], [34, 14218], [37, 14358], [45, 15218], [52, 15738], [55, 16038], [65, 17098], [68, 17398], [75, 17758], [78, 17918]]}, {"verse": 3, "start": 18796, "end": 24046, "text": "Y decían entre sí: ¿Quién nos hará rodar la piedra de la puerta del sepulcro?", "words": [[0, 18796], [2, 18905], [9, 19425], [15, 19705], [19, 20387], [26, 20707], [30, 20847], [35, 21167], [41, 21647], [44, 21787], [51, 22287], [54, 22407], [57, 22527], [64, 22867], [68, 23147]]}, {"verse": 4, "start": 24326, "end": 28691, "text": "Y al mirar, vieron que la piedra había sido removida, aunque era muy grande.", "words": [[0, 24326], [2, 24455], [5, 24555], [12, 24955], [19, 25295], [23, 25455], [26, 25595], [33, 26035], [39, 26235], [44, 26615], [54, 27535], [61, 27695], [65, 27955], [69, 28115]]}, {"verse": 5, "start": 29041, "end": 38829, "text": "Y entradas en el sepulcro, vieron un joven sentado al lado derecho, cubierto de una larga túnica blanca; y se espantaron.", "words": [[0, 29041], [2, 29225], [11, 29785], [14, 30045], [17, 30205], [27, 30945], [34, 31785], [37, 31965], [43, 32425], [51, 33105], [54, 33285], [59, 33565], [68, 34065], [77, 35105], [80, 35425], [84, 35605], [90, 36025], [97, 36505], [105, 37436], [107, 37600], [110, 37720]]}, {"verse": 6, "start": 39179, "end": 49482, "text": "Pero él les dice: No os asustéis: buscáis a Jesús nazareno, el que fue crucificado; ha resucitado, no está aquí; he aquí el lugar en donde le pusieron.", "words": [[0, 39179], [5, 39344], [8, 39574], [12, 39804], [18, 40563], [21, 40765], [24, 40945], [34, 41948], [42, 42428], [44, 42588], [50, 42808], [60, 43528], [63, 43768], [67, 43888], [71, 44068], [84, 45459], [87, 45753], [99, 46046], [102, 46346], [107, 46566], [113, 47293], [116, 47373], [121, 47633], [124, 47913], [130, 48233], [133, 48513], [139, 48653], [142, 48833]]}, {"verse": 7, "start": 49832, "end": 56454, "text": "Pero id, decid a sus discípulos y a Pedro, que él va antes que vosotros a Galilea: allí le veréis, como os dijo.", "words": [[0, 49832], [5, 49991], [9, 50231], [15, 50471], [17, 50711], [21, 50871], [32, 51531], [34, 51671], [36, 51751], [43, 52311], [47, 52498], [50, 52684], [53, 52871], [59, 53131], [63, 53331], [72, 53771], [74, 54011], [83, 54853], [88, 55115], [91, 55235], [99, 55615], [104, 55915], [107, 56055]]}, {"verse": 8, "start": 56734, "end": 66025, "text": "Y ellas se fueron huyendo del sepulcro; porque las había tomado temblor y espanto; ni decían nada a nadie, porque tenían miedo.", "words": [[0, 56734], [2, 56918], [8, 57278], [11, 57738], [18, 58018], [26, 58658], [30, 58898], [40, 60092], [47, 60276], [51, 60476], [57, 60796], [64, 61276], [72, 61876], [74, 62036], [83, 63144], [86, 63291], [93, 63831], [98, 64191], [100, 64432], [107, 64712], [114, 64991], [121, 65372]]}, {"verse": 9, "start": 66375, "end": 76696, "text": "Pero como Jesús resucitó por la mañana, el primer día de la semana, apareció primeramente a María Magdalena, de la cual había echado siete demonios.", "words": [[0, 66375], [5, 66657], [10, 66837], [16, 67657], [25, 68477], [29, 68637], [32, 68777], [40, 69177], [43, 69397], [50, 69697], [54, 70017], [57, 70157], [60, 70297], [68, 7