{"book": "ACT", "chapter": 2, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 350642, "verses": [{"verse": 1, "start": 300, "end": 5957, "text": "Y como se cumplieron los días de Pentecostés, estaban todos unánimes juntos;", "words": [[0, 300], [2, 424], [7, 664], [10, 844], [21, 1484], [25, 1664], [30, 1944], [33, 2124], [46, 3024], [54, 3644], [60, 4204], [69, 5044]]}, {"verse": 2, "start": 6307, "end": 15535, "text": "Y de repente vino un estruendo del cielo como de un viento recio que corría, el cual llenó toda la casa donde estaban sentados;", "words": [[0, 6307], [2, 6431], [5, 6551], [13, 7051], [18, 7551], [21, 7791], [31, 8331], [35, 8551], [41, 8991], [46, 9291], [49, 9471], [52, 9551], [59, 9991], [65, 10431], [69, 10571], [77, 11436], [80, 11576], [85, 11796], [91, 12196], [96, 12476], [99, 12736], [104, 13176], [110, 13856], [118, 14722]]}, {"verse": 3, "start": 15885, "end": 22359, "text": "Y se les aparecieron lenguas repartidas, como de fuego, que se asentó sobre cada uno de ellos.", "words": [[0, 15885], [2, 16029], [5, 16149], [9, 16309], [21, 17129], [29, 17669], [41, 18529], [46, 18829], [49, 19009], [56, 19449], [60, 19949], [63, 20129], [70, 20669], [76, 20949], [81, 21209], [85, 21549], [88, 21749]]}, {"verse": 4, "start": 22709, "end": 30434, "text": "Y fueron todos llenos del Espíritu Santo, y comenzaron a hablar en otras lenguas, como el Espíritu les daba que hablasen.", "words": [[0, 22709], [2, 22852], [9, 23072], [15, 23512], [22, 24112], [26, 24292], [35, 24792], [42, 25152], [44, 25656], [55, 26316], [57, 26476], [64, 26757], [67, 26976], [73, 27156], [82, 27796], [87, 28296], [90, 28516], [99, 29117], [103, 29257], [108, 29516], [112, 29696]]}, {"verse": 5, "start": 30784, "end": 38548, "text": "Moraban entonces en Jerusalén judíos, varones religiosos, de todas las naciones debajo del cielo.", "words": [[0, 30784], [8, 31260], [17, 31840], [20, 32160], [30, 32800], [38, 33780], [46, 34300], [58, 35520], [61, 35840], [67, 36180], [71, 36680], [80, 37300], [87, 37760], [91, 37980]]}, {"verse": 6, "start": 38898, "end": 46795, "text": "Y hecho este estruendo, se juntó la multitud; y estaban confusos, porque cada uno les oía hablar su propia lengua.", "words": [[0, 38898], [2, 39078], [8, 39278], [13, 39578], [24, 40438], [27, 40618], [33, 41018], [36, 41118], [46, 42139], [48, 42223], [56, 42483], [66, 43503], [73, 44023], [78, 44343], [82, 44683], [86, 44923], [90, 45283], [97, 45523], [100, 45763], [107, 46083]]}, {"verse": 7, "start": 47145, "end": 53671, "text": "Y estaban atónitos y maravillados, diciendo: He aquí ¿no son galileos todos estos que hablan?", "words": [[0, 47145], [2, 47265], [10, 47645], [19, 48565], [21, 48765], [35, 49605], [45, 50818], [48, 50908], [53, 51168], [57, 51388], [61, 51608], [70, 52208], [76, 52468], [82, 52828], [86, 53108]]}, {"verse": 8, "start": 54021, "end": 58392, "text": "¿Cómo, pues, les oímos nosotros hablar cada uno en nuestra lengua de nacimiento?", "words": [[0, 54021], [7, 54202], [13, 54802], [17, 54902], [23, 55342], [32, 55582], [39, 56122], [44, 56362], [48, 56702], [51, 56842], [59, 56982], [66, 57482], [69, 57562]]}, {"verse": 9, "start": 58742, "end": 66229, "text": "Partos y medos, y elamitas, y los que habitamos en Mesopotamia, en Judea y en Capadocia, en el Ponto y en Asia,", "words": [[0, 58742], [7, 59210], [9, 59350], [16, 59730], [18, 59850], [28, 60390], [30, 60655], [34, 60815], [38, 60995], [48, 61555], [51, 61735], [64, 62875], [67, 62915], [73, 63415], [75, 63535], [78, 63655], [89, 64815], [92, 64895], [95, 65155], [101, 65415], [103, 65615], [106, 65715]]}, {"verse": 10, "start": 66578, "end": 75234, "text": "En Frigia y Panfilia, en Egipto y en las partes de Africa que está del otro lado de Cirene, y Romanos extranjeros, tanto judíos como convertidos,", "words": [[0, 66578], [3, 66739], [10, 67279], [12, 67739], [22, 68199], [25, 68259], [32, 68759], [34, 68839], [37, 68919], [41, 69039], [48, 69399], [51, 69599], [58, 69979], [62, 70159], [67, 70419], [71, 70599], [76, 70819], [81, 71079], [84, 71379], [92, 71679], [94, 71844], [102, 72344], [115, 73424], [121, 73584], [128, 74124], [133, 74344]]}, {"verse": 11, "start": 75584, "end": 80292, "text": "Cretenses y árabes, les oímos hablar en nuestras lenguas las maravillas de Dios.", "words": [[0, 75854], [10, 76124], [12, 76344], [20, 76764], [24, 76924], [30, 77424], [37, 77704], [40, 77904], [49, 78104], [57, 78784], [61, 78944], [72, 79564], [75, 79744]]}, {"verse": 12, "start": 80572, "end": 87168, "text": "Y estaban todos atónitos y perplejos, diciendo los unos a los otros: ¿Qué significa esto?", "words": [[0, 80572], [2, 80673], [10, 81033], [16, 81433], [25, 82293], [27, 82453], [38, 83146], [47, 83840], [51, 84533], [56, 84753], [58, 85013], [62, 85173], [69, 86083], [74, 86187], [84, 86587]]}, {"verse": 13, "start": 87448, "end": 91934, "text": "Pero otros burlándose, decían: Que están llenos de vino nuevo.", "words": [[0, 87448], [5, 87632], [11, 88402], [23, 89172], [31, 90342], [35, 90426], [41, 90666], [48, 91066], [51, 91206], [56, 91366]]}, {"verse": 14, "start": 92214, "end": 104665, "text": "Entonces Pedro, poniéndose en pie con los once, alzó su voz, y les habló diciendo: Varones judíos, y todos los que habitáis en Jerusalén, esto os sea notorio, y oíd mis palabras.", "words": [[0, 92214], [9, 92896], [16, 93756], [27, 94356], [30, 94536], [34, 94656], [38, 94856], [42, 95036], [48, 96056], [53, 96376], [56, 96516], [61, 96816], [63, 97216], [67, 97356], [73, 97756], [83, 98651], [91, 99018], [99, 99598], [101, 99718], [107, 99938], [111, 100158], [115, 100338], [124, 100798], [127, 100898], [138, 101938], [143, 102048], [146, 102158], [150, 102478], [159, 103138], [161, 103428], [165, 103718], [169, 103878]]}, {"verse": 15, "start": 105015, "end": 109421, "text": "Porque estos no están borrachos, como vosotros pensáis, siendo la tercera hora del día;", "words": [[0, 105015], [7, 105217], [13, 105437], [16, 105657], [22, 105857], [33, 106437], [38, 106637], [47, 107077], [56, 107837], [63, 108057], [66, 108237], [74, 108617], [79, 108817], [83, 109017]]}, {"verse": 16, "start": 109771, "end": 112518, "text": "Pero esto es lo que fue dicho por el profeta Joel:", "words": [[0, 109771], [5, 109908], [10, 110228], [13, 110468], [16, 110588], [20, 110728], [24, 110908], [30, 111228], [34, 111488], [37, 111608], [45, 112008]]}, {"verse": 17, "start": 112868, "end": 124944, "text": "Y será en los últimos días, dice Dios, derramaré de mi Espíritu sobre toda carne, y vuestros hijos y vuestras hijas profetizarán; y vuestros jóvenes verán visiones, y vuestros viejos soñarán sueños:", "words": [[0, 112868], [2, 112989], [7, 113189], [10, 113389], [14, 113509], [22, 113829], [28, 114509], [33, 114709], [39, 115489], [49, 115989], [52, 116129], [55, 116249], [64, 116789], [70, 117009], [75, 117249], [82, 117689], [84, 117914], [93, 118294], [99, 118674], [101, 118894], [110, 119274], [116, 119634], [130, 120716], [132, 120814], [141, 121174], [149, 121474], [155, 121914], [165, 122714], [167, 123014], [176, 123354], [183, 123734], [191, 124234]]}, {"verse": 18, "start": 125294, "end": 131260, "text": "Y de cierto sobre mis siervos y sobre mis siervas en aquellos días derramaré de mi Espíritu, y profetizarán.", "words": [[0, 125294], [2, 125504], [5, 125758], [12, 126011], [18, 126191], [22, 126371], [30, 126811], [32, 126951], [38, 127111], [42, 127331], [50, 127731], [53, 127891], [62, 128111], [67, 128531], [77, 129111], [80, 129231], [83, 129351], [93, 130191], [95, 130331]]}, {"verse": 19, "start": 131610, "end": 137566, "text": "Y daré prodigios arriba en el cielo, y señales abajo en la tierra, sangre y fuego y vapor de humo:", "words": [[0, 131610], [2, 131713], [7, 131993], [17, 132513], [24, 132813], [27, 133013], [30, 133133], [37, 133493], [39, 133678], [47, 134178], [53, 134498], [56, 134718], [59, 134818], [67, 135518], [74, 135998], [76, 136158], [82, 136438], [84, 136698], [90, 136938], [93, 137178]]}, {"verse": 20, "start": 137916, "end": 144608, "text": "El sol se volverá en tinieblas, y la luna en sangre, antes que venga el día del Señor, grande y manifiesto;", "words": [[0, 137916], [3, 138034], [7, 138294], [10, 138494], [18, 138954], [21, 139334], [32, 139714], [34, 139894], [37, 140034], [42, 140214], [45, 140374], [53, 140934], [59, 141514], [63, 141734], [69, 142054], [72, 142194], [76, 142334], [80, 142514], [87, 142874], [94, 143654], [96, 143814]]}, {"verse": 21, "start": 144958, "end": 148418, "text": "Y será que todo aquel que invoque el nombre del Señor, será salvo.", "words": [[0, 144958], [2, 145062], [7, 145202], [11, 145382], [16, 145582], [22, 145962], [26, 146062], [34, 146442], [37, 146542], [44, 146782], [48, 146962], [55, 147362], [60, 147902]]}, {"verse": 22, "start": 148768, "end": 161194, "text": "Varones israelitas, oíd estas palabras: Jesús nazareno, varón aprobado de Dios entre vosotros en maravillas y prodigios y señales, que Dios hizo por él en medio de vosotros, como también vosotros sabéis;", "words": [[0, 148928], [8, 149128], [20, 149768], [24, 150408], [30, 150588], [40, 151560], [46, 151789], [56, 152749], [62, 153109], [71, 153609], [74, 153789], [79, 154009], [85, 154289], [94, 154869], [97, 155109], [108, 155649], [110, 155809], [120, 156369], [122, 156489], [131, 157009], [135, 157429], [140, 157689], [145, 157969], [149, 158249], [152, 158409], [155, 158529], [161, 158749], [164, 158909], [174, 159649], [179, 159749], [187, 160109], [196, 160629]]}, {"verse": 23, "start": 161544, "end": 169897, "text": "A este, entregado según el plan determinado y el conocimiento anticipado de Dios, prendisteis y matasteis por manos de los inicuos, crucificándole;", "words": [[0, 161544], [2, 161641], [8, 161841], [18, 162401], [24, 162661], [27, 162861], [32, 163121], [44, 163801], [46, 163881], [49, 163981], [62, 164581], [73, 165241], [76, 165381], [82, 166201], [94, 166881], [96, 167001], [106, 167581], [110, 167721], [116, 167961], [119, 168161], [123, 168261], [132, 168961]]}, {"verse": 24, "start": 170247, "end": 176953, "text": "Al cual Dios levantó, habiéndolo liberado de los dolores de la muerte, por cuanto era imposible que ella lo retuviese.", "words": [[0, 170247], [3, 170364], [8, 170544], [13, 170804], [22, 171464], [33, 172124], [42, 172684], [45, 172824], [49, 172964], [57, 173404], [60, 173544], [63, 173664], [71, 174064], [75, 174319], [82, 174559], [86, 174879], [96, 175579], [100, 175799], [105, 175979], [108, 176139]]}, {"verse": 25, "start": 177303, "end": 184003, "text": "Porque David dice de él: Veía al Señor siempre delante de mí: porque está a mi diestra, no seré conmovido.", "words": [[0, 177303], [7, 177516], [13, 177816], [18, 178196], [21, 178396], [25, 178938], [30, 179320], [33, 179440], [39, 179700], [47, 180160], [55, 180640], [58, 180780], [62, 181287], [69, 181492], [74, 181792], [76, 181932], [79, 181992], [88, 182812], [91, 182912], [96, 183272]]}, {"verse": 26, "start": 184353, "end": 190025, "text": "Por lo cual mi corazón se alegró, y se gozó mi lengua; y aun mi carne descansará en esperanza;", "words": [[0, 184353], [4, 184455], [7, 184575], [12, 184815], [15, 184955], [23, 185315], [26, 185595], [34, 186075], [36, 186315], [39, 186455], [44, 186775], [47, 186855], [55, 187582], [57, 187721], [61, 187861], [64, 188081], [70, 188401], [81, 189141], [84, 189261]]}, {"verse": 27, "start": 190375, "end": 194612, "text": "Que no dejarás mi alma en el infierno, ni darás a tu Santo que vea corrupción.", "words": [[0, 190375], [4, 190456], [7, 190576], [15, 191036], [18, 191176], [23, 191396], [26, 191536], [29, 191636], [39, 192356], [42, 192516], [48, 192836], [50, 192916], [53, 193016], [59, 193396], [63, 193576], [67, 193816]]}, {"verse": 28, "start": 194962, "end": 199208, "text": "Me diste a conocer los caminos de la vida; me llenarás de gozo con tu presencia.", "words": [[0, 195065], [3, 195205], [9, 195345], [11, 195465], [19, 195785], [23, 195965], [31, 196345], [34, 196465], [37, 196565], [43, 197217], [46, 197314], [55, 197774], [58, 197874], [63, 198174], [67, 198334], [70, 198434]]}, {"verse": 29, "start": 199558, "end": 208017, "text": "Varones hermanos, se os puede libremente decir del patriarca David, que murió, y fue sepultado, y su sepulcro está con nosotros hasta el día de hoy.", "words": [[0, 199691], [8, 199861], [18, 200441], [21, 200581], [24, 200681], [30, 200941], [41, 201328], [47, 201714], [51, 202101], [61, 202621], [68, 202881], [72, 203076], [79, 203496], [81, 203976], [85, 204156], [96, 204876], [98, 205316], [101, 205456], [110, 205996], [115, 206296], [119, 206516], [128, 206896], [134, 207236], [137, 207376], [141, 207576], [144, 207736]]}, {"verse": 30, "start": 208367, "end": 218481, "text": "Pero siendo profeta, y sabiendo que con juramento le había Dios jurado que del fruto de su lomo, cuanto a la carne, levantaría al Cristo que se sentaría sobre su trono;", "words": [[0, 208367], [5, 208603], [12, 208823], [21, 209503], [23, 209623], [32, 210103], [36, 210263], [40, 210503], [50, 211063], [53, 211283], [59, 211503], [64, 211823], [71, 212303], [75, 212483], [79, 212643], [85, 213003], [88, 213163], [91, 213303], [97, 213763], [104, 214283], [106, 214483], [109, 214543], [116, 215376], [127, 216000], [130, 216200], [137, 216540], [141, 216780], [144, 216900], [153, 217480], [159, 217760], [162, 217960]]}, {"verse": 31, "start": 218831, "end": 225809, "text": "Viéndolo antes, habló de la resurrección de Cristo, que su alma no fue dejada en el infierno, ni su carne vio corrupción.", "words": [[0, 218831], [9, 219293], [16, 219633], [22, 220173], [25, 220233], [28, 220373], [41, 221053], [44, 221173], [52, 221913], [56, 222113], [59, 222313], [64, 222513], [67, 222753], [71, 222913], [78, 223333], [81, 223433], [84, 223533], [94, 224033], [97, 224433], [100, 224573], [106, 224873], [110, 225153]]}, {"verse": 32, "start": 226159, "end": 230493, "text": "A este Jesús resucitó Dios, de lo cual todos nosotros somos testigos.", "words": [[0, 226159], [2, 226277], [7, 226477], [13, 226877], [22, 227537], [28, 228117], [31, 228197], [34, 228317], [39, 228557], [45, 228797], [54, 229257], [60, 229657]]}, {"verse": 33, "start": 230843, "end": 238998, "text": "Así que, levantado por la diestra de Dios, y recibiendo del Padre la promesa del Espíritu Santo, ha derramado esto que vosotros veis y oís.", "words": [[0, 230843], [4, 231019], [9, 231199], [19, 231799], [23, 231999], [26, 232099], [34, 232459], [37, 232619], [43, 232899], [45, 233499], [56, 234079], [60, 234279], [66, 234659], [69, 234759], [77, 235199], [81, 235379], [90, 235919], [97, 236259], [100, 236544], [110, 237104], [115, 237384], [119, 237584], [128, 238024], [133, 238444], [135, 238564]]}, {"verse": 34, "start": 239348, "end": 245716, "text": "Porque David no subió a los cielos; pero él dice: Dijo el Señor a mi Señor: Siéntate a mi diestra,", "words": [[0, 239348], [7, 239526], [13, 239786], [16, 240046], [22, 240366], [24, 240466], [28, 240566], [36, 241360], [41, 241519], [44, 241739], [50, 242508], [55, 242789], [58, 242969], [64, 243249], [66, 243469], [69, 243549], [76, 244325], [85, 244883], [87, 245023], [90, 245103]]}, {"verse": 35, "start": 246066, "end": 249256, "text": "Hasta que ponga a tus enemigos por estrado de tus pies.", "words": [[0, 246066], [6, 246290], [10, 246470], [16, 246910], [18, 246990], [22, 247130], [31, 247670], [35, 247970], [43, 248410], [46, 248550], [50, 248690]]}, {"verse": 36, "start": 249606, "end": 257646, "text": "Sepa pues ciertísimamente toda la casa de Israel, que a este Jesús que vosotros crucificasteis, Dios ha hecho Señor y Cristo.", "words": [[0, 249606], [5, 249940], [10, 250240], [26, 251260], [31, 251580], [34, 251800], [39, 252080], [42, 252260], [50, 252720], [54, 252945], [56, 253045], [61, 253245], [67, 253625], [71, 253845], [80, 254285], [96, 255405], [101, 255825], [104, 256065], [110, 256265], [116, 256645], [118, 257045]]}, {"verse": 37, "start": 257926, "end": 266775, "text": "Entonces oído esto, fueron compungidos de corazón, y dijeron a Pedro y a los otros apóstoles: Varones hermanos, ¿qué haremos?", "words": [[0, 257926], [9, 258737], [14, 259129], [20, 259449], [27, 259869], [39, 260889], [42, 261049], [51, 261569], [53, 261894], [61, 262394], [63, 262474], [69, 262814], [71, 263074], [73, 263154], [77, 263254], [83, 263594], [94, 265123], [102, 265333], [112, 266033], [117, 266093]]}, {"verse": 38, "start": 267055, "end": 276782, "text": "Y Pedro les dice: Arrepentíos, y bautícese cada uno de vosotros en el nombre de Jesucristo para perdón de los pecados; y recibiréis el don del Espíritu Santo.", "words": [[0, 267055], [2, 267180], [8, 267540], [12, 267950], [18, 268510], [31, 269288], [33, 269408], [43, 270048], [48, 270228], [52, 270508], [55, 270648], [64, 271168], [67, 271388], [70, 271488], [77, 271788], [80, 271948], [91, 272608], [96, 272808], [103, 273268], [106, 273348], [110, 273468], [119, 274394], [121, 274485], [132, 275165], [135, 275325], [139, 275505], [143, 275685], [152, 276225]]}, {"verse": 39, "start": 277132, "end": 284310, "text": "Porque para vosotros es la promesa, y para vuestros hijos, y para todos los que están lejos; para cuantos el Señor nuestro Dios llame.", "words": [[0, 277132], [7, 277332], [12, 277532], [21, 277972], [24, 278152], [27, 278272], [36, 278772], [38, 279012], [43, 279192], [52, 279592], [59, 279852], [61, 280172], [66, 280372], [72, 280612], [76, 280812], [80, 280972], [86, 281172], [93, 281952], [98, 282099], [106, 282499], [109, 282599], [115, 282819], [123, 283059], [128, 283399]]}, {"verse": 40, "start": 284590, "end": 292485, "text": "Y con otras muchas palabras testificaba y exhortaba, diciendo: Sed salvos de esta perversa generación.", "words": [[0, 284590], [2, 284727], [6, 284927], [12, 285127], [19, 285467], [28, 285927], [40, 286967], [42, 287147], [53, 288487], [63, 289490], [67, 289753], [74, 290233], [77, 290393], [82, 290553], [91, 291113]]}, {"verse": 41, "start": 292765, "end": 301213, "text": "Así que, los que recibieron su palabra, fueron bautizados: y fueron añadidas a ellos aquel día como tres mil personas.", "words": [[0, 292765], [4, 292980], [9, 293180], [13, 293320], [17, 293480], [28, 294140], [31, 294320], [40, 294780], [47, 295180], [59, 296514], [61, 296767], [68, 296987], [77, 297887], [79, 298207], [85, 298547], [91, 299267], [95, 299507], [100, 299707], [105, 299907], [109, 300107]]}, {"verse": 42, "start": 301563, "end": 310342, "text": "Y perseveraban en la enseñanza de los apóstoles, y en la comunión, y en el partimiento del pan, y en las oraciones.", "words": [[0, 301563], [2, 301684], [15, 302784], [18, 303084], [21, 303244], [31, 304184], [34, 304324], [38, 304464], [49, 305184], [51, 305664], [54, 305784], [57, 305904], [67, 306644], [69, 307144], [72, 307264], [75, 307384], [87, 308144], [91, 308364], [96, 308704], [98, 309024], [101, 309144], [105, 309284]]}, {"verse": 43, "start": 310692, "end": 317414, "text": "Y toda persona tenía temor: y muchas maravillas y señales eran hechas por los apóstoles.", "words": [[0, 310692], [2, 310938], [7, 311118], [15, 311618], [21, 312118], [28, 312935], [30, 313079], [37, 313519], [48, 314399], [50, 314579], [58, 315139], [63, 315379], [70, 315939], [74, 316299], [78, 316479]]}, {"verse": 44, "start": 317764, "end": 322902, "text": "Y todos los que creían estaban juntos; y tenían todas las cosas comunes;", "words": [[0, 317764], [2, 317889], [8, 318209], [12, 318489], [16, 318669], [23, 319169], [31, 319469], [39, 320532], [41, 320760], [48, 321020], [54, 321380], [58, 321660], [64, 322000]]}, {"verse": 45, "start": 323252, "end": 330610, "text": "Y vendían las posesiones, y los bienes, y los repartían a todos, según la necesidad de cada uno.", "words": [[0, 323252], [2, 323377], [10, 323837], [14, 324017], [26, 324837], [28, 325252], [32, 325392], [40, 326292], [42, 326532], [46, 326672], [56, 327292], [58, 327392], [65, 328152], [71, 328652], [74, 328912], [84, 329592], [87, 329732], [92, 329972]]}, {"verse": 46, "start": 330960, "end": 340659, "text": "Y perseverando unánimes cada día en el templo, y partiendo el pan en las casas, comían juntos con alegría y con sencillez de corazón,", "words": [[0, 330960], [2, 331086], [15, 331976], [24, 332866], [29, 333186], [33, 333546], [36, 333766], [39, 333906], [47, 334686], [49, 334826], [59, 335366], [62, 335526], [66, 335806], [69, 335966], [73, 336126], [80, 337166], [87, 337626], [94, 337986], [98, 338326], [106, 338866], [108, 338946], [112, 339366], [122, 339786], [125, 339906]]}, {"verse": 47, "start": 341009, "end": 350242, "text": "Alabando a Dios, y teniendo gracia con todo el pueblo. Y el Señor añadía cada día a la iglesia los que habían de ser salvos.", "words": [[0, 341009], [9, 341569], [11, 341669], [17, 341929], [19, 342424], [28, 342924], [35, 343464], [39, 343684], [44, 343884], [47, 344064], [55, 344917], [57, 345041], [60, 345181], [66, 345561], [73, 346441], [78, 346721], [82, 347161], [84, 347461], [87, 347541], [95, 348101], [99, 348541], [103, 348741], [110, 349061], [113, 349261], [117, 349461]]}]}