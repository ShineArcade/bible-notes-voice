erse": 18, "start": 112455, "end": 121694, "text": "¶ He that believes on him is not condemned: but he that believes not is condemned already, because he has not believed in the name of the only begotten Son of God.", "words": [[2, 112455], [5, 112613], [10, 112813], [19, 113133], [22, 113413], [26, 113613], [29, 113873], [33, 114073], [44, 115038], [48, 115160], [51, 115420], [56, 115660], [65, 116000], [69, 116400], [72, 116700], [82, 117080], [91, 117560], [99, 117875], [102, 118115], [106, 118295], [110, 118455], [119, 118855], [122, 119115], [126, 119215], [131, 119535], [134, 119755], [138, 119895], [143, 120195], [152, 120715], [156, 120995], [159, 121195]]}, {"verse": 19, "start": 122044, "end": 130473, "text": "And this is the condemnation, that light is come into the world, and men loved darkness rather than light, because their deeds were evil.", "words": [[0, 122044], [4, 122201], [9, 122481], [12, 122741], [16, 122881], [30, 124241], [35, 124441], [41, 124721], [44, 124961], [49, 125201], [54, 125441], [58, 125521], [65, 126261], [69, 126481], [73, 126731], [79, 126981], [88, 127541], [95, 127961], [100, 128221], [107, 128581], [115, 129041], [121, 129321], [127, 129701], [132, 129961]]}, {"verse": 20, "start": 130823, "end": 136950, "text": "For every one that does evil hates the light, neither comes to the light, lest his deeds should be reproved.", "words": [[0, 130823], [4, 130959], [10, 131105], [14, 131252], [19, 131552], [24, 131752], [29, 132132], [35, 132512], [39, 132712], [46, 133512], [54, 133752], [60, 134132], [63, 134352], [67, 134452], [74, 135112], [79, 135332], [83, 135512], [89, 135872], [96, 136112], [99, 136252]]}, {"verse": 21, "start": 137300, "end": 143814, "text": "But he that does truth comes to the light, that his deeds may be made manifest, that they are wrought in God.", "words": [[0, 137300], [4, 137422], [7, 137662], [12, 137902], [17, 138202], [23, 138642], [29, 139042], [32, 139322], [36, 139442], [43, 139922], [48, 1402