{"book": "PSA", "chapter": 69, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 247703, "verses": [{"verse": 1, "start": 300, "end": 9976, "text": "Al Músico principal: sobre Sosannim: Salmo de David. SÁLVAME, oh Dios, porque las aguas han entrado hasta el alma.", "words": [[0, 300], [3, 484], [10, 984], [21, 2083], [27, 2798], [37, 4458], [43, 5242], [46, 5442], [53, 6191], [62, 6560], [65, 6940], [71, 7620], [78, 7780], [82, 8060], [88, 8440], [92, 8580], [100, 9120], [106, 9280], [109, 9460]]}, {"verse": 2, "start": 10326, "end": 18214, "text": "Estoy hundido en cieno profundo, donde no hay pie: he venido a abismos de aguas, y la corriente me ha anegado.", "words": [[0, 10326], [6, 10712], [14, 11192], [17, 11372], [23, 11752], [33, 12312], [39, 12812], [42, 13112], [46, 13272], [51, 13933], [54, 14060], [61, 14460], [63, 14640], [71, 15060], [74, 15200], [81, 15780], [83, 16200], [86, 16320], [96, 16920], [99, 17220], [102, 17754]]}, {"verse": 3, "start": 18564, "end": 26486, "text": "Cansado estoy de llamar; mi garganta se ha enronquecido; han desfallecido mis ojos esperando a mi Dios.", "words": [[0, 18564], [8, 19126], [14, 19366], [17, 19606], [25, 20184], [28, 20484], [37, 20751], [40, 21017], [43, 21284], [57, 22834], [61, 23134], [74, 23974], [78, 24154], [83, 24474], [93, 24994], [95, 25314], [98, 25394]]}, {"verse": 4, "start": 26836, "end": 40538, "text": "Se han aumentado más que los cabellos de mi cabeza los que me aborrecen sin causa; se han fortalecido mis enemigos, los que me destruyen sin por qué: he venido pues a pagar lo que no he tomado.", "words": [[0, 26836], [3, 26982], [7, 27142], [17, 27862], [21, 28122], [25, 28342], [29, 28502], [38, 29082], [41, 29162], [44, 29282], [51, 30282], [55, 30342], [59, 30502], [62, 30642], [72, 31222], [76, 31422], [83, 32457], [86, 32786], [90, 32926], [102, 33866], [106, 34046], [116, 35066], [120, 35426], [124, 35566], [127, 35706], [137, 36426], [141, 36666], [145, 36986], [150, 37696], [153, 37800], [160, 38200], [165, 38440], [167, 38660], [173, 38960], [176, 39360], [180, 39500], [183, 39740], [186, 39880]]}, {"verse": 5, "start": 40888, "end": 44819, "text": "Dios, tú sabes mi locura; y mis delitos no te son ocultos.", "words": [[0, 40888], [6, 41133], [9, 41373], [15, 41633], [18, 41913], [26, 42663], [28, 42772], [32, 42912], [40, 43412], [43, 43632], [46, 43792], [50, 44032]]}, {"verse": 6, "start": 45169, "end": 54948, "text": "No sean avergonzados por mi causa los que te esperan, oh Señor Jehová de los ejércitos; no sean confusos por mí los que te buscan, oh Dios de Israel.", "words": [[0, 45169], [3, 45296], [8, 45576], [21, 46496], [25, 46736], [28, 46916], [34, 47296], [38, 47536], [42, 47676], [45, 47776], [54, 48286], [57, 48796], [63, 49196], [70, 49796], [73, 49896], [77, 50056], [88, 51282], [91, 51387], [96, 51627], [105, 52287], [109, 52494], [112, 52700], [116, 52907], [120, 53027], [123, 53147], [131, 53507], [134, 53867], [139, 54067], [142, 54287]]}, {"verse": 7, "start": 55298, "end": 61061, "text": "Porque por amor de ti he sufrido afrenta; confusión ha cubierto mi rostro.", "words": [[0, 55298], [7, 55562], [11, 55842], [16, 56102], [19, 56362], [22, 56582], [25, 56822], [33, 57422], [42, 58555], [52, 59382], [55, 59582], [64, 60142], [67, 60322]]}, {"verse": 8, "start": 61411, "end": 66769, "text": "He sido extrañado de mis hermanos, y extraño a los hijos de mi madre.", "words": [[0, 61411], [3, 61517], [8, 61817], [18, 62797], [21, 62977], [25, 63117], [35, 64137], [37, 64317], [45, 65097], [47, 65357], [51, 65537], [57, 65837], [60, 66037], [63, 66157]]}, {"verse": 9, "start": 67119, "end": 73593, "text": "Porque me consumió el celo de tu casa; y los denuestos de los que te vituperaban, cayeron sobre mí.", "words": [[0, 67119], [7, 67343], [10, 67543], [19, 68343], [22, 68603], [27, 69063], [30, 69163], [33, 69343], [39, 70090], [41, 70321], [45, 70481], [55, 71101], [58, 71221], [62, 71321], [66, 71461], [69, 71621], [82, 72321], [90, 72921], [96, 73181]]}, {"verse": 10, "start": 73943, "end": 78987, "text": "Y lloré afligiendo con ayuno mi alma; y esto me ha sido por afrenta.", "words": [[0, 73943], [2, 74069], [8, 74589], [19, 75489], [23, 75709], [29, 76109], [32, 76369], [38, 77156], [40, 77272], [45, 77472], [48, 77672], [51, 77772], [56, 77992], [60, 78252]]}, {"verse": 11, "start": 79337, "end": 84400, "text": "Puse además saco por mi vestido; y vine a serles por proverbio.", "words": [[0, 79337], [5, 79619], [12, 79879], [17, 80499], [21, 80699], [24, 80879], [33, 81866], [35, 82199], [40, 82399], [42, 82779], [49, 83159], [53, 83439]]}, {"verse": 12, "start": 84750, "end": 92893, "text": "Hablaban contra mí los que se sentaban a la puerta, y se burlaban de mí en sus canciones de los bebedores de sidra.", "words": [[0, 84750], [9, 85174], [16, 85554], [19, 85834], [23, 86154], [27, 86314], [30, 86454], [39, 87074], [41, 87174], [44, 87274], [52, 88264], [54, 88554], [57, 88754], [66, 89354], [69, 89594], [72, 89774], [75, 90074], [79, 90394], [89, 91254], [92, 91474], [96, 91594], [106, 92134], [109, 92544]]}, {"verse": 13, "start": 93243, "end": 104439, "text": "Pero yo enderezaba mi oración a ti, oh Jehová, al tiempo de tu buena voluntad: oh Dios, por la multitud de tu misericordia, por la verdad de tu salvación, óyeme.", "words": [[0, 93243], [5, 93390], [8, 93690], [19, 94490], [22, 94670], [30, 95090], [32, 95290], [36, 95500], [39, 95710], [47, 96230], [50, 96410], [57, 96690], [60, 96950], [63, 97090], [69, 97310], [79, 99547], [82, 99767], [88, 99987], [92, 100227], [95, 100387], [104, 100947], [107, 101187], [110, 101287], [124, 102247], [128, 102327], [131, 102467], [138, 102727], [141, 102987], [144, 103127], [155, 103947]]}, {"verse": 14, "start": 104789, "end": 112673, "text": "Sácame del lodo, y no sea yo sumergido: sea yo libertado de los que me aborrecen, y del profundo de las aguas.", "words": [[0, 104789], [7, 105273], [11, 105553], [17, 105933], [19, 106033], [22, 106213], [26, 106393], [29, 106673], [40, 107828], [44, 108044], [47, 108264], [57, 108984], [60, 109144], [64, 109244], [68, 109404], [71, 109544], [82, 110244], [84, 110704], [88, 110864], [97, 111544], [100, 111744], [104, 111924]]}, {"verse": 15, "start": 113023, "end": 120017, "text": "No me anegue el ímpetu de las aguas, ni me trague la hondura, ni el pozo cierre sobre mí su boca.", "words": [[0, 113023], [3, 113207], [6, 113507], [13, 113807], [16, 114067], [23, 114647], [26, 114807], [30, 115007], [37, 116047], [40, 116387], [43, 116547], [50, 116867], [53, 117357], [62, 117847], [65, 117987], [68, 118107], [73, 118447], [80, 118867], [86, 119107], [89, 119347], [92, 119527]]}, {"verse": 16, "start": 120367, "end": 127245, "text": "Óyeme, Jehová, porque apacible es tu misericordia; mírame conforme a la multitud de tus misericordias.", "words": [[0, 120687], [7, 121007], [15, 121327], [22, 121527], [31, 122287], [34, 122467], [37, 122527], [51, 123927], [58, 124232], [67, 124532], [69, 124832], [72, 124932], [81, 125552], [84, 125792], [88, 125952]]}, {"verse": 17, "start": 127595, "end": 133125, "text": "Y no escondas tu rostro de tu siervo; porque estoy angustiado; apresúrate, óyeme.", "words": [[0, 127595], [2, 127713], [5, 127853], [14, 128413], [17, 128553], [24, 129053], [27, 129173], [30, 129333], [38, 130179], [45, 130364], [51, 130604], [63, 131695], [75, 132393]]}, {"verse": 18, "start": 133475, "end": 138080, "text": "Acércate a mi alma, redímela: líbrame a causa de mis enemigos.", "words": [[0, 133475], [9, 134095], [11, 134275], [14, 134395], [20, 135102], [30, 136231], [38, 136471], [40, 136611], [46, 136911], [49, 137171], [53, 137271]]}, {"verse": 19, "start": 138430, "end": 145170, "text": "Tú sabes mi afrenta, y mi confusión, y mi deshonra: delante de ti están todos mis enemigos.", "words": [[0, 138430], [3, 138537], [9, 138797], [12, 139037], [21, 139877], [23, 140037], [26, 140157], [37, 140997], [39, 141257], [42, 141743], [52, 142394], [60, 142994], [63, 143154], [66, 143394], [72, 143654], [78, 144054], [82, 144334]]}, {"verse": 20, "start": 145520, "end": 155515, "text": "La afrenta ha quebrantado mi corazón, y estoy acongojado: y esperé quien se compadeciese de mí, y no lo hubo: y consoladores, y ninguno hallé.", "words": [[0, 145520], [3, 145670], [11, 146350], [14, 146510], [26, 147330], [29, 147510], [38, 148010], [40, 148490], [46, 148730], [58, 149910], [60, 150055], [67, 150535], [73, 150735], [76, 151265], [89, 151795], [92, 152015], [96, 152175], [98, 152355], [101, 152495], [104, 152655], [110, 153297], [112, 153402], [126, 154282], [128, 154642], [136, 155105]]}, {"verse": 21, "start": 155865, "end": 160986, "text": "Me pusieron además hiel por comida, y en mi sed me dieron a beber vinagre.", "words": [[0, 155865], [3, 155954], [12, 156474], [19, 156984], [24, 157494], [28, 157754], [36, 158274], [38, 158554], [41, 158734], [44, 158934], [48, 159254], [51, 159514], [58, 159874], [60, 159994], [66, 160194]]}, {"verse": 22, "start": 161336, "end": 166276, "text": "Sea su mesa delante de ellos por lazo, y lo que es para bien por tropiezo.", "words": [[0, 161336], [4, 161578], [7, 161818], [12, 162138], [20, 162658], [23, 162858], [29, 163038], [33, 163278], [39, 163778], [41, 164218], [44, 164358], [48, 164518], [51, 164678], [56, 164858], [61, 165078], [65, 165338]]}, {"verse": 23, "start": 166626, "end": 172720, "text": "Sean oscurecidos sus ojos para ver, y haz siempre titubear sus lomos.", "words": [[0, 166626], [5, 167066], [17, 168166], [21, 168466], [26, 168766], [31, 169086], [36, 169386], [38, 169806], [42, 169986], [50, 170646], [59, 171686], [63, 171906]]}, {"verse": 24, "start": 173070, "end": 177829, "text": "Derrama sobre ellos tu ira, y el furor de tu enojo los alcance.", "words": [[0, 173070], [8, 173604], [14, 173904], [20, 174224], [23, 174544], [28, 175404], [30, 175584], [33, 175724], [39, 176124], [42, 176284], [45, 176444], [51, 176824], [55, 177004]]}, {"verse": 25, "start": 178179, "end": 182597, "text": "Sea su palacio asolado: en sus tiendas no haya habitante.", "words": [[0, 178179], [4, 178463], [7, 178703], [15, 179353], [24, 180223], [27, 180330], [31, 180470], [39, 181090], [42, 181470], [47, 181690]]}, {"verse": 26, "start": 182947, "end": 188589, "text": "Porque persiguieron al que tú heriste; y cuentan del dolor de los que tú llagaste.", "words": [[0, 182947], [7, 183928], [20, 184328], [23, 184488], [27, 184648], [30, 185166], [39, 185869], [41, 185972], [49, 186492], [53, 186692], [59, 187072], [62, 187292], [66, 187412], [70, 187592], [73, 188119]]}, {"verse": 27, "start": 188939, "end": 193193, "text": "Pon maldad sobre su maldad, y no entren en tu justicia.", "words": [[0, 188939], [4, 189082], [11, 189622], [17, 190042], [20, 190262], [28, 190882], [30, 191322], [33, 191502], [40, 191822], [43, 192082], [46, 192242]]}, {"verse": 28, "start": 193543, "end": 197973, "text": "Sean raídos del libro de los vivientes, y no sean escritos con los justos.", "words": [[0, 193543], [5, 193764], [12, 194344], [16, 194504], [22, 194824], [25, 195004], [29, 195124], [40, 195684], [42, 196124], [45, 196244], [50, 196484], [59, 197004], [63, 197204], [67, 197384]]}, {"verse": 29, "start": 198323, "end": 203197, "text": "Y yo afligido y dolorido, tu salvación, oh Dios, me defenderá.", "words": [[0, 198323], [2, 198469], [5, 198669], [14, 199429], [16, 199529], [26, 200549], [29, 200629], [40, 201789], [43, 201929], [49, 202309], [52, 202429]]}, {"verse": 30, "start": 203547, "end": 208612, "text": "Alabaré yo el nombre de Dios con cántico, lo ensalzaré con alabanza.", "words": [[0, 203736], [8, 203962], [11, 204189], [14, 204349], [21, 204729], [24, 204929], [29, 205189], [33, 205489], [42, 206629], [45, 206709], [55, 207509], [59, 207649]]}, {"verse": 31, "start": 208962, "end": 215025, "text": "Y agradará a Jehová más que sacrificio de buey, o becerro que echa cuernos y uñas.", "words": [[0, 208962], [2, 209127], [11, 209767], [13, 210007], [20, 210467], [24, 210647], [28, 211057], [39, 211467], [42, 211907], [48, 212347], [50, 212787], [58, 213227], [62, 213437], [67, 213647], [75, 214207], [77, 214367]]}, {"verse": 32, "start": 215375, "end": 221132, "text": "Lo verán los humildes, y se gozarán; buscad a Dios, y vivirá vuestro corazón.", "words": [[0, 215375], [3, 215523], [9, 215823], [13, 215983], [23, 216843], [25, 217223], [28, 217403], [37, 218424], [44, 218908], [46, 219008], [52, 219248], [54, 219608], [61, 220048], [69, 220388]]}, {"verse": 33, "start": 221482, "end": 226731, "text": "Porque Jehová oye a los necesitados, y no menosprecia a sus prisioneros.", "words": [[0, 221482], [7, 221744], [14, 222324], [18, 222664], [20, 222824], [24, 222924], [37, 223924], [39, 224189], [42, 224389], [54, 225289], [56, 225569], [60, 225749]]}, {"verse": 34, "start": 227081, "end": 233128, "text": "Alábenlo los cielos y la tierra, los mares, y todo lo que se mueve en ellos.", "words": [[0, 227426], [9, 227806], [13, 227986], [20, 228546], [22, 228666], [25, 228806], [33, 229746], [37, 229826], [44, 230386], [46, 230786], [51, 231126], [54, 231426], [58, 231566], [61, 231746], [67, 232326], [70, 232546]]}, {"verse": 35, "start": 233478, "end": 240914, "text": "Porque Dios guardará a Sion, y reedificará las ciudades de Judá; y habitarán allí, y la poseerán.", "words": [[0, 233478], [7, 233723], [12, 234003], [21, 234463], [23, 234923], [29, 235383], [31, 235812], [43, 236241], [47, 236670], [56, 237099], [59, 237528], [65, 238382], [67, 238602], [77, 239142], [83, 239482], [85, 239822], [88, 239942]]}, {"verse": 36, "start": 241264, "end": 247303, "text": "Y la descendencia de sus siervos la heredará, y los que aman su nombre habitarán en ella.", "words": [[0, 241264], [2, 241367], [5, 241487], [18, 242447], [21, 242587], [25, 242747], [33, 243427], [36, 243867], [46, 244607], [48, 245047], [52, 245187], [56, 245347], [61, 245527], [64, 245787], [71, 246067], [81, 246647], [84, 246767]]}]}