{"book": "ACT", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 470475, "verses": [{"verse": 1, "start": 300, "end": 4551, "text": "EL sumo sacerdote dijo entonces: ¿Es esto así?", "words": [[0, 300], [3, 446], [8, 946], [18, 2026], [23, 2386], [33, 3687], [37, 3870], [42, 4110]]}, {"verse": 2, "start": 4901, "end": 15082, "text": "Y él dijo: Varones hermanos y padres, oíd: El Dios de la gloria apareció a nuestro padre Abraham, estando en Mesopotamia, antes que morase en Harán,", "words": [[0, 4901], [2, 5089], [5, 5249], [11, 6018], [19, 6581], [28, 7021], [30, 7121], [38, 7861], [43, 8538], [46, 8663], [51, 8883], [54, 9063], [57, 9183], [64, 9603], [73, 10163], [75, 10263], [83, 10383], [89, 10943], [98, 11903], [106, 12343], [109, 12463], [122, 13623], [128, 13843], [132, 14063], [139, 14463], [142, 14773]]}, {"verse": 3, "start": 15532, "end": 20461, "text": "Y le dijo: Sal de tu tierra y de tus parientes, y ven a la tierra que te mostraré.", "words": [[0, 15532], [2, 15691], [5, 15751], [11, 16506], [15, 16740], [18, 16920], [21, 17060], [28, 17400], [30, 17540], [33, 17640], [37, 17760], [48, 18360], [50, 18800], [54, 18940], [56, 19100], [59, 19160], [66, 19440], [70, 19700], [73, 19800]]}, {"verse": 4, "start": 20911, "end": 30252, "text": "Entonces salió de la tierra de los caldeos, y habitó en Harán: y de allí, muerto su padre, lo trasladó a esta tierra, en la cual vosotros habitáis ahora;", "words": [[0, 20911], [9, 21255], [15, 21796], [18, 21896], [21, 21996], [28, 22236], [31, 22436], [35, 22536], [44, 23176], [46, 23416], [53, 23796], [56, 24336], [63, 25120], [65, 25245], [68, 25345], [74, 25505], [81, 25925], [84, 26085], [91, 26425], [94, 26885], [103, 27425], [105, 27525], [110, 27705], [118, 28125], [121, 28585], [124, 28665], [129, 28825], [138, 29285], [147, 29825]]}, {"verse": 5, "start": 30702, "end": 39439, "text": "Y no le dio herencia en ella, ni aun para asentar un pie: pero le prometió que se la daría en posesión, y a su descendencia después de él, no teniendo hijo.", "words": [[0, 30702], [2, 30808], [5, 30928], [8, 31048], [12, 31228], [21, 31608], [24, 31788], [30, 32048], [33, 32428], [37, 32688], [42, 33078], [50, 33468], [53, 33568], [58, 34210], [63, 34353], [66, 34513], [75, 34973], [79, 35093], [82, 35213], [85, 35333], [91, 35633], [94, 35713], [104, 36333], [106, 36633], [108, 36733], [111, 36853], [124, 37573], [132, 37793], [135, 38113], [139, 38313], [142, 38593], [151, 39033]]}, {"verse": 6, "start": 39889, "end": 49193, "text": "Y le dijo Dios así: Que su descendencia sería extranjera en tierra ajena, y que los someterían a esclavitud y maltratarían, por cuatrocientos años.", "words": [[0, 39889], [2, 40033], [5, 40113], [10, 40373], [15, 40613], [20, 41402], [24, 41486], [27, 41646], [40, 42446], [46, 42686], [57, 43566], [60, 43706], [67, 43966], [74, 44546], [76, 45006], [80, 45116], [84, 45226], [95, 45906], [97, 45966], [108, 46546], [110, 46706], [124, 47446], [128, 47866], [142, 48286]]}, {"verse": 7, "start": 49643, "end": 56958, "text": "Pero yo juzgaré, dijo Dios, la nación a la cual serán siervos: y después de esto saldrán y me servirán en este lugar.", "words": [[0, 49643], [5, 49767], [8, 49967], [17, 50527], [22, 50727], [28, 51507], [31, 51587], [38, 52007], [40, 52307], [43, 52347], [48, 52587], [54, 53007], [63, 54031], [65, 54138], [73, 54458], [76, 54678], [81, 54898], [89, 55478], [91, 55538], [94, 55638], [103, 56138], [106, 56258], [111, 56458]]}, {"verse": 8, "start": 57408, "end": 67906, "text": "Y le dio el pacto de la circuncisión: y así Abraham engendró a Isaac, y le circuncidó al octavo día; e Isaac a Jacob, y Jacob a los doce patriarcas.", "words": [[0, 57408], [2, 57534], [5, 57654], [9, 57854], [12, 58034], [18, 58414], [21, 58494], [24, 58594], [38, 59858], [40, 60000], [44, 60260], [52, 60780], [61, 61400], [63, 61520], [70, 61820], [72, 62340], [75, 62460], [86, 63300], [89, 63440], [96, 63740], [101, 64458], [103, 64631], [109, 64837], [111, 65044], [118, 65504], [120, 65984], [126, 66324], [128, 66544], [132, 66714], [137, 66884]]}, {"verse": 9, "start": 68356, "end": 73682, "text": "Y los patriarcas, movidos de envidia, vendieron a José para Egipto; pero Dios era con él,", "words": [[0, 68356], [2, 68426], [6, 68766], [18, 69106], [26, 69566], [29, 69766], [38, 70266], [48, 70746], [50, 70906], [55, 71146], [60, 71446], [68, 72366], [73, 72583], [78, 72823], [82, 73103], [86, 73323]]}, {"verse": 10, "start": 74132, "end": 85235, "text": "Y le libró de todas sus tribulaciones, y le dio gracia y sabiduría en la presencia de Faraón, rey de Egipto, el cual le puso por gobernador sobre Egipto, y sobre toda su casa.", "words": [[0, 74132], [2, 74260], [5, 74360], [11, 74760], [14, 74860], [20, 75040], [24, 75340], [39, 76140], [41, 76640], [44, 76720], [48, 76880], [55, 77360], [57, 77440], [67, 78140], [70, 78400], [73, 78480], [83, 79040], [86, 79200], [94, 80020], [98, 80280], [101, 80360], [109, 81220], [112, 81300], [117, 81480], [120, 81680], [125, 82000], [129, 82180], [140, 82760], [146, 83020], [154, 83982], [156, 84079], [162, 84359], [167, 84639], [170, 84719]]}, {"verse": 11, "start": 85685, "end": 93361, "text": "Vino entonces hambre en toda la tierra de Egipto y de Canaán, y grande tribulación; y nuestros padres no hallaban alimentos.", "words": [[0, 85685], [5, 85906], [14, 86366], [21, 86946], [24, 87106], [29, 87266], [32, 87466], [39, 87746], [42, 87926], [49, 88406], [51, 88486], [54, 88776], [62, 89066], [64, 89526], [71, 89806], [84, 91051], [86, 91154], [95, 91394], [102, 91894], [105, 92174], [114, 92554]]}, {"verse": 12, "start": 93811, "end": 98764, "text": "Y como oyese Jacob que había trigo en Egipto, envió a nuestros padres la primera vez.", "words": [[0, 93811], [2, 93898], [7, 94118], [13, 94338], [19, 94758], [23, 95038], [29, 95198], [35, 95618], [38, 95758], [46, 96378], [52, 96978], [54, 97058], [63, 97238], [70, 97758], [73, 97978], [81, 98238]]}, {"verse": 13, "start": 99214, "end": 105391, "text": "Y en la segunda, José fue conocido de sus hermanos, y fue sabido de Faraón el linaje de José.", "words": [[0, 99214], [2, 99334], [5, 99434], [8, 99514], [17, 100354], [22, 100674], [26, 100974], [35, 101554], [38, 101694], [42, 101834], [52, 102534], [54, 102894], [58, 103054], [65, 103434], [68, 103594], [75, 104114], [78, 104394], [85, 104814], [88, 104914]]}, {"verse": 14, "start": 105841, "end": 112111, "text": "Y enviando José, hizo venir a su padre Jacob, y a todos sus parientes, en número de setenta y cinco personas.", "words": [[0, 105841], [2, 105949], [11, 106409], [17, 106729], [22, 107049], [28, 107249], [30, 107429], [33, 107549], [39, 107809], [46, 108189], [48, 108729], [50, 108829], [56, 109009], [60, 109249], [71, 109769], [74, 110129], [81, 110369], [84, 110524], [92, 110679], [94, 110834], [100, 110989]]}, {"verse": 15, "start": 112561, "end": 117146, "text": "Así descendió Jacob a Egipto, donde murió él y nuestros padres;", "words": [[0, 112561], [4, 112806], [14, 113306], [20, 113606], [22, 113826], [30, 114486], [36, 114606], [42, 115006], [45, 115246], [47, 115466], [56, 115646]]}, {"verse": 16, "start": 117596, "end": 125056, "text": "Los cuales fueron trasladados a Siquem, y puestos en el sepulcro que compró Abraham a precio de dinero de los hijos de Hamor de Siquem.", "words": [[0, 117596], [4, 117735], [11, 118015], [18, 118415], [30, 119115], [32, 119415], [40, 119715], [42, 120195], [50, 120675], [53, 120815], [56, 120935], [65, 121435], [69, 121575], [76, 121975], [84, 122355], [86, 122555], [93, 122795], [96, 122995], [103, 123255], [106, 123475], [110, 123595], [116, 123855], [119, 124075], [125, 124295], [128, 124705]]}, {"verse": 17, "start": 125506, "end": 132441, "text": "Pero como se acercaba el tiempo de la promesa, la cual Dios había jurado a Abraham, el pueblo creció y se multiplicó en Egipto,", "words": [[0, 125506], [5, 125643], [10, 125843], [13, 125983], [22, 126443], [25, 126563], [32, 126843], [35, 127023], [38, 127143], [47, 127643], [50, 127743], [55, 127943], [60, 128223], [66, 128543], [73, 129003], [75, 129393], [84, 129783], [87, 129883], [94, 130163], [101, 130783], [103, 131023], [106, 131123], [117, 131743], [120, 131863]]}, {"verse": 18, "start": 132891, "end": 136425, "text": "Hasta que se levantó otro rey en Egipto que no conocía a José.", "words": [[0, 132891], [6, 133097], [10, 133257], [13, 133377], [21, 133877], [26, 134117], [30, 134437], [33, 134517], [40, 134977], [44, 135117], [47, 135297], [55, 135837], [57, 135997]]}, {"verse": 19, "start": 136875, "end": 146701, "text": "Este, usando de astucia con nuestro linaje, maltrató a nuestros padres, a fin de que pusiesen a peligro de muerte sus niños, para que cesase la generación.", "words": [[0, 136875], [6, 137375], [13, 137735], [16, 137955], [24, 138495], [28, 138715], [36, 138915], [44, 140035], [53, 140575], [55, 140655], [64, 140855], [72, 141395], [74, 141895], [78, 142055], [81, 142195], [85, 142315], [94, 142775], [96, 142935], [104, 143375], [107, 143475], [114, 143735], [118, 144015], [125, 144375], [130, 145035], [134, 145365], [141, 145695], [144, 145855]]}, {"verse": 20, "start": 147151, "end": 153992, "text": "En aquel mismo tiempo nació Moisés, y fue agradable a Dios: y fue criado tres meses en casa de su padre.", "words": [[0, 147151], [3, 147269], [9, 147509], [15, 147689], [22, 148029], [28, 148489], [36, 148929], [38, 149569], [42, 149729], [52, 150269], [54, 150389], [60, 151177], [62, 151476], [66, 151636], [73, 152076], [78, 152296], [84, 152616], [87, 152896], [92, 153136], [95, 153356], [98, 153476]]}, {"verse": 21, "start": 154442, "end": 160455, "text": "Pero cuando estaba en peligro de morir, la hija de Faraón lo recogió y le crio como a hijo suyo.", "words": [[0, 154442], [5, 154580], [12, 154840], [19, 155220], [22, 155400], [30, 155860], [33, 155960], [40, 156820], [43, 156920], [48, 157260], [51, 157560], [58, 157860], [61, 158000], [69, 158640], [71, 158860], [74, 158960], [79, 159320], [84, 159560], [86, 159700], [91, 159860]]}, {"verse": 22, "start": 160905, "end": 168007, "text": "Y fue enseñado Moisés en toda la sabiduría de los egipcios; y era poderoso en sus dichos y hechos.", "words": [[0, 160905], [2, 161004], [6, 161164], [15, 161764], [22, 162224], [25, 162604], [30, 162824], [33, 163044], [43, 163704], [46, 163804], [50, 163944], [60, 165682], [62, 165833], [66, 165953], [75, 166553], [78, 166713], [82, 166893], [89, 167313], [91, 167453]]}, {"verse": 23, "start": 168457, "end": 174738, "text": "Y cuando hubo cumplido la edad de cuarenta años, le vino voluntad de visitar a sus hermanos los hijos de Israel.", "words": [[0, 168457], [2, 168538], [9, 168758], [14, 169118], [23, 169638], [26, 169778], [31, 170058], [34, 170268], [43, 170478], [49, 171358], [52, 171438], [57, 171618], [66, 172238], [69, 172358], [77, 172818], [79, 172858], [83, 173018], [92, 173538], [96, 173678], [102, 173938], [105, 174138]]}, {"verse": 24, "start": 175188, "end": 180907, "text": "Y cuando vio a uno que era maltratado, lo defendió, e hiriendo al egipcio, vengó al oprimido.", "words": [[0, 175188], [2, 175275], [9, 175515], [13, 175815], [15, 175915], [19, 176095], [23, 176295], [27, 176915], [39, 177535], [42, 177655], [52, 178755], [54, 178855], [63, 179255], [66, 179415], [75, 179895], [81, 180252], [84, 180608]]}, {"verse": 25, "start": 181357, "end": 188212, "text": "Pero él pensaba que sus hermanos entendían que Dios les había de dar libertad por su mano; pero ellos no lo habían entendido.", "words": [[0, 181357], [5, 181497], [8, 181657], [16, 182157], [20, 182317], [24, 182477], [33, 182977], [43, 183577], [47, 183737], [52, 183977], [56, 184237], [62, 184517], [65, 184677], [69, 184817], [78, 185357], [82, 185497], [85, 185657], [91, 186322], [96, 186481], [102, 186761], [105, 187061], [108, 187181], [115, 187421]]}, {"verse": 26, "start": 188662, "end": 198649, "text": "Y al día siguiente, riñendo ellos, se les mostró, y los ponía en paz, diciendo: Varones, hermanos sois, ¿por qué os maltratáis los unos a los otros?", "words": [[0, 188662], [2, 188948], [5, 189088], [9, 189248], [20, 190168], [28, 190668], [35, 191308], [38, 191408], [42, 191528], [50, 192108], [52, 192468], [56, 192608], [62, 193048], [65, 193148], [70, 193728], [80, 194941], [89, 195251], [98, 195801], [104, 196351], [109, 196431], [113, 196591], [116, 196711], [127, 197291], [131, 197431], [136, 197691], [138, 197911], [142, 198051]]}, {"verse": 27, "start": 199099, "end": 206442, "text": "Entonces el que maltrataba a su prójimo, lo empujó, diciendo: ¿Quién te ha puesto por príncipe y juez sobre nosotros?", "words": [[0, 199099], [9, 199603], [12, 199923], [16, 200063], [27, 200703], [29, 200803], [32, 200903], [41, 201523], [44, 201963], [52, 202583], [62, 203750], [69, 203968], [72, 204028], [75, 204168], [82, 204348], [86, 204628], [95, 205088], [97, 205228], [102, 205468], [108, 205608]]}, {"verse": 28, "start": 206892, "end": 209482, "text": "¿Quieres tú matarme, como mataste ayer al egipcio?", "words": [[0, 206892], [9, 207213], [12, 207293], [21, 207713], [26, 207913], [34, 208393], [39, 208633], [42, 208793]]}, {"verse": 29, "start": 209932, "end": 215888, "text": "A esta palabra Moisés huyó, y se hizo extranjero en tierra de Madián, donde engendró dos hijos.", "words": [[0, 209932], [2, 210049], [7, 210249], [15, 210549], [22, 211049], [28, 211549], [30, 212129], [33, 212309], [38, 212549], [49, 213209], [52, 213349], [59, 213609], [62, 214059], [70, 214509], [76, 214629], [85, 215169], [89, 215369]]}, {"verse": 30, "start": 216338, "end": 223548, "text": "Y cumplidos cuarenta años, un ángel le apareció en el desierto del monte Sinaí, en fuego de llama de una zarza.", "words": [[0, 216338], [2, 216437], [12, 216977], [21, 217617], [27, 218457], [30, 218577], [36, 218937], [39, 219037], [48, 219557], [51, 219677], [54, 219777], [63, 220257], [67, 220457], [73, 220757], [80, 221677], [83, 221877], [89, 222097], [92, 222337], [98, 222577], [101, 222797], [105, 223197]]}, {"verse": 31, "start": 223998, "end": 230818, "text": "Entonces Moisés mirando, se maravilló de la visión: y acercándose para observar, le llegó la voz del Señor:", "words": [[0, 223998], [9, 224400], [16, 224860], [25, 225320], [28, 225660], [38, 226180], [41, 226240], [44, 226340], [52, 227232], [54, 227350], [66, 228030], [71, 228250], [81, 229110], [84, 229410], [90, 229670], [93, 229870], [97, 230070], [101, 230230]]}, {"verse": 32, "start": 231268, "end": 239616, "text": "Yo soy el Dios de tus padres, el Dios de Abraham, y el Dios de Isaac, y el Dios de Jacob. Pero Moisés, temeroso, no se atrevía a mirar.", "words": [[0, 231268], [3, 231391], [7, 231631], [10, 231831], [15, 232031], [18, 232231], [22, 232371], [30, 233111], [33, 233191], [38, 233391], [41, 233571], [50, 233931], [52, 234471], [55, 234591], [60, 234771], [63, 234931], [70, 235231], [72, 235571], [75, 235691], [80, 235851], [83, 236011], [90, 236783], [95, 236942], [103, 237262], [113, 237942], [116, 238462], [119, 238602], [127, 239062], [129, 239162]]}, {"verse": 33, "start": 240066, "end": 246970, "text": "Y le dijo el Señor: Quita los zapatos de tus pies, porque el lugar en que estás es tierra santa.", "words": [[0, 240066], [2, 240166], [5, 240266], [10, 240486], [13, 240606], [20, 241436], [26, 241752], [30, 241912], [38, 242472], [41, 242632], [45, 242812], [51, 243752], [58, 244012], [61, 244192], [67, 244412], [70, 244632], [74, 244752], [80, 245092], [83, 245552], [90, 245972]]}, {"verse": 34, "start": 247270, "end": 257260, "text": "He visto, he visto la aflicción de mi pueblo que está en Egipto, y he oído el gemido de ellos, y he descendido para librarlos. Ahora pues, ven, te enviaré a Egipto.", "words": [[0, 247270], [3, 247414], [10, 248054], [13, 248214], [19, 248414], [22, 248614], [32, 249154], [35, 249314], [38, 249414], [45, 249694], [49, 249934], [54, 250154], [57, 250314], [65, 250854], [67, 251254], [70, 251374], [75, 251654], [78, 251794], [85, 252194], [88, 252374], [95, 252634], [97, 253134], [100, 253194], [111, 253754], [116, 253954], [127, 255036], [133, 255284], [139, 255504], [144, 256024], [147, 256104], [155, 256604], [157, 256684]]}, {"verse": 35, "start": 257710, "end": 268938, "text": "A este Moisés, al cual habían rechazado, diciendo: ¿Quién te ha puesto por príncipe y juez? a este envió Dios por príncipe y redentor con la mano del ángel que le apareció en la zarza.", "words": [[0, 257710], [2, 257852], [7, 258052], [15, 258472], [18, 258832], [23, 259012], [30, 259652], [41, 260292], [51, 261231], [58, 261451], [61, 261531], [64, 261671], [71, 261851], [75, 262151], [84, 262611], [86, 262771], [92, 263491], [94, 263635], [99, 263875], [105, 264295], [110, 264515], [114, 264815], [123, 265435], [125, 265655], [134, 266215], [138, 266395], [141, 266535], [146, 266735], [150, 266915], [156, 267315], [160, 267455], [163, 267575], [172, 268135], [175, 268255], [178, 268355]]}, {"verse": 36, "start": 269388, "end": 276879, "text": "Este los sacó, habiendo hecho prodigios y milagros en la tierra de Egipto, y en el Mar Rojo, y en el desierto por cuarenta años.", "words": [[0, 269516], [5, 269662], [9, 269809], [15, 270189], [24, 270509], [30, 270769], [40, 271429], [42, 271529], [51, 271989], [54, 272169], [57, 272249], [64, 272549], [67, 272709], [75, 273429], [77, 273689], [80, 273789], [83, 273889], [87, 274069], [93, 274509], [95, 274949], [98, 275049], [101, 275149], [110, 275589], [114, 275919], [123, 276249]]}, {"verse": 37, "start": 277329, "end": 285764, "text": "Este es el Moisés, el cual dijo a los hijos de Israel: Profeta os levantará el Señor Dios vuestro de vuestros hermanos, como yo; a él oiréis.", "words": [[0, 277329], [5, 277630], [8, 277870], [11, 278010], [19, 278750], [22, 278830], [27, 278970], [32, 279270], [34, 279410], [38, 279510], [44, 279730], [47, 279930], [55, 280882], [63, 281028], [66, 281175], [76, 281715], [79, 281835], [85, 282075], [90, 282375], [98, 282915], [101, 283015], [110, 283335], [120, 283935], [125, 284055], [129, 284740], [131, 284898], [134, 285358]]}, {"verse": 38, "start": 286214, "end": 296510, "text": "Este es aquel que estuvo en la congregación en el desierto con el ángel que le hablaba en el monte Sinaí, y con nuestros padres; y recibió las palabras de vida para dárnoslas:", "words": [[0, 286214], [5, 286474], [8, 286754], [14, 287114], [18, 287234], [25, 287614], [28, 287754], [31, 287814], [44, 288554], [47, 288734], [50, 288854], [59, 289414], [63, 289694], [66, 289814], [72, 290214], [76, 290334], [79, 290474], [87, 290914], [90, 291054], [93, 291134], [99, 291414], [106, 291994], [108, 292414], [112, 292594], [121, 292794], [129, 293910], [131, 293998], [139, 294478], [143, 294638], [152, 294998], [155, 295258], [160, 295458], [165, 296008]]}, {"verse": 39, "start": 296960, "end": 303722, "text": "Al cual nuestros padres no quisieron obedecer; sino que lo rechazaron, y se apartaron de corazón a Egipto,", "words": [[0, 296960], [3, 297122], [8, 297362], [17, 297602], [24, 298182], [27, 298462], [37, 298962], [47, 299978], [52, 300215], [56, 300355], [59, 300475], [71, 301195], [73, 301735], [76, 301855], [86, 302435], [89, 302595], [97, 302975], [99, 303195]]}, {"verse": 40, "start": 304172, "end": 314121, "text": "Diciendo a Aarón: Haznos dioses que vayan delante de nosotros; porque a este Moisés, que nos sacó de tierra de Egipto, no sabemos qué le ha acontecido.", "words": [[0, 304172], [9, 304654], [11, 305059], [18, 305704], [25, 306090], [32, 306570], [36, 306810], [42, 307150], [50, 307550], [53, 307670], [63, 308681], [70, 308880], [72, 309020], [77, 309180], [85, 310160], [89, 310240], [93, 310380], [98, 310820], [101, 310960], [108, 311240], [111, 311420], [119, 312340], [122, 312440], [130, 312820], [134, 313120], [137, 313260], [140, 313380]]}, {"verse": 41, "start": 314571, "end": 321359, "text": "Y entonces hicieron un becerro, y ofrecieron sacrificio al ídolo, y en las obras de sus manos se regocijaron.", "words": [[0, 314571], [2, 314673], [11, 314973], [20, 315693], [23, 315853], [32, 316473], [34, 316673], [45, 317213], [56, 317973], [59, 318113], [66, 318453], [68, 318953], [71, 319073], [75, 319193], [81, 319493], [84, 319673], [88, 319813], [94, 320153], [97, 320413]]}, {"verse": 42, "start": 321809, "end": 333972, "text": "Y Dios se apartó, y los entregó que sirviesen al ejército del cielo; como está escrito en el libro de los profetas: ¿Me ofrecisteis víctimas y sacrificios en el desierto por cuarenta años, casa de Israel?", "words": [[0, 321809], [2, 321933], [7, 322133], [10, 322313], [18, 322833], [20, 323213], [24, 323353], [32, 323833], [36, 323933], [46, 324453], [49, 324633], [58, 325133], [62, 325333], [69, 326106], [74, 326267], [79, 326547], [87, 326927], [90, 327147], [93, 327287], [99, 327507], [102, 327687], [106, 327807], [116, 328946], [120, 329051], [132, 329751], [141, 330291], [143, 330431], [155, 331151], [158, 331291], [161, 331391], [170, 331891], [174, 332201], [183, 332511], [189, 333031], [194, 333151], [197, 333391]]}, {"verse": 43, "start": 334422, "end": 344820, "text": "Antes, trajisteis el tabernáculo de Moloc, y la estrella de vuestro dios Renfán: figuras que os hicisteis para adorarlas: os transportaré pues, más allá de Babilonia.", "words": [[0, 334422], [7, 334725], [18, 335505], [21, 335625], [33, 336245], [36, 336535], [43, 336825], [45, 337365], [48, 337485], [57, 337945], [60, 338045], [68, 338365], [73, 338665], [81, 339651], [89, 340017], [93, 340217], [96, 340357], [106, 340937], [111, 341117], [122, 342151], [125, 342288], [138, 342968], [144, 343248], [148, 343748], [153, 343988], [156, 344128]]}, {"verse": 44, "start": 345270, "end": 354331, "text": "Tuvieron nuestros padres el tabernáculo del testimonio en el desierto, como había ordenado Dios, hablando a Moisés que lo hiciese según la forma que había visto.", "words": [[0, 345270], [9, 345605], [18, 345885], [25, 346325], [28, 346685], [40, 347365], [44, 347565], [55, 348225], [58, 348325], [61, 348425], [71, 349345], [76, 349545], [82, 349745], [91, 350165], [97, 350965], [106, 351225], [108, 351425], [115, 351825], [119, 352105], [122, 352225], [130, 352705], [136, 352965], [139, 353165], [145, 353445], [149, 353645], [155, 353845]]}, {"verse": 45, "start": 354781, "end": 363892, "text": "El cual recibido, metieron también nuestros padres con Josué en la posesión de los Gentiles, que Dios echó de la presencia de nuestros padres, hasta los días de David;", "words": [[0, 354781], [3, 354901], [8, 355181], [18, 356081], [27, 356521], [35, 356821], [44, 357161], [51, 357641], [55, 357921], [61, 358401], [64, 358541], [67, 358661], [76, 359181], [79, 359321], [83, 359421], [93, 360281], [97, 360381], [102, 360641], [107, 361041], [110, 361141], [113, 361241], [123, 361701], [126, 361821], [135, 362001], [143, 362741], [149, 362961], [153, 363141], [158, 363341], [161, 363521]]}, {"verse": 46, "start": 364342, "end": 369296, "text": "El cual halló gracia delante de Dios, y pidió hallar tabernáculo para el Dios de Jacob.", "words": [[0, 364342], [3, 364480], [8, 364640], [14, 364960], [21, 365360], [29, 365760], [32, 365880], [38, 366140], [40, 366760], [46, 367160], [53, 367480], [65, 368080], [70, 368340], [73, 368480], [78, 368620], [81, 368760]]}, {"verse": 47, "start": 369746, "end": 371415, "text": "Pero Salomón le edificó casa.", "words": [[0, 369746], [5, 369886], [13, 370386], [16, 370506], [24, 370946]]}, {"verse": 48, "start": 371865, "end": 376301, "text": "Si bien el Altísimo no habita en templos hechos de mano; como el profeta dice:", "words": [[0, 371865], [3, 372030], [8, 372270], [11, 372370], [20, 372830], [23, 373050], [30, 373390], [33, 373510], [41, 373950], [48, 374210], [51, 374350], [57, 375075], [62, 375235], [65, 375395], [73, 375815]]}, {"verse": 49, "start": 376751, "end": 385385, "text": "El cielo es mi trono, y la tierra es el estrado de mis pies. ¿Qué casa me edificaréis? dice el Señor; ¿o cuál es el lugar de mi reposo?", "words": [[0, 376751], [3, 376891], [9, 377231], [12, 377451], [15, 377571], [22, 377951], [24, 378391], [27, 378531], [34, 378811], [37, 379011], [40, 379111], [48, 379531], [51, 379671], [55, 379771], [61, 380613], [66, 380735], [71, 381015], [74, 381235], [87, 382386], [92, 382630], [95, 382770], [102, 383599], [105, 383699], [110, 383879], [113, 384099], [116, 384219], [122, 384439], [125, 384639], [128, 384759]]}, {"verse": 50, "start": 385835, "end": 388147, "text": "¿No hizo mi mano todas estas cosas?", "words": [[0, 385835], [4, 385979], [9, 386259], [12, 386499], [17, 386779], [23, 387039], [29, 387419]]}, {"verse": 51, "start": 388597, "end": 397887, "text": "Duros de cerviz, e incircuncisos de corazón y de oídos, vosotros resistís siempre al Espíritu Santo: como vuestros padres, así también vosotros.", "words": [[0, 388597], [6, 389078], [9, 389358], [17, 389638], [19, 390268], [33, 390898], [36, 391038], [44, 391438], [46, 391638], [49, 391758], [56, 392578], [65, 392938], [74, 393538], [82, 393878], [85, 394078], [94, 394558], [101, 395339], [106, 395483], [115, 395903], [123, 396583], [127, 396763], [135, 397123]]}, {"verse": 52, "start": 398337, "end": 408281, "text": "¿A cuál de los profetas no persiguieron vuestros padres? y mataron a los que antes anunciaron la venida del Justo, del cual vosotros ahora habéis sido traidores y asesinos;", "words": [[0, 398337], [3, 398459], [8, 398639], [11, 398819], [15, 398959], [24, 399479], [27, 399679], [40, 400299], [49, 400639], [57, 401618], [59, 401721], [67, 402181], [69, 402321], [73, 402441], [77, 402601], [83, 402841], [94, 403521], [97, 403661], [104, 404001], [108, 404181], [115, 404921], [119, 405061], [124, 405281], [133, 405801], [139, 406121], [146, 406641], [151, 406861], [161, 407321], [163, 407561]]}, {"verse": 53, "start": 408731, "end": 412890, "text": "Que recibisteis la ley por disposición de ángeles, y no la guardasteis.", "words": [[0, 408731], [4, 408810], [16, 409610], [19, 409750], [23, 409950], [27, 410130], [39, 410790], [42, 410950], [51, 411450], [53, 411710], [56, 411870], [59, 412010]]}, {"verse": 54, "start": 413240, "end": 419886, "text": "Y oyendo estas cosas, se enfurecían en sus corazones, y crujían los dientes contra él.", "words": [[0, 413240], [2, 413383], [9, 413703], [15, 413923], [22, 414443], [25, 415363], [36, 416123], [39, 416343], [43, 416543], [54, 417603], [56, 417763], [64, 418443], [68, 418603], [76, 419003], [83, 419423]]}, {"verse": 55, "start": 420336, "end": 429720, "text": "Pero él, estando lleno de Espíritu Santo, puestos los ojos en el cielo, vio la gloria de Dios, y a Jesús que estaba a la diestra de Dios,", "words": [[0, 420336], [5, 420517], [9, 420817], [17, 421297], [23, 421697], [26, 421817], [35, 422377], [42, 423317], [50, 423817], [54, 423977], [59, 424317], [62, 424577], [65, 424717], [72, 425397], [76, 425697], [79, 425837], [86, 426237], [89, 426397], [95, 426697], [97, 427217], [99, 427337], [105, 427937], [109, 428077], [116, 428377], [118, 428577], [121, 428617], [129, 429097], [132, 429297]]}, {"verse": 56, "start": 430170, "end": 435765, "text": "Y dijo: He aquí, veo los cielos abiertos, y al Hijo del hombre que está a la diestra de Dios.", "words": [[0, 430170], [2, 430319], [8, 431067], [11, 431209], [17, 431489], [21, 431749], [25, 431929], [32, 432349], [42, 433209], [44, 433369], [47, 433489], [52, 433709], [56, 433909], [63, 434269], [67, 434369], [72, 434629], [74, 434729], [77, 434789], [85, 435169], [88, 435329]]}, {"verse": 57, "start": 436115, "end": 443434, "text": "Entonces dando grandes voces, se taparon sus oídos, y arremetieron unánimes contra él;", "words": [[0, 436115], [9, 437305], [15, 437645], [23, 438045], [30, 438965], [33, 439085], [41, 439545], [45, 439725], [52, 440665], [54, 440885], [67, 441765], [76, 442585], [83, 442945]]}, {"verse": 58, "start": 443884, "end": 451986, "text": "Y echándolo fuera de la ciudad, le apedreaban: y los testigos pusieron sus vestidos a los pies de un joven que se llamaba Saulo.", "words": [[0, 443884], [2, 443994], [12, 444534], [18, 444794], [21, 444994], [24, 445134], [32, 445994], [35, 446134], [47, 447653], [49, 447759], [53, 447899], [62, 448439], [71, 448859], [75, 449079], [84, 449599], [86, 449779], [90, 449899], [95, 450079], [98, 450239], [101, 450359], [107, 450719], [111, 450839], [114, 450959], [122, 451359]]}, {"verse": 59, "start": 452436, "end": 458745, "text": "Y apedrearon a Esteban, invocando él y diciendo: Señor Jesús, recibe mi espíritu.", "words": [[0, 452436], [2, 452566], [13, 453266], [15, 453406], [24, 454006], [34, 454966], [37, 455226], [39, 455446], [49, 456482], [55, 456725], [62, 457505], [69, 457965], [72, 458105]]}, {"verse": 60, "start": 459095, "end": 470075, "text": "Y puesto de rodillas, clamó a gran voz: Señor, no les imputes este pecado. Y habiendo dicho esto, durmió.", "words": [[0, 459095], [2, 459217], [9, 459557], [12, 459857], [22, 460957], [28, 461397], [30, 461497], [35, 461637], [40, 462507], [47, 462993], [50, 463053], [54, 463233], [62, 463693], [67, 463953], [75, 467856], [77, 468016], [86, 468416], [92, 468756], [98, 469416]]}]}