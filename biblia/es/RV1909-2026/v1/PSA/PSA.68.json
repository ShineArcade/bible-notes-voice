{"book": "PSA", "chapter": 68, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 278993, "verses": [{"verse": 1, "start": 300, "end": 11332, "text": "Al Músico principal: Salmo de David: Canción. LEVÁNTESE Dios, sean esparcidos sus enemigos, y huyan de su presencia los que le aborrecen.", "words": [[0, 300], [3, 471], [10, 971], [21, 2146], [27, 2643], [30, 2803], [37, 3658], [46, 4651], [56, 5259], [62, 6079], [67, 6279], [78, 7059], [82, 7299], [92, 7979], [94, 8339], [100, 8719], [103, 8859], [106, 8999], [116, 9739], [120, 10199], [124, 10339], [127, 10479]]}, {"verse": 2, "start": 11782, "end": 22195, "text": "Como es lanzado el humo, los lanzarás: como se derrite la cera delante del fuego, así perecerán los impíos delante de Dios.", "words": [[0, 11782], [5, 12172], [8, 12352], [16, 13092], [19, 13252], [25, 14052], [29, 14292], [39, 16039], [44, 16202], [47, 16552], [55, 16902], [58, 17122], [63, 17442], [71, 17862], [75, 18082], [82, 18922], [86, 19302], [96, 20042], [100, 20202], [107, 20942], [115, 21402], [118, 21562]]}, {"verse": 3, "start": 22645, "end": 28824, "text": "Mas los justos se alegrarán: se gozarán delante de Dios, y saltarán de alegría.", "words": [[0, 22645], [4, 22920], [8, 23226], [15, 23533], [18, 23873], [29, 25076], [32, 25336], [40, 25856], [48, 26256], [51, 26416], [57, 26716], [59, 27316], [68, 27956], [71, 28056]]}, {"verse": 4, "start": 29274, "end": 39314, "text": "Cantad a Dios, cantad salmos a su nombre: exaltad al que sube sobre los cielos en JAH su nombre, y alegraos delante de él.", "words": [[0, 29274], [7, 29841], [9, 29961], [15, 30721], [22, 31181], [29, 31801], [31, 32001], [34, 32161], [42, 33043], [50, 33929], [53, 34129], [57, 34289], [62, 34709], [68, 34969], [72, 35209], [79, 35689], [82, 35909], [86, 36129], [89, 36349], [97, 36789], [99, 37449], [108, 38109], [116, 38729], [119, 38929]]}, {"verse": 5, "start": 39764, "end": 46178, "text": "Padre de huérfanos y defensor de viudas, es Dios en la morada de su santuario:", "words": [[0, 39764], [6, 40189], [9, 40329], [19, 41109], [21, 41249], [30, 41849], [33, 42049], [41, 42669], [44, 43369], [49, 43869], [52, 44269], [55, 44409], [62, 44849], [65, 45029], [68, 45189]]}, {"verse": 6, "start": 46628, "end": 55798, "text": "El Dios que hace habitar en familia los solos; que saca a los aprisionados con grillos: mas los rebeldes habitan en sequedad.", "words": [[0, 46628], [3, 46908], [8, 47208], [12, 47468], [17, 47818], [25, 48168], [28, 48408], [36, 48848], [40, 49068], [47, 50071], [51, 50152], [56, 50652], [58, 50692], [62, 50832], [75, 51592], [79, 51812], [88, 52879], [92, 53286], [96, 53666], [105, 54366], [113, 54926], [116, 55388]]}, {"verse": 7, "start": 56248, "end": 62088, "text": "Oh Dios, cuando tú saliste delante de tu pueblo, cuando anduviste por el desierto, (Selah,)", "words": [[0, 56298], [3, 56378], [9, 56618], [16, 56958], [19, 57378], [27, 57998], [35, 58518], [38, 58698], [41, 58818], [49, 59318], [56, 59518], [66, 60078], [70, 60318], [73, 60438], [83, 61292]]}, {"verse": 8, "start": 62538, "end": 72490, "text": "La tierra tembló; también destilaron los cielos a la presencia de Dios: aquel Sinaí tembló delante de Dios, del Dios de Israel.", "words": [[0, 62538], [3, 62664], [10, 62944], [18, 64084], [26, 64548], [37, 65308], [41, 65448], [48, 66048], [50, 66248], [53, 66348], [63, 67048], [66, 67248], [72, 68088], [78, 68475], [84, 69075], [91, 69695], [99, 70195], [102, 70375], [108, 71055], [112, 71315], [117, 71595], [120, 71775]]}, {"verse": 9, "start": 72940, "end": 80503, "text": "Abundante lluvia esparciste, oh Dios, a tu heredad; y cuando se cansó, tú la recreaste.", "words": [[0, 72940], [10, 73528], [17, 74028], [29, 74578], [32, 75128], [38, 75388], [40, 75867], [43, 76028], [52, 77012], [54, 77118], [61, 77338], [64, 77558], [71, 78718], [74, 79118], [77, 79438]]}, {"verse": 10, "start": 80953, "end": 86877, "text": "Los que son de tu grey han morado en ella: por tu bondad, oh Dios, has provisto al pobre.", "words": [[0, 80989], [4, 81059], [8, 81199], [12, 81439], [15, 81599], [18, 81759], [23, 82259], [27, 82499], [34, 83019], [37, 83199], [43, 83984], [47, 84128], [50, 84288], [58, 84638], [61, 84988], [67, 85248], [71, 85608], [80, 86108], [83, 86268]]}, {"verse": 11, "start": 87327, "end": 92804, "text": "El Señor daba palabra: de las que anunciaban las buenas nuevas había grande ejército.", "words": [[0, 87327], [3, 87455], [9, 87755], [14, 88115], [23, 89143], [26, 89307], [30, 89427], [34, 89567], [45, 90207], [49, 90387], [56, 90647], [63, 90967], [69, 91598], [76, 92228]]}, {"verse": 12, "start": 93254, "end": 100023, "text": "Huyeron, huyeron reyes de ejércitos; y las que se quedaban en casa repartían los despojos.", "words": [[0, 93254], [9, 93980], [17, 94407], [23, 94833], [26, 95260], [37, 96800], [39, 96910], [43, 97010], [47, 97150], [50, 97290], [59, 97750], [62, 97870], [67, 98190], [77, 98970], [81, 99523]]}, {"verse": 13, "start": 100473, "end": 109605, "text": "Bien que fuisteis echados entre los tiestos, seréis como las alas de la paloma cubierta de plata, y sus plumas con amarillez de oro.", "words": [[0, 100473], [5, 100697], [9, 100897], [18, 101597], [26, 102157], [32, 102477], [36, 102717], [45, 103517], [52, 103997], [57, 104257], [61, 104497], [66, 104977], [69, 105097], [72, 105197], [79, 105557], [88, 106177], [91, 106297], [98, 106677], [100, 107117], [104, 107297], [111, 108137], [115, 108567], [125, 108997], [128, 109237]]}, {"verse": 14, "start": 110055, "end": 115849, "text": "Cuando esparció el Omnipotente los reyes en ella, se emblanqueció esta como la nieve en Salmón.", "words": [[0, 110055], [7, 110279], [16, 110879], [19, 111059], [31, 111759], [35, 111939], [41, 112392], [44, 112846], [50, 113299], [53, 113719], [66, 114139], [71, 114319], [76, 114599], [79, 114739], [85, 115059], [88, 115179]]}, {"verse": 15, "start": 116299, "end": 120843, "text": "Monte de Dios es el monte de Basán; monte alto el de Basán.", "words": [[0, 116299], [6, 116585], [9, 116805], [14, 117085], [17, 117425], [20, 117585], [26, 117865], [29, 118045], [36, 118997], [42, 119437], [47, 119957], [50, 120037], [53, 120157]]}, {"verse": 16, "start": 121293, "end": 130708, "text": "¿Por qué os levantáis, oh montes altos? Este monte amó Dios para su asiento; ciertamente Jehová habitará en él para siempre.", "words": [[0, 121293], [5, 121435], [9, 121615], [12, 121715], [23, 122415], [26, 123115], [33, 123635], [40, 124653], [45, 124859], [51, 125199], [55, 125579], [60, 125759], [65, 126099], [68, 126259], [77, 127238], [89, 128044], [96, 128564], [105, 129224], [108, 129464], [111, 129644], [116, 129924]]}, {"verse": 17, "start": 131158, "end": 141119, "text": "Los carros de Dios son veinte mil, y más millares de ángeles. El Señor entre ellos, como en Sinaí, así en el santuario.", "words": [[0, 131158], [4, 131433], [11, 131743], [14, 131863], [19, 132123], [23, 132750], [30, 133376], [35, 134003], [37, 134203], [41, 134383], [50, 134943], [53, 135163], [62, 136273], [65, 136432], [71, 136712], [77, 137072], [84, 137572], [89, 138172], [92, 138432], [99, 139412], [103, 139652], [106, 139992], [109, 140132]]}, {"verse": 18, "start": 141569, "end": 151728, "text": "Subiste a lo alto, cautivaste la cautividad, tomaste dones para los hombres, y también para los rebeldes, para que habite entre ellos JAH Dios.", "words": [[0, 141569], [8, 142170], [10, 142350], [13, 142470], [19, 143330], [30, 144190], [33, 144350], [45, 145170], [53, 145990], [59, 146470], [64, 146670], [68, 146870], [77, 147310], [79, 147810], [87, 148110], [92, 148350], [96, 148570], [106, 149430], [111, 149610], [115, 149770], [122, 150070], [128, 150310], [134, 150783], [138, 151256]]}, {"verse": 19, "start": 152178, "end": 161512, "text": "Bendito el Señor; cada día nos colma de beneficios el Dios de nuestra salvación. (Selah.)", "words": [[0, 152178], [8, 152686], [11, 152826], [18, 153690], [23, 153874], [27, 154154], [31, 154334], [37, 154834], [40, 154994], [51, 155734], [54, 155934], [59, 156174], [62, 156374], [70, 156554], [81, 160234]]}, {"verse": 20, "start": 161962, "end": 165256, "text": "Dios, nuestro Dios ha de salvarnos; y de Dios Jehová es el librar de la muerte.", "words": [[0, 162364], [6, 162510], [14, 162656], [19, 162801], [22, 162947], [25, 163093], [36, 163481], [38, 163481], [41, 163481], [46, 163481], [53, 163481], [56, 163664], [59, 163844], [66, 164344], [69, 164444], [72, 164584]]}, {"verse": 21, "start": 165706, "end": 172354, "text": "Ciertamente Dios herirá la cabeza de sus enemigos, la cabelluda mollera del que camina en sus pecados.", "words": [[0, 165706], [12, 166467], [17, 166747], [24, 167387], [27, 167527], [34, 167887], [37, 168087], [41, 168247], [51, 169207], [54, 169447], [64, 169997], [72, 170547], [76, 170727], [80, 170927], [87, 171387], [90, 171467], [94, 171627]]}, {"verse": 22, "start": 172804, "end": 178342, "text": "El Señor dijo: De Basán haré volver, te haré volver de los profundos del mar:", "words": [[0, 172804], [3, 172950], [9, 173250], [15, 174105], [18, 174165], [24, 174665], [29, 175165], [37, 175665], [40, 175925], [45, 176145], [52, 176425], [55, 176685], [59, 176825], [69, 177405], [73, 177645]]}, {"verse": 23, "start": 178792, "end": 184507, "text": "Porque tu pie se enrojecerá de sangre de tus enemigos, y de ella la lengua de tus perros.", "words": [[0, 178792], [7, 178993], [10, 179173], [14, 179493], [17, 179813], [28, 180473], [31, 180553], [38, 180953], [41, 181173], [45, 181293], [55, 181893], [57, 182333], [60, 182453], [65, 182753], [68, 182953], [75, 183313], [78, 183393], [82, 183573]]}, {"verse": 24, "start": 184857, "end": 191086, "text": "Vieron tus caminos, oh Dios; los caminos de mi Dios, de mi Rey, en el santuario.", "words": [[0, 184857], [7, 185243], [11, 185443], [20, 186143], [23, 186403], [29, 187358], [33, 187462], [41, 187922], [44, 188102], [47, 188202], [53, 189182], [56, 189242], [59, 189382], [64, 189982], [67, 190122], [70, 190262]]}, {"verse": 25, "start": 191536, "end": 198574, "text": "Los cantores iban delante, los músicos detrás; en medio, las doncellas con panderos.", "words": [[0, 191536], [4, 191796], [13, 192456], [18, 192976], [27, 194056], [31, 194156], [39, 194676], [47, 195833], [50, 195959], [57, 196379], [61, 196859], [71, 197499], [75, 197679]]}, {"verse": 26, "start": 199024, "end": 206004, "text": "Bendecid a Dios en congregaciones: al Señor, vosotros de la estirpe de Israel.", "words": [[0, 199424], [9, 199824], [11, 200044], [16, 200264], [19, 200564], [35, 202210], [38, 202457], [45, 202797], [54, 203577], [57, 204437], [60, 204557], [68, 205037], [71, 205157]]}, {"verse": 27, "start": 206454, "end": 216176, "text": "Allí estaba el joven Benjamín gobernante de ellos, los príncipes de Judá en su congregación, los príncipes de Zabulón, los príncipes de Neftalí.", "words": [[0, 206454], [5, 206894], [12, 207194], [15, 207414], [21, 207854], [30, 208494], [41, 209174], [44, 209334], [51, 209994], [55, 210234], [65, 210874], [68, 210974], [73, 211314], [76, 211454], [79, 211614], [93, 212894], [97, 212974], [107, 213534], [110, 214094], [119, 214654], [123, 214734], [133, 215334], [136, 215454]]}, {"verse": 28, "start": 216626, "end": 223055, "text": "Tu Dios ha ordenado tu fuerza; confirma, oh Dios, lo que has hecho en nosotros.", "words": [[0, 216626], [3, 216728], [8, 217048], [11, 217408], [20, 217928], [23, 218088], [31, 219124], [41, 219558], [44, 220028], [50, 220448], [53, 221108], [57, 221268], [61, 221448], [67, 221728], [70, 221908]]}, {"verse": 29, "start": 223505, "end": 228433, "text": "Por razón de tu templo en Jerusalén los reyes te ofrecerán dones.", "words": [[0, 223505], [4, 223647], [10, 224027], [13, 224327], [16, 224487], [23, 225027], [26, 225107], [36, 226327], [40, 226427], [46, 226867], [49, 227047], [59, 227727]]}, {"verse": 30, "start": 228883, "end": 242890, "text": "Reprime la reunión de gentes armadas, la multitud de toros con los becerros de los pueblos, hasta que todos se sometan con sus piezas de plata: disipa los pueblos que se complacen en la guerra.", "words": [[0, 228883], [8, 229548], [11, 229728], [19, 230308], [22, 230468], [29, 230928], [38, 232168], [41, 232308], [50, 232828], [53, 232988], [59, 233368], [63, 233548], [67, 233948], [76, 234348], [79, 234448], [83, 234588], [92, 235248], [98, 235668], [102, 235928], [108, 236248], [111, 236568], [119, 237148], [123, 237348], [127, 237548], [134, 238088], [137, 238208], [144, 239366], [151, 239666], [155, 239766], [163, 240186], [167, 240286], [170, 240406], [180, 241006], [183, 241126], [186, 241266]]}, {"verse": 31, "start": 243340, "end": 248043, "text": "Vendrán príncipes de Egipto; Etiopía apresurará sus manos a Dios.", "words": [[0, 243340], [8, 243340], [18, 243944], [21, 244144], [29, 245696], [37, 246262], [48, 246829], [52, 246969], [58, 247269], [60, 247529]]}, {"verse": 32, "start": 248493, "end": 253325, "text": "Reinos de la tierra, cantad a Dios, cantad al Señor (Selah);", "words": [[0, 248707], [7, 248957], [10, 249057], [13, 249157], [21, 249624], [28, 250090], [30, 250557], [36, 251010], [43, 251464], [46, 251917], [52, 252624]]}, {"verse": 33, "start": 253775, "end": 261031, "text": "Al que cabalga sobre los cielos de los cielos que son de antiguo: he aquí a su voz dará voz de fortaleza.", "words": [[0, 253847], [3, 253957], [7, 254117], [15, 254717], [21, 255017], [25, 255257], [32, 255917], [35, 255977], [39, 256117], [46, 256717], [50, 256797], [54, 256997], [57, 257197], [66, 258346], [69, 258436], [74, 258656], [76, 258856], [79, 258996], [83, 259296], [88, 259716], [92, 259916], [95, 260116]]}, {"verse": 34, "start": 261481, "end": 269060, "text": "Atribuid fortaleza a Dios: sobre Israel es su magnificencia, y su poder está en los cielos.", "words": [[0, 261773], [9, 262103], [19, 262634], [21, 263165], [27, 263971], [33, 264333], [40, 265133], [43, 265553], [46, 265773], [61, 266953], [63, 267173], [66, 267393], [72, 267753], [77, 268053], [80, 268213], [84, 268333]]}, {"verse": 35, "start": 269510, "end": 278593, "text": "Temible eres, oh Dios, desde tus santuarios: el Dios de Israel, él da fortaleza y vigor a su pueblo. Bendito Dios.", "words": [[0, 269510], [8, 269995], [14, 270375], [17, 270755], [23, 271135], [29, 271455], [33, 271715], [45, 272889], [48, 273207], [53, 273427], [56, 273587], [64, 274347], [67, 274487], [70, 274667], [80, 275507], [82, 275687], [88, 275947], [90, 276187], [93, 276327], [101, 277278], [109, 277964]]}]}