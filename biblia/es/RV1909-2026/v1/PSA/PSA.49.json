{"book": "PSA", "chapter": 49, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 129476, "verses": [{"verse": 1, "start": 300, "end": 9299, "text": "Al Músico principal: Salmo para los hijos de Coré. Oíd esto, pueblos todos; escuchad, habitantes todos del mundo:", "words": [[0, 300], [3, 492], [10, 972], [21, 1996], [27, 2558], [32, 3038], [36, 3238], [42, 3558], [45, 3908], [51, 4425], [55, 4787], [61, 5177], [69, 5757], [76, 6602], [86, 7284], [97, 8084], [103, 8424], [107, 8724]]}, {"verse": 2, "start": 9649, "end": 14142, "text": "Así los plebeyos como los nobles, el rico y el pobre juntamente.", "words": [[0, 9649], [4, 9821], [8, 10241], [17, 10661], [22, 10901], [26, 11081], [34, 11941], [37, 12041], [42, 12421], [44, 12721], [47, 12861], [53, 13141]]}, {"verse": 3, "start": 14492, "end": 19805, "text": "Mi boca hablará sabiduría; y el pensamiento de mi corazón inteligencia.", "words": [[0, 14492], [3, 14597], [8, 14877], [16, 15537], [27, 16681], [29, 16786], [32, 16906], [44, 17726], [47, 17926], [50, 18066], [58, 18466]]}, {"verse": 4, "start": 20155, "end": 25314, "text": "Inclinaré mi oído a proverbios: declararé con el arpa mi enigma.", "words": [[0, 20155], [10, 20939], [13, 21179], [18, 21539], [20, 21699], [32, 22939], [42, 23704], [46, 23924], [49, 24104], [54, 24464], [57, 24684]]}, {"verse": 5, "start": 25664, "end": 31083, "text": "¿Por qué he de temer en los días de adversidad, cuando la iniquidad de mis opresores me rodee?", "words": [[0, 25664], [5, 25791], [9, 25991], [12, 26191], [15, 26391], [21, 26591], [24, 26791], [28, 26891], [33, 27111], [36, 27311], [48, 27991], [55, 28246], [58, 28506], [68, 29266], [71, 29446], [75, 29586], [85, 30226], [88, 30446]]}, {"verse": 6, "start": 31433, "end": 36082, "text": "Los que confían en sus bienes, y en la muchedumbre de sus riquezas se jactan,", "words": [[0, 31433], [4, 31714], [8, 32044], [16, 32374], [19, 32454], [23, 32614], [31, 33294], [33, 33434], [36, 33534], [39, 33634], [51, 34294], [54, 34434], [58, 34614], [67, 35234], [70, 35686]]}, {"verse": 7, "start": 36432, "end": 42461, "text": "Ninguno de ellos podrá en manera alguna redimir al hermano, ni dar a Dios su rescate.", "words": [[0, 36432], [8, 37061], [11, 37181], [17, 37481], [23, 38021], [26, 38081], [33, 38401], [40, 39071], [48, 39741], [51, 39841], [60, 40274], [63, 40708], [67, 41141], [69, 41241], [74, 41441], [77, 41701]]}, {"verse": 8, "start": 42811, "end": 46851, "text": "(Porque la redención de su vida es de gran precio, y no se hará jamás;)", "words": [[0, 42811], [8, 42971], [11, 43191], [21, 43851], [24, 44051], [27, 44211], [32, 44491], [35, 44591], [38, 44711], [43, 44911], [51, 45471], [53, 45711], [56, 45871], [59, 46031], [64, 46271]]}, {"verse": 9, "start": 47201, "end": 50835, "text": "Que viva adelante para siempre, y nunca vea la sepultura.", "words": [[0, 47201], [4, 47285], [9, 47605], [18, 48165], [23, 48485], [32, 48965], [34, 49230], [40, 49410], [44, 49910], [47, 50409]]}, {"verse": 10, "start": 51185, "end": 59362, "text": "Pues se ve que mueren los sabios, así como el insensato y el necio perecen, y dejan a otros sus riquezas.", "words": [[0, 51185], [5, 51326], [8, 51466], [11, 51566], [15, 51806], [22, 52046], [26, 52166], [34, 52846], [38, 53286], [43, 53566], [46, 53706], [56, 54706], [58, 54886], [61, 55006], [67, 55446], [76, 56126], [78, 56806], [84, 57266], [86, 57546], [92, 57906], [96, 58486]]}, {"verse": 11, "start": 59712, "end": 69170, "text": "En su interior tienen que sus casas serán eternas, y sus habitaciones para generación y generación: llamaron sus tierras de sus nombres.", "words": [[0, 59712], [3, 59857], [6, 60017], [15, 60517], [22, 60877], [26, 61137], [30, 61317], [36, 61837], [42, 62137], [51, 62997], [53, 63437], [57, 63597], [70, 64317], [75, 64597], [86, 65397], [88, 65537], [100, 66882], [109, 67257], [113, 67497], [121, 68077], [124, 68237], [128, 68377]]}, {"verse": 12, "start": 69520, "end": 75455, "text": "Mas el hombre no permanecerá en honra: es semejante a las bestias que perecen.", "words": [[0, 69520], [4, 70176], [7, 70256], [14, 70496], [17, 70936], [29, 71916], [32, 72350], [39, 72948], [42, 73229], [52, 73869], [54, 73989], [58, 74289], [66, 74589], [70, 74729]]}, {"verse": 13, "start": 75805, "end": 83122, "text": "Este su camino es su locura: con todo, corren sus descendientes por el dicho de ellos. (Selah.)", "words": [[0, 75805], [5, 76092], [8, 76292], [15, 76672], [18, 77092], [21, 77292], [29, 79009], [33, 79009], [39, 79009], [46, 79474], [50, 79734], [64, 80834], [68, 81154], [71, 81294], [77, 81594], [80, 81794], [87, 82886]]}, {"verse": 14, "start": 83472, "end": 96330, "text": "Como rebaños serán puestos en la sepultura; la muerte se cebará en ellos; y por la mañana los justos prevalecerán sobre ellos: y se consumirá su hermosura en el sepulcro de su morada.", "words": [[0, 83472], [5, 83997], [13, 84557], [19, 84957], [27, 85477], [30, 85617], [33, 85757], [44, 86855], [47, 87004], [54, 87324], [57, 87764], [64, 88204], [67, 88364], [74, 89212], [76, 89300], [80, 89480], [83, 89620], [90, 89940], [94, 90200], [101, 90700], [114, 91500], [120, 91800], [127, 92666], [129, 92788], [132, 92888], [142, 93588], [145, 93748], [155, 94388], [158, 94528], [161, 94668], [170, 95328], [173, 95488], [176, 95608]]}, {"verse": 15, "start": 96680, "end": 101792, "text": "Pero Dios redimirá mi vida del poder de la sepultura, cuando me tome. (Selah.)", "words": [[0, 96680], [5, 96866], [10, 97479], [19, 98091], [22, 98251], [27, 98551], [31, 98791], [37, 99131], [40, 99331], [43, 99451], [54, 100071], [61, 100331], [64, 100591], [70, 101555]]}, {"verse": 16, "start": 102142, "end": 105978, "text": "No temas cuando se enriquece alguno, cuando aumenta la gloria de su casa;", "words": [[0, 102142], [3, 102272], [9, 102612], [16, 102772], [19, 103072], [29, 103532], [37, 103972], [44, 104132], [52, 104712], [55, 104812], [62, 105152], [65, 105292], [68, 105412]]}, {"verse": 17, "start": 106328, "end": 110868, "text": "Porque al morir no llevará nada, ni descenderá tras él su gloria.", "words": [[0, 106328], [7, 106554], [10, 106714], [16, 107134], [19, 107354], [27, 107814], [33, 108614], [36, 108814], [47, 109554], [52, 109714], [55, 109994], [58, 110440]]}, {"verse": 18, "start": 111218, "end": 117716, "text": "Si bien mientras viva, dirá dichosa a su alma: y tú serás alabado cuando bien te trates.", "words": [[0, 111218], [3, 111383], [8, 111723], [17, 112383], [23, 112963], [28, 113463], [36, 114003], [38, 114203], [41, 114303], [47, 115157], [49, 115284], [52, 115404], [58, 115824], [66, 116324], [73, 116524], [78, 116824], [81, 117004]]}, {"verse": 19, "start": 118066, "end": 123325, "text": "Entrará a la generación de sus padres: no verán luz para siempre.", "words": [[0, 118066], [8, 118788], [10, 119028], [13, 119128], [24, 119848], [27, 120008], [31, 120148], [39, 121243], [42, 121390], [48, 121750], [52, 121990], [57, 122370]]}, {"verse": 20, "start": 123675, "end": 129076, "text": "El hombre en honra que no entiende, semejante es a las bestias que perecen.", "words": [[0, 123675], [3, 123840], [10, 124160], [13, 124580], [19, 125140], [23, 125440], [26, 125640], [36, 126480], [46, 127200], [49, 127440], [51, 127540], [55, 127680], [63, 128120], [67, 128280]]}]}