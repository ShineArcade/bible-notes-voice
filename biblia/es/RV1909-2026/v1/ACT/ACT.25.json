{"book": "ACT", "chapter": 25, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 243809, "verses": [{"verse": 1, "start": 300, "end": 7416, "text": "Festo pues, entrado en la provincia, tres días después subió de Cesarea a Jerusalén.", "words": [[0, 300], [6, 780], [12, 1360], [20, 1920], [23, 2020], [26, 2160], [37, 3320], [42, 3620], [47, 4020], [55, 4460], [61, 5320], [64, 5580], [72, 6140], [74, 6460]]}, {"verse": 2, "start": 7866, "end": 15479, "text": "Y vinieron a él los principales sacerdotes y los principales de los judíos contra Pablo; y le rogaron,", "words": [[0, 7866], [2, 7990], [11, 8470], [13, 8670], [16, 8930], [20, 9310], [32, 10050], [43, 10890], [45, 11290], [49, 11430], [61, 12110], [64, 12250], [68, 12370], [75, 12930], [82, 13290], [89, 14397], [91, 14538], [94, 15026]]}, {"verse": 3, "start": 15929, "end": 23862, "text": "Pidiendo como favor contra él, que le hiciese traer a Jerusalén, poniendo ellos emboscadas para matarle en el camino.", "words": [[0, 15929], [9, 16412], [14, 16652], [20, 17012], [27, 17432], [31, 18152], [35, 18392], [38, 18532], [46, 19012], [52, 19512], [54, 19572], [65, 20732], [74, 21212], [80, 21432], [91, 22272], [96, 22512], [104, 23052], [107, 23192], [110, 23292]]}, {"verse": 4, "start": 24312, "end": 31245, "text": "Pero Festo respondió, que Pablo estaba guardado en Cesarea, y que él mismo partiría en breve.", "words": [[0, 24312], [5, 24498], [11, 25118], [22, 26098], [26, 26237], [32, 26618], [39, 26898], [48, 27537], [51, 27697], [60, 28237], [62, 28877], [66, 29037], [69, 29357], [75, 29718], [84, 30578], [87, 30718]]}, {"verse": 5, "start": 31545, "end": 38848, "text": "Los que de vosotros pueden, dijo, desciendan juntamente; y si hay algún crimen en este hombre, acúsenle.", "words": [[0, 31545], [4, 31686], [8, 31866], [11, 31946], [20, 32386], [28, 33398], [34, 34223], [45, 34868], [57, 36075], [59, 36224], [62, 36304], [66, 36464], [72, 36724], [79, 37124], [82, 37224], [87, 37464], [95, 37784]]}, {"verse": 6, "start": 39198, "end": 49244, "text": "Y permaneciendo entre ellos no más de ocho o diez días, venido a Cesarea, el siguiente día se sentó en el tribunal, y mandó que Pablo fuese traído.", "words": [[0, 39198], [2, 39322], [16, 40202], [22, 40482], [28, 40842], [31, 41082], [35, 41282], [38, 41462], [43, 41882], [45, 42002], [50, 42262], [56, 43122], [63, 43462], [65, 43602], [74, 44502], [77, 44622], [87, 44902], [91, 45342], [94, 45522], [100, 45942], [103, 46042], [106, 46162], [116, 46782], [118, 47202], [124, 47542], [128, 47642], [134, 48082], [140, 48442]]}, {"verse": 7, "start": 49694, "end": 59790, "text": "El cual venido, le rodearon los judíos que habían venido de Jerusalén, poniendo contra Pablo muchas y graves acusaciones, las cuales no podían probar;", "words": [[0, 49694], [3, 49856], [8, 50096], [16, 50616], [19, 50796], [28, 51396], [32, 51596], [39, 52096], [43, 52236], [50, 52496], [57, 52936], [60, 53096], [71, 53816], [80, 54496], [87, 54836], [93, 55316], [100, 55896], [102, 56316], [109, 56596], [122, 57936], [126, 58056], [133, 58316], [136, 58816], [143, 59196]]}, {"verse": 8, "start": 60240, "end": 68114, "text": "Alegando él por su parte: Ni contra la ley de los judíos, ni contra el templo, ni contra César he pecado en nada.", "words": [[0, 60492], [9, 60782], [12, 60982], [16, 61162], [19, 61342], [26, 62259], [29, 62381], [36, 62761], [39, 62941], [43, 63161], [46, 63281], [50, 63401], [58, 64241], [61, 64481], [68, 64841], [71, 64981], [79, 65781], [82, 65841], [89, 66201], [95, 66961], [98, 67061], [105, 67481], [108, 67661]]}, {"verse": 9, "start": 68464, "end": 78992, "text": "Pero Festo, queriendo congraciarse con los judíos, respondiendo a Pablo, dijo: ¿Quieres subir a Jerusalén, y allá ser juzgado de estas cosas delante de mí?", "words": [[0, 68809], [5, 69189], [12, 69569], [22, 69989], [35, 70969], [39, 71169], [43, 71329], [51, 72209], [64, 73029], [66, 73189], [73, 73689], [79, 74480], [88, 74735], [94, 74915], [96, 75055], [107, 75775], [109, 76275], [114, 76455], [118, 76675], [126, 77195], [129, 77415], [135, 77615], [141, 78035], [149, 78555], [152, 78695]]}, {"verse": 10, "start": 79342, "end": 88756, "text": "Y Pablo dijo: Ante el tribunal de César estoy, donde conviene que sea juzgado. A los judíos no he hecho ningún agravio, como tú sabes muy bien.", "words": [[0, 79342], [2, 79487], [8, 79827], [14, 80624], [19, 80839], [22, 80919], [31, 81339], [34, 81499], [40, 81959], [47, 82859], [53, 82999], [62, 83559], [66, 83699], [70, 83919], [79, 84972], [81, 85058], [85, 85178], [92, 85658], [95, 85818], [98, 85998], [104, 86198], [111, 86478], [120, 87418], [125, 87578], [128, 87778], [134, 88078], [138, 88318]]}, {"verse": 11, "start": 89206, "end": 100619, "text": "Porque si algún agravio, o cosa alguna digna de muerte he hecho, no rehuso morir; pero si nada hay de las cosas de que estos me acusan, nadie puede darme a ellos. A César apelo.", "words": [[0, 89206], [7, 89396], [10, 89636], [16, 89936], [25, 90576], [27, 90836], [32, 91116], [39, 91476], [45, 91936], [48, 92036], [55, 92186], [58, 92336], [65, 93216], [68, 93546], [75, 93876], [82, 94677], [87, 94819], [90, 94999], [95, 95239], [99, 95519], [102, 95639], [106, 95779], [112, 96139], [115, 96399], [119, 96539], [125, 96779], [128, 97039], [136, 97779], [142, 98099], [148, 98359], [154, 98819], [156, 98919], [163, 99919], [165, 100169], [171, 100419]]}, {"verse": 12, "start": 100968, "end": 108213, "text": "Entonces Festo, habiendo hablado con el consejo, respondió: ¿A César has apelado? a César irás.", "words": [[0, 100968], [9, 102217], [16, 102737], [25, 103097], [33, 103577], [37, 103757], [40, 103897], [49, 104577], [60, 105736], [63, 106016], [69, 106296], [73, 106576], [82, 107364], [84, 107659], [90, 107954]]}, {"verse": 13, "start": 108563, "end": 114842, "text": "Y pasados algunos días, el rey Agripa y Bernice vinieron a Cesarea a saludar a Festo.", "words": [[0, 108563], [2, 108706], [10, 109126], [18, 109486], [24, 109806], [27, 110086], [31, 110666], [38, 111246], [40, 111366], [48, 111946], [57, 112646], [59, 112886], [67, 113566], [69, 113666], [77, 114206], [79, 114266]]}, {"verse": 14, "start": 115292, "end": 123523, "text": "Y como estuvieron allí muchos días, Festo declaró la causa de Pablo al rey, diciendo: Un hombre ha sido dejado preso por Félix,", "words": [[0, 115292], [2, 115378], [7, 115558], [18, 116098], [23, 116278], [30, 116518], [36, 117338], [42, 117878], [50, 118478], [53, 118598], [59, 118938], [62, 119198], [68, 119478], [71, 119678], [76, 120298], [86, 121326], [89, 121431], [96, 121671], [99, 121831], [104, 121991], [111, 122391], [117, 122791], [121, 122951]]}, {"verse": 15, "start": 123973, "end": 132485, "text": "Sobre el cual, cuando fui a Jerusalén, vinieron a mí los principales sacerdotes y los ancianos de los judíos, pidiendo condenación contra él:", "words": [[0, 123973], [6, 124235], [9, 124395], [15, 124855], [22, 125095], [26, 125335], [28, 125435], [39, 126455], [48, 126795], [50, 126895], [53, 127035], [57, 127195], [69, 127935], [80, 128695], [82, 128895], [86, 129055], [95, 129515], [98, 129655], [102, 129775], [110, 130595], [119, 131135], [131, 131755], [138, 132115]]}, {"verse": 16, "start": 132935, "end": 144155, "text": "A los cuales respondí, no ser costumbre de los Romanos dar alguno a la muerte antes que el que es acusado tenga presentes sus acusadores, y haya lugar de defenderse de la acusación.", "words": [[0, 132935], [2, 133031], [6, 133131], [13, 133391], [23, 134591], [26, 134771], [30, 134951], [40, 135511], [43, 135631], [47, 135751], [55, 136251], [59, 136411], [66, 136891], [68, 136931], [71, 136991], [78, 137791], [84, 138111], [88, 138331], [91, 138411], [95, 138511], [98, 138631], [106, 139071], [112, 139441], [122, 139811], [126, 140031], [138, 141230], [140, 141321], [145, 141451], [151, 141711], [154, 141951], [165, 142531], [168, 142651], [171, 142751]]}, {"verse": 17, "start": 144605, "end": 151776, "text": "Así que, habiendo venido ellos juntos acá, sin ninguna demora, al día siguiente, sentado en el tribunal, mandé traer al hombre;", "words": [[0, 144605], [4, 144826], [9, 145106], [18, 145366], [25, 145766], [31, 145986], [38, 146326], [43, 147126], [47, 147246], [55, 147646], [63, 148126], [66, 148406], [70, 148546], [81, 148886], [89, 149646], [92, 149766], [95, 149846], [105, 150566], [111, 150946], [117, 151246], [120, 151386]]}, {"verse": 18, "start": 152226, "end": 158292, "text": "Y estando presentes los acusadores, ningún cargo produjeron de los que yo sospechaba:", "words": [[0, 152226], [2, 152322], [10, 152682], [20, 153242], [24, 153342], [36, 154462], [43, 154702], [49, 155142], [60, 155822], [63, 155942], [67, 156062], [71, 156222], [74, 156362]]}, {"verse": 19, "start": 158742, "end": 168117, "text": "Solamente tenían contra él ciertas cuestiones acerca de su superstición, y de un cierto Jesús, difunto, el cual Pablo afirmaba que estaba vivo.", "words": [[0, 158742], [10, 159307], [17, 159707], [24, 160087], [27, 160347], [35, 160867], [46, 161427], [53, 161767], [56, 162047], [59, 162187], [73, 163467], [75, 163707], [78, 163827], [81, 163987], [88, 164247], [95, 165207], [104, 166207], [107, 166307], [112, 166467], [118, 166827], [127, 167307], [131, 167427], [138, 167707]]}, {"verse": 20, "start": 168567, "end": 175482, "text": "Y yo, dudando en cuestión semejante, dije, si quería ir a Jerusalén, y allá ser juzgado de estas cosas.", "words": [[0, 168567], [2, 168712], [6, 168872], [14, 169332], [17, 169512], [26, 169812], [37, 170732], [43, 171372], [46, 171572], [53, 171912], [56, 172132], [58, 172232], [69, 172952], [71, 173292], [76, 173472], [80, 173732], [88, 174292], [91, 174492], [97, 174692]]}, {"verse": 21, "start": 175932, "end": 183384, "text": "Pero apelando Pablo a quedar bajo custodia para la decisión del emperador, mandé que le guardasen hasta que le enviara a César.", "words": [[0, 175932], [5, 176064], [14, 176584], [20, 176964], [22, 177164], [29, 177364], [34, 177684], [43, 178324], [48, 178584], [51, 178724], [60, 179284], [64, 179404], [75, 180364], [81, 180784], [85, 180884], [88, 181264], [98, 181644], [104, 181944], [108, 182144], [111, 182284], [119, 182704], [121, 182864]]}, {"verse": 22, "start": 183734, "end": 191482, "text": "Entonces Agripa dijo a Festo: Yo también quisiera oír a ese hombre. Y él dijo: Mañana le oirás.", "words": [[0, 183734], [9, 184420], [16, 185340], [21, 185880], [23, 186100], [30, 186904], [33, 187067], [41, 187307], [50, 187827], [54, 188127], [56, 188207], [60, 188367], [68, 189186], [70, 189374], [73, 189534], [79, 190303], [86, 190689], [89, 190909]]}, {"verse": 23, "start": 191832, "end": 204466, "text": "Y al otro día, viniendo Agripa y Bernice con gran pompa, y entrando en la audiencia con los comandantes y principales hombres de la ciudad, por mandato de Festo, fue traído Pablo.", "words": [[0, 191832], [2, 191974], [5, 192074], [10, 192314], [15, 193274], [24, 193884], [31, 194494], [33, 194844], [41, 195194], [45, 195474], [50, 195714], [57, 196394], [59, 196554], [68, 197214], [71, 197354], [74, 197514], [84, 198154], [88, 198374], [92, 198534], [104, 199234], [106, 199394], [118, 200034], [126, 200354], [129, 200574], [132, 200674], [140, 201014], [144, 201654], [152, 202114], [155, 202294], [162, 203195], [166, 203345], [173, 203765]]}, {"verse": 24, "start": 204916, "end": 219915, "text": "Entonces Festo dijo: Rey Agripa, y todos los varones que estáis aquí juntos con nosotros: veis a este, por el cual toda la multitud de los judíos me ha pedido en Jerusalén y aquí, dando voces que no conviene que viva más;", "words": [[0, 204916], [9, 205923], [15, 206403], [21, 207265], [25, 207685], [33, 208145], [35, 208345], [41, 208525], [45, 208765], [53, 209165], [57, 209345], [64, 209685], [69, 209865], [76, 210205], [80, 210565], [90, 211636], [95, 211934], [97, 212054], [103, 212374], [107, 212614], [110, 212754], [115, 212974], [120, 213294], [123, 213554], [132, 214094], [135, 214254], [139, 214374], [146, 214854], [149, 215014], [152, 215114], [159, 215514], [162, 215634], [172, 216654], [174, 216714], [180, 217434], [186, 217694], [192, 218154], [196, 218354], [199, 218514], [208, 218994], [212, 219154], [217, 219434]]}, {"verse": 25, "start": 220365, "end": 226962, "text": "Pero yo, hallando que ninguna cosa digna de muerte ha hecho, y él mismo apelando al emperador, he determinado enviarle:", "words": [[0, 220365], [5, 220522], [9, 220702], [18, 221082], [22, 221242], [30, 221542], [35, 221962], [41, 222382], [44, 222462], [51, 222742], [54, 223002], [61, 223682], [63, 223762], [66, 223882], [72, 224142], [81, 224742], [84, 224842], [95, 225422], [98, 225642], [110, 226262]]}, {"verse": 26, "start": 227412, "end": 238224, "text": "Del cual no tengo cosa cierta que escriba al señor; por lo que le he sacado a vosotros, y mayormente a ti, oh rey Agripa, para que realizada la investigación, tenga yo qué escribir.", "words": [[0, 227412], [4, 227582], [9, 227802], [12, 228022], [18, 228282], [23, 228582], [30, 229122], [34, 229315], [42, 229509], [45, 229702], [52, 230500], [56, 230648], [59, 230768], [63, 230888], [66, 231048], [69, 231188], [76, 231588], [78, 231668], [88, 232208], [90, 232468], [101, 233048], [103, 233228], [107, 233458], [110, 233688], [114, 233948], [122, 234388], [127, 234948], [131, 235108], [141, 235688], [144, 235848], [159, 236548], [165, 237208], [168, 237448], [172, 237588]]}, {"verse": 27, "start": 238674, "end": 243409, "text": "Porque fuera de razón me parece enviar un preso, y no informar de las causas.", "words": [[0, 238674], [7, 238882], [13, 239162], [16, 239382], [22, 239782], [25, 240002], [32, 240362], [39, 240842], [42, 240962], [49, 241682], [51, 241842], [54, 241942], [63, 242502], [66, 242582], [70, 242742]]}]}