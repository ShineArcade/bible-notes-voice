{"book": "GEN", "chapter": 50, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 257031, "verses": [{"verse": 1, "start": 300, "end": 7328, "text": "Entonces se echó José sobre el rostro de su padre, y lloró sobre él, y lo besó.", "words": [[0, 300], [9, 1384], [12, 1724], [17, 2144], [22, 2484], [28, 2924], [31, 3144], [38, 3584], [41, 3704], [44, 3884], [51, 4284], [53, 4924], [59, 5304], [65, 5584], [69, 5984], [71, 6384], [74, 6784]]}, {"verse": 2, "start": 7778, "end": 16343, "text": "Y mandó José a sus siervos los médicos que embalsamasen a su padre: y los médicos embalsamaron a Israel.", "words": [[0, 7778], [2, 8048], [8, 8343], [13, 8638], [15, 8933], [19, 9173], [27, 9773], [31, 10173], [39, 10893], [43, 11553], [56, 12213], [58, 12293], [61, 12413], [68, 13370], [70, 13481], [74, 13601], [82, 14471], [95, 15341], [97, 15641]]}, {"verse": 3, "start": 16792, "end": 24569, "text": "Y le cumplieron cuarenta días, porque así cumplían los días de los embalsamados, y lo lloraron los egipcios setenta días.", "words": [[0, 16792], [2, 16882], [5, 16962], [16, 17412], [25, 17862], [31, 18422], [38, 18902], [42, 19142], [51, 19722], [55, 19902], [60, 20102], [63, 20282], [67, 20382], [81, 21262], [83, 21782], [86, 21922], [95, 22442], [99, 22622], [108, 23142], [116, 23662]]}, {"verse": 4, "start": 25019, "end": 36578, "text": "Y pasados los días de su luto, habló José a los de la casa de Faraón, diciendo: Si he hallado ahora gracia en vuestros ojos, os ruego que habléis en oídos de Faraón, diciendo:", "words": [[0, 25019], [2, 25124], [10, 25644], [14, 25844], [19, 26104], [22, 26264], [25, 26384], [31, 27014], [37, 27644], [42, 27984], [44, 28204], [48, 28324], [51, 28444], [54, 28544], [59, 28744], [62, 29154], [70, 29564], [80, 31028], [83, 31204], [86, 31384], [94, 31804], [100, 32104], [107, 32604], [110, 32704], [119, 33044], [125, 33844], [128, 33944], [134, 34264], [138, 34444], [146, 34844], [149, 34984], [155, 35344], [158, 35424], [166, 35984]]}, {"verse": 5, "start": 37028, "end": 49839, "text": "Mi padre me conjuró diciendo: He aquí yo muero; en mi sepulcro que yo cavé para mí en la tierra de Canaán, allí me sepultarás; ruego pues que vaya yo ahora, y sepultaré a mi padre, y volveré.", "words": [[0, 37028], [3, 37130], [9, 37370], [12, 37710], [20, 38050], [30, 39008], [33, 39088], [38, 39268], [41, 39468], [48, 41298], [51, 41437], [54, 41577], [63, 42077], [67, 42217], [70, 42437], [75, 42657], [80, 42817], [83, 43037], [86, 43197], [89, 43297], [96, 43537], [99, 44017], [107, 44497], [112, 44737], [115, 44837], [127, 46077], [133, 46207], [138, 46547], [142, 46727], [147, 46907], [150, 47147], [157, 47487], [159, 47807], [169, 48127], [171, 48447], [174, 48607], [181, 48927], [183, 49287]]}, {"verse": 6, "start": 50189, "end": 58644, "text": "Y Faraón dijo: Ve, y sepulta a tu padre, como él te conjuró.", "words": [[0, 50189], [2, 50489], [9, 50829], [15, 51645], [19, 51864], [21, 52164], [29, 52744], [31, 52824], [34, 52944], [41, 53744], [46, 53904], [49, 54124], [52, 54204]]}, {"verse": 7, "start": 58994, "end": 70275, "text": "Entonces José subió a sepultar a su padre; y subieron con él todos los siervos de Faraón, los ancianos de su casa, y todos los ancianos de la tierra de Egipto,", "words": [[0, 58994], [9, 59638], [14, 60518], [20, 61158], [22, 61318], [31, 61878], [33, 61938], [36, 62078], [43, 62964], [45, 63067], [54, 63487], [58, 63687], [61, 63847], [67, 64167], [71, 64447], [79, 64907], [82, 65487], [90, 66067], [94, 66127], [103, 66707], [106, 66847], [109, 66987], [115, 67267], [117, 67507], [123, 67767], [127, 68267], [136, 68867], [139, 69007], [142, 69107], [149, 69347], [152, 69587]]}, {"verse": 8, "start": 70725, "end": 80989, "text": "Y toda la casa de José, y sus hermanos, y la casa de su padre: solamente dejaron en la tierra de Gosén sus niños, y sus ovejas y sus vacas.", "words": [[0, 70725], [2, 70848], [7, 71128], [10, 71368], [15, 71648], [18, 71868], [24, 72208], [26, 72528], [30, 72708], [40, 73328], [42, 73448], [45, 73588], [50, 73808], [53, 74008], [56, 74128], [63, 75005], [73, 75430], [81, 76230], [84, 76390], [87, 76550], [94, 76930], [97, 77290], [103, 77650], [107, 77830], [114, 78310], [116, 79030], [120, 79190], [127, 79850], [129, 80130], [133, 80310]]}, {"verse": 9, "start": 81439, "end": 87920, "text": "Y subieron también con él carros y gente de a caballo, y se hizo un escuadrón muy grande.", "words": [[0, 81439], [2, 81563], [11, 81983], [19, 82363], [23, 82613], [26, 82863], [33, 83523], [35, 83863], [41, 84203], [44, 84483], [46, 84763], [55, 85043], [57, 85723], [60, 85843], [65, 86203], [68, 86443], [78, 87023], [82, 87223]]}, {"verse": 10, "start": 88370, "end": 100655, "text": "Y llegaron hasta la era de Atad, que está al otro lado del Jordán, y se lamentaron allí con grande y muy grave lamentación: y José hizo a su padre duelo por siete días.", "words": [[0, 88370], [2, 88493], [11, 88993], [17, 89493], [20, 89753], [24, 89973], [27, 90173], [33, 90953], [37, 91013], [42, 91253], [45, 91593], [50, 91793], [55, 92053], [59, 92333], [67, 92933], [69, 93353], [72, 93473], [83, 94193], [88, 94453], [92, 94733], [99, 95133], [101, 95253], [105, 95433], [111, 95733], [124, 97178], [126, 97418], [131, 97718], [136, 98218], [138, 98378], [141, 98518], [147, 98858], [153, 99358], [157, 99558], [163, 99838]]}, {"verse": 11, "start": 101105, "end": 116762, "text": "Y viendo los moradores de la tierra, los cananeos, el llanto en la era de Atad, dijeron: Llanto grande es este de los egipcios: por eso fue llamado su nombre Abel-mizraim, que está al otro lado del Jordán.", "words": [[0, 101105], [2, 101230], [9, 101510], [13, 101730], [23, 102290], [26, 102470], [29, 102570], [37, 103650], [41, 103750], [51, 104870], [54, 104950], [61, 105850], [64, 105950], [67, 106130], [71, 106310], [74, 106510], [80, 107230], [89, 108208], [96, 108605], [103, 108965], [106, 109405], [111, 109705], [114, 109865], [118, 109985], [128, 111085], [132, 111211], [136, 111431], [140, 111691], [148, 112011], [151, 112311], [158, 113271], [172, 114231], [176, 114691], [181, 114931], [184, 115131], [189, 115331], [194, 115611], [198, 115911]]}, {"verse": 12, "start": 117212, "end": 120881, "text": "Hicieron, pues, sus hijos con él, según les había mandado:", "words": [[0, 117212], [10, 117677], [16, 117917], [20, 118417], [26, 118717], [30, 119037], [34, 119197], [40, 119577], [44, 119837], [50, 120157]]}, {"verse": 13, "start": 121331, "end": 139131, "text": "Pues lo llevaron sus hijos a la tierra de Canaán, y le sepultaron en la cueva del campo de Macpela, la que había comprado Abraham con el mismo campo, para heredad de sepultura, de Efrón el heteo, delante de Mamre.", "words": [[0, 121331], [5, 121472], [8, 121652], [17, 122132], [21, 122372], [27, 122672], [29, 122932], [32, 123012], [39, 123332], [42, 123572], [50, 124272], [52, 124662], [55, 125052], [66, 125932], [69, 126252], [72, 126412], [78, 126792], [82, 126932], [88, 127412], [91, 127652], [100, 128912], [103, 129232], [107, 129372], [113, 129632], [122, 130292], [130, 130992], [134, 131592], [137, 131772], [143, 132092], [150, 133153], [155, 133341], [163, 133941], [166, 134121], [177, 134941], [180, 135641], [186, 136381], [189, 136921], [196, 137461], [204, 138321], [207, 138757]]}, {"verse": 14, "start": 139581, "end": 149720, "text": "Y José regresó a Egipto, él y sus hermanos, y todos los que subieron con él a sepultar a su padre, después que le hubo sepultado.", "words": [[0, 139581], [2, 139725], [7, 140065], [15, 140925], [17, 141065], [25, 142185], [28, 142485], [30, 142945], [34, 143125], [44, 144145], [46, 144245], [52, 144585], [56, 144885], [60, 145025], [69, 145545], [73, 145765], [76, 146005], [78, 146265], [87, 146825], [89, 146905], [92, 147065], [99, 147525], [107, 148125], [111, 148385], [114, 148505], [119, 148785]]}, {"verse": 15, "start": 150170, "end": 159299, "text": "Y viendo los hermanos de José que su padre era muerto, dijeron: Quizá nos aborrecerá José, y nos dará el pago de todo el mal que le hicimos.", "words": [[0, 150170], [2, 150277], [9, 150517], [13, 150697], [22, 151197], [25, 151297], [30, 151577], [34, 151797], [37, 151957], [43, 152237], [47, 152517], [55, 153237], [64, 154231], [70, 154555], [74, 154675], [85, 155415], [91, 155715], [93, 156095], [97, 156235], [102, 156575], [105, 156775], [110, 157275], [113, 157455], [118, 157675], [121, 157915], [125, 158175], [129, 158415], [132, 158535]]}, {"verse": 16, "start": 159749, "end": 165428, "text": "Y enviaron a decir a José: Tu padre mandó antes de su muerte, diciendo:", "words": [[0, 159749], [2, 160005], [11, 160525], [13, 160625], [19, 160905], [21, 161065], [27, 161794], [30, 161877], [36, 162197], [42, 162777], [48, 163157], [51, 163377], [54, 163537], [62, 164517]]}, {"verse": 17, "start": 165878, "end": 182146, "text": "Así diréis a José: Te ruego que perdones ahora la maldad de tus hermanos y su pecado, porque mal te trataron: por tanto ahora te rogamos que perdones la maldad de los siervos del Dios de tu padre. Y José lloró mientras hablaban.", "words": [[0, 165878], [4, 166119], [11, 166559], [13, 166739], [19, 167564], [22, 167827], [28, 168187], [32, 168387], [41, 168947], [47, 169187], [50, 169447], [57, 169887], [60, 170067], [64, 170227], [73, 170827], [75, 170927], [78, 171067], [86, 171547], [93, 172007], [97, 172387], [100, 172627], [110, 173730], [114, 173853], [120, 174773], [126, 175033], [129, 175253], [137, 175873], [141, 176073], [150, 176693], [153, 176913], [160, 177333], [163, 177533], [167, 177673], [175, 178193], [179, 178433], [184, 178673], [187, 178893], [190, 179013], [197, 179850], [199, 180119], [204, 180359], [210, 180919], [219, 181539]]}, {"verse": 18, "start": 182596, "end": 189267, "text": "Y vinieron también sus hermanos, y se postraron delante de él, y dijeron: Aquí nos tienes por tus siervos.", "words": [[0, 182596], [2, 182718], [11, 183158], [19, 183498], [23, 183758], [33, 184698], [35, 184838], [38, 184978], [48, 185598], [56, 186058], [59, 186278], [63, 186478], [65, 186638], [74, 187597], [79, 187794], [83, 187974], [90, 188214], [94, 188454], [98, 188594]]}, {"verse": 19, "start": 189717, "end": 193859, "text": "Y les respondió José: No temáis: ¿estoy yo en lugar de Dios?", "words": [[0, 189717], [2, 189845], [6, 189985], [16, 190525], [22, 191266], [25, 191664], [33, 192338], [40, 192676], [43, 192836], [46, 192956], [52, 193176], [55, 193396]]}, {"verse": 20, "start": 194309, "end": 202567, "text": "Vosotros pensasteis mal sobre mí, mas Dios lo encaminó a bien, para hacer lo que vemos hoy, para mantener en vida a mucho pueblo.", "words": [[0, 194309], [9, 194727], [20, 195447], [24, 195607], [30, 195887], [34, 196467], [38, 196687], [43, 196867], [46, 197047], [55, 197547], [57, 197607], [63, 197807], [68, 198167], [74, 198407], [77, 198547], [81, 198667], [87, 198887], [92, 199487], [97, 199747], [106, 200167], [109, 200387], [114, 200607], [116, 200767], [122, 200907]]}, {"verse": 21, "start": 203017, "end": 211669, "text": "Ahora, pues, no tengáis miedo; yo os sustentaré a vosotros y a vuestros hijos. Así los consoló, y les habló al corazón.", "words": [[0, 203017], [7, 203298], [13, 203578], [16, 204058], [24, 204518], [31, 205336], [34, 205413], [37, 205533], [48, 206233], [50, 206353], [59, 206853], [61, 207053], [63, 207153], [72, 207513], [79, 208381], [83, 208645], [87, 208825], [96, 209585], [98, 210005], [102, 210185], [108, 210705], [111, 210825]]}, {"verse": 22, "start": 212119, "end": 219062, "text": "Y estuvo José en Egipto, él y la casa de su padre: y vivió José ciento diez años.", "words": [[0, 212119], [2, 212228], [9, 212648], [14, 213068], [17, 213388], [25, 214268], [28, 214528], [30, 214768], [33, 214928], [38, 215188], [41, 215408], [44, 215548], [51, 216472], [53, 216716], [59, 217076], [64, 217409], [71, 217743], [76, 218076]]}, {"verse": 23, "start": 219512, "end": 230231, "text": "Y vio José los hijos de Efraín hasta la tercera generación: también los hijos de Maquir, hijo de Manasés, fueron criados sobre las rodillas de José.", "words": [[0, 219512], [2, 219636], [6, 219896], [11, 220236], [15, 220476], [21, 220756], [24, 221056], [31, 221696], [37, 222296], [40, 222516], [48, 223036], [60, 224260], [68, 224544], [72, 224784], [78, 225084], [81, 225594], [89, 226104], [94, 226264], [97, 226444], [106, 227284], [113, 227604], [121, 228304], [127, 228864], [131, 229104], [140, 229564], [143, 229744]]}, {"verse": 24, "start": 230681, "end": 240751, "text": "Y José dijo a sus hermanos: Yo me muero; mas Dios ciertamente os visitará, y os hará subir de esta tierra a la tierra que juró a Abraham, a Isaac, y a Jacob.", "words": [[0, 230681], [2, 230883], [7, 231183], [12, 231723], [14, 231843], [18, 231963], [28, 233044], [31, 233190], [34, 233270], [41, 234049], [45, 234212], [50, 234412], [62, 235032], [65, 235212], [75, 235752], [77, 236212], [80, 236332], [85, 236532], [91, 236752], [94, 237072], [99, 237272], [106, 237632], [108, 237812], [111, 237872], [118, 238192], [122, 238392], [127, 238752], [129, 238852], [138, 239192], [140, 239532], [147, 239852], [149, 240212], [151, 240272]]}, {"verse": 25, "start": 241101, "end": 248424, "text": "Y conjuró José a los hijos de Israel, diciendo: Dios ciertamente os visitará, y haréis llevar de aquí mis huesos.", "words": [[0, 241101], [2, 241224], [10, 241864], [15, 242224], [17, 242464], [21, 242604], [27, 242884], [30, 243104], [38, 243584], [48, 244815], [53, 245054], [65, 245714], [68, 245854], [78, 246414], [80, 246814], [87, 247074], [94, 247314], [97, 247454], [102, 247614], [106, 247774]]}, {"verse": 26, "start": 248774, "end": 256631, "text": "Y murió José de edad de ciento diez años; y lo embalsamaron, y fue puesto en un ataúd en Egipto.", "words": [[0, 248774], [2, 248899], [8, 249339], [13, 249699], [16, 249939], [21, 250319], [24, 250606], [31, 250892], [36, 251179], [42, 252494], [44, 252641], [47, 252781], [61, 253761], [63, 254321], [67, 254541], [74, 254941], [77, 255121], [80, 255261], [86, 255761], [89, 255921]]}]}