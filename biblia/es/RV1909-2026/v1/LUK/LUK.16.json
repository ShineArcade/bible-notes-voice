{"book": "LUK", "chapter": 16, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 278872, "verses": [{"verse": 1, "start": 300, "end": 11733, "text": "Y dijo también a sus discípulos: Había un hombre rico, el cual tenía un mayordomo, y este fue acusado delante de él como derrochador de sus bienes.", "words": [[0, 300], [2, 407], [7, 687], [15, 1167], [17, 1527], [21, 1707], [33, 3054], [39, 3358], [42, 3498], [49, 3818], [55, 5018], [58, 5098], [63, 5278], [69, 5638], [72, 6318], [83, 6998], [85, 7078], [90, 7298], [94, 7558], [102, 8318], [110, 8838], [113, 9058], [116, 9258], [121, 9598], [133, 10578], [136, 10818], [140, 11018]]}, {"verse": 2, "start": 12183, "end": 19840, "text": "Y le llamó, y le dijo: ¿Qué es esto que oigo de ti? Da cuenta de tu mayordomía, porque ya no podrás más ser mayordomo.", "words": [[0, 12183], [2, 12394], [5, 12624], [12, 13084], [14, 13284], [17, 13404], [23, 14232], [28, 14371], [31, 14551], [36, 14751], [40, 14971], [45, 15171], [48, 15331], [52, 15954], [55, 16054], [62, 16294], [65, 16534], [68, 16654], [80, 17554], [87, 17894], [90, 18114], [93, 18234], [100, 18654], [104, 18794], [108, 19114]]}, {"verse": 3, "start": 20190, "end": 30324, "text": "Entonces el mayordomo dijo dentro de sí: ¿Qué haré? que mi señor me quita la mayordomía. Cavar, no puedo; mendigar, tengo vergüenza.", "words": [[0, 20190], [9, 20775], [12, 21555], [22, 22335], [27, 22595], [34, 23215], [37, 23555], [41, 24142], [46, 24259], [52, 24999], [56, 25079], [59, 25199], [65, 25519], [68, 25719], [74, 25999], [77, 26484], [89, 27364], [96, 27554], [99, 27694], [106, 28518], [116, 29116], [122, 29516]]}, {"verse": 4, "start": 30774, "end": 35655, "text": "Yo sé lo que haré para que cuando sea quitado de la mayordomía, me reciban en sus casas.", "words": [[0, 30774], [3, 30995], [6, 31195], [9, 31315], [13, 31455], [18, 31715], [23, 31895], [27, 32055], [34, 32295], [38, 32595], [46, 33075], [49, 33195], [52, 33315], [64, 34055], [67, 34275], [75, 34735], [78, 34855], [82, 34975]]}, {"verse": 5, "start": 36005, "end": 42031, "text": "Y llamando a cada uno de los deudores de su señor, dijo al primero: ¿Cuánto debes a mi señor?", "words": [[0, 36005], [2, 36109], [11, 36609], [13, 36729], [18, 36889], [22, 37209], [25, 37349], [29, 37489], [38, 38009], [41, 38169], [44, 38309], [51, 39169], [56, 39489], [59, 39689], [68, 40594], [76, 40917], [82, 41277], [84, 41417], [87, 41477]]}, {"verse": 6, "start": 42381, "end": 51442, "text": "Y él dijo: Cien barriles de aceite. Y le dijo: Toma tu documento de deuda, y siéntate pronto, y escribe cincuenta.", "words": [[0, 42381], [2, 42569], [5, 42729], [11, 43578], [16, 43698], [25, 44238], [28, 44378], [36, 45352], [38, 45473], [41, 45573], [47, 46338], [52, 46596], [55, 46696], [65, 47316], [68, 47376], [75, 47776], [77, 48196], [86, 48676], [94, 49116], [96, 49516], [104, 50506]]}, {"verse": 7, "start": 51792, "end": 63881, "text": "Después dijo a otro: ¿Y tú, cuánto debes? Y él dijo: Cien coros de trigo. Y él le dijo: Toma tu documento de deuda, y escribe ochenta.", "words": [[0, 51792], [8, 52015], [13, 52295], [15, 52435], [21, 53165], [24, 53305], [28, 53485], [35, 53985], [42, 55785], [44, 55974], [47, 56134], [53, 56991], [58, 57121], [64, 57641], [67, 57741], [74, 58638], [76, 58806], [79, 58946], [82, 59106], [88, 59880], [93, 60141], [96, 60241], [106, 60861], [109, 60941], [116, 61301], [118, 61601], [126, 62741]]}, {"verse": 8, "start": 64231, "end": 75227, "text": "Y alabó el señor al mayordomo malo por haber actuado con astucia; porque los hijos de este siglo son en su generación más sagaces que los hijos de luz.", "words": [[0, 64231], [2, 64354], [8, 64624], [11, 64895], [17, 65335], [20, 65904], [30, 66474], [35, 66974], [39, 67414], [45, 67594], [53, 68094], [57, 68315], [66, 69331], [73, 69536], [77, 69756], [83, 70016], [86, 70236], [91, 70416], [97, 70896], [101, 71496], [104, 71756], [107, 71976], [118, 72616], [122, 73146], [130, 73676], [134, 74136], [138, 74296], [144, 74636], [147, 74796]]}, {"verse": 9, "start": 75677, "end": 86030, "text": "Y yo os digo: Haceos amigos por medio de las riquezas injustas, para que cuando estas falten, os reciban en las moradas eternas.", "words": [[0, 75677], [2, 75836], [5, 75976], [8, 76116], [14, 76886], [21, 77432], [28, 77752], [32, 78092], [38, 78452], [41, 78652], [45, 78812], [54, 79292], [64, 80472], [69, 80712], [73, 80892], [80, 81152], [86, 81512], [94, 82273], [97, 82832], [105, 83472], [108, 83633], [112, 83773], [120, 84273]]}, {"verse": 10, "start": 86480, "end": 95383, "text": "El que es fiel en lo muy poco, también en lo más es fiel: y el que en lo muy poco es injusto, también en lo más es injusto.", "words": [[0, 86480], [3, 86480], [7, 86480], [10, 86480], [15, 86840], [18, 87080], [21, 87200], [25, 87460], [31, 88180], [39, 88600], [42, 88940], [45, 89140], [49, 89310], [52, 89480], [58, 90532], [60, 90714], [63, 90894], [67, 91134], [70, 91494], [73, 91654], [77, 91874], [82, 92214], [85, 92434], [94, 93394], [102, 93774], [105, 94074], [108, 94214], [112, 94454], [115, 94554]]}, {"verse": 11, "start": 95833, "end": 100886, "text": "Pues si en las malas riquezas no fuisteis fieles, ¿quién os confiará lo verdadero?", "words": [[0, 95833], [5, 95955], [8, 96275], [11, 96415], [15, 96575], [21, 96975], [30, 97435], [33, 97655], [42, 98155], [50, 98975], [57, 99215], [60, 99375], [69, 100015], [72, 100135]]}, {"verse": 12, "start": 101336, "end": 105981, "text": "Y si en lo ajeno no fuisteis fieles, ¿quién os dará lo que es vuestro?", "words": [[0, 101336], [2, 101461], [5, 101621], [8, 101761], [11, 101921], [17, 102321], [20, 102501], [29, 103081], [37, 103941], [44, 104231], [47, 104521], [52, 104861], [55, 105001], [59, 105161], [62, 105321]]}, {"verse": 13, "start": 106431, "end": 120892, "text": "Ningún siervo puede servir a dos señores; porque o aborrecerá al uno y amará al otro, o se allegará al uno y menospreciará al otro. No podéis servir a Dios y a las riquezas.", "words": [[0, 106431], [7, 106842], [14, 107322], [20, 107552], [27, 107782], [29, 108012], [33, 108242], [42, 109495], [49, 109877], [51, 110377], [62, 111317], [65, 111557], [69, 111837], [71, 112137], [77, 112477], [80, 112757], [86, 113557], [88, 113830], [91, 114104], [100, 114377], [103, 114717], [107, 115077], [109, 115877], [123, 116677], [126, 117017], [132, 117893], [135, 118083], [142, 118563], [149, 119043], [151, 119283], [156, 119483], [158, 119723], [160, 119803], [164, 119903]]}, {"verse": 14, "start": 121342, "end": 127813, "text": "Y oían también todas estas cosas los fariseos, los cuales eran avaros, y se burlaban de él.", "words": [[0, 121342], [2, 121500], [7, 121800], [15, 122160], [21, 122460], [27, 122820], [33, 123760], [37, 123840], [47, 124820], [51, 124940], [58, 125140], [63, 125460], [71, 125980], [73, 126400], [76, 126540], [85, 127060], [88, 127360]]}, {"verse": 15, "start": 128263, "end": 142435, "text": "Y les dijo: Vosotros sois los que os justificáis a vosotros mismos delante de los hombres; pero Dios conoce vuestros corazones; porque lo que los hombres tienen por sublime, delante de Dios es abominación.", "words": [[0, 128263], [2, 128388], [6, 128508], [12, 129320], [21, 129786], [26, 130286], [30, 130666], [34, 130766], [37, 130866], [49, 131746], [51, 131866], [60, 132286], [67, 132586], [75, 133146], [78, 133286], [82, 133426], [91, 134366], [96, 134510], [101, 134710], [108, 135230], [117, 135610], [128, 136826], [135, 136990], [138, 137170], [142, 137290], [146, 137450], [154, 137750], [161, 138090], [165, 138560], [174, 139030], [182, 139630], [185, 139810], [190, 140050], [193, 140390]]}, {"verse": 16, "start": 142885, "end": 152243, "text": "La ley y los profetas hasta Juan: desde entonces el reino de Dios es anunciado, y todos se esfuerzan a entrar en él.", "words": [[0, 142885], [3, 142885], [7, 142885], [9, 142989], [13, 143089], [22, 143669], [28, 144149], [34, 145013], [40, 145181], [49, 145741], [52, 146101], [58, 146521], [61, 146661], [66, 147061], [69, 147581], [80, 148341], [82, 149081], [88, 149441], [91, 150101], [101, 150881], [103, 151141], [110, 151581], [113, 151921]]}, {"verse": 17, "start": 152693, "end": 159387, "text": "Pero más fácil cosa es pasar el cielo y la tierra, que caer un solo trazo de una letra de la ley.", "words": [[0, 152693], [5, 152837], [9, 153037], [15, 153477], [20, 153877], [23, 154157], [29, 154557], [32, 154797], [38, 155137], [40, 155337], [43, 155437], [51, 156397], [55, 156397], [60, 156817], [63, 156977], [68, 157257], [74, 157817], [77, 157977], [81, 158137], [87, 158637], [90, 158757], [93, 158897]]}, {"verse": 18, "start": 159837, "end": 170434, "text": "Cualquiera que se divorcia de su mujer, y se casa con otra, comete adulterio: y el que se casa con una mujer divorciada de su marido, comete adulterio.", "words": [[0, 159837], [11, 160300], [15, 160480], [18, 160640], [27, 161220], [30, 161360], [33, 161520], [40, 161920], [42, 162180], [45, 162320], [50, 162620], [54, 162940], [60, 163780], [67, 164080], [78, 165288], [80, 165563], [83, 165663], [87, 165803], [90, 165963], [95, 166283], [99, 166583], [103, 166763], [109, 167123], [120, 167923], [123, 168103], [126, 168223], [134, 168823], [141, 169323]]}, {"verse": 19, "start": 170884, "end": 178490, "text": "Había un hombre rico, que se vestía de púrpura y de lino fino, y hacía cada día banquete con esplendidez.", "words": [[0, 170884], [6, 171128], [9, 171368], [16, 171668], [22, 172308], [26, 172988], [29, 173148], [36, 173568], [39, 173708], [47, 174308], [49, 174408], [52, 174548], [57, 174848], [63, 175168], [65, 175768], [71, 176088], [76, 176388], [80, 176688], [89, 177248], [93, 177898]]}, {"verse": 20, "start": 178940, "end": 185674, "text": "Había también un mendigo llamado Lázaro, el cual estaba echado a la puerta de él, lleno de llagas,", "words": [[0, 178940], [6, 179258], [14, 179578], [17, 179818], [25, 180418], [33, 180698], [41, 182018], [44, 182098], [49, 182258], [56, 182598], [63, 183038], [65, 183118], [68, 183178], [75, 183478], [78, 183758], [82, 184458], [88, 184818], [91, 184938]]}, {"verse": 21, "start": 186124, "end": 194572, "text": "Y deseando hartarse de las migajas que caían de la mesa del rico; y aun los perros venían y le lamían las llagas.", "words": [[0, 186124], [2, 186250], [11, 186850], [20, 187730], [23, 188230], [27, 188620], [35, 189010], [39, 189150], [45, 189610], [48, 189750], [51, 189850], [56, 190090], [60, 190350], [66, 191256], [68, 191421], [72, 191581], [76, 191821], [83, 192301], [90, 192861], [92, 193121], [95, 193221], [102, 193641], [106, 194136]]}, {"verse": 22, "start": 195022, "end": 204203, "text": "Y aconteció que murió el mendigo, y fue llevado por los ángeles al seno de Abraham: y murió también el rico, y fue sepultado.", "words": [[0, 195022], [2, 195122], [12, 195782], [16, 195942], [22, 196362], [25, 196502], [34, 197102], [36, 197582], [40, 197762], [48, 198262], [52, 198442], [56, 198642], [64, 199202], [67, 199442], [72, 199902], [75, 200022], [84, 201139], [86, 201268], [92, 201588], [100, 201888], [103, 202188], [109, 202548], [111, 203008], [115, 203168]]}, {"verse": 23, "start": 204653, "end": 212659, "text": "Y en el infierno alzó sus ojos, estando en los tormentos, y vio a Abraham de lejos, y a Lázaro en su seno.", "words": [[0, 204653], [2, 204796], [5, 204916], [8, 205056], [17, 205696], [22, 206256], [26, 206436], [32, 207156], [40, 207696], [43, 207816], [47, 207936], [58, 208876], [60, 209076], [64, 209376], [66, 209636], [74, 210156], [77, 210416], [84, 210776], [86, 211129], [88, 211483], [95, 211836], [98, 211996], [101, 212116]]}, {"verse": 24, "start": 213109, "end": 225041, "text": "Entonces él, dando voces, dijo: Padre Abraham, ten misericordia de mí, y envía a Lázaro que moje la punta de su dedo en agua, y refresque mi lengua; porque soy atormentado en esta llama.", "words": [[0, 213109], [9, 214067], [13, 214207], [19, 214467], [26, 215007], [32, 215905], [38, 216176], [47, 216716], [51, 216816], [64, 217576], [67, 217736], [71, 217916], [73, 218276], [79, 218576], [81, 218876], [88, 219176], [92, 219336], [97, 219656], [100, 219776], [106, 220136], [109, 220256], [112, 220416], [117, 220716], [120, 220816], [126, 221076], [128, 221536], [138, 222156], [141, 222296], [149, 223082], [156, 223279], [160, 223519], [172, 224259], [175, 224399], [180, 224579]]}, {"verse": 25, "start": 225391, "end": 235535, "text": "Y le dijo Abraham: Hijo, acuérdate que recibiste tus bienes en tu vida, y Lázaro también males; pero ahora este es consolado aquí, y tú atormentado.", "words": [[0, 225391], [2, 225536], [5, 225636], [10, 225936], [19, 227055], [25, 227439], [35, 227799], [39, 227999], [49, 228559], [53, 228759], [60, 229159], [63, 229279], [66, 229399], [72, 229679], [74, 230189], [81, 230699], [89, 231039], [96, 232095], [101, 232239], [107, 232559], [112, 232899], [115, 233079], [125, 233659], [131, 233919], [133, 234379], [136, 234539]]}, {"verse": 26, "start": 235985, "end": 245808, "text": "Y además de todo esto, un gran abismo está establecido entre nosotros y vosotros, que los que quieran pasar de aquí a vosotros, no pueden, ni de allá pasar acá.", "words": [[0, 235985], [2, 236111], [9, 236411], [12, 236591], [17, 236791], [23, 237831], [26, 237991], [31, 238171], [38, 238611], [43, 238851], [55, 239531], [61, 239771], [70, 240231], [72, 240511], [82, 241011], [86, 241491], [90, 241631], [94, 241771], [102, 242071], [108, 242311], [111, 242531], [116, 242711], [118, 242811], [128, 243351], [131, 243851], [139, 244291], [142, 244751], [145, 244871], [150, 245011], [156, 245311]]}, {"verse": 27, "start": 246158, "end": 250633, "text": "Y dijo: Te ruego pues, padre, que le envíes a la casa de mi padre;", "words": [[0, 246158], [2, 246287], [8, 247059], [11, 247182], [17, 247562], [23, 247703], [30, 248642], [34, 248722], [37, 248862], [44, 249342], [46, 249462], [49, 249543], [54, 249802], [57, 250022], [60, 250122]]}, {"verse": 28, "start": 251083, "end": 257330, "text": "Porque tengo cinco hermanos; para que les testifique, porque no vengan ellos también a este lugar de tormento.", "words": [[0, 251083], [7, 251262], [13, 251542], [19, 251882], [29, 252929], [34, 253073], [38, 253193], [42, 253333], [54, 254353], [61, 254573], [64, 254773], [71, 255113], [77, 255273], [85, 255673], [87, 255893], [92, 256113], [98, 256393], [101, 256613]]}, {"verse": 29, "start": 257680, "end": 262868, "text": "Y Abraham le dice: A Moisés y a los profetas tienen: óiganlos.", "words": [[0, 257680], [2, 257824], [10, 258164], [13, 258544], [19, 259419], [21, 259541], [28, 259941], [30, 260401], [32, 260481], [36, 260621], [45, 261161], [53, 262075]]}, {"verse": 30, "start": 263218, "end": 270256, "text": "Él entonces dijo: No, padre Abraham: pero si alguno va a ellos de los muertos, se arrepentirán.", "words": [[0, 263218], [3, 263847], [12, 264367], [18, 265393], [22, 265749], [28, 266149], [37, 266793], [42, 266935], [45, 267135], [52, 267575], [55, 267715], [57, 267875], [63, 268035], [66, 268195], [70, 268335], [79, 269095], [82, 269315]]}, {"verse": 31, "start": 270606, "end": 278472, "text": "Pero Abraham le dijo: Si no oyen a Moisés y a los profetas, tampoco se persuadirán, si alguno resucita de los muertos.", "words": [[0, 270606], [5, 270770], [13, 271330], [16, 271970], [22, 272756], [25, 272910], [28, 273070], [33, 273370], [35, 273410], [42, 273830], [44, 274070], [46, 274090], [50, 274230], [60, 275110], [68, 275370], [71, 275670], [84, 276390], [87, 276710], [94, 277090], [103, 277590], [106, 277710], [110, 277810]]}]}