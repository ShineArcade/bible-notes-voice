{"book": "PSA", "chapter": 49, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 134368, "verses": [{"verse": 1, "start": 300, "end": 8724, "text": "Al Músico principal: Salmo para los hijos de Coré. Oíd esto, pueblos todos; escuchad, habitantes todos del mundo:", "words": [[0, 300], [3, 492], [10, 972], [21, 2076], [27, 2638], [32, 3118], [36, 3318], [42, 3638], [45, 3988], [51, 4810], [55, 5064], [61, 5317], [69, 5630], [76, 7010], [86, 7810], [97, 8038], [103, 8267], [107, 8495]]}, {"verse": 2, "start": 9174, "end": 14875, "text": "Así los plebeyos como los nobles, el rico y el pobre juntamente.", "words": [[0, 10374], [4, 10554], [8, 10974], [17, 11394], [22, 11634], [26, 11814], [34, 12674], [37, 12774], [42, 13154], [44, 13454], [47, 13594], [53, 13874]]}, {"verse": 3, "start": 15325, "end": 20719, "text": "Mi boca hablará sabiduría; y el pensamiento de mi corazón inteligencia.", "words": [[0, 15325], [3, 15430], [8, 15710], [16, 16370], [27, 17594], [29, 17699], [32, 17819], [44, 18639], [47, 18839], [50, 18979], [58, 19379]]}, {"verse": 4, "start": 21168, "end": 26407, "text": "Inclinaré mi oído a proverbios: declararé con el arpa mi enigma.", "words": [[0, 21168], [10, 21952], [13, 22192], [18, 22552], [20, 22712], [32, 24032], [42, 24797], [46, 25017], [49, 25197], [54, 25557], [57, 25777]]}, {"verse": 5, "start": 26857, "end": 32721, "text": "¿Por qué he de temer en los días de adversidad, cuando la iniquidad de mis opresores me rodee?", "words": [[0, 26857], [5, 26984], [9, 27184], [12, 27384], [15, 27584], [21, 27784], [24, 27984], [28, 28084], [33, 28304], [36, 28504], [48, 29184], [55, 29884], [58, 30144], [68, 30904], [71, 31084], [75, 31224], [85, 31864], [88, 32084]]}, {"verse": 6, "start": 33171, "end": 37820, "text": "Los que confían en sus bienes, y en la muchedumbre de sus riquezas se jactan,", "words": [[0, 33171], [4, 33452], [8, 33782], [16, 34112], [19, 34192], [23, 34352], [31, 35032], [33, 35172], [36, 35272], [39, 35372], [51, 36032], [54, 36172], [58, 36352], [67, 36972], [70, 37424]]}, {"verse": 7, "start": 38270, "end": 44299, "text": "Ninguno de ellos podrá en manera alguna redimir al hermano, ni dar a Dios su rescate.", "words": [[0, 38270], [8, 38899], [11, 39019], [17, 39319], [23, 39859], [26, 39919], [33, 40239], [40, 40909], [48, 41579], [51, 41679], [60, 42112], [63, 42546], [67, 42979], [69, 43079], [74, 43279], [77, 43539]]}, {"verse": 8, "start": 44749, "end": 48789, "text": "(Porque la redención de su vida es de gran precio, y no se hará jamás;)", "words": [[0, 44749], [8, 44909], [11, 45129], [21, 45789], [24, 45989], [27, 46149], [32, 46429], [35, 46529], [38, 46649], [43, 46849], [51, 47409], [53, 47649], [56, 47809], [59, 47969], [64, 48209]]}, {"verse": 9, "start": 49239, "end": 53328, "text": "Que viva adelante para siempre, y nunca vea la sepultura.", "words": [[0, 49239], [4, 49323], [9, 49643], [18, 50203], [23, 50523], [32, 51003], [34, 51723], [40, 51903], [44, 52403], [47, 52902]]}, {"verse": 10, "start": 53778, "end": 61955, "text": "Pues se ve que mueren los sabios, así como el insensato y el necio perecen, y dejan a otros sus riquezas.", "words": [[0, 53778], [5, 53919], [8, 54059], [11, 54159], [15, 54399], [22, 54639], [26, 54759], [34, 55439], [38, 55879], [43, 56159], [46, 56299], [56, 57299], [58, 57479], [61, 57599], [67, 58039], [76, 58719], [78, 59399], [84, 59859], [86, 60139], [92, 60499], [96, 61079]]}, {"verse": 11, "start": 62405, "end": 72693, "text": "En su interior tienen que sus casas serán eternas, y sus habitaciones para generación y generación: llamaron sus tierras de sus nombres.", "words": [[0, 62405], [3, 62550], [6, 62710], [15, 63210], [22, 63570], [26, 63810], [30, 64010], [36, 64530], [42, 64850], [51, 65910], [53, 66130], [57, 66290], [70, 67010], [75, 67290], [86, 68090], [88, 68230], [100, 70545], [109, 70665], [113, 70785], [121, 70905], [124, 71025], [128, 71205]]}, {"verse": 12, "start": 73143, "end": 78631, "text": "Mas el hombre no permanecerá en honra: es semejante a las bestias que perecen.", "words": [[0, 73192], [4, 73272], [7, 73352], [14, 73592], [17, 74032], [29, 75012], [32, 75445], [39, 76125], [42, 76406], [52, 77046], [54, 77166], [58, 77466], [66, 77766], [70, 77906]]}, {"verse": 13, "start": 79081, "end": 86559, "text": "Este su camino es su locura: con todo, corren sus descendientes por el dicho de ellos. (Selah.)", "words": [[0, 79081], [5, 79368], [8, 79568], [15, 79948], [18, 80368], [21, 80568], [29, 82366], [33, 82366], [39, 82366], [46, 82831], [50, 83091], [64, 84191], [68, 84511], [71, 84651], [77, 84951], [80, 85151], [87, 86322]]}, {"verse": 14, "start": 87009, "end": 100107, "text": "Como rebaños serán puestos en la sepultura; la muerte se cebará en ellos; y por la mañana los justos prevalecerán sobre ellos: y se consumirá su hermosura en el sepulcro de su morada.", "words": [[0, 87009], [5, 87533], [13, 88093], [19, 88493], [27, 89013], [30, 89153], [33, 89293], [44, 90471], [47, 90620], [54, 90940], [57, 91380], [64, 91820], [67, 91980], [74, 92908], [76, 92996], [80, 93176], [83, 93316], [90, 93636], [94, 93896], [101, 94396], [114, 95196], [120, 95496], [127, 96442], [129, 96564], [132, 96664], [142, 97364], [145, 97524], [155, 98164], [158, 98304], [161, 98444], [170, 99104], [173, 99264], [176, 99384]]}, {"verse": 15, "start": 100557, "end": 106023, "text": "Pero Dios redimirá mi vida del poder de la sepultura, cuando me tome. (Selah.)", "words": [[0, 100557], [5, 100742], [10, 101492], [19, 102242], [22, 102402], [27, 102702], [31, 102942], [37, 103282], [40, 103482], [43, 103602], [54, 104222], [61, 104482], [64, 104742], [70, 105787]]}, {"verse": 16, "start": 106473, "end": 110309, "text": "No temas cuando se enriquece alguno, cuando aumenta la gloria de su casa;", "words": [[0, 106473], [3, 106603], [9, 106943], [16, 107103], [19, 107403], [29, 107863], [37, 108303], [44, 108463], [52, 109043], [55, 109143], [62, 109483], [65, 109623], [68, 109743]]}, {"verse": 17, "start": 110759, "end": 115299, "text": "Porque al morir no llevará nada, ni descenderá tras él su gloria.", "words": [[0, 110759], [7, 110986], [10, 111146], [16, 111566], [19, 111786], [27, 112246], [33, 113046], [36, 113246], [47, 113986], [52, 114146], [55, 114426], [58, 114872]]}, {"verse": 18, "start": 115749, "end": 122328, "text": "Si bien mientras viva, dirá dichosa a su alma: y tú serás alabado cuando bien te trates.", "words": [[0, 115749], [3, 115915], [8, 116255], [17, 116915], [23, 117495], [28, 117995], [36, 118535], [38, 118735], [41, 118835], [47, 119768], [49, 119895], [52, 120015], [58, 120435], [66, 120935], [73, 121135], [78, 121435], [81, 121615]]}, {"verse": 19, "start": 122778, "end": 128117, "text": "Entrará a la generación de sus padres: no verán luz para siempre.", "words": [[0, 122778], [8, 123499], [10, 123739], [13, 123839], [24, 124559], [27, 124719], [31, 124859], [39, 126035], [42, 126181], [48, 126541], [52, 126781], [57, 127161]]}, {"verse": 20, "start": 128567, "end": 133968, "text": "El hombre en honra que no entiende, semejante es a las bestias que perecen.", "words": [[0, 128567], [3, 128731], [10, 129051], [13, 129471], [19, 130031], [23, 130331], [26, 130531], [36, 131371], [46, 132091], [49, 132331], [51, 132431], [55, 132571], [63, 133011], [67, 133171]]}]}