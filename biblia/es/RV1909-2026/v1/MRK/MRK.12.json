{"book": "MRK", "chapter": 12, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 385417, "verses": [{"verse": 1, "start": 300, "end": 18027, "text": "Y comenzó a hablarles por parábolas: Plantó un hombre una viña, y la rodeó con una cerca, y cavó un depósito para recoger el vino, y edificó una torre, y la arrendó a agricultores arrendatarios, y se fue lejos.", "words": [[0, 300], [2, 417], [10, 1097], [12, 1297], [22, 1857], [26, 2077], [37, 3240], [44, 3804], [47, 3984], [54, 4284], [58, 4544], [64, 5104], [66, 5744], [69, 5904], [75, 6464], [79, 6644], [83, 6804], [90, 7264], [92, 7632], [97, 7999], [100, 8099], [109, 8739], [114, 8999], [122, 9559], [125, 9719], [131, 10099], [133, 10839], [141, 11519], [145, 11719], [152, 12699], [154, 13019], [157, 13139], [165, 13939], [167, 14159], [180, 15219], [195, 16771], [197, 16898], [200, 17038], [204, 17238]]}, {"verse": 2, "start": 18377, "end": 25042, "text": "Y envió un siervo a los labradores, al tiempo, para que tomase de los labradores del fruto de la viña.", "words": [[0, 18377], [2, 18498], [8, 18858], [11, 19018], [18, 19478], [20, 19578], [24, 19718], [36, 20558], [39, 20978], [47, 21498], [52, 22053], [56, 22193], [63, 22693], [66, 22833], [70, 22993], [81, 23653], [85, 23833], [91, 24253], [94, 24353], [97, 24473]]}, {"verse": 3, "start": 25392, "end": 30288, "text": "Pero ellos, tomándole, lo golpearon, y le enviaron vacío.", "words": [[0, 25392], [5, 25757], [12, 25976], [23, 27257], [26, 27377], [37, 28136], [39, 28796], [42, 28937], [51, 29457]]}, {"verse": 4, "start": 30638, "end": 38336, "text": "Y volvió a enviarles otro siervo; pero apedreándole, le hirieron en la cabeza, y lo despidieron humillado.", "words": [[0, 30638], [2, 30785], [9, 31165], [11, 31245], [21, 31725], [26, 31965], [34, 32787], [39, 32972], [53, 34352], [56, 34792], [65, 35232], [68, 35412], [71, 35552], [79, 36012], [81, 36552], [84, 36692], [96, 37372]]}, {"verse": 5, "start": 38686, "end": 46481, "text": "Y volvió a enviar otro, y a aquel mataron; y a otros muchos, hiriendo a unos y matando a otros.", "words": [[0, 38686], [2, 38815], [9, 39295], [11, 39415], [18, 39855], [24, 40184], [26, 40512], [28, 40841], [34, 41170], [43, 42237], [45, 42379], [47, 42459], [53, 42719], [61, 43539], [70, 44359], [72, 44559], [77, 44819], [79, 45179], [87, 45699], [89, 45839]]}, {"verse": 6, "start": 46831, "end": 54706, "text": "Teniendo pues aún un hijo suyo amado, lo envió también a ellos por último, diciendo: Respetarán a mi hijo.", "words": [[0, 46831], [9, 47316], [14, 47596], [18, 47876], [21, 48096], [26, 48336], [31, 48776], [38, 49516], [41, 49916], [47, 50236], [55, 50536], [57, 50836], [63, 51056], [67, 51316], [75, 52136], [85, 53175], [96, 53953], [98, 54053], [101, 54173]]}, {"verse": 7, "start": 55056, "end": 62912, "text": "Pero aquellos labradores dijeron entre sí: Este es el heredero; venid, matémosle, y la herencia será nuestra.", "words": [[0, 55056], [5, 55198], [14, 55538], [25, 56458], [33, 56998], [39, 57238], [43, 58114], [48, 58114], [51, 58369], [54, 58608], [64, 59502], [71, 60013], [82, 60813], [84, 61173], [87, 61313], [96, 61833], [101, 62153]]}, {"verse": 8, "start": 63262, "end": 67385, "text": "Y prendiéndole, le mataron, y echaron fuera de la viña.", "words": [[0, 63262], [2, 63390], [16, 64250], [19, 64510], [28, 65110], [30, 65690], [38, 66110], [44, 66390], [47, 66650], [50, 66770]]}, {"verse": 9, "start": 67735, "end": 75342, "text": "¿Qué, pues, hará el señor de la viña? Vendrá, y destruirá a estos labradores, y dará su viña a otros.", "words": [[0, 67735], [6, 67837], [12, 68157], [17, 68717], [20, 68837], [26, 69137], [29, 69377], [32, 69497], [38, 70315], [46, 70901], [48, 71081], [58, 71781], [60, 71981], [66, 72261], [78, 73081], [80, 73421], [85, 73741], [88, 73941], [93, 74381], [95, 74621]]}, {"verse": 10, "start": 75692, "end": 83904, "text": "¿Ni aun esta Escritura habéis leído: La piedra que desecharon los que edificaban, esta se ha convertido en la piedra angular;", "words": [[0, 75808], [4, 75963], [8, 76118], [13, 76273], [23, 76833], [30, 77153], [37, 77966], [40, 78072], [47, 78572], [51, 78732], [62, 79452], [66, 79652], [70, 79832], [82, 80692], [87, 81012], [90, 81452], [93, 81552], [104, 82292], [107, 82492], [110, 82632], [117, 83092]]}, {"verse": 11, "start": 84254, "end": 88493, "text": "Por el Señor es hecho esto, y es cosa maravillosa en nuestros ojos?", "words": [[0, 84254], [4, 84397], [7, 84537], [13, 84817], [16, 85037], [22, 85277], [28, 85677], [30, 86177], [33, 86337], [38, 86537], [50, 87437], [53, 87617], [62, 87857]]}, {"verse": 12, "start": 88843, "end": 98671, "text": "Y procuraban prenderle, porque entendían que decía a ellos aquella parábola; pero temían a la multitud; y dejándole, se fueron.", "words": [[0, 88843], [2, 88965], [13, 89665], [24, 90505], [31, 91225], [41, 92105], [45, 92305], [51, 92745], [53, 93045], [59, 93285], [67, 93785], [77, 94745], [82, 95031], [89, 95591], [91, 95751], [94, 95831], [104, 96821], [106, 96924], [117, 97584], [120, 98044]]}, {"verse": 13, "start": 99021, "end": 105707, "text": "Y envían a él algunos de los fariseos y de los Herodianos, para atraparlo en sus propias palabras.", "words": [[0, 99021], [2, 99163], [9, 99583], [11, 99703], [14, 99923], [22, 100383], [25, 100603], [29, 100703], [38, 101343], [40, 101463], [43, 101543], [47, 101663], [59, 102583], [64, 103003], [74, 104003], [77, 104143], [81, 104323], [89, 104843]]}, {"verse": 14, "start": 106057, "end": 122008, "text": "Y viniendo ellos, le dicen: Maestro, sabemos que eres hombre de verdad, y que no te dejas influir por nadie; porque no miras a la apariencia de hombres, antes con verdad enseñas el camino de Dios: ¿Es lícito dar tributo a César, o no? ¿Daremos, o no daremos?", "words": [[0, 106057], [2, 106237], [11, 106737], [18, 106997], [21, 107257], [28, 108062], [37, 108646], [45, 108886], [49, 109186], [54, 109346], [61, 109646], [64, 109846], [72, 110186], [74, 110401], [78, 110521], [81, 110661], [84, 110801], [90, 111061], [98, 111581], [102, 111741], [109, 112475], [116, 112659], [119, 112859], [125, 113239], [127, 113339], [130, 113439], [141, 113939], [144, 114159], [153, 114839], [159, 115359], [163, 115459], [170, 116119], [178, 116659], [181, 116759], [188, 116999], [191, 117279], [197, 117984], [201, 118129], [208, 118529], [212, 118729], [220, 119249], [222, 119309], [229, 119709], [231, 119929], [235, 120492], [245, 121037], [247, 121237], [250, 121397]]}, {"verse": 15, "start": 122288, "end": 132066, "text": "Entonces él, como entendía la hipocresía de ellos, les dijo: ¿Por qué intentáis ponerme a prueba? Traedme la moneda para que la vea.", "words": [[0, 122288], [9, 122733], [13, 123293], [18, 123473], [27, 124113], [30, 124273], [41, 125133], [44, 125313], [51, 125973], [55, 126073], [61, 126797], [66, 126922], [70, 127202], [80, 128082], [88, 128722], [90, 128862], [98, 129787], [106, 130371], [109, 130531], [116, 130951], [121, 131191], [125, 131371], [128, 131531]]}, {"verse": 16, "start": 132416, "end": 141063, "text": "Y ellos se la trajeron y les dice: ¿De quién es esta imagen y esta inscripción? Y ellos le dijeron: De César.", "words": [[0, 132416], [2, 132581], [8, 132861], [11, 133081], [14, 133181], [23, 133941], [25, 134121], [29, 134261], [35, 135140], [39, 135322], [45, 135542], [48, 136022], [53, 136322], [60, 136802], [62, 137062], [67, 137302], [80, 138573], [82, 138777], [88, 139097], [91, 139417], [100, 140321], [103, 140464]]}, {"verse": 17, "start": 141343, "end": 150100, "text": "Y respondiendo Jesús, les dijo: Dad lo que es de César a César; y lo que es de Dios, a Dios. Y se maravillaron de ello.", "words": [[0, 141343], [2, 141467], [15, 142207], [22, 143007], [26, 143107], [32, 143847], [36, 144192], [39, 144527], [43, 144687], [46, 144787], [49, 144907], [55, 145367], [57, 145587], [64, 146288], [66, 146392], [69, 146512], [73, 146672], [76, 146772], [79, 146872], [85, 147300], [87, 147729], [93, 148326], [95, 148510], [98, 148630], [111, 149330], [114, 149550]]}, {"verse": 18, "start": 150450, "end": 158010, "text": "Entonces vienen a él los saduceos, que dicen que no hay resurrección, y le preguntaron, diciendo:", "words": [[0, 150450], [9, 150848], [16, 151368], [18, 151708], [21, 151968], [25, 152288], [35, 153528], [39, 153728], [45, 154008], [49, 154248], [52, 154508], [56, 154688], [70, 156148], [72, 156248], [75, 156328], [88, 157068]]}, {"verse": 19, "start": 158210, "end": 168051, "text": "Maestro, Moisés nos escribió, que si el hermano de alguno muriese, y dejase mujer, y no dejase hijos, que su hermano tome su mujer, y dé descendencia a su hermano.", "words": [[0, 158210], [9, 158611], [16, 158971], [20, 159171], [30, 159911], [34, 160411], [37, 160591], [40, 160711], [48, 161131], [51, 161211], [58, 161611], [67, 162091], [69, 162351], [76, 162771], [83, 163111], [85, 163671], [88, 163791], [95, 164231], [102, 164931], [106, 165011], [109, 165151], [117, 165531], [122, 165771], [125, 165911], [132, 166251], [134, 166531], [137, 166651], [150, 167351], [152, 167491], [155, 167551]]}, {"verse": 20, "start": 168401, "end": 173649, "text": "Fueron siete hermanos: y el primero tomó mujer, y muriendo, no dejó descendencia;", "words": [[0, 168401], [7, 168609], [13, 168909], [23, 169863], [25, 169964], [28, 170064], [36, 170384], [41, 170764], [48, 171124], [50, 171424], [60, 172244], [63, 172424], [68, 173064]]}, {"verse": 21, "start": 173999, "end": 180137, "text": "Y la tomó el segundo, y murió, y ni aquel tampoco dejó descendencia; y el tercero, de la misma manera.", "words": [[0, 173999], [2, 174101], [5, 174161], [10, 174441], [13, 174521], [22, 174921], [24, 175261], [31, 175701], [33, 176061], [36, 176161], [42, 176461], [50, 176761], [55, 177456], [69, 178317], [71, 178377], [74, 178477], [83, 179037], [86, 179177], [89, 179297], [95, 179517]]}, {"verse": 22, "start": 180487, "end": 186103, "text": "Y la tomaron los siete, y tampoco dejaron descendencia: después de todos murió también la mujer.", "words": [[0, 180487], [2, 180604], [5, 180704], [13, 181124], [17, 181304], [24, 181664], [26, 181929], [34, 182229], [42, 182789], [56, 183916], [64, 184263], [67, 184463], [73, 184723], [79, 185203], [87, 185423], [90, 185643]]}, {"verse": 23, "start": 186453, "end": 192935, "text": "En la resurrección, pues, cuando resuciten, ¿de cuál de ellos será mujer? porque los siete la tuvieron por mujer.", "words": [[0, 186453], [3, 186595], [6, 186675], [20, 187515], [26, 187895], [33, 188135], [44, 188795], [48, 189260], [53, 189520], [56, 189720], [62, 189940], [67, 190180], [74, 190963], [81, 191165], [85, 191345], [91, 191625], [94, 191845], [103, 192225], [107, 192385]]}, {"verse": 24, "start": 193215, "end": 201118, "text": "Entonces respondiendo Jesús, les dice: ¿No erráis por eso, porque no sabéis las Escrituras, ni el poder de Dios?", "words": [[0, 193215], [9, 194006], [22, 194698], [29, 195048], [33, 195398], [39, 196162], [43, 196469], [50, 196809], [54, 197029], [59, 197649], [66, 197949], [69, 198129], [76, 198549], [80, 198709], [92, 199319], [95, 199929], [98, 200049], [104, 200429], [107, 200569]]}, {"verse": 25, "start": 201468, "end": 210903, "text": "Porque cuando resuciten de los muertos, ni se casarán, ni serán dados en casamiento, sino que son como los ángeles que están en los cielos.", "words": [[0, 201468], [7, 201692], [14, 202032], [24, 202832], [27, 203012], [31, 203132], [40, 204032], [43, 204272], [46, 204432], [55, 205392], [58, 205612], [64, 206012], [70, 206352], [73, 206652], [85, 207712], [90, 207992], [94, 208192], [98, 208432], [103, 208732], [107, 208912], [115, 209512], [119, 209672], [125, 209912], [128, 210092], [132, 210212]]}, {"verse": 26, "start": 211253, "end": 224535, "text": "Y de que los muertos hayan de resucitar, ¿no habéis leído en el libro de Moisés cómo le habló Dios en la zarza, diciendo: Yo soy el Dios de Abraham, y el Dios de Isaac, y el Dios de Jacob?", "words": [[0, 211253], [2, 211377], [5, 211497], [9, 211637], [13, 211817], [21, 212377], [27, 212937], [30, 213057], [41, 214217], [45, 214377], [52, 214837], [58, 215277], [61, 215417], [64, 215557], [70, 215817], [73, 216017], [80, 216417], [85, 216877], [88, 217077], [94, 217377], [99, 217537], [102, 217797], [105, 218337], [112, 218877], [122, 219847], [125, 220057], [129, 220377], [132, 220617], [137, 220837], [140, 221057], [149, 221517], [151, 221842], [154, 222002], [159, 222302], [162, 222562], [169, 223142], [171, 223507], [174, 223627], [179, 223827], [182, 223987]]}, {"verse": 27, "start": 224885, "end": 229911, "text": "No es Dios de muertos, sino Dios de vivos; así que vosotros mucho erráis.", "words": [[0, 224885], [3, 225051], [6, 225191], [11, 225411], [14, 225611], [23, 226291], [28, 226591], [33, 226871], [36, 227031], [43, 227708], [47, 228068], [51, 228248], [60, 228748], [66, 229148]]}, {"verse": 28, "start": 230261, "end": 240775, "text": "Y llegándose uno de los escribas, que los había oído debatir, y sabía que les había respondido bien, le preguntó: ¿Cuál es el primer mandamiento de todos?", "words": [[0, 230261], [2, 230365], [13, 231045], [17, 231405], [20, 231565], [24, 231725], [34, 232825], [38, 232905], [42, 233065], [48, 233385], [53, 233745], [62, 234445], [64, 234785], [70, 235225], [74, 235325], [78, 235485], [84, 235805], [95, 236505], [101, 237345], [104, 237505], [114, 238551], [120, 238774], [123, 238894], [126, 239014], [133, 239274], [145, 239934], [148, 240154]]}, {"verse": 29, "start": 241055, "end": 250348, "text": "Y Jesús le respondió: El primer mandamiento de todos es: Oye, Israel, el Señor nuestro Dios, el Señor uno es.", "words": [[0, 241055], [2, 241176], [8, 241576], [11, 241996], [22, 243039], [25, 243226], [32, 243546], [44, 244386], [47, 244546], [53, 244826], [57, 245636], [62, 246244], [70, 247284], [73, 247424], [79, 247724], [87, 248064], [93, 248964], [96, 249104], [102, 249404], [106, 249864]]}, {"verse": 30, "start": 250698, "end": 261427, "text": "Amarás pues al Señor tu Dios de todo tu corazón, y de toda tu alma, y de toda tu mente, y de todas tus fuerzas; este es el principal mandamiento.", "words": [[0, 250698], [7, 251240], [12, 251460], [15, 251760], [21, 252120], [24, 252480], [29, 252780], [32, 253040], [37, 253320], [40, 253560], [49, 254000], [51, 254600], [54, 254720], [59, 254920], [62, 255180], [68, 255500], [70, 255775], [73, 255895], [78, 256155], [81, 256415], [88, 256795], [90, 257315], [93, 257435], [99, 257715], [103, 257975], [112, 258995], [117, 259258], [120, 259518], [123, 259678], [133, 260258]]}, {"verse": 31, "start": 261777, "end": 269670, "text": "Y el segundo es semejante a él: Amarás a tu prójimo como a ti mismo. No hay otro mandamiento mayor que estos.", "words": [[0, 261777], [2, 261922], [5, 262042], [13, 262462], [16, 262802], [26, 263502], [28, 263702], [32, 264346], [39, 264831], [41, 264931], [44, 265071], [52, 265691], [57, 265971], [59, 266131], [62, 266251], [69, 267054], [72, 267261], [76, 267481], [81, 267741], [93, 268421], [99, 268801], [103, 269061]]}, {"verse": 32, "start": 270020, "end": 276698, "text": "Entonces el escriba le dijo: Bien, Maestro, verdad has dicho, que uno es Dios, y no hay otro fuera de él;", "words": [[0, 270020], [9, 270543], [12, 270923], [20, 271423], [23, 271543], [29, 272248], [35, 272504], [44, 273144], [51, 273484], [55, 273584], [62, 273864], [66, 274144], [70, 274344], [73, 274584], [79, 274824], [81, 275404], [84, 275544], [88, 275704], [93, 275924], [99, 276204], [102, 276444]]}, {"verse": 33, "start": 277048, "end": 287879, "text": "Y que amarle de todo corazón, y de todo entendimiento, y de toda el alma, y de todas las fuerzas, y amar al prójimo como a sí mismo, más es que todos los holocaustos y sacrificios.", "words": [[0, 277048], [2, 277153], [6, 277253], [13, 277653], [16, 277773], [21, 277953], [30, 278493], [32, 278973], [35, 279073], [40, 279273], [55, 280193], [57, 280493], [60, 280613], [65, 280773], [68, 280993], [74, 281253], [76, 281613], [79, 281733], [85, 281913], [89, 282153], [98, 282560], [100, 282966], [105, 283373], [108, 283473], [116, 283993], [121, 284213], [123, 284373], [126, 284433], [133, 285200], [137, 285437], [140, 285577], [144, 285697], [150, 285917], [154, 286177], [166, 286877], [168, 286977]]}, {"verse": 34, "start": 288159, "end": 299279, "text": "Jesús entonces, viendo que había respondido sabiamente, le dice: No estás lejos del reino de Dios. Y ya ninguno se atrevía a preguntarle.", "words": [[0, 288159], [6, 288502], [16, 289942], [23, 290382], [27, 290642], [33, 290942], [44, 291762], [56, 292922], [59, 293002], [65, 293787], [68, 293972], [74, 294212], [80, 294752], [84, 295012], [90, 295472], [93, 295672], [99, 296491], [101, 296777], [104, 296917], [112, 297457], [115, 297657], [123, 298137], [125, 298277]]}, {"verse": 35, "start": 299629, "end": 306857, "text": "Y respondiendo Jesús decía, enseñando en el templo: ¿Cómo dicen los escribas que el Cristo es hijo de David?", "words": [[0, 299629], [2, 299754], [15, 300514], [21, 300854], [28, 301754], [38, 302494], [41, 302634], [44, 302774], [52, 303761], [58, 303948], [64, 304288], [68, 304528], [77, 305148], [81, 305288], [84, 305428], [91, 305808], [94, 306008], [99, 306248], [102, 306428]]}, {"verse": 36, "start": 307207, "end": 317055, "text": "Porque el mismo David dijo por el Espíritu Santo: Dijo el Señor a mi Señor: Siéntate a mi derecha, hasta que ponga tus enemigos por estrado de tus pies.", "words": [[0, 307207], [7, 307412], [10, 307572], [16, 307852], [22, 308312], [27, 308832], [31, 309192], [34, 309332], [43, 309852], [50, 310734], [55, 311123], [58, 311323], [64, 311603], [66, 311863], [69, 311943], [76, 312774], [85, 313276], [87, 313376], [90, 313436], [99, 313856], [105, 314016], [109, 314176], [115, 314616], [119, 314756], [128, 315296], [132, 315516], [140, 316056], [143, 316216], [147, 316376]]}, {"verse": 37, "start": 317405, "end": 325090, "text": "Luego llamándole el mismo David Señor, ¿cómo, pues, es su hijo? Y la gente común lo oía con agrado.", "words": [[0, 317454], [6, 318030], [17, 318810], [20, 319150], [26, 319470], [32, 319770], [39, 320645], [46, 320925], [52, 321345], [55, 321765], [58, 321965], [64, 322681], [66, 322769], [69, 322869], [75, 323129], [81, 323469], [84, 323769], [88, 324249], [92, 324469]]}, {"verse": 38, "start": 325440, "end": 335103, "text": "Y les decía en su enseñanza: Guardaos de los escribas, que quieren andar con ropas largas, y aman los saludos en las plazas,", "words": [[0, 325440], [2, 325564], [6, 325704], [12, 326164], [15, 326344], [18, 326484], [29, 327865], [38, 328135], [41, 328315], [45, 328415], [55, 329095], [59, 329655], [67, 330015], [73, 330375], [77, 330635], [83, 331055], [91, 331755], [93, 332575], [98, 332815], [102, 333455], [110, 334075], [113, 334215], [117, 334375]]}, {"verse": 39, "start": 335453, "end": 341474, "text": "Y los asientos principales en las sinagogas, y los lugares de honor en los banquetes;", "words": [[0, 335453], [2, 335598], [6, 335718], [15, 336178], [27, 337138], [30, 337358], [34, 337518], [45, 338358], [47, 338938], [51, 339098], [59, 339478], [62, 339718], [68, 339998], [71, 340458], [75, 340598]]}, {"verse": 40, "start": 341824, "end": 349960, "text": "Que devoran las casas de las viudas, y para aparentar hacen largas oraciones. Estos recibirán mayor juicio.", "words": [[0, 341824], [4, 341906], [12, 342386], [16, 342566], [22, 343006], [25, 343106], [29, 343226], [37, 343786], [39, 344146], [44, 344386], [54, 345346], [60, 345646], [67, 346226], [78, 347412], [84, 348071], [94, 348931], [100, 349211]]}, {"verse": 41, "start": 350310, "end": 359732, "text": "Y estando sentado Jesús delante del tesoro del templo, miraba cómo el pueblo echaba dinero en el tesoro: y muchos ricos echaban mucho.", "words": [[0, 350310], [2, 350430], [10, 350990], [18, 351610], [24, 351930], [32, 352590], [36, 352830], [43, 353310], [47, 353450], [55, 354370], [62, 354790], [67, 355110], [70, 355330], [77, 355570], [84, 356090], [91, 356470], [94, 356690], [97, 356810], [105, 357755], [107, 357876], [114, 358266], [120, 358656], [128, 359096]]}, {"verse": 42, "start": 360082, "end": 367698, "text": "Y cuando vino una viuda pobre, echó dos monedas pequeñas de cobre, que equivalen a un cuadrante romano.", "words": [[0, 360082], [2, 360187], [9, 360407], [14, 360747], [18, 360987], [24, 361347], [31, 362027], [36, 362687], [40, 363047], [48, 363627], [57, 364247], [60, 364347], [67, 364847], [71, 365307], [81, 366087], [83, 366247], [86, 366367], [96, 366947]]}, {"verse": 43, "start": 368048, "end": 376843, "text": "Entonces llamando a sus discípulos, les dice: De cierto os digo que esta viuda pobre echó más que todos los que han echado en el arca:", "words": [[0, 368048], [9, 368968], [18, 369368], [20, 369448], [24, 369628], [36, 370308], [40, 370448], [46, 371393], [49, 371607], [56, 371820], [59, 372020], [64, 372360], [68, 372620], [73, 372920], [79, 373340], [85, 373720], [90, 374100], [94, 374360], [98, 374580], [104, 374900], [108, 375200], [112, 375380], [116, 375560], [123, 375980], [126, 376120], [129, 376280]]}, {"verse": 44, "start": 377193, "end": 385017, "text": "Porque todos han echado de lo que les sobra; pero esta, aun en su pobreza, echó todo lo que tenía para vivir.", "words": [[0, 377193], [7, 377437], [13, 377797], [17, 378177], [24, 378737], [27, 379197], [30, 379337], [34, 379457], [38, 379597], [45, 380526], [50, 380671], [56, 381011], [60, 381371], [63, 381571], [66, 381731], [75, 382391], [80, 383131], [85, 383471], [88, 383711], [92, 383831], [98, 384171], [103, 384391]]}]}