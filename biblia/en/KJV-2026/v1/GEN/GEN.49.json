{"book": "GEN", "chapter": 49, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 227922, "verses": [{"verse": 1, "start": 300, "end": 7576, "text": "And Jacob called to his sons, and said, Gather yourselves together, that I may tell you that which shall befall you in the last days.", "words": [[0, 300], [4, 412], [10, 692], [17, 1092], [20, 1312], [24, 1492], [30, 1852], [34, 2312], [40, 3021], [47, 3402], [58, 3842], [68, 4262], [73, 4502], [75, 4642], [79, 4742], [84, 5022], [88, 5222], [93, 5402], [99, 5622], [105, 5882], [112, 6262], [116, 6422], [119, 6582], [123, 6682], [128, 6982]]}, {"verse": 2, "start": 7926, "end": 12992, "text": "Gather yourselves together, and hear, you sons of Jacob; and hearken to Israel your father.", "words": [[0, 7926], [7, 8223], [18, 8623], [28, 9043], [32, 9363], [38, 9683], [42, 10103], [47, 10363], [50, 10543], [57, 11273], [61, 11506], [69, 11776], [72, 11956], [79, 12456], [84, 12536]]}, {"verse": 3, "start": 13342, "end": 20485, "text": "¶ Reuben, you are my firstborn, my might, and the beginning of my strength, the excellency of dignity, and the excellency of power:", "words": [[2, 13536], [10, 13766], [14, 13906], [18, 14006], [21, 14166], [32, 15086], [35, 15206], [42, 15866], [46, 15926], [50, 16046], [60, 16326], [63, 16526], [66, 16706], [76, 17466], [80, 17546], [91, 18086], [94, 18246], [103, 18626], [107, 19146], [111, 19266], [122, 19806], [125, 19986]]}, {"verse": 4, "start": 20835, "end": 27860, "text": "Unstable as water, you shall not excel; because you went up to your father’s bed; then you defiled it: he went up to my couch.", "words": [[0, 20835], [9, 21337], [12, 21577], [19, 22177], [23, 22257], [29, 22457], [33, 22677], [40, 23394], [48, 23611], [52, 23831], [57, 23951], [60, 24151], [63, 24291], [68, 24411], [77, 24851], [82, 25376], [87, 25552], [91, 25712], [99, 26092], [103, 26565], [106, 26673], [111, 26833], [114, 27033], [117, 27193], [120, 27333]]}, {"verse": 5, "start": 28210, "end": 32337, "text": "¶ Simeon and Levi are brethren; instruments of cruelty are in their habitations.", "words": [[2, 28210], [9, 28676], [13, 28796], [18, 29016], [22, 29216], [32, 30045], [44, 30545], [47, 30685], [55, 31085], [59, 31265], [62, 31385], [68, 31485]]}, {"verse": 6, "start": 32687, "end": 43469, "text": "O my soul, come not you into their secret; to their assembly, my honour, be not you united: for in their anger they killed a man, and in their selfwill they dug down a wall.", "words": [[0, 32817], [2, 32947], [5, 33027], [11, 33507], [16, 33607], [20, 33867], [24, 34107], [29, 34387], [35, 34607], [43, 35331], [46, 35435], [52, 35615], [62, 36174], [65, 36535], [73, 36895], [76, 36994], [80, 37215], [84, 37575], [92, 38620], [96, 38752], [99, 38952], [105, 39172], [111, 39652], [116, 39899], [123, 40145], [125, 40392], [130, 40892], [134, 41152], [137, 41292], [143, 41712], [152, 42132], [157, 42372], [161, 42592], [166, 42912], [168, 43052]]}, {"verse": 7, "start": 43819, "end": 51282, "text": "Cursed be their anger, for it was fierce; and their wrath, for it was cruel: I will divide them in Jacob, and scatter them in Israel.", "words": [[0, 43819], [7, 44056], [10, 44336], [16, 44536], [23, 44916], [27, 45176], [30, 45316], [34, 45496], [42, 46279], [46, 46403], [52, 46603], [59, 46983], [63, 47283], [66, 47423], [70, 47563], [77, 48371], [79, 48511], [84, 48651], [91, 48971], [96, 49271], [99, 49391], [106, 49751], [110, 50131], [118, 50391], [123, 50651], [126, 50771]]}, {"verse": 8, "start": 51632, "end": 59622, "text": "¶ Judah, you are he whom your brethren shall praise: your hand shall be in the neck of your enemies; your father’s children shall bow down before you.", "words": [[2, 51632], [9, 51838], [13, 52058], [17, 52638], [20, 52758], [25, 52998], [30, 53158], [39, 53538], [45, 53878], [53, 54785], [58, 54912], [63, 55252], [69, 55492], [72, 55672], [75, 55792], [79, 55892], [84, 56112], [87, 56272], [92, 56412], [101, 57327], [106, 57415], [115, 57835], [124, 58135], [130, 58355], [134, 58615], [139, 58935], [146, 59235]]}, {"verse": 9, "start": 59972, "end": 67977, "text": "Judah is a lion’s whelp: from the prey, my son, you are gone up: he stooped down, he couched as a lion, and as an old lion; who shall rouse him up?", "words": [[0, 59972], [6, 60233], [9, 60513], [11, 60653], [18, 61028], [25, 61582], [30, 61682], [34, 61942], [40, 62202], [43, 62302], [48, 62702], [52, 62782], [56, 62942], [61, 63142], [65, 63672], [68, 63812], [76, 63992], [82, 64372], [85, 64372], [93, 64812], [96, 64892], [98, 65012], [104, 65232], [108, 65692], [111, 65852], [114, 65972], [118, 66132], [124, 66832], [128, 66916], [134, 67136], [140, 67496], [144, 67636]]}, {"verse": 10, "start": 68327, "end": 76836, "text": "The sceptre shall not depart from Judah, nor a lawgiver from between his feet, until Shiloh come; and to him shall the gathering of the people be.", "words": [[0, 68327], [4, 68588], [12, 68868], [18, 69128], [22, 69308], [29, 69648], [34, 69908], [41, 70568], [45, 70728], [47, 70888], [56, 71348], [61, 71568], [69, 71848], [73, 72128], [79, 72668], [85, 72928], [92, 73488], [98, 74068], [102, 74197], [105, 74357], [109, 74657], [115, 75117], [119, 75277], [129, 75677], [132, 75957], [136, 76097], [143, 76417]]}, {"verse": 11, "start": 77186, "end": 84330, "text": "Binding his foal to the vine, and his donkey’s colt to the choice vine; he washed his garments in wine, and his clothes in the blood of grapes:", "words": [[0, 77186], [8, 77531], [12, 77751], [17, 77971], [20, 78131], [24, 78251], [30, 78951], [34, 79011], [38, 79111], [47, 79451], [52, 79791], [55, 80011], [59, 80131], [66, 80371], [72, 81010], [75, 81081], [82, 81361], [86, 81521], [95, 81801], [98, 82041], [104, 82361], [108, 82591], [112, 82821], [120, 83051], [123, 83281], [127, 83461], [133, 83621], [136, 83761]]}, {"verse": 12, "start": 84680, "end": 88078, "text": "His eyes shall be red with wine, and his teeth white with milk.", "words": [[0, 84680], [4, 84781], [9, 85121], [15, 85361], [18, 85521], [22, 85801], [27, 86001], [33, 86561], [37, 86861], [41, 86981], [47, 87181], [53, 87481], [58, 87661]]}, {"verse": 13, "start": 88428, "end": 94599, "text": "¶ Zebulun shall dwell at the haven of the sea; and he shall be for a haven of ships; and his border shall be to Zidon.", "words": [[2, 88428], [10, 89004], [16, 89224], [22, 89464], [25, 89664], [29, 89764], [35, 89984], [38, 90184], [42, 90284], [47, 90914], [51, 91019], [54, 91079], [60, 91239], [63, 91479], [67, 91589], [69, 91699], [75, 91979], [78, 92159], [85, 92964], [89, 93088], [93, 93208], [100, 93448], [106, 93688], [109, 93868], [112, 94258]]}, {"verse": 14, "start": 94949, "end": 97975, "text": "¶ Issachar is a strong donkey couching down between two burdens:", "words": [[2, 95120], [11, 95330], [14, 95490], [16, 95610], [23, 95930], [30, 96310], [39, 96770], [44, 96970], [52, 97210], [56, 97450]]}, {"verse": 15, "start": 98325, "end": 104229, "text": "And he saw that rest was good, and the land that it was pleasant; and bowed his shoulder to bear, and became a servant to tribute.", "words": [[0, 98325], [4, 98427], [7, 98507], [11, 98707], [16, 98887], [21, 99087], [25, 99247], [31, 99507], [35, 99807], [39, 99907], [44, 100107], [49, 100227], [52, 100327], [56, 100467], [66, 101175], [70, 101322], [76, 101662], [80, 101722], [89, 102002], [92, 102242], [98, 102502], [102, 102902], [109, 103142], [111, 103302], [119, 103542], [122, 103702]]}, {"verse": 16, "start": 104579, "end": 107754, "text": "¶ Dan shall judge his people, as one of the tribes of Israel.", "words": [[2, 104579], [6, 104758], [12, 105038], [18, 105398], [22, 105558], [30, 105978], [33, 106398], [37, 106578], [40, 106698], [44, 106798], [51, 107058], [54, 107258]]}, {"verse": 17, "start": 108104, "end": 113905, "text": "Dan shall be a serpent by the way, an adder in the path, that bites the horse heels, so that his rider shall fall backward.", "words": [[0, 108104], [4, 108322], [10, 108582], [13, 108782], [15, 108882], [23, 109202], [26, 109462], [30, 109602], [35, 109822], [38, 110042], [44, 110382], [47, 110482], [51, 110562], [57, 110862], [62, 111102], [68, 111382], [72, 111622], [78, 111822], [85, 112162], [88, 112402], [93, 112542], [97, 112642], [103, 112862], [109, 113122], [114, 113362]]}, {"verse": 18, "start": 114255, "end": 116438, "text": "I have waited for your salvation, O LORD.", "words": [[0, 114255], [2, 114418], [7, 114598], [14, 114858], [18, 115098], [23, 115238], [34, 115978], [36, 116078]]}, {"verse": 19, "start": 116788, "end": 120670, "text": "¶ Gad, a troop shall overcome him: but he shall overcome at the last.", "words": [[2, 116941], [7, 117096], [9, 117251], [15, 117406], [21, 117666], [30, 118106], [35, 118799], [39, 118898], [42, 119098], [48, 119298], [57, 119778], [60, 120038], [64, 120158]]}, {"verse": 20, "start": 121020, "end": 125027, "text": "¶ Out of Asher his bread shall be fat, and he shall yield royal dainties.", "words": [[2, 121020], [6, 121164], [9, 121304], [15, 121824], [19, 121944], [25, 122164], [31, 122404], [34, 122564], [39, 123204], [43, 123284], [46, 123464], [52, 123684], [58, 123924], [64, 124284]]}, {"verse": 21, "start": 125377, "end": 128704, "text": "¶ Naphtali is a hind let loose: he gives goodly words.", "words": [[2, 125614], [11, 125884], [14, 126224], [16, 126344], [21, 126584], [25, 126744], [32, 127517], [35, 127577], [41, 127757], [48, 128157]]}, {"verse": 22, "start": 129054, "end": 134214, "text": "¶ Joseph is a fruitful bough, even a fruitful bough by a well; whose branches run over the wall:", "words": [[2, 129054], [9, 129276], [12, 129496], [14, 129596], [23, 130096], [30, 130596], [35, 130716], [37, 130876], [46, 131236], [52, 131596], [55, 131856], [57, 131956], [63, 132629], [69, 132727], [78, 133167], [82, 133447], [87, 133627], [91, 133747]]}, {"verse": 23, "start": 134564, "end": 138282, "text": "The archers have sorely grieved him, and shot at him, and hated him:", "words": [[0, 134564], [4, 134696], [12, 135156], [17, 135356], [24, 135816], [32, 136176], [37, 136336], [41, 136776], [46, 137076], [49, 137236], [54, 137416], [58, 137696], [64, 137936]]}, {"verse": 24, "start": 138632, "end": 147546, "text": "But his bow remained in strength, and the arms of his hands were made strong by the hands of the mighty God of Jacob; (from there is the shepherd, the stone of Israel:)", "words": [[0, 138632], [4, 138753], [8, 138853], [12, 139093], [21, 139533], [24, 139733], [34, 140093], [38, 140533], [42, 140633], [47, 140933], [50, 141073], [54, 141193], [60, 141473], [65, 141653], [70, 141833], [77, 142193], [80, 142433], [84, 142553], [90, 142793], [93, 142933], [97, 143053], [104, 143313], [108, 143653], [111, 143773], [118, 144513], [124, 144635], [130, 144895], [133, 145095], [137, 145235], [147, 145875], [151, 145995], [157, 146335], [160, 146495]]}, {"verse": 25, "start": 147896, "end": 158635, "text": "Even by the God of your father, who shall help you; and by the Almighty, who shall bless you with blessings of heaven above, blessings of the deep that lies under, blessings of the breasts, and of the womb:", "words": [[0, 147896], [5, 148112], [8, 148332], [12, 148432], [16, 148692], [19, 148832], [24, 148932], [32, 149252], [36, 149592], [42, 149772], [47, 150032], [52, 150463], [56, 150568], [59, 150748], [63, 150888], [73, 151748], [77, 152028], [83, 152208], [89, 152448], [93, 152688], [98, 152848], [108, 153128], [111, 153368], [118, 153608], [125, 154408], [135, 154728], [138, 155048], [142, 155168], [147, 155388], [152, 155608], [157, 155808], [164, 156488], [174, 156848], [177, 157148], [181, 157268], [190, 157628], [194, 157968], [197, 158068], [201, 158188]]}, {"verse": 26, "start": 158985, "end": 170785, "text": "The blessings of your father have prevailed above the blessings of my progenitors to the utmost bound of the everlasting hills: they shall be on the head of Joseph, and on the crown of the head of him that was separate from his brethren.", "words": [[0, 158985], [4, 159083], [14, 159363], [17, 159623], [22, 159743], [29, 160043], [34, 160303], [44, 160843], [50, 161143], [54, 161383], [64, 161703], [67, 161983], [70, 162143], [82, 162783], [85, 163003], [89, 163123], [96, 163403], [102, 163863], [105, 164063], [109, 164203], [121, 164563], [128, 165575], [133, 165695], [139, 165895], [142, 166075], [145, 166235], [149, 166355], [154, 166515], [157, 166635], [165, 167055], [169, 167675], [172, 167775], [176, 167895], [182, 168175], [185, 168355], [189, 168475], [194, 168655], [197, 168795], [201, 169015], [206, 169295], [210, 169455], [219, 169835], [224, 170075], [228, 170235]]}, {"verse": 27, "start": 171135, "end": 177197, "text": "¶ Benjamin shall ravin as a wolf: in the morning he shall devour the prey, and at night he shall divide the spoil.", "words": [[2, 171135], [11, 171512], [17, 171902], [23, 172292], [26, 172512], [28, 172612], [34, 173165], [37, 173319], [41, 173419], [49, 173699], [52, 173939], [58, 174159], [65, 174639], [69, 174779], [75, 175219], [79, 175479], [82, 175599], [88, 175819], [91, 176059], [97, 176219], [104, 176519], [108, 176719]]}, {"verse": 28, "start": 177477, "end": 187252, "text": "¶ All these are the twelve tribes of Israel: and this is it that their father spoke to them, and blessed them; every one according to his blessing he blessed them.", "words": [[2, 177477], [6, 177667], [12, 177947], [16, 178207], [20, 178347], [27, 178707], [34, 179167], [37, 179487], [45, 180303], [49, 180448], [54, 180648], [57, 180828], [60, 180968], [65, 181168], [71, 181328], [78, 181668], [84, 182048], [87, 182328], [93, 182588], [97, 183128], [105, 183448], [111, 184288], [117, 184422], [121, 184555], [131, 184955], [134, 185275], [138, 185495], [147, 186255], [150, 186395], [158, 186735]]}, {"verse": 29, "start": 187602, "end": 196253, "text": "And he charged them, and said to them, I am to be gathered to my people: bury me with my fathers in the cave that is in the field of Ephron the Hittite,", "words": [[0, 187602], [4, 187734], [7, 187854], [15, 188274], [21, 188614], [25, 188854], [30, 189174], [33, 189354], [39, 190589], [41, 190751], [44, 190851], [47, 190991], [50, 191091], [59, 191451], [62, 191691], [65, 191811], [73, 192466], [78, 192751], [81, 192871], [86, 193051], [89, 193231], [97, 193711], [100, 193811], [104, 193911], [109, 194151], [114, 194351], [117, 194491], [120, 194611], [124, 194711], [130, 194991], [133, 195131], [140, 195531], [144, 195671]]}, {"verse": 30, "start": 196603, "end": 207313, "text": "In the cave that is in the field of Machpelah, which is before Mamre, in the land of Canaan, which Abraham bought with the field of Ephron the Hittite for a possession of a buryingplace.", "words": [[0, 196603], [3, 196764], [7, 196864], [12, 197204], [17, 197424], [20, 197564], [23, 197724], [27, 197804], [33, 198084], [36, 198654], [47, 199224], [53, 199364], [56, 199484], [63, 199904], [70, 200404], [73, 200824], [77, 200944], [82, 201184], [85, 201344], [93, 202142], [99, 202304], [107, 202724], [114, 203144], [119, 203364], [123, 203534], [129, 203704], [132, 203864], [139, 204324], [143, 204614], [151, 204904], [155, 205344], [157, 205464], [168, 205844], [171, 206224], [173, 206799]]}, {"verse": 31, "start": 207663, "end": 214681, "text": "There they buried Abraham and Sarah his wife; there they buried Isaac and Rebekah his wife; and there I buried Leah.", "words": [[0, 207663], [6, 208087], [11, 208147], [18, 208467], [26, 208967], [30, 209247], [36, 209647], [40, 209727], [46, 210316], [52, 210572], [57, 210772], [64, 211092], [70, 211552], [74, 211932], [82, 212312], [86, 212392], [92, 213007], [96, 213240], [102, 213474], [104, 213707], [111, 214107]]}, {"verse": 32, "start": 215031, "end": 218756, "text": "The purchase of the field and of the cave that is in it was from the children of Heth.", "words": [[0, 215031], [4, 215135], [13, 215515], [16, 215735], [20, 215855], [26, 216195], [30, 216355], [33, 216455], [37, 216615], [42, 216835], [47, 217035], [50, 217175], [53, 217315], [56, 217415], [60, 217575], [65, 217795], [69, 217895], [78, 218255], [81, 218455]]}, {"verse": 33, "start": 219036, "end": 227522, "text": "And when Jacob had made an end of commanding his sons, he gathered up his feet into the bed, and breathed his last, and was gathered to his people.", "words": [[0, 219036], [4, 219149], [9, 219289], [15, 219589], [19, 219869], [24, 220049], [27, 220229], [31, 220529], [34, 220649], [45, 221189], [49, 221329], [55, 222189], [58, 222289], [67, 222629], [70, 222849], [74, 223049], [79, 223329], [84, 223649], [88, 223829], [93, 224489], [97, 224549], [106, 225029], [110, 225169], [116, 226009], [120, 226089], [124, 226249], [133, 226589], [136, 226829], [140, 226989]]}]}