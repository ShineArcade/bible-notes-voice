{"book": "LUK", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 372697, "verses": [{"verse": 1, "start": 300, "end": 12286, "text": "Y después de estas cosas, designó el Señor aun otros setenta, los cuales envió de dos en dos delante de sí, a toda ciudad y lugar a donde él había de venir.", "words": [[0, 300], [2, 419], [10, 699], [13, 939], [19, 1119], [26, 2299], [34, 2859], [37, 2999], [43, 3459], [47, 3919], [53, 4379], [62, 5579], [66, 5699], [73, 5979], [79, 6659], [82, 6779], [86, 7079], [89, 7379], [93, 7619], [101, 8159], [104, 8339], [108, 9010], [110, 9210], [115, 9430], [122, 9890], [124, 10310], [130, 10670], [132, 10910], [138, 11170], [141, 11410], [147, 11630], [150, 11830]]}, {"verse": 2, "start": 12736, "end": 23458, "text": "Y les decía: La cosecha a la verdad es mucha, pero los obreros pocos; por tanto, rogad al Señor de la cosecha que envíe obreros a su cosecha.", "words": [[0, 12736], [2, 12906], [6, 12986], [13, 13973], [16, 14082], [24, 14642], [26, 14822], [29, 14882], [36, 15142], [39, 15402], [46, 16142], [51, 16302], [55, 16482], [63, 16902], [70, 17941], [74, 18067], [81, 18857], [87, 19647], [90, 19887], [96, 20267], [99, 20507], [102, 20627], [110, 21147], [114, 21307], [120, 21847], [128, 22487], [130, 22607], [133, 22727]]}, {"verse": 3, "start": 23908, "end": 28538, "text": "Andad, he aquí yo os envío como corderos en medio de lobos.", "words": [[0, 23908], [7, 24397], [10, 24917], [15, 25077], [18, 25377], [21, 25657], [27, 26217], [32, 26707], [41, 27197], [44, 27377], [50, 27697], [53, 27877]]}, {"verse": 4, "start": 28988, "end": 34550, "text": "No llevéis bolsa, ni alforja, ni calzado; y a nadie saludéis en el camino.", "words": [[0, 28988], [3, 29423], [11, 29923], [18, 30423], [21, 30583], [30, 31203], [33, 31323], [42, 32562], [44, 32674], [46, 32734], [52, 33224], [61, 33714], [64, 33854], [67, 33974]]}, {"verse": 5, "start": 35000, "end": 40587, "text": "En cualquier casa donde entréis, primeramente decid: Paz sea a esta casa.", "words": [[0, 35000], [3, 35150], [13, 35410], [18, 35950], [24, 36250], [33, 37250], [46, 37993], [53, 39130], [57, 39324], [61, 39517], [63, 39737], [68, 39957]]}, {"verse": 6, "start": 41037, "end": 48756, "text": "Y si hay allí algún hijo de paz, vuestra paz reposará sobre él; y si no, se volverá a vosotros.", "words": [[0, 41037], [2, 41159], [5, 41279], [9, 41479], [14, 41759], [20, 42019], [25, 42239], [28, 42419], [33, 43179], [41, 43559], [45, 43859], [54, 44879], [60, 45199], [64, 46067], [66, 46292], [69, 46432], [73, 46972], [76, 47172], [84, 47772], [86, 47912]]}, {"verse": 7, "start": 49206, "end": 59370, "text": "Y posad en aquella misma casa, comiendo y bebiendo lo que os den; porque el obrero digno es de su salario. No os paséis de casa en casa.", "words": [[0, 49206], [2, 49331], [8, 49951], [11, 50251], [19, 50591], [25, 50811], [31, 51651], [40, 52311], [42, 52451], [51, 52911], [54, 53091], [58, 53231], [61, 53351], [66, 54118], [73, 54382], [76, 54722], [83, 55122], [89, 55642], [92, 55782], [95, 55902], [98, 56062], [107, 57267], [110, 57457], [113, 57647], [120, 57837], [123, 58257], [128, 58517], [131, 58757]]}, {"verse": 8, "start": 59820, "end": 65593, "text": "Y en cualquier ciudad donde entréis y os reciban, comed lo que os pongan delante;", "words": [[0, 59820], [2, 59965], [5, 60105], [15, 60385], [22, 61025], [28, 61425], [36, 62125], [38, 62365], [41, 62485], [50, 63565], [56, 63925], [59, 64145], [63, 64285], [66, 64425], [73, 64825]]}, {"verse": 9, "start": 66043, "end": 72994, "text": "Y sanad los enfermos que en ella haya, y decidles: Se ha llegado a vosotros el reino de Dios.", "words": [[0, 66043], [2, 66289], [8, 66569], [12, 66849], [21, 67129], [25, 67409], [28, 67689], [33, 67969], [39, 68249], [41, 68589], [51, 70182], [54, 70472], [57, 70652], [65, 71092], [67, 71192], [76, 71632], [79, 71892], [85, 72292], [88, 72452]]}, {"verse": 10, "start": 73444, "end": 79012, "text": "Pero en cualquier ciudad donde entréis y no os reciban, saliendo por sus calles, decid:", "words": [[0, 73444], [5, 73607], [8, 73747], [18, 74087], [25, 74667], [31, 75027], [39, 75807], [41, 76067], [44, 76267], [47, 76447], [56, 77047], [65, 77967], [69, 78167], [73, 78387], [81, 78730]]}, {"verse": 11, "start": 79462, "end": 91391, "text": "Aun el polvo que se nos ha pegado de vuestra ciudad a nuestros pies, sacudimos en vosotros: Pero esto sabed, que el reino de los cielos se ha llegado a vosotros.", "words": [[0, 80365], [4, 80565], [7, 80785], [13, 81325], [17, 81445], [20, 81605], [24, 81745], [27, 81925], [34, 82465], [37, 82625], [45, 82965], [52, 83365], [54, 83665], [63, 83825], [69, 84595], [79, 85365], [82, 85565], [92, 86632], [97, 86795], [102, 87135], [109, 87475], [113, 87775], [116, 87955], [122, 88395], [125, 88535], [129, 88695], [136, 89395], [139, 89835], [142, 89995], [150, 90435], [152, 90555]]}, {"verse": 12, "start": 91841, "end": 98322, "text": "Y os digo que el juicio será más llevadero para los de Sodoma aquel día que para aquella ciudad.", "words": [[0, 91841], [2, 91968], [5, 92088], [10, 92288], [14, 92528], [17, 92648], [24, 93068], [29, 93348], [33, 93688], [43, 94448], [48, 94708], [52, 94948], [55, 95168], [62, 95748], [68, 96208], [72, 96468], [76, 96908], [81, 97188], [89, 97588]]}, {"verse": 13, "start": 98772, "end": 113941, "text": "¡Ay de ti, Corazín! ¡Ay de ti, Betsaida! que si en Tiro y en Sidón hubieran sido hechas las maravillas que se han hecho en vosotras, hace ya tiempo que, sentados en cilicio y ceniza, se habrían arrepentido.", "words": [[0, 98887], [4, 99036], [7, 99236], [11, 99794], [20, 100852], [24, 101150], [27, 101448], [31, 101747], [41, 102284], [45, 102385], [48, 102605], [51, 102785], [56, 103165], [58, 103425], [61, 103565], [67, 104325], [76, 104905], [81, 105205], [88, 105545], [92, 105725], [103, 106285], [107, 106465], [110, 106605], [114, 106745], [120, 106945], [123, 107105], [133, 107985], [138, 108385], [141, 108605], [148, 108985], [153, 109345], [162, 110265], [165, 110685], [173, 111105], [175, 111265], [183, 111785], [186, 112325], [194, 112805]]}, {"verse": 14, "start": 114391, "end": 119154, "text": "Por tanto, el juicio será más llevadero para Tiro y Sidón que para vosotras.", "words": [[0, 114391], [4, 114518], [11, 114938], [14, 115038], [21, 115478], [26, 115758], [30, 116118], [40, 116838], [45, 117078], [50, 117438], [52, 117578], [58, 117958], [62, 118078], [67, 118338]]}, {"verse": 15, "start": 119604, "end": 126183, "text": "Y tú, Capernaum, que hasta los cielos estás levantada, hasta los infiernos serás abatida.", "words": [[0, 119604], [2, 119887], [6, 120087], [17, 121207], [21, 121427], [27, 121607], [31, 121827], [38, 122147], [44, 122467], [55, 123567], [61, 123787], [65, 123987], [75, 124807], [81, 125367]]}, {"verse": 16, "start": 126633, "end": 136431, "text": "El que a vosotros oye, a mí oye; y el que a vosotros desecha, a mí desecha; y el que a mí desecha, desecha al que me envió.", "words": [[0, 126633], [3, 126770], [7, 126910], [9, 127010], [18, 127450], [23, 127870], [25, 128050], [28, 128230], [33, 129096], [35, 129226], [38, 129366], [42, 129526], [44, 129666], [53, 130326], [62, 130986], [64, 131266], [67, 131926], [76, 132844], [78, 133135], [81, 133255], [85, 133415], [87, 133555], [90, 133695], [99, 134735], [107, 135475], [110, 135595], [114, 135735], [117, 135895]]}, {"verse": 17, "start": 136881, "end": 146141, "text": "Y volvieron los setenta con gozo, diciendo: Señor, aun los demonios se nos sujetan en tu nombre.", "words": [[0, 136881], [2, 137005], [12, 137485], [16, 137785], [24, 138085], [28, 138465], [34, 139065], [44, 140691], [51, 141591], [55, 141791], [59, 141991], [68, 142511], [71, 142631], [75, 142731], [83, 143231], [86, 143331], [89, 143451]]}, {"verse": 18, "start": 146491, "end": 151729, "text": "Y les dijo: Yo veía a Satanás, como un rayo, que caía del cielo.", "words": [[0, 146491], [2, 146635], [6, 146950], [12, 147512], [15, 147703], [20, 148163], [22, 148363], [31, 149063], [36, 149443], [39, 149623], [45, 150163], [49, 150483], [54, 150883], [58, 151063]]}, {"verse": 19, "start": 152179, "end": 161748, "text": "He aquí os doy potestad de pisar sobre las serpientes y sobre los escorpiones, y sobre toda fuerza del enemigo, y nada os dañará.", "words": [[0, 152179], [3, 152345], [8, 152605], [11, 152785], [15, 153085], [24, 153745], [27, 153905], [33, 154365], [39, 154625], [43, 154865], [54, 155565], [56, 155785], [62, 156025], [66, 156245], [79, 157025], [81, 157705], [87, 157925], [92, 158205], [99, 158605], [103, 158925], [112, 159665], [114, 160225], [119, 160505], [122, 160905]]}, {"verse": 20, "start": 162198, "end": 171209, "text": "Pero no os gocéis de esto, que los espíritus se os sujetan; sino gozaos de que vuestros nombres están escritos en los cielos.", "words": [[0, 162198], [5, 162367], [8, 162627], [11, 162867], [18, 163407], [21, 163567], [27, 163947], [31, 164547], [35, 164687], [45, 165427], [48, 165547], [51, 165647], [60, 166765], [65, 167063], [72, 168103], [75, 168483], [79, 168603], [88, 169003], [96, 169463], [102, 169743], [111, 170243], [114, 170463], [118, 170603]]}, {"verse": 21, "start": 171659, "end": 190160, "text": "En aquella misma hora Jesús se alegró en espíritu, y dijo: Yo te alabo, oh Padre, Señor del cielo y de la tierra, que escondiste estas cosas a los sabios y entendidos, y las has revelado a los pequeños: así, Padre, porque así te agradó.", "words": [[0, 171659], [3, 171974], [11, 172334], [17, 172554], [22, 172894], [28, 173334], [31, 173794], [38, 174234], [41, 174354], [51, 175334], [53, 175394], [59, 176295], [62, 176429], [65, 176562], [72, 177062], [75, 177162], [82, 177922], [88, 178282], [92, 178622], [98, 179042], [100, 179262], [103, 179382], [106, 179502], [114, 180442], [118, 180582], [129, 181422], [135, 181702], [141, 182162], [143, 182402], [147, 182562], [154, 183102], [156, 183282], [168, 184122], [170, 184582], [174, 184782], [178, 185062], [187, 186042], [189, 186142], [193, 186262], [203, 187403], [208, 188066], [215, 188846], [222, 189126], [226, 189346], [229, 189566]]}, {"verse": 22, "start": 190610, "end": 202705, "text": "Todas las cosas me son entregadas de mi Padre: y nadie sabe quién sea el Hijo sino el Padre; ni quién sea el Padre, sino el Hijo, y a quien el Hijo lo quiera revelar.", "words": [[0, 190610], [6, 190875], [10, 191015], [16, 191415], [19, 191635], [23, 191835], [34, 192475], [37, 192635], [40, 192755], [47, 193669], [49, 193982], [55, 194262], [60, 194722], [66, 195042], [70, 195422], [73, 195682], [78, 195942], [83, 196222], [86, 196462], [93, 197383], [96, 197566], [102, 197786], [106, 198106], [109, 198286], [116, 198646], [121, 199166], [124, 199566], [130, 199946], [132, 200526], [134, 200646], [140, 200806], [143, 201046], [148, 201286], [151, 201466], [158, 202108]]}, {"verse": 23, "start": 203155, "end": 210281, "text": "Y vuelto en privado a los discípulos, dijo: Bienaventurados los ojos que ven lo que vosotros veis:", "words": [[0, 203155], [2, 203495], [9, 203975], [12, 204115], [20, 204615], [22, 204735], [26, 204835], [38, 205775], [44, 207295], [60, 207735], [64, 207935], [69, 208295], [73, 208535], [77, 208715], [80, 208915], [84, 209055], [93, 209515]]}, {"verse": 24, "start": 210731, "end": 220457, "text": "Porque os digo que muchos profetas y reyes desearon ver lo que vosotros veis, y no lo vieron; y oír lo que oís, y no lo oyeron.", "words": [[0, 210731], [7, 210974], [10, 211114], [15, 211334], [19, 211554], [26, 211894], [35, 212554], [37, 212734], [43, 213174], [52, 213954], [56, 214314], [59, 214934], [63, 215074], [72, 215554], [78, 216154], [80, 216654], [83, 216794], [86, 216934], [94, 218082], [96, 218268], [100, 218455], [103, 218635], [107, 218855], [112, 219075], [114, 219375], [117, 219595], [120, 219775]]}, {"verse": 25, "start": 220907, "end": 230339, "text": "Y he aquí, un intérprete de la ley se levantó, tentándole y diciendo: Maestro, ¿haciendo qué cosa poseeré la vida eterna?", "words": [[0, 220907], [2, 221118], [5, 221258], [11, 221638], [14, 221938], [25, 222918], [28, 223058], [31, 223218], [35, 223478], [38, 223738], [47, 225018], [58, 225838], [60, 226078], [70, 227106], [79, 227808], [89, 228148], [93, 228388], [98, 228688], [106, 229288], [109, 229408], [114, 229608]]}, {"verse": 26, "start": 230689, "end": 234602, "text": "Y él le dijo: ¿Qué está escrito en la ley? ¿cómo lees?", "words": [[0, 230689], [2, 230874], [5, 231014], [8, 231174], [14, 232040], [19, 232162], [24, 232322], [32, 232662], [35, 232902], [38, 233042], [43, 233781], [49, 233970]]}, {"verse": 27, "start": 235052, "end": 246737, "text": "Y él respondiendo, dijo: Amarás al Señor tu Dios de todo tu corazón, y de toda tu alma, y de todas tus fuerzas, y de todo tu entendimiento; y a tu prójimo como a ti mismo.", "words": [[0, 235052], [2, 235235], [5, 235655], [19, 236515], [25, 237213], [32, 237710], [35, 237850], [41, 238150], [44, 238450], [49, 238730], [52, 238910], [57, 239150], [60, 239350], [69, 239750], [71, 240190], [74, 240310], [79, 240490], [82, 240750], [88, 241050], [90, 241630], [93, 241750], [99, 241930], [103, 242150], [112, 242690], [114, 243250], [117, 243350], [122, 243550], [125, 243730], [140, 244972], [142, 245097], [144, 245177], [147, 245257], [155, 245757], [160, 245957], [162, 246117], [165, 246197]]}, {"verse": 28, "start": 247087, "end": 251125, "text": "Y le dijo: Bien has respondido: haz esto, y vivirás.", "words": [[0, 247087], [2, 247211], [5, 247331], [11, 248138], [16, 248335], [20, 248565], [32, 249623], [36, 249837], [42, 250137], [44, 250397]]}, {"verse": 29, "start": 251575, "end": 257037, "text": "Pero él, queriéndose justificar a sí mismo, dijo a Jesús: ¿Y quién es mi prójimo?", "words": [[0, 251575], [5, 251739], [9, 252319], [21, 252879], [32, 253539], [34, 253699], [37, 253839], [44, 254599], [49, 254859], [51, 255039], [58, 255838], [61, 255926], [67, 256052], [70, 256179], [73, 256399]]}, {"verse": 30, "start": 257387, "end": 271001, "text": "Y respondiendo Jesús, dijo: Un hombre descendía de Jerusalén a Jericó, y cayó en manos de ladrones, los cuales le despojaron; e hiriéndole, se fueron, dejándole medio muerto.", "words": [[0, 257387], [2, 257502], [15, 258302], [22, 258662], [28, 259910], [31, 260075], [38, 260375], [48, 261135], [51, 261255], [61, 262055], [63, 262255], [71, 262815], [73, 263195], [78, 263615], [81, 263735], [87, 263995], [90, 264215], [100, 265075], [104, 265175], [111, 265455], [114, 266035], [126, 267302], [128, 267789], [140, 268309], [143, 268469], [151, 269249], [161, 269809], [167, 270129]]}, {"verse": 31, "start": 271451, "end": 277833, "text": "Y aconteció, que descendió un sacerdote por aquel camino, y viéndole, se pasó de un lado.", "words": [[0, 271451], [2, 271596], [13, 272416], [17, 272596], [27, 273316], [30, 273536], [40, 274256], [44, 274496], [50, 274776], [58, 275276], [60, 275936], [70, 276596], [73, 276656], [78, 276996], [81, 277196], [84, 277316]]}, {"verse": 32, "start": 278283, "end": 284772, "text": "Y asimismo un levita, llegando cerca de aquel lugar, y viéndole, se pasó de un lado.", "words": [[0, 278283], [2, 278747], [11, 279227], [14, 279567], [22, 280527], [31, 280887], [37, 281187], [40, 281467], [46, 281727], [53, 282067], [55, 282527], [65, 283447], [68, 283527], [73, 283867], [76, 284067], [79, 284207]]}, {"verse": 33, "start": 285222, "end": 292013, "text": "Pero un samaritano que transitaba, viniendo cerca de él, y viéndole, fue movido a misericordia;", "words": [[0, 285222], [5, 285388], [8, 285608], [19, 286308], [23, 286468], [35, 287248], [44, 287788], [50, 288088], [53, 288368], [57, 288528], [59, 289108], [69, 290028], [73, 290368], [80, 290948], [82, 291088]]}, {"verse": 34, "start": 292463, "end": 302827, "text": "Y acercándose, vendó sus heridas, echándoles aceite y vino; y poniéndole sobre su cabalgadura, le llevó al mesón, y cuidó de él.", "words": [[0, 292463], [2, 292568], [15, 293848], [21, 294248], [25, 294468], [34, 295088], [45, 296028], [52, 296507], [54, 296986], [60, 297729], [62, 297851], [73, 298611], [79, 298991], [82, 299711], [95, 300431], [98, 300631], [104, 300991], [107, 301091], [114, 301571], [116, 301791], [122, 302231], [125, 302351]]}, {"verse": 35, "start": 303277, "end": 314255, "text": "Y otro día al partir, sacó dos denarios, y los dio al mesonero, y le dijo: Cuídamele; y todo lo que de más gastes, yo cuando vuelva te lo pagaré.", "words": [[0, 303277], [2, 303402], [7, 303582], [11, 303982], [14, 304102], [22, 304902], [27, 305382], [31, 305742], [41, 306382], [43, 306662], [47, 306842], [51, 307062], [54, 307262], [64, 307902], [66, 308062], [69, 308162], [75, 308966], [86, 310072], [88, 310217], [93, 310517], [96, 310837], [100, 311004], [103, 311170], [107, 311337], [115, 312197], [118, 312437], [125, 312697], [132, 313297], [135, 313417], [138, 313577]]}, {"verse": 36, "start": 314705, "end": 320900, "text": "¿Quién, pues, de estos tres te parece que fue el prójimo de aquel que cayó en manos de los ladrones?", "words": [[0, 314705], [8, 315030], [14, 315250], [17, 315770], [23, 315990], [28, 316310], [31, 316470], [38, 316830], [42, 317090], [46, 317330], [49, 317690], [57, 318330], [60, 318510], [66, 318810], [70, 318950], [75, 319370], [78, 319550], [84, 319830], [87, 320030], [91, 320150]]}, {"verse": 37, "start": 321350, "end": 329274, "text": "Y él dijo: El que usó con él de misericordia. Entonces Jesús le dijo: Ve, y haz tú lo mismo.", "words": [[0, 321350], [2, 321516], [5, 321881], [11, 322425], [14, 322573], [18, 322693], [22, 323053], [26, 323213], [29, 323333], [32, 323453], [46, 325361], [55, 325824], [61, 326524], [64, 326804], [70, 327883], [74, 328223], [76, 328353], [80, 328483], [83, 328643], [86, 328763]]}, {"verse": 38, "start": 329724, "end": 337445, "text": "Y aconteció que yendo, entró él en una aldea: y una mujer llamada Marta, le recibió en su casa.", "words": [[0, 329724], [2, 329866], [12, 330446], [16, 330606], [23, 331066], [29, 331966], [32, 332226], [35, 332486], [39, 332686], [46, 333816], [48, 334118], [52, 334278], [58, 334558], [66, 335018], [73, 335598], [76, 336018], [84, 336578], [87, 336698], [90, 336838]]}, {"verse": 39, "start": 337895, "end": 345636, "text": "Y esta tenía una hermana que se llamaba María, la cual sentándose a los pies de Jesús, oía su palabra.", "words": [[0, 337895], [2, 338023], [7, 338323], [13, 338643], [17, 338863], [25, 339303], [29, 339483], [32, 339623], [40, 340083], [47, 341243], [50, 341343], [55, 341543], [66, 342563], [68, 342703], [72, 342843], [77, 343063], [80, 343223], [87, 343583], [91, 344323], [94, 344503]]}, {"verse": 40, "start": 346086, "end": 357560, "text": "Pero Marta se distraía en muchos servicios; y sobreviniendo, dice: Señor, ¿no tienes cuidado que mi hermana me deja servir sola? Dile pues, que me ayude.", "words": [[0, 346086], [5, 346230], [11, 346850], [14, 347010], [23, 347710], [26, 347890], [33, 348210], [44, 349433], [46, 349533], [61, 350633], [67, 351494], [74, 352500], [78, 352700], [85, 352960], [93, 353420], [97, 353680], [100, 353820], [108, 354220], [111, 354420], [116, 354680], [123, 355020], [129, 356086], [134, 356412], [140, 356592], [144, 356832], [147, 356972]]}, {"verse": 41, "start": 357910, "end": 365147, "text": "Pero respondiendo Jesús, le dijo: Marta, Marta, preocupada estás, y con las muchas cosas estás turbada:", "words": [[0, 357910], [5, 358072], [18, 358792], [25, 359192], [28, 359692], [34, 360548], [41, 361115], [48, 361515], [59, 362095], [66, 362355], [68, 363095], [72, 363255], [76, 363395], [83, 363655], [89, 364055], [95, 364355]]}, {"verse": 42, "start": 365597, "end": 372297, "text": "Pero una cosa es necesaria; y María escogió la buena parte, la cual no le será quitada.", "words": [[0, 365597], [5, 365739], [9, 365939], [14, 366299], [17, 366639], [28, 367892], [30, 367999], [36, 368639], [44, 369219], [47, 369319], [53, 369479], [60, 370319], [63, 370439], [68, 370659], [71, 371219], [74, 371399], [79, 371619]]}]}