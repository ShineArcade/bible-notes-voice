{"book": "LUK", "chapter": 20, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 354966, "verses": [{"verse": 1, "start": 300, "end": 11474, "text": "Y aconteció un día, que enseñando él al pueblo en el templo, y anunciando el evangelio, se llegaron los principales sacerdotes y los escribas, con los ancianos;", "words": [[0, 300], [2, 422], [12, 1122], [15, 1302], [20, 1602], [24, 2222], [34, 2862], [37, 3042], [40, 3182], [47, 3562], [50, 3742], [53, 3902], [61, 4602], [63, 4722], [74, 5382], [77, 5502], [88, 6762], [91, 6922], [100, 7382], [104, 7542], [116, 8322], [127, 9282], [129, 9522], [133, 9682], [143, 10262], [147, 10502], [151, 10642]]}, {"verse": 2, "start": 11924, "end": 19472, "text": "Y le hablaron, diciendo: Dinos: ¿con qué autoridad haces estas cosas? ¿o quién es el que te ha dado esta autoridad?", "words": [[0, 11924], [2, 12070], [5, 12150], [15, 12870], [25, 14165], [32, 14999], [37, 15123], [41, 15303], [51, 15883], [57, 16263], [63, 16503], [70, 17501], [73, 17605], [79, 17785], [82, 17965], [85, 18085], [89, 18205], [92, 18365], [95, 18445], [100, 18665], [105, 18845]]}, {"verse": 3, "start": 19822, "end": 26744, "text": "Respondiendo entonces Jesús, les dijo: Os haré yo también una pregunta; respondedme:", "words": [[0, 19822], [13, 20688], [22, 21128], [29, 21768], [33, 22188], [39, 23094], [42, 23531], [47, 23971], [50, 24091], [58, 24431], [62, 24751], [72, 26273]]}, {"verse": 4, "start": 27194, "end": 31026, "text": "El bautismo de Juan, ¿era del cielo, o de los hombres?", "words": [[0, 27194], [3, 27318], [12, 27878], [15, 28038], [21, 28438], [26, 29138], [30, 29378], [37, 29798], [39, 30178], [42, 30238], [46, 30378]]}, {"verse": 5, "start": 31476, "end": 38488, "text": "Pero ellos pensaban dentro de sí, diciendo: Si decimos, del cielo, dirá: ¿Por qué, pues, no le creísteis?", "words": [[0, 31476], [5, 31620], [11, 31840], [20, 32500], [27, 32820], [30, 33080], [34, 33660], [44, 34583], [47, 34716], [56, 35196], [60, 35376], [67, 36216], [73, 36954], [78, 37078], [83, 37318], [89, 37658], [92, 37918], [95, 38203]]}, {"verse": 6, "start": 38938, "end": 45652, "text": "Y si decimos, de los hombres, todo el pueblo nos apedreará: porque están ciertos que Juan era profeta.", "words": [[0, 38938], [2, 39615], [5, 39735], [14, 40215], [17, 40375], [21, 40515], [30, 40875], [35, 41475], [38, 41695], [45, 41975], [49, 42215], [60, 43379], [67, 43541], [73, 43761], [81, 44381], [85, 44481], [90, 44761], [94, 44941]]}, {"verse": 7, "start": 46002, "end": 48494, "text": "Y respondieron que no sabían de dónde.", "words": [[0, 46002], [2, 46126], [15, 46806], [19, 47026], [22, 47206], [29, 47706], [32, 47926]]}, {"verse": 8, "start": 48944, "end": 55644, "text": "Entonces Jesús les dijo: Ni yo os digo con qué autoridad hago estas cosas.", "words": [[0, 48944], [9, 49408], [15, 50308], [19, 50768], [25, 51540], [28, 51706], [31, 51946], [34, 52126], [39, 52486], [43, 52806], [47, 53106], [57, 53986], [62, 54466], [68, 54766]]}, {"verse": 9, "start": 56094, "end": 65763, "text": "Y comenzó a decir al pueblo esta parábola: Un hombre plantó una viña, y la arrendó a labradores, y se ausentó por mucho tiempo.", "words": [[0, 56094], [2, 56376], [10, 56936], [12, 57016], [18, 57296], [21, 57496], [28, 57936], [33, 58473], [43, 59268], [46, 59435], [53, 59695], [60, 60275], [64, 60415], [70, 60975], [72, 61495], [75, 61655], [83, 62375], [85, 62475], [97, 63195], [99, 63635], [102, 63835], [110, 64655], [114, 64835], [120, 65075]]}, {"verse": 10, "start": 66213, "end": 77178, "text": "Y al tiempo, envió un siervo a los labradores, para que le diesen del fruto de la viña; pero los labradores le hirieron, y le enviaron con las manos vacías.", "words": [[0, 66213], [2, 66333], [5, 66453], [13, 66833], [19, 67253], [22, 67393], [29, 67913], [31, 67993], [35, 68173], [47, 69073], [52, 69713], [56, 69893], [59, 70213], [66, 70533], [70, 70773], [76, 71373], [79, 71473], [82, 71593], [88, 72481], [93, 72624], [97, 72824], [108, 73564], [111, 73784], [121, 74404], [123, 74944], [126, 75084], [135, 75584], [139, 75804], [143, 75984], [149, 76244]]}, {"verse": 11, "start": 77628, "end": 85743, "text": "Y volvió a enviar otro siervo; pero ellos a este también, herido y humillado, le enviaron con las manos vacías.", "words": [[0, 77628], [2, 77757], [9, 78237], [11, 78397], [18, 78857], [23, 79217], [31, 80319], [36, 80559], [42, 80859], [44, 81099], [49, 81339], [58, 82059], [65, 82419], [67, 82539], [78, 83519], [81, 83599], [90, 84199], [94, 84419], [98, 84599], [104, 84839]]}, {"verse": 12, "start": 86193, "end": 91618, "text": "Y volvió a enviar al tercer siervo; pero ellos también a este echaron herido.", "words": [[0, 86193], [2, 86318], [9, 86818], [11, 86998], [18, 87538], [21, 87818], [28, 88406], [36, 89222], [41, 89387], [47, 89667], [55, 90067], [57, 90287], [62, 90667], [70, 91047]]}, {"verse": 13, "start": 92068, "end": 99652, "text": "Entonces el señor de la viña dijo: ¿Qué haré? Enviaré mi hijo amado: quizás cuando a este vean, tendrán respeto.", "words": [[0, 92068], [9, 92527], [12, 92867], [18, 93147], [21, 93367], [24, 93487], [29, 93847], [35, 94641], [40, 94758], [46, 95399], [54, 95759], [57, 95959], [62, 96159], [69, 96939], [76, 97321], [83, 97501], [85, 97761], [90, 97941], [96, 98401], [104, 98941]]}, {"verse": 14, "start": 100002, "end": 109865, "text": "Pero los labradores, viéndole, pensaron entre sí, diciendo: Este es el heredero; venid, matémosle para que la herencia sea nuestra.", "words": [[0, 100002], [5, 100166], [9, 100406], [21, 101066], [31, 102206], [40, 102886], [46, 103226], [50, 103666], [60, 105251], [65, 105539], [68, 105779], [71, 105919], [81, 107100], [88, 107470], [98, 108090], [103, 108290], [107, 108430], [110, 108570], [119, 108970], [123, 109250]]}, {"verse": 15, "start": 110215, "end": 116435, "text": "Y le echaron fuera de la viña, y le mataron. ¿Qué pues, les hará el señor de la viña?", "words": [[0, 110215], [2, 110360], [5, 110440], [13, 110860], [19, 111100], [22, 111320], [25, 111440], [31, 111960], [33, 112460], [36, 112560], [45, 113630], [50, 113834], [56, 114434], [60, 114634], [65, 114974], [68, 115114], [74, 115434], [77, 115674], [80, 115794]]}, {"verse": 16, "start": 116885, "end": 126407, "text": "Vendrá, y destruirá a estos labradores, y dará su viña a otros. Y como ellos lo oyeron, dijeron: ¡Dios nos libre!", "words": [[0, 116885], [8, 117451], [10, 117891], [20, 118711], [22, 118871], [28, 119071], [40, 119871], [42, 120251], [47, 120511], [50, 120691], [55, 121111], [57, 121331], [64, 122323], [66, 122427], [71, 122687], [77, 123007], [80, 123427], [88, 124487], [97, 125445], [103, 125662], [107, 125862]]}, {"verse": 17, "start": 126757, "end": 135566, "text": "Pero él mirándolos, dice: ¿Qué pues es lo que está escrito: La piedra que rechazaron los constructores, esta fue por cabeza de esquina?", "words": [[0, 126757], [5, 126919], [8, 127279], [20, 127959], [26, 128685], [31, 128789], [36, 129049], [39, 129409], [42, 129529], [46, 129669], [51, 129849], [60, 130894], [63, 131016], [70, 131516], [74, 131636], [85, 132316], [89, 132496], [104, 133656], [109, 133836], [113, 134056], [117, 134256], [124, 134636], [127, 134916]]}, {"verse": 18, "start": 136016, "end": 143988, "text": "Cualquiera que caiga sobre aquella piedra, será quebrantado; pero sobre el que la piedra caiga, le desmenuzará.", "words": [[0, 136016], [11, 136478], [15, 136758], [21, 137038], [27, 137338], [35, 137718], [43, 138218], [48, 138578], [61, 139976], [66, 140160], [72, 140520], [75, 140760], [79, 140960], [82, 141120], [89, 141560], [96, 142140], [99, 142740]]}, {"verse": 19, "start": 144438, "end": 155954, "text": "Y procuraban los principales sacerdotes y los escribas echarle mano en aquella hora, porque entendieron que contra ellos había dicho esta parábola: pero temieron al pueblo.", "words": [[0, 144438], [2, 144564], [13, 145264], [17, 145464], [29, 146304], [40, 147104], [42, 147224], [46, 147364], [55, 147984], [63, 148684], [68, 149044], [71, 149244], [79, 149624], [85, 150204], [92, 150504], [104, 151284], [108, 151484], [115, 151884], [121, 152164], [127, 152544], [133, 152904], [138, 153204], [148, 154375], [153, 154539], [162, 155059], [165, 155319]]}, {"verse": 20, "start": 156404, "end": 167209, "text": "Y acechándole enviaron espías que fingieran ser justos, para sorprenderle en palabras, para que le entregasen al poder y a la potestad del gobernador.", "words": [[0, 156404], [2, 156565], [14, 157405], [23, 158185], [30, 158805], [34, 158965], [44, 159565], [48, 159785], [56, 160665], [61, 160925], [74, 161885], [77, 162045], [87, 162945], [92, 163285], [96, 163425], [99, 163585], [110, 164385], [113, 164505], [119, 164905], [121, 165185], [123, 165285], [126, 165345], [135, 165835], [139, 166325]]}, {"verse": 21, "start": 167659, "end": 178125, "text": "Los cuales le preguntaron, diciendo: Maestro, sabemos que dices y enseñas bien, y que no haces distinción entre personas; sino que enseñas el camino de Dios con verdad.", "words": [[0, 167659], [4, 167787], [11, 167967], [14, 168187], [27, 169146], [37, 170310], [46, 170793], [54, 171053], [58, 171333], [64, 171693], [66, 171853], [74, 172333], [80, 172593], [82, 173093], [86, 173213], [89, 173393], [95, 173673], [106, 174333], [112, 174593], [122, 175606], [127, 175784], [131, 175964], [139, 176424], [142, 176544], [149, 176804], [152, 177084], [157, 177324], [161, 177584]]}, {"verse": 22, "start": 178575, "end": 180932, "text": "¿Nos es lícito dar tributo a César, o no?", "words": [[0, 178640], [5, 178740], [8, 178840], [15, 179260], [19, 179500], [27, 180000], [29, 180040], [36, 180460], [38, 180640]]}, {"verse": 23, "start": 181282, "end": 186317, "text": "Pero él, entendiendo la astucia de ellos, les dijo: ¿Por qué me tentáis?", "words": [[0, 181282], [5, 181446], [9, 181866], [21, 182546], [24, 182726], [32, 183206], [35, 183386], [42, 183966], [46, 184046], [52, 184866], [57, 184990], [61, 185230], [64, 185390]]}, {"verse": 24, "start": 186767, "end": 194852, "text": "Mostradme la moneda. ¿De quién tiene la imagen y la inscripción? Y respondiendo dijeron: De César.", "words": [[0, 187116], [10, 187496], [13, 187656], [21, 188699], [25, 188845], [31, 189065], [37, 189445], [40, 189645], [47, 190065], [49, 190425], [52, 190585], [65, 192012], [67, 192178], [80, 193038], [89, 194110], [92, 194253]]}, {"verse": 25, "start": 195202, "end": 202022, "text": "Entonces les dijo: Pues dad a César lo que es de César; y lo que es de Dios, a Dios.", "words": [[0, 195202], [9, 195728], [13, 196108], [19, 197025], [24, 197390], [28, 197790], [30, 198050], [36, 198550], [39, 198770], [43, 198910], [46, 199030], [49, 199130], [56, 200030], [58, 200130], [61, 200250], [65, 200370], [68, 200490], [71, 200610], [77, 201095], [79, 201580]]}, {"verse": 26, "start": 202472, "end": 210851, "text": "Y no pudieron sorprenderle en sus palabras delante del pueblo: sino que maravillados de su respuesta, callaron.", "words": [[0, 202472], [2, 202594], [5, 202694], [14, 203154], [27, 204234], [30, 204474], [34, 204634], [43, 205194], [51, 206134], [55, 206374], [63, 207372], [68, 207619], [72, 207919], [85, 209079], [88, 209239], [91, 209399], [102, 209939]]}, {"verse": 27, "start": 211301, "end": 217679, "text": "Y llegando unos de los saduceos, los cuales niegan haber resurrección, le preguntaron,", "words": [[0, 211301], [2, 211409], [11, 211909], [16, 212209], [19, 212389], [23, 212549], [33, 213609], [37, 213829], [44, 214302], [51, 214776], [57, 215249], [71, 216709], [74, 216789]]}, {"verse": 28, "start": 218129, "end": 228152, "text": "Diciendo: Maestro, Moisés nos escribió: Si el hermano de alguno muere teniendo mujer, y muere sin hijos, que su hermano se case con la viuda, y levante descendencia a su hermano.", "words": [[0, 218129], [10, 219155], [19, 219533], [26, 219913], [30, 220133], [40, 221075], [43, 221216], [46, 221356], [54, 221776], [57, 221876], [64, 222276], [70, 222536], [79, 222936], [86, 223296], [88, 223516], [94, 223776], [98, 223936], [105, 224436], [109, 224636], [112, 224776], [120, 225136], [123, 225216], [128, 225436], [132, 225676], [135, 225816], [142, 226136], [144, 226376], [152, 226756], [165, 227476], [167, 227576], [170, 227636]]}, {"verse": 29, "start": 228602, "end": 233301, "text": "Fueron, pues, siete hermanos: y el primero tomó mujer, y murió sin hijos.", "words": [[0, 228602], [8, 228822], [14, 229102], [20, 229582], [30, 230565], [32, 230666], [35, 230766], [43, 231106], [48, 231526], [55, 231906], [57, 232186], [63, 232506], [67, 232726]]}, {"verse": 30, "start": 233751, "end": 236954, "text": "Y la tomó el segundo, el cual también murió sin hijos.", "words": [[0, 233751], [2, 233855], [5, 233955], [10, 234255], [13, 234355], [22, 235135], [25, 235155], [30, 235375], [38, 235715], [44, 236195], [48, 236395]]}, {"verse": 31, "start": 237404, "end": 244107, "text": "Y la tomó el tercero: asimismo también todos siete: y murieron sin dejar descendencia.", "words": [[0, 237404], [2, 237505], [5, 237605], [10, 237905], [13, 238005], [22, 238934], [31, 239559], [39, 240002], [45, 240446], [52, 241189], [54, 241297], [63, 241717], [67, 241937], [73, 242297]]}, {"verse": 32, "start": 244557, "end": 246545, "text": "Y finalmente murió también la mujer.", "words": [[0, 244557], [2, 244662], [13, 244962], [19, 245582], [27, 245822], [30, 246062]]}, {"verse": 33, "start": 246995, "end": 252311, "text": "En la resurrección, pues, ¿mujer de cuál de ellos será? porque los siete la tuvieron por mujer.", "words": [[0, 246995], [3, 247132], [6, 247252], [20, 248052], [26, 248592], [33, 248832], [36, 249072], [41, 249252], [44, 249432], [50, 249632], [56, 250384], [63, 250569], [67, 250729], [73, 251049], [76, 251229], [85, 251629], [89, 251809]]}, {"verse": 34, "start": 252661, "end": 259627, "text": "Entonces respondiendo Jesús, les dijo: Los hijos de esta era se casan, y son dados en casamiento:", "words": [[0, 252661], [9, 253505], [22, 254125], [29, 254465], [33, 254865], [39, 255608], [43, 255718], [49, 256038], [52, 256271], [57, 256505], [61, 256738], [64, 256838], [71, 257358], [73, 257778], [77, 257938], [83, 258278], [86, 258578]]}, {"verse": 35, "start": 260077, "end": 269183, "text": "Pero los que sean tenidos por dignos de aquella era y de la resurrección de los muertos, ni se casan, ni son dados en casamiento:", "words": [[0, 260077], [5, 260241], [9, 260441], [13, 260601], [18, 260921], [26, 261441], [30, 261681], [37, 262141], [40, 262241], [48, 262701], [52, 263081], [54, 263341], [57, 263461], [60, 263601], [73, 264521], [76, 264661], [80, 264781], [89, 265321], [92, 265841], [95, 266061], [102, 266901], [105, 267101], [109, 267381], [115, 267841], [118, 268161]]}, {"verse": 36, "start": 269633, "end": 279009, "text": "Porque no pueden ya más morir: porque son iguales a los ángeles, y son hijos de Dios, cuando son hijos de la resurrección.", "words": [[0, 269633], [7, 269857], [10, 270077], [17, 270597], [20, 270877], [24, 271157], [31, 272049], [38, 272295], [42, 272555], [50, 273235], [52, 273335], [56, 273435], [65, 274015], [67, 274135], [71, 274355], [77, 274795], [80, 275015], [86, 275315], [93, 275935], [97, 276315], [103, 276795], [106, 277095], [109, 277255]]}, {"verse": 37, "start": 279459, "end": 290718, "text": "Y que los muertos hayan de resucitar, aun Moisés lo enseñó en el pasaje de la zarza, cuando llama al Señor: Dios de Abraham, y Dios de Isaac, y Dios de Jacob.", "words": [[0, 279459], [2, 279569], [6, 279669], [10, 279809], [18, 280259], [24, 280709], [27, 280829], [38, 281609], [42, 281769], [49, 282369], [52, 282909], [59, 283529], [62, 283709], [65, 283849], [72, 284389], [75, 284529], [78, 284669], [85, 285269], [92, 285649], [98, 286089], [101, 286309], [108, 287154], [113, 287401], [116, 287601], [125, 288061], [127, 288561], [132, 288761], [135, 288901], [142, 289281], [144, 289821], [149, 290021], [152, 290161]]}, {"verse": 38, "start": 291168, "end": 296840, "text": "Porque Dios no es Dios de muertos, sino de vivos: porque todos viven a él.", "words": [[0, 291168], [7, 291393], [12, 291753], [15, 292253], [18, 292513], [23, 292853], [26, 293053], [35, 293593], [40, 294113], [43, 294333], [50, 295323], [57, 295531], [63, 295831], [69, 296351], [71, 296491]]}, {"verse": 39, "start": 297290, "end": 305647, "text": "Y respondiéndole unos de los escribas, dijeron: Maestro, bien has dicho.", "words": [[0, 297290], [2, 297410], [17, 298410], [22, 298710], [25, 298890], [29, 299280], [39, 299670], [48, 300546], [57, 301135], [62, 301275], [66, 301455]]}, {"verse": 40, "start": 305997, "end": 308546, "text": "Y no se atrevieron más a preguntarle algo.", "words": [[0, 305997], [2, 306121], [5, 306261], [8, 306401], [19, 306941], [23, 307141], [25, 307301], [37, 307981]]}, {"verse": 41, "start": 308996, "end": 312957, "text": "Y él les dijo: ¿Cómo dicen que el Cristo es hijo de David?", "words": [[0, 308996], [2, 309181], [5, 309361], [9, 309681], [15, 310480], [21, 310781], [27, 311041], [31, 311321], [34, 311441], [41, 311821], [44, 312081], [49, 312281], [52, 312461]]}, {"verse": 42, "start": 313407, "end": 320893, "text": "Y el mismo David dice en el libro de los Salmos: Dijo el Señor a mi Señor: Siéntate a mi diestra,", "words": [[0, 313407], [2, 313513], [5, 313613], [11, 313913], [17, 314333], [22, 315033], [25, 315373], [28, 315593], [34, 315853], [37, 316053], [41, 316173], [49, 317342], [54, 317668], [57, 317868], [63, 318148], [65, 318448], [68, 318568], [75, 319439], [84, 320099], [86, 320239], [89, 320339]]}, {"verse": 43, "start": 321343, "end": 324915, "text": "Entre tanto que pongo tus enemigos por estrado de tus pies.", "words": [[0, 321343], [6, 321626], [12, 322066], [16, 322286], [22, 322666], [26, 322866], [35, 323406], [39, 323626], [47, 324126], [50, 324306], [54, 324466]]}, {"verse": 44, "start": 325365, "end": 328686, "text": "Así que David le llama Señor: ¿cómo pues es su hijo?", "words": [[0, 325365], [4, 325705], [8, 325885], [14, 326165], [17, 326445], [23, 326645], [30, 327539], [36, 327703], [41, 327943], [44, 328103], [47, 328263]]}, {"verse": 45, "start": 329136, "end": 332348, "text": "Y oyéndole todo el pueblo, dijo a sus discípulos:", "words": [[0, 329136], [2, 329280], [11, 329820], [16, 330060], [19, 330280], [27, 330580], [32, 330880], [34, 331140], [38, 331320]]}, {"verse": 46, "start": 332798, "end": 345063, "text": "Guardaos de los escribas, que quieren andar con ropas largas, y aman los saludos en las plazas, y las primeras sillas en las sinagogas, y los primeros asientos en las cenas;", "words": [[0, 333071], [9, 333381], [12, 333541], [16, 333661], [26, 334281], [30, 334801], [38, 335141], [44, 335461], [48, 335701], [54, 336081], [62, 336681], [64, 337101], [69, 337381], [73, 337861], [81, 338541], [84, 338788], [88, 339034], [96, 339281], [98, 339741], [102, 339901], [111, 340341], [118, 340761], [121, 341001], [125, 341599], [136, 342459], [138, 342578], [142, 342738], [151, 343338], [160, 343818], [163, 344118], [167, 344278]]}, {"verse": 47, "start": 345513, "end": 354566, "text": "Que devoran las casas de las viudas, poniendo por pretexto la larga oración: estos recibirán mayor condenación.", "words": [[0, 345513], [4, 345824], [12, 346304], [16, 346484], [22, 346944], [25, 347044], [29, 347144], [37, 348144], [46, 348804], [50, 349064], [59, 349944], [62, 350224], [68, 350624], [77, 351766], [83, 352111], [93, 353191], [99, 353531]]}]}