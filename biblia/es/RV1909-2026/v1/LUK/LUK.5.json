{"book": "LUK", "chapter": 5, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 342782, "verses": [{"verse": 1, "start": 300, "end": 8297, "text": "Y aconteció, que estando él junto al lago de Genezaret, el gentío se agolpaba sobre él para oír la palabra de Dios.", "words": [[0, 300], [2, 426], [13, 1126], [17, 1386], [25, 1806], [28, 1966], [34, 2186], [37, 2446], [42, 2746], [45, 3436], [56, 4126], [59, 4226], [66, 4846], [69, 5046], [78, 5786], [84, 6086], [87, 6426], [92, 6626], [96, 7026], [99, 7166], [107, 7606], [110, 7746]]}, {"verse": 2, "start": 8647, "end": 17200, "text": "Y vio dos barcos que estaban cerca de la orilla del lago: y los pescadores, habiendo descendido de ellos, lavaban sus redes.", "words": [[0, 8647], [2, 8775], [6, 8975], [10, 9155], [17, 9595], [21, 9755], [29, 10035], [35, 10455], [38, 10715], [41, 10855], [48, 11255], [52, 11415], [58, 12130], [60, 12233], [64, 12393], [76, 13173], [85, 13693], [96, 14513], [99, 14693], [106, 15593], [114, 16253], [118, 16473]]}, {"verse": 3, "start": 17550, "end": 28197, "text": "Y entrado en uno de estos barcos, el cual era de Simón, le rogó que lo desviase de tierra un poco; y sentándose, enseñaba desde el barco a la multitud.", "words": [[0, 17550], [2, 17825], [10, 18345], [13, 18485], [17, 18665], [20, 18805], [26, 18985], [34, 19525], [37, 19785], [42, 19985], [46, 20365], [49, 20545], [56, 21065], [59, 21685], [64, 22185], [68, 22305], [71, 22465], [80, 23025], [83, 23205], [90, 23565], [93, 23805], [99, 24572], [101, 24698], [113, 25538], [122, 26438], [128, 26618], [131, 26858], [137, 27258], [139, 27358], [142, 27438]]}, {"verse": 4, "start": 28547, "end": 35622, "text": "Y como cesó de hablar, dijo a Simón: Ve a aguas profundas, y echad vuestras redes para pescar.", "words": [[0, 28547], [2, 28802], [7, 29022], [12, 29462], [15, 29562], [23, 30402], [28, 30794], [30, 31186], [37, 31734], [40, 31800], [42, 31900], [48, 32220], [59, 33260], [61, 33480], [67, 33900], [76, 34300], [82, 34620], [87, 34980]]}, {"verse": 5, "start": 35972, "end": 43880, "text": "Y respondiendo Simón, le dijo: Maestro, habiendo trabajado toda la noche, nada hemos tomado; pero en tu palabra echaré la red.", "words": [[0, 35972], [2, 36251], [15, 37091], [22, 37471], [25, 37631], [31, 38362], [40, 38919], [49, 39139], [59, 39719], [64, 39899], [67, 40079], [74, 40819], [79, 40999], [85, 41279], [93, 42126], [98, 42290], [101, 42410], [104, 42510], [112, 42850], [119, 43370], [122, 43510]]}, {"verse": 6, "start": 44160, "end": 49969, "text": "Y habiéndolo hecho, encerraron gran multitud de pescado, que su red se rompía.", "words": [[0, 44160], [2, 44324], [13, 44844], [20, 45164], [31, 46044], [36, 46264], [45, 47044], [48, 47284], [57, 48024], [61, 48219], [64, 48439], [68, 48779], [71, 49139]]}, {"verse": 7, "start": 50319, "end": 61482, "text": "E hicieron señas a los compañeros que estaban en el otro barco, que viniesen a ayudarles; y vinieron, y llenaron ambos barcos, de tal manera que se hundían.", "words": [[0, 50319], [2, 50636], [11, 51136], [17, 51876], [19, 51956], [23, 52076], [34, 52776], [38, 52896], [46, 53196], [49, 53456], [52, 53616], [57, 53796], [64, 54576], [68, 54916], [77, 55256], [79, 55536], [90, 56714], [92, 56856], [102, 57356], [104, 57656], [113, 58216], [119, 58616], [127, 59236], [130, 59636], [134, 59956], [141, 60316], [145, 60556], [148, 60716]]}, {"verse": 8, "start": 61832, "end": 69714, "text": "Lo cual viendo Simón Pedro, se derribó de rodillas a Jesús, diciendo: Apártate de mí, Señor, porque soy hombre pecador.", "words": [[0, 61832], [3, 61958], [8, 62138], [15, 62478], [21, 62938], [28, 63398], [31, 63938], [39, 64518], [42, 64638], [51, 65138], [53, 65318], [60, 65658], [70, 66868], [79, 67426], [82, 67586], [86, 67686], [93, 68366], [100, 68566], [104, 68786], [111, 69086]]}, {"verse": 9, "start": 69994, "end": 77065, "text": "Porque temor le había rodeado, y a todos los que estaban con él, de la captura de los peces que habían tomado;", "words": [[0, 69994], [7, 70238], [13, 70758], [16, 70878], [22, 71178], [31, 71898], [33, 72103], [35, 72203], [41, 72503], [45, 72783], [49, 72963], [57, 73303], [61, 73623], [65, 73863], [68, 74523], [71, 74643], [79, 75123], [82, 75263], [86, 75383], [92, 75923], [96, 76143], [103, 76403]]}, {"verse": 10, "start": 77415, "end": 89740, "text": "Y asimismo a Jacobo y a Juan, hijos de Zebedeo, que eran compañeros de Simón. Y Jesús dijo a Simón: No temas: desde ahora pescarás hombres.", "words": [[0, 77415], [2, 77812], [11, 78242], [13, 78542], [20, 79262], [22, 79422], [24, 79502], [30, 80482], [36, 80742], [39, 81522], [48, 82302], [52, 82362], [57, 82622], [68, 83482], [71, 83642], [78, 84590], [80, 84717], [86, 85077], [91, 85597], [93, 85837], [100, 86616], [103, 86763], [110, 87622], [116, 87848], [122, 88388], [131, 88928]]}, {"verse": 11, "start": 90090, "end": 94991, "text": "Y cuando llegaron a tierra los barcos, dejándolo todo, le siguieron.", "words": [[0, 90090], [2, 90178], [9, 90378], [18, 90958], [20, 91078], [27, 91378], [31, 91638], [39, 92598], [49, 93258], [55, 94118], [58, 94218]]}, {"verse": 12, "start": 95341, "end": 108486, "text": "Y aconteció que estando en una ciudad, he aquí un hombre lleno de lepra, el cual viendo a Jesús, postrándose sobre el rostro, le rogó, diciendo: Señor, si quieres, puedes limpiarme.", "words": [[0, 95341], [2, 95462], [12, 96142], [16, 96322], [24, 96682], [27, 96802], [31, 96962], [39, 97722], [42, 98002], [47, 98262], [50, 98442], [57, 98782], [63, 99302], [66, 99422], [73, 99855], [76, 100289], [81, 100722], [88, 101082], [90, 101242], [97, 102002], [109, 102742], [115, 103142], [118, 103342], [126, 104107], [129, 104247], [135, 104827], [145, 105970], [152, 106555], [155, 106555], [164, 107255], [171, 107655]]}, {"verse": 13, "start": 108766, "end": 116004, "text": "Entonces, extendiendo la mano, le tocó diciendo: Quiero: sé limpio. Y luego la lepra se fue de él.", "words": [[0, 108766], [10, 109650], [22, 110390], [25, 110550], [31, 110950], [34, 111010], [39, 111370], [49, 112270], [57, 112930], [60, 113098], [68, 113964], [70, 114128], [76, 114368], [79, 114608], [85, 114988], [88, 115208], [92, 115408], [95, 115648]]}, {"verse": 14, "start": 116354, "end": 127919, "text": "Y él le mandó que no lo dijese a nadie: Pero ve, le dijo, muéstrate al sacerdote, y ofrece por tu limpieza, como mandó Moisés, para testimonio a ellos.", "words": [[0, 116354], [2, 116520], [5, 116660], [8, 116800], [14, 117160], [18, 117300], [21, 117460], [24, 117580], [31, 118040], [33, 118200], [40, 118925], [45, 119281], [49, 119815], [52, 120028], [58, 120775], [68, 121261], [71, 121521], [82, 122281], [84, 122641], [91, 123021], [95, 123301], [98, 123441], [108, 124181], [113, 124761], [119, 125261], [127, 125721], [132, 126196], [143, 127136], [145, 127296]]}, {"verse": 15, "start": 128269, "end": 135577, "text": "Pero tanto más se extendía su fama: y se reunía mucha gente para oír y ser sanadas de sus enfermedades.", "words": [[0, 128269], [5, 128582], [11, 128842], [15, 129202], [18, 129382], [27, 129982], [30, 130162], [36, 130980], [38, 131102], [41, 131222], [48, 131722], [54, 131962], [60, 132362], [65, 132682], [69, 133082], [71, 133282], [75, 133522], [83, 134102], [86, 134262], [90, 134402]]}, {"verse": 16, "start": 135927, "end": 138952, "text": "Pero él se apartaba a los desiertos, y oraba.", "words": [[0, 135927], [5, 136091], [8, 136271], [11, 136411], [20, 137051], [22, 137151], [26, 137271], [37, 138111], [39, 138311]]}, {"verse": 17, "start": 139302, "end": 155635, "text": "Y aconteció un día, que él estaba enseñando, y los fariseos y maestros de la ley estaban sentados, los cuales habían venido de todas las aldeas de Galilea, y de Judea y Jerusalén: y el poder del Señor estaba allí para sanarlos.", "words": [[0, 139302], [2, 139479], [12, 140179], [15, 140359], [20, 140699], [24, 140934], [27, 141294], [34, 141594], [45, 142494], [47, 143134], [51, 143274], [60, 143974], [62, 144094], [71, 144714], [74, 144834], [77, 144974], [81, 145214], [89, 145594], [99, 146894], [103, 147094], [110, 147314], [117, 147754], [124, 148214], [127, 148354], [133, 148614], [137, 148914], [144, 149394], [147, 149494], [156, 150321], [158, 150561], [161, 150601], [167, 151241], [169, 151401], [180, 152558], [182, 152717], [185, 152877], [191, 153217], [195, 153457], [201, 153797], [208, 154217], [213, 154497], [218, 154737]]}, {"verse": 18, "start": 155985, "end": 164641, "text": "Y he aquí unos hombres, que traían sobre un lecho un hombre que estaba paralítico; y buscaban meterle, y ponerle delante de él.", "words": [[0, 155985], [2, 156121], [5, 156291], [10, 156531], [15, 156731], [24, 157211], [28, 157596], [35, 158076], [41, 158356], [44, 158536], [50, 158936], [53, 159236], [60, 159556], [64, 159776], [71, 160056], [83, 161395], [85, 161521], [94, 162001], [103, 162661], [105, 163041], [113, 163621], [121, 164101], [124, 164241]]}, {"verse": 19, "start": 164991, "end": 175536, "text": "Y no hallando por donde meterle a causa de la multitud, subieron encima de la casa, y por el tejado le bajaron con el lecho en medio, delante de Jesús;", "words": [[0, 164991], [2, 165114], [5, 165234], [14, 165654], [18, 165894], [24, 166134], [32, 166834], [34, 166954], [40, 167274], [43, 167474], [46, 167594], [56, 168674], [65, 169254], [72, 169694], [75, 169874], [78, 170014], [84, 170894], [86, 171094], [90, 171254], [93, 171374], [100, 171934], [103, 172054], [111, 172554], [115, 172734], [118, 172914], [124, 173274], [127, 173414], [134, 173834], [142, 174674], [145, 174834]]}, {"verse": 20, "start": 175886, "end": 181613, "text": "El cual, viendo la fe de ellos, le dice: Hombre, tus pecados te son perdonados.", "words": [[0, 175886], [3, 176048], [9, 176688], [16, 177028], [19, 177268], [22, 177448], [25, 177608], [32, 177888], [35, 178248], [41, 179037], [49, 179707], [53, 179867], [61, 180347], [64, 180487], [68, 180667]]}, {"verse": 21, "start": 181963, "end": 191718, "text": "Entonces los escribas y los fariseos comenzaron a pensar, diciendo: ¿Quién es este que habla blasfemias? ¿Quién puede perdonar pecados sino sólo Dios?", "words": [[0, 181963], [9, 182463], [13, 182923], [22, 183603], [24, 183763], [28, 183903], [37, 184543], [48, 185183], [50, 185303], [58, 185803], [68, 187131], [75, 187325], [78, 187465], [83, 187685], [87, 187905], [93, 188125], [105, 189187], [112, 189424], [118, 189624], [127, 190164], [135, 190684], [140, 190904], [145, 191164]]}, {"verse": 22, "start": 191998, "end": 199661, "text": "Jesús entonces, conociendo los pensamientos de ellos, respondiendo les dijo: ¿Qué pensáis en vuestros corazones?", "words": [[0, 191998], [6, 192424], [16, 193604], [27, 194244], [31, 194444], [44, 195124], [47, 195364], [54, 195897], [67, 196431], [71, 196964], [77, 197747], [82, 197850], [90, 198290], [93, 198490], [102, 198830]]}, {"verse": 23, "start": 200011, "end": 206911, "text": "¿Qué es más fácil, decir: Tus pecados te son perdonados, o decir: Levántate y anda?", "words": [[0, 200011], [5, 200133], [8, 200293], [12, 200513], [19, 200953], [26, 202204], [30, 202821], [38, 203381], [41, 203541], [45, 203781], [57, 204541], [59, 204940], [66, 205558], [76, 206196], [78, 206496]]}, {"verse": 24, "start": 207261, "end": 218193, "text": "Pues para que sepáis que el Hijo del hombre tiene potestad en la tierra de perdonar pecados, (dice al paralítico): A ti digo, levántate, toma tu lecho, y vete a tu casa.", "words": [[0, 207261], [5, 207565], [10, 207950], [14, 208110], [21, 208650], [25, 208890], [28, 209050], [33, 209290], [37, 209450], [44, 209750], [50, 210050], [59, 210730], [62, 210850], [65, 210990], [72, 211310], [75, 211530], [84, 212090], [93, 212984], [99, 213373], [102, 213593], [115, 214694], [117, 214899], [120, 214979], [126, 215379], [137, 216159], [142, 216339], [145, 216569], [152, 216799], [154, 217059], [159, 217379], [161, 217519], [164, 217599]]}, {"verse": 25, "start": 218543, "end": 226921, "text": "Y luego, levantándose en presencia de ellos, y tomando aquel en que estaba echado, se fue a su casa, glorificando a Dios.", "words": [[0, 218543], [2, 218688], [9, 218948], [22, 220008], [25, 220208], [35, 220828], [38, 221048], [45, 221868], [47, 222168], [55, 222548], [61, 222908], [64, 223028], [68, 223148], [75, 223448], [83, 224368], [86, 224468], [90, 224648], [92, 224748], [95, 224828], [101, 225588], [114, 226328], [116, 226428]]}, {"verse": 26, "start": 227271, "end": 235351, "text": "Y tomó espanto a todos, y glorificaban a Dios; y fueron llenos de temor, diciendo: Hemos visto maravillas hoy.", "words": [[0, 227271], [2, 227395], [7, 227715], [15, 228335], [17, 228495], [24, 228875], [26, 229435], [39, 230235], [41, 230355], [47, 231051], [49, 231190], [56, 231430], [63, 231870], [66, 231970], [73, 232470], [83, 233719], [89, 233901], [95, 234241], [106, 234861]]}, {"verse": 27, "start": 235631, "end": 245943, "text": "Y después de estas cosas salió, y vio a un recaudador de impuestos llamado Leví, sentado a la mesa de cobro de impuestos, y le dijo: Sígueme.", "words": [[0, 235631], [2, 235753], [10, 236053], [13, 236253], [19, 236453], [25, 236893], [32, 237933], [34, 238193], [38, 238453], [40, 238673], [43, 238853], [54, 239593], [57, 239793], [67, 240373], [75, 240693], [81, 241093], [89, 242293], [91, 242413], [94, 242513], [99, 242753], [102, 242953], [108, 243333], [111, 243493], [122, 244153], [124, 244333], [127, 244433], [133, 245563]]}, {"verse": 28, "start": 246293, "end": 250032, "text": "Y dejadas todas las cosas, levantándose, le siguió.", "words": [[0, 246293], [2, 246407], [10, 246787], [16, 247047], [20, 247327], [27, 247747], [41, 249127], [44, 249427]]}, {"verse": 29, "start": 250382, "end": 260055, "text": "E hizo Leví gran banquete en su casa; y había muchos recaudadores de impuestos y otras personas, los cuales estaban a la mesa con ellos.", "words": [[0, 250382], [2, 250546], [7, 250886], [12, 251226], [17, 251466], [26, 252126], [29, 252306], [32, 252446], [38, 253313], [40, 253438], [46, 253618], [53, 254018], [66, 254938], [69, 255178], [79, 255878], [81, 256418], [87, 256618], [97, 257698], [101, 257798], [108, 258038], [116, 258578], [118, 258778], [121, 258878], [126, 259118], [130, 259378]]}, {"verse": 30, "start": 260405, "end": 269752, "text": "Y los escribas y los fariseos murmuraban contra sus discípulos, diciendo: ¿Por qué coméis y bebéis con los recaudadores de impuestos y pecadores?", "words": [[0, 260405], [2, 260531], [6, 260691], [15, 261351], [17, 261511], [21, 261671], [30, 262391], [41, 263231], [48, 263611], [52, 263911], [64, 264891], [74, 266040], [79, 266167], [83, 266327], [90, 266747], [92, 266887], [99, 267207], [103, 267387], [107, 267507], [120, 268167], [123, 268347], [133, 268807], [135, 268967]]}, {"verse": 31, "start": 270032, "end": 277375, "text": "Y respondiendo Jesús, les dijo: Los que están sanos no necesitan médico, sino los que están enfermos.", "words": [[0, 270032], [2, 270154], [15, 270894], [22, 271294], [26, 271854], [32, 272673], [36, 272947], [40, 273107], [46, 273367], [52, 273847], [55, 274047], [65, 274667], [73, 275667], [78, 275967], [82, 276187], [86, 276307], [92, 276527]]}, {"verse": 32, "start": 277725, "end": 281784, "text": "No he venido a llamar justos, sino pecadores a arrepentimiento.", "words": [[0, 277725], [3, 277895], [6, 277975], [13, 278295], [15, 278375], [22, 278685], [30, 278995], [35, 279395], [45, 280215], [47, 280475]]}, {"verse": 33, "start": 282134, "end": 292522, "text": "Entonces ellos le dijeron: ¿Por qué los discípulos de Juan ayunan muchas veces y hacen oraciones, y asimismo los de los fariseos, y tus discípulos comen y beben?", "words": [[0, 282134], [9, 282573], [15, 283113], [18, 283353], [27, 284179], [32, 284245], [36, 284312], [40, 284532], [51, 285172], [54, 285332], [59, 285672], [66, 286092], [73, 286332], [79, 286772], [81, 287192], [87, 287432], [98, 288452], [100, 288742], [109, 289032], [113, 289252], [116, 289412], [120, 289532], [130, 290392], [132, 290652], [136, 290792], [147, 291532], [153, 291892], [155, 292072]]}, {"verse": 34, "start": 292802, "end": 299905, "text": "Y él les dijo: ¿Podéis hacer que los que están de bodas ayunen, entre tanto que el esposo está con ellos?", "words": [[0, 292802], [2, 293030], [5, 293210], [9, 293410], [15, 294164], [23, 294548], [29, 295028], [33, 295468], [37, 295628], [41, 295788], [47, 296028], [50, 296168], [56, 296528], [64, 297061], [70, 297595], [76, 298128], [80, 298348], [83, 298528], [90, 298948], [95, 299148], [99, 299408]]}, {"verse": 35, "start": 300255, "end": 306643, "text": "Pero vendrán días cuando el esposo les será quitado: entonces ayunarán en aquellos días.", "words": [[0, 300255], [5, 300423], [13, 300923], [18, 301263], [25, 301723], [28, 301963], [35, 302403], [39, 302623], [44, 302863], [53, 303802], [62, 304367], [71, 305387], [74, 305547], [83, 305807]]}, {"verse": 36, "start": 306993, "end": 318372, "text": "Y les decía también una parábola: Nadie mete remiendo de paño nuevo en vestido viejo; de otra manera el nuevo rompe, y al viejo no conviene remiendo nuevo.", "words": [[0, 306993], [2, 307117], [6, 307257], [12, 307677], [20, 308057], [24, 308437], [34, 309411], [40, 310011], [45, 310291], [54, 310991], [57, 311241], [62, 311491], [68, 311791], [71, 311971], [79, 312451], [86, 313249], [89, 313394], [94, 313554], [101, 313954], [104, 314154], [110, 314314], [117, 315014], [119, 315434], [122, 315594], [128, 316134], [131, 316574], [140, 317134], [149, 317754]]}, {"verse": 37, "start": 318722, "end": 329155, "text": "Y nadie echa vino nuevo en odres viejos; de otra manera el vino nuevo romperá los odres, y el vino se derramará, y los odres se perderán.", "words": [[0, 318722], [2, 318870], [8, 319170], [13, 319730], [18, 320130], [24, 320530], [27, 320730], [33, 321110], [41, 322200], [44, 322326], [49, 322486], [56, 322886], [59, 323086], [64, 323266], [70, 323586], [78, 324246], [82, 324406], [89, 324966], [91, 325231], [94, 325351], [99, 325591], [102, 325831], [113, 326531], [115, 327211], [119, 327371], [125, 327991], [128, 328331]]}, {"verse": 38, "start": 329505, "end": 335604, "text": "Pero el vino nuevo en odres nuevos se ha de echar; y lo uno y lo otro se conserva.", "words": [[0, 329505], [5, 329669], [8, 329849], [13, 330089], [19, 330469], [22, 330729], [28, 331149], [35, 331609], [38, 332089], [41, 332249], [44, 332389], [51, 333212], [53, 333335], [56, 333475], [60, 333775], [62, 334235], [65, 334375], [70, 334615], [73, 334815]]}, {"verse": 39, "start": 335954, "end": 342382, "text": "Y ninguno que bebe del añejo, quiere enseguida el nuevo; porque dice: El añejo es mejor.", "words": [[0, 335954], [2, 336072], [10, 336532], [14, 336732], [19, 337072], [23, 337252], [30, 337812], [37, 338472], [47, 339132], [50, 339272], [57, 340019], [64, 340242], [70, 341039], [73, 341204], [79, 341684], [82, 341824]]}]}