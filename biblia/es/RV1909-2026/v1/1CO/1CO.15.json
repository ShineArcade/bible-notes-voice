{"book": "1CO", "chapter": 15, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 379702, "verses": [{"verse": 1, "start": 300, "end": 7849, "text": "Además os declaro, hermanos, el evangelio que os he predicado, el cual también recibisteis, en el cual también perseveráis;", "words": [[0, 300], [7, 599], [10, 839], [19, 1299], [29, 2259], [32, 2359], [42, 3059], [46, 3159], [49, 3299], [52, 3379], [63, 4399], [66, 4459], [71, 4659], [79, 4979], [92, 6119], [95, 6199], [98, 6319], [103, 6539], [111, 6979]]}, {"verse": 2, "start": 8199, "end": 14993, "text": "Por el cual asimismo, si retenéis la palabra que os he predicado, sois salvos, si no creísteis en vano.", "words": [[0, 8199], [4, 8353], [7, 8433], [12, 8943], [22, 9453], [25, 9613], [34, 10193], [37, 10353], [45, 10673], [49, 10993], [52, 11153], [55, 11373], [66, 12433], [71, 12693], [79, 13593], [82, 13673], [85, 13833], [95, 14433], [98, 14573]]}, {"verse": 3, "start": 15343, "end": 23184, "text": "Porque primeramente os he enseñado lo que asimismo recibí: Que Cristo fue muerto por nuestros pecados, conforme a las Escrituras;", "words": [[0, 15343], [7, 15539], [20, 16319], [23, 16459], [26, 16699], [35, 17259], [38, 17399], [42, 17719], [51, 18039], [59, 18932], [63, 19032], [70, 19432], [74, 19752], [81, 20212], [85, 20452], [94, 20732], [103, 21472], [112, 22092], [114, 22172], [118, 22332]]}, {"verse": 4, "start": 23534, "end": 28663, "text": "Y que fue sepultado, y que resucitó al tercer día, conforme a las Escrituras;", "words": [[0, 23534], [2, 23634], [6, 23734], [10, 23914], [21, 24674], [23, 25094], [27, 25214], [36, 25874], [39, 25974], [46, 26214], [51, 26734], [60, 27614], [62, 27674], [66, 27814]]}, {"verse": 5, "start": 29013, "end": 31914, "text": "Y que apareció a Cefas, y después a los doce.", "words": [[0, 29013], [2, 29120], [6, 29240], [15, 29760], [17, 30090], [24, 30420], [26, 30640], [34, 30920], [36, 31220], [40, 31340]]}, {"verse": 6, "start": 32264, "end": 38724, "text": "Después apareció a más de quinientos hermanos juntos; de los cuales muchos viven aún, y otros son muertos.", "words": [[0, 32264], [8, 32608], [17, 33328], [19, 33468], [23, 33608], [26, 33868], [37, 34128], [46, 34768], [54, 35573], [57, 35654], [61, 35774], [68, 36034], [75, 36394], [81, 36894], [86, 37134], [88, 37614], [94, 37854], [98, 38174]]}, {"verse": 7, "start": 39074, "end": 43045, "text": "Después apareció a Jacobo; después a todos los apóstoles.", "words": [[0, 39074], [8, 39440], [17, 40100], [19, 40240], [27, 41069], [35, 41394], [37, 41694], [43, 41914], [47, 42114]]}, {"verse": 8, "start": 43395, "end": 47919, "text": "Y el último de todos, como a un nacido fuera de tiempo, me apareció a mí.", "words": [[0, 43395], [2, 43501], [5, 43601], [12, 43901], [15, 44141], [22, 45061], [27, 45188], [29, 45314], [32, 45441], [39, 45941], [45, 46181], [48, 46401], [56, 46881], [59, 46981], [68, 47541], [70, 47661]]}, {"verse": 9, "start": 48269, "end": 54750, "text": "Porque yo soy el más pequeño de los apóstoles, que no soy digno de ser llamado apóstol, porque perseguí la iglesia de Dios.", "words": [[0, 48269], [7, 48449], [10, 48629], [14, 48789], [17, 48909], [21, 49049], [29, 49369], [32, 49589], [36, 49689], [47, 50529], [51, 50589], [54, 50749], [58, 50929], [64, 51309], [67, 51389], [71, 51509], [79, 51829], [88, 52769], [95, 53109], [104, 53609], [107, 53709], [115, 54109], [118, 54249]]}, {"verse": 10, "start": 55100, "end": 65829, "text": "Pero por la gracia de Dios soy lo que soy: y su gracia no ha sido en vano para conmigo; antes he trabajado más que todos ellos: pero no yo, sino la gracia de Dios que fue conmigo.", "words": [[0, 55100], [5, 55248], [9, 55448], [12, 55568], [19, 55988], [22, 56108], [27, 56328], [31, 56668], [34, 56828], [38, 56948], [43, 57543], [45, 57632], [48, 57772], [55, 58232], [58, 58392], [61, 58512], [66, 58732], [69, 58952], [74, 59232], [79, 59412], [88, 60309], [94, 60651], [97, 60831], [107, 61411], [111, 61611], [115, 61831], [121, 62051], [128, 62884], [133, 63024], [136, 63244], [140, 63844], [145, 63964], [148, 64144], [155, 64544], [158, 64664], [163, 64844], [167, 65044], [171, 65204]]}, {"verse": 11, "start": 66179, "end": 70185, "text": "Porque, o sea yo o sean ellos, así predicamos, y así habéis creído.", "words": [[0, 66179], [8, 66387], [10, 66567], [14, 66727], [17, 66987], [19, 67127], [24, 67367], [31, 67587], [35, 67847], [47, 68507], [49, 68987], [53, 69187], [60, 69567]]}, {"verse": 12, "start": 70535, "end": 77737, "text": "Y si Cristo es predicado que resucitó de los muertos, ¿cómo dicen algunos entre vosotros que no hay resurrección de muertos?", "words": [[0, 70535], [2, 70657], [5, 70777], [12, 71177], [15, 71337], [25, 71937], [29, 72097], [38, 72757], [41, 72857], [45, 72977], [54, 74017], [60, 74157], [66, 74517], [74, 74877], [80, 75237], [89, 75757], [93, 75997], [96, 76237], [100, 76377], [113, 77077], [116, 77197]]}, {"verse": 13, "start": 78087, "end": 81741, "text": "Porque si no hay resurrección de muertos, Cristo tampoco resucitó:", "words": [[0, 78087], [7, 78263], [10, 78423], [13, 78603], [17, 78743], [30, 79423], [33, 79543], [42, 80163], [49, 80423], [57, 80843]]}, {"verse": 14, "start": 82091, "end": 87811, "text": "Y si Cristo no resucitó, vana es entonces nuestra predicación, vana es también vuestra fe.", "words": [[0, 82091], [2, 82212], [5, 82332], [12, 82672], [15, 82892], [25, 83482], [30, 84072], [33, 84192], [42, 84512], [50, 84892], [63, 85722], [68, 86552], [71, 86692], [79, 86952], [87, 87412]]}, {"verse": 15, "start": 88161, "end": 97908, "text": "Y aun somos hallados falsos testigos de Dios; porque hemos testificado de Dios que él haya levantado a Cristo; al cual no levantó, si en verdad los muertos no resucitan.", "words": [[0, 88161], [2, 88304], [6, 88424], [12, 88804], [21, 89264], [28, 89784], [37, 90224], [40, 90404], [46, 91076], [53, 91298], [59, 91538], [71, 92278], [74, 92418], [79, 92678], [83, 92938], [86, 93098], [91, 93238], [101, 93778], [103, 93878], [111, 94623], [114, 94751], [119, 94931], [122, 95131], [131, 95691], [134, 95951], [137, 96051], [144, 96291], [148, 96491], [156, 96891], [159, 97111]]}, {"verse": 16, "start": 98258, "end": 101923, "text": "Porque si los muertos no resucitan, tampoco Cristo resucitó:", "words": [[0, 98258], [7, 98441], [10, 98621], [14, 98781], [22, 99161], [25, 99381], [36, 100341], [44, 100601], [51, 101101]]}, {"verse": 17, "start": 102273, "end": 107189, "text": "Y si Cristo no resucitó, vuestra fe es vana; aún estáis en vuestros pecados.", "words": [[0, 102273], [2, 102375], [5, 102475], [12, 102815], [15, 102995], [25, 103735], [33, 104195], [36, 104415], [39, 104575], [45, 105233], [49, 105511], [56, 106031], [59, 106131], [68, 106431]]}, {"verse": 18, "start": 107539, "end": 110609, "text": "Entonces también los que durmieron en Cristo son perdidos.", "words": [[0, 107539], [9, 107960], [17, 108340], [21, 108540], [25, 108680], [35, 109120], [38, 109280], [45, 109560], [49, 109840]]}, {"verse": 19, "start": 110959, "end": 116683, "text": "Si en esta vida solamente esperamos en Cristo, somos los más dignos de compasión de todos los hombres.", "words": [[0, 110959], [3, 111140], [6, 111240], [11, 111500], [16, 111760], [26, 112140], [36, 112860], [39, 113020], [47, 113420], [53, 113765], [57, 114045], [61, 114265], [68, 114785], [71, 114885], [81, 115485], [84, 115645], [90, 115825], [94, 116085]]}, {"verse": 20, "start": 117033, "end": 122271, "text": "Pero ahora Cristo ha resucitado de los muertos; primicias de los que durmieron es hecho.", "words": [[0, 117033], [5, 117201], [11, 117501], [18, 117941], [21, 118201], [32, 118821], [35, 118941], [39, 119061], [48, 119934], [58, 120401], [61, 120601], [65, 120721], [69, 120901], [79, 121401], [82, 121741]]}, {"verse": 21, "start": 122621, "end": 128015, "text": "Porque por cuanto la muerte entró por un hombre, también por un hombre la resurrección de los muertos.", "words": [[0, 122621], [7, 122845], [11, 123065], [18, 123325], [21, 123545], [28, 123845], [34, 124405], [38, 124525], [41, 124685], [49, 125225], [57, 125525], [61, 125865], [64, 126005], [71, 126245], [74, 126385], [87, 127125], [90, 127245], [94, 127345]]}, {"verse": 22, "start": 128365, "end": 133618, "text": "Porque así como en Adam todos mueren, así también en Cristo todos serán vivificados.", "words": [[0, 128365], [7, 128543], [11, 128823], [16, 129103], [19, 129243], [24, 129483], [30, 129783], [38, 130503], [42, 130683], [50, 131043], [53, 131243], [60, 131583], [66, 131983], [72, 132363]]}, {"verse": 23, "start": 133968, "end": 140111, "text": "Pero cada uno en su orden: Cristo las primicias; luego los que son de Cristo, en su venida.", "words": [[0, 133968], [5, 134123], [10, 134403], [14, 134723], [17, 134923], [20, 135063], [27, 135865], [34, 136282], [38, 136502], [49, 137612], [55, 137811], [59, 138071], [63, 138191], [67, 138371], [70, 138571], [78, 138991], [81, 139251], [84, 139431]]}, {"verse": 24, "start": 140461, "end": 148328, "text": "Luego el fin; cuando entregará el reino a Dios y al Padre, cuando habrá quitado todo dominio, y toda autoridad y poder.", "words": [[0, 140461], [6, 140801], [9, 141001], [14, 141653], [21, 141863], [31, 142503], [34, 142643], [40, 142943], [42, 143083], [47, 143243], [49, 143423], [52, 143523], [59, 144303], [66, 144503], [72, 144823], [80, 145243], [85, 145503], [94, 146283], [96, 146583], [101, 146803], [111, 147463], [113, 147803]]}, {"verse": 25, "start": 148678, "end": 153716, "text": "Porque es necesario que él reine, hasta poner a todos sus enemigos debajo de sus pies.", "words": [[0, 148678], [7, 148904], [10, 149084], [20, 149644], [24, 149884], [27, 150024], [34, 150484], [40, 150984], [46, 151304], [48, 151464], [54, 151684], [58, 151944], [67, 152424], [74, 152844], [77, 152984], [81, 153124]]}, {"verse": 26, "start": 154066, "end": 157203, "text": "Y el último enemigo que será deshecho, será la muerte.", "words": [[0, 154066], [2, 154188], [5, 154348], [12, 154608], [20, 155128], [24, 155228], [29, 155658], [39, 156088], [44, 156488], [47, 156668]]}, {"verse": 27, "start": 157553, "end": 167223, "text": "Porque todas las cosas sujetó debajo de sus pies. Y cuando dice: Todas las cosas son sujetadas a él, claro está exceptuado aquel que sujetó a él todas las cosas.", "words": [[0, 157553], [7, 157761], [13, 158001], [17, 158281], [23, 158621], [30, 159141], [37, 159481], [40, 159621], [44, 159761], [50, 160568], [52, 160673], [59, 160873], [65, 161688], [71, 161971], [75, 162091], [81, 162391], [85, 162671], [95, 163251], [97, 163431], [101, 163851], [107, 164011], [112, 164271], [123, 164931], [129, 165271], [133, 165371], [140, 165891], [142, 165991], [145, 166111], [151, 166311], [155, 166611]]}, {"verse": 28, "start": 167573, "end": 177929, "text": "Pero luego que todas las cosas le estén sujetas, entonces también el mismo Hijo se sujetará al que le sujetó a él todas las cosas, para que Dios sea todas las cosas en todos.", "words": [[0, 167573], [5, 167710], [11, 167970], [15, 168190], [21, 168410], [25, 168710], [31, 169010], [34, 169270], [40, 169530], [49, 170430], [58, 170810], [66, 171390], [69, 171710], [75, 172030], [80, 172330], [83, 172530], [92, 173170], [95, 173430], [99, 173570], [102, 173690], [109, 174210], [111, 174310], [114, 174430], [120, 174670], [124, 174970], [131, 175781], [136, 175919], [140, 176079], [145, 176259], [149, 176539], [155, 176839], [159, 177079], [165, 177379], [168, 177619]]}, {"verse": 29, "start": 178279, "end": 186601, "text": "De otro modo, ¿qué harán los que se bautizan por los muertos, si en ninguna manera los muertos resucitan? ¿Por qué pues se bautizan por los muertos?", "words": [[0, 178279], [3, 178417], [8, 178637], [14, 179177], [19, 179277], [25, 179557], [29, 179677], [33, 179837], [36, 179977], [45, 180497], [49, 180617], [53, 180757], [62, 181617], [65, 181937], [68, 182037], [76, 182337], [83, 182737], [87, 182937], [95, 183337], [106, 184403], [111, 184522], [115, 184722], [120, 184942], [123, 185102], [132, 185602], [136, 185762], [140, 185902]]}, {"verse": 30, "start": 186951, "end": 189321, "text": "¿Y por qué nosotros peligramos a toda hora?", "words": [[0, 186951], [3, 187077], [7, 187257], [11, 187397], [20, 187797], [31, 188537], [33, 188697], [38, 188817]]}, {"verse": 31, "start": 189671, "end": 195094, "text": "Sí, por la gloria que en orden a vosotros tengo en Cristo Jesús Señor nuestro, cada día muero.", "words": [[0, 189671], [4, 190154], [8, 190294], [11, 190434], [18, 190774], [22, 190954], [25, 191114], [31, 191294], [33, 191514], [42, 191914], [48, 192194], [51, 192394], [58, 192634], [64, 193274], [70, 193474], [79, 194334], [84, 194434], [88, 194654]]}, {"verse": 32, "start": 195444, "end": 203956, "text": "Si como hombre batallé en Éfeso contra las bestias, ¿qué me aprovecha? Si los muertos no resucitan, comamos y bebamos, que mañana moriremos.", "words": [[0, 195444], [3, 195607], [8, 195827], [15, 196087], [23, 196627], [26, 196887], [32, 197147], [39, 197407], [43, 197627], [52, 198487], [57, 198567], [60, 198687], [71, 199560], [74, 199664], [78, 199824], [86, 200184], [89, 200404], [100, 201404], [108, 201884], [110, 202144], [119, 202784], [123, 202844], [130, 203144]]}, {"verse": 33, "start": 204306, "end": 207958, "text": "No erréis: las malas compañías corrompen las buenas costumbres.", "words": [[0, 204306], [3, 204652], [11, 205232], [15, 205332], [21, 205672], [31, 206252], [41, 206732], [45, 206892], [52, 207112]]}, {"verse": 34, "start": 208308, "end": 213993, "text": "Velad debidamente, y no pequéis; porque algunos no conocen a Dios: para vergüenza vuestra hablo.", "words": [[0, 208308], [6, 208626], [19, 209166], [21, 209406], [24, 209486], [33, 210388], [40, 210565], [48, 210885], [51, 211185], [59, 211645], [61, 211725], [67, 212457], [72, 212600], [82, 213120], [90, 213520]]}, {"verse": 35, "start": 214343, "end": 218826, "text": "Pero dirá alguno: ¿Cómo resucitarán los muertos? ¿Con qué cuerpo vendrán?", "words": [[0, 214343], [5, 214486], [10, 214786], [18, 215601], [24, 215779], [36, 216539], [40, 216639], [49, 217569], [54, 217685], [58, 217825], [65, 218105]]}, {"verse": 36, "start": 219176, "end": 222903, "text": "Necio, lo que tú siembras no se vivifica, si no muere antes.", "words": [[0, 219176], [7, 219580], [10, 219760], [14, 219900], [17, 220080], [26, 220500], [29, 220720], [32, 220880], [42, 221253], [45, 221627], [48, 222000], [54, 222320]]}, {"verse": 37, "start": 223253, "end": 230221, "text": "Y lo que siembras, no siembras el cuerpo que ha de salir, sino el grano desnudo, acaso de trigo, o de otro grano:", "words": [[0, 223253], [2, 223347], [5, 223447], [9, 223567], [19, 224407], [22, 224607], [31, 225147], [34, 225287], [41, 225587], [45, 225867], [48, 225987], [51, 226067], [58, 226747], [63, 226967], [66, 227167], [72, 227467], [81, 227977], [87, 228487], [90, 228667], [97, 229107], [99, 229367], [102, 229487], [107, 229727]]}, {"verse": 38, "start": 230571, "end": 234806, "text": "Pero Dios le da el cuerpo como quiso, y a cada semilla su propio cuerpo.", "words": [[0, 230571], [5, 230710], [10, 230950], [13, 231190], [16, 231350], [19, 231470], [26, 231770], [31, 232050], [38, 232490], [40, 232930], [42, 233070], [47, 233250], [55, 233770], [58, 233970], [65, 234230]]}, {"verse": 39, "start": 235156, "end": 244836, "text": "No toda carne es la misma carne; pero una carne ciertamente es la de los hombres, y otra carne la de los animales, y otra la de los peces, y otra la de las aves.", "words": [[0, 235156], [3, 235337], [8, 235537], [14, 235937], [17, 236177], [20, 236277], [26, 236477], [33, 237261], [38, 237401], [42, 237581], [48, 237901], [60, 238741], [63, 239101], [66, 239241], [69, 239341], [73, 239461], [82, 239881], [84, 240361], [89, 240501], [95, 240881], [98, 241021], [101, 241141], [105, 241241], [115, 242061], [117, 242301], [122, 242481], [125, 242621], [128, 242741], [132, 242841], [139, 243681], [141, 243721], [146, 243861], [149, 244021], [152, 244141], [156, 244261]]}, {"verse": 40, "start": 245186, "end": 253300, "text": "Y cuerpos hay celestiales, y cuerpos terrestres; pero ciertamente una es la gloria de los celestiales, y otra la de los terrestres.", "words": [[0, 245186], [2, 245283], [10, 245583], [14, 245883], [27, 246763], [29, 246963], [37, 247343], [49, 248336], [54, 248477], [66, 249277], [70, 249577], [73, 249877], [76, 250037], [83, 250417], [86, 250517], [90, 250637], [103, 251517], [105, 251797], [110, 252057], [113, 252217], [116, 252337], [120, 252457]]}, {"verse": 41, "start": 253650, "end": 261848, "text": "Otra es la gloria del sol, y otra la gloria de la luna, y otra la gloria de las estrellas: porque una estrella es diferente de otra en gloria.", "words": [[0, 253650], [5, 253952], [8, 254092], [11, 254232], [18, 254572], [22, 254732], [27, 255052], [29, 255432], [34, 255632], [37, 255792], [44, 256132], [47, 256272], [50, 256372], [56, 256732], [58, 257192], [63, 257392], [66, 257552], [73, 257932], [76, 258072], [80, 258212], [91, 259224], [98, 259421], [102, 259621], [111, 260101], [114, 260201], [124, 260561], [127, 260901], [132, 261121], [135, 261281]]}, {"verse": 42, "start": 262198, "end": 268274, "text": "Así también es la resurrección de los muertos. Se siembra en corrupción, se levantará en incorrupción;", "words": [[0, 262198], [4, 262419], [12, 262799], [15, 263039], [18, 263179], [31, 263859], [34, 263979], [38, 264099], [47, 264994], [50, 265156], [58, 265576], [61, 265636], [73, 266636], [76, 266716], [86, 267316], [89, 267416]]}, {"verse": 43, "start": 268624, "end": 274354, "text": "Se siembra en vergüenza, se levantará con gloria; se siembra en debilidad, se levantará con poder;", "words": [[0, 268624], [3, 268762], [11, 269222], [14, 269302], [25, 270122], [28, 270202], [38, 270722], [42, 270902], [50, 271704], [53, 271953], [61, 272243], [64, 272343], [75, 273043], [78, 273123], [88, 273623], [92, 273803]]}, {"verse": 44, "start": 274704, "end": 281530, "text": "Se siembra cuerpo natural, resucitará cuerpo espiritual. Hay cuerpo natural, y hay cuerpo espiritual.", "words": [[0, 274704], [3, 274864], [11, 275324], [18, 275564], [27, 276544], [38, 277264], [45, 277524], [57, 278660], [61, 278960], [68, 279280], [77, 279840], [79, 280160], [83, 280320], [90, 280600]]}, {"verse": 45, "start": 281880, "end": 288980, "text": "Así también está escrito: fue hecho el primer hombre Adam en alma viviente; el último Adam en espíritu que da vida.", "words": [[0, 281880], [4, 282220], [12, 282560], [17, 282840], [26, 283673], [30, 283831], [36, 284051], [39, 284171], [46, 284411], [53, 284751], [58, 285231], [61, 285551], [66, 285771], [76, 286761], [79, 286903], [86, 287223], [91, 287583], [94, 287803], [103, 288323], [107, 288423], [110, 288543]]}, {"verse": 46, "start": 289330, "end": 293420, "text": "Pero lo espiritual no es primero, sino lo natural; luego lo espiritual.", "words": [[0, 289330], [5, 289452], [8, 289612], [19, 290112], [22, 290352], [25, 290512], [34, 290892], [39, 291192], [42, 291352], [51, 292204], [57, 292453], [60, 292653]]}, {"verse": 47, "start": 293770, "end": 299609, "text": "El primer hombre, es de la tierra, formado de ella: el segundo hombre, que es el Señor, es del cielo.", "words": [[0, 293770], [3, 293886], [10, 294126], [18, 294466], [21, 294746], [24, 294866], [27, 294966], [35, 295306], [43, 295866], [46, 296066], [52, 296656], [55, 296736], [63, 297076], [71, 297536], [75, 297756], [78, 297896], [81, 298016], [88, 298396], [91, 298896], [95, 299056]]}, {"verse": 48, "start": 299959, "end": 307449, "text": "Como es el hombre hecho de tierra, así son también los hechos de tierra; y como es el celestial, así son también los celestiales.", "words": [[0, 299959], [5, 300163], [8, 300383], [11, 300523], [18, 300763], [24, 301063], [27, 301223], [35, 301923], [39, 302063], [43, 302343], [51, 302663], [55, 302843], [62, 303143], [65, 303303], [73, 304096], [75, 304199], [80, 304419], [83, 304579], [86, 304739], [97, 305659], [101, 305779], [105, 306019], [113, 306319], [117, 306519]]}, {"verse": 49, "start": 307799, "end": 312919, "text": "Y como hemos llevado la imagen del hombre hecho de tierra, también llevaremos la imagen del celestial.", "words": [[0, 307799], [2, 307898], [7, 308118], [13, 308318], [21, 308718], [24, 308838], [31, 309138], [35, 309358], [42, 309578], [48, 309838], [51, 309978], [59, 310778], [67, 310978], [78, 311538], [81, 311698], [88, 311978], [92, 312218]]}, {"verse": 50, "start": 313269, "end": 320217, "text": "Pero esto digo, hermanos: que la carne y la sangre no pueden heredar el reino de Dios; ni la corrupción hereda la incorrupción.", "words": [[0, 313269], [5, 313432], [10, 313672], [16, 313932], [26, 314892], [30, 314968], [33, 315088], [39, 315408], [41, 315588], [44, 315668], [51, 316008], [54, 316188], [61, 316508], [69, 316908], [72, 317028], [78, 317348], [81, 317468], [87, 318179], [90, 318300], [93, 318440], [104, 318980], [111, 319300], [114, 319440]]}, {"verse": 51, "start": 320567, "end": 325896, "text": "He aquí, os digo un misterio: Ciertamente no todos dormiremos, pero todos seremos transformados,", "words": [[0, 320607], [3, 320687], [9, 320827], [12, 321007], [17, 321207], [20, 321387], [30, 322228], [42, 322866], [45, 323046], [51, 323286], [63, 324186], [68, 324326], [74, 324666], [82, 325006]]}, {"verse": 52, "start": 326246, "end": 336857, "text": "En un momento, en un abrir y cerrar de ojos, a la final trompeta; porque será tocada la trompeta, y los muertos serán levantados sin corrupción, y nosotros seremos transformados.", "words": [[0, 326246], [3, 326367], [6, 326467], [15, 326927], [18, 327427], [21, 327547], [27, 327847], [29, 327987], [36, 328367], [39, 328527], [45, 328767], [47, 329107], [50, 329187], [56, 329427], [66, 330371], [73, 330551], [78, 330771], [85, 331231], [88, 331351], [98, 332031], [100, 332351], [104, 332471], [112, 332911], [118, 333231], [129, 333791], [133, 333971], [145, 334611], [147, 335011], [156, 335251], [164, 335811]]}, {"verse": 53, "start": 337207, "end": 344381, "text": "Porque es necesario que esto corruptible sea vestido de incorrupción, y esto mortal sea vestido de inmortalidad.", "words": [[0, 337207], [7, 337391], [10, 337571], [20, 338071], [24, 338311], [29, 338511], [41, 339191], [45, 339411], [53, 339891], [56, 340031], [70, 340711], [72, 341111], [77, 341391], [84, 341751], [88, 342031], [96, 342531], [99, 342651]]}, {"verse": 54, "start": 344731, "end": 355778, "text": "Y cuando esto corruptible se haya vestido de incorrupción, y esto mortal se haya vestido de inmortalidad, entonces se efectuará la palabra que está escrita: La muerte ha sido tragada en victoria.", "words": [[0, 344731], [2, 344862], [9, 345102], [14, 345422], [26, 346082], [29, 346302], [34, 346422], [42, 346902], [45, 347062], [59, 347762], [61, 348062], [66, 348302], [73, 348662], [76, 348922], [81, 349062], [89, 349502], [92, 349622], [106, 350622], [115, 350942], [118, 351342], [128, 351862], [131, 351962], [139, 352322], [143, 352502], [148, 352702], [157, 353572], [160, 353677], [167, 354017], [170, 354377], [175, 354577], [183, 355057], [186, 355157]]}, {"verse": 55, "start": 356128, "end": 360340, "text": "¿Dónde está, oh muerte, tu aguijón? ¿dónde, oh sepulcro, tu victoria?", "words": [[0, 356128], [7, 356434], [13, 356644], [16, 356854], [24, 357234], [27, 357434], [36, 358340], [44, 358678], [47, 359052], [57, 359425], [60, 359605]]}, {"verse": 56, "start": 360690, "end": 364937, "text": "Ya que el aguijón de la muerte es el pecado, y el poder del pecado, la ley.", "words": [[0, 360690], [3, 360835], [7, 361015], [10, 361155], [18, 361595], [21, 361695], [24, 361815], [31, 362115], [34, 362395], [37, 362535], [45, 363055], [47, 363355], [50, 363475], [56, 363735], [60, 363935], [68, 364435], [71, 364595]]}, {"verse": 57, "start": 365287, "end": 369731, "text": "Pero a Dios gracias, que nos da la victoria por el Señor nuestro Jesucristo.", "words": [[0, 365287], [5, 365492], [7, 365698], [12, 365905], [21, 366725], [25, 366845], [29, 367025], [32, 367225], [35, 367325], [44, 367865], [48, 368065], [51, 368205], [57, 368425], [65, 368745]]}, {"verse": 58, "start": 370081, "end": 379302, "text": "Así que, hermanos míos amados, estad firmes y constantes, creciendo en la obra del Señor siempre, sabiendo que vuestro trabajo en el Señor no es vano.", "words": [[0, 370081], [4, 370275], [9, 370495], [18, 370855], [23, 371195], [31, 371825], [37, 372455], [44, 373055], [46, 373135], [58, 373915], [68, 374595], [71, 374735], [74, 374835], [79, 375075], [83, 375255], [89, 375535], [98, 376515], [107, 376935], [111, 377115], [119, 377435], [127, 377815], [130, 377995], [133, 378095], [139, 378335], [142, 378715], [145, 378875]]}]}