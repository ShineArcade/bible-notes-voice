{"book": "LUK", "chapter": 4, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 305920, "verses": [{"verse": 1, "start": 300, "end": 6162, "text": "And Jesus being full of the Holy Spirit returned from Jordan, and was led by the Spirit into the wilderness,", "words": [[0, 300], [4, 428], [10, 728], [16, 1068], [21, 1408], [24, 1528], [28, 1648], [33, 1828], [40, 2248], [49, 2688], [54, 2928], [62, 3308], [66, 3888], [70, 4028], [74, 4248], [77, 4468], [81, 4628], [88, 4968], [93, 5288], [97, 5468]]}, {"verse": 2, "start": 6512, "end": 13536, "text": "Being forty days tempted of the devil. And in those days he did eat nothing: and when they were ended, he afterward was hungry.", "words": [[0, 6512], [6, 6755], [12, 7035], [17, 7395], [25, 7775], [28, 8035], [32, 8135], [39, 8818], [43, 8947], [46, 9047], [52, 9247], [57, 9567], [60, 9807], [64, 10007], [68, 10187], [77, 10958], [81, 11081], [86, 11221], [91, 11401], [96, 11541], [103, 12041], [106, 12141], [116, 12601], [120, 12961]]}, {"verse": 3, "start": 13886, "end": 19263, "text": "And the devil said to him, If you be the Son of God, command this stone that it be made bread.", "words": [[0, 13886], [4, 13982], [8, 14082], [14, 14342], [19, 14642], [22, 14862], [27, 15411], [30, 15551], [34, 15671], [37, 15831], [41, 15991], [45, 16231], [48, 16351], [53, 17111], [61, 17411], [66, 17731], [72, 18031], [77, 18231], [80, 18331], [83, 18491], [88, 18731]]}, {"verse": 4, "start": 19543, "end": 27350, "text": "And Jesus answered him, saying, It is written, That man shall not live by bread alone, but by every word of God.", "words": [[0, 19543], [4, 19694], [10, 20014], [19, 20534], [24, 20934], [32, 22546], [35, 22670], [38, 22810], [47, 23130], [52, 23390], [56, 23730], [62, 23990], [66, 24230], [71, 24490], [74, 24730], [80, 24970], [87, 25590], [91, 25950], [94, 26150], [100, 26490], [105, 26770], [108, 26870]]}, {"verse": 5, "start": 27630, "end": 33761, "text": "And the devil, taking him up into a high mountain, showed to him all the kingdoms of the world in a moment of time.", "words": [[0, 27630], [4, 27761], [8, 27881], [15, 28201], [22, 28561], [26, 28821], [29, 29001], [34, 29241], [36, 29421], [41, 29621], [51, 30001], [58, 30421], [61, 30701], [65, 30881], [69, 31241], [73, 31441], [82, 31761], [85, 32081], [89, 32201], [95, 32541], [98, 32721], [100, 32801], [107, 33061], [110, 33261]]}, {"verse": 6, "start": 34111, "end": 42422, "text": "And the devil said to him, All this power will I give you, and the glory of them: for that is delivered to me; and to whomsoever I will I give it.", "words": [[0, 34111], [4, 34250], [8, 34350], [14, 34630], [19, 34930], [22, 35170], [27, 35762], [31, 35969], [36, 36169], [42, 36449], [47, 36709], [49, 36849], [54, 37049], [59, 37249], [63, 37629], [67, 37769], [73, 38009], [76, 38229], [82, 38953], [86, 39060], [91, 39260], [94, 39460], [104, 39820], [107, 40040], [111, 40535], [115, 40702], [118, 41042], [129, 41382], [131, 41622], [136, 41782], [138, 41922], [143, 42062]]}, {"verse": 7, "start": 42772, "end": 45764, "text": "If you therefore will worship me, all shall be yours.", "words": [[0, 42772], [3, 42900], [7, 43000], [17, 43300], [22, 43560], [30, 43900], [34, 44540], [38, 44760], [44, 45020], [47, 45220]]}, {"verse": 8, "start": 46044, "end": 54155, "text": "And Jesus answered and said to him, Get behind me, Satan: for it is written, You shall worship the Lord your God, and him only shall you serve.", "words": [[0, 46044], [4, 46208], [10, 46528], [19, 47148], [23, 47348], [28, 47648], [31, 47848], [36, 48389], [40, 48510], [47, 48810], [51, 49070], [58, 49724], [62, 49832], [65, 49952], [68, 50072], [77, 50652], [81, 50812], [87, 51012], [95, 51352], [99, 51552], [104, 51772], [109, 51932], [114, 52592], [118, 52652], [122, 52852], [127, 53172], [133, 53432], [137, 53632]]}, {"verse": 9, "start": 54435, "end": 62466, "text": "And he brought him to Jerusalem, and set him on a pinnacle of the temple, and said to him, If you be the Son of God, cast yourself down from here:", "words": [[0, 54435], [4, 54569], [7, 54669], [15, 54909], [19, 55109], [22, 55269], [33, 55869], [37, 56409], [41, 56609], [45, 56789], [48, 56929], [50, 57009], [59, 57469], [62, 57669], [66, 57789], [74, 58109], [78, 58589], [83, 58809], [86, 58989], [91, 59517], [94, 59691], [98, 59811], [101, 59911], [105, 60031], [109, 60251], [112, 60371], [117, 60951], [122, 61171], [131, 61571], [136, 61851], [141, 62091]]}, {"verse": 10, "start": 62816, "end": 65832, "text": "For it is written, He shall give his angels charge over you, to keep you:", "words": [[0, 62816], [4, 62917], [7, 63037], [10, 63137], [19, 63577], [22, 63637], [28, 63817], [33, 63957], [37, 64077], [44, 64377], [51, 64657], [56, 64937], [61, 65117], [64, 65317], [69, 65537]]}, {"verse": 11, "start": 66182, "end": 71308, "text": "And in their hands they shall bear you up, lest at any time you dash your foot against a stone.", "words": [[0, 66182], [4, 66300], [7, 66410], [13, 66520], [19, 66840], [24, 67040], [30, 67220], [35, 67600], [39, 67800], [43, 68320], [48, 68520], [51, 68720], [55, 69020], [60, 69340], [64, 69480], [69, 69760], [74, 69940], [79, 70140], [87, 70370], [89, 70600]]}, {"verse": 12, "start": 71588, "end": 76682, "text": "And Jesus answering said to him, It is said, You shall not tempt the Lord your God.", "words": [[0, 71588], [4, 71733], [10, 72053], [20, 72593], [25, 72873], [28, 73053], [33, 73373], [36, 73533], [39, 73673], [45, 74053], [49, 74737], [55, 74914], [59, 75174], [65, 75454], [69, 75674], [74, 75934], [79, 76134]]}, {"verse": 13, "start": 76962, "end": 81709, "text": "And when the devil had ended all the temptation, he departed from him for a season.", "words": [[0, 76962], [4, 77087], [9, 77247], [13, 77387], [19, 77667], [23, 77907], [29, 78267], [33, 78547], [37, 78687], [49, 79747], [52, 79827], [61, 80267], [66, 80607], [70, 80827], [74, 81087], [76, 81207]]}, {"verse": 14, "start": 82059, "end": 89268, "text": "¶ And Jesus returned in the power of the Spirit into Galilee: and there went out a fame of him through all the region round about.", "words": [[2, 82059], [6, 82203], [12, 82543], [21, 83023], [24, 83283], [28, 83383], [34, 83723], [37, 83943], [41, 84083], [48, 84463], [53, 84763], [62, 85890], [66, 86020], [72, 86140], [77, 86320], [81, 86520], [83, 86640], [88, 86900], [91, 87120], [95, 87280], [103, 87500], [107, 87840], [111, 88020], [118, 88457], [124, 88894]]}, {"verse": 15, "start": 89618, "end": 92967, "text": "And he taught in their synagogues, being glorified of all.", "words": [[0, 89618], [4, 89746], [7, 89866], [14, 90146], [17, 90326], [23, 90446], [35, 91406], [41, 91626], [51, 92366], [54, 92586]]}, {"verse": 16, "start": 93317, "end": 101143, "text": "¶ And he came to Nazareth, where he had been brought up: and, as his custom was, he went into the synagogue on the sabbath day, and stood up to read.", "words": [[2, 93317], [6, 93453], [9, 93553], [14, 93773], [17, 93913], [27, 94433], [33, 94693], [36, 94873], [40, 94993], [45, 95113], [53, 95373], [57, 95972], [62, 96235], [65, 96515], [69, 96655], [76, 97015], [81, 97475], [84, 97555], [89, 97755], [94, 97975], [98, 98135], [108, 98535], [111, 98855], [115, 98955], [123, 99255], [128, 99675], [132, 100055], [138, 100295], [141, 100475], [144, 100655]]}, {"verse": 17, "start": 101493, "end": 108153, "text": "And there was delivered to him the book of the prophet Esaias. And when he had opened the book, he found the place where it was written,", "words": [[0, 101493], [4, 101644], [10, 101744], [14, 101904], [24, 102304], [27, 102564], [31, 102724], [35, 102924], [40, 103144], [43, 103264], [47, 103404], [55, 104033], [63, 104816], [67, 104957], [72, 105117], [75, 105297], [79, 105397], [86, 105617], [90, 105837], [96, 106337], [99, 106477], [105, 106737], [109, 106917], [115, 107157], [121, 107437], [124, 107537], [128, 107697]]}, {"verse": 18, "start": 108353, "end": 122930, "text": "The Spirit of the Lord is upon me, because he has anointed me to preach the gospel to the poor; he has sent me to heal the brokenhearted, to preach deliverance to the captives, and recovering of sight to the blind, to set at liberty them that are bruised,", "words": [[0, 108353], [4, 108452], [11, 108832], [14, 108992], [18, 109152], [23, 109472], [26, 109672], [31, 109992], [35, 110312], [43, 110872], [46, 111092], [50, 111252], [59, 111672], [62, 111952], [65, 112112], [72, 112392], [76, 112612], [83, 113032], [86, 113232], [90, 113352], [96, 114044], [99, 114144], [103, 114304], [108, 114564], [111, 114744], [114, 114924], [119, 115144], [123, 115304], [138, 116424], [141, 116624], [148, 116904], [160, 117524], [163, 117664], [167, 117784], [177, 118724], [181, 118824], [192, 119224], [195, 119504], [201, 119784], [204, 119984], [208, 120064], [215, 120964], [218, 121064], [222, 121264], [225, 121364], [233, 121664], [238, 122024], [243, 122204], [247, 122304]]}, {"verse": 19, "start": 123280, "end": 125873, "text": "To preach the acceptable year of the Lord.", "words": [[0, 123280], [3, 123398], [10, 123718], [14, 123978], [25, 124598], [30, 125038], [33, 125218], [37, 125338]]}, {"verse": 20, "start": 126153, "end": 134545, "text": "And he closed the book, and he gave it again to the minister, and sat down. And the eyes of all them that were in the synagogue were fastened on him.", "words": [[0, 126153], [4, 126306], [7, 126406], [14, 126686], [18, 126926], [24, 127686], [28, 127766], [31, 127906], [36, 128066], [39, 128226], [45, 128466], [48, 128626], [52, 128726], [62, 129106], [66, 129706], [70, 129986], [76, 130837], [80, 130983], [84, 131103], [89, 131423], [92, 131663], [96, 131843], [101, 132083], [106, 132323], [111, 132483], [114, 132603], [118, 132683], [128, 133143], [133, 133463], [142, 133963], [145, 134123]]}, {"verse": 21, "start": 134895, "end": 139438, "text": "And he began to say to them, This day is this scripture fulfilled in your ears.", "words": [[0, 134895], [4, 135025], [7, 135125], [13, 135405], [16, 135585], [20, 135785], [23, 135945], [29, 136447], [34, 136644], [38, 136944], [41, 137194], [46, 137444], [56, 137864], [66, 138404], [69, 138724], [74, 138844]]}, {"verse": 22, "start": 139718, "end": 147932, "text": "And all bore him witness, and wondered at the gracious words which proceeded out of his mouth. And they said, Is not this Joseph’s son?", "words": [[0, 139718], [4, 139837], [8, 140137], [13, 140477], [17, 140657], [26, 141437], [30, 141697], [39, 142057], [42, 142277], [46, 142377], [55, 142737], [61, 143217], [67, 143517], [77, 144037], [81, 144317], [84, 144457], [88, 144557], [95, 145217], [99, 145497], [104, 145657], [110, 146381], [113, 146533], [117, 146813], [122, 147093], [131, 147633]]}, {"verse": 23, "start": 148212, "end": 156581, "text": "And he said to them, You will surely say to me this proverb, Physician, heal yourself: whatever we have heard done in Capernaum, do also here in your country.", "words": [[0, 148212], [4, 148343], [7, 148463], [12, 148703], [15, 148903], [21, 149448], [25, 149554], [30, 149674], [37, 149994], [41, 150234], [44, 150354], [47, 150474], [52, 150674], [61, 151294], [72, 152114], [77, 152254], [87, 153069], [96, 153297], [99, 153497], [104, 153617], [110, 153797], [115, 154037], [118, 154547], [129, 155057], [132, 155137], [137, 155497], [142, 155777], [145, 155937], [150, 156037]]}, {"verse": 24, "start": 156861, "end": 162512, "text": "And he said, Assuredly I say to you, No prophet is accepted in his own country.", "words": [[0, 156861], [4, 156995], [7, 157135], [13, 158544], [23, 159126], [25, 159246], [29, 159446], [32, 159626], [37, 160206], [40, 160386], [48, 160786], [51, 161046], [60, 161486], [63, 161686], [67, 161846], [71, 161966]]}, {"verse": 25, "start": 162862, "end": 173271, "text": "But I tell you of a truth, many widows were in Israel in the days of Elias, when the heaven was shut up three years and six months, when great famine was throughout all the land;", "words": [[0, 162862], [4, 162963], [6, 163083], [11, 163363], [15, 163563], [18, 163743], [20, 163823], [27, 164723], [32, 164943], [39, 165443], [44, 165643], [47, 165783], [54, 166203], [57, 166503], [61, 166603], [66, 166863], [69, 167003], [76, 167703], [81, 167903], [85, 168023], [92, 168243], [96, 168443], [101, 168703], [104, 168843], [110, 169083], [116, 169443], [120, 169663], [124, 169863], [132, 170660], [137, 170777], [143, 171077], [150, 171497], [154, 171777], [165, 172057], [169, 172517], [173, 172697]]}, {"verse": 26, "start": 173621, "end": 179428, "text": "But to none of them was Elias sent, save to Sarepta, a city of Sidon, to a woman that was a widow.", "words": [[0, 173621], [4, 173725], [7, 173865], [12, 174045], [15, 174205], [20, 174325], [24, 174605], [30, 174885], [36, 175335], [41, 175785], [44, 176005], [53, 176745], [55, 176845], [60, 177065], [63, 177225], [70, 177985], [73, 178125], [75, 178245], [81, 178445], [86, 178665], [90, 178845], [92, 178925]]}, {"verse": 27, "start": 179778, "end": 186414, "text": "And many lepers were in Israel in the time of Eliseus the prophet; and none of them was cleansed, saving Naaman the Syrian.", "words": [[0, 179778], [4, 179916], [9, 180136], [16, 180516], [21, 180756], [24, 180856], [31, 181196], [34, 181516], [38, 181616], [43, 181876], [46, 182206], [54, 182536], [58, 182716], [67, 183480], [71, 183624], [76, 183844], [79, 183964], [84, 184124], [88, 184284], [98, 184964], [105, 185284], [112, 185704], [116, 185844]]}, {"verse": 28, "start": 186694, "end": 191099, "text": "And all they in the synagogue, when they heard these things, were filled with wrath,", "words": [[0, 186694], [4, 186809], [8, 187089], [13, 187329], [16, 187569], [20, 187689], [31, 188609], [36, 188849], [41, 189009], [47, 189249], [53, 189449], [61, 190049], [66, 190189], [73, 190429], [78, 190669]]}, {"verse": 29, "start": 191449, "end": 198979, "text": "And rose up, and thrust him out of the city, and led him to the brow of the hill on which their city was built, that they might cast him down headlong.", "words": [[0, 191449], [4, 191575], [9, 191795], [13, 192075], [17, 192195], [24, 192435], [28, 192715], [32, 192855], [35, 192975], [39, 193095], [45, 193695], [49, 193935], [53, 194115], [57, 194275], [60, 194415], [64, 194535], [69, 194755], [72, 194955], [76, 195095], [81, 195315], [84, 195555], [90, 195715], [96, 195895], [101, 196155], [105, 196355], [112, 197087], [117, 197192], [122, 197312], [128, 197492], [133, 197872], [137, 198052], [142, 198272]]}, {"verse": 30, "start": 199329, "end": 202070, "text": "But he passing through the midst of them went his way,", "words": [[0, 199329], [4, 199455], [7, 199575], [15, 199975], [23, 200295], [27, 200455], [33, 200675], [36, 200895], [41, 201095], [46, 201315], [50, 201535]]}, {"verse": 31, "start": 202420, "end": 207736, "text": "And came down to Capernaum, a city of Galilee, and taught them on the sabbath days.", "words": [[0, 202420], [4, 202547], [9, 202787], [14, 203087], [17, 203697], [28, 204307], [30, 204427], [35, 204687], [38, 204867], [47, 205947], [51, 206007], [58, 206247], [63, 206467], [66, 206607], [70, 206747], [78, 207027]]}, {"verse": 32, "start": 208086, "end": 212086, "text": "And they were astonished at his doctrine: for his word was with power.", "words": [[0, 208086], [4, 208213], [9, 208333], [14, 208513], [25, 209113], [28, 209253], [32, 209373], [42, 210240], [46, 210365], [50, 210525], [55, 210925], [59, 211225], [64, 211425]]}, {"verse": 33, "start": 212436, "end": 216860, "text": "¶ And in the synagogue there was a man, which had a spirit of an unclean demon, and cried out with a loud voice,", "words": [[2, 212436], [6, 212580], [9, 212720], [13, 212820], [23, 213200], [29, 213580], [33, 213740], [35, 213860], [40, 214200], [46, 214720], [50, 214880], [52, 214960], [59, 215320], [62, 215540], [65, 215640], [73, 216240], [80, 216317], [84, 216395], [90, 216472], [94, 216550], [99, 216627], [101, 216705], [106, 216782]]}, {"verse": 34, "start": 217210, "end": 227532, "text": "Saying, Let us alone; what have we to do with you, you Jesus of Nazareth? are you come to destroy us? I know you who you are; the Holy One of God.", "words": [[0, 218947], [8, 219660], [12, 219836], [15, 220016], [22, 220771], [27, 220897], [32, 221057], [35, 221197], [38, 221317], [41, 221437], [46, 221637], [51, 221937], [55, 222077], [61, 222357], [64, 222617], [74, 223427], [78, 223530], [82, 223650], [87, 223850], [90, 223990], [98, 224310], [102, 224973], [104, 225095], [109, 225295], [113, 225495], [117, 225675], [121, 225815], [126, 226412], [130, 226514], [135, 226754], [139, 226994], [142, 227094]]}, {"verse": 35, "start": 227812, "end": 236923, "text": "And Jesus rebuked him, saying, Be quiet, and come out of him. And when the demon had thrown him in the midst, he came out of him, and hurt him not.", "words": [[0, 227812], [4, 227957], [10, 228297], [18, 229037], [23, 229277], [31, 229964], [34, 230173], [41, 230633], [45, 231173], [50, 231413], [54, 231653], [57, 231793], [62, 232431], [66, 232556], [71, 232696], [75, 232836], [81, 233136], [85, 233356], [92, 233596], [96, 233816], [99, 233956], [103, 234036], [110, 234816], [113, 234896], [118, 235136], [122, 235416], [125, 235536], [130, 235736], [134, 236036], [139, 236296], [143, 236456]]}, {"verse": 36, "start": 237273, "end": 246540, "text": "And they were all amazed, and spoke among themselves, saying, What a word is this! for with authority and power he commands the unclean spirits, and they come out.", "words": [[0, 237273], [4, 237613], [9, 237733], [14, 237933], [18, 238113], [26, 238513], [30, 239033], [36, 239353], [42, 239613], [54, 240413], [62, 241041], [67, 241187], [69, 241287], [74, 241487], [77, 241667], [83, 242401], [87, 242520], [92, 242840], [102, 243320], [106, 243560], [112, 243920], [115, 244180], [124, 244540], [128, 244760], [136, 245260], [145, 245580], [149, 245900], [154, 246020], [159, 246180]]}, {"verse": 37, "start": 246820, "end": 250541, "text": "And the fame of him went out into every place of the country round about.", "words": [[0, 246820], [4, 246955], [8, 247055], [13, 247335], [16, 247515], [20, 247695], [25, 247915], [29, 248095], [34, 248315], [40, 248775], [46, 249135], [49, 249295], [53, 249395], [61, 249777], [67, 250159]]}, {"verse": 38, "start": 250891, "end": 259458, "text": "¶ And he arose out of the synagogue, and entered into Simon’s house. And Simon’s wife’s mother was taken with a great fever; and they besought him for her.", "words": [[2, 250891], [6, 251038], [9, 251228], [15, 251418], [19, 251698], [22, 251798], [26, 251898], [37, 252298], [41, 252798], [49, 253138], [54, 253418], [62, 253938], [69, 254678], [73, 254829], [81, 255349], [88, 255709], [95, 255969], [99, 256249], [105, 256549], [110, 256789], [112, 256909], [118, 257109], [125, 258003], [129, 258139], [134, 258279], [143, 258719], [147, 258919], [151, 259179]]}, {"verse": 39, "start": 259808, "end": 266763, "text": "And he stood over her, and rebuked the fever; and it left her: and immediately she arose and ministered to them.", "words": [[0, 259808], [4, 259952], [7, 260072], [13, 260332], [18, 260612], [23, 260872], [27, 261252], [35, 261812], [39, 261932], [46, 262664], [50, 262808], [53, 262928], [58, 263168], [63, 263744], [67, 263909], [79, 264209], [83, 264769], [89, 265189], [93, 265629], [104, 266209], [107, 266329]]}, {"verse": 40, "start": 267113, "end": 276117, "text": "¶ Now when the sun was setting, all they that had any sick with various diseases brought them to him; and he laid his hands on every one of them, and healed them.", "words": [[2, 267113], [6, 267337], [11, 267577], [15, 267717], [19, 267937], [23, 268117], [32, 268737], [36, 269177], [41, 269417], [46, 269597], [50, 269777], [54, 270057], [59, 270337], [64, 270617], [72, 271037], [81, 271677], [89, 272057], [94, 272337], [97, 