{"book": "JHN", "chapter": 8, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 472479, "verses": [{"verse": 1, "start": 300, "end": 3196, "text": "Y Jesús se fue al monte de los Olivos.", "words": [[0, 300], [2, 466], [8, 826], [11, 1446], [15, 1686], [18, 1866], [24, 2206], [27, 2426], [31, 2566]]}, {"verse": 2, "start": 3546, "end": 10311, "text": "Y por la mañana volvió al templo, y todo el pueblo vino a él: y sentado él, los enseñaba.", "words": [[0, 3546], [2, 3650], [6, 3810], [9, 3970], [16, 4290], [23, 4790], [26, 4930], [34, 5690], [36, 5850], [41, 6110], [44, 6310], [51, 6590], [56, 6990], [58, 7250], [62, 7847], [64, 7951], [72, 8491], [76, 8771], [80, 9231]]}, {"verse": 3, "start": 10661, "end": 18129, "text": "Entonces los escribas y los fariseos le traen una mujer sorprendida en adulterio; y poniéndola en medio,", "words": [[0, 10661], [9, 11105], [13, 11365], [22, 12025], [24, 12165], [28, 12305], [37, 13065], [40, 13545], [46, 13985], [50, 14145], [56, 14405], [68, 15305], [71, 15425], [82, 16485], [84, 16589], [95, 17269], [98, 17469]]}, {"verse": 4, "start": 18479, "end": 23132, "text": "Le dicen: Maestro, esta mujer ha sido sorprendida en el acto de adulterio;", "words": [[0, 18479], [3, 18876], [10, 19506], [19, 19907], [24, 20127], [30, 20427], [33, 20687], [38, 20867], [50, 21667], [53, 21867], [56, 21987], [61, 22307], [64, 22387]]}, {"verse": 5, "start": 23482, "end": 27883, "text": "Y en la ley Moisés nos mandó apedrear a las tales: tú pues, ¿qué dices?", "words": [[0, 23482], [2, 23583], [5, 23663], [8, 23783], [12, 23963], [19, 24383], [23, 24723], [29, 25173], [38, 25623], [40, 25683], [44, 25823], [51, 26644], [54, 26762], [60, 27302], [65, 27382]]}, {"verse": 6, "start": 28163, "end": 36863, "text": "Pero esto decían tentándole, para poder acusarle. Pero Jesús, inclinado hacia abajo, escribía en tierra con el dedo.", "words": [[0, 28163], [5, 28307], [10, 28867], [17, 29427], [29, 29987], [34, 30887], [40, 31227], [50, 32380], [55, 32524], [62, 33204], [72, 33844], [78, 34064], [85, 34664], [94, 35284], [97, 35444], [104, 35784], [108, 36104], [111, 36284]]}, {"verse": 7, "start": 37213, "end": 46997, "text": "Y como perseverasen preguntándole, se enderezó, y les dijo: El que de vosotros esté sin pecado, arroje contra ella la piedra el primero.", "words": [[0, 37213], [2, 37477], [7, 38027], [20, 38577], [35, 39127], [38, 39677], [48, 40497], [50, 40817], [54, 40937], [60, 41751], [63, 41910], [67, 42090], [70, 42230], [79, 42650], [84, 43070], [88, 43490], [96, 43910], [103, 44890], [110, 45270], [115, 45570], [118, 45810], [125, 46270], [128, 46390]]}, {"verse": 8, "start": 47347, "end": 51606, "text": "Y volviéndose a inclinar hacia abajo, escribía en tierra.", "words": [[0, 47347], [2, 47446], [14, 48086], [16, 48406], [25, 48726], [31, 49106], [38, 49566], [47, 50786], [50, 50946]]}, {"verse": 9, "start": 51956, "end": 63741, "text": "Oyendo, pues, ellos, acusados por su conciencia, se salían uno a uno, comenzando desde los más viejos hasta los últimos: y quedó solo Jesús, y la mujer que estaba en medio.", "words": [[0, 51956], [8, 52343], [14, 52583], [21, 53443], [30, 53883], [34, 54123], [37, 54283], [49, 55303], [52, 55383], [59, 55883], [63, 56243], [65, 56523], [70, 56763], [81, 57543], [87, 57903], [91, 58243], [95, 58503], [102, 59043], [108, 59363], [112, 59583], [121, 60585], [123, 60721], [129, 61081], [134, 61301], [141, 61781], [143, 62241], [146, 62341], [152, 62601], [156, 62801], [163, 62981], [166, 63161]]}, {"verse": 10, "start": 64091, "end": 72935, "text": "Y enderezándose Jesús, y no viendo a nadie más que a la mujer, le dijo: ¿Mujer, dónde están los que te acusaban? ¿Ninguno te ha condenado?", "words": [[0, 64091], [2, 64253], [16, 65133], [23, 65533], [25, 65933], [28, 66073], [35, 66333], [37, 66513], [43, 66773], [47, 66993], [51, 67193], [53, 67293], [56, 67333], [63, 68113], [66, 68313], [72, 69099], [80, 69447], [86, 69627], [92, 70027], [96, 70227], [100, 70387], [103, 70487], [113, 71492], [122, 71882], [125, 72062], [128, 72162]]}, {"verse": 11, "start": 73285, "end": 82316, "text": "Y ella dijo: Señor, ninguno. Entonces Jesús le dijo: Ni yo te condeno: vete, y no peques más.", "words": [[0, 73285], [2, 73455], [7, 73625], [13, 74393], [20, 74794], [29, 76899], [38, 77383], [44, 78063], [47, 78503], [53, 79320], [56, 79575], [59, 79829], [62, 80083], [71, 80502], [77, 80950], [79, 81330], [82, 81510], [89, 81790]]}, {"verse": 12, "start": 82666, "end": 92995, "text": "Y les habló Jesús otra vez, diciendo: Yo soy la luz del mundo: el que me sigue, no andará en tinieblas, sino que tendrá la luz de la vida.", "words": [[0, 82666], [2, 82771], [6, 82931], [12, 83291], [18, 83491], [23, 83831], [28, 84131], [38, 85260], [41, 85505], [45, 85805], [48, 86165], [52, 86425], [56, 86745], [63, 87500], [66, 87662], [70, 87802], [73, 87982], [80, 88842], [83, 89062], [90, 89402], [93, 89982], [104, 90562], [109, 90722], [113, 90922], [120, 91382], [123, 91542], [127, 91962], [130, 92362], [133, 92482]]}, {"verse": 13, "start": 93345, "end": 100108, "text": "Entonces los fariseos le dijeron: Tú de ti mismo das testimonio: tu testimonio no es verdadero.", "words": [[0, 93345], [9, 94034], [13, 94614], [22, 95474], [25, 95654], [34, 96414], [37, 96530], [40, 96690], [43, 96850], [49, 97130], [53, 97410], [65, 98494], [68, 98596], [79, 99176], [82, 99316], [85, 99436]]}, {"verse": 14, "start": 100388, "end": 113890, "text": "Respondió Jesús, y les dijo: Aunque yo doy testimonio de mí mismo, mi testimonio es verdadero, porque sé de dónde he venido y a dónde voy; pero vosotros no sabéis de dónde vengo, y a dónde voy.", "words": [[0, 100678], [10, 100968], [17, 101308], [19, 101648], [23, 101788], [29, 102528], [36, 102908], [39, 103188], [43, 103428], [54, 104128], [57, 104248], [60, 104408], [67, 105288], [70, 105528], [81, 106208], [84, 106288], [95, 106948], [102, 107448], [105, 107728], [108, 107908], [114, 108128], [117, 108468], [124, 109028], [126, 109348], [128, 109428], [134, 109668], [139, 110430], [144, 110594], [153, 111054], [156, 111214], [163, 111674], [166, 111874], [172, 112054], [179, 112614], [181, 113094], [183, 113234], [189, 113414]]}, {"verse": 15, "start": 114240, "end": 118627, "text": "Vosotros según la carne juzgáis; pero yo no juzgo a nadie.", "words": [[0, 114240], [9, 115127], [15, 115347], [18, 115587], [24, 115927], [33, 117084], [38, 117250], [41, 117430], [44, 117550], [50, 117970], [52, 118090]]}, {"verse": 16, "start": 118977, "end": 127053, "text": "Y si yo juzgo, mi juicio es verdadero; porque no soy solo, sino yo y el que me envió, el Padre.", "words": [[0, 118977], [2, 119125], [5, 119225], [8, 119385], [15, 120305], [18, 120425], [25, 120845], [28, 121305], [39, 122524], [46, 122748], [49, 122968], [53, 123188], [59, 124068], [64, 124388], [67, 125068], [69, 125313], [72, 125473], [76, 125633], [79, 125793], [86, 126213], [89, 126453]]}, {"verse": 17, "start": 127403, "end": 132630, "text": "Y en vuestra ley está escrito que el testimonio de dos hombres es verdadero.", "words": [[0, 127403], [2, 127546], [5, 127666], [13, 128086], [17, 128486], [22, 129006], [30, 129346], [34, 129606], [37, 129726], [48, 130446], [51, 130566], [55, 130766], [63, 131166], [66, 131626]]}, {"verse": 18, "start": 132980, "end": 139346, "text": "Yo soy el que doy testimonio de mí mismo: y da testimonio de mí el que me envió, el Padre.", "words": [[0, 132980], [3, 133166], [7, 133446], [10, 133646], [14, 133786], [18, 134066], [29, 134746], [32, 134846], [35, 134986], [42, 135822], [44, 135937], [47, 136057], [58, 136797], [61, 136897], [64, 137117], [67, 137417], [71, 137577], [74, 137737], [81, 138557], [84, 138697]]}, {"verse": 19, "start": 139696, "end": 151078, "text": "Y le decían: ¿Dónde está tu Padre? Respondió Jesús: Ni a mí me conocéis, ni a mi Padre; si a mí me conocieseis, a mi Padre también conocierais.", "words": [[0, 139696], [2, 139825], [5, 139925], [13, 140889], [20, 141157], [25, 141397], [28, 141517], [35, 142431], [45, 142871], [52, 143920], [55, 144120], [57, 144220], [60, 144360], [63, 144500], [73, 145140], [76, 145780], [78, 145840], [81, 145920], [88, 146817], [91, 146976], [93, 147096], [96, 147336], [99, 148046], [112, 148756], [114, 148836], [117, 148996], [123, 149336], [131, 150231]]}, {"verse": 20, "start": 151428, "end": 161239, "text": "Estas palabras habló Jesús en el lugar de las limosnas, enseñando en el templo: y nadie le prendió; porque aún no había venido su hora.", "words": [[0, 151428], [6, 151768], [15, 152128], [21, 152708], [27, 153108], [30, 153588], [33, 153708], [39, 154068], [42, 154268], [46, 154888], [56, 155508], [66, 156308], [69, 156428], [72, 156548], [80, 157394], [82, 157537], [88, 157857], [91, 158097], [100, 158975], [107, 159199], [111, 159479], [114, 159779], [120, 160039], [127, 160479], [130, 160679]]}, {"verse": 21, "start": 161589, "end": 172209, "text": "Y les dijo otra vez Jesús: Yo me voy, y me buscaréis, pero en vuestro pecado moriréis: a donde yo voy, vosotros no podéis venir.", "words": [[0, 161589], [2, 161889], [6, 162029], [11, 162369], [16, 162669], [20, 162949], [27, 163814], [30, 164041], [33, 164201], [38, 164481], [40, 164801], [43, 164941], [54, 166041], [59, 166381], [62, 166561], [70, 166941], [77, 167461], [87, 168877], [89, 169046], [95, 169226], [98, 169506], [103, 170406], [112, 170886], [115, 171106], [122, 171546]]}, {"verse": 22, "start": 172559, "end": 179797, "text": "Decían entonces los judíos: ¿Se va a matar a sí mismo, que dice: A donde yo voy, vosotros no podéis venir?", "words": [[0, 172559], [7, 173165], [16, 173945], [20, 174485], [28, 175478], [32, 175613], [35, 175793], [37, 175873], [43, 176113], [45, 176273], [48, 176413], [55, 176733], [59, 176933], [65, 177636], [67, 177739], [73, 177899], [76, 178139], [81, 178359], [90, 178859], [93, 179039], [100, 179339]]}, {"verse": 23, "start": 180077, "end": 188838, "text": "Y les decía: Vosotros sois de abajo, yo soy de arriba; vosotros sois de este mundo, yo no soy de este mundo.", "words": [[0, 180077], [2, 180359], [6, 180679], [13, 181174], [22, 181796], [27, 182436], [30, 182576], [37, 183476], [40, 183596], [44, 183856], [47, 184036], [55, 184924], [64, 185470], [69, 185990], [72, 186170], [77, 186350], [84, 187090], [87, 187450], [90, 187550], [94, 187830], [97, 188030], [102, 188190]]}, {"verse": 24, "start": 189188, "end": 197758, "text": "Por eso os dije que moriréis en vuestros pecados; porque si no creéis que yo soy, en vuestros pecados moriréis.", "words": [[0, 189188], [4, 189388], [8, 189628], [11, 189908], [16, 190228], [20, 190468], [29, 191268], [32, 191488], [41, 191948], [50, 192838], [57, 193062], [60, 193262], [63, 193482], [70, 194022], [74, 194182], [77, 194402], [82, 194842], [85, 195362], [94, 195802], [102, 196842]]}, {"verse": 25, "start": 198108, "end": 206936, "text": "Y le decían: ¿Tú quién eres? Entonces Jesús les dijo: Quien os he dicho desde el principio.", "words": [[0, 198108], [2, 198237], [5, 198337], [13, 199301], [17, 199441], [23, 199681], [29, 201587], [38, 202053], [44, 202773], [48, 203293], [54, 204041], [60, 204431], [63, 204751], [66, 204991], [72, 205311], [78, 205791], [81, 206111]]}, {"verse": 26, "start": 207286, "end": 217353, "text": "Muchas cosas tengo que decir y juzgar de vosotros: pero el que me envió, es verdadero: y yo, lo que he oído de él, esto hablo en el mundo.", "words": [[0, 207286], [7, 207513], [13, 207893], [19, 208213], [23, 208433], [29, 208813], [31, 209113], [38, 209613], [41, 209793], [51, 210755], [56, 210920], [59, 211060], [63, 211200], [66, 211360], [73, 211800], [76, 212400], [87, 213502], [89, 213648], [93, 213868], [96, 214048], [100, 214248], [103, 214548], [108, 214988], [111, 215248], [115, 215628], [120, 215928], [126, 216448], [129, 216588], [132, 216728]]}, {"verse": 27, "start": 217703, "end": 220717, "text": "Pero no entendieron que él les hablaba del Padre.", "words": [[0, 217703], [5, 217848], [8, 218008], [20, 218688], [24, 218948], [27, 219188], [31, 219368], [39, 219848], [43, 220008]]}, {"verse": 28, "start": 221067, "end": 233335, "text": "Les dijo pues, Jesús: Cuando levantéis al Hijo del hombre, entonces entenderéis que yo soy, y que nada hago de mí mismo; pero como el Padre me enseñó, esto hablo.", "words": [[0, 221067], [4, 221361], [9, 221641], [15, 221981], [22, 223004], [29, 223208], [39, 223968], [42, 224188], [47, 224428], [51, 224648], [59, 225428], [68, 225628], [80, 226648], [84, 226828], [87, 227028], [92, 227408], [94, 227848], [98, 228008], [103, 228308], [108, 228848], [111, 229028], [114, 229208], [121, 230063], [126, 230209], [131, 230469], [134, 230629], [140, 230989], [143, 231229], [151, 232429], [156, 232669]]}, {"verse": 29, "start": 233685, "end": 241522, "text": "Porque el que me envió, conmigo está; no me ha dejado solo el Padre; porque yo, lo que a él agrada, hago siempre.", "words": [[0, 233685], [7, 233888], [10, 234048], [14, 234188], [17, 234308], [24, 234688], [32, 235448], [38, 236656], [41, 236806], [44, 236946], [47, 237026], [54, 237466], [59, 237746], [62, 237946], [69, 238641], [76, 238766], [80, 239106], [83, 239466], [87, 239646], [89, 239766], [92, 239906], [100, 240366], [105, 240746]]}, {"verse": 30, "start": 241872, "end": 245481, "text": "Hablando él estas cosas, muchos creyeron en él.", "words": [[0, 241872], [9, 242139], [12, 242449], [18, 242669], [25, 243569], [32, 244129], [41, 244689], [44, 245049]]}, {"verse": 31, "start": 245831, "end": 254891, "text": "Y decía Jesús a los judíos que le habían creído: Si vosotros permanecéis en mi palabra, seréis verdaderamente mis discípulos;", "words": [[0, 245831], [2, 245938], [8, 246378], [14, 246618], [16, 246858], [20, 246978], [27, 247458], [31, 247578], [34, 247698], [41, 247978], [49, 248865], [52, 249048], [61, 249648], [73, 250728], [76, 250848], [79, 250988], [88, 252008], [95, 252688], [110, 253748], [114, 253968]]}, {"verse": 32, "start": 255241, "end": 258629, "text": "Y conoceréis la verdad, y la verdad os libertará.", "words": [[0, 255241], [2, 255327], [13, 256027], [16, 256207], [24, 256567], [26, 256922], [29, 257042], [36, 257382], [39, 257722]]}, {"verse": 33, "start": 258979, "end": 266416, "text": "Y le respondieron: Linaje de Abraham somos, y jamás fuimos esclavos de nadie: ¿cómo dices tú: Seréis libres?", "words": [[0, 258979], [2, 259129], [5, 259249], [19, 260379], [26, 260816], [29, 261016], [37, 261356], [44, 261776], [46, 262296], [52, 262676], [59, 263056], [68, 263676], [71, 263796], [78, 264515], [84, 264672], [90, 264972], [94, 265569], [101, 265896]]}, {"verse": 34, "start": 266696, "end": 274703, "text": "Jesús les respondió: De cierto, de cierto os digo, que todo aquel que hace pecado, es esclavo del pecado.", "words": [[0, 266696], [6, 267058], [10, 267455], [21, 268520], [24, 268996], [32, 269473], [35, 269950], [42, 270426], [45, 270903], [51, 271083], [55, 271303], [60, 271543], [66, 271923], [70, 272023], [75, 272223], [83, 272763], [86, 273303], [94, 273786], [98, 274268]]}, {"verse": 35, "start": 275053, "end": 279567, "text": "Y el esclavo no queda en casa para siempre: el hijo queda para siempre.", "words": [[0, 275053], [2, 275197], [5, 275497], [13, 275797], [16, 275997], [22, 276237], [25, 276417], [30, 276737], [35, 277017], [44, 277941], [47, 278191], [52, 278391], [58, 278671], [63, 278911]]}, {"verse": 36, "start": 279917, "end": 284262, "text": "Así que, si el Hijo os libera, seréis verdaderamente libres.", "words": [[0, 279917], [4, 280233], [9, 280433], [12, 280633], [15, 280853], [20, 280983], [23, 281113], [31, 281813], [38, 282433], [53, 283473]]}, {"verse": 37, "start": 284612, "end": 291343, "text": "Sé que sois descendientes de Abraham, pero procuráis matarme, porque mi palabra no cabe en vosotros.", "words": [[0, 284612], [3, 284774], [7, 284894], [12, 285274], [26, 286274], [29, 286434], [38, 287454], [43, 287594], [53, 288174], [62, 288854], [69, 289274], [72, 289494], [80, 289834], [83, 290114], [88, 290414], [91, 290614]]}, {"verse": 38, "start": 291693, "end": 298544, "text": "Yo hablo lo que he visto cerca del Padre; y vosotros hacéis lo que habéis oído cerca de vuestro padre.", "words": [[0, 291693], [3, 291919], [9, 292299], [12, 292459], [16, 292659], [19, 292759], [25, 292999], [31, 293339], [35, 293659], [42, 294550], [44, 294678], [53, 295118], [60, 295778], [63, 296098], [67, 296238], [74, 296538], [79, 296898], [85, 297238], [88, 297598], [96, 297918]]}, {"verse": 39, "start": 298894, "end": 308357, "text": "Respondieron y le dijeron: Nuestro padre es Abraham. Les dice Jesús: Si fuerais hijos de Abraham, las obras de Abraham haríais.", "words": [[0, 298894], [13, 299578], [15, 299878], [18, 299998], [27, 300788], [35, 301128], [41, 301568], [44, 301748], [53, 302670], [57, 302819], [62, 303119], [69, 304123], [72, 304465], [80, 304845], [86, 305165], [89, 305405], [98, 306190], [102, 306290], [108, 306630], [111, 306850], [119, 307270]]}, {"verse": 40, "start": 308707, "end": 317598, "text": "Pero ahora procuráis matarme, hombre que os he hablado la verdad, la cual he oído de Dios: no hizo esto Abraham.", "words": [[0, 308707], [5, 308852], [11, 309192], [21, 309872], [30, 311112], [37, 311452], [41, 311692], [44, 311912], [47, 312052], [55, 312552], [58, 312712], [66, 313512], [69, 313772], [74, 314012], [77, 314332], [82, 314712], [85, 314932], [91, 315782], [94, 316112], [99, 316492], [104, 317032]]}, {"verse": 41, "start": 317948, "end": 327859, "text": "Vosotros hacéis las obras de vuestro padre. Le dijeron entonces: Nosotros no somos nacidos de fornicación; un padre tenemos, que es Dios.", "words": [[0, 317948], [9, 318554], [16, 319474], [20, 319694], [26, 320074], [29, 320334], [37, 320714], [44, 321530], [47, 321656], [55, 322136], [65, 323274], [74, 323738], [77, 323938], [83, 324258], [91, 324798], [94, 324978], [107, 326036], [110, 326179], [116, 326479], [125, 326839], [129, 327219], [132, 327359]]}, {"verse": 42, "start": 328139, "end": 340873, "text": "Jesús entonces les dijo: Si vuestro padre fuera Dios, ciertamente me amaríais: porque yo de Dios he salido, y he venido; que no he venido de mí mismo, sino que él me envió.", "words": [[0, 328139], [6, 328463], [15, 329203], [19, 329783], [25, 330552], [28, 330710], [36, 331110], [42, 331530], [48, 331730], [54, 332530], [66, 333230], [69, 333490], [79, 334739], [86, 334922], [89, 335162], [92, 335302], [97, 335542], [100, 335742], [108, 336507], [110, 336667], [113, 336787], [121, 337601], [125, 337702], [128, 337882], [131, 338002], [138, 338402], [141, 338562], [144, 338742], [151, 339282], [156, 339482], [160, 339722], [163, 340022], [166, 340202]]}, {"verse": 43, "start": 341223, "end": 345309, "text": "¿Por qué no reconocéis mi lenguaje? porque no podéis oír mi palabra.", "words": [[0, 341223], [5, 341345], [9, 341505], [12, 341645], [23, 342325], [26, 342465], [36, 343477], [43, 343607], [46, 343747], [53, 344107], [57, 344447], [60, 344567]]}, {"verse": 44, "start": 345659, "end": 364416, "text": "Vosotros de vuestro padre el diablo sois, y los deseos de vuestro padre queréis cumplir. El, homicida ha sido desde el principio, y no permaneció en la verdad, porque no hay verdad en él. Cuando habla mentira, de lo suyo habla; porque es mentiroso, y padre de mentira.", "words": [[0, 345659], [9, 346158], [12, 346378], [20, 346758], [26, 347298], [29, 347538], [36, 347938], [42, 348618], [44, 349238], [48, 349418], [55, 350018], [58, 350138], [66, 350518], [72, 350978], [80, 351338], [89, 352418], [93, 352542], [102, 353062], [105, 353202], [110, 353422], [116, 353702], [119, 353942], [130, 354702], [132, 355057], [135, 355197], [146, 355917], [149, 356057], [152, 356197], [160, 356537], [167, 357137], [170, 357397], [174, 357537], [181, 357857], [184, 358117], [188, 358746], [195, 358928], [201, 359248], [210, 359828], [213, 359968], [216, 360108], [221, 360468], [228, 361197], [235, 361421], [238, 361601], [249, 362601], [251, 363021], [257, 363401], [260, 363621]]}, {"verse": 45, "start": 364766, "end": 367752, "text": "Y porque yo digo verdad, no me creéis.", "words": [[0, 364766], [2, 364891], [9, 365211], [12, 365471], [17, 365691], [25, 366491], [28, 366731], [31, 366891]]}, {"verse": 46, "start": 368102, "end": 373890, "text": "¿Quién de vosotros demuestra que he pecado? Pues si digo verdad, ¿por qué vosotros no me creéis?", "words": [[0, 368102], [7, 368326], [10, 368446], [19, 368886], [29, 369506], [33, 369626], [36, 369746], [44, 370646], [49, 370771], [52, 370951], [57, 371171], [65, 371971], [70, 372231], [74, 372371], [83, 372831], [86, 373011], [89, 373091]]}, {"verse": 47, "start": 374240, "end": 381904, "text": "El que es de Dios, las palabras de Dios oye: por esto no las oís vosotros, porque no sois de Dios.", "words": [[0, 374240], [3, 374387], [7, 374547], [10, 374747], [13, 374847], [19, 375707], [23, 375807], [32, 376287], [35, 376547], [40, 376807], [45, 377567], [49, 377694], [54, 377914], [57, 378214], [61, 378494], [65, 379014], [75, 379974], [82, 380574], [85, 380814], [90, 381294], [93, 381534]]}, {"verse": 48, "start": 382254, "end": 389593, "text": "Respondieron entonces los judíos, y le dijeron: ¿No decimos bien nosotros, que tú eres samaritano, y tienes demonio?", "words": [[0, 382254], [13, 382962], [22, 383482], [26, 383802], [34, 384342], [36, 384482], [39, 384582], [48, 385549], [52, 385729], [60, 386229], [65, 386409], [75, 386909], [79, 387309], [82, 387529], [87, 387749], [99, 388489], [101, 388729], [108, 388989]]}, {"verse": 49, "start": 389873, "end": 396962, "text": "Respondió Jesús: Yo no tengo demonio, antes honro a mi Padre; y vosotros me habéis deshonrado.", "words": [[0, 389977], [10, 390417], [17, 391298], [20, 391466], [23, 391606], [29, 391906], [38, 392646], [44, 393066], [50, 393766], [52, 393906], [55, 393986], [62, 394822], [64, 395056], [73, 395536], [76, 395756], [83, 396036]]}, {"verse": 50, "start": 397312, "end": 400920, "text": "Y no busco mi gloria: hay quien la busque, y juzgue.", "words": [[0, 397312], [2, 397417], [5, 397517], [11, 397857], [14, 397997], [22, 398832], [26, 398999], [32, 399259], [35, 399419], [43, 399839], [45, 400299]]}, {"verse": 51, "start": 401270, "end": 407650, "text": "De cierto, de cierto os digo, que el que guarda mi palabra, no verá muerte para siempre.", "words": [[0, 401496], [3, 401756], [11, 402016], [14, 402276], [21, 402536], [24, 402756], [30, 403576], [34, 403856], [37, 404036], [41, 404216], [48, 404696], [51, 404816], [60, 405596], [63, 405876], [68, 406156], [75, 406596], [80, 406876]]}, {"verse": 52, "start": 408000, "end": 419046, "text": "Entonces los judíos le dijeron: Ahora conocemos que tienes demonio. Abraham murió, y los profetas, y tú dices: El que guarda mi palabra, no gustará muerte para siempre.", "words": [[0, 408000], [9, 408968], [13, 409108], [20, 409548], [23, 409688], [32, 410601], [38, 410883], [48, 411443], [52, 411623], [59, 411883], [68, 412767], [76, 413170], [83, 413670], [85, 413770], [89, 413910], [99, 414850], [101, 414970], [104, 415130], [111, 415932], [114, 416056], [118, 416156], [125, 416516], [128, 416596], [137, 417016], [140, 417416], [148, 417836], [155, 418196], [160, 418436]]}, {"verse": 53, "start": 419396, "end": 425370, "text": "¿Eres tú mayor que nuestro padre Abraham, el cual murió? y los profetas murieron: ¿quién te haces a ti mismo?", "words": [[0, 419396], [6, 419593], [9, 419753], [15, 420053], [19, 420253], [27, 420433], [33, 420853], [42, 421493], [45, 421573], [50, 421733], [57, 422526], [59, 422606], [63, 422706], [72, 423186], [82, 424064], [89, 424292], [92, 424392], [98, 424672], [100, 424812], [103, 424872]]}, {"verse": 54, "start": 425650, "end": 434979, "text": "Respondió Jesús: Si yo me glorifico a mí mismo, mi gloria es nada: mi Padre es el que me glorifica; el que vosotros decís que es vuestro Dios;", "words": [[0, 425754], [10, 426194], [17, 427075], [20, 427219], [23, 427419], [26, 427539], [36, 428199], [38, 428259], [41, 428379], [48, 428859], [51, 428979], [58, 429359], [61, 429499], [67, 430173], [70, 430301], [76, 430621], [79, 430901], [82, 431021], [86, 431141], [89, 431301], [100, 432374], [103, 432614], [107, 432734], [116, 433274], [122, 433814], [126, 433934], [129, 434054], [137, 434434]]}, {"verse": 55, "start": 435329, "end": 444135, "text": "Y no le conocéis: pero yo le conozco; y si digo que no le conozco, seré como vosotros mentiroso: pero le conozco, y guardo su palabra.", "words": [[0, 435329], [2, 435429], [5, 435589], [8, 435729], [18, 436942], [23, 437062], [26, 437212], [29, 437362], [38, 438324], [40, 438574], [43, 438714], [48, 438974], [52, 439134], [55, 439294], [58, 439414], [67, 439934], [72, 440234], [77, 440434], [86, 440954], [97, 442116], [102, 442262], [105, 442402], [114, 442882], [116, 442982], [123, 443322], [126, 443482]]}, {"verse": 56, "start": 444485, "end": 449420, "text": "Abraham vuestro padre se gozó por ver mi día; y lo vio, y se gozó.", "words": [[0, 444767], [8, 445087], [16, 445467], [22, 445767], [25, 446067], [30, 446487], [34, 446667], [38, 446887], [41, 447067], [46, 447842], [48, 447983], [51, 448103], [56, 448403], [58, 448608], [61, 448848]]}, {"verse": 57, "start": 449770, "end": 455679, "text": "Le dijeron entonces los judíos: Aún no tienes cincuenta años, ¿y has visto a Abraham?", "words": [[0, 449770], [3, 449898], [11, 450438], [20, 450918], [24, 451278], [32, 452364], [36, 452607], [39, 452894], [46, 453180], [56, 453467], [62, 453987], [65, 454487], [69, 454647], [75, 454787], [77, 454927]]}, {"verse": 58, "start": 455959, "end": 462751, "text": "Les dijo Jesús: De cierto, de cierto os digo: Antes que Abraham fuese, yo soy.", "words": [[0, 456014], [4, 456104], [9, 456384], [16, 457716], [19, 458088], [27, 458460], [30, 458832], [37, 459204], [40, 459424], [46, 460133], [52, 460520], [56, 460820], [64, 461200], [71, 462060], [74, 462300]]}, {"verse": 59, "start": 463101, "end": 472079, "text": "Tomaron entonces piedras para tirarle: pero Jesús se ocultó, y salió del templo; y atravesando por medio de ellos, se fue.", "words": [[0, 463101], [8, 463475], [17, 463875], [25, 464475], [30, 464655], [39, 465625], [44, 465749], [50, 466089], [53, 466489], [61, 467069], [63, 467429], [69, 467789], [73, 467949], [81, 468834], [83, 468961], [95, 469701], [99, 469961], [105, 470321], [108, 470581], [115, 471361], [118, 471681]]}]}