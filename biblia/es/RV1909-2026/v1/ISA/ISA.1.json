{"book": "ISA", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 293621, "verses": [{"verse": 1, "start": 300, "end": 11222, "text": "Visión de Isaías hijo de Amoz, la cual vio sobre Judá y Jerusalén, en días de Uzías, Jotam, Acaz y Ezequías, reyes de Judá.", "words": [[0, 300], [7, 824], [10, 984], [17, 1644], [22, 2003], [25, 2523], [31, 3043], [34, 3103], [39, 3303], [43, 3523], [49, 3803], [54, 4244], [56, 4323], [67, 5244], [70, 5533], [75, 5823], [78, 6414], [85, 7004], [92, 7773], [97, 8544], [99, 8964], [109, 9724], [115, 10484], [118, 10684]]}, {"verse": 2, "start": 11672, "end": 20504, "text": "Oíd, cielos, y escucha tú, tierra; porque habla Jehová: Crié hijos, y los engrandecí, y ellos se rebelaron contra mí.", "words": [[0, 11672], [5, 12055], [13, 12835], [15, 13075], [23, 13615], [27, 13735], [35, 14924], [42, 15084], [48, 15324], [56, 16277], [61, 16654], [68, 17014], [70, 17254], [74, 17354], [86, 18474], [88, 18734], [94, 18994], [97, 19404], [107, 19814], [114, 20114]]}, {"verse": 3, "start": 21178, "end": 29563, "text": "El buey conoce a su dueño, y el asno el pesebre de su señor: Israel no conoce, mi pueblo no tiene entendimiento.", "words": [[0, 21178], [3, 21319], [8, 21659], [15, 22059], [17, 22119], [20, 22219], [27, 22979], [29, 23139], [32, 23259], [37, 23839], [40, 23919], [48, 24439], [51, 24579], [54, 24719], [61, 25779], [68, 26323], [71, 26583], [79, 27443], [82, 27583], [89, 27943], [92, 28303], [98, 28543]]}, {"verse": 4, "start": 30173, "end": 42414, "text": "¡Oh gente pecadora, pueblo cargado de maldad, generación de malignos, hijos depravados! Dejaron a Jehová, provocaron a ira al Santo de Israel, se volvieron atrás.", "words": [[0, 30277], [4, 30417], [10, 30817], [20, 31717], [27, 31957], [35, 32617], [38, 32777], [46, 33497], [57, 34257], [60, 34437], [70, 35117], [76, 35317], [88, 36558], [96, 37065], [98, 37205], [106, 37985], [117, 38785], [119, 38945], [123, 39285], [126, 39505], [132, 39845], [135, 40125], [143, 41065], [146, 41225], [156, 41765]]}, {"verse": 5, "start": 42864, "end": 50666, "text": "¿Para qué habéis de ser castigados aún? todavía os rebelaréis. Toda cabeza está enferma, y todo corazón doliente.", "words": [[0, 42864], [6, 43028], [10, 43228], [17, 43508], [20, 43648], [24, 43828], [35, 44488], [40, 45373], [48, 45800], [51, 46536], [63, 47512], [68, 47761], [75, 47981], [80, 48321], [89, 48941], [91, 49081], [96, 49261], [104, 49741]]}, {"verse": 6, "start": 51116, "end": 62205, "text": "Desde la planta del pie hasta la cabeza no hay en él cosa ilesa, sino herida, hinchazón y podrida llaga: no están curadas, ni vendadas, ni ablandadas con aceite.", "words": [[0, 51116], [6, 51416], [9, 51676], [16, 52096], [20, 52236], [24, 52536], [30, 52856], [33, 53016], [40, 53376], [43, 53696], [47, 53916], [50, 54096], [53, 54196], [58, 54686], [65, 55176], [70, 55416], [78, 55896], [88, 56376], [90, 56856], [98, 57355], [105, 58135], [108, 58283], [114, 58463], [123, 59043], [126, 59243], [136, 59943], [139, 60403], [150, 61143], [154, 61383]]}, {"verse": 7, "start": 62655, "end": 74883, "text": "Vuestra tierra está destruida, vuestras ciudades puestas a fuego, vuestra tierra delante de vosotros comida de extranjeros, y asolada como asolamiento de extraños.", "words": [[0, 62655], [8, 63138], [15, 63438], [20, 63798], [31, 65178], [40, 65578], [49, 66098], [57, 66778], [59, 66898], [66, 67798], [74, 68338], [81, 68798], [89, 69478], [92, 69638], [101, 70358], [108, 70658], [111, 70918], [124, 72038], [126, 72198], [134, 72778], [139, 73038], [151, 73718], [154, 73958]]}, {"verse": 8, "start": 75333, "end": 82289, "text": "Y queda la hija de Sion como choza en viña, y como cabaña en melonar, como ciudad asolada.", "words": [[0, 75333], [2, 75460], [8, 75820], [11, 76040], [16, 76420], [19, 76540], [24, 76880], [29, 77230], [35, 77580], [38, 77760], [44, 78360], [46, 78840], [51, 79080], [58, 79640], [61, 79780], [70, 80400], [75, 80860], [82, 81260]]}, {"verse": 9, "start": 82739, "end": 92456, "text": "Si Jehová de los ejércitos no hubiera hecho que nos quedasen muy pocos sobrevivientes, como Sodoma fuéramos, y semejantes a Gomorra.", "words": [[0, 82739], [3, 82939], [10, 83379], [13, 83499], [17, 83619], [27, 84379], [30, 84639], [38, 84999], [44, 85439], [48, 86079], [52, 86219], [61, 86759], [65, 87119], [71, 87639], [87, 88859], [92, 89299], [99, 89779], [109, 90339], [111, 90779], [122, 91539], [124, 91739]]}, {"verse": 10, "start": 92906, "end": 100940, "text": "Príncipes de Sodoma, oíd la palabra de Jehová; escuchad la ley de nuestro Dios, pueblo de Gomorra.", "words": [[0, 92906], [10, 93826], [13, 94226], [21, 94756], [25, 95286], [28, 95586], [36, 96026], [39, 96246], [47, 97529], [56, 97819], [59, 98039], [63, 98359], [66, 98539], [74, 98719], [80, 99619], [87, 99919], [90, 100159]]}, {"verse": 11, "start": 101240, "end": 115258, "text": "¿Para qué a mí, dice Jehová, la multitud de vuestros sacrificios? Harto estoy de holocaustos de carneros, y de sebo de animales gruesos: no quiero sangre de bueyes, ni de ovejas, ni de machos cabríos.", "words": [[0, 101240], [6, 101425], [10, 101665], [12, 101825], [16, 102245], [21, 102465], [29, 103405], [32, 103485], [41, 104085], [44, 104205], [53, 104545], [66, 106198], [72, 106368], [78, 106588], [81, 106808], [93, 107488], [96, 107588], [106, 108288], [108, 108628], [111, 108858], [116, 109088], [119, 109208], [128, 109508], [137, 110845], [140, 111048], [147, 111428], [154, 111828], [157, 112258], [165, 112688], [168, 112968], [171, 113108], [179, 113608], [182, 113968], [185, 114108], [192, 114683]]}, {"verse": 12, "start": 115947, "end": 122237, "text": "¿Quién pidió esto de vuestras manos, cuando vinieseis a presentaros delante de mí, para pisotear mis atrios?", "words": [[0, 115947], [7, 116207], [13, 116567], [18, 116847], [21, 117027], [30, 117407], [37, 117747], [44, 118307], [54, 119007], [56, 119107], [68, 119767], [76, 120187], [79, 120347], [83, 120527], [88, 120967], [97, 121587], [101, 121912]]}, {"verse": 13, "start": 122971, "end": 134747, "text": "No me traigáis más vana ofrenda: el incienso me es abominación: luna nueva y sábado, el convocar asambleas, no las puedo sufrir: son iniquidad vuestras solemnidades.", "words": [[0, 122971], [3, 123156], [6, 123276], [15, 123716], [19, 123976], [24, 124236], [33, 125387], [36, 125531], [45, 126131], [48, 126331], [51, 126471], [64, 127924], [69, 128188], [75, 128448], [77, 128628], [85, 129028], [88, 129428], [97, 129888], [108, 130788], [111, 130948], [115, 131128], [121, 131348], [129, 132569], [133, 132757], [143, 133337], [152, 133777]]}, {"verse": 14, "start": 135429, "end": 144036, "text": "Vuestras lunas nuevas y vuestras solemnidades tiene aborrecidas mi alma: me son gravosas; cansado estoy de llevarlas.", "words": [[0, 135429], [9, 135878], [15, 136298], [22, 136658], [24, 137018], [33, 137438], [46, 138178], [52, 138578], [64, 139358], [67, 139558], [73, 140598], [76, 140723], [80, 141228], [90, 142294], [98, 142856], [104, 143076], [107, 143336]]}, {"verse": 15, "start": 144738, "end": 157162, "text": "Cuando extendáis vuestras manos, yo esconderé de vosotros mis ojos: asimismo cuando multipliquéis la oración, yo no oiré: llenas están de sangre vuestras manos.", "words": [[0, 144738], [7, 145162], [17, 145942], [26, 146382], [33, 147362], [36, 147462], [46, 148122], [49, 148202], [58, 148682], [62, 148922], [68, 150099], [77, 150836], [84, 150996], [98, 151796], [101, 151976], [110, 153136], [113, 153276], [116, 153496], [122, 154568], [129, 155282], [135, 155582], [138, 155782], [145, 156122], [154, 156562]]}, {"verse": 16, "start": 157879, "end": 165244, "text": "Lavad, limpiaos; quitad la iniquidad de vuestras obras de ante mis ojos; dejad de hacer lo malo:", "words": [[0, 158134], [7, 158424], [17, 159822], [24, 160240], [27, 160400], [37, 161020], [40, 161180], [49, 161560], [55, 161820], [58, 162040], [63, 162220], [67, 162440], [73, 163444], [79, 164184], [82, 164364], [88, 164544], [91, 164724]]}, {"verse": 17, "start": 165961, "end": 174599, "text": "Aprended a hacer bien; buscad juicio, restituid al agraviado, oíd en derecho al huérfano, amparad a la viuda.", "words": [[0, 166238], [9, 166548], [11, 166808], [17, 167088], [23, 168191], [30, 168639], [38, 169579], [48, 170239], [51, 170399], [62, 171069], [66, 171739], [69, 171899], [77, 172219], [80, 172399], [90, 173279], [98, 173839], [100, 173999], [103, 174079]]}, {"verse": 18, "start": 175286, "end": 189216, "text": "Venid luego, dirá Jehová, y razonemos juntos: si vuestros pecados son como la grana, como la nieve serán emblanquecidos: si son rojos como el carmesí, vendrán a ser como blanca lana.", "words": [[0, 175286], [6, 175825], [13, 176172], [18, 176518], [26, 176865], [28, 177405], [38, 177945], [46, 179453], [49, 179652], [58, 180132], [66, 180772], [70, 181032], [75, 181312], [78, 181492], [85, 182312], [90, 182572], [93, 182752], [99, 183132], [105, 183892], [121, 185204], [124, 185346], [128, 185606], [134, 186046], [139, 186286], [142, 186406], [151, 187346], [159, 187706], [161, 187806], [165, 188026], [170, 188286], [177, 188686]]}, {"verse": 19, "start": 189893, "end": 193703, "text": "Si queréis y oís, comeréis el bien de la tierra:", "words": [[0, 189893], [3, 190493], [11, 190723], [13, 190953], [18, 191853], [27, 192513], [30, 192633], [35, 192813], [38, 192973], [41, 193073]]}, {"verse": 20, "start": 194436, "end": 201162, "text": "Si no queréis y sois rebeldes, seréis consumidos a espada: porque la boca de Jehová lo ha dicho.", "words": [[0, 194436], [3, 194619], [6, 194759], [14, 195219], [16, 195479], [21, 195839], [31, 196699], [38, 197219], [49, 197859], [51, 197999], [59, 199333], [66, 199493], [69, 199613], [74, 199873], [77, 200093], [84, 200473], [87, 200553], [90, 200633]]}, {"verse": 21, "start": 201612, "end": 209997, "text": "¿Cómo te has vuelto prostituta, oh ciudad fiel? Llena estuvo de juicio, en ella habitó equidad; pero ahora, homicidas.", "words": [[0, 201612], [6, 201980], [9, 202140], [13, 202240], [20, 202520], [32, 203000], [35, 203480], [42, 203860], [48, 204910], [54, 205050], [61, 205450], [64, 205590], [72, 206510], [75, 206670], [80, 206830], [87, 207330], [96, 208341], [101, 208484], [108, 208964]]}, {"verse": 22, "start": 210447, "end": 215091, "text": "Tu plata se ha vuelto escorias, tu vino mezclado está con agua.", "words": [[0, 210447], [3, 210531], [9, 210931], [12, 211171], [15, 211271], [22, 211811], [32, 213031], [35, 213211], [40, 213431], [49, 214031], [54, 214271], [58, 214551]]}, {"verse": 23, "start": 215541, "end": 228302, "text": "Tus príncipes, rebeldes y compañeros de ladrones: todos aman las dádivas, y van tras las recompensas: no oyen en juicio al huérfano, ni llega a ellos la causa de la viuda.", "words": [[0, 215541], [4, 215668], [15, 216748], [24, 217508], [26, 217628], [37, 218348], [40, 218448], [50, 219501], [56, 219741], [61, 220181], [65, 220421], [74, 220961], [76, 221441], [80, 221621], [85, 221861], [89, 222141], [102, 223643], [105, 223889], [110, 224269], [113, 224449], [120, 224889], [123, 225069], [133, 225789], [136, 226149], [142, 226429], [144, 226669], [150, 226869], [153, 227089], [159, 227409], [162, 227609], [165, 227729]]}, {"verse": 24, "start": 228752, "end": 238220, "text": "Por tanto, dice el Señor Jehová de los ejércitos, el Fuerte de Israel: Ea, tomaré satisfacción de mis enemigos, me vengaré de mis adversarios:", "words": [[0, 228752], [4, 228870], [11, 229390], [16, 229650], [19, 229850], [25, 230130], [32, 230750], [35, 230810], [39, 230970], [50, 231970], [53, 232050], [60, 232370], [63, 232670], [71, 233631], [75, 233950], [82, 234310], [95, 235070], [98, 235230], [102, 235370], [112, 236290], [115, 236510], [123, 236890], [126, 237050], [130, 237190]]}, {"verse": 25, "start": 238899, "end": 244638, "text": "Y volveré mi mano sobre ti, y limpiaré hasta lo más puro tus escorias, y quitaré todo tu estaño:", "words": [[0, 238899], [2, 238998], [10, 239378], [13, 239458], [18, 239718], [24, 239998], [28, 240318], [30, 240778], [39, 241238], [45, 241418], [48, 241558], [52, 241738], [57, 242018], [61, 242198], [71, 242838], [73, 243138], [81, 243558], [86, 243758], [89, 244018]]}, {"verse": 26, "start": 245326, "end": 254648, "text": "Y restituiré tus jueces como al principio, y tus consejeros como de primero: entonces te llamarán Ciudad de justicia, Ciudad fiel.", "words": [[0, 245326], [2, 245773], [13, 246263], [17, 246383], [24, 246923], [29, 247203], [32, 247343], [43, 247863], [45, 248543], [49, 248703], [60, 249443], [65, 249643], [68, 249803], [77, 250949], [86, 251408], [89, 251828], [98, 252308], [105, 252728], [108, 252848], [118, 253848], [125, 254168]]}, {"verse": 27, "start": 255230, "end": 260818, "text": "Sion con juicio será rescatada, y los convertidos de ella con justicia.", "words": [[0, 255312], [5, 255432], [9, 255552], [16, 256292], [21, 256632], [32, 257652], [34, 258372], [38, 258512], [50, 259252], [53, 259452], [58, 259692], [62, 259952]]}, {"verse": 28, "start": 261268, "end": 268271, "text": "Pero los rebeldes y pecadores a una serán quebrantados, y los que dejan a Jehová serán consumidos.", "words": [[0, 261268], [5, 261430], [9, 261670], [18, 262450], [20, 262610], [30, 262930], [32, 263250], [36, 263570], [42, 264050], [56, 265030], [58, 265530], [62, 265670], [66, 265810], [72, 266190], [74, 266330], [81, 266770], [87, 267130]]}, {"verse": 29, "start": 268721, "end": 276243, "text": "Entonces os avergonzarán los olmos que amasteis, y os afrentarán los bosques que escogisteis.", "words": [[0, 268721], [9, 269460], [12, 270200], [25, 271220], [29, 271420], [35, 271840], [39, 271980], [49, 272780], [51, 273260], [54, 273420], [65, 274200], [69, 274380], [77, 274860], [81, 275160]]}, {"verse": 30, "start": 276693, "end": 283529, "text": "Porque seréis como el olmo que se le cae la hoja, y como huerto que le faltan las aguas.", "words": [[0, 276693], [7, 276939], [14, 277459], [19, 277759], [22, 277979], [27, 278559], [31, 278759], [34, 278959], [37, 279099], [41, 279479], [44, 279599], [50, 280179], [52, 280819], [57, 281099], [64, 281719], [68, 281959], [71, 282079], [78, 282559], [82, 282759]]}, {"verse": 31, "start": 283979, "end": 293221, "text": "Y el fuerte será como estopa, y lo que hizo como centella; y ambos serán encendidos juntamente, y no habrá quien apague.", "words": [[0, 283979], [2, 284086], [5, 284206], [12, 284586], [17, 284946], [22, 285226], [30, 285806], [32, 286506], [35, 286666], [39, 286846], [44, 287126], [49, 287761], [59, 288669], [61, 288795], [67, 289095], [73, 289755], [84, 290675], [96, 291475], [98, 291715], [101, 291935], [107, 292355], [113, 292535]]}]}