{"book": "GEN", "chapter": 6, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 198484, "verses": [{"verse": 1, "start": 300, "end": 7582, "text": "Y acaeció que, cuando comenzaron los hombres a multiplicarse sobre la faz de la tierra, y les nacieron hijas,", "words": [[0, 300], [2, 444], [10, 1104], [15, 1324], [22, 1604], [33, 2364], [37, 2564], [45, 2924], [47, 3144], [61, 4104], [67, 4404], [70, 4604], [74, 4844], [77, 5004], [80, 5104], [88, 5524], [90, 6204], [94, 6384], [103, 6904]]}, {"verse": 2, "start": 7932, "end": 15442, "text": "Viendo los hijos de Dios que las hijas de los hombres eran hermosas, se tomaron mujeres, escogiendo entre todas.", "words": [[0, 7932], [7, 8238], [11, 8518], [17, 8817], [20, 9018], [25, 9298], [29, 9558], [33, 9778], [39, 10098], [42, 10198], [46, 10317], [54, 10678], [59, 10958], [69, 12038], [72, 12378], [80, 12798], [89, 13238], [100, 14398], [106, 14678]]}, {"verse": 3, "start": 15792, "end": 25561, "text": "Y dijo Jehová: No contenderá mi espíritu con el hombre para siempre, porque ciertamente él es carne: mas serán sus días ciento veinte años.", "words": [[0, 15792], [2, 15929], [7, 16169], [15, 17009], [18, 17209], [29, 17929], [32, 18069], [41, 18649], [45, 18829], [48, 18969], [55, 19189], [60, 19449], [69, 20409], [76, 20709], [88, 21589], [91, 21929], [94, 22249], [101, 23214], [105, 23411], [111, 23731], [115, 23951], [120, 24231], [127, 24511], [134, 24791]]}, {"verse": 4, "start": 26125, "end": 41168, "text": "Había gigantes en la tierra en aquellos días, y también después que entraron los hijos de Dios a las hijas de los hombres, y les engendraron hijos: estos fueron los valientes que desde la antigüedad fueron hombres de renombre.", "words": [[0, 26125], [6, 26425], [15, 27065], [18, 27305], [21, 27465], [28, 27845], [31, 28105], [40, 28345], [46, 29485], [48, 29785], [56, 30205], [64, 30945], [68, 31205], [77, 31805], [81, 31965], [87, 32285], [90, 32505], [95, 32745], [97, 32925], [101, 33085], [107, 33405], [110, 33505], [114, 33645], [123, 34065], [125, 34785], [129, 34965], [141, 35845], [148, 36677], [154, 36964], [161, 37184], [165, 37404], [175, 37964], [179, 38264], [185, 38364], [188, 38624], [199, 39544], [206, 39784], [214, 40184], [217, 40707]]}, {"verse": 5, "start": 41518, "end": 51352, "text": "Y vio Jehová que la malicia de los hombres era mucha en la tierra, y que todo designio de los pensamientos del corazón de ellos era de continuo solamente el mal.", "words": [[0, 41518], [2, 41635], [6, 41855], [13, 42315], [17, 42435], [20, 42535], [28, 43015], [31, 43175], [35, 43335], [43, 43705], [47, 44075], [53, 44415], [56, 44595], [59, 44695], [67, 45573], [69, 45676], [73, 45816], [78, 46356], [87, 47016], [90, 47116], [94, 47236], [107, 47896], [111, 48096], [119, 48516], [122, 48736], [128, 49196], [132, 49356], [135, 49496], [144, 50136], [154, 50496], [157, 50896]]}, {"verse": 6, "start": 51702, "end": 57274, "text": "Y se arrepintió Jehová de haber hecho hombre en la tierra, y le pesó en su corazón.", "words": [[0, 51702], [2, 51810], [5, 51970], [16, 52710], [23, 53450], [26, 53710], [32, 53930], [38, 54170], [45, 54470], [48, 54670], [51, 54770], [59, 55130], [61, 55810], [64, 55930], [69, 56270], [72, 56370], [75, 56510]]}, {"verse": 7, "start": 57624, "end": 69520, "text": "Y dijo Jehová: Borraré los hombres que he creado de sobre la faz de la tierra, desde el hombre hasta la bestia, y hasta el reptil y las aves del cielo: porque me arrepiento de haberlos hecho.", "words": [[0, 57624], [2, 57761], [7, 58001], [15, 58840], [23, 59225], [27, 59365], [35, 59765], [39, 60065], [42, 60165], [49, 60645], [52, 60825], [58, 61105], [61, 61305], [65, 61565], [68, 61745], [71, 61865], [79, 62645], [85, 62925], [88, 63165], [95, 63405], [101, 63685], [104, 63845], [112, 64425], [114, 64865], [120, 65105], [123, 65245], [130, 65865], [132, 66045], [136, 66185], [141, 66485], [145, 66645], [152, 67631], [159, 67790], [162, 67950], [173, 68490], [176, 68650], [185, 68990]]}, {"verse": 8, "start": 70040, "end": 72869, "text": "Pero Noé halló gracia en los ojos de Jehová.", "words": [[0, 70040], [5, 70364], [9, 70724], [15, 71084], [22, 71444], [25, 71604], [29, 71744], [34, 72064], [37, 72284]]}, {"verse": 9, "start": 73219, "end": 81650, "text": "Estas son las generaciones de Noé: Noé, varón justo, perfecto fue en sus generaciones; con Dios caminó Noé.", "words": [[0, 73219], [6, 73758], [10, 73958], [14, 74178], [27, 74978], [30, 75138], [35, 76593], [40, 76719], [46, 76846], [53, 77326], [62, 78069], [66, 78251], [69, 78511], [73, 78731], [87, 80094], [91, 80439], [96, 80619], [103, 81149]]}, {"verse": 10, "start": 82000, "end": 86659, "text": "Y engendró Noé tres hijos: a Sem, a Cam, y a Jafet.", "words": [[0, 82000], [2, 82329], [11, 82689], [15, 83049], [20, 83289], [27, 84433], [29, 84613], [34, 84793], [36, 84973], [41, 85673], [43, 85973], [45, 86053]]}, {"verse": 11, "start": 87009, "end": 92200, "text": "Y se corrompió la tierra delante de Dios, y estaba la tierra llena de violencia.", "words": [[0, 87009], [2, 87115], [5, 87235], [15, 87915], [18, 88075], [25, 88415], [33, 88935], [36, 89115], [42, 89395], [44, 89895], [51, 90175], [54, 90355], [61, 90635], [67, 91155], [70, 91275]]}, {"verse": 12, "start": 92550, "end": 101972, "text": "Y miró Dios la tierra, y he aquí que estaba corrompida; porque toda carne había corrompido su camino sobre la tierra.", "words": [[0, 92550], [2, 92695], [7, 93055], [12, 93375], [15, 93975], [23, 95295], [25, 95395], [28, 95535], [33, 95935], [37, 96215], [44, 96555], [56, 97861], [63, 98065], [68, 98365], [74, 98885], [80, 99265], [91, 100105], [94, 100285], [101, 100665], [107, 101025], [110, 101245]]}, {"verse": 13, "start": 102322, "end": 113858, "text": "Y dijo Dios a Noé: El fin de toda carne ha venido delante de mí; porque la tierra está llena de violencia a causa de ellos; y he aquí que yo los destruiré con la tierra.", "words": [[0, 102322], [2, 102611], [7, 102891], [12, 103171], [14, 103571], [19, 104183], [22, 104332], [26, 104592], [29, 104772], [34, 104952], [40, 105412], [43, 105712], [50, 106132], [58, 106552], [61, 106692], [65, 107464], [72, 107628], [75, 107808], [82, 108148], [87, 108588], [93, 109008], [96, 109108], [106, 109708], [108, 109928], [114, 110208], [117, 110468], [124, 111420], [126, 111558], [129, 111738], [134, 111998], [138, 112178], [141, 112338], [145, 112478], [155, 113098], [159, 113218], [162, 113338]]}, {"verse": 14, "start": 114460, "end": 121961, "text": "Hazte un arca de madera de Gopher: harás compartimentos en el arca, y la cubrirás con brea por dentro y por fuera.", "words": [[0, 114595], [6, 114765], [9, 114965], [14, 115285], [17, 115405], [24, 115785], [27, 116095], [35, 116873], [41, 117211], [56, 118071], [59, 118271], [62, 118391], [68, 118751], [70, 119131], [73, 119251], [82, 119791], [86, 120011], [91, 120371], [95, 120571], [102, 120951], [104, 121251], [108, 121411]]}, {"verse": 15, "start": 122538, "end": 132211, "text": "Y de esta manera la harás: de trescientos codos la longitud del arca, de cincuenta codos su anchura, y de treinta codos su altura.", "words": [[0, 122538], [2, 122840], [5, 122940], [10, 123160], [17, 123560], [20, 123980], [27, 125674], [30, 125941], [42, 126251], [48, 126851], [51, 126971], [60, 127271], [64, 127631], [70, 128451], [73, 128651], [83, 128851], [89, 129491], [92, 129611], [101, 130111], [103, 130531], [106, 130751], [114, 130971], [120, 131471], [123, 131611]]}, {"verse": 16, "start": 132804, "end": 144657, "text": "Una ventana harás al arca, y la acabarás a un codo de elevación por la parte de arriba: y pondrás la puerta del arca a su lado; y le harás piso bajo, segundo y tercero.", "words": [[0, 132804], [4, 132990], [12, 133570], [18, 133990], [21, 134170], [27, 134530], [29, 135050], [32, 135190], [41, 135770], [43, 135950], [46, 136050], [51, 136390], [54, 136530], [64, 137070], [68, 137330], [71, 137470],