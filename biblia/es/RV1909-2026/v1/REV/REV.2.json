{"book": "REV", "chapter": 2, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 307225, "verses": [{"verse": 1, "start": 300, "end": 9737, "text": "Escribe al ángel de la iglesia en EFESO: El que tiene las siete estrellas en su diestra, el cual anda en medio de los siete candeleros de oro, dice estas cosas:", "words": [[0, 537], [8, 807], [11, 927], [17, 1287], [20, 1407], [23, 1527], [31, 1847], [34, 2272], [41, 2938], [44, 3045], [48, 3165], [54, 3425], [58, 3625], [64, 3925], [74, 4505], [77, 4605], [80, 4745], [89, 5445], [92, 5745], [97, 5945], [102, 6265], [105, 6385], [111, 6585], [114, 6785], [118, 6925], [124, 7225], [135, 7845], [138, 7965], [143, 8525], [148, 8745], [154, 9005]]}, {"verse": 2, "start": 10087, "end": 24477, "text": "Yo sé tus obras, y tu trabajo y perseverancia; y que tú no puedes soportar a los malos, y has probado a los que se dicen ser apóstoles, y no lo son, y los has hallado mentirosos;", "words": [[0, 10087], [3, 10311], [6, 10511], [10, 10691], [17, 11171], [19, 11991], [22, 12111], [30, 12651], [32, 13331], [47, 15076], [49, 15177], [53, 15337], [56, 15577], [59, 15737], [66, 16197], [75, 17017], [77, 17117], [81, 17257], [88, 18097], [90, 18410], [94, 18724], [102, 19037], [104, 19197], [108, 19297], [112, 19437], [115, 19597], [121, 19917], [125, 20217], [136, 20837], [138, 21277], [141, 21417], [144, 21557], [149, 22617], [151, 22737], [155, 22857], [159, 23097], [167, 23537]]}, {"verse": 3, "start": 24927, "end": 31520, "text": "Y has sufrido, y has perseverado, y has trabajado por mi nombre, y no has desfallecido.", "words": [[0, 24927], [2, 25109], [6, 25289], [15, 26109], [17, 26369], [21, 26549], [34, 27549], [36, 27929], [40, 28069], [50, 28629], [54, 28849], [57, 29029], [65, 29409], [67, 29969], [70, 30189], [74, 30409]]}, {"verse": 4, "start": 31970, "end": 35027, "text": "Pero tengo contra ti que has dejado tu primer amor.", "words": [[0, 31970], [5, 32097], [11, 32417], [18, 32817], [21, 33077], [25, 33257], [29, 33457], [36, 33977], [39, 34117], [46, 34477]]}, {"verse": 5, "start": 35477, "end": 48860, "text": "Recuerda por tanto de dónde has caído, y arrepiéntete, y haz las primeras obras; pues si no, vendré pronto a ti, y quitaré tu candelero de su lugar, si no te arrepientes.", "words": [[0, 35477], [9, 36261], [13, 36461], [19, 36881], [22, 37181], [28, 37381], [32, 37661], [39, 38161], [41, 38701], [55, 39641], [57, 40221], [61, 40461], [65, 40701], [74, 41181], [81, 42070], [86, 42277], [89, 42617], [93, 43177], [100, 43657], [107, 44157], [109, 44517], [113, 44697], [115, 45157], [123, 45717], [126, 45857], [136, 46517], [139, 46677], [142, 46837], [149, 47217], [152, 47657], [155, 47837], [158, 47977]]}, {"verse": 6, "start": 49310, "end": 55355, "text": "Pero tienes esto, que aborreces los hechos de los nicolaítas; los cuales yo también aborrezco.", "words": [[0, 49310], [5, 49495], [12, 49915], [18, 50315], [22, 50535], [32, 51175], [36, 51415], [43, 51855], [46, 52015], [50, 52155], [62, 53640], [66, 53758], [73, 54018], [76, 54238], [84, 54814]]}, {"verse": 7, "start": 55805, "end": 67306, "text": "El que tiene oído, oiga lo que el Espíritu dice a las iglesias. Al que venza, daré a comer del árbol de la vida, el cual está en medio del paraíso de Dios.", "words": [[0, 55805], [3, 55943], [7, 56063], [13, 56343], [19, 56963], [24, 57583], [27, 57763], [31, 57923], [34, 58063], [43, 58663], [48, 58963], [50, 59143], [54, 59684], [64, 60530], [67, 60630], [71, 60790], [78, 61650], [83, 62150], [85, 62210], [91, 62530], [95, 62850], [101, 63230], [104, 63370], [107, 63490], [113, 64000], [116, 64510], [121, 64710], [126, 65050], [129, 65210], [135, 65510], [139, 65770], [147, 66430], [150, 66610]]}, {"verse": 8, "start": 67756, "end": 76197, "text": "Y escribe al ángel de la iglesia en Esmirna: El primero y último, que fue muerto, y vivió, dice estas cosas:", "words": [[0, 67756], [2, 67860], [10, 68260], [13, 68500], [19, 69020], [22, 69160], [25, 69300], [33, 69800], [36, 70247], [45, 70955], [48, 71102], [56, 71442], [58, 71722], [66, 72142], [70, 72602], [74, 72802], [82, 73322], [84, 73942], [91, 74682], [96, 75062], [102, 75442]]}, {"verse": 9, "start": 76647, "end": 89151, "text": "Yo sé tus obras, y tu tribulación, y tu pobreza (pero tú eres rico), y la blasfemia de los que se dicen ser judíos, y no lo son, sino que son sinagoga de Satanás.", "words": [[0, 76647], [3, 76791], [6, 76970], [10, 77130], [17, 77630], [19, 78310], [22, 78450], [35, 79170], [37, 79470], [40, 79590], [48, 80770], [54, 80990], [57, 81210], [62, 81410], [69, 81830], [71, 82370], [74, 82511], [84, 83310], [87, 83490], [91, 83610], [95, 83750], [98, 83890], [104, 84210], [108, 84490], [116, 85150], [118, 85490], [121, 85630], [124, 85750], [129, 86570], [134, 86910], [138, 87110], [142, 87350], [151, 88070], [154, 88250]]}, {"verse": 10, "start": 89601, "end": 106495, "text": "No tengas ningún temor de las cosas que has de padecer. He aquí, el diablo ha de enviar algunos de vosotros a la cárcel, para que seáis probados, y tendréis tribulación de diez días. Sé fiel hasta la muerte, y yo te daré la corona de la vida.", "words": [[0, 89601], [3, 89729], [10, 90209], [17, 90569], [23, 91069], [26, 91209], [30, 91349], [36, 91729], [40, 91989], [44, 92169], [47, 92249], [56, 93473], [59, 93593], [65, 93793], [68, 93973], [75, 94373], [78, 94573], [81, 94673], [88, 95113], [96, 95493], [99, 95673], [108, 96193], [110, 96393], [113, 96493], [121, 97053], [126, 97633], [130, 97813], [136, 98273], [146, 98993], [148, 99233], [157, 99933], [169, 100753], [172, 101023], [177, 101293], [183, 102397], [186, 102681], [191, 103001], [197, 103181], [200, 103381], [208, 103801], [210, 104481], [213, 104701], [216, 104841], [221, 105221], [224, 105341], [231, 105681], [234, 105901], [237, 106021]]}, {"verse": 11, "start": 106945, "end": 114982, "text": "El que tiene oído, oiga lo que el Espíritu dice a las iglesias. El que venza, no recibirá daño de la muerte segunda.", "words": [[0, 106945], [3, 107062], [7, 107182], [13, 107462], [19, 108322], [24, 108882], [27, 109102], [31, 109282], [34, 109422], [43, 110042], [48, 110282], [50, 110422], [54, 110562], [64, 111760], [67, 111887], [71, 112067], [78, 112427], [81, 112587], [90, 113207], [95, 113607], [98, 113727], [101, 113867], [108, 114107]]}, {"verse": 12, "start": 115432, "end": 123414, "text": "Y escribe al ángel de la iglesia en PÉRGAMO: El que tiene la espada aguda de dos filos, dice estas cosas:", "words": [[0, 115432], [2, 115720], [10, 116200], [13, 116560], [19, 117080], [22, 117160], [25, 117320], [33, 117820], [36, 118000], [45, 119079], [48, 119378], [52, 119498], [58, 119778], [61, 119958], [68, 120338], [74, 120918], [77, 121078], [81, 121298], [88, 121818], [93, 122278], [99, 122618]]}, {"verse": 13, "start": 123864, "end": 142792, "text": "Yo sé tus obras, y dónde moras, donde está el trono de Satanás; y retienes mi nombre, y no has negado mi fe, aun en los días en que fue Antipas mi testigo fiel, el cual ha sido muerto entre vosotros, donde Satanás mora.", "words": [[0, 123864], [3, 124069], [6, 124249], [10, 124449], [17, 124949], [19, 125829], [25, 126069], [32, 127249], [38, 127689], [43, 128069], [46, 128229], [52, 128689], [55, 128849], [64, 130130], [66, 130271], [75, 130911], [78, 131071], [86, 132091], [88, 132191], [91, 132351], [95, 132531], [102, 133151], [105, 133331], [109, 133631], [113, 134211], [116, 134471], [120, 134631], [125, 134991], [128, 135531], [132, 135651], [136, 135891], [144, 136871], [147, 137171], [155, 137751], [161, 138571], [164, 138751], [169, 138931], [172, 139091], [177, 139311], [184, 139791], [190, 140031], [200, 141172], [206, 141456], [214, 142156]]}, {"verse": 14, "start": 143242, "end": 161667, "text": "Pero tengo unas pocas cosas contra ti: porque tú tienes ahí los que tienen la doctrina de Balaam, el cual enseñaba a Balac a poner tropiezo delante de los hijos de Israel, a comer de cosas sacrificadas a los ídolos, y a cometer inmoralidad sexual.", "words": [[0, 143242], [5, 143384], [11, 143744], [16, 143964], [22, 144404], [28, 144784], [35, 145164], [39, 145980], [46, 146164], [49, 146424], [56, 146724], [60, 147004], [64, 147204], [68, 147344], [75, 147684], [78, 147964], [87, 148544], [90, 148764], [98, 150064], [101, 150184], [106, 150384], [115, 151144], [117, 151534], [123, 151924], [125, 152344], [131, 152624], [140, 153484], [148, 153944], [151, 154124], [155, 154244], [161, 154564], [164, 154744], [172, 155769], [174, 155893], [180, 156173], [183, 156413], [189, 156793], [202, 157833], [204, 158013], [208, 158153], [216, 158873], [218, 159313], [220, 159433], [228, 159833], [240, 160873]]}, {"verse": 15, "start": 162117, "end": 168703, "text": "Así también tú tienes a los que tienen la doctrina de los nicolaítas, lo cual yo aborrezco.", "words": [[0, 162117], [4, 162487], [12, 162887], [15, 163147], [22, 163487], [24, 163747], [28, 163867], [32, 164007], [39, 164367], [42, 164767], [51, 165287], [54, 165547], [58, 165667], [70, 166787], [73, 166967], [78, 167267], [81, 167707]]}, {"verse": 16, "start": 169152, "end": 176295, "text": "Arrepiéntete, porque de otra manera vendré a ti pronto, y pelearé contra ellos con la espada de mi boca.", "words": [[0, 169152], [14, 170476], [21, 170876], [24, 171076], [29, 171276], [36, 171636], [43, 172176], [45, 172276], [48, 172396], [56, 172836], [58, 173456], [66, 174156], [73, 174496], [79, 174796], [83, 175016], [86, 175136], [93, 175516], [96, 175656], [99, 175776]]}, {"verse": 17, "start": 176745, "end": 194176, "text": "El que tiene oído, oiga lo que el Espíritu dice a las iglesias. Al que venza, daré a comer del maná escondido, y le daré una piedrecita blanca, y en la piedrecita un nombre nuevo escrito, el cual ninguno conoce sino aquel que lo recibe.", "words": [[0, 176745], [3, 176869], [7, 176989], [13, 177249], [19, 177949], [24, 178389], [27, 178589], [31, 178749], [34, 178909], [43, 179489], [48, 179729], [50, 179869], [54, 180009], [64, 181131], [67, 181295], [71, 181435], [78, 182355], [83, 182835], [85, 182895], [91, 183175], [95, 183435], [100, 183775], [111, 184455], [113, 184895], [116, 185035], [121, 185375], [125, 185515], [136, 186235], [144, 186795], [146, 187395], [149, 187535], [152, 187695], [163, 188395], [166, 188575], [173, 188875], [179, 189195], [188, 190213], [191, 190372], [196, 190592], [204, 191472], [211, 192092], [216, 192512], [222, 193172], [226, 193332], [229, 193492]]}, {"verse": 18, "start": 194626, "end": 206578, "text": "Y escribe al ángel de la iglesia en TIATIRA: El Hijo de Dios, que tiene sus ojos como llama de fuego, y sus pies semejantes al bronce fino, dice estas cosas:", "words": [[0, 194626], [2, 194775], [10, 195235], [13, 195515], [19, 195975], [22, 196095], [25, 196235], [33, 196735], [36, 197232], [45, 197994], [48, 198119], [53, 198399], [56, 198519], [62, 199179], [66, 199399], [72, 199659], [76, 199919], [81, 200299], [86, 200619], [92, 200899], [95, 201119], [102, 201479], [104, 202019], [108, 202219], [113, 202519], [124, 203419], [127, 203659], [134, 204219], [140, 205019], [145, 205339], [151, 205739]]}, {"verse": 19, "start": 207028, "end": 216806, "text": "Yo he conocido tus obras, y amor, y servicio, y fe, y tu perseverancia, y que tus últimas obras son más que las primeras.", "words": [[0, 207028], [3, 207256], [6, 207376], [15, 207916], [19, 208096], [26, 208976], [28, 209316], [34, 210076], [36, 210156], [46, 210976], [48, 211036], [52, 211696], [54, 211756], [57, 211916], [72, 213156], [74, 213356], [78, 213496], [82, 213756], [90, 214436], [96, 214856], [100, 215396], [104, 215676], [108, 215836], [112, 215976]]}, {"verse": 20, "start": 217256, "end": 233384, "text": "Pero tengo unas pocas cosas contra ti: porque permites a aquella mujer Jezabel (que se dice profetisa) enseñar, y engañar a mis siervos, a practicar inmoralidad sexual, y a comer cosas ofrecidas a los ídolos.", "words": [[0, 217256], [5, 217381], [11, 217701], [16, 217921], [22, 218341], [28, 218701], [35, 219101], [39, 219824], [46, 220028], [55, 220768], [57, 220928], [65, 221308], [71, 221588], [79, 222748], [84, 222808], [87, 222968], [92, 223648], [103, 224328], [112, 225168], [114, 225548], [122, 226308], [124, 226368], [128, 226528], [137, 227588], [139, 227688], [149, 228388], [161, 229388], [169, 229868], [171, 230848], [173, 230948], [179, 231188], [185, 231568], [195, 232348], [197, 232508], [201, 232668]]}, {"verse": 21, "start": 233834, "end": 240855, "text": "Y le he dado tiempo para que se arrepienta de la inmoralidad sexual; y no se ha arrepentido.", "words": [[0, 233834], [2, 233998], [5, 234098], [8, 234238], [13, 234438], [20, 235058], [25, 235738], [29, 235898], [32, 236098], [43, 236818], [46, 236938], [49, 237098], [61, 237918], [69, 238985], [71, 239115], [74, 239315], [77, 239535], [80, 239775]]}, {"verse": 22, "start": 241305, "end": 250114, "text": "He aquí, yo la echo en cama, y a los que adulteran con ella, en muy grande tribulación, si no se arrepienten de sus obras:", "words": [[0, 241305], [3, 241467], [9, 241787], [12, 242007], [15, 242227], [20, 242447], [23, 242607], [29, 242987], [31, 243747], [33, 243827], [37, 243967], [41, 244147], [51, 244787], [55, 244967], [61, 245327], [64, 246127], [68, 246427], [75, 246787], [88, 247627], [91, 248107], [94, 248247], [97, 248427], [109, 249107], [112, 249247], [116, 249407]]}, {"verse": 23, "start": 250564, "end": 263121, "text": "Y mataré a sus hijos con muerte; y todas las iglesias sabrán que yo soy el que escudriño los riñones y los corazones: y daré a cada uno de vosotros según sus obras.", "words": [[0, 250564], [2, 250688], [9, 251208], [11, 251448], [15, 251648], [21, 251928], [25, 252208], [33, 253265], [35, 253412], [41, 253692], [45, 254052], [54, 254592], [61, 255052], [65, 255212], [68, 255412], [72, 255712], [75, 256052], [79, 256252], [89, 257172], [93, 257372], [101, 258072], [103, 258472], [107, 258612], [118, 259872], [120, 259981], [125, 260401], [127, 260581], [132, 260801], [136, 261121], [139, 261301], [148, 261881], [154, 262161], [158, 262421]]}, {"verse": 24, "start": 263571, "end": 277634, "text": "Pero yo digo a vosotros, y a los demás que estáis en Tiatira, cualesquiera que no tienen esta doctrina, y que no han conocido las profundidades de Satanás, como dicen: Yo no impondré sobre vosotros otra carga.", "words": [[0, 263571], [5, 263735], [8, 263935], [13, 264175], [15, 264315], [25, 264875], [27, 265675], [29, 265755], [33, 265895], [39, 266175], [43, 266395], [50, 266755], [53, 267248], [62, 267742], [75, 268235], [79, 268415], [82, 268555], [89, 268795], [94, 269115], [104, 269695], [106, 270255], [110, 270395], [113, 270615], [117, 270755], [126, 271295], [130, 271415], [144, 272255], [147, 272455], [156, 273575], [161, 273775], [168, 274769], [171, 274937], [174, 275097], [183, 275677], [189, 275957], [198, 276557], [203, 276957]]}, {"verse": 25, "start": 278084, "end": 281798, "text": "Pero lo que tenéis, conservadlo hasta que yo venga.", "words": [[0, 278084], [5, 278229], [8, 278409], [12, 278549], [20, 279389], [32, 280349], [38, 280829], [42, 281009], [45, 281169]]}, {"verse": 26, "start": 282248, "end": 289809, "text": "Y al que haya vencido, y haya guardado mis obras hasta el fin, yo le daré autoridad sobre las naciones;", "words": [[0, 282248], [2, 282388], [5, 282548], [9, 282708], [14, 282948], [23, 283728], [25, 284348], [30, 284528], [39, 285088], [43, 285248], [49, 285588], [55, 285908], [58, 286048], [63, 286948], [66, 287048], [69, 287288], [74, 287648], [84, 288368], [90, 288708], [94, 288988]]}, {"verse": 27, "start": 290259, "end": 298941, "text": "Y las regirá con vara de hierro, y serán quebrantados como vaso de alfarero, como también yo he recibido de mi Padre:", "words": [[0, 290259], [2, 290385], [6, 290525], [13, 291105], [17, 291325], [22, 291625], [25, 291845], [33, 293025], [35, 293125], [41, 293465], [54, 294325], [59, 294605], [64, 295085], [67, 295205], [77, 295885], [82, 296365], [90, 296805], [93, 297165], [96, 297325], [105, 297965], [108, 298125], [111, 298245]]}, {"verse": 28, "start": 299391, "end": 301856, "text": "Y le daré la estrella de la mañana.", "words": [[0, 299391], [2, 299671], [5, 299811], [10, 300171], [13, 300291], [22, 300851], [25, 300991], [28, 301111]]}, {"verse": 29, "start": 302306, "end": 306825, "text": "El que tiene oído, oiga lo que el Espíritu dice a las iglesias.", "words": [[0, 302306], [3, 302431], [7, 302551], [13, 302851], [19, 303571], [24, 304291], [27, 304491], [31, 304631], [34, 304771], [43, 305371], [48, 305611], [50, 305751], [54, 306299]]}]}