{"book": "PSA", "chapter": 86, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 118173, "verses": [{"verse": 1, "start": 300, "end": 7233, "text": "Oración de David. INCLINA, oh Jehová, tu oído, y óyeme; porque estoy afligido y necesitado.", "words": [[0, 300], [8, 745], [11, 1005], [18, 1815], [27, 2315], [30, 2815], [38, 3315], [41, 3535], [47, 3995], [49, 4235], [56, 4979], [63, 5227], [69, 5476], [78, 6076], [80, 6236]]}, {"verse": 2, "start": 7583, "end": 14046, "text": "Guarda mi alma, porque soy piadoso: salva tú, oh Dios mío, a tu siervo que en ti, confía.", "words": [[0, 7583], [7, 8008], [10, 8168], [16, 8448], [23, 8768], [27, 9048], [36, 10087], [42, 10507], [46, 10935], [49, 11115], [54, 11295], [59, 11815], [61, 11875], [64, 12015], [71, 12495], [75, 12695], [78, 12875], [82, 13155]]}, {"verse": 3, "start": 14396, "end": 18633, "text": "Ten misericordia de mí, oh Jehová: porque a ti clamo todo el día.", "words": [[0, 14396], [4, 14541], [17, 15361], [20, 15501], [24, 15883], [27, 16266], [35, 16804], [42, 16987], [44, 17267], [47, 17447], [53, 17627], [58, 17907], [61, 18167]]}, {"verse": 4, "start": 18983, "end": 23646, "text": "Alegra el alma de tu siervo: porque a ti, oh Señor, levanto mi alma.", "words": [[0, 19207], [7, 19457], [10, 19597], [15, 19797], [18, 19977], [21, 20097], [29, 20931], [36, 21136], [38, 21296], [42, 21486], [45, 21676], [52, 22056], [60, 22956], [63, 23096]]}, {"verse": 5, "start": 23996, "end": 32028, "text": "Porque tú, Señor, eres bueno y perdonador, y grande en misericordia para con todos los que te invocan.", "words": [[0, 23996], [7, 24220], [11, 24480], [18, 25000], [23, 25740], [29, 26200], [31, 26680], [43, 27440], [45, 28120], [52, 28540], [55, 28720], [68, 29580], [73, 29820], [77, 30100], [83, 30520], [87, 30900], [91, 31060], [94, 31200]]}, {"verse": 6, "start": 32378, "end": 36570, "text": "Escucha, oh Jehová, mi oración, y está atento a la voz de mis ruegos.", "words": [[0,