{"book": "MRK", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 297537, "verses": [{"verse": 1, "start": 300, "end": 7754, "text": "Y saliendo del templo, le dice uno de sus discípulos: Maestro, mira qué piedras, y qué edificios.", "words": [[0, 300], [2, 443], [11, 903], [15, 1143], [23, 2163], [26, 2323], [31, 2623], [35, 3103], [38, 3283], [42, 3483], [54, 4882], [63, 5480], [68, 5600], [72, 5800], [81, 6340], [83, 6700], [87, 6860]]}, {"verse": 2, "start": 8034, "end": 16463, "text": "Y Jesús respondiendo, le dijo: ¿Ves estos grandes edificios? no quedará piedra sobre piedra que no sea derribada.", "words": [[0, 8034], [2, 8142], [8, 8634], [22, 9125], [25, 9617], [31, 10402], [36, 10850], [42, 11290], [50, 11770], [61, 13109], [64, 13279], [72, 13699], [79, 14239], [85, 14519], [92, 15079], [96, 15199], [99, 15379], [103, 15599]]}, {"verse": 3, "start": 16813, "end": 24964, "text": "Y sentándose en el monte de los Olivos delante del templo, le preguntaron aparte Pedro y Jacobo y Juan y Andrés:", "words": [[0, 16813], [2, 16954], [13, 17754], [16, 17954], [19, 18094], [25, 18414], [28, 18634], [32, 18754], [39, 19214], [47, 19694], [51, 19934], [59, 21034], [62, 21174], [74, 21674], [81, 22174], [87, 22714], [89, 23014], [96, 23614], [98, 23774], [103, 24074], [105, 24314]]}, {"verse": 4, "start": 25164, "end": 30599, "text": "Dinos, ¿cuándo serán estas cosas? ¿y qué señal habrá cuando todas estas cosas han de cumplirse?", "words": [[0, 25164], [7, 25399], [15, 25879], [21, 26199], [27, 26379], [34, 27305], [37, 27412], [41, 27552], [47, 28012], [53, 28292], [60, 28452], [66, 28792], [72, 29132], [78, 29532], [82, 29812], [85, 29932]]}, {"verse": 5, "start": 30879, "end": 36059, "text": "Y Jesús respondiéndoles, comenzó a decir: Mirad, que nadie os engañe;", "words": [[0, 30879], [2, 31001], [8, 31401], [25, 32666], [33, 33566], [35, 33666], [42, 34166], [49, 34626], [53, 34986], [59, 35226], [62, 35486]]}, {"verse": 6, "start": 36409, "end": 42428, "text": "Porque vendrán muchos en mi nombre, diciendo: Yo soy el Cristo; y engañarán a muchos.", "words": [[0, 36409], [7, 36593], [15, 37133], [22, 37593], [25, 37893], [28, 38033], [36, 38333], [46, 39354], [49, 39450], [53, 39610], [56, 39830], [64, 40730], [66, 40950], [76, 41670], [78, 41730]]}, {"verse": 7, "start": 42778, "end": 52415, "text": "Pero cuando oigáis de guerras y de rumores de guerras no os turbéis, porque conviene hacerse así; pero aún no será el fin.", "words": [[0, 42778], [5, 42919], [12, 43279], [19, 44019], [22, 44239], [30, 44739], [32, 44979], [35, 45099], [43, 45699], [46, 45859], [54, 46542], [57, 46804], [60, 46984], [69, 47564], [76, 48164], [85, 48904], [93, 49684], [98, 50412], [103, 50553], [107, 50953], [110, 51453], [115, 51693], [118, 51873]]}, {"verse": 8, "start": 52765, "end": 65411, "text": "Porque se levantará nación contra nación, y reino contra reino; y habrá terremotos en muchos lugares, y habrá hambres y alborotos; estos serán el principio de los dolores de parto.", "words": [[0, 52765], [7, 52949], [10, 53169], [20, 53789], [27, 54209], [34, 54649], [42, 55269], [44, 55799], [50, 56329], [57, 56689], [64, 57669], [66, 57774], [72, 58074], [83, 58814], [86, 58994], [93, 59294], [102, 59854], [104, 60394], [110, 60764], [118, 61134], [120, 61334], [131, 62419], [137, 62866], [143, 63306], [146, 63426], [156, 63966], [159, 64226], [163, 64346], [171, 64746], [174, 64846]]}, {"verse": 9, "start": 65761, "end": 79936, "text": "Pero mirad por vosotros mismos: porque os entregarán en los tribunales, y en sinagogas seréis azotados: y delante de gobernadores y de reyes compareceréis por causa de mí, en testimonio a ellos.", "words": [[0, 65761], [5, 65928], [11, 66328], [15, 66488], [24, 66948], [32, 67840], [39, 68082], [42, 68262], [53, 69022], [56, 69122], [60, 69282], [72, 70022], [74, 70317], [77, 70477], [87, 71377], [94, 72037], [104, 73310], [106, 73572], [114, 74052], [117, 74212], [130, 75032], [132, 75412], [135, 75792], [141, 76172], [155, 76992], [159, 77232], [165, 77572], [168, 77852], [172, 78072], [175, 78532], [186, 79272], [188, 79412]]}, {"verse": 10, "start": 80286, "end": 84526, "text": "Y a todas las naciones conviene que el evangelio sea predicado antes.", "words": [[0, 80286], [2, 80447], [4, 80527], [10, 80767], [14, 81027], [23, 81467], [32, 81987], [36, 82167], [39, 82287], [49, 82947], [53, 83407], [63, 83867]]}, {"verse": 11, "start": 84876, "end": 99540, "text": "Y cuando os traigan para entregaros, no premeditéis qué habéis de decir, ni lo penséis: sino lo que os sea dado en aquella hora, eso hablad; porque no sois vosotros los que habláis, sino el Espíritu Santo.", "words": [[0, 84876], [2, 85046], [9, 85156], [12, 85266], [20, 85946], [25, 86206], [37, 87326], [40, 87426], [52, 88226], [56, 88366], [63, 88786], [66, 88966], [73, 89706], [76, 89866], [79, 90006], [88, 91030], [93, 91332], [96, 91572], [100, 91692], [103, 91872], [107, 92072], [112, 92392], [115, 92532], [123, 92872], [129, 93345], [133, 93819], [141, 94437], [148, 94644], [151, 94884], [156, 95364], [165, 96084], [169, 96384], [173, 96584], [182, 97064], [187, 97644], [190, 98204], [199, 98924]]}, {"verse": 12, "start": 99890, "end": 108900, "text": "Y entregará a la muerte el hermano al hermano, y el padre al hijo: y se levantarán los hijos contra los padres, y los matarán.", "words": [[0, 99890], [2, 100017], [12, 100797], [14, 100937], [17, 101037], [24, 101437], [27, 101737], [35, 102317], [38, 102437], [47, 103497], [49, 103797], [52, 103937], [58, 104397], [61, 104577], [67, 105247], [69, 105355], [72, 105455], [83, 106095], [87, 106235], [93, 106495], [100, 106835], [104, 107015], [112, 107415], [114, 107975], [118, 108115]]}, {"verse": 13, "start": 109250, "end": 116184, "text": "Y seréis aborrecidos de todos por mi nombre: pero el que persevere hasta el fin, este será salvo.", "words": [[0, 109250], [2, 109359], [9, 109819], [21, 110659], [24, 110839], [30, 111139], [34, 111439], [37, 111619], [45, 112408], [50, 112551], [53, 112731], [57, 112851], [67, 113611], [73, 113811], [76, 113991], [81, 115031], [86, 115231], [91, 115551]]}, {"verse": 14, "start": 116534, "end": 129796, "text": "Pero cuando veáis la abominación desoladora de que habló el profeta Daniel, puesta donde no debe estar (el que lee, entienda), entonces los que estén en Judea huyan a los montes;", "words": [[0, 116534], [5, 116677], [12, 116977], [18, 117437], [21, 117657], [33, 118557], [44, 119457], [47, 119677], [51, 119837], [57, 120137], [60, 120237], [68, 120717], [76, 121397], [83, 122077], [89, 122397], [92, 122757], [97, 123017], [103, 123457], [107, 123977], [111, 124137], [116, 124977], [127, 125898], [136, 126401], [140, 127001], [144, 127181], [150, 127601], [153, 127781], [159, 128381], [165, 128801], [167, 128901], [171, 129041]]}, {"verse": 15, "start": 130146, "end": 136924, "text": "Y el que esté sobre la azotea, no descienda a la casa, ni entre para tomar algo de su casa;", "words": [[0, 130146], [2, 130274], [5, 130374], [9, 130534], [14, 130774], [20, 131174], [23, 131414], [31, 132654], [34, 132934], [44, 133494], [46, 133634], [49, 133714], [55, 134074], [58, 134754], [64, 135074], [69, 135314], [75, 135674], [80, 136054], [83, 136234], [86, 136354]]}, {"verse": 16, "start": 137274, "end": 141471, "text": "Y el que esté en el campo, no vuelva atrás a tomar su capa.", "words": [[0, 137274], [2, 137413], [5, 137533], [9, 137673], [14, 137913], [17, 138093], [20, 138173], [27, 139253], [30, 139563], [37, 139873], [43, 140153], [45, 140393], [51, 140653], [54, 140913]]}, {"verse": 17, "start": 141821, "end": 147647, "text": "Pero ¡ay de las embarazadas y de las que estén amamantando en aquellos días!", "words": [[0, 141821], [5, 142196], [9, 142606], [12, 142966], [16, 143126], [28, 144146], [30, 144626], [33, 144746], [37, 144906], [41, 145046], [47, 145406], [59, 146486], [62, 146606], [71, 146846]]}, {"verse": 18, "start": 147997, "end": 151846, "text": "Orad pues, que no acontezca vuestra huida en invierno.", "words": [[0, 148175], [5, 148385], [11, 148645], [15, 148965], [18, 149515], [28, 150065], [36, 150505], [42, 150945], [45, 151085]]}, {"verse": 19, "start": 151846, "end": 160271, "text": "Porque aquellos días serán de aflicción, cual nunca fue desde el principio de la creación que Dios creó, hasta este tiempo, ni será.", "words": [[0, 151846], [7, 152126], [16, 152446], [21, 152786], [27, 153186], [30, 153306], [41, 153926], [46, 154201], [52, 154521], [56, 154901], [62, 155181], [65, 155361], [75, 155981], [78, 156281], [81, 156421], [90, 157001], [94, 157201], [99, 157441], [105, 158021], [111, 158581], [116, 158801], [124, 159601], [127, 159781]]}, {"verse": 20, "start": 160621, "end": 170206, "text": "Y si el Señor no hubiese abreviado aquellos días, nadie sobreviviría; pero por causa de los escogidos a quienes eligió, acortó aquellos días.", "words": [[0, 160621], [2, 160745], [5, 160905], [8, 161045], [14, 161325], [17, 161605], [25, 161945], [35, 162565], [44, 162785], [50, 163705], [56, 164005], [70, 165496], [75, 165878], [79, 166038], [85, 166338], [88, 166578], [92, 166698], [102, 167278], [104, 167438], [112, 167578], [120, 168718], [127, 169258], [136, 169498]]}, {"verse": 21, "start": 170556, "end": 178636, "text": "Y entonces si alguno os dice: Mirad, aquí está el Cristo» o «Mirad, allí está», no lo creáis.", "words": [[0, 170556], [2, 170697], [11, 171097], [14, 171677], [21, 171937], [24, 172197], [30, 173008], [37, 173414], [42, 173754], [47, 174074], [50, 174214], [58, 174999], [60, 175119], [68, 175819], [73, 176499], [80, 177379], [83, 177619], [86, 177779]]}, {"verse": 22, "start": 178986, "end": 189079, "text": "Porque se levantarán falsos Cristos y falsos profetas, y darán señales y prodigios, para engañar, si se pudiese hacer, aun a los escogidos.", "words": [[0, 178986], [7, 179191], [10, 179351], [21, 179991], [28, 180511], [36, 181011], [38, 181111], [45, 181511], [55, 182011], [57, 182531], [63, 182931], [71, 183571], [73, 183691], [84, 184531], [89, 185031], [98, 185831], [101, 186331], [104, 186491], [112, 186971], [119, 187431], [123, 187791], [125, 188051], [129, 188191]]}, {"verse": 23, "start": 189429, "end": 192930, "text": "Pero vosotros mirad; os lo he dicho antes todo.", "words": [[0, 189429], [5, 189689], [14, 190329], [21, 190975], [24, 191185], [27, 191465], [30, 191585], [36, 191845], [42, 192305]]}, {"verse": 24, "start": 193280, "end": 202610, "text": "Pero en aquellos días, después de aquella aflicción, el sol se oscurecerá, y la luna no dará su resplandor;", "words": [[0, 193280], [5, 193446], [8, 193626], [17, 193866], [23, 195046], [31, 195486], [34, 195726], [42, 196086], [53, 197426], [56, 197706], [60, 198006], [63, 198246], [75, 199186], [77, 199626], [80, 199766], [85, 200086], [88, 200786], [93, 201226], [96, 201948]]}, {"verse": 25, "start": 202960, "end": 208486, "text": "Y las estrellas caerán del cielo, y los poderes que están en los cielos serán conmovidos;", "words": [[0, 202960], [2, 203057], [6, 203197], [16, 203817], [23, 204297], [27, 204477], [34, 204917], [36, 205337], [40, 205477], [48, 205997], [52, 206077], [58, 206357], [61, 206497], [65, 206657], [72, 207197], [78, 207557]]}, {"verse": 26, "start": 208836, "end": 215738, "text": "Y entonces verán al Hijo del hombre, que vendrá en las nubes con gran poder y gloria.", "words": [[0, 208836], [2, 209092], [11, 209592], [17, 210492], [20, 210652], [25, 210912], [29, 211152], [37, 211912], [41, 212452], [48, 212992], [51, 213252], [55, 213392], [61, 213952], [65, 214152], [70, 214432], [76, 214852], [78, 215092]]}, {"verse": 27, "start": 216088, "end": 225780, "text": "Y entonces enviará sus ángeles, y reunirá a sus escogidos de los cuatro vientos, desde el extremo de la tierra hasta el extremo del cielo.", "words": [[0, 216088], [2, 216253], [11, 216673], [19, 217613], [23, 217753], [32, 218393], [34, 219033], [42, 219833], [44, 219873], [48, 220013], [58, 220713], [61, 220853], [65, 220953], [72, 221193], [81, 221853], [87, 222353], [90, 222573], [98, 223133], [101, 223193], [104, 223313], [111, 223693], [117, 224273], [120, 224433], [128, 225013], [132, 225113]]}, {"verse": 28, "start": 226130, "end": 235622, "text": "De la higuera aprended la semejanza: Cuando su rama ya se pone tierna, y brota hojas, conocéis que el verano está cerca:", "words": [[0, 226130], [3, 226236], [6, 226396], [14, 227166], [23, 227936], [26, 228396], [37, 229606], [44, 229822], [47, 230062], [52, 230422], [55, 230582], [58, 230722], [63, 230982], [71, 231702], [73, 232082], [79, 232442], [86, 233202], [95, 233902], [99, 234162], [102, 234322], [109, 234682], [114, 234882]]}, {"verse": 29, "start": 235972, "end": 242942, "text": "Así también vosotros, cuando veáis que suceden estas cosas, conoced que está cerca, a las puertas.", "words": [[0, 235972], [4, 236232], [12, 236592], [22, 237652], [29, 237852], [35, 238372], [39, 238552], [47, 239192], [53, 239372], [60, 240082], [68, 240792], [72, 240992], [77, 241232], [84, 241672], [86, 242212], [90, 242332]]}, {"verse": 30, "start": 243292, "end": 249065, "text": "De cierto os digo que no pasará esta generación hasta que todas estas cosas sean hechas.", "words": [[0, 243292], [3, 243455], [10, 243735], [13, 244075], [18, 244355], [22, 244575], [25, 244795], [32, 245275], [37, 245555], [48, 246415], [54, 246790], [58, 246990], [64, 247230], [70, 247610], [76, 248010], [81, 248390]]}, {"verse": 31, "start": 249415, "end": 253969, "text": "El cielo y la tierra pasarán, pero mis palabras no pasarán.", "words": [[0, 249415], [3, 249543], [9, 250083], [11, 250483], [14, 250623], [21, 250923], [30, 251923], [35, 252183], [39, 252343], [48, 252743], [51, 253103]]}, {"verse": 32, "start": 254319, "end": 262197, "text": "Pero de aquel día y de la hora, nadie sabe; ni aun los ángeles que están en el cielo, ni el Hijo, sino el Padre.", "words": [[0, 254319], [5, 254461], [8, 254681], [14, 255001], [18, 255241], [20, 255401], [23, 255501], [26, 255661], [32, 255921], [38, 256721], [44, 257725], [47, 257874], [51, 258114], [55, 258394], [63, 258954], [67, 259134], [73, 259374], [76, 259574], [79, 259714], [86, 260054], [89, 260374], [92, 260534], [98, 261174], [103, 261374], [106, 261594]]}, {"verse": 33, "start": 262547, "end": 266981, "text": "Mirad, velad y orad: porque no sabéis cuándo será el tiempo.", "words": [[0, 262547], [7, 262954], [13, 263414], [15, 263714], [21, 264447], [28, 264649], [31, 264869], [38, 265349], [45, 265909], [50, 266149], [53, 266349]]}, {"verse": 34, "start": 267331, "end": 277708, "text": "Como un hombre que se fue lejos, dejó su casa, y dio autoridad a sus siervos, y a cada uno su obra, y al portero mandó que velase:", "words": [[0, 267331], [5, 267495], [8, 267715], [15, 268055], [19, 268235], [22, 268375], [26, 268595], [33, 269175], [38, 270095], [41, 270275], [47, 270695], [49, 271495], [53, 271775], [63, 272495], [65, 272655], [69, 272835], [78, 273475], [80, 273875], [82, 273955], [87, 274155], [91, 274455], [94, 274675], [100, 275115], [102, 275675], [105, 275795], [113, 276415], [119, 276855], [123, 277313]]}, {"verse": 35, "start": 278058, "end": 288152, "text": "Velad pues, porque no sabéis cuándo el señor de la casa vendrá; si a la tarde, o a la media noche, o al canto del gallo, o a la mañana;", "words": [[0, 278303], [6, 278583], [12, 279001], [19, 279418], [22, 279538], [29, 279958], [36, 280238], [39, 280518], [45, 280858], [48, 281078], [51, 281218], [56, 281518], [64, 282539], [67, 282769], [69, 282869], [72, 282969], [79, 284029], [81, 284069], [83, 284169], [86, 284596], [92, 285022], [99, 285449], [101, 285489], [104, 285629], [110, 286029], [114, 286579], [121, 287129], [123, 287189], [125, 287329], [128, 287429]]}, {"verse": 36, "start": 288502, "end": 292614, "text": "Porque cuando venga de repente, no os halle durmiendo.", "words": [[0, 288502], [7, 288724], [14, 289024], [20, 289504], [23, 289644], [32, 290724], [35, 290984], [38, 291414], [44, 291844]]}, {"verse": 37, "start": 292964, "end": 297137, "text": "Y las cosas que a vosotros digo, a todos las digo: Velad.", "words": [[0, 292964], [2, 293072], [6, 293212], [12, 293532], [16, 293772], [18, 293872], [27, 294272], [33, 295152], [35, 295232], [41, 295572], [45, 295812], [51, 296845]]}]}