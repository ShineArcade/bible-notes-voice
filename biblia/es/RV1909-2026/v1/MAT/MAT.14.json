{"book": "MAT", "chapter": 14, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 276250, "verses": [{"verse": 1, "start": 300, "end": 5029, "text": "En aquel tiempo Herodes el tetrarca oyó la fama de Jesús,", "words": [[0, 300], [3, 424], [9, 724], [16, 1364], [24, 2004], [27, 2644], [36, 3284], [40, 3764], [43, 3904], [48, 4284], [51, 4364]]}, {"verse": 2, "start": 5479, "end": 14300, "text": "Y dijo a sus criados: Este es Juan el Bautista: él ha resucitado de los muertos, y por eso actúan en él poderes milagrosos.", "words": [[0, 5479], [2, 5759], [7, 6059], [9, 6239], [13, 6359], [22, 7567], [27, 7851], [30, 8091], [35, 8351], [38, 8551], [48, 9558], [51, 9737], [54, 9897], [65, 10577], [68, 10717], [72, 10837], [81, 11337], [83, 11857], [87, 12037], [91, 12237], [98, 12797], [101, 12897], [104, 13057], [112, 13497]]}, {"verse": 3, "start": 14650, "end": 24133, "text": "Porque Herodes había prendido a Juan, y le había aprisionado y puesto en la cárcel, por causa de Herodías, mujer de Felipe su hermano;", "words": [[0, 14650], [7, 14916], [15, 15476], [21, 16016], [30, 16556], [32, 16656], [38, 16976], [40, 17516], [43, 17636], [49, 17916], [61, 18836], [63, 18956], [70, 19436], [73, 19656], [76, 19776], [84, 20296], [88, 20676], [94, 20956], [97, 21256], [107, 22396], [113, 22656], [116, 22896], [123, 23236], [126, 23496]]}, {"verse": 4, "start": 24583, "end": 28074, "text": "Porque Juan le decía: No te es lícito tenerla.", "words": [[0, 24583], [7, 24784], [12, 25144], [15, 25564], [22, 26476], [25, 26678], [28, 26931], [31, 27185], [38, 27438]]}, {"verse": 5, "start": 28424, "end": 33432, "text": "Y quería matarle, pero temía al pueblo; porque le tenían como a profeta.", "words": [[0, 28424], [2, 28542], [9, 28802], [18, 29642], [23, 29762], [29, 30262], [32, 30442], [40, 31438], [47, 31646], [50, 31806], [57, 32186], [62, 32614], [64, 33042]]}, {"verse": 6, "start": 33882, "end": 42200, "text": "Pero celebrándose el día del nacimiento de Herodes, la hija de Herodías danzó en medio, y agradó a Herodes.", "words": [[0, 33882], [5, 34046], [18, 34886], [21, 35186], [25, 35406], [29, 35606], [40, 36226], [43, 36406], [52, 37466], [55, 37546], [60, 37926], [63, 38026], [72, 38586], [78, 39526], [81, 39686], [88, 40106], [90, 40666], [97, 41226], [99, 41406]]}, {"verse": 7, "start": 42650, "end": 46453, "text": "Y prometió él con juramento de darle todo lo que pidiese.", "words": [[0, 42650], [2, 42774], [11, 43374], [14, 43554], [18, 43794], [28, 44394], [31, 44634], [37, 44994], [42, 45394], [45, 45634], [49, 45754]]}, {"verse": 8, "start": 46903, "end": 55767, "text": "Y ella, instruída primero de su madre, dijo: Dame aquí en un plato la cabeza de Juan el Bautista.", "words": [[0, 46903], [2, 47072], [8, 47532], [18, 48192], [26, 48492], [29, 48772], [32, 48932], [39, 49672], [45, 50527], [50, 50787], [55, 51207], [58, 51507], [61, 51647], [67, 52087], [70, 52227], [77, 52667], [80, 52867], [85, 53247], [88, 53507]]}, {"verse": 9, "start": 56117, "end": 64738, "text": "Entonces el rey se entristeció; pero por el juramento, y por los que estaban juntamente a la mesa, mandó que se le diese.", "words": [[0, 56117], [9, 56678], [12, 57118], [16, 57498], [19, 57598], [32, 58850], [37, 59014], [41, 59234], [44, 59354], [55, 60434], [57, 60694], [61, 60834], [65, 60994], [69, 61134], [77, 61474], [88, 62174], [90, 62334], [93, 62414], [99, 63154], [105, 63694], [109, 63814], [112, 63954], [115, 64094]]}, {"verse": 10, "start": 65188, "end": 68142, "text": "Y enviando, degolló a Juan en la cárcel.", "words": [[0, 65188], [2, 65312], [12, 65912], [20, 66512], [22, 66652], [27, 66992], [30, 67272], [33, 67432]]}, {"verse": 11, "start": 68592, "end": 75284, "text": "Y fue traída su cabeza en un plato, y dada a la muchacha; y ella la presentó a su madre.", "words": [[0, 68592], [2, 68717], [6, 68857], [13, 69317], [16, 69537], [23, 70017], [26, 70217], [29, 70357], [36, 70977], [38, 71397], [43, 71797], [45, 71897], [48, 71957], [58, 73060], [60, 73207], [65, 73527], [68, 73927], [77, 74547], [79, 74627], [82, 74727]]}, {"verse": 12, "start": 75734, "end": 84235, "text": "Entonces llegaron sus discípulos, y tomaron el cuerpo, y lo enterraron; y fueron, y dieron la noticia a Jesús.", "words": [[0, 75734], [9, 76387], [18, 77287], [22, 77487], [34, 78327], [36, 78547], [44, 78967], [47, 79127], [55, 79627], [57, 79987], [60, 80127], [72, 81357], [74, 81522], [82, 81802], [84, 82262], [91, 82602], [94, 82782], [102, 83402], [104, 83562]]}, {"verse": 13, "start": 84685, "end": 95413, "text": "Y oyéndolo Jesús, se apartó de allí en un barco a un lugar desierto, apartado: y cuando la gente lo oyó y lo siguió a pie desde las ciudades.", "words": [[0, 84685], [2, 85039], [11, 85429], [18, 86289], [21, 86409], [28, 86909], [31, 87029], [36, 87289], [39, 87529], [42, 87709], [48, 88169], [50, 88429], [53, 88549], [59, 88849], [69, 89709], [79, 90828], [81, 90934], [88, 91174], [91, 91374], [97, 91694], [100, 92014], [104, 92494], [106, 92934], [109, 93074], [116, 93534], [118, 93654], [122, 93874], [128, 94154], [132, 94354]]}, {"verse": 14, "start": 95863, "end": 104188, "text": "Y saliendo Jesús, vio una gran multitud, y tuvo compasión de ellos, y sanó a los que de ellos había enfermos.", "words": [[0, 95863], [2, 95985], [11, 96465], [18, 97585], [22, 97965], [26, 98165], [31, 98425], [41, 99205], [43, 99685], [48, 99905], [58, 100625], [61, 100805], [68, 101125], [70, 101425], [75, 102045], [77, 102385], [81, 102505], [85, 102645], [88, 102785], [94, 103035], [100, 103285]]}, {"verse": 15, "start": 104638, "end": 118251, "text": "Y cuando fue la tarde del día, se llegaron a él sus discípulos, diciendo: El lugar es desierto, y el tiempo es ya pasado: despide a la multitud, para que se vayan por las aldeas, y compren para sí de comer.", "words": [[0, 104638], [2, 104740], [9, 104960], [13, 105260], [16, 105420], [22, 105700], [26, 106020], [31, 106800], [34, 106940], [43, 107460], [45, 107580], [48, 107740], [52, 107920], [64, 108960], [74, 110186], [77, 110308], [83, 110548], [86, 110748], [96, 111348], [98, 111748], [101, 111888], [108, 112208], [111, 112448], [114, 112568], [122, 113493], [130, 113972], [132, 114072], [135, 114132], [145, 114712], [150, 115152], [154, 115292], [157, 115432], [163, 115732], [167, 115892], [171, 116092], [179, 116632], [181, 116812], [189, 117212], [194, 117422], [197, 117632], [200, 117752]]}, {"verse": 16, "start": 118601, "end": 124829, "text": "Y Jesús les dijo: No tienen necesidad de irse: dadles vosotros de comer.", "words": [[0, 118601], [2, 118744], [8, 119144], [12, 119544], [18, 120356], [21, 120465], [28, 120785], [38, 121605], [41, 121725], [47, 122801], [54, 123406], [63, 124106], [66, 124487]]}, {"verse": 17, "start": 125279, "end": 129723, "text": "Y ellos dijeron: No tenemos aquí sino cinco panes y dos peces.", "words": [[0, 125279], [2, 125460], [8, 125660], [17, 126649], [20, 126832], [28, 127172], [33, 127632], [38, 127932], [44, 128232], [50, 128752], [52, 128882], [56, 129012]]}, {"verse": 18, "start": 130073, "end": 132546, "text": "Y él les dijo: Traédmelos acá.", "words": [[0, 130073], [2, 130280], [5, 130420], [9, 130580], [15, 131720], [26, 132070]]}, {"verse": 19, "start": 132996, "end": 147236, "text": "Y mandando a la gente recostarse sobre la hierba, tomando los cinco panes y los dos peces, alzando los ojos al cielo, bendijo, y partió y dio los panes a los discípulos, y los discípulos a la multitud.", "words": [[0, 132996], [2, 133100], [11, 133600], [13, 133680], [16, 133740], [22, 134020], [33, 134800], [39, 135100], [42, 135320], [50, 135840], [58, 136200], [62, 136380], [68, 136720], [74, 137320], [76, 137460], [80, 137600], [84, 137780], [91, 138660], [99, 139140], [103, 139340], [108, 139620], [111, 139900], [118, 140620], [127, 141657], [129, 141784], [136, 142464], [138, 142784], [142, 142964], [146, 143164], [152, 143744], [154, 143844], [158, 143964], [170, 144724], [172, 145164], [176, 145304], [187, 146024], [189, 146304], [192, 146384]]}, {"verse": 20, "start": 147686, "end": 155620, "text": "Y comieron todos, y se saciaron; y alzaron lo que sobró de los pedazos, doce cestas llenas.", "words": [[0, 147686], [2, 147796], [11, 148156], [18, 148556], [20, 149316], [23, 149456], [33, 150658], [35, 150784], [43, 151384], [46, 151584], [50, 151724], [56, 152544], [59, 152724], [63, 152864], [72, 153497], [77, 154131], [84, 154764]]}, {"verse": 21, "start": 156070, "end": 161948, "text": "Y los que comieron fueron como cinco mil hombres, sin las mujeres y los niños.", "words": [[0, 156070], [2, 156195], [6, 156315], [10, 156495], [19, 157035], [26, 157355], [31, 157725], [37, 158095], [41, 158595], [50, 159575], [54, 160075], [58, 160295], [66, 160735], [68, 160975], [72, 161115]]}, {"verse": 22, "start": 162398, "end": 173956, "text": "Y luego Jesús hizo a sus discípulos entrar en el barco, e ir delante de él al otro lado del lago, entre tanto que él despedía a la multitud.", "words": [[0, 162398], [2, 162580], [8, 162880], [14, 163620], [19, 164380], [21, 164640], [25, 164820], [36, 165520], [43, 166060], [46, 166380], [49, 166560], [56, 167020], [58, 167440], [61, 167660], [69, 168280], [72, 168480], [75, 168800], [78, 169080], [83, 169340], [88, 169680], [92, 169980], [98, 170820], [104, 171220], [110, 171660], [114, 171940], [117, 172160], [126, 172840], [128, 173020], [131, 173100]]}, {"verse": 23, "start": 174406, "end": 183135, "text": "Y despedida la multitud, subió al monte, apartado, a orar: y como fue la tarde del día, estaba allí solo.", "words": [[0, 174406], [2, 174513], [12, 175073], [15, 175193], [25, 175793], [31, 176333], [34, 176553], [41, 177353], [51, 178573], [53, 178907], [59, 179485], [61, 179728], [66, 179928], [70, 180168], [73, 180328], [79, 180628], [83, 180908], [88, 181628], [95, 182028], [100, 182368]]}, {"verse": 24, "start": 183585, "end": 190232, "text": "Y ya el barco estaba en medio del mar, atormentado de las olas; porque el viento era contrario.", "words": [[0, 183585], [2, 183847], [5, 184047], [8, 184167], [14, 184547], [21, 184807], [24, 184987], [30, 185227], [34, 185447], [39, 186167], [51, 187027], [54, 187187], [58, 187347], [64, 188317], [71, 188539], [74, 188699], [81, 189079], [85, 189279]]}, {"verse": 25, "start": 190682, "end": 196385, "text": "Pero a la cuarta vigilia de la noche, Jesús fue a ellos andando sobre el mar.", "words": [[0, 190682], [5, 190826], [7, 190946], [10, 191006], [17, 191406], [25, 191866], [28, 191986], [31, 192126], [38, 192946], [44, 193446], [48, 194206], [50, 194526], [56, 194766], [64, 195446], [70, 195746], [73, 195946]]}, {"verse": 26, "start": 196835, "end": 206689, "text": "Y los discípulos, viéndole andar sobre el mar, se turbaron, diciendo: Fantasma es. Y dieron voces de miedo.", "words": [[0, 196835], [2, 197082], [6, 197222], [18, 197842], [27, 198322], [33, 198682], [39, 199082], [42, 199282], [47, 199482], [50, 200002], [60, 201042], [70, 202482], [79, 202862], [83, 203546], [85, 203671], [92, 203951], [98, 204411], [101, 204531]]}, {"verse": 27, "start": 207139, "end": 211580, "text": "Pero luego Jesús les habló, diciendo: Confiad, yo soy; no tengáis miedo.", "words": [[0, 207139], [5, 207139], [11, 207139], [17, 207139], [21, 207139], [28, 207139], [38, 209173], [47, 209173], [50, 209381], [55, 210036], [58, 210376], [66, 210896]]}, {"verse": 28, "start": 212030, "end": 218364, "text": "Entonces le respondió Pedro, y dijo: Señor, si tú eres, manda que yo vaya a ti sobre las aguas.", "words": [[0, 212030], [9, 212547], [12, 213067], [22, 213667], [29, 214047], [31, 214247], [37, 215009], [44, 215367], [47, 215447], [50, 215607], [56, 216267], [62, 216567], [66, 216667], [69, 216807], [74, 216987], [76, 217207], [79, 217327], [85, 217547], [89, 217787]]}, {"verse": 29, "start": 218714, "end": 225061, "text": "Y él dijo: Ven. Y descendiendo Pedro del barco, andaba sobre las aguas para ir a Jesús.", "words": [[0, 218714], [2, 218875], [5, 218995], [11, 220021], [16, 220575], [18, 220683], [31, 221343], [37, 221723], [41, 221963], [48, 222443], [55, 222963], [61, 223203], [65, 223483], [71, 223943], [76, 224143], [79, 224363], [81, 224423]]}, {"verse": 30, "start": 225511, "end": 232981, "text": "Pero viendo el viento fuerte, tuvo miedo; y comenzándose a hundir, dio voces, diciendo: Señor, sálvame.", "words": [[0, 225511], [5, 225655], [12, 225935], [15, 226095], [22, 226395], [30, 226835], [35, 227155], [42, 228223], [44, 228331], [57, 229151], [59, 229311], [67, 229771], [71, 230131], [78, 230671], [88, 231832], [95, 232149]]}, {"verse": 31, "start": 233331, "end": 241722, "text": "Y luego Jesús, extendiendo la mano, lo sujetó, y le dice: Oh hombre de poca fe, ¿por qué dudaste?", "words": [[0, 233331], [2, 233478], [8, 233718], [15, 234238], [27, 235438], [30, 235578], [36, 236338], [39, 236558], [47, 237298], [49, 237658], [52, 237798], [58, 238728], [61, 238848], [68, 239188], [71, 239408], [76, 239768], [80, 240408], [85, 240708], [89, 240888]]}, {"verse": 32, "start": 242172, "end": 246181, "text": "Y como ellos entraron en el barco, se sosegó el viento.", "words": [[0, 242172], [2, 242356], [7, 242616], [13, 242896], [22, 243736], [25, 243856], [28, 244036], [35, 244816], [38, 244916], [45, 245456], [48, 245576]]}, {"verse": 33, "start": 246631, "end": 254926, "text": "Entonces los que estaban en el barco, vinieron y le adoraron, diciendo: Verdaderamente eres Hijo de Dios.", "words": [[0, 246631], [9, 247297], [13, 248057], [17, 248197], [25, 248497], [28, 248717], [31, 248857], [38, 249317], [47, 250117], [49, 250417], [52, 250517], [62, 251557], [72, 252687], [87, 253471], [92, 253731], [97, 254211], [100, 254391]]}, {"verse": 34, "start": 255276, "end": 258922, "text": "Y llegando a la otra parte, vinieron a la tierra de Genezaret.", "words": [[0, 255276], [2, 255405], [11, 255805], [13, 255925], [16, 255985], [21, 256165], [28, 256545], [37, 257105], [39, 257265], [42, 257345], [49, 257685], [52, 258337]]}, {"verse": 35, "start": 259372, "end": 268270, "text": "Y como le conocieron los hombres de aquel lugar, enviaron por toda aquella tierra alrededor, y trajeron a él todos los enfermos;", "words": [[0, 259372], [2, 259480], [7, 259680], [10, 259820], [21, 260480], [25, 260620], [33, 260980], [36, 261160], [42, 261460], [49, 262260], [58, 262980], [62, 263240], [67, 263600], [75, 264100], [82, 264440], [93, 264940], [95, 265360], [104, 265880], [106, 265980], [109, 266180], [115, 266860], [119, 267300]]}, {"verse": 36, "start": 268720, "end": 275850, "text": "Y le rogaban que solamente tocasen el borde de su manto; y todos los que tocaron, quedaron sanos.", "words": [[0, 268720], [2, 268841], [5, 268941], [13, 269521], [17, 269701], [27, 270381], [35, 271061], [38, 271201], [44, 271541], [47, 271681], [50, 271841], [57, 272768], [59, 273051], [65, 273391], [69, 273871], [73, 274031], [82, 274531], [91, 274991]]}]}