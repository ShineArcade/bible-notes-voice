{"book": "LUK", "chapter": 23, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 422559, "verses": [{"verse": 1, "start": 300, "end": 5634, "text": "Levantándose entonces toda la multitud de ellos, le llevaron a Pilato.", "words": [[0, 300], [13, 1218], [22, 1858], [27, 2338], [30, 2558], [39, 3118], [42, 3338], [49, 3878], [52, 4418], [61, 4878], [63, 4998]]}, {"verse": 2, "start": 5984, "end": 16052, "text": "Y comenzaron a acusarle, diciendo: A este hemos hallado que pervierte la nación, y que prohíbe pagar impuestos a César, diciendo que él es el Cristo, el rey.", "words": [[0, 5984], [2, 6110], [13, 6770], [15, 7050], [25, 7770], [35, 9203], [37, 9321], [42, 9561], [48, 9761], [56, 10221], [60, 10531], [70, 10841], [73, 11001], [81, 11461], [83, 11636], [87, 11756], [95, 12156], [101, 12376], [111, 12956], [113, 13196], [120, 13976], [129, 14336], [133, 14656], [136, 14836], [139, 14996], [142, 15116], [150, 15656], [153, 15716]]}, {"verse": 3, "start": 16332, "end": 25293, "text": "Entonces Pilato le preguntó, diciendo: ¿Eres tú el Rey de los judíos? Y respondiéndole él, dijo: Tú lo dices.", "words": [[0, 16332], [9, 16897], [16, 17677], [19, 17877], [29, 18837], [39, 20172], [45, 20360], [48, 20660], [51, 20840], [55, 21060], [58, 21120], [62, 21260], [70, 22248], [72, 22372], [87, 23292], [91, 23572], [97, 24320], [100, 24444], [103, 24584]]}, {"verse": 4, "start": 25643, "end": 31611, "text": "Y Pilato dijo a los principales sacerdotes, y a la gente: Ninguna culpa hallo en este hombre.", "words": [[0, 25643], [2, 25917], [9, 26417], [14, 26717], [16, 26897], [20, 26997], [32, 27817], [44, 28737], [46, 28877], [48, 28957], [51, 28977], [58, 29788], [66, 30086], [72, 30476], [78, 30866], [81, 30946], [86, 31166]]}, {"verse": 5, "start": 31891, "end": 38901, "text": "Pero ellos insistían, diciendo: Alborota al pueblo, enseñando por toda Judea, comenzando desde Galilea hasta aquí.", "words": [[0, 31891], [5, 32078], [11, 32358], [22, 33198], [32, 34290], [41, 34726], [44, 34866], [52, 35106], [62, 35746], [66, 35906], [71, 36086], [78, 36926], [89, 37546], [95, 37726], [103, 38286], [109, 38486]]}, {"verse": 6, "start": 39181, "end": 43960, "text": "Entonces Pilato, oyendo de Galilea, preguntó si el hombre era galileo.", "words": [[0, 39181], [9, 39655], [17, 40475], [24, 40855], [27, 41035], [36, 41755], [45, 42235], [48, 42395], [51, 42575], [58, 42855], [62, 43135]]}, {"verse": 7, "start": 44310, "end": 52955, "text": "Y como entendió que era de la jurisdicción de Herodes, le remitió a Herodes, el cual también estaba en Jerusalén en aquellos días.", "words": [[0, 44310], [2, 44410], [7, 44610], [16, 45150], [20, 45330], [24, 45510], [27, 45650], [30, 45790], [43, 46610], [46, 46770], [55, 47610], [58, 47710], [66, 48410], [68, 48690], [77, 49510], [80, 49630], [85, 49870], [93, 50310], [100, 50690], [103, 50870], [113, 51610], [116, 51810], [125, 52090]]}, {"verse": 8, "start": 53305, "end": 65381, "text": "Y Herodes, viendo a Jesús, se alegró mucho, porque hacía mucho que deseaba verle; porque había oído de él muchas cosas, y tenía esperanza que le vería hacer alguna señal.", "words": [[0, 53305], [2, 53489], [11, 53869], [18, 54289], [20, 54549], [27, 54909], [30, 55489], [37, 55829], [44, 56689], [51, 57089], [57, 57449], [63, 57769], [67, 57989], [75, 58489], [82, 59356], [89, 59559], [95, 59919], [100, 60519], [103, 60739], [106, 60939], [113, 61199], [120, 61739], [122, 62499], [128, 62739], [138, 63379], [142, 63539], [145, 63679], [151, 64019], [157, 64319], [164, 64619]]}, {"verse": 9, "start": 65731, "end": 70361, "text": "Y le preguntaba con muchas palabras; pero él nada le respondió:", "words": [[0, 65731], [2, 65857], [5, 65957], [16, 66617], [20, 66877], [27, 67197], [37, 68326], [42, 68511], [45, 68771], [50, 69136], [53, 69416]]}, {"verse": 10, "start": 70711, "end": 77375, "text": "Y estaban los principales sacerdotes y los escribas acusándolo con gran insistencia.", "words": [[0, 70711], [2, 70819], [10, 71179], [14, 71439], [26, 72339], [37, 73319], [39, 73579], [43, 73699], [52, 74379], [63, 75399], [67, 75639], [72, 75939]]}, {"verse": 11, "start": 77725, "end": 86812, "text": "Pero Herodes con su corte le menospreció, y se burló de él, vistiéndole de una ropa rica; y le volvió a enviar a Pilato.", "words": [[0, 77725], [5, 77907], [13, 78287], [17, 78567], [20, 78897], [26, 79227], [29, 79307], [42, 80227], [44, 80607], [47, 80787], [53, 81247], [56, 81407], [60, 81847], [72, 82807], [75, 82967], [79, 83087], [84, 83507], [90, 84388], [92, 84531], [95, 84611], [102, 85211], [104, 85391], [111, 85931], [113, 86151]]}, {"verse": 12, "start": 87162, "end": 93924, "text": "Y fueron hechos amigos entre sí Pilato y Herodes en el mismo día; porque antes eran enemigos entre sí.", "words": [[0, 87162], [2, 87283], [9, 87503], [16, 87863], [23, 88243], [29, 88643], [32, 88923], [39, 89483], [41, 89683], [49, 90143], [52, 90323], [55, 90443], [61, 90723], [66, 91418], [73, 91660], [79, 92200], [84, 92580], [93, 93160], [99, 93500]]}, {"verse": 13, "start": 94274, "end": 100489, "text": "Entonces Pilato, convocando los principales sacerdotes, y los dirigentes, y el pueblo,", "words": [[0, 94274], [9, 94898], [17, 95818], [28, 96618], [32, 96798], [44, 97598], [56, 98398], [58, 98558], [62, 98678], [74, 99338], [76, 99658], [79, 99838]]}, {"verse": 14, "start": 100839, "end": 112079, "text": "Les dijo: Me habéis presentado a este por hombre que desvía al pueblo: y he aquí, preguntando yo delante de vosotros, no he hallado culpa alguna en este hombre de aquellas de que le acusáis.", "words": [[0, 100839], [4, 101055], [10, 102237], [13, 102338], [20, 102558], [31, 103238], [33, 103378], [38, 103618], [42, 103878], [49, 104098], [53, 104298], [60, 104758], [63, 104878], [71, 105595], [73, 105737], [76, 105837], [82, 106097], [94, 106777], [97, 106937], [105, 107357], [108, 107477], [118, 108337], [121, 108537], [124, 108677], [132, 108997], [138, 109217], [145, 109677], [148, 109877], [153, 110077], [160, 110357], [163, 110537], [172, 111017], [175, 111157], [179, 111257], [182, 111397]]}, {"verse": 15, "start": 112429, "end": 118292, "text": "Y ni aun Herodes; porque os remití a él, y he aquí, ninguna cosa digna de muerte ha hecho.", "words": [[0, 112429], [2, 112591], [5, 112671], [9, 113176], [18, 113853], [25, 114052], [28, 114232], [35, 114732], [37, 114832], [41, 115072], [43, 115312], [46, 115432], [52, 115732], [60, 116352], [65, 116812], [71, 117232], [74, 117332], [81, 117592], [84, 117852]]}, {"verse": 16, "start": 118642, "end": 120998, "text": "Le soltaré, pues, después de castigarlo.", "words": [[0, 118687], [3, 118767], [12, 119037], [18, 119307], [26, 119547], [29, 120147]]}, {"verse": 17, "start": 121278, "end": 124825, "text": "Y tenía necesidad de soltarles uno en cada fiesta.", "words": [[0, 121278], [2, 121505], [8, 121765], [18, 122525], [21, 122685], [31, 123465], [35, 123825], [38, 123965], [43, 124185]]}, {"verse": 18, "start": 125175, "end": 131846, "text": "Pero toda la multitud dio voces a una, diciendo: Quita a este, y suéltanos a Barrabás:", "words": [[0, 125175], [5, 125320], [10, 125760], [13, 126040], [22, 126800], [26, 127100], [32, 127540], [34, 127740], [39, 128320], [49, 129292], [55, 129452], [57, 129652], [63, 130052], [65, 130472], [75, 131052], [77, 131232]]}, {"verse": 19, "start": 132126, "end": 138529, "text": "(El cual había sido echado en la cárcel por una revuelta ocurrida en la ciudad y un homicidio.)", "words": [[0, 132126], [4, 132283], [9, 132563], [15, 132963], [20, 133383], [27, 133903], [30, 134023], [33, 134163], [40, 134683], [44, 134983], [48, 135163], [57, 135863], [66, 136663], [69, 136843], [72, 136963], [79, 137283], [81, 137603], [84, 137743]]}, {"verse": 20, "start": 138879, "end": 142340, "text": "Y les habló otra vez Pilato, queriendo soltar a Jesús.", "words": [[0, 138879], [2, 138986], [6, 139126], [12, 139546], [17, 139806], [21, 140026], [29, 140646], [39, 141126], [46, 141606], [48, 141706]]}, {"verse": 21, "start": 142690, "end": 147668, "text": "Pero ellos volvieron a dar voces, diciendo: Crucifícale, crucifícale.", "words": [[0, 142690], [5, 142873], [11, 143173], [21, 143753], [23, 143893], [27, 144033], [34, 144673], [44, 145996], [57, 146856]]}, {"verse": 22, "start": 147948, "end": 157297, "text": "Y él les dijo la tercera vez: ¿Pues qué mal ha hecho este? Ninguna culpa de muerte he hallado en él: le castigaré, pues, y le soltaré.", "words": [[0, 147948], [2, 148169], [5, 148409], [9, 148809], [14, 149269], [17, 149469], [25, 150049], [30, 150837], [36, 150993], [40, 151173], [44, 151393], [47, 151553], [53, 151793], [59, 152552], [67, 152955], [73, 153195], [76, 153435], [83, 153775], [86, 154055], [94, 154435], [97, 154615], [101, 155122], [104, 155207], [115, 155827], [121, 156127], [123, 156447], [126, 156567]]}, {"verse": 23, "start": 157577, "end": 166277, "text": "Pero ellos instaban a grandes voces, pidiendo que fuese crucificado. Y las voces de ellos y de los principales sacerdotes crecían.", "words": [[0, 157577], [5, 157742], [11, 157982], [20, 158722], [22, 158862], [30, 159122], [37, 159922], [46, 160362], [50, 160522], [56, 160862], [69, 162210], [71, 162318], [75, 162438], [81, 162838], [84, 162998], [90, 163298], [92, 163758], [95, 163838], [99, 163958], [111, 164698], [122, 165358]]}, {"verse": 24, "start": 166627, "end": 170707, "text": "Entonces Pilato juzgó que se hiciese lo que ellos pedían;", "words": [[0, 166627], [9, 167257], [16, 167837], [22, 168397], [26, 168557], [29, 168757], [37, 169417], [40, 169637], [44, 169797], [50, 170017]]}, {"verse": 25, "start": 171057, "end": 181872, "text": "Y les soltó a aquel que había sido echado en la cárcel por una revuelta y un homicidio, al cual habían pedido; y entregó a Jesús a la voluntad de ellos.", "words": [[0, 171057], [2, 171214], [6, 171334], [12, 171954], [14, 172294], [20, 172734], [24, 172874], [30, 173094], [35, 173474], [42, 173914], [45, 174034], [48, 174174], [55, 174654], [59, 174914], [63, 175114], [72, 175834], [74, 175974], [77, 176134], [88, 176641], [91, 177149], [96, 177369], [103, 177889], [111, 178978], [113, 179119], [121, 179619], [123, 179719], [129, 180079], [131, 180379], [134, 180459], [143, 181099], [146, 181279]]}, {"verse": 26, "start": 182222, "end": 190502, "text": "Y llevándole, tomaron a un Simón cireneo, que venía del campo, y le pusieron encima la cruz para que la llevase tras Jesús.", "words": [[0, 182222], [2, 182343], [14, 182903], [22, 183563], [24, 183823], [27, 183963], [33, 184503], [42, 185043], [46, 185208], [52, 185468], [56, 185728], [63, 186228], [65, 186493], [68, 186613], [77, 187073], [84, 187673], [87, 187893], [92, 188573], [97, 188873], [101, 189013], [104, 189153], [112, 189573], [117, 189793]]}, {"verse": 27, "start": 190852, "end": 196986, "text": "Y le seguía una grande multitud de pueblo, y de mujeres, las cuales le lloraban y lamentaban.", "words": [[0, 190852], [2, 190956], [5, 191096], [12, 191556], [16, 191716], [23, 192056], [32, 192776], [35, 192936], [43, 193376], [45, 193536], [48, 193656], [57, 194496], [61, 194616], [68, 194936], [71, 195396], [80, 195916], [82, 196176]]}, {"verse": 28, "start": 197336, "end": 207266, "text": "Pero Jesús, vuelto a ellas, les dice: Hijas de Jerusalén, no me lloréis a mí, sino llorad por vosotras mismas, y por vuestros hijos.", "words": [[0, 197336], [5, 197464], [12, 198124], [19, 198504], [21, 198624], [28, 199164], [32, 199264], [38, 199999], [44, 200462], [47, 200642], [58, 201462], [61, 201702], [64, 202002], [72, 202302], [74, 202422], [78, 202962], [83, 203512], [90, 204062], [94, 204422], [103, 205062], [111, 205942], [113, 206062], [117, 206282], [126, 206702]]}, {"verse": 29, "start": 207616, "end": 217464, "text": "Porque he aquí vendrán días en que dirán: Bienaventuradas las estériles, y los vientres que no engendraron, y los pechos que no amamantaron.", "words": [[0, 207616], [7, 207700], [10, 207820], [15, 208040], [23, 208740], [28, 209100], [31, 209440], [35, 209580], [42, 211024], [58, 211594], [62, 211814], [73, 212614], [75, 213194], [79, 213334], [88, 213794], [92, 213954], [95, 214494], [108, 215034], [110, 215354], [114, 215494], [121, 215934], [125, 216094], [128, 216294]]}, {"verse": 30, "start": 217814, "end": 224683, "text": "Entonces comenzarán a decir a los montes: Caed sobre nosotros: y a las colinas: Cubridnos.", "words": [[0, 217814], [9, 218220], [20, 219080], [22, 219140], [28, 219460], [30, 219620], [34, 219740], [42, 220686], [47, 221051], [53, 221351], [63, 222417], [65, 222657], [67, 222717], [71, 222837], [80, 224240]]}, {"verse": 31, "start": 225033, "end": 230042, "text": "Porque si en el árbol verde hacen estas cosas, ¿en el seco, qué se hará?", "words": [[0, 225033], [7, 225257], [10, 225497], [13, 225697], [16, 225837], [22, 226177], [28, 226637], [34, 227097], [40, 227377], [47, 228377], [51, 228617], [54, 228737], [60, 229237], [64, 229337], [67, 229537]]}, {"verse": 32, "start": 230392, "end": 235082, "text": "Y llevaban también con él otros dos, malhechores, a ser muertos.", "words": [[0, 230392], [2, 230498], [11, 230978], [19, 231358], [23, 231598], [26, 231818], [32, 232138], [37, 232848], [50, 233558], [52, 234038], [56, 234218]]}, {"verse": 33, "start": 235432, "end": 244320, "text": "Y cuando vinieron al lugar que se llama de la Calavera, le crucificaron allí, y a los malhechores, uno a la derecha, y otro a la izquierda.", "words": [[0, 235432], [2, 235551], [9, 235771], [18, 236371], [21, 236551], [27, 236891], [31, 237111], [34, 237231], [40, 237491], [43, 237671], [46, 237791], [56, 238891], [59, 238971], [72, 239891], [78, 240251], [80, 240436], [82, 240536], [86, 241096], [99, 241656], [103, 241996], [105, 242196], [108, 242276], [117, 242836], [119, 243076], [124, 243296], [126, 243456], [129, 243536]]}, {"verse": 34, "start": 244670, "end": 252814, "text": "Y Jesús decía: Padre, perdónalos, porque no saben lo que hacen. Y partiendo sus vestidos, echaron suertes.", "words": [[0, 244670], [2, 244796], [8, 245116], [15, 246133], [22, 246536], [34, 247356], [41, 247916], [44, 248136], [50, 248516], [53, 248736], [57, 248876], [64, 249749], [66, 249837], [76, 250457], [80, 250697], [90, 251317], [98, 251917]]}, {"verse": 35, "start": 253164, "end": 265363, "text": "Y el pueblo estaba mirando; y se burlaban de él los dirigentes con ellos, diciendo: A otros hizo salvos: sálvese a sí, si este es el Mesías, el escogido de Dios.", "words": [[0, 253164], [2, 253421], [5, 253541], [12, 253881], [19, 254221], [28, 255281], [30, 255428], [33, 255568], [42, 256168], [45, 256428], [48, 256608], [52, 256748], [63, 257348], [67, 257628], [74, 257928], [84, 259162], [86, 259307], [92, 259770], [97, 260234], [105, 260864], [113, 261108], [115, 261394], [119, 261681], [122, 262021], [127, 262261], [130, 262421], [133, 262521], [141, 263381], [144, 263461], [153, 263961], [156, 264101]]}, {"verse": 36, "start": 265643, "end": 271242, "text": "Se burlaban de él también los soldados, llegándose y presentándole vinagre,", "words": [[0, 265643], [3, 265845], [12, 266425], [15, 266665], [18, 266885], [26, 267205], [30, 267485], [40, 268325], [51, 269245], [53, 269545], [67, 270505]]}, {"verse": 37, "start": 271592, "end": 275920, "text": "Y diciendo: Si tú eres el Rey de los judíos, sálvate a ti mismo.", "words": [[0, 271592], [2, 271722], [12, 272693], [15, 272873], [18, 273053], [23, 273253], [26, 273453], [30, 273693], [33, 273753], [37, 273873], [45, 274673], [53, 275153], [55, 275313], [58, 275393]]}, {"verse": 38, "start": 276200, "end": 285082, "text": "Y había también sobre él un letrero escrito con letras griegas, y latinas, y hebreas: ESTE ES EL REY DE LOS JUDÍOS.", "words": [[0, 276200], [2, 276306], [8, 276506], [16, 276806], [22, 277226], [25, 277546], [28, 277766], [36, 278386], [44, 278766], [48, 279286], [55, 279786], [64, 280506], [66, 280726], [75, 281246], [77, 281546], [86, 282448], [91, 282836], [94, 283236], [97, 283736], [101, 284076], [104, 284156], [108, 284316]]}, {"verse": 39, "start": 285432, "end": 294031, "text": "Y uno de los malhechores que estaban colgados, le injuriaba, diciendo: Si tú eres el Cristo, sálvate a ti mismo y a nosotros.", "words": [[0, 285432], [2, 285556], [6, 285716], [9, 285836], [13, 285956], [25, 286576], [29, 286776], [37, 287286], [47, 287796], [50, 288256], [61, 289116], [71, 290347], [74, 290552], [77, 290712], [82, 290892], [85, 291052], [93, 292052], [101, 292412], [103, 292592], [106, 292672], [112, 293032], [114, 293212], [116, 293292]]}, {"verse": 40, "start": 294311, "end": 301809, "text": "Y respondiendo el otro, le reprendió, diciendo: ¿Ni aun tú temes a Dios, estando en la misma condenación?", "words": [[0, 294311], [2, 294716], [15, 295156], [18, 295356], [24, 296116], [27, 296356], [38, 297136], [48, 298388], [52, 298546], [56, 298706], [59, 298966], [65, 299346], [67, 299446], [73, 299966], [81, 300366], [84, 300466], [87, 300566], [93, 300806]]}, {"verse": 41, "start": 302159, "end": 309357, "text": "Y nosotros, a la verdad, justamente padecemos; porque recibimos lo que merecieron nuestros hechos: pero este ningún mal hizo.", "words": [[0, 302159], [2, 302244], [12, 302764], [14, 302864], [17, 302944], [25, 303604], [36, 303944], [47, 305160], [54, 305343], [64, 305963], [67, 306143], [71, 306263], [82, 306803], [91, 307063], [99, 307813], [104, 308131], [109, 308351], [116, 308691], [120, 309051]]}, {"verse": 42, "start": 309637, "end": 313326, "text": "Y dijo a Jesús: Acuérdate de mí cuando vengas a tu reino.", "words": [[0, 309637], [2, 309803], [7, 310083], [9, 310183], [16, 311115], [26, 311637], [29, 311877], [32, 311997], [39, 312217], [46, 312697], [48, 312777], [51, 312897]]}, {"verse": 43, "start": 313606, "end": 319258, "text": "Entonces Jesús le dijo: De cierto te digo, que hoy estarás conmigo en el paraíso.", "words": [[0, 313606], [9, 314070], [15, 314570], [18, 314890], [24, 315598], [27, 315744], [34, 316044], [37, 316424], [43, 316784], [47, 316999], [51, 317259], [59, 317739], [67, 318259], [70, 318379], [73, 318845]]}, {"verse": 44, "start": 319608, "end": 327112, "text": "Y cuando era como la hora de sexta, fueron hechas tinieblas sobre toda la tierra hasta la hora de nona.", "words": [[0, 319608], [2, 319732], [9, 319992], [13, 320332], [18, 320592], [21, 320792], [26, 320972], [29, 321152], [36, 322072], [43, 322532], [50, 323052], [60, 323572], [66, 323832], [71, 324192], [74, 324392], [81, 324732], [87, 325192], [90, 325680], [95, 326169], [98, 326657]]}, {"verse": 45, "start": 327462, "end": 331951, "text": "Y el sol se oscureció: y el velo del templo se rompió por medio.", "words": [[0, 327462], [2, 327462], [5, 327462], [9, 327462], [12, 327707], [23, 328933], [25, 329060], [28, 329200], [33, 329500], [37, 329660], [44, 330300], [47, 330380], [54, 330960], [58, 331220]]}, {"verse": 46, "start": 332301, "end": 342672, "text": "Entonces Jesús, clamando a gran voz, dijo: Padre, en tus manos encomiendo mi espíritu. Y habiendo dicho esto, exhaló su último aliento.", "words": [[0, 332301], [9, 332779], [16, 333519], [25, 334019], [27, 334099], [32, 334259], [37, 334859], [43, 335499], [50, 335987], [53, 336247], [57, 336427], [63, 336827], [74, 337667], [77, 337907], [87, 338953], [89, 339080], [98, 339400], [104, 339700], [110, 340720], [117, 341220], [120, 341380], [127, 341840]]}, {"verse": 47, "start": 343022, "end": 351191, "text": "Y como el centurión vio lo que había acontecido, dio gloria a Dios, diciendo: Verdaderamente este hombre era justo.", "words": [[0, 343022], [2, 343123], [7, 343363], [10, 343563], [20, 344183], [24, 344463], [27, 344583], [31, 344743], [37, 344983], [49, 346203], [53, 346603], [60, 347203], [62, 347523], [68, 347783], [78, 349104], [93, 349902], [98, 350122], [105, 350382], [109, 350642]]}, {"verse": 48, "start": 351471, "end": 361188, "text": "Y toda la multitud de los que estaban presentes a este espectáculo, viendo lo que había acontecido, se volvían golpeándose el pecho.", "words": [[0, 351471], [2, 351596], [7, 351876], [10, 352116], [19, 352896], [22, 353176], [26, 353316], [30, 353436], [38, 353776], [48, 354516], [50, 354636], [55, 354876], [68, 356096], [75, 356596], [78, 356896], [82, 357036], [88, 357356], [100, 358596], [103, 358776], [111, 359316], [123, 360276], [126, 360476]]}, {"verse": 49, "start": 361538, "end": 368763, "text": "Pero todos sus conocidos, y las mujeres que le habían seguido desde Galilea, estaban lejos mirando estas cosas.", "words": [[0, 361538], [5, 361679], [11, 361999], [15, 362299], [26, 363099], [28, 363259], [32, 363399], [40, 363819], [44, 364139], [47, 364299], [54, 364559], [62, 365139], [68, 365319], [77, 366099], [85, 366679], [91, 367279], [99, 367824], [105, 367984]]}, {"verse": 50, "start": 369113, "end": 376179, "text": "Y he aquí un varón llamado José, el cual era miembro del Consejo, varón bueno y justo,", "words": [[0, 369113], [2, 369258], [5, 369418], [10, 369698], [13, 369938], [19, 370298], [27, 370578], [33, 371758], [36, 371858], [41, 372118], [45, 372518], [53, 373098], [57, 373278], [66, 374538], [72, 374978], [78, 375278], [80, 375558]]}, {"verse": 51, "start": 376529, "end": 386480, "text": "(El cual no había consentido en el consejo ni en los hechos de ellos), de Arimatea, ciudad de la Judea, el cual también esperaba el reino de Dios;", "words": [[0, 376529], [4, 376671], [9, 376831], [12, 377071], [18, 377311], [29, 378091], [32, 378191], [35, 378291], [43, 378871], [46, 378991], [49, 379091], [53, 379251], [60, 379571], [63, 379771], [71, 380551], [74, 380791], [84, 381811], [91, 382251], [94, 382551], [97, 382671], [104, 383571], [107, 383691], [112, 383911], [120, 384471], [129, 385271], [132, 385431], [138, 385831], [141, 385971]]}, {"verse": 52, "start": 386830, "end": 390686, "text": "Este llegó a Pilato, y pidió el cuerpo de Jesús.", "words": [[0, 386830], [5, 387087], [11, 387407], [13, 387507], [21, 388047], [23, 388847], [29, 389187], [32, 389287], [39, 389647], [42, 389927]]}, {"verse": 53, "start": 391036, "end": 400402, "text": "Y quitado, lo envolvió en una sábana, y le puso en un sepulcro abierto en una peña, en el cual ninguno había aún sido puesto.", "words": [[0, 391036], [2, 391163], [11, 391603], [14, 391743], [23, 392263], [26, 392363], [30, 392523], [38, 393143], [40, 393803], [43, 393943], [48, 394363], [51, 394503], [54, 394663], [63, 395403], [71, 396143], [74, 396363], [78, 396523], [84, 397043], [87, 397523], [90, 397643], [95, 397903], [103, 398623], [109, 398903], [113, 399283], [118, 399643]]}, {"verse": 54, "start": 400752, "end": 405366, "text": "Y era día de la víspera de la Pascua; y estaba para comenzar el sábado.", "words": [[0, 400752], [2, 400954], [6, 401094], [10, 401334], [13, 401534], [16, 401674], [24, 402134], [27, 402214], [30, 402314], [38, 403189], [40, 403313], [47, 403633], [52, 403913], [61, 404573], [64, 404693]]}, {"verse": 55, "start": 405716, "end": 414300, "text": "Y las mujeres que con él habían venido de Galilea, siguieron también y vieron el sepulcro, y cómo fue puesto su cuerpo.", "words": [[0, 405716], [2, 405954], [6, 406074], [14, 406554], [18, 406879], [22, 407099], [25, 407239], [32, 407479], [39, 407939], [42, 408099], [51, 408799], [61, 409579], [69, 409999], [71, 410599], [78, 410939], [81, 411139], [91, 411859], [93, 412459], [98, 412759], [102, 413039], [109, 413419], [112, 413659]]}, {"verse": 56, "start": 414650, "end": 422159, "text": "Y vueltas, prepararon especias aromáticas y ungüentos; y descansaron el sábado, conforme al mandamiento.", "words": [[0, 414650], [2, 414771], [11, 415231], [22, 415951], [31, 416671], [42, 417431], [44, 417711], [55, 418846], [57, 418968], [69, 419708], [72, 419888], [80, 420528], [89, 421188], [92, 421288]]}]}