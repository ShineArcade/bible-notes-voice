{"book": "LUK", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 558905, "verses": [{"verse": 1, "start": 300, "end": 9338, "text": "Y juntando a sus doce discípulos, les dio poder y autoridad sobre todos los demonios, y que sanasen enfermedades.", "words": [[0, 300], [2, 422], [11, 1002], [13, 1122], [17, 1262], [22, 1622], [34, 2621], [38, 2802], [42, 3002], [48, 3362], [50, 3641], [60, 4342], [66, 4702], [72, 5082], [76, 5361], [86, 6242], [88, 6401], [92, 6802], [100, 7202]]}, {"verse": 2, "start": 9788, "end": 15574, "text": "Y los envió a que predicasen el reino de Dios, y que sanasen a los enfermos.", "words": [[0, 9788], [2, 9914], [6, 10034], [12, 10554], [14, 10774], [18, 11304], [29, 11834], [32, 12094], [38, 12554], [41, 12714], [47, 13034], [49, 13654], [53, 14084], [61, 14514], [63, 14614], [67, 14754]]}, {"verse": 3, "start": 16024, "end": 25350, "text": "Y les dice: No toméis nada para el camino, ni bastón, ni alforja, ni pan, ni dinero; ni tengáis dos vestidos cada uno.", "words": [[0, 16024], [2, 16290], [6, 16588], [12, 17134], [15, 17283], [22, 17703], [27, 17963], [32, 18283], [35, 18443], [43, 19243], [46, 19423], [54, 20383], [57, 20463], [66, 21183], [69, 21323], [74, 22063], [77, 22183], [85, 23204], [88, 23354], [96, 23774], [100, 23974], [109, 24494], [114, 24754]]}, {"verse": 4, "start": 25800, "end": 30296, "text": "Y en cualquier casa donde entréis, quedad allí, y de allí salid.", "words": [[0, 25800], [2, 25927], [5, 26027], [15, 26287], [20, 26927], [26, 27617], [35, 28307], [42, 28687], [48, 29027], [50, 29387], [53, 29527], [58, 29707]]}, {"verse": 5, "start": 30746, "end": 40593, "text": "Y todos los que no os reciban, saliéndoos de aquella ciudad, aun el polvo sacudid de vuestros pies en testimonio contra ellos.", "words": [[0, 30746], [2, 30871], [8, 31171], [12, 31871], [16, 32271], [19, 32491], [22, 32731], [31, 33771], [42, 34811], [45, 34991], [53, 35331], [61, 35711], [65, 36371], [68, 36571], [74, 37181], [82, 37791], [85, 37971], [94, 38291], [99, 38571], [102, 38811], [113, 39551], [120, 39871]]}, {"verse": 6, "start": 41043, "end": 48781, "text": "Y saliendo, rodeaban por todas las aldeas, anunciando el evangelio, y sanando por todas partes.", "words": [[0, 41043], [2, 41186], [12, 41786], [21, 42946], [25, 43246], [31, 43566], [35, 43886], [43, 44806], [54, 45646], [57, 45766], [68, 46606], [70, 46966], [78, 47426], [82, 47646], [88, 47906]]}, {"verse": 7, "start": 49231, "end": 58777, "text": "Y oyó Herodes el tetrarca todas las cosas que hacía; y estaba en duda, porque decían algunos: Juan ha resucitado de los muertos;", "words": [[0, 49231], [2, 49354], [6, 49779], [14, 50204], [17, 50629], [26, 51054], [32, 51314], [36, 51654], [42, 52014], [46, 52274], [53, 53211], [55, 53482], [62, 53762], [65, 53982], [71, 54262], [78, 54662], [85, 55202], [94, 56290], [99, 56611], [102, 56911], [113, 57711], [116, 57871], [120, 57971]]}, {"verse": 8, "start": 59227, "end": 66508, "text": "Y otros: Elías ha aparecido; y otros: Algún profeta de los antiguos ha resucitado.", "words": [[0, 59227], [2, 59429], [9, 60342], [15, 60905], [18, 61165], [29, 62444], [31, 62765], [38, 63665], [44, 64021], [52, 64561], [55, 64681], [59, 64821], [68, 65401], [71, 65501]]}, {"verse": 9, "start": 66958, "end": 74553, "text": "Y dijo Herodes: A Juan yo degollé: ¿quién pues será este, de quien yo oigo tales cosas? Y procuraba verle.", "words": [[0, 66958], [2, 67198], [7, 67458], [16, 68413], [18, 68532], [23, 68892], [26, 69252], [35, 69853], [42, 70117], [47, 70257], [52, 70517], [58, 70897], [61, 71177], [67, 71337], [70, 71537], [75, 71777], [81, 71997], [88, 73122], [90, 73261], [100, 73881]]}, {"verse": 10, "start": 75003, "end": 86269, "text": "Y vueltos los apóstoles, le contaron todas las cosas que habían hecho. Y tomándolos, se retiró aparte a un lugar desierto de la ciudad que se llama Betsaida.", "words": [[0, 75003], [2, 75129], [10, 75569], [14, 75689], [25, 76469], [28, 76969], [37, 77529], [43, 77849], [47, 78149], [53, 78449], [57, 78649], [64, 78889], [71, 79686], [73, 79790], [85, 80650], [88, 80950], [95, 81470], [102, 82170], [104, 82310], [107, 82490], [113, 82830], [122, 83550], [125, 83790], [128, 83910], [135, 84230], [139, 84550], [142, 84670], [148, 85496]]}, {"verse": 11, "start": 86719, "end": 97508, "text": "Y cuando la gente lo supo, lo siguió; y él la recibió, y les hablaba del reino de Dios, y sanaba a los que tenían necesidad de cura.", "words": [[0, 86719], [2, 86802], [9, 87022], [12, 87222], [18, 87542], [21, 87822], [27, 88322], [30, 88622], [38, 89545], [40, 89733], [43, 89953], [46, 90333], [55, 91333], [57, 91513], [61, 91673], [69, 92313], [73, 92553], [79, 93013], [82, 93173], [88, 93513], [90, 94313], [97, 94813], [99, 94973], [103, 95073], [107, 95213], [114, 95633], [124, 96693], [127, 96873]]}, {"verse": 12, "start": 97958, "end": 112796, "text": "Y el día había comenzado a declinar; y acercándose los doce, le dijeron: Despide a la gente, para que yendo a las aldeas y campos de alrededor, procedan a alojarse y encuentren comida; porque aquí estamos en lugar desierto.", "words": [[0, 97958], [2, 98083], [5, 98203], [9, 98423], [15, 98703], [25, 99423], [27, 99503], [37, 100496], [39, 100603], [51, 101483], [55, 101703], [61, 102243], [64, 102663], [73, 103696], [81, 104135], [83, 104215], [86, 104255], [93, 104655], [98, 105195], [102, 105355], [108, 105535], [110, 105715], [114, 105855], [121, 106395], [123, 106515], [130, 106935], [133, 107015], [144, 107515], [153, 108435], [155, 108535], [164, 109115], [166, 109315], [177, 109795], [185, 110702], [192, 110913], [197, 111153], [205, 111573], [208, 111793], [214, 111973]]}, {"verse": 13, "start": 113146, "end": 124217, "text": "Y les dice: Dadles vosotros de comer. Y dijeron ellos: No tenemos más que cinco panes y dos pescados, si no vamos nosotros a comprar comida para toda esta multitud.", "words": [[0, 113146], [2, 113411], [6, 113709], [12, 114562], [19, 114902], [28, 115582], [31, 115802], [38, 116707], [40, 116833], [48, 117313], [55, 118169], [58, 118291], [66, 118571], [70, 118871], [74, 119071], [80, 119271], [86, 119711], [88, 119811], [92, 119911], [102, 120811], [105, 121011], [108, 121091], [114, 121351], [123, 121671], [125, 121971], [133, 122271], [140, 122691], [145, 122971], [150, 123211], [155, 123511]]}, {"verse": 14, "start": 124567, "end": 133768, "text": "Y eran como cinco mil hombres. Entonces dijo a sus discípulos: Hacedlos sentar en grupos, de cincuenta en cincuenta.", "words": [[0, 124567], [2, 124711], [7, 124931], [12, 125231], [18, 125531], [22, 125831], [31, 126845], [40, 127414], [45, 127794], [47, 128014], [51, 128174], [63, 129327], [72, 129968], [79, 130688], [82, 130828], [90, 131248], [93, 131838], [103, 132428], [106, 133098]]}, {"verse": 15, "start": 134218, "end": 137934, "text": "Y así lo hicieron, haciéndolos sentar a todos.", "words": [[0, 134218], [2, 134343], [6, 134523], [9, 134743], [19, 135883], [31, 136623], [38, 137223], [40, 137303]]}, {"verse": 16, "start": 138384, "end": 149201, "text": "Y tomando los cinco panes y los dos pescados, mirando al cielo los bendijo, y partió, y dio a sus discípulos para que pusiesen delante de la gente.", "words": [[0, 138384], [2, 138508], [10, 138968], [14, 139168], [20, 139628], [26, 140348], [28, 140568], [32, 140728], [36, 140888], [46, 141508], [54, 142248], [57, 142448], [63, 142728], [67, 142948], [76, 143528], [78, 144028], [86, 144628], [88, 145208], [92, 145408], [94, 145568], [98, 145768], [109, 146708], [114, 147328], [118, 147468], [127, 147928], [135, 148448], [138, 148588], [141, 148688]]}, {"verse": 17, "start": 149651, "end": 156178, "text": "Y comieron todos, y se saciaron; y alzaron lo que les sobró, doce cestos de pedazos.", "words": [[0, 149651], [2, 149924], [11, 150304], [18, 150784], [20, 151144], [23, 151244], [33, 152443], [35, 152547], [43, 153127], [46, 153307], [50, 153427], [54, 153587], [61, 154160], [66, 154734], [73, 155307], [76, 155407]]}, {"verse": 18, "start": 156628, "end": 165738, "text": "Y aconteció que estando él solo orando, estaban con él los discípulos; y les preguntó diciendo: ¿Quién dice la gente que soy yo?", "words": [[0, 156628], [2, 156896], [12, 157616], [16, 157836], [24, 158276], [27, 158516], [32, 158856], [40, 159896], [48, 160256], [52, 160556], [55, 160716], [59, 160876], [71, 162042], [73, 162326], [77, 162446], [86, 163066], [96, 164116], [103, 164376], [108, 164576], [111, 164756], [117, 164976], [121, 165156], [125, 165336]]}, {"verse": 19, "start": 166188, "end": 177298, "text": "Y ellos respondieron, y dijeron: Juan el Bautista; y otros, Elías; y otros, que algún profeta de los antiguos ha resucitado.", "words": [[0, 166188], [2, 166350], [8, 166530], [22, 167390], [24, 167810], [33, 168680], [38, 169021], [41, 169341], [51, 170388], [53, 170570], [60, 171130], [67, 172009], [69, 172178], [76, 172438], [80, 172878], [86, 173158], [94, 173618], [97, 173758], [101, 173878], [110, 174538], [113, 174718]]}, {"verse": 20, "start": 177648, "end": 186360, "text": "Y les dijo: ¿Y vosotros, quién decís que soy? Entonces respondiendo Simón Pedro, dijo: El Cristo de Dios.", "words": [[0, 177648], [2, 177777], [6, 177937], [12, 178750], [15, 178854], [25, 179254], [31, 179494], [37, 179894], [41, 179974], [46, 180780], [55, 181698], [68, 182738], [74, 183138], [81, 183558], [87, 184686], [90, 184806], [97, 185186], [100, 185426]]}, {"verse": 21, "start": 186710, "end": 191409, "text": "Pero él, advirtiéndoles, mandó que a nadie dijesen esto;", "words": [[0, 186710], [5, 186875], [9, 187375], [25, 188975], [31, 189515], [35, 189695], [37, 189815], [43, 190365], [51, 190915]]}, {"verse": 22, "start": 191859, "end": 207761, "text": "Diciendo: Es necesario que el Hijo del hombre padezca muchas cosas, y sea desechado de los ancianos, y de los principales sacerdotes, y de los escribas, y que sea muerto, y resucite al tercer día.", "words": [[0, 191859], [10, 192933], [13, 193220], [23, 194220], [27, 194500], [30, 194700], [35, 194960], [39, 195100], [46, 195500], [54, 196060], [61, 196360], [68, 196940], [70, 197820], [74, 198080], [84, 198900], [87, 199040], [91, 199200], [101, 199940], [103, 200260], [106, 200340], [110, 200460], [122, 201220], [134, 202080], [136, 202560], [139, 202660], [143, 202820], [153, 203560], [155, 204060], [159, 204180], [163, 204380], [171, 205409], [173, 205766], [182, 206546], [185, 206726], [192, 207026]]}, {"verse": 23, "start": 208211, "end": 216532, "text": "Y decía a todos: Si alguno quiere venir en pos de mí, niéguese a sí mismo, y tome su cruz cada día, y sígame.", "words": [[0, 208211], [2, 208367], [8, 208867], [10, 209167], [17, 210231], [20, 210373], [27, 210813], [34, 210973], [40, 211313], [43, 211513], [47, 211713], [50, 211873], [54, 212393], [63, 212913], [65, 213193], [68, 213293], [75, 213673], [77, 214173], [82, 214513], [85, 214693], [90, 215133], [95, 215333], [100, 215693], [102, 215913]]}, {"verse": 24, "start": 216982, "end": 224667, "text": "Porque todo el que quiera salvar su vida, la perderá; y todo el que pierda su vida por causa de mí, este la salvará.", "words": [[0, 216982], [7, 217184], [12, 217494], [15, 217804], [19, 217924], [26, 218224], [33, 218644], [36, 218944], [42, 219264], [45, 219444], [54, 220465], [56, 220586], [61, 220856], [64, 221126], [68, 221246], [75, 221646], [78, 221786], [83, 222046], [87, 222266], [93, 222606], [96, 222906], [100, 223506], [105, 223806], [108, 223966]]}, {"verse": 25, "start": 225117, "end": 233298, "text": "Porque ¿qué aprovecha al hombre, si gana todo el mundo, y se pierde él a sí mismo, o se perjudica a sí mismo?", "words": [[0, 225117], [7, 225361], [12, 225701], [22, 226421], [25, 226561], [33, 226901], [36, 227421], [41, 227721], [46, 228001], [49, 228261], [56, 228661], [58, 229221], [61, 229361], [68, 229841], [71, 230041], [73, 230161], [76, 230281], [83, 230741], [85, 231201], [88, 231341], [98, 232241], [100, 232481], [103, 232621]]}, {"verse": 26, "start": 233748, "end": 245507, "text": "Porque el que se avergüence de mí y de mis palabras, de este se avergonzará el Hijo del hombre cuando venga en su gloria y en la del Padre, y de los santos ángeles.", "words": [[0, 233748], [7, 233991], [10, 234291], [14, 234471], [17, 234931], [28, 235391], [31, 235631], [34, 235831], [36, 236091], [39, 236211], [43, 236351], [53, 236811], [56, 237691], [61, 238151], [64, 238671], [76, 239491], [79, 239711], [84, 240031], [88, 240211], [95, 240591], [102, 240791], [108, 241311], [111, 241431], [114, 241591], [121, 242031], [123, 242311], [126, 242451], [129, 242591], [133, 242811], [140, 243745], [142, 243945], [145, 244065], [149, 244205], [156, 244705]]}, {"verse": 27, "start": 245957, "end": 253417, "text": "Y os digo en verdad, que hay algunos de los que están aquí, que no probarán la muerte, hasta que vean el reino de Dios.", "words": [[0, 245957], [2, 246093], [5, 246193], [10, 246413], [13, 246553], [21, 246873], [25, 247173], [29, 247373], [37, 247793], [40, 247973], [44, 248073], [48, 248193], [54, 248393], [60, 249393], [64, 249493], [67, 249673], [76, 250293], [79, 250433], [87, 250913], [93, 251633], [97, 251813], [102, 252153], [105, 252313], [111, 252673], [114, 252833]]}, {"verse": 28, "start": 253867, "end": 263206, "text": "Y aconteció como ocho días después de estas palabras, que tomó a Pedro y a Juan y a Jacobo, y subió al monte a orar.", "words": [[0, 253867], [2, 253986], [12, 254806], [17, 255106], [22, 255526], [27, 255846], [35, 256326], [38, 256586], [44, 256826], [54, 258066], [58, 258306], [63, 258666], [65, 258766], [71, 259106], [73, 259366], [75, 259426], [80, 259786], [82, 259966], [84, 260006], [92, 260766], [94, 261326], [100, 261786], [103, 262046], [109, 262426], [111, 262726]]}, {"verse": 29, "start": 263656, "end": 271167, "text": "Y entre tanto que oraba, la apariencia de su rostro se hizo otra, y su vestido blanco y resplandeciente.", "words": [[0, 263656], [2, 263774], [8, 264034], [14, 264434], [18, 264694], [25, 265374], [28, 265794], [39, 266454], [42, 266634], [45, 266834], [52, 267394], [55, 267554], [60, 267894], [66, 268414], [68, 268934], [71, 269094], [79, 269534], [86, 269894], [88, 270034]]}, {"verse": 30, "start": 271617, "end": 277207, "text": "Y he aquí dos varones que hablaban con él, los cuales eran Moisés y Elías;", "words": [[0, 271617], [2, 271801], [5, 271941], [10, 272221], [14, 272421], [22, 272881], [26, 273061], [35, 273461], [39, 273661], [43, 274281], [47, 274421], [54, 274621], [59, 274941], [66, 275841], [68, 276401]]}, {"verse": 31, "start": 277657, "end": 284530, "text": "Que aparecieron en majestad, y hablaban de su partida, la cual había de cumplir en Jerusalén.", "words": [[0, 277657], [4, 277761], [16, 278561], [19, 278741], [29, 279561], [31, 280121], [40, 280561], [43, 280721], [46, 280881], [55, 281781], [58, 282041], [63, 282261], [69, 282541], [72, 282721], [80, 283381], [83, 283601]]}, {"verse": 32, "start": 284980, "end": 295266, "text": "Y Pedro y los que estaban con él, estaban cargados de sueño: y como despertaron, vieron su majestad, y a aquellos dos varones que estaban con él.", "words": [[0, 284980], [2, 285085], [8, 285625], [10, 286045], [14, 286185], [18, 286325], [26, 286665], [30, 286965], [34, 287185], [42, 287565], [51, 288305], [54, 288465], [61, 289410], [63, 289553], [68, 289853], [81, 290953], [88, 291253], [91, 291533], [101, 292033], [103, 292533], [105, 293033], [114, 293453], [118, 293733], [126, 294153], [130, 294333], [138, 294593], [142, 294893]]}, {"verse": 33, "start": 295716, "end": 310417, "text": "Y aconteció, que apartándose ellos de él, Pedro dice a Jesús: Maestro, bien es que nos quedemos aquí: y hagamos tres refugios, uno para ti, y uno para Moisés, y uno para Elías; no sabiendo lo que se decía.", "words": [[0, 295716], [2, 296012], [13, 296772], [17, 297012], [29, 297792], [35, 298112], [38, 298312], [42, 298592], [48, 299452], [53, 299772], [55, 299972], [62, 300895], [71, 301131], [76, 301405], [79, 301678], [83, 301798], [87, 301938], [96, 302378], [102, 303172], [104, 303293], [112, 303633], [117, 303893], [127, 304753], [131, 304933], [136, 305193], [140, 305453], [142, 305973], [146, 306133], [151, 306353], [159, 306753], [161, 307153], [165, 307313], [170, 307553], [177, 308519], [180, 308666], [189, 309166], [192, 309346], [196, 309486], [199, 309626]]}, {"verse": 34, "start": 310867, "end": 318351, "text": "Y estando él hablando esto, vino una nube que los cubrió; y tuvieron temor, entrando ellos en la nube.", "words": [[0, 310867], [2, 310976], [10, 311356], [13, 311556], [22, 311856], [28, 312736], [33, 312976], [37, 313196], [42, 313576], [46, 313736], [50, 313876], [58, 314972], [60, 315097], [69, 315517], [76, 316137], [85, 316727], [91, 317317], [94, 317617], [97, 317737]]}, {"verse": 35, "start": 318801, "end": 325013, "text": "Y vino una voz de la nube, que decía: Este es mi Hijo amado; a él oíd.", "words": [[0, 318801], [2, 318924], [7, 319203], [11, 319523], [15, 319843], [18, 320023], [21, 320164], [27, 320484], [31, 320643], [38, 321612], [43, 321935], [46, 322195], [49, 322375], [54, 322595], [61, 323973], [63, 324225], [66, 324478]]}, {"verse": 36, "start": 325364, "end": 334762, "text": "Y pasada aquella voz, Jesús fue hallado solo: y ellos callaron; y por aquellos días no dijeron nada a nadie de lo que habían visto.", "words": [[0, 325364], [2, 325472], [9, 326012], [17, 326412], [22, 327052], [28, 327432], [32, 327932], [40, 328352], [46, 329284], [48, 329447], [54, 330022], [64, 330841], [66, 330920], [70, 331060], [79, 331240], [84, 331620], [87, 331860], [95, 332440], [100, 332840], [102, 333080], [108, 333360], [111, 333580], [114, 333700], [118, 333840], [125, 334120]]}, {"verse": 37, "start": 335212, "end": 342957, "text": "Y aconteció al día siguiente, que apartándose ellos del monte, una gran multitud les salió al encuentro.", "words": [[0, 335212], [2, 335329], [12, 335969], [15, 336149], [19, 336289], [30, 336749], [34, 337169], [46, 337989], [52, 338409], [56, 338649], [63, 339529], [67, 339729], [72, 340049], [81, 340909], [85, 341249], [91, 341949], [94, 342129]]}, {"verse": 38, "start": 343407, "end": 351053, "text": "Y he aquí, un hombre de la multitud clamó, diciendo: Maestro, te ruego que veas a mi hijo; que es el único que tengo:", "words": [[0, 343407], [2, 343611], [5, 343731], [11, 343951], [14, 344131], [21, 344391], [24, 344571], [27, 344691], [36, 345291], [43, 345891], [53, 347184], [62, 347750], [65, 347830], [71, 348150], [75, 348350], [80, 348750], [82, 348850], [85, 348970], [91, 349726], [95, 349827], [98, 349947], [101, 350107], [107, 350287], [111, 350527]]}, {"verse": 39, "start": 351503, "end": 360740, "text": "Y he aquí un espíritu le toma, y de repente da voces; y lo sacude con violencia y le hace echar espuma, y apenas se aparta de él quebrantándole.", "words": [[0, 351503], [2, 351660], [5, 351740], [10, 352020], [13, 352200], [22, 352760], [25, 352840], [31, 353200], [33, 353660], [36, 353780], [44, 354100], [47, 354380], [54, 355294], [56, 355500], [59, 355720], [66, 355940], [70, 356160], [80, 356820], [82, 357080], [85, 357200], [90, 357420], [96, 357740], [104, 358520], [106, 358580], [113, 358840], [116, 359120], [123, 359560], [126, 359680], [129, 359800]]}, {"verse": 40, "start": 361190, "end": 364543, "text": "Y rogué a tus discípulos que le echasen fuera, y no pudieron.", "words": [[0, 361190], [2, 361315], [8, 361675], [10, 361775], [14, 361895], [25, 362555], [29, 362735], [32, 363042], [40, 363348], [47, 363655], [49, 363835], [52, 363955]]}, {"verse": 41, "start": 364893, "end": 375056, "text": "Y respondiendo Jesús, dice: ¡Oh generación infiel y perversa! ¿hasta cuándo tengo de estar con vosotros, y os sufriré? Trae tu hijo acá.", "words": [[0, 364893], [2, 365017], [15, 365777], [22, 366737], [28, 367596], [32, 367696], [43, 368376], [50, 368876], [52, 368996], [62, 370075], [69, 370282], [76, 370582], [82, 370982], [85, 371162], [91, 371382], [95, 371662], [105, 372182], [107, 372342], [110, 372442], [119, 373633], [124, 374069], [127, 374229], [132, 374529]]}, {"verse": 42, "start": 375506, "end": 387242, "text": "Y como aún se acercaba, el demonio lo derribó y lo sacudió con violencia: pero Jesús reprendió al espíritu inmundo, y sanó al muchacho, y se lo volvió a su padre.", "words": [[0, 375506], [2, 375648], [7, 375968], [11, 376248], [14, 376488], [24, 377428], [27, 377568], [35, 378128], [38, 378288], [46, 378848], [48, 378928], [51, 379048], [59, 379588], [63, 379768], [74, 381095], [79, 381237], [85, 381637], [95, 382797], [98, 382957], [107, 383637], [116, 384217], [118, 384457], [123, 384857], [126, 384997], [136, 385537], [138, 385677], [141, 385797], [144, 385957], [151, 386417], [153, 386497], [156, 386657]]}, {"verse": 43, "start": 387692, "end": 397082, "text": "Y todos estaban atónitos de la grandeza de Dios. Y maravillándose todos de todas las cosas que hacía, dijo a sus discípulos:", "words": [[0, 387692], [2, 387855], [8, 388155], [16, 388755], [25, 389455], [28, 389695], [31, 389795], [40, 390455], [43, 390615], [49, 391474], [51, 391583], [66, 392483], [72, 393003], [75, 393503], [81, 393803], [85, 394103], [91, 394443], [95, 394723], [102, 395483], [107, 395903], [109, 396063], [113, 396223]]}, {"verse": 44, "start": 397532, "end": 405957, "text": "Poned vosotros en vuestros oídos estas palabras; porque ha de acontecer que el Hijo del hombre será entregado en manos de hombres.", "words": [[0, 397532], [6, 397857], [15, 398417], [18, 398637], [27, 399017], [33, 399437], [39, 399657], [49, 400811], [56, 401035], [59, 401335], [62, 401415], [72, 402055], [76, 402375], [79, 402715], [84, 403055], [88, 403215], [95, 403675], [100, 403895], [110, 404615], [113, 404735], [119, 404995], [122, 405215]]}, {"verse": 45, "start": 406407, "end": 416026, "text": "Pero ellos no entendían esta palabra, y les era encubierta para que no la entendiesen; y temían preguntarle de esta palabra.", "words": [[0, 406407], [5, 406649], [11, 406929], [14, 407609], [24, 408409], [29, 408689], [38, 409269], [40, 409849], [44, 410049], [48, 410249], [59, 411169], [64, 411769], [68, 411949], [71, 412109], [74, 412249], [87, 413563], [89, 413663], [96, 414083], [108, 414843], [111, 415063], [116, 415283]]}, {"verse": 46, "start": 416476, "end": 420737, "text": "Entonces entraron en disputa, cuál de ellos sería el mayor.", "words": [[0, 416476], [9, 417206], [18, 418146], [21, 418286], [30, 419006], [35, 419206], [38, 419446], [44, 419626], [50, 420026], [53, 420206]]}, {"verse": 47, "start": 421187, "end": 427742, "text": "Pero Jesús, viendo los pensamientos del corazón de ellos, tomó un niño, y le puso junto a sí,", "words": [[0, 421187], [5, 421310], [12, 422250], [19, 422570], [23, 422810], [36, 423530], [40, 423730], [48, 424150], [51, 424410], [58, 425110], [63, 425390], [66, 425570], [72, 425930], [74, 426410], [77, 426550], [82, 426890], [88, 427188], [90, 427487]]}, {"verse": 48, "start": 428192, "end": 443585, "text": "Y les dice: Cualquiera que reciba este niño en mi nombre, a mí recibe; y cualquiera que me reciba a mí, recibe al que me envió; porque el que es más pequeño entre todos vosotros, este es el más grande.", "words": [[0, 428192], [2, 428457], [6, 428755], [12, 429302], [23, 429706], [27, 429846], [34, 430466], [39, 430526], [44, 430906], [47, 431106], [50, 431206], [58, 431566], [60, 432046], [63, 432186], [71, 433194], [73, 433414], [84, 433874], [88, 434034], [91, 434134], [98, 434654], [100, 434754], [104, 435154], [111, 435934], [114, 436454], [118, 436614], [121, 436794], [128, 437712], [135, 437956], [138, 438236], [142, 438396], [145, 438536], [149, 438756], [157, 439296], [163, 439616], [169, 439976], [179, 440876], [184, 441296], [187, 441496], [190, 441656], [194, 441816]]}, {"verse": 49, "start": 444035, "end": 452694, "text": "Entonces respondiendo Juan, dijo: Maestro, hemos visto a uno que echaba fuera demonios en tu nombre; y se lo prohibimos, porque no sigue con nosotros.", "words": [[0, 444035], [9, 444035], [22, 444697], [28, 445377], [34, 446193], [43, 446636], [49, 446816], [55, 447196], [57, 447356], [61, 447496], [65, 447716], [72, 448036], [78, 448256], [87, 448876], [90, 449036], [93, 449156], [101, 450008], [103, 450110], [106, 450210], [109, 450330], [121, 451010], [128, 451370], [131, 451530], [137, 451770], [141, 452030]]}, {"verse": 50, "start": 453044, "end": 460194, "text": "Jesús le dijo: No se lo prohibáis; porque el que no es contra nosotros, por nosotros es.", "words": [[0, 453044], [6, 453333], [9, 453673], [15, 454461], [18, 454588], [21, 454748], [24, 454908], [35, 456104], [42, 456368], [45, 456708], [49, 456868], [52, 457128], [55, 457368], [62, 457708], [72, 458768], [76, 459068], [85, 459568]]}, {"verse": 51, "start": 460644, "end": 469192, "text": "Y aconteció que, como se cumplió el tiempo en que había de ser recibido arriba, él afirmó su rostro para ir a Jerusalén.", "words": [[0, 460644], [2, 460770], [12, 461390], [17, 461590], [22, 461850], [25, 462050], [33, 462670], [36, 462790], [43, 463290], [46, 463590], [50, 463690], [56, 463950], [59, 464110], [63, 464290], [72, 464890], [80, 465910], [83, 466170], [90, 466990], [93, 467150], [100, 467730], [105, 467930], [108, 468190], [110, 468250]]}, {"verse": 52, "start": 469642, "end": 478469, "text": "Y envió mensajeros delante de sí, los cuales fueron y entraron en una ciudad de los samaritanos, para preparar su llegada.", "words": [[0, 469642], [2, 469808], [8, 470168], [19, 470828], [27, 471268], [30, 471428], [34, 472328], [38, 472448], [45, 472708], [52, 473108], [54, 473628], [63, 474248], [66, 474388], [70, 474568], [77, 474968], [80, 475228], [84, 475348], [97, 476368], [102, 476808], [111, 477608], [114, 477768]]}, {"verse": 53, "start": 478919, "end": 483421, "text": "Pero no le recibieron, porque tenía intención de ir a Jerusalén.", "words": [[0, 478919], [5, 479064], [8, 479284], [11, 479444], [23, 480244], [30, 480824], [36, 481184], [46, 482124], [49, 482324], [52, 482484], [54, 482564]]}, {"verse": 54, "start": 483871, "end": 494340, "text": "Y viendo esto sus discípulos Jacobo y Juan, dijeron: Señor, ¿quieres que mandemos que descienda fuego del cielo, y los consuma, como hizo Elías?", "words": [[0, 483871], [2, 483996], [9, 484286], [14, 484576], [18, 484916], [29, 485756], [36, 486516], [38, 486636], [44, 487576], [53, 488578], [60, 489592], [69, 489892], [73, 490012], [82, 490512], [86, 490672], [96, 491192], [102, 491492], [106, 491772], [113, 492192], [115, 492432], [119, 492572], [128, 493172], [133, 493392], [138, 493652]]}, {"verse": 55, "start": 494690, "end": 500961, "text": "Entonces volviéndose él, los reprendió, diciendo: Vosotros no sabéis de qué espíritu sois;", "words": [[0, 494690], [9, 495653], [21, 496453], [25, 496906], [29, 497360], [40, 497813], [50, 498828], [59, 499432], [62, 499972], [69, 500452], [72, 500632], [76, 500742], [85, 500852]]}, {"verse": 56, "start": 501411, "end": 510712, "text": "Porque el Hijo del hombre no ha venido para perder las almas de los hombres, sino para salvarlas. Y se fueron a otra aldea.", "words": [[0, 502635], [7, 502975], [10, 503295], [15, 503575], [19, 503715], [26, 504075], [29, 504255], [32, 504375], [39, 504735], [44, 504955], [51, 505295], [55, 505575], [61, 505955], [64, 506075], [68, 506215], [77, 506575], [82, 507075], [87, 507335], [98, 508634], [100, 508776], [103, 508876], [110, 509176], [112, 509556], [117, 509836]]}, {"verse": 57, "start": 511162, "end": 517458, "text": "Y aconteció que yendo ellos, uno le dijo en el camino: Señor, te seguiré adondequiera que vayas.", "words": [[0, 511162], [2, 511284], [12, 511904], [16, 512104], [22, 512484], [29, 513304], [33, 513504], [36, 513684], [41, 513964], [44, 514144], [47, 514244], [55, 515134], [62, 515455], [65, 515655], [73, 516205], [86, 516755], [90, 516895]]}, {"verse": 58, "start": 517808, "end": 526489, "text": "Y le dijo Jesús: Las zorras tienen cuevas, y las aves de los cielos nidos; pero el Hijo del hombre no tiene donde recline la cabeza.", "words": [[0, 517808], [2, 517954], [5, 518034], [10, 518314], [17, 519332], [21, 519631], [28, 519962], [35, 520182], [43, 520742], [45, 520881], [49, 521022], [54, 521322], [57, 521422], [61, 521542], [68, 522062], [75, 522965], [80, 523245], [83, 523445], [88, 523705], [92, 523885], [99, 524205], [102, 524445], [108, 524785], [114, 525245], [122, 525705], [125, 525885]]}, {"verse": 59, "start": 526939, "end": 532921, "text": "Y dijo a otro: Sígueme. Y él dijo: Señor, déjame que primero vaya y entierre a mi padre.", "words": [[0, 526939], [2, 527057], [7, 527297], [9, 527437], [15, 528097], [24, 529063], [26, 529204], [29, 529344], [35, 530085], [42, 530339], [49, 530859], [53, 531019], [61, 531319], [66, 531679], [68, 531859], [77, 532279], [79, 532359], [82, 532439]]}, {"verse": 60, "start": 533271, "end": 542084, "text": "Y Jesús le dijo: Deja los muertos que entierren a sus muertos; y tú, ve, y anuncia el reino de Dios.", "words": [[0, 533271], [2, 533394], [8, 533734], [11, 534234], [17, 535096], [22, 535562], [26, 535642], [34, 536182], [38, 536482], [48, 537302], [50, 537442], [54, 537582], [63, 538739], [65, 538886], [69, 539446], [73, 539746], [75, 540206], [83, 540826], [86, 541026], [92, 541406], [95, 541566]]}, {"verse": 61, "start": 542534, "end": 550161, "text": "Entonces también dijo otro: Te seguiré, Señor; pero déjame que me despida primero de los que están en mi casa.", "words": [[0, 542534], [9, 543098], [17, 543518], [22, 543858], [28, 544604], [31, 544698], [40, 545118], [47, 545904], [52, 546041], [59, 546461], [63, 546601], [66, 546701], [74, 547161], [82, 547461], [85, 547721], [89, 547841], [93, 547961], [99, 548181], [102, 548321], [105, 548441]]}, {"verse": 62, "start": 550511, "end": 558505, "text": "Y Jesús le dijo: Ninguno que poniendo su mano al arado mira atrás, es apto para el reino de Dios.", "words": [[0, 550511], [2, 550634], [8, 550974], [11, 551474], [17, 552336], [25, 553050], [29, 553229], [38, 553749], [41, 553950], [46, 554249], [49, 554469], [55, 554829], [60, 555109], [67, 556190], [70, 556450], [75, 557030], [80, 557170], [83, 557349], [89, 557749], [92, 557910]]}]}