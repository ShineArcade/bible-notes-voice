{"book": "LUK", "chapter": 2, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 342340, "verses": [{"verse": 1, "start": 300, "end": 7379, "text": "And it came to pass in those days, that there went out a decree from Cæsar Augustus, that all the world should be enrolled.", "words": [[0, 300], [4, 431], [7, 531], [12, 731], [15, 891], [20, 1231], [23, 1571], [29, 1791], [35, 2151], [40, 2471], [46, 2631], [51, 2831], [55, 3071], [57, 3191], [64, 3571], [69, 3921], [75, 4271], [85, 5091], [90, 5531], [94, 5791], [98, 5951], [104, 6251], [111, 6511], [114, 6691]]}, {"verse": 2, "start": 7729, "end": 11887, "text": "( And this enrollment was first made when Cyrenius was governor of Syria.)", "words": [[0, 7729], [2, 7729], [6, 7883], [11, 8083], [22, 8503], [26, 8823], [32, 9103], [37, 9483], [42, 9973], [51, 10463], [55, 10703], [64, 11023], [67, 11283]]}, {"verse": 3, "start": 12237, "end": 15362, "text": "And all went to be enrolled, every one into his own city.", "words": [[0, 12237], [4, 12360], [8, 12640], [13, 12860], [16, 13040], [19, 13180], [29, 13487], [35, 13793], [39, 14100], [44, 14460], [48, 14660], [52, 14820]]}, {"verse": 4, "start": 15712, "end": 27203, "text": "And Joseph also went up from Galilee, out of the city of Nazareth, into Judæa, to the city of David, which is called Bethlehem; (because he was of the house and lineage of David:)", "words": [[0, 15712], [4, 15854], [11, 16174], [16, 16594], [21, 16854], [24, 17014], [29, 17234], [38, 17814], [42, 18154], [45, 18274], [49, 18414], [54, 18654], [57, 18854], [67, 19454], [72, 20074], [79, 20694], [82, 20934], [86, 21094], [91, 21294], [94, 21494], [101, 22254], [107, 22434], [110, 22574], [117, 22814], [128, 23782], [137, 24030], [140, 24250], [144, 24430], [147, 24570], [151, 24710], [157, 24990], [161, 25190], [169, 25550], [172, 25770]]}, {"verse": 5, "start": 27553, "end": 31787, "text": "To be enrolled with Mary his espoused wife, being great with child.", "words": [[0, 27553], [3, 27653], [6, 27793], [15, 28133], [20, 28453], [25, 28913], [29, 29013], [38, 29573], [44, 30333], [50, 30593], [56, 30893], [61, 31093]]}, {"verse": 6, "start": 32137, "end": 37506, "text": "And so it was, that, while they were there, the days were accomplished that she should be delivered.", "words": [[0, 32137], [4, 32265], [7, 32485], [10, 32605], [15, 32905], [21, 33525], [27, 33765], [32, 33965], [37, 34125], [44, 34805], [48, 34905], [53, 35165], [58, 35405], [71, 35885], [76, 36325], [80, 36545], [87, 36785], [90, 36925]]}, {"verse": 7, "start": 37856, "end": 46448, "text": "And she brought forth her firstborn son, and wrapped him in swaddling clothes, and laid him in a manger; because there was no room for them in the inn.", "words": [[0, 37856], [4, 37983], [8, 38123], [16, 38403], [22, 38743], [26, 38963], [36, 39563], [41, 40403], [45, 40643], [53, 40923], [57, 41163], [60, 41303], [70, 41823], [79, 42763], [83, 42843], [88, 43063], [92, 43283], [95, 43423], [97, 43503], [105, 44330], [113, 44514], [119, 44694], [123, 44854], [126, 45034], [131, 45314], [135, 45494], [140, 45694], [143, 45894], [147, 46034]]}, {"verse": 8, "start": 46798, "end": 52299, "text": "And there were in the same country shepherds abiding in the field, keeping watch over their flock by night.", "words": [[0, 46798], [4, 46918], [10, 47068], [15, 47208], [18, 47348], [22, 47448], [27, 47708], [35, 48268], [45, 48728], [53, 49108], [56, 49288], [60, 49388], [67, 50148], [75, 50408], [81, 50828], [86, 51108], [92, 51308], [98, 51548], [101, 51848]]}, {"verse": 9, "start": 52649, "end": 60882, "text": "And, lo, the angel of the Lord came upon them, and the glory of the Lord shone round about them: and they were greatly afraid.", "words": [[0, 52649], [5, 52798], [9, 53498], [13, 53718], [19, 54138], [22, 54318], [26, 54478], [31, 54758], [36, 55058], [41, 55378], [47, 56018], [51, 56258], [55, 56398], [61, 56778], [64, 57058], [68, 57238], [73, 57498], [79, 57978], [85, 58258], [91, 58598], [97, 59305], [101, 59430], [106, 59570], [111, 59710], [119, 60070]]}, {"verse": 10, "start": 61232, "end": 68173, "text": "And the angel said to them, Fear not: for, behold, I bring you good tidings of great joy, which shall be to all people.", "words": [[0, 61232], [4, 61393], [8, 61513], [14, 61853], [19, 62113], [22, 62293], [28, 62950], [33, 63102], [38, 63797], [43, 63926], [51, 64666], [53, 64766], [59, 64986], [63, 65146], [68, 65426], [76, 65866], [79, 66006], [85, 66286], [90, 66866], [96, 67006], [102, 67266], [105, 67426], [108, 67606], [112, 67766]]}, {"verse": 11, "start": 68523, "end": 73235, "text": "For to you is born this day in the city of David a Saviour, which is Christ the Lord.", "words": [[0, 68523], [4, 68649], [7, 68829], [11, 69029], [14, 69189], [19, 69489], [24, 69789], [28, 70089], [31, 70269], [35, 70369], [40, 70589], [43, 70729], [49, 70949], [51, 71199], [60, 71449], [66, 72049], [69, 72249], [76, 72569], [80, 72889]]}, {"verse": 12, "start": 73585, "end": 78886, "text": "And this shall be a sign to you; You shall find the babe wrapped in swaddling clothes, lying in a manger.", "words": [[0, 73585], [4, 73706], [9, 73866], [15, 74106], [18, 74266], [20, 74426], [25, 74586], [28, 74786], [33, 75236], [37, 75334], [43, 75494], [48, 75794], [52, 75974], [57, 76214], [65, 76574], [68, 76774], [78, 77254], [87, 77574], [93, 78154], [96, 78334], [98, 78414]]}, {"verse": 13, "start": 79166, "end": 84990, "text": "And suddenly there was with the angel a multitude of the heavenly host praising God, and saying,", "words": [[0, 79166], [4, 79322], [13, 79974], [19, 80147], [23, 80387], [28, 80627], [32, 80807], [38, 81227], [40, 81447], [50, 81887], [53, 82207], [57, 82347], [66, 82667], [71, 83067], [80, 83627], [85, 84067], [89, 84367]]}, {"verse": 14, "start": 85190, "end": 89416, "text": "Glory to God in the highest, and on earth peace, good will toward men.", "words": [[0, 85190], [6, 85424], [9, 85684], [13, 85964], [16, 86184], [20, 86304], [29, 87084], [33, 87144], [36, 87264], [42, 87464], [49, 87844], [54, 88224], [59, 88604], [66, 88904]]}, {"verse": 15, "start": 89696, "end": 102608, "text": "And it came to pass, as the angels were gone away from them into heaven, the shepherds said one to another, Let us now go even to Bethlehem, and see this thing which is come to pass, which the Lord has made known to us.", "words": [[0, 89696], [4, 89847], [7, 89967], [12, 90147], [15, 90327], [21, 91267], [24, 91447], [28, 91607], [35, 91947], [40, 92167], [45, 92387], [50, 92687], [55, 92887], [60, 93107], [65, 93347], [73, 94147], [77, 94227], [87, 94707], [92, 94907], [96, 95147], [99, 95367], [108, 96135], [112, 96306], [115, 96466], [119, 96706], [122, 96946], [127, 97326], [130, 97506], [141, 98146], [145, 98526], [149, 98826], [154, 99066], [160, 99306], [166, 99476], [169, 99646], [174, 99846], [177, 100006], [183, 100346], [189, 100886], [193, 101106], [198, 101346], [202, 101606], [207, 101826], [213, 102086], [216, 102306]]}, {"verse": 16, "start": 102888, "end": 108484, "text": "And they came with haste, and found Mary, and Joseph, and the babe lying in a manger.", "words": [[0, 102888], [4, 103020], [9, 103120], [14, 103360], [19, 103600], [26, 104280], [30, 104440], [36, 104720], [42, 105080], [46, 105600], [54, 106020], [58, 106700], [62, 106840], [67, 107140], [73, 107560], [76, 107780], [78, 107880]]}, {"verse": 17, "start": 108834, "end": 114941, "text": "And when they had seen it, they made known abroad the saying which was told them concerning this child.", "words": [[0, 108834], [4, 108978], [9, 109098], [14, 109278], [18, 109418], [23, 109718], [27, 110198], [32, 110398], [37, 110698], [43, 110998], [50, 111578], [54, 112098], [61, 112458], [67, 112738], [71, 112918], [76, 113238], [81, 113498], [92, 113958], [97, 114278]]}, {"verse": 18, "start": 115291, "end": 120074, "text": "And all they that heard it wondered at those things which were told them by the shepherds.", "words": [[0, 115291], [4, 115416], [8, 115716], [13, 116016], [18, 116376], [24, 116676], [27, 116836], [36, 117196], [39, 117456], [45, 117676], [52, 118076], [58, 118336], [63, 118516], [68, 118796], [73, 119036], [76, 119236], [80, 119376]]}, {"verse": 19, "start": 120424, "end": 123846, "text": "But Mary kept all these things, and pondered them in her heart.", "words": [[0, 120424], [4, 120551], [9, 120811], [14, 121111], [18, 121391], [24, 121591], [32, 121991], [36, 122451], [45, 122931], [50, 123111], [53, 123271], [57, 123411]]}, {"verse": 20, "start": 124196, "end": 130859, "text": "And the shepherds returned, glorifying and praising God for all the things that they had heard and seen, as it was told to them.", "words": [[0, 124196], [4, 124349], [8, 124449], [18, 124889], [28, 125789], [39, 126529], [43, 126729], [52, 127129], [56, 127489], [60, 127769], [64, 128009], [68, 128169], [75, 128449], [80, 128649], [85, 128789], [89, 128929], [95, 129169], [99, 129329], [105, 129649], [108, 129889], [111, 130009], [115, 130129], [120, 130349], [123, 130549]]}, {"verse": 21, "start": 131209, "end": 140394, "text": "And when eight days were accomplished for the circumcising of the child, his name was called JESUS, which was so named of the angel before he was conceived in the womb.", "words": [[0, 131209], [4, 131340], [9, 131460], [15, 131700], [20, 131960], [25, 132220], [38, 132660], [42, 132940], [46, 133080], [59, 133800], [62, 134000], [66, 134100], [73, 135000], [77, 135140], [82, 135400], [86, 135580], [93, 135880], [100, 136878], [106, 136982], [110, 137162], [113, 137382], [119, 137682], [122, 137902], [126, 138022], [132, 138402], [139, 138742], [142, 139002], [146, 139142], [156, 139582], [159, 139822], [163, 139922]]}, {"verse": 22, "start": 140744, "end": 148638, "text": "And when the days of her purification according to the law of Moses were accomplished, they brought him to Jerusalem, to present him to the Lord;", "words": [[0, 140744], [4, 140871], [9, 141031], [13, 141191], [18, 141511], [21, 141651], [25, 141791], [38, 142611], [48, 142931], [51, 143251], [55, 143371], [59, 143611], [62, 143751], [68, 144091], [73, 144411], [87, 145571], [92, 145671], [100, 145951], [104, 146191], [107, 146371], [118, 146951], [121, 147186], [129, 147566], [133, 147826], [136, 148006], [140, 148146]]}, {"verse": 23, "start": 148988, "end": 155126, "text": "(As it is written in the law of the Lord, Every male that opens the womb shall be called holy to the Lord;)", "words": [[0, 148988], [4, 149216], [7, 149356], [10, 149516], [18, 149816], [21, 150036], [25, 150176], [29, 150416], [32, 150556], [36, 150696], [42, 151636], [48, 151876], [53, 152216], [58, 152416], [64, 152756], [68, 153016], [73, 153296], [79, 153536], [82, 153676], [89, 153896], [94, 154276], [97, 154496], [101, 154636]]}, {"verse": 24, "start": 155476, "end": 162988, "text": "And to offer a sacrifice according to that which is said in the law of the Lord, A pair of turtledoves, or two young pigeons.", "words": [[0, 155476], [4, 155618], [7, 155758], [13, 156058], [15, 156258], [25, 156858], [35, 157378], [38, 157678], [43, 157878], [49, 158138], [52, 158278], [57, 158518], [60, 158678], [64, 158778], [68, 158998], [71, 159118], [75, 159278], [81, 160078], [83, 160218], [88, 160458], [91, 160618], [104, 161478], [107, 161698], [111, 161938], [117, 162218]]}, {"verse": 25, "start": 163338, "end": 173668, "text": "And, behold, there was a man in Jerusalem, whose name was Simeon; and the same man was just and devout, waiting for the consolation of Israel: and the Holy Spirit was upon him.", "words": [[0, 163338], [5, 163466], [13, 163986], [19, 164086], [23, 164266], [25, 164386], [29, 164646], [32, 164806], [43, 165386], [49, 165701], [54, 165981], [58, 166181], [66, 167099], [70, 167237], [74, 167337], [79, 167577], [83, 167877], [87, 168117], [92, 168437], [96, 168677], [104, 169297], [112, 169677], [116, 169937], [120, 170037], [132, 170797], [135, 170937], [143, 171727], [147, 171875], [151, 171975], [156, 172195], [163, 172695], [167, 172895], [172, 173155]]}, {"verse": 26, "start": 174018, "end": 180466, "text": "And it was revealed to him by the Holy Spirit, that he should not see death, before he had seen the Lord’s Christ.", "words": [[0, 174018], [4, 174132], [7, 174212], [11, 174352], [20, 174732], [23, 174992], [27, 175132], [30, 175372], [34, 175512], [39, 175792], [47, 176352], [52, 176792], [55, 176932], [62, 177092], [66, 177332], [70, 177632], [77, 178072], [84, 178672], [87, 178932], [91, 179092], [96, 179352], [100, 179532], [107, 179892]]}, {"verse": 27, "start": 180816, "end": 188323, "text": "And he came by the Spirit into the temple: and when the parents brought in the child Jesus, to do for him after the custom of the law,", "words": [[0, 180816], [4, 180959], [7, 181039], [12, 181239], [15, 181479], [19, 181639], [26, 181999], [31, 182239], [35, 182399], [43, 183173], [47, 183286], [52, 183446], [56, 183586], [64, 183926], [72, 184226], [75, 184506], [79, 184646], [85, 184986], [92, 185486], [95, 186006], [98, 186226], [102, 186426], [106, 186586], [112, 186926], [116, 187086], [123, 187406], [126, 187626], [130, 187726]]}, {"verse": 28, "start": 188673, "end": 192109, "text": "Then took he him up in his arms, and blessed God, and said,", "words": [[0, 188673], [5, 188856], [10, 189116], [13, 189316], [17, 189556], [20, 189696], [23, 189836], [27, 189996], [33, 190396], [37, 190596], [45, 190896], [50, 191356], [54, 191636]]}, {"verse": 29, "start": 192309, "end": 195999, "text": "Lord, now do you let your servant depart in peace, according to your word:", "words": [[0, 192309], [6, 192729], [10, 192829], [13, 193049], [17, 193189], [21, 193389], [26, 193529], [34, 193869], [41, 194269], [44, 194509], [51, 194809], [61, 195189], [64, 195469], [69, 195629]]}, {"verse": 30, "start": 196349, "end": 198476, "text": "For my eyes have seen your salvation,", "words": [[0, 196349], [4, 196432], [7, 196592], [12, 196952], [17, 197172], [22, 197452], [27, 197632]]}, {"verse": 31, "start": 198826, "end": 201520, "text": "Which you have prepared before the face of all people;", "words": [[0, 198826], [6, 198988], [10, 199168], [15, 199308], [24, 199708], [31, 200008], [35, 200228], [40, 200488], [43, 200708], [47, 200948]]}, {"verse": 32, "start": 201870, "end": 205729, "text": "A light to lighten the Gentiles, and the glory of your people Israel.", "words": [[0, 201870], [2, 202008], [8, 202188], [11, 202368], [19, 202768], [23, 202868], [33, 203548], [37, 203928], [41, 204048], [47, 204368], [50, 204588], [55, 204728], [62, 205048]]}, {"verse": 33, "start": 206009, "end": 209809, "text": "And Joseph and his mother marvelled at those things which were spoken of him.", "words": [[0, 206009], [4, 206142], [11, 206482], [15, 206702], [19, 206822], [26, 207312], [36, 207802], [39, 207842], [45, 208022], [52, 208322], [58, 208562], [63, 208742], [70, 209122], [73, 209382]]}, {"verse": 34, "start": 210159, "end": 219775, "text": "And Simeon blessed them, and said to Mary his mother, Behold, this child is set for the fall and rising again of many in Israel; and for a sign which shall be spoken against;", "words": [[0, 210159], [4, 210302], [11, 210882], [19, 211142], [25, 211522], [29, 212042], [34, 212242], [37, 212482], [42, 212722], [46, 212982], [54, 213763], [62, 214181], [67, 214281], [73, 214581], [76, 214741], [80, 214921], [84, 215081], [88, 215221], [93, 215501], [97, 215681], [104, 216041], [110, 216361], [113, 216541], [118, 216841], [121, 216981], [129, 217668], [133, 217793], [137, 217973], [139, 218113], [144, 218353], [150, 218553], [156, 218713], [159, 218833], [166, 219173]]}, {"verse": 35, "start": 220125, "end": 225309, "text": "(Yes, a sword shall pierce through your own soul also,) that the thoughts of many hearts may be revealed.", "words": [[0, 220125], [6, 220526], [8, 220546], [14, 220846], [20, 221086], [27, 221566], [35, 221706], [40, 221886], [44, 222126], [49, 222446], [56, 223166], [61, 223406], [65, 223546], [74, 223786], [77, 223946], [82, 224126], [89, 224426], [93, 224646], [96, 224766]]}, {"verse": 36, "start": 225589, "end": 235946, "text": "And there was one Anna, a prophetess, the daughter of Phanuel, of the tribe of Aser: she was of a great age, and had lived with a husband seven years from her virginity;", "words": [[0, 225589], [4, 225731], [10, 225851], [14, 226031], [18, 226331], [24, 227131], [26, 227211], [38, 228211], [42, 228351], [51, 228611], [54, 229221], [63, 229831], [66, 229891], [70, 230031], [76, 230351], [79, 230788], [85, 231387], [89, 231528], [93, 231688], [96, 231828], [98, 231908], [104, 232128], [109, 232588], [113, 232968], [117, 233108], [123, 233348], [128, 233548], [130, 233648], [138, 233908], [144, 234428], [150, 234788], [155, 235068], [159, 235248]]}, {"verse": 37, "start": 236296, "end": 244274, "text": "And she was a widow of about eighty-four years, which departed not from the temple, but served God with fastings and prayers night and day.", "words": [[0, 236296], [4, 236395], [8, 236555], [12, 236735], [14, 236855], [20, 237035], [23, 237335], [29, 237735], [41, 238135], [48, 239155], [54, 239355], [63, 239815], [67, 240115], [72, 240375], [76, 240515], [84, 240815], [88, 241055], [95, 241455], [99, 241775], [104, 242055], [113, 242635], [117, 242835], [125, 243195], [131, 243615], [135, 243815]]}, {"verse": 38, "start": 244624, "end": 252128, "text": "And she coming in that instant gave thanks likewise to the Lord, and spoke of him to all them that looked for redemption in Jerusalem.", "words": [[0, 244624], [4, 244738], [8, 244878], [15, 245178], [18, 245418], [23, 245618], [31, 245978], [36, 246278], [43, 246678], [52, 247138], [55, 247458], [59, 247598], [65, 247878], [69, 248153], [75, 248493], [78, 248713], [82, 248853], [85, 249073], [89, 249453], [94, 249733], [99, 250053], [106, 250233], [110, 250513], [121, 250993], [124, 251293]]}, {"verse": 39, "start": 252478, "end": 259511, "text": "And when they had performed all things according to the law of the Lord, they returned into Galilee, to their own city Nazareth.", "words": [[0, 252478], [4, 252613], [9, 252753], [14, 252933], [18, 253053], [28, 253433], [32, 253773], [39, 254093], [49, 254433], [52, 254713], [56, 254853], [60, 255073], [63, 255193], [67, 255333], [73, 256153], [78, 256253], [87, 256633], [92, 256873], [101, 257473], [104, 257913], [110, 258113], [114, 258353], [119, 258653]]}, {"verse": 40, "start": 259861, "end": 266445, "text": "And the child grew, and grew strong in spirit, filled with wisdom: and the grace of God was upon him.", "words": [[0, 259861], [4, 260001], [8, 260081], [14, 260381], [20, 260781], [24, 261341], [29, 261581], [36, 262001], [39, 262261], [47, 263081], [54, 263361], [59, 263621], [67, 264456], [71, 264581], [75, 264701], [81, 264941], [84, 265141], [88, 265481], [92, 265741], [97, 266041]]}, {"verse": 41, "start": 266795, "end": 270995, "text": "Now his parents went to Jerusalem every year at the feast of the passover.", "words": [[0, 266795], [4, 267062], [8, 267302], [16, 267682], [21, 267922], [24, 268102], [34, 268622], [40, 269002], [45, 269362], [48, 269622], [52, 269762], [58, 270082], [61, 270182], [65, 270262]]}, {"verse": 42, "start": 271345, "end": 276228, "text": "And when he was twelve years old, they went up to Jerusalem after the custom of the feast.", "words": [[0, 271345], [4, 271469], [9, 271609], [12, 271749], [16, 271989], [23, 272229], [29, 272469], [34, 273269], [39, 273469], [44, 273669], [47, 273789], [50, 273929], [60, 274469], [66, 274889], [70, 275069], [77, 275429], [80, 275629], [84, 275709]]}, {"verse": 43, "start": 276578, "end": 284545, "text": "And when they had fulfilled the days, as they returned, the child Jesus stayed behind in Jerusalem; and Joseph and his mother knew not of it.", "words": [[0, 276578], [4, 276698], [9, 276858], [14, 277038], [18, 277158], [28, 277458], [32, 277738], [38, 278078], [41, 278458], [46, 278618], [56, 279578], [60, 279678], [66, 279998], [72, 280338], [79, 280798], [86, 281218], [89, 281418], [100, 282384], [104, 282510], [111, 282810], [115, 283090], [119, 283230], [126, 283510], [131, 283790], [135, 284030], [138, 284230]]}, {"verse": 44, "start": 284895, "end": 291522, "text": "But they, supposing him to have been in the company, went a day’s journey; and they sought him among their kinsfolk and acquaintance.", "words": [[0, 284895], [4, 285019], [10, 285139], [20, 285739], [24, 285939], [27, 286099], [32, 286219], [37, 286399], [40, 286499], [44, 286599], [53, 286903], [58, 287207], [60, 287510], [66, 287814], [75, 288586], [79, 288730], [84, 288850], [91, 289130], [95, 289350], [101, 289590], [107, 289850], [116, 290430], [120, 290710]]}, {"verse": 45, "start": 291872, "end": 296340, "text": "And when they found him not, they turned back again to Jerusalem, seeking him.", "words": [[0, 291872], [4, 292007], [9, 292147], [14, 292327], [20, 292607], [24, 292747], [29, 293527], [34, 293647], [41, 293947], [46, 294207], [52, 294567], [55, 294727], [66, 295627], [74, 295867]]}, {"verse": 46, "start": 296690, "end": 305253, "text": "And it came to pass, that after three days they found him in the temple, sitting in the midst of the doctors, both hearing them, and asking them questions.", "words": [[0, 296690], [4, 296867], [7, 296987], [12, 297187], [15, 297367], [21, 297707], [26, 298002], [32, 298322], [38, 298622], [43, 299102], [48, 299282], [54, 299582], [58, 299762], [61, 299882], [65, 299982], [73, 300722], [81, 301002], [84, 301202], [88, 301302], [94, 301522], [97, 301722], [101, 301842], [110, 302372], [115, 302902], [123, 303222], [129, 303522], [133, 303882], [140, 304222], [145, 304442]]}, {"verse": 47, "start": 305603, "end": 309626, "text": "And all that heard him were astonished at his understanding and answers.", "words": [[0, 305603], [4, 305726], [8, 305986], [13, 306206], [19, 306446], [23, 306666], [28, 306906], [39, 307626], [42, 307786], [46, 307926], [60, 308606], [64, 308906]]}, {"verse": 48, "start": 309976, "end": 319898, "text": "And when they saw him, they were amazed: and his mother said to him, Son, why have you thus dealt with us? behold, your father and I have sought you sorrowing.", "words": [[0, 309976], [4, 310102], [9, 310282], [14, 310502], [18, 310782], [23, 311322], [28, 311462], [33, 311642], [41, 312663], [45, 312791], [49, 312931], [56, 313191], [61, 313511], [64, 313751], [69, 314381], [74, 315107], [78, 315267], [83, 315467], [87, 315607], [92, 315847], [98, 316087], [103, 316327], [107, 316981], [115, 317248], [120, 317388], [127, 318068], [131, 318148], [133, 318368], [138, 318508], [145, 318728], [149, 318868]]}, {"verse": 49, "start": 320178, "end": 326006, "text": "And he said to them, How is it that you sought me? Did you not know that I must be about my Father’s business?", "words": [[0, 320178], [4, 320309], [7, 320429], [12, 320669], [15, 320869], [21, 321414], [25, 321630], [28, 321890], [31, 322010], [36, 322150], [40, 322290], [47, 322530], [51, 323100], [55, 323184], [59, 323344], [63, 323524], [68, 323784], [73, 323984], [75, 324104], [80, 324284], [83, 324504], [89, 324724], [92, 324924], [101, 325364]]}, {"verse": 50, "start": 326286, "end": 329091, "text": "And they understood not the saying which he spoke to them.", "words": [[0, 326286], [4, 326440], [9, 326580], [20, 327040], [24, 327360], [28, 327580], [35, 327860], [41, 328120], [44, 328260], [50, 328540], [53, 328760]]}, {"verse": 51, "start": 329441, "end": 336421, "text": "And he went down with them, and came to Nazareth, and was subject to them: but his mother kept all these sayings in her heart.", "words": [[0, 329441], [4, 329570], [7, 329650], [12, 329830], [17, 330150], [22, 330410], [28, 330590], [32, 331090], [37, 331310], [40, 331490], [50, 331990], [54, 332170], [58, 332310], [66, 332670], [69, 332950], [75, 333529], [79, 333657], [83, 333817], [90, 334137], [95, 334477], [99, 334857], [105, 335077], [113, 335677], [116, 335837], [120, 335977]]}, {"verse": 52, "start": 336771, "end": 341940, "text": "And Jesus increased in wisdom and stature, and in favour with God and man.", "words": [[0, 336771], [4, 336914], [10, 337314], [20, 337994], [23, 338354], [30, 338754], [34, 338994], [43, 339594], [47, 340054], [50, 340294], [57, 340534], [62, 340894], [66, 341194], [70, 341434]]}]}