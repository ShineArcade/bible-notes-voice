{"book": "PSA", "chapter": 106, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 293083, "verses": [{"verse": 1, "start": 300, "end": 6870, "text": "Aleluya. Alabad a Jehová, porque es bueno; porque para siempre es su misericordia.", "words": [[0, 770], [9, 1434], [16, 1434], [18, 2086], [26, 2506], [33, 2766], [36, 2966], [43, 3838], [50, 4045], [55, 4305], [63, 4705], [66, 4905], [69, 5105]]}, {"verse": 2, "start": 7220, "end": 12147, "text": "¿Quién expresará las valentías de Jehová? ¿ quién contará sus alabanzas?", "words": [[0, 7390], [7, 7584], [17, 7777], [21, 8157], [31, 9037], [34, 9277], [42, 10192], [44, 10192], [50, 10476], [58, 10936], [62, 11116]]}, {"verse": 3, "start": 12497, "end": 17393, "text": "Dichosos los que guardan juicio, los que hacen justicia en todo tiempo.", "words": [[0, 12497], [9, 13184], [13, 13424], [17, 13624], [25, 14044], [33, 15064], [37, 15344], [41, 15504], [47, 15804], [56, 16404], [59, 16564], [64, 16724]]}, {"verse": 4, "start": 17743, "end": 24673, "text": "Acuérdate de mí, oh Jehová, según tu benevolencia para con tu pueblo: visítame con tu salvación;", "words": [[0, 17743], [10, 18443], [13, 18743], [17, 19056], [20, 19370], [28, 19683], [34, 19983], [37, 20343], [50, 21223], [55, 21443], [59, 21703], [62, 21883], [70, 22742], [79, 23391], [83, 23651], [86, 23811]]}, {"verse": 5, "start": 25023, "end": 33041, "text": "Para que yo vea el bien de tus escogidos, para que me goce en la alegría de tu nación, y me gloríe con tu heredad.", "words": [[0, 25023], [5, 25148], [9, 25288], [12, 25468], [16, 25828], [19, 26048], [24, 26328], [27, 26568], [31, 26748], [42, 27808], [47, 28268], [51, 28428], [54, 28568], [59, 28988], [62, 29208], [65, 29368], [73, 29948], [76, 30108], [79, 30268], [87, 30888], [89, 31308], [92, 31448], [99, 31988], [103, 32208], [106, 32428]]}, {"verse": 6, "start": 33391, "end": 38678, "text": "Pecamos con nuestros padres, hicimos iniquidad, hicimos impiedad.", "words": [[0, 33617], [8, 33877], [12, 34197], [21, 34477], [29, 35497], [37, 36337], [48, 37177], [56, 37677]]}, {"verse": 7, "start": 39028, "end": 49477, "text": "Nuestros padres en Egipto no entendieron tus maravillas; no se acordaron de la muchedumbre de tus misericordias; sino que se rebelaron junto al mar, en el Mar Rojo.", "words": [[0, 39028], [9, 39712], [16, 40052], [19, 40352], [26, 40812], [29, 40972], [41, 41532], [45, 41772], [57, 42888], [60, 43180], [63, 43320], [73, 43900], [76, 44080], [79, 44220], [91, 44880], [94, 45020], [98, 45160], [113, 46503], [118, 46704], [122, 46884], [125, 47274], [135, 47664], [141, 47864], [144, 48084], [149, 48364], [152, 48584], [155, 48704], [159, 48904]]}, {"verse": 8, "start": 49827, "end": 55076, "text": "Pero los salvó por amor de su nombre, para hacer notoria su fortaleza.", "words": [[0, 49827], [5, 49980], [9, 50170], [15, 50830], [19, 51030], [24, 51310], [27, 51490], [30, 51630], [38, 52050], [43, 52650], [49, 53150], [57, 53850], [60, 54070]]}, {"verse": 9, "start": 55426, "end": 62429, "text": "Y reprendió al Mar Rojo, y lo secó; y les hizo ir por el abismo, como por un desierto.", "words": [[0, 55426], [2, 55566], [12, 56346], [15, 56606], [19, 56826], [25, 57726], [27, 57946], [30, 58086], [36, 58820], [38, 59122], [42, 59342], [47, 59722], [50, 60062], [54, 60302], [57, 60462], [65, 60842], [70, 61162], [74, 61462], [77, 61622]]}, {"verse": 10, "start": 62779, "end": 67792, "text": "Y los salvó de mano del enemigo, y los rescató de mano del adversario.", "words": [[0, 62779], [2, 62900], [6, 63040], [12, 63500], [15, 63600], [20, 63820], [24, 64060], [33, 64720], [35, 65340], [39, 65500], [47, 66120], [50, 66260], [55, 66500], [59, 66740]]}, {"verse": 11, "start": 68142, "end": 72970, "text": "Y cubrieron las aguas a sus enemigos: no quedó uno de ellos.", "words": [[0, 68142], [2, 68250], [12, 68930], [16, 69130], [22, 69630], [24, 69730], [28, 69890], [38, 71067], [41, 71367], [47, 71807], [51, 72047], [54, 72287]]}, {"verse": 12, "start": 73320, "end": 77613, "text": "Entonces creyeron a sus palabras, y cantaron su alabanza.", "words": [[0, 73320], [9, 73813], [18, 74593], [20, 74693], [24, 74833], [34, 75393], [36, 75818], [45, 76478], [48, 76718]]}, {"verse": 13, "start": 77963, "end": 83288, "text": "Se apresuraron, se olvidaron de sus obras; no esperaron en su consejo.", "words": [[0, 77963], [3, 78086], [16, 79266], [19, 79346], [29, 79886], [32, 80066], [36, 80226], [43, 81175], [46, 81335], [56, 81975], [59, 82155], [62, 82335]]}, {"verse": 14, "start": 83638, "end": 89071, "text": "Y desearon con ansia en el desierto; y tentaron a Dios en la soledad.", "words": [[0, 83638], [2, 83898], [11, 84558], [15, 84718], [21, 85478], [24, 85598], [27, 85718], [37, 86845], [39, 86971], [48, 87551], [50, 87711], [55, 87931], [58, 88151], [61, 88291]]}, {"verse": 15, "start": 89421, "end": 94364, "text": "Y él les dio lo que pidieron; mas envió flaqueza en sus almas.", "words": [[0, 89421], [2, 89591], [5, 89791], [9, 90111], [13, 90371], [16, 90551], [20, 90691], [30, 91762], [34, 91950], [40, 92600], [49, 93250], [52, 93350], [56, 93530]]}, {"verse": 16, "start": 94714, "end": 100372, "text": "Tomaron después celo contra Moisés en el campamento, y contra Aarón el santo de Jehová.", "words": [[0, 94714], [8, 95038], [16, 95318], [21, 95858], [28, 96138], [35, 96598], [38, 96838], [41, 96958], [53, 97718], [55, 97858], [62, 98444], [68, 99031], [71, 99183], [77, 99663], [80, 99803]]}, {"verse": 17, "start": 100722, "end": 105810, "text": "Se abrió la tierra, y tragó a Datán, y cubrió la compañía de Abiram.", "words": [[0, 100722], [3, 100840], [9, 101100], [12, 101240], [20, 101680], [22, 102025], [28, 102425], [30, 102545], [37, 103105], [39, 103605], [46, 104025], [49, 104185], [58, 105085], [61, 105225]]}, {"verse": 18, "start": 106160, "end": 110687, "text": "Y se encendió el fuego en su junta; la llama quemó los impíos.", "words": [[0, 106160], [2, 106277], [5, 106417], [14, 107017], [17, 107177], [23, 107457], [26, 107677], [29, 107837], [36, 108739], [39, 108921], [45, 109141], [51, 109561], [55, 109721]]}, {"verse": 19, "start": 111037, "end": 116368, "text": "Hicieron becerro en Horeb, y se postraron ante un ídolo fundido.", "words": [[0, 111037], [9, 111492], [17, 112192], [20, 112512], [27, 112832], [29, 113272], [32, 113392], [42, 114252], [47, 114592], [50, 114832], [56, 115412]]}, {"verse": 20, "start": 116718, "end": 120969, "text": "Así trocaron su gloria por la imagen de un buey que come hierba.", "words": [[0, 116718], [4, 116978], [13, 117578], [16, 117858], [23, 118138], [27, 118338], [30, 118518], [37, 118898], [40, 119118], [43, 119238], [48, 119738], [52, 120038], [57, 120298]]}, {"verse": 21, "start": 121319, "end": 126625, "text": "Olvidaron al Dios de su salvación, que había hecho grandezas en Egipto;", "words": [[0, 121319], [10, 122135], [13, 122455], [18, 122655], [21, 122915], [24, 123075], [35, 124255], [39, 124575], [45, 124795], [51, 125115], [61, 125795], [64, 125935]]}, {"verse": 22, "start": 126975, "end": 132141, "text": "Maravillas en la tierra de Cam, cosas formidables sobre el Mar Rojo.", "words": [[0, 126975], [11, 127599], [14, 127839], [17, 127999], [24, 128359], [27, 128559], [32, 129259], [38, 129699], [50, 130599], [56, 130939], [59, 131199], [63, 131439]]}, {"verse": 23, "start": 132491, "end": 142299, "text": "Y trató de destruirlos, a no haberse puesto Moisés su escogido en la brecha delante de él, a fin de apartar su ira, para que no los destruyese.", "words": [[0, 132491], [2, 132654], [8, 133114], [11, 133234], [24, 134674], [26, 134754], [29, 134894], [37, 135294], [44, 135514], [51, 136134], [54, 136434], [63, 137074], [66, 137194], [69, 137314], [76, 137654], [84, 138094], [87, 138494], [91, 138894], [93, 138994], [97, 139154], [100, 139314], [108, 139854], [111, 140074], [116, 140454], [121, 141034], [125, 141174], [128, 141314], [132, 141454]]}, {"verse": 24, "start": 142649, "end": 147238, "text": "Pero aborrecieron la tierra deseable: no creyeron a su palabra;", "words": [[0, 142649], [5, 143173], [18, 143993], [21, 144153], [28, 144433], [38, 145500], [41, 145688], [50, 146368], [52, 146448], [55, 146548]]}, {"verse": 25, "start": 147588, "end": 152352, "text": "Antes murmuraron en sus tiendas, y no oyeron la voz de Jehová.", "words": [[0, 147754], [6, 148697], [17, 149137], [20, 149337], [24, 149497], [33, 150217], [35, 150537], [38, 150777], [45, 151257], [48, 151397], [52, 151597], [55, 151737]]}, {"verse": 26, "start": 152702, "end": 157236, "text": "Por lo que alzó su mano a ellos, para postrarlos en el desierto,", "words": [[0, 152702], [4, 152866], [7, 152966], [11, 153126], [16, 153506], [19, 153626], [24, 153946], [26, 154186], [33, 154486], [38, 155046], [49, 156066], [52, 156286], [55, 156406]]}, {"verse": 27, "start": 157586, "end": 163612, "text": "Y humillar a su pueblo entre las naciones, y esparcirlos por las tierras.", "words": [[0, 157586], [2, 157771], [11, 158171], [13, 158331], [16, 158471], [23, 158951], [29, 159491], [33, 159751], [43, 160491], [45, 161151], [57, 162271], [61, 162511], [65, 162771]]}, {"verse": 28, "start": 163962, "end": 169405, "text": "Se juntaron asimismo a Baal-peor, y comieron los sacrificios de los muertos.", "words": [[0, 163962], [3, 164081], [12, 164381], [21, 164681], [23, 165491], [34, 166301], [36, 166701], [45, 167241], [49, 167481], [61, 168361], [64, 168461], [68, 168601]]}, {"verse": 29, "start": 169755, "end": 174678, "text": "Y enojaron a Dios con sus obras, y se desató la mortandad en ellos.", "words": [[0, 169755], [2, 169880], [11, 170520], [13, 170640], [18, 170820], [22, 171080], [26, 171240], [33, 171640], [35, 172240], [38, 172380], [45, 172980], [48, 173120], [58, 173940], [61, 174080]]}, {"verse": 30, "start": 175028, "end": 179706, "text": "Entonces se levantó Finees, e hizo juicio; y se detuvo la plaga.", "words": [[0, 175028], [9, 175559], [12, 175879], [20, 176379], [28, 176879], [30, 177099], [35, 177319], [43, 178186], [45, 178367], [48, 178487], [55, 178927], [58, 179127]]}, {"verse": 31, "start": 180056, "end": 184701, "text": "Y le fue contado a justicia de generación en generación para siempre.", "words": [[0, 180056], [2, 180178], [5, 180258], [9, 180438], [17, 181058], [19, 181178], [28, 181758], [31, 181898], [42, 182698], [45, 183003], [56, 183683], [61, 183903]]}, {"verse": 32, "start": 185051, "end": 191229, "text": "También le irritaron en las aguas de Meriba: e hizo mal a Moisés por causa de ellos;", "words": [[0, 185051], [8, 185335], [11, 185575], [21, 186655], [24, 186795], [28, 186995], [34, 187435], [37, 187775], [45, 188335], [47, 188463], [52, 188783], [56, 189123], [58, 189343], [65, 189723], [69, 190043], [75, 190363], [78, 190683]]}, {"verse": 33, "start": 191579, "end": 196799, "text": "Porque hicieron se rebelase su espíritu, como lo expresó con sus labios.", "words": [[0, 191579], [7, 191823], [16, 192443], [19, 192933], [28, 193423], [31, 193623], [41, 194483], [46, 194763], [49, 194943], [57, 195643], [61, 195843], [65, 196043]]}, {"verse": 34, "start": 197149, "end": 200243, "text": "No destruyeron los pueblos que Jehová les dijo;", "words": [[0, 197149], [3, 197405], [15, 198365], [19, 198525], [27, 199045], [31, 199165], [38, 199645], [42, 199725]]}, {"verse": 35, "start": 200593, "end": 204864, "text": "Antes se mezclaron con las naciones, y aprendieron sus obras,", "words": [[0, 200593], [6, 200921], [9, 201301], [19, 201841], [23, 201961], [27, 202161], [37, 202741], [39, 203241], [51, 203841], [55, 204081]]}, {"verse": 36, "start": 205214, "end": 209280, "text": "Y sirvieron a sus ídolos; los cuales les fueron por ruina.", "words": [[0, 205214], [2, 205342], [12, 206002], [14, 206142], [18, 206302], [26, 207395], [30, 207502], [37, 207742], [41, 207982], [48, 208282], [52, 208562]]}, {"verse": 37, "start": 209630, "end": 213016, "text": "Y sacrificaron sus hijos y sus hijas a los demonios;", "words": [[0, 209630], [2, 209718], [15, 210478], [19, 210698], [25, 211138], [27, 211418], [31, 211638], [37, 211998], [39, 212118], [43, 212218]]}, {"verse": 38, "start": 213366, "end": 224640, "text": "Y derramaron la sangre inocente, la sangre de sus hijos y de sus hijas, que sacrificaron a los ídolos de Canaán: y la tierra fue contaminada con sangre.", "words": [[0, 213366], [2, 213483], [13, 214103], [16, 214283], [23, 214683], [33, 215878], [36, 215978], [43, 216358], [46, 216558], [50, 216738], [56, 217158], [58, 217538], [61, 217638], [65, 217898], [72, 218758], [76, 218898], [89, 219818], [91, 220198], [95, 220358], [102, 220998], [105, 221158], [113, 222025], [115, 222130], [118, 222250], [125, 222530], [129, 222890], [141, 223670], [145, 223890]]}, {"verse": 39, "start": 224990, "end": 229629, "text": "Se contaminaron así con sus obras, y fornicaron con sus hechos.", "words": [[0, 224990], [3, 225133], [16, 225953], [20, 226173], [24, 226413], [28, 226593], [35, 227053], [37, 227608], [48, 228408], [52, 228628], [56, 228908]]}, {"verse": 40, "start": 229979, "end": 235147, "text": "Se encendió por tanto el furor de Jehová sobre su pueblo, y abominó su heredad:", "words": [[0, 229979], [3, 230122], [12, 230682], [16, 230882], [22, 231222], [25, 231462], [31, 231922], [34, 232122], [41, 232582], [47, 232802], [50, 233022], [58, 233442], [60, 233702], [68, 234362], [71, 234522]]}, {"verse": 41, "start": 235497, "end": 241461, "text": "Y los entregó en poder de las gentes, y se enseñorearon de ellos los que los aborrecían.", "words": [[0, 235497], [2, 235621], [6, 235741], [14, 236321], [17, 236401], [23, 236681], [26, 236851], [30, 237021], [38, 237601], [40, 238141], [43, 238321], [56, 239321], [59, 239581], [65, 239941], [69, 240261], [73, 240421], [77, 240561]]}, {"verse": 42, "start": 241811, "end": 246270, "text": "Y sus enemigos los oprimieron, y fueron quebrantados debajo de su mano.", "words": [[0, 241811], [2, 241912], [6, 242032], [15, 242485], [19, 242939], [31, 243392], [33, 243812], [40, 244052], [53, 245092], [60, 245472], [63, 245632], [66, 245772]]}, {"verse": 43, "start": 246620, "end": 253961, "text": "Muchas veces los libró; mas ellos se rebelaron a su consejo, y fueron humillados por su maldad.", "words": [[0, 246620], [7, 246846], [13, 247326], [17, 247786], [24, 248569], [28, 248778], [34, 249238], [37, 249898], [47, 250558], [49, 250658], [52, 250778], [61, 251378], [63, 251458], [70, 251738], [81, 252798], [85, 253078], [88, 253278]]}, {"verse": 44, "start": 254311, "end": 258643, "text": "El con todo, miraba cuando estaban en angustia, y oía su clamor:", "words": [[0, 254311], [3, 254611], [7, 254851], [13, 255191], [20, 255751], [27, 255991], [35, 256451], [38, 256651], [48, 257291], [50, 257511], [54, 257791], [57, 258246]]}, {"verse": 45, "start": 258993, "end": 265727, "text": "Y se acordaba de su pacto con ellos, y se arrepentía conforme a la muchedumbre de sus compasiones.", "words": [[0, 258993], [2, 259134], [5, 259234], [14, 259814], [17, 259974], [20, 260154], [26, 260674], [30, 260874], [37, 261214], [39, 261709], [42, 261849], [53, 262789], [62, 263129], [64, 263469], [67, 263609], [79, 264349], [82, 264469], [86, 264629]]}, {"verse": 46, "start": 266077, "end": 272119, "text": "Hizo asimismo tuviesen de ellos misericordia todos los que los tenían cautivos.", "words": [[0, 266077], [5, 266767], [14, 267477], [23, 268037], [26, 268257], [32, 268517], [45, 269437], [51, 269737], [55, 270317], [59, 270477], [63, 270617], [70, 270977]]}, {"verse": 47, "start": 272469, "end": 284480, "text": "Sálvanos, Jehová Dios nuestro, y reúnenos de entre las naciones, para que alabemos tu santo nombre, para que nos gloriemos en tus alabanzas.", "words": [[0, 272469], [10, 273022], [17, 273608], [22, 274195], [31, 275375], [33, 275395], [42, 276515], [45, 276935], [51, 277235], [55, 277475], [65, 278635], [70, 279015], [74, 279235], [83, 279955], [86, 280195], [92, 280575], [100, 281515], [105, 281775], [109, 281935], [113, 282155], [123, 282975], [126, 283175], [130, 283335]]}, {"verse": 48, "start": 284830, "end": 292683, "text": "Bendito Jehová Dios de Israel, desde el siglo y hasta el siglo: y diga todo el pueblo, Amén. Aleluya.", "words": [[0, 284830], [8, 285232], [15, 285666], [20, 286099], [23, 286279], [31, 286779], [37, 287194], [40, 287474], [46, 287894], [48, 288254], [54, 288474], [57, 288714], [64, 289616], [66, 289824], [71, 290074], [76, 290214], [79, 290414], [87, 290854], [93, 292239]]}]}