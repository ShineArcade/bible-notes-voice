{"book": "ISA", "chapter": 5, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 322770, "verses": [{"verse": 1, "start": 300, "end": 8378, "text": "Ahora cantaré por mi amado el cantar de mi amado a su viña. Tenía mi amado una viña en un colina, lugar fértil.", "words": [[0, 300], [6, 543], [14, 1163], [18, 1343], [21, 1583], [27, 1853], [30, 2123], [37, 2663], [40, 2803], [43, 2963], [49, 3343], [51, 3443], [54, 3583], [60, 4490], [66, 4919], [69, 5249], [75, 5579], [79, 5759], [84, 6139], [87, 6279], [90, 6399], [98, 6899], [104, 7339]]}, {"verse": 2, "start": 8828, "end": 24682, "text": "La había cercado, y despedregado, y plantado de vides escogidas: había edificado en medio de ella una torre, y también asentado un lagar en ella: y esperaba que llevase uvas, y llevó uvas silvestres.", "words": [[0, 8828], [3, 8973], [9, 9433], [18, 9893], [20, 9993], [34, 11133], [36, 11473], [45, 12273], [48, 12543], [54, 12813], [65, 14128], [71, 14375], [81, 15115], [84, 15235], [90, 15515], [93, 15755], [98, 16015], [102, 16355], [109, 17035], [111, 17655], [119, 18255], [128, 18855], [131, 19115], [137, 19655], [140, 19915], [146, 20767], [148, 20852], [157, 21332], [161, 21512], [169, 21932], [175, 22832], [177, 22932], [183, 23252], [188, 23712]]}, {"verse": 3, "start": 24982, "end": 32098, "text": "Ahora pues, vecinos de Jerusalén y varones de Judá, juzgad ahora entre mí y mi viña.", "words": [[0, 24982], [6, 25268], [12, 25968], [20, 26428], [23, 26648], [33, 27488], [35, 27928], [43, 28328], [46, 28508], [52, 29548], [59, 30088], [65, 30488], [71, 30868], [74, 31148], [76, 31428], [79, 31528]]}, {"verse": 4, "start": 32799, "end": 41424, "text": "¿Qué más se había de hacer a mi viña, que yo no haya hecho en ella? ¿Cómo, esperando yo que llevase uvas, ha llevado uvas silvestres?", "words": [[0, 32799], [5, 32898], [9, 33158], [12, 33298], [18, 33478], [21, 33718], [27, 33978], [29, 34118], [32, 34238], [38, 34638], [42, 34998], [45, 35138], [48, 35318], [53, 35558], [59, 35858], [62, 36018], [68, 36970], [75, 37214], [85, 37674], [88, 38074], [92, 38254], [100, 38794], [106, 39474], [109, 39654], [117, 40154], [122, 40554]]}, {"verse": 5, "start": 42105, "end": 51957, "text": "Os mostraré pues ahora lo que haré yo a mi viña: Le quitaré su vallado, y será para ser consumida; aportillaré su cerca, y será para ser hollada;", "words": [[0, 42105], [3, 42222], [12, 42802], [17, 42942], [23, 43302], [26, 43502], [30, 43662], [35, 43922], [38, 44122], [40, 44262], [43, 44362], [49, 45404], [52, 45506], [60, 45926], [63, 46066], [72, 46586], [74, 46986], [79, 47226], [84, 47466], [88, 47706], [99, 49047], [111, 49717], [114, 49897], [121, 50297], [123, 50597], [128, 50857], [133, 51097], [137, 51527]]}, {"verse": 6, "start": 52638, "end": 62728, "text": "Haré que quede desierta; no será podada ni cavada, y crecerá el cardo y las espinas: y aun a las nubes mandaré que no derramen lluvia sobre ella.", "words": [[0, 52638], [5, 52901], [9, 52981], [15, 53281], [25, 54635], [28, 54800], [33, 55000], [40, 55480], [43, 55820], [51, 56160], [53, 56540], [61, 57040], [64, 57120], [70, 57560], [72, 57640], [76, 57800], [85, 59045], [87, 59168], [91, 59388], [93, 59528], [97, 59708], [103, 60368], [111, 60808], [115, 60968], [118, 61128], [127, 61588], [134, 61948], [140, 62208]]}, {"verse": 7, "start": 63316, "end": 77878, "text": "Ciertamente la viña de Jehová de los ejércitos es la casa de Israel, y los hombres de Judá planta suya deleitosa. Esperaba juicio, y he aquí vileza; justicia, y he aquí clamor.", "words": [[0, 63316], [12, 64301], [15, 64481], [20, 64921], [23, 65041], [30, 65501], [33, 65581], [37, 66051], [47, 66521], [50, 66921], [53, 67221], [58, 67581], [61, 67821], [69, 68481], [71, 69201], [75, 69381], [83, 69741], [86, 69941], [91, 70341], [98, 70761], [103, 71503], [114, 72490], [123, 72978], [131, 73938], [133, 74258], [136, 74418], [141, 74963], [149, 75743], [159, 76390], [161, 76700], [164, 77010], [169, 77481]]}, {"verse": 8, "start": 78328, "end": 88202, "text": "¡Ay de los que juntan casa con casa, y juntan heredad a heredad hasta acabar el término! ¿Habitaréis vosotros solos en medio de la tierra?", "words": [[0, 78456], [4, 78616], [7, 78797], [11, 78917], [15, 79077], [22, 79577], [27, 79876], [31, 80176], [37, 80637], [39, 81176], [46, 81596], [54, 82017], [56, 82437], [64, 82857], [70, 83176], [77, 83577], [80, 83816], [89, 84771], [101, 85651], [110, 86211], [116, 86751], [119, 86911], [125, 87231], [128, 87431], [131, 87551]]}, {"verse": 9, "start": 88652, "end": 98390, "text": "Ha llegado a mis oídos de parte de Jehová de los ejércitos, que las muchas casas han de quedar asoladas, sin habitante las grandes y hermosas.", "words": [[0, 88652], [3, 88852], [11, 89272], [13, 89392], [17, 89512], [23, 89992], [26, 90092], [32, 90412], [35, 90652], [42, 91132], [45, 91212], [49, 91352], [60, 92132], [64, 92552], [68, 92692], [75, 92972], [81, 93692], [85, 93972], [88, 94112], [95, 94392], [105, 95132], [109, 95712], [119, 96452], [123, 96872], [131, 97312], [133, 97632]]}, {"verse": 10, "start": 98840, "end": 105300, "text": "Y diez huebras de viña producirán un zaque, y treinta modios de semilla darán tres modios.", "words": [[0, 98840], [2, 99043], [7, 99283], [15, 99923], [18, 100043], [23, 100403], [34, 101103], [37, 101423], [44, 101743], [46, 102253], [54, 102763], [61, 103263], [64, 103363], [72, 103903], [78, 104323], [83, 104523]]}, {"verse": 11, "start": 105750, "end": 114520, "text": "¡Ay de los que se levantan de mañana para seguir la embriaguez; que se están hasta la noche, hasta que el vino los enciende!", "words": [[0, 105910], [4, 106100], [7, 106800], [11, 106900], [15, 107040], [18, 107200], [27, 107760], [30, 107880], [37, 108280], [42, 108713], [49, 109147], [52, 109580], [64, 110245], [68, 110350], [71, 110490], [77, 110790], [83, 111010], [86, 111170], [93, 112010], [99, 112430], [103, 112690], [106, 113050], [111, 113310], [115, 113530]]}, {"verse": 12, "start": 114970, "end": 125482, "text": "Y en sus banquetes hay arpas, vihuelas, tamboriles, flautas, y vino; y no miran la obra de Jehová, ni consideran la obra de sus manos.", "words": [[0, 114970], [2, 115080], [5, 115180], [9, 115320], [19, 115980], [23, 116140], [30, 116870], [40, 117600], [52, 118540], [61, 119120], [63, 119320], [69, 120767], [71, 120891], [74, 121031], [80, 121411], [83, 121551], [88, 121831], [91, 122031], [99, 122631], [102, 123231], [113, 124071], [116, 124251], [121, 124491], [124, 124631], [128, 124771]]}, {"verse": 13, "start": 125932, "end": 134416, "text": "Por tanto mi pueblo fue llevado cautivo, porque no tuvo ciencia: y su gloria pereció de hambre, y su multitud se secó de sed.", "words": [[0, 125932], [4, 126033], [10, 126413], [13, 126553], [20, 126893], [24, 127193], [32, 127613], [41, 128233], [48, 128513], [51, 128693], [56, 128933], [65, 130110], [67, 130236], [70, 130376], [77, 130876], [85, 131476], [88, 131636], [96, 132116], [98, 132616], [101, 132736], [110, 133296], [113, 133476], [118, 133876], [121, 133956]]}, {"verse": 14, "start": 134866, "end": 148665, "text": "Por eso ensanchó su interior el sepulcro, y sin medida extendió su boca; y allá descenderá la gloria de ellos, y su multitud, y su fausto, y el que en él se alegraba.", "words": [[0, 134866], [4, 134990], [8, 135590], [17, 136230], [20, 136370], [29, 136890], [32, 137130], [42, 137790], [44, 138210], [48, 138390], [55, 138850], [64, 139670], [67, 139830], [73, 140637], [75, 140783], [80, 141003], [91, 141923], [94, 142063], [101, 142563], [104, 142723], [111, 143703], [113, 143963], [116, 144103], [126, 145283], [128, 145323], [131, 145503], [139, 146563], [141, 146643], [144, 146783], [148, 146963], [151, 147303], [154, 147463], [157, 147743]]}, {"verse": 15, "start": 149115, "end": 156524, "text": "Y el hombre será humillado, y el varón será abatido, y bajados serán los ojos de los altivos.", "words": [[0, 149115], [2, 149239], [5, 149359], [12, 149599], [17, 149919], [28, 150639], [30, 151419], [33, 151579], [39, 151979], [44, 152239], [53, 153079], [55, 153559], [63, 154179], [69, 154859], [73, 155039], [78, 155339], [81, 155539], [85, 155619]]}, {"verse": 16, "start": 156974, "end": 165239, "text": "Pero Jehová de los ejércitos será exaltado en juicio, y el Dios Santo será santificado con justicia.", "words": [[0, 156974], [5, 157178], [12, 157678], [15, 157758], [19, 157898], [29, 158718], [34, 159298], [43, 160218], [46, 160398], [54, 160958], [56, 161618], [59, 161798], [64, 162118], [70, 162698], [75, 163278], [87, 164118], [91, 164318]]}, {"verse": 17, "start": 165689, "end": 174117, "text": "Y los corderos serán apacentados según su costumbre; y extraños comerán las gruesas desamparadas.", "words": [[0, 165689], [2, 166073], [6, 166193], [15, 166733], [21, 167253], [33, 168173], [39, 168493], [42, 168793], [53, 169943], [55, 170185], [64, 170985], [72, 171905], [76, 172185], [84, 172845]]}, {"verse": 18, "start": 174567, "end": 181564, "text": "¡Ay de los que traen la iniquidad con cuerdas de vanidad, y el pecado como con cuerdas de carreta,", "words": [[0, 174765], [4, 174995], [7, 175225], [11, 175455], [15, 175575], [21, 176035], [24, 176235], [34, 176995], [38, 177255], [46, 177795], [49, 177915], [58, 178435], [60, 178895], [63, 179035], [70, 179575], [75, 179875], [79, 180155], [87, 180735], [90, 180835]]}, {"verse": 19, "start": 182014, "end": 190476, "text": "Los cuales dicen: Venga ya, apresúrese su obra, y veamos: acérquese, y venga el consejo del Santo de Israel, para que lo sepamos!", "words": [[0, 182014], [4, 182139], [11, 182399], [18, 183295], [24, 183595], [28, 184005], [39, 184415], [42, 184655], [48, 184955], [50, 185455], [58, 186405], [69, 187056], [71, 187476], [77, 187736], [80, 187836], [88, 188296], [92, 188396], [98, 188696], [101, 188896], [109, 189216], [114, 189556], [118, 189716], [121, 189816]]}, {"verse": 20, "start": 190826, "end": 204001, "text": "¡Ay de los que a lo malo dicen bueno, y a lo bueno malo; que hacen de la luz tinieblas, y de las tinieblas luz; que ponen lo amargo por dulce, y lo dulce por amargo!", "words": [[0, 190953], [4, 191113], [7, 191413], [11, 191553], [15, 191793], [17, 191913], [20, 192033], [25, 192393], [31, 192653], [38, 193133], [40, 193893], [42, 194013], [45, 194133], [51, 194413], [57, 195427], [61, 195529], [67, 195849], [70, 196089], [73, 196229], [77, 196449], [88, 197369], [90, 198489], [93, 198629], [97, 198769], [107, 199389], [112, 200283], [116, 200368], [122, 200808], [125, 200988], [132, 201468], [136, 201708], [143, 202288], [145, 202468], [148, 202628], [154, 203068], [158, 203288]]}, {"verse": 21, "start": 204451, "end": 209753, "text": "¡Ay de los sabios en sus ojos, y de los que son prudentes delante de sí mismos!", "words": [[0, 204583], [4, 204753], [7, 204913], [11, 205073], [18, 205573], [21, 205773], [25, 205953], [31, 206413], [33, 207013], [36, 207153], [40, 207273], [44, 207413], [48, 207613], [58, 208253], [66, 208713], [69, 208913], [72, 209053]]}, {"verse": 22, "start": 210203, "end": 216386, "text": "¡Ay de los que son valientes para beber vino, y hombres fuertes para mezclar bebida;", "words": [[0, 210362], [4, 210562], [7, 210762], [11, 210902], [15, 211062], [19, 211282], [29, 211902], [34, 212222], [40, 212482], [46, 212982], [48, 213422], [56, 213722], [64, 214842], [69, 215202], [77, 215682]]}, {"verse": 23, "start": 216836, "end": 222769, "text": "Los que dan por justo al impío por cohechos, y al justo quitan su justicia!", "words": [[0, 216895], [4, 216985], [8, 217145], [12, 217385], [16, 217625], [22, 218065], [25, 218285], [31, 218925], [35, 219185], [45, 219985], [47, 220405], [50, 220545], [56, 221025], [63, 221705], [66, 221965]]}, {"verse": 24, "start": 223219, "end": 243832, "text": "Por tanto, como la lengua del fuego consume las aristas, y la llama devora la paja, así será su raíz como podredumbre, y su flor se desvanecerá como polvo: porque desecharon la ley de Jehová de los ejércitos, y abominaron la palabra del Santo de Israel.", "words": [[0, 223219], [4, 223363], [11, 224223], [16, 224543], [19, 224723], [26, 225123], [30, 225263], [36, 225683], [44, 226383], [48, 226663], [57, 227283], [59, 228103], [62, 228243], [68, 228503], [75, 228923], [78, 229063], [84, 229963], [88, 230263], [93, 230563], [96, 230783], [101, 231223], [106, 231873], [119, 232523], [121, 233163], [124, 233343], [129, 233803], [132, 234343], [144, 235323], [149, 235523], [156, 236781], [163, 237065], [174, 237905], [177, 238145], [181, 238385], [184, 238525], [191, 238925], [194, 239005], [198, 239145], [209, 240005], [211, 240585], [222, 241365], [225, 241585], [233, 241965], [237, 242245], [243, 242665], [246, 242985]]}, {"verse": 25, "start": 244282, "end": 263951, "text": "Por esta causa se encendió el furor de Jehová contra su pueblo, y extendió contra él su mano, y lo hirió; y se estremecieron los montes, y sus cadáveres fueron arrojados en medio de las calles. Con todo esto no ha cesado su furor, antes está su mano todavía extendida.", "words": [[0, 244282], [4, 244423], [9, 244603], [15, 245063], [18, 245263], [27, 245803], [30, 245903], [36, 246303], [39, 246443], [46, 246883], [53, 247123], [56, 247343], [64, 247763], [66, 248403], [75, 249063], [82, 249423], [85, 249723], [88, 249923], [94, 250243], [96, 250923], [99, 251103], [106, 251862], [108, 252026], [111, 252126], [125, 253026], [129, 253166], [137, 253846], [139, 254506], [143, 254666], [153, 255366], [160, 255606], [170, 256486], [173, 256706], [179, 256986], [182, 257186], [186, 257326], [194, 258326], [198, 258448], [203, 258748], [208, 259068], [211, 259348], [214, 259488], [221, 259948], [224, 260128], [231, 260988], [237, 261383], [242, 261778], [245, 262173], [250, 262568], [258, 262988]]}, {"verse": 26, "start": 264401, "end": 273692, "text": "Y alzará pendón a naciones lejanas, y silbará al que está en el extremo de la tierra; y he aquí que vendrá pronto y velozmente.", "words": [[0, 264401], [2, 264540], [9, 265060], [16, 265600], [18, 265780], [27, 266180], [36, 267400], [38, 267640], [46, 268060], [49, 268480], [53, 268700], [58, 268920], [61, 269200], [64, 269360], [72, 270000], [75, 270060], [78, 270180], [86, 271185], [88, 271390], [91, 271490], [96, 271770], [100, 271910], [107, 272330], [114, 272670], [116, 272850]]}, {"verse": 27, "start": 274142, "end": 287364, "text": "No habrá entre ellos cansado, ni que vacile; ninguno se dormirá ni le tomará sueño; a ninguno se le desatará el cinto de los lomos, ni se le romperá la correa de sus sandalias.", "words": [[0, 274142], [3, 274350], [9, 274770], [15, 275010], [21, 275310], [30, 275930], [33, 276550], [37, 276670], [45, 277564], [53, 278052], [56, 278212], [64, 278692], [67, 278852], [70, 278952], [77, 279392], [84, 280226], [86, 280346], [94, 280866], [97, 281046], [100, 281166], [109, 281966], [112, 282206], [118, 282866], [121, 283046], [125, 283166], [132, 283666], [135, 284106], [138, 284346], [141, 284506], [149, 285226], [152, 285346], [159, 285886], [162, 286046], [166, 286226]]}, {"verse": 28, "start": 287814, "end": 297974, "text": "Sus flechas afiladas, y todos sus arcos tensados; las uñas de sus caballos parecerán como de pedernal, y las ruedas de sus carros como torbellino.", "words": [[0, 287814], [4, 287939], [12, 288399], [22, 289079], [24, 289479], [30, 289719], [34, 290019], [40, 290359], [50, 291769], [54, 291889], [59, 292229], [62, 292389], [66, 292529], [75, 293089], [85, 293769], [90, 294009], [93, 294189], [103, 295049], [105, 295409], [109, 295569], [116, 296049], [119, 296169], [123, 296309], [130, 296849], [135, 297049]]}, {"verse": 29, "start": 298424, "end": 308892, "text": "Su bramido como de león; rugirá a manera de leoncillos, rechinará los dientes, y arrebatará la presa; la llevará, y nadie se la quitará.", "words": [[0, 298664], [3, 298904], [11, 299144], [16, 299344], [19, 299524], [25, 300795], [32, 301115], [34, 301255], [41, 301535], [44, 301775], [56, 302955], [66, 303575], [70, 303715], [79, 304215], [81, 304555], [92, 305215], [95, 305355], [102, 306224], [105, 306349], [114, 306969], [116, 307209], [122, 307629], [125, 308009], [128, 308149]]}, {"verse": 30, "start": 309342, "end": 322370, "text": "Y bramará sobre él en aquel día como bramido del mar: entonces mirará hacia la tierra, y he aquí tinieblas de tribulación, y en sus cielos se oscurecerá la luz.", "words": [[0, 309342], [2, 309487], [10, 310027], [16, 310347], [19, 310687], [22, 310847], [28, 311207], [32, 311427], [37, 311867], [45, 312307], [49, 312547], [54, 313349], [63, 313890], [70, 314690], [76, 314990], [79, 315190], [87, 316350], [89, 316470], [92, 316630], [97, 316950], [107, 317650], [110, 317770], [123, 319130], [125, 319250], [128, 319410], [132, 319570], [139, 320190], [142, 320610], [153, 321610], [156, 321890]]}]}