{"book": "PSA", "chapter": 18, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 338336, "verses": [{"verse": 1, "start": 300, "end": 18105, "text": "Al Músico principal: Salmo de David, siervo de Jehová, el cual profirió a Jehová las palabras de este cántico el día que le libró Jehová de mano de todos sus enemigos, y de mano de Saúl. Entonces dijo: TE AMARÉ, oh Jehová, fortaleza mía.", "words": [[0, 300], [3, 491], [10, 971], [21, 2271], [27, 2894], [30, 3154], [37, 4074], [44, 4474], [47, 4594], [55, 5414], [58, 5414], [63, 5614], [72, 6374], [74, 6514], [81, 6934], [85, 7074], [94, 7414], [97, 7754], [102, 7954], [110, 8694], [113, 8714], [117, 8914], [121, 9094], [124, 9234], [130, 9634], [137, 10074], [140, 10174], [145, 10394], [148, 10574], [154, 10814], [158, 11294], [168, 12461], [170, 12586], [173, 12706], [178, 12926], [181, 13146], [187, 14072], [196, 14637], [202, 15653], [205, 15757], [212, 16164], [215, 16570], [223, 16977], [233, 17557]]}, {"verse": 2, "start": 18555, "end": 29703, "text": "Jehová, roca mía y castillo mío, y mi libertador; Dios mío, fuerte mío, en él confiaré; escudo mío, y el cuerno de mi salvación, mi refugio.", "words": [[0, 18555], [8, 18982], [13, 19382], [17, 19762], [19, 19842], [28, 20382], [33, 20722], [35, 20822], [38, 20922], [50, 22229], [55, 22549], [60, 23089], [67, 23329], [72, 23769], [75, 23909], [78, 24029], [88, 25136], [95, 25580], [100, 26580], [102, 26780], [105, 26960], [112, 27520], [115, 27600], [118, 27760], [129, 28740], [132, 28800]]}, {"verse": 3, "start": 30153, "end": 35230, "text": "Invocaré a Jehová, digno de ser alabado, y seré salvo de mis enemigos.", "words": [[0, 30153], [9, 30934], [11, 31014], [19, 31414], [25, 31874], [28, 31954], [32, 32174], [41, 32894], [43, 33334], [48, 33634], [54, 34114], [57, 34254], [61, 34354]]}, {"verse": 4, "start": 35680, "end": 40868, "text": "Me cercaron dolores de muerte, y torrentes de perversidad me atemorizaron.", "words": [[0, 35680], [3, 35788], [12, 36288], [20, 36768], [23, 36908], [31, 37328], [33, 37848], [43, 38608], [46, 38708], [58, 39568], [61, 39748]]}, {"verse": 5, "start": 41318, "end": 46738, "text": "Dolores del sepulcro me rodearon, me sorprendieron lazos de muerte.", "words": [[0, 41318], [8, 41863], [12, 42123], [21, 42843], [24, 43003], [34, 44163], [37, 44443], [51, 45323], [57, 45883], [60, 46003]]}, {"verse": 6, "start": 47188, "end": 57166, "text": "En mi angustia invoqué a Jehová, y clamé a mi Dios: él oyó mi voz desde su templo, y mi clamor llegó delante de él, a sus oídos.", "words": [[0, 47188], [3, 47517], [6, 47657], [15, 48297], [23, 48737], [25, 48877], [33, 49477], [35, 49737], [41, 50157], [43, 50457], [46, 50577], [52, 51506], [55, 51692], [59, 52012], [62, 52132], [66, 52492], [72, 52892], [75, 53192], [83, 54252], [85, 54292], [88, 54432], [95, 54912], [101, 55152], [109, 55672], [112, 55892], [116, 56072], [118, 56292], [122, 56452]]}, {"verse": 7, "start": 57616, "end": 66484, "text": "Y la tierra fue conmovida y tembló; y se movieron los fundamentos de los montes, y se estremecieron, porque se indignó él.", "words": [[0, 57616], [2, 57720], [5, 57860], [12, 58180], [16, 58520], [26, 59160], [28, 59320], [36, 60226], [38, 60391], [41, 60471], [50, 60971], [54, 61151], [66, 61851], [69, 61931], [73, 62071], [81, 62651], [83, 63051], [86, 63231], [101, 64311], [108, 64911], [111, 65171], [119, 66051]]}, {"verse": 8, "start": 66934, "end": 73974, "text": "Humo subió de su nariz, y de su boca consumidor fuego; carbones fueron por él encendidos.", "words": [[0, 66934], [5, 67419], [11, 68019], [14, 68139], [17, 68319], [24, 68939], [26, 69119], [29, 69219], [32, 69379], [37, 69719], [48, 70599], [55, 71662], [64, 72266], [71, 72506], [75, 72826], [78, 72986]]}, {"verse": 9, "start": 74424, "end": 79733, "text": "Y bajó los cielos, y descendió; y oscuridad debajo de sus pies.", "words": [[0, 74424], [2, 74549], [7, 74869], [11, 74989], [19, 75769], [21, 76089], [32, 77163], [34, 77508], [44, 78228], [51, 78728], [54, 78868], [58, 79008]]}, {"verse": 10, "start": 80183, "end": 85437, "text": "Y cabalgó sobre un querubín, y voló: voló sobre las alas del viento.", "words": [[0, 80183], [2, 80519], [10, 80889], [16, 81169], [19, 81349], [29, 82089], [31, 82509], [37, 83376], [42, 83762], [48, 84022], [52, 84242], [57, 84602], [61, 84762]]}, {"verse": 11, "start": 85887, "end": 94509, "text": "Puso tinieblas por escondedero suyo, su pabellón en derredor de sí; oscuridad de aguas, nubes de los cielos.", "words": [[0, 85887], [5, 86111], [15, 86711], [19, 87181], [31, 87651], [37, 88531], [40, 88771], [49, 89391], [52, 89781], [61, 90171], [64, 90471], [68, 91164], [78, 91850], [81, 92070], [88, 92950], [94, 93430], [97, 93570], [101, 93690]]}, {"verse": 12, "start": 94959, "end": 101062, "text": "Por el resplandor delante de él, sus nubes pasaron; granizo y carbones ardientes.", "words": [[0, 94959], [4, 95256], [7, 95436], [18, 96056], [26, 96516], [29, 96656], [33, 96856], [37, 97036], [43, 97456], [52, 98570], [60, 99310], [62, 99550], [71, 100030]]}, {"verse": 13, "start": 101512, "end": 108494, "text": "Y tronó en los cielos Jehová, y el Altísimo dio su voz; granizo y carbones de fuego.", "words": [[0, 101512], [2, 101657], [8, 102077], [11, 102177], [15, 102297], [22, 102777], [30, 103537], [32, 103777], [35, 103917], [44, 104597], [48, 104977], [51, 105277], [56, 106140], [64, 106764], [66, 107244], [75, 107784], [78, 107924]]}, {"verse": 14, "start": 108944, "end": 115041, "text": "Y envió sus flechas, y los desbarató; y echó relámpagos, y los destruyó.", "words": [[0, 108944], [2, 109069], [8, 109489], [12, 109689], [21, 110369], [23, 110829], [27, 110969], [38, 112066], [40, 112347], [45, 112667], [57, 113927], [59, 114127], [63, 114267]]}, {"verse": 15, "start": 115491, "end": 125175, "text": "Y aparecieron las honduras de las aguas, y se descubrieron los cimientos del mundo, a tu reprensión, oh Jehová, por el soplo del viento de tu nariz.", "words": [[0, 115491], [2, 115634], [14, 116294], [18, 116644], [27, 116994], [30, 117134], [34, 117314], [41, 117934], [43, 118114], [46, 118234], [59, 119014], [63, 119174], [73, 119694], [77, 119934], [84, 120694], [86, 121062], [89, 121430], [101, 121798], [104, 122166], [112, 122534], [116, 122854], [119, 122994], [125, 123514], [129, 123714], [136, 124194], [139, 124544], [142, 124893]]}, {"verse": 16, "start": 125625, "end": 130363, "text": "Envió desde lo alto; me tomó, me sacó de las muchas aguas.", "words": [[0, 125625], [6, 126026], [12, 126226], [15, 126466], [21, 127362], [24, 127508], [30, 128488], [33, 128648], [38, 129068], [41, 129188], [45, 129328], [52, 129568]]}, {"verse": 17, "start": 130813, "end": 137126, "text": "Me libró de mi poderoso enemigo, y de los que me aborrecían, aunque eran ellos más fuertes que yo.", "words": [[0, 130813], [3, 130939], [9, 131399], [12, 131499], [15, 131639], [24, 132219], [33, 133019], [35, 133279], [38, 133399], [42, 133579], [46, 133759], [49, 133939], [61, 135039], [68, 135279], [73, 135639], [79, 135859], [83, 136139], [91, 136659], [95, 136759]]}, {"verse": 18, "start": 137576, "end": 142081, "text": "Me asaltaron en el día de mi quebranto: mas Jehová fue mi apoyo.", "words": [[0, 137576], [3, 137722], [13, 138542], [16, 138742], [19, 138882], [23, 139122], [26, 139242], [29, 139402], [40, 140460], [44, 140738], [51, 141048], [55, 141248], [58, 141687]]}, {"verse": 19, "start": 142531, "end": 146770, "text": "Y me sacó a anchura: me libró, porque se agradó de mí.", "words": [[0, 142531], [2, 142677], [5, 142777], [10, 143027], [12, 143277], [21, 144481], [24, 144588], [31, 145268], [38, 145608], [41, 145808], [48, 146288], [51, 146448]]}, {"verse": 20, "start": 147220, "end": 152916, "text": "Me ha pagado Jehová conforme a mi justicia: conforme a la limpieza de mis manos me ha vuelto.", "words": [[0, 147220], [3, 147339], [6, 147459], [13, 147839], [20, 148259], [29, 148879], [31, 148939], [34, 149039], [44, 150167], [53, 150751], [55, 150831], [58, 150891], [67, 151491], [70, 151591], [74, 151751], [80, 152051], [83, 152271], [86, 152351]]}, {"verse": 21, "start": 153366, "end": 159483, "text": "Porque yo he guardado los caminos de Jehová, y no me aparté impíamente de mi Dios.", "words": [[0, 153366], [7, 153569], [10, 153849], [13, 153969], [22, 154489], [26, 154649], [34, 155109], [37, 155289], [45, 156009], [47, 156229], [50, 156449], [53, 156669], [60, 157349], [71, 158429], [74, 158709], [77, 158829]]}, {"verse": 22, "start": 159933, "end": 165452, "text": "Pues todos sus juicios estuvieron delante de mí, y no eché de mí sus estatutos.", "words": [[0, 159933], [5, 160077], [11, 160337], [15, 160617], [23, 161037], [34, 161677], [42, 162177], [45, 162337], [49, 162577], [51, 163437], [54, 163717], [59, 163997], [62, 164157], [65, 164297], [69, 164517]]}, {"verse": 23, "start": 165902, "end": 170601, "text": "Y fui íntegro para con él, y me he guardado de mi maldad.", "words": [[0, 165902], [2, 166029], [6, 166209], [14, 167069], [19, 167309], [23, 167589], [27, 167789], [29, 168629], [32, 168849], [35, 168969], [44, 169549], [47, 169729], [50, 169889]]}, {"verse": 24, "start": 171051, "end": 177625, "text": "Me pagó pues Jehová conforme a mi justicia; conforme a la limpieza de mis manos delante de sus ojos.", "words": [[0, 171051], [3, 171160], [8, 171560], [13, 171800], [20, 172380], [29, 172670], [31, 172960], [34, 173060], [44, 174180], [53, 174724], [55, 174804], [58, 174864], [67, 175524], [70, 175644], [74, 175784], [80, 176204], [88, 176704], [91, 176844], [95, 177004]]}, {"verse": 25, "start": 178075, "end": 184433, "text": "Con el misericordioso te mostrarás misericordioso, y recto para con el hombre íntegro.", "words": [[0, 178075], [4, 178223], [7, 178343], [22, 179363], [25, 179733], [35, 180103], [51, 181143], [53, 181863], [59, 182583], [64, 182863], [68, 183083], [71, 183203], [78, 183463]]}, {"verse": 26, "start": 184883, "end": 189810, "text": "Limpio te mostrarás para con el limpio, y severo serás para con el perverso.", "words": [[0, 184883], [7, 185527], [10, 185647], [20, 186327], [25, 186547], [29, 186787], [32, 186927], [40, 187547], [42, 187647], [49, 188107], [55, 188407], [60, 188587], [64, 188827], [67, 188947]]}, {"verse": 27, "start": 190260, "end": 194654, "text": "Y tú salvarás al pueblo humilde, y humillarás los ojos altivos.", "words": [[0, 190260], [2, 190371], [5, 190511], [14, 191151], [17, 191291], [24, 191531], [33, 192211], [35, 192731], [46, 193331], [50, 193451], [55, 193731]]}, {"verse": 28, "start": 195104, "end": 200954, "text": "Tú pues alumbrarás mi lámpara: Jehová mi Dios alumbrará mis tinieblas.", "words": [[0, 195104], [3, 195738], [8, 195958], [19, 196618], [22, 196818], [31, 197865], [38, 198374], [41, 198454], [46, 199194], [56, 199814], [60, 200014]]}, {"verse": 29, "start": 201404, "end": 206425, "text": "Porque contigo desharé ejércitos; y con mi Dios asaltaré muros.", "words": [[0, 201404], [7, 201609], [15, 202169], [23, 202729], [34, 204107], [36, 204212], [40, 204372], [43, 204572], [48, 204872], [57, 205772]]}, {"verse": 30, "start": 206875, "end": 215335, "text": "Dios, perfecto su camino: es purificada la palabra de Jehová: escudo es a todos los que en él esperan.", "words": [[0, 206875], [6, 207201], [15, 208061], [18, 208181], [26, 209146], [29, 209476], [40, 210416], [43, 210596], [51, 210936], [54, 211136], [62, 212016], [69, 212500], [72, 212640], [74, 212760], [80, 213080], [84, 213320], [88, 213520], [91, 213680], [94, 213760]]}, {"verse": 31, "start": 215785, "end": 219952, "text": "Porque ¿qué Dios hay fuera de Jehová? ¿y qué fuerte fuera de nuestro Dios?", "words": [[0, 215785], [7, 215785], [12, 216000], [17, 216254], [21, 216507], [27, 216807], [30, 216967], [38, 217780], [41, 217868], [45, 217988], [52, 218468], [58, 218788], [61, 219048], [69, 219228]]}, {"verse": 32, "start": 220402, "end": 224795, "text": "Dios es el que me ciñe de fuerza, e hizo perfecto mi camino;", "words": [[0, 220402], [5, 220671], [8, 221131], [11, 221351], [15, 221511], [18, 221631], [23, 222031], [26, 222111], [34, 222471], [36, 222791], [41, 223091], [50, 223951], [53, 224051]]}, {"verse": 33, "start": 225245, "end": 230500, "text": "Quien pone mis pies como pies de ciervas, y me hizo estar sobre mis alturas;", "words": [[0, 225245], [6, 225370], [11, 225690], [15, 225910], [20, 226230], [25, 226790], [30, 227070], [33, 227470], [42, 227870], [44, 228250], [47, 228390], [52, 228670], [58, 229010], [64, 229330], [68, 229570]]}, {"verse": 34, "start": 230950, "end": 238122, "text": "Quien enseña mis manos para la batalla, y será quebrado con mis brazos el arco de acero.", "words": [[0, 230950], [6, 231155], [13, 232035], [17, 232215], [23, 232655], [28, 233075], [31, 233235], [40, 233775], [42, 234495], [47, 234715], [56, 235355], [60, 235535], [64, 235735], [71, 236375], [74, 236895], [79, 237375], [82, 237535]]}, {"verse": 35, "start": 238572, "end": 246550, "text": "Me diste asimismo el escudo de tu salvación: y tu diestra me sustentó, y tu benignidad me ha acrecentado.", "words": [[0, 238890], [3, 239240], [9, 239590], [18, 239940], [21, 240140], [28, 240600], [31, 240760], [34, 240920], [45, 242020], [47, 242122], [50, 242282], [58, 242662], [61, 242842], [71, 243522], [73, 244082], [76, 244522], [87, 244962], [90, 245282], [93, 245943]]}, {"verse": 36, "start": 247000, "end": 251492, "text": "Ensanchaste mis pasos debajo de mí, y no titubearon mis rodillas.", "words": [[0, 247000], [12, 247766], [16, 247946], [22, 248366], [29, 248746], [32, 248886], [36, 249066], [38, 249446], [41, 249626], [52, 250366], [56, 250606]]}, {"verse": 37, "start": 251942, "end": 257415, "text": "He perseguido a mis enemigos, y los alcancé, y no volví hasta acabarlos.", "words": [[0, 251942], [3, 252089], [14, 252809], [16, 252909], [20, 253009], [30, 253669], [32, 254449], [36, 254609], [45, 255409], [47, 255569], [50, 255709], [56, 256209], [62, 256449]]}, {"verse": 38, "start": 257865, "end": 262488, "text": "Los he herido, y no podrán levantarse: cayeron debajo de mis pies.", "words": [[0, 257865], [4, 258010], [7, 258330], [15, 258830], [17, 258950], [20, 259070], [27, 259550], [39, 261066], [47, 261316], [54, 261716], [57, 261856], [61, 261996]]}, {"verse": 39, "start": 262938, "end": 268540, "text": "Pues me ceñiste de fortaleza para la pelea; has agobiado mis enemigos debajo de mí.", "words": [[0, 262938], [5, 263138], [8, 263458], [16, 263778], [19, 263938], [29, 264618], [34, 264818], [37, 264998], [44, 265897], [48, 266180], [57, 266940], [61, 267100], [70, 267660], [77, 268080], [80, 268260]]}, {"verse": 40, "start": 268990, "end": 274038, "text": "Y me diste la cerviz de mis enemigos, y destruí a los que me aborrecían.", "words": [[0, 268990], [2, 269234], [5, 269374], [11, 269721], [14, 270067], [21, 270414], [24, 270514], [28, 270614], [38, 271274], [40, 271914], [48, 272534], [50, 272694], [54, 272834], [58, 272954], [61, 273094]]}, {"verse": 41, "start": 274488, "end": 279652, "text": "Clamaron, y no hubo quien salvase: aun a Jehová, pero no los oyó.", "words": [[0, 274488], [10, 274969], [12, 275189], [15, 275349], [20, 275789], [26, 275949], [35, 277169], [39, 277169], [41, 277772], [49, 278412], [54, 278712], [57, 279045], [61, 279378]]}, {"verse": 42, "start": 280102, "end": 285619, "text": "Y los molí como polvo delante del viento; los esparcí como lodo de las calles.", "words": [[0, 280102], [2, 280207], [6, 280347], [11, 280747], [16, 280947], [22, 281527], [30, 282027], [34, 282247], [42, 283217], [46, 283364], [54, 284024], [59, 284224], [64, 284584], [67, 284744], [71, 284884]]}, {"verse": 43, "start": 286069, "end": 293661, "text": "Me libraste de contiendas de pueblo: me pusiste por cabeza de las naciones: pueblo que yo no conocía, me sirvió.", "words": [[0, 286069], [3, 286250], [12, 286750], [15, 286930], [26, 287750], [29, 287850], [37, 288799], [40, 288964], [48, 289504], [52, 289744], [59, 290184], [62, 290404], [66, 290564], [76, 291686], [83, 291868], [87, 292168], [90, 292328], [93, 292678], [102, 293028], [105, 293088]]}, {"verse": 44, "start": 294111, "end": 299253, "text": "Tan pronto como oyó, me obedeció; los hijos de extraños me mintieron;", "words": [[0, 294111], [4, 294255], [11, 294635], [16, 295025], [21, 295415], [24, 295875], [34, 296961], [38, 297067], [44, 297367], [47, 297527], [56, 298207], [59, 298730]]}, {"verse": 45, "start": 299703, "end": 304103, "text": "Los extraños flaquearon, y tuvieron miedo desde sus escondites.", "words": [[0, 299703], [4, 299828], [13, 300588], [25, 301388], [27, 301648], [36, 302068], [42, 302548], [48, 302828], [52, 303108]]}, {"verse": 46, "start": 304553, "end": 311124, "text": "Viva Jehová, y sea bendita mi roca; y enaltecido sea el Dios de mi salvación:", "words": [[0, 304553], [5, 304959], [13, 305659], [15, 305839], [19, 306059], [27, 306679], [30, 306859], [36, 307788], [38, 308305], [49, 308855], [53, 309195], [56, 309615], [61, 309855], [64, 310115], [67, 310235]]}, {"verse": 47, "start": 311574, "end": 315288, "text": "El Dios que me da las venganzas, y sujetó pueblos a mí.", "words": [[0, 311574], [3, 311757], [8, 312057], [12, 312457], [15, 312597], [18, 312737], [22, 312857], [33, 313517], [35, 313877], [42, 314317], [50, 314837], [52, 314977]]}, {"verse": 48, "start": 315738, "end": 322787, "text": "Mi libertador de mis enemigos: me hiciste también superior de mis adversarios; me libraste de varón violento.", "words": [[0, 315738], [3, 315865], [14, 316485], [17, 316665], [21, 316785], [31, 317859], [34, 317986], [42, 318366], [50, 318666], [59, 319166], [62, 319446], [66, 319566], [79, 320909], [82, 321229], [91, 321549], [94, 321709], [100, 321989]]}, {"verse": 49, "start": 323237, "end": 328880, "text": "Por tanto yo te confesaré entre las naciones, oh Jehová, y cantaré a tu nombre.", "words": [[0, 323237], [4, 323361], [10, 323841], [13, 323981], [16, 324121], [26, 324861], [32, 325161], [36, 325421], [46, 326081], [49, 326741], [57, 327401], [59, 327501], [67, 328021], [69, 328161], [72, 328261]]}, {"verse": 50, "start": 329330, "end": 337936, "text": "El cual da grandes triunfos a su rey, y hace misericordia a su ungido, a David y a su descendencia, para siempre.", "words": [[0, 329330], [3, 329476], [8, 329676], [11, 329876], [19, 330176], [28, 330896], [30, 330996], [33, 331136], [38, 332216], [40, 332376], [45, 332616], [58, 333656], [60, 333876], [63, 334036], [71, 334836], [73, 335016], [79, 335296], [81, 335596], [83, 335696], [86, 335836], [100, 336856], [105, 337236]]}]}