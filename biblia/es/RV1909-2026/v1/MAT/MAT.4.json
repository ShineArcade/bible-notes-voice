7490], [60, 67790], [66, 68070], [69, 68370], [74, 68590], [83, 69410], [85, 69830], [87, 69930], [90, 70090], [95, 70430]]}, {"verse": 11, "start": 71759, "end": 76812, "text": "El diablo entonces le dejó: y he aquí los ángeles llegaron y le servían.", "words": [[0, 71759], [3, 72023], [10, 72423], [19, 72803], [22, 73103], [28, 73802], [30, 73982], [33, 74162], [38, 74442], [42, 74842], [50, 75422], [59, 75962], [61, 76112], [64, 76262]]}, {"verse": 12, "start": 77162, "end": 82737, "text": "Pero oyendo Jesús que Juan había sido encarcelado, se volvió a Galilea;", "words": [[0, 77162], [5, 77323], [12, 77843], [18, 78203], [22, 78523], [27, 78983], [33, 79343], [38, 79783], [51, 81123], [54, 81363], [61, 81843], [63, 81963]]}, {"verse": 13, "start": 83087, "end": 91758, "text": "Y dejando a Nazaret, vino y habitó en Capernaum, ciudad junto al mar, en los confines de Zabulón y de Neftalí:", "words": [[0, 83087], [2, 83185], [10, 83625], [12, 83745], [21, 84285], [26, 85225], [28, 85525], [35, 85925], [38, 86505], [49, 87085], [56, 87665], [62, 87985], [65, 88265], [70, 89105], [73, 89205], [77, 89325], [86, 89845], [89, 90235], [97, 90625], [99, 90845], [102, 90925]]}, {"verse": 14, "start": 92108, "end": 97147, "text": "Para que se cumpliese lo que fue dicho por el profeta Isaías, que dijo:", "words": [[0, 92108], [5, 92272], [9, 92432], [12, 92862], [22, 93292], [25, 93532], [29, 93672], [33, 93872], [39, 94172], [43, 94472], [46, 94612], [54, 95292], [62, 96432], [66, 96592]]}, {"verse": 15, "start": 97497, "end": 106678, "text": "La tierra de Zabulón, y la tierra de Neftalí, camino del mar, del otro lado del Jordán, Galilea de los Gentiles;", "words": [[0, 97497], [3, 97671], [10, 98031], [13, 98491], [22, 98951], [24, 99611], [27, 99731], [34, 100071], [37, 100311], [46, 101171], [53, 101411], [57, 101731], [62, 102531], [66, 102651], [71, 102971], [76, 103291], [80, 103591], [88, 104731], [96, 105311], [99, 105431], [103, 105571]]}, {"verse": 16, "start": 107028, "end": 117489, "text": "El pueblo asentado en tinieblas, vio gran luz; y a los sentados en región y sombra de muerte, una luz les resplandeció.", "words": [[0, 107028], [3, 107448], [10, 107788], [19, 108608], [22, 108748], [33, 109488], [37, 109948], [42, 110168], [47, 110974], [49, 111143], [51, 111243], [55, 111383], [64, 112203], [67, 112443], [74, 112883], [76, 113183], [83, 113703], [86, 113843], [94, 114743], [98, 115103], [102, 115603], [106, 116083]]}, {"verse": 17, "start": 117839, "end": 126501, "text": "Desde entonces comenzó Jesús a predicar, y a decir: Arrepentíos, que el reino de los cielos se ha acercado.", "words": [[0, 117839], [6, 118165], [15, 118805], [23, 119605], [29, 119865], [31, 120145], [41, 120785], [43, 121265], [45, 121385], [52, 122118], [65, 123158], [69, 123558], [72, 123718], [78, 124078], [81, 124198], [85, 124378], [92, 125158], [95, 125478], [98, 125638]]}, {"verse": 18, "start": 126851, "end": 139325, "text": "Y andando Jesús junto al mar de Galilea, vio a dos hermanos, Simón, que es llamado Pedro, y Andrés su hermano, que echaban la red en el mar; porque eran pescadores.", "words": [[0, 126851], [2, 126976], [10, 127396], [16, 127816], [22, 128196], [25, 128496], [29, 128696], [32, 128856], [41, 129756], [45, 130136], [47, 130336], [51, 130516], [61, 131376], [68, 132316], [72, 132406], [75, 132496], [83, 132836], [90, 133316], [92, 133571], [99, 134311], [102, 134511], [111, 135431], [115, 135531], [123, 136011], [126, 136231], [130, 136511], [133, 136931], [136, 137111], [141, 137827], [148, 138053], [153, 138273]]}, {"verse": 19, "start": 139675, "end": 144728, "text": "Y les dice: Venid en pos de mí, y os haré pescadores de hombres.", "words": [[0, 139675], [2, 139855], [6, 139975], [12, 140809], [18, 141235], [21, 141435], [25, 141635], [28, 141835], [32, 142075], [34, 142455], [37, 142835], [42, 143215], [53, 143735], [56, 143995]]}, {"verse": 20, "start": 145078, "end": 149698, "text": "Ellos entonces, dejando luego