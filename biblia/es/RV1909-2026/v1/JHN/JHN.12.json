{"book": "JHN", "chapter": 12, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 398654, "verses": [{"verse": 1, "start": 300, "end": 11684, "text": "Y Jesús, seis días antes de la Pascua, vino a Betania, donde estaba Lázaro, que había sido muerto, al cual había resucitado de los muertos.", "words": [[0, 300], [2, 460], [9, 1240], [14, 1620], [19, 2060], [25, 2640], [28, 2840], [31, 2960], [39, 3940], [44, 4200], [46, 4520], [55, 5840], [61, 5980], [68, 6380], [76, 7480], [80, 7520], [86, 7760], [91, 8100], [99, 9160], [102, 9300], [107, 9560], [113, 10020], [124, 11000], [127, 11140], [131, 11260]]}, {"verse": 2, "start": 12034, "end": 21168, "text": "Y le hicieron allí una cena: y Marta servía, y Lázaro era uno de los que estaban sentados a la mesa juntamente con él.", "words": [[0, 12034], [2, 12433], [5, 12573], [14, 12983], [19, 13393], [23, 13673], [29, 14429], [31, 14554], [37, 15114], [45, 16139], [47, 16259], [54, 16759], [58, 17139], [62, 17579], [65, 17739], [69, 17879], [73, 18019], [81, 18339], [90, 19079], [92, 19259], [95, 19359], [100, 19599], [111, 20419], [115, 20739]]}, {"verse": 3, "start": 21518, "end": 34781, "text": "Entonces María tomó una libra de perfume de nardo líquido de mucho precio, y ungió los pies de Jesús, y limpió sus pies con sus cabellos: y la casa se llenó del olor del perfume.", "words": [[0, 21518], [9, 22317], [15, 22697], [20, 23177], [24, 23337], [30, 23737], [33, 23877], [41, 24237], [44, 24517], [50, 24917], [58, 25517], [61, 25677], [67, 25917], [75, 26477], [77, 27157], [83, 27617], [87, 27797], [92, 28017], [95, 28177], [102, 28577], [104, 28862], [111, 29462], [115, 29682], [120, 29962], [124, 30282], [128, 30482], [138, 31550], [140, 31676], [143, 31796], [148, 32116], [151, 32376], [157, 32836], [161, 33176], [166, 33736], [170, 33916]]}, {"verse": 4, "start": 35131, "end": 42126, "text": "Y dijo uno de sus discípulos, Judas Iscariote, hijo de Simón, el que le había de entregar:", "words": [[0, 35131], [2, 35387], [7, 35667], [11, 36027], [14, 36187], [18, 36387], [30, 37447], [36, 37807], [47, 39067], [52, 39327], [55, 39527], [62, 40407], [65, 40587], [69, 40747], [72, 40907], [78, 41107], [81, 41347]]}, {"verse": 5, "start": 42326, "end": 46700, "text": "¿Por qué no se ha vendido este perfume por trescientos denarios, y se dio a los pobres?", "words": [[0, 42326], [5, 42450], [9, 42610], [12, 42750], [15, 42890], [18, 43010], [26, 43430], [31, 43590], [39, 44010], [43, 44320], [55, 44630], [65, 45290], [67, 45530], [70, 45670], [74, 45850], [76, 45930], [80, 46030]]}, {"verse": 6, "start": 46980, "end": 56087, "text": "Pero dijo esto, no por el cuidado que él tenía de los pobres; sino porque era ladrón, y tenía la bolsa, y traía lo que se echaba en ella.", "words": [[0, 46980], [5, 47142], [10, 47442], [16, 47742], [19, 47982], [23, 48222], [26, 48382], [34, 48742], [38, 49042], [41, 49202], [47, 49502], [50, 49662], [54, 49782], [62, 50839], [67, 51144], [74, 51524], [78, 51784], [86, 52404], [88, 52924], [94, 53184], [97, 53384], [104, 53884], [106, 53984], [112, 54464], [115, 54664], [119, 54804], [122, 54984], [129, 55364], [132, 55584]]}, {"verse": 7, "start": 56437, "end": 62633, "text": "Entonces Jesús dijo: Déjala: para el día de mi sepultura ha guardado esto;", "words": [[0, 56437], [9, 57102], [15, 57602], [21, 58563], [29, 59462], [34, 59649], [37, 59789], [41, 60049], [44, 60229], [47, 60369], [57, 61029], [60, 61369], [69, 62029]]}, {"verse": 8, "start": 62983, "end": 68377, "text": "Porque a los pobres siempre los tenéis con vosotros, pero a mí no siempre me tenéis.", "words": [[0, 62983], [7, 63205], [9, 63325], [13, 63425], [20, 63985], [28, 64565], [32, 64825], [39, 65185], [43, 65385], [53, 66405], [58, 66705], [60, 66805], [63, 66905], [66, 67045], [74, 67445], [77, 67685]]}, {"verse": 9, "start": 68727, "end": 81249, "text": "Entonces mucha gente de los judíos entendió que él estaba allí; y vinieron no solamente por causa de Jesús, sino también por ver a Lázaro, al cual había resucitado de los muertos.", "words": [[0, 68727], [9, 69547], [15, 69887], [21, 70287], [24, 70487], [28, 70607], [35, 71087], [44, 71647], [48, 71827], [51, 72007], [58, 72307], [64, 73125], [66, 73233], [75, 73673], [78, 74173], [88, 74553], [92, 74993], [98, 75333], [101, 75573], [108, 76253], [113, 76513], [121, 76893], [125, 77193], [129, 77660], [131, 78126], [139, 78593], [142, 78693], [147, 78913], [153, 79313], [164, 80213], [167, 80373], [171, 80473]]}, {"verse": 10, "start": 81599, "end": 86305, "text": "Planearon asimismo los principales sacerdotes matar también a Lázaro;", "words": [[0, 81599], [10, 82183], [19, 82803], [23, 83003], [35, 83783], [46, 84503], [52, 84843], [60, 85355], [62, 85867]]}, {"verse": 11, "start": 86655, "end": 91281, "text": "Porque muchos de los judíos iban y creían en Jesús por causa de él.", "words": [[0, 86655], [7, 86996], [14, 87396], [17, 87596], [21, 87716], [28, 88276], [33, 88676], [35, 88816], [42, 89316], [45, 89456], [51, 89896], [55, 90301], [61, 90661], [64, 91001]]}, {"verse": 12, "start": 91631, "end": 98314, "text": "El siguiente día, mucha gente que había venido a la fiesta, cuando oyeron que Jesús venía a Jerusalén,", "words": [[0, 91631], [3, 91778], [13, 92078], [18, 92478], [24, 92798], [30, 93218], [34, 93418], [40, 93638], [47, 94098], [49, 94178], [52, 94238], [60, 95118], [67, 95578], [74, 96098], [78, 96198], [84, 96478], [90, 97238], [92, 97418]]}, {"verse": 13, "start": 98664, "end": 107976, "text": "Tomaron ramas de palmas, y salieron a recibirle, y clamaban: ¡Hosanna, Bendito el que viene en el nombre del Señor, el Rey de Israel!", "words": [[0, 98664], [8, 99027], [14, 99607], [17, 99707], [25, 100387], [27, 100747], [36, 101227], [38, 101387], [49, 102127], [51, 102627], [61, 103827], [71, 104087], [79, 104667], [82, 104767], [86, 104887], [92, 105187], [95, 105387], [98, 105507], [105, 105787], [109, 105987], [116, 106927], [119, 107027], [123, 107307], [126, 107367]]}, {"verse": 14, "start": 108256, "end": 112396, "text": "Y halló Jesús un asnillo, y se sentó sobre él, como está escrito:", "words": [[0, 108256], [2, 108402], [8, 108702], [14, 109022], [17, 109442], [26, 110022], [28, 110267], [31, 110367], [37, 110787], [43, 111067], [47, 111347], [52, 111607], [57, 111787]]}, {"verse": 15, "start": 112746, "end": 118373, "text": "No temas, hija de Sion: he aquí tu Rey viene, sentado sobre un pollino de asna.", "words": [[0, 112746], [3, 112871], [10, 113151], [15, 113591], [18, 113651], [24, 114546], [27, 114626], [32, 114826], [35, 115046], [39, 115426], [46, 116106], [54, 116666], [60, 116906], [63, 117126], [71, 117606], [74, 117766]]}, {"verse": 16, "start": 118723, "end": 131139, "text": "Estas cosas no las entendieron sus discípulos al principio: pero cuando Jesús fue glorificado, entonces se acordaron de que estas cosas estaban escritas de él, y que le hicieron estas cosas.", "words": [[0, 118723], [6, 119163], [12, 119363], [15, 119683], [19, 119863], [31, 120583], [35, 120823], [46, 121463], [49, 121663], [60, 122785], [65, 122909], [72, 123169], [78, 123489], [82, 123789], [95, 124949], [104, 125289], [107, 125669], [117, 126229], [120, 126429], [124, 126529], [130, 126729], [136, 127169], [144, 127609], [153, 128269], [156, 128449], [160, 128789], [162, 129269], [166, 129409], [169, 129549], [178, 130109], [184, 130329]]}, {"verse": 17, "start": 131489, "end": 140312, "text": "Y la gente que estaba con él, daba testimonio de cuando llamó a Lázaro del sepulcro, y le resucitó de los muertos.", "words": [[0, 131489], [2, 131593], [5, 131693], [11, 131993], [15, 132193], [22, 132413], [26, 132713], [30, 133373], [35, 133933], [46, 134713], [49, 134833], [56, 135073], [62, 135526], [64, 135980], [71, 136433], [75, 136633], [85, 137573], [87, 138213], [90, 138393], [99, 139273], [102, 139333], [106, 139473]]}, {"verse": 18, "start": 140662, "end": 147282, "text": "Por lo cual también había venido la gente a recibirle, porque había oído que él había hecho esta señal;", "words": [[0, 140662], [4, 140805], [7, 140965], [12, 141225], [20, 141525], [26, 141925], [33, 142405], [36, 142545], [42, 142825], [44, 142985], [55, 143805], [62, 144365], [68, 144745], [73, 145225], [77, 145485], [80, 145685], [86, 145945], [92, 146285], [97, 146565]]}, {"verse": 19, "start": 147632, "end": 153590, "text": "Pero los fariseos dijeron entre sí: ¿Veis que nada aprovecháis? he aquí, el mundo se va tras de él.", "words": [[0, 147632], [5, 147775], [9, 147975], [18, 148655], [26, 149195], [32, 149475], [36, 150207], [42, 150450], [46, 150530], [51, 150710], [64, 151843], [67, 151923], [73, 152143], [76, 152323], [82, 152543], [85, 152743], [88, 152923], [93, 153103], [96, 153363]]}, {"verse": 20, "start": 153870, "end": 158877, "text": "Y había ciertos griegos de los que habían subido a adorar en la fiesta:", "words": [[0, 153870], [2, 153998], [8, 154218], [16, 154958], [24, 155558], [27, 155738], [31, 155838], [35, 155978], [42, 156238], [49, 156798], [51, 156978], [58, 157618], [61, 157938], [64, 158098]]}, {"verse": 21, "start": 159227, "end": 167964, "text": "Estos pues, se llegaron a Felipe, que era de Betsaida de Galilea, y le rogaron, diciendo: Señor, querríamos ver a Jesús.", "words": [[0, 159227], [6, 159610], [12, 160250], [15, 160390], [24, 160830], [26, 160930], [34, 161390], [38, 161670], [42, 161830], [45, 162260], [54, 162690], [57, 162770], [66, 163810], [68, 163850], [71, 163990], [80, 164770], [90, 165951], [97, 166755], [108, 167095], [112, 167355], [114, 167435]]}, {"verse": 22, "start": 168244, "end": 173849, "text": "Vino Felipe, y lo dijo a Andrés: Andrés entonces, y Felipe, lo dicen a Jesús.", "words": [[0, 168244], [5, 168510], [13, 168930], [15, 169210], [18, 169290], [23, 169410], [25, 169530], [33, 170529], [40, 170914], [50, 171454], [52, 171879], [60, 172339], [63, 172919], [69, 173239], [71, 173419]]}, {"verse": 23, "start": 174199, "end": 181700, "text": "Entonces Jesús les respondió, diciendo: La hora viene en que el Hijo del hombre ha de ser glorificado.", "words": [[0, 174199], [9, 174663], [15, 175203], [19, 175623], [30, 176283], [40, 177303], [43, 177533], [48, 177813], [54, 178173], [57, 178573], [61, 178753], [64, 178953], [69, 179213], [73, 179393], [80, 179753], [83, 180053], [86, 180233], [90, 180473]]}, {"verse": 24, "start": 182050, "end": 192064, "text": "De cierto, de cierto os digo, que si el grano de trigo no cae en la tierra y muere, él solo queda; pero si muere, lleva mucho fruto.", "words": [[0, 182281], [3, 182545], [11, 182809], [14, 183073], [21, 183337], [24, 183517], [30, 183777], [34, 184017], [37, 184237], [40, 184437], [46, 184817], [49, 184957], [55, 185397], [58, 185637], [62, 186157], [65, 186377], [68, 186537], [75, 186997], [77, 187337], [84, 187737], [87, 188037], [92, 188357], [99, 189280], [104, 189444], [107, 190084], [114, 190724], [120, 190924], [126, 191304]]}, {"verse": 25, "start": 192414, "end": 199718, "text": "El que ama su vida, la perderá; y el que aborrece su vida en este mundo, para vida eterna la guardará.", "words": [[0, 192414], [3, 192567], [7, 192727], [11, 192947], [14, 193167], [20, 193567], [23, 193892], [32, 194884], [34, 195215], [37, 195335], [41, 195475], [50, 195975], [53, 196195], [58, 196515], [61, 196635], [66, 196835], [73, 197275], [78, 197855], [83, 198075], [90, 198675], [93, 198935]]}, {"verse": 26, "start": 200068, "end": 209109, "text": "Si alguno me sirve, sígame: y donde yo esté, allí también estará mi servidor. Si alguno me sirve, mi Padre le honrará.", "words": [[0, 200068], [3, 200250], [10, 200670], [13, 200790], [20, 201428], [28, 202285], [30, 202389], [36, 202589], [39, 202889], [45, 203769], [50, 204009], [58, 204429], [65, 204909], [68, 205009], [78, 205983], [81, 206147], [88, 206587], [91, 206687], [98, 207547], [101, 207647], [107, 208007], [110, 208587]]}, {"verse": 27, "start": 209459, "end": 217694, "text": "Ahora está turbada mi alma; ¿y qué diré? Padre, sálvame de esta hora. Pero por esto he venido en esta hora.", "words": [[0, 209459], [6, 209899], [11, 210139], [19, 210639], [22, 210819], [28, 211545], [31, 211710], [35, 211850], [41, 213390], [48, 213715], [56, 214040], [59, 214365], [64, 214625], [70, 215464], [75, 215609], [79, 215829], [84, 216129], [87, 216449], [94, 216849], [97, 216969], [102, 217189]]}, {"verse": 28, "start": 218044, "end": 226583, "text": "Padre, glorifica tu nombre. Entonces vino una voz del cielo: Y lo he glorificado, y lo glorificaré otra vez.", "words": [[0, 218044], [7, 218508], [17, 219108], [20, 219308], [28, 220170], [37, 220914], [42, 221754], [46, 222074], [50, 222314], [54, 222474], [61, 223393], [63, 223532], [66, 223652], [69, 223812], [82, 224672], [84, 224807], [87, 224907], [99, 225607], [104, 225807]]}, {"verse": 29, "start": 226863, "end": 234421, "text": "Y la gente que estaba presente, y había oído, decía que había sido trueno. Otros decían: Ángel le ha hablado.", "words": [[0, 226863], [2, 226963], [5, 227043], [11, 227363], [15, 227543], [22, 227783], [32, 228303], [34, 228483], [40, 228643], [46, 229043], [52, 229803], [56, 230163], [62, 230383], [67, 230703], [75, 231634], [81, 232023], [89, 233153], [95, 233593], [98, 233753], [101, 233893]]}, {"verse": 30, "start": 234701, "end": 240505, "text": "Respondió Jesús, y dijo: No ha venido esta voz por mi causa, sino por causa de vosotros.", "words": [[0, 234701], [10, 235258], [17, 235678], [19, 235978], [25, 236689], [28, 236855], [31, 236995], [38, 237335], [43, 237575], [47, 237815], [51, 238075], [54, 238215], [61, 238715], [66, 238935], [70, 239195], [76, 239555], [79, 239835]]}, {"verse": 31, "start": 240855, "end": 246438, "text": "Ahora es el juicio de este mundo: ahora el príncipe de este mundo será echado fuera.", "words": [[0, 240855], [6, 241225], [9, 241385], [12, 241445], [19, 241905], [22, 242045], [27, 242205], [34, 242998], [40, 243288], [43, 243488], [52, 244408], [55, 244588], [60, 244788], [66, 245068], [71, 245408], [78, 245828]]}, {"verse": 32, "start": 246788, "end": 251117, "text": "Y yo, si soy levantado de la tierra, a todos traeré a mí mismo.", "words": [[0, 246788], [2, 246929], [6, 247089], [9, 247249], [13, 247469], [23, 248129], [26, 248269], [29, 248389], [37, 249089], [39, 249329], [45, 249629], [52, 250409], [54, 250449], [57, 250569]]}, {"verse": 33, "start": 251467, "end": 254698, "text": "Y esto decía dando a entender de qué muerte había de morir.", "words": [[0, 251467], [2, 251592], [7, 251792], [13, 252172], [19, 252472], [21, 252592], [30, 252952], [33, 253212], [37, 253352], [44, 253672], [50, 253972], [53, 254172]]}, {"verse": 34, "start": 255048, "end": 266060, "text": "Le respondió la gente: Nosotros hemos oído de la ley, que el Cristo permanece para siempre: ¿cómo pues dices tú: Conviene que el Hijo del hombre sea levantado? ¿Quién es este Hijo del hombre?", "words": [[0, 255048], [3, 255157], [13, 255737], [16, 255857], [23, 256711], [32, 257095], [38, 257335], [43, 257695], [46, 257835], [49, 257955], [54, 258215], [58, 258635], [61, 258755], [68, 259055], [78, 259615], [83, 259835], [92, 260678], [98, 260882], [103, 261282], [109, 261742], [113, 262366], [122, 262724], [126, 262884], [129, 263004], [134, 263184], [138, 263324], [145, 263524], [149, 263764], [160, 264710], [167, 264887], [170, 265007], [175, 265227], [180, 265407], [184, 265587]]}, {"verse": 35, "start": 266340, "end": 281579, "text": "Entonces Jesús les dice: Aun por un poco estará la luz entre vosotros: andad entre tanto que tenéis luz, porque no os sorprendan las tinieblas; porque el que anda en tinieblas, no sabe dónde va.", "words": [[0, 266340], [9, 267364], [15, 267824], [19, 268324], [25, 269146], [29, 269370], [33, 269670], [36, 269810], [41, 270110], [48, 270650], [51, 270770], [55, 271030], [61, 271350], [71, 272668], [77, 272888], [83, 273248], [89, 273648], [93, 273868], [100, 274288], [105, 275048], [112, 275488], [115, 275668], [118, 275848], [129, 276988], [133, 277188], [144, 278410], [151, 278654], [154, 278814], [158, 278974], [163, 279174], [166, 279354], [177, 280094], [180, 280514], [185, 280774], [191, 281014]]}, {"verse": 36, "start": 281929, "end": 292661, "text": "Entre tanto que tenéis la luz, creed en la luz, para que seáis hijos de luz. Estas cosas habló Jesús, y se fue, y se escondió de ellos.", "words": [[0, 281929], [6, 282216], [12, 282576], [16, 282816], [23, 283276], [26, 283496], [31, 284156], [37, 284716], [40, 284956], [43, 285136], [48, 285496], [53, 286056], [57, 286216], [63, 286676], [69, 287196], [72, 287556], [77, 288308], [83, 288596], [89, 289016], [95, 289596], [102, 289976], [104, 290311], [107, 290471], [112, 290731], [114, 291231], [117, 291391], [126, 292071], [129, 292231]]}, {"verse": 37, "start": 293011, "end": 297628, "text": "Pero habiendo hecho delante de ellos tantas señales, no creían en él.", "words": [[0, 293011], [5, 293158], [14, 293558], [20, 293878], [28, 294398], [31, 294578], [37, 294838], [44, 295478], [53, 296138], [56, 296558], [63, 297118], [66, 297338]]}, {"verse": 38, "start": 297978, "end": 307451, "text": "Para que se cumpliese el dicho que dijo el profeta Isaías: ¿Señor, quién ha creído a nuestro dicho? ¿y el brazo del Señor, a quién es revelado?", "words": [[0, 297978], [5, 298139], [9, 298279], [12, 298689], [22, 299099], [25, 299279], [31, 299639], [35, 299839], [40, 300159], [43, 300339], [51, 300939], [59, 302068], [67, 302547], [73, 302747], [76, 302847], [83, 303247], [85, 303367], [93, 303487], [100, 304400], [103, 304527], [106, 304687], [112, 305107], [116, 305287], [123, 305767], [125, 306227], [131, 306447], [134, 306667]]}, {"verse": 39, "start": 307801, "end": 312227, "text": "Por esto no podían creer, porque otra vez dijo Isaías:", "words": [[0, 307801], [4, 307946], [9, 308186], [12, 308406], [19, 308846], [26, 309686], [33, 309906], [38, 310146], [42, 310606], [47, 311121]]}, {"verse": 40, "start": 312577, "end": 323005, "text": "Cegó los ojos de ellos, y endureció su corazón; porque no vean con los ojos, y entiendan de corazón, y se conviertan, y yo los sane.", "words": [[0, 312577], [5, 312982], [9, 313162], [14, 313482], [17, 313762], [24, 314122], [26, 314642], [36, 315382], [39, 315622], [48, 316733], [55, 316915], [58, 317155], [63, 317495], [67, 317635], [71, 317815], [77, 318275], [79, 318715], [89, 319435], [92, 319595], [101, 320115], [103, 320675], [106, 320815], [118, 321655], [120, 322075], [123, 322235], [127, 322375]]}, {"verse": 41, "start": 323355, "end": 327893, "text": "Estas cosas dijo Isaías cuando vio su gloria, y habló de él.", "words": [[0, 323355], [6, 323755], [12, 324075], [17, 324635], [24, 325255], [31, 325735], [35, 326035], [38, 326215], [46, 326735], [48, 326910], [54, 327290], [57, 327470]]}, {"verse": 42, "start": 328243, "end": 339491, "text": "Con todo eso, aun de los dirigentes, muchos creyeron en él; pero por causa de los fariseos no lo confesaban, por no ser echados de la sinagoga.", "words": [[0, 328243], [4, 328387], [9, 328687], [14, 329207], [18, 329507], [21, 329767], [25, 329887], [37, 331267], [44, 331767], [53, 332547], [56, 332707], [60, 333327], [65, 333471], [69, 333731], [75, 334171], [78, 334431], [82, 334571], [91, 335351], [94, 335691], [97, 335831], [109, 336911], [113, 337191], [116, 337371], [120, 337631], [128, 338271], [131, 338491], [134, 338611]]}, {"verse": 43, "start": 339841, "end": 343959, "text": "Porque amaban más la gloria de los hombres que la gloria de Dios.", "words": [[0, 339841], [7, 340088], [14, 340548], [18, 340908], [21, 341328], [28, 341728], [31, 341868], [35, 342008], [43, 342428], [47, 342668], [50, 342808], [57, 343208], [60, 343328]]}, {"verse": 44, "start": 344309, "end": 350751, "text": "Pero Jesús clamó y dijo: El que cree en mí, no cree en mí, sino en el que me envió;", "words": [[0, 344309], [5, 344456], [11, 344876], [17, 345716], [19, 345876], [25, 346589], [28, 346718], [32, 346858], [37, 347158], [40, 347498], [44, 348238], [47, 348338], [52, 348598], [55, 348858], [59, 349258], [64, 349578], [67, 349778], [70, 349898], [74, 350018], [77, 350158]]}, {"verse": 45, "start": 351101, "end": 353774, "text": "Y el que me ve, ve al que me envió.", "words": [[0, 351101], [2, 351242], [5, 351362], [9, 351502], [12, 351642], [16, 352262], [19, 352552], [22, 352842], [26, 352982], [29, 353162]]}, {"verse": 46, "start": 354124, "end": 361055, "text": "Yo la luz he venido al mundo, para que todo aquel que cree en mí no permanezca en tinieblas.", "words": [[0, 354124], [3, 354368], [6, 354688], [10, 354948], [13, 355228], [20, 355608], [23, 355748], [30, 356148], [35, 356688], [39, 356868], [44, 357148], [50, 357608], [54, 357728], [59, 358048], [62, 358408], [65, 358688], [68, 359168], [79, 359968], [82, 360128]]}, {"verse": 47, "start": 361405, "end": 371187, "text": "Y el que oye mis palabras, y no las cree, yo no le juzgo; porque no he venido a juzgar al mundo, sino a salvar al mundo.", "words": [[0, 361405], [2, 361568], [5, 361688], [9, 361888], [13, 362268], [17, 362408], [27, 362948], [29, 363448], [32, 363628], [36, 363808], [42, 364808], [45, 365048], [48, 365228], [51, 365408], [58, 366345], [65, 366745], [68, 367045], [71, 367205], [78, 367585], [80, 367705], [87, 368165], [90, 368445], [97, 369205], [102, 369485], [104, 369805], [111, 370185], [114, 370605]]}, {"verse": 48, "start": 371537, "end": 380522, "text": "El que me rechaza, y no recibe mis palabras, tiene quien le juzgue: la palabra que he hablado, ella le juzgará en el día postrero.", "words": [[0, 371537], [3, 371677], [7, 371817], [10, 371977], [19, 372657], [21, 373377], [24, 373577], [31, 374077], [35, 374237], [45, 374657], [51, 375057], [57, 375357], [60, 375577], [68, 376493], [71, 376795], [79, 377155], [83, 377435], [86, 377555], [95, 378135], [100, 378355], [103, 378535], [111, 379175], [114, 379375], [117, 379515], [121, 379735]]}, {"verse": 49, "start": 380872, "end": 389409, "text": "Porque yo no he hablado de mí mismo: sino que el Padre que me envió, él me dio mandamiento de lo que he de decir, y de lo que he de hablar.", "words": [[0, 380872], [7, 381058], [10, 381278], [13, 381438], [16, 381558], [24, 381938], [27, 382078], [30, 382218], [37, 382985], [42, 383206], [46, 383426], [49, 383586], [55, 383926], [59, 384126], [62, 384306], [69, 384941], [72, 385281], [75, 385461], [79, 385641], [91, 386401], [94, 386641], [97, 386801], [101, 387001], [104, 387141], [107, 387261], [114, 387701], [116, 388086], [119, 388226], [122, 388366], [126, 388546], [129, 388686], [132, 388806]]}, {"verse": 50, "start": 389759, "end": 398254, "text": "Y sé que su mandamiento es vida eterna: así que, lo que yo hablo, como el Padre me lo ha dicho, así hablo.", "words": [[0, 389759], [2, 389984], [5, 390224], [9, 390424], [12, 390624], [24, 391304], [27, 391564], [32, 391804], [40, 392871], [44, 393285], [49, 393525], [52, 393705], [56, 393885], [59, 394105], [66, 395125], [71, 395485], [74, 395665], [80, 396125], [83, 396245], [86, 396385], [89, 396485], [96, 397200], [100, 397460]]}]}