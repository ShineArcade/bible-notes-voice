{"book": "PSA", "chapter": 85, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 83031, "verses": [{"verse": 1, "start": 300, "end": 9577, "text": "Al Músico principal: Salmo para los hijos de Coré. FUISTE propicio a tu tierra, oh Jehová: volviste la cautividad de Jacob.", "words": [[0, 300], [3, 514], [10, 974], [21, 2098], [27, 2578], [32, 2798], [36, 2998], [42, 3278], [45, 3518], [51, 4263], [58, 4681], [67, 5521], [69, 5681], [72, 5801], [80, 6121], [83, 6441], [91, 7259], [100, 7890], [103, 8110], [114, 8810], [117, 9030]]}, {"verse": 2, "start": 10027, "end": 16974, "text": "Perdonaste la iniquidad de tu pueblo; todos los pecados de ellos cubriste. (Selah.)", "words": [[0, 10027], [11, 10692], [14, 11052], [24, 11932], [27, 12152], [30, 12312], [38, 13312], [44, 13597], [48, 14157], [56, 14677], [59, 14857], [65, 15077], [75, 16652]]}, {"verse": 3, "start": 17424, "end": 21544, "text": "Dejaste toda tu saña: te volviste de la ira de tu furor.", "words": [[0, 17424], [8, 17952], [13, 18272], [16, 18532], [22, 19447], [25, 19532], [34, 19972], [37, 20152], [40, 20292], [44, 20632], [47, 20752], [50, 20912]]}, {"verse": 4, "start": 21994, "end": 28109, "text": "Vuélvenos, oh Dios de nuestra salvación, y haz cesar tu ira de sobre nosotros.", "words": [[0, 21994], [11, 22918], [14, 23178], [19, 23918], [22, 24018], [30, 24198], [41, 25118], [43, 25505], [47, 25891], [53, 26278], [56, 26498], [60, 26718], [63, 26858], [69, 27178]]}, {"verse": 5, "start": 28559, "end": 35492, "text": "¿Estarás enojado contra nosotros para siempre? ¿extenderás tu ira de generación en generación?", "words": [[0, 28559], [9, 29066], [17, 29726], [24, 30046], [33, 30426], [38, 30786], [47, 31833], [59, 32840], [62, 33040], [66, 33320], [69, 33440], [80, 34220], [83, 34460]]}, {"verse": 6, "start": 35942, "end": 39858, "text": "¿No volverás tú a darnos vida, y tu pueblo se alegrará en ti?", "words": [[0, 35942], [4, 36090], [13, 36650], [16, 36810], [1