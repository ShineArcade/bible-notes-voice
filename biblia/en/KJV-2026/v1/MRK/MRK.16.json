{"book": "MRK", "chapter": 16, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 139783, "verses": [{"verse": 1, "start": 300, "end": 10181, "text": "And when the sabbath was past, Mary Magdalene, and Mary the mother of James, and Salome, had bought sweet spices, that they might come and anoint him.", "words": [[0, 300], [4, 443], [9, 643], [13, 823], [21, 1143], [25, 1623], [31, 2103], [36, 2523], [47, 3303], [51, 3503], [56, 3763], [60, 3943], [67, 4183], [70, 4423], [77, 4863], [81, 5483], [89, 6103], [93, 6663], [100, 6923], [106, 7283], [114, 7863], [119, 8423], [124, 8603], [130, 8823], [135, 9143], [139, 9383], [146, 9723]]}, {"verse": 2, "start": 10631, "end": 15986, "text": "And very early in the morning the first day of the week, they came to the tomb at the rising of the sun.", "words": [[0, 10631], [4, 10758], [9, 11018], [15, 11358], [18, 11578], [22, 11658], [30, 12118], [34, 12218], [40, 12458], [44, 12718], [47, 12838], [51, 12938], [57, 13498], [62, 13678], [67, 13938], [70, 14118], [74, 14218], [79, 14498], [82, 14678], [86, 14798], [93, 15158], [96, 15378], [100, 15478]]}, {"verse": 3, "start": 16436, "end": 21748, "text": "And they said among themselves, Who shall roll us away the stone from the door of the tomb?", "words": [[0, 16436], [4, 16561], [9, 16731], [14, 16901], [20, 17161], [32, 18275], [36, 18384], [42, 18604], [47, 18904], [50, 19124], [55, 19354], [59, 19584], [65, 20044], [70, 20324], [74, 20504], [79, 20844], [82, 21044], [86, 21164]]}, {"verse": 4, "start": 22098, "end": 26930, "text": "And when they looked, they saw that the stone was rolled away: for it was very great.", "words": [[0, 22098], [4, 22222], [9, 22362], [14, 22562], [22, 23122], [27, 23262], [31, 23542], [36, 23702], [40, 23842], [46, 24162], [50, 24382], [57, 24642], [63, 25558], [67, 25711], [70, 25851], [74, 26011], [79, 26311]]}, {"verse": 5, "start": 27380, "end": 35110, "text": "And entering into the tomb, they saw a young man sitting on the right side, clothed in a long white garment; and they were affrighted.", "words": [[0, 27380], [4, 27540], [13, 27960], [18, 28260], [22, 28400], [28, 29240], [33, 29340], [37, 29600], [39, 29740], [45, 29940], [49, 30280], [57, 30620], [60, 30840], [64, 30940], [70, 31140], [76, 31780], [84, 32440], [87, 32540], [89, 32680], [94, 32920], [100, 33140], [109, 34093], [113, 34221], [118, 34341], [123, 34521]]}, {"verse": 6, "start": 35560, "end": 44394, "text": "And he says to them, Be not affrighted: You seek Jesus of Nazareth, which was crucified: he is risen; he is not here: behold the place where they laid him.", "words": [[0, 35560], [4, 35709], [7, 35789], [12, 35969], [15, 36169], [21, 36740], [24, 36891], [28, 37071], [40, 37996], [44, 38119], [49, 38319], [55, 38699], [58, 38899], [68, 39339], [74, 39539], [78, 39699], [89, 40629], [92, 40769], [95, 40909], [102, 41678], [105, 41772], [108, 41892], [112, 42052], [118, 42820], [125, 43178], [129, 43358], [135, 43558], [141, 43738], [146, 43878], [151, 44058]]}, {"verse": 7, "start": 44844, "end": 52025, "text": "But go your way, tell his disciples and Peter that he goes before you into Galilee: there shall you see him, as he said to you.", "words": [[0, 44844], [4, 45019], [7, 45199], [12, 45399], [17, 46159], [22, 46479], [26, 46679], [36, 47219], [40, 47439], [46, 47699], [51, 48079], [54, 48219], [59, 48459], [66, 48819], [70, 49019], [75, 49299], [84, 50239], [90, 50463], [96, 50683], [100, 50843], [104, 51003], [109, 51203], [112, 51343], [115, 51463], [120, 51643], [123, 51823]]}, {"verse": 8, "start": 52375, "end": 60846, "text": "And they went out quickly, and fled from the tomb; for they trembled and were amazed: neither said they any thing to any man; for they were afraid.", "words": [[0, 52375], [4, 52528], [9, 52628], [14, 52808], [18, 52948], [27, 53348], [31, 53728], [36, 53948], [41, 54168], [45, 54288], [51, 55080], [55, 55168], [60, 55308], [69, 55968], [73, 56148], [78, 56308