{"book": "PSA", "chapter": 108, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 84931, "verses": [{"verse": 1, "start": 300, "end": 9416, "text": "Canción: Salmo de David. MI corazón está dispuesto, oh Dios; cantaré y salmearé todavía en mi gloria.", "words": [[0, 300], [9, 1527], [15, 1949], [18, 2129], [25, 2986], [28, 3114], [36, 3554], [41, 4134], [52, 4215], [55, 4296], [61, 5982], [69, 6762], [71, 7002], [80, 7722], [88, 8142], [91, 8579], [94, 9016]]}, {"verse": 2, "start": 9866, "end": 14235, "text": "Despiértate, salterio y arpa: despertaré al alba.", "words": [[0, 10304], [13, 10784], [22, 11484], [24, 11684], [30, 12691], [41, 13458], [44, 13618]]}, {"verse": 3, "start": 14685, "end": 20271, "text": "Te alabaré, oh Jehová, entre los pueblos; a ti cantaré salmos entre las naciones.", "words": [[0, 14685], [3, 14897], [12, 15143], [15, 15390], [23, 15950], [29, 16290], [33, 16510], [42, 17540], [44, 17722], [47, 17842], [55, 18362], [62, 18882], [68, 19202], [72, 19442]]}, {"verse": 4, "start": 20721, "end": 26109, "text": "Porque grande más que los cielos es tu misericordia, y hasta los cielos tu verdad.", "words": [[0, 20721], [7, 21241], [14, 21501], [18, 21801], [22, 22001], [26, 22181], [33, 22501], [36, 22821], [39, 22981], [53, 23961], [55, 24321], [61, 24521], [65, 24741], [72, 25200], [75, 25658]]}, {"verse": 5, "start": 26559, "end": 32189, "text": "Ensálzate, oh Dios, sobre los cielos; y sobre toda la tierra tu gloria.", "words": [[0, 26885], [11, 27245], [14, 27605], [20, 27965], [26, 28465], [30, 28705], [38, 29778], [40, 29923], [46, 30103], [51, 30523], [54, 30803], [61, 31143], [64, 31463]]}, {"verse": 6, "start": 32639, "end": 37885, "text": "Para que sean librados tus amados, salva con tu diestra y respóndeme.", "words": [[0, 32639], [5, 32803], [9, 32943], [14, 33323], [23, 34303], [27, 34483], [35, 35483], [41, 36023], [45, 36243], [48, 36423], [56, 36863], [58, 37023]]}, {"verse": 7, "start": 38335,