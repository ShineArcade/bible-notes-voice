, [90, 190232], [98, 190752], [104, 191032], [109, 191459], [120, 191885], [123, 192312]]}, {"verse": 28, "start": 193350, "end": 199504, "text": "Y lo de origen humilde del mundo y lo menospreciado escogió Dios, y lo que no es, para deshacer lo que es:", "words": [[0, 193350], [2, 193470], [5, 193590], [8, 193710], [15, 194070], [23, 194390], [27, 194590], [33, 194870], [35, 195010], [38, 195130], [52, 195890], [60, 196390], [66, 197170], [68, 197250], [71, 197390], [75, 197510], [78, 197710], [82, 197970], [87, 198250], [96, 198830], [99, 198990], [103, 199130]]}, {"verse": 29, "start": 199954, "end": 203057, "text": "Para que ninguna carne se jacte en su presencia.", "words": [[0, 199954], [5, 200097], [9, 200257], [17, 200557], [23, 200957], [26, 201247], [32, 201537], [35, 201577], [38, 201717]]}, {"verse": 30, "start": 203507, "end": 212279, "text": "Pero de él sois vosotros en Cristo Jesús, el cual nos ha sido hecho por Dios sabiduría, y justificación, y santificación, y redención:", "words": [[0, 203507], [5, 203664], [8, 203824], [11, 204024], [16, 204344], [25, 204844], [28, 205084], [35, 205404], [42, 206324], [45, 206384], [50, 206604], [54, 206844], [57, 207004], [62, 207264], [68, 207544], [72, 207764], [77, 207984], [88, 208784], [90, 209124], [105, 210064], [107, 210424], [122, 211244], [124, 211544]]}, {"verse": 31, "start": 212729, "end": 217284, "text": "Para que, como está escrito: El que se gloría, gloríese en el Señor.", "words": [[0, 212729], [5, 212913], [10, 213253], [15, 213413], [20, 213653], [29, 214586], [32, 214726], [36, 214866], [39, 215006], [47, 215786], [56, 216406], [59, 216626], [62, 216766]]}]}