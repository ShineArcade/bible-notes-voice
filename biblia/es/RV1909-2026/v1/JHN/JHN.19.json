{"book": "JHN", "chapter": 19, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 405864, "verses": [{"verse": 1, "start": 300, "end": 4431, "text": "Así que, entonces tomó Pilato a Jesús, y le azotó.", "words": [[0, 300], [4, 536], [9, 756], [18, 1276], [23, 2116], [30, 2556], [32, 2716], [39, 3056], [41, 3756], [44, 4124]]}, {"verse": 2, "start": 4881, "end": 12858, "text": "Y los soldados entretejieron de espinas una corona, y la pusieron sobre su cabeza, y le vistieron de una ropa de grana;", "words": [[0, 4881], [2, 4987], [6, 5107], [15, 5747], [29, 6647], [32, 6827], [40, 7307], [44, 7627], [52, 8147], [54, 8687], [57, 8787], [66, 9247], [72, 9547], [75, 9767], [83, 10227], [85, 10727], [88, 11077], [98, 11427], [101, 11627], [105, 11787], [110, 12207], [113, 12327]]}, {"verse": 3, "start": 13308, "end": 18014, "text": "Y decían: ¡Salve, Rey de los judíos! y le daban bofetadas.", "words": [[0, 13308], [2, 13435], [10, 14319], [18, 14744], [22, 15044], [25, 15144], [29, 15264], [37, 16396], [39, 16519], [42, 16639], [48, 16999]]}, {"verse": 4, "start": 18464, "end": 26407, "text": "Entonces Pilato salió otra vez fuera, y les dijo: He aquí, os le traigo fuera, para que entendáis que ningún crimen hallo en él.", "words": [[0, 18464], [9, 19051], [16, 19931], [22, 20411], [27, 20691], [31, 21011], [38, 21451], [40, 21751], [44, 22051], [50, 22795], [53, 22795], [59, 23038], [62, 23258], [65, 23378], [72, 23678], [79, 23978], [84, 24358], [88, 24518], [98, 24998], [102, 25138], [109, 25418], [116, 25748], [122, 26078], [125, 26178]]}, {"verse": 5, "start": 26757, "end": 34486, "text": "Y salió Jesús fuera, llevando la corona de espinas y la ropa de grana. Y les dice Pilato: He aquí el hombre.", "words": [[0, 26757], [2, 26883], [8, 27183], [14, 27423], [21, 28383], [30, 29063], [33, 29243], [40, 29563], [43, 29843], [51, 30383], [53, 30583], [56, 30703], [61, 31083], [64, 31203], [71, 32081], [73, 32269], [77, 32349], [82, 32549], [90, 33557], [93, 33637], [98, 33857], [101, 34017]]}, {"verse": 6, "start": 34836, "end": 53170, "text": "Y como le vieron los principales sacerdotes y los guardias, dieron voces diciendo: Crucifícale, crucifícale. Les dice Pilato: Tomadle vosotros, y crucificadle; porque yo no hallo en él crimen.", "words": [[0, 34836], [2, 34958], [7, 35198], [10, 35358], [17, 35698], [21, 35858], [33, 36658], [44, 37558], [46, 37718], [50, 37878], [60, 38818], [67, 39338], [73, 39798], [83, 40870], [96, 41729], [109, 47759], [113, 47887], [118, 48107], [126, 49074], [134, 49534], [144, 50074], [146, 50294], [160, 51474], [167, 51662], [170, 51882], [173, 52142], [179, 52402], [182, 52542], [185, 52682]]}, {"verse": 7, "start": 53520, "end": 61455, "text": "Le respondieron los judíos: Nosotros tenemos ley, y según nuestra ley debe morir, porque se hizo Hijo de Dios.", "words": [[0, 53520], [3, 53666], [16, 54486], [20, 54726], [28, 55848], [37, 56253], [45, 56673], [50, 57153], [52, 57433], [58, 57713], [66, 57993], [70, 58413], [75, 58653], [82, 59413], [89, 59733], [92, 60033], [97, 60433], [102, 60753], [105, 60953]]}, {"verse": 8, "start": 61805, "end": 65192, "text": "Y como Pilato oyó esta palabra, tuvo más miedo.", "words": [[0, 61805], [2, 61932], [7, 62192], [14, 62772], [18, 63172], [23, 63332], [32, 63832], [37, 64152], [41, 64512]]}, {"verse": 9, "start": 65642, "end": 75292, "text": "Y entró otra vez en el pretorio, y dijo a Jesús: ¿De dónde eres tú? Pero Jesús no le dio respuesta.", "words": [[0, 65642], [2, 65766], [8, 66146], [13, 66426], [17, 66726], [20, 66886], [23, 67026], [33, 67666], [35, 67766], [40, 68006], [42, 68146], [49, 69047], [53, 69190], [59, 69370], [64, 69710], [68, 73070], [73, 73214], [79, 73534], [82, 74014], [85, 74174], [89, 74354]]}, {"verse": 10, "start": 75742, "end": 84126, "text": "Entonces le dice Pilato: ¿A mí no me hablas? ¿no sabes que tengo autoridad para crucificarte, y que tengo autoridad para soltarte?", "words": [[0, 75742], [9, 76206], [12, 76806], [17, 77066], [25, 78036], [28, 78158], [31, 78278], [34, 78378], [37, 78518], [45, 79373], [49, 79481], [55, 79741], [59, 79941], [65, 80221], [75, 80781], [80, 81021], [94, 81881], [96, 82261], [100, 82361], [106, 82621], [116, 83161], [121, 83671]]}, {"verse": 11, "start": 84476, "end": 95682, "text": "Respondió Jesús: Ninguna autoridad tendrías contra mí, si no te fuese dada de arriba: por tanto, el que a ti me ha entregado, mayor pecado tiene.", "words": [[0, 84723], [10, 85003], [17, 85973], [25, 86625], [35, 87485], [44, 88125], [51, 88485], [55, 88785], [58, 89225], [61, 89365], [64, 89505], [70, 89845], [75, 90205], [78, 90639], [86, 91311], [90, 91438], [97, 91838], [100, 92478], [104, 92658], [106, 92818], [109, 92938], [112, 93138], [115, 93278], [126, 93998], [132, 94538], [139, 95058]]}, {"verse": 12, "start": 96132, "end": 109737, "text": "Desde entonces procuraba Pilato soltarle; pero los judíos daban voces, diciendo: Si a este sueltas, no eres amigo de César: cualquiera que se hace rey, a César contradice.", "words": [[0, 96132], [6, 96374], [15, 97054], [25, 97974], [32, 98494], [42, 99720], [47, 99864], [51, 100044], [58, 100504], [64, 100744], [71, 101544], [81, 102542], [84, 102681], [86, 102988], [91, 103294], [100, 103601], [103, 103921], [108, 104161], [114, 104501], [117, 104721], [124, 105533], [135, 105917], [139, 106077], [142, 106217], [147, 106457], [152, 106797], [154, 107137], [160, 107477]]}, {"verse": 13, "start": 110087, "end": 120498, "text": "Entonces Pilato, oyendo este dicho, llevó fuera a Jesús, y se sentó en el tribunal en el lugar que se dice Lithóstrotos, y en hebreo Gabata.", "words": [[0, 110087], [9, 110534], [17, 111214], [24, 111574], [29, 111754], [36, 112364], [42, 112974], [48, 113374], [50, 113614], [57, 113994], [59, 114614], [62, 114754], [68, 115254], [71, 115374], [74, 115494], [83, 116094], [86, 116274], [89, 116414], [95, 116814], [99, 117034], [102, 117194], [107, 118024], [121, 118854], [123, 119034], [126, 119547], [133, 120059]]}, {"verse": 14, "start": 120948, "end": 132282, "text": "Y era la víspera de la Pascua, y como la hora de sexta. Entonces dijo a los judíos: He aquí vuestro Rey.", "words": [[0, 120948], [2, 121128], [6, 121288], [9, 121448], [17, 122048], [20, 122148], [23, 122528], [31, 122908], [33, 123548], [38, 123788], [41, 123988], [46, 124188], [49, 124308], [56, 125330], [65, 125938], [70, 126438], [72, 126638], [76, 126738], [84, 127822], [87, 127902], [92, 128082], [100, 128482]]}, {"verse": 15, "start": 132632, "end": 145296, "text": "Pero ellos dieron voces: Quita, quita, crucifícale. Les dice Pilato: ¿A vuestro Rey he de crucificar? Respondieron los principales sacerdotes: No tenemos rey sino a César.", "words": [[0, 132632], [5, 132797], [11, 133057], [18, 133457], [25, 134532], [32, 134856], [39, 135156], [52, 136347], [56, 136475], [61, 136695], [69, 137662], [72, 137783], [80, 138143], [84, 138463], [87, 138783], [90, 138903], [102, 140474], [115, 140814], [119, 141014], [131, 141814], [143, 143210], [146, 143374], [154, 143714], [158, 144314], [163, 144514], [165, 144854]]}, {"verse": 16, "start": 145646, "end": 153955, "text": "Así que entonces lo entregó a ellos para que fuese crucificado. Y tomaron a Jesús, y le llevaron.", "words": [[0, 145646], [4, 145989], [8, 146169], [17, 146749], [20, 147409], [28, 148049], [30, 148169], [36, 148449], [41, 149169], [45, 149309], [51, 150076], [64, 151085], [66, 151213], [74, 151733], [76, 151933], [83, 152293], [85, 152763], [88, 153233]]}, {"verse": 17, "start": 154405, "end": 160656, "text": "Y llevando su cruz, salió al lugar que se dice de la Calavera, y en hebreo, Gólgota;", "words": [[0, 154405], [2, 154510], [11, 154890], [14, 155110], [20, 155990], [26, 156470], [29, 156590], [35, 156930], [39, 157110], [42, 157290], [47, 157590], [50, 157810], [53, 157950], [63, 158710], [65, 158850], [68, 159010], [76, 159670]]}, {"verse": 18, "start": 161106, "end": 167114, "text": "Donde le crucificaron, y con él otros dos, uno a cada lado, y Jesús en medio.", "words": [[0, 161106], [6, 161311], [9, 161531], [23, 162491], [25, 163051], [29, 163251], [32, 163421], [38, 163591], [43, 163991], [47, 164651], [49, 164951], [54, 165131], [60, 165551], [62, 165871], [68, 166171], [71, 166491]]}, {"verse": 19, "start": 167564, "end": 176336, "text": "Y escribió también Pilato un letrero, que puso encima de la cruz. Y el escrito era: JESÚS NAZARENO, REY DE LOS JUDÍOS.", "words": [[0, 167564], [2, 167691], [11, 168271], [19, 168511], [26, 169091], [29, 169211], [38, 169711], [42, 169851], [47, 170231], [54, 170651], [57, 170851], [60, 170971], [66, 171793], [68, 171920], [71, 172020], [79, 172380], [84, 173221], [90, 173642], [100, 174922], [104, 175362], [107, 175462], [111, 175602]]}, {"verse": 20, "start": 176786, "end": 187633, "text": "Y muchos de los judíos leyeron este letrero: porque el lugar donde estaba crucificado Jesús era cerca de la ciudad: y estaba escrito en hebreo, en griego, y en latín.", "words": [[0, 176786], [2, 176893], [9, 177113], [12, 177273], [16, 177413], [23, 177933], [31, 178613], [36, 178793], [45, 179747], [52, 179969], [55, 180169], [61, 180449], [67, 180709], [74, 181089], [86, 181909], [92, 182189], [96, 182549], [102, 182929], [105, 183189], [108, 183289], [116, 184379], [118, 184634], [125, 184874], [133, 185254], [136, 185514], [144, 186174], [147, 186214], [155, 186674], [157, 186814], [160, 186894]]}, {"verse": 21, "start": 188083, "end": 201558, "text": "Y decían a Pilato los principales sacerdotes de los judíos: No escribas, Rey de los judíos: sino, que él dijo: Rey soy de los judíos.", "words": [[0, 188083], [2, 188386], [9, 188726], [11, 189066], [18, 189406], [22, 189586], [34, 190406], [45, 191126], [48, 191306], [52, 191446], [60, 192477], [63, 192662], [73, 193202], [77, 193522], [80, 193602], [84, 193722], [92, 198002], [98, 198345], [102, 198585], [105, 198765], [111, 199815], [115, 200055], [119, 200415], [122, 200655], [126, 200795]]}, {"verse": 22, "start": 202008, "end": 205437, "text": "Respondió Pilato: Lo que he escrito, he escrito.", "words": [[0, 202272], [10, 202572], [18, 203500], [21, 203601], [25, 203741], [28, 203821], [37, 204721], [40, 204781]]}, {"verse": 23, "start": 205787, "end": 221457, "text": "Y como los soldados hubieron crucificado a Jesús, tomaron sus vestidos, e hicieron cuatro partes (para cada soldado una parte); y la túnica; pero la túnica era sin costura, toda tejida desde arriba.", "words": [[0, 205787], [2, 205887], [7, 206087], [11, 206267], [20, 206807], [29, 207207], [41, 208107], [43, 208227], [50, 209027], [58, 209567], [62, 209847], [72, 210547], [74, 210987], [83, 211567], [90, 211967], [97, 213247], [103, 213547], [108, 213787], [116, 214507], [120, 214827], [128, 215791], [130, 215913], [133, 216013], [141, 217016], [146, 217180], [149, 217360], [156, 217800], [160, 217980], [164, 218200], [173, 219500], [178, 219780], [185, 220360], [191, 220560]]}, {"verse": 24, "start": 221907, "end": 237165, "text": "Y dijeron entre ellos: No la rasguemos, sino echemos suertes sobre ella, de quién será; para que se cumpliese la Escritura, que dice: Partieron para sí mis vestidos, y sobre mi ropa echaron suertes. Y los soldados hicieron esto.", "words": [[0, 221907], [2, 222056], [10, 222576], [16, 222816], [23, 223647], [26, 223824], [29, 223984], [40, 224524], [45, 224824], [53, 225304], [61, 225784], [67, 226104], [73, 226384], [76, 226584], [82, 226764], [88, 227659], [93, 227804], [97, 227964], [100, 228124], [110, 228764], [113, 228924], [124, 229484], [128, 229664], [134, 230479], [144, 230964], [149, 231244], [152, 231504], [156, 231664], [166, 232324], [168, 232684], [174, 232904], [177, 233144], [182, 233584], [190, 233924], [199, 235038], [201, 235162], [205, 235262], [214, 235902], [223, 236582]]}, {"verse": 25, "start": 237615, "end": 246605, "text": "Y estaban junto a la cruz de Jesús su madre, y la hermana de su madre, María mujer de Cleofas, y María Magdalena.", "words": [[0, 237615], [2, 237733], [10, 238053], [16, 238413], [18, 238633], [21, 238693], [26, 239193], [29, 239393], [35, 239733], [38, 240053], [45, 240453], [47, 241113], [50, 241273], [58, 241793], [61, 241953], [64, 242173], [71, 242833], [77, 243173], [83, 243633], [86, 243753], [95, 244513], [97, 245173], [103, 245902]]}, {"verse": 26, "start": 247055, "end": 255997, "text": "Y cuando vio Jesús a la madre, y al discípulo que él amaba, que estaba presente, dice a su madre: Mujer, he ahí tu hijo.", "words": [[0, 247055], [2, 247151], [9, 247391], [13, 247731], [19, 248111], [21, 248451], [24, 248571], [31, 248971], [33, 249211], [36, 249371], [46, 250011], [50, 250211], [53, 250391], [60, 250871], [64, 251311], [71, 251571], [81, 252171], [86, 252671], [88, 252851], [91, 252991], [98, 253902], [105, 254448], [108, 255028], [112, 255228], [115, 255448]]}, {"verse": 27, "start": 256447, "end": 263236, "text": "Después dice al discípulo: He ahí tu madre. Y desde aquella hora el discípulo la recibió consigo.", "words": [[0, 256641], [8, 256867], [13, 257094], [16, 257274], [27, 258397], [30, 258507], [34, 258687], [37, 258807], [44, 259698], [46, 259823], [52, 260023], [60, 260523], [65, 260823], [68, 261003], [78, 261703], [81, 261883], [89, 262503]]}, {"verse": 28, "start": 263686, "end": 271939, "text": "Después de esto, sabiendo Jesús que todas las cosas eran ya cumplidas, para que la Escritura se cumpliese, dijo: Sed tengo.", "words": [[0, 263686], [8, 264065], [11, 264265], [17, 264545], [26, 265105], [32, 265465], [36, 265785], [42, 266125], [46, 266425], [52, 266725], [57, 267085], [60, 267265], [71, 267905], [76, 268465], [80, 268605], [83, 268725], [93, 269245], [96, 269425], [107, 270065], [113, 271059], [117, 271199]]}, {"verse": 29, "start": 272389, "end": 283389, "text": "Y estaba allí un vaso lleno de vinagre: entonces ellos empaparon una esponja en vinagre y, puesta en una rama de hisopo, se la acercaron a la boca.", "words": [[0, 272389], [2, 272507], [9, 272827], [14, 273107], [17, 273267], [22, 273627], [28, 273927], [31, 274047], [40, 275083], [49, 275549], [55, 275969], [65, 277069], [69, 277269], [77, 278009], [80, 278109], [88, 278769], [91, 279209], [98, 279809], [101, 279969], [105, 280129], [110, 280529], [113, 281039], [121, 281549], [124, 281749], [127, 281909], [137, 282609], [139, 282709], [142, 282809]]}, {"verse": 30, "start": 283839, "end": 291824, "text": "Y como Jesús tomó el vinagre, dijo: Consumado es. Y habiendo inclinado la cabeza, dio el espíritu.", "words": [[0, 283839], [2, 283979], [7, 284259], [13, 284639], [18, 285279], [21, 285439], [30, 286059], [36, 286896], [46, 287584], [50, 288435], [52, 288561], [61, 288941], [71, 289581], [74, 289721], [82, 290521], [86, 290761], [89, 291061]]}, {"verse": 31, "start": 292274, "end": 308249, "text": "Entonces los judíos, por cuanto era la víspera de la Pascua, para que los cuerpos no quedasen en la cruz en el sábado, pues era el gran día del sábado, rogaron a Pilato que se les quebrasen las piernas, y fuesen quitados.", "words": [[0, 292274], [9, 292804], [13, 293344], [21, 293944], [25, 294204], [32, 294564], [36, 294904], [39, 295104], [47, 295704], [50, 295804], [53, 295964], [61, 296924], [66, 297064], [70, 297204], [74, 297364], [82, 297924], [85, 298224], [94, 298804], [97, 298944], [100, 299104], [105, 299524], [108, 299724], [111, 299904], [119, 300904], [124, 301004], [128, 301264], [131, 301544], [136, 301804], [140, 302184], [144, 302424], [152, 303685], [160, 304015], [162, 304135], [169, 304555], [173, 304755], [176, 304895], [180, 305255], [190, 305615], [194, 305775], [203, 306435], [205, 306835], [212, 307255]]}, {"verse": 32, "start": 308699, "end": 316051, "text": "Y vinieron los soldados, y quebraron las piernas al primero, y asimismo al otro que había sido crucificado con él.", "words": [[0, 308699], [2, 308825], [11, 309205], [15, 309405], [25, 310165], [27, 310705], [37, 311185], [41, 311345], [49, 311785], [52, 311965], [61, 312345], [63, 312845], [72, 313365], [75, 313545], [80, 313785], [84, 313985], [90, 314165], [95, 314525], [107, 315405], [111, 315665]]}, {"verse": 33, "start": 316501, "end": 321590, "text": "Pero cuando vinieron a Jesús, como le vieron ya muerto, no le quebraron las piernas:", "words": [[0, 316501], [5, 316628], [12, 316868], [21, 317408], [23, 317528], [30, 318188], [35, 318348], [38, 318508], [45, 318788], [48, 318968], [56, 319728], [59, 319868], [62, 320028], [72, 320628], [76, 320808]]}, {"verse": 34, "start": 322040, "end": 328646, "text": "Pero uno de los soldados le abrió el costado con una lanza, y de inmediato salió sangre y agua.", "words": [[0, 322040], [5, 322184], [9, 322404], [12, 322524], [16, 322664], [25, 323264], [28, 323524], [34, 323784], [37, 324044], [45, 324524], [49, 324764], [53, 325004], [60, 325544], [62, 326004], [65, 326164], [75, 326924], [81, 327324], [88, 327764], [90, 328084]]}, {"verse": 35, "start": 329096, "end": 336988, "text": "Y el que lo vio, da testimonio, y su testimonio es verdadero: y él sabe que dice verdad, para que vosotros también creáis.", "words": [[0, 329096], [2, 329210], [5, 329330], [9, 329470], [12, 329630], [17, 329850], [20, 329970], [32, 330830], [34, 330930], [37, 331090], [48, 331950], [51, 332030], [62, 333187], [64, 333467], [67, 333587], [72, 333927], [76, 334147], [81, 334407], [89, 334807], [94, 335187], [98, 335327], [107, 335747], [115, 336107]]}, {"verse": 36, "start": 337438, "end": 343847, "text": "Porque estas cosas fueron hechas para que se cumpliese la Escritura: Hueso no quebrantaréis de él.", "words": [[0, 337438], [7, 337600], [13, 337800], [19, 338320], [26, 338860], [33, 339260], [38, 339480], [42, 339620], [45, 339760], [55, 340300], [58, 340500], [69, 341919], [75, 342319], [78, 342419], [92, 343279], [95, 343479]]}, {"verse": 37, "start": 344297, "end": 348632, "text": "Y también otra Escritura dice: Mirarán al que traspasaron.", "words": [[0, 344297], [2, 344579], [10, 344819], [15, 345159], [25, 345879], [31, 346648], [39, 347253], [42, 347513], [46, 347653]]}, {"verse": 38, "start": 349082, "end": 366970, "text": "Después de estas cosas, José de Arimatea, el cual era discípulo de Jesús, pero secreto por miedo de los judíos, rogó a Pilato que pudiera quitar el cuerpo de Jesús: y Pilato se lo permitió. Entonces vino, y quitó el cuerpo de Jesús.", "words": [[0, 349082], [8, 349345], [11, 349545], [17, 349705], [24, 350825], [29, 351245], [32, 351465], [42, 352705], [45, 352725], [50, 352905], [54, 353165], [64, 353885], [67, 354025], [74, 355025], [79, 355205], [87, 355825], [91, 356045], [97, 356405], [100, 356625], [104, 356745], [112, 357725], [117, 358165], [119, 358305], [126, 358725], [130, 358885], [138, 359265], [145, 359605], [148, 359765], [155, 360065], [158, 360285], [165, 361197], [167, 361320], [174, 361640], [177, 361960], [180, 362120], [190, 363133], [199, 363800], [205, 364560], [207, 364940], [213, 365460], [216, 365680], [223, 366040], [226, 366300]]}, {"verse": 39, "start": 367420, "end": 376113, "text": "Y vino también Nicodemo, el que antes había venido a Jesús de noche, trayendo un compuesto de mirra y de áloes, como cien libras.", "words": [[0, 367420], [2, 367562], [7, 367742], [15, 368182], [25, 369482], [28, 369622], [32, 369762], [38, 370022], [44, 370362], [51, 370742], [53, 370842], [59, 371002], [62, 371242], [69, 371962], [78, 372522], [81, 372762], [91, 373342], [94, 373542], [100, 374042], [102, 374242], [105, 374382], [112, 374862], [117, 375082], [122, 375422]]}, {"verse": 40, "start": 376563, "end": 385760, "text": "Tomaron pues el cuerpo de Jesús, y lo envolvieron en telas de lino con especias aromáticas, como es costumbre de los judíos sepultar.", "words": [[0, 376563], [8, 376907], [13, 377067], [16, 377287], [23, 377587], [26, 377807], [33, 378227], [35, 379047], [38, 379187], [50, 379867], [53, 380087], [59, 380547], [62, 380627], [67, 380967], [71, 381367], [80, 381767], [92, 382567], [97, 383207], [100, 383367], [110, 384067], [113, 384187], [117, 384327], [124, 384847]]}, {"verse": 41, "start": 386210, "end": 396519, "text": "Y en aquel lugar donde había sido crucificado, había un huerto; y en el huerto un sepulcro nuevo, en el cual aún no había sido puesto ninguno.", "words": [[0, 386210], [2, 386501], [5, 386581], [11, 386861], [17, 387141], [23, 387481], [29, 387801], [34, 388591], [47, 389381], [53, 389511], [56, 389641], [64, 390786], [66, 390912], [69, 391032], [72, 391152], [79, 391552], [82, 391892], [91, 392532], [98, 393392], [101, 393712], [104, 393812], [109, 394052], [113, 394432], [116, 394692], [122, 394932], [127, 395332], [134, 395672]]}, {"verse": 42, "start": 396969, "end": 405464, "text": "Allí, pues, por causa de la víspera de la Pascua de los judíos, porque aquel sepulcro estaba cerca, pusieron a Jesús.", "words": [[0, 396969], [6, 397390], [12, 398190], [16, 398430], [22, 398730], [25, 398990], [28, 399090], [36, 399630], [39, 399730], [42, 399850], [49, 400370], [52, 400470], [56, 400610], [64, 401310], [71, 401630], [77, 401950], [86, 402670], [93, 402930], [100, 403430], [109, 404630], [111, 404770]]}]}