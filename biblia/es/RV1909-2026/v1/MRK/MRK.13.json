{"book": "MRK", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 298108, "verses": [{"verse": 1, "start": 300, "end": 7754, "text": "Y saliendo del templo, le dice uno de sus discípulos: Maestro, mira qué piedras, y qué edificios.", "words": [[0, 300], [2, 443], [11, 903], [15, 1143], [23, 2163], [26, 2323], [31, 2623], [35, 3103], [38, 3283], [42, 3483], [54, 4882], [63, 5480], [68, 5600], [72, 5800], [81, 6340], [83, 6700], [87, 6860]]}, {"verse": 2, "start": 8034, "end": 16463, "text": "Y Jesús respondiendo, le dijo: ¿Ves estos grandes edificios? no quedará piedra sobre piedra que no sea derribada.", "words": [[0, 8034], [2, 8142], [8, 8634], [22, 9125], [25, 9617], [31, 10402], [36, 10850], [42, 11290], [50, 11770], [61, 13109], [64, 13279], [72, 13699], [79, 14239], [85, 14519], [92, 15079], [96, 15199], [99, 15379], [103, 15599]]}, {"verse": 3, "start": 16813, "end": 24964, "text": "Y sentándose en el monte de los Olivos delante del templo, le preguntaron aparte Pedro y Jacobo y Juan y Andrés:", "words": [[0, 16813], [2, 16954], [13, 17754], [16, 17954], [19, 18094], [25, 18414], [28, 18634], [32, 18754], [39, 19214], [47, 19694], [51, 19934], [59, 21034], [62, 21174], [74, 21674], [81, 22174], [87, 22714], [89, 23014], [96, 23614], [98, 23774], [103, 24074], [105, 24314]]}, {"verse": 4, "start": 25164, "end": 30599, "text": "Dinos, ¿cuándo serán estas cosas? ¿y qué señal habrá cuando todas estas cosas han de cumplirse?", "words": [[0, 25164], [7, 25399], [15, 25879], [21, 26199], [27, 26379], [34, 27305], [37, 27412], [41, 27552], [47, 28012], [53, 28292], [60, 28452], [66, 28792], [72, 29132], [78, 29532], [82, 29812], [85, 29932]]}, {"verse": 5, "start": 30879, "end": 36281, "text": "Y Jesús respondiéndoles, comenzó a decir: Mirad, que nadie os engañe;", "words": [[0, 30879], [2, 31002], [8, 31402], [25, 32667], [33, 33567], [35, 33667], [42, 34387], [49, 34847], [53, 35207], [59, 35447], [62, 35707]]}, {"verse": 6, "start": 36631, "end": 42649, "text": "Porque vendrán muchos en mi nombre, diciendo: Yo soy el Cristo; y engañarán a muchos.", "words": [[0, 36631], [7, 36815], [15, 37355], [22, 37815], [25, 38115], [28, 38255], [36, 38555], [46, 39575], [49, 39671], [53, 39831], [56, 40051], [64, 40952], [66, 41172], [76, 41892], [78, 41952]]}, {"verse": 7, "start": 42999, "end": 52636, "text": "Pero cuando oigáis de guerras y de rumores de guerras no os turbéis, porque conviene hacerse así; pero aún no será el fin.", "words": [[0, 42999], [5, 43141], [12, 43501], [19, 44241], [22, 44461], [30, 44961], [32, 45201], [35, 45321], [43, 45921], [46, 46081], [54, 46764], [57, 47026], [60, 47206], [69, 47786], [76, 48386], [85, 49126], [93, 49906], [98, 50633], [103, 50775], [107, 51175], [110, 51675], [115, 51915], [118, 52095]]}, {"verse": 8, "start": 52986, "end": 65632, "text": "Porque se levantará nación contra nación, y reino contra reino; y habrá terremotos en muchos lugares, y habrá hambres y alborotos; estos serán el principio de los dolores de parto.", "words": [[0, 52986], [7, 53171], [10, 53391], [20, 54011], [27, 54431], [34, 54871], [42, 55491], [44, 56021], [50, 56551], [57, 56911], [64, 57891], [66, 57995], [72, 58295], [83, 59035], [86, 59215], [93, 59515], [102, 60075], [104, 60615], [110, 60985], [118, 61355], [120, 61555], [131, 62640], [137, 63088], [143, 63528], [146, 63648], [156, 64188], [159, 64448], [163, 64568], [171, 64968], [174, 65068]]}, {"verse": 9, "start": 65982, "end": 80158, "text": "Pero mirad por vosotros mismos: porque os entregarán en los tribunales, y en sinagogas seréis azotados: y delante de gobernadores y de reyes compareceréis por causa de mí, en testimonio a ellos.", "words": [[0, 65982], [5, 66149], [11, 66549], [15, 66709], [24, 67169], [32, 68062], [39, 68304], [42, 68484], [53, 69244], [56, 69344], [60, 69504], [72, 70244], [74, 70539], [77, 70699], [87, 71599], [94, 72259], [104, 73531], [106, 73793], [114, 74273], [117, 74433], [130, 75253], [132, 75633], [135, 76013], [141, 76393], [155, 77213], [159, 77453], [165, 77793], [168, 78073], [172, 78293], [175, 78753], [186, 79493], [188, 79633]]}, {"verse": 10, "start": 80508, "end": 84747, "text": "Y a todas las naciones conviene que el evangelio sea predicado antes.", "words": [[0, 80508], [2, 80669], [4, 80749], [10, 80989], [14, 81249], [23, 81689], [32, 82209], [36, 82389], [39, 82509], [49, 83169], [53, 83629], [63, 84089]]}, {"verse": 11, "start": 85097, "end": 99761, "text": "Y cuando os traigan para entregaros, no premeditéis qué habéis de decir, ni lo penséis: sino lo que os sea dado en aquella hora, eso hablad; porque no sois vosotros los que habláis, sino el Espíritu Santo.", "words": [[0, 85097], [2, 85267], [9, 85377], [12, 85487], [20, 86167], [25, 86427], [37, 87547], [40, 87647], [52, 88447], [56, 88587], [63, 89007], [66, 89187], [73, 89927], [76, 90087], [79, 90227], [88, 91251], [93, 91554], [96, 91794], [100, 91914], [103, 92094], [107, 92294], [112, 92614], [115, 92754], [123, 93094], [129, 93567], [133, 94041], [141, 94658], [148, 94866], [151, 95106], [156, 95586], [165, 96306], [169, 96606], [173, 96806], [182, 97286], [187, 97866], [190, 98426], [199, 99146]]}, {"verse": 12, "start": 100111, "end": 109122, "text": "Y entregará a la muerte el hermano al hermano, y el padre al hijo: y se levantarán los hijos contra los padres, y los matarán.", "words": [[0, 100111], [2, 100238], [12, 101018], [14, 101158], [17, 101258], [24, 101658], [27, 101958], [35, 102538], [38, 102658], [47, 103718], [49, 104018], [52, 104158], [58, 104618], [61, 104798], [67, 105469], [69, 105576], [72, 105676], [83, 106316], [87, 106456], [93, 106716], [100, 107056], [104, 107236], [112, 107636], [114, 108196], [118, 108336]]}, {"verse": 13, "start": 109472, "end": 116405, "text": "Y seréis aborrecidos de todos por mi nombre: pero el que persevere hasta el fin, este será salvo.", "words": [[0, 109472], [2, 109581], [9, 110041], [21, 110881], [24, 111061], [30, 111361], [34, 111661], [37, 111841], [45, 112629], [50, 112773], [53, 112953], [57, 113073], [67, 113833], [73, 114033], [76, 114213], [81, 115253], [86, 115453], [91, 115773]]}, {"verse": 14, "start": 116755, "end": 130017, "text": "Pero cuando veáis la abominación desoladora de que habló el profeta Daniel, puesta donde no debe estar (el que lee, entienda), entonces los que estén en Judea huyan a los montes;", "words": [[0, 116755], [5, 116899], [12, 117199], [18, 117659], [21, 117879], [33, 118779], [44, 119679], [47, 119899], [51, 120059], [57, 120359], [60, 120459], [68, 120939], [76, 121619], [83, 122299], [89, 122619], [92, 122979], [97, 123239], [103, 123679], [107, 124199], [111, 124359], [116, 125199], [127, 126119], [136, 126623], [140, 127223], [144, 127403], [150, 127823], [153, 128003], [159, 128603], [165, 129023], [167, 129123], [171, 129263]]}, {"verse": 15, "start": 130367, "end": 137146, "text": "Y el que esté sobre la azotea, no descienda a la casa, ni entre para tomar algo de su casa;", "words": [[0, 130367], [2, 130495], [5, 130595], [9, 130755], [14, 130995], [20, 131395], [23, 131635], [31, 132875], [34, 133155], [44, 133715], [46, 133855], [49, 133935], [55, 134295], [58, 134975], [64, 135295], [69, 135535], [75, 135895], [80, 136275], [83, 136455], [86, 136575]]}, {"verse": 16, "start": 137496, "end": 141693, "text": "Y el que esté en el campo, no vuelva atrás a tomar su capa.", "words": [[0, 137496], [2, 137634], [5, 137754], [9, 137894], [14, 138134], [17, 138314], [20, 138394], [27, 139474], [30, 139784], [37, 140094], [43, 140374], [45, 140614], [51, 140874], [54, 141134]]}, {"verse": 17, "start": 142043, "end": 147869, "text": "Pero ¡ay de las embarazadas y de las que estén amamantando en aquellos días!", "words": [[0, 142043], [5, 142417], [9, 142827], [12, 143187], [16, 143347], [28, 144367], [30, 144847], [33, 144967], [37, 145127], [41, 145267], [47, 145627], [59, 146707], [62, 146827], [71, 147067]]}, {"verse": 18, "start": 148219, "end": 152068, "text": "Orad pues, que no acontezca vuestra huida en invierno.", "words": [[0, 148397], [5, 148607], [11, 148867], [15, 149187], [18, 149737], [28, 150287], [36, 150727], [42, 151167], [45, 151307]]}, {"verse": 19, "start": 152418, "end": 160842, "text": "Porque aquellos días serán de aflicción, cual nunca fue desde el principio de la creación que Dios creó, hasta este tiempo, ni será.", "words": [[0, 152418], [7, 152698], [16, 153018], [21, 153358], [27, 153758], [30, 153878], [41, 154498], [46, 154773], [52, 155093], [56, 155473], [62, 155753], [65, 155933], [75, 156553], [78, 156853], [81, 156993], [90, 157573], [94, 157773], [99, 158013], [105, 158593], [111, 159153], [116, 159373], [124, 160173], [127, 160353]]}, {"verse": 20, "start": 161192, "end": 170777, "text": "Y si el Señor no hubiese abreviado aquellos días, nadie sobreviviría; pero por causa de los escogidos a quienes eligió, acortó aquellos días.", "words": [[0, 161192], [2, 161316], [5, 161476], [8, 161616], [14, 161896], [17, 162176], [25, 162516], [35, 163136], [44, 163356], [50, 164276], [56, 164576], [70, 166068], [75, 166450], [79, 166610], [85, 166910], [88, 167150], [92, 167270], [102, 167850], [104, 168010], [112, 168150], [120, 169290], [127, 169830], [136, 170070]]}, {"verse": 21, "start": 171127, "end": 179208, "text": "Y entonces si alguno os dice: Mirad, aquí está el Cristo» o «Mirad, allí está», no lo creáis.", "words": [[0, 171127], [2, 171269], [11, 171669], [14, 172249], [21, 172509], [24, 172769], [30, 173579], [37, 173985], [42, 174325], [47, 174645], [50, 174785], [58, 175570], [60, 175690], [68, 176390], [73, 177070], [80, 177950], [83, 178190], [86, 178350]]}, {"verse": 22, "start": 179558, "end": 189650, "text": "Porque se levantarán falsos Cristos y falsos profetas, y darán señales y prodigios, para engañar, si se pudiese hacer, aun a los escogidos.", "words": [[0, 179558], [7, 179763], [10, 179923], [21, 180563], [28, 181083], [36, 181583], [38, 181683], [45, 182083], [55, 182583], [57, 183103], [63, 183503], [71, 184143], [73, 184263], [84, 185103], [89, 185603], [98, 186403], [101, 186903], [104, 187063], [112, 187543], [119, 188003], [123, 188363], [125, 188623], [129, 188763]]}, {"verse": 23, "start": 190000, "end": 193501, "text": "Pero vosotros mirad; os lo he dicho antes todo.", "words": [[0, 190000], [5, 190260], [14, 190900], [21, 191547], [24, 191756], [27, 192036], [30, 192156], [36, 192416], [42, 192876]]}, {"verse": 24, "start": 193851, "end": 203181, "text": "Pero en aquellos días, después de aquella aflicción, el sol se oscurecerá, y la luna no dará su resplandor;", "words": [[0, 193851], [5, 194017], [8, 194197], [17, 194437], [23, 195617], [31, 196057], [34, 196297], [42, 196657], [53, 197997], [56, 198277], [60, 198577], [63, 198817], [75, 199757], [77, 200197], [80, 200337], [85, 200657], [88, 201357], [93, 201797], [96, 202519]]}, {"verse": 25, "start": 203531, "end": 209057, "text": "Y las estrellas caerán del cielo, y los poderes que están en los cielos serán conmovidos;", "words": [[0, 203531], [2, 203628], [6, 203768], [16, 204388], [23, 204868], [27, 205048], [34, 205488], [36, 205908], [40, 206048], [48, 206568], [52, 206648], [58, 206928], [61, 207068], [65, 207228], [72, 207768], [78, 208128]]}, {"verse": 26, "start": 209407, "end": 216310, "text": "Y entonces verán al Hijo del hombre, que vendrá en las nubes con gran poder y gloria.", "words": [[0, 209407], [2, 209663], [11, 210163], [17, 211063], [20, 211223], [25, 211483], [29, 211723], [37, 212483], [41, 213023], [48, 213563], [51, 213823], [55, 213963], [61, 214523], [65, 214723], [70, 215003], [76, 215423], [78, 215663]]}, {"verse": 27, "start": 216660, "end": 226351, "text": "Y entonces enviará sus ángeles, y reunirá a sus escogidos de los cuatro vientos, desde el extremo de la tierra hasta el extremo del cielo.", "words": [[0, 216660], [2, 216824], [11, 217244], [19, 218184], [23, 218324], [32, 218964], [34, 219604], [42, 220404], [44, 220444], [48, 220584], [58, 221284], [61, 221424], [65, 221524], [72, 221764], [81, 222424], [87, 222924], [90, 223144], [98, 223704], [101, 223764], [104, 223884], [111, 224264], [117, 224844], [120, 225004], [128, 225584], [132, 225684]]}, {"verse": 28, "start": 226701, "end": 236193, "text": "De la higuera aprended la semejanza: Cuando su rama ya se pone tierna, y brota hojas, conocéis que el verano está cerca:", "words": [[0, 226701], [3, 226808], [6, 226968], [14, 227738], [23, 228508], [26, 228968], [37, 230177], [44, 230394], [47, 230634], [52, 230994], [55, 231154], [58, 231294], [63, 231554], [71, 232274], [73, 232654], [79, 233014], [86, 233774], [95, 234474], [99, 234734], [102, 234894], [109, 235254], [114, 235454]]}, {"verse": 29, "start": 236543, "end": 243513, "text": "Así también vosotros, cuando veáis que suceden estas cosas, conoced que está cerca, a las puertas.", "words": [[0, 236543], [4, 236803], [12, 237163], [22, 238223], [29, 238423], [35, 238943], [39, 239123], [47, 239763], [53, 239943], [60, 240653], [68, 241363], [72, 241563], [77, 241803], [84, 242243], [86, 242783], [90, 242903]]}, {"verse": 30, "start": 243863, "end": 249636, "text": "De cierto os digo que no pasará esta generación hasta que todas estas cosas sean hechas.", "words": [[0, 243863], [3, 244027], [10, 244307], [13, 244647], [18, 244927], [22, 245147], [25, 245367], [32, 245847], [37, 246127], [48, 246987], [54, 247362], [58, 247562], [64, 247802], [70, 248182], [76, 248582], [81, 248962]]}, {"verse": 31, "start": 249986, "end": 254541, "text": "El cielo y la tierra pasarán, pero mis palabras no pasarán.", "words": [[0, 249986], [3, 250115], [9, 250655], [11, 251055], [14, 251195], [21, 251495], [30, 252495], [35, 252755], [39, 252915], [48, 253315], [51, 253675]]}, {"verse": 32, "start": 254891, "end": 262769, "text": "Pero de aquel día y de la hora, nadie sabe; ni aun los ángeles que están en el cielo, ni el Hijo, sino el Padre.", "words": [[0, 254891], [5, 255032], [8, 255252], [14, 255572], [18, 255812], [20, 255972], [23, 256072], [26, 256232], [32, 256492], [38, 257292], [44, 258296], [47, 258445], [51, 258685], [55, 258965], [63, 259525], [67, 259705], [73, 259945], [76, 260145], [79, 260285], [86, 260625], [89, 260945], [92, 261105], [98, 261745], [103, 261945], [106, 262165]]}, {"verse": 33, "start": 263119, "end": 267552, "text": "Mirad, velad y orad: porque no sabéis cuándo será el tiempo.", "words": [[0, 263119], [7, 263526], [13, 263986], [15, 264286], [21, 265018], [28, 265220], [31, 265440], [38, 265920], [45, 266480], [50, 266720], [53, 266920]]}, {"verse": 34, "start": 267902, "end": 278279, "text": "Como un hombre que se fue lejos, dejó su casa, y dio autoridad a sus siervos, y a cada uno su obra, y al portero mandó que velase:", "words": [[0, 267902], [5, 268067], [8, 268287], [15, 268627], [19, 268807], [22, 268947], [26, 269167], [33, 269747], [38, 270667], [41, 270847], [47, 271267], [49, 272067], [53, 272347], [63, 273067], [65, 273227], [69, 273407], [78, 274047], [80, 274447], [82, 274527], [87, 274727], [91, 275027], [94, 275247], [100, 275687], [102, 276247], [105, 276367], [113, 276987], [119, 277427], [123, 277885]]}, {"verse": 35, "start": 278629, "end": 288723, "text": "Velad pues, porque no sabéis cuándo el señor de la casa vendrá; si a la tarde, o a la media noche, o al canto del gallo, o a la mañana;", "words": [[0, 278875], [6, 279155], [12, 279573], [19, 279990], [22, 280110], [29, 280530], [36, 280810], [39, 281090], [45, 281430], [48, 281650], [51, 281790], [56, 282090], [64, 283110], [67, 283340], [69, 283440], [72, 283540], [79, 284600], [81, 284640], [83, 284740], [86, 285167], [92, 285593], [99, 286020], [101, 286060], [104, 286200], [110, 286600], [114, 287150], [121, 287700], [123, 287760], [125, 287900], [128, 288000]]}, {"verse": 36, "start": 289073, "end": 293186, "text": "Porque cuando venga de repente, no os halle durmiendo.", "words": [[0, 289073], [7, 289295], [14, 289595], [20, 290075], [23, 290215], [32, 291295], [35, 291555], [38, 291985], [44, 292415]]}, {"verse": 37, "start": 293536, "end": 297708, "text": "Y las cosas que a vosotros digo, a todos las digo: Velad.", "words": [[0, 293536], [2, 293643], [6, 293783], [12, 294103], [16, 294343], [18, 294443], [27, 294843], [33, 295723], [35, 295803], [41, 296143], [45, 296383], [51, 297416]]}]}