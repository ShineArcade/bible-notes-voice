{"book": "PSA", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 135591, "verses": [{"verse": 1, "start": 300, "end": 5529, "text": "¿Por qué estás lejos, oh Jehová, y te escondes en el tiempo de la tribulación?", "words": [[0, 351], [5, 437], [9, 524], [15, 724], [22, 1364], [25, 2004], [33, 2644], [35, 2744], [38, 3174], [47, 3604], [50, 3744], [53, 3864], [60, 4204], [63, 4424], [66, 4544]]}, {"verse": 2, "start": 5979, "end": 12817, "text": "Con arrogancia el malo persigue al pobre: serán cogidos en los artificios que han ideado.", "words": [[0, 5979], [4, 6266], [15, 7106], [18, 7306], [23, 7686], [32, 8206], [35, 8386], [42, 9390], [48, 9906], [56, 10546], [59, 10747], [63, 10886], [74, 11747], [78, 11886], [82, 12086]]}, {"verse": 3, "start": 13267, "end": 20675, "text": "Por cuanto se alaba el malo del deseo de su alma, y bendice al codicioso, a quien Jehová aborrece.", "words": [[0, 13267], [4, 13410], [11, 13670], [14, 13990], [20, 14350], [23, 14490], [28, 14890], [32, 15030], [38, 15610], [41, 15690], [44, 15870], [50, 16750], [52, 17130], [60, 17490], [63, 17850], [74, 18650], [76, 18930], [82, 19090], [89, 19750]]}, {"verse": 4, "start": 21125, "end": 28730, "text": "El malo, por la altivez de su rostro, no busca a Dios: no hay Dios en todos sus pensamientos.", "words": [[0, 21125], [3, 21411], [9, 21831], [13, 22051], [16, 22441], [24, 22831], [27, 23051], [30, 23231], [38, 23911], [41, 24471], [47, 24851], [49, 25111], [55, 25948], [58, 26154], [62, 26394], [67, 26654], [70, 26974], [76, 27294], [80, 27654]]}, {"verse": 5, "start": 29180, "end": 37667, "text": "Sus caminos son viciosos en todo tiempo: tus juicios los tiene muy lejos de su vista: se burla de todos sus enemigos.", "words": [[0, 29180], [4, 29301], [12, 29821], [16, 30021], [25, 30661], [28, 30821], [33, 31021], [41, 32047], [45, 32131], [53, 32591], [57, 32901], [63, 33211], [67, 33471], [73, 33891], [76, 34051], [79, 34171], [86, 35068], [89, 35232], [95, 35732], [98, 36152], [104, 36472], [108, 36812]]}, {"verse": 6, "start": 38117, "end": 44379, "text": "Dice en su corazón: No seré movido en ningún tiempo, ni jamás me alcanzará el infortunio.", "words": [[0, 38117], [5, 38642], [8, 38962], [11, 39142], [20, 40186], [23, 40311], [28, 40611], [35, 40991], [38, 41131], [45, 41411], [53, 42191], [56, 42451], [62, 42831], [65, 42951], [75, 43491], [78, 43631]]}, {"verse": 7, "start": 44729, "end": 52663, "text": "Llena está su boca de maldición, y de engaños y fraude: debajo de su lengua, vejación y maldad.", "words": [[0, 44857], [6, 45017], [11, 45437], [14, 45557], [19, 45797], [22, 45977], [33, 46557], [35, 47537], [38, 47677], [46, 48477], [48, 48777], [56, 49717], [63, 50097], [66, 50277], [69, 50397], [77, 51177], [86, 51777], [88, 52037]]}, {"verse": 8, "start": 53113, "end": 62168, "text": "Está en las guaridas de las aldeas: en los escondrijos mata al inocente: sus ojos están acechando al pobre.", "words": [[0, 53113], [5, 53517], [8, 53797], [12, 54017], [21, 54677], [24, 54857], [28, 54997], [36, 56154], [39, 56454], [43, 56574], [55, 57534], [60, 58154], [63, 58554], [73, 59744], [77, 59870], [82, 60490], [88, 60690], [98, 61330], [101, 61490]]}, {"verse": 9, "start": 62618, "end": 71869, "text": "Acecha en oculto, como el león desde su cama: acecha para arrebatar al pobre: arrebata al pobre trayéndolo a su red.", "words": [[0, 62787], [7, 62987], [10, 63187], [18, 63947], [23, 64167], [26, 64367], [31, 64747], [37, 64927], [40, 65207], [46, 66323], [53, 66563], [58, 66843], [68, 67643], [71, 67783], [78, 69157], [87, 69577], [90, 69777], [96, 70397], [107, 71077], [109, 71217], [112, 71357]]}, {"verse": 10, "start": 72319, "end": 77645, "text": "Se encoge, se agacha, y caen en sus fuerzas muchos desdichados.", "words": [[0, 72319], [3, 72501], [11, 73141], [14, 73221], [22, 73681], [24, 74361], [29, 74821], [32, 74961], [36, 75081], [44, 75741], [51, 76707]]}, {"verse": 11, "start": 78095, "end": 85080, "text": "Dice en su corazón: Dios está olvidado, ha encubierto su rostro; nunca lo verá.", "words": [[0, 78095], [5, 78621], [8, 78941], [11, 79121], [20, 80164], [25, 80370], [30, 80730], [40, 81070], [43, 81410], [54, 81950], [57, 82150], [65, 83037], [71, 83435], [74, 83575]]}, {"verse": 12, "start": 85430, "end": 90318, "text": "Levántate, oh Jehová Dios, alza tu mano, no te olvides de los pobres.", "words": [[0, 85430], [11, 85989], [14, 86584], [21, 87179], [27, 87774], [32, 88274], [35, 88454], [41, 88794], [44, 89434], [47, 89574], [55, 89994], [58, 90102], [62, 90210]]}, {"verse": 13, "start": 90768, "end": 95978, "text": "¿Por qué irrita el malo a Dios? En su corazón ha dicho que no lo inquirirás.", "words": [[0, 91532], [5, 91792], [9, 91972], [16, 92372], [19, 92472], [24, 92752], [26, 92852], [32, 93565], [35, 93710], [38, 93830], [46, 94270], [49, 94450], [55, 94710], [59, 94870], [62, 95010], [65, 95530]]}, {"verse": 14, "start": 96428, "end": 107049, "text": "Tú lo tienes visto: porque tú miras el trabajo, y la vejación, para vengarle por tu mano: a ti se acoge el pobre, tú eres el amparo del huérfano.", "words": [[0, 96428], [3, 96551], [6, 96631], [13, 96831], [20, 97767], [27, 97994], [30, 98274], [36, 98734], [39, 98874], [48, 99374], [50, 99694], [53, 99814], [63, 100454], [68, 101214], [77, 101814], [81, 102054], [84, 102234], [90, 103057], [92, 103197], [95, 103357], [98, 103637], [104, 104037], [107, 104137], [114, 104837], [117, 105077], [122, 105297], [125, 105497], [132, 106097], [136, 106277]]}, {"verse": 15, "start": 107499, "end": 114151, "text": "Quebranta el brazo del malo: del maligno buscarás su maldad, hasta que ninguna halles.", "words": [[0, 107762], [10, 108062], [13, 108222], [19, 108582], [23, 108762], [29, 110371], [33, 110716], [41, 111061], [50, 111406], [53, 111586], [61, 112126], [67, 112666], [71, 112866], [79, 113266]]}, {"verse": 16, "start": 114601, "end": 120564, "text": "Jehová, Rey eterno y perpetuo; de su tierra fueron destruidas las naciones.", "words": [[0, 114601], [8, 115084], [12, 115364], [19, 116164], [21, 116344], [31, 117586], [34, 117730], [37, 117870], [44, 118230], [51, 118570], [62, 119510], [66, 119730]]}, {"verse": 17, "start": 121014, "end": 128513, "text": "El deseo de los humildes oíste, oh Jehová: tú dispones su corazón, y haces atento tu oído;", "words": [[0, 121014], [3, 121395], [9, 121915], [12, 121995], [16, 122155], [25, 122855], [32, 123435], [35, 124015], [43, 124860], [46, 124964], [55, 125464], [58, 125684], [67, 126204], [69, 126924], [75, 127204], [82, 127724], [85, 127924]]}, {"verse": 18, "start": 128963, "end": 135191, "text": "Para juzgar al huérfano y al pobre, a fin de que no vuelva más a hacer violencia el hombre de la tierra.", "words": [[0, 128963], [5, 129208], [12, 129768], [15, 129908], [24, 130468], [26, 130608], [29, 130748], [36, 131348], [38, 131408], [42, 131588], [45, 131728], [49, 131848], [52, 132008], [59, 132408], [63, 132628], [65, 132828], [71, 133128], [81, 133568], [84, 134008], [91, 134268], [94, 134428], [97, 134548]]}]}