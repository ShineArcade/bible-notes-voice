{"book": "LUK", "chapter": 6, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 435966, "verses": [{"verse": 1, "start": 300, "end": 11921, "text": "Y aconteció que pasando él por los sembrados en un sábado segundo del primero, sus discípulos arrancaban espigas, y comían, restregándolas con las manos.", "words": [[0, 300], [2, 422], [12, 1062], [16, 1262], [24, 1642], [27, 1982], [31, 2182], [35, 2382], [45, 3042], [48, 3262], [51, 3382], [58, 3902], [66, 4402], [70, 4722], [79, 5782], [83, 6082], [94, 6862], [105, 7642], [114, 8422], [116, 8902], [124, 9862], [139, 10902], [143, 11122], [147, 11302]]}, {"verse": 2, "start": 12271, "end": 17588, "text": "Y algunos de los fariseos les dijeron: ¿Por qué hacéis lo que no es lícito hacer en los sábados?", "words": [[0, 12271], [2, 12350], [10, 12670], [13, 12890], [17, 12990], [26, 13670], [30, 13970], [39, 14730], [44, 14845], [48, 15045], [55, 15485], [58, 15585], [62, 15705], [65, 15885], [68, 16025], [75, 16445], [81, 16685], [84, 16865], [88, 16985]]}, {"verse": 3, "start": 17868, "end": 27408, "text": "Y respondiendo Jesús les dijo: ¿Ni aun esto habéis leído, qué hizo David cuando tuvo hambre, él, y los que con él estaban;", "words": [[0, 17868], [2, 17991], [15, 18771], [21, 19131], [25, 19491], [31, 20398], [35, 20498], [39, 20758], [44, 21218], [51, 21598], [58, 22078], [62, 22318], [67, 22718], [73, 23078], [80, 23418], [85, 23838], [93, 24858], [97, 25278], [99, 25743], [103, 25903], [107, 26043], [111, 26303], [114, 26463]]}, {"verse": 4, "start": 27758, "end": 40656, "text": "Cómo entró en la casa de Dios, y tomó los panes de la Presencia, y comió, y dio también a los que estaban con él, los cuales no era lícito comer, sino a solos los sacerdotes?", "words": [[0, 27758], [5, 27964], [11, 28444], [14, 28524], [17, 28644], [22, 28924], [25, 29144], [31, 29444], [33, 29919], [38, 30239], [42, 30359], [48, 30819], [51, 30899], [54, 31019], [65, 31679], [67, 31819], [74, 32299], [76, 32799], [80, 32959], [88, 33439], [90, 33999], [94, 34119], [98, 34259], [106, 34519], [110, 34859], [114, 35509], [118, 35636], [125, 35956], [128, 36596], [132, 36756], [139, 37156], [146, 38036], [151, 38236], [153, 38436], [159, 38976], [163, 39456]]}, {"verse": 5, "start": 41006, "end": 45276, "text": "Y les decía: El Hijo del hombre es Señor aun del sábado.", "words": [[0, 41006], [2, 41155], [6, 41255], [13, 42214], [16, 42531], [21, 42751], [25, 42931], [32, 43311], [35, 43571], [41, 43871], [45, 44251], [49, 44511]]}, {"verse": 6, "start": 45626, "end": 55130, "text": "Y aconteció también en otro sábado, que él entró en la sinagoga y enseñaba; y estaba allí un hombre que tenía la mano derecha atrofiada.", "words": [[0, 45626], [2, 45769], [12, 46449], [20, 46789], [23, 47089], [28, 47309], [36, 47869], [40, 48349], [43, 48749], [49, 49269], [52, 49369], [55, 49509], [64, 50149], [66, 50329], [76, 51438], [78, 51699], [85, 51979], [90, 52259], [93, 52419], [100, 52719], [104, 52899], [110, 53179], [113, 53359], [118, 53579], [126, 54139]]}, {"verse": 7, "start": 55480, "end": 62227, "text": "Y le acechaban los escribas y los fariseos, si sanaría en sábado, por hallar de qué le acusasen.", "words": [[0, 55480], [2, 55605], [5, 55745], [15, 56385], [19, 56545], [28, 57245], [30, 57405], [34, 57565], [44, 58565], [47, 58825], [55, 59325], [58, 59565], [66, 60125], [70, 60425], [77, 60725], [80, 61005], [84, 61205], [87, 61365]]}, {"verse": 8, "start": 62577, "end": 73173, "text": "Pero él sabía los pensamientos de ellos; y dijo al hombre que tenía la mano atrofiada: Levántate, y ponte en medio. Y él levantándose, se puso en pie.", "words": [[0, 62577], [5, 62720], [8, 62920], [14, 63320], [18, 63460], [31, 64040], [34, 64260], [41, 64995], [43, 65277], [48, 65517], [51, 65697], [58, 65917], [62, 66217], [68, 66517], [71, 66657], [76, 66997], [87, 68416], [98, 69081], [100, 69321], [106, 69681], [109, 69861], [116, 70665], [118, 70828], [121, 70968], [135, 71868], [138, 72048], [143, 72448], [146, 72588]]}, {"verse": 9, "start": 73523, "end": 82777, "text": "Entonces Jesús les dice: Os preguntaré una cosa: ¿Es lícito en sábados hacer bien, o hacer mal? ¿salvar la vida, o quitarla?", "words": [[0, 73523], [9, 74023], [15, 74503], [19, 74803], [25, 75570], [28, 75736], [39, 76516], [43, 76676], [49, 77371], [53, 77564], [60, 78144], [63, 78324], [71, 78844], [77, 79224], [83, 79584], [85, 80104], [91, 80384], [96, 81084], [104, 81441], [107, 81701], [113, 81921], [115, 82101]]}, {"verse": 10, "start": 83127, "end": 91101, "text": "Y mirándolos a todos alrededor, dice al hombre: Extiende tu mano. Y él lo hizo así, y su mano fue restaurada.", "words": [[0, 83127], [2, 83252], [13, 83992], [15, 84112], [21, 84372], [32, 85292], [37, 85492], [40, 85732], [48, 86403], [57, 87011], [60, 87211], [66, 88021], [68, 88190], [71, 88310], [74, 88490], [79, 88730], [84, 89090], [86, 89330], [89, 89510], [94, 89750], [98, 90010]]}, {"verse": 11, "start": 91451, "end": 97714, "text": "Y ellos se llenaron de rabia; y hablaban los unos a los otros qué harían a Jesús.", "words": [[0, 91451], [2, 91762], [8, 92062], [11, 92582], [20, 93082], [23, 93222], [30, 94171], [32, 94277], [41, 94777], [45, 95017], [50, 95417], [52, 95717], [56, 95877], [62, 96197], [66, 96497], [73, 96957], [75, 97077]]}, {"verse": 12, "start": 98064, "end": 104179, "text": "Y aconteció en aquellos días, que fue al monte a orar, y pasó la noche orando a Dios.", "words": [[0, 98064], [2, 98189], [12, 98969], [15, 99109], [24, 99349], [30, 99849], [34, 100109], [38, 100329], [41, 100469], [47, 100769], [49, 100929], [55, 101369], [57, 101989], [62, 102309], [65, 102529], [71, 102829], [78, 103469], [80, 103629]]}, {"verse": 13, "start": 104529, "end": 112571, "text": "Y como fue de día, llamó a sus discípulos, y escogió doce de ellos, a los cuales también llamó apóstoles:", "words": [[0, 104529], [2, 104632], [7, 104852], [11, 105072], [14, 105212], [19, 106172], [25, 106612], [27, 106692], [31, 106872], [43, 107712], [45, 108412], [53, 109092], [58, 109752], [61, 109972], [68, 110332], [70, 110592], [74, 110732], [81, 110912], [89, 111272], [95, 111692]]}, {"verse": 14, "start": 112921, "end": 121021, "text": "A Simón, al cual también llamó Pedro, y a Andrés su hermano, Jacobo y Juan, Felipe y Bartolomé,", "words": [[0, 112921], [2, 113085], [9, 113805], [12, 113905], [17, 114105], [25, 114465], [31, 114945], [38, 115845], [40, 116085], [42, 116165], [49, 116905], [52, 116945], [61, 117805], [68, 118445], [70, 118605], [76, 119365], [83, 119765], [85, 120205]]}, {"verse": 15, "start": 121371, "end": 127047, "text": "Mateo y Tomás, Jacobo hijo de Alfeo, y Simón el que se llama Zelote,", "words": [[0, 121371], [6, 121937], [8, 122097], [15, 122877], [22, 123537], [27, 123697], [30, 123897], [37, 124857], [39, 124917], [45, 125537], [48, 125697], [52, 125837], [55, 125977], [61, 126532]]}, {"verse": 16, "start": 127397, "end": 132563, "text": "Judas hermano de Jacobo, y Judas Iscariote, que también fue el traidor.", "words": [[0, 127397], [6, 127703], [14, 128303], [17, 128363], [25, 129283], [27, 129443], [33, 129823], [44, 130823], [48, 130923], [56, 131303], [60, 131543], [63, 131823]]}, {"verse": 17, "start": 132913, "end": 151404, "text": "Y descendió con ellos, y se paró en un lugar llano, y un grupo numeroso de sus discípulos, y una grande multitud de pueblo de toda Judea y de Jerusalén, y de la costa de Tiro y de Sidón, que habían venido a oírle, y para ser sanados de sus enfermedades;", "words": [[0, 132913], [2, 133037], [12, 133557], [16, 133817], [23, 134177], [25, 134582], [28, 134762], [33, 135162], [36, 135342], [39, 135482], [45, 135862], [52, 136922], [54, 137102], [57, 137222], [63, 137442], [72, 138082], [75, 138262], [79, 138442], [91, 139242], [93, 139682], [97, 139842], [104, 140142], [113, 140842], [116, 141042], [123, 141442], [126, 141682], [131, 141962], [137, 142642], [139, 142742], [142, 142862], [153, 144039], [155, 144175], [158, 144295], [161, 144435], [167, 144975], [170, 145075], [175, 145455], [177, 145655], [180, 145795], [187, 146415], [191, 146775], [198, 147015], [205, 147475], [207, 147575], [214, 148275], [216, 148675], [221, 148875], [225, 149155], [233, 149775], [236, 149975], [240, 150135]]}, {"verse": 18, "start": 151754, "end": 156988, "text": "Y los que habían sido atormentados de espíritus inmundos: y estaban curados.", "words": [[0, 151754], [2, 151876], [6, 151996], [10, 152136], [17, 152396], [22, 152736], [35, 153676], [38, 153816], [48, 154556], [58, 155688], [60, 155788], [68, 156048]]}, {"verse": 19, "start": 157338, "end": 163186, "text": "Y toda la gente procuraba tocarle; porque salía de él poder, y sanaba a todos.", "words": [[0, 157338], [2, 157482], [7, 157702], [10, 157922], [16, 158242], [26, 158982], [35, 160083], [42, 160246], [48, 160706], [51, 160846], [54, 161006], [61, 161306], [63, 161886], [70, 162366], [72, 162506]]}, {"verse": 20, "start": 163536, "end": 172082, "text": "Y alzando él los ojos a sus discípulos, decía: Bienaventurados vosotros los pobres; porque vuestro es el reino de Dios.", "words": [[0, 163536], [2, 163664], [10, 163984], [13, 164304], [17, 164464], [22, 164844], [24, 165064], [28, 165244], [40, 166224], [47, 167366], [63, 168262], [72, 168782], [76, 168962], [84, 169927], [91, 170132], [99, 170632], [102, 170952], [105, 171132], [111, 171552], [114, 171692]]}, {"verse": 21, "start": 172432, "end": 182137, "text": "Bienaventurados los que ahora tenéis hambre; porque seréis saciados. Bienaventurados los que ahora lloráis, porque reiréis.", "words": [[0, 172432], [16, 173559], [20, 174139], [24, 174359], [30, 174599], [37, 175139], [45, 176082], [52, 176264], [59, 176764], [69, 178057], [85, 179157], [89, 179357], [93, 179557], [99, 179797], [108, 180577], [115, 180957]]}, {"verse": 22, "start": 182487, "end": 194447, "text": "Bienaventurados seréis, cuando los hombres os aborrezcan, y cuando os aparten de sí, y os insulten, y desechen vuestro nombre como malo, por el Hijo del hombre.", "words": [[0, 182487], [16, 183292], [24, 183792], [31, 184272], [35, 184592], [43, 184972], [46, 185642], [58, 186312], [60, 186872], [67, 187092], [70, 187312], [78, 187872], [81, 188012], [85, 188332], [87, 189132], [90, 189272], [100, 190272], [102, 190592], [111, 191192], [119, 191572], [126, 191932], [131, 192252], [137, 192852], [141, 193272], [144, 193412], [149, 193672], [153, 193872]]}, {"verse": 23, "start": 194797, "end": 204609, "text": "Gozaos en aquel día, y alegraos; porque he aquí vuestro recompensa es grande en los cielos; porque así hacían sus padres a los profetas.", "words": [[0, 195083], [7, 195403], [10, 195643], [16, 196003], [21, 196323], [23, 196983], [33, 197817], [40, 197943], [43, 198103], [48, 198443], [56, 198963], [67, 199863], [70, 200063], [77, 200523], [80, 200763], [84, 200863], [92, 201599], [99, 201919], [103, 202299], [110, 202759], [114, 202999], [121, 203459], [123, 203699], [127, 203819]]}, {"verse": 24, "start": 204959, "end": 208915, "text": "Pero ¡ay de vosotros, ricos! porque tenéis vuestro consuelo.", "words": [[0, 204959], [5, 205279], [9, 205599], [12, 205819], [22, 206279], [29, 207240], [36, 207424], [43, 207784], [51, 208124]]}, {"verse": 25, "start": 209265, "end": 219278, "text": "¡Ay de vosotros, los que estáis hartos! porque tendréis hambre. ¡Ay de vosotros, los que ahora reís! porque lamentaréis y lloraréis.", "words": [[0, 209364], [4, 209504], [7, 209704], [17, 210224], [21, 210444], [25, 210584], [32, 211004], [40, 212093], [47, 212298], [56, 212918], [64, 213935], [68, 214045], [71, 214225], [81, 214785], [85, 215345], [89, 215545], [95, 215785], [101, 216918], [108, 217058], [120, 218218], [122, 218358]]}, {"verse": 26, "start": 219628, "end": 228079, "text": "¡Ay de vosotros, cuando todos los hombres hablen bien de vosotros! porque así hacían sus padres a los falsos profetas.", "words": [[0, 219707], [4, 219817], [7, 220037], [17, 220617], [24, 220917], [30, 221377], [34, 221637], [42, 221997], [49, 222597], [54, 222877], [57, 223157], [67, 224219], [74, 224579], [78, 224979], [85, 225799], [89, 226019], [96, 226539], [98, 226819], [102, 226919], [109, 227359]]}, {"verse": 27, "start": 228429, "end": 234703, "text": "Pero a vosotros los que oís, digo: Amad a vuestros enemigos, haced bien a los que os aborrecen;", "words": [[0, 228429], [5, 228596], [7, 228696], [16, 229156], [20, 229376], [24, 229596], [29, 229936], [35, 230911], [40, 231077], [42, 231244], [51, 231644], [61, 232444], [67, 232744], [72, 233104], [74, 233444], [78, 233564], [82, 233704], [85, 233844]]}, {"verse": 28, "start": 235053, "end": 240165, "text": "Bendecid a los que os maldicen, y orad por los que os calumnian.", "words": [[0, 235543], [9, 236033], [11, 236273], [15, 236393], [19, 236533], [22, 236673], [32, 237246], [34, 237820], [39, 238393], [43, 238753], [47, 238973], [51, 239133], [54, 239273]]}, {"verse": 29, "start": 240515, "end": 248494, "text": "Y al que te hiera en la mejilla, dale también la otra; y al que te quite la capa, no le niegues tampoco la túnica.", "words": [[0, 240515], [2, 240654], [5, 240794], [9, 240954], [12, 241244], [18, 241534], [21, 241694], [24, 241774], [33, 242834], [38, 243134], [46, 243474], [49, 243794], [55, 244619], [57, 244721], [60, 244801], [64, 244941], [67, 245101], [73, 245341], [76, 245601], [82, 246501], [85, 246601], [88, 246741], [96, 247201], [104, 247481], [107, 247801]]}, {"verse": 30, "start": 248844, "end": 253764, "text": "Y a cualquiera que te pida, dale; y al que tome lo que es tuyo, no vuelvas a pedir.", "words": [[0, 248844], [2, 248930], [4, 248990], [15, 249470], [19, 249610], [22, 249770], [28, 250070], [34, 250794], [36, 250981], [39, 251101], [43, 251281], [48, 251721], [51, 251841], [55, 251981], [58, 252181], [64, 252521], [67, 252681], [75, 253161], [77, 253241]]}, {"verse": 31, "start": 254114, "end": 259515, "text": "Y como queréis que os hagan los hombres, así hacedles también vosotros:", "words": [[0, 254114], [2, 254218], [7, 254418], [15, 254918], [19, 255098], [22, 255258], [28, 255558], [32, 255738], [41, 256798], [45, 257138], [54, 258178], [62, 258498]]}, {"verse": 32, "start": 259865, "end": 267680, "text": "Porque si amáis a los que os aman, ¿qué gracias tendréis? porque también los pecadores aman a los que los aman.", "words": [[0, 259865], [7, 260109], [10, 260329], [16, 260849], [18, 261269], [22, 261389], [26, 261569], [29, 261749], [35, 262549], [40, 262789], [48, 263189], [58, 264246], [65, 264429], [73, 264929], [77, 265129], [87, 265689], [92, 266229], [94, 266629], [98, 266749], [102, 266869], [106, 267009]]}, {"verse": 33, "start": 268030, "end": 275218, "text": "Y si hacéis bien a los que os hacen bien, ¿qué gracias tendréis? porque también los pecadores hacen lo mismo.", "words": [[0, 268030], [2, 268151], [5, 268291], [12, 268811], [17, 269031], [19, 269311], [23, 269431], [27, 269598], [30, 269764], [36, 269931], [42, 270611], [47, 271131], [55, 271531], [65, 272774], [72, 272978], [80, 273358], [84, 273538], [94, 274058], [100, 274438], [103, 274638]]}, {"verse": 34, "start": 275568, "end": 285582, "text": "Y si prestáis a aquellos de quienes esperáis recibir, ¿qué gracias tendréis? porque también los pecadores prestan a los pecadores, para recibir otro tanto.", "words": [[0, 275568], [2, 275875], [5, 276015], [14, 276715], [16, 276935], [25, 277295], [28, 277575], [36, 277835], [45, 278455], [54, 279315], [59, 279435], [67, 279835], [77, 281083], [84, 281435], [92, 281875], [96, 282055], [106, 282615], [114, 283255], [116, 283335], [120, 283435], [131, 283895], [136, 284155], [144, 284635], [149, 284915]]}, {"verse": 35, "start": 285932, "end": 300899, "text": "Amad, pues, a vuestros enemigos, y haced bien, y prestad, no esperando de ello nada; y será vuestro recompensa grande, y seréis hijos del Altísimo: porque él es benigno para con los ingratos y malos.", "words": [[0, 286113], [6, 286333], [12, 286573], [14, 286813], [23, 287173], [33, 287793], [35, 288053], [41, 288313], [47, 288713], [49, 289403], [58, 290093], [61, 290173], [71, 290593], [74, 290873], [79, 291013], [85, 291801], [87, 291927], [92, 292167], [100, 292779], [111, 293612], [119, 294092], [121, 294592], [128, 295112], [134, 295532], [138, 295852], [148, 297122], [155, 297365], [158, 297745], [161, 298025], [169, 298865], [174, 299085], [178, 299325], [182, 299465], [191, 300025], [193, 300265]]}, {"verse": 36, "start": 301249, "end": 305914, "text": "Sed pues misericordiosos, como también vuestro Padre es misericordioso.", "words": [[0, 301249], [4, 301733], [9, 302313], [26, 302893], [31, 303113], [39, 303473], [47, 303873], [53, 304573], [56, 304733]]}, {"verse": 37, "start": 306264, "end": 314246, "text": "No juzguéis, y no seréis juzgados: no condenéis, y no seréis condenados: perdonad, y seréis perdonados.", "words": [[0, 306264], [3, 306592], [13, 306952], [15, 307172], [18, 307312], [25, 307672], [35, 308766], [38, 308986], [49, 309606], [51, 310026], [54, 310186], [61, 310646], [73, 311833], [83, 312426], [85, 312646], [92, 313106]]}, {"verse": 38, "start": 314596, "end": 326505, "text": "Dad, y se os dará; medida buena, apretada, sacudida, y rebosando darán en vuestro regazo: porque con la misma medida con que medís, os será vuelto a medir.", "words": [[0, 314596], [5, 315096], [7, 315416], [10, 315556], [13, 315736], [19, 316600], [26, 316810], [33, 317270], [43, 318070], [53, 318730], [55, 319230], [65, 319730], [71, 320290], [74, 320510], [82, 321154], [90, 322067], [97, 322217], [101, 322417], [104, 322557], [110, 322857], [117, 323537], [121, 323757], [125, 323977], [132, 324487], [135, 324997], [140, 325357], [147, 325917], [149, 325997]]}, {"verse": 39, "start": 326855, "end": 332966, "text": "Y les decía una parábola: ¿Puede el ciego guiar al ciego? ¿No caerán ambos en el hoyo?", "words": [[0, 326855], [2, 326982], [6, 327122], [12, 327542], [16, 327782], [26, 328836], [33, 329080], [36, 329220], [42, 329660], [48, 330060], [51, 330200], [58, 331058], [62, 331204], [69, 331764], [75, 332144], [78, 332364], [81, 332695]]}, {"verse": 40, "start": 333316, "end": 341045, "text": "El discípulo no es superior a su maestro; pero cualquiera que sea como el maestro, estará plenamente formado.", "words": [[0, 333316], [3, 333481], [13, 334241], [16, 334561], [19, 334761], [28, 335281], [30, 335561], [33, 335641], [42, 336685], [47, 336830], [58, 337350], [62, 337510], [66, 337730], [71, 337990], [74, 338130], [83, 339130], [90, 339710], [101, 340250]]}, {"verse": 41, "start": 341395, "end": 348449, "text": "¿Por qué miras la paja que está en el ojo de tu hermano, y la viga que está en tu propio ojo no consideras?", "words": [[0, 341452], [5, 341546], [9, 341639], [15, 342239], [18, 342539], [23, 342919], [27, 343079], [32, 343299], [35, 343499], [38, 343619], [42, 343899], [45, 344039], [48, 344159], [57, 345219], [59, 345339], [62, 345499], [67, 345799], [71, 345939], [76, 346139], [79, 346259], [82, 346399], [89, 346739], [93, 347239], [96, 347399]]}, {"verse": 42, "start": 348799, "end": 366173, "text": "¿O cómo puedes decir a tu hermano: Hermano, deja, echaré fuera la paja que está en tu ojo, no mirando tú la viga que está en tu ojo? Hipócrita, echa primero fuera de tu ojo la viga, y entonces verás bien para sacar la paja que está en el ojo de tu hermano.", "words": [[0, 348799], [3, 348916], [8, 349176], [15, 349636], [21, 350096], [23, 350276], [26, 350396], [35, 351229], [44, 352038], [50, 352658], [57, 353393], [63, 353653], [66, 353933], [71, 354333], [75, 354533], [80, 354713], [83, 354873], [86, 355093], [91, 355573], [94, 356073], [102, 356533], [105, 356833], [108, 357013], [113, 357333], [117, 357473], [122, 357673], [125, 357813], [128, 357993], [133, 358702], [144, 359213], [149, 359763], [157, 360123], [163, 360443], [166, 360703], [169, 360883], [173, 361123], [176, 361283], [182, 361663], [184, 361803], [193, 362203], [199, 363103], [204, 363283], [209, 363603], [215, 363943], [218, 364203], [223, 364543], [227, 364683], [232, 364903], [235, 365003], [238, 365123], [242, 365363], [245, 365483], [248, 365623]]}, {"verse": 43, "start": 366523, "end": 372202, "text": "Porque no es buen árbol el que da malos frutos; ni árbol malo el que da buen fruto.", "words": [[0, 366523], [7, 366749], [10, 367009], [13, 367209], [18, 367409], [24, 367929], [27, 368189], [31, 368329], [34, 368489], [40, 368809], [48, 369940], [51, 370030], [57, 370430], [62, 370890], [65, 371017], [69, 371143], [72, 371270], [77, 371510]]}, {"verse": 44, "start": 372552, "end": 381616, "text": "Porque cada árbol por su fruto es conocido: que no cogen higos de los espinos, ni vendimian uvas de las zarzas.", "words": [[0, 372552], [7, 372737], [12, 373137], [18, 373717], [22, 373957], [25, 374177], [31, 374637], [34, 374757], [44, 375857], [48, 375939], [51, 376099], [57, 376659], [63, 377119], [66, 377279], [70, 377419], [79, 378132], [82, 378846], [92, 379559], [97, 380219], [100, 380539], [104, 381100]]}, {"verse": 45, "start": 381966, "end": 392666, "text": "El buen hombre del buen tesoro de su corazón saca bien; y el mal hombre del mal tesoro de su corazón saca mal; porque de la abundancia del corazón habla su boca.", "words": [[0, 381966], [3, 382090], [8, 382270], [15, 382570], [19, 382790], [24, 382990], [31, 383470], [34, 383590], [37, 383750], [45, 384190], [50, 384570], [56, 385266], [58, 385407], [61, 385547], [65, 385827], [72, 386407], [76, 386587], [80, 386847], [87, 387347], [90, 387487], [93, 387647], [101, 388087], [106, 388527], [111, 389027], [118, 389207], [121, 389767], [124, 389927], [135, 390767], [139, 390947], [147, 391467], [153, 391907], [156, 392107]]}, {"verse": 46, "start": 393016, "end": 396476, "text": "¿Por qué me llamáis, Señor, Señor, y no hacéis lo que digo?", "words": [[0, 393016], [5, 393120], [9, 393260], [12, 393380], [21, 394000], [28, 394480], [35, 395060], [37, 395140], [40, 395280], [47, 395720], [50, 395860], [54, 396000]]}, {"verse": 47, "start": 396826, "end": 403680, "text": "Todo aquel que viene a mí, y oye mis palabras, y las hace, os enseñaré a quién es semejante:", "words": [[0, 396826], [5, 397011], [11, 397451], [15, 397571], [21, 397831], [23, 397991], [27, 398171], [29, 398471], [33, 398731], [37, 398891], [47, 399391], [49, 400011], [53, 400211], [59, 401071], [62, 401191], [71, 401911], [73, 402111], [79, 402271], [82, 402671]]}, {"verse": 48, "start": 404030, "end": 421135, "text": "Semejante es al hombre que edifica una casa, el cual cavó y ahondó, y puso el fundamento sobre la roca; y cuando vino una crecida, el río dio con ímpetu en aquella casa, pero no la pudo mover: porque estaba fundada sobre la roca.", "words": [[0, 404393], [10, 404793], [13, 405033], [16, 405193], [23, 405453], [27, 405693], [35, 406413], [39, 406693], [45, 407533], [48, 407833], [53, 408263], [58, 408693], [60, 408833], [68, 409413], [70, 409893], [75, 410273], [78, 410393], [89, 411033], [95, 411273], [98, 411493], [104, 412324], [106, 412442], [113, 412662], [118, 412962], [122, 413615], [131, 414267], [134, 414407], [138, 414707], [142, 414927], [146, 415227], [153, 416027], [156, 416207], [164, 416507], [170, 417367], [175, 417487], [178, 417707], [181, 417827], [186, 418107], [193, 418874], [200, 419038], [207, 419318], [215, 419978], [221, 420258], [224, 420498]]}, {"verse": 49, "start": 421485, "end": 435566, "text": "Pero el que oyó y no hizo, semejante es al hombre que edificó su casa sobre tierra, sin fundamento; en la cual el río dio con ímpetu, y luego cayó; y fue grande la ruina de aquella casa.", "words": [[0, 421485], [5, 421647], [8, 421787], [12, 421947], [16, 422327], [18, 422527], [21, 422647], [27, 423487], [37, 424267], [40, 424627], [43, 424927], [50, 425207], [54, 425447], [62, 426067], [65, 426227], [70, 426527], [76, 426827], [84, 427267], [88, 427947], [100, 429286], [103, 429414], [106, 429534], [111, 429794], [114, 430134], [118, 430494], [122, 430674], [126, 430934], [134, 431534], [136, 431934], [142, 432154], [148, 433063], [150, 433169], [154, 433329], [161, 433649], [164, 433909], [170, 434369], [173, 434549], [181, 434909]]}]}