{"book": "1CO", "chapter": 12, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 210339, "verses": [{"verse": 1, "start": 300, "end": 4880, "text": "Y acerca de los dones espirituales, no quiero, hermanos, que ignoréis.", "words": [[0, 300], [2, 424], [9, 744], [12, 1024], [16, 1144], [22, 1544], [36, 2504], [39, 2824], [47, 3224], [57, 3924], [61, 4124]]}, {"verse": 2, "start": 5330, "end": 10749, "text": "Sabéis que cuando erais paganos, ibais, como erais llevados, a los ídolos mudos.", "words": [[0, 5330], [7, 5768], [11, 5948], [18, 6228], [24, 6588], [33, 7488], [40, 8268], [45, 8468], [51, 8728], [61, 9268], [63, 9528], [67, 9688], [74, 10168]]}, {"verse": 3, "start": 11199, "end": 20556, "text": "Por tanto os hago saber, que nadie que hable por Espíritu de Dios, llama maldito a Jesús; y nadie puede llamar a Jesús Señor, sino por Espíritu Santo.", "words": [[0, 11199], [4, 11306], [10, 11786], [13, 12006], [18, 12166], [25, 12546], [29, 12886], [35, 13206], [39, 13506], [45, 13826], [49, 14006], [58, 14586], [61, 14666], [67, 14946], [73, 15506], [81, 16126], [83, 16226], [90, 17070], [92, 17191], [98, 17411], [104, 17671], [111, 18111], [113, 18171], [119, 18371], [126, 19151], [131, 19331], [135, 19551], [144, 20051]]}, {"verse": 4, "start": 21006, "end": 24691, "text": "Ahora bien, hay diversidad de dones; pero el Espíritu es el mismo.", "words": [[0, 21006], [6, 21224], [12, 21464], [16, 21624], [27, 22184], [30, 22324], [37, 23173], [42, 23315], [45, 23435], [54, 23935], [57, 24055], [60, 24175]]}, {"verse": 5, "start": 25141, "end": 28829, "text": "Y hay diversidad de ministerios; pero el Señor es el mismo.", "words": [[0, 25141], [2, 25283], [6, 25383], [17, 25963], [20, 26123], [33, 27341], [38, 27485], [41, 27625], [47, 27905], [50, 28185], [53, 28305]]}, {"verse": 6, "start": 29279, "end": 35046, "text": "Y hay diversidad de actividades; pero el mismo Dios es el que obra todas las cosas en todos.", "words": [[0, 29279], [2, 29420], [6, 29520], [17, 30080], [20, 30240], [33, 31450], [38, 31602], [41, 31742], [47, 32042], [52, 32402], [55, 32682], [58, 32802], [62, 32962], [67, 33222], [73, 33522], [77, 33822], [83, 34142], [86, 34422]]}, {"verse": 7, "start": 35496, "end": 39396, "text": "Pero a cada uno le es dada manifestación del Espíritu para provecho.", "words": [[0, 35496], [5, 35640], [7, 35800], [12, 35940], [16, 36260], [19, 36460], [22, 36620], [27, 36860], [41, 37680], [45, 37880], [54, 38500], [59, 38660]]}, {"verse": 8, "start": 39846, "end": 47614, "text": "Porque a la verdad, a este es dada por el Espíritu palabra de sabiduría; a otro, palabra de conocimiento según el mismo Espíritu;", "words": [[0, 39846], [7, 40094], [9, 40174], [12, 40214], [20, 40974], [22, 41254], [27, 41554], [30, 41754], [35, 42034], [39, 42214], [42, 42334], [51, 42814], [59, 43294], [62, 43394], [73, 44434], [75, 44553], [81, 44833], [89, 45313], [92, 45553], [105, 46273], [111, 46573], [114, 46753], [120, 46953]]}, {"verse": 9, "start": 48064, "end": 53495, "text": "A otro, fe por el mismo Espíritu; y a otro, dones de sanidades por el mismo Espíritu;", "words": [[0, 48064], [2, 48209], [8, 48469], [11, 49049], [15, 49289], [18, 49409], [24, 49629], [34, 50602], [36, 50727], [38, 50807], [44, 51067], [50, 51467], [53, 51587], [63, 52127], [67, 52387], [70, 52507], [76, 52727]]}, {"verse": 10, "start": 53945, "end": 64875, "text": "A otro, operaciones de milagros; y a otro, profecía; y a otro, discernimiento de espíritus; y a otro, géneros de lenguas; y a otro, interpretación de lenguas.", "words": [[0, 53945], [2, 54141], [8, 54371], [20, 55271], [23, 55491], [33, 56468], [35, 56593], [37, 56673], [43, 56893], [53, 58035], [55, 58158], [57, 58258], [63, 58538], [78, 59498], [81, 59658], [92, 60694], [94, 60840], [96, 60920], [102, 61560], [110, 61940], [113, 62040], [122, 62929], [124, 63051], [126, 63201], [132, 63351], [147, 64111], [150, 64251]]}, {"verse": 11, "start": 65325, "end": 71665, "text": "Pero todas estas cosas obra uno y el mismo Espíritu, repartiendo individualmente a cada uno como quiere.", "words": [[0, 65325], [5, 65443], [11, 65703], [17, 66003], [23, 66363], [28, 66823], [32, 67183], [34, 67443], [37, 67543], [43, 67823], [53, 68843], [65, 69443], [81, 70303], [83, 70463], [88, 70603], [92, 70903], [97, 71163]]}, {"verse": 12, "start": 72115, "end": 82074, "text": "Porque de la manera que el cuerpo es uno, y tiene muchos miembros, pero todos los miembros del cuerpo, siendo muchos, son un cuerpo, así también Cristo.", "words": [[0, 72115], [7, 72346], [10, 72506], [13, 72626], [20, 72906], [24, 73126], [27, 73266], [34, 73506], [37, 73806], [42, 74106], [44, 74506], [50, 74766], [57, 75066], [67, 76126], [72, 76326], [78, 76566], [82, 76766], [91, 77226], [95, 77366], [103, 78026], [110, 78306], [118, 79126], [122, 79266], [125, 79426], [133, 80026], [137, 80246], [145, 80546]]}, {"verse": 13, "start": 82524, "end": 92319, "text": "Porque por un Espíritu somos todos bautizados en un cuerpo, sean judíos o griegos, sean siervos o libres; y todos hemos bebido de un mismo Espíritu.", "words": [[0, 82524], [7, 82736], [11, 82996], [14, 83116], [23, 83716], [29, 83996], [35, 84356], [46, 85176], [49, 85416], [52, 85536], [60, 86356], [65, 86556], [72, 87236], [74, 87396], [83, 88156], [88, 88546], [96, 88936], [98, 89116], [106, 90014], [108, 90133], [114, 90313], [120, 90613], [127, 91153], [130, 91273], [133, 91373], [139, 91613]]}, {"verse": 14, "start": 92769, "end": 95828, "text": "Pues ni tampoco el cuerpo es un miembro, sino muchos.", "words": [[0, 92769], [5, 92958], [8, 93238], [16, 93578], [19, 93838], [26, 94038], [29, 94318], [32, 94458], [41, 94938], [46, 95178]]}, {"verse": 15, "start": 96278, "end": 102074, "text": "Si dice el pie: Como no soy mano, no soy parte del cuerpo», ¿por eso no sería parte del cuerpo?", "words": [[0, 96278], [3, 96461], [8, 96701], [11, 96841], [16, 97548], [21, 97709], [24, 97869], [28, 98089], [34, 98649], [37, 98749], [41, 98929], [47, 99209], [51, 99449], [60, 100229], [65, 100409], [69, 100589], [72, 100709], [78, 100929], [84, 101249], [88, 101509]]}, {"verse": 16, "start": 102524, "end": 107861, "text": "Y si dice la oreja: Como no soy ojo, no soy parte del cuerpo», ¿por eso no sería parte del cuerpo?", "words": [[0, 102524], [2, 102653], [5, 102773], [10, 103033], [13, 103213], [20, 104023], [25, 104185], [28, 104345], [32, 104545], [37, 105005], [40, 105085], [44, 105265], [50, 105505], [54, 105745], [63, 106245], [68, 106365], [72, 106525], [75, 106645], [81, 106845], [87, 107145], [91, 107385]]}, {"verse": 17, "start": 108311, "end": 114985, "text": "Si todo el cuerpo fuese ojo, ¿dónde estaría el oído? Si todo fuese oído, ¿dónde estaría el olfato?", "words": [[0, 108311], [3, 108459], [8, 108659], [11, 108819], [18, 109059], [24, 109419], [29, 109939], [36, 110139], [44, 110479], [47, 110579], [53, 112019], [56, 112203], [61, 112443], [67, 112823], [73, 113703], [80, 113983], [88, 114323], [91, 114423]]}, {"verse": 18, "start": 115435, "end": 119603, "text": "Pero ahora Dios ha colocado los miembros cada uno de ellos en el cuerpo, como quiso.", "words": [[0, 115435], [5, 115575], [11, 115855], [16, 116135], [19, 116335], [28, 116815], [32, 116955], [41, 117375], [46, 117575], [50, 117795], [53, 117955], [59, 118155], [62, 118315], [65, 118435], [73, 118975], [78, 119115]]}, {"verse": 19, "start": 120053, "end": 122690, "text": "Que si todos fueran un miembro, ¿dónde estuviera el cuerpo?", "words": [[0, 120053], [4, 120133], [7, 120253], [13, 120473], [20, 120873], [23, 120953], [32, 121573], [39, 121753], [49, 122113], [52, 122213]]}, {"verse": 20, "start": 123140, "end": 126301, "text": "Pero ahora son muchos los miembros, pero el cuerpo es uno solo.", "words": [[0, 123140], [5, 123278], [11, 123498], [15, 123778], [22, 124098], [26, 124298], [36, 124878], [41, 124998], [44, 125118], [51, 125358], [54, 125618], [58, 125778]]}, {"verse": 21, "start": 126751, "end": 134339, "text": "Ni el ojo puede decir a la mano: No te necesito: ni asimismo la cabeza a los pies: No tengo necesidad de vosotros.", "words": [[0, 126751], [3, 126876], [6, 127016], [10, 127256], [16, 127476], [22, 127836], [24, 127996], [27, 128076], [33, 128805], [36, 128962], [39, 129062], [49, 130105], [52, 130233], [61, 130753], [64, 130873], [71, 131233], [73, 131453], [77, 131573], [83, 132429], [86, 132606], [92, 132906], [102, 133506], [105, 133626]]}, {"verse": 22, "start": 134789, "end": 139449, "text": "Antes, mucho más los miembros del cuerpo que parecen más débiles, son necesarios;", "words": [[0, 134789], [7, 135196], [13, 135516], [17, 135756], [21, 135936], [30, 136376], [34, 136496], [41, 136816], [45, 137016], [53, 137396], [57, 137636], [66, 138056], [70, 138496]]}, {"verse": 23, "start": 139899, "end": 149920, "text": "Y a aquellos del cuerpo que consideramos menos honrosos, a estos vestimos más dignamente; y a los que en nosotros son menos presentables, los tratamos con mayor decoro.", "words": [[0, 139899], [2, 139941], [4, 140021], [13, 140321], [17, 140541], [24, 140781], [28, 140961], [41, 141601], [47, 142101], [57, 142601], [59, 143021], [65, 143261], [74, 143781], [78, 144021], [90, 145363], [92, 145483], [94, 145543], [98, 145703], [102, 145793], [105, 145883], [114, 146203], [118, 146663], [124, 146903], [138, 148183], [142, 148363], [151, 148823], [155, 149043], [161, 149303]]}, {"verse": 24, "start": 150370, "end": 160050, "text": "Porque los que en nosotros son más presentables, no tienen necesidad: pero Dios ordenó el cuerpo, dando más abundante honor al que le faltaba;", "words": [[0, 150370], [7, 150550], [11, 150750], [15, 150840], [18, 150930], [27, 151290], [31, 151690], [35, 151870], [49, 152630], [52, 153070], [59, 153330], [70, 155540], [75, 155677], [80, 155917], [87, 156477], [90, 156617], [98, 157437], [104, 157697], [108, 158017], [118, 158657], [124, 158917], [127, 159137], [131, 159277], [134, 159377]]}, {"verse": 25, "start": 160500, "end": 166449, "text": "Para que no haya desavenencia en el cuerpo, sino que los miembros todos se interesen los unos por los otros.", "words": [[0, 160500], [5, 160664], [9, 160824], [12, 161004], [17, 161204], [30, 162004], [33, 162124], [36, 162224], [44, 162864], [49, 163164], [53, 163344], [57, 163484], [66, 163964], [72, 164224], [75, 164564], [85, 165064], [89, 165204], [94, 165464], [98, 165724], [102, 165884]]}, {"verse": 26, "start": 166899, "end": 174907, "text": "Por manera que si un miembro padece, todos los miembros a una se duelen; y si un miembro es honrado, todos los miembros a una se gozan.", "words": [[0, 166899], [4, 166991], [11, 167211], [15, 167431], [18, 167591], [21, 167751], [29, 168091], [37, 168991], [43, 169111], [47, 169391], [56, 169644], [58, 169898], [62, 170151], [65, 170371], [73, 171248], [75, 171366], [78, 171466], [81, 171606], [89, 171946], [92, 172066], [101, 172966], [107, 173126], [111, 173386], [120, 173613], [122, 173839], [126, 174066], [129, 174306]]}, {"verse": 27, "start": 175357, "end": 180423, "text": "Pues vosotros sois el cuerpo de Cristo, y cada uno de vosotros es miembro de él.", "words": [[0, 175357], [5, 175565], [14, 176205], [19, 176565], [22, 176665], [29, 176965], [32, 177185], [40, 178005], [42, 178045], [47, 178285], [51, 178545], [54, 178685], [63, 179165], [66, 179485], [74, 179965], [77, 180105]]}, {"verse": 28, "start": 180873, "end": 193750, "text": "Y a unos puso Dios en la iglesia, primeramente apóstoles, luego profetas, lo tercero maestros; luego los que hacen milagros; luego dones de sanidades, ayudas, capacidades de dirección, géneros de lenguas.", "words": [[0, 180873], [2, 180991], [4, 181071], [9, 181271], [14, 181711], [19, 182051], [22, 182191], [25, 182291], [34, 183111], [47, 183731], [58, 184571], [64, 184791], [74, 185731], [77, 185831], [85, 186291], [95, 187331], [101, 187520], [105, 187740], [109, 187880], [115, 188060], [125, 189059], [131, 189201], [137, 189601], [140, 189701], [151, 190581], [159, 191121], [171, 191681], [174, 191841], [185, 192701], [193, 193101], [196, 193201]]}, {"verse": 29, "start": 194200, "end": 200018, "text": "¿Son todos apóstoles? ¿son todos profetas? ¿todos maestros? ¿hacen todos milagros?", "words": [[0, 194200], [5, 194367], [11, 194647], [22, 195767], [27, 195938], [33, 196198], [43, 197298], [50, 197438], [60, 198648], [67, 198888], [73, 199148]]}, {"verse": 30, "start": 200468, "end": 205033, "text": "¿Tienen todos dones de sanidad? ¿hablan todos lenguas? ¿interpretan todos?", "words": [[0, 200468], [8, 200655], [14, 200915], [20, 201435], [23, 201535], [32, 202352], [40, 202653], [46, 202873], [55, 203901], [68, 204521]]}, {"verse": 31, "start": 205483, "end": 209939, "text": "Pero procurad los mejores dones: pero aun yo os muestro un camino más excelente.", "words": [[0, 205483], [5, 205783], [14, 206123], [18, 206263], [26, 206603], [33, 207520], [38, 207662], [42, 207892], [45, 208122], [48, 208352], [56, 208582], [59, 208682], [66, 208982], [70, 209182]]}]}