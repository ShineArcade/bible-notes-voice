{"book": "REV", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 195100, "verses": [{"verse": 1, "start": 300, "end": 10529, "text": "La revelación de Jesucristo, que Dios le dio, para manifestar a sus siervos las cosas que deben suceder pronto; y la declaró, enviándola por su ángel a Juan su siervo,", "words": [[0, 300], [3, 445], [14, 1005], [17, 1145], [29, 1865], [33, 2105], [38, 2325], [41, 2525], [46, 2785], [51, 3305], [62, 3925], [64, 3985], [68, 4105], [76, 4645], [80, 4945], [86, 5305], [90, 5565], [96, 5765], [104, 6265], [112, 7120], [114, 7225], [117, 7325], [126, 7845], [137, 8545], [141, 8705], [144, 8925], [150, 9365], [152, 9545], [157, 9892], [160, 10238]]}, {"verse": 2, "start": 10979, "end": 17773, "text": "El cual ha dado testimonio de la palabra de Dios, y del testimonio de Jesucristo, y de todas las cosas que ha visto.", "words": [[0, 10979], [3, 11115], [8, 11355], [11, 11535], [16, 11715], [27, 12435], [30, 12535], [33, 12635], [41, 12975], [44, 13175], [50, 13455], [52, 14115], [56, 14275], [67, 14855], [70, 14955], [82, 15655], [84, 16115], [87, 16235], [93, 16415], [97, 16655], [103, 16975], [107, 17215], [110, 17295]]}, {"verse": 3, "start": 18223, "end": 26099, "text": "Bienaventurado el que lee, y los que oyen las palabras de esta profecía, y guardan las cosas en ella escritas: porque el tiempo está cerca.", "words": [[0, 18588], [15, 18988], [18, 19108], [22, 19228], [27, 19868], [29, 20128], [33, 20248], [37, 20428], [42, 20648], [46, 20768], [55, 21088], [58, 21308], [63, 21448], [73, 22128], [75, 22508], [83, 22848], [87, 23008], [93, 23248], [96, 23488], [101, 23668], [111, 24732], [118, 24933], [121, 25053], [128, 25253], [133, 25473]]}, {"verse": 4, "start": 26549, "end": 36893, "text": "Juan a las siete iglesias que están en Asia: Gracia sea con vosotros, y paz del que es y que era y que ha de venir, y de los siete Espíritus que están delante de su trono;", "words": [[0, 26549], [5, 26772], [7, 26952], [11, 27132], [17, 27432], [26, 27932], [30, 28072], [36, 28232], [39, 28392], [45, 29552], [52, 29892], [56, 30092], [60, 30332], [70, 31152], [72, 31372], [76, 31592], [80, 31752], [84, 31932], [87, 32212], [89, 32612], [93, 32772], [97, 33012], [99, 33152], [103, 33252], [106, 33372], [109, 33472], [116, 33772], [118, 34352], [121, 34452], [125, 34592], [131, 34832], [141, 35452], [145, 35552], [151, 35752], [159, 36172], [162, 36312], [165, 36432]]}, {"verse": 5, "start": 37343, "end": 47477, "text": "Y de Jesucristo, el testigo fiel, el primogénito de los muertos, y príncipe de los reyes de la tierra. Al que nos amó, y nos ha lavado de nuestros pecados con su sangre,", "words": [[0, 37343], [2, 37343], [5, 37490], [17, 38630], [20, 38710], [28, 39190], [34, 39850], [37, 39890], [49, 40630], [52, 40730], [56, 40850], [65, 41370], [67, 41770], [76, 42290], [79, 42470], [83, 42590], [89, 42930], [92, 43030], [95, 43130], [103, 43985], [106, 44108], [110, 44208], [114, 44348], [119, 44908], [121, 45028], [125, 45168], [128, 45328], [135, 45708], [138, 45808], [147, 45968], [155, 46608], [159, 46788], [162, 46928]]}, {"verse": 6, "start": 47927, "end": 54639, "text": "Y nos ha hecho reyes y sacerdotes para Dios y su Padre; a él sea gloria e imperio para siempre. Amén.", "words": [[0, 47927], [2, 48030], [6, 48170], [9, 48310], [15, 48490], [21, 48930], [23, 49030], [34, 49610], [39, 49870], [44, 50130], [46, 50430], [49, 50550], [56, 51358], [58, 51475], [61, 51615], [65, 51795], [72, 52335], [74, 52555], [82, 53055], [87, 53235], [96, 54192]]}, {"verse": 7, "start": 55089, "end": 64690, "text": "He aquí que viene con las nubes, y todo ojo le verá, y los que le traspasaron; y todos los linajes de la tierra se lamentarán sobre él. Así sea. Amén.", "words": [[0, 55139], [3, 55199], [8, 55359], [12, 55559], [18, 55759], [22, 55959], [26, 56119], [33, 56639], [35, 56879], [40, 57119], [44, 57439], [47, 57579], [53, 57979], [55, 58319], [59, 58479], [63, 58619], [66, 58719], [79, 59884], [81, 59985], [87, 60185], [91, 60425], [99, 60905], [102, 61005], [105, 61125], [112, 61385], [115, 61605], [126, 62205], [132, 62445], [136, 63174], [140, 63395], [145, 64231]]}, {"verse": 8, "start": 64990, "end": 73672, "text": "Yo soy el Alfa y la Omega, principio y fin, dice el Señor, que es y que era y que ha de venir, el Todopoderoso.", "words": [[0, 64990], [3, 65144], [7, 65384], [10, 65584], [15, 65904], [17, 66004], [20, 66084], [27, 66764], [37, 67244], [39, 67524], [44, 69128], [49, 69487], [52, 69647], [59, 69907], [63, 70207], [66, 70527], [68, 70787], [72, 70947], [76, 71207], [78, 71747], [82, 71867], [85, 71987], [88, 72067], [95, 72407], [98, 73057]]}, {"verse": 9, "start": 74122, "end": 85441, "text": "Yo Juan, vuestro hermano, y participante en la tribulación y en el reino, y en la perseverancia de Jesucristo, estaba en la isla que es llamada Patmos, por la palabra de Dios y el testimonio de Jesucristo.", "words": [[0, 74122], [3, 74336], [9, 74556], [17, 74876], [26, 75336], [28, 75436], [41, 76196], [44, 76296], [47, 76376], [59, 76996], [61, 77116], [64, 77176], [67, 77296], [74, 77676], [76, 78076], [79, 78156], [82, 78236], [96, 78916], [99, 79056], [111, 80056], [118, 80356], [121, 80556], [124, 80676], [129, 80976], [133, 81136], [136, 81256], [144, 81616], [152, 82548], [156, 82680], [159, 82780], [167, 83100], [170, 83260], [175, 83520], [177, 83800], [180, 83900], [191, 84520], [194, 84600]]}, {"verse": 10, "start": 85891, "end": 91325, "text": "Yo estaba en el Espíritu en el día del Señor, y oí detrás de mí una gran voz como de trompeta,", "words": [[0, 85891], [3, 86015], [10, 86295], [13, 86495], [16, 86595], [25, 87135], [28, 87235], [31, 87355], [35, 87515], [39, 87675], [46, 88015], [48, 88575], [51, 88835], [58, 89175], [61, 89295], [64, 89455], [68, 89735], [73, 89975], [77, 90255], [82, 90495], [85, 90910]]}, {"verse": 11, "start": 91775, "end": 112796, "text": "Que decía: Yo soy el Alfa y Omega, el primero y el último. Escribe en un libro lo que ves, y envíalo a las siete iglesias que están en Asia; a Éfeso, y a Esmirna, y a Pérgamo, y a Tiatira, y a Sardis, y a Filadelfia, y a Laodicea.", "words": [[0, 91775], [4, 91886], [11, 92816], [14, 93021], [18, 93281], [21, 93521], [26, 93901], [28, 94041], [35, 94961], [38, 95061], [46, 95461], [48, 95721], [51, 95841], [59, 96825], [67, 97332], [70, 97652], [73, 97812], [79, 98132], [82, 98372], [86, 98532], [91, 98812], [93, 99532], [101, 100192], [103, 100452], [107, 100572], [113, 100952], [122, 101672], [126, 101792], [132, 102032], [135, 102192], [141, 103105], [143, 103405], [150, 104005], [152, 104365], [154, 104445], [163, 105665], [165, 105965], [167, 106595], [176, 107225], [178, 107285], [180, 107895], [189, 108505], [191, 108585], [193, 108665], [201, 109705], [203, 109745], [205, 109805], [217, 110845], [219, 111265], [221, 111385]]}, {"verse": 12, "start": 113096, "end": 118259, "text": "Y me volví a ver la voz que hablaba conmigo: y vuelto, vi siete candeleros de oro;", "words": [[0, 113096], [2, 113194], [5, 113294], [11, 113694], [13, 113774], [17, 113954], [20, 114094], [24, 114294], [28, 114434], [36, 114794], [45, 115739], [47, 115844], [55, 116277], [58, 116711], [64, 117144], [75, 117824], [78, 117944]]}, {"verse": 13, "start": 118709, "end": 128317, "text": "Y en medio de los siete candeleros, uno semejante al Hijo del hombre, vestido de una ropa que llegaba hasta los pies, y ceñido por el pecho con una banda de oro.", "words": [[0, 118709], [2, 118809], [5, 118929], [11, 119209], [14, 119389], [18, 119529], [24, 119829], [36, 120969], [40, 121109], [50, 121789], [53, 121929], [58, 122109], [62, 122289], [70, 122989], [78, 123489], [81, 123629], [85, 123769], [90, 124129], [94, 124269], [102, 124689], [108, 124889], [112, 125089], [118, 125922], [120, 126026], [127, 126426], [131, 126626], [134, 126746], [140, 127086], [144, 127266], [148, 127446], [154, 127746], [157, 127926]]}, {"verse": 14, "start": 128767, "end": 135434, "text": "Y su cabeza y sus cabellos eran blancos como la lana blanca, como la nieve; y sus ojos como llama de fuego;", "words": [[0, 128815], [2, 128865], [5, 128985], [12, 129405], [14, 129625], [18, 129765], [27, 130365], [32, 130525], [40, 131125], [45, 131365], [48, 131545], [53, 131825], [61, 132485], [66, 132625], [69, 132805], [76, 133605], [78, 133700], [82, 133820], [87, 134140], [92, 134420], [98, 134680], [101, 134920]]}, {"verse": 15, "start": 135884, "end": 142580, "text": "Y sus pies semejantes al bronce fino, ardientes como en un horno; y su voz como ruido de muchas aguas.", "words": [[0, 135884], [2, 135985], [6, 136145], [11, 136425], [22, 137145], [25, 137345], [32, 137765], [38, 138265], [48, 138765], [53, 139145], [56, 139325], [59, 139485], [66, 140256], [68, 140361], [71, 140541], [75, 140821], [80, 141081], [86, 141461], [89, 141601], [96, 141861]]}, {"verse": 16, "start": 143030, "end": 153704, "text": "Y tenía en su diestra siete estrellas: y de su boca salía una espada aguda de dos filos. Y su rostro era como el sol cuando resplandece en su fuerza.", "words": [[0, 143030], [2, 143149], [8, 143449], [11, 143609], [14, 143769], [22, 144189], [28, 144589], [39, 145793], [41, 145892], [44, 145992], [47, 146132], [52, 146432], [58, 146932], [62, 147112], [69, 147552], [75, 147972], [78, 148152], [82, 148352], [89, 150252], [91, 150354], [94, 150474], [101, 150994], [105, 151134], [110, 151394], [113, 151554], [117, 151794], [124, 152074], [136, 152854], [139, 152954], [142, 153074]]}, {"verse": 17, "start": 154154, "end": 163896, "text": "Y cuando yo le vi, caí como muerto a sus pies. Y él puso su diestra sobre mí, diciéndome: No temas: yo soy el primero y el último;", "words": [[0, 154154], [2, 154252], [9, 154472], [12, 154712], [15, 154852], [19, 155272], [23, 155572], [28, 155752], [35, 156172], [37, 156292], [41, 156432], [47, 157306], [49, 157445], [52, 157565], [57, 157905], [60, 158065], [68, 158485], [74, 158785], [78, 159065], [90, 160690], [93, 161022], [100, 161591], [103, 161794], [107, 162014], [110, 162234], [118, 162754], [120, 163094], [123, 163234]]}, {"verse": 18, "start": 164346, "end": 173517, "text": "Y soy el que vive, y estuve muerto; y he aquí que vivo por siglos de siglos, Amén. Y tengo las llaves del infierno y de la muerte:", "words": [[0, 164346], [2, 164453], [6, 164613], [9, 164873], [13, 165013], [19, 165373], [21, 165973], [28, 166273], [36, 167303], [38, 167507], [41, 167627], [46, 167887], [50, 168087], [55, 168347], [59, 168627], [66, 169067], [69, 169227], [77, 170007], [83, 171002], [85, 171106], [91, 171346], [95, 171546], [102, 171866], [106, 172026], [115, 172566], [117, 172706], [120, 172786], [123, 172886]]}, {"verse": 19, "start": 173967, "end": 179578, "text": "Escribe las cosas que has visto, y las que son, y las que han de ser después de estas:", "words": [[0, 173967], [8, 174383], [12, 174623], [18, 174963], [22, 175223], [26, 175323], [33, 176263], [35, 176463], [39, 176603], [43, 176723], [48, 177583], [50, 177623], [54, 177743], [58, 177923], [62, 178043], [65, 178143], [69, 178383], [77, 178723], [80, 178963]]}, {"verse": 20, "start": 180028, "end": 194700, "text": "El misterio de las siete estrellas que has visto en mi diestra, y los siete candeleros de oro. Las siete estrellas son los ángeles de las siete iglesias; y los siete candeleros que has visto, son las siete iglesias.", "words": [[0, 180028], [3, 180214], [12, 180914], [15, 181054], [19, 181214], [25, 181574], [35, 182314], [39, 182554], [43, 182734], [49, 183174], [52, 183414], [55, 183594], [64, 184094], [66, 184794], [70, 184954], [76, 185234], [87, 185974], [90, 186094], [95, 186830], [99, 187101], [105, 187381], [115, 187921], [119, 188121], [123, 188281], [131, 188801], [134, 188941], [138, 189061], [144, 189301], [154, 190528], [156, 190632], [160, 190772], [166, 191132], [177, 191952], [181, 192072], [185, 192212], [192, 192592], [196, 193272], [200, 193452], [206, 193772]]}]}