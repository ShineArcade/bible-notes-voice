{"book": "PSA", "chapter": 40, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 137084, "verses": [{"verse": 1, "start": 300, "end": 5045, "text": "I waited patiently for the LORD; and he inclined to me, and heard my cry.", "words": [[0, 300], [2, 477], [9, 757], [19, 1317], [23, 1637], [27, 1777], [33, 2617], [37, 2760], [40, 2940], [49, 3340], [52, 3640], [56, 3780], [60, 3960], [66, 4200], [69, 4420]]}, {"verse": 2, "start": 5495, "end": 13261, "text": "He brought me up also out of a horrible pit, out of the miry clay, and set my feet upon a rock, and established my goings.", "words": [[0, 5495], [3, 5602], [11, 5822], [14, 6022], [17, 6182], [22, 6602], [26, 6922], [29, 7042], [31, 7162], [40, 7522], [45, 8002], [49, 8462], [52, 8562], [56, 8852], [61, 9142], [67, 9402], [71, 9962], [75, 10182], [78, 10362], [83, 10662], [88, 10902], [90, 11082], [96, 11442], [100, 11882], [112, 12322], [115, 12622]]}, {"verse": 3, "start": 13711, "end": 21235, "text": "And he has put a new song in my mouth, even praise to our God: many shall see it, and fear, and shall trust in the LORD.", "words": [[0, 13711], [4, 13857], [7, 13997], [11, 14137], [15, 14317], [17, 14477], [21, 14657], [26, 14977], [29, 15177], [32, 15337], [39, 15977], [44, 16217], [51, 16617], [54, 16857], [58, 17017], [63, 17864], [68, 18089], [74, 18369], [78, 18709], [82, 18869], [86, 19109], [92, 19709], [96, 19889], [102, 20109], [108, 20429], [111, 20669], [115, 20789]]}, {"verse": 4, "start": 21685, "end": 28379, "text": "Blessed is that man that makes the LORD his trust, and respects not the proud, nor such as turn aside to lies.", "words": [[0, 21816], [8, 21956], [11, 22116], [16, 22336], [20, 22616], [25, 22836], [31, 23056], [35, 23236], [40, 23476], [44, 23676], [51, 24416], [55, 24576], [64, 24916], [68, 25276], [72, 25456], [79, 26276], [83, 26436], [88, 26736], [91, 26916], [96, 27156], [102, 27516], [105, 27756]]}, {"verse": 5, "start": 28829, "end": 42500, "text": "Many, O LORD my God, are your wonderful works which you have done, and your thoughts which are to us-ward: they cannot be reckoned up in order to you: if I would declare and speak of them, they are more than can be numbered.", "words": [[0, 28829], [6, 29212], [8, 29312], [13, 29552], [16, 29792], [21, 30372], [25, 30492], [30, 30652], [40, 31152], [46, 31592], [52, 31852], [56, 32012], [61, 32152], [67, 33012], [71, 33092], [76, 33232], [85, 33612], [91, 33912], [95, 34112], [98, 34885], [107, 35937], [112, 36040], [119, 36340], [122, 36580], [131, 37000], [134, 37140], [137, 37340], [143, 37500], [146, 37720], [151, 38493], [154, 38661], [156, 38861], [162, 39041], [170, 39461], [174, 39701], [180, 40001], [183, 40261], [189, 40721], [194, 40841], [198, 40981], [203, 41301], [208, 41561], [212, 41761], [215, 41921]]}, {"verse": 6, "start": 42950, "end": 51316, "text": "Sacrifice and offering you did not desire; my ears have you opened: burnt offering and sin offering have you not required.", "words": [[0, 42950], [10, 43570], [14, 43990], [23, 44390], [27, 44670], [31, 44910], [35, 45150], [43, 46261], [46, 46409], [51, 46709], [56, 47009], [60, 47149], [68, 48093], [74, 48223], [83, 48683], [87, 49003], [91, 49283], [100, 49803], [105, 50143], [109, 50323], [113, 50523]]}, {"verse": 7, "start": 51766, "end": 56266, "text": "Then said I, Lo, I come: in the volume of the book it is written of me,", "words": [[0, 51766], [5, 51990], [10, 52410], [13, 52650], [17, 53050], [19, 53130], [25, 53940], [28, 54066], [32, 54166], [39, 54546], [42, 54746], [46, 54866], [51, 55106], [54, 55246], [57, 55366], [65, 55606], [68, 55866]]}, {"verse": 8, "start": 56716, "end": 61559, "text": "I delight to do your will, O my God: yes, your law is within my heart.", "words": [[0, 56716], [2, 56918], [10, 57218], [13, 57518], [16, 57658], [21, 57818], [27, 58098], [29, 58378], [32, 58578], [37, 59446], [42, 59996], [47, 60076], [51, 60356], [54, 60576], [61, 60816], [64, 61076]]}, {"verse": 9, "start": 62009, "end": 68148, "text": "I have preached righteousness in the great congregation: lo, I have not refrained my lips, O LORD, you know.", "words": [[0, 62009], [2, 62134], [7, 62254], [16, 62534], [30, 63134], [33, 63434], [37, 63534], [43, 63754], [57, 65056], [61, 65126], [63, 65326], [68, 65526], [72, 65706], [82, 66246], [85, 66446], [91, 66806], [93, 67166], [99, 67686], [103, 67746]]}, {"verse": 10, "start": 68598, "end": 79395, "text": "I have not hid your righteousness within my heart; I have declared your faithfulness and your salvation: I have not concealed your lovingkindness and your truth from the great congregation.", "words": [[0, 68598], [2, 68744], [7, 68884], [11, 69084], [15, 69344], [20, 69564], [34, 70044], [41, 70464], [44, 70744], [51, 71480], [53, 71605], [58, 71745], [67, 72145], [72, 72365], [85, 73125], [89, 73385], [94, 73525], [105, 74558], [107, 74738], [112, 74918], [116, 75118], [126, 75678], [131, 76268], [146, 76858], [150, 77078], [155, 77238], [161, 77598], [166, 77878], [170, 78018], [176, 78298]]}, {"verse": 11, "start": 79845, "end": 87453, "text": "Withhold not you your tender mercies from me, O LORD: let your lovingkindness and your truth continually preserve me.", "words": [[0, 79845], [9, 80290], [13, 80570], [17, 80950], [22, 81190], [29, 81510], [37, 82110], [42, 82310], [46, 82690], [48, 82790], [54, 83587], [58, 83947], [63, 84477], [78, 85007], [82, 85187], [87, 85347], [93, 85727], [105, 86447], [114, 86907]]}, {"verse": 12, "start": 87903, "end": 99750, "text": "For innumerable evils have compassed me about: my iniquities have taken hold upon me, so that I am not able to look up; they are more than the hairs of my head: therefore my heart fails me.", "words": [[0, 87973], [4, 88053], [16, 88673], [22, 89133], [27, 89253], [37, 89833], [40, 89913], [47, 90791], [50, 90975], [61, 91555], [66, 91695], [72, 91955], [77, 92295], [82, 92635], [86, 92895], [89, 93375], [94, 93555], [96, 93695], [99, 93815], [103, 94035], [108, 94355], [111, 94575], [116, 94735], [120, 95423], [125, 95610], [129, 95750], [134, 96030], [139, 96270], [143, 96430], [149, 96650], [152, 96870], [155, 97050], [161, 97832], [171, 98395], [174, 98555], [180, 98875], [186, 99315]]}, {"verse": 13, "start": 100200, "end": 104843, "text": "Be pleased, O LORD, to deliver me: O LORD, make haste to help me.", "words": [[0, 100200], [3, 100304], [12, 100884], [14, 101024], [20, 101504], [23, 101604], [31, 101964], [35, 102680], [37, 102826], [43, 103406], [48, 103526], [54, 104146], [57, 104286], [62, 104486]]}, {"verse": 14, "start": 105293, "end": 115267, "text": "Let them be ashamed and confounded together that seek after my soul to destroy it; let them be driven backward and put to shame that wish me evil.", "words": [[0, 105293], [4, 105629], [9, 105869], [12, 106049], [20, 106489], [24, 106769], [35, 107429], [44, 107869], [49, 108229], [54, 108509], [60, 108889], [63, 109109], [68, 109469], [71, 109669], [79, 110129], [83, 111376], [87, 111490], [92, 111710], [95, 111890], [102, 112210], [111, 112750], [115, 113290], [119, 113470], [122, 113670], [128, 114010], [133, 114290], [138, 114510], [141, 114730]]}, {"verse": 15, "start": 115717, "end": 120673, "text": "Let them be desolate for a reward of their shame that say to me, Aha, aha.", "words": [[0, 115717], [4, 115865], [9, 116085], [12, 116245], [21, 116805], [25, 117065], [27, 117185], [34, 117605], [37, 117765], [43, 117945], [49, 118365], [54, 118625], [58, 118865], [61, 119065], [65, 120028], [70, 120354]]}, {"verse": 16, "start": 121023, "end": 128578, "text": "Let all those that seek you rejoice and be glad in you: let such as love your salvation say continually, The LORD be magnified.", "words": [[0, 121023], [4, 121131], [8, 121371], [14, 121651], [19, 121871], [24, 122131], [28, 122271], [36, 122691], [40, 122991], [43, 123111], [48, 123411], [51, 123631], [56, 124213], [60, 124376], [65, 124636], [68, 124816], [73, 125