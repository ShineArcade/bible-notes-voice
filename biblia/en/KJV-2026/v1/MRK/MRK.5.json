{"book": "MRK", "chapter": 5, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 310323, "verses": [{"verse": 1, "start": 300, "end": 4824, "text": "And they came over to the other side of the sea, into the country of the Gadarenes.", "words": [[0, 300], [4, 442], [9, 542], [14, 742], [19, 1002], [22, 1202], [26, 1342], [32, 1582], [37, 1922], [40, 2082], [44, 2182], [49, 2762], [54, 3141], [58, 3322], [66, 3702], [69, 3902], [73, 4362]]}, {"verse": 2, "start": 5274, "end": 11802, "text": "And when he was come out of the ship, immediately there met him out of the tombs a man with an unclean spirit,", "words": [[0, 5274], [4, 5405], [9, 5565], [12, 5725], [16, 5885], [21, 6065], [25, 6285], [28, 6385], [32, 6525], [38, 7145], [50, 7665], [56, 8125], [60, 8325], [64, 8525], [68, 8725], [71, 8825], [75, 8925], [81, 9865], [83, 9965], [87, 10205], [92, 10445], [95, 10565], [103, 11145]]}, {"verse": 3, "start": 12252, "end": 18031, "text": "Who had his dwelling among the tombs; and no man could bind him, no, not with chains:", "words": [[0, 12252], [4, 12367], [8, 12587], [12, 12787], [21, 13187], [27, 13507], [31, 13747], [38, 14695], [42, 14842], [45, 15042], [49, 15302], [55, 15522], [60, 15842], [65, 16362], [69, 16982], [73, 17182], [78, 17362]]}, {"verse": 4, "start": 18481, "end": 28473, "text": "Because that he had been often bound with fetters and chains, and the chains had been plucked asunder by him, and the fetters broken in pieces: neither could any man tame him.", "words": [[0, 18481], [8, 18688], [13, 18968], [16, 19108], [20, 19208], [25, 19348], [31, 19688], [37, 20168], [42, 20488], [50, 20908], [54, 21108], [62, 21968], [66, 22108], [70, 22208], [77, 22508], [81, 22728], [86, 22888], [94, 23328], [102, 23628], [105, 23908], [110, 24468], [114, 24608], [118, 24748], [126, 25068], [133, 25468], [136, 25688], [144, 26672], [152, 26913], [158, 27213], [162, 27473], [166, 27753], [171, 28053]]}, {"verse": 5, "start": 28923, "end": 35334, "text": "And always, night and day, he was in the mountains, and in the tombs, crying, and cutting himself with stones.", "words": [[0, 28923], [4, 29051], [12, 29391], [18, 29791], [22, 30051], [27, 30351], [30, 30611], [34, 30791], [37, 30951], [41, 31051], [52, 31391], [56, 31831], [59, 31971], [63, 32071], [70, 32571], [78, 32951], [82, 33671], [90, 33951], [98, 34311], [103, 34631]]}, {"verse": 6, "start": 35784, "end": 39786, "text": "But when he saw Jesus afar off, he ran and worshipped him,", "words": [[0, 35784], [4, 35887], [9, 36047], [12, 36187], [16, 36467], [22, 36867], [27, 37327], [32, 37807], [35, 37907], [39, 38227], [43, 38607], [54, 38987]]}, {"verse": 7, "start": 40236, "end": 49172, "text": "And cried with a loud voice, and said, What have I to do with you, Jesus, you Son of the most high God? I adjure you by God, that you torment me not.", "words": [[0, 40236], [4, 40375], [10, 40735], [15, 41015], [17, 41175], [22, 41475], [29, 42015], [33, 42295], [39, 43028], [44, 43167], [49, 43287], [51, 43407], [54, 43567], [57, 43707], [62, 43907], [67, 44187], [74, 44887], [78, 44947], [82, 45187], [85, 45327], [89, 45427], [94, 45567], [99, 45847], [104, 46603], [106, 46743], [113, 47123], [117, 47243], [120, 47443], [125, 47723], [130, 47983], [134, 48123], [142, 48423], [145, 48743]]}, {"verse": 8, "start": 49522, "end": 54196, "text": "For he said to him, Come out of the man, you unclean spirit.", "words": [[0, 49522], [4, 49655], [7, 49815], [12, 50055], [15, 50255], [20, 51637], [25, 51781], [29, 52021], [32, 52121], [36, 52241], [41, 52981], [45, 53081], [53, 53681]]}, {"verse": 9, "start": 54546, "end": 65132, "text": "And he asked him, What is your name? And he answered, saying, My name is Legion: for we are many.", "words": [[0, 54546], [4, 54671], [7, 54791], [13, 55131], [18, 55760], [23, 55937], [26, 56057], [31, 56197], [35, 59214], [37, 60755], [41, 60893], [44, 61053], [54, 61453], [62, 62808], [65, 63008], [70, 63228], [73, 63448], [81, 64294], [85, 64465], [88, 64645], [92, 64765]]}, {"verse": 10, "start": 65482, "end": 69411, "text": "And he besought him much that he would not send them away out of the country.", "words": [[0, 65482], [4, 65616], [7, 65716], [16, 66176], [20, 66376], [25, 66696], [30, 66956], [33, 67096], [39, 67276], [43, 67496], [48, 67836], [53, 68056], [58, 68376], [62, 68636], [65, 68756], [69, 68856]]}, {"verse": 11, "start": 69861, "end": 73640, "text": "Now there was there near to the mountains a great herd of swine feeding.", "words": [[0, 69861], [4, 70069], [10, 70249], [14, 70469], [20, 70909], [25, 71049], [28, 71229], [32, 71369], [42, 71929], [44, 72009], [50, 72209], [55, 72529], [58, 72709], [64, 73149]]}, {"verse": 12, "start": 74090, "end": 80107, "text": "And all the demons besought him, saying, Send us into the swine, that we may enter into them.", "words": [[0, 74090], [4, 74213], [8, 74493], [12, 74673], [19, 75073], [28, 75613], [33, 75913], [41, 77451], [46, 77586], [49, 77766], [54, 77966], [58, 78126], [65, 78586], [70, 78846], [73, 79046], [77, 79226], [83, 79566], [88, 79826]]}, {"verse": 13, "start": 80457, "end": 94030, "text": "And forthwith Jesus gave them leave. And the unclean spirits went out, and entered into the swine: and the herd ran violently down a steep place into the sea, (they were about two thousand;) and were choked in the sea.", "words": [[0, 80457], [4, 80585], [14, 81265], [20, 81605], [25, 82065], [30, 82325], [37, 83258], [41, 83399], [45, 83499], [53, 84079], [61, 84599], [66, 84859], [71, 85119], [75, 85659], [83, 85979], [88, 86279], [92, 86459], [99, 87406], [103, 87559], [107, 87659], [112, 87899], [116, 88259], [126, 88799], [131, 89119], [133, 89299], [139, 89459], [145, 89819], [150, 90139], [154, 90279], [159, 90959], [165, 91099], [170, 91279], [176, 91606], [180, 91932], [191, 92259], [195, 92859], [200, 93019], [207, 93339], [210, 93539], [214, 93639]]}, {"verse": 14, "start": 94480, "end": 101973, "text": "And they that fed the swine fled, and told it in the city, and in the country. And they went out to see what it was that was done.", "words": [[0, 94480], [4, 94626], [9, 94786], [14, 95046], [18, 95326], [22, 95526], [28, 95926], [34, 96226], [38, 96806], [43, 97106], [46, 97286], [49, 97446], [53, 97546], [59, 97826], [63, 98366], [66, 98506], [70, 98626], [79, 99467], [83, 99610], [88, 99730], [93, 99930], [97, 100090], [100, 100270], [104, 100450], [109, 100690], [112, 100790], [116, 101050], [121, 101270], [125, 101470]]}, {"verse": 15, "start": 102423, "end": 111489, "text": "And they come to Jesus, and see him that was demon-possessed, and had the legion, sitting, and clothed, and in his right mind: and they were afraid.", "words": [[0, 102423], [4, 102564], [9, 102664], [14, 102864], [17, 103024], [24, 103424], [28, 104084], [32, 104324], [36, 104504], [41, 104724], [45, 105364], [62, 106004], [66, 106484], [70, 106644], [74, 106824], [82, 107244], [91, 107704], [95, 108104], [104, 108764], [108, 108924], [111, 109064], [115, 109224], [121, 109464], [127, 110317], [131, 110461], [136, 110601], [141, 110841]]}, {"verse": 16, "start": 111939, "end": 118280, "text": "And they that saw it told them how it befell to him that was demon-possessed, and also concerning the swine.", "words": [[0, 111939], [4, 112108], [9, 112268], [14, 112488], [18, 112788], [21, 112928], [26, 113188], [31, 113468], [35, 113688], [38, 113828], [45, 114268], [48, 114468], [52, 114688], [57, 114908], [61, 115678], [78, 116448], [82, 116648], [87, 116928], [98, 117408], [102, 117688]]}, {"verse": 17, "start": 118730, "end": 121655, "text": "And they began to pray him to depart out of their coasts.", "words": [[0, 118730], [4, 118854], [9, 118954], [15, 119274], [18, 119454], [23, 119674], [27, 119934], [30, 120094], [37, 120414], [41, 120654], [44, 120774], [50, 120914]]}, {"verse": 18, "start": 122105, "end": 127438, "text": "And when he was come into the ship, he that had been demon-possessed prayed him that he might be with him.", "words": [[0, 122105], [4, 122239], [9, 122399], [12, 122559], [16, 122719], [21, 122919], [26, 123099], [30, 123259], [36, 123899], [39, 124039], [44, 124239], [48, 124379], [53, 124969], [69, 125559], [76, 125899], [80, 126159], [85, 126339], [88, 126459], [94, 126679], [97, 126879], [102, 127139]]}, {"verse": 19, "start": 127888, "end": 136953, "text": "However Jesus did not permit him, but says to him, Go home to your friends, and tell them how great things the Lord has done for you, and has had compassion on you.", "words": [[0, 127888], [8, 128330], [14, 128610], [18, 128970], [22, 129170], [29, 129530], [34, 130170], [38, 130290], [43, 130530], [46, 130750], [51, 131369], [54, 131507], [59, 131727], [62, 131887], [67, 131987], [76, 132347], [80, 132947], [85, 133147], [90, 133307], [94, 133447], [100, 133707], [107, 134007], [111, 134207], [116, 134367], [120, 134567], [125, 134787], [129, 134947], [134, 135167], [138, 135647], [142, 135787], [146, 135947], [157, 136327], [160, 136667]]}, {"verse": 20, "start": 137303, "end": 144399, "text": "And he departed, and began to publish in Decapolis how great things Jesus had done for him: and all men did marvel.", "words": [[0, 137303], [4, 137423], [7, 137543], [17, 138023], [21, 138363], [27, 138683], [30, 138843], [38, 139143], [41, 139363], [51, 139983], [55, 140263], [61, 140643], [68, 140963], [74, 141323], [78, 141643], [83, 141883], [87, 142083], [92, 142745], [96, 142872], [100, 143132], [104, 143432], [108, 143732]]}, {"verse": 21, "start": 144849, "end": 152126, "text": "And when Jesus was passed over again by ship to the other side, much people gathered to him: and he was near to the sea.", "words": [[0, 144849], [4, 144971], [9, 145131], [15, 145451], [19, 145771], [26, 146071], [31, 146411], [37, 146751], [40, 147011], [45, 147291], [48, 147491], [52, 147611], [58, 147751], [64, 148731], [69, 149011], [76, 149391], [85, 149791], [88, 150051], [93, 150685], [97, 150822], [100, 150942], [104, 151122], [109, 151342], [112, 151522], [116, 151642]]}, {"verse": 22, "start": 152576, "end": 159578, "text": "And, behold, there comes one of the rulers of the synagogue, Jairus by name; and when he saw him, he fell at his feet,", "words": [[0, 152576], [5, 152721], [13, 153461], [19, 153701], [25, 153941], [29, 154261], [32, 154361], [36, 154501], [43, 154821], [46, 155101], [50, 155221], [61, 155831], [68, 156441], [71, 156661], [77, 157524], [81, 157604], [86, 157764], [89, 157884], [93, 158124], [98, 158464], [101, 158544], [106, 158784], [109, 158964], [113, 159124]]}, {"verse": 23, "start": 160028, "end": 169606, "text": "And besought him greatly, saying, My little daughter lies at the point of death: please, come and lay your hands on her, that she may be healed; and she shall live.", "words": [[0, 160028], [4, 160165], [13, 160585], [17, 160745], [26, 161345], [34, 162690], [37, 162815], [44, 163055], [53, 163395], [58, 163735], [61, 163995], [65, 164095], [71, 164295], [74, 164395], [81, 164989], [89, 165627], [94, 165987], [98, 166207], [102, 166367], [107, 166507], [113, 166727], [116, 166907], [121, 167107], [126, 167427], [130, 167607], [134, 167767], [137, 167887], [145, 168656], [149, 168756], [153, 168956], [159, 169176]]}, {"verse": 24, "start": 169956, "end": 173969, "text": "And Jesus went with him; and much people followed him, and thronged him.", "words": [[0, 169956], [4, 170088], [10, 170368], [15, 170728], [20, 171028], [25, 171625], [29, 171750], [34, 171970], [41, 172310], [50, 172790], [55, 173070], [59, 173230], [68, 173710]]}, {"verse": 25, "start": 174419, "end": 177809, "text": "And a certain woman, which had an issue of blood twelve years,", "words": [[0, 174419], [4, 174539], [6, 174659], [14, 174919], [21, 175319], [27, 175619], [31, 175819], [34, 175919], [40, 176179], [43, 176379], [49, 176719], [56, 177059]]}, {"verse": 26, "start": 178259, "end": 186148, "text": "And had suffered many things of many physicians, and had spent all that she had, and was nothing bettered, but rather grew worse,", "words": [[0, 178259], [4, 178386], [8, 178546], [17, 178926], [22, 179466], [29, 179886], [32, 180146], [37, 180446], [49, 181586], [53, 181666], [57, 181826], [63, 182066], [67, 182426], [72, 182646], [76, 182826], [81, 183166], [85, 183446], [89, 183646], [97, 183906], [107, 184706], [111, 184866], [118, 185146], [123, 185446]]}, {"verse": 27, "start": 186598, "end": 191158, "text": "When she had heard of Jesus, came in the press behind, and touched his garment.", "words": [[0, 186598], [5, 186736], [9, 186896], [13, 187076], [19, 187256], [22, 187416], [29, 188256], [34, 188536], [37, 188716], [41, 188816], [47, 189056], [55, 189476], [59, 190076], [67, 190376], [71, 190576]]}, {"verse": 28, "start": 191608, "end": 196082, "text": "For she said, If I may touch but his clothes, I shall be whole.", "words": [[0, 191608], [4, 191731], [8, 191912], [14, 192733], [17, 192879], [19, 193039], [23, 193179], [29, 193559], [33, 193819], [37, 193979], [46, 194919], [48, 195179], [54, 195399], [57, 195559]]}, {"verse": 29, "start": 196432, "end": 202560, "text": "And immediately the fountain of her blood was dried up; and she felt in her body that she was healed of that plague.", "words": [[0, 196432], [4, 196569], [16, 196949], [20, 197349], [29, 197689], [32, 197949], [36, 198069], [42, 198369], [46, 198589], [52, 198869], [56, 199570], [60, 199697], [64, 199967], [69, 200237], [72, 200337], [76, 200457], [81, 200797], [86, 201037], [90, 201217], [94, 201397], [101, 201677], [104, 201897], [109, 202057]]}, {"verse": 30, "start": 203010, "end": 211385, "text": "And Jesus, immediately knowing in himself that power had gone out of him, turned him about in the press, and said, Who touched my clothes?", "words": [[0, 203010], [4, 203159], [11, 203519], [23, 204159], [31, 204779], [34, 205039], [42, 205439], [47, 205739], [53, 206099], [57, 206339], [62, 206559], [66, 206839], [69, 206999], [74, 207419], [81, 207879], [85, 208119], [91, 208399], [94, 208619], [98, 208719], [105, 209079], [109, 209319], [115, 210072], [119, 210180], [127, 210400], [130, 210640]]}, {"verse": 31, "start": 211735, "end": 219151, "text": "And his disciples said to him, You see the multitude thronging you, and do you say, Who touched me?", "words": [[0, 211735], [4, 211860], [8, 211980], [18, 212520], [23, 212820], [26, 212980], [31, 215928], [35, 216004], [39, 216144], [43, 216284], [53, 216774], [63, 217264], [68, 217444], [72, 217764], [75, 217924], [79, 218044], [84, 218344], [88, 218584], [96, 218844]]}, {"verse": 32, "start": 219501, "end": 222860, "text": "And he looked round about to see her that had done this thing.", "words": [[0, 219501], [4, 219626], [7, 219746], [14, 219986], [20, 220286], [26, 220626], [29, 220906], [33, 221166], [37, 221406], [42, 221666], [46, 221786], [51, 222066], [56, 222346]]}, {"verse": 33, "start": 223310, "end": 230290, "text": "But the woman fearing and trembling, knowing what was done in her, came and fell down before him, and told him all the truth.", "words": [[0, 223310], [4, 223418], [8, 223558], [14, 223998], [22, 224398], [26, 224538], [37, 224938], [45, 225378], [50, 225658], [54, 225838], [59, 226058], [62, 226198], [67, 226838], [72, 227058], [76, 227258], [81, 227518], [86, 227798], [93, 228098], [98, 228858], [102, 228938], [107, 229178], [111, 229398], [115, 229618], [119, 229778]]}, {"verse": 34, "start": 230740, "end": 237736, "text": "And he said to her, Daughter, your faith has made you whole; go in peace, and be whole of your plague.", "words": [[0, 230740], [4, 230740], [7, 231160], [12, 231380], [15, 231620], [20, 233512], [30, 233872], [35, 233932], [41, 234192], [45, 234452], [50, 234692], [54, 234852], [61, 235596], [64, 235700], [67, 235860], [74, 236160], [78, 236560], [81, 236720], [87, 236940], [90, 237120], [95, 237220]]}, {"verse": 35, "start": 238086, "end": 247009, "text": "While he yet spoke, there came from the ruler of the synagogue’s house certain which said, Your daughter is dead: why do you trouble the Master any further?", "words": [[0, 238086], [6, 238314], [9, 238534], [13, 238734], [20, 239734], [26, 239934], [31, 240254], [36, 240574], [40, 240734], [46, 241074], [49, 241354], [53, 241474], [65, 242174], [71, 242394], [79, 242754], [85, 243074], [91, 243919], [96, 244038], [105, 244298], [108, 244518], [114, 245152], [118, 245291], [121, 245431], [125, 245511], [133, 245791], [137, 245951], [144, 246211], [148, 246511]]}, {"verse": 36, "start": 247359, "end": 254280, "text": "As soon as Jesus heard the word that was spoken, he says to the ruler of the synagogue, Be not afraid, only believe.", "words": [[0, 247359], [3, 247489], [8, 247749], [11, 247869], [17, 248129], [23, 248509], [27, 248669], [32, 248909], [37, 249049], [41, 249169], [49, 250089], [52, 250209], [57, 250469], [60, 250689], [64, 250829], [70, 251089], [73, 251309], [77, 251409], [88, 252389], [91, 252490], [95, 252650], [103, 253330], [108, 253550]]}, {"verse": 37, "start": 254630, "end": 259754, "text": "And he permitted no one to follow him, save Peter, and James, and John the brother of James.", "words": [[0, 254630], [4, 254764], [7, 254864], [17, 255204], [20, 255504], [24, 255704], [27, 255844], [34, 256124], [39, 256644], [44, 256884], [51, 257204], [55, 257524], [62, 257864], [66, 258204], [71, 258504], [75, 258684], [83, 258904], [86, 259144]]}, {"verse": 38, "start": 260204, "end": 267109, "text": "And he comes to the house of the ruler of the synagogue, and sees the tumult, and them that wept and wailed greatly.", "words": [[0, 260204], [4, 260306], [7, 260426], [13, 260706], [16, 260906], [20, 261046], [26, 261286], [29, 261466], [33, 261606], [39, 261866], [42, 262106], [46, 262206], [57, 262706], [61, 263326], [66, 263606], [70, 263846], [78, 264366], [82, 264826], [87, 265126], [92, 265386], [97, 265806], [101, 266006], [108, 266426]]}, {"verse": 39, "start": 267559, "end": 274646, "text": "And when he was come in, he says to them, Why do you make this commotion, and weep? the girl is not dead, but sleeps.", "words": [[0, 267559], [4, 267699], [9, 267859], [12, 268019], [16, 268199], [21, 268459], [25, 268959], [28, 269059], [33, 269299], [36, 269539], [42, 270161], [46, 270330], [49, 270490], [53, 270590], [58, 270770], [63, 270990], [74, 271490], [78, 271890], [84, 272694], [88, 272776], [93, 273016], [96, 273196], [100, 273396], [106, 273876], [110, 273956]]}, {"verse": 40, "start": 274996, "end": 285521, "text": "And they laughed him to scorn. But when he had put them all out, he takes the father and the mother of the girl, and them that were with him, and enters in where the girl was lying.", "words": [[0, 274996], [4, 275154], [9, 275294], [17, 275654], [21, 275954], [24, 276134], [31, 277088], [35, 277209], [40, 277429], [43, 277649], [47, 277769], [51, 277949], [56, 278169], [60, 278369], [65, 278949], [68, 279109], [74, 279409], [78, 279609], [85, 279929], [89, 280229], [93, 280349], [100, 280569], [103, 280769], [107, 280869], [113, 281189], [117, 281749], [122, 281989], [127, 282229], [132, 282369], [137, 282629], [142, 283295], [146, 283444], [153, 283844], [156, 284104], [162, 284284], [166, 284444], [171, 284704], [175, 284924]]}, {"verse": 41, "start": 285971, "end": 295684, "text": "And he took the girl by the hand, and said to her, Talitha cumi; which is, being interpreted, Girl, I say to you, arise.", "words": [[0, 285971], [4, 286115], [7, 286215], [12, 286395], [16, 286575], [21, 286795], [24, 287015], [28, 287155], [34, 287535], [38, 287795], [43, 288055], [46, 288295], [51, 289181], [59, 289545], [65, 290200], [71, 290369], [75, 290549], [81, 290809], [94, 293424], [100, 293644], [102, 293984], [106, 294244], [109, 294444], [114, 294984]]}, {"verse": 42, "start": 296034, "end": 303648, "text": "And immediately the girl arose, and walked; for she was of the age of twelve years. And they were astonished with a great astonishment.", "words": [[0, 296034], [4, 296159], [16, 296519], [20, 296899], [25, 297159], [32, 297599], [36, 297959], [44, 298853], [48, 298955], [52, 299095], [56, 299275], [59, 299415], [63, 299575], [67, 299795], [70, 300025], [77, 300255], [84, 301266], [88, 301405], [93, 301505], [98, 301665], [109, 302325], [114, 302465], [116, 302585], [122, 302785]]}, {"verse": 43, "start": 304098, "end": 309923, "text": "And he charged them sternly that no man should know it; and commanded that something should be given her to eat.", "words": [[0, 304098], [4, 304225], [7, 304305], [15, 304665], [20, 304945], [28, 305545], [33, 305745], [36, 305985], [40, 306265], [47, 306545], [52, 306805], [56, 307355], [60, 307478], [70, 307878], [75, 308218], [85, 308518], [92, 308818], [95, 308998], [101, 309218], [105, 309418], [108, 309538]]}]}