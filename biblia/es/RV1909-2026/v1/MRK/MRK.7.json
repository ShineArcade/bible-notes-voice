{"book": "MRK", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 305801, "verses": [{"verse": 1, "start": 300, "end": 6667, "text": "Y se juntaron a él los fariseos, y algunos de los escribas, que habían venido de Jerusalén;", "words": [[0, 300], [2, 465], [5, 545], [14, 1145], [16, 1305], [19, 1485], [23, 1745], [33, 2585], [35, 3125], [43, 3485], [46, 3705], [50, 3845], [60, 4485], [64, 4865], [71, 5165], [78, 5685], [81, 5845]]}, {"verse": 2, "start": 7017, "end": 14682, "text": "Los cuales, viendo a algunos de sus discípulos comer pan con manos impuras, es decir, no lavadas, los criticaban.", "words": [[0, 7017], [4, 7142], [12, 7682], [19, 7852], [21, 8022], [29, 8482], [32, 8702], [36, 8882], [47, 9542], [53, 9842], [57, 10182], [61, 10442], [67, 10722], [76, 11802], [79, 11862], [86, 12642], [89, 12782], [98, 13382], [102, 13702]]}, {"verse": 3, "start": 15032, "end": 23873, "text": "(Porque los fariseos y todos los judíos, teniendo la tradición de los ancianos, si muchas veces no se lavan las manos, no comen.", "words": [[0, 15032], [8, 15295], [12, 15475], [21, 16215], [23, 16375], [29, 16635], [33, 16895], [41, 17875], [50, 18435], [53, 18595], [63, 19195], [66, 19375], [70, 19495], [80, 20535], [83, 20635], [90, 20895], [96, 21335], [99, 21695], [102, 21895], [108, 22295], [112, 22435], [119, 23015], [122, 23175]]}, {"verse": 4, "start": 24223, "end": 38003, "text": "Y volviendo de la plaza, si no se lavan, no comen. Y otras muchas cosas hay, que tomaron para guardar, como las lavaduras de los vasos de beber, y de los jarros, y de los recipientes de metal, y de las camas.)", "words": [[0, 24223], [2, 24348], [12, 24828], [15, 24988], [18, 25108], [25, 25528], [28, 25708], [31, 25868], [34, 26008], [41, 26728], [44, 26968], [51, 27896], [53, 28021], [59, 28201], [66, 28501], [72, 28961], [77, 29461], [81, 29881], [89, 30321], [94, 30561], [103, 31341], [108, 31681], [112, 31941], [122, 32681], [125, 32841], [129, 32981], [135, 33361], [138, 33461], [145, 33741], [147, 34181], [150, 34281], [154, 34421], [162, 34981], [164, 35301], [167, 35401], [171, 35521], [183, 36121], [186, 36261], [193, 37029], [195, 37149], [198, 37229], [202, 37349]]}, {"verse": 5, "start": 38353, "end": 48201, "text": "Y le preguntaron los fariseos y los escribas: ¿Por qué tus discípulos no andan conforme a la tradición de los ancianos, sino que comen pan con manos impuras?", "words": [[0, 38353], [2, 38476], [5, 38576], [17, 39256], [21, 39416], [30, 40176], [32, 40316], [36, 40456], [46, 41543], [51, 41663], [55, 41843], [59, 42043], [70, 42683], [73, 42943], [79, 43243], [88, 43763], [90, 43823], [93, 43863], [103, 44403], [106, 44543], [110, 44663], [120, 45763], [125, 45963], [129, 46163], [135, 46403], [139, 46783], [143, 47023], [149, 47323]]}, {"verse": 6, "start": 48481, "end": 61244, "text": "Y respondiendo él, les dijo: Hipócritas, bien profetizó de vosotros Isaías, como está escrito: Este pueblo con los labios me honra, pero su corazón lejos está de mí.", "words": [[0, 48481], [2, 48602], [15, 49442], [19, 49842], [23, 50242], [29, 51054], [41, 52361], [46, 52741], [56, 53661], [59, 53801], [68, 54321], [76, 55418], [81, 55608], [86, 55798], [95, 56740], [100, 56929], [107, 57309], [111, 57589], [115, 57769], [122, 58189], [125, 58409], [132, 58789], [137, 59029], [140, 59209], [148, 60029], [154, 60489], [159, 60769], [162, 60969]]}, {"verse": 7, "start": 61594, "end": 66852, "text": "Y en vano me honran, enseñando como doctrinas mandamientos de hombres.", "words": [[0, 61594], [2, 61736], [5, 61876], [10, 62216], [13, 62356], [21, 62936], [31, 64236], [36, 64496], [46, 65196], [59, 65856], [62, 66076]]}, {"verse": 8, "start": 67202, "end": 79474, "text": "Porque dejando el mandamiento de Dios, tenéis la tradición de los hombres; las lavaduras de los jarros y de los vasos de beber: y hacéis otras muchas cosas semejantes.", "words": [[0, 67202], [7, 67761], [15, 68441], [18, 68561], [30, 69241], [33, 69441], [39, 70181], [46, 70681], [49, 70941], [59, 71561], [62, 71701], [66, 71861], [75, 72803], [79, 73261], [89, 74161], [92, 74301], [96, 74421], [103, 74981], [105, 75161], [108, 75261], [112, 75381], [118, 75801], [121, 76113], [128, 76592], [130, 76881], [137, 77211], [143, 77711], [150, 78091], [156, 78451]]}, {"verse": 9, "start": 79824, "end": 86538, "text": "Les decía también: Bien invalidáis el mandamiento de Dios para guardar vuestra tradición.", "words": [[0, 79824], [4, 79972], [10, 80352], [19, 81351], [24, 81675], [35, 82735], [38, 82895], [50, 83595], [53, 83775], [58, 84075], [63, 84715], [71, 85315], [79, 85675]]}, {"verse": 10, "start": 86888, "end": 95676, "text": "Porque Moisés dijo: Honra a tu padre y a tu madre, y: El que maldiga al padre o a la madre, morirá de muerte.", "words": [[0, 86888], [7, 87229], [14, 87709], [20, 88842], [26, 89326], [28, 89506], [31, 89606], [37, 89966], [39, 90306], [41, 90406], [44, 90446], [51, 90846], [54, 91338], [57, 91503], [61, 91643], [69, 92183], [72, 92403], [78, 92823], [80, 93183], [82, 93303], [85, 93403], [92, 94303], [99, 94903], [102, 94983]]}, {"verse": 11, "start": 96026, "end": 108023, "text": "Y vosotros decís: Basta que diga un hombre al padre o a la madre: Es Corbán (que quiere decir, mi ofrenda a Dios) todo aquello con que pudiera ayudarte;", "words": [[0, 96026], [2, 96171], [11, 96591], [18, 97722], [24, 98222], [28, 98522], [33, 98882], [36, 99042], [43, 99382], [46, 99582], [52, 100042], [54, 100462], [56, 100582], [59, 100682], [66, 101481], [69, 101666], [76, 102609], [81, 102691], [88, 102991], [95, 103491], [98, 103991], [106, 104551], [108, 104751], [114, 105451], [119, 105611], [127, 106131], [131, 106371], [135, 106551], [143, 107071]]}, {"verse": 12, "start": 108373, "end": 112469, "text": "Y no le dejáis hacer más por su padre o por su madre,", "words": [[0, 108373], [2, 108633], [5, 108773], [8, 108913], [15, 109373], [21, 109693], [25, 109953], [29, 110213], [32, 110413], [38, 110833], [40, 111373], [44, 111593], [47, 111773]]}, {"verse": 13, "start": 112819, "end": 121730, "text": "Invalidando la palabra de Dios con vuestra tradición que habéis transmitido: y muchas cosas hacéis semejantes a estas.", "words": [[0, 112819], [12, 113600], [15, 113800], [23, 114140], [26, 114380], [31, 114640], [35, 114940], [43, 115420], [53, 116180], [57, 116440], [64, 116780], [77, 118103], [79, 118350], [86, 118590], [92, 119300], [99, 120010], [110, 120930], [112, 121150]]}, {"verse": 14, "start": 122080, "end": 127015, "text": "Y llamando a toda la multitud, les dijo: Oídme todos, y entended:", "words": [[0, 122080], [2, 122281], [11, 122721], [13, 122821], [18, 122961], [21, 123201], [31, 123781], [35, 124041], [41, 124855], [47, 125344], [54, 125684], [56, 126224]]}, {"verse": 15, "start": 127365, "end": 136930, "text": "Nada hay fuera del hombre que entre en él, que le pueda contaminar: pero lo que sale de él, aquello es lo que contamina al hombre.", "words": [[0, 127365], [5, 127729], [9, 128189], [15, 128509], [19, 128829], [26, 129149], [30, 129429], [36, 130009], [39, 130349], [43, 130729], [47, 131109], [50, 131249], [56, 131509], [68, 132645], [73, 132787], [76, 132967], [80, 133087], [85, 133347], [88, 133587], [92, 134147], [100, 134647], [103, 134907], [106, 135267], [110, 135407], [120, 136147], [123, 136327]]}, {"verse": 16, "start": 137280, "end": 140469, "text": "Si alguno tiene oídos para oír, oiga.", "words": [[0, 137280], [3, 137442], [10, 137982], [16, 138242], [22, 138902], [27, 139102], [32, 139922]]}, {"verse": 17, "start": 140819, "end": 147630, "text": "Y apartado de la multitud, habiendo entrado en casa, le preguntaron sus discípulos sobre la parábola.", "words": [[0, 140819], [2, 140922], [11, 141502], [14, 141682], [17, 141782], [27, 142702], [36, 143102], [44, 143562], [47, 143702], [53, 144602], [56, 144742], [68, 145422], [72, 145642], [83, 146342], [89, 146702], [92, 146922]]}, {"verse": 18, "start": 147980, "end": 156965, "text": "Y les dijo: ¿También vosotros estáis así sin comprender? ¿No entendéis que todo lo de fuera que entra en el hombre, no le puede contaminar;", "words": [[0, 147980], [2, 148190], [6, 148310], [12, 149036], [21, 149314], [30, 149874], [37, 150334], [41, 150574], [45, 150774], [57, 151850], [61, 152000], [71, 152620], [75, 152800], [80, 153140], [83, 153360], [86, 153480], [92, 153800], [96, 154100], [102, 154460], [105, 154680], [108, 154840], [116, 155140], [119, 155720], [122, 155880], [128, 156100]]}, {"verse": 19, "start": 157315, "end": 165920, "text": "Porque no entra en su corazón, sino en el vientre, y sale a la letrina? Esto decía, declarando limpios todos los alimentos.", "words": [[0, 157315], [7, 157757], [10, 158037], [16, 158397], [19, 158557], [22, 158697], [31, 159217], [36, 159577], [39, 159757], [42, 159877], [51, 160497], [53, 160857], [58, 161137], [60, 161317], [63, 161417], [72, 162378], [77, 162666], [84, 163236], [95, 163806], [103, 164426], [109, 164706], [113, 165006]]}, {"verse": 20, "start": 166270, "end": 171017, "text": "Pero decía, que lo que del hombre sale, aquello contamina al hombre.", "words": [[0, 166270], [5, 166412], [12, 167090], [16, 167430], [19, 167790], [23, 167990], [27, 168190], [34, 168470], [40, 168970], [48, 169470], [58, 170210], [61, 170450]]}, {"verse": 21, "start": 171367, "end": 181475, "text": "Porque de dentro, del corazón de los hombres, salen los malos pensamientos, los adulterios, las fornicaciones, los homicidios,", "words": [[0, 171367], [7, 171649], [10, 171889], [18, 172369], [22, 172669], [30, 173169], [33, 173429], [37, 173569], [46, 174009], [52, 174929], [56, 175169], [62, 175629], [76, 176989], [80, 177089], [92, 178389], [96, 178509], [111, 180009], [115, 180169]]}, {"verse": 22, "start": 181825, "end": 192711, "text": "Los hurtos, las avaricias, las maldades, el engaño, la lascivia, el ojo maligno, las injurias, la soberbia, la insensatez.", "words": [[0, 181825], [4, 182529], [12, 183269], [16, 183429], [27, 184889], [31, 185589], [41, 186289], [44, 186449], [52, 187429], [55, 187509], [65, 188489], [68, 188629], [72, 188949], [81, 190049], [85, 190169], [95, 191109], [98, 191149], [108, 191829], [111, 192270]]}, {"verse": 23, "start": 193061, "end": 197989, "text": "Todas estas maldades de dentro salen, y contaminan al hombre.", "words": [[0, 193061], [6, 193814], [12, 194154], [21, 194934], [24, 195154], [31, 195534], [38, 196174], [40, 196494], [51, 197274], [54, 197454]]}, {"verse": 24, "start": 198339, "end": 207948, "text": "Y levantándose de allí, se fue a la región de Tiro y Sidón; y entrando en casa, quiso que nadie lo supiese; pero no pudo esconderse.", "words": [[0, 198339], [2, 198456], [15, 199336], [18, 199516], [24, 200296], [27, 200496], [31, 200696], [33, 200816], [36, 200876], [43, 201216], [46, 201436], [51, 201836], [53, 201956], [60, 202899], [62, 203075], [71, 203635], [74, 203855], [80, 204155], [86, 204675], [90, 204855], [96, 205155], [99, 205375], [108, 206327], [113, 206494], [116, 206654], [121, 207014]]}, {"verse": 25, "start": 208298, "end": 216277, "text": "Porque una mujer, cuya hija tenía un espíritu inmundo, luego que oyó de él, vino y se echó a sus pies.", "words": [[0, 208298], [7, 208521], [11, 208781], [18, 209221], [23, 209681], [28, 210021], [34, 210301], [37, 210541], [46, 211241], [55, 211841], [61, 212421], [65, 212781], [69, 213141], [72, 213281], [76, 213521], [81, 214221], [83, 214841], [86, 215001], [91, 215341], [93, 215441], [97, 215601]]}, {"verse": 26, "start": 216627, "end": 223406, "text": "Y la mujer era griega, Sirofenisa de nación; y le rogaba que echase fuera de su hija al demonio.", "words": [[0, 216627], [2, 216723], [5, 216843], [11, 217143], [15, 217730], [23, 218316], [34, 218903], [37, 219083], [45, 220038], [47, 220150], [50, 220300], [57, 220840], [61, 221210], [68, 221580], [74, 221900], [77, 222100], [80, 222300], [85, 222510], [88, 222720]]}, {"verse": 27, "start": 223756, "end": 232867, "text": "Pero Jesús le dijo: Deja primero hartarse los hijos, porque no es bien tomar el pan de los hijos y echarlo a los perrillos.", "words": [[0, 223756], [5, 223898], [11, 224298], [14, 224818], [20, 225582], [25, 225947], [33, 226327], [42, 226907], [46, 227087], [53, 228067], [60, 228447], [63, 228707], [66, 228867], [71, 229047], [77, 229407], [80, 229667], [84, 230007], [87, 230227], [91, 230367], [97, 230767], [99, 231107], [107, 231747], [109, 231847], [113, 232387]]}, {"verse": 28, "start": 233217, "end": 240742, "text": "Y respondió ella, y le dijo: Sí, Señor; pero aun los perrillos debajo de la mesa, comen de las migajas de los hijos.", "words": [[0, 233217], [2, 233310], [12, 234070], [18, 234390], [20, 234625], [23, 234765], [29, 235491], [33, 235871], [40, 236483], [45, 236625], [49, 236905], [53, 237125], [63, 237585], [70, 238005], [73, 238145], [76, 238245], [82, 238545], [88, 239065], [91, 239245], [95, 239385], [103, 239905], [106, 240025], [110, 240145]]}, {"verse": 29, "start": 241022, "end": 245988, "text": "Entonces le dice: Por esta respuesta, ve; el demonio ha salido de tu hija.", "words": [[0, 241022], [9, 241461], [12, 241801], [18, 242554], [22, 242698], [27, 242898], [38, 243398], [42, 244004], [45, 244189], [53, 244669], [56, 244749], [63, 245169], [66, 245329], [69, 245509]]}, {"verse": 30, "start": 246338, "end": 252636, "text": "Y como fue a su casa, halló que el demonio había salido, y a la hija echada sobre la cama.", "words": [[0, 246338], [2, 246618], [7, 246878], [11, 247118], [13, 247218], [16, 247358], [22, 247848], [28, 248338], [32, 248498], [35, 248678], [43, 249138], [49, 249338], [57, 249978], [59, 250438], [61, 250518], [64, 250618], [69, 251038], [76, 251538], [82, 251878], [85, 252098]]}, {"verse": 31, "start": 252986, "end": 261671, "text": "Y volviendo a salir de la región de Tiro, vino por Sidón al mar de Galilea, por en medio de la región de Decápolis.", "words": [[0, 252986], [2, 253129], [12, 253649], [14, 253769], [20, 254109], [23, 254369], [26, 254509], [33, 254909], [36, 255149], [42, 256049], [47, 256369], [51, 256689], [57, 257269], [60, 257529], [64, 257789], [67, 257989], [76, 258989], [80, 259269], [83, 259429], [89, 259709], [92, 259929], [95, 260069], [102, 260489], [105, 260669]]}, {"verse": 32, "start": 262021, "end": 268835, "text": "Y le traen un hombre sordo y con dificultad para hablar, y le ruegan que le ponga la mano encima.", "words": [[0, 262021], [2, 262162], [5, 262242], [11, 262782], [14, 262922], [21, 263222], [27, 263802], [29, 264087], [33, 264287], [44, 265127], [49, 265387], [57, 265827], [59, 266307], [62, 266607], [69, 266907], [73, 267047], [76, 267187], [82, 267627], [85, 267727], [90, 268067]]}, {"verse": 33, "start": 269185, "end": 277385, "text": "Y tomándole aparte de la gente, metió sus dedos en las orejas de él, y escupiendo, tocó su lengua;", "words": [[0, 269185], [2, 269321], [12, 270001], [19, 270641], [22, 270721], [25, 270861], [32, 271901], [38, 272281], [42, 272561], [48, 273021], [51, 273161], [55, 273341], [62, 273781], [65, 274001], [69, 274221], [71, 274801], [83, 275981], [88, 276501], [91, 276761]]}, {"verse": 34, "start": 277735, "end": 284261, "text": "Y mirando al cielo, gimió, y le dijo: Efata: que es decir: Sé abierto.", "words": [[0, 277735], [2, 277899], [10, 278279], [13, 278459], [20, 279159], [27, 279859], [29, 280504], [32, 280624], [38, 281629], [45, 282176], [49, 282321], [52, 282501], [59, 283262], [62, 283687]]}, {"verse": 35, "start": 284611, "end": 291425, "text": "Y luego fueron abiertos sus oídos, y se soltó la atadura de su lengua, y hablaba con claridad.", "words": [[0, 284611], [2, 284755], [8, 284955], [15, 285395], [24, 286175], [28, 286415], [35, 287235], [37, 287375], [40, 287515], [46, 287995], [49, 288195], [57, 288755], [60, 288995], [63, 289135], [71, 289995], [73, 290155], [81, 290595], [85, 290775]]}, {"verse": 36, "start": 291775, "end": 298268, "text": "Y les mandó que no lo dijesen a nadie; pero cuanto más les mandaba, tanto más y más lo divulgaban.", "words": [[0, 291775], [2, 291883], [6, 292003], [12, 292383], [16, 292503], [19, 292663], [22, 292973], [30, 293283], [32, 293443], [39, 293953], [44, 294095], [51, 294395], [55, 294695], [59, 294835], [68, 295955], [74, 296115], [78, 296495], [80, 296735], [84, 296975], [87, 297215]]}, {"verse": 37, "start": 298618, "end": 305401, "text": "Y en gran manera se maravillaban, diciendo: Bien lo ha hecho todo: hace a los sordos oír, y a los mudos hablar.", "words": [[0, 298618], [2, 298744], [5, 298864], [10, 299064], [17, 299464], [20, 299684], [34, 300364], [44, 301244], [49, 301469], [52, 301689], [55, 301769], [61, 301929], [67, 302606], [72, 302911], [74, 302991], [78, 303111], [85, 303591], [90, 303991], [92, 304391], [94, 304451], [98, 304571], [104, 304951]]}]}