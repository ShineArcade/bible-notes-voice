{"book": "PSA", "chapter": 88, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 118887, "verses": [{"verse": 1, "start": 300, "end": 14446, "text": "Canción: Salmo para los hijos de Coré: al Músico principal: para cantar sobre Mahalat: Masquil de Hemán ezraíta. OH Jehová, Dios de mi salvación, día y noche clamo delante de ti.", "words": [[0, 300], [9, 1330], [15, 1908], [20, 2208], [24, 2388], [30, 2668], [33, 3032], [39, 3617], [42, 3778], [49, 4238], [60, 5368], [65, 5535], [72, 6095], [78, 6395], [87, 7860], [95, 8220], [98, 8736], [104, 9253], [113, 9954], [116, 10143], [124, 10823], [129, 11003], [132, 11183], [135, 11283], [146, 12283], [150, 12563], [152, 12803], [158, 13043], [164, 13563], [172, 13923], [175, 14103]]}, {"verse": 2, "start": 14796, "end": 19650, "text": "Entre mi oración en tu presencia: inclina tu oído a mi clamor.", "words": [[0, 14796], [6, 15093], [9, 15353], [17, 15813], [20, 16033], [23, 16153], [34, 17723], [42, 18103], [45, 18343], [50, 18763], [52, 18943], [55, 19063]]}, {"verse": 3, "start": 20000, "end": 25066, "text": "Porque mi alma está harta de males, y mi vida cercana al sepulcro.", "words": [[0, 20000], [7, 20164], [10, 20404], [15, 20704], [20, 21024], [26, 21504], [29, 21704], [36, 22124], [38, 22864], [41, 23024], [46, 23304], [54, 23924], [57, 24124]]}, {"verse": 4, "start": 25416, "end": 30549, "text": "Soy contado con los que descienden al hoyo, soy como hombre sin fuerza:", "words": [[0, 25416], [4, 25661], [12, 26381], [16, 26621], [20, 26781], [24, 26921], [35, 27501], [38, 27741], [44, 28541], [48, 28941], [53, 29261], [60, 29601], [64, 29841]]}, {"verse": 5, "start": 30899, "end": 39973, "text": "Libre entre los muertos, como los matados que yacen en el sepulcro, que no te acuerdas más de ellos, y que son cortados de tu mano.", "words": [[0, 30899], [6, 31343], [12, 31723], [16, 31923], [25, 32903], [30, 33223], [34, 33383], [42, 33963], [46, 34163], [52, 34663], [55, 34803], [58, 34943], [68, 36043], [72, 36143], [75, 36283], [78, 36403], [87, 36823], [91, 36983], [94, 37183], [101, 37483], [103, 38103], [107, 38223], [111, 38403], [120, 39123], [123, 39283], [126, 39423]]}, {"verse": 6, "start": 40323, "end": 44738, "text": "Me has puesto en el hoyo profundo, en tinieblas, en honduras.", "words": [[0, 40323], [3, 40470], [7, 40610], [14, 40870], [17, 41150], [20, 41320], [25, 41490], [35, 42530], [38, 42750], [49, 43830], [52, 44317]]}, {"verse": 7, "start": 45088, "end": 50538, "text": "Sobre mí se ha acostado tu ira, y me has afligido con todas tus ondas. (Selah.)", "words": [[0, 45088], [6, 45310], [9, 45550], [12, 45730], [15, 45850], [24, 46310], [27, 46510], [32, 47110], [34, 47310], [37, 47430], [41, 47590], [50, 48210], [54, 48450], [60, 48770], [64, 49030], [71, 50301]]}, {"verse": 8, "start": 50888, "end": 58710, "text": "Has alejado de mí mis conocidos: me has puesto por abominación a ellos: encerrado estoy, y no puedo salir.", "words": [[0, 51185], [4, 51519], [12, 51852], [15, 52012], [18, 52172], [22, 52372], [33, 53461], [36, 53609], [40, 53809], [47, 54089], [51, 54589], [63, 55409], [65, 55609], [72, 56379], [82, 57151], [89, 57391], [91, 57711], [94, 57831], [100, 58091]]}, {"verse": 9, "start": 59060, "end": 66876, "text": "Mis ojos enfermaron a causa de mi aflicción: te he llamado, oh Jehová, cada día; he extendido a ti mis manos.", "words": [[0, 59060], [4, 59300], [9, 59620], [20, 60560], [22, 60660], [28, 61020], [31, 61280], [34, 61400], [45, 62575], [48, 62696], [51, 62776], [60, 63096], [63, 63416], [71, 63856], [76, 64076], [81, 64863], [84, 65145], [94, 65865], [96, 65985], [99, 66085], [103, 66225]]}, {"verse": 10, "start": 67226, "end": 73057, "text": "¿Harás tú milagro a los muertos? ¿se levantarán los muertos para alabarte? (Selah.)", "words": [[0, 67226], [7, 67574], [10, 67774], [18, 68494], [20, 68554], [24, 68654], [33, 69684], [37, 69774], [48, 70454], [52, 70554], [60, 70974], [65, 71294], [75, 72729]]}, {"verse": 11, "start": 73407, "end": 78516, "text": "¿Será contada en el sepulcro tu misericordia, o tu verdad en la perdición?", "words": [[0, 73407], [6, 73804], [14, 74484], [17, 74624], [20, 74784], [29, 75464], [32, 75524], [46, 76424], [48, 76644], [51, 76724], [58, 77024], [61, 77444], [64, 77584]]}, {"verse": 12, "start": 78866, "end": 84413, "text": "¿Será conocida en las tinieblas tu maravilla, ni tu justicia en la tierra del olvido?", "words": [[0, 78866], [6, 79188], [15, 79768], [18, 79888], [22, 80048], [32, 80688], [35, 80808], [46, 81648], [49, 81968], [52, 82128], [61, 82828], [64, 82988], [67, 83108], [74, 83488], [78, 83748]]}, {"verse": 13, "start": 84763, "end": 90181, "text": "Mas yo a ti he clamado, oh Jehová; y de mañana mi oración llegó antes a ti.", "words": [[0, 84923], [4, 85103], [7, 85283], [9, 85523], [12, 85683], [15, 86129], [24, 86575], [27, 87021], [35, 87623], [37, 87739], [40, 87859], [47, 88179], [50, 88459], [58, 88879], [64, 89199], [70, 89539], [72, 89839]]}, {"verse": 14, "start": 90531, "end": 95340, "text": "¿Por qué, oh Jehová, desechas mi alma? ¿por qué escondes de mí tu rostro?", "words": [[0, 90531], [5, 90656], [10, 90976], [13, 91296], [21, 91616], [30, 92396], [33, 92576], [39, 93411], [44, 93552], [48, 93712], [57, 94232], [60, 94372], [63, 94512], [66, 94652]]}, {"verse": 15, "start": 95690, "end": 102514, "text": "Yo soy afligido y necesitado: desde la juventud he llevado tus terrores, he estado temeroso.", "words": [[0, 95690], [3, 95877], [7, 96117], [16, 96817], [18, 96917], [30, 98118], [36, 98518], [39, 98738], [48, 99438], [51, 99678], [59, 100138], [63, 100318], [73, 101178], [76, 101238], [83, 101558]]}, {"verse": 16, "start": 102864, "end": 107082, "text": "Sobre mí han pasado tus iras; tus espantos me han cortado.", "words": [[0, 102864], [6, 103131], [9, 103411], [13, 103611], [20, 104031], [24, 104568], [30, 105297], [34, 105424], [43, 106384], [46, 106624], [50, 106784]]}, {"verse": 17, "start": 107432, "end": 112302, "text": "Me han rodeado como aguas de continuo; me han cercado a una.", "words": [[0, 107432], [3, 108276], [7, 108436], [15, 108976], [20, 109236], [26, 109596], [29, 109696], [39, 110744], [42, 110964], [46, 111064], [54, 111624], [56, 111784]]}, {"verse": 18, "start": 112652, "end": 118487, "text": "Has alejado de mí el amigo y el compañero; y mis conocidos se esconden en la tiniebla.", "words": [[0, 112802], [4, 112952], [12, 113392], [15, 113552], [18, 113752], [21, 114012], [27, 114332], [29, 114532], [32, 114672], [43, 115709], [45, 115806], [49, 115946], [59, 116666], [62, 116886], [71, 117446], [74, 117646], [77, 118089]]}]}