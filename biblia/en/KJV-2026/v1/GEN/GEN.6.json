{"book": "GEN", "chapter": 6, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 184909, "verses": [{"verse": 1, "start": 300, "end": 6289, "text": "And it came to pass, when men began to multiply on the face of the earth, and daughters were born to them,", "words": [[0, 300], [4, 436], [7, 556], [12, 776], [15, 936], [21, 1316], [26, 1956], [30, 2176], [36, 2496], [39, 2676], [48, 3156], [51, 3416], [55, 3516], [60, 3736], [63, 3916], [67, 4016], [74, 4316], [78, 4836], [88, 5136], [93, 5416], [98, 5696], [101, 5916]]}, {"verse": 2, "start": 6739, "end": 13733, "text": "That the sons of God saw the daughters of men that they were fair; and they took them wives of all which they chose.", "words": [[0, 6739], [5, 6869], [9, 7029], [14, 7349], [17, 7569], [21, 7909], [25, 8289], [29, 8469], [39, 8829], [42, 9089], [46, 9389], [51, 9689], [56, 9829], [61, 10009], [67, 10871], [71, 10994], [76, 11134], [81, 11374], [86, 11614], [92, 12034], [95, 12334], [99, 12574], [105, 12794], [110, 13014]]}, {"verse": 3, "start": 14183, "end": 23304, "text": "And the LORD said, My spirit shall not always strive with man, for that he also is flesh: yet his days shall be a hundred and twenty years.", "words": [[0, 14183], [4, 14328], [8, 14448], [13, 14668], [19, 15533], [22, 15737], [29, 16137], [35, 16417], [39, 16637], [46, 17037], [53, 17357], [58, 17577], [63, 18297], [67, 18537], [72, 18717], [75, 18877], [80, 19197], [83, 19437], [90, 20561], [94, 20706], [98, 20926], [103, 21226], [109, 21486], [112, 21658], [114, 21830], [122, 22002], [126, 22174], [133, 22346]]}, {"verse": 4, "start": 23654, "end": 36764, "text": "There were giants in the earth in those days; and also after that, when the sons of God came in to the daughters of men, and they bore children to them, the same became mighty men which were of old, men of renown.", "words": [[0, 23654], [6, 23797], [11, 23917], [18, 24317], [21, 24577], [25, 24717], [31, 24877], [34, 25057], [40, 25237], [46, 26102], [50, 26227], [55, 26707], [61, 26987], [67, 27687], [72, 27867], [76, 28007], [81, 28247], [84, 28427], [88, 28687], [93, 28894], [96, 29100], [99, 29307], [103, 29507], [113, 29787], [116, 30067], [121, 30787], [125, 30927], [130, 31047], [135, 31247], [144, 31627], [147, 31927], [153, 32634], [157, 32741], [162, 33021], [169, 33381], [176, 33841], [180, 34181], [186, 34481], [191, 34721], [194, 34861], [199, 35701], [203, 35901], [206, 36081]]}, {"verse": 5, "start": 37214, "end": 46071, "text": "¶ And GOD saw that the wickedness of man was great in the earth, and that every imagination of the thoughts of his heart was only evil continually.", "words": [[2, 37214], [6, 37356], [10, 37656], [14, 38096], [19, 38356], [23, 38516], [34, 39056], [37, 39236], [41, 39556], [45, 39816], [51, 40196], [54, 40456], [58, 40576], [65, 41236], [69, 41476], [74, 41616], [80, 41916], [92, 42476], [95, 42876], [99, 42996], [108, 43276], [111, 43476], [115, 43616], [121, 43936], [125, 44196], [130, 44556], [135, 44956]]}, {"verse": 6, "start": 46521, "end": 51590, "text": "And it repented the LORD that he had made man on the earth, and it grieved him at his heart.", "words": [[0, 46521], [4, 46645], [7, 46725], [16, 47225], [20, 47425], [25, 47745], [30, 47985], [33, 48145], [37, 48305], [42, 48565], [46, 48905], [49, 49085], [53, 49225], [60, 49925], [64, 50105], [67, 50225], [75, 50645], [79, 50785], [82, 50925], [86, 51045]]}, {"verse": 7, "start": 52040, "end": 63869, "text": "And the LORD said, I will destroy man whom I have created from the face of the earth; both man, and beast, and the creeping thing, and the fowls of the air; for it repents me that I have made them.", "words": [[0, 52040], [4, 52145], [8, 52265], [13, 52465], [19, 53293], [21, 53420], [26, 53560], [34, 53920], [38, 54300], [43, 54580], [45, 54780], [50, 54940], [58, 55340], [63, 55560], [67, 55680], [72, 55920], [75, 56100], [79, 56200], [86, 57065], [91, 57282], [96, 57702], [100, 57942], [107, 58262], [111, 58522], [115, 58642], [124, 58942], [131, 59322], [135, 59702], [139, 59822], [145, 60282], [148, 60382], [152, 60522], [157, 61467], [161, 61675], [164, 61795], [172, 62215], [175, 62395], [180, 62635], [182, 62795], [187, 62955], [192, 63175]]}, {"verse": 8, "start": 64219, "end": 66800, "text": "But Noah found grace in the eyes of the LORD.", "words": [[0, 64219], [4, 64389], [9, 64689], [15, 65069], [21, 65389], [24, 65629], [28, 65749], [33, 65989], [36, 66149], [40, 66269]]}, {"verse": 9, "start": 67250, "end": 74866, "text": "¶ These are the generations of Noah: Noah was a just man and perfect in his generations, and Noah walked with God.", "words": [[2, 67250], [8, 67457], [12, 67657], [16, 67757], [28, 68377], [31, 68697], [37, 69534], [42, 69822], [46, 70122], [48, 70282], [53, 70522], [57, 70862], [61, 71102], [69, 71502], [72, 71782], [76, 71922], [89, 73182], [93, 73262], [98, 73602], [105, 73982], [110, 74222]]}, {"verse": 10, "start": 75316, "end": 79251, "text": "And Noah begot three sons, Shem, Ham, and Japheth.", "words": [[0, 75316], [4, 75495], [9, 75815], [15, 76275], [21, 76595], [27, 77455], [33, 78195], [38, 78715], [42, 78755]]}, {"verse": 11, "start": 79701, "end": 84578, "text": "The earth also was corrupt before God, and the earth was filled with violence.", "words": [[0, 79701], [4, 79809], [10, 80069], [15, 80549], [19, 80789], [27, 81129], [34, 81569], [39, 82389], [43, 82589], [47, 82729], [53, 82989], [57, 83229], [64, 83509], [69, 83769]]}, {"verse": 12, "start": 85028, "end": 92290, "text": "And God looked upon the earth, and, behold, it was corrupt; for all flesh had corrupted his way upon the earth.", "words": [[0, 85028], [4, 85328], [8, 85608], [15, 85888], [20, 86228], [24, 86468], [31, 86728], [36, 87408], [44, 88308], [47, 88408], [51, 88608], [60, 89552], [64, 89712], [68, 89892], [74, 90192], [78, 90432], [88, 90872], [92, 91132], [96, 91372], [101, 91612], [105, 91852]]}, {"verse": 13, "start": 92740, "end": 103224, "text": "And God said to Noah, The end of all flesh is come before me; for the earth is filled with violence through them; and, behold, I will destroy them with the earth.", "words": [[0, 92740], [4, 92870], [8, 93110], [13, 93390], [16, 93590], [22, 95017], [26, 95118], [30, 95398], [33, 95558], [37, 95718], [43, 95988], [46, 96258], [51, 96458], [58, 96758], [62, 97755], [66, 97850], [70, 97970], [76, 98210], [79, 98390], [86, 98630], [91, 98830], [100, 99210], [108, 99530], [114, 100511], [119, 100652], [127, 101432], [129, 101572], [134, 101692], [142, 102092], [147, 102352], [152, 102532], [156, 102672]]}, {"verse": 14, "start": 103674, "end": 110227, "text": "¶ Make you an ark of gopher wood; rooms shall you make in the ark, and shall pitch it within and without with pitch.", "words": [[2, 103674], [7, 103804], [11, 104024], [14, 104144], [18, 104384], [21, 104544], [28, 104924], [34, 106072], [40, 106192], [46, 106512], [50, 106672], [55, 106872], [58, 106992], [62, 107092], [67, 107732], [71, 107812], [77, 107972], [83, 108232], [86, 108352], [93, 108672], [97, 108892], [105, 109232], [110, 109432]]}, {"verse": 15, "start": 110677, "end": 119647, "text": "And this is the fashion which you shall make it of: The length of the ark shall be three hundred cubits, the breadth of it fifty cubits, and the height of it thirty cubits.", "words": [[0, 110677], [4, 110785], [9, 110985], [12, 111105], [16, 111245], [24, 111565], [30, 111825], [34, 111965], [40, 112125], [45, 112345], [48, 112465], [52, 113312], [56, 113414], [63, 113634], [66, 113814], [70, 113984], [74, 114154], [80, 114354], [83, 114769], [89, 115184], [97, 115599], [105, 116014], [109, 116054], [117, 116314], [120, 116474], [123, 116874], [129, 117274], [137, 117674], [141, 117874], [145, 117974], [152, 118194], [155, 118334], [158, 118694], [165, 119054]]}, {"verse": 16, "start": 120097, "end": 130895, "text": "A window shall you make to the ark, and in a cubit shall you finish it above; and the door of the ark shall you set in the side of it; with lower, second, and third stories shall you make it.", "words": [[0, 120097], [2, 120208], [9, 120468], [15, 120768], [19, 120928], [24, 121108], [27, 121268], [31, 121388], [36, 121948], [40, 122268], [43, 122388], [45, 122488], [51, 122848], [57, 123068], [61, 123188], [68, 123468], [71, 123648], [78, 124730], [82, 124874], [86, 124974], [91, 125194], [94, 125374], [98, 125474], [102, 125654], [108, 125874], [112, 126014], [116, 126274], [119, 126474], [123, 126574], [128, 126834], [131, 126974], [135, 127730], [140, 127883], [147, 128123], [155, 128943], [159, 129143], [165, 129463], [173, 129783], [179, 130043], [183, 130223], [188, 130403]]}, {"verse": 17, "start": 131345, "end": 143083, "text": "And, behold, I, even I, do bring a flood of waters upon the earth, to destroy all flesh, in which is the breath of life, from under heaven; and every thing that is in the earth shall die.", "words": [[0, 131345], [5, 131462], [13, 132162], [16, 132562], [21, 132742], [24, 133422], [27, 133542], [33, 133842], [35, 133982], [41, 134182], [44, 134342], [51, 134682], [56, 135042], [60, 135282], [67, 135542], [70, 135802], [78, 136282], [82, 136602], [89, 137022], [92, 137602], [98, 137802], [101, 137962], [105, 138062], [112, 138262], [115, 138462], [121, 138802], [126, 139342], [132, 139602], [140, 140698], [144, 140838], [150, 141012], [156, 141185], [161, 141565], [164, 141705], [167, 141805], [171, 141905], [177, 142045], [183, 142345]]}, {"verse": 18, "start": 143533, "end": 151427, "text": "But with you will I establish my covenant; and you shall come into the ark, you, and your sons, and your wife, and your sons’ wives with you.", "words": [[0, 143533], [4, 143637], [9, 143857], [13, 143997], [18, 144157], [20, 144277], [30, 144697], [33, 144977], [43, 146061], [47, 146061], [51, 146247], [57, 146387], [62, 146627], [67, 146847], [71, 147007], [76, 147227], [81, 147687], [85, 148067], [90, 148167], [