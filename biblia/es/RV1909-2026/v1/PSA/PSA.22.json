{"book": "PSA", "chapter": 22, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 209875, "verses": [{"verse": 1, "start": 300, "end": 12007, "text": "Al Músico principal, sobre Ajelet-sahar: Salmo de David. DIOS mío, Dios mío, ¿por qué me has dejado? ¿ por qué estás lejos de mi salvación, y de las palabras de mi clamor?", "words": [[0, 300], [3, 446], [10, 906], [21, 1546], [27, 2453], [41, 3551], [47, 4009], [50, 4169], [57, 4965], [62, 5253], [67, 5733], [72, 5873], [77, 6497], [82, 6637], [86, 6777], [89, 6917], [93, 7017], [101, 7939], [103, 7939], [107, 8060], [111, 8260], [117, 8500], [123, 9100], [126, 9260], [129, 9360], [140, 10080], [142, 10500], [145, 10600], [149, 10740], [158, 11080], [161, 11320], [164, 11664]]}, {"verse": 2, "start": 12357, "end": 18056, "text": "Dios mío, clamo de día, y no oyes; y de noche, y no hay para mí silencio.", "words": [[0, 12357], [5, 12582], [10, 13082], [16, 13442], [19, 13622], [24, 13942], [26, 14162], [29, 14342], [35, 15470], [37, 15611], [40, 15731], [47, 16071], [49, 16451], [52, 16631], [56, 16831], [61, 17071], [64, 17271]]}, {"verse": 3, "start": 18406, "end": 23192, "text": "Pero tú eres santo, tú que habitas entre las alabanzas de Israel.", "words": [[0, 18406], [5, 18568], [8, 18828], [13, 19048], [20, 19993], [23, 20313], [27, 20493], [35, 21093], [41, 21453], [45, 21733], [55, 22393], [58, 22493]]}, {"verse": 4, "start": 23542, "end": 28575, "text": "En ti esperaron nuestros padres: esperaron, y tú los libraste.", "words": [[0, 23542], [3, 23709], [6, 24049], [16, 24929], [25, 25169], [33, 26281], [44, 26925], [46, 27185], [49, 27445], [53, 28037]]}, {"verse": 5, "start": 28925, "end": 33932, "text": "Clamaron a ti, y fueron librados: confiaron en ti, y no se avergonzaron.", "words": [[0, 28925], [9, 29369], [11, 29509], [15, 29709], [17, 29889], [24, 30149], [34, 31357], [44, 31923], [47, 32113], [51, 32303], [53, 32563], [56, 32703], [59, 32883]]}, {"verse": 6, "start": 33932, "end": 39928, "text": "Mas yo soy gusano, y no hombre; deshonra de los hombres, y desecho del pueblo.", "words": [[0, 33983], [4, 34304], [7, 34564], [11, 34804], [19, 35464], [21, 35784], [24, 35964], [32, 37017], [41, 37367], [44, 37507], [48, 37647], [57, 38087], [59, 38607], [67, 39167], [71, 39287]]}, {"verse": 7, "start": 40278, "end": 47212, "text": "Todos los que me ven, escarnecen de mí; estiran los labios, menean la cabeza, diciendo:", "words": [[0, 40278], [6, 40523], [10, 40843], [14, 41043], [17, 41203], [22, 41893], [33, 42583], [36, 42783], [40, 43364], [48, 43774], [52, 43974], [60, 45014], [67, 45494], [70, 45634], [78, 46134]]}, {"verse": 8, "start": 47412, "end": 52240, "text": "Se encomienda a Jehová, líbrelo; sálvele, puesto que en él se complacía.", "words": [[0, 47412], [3, 47617], [14, 47907], [16, 48197], [24, 48937], [33, 49853], [42, 50433], [49, 50733], [53, 50973], [56, 51113], [59, 51233], [62, 51393]]}, {"verse": 9, "start": 52520, "end": 59219, "text": "Pero tú eres el que me sacó del vientre, el que me hizo estar confiado desde que estaba a los pechos de mi madre.", "words": [[0, 52520], [5, 52664], [8, 52884], [13, 53124], [16, 53304], [20, 53424], [23, 53564], [28, 53924], [32, 54064], [41, 55024], [44, 55284], [48, 55444], [51, 55584], [56, 55864], [62, 56124], [71, 56824], [77, 57044], [81, 57284], [88, 57584], [90, 57804], [94, 57924], [101, 58364], [104, 58504], [107, 58624]]}, {"verse": 10, "start": 59569, "end": 66078, "text": "Sobre ti fui echado desde la matriz: desde el vientre de mi madre, tú eres mi Dios.", "words": [[0, 59569], [6, 59812], [9, 60072], [13, 60272], [20, 60832], [26, 61352], [29, 61592], [37, 62533], [43, 62796], [46, 63036], [54, 63516], [57, 63616], [60, 63776], [67, 64756], [70, 65016], [75, 65236], [78, 65436]]}, {"verse": 11, "start": 66428, "end": 71972, "text": "No te alejes de mí, porque la angustia está cerca; porque no hay quien ayude.", "words": [[0, 66428], [3, 66708], [6, 66848], [13, 67268], [16, 67448], [20, 67948], [27, 68228], [30, 68408], [39, 68928], [44, 69088], [51, 69992], [58, 70377], [61, 70617], [65, 70797], [71, 71137]]}, {"verse": 12, "start": 72322, "end": 77061, "text": "Me han rodeado muchos toros; fuertes toros de Basán me han cercado.", "words": [[0, 72322], [3, 72450], [7, 72610], [15, 73230], [22, 73490], [29, 74514], [37, 75037], [43, 75477], [46, 75597], [52, 75997], [55, 76157], [59, 76257]]}, {"verse": 13, "start": 77411, "end": 81774, "text": "Abrieron sobre mí su boca, como león que arrebata y ruge.", "words": [[0, 77411], [9, 77936], [15, 78216], [18, 78456], [21, 78636], [27, 79496], [32, 79876], [37, 80316], [41, 80636], [50, 80956], [52, 81388]]}, {"verse": 14, "start": 82124, "end": 91861, "text": "Me he derramado como aguas, y todos mis huesos se descoyuntaron: mi corazón fue como cera, derritiéndose en medio de mis entrañas.", "words": [[0, 82124], [3, 82442], [6, 82582], [16, 83142], [21, 83382], [28, 84182], [30, 84462], [36, 84802], [40, 85362], [47, 85942], [50, 86162], [65, 87475], [68, 87621], [76, 88001], [80, 88301], [85, 88541], [91, 89361], [105, 90201], [108, 90341], [114, 90561], [117, 90761], [121, 90861]]}, {"verse": 15, "start": 92211, "end": 99356, "text": "Se secó como un tiesto mi vigor, y mi lengua se pegó a mi paladar; y me has puesto en el polvo de la muerte.", "words": [[0, 92211], [3, 92332], [8, 92772], [13, 92972], [16, 93112], [23, 93692], [26, 93812], [33, 94412], [35, 94652], [38, 94772], [45, 95252], [48, 95412], [53, 95812], [55, 95912], [58, 96363], [67, 97008], [69, 97133], [72, 97233], [76, 97373], [83, 97653], [86, 97913], [89, 98033], [95, 98513], [98, 98613], [101, 98733]]}, {"verse": 16, "start": 99706, "end": 106160, "text": "Porque perros me han rodeado, me ha cercado cuadrilla de malignos: horadaron mis manos y mis pies.", "words": [[0, 99706], [7, 99951], [14, 100631], [17, 100891], [21, 101011], [30, 101711], [33, 101771], [36, 102151], [44, 102531], [54, 102911], [57, 103051], [67, 104370], [77, 104700], [81, 104900], [87, 105260], [89, 105500], [93, 105660]]}, {"verse": 17, "start": 106510, "end": 110935, "text": "Contar puedo todos mis huesos; ellos miran, me observan.", "words": [[0, 106510], [7, 106951], [13, 107471], [19, 107951], [23, 108251], [31, 109138], [37, 109427], [44, 109887], [47, 110047]]}, {"verse": 18, "start": 111285, "end": 115607, "text": "Partieron entre sí mis vestidos, y sobre mi ropa echaron suertes.", "words": [[0, 111285], [10, 111985], [16, 112305], [19, 112605], [23, 112805], [33, 113405], [35, 113625], [41, 113865], [44, 114085], [49, 114465], [57, 114825]]}, {"verse": 19, "start": 115957, "end": 120477, "text": "Mas tú, Jehová, no te alejes; fortaleza mía, apresúrate para mi ayuda.", "words": [[0, 115957], [4, 116182], [8, 116407], [16, 116632], [19, 116857], [22, 117097], [30, 118009], [40, 118607], [45, 119047], [56, 119547], [61, 119787], [64, 119947]]}, {"verse": 20, "start": 120827, "end": 124785, "text": "Libra de la espada mi alma; del poder del perro mi única.", "words": [[0, 120827], [6, 121252], [9, 121352], [12, 121452], [19, 121932], [22, 122032], [28, 122797], [32, 122961], [38, 123261], [42, 123574], [48, 123888], [51, 124201]]}, {"verse": 21, "start": 125135, "end": 130209, "text": "Sálvame de la boca del león, y óyeme librándome de los cuernos de los búfalos.", "words": [[0, 125135], [8, 125603], [11, 125783], [14, 125883], [19, 126103], [23, 126343], [29, 126863], [31, 127403], [37, 127783], [48, 128463], [51, 128623], [55, 128763], [63, 129243], [66, 129343], [70, 129443]]}, {"verse": 22, "start": 130559, "end": 135712, "text": "Anunciaré tu nombre a mis hermanos: en medio de la congregación te alabaré.", "words": [[0, 130559], [10, 131197], [13, 131377], [20, 131677], [22, 131817], [26, 131917], [36, 133182], [39, 133564], [45, 133884], [48, 134064], [51, 134164], [64, 134944], [67, 135144]]}, {"verse": 23, "start": 136062, "end": 145088, "text": "Los que teméis a Jehová, alabadle; glorificadle, descendencia toda de Jacob; y temed de él, vosotros, descendencia toda de Israel.", "words": [[0, 136062], [4, 136192], [8, 136332], [15, 136672], [17, 136812], [25, 137480], [35, 138912], [49, 139542], [62, 140442], [67, 140682], [70, 140902], [77, 141713], [79, 141908], [85, 142138], [88, 142358], [92, 142478], [102, 142998], [115, 143878], [120, 144118], [123, 144378]]}, {"verse": 24, "start": 145438, "end": 155713, "text": "Porque no menospreció ni abominó la aflicción del pobre, ni de él escondió su rostro; sino que cuando clamó a él, le oyó.", "words": [[0, 145438], [7, 145660], [10, 146220], [22, 146780], [25, 147060], [33, 147960], [36, 148380], [46, 149100], [50, 149280], [57, 149740], [60, 150340], [63, 150540], [66, 150880], [75, 151520], [78, 151680], [86, 152566], [91, 152985], [95, 153185], [102, 153655], [108, 154125], [110, 154305], [114, 154801], [117, 155297]]}, {"verse": 25, "start": 156063, "end": 162768, "text": "De ti será mi alabanza en la grande congregación; mis votos pagaré delante de los que le temen.", "words": [[0, 156063], [3, 156230], [6, 156450], [11, 156730], [14, 156990], [23, 157790], [26, 158250], [29, 158410], [36, 158790], [50, 160287], [54, 160435], [60, 160775], [67, 161235], [75, 161655], [78, 161815], [82, 161955], [86, 162075], [89, 162195]]}, {"verse": 26, "start": 163118, "end": 170613, "text": "Comerán los pobres, y serán saciados: alabarán a Jehová los que le buscan: vivirá vuestro corazón para siempre.", "words": [[0, 163118], [8, 163482], [12, 163642], [20, 164162], [22, 164382], [28, 164722], [38, 165829], [47, 166480], [49, 166733], [56, 166987], [60, 167240], [64, 167340], [67, 167480], [75, 168365], [82, 168831], [90, 169131], [98, 169531], [103, 169871]]}, {"verse": 27, "start": 170963, "end": 179944, "text": "Se acordarán, y se volverán a Jehová todos los confines de la tierra; y se humillarán delante de ti todas las familias de las naciones.", "words": [[0, 170963], [3, 171125], [14, 171905], [16, 172105], [19, 172265], [28, 172805], [30, 172905], [37, 173325], [43, 173605], [47, 173945], [56, 174545], [59, 174705], [62, 174805], [70, 175765], [72, 175996], [75, 176136], [86, 176856], [94, 177276], [97, 177416], [100, 177636], [106, 177996], [110, 178316], [119, 178916], [122, 179016], [126, 179156]]}, {"verse": 28, "start": 180294, "end": 185096, "text": "Porque de Jehová es el reino; y él se enseñoreará de las naciones.", "words": [[0, 180294], [7, 180495], [10, 180675], [17, 181175], [20, 181395], [23, 181595], [30, 182490], [32, 182681], [35, 182821], [38, 183021], [50, 183901], [53, 184021], [57, 184181]]}, {"verse": 29, "start": 185446, "end": 198111, "text": "Comerán y adorarán todos los poderosos de la tierra: se postrarán delante de él todos los que descienden al polvo, si bien ninguno puede conservar la vida a su propia alma.", "words": [[0, 185446], [8, 186015], [10, 186455], [19, 187115], [25, 187415], [29, 187695], [39, 188255], [42, 188395], [45, 188495], [53, 189346], [56, 189489], [66, 190229], [74, 190709], [77, 190909], [80, 191109], [86, 191529], [90, 192229], [94, 192409], [105, 192969], [108, 193189], [115, 194009], [118, 194209], [123, 194509], [131, 195349], [137, 195589], [147, 196289], [150, 196449], [155, 196729], [157, 196989], [160, 197129], [167, 197509]]}, {"verse": 30, "start": 198461, "end": 203754, "text": "La posteridad le servirá; será ella contada por una generación de Jehová.", "words": [[0, 198461], [3, 198630], [14, 199550], [17, 199870], [26, 200837], [31, 201167], [36, 201307], [44, 201927], [48, 202167], [52, 202327], [63, 202987], [66, 203127]]}, {"verse": 31, "start": 204104, "end": 209475, "text": "Vendrán, y anunciarán al pueblo que nazca, su justicia que él hizo.", "words": [[0, 204104], [9, 204730], [11, 205290], [22, 206050], [25, 206170], [32, 206450], [36, 206770], [43, 207290], [46, 207750], [55, 208470], [59, 208670], [62, 208870]]}]}