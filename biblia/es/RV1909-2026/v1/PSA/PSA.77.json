{"book": "PSA", "chapter": 77, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 134434, "verses": [{"verse": 1, "start": 300, "end": 9261, "text": "Al Músico principal: para Jedutún: Salmo de Asaf. CON mi voz clamé a Dios, a Dios clamé, y él me escuchará.", "words": [[0, 300], [3, 468], [10, 968], [21, 2132], [26, 2600], [35, 3343], [41, 3844], [44, 4024], [50, 4838], [54, 4961], [57, 5161], [61, 5861], [67, 6161], [69, 6301], [75, 6801], [77, 6861], [82, 7041], [89, 8001], [91, 8101], [94, 8281], [97, 8441]]}, {"verse": 2, "start": 9711, "end": 18237, "text": "Al Señor busqué en el día de mi angustia: mi mal corría de noche, y no cesaba: mi alma rehusaba consuelo.", "words": [[0, 9711], [3, 9858], [9, 10158], [16, 10738], [19, 11018], [22, 11158], [26, 11378], [29, 11558], [32, 11678], [42, 12774], [45, 12940], [49, 13240], [56, 13820], [59, 13960], [66, 14380], [68, 14780], [71, 14920], [79, 16036], [82, 16203], [87, 16503], [96, 17303]]}, {"verse": 3, "start": 18687, "end": 24661, "text": "Me acordaba de Dios, y gritaba: me quejaba, y desmayaba mi espíritu. (Selah.)", "words": [[0, 18687], [3, 18796], [12, 19296], [15, 19456], [21, 19776], [23, 20396], [32, 21450], [35, 21558], [44, 22118], [46, 22298], [56, 22878], [59, 23078], [69, 24379]]}, {"verse": 4, "start": 25111, "end": 29929, "text": "Tenías los párpados de mis ojos: estaba yo quebrantado, y no hablaba.", "words": [[0, 25111], [7, 25600], [11, 25760], [20, 26340], [23, 26500], [27, 26620], [33, 27637], [40, 28004], [43, 28184], [56, 28984], [58, 29104], [61, 29244]]}, {"verse": 5, "start": 30379, "end": 35112, "text": "Consideraba los días desde el principio, los años de los siglos.", "words": [[0, 30379], [12, 31276], [16, 31476], [21, 31776], [27, 32196], [30, 32456], [41, 33516], [45, 33716], [50, 34016], [53, 34196], [57, 34676]]}, {"verse": 6, "start": 35562, "end": 42045, "text": "Me acordaba de mis canciones de noche; meditaba con mi corazón, y mi espíritu inquiría.", "words": [[0, 35562], [3, 35668], [12, 36228], [15, 36368], [19, 36488], [29, 37028], [32, 37188], [39, 38060], [48, 38762], [52, 38982], [55, 39222], [64, 39722], [66, 40302], [69, 40462], [78, 41202]]}, {"verse": 7, "start": 42495, "end": 46757, "text": "¿Desechará el Señor para siempre, y no volverá más a amar?", "words": [[0, 42495], [11, 43121], [14, 43281], [20, 43581], [25, 43941], [34, 44521], [36, 45261], [39, 45401], [47, 45881], [51, 46121], [53, 46241]]}, {"verse": 8, "start": 47207, "end": 54010, "text": "¿Se ha acabado para siempre su misericordia? ¿se ha acabado la palabra suya para generación y generación?", "words": [[0, 47207], [4, 47370], [7, 47490], [15, 47930], [20, 48150], [28, 48530], [31, 48750], [45, 50124], [49, 50284], [52, 50444], [60, 50944], [63, 51064], [71, 51364], [76, 51944], [81, 52164], [92, 52964], [94, 53144]]}, {"verse": 9, "start": 54460, "end": 61288, "text": "¿Ha olvidado Dios el tener misericordia? ¿ha encerrado con ira sus piedades? (Selah.)", "words": [[0, 54460], [4, 54720], [13, 55300], [18, 55600], [21, 56120], [27, 56400], [41, 57896], [45, 58064], [55, 58704], [59, 58974], [63, 59244], [67, 59444], [77, 61027]]}, {"verse": 10, "start": 61738, "end": 68610, "text": "Y dije: Enfermedad mía es esta; traeré pues a la memoria los años de la diestra del Altísimo.", "words": [[0, 61738], [2, 61885], [8, 62698], [19, 63547], [23, 63907], [26, 64087], [32, 64953], [39, 65455], [44, 65555], [46, 65755], [49, 65835], [57, 66295], [61, 66475], [66, 66795], [69, 66975], [72, 67095], [80, 67535], [84, 67715]]}, {"verse": 11, "start": 69060, "end": 74428, "text": "Me acordaré de las obras de JAH: sí, haré yo memoria de tus maravillas antiguas.", "words": [[0, 69060], [3, 69147], [12, 69707], [15, 69827], [19, 69987], [25, 70247], [28, 70609], [33, 71221], [37, 71725], [42, 71945], [45, 72125], [53, 72625], [56, 72805], [60, 72965], [71, 73565]]}, {"verse": 12, "start": 74878, "end": 79008, "text": "Y meditaré en todas tus obras, y hablaré de tus hechos.", "words": [[0, 74878], [2, 75138], [11, 75818], [14, 76038], [20, 76318], [24, 76678], [31, 77098], [33, 77618], [41, 78078], [44, 78198], [48, 78418]]}, {"verse": 13, "start": 79458, "end": 84689, "text": "Oh Dios, en santidad es tu camino: ¿qué Dios grande como el Dios nuestro?", "words": [[0, 79458], [3, 79890], [9, 80330], [12, 80470], [21, 81150], [24, 81490], [27, 81610], [35, 82530], [40, 82637], [45, 82857], [52, 83317], [57, 83617], [60, 83777], [65, 83957]]}, {"verse": 14, "start": 85139, "end": 91291, "text": "Tú eres el Dios que hace maravillas: tú hiciste notoria en los pueblos tu fortaleza.", "words": [[0, 85139], [3, 85262], [8, 85502], [11, 85702], [16, 85962], [20, 86242], [25, 86442], [37, 87721], [40, 88101], [48, 88821], [56, 89441], [59, 89621], [63, 89741], [71, 90221], [74, 90341]]}, {"verse": 15, "start": 91741, "end": 98369, "text": "Con tu brazo redimiste a tu pueblo, a los hijos de Jacob y de José. (Selah.)", "words": [[0, 91741], [4, 91882], [7, 92042], [13, 92762], [23, 93482], [25, 93622], [28, 93702], [36, 94442], [38, 94502], [42, 94622], [48, 94902], [51, 95222], [57, 95542], [59, 95722], [62, 95822], [68, 98054]]}, {"verse": 16, "start": 98819, "end": 105483, "text": "Te vieron las aguas, oh Dios; te vieron las aguas, temieron; y temblaron los abismos.", "words": [[0, 98819], [3, 98921], [10, 99181], [14, 99401], [21, 100141], [24, 100541], [30, 101364], [33, 101465], [40, 101745], [44, 101965], [51, 102650], [61, 103575], [63, 103700], [73, 104460], [77, 104600]]}, {"verse": 17, "start": 105933, "end": 112490, "text": "Las nubes echaron inundaciones de aguas; tronaron los cielos, y corrieron tus rayos.", "words": [[0, 105933], [4, 106044], [10, 106644], [18, 107344], [31, 108184], [34, 108484], [41, 109396], [50, 110077], [54, 110297], [62, 110956], [64, 111077], [74, 111577], [78, 112034]]}, {"verse": 18, "start": 112940, "end": 121523, "text": "Anduvo en derredor el sonido de tus truenos; los relámpagos alumbraron el mundo; se estremeció y tembló la tierra.", "words": [[0, 112940], [7, 113427], [10, 113607], [19, 114207], [22, 114427], [29, 114987], [32, 115147], [36, 115327], [45, 116494], [49, 116599], [60, 117299], [71, 117959], [74, 118159], [81, 119007], [84, 119184], [95, 120004], [97, 120264], [104, 120764], [107, 120884]]}, {"verse": 19, "start": 121973, "end": 128924, "text": "En el mar fue tu camino, y tus sendas en las muchas aguas; y tus pisadas no fueron conocidas.", "words": [[0, 121973], [3, 122095], [6, 122235], [10, 122475], [14, 122695], [17, 122895], [25, 123375], [27, 123875], [31, 124035], [38, 124655], [41, 124815], [45, 124975], [52, 125255], [59, 126350], [61, 126477], [65, 126657], [73, 127277], [76, 127597], [83, 127857]]}, {"verse": 20, "start": 129374, "end": 134034, "text": "Condujiste a tu pueblo como ovejas, por mano de Moisés y de Aarón.", "words": [[0, 129374], [11, 129936], [13, 130076], [16, 130136], [23, 130516], [28, 130876], [36, 131876], [40, 132156], [45, 132396], [48, 132596], [55, 133016], [57, 133276], [60, 133667]]}]}