{"book": "ACT", "chapter": 23, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 322199, "verses": [{"verse": 1, "start": 300, "end": 10985, "text": "Entonces Pablo, poniendo los ojos en el Consejo, dice: Varones hermanos, yo con toda buena conciencia he vivido delante de Dios hasta el día de hoy.", "words": [[0, 300], [9, 748], [16, 1568], [25, 2108], [29, 2328], [34, 2608], [37, 2828], [40, 2948], [49, 4068], [55, 5056], [63, 5266], [73, 6166], [76, 6466], [80, 6726], [85, 6926], [91, 7246], [102, 8106], [105, 8366], [112, 8786], [120, 9186], [123, 9346], [128, 9606], [134, 10106], [137, 10266], [141, 10446], [144, 10626]]}, {"verse": 2, "start": 11335, "end": 19215, "text": "El sumo sacerdote, Ananías, mandó entonces a los que estaban delante de él, que le hiriesen en la boca.", "words": [[0, 11335], [3, 11478], [8, 11938], [19, 12618], [28, 13938], [34, 14498], [43, 15058], [45, 15458], [49, 15578], [53, 15718], [61, 16058], [69, 16638], [72, 16838], [76, 17158], [80, 17578], [83, 17928], [92, 18278], [95, 18418], [98, 18678]]}, {"verse": 3, "start": 19665, "end": 29459, "text": "Entonces Pablo le dijo: Dios te herirá, pared blanqueada: ¿y estás tú sentado para juzgarme conforme a la ley, y contra la ley me mandas herir?", "words": [[0, 19665], [9, 20223], [15, 20983], [18, 21283], [24, 21998], [29, 22298], [32, 22578], [40, 23018], [46, 23338], [58, 24541], [61, 24643], [67, 24903], [70, 25143], [78, 25663], [83, 25883], [92, 26503], [101, 27063], [103, 27163], [106, 27243], [111, 27843], [113, 27903], [120, 28183], [123, 28363], [127, 28563], [130, 28683], [137, 29063]]}, {"verse": 4, "start": 29809, "end": 34428, "text": "Y los que estaban presentes dijeron: ¿Al sumo sacerdote de Dios maldices?", "words": [[0, 29809], [2, 29922], [6, 30082], [10, 30262], [18, 30582], [28, 31382], [37, 32225], [41, 32362], [46, 32702], [56, 33282], [59, 33442], [64, 33642]]}, {"verse": 5, "start": 34778, "end": 42855, "text": "Y Pablo dijo: No sabía, hermanos, que era el sumo sacerdote; pues escrito está: Al príncipe de tu pueblo no maldecirás.", "words": [[0, 34778], [2, 34923], [8, 35263], [14, 36061], [17, 36260], [24, 36640], [34, 37200], [38, 37360], [42, 37540], [45, 37640], [50, 37980], [61, 39017], [66, 39162], [74, 39522], [80, 40377], [83, 40495], [92, 40975], [95, 41115], [98, 41255], [105, 41595], [108, 41935]]}, {"verse": 6, "start": 43205, "end": 58939, "text": "Entonces Pablo, sabiendo que una parte era de saduceos y la otra de fariseos, clamó en el Consejo: Varones hermanos, yo soy fariseo, hijo de fariseo: de la esperanza y de la resurrección de los muertos soy yo juzgado.", "words": [[0, 43205], [9, 43797], [16, 45017], [25, 45657], [29, 45857], [33, 45997], [39, 46417], [43, 46797], [46, 46977], [55, 47837], [57, 48077], [60, 48217], [65, 48457], [68, 48657], [78, 49837], [84, 50297], [87, 50477], [90, 50597], [99, 51860], [107, 52070], [117, 52950], [120, 53070], [124, 53250], [133, 54070], [138, 54230], [141, 54390], [150, 55332], [153, 55432], [156, 55532], [166, 56172], [168, 56292], [171, 56392], [174, 56512], [187, 57192], [190, 57332], [194, 57452], [202, 57912], [206, 58192], [209, 58312]]}, {"verse": 7, "start": 59289, "end": 67142, "text": "Y cuando hubo dicho esto, fue hecha división entre los fariseos y los saduceos; y la multitud fue dividida.", "words": [[0, 59289], [2, 59389], [9, 59609], [14, 59969], [20, 60169], [26, 61029], [30, 61389], [36, 61609], [45, 62209], [51, 62469], [55, 62689], [64, 63429], [66, 63569], [70, 63729], [80, 65146], [82, 65268], [85, 65348], [94, 65968], [98, 66328]]}, {"verse": 8, "start": 67592, "end": 75804, "text": "Porque los saduceos dicen que no hay resurrección, ni ángel, ni espíritu; pero los fariseos confiesan ambas cosas.", "words": [[0, 67592], [7, 67777], [11, 67957], [20, 68737], [26, 68997], [30, 69237], [33, 69457], [37, 69657], [51, 71037], [54, 71297], [61, 72177], [64, 72317], [74, 73322], [79, 73466], [83, 73666], [92, 74246], [102, 74846], [108, 75126]]}, {"verse": 9, "start": 76254, "end": 90629, "text": "Y se levantó un gran clamor: y levantándose los escribas de la parte de los fariseos, contendían diciendo: Ningún mal hallamos en este hombre; que si espíritu le ha hablado, o ángel, no resistamos a Dios.", "words": [[0, 76254], [2, 76465], [5, 76585], [13, 77185], [16, 77445], [21, 78010], [29, 78811], [31, 78938], [44, 79938], [48, 80118], [57, 80698], [60, 80818], [63, 80938], [69, 81198], [72, 81398], [76, 81518], [86, 82388], [97, 83258], [107, 84317], [114, 84699], [118, 85029], [127, 85359], [130, 85539], [135, 85759], [143, 86546], [147, 86650], [150, 86790], [159, 87430], [162, 87550], [165, 87650], [174, 88150], [176, 88390], [183, 89230], [186, 89330], [197, 89970], [199, 90150]]}, {"verse": 10, "start": 90979, "end": 104947, "text": "Y habiendo gran disputa, el comandante, teniendo temor de que Pablo fuese despedazado de ellos, mandó venir soldados, y arrebatarle de en medio de ellos, y llevarle a la fortaleza.", "words": [[0, 90979], [2, 91102], [11, 91422], [16, 91722], [25, 92112], [28, 92502], [40, 93135], [49, 93769], [55, 94402], [58, 94622], [62, 94742], [68, 95302], [74, 95742], [86, 97042], [89, 97222], [96, 98062], [102, 98502], [108, 98762], [118, 99602], [120, 100242], [132, 101222], [135, 101602], [138, 101782], [144, 102042], [147, 102262], [154, 102622], [156, 103162], [165, 103762], [167, 103942], [170, 104042]]}, {"verse": 11, "start": 105397, "end": 117828, "text": "Y la noche siguiente, presentándosele el Señor, le dijo: Confía, Pablo; que como has testificado de mí en Jerusalén, así es necesario testifiques también en Roma.", "words": [[0, 105397], [2, 105519], [5, 105639], [11, 105879], [22, 106759], [38, 107939], [41, 108119], [48, 109099], [51, 109179], [57, 110038], [65, 110578], [72, 111455], [76, 111899], [81, 112139], [85, 112359], [97, 113039], [100, 113239], [103, 113419], [106, 113559], [117, 114659], [121, 114899], [124, 115199], [134, 115919], [146, 116639], [154, 117019], [157, 117259]]}, {"verse": 12, "start": 118278, "end": 130242, "text": "Y venido el día, algunos de los judíos se juntaron, e hicieron voto bajo de maldición, diciendo que ni comerían ni beberían hasta que hubiesen muerto a Pablo.", "words": [[0, 118278], [2, 118399], [9, 118779], [12, 118939], [17, 119779], [25, 120219], [28, 120419], [32, 120559], [39, 121059], [42, 121199], [52, 121939], [54, 122339], [63, 122819], [68, 123339], [73, 123559], [76, 123819], [87, 125039], [96, 125559], [100, 125999], [103, 126359], [112, 127119], [115, 127439], [124, 128139], [130, 128479], [134, 128659], [143, 129039], [150, 129539], [152, 129679]]}, {"verse": 13, "start": 130692, "end": 133866, "text": "Y eran más de cuarenta los que habían hecho esta conspiración;", "words": [[0, 130692], [2, 130833], [7, 131013], [11, 131253], [14, 131493], [23, 131733], [27, 132033], [31, 132213], [38, 132473], [44, 132693], [49, 132913]]}, {"verse": 14, "start": 134316, "end": 145820, "text": "Los cuales se fueron a los principales sacerdotes y a los ancianos, y dijeron: Nosotros hemos hecho voto debajo de maldición, que no hemos de comer nada hasta que hayamos muerto a Pablo.", "words": [[0, 134316], [4, 134406], [11, 134626], [14, 134866], [21, 135106], [23, 135306], [27, 135426], [39, 136066], [50, 136786], [52, 137206], [54, 137266], [58, 137366], [68, 138046], [70, 138166], [79, 139746], [88, 140145], [94, 140405], [100, 140685], [105, 141125], [112, 141465], [115, 141625], [126, 142545], [130, 142785], [133, 143005], [139, 143165], [142, 143365], [148, 143565], [153, 143985], [159, 144385], [163, 144545], [171, 144885], [178, 145265], [180, 145405]]}, {"verse": 15, "start": 146270, "end": 158689, "text": "Ahora pues, vosotros, con el Consejo, requerid al comandante que le saque mañana a vosotros como que queréis entender de él alguna cosa más cierta; y nosotros, antes que él llegue, estaremos listos para matarle.", "words": [[0, 146270], [6, 146526], [12, 146766], [22, 147286], [26, 147566], [29, 147686], [38, 148416], [47, 149146], [50, 149266], [61, 149946], [65, 150086], [68, 150206], [74, 150546], [81, 150886], [83, 151106], [92, 151606], [97, 152186], [101, 152456], [109, 152726], [118, 153166], [121, 153486], [124, 153686], [131, 153966], [136, 154346], [140, 154526], [148, 155396], [150, 155501], [160, 155681], [166, 156081], [170, 156341], [173, 156461], [181, 157061], [191, 157501], [198, 157941], [203, 158101]]}, {"verse": 16, "start": 159039, "end": 167390, "text": "Entonces un hijo de la hermana de Pablo, oyendo las emboscadas, fue, y entró en la fortaleza, y dio aviso a Pablo.", "words": [[0, 159039], [9, 160244], [12, 160544], [17, 160784], [20, 160944], [23, 161084], [31, 161484], [34, 161624], [41, 162164], [48, 162544], [52, 162764], [64, 163704], [69, 163864], [71, 164484], [77, 164964], [80, 165084], [83, 165204], [94, 165904], [96, 166064], [100, 166404], [106, 166744], [108, 166864]]}, {"verse": 17, "start": 167840, "end": 175824, "text": "Y Pablo, llamando a uno de los centuriones, dice: Lleva a este joven al comandante, porque tiene cierto aviso que darle.", "words": [[0, 167840], [2, 167956], [9, 168476], [18, 168956], [20, 169156], [24, 169356], [27, 169496], [31, 169616], [44, 170716], [50, 171554], [56, 171837], [58, 171957], [63, 172177], [69, 172617], [72, 172737], [84, 173657], [91, 174017], [97, 174357], [104, 174737], [110, 175197], [114, 175357]]}, {"verse": 18, "start": 176174, "end": 185937, "text": "Él entonces tomándole, le llevó al comandante, y dijo: El preso Pablo, llamándome, me rogó que trajese a ti este joven, que tiene algo que hablarte.", "words": [[0, 176174], [3, 176799], [12, 177439], [23, 178009], [26, 178579], [32, 178899], [35, 178999], [47, 179679], [49, 179819], [55, 180565], [58, 180689], [64, 181049], [71, 181589], [83, 182449], [86, 182609], [91, 182949], [95, 183259], [103, 183569], [105, 183709], [108, 183829], [113, 184069], [120, 184609], [124, 184689], [130, 184949], [135, 185189], [139, 185349]]}, {"verse": 19, "start": 186287, "end": 193795, "text": "Y el comandante, tomándole de la mano y retirándose aparte, le preguntó: ¿Qué es lo que tienes que decirme?", "words": [[0, 186287], [2, 186451], [5, 186591], [17, 187251], [27, 187991], [30, 188111], [33, 188271], [38, 188691], [40, 189211], [52, 190011], [60, 191231], [63, 191311], [73, 192245], [78, 192385], [81, 192505], [84, 192645], [88, 192745], [95, 193005], [99, 193185]]}, {"verse": 20, "start": 194145, "end": 202171, "text": "Y él dijo: Los judíos han convenido en rogarte que mañana saques a Pablo al Consejo, como que han de inquirir de él alguna cosa más cierta.", "words": [[0, 194145], [2, 194333], [5, 194493], [11, 195262], [15, 195352], [22, 195832], [26, 195972], [36, 196532], [39, 196632], [47, 197072], [51, 197252], [58, 197532], [65, 198112], [67, 198312], [73, 198532], [76, 198752], [85, 199452], [90, 199612], [94, 199837], [98, 200062], [101, 200287], [110, 200512], [113, 200612], [116, 200792], [123, 201072], [128, 201392], [132, 201552]]}, {"verse": 21, "start": 202621, "end": 215341, "text": "Pero tú no los creas; porque más de cuarenta hombres de ellos le acechan, los cuales han hecho voto debajo de maldición, de no comer ni beber hasta que le hayan muerto; y ahora están listos esperando tu promesa.", "words": [[0, 202621], [5, 202747], [8, 202947], [11, 203067], [15, 203207], [22, 204059], [29, 204286], [33, 204586], [36, 204886], [45, 205186], [53, 205546], [56, 205786], [62, 206046], [65, 206246], [74, 207126], [78, 207206], [85, 207526], [89, 207886], [95, 208126], [100, 208566], [107, 208946], [110, 209106], [121, 210086], [124, 210146], [127, 210346], [133, 210626], [136, 210886], [142, 211186], [148, 211546], [152, 211726], [155, 211866], [161, 212206], [169, 213048], [171, 213130], [177, 213290], [183, 213550], [190, 214010], [200, 214390], [203, 214670]]}, {"verse": 22, "start": 215691, "end": 223297, "text": "Entonces el comandante despidió al joven, mandándole que a nadie dijese que le había dado aviso de esto.", "words": [[0, 215691], [9, 216188], [12, 216548], [23, 217248], [32, 217928], [35, 218028], [42, 218548], [53, 219508], [57, 219788], [59, 220168], [65, 220508], [72, 221128], [76, 221328], [79, 221488], [85, 221748], [90, 222048], [96, 222548], [99, 222748]]}, {"verse": 23, "start": 223747, "end": 236318, "text": "Y llamados dos centuriones, mandó que preparasen para la tercera hora de la noche doscientos soldados, que fuesen hasta Cesarea, y setenta de a caballo, y doscientos lanceros;", "words": [[0, 223747], [2, 223870], [11, 224250], [15, 224490], [28, 225810], [34, 226230], [38, 226690], [49, 227150], [54, 227430], [57, 227630], [65, 228070], [70, 228510], [73, 228630], [76, 228770], [82, 229090], [93, 229410], [103, 230470], [107, 230870], [114, 231330], [120, 231690], [129, 232450], [131, 232950], [139, 233450], [142, 233777], [144, 234103], [153, 234430], [155, 234890], [166, 235350]]}, {"verse": 24, "start": 236768, "end": 244250, "text": "Y que preparasen cabalgaduras en que poniendo a Pablo, le llevasen a salvo a Félix el gobernador.", "words": [[0, 236768], [2, 236890], [6, 237010], [17, 238020], [30, 239030], [33, 239430], [37, 239590], [46, 240110], [48, 240270], [55, 240783], [58, 241297], [67, 241810], [69, 241930], [75, 242330], [77, 242430], [83, 243010], [86, 243370]]}, {"verse": 25, "start": 244700, "end": 247517, "text": "Y escribió una carta en estos términos:", "words": [[0, 244700], [2, 244957], [11, 245617], [15, 245777], [21, 246197], [24, 246417], [30, 246617]]}, {"verse": 26, "start": 247767, "end": 252044, "text": "Claudio Lisias al excelentísimo gobernador Félix: Saludos.", "words": [[0, 247767], [8, 248291], [15, 248821], [18, 248901], [32, 249661], [43, 250301], [50, 251291]]}, {"verse": 27, "start": 252494, "end": 260426, "text": "A este hombre, aprehendido de los judíos, y que iban ellos a matar, libré yo acudiendo con la tropa, habiendo entendido que era Romano.", "words": [[0, 252494], [2, 252620], [7, 252820], [15, 253330], [27, 253840], [30, 253960], [34, 254080], [42, 254700], [44, 255040], [48, 255180], [53, 255440], [59, 255620], [61, 255800], [68, 256640], [74, 257040], [77, 257220], [87, 257760], [91, 257920], [94, 258080], [101, 258600], [110, 258960], [120, 259540], [124, 259720], [128, 259860]]}, {"verse": 28, "start": 260876, "end": 265488, "text": "Y queriendo saber la causa por qué le acusaban, le llevé al Consejo de ellos:", "words": [[0, 260876], [2, 260975], [12, 261395], [18, 261715], [21, 261935], [27, 262255], [31, 262555], [35, 262695], [38, 262815], [48, 263755], [51, 263975], [57, 264255], [60, 264395], [68, 264855], [71, 264975]]}, {"verse": 29, "start": 265938, "end": 272526, "text": "Y hallé que le acusaban de cuestiones de la ley de ellos, y que ningún crimen tenía digno de muerte o de prisión.", "words": [[0, 265938], [2, 266135], [8, 266335], [12, 266515], [15, 266635], [24, 267155], [27, 267295], [38, 267875], [41, 268075], [44, 268195], [48, 268395], [51, 268535], [58, 268855], [60, 269315], [64, 269435], [71, 269735], [78, 270235], [84, 270555], [90, 271035], [93, 271095], [100, 271455], [102, 271795], [105, 271915]]}, {"verse": 30, "start": 272976, "end": 285143, "text": "Pero siéndome dado aviso de emboscadas que le habían tendido los judíos, luego al punto le he enviado a ti, ordenando también a los acusadores que traten delante de ti lo que tienen contra él. Pásalo bien.", "words": [[0, 272976], [5, 273306], [14, 273636], [19, 273856], [25, 274216], [28, 274356], [39, 274916], [43, 275136], [46, 275236], [53, 275476], [61, 275976], [65, 276116], [73, 277036], [79, 277196], [82, 277396], [88, 277656], [91, 277896], [94, 277996], [102, 278376], [104, 278496], [108, 279109], [118, 279671], [126, 279991], [128, 280231], [132, 280311], [143, 280951], [147, 281231], [154, 281651], [162, 282131], [165, 282291], [168, 282511], [171, 282811], [175, 282951], [182, 283271], [189, 283631], [193, 284324], [200, 284692]]}, {"verse": 31, "start": 285493, "end": 291501, "text": "Y los soldados, tomando a Pablo como les era mandado, le llevaron de noche a Antipatris.", "words": [[0, 285493], [2, 285605], [6, 285745], [16, 286345], [24, 286905], [26, 287045], [32, 287365], [37, 287685], [41, 287905], [45, 288105], [54, 288725], [57, 289345], [66, 289745], [69, 289905], [75, 290185], [77, 290525]]}, {"verse": 32, "start": 291951, "end": 298763, "text": "Y al día siguiente, dejando a los de a caballo que fuesen con él, se volvieron a la fortaleza.", "words": [[0, 291951], [2, 292091], [5, 292211], [9, 292391], [20, 293191], [28, 293731], [30, 293931], [34, 294191], [37, 294511], [39, 294671], [47, 295111], [51, 295251], [58, 295671], [62, 295911], [66, 296711], [69, 296931], [79, 297471], [81, 297731], [84, 297831]]}, {"verse": 33, "start": 299213, "end": 306858, "text": "Y cuando llegaron a Cesarea, y dieron la carta al gobernador, presentaron también a Pablo delante de él.", "words": [[0, 299213], [2, 299300], [9, 299480], [18, 300020], [20, 300200], [29, 300780], [31, 301520], [38, 301860], [41, 302040], [47, 302440], [50, 302680], [62, 303780], [74, 304640], [82, 305020], [84, 305280], [90, 305640], [98, 306220], [101, 306566]]}, {"verse": 34, "start": 307308, "end": 314103, "text": "Y el gobernador, leída la carta, preguntó de qué provincia era; y entendiendo que de Cilicia,", "words": [[0, 307308], [2, 307550], [5, 307670], [17, 308330], [23, 308990], [26, 309130], [33, 309970], [42, 310550], [45, 310670], [49, 310790], [59, 311430], [64, 312205], [66, 312348], [78, 312968], [82, 313347], [85, 313725]]}, {"verse": 35, "start": 314353, "end": 321799, "text": "Te oiré, dijo, cuando vengan tus acusadores. Y mandó que le guardasen en el pretorio de Herodes.", "words": [[0, 314353], [3, 314630], [9, 315246], [15, 316070], [22, 316246], [29, 316706], [33, 316906], [45, 318357], [47, 318486], [53, 318886], [57, 319026], [60, 319166], [70, 319866], [73, 320006], [76, 320166], [85, 320806], [88, 320946]]}]}