{"book": "PSA", "chapter": 41, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 94069, "verses": [{"verse": 1, "start": 300, "end": 8862, "text": "Al Músico principal: Salmo de David. BIENAVENTURADO el que piensa en el pobre: en el día malo lo librará Jehová.", "words": [[0, 300], [3, 471], [10, 991], [21, 2111], [27, 2630], [30, 2790], [37, 4100], [52, 4560], [55, 4700], [59, 4820], [66, 5360], [69, 5460], [72, 5580], [79, 6611], [82, 6762], [85, 6902], [89, 7102], [94, 7522], [97, 7642], [105, 8142]]}, {"verse": 2, "start": 9312, "end": 18091, "text": "Jehová lo guarde, y le dé vida: sea bienaventurado en la tierra, y no lo entregues a la voluntad de sus enemigos.", "words": [[0, 9312], [7, 9776], [10, 9875], [18, 10535], [20, 10835], [23, 10975], [26, 11135], [32, 12728], [36, 13282], [51, 13872], [54, 13972], [57, 14092], [65, 14512], [67, 15032], [70, 15172], [73, 15312], [83, 16032], [85, 16172], [88, 16252], [97, 16872], [100, 17012], [104, 17192]]}, {"verse": 3, "start": 18541, "end": 25129, "text": "Jehová lo sustentará sobre el lecho del dolor: arreglarás toda su cama en su enfermedad.", "words": [[0, 18541], [7, 19079], [10, 19179], [21, 20039], [27, 20359], [30, 20659], [36, 20979], [40, 21179], [47, 22076], [58, 23040], [63, 23280], [66, 23560], [71, 23940], [74, 24120], [77, 24240]]}, {"verse": 4, "start": 25579, "end": 32138, "text": "Yo dije: Jehová, ten misericordia de mí; sana mi alma, porque contra ti he pecado.", "words": [[0, 25817], [3, 26088], [9, 26850], [17, 27110], [21, 27370], [34, 28290], [37, 28390], [41, 28990], [46, 29295], [49, 29535], [55, 30155], [62, 30555], [69, 30915], [72, 31195], [75, 31455]]}, {"verse": 5, "start": 32588, "end": 37774, "text": "Mis enemigos dicen mal de mí preguntando: ¿Cuándo morirá, y perecerá su nombre?", "words": [[0, 32588], [4, 32695], [13, 33275], [19, 33615], [23, 34035], [26, 34295], [29, 34435], [42, 35663], [50, 36059], [58, 36499], [60, 36619], [69, 37139], [72, 37259]]}, {"verse": 6, "start": 38124, "end": 45926, "text": "Y si venía a verme, hablaba mentira: su corazón se amontonaba iniquidad; y salido fuera, la hablaba.", "words": [[0, 38124], [2, 38294], [5, 38394], [11, 38734], [13, 38894], [20, 39314], [28, 40114], [37, 41259], [40, 41402], [48, 41842], [51, 42202], [62, 42942], [73, 44267], [75, 44373], [82, 44773], [89, 45013], [92, 45333]]}, {"verse": 7, "start": 46376, "end": 54743, "text": "Reunidos murmuraban contra mí todos los que me aborrecían: contra mí pensaban mal, diciendo de mí:", "words": [[0, 46376], [9, 47158], [20, 48238], [27, 48658], [30, 48938], [36, 49478], [40, 49898], [44, 50078], [47, 50641], [59, 51505], [66, 51965], [69, 52165], [78, 52805], [83, 53685], [92, 54085], [95, 54445]]}, {"verse": 8, "start": 54993, "end": 59963, "text": "Cosa pestilencial de él se ha apoderado; y el que cayó en cama, no volverá a levantarse.", "words": [[0, 54993], [5, 55170], [18, 55890], [21, 56110], [24, 56270], [27, 56450], [30, 56570], [41, 57561], [43, 57645], [46, 57725], [50, 57845], [55, 58125], [58, 58225], [64, 58505], [67, 58805], [75, 59225], [77, 59225]]}, {"verse": 9, "start": 60314, "end": 67803, "text": "Aun el hombre de mi paz, en quien yo confiaba, el que de mi pan comía, se volvió contra mí.", "words": [[0, 60314], [4, 60617], [7, 60837], [14, 61077], [17, 61317], [20, 61477], [25, 62297], [28, 62717], [34, 62957], [37, 63257], [47, 63997], [50, 64697], [54, 64877], [57, 65037], [60, 65177], [64, 65477], [71, 66117], [74, 66617], [81, 67057], [88, 67397]]}, {"verse": 10, "start": 68253, "end": 74086, "text": "Mas tú, Jehová, ten misericordia de mí, y hazme levantar, y les daré el pago.", "words": [[0, 68253], [4, 68455], [8, 69025], [16, 69595], [20, 69675], [33, 70635], [36, 70795], [40, 70975], [42, 71515], [48, 71855], [58, 72555], [60, 72875], [64, 73035], [69, 73395], [72, 73515]]}, {"verse": 11, "start": 74536, "end": 78988, "text": "En esto habré conocido que te he agradado, que mi enemigo no se alegrará de mí.", "words": [[0, 74536], [3, 74800], [8, 75000], [14, 75320], [23, 75840], [27, 75960], [30, 76120], [33, 76280], [43, 76840], [47, 77000], [50, 77180], [58, 77580], [61, 77760], [64, 77980], [73, 78540], [76, 78720]]}, {"verse": 12, "start": 79438, "end": 86488, "text": "En cuanto a mí, en mi integridad me has sustentado, y me has hecho estar delante de ti para siempre.", "words": [[0, 79438], [3, 79602], [10, 79762], [12, 80002], [16, 80642], [19, 80782], [22, 80962], [33, 81722], [36, 82162], [40, 82322], [52, 83182], [54, 83522], [57, 83662], [61, 83842], [67, 84202], [73, 84442], [81, 85042], [84, 85222], [87, 85442], [92, 85702]]}, {"verse": 13, "start": 86938, "end": 93669, "text": "Bendito sea Jehová, el Dios de Israel, por siglos de siglos. Amén y Amén.", "words": [[0, 86938], [8, 87604], [12, 87884], [20, 88584], [23, 88824], [28, 89164], [31, 89444], [39, 90024], [43, 90684], [50, 91224], [53, 91404], [61, 92402], [66, 92866], [68, 93186]]}]}