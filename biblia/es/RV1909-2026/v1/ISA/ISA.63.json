{"book": "ISA", "chapter": 63, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 197262, "verses": [{"verse": 1, "start": 300, "end": 13948, "text": "¿Quién es este que viene de Edom, de Bosra con vestidos rojos? ¿este hermoso en su vestido, que marcha en la grandeza de su poder? Yo, el que hablo en justicia, grande para salvar.", "words": [[0, 300], [7, 586], [10, 786], [15, 1086], [19, 1326], [25, 1706], [28, 1986], [34, 2686], [37, 3506], [43, 4086], [47, 4386], [56, 4926], [63, 6042], [69, 6286], [77, 7146], [80, 7246], [83, 7426], [92, 8046], [96, 8206], [103, 8726], [106, 8806], [109, 8966], [118, 9606], [121, 9766], [124, 9906], [131, 10790], [135, 11198], [138, 11278], [142, 11418], [148, 11698], [151, 11778], [161, 12718], [168, 13038], [173, 13298]]}, {"verse": 2, "start": 14582, "end": 19635, "text": "¿Por qué es rojo tu vestido, y tus ropas como del que ha pisado en lagar?", "words": [[0, 14661], [5, 14775], [9, 14888], [12, 15128], [17, 15508], [20, 15648], [29, 16568], [31, 16888], [35, 17048], [41, 17568], [46, 17948], [50, 18148], [54, 18348], [57, 18488], [64, 18928], [67, 19048]]}, {"verse": 3, "start": 19935, "end": 32745, "text": "Yo solo he pisado el lagar, y de los pueblos nadie fue conmigo: los pisé con mi ira, y los hollé con mi furor; y su sangre salpicó mis vestidos, y ensucié todas mis ropas.", "words": [[0, 19935], [3, 20100], [8, 20480], [11, 20720], [18, 21160], [21, 21260], [28, 21720], [30, 22140], [33, 22260], [37, 22440], [45, 22960], [51, 23260], [55, 23580], [64, 24862], [68, 25003], [73, 25403], [77, 25623], [80, 25823], [85, 26303], [87, 26463], [91, 26713], [97, 26963], [101, 27183], [104, 27323], [111, 28314], [113, 28415], [116, 28555], [123, 28955], [131, 29555], [135, 29695], [145, 30315], [147, 30855], [155, 31495], [161, 31755], [165, 32035]]}, {"verse": 4, "start": 33430, "end": 38596, "text": "Porque el día de la venganza está en mi corazón, y el año de mis redimidos es venido.", "words": [[0, 33430], [7, 33636], [10, 33816], [14, 34016], [17, 34156], [20, 34256], [29, 34856], [34, 35056], [37, 35196], [40, 35296], [49, 35756], [51, 36356], [54, 36516], [58, 36736], [61, 36916], [65, 37276], [75, 37636], [78, 37996]]}, {"verse": 5, "start": 39276, "end": 47206, "text": "Y miré y no había quien ayudara, y me maravillé que no hubiera quien sustentase: y me salvó mi brazo, y me sostuvo mi ira.", "words": [[0, 39276], [2, 39414], [7, 39794], [9, 39974], [12, 40114], [18, 40374], [24, 40634], [33, 41214], [35, 41654], [38, 41754], [48, 42334], [52, 42474], [55, 42594], [63, 42914], [69, 43114], [81, 44605], [83, 44706], [86, 44786], [92, 45146], [95, 45246], [102, 45766], [104, 46066], [107, 46146], [115, 46586], [118, 46786]]}, {"verse": 6, "start": 47895, "end": 53884, "text": "Y con mi ira hollé los pueblos, y los embriagué de mi furor, y derribé a tierra su fortaleza.", "words": [[0, 47895], [2, 48058], [6, 48262], [9, 48466], [13, 48670], [19, 48874], [23, 49054], [32, 49754], [34, 49934], [38, 50094], [48, 50554], [51, 50714], [54, 50834], [61, 51314], [63, 51894], [71, 52394], [73, 52474], [80, 52754], [83, 53034]]}, {"verse": 7, "start": 54488, "end": 73062, "text": "De las misericordias de Jehová haré memoria, de las alabanzas de Jehová, conforme a todo lo que Jehová nos ha dado, y de la grandeza de su beneficencia hacia la casa de Israel, que les ha hecho según sus misericordias, y según la multitud de sus misericordias.", "words": [[0, 54488], [3, 54614], [7, 54734], [21, 55654], [24, 55794], [31, 56144], [36, 56494], [45, 57654], [48, 57994], [52, 58154], [62, 58834], [65, 58974], [73, 59514], [82, 60234], [84, 60374], [89, 60574], [92, 60814], [96, 60934], [103, 61434], [107, 61574], [110, 61774], [116, 62583], [118, 62708], [121, 62808], [124, 62948], [133, 63568], [136, 63708], [139, 63868], [152, 64848], [158, 65168], [161, 65468], [166, 65848], [169, 66088], [177, 67148], [181, 67348], [185, 67528], [188, 67728], [194, 67988], [200, 68408], [204, 69228], [219, 69748], [221, 70208], [227, 70528], [230, 70748], [239, 71468], [242, 71668], [246, 71828]]}, {"verse": 8, "start": 73512, "end": 80028, "text": "Porque dijo: Ciertamente mi pueblo son, hijos que no mienten; y fue su Salvador.", "words": [[0, 73512], [7, 73714], [13, 74529], [25, 75313], [28, 75453], [35, 75813], [40, 76293], [46, 76953], [50, 77293], [53, 77473], [62, 78737], [64, 78882], [68, 79062], [71, 79222]]}, {"verse": 9, "start": 80478, "end": 94050, "text": "En toda angustia de ellos él fue angustiado, y el ángel de su faz los salvó: en su amor y en su clemencia los redimió, y los trajo, y los levantó todos los días del siglo.", "words": [[0, 80478], [3, 80643], [8, 80843], [17, 81543], [20, 81683], [26, 82023], [29, 82403], [33, 82623], [45, 83423], [47, 83863], [50, 84003], [56, 84403], [59, 84543], [62, 84703], [66, 85013], [70, 85323], [77, 86210], [80, 86377], [83, 86557], [88, 86997], [90, 87537], [93, 87677], [96, 88067], [106, 88457], [110, 88697], [119, 89557], [121, 90077], [125, 90237], [132, 90877], [134, 91397], [138, 91577], [146, 92317], [152, 92537], [156, 92877], [161, 93117], [165, 93377]]}, {"verse": 10, "start": 94500, "end": 104412, "text": "Mas ellos fueron rebeldes, e hicieron enojar su espíritu santo; por lo cual se les volvió enemigo, y él mismo peleó contra ellos.", "words": [[0, 94500], [4, 94623], [10, 94823], [17, 95163], [27, 96003], [29, 96343], [38, 96903], [45, 97543], [48, 97723], [57, 98323], [64, 99285], [68, 99426], [71, 99546], [76, 99826], [79, 100026], [83, 100186], [90, 100806], [99, 101786], [101, 102086], [104, 102286], [110, 102686], [116, 103306], [123, 103646]]}, {"verse": 11, "start": 104862, "end": 117228, "text": "Pero se acordó de los días antiguos, de Moisés y de su pueblo, diciendo: ¿Dónde está el que les hizo subir del mar con el pastor de su rebaño? ¿dónde el que puso en medio de él su espíritu santo?", "words": [[0, 104862], [5, 105004], [8, 105164], [15, 105644], [18, 105744], [22, 105844], [27, 106044], [37, 106924], [40, 107444], [47, 107964], [49, 108624], [52, 108744], [55, 108904], [63, 109384], [73, 110770], [80, 111027], [85, 111247], [88, 111367], [92, 111487], [96, 111627], [101, 111867], [107, 112147], [111, 112367], [115, 112647], [119, 112847], [122, 112967], [129, 113327], [132, 113527], [135, 113667], [143, 114579], [150, 114816], [153, 114956], [157, 115076], [162, 115436], [165, 115516], [171, 115716], [174, 115956], [177, 116096], [180, 116236], [189, 116716]]}, {"verse": 12, "start": 117678, "end": 126360, "text": "¿El que los guio por la diestra de Moisés con el brazo de su gloria; el que rompió las aguas delante de ellos, haciéndose así nombre perpetuo?", "words": [[0, 117678], [4, 117800], [8, 117920], [12, 118080], [17, 118420], [21, 118640], [24, 118760], [32, 119180], [35, 119340], [42, 119720], [46, 120020], [49, 120160], [55, 120540], [58, 120660], [61, 120800], [69, 121636], [72, 121754], [76, 121874], [83, 122354], [87, 122534], [93, 122954], [101, 123374], [104, 123554], [111, 124194], [122, 124954], [126, 125254], [133, 125554]]}, {"verse": 13, "start": 126810, "end": 132002, "text": "¿El que los condujo por los abismos, como un caballo por el desierto, sin que tropezaran?", "words": [[0, 126810], [4, 126934], [8, 127054], [12, 127214], [20, 127774], [24, 127974], [28, 128114], [37, 128854], [42, 129094], [45, 129234], [53, 129634], [57, 129834], [60, 129954], [70, 130734], [74, 131014], [78, 131174]]}, {"verse": 14, "start": 132352, "end": 141566, "text": "El espíritu de Jehová los pastoreó, como a una bestia que desciende al valle; así pastoreaste tu pueblo, para hacerte nombre glorioso.", "words": [[0, 132352], [3, 132492], [12, 133112], [15, 133192], [22, 133652], [26, 134002], [36, 134352], [41, 134612], [43, 134772], [47, 134912], [54, 135432], [58, 135552], [68, 136092], [71, 136272], [78, 137143], [82, 137383], [94, 138163], [97, 138383], [105, 138783], [110, 139362], [118, 140103], [125, 140603]]}, {"verse": 15, "start": 142016, "end": 156476, "text": "Mira desde el cielo, y contempla desde la morada de tu santidad y de tu gloria: ¿dónde está tu celo, y tu fortaleza, la conmoción de tus entrañas y de tus misericordias para conmigo? ¿se han estrechado?", "words": [[0, 142016], [5, 142264], [11, 142504], [14, 142704], [21, 143244], [23, 144044], [33, 144724], [39, 144904], [42, 145104], [49, 145524], [52, 145684], [55, 145824], [64, 146504], [66, 146704], [69, 146804], [72, 146944], [80, 147863], [87, 148201], [92, 148421], [95, 148641], [101, 149281], [103, 149401], [106, 149521], [117, 150761], [120, 150881], [130, 151541], [133, 151761], [137, 151901], [146, 152661], [148, 152861], [151, 152961], [155, 153121], [169, 154041], [174, 154261], [183, 155286], [187, 155448], [191, 155568]]}, {"verse": 16, "start": 156926, "end": 170016, "text": "Pero tú eres nuestro padre, si bien Abraham nos ignora, e Israel no nos conoce: tú, oh Jehová, eres nuestro padre; nuestro Redentor perpetuo es tu nombre.", "words": [[0, 156926], [5, 157226], [8, 157526], [13, 157766], [21, 158126], [28, 158786], [31, 158886], [36, 159166], [44, 159786], [48, 160046], [56, 160626], [58, 160886], [65, 161726], [68, 161886], [72, 162106], [80, 163155], [84, 163584], [87, 164050], [95, 164517], [100, 164717], [108, 165277], [115, 166335], [123, 167222], [132, 168142], [141, 169022], [144, 169262], [147, 169382]]}, {"verse": 17, "start": 170466, "end": 181690, "text": "¿Por qué, oh Jehová, nos has hecho errar de tus caminos, y endureciste nuestro corazón a tu temor? Vuélvete por amor de tus siervos, por las tribus de tu heredad.", "words": [[0, 170466], [5, 170608], [10, 170915], [13, 171221], [21, 171528], [25, 172288], [29, 172528], [35, 172858], [41, 173188], [44, 173368], [48, 173548], [57, 174188], [59, 174648], [71, 175588], [79, 175808], [87, 176528], [89, 176788], [92, 176908], [99, 177771], [108, 178311], [112, 178551], [117, 178791], [120, 178991], [124, 179151], [133, 179910], [137, 180151], [141, 180331], [148, 180791], [151, 180910], [154, 181071]]}, {"verse": 18, "start": 182140, "end": 189052, "text": "Por poco tiempo lo poseyó el pueblo de tu santidad: nuestros enemigos han pisoteado tu santuario.", "words": [[0, 182140], [4, 182323], [9, 182563], [16, 182936], [19, 183310], [26, 183683], [29, 183883], [36, 184263], [39, 184543], [42, 184723], [52, 185874], [61, 186322], [70, 186882], [74, 187102], [84, 187882], [87, 188082]]}, {"verse": 19, "start": 189502, "end": 196862, "text": "Hemos venido a ser como aquellos a quienes nunca gobernaste, sobre los cuales nunca fue llamado tu nombre.", "words": [[0, 189502], [6, 189722], [13, 190182], [15, 190322], [19, 190542], [24, 190802], [33, 191222], [35, 191522], [43, 191742], [49, 192282], [61, 193522], [67, 193782], [71, 194002], [78, 194302], [84, 195102], [88, 195562], [96, 195962], [99, 196222]]}]}