{"book": "RUT", "chapter": 3, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 164329, "verses": [{"verse": 1, "start": 300, "end": 6873, "text": "Then Naomi her mother in law said to her, My daughter, shall I not seek rest for you, that it may be well with you?", "words": [[0, 300], [5, 548], [11, 1248], [15, 1328], [22, 1568], [25, 1788], [29, 2168], [34, 2288], [37, 2488], [42, 3058], [45, 3227], [55, 3527], [61, 3787], [63, 3927], [67, 4107], [72, 4347], [77, 4647], [81, 4867], [86, 5467], [91, 5607], [94, 5727], [98, 5907], [101, 6047], [106, 6287], [111, 6507]]}, {"verse": 2, "start": 7323, "end": 14629, "text": "And now is not Boaz of our kindred, with whose maidens you were? Behold, he winnows barley tonight in the threshingfloor.", "words": [[0, 7323], [4, 7460], [8, 7740], [11, 7980], [15, 8180], [20, 8620], [23, 8780], [27, 8920], [36, 9660], [41, 9900], [47, 10060], [55, 10580], [59, 10700], [65, 11392], [73, 11972], [76, 12072], [84, 12492], [91, 12912], [99, 13252], [102, 13512], [106, 14101]]}, {"verse": 3, "start": 15079, "end": 26484, "text": "Wash yourself therefore, and anoint you, and put your clothing upon you, and get down to the floor: but make not yourself known to the man, until he shall have done eating and drinking.", "words": [[0, 15079], [5, 15306], [14, 15786], [25, 16326], [29, 16666], [36, 17006], [41, 17286], [45, 17786], [49, 17986], [54, 18146], [63, 18546], [68, 18886], [73, 19266], [77, 19766], [81, 20006], [86, 20326], [89, 20506], [93, 20606], [100, 21486], [104, 21651], [109, 21891], [113, 22151], [122, 22571], [128, 22871], [131, 23091], [135, 23191], [140, 23551], [146, 24171], [149, 24471], [155, 24651], [160, 24811], [165, 25031], [172, 25391], [176, 25811]]}, {"verse": 4, "start": 26934, "end": 38733, "text": "And it shall be, when he lies down, that you shall mark the place where he shall lie, and you shall go in, and uncover his feet, and lay you down; and he will tell you what you shall do.", "words": [[0, 26934], [4, 27054], [7, 27214], [13, 27474], [17, 27754], [22, 28014], [25, 28194], [30, 28434], [36, 29214], [41, 29474], [45, 29674], [51, 29874], [56, 30134], [60, 30314], [66, 30614], [72, 30794], [75, 30974], [81, 31194], [86, 31874], [90, 32134], [94, 32354], [100, 32554], [103, 32794], [107, 33134], [111, 33654], [119, 34094], [123, 34394], [129, 35220], [133, 35368], [137, 35588], [141, 35768], [147, 36612], [151, 36732], [154, 36892], [159, 37052], [164, 37292], [168, 37552], [173, 37812], [177, 38012], [183, 38272]]}, {"verse": 5, "start": 39083, "end": 42281, "text": "And she said to her, All that you say to me I will do.", "words": [[0, 39083], [4, 39208], [8, 39328], [13, 39568], [16, 39768], [21, 40326], [25, 40575], [30, 40795], [34, 40915], [38, 41135], [41, 41315], [44, 41475], [46, 41615], [51, 41775]]}, {"verse": 6, "start": 42631, "end": 47844, "text": "¶ And she went down to the floor, and did according to all that her mother in law bade her.", "words": [[2, 42631], [6, 42745], [10, 42905], [15, 43105], [20, 43365], [23, 43525], [27, 43605], [34, 44385], [38, 44465], [42, 44605], [52, 44925], [55, 45185], [59, 45485], [64, 45665], [68, 45785], [75, 46045], [78, 46225], [82, 46405], [87, 46785]]}, {"verse": 7, "start": 48294, "end": 58622, "text": "And when Boaz had eaten and drunk, and his heart was merry, he went to lie down at the end of the heap of grain: and she came softly, and uncovered his feet, and laid her down.", "words": [[0, 48294], [4, 48416], [9, 48646], [14, 48876], [18, 49156], [24, 49416], [28, 49676], [35, 50456], [39, 50536], [43, 50676], [49, 50956], [53, 51156], [60, 51956], [63, 52016], [68, 52196], [71, 52396], [75, 52596], [80, 52936], [83, 53136], [87, 53236], [91, 53416], [94, 53536], [98, 53636], [103, 53816], [106, 53956], [113, 54831], [117, 54966], [121, 55086], [126, 55326], [134, 55926], [138, 56286], [148, 56706], [152, 56986], [158, 57306], [162, 57606], [167, 57866], [171, 58046]]}, {"verse": 8, "start": 59072, "end": 66217, "text": "¶ And it came to pass at midnight, that the man was afraid, and turned himself: and, behold, a woman lay at his feet.", "words": [[2, 59072], [6, 59218], [9, 59298], [14, 59518], [17, 59698], [22, 60018], [25, 60178], [35, 60618], [40, 61058], [44, 61198], [48, 61418], [52, 61598], [60, 62038], [64, 62518], [71, 62758], [80, 63741], [85, 63924], [93, 64744], [95, 64923], [101, 65164], [105, 65463], [108, 65624], [112, 65764]]}, {"verse": 9, "start": 66667, "end": 76957, "text": "And he said, Who are you? And she answered, I am Ruth your handmaid: spread therefore your skirt over your handmaid; for you are a near kinsman.", "words": [[0, 66667], [4, 66811], [7, 66891], [13, 67594], [17, 67751], [21, 67971], [26, 68758], [30, 68890], [34, 69050], [44, 69883], [46, 70083], [49, 70323], [54, 70603], [59, 70883], [69, 71962], [76, 72366], [86, 72906], [91, 73186], [97, 73566], [102, 73926], [107, 74166], [117, 75223], [121, 75356], [125, 75576], [129, 75836], [131, 75936], [136, 76136]]}, {"verse": 10, "start": 77307, "end": 88294, "text": "And he said, Blessed are you of the LORD, my daughter: for you have showed more kindness in the latter end than at the beginning, inasmuch as you followed not young men, whether poor or rich.", "words": [[0, 77307], [4, 77442], [7, 77582], [13, 79040], [21, 79450], [25, 79670], [29, 79850], [32, 80050], [36, 80170], [42, 80610], [45, 80710], [55, 81442], [59, 81531], [63, 81651], [68, 81811], [75, 82011], [80, 82231], [89, 82631], [92, 82931], [96, 83051], [103, 83271], [107, 83551], [112, 83771], [115, 83911], [119, 83991], [130, 84651], [139, 85311], [142, 85451], [146, 85551], [155, 85851], [159, 86111], [165, 86351], [170, 86911], [178, 87131], [183, 87491], [186, 87791]]}, {"verse": 11, "start": 88744, "end": 95926, "text": "And now, my daughter, fear not; I will do to you all that you require: for all the city of my people does know that you are a virtuous woman.", "words": [[0, 88744], [4, 88867], [9, 89047], [12, 89247], [22, 89547], [27, 89847], [32, 90551], [34, 90671], [39, 90811], [42, 91031], [45, 91211], [49, 91331], [53, 91591], [58, 91771], [62, 91891], [71, 92784], [75, 92859], [79, 93059], [83, 93199], [88, 93419], [91, 93559], [94, 93699], [101, 93979], [106, 94279], [111, 94539], [116, 94719], [120, 94859], [124, 94999], [126, 95039], [135, 95339]]}, {"verse": 12, "start": 96376, "end": 101243, "text": "And now it is true that I am your near kinsman: however there is a kinsman nearer than I.", "words": [[0, 96376], [4, 96537], [8, 96837], [11, 97077], [14, 97237], [19, 97477], [24, 97677], [26, 97817], [29, 97937], [34, 98037], [39, 98257], [48, 99157], [56, 99603], [62, 99683], [65, 99843], [67, 99963], [75, 100343], [82, 100783], [87, 100903]]}, {"verse": 13, "start": 101693, "end": 116060, "text": "Stay this night, and it shall be in the morning, that if he will perform to you the part of a kinsman, well; let him do the kinsman’s part: but if he will not do the part of a kinsman to you, then will I do the part of a kinsman to you, as the LORD lives: lie down until the morning.", "words": [[0, 101693], [5, 101869], [10, 102089], [17, 102349], [21, 102529], [24, 102649], [30, 102769], [33, 102949], [36, 103149], [40, 103249], [49, 103929], [54, 104069], [57, 104189], [60, 104309], [65, 104409], [73, 104749], [76, 104949], [80, 105049], [84, 105149], [89, 105349], [92, 105449], [94, 105529], [103, 105969], [109, 106847], [113, 106985], [117, 107105], [120, 107245], [124, 107345], [134, 107845], [140, 108448], [144, 108579], [147, 108689], [150, 108799], [155, 108919], [159, 109099], [162, 109259], [166, 109359], [171, 109639], [174, 109759], [176, 109879], [184, 110239], [187, 110419], [192, 110979], [197, 111159], [202, 111339], [204, 111479], [207, 111639], [211, 111779], [216, 112019], [219, 112139], [221, 112259], [229, 112619], [232, 112819], [237, 113039], [240, 113459], [244, 113599], [249, 113779], [256, 114660], [260, 114841], [265, 115161], [271, 115481], [275, 115641]]}, {"verse": 14, "start": 116410, "end": 125098, "text": "¶ And she lay at his feet until the morning: and she rose up before one could know another. And he said, Let it not be known that a woman came into the floor.", "words": [[2, 116410], [6, 116525], [10, 116665], [14, 116925], [17, 117065], [21, 117185], [26, 117425], [32, 117685], [36, 117865], [45, 118782], [49, 118922], [53, 119062], [58, 119302], [61, 119642], [68, 119962], [72, 120302], [78, 120502], [83, 120702], [92, 121561], [96, 121920], [99, 122020], [105, 122717], [109, 122855], [112, 122975], [116, 123115], [119, 123275], [125, 123515], [130, 123735], [132, 123855], [138, 124075], [143, 124375], [148, 124555], [152, 124695]]}, {"verse": 15, "start": 125448, "end": 138166, "text": "Also he said, Bring the veil that you have upon you, and hold it. And when she held it, he measured six measures of barley, and laid it on her: and she went into the city.", "words": [[0, 125448], [5, 125868], [8, 125948], [14, 128526], [20, 128703], [24, 128883], [29, 129183], [34, 129423], [38, 129583], [43, 129783], [48, 130123], [53, 130383], [57, 130803], [62, 131103], [66, 132273], [70, 132406], [75, 132566], [79, 132766], [84, 133046], [88, 133346], [91, 133426], [100, 133766], [104, 134106], [113, 134566], [116, 134766], [124, 135166], [128, 135586], [133, 135846], [136, 135986], [139, 136166], [144, 136818], [148, 136923], [152, 137043], [157, 137243], [162, 137483], [166, 137683]]}, {"verse": 16, "start": 138616, "end": 146876, "text": "And when she came to her mother in law, she said, Who are you, my daughter? And she told her all that the man had done to her.", "words": [[0, 138616], [4, 138956], [9, 139116], [13, 139296], [18, 139536], [21, 139736], [25, 139876], [32, 140136], [35, 140356], [40, 140676], [44, 140796], [50, 141923], [54, 142096], [58, 142396], [63, 142936], [66, 143076], [76, 144063], [80, 144178], [84, 144338], [89, 144598], [93, 144798], [97, 