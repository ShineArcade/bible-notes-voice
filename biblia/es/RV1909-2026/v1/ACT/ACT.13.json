{"book": "ACT", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 435820, "verses": [{"verse": 1, "start": 300, "end": 15686, "text": "Había entonces en la iglesia que estaba en Antioquía, profetas y maestros: Bernabé, y Simón el que se llamaba Niger, y Lucio cireneo, y Manaén, que había sido criado con Herodes el tetrarca, y Saulo.", "words": [[0, 300], [6, 656], [15, 1136], [18, 1476], [21, 1676], [29, 2176], [33, 2336], [40, 2696], [43, 2956], [54, 4276], [63, 4976], [65, 5156], [75, 6245], [84, 6911], [86, 7092], [92, 7653], [95, 7766], [99, 7886], [102, 8006], [110, 8466], [117, 9546], [119, 9646], [125, 10186], [134, 10726], [136, 10966], [144, 12046], [148, 12126], [154, 12326], [159, 12646], [166, 13206], [170, 13446], [178, 13846], [181, 14086], [191, 14786], [193, 14946]]}, {"verse": 2, "start": 16036, "end": 25757, "text": "Ministrando pues estos al Señor, y ayunando, dijo el Espíritu Santo: Apartadme a Bernabé y a Saulo para la obra para la cual los he llamado.", "words": [[0, 16036], [12, 16805], [17, 17045], [23, 17345], [26, 17645], [33, 17945], [35, 18245], [45, 19065], [50, 19565], [53, 19725], [62, 20225], [69, 20985], [79, 21747], [81, 21827], [89, 22467], [91, 22747], [93, 22807], [99, 23147], [104, 23367], [107, 23527], [112, 23920], [117, 24062], [120, 24202], [125, 24449], [129, 24695], [132, 24942]]}, {"verse": 3, "start": 26037, "end": 32707, "text": "Entonces habiendo ayunado y orado, y puesto las manos encima de ellos, los despidieron.", "words": [[0, 26037], [9, 26948], [18, 27451], [26, 28191], [28, 28371], [35, 28871], [37, 29471], [44, 29711], [48, 29951], [54, 30231], [61, 30731], [64, 30971], [71, 31671], [75, 31771]]}, {"verse": 4, "start": 33057, "end": 40613, "text": "Y ellos, enviados así por el Espíritu Santo, descendieron a Seleucia; y de allí navegaron a Chipre.", "words": [[0, 33057], [2, 33372], [9, 33672], [18, 34392], [22, 34712], [26, 35012], [29, 35192], [38, 35752], [45, 36112], [58, 37472], [60, 37999], [70, 38723], [72, 38923], [75, 39043], [80, 39223], [90, 39883], [92, 40273]]}, {"verse": 5, "start": 40963, "end": 50601, "text": "Y llegados a Salamina, anunciaban la palabra de Dios en las sinagogas de los judíos: y tenían también a Juan como ayudante.", "words": [[0, 40963], [2, 41067], [11, 41547], [13, 41747], [23, 42827], [34, 43667], [37, 43867], [45, 44247], [48, 44487], [53, 44767], [56, 45147], [60, 45327], [70, 46427], [73, 46627], [77, 46787], [85, 47771], [87, 48193], [94, 48553], [102, 48933], [104, 49213], [109, 49433], [114, 49733]]}, {"verse": 6, "start": 50951, "end": 60482, "text": "Y habiendo atravesado toda la isla hasta Pafos, hallaron un hombre mago, falso profeta, judío, llamado Barjesús;", "words": [[0, 50951], [2, 51079], [11, 51459], [22, 52159], [27, 52459], [30, 52739], [35, 53159], [41, 53849], [48, 54539], [57, 55259], [60, 55559], [67, 55839], [73, 56679], [79, 57419], [88, 58339], [95, 59199], [103, 59877]]}, {"verse": 7, "start": 60832, "end": 70972, "text": "El cual estaba con el procónsul Sergio Paulo, varón prudente. Este, llamando a Bernabé y a Saulo, deseaba oír la palabra de Dios.", "words": [[0, 60832], [3, 61010], [8, 61290], [15, 61850], [19, 62150], [22, 62637], [32, 63123], [39, 63610], [46, 64250], [52, 64750], [62, 65805], [68, 66151], [77, 66691], [79, 66871], [87, 67531], [89, 67731], [91, 67831], [98, 68771], [106, 69311], [110, 69731], [113, 69871], [121, 70231], [124, 70471]]}, {"verse": 8, "start": 71322, "end": 79789, "text": "Pero les resistía Elimas el hechicero (que así se interpreta su nombre), procurando apartar de la fe al procónsul.", "words": [[0, 71322], [5, 71687], [9, 72067], [18, 72837], [25, 73607], [28, 73807], [38, 74747], [43, 74907], [47, 75147], [50, 75307], [61, 75987], [64, 76147], [73, 76967], [84, 77587], [92, 78247], [95, 78347], [98, 78487], [101, 78727], [104, 78927]]}, {"verse": 9, "start": 80139, "end": 86548, "text": "Entonces Saulo, que también es Pablo, lleno del Espíritu Santo, poniendo en él los ojos,", "words": [[0, 80139], [9, 80970], [16, 81710], [20, 81770], [28, 82110], [31, 82350], [38, 83270], [44, 83670], [48, 83810], [57, 84410], [64, 84870], [73, 85350], [76, 85510], [79, 85670], [83, 85870]]}, {"verse": 10, "start": 86898, "end": 96662, "text": "Dijo: Oh, lleno de todo engaño y de toda maldad, hijo del diablo, enemigo de toda justicia, ¿no cesarás de trastornar los caminos rectos del Señor?", "words": [[0, 86898], [6, 87730], [10, 87820], [16, 88140], [19, 88280], [24, 88460], [31, 89060], [33, 89160], [36, 89280], [41, 89480], [49, 90520], [54, 90700], [58, 90880], [66, 91640], [74, 92020], [77, 92160], [82, 92360], [92, 93540], [96, 93660], [104, 94180], [107, 94320], [118, 94960], [122, 95080], [130, 95540], [137, 96040], [141, 96180]]}, {"verse": 11, "start": 97012, "end": 111676, "text": "Ahora pues, he aquí la mano del Señor es contra ti, y serás ciego, que no veas el sol por un tiempo. Y de inmediato cayeron en él oscuridad y tinieblas; y andando alrededor, buscaba quién le condujese por la mano.", "words": [[0, 97012], [6, 97267], [12, 97807], [15, 97887], [20, 98127], [23, 98267], [28, 98507], [32, 98687], [38, 99027], [41, 99307], [48, 99607], [52, 100207], [54, 100447], [60, 100747], [67, 101587], [71, 101647], [74, 101827], [79, 102027], [82, 102227], [86, 102427], [90, 102667], [93, 102787], [101, 103629], [103, 103734], [106, 103854], [116, 104474], [124, 105074], [127, 105214], [130, 105414], [140, 106234], [142, 106414], [153, 107493], [155, 107795], [163, 108255], [174, 108555], [182, 109535], [188, 109835], [191, 110055], [201, 110735], [205, 110995], [208, 111175]]}, {"verse": 12, "start": 112026, "end": 119545, "text": "Entonces el procónsul, viendo lo que había sido hecho, creyó, maravillado de la doctrina del Señor.", "words": [[0, 112026], [9, 113082], [12, 113324], [23, 114184], [30, 114484], [33, 114724], [37, 114864], [43, 115084], [48, 115444], [55, 116364], [62, 117164], [74, 117824], [77, 118024], [80, 118164], [89, 118724], [93, 118964]]}, {"verse": 13, "start": 119895, "end": 130944, "text": "Y partidos de Pafos, Pablo y sus compañeros arribaron a Perge de Panfilia: entonces Juan, apartándose de ellos, se volvió a Jerusalén.", "words": [[0, 119895], [2, 120171], [11, 120711], [14, 120891], [21, 121951], [27, 122691], [29, 122891], [33, 123051], [44, 123851], [54, 124611], [56, 124911], [62, 125211], [65, 125351], [75, 126456], [84, 126954], [90, 127634], [102, 128574], [105, 128754], [112, 129074], [115, 129594], [122, 130134], [124, 130254]]}, {"verse": 14, "start": 131294, "end": 139607, "text": "Y ellos pasando de Perge, llegaron a Antioquía de Pisidia, y entrando en la sinagoga un día de sábado, se sentaron.", "words": [[0, 131294], [2, 131439], [8, 131679], [16, 132079], [19, 132469], [26, 132859], [35, 133739], [37, 134059], [47, 134779], [50, 134919], [59, 135619], [61, 135959], [70, 136479], [73, 136619], [76, 136719], [85, 137279], [88, 137459], [92, 137639], [95, 137779], [103, 138319], [106, 138879]]}, {"verse": 15, "start": 139957, "end": 151903, "text": "Y después de la lectura de la ley y de los profetas, los dirigentes de la sinagoga enviaron a ellos, diciendo: Varones hermanos, si tenéis alguna palabra de exhortación para el pueblo, hablad.", "words": [[0, 139957], [2, 140078], [10, 140338], [13, 140558], [16, 140698], [24, 141218], [27, 141358], [30, 141518], [34, 141798], [36, 141998], [39, 142098], [43, 142218], [53, 143418], [57, 143518], [68, 144158], [71, 144318], [74, 144438], [83, 145038], [92, 145578], [94, 145758], [101, 146138], [111, 147671], [119, 147841], [129, 148421], [132, 148501], [139, 148821], [146, 149121], [154, 149521], [157, 149701], [169, 150321], [174, 150601], [177, 150741], [185, 151351]]}, {"verse": 16, "start": 152183, "end": 161543, "text": "Entonces Pablo, levantándose, hecha señal de silencio con la mano, dice: Varones israelitas, y los que teméis a Dios, oíd:", "words": [[0, 152183], [9, 152623], [16, 153263], [30, 154413], [36, 155563], [42, 156083], [45, 156183], [54, 156843], [58, 157043], [61, 157203], [67, 157543], [73, 158357], [81, 158733], [93, 159533], [95, 159733], [99, 159853], [103, 159993], [110, 160326], [112, 160660], [118, 160993]]}, {"verse": 17, "start": 161893, "end": 172016, "text": "El Dios del pueblo de Israel escogió a nuestros padres, y enalteció al pueblo, siendo ellos extranjeros en la tierra de Egipto, y con brazo levantado los sacó de ella.", "words": [[0, 161893], [3, 162013], [8, 162213], [12, 162413], [19, 162733], [22, 162953], [29, 163373], [37, 164073], [39, 164173], [48, 164353], [56, 164913], [58, 165473], [68, 166013], [71, 166173], [79, 166993], [86, 167293], [92, 167573], [104, 168393], [107, 168513], [110, 168613], [117, 168853], [120, 169073], [128, 169553], [130, 169873], [134, 170013], [140, 170353], [150, 170723], [154, 171093], [159, 171473], [162, 171613]]}, {"verse": 18, "start": 172366, "end": 176319, "text": "Y por tiempo como de cuarenta años soportó sus costumbres en el desierto;", "words": [[0, 172366], [2, 172474], [6, 172614], [13, 172854], [18, 173174], [21, 173444], [30, 173714], [35, 174094], [43, 174674], [47, 174814], [58, 175374], [61, 175514], [64, 175614]]}, {"verse": 19, "start": 176669, "end": 181880, "text": "Y destruyendo siete naciones en la tierra de Canaán, les repartió por suerte la tierra de ellas.", "words": [[0, 176669], [2, 176737], [14, 177147], [20, 177557], [29, 178117], [32, 178297], [35, 178397], [42, 178617], [45, 179047], [53, 179477], [57, 179797], [66, 180297], [70, 180437], [77, 180797], [80, 180937], [87, 181197], [90, 181397]]}, {"verse": 20, "start": 182230, "end": 187451, "text": "Y después, como por cuatrocientos cincuenta años, les dio jueces hasta el profeta Samuel.", "words": [[0, 182230], [2, 182331], [11, 182911], [16, 183071], [20, 183358], [34, 183644], [44, 183931], [50, 185291], [54, 185471], [58, 185691], [65, 186091], [71, 186351], [74, 186471], [82, 186871]]}, {"verse": 21, "start": 187801, "end": 195253, "text": "Y entonces pidieron rey; y les dio Dios a Saúl, hijo de Cis, varón de la tribu de Benjamín, por cuarenta años.", "words": [[0, 187801], [2, 187920], [11, 188280], [20, 188840], [25, 189486], [27, 189608], [31, 189808], [35, 190088], [40, 190328], [42, 190608], [48, 191148], [53, 191308], [56, 191488], [61, 192148], [67, 192568], [70, 192668], [73, 192768], [79, 193148], [82, 193268], [92, 194108], [96, 194228], [105, 194788]]}, {"verse": 22, "start": 195603, "end": 208472, "text": "Y quitado aquel, les levantó por rey a David, al que dio también testimonio, diciendo: He hallado a David, hijo de Isaí, varón conforme a mi corazón, el cual hará todo lo que yo quiero.", "words": [[0, 195603], [2, 195704], [10, 196104], [17, 196524], [21, 196684], [29, 197184], [33, 197337], [37, 197491], [39, 197644], [46, 198104], [49, 198424], [53, 198524], [57, 198704], [65, 199024], [77, 200062], [87, 200911], [90, 201049], [98, 201489], [100, 201629], [107, 202249], [112, 202549], [115, 202709], [121, 203489], [127, 203909], [136, 204529], [138, 204609], [141, 204689], [150, 205629], [153, 205809], [158, 206109], [163, 206549], [168, 206769], [171, 207029], [175, 207169], [178, 207329]]}, {"verse": 23, "start": 208692, "end": 214810, "text": "De la descendencia de este, Dios, conforme a la promesa, levantó a Jesús por Salvador a Israel;", "words": [[0, 208692], [3, 208819], [6, 208919], [19, 209639], [22, 209779], [28, 210299], [34, 210959], [43, 211459], [45, 211539], [48, 211579], [57, 212539], [65, 213019], [67, 213099], [73, 213319], [77, 213659], [86, 214039], [88, 214259]]}, {"verse": 24, "start": 215160, "end": 220246, "text": "Predicando Juan antes de su llegada el bautismo de arrepentimiento a todo el pueblo de Israel.", "words": [[0, 215160], [11, 215646], [16, 215966], [22, 216366], [25, 216526], [28, 216646], [36, 216936], [39, 217226], [48, 217766], [51, 217926], [67, 218726], [69, 218886], [74, 219026], [77, 219186], [84, 219466], [87, 219606]]}, {"verse": 25, "start": 220596, "end": 229748, "text": "Pero como Juan cumpliese su carrera, dijo: ¿Quién pensáis que soy? No soy yo él; pero he aquí, viene tras mí uno, cuyo calzado de los pies no soy digno de desatar.", "words": [[0, 220596], [5, 220712], [10, 220912], [15, 221312], [25, 221712], [28, 221892], [37, 222392], [43, 223016], [50, 223200], [58, 223540], [62, 223720], [67, 224353], [70, 224473], [74, 224673], [77, 224833], [81, 225350], [86, 225486], [89, 225646], [95, 226146], [101, 226326], [106, 226526], [109, 226746], [114, 226966], [119, 227306], [127, 227786], [130, 227866], [134, 228006], [139, 228266], [142, 228526], [146, 228726], [152, 229106], [155, 229146]]}, {"verse": 26, "start": 230098, "end": 238602, "text": "Varones hermanos, hijos del linaje de Abraham, y los que entre vosotros temen a Dios, a vosotros es enviada la palabra de esta salvación.", "words": [[0, 230098], [8, 230521], [18, 231281], [24, 231401], [28, 231681], [35, 232101], [38, 232241], [47, 233301], [49, 233361], [53, 233501], [57, 233661], [63, 233901], [72, 234421], [78, 234821], [80, 234921], [86, 235701], [88, 235801], [97, 236221], [100, 236401], [108, 236841], [111, 237021], [119, 237401], [122, 237601], [127, 237821]]}, {"verse": 27, "start": 238952, "end": 248414, "text": "Porque los que habitaban en Jerusalén, y sus príncipes, no conociendo a este, y las voces de los profetas que se leen todos los sábados, condenándolo, las cumplieron.", "words": [[0, 238952], [7, 239156], [11, 239336], [15, 239496], [25, 239996], [28, 240116], [39, 240736], [41, 240836], [45, 241016], [56, 241836], [59, 241936], [70, 242416], [72, 242636], [78, 242976], [80, 243356], [84, 243516], [90, 243876], [93, 244016], [97, 244116], [106, 244696], [110, 244916], [113, 245056], [118, 245376], [124, 245576], [128, 245836], [137, 246756], [151, 247616], [155, 247676]]}, {"verse": 28, "start": 248764, "end": 253123, "text": "Y sin hallar en él causa de muerte, pidieron a Pilato que le matasen.", "words": [[0, 248764], [2, 248893], [6, 249133], [13, 249453], [16, 249573], [19, 249713], [25, 249973], [28, 250233], [36, 251153], [45, 251633], [47, 251733], [54, 252133], [58, 252273], [61, 252393]]}, {"verse": 29, "start": 253473, "end": 260181, "text": "Y habiendo cumplido todas las cosas que de él estaban escritas, quitándolo del madero, lo pusieron en el sepulcro.", "words": [[0, 253473], [2, 253574], [11, 253874], [20, 254434], [26, 254614], [30, 254894], [36, 255234], [40, 255494], [43, 255614], [46, 255814], [54, 256114], [64, 257154], [75, 257654], [79, 257814], [87, 258694], [90, 258854], [99, 259274], [102, 259594], [105, 259914]]}, {"verse": 30, "start": 260531, "end": 262565, "text": "Pero Dios le levantó de los muertos.", "words": [[0, 260531], [5, 260668], [10, 260908], [13, 261168], [21, 261648], [24, 261728], [28, 261848]]}, {"verse": 31, "start": 262915, "end": 270455, "text": "Y él fue visto por muchos días de los que habían subido juntamente con él de Galilea a Jerusalén, los cuales son sus testigos al pueblo.", "words": [[0, 262915], [2, 263052], [5, 263152], [9, 263312], [15, 263552], [19, 263792], [26, 264052], [31, 264432], [34, 264672], [38, 264812], [42, 264992], [49, 265232], [56, 265672], [67, 266212], [71, 266452], [74, 266592], [77, 266712], [85, 267002], [87, 267292], [98, 268352], [102, 268452], [109, 268752], [113, 269032], [117, 269252], [126, 269732], [129, 269912]]}, {"verse": 32, "start": 270805, "end": 275377, "text": "Y nosotros también os anunciamos el evangelio de aquella promesa que fue hecha a los padres,", "words": [[0, 270805], [2, 270908], [11, 271148], [19, 271418], [22, 271688], [33, 272228], [36, 272468], [46, 273048], [49, 273148], [57, 273428], [65, 273908], [69, 274068], [73, 274268], [79, 274548], [81, 274628], [85, 274728]]}, {"verse": 33, "start": 275727, "end": 285593, "text": "La cual Dios ha cumplido a los hijos de ellos, a nosotros, resucitando a Jesús: como también en el salmo segundo está escrito: Mi hijo eres tú, yo te he engendrado hoy.", "words": [[0, 275727], [3, 275854], [8, 276054], [13, 276374], [16, 276734], [25, 277214], [27, 277314], [31, 277434], [37, 277674], [40, 277894], [47, 278374], [49, 278453], [59, 279414], [71, 279874], [73, 279974], [80, 280594], [85, 280757], [93, 281157], [96, 281317], [99, 281437], [105, 281757], [113, 282117], [118, 282377], [127, 283216], [130, 283379], [135, 283579], [140, 283799], [144, 284379], [147, 284479], [150, 284659], [153, 284739], [164, 285239]]}, {"verse": 34, "start": 285943, "end": 292663, "text": "Y que le levantó de los muertos para nunca más volver a corrupción, así lo dijo: Os daré las misericordias fieles de David.", "words": [[0, 285943], [2, 286051], [6, 286151], [9, 286251], [17, 286731], [20, 286791], [24, 286931], [32, 287331], [37, 287591], [43, 287831], [47, 288171], [54, 288351], [56, 288531], [68, 289311], [72, 289491], [75, 289651], [81, 290286], [84, 290403], [89, 290743], [93, 290843], [107, 291563], [114, 292063], [117, 292163]]}, {"verse": 35, "start": 293013, "end": 297430, "text": "Por eso dice también en otro lugar: No permitirás que tu Santo vea corrupción.", "words": [[0, 293013], [4, 293137], [8, 293337], [13, 293577], [21, 293877], [24, 294117], [29, 294277], [36, 295061], [39, 295185], [50, 295805], [54, 295905], [57, 296025], [63, 296365], [67, 296705]]}, {"verse": 36, "start": 297780, "end": 305329, "text": "Porque a la verdad David, habiendo servido en su generación a la voluntad de Dios, durmió, y fue reunido con sus padres, y vio corrupción:", "words": [[0, 297780], [7, 297988], [9, 298128], [12, 298188], [19, 298628], [26, 299108], [35, 299408], [43, 299848], [46, 299948], [49, 300068], [60, 300668], [62, 300808], [65, 300848], [74, 301328], [77, 301428], [83, 302048], [91, 302608], [93, 302868], [97, 303028], [105, 303468], [109, 303608], [113, 303808], [121, 304128], [123, 304468], [127, 304648]]}, {"verse": 37, "start": 305679, "end": 308107, "text": "Pero aquel que Dios levantó, no vio corrupción.", "words": [[0, 305679], [5, 305816], [11, 306096], [15, 306176], [20, 306336], [29, 306936], [32, 307216], [36, 307396]]}, {"verse": 38, "start": 308457, "end": 314317, "text": "Os sea pues notorio, varones hermanos, que por este os es anunciado el perdón de pecados;", "words": [[0, 308486], [3, 308556], [7, 308916], [12, 309036], [21, 309666], [29, 310296], [39, 311096], [43, 311336], [47, 311536], [52, 311796], [55, 312056], [58, 312316], [68, 312976], [71, 313096], [78, 313516], [81, 313616]]}, {"verse": 39, "start": 314667, "end": 321688, "text": "Y de todo lo que por la ley de Moisés no pudisteis ser justificados, en este es justificado todo aquel que cree.", "words": [[0, 314667], [2, 314791], [5, 314911], [10, 315211], [13, 315431], [17, 315571], [21, 315791], [24, 315911], [28, 316111], [31, 316251], [38, 316631], [41, 316951], [51, 317651], [55, 317791], [69, 319131], [72, 319331], [77, 319571], [80, 319771], [92, 320531], [97, 320731], [103, 321151], [107, 321251]]}, {"verse": 40, "start": 322038, "end": 326182, "text": "Mirad, pues, que no venga sobre vosotros lo que está dicho en los profetas;", "words": [[0, 322038], [7, 322396], [13, 322596], [17, 323156], [20, 323296], [26, 323616], [32, 323836], [41, 324396], [44, 324576], [48, 324696], [53, 324876], [59, 325156], [62, 325296], [66, 325396]]}, {"verse": 41, "start": 326532, "end": 335171, "text": "Mirad, oh menospreciadores, y asombraos y pereced; porque yo hago una obra en vuestros días, obra que no creeréis, si alguien os la cuenta.", "words": [[0, 326532], [7, 327013], [10, 327533], [28, 328053], [30, 328573], [40, 329293], [42, 329513], [51, 330409], [58, 330609], [61, 330809], [66, 330989], [70, 331249], [75, 331529], [78, 331689], [87, 332049], [93, 332689], [98, 332889], [102, 333069], [105, 333189], [115, 333749], [118, 334089], [126, 334299], [129, 334509], [132, 334629]]}, {"verse": 42, "start": 335451, "end": 344512, "text": "Y saliendo ellos de la sinagoga de los judíos, los Gentiles les rogaron que el sábado siguiente les hablasen estas palabras.", "words": [[0, 335451], [2, 335573], [11, 336093], [17, 336453], [20, 336693], [23, 336833], [32, 337493], [35, 337693], [39, 337813], [47, 338873], [51, 339053], [60, 339673], [64, 340373], [72, 341073], [76, 341333], [79, 341513], [86, 341933], [96, 342253], [100, 342783], [109, 343313], [115, 343553]]}, {"verse": 43, "start": 344862, "end": 360287, "text": "Y despedida la congregación, muchos de los judíos y de los convertidos devotos al judaísmo siguieron a Pablo y a Bernabé; los cuales hablándoles, les persuadían que permaneciesen en la gracia de Dios.", "words": [[0, 344862], [2, 344996], [12, 345856], [15, 345936], [29, 347476], [36, 347956], [39, 348176], [43, 348316], [50, 348976], [52, 349156], [55, 349236], [59, 349376], [71, 350036], [79, 350696], [82, 350836], [91, 351656], [101, 352556], [103, 352796], [109, 353236], [111, 353556], [113, 353636], [122, 354543], [126, 354689], [133, 355029], [146, 356009], [150, 356529], [161, 357329], [165, 357549], [179, 358889], [182, 359009], [185, 359149], [192, 359549], [195, 359689]]}, {"verse": 44, "start": 360637, "end": 365932, "text": "Y el sábado siguiente se juntó casi toda la ciudad a oír la palabra de Dios.", "words": [[0, 360637], [2, 360760], [5, 360880], [12, 361320], [22, 361780], [25, 362120], [31, 362640], [36, 362840], [41, 363300], [44, 363540], [51, 363880], [53, 364280], [57, 364620], [60, 364780], [68, 365140], [71, 365400]]}, {"verse": 45, "start": 366282, "end": 374798, "text": "Pero los judíos, al ver la multitud, se llenaron de celo, y se oponían a lo que Pablo decía, contradiciendo y blasfemando.", "words": [[0, 366282], [5, 366427], [9, 366607], [17, 367107], [20, 367307], [24, 367487], [27, 367627], [37, 368267], [40, 368887], [49, 369627], [52, 369887], [58, 370567], [60, 370727], [63, 370847], [71, 371447], [73, 371687], [76, 371787], [80, 371887], [86, 372207], [93, 372927], [108, 373787], [110, 373907]]}, {"verse": 46, "start": 375148, "end": 390661, "text": "Entonces Pablo y Bernabé, hablando con franqueza, dijeron: A vosotros a la verdad era necesario que se os hablase la palabra de Dios; pero pues que la desecháis, y os juzgáis indignos de la vida eterna, he aquí, nos volvemos a los Gentiles.", "words": [[0, 375148], [9, 375798], [15, 376578], [17, 376818], [26, 377538], [35, 377938], [39, 378488], [50, 379038], [59, 380014], [61, 380138], [70, 380738], [72, 380858], [75, 380938], [82, 381458], [86, 381638], [96, 382258], [100, 382458], [103, 382598], [106, 382758], [114, 383118], [117, 383238], [125, 383518], [128, 383718], [134, 384418], [139, 384577], [144, 384837], [148, 384977], [151, 385097], [162, 385737], [164, 386017], [167, 386157], [175, 386557], [184, 387197], [187, 387297], [190, 387397], [195, 387577], [203, 388097], [206, 388617], [212, 388937], [216, 389237], [225, 389757], [227, 389857], [231, 389957]]}, {"verse": 47, "start": 391011, "end": 398647, "text": "Porque así nos ha mandado el Señor, diciendo: Te he puesto para luz de los Gentiles, para que seas salvación hasta lo último de la tierra.", "words": [[0, 391011], [7, 391148], [11, 391388], [15, 391548], [18, 391688], [26, 392088], [29, 392188], [36, 392488], [46, 393625], [49, 393759], [52, 393859], [59, 394119], [64, 394499], [68, 394699], [71, 394879], [75, 394999], [85, 395579], [90, 395874], [94, 396084], [99, 396294], [109, 396994], [115, 397354], [118, 397534], [125, 397834], [128, 398054], [131, 398154]]}, {"verse": 48, "start": 398927, "end": 408181, "text": "Y los Gentiles oyendo esto, fueron gozosos, y glorificaban la palabra del Señor: y creyeron todos los que estaban ordenados para vida eterna.", "words": [[0, 398927], [2, 399052], [6, 399192], [15, 399792], [22, 400352], [28, 400652], [35, 401272], [44, 402032], [46, 402212], [59, 403032], [62, 403192], [70, 403552], [74, 403812], [81, 404578], [83, 404686], [92, 405226], [98, 405506], [102, 405786], [106, 405946], [114, 406246], [124, 406866], [129, 407126], [134, 407346]]}, {"verse": 49, "start": 408531, "end": 412478, "text": "Y la palabra del Señor era sembrada por toda aquella provincia.", "words": [[0, 408531], [2, 408780], [5, 408900], [13, 409160], [17, 409440], [23, 409700], [27, 410000], [36, 410640], [40, 410860], [45, 411120], [53, 411580]]}, {"verse": 50, "start": 412828, "end": 425314, "text": "Pero los judíos incitaron a mujeres devotas y de posición distinguida, y a los principales de la ciudad, y levantaron persecución contra Pablo y Bernabé, y los echaron de su territorio.", "words": [[0, 412828], [5, 413011], [9, 413191], [16, 413671], [26, 414411], [28, 414451], [36, 415021], [44, 415591], [46, 415676], [49, 415816], [58, 416236], [71, 417356], [73, 417916], [75, 417996], [79, 418116], [91, 418916], [94, 419076], [97, 419176], [105, 419576], [107, 419911], [118, 420551], [130, 421391], [137, 421771], [143, 422231], [145, 422391], [154, 423288], [156, 423555], [160, 423821], [168, 424088], [171, 424268], [174, 424428]]}, {"verse": 51, "start": 425664, "end": 430947, "text": "Ellos entonces sacudiendo en ellos el polvo de sus pies, vinieron a Iconio.", "words": [[0, 425664], [6, 426052], [15, 426472], [26, 427512], [29, 427692], [35, 427932], [38, 428172], [44, 428712], [47, 428832], [51, 429012], [57, 429372], [66, 430047], [68, 430227]]}, {"verse": 52, "start": 431297, "end": 435420, "text": "Y los discípulos estaban llenos de gozo, y del Espíritu Santo.", "words": [[0, 431297], [2, 431384], [6, 431504], [17, 432124], [25, 432484], [32, 433024], [35, 433144], [41, 433604], [43, 434024], [47, 434164], [56, 434724]]}]}