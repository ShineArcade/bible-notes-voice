{"book": "MRK", "chapter": 4, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 293915, "verses": [{"verse": 1, "start": 300, "end": 12334, "text": "And he began again to teach by the sea side: and there was gathered to him a great multitude, so that he entered into a ship, and sat in the sea; and the whole multitude was by the sea on the land.", "words": [[0, 300], [4, 422], [7, 522], [13, 842], [19, 1122], [22, 1322], [28, 1582], [31, 1822], [35, 2118], [39, 2413], [45, 2975], [49, 3135], [55, 3235], [59, 3375], [68, 3715], [71, 3935], [75, 4115], [77, 4215], [83, 4455], [94, 5235], [97, 5455], [102, 5635], [105, 5735], [113, 6055], [118, 6285], [120, 6515], [126, 6775], [130, 7255], [134, 7555], [137, 7755], [141, 7895], [146, 9322], [150, 9480], [154, 9600], [160, 9820], [170, 10420], [174, 10780], [177, 11000], [181, 11160], [185, 11440], [188, 11640], [192, 11760]]}, {"verse": 2, "start": 12784, "end": 17034, "text": "And he taught them many things by parables, and said to them in his doctrine,", "words": [[0, 12784], [4, 12941], [7, 13041], [14, 13281], [19, 13481], [24, 13761], [31, 14081], [34, 14341], [44, 14981], [48, 15341], [53, 15701], [56, 15901], [61, 16061], [64, 16201], [68, 16341]]}, {"verse": 3, "start": 17284, "end": 20730, "text": "Hearken; Behold, there went out a sower to sow:", "words": [[0, 17575], [9, 18147], [17, 19071], [23, 19151], [28, 19351], [32, 19631], [34, 19791], [40, 20131], [43, 20271]]}, {"verse": 4, "start": 21180, "end": 27580, "text": "And it came to pass, as he sowed, some fell by the way side, and the fowls of the air came and devoured it up.", "words": [[0, 21180], [4, 21283], [7, 21383], [12, 21583], [15, 21763], [21, 22343], [24, 22543], [27, 22663], [34, 23363], [39, 23583], [44, 23883], [47, 24123], [51, 24443], [55, 24763], [61, 25083], [65, 25223], [69, 25343], [75, 25743], [78, 25863], [82, 25983], [86, 26163], [91, 26443], [95, 26703], [104, 27123], [107, 27243]]}, {"verse": 5, "start": 28030, "end": 35422, "text": "And some fell on stony ground, where it had not much earth; and immediately it sprang up, because it had no depth of earth:", "words": [[0, 28030], [4, 28187], [9, 28467], [14, 28807], [17, 29087], [23, 29507], [31, 29887], [37, 30427], [40, 30567], [44, 30707], [48, 30927], [53, 31207], [60, 31967], [64, 32103], [76, 32463], [79, 32823], [86, 33223], [90, 33443], [98, 33903], [101, 34123], [105, 34263], [108, 34463], [114, 34763], [117, 34963]]}, {"verse": 6, "start": 35872, "end": 40948, "text": "But when the sun was up, it was scorched; and because it had no root, it withered away.", "words": [[0, 35872], [4, 36011], [9, 36171], [13, 36291], [17, 36531], [21, 36751], [25, 37211], [28, 37291], [32, 37431], [42, 38392], [46, 38509], [54, 38749], [57, 38949], [61, 39109], [64, 39309], [70, 39989], [73, 40109], [82, 40449]]}, {"verse": 7, "start": 41398, "end": 46715, "text": "And some fell among thorns, and the thorns grew up, and choked it, and it yielded no fruit.", "words": [[0, 41398], [4, 41543], [9, 41803], [14, 42143], [20, 42463], [28, 43323], [32, 43483], [36, 43603], [43, 43903], [48, 44163], [52, 44423], [56, 44683], [63, 45043], [67, 45423], [71, 45563], [74, 45663], [82, 46043], [85, 46243]]}, {"verse": 8, "start": 47165, "end": 55583, "text": "And other fell on good ground, and did yield fruit that sprang up and increased; and brought forth, some thirty, and some sixty, and some a hundred.", "words": [[0, 47165], [4, 47301], [10, 47561], [15, 47901], [18, 48121], [23, 48301], [31, 48661], [35, 49281], [39, 49441], [45, 49681], [51, 50001], [56, 50241], [63, 50661], [66, 50861], [70, 51021], [81, 51998], [85, 52245], [93, 52425], [100, 52845], [105, 53245], [113, 53645], [117, 53985], [122, 54275], [129, 54565], [133, 54825], [138, 55085], [140, 55345]]}, {"verse": 9, "start": 55933, "end": 59729, "text": "And he said to them, He that has ears to hear, let him hear.", "words": [[0, 55933], [4, 56064], [7, 56184], [12, 56424], [15, 56624], [21, 57219], [24, 57350], [29, 57590], [33, 57790], [38, 58090], [41, 58330], [47, 58950], [51, 59110], [55, 59310]]}, {"verse": 10, "start": 60079, "end": 65134, "text": "And when he was alone, they that were about him with the twelve asked of him the parable.", "words": [[0, 60079], [4, 60225], [9, 60365], [12, 60525], [16, 60725], [23, 61665], [28, 61965], [33, 62165], [38, 62345], [44, 62665], [48, 62885], [53, 63085], [57, 63205], [64, 63505], [70, 64045], [73, 64245], [77, 64385], [81, 64525]]}, {"verse": 11, "start": 65584, "end": 74098, "text": "And he said to them, To you it is given to know the mystery of the kingdom of God: but to them that are without, all these things are done in parables:", "words": [[0, 65584], [4, 65722], [7, 65822], [12, 66042], [15, 66222], [21, 66873], [24, 67011], [28, 67231], [31, 67391], [34, 67511], [40, 67751], [43, 67951], [48, 68131], [52, 68291], [60, 68671], [63, 68891], [67, 69011], [75, 69331], [78, 69571], [83, 70421], [87, 70561], [90, 70721], [95, 70961], [100, 71201], [104, 71321], [113, 72101], [117, 72341], [123, 72501], [130, 72801], [134, 72981], [139, 73181], [142, 73301]]}, {"verse": 12, "start": 74548, "end": 84476, "text": "That seeing they may see, and not perceive; and hearing they may hear, and not understand; lest at any time they should be converted, and their sins should be forgiven them.", "words": [[0, 74548], [5, 74710], [12, 75030], [17, 75310], [21, 75470], [26, 75910], [30, 76290], [34, 76510], [44, 77580], [48, 77725], [56, 78045], [61, 78325], [65, 78465], [71, 78865], [75, 79145], [79, 79345], [91, 80447], [96, 80693], [99, 80833], [103, 81033], [108, 81433], [113, 81613], [120, 81773], [123, 81913], [134, 82593], [138, 82793], [144, 82953], [149, 83313], [156, 83553], [159, 83713], [168, 84053]]}, {"verse": 13, "start": 84826, "end": 89940, "text": "And he said to them, Do you not know this parable? and how then will you know all parables?", "words": [[0, 84826], [4, 84957], [7, 85077], [12, 85317], [15, 85517], [21, 86112], [24, 86212], [28, 86292], [32, 86452], [37, 86672], [42, 86852], [51, 87778], [55, 87874], [59, 88094], [64, 88354], [69, 88594], [73, 88754], [78, 88954], [82, 89214]]}, {"verse": 14, "start": 90390, "end": 91766, "text": "¶ The sower sows the word.", "words": [[2, 90390], [6, 90489], [12, 90829], [17, 91169], [21, 91329]]}, {"verse": 15, "start": 92216, "end": 101314, "text": "And these are they by the way side, where the word is sown; but when they have heard, Satan comes immediately, and takes away the word that was sown in their hearts.", "words": [[0, 92216], [4, 92340], [10, 92580], [14, 92780], [19, 92960], [22, 93140], [26, 93447], [30, 93753], [36, 94060], [42, 94280], [46, 94420], [51, 94640], [54, 94820], [60, 95642], [64, 95745], [69, 95905], [74, 96085], [79, 96205], [86, 96825], [92, 97205], [98, 97625], [111, 98185], [115, 98765], [121, 99045], [126, 99305], [130, 99505], [135, 99765], [140, 100005], [144, 100165], [149, 100485], [152, 100605], [158, 100745]]}, {"verse": 16, "start": 101764, "end": 109373, "text": "And these are they likewise which are sown on stony ground; who, when they have heard the word, immediately receive it with gladness;", "words": [[0, 101764], [4, 102084], [10, 102304], [14, 102504], [19, 102684], [28, 103444], [34, 103564], [38, 103774], [43, 103984], [46, 104184], [52, 104564], [60, 105479], [65, 105616], [70, 105776], [75, 105976], [80, 106156], [86, 106396], [90, 106556], [96, 106856], [108, 107596], [116, 108316], [119, 108476], [124, 108656]]}, {"verse": 17, "start": 109823, "end": 119627, "text": "And have no root in themselves, and so endure but for a time: afterward, when affliction or persecution arises for the word’s sake, immediately they are offended.", "words": [[0, 109823], [4, 109964], [9, 110124], [12, 110344], [17, 110644], [20, 110864], [32, 111744], [36, 111924], [39, 112124], [46, 112524], [50, 112864], [54, 113124], [56, 113224], [62, 114037], [73, 114697], [78, 114797], [89, 115297], [92, 115477], [104, 115977], [111, 116597], [115, 116897], [119, 116977], [126, 117437], [132, 117997], [144, 118437], [149, 118877], [153, 119017]]}, {"verse": 18, "start": 120077, "end": 124232, "text": "And these are they which are sown among thorns; such as hear the word,", "words": [[0, 120077], [4, 120214], [10, 120494], [14, 120794], [19, 121074], [25, 121334], [29, 121474], [34, 121874], [40, 122074], [48, 123065], [53, 123283], [56, 123463], [61, 123663], [65, 123823]]}, {"verse": 19, "start": 124682, "end": 133472, "text": "And the cares of this world, and the deceitfulness of riches, and the lusts of other things entering in, choke the word, and it becomes unfruitful.", "words": [[0, 124682], [4, 124801], [8, 124902], [14, 125242], [17, 125482], [22, 125682], [29, 126361], [33, 126721], [37, 126822], [51, 127382], [54, 127682], [62, 128422], [66, 128582], [70, 128702], [76, 129142], [79, 129242], [85, 129422], [92, 129721], [101, 130142], [105, 130782], [111, 131082], [115, 131302], [121, 132041], [125, 132182], [128, 132282], [136, 132642]]}, {"verse": 20, "start": 133922, "end": 143744, "text": "And these are they which are sown on good ground; such as hear the word, and receive it, and bring forth fruit, some thirtyfold, some sixty, and some a hundred.", "words": [[0, 133922], [4, 134063], [10, 134343], [14, 134583], [19, 134863], [25, 135143], [29, 135303], [34, 135683], [37, 135823], [42, 136043], [50, 136979], [55, 137160], [58, 137380], [63, 137600], [67, 137760], [73, 138480], [77, 138560], [85, 138880], [89, 139360], [93, 139440], [99, 139660], [105, 139920], [112, 140780], [117, 140980], [129, 141920], [134, 142100], [141, 142860], [145, 142940], [150, 143140], [152, 143300]]}, {"verse": 21, "start": 144094, "end": 151636, "text": "¶ And he said to them, Is a lamp brought to be put under a basket, or under a bed? and not to be set on a lampstand?", "words": [[2, 144094], [6, 144224], [9, 144344], [14, 144584], [17, 144784], [23, 145380], [26, 145526], [28, 145666], [33, 145926], [41, 146246], [44, 146506], [47, 146646], [51, 146866], [57, 147206], [59, 147366], [67, 147786], [70, 148306], [76, 148626], [78, 148786], [83, 149571], [87, 149728], [91, 149928], [94, 150148], [97, 150248], [101, 150508], [104, 150708], [106, 151198]]}, {"verse": 22, "start": 152086, "end": 159428, "text": "For there is nothing hid, which shall not be manifested; neither was any thing kept secret, but that it should come abroad.", "words": [[0, 152086], [4, 152173], [10, 152333], [13, 152473], [21, 152793], [26, 153173], [32, 153613], [38, 153853], [42, 154093], [45, 154273], [57, 155421], [65, 155795], [69, 156048], [73, 156302], [79, 156555], [84, 156995], [92, 157775], [96, 158015], [101, 158175], [104, 158315], [111, 158475], [116, 158755]]}, {"verse": 23, "start": 159878, "end": 162641, "text": "If any man have ears to hear, let him hear.", "words": [[0, 159878], [3, 160019], [7, 160219], [11, 160479], [16, 160699], [21, 160959], [24, 161179], [30, 161699], [34, 161959], [38, 162159]]}, {"verse": 24, "start": 162991, "end": 171765, "text": "And he said to them, Take heed what you hear: with what measure you measure, it shall be measured to you: and to you that hear shall more be given.", "words": [[0, 162991], [4, 163122], [7, 163242], [12, 163482], [15, 163682], [21, 164277], [26, 164437], [31, 164777], [36, 165017], [40, 165197], [46, 165965], [51, 166081], [56, 166261], [64, 166641], [68, 166881], [77, 167641], [80, 167721], [86, 167921], [89, 168081], [98, 168401], [101, 168661], [106, 169352], [110, 169494], [113, 169654], [117, 169874], [122, 170154], [127, 170434], [133, 170754], [138, 171054], [141, 171234]]}, {"verse": 25, "start": 172215, "end": 179419, "text": "For he that has, to him shall be given: and he that has not, from him shall be taken even that which he has.", "words": [[0, 172215], [4, 172319], [7, 172539], [12, 172719], [17, 173079], [20, 173539], [24, 173819], [30, 174119], [33, 174279], [40, 175085], [44, 175249], [47, 175469], [52, 175689], [56, 175909], [61, 176209], [66, 176769], [70, 177049], [76, 177409], [79, 177569], [85, 177869], [90, 178229], [95, 178549], [101, 178809], [104, 178989]]}, {"verse": 26, "start": 179769, "end": 185998, "text": "¶ And he said, So is the kingdom of God, as if a man should cast seed into the ground;", "words": [[2, 179769], [6, 179904], [9, 180044], [15, 181503], [18, 181705], [21, 181905], [25, 182045], [33, 182305], [36, 182545], [41, 183345], [44, 183545], [47, 183705], [49, 183805], [53, 184105], [60, 184305], [65, 184645], [70, 185065], [75, 185325], [79, 185465]]}, {"verse": 27, "start": 186448, "end": 192711, "text": "And should sleep, and rise night and day, and the seed should spring and grow up, he knows not how.", "words": [[0, 186448], [4, 186592], [11, 186812], [18, 187252], [22, 187552], [27, 187932], [33, 188292], [37, 188572], [42, 189212], [46, 189512], [50, 189632], [55, 189872], [62, 190132], [69, 190552], [73, 190852], [78, 191092], [82, 191632], [85, 191772], [91, 191972], [95, 192252]]}, {"verse": 28, "start": 193161, "end": 199672, "text": "For the earth brings forth fruit of herself; first the blade, then the ear, after that the full grain in the ear.", "words": [[0, 193161], [4, 193245], [8, 193385], [14, 193625], [21, 193905], [27, 194245], [33, 194585], [36, 194725], [45, 195536], [51, 195788], [55, 196048], [62, 196408], [67, 196708], [71, 196888], [76, 197608], [82, 197888], [87, 198168], [91, 198368], [96, 198628], [102, 198948], [105, 199148], [109, 199248]]}, {"verse": 29, "start": 200122, "end": 205114, "text": "But when the fruit is brought forth, immediately he puts in the sickle, because the harvest is come.", "words": [[0, 200122], [4, 200223], [9, 200343], [13, 200483], [19, 200683], [22, 200843], [30, 201043], [37, 201623], [49, 202043], [52, 202543], [57, 202743], [60, 202943], [64, 203063], [72, 203483], [80, 203863], [84, 204063], [92, 204353], [95, 204643]]}, {"verse": 30, "start": 205464, "end": 212450, "text": "¶ And he said, To what shall we liken the kingdom of God? or with what comparison shall we compare it?", "words": [[2, 205464], [6, 205599], [9, 205739], [15, 207197], [18, 207316], [23, 207496], [29, 207736], [32, 207916], [38, 208256], [42, 208496], [50, 208796], [53, 209056], [58, 209947], [61, 210107], [66, 210347], [71, 210527], [82, 211187], [88, 211527], [91, 211707], [99, 212087]]}, {"verse": 31, "start": 212900, "end": 218850, "text": "It is like a grain of mustard seed, which, when it is sown in the earth, is less than all the seeds that be in the earth:", "words": [[0, 212900], [3, 212987], [6, 213107], [11, 213247], [13, 213367], [19, 213627], [22, 213767], [30, 214127], [36, 214907], [43, 215387], [48, 215487], [51, 215607], [54, 215747], [59, 216007], [62, 216147], [66, 216247], [73, 216687], [76, 216847], [81, 217027], [86, 217247], [90, 217467], [94, 217607], [100, 217927], [105, 218147], [108, 218347], [111, 218487], [115, 218607]]}, {"verse": 32, "start": 219300, "end": 228665, "text": "But when it is sown, it grows up, and becomes greater than all herbs, and shoots out great branches; so that the fowls of the air may lodge under the shadow of it.", "words": [[0, 219300], [4, 219422], [9, 219582], [12, 219722], [15, 219862], [21, 220702], [24, 220802], [30, 221042], [34, 221382], [38, 221962], [46, 222282], [54, 222622], [59, 222862], [63, 223022], [70, 223382], [74, 223802], [81, 224042], [85, 224302], [91, 224522], [101, 225549], [104, 225690], [109, 225830], [113, 225970], [119, 226410], [122, 226510], [126, 226630], [130, 226850], [134, 227050], [140, 227450], [146, 227770], [150, 227930], [157, 228230], [160, 228430]]}, {"verse": 33, "start": 229015, "end": 233425, "text": "And with many such parables spoke he the word to them, as they were able to hear it.", "words": [[0, 229015], [4, 229150], [9, 229290], [14, 229530], [19, 229770], [28, 230330], [34, 230690], [37, 230990], [41, 231170], [46, 231430], [49, 231650], [55, 231870], [58, 232130], [63, 232290], [68, 232470], [73, 232750], [76, 232910], [81, 233170]]}, {"verse": 34, "start": 233875, "end": 240861, "text": "But without a parable spoke he not to them: and when they were alone, he expounded all things to his disciples.", "words": [[0, 233875], [4, 234175], [12, 234495], [14, 234695], [22, 235095], [28, 235715], [31, 235795], [35, 235995], [38, 236175], [44, 236897], [48, 237028], [53, 237168], [58, 237328], [63, 237508], [70, 238088], [73, 238188], [83, 238808], [87, 239148], [94, 239468], [97, 239788], [101, 239968]]}, {"verse": 35, "start": 241311, "end": 246980, "text": "And the same day, when the even was come, he says to them, Let us pass over to the other side.", "words": [[0, 241311], [4, 241435], [8, 241555], [13, 241815], [18, 242315], [23, 242455], [27, 242615], [32, 242875], [36, 243155], [42, 243875], [45, 243975], [50, 244215], [53, 244455], [59, 245032], [63, 245190], [66, 245350], [71, 245590], [76, 245930], [79, 246110], [83, 246250], [89, 246410]]}, {"verse": 36, "start": 247330, "end": 254393, "text": "And when they had sent away the multitude, they took him even as he was in the ship. And there were also with him other little ships.", "words": [[0, 247330], [4, 247455], [9, 247595], [14, 247795], [18, 247915], [23, 248135], [28, 248355], [32, 248535], [43, 249455], [48, 249615], [53, 249835], [57, 250035], [62, 250295], [65, 250575], [68, 250695], [72, 250935], [75, 251155], [79, 251275], [85, 251966], [89, 252112], [95, 252232], [100, 252392], [105, 252752], [110, 252992], [114, 253152], [120, 253412], [127, 253752]]}, {"verse": 37, "start": 254843, "end": 260661, "text": "And there arose a great storm of wind, and the waves beat into the ship, so that it was now full.", "words": [[0, 254843], [4, 254986], [10, 255146], [16, 255506], [18, 255706], [24, 255946], [30, 256326], [33, 256546], [39, 257246], [43, 257526], [47, 257646], [53, 257966], [58, 258266], [63, 258546], [67, 258726], [73, 259306], [76, 259486], [81, 259646], [84, 259746], [88, 259886], [92, 260106]]}, {"verse": 38, "start": 261111, "end": 269911, "text": "And he was in the hinder part of the ship, asleep on a pillow: and they awake him, and say to him, Master, do you not care that we perish?", "words": [[0, 261111], [4, 261251], [7, 261371], [11, 261531], [14, 261691], [18, 261811], [25, 262091], [30, 262411], [33, 262531], [37, 262651], [43, 262951], [50, 263551], [53, 263871], [55, 263951], [63, 264693], [67, 264837], [72, 265017], [78, 265337], [83, 265637], [87, 266037], [91, 266277], [94, 266437], [99, 267123], [107, 267663], [110, 267743], [114, 267883], [118, 268043], [123, 268343], [128, 268583], [131, 268723]]}, {"verse": 39, "start": 270261, "end": 279555, "text": "And he arose, and rebuked the wind, and said to the sea, Peace, be still. And the wind ceased, and there was a great calm.", "words": [[0, 270261], [4, 270422], [7, 270562], [14, 270922], [18, 271222], [26, 271722], [30, 271802], [36, 272102], [40, 272562], [45, 272782], [48, 272962], [52, 273082], [57, 275141], [64, 275412], [67, 275732], [74, 276669], [78, 276813], [82, 276933], [87, 277153], [95, 277953], [99, 278233], [105, 278353], [109, 278513], [111, 278613], [117, 278833]]}, {"verse": 40, "start": 280005, "end": 284890, "text": "And he said to them, Why are you so fearful? how is it that you have no faith?", "words": [[0, 280005], [4, 280145], [7, 280245], [12, 280465], [15, 280665], [21, 281208], [25, 281396], [29, 281596], [33, 281756], [36, 282016], [45, 283094], [49, 283260], [52, 283500], [55, 283620], [60, 283800], [64, 283960], [69, 284180], [72, 284360]]}, {"verse": 41, "start": 285240, "end": 293515, "text": "And they feared exceedingly, and said one to another, What manner of man is this, that even the wind and the sea obey him?", "words": [[0, 285240], [4, 285386], [9, 285486], [16, 285806], [29, 286486], [33, 287126], [38, 287326], [42, 287546], [45, 287746], [54, 289878], [59, 290021], [66, 290321], [69, 290501], [73, 290701], [76, 290901], [82, 291481], [87, 291721], [92, 291861], [96, 292041], [101, 292301], [105, 292461], [109, 292561], [113, 292841], [118, 293041]]}]}