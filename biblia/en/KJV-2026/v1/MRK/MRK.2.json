{"book": "MRK", "chapter": 2, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 226667, "verses": [{"verse": 1, "start": 300, "end": 6917, "text": "And again he entered into Capernaum after some days; and it was noised that he was in the house.", "words": [[0, 300], [4, 467], [10, 1027], [13, 1127], [21, 1547], [26, 2117], [36, 2687], [42, 3107], [47, 3427], [53, 4432], [57, 4600], [60, 4720], [64, 4980], [71, 5240], [76, 5640], [79, 5840], [83, 6020], [86, 6220], [90, 6360]]}, {"verse": 2, "start": 7367, "end": 16978, "text": "And immediately many were gathered together, so that there was no room to receive them, no, not so much as about the door: and he preached the word to them.", "words": [[0, 7367], [4, 7510], [16, 7830], [21, 8330], [26, 8550], [35, 8850], [45, 9610], [48, 9810], [53, 10010], [59, 10150], [63, 10330], [66, 10530], [71, 10770], [74, 10930], [82, 11310], [88, 11790], [92, 12330], [96, 12510], [99, 12690], [104, 12910], [107, 13030], [113, 13250], [117, 13430], [123, 14200], [127, 14347], [130, 14447], [139, 14747], [143, 14947], [148, 15167], [151, 15367]]}, {"verse": 3, "start": 17428, "end": 21301, "text": "And they come to him, bringing one paralyzed, which was borne of four.", "words": [[0, 17428], [4, 17549], [9, 17669], [14, 17889], [17, 18089], [22, 18649], [31, 18909], [35, 19189], [46, 20069], [52, 20169], [56, 20379], [62, 20589], [65, 20789]]}, {"verse": 4, "start": 21751, "end": 31153, "text": "And when they could not come near to him for the press, they uncovered the roof where he was: and when they had broken it up, they let down the bed in which the paralytic lay.", "words": [[0, 21751], [4, 22054], [9, 22174], [14, 22314], [20, 22454], [24, 22634], [29, 22874], [34, 23074], [37, 23234], [41, 23414], [45, 23574], [49, 23694], [56, 24334], [61, 24494], [71, 24814], [75, 25054], [80, 25274], [86, 25534], [89, 25694], [94, 26446], [98, 26578], [103, 26738], [108, 26938], [112, 27078], [119, 27398], [122, 27658], [126, 28258], [131, 28398], [135, 28578], [140, 28878], [144, 29038], [148, 29318], [151, 29598], [157, 29798], [161, 29998], [171, 30618]]}, {"verse": 5, "start": 31603, "end": 37026, "text": "When Jesus saw their faith, he said to the paralytic, Son, your sins be forgiven you.", "words": [[0, 31603], [5, 31774], [11, 32094], [15, 32494], [21, 32674], [28, 33294], [31, 33544], [36, 33794], [39, 33994], [43, 34094], [54, 35095], [59, 35470], [64, 35550], [69, 35870], [72, 36170], [81, 36550]]}, {"verse": 6, "start": 37376, "end": 41838, "text": "But there were certain of the scribes sitting there, and reasoning in their hearts,", "words": [[0, 37376], [4, 37483], [10, 37603], [15, 37723], [23, 38083], [26, 38283], [30, 38403], [38, 38903], [46, 39103], [53, 39483], [57, 39843], [67, 40223], [70, 40463], [76, 40603]]}, {"verse": 7, "start": 42088, "end": 46188, "text": "Why does this man thus speak blasphemies? who can forgive sins but God only?", "words": [[0, 42088], [4, 42226], [9, 42386], [14, 42586], [18, 42826], [23, 43086], [29, 43306], [42, 44502], [46, 44592], [50, 44732], [58, 45012], [63, 45332], [67, 45592], [71, 45772]]}, {"verse": 8, "start": 46538, "end": 54709, "text": "And immediately when Jesus perceived in his spirit that they so reasoned within themselves, he said to them, Why do you reason these things in your hearts?", "words": [[0, 46538], [4, 46689], [16, 47049], [21, 47469], [27, 47769], [37, 48349], [40, 48549], [44, 48689], [51, 49069], [56, 49309], [61, 49469], [64, 49689], [73, 50129], [80, 50309], [92, 51309], [95, 51469], [100, 51709], [103, 51889], [109, 52559], [113, 52697], [116, 52837], [120, 52937], [127, 53237], [133, 53497], [140, 53797], [143, 53997], [148, 54117]]}, {"verse": 9, "start": 55159, "end": 61741, "text": "Whether is it easier to say to the paralytic, Your sins be forgiven you; or to say, Arise, and take up your bed, and walk?", "words": [[0, 55159], [8, 55320], [11, 55520], [14, 55620], [21, 55820], [24, 55980], [28, 56180], [31, 56240], [35, 56360], [46, 57180], [51, 57280], [56, 57540], [59, 57740], [68, 58080], [73, 58818], [76, 58921], [79, 59041], [84, 59281], [91, 59781], [95, 60101], [100, 60301], [103, 60461], [108, 60561], [113, 60881], [117, 61201]]}, {"verse": 10, "start": 62191, "end": 68194, "text": "But that you may know that the Son of man has power on earth to forgive sins, (he says to the paralytic,)", "words": [[0, 62191], [4, 62276], [9, 62436], [13, 62596], [17, 62776], [22, 63056], [27, 63256], [31, 63396], [35, 63636], [38, 63756], [42, 64076], [46, 64316], [52, 64676], [55, 64916], [61, 65236], [64, 65476], [72, 65796], [78, 66868], [82, 66952], [87, 67172], [90, 67392], [94, 67492]]}, {"verse": 11, "start": 68494, "end": 73141, "text": "I say to you, Arise, and take up your bed, and go your way into your house.", "words": [[0, 68494], [2, 68634], [6, 68874], [9, 69074], [14, 69514], [21, 69854], [25, 70434], [30, 70694], [33, 70854], [38, 70974], [43, 71254], [47, 71554], [50, 71734], [55, 71894], [59, 72134], [64, 72374], [69, 72554]]}, {"verse": 12, "start": 73491, "end": 84455, "text": "And immediately he arose, took up the bed, and went forth before them all; so that they were all amazed, and glorified God, saying, We never saw it on this fashion.", "words": [[0, 73491], [4, 73645], [16, 74065], [19, 74485], [26, 75365], [31, 75525], [34, 75705], [38, 75845], [43, 76485], [47, 76625], [52, 76805], [58, 77105], [65, 77465], [70, 77685], [75, 78375], [78, 78517], [83, 78677], [88, 78817], [93, 78977], [97, 79257], [105, 79797], [109, 80197], [119, 80897], [124, 81477], [132, 82668], [135, 82793], [141, 83073], [145, 83433], [148, 83613], [151, 83793], [156, 83993]]}, {"verse": 13, "start": 84805, "end": 90294, "text": "And he went forth again by the sea side; and all the multitude resorted to him, and he taught them.", "words": [[0, 84805], [4, 84938], [7, 85038], [12, 85238], [18, 85518], [24, 85858], [27, 86118], [31, 86419], [35, 86720]