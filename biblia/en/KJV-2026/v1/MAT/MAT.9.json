{"book": "MAT", "chapter": 9, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 291112, "verses": [{"verse": 1, "start": 300, "end": 4739, "text": "And he entered into a ship, and passed over, and came into his own city.", "words": [[0, 300], [4, 427], [7, 527], [15, 847], [20, 1167], [22, 1327], [28, 1607], [32, 2147], [39, 2467], [45, 2827], [49, 3427], [54, 3647], [59, 3887], [63, 4087], [67, 4247]]}, {"verse": 2, "start": 5189, "end": 16977, "text": "And, behold, they brought to him a man paralyzed, lying on a bed: and Jesus seeing their faith said to the paralytic; Son, be of good cheer; your sins be forgiven you.", "words": [[0, 5189], [5, 5317], [13, 6017], [18, 6157], [26, 6397], [29, 6597], [33, 6717], [35, 6777], [39, 7037], [50, 8077], [56, 8357], [59, 8557], [61, 8637], [66, 10013], [70, 10166], [76, 10506], [83, 10926], [89, 11186], [95, 11506], [100, 11886], [103, 12046], [107, 12166], [118, 13723], [123, 14003], [126, 14243], [129, 14463], [134, 14643], [141, 15525], [146, 15623], [151, 15923], [154, 16183], [163, 16523]]}, {"verse": 3, "start": 17327, "end": 22433, "text": "And, behold, certain of the scribes said within themselves, This man blasphemes.", "words": [[0, 17327], [5, 17483], [13, 18403], [21, 18763], [24, 18963], [28, 19063], [36, 19603], [41, 19743], [48, 20043], [60, 21129], [65, 21306], [69, 21896]]}, {"verse": 4, "start": 22783, "end": 27543, "text": "And Jesus knowing their thoughts said, Why do you think evil in your hearts?", "words": [[0, 22783], [4, 22932], [10, 23252], [18, 23632], [24, 23912], [33, 24292], [39, 25576], [43, 25715], [46, 25855], [50, 25975], [56, 26195], [61, 26575], [64, 26835], [69, 26935]]}, {"verse": 5, "start": 27993, "end": 33262, "text": "For whether is easier, to say, Your sins be forgiven you; or to say, Arise, and walk?", "words": [[0, 27993], [4, 28117], [12, 28277], [15, 28497], [23, 28877], [26, 29097], [31, 29557], [36, 29637], [41, 29997], [44, 30237], [53, 30597], [58, 31333], [61, 31434], [64, 31574], [69, 31894], [76, 32314], [80, 32714]]}, {"verse": 6, "start": 33712, "end": 44612, "text": "But that you may know that the Son of man has power on earth to forgive sins, (then says he to the paralytic,) Arise, take up your bed, and go to your house.", "words": [[0, 33712], [4, 33798], [9, 33958], [13, 34118], [17, 34298], [22, 34578], [27, 34778], [31, 34918], [35, 35158], [38, 35278], [42, 35598], [46, 35838], [52, 36198], [55, 36438], [61, 36758], [64, 36998], [72, 37318], [78, 38389], [84, 38696], [89, 38976], [92, 39276], [95, 39456], [99, 39576], [111, 41341], [118, 41982], [123, 42122], [126, 42342], [131, 42482], [136, 42802], [140, 43442], [143, 43702], [146, 43902], [151, 44062]]}, {"verse": 7, "start": 44962, "end": 47523, "text": "And he arose, and departed to his house.", "words": [[0, 44962], [4, 45106], [7, 45286], [14, 45626], [18, 46066], [27, 46486], [30, 46766], [34, 46926]]}, {"verse": 8, "start": 47973, "end": 54156, "text": "But when the multitudes saw it, they marvelled, and glorified God, which had given such power to men.", "words": [[0, 47973], [4, 48080], [9, 48240], [13, 48530], [24, 48820], [28, 49320], [32, 49700], [37, 50100], [48, 50500], [52, 50720], [62, 51440], [67, 52140], [73, 52360], [77, 52520], [83, 52740], [88, 53040], [94, 53460], [97, 53680]]}, {"verse": 9, "start": 54606, "end": 66851, "text": "¶ And as Jesus passed forth from there, he saw a man, named Matthew, sitting at the tax office: and he says to him, Follow me. And he arose, and followed him.", "words": [[2, 54606], [6, 54722], [9, 54882], [15, 55222], [22, 55662], [28, 56042], [33, 56322], [40, 57102], [43, 57242], [47, 57542], [49, 57742], [54, 58122], [60, 58582], [69, 59202], [77, 59622], [80, 59842], [84, 59942], [88, 60222], [96, 61331], [100, 61611], [103, 61711], [108, 61951], [111, 62191], [116, 64255], [123, 64506], [127, 65167], [131, 65308], [134, 65488], [141, 65708], [145, 66088], [154, 66428]]}, {"verse": 10, "start": 67301, "end": 77559, "text": "¶ And it came to pass, as Jesus sat at the table in the house, behold, many tax collectors and sinners came and sat down with him and his disciples.", "words": [[2, 67301], [6, 67433], [9, 67533], [14, 67773], [17, 67973], [23, 68873], [26, 69113], [32, 69473], [36, 69893], [39, 70033], [43, 70153], [49, 70573], [52, 70753], [56, 70873], [63, 71753], [71, 72633], [76, 72873], [80, 73273], [91, 73813], [95, 74133], [103, 74513], [108, 74973], [112, 75233], [116, 75513], [121, 75853], [126, 76153], [130, 76373], [134, 76513], [138, 76653]]}, {"verse": 11, "start": 78009, "end": 84625, "text": "And when the Pharisees saw it, they said to his disciples, Why eats your Master with tax collectors and sinners?", "words": [[0, 78009], [4, 78131], [9, 78271], [13, 78431], [23, 79051], [27, 79311], [31, 79831], [36, 79971], [41, 80191], [44, 80351], [48, 80471], [59, 81460], [63, 81672], [68, 82012], [73, 82172], [80, 82532], [85, 82832], [89, 83152], [100, 83652], [104, 83972]]}, {"verse": 12, "start": 84975, "end": 90926, "text": "But when Jesus heard that, he said to them, They that be whole need not a physician, but they that are sick.", "words": [[0, 84975], [4, 85080], [9, 85280], [15, 85600], [21, 85960], [27, 86360], [30, 86440], [35, 86700], [38, 86880], [44, 87493], [49, 87735], [54, 87975], [57, 88175], [63, 88495], [68, 88775], [72, 89015], [74, 89135], [85, 89755], [89, 89915], [94, 90135], [99, 90295], [103, 90415]]}, {"verse": 13, "start": 91376, "end": 100124, "text": "But go and learn what that means, I will have mercy, and not sacrifice: for I am not come to call the righteous, but sinners to repentance.", "words": [[0, 91376], [4, 91476], [7, 91736], [11, 91916], [17, 92116], [22, 92336], [27, 92556], [34, 93276], [36, 93416], [41, 93556], [46, 93736], [53, 94136], [57, 94416], [61, 94616], [72, 95848], [76, 95987], [78, 96327], [81, 96467], [85, 96687], [90, 96987], [93, 97167], [98, 97447], [102, 97627], [113, 98327], [117, 98687], [125, 99007], [128, 99347]]}, {"verse": 14, "start": 100474, "end": 108117, "text": "¶ Then came to him the disciples of John, saying, Why do we and the Pharisees fast often, but your disciples fast not?", "words": [[2, 100474], [7, 100689], [12, 100949], [15, 101169], [19, 101329], [23, 101469], [33, 101929], [36, 102169], [42, 102969], [50, 104197], [54, 104367], [57, 104547], [60, 104687], [64, 104867], [68, 104967], [78, 105567], [83, 105787], [90, 106687], [94, 106787], [99, 106907], [109, 107267], [114, 107567]]}, {"verse": 15, "start": 108467, "end": 118840, "text": "And Jesus said to them, Can the children of the bridechamber mourn, as long as the bridegroom is with them? but the days will come, when the bridegroom shall be taken from them, and then shall they fast.", "words": [[0, 108467], [4, 108593], [10, 108933], [15, 109333], [18, 109513], [24, 110107], [28, 110240], [32, 110360], [41, 110680], [44, 110840], [48, 111150], [61, 111460], [68, 112240], [71, 112420], [76, 112620], [79, 112760], [83, 112880], [94, 113340], [97, 113460], [102, 113660], [108, 114314], [112, 114400], [116, 114540], [121, 114780], [126, 114960], [132, 115340], [137, 115680], [141, 115800], [152, 116260], [158, 116440], [161, 116580], [167, 116840], [172, 117120], [178, 117580], [182, 117660], [187, 117840], [193, 118100], [198, 118260]]}, {"verse": 16, "start": 119290, "end": 127243, "text": "No man puts a piece of new cloth to an old garment, for that which is put in to fill it up takes from the garment, and the tear is made worse.", "words": [[0, 119290], [3, 119518], [7, 119798], [12, 120058], [14, 120258], [20, 120418], [23, 120578], [27, 120738], [33, 121078], [36, 121358], [39, 121498], [43, 121658], [52, 122378], [56, 122618], [61, 122818], [67, 123018], [70, 123198], [74, 123378], [77, 123558], [80, 123718], [85, 123978], [88, 124138], [91, 124278], [97, 124558], [102, 124858], [106, 124998], [115, 125781], [119, 125902], [123, 126002], [128, 126302], [131, 126502], [136, 126682]]}, {"verse": 17, "start": 127693, "end": 138786, "text": "Neither do men put new wine into old wineskins: else the bottles break, and the wine runs out, and the bottles perish: but they put new wine into new bottles, and both are preserved.", "words": [[0, 127693], [8, 128018], [11, 128258], [15, 128498], [19, 128778], [23, 129018], [28, 129378], [33, 129638], [37, 130323], [48, 131255], [53, 131442], [57, 131662], [65, 131942], [72, 132322], [76, 132782], [80, 132902], [85, 133162], [90, 133442], [95, 133742], [99, 134102], [103, 134202], [111, 134482], [119, 135477], [123, 135554], [128, 135694], [132, 135914], [136, 136134], [141, 136434], [146, 136654], [150, 136874], [159, 137274], [163, 137734], [168, 137954], [172, 138114]]}, {"verse": 18, "start": 139136, "end": 150834, "text": "¶ While he spoke these things to them, behold, there came a certain ruler, and worshipped him, saying, My daughter is even now dead: but come and lay your hand upon her, and she shall live.", "words": [[2, 139136], [8, 139346], [11, 139566], [17, 139886], [23, 140226], [30, 140606], [33, 140866], [39, 141386], [47, 142306], [53, 142646], [58, 142866], [60, 143066], [68, 143326], [75, 143806], [79, 144296], [90, 144786], [95, 145086], [103, 146661], [106, 146817], [115, 147097], [118, 147397], [123, 147577], [127, 147797], [133, 148524], [137, 148626], [142, 148846], [146, 148946], [150, 149086], [155, 149226], [160, 149426], [165, 149626], [170, 149906], [174, 150146], [178, 150346], [184, 150546]]}, {"verse": 19, "start": 151184, "end": 155457, "text": "And Jesus arose, and followed him, and so did his disciples.", "words": [[0, 151184], [4, 151311], [10, 151651], [17, 152091], [21, 152491], [30, 152871], [35, 153691], [39, 153811], [42, 154091], [46, 154311], [50, 154471]]}, {"verse": 20, "start": 155907, "end": 163838, "text": "¶ And, behold, a woman, which was diseased with an issue of blood twelve years, came behind him, and touched the hem of his garment:", "words": [[2, 155907], [7, 156056], [15, 156816], [17, 156996], [24, 157276], [30, 157836], [34, 158036], [43, 158636], [48, 158796], [51, 158916], [57, 159156], [60, 159336], [66, 159596], [73, 159856], [80, 160836], [85, 161016], [92, 161416], [97, 161736], [101, 162216], [109, 162536], [113, 162776], [117, 162956], [120, 163116], [124, 163256]]}, {"verse": 21, "start": 164288, "end": 169395, "text": "For she said within herself, If I may but touch his garment, I shall be whole.", "words": [[0, 164288], [4, 164412], [8, 164652], [13, 164912], [20, 165172], [29, 166194], [32, 166344], [34, 166544], [38, 166784], [42, 167004], [48, 167284], [52, 167484], [61, 168324], [63, 168524], [69, 168764], [72, 168944]]}, {"verse": 22, "start": 169745, "end": 179257, "text": "But Jesus turned him about, and when he saw her, he said, Daughter, be of good comfort; your faith has made you whole. And the woman was made whole from that hour.", "words": [[0, 169745], [4, 169891], [10, 170211], [17, 170611], [21, 170811], [28, 171391], [32, 171771], [37, 171912], [40, 172072], [44, 172331], [49, 172632], [52, 172711], [58, 173437], [68, 173815], [71, 173975], [74, 174115], [79, 174295], [88, 175231], [93, 175318], [99, 175558], [103, 175778], [108, 175998], [112, 176118], [119, 176934], [123, 177066], [127, 177166], [133, 177426], [137, 177706], [142, 177906], [148, 178226], [153, 178526], [158, 178726]]}, {"verse": 23, "start": 179707, "end": 185038, "text": "And when Jesus came into the ruler’s house, and saw the minstrels and the people making a noise,", "words": [[0, 179707], [4, 179832], [9, 179972], [15, 180252], [20, 180592], [25, 180852], [29, 180992], [37, 181492], [44, 181752], [48, 182292], [52, 182612], [56, 182772], [66, 183332], [70, 183512], [74, 183612], [81, 183872], [88, 184252], [90, 184392]]}, {"verse": 24, "start": 185488, "end": 192243, "text": "He said to them, Give place: for the maid is not dead, but sleeps. And they laughed him to scorn.", "words": [[0, 185488], [3, 185577], [8, 185817], [11, 185997], [17, 186647], [22, 186848], [29, 187874], [33, 187966], [37, 188106], [42, 188386], [45, 188586], [49, 188786], [55, 189566], [59, 189706], [67, 190742], [71, 190899], [76, 191099], [84, 191299], [88, 191479], [91, 191619]]}, {"verse": 25, "start": 192693, "end": 197804, "text": "But when the people were put forth, he went in, and took her by the hand, and the maid arose.", "words": [[0, 192693], [4, 192792], [9, 192932], [13, 193052], [20, 193292], [25, 193492], [29, 193692], [36, 194312], [39, 194432], [44, 194652], [48, 194932], [52, 195292], [57, 195492], [61, 195612], [64, 195792], [68, 195932], [74, 196352], [78, 196752], [82, 196872], [87, 197112]]}, {"verse": 26, "start": 198254, "end": 201684, "text": "And the fame hereof went abroad into all that land.", "words": [[0, 198254], [4, 198390], [8, 198510], [13, 198910], [20, 199450], [25, 199690], [32, 200210], [37, 200510], [41, 200850], [46, 201090]]}, {"verse": 27, "start": 202134, "end": 209760, "text": "¶ And when Jesus departed from there, two blind men followed him, crying, and saying, You Son of David, have mercy on us.", "words": [[2, 202134], [6, 202278], [11, 202438], [17, 202758], [26, 203338], [31, 203638], [38, 204338], [42, 204538], [48, 204938], [52, 205258], [61, 205678], [66, 206138], [74, 206558], [78, 206838], [86, 207644], [90, 207760], [94, 208000], [97, 208140], [104, 208460], [109, 208700], [115, 209140], [118, 209400]]}, {"verse": 28, "start": 210110, "end": 224360, "text": "And when he was come into the house, the blind men came to him: and Jesus says to them, Do you believe that I am able to do this? They said to him, Yes, Lord.", "words": [[0, 210110], [4, 210234], [9, 210414], [12, 210594], [16, 210794], [21, 211014], [26, 211234], [30, 211414], [37, 212334], [41, 212494], [47, 212774], [51, 213094], [56, 213394], [59, 213654], [64, 214317], [68, 214456], [74, 214816], [79, 215156], [82, 215376], [88, 216045], [91, 216142], [95, 216362], [103, 216762], [108, 217042], [110, 217262], [113, 217402], [118, 217702], [121, 217902], [124, 218122], [128, 220185], [130, 221726], [135, 221831], [140, 222071], [143, 222271], [148, 223513], [153, 223757]]}, {"verse": 29, "start": 224710, "end": 229914, "text": "Then touched he their eyes, saying, According to your faith be it to you.", "words": [[0, 224710], [5, 224914], [13, 225294], [16, 225574], [22, 225794], [28, 226474], [36, 227366], [46, 227731], [49, 228071], [54, 228211], [60, 228951], [63, 229171], [66, 229311], [69, 229511]]}, {"verse": 30, "start": 230264, "end": 236637, "text": "And their eyes were opened; and Jesus sternly charged them, saying, See that no man know it.", "words": [[0, 230264], [4, 230409], [10, 230589], [15, 230909], [20, 231189], [28, 231992], [32, 232132], [38, 232492], [46, 233112], [54, 233452], [60, 233872], [68, 235199], [72, 235422], [77, 235602], [80, 235802], [84, 236062], [89, 236322]]}, {"verse": 31, "start": 236987, "end": 241787, "text": "But they, when they were departed, spread abroad his fame in all that country.", "words": [[0, 236987], [4, 237187], [10, 237547], [15, 237687], [20, 237867], [25, 238007], [35, 238867], [42, 239407], [49, 239807], [53, 240087], [58, 240447], [61, 240687], [65, 240887], [70, 241107]]}, {"verse": 32, "start": 242237, "end": 247711, "text": "¶ As they went out, behold, they brought to him a dumb man demon-possessed.", "words": [[2, 242237], [5, 242436], [10, 242616], [15, 242856], [20, 243356], [28, 244456], [33, 244636], [41, 244916], [44, 245156], [48, 245396], [50, 245596], [55, 245996], [59, 246887]]}, {"verse": 33, "start": 248161, "end": 255910, "text": "And when the demon was cast out, the dumb spoke: and the multitudes marvelled, saying, It was never so seen in Israel.", "words": [[0, 248161], [4, 248305], [9, 248465], [13, 248605], [19, 248925], [23, 249185], [28, 249565], [33, 250365], [37, 250485], [42, 250785], [49, 251850], [53, 251972], [57, 252072], [68, 252792], [79, 253512], [87, 254284], [90, 254372], [94, 254512], [100, 254712], [103, 254972], [108, 255252], [111, 255432]]}, {"verse": 34, "start": 256260, "end": 260504, "text": "But the Pharisees said, He casts out demons through the prince of the demons.", "words": [[0, 256260], [4, 256367], [8, 256487], [18, 257107], [24, 257797], [27, 257904], [33, 258244], [37, 258384], [44, 258804], [52, 259124], [56, 259284], [63, 259604], [66, 259824], [70, 259924]]}, {"verse": 35, "start": 260854, "end": 270751, "text": "And Jesus went about all the cities and villages, teaching in their synagogues, and preaching the gospel of the kingdom, and healing every sickness and every disease among the people.", "words": [[0, 260854], [4, 260996], [10, 261276], [15, 261616], [21, 261876], [25, 262316], [29, 262516], [36, 262816], [40, 263036], [50, 263776], [59, 264076], [62, 264296], [68, 264436], [80, 265176], [84, 265276], [94, 265556], [98, 265836], [105, 266236], [108, 266476], [112, 266616], [121, 266956], [125, 267576], [133, 267916], [139, 268276], [148, 268716], [152, 269056], [158, 269336], [166, 269736], [172, 270076], [176, 270276]]}, {"verse": 36, "start": 271201, "end": 280145, "text": "¶ But when he saw the multitudes, he was moved with compassion on them, because they fainted, and were scattered abroad, as sheep having no shepherd.", "words": [[2, 271201], [6, 271311], [11, 271451], [14, 271611], [18, 271851], [22, 272011], [34, 272631], [37, 272831], [41, 272991], [47, 273311], [52, 273511], [63, 274071], [66, 274331], [72, 274831], [80, 275151], [85, 275391], [94, 276011], [98, 276391], [103, 276531], [113, 276891], [121, 277911], [124, 278091], [130, 278351], [137, 278671], [140, 278891]]}, {"verse": 37, "start": 280595, "end": 285833, "text": "Then says he to his disciples, The harvest truly is plenteous, but the labourers are few;", "words": [[0, 280595], [5, 280764], [10, 281024], [13, 281304], [16, 281504], [20, 281644], [31, 282693], [35, 282798], [43, 283038], [49, 283518], [52, 283718], [63, 284398], [67, 284538], [71, 284878], [81, 285218], [85, 285338]]}, {"verse": 38, "start": 286283, "end": 290712, "text": "Pray therefore the Lord of the harvest, that he will send forth labourers into his harvest.", "words": [[0, 286283], [5, 286428], [15, 286788], [19, 287048], [24, 287268], [27, 287408], [31, 287508], [40, 287868], [45, 288348], [48, 288468], [53, 288588], [58, 288848], [64, 289278], [74, 289708], [79, 289948], [83, 290148]]}]}