{"book": "PSA", "chapter": 33, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 133101, "verses": [{"verse": 1, "start": 300, "end": 5515, "text": "Alegraos, justos, en Jehová: a los rectos es hermosa la alabanza.", "words": [[0, 542], [10, 822], [18, 1642], [21, 1862], [29, 2859], [31, 3099], [35, 3239], [42, 3652], [45, 4066], [53, 4479], [56, 4639]]}, {"verse": 2, "start": 5965, "end": 10820, "text": "Celebrad a Jehová con arpa: cantadle con salterio y decacordio.", "words": [[0, 6130], [9, 6336], [11, 6543], [18, 7023], [22, 7163], [28, 8426], [37, 8806], [41, 9086], [50, 9786], [52, 10303]]}, {"verse": 3, "start": 11270, "end": 15867, "text": "Cantadle canción nueva: hacedlo bien tañendo con júbilo.", "words": [[0, 11554], [9, 11874], [17, 12294], [24, 13585], [32, 13945], [37, 14425], [45, 14905], [49, 15105]]}, {"verse": 4, "start": 16317, "end": 21535, "text": "Porque recta es la palabra de Jehová, y toda su obra con verdad hecha.", "words": [[0, 16317], [7, 16599], [13, 17219], [16, 17439], [19, 17599], [27, 18019], [30, 18219], [38, 18959], [40, 19139], [45, 19399], [48, 19739], [53, 20039], [57, 20299], [64, 20739]]}, {"verse": 5, "start": 21985, "end": 27245, "text": "Él ama justicia y juicio: de la misericordia de Jehová está llena la tierra.", "words": [[0, 22217], [3, 22482], [7, 22747], [16, 23012], [18, 23132], [26, 24094], [29, 24260], [32, 24380], [45, 25260], [48, 25359], [55, 25839], [60, 26080], [66, 26440], [69, 26580]]}, {"verse": 6, "start": 27695, "end": 34684, "text": "Por la palabra de Jehová fueron hechos los cielos, y todo el ejército de ellos por el espíritu de su boca.", "words": [[0, 27695], [4, 27838], [7, 27958], [15, 28278], [18, 28498], [25, 28958], [32, 29198], [39, 29578], [43, 29778], [51, 30718], [53, 30898], [58, 31218], [61, 31418], [70, 32078], [73, 32298], [79, 32558], [83, 32838], [86, 32978], [95, 33698], [98, 33838], [101, 34018]]}, {"verse": 7, "start": 35134, "end": 41007, "text":