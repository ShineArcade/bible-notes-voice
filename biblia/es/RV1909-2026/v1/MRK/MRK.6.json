{"book": "MRK", "chapter": 6, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 458571, "verses": [{"verse": 1, "start": 300, "end": 5039, "text": "Y salió de allí, y vino a su pueblo, y le siguieron sus discípulos.", "words": [[0, 300], [2, 441], [8, 761], [11, 901], [17, 1201], [19, 1701], [24, 1921], [26, 2101], [29, 2241], [37, 2601], [39, 2971], [42, 3341], [52, 3761], [56, 3981]]}, {"verse": 2, "start": 5389, "end": 20077, "text": "Y llegado el sábado, comenzó a enseñar en la sinagoga; y muchos oyéndole, estaban atónitos, diciendo: ¿De dónde tiene este estas cosas? ¿Y qué sabiduría es esta que le es dada, y tales milagros realizados por sus manos?", "words": [[0, 5389], [2, 5474], [10, 5874], [13, 5994], [21, 6474], [29, 7134], [31, 7274], [39, 7874], [42, 7994], [45, 8154], [55, 9214], [57, 9496], [64, 9936], [74, 10896], [82, 11276], [92, 12436], [102, 13303], [106, 13420], [112, 13560], [118, 13940], [123, 14240], [129, 14440], [136, 15310], [139, 15409], [143, 15529], [153, 16169], [156, 16349], [161, 16589], [165, 16749], [168, 16889], [171, 17049], [177, 17389], [179, 17769], [185, 17949], [194, 18509], [205, 19109], [209, 19329], [213, 19489]]}, {"verse": 3, "start": 20427, "end": 29912, "text": "¿No es este el carpintero, hijo de María, hermano de Jacobo, y de José, y de Judas, y de Simón? ¿No están también aquí con nosotros, sus hermanas? Y lo rechazaban.", "words": [[0, 20427], [4, 20623], [7, 20783], [12, 21023], [15, 21123], [27, 21843], [32, 22023], [35, 22183], [42, 22823], [50, 23143], [53, 23183], [61, 23743], [63, 23883], [66, 23943], [72, 24203], [74, 24603], [77, 24683], [84, 24943], [86, 25303], [89, 25363], [96, 26101], [100, 26245], [106, 26465], [114, 26765], [119, 26965], [123, 27165], [133, 27685], [137, 27765], [147, 28747], [149, 28851], [152, 28991]]}, {"verse": 4, "start": 30262, "end": 38338, "text": "Pero Jesús les decía: No hay profeta deshonrado sino en su tierra, y entre sus parientes, y en su casa.", "words": [[0, 30262], [5, 30449], [11, 30889], [15, 31369], [22, 32259], [25, 32446], [29, 32666], [37, 33346], [48, 34026], [53, 34306], [56, 34546], [59, 34706], [67, 35226], [69, 35946], [75, 36246], [79, 36486], [90, 37046], [92, 37446], [95, 37586], [98, 37746]]}, {"verse": 5, "start": 38688, "end": 46188, "text": "Y no pudo hacer allí alguna maravilla; solamente sanó unos pocos enfermos, poniendo sobre ellos las manos.", "words": [[0, 38688], [2, 38793], [5, 38933], [10, 39273], [16, 39533], [21, 39853], [28, 40293], [39, 41406], [49, 41904], [54, 42604], [59, 42784], [65, 43224], [75, 43964], [84, 44589], [90, 44929], [96, 45249], [100, 45489]]}, {"verse": 6, "start": 46538, "end": 53840, "text": "Y estaba maravillado de la incredulidad de ellos. Y rodeaba las aldeas de alrededor, enseñando.", "words": [[0, 46538], [2, 46649], [9, 46929], [21, 47729], [24, 47929], [27, 48069], [40, 49029], [43, 49309], [50, 50144], [52, 50269], [60, 50989], [64, 51209], [71, 51789], [74, 51909], [85, 52549]]}, {"verse": 7, "start": 54190, "end": 62451, "text": "Y llamó a los doce, y comenzó a enviarlos de dos en dos: y les dio autoridad sobre los espíritus inmundos.", "words": [[0, 54190], [2, 54338], [8, 54758], [10, 54958], [14, 55218], [20, 55478], [22, 55954], [30, 56594], [32, 56734], [42, 57374], [45, 57654], [49, 57954], [52, 58154], [57, 58916], [59, 59035], [63, 59195], [67, 59435], [77, 60275], [83, 60635], [87, 60875], [97, 61698]]}, {"verse": 8, "start": 62801, "end": 71011, "text": "Y les mandó que no llevasen nada para el camino, sino solamente bastón; no bolsa de viaje, ni pan, ni dinero en la bolsa;", "words": [[0, 62801], [2, 62918], [6, 63038], [12, 63438], [16, 63548], [19, 63658], [28, 64178], [33, 64478], [38, 64718], [41, 64878], [49, 65518], [54, 65778], [64, 66378], [72, 67420], [75, 67584], [81, 68004], [84, 68124], [91, 68804], [94, 68984], [99, 69644], [102, 69804], [109, 70144], [112, 70364], [115, 70444]]}, {"verse": 9, "start": 71361, "end": 75039, "text": "Pero que calzasen sandalias, y no vistiesen dos túnicas.", "words": [[0, 71361], [5, 71507], [9, 71947], [18, 72387], [29, 73147], [31, 73327], [34, 73687], [44, 74047], [48, 74207]]}, {"verse": 10, "start": 75389, "end": 82282, "text": "Y les decía: Donde quiera que entréis en una casa, quedaos en ella hasta que salgáis de allí.", "words": [[0, 75389], [2, 75652], [6, 75952], [13, 76851], [19, 77097], [26, 77557], [30, 77697], [38, 78217], [41, 78377], [45, 78537], [51, 79117], [59, 79897], [62, 80177], [67, 80477], [73, 80837], [77, 81037], [85, 81597], [88, 81857]]}, {"verse": 11, "start": 82632, "end": 100546, "text": "Y todos aquellos que no os reciban ni os oigan, saliendo de allí, sacudid el polvo que está debajo de vuestros pies, en testimonio a ellos. De cierto les digo que más tolerable será el castigo de los de Sodoma y Gomorra el día del juicio, que el de aquella ciudad.", "words": [[0, 82632], [2, 82756], [8, 83036], [17, 83536], [21, 83683], [24, 83829], [27, 83976], [35, 84656], [38, 85016], [41, 85176], [48, 86076], [57, 86616], [60, 86796], [66, 87426], [74, 88056], [77, 88196], [83, 88776], [87, 88936], [92, 89136], [99, 89536], [102, 89716], [111, 89996], [117, 90296], [120, 90796], [131, 91556], [133, 91676], [140, 92397], [143, 92562], [150, 92842], [154, 93202], [159, 93562], [163, 93722], [167, 93922], [177, 94622], [182, 94862], [185, 95082], [193, 95602], [196, 95762], [200, 95882], [203, 96062], [210, 96742], [212, 97022], [220, 97742], [223, 97982], [227, 98172], [231, 98362], [239, 98962], [243, 99202], [246, 99362], [249, 99482], [257, 99822]]}, {"verse": 12, "start": 100896, "end": 104944, "text": "Y saliendo, predicaban que los hombres se arrepintiesen.", "words": [[0, 100896], [2, 101199], [12, 101759], [23, 102559], [27, 102719], [31, 102919], [39, 103319], [42, 104157]]}, {"verse": 13, "start": 105294, "end": 110887, "text": "Y echaban fuera muchos demonios, y ungían con aceite a muchos enfermos, y sanaban.", "words": [[0, 105294], [2, 105442], [10, 105922], [16, 106142], [23, 106482], [33, 107282], [35, 107662], [42, 108182], [46, 108422], [53, 108762], [55, 108982], [62, 109142], [72, 109882], [74, 110182]]}, {"verse": 14, "start": 111237, "end": 122680, "text": "Y oyó el rey Herodes la fama de Jesús, porque su nombre se había hecho notorio; y dijo: Juan el que bautizaba, ha resucitado de los muertos, y por tanto, poderes milagrosos actúan en él.", "words": [[0, 111237], [2, 111387], [6, 111667], [9, 111807], [13, 112127], [21, 112647], [24, 112727], [29, 113047], [32, 113127], [39, 113827], [46, 114027], [49, 114227], [56, 114567], [59, 114767], [65, 115007], [71, 115347], [80, 116339], [82, 116539], [88, 117198], [93, 117430], [96, 117530], [100, 117670], [111, 118390], [114, 118545], [125, 119265], [128, 119385], [132, 119505], [141, 119985], [143, 120200], [147, 120360], [154, 120740], [162, 121280], [173, 121880], [180, 122260], [183, 122360]]}, {"verse": 15, "start": 122960, "end": 129364, "text": "Otros decían: Elías es. Y otros decían: Profeta es, o alguno de los profetas.", "words": [[0, 122960], [6, 123331], [14, 124559], [20, 125039], [24, 125759], [26, 125925], [32, 126105], [40, 127220], [48, 127661], [52, 127881], [54, 128021], [61, 128401], [64, 128461], [68, 128581]]}, {"verse": 16, "start": 129644, "end": 136208, "text": "Y oyéndolo Herodes, dijo: Este es Juan el que yo degollé: él ha resucitado de los muertos.", "words": [[0, 129644], [2, 129806], [11, 130406], [20, 131066], [26, 132050], [31, 132371], [34, 132591], [39, 132851], [42, 133171], [46, 133311], [49, 133721], [58, 134295], [61, 134592], [64, 134932], [75, 135272], [78, 135392], [82, 135512]]}, {"verse": 17, "start": 136488, "end": 149543, "text": "Porque el mismo Herodes había enviado, y prendido a Juan, y le había aprisionado en la cárcel a causa de Herodías, mujer de Felipe su hermano; pues la había tomado por mujer.", "words": [[0, 136488], [7, 136810], [10, 137010], [16, 137350], [24, 137830], [30, 138250], [39, 138890], [41, 139330], [50, 139930], [52, 140030], [58, 140470], [60, 141030], [63, 141190], [69, 141550], [81, 142550], [84, 142690], [87, 142850], [94, 143430], [96, 143610], [102, 143970], [105, 144310], [115, 145290], [121, 145730], [124, 145990], [131, 146630], [134, 146730], [143, 147585], [148, 147688], [151, 147888], [157, 148148], [164, 148648], [168, 148928]]}, {"verse": 18, "start": 149893, "end": 155068, "text": "Porque Juan decía a Herodes: No te es lícito tener la mujer de tu hermano.", "words": [[0, 149893], [7, 150097], [12, 150477], [18, 151257], [20, 151697], [29, 152729], [32, 152872], [35, 153099], [38, 153325], [45, 153552], [51, 153832], [54, 154012], [60, 154272], [63, 154452], [66, 154552]]}, {"verse": 19, "start": 155348, "end": 160189, "text": "Pero Herodías le guardaba rencor, y deseaba matarle, y no podía:", "words": [[0, 155348], [5, 155713], [14, 156113], [17, 156633], [26, 157193], [34, 157753], [36, 157948], [44, 158678], [53, 159408], [55, 159508], [58, 159608]]}, {"verse": 20, "start": 160539, "end": 171556, "text": "Porque Herodes temía a Juan, sabiendo que era varón justo y santo, y le tenía respeto: y oyéndole, hacía muchas cosas; y le oía de buena gana.", "words": [[0, 160539], [7, 160783], [15, 161323], [21, 162123], [23, 162323], [29, 163043], [38, 163483], [42, 163683], [46, 163823], [52, 164143], [58, 164483], [60, 164683], [67, 165483], [69, 165543], [72, 165683], [78, 166023], [87, 167100], [89, 167400], [99, 167960], [105, 168480], [112, 168820], [119, 169929], [121, 170070], [124, 170210], [128, 170570], [131, 170730], [137, 170950]]}, {"verse": 21, "start": 171906, "end": 183358, "text": "Y venido un día oportuno, en que Herodes, en la fiesta de su nacimiento, daba una cena a sus nobles y comandantes militares, y a los principales de Galilea;", "words": [[0, 171906], [2, 172035], [9, 172415], [12, 172575], [16, 172775], [26, 174115], [29, 174295], [33, 174475], [42, 175415], [45, 175715], [48, 175855], [55, 176215], [58, 176395], [61, 176535], [73, 177815], [78, 178135], [82, 178335], [87, 178675], [89, 178955], [93, 179155], [100, 179795], [102, 179975], [114, 180595], [125, 181315], [127, 181655], [129, 181695], [133, 181815], [145, 182515], [148, 182655]]}, {"verse": 22, "start": 183708, "end": 196035, "text": "Y entrando la hija de Herodías, y danzando, y agradando a Herodes y a los que estaban con él a la mesa, el rey dijo a la muchacha: Pídeme lo que quieras, que yo te lo daré.", "words": [[0, 183708], [2, 183872], [11, 184412], [14, 184632], [19, 185072], [22, 185192], [32, 186492], [34, 186692], [44, 188012], [46, 188092], [56, 188712], [58, 188952], [66, 189452], [68, 189832], [70, 189912], [74, 190012], [78, 190152], [86, 190452], [90, 190752], [93, 190912], [95, 190992], [98, 191092], [104, 191892], [107, 192092], [111, 192452], [116, 192912], [118, 193052], [121, 193092], [131, 194014], [138, 194352], [141, 194492], [145, 194612], [154, 195132], [158, 195332], [161, 195472], [164, 195592], [167, 195692]]}, {"verse": 23, "start": 196315, "end": 201521, "text": "Y le juró: Todo lo que me pidas te daré, hasta la mitad de mi reino.", "words": [[0, 196315], [2, 196460], [5, 196560], [11, 197331], [16, 197489], [19, 197689], [23, 197809], [26, 197929], [32, 198249], [35, 198409], [41, 198829], [47, 199149], [50, 199329], [56, 199589], [59, 199829], [62, 199949]]}, {"verse": 24, "start": 201801, "end": 207880, "text": "Y saliendo ella, dijo a su madre: ¿Qué pediré? Y ella dijo: La cabeza de Juan Bautista.", "words": [[0, 201801], [2, 201910], [11, 202390], [17, 202630], [22, 202970], [24, 203130], [27, 203250], [34, 204046], [39, 204170], [47, 204987], [49, 205149], [54, 205349], [60, 206139], [63, 206246], [70, 206606], [73, 206846], [78, 207046]]}, {"verse": 25, "start": 208160, "end": 216385, "text": "Entonces ella entró de inmediato al rey, y pidió, diciendo: Quiero que ahora mismo me des en un plato la cabeza de Juan Bautista.", "words": [[0, 208160], [9, 208705], [14, 209260], [20, 209740], [23, 209840], [33, 210440], [36, 210600], [41, 211020], [43, 211180], [50, 212000], [60, 212906], [67, 213086], [71, 213206], [77, 213386], [83, 213726], [86, 213926], [90, 214066], [93, 214206], [96, 214326], [102, 214646], [105, 214766], [112, 215086], [115, 215286], [120, 215506]]}, {"verse": 26, "start": 216665, "end": 225171, "text": "Y el rey se entristeció mucho; pero a causa del juramento, y de los que estaban con él a la mesa, no quiso desecharla.", "words": [[0, 216665], [2, 216863], [5, 217023], [9, 217463], [12, 217543], [24, 218403], [31, 219327], [36, 219471], [38, 219611], [44, 219931], [48, 220251], [59, 221251], [61, 221491], [64, 221591], [68, 221751], [72, 221911], [80, 222231], [84, 222511], [87, 222711], [89, 222791], [92, 222911], [98, 223731], [101, 223851], [107, 224191]]}, {"verse": 27, "start": 225521, "end": 231305, "text": "Y luego el rey, enviando un verdugo de la guardia, mandó que fuese traída su cabeza;", "words": [[0, 225521], [2, 225683], [8, 225843], [11, 226083], [16, 226563], [25, 227203], [28, 227363], [36, 227783], [39, 227943], [42, 228063], [51, 228903], [57, 229343], [61, 229463], [67, 229953], [74, 230443], [77, 230603]]}, {"verse": 28, "start": 231655, "end": 241385, "text": "El cual fue, y le degolló en la cárcel, y trajo su cabeza en un plato, y la dio a la muchacha, y la muchacha la dio a su madre.", "words": [[0, 231655], [3, 231800], [8, 232080], [13, 232600], [15, 232960], [18, 233120], [26, 233740], [29, 233900], [32, 234060], [40, 234640], [42, 235140], [48, 235560], [51, 235740], [58, 236080], [61, 236360], [64, 236480], [71, 237080], [73, 237580], [76, 237720], [80, 237900], [82, 238080], [85, 238140], [95, 239080], [97, 239520], [100, 239640], [109, 240140], [112, 240300], [116, 240520], [118, 240660], [121, 240780]]}, {"verse": 29, "start": 241735, "end": 248679, "text": "Y oyéndolo sus discípulos, vinieron y tomaron su cuerpo, y le pusieron en un sepulcro.", "words": [[0, 241735], [2, 241892], [11, 242512], [15, 242792], [27, 244272], [36, 244892], [38, 245152], [46, 245632], [49, 245872], [57, 246372], [59, 246607], [62, 246747], [71, 247267], [74, 247627], [77, 247807]]}, {"verse": 30, "start": 249029, "end": 256219, "text": "Y los apóstoles se juntaron con Jesús, y le contaron todo lo que habían hecho, y lo que habían enseñado.", "words": [[0, 249029], [2, 249131], [6, 249251], [16, 249851], [19, 250211], [28, 250711], [32, 250911], [39, 251311], [41, 252111], [44, 252231], [53, 252731], [58, 253071], [61, 253331], [65, 253491], [72, 253771], [79, 254151], [81, 254731], [84, 254851], [88, 254971], [95, 255251]]}, {"verse": 31, "start": 256569, "end": 269108, "text": "Y él les dijo: Venid vosotros aparte al lugar desierto, y descansad un poco. Porque eran muchos los que iban y venían, que ni siquiera tenían tiempo para comer.", "words": [[0, 256618], [2, 256703], [5, 256863], [9, 257163], [15, 258325], [21, 258792], [30, 259372], [37, 259952], [40, 260072], [46, 260412], [56, 261212], [58, 261792], [68, 262632], [71, 262792], [77, 263654], [84, 263879], [89, 264099], [96, 264599], [100, 265099], [104, 265319], [109, 265659], [111, 265759], [119, 266419], [123, 266699], [126, 266879], [135, 267299], [142, 267679], [149, 268179], [154, 268459]]}, {"verse": 32, "start": 269458, "end": 273017, "text": "Y se fueron en un barco al lugar desierto aparte.", "words": [[0, 269458], [2, 269566], [5, 269666], [12, 269966], [15, 270526], [18, 270666], [24, 271146], [27, 271286], [33, 271716], [42, 272146]]}, {"verse": 33, "start": 273367, "end": 282470, "text": "Y los vieron ir muchos, y le conocieron; y corrieron allá muchos a pie de las ciudades, y llegaron antes que ellos, y se juntaron a él.", "words": [[0, 273367], [2, 273494], [6, 273614], [13, 273914], [16, 274074], [24, 274474], [26, 275094], [29, 275194], [41, 276287], [43, 276412], [53, 277012], [58, 277512], [65, 277512], [67, 277782], [71, 278052], [74, 278212], [78, 278352], [88, 279092], [90, 279252], [99, 279652], [105, 279912], [109, 280132], [116, 281032], [118, 281292], [121, 281412], [130, 281972], [132, 282092]]}, {"verse": 34, "start": 282820, "end": 292628, "text": "Y saliendo Jesús vio grande multitud, y tuvo compasión de ellos, porque eran como ovejas que no tenían pastor; y les comenzó a enseñar muchas cosas.", "words": [[0, 282820], [2, 282942], [11, 283382], [17, 283822], [21, 284322], [28, 284602], [38, 285282], [40, 285517], [45, 285696], [55, 286337], [58, 286517], [65, 286816], [72, 287556], [77, 287816], [82, 288097], [89, 288597], [93, 288797], [96, 288936], [103, 289256], [111, 290176], [113, 290274], [117, 290394], [125, 290934], [127, 290994], [135, 291514], [142, 291774]]}, {"verse": 35, "start": 292978, "end": 301033, "text": "Y como ya era muy tarde, sus discípulos llegaron a él, diciendo: El lugar es desierto, y ya es muy tarde;", "words": [[0, 292978], [2, 293084], [7, 293284], [10, 293544], [14, 293724], [18, 293904], [25, 294724], [29, 294964], [40, 296004], [49, 296824], [51, 296964], [55, 297204], [65, 298538], [68, 298651], [74, 298851], [77, 299051], [87, 299651], [89, 300031], [92, 300191], [95, 300331], [99, 300471]]}, {"verse": 36, "start": 301383, "end": 307683, "text": "Envíalos para que vayan a los caseríos y aldeas de alrededor, y compren para sí pan; porque no tienen qué comer.", "words": [[0, 301383], [9, 301928], [14, 302148], [18, 302308], [24, 302628], [26, 302728], [30, 303078], [39, 303428], [41, 303528], [48, 303908], [51, 304218], [62, 304528], [64, 304928], [72, 305328], [77, 305631], [80, 305935], [85, 306397], [92, 306563], [95, 306743], [102, 306983], [106, 307183]]}, {"verse": 37, "start": 307963, "end": 317904, "text": "Y respondiendo él, les dijo: Dadles de comer vosotros. Y le dijeron: ¿ Que vayamos y compremos pan por doscientos denarios, y les demos de comer?", "words": [[0, 307963], [2, 308088], [15, 308868], [19, 309108], [23, 309248], [29, 309949], [36, 310555], [39, 310755], [45, 311055], [55, 312291], [57, 312415], [60, 312515], [69, 313440], [71, 313440], [75, 313541], [83, 314021], [85, 314181], [95, 314621], [99, 314981], [103, 315281], [114, 315581], [124, 316321], [126, 316781], [130, 316901], [136, 317201], [139, 317401]]}, {"verse": 38, "start": 318184, "end": 325607, "text": "Y él les dice: ¿Cuántos panes tenéis? Id, y vedlo. Y sabiéndolo, dijeron: Cinco, y dos peces.", "words": [[0, 318184], [2, 318390], [5, 318667], [9, 318944], [15, 319431], [24, 319817], [30, 320257], [38, 321171], [42, 321171], [44, 321599], [51, 322291], [53, 322551], [65, 323251], [74, 324378], [81, 324558], [83, 324748], [87, 324938]]}, {"verse": 39, "start": 325887, "end": 330859, "text": "Y les mandó que hiciesen recostar a todos por grupos sobre la hierba verde.", "words": [[0, 325887], [2, 326010], [6, 326150], [12, 326610], [16, 326770], [25, 327290], [34, 327930], [36, 328030], [42, 328230], [46, 328530], [53, 328930], [59, 329610], [62, 329830], [69, 330250]]}, {"verse": 40, "start": 331209, "end": 336721, "text": "Y se recostaron en grupos, de ciento en ciento, y de cincuenta en cincuenta.", "words": [[0, 331209], [2, 331337], [5, 331457], [16, 332217], [19, 332397], [27, 332757], [30, 333187], [37, 333617], [40, 333967], [48, 334317], [50, 334752], [53, 335082], [63, 335412], [66, 336076]]}, {"verse": 41, "start": 337071, "end": 349403, "text": "Y tomados los cinco panes y los dos peces, mirando al cielo, bendijo, y partió los panes, y dio a sus discípulos para que los pusiesen delante: y repartió a todos los dos peces.", "words": [[0, 337071], [2, 337176], [10, 337616], [14, 337836], [20, 338236], [26, 338816], [28, 338936], [32, 339076], [36, 339236], [43, 340196], [51, 340596], [54, 340756], [61, 341096], [70, 342096], [72, 342136], [79, 342616], [83, 342756], [90, 343336], [92, 343656], [96, 343876], [98, 344056], [102, 344236], [113, 344856], [118, 345076], [122, 345216], [126, 345376], [135, 345836], [144, 346756], [146, 346882], [155, 347602], [157, 347822], [163, 348122], [167, 348622], [171, 348822]]}, {"verse": 42, "start": 349753, "end": 352941, "text": "Y comieron todos, y quedaron satisfechos.", "words": [[0, 349753], [2, 349876], [11, 350316], [18, 350796], [20, 351356], [29, 351836]]}, {"verse": 43, "start": 353291, "end": 358094, "text": "Y alzaron de los pedazos doce cestas llenas, y de los peces.", "words": [[0, 353291], [2, 353433], [10, 354053], [13, 354233], [17, 354393], [25, 354993], [30, 355593], [37, 356193], [45, 356793], [47, 357033], [50, 357153], [54, 357293]]}, {"verse": 44, "start": 358444, "end": 361553, "text": "Y los que comieron eran cinco mil hombres.", "words": [[0, 358444], [2, 358688], [6, 358808], [10, 358948], [19, 359508], [24, 359921], [30, 360335], [34, 360748]]}, {"verse": 45, "start": 361903, "end": 372835, "text": "Y luego hizo que sus discípulos subieran de inmediato al barco y fueran delante de él a Betsaida de la otra parte, entre tanto que él despedía la multitud.", "words": [[0, 361903], [2, 362024], [8, 362244], [13, 362824], [17, 363124], [21, 363324], [32, 364084], [41, 364724], [44, 364904], [54, 365544], [57, 365684], [63, 366184], [65, 366564], [72, 367004], [80, 367424], [83, 367624], [86, 367824], [88, 368224], [97, 368624], [100, 368784], [103, 368904], [108, 369104], [115, 369944], [121, 370264], [127, 370664], [131, 370924], [134, 371124], [143, 372004], [146, 372124]]}, {"verse": 46, "start": 373185, "end": 376358, "text": "Y después que los hubo despedido, se fue al monte a orar.", "words": [[0, 373185], [2, 373311], [10, 373611], [14, 373858], [18, 374104], [23, 374351], [34, 374911], [37, 375071], [41, 375251], [44, 375411], [50, 375671], [52, 375851]]}, {"verse": 47, "start": 376708, "end": 381518, "text": "Y como fue la tarde, el barco estaba en medio del mar, y él solo en tierra.", "words": [[0, 376708], [2, 376878], [7, 377098], [11, 377298], [14, 377458], [21, 378038], [24, 378118], [30, 378538], [37, 378838], [40, 379058], [46, 379278], [50, 379518], [55, 379798], [57, 380043], [60, 380203], [65, 380663], [68, 381123]]}, {"verse": 48, "start": 381868, "end": 393909, "text": "Y los vio esforzándose por remar, porque el viento les era contrario: y cerca del cuarto turno de vigilancia nocturna, vino a ellos andando sobre el mar, y quería precederlos.", "words": [[0, 381868], [2, 381991], [6, 382131], [10, 382411], [23, 383371], [27, 383591], [34, 384431], [41, 384831], [44, 384991], [51, 385351], [55, 385531], [59, 385731], [70, 386818], [72, 387079], [78, 387359], [82, 387619], [89, 387939], [95, 388559], [98, 388659], [109, 389319], [119, 390279], [124, 390499], [126, 390699], [132, 390899], [140, 391499], [146, 391799], [149, 392039], [154, 392279], [156, 392644], [163, 392944]]}, {"verse": 49, "start": 394259, "end": 400407, "text": "Y viéndole ellos, que andaba sobre el mar, pensaron que era fantasma, y dieron voces;", "words": [[0, 394259], [2, 394422], [11, 394922], [18, 395322], [22, 395582], [29, 395982], [35, 396302], [38, 396522], [43, 397222], [52, 397682], [56, 397922], [60, 398082], [70, 398922], [72, 399362], [79, 399642]]}, {"verse": 50, "start": 400757, "end": 408671, "text": "Porque todos le veían, y se turbaron. Pero luego habló con ellos, y les dijo: Ánimo; yo soy, no temáis.", "words": [[0, 400757], [7, 400919], [13, 401239], [16, 401479], [23, 402019], [25, 402459], [28, 402579], [38, 403636], [43, 403780], [49, 404100], [55, 404580], [59, 404740], [66, 405000], [68, 405360], [72, 405500], [78, 406570], [85, 407156], [88, 407383], [93, 407663], [96, 408201]]}, {"verse": 51, "start": 409021, "end": 416793, "text": "Y subió a ellos en el barco, y calmó el viento: y ellos en gran manera estaban fuera de sí, y se maravillaban:", "words": [[0, 409021], [2, 409169], [8, 409569], [10, 409709], [16, 409929], [19, 410169], [22, 410309], [29, 410869], [31, 411249], [37, 411709], [40, 411829], [48, 412715], [50, 412861], [56, 413161], [59, 413381], [64, 413581], [71, 413961], [79, 414361], [85, 414681], [88, 414941], [92, 415181], [94, 415601], [97, 415741]]}, {"verse": 52, "start": 417143, "end": 423987, "text": "Porque aún no habían considerado lo de los panes, por cuanto sus corazones estaban endurecidos.", "words": [[0, 417143], [7, 417405], [11, 417865], [14, 418125], [21, 418425], [33, 419325], [36, 419485], [39, 419625], [43, 419745], [50, 420585], [54, 420985], [61, 421265], [65, 421585], [75, 422445], [83, 422805]]}, {"verse": 53, "start": 424337, "end": 429805, "text": "Y cuando estuvieron de la otra parte, vinieron a tierra de Genezaret, y llegaron a la orilla.", "words": [[0, 424337], [2, 424477], [9, 424657], [20, 425197], [23, 425317], [26, 425437], [31, 425597], [38, 426097], [47, 426857], [49, 427017], [56, 427277], [59, 427767], [70, 428257], [72, 428557], [81, 429017], [83, 429137], [86, 429217]]}, {"verse": 54, "start": 430155, "end": 433676, "text": "Y saliendo ellos del barco, luego le conocieron.", "words": [[0, 430155], [2, 430272], [11, 430772], [17, 431032], [21, 431312], [28, 432192], [34, 432492], [37, 432712]]}, {"verse": 55, "start": 434026, "end": 442100, "text": "Y recorriendo toda la tierra de alrededor, comenzaron a traer de todas partes enfermos en lechos, a donde oían que estaba.", "words": [[0, 434026], [2, 434211], [14, 434871], [19, 435111], [22, 435351], [29, 435751], [32, 435951], [43, 436451], [54, 437451], [56, 437631], [62, 438011], [65, 438131], [71, 438351], [78, 438791], [87, 439511], [90, 439691], [98, 440291], [100, 440571], [106, 440791], [111, 441231], [115, 441431]]}, {"verse": 56, "start": 442450, "end": 458171, "text": "Y donde quiera que entraba, en aldeas, o ciudades, o campos, ponían en las calles a los que estaban enfermos, y le rogaban que tocasen siquiera el borde de su vestido; y todos los que le tocaban quedaban sanos.", "words": [[0, 442450], [2, 442682], [8, 442948], [15, 443215], [19, 443495], [28, 444595], [31, 444975], [39, 445775], [41, 446235], [51, 446935], [53, 447075], [61, 447935], [68, 448515], [71, 448695], [75, 448855], [82, 449355], [84, 449475], [88, 449575], [92, 449695], [100, 449975], [110, 450922], [112, 451088], [115, 451255], [123, 451895], [127, 452055], [135, 452675], [144, 453195], [147, 453355], [153, 453735], [156, 453915], [159, 454055], [168, 454993], [170, 455111], [176, 455471], [180, 455991], [184, 456171], [187, 456271], [195, 456851], [204, 457351]]}]}