{"book": "PSA", "chapter": 96, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 93920, "verses": [{"verse": 1, "start": 300, "end": 5378, "text": "Cantad a Jehová canción nueva; cantad a Jehová, toda la tierra.", "words": [[0, 544], [7, 824], [9, 1104], [16, 1384], [24, 1604], [31, 2997], [38, 3297], [40, 3537], [48, 3977], [53, 4237], [56, 4517]]}, {"verse": 2, "start": 5828, "end": 11532, "text": "Cantad a Jehová, bendecid su nombre: anunciad de día en día su salvación.", "words": [[0, 6294], [7, 6794], [9, 7054], [17, 7314], [26, 7574], [29, 7854], [37, 9213], [46, 9573], [49, 9753], [53, 10013], [56, 10193], [60, 10413], [63, 10633]]}, {"verse": 3, "start": 11982, "end": 16922, "text": "Contad entre las naciones su gloria, en todos los pueblos sus maravillas.", "words": [[0, 12254], [7, 12564], [13, 12844], [17, 13064], [26, 13604], [29, 13844], [37, 14384], [40, 14884], [46, 15104], [50, 15344], [58, 15889], [62, 16434]]}, {"verse": 4, "start": 17372, "end": 23872, "text": "Porque grande es Jehová, y digno de suprema alabanza; temible sobre todos los dioses.", "words": [[0, 17372], [7, 17576], [14, 17786], [17, 17996], [25, 19096], [27, 19276], [33, 19896], [36, 20266], [44, 20636], [54, 22038], [62, 22298], [68, 22598], [74, 22898], [78, 23138]]}, {"verse": 5, "start": 24322, "end": 30071, "text": "Porque todos los dioses de los pueblos son ídolos: pero Jehová hizo los cielos.", "words": [[0, 24322], [7, 24547], [13, 24967], [17, 25267], [24, 25727], [27, 25907], [31, 26027], [39, 26467], [43, 26727], [51, 28042], [56, 28244], [63, 28864], [68, 29104], [72, 29324]]}, {"verse": 6, "start": 30521, "end": 36857, "text": "Alabanza y magnificencia delante de él: fortaleza y gloria en su santuario.", "words": [[0, 30797], [9, 31107], [11, 31287], [25, 32307], [33, 32767], [36, 32967], [40, 33699], [50, 34759], [52, 35159], [59, 35739], [62, 35859], [65, 35999]]}, {"verse": 7, "start": 37307, "end": 43268, "text": "Dad a Jehová, oh familias de los pueblos, dad a Jehová la gloria y la fortaleza.", "words": [[0, 37307], [4, 37612], [6, 37912], [14, 38252], [17, 38592], [26, 39192], [29, 39312], [33, 39412], [42, 40352], [46, 40812], [48, 41092], [55, 41492], [58, 41572], [65, 42012], [67, 42152], [70, 42292]]}, {"verse": 8, "start": 43718, "end": 49997, "text": "Dad a Jehová la honra debida a su nombre: tomad ofrendas, y venid a sus atrios.", "words": [[0, 43800], [4, 43914], [6, 44027], [13, 44507], [16, 44627], [22, 45167], [29, 45707], [31, 45927], [34, 46027], [42, 47217], [48, 47407], [58, 48167], [60, 48467], [66, 48887], [68, 49047], [72, 49167]]}, {"verse": 9, "start": 50447, "end": 57518, "text": "Encorvaos a Jehová en la hermosura de su santuario: temed delante de él, toda la tierra.", "words": [[0, 50930], [10, 51450], [12, 51590], [19, 52070], [22, 52210], [25, 52600], [35, 52990], [38, 53130], [41, 53290], [52, 54625], [58, 54825], [66, 55445], [69, 55645], [73, 55845], [78, 56525], [81, 56825]]}, {"verse": 10, "start": 57968, "end": 67862, "text": "Decid entre las naciones: Jehová reinó, también afirmó el mundo, no será conmovido: juzgará a los pueblos en justicia.", "words": [[0, 57968], [6, 58533], [12, 58933], [16, 59153], [26, 60301], [33, 61126], [40, 61986], [48, 62186], [55, 62766], [58, 62866], [65, 63626], [68, 63766], [73, 64006], [84, 65229], [92, 65873], [94, 65953], [98, 66113], [106, 66693], [109, 66833]]}, {"verse": 11, "start": 68312, "end": 74635, "text": "Alégrense los cielos, y gócese la tierra: brame el mar y su plenitud.", "words": [[0, 68760], [10, 69220], [14, 69380], [22, 70020], [24, 70420], [31, 70820], [34, 70960], [42, 72059], [48, 72488], [51, 72668], [55, 73048], [57, 73488], [60, 73668]]}, {"verse": 12, "start": 75085, "end": 84186, "text": "Regocíjese el campo, y todo lo que en él está: entonces todos los árboles del bosque rebosarán de contento,", "words": [[0, 75509], [11, 75969], [14, 76229], [21, 76729], [23, 77289], [28, 77529], [31, 77789], [