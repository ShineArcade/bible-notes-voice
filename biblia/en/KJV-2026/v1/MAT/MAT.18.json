{"book": "MAT", "chapter": 18, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 271228, "verses": [{"verse": 1, "start": 300, "end": 6410, "text": "At the same time came the disciples to Jesus, saying, Who is the greatest in the kingdom of heaven?", "words": [[0, 300], [3, 427], [7, 547], [12, 827], [17, 1167], [22, 1427], [26, 1627], [36, 2107], [39, 2387], [46, 2767], [54, 4513], [58, 4639], [61, 4759], [65, 4899], [74, 5279], [77, 5499], [81, 5599], [89, 5839], [92, 6079]]}, {"verse": 2, "start": 6760, "end": 10645, "text": "And Jesus called a little child to him, and set him in the midst of them,", "words": [[0, 6760], [4, 6904], [10, 7184], [17, 7604], [19, 7804], [26, 7984], [32, 8344], [35, 8624], [40, 8824], [44, 9204], [48, 9464], [52, 9624], [55, 9764], [59, 9844], [65, 10064], [68, 10264]]}, {"verse": 3, "start": 11095, "end": 19521, "text": "And said, Assuredly I say to you, Unless you be converted, and become as little children, you shall not enter into the kingdom of heaven.", "words": [[0, 11095], [4, 11240], [10, 11953], [20, 12538], [22, 12698], [26, 12898], [29, 13078], [34, 13718], [41, 14018], [45, 14258], [48, 14378], [59, 14838], [63, 15338], [70, 15638], [73, 15878], [80, 16098], [90, 16878], [94, 17218], [100, 17438], [104, 17638], [110, 18038], [115, 18298], [119, 18458], [127, 18758], [130, 19018]]}, {"verse": 4, "start": 19971, "end": 25964, "text": "Whoever therefore shall humble himself as this little child, the same is greatest in the kingdom of heaven.", "words": [[0, 19971], [8, 20211], [18, 20811], [24, 21151], [31, 21451], [39, 21831], [42, 22311], [47, 22531], [54, 22791], [61, 23631], [65, 23731], [70, 23991], [73, 24211], [82, 24531], [85, 24831], [89, 24931], [97, 25211], [100, 25511]]}, {"verse": 5, "start": 26414, "end": 30220, "text": "And whoever shall receive one such little child in my name receives me.", "words": [[0, 26414], [4, 26556], [12, 26756], [18, 27116], [26, 27476], [30, 27756], [35, 27996], [42, 28236], [48, 28556], [51, 28756], [54, 28956], [59, 29276], [68, 29696]]}, {"verse": 6, "start": 30670, "end": 40696, "text": "But whoever shall offend one of these little ones which believe in me, it were better for him that a millstone were hanged about his neck, and that he were drowned in the depth of the sea.", "words": [[0, 30670], [4, 30792], [12, 31112], [18, 31472], [25, 31872], [29, 32172], [32, 32332], [38, 32552], [45, 32912], [50, 33272], [56, 33532], [64, 33892], [67, 34112], [71, 34812], [74, 34912], [79, 35052], [86, 35312], [90, 35552], [94, 35752], [99, 35992], [101, 36112], [111, 36612], [116, 36832], [123, 37212], [129, 37332], [133, 37512], [139, 38219], [143, 38321], [148, 38441], [151, 38581], [156, 38721], [164, 39121], [167, 39441], [171, 39541], [177, 39901], [180, 40101], [184, 40241]]}, {"verse": 7, "start": 41146, "end": 49179, "text": "¶ Woe to the world because of offences! for it must needs be that offences come; but woe to that man by whom the offence comes!", "words": [[2, 41146], [6, 41491], [9, 41571], [13, 41671], [19, 41971], [27, 42311], [30, 42781], [40, 43489], [44, 43607], [47, 43727], [52, 43887], [58, 44247], [61, 44527], [66, 44827], [75, 45127], [81, 46157], [85, 46283], [89, 46683], [92, 46783], [97, 47003], [101, 47303], [104, 47563], [109, 47823], [113, 48103], [121, 48383]]}, {"verse": 8, "start": 49629, "end": 62176, "text": "Therefore if your hand or your foot offend you, cut them off, and cast them from you: it is better for you to enter into life lame or maimed, rather than having two hands or two feet to be cast into everlasting fire.", "words": [[0, 49629], [10, 50226], [13, 50386], [18, 50526], [23, 50986], [26, 51206], [31, 51386], [36, 51686], [43, 52086], [48, 52706], [52, 52866], [57, 53106], [62, 53366], [66, 53666], [71, 54026], [76, 54306], [81, 54566], [86, 55236], [89, 55333], [92, 55433], [99, 55653], [103, 55853], [107, 55993], [110, 56053], [116, 56313], [121, 56533], [126, 56833], [131, 57213], [134, 57433], [142, 57973], [149, 58373], [154, 58613], [161, 58813], [165, 59093], [171, 59473], [174, 59653], [178, 59853], [183, 60173], [186, 60333], [189, 60473], [194, 60733], [199, 61013], [211, 61393]]}, {"verse": 9, "start": 62626, "end": 72548, "text": "And if your eye offend you, pluck it out, and cast it from you: it is better for you to enter into life with one eye, rather than having two eyes to be cast into hell fire.", "words": [[0, 62626], [4, 62752], [7, 62892], [12, 63012], [16, 63332], [23, 63712], [28, 64332], [34, 64492], [37, 64632], [42, 64872], [46, 65212], [51, 65532], [54, 65712], [59, 65912], [64, 66508], [67, 66628], [70, 66768], [77, 67008], [81, 67268], [85, 67428], [88, 67508], [94, 67828], [99, 68068], [104, 68368], [109, 68608], [113, 68848], [118, 69208], [125, 69728], [130, 69968], [137, 70208], [141, 70468], [146, 70808], [149, 71008], [152, 71168], [157, 71468], [162, 71828], [167, 72188]]}, {"verse": 10, "start": 72998, "end": 82652, "text": "Take heed that you despise not one of these little ones; for I say to you, That in heaven their angels do always behold the face of my Father which is in heaven.", "words": [[0, 72998], [5, 73143], [10, 73503], [15, 73723], [19, 73823], [27, 74443], [31, 74603], [35, 74843], [38, 74943], [44, 75103], [51, 75383], [57, 76214], [61, 76324], [63, 76544], [67, 76824], [70, 77084], [75, 77624], [80, 77884], [83, 78044], [90, 78364], [96, 78664], [103, 79164], [106, 79444], [113, 79884], [120, 80284], [124, 80524], [129, 80824], [132, 80984], [135, 81164], [142, 81544], [148, 81864], [151, 82004], [154, 82164]]}, {"verse": 11, "start": 83102, "end": 86676, "text": "For the Son of man is come to save that which was lost.", "words": [[0, 83102], [4, 83218], [8, 83338], [12, 83618], [15, 83758], [19, 84118], [22, 84398], [27, 84638], [30, 84838], [35, 85218], [40, 85598], [46, 85858], [50, 86058]]}, {"verse": 12, "start": 87126, "end": 98427, "text": "How do you think? if a man have a hundred sheep, and one of them be gone astray, does he not leave the ninety and nine, and goes into the mountains, and seeks that which is gone astray?", "words": [[0, 87126], [4, 87291], [7, 87431], [11, 87531], [18, 88341], [21, 88477], [23, 88597], [27, 88837], [32, 89057], [34, 89197], [42, 89457], [49, 89857], [53, 90377], [57, 90597], [60, 90717], [65, 90897], [68, 91057], [73, 91297], [81, 92277], [86, 92377], [89, 92557], [93, 92737], [99, 93037], [103, 93237], [110, 93557], [114, 93737], [120, 94057], [124, 94577], [129, 94837], [134, 95157], [138, 95317], [149, 96287], [153, 96507], [159, 96827], [164, 97127], [170, 97307], [173, 97487], [178, 97707]]}, {"verse": 13, "start": 98877, "end": 106893, "text": "And if so be that he find it, indeed I say to you, he rejoices more of that sheep, than of the ninety and nine which went not astray.", "words": [[0, 98877], [4, 99038], [7, 99158], [10, 99398], [13, 99618], [18, 99838], [21, 99958], [26, 100278], [30, 100758], [37, 101058], [39, 101358], [43, 101558], [46, 101758], [51, 102378], [54, 102518], [63, 103098], [68, 103378], [71, 103518], [76, 103678], [83, 103998], [88, 104518], [91, 104678], [95, 104758], [102, 105058], [106, 105258], [111, 105538], [117, 105818], [122, 106018], [126, 106238]]}, {"verse": 14, "start": 107343, "end": 113104, "text": "Even so it is not the will of your Father which is in heaven, that one of these little ones should perish.", "words": [[0, 107343], [5, 107546], [8, 108126], [11, 108146], [14, 108286], [18, 108486], [22, 108666], [27, 108866], [30, 109006], [35, 109126], [42, 109526], [48, 109806], [51, 109946], [54, 110086], [62, 110366], [67, 110966], [71, 111226], [74, 111326], [80, 111486], [87, 111806], [92, 112126], [99, 112386]]}, {"verse": 15, "start": 113554, "end": 122757, "text": "¶ Moreover if your brother shall trespass against you, go and tell him his fault between you and him alone: if he shall hear you, you have gained your brother.", "words": [[2, 113554], [11, 114313], [14, 114433], [19, 114573], [27, 114873], [33, 115113], [42, 115753], [50, 116033], [55, 116773], [58, 116973], [62, 117193], [67, 117353], [71, 117613], [75, 117813], [81, 118093], [89, 118473], [93, 118853], [97, 119133], [101, 119293], [108, 120171], [111, 120307], [114, 120467], [120, 120687], [125, 120987], [130, 121427], [134, 121667], [139, 121807], [146, 122087], [151, 122287]]}, {"verse": 16, "start": 123207, "end": 131569, "text": "But if he will not hear you, then take with you one or two more, that in the mouth of two or three witnesses every word may be established.", "words": [[0, 123207], [4, 123349], [7, 123589], [10, 123709], [15, 123809], [19, 123989], [24, 124289], [29, 124989], [34, 125209], [39, 125489], [44, 125689], [48, 125909], [52, 126229], [55, 126529], [59, 126769], [65, 127389], [70, 127669], [73, 127789], [77, 127889], [83, 128169], [86, 128389], [90, 128649], [93, 128729], [99, 128969], [109, 129729], [115, 129969], [120, 130349], [124, 130589], [127, 130709]]}, {"verse": 17, "start": 132019, "end": 140353, "text": "And if he shall neglect to hear them, tell it to the church: but if he neglect to hear the church, let him be to you as a heathen man and a tax collector.", "words": [[0, 132019], [4, 132157], [7, 132297], [10, 132417], [16, 132597], [24, 132897], [27, 133157], [32, 133357], [38, 134077], [43, 134257], [46, 134377], [49, 134497], [53, 134617], [61, 135443], [65, 135545], [68, 135665], [71, 135745], [79, 136005], [82, 136265], [87, 136385], [91, 136525], [99, 137165], [103, 137345], [107, 137485], [110, 137645], [113, 137805], [117, 138025], [120, 138265], [122, 138385], [130, 138765], [134, 139125], [138, 139365], [140, 139545], [144, 139745]]}, {"verse": 18, "start": 140803, "end": 148900, "text": "Assuredly I say to you, Whatever you shall bind on earth shall be bound in heaven: and whatever you shall loose on earth shall be loosed in heaven.", "words": [[0, 140803], [10, 141446], [12, 141606], [16, 141826], [19, 142006], [24, 142666], [33, 142966], [37, 143206], [43, 143406], [48, 143666], [51, 143866], [57, 144146], [63, 144486], [66, 144626], [72, 144926], [75, 145166], [83, 145949], [87, 146052], [96, 146312], [100, 146512], [106, 146712], [112, 146992], [115, 147192], [121, 147452], [127, 147772], [130, 147912], [137, 148292], [140, 148412]]}, {"verse": 19, "start": 149350, "end": 158619, "text": "Again I say to you, That if two of you shall agree on earth as touching any thing that they shall ask, it shall be done for them of my Father which is in heaven.", "words": [[0, 149350], [6, 149642], [8, 149882], [12, 150102], [15, 150282], [20, 150562], [25, 151142], [28, 151302], [32, 151562], [35, 151702], [39, 151882], [45, 152102], [51, 152422], [54, 152702], [60, 153002], [63, 153242], [72, 153495], [76, 153749], [82, 154002], [87, 154422], [92, 154562], [98, 154762], [103, 155642], [106, 155761], [112, 155981], [115, 156141], [120, 156401], [124, 156601], [129, 156781], [132, 156981], [135, 157161], [142, 157541], [148, 157841], [151, 157981], [154, 158141]]}, {"verse": 20, "start": 159069, "end": 163746, "text": "For where two or three are gathered together in my name, there am I in the midst of them.", "words": [[0, 159069], [4, 159369], [10, 159589], [14, 159869], [17, 160049], [23, 160329], [27, 160489], [36, 160809], [45, 161149], [48, 161369], [51, 161529], [57, 162209], [63, 162369], [66, 162549], [68, 162789], [71, 162909], [75, 163009], [81, 163209], [84, 163409]]}, {"verse": 21, "start": 164096, "end": 171045, "text": "¶ Then came Peter to him, and said, Lord, how often shall my brother sin against me, and I forgive him? till seven times?", "words": [[2, 164096], [7, 164314], [12, 164594], [18, 164894], [21, 165134], [26, 165354], [30, 165574], [36, 166288], [42, 166670], [46, 166770], [52, 167130], [58, 167370], [61, 167550], [69, 167790], [73, 168110], [81, 168370], [85, 168930], [89, 169030], [91, 169130], [99, 169370], [104, 170081], [109, 170238], [115, 170438]]}, {"verse": 22, "start": 171395, "end": 179050, "text": "Jesus says to him, I say not to you, Until seven times: but, Until seventy times seven.", "words": [[0, 171395], [6, 171650], [11, 171990], [14, 172230], [19, 173575], [21, 173773], [25, 173993], [29, 174213], [32, 174453], [37, 175053], [43, 175393], [49, 175773], [56, 176773], [61, 177034], [67, 177554], [75, 178074], [81, 178594]]}, {"verse": 23, "start": 179500, "end": 185054, "text": "¶ Therefore is the kingdom of heaven likened to a certain king, which would take account of his servants.", "words": [[2, 179500], [12, 179899], [15, 180219], [19, 180339], [27, 180639], [30, 180899], [37, 181179], [45, 181779], [48, 181899], [50, 182039], [58, 182279], [64, 182999], [70, 183299], [76, 183479], [81, 183699], [89, 184059], [92, 184239], [96, 184359]]}, {"verse": 24, "start": 185504, "end": 191351, "text": "And when he had begun to reckon, one was brought to him, which owed him ten thousand talents.", "words": [[0, 185504], [4, 185765], [9, 186025], [12, 186205], [16, 186365], [22, 186645], [25, 186845], [33, 187605], [37, 187885], [41, 188145], [49, 188365], [52, 188605], [57, 189085], [63, 189365], [68, 189605], [72, 189965], [76, 190325], [85, 190685]]}, {"verse": 25, "start": 191801, "end": 200217, "text": "But since he had not to pay, his lord commanded him to be sold, and his wife, and children, and all that he had, and payment to be made.", "words": [[0, 191801], [4, 191904], [10, 192144], [13, 192364], [17, 192484], [21, 192664], [24, 192844], [29, 193604], [33, 193744], [38, 194024], [48, 194504], [52, 194724], [55, 194864], [58, 194984], [64, 195784], [68, 195964], [72, 196144], [78, 196464], [82, 196944], [92, 197724], [96, 197984], [100, 198164], [105, 198324], [108, 198484], [113, 199064], [117, 199144], [125, 199424], [128, 199684], [131, 199804]]}, {"verse": 26, "start": 200667, "end": 206990, "text": "The servant therefore fell down, and worshipped him, saying, Lord, have patience with me, and I will pay you all.", "words": [[0, 200667], [4, 200774], [12, 201074], [22, 201414], [27, 201754], [33, 202134], [37, 202584], [48, 203034], [53, 203254], [61, 203854], [67, 204554], [72, 204694], [81, 205134], [86, 205414], [90, 205754], [94, 205834], [96, 206014], [101, 206154], [105, 206354], [109, 206554]]}, {"verse": 27, "start": 207440, "end": 212408, "text": "Then the lord of that servant was moved with compassion, and loosed him, and forgave him the debt.", "words": [[0, 207440], [5, 207658], [9, 207838], [14, 208038], [17, 208158], [22, 208338], [30, 208678], [34, 208938], [40, 209298], [45, 209498], [57, 210038], [61, 210518], [68, 210898], [73, 211038], [77, 211378], [85, 211798], [89, 211898], [93, 212018]]}, {"verse": 28, "start": 212858, "end": 223596, "text": "But the same servant went out, and found one of his fellowservants, which owed him a hundred denarii: and he laid hands on him, and took him by the throat, saying, Pay me that you owe.", "words": [[0, 212858], [4, 212962], [8, 213082], [13, 213382], [21, 213782], [26, 214062], [31, 214342], [35, 214862], [41, 215162], [45, 215422], [48, 215522], [52, 216082], [68, 216642], [74, 216902], [79, 217142], [83, 217342], [85, 217482], [93, 218042], [102, 218853], [106, 218953], [109, 219073], [114, 219273], [120, 219653], [123, 219893], [128, 220113], [132, 220513], [137, 220733], [141, 220893], [144, 221073], [148, 221213], [156, 221493], [164, 222273], [168, 222593], [171, 222773], [176, 222973], [180, 223153]]}, {"verse": 29, "start": 224046, "end": 230672, "text": "And his fellowservant fell down at his feet, and besought him, saying, Have patience with me, and I will pay you all.", "words": [[0, 224046], [4, 224168], [8, 224598], [22, 225028], [27, 225328], [32, 225648], [35, 225788], [39, 225928], [45, 226708], [49, 226768], [58, 227168], [63, 227428], [71, 228068], [76, 228268], [85, 228668], [90, 228908], [94, 229488], [98, 229588], [100, 229748], [105, 229868], [109, 230068], [113, 230248]]}, {"verse": 30, "start": 231122, "end": 235549, "text": "And he would not: but went and cast him into prison, till he should pay the debt.", "words": [[0, 231122], [4, 231264], [7, 231404], [13, 231584], [18, 232344], [22, 232485], [27, 232685], [31, 232885], [36, 233145], [40, 233365], [45, 233485], [53, 233885], [58, 234445], [61, 234625], [68, 234765], [72, 234985], [76, 235125]]}, {"verse": 31, "start": 235999, "end": 242242, "text": "So when his fellowservants saw what was done, they were very sorry, and came and told to their lord all that was done.", "words": [[0, 235999], [3, 236134], [8, 236294], [12, 236704], [27, 237114], [31, 237414], [36, 237594], [40, 237754], [46, 238434], [51, 238554], [56, 238674], [61, 238914], [68, 239594], [72, 239794], [77, 240074], [81, 240294], [86, 240514], [89, 240734], [95, 240874], [100, 241154], [104, 241474], [109, 241634], [113, 241814]]}, {"verse": 32, "start": 242692, "end": 251193, "text": "Then his lord, after that he had called him, said to him, O you wicked servant, I forgave you all that debt, because you desired me:", "words": [[0, 242692], [5, 242964], [9, 243184], [15, 243464], [21, 243824], [26, 244064], [29, 244284], [33, 244404], [40, 244684], [45, 245284], [50, 245464], [53, 245684], [58, 246404], [60, 246604], [64, 246884], [71, 247204], [80, 247984], [82, 248084], [90, 248604], [94, 248724], [98, 248984], [103, 249204], [109, 249824], [117, 250064], [121, 250284], [129, 250664]]}, {"verse": 33, "start": 251643, "end": 256557, "text": "Should you not also have had compassion on your fellowservant, even as I had pity on you?", "words": [[0, 251718], [7, 251798], [11, 251918], [15, 252078], [20, 252418], [25, 252638], [29, 252838], [40, 253378], [43, 253658], [48, 254288], [63, 254918], [68, 255138], [71, 255378], [73, 255518], [77, 255698], [82, 255918], [85, 256238]]}, {"verse": 34, "start": 257007, "end": 262868, "text": "And his lord was angry, and delivered him to the tormentors, till he should pay all that was due to him.", "words": [[0, 257007], [4, 257132], [8, 257272], [13, 257552], [17, 257792], [24, 258212], [28, 258732], [38, 259052], [42, 259312], [45, 259452], [49, 259592], [61, 260612], [66, 260852], [69, 261032], [76, 261192], [80, 261412], [84, 261732], [89, 261892], [93, 262072], [97, 262252], [100, 262432]]}, {"verse": 35, "start": 263318, "end": 270828, "text": "So likewise shall my heavenly Father do also to you, if you from your hearts forgive not every one his brother their trespasses.", "words": [[0, 263318], [3, 263466], [12, 263906], [18, 264326], [21, 264506], [30, 264866], [37, 265266], [40, 265546], [45, 265906], [48, 266166], [53, 266726], [56, 266906], [60, 267086], [65, 267286], [70, 267426], [77, 267746], [85, 268106], [89, 268466], [95, 268726], [99, 269066], [103, 269366], [111, 269666], [117, 269886]]}]}