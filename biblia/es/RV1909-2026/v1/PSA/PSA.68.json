{"book": "PSA", "chapter": 68, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 270326, "verses": [{"verse": 1, "start": 300, "end": 11092, "text": "Al Músico principal: Salmo de David: Canción. LEVÁNTESE Dios, sean esparcidos sus enemigos, y huyan de su presencia los que le aborrecen.", "words": [[0, 300], [3, 471], [10, 971], [21, 2066], [27, 2563], [30, 2723], [37, 3498], [46, 4411], [56, 5019], [62, 5839], [67, 6039], [78, 6819], [82, 7059], [92, 7739], [94, 8099], [100, 8479], [103, 8619], [106, 8759], [116, 9499], [120, 9959], [124, 10099], [127, 10239]]}, {"verse": 2, "start": 11442, "end": 21359, "text": "Como es lanzado el humo, los lanzarás: como se derrite la cera delante del fuego, así perecerán los impíos delante de Dios.", "words": [[0, 11442], [5, 11832], [8, 12012], [16, 12752], [19, 12912], [25, 13712], [29, 13952], [39, 15202], [44, 15366], [47, 15716], [55, 16066], [58, 16286], [63, 16606], [71, 17026], [75, 17246], [82, 18086], [86, 18466], [96, 19206], [100, 19366], [107, 20106], [115, 20566], [118, 20726]]}, {"verse": 3, "start": 21709, "end": 27807, "text": "Mas los justos se alegrarán: se gozarán delante de Dios, y saltarán de alegría.", "words": [[0, 21709], [4, 21984], [8, 22290], [15, 22597], [18, 22937], [29, 24059], [32, 24319], [40, 24839], [48, 25239], [51, 25399], [57, 25699], [59, 26299], [68, 26939], [71, 27039]]}, {"verse": 4, "start": 28157, "end": 38118, "text": "Cantad a Dios, cantad salmos a su nombre: exaltad al que sube sobre los cielos en JAH su nombre, y alegraos delante de él.", "words": [[0, 28157], [7, 28725], [9, 28845], [15, 29605], [22, 30065], [29, 30685], [31, 30885], [34, 31045], [42, 31847], [50, 32732], [53, 32932], [57, 33092], [62, 33512], [68, 33772], [72, 34012], [79, 34492], [82, 34712], [86, 34932], [89, 35152], [97, 35592], [99, 36252], [108, 36912], [116, 37532], [119, 37732]]}, {"verse": 5, "start": 38468, "end": 44882, "text": "Padre de huérfanos y defensor de viudas, es Dios en la morada de su santuario:", "words": [[0, 38468], [6, 38893], [9, 39033], [19, 39813], [21, 39953], [30, 40553], [33, 40753], [41, 41373], [44, 42073], [49, 42573], [52, 42973], [55, 43113], [62, 43553], [65, 43733], [68, 43893]]}, {"verse": 6, "start": 45232, "end": 54242, "text": "El Dios que hace habitar en familia los solos; que saca a los aprisionados con grillos: mas los rebeldes habitan en sequedad.", "words": [[0, 45232], [3, 45512], [8, 45812], [12, 46072], [17, 46422], [25, 46772], [28, 47012], [36, 47452], [40, 47672], [47, 48594], [51, 48676], [56, 49176], [58, 49216], [62, 49356], [75, 50116], [79, 50336], [88, 51323], [92, 51729], [96, 52109], [105, 52809], [113, 53369], [116, 53831]]}, {"verse": 7, "start": 54592, "end": 60432, "text": "Oh Dios, cuando tú saliste delante de tu pueblo, cuando anduviste por el desierto, (Selah,)", "words": [[0, 54642], [3, 54722], [9, 54962], [16, 55302], [19, 55722], [27, 56342], [35, 56862], [38, 57042], [41, 57162], [49, 57662], [56, 57862], [66, 58422], [70, 58662], [73, 58782], [83, 59636]]}, {"verse": 8, "start": 60782, "end": 70574, "text": "La tierra tembló; también destilaron los cielos a la presencia de Dios: aquel Sinaí tembló delante de Dios, del Dios de Israel.", "words": [[0, 60782], [3, 60908], [10, 61188], [18, 62248], [26, 62712], [37, 63472], [41, 63612], [48, 64212], [50, 64412], [53, 64512], [63, 65212], [66, 65412], [72, 66172], [78, 66559], [84, 67159], [91, 67779], [99, 68279], [102, 68459], [108, 69139], [112, 69399], [117, 69679], [120, 69859]]}, {"verse": 9, "start": 70924, "end": 78407, "text": "Abundante lluvia esparciste, oh Dios, a tu heredad; y cuando se cansó, tú la recreaste.", "words": [[0, 70924], [10, 71511], [17, 72011], [29, 72561], [32, 73111], [38, 73371], [40, 73851], [43, 74011], [52, 74916], [54, 75022], [61, 75242], [64, 75462], [71, 76622], [74, 77022], [77, 77342]]}, {"verse": 10, "start": 78757, "end": 84601, "text": "Los que son de tu grey han morado en ella: por tu bondad, oh Dios, has provisto al pobre.", "words": [[0, 78793], [4, 78863], [8, 79003], [12, 79243], [15, 79403], [18, 79563], [23, 80063], [27, 80303], [34, 80823], [37, 81003], [43, 81708], [47, 81852], [50, 82012], [58, 82362], [61, 82712], [67, 82972], [71, 83332], [80, 83832], [83, 83992]]}, {"verse": 11, "start": 84951, "end": 90348, "text": "El Señor daba palabra: de las que anunciaban las buenas nuevas había grande ejército.", "words": [[0, 84951], [3, 85079], [9, 85379], [14, 85739], [23, 86686], [26, 86851], [30, 86970], [34, 87110], [45, 87750], [49, 87931], [56, 88190], [63, 88511], [69, 89142], [76, 89772]]}, {"verse": 12, "start": 90698, "end": 97253, "text": "Huyeron, huyeron reyes de ejércitos; y las que se quedaban en casa repartían los despojos.", "words": [[0, 90698], [9, 91424], [17, 91851], [23, 92277], [26, 92704], [37, 94164], [39, 94273], [43, 94373], [47, 94513], [50, 94653], [59, 95113], [62, 95233], [67, 95553], [77, 96333], [81, 96793]]}, {"verse": 13, "start": 97603, "end": 106431, "text": "Bien que fuisteis echados entre los tiestos, seréis como las alas de la paloma cubierta de plata, y sus plumas con amarillez de oro.", "words": [[0, 97603], [5, 97827], [9, 98027], [18, 98727], [26, 99287], [32, 99607], [36, 99847], [45, 100647], [52, 101127], [57, 101387], [61, 101627], [66, 102107], [69, 102227], [72, 102327], [79, 102687], [88, 103307], [91, 103427], [98, 103807], [100, 104247], [104, 104427], [111, 104962], [115, 105392], [125, 105822], [128, 106062]]}, {"verse": 14, "start": 106781, "end": 112260, "text": "Cuando esparció el Omnipotente los reyes en ella, se emblanqueció esta como la nieve en Salmón.", "words": [[0, 106781], [7, 107005], [16, 107605], [19, 107785], [31, 108485], [35, 108665], [41, 109013], [44, 109362], [50, 109710], [53, 110130], [66, 110550], [71, 110730], [76, 111010], [79, 111150], [85, 111470], [88, 111590]]}, {"verse": 15, "start": 112610, "end": 116851, "text": "Monte de Dios es el monte de Basán; monte alto el de Basán.", "words": [[0, 112610], [6, 112895], [9, 113115], [14, 113395], [17, 113735], [20, 113895], [26, 114175], [29, 114355], [36, 115008], [42, 115448], [47, 115968], [50, 116048], [53, 116168]]}, {"verse": 16, "start": 117201, "end": 126456, "text": "¿Por qué os levantáis, oh montes altos? Este monte amó Dios para su asiento; ciertamente Jehová habitará en él para siempre.", "words": [[0, 117201], [5, 117343], [9, 117523], [12, 117623], [23, 118323], [26, 119023], [33, 119543], [40, 120481], [45, 120687], [51, 121027], [55, 121407], [60, 121587], [65, 121927], [68, 122087], [77, 122986], [89, 123792], [96, 124312], [105, 124972], [108, 125212], [111, 125392], [116, 125672]]}, {"verse": 17, "start": 126806, "end": 136687, "text": "Los carros de Dios son veinte mil, y más millares de ángeles. El Señor entre ellos, como en Sinaí, así en el santuario.", "words": [[0, 126806], [4, 127081], [11, 127391], [14, 127511], [19, 127771], [23, 128398], [30, 129024], [35, 129651], [37, 129851], [41, 130031], [50, 130591], [53, 130811], [62, 131840], [65, 132000], [71, 132280], [77, 132640], [84, 133140], [89, 133740], [92, 134000], [99, 134980], [103, 135220], [106, 135560], [109, 135700]]}, {"verse": 18, "start": 137037, "end": 147196, "text": "Subiste a lo alto, cautivaste la cautividad, tomaste dones para los hombres, y también para los rebeldes, para que habite entre ellos JAH Dios.", "words": [[0, 137037], [8, 137638], [10, 137818], [13, 137938], [19, 138798], [30, 139658], [33, 139818], [45, 140638], [53, 141458], [59, 141938], [64, 142138], [68, 142338], [77, 142778], [79, 143278], [87, 143578], [92, 143818], [96, 144038], [106, 144898], [111, 145078], [115, 145238], [122, 145538], [128, 145778], [134, 146251], [138, 146724]]}, {"verse": 19, "start": 147546, "end": 156720, "text": "Bendito el Señor; cada día nos colma de beneficios el Dios de nuestra salvación. (Selah.)", "words": [[0, 147546], [8, 148054], [11, 148194], [18, 148977], [23, 149162], [27, 149442], [31, 149622], [37, 150122], [40, 150282], [51, 151022], [54, 151222], [59, 151462], [62, 151662], [70, 151842], [81, 155442]]}, {"verse": 20, "start": 157070, "end": 160283, "text": "Dios, nuestro Dios ha de salvarnos; y de Dios Jehová es el librar de la muerte.", "words": [[0, 157472], [6, 157618], [14, 157764], [19, 157909], [22, 158055], [25, 158201], [36, 158509], [38, 158509], [41, 158509], [46, 158509], [53, 158509], [56, 158692], [59, 158872], [66, 159372], [69, 159472], [72, 159612]]}, {"verse": 21, "start": 160633, "end": 167282, "text": "Ciertamente Dios herirá la cabeza de sus enemigos, la cabelluda mollera del que camina en sus pecados.", "words": [[0, 160633], [12, 161395], [17, 161675], [24, 162315], [27, 162455], [34, 162815], [37, 163015], [41, 163175], [51, 164135], [54, 164375], [64, 164925], [72, 165475], [76, 165655], [80, 165855], [87, 166315], [90, 166395], [94, 166555]]}, {"verse": 22, "start": 167632, "end": 172692, "text": "El Señor dijo: De Basán haré volver, te haré volver de los profundos del mar:", "words": [[0, 167632], [3, 167778], [9, 168078], [15, 168882], [18, 168942], [24, 169442], [29, 169942], [37, 170442], [40, 170702], [45, 170922], [52, 171202], [55, 171462], [59, 171602], [69, 172182], [73, 172422]]}, {"verse": 23, "start": 173326, "end": 178807, "text": "Porque tu pie se enrojecerá de sangre de tus enemigos, y de ella la lengua de tus perros.", "words": [[0, 173326], [7, 173527], [10, 173707], [14, 174027], [17, 174347], [28, 175007], [31, 175087], [38, 175487], [41, 175707], [45, 175827], [55, 176427], [57, 176867], [60, 176987], [65, 177287], [68, 177487], [75, 177847], [78, 177927], [82, 178107]]}, {"verse": 24, "start": 179322, "end": 185471, "text": "Vieron tus caminos, oh Dios; los caminos de mi Dios, de mi Rey, en el santuario.", "words": [[0, 179322], [7, 179707], [11, 179907], [20, 180607], [23, 180867], [29, 181743], [33, 181846], [41, 182306], [44, 182486], [47, 182586], [53, 183566], [56, 183626], [59, 183766], [64, 184366], [67, 184506], [70, 184646]]}, {"verse": 25, "start": 185821, "end": 192779, "text": "Los cantores iban delante, los músicos detrás; en medio, las doncellas con panderos.", "words": [[0, 185821], [4, 186081], [13, 186741], [18, 187261], [27, 188341], [31, 188441], [39, 188961], [47, 190038], [50, 190163], [57, 190583], [61, 191063], [71, 191703], [75, 191883]]}, {"verse": 26, "start": 193129, "end": 199584, "text": "Bendecid a Dios en congregaciones: al Señor, vosotros de la estirpe de Israel.", "words": [[0, 193529], [9, 193929], [11, 194149], [16, 194369], [19, 194669], [35, 196235], [38, 196481], [45, 196821], [54, 197601], [57, 198016], [60, 198136], [68, 198616], [71, 198736]]}, {"verse": 27, "start": 199934, "end": 209656, "text": "Allí estaba el joven Benjamín gobernante de ellos, los príncipes de Judá en su congregación, los príncipes de Zabulón, los príncipes de Neftalí.", "words": [[0, 199934], [5, 200374], [12, 200674], [15, 200894], [21, 201334], [30, 201974], [41, 202654], [44, 202814], [51, 203474], [55, 203714], [65, 204354], [68, 204454], [73, 204794], [76, 204934], [79, 205094], [93, 206374], [97, 206454], [107, 207014], [110, 207574], [119, 208134], [123, 208214], [133, 208814], [136, 208934]]}, {"verse": 28, "start": 210006, "end": 216010, "text": "Tu Dios ha ordenado tu fuerza; confirma, oh Dios, lo que has hecho en nosotros.", "words": [[0, 210006], [3, 210108], [8, 210428], [11, 210788], [20, 211308], [23, 211468], [31, 212423], [41, 212857], [44, 213327], [50, 213747], [53, 214062], [57, 214222], [61, 214402], [67, 214682], [70, 214862]]}, {"verse": 29, "start": 216360, "end": 221287, "text": "Por razón de tu templo en Jerusalén los reyes te ofrecerán dones.", "words": [[0, 216360], [4, 216501], [10, 216881], [13, 217181], [16, 217341], [23, 217881], [26, 217961], [36, 219181], [40, 219281], [46, 219721], [49, 219901], [59, 220581]]}, {"verse": 30, "start": 221637, "end": 234561, "text": "Reprime la reunión de gentes armadas, la multitud de toros con los becerros de los pueblos, hasta que todos se sometan con sus piezas de plata: disipa los pueblos que se complacen en la guerra.", "words": [[0, 221637], [8, 222302], [11, 222482], [19, 223062], [22, 223222], [29, 223682], [38, 224922], [41, 225062], [50, 225582], [53, 225742], [59, 226122], [63, 226302], [67, 226702], [76, 227102], [79, 227202], [83, 227342], [92, 228002], [98, 228422], [102, 228682], [108, 229002], [111, 229322], [119, 229902], [123, 230102], [127, 230302], [134, 230842], [137, 230962], [144, 232041], [151, 232341], [155, 232441], [163, 232861], [167, 232961], [170, 233081], [180, 233681], [183, 233801], [186, 233941]]}, {"verse": 31, "start": 234911, "end": 240282, "text": "Vendrán príncipes de Egipto; Etiopía apresurará sus manos a Dios.", "words": [[0, 235181], [8, 235636], [18, 236276], [21, 236476], [29, 237934], [37, 238500], [48, 239067], [52, 239207], [58, 239507], [60, 239767]]}, {"verse": 32, "start": 240632, "end": 245463, "text": "Reinos de la tierra, cantad a Dios, cantad al Señor (Selah);", "words": [[0, 240845], [7, 241095], [10, 241195], [13, 241295], [21, 241762], [28, 242228], [30, 242695], [36, 243148], [43, 243602], [46, 244055], [52, 244762]]}, {"verse": 33, "start": 245813, "end": 252989, "text": "Al que cabalga sobre los cielos de los cielos que son de antiguo: he aquí a su voz dará voz de fortaleza.", "words": [[0, 245885], [3, 245995], [7, 246155], [15, 246755], [21, 247055], [25, 247295], [32, 247955], [35, 248015], [39, 248155], [46, 248755], [50, 248835], [54, 249035], [57, 249235], [66, 250305], [69, 250395], [74, 250615], [76, 250815], [79, 250955], [83, 251255], [88, 251675], [92, 251875], [95, 252075]]}, {"verse": 34, "start": 253339, "end": 260839, "text": "Atribuid fortaleza a Dios: sobre Israel es su magnificencia, y su poder está en los cielos.", "words": [[0, 253631], [9, 253961], [19, 254492], [21, 255023], [27, 255749], [33, 256111], [40, 256911], [43, 257331], [46, 257551], [61, 258731], [63, 258951], [66, 259171], [72, 259531], [77, 259831], [80, 259991], [84, 260111]]}, {"verse": 35, "start": 261189, "end": 269926, "text": "Temible eres, oh Dios, desde tus santuarios: el Dios de Israel, él da fortaleza y vigor a su pueblo. Bendito Dios.", "words": [[0, 261189], [8, 261673], [14, 262053], [17, 262433], [23, 262813], [29, 263133], [33, 263393], [45, 264488], [48, 264621], [53, 264841], [56, 265001], [64, 265761], [67, 265901], [70, 266081], [80, 266921], [82, 267101], [88, 267361], [90, 267601], [93, 267741], [101, 268612], [109, 269298]]}]}