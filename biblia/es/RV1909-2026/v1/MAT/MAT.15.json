{"book": "MAT", "chapter": 15, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 304982, "verses": [{"verse": 1, "start": 300, "end": 5834, "text": "Entonces llegaron a Jesús ciertos escribas y fariseos de Jerusalén, diciendo:", "words": [[0, 300], [9, 710], [18, 1230], [20, 1330], [26, 1630], [34, 2410], [43, 2990], [45, 3130], [54, 3790], [57, 3890], [68, 5090]]}, {"verse": 2, "start": 6084, "end": 12216, "text": "¿Por qué tus discípulos quebrantan la tradición de los ancianos? porque no se lavan las manos cuando comen pan.", "words": [[0, 6084], [5, 6219], [9, 6359], [13, 6539], [24, 7099], [35, 7699], [38, 7799], [48, 8259], [51, 8379], [55, 8479], [65, 9529], [72, 9706], [75, 9886], [78, 10066], [84, 10246], [88, 10446], [94, 10766], [101, 11086], [107, 11406]]}, {"verse": 3, "start": 12566, "end": 20352, "text": "Y él respondiendo, les dijo: ¿Por qué también vosotros quebrantáis el mandamiento de Dios por vuestra tradición?", "words": [[0, 12566], [2, 12759], [5, 12979], [19, 14099], [23, 14299], [29, 15125], [34, 15247], [38, 15407], [46, 15787], [55, 16367], [67, 16947], [70, 17407], [82, 18147], [85, 18387], [90, 18647], [94, 19007], [102, 19427]]}, {"verse": 4, "start": 20802, "end": 30842, "text": "Porque Dios mandó, diciendo: Honra al padre y a la madre; y: El que maldiga al padre o a la madre, sea condenado a muerte.", "words": [[0, 20802], [7, 20984], [12, 21224], [19, 21684], [29, 22768], [35, 23316], [38, 23576], [44, 24016], [46, 24396], [48, 24476], [51, 24576], [58, 25482], [61, 26156], [64, 26296], [68, 26456], [76, 27016], [79, 27196], [85, 27636], [87, 27996], [89, 28116], [92, 28216], [99, 28996], [103, 29316], [113, 30036], [115, 30156]]}, {"verse": 5, "start": 31292, "end": 40235, "text": "Pero vosotros decís: Cualquiera que diga a su padre o a su madre: Es mi ofrenda a Dios todo aquello con que pudiera ayudarte;", "words": [[0, 31292], [5, 31439], [14, 31879], [21, 32972], [32, 33436], [36, 33616], [41, 33956], [43, 34016], [46, 34136], [52, 34536], [54, 34936], [56, 35036], [59, 35156], [66, 36074], [69, 36238], [72, 36418], [80, 36998], [82, 37158], [87, 37358], [92, 37738], [100, 38298], [104, 38538], [108, 38718], [116, 39278]]}, {"verse": 6, "start": 40685, "end": 50009, "text": "No deberá honrar a su padre o a su madre con socorro. Así habéis invalidado el mandamiento de Dios por vuestra tradición.", "words": [[0, 40685], [3, 40951], [10, 41511], [17, 42111], [19, 42271], [22, 42431], [28, 42891], [30, 43191], [32, 43311], [35, 43471], [41, 43811], [45, 44051], [54, 45167], [58, 45586], [65, 45986], [76, 46686], [79, 46826], [91, 47486], [94, 47706], [99, 47966], [103, 48586], [111, 49086]]}, {"verse": 7, "start": 50459, "end": 54505, "text": "Hipócritas, bien profetizó de vosotros Isaías, diciendo:", "words": [[0, 50459], [12, 51320], [17, 51580], [27, 52460], [30, 52560], [39, 53020], [47, 53700]]}, {"verse": 8, "start": 54955, "end": 59156, "text": "Este pueblo de labios me honra; pero su corazón lejos está de mí.", "words": [[0, 54955], [5, 55144], [12, 55464], [15, 55684], [22, 56004], [25, 56431], [32, 57106], [37, 57230], [40, 57410], [48, 57850], [54, 58410], [59, 58710], [62, 58890]]}, {"verse": 9, "start": 59607, "end": 64811, "text": "Pero en vano me honran, enseñando doctrinas y mandamientos de hombres.", "words": [[0, 59607], [5, 59930], [8, 60110], [13, 60630], [16, 60990], [24, 61350], [34, 62450], [44, 63170], [46, 63270], [59, 63970], [62, 64170]]}, {"verse": 10, "start": 65261, "end": 69451, "text": "Y llamando a sí a la multitud, les dijo: Oíd, y entended:", "words": [[0, 65261], [2, 65368], [11, 65608], [13, 65848], [16, 66088], [18, 66208], [21, 66288], [31, 67028], [35, 67148], [41, 68403], [46, 68403], [48, 68955]]}, {"verse": 11, "start": 69901, "end": 76615, "text": "No lo que entra en la boca contamina al hombre; sino lo que sale de la boca, esto contamina al hombre.", "words": [[0, 69901], [3, 70090], [6, 70250], [10, 70430], [16, 70990], [19, 71290], [22, 71450], [27, 71690], [37, 72450], [40, 72650], [48, 73462], [53, 73682], [56, 73862], [60, 74002], [65, 74322], [68, 74482], [71, 74602], [77, 75002], [82, 75282], [92, 76022], [95, 76142]]}, {"verse": 12, "start": 77065, "end": 84330, "text": "Entonces acercándose sus discípulos, le dijeron: ¿Sabes que los fariseos oyendo esta palabra se ofendieron?", "words": [[0, 77065], [9, 77909], [21, 78889], [25, 79049], [37, 80189], [40, 80329], [49, 81192], [56, 81551], [60, 81651], [64, 81771], [73, 82371], [80, 82771], [85, 82971], [93, 83391], [96, 83591]]}, {"verse": 13, "start": 84680, "end": 91659, "text": "Pero respondiendo él, dijo: Toda planta que no plantó mi Padre celestial, será desarraigada.", "words": [[0, 84680], [5, 84848], [18, 85708], [22, 85908], [28, 86688], [33, 86971], [40, 87411], [44, 87511], [47, 87651], [54, 88071], [57, 88211], [63, 88571], [74, 89331], [79, 90151]]}, {"verse": 14, "start": 92109, "end": 100334, "text": "Dejadlos: son ciegos guías de ciegos; y si el ciego guía al ciego, ambos caerán en el hoyo.", "words": [[0, 92109], [10, 93330], [14, 93535], [21, 94115], [27, 94715], [30, 94875], [38, 95854], [40, 95980], [43, 96140], [46, 96340], [52, 96880], [57, 97300], [60, 97520], [67, 98240], [73, 98800], [80, 99520], [83, 99640], [86, 99800]]}, {"verse": 15, "start": 100784, "end": 105318, "text": "Y respondiendo Pedro, le dijo: Decláranos esta parábola.", "words": [[0, 100784], [2, 100905], [15, 101725], [22, 102645], [25, 102905], [31, 104122], [42, 104472], [47, 104732]]}, {"verse": 16, "start": 105668, "end": 110134, "text": "Y Jesús dijo: ¿Aun también vosotros sois sin entendimiento?", "words": [[0, 105668], [2, 105854], [8, 106114], [14, 107119], [19, 107347], [27, 107767], [36, 108207], [41, 108647], [45, 108967]]}, {"verse": 17, "start": 110584, "end": 116863, "text": "¿No entendéis aún, que todo lo que entra en la boca, va al vientre, y es echado en la letrina?", "words": [[0, 110584], [4, 110730], [14, 111023], [19, 111317], [23, 111610], [28, 112150], [31, 112430], [35, 112660], [41, 112890], [44, 113130], [47, 113270], [53, 113510], [56, 113830], [59, 114010], [68, 114710], [70, 114930], [73, 115130], [80, 115710], [83, 116010], [86, 116150]]}, {"verse": 18, "start": 117313, "end": 123265, "text": "Pero lo que sale de la boca, del corazón sale; y esto contamina al hombre.", "words": [[0, 117313], [5, 117437], [8, 117597], [12, 117757], [17, 118017], [20, 118197], [23, 118337], [29, 118677], [33, 119517], [41, 119977], [47, 121057], [49, 121349], [54, 121629], [64, 122409], [67, 122669]]}, {"verse": 19, "start": 123715, "end": 133825, "text": "Porque del corazón salen los malos pensamientos, homicidios, adulterios, fornicaciones, hurtos, falsos testimonios, blasfemias.", "words": [[0, 123715], [7, 123916], [11, 124096], [19, 124576], [25, 125396], [29, 125676], [35, 126096], [49, 127336], [61, 128516], [73, 129556], [88, 130596], [96, 131296], [103, 131756], [116, 132556]]}, {"verse": 20, "start": 134275, "end": 141493, "text": "Estas cosas son las que contaminan al hombre: que comer con las manos sin lavar no contamina al hombre.", "words": [[0, 134275], [6, 134560], [12, 134840], [16, 135460], [20, 135640], [24, 135780], [35, 136460], [38, 136720], [46, 137579], [50, 137662], [56, 137942], [60, 138142], [64, 138342], [70, 138722], [74, 139282], [80, 139662], [83, 139862], [93, 140562], [96, 140802]]}, {"verse": 21, "start": 141943, "end": 146045, "text": "Y saliendo Jesús de allí, se fue a las partes de Tiro y de Sidón.", "words": [[0, 141943], [2, 142049], [11, 142509], [17, 142869], [20, 143129], [26, 143689], [29, 143769], [33, 143949], [35, 144089], [39, 144189], [46, 144569], [49, 144749], [54, 145169], [56, 145269], [59, 145409]]}, {"verse": 22, "start": 146495, "end": 159906, "text": "Y he aquí una mujer cananea, que había salido de aquellos términos, clamaba, diciéndole: Señor, Hijo de David, ten misericordia de mí; mi hija es cruelmente atormentada por un demonio.", "words": [[0, 146495], [2, 146674], [5, 146814], [10, 147114], [14, 147354], [20, 147774], [29, 148654], [33, 149074], [39, 149274], [46, 149794], [49, 149934], [58, 150174], [68, 151134], [77, 152274], [89, 153491], [96, 153887], [101, 154427], [104, 154567], [111, 154987], [115, 155407], [128, 156167], [131, 156287], [135, 156939], [138, 157081], [143, 157361], [146, 157521], [157, 158201], [169, 158881], [173, 159101], [176, 159241]]}, {"verse": 23, "start": 160256, "end": 171512, "text": "Pero él no le respondió palabra. Entonces acercándose sus discípulos, le rogaron, diciendo: Despídela, pues da voces tras nosotros.", "words": [[0, 160256], [5, 160398], [8, 160758], [11, 161138], [14, 161318], [24, 161918], [33, 162929], [42, 163612], [54, 165012], [58, 165372], [70, 166352], [73, 166872], [82, 167712], [92, 169135], [103, 169465], [108, 170105], [111, 170185], [117, 170585], [122, 170725]]}, {"verse": 24, "start": 171862, "end": 178152, "text": "Y él respondiendo, dijo: No soy enviado sino a las ovejas perdidas de la casa de Israel.", "words": [[0, 171862], [2, 172029], [5, 172169], [19, 172889], [25, 173786], [28, 173952], [32, 174272], [40, 174832], [45, 175072], [47, 175252], [51, 175372], [58, 175872], [67, 176552], [70, 176712], [73, 176792], [78, 177072], [81, 177332]]}, {"verse": 25, "start": 178602, "end": 185328, "text": "Entonces ella vino, y le adoró, diciendo: Señor, socórreme.", "words": [[0, 178602], [9, 179169], [14, 179589], [20, 180029], [22, 180629], [25, 180769], [32, 181489], [42, 182712], [49, 184020]]}, {"verse": 26, "start": 185678, "end": 191745, "text": "Y respondiendo él, dijo: No es bien tomar el pan de los hijos, y echarlo a los perrillos.", "words": [[0, 185678], [2, 185800], [15, 186600], [19, 186780], [25, 187642], [28, 187823], [31, 188023], [36, 188183], [42, 188603], [45, 188863], [49, 189083], [52, 189243], [56, 189403], [63, 189743], [65, 190123], [73, 190683], [75, 190763], [79, 191285]]}, {"verse": 27, "start": 192195, "end": 199076, "text": "Y ella dijo: Sí, Señor; pero los perrillos comen de las migajas que caen de la mesa de sus señores.", "words": [[0, 192195], [2, 192533], [7, 192693], [13, 193511], [17, 193997], [24, 194842], [29, 194989], [33, 195169], [43, 195629], [49, 195969], [52, 196189], [56, 196309], [64, 196929], [68, 197109], [73, 197489], [76, 197589], [79, 197709], [84, 197989], [87, 198169], [91, 198309]]}, {"verse": 28, "start": 199426, "end": 209988, "text": "Entonces respondiendo Jesús, dijo: Oh mujer, grande es tu fe; sea hecho contigo como quieres. Y fue sana su hija desde aquella hora.", "words": [[0, 199426], [9, 200431], [22, 201311], [29, 201631], [35, 202791], [38, 202881], [45, 203281], [52, 203841], [55, 203955], [58, 204069], [62, 204976], [66, 205486], [72, 205666], [80, 206266], [85, 206566], [94, 207651], [96, 207760], [100, 207900], [105, 208340], [108, 208440], [113, 208800], [119, 209000], [127, 209480]]}, {"verse": 29, "start": 210438, "end": 217599, "text": "Y partido Jesús de allí, vino junto al mar de Galilea: y subiendo al monte, se sentó allí.", "words": [[0, 210438], [2, 210678], [10, 211158], [16, 211538], [19, 211798], [25, 212058], [30, 212598], [36, 212958], [39, 213258], [43, 213498], [46, 213698], [55, 214850], [57, 214994], [66, 215454], [69, 215614], [76, 216014], [79, 216714], [85, 217174]]}, {"verse": 30, "start": 218049, "end": 229032, "text": "Y se le acercó mucha gente que traía consigo cojos, ciegos, mudos, mancos, y otros muchos enfermos: y los pusieron a los pies de Jesús, y los sanó:", "words": [[0, 218049], [2, 218318], [5, 218438], [8, 218578], [15, 219118], [21, 219578], [27, 219958], [31, 220158], [37, 220538], [45, 220878], [52, 221858], [60, 222658], [67, 223198], [75, 223638], [77, 224158], [83, 224398], [90, 224758], [100, 225929], [102, 226037], [106, 226137], [115, 226597], [117, 226737], [121, 226857], [126, 227017], [129, 227177], [136, 227497], [138, 228297], [142, 228417]]}, {"verse": 31, "start": 229482, "end": 239965, "text": "De manera que la multitud se maravillaba, viendo hablar los mudos, los mancos sanos, andar los cojos, y ver los ciegos: y glorificaron al Dios de Israel.", "words": [[0, 229482], [3, 229624], [10, 229844], [14, 230104], [17, 230244], [26, 230804], [29, 231024], [42, 231724], [49, 231984], [56, 232304], [60, 232564], [67, 233444], [71, 233504], [78, 234004], [85, 234904], [91, 235124], [95, 235384], [102, 235864], [104, 236204], [108, 236384], [112, 236604], [120, 237705], [122, 237889], [135, 238689], [138, 238869], [143, 239169], [146, 239289]]}, {"verse": 32, "start": 240415, "end": 256532, "text": "Y Jesús llamando a sus discípulos, dijo: Tengo compasión de la gente, que ya hace tres días que perseveran conmigo, y no tienen qué comer; y enviarlos en ayunas no quiero, porque no desmayen en el camino.", "words": [[0, 240415], [2, 240558], [8, 241338], [17, 241898], [19, 241998], [23, 242178], [35, 243238], [41, 244040], [47, 244319], [57, 245019], [60, 245179], [63, 245299], [70, 245739], [74, 246279], [77, 246519], [82, 246779], [87, 247139], [92, 247559], [96, 247739], [107, 248399], [116, 249059], [118, 249399], [121, 249519], [128, 249759], [132, 249979], [139, 250810], [141, 250952], [151, 251512], [154, 251792], [161, 252212], [164, 252372], [172, 252892], [179, 253152], [182, 253372], [191, 254072], [194, 254272], [197, 254392]]}, {"verse": 33, "start": 256982, "end": 264315, "text": "Entonces sus discípulos le dicen: ¿Dónde tenemos nosotros tantos panes en el desierto, para alimentar a tanta gente?", "words": [[0, 256982], [9, 256982], [13, 257264], [24, 258344], [27, 258684], [34, 259541], [41, 259762], [49, 260222], [58, 260542], [65, 261222], [71, 261602], [74, 261702], [77, 261822], [87, 262322], [92, 262882], [102, 263402], [104, 263462], [110, 263622]]}, {"verse": 34, "start": 264665, "end": 271908, "text": "Y Jesús les dice: ¿Cuántos panes tenéis? Y ellos dijeron: Siete, y unos pocos pececillos.", "words": [[0, 264665], [2, 264809], [8, 265209], [12, 265589], [18, 266461], [27, 266865], [33, 267385], [41, 268368], [43, 268552], [49, 268732], [58, 269918], [65, 270068], [67, 270408], [72, 270608], [78, 271288]]}, {"verse": 35, "start": 272258, "end": 275582, "text": "Y mandó a la multitud que se recostase en tierra.", "words": [[0, 272258], [2, 272385], [8, 272785], [10, 272905], [13, 272985], [22, 273625], [26, 273978], [29, 274332], [39, 274685], [42, 274845]]}, {"verse": 36, "start": 276032, "end": 284371, "text": "Y tomando los siete panes y los peces, haciendo gracias, partió y dio a sus discípulos; y los discípulos a la gente.", "words": [[0, 276032], [2, 276119], [10, 276519], [14, 276659], [20, 276919], [26, 277439], [28, 277539], [32, 277659], [39, 278139], [48, 278479], [57, 279599], [64, 280219], [66, 280539], [70, 280799], [72, 280939], [76, 281199], [88, 282694], [90, 282781], [94, 282901], [105, 283501], [107, 283681], [110, 283741]]}, {"verse": 37, "start": 284821, "end": 291800, "text": "Y comieron todos, y se saciaron: y alzaron lo que sobró de los pedazos, siete canastas llenas.", "words": [[0, 284821], [2, 284942], [11, 285382], [18, 285782], [20, 286162], [23, 286282], [33, 287547], [35, 287648], [43, 288208], [46, 288368], [50, 288508], [56, 288948], [59, 289008], [63, 289148], [72, 289698], [78, 290248], [87, 291028]]}, {"verse": 38, "start": 292250, "end": 297762, "text": "Y eran los que habían comido, cuatro mil hombres, sin las mujeres y los niños.", "words": [[0, 292250], [2, 292415], [7, 292615], [11, 292835], [15, 292995], [22, 293255], [30, 293895], [37, 294535], [41, 295175], [50, 295535], [54, 296055], [58, 296275], [66, 296675], [68, 296915], [72, 297055]]}, {"verse": 39, "start": 298212, "end": 304582, "text": "Entonces, despedida la gente, subió en el barco: y vino a los términos de Magdala.", "words": [[0, 298212], [10, 298869], [20, 300009], [23, 300129], [30, 300589], [36, 301089], [39, 301229], [42, 301349], [49, 302302], [51, 302582], [56, 302822], [58, 302962], [62, 303102], [71, 303682], [74, 304152]]}]}