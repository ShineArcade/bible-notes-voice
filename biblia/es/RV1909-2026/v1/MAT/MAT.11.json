{"book": "MAT", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 256735, "verses": [{"verse": 1, "start": 300, "end": 9529, "text": "Y fue, que acabando Jesús de dar instrucciones a sus doce discípulos, se fue de allí a enseñar y a predicar en las ciudades de ellos.", "words": [[0, 300], [2, 405], [7, 565], [11, 925], [20, 1425], [26, 1765], [29, 2065], [33, 2265], [47, 3285], [49, 3545], [53, 3705], [58, 4185], [70, 5505], [73, 5745], [77, 5925], [80, 6105], [85, 6305], [87, 6425], [95, 7105], [97, 7245], [99, 7325], [108, 7845], [111, 8045], [115, 8205], [124, 8745], [127, 8905]]}, {"verse": 2, "start": 9979, "end": 16011, "text": "Y oyendo Juan en la prisión los hechos de Cristo, le envió dos de sus discípulos,", "words": [[0, 9979], [2, 10142], [9, 10522], [14, 10862], [17, 11162], [20, 11462], [28, 11762], [32, 11982], [39, 12302], [42, 12462], [50, 13382], [53, 13682], [59, 14122], [63, 14462], [66, 14642], [70, 14842]]}, {"verse": 3, "start": 16461, "end": 21177, "text": "Diciendo: ¿Eres tú aquel que había de venir, o esperaremos a otro?", "words": [[0, 16461], [10, 17598], [16, 17839], [19, 18099], [25, 18479], [29, 18599], [35, 18779], [38, 18979], [45, 19279], [47, 19839], [59, 20459], [61, 20719]]}, {"verse": 4, "start": 21527, "end": 28492, "text": "Y respondiendo Jesús, les dijo: Id, y haced saber a Juan las cosas que oís y veis:", "words": [[0, 21527], [2, 21649], [15, 22369], [22, 22819], [26, 23269], [32, 24203], [36, 24353], [38, 24833], [44, 25313], [50, 25733], [52, 25873], [57, 26173], [61, 26653], [67, 26953], [71, 27233], [75, 27693], [77, 27953]]}, {"verse": 5, "start": 28942, "end": 41248, "text": "Los ciegos ven, y los cojos andan; los leprosos son limpiados, y los sordos oyen; los muertos son resucitados, y a los pobres es anunciado el evangelio.", "words": [[0, 28942], [4, 29049], [11, 29569], [16, 29989], [18, 30569], [22, 30709], [28, 31209], [35, 32291], [39, 32410], [48, 33070], [52, 33350], [63, 34150], [65, 34410], [69, 34590], [76, 35190], [82, 36187], [86, 36311], [94, 36731], [98, 37011], [111, 37951], [113, 38491], [115, 38591], [119, 38691], [126, 39131], [129, 39331], [139, 40131], [142, 40311]]}, {"verse": 6, "start": 41698, "end": 45059, "text": "Y bienaventurado es el que no tropiece por causa de mí.", "words": [[0, 41698], [2, 41964], [17, 42924], [20, 43084], [23, 43204], [27, 43344], [30, 43484], [39, 43964], [43, 44204], [49, 44464], [52, 44744]]}, {"verse": 7, "start": 45509, "end": 55525, "text": "Y al irse ellos, comenzó Jesús a decir de Juan a la gente: ¿Qué salisteis a ver al desierto? ¿una caña que es sacudida por el viento?", "words": [[0, 45509], [2, 45656], [5, 45776], [10, 46156], [17, 46596], [25, 47756], [31, 48016], [33, 48336], [39, 48656], [42, 48976], [47, 49296], [49, 49476], [52, 49556], [59, 50474], [64, 50922], [74, 51402], [76, 51562], [80, 51682], [83, 51822], [93, 52958], [98, 53278], [103, 53738], [107, 53938], [110, 54268], [119, 54598], [123, 54758], [126, 54898]]}, {"verse": 8, "start": 55975, "end": 66395, "text": "Pero ¿qué salisteis a ver? ¿un hombre cubierto de delicados vestidos? He aquí, los que traen vestidos delicados, en las casas de los reyes están.", "words": [[0, 55975], [5, 56138], [10, 56578], [20, 57258], [22, 57398], [27, 58041], [31, 58224], [38, 58564], [47, 59304], [50, 59504], [60, 60184], [70, 61476], [73, 61651], [79, 61826], [83, 62001], [87, 62161], [93, 62601], [102, 63181], [113, 64021], [116, 64421], [120, 64561], [126, 65121], [129, 65221], [133, 65491], [139, 65761]]}, {"verse": 9, "start": 66845, "end": 72262, "text": "Pero ¿qué salisteis a ver? ¿un profeta? También os digo, y más que profeta.", "words": [[0, 66845], [5, 67222], [10, 67636], [20, 68049], [22, 68189], [27, 68782], [31, 69022], [40, 69980], [48, 70175], [51, 70405], [57, 70685], [59, 71105], [63, 71305], [67, 71485]]}, {"verse": 10, "start": 72712, "end": 80707, "text": "Porque este es de quien está escrito: He aquí, yo envío mi mensajero delante de ti, que preparará tu camino delante de ti.", "words": [[0, 72712], [7, 72954], [12, 73254], [15, 73594], [18, 73754], [24, 73934], [29, 74234], [38, 75263], [41, 75343], [47, 75603], [50, 76243], [56, 76663], [59, 76823], [69, 77503], [77, 77903], [80, 78083], [84, 78283], [88, 78463], [98, 79043], [101, 79243], [108, 79563], [116, 80143], [119, 80343]]}, {"verse": 11, "start": 81157, "end": 92387, "text": "De cierto os digo, que no se levantó entre los que nacen de mujeres otro mayor que Juan el Bautista; pero el más pequeño en el reino de los cielos, mayor es que él.", "words": [[0, 81346], [3, 81571], [10, 81796], [13, 82021], [19, 82561], [23, 82641], [26, 82801], [29, 82961], [37, 83621], [43, 84041], [47, 84281], [51, 84461], [57, 84881], [60, 85021], [68, 85481], [73, 85901], [79, 86301], [83, 86521], [88, 86821], [91, 87362], [101, 88150], [106, 88316], [109, 88476], [113, 88656], [121, 89116], [124, 89376], [127, 89496], [133, 89876], [136, 89996], [140, 90156], [148, 90916], [154, 91316], [157, 91676], [161, 91836]]}, {"verse": 12, "start": 92837, "end": 101214, "text": "Desde los días de Juan el Bautista hasta ahora, al reino de los cielos se hace fuerza, y los valientes lo arrebatan.", "words": [[0, 92837], [6, 93002], [10, 93222], [15, 93462], [18, 93642], [23, 94142], [26, 94242], [35, 95082], [41, 95182], [48, 96162], [51, 96302], [57, 96682], [60, 96802], [64, 96942], [71, 97482], [74, 97642], [79, 97842], [87, 98342], [89, 98882], [93, 99022], [103, 99542], [106, 100102]]}, {"verse": 13, "start": 101664, "end": 105593, "text": "Porque todos los profetas y la ley hasta Juan profetizaron.", "words": [[0, 101664], [7, 101847], [13, 102247], [17, 102647], [26, 103147], [28, 103327], [31, 103447], [35, 103727], [41, 104087], [46, 104447]]}, {"verse": 14, "start": 106043, "end": 110249, "text": "Y si queréis recibir, él es aquel Elías que había de venir.", "words": [[0, 106043], [2, 106209], [5, 106289], [13, 106769], [22, 108029], [25, 108289], [28, 108449], [34, 108769], [40, 109249], [44, 109389], [50, 109609], [53, 109809]]}, {"verse": 15, "start": 110699, "end": 113514, "text": "El que tiene oídos para oír, oiga.", "words": [[0, 110699], [3, 110825], [7, 110965], [13, 111325], [19, 111985], [24, 112245], [29, 113025]]}, {"verse": 16, "start": 113964, "end": 122812, "text": "Pero ¿a quién compararé esta generación? Es semejante a los muchachos que se sientan en las plazas, y dan voces a sus compañeros,", "words": [[0, 113964], [5, 114146], [8, 114546], [14, 114786], [24, 115586], [29, 115906], [41, 117197], [44, 117483], [54, 118443], [56, 118543], [60, 118643], [70, 119183], [74, 119283], [77, 119403], [85, 119903], [88, 120003], [92, 120123], [100, 120663], [102, 120983], [106, 121143], [112, 121603], [114, 121743], [118, 121883]]}, {"verse": 17, "start": 123262, "end": 131851, "text": "Y dicen: Tocamos la flauta para vosotros, y no bailasteis; cantamos canciones de duelo para vosotros, y no lamentasteis.", "words": [[0, 123262], [2, 123696], [9, 124460], [17, 124884], [20, 125104], [27, 125564], [32, 125764], [42, 126364], [44, 126604], [47, 126724], [59, 127942], [68, 128586], [78, 129106], [81, 129346], [87, 129686], [92, 129906], [102, 130426], [104, 130706], [107, 130866]]}, {"verse": 18, "start": 132301, "end": 137262, "text": "Porque vino Juan, que ni comía ni bebía, y dicen: Demonio tiene.", "words": [[0, 132301], [7, 132482], [12, 132762], [18, 133182], [22, 133722], [25, 133902], [31, 134322], [34, 134482], [41, 135002], [43, 135202], [50, 136397], [58, 136697]]}, {"verse": 19, "start": 137712, "end": 150688, "text": "Vino el Hijo del hombre, que come y bebe, y dicen: He aquí un hombre comilón, y bebedor de vino, amigo de publicanos y de pecadores. Pero la sabiduría es justificada por sus hijos.", "words": [[0, 137712], [5, 137997], [8, 138197], [13, 138497], [17, 138657], [25, 139257], [29, 139577], [34, 139917], [36, 140177], [42, 140557], [44, 140757], [51, 141664], [54, 141792], [59, 142072], [62, 142252], [69, 142792], [78, 143332], [80, 143812], [88, 144252], [91, 144432], [97, 145072], [103, 145392], [106, 145592], [117, 146272], [119, 146452], [122, 146572], [133, 147729], [138, 147874], [141, 148034], [151, 148694], [154, 148814], [166, 149594], [170, 149814], [174, 150034]]}, {"verse": 20, "start": 151138, "end": 160589, "text": "Entonces comenzó a reprender a las ciudades en las cuales habían sido hechas muchas de sus maravillas, porque no se habían arrepentido, diciendo:", "words": [[0, 151138], [9, 151618], [17, 152318], [19, 152398], [29, 152898], [31, 153038], [35, 153158], [44, 153678], [47, 153838], [51, 153998], [58, 154198], [65, 154618], [70, 154998], [77, 155278], [84, 155598], [87, 155858], [91, 155998], [103, 156618], [110, 157238], [113, 157818], [116, 157998], [123, 158298], [136, 159558]]}, {"verse": 21, "start": 161039, "end": 175981, "text": "¡Ay de ti, Corazín! ¡Ay de ti, Betsaida! porque si en Tiro y en Sidón fueran hechas las maravillas que han sido hechas en vosotras, en otro tiempo se hubieran arrepentido con ropa de luto y ceniza.", "words": [[0, 161039], [4, 161562], [7, 161602], [11, 162212], [20, 163122], [24, 163622], [27, 164080], [31, 164538], [41, 165247], [48, 165471], [51, 165751], [54, 166211], [59, 166511], [61, 166731], [64, 167081], [70, 167431], [77, 168151], [84, 168531], [88, 168731], [99, 169351], [103, 169531], [107, 169671], [112, 169991], [119, 170371], [122, 170591], [132, 171631], [135, 171751], [140, 171971], [147, 172351], [150, 172591], [159, 172971], [171, 173951], [175, 174111], [180, 174631], [183, 174771], [188, 175131], [190, 175271]]}, {"verse": 22, "start": 176431, "end": 183311, "text": "Por tanto os digo, que a Tiro y a Sidón será más tolerable el castigo en el día del juicio, que a vosotras.", "words": [[0, 176431], [4, 176555], [10, 177035], [13, 177135], [19, 177315], [23, 177615], [25, 177915], [30, 178215], [32, 178468], [34, 178722], [40, 178975], [45, 179195], [49, 179455], [59, 180095], [62, 180235], [70, 180755], [73, 180875], [76, 180975], [80, 181215], [84, 181375], [92, 181955], [96, 182395], [98, 182515]]}, {"verse": 23, "start": 183761, "end": 199744, "text": "Y tú, Capernaum, que eres levantada hasta el cielo, hasta los infiernos serás abatida; porque si en los de Sodoma fueran hechas las maravillas que han sido hechas en ti, hubieran quedado hasta el día de hoy.", "words": [[0, 183761], [2, 183902], [6, 184102], [17, 185442], [21, 185702], [26, 185942], [36, 186762], [42, 186962], [45, 187122], [52, 187622], [58, 188382], [62, 188602], [72, 189349], [78, 190097], [87, 191097], [94, 191379], [97, 191759], [100, 191979], [104, 192352], [107, 192726], [114, 193099], [121, 193599], [128, 194079], [132, 194439], [143, 195219], [147, 195479], [151, 195699], [156, 195999], [163, 196399], [166, 196619], [170, 197219], [179, 197959], [187, 198519], [193, 198779], [196, 198979], [200, 199199], [203, 199379]]}, {"verse": 24, "start": 200194, "end": 207449, "text": "Por tanto os digo, que a la tierra de los de Sodoma será más tolerable el castigo en el día del juicio, que a ti.", "words": [[0, 200194], [4, 200316], [10, 200456], [13, 200596], [19, 200976], [23, 201256], [25, 201696], [28, 201776], [35, 202176], [38, 202456], [42, 202706], [45, 202956], [52, 203206], [57, 203456], [61, 203816], [71, 204336], [74, 204856], [82, 205536], [85, 205656], [88, 205796], [92, 205996], [96, 206176], [104, 206676], [108, 206896], [110, 206996]]}, {"verse": 25, "start": 207899, "end": 221480, "text": "En aquel tiempo, respondiendo Jesús, dijo: Te alabo, Padre, Señor del cielo y de la tierra, que hayas escondido estas cosas de los sabios y de los entendidos, y las hayas revelado a los niños.", "words": [[0, 207899], [3, 208259], [9, 208539], [17, 208999], [30, 209739], [37, 210579], [43, 211364], [46, 211450], [53, 211770], [60, 212590], [66, 213030], [70, 213330], [76, 213770], [78, 213990], [81, 214070], [84, 214190], [92, 215030], [96, 215230], [102, 215570], [112, 216270], [118, 216410], [124, 216890], [127, 217130], [131, 217250], [138, 217770], [140, 217930], [143, 218010], [147, 218150], [159, 218910], [161, 219390], [165, 219550], [171, 219890], [180, 220490], [182, 220590], [186, 220710]]}, {"verse": 26, "start": 221930, "end": 224412, "text": "Así, Padre, pues que así te agradó.", "words": [[0, 221930], [5, 222352], [12, 223152], [17, 223272], [21, 223452], [25, 223632], [28, 223812]]}, {"verse": 27, "start": 224862, "end": 237128, "text": "Todas las cosas me son entregadas de mi Padre: y nadie conoció al Hijo, sino el Padre; ni al Padre conoció alguno, sino el Hijo, y aquel a quien el Hijo lo quiera revelar.", "words": [[0, 224862], [6, 225106], [10, 225226], [16, 225506], [19, 225746], [23, 225926], [34, 226506], [37, 226666], [40, 226786], [47, 227650], [49, 228017], [55, 228297], [63, 228917], [66, 229137], [72, 229677], [77, 229897], [80, 230117], [87, 231215], [90, 231425], [93, 231635], [99, 231845], [107, 232465], [115, 233085], [120, 233285], [123, 233645], [129, 234725], [131, 234825], [137, 235145], [139, 235265], [145, 235425], [148, 235685], [153, 235905], [156, 236065], [163, 236385]]}, {"verse": 28, "start": 237578, "end": 242749, "text": "Venid a mí todos los que estáis cansados y cargados, que yo os haré descansar.", "words": [[0, 237578], [6, 237916], [8, 238016], [11, 238136], [17, 238476], [21, 238736], [25, 239149], [32, 239563], [41, 239976], [43, 240156], [53, 240936], [57, 241256], [60, 241496], [63, 241676], [68, 241916]]}, {"verse": 29, "start": 243199, "end": 252749, "text": "Llevad mi yugo sobre vosotros, y aprended de mí, que soy manso y humilde de corazón; y hallaréis descanso para vuestras almas.", "words": [[0, 243199], [7, 243506], [10, 243846], [15, 244186], [21, 244386], [31, 245046], [33, 245306], [42, 245926], [45, 246146], [49, 246786], [53, 247046], [57, 247266], [63, 248026], [65, 248306], [73, 248766], [76, 248946], [85, 250055], [87, 250202], [97, 250682], [106, 251462], [111, 251682], [120, 252122]]}, {"verse": 30, "start": 253199, "end": 256335, "text": "Porque mi yugo es fácil, y ligera mi carga.", "words": [[0, 253199], [7, 253381], [10, 253671], [15, 253961], [18, 254141], [25, 254561], [27, 255121], [34, 255581], [37, 255741]]}]}