{"book": "ROM", "chapter": 15, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 236212, "verses": [{"verse": 1, "start": 300, "end": 6634, "text": "Así que, los que somos más firmes debemos soportar las debilidades de los débiles, y no agradarnos a nosotros mismos.", "words": [[0, 300], [4, 504], [9, 704], [13, 844], [17, 1004], [23, 1244], [27, 1524], [34, 2044], [42, 2424], [51, 3064], [55, 3184], [67, 3764], [70, 3944], [74, 4064], [83, 4504], [85, 4784], [88, 4924], [99, 5504], [101, 5684], [110, 5864]]}, {"verse": 2, "start": 6984, "end": 10823, "text": "Cada uno de nosotros agrade a su prójimo en bien, a edificación.", "words": [[0, 6984], [5, 7125], [9, 7405], [12, 7525], [21, 8025], [28, 8405], [30, 8645], [33, 8765], [41, 9245], [44, 9385], [50, 9605], [52, 9945]]}, {"verse": 3, "start": 11173, "end": 19276, "text": "Porque Cristo no se agradó a sí mismo; antes bien, como está escrito: Los insultos de los que te insultan, cayeron sobre mí.", "words": [[0, 11173], [7, 11422], [14, 11862], [17, 12142], [20, 12322], [27, 12762], [29, 12882], [32, 12962], [39, 13679], [45, 13941], [51, 14801], [56, 15101], [61, 15341], [70, 16228], [74, 16368], [83, 17068], [86, 17188], [90, 17308], [94, 17468], [97, 17608], [107, 18328], [115, 18748], [121, 18968]]}, {"verse": 4, "start": 19626, "end": 29894, "text": "Porque las cosas que antes fueron escritas, para nuestra enseñanza fueron escritas; para que por la paciencia, y por la consolación de las Escrituras, tengamos esperanza.", "words": [[0, 19626], [7, 19815], [11, 20015], [17, 20335], [21, 20595], [27, 20835], [34, 21135], [44, 21935], [49, 22315], [57, 22535], [67, 23355], [74, 23635], [84, 24707], [89, 24852], [93, 24992], [97, 25172], [100, 25292], [111, 25952], [113, 26372], [117, 26552], [120, 26652], [132, 27292], [135, 27412], [139, 27552], [151, 28232], [160, 29072]]}, {"verse": 5, "start": 30244, "end": 36372, "text": "Pero el Dios de la paciencia y de la consolación os dé que entre vosotros seáis unánimes según Cristo Jesús;", "words": [[0, 30244], [5, 30382], [8, 30522], [13, 30682], [16, 30862], [19, 30962], [29, 31562], [31, 31702], [34, 31782], [37, 31902], [49, 32722], [52, 33242], [55, 33442], [59, 33582], [65, 33802], [74, 34342], [80, 34722], [89, 35242], [95, 35462], [102, 35842]]}, {"verse": 6, "start": 36722, "end": 41898, "text": "Para que concordes, a una boca glorifiquéis al Dios y Padre de nuestro Señor Jesucristo.", "words": [[0, 36722], [5, 36874], [9, 36994], [20, 37674], [22, 37874], [26, 38034], [31, 38334], [44, 39174], [47, 39354], [52, 39574], [54, 39914], [60, 40294], [63, 40374], [71, 40754], [77, 40954]]}, {"verse": 7, "start": 42248, "end": 48390, "text": "Por tanto, recibíos los unos a los otros, como también Cristo nos recibió, para gloria de Dios.", "words": [[0, 42248], [4, 42351], [11, 42771], [20, 43411], [24, 43611], [29, 43891], [31, 44111], [35, 44251], [42, 44891], [47, 45171], [55, 45531], [62, 45851], [66, 46051], [75, 46876], [80, 47116], [87, 47516], [90, 47656]]}, {"verse": 8, "start": 48740, "end": 56430, "text": "Digo, pues, que Cristo Jesús fue hecho ministro de la circuncisión por la verdad de Dios, para confirmar las promesas hechas a los padres,", "words": [[0, 48740], [6, 48920], [12, 49620], [16, 49700], [23, 50040], [29, 50560], [33, 50820], [39, 51020], [48, 51580], [51, 51660], [54, 51760], [67, 52620], [71, 52820], [74, 52940], [81, 53240], [84, 53420], [90, 53720], [95, 53985], [105, 54605], [109, 54745], [118, 55285], [125, 55525], [127, 55725], [131, 55865]]}, {"verse": 9, "start": 56780, "end": 65748, "text": "Y para que los Gentiles glorifiquen a Dios por la misericordia; como está escrito: Por tanto yo te confesaré entre los Gentiles, y cantaré a tu nombre.", "words": [[0, 56780], [2, 56888], [7, 57068], [11, 57228], [15, 57368], [24, 57888], [36, 58728], [38, 58808], [43, 58988], [47, 59248], [50, 59368], [64, 60499], [69, 60675], [74, 60955], [83, 61815], [87, 61916], [93, 62376], [96, 62476], [99, 62636], [109, 63256], [115, 63496], [119, 63716], [129, 64276], [131, 64536], [139, 64996], [141, 65116], [144, 65216]]}, {"verse": 10, "start": 66098, "end": 69545, "text": "Y otra vez dice: Alegraos, Gentiles, con su pueblo.", "words": [[0, 66098], [2, 66257], [7, 66397], [11, 66657], [17, 67595], [27, 67835], [37, 68475], [41, 68735], [44, 68875]]}, {"verse": 11, "start": 69895, "end": 75723, "text": "Y otra vez: Alabad al Señor todos los Gentiles, y magnificadle, todos los pueblos.", "words": [[0, 69895], [2, 70061], [7, 70201], [12, 71182], [19, 71432], [22, 71532], [28, 71752], [34, 72112], [38, 72352], [48, 72992], [50, 73672], [64, 74352], [70, 74792], [74, 75072]]}, {"verse": 12, "start": 76073, "end": 85129, "text": "Y otra vez, dice Isaías: Estará la raíz de Isaí, y el que se levantará a regir los Gentiles: los Gentiles esperarán en él.", "words": [[0, 76073], [2, 76330], [7, 76470], [12, 76770], [17, 77070], [25, 78759], [32, 79219], [35, 79319], [40, 79719], [43, 79859], [49, 80499], [51, 80739], [54, 80839], [58, 80959], [61, 81099], [71, 81719], [73, 81919], [79, 82319], [83, 82459], [93, 83420], [97, 83540], [106, 84060], [116, 84740], [119, 84860]]}, {"verse": 13, "start": 85479, "end": 93452, "text": "Y el Dios de esperanza os llene de todo gozo y paz creyendo, para que abundéis en esperanza por el poder del Espíritu Santo.", "words": [[0, 85479], [2, 85624], [5, 85744], [10, 85984], [13, 86224], [23, 86924], [26, 87184], [32, 87504], [35, 87644], [40, 87904], [45, 88364], [47, 88544], [51, 88804], [61, 89884], [66, 90084], [70, 90264], [79, 90784], [82, 90944], [92, 91544], [96, 91784], [99, 91904], [105, 92144], [109, 92404], [118, 92944]]}, {"verse": 14, "start": 93802, "end": 104398, "text": "Pero cierto estoy yo de vosotros, hermanos míos, que aun vosotros mismos estáis llenos de bondad, llenos de todo conocimiento, de tal manera que podáis amonestaros los unos a los otros.", "words": [[0, 93802], [5, 93958], [12, 94478], [18, 94658], [21, 94898], [24, 94998], [34, 95698], [43, 96118], [49, 96838], [53, 96918], [57, 97078], [66, 97558], [73, 97898], [80, 98458], [87, 98718], [90, 98858], [98, 99538], [105, 99838], [108, 99978], [113, 100138], [127, 101324], [130, 101430], [134, 101630], [141, 101910], [145, 102110], [152, 102490], [164, 103190], [168, 103330], [173, 103530], [175, 103730], [179, 103870]]}, {"verse": 15, "start": 104748, "end": 111634, "text": "Pero os he escrito, hermanos, en parte resueltamente, como amonestándoos por la gracia que de Dios me es dada,", "words": [[0, 104748], [5, 104901], [8, 105081], [11, 105181], [20, 105761], [30, 106461], [33, 106541], [39, 107411], [54, 108281], [59, 108541], [73, 109441], [77, 109641], [80, 109781], [87, 110241], [91, 110341], [94, 110481], [99, 110721], [102, 110981], [105, 111121]]}, {"verse": 16, "start": 111984, "end": 122766, "text": "Para ser ministro de Jesucristo a los Gentiles, ministrando el evangelio de Dios, para que la ofrenda de los Gentiles sea agradable, santificada por el Espíritu Santo.", "words": [[0, 111984], [5, 112143], [9, 112323], [18, 112903], [21, 113003], [32, 113743], [34, 113843], [38, 113963], [48, 115223], [60, 115743], [63, 115903], [73, 116463], [76, 116563], [82, 117323], [87, 117523], [91, 117683], [94, 117803], [102, 118263], [105, 118343], [109, 118483], [118, 119063], [122, 119323], [133, 120223], [145, 120903], [149, 121123], [152, 121243], [161, 121843]]}, {"verse": 17, "start": 123116, "end": 127985, "text": "Tengo, pues, de qué gloriarme en Cristo Jesús en lo que se refiere a Dios.", "words": [[0, 123116], [7, 123336], [13, 123616], [16, 124116], [20, 124296], [30, 124976], [33, 125076], [40, 125376], [46, 125916], [49, 126171], [52, 126251], [56, 126371], [59, 126491], [67, 126891], [69, 127031]]}, {"verse": 18, "start": 128335, "end": 136388, "text": "Porque no me atrevería a hablar alguna cosa que Cristo no haya hecho por mí para la obediencia de los Gentiles, con la palabra y con las obras,", "words": [[0, 128335], [7, 128545], [10, 128785], [13, 128925], [23, 129565], [25, 129665], [32, 129845], [39, 130145], [44, 130545], [48, 130765], [55, 131085], [58, 131365], [63, 131525], [69, 131825], [73, 132045], [76, 132225], [81, 132445], [84, 132605], [95, 133145], [98, 133285], [102, 133425], [112, 134165], [116, 134485], [119, 134625], [127, 135005], [129, 135145], [133, 135285], [137, 135445]]}, {"verse": 19, "start": 136738, "end": 146992, "text": "Con poder de milagros y prodigios, por el poder del Espíritu de Dios: de manera que desde Jerusalén, y por los alrededores hasta Ilírico, he llenado todo del evangelio de Cristo.", "words": [[0, 136738], [4, 136860], [10, 137100], [13, 137280], [22, 137820], [24, 137940], [35, 138580], [39, 138920], [42, 139040], [48, 139240], [52, 139480], [61, 140020], [64, 140120], [70, 140860], [73, 140924], [80, 141104], [84, 141344], [90, 141524], [101, 142404], [103, 142664], [107, 142824], [111, 142984], [123, 143644], [129, 143924], [138, 144764], [141, 145064], [149, 145384], [154, 145664], [158, 145884], [168, 146384], [171, 146484]]}, {"verse": 20, "start": 147342, "end": 155021, "text": "Y de esta manera me esforcé a predicar el evangelio, no donde antes Cristo fuese nombrado, por no edificar sobre ajeno fundamento:", "words": [[0, 147342], [2, 147463], [5, 147543], [10, 147763], [17, 148103], [20, 148323], [28, 148763], [30, 148863], [39, 149263], [42, 149403], [53, 150423], [56, 150583], [62, 150803], [68, 151123], [75, 151463], [81, 151923], [91, 152523], [95, 152943], [98, 153143], [107, 153563], [113, 153883], [119, 154263]]}, {"verse": 21, "start": 155371, "end": 161221, "text": "Sino, como está escrito: A los que no fue anunciado de él, verán: y los que no oyeron, entenderán.", "words": [[0, 155371], [6, 155649], [11, 155909], [16, 156109], [25, 156887], [27, 156989], [31, 157089], [35, 157249], [38, 157409], [42, 157589], [52, 158129], [55, 158309], [59, 158509], [66, 159254], [68, 159332], [72, 159452], [76, 159632], [79, 159812], [87, 160332]]}, {"verse": 22, "start": 161571, "end": 165419, "text": "Por lo cual aun he sido impedido muchas veces de venir a vosotros.", "words": [[0, 161571], [4, 161679], [7, 161819], [12, 162159], [16, 162699], [19, 162859], [24, 163079], [33, 163579], [40, 163779], [46, 164139], [49, 164359], [55, 164579], [57, 164719]]}, {"verse": 23, "start": 165769, "end": 171341, "text": "Pero ahora no teniendo más lugar en estas regiones, y deseando ir a vosotros desde hace muchos años,", "words": [[0, 165769], [5, 165927], [11, 166227], [14, 166387], [23, 166807], [27, 166987], [33, 167307], [36, 167467], [42, 167667], [52, 168567], [54, 168727], [63, 169207], [66, 169367], [68, 169467], [77, 169887], [83, 170107], [88, 170447], [95, 170707]]}, {"verse": 24, "start": 171691, "end": 179942, "text": "Cuando vaya a España, iré a vosotros; porque espero que pasando os veré, y que seré llevado de vosotros allá, una vez que haya gozado de vosotros.", "words": [[0, 171691], [7, 171855], [12, 172135], [14, 172255], [22, 172595], [26, 173175], [28, 173235], [38, 174138], [45, 174337], [52, 174637], [56, 174817], [64, 175237], [67, 175517], [73, 176077], [75, 176297], [79, 176397], [84, 176697], [92, 177037], [95, 177177], [104, 177617], [110, 177897], [114, 178242], [118, 178462], [122, 178622], [127, 178782], [134, 179262], [137, 179402]]}, {"verse": 25, "start": 180292, "end": 183468, "text": "Pero ahora parto para Jerusalén a ministrar a los santos.", "words": [[0, 180292], [5, 180414], [11, 180694], [17, 181134], [22, 181294], [32, 181741], [34, 182187], [44, 182634], [46, 182694], [50, 182834]]}, {"verse": 26, "start": 183818, "end": 189980, "text": "Porque Macedonia y Acaya tuvieron por bien hacer una colecta para los pobres de los santos que están en Jerusalén.", "words": [[0, 183818], [7, 184045], [17, 184645], [19, 184785], [25, 185145], [34, 185585], [38, 185765], [43, 185985], [49, 186245], [53, 186465], [61, 187025], [66, 187205], [70, 187385], [77, 187765], [80, 187925], [84, 188065], [91, 188605], [95, 188745], [101, 189025], [104, 189185]]}, {"verse": 27, "start": 190330, "end": 200339, "text": "Porque les pareció bueno, y son deudores a ellos: porque si los Gentiles han sido hechos participantes de sus bienes espirituales, deben también ellos servirles en los bienes materiales.", "words": [[0, 190330], [7, 190516], [11, 190676], [19, 191056], [26, 191376], [28, 191776], [32, 191936], [41, 192416], [43, 192576], [50, 193300], [57, 193459], [60, 193619], [64, 193739], [73, 194199], [77, 194419], [82, 194639], [89, 194919], [103, 195699], [106, 195899], [110, 196059], [117, 196459], [131, 197619], [137, 197899], [145, 198219], [151, 198499], [161, 199079], [164, 199199], [168, 199319], [175, 199639]]}, {"verse": 28, "start": 200689, "end": 206316, "text": "Así que, cuando haya concluido esto, y les haya entregado este fruto, pasaré por vosotros a España.", "words": [[0, 200689], [4, 200862], [9, 201022], [16, 201202], [21, 201522], [31, 202122], [37, 202422], [39, 202662], [43, 202782], [48, 203002], [58, 203542], [63, 203742], [70, 204562], [77, 205002], [81, 205102], [90, 205582], [92, 205722]]}, {"verse": 29, "start": 206666, "end": 211470, "text": "Y sé que cuando llegue a vosotros, llegaré con abundancia de la bendición del evangelio de Cristo.", "words": [[0, 206666], [2, 206768], [5, 206868], [9, 207008], [16, 207228], [23, 207588], [25, 207628], [35, 208128], [43, 208588], [47, 208768], [58, 209388], [61, 209528], [64, 209628], [74, 210148], [78, 210328], [88, 210888], [91, 210968]]}, {"verse": 30, "start": 211820, "end": 219049, "text": "Pero os ruego, hermanos, por el Señor nuestro Jesucristo, y por el amor del Espíritu, que me ayudéis con oraciones por mí a Dios,", "words": [[0, 211820], [5, 211999], [8, 212159], [15, 212419], [25, 212959], [29, 213219], [32, 213379], [38, 213599], [46, 213879], [58, 214719], [60, 215159], [64, 215379], [67, 215459], [72, 215699], [76, 215879], [86, 216559], [90, 216859], [93, 216999], [101, 217379], [105, 217579], [115, 218059], [119, 218339], [122, 218592], [124, 218846]]}, {"verse": 31, "start": 219399, "end": 225977, "text": "Que sea librado de los rebeldes que están en Judea, y que la ofrenda de mi servicio a los santos en Jerusalén sea acepta;", "words": [[0, 219399], [4, 219490], [8, 219690], [16, 220190], [19, 220310], [23, 220430], [32, 220950], [36, 221070], [42, 221270], [45, 221390], [52, 222150], [54, 222290], [58, 222410], [61, 222530], [69, 223010], [72, 223110], [75, 223210], [84, 223650], [86, 223810], [90, 223910], [97, 224350], [100, 224450], [110, 224850], [114, 225250]]}, {"verse": 32, "start": 226327, "end": 232471, "text": "Para que con gozo llegue a vosotros por la voluntad de Dios, y que halle descanso juntamente con vosotros.", "words": [[0, 226327], [5, 226480], [9, 226733], [13, 226987], [18, 227240], [25, 227560], [27, 227620], [36, 228100], [40, 228380], [43, 228500], [52, 229000], [55, 229120], [61, 229440], [63, 229900], [67, 230060], [73, 230220], [82, 230880], [93, 231480], [97, 231720]]}, {"verse": 33, "start": 232821, "end": 235812, "text": "Y el Dios de paz sea con todos vosotros. Amén.", "words": [[0, 232821], [2, 232943], [5, 233063], [10, 233263], [13, 233463], [17, 233683], [21, 233943], [25, 234163], [31, 234423], [41, 235313]]}]}