{"book": "MAT", "chapter": 22, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 272296, "verses": [{"verse": 1, "start": 300, "end": 4440, "text": "And Jesus answered and spoke to them again by parables, and said,", "words": [[0, 300], [4, 448], [10, 768], [19, 1388], [23, 1568], [29, 1828], [32, 2048], [37, 2228], [43, 2528], [46, 2788], [56, 3788], [60, 3928]]}, {"verse": 2, "start": 4690, "end": 8695, "text": "The kingdom of heaven is like to a certain king, which made a marriage for his son,", "words": [[0, 4690], [4, 4775], [12, 5055], [15, 5275], [22, 5575], [25, 5815], [30, 6015], [33, 6195], [35, 6335], [43, 6535], [49, 6895], [55, 7195], [60, 7395], [62, 7495], [71, 7795], [75, 7995], [79, 8175]]}, {"verse": 3, "start": 9145, "end": 13597, "text": "And sent forth his servants to call them that were bidden to the wedding: and they would not come.", "words": [[0, 9145], [4, 9249], [9, 9509], [15, 9749], [19, 9949], [28, 10289], [31, 10509], [36, 10749], [41, 10929], [46, 11069], [51, 11209], [58, 11489], [61, 11629], [65, 11749], [74, 12469], [78, 12597], [83, 12717], [89, 12857], [93, 13057]]}, {"verse": 4, "start": 14047, "end": 24700, "text": "Again, he sent forth other servants, saying, Tell them which are bidden, Behold, I have prepared my dinner: my oxen and my fatlings are killed, and all things are ready: come to the marriage.", "words": [[0, 14047], [7, 14486], [10, 14546], [15, 14786], [21, 15026], [27, 15346], [37, 15706], [45, 16386], [50, 16686], [55, 16886], [61, 17086], [65, 17426], [73, 17766], [81, 18466], [83, 18566], [88, 18706], [97, 19026], [100, 19246], [108, 20009], [111, 20157], [116, 20637], [120, 20777], [123, 20937], [132, 21417], [136, 21597], [144, 22357], [148, 22477], [152, 22657], [159, 22897], [163, 23097], [170, 23785], [175, 23925], [178, 24065], [182, 24165]]}, {"verse": 5, "start": 25150, "end": 29805, "text": "But they made light of it, and went their ways, one to his farm, another to his merchandise:", "words": [[0, 25150], [4, 25235], [9, 25355], [14, 25555], [20, 25755], [23, 25935], [27, 26095], [31, 26335], [36, 26495], [42, 26675], [48, 27275], [52, 27435], [55, 27615], [59, 27735], [65, 28355], [73, 28655], [76, 28895], [80, 29035]]}, {"verse": 6, "start": 30255, "end": 34591, "text": "And the remnant took his servants, and entreated them spitefully, and killed them.", "words": [[0, 30255], [4, 30396], [8, 30496], [16, 30876], [21, 31096], [25, 31296], [35, 31656], [39, 32276], [49, 32676], [54, 32936], [66, 33536], [70, 33896], [77, 34196]]}, {"verse": 7, "start": 35041, "end": 42242, "text": "But when the king heard of it, he was angry: and he sent forth his armies, and destroyed those murderers, and burned up their city.", "words": [[0, 35041], [4, 35144], [9, 35284], [13, 35424], [18, 35624], [24, 35864], [27, 36004], [31, 36384], [34, 36484], [38, 36664], [45, 37534], [49, 37660], [52, 37760], [57, 38040], [63, 38300], [67, 38540], [75, 38880], [79, 39440], [89, 39880], [95, 40180], [106, 40800], [110, 41200], [117, 41440], [120, 41640], [126, 41840]]}, {"verse": 8, "start": 42692, "end": 47864, "text": "Then says he to his servants, The wedding is ready, but they which were bidden were not worthy.", "words": [[0, 42692], [5, 42874], [10, 43194], [13, 43434], [16, 43614], [20, 43774], [30, 44494], [34, 44674], [42, 44914], [45, 45114], [52, 45634], [56, 45834], [61, 46054], [67, 46274], [72, 46454], [79, 46914], [84, 47174], [88, 47374]]}, {"verse": 9, "start": 48314, "end": 53313, "text": "Go therefore into the highways, and as many as you shall find, bid to the marriage.", "words": [[0, 48314], [3, 48471], [13, 48851], [18, 49251], [22, 49411], [32, 50391], [36, 50631], [39, 50771], [44, 50991], [47, 51211], [51, 51351], [57, 51491], [63, 51971], [67, 52411], [70, 52631], [74, 52751]]}, {"verse": 10, "start": 53763, "end": 62066, "text": "So those servants went out into the highways, and gathered together all as many as they found, both bad and good: and the wedding was furnished with guests.", "words": [[0, 53763], [3, 53905], [9, 54065], [18, 54385], [23, 54685], [27, 54825], [32, 55025], [36, 55185], [46, 55525], [50, 56125], [59, 56405], [68, 56685], [72, 57085], [75, 57305], [80, 57545], [83, 57725], [88, 57865], [95, 58645], [100, 58745], [104, 59125], [108, 59425], [114, 60178], [118, 60296], [122, 60376], [130, 60596], [134, 60836], [144, 61256], [149, 61396]]}, {"verse": 11, "start": 62516, "end": 67727, "text": "¶ And when the king came in to see the guests, he saw there a man which had not on a wedding garment:", "words": [[2, 62516], [6, 62619], [11, 62759], [15, 62879], [20, 63119], [25, 63379], [28, 63579], [31, 63699], [35, 63839], [39, 63979], [47, 64699], [50, 64959], [54, 65219], [60, 65459], [62, 65599], [66, 65919], [72, 66379], [76, 66539], [80, 66719], [83, 66899], [85, 66979], [93, 67159]]}, {"verse": 12, "start": 68177, "end": 74014, "text": "And he says to him, Friend, how did you come in here not having a wedding garment? And he was speechless.", "words": [[0, 68177], [4, 68321], [7, 68441], [12, 68681], [15, 68901], [20, 69321], [28, 69961], [32, 70141], [36, 70281], [40, 70381], [45, 70581], [48, 70741], [53, 70921], [57, 71121], [64, 71441], [66, 71561], [74, 71761], [83, 72659], [87, 72939], [90, 73039], [94, 73179]]}, {"verse": 13, "start": 74464, "end": 83672, "text": "Then said the king to the servants, Bind him hand and foot, and take him away, and cast him into outer darkness; there shall be weeping and gnashing of teeth.", "words": [[0, 74464], [5, 74759], [10, 75019], [14, 75199], [19, 75439], [22, 75619], [26, 75759], [36, 76439], [41, 76799], [45, 77059], [50, 77379], [54, 77499], [60, 78159], [64, 78219], [69, 78479], [73, 78639], [79, 79279], [83, 79379], [88, 79679], [92, 79939], [97, 80119], [103, 80379], [113, 81425], [119, 81755], [125, 81955], [128, 82115], [136, 82555], [140, 82715], [149, 83175], [152, 83315]]}, {"verse": 14, "start": 84122, "end": 86742, "text": "For many are called, but few are chosen.", "words": [[0, 84170], [4, 84250], [9, 84530], [13, 84750], [21, 85650], [25, 85730], [29, 85970], [33, 86130]]}, {"verse": 15, "start": 87092, "end": 91998, "text": "¶ Then went the Pharisees, and took counsel how they might entangle him in his talk.", "words": [[2, 87092], [7, 87357], [12, 87657], [16, 87877], [27, 88677], [31, 88917], [36, 89137], [44, 89577], [48, 89877], [53, 90057], [59, 90257], [68, 90897], [72, 91097], [75, 91277], [79, 91457]]}, {"verse": 16, "start": 92448, "end": 104365, "text": "And they sent out to him their disciples with the Herodians, saying, Master, we know that you are true, and teach the way of God in truth, neither do you care for any man: for you regard not the person of men.", "words": [[0, 92448], [4, 92594], [9, 92814], [14, 93034], [18, 93234], [21, 93434], [25, 93634], [31, 93854], [41, 94454], [46, 94794], [50, 94954], [61, 95654], [69, 96740], [77, 97101], [80, 97361], [85, 97621], [90, 97821], [94, 97961], [98, 98061], [104, 98401], [108, 98901], [114, 99161], [118, 99361], [122, 99501], [125, 99621], [129, 99841], [132, 99981], [139, 100301], [147, 100801], [150, 101021], [154, 101101], [159, 101341], [163, 101561], [167, 101861], [172, 102606], [176, 102703], [180, 102803], [187, 103103], [191, 103363], [195, 103563], [202, 103863], [205, 104023]]}, {"verse": 17, "start": 104815, "end": 109253, "text": "Tell us therefore, What do you think? Is it lawful to give tribute to Caesar, or not?", "words": [[0, 104815], [5, 104949], [8, 105089], [19, 105429], [24, 105729], [27, 105869], [31, 105929], [38, 106626], [41, 106765], [44, 106865], [51, 107325], [54, 107485], [59, 107665], [67, 107985], [70, 108185], [78, 108505], [81, 108785]]}, {"verse": 18, "start": 109603, "end": 115000, "text": "But Jesus perceived their wickedness, and said, Why do you tempt me, you hypocrites?", "words": [[0, 109603], [4, 109728], [10, 110028], [20, 110628], [26, 110888], [38, 111548], [42, 111988], [48, 112802], [52, 113022], [55, 113242], [59, 113382], [65, 113622], [69, 114022], [73, 114122]]}, {"verse": 19, "start": 115450, "end": 119138, "text": "Show me the tribute money. And they brought to him a denarius.", "words": [[0, 115450], [5, 115678], [8, 115878], [12, 115998], [20, 116278], [27, 117206], [31, 117350], [36, 117450], [44, 117710], [47, 117950], [51, 118110], [53, 118270]]}, {"verse": 20, "start": 119588, "end": 123372, "text": "And he says to them, Whose is this image and inscription?", "words": [[0, 119588], [4, 119714], [7, 119814], [12, 120034], [15, 120254], [21, 121197], [27, 121377], [30, 121517], [35, 121757], [41, 122177], [45, 122557]]}, {"verse": 21, "start": 123722, "end": 134790, "text": "They say to him, Cæsar’s. Then says he to them, Render therefore to Cæsar the things which are Cæsar’s; and to God the things that are God’s.", "words": [[0, 123722], [5, 123828], [9, 124068], [12, 124268], [17, 125178], [26, 125847], [31, 126062], [36, 126322], [39, 126582], [42, 126782], [48, 129375], [55, 129622], [65, 130122], [68, 130402], [74, 130682], [78, 131002], [85, 131342], [91, 131582], [95, 132012], [104, 132684], [108, 132864], [111, 133024], [115, 133304], [119, 133544], [126, 133824], [131, 134064], [135, 134184]]}, {"verse": 22, "start": 135140, "end": 139643, "text": "When they had heard these words, they marvelled, and left him, and went their way.", "words": [[0, 135140], [5, 135257], [10, 135397], [14, 135557], [20, 135777], [26, 135977], [33, 136857], [38, 137307], [49, 137757], [53, 137937], [58, 138217], [63, 138477], [67, 138777], [72, 138957], [78, 139177]]}, {"verse": 23, "start": 140093, "end": 146293, "text": "¶ The same day came to him the Sadducees, which say that there is no resurrection, and asked him,", "words": [[2, 140093], [6, 140198], [11, 140478], [15, 140738], [20, 141018], [23, 141218], [27, 141358], [31, 141518], [42, 142618], [48, 142818], [52, 143118], [57, 143318], [63, 143478], [66, 143638], [69, 143818], [83, 144938], [87, 145118], [93, 145398]]}, {"verse": 24, "start": 146743, "end": 153713, "text": "Saying, Master, Moses said, If a man die, having no children, his brother shall marry his wife, and raise up seed to his brother.", "words": [[0, 146878], [8, 147286], [16, 147586], [22, 147946], [28, 148326], [31, 148586], [33, 148706], [37, 148906], [42, 149206], [49, 149506], [52, 149786], [62, 150626], [66, 150746], [74, 151046], [80, 151266], [86, 151566], [90, 151746], [96, 152026], [100, 152406], [106, 152606], [109, 152796], [114, 152986], [117, 153166], [121, 153286]]}, {"verse": 25, "start": 154163, "end": 161371, "text": "Now there were with us seven brethren: and the first, when he had married a wife, deceased, and, having no issue, left his wife to his brother:", "words": [[0, 154163], [4, 154333], [10, 154543], [15, 154683], [20, 154833], [23, 154983], [29, 155323], [39, 156221], [43, 156326], [47, 156426], [54, 156666], [59, 156846], [62, 156926], [66, 157006], [74, 157246], [76, 157386], [82, 157806], [92, 158106], [97, 158866], [104, 159166], [107, 159386], [114, 159906], [119, 160206], [123, 160406], [128, 160646], [131, 160806], [135, 160926]]}, {"verse": 26, "start": 161821, "end": 165726, "text": "Likewise the second also, and the third, to the seventh.", "words": [[0, 161821], [9, 162146], [13, 162426], [20, 162666], [26, 163066], [30, 163526], [34, 163686], [41, 163906], [44, 164226], [48, 164366]]}, {"verse": 27, "start": 166176, "end": 168000, "text": "And last of all the woman died also.", "words": [[0, 166176], [4, 166298], [9, 166518], [12, 166698], [16, 166898], [20, 166938], [26, 167178], [31, 167438]]}, {"verse": 28, "start": 168450, "end": 172664, "text": "Therefore in the resurrection whose wife shall she be of the seven? for they all had her.", "words": [[0, 168450], [10, 168917], [13, 168977], [17, 169077], [30, 169777], [36, 169857], [41, 170117], [47, 170357], [51, 170517], [54, 170657], [57, 170797], [61, 170917], [68, 171653], [72, 171781], [77, 171961], [81, 172181], [85, 172441]]}, {"verse": 29, "start": 173014, "end": 178440, "text": "Jesus answered and said to them, You do err, not knowing the scriptures, nor the power of God.", "words": [[0, 173014], [6, 173279], [15, 173799], [19, 174019], [24, 174219], [27, 174399], [33, 175118], [37, 175234], [40, 175374], [45, 175694], [49, 175954], [57, 176234], [61, 176414], [73, 176854], [77, 177274], [81, 177494], [87, 177794], [90, 177974]]}, {"verse": 30, "start": 178890, "end": 184664, "text": "For in the resurrection they neither marry, nor are given in marriage, but are as the angels of God in heaven.", "words": [[0, 178890], [4, 178992], [7, 179132], [11, 179212], [24, 179712], [29, 180072], [37, 180332], [44, 180712], [48, 181132], [52, 181372], [58, 181612], [61, 181792], [71, 182372], [75, 182632], [79, 182792], [82, 183032], [86, 183192], [93, 183552], [96, 183772], [100, 184052], [103, 184252]]}, {"verse": 31, "start": 185114, "end": 190648, "text": "But as touching the resurrection of the dead, have you not read that which was spoken to you by God, saying,", "words": [[0, 185114], [4, 185233], [7, 185373], [16, 185693], [20, 185873], [33, 186313], [36, 186573], [40, 186673], [46, 187313], [51, 187533], [55, 187653], [59, 187813], [64, 188013], [69, 188273], [75, 188513], [79, 188633], [86, 188973], [89, 189193], [93, 189333], [96, 189533], [101, 190073]]}, {"verse": 32, "start": 191098, "end": 198678, "text": "I am the God of Abraham, and the God of Isaac, and the God of Jacob? God is not the God of the dead, but of the living.", "words": [[0, 191098], [2, 191340], [5, 191600], [9, 191740], [13, 192080], [16, 192240], [25, 192720], [29, 193140], [33, 193280], [37, 193520], [40, 193660], [47, 194000], [51, 194600], [55, 194740], [59, 194960], [62, 195080], [69, 195943], [73, 196208], [76, 196408], [80, 196588], [84, 196808], [88, 197028], [91, 197168], [95, 197308], [101, 197828], [105, 198008], [108, 198148], [112, 198268]]}, {"verse": 33, "start": 199028, "end": 202849, "text": "And when the multitude heard this, they were astonished at his doctrine.", "words": [[0, 199028], [4, 199153], [9, 199293], [13, 199433], [23, 199793], [29, 200213], [35, 200973], [40, 201133], [45, 201313], [56, 201933], [59, 202073], [63, 202213]]}, {"verse": 34, "start": 203299, "end": 208625, "text": "¶ But when the Pharisees had heard that he had put the Sadducees to silence, they were gathered together.", "words": [[2, 203299], [6, 203421], [11, 203601], [15, 203741], [25, 204361], [29, 204501], [35, 204741], [40, 204961], [43, 205101], [47, 205241], [51, 205421], [55, 205601], [65, 206241], [68, 206361], [77, 207261], [82, 207421], [87, 207581], [96, 207921]]}, {"verse": 35, "start": 209075, "end": 215497, "text": "Then one of them, which was a lawyer, asked him a question, tempting him, and saying,", "words": [[0, 209075], [5, 209344], [9, 209704], [12, 209864], [18, 210164], [24, 210504], [28, 210724], [30, 210844], [38, 211604], [44, 211964], [48, 212144], [50, 212224], [60, 212904], [69, 213204], [74, 213524], [78, 213764]]}, {"verse": 36, "start": 215747, "end": 218216, "text": "Master, which is the great commandment in the law?", "words": [[0, 215747], [8, 216445], [14, 216645], [17, 216765], [21, 216885], [27, 217105], [39, 217645], [42, 217805], [46, 217905]]}, {"verse": 37, "start": 218566, "end": 227971, "text": "Jesus said to him, You shall love the Lord your God with all your heart, and with all your soul, and with all your mind.", "words": [[0, 218566], [6, 218906], [11, 219226], [14, 219426], [19, 222407], [23, 222547], [29, 222747], [34, 223027], [38, 223207], [43, 223447], [48, 223647], [52, 223967], [57, 224207], [61, 224447], [66, 224607], [73, 225007], [77, 225427], [82, 225587], [86, 225807], [91, 225967], [97, 226387], [101, 226887], [106, 227027], [110, 227247], [115, 227407]]}, {"verse": 38, "start": 228421, "end": 230285, "text": "This is the first and great commandment.", "words": [[0, 228421], [5, 228565], [8, 228685], [12, 228805], [18, 229065], [22, 229325], [28, 229525]]}, {"verse": 39, "start": 230735, "end": 234590, "text": "And the second is like to it, You shall love your neighbour as yourself.", "words": [[0, 230735], [4, 230875], [8, 230995], [15, 231295], [18, 231675], [23, 231895], [26, 232115], [30, 232615], [34, 232815], [40, 232995], [45, 233275], [50, 233505], [60, 233735], [63, 234055]]}, {"verse": 40, "start": 235040, "end": 238308, "text": "On these two commandments hang all the law and the prophets.", "words": [[0, 235040], [3, 235188], [9, 235408], [13, 235648], [26, 236108], [31, 236488], [35, 236808], [39, 236948], [43, 237268], [47, 237508], [51, 237628]]}, {"verse": 41, "start": 238658, "end": 242301, "text": "¶ While the Pharisees were gathered together, Jesus asked them,", "words": [[2, 238658], [8, 238804], [12, 238944], [22, 239444], [27, 239564], [36, 239844], [46, 240664], [52, 241024], [58, 241464]]}, {"verse": 42, "start": 242751, "end": 251546, "text": "Saying, What do you think of Christ? whose son is he? They say to him, The Son of David.", "words": [[0, 242922], [8, 243378], [13, 243548], [16, 243708], [20, 243808], [26, 244008], [29, 244168], [37, 245137], [43, 245288], [47, 245688], [50, 245948], [52, 247894], [54, 249435], [59, 249565], [63, 249805], [66, 250005], [71, 250698], [75, 250795], [79, 251015], [82, 251115]]}, {"verse": 43, "start": 251896, "end": 256136, "text": "He says to them, How then does David in spirit call him Lord, saying,", "words": [[0, 251896], [3, 251986], [8, 252186], [11, 252406], [17, 253057], [21, 253242], [26, 253462], [31, 253682], [37, 254022], [40, 254182], [47, 254522], [52, 254822], [56, 255042], [62, 255582]]}, {"verse": 44, "start": 256586, "end": 261741, "text": "The LORD said to my Lord, Sit you on my right hand, till I make your enemies your footstool?", "words": [[0, 256586], [4, 256664], [9, 256924], [14, 257224], [17, 257424], [20, 257584], [26, 258164], [30, 258344], [34, 258604], [37, 258744], [40, 258884], [46, 259104], [52, 259644], [57, 259904], [59, 260044], [64, 260224], [69, 260424], [77, 260764], [82, 261024]]}, {"verse": 45, "start": 262191, "end": 265313, "text": "If David then call him Lord, how is he his son?", "words": [[0, 262191], [3, 262335], [9, 262655], [14, 262875], [19, 263135], [23, 263335], [29, 264075], [33, 264255], [36, 264435], [39, 264615], [43, 264835]]}, {"verse": 46, "start": 265663, "end": 271896, "text": "And no man was able to answer him a word, neither dared any man from that day forth ask him any more questions.", "words": [[0, 265663], [4, 265814], [7, 266014], [11, 266294], [15, 266514], [20, 266734], [23, 266854], [30, 267174], [34, 267434], [36, 267534], [42, 268054], [50, 268234], [56, 268594], [60, 268894], [64, 269234], [69, 269414], [74, 269634], [78, 269834], [84, 270154], [88, 270454], [92, 270654], [96, 270854], [101, 271074]]}]}