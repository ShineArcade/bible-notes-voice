{"book": "GEN", "chapter": 30, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 335419, "verses": [{"verse": 1, "start": 300, "end": 9207, "text": "And when Rachel saw that she bore Jacob no children, Rachel envied her sister; and said to Jacob, Give me children, or else I die.", "words": [[0, 300], [4, 433], [9, 573], [16, 933], [20, 1353], [25, 1553], [29, 1733], [34, 1973], [40, 2353], [43, 2653], [53, 3533], [60, 3973], [67, 4553], [71, 4693], [79, 5632], [83, 5739], [88, 5959], [91, 6139], [98, 6910], [103, 7050], [106, 7230], [116, 7990], [119, 8210], [124, 8450], [126, 8670]]}, {"verse": 2, "start": 9557, "end": 17365, "text": "And Jacob’s anger was kindled against Rachel: and he said, Am I in God’s stead, who has withheld from you the fruit of the womb?", "words": [[0, 9557], [4, 9687], [12, 10147], [18, 10427], [22, 10667], [30, 11187], [38, 11487], [46, 12448], [50, 12592], [53, 12692], [59, 13377], [62, 13537], [64, 13737], [67, 13917], [73, 14357], [80, 15037], [84, 15157], [88, 15337], [97, 15757], [102, 15957], [106, 16177], [110, 16357], [116, 16617], [119, 16817], [123, 16937]]}, {"verse": 3, "start": 17715, "end": 25891, "text": "And she said, Behold my maid Bilhah, go in to her; and she shall bear upon my knees, that I may also have children by her.", "words": [[0, 17715], [4, 17818], [8, 17978], [14, 18829], [21, 19009], [24, 19289], [29, 19729], [37, 20469], [40, 20656], [43, 20842], [46, 21029], [51, 21781], [55, 21886], [59, 22066], [65, 22266], [70, 22526], [75, 22786], [78, 23106], [85, 23446], [90, 23926], [92, 24146], [96, 24306], [101, 24666], [106, 24966], [115, 25286], [118, 25566]]}, {"verse": 4, "start": 26241, "end": 30558, "text": "And she gave him Bilhah her handmaid to wife: and Jacob went in to her.", "words": [[0, 26241], [4, 26357], [8, 26497], [13, 26757], [17, 27227], [24, 27697], [28, 27797], [37, 28377], [40, 28497], [46, 29137], [50, 29282], [56, 29582], [61, 29795], [64, 30009], [67, 30222]]}, {"verse": 5, "start": 31008, "end": 33986, "text": "And Bilhah conceived, and bore Jacob a son.", "words": [[0, 31008], [4, 31452], [11, 31912], [22, 32392], [26, 32732], [31, 32952], [37, 33292], [39, 33512]]}, {"verse": 6, "start": 34436, "end": 43104, "text": "And Rachel said, God has judged me, and has also heard my voice, and has given me a son: therefore called she his name Dan.", "words": [[0, 34436], [4, 34796], [11, 35280], [17, 35943], [21, 36163], [25, 36423], [32, 36763], [36, 37083], [40, 37563], [44, 37723], [49, 38123], [55, 38423], [58, 38603], [65, 39023], [69, 39483], [73, 39643], [79, 39863], [82, 40083], [84, 40183], [89, 41074], [99, 41384], [106, 41744], [110, 42004], [114, 42264], [119, 42584]]}, {"verse": 7, "start": 43554, "end": 48207, "text": "And Bilhah Rachel’s maid conceived again, and bore Jacob a second son.", "words": [[0, 43554], [4, 43696], [11, 44096], [20, 44636], [25, 44896], [35, 45336], [42, 46276], [46, 46456], [51, 46676], [57, 47036], [59, 47256], [66, 47516]]}, {"verse": 8, "start": 48657, "end": 56672, "text": "And Rachel said, With great wrestlings have I wrestled with my sister, and I have prevailed: and she called his name Naphtali.", "words": [[0, 48657], [4, 48803], [11, 49235], [17, 49848], [22, 49980], [28, 50280], [39, 50960], [44, 51120], [46, 51280], [55, 51740], [60, 51880], [63, 52100], [71, 52980], [75, 53160], [77, 53340], [82, 53500], [93, 54652], [97, 54758], [101, 54918], [108, 55198], [112, 55438], [117, 56080]]}, {"verse": 9, "start": 57122, "end": 62539, "text": "When Leah saw that she had left bearing, she took Zilpah her maid, and gave her Jacob to wife.", "words": [[0, 57122], [5, 57289], [10, 57569], [14, 57949], [19, 58169], [23, 58369], [27, 58509], [32, 58749], [41, 59509], [45, 59609], [50, 59949], [57, 60289], [61, 60469], [67, 60789], [71, 61249], [76, 61449], [80, 61629], [86, 61929], [89, 62169]]}, {"verse": 10, "start": 62989, "end": 65804, "text": "And Zilpah Leah’s maid bore Jacob a son.", "words": [[0, 62989], [4, 63332], [11, 63676], [18, 64019], [23, 64339], [28, 64739], [34, 65099], [36, 65299]]}, {"verse": 11, "start": 66254, "end": 70740, "text": "And Leah said, A troop comes: and she called his name Gad.", "words": [[0, 66254], [4, 66432], [9, 66692], [15, 67526], [17, 67606], [23, 67926], [30, 69073], [34, 69180], [38, 69320], [45, 69640], [49, 69880], [54, 70120]]}, {"verse": 12, "start": 71190, "end": 73916, "text": "And Zilpah Leah’s maid bore Jacob a second son.", "words": [[0, 71190], [4, 71433], [11, 71718], [18, 72003], [23, 72288], [28, 72568], [34, 72928], [36, 73148], [43, 73368]]}, {"verse": 13, "start": 74366, "end": 80288, "text": "And Leah said, Happy am I, for the daughters will call me blessed: and she called his name Asher.", "words": [[0, 74366], [4, 74509], [9, 74689], [15, 75461], [21, 75681], [24, 75861], [27, 76061], [31, 76221], [35, 76341], [45, 76681], [50, 76961], [55, 77201], [58, 77401], [67, 78448], [71, 78563], [75, 78703], [82, 79003], [86, 79223], [91, 79523]]}, {"verse": 14, "start": 80738, "end": 92246, "text": "¶ And Reuben went in the days of wheat harvest, and found mandrakes in the field, and brought them to his mother Leah. Then Rachel said to Leah, Give me, please, of your son’s mandrakes.", "words": [[2, 80738], [6, 80991], [13, 81281], [18, 81461], [21, 81641], [25, 81721], [30, 82001], [33, 82181], [39, 82361], [48, 82741], [52, 83361], [58, 83641], [68, 84261], [71, 84401], [75, 84501], [82, 84881], [86, 85341], [94, 85561], [99, 85801], [102, 85961], [106, 86141], [113, 86381], [119, 87252], [124, 87672], [131, 87972], [136, 88272], [139, 88452], [145, 89171], [150, 89439], [154, 89699], [162, 90179], [165, 90679], [170, 90839], [176, 91359]]}, {"verse": 15, "start": 92596, "end": 104715, "text": "And she said to her, Is it a small matter that you have taken my husband? and would you take away my son’s mandrakes also? And Rachel said, Therefore he shall lie with you tonight for your son’s mandrakes.", "words": [[0, 92596], [4, 92721], [8, 92841], [13, 93081], [16, 93281], [21, 93839], [24, 93955], [27, 94075], [29, 94175], [35, 94475], [42, 94855], [47, 95095], [51, 95255], [56, 95355], [62, 95595], [65, 95835], [74, 96857], [78, 96986], [84, 97146], [88, 97306], [93, 97526], [98, 97766], [101, 97986], [107, 98366], [117, 98886], [123, 99877], [127, 100046], [134, 100406], [140, 101241], [150, 101885], [153, 101985], [159, 102185], [163, 102465], [168, 102665], [172, 102785], [180, 103105], [184, 103365], [189, 103505], [195, 103945]]}, {"verse": 16, "start": 105065, "end": 117419, "text": "And Jacob came out of the field in the evening, and Leah went out to meet him, and said, You must come in to me; for surely I have hired you with my son’s mandrakes. And he lay with her that night.", "words": [[0, 105065], [4, 105208], [10, 105528], [15, 105868], [19, 106088], [22, 106228], [26, 106348], [32, 106648], [35, 106828], [39, 106928], [48, 107868], [52, 107948], [57, 108188], [62, 108468], [66, 108608], [69, 108808], [74, 109008], [79, 109288], [83, 109508], [89, 110210], [93, 110438], [98, 110678], [103, 110925], [106, 111171], [109, 111418], [113, 112151], [117, 112304], [124, 112784], [126, 113124], [131, 113304], [137, 113664], [141, 113884], [146, 114084], [149, 114284], [155, 114724], [166, 115925], [170, 116059], [173, 116179], [177, 116359], [182, 116619], [186, 116759], [191, 116979]]}, {"verse": 17, "start": 117869, "end": 122129, "text": "And God hearkened to Leah, and she conceived, and bore Jacob the fifth son.", "words": [[0, 117869], [4, 117996], [8, 118296], [18, 118756], [21, 118936], [27, 119376], [31, 119456], [35, 119636], [46, 120396], [50, 120516], [55, 120756], [61, 121136], [65, 121356], [71, 121556]]}, {"verse": 18, "start": 122579, "end": 131051, "text": "And Leah said, God has given me my hire, because I have given my maiden to my husband: and she called his name Issachar.", "words": [[0, 122579], [4, 122724], [9, 122964], [15, 123774], [19, 123994], [23, 124254], [29, 124514], [32, 124794], [35, 124994], [41, 125794], [49, 126094], [51, 126334], [56, 126454], [62, 126734], [65, 126934], [72, 127294], [75, 127594], [78, 127774], [87, 128755], [91, 128884], [95, 129024], [102, 129364], [106, 129624], [111, 130370]]}, {"verse": 19, "start": 131501, "end": 135002, "text": "And Leah conceived again, and bore Jacob the sixth son.", "words": [[0, 131501], [4, 131687], [9, 131927], [19, 132387], [26, 132887], [30, 133287], [35, 133507], [41, 133927], [45, 134147], [51, 134407]]}, {"verse": 20, "start": 135452, "end": 145783, "text": "And Leah said, God has endued me with a good dowry; now will my husband dwell with me, because I have born him six sons: and she called his name Zebulun.", "words": [[0, 135452], [4, 135759], [9, 135939], [15, 136705], [19, 136940], [23, 137240], [30, 137720], [33, 137840], [38, 138040], [40, 138160], [45, 138340], [52, 139312], [56, 139596], [61, 139816], [64, 140016], [72, 140336], [78, 140676], [83, 140956], [87, 141336], [95, 141696], [97, 141936], [102, 142216], [107, 142496], [111, 142616], [115, 142876], [121, 143939], [125, 144039], [129, 144179], [136, 144439], [140, 144659], [145, 144919]]}, {"verse": 21, "start": 146233, "end": 149858, "text": "And afterwards she bore a daughter, and called her name Dinah.", "words": [[0, 146233], [4, 146370], [15, 146750], [19, 147210], [24, 147470], [26, 147610], [36, 147910], [40, 148430], [47, 148710], [51, 148930], [56, 149190]]}, {"verse": 22, "start": 150308, "end": 155034, "text": "¶ And God remembered Rachel, and God hearkened to her, and opened her womb.", "words": [[2, 150308], [6, 150451], [10, 150711], [21, 151071], [29, 152111], [33, 152191], [37, 152511], [47, 153011], [50, 153191], [55, 153771], [59, 153831], [66, 154191], [70, 154451]]}, {"verse": 23, "start": 155484, "end": 161161, "text": "And she conceived, and bore a son; and said, God has taken away my reproach:", "words": [[0, 155484], [4, 155603], [8, 155743], [19, 156323], [23, 156623], [28, 156903], [30, 157123], [35, 157936], [39, 158060], [45, 158791], [49, 159111], [53, 159431], [59, 159711], [64, 160051], [67, 160331]]}, {"verse": 24, "start": 161511, "end": 166533, "text": "And she called his name Joseph; and said, The LORD shall add to me another son.", "words": [[0, 161511], [4, 161622], [8, 161762], [15, 162082], [19, 162282], [24, 162542], [32, 163526], [36, 163666], [42, 164239], [46, 164343], [51, 164603], [57, 164863], [61, 165163], [64, 165343], [67, 165523], [75, 165863]]}, {"verse": 25, "start": 166883, "end": 174615, "text": "¶ And it came to pass, when Rachel had born Joseph, that Jacob said to Laban, Send me away, that I may go to my own place, and to my country.", "words": [[2, 166883], [6, 167027], [9, 167087], [14, 167267], [17, 167407], [23, 167707], [28, 168047], [35, 168367], [39, 168627], [44, 168887], [52, 169767], [57, 169987], [63, 170307], [68, 170607], [71, 170787], [78, 171592], [83, 171706], [86, 171936], [92, 172166], [97, 172366], [99, 172466], [103, 172586], [106, 172806], [109, 172966], [112, 173146], [116, 173286], [123, 173566], [127, 173846], [130, 174006], [133, 174126]]}, {"verse": 26, "start": 175065, "end": 181438, "text": "Give me my wives and my children, for whom I have served you, and let me go: for you know my service which I have done you.", "words": [[0, 175065], [5, 175208], [8, 175368], [11, 175548], [17, 175888], [21, 176168], [24, 176308], [34, 176628], [38, 176948], [43, 177128], [45, 177328], [50, 177428], [57, 177688], [62, 177908], [66, 178308], [70, 178488], [73, 178648], [77, 179299], [81, 179437], [85, 179617], [90, 179757], [93, 179917], [101, 180337], [107, 180597], [109, 180777], [114, 180957], [119, 181137]]}, {"verse": 27, "start": 181788, "end": 190187, "text": "And Laban said to him, please, if I have found favour in your eyes, stay: for I have learned by experience that the LORD has blessed me for your sake.", "words": [[0, 181788], [4, 181953], [10, 182433], [15, 182713], [18, 182933], [23, 183459], [31, 183897], [34, 184017], [36, 184177], [41, 184317], [47, 184557], [54, 184797], [57, 185097], [62, 185217], [68, 185797], [74, 186591], [78, 186717], [80, 186897], [85, 187057], [93, 187317], [96, 187497], [107, 188017], [112, 188377], [116, 188517], [121, 188717], [125, 188937], [133, 189197], [136, 189477], [140, 189657], [145, 189777]]}, {"verse": 28, "start": 190537, "end": 194610, "text": "And he said, Appoint me your wages, and I will give it.", "words": [[0, 190537], [4, 190672], [7, 190812], [13, 192270], [21, 192550], [24, 192790], [29, 192930], [36, 193290], [40, 193870], [42, 194030], [47, 194170], [52, 194350]]}, {"verse": 29, "start": 194960, "end": 199342, "text": "And he said to him, You know how I have served you, and how your cattle was with me.", "words": [[0, 194960], [4, 195086], [7, 195186], [12, 195406], [15, 195606], [20, 196258], [24, 196404], [29, 196584], [33, 196784], [35, 197004], [40, 197124], [47, 197404], [52, 197644], [56, 198004], [60, 198164], [65, 198304], [72, 198624], [76, 198884], [81, 199084]]}, {"verse": 30, "start": 199792, "end": 209460, "text": "For it was little which you had before I came, and it is now increased to a multitude; and the LORD has blessed you since my coming: and now when shall I provide for my own house also?", "words": [[0, 199792], [4, 199912], [7, 200032], [11, 200172], [18, 200452], [24, 200672], [28, 200792], [32, 200932], [39, 201232], [41, 201432], [47, 201972], [51, 202092], [54, 202212], [57, 202352], [61, 202532], [71, 203012], [74, 203232], [76, 203312], [87, 204239], [91, 204383], [95, 204503], [100, 204703], [104, 204943], [112, 205243], [116, 205543], [122, 205763], [125, 206023], [133, 206816], [137, 206940], [141, 207260], [146, 207360], [152, 207560], [154, 207680], [162, 208020], [166, 208240], [169, 208440], [173, 208560], [179, 208860]]}, {"verse": 31, "start": 209810, "end": 219775, "text": "And he said, What shall I give you? And Jacob said, You shall not give me any thing: if you will do this thing for me, I will again feed and keep your flock:", "words": [[0, 209810], [4, 209945], [7, 210085], [13, 211543], [18, 211683], [24, 211903], [26, 212023], [31, 212243], [36, 212932], [40, 213079], [46, 213379], [52, 214130], [56, 214267], [62, 214487], [66, 214747], [71, 215007], [74, 215327], [78, 215647], [85, 216250], [88, 216393], [92, 216553], [97, 216673], [100, 216833], [105, 217033], [111, 217253], [115, 217433], [119, 217893], [121, 217993], [126, 218153], [132, 218453], [137, 218773], [141, 218953], [146, 219153], [151, 219293]]}, {"verse": 32, "start": 220225, "end": 232166, "text": "I will pass through all your flock today, removing from there all the speckled and spotted cattle, and all the brown cattle among the sheep, and the spotted and speckled among the goats: and of such shall be my hire.", "words": [[0, 220225], [2, 220345], [7, 220465], [12, 220805], [20, 221085], [24, 221365], [29, 221525], [35, 221805], [42, 222565], [51, 222865], [56, 223145], [62, 223385], [66, 223685], [70, 223865], [79, 224285], [83, 224405], [91, 224705], [99, 225125], [103, 225585], [107, 225805], [111, 225945], [117, 226185], [124, 226525], [130, 226785], [134, 226985], [141, 227655], [145, 227796], [149, 227916], [157, 228296], [161, 228576], [170, 229056], [176, 229256], [180, 229456], [187, 230276], [191, 230432], [194, 230592], [199, 230852], [205, 231192], [208, 231412], [211, 231672]]}, {"verse": 33, "start": 232616, "end": 244656, "text": "So shall my righteousness answer for me in time to come, when it shall come for my hire before your face: every one that is not speckled and spotted among the goats, and brown among the sheep, that shall be counted stolen with me.", "words": [[0, 232616], [3, 232778], [9, 232998], [12, 233198], [26, 233618], [33, 234158], [37, 234398], [40, 234578], [43, 234818], [48, 235078], [51, 235258], [57, 235578], [62, 235998], [65, 236138], [71, 236258], [76, 236538], [80, 236718], [83, 236898], [88, 237258], [95, 237618], [100, 237858], [106, 238774], [112, 238894], [116, 239014], [121, 239414], [124, 239534], [128, 239714], [137, 240254], [141, 240354], [149, 240654], [155, 240894], [159, 241094], [166, 241334], [170, 241639], [176, 241959], [182, 242199], [186, 242419], [193, 242719], [198, 243039], [204, 243239], [207, 243379], [215, 243699], [222, 244139], [227, 244379]]}, {"verse": 34, "start": 245006, "end": 249028, "text": "And Laban said, Behold, I would it might be according to your word.", "words": [[0, 245006], [4, 245378], [10, 245778], [16, 246431], [24, 246830], [26, 247110], [32, 247310], [35, 247450], [41, 247630], [44, 247870], [54, 248170], [57, 248430], [62, 248590]]}, {"verse": 35, "start": 249378, "end": 263788, "text": "And he removed that day the he goats that were streaked and spotted, and all the she goats that were speckled and spotted, and every one that had some white in it, and all the brown among the sheep, and gave them into the hand of his sons.", "words": [[0, 249378], [4, 249521], [7, 249601], [15, 249961], [20, 250241], [24, 250481], [28, 250681], [31, 250861], [37, 251161], [42, 251401], [47, 251541], [56, 251941], [60, 252081], [69, 252461], [73, 253141], [77, 253341], [81, 253501], [85, 253641], [91, 253941], [96, 254181], [101, 254321], [110, 254801], [114, 254961], [123, 256870], [127, 256982], [133, 257222], [137, 257522], [142, 257682], [146, 257882], [151, 258122], [157, 258482], [160, 258702], [164, 259122], [168, 259322], [172, 259582], [176, 259762], [182, 260102], [188, 260422], [192, 260702], [199, 261442], [203, 261642], [208, 261862], [213, 262122], [218, 262362], [222, 262542], [227, 262842], [230, 262982], [234, 263142]]}, {"verse": 36, "start": 264238, "end": 270396, "text": "And he set three days’ journey between himself and Jacob: and Jacob fed the rest of Laban’s flocks.", "words": [[0, 264238], [4, 264370], [7, 264490], [11, 264730], [17, 265070], [23, 265310], [31, 265750], [39, 266110], [47, 266650], [51, 266970], [58, 267844], [62, 267967], [68, 268267], [72, 268667], [76, 268847], [81, 269087], [84, 269227], [92, 269787]]}, {"verse": 37, "start": 270846, "end": 280138, "text": "¶ And Jacob took him rods of green poplar, and of the hazel and chestnut tree; and peeled white strakes in them, and made the white appear which was in the rods.", "words": [[2, 270846], [6, 270989], [12, 271309], [17, 271549], [21, 271729], [26, 272069], [29, 272229], [35, 272509], [43, 273069], [47, 273469], [50, 273589], [54, 273729], [60, 274229], [64, 274349], [73, 274829], [79, 275606], [83, 275734], [90, 276014], [96, 276454], [104, 276894], [107, 277094], [113, 277254], [117, 277714], [122, 277914], [126, 278074], [132, 278294], [139, 278714], [145, 279014], [149, 279214], [152, 279374], [156, 279474]]}, {"verse": 38, "start": 280588, "end": 290252, "text": "And he set the rods which he had peeled before the flocks in the gutters in the watering troughs when the flocks came to drink, that they should conceive when they came to drink.", "words": [[0, 280588], [4, 280710], [7, 280830], [11, 281110], [15, 281290], [20, 281770], [26, 282110], [29, 282290], [33, 282450], [40, 282870], [47, 283230], [51, 283450], [58, 283930], [61, 284090], [65, 284190], [73, 284590], [76, 284850], [80, 284950], [89, 285330], [97, 285850], [102, 286070], [106, 286170], [113, 286570], [118, 286790], [121, 286990], [128, 287763], [133, 288083], [138, 288243], [145, 288423], [154, 289003], [159, 289303], [164, 289463], [169, 289683], [172, 289863]]}, {"verse": 39, "start": 290702, "end": 296688, "text": "And the flocks conceived before the rods, and brought forth cattle streaked, speckled, and spotted.", "words": [[0, 290702], [4, 290855], [8, 290935], [15, 291355], [25, 291835], [32, 292235], [36, 292475], [42, 293315], [46, 293475], [54, 293695], [60, 294015], [67, 294415], [77, 295315], [87, 295995], [91, 296055]]}, {"verse": 40, "start": 297138, "end": 30899