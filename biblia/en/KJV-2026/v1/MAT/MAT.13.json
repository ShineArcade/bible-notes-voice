{"book": "MAT", "chapter": 13, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 422350, "verses": [{"verse": 1, "start": 300, "end": 3927, "text": "The same day went Jesus out of the house, and sat by the sea side.", "words": [[0, 300], [4, 380], [9, 640], [13, 880], [18, 1100], [24, 1460], [28, 1800], [31, 1920], [35, 2020], [42, 2320], [46, 2580], [50, 2820], [53, 3060], [57, 3362], [61, 3664]]}, {"verse": 2, "start": 4277, "end": 11584, "text": "And great multitudes were gathered together to him, so that he went into a ship, and sat; and the whole multitude stood on the shore.", "words": [[0, 4277], [4, 4401], [10, 4621], [21, 5321], [26, 5481], [35, 5781], [44, 6141], [47, 6401], [52, 6821], [55, 7061], [60, 7221], [63, 7321], [68, 7501], [73, 7741], [75, 7881], [81, 8181], [85, 8521], [90, 9275], [94, 9402], [98, 9522], [104, 9762], [114, 10382], [120, 10722], [123, 10962], [127, 11082]]}, {"verse": 3, "start": 11934, "end": 17217, "text": "And he spoke many things to them in parables, saying, Behold, a sower went forth to sow;", "words": [[0, 11934], [4, 12037], [7, 12157], [13, 12437], [18, 12797], [25, 13137], [28, 13357], [33, 13557], [36, 13676], [46, 14357], [54, 15136], [62, 15699], [64, 15699], [70, 16039], [75, 16239], [81, 16499], [84, 16759]]}, {"verse": 4, "start": 17567, "end": 22895, "text": "And when he sowed, some seeds fell by the way side, and the fowls came and devoured them up:", "words": [[0, 17567], [4, 17688], [9, 17848], [12, 17988], [19, 18568], [24, 18728], [30, 19108], [35, 19408], [38, 19628], [42, 19981], [46, 20335], [52, 20688], [56, 20848], [60, 20968], [66, 21388], [71, 21668], [75, 21868], [84, 22308], [89, 22468]]}, {"verse": 5, "start": 23245, "end": 30366, "text": "Some fell upon stony places, where they had not much earth: and forthwith they sprung up, because they had no deepness of earth:", "words": [[0, 23245], [5, 23469], [10, 23749], [15, 24029], [21, 24549], [29, 25349], [35, 25569], [40, 25709], [44, 25909], [48, 26089], [53, 26349], [60, 26899], [64, 27016], [74, 27636], [79, 27876], [86, 28296], [90, 28476], [98, 28916], [103, 29136], [107, 29316], [110, 29476], [119, 29956], [122, 30116]]}, {"verse": 6, "start": 30716, "end": 35964, "text": "And when the sun was up, they were scorched; and because they had no root, they withered away.", "words": [[0, 30716], [4, 30836], [9, 30956], [13, 31116], [17, 31336], [21, 31556], [25, 32016], [30, 32096], [35, 32236], [45, 33125], [49, 33250], [57, 33550], [62, 33830], [66, 34030], [69, 34210], [75, 34970], [80, 35070], [89, 35430]]}, {"verse": 7, "start": 36314, "end": 40513, "text": "And some fell among thorns; and the thorns sprung up, and choked them:", "words": [[0, 36314], [4, 36478], [9, 36778], [14, 37138], [20, 37458], [28, 38490], [32, 38610], [36, 38710], [43, 39030], [50, 39470], [54, 39630], [58, 39810], [65, 40170]]}, {"verse": 8, "start": 40863, "end": 47191, "text": "But other fell into good ground, and brought forth fruit, some a hundredfold, some sixtyfold, some thirtyfold.", "words": [[0, 40863], [4, 40985], [10, 41205], [15, 41485], [20, 41685], [25, 41925], [33, 42305], [37, 42570], [45, 42770], [51, 43070], [58, 43750], [63, 44130], [65, 44410], [78, 45190], [83, 45390], [94, 46250], [99, 46390]]}, {"verse": 9, "start": 47541, "end": 49987, "text": "Who has ears to hear, let him hear.", "words": [[0, 47541], [4, 47821], [8, 48021], [13, 48321], [16, 48541], [22, 49101], [26, 49361], [30, 49581]]}, {"verse": 10, "start": 50267, "end": 54559, "text": "And the disciples came, and said to him, Why do you speak to them in parables?", "words": [[0, 50267], [4, 50391], [8, 50511], [18, 50971], [24, 51391], [28, 51911], [33, 52171], [36, 52391], [41, 52995], [45, 53110], [48, 53230], [52, 53290], [58, 53470], [61, 53650], [66, 53810], [69, 53930]]}, {"verse": 11, "start": 54839, "end": 62580, "text": "He answered and said to them, Because it is given to you to know the mysteries of the kingdom of heaven, but to them it is not given.", "words": [[0, 54839], [3, 54931], [12, 55311], [16, 55551], [21, 55791], [24, 55991], [30, 56529], [38, 56814], [41, 57034], [44, 57174], [50, 57414], [53, 57674], [57, 57854], [60, 58074], [65, 58334], [69, 58534], [79, 58994], [82, 59274], [86, 59374], [94, 59654], [97, 59894], [105, 60554], [109, 60914], [112, 61094], [117, 61354], [120, 61674], [123, 61814], [127, 62054]]}, {"verse": 12, "start": 62930, "end": 70586, "text": "For whoever has, to him shall be given, and he shall have more abundance: but whoever has not, from him shall be taken away even that he has.", "words": [[0, 62930], [4, 63055], [12, 63355], [17, 63715], [20, 63915], [24, 64075], [30, 64255], [33, 64395], [40, 64915], [44, 65195], [47, 65315], [53, 65475], [58, 65735], [63, 65935], [74, 66862], [78, 66966], [86, 67206], [90, 67526], [95, 67826], [100, 68146], [104, 68366], [110, 68646], [113, 68786], [119, 69046], [124, 69366], [129, 69766], [134, 70006], [137, 70146]]}, {"verse": 13, "start": 70936, "end": 78276, "text": "Therefore speak I to them in parables: because they seeing see not; and hearing they hear not, neither do they understand.", "words": [[0, 70936], [10, 71228], [16, 71528], [18, 71828], [21, 71928], [26, 72088], [29, 72228], [39, 73208], [47, 73532], [52, 73972], [59, 74332], [63, 74612], [68, 75361], [72, 75506], [80, 75766], [85, 75986], [90, 76226], [95, 76806], [103, 77006], [106, 77266], [111, 77426]]}, {"verse": 14, "start": 78626, "end": 88688, "text": "And in them is fulfilled the prophecy of Esaias, which says, By hearing you shall hear, and shall not understand; and seeing you shall see, and shall not perceive:", "words": [[0, 78626], [4, 78767], [7, 78987], [12, 79147], [15, 79447], [25, 79847], [29, 80127], [38, 80587], [41, 81087], [49, 81587], [55, 81767], [61, 82427], [64, 82627], [72, 82927], [76, 83227], [82, 83467], [88, 84207], [92, 84307], [98, 84507], [102, 84767], [114, 85854], [118, 85977], [125, 86277], [129, 86577], [135, 86817], [140, 87117], [144, 87517], [150, 87737], [154, 87957]]}, {"verse": 15, "start": 89038, "end": 103392, "text": "For this people’s heart has grown dull, and their ears are dull of hearing, and their eyes they have closed; lest at any time they should see with their eyes, and hear with their ears, and should understand with their heart, and should be converted, and I should heal them.", "words": [[0, 89038], [4, 89128], [9, 89308], [18, 89788], [24, 89988], [28, 90248], [34, 90488], [40, 91088], [44, 91348], [50, 91468], [55, 91828], [59, 92048], [64, 92268], [67, 92448], [76, 93068], [80, 93248], [86, 93408], [91, 93708], [96, 93968], [101, 94088], [109, 94973], [114, 95272], [117, 95392], [121, 95612], [126, 96032], [131, 96252], [138, 96432], [142, 96692], [147, 96852], [153, 97032], [159, 97772], [163, 97952], [168, 98172], [173, 98332], [179, 98512], [185, 99332], [189, 99412], [196, 99552], [207, 100032], [212, 100272], [218, 100452], [225, 101092], [229, 101232], [236, 101372], [239, 101512], [250, 102432], [254, 102532], [256, 102672], [263, 102832], [268, 103052]]}, {"verse": 16, "start": 103742, "end": 108193, "text": "But blessed are your eyes, for they see: and your ears, for they hear.", "words": [[0, 103742], [4, 103866], [12, 104246], [16, 104606], [21, 104766], [27, 105246], [31, 105626], [36, 105826], [41, 106426], [45, 106553], [50, 106693], [56, 107113], [60, 107553], [65, 107733]]}, {"verse": 17, "start": 108543, "end": 119255, "text": "For indeed I say to you, That many prophets and righteous men have desired to see those things which you see, and have not seen them; and to hear those things which you hear, and have not heard them.", "words": [[0, 108543], [4, 108712], [11, 109012], [13, 109292], [17, 109512], [20, 109732], [25, 110012], [30, 110552], [35, 110792], [44, 111272], [48, 111612], [58, 111932], [62, 112352], [67, 112592], [75, 112972], [78, 113232], [82, 113432], [88, 113652], [95, 114032], [101, 114252], [105, 114432], [110, 114752], [114, 114967], [119, 115107], [123, 115307], [128, 115587], [134, 116067], [138, 116205], [141, 116345], [146, 116565], [152, 116785], [159, 117165], [165, 117405], [169, 117565], [175, 117885], [179, 118325], [184, 118505], [188, 118725], [194, 118965]]}, {"verse": 18, "start": 119605, "end": 121654, "text": "¶ Hear therefore the parable of the sower.", "words": [[2, 119739], [7, 119899], [17, 120379], [21, 120479], [29, 120919], [32, 121099], [36, 121179]]}, {"verse": 19, "start": 122004, "end": 132589, "text": "When any one hears the word of the kingdom, and understands it not, then comes the wicked one, and catches away that which was sown in his heart. This is he which received seed by the way side.", "words": [[0, 122004], [5, 122176], [9, 122356], [13, 122536], [19, 122796], [23, 122996], [28, 123236], [31, 123336], [35, 123456], [44, 123756], [48, 124071], [60, 124591], [63, 124891], [68, 125691], [73, 125871], [79, 126151], [83, 126331], [90, 126591], [95, 126831], [99, 127271], [107, 127611], [112, 127931], [117, 128191], [123, 128371], [127, 128551], [132, 128871], [135, 128991], [139, 129131], [146, 129781], [151, 129941], [154, 130101], [157, 130341], [163, 130701], [172, 131061], [177, 131461], [180, 131721], [184, 132031], [188, 132341]]}, {"verse": 20, "start": 132939, "end": 140307, "text": "But he that received the seed into stony places, the same is he that hears the word, and immediately with joy receives it;", "words": [[0, 132939], [4, 133059], [7, 133299], [12, 133539], [21, 133859], [25, 134059], [30, 134359], [35, 134619], [41, 135019], [49, 136039], [53, 136159], [58, 136459], [61, 136639], [64, 136879], [69, 137119], [75, 137359], [79, 137579], [85, 137879], [89, 138419], [101, 138839], [106, 139199], [110, 139479], [119, 139919]]}, {"verse": 21, "start": 140657, "end": 150336, "text": "Yet has he not root in himself, but endures for a while: for when tribulation or persecution arises because of the word, immediately he is offended.", "words": [[0, 140657], [4, 140795], [8, 141095], [11, 141255], [15, 141455], [20, 141735], [23, 141955], [32, 142755], [36, 143035], [44, 143595], [48, 143775], [50, 143895], [57, 144571], [61, 144666], [66, 144866], [78, 145546], [81, 145826], [93, 146386], [100, 147126], [108, 147586], [111, 147806], [115, 147926], [121, 148586], [133, 149046], [136, 149566], [139, 149726]]}, {"verse": 22, "start": 150686, "end": 160500, "text": "He also that received seed among the thorns is he that hears the word; and the care of this world, and the deceitfulness of riches, choke the word, and he becomes unfruitful.", "words": [[0, 150686], [3, 150809], [8, 151129], [13, 151369], [22, 151769], [27, 152149], [33, 152409], [37, 152629], [44, 153049], [47, 153314], [50, 153554], [55, 153834], [61, 154054], [65, 154294], [71, 154943], [75, 155082], [79, 155182], [84, 155482], [87, 155622], [92, 155762], [99, 156162], [103, 156522], [107, 156622], [121, 157162], [124, 157402], [132, 157702], [138, 158342], [142, 158562], [148, 159002], [152, 159122], [155, 159202], [163, 159582]]}, {"verse": 23, "start": 160850, "end": 171833, "text": "But he that received seed into the good ground is he that hears the word, and understands it; which also bears fruit, and brings forth, some a hundredfold, some sixty, some thirty.", "words": [[0, 160850], [4, 161016], [7, 161256], [12, 161496], [21, 161896], [26, 162276], [31, 162556], [35, 162716], [40, 162876], [47, 163216], [50, 163576], [53, 163776], [58, 163976], [64, 164216], [68, 164456], [74, 164736], [78, 165236], [90, 165716], [94, 166335], [100, 166459], [105, 166799], [111, 167139], [118, 167519], [122, 168059], [129, 168359], [136, 168739], [141, 169319], [143, 169539], [156, 170399], [161, 170559], [168, 171259], [173, 171379]]}, {"verse": 24, "start": 172113, "end": 178574, "text": "¶ Another parable put he forth to them, saying, The kingdom of heaven is likened to a man which sowed good seed in his field:", "words": [[2, 172113], [10, 172377], [18, 172677], [22, 172977], [25, 173277], [31, 173517], [34, 173757], [40, 174037], [48, 174830], [52, 174909], [60, 175169], [63, 175369], [70, 175649], [73, 175849], [81, 176289], [84, 176389], [86, 176489], [90, 176709], [96, 176929], [102, 177289], [107, 177449], [112, 177769], [115, 177949], [119, 178089]]}, {"verse": 25, "start": 178924, "end": 183573, "text": "But while men slept, his enemy came and sowed tares among the wheat, and went his way.", "words": [[0, 178924], [4, 179008], [10, 179188], [14, 179428], [21, 180208], [25, 180288], [31, 180568], [36, 180908], [40, 181148], [46, 181488], [52, 181808], [58, 182008], [62, 182208], [69, 182388], [73, 182808], [78, 182968], [82, 183168]]}, {"verse": 26, "start": 183923, "end": 189053, "text": "But when the blade was sprung up, and brought forth fruit, then appeared the tares also.", "words": [[0, 183923], [4, 184023], [9, 184183], [13, 184303], [19, 184583], [23, 184783], [30, 185183], [34, 185383], [38, 185863], [46, 186083], [52, 186383], [59, 187163], [64, 187423], [73, 187783], [77, 188023], [83, 188463]]}, {"verse": 27, "start": 189403, "end": 196561, "text": "So the servants of the householder came and said to him, Sir, did you not sow good seed in your field? from where then has it tares?", "words": [[0, 189403], [3, 189528], [7, 189668], [16, 189928], [19, 190128], [23, 190248], [35, 190768], [40, 191028], [44, 191288], [49, 191468], [52, 191648], [57, 192208], [62, 192728], [66, 192888], [70, 193028], [74, 193188], [78, 193428], [83, 193708], [88, 194028], [91, 194248], [96, 194348], [103, 195092], [108, 195237], [114, 195397], [119, 195597], [123, 195817], [126, 196212]]}, {"verse": 28, "start": 196911, "end": 203111, "text": "He said to them, An enemy has done this. The servants said to him, Will you then that we go and gather them up?", "words": [[0, 196911], [3, 196994], [8, 197194], [11, 197354], [17, 197974], [20, 198114], [26, 198454], [30, 198734], [35, 198954], [41, 199613], [45, 199791], [54, 199991], [59, 200291], [62, 200491], [67, 200911], [72, 201071], [76, 201291], [81, 201491], [86, 201671], [89, 201811], [92, 202071], [96, 202271], [103, 202551], [108, 202751]]}, {"verse": 29, "start": 203461, "end": 208603, "text": "But he said, No; lest while you gather up the tares, you root up also the wheat with them.", "words": [[0, 203461], [4, 203561], [7, 203701], [13, 203941], [17, 204661], [22, 204948], [28, 205168], [32, 205308], [39, 205568], [42, 205788], [46, 205908], [53, 206848], [57, 206928], [62, 207128], [65, 207308], [70, 207628], [74, 207848], [80, 208028], [85, 208268]]}, {"verse": 30, "start": 208953, "end": 219558, "text": "Let both grow together until the harvest: and in the time of harvest I will say to the reapers, Gather together first the tares, and bind them in bundles to burn them: but gather the wheat into my barn.", "words": [[0, 208953], [4, 209094], [9, 209374], [14, 209634], [23, 209994], [29, 210294], [33, 210474], [42, 211308], [46, 211452], [49, 211572], [53, 211652], [58, 211912], [61, 212052], [69, 212432], [71, 212652], [76, 212772], [80, 212972], [83, 213112], [87, 213192], [96, 213892], [103, 214172], [112, 214512], [118, 214852], [122, 215112], [129, 215552], [133, 215932], [138, 216172], [143, 216392], [146, 216492], [154, 216852], [157, 217032], [162, 217232], [168, 217784], [172, 217946], [179, 218206], [183, 218386], [189, 218566], [194, 218886], [197, 219066]]}, {"verse": 31, "start": 219838, "end": 228246, "text": "¶ Another parable put he forth to them, saying, The kingdom of heaven is like to a grain of mustard seed, which a man took, and sowed in his field:", "words": [[2, 219838], [10, 220102], [18, 220402], [22, 220702], [25, 221002], [31, 221242], [34, 221482], [40, 221762], [48, 222555], [52, 222636], [60, 222936], [63, 223156], [70, 223456], [73, 223676], [78, 223876], [81, 224056], [83, 224176], [89, 224396], [92, 224556], [100, 224876], [106, 225756], [112, 225916], [114, 226036], [118, 226216], [124, 226536], [128, 227016], [134, 227456], [137, 227556], [141, 227696]]}, {"verse": 32, "start": 228596, "end": 238858, "text": "Which indeed is the least of all seeds: but when it is grown, it is the greatest among herbs, and becomes a tree, so that the birds of the air come and lodge in the branches of it.", "words": [[0, 228596], [6, 228738], [13, 229078], [16, 229378], [20, 229518], [26, 229738], [29, 229958], [33, 230118], [40, 230959], [44, 231150], [49, 231370], [52, 231490], [55, 231630], [62, 232430], [65, 232530], [68, 232670], [72, 232790], [81, 233150], [87, 233450], [94, 234230], [98, 234390], [106, 234690], [108, 234890], [114, 235550], [117, 235710], [122, 235870], [126, 236010], [132, 236270], [135, 236430], [139, 236570], [143, 236790], [148, 237090], [152, 237370], [158, 237690], [161, 237930], [165, 238010], [174, 238370], [177, 238650]]}, {"verse": 33, "start": 239138, "end": 248072, "text": "¶ Another parable spoke he to them; The kingdom of heaven is like to leaven, which a woman took, and hid in three measures of meal, till the whole was leavened.", "words": [[2, 239138], [10, 239407], [18, 239987], [24, 240277], [27, 240567], [30, 240727], [36, 241339], [40, 241441], [48, 241741], [51, 242001], [58, 242301], [61, 242501], [66, 242721], [69, 242901], [77, 243601], [83, 243741], [85, 243861], [91, 244061], [97, 244741], [101, 244861], [105, 245121], [108, 245321], [114, 245601], [123, 245901], [126, 246121], [132, 246741], [137, 246901], [141, 247061], [147, 247301], [151, 247541]]}, {"verse": 34, "start": 248352, "end": 254464, "text": "All these things spoke Jesus to the multitude in parables; and without a parable spoke he not to them:", "words": [[0, 248352], [4, 248560], [10, 248780], [17, 249180], [23, 249540], [29, 249940], [32, 250280], [36, 250400], [46, 250920], [49, 251140], [59, 252116], [63, 252260], [71, 252500], [73, 252700], [81, 253040], [87, 253360], [90, 253660], [94, 253860], [97, 254040]]}, {"verse": 35, "start": 254814, "end": 264786, "text": "That it might be fulfilled which was spoken by the prophet, saying, I will open my mouth in parables; I will utter things which have been kept secret from the foundation of the world.", "words": [[0, 254814], [5, 254927], [8, 255027], [14, 255227], [17, 255447], [27, 255887], [33, 256227], [37, 256407], [44, 256767], [47, 257047], [51, 257187], [60, 257507], [68, 258367], [70, 258647], [75, 258807], [80, 259127], [83, 259367], [89, 259647], [92, 259847], [102, 260906], [104, 261049], [109, 261209], [115, 261449], [122, 261809], [128, 262109], [133, 262269], [138, 262409], [143, 262609], [150, 263049], [155, 263289], [159, 263429], [170, 263889], [173, 264169], [177, 264289]]}, {"verse": 36, "start": 265136, "end": 274435, "text": "Then Jesus sent the multitude away, and went into the house: and his disciples came to him, saying, Declare to us the parable of the tares of the field.", "words": [[0, 265136], [5, 265425], [11, 265765], [16, 266165], [20, 266325], [30, 266745], [36, 267205], [40, 267805], [45, 268005], [50, 268245], [54, 268385], [61, 269170], [65, 269278], [69, 269398], [79, 269898], [84, 270238], [87, 270478], [92, 270798], [100, 271736], [108, 271886], [111, 272126], [114, 272306], [118, 272466], [126, 272946], [129, 273126], [133, 273356], [139, 273586], [142, 273786], [146, 273906]]}, {"verse": 37, "start": 274715, "end": 279277, "text": "He answered and said to them, He that sows the good seed is the Son of man;", "words": [[0, 274715], [3, 274807], [12, 275187], [16, 275427], [21, 275667], [24, 275867], [30, 276405], [33, 276576], [38, 276836], [43, 277176], [47, 277396], [52, 277596], [57, 277936], [60, 278276], [64, 278436], [68, 278656], [71, 278776]]}, {"verse": 38, "start": 279627, "end": 285776, "text": "The field is the world; the good seed are the children of the kingdom; but the tares are the children of the wicked one;", "words": [[0, 279627], [4, 279704], [10, 280044], [13, 280304], [17, 280444], [24, 281169], [28, 281251], [33, 281451], [38, 281751], [42, 282031], [46, 282131], [55, 282511], [58, 282691], [62, 282791], [71, 283526], [75, 283608], [79, 283768], [85, 284248], [89, 284388], [93, 284488], [102, 284848], [105, 285028], [109, 285108], [116, 285308]]}, {"verse": 39, "start": 286126, "end": 291956, "text": "The enemy that sowed them is the devil; the harvest is the end of the world; and the reapers are the angels.", "words": [[0, 286126], [4, 286210], [10, 286490], [15, 286750], [21, 287150], [26, 287250], [29, 287410], [33, 287550], [40, 288228], [44, 288306], [52, 288686], [55, 289006], [59, 289146], [63, 289326], [66, 289426], [70, 289506], [77, 290296], [81, 290496], [85, 290596], [93, 290956], [97, 291156], [101, 291256]]}, {"verse": 40, "start": 292306, "end": 298374, "text": "As therefore the tares are gathered and burned in the fire; so shall it be in the end of this world.", "words": [[0, 292306], [3, 292493], [13, 293013], [17, 293293], [23, 293753], [27, 293873], [36, 294233], [40, 294573], [47, 294933], [50, 295153], [54, 295253], [60, 295995], [63, 296305], [69, 296585], [72, 296745], [75, 296905], [78, 297065], [82, 297165], [86, 297485], [89, 297665], [94, 297845]]}, {"verse": 41, "start": 298724, "end": 306864, "text": "The Son of man shall send forth his angels, and they shall gather out of his kingdom all things that offend, and them which do iniquity;", "words": [[0, 298724], [4, 298822], [8, 299082], [11, 299202], [15, 299542], [21, 299802], [26, 300102], [32, 300322], [36, 300582], [44, 301542], [48, 301722], [53, 301842], [59, 302022], [66, 302342], [70, 302582], [73, 302702], [77, 302862], [85, 303202], [89, 303562], [96, 303882], [101, 304142], [109, 304922], [113, 305122], [118, 305422], [124, 305722], [127, 306022]]}, {"verse": 42, "start": 307214, "end": 311775, "text": "And shall cast them into a furnace of fire: there shall be wailing and gnashing of teeth.", "words": [[0, 307214], [4, 307343], [10, 307503], [15, 307823], [20, 308083], [25, 308263], [27, 308443], [35, 308703], [38, 308943], [44, 309721], [50, 309805], [56, 309985], [59, 310145], [67, 310605], [71, 310765], [80, 311225], [83, 311365]]}, {"verse": 43, "start": 312125, "end": 317396, "text": "Then shall the righteous shine forth as the sun in the kingdom of their Father. Who has ears to hear, let him hear.", "words": [[0, 312125], [5, 312400], [11, 312620], [15, 312780], [25, 313120], [31, 313480], [37, 313860], [40, 314100], [44, 314273], [48, 314447], [51, 314620], [55, 314720], [63, 314960], [66, 315160], [72, 315300], [80, 316063], [84, 316187], [88, 316387], [93, 316687], [96, 316967], [102, 317089], [106, 317212], [110, 317335]]}, {"verse": 44, "start": 317746, "end": 329745, "text": "¶ Again, the kingdom of heaven is like to treasure hid in a field; which when a man has found, he hides, and for joy of it goes and sells all that he has, and buys that field.", "words": [[2, 318991], [9, 319331], [13, 319551], [21, 319871], [24, 320111], [31, 320411], [34, 320591], [39, 320771], [42, 320931], [51, 321211], [55, 321591], [58, 321811], [60, 321931], [67, 322685], [73, 323075], [78, 323215], [80, 323295], [84, 323495], [88, 323675], [95, 324395], [98, 324495], [105, 325275], [109, 325455], [113, 325595], [117, 325875], [120, 326035], [123, 326135], [128, 326435], [132, 326695], [138, 327035], [142, 327395], [147, 327575], [150, 327695], [155, 328375], [159, 328615], [164, 328915], [169, 329235]]}, {"verse": 45, "start": 330095, "end": 335276, "text": "¶ Again, the kingdom of heaven is like to a merchant man, seeking goodly pearls:", "words": [[2, 330095], [9, 330991], [13, 331071], [21, 331411], [24, 331671], [31, 331991], [34, 332331], [39, 332551], [42, 332731], [44, 332851], [53, 333111], [58, 333931], [66, 334211], [73, 334631]]}, {"verse": 46, "start": 335626, "end": 341382, "text": "Who, when he had found one pearl of great price, went and sold all that he had, and bought it.", "words": [[0, 335626], [5, 336099], [10, 336419], [13, 336539], [17, 336639], [23, 336899], [27, 337219], [33, 337519], [36, 337679], [42, 337899], [49, 338659], [54, 338879], [58, 339119], [63, 339379], [67, 339759], [72, 339939], [75, 340079], [80, 340419], [84, 340819], [91, 341059]]}, {"verse": 47, "start": 341732, "end": 347417, "text": "¶ Again, the kingdom of heaven is like to a net, that was cast into the sea, and gathered of every kind:", "words": [[2, 341732], [9, 342023], [13, 342263], [21, 342503], [24, 342743], [31, 343023], [34, 343283], [39, 343503], [42, 343703], [44, 343843], [49, 344123], [54, 344318], [58, 344458], [63, 344738], [68, 345018], [72, 345178], [77, 345518], [81, 346018], [90, 346358], [93, 346578], [99, 346818]]}, {"verse": 48, "start": 347767, "end": 354436, "text": "Which, when it was full, they drew to shore, and sat down, and gathered the good into vessels, but cast the bad away.", "words": [[0, 347767], [7, 348162], [12, 348302], [15, 348402], [19, 348542], [25, 349322], [30, 349522], [35, 349762], [38, 349922], [45, 350262], [49, 350682], [53, 350942], [59, 351302], [63, 351642], [72, 351982], [76, 352162], [81, 352362], [86, 352562], [95, 352942], [99, 353282], [104, 353582], [108, 353802], [112, 354002]]}, {"verse": 49, "start": 354786, "end": 360917, "text": "So shall it be at the end of the world: the angels shall come forth, and sever the wicked from among the just,", "words": [[0, 354786], [3, 355103], [9, 355383], [12, 355523], [15, 355683], [18, 355823], [22, 355923], [26, 356103], [29, 356203], [33, 356323], [40, 356997], [44, 357100], [51, 357520], [57, 357820], [62, 358060], [69, 358420], [73, 358960], [79, 359280], [83, 359460], [90, 359740], [95, 359980], [101, 360240], [105, 360420]]}, {"verse": 50, "start": 361267, "end": 365815, "text": "And shall cast them into the furnace of fire: there shall be wailing and gnashing of teeth.", "words": [[0, 361267], [4, 361386], [10, 361526], [15, 361866], [20, 362106], [25, 362286], [29, 362446], [37, 362706], [40, 362926], [46, 363615], [52, 363715], [58, 363915], [61, 364075], [69, 364575], [73, 364815], [82, 365255], [85, 365395]]}, {"verse": 51, "start": 366095, "end": 372703, "text": "Jesus says to them, Have you understood all these things? They say to him, Yes, Lord.", "words": [[0, 366095], [6, 366379], [11, 366719], [14, 366959], [20, 367565], [25, 367734], [29, 367874], [40, 368334], [44, 368654], [50, 368834], [56, 370096], [58, 370644], [63, 370773], [67, 371013], [70, 371213], [75, 371856], [80, 372101]]}, {"verse": 52, "start": 372983, "end": 383274, "text": "Then said he to them, Therefore every scribe which is instructed to the kingdom of heaven is like to a man that is a householder, which brings forth out of his treasure things new and old.", "words": [[0, 372983], [5, 373203], [10, 373443], [13, 373603], [16, 373743], [22, 374296], [32, 375010], [38, 375410], [45, 376010], [51, 376110], [54, 376250], [65, 376670], [68, 376930], [72, 377050], [80, 377290], [83, 377510], [90, 377790], [93, 378230], [98, 378430], [101, 378610], [103, 378730], [107, 378990], [112, 379170], [115, 379310], [117, 379390], [130, 380288], [136, 380406], [143, 380686], [149, 381006], [153, 381246], [156, 381366], [160, 381486], [169, 381766], [176, 382086], [180, 382466], [184, 382806]]}, {"verse": 53, "start": 383554, "end": 389055, "text": "¶ And it came to pass, that when Jesus had finished these parables, he departed from there.", "words": [[2, 383554], [6, 383702], [9, 383802], [14, 384022], [17, 384182], [23, 385042], [28, 385222], [33, 385422], [39, 385782], [43, 386102], [52, 386402], [58, 386662], [68, 387722], [71, 387782], [80, 388222], [85, 388542]]}, {"verse": 54, "start": 389405, "end": 398660, "text": "And when he was come into his own country, he taught them in their synagogue, so that they were astonished, and said, From where has this man this wisdom, and these mighty works?", "words": [[0, 389405], [4, 389537], [9, 389697], [12, 389857], [16, 390084], [21, 390310], [26, 390537], [30, 390697], [34, 390857], [43, 391597], [46, 391837], [53, 392117], [58, 392357], [61, 392497], [67, 392617], [78, 393077], [81, 393777], [86, 393957], [91, 394097], [96, 394257], [108, 394957], [112, 395157], [118, 395799], [123, 395950], [129, 396130], [133, 396370], [138, 396570], [142, 396810], [147, 397010], [155, 397370], [159, 397590], [165, 397750], [172, 398090]]}, {"verse": 55, "start": 399010, "end": 405359, "text": "Is not this the carpenter’s son? is not his mother called Mary? and his brethren, James, and Joses, and Simon, and Judas?", "words": [[0, 399058], [3, 399148], [7, 399268], [12, 399588], [16, 399648], [28, 400228], [33, 400791], [36, 400891], [40, 400991], [44, 401131], [51, 401371], [58, 401611], [64, 402265], [68, 402370], [72, 402470], [82, 402770], [89, 403270], [93, 403580], [100, 403890], [104, 404210], [111, 404570], [115, 404830]]}, {"verse": 56, "start": 405709, "end": 410345, "text": "And his sisters, are they not all with us? From where then has this man all these things?", "words": [[0, 405709], [4, 405826], [8, 405946], [17, 406726], [21, 406806], [26, 406966], [30, 407146], [34, 407426], [39, 407626], [43, 408228], [48, 408352], [54, 408572], [59, 408752], [63, 408972], [68, 409152], [72, 409392], [76, 409632], [82, 409812]]}, {"verse": 57, "start": 410625, "end": 418484, "text": "And they were offended in him. But Jesus said to them, A prophet is not without honour, save in his own country, and in his own house.", "words": [[0, 410625], [4, 410767], [9, 410887], [14, 411067], [23, 411407], [26, 411667], [31, 412233], [35, 412339], [41, 412639], [46, 412979], [49, 413159], [55, 413718], [57, 413822], [65, 414162], [68, 414382], [72, 414582], [80, 415102], [88, 415622], [93, 415942], [96, 416122], [100, 416282], [104, 416442], [113, 416862], [117, 417422], [120, 417562], [124, 417762], [128, 417922]]}, {"verse": 58, "start": 418764, "end": 421950, "text": "And he did not many mighty works there because of their unbelief.", "words": [[0, 418764], [4, 418900], [7, 419000], [11, 419140], [15, 419320], [20, 419660], [27, 419980], [33, 420260], [39, 420580], [47, 420900], [50, 421120], [56, 421260]]}]}