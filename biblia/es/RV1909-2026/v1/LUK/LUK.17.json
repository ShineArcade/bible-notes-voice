{"book": "LUK", "chapter": 17, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 281029, "verses": [{"verse": 1, "start": 300, "end": 8229, "text": "Y A SUS discípulos dice: Imposible es que no vengan escándalos; pero ¡ay de aquel por quien vienen!", "words": [[0, 300], [2, 443], [4, 543], [8, 683], [19, 1523], [25, 2822], [35, 3182], [38, 3362], [42, 3462], [45, 3642], [52, 4022], [64, 5308], [69, 5680], [73, 6090], [76, 6490], [82, 6930], [86, 7150], [92, 7410]]}, {"verse": 2, "start": 8679, "end": 18335, "text": "Mejor le fuera, si le pusiesen al cuello una piedra de molino, y le lanzasen en el mar, que escandalizar a uno de estos pequeñitos.", "words": [[0, 8679], [6, 9064], [9, 9244], [16, 9644], [19, 10184], [22, 10324], [31, 10824], [34, 11104], [41, 11504], [45, 11724], [52, 12204], [55, 12324], [63, 13064], [65, 13364], [68, 13484], [77, 14304], [80, 14444], [83, 14604], [88, 14884], [92, 15344], [105, 16384], [107, 16644], [111, 16844], [114, 17024], [120, 17264]]}, {"verse": 3, "start": 18785, "end": 25909, "text": "Mirad por vosotros: si peca contra ti tu hermano, repréndele; y si se arrepiente, perdónale.", "words": [[0, 18785], [6, 19233], [10, 19573], [20, 20696], [23, 20841], [28, 21261], [35, 21581], [38, 21921], [41, 22021], [50, 22521], [62, 23782], [64, 23867], [67, 23987], [70, 24187], [82, 24867]]}, {"verse": 4, "start": 26359, "end": 34024, "text": "Y si siete veces al día peca contra ti, y siete veces al día se vuelve a ti, diciendo, me arrepiento, perdónalo.", "words": [[0, 26359], [2, 26466], [5, 26586], [11, 26926], [17, 27206], [20, 27566], [24, 27786], [29, 28326], [36, 28646], [40, 28906], [42, 29286], [48, 29546], [54, 29846], [57, 30086], [61, 30286], [64, 30466], [71, 30826], [73, 30946], [77, 31086], [87, 31686], [90, 32206], [102, 32946]]}, {"verse": 5, "start": 34474, "end": 38065, "text": "Y dijeron los apóstoles al Señor: Auméntanos la fe.", "words": [[0, 34474], [2, 34597], [10, 35057], [14, 35197], [24, 35857], [27, 36077], [34, 36889], [45, 37537], [48, 37717]]}, {"verse": 6, "start": 38415, "end": 50740, "text": "Entonces el Señor dijo: Si tuvieseis fe como un grano de mostaza, diréis a este sicómoro: Desarráigate, y plántate en el mar; y os obedecerá.", "words": [[0, 38415], [9, 38889], [12, 39249], [18, 39549], [24, 40470], [27, 40931], [37, 41411], [40, 41731], [45, 42051], [48, 42231], [54, 42591], [57, 42691], [66, 43791], [73, 44431], [75, 44631], [80, 45276], [90, 46707], [104, 47277], [106, 47717], [115, 48437], [118, 48617], [121, 48737], [126, 49501], [128, 49587], [131, 49674]]}, {"verse": 7, "start": 51190, "end": 59378, "text": "¿Y quién de vosotros tiene un siervo que ara o apacienta, que vuelto del campo le diga enseguida: Pasa, siéntate a la mesa?", "words": [[0, 51190], [3, 51356], [9, 51556], [12, 51756], [21, 52256], [27, 52556], [30, 52736], [37, 53216], [41, 53416], [45, 53716], [47, 53916], [58, 55016], [62, 55136], [69, 55576], [73, 55716], [79, 56096], [82, 56376], [87, 56676], [98, 58144], [104, 58144], [113, 58669], [115, 58809], [118, 58889]]}, {"verse": 8, "start": 59828, "end": 69370, "text": "¿No le dice antes: Prepárame la cena, y arremángate, y sírveme hasta que haya comido y bebido; y después de esto, come tú y bebe?", "words": [[0, 59828], [4, 60096], [7, 60216], [12, 60476], [19, 61487], [29, 62071], [32, 62211], [38, 62511], [40, 62711], [53, 63511], [55, 63911], [63, 64491], [69, 64951], [73, 65131], [78, 65311], [85, 65851], [87, 65971], [95, 66809], [97, 66916], [105, 67176], [108, 67376], [114, 68116], [119, 68336], [122, 68636], [124, 68936]]}, {"verse": 9, "start": 69820, "end": 75019, "text": "¿Da gracias al siervo porque hizo lo que le había sido mandado? Pienso que no.", "words": [[0, 69820], [4, 70042], [12, 70442], [15, 70762], [22, 71202], [29, 71502], [34, 71922], [37, 72202], [41, 72342], [44, 72482], [50, 72682], [55, 73042], [64, 74123], [71, 74488], [75, 74648]]}, {"verse": 10, "start": 75469, "end": 85480, "text": "Así también vosotros, cuando hayáis hecho todo lo que os es mandado, decid: Siervos inútiles somos, porque lo que debíamos hacer, hicimos.", "words": [[0, 75469], [4, 75698], [12, 76038], [22, 76698], [29, 76998], [36, 77558], [42, 77778], [47, 78118], [50, 78378], [54, 78538], [57, 78718], [60, 78898], [69, 79998], [76, 81186], [84, 81466], [93, 82126], [100, 83006], [107, 83346], [110, 83526], [114, 83666], [123, 84126], [130, 84586]]}, {"verse": 11, "start": 85930, "end": 91971, "text": "Y aconteció que yendo él a Jerusalén, pasaba por medio de Samaria y de Galilea.", "words": [[0, 85930], [2, 86075], [12, 86815], [16, 87055], [22, 87355], [25, 87695], [27, 87935], [38, 89215], [45, 89695], [49, 89935], [55, 90215], [58, 90435], [66, 90955], [68, 91135], [71, 91235]]}, {"verse": 12, "start": 92421, "end": 100033, "text": "Y entrando en una aldea, le vinieron al encuentro diez hombres leprosos, los cuales se pararon de lejos,", "words": [[0, 92421], [2, 92547], [11, 93027], [14, 93227], [18, 93467], [25, 94527], [28, 94747], [37, 95207], [40, 95387], [50, 95987], [55, 96167], [63, 96707], [73, 97747], [77, 97867], [84, 98267], [87, 98767], [95, 99287], [98, 99427]]}, {"verse": 13, "start": 100483, "end": 106128, "text": "Y alzaron la voz, diciendo: Jesús, Maestro, ten misericordia de nosotros.", "words": [[0, 100483], [2, 100608], [10, 101108], [13, 101268], [18, 101628], [28, 102921], [35, 103565], [44, 104405], [48, 104485], [61, 105265], [64, 105365]]}, {"verse": 14, "start": 106478, "end": 114422, "text": "Y como él los vio, les dijo: Id, mostraos a los sacerdotes. Y aconteció, que yendo ellos, fueron limpios.", "words": [[0, 106478], [2, 106600], [7, 106840], [10, 107100], [14, 107240], [19, 107500], [23, 107620], [29, 108588], [33, 108708], [42, 109848], [44, 109968], [48, 110108], [60, 111570], [62, 111670], [73, 112330], [77, 112540], [83, 112750], [90, 113070], [97, 113470]]}, {"verse": 15, "start": 114872, "end": 121690, "text": "Entonces uno de ellos, como se vio que estaba limpio, volvió, glorificando a Dios a gran voz;", "words": [[0, 114872], [9, 115396], [13, 115936], [16, 116136], [23, 116516], [28, 116816], [31, 117016], [35, 117236], [39, 117356], [46, 117576], [54, 118676], [62, 119996], [75, 120476], [77, 120616], [82, 120756], [84, 120996], [89, 121156]]}, {"verse": 16, "start": 122140, "end": 127958, "text": "Y se postró sobre el rostro a sus pies, dándole gracias: y este era samaritano.", "words": [[0, 122140], [2, 122247], [5, 122387], [12, 122847], [18, 123147], [21, 123367], [28, 123827], [30, 123927], [34, 124087], [40, 124807], [48, 125187], [57, 126310], [59, 126449], [64, 126689], [68, 126929]]}, {"verse": 17, "start": 128408, "end": 134603, "text": "Y respondiendo Jesús, dijo: ¿No son diez los que fueron limpios? ¿Y los nueve dónde están?", "words": [[0, 128408], [2, 128532], [15, 129272], [22, 129992], [28, 130776], [32, 130926], [36, 131176], [41, 131426], [45, 131726], [49, 131886], [56, 132166], [65, 133258], [68, 133366], [72, 133486], [78, 133806], [84, 133946]]}, {"verse": 18, "start": 135053, "end": 139496, "text": "¿No hubo quien volviese y diese gloria a Dios sino este extranjero?", "words": [[0, 135053], [4, 135240], [9, 135560], [15, 135740], [24, 136380], [26, 136640], [32, 136900], [39, 137420], [41, 137600], [46, 137900], [51, 138560], [56, 138620]]}, {"verse": 19, "start": 139946, "end": 143996, "text": "Y le dijo: Levántate, vete; tu fe te ha salvado.", "words": [[0, 139946], [2, 140088], [5, 140208], [11, 141082], [22, 141849], [28, 142611], [31, 142695], [34, 142935], [37, 143135], [40, 143255]]}, {"verse": 20, "start": 144446, "end": 154828, "text": "Y preguntado por los fariseos, cuándo había de venir el reino de Dios, les respondió y dijo: El reino de Dios no vendrá con advertencia;", "words": [[0, 144446], [2, 144571], [13, 145251], [17, 145511], [21, 145671], [31, 146791], [38, 147111], [44, 147491], [47, 147651], [53, 147891], [56, 148111], [62, 148451], [65, 148611], [71, 149231], [75, 149351], [85, 150471], [87, 150551], [93, 151341], [96, 151766], [102, 152286], [105, 152426], [110, 152706], [113, 153126], [120, 153566], [124, 153706]]}, {"verse": 21, "start": 155278, "end": 162815, "text": "Ni dirán: Está aquí, o está allí: porque he aquí el reino de Dios entre vosotros está.", "words": [[0, 155786], [3, 156295], [10, 157062], [15, 157427], [21, 157747], [23, 158267], [28, 158527], [34, 159313], [41, 159535], [44, 159815], [49, 160135], [52, 160295], [58, 160695], [61, 160835], [66, 161135], [72, 161595], [81, 162435]]}, {"verse": 22, "start": 163265, "end": 172047, "text": "Y dijo a sus discípulos: Tiempo vendrá, cuando desearéis ver uno de los días del Hijo del hombre, y no lo veréis.", "words": [[0, 163265], [2, 163625], [7, 163865], [9, 164025], [13, 164145], [25, 165392], [32, 165728], [40, 166288], [47, 166528], [57, 167348], [61, 167568], [65, 167948], [68, 168108], [72, 168248], [77, 168488], [81, 168728], [86, 168948], [90, 169128], [98, 169528], [100, 169968], [103, 170168], [106, 170328]]}, {"verse": 23, "start": 172497, "end": 176280, "text": "Y os dirán: Está aquí, o está allí. No vayáis, ni sigáis.", "words": [[0, 172668], [2, 172871], [5, 173073], [12, 173575], [17, 173575], [23, 173575], [25, 173711], [30, 173911], [36, 174715], [39, 174962], [47, 175242], [50, 175788]]}, {"verse": 24, "start": 176730, "end": 188595, "text": "Porque como el relámpago, relampagueando desde una parte de debajo del cielo, resplandece hasta la otra debajo del cielo, así también será el Hijo del hombre en su día.", "words": [[0, 176730], [7, 176993], [12, 177293], [15, 178106], [26, 178920], [41, 179733], [47, 179973], [51, 180213], [57, 180713], [60, 180933], [67, 181313], [71, 181553], [78, 182053], [90, 183453], [96, 183853], [99, 184073], [104, 184353], [111, 184813], [115, 185053], [122, 185913], [126, 186133], [134, 186533], [139, 186873], [142, 187113], [147, 187353], [151, 187553], [158, 187853], [161, 188033], [164, 188173]]}, {"verse": 25, "start": 189045, "end": 195455, "text": "Pero primero es necesario que padezca mucho, y sea rechazado por esta generación.", "words": [[0, 189045], [5, 189207], [13, 189607], [16, 189827], [26, 190487], [30, 190807], [38, 191387], [45, 191747], [47, 192587], [51, 192947], [61, 194027], [65, 194287], [70, 194467]]}, {"verse": 26, "start": 195905, "end": 201402, "text": "Y como fue en los días de Noé, así también será en los días del Hijo del hombre.", "words": [[0, 195905], [2, 196162], [7, 196402], [11, 196702], [14, 196942], [18, 197082], [23, 197322], [26, 197502], [31, 198222], [35, 198422], [43, 198942], [48, 199382], [51, 199782], [55, 199942], [60, 200182], [64, 200442], [69, 200662], [73, 200862]]}, {"verse": 27, "start": 201852, "end": 212593, "text": "Comían, bebían, se casaban y se daban en casamiento, hasta el día que entró Noé en el arca; y vino el diluvio, y destruyó a todos.", "words": [[0, 201852], [8, 202416], [16, 203276], [19, 203376], [27, 204076], [29, 204596], [32, 204716], [38, 205016], [41, 205156], [53, 206336], [59, 206716], [62, 206876], [66, 207056], [70, 207236], [76, 207716], [80, 208196], [83, 208436], [86, 208576], [92, 209479], [94, 209585], [99, 209805], [102, 209965], [111, 210645], [113, 211025], [122, 211745], [124, 211945]]}, {"verse": 28, "start": 213043, "end": 220669, "text": "Asimismo también como fue en los días de Lot; comían, bebían, compraban, vendían, plantaban, edificaban;", "words": [[0, 213350], [9, 213690], [17, 214110], [22, 214470], [26, 214770], [29, 214970], [33, 215130], [38, 215468], [41, 215805], [46, 216371], [54, 217337], [62, 218317], [73, 219177], [82, 219897], [93, 220283]]}, {"verse": 29, "start": 221119, "end": 228507, "text": "Pero el día que Lot salió de Sodoma, llovió del cielo fuego y azufre, y destruyó a todos:", "words": [[0, 222253], [5, 222393], [8, 222553], [12, 222733], [16, 222893], [20, 223093], [26, 223573], [29, 223713], [37, 224613], [44, 224953], [48, 225053], [54, 225373], [60, 225853], [62, 226293], [70, 226733], [72, 227133], [81, 227753], [83, 227853]]}, {"verse": 30, "start": 228957, "end": 232610, "text": "Como esto será el día en que el Hijo del hombre se manifestará.", "words": [[0, 228957], [5, 229141], [10, 229401], [15, 229781], [18, 230021], [22, 230261], [25, 230481], [29, 230621], [32, 230781], [37, 231041], [41, 231201], [48, 231461], [51, 231661]]}, {"verse": 31, "start": 233060, "end": 243617, "text": "En aquel día, el que esté en la azotea, y sus bienes en casa, no descienda a tomarlos: y el que en el campo, asimismo no vuelva atrás.", "words": [[0, 233060], [3, 233200], [9, 233560], [14, 233800], [17, 234120], [21, 234319], [26, 234640], [29, 234999], [32, 235180], [40, 235960], [42, 236099], [46, 236279], [53, 236640], [56, 236779], [62, 237099], [65, 237719], [75, 238319], [77, 238520], [87, 239666], [89, 239830], [92, 240010], [96, 240190], [99, 240490], [102, 240650], [109, 241230], [118, 242470], [121, 242610], [128, 242990]]}, {"verse": 32, "start": 244067, "end": 246373, "text": "Acordaos de la mujer de Lot.", "words": [[0, 244467], [9, 244867], [12, 245087], [15, 245187], [21, 245517], [24, 245847]]}, {"verse": 33, "start": 246823, "end": 252377, "text": "Todo el que procure salvar su vida, la perderá; y todo el que la pierda, la salvará.", "words": [[0, 246823], [5, 246997], [8, 247207], [12, 247307], [20, 247727], [27, 248167], [30, 248487], [36, 248767], [39, 248927], [48, 249968], [50, 250111], [55, 250311], [58, 250531], [62, 250671], [65, 250811], [73, 251411], [76, 251711]]}, {"verse": 34, "start": 252827, "end": 259878, "text": "Os digo que en aquella noche estarán dos en una cama; el uno será tomado, y el otro será dejado.", "words": [[0, 252827], [3, 252987], [8, 253267], [12, 253507], [15, 253767], [23, 254167], [29, 254487], [37, 255107], [41, 255367], [44, 255647], [48, 255827], [54, 256687], [57, 256834], [61, 257054], [66, 257294], [74, 257974], [76, 258514], [79, 258634], [84, 258874], [89, 259194]]}, {"verse": 35, "start": 260328, "end": 265694, "text": "Dos mujeres estarán moliendo juntas: la una será tomada, y la otra dejada.", "words": [[0, 260328], [4, 260576], [12, 261116], [20, 261696], [29, 261977], [37, 263419], [40, 263519], [44, 263679], [49, 263919], [57, 264519], [59, 264679], [62, 264779], [67, 265262]]}, {"verse": 36, "start": 266144, "end": 271325, "text": "Dos estarán en el campo; el uno será tomado, y el otro dejado.", "words": [[0, 266144], [4, 266449], [12, 267169], [15, 267369], [18, 267489], [25, 268465], [28, 268613], [32, 268833], [37, 269053], [45, 269773], [47, 270173], [50, 270313], [55, 270533]]}, {"verse": 37, "start": 271775, "end": 280629, "text": "Y respondiendo, le dicen: ¿Dónde, Señor? Y él les dijo: Donde esté el cuerpo, allá se juntarán también las águilas.", "words": [[0, 271775], [2, 272111], [16, 272477], [19, 272844], [26, 273840], [34, 274179], [41, 275024], [43, 275206], [46, 275346], [50, 275486], [56, 276359], [62, 276606], [67, 276946], [70, 277226], [78, 278146], [83, 278366], [86, 278606], [95, 279266], [103, 279566], [107, 279846]]}]}