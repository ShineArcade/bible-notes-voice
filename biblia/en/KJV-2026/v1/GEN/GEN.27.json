{"book": "GEN", "chapter": 27, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 391630, "verses": [{"verse": 1, "start": 300, "end": 13926, "text": "And it came to pass, that when Isaac was old, and his eyes were dim, so that he could not see, he called Esau his eldest son, and said to him, My son: and he said to him, Behold, here am I.", "words": [[0, 300], [4, 452], [7, 552], [12, 792], [15, 972], [21, 1712], [26, 1952], [31, 2132], [37, 2472], [41, 2772], [46, 3212], [50, 3472], [54, 3632], [59, 3932], [64, 4132], [69, 4872], [72, 5052], [77, 5212], [80, 5312], [86, 5432], [90, 5652], [95, 6492], [98, 6572], [105, 6872], [110, 7592], [114, 7832], [121, 8092], [126, 9120], [130, 9266], [135, 9466], [138, 9666], [143, 10274], [146, 10414], [151, 11196], [155, 11322], [158, 11422], [163, 11642], [166, 11842], [171, 12444], [179, 13041], [184, 13201], [187, 13501]]}, {"verse": 2, "start": 14206, "end": 19272, "text": "And he said, Behold now, I am old, I know not the day of my death:", "words": [[0, 14206], [4, 14341], [7, 14481], [13, 15889], [20, 16249], [25, 16509], [27, 16789], [30, 16929], [35, 17309], [37, 17849], [42, 18049], [46, 18269], [50, 18429], [54, 18629], [57, 18749], [60, 18909]]}, {"verse": 3, "start": 19622, "end": 26070, "text": "Now therefore take, please, your weapons, your quiver and your bow, and go out to the field, and take me some venison;", "words": [[0, 19622], [4, 19838], [14, 20258], [20, 20518], [28, 21318], [33, 21418], [42, 22138], [47, 22218], [54, 22558], [58, 22818], [63, 22938], [68, 23218], [72, 23718], [75, 23898], [79, 24078], [82, 24238], [86, 24318], [93, 24618], [97, 24978], [102, 25158], [105, 25338], [110, 25518]]}, {"verse": 4, "start": 26420, "end": 33134, "text": "And make me savoury food, such as I love, and bring it to me, that I may eat; that my soul may bless you before I die.", "words": [[0, 26420], [4, 26568], [9, 26728], [12, 27040], [20, 27354], [26, 27667], [31, 27887], [34, 28047], [36, 28147], [42, 28447], [46, 28867], [52, 29107], [55, 29228], [58, 29387], [62, 29548], [67, 29928], [69, 30068], [73, 30228], [78, 30964], [83, 31086], [86, 31226], [91, 31526], [95, 31726], [101, 31986], [105, 32226], [112, 32506], [114, 32726]]}, {"verse": 5, "start": 33414, "end": 40428, "text": "And Rebekah heard when Isaac spoke to Esau his son. And Esau went to the field to hunt for venison, and to bring it.", "words": [[0, 33414], [4, 33549], [12, 34029], [18, 34249], [23, 34469], [29, 34789], [35, 35169], [38, 35409], [43, 35909], [47, 36089], [52, 36829], [56, 36995], [61, 37535], [66, 37755], [69, 37955], [73, 38055], [79, 38355], [82, 38595], [87, 38775], [91, 38935], [100, 39415], [104, 39795], [107, 39935], [113, 40155]]}, {"verse": 6, "start": 40778, "end": 47256, "text": "¶ And Rebekah spoke to Jacob her son, saying, Behold, I heard your father speak to Esau your brother, saying,", "words": [[2, 40778], [6, 40914], [14, 41354], [20, 41574], [23, 41794], [29, 42074], [33, 42334], [38, 42734], [46, 43234], [54, 44134], [56, 44374], [62, 44594], [67, 44794], [74, 45094], [80, 45454], [83, 45694], [88, 46274], [93, 46334], [102, 46834]]}, {"verse": 7, "start": 47456, "end": 53995, "text": "Bring me venison, and make me savoury food, that I may eat, and bless you before the LORD before my death.", "words": [[0, 47456], [6, 47616], [9, 47836], [18, 48336], [22, 48616], [27, 48836], [30, 49186], [38, 49536], [44, 50076], [49, 50341], [51, 50521], [55, 50701], [60, 51321], [64, 51621], [70, 51901], [74, 52161], [81, 52401], [85, 52641], [90, 53161], [97, 53381], [100, 53641]]}, {"verse": 8, "start": 54345, "end": 59935, "text": "Now therefore, my son, obey my voice according to that which I command you.", "words": [[0, 54345], [4, 54734], [15, 55554], [18, 55714], [23, 56554], [28, 56994], [31, 57354], [37, 57794], [47, 58194], [50, 58494], [55, 58674], [61, 58894], [63, 59054], [71, 59354]]}, {"verse": 9, "start": 60285, "end": 69218, "text": "Go now to the flock, and fetch me from there two good kids of the goats; and I will make them savoury food for your father, such as he loves:", "words": [[0, 60285], [3, 60529], [7, 60789], [10, 60989], [14, 61129], [21, 61909], [25, 62069], [31, 62309], [34, 62549], [39, 62729], [45, 62969], [49, 63329], [54, 63569], [59, 63909], [62, 64149], [66, 64289], [73, 65097], [77, 65217], [79, 65337], [84, 65457], [89, 65677], [94, 65977], [102, 66277], [107, 66777], [111, 66997], [116, 67137], [124, 67977], [129, 68237], [132, 68437], [135, 68577]]}, {"verse": 10, "start": 69568, "end": 74522, "text": "And you shall bring it to your father, that he may eat, and that he may bless you before his death.", "words": [[0, 69568], [4, 69688], [8, 69868], [14, 70048], [20, 70348], [23, 70488], [26, 70688], [31, 70808], [39, 71188], [44, 71483], [47, 71683], [51, 71863], [56, 72203], [60, 72703], [65, 72823], [68, 72983], [72, 73103], [78, 73403], [82, 73643], [89, 73903], [93, 74123]]}, {"verse": 11, "start": 74802, "end": 80845, "text": "And Jacob said to Rebekah his mother, Behold, Esau my brother is a hairy man, and I am a smooth man:", "words": [[0, 74802], [4, 74933], [10, 75253], [15, 75533], [18, 75913], [26, 76293], [30, 76393], [38, 77143], [46, 77537], [51, 77937], [54, 78117], [62, 78397], [65, 78697], [67, 78797], [73, 79037], [78, 79677], [82, 79777], [84, 79937], [87, 80037], [89, 80117], [96, 80337]]}, {"verse": 12, "start": 81195, "end": 88256, "text": "My father perhaps will feel me, and I shall seem to him as a deceiver; and I shall bring a curse upon me, and not a blessing.", "words": [[0, 81195], [3, 81314], [10, 81594], [18, 81994], [23, 82254], [28, 82454], [32, 82674], [36, 83074], [38, 83194], [44, 83334], [49, 83574], [52, 83774], [56, 83994], [59, 84254], [61, 84354], [71, 85144], [75, 85324], [77, 85444], [83, 85664], [89, 85924], [91, 86124], [97, 86304], [102, 86604], [106, 86904], [110, 87364], [114, 87604], [116, 87764]]}, {"verse": 13, "start": 88536, "end": 94837, "text": "And his mother said to him, Upon me be your curse, my son: only obey my voice, and go fetch me them.", "words": [[0, 88536], [4, 88656], [8, 88796], [15, 89036], [20, 89316], [23, 89496], [28, 90056], [33, 90216], [36, 90556], [39, 90696], [44, 90856], [51, 91376], [54, 91476], [59, 92206], [64, 92434], [69, 92694], [72, 92914], [79, 93274], [83, 93594], [86, 93814], [92, 94134], [95, 94374]]}, {"verse": 14, "start": 95117, "end": 102164, "text": "And he went, and fetched, and brought them to his mother: and his mother made savoury food, such as his father loved.", "words": [[0, 95117], [4, 95253], [7, 95373], [13, 95613], [17, 95773], [26, 96353], [30, 96693], [38, 96973], [43, 97213], [46, 97373], [50, 97533], [58, 98267], [62, 98430], [66, 98570], [73, 98870], [78, 99280], [86, 99690], [92, 100270], [97, 100750], [100, 100950], [104, 101110], [111, 101450]]}, {"verse": 15, "start": 102514, "end": 110141, "text": "And Rebekah took goodly clothing of her eldest son Esau, which were with her in the house, and put them upon Jacob her younger son:", "words": [[0, 102514], [4, 102718], [12, 102948], [17, 103308], [24, 103788], [33, 104168], [36, 104448], [40, 104588], [47, 104908], [51, 105528], [57, 106328], [63, 106488], [68, 106688], [73, 106908], [77, 107048], [80, 107188], [84, 107288], [91, 107588], [95, 108028], [99, 108228], [104, 108428], [109, 108628], [115, 109048], [119, 109328], [127, 109568]]}, {"verse": 16, "start": 110491, "end": 115894, "text": "And she put the skins of the kids of the goats upon his hands, and upon the smooth of his neck:", "words": [[0, 110491], [4, 110598], [8, 110758], [12, 110998], [16, 111198], [22, 111538], [25, 111758], [29, 111878], [34, 112118], [37, 112338], [41, 112458], [47, 112738], [52, 113078], [56, 113378], [63, 113798], [67, 114318], [72, 114598], [76, 114838], [83, 115058], [86, 115338], [90, 115498]]}, {"verse": 17, "start": 116244, "end": 121933, "text": "And she gave the savoury food and the bread, which she had prepared, into the hand of her son Jacob.", "words": [[0, 116244], [4, 116357], [8, 116517], [13, 116737], [17, 117007], [25, 117277], [30, 117737], [34, 117957], [38, 118057], [45, 118357], [51, 118957], [55, 119157], [59, 119317], [69, 119797], [74, 120357], [78, 120537], [83, 120817], [86, 120977], [90, 121077], [94, 121357]]}, {"verse": 18, "start": 122283, "end": 129774, "text": "¶ And he came to his father, and said, My father: and he said, Here am I; who are you, my son?", "words": [[2, 122283], [6, 122650], [9, 122770], [14, 123010], [17, 123190], [21, 123330], [29, 123690], [33, 123930], [39, 124649], [42, 124767], [50, 125544], [54, 125678], [57, 125818], [63, 127227], [68, 127543], [71, 127863], [74, 128539], [78, 128678], [82, 128818], [87, 129198], [90, 129298]]}, {"verse": 19, "start": 130054, "end": 139630, "text": "And Jacob said to his father, I am Esau your firstborn; I have done according as you invited me: arise, please, sit and eat of my venison, that your soul may bless me.", "words": [[0, 130054], [4, 130205], [10, 130505], [15, 130785], [18, 130985], [22, 131125], [30, 131900], [32, 132138], [35, 132318], [40, 132938], [45, 132938], [56, 133954], [58, 134093], [63, 134213], [68, 134393], [78, 134713], [81, 134953], [85, 135053], [93, 135313], [97, 135965], [104, 136473], [112, 136773], [116, 136946], [120, 137120], [124, 137293], [127, 137413], [130, 137553], [139, 138293], [144, 138413], [149, 138573], [154, 138853], [158, 139033], [164, 139273]]}, {"verse": 20, "start": 139910, "end": 148425, "text": "And Isaac said to his son, How is it that you have found it so quickly, my son? And he said, Because the LORD your God brought it to me.", "words": [[0, 139910], [4, 140049], [10, 140349], [15, 140689], [18, 140869], [22, 141029], [27, 141739], [31, 141953], [34, 142193], [37, 142353], [42, 142533], [46, 142673], [51, 142793], [57, 143033], [60, 143153], [63, 143313], [72, 143753], [75, 143893], [80, 144562], [84, 144697], [87, 144837], [93, 146245], [101, 146443], [105, 146663], [110, 146923], [115, 147123], [119, 147503], [127, 147883], [130, 148063], [133, 148203]]}, {"verse": 21, "start": 148705, "end": 155395, "text": "And Isaac said to Jacob, Come near, please, that I may feel you, my son, whether you be my very son Esau or not.", "words": [[0, 148705], [4, 148860], [10, 149160], [15, 149460], [18, 149620], [25, 150385], [30, 150522], [36, 150722], [44, 151322], [49, 151422], [51, 151582], [55, 151722], [60, 152022], [65, 152222], [68, 152402], [73, 153082], [81, 153282], [85, 153502], [88, 153642], [91, 153822], [96, 154062], [100, 154342], [105, 154822], [108, 155002]]}, {"verse": 22, "start": 155675, "end": 163585, "text": "And Jacob went near to Isaac his father; and he felt him, and said, The voice is Jacob’s voice, but the hands are the hands of Esau.", "words": [[0, 155675], [4, 155827], [10, 156127], [15, 156427], [20, 156667], [23, 156847], [29, 157207], [33, 157467], [41, 158267], [45, 158430], [48, 158570], [53, 158850], [58, 159090], [62, 159310], [68, 159914], [72, 160020], [78, 160280], [81, 160460], [89, 160920], [96, 161540], [100, 161760], [104, 161900], [110, 162220], [114, 162400], [118, 162520], [124, 162800], [127, 162980]]}, {"verse": 23, "start": 163865, "end": 170306, "text": "And he discerned him not, because his hands were hairy, as his brother Esau’s hands: so he blessed him.", "words": [[0, 163865], [4, 164005], [7, 164145], [17, 164685], [21, 164785], [26, 165125], [34, 165745], [38, 165985], [44, 166245], [49, 166465], [56, 166885], [59, 167405], [63, 167545], [71, 167825], [78, 168525], [85, 169256], [88, 169422], [91, 169582], [99, 169862]]}, {"verse": 24, "start": 170656, "end": 176067, "text": "And he said, Are you my very son Esau? And he said, I am.", "words": [[0, 170656], [4, 170804], [7, 170924], [13, 171673], [17, 171821], [21, 171981], [24, 172181], [29, 172501], [33, 173021], [39, 173768], [43, 173903], [46, 174043], [52, 175451], [54, 175704]]}, {"verse": 25, "start": 176347, "end": 187864, "text": "And he said, Bring it near to me, and I will eat of my son’s venison, that my soul may bless you. And he brought it near to him, and he did eat: and he brought him wine, and he drank.", "words": [[0, 176347], [4, 176482], [7, 176622], [13, 178031], [19, 178170], [22, 178330], [27, 178490], [30, 178690], [34, 178850], [38, 179190], [40, 179370], [45, 179530], [49, 179790], [52, 179970], [55, 180130], [61, 180470], [70, 180910], [75, 181170], [78, 181330], [83, 181650], [87, 181850], [93, 182090], [98, 182709], [102, 182850], [105, 182970], [113, 183230], [116, 183390], [121, 183650], [124, 183890], [129, 184110], [133, 184375], [136, 184495], [140, 184715], [145, 185468], [149, 185587], [152, 185707], [160, 186007], [164, 186207], [170, 186647], [174, 187127], [177, 187267]]}, {"verse": 26, "start": 188214, "end": 192292, "text": "And his father Isaac said to him, Come near now, and kiss me, my son.", "words": [[0, 188214], [4, 188363], [8, 188523], [15, 188883], [21, 189343], [26, 189683], [29, 189903], [34, 190467], [39, 190603], [44, 190823], [49, 191103], [53, 191283], [58, 191503], [62, 191703], [65, 191883]]}, {"verse": 27, "start": 192572, "end": 202035, "text": "And he came near, and kissed him: and he smelled the smell of his clothing, and blessed him, and said, See, the smell of my son is as the smell of a field which the LORD has blessed:", "words": [[0, 192572], [4, 192705], [7, 192805], [12, 193065], [18, 193345], [22, 193610], [29, 193850], [34, 194466], [38, 194603], [41, 194723], [49, 195063], [53, 195263], [59, 195463], [62, 195703], [66, 195843], [76, 196263], [80, 196683], [88, 196963], [93, 197263], [97, 197503], [103, 198105], [108, 198242], [112, 198362], [118, 198582], [121, 198802], [124, 198962], [128, 199242], [131, 199402], [134, 199642], [138, 199822], [144, 200062], [147, 200222], [149, 200322], [155, 200622], [161, 200842], [165, 201042], [170, 201262], [174, 201482]]}, {"verse": 28, "start": 202385, "end": 208171, "text": "Therefore God give you of the dew of heaven, and the fatness of the earth, and plenty of grain and wine:", "words": [[0, 202385], [10, 202740], [14, 203100], [19, 203380], [23, 203540], [26, 203680], [30, 203800], [34, 204040], [37, 204220], [45, 204540], [49, 205020], [53, 205120], [61, 205600], [64, 205780], [68, 205940], [75, 206200], [79, 206640], [86, 207000], [89, 207200], [95, 207480], [99, 207680]]}, {"verse": 29, "start": 208521, "end": 219666, "text": "Let people serve you, and nations bow down to you: be lord over your brethren, and let your mother’s sons bow down to you: cursed be every one that curses you, and blessed be he that blesses you.", "words": [[0, 208521], [4, 208658], [11, 208938], [17, 209278], [22, 209538], [26, 209898], [34, 210298], [38, 210598], [43, 210918], [46, 211098], [51, 211581], [54, 211696], [59, 211916], [64, 212236], [69, 212396], [79, 213256], [83, 213336], [87, 213496], [92, 213636], [101, 214096], [106, 214336], [110, 214616], [115, 214936], [118, 215156], [123, 215657], [130, 215934], [133, 216154], [139, 216374], [143, 216594], [148, 216854], [155, 217254], [160, 217534], [164, 217894], [172, 218194], [175, 218494], [178, 218694], [183, 218874], [191, 219314]]}, {"verse": 30, "start": 219946, "end": 230789, "text": "¶ And it came to pass, as soon as Isaac had made an end of blessing Jacob, and Jacob was yet scarce gone out from the presence of Isaac his father, that Esau his brother came in from his hunting.", "words": [[2, 219946], [6, 220099], [9, 220199], [14, 220419], [17, 220579], [23, 220919], [26, 221219], [31, 221439], [34, 221579], [40, 221899], [44, 222159], [49, 222339], [52, 222479], [56, 222739], [59, 222859], [68, 223159], [75, 224139], [79, 224239], [85, 224499], [89, 224759], [93, 224919], [100, 225339], [105, 225699], [109, 225939], [114, 226139], [118, 226239], [127, 226559], [130, 226779], [136, 227039], [140, 227259], [148, 228021], [153, 228130], [158, 228790], [162, 228930], [170, 229390], [175, 229590], [178, 229830], [183, 230010], [187, 230210]]}, {"verse": 31, "start": 231139, "end": 241115, "text": "And he also had made savoury food, and brought it to his father, and said to his father, Let my father arise, and eat of his son’s venison, that your soul may bless me.", "words": [[0, 231139], [4, 231265], [7, 231385], [12, 231705], [16, 231965], [21, 232325], [29, 232685], [35, 233205], [39, 233765], [47, 234005], [50, 234165], [53, 234325], [57, 234485], [65, 234885], [69, 235230], [74, 235490], [77, 235710], [81, 235890], [89, 236671], [93, 236822], [96, 237022], [103, 237322], [110, 237822], [114, 238302], [118, 238462], [121, 238582], [125, 238682], [131, 239002], [140, 239522], [145, 239902], [150, 240042], [155, 240362], [159, 240562], [165, 240802]]}, {"verse": 32, "start": 241395, "end": 249157, "text": "And Isaac his father said to him, Who are you? And he said, I am your son, your firstborn Esau.", "words": [[0, 241395], [4, 241543], [10, 242103], [14, 242203], [21, 242663], [26, 242863], [29, 243083], [34, 243606], [38, 243763], [42, 243983], [47, 244700], [51, 244834], [54, 244974], [60, 246383], [62, 246543], [65, 246663], [70, 246803], [75, 247663], [80, 247743], [90, 248403]]}, {"verse": 33, "start": 249437, "end": 260336, "text": "And Isaac trembled very exceedingly, and said, Who? where is he that has taken venison, and brought it me, and I have eaten of all before you came, and have blessed him? yes, and he shall be blessed.", "words": [[0, 249437], [4, 249581], [10, 249941], [19, 250481], [24, 250761], [37, 251461], [41, 251721], [47, 252539], [52, 252922], [58, 253103], [61, 253323], [64, 253463], [69, 253643], [73, 253783], [79, 254003], [88, 254523], [92, 254683], [100, 254883], [103, 255023], [107, 255523], [111, 255643], [113, 255803], [118, 255963], [124, 256163], [127, 256363], [131, 256623], [138, 256863], [142, 257083], [148, 257363], [152, 257743], [157, 257863], [165, 258103], [170, 258696], [175, 259259], [179, 259339], [182, 259539], [188, 259779], [191, 259919]]}, {"verse": 34, "start": 260616, "end": 269580, "text": "And when Esau heard the words of his father, he cried with a great and exceeding bitter cry, and said to his father, Bless me, even me also, O my father.", "words": [[0, 260616], [4, 260762], [9, 260922], [14, 261502], [20, 261742], [24, 261902], [30, 262162], [33, 262302], [37, 262422], [45, 263222], [48, 263342], [54, 263682], [59, 263902], [61, 264022], [67, 264282], [71, 264462], [81, 264982], [88, 265242], [93, 265782], [97, 266162], [102, 266382], [105, 266582], [109, 266702], [117, 267421], [123, 267622], [127, 267862], [132, 268042], [135, 268282], [141, 268632], [143, 268982], [146, 269142]]}, {"verse": 35, "start": 269860, "end": 274943, "text": "And he said, Your brother came with craftiness, and has taken away your blessing.", "words": [[0, 269860], [4, 269995], [7, 270135], [13, 271544], [18, 271644], [26, 271904], [31, 272244], [36, 272444], [48, 273044], [52, 273504], [56, 273644], [62, 273884], [67, 274164], [72, 274364]]}, {"verse": 36, "start": 275223, "end": 290231, "text": "And he said, Is not he rightly named Jacob? for he has supplanted me these two times: he took away my birthright; and, behold, now he has taken away my blessing. And he said, Have you not reserved a blessing for me?", "words": [[0, 275223], [4, 275357], [7, 275497], [13, 276906], [16, 277029], [20, 277209], [23, 277429], [31, 277689], [37, 278029], [44, 278829], [48, 278941], [51, 279121], [55, 279301], [66, 279881], [69, 280061], [75, 280301], [79, 280461], [86, 281218], [89, 281282], [94, 281462], [99, 281742], [102, 281902], [114, 283330], [119, 283330], [127, 284210], [131, 284390], [134, 284590], [138, 284770], [144, 285070], [149, 285330], [152, 285570], [162, 286430], [166, 286565], [169, 286705], [175, 288114], [180, 288270], [184, 288390], [188, 288610], [197, 288930], [199, 289250], [208, 289590], [212, 289870]]}, {"verse": 37, "start": 290511, "end": 302983, "text": "And Isaac answered and said to Esau, Behold, I have made him your lord, and all his brethren have I given to him for servants; and with grain and wine have I sustained him: and what shall I do now to you, my son?", "words": [[0, 290511], [4, 290633], [10, 290933], [19, 291453], [23, 291673], [28, 291933], [31, 292193], [37, 293356], [45, 293912], [47, 294032], [52, 294212], [57, 294412], [61, 294572], [66, 294752], [72, 295432], [76, 295532], [80, 295792], [84, 295992], [93, 296432], [98, 296712], [100, 296832], [106, 297032], [109, 297232], [113, 297392], [117, 297572], [127, 298470], [131, 298592], [136, 298732], [142, 299032], [146, 299232], [151, 299512], [156, 299732], [158, 299852], [168, 300172], [173, 300822], [177, 300926], [182, 301106], [188, 301306], [190, 301446], [193, 301606], [197, 301806], [200, 302006], [205, 302406], [208, 302526]]}, {"verse": 38, "start": 303263, "end": 312422, "text": "And Esau said to his father, Have you but one blessing, my father? bless me, even me also, O my father. And Esau lifted up his voice, and wept.", "words": [[0, 303263], [4, 303427], [9, 304007], [14, 304267], [17, 304487], [21, 304667], [29, 305410], [34, 305571], [38, 305711], [42, 305891], [46, 306111], [56, 306591], [59, 306671], [67, 307382], [73, 307568], [77, 307808], [82, 307988], [85, 308188], [91, 308768], [93, 308848], [96, 308968], [104, 309742], [108, 309934], [113, 310594], [120, 310914], [123, 311154], [127, 311294], [134, 311674], [138, 312034]]}, {"verse": 39, "start": 312772, "end": 320100, "text": "And Isaac his father answered and said to him, Behold, your dwelling shall be the fatness of the earth, and of the dew of heaven from above;", "words": [[0, 312772], [4, 312958], [10, 313318], [14, 313558], [21, 313838], [30, 314318], [34, 314558], [39, 314758], [42, 314978], [47, 315479], [55, 315965], [60, 316045], [69, 316385], [75, 316645], [78, 316805], [82, 316905], [90, 317385], [93, 317545], [97, 317685], [104, 317965], [108, 318485], [111, 318605], [115, 318705], [119, 318965], [122, 319125], [129, 319405], [134, 319625]]}, {"verse": 40, "start": 320450, "end": 328300, "text": "And by your sword shall you live, and shall serve your brother; and it shall come to pass when you shall have the dominion, that you shall break his yoke from off your neck.", "words": [[0, 320450], [4, 320551], [7, 320691], [12, 320851], [18, 321191], [24, 321411], [28, 321551], [34, 321851], [38, 322171], [44, 322371], [50, 322651], [55, 322771], [64, 323405], [68, 323523], [71, 323643], [77, 323783], [82, 324003], [85, 324183], [90, 324483], [95, 324663], [99, 324783], [105, 324943], [110, 325183], [114, 325303], [124, 325903], [129, 326243], [133, 326383], [139, 326543], [145, 326803], [149, 327003], [154, 327343], [159, 327523], [163, 327763], [168, 327903]]}, {"verse": 41, "start": 328580, "end": 341005, "text": "¶ And Esau hated Jacob because of the blessing with which his father blessed him: and Esau said in his heart, The days of mourning for my father are at hand; then will I slay my brother Jacob.", "words": [[2, 328580], [6, 328753], [11, 329553], [17, 329893], [23, 330433], [31, 330753], [34, 330953], [38, 331073], [47, 331413], [52, 331713], [58, 331933], [62, 332113], [69, 332473], [77, 332833], [82, 333469], [86, 333864], [91, 334484], [96, 334764], [99, 335004], [103, 335204], [110, 335924], [114, 336064], [119, 336364], [122, 336564], [131, 336884], [135, 337164], [138, 337364], [145, 337684], [149, 338004], [152, 338164], [158, 338929], [163, 339135], [168, 339355], [170, 339495], [175, 339895], [178, 340055], [186, 340335]]}, {"verse": 42, "start": 341355, "end": 355020, "text": "And these words of Esau her elder son were told to Rebekah: and she sent and called Jacob her younger son, and said to him, Behold, your brother Esau, as touching you, does comfort himself, purposing to kill you.", "words": [[0, 341355], [4, 341499], [10, 341679], [16, 342019], [19, 342239], [24, 342859], [28, 342979], [34, 343239], [38, 343779], [43, 343859], [48, 344099], [51, 344542], [60, 345134], [64, 345471], [68, 345631], [73, 345931], [77, 346131], [84, 346411], [90, 346811], [94, 347071], [102, 347331], [107, 347711], [111, 347931], [116, 348151], [119, 348351], [124, 349242], [132, 349582], [137, 349762], [145, 350062], [151, 350862], [154, 351022], [163, 351402], [168, 352122], [173, 352262], [181, 352662], [190, 353662], [200, 354122], [203, 354282], [208, 354542]]}, {"verse": 43, "start": 355370, "end": 361756, "text": "Now therefore, my son, obey my voice; and arise, flee to Laban my brother to Haran;", "words": [[0, 355370], [4, 355560], [15, 356120], [18, 356280], [23, 356980], [28, 357180], [31, 357420], [38, 358140], [42, 358303], [49, 359243], [54, 359543], [57, 359923], [63, 360303], [66, 360403], [74, 360903], [77, 361357]]}, {"verse": 44, "start": 362106, "end": 365958, "text": "And stay with him a few days, until your brother’s fury turn away;", "words": [[0, 362106], [4, 362226], [9, 362486], [14, 362706], [18, 362846], [20, 362986], [24, 363146], [30, 363486], [36, 363871], [41, 364111], [51, 364571], [56, 364851], [61, 365251]]}, {"verse": 45, "start": 366308, "end": 377940, "text": "Until your brother’s anger turn away from you, and he forget that which you have done to him: then I will send, and fetch you from there: why should I be deprived also of you both in one day?", "words": [[0, 366308], [6, 366588], [11, 366788], [21, 367248], [27, 367508], [32, 367828], [37, 368088], [42, 368308], [47, 369028], [51, 369148], [54, 369328], [61, 369648], [66, 369908], [72, 370128], [76, 370368], [81, 370528], [86, 370768], [89, 371008], [94, 371701], [99, 371881], [101, 372061], [106, 372201], [112, 372581], [116, 372881], [122, 373201], [126, 373421], [131, 373641], [138, 374339], [142, 374563], [149, 374843], [151, 374983], [154, 375103], [163, 375543], [168, 376103], [171, 376443], [175, 376583], [180, 376823], [183, 377123], [187, 377363]]}, {"verse": 46, "start": 378220, "end": 391230, "text": "And Rebekah said to Isaac, I am weary of my life because of the daughters of Heth: if Jacob take a wife of the daughters of Heth, such as these which are of the daughters of the land, what good shall my life do me?", "words": [[0, 378220], [4, 378415], [12, 378645], [17, 378985], [20, 379165], [27, 379898], [29, 380097], [32, 380357], [38, 380617], [41, 380877], [44, 381057], [49, 381437], [57, 381837], [60, 382057], [64, 382177], [74, 382577], [77, 382986], [83, 383615], [86, 383732], [92, 384092], [97, 384392], [99, 384552], [104, 384812], [107, 384972], [111, 385112], [121, 385432], [124, 385652], [130, 386232], [135, 386412], [138, 386612], [144, 386872], [150, 387172], [154, 387312], [157, 387432], [161, 387552], [171, 387852], [174, 388112], [178, 388252], [184, 389232], [189, 389412], [194, 389772], [200, 390052], [203, 390272], [208, 390592], [211, 390852]]}]}