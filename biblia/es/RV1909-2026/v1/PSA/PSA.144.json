{"book": "PSA", "chapter": 144, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 115870, "verses": [{"verse": 1, "start": 300, "end": 8056, "text": "Salmo de David. BENDITO sea Jehová, mi roca, que enseña mis manos a la batalla, y mis dedos a la guerra:", "words": [[0, 300], [6, 770], [9, 930], [16, 1755], [24, 2301], [28, 2608], [36, 2914], [39, 3221], [45, 4021], [49, 4281], [56, 4781], [60, 4941], [66, 5281], [68, 5521], [71, 5581], [80, 6101], [82, 6561], [86, 6741], [92, 7201], [94, 7341], [97, 7421]]}, {"verse": 2, "start": 8506, "end": 17917, "text": "Misericordia mía y mi castillo, altura mía y mi libertador, escudo mío, en quien he confiado; el que somete mi pueblo delante de mí.", "words": [[0, 8506], [13, 9292], [17, 9472], [19, 9652], [22, 9752], [32, 10952], [39, 11172], [43, 11422], [45, 11672], [48, 11772], [60, 12752], [67, 13192], [72, 13672], [75, 13992], [81, 14192], [84, 14372], [94, 15547], [97, 15672], [101, 15792], [108, 16312], [111, 16412], [118, 16772], [126, 17312], [129, 17492]]}, {"verse": 3, "start": 18367, "end": 25210, "text": "Oh Jehová, ¿qué es el hombre, para que lo conozcas? ¿o el hijo del hombre, para que lo estimes?", "words": [[0, 18701], [3, 19067], [11, 19434], [16, 19834], [19, 20034], [22, 20214], [30, 20554], [35, 21074], [39, 21234], [42, 21374], [52, 22576], [55, 22682], [58, 22822], [63, 23042], [67, 23242], [75, 23622], [80, 24102], [84, 24242], [87, 24402]]}, {"verse": 4, "start": 25660, "end": 30624, "text": "El hombre es semejante a la vanidad: sus días son como la sombra que pasa.", "words": [[0, 25660], [3, 25920], [10, 26180], [13, 26420], [23, 27100], [25, 27220], [28, 27320], [37, 28341], [41, 28486], [46, 28766], [50, 29026], [55, 29246], [58, 29406], [65, 29846], [69, 29986]]}, {"verse": 5, "start": 31074, "end": 36728, "text": "Oh Jehová, inclina tus cielos y desciende: toca los montes, y humeen.", "words": [[0, 31479], [3, 31899], [11, 32319], [19, 32739], [23, 32979], [