{"book": "1CO", "chapter": 4, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 162842, "verses": [{"verse": 1, "start": 300, "end": 4983, "text": "NOS TENGAN los hombres por ministros de Cristo, y administradores de los misterios de Dios.", "words": [[0, 300], [4, 442], [11, 722], [15, 943], [23, 1262], [27, 1522], [37, 2062], [40, 2162], [48, 2522], [50, 2822], [66, 3622], [69, 3742], [73, 3862], [83, 4402], [86, 4502]]}, {"verse": 2, "start": 5433, "end": 10515, "text": "Pero ahora se requiere en los administradores, que cada uno sea hallado fiel.", "words": [[0, 5433], [5, 5575], [11, 5835], [14, 6048], [23, 6262], [26, 6475], [30, 6655], [47, 7535], [51, 7915], [56, 8135], [60, 8395], [64, 8695], [72, 9035]]}, {"verse": 3, "start": 10965, "end": 16035, "text": "Yo en muy poco tengo el ser juzgado de vosotros, o de juicio humano; y ni aun yo me juzgo.", "words": [[0, 10965], [3, 11113], [6, 11193], [10, 11293], [15, 11553], [21, 11793], [24, 11973], [28, 12133], [36, 12573], [39, 12753], [49, 13233], [51, 13493], [54, 13613], [61, 13913], [69, 14833], [71, 14953], [74, 15033], [78, 15213], [81, 15393], [84, 15533]]}, {"verse": 4, "start": 16486, "end": 23115, "text": "Porque aunque de nada tengo mala conciencia, no por eso soy justificado; pero el que me juzga, el Señor es.", "words": [[0, 16486], [7, 16669], [14, 16829], [17, 17049], [22, 17209], [28, 17529], [33, 17729], [45, 18789], [48, 18869], [52, 19049], [56, 19209], [60, 19389], [73, 20922], [78, 21060], [81, 21180], [85, 21300], [88, 21440], [95, 22180], [98, 22280], [104, 22520]]}, {"verse": 5, "start": 23565, "end": 36431, "text": "Así que, no juzguéis nada antes de tiempo, hasta que venga el Señor, el cual también aclarará lo oculto de las tinieblas, y manifestará las intenciones de los corazones: y entonces cada uno tendrá de Dios la alabanza.", "words": [[0, 23565], [4, 23742], [9, 23902], [12, 24042], [21, 24582], [26, 24862], [32, 25262], [35, 25422], [43, 26122], [49, 26382], [53, 26562], [59, 26822], [62, 26942], [69, 27722], [72, 27842], [77, 28042], [85, 28362], [94, 29022], [97, 29202], [104, 29722], [107, 29762], [111, 29922], [122, 30582], [124, 30902], [136, 31502], [140, 31662], [152, 32222], [155, 32382], [159, 32482], [170, 33592], [172, 33694], [181, 34034], [186, 34474], [190, 34754], [197, 35194], [200, 35314], [205, 35534], [208, 35774]]}, {"verse": 6, "start": 36881, "end": 49585, "text": "Pero esto, hermanos, he presentado como ejemplo en mí y en Apolos por amor de vosotros; para que en nosotros aprendáis a no saber más de lo que está escrito, para que ninguno se envanezca a favor de uno contra otro.", "words": [[0, 36881], [5, 37023], [11, 37383], [21, 38003], [24, 38023], [35, 38623], [40, 38823], [48, 39263], [51, 39643], [54, 39863], [56, 40103], [59, 40183], [66, 40703], [70, 41083], [75, 41303], [78, 41523], [88, 42483], [93, 42634], [97, 42714], [100, 42794], [109, 43094], [119, 43974], [121, 44114], [124, 44294], [130, 44574], [134, 44914], [137, 45194], [140, 45334], [144, 45434], [149, 45614], [158, 46494], [163, 46774], [167, 46914], [175, 47314], [178, 47434], [188, 47974], [190, 48074], [196, 48254], [199, 48494], [203, 48714], [210, 49074]]}, {"verse": 7, "start": 50035, "end": 57871, "text": "Porque ¿quién te distingue? ¿o qué tienes que no hayas recibido? Y si lo recibiste, ¿de qué te glorías como si no hubieras recibido?", "words": [[0, 50035], [7, 50193], [14, 50413], [17, 50573], [28, 51551], [31, 51657], [35, 51797], [42, 52177], [46, 52417], [49, 52617], [55, 52957], [65, 54027], [67, 54125], [70, 54205], [73, 54345], [84, 55365], [88, 55445], [92, 55565], [95, 55725], [103, 56165], [108, 56405], [111, 56585], [114, 56725], [123, 57165]]}, {"verse": 8, "start": 58321, "end": 67059, "text": "Ya estáis saciados, ya estáis ricos, sin nosotros reináis; y ojalá reinéis, para que nosotros reinemos también juntamente con vosotros.", "words": [[0, 58321], [3, 58478], [10, 59048], [20, 59618], [23, 59698], [30, 60058], [37, 60438], [41, 60758], [50, 61198], [59, 62768], [61, 62916], [67, 63316], [76, 63756], [81, 64016], [85, 64156], [94, 64496], [103, 65136], [111, 65436], [122, 66136], [126, 66356]]}, {"verse": 9, "start": 67509, "end": 78574, "text": "Porque a lo que pienso, Dios nos ha mostrado a nosotros los apóstoles por los últimos, como a sentenciados a muerte: porque somos hechos espectáculo al mundo, y a los ángeles, y a los hombres.", "words": [[0, 67509], [7, 67729], [9, 67829], [12, 67909], [16, 68029], [24, 68649], [29, 68809], [33, 68989], [36, 69089], [45, 69549], [47, 69669], [56, 69939], [60, 70209], [70, 70789], [74, 70969], [78, 71129], [87, 72029], [92, 72382], [94, 72736], [107, 73089], [109, 73209], [117, 73990], [124, 74186], [130, 74486], [137, 74966], [149, 75726], [152, 75906], [159, 76246], [161, 76726], [163, 76786], [167, 76926], [176, 77426], [178, 77706], [180, 77766], [184, 77926]]}, {"verse": 10, "start": 79024, "end": 89967, "text": "Nosotros necios por amor de Cristo, y vosotros prudentes en Cristo; nosotros débiles, y vosotros fuertes; vosotros estimados, y nosotros despreciados.", "words": [[0, 79024], [9, 79541], [16, 80061], [20, 80381], [25, 80561], [28, 80781], [36, 81161], [38, 81601], [47, 82021], [57, 82581], [60, 82801], [68, 83695], [77, 84121], [86, 84661], [88, 84981], [97, 85421], [106, 87099], [115, 87522], [126, 88222], [128, 88462], [137, 88742]]}, {"verse": 11, "start": 90417, "end": 97824, "text": "Hasta esta hora pasamos hambre, y tenemos sed, y estamos desnudos, y somos heridos de golpes, y andamos sin hogar fijo;", "words": [[0, 90417], [6, 90606], [11, 90906], [16, 91126], [24, 91626], [32, 92166], [34, 92386], [42, 92666], [47, 93106], [49, 93346], [57, 93686], [67, 94366], [69, 94826], [75, 95026], [83, 95506], [86, 95686], [94, 96186], [96, 96466], [104, 96886], [108, 97106], [114, 97386]]}, {"verse": 12, "start": 98274, "end": 105300, "text": "Y trabajamos, obrando con nuestras manos: nos maldicen, y bendecimos: padecemos persecución, y sufrimos:", "words": [[0, 98274], [2, 98378], [14, 99038], [22, 99558], [26, 99778], [35, 100018], [42, 101095], [46, 101217], [56, 101817], [58, 101897], [70, 103072], [80, 103556], [93, 104436], [95, 104576]]}, {"verse": 13, "start": 105750, "end": 112072, "text": "Somos calumniados, y rogamos: hemos venido a ser como la basura del mundo, el desecho de todos hasta ahora.", "words": [[0, 105750], [6, 106088], [19, 106768], [21, 107028], [30, 108060], [36, 108259], [43, 108619], [45, 108739], [49, 108859], [54, 109079], [57, 109219], [64, 109619], [68, 109799], [75, 110459], [78, 110539], [86, 110979], [89, 111059], [95, 111299], [101, 111639]]}, {"verse": 14, "start": 112522, "end": 117170, "text": "No escribo esto para avergonzaros: sino que os amonesto como a mis hijos amados.", "words": [[0, 112522], [3, 112744], [11, 113004], [16, 113204], [21, 113484], [35, 114689], [40, 114909], [44, 115089], [47, 115209], [56, 115749], [61, 115989], [63, 116129], [67, 116229], [73, 116429]]}, {"verse": 15, "start": 117620, "end": 125384, "text": "Porque aunque tengáis diez mil tutores en Cristo, no tendréis muchos padres; que en Cristo Jesús yo os engendré por el evangelio.", "words": [[0, 117620], [7, 117788], [14, 117948], [22, 118288], [27, 118628], [31, 118968], [39, 119388], [42, 119848], [50, 120308], [53, 120508], [62, 121008], [69, 121208], [77, 122291], [81, 122388], [84, 122488], [91, 122788], [97, 123368], [100, 123748], [103, 123888], [112, 124368], [116, 124548], [119, 124648]]}, {"verse": 16, "start": 125834, "end": 127891, "text": "Por tanto, os ruego que me imitéis.", "words": [[0, 125834], [4, 125950], [11, 126270], [14, 126610], [20, 126930], [24, 127090], [27, 127210]]}, {"verse": 17, "start": 128341, "end": 140045, "text": "Por lo cual os he enviado a Timoteo, que es mi hijo amado y fiel en el Señor, el cual os recordará cuáles son mis caminos en Cristo, de la manera que enseño en todas partes en todas las iglesias.", "words": [[0, 128341], [4, 128460], [7, 128560], [12, 128790], [15, 129020], [18, 129180], [26, 129640], [28, 129780], [37, 130780], [41, 130840], [44, 131000], [47, 131180], [52, 131380], [58, 131780], [60, 131920], [65, 132060], [68, 132240], [71, 132380], [78, 133180], [81, 133280], [86, 133500], [89, 133700], [99, 134300], [106, 134720], [110, 134900], [114, 135100], [122, 135520], [125, 135700], [133, 136523], [136, 136628], [139, 136728], [146, 136968], [150, 137208], [157, 137668], [160, 137788], [166, 137948], [173, 138788], [176, 138848], [182, 139028], [186, 139288]]}, {"verse": 18, "start": 140495, "end": 144883, "text": "Pero algunos están envanecidos, como si nunca hubiese yo de ir a vosotros.", "words": [[0, 140495], [5, 140634], [13, 140954], [19, 141354], [32, 142454], [37, 142774], [40, 142934], [46, 143154], [54, 143574], [57, 143834], [60, 143954], [63, 144114], [65, 144194]]}, {"verse": 19, "start": 145333, "end": 152421, "text": "Pero iré pronto a vosotros, si el Señor quiere; y entenderé, no las palabras de los que andan hinchados, sino el poder.", "words": [[0, 145333], [5, 145473], [9, 145733], [16, 145953], [18, 146153], [28, 146673], [31, 147033], [34, 147133], [40, 147333], [48, 148256], [50, 148358], [61, 148958], [64, 149198], [68, 149418], [77, 149798], [80, 150078], [84, 150198], [88, 150378], [94, 150638], [105, 151558], [110, 151738], [113, 151938]]}, {"verse": 20, "start": 152871, "end": 156613, "text": "Porque el reino de Dios no consiste en palabras, sino en poder.", "words": [[0, 152871], [7, 153077], [10, 153277], [16, 153577], [19, 153697], [24, 153937], [27, 154237], [36, 154637], [39, 154917], [49, 155597], [54, 155877], [57, 156117]]}, {"verse": 21, "start": 157063, "end": 162442, "text": "¿Qué queréis? ¿iré a vosotros con vara, o con amor y espíritu de mansedumbre?", "words": [[0, 157063], [5, 157163], [14, 158093], [19, 158391], [21, 158451], [30, 158951], [34, 159251], [40, 159611], [42, 160231], [46, 160411], [5