{"book": "JHN", "chapter": 5, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 310641, "verses": [{"verse": 1, "start": 300, "end": 4915, "text": "After this there was a feast of the Jews; and Jesus went up to Jerusalem.", "words": [[0, 300], [6, 515], [11, 1075], [17, 1215], [21, 1395], [23, 1495], [29, 1735], [32, 1995], [36, 2115], [42, 2940], [46, 3077], [52, 3417], [57, 3737], [60, 3897], [63, 4057]]}, {"verse": 2, "start": 5265, "end": 13140, "text": "Now there is at Jerusalem by the sheep market a pool, which is called in the Hebrew tongue Bethesda, having five porches.", "words": [[0, 5265], [4, 5591], [10, 5851], [13, 6031], [16, 6151], [26, 6671], [29, 7051], [33, 7211], [39, 7451], [46, 7931], [48, 8211], [54, 8991], [60, 9211], [63, 9351], [70, 9651], [73, 9851], [77, 9951], [84, 10211], [91, 10591], [101, 11651], [108, 11891], [113, 12251]]}, {"verse": 3, "start": 13490, "end": 20621, "text": "In these lay a great multitude of impotent folk, of blind, lame, withered, waiting for the moving of the water.", "words": [[0, 13490], [3, 13630], [9, 13890], [13, 14150], [15, 14270], [21, 14530], [31, 15130], [34, 15350], [43, 15830], [49, 16130], [52, 16670], [59, 17430], [65, 18130], [75, 18810], [83, 19170], [87, 19430], [91, 19570], [98, 19810], [101, 20010], [105, 20110]]}, {"verse": 4, "start": 20971, "end": 31633, "text": "For an angel went down at a certain season into the pool, and troubled the water: whoever then first after the troubling of the water stepped in was made whole of whatever disease he had.", "words": [[0, 20971], [4, 21106], [7, 21246], [13, 21626], [18, 21886], [23, 22186], [26, 22366], [28, 22466], [36, 22686], [43, 23146], [48, 23426], [52, 23586], [58, 23926], [62, 24486], [71, 24786], [75, 25006], [82, 25714], [90, 25941], [95, 26381], [101, 27021], [107, 27261], [111, 27421], [121, 27781], [124, 28021], [128, 28121], [134, 28361], [142, 28721], [145, 29161], [149, 29261], [154, 29501], [160, 29841], [163, 30101], [172, 30341], [180, 30821], [183, 31121]]}, {"verse": 5, "start": 31983, "end": 36072, "text": "And a certain man was there, which had an infirmity thirty and eight years.", "words": [[0, 31983], [4, 32303], [6, 32423], [14, 32663], [18, 32983], [22, 33263], [29, 33523], [35, 33803], [39, 34003], [42, 34143], [52, 34583], [59, 35023], [63, 35213], [69, 35403]]}, {"verse": 6, "start": 36422, "end": 44070, "text": "When Jesus saw him lie, and knew that he had been now a long time in that case, he says to him, Will you be made whole?", "words": [[0, 36422], [5, 36569], [11, 36849], [15, 37289], [19, 37469], [24, 37849], [28, 38429], [33, 38649], [38, 38829], [41, 38989], [45, 39169], [50, 39369], [54, 39649], [56, 39769], [61, 40009], [66, 40349], [69, 40589], [74, 40749], [80, 41569], [83, 41729], [88, 41969], [91, 42209], [96, 42800], [101, 42964], [105, 43144], [108, 43304], [113, 43544]]}, {"verse": 7, "start": 44350, "end": 53068, "text": "The impotent man answered him, Sir, I have no man, when the water is troubled, to put me into the pool: but while I am coming, another steps down before me.", "words": [[0, 44350], [4, 44426], [13, 44966], [17, 45166], [26, 45586], [31, 46194], [36, 46489], [38, 46629], [43, 46849], [46, 47089], [51, 47469], [56, 47849], [60, 47989], [66, 48229], [69, 48409], [79, 48749], [82, 49169], [86, 49389], [89, 49569], [94, 49729], [98, 49869], [104, 50435], [108, 50536], [114, 50716], [116, 50896], [119, 50996], [127, 51616], [135, 51836], [141, 52196], [146, 52476], [153, 52736]]}, {"verse": 8, "start": 53348, "end": 57982, "text": "Jesus says to him, Rise, take up your bed, and walk.", "words": [[0, 53348], [6, 53603], [11, 53963], [14, 54203], [19, 55478], [25, 56136], [30, 56256], [33, 56516], [38, 56636], [43, 57336], [47, 57416]]}, {"verse": 9, "start": 58262, "end": 64297, "text": "And immediately the man was made whole, and took up his bed, and walked: and on the same day was the sabbath.", "words": [[0, 58262], [4, 58397], [16, 58737], [20, 59177], [24, 59417], [28, 59617], [33, 59817], [40, 60177], [44, 60657], [49, 60817], [52, 60977], [56, 61097], [61, 61397], [65, 61697], [73, 62438], [77, 62600], [80, 62680], [84, 62820], [89, 63040], [93, 63360], [97, 63560], [101, 63700]]}, {"verse": 10, "start": 64647, "end": 70827, "text": "¶ The Jews therefore said to him that was cured, It is the sabbath day: it is not lawful for you to carry your bed.", "words": [[2, 64647], [6, 64735], [11, 65035], [21, 65455], [26, 65795], [29, 65995], [33, 66155], [38, 66375], [42, 66535], [49, 67412], [52, 67529], [55, 67649], [59, 67769], [67, 68089], [72, 68762], [75, 68879], [78, 68979], [82, 69159], [89, 69599], [93, 69759], [97, 69919], [100, 70019], [106, 70279], [111, 70499]]}, {"verse": 11, "start": 71107, "end": 75875, "text": "He answered them, He that made me whole, the same said to me, Take up your bed, and walk.", "words": [[0, 71107], [3, 71218], [12, 71518], [18, 72207], [21, 72297], [26, 72497], [31, 72677], [34, 72897], [41, 73117], [45, 73317], [50, 73567], [55, 73817], [58, 73997], [62, 74377], [67, 74537], [70, 74697], [75, 74817], [80, 75097], [84, 75397]]}, {"verse": 12, "start": 76155, "end": 80806, "text": "Then asked they him, What man is that which said to you, Take up your bed, and walk?", "words": [[0, 76155], [5, 76454], [11, 76764], [16, 77104], [21, 77814], [26, 77980], [30, 78180], [33, 78320], [38, 78520], [44, 78660], [49, 78900], [52, 79060], [57, 79400], [62, 79680], [65, 79880], [70, 79980], [75, 80200], [79, 80380]]}, {"verse": 13, "start": 81086, "end": 88566, "text": "And he that was healed knew not who it was: for Jesus had conveyed himself away, a multitude being in that place.", "words": [[0, 81086], [4, 81231], [7, 81451], [12, 81671], [16, 81891], [23, 82251], [28, 82631], [32, 82911], [36, 83191], [39, 83311], [44, 84141], [48, 84245], [54, 84584], [58, 84905], [67, 85325], [75, 85745], [81, 86485], [83, 86565], [93, 86985], [99, 87545], [102, 87765], [107, 87944]]}, {"verse": 14, "start": 88916, "end": 96926, "text": "Afterward Jesus finds him in the temple, and said to him, Behold, you are made whole: sin no more, lest a worse thing come to you.", "words": [[0, 88916], [10, 89724], [16, 90024], [22, 90444], [26, 90644], [29, 90764], [33, 90864], [41, 91204], [45, 91484], [50, 91724], [53, 91924], [58, 92510], [66, 93104], [70, 93184], [74, 93304], [79, 93524], [86, 94235], [90, 94460], [93, 94740], [99, 95480], [104, 95660], [106, 95760], [112, 95980], [118, 96200], [123, 96440], [126, 96660]]}, {"verse": 15, "start": 97206, "end": 101575, "text": "The man departed, and told the Jews that it was Jesus, which had made him whole.", "words": [[0, 97206], [4, 97314], [8, 97554], [18, 98014], [22, 98234], [27, 98454], [31, 98654], [36, 98934], [41, 99194], [44, 99294], [48, 99454], [55, 100354], [61, 100574], [65, 100734], [70, 100894], [74, 101094]]}, {"verse": 16, "start": 101925, "end": 108545, "text": "And therefore did the Jews persecute Jesus, and sought to slay him, because he had done these things on the sabbath day.", "words": [[0, 101925], [4, 102073], [14, 102433], [18, 102713], [22, 102873], [27, 103153], [37, 103953], [44, 104353], [48, 104728], [55, 104988], [58, 105208], [63, 105608], [68, 105768], [76, 106128], [79, 106368], [83, 106548], [88, 106788], [94, 107008], [101, 107328], [104, 107548], [108, 107668], [116, 107988]]}, {"verse": 17, "start": 108895, "end": 113544, "text": "¶ But Jesus answered them, My Father works until now, and I work.", "words": [[2, 108895], [6, 109022], [12, 109362], [21, 109842], [27, 110500], [30, 110657], [37, 111017], [43, 111377], [49, 111717], [54, 112557], [58, 112857], [60, 112997]]}, {"verse": 18, "start": 113824, "end": 123113, "text": "Therefore the Jews sought the more to kill him, because he not only had broken the sabbath, but said also that God was his Father, making himself equal with God.", "words": [[0, 113824], [10, 114152], [14, 114392], [19, 114672], [26, 114992], [30, 115172], [35, 115352], [38, 115492], [43, 115812], [48, 116332], [56, 116672], [59, 116872], [63, 117072], [68, 117352], [72, 117532], [79, 117832], [83, 118052], [92, 118832], [96, 118932], [101, 119132], [106, 119452], [111, 119712], [115, 119952], [119, 120212], [123, 120372], [131, 121152], [138, 121352], [146, 121792], [152, 122252], [157, 122552]]}, {"verse": 19, "start": 123463, "end": 135689, "text": "Then answered Jesus and said to them, Most assuredly, I say to you, The Son can do nothing of himself, but what he sees the Father do: for what things soever he does, these also does the Son likewise.", "words": [[0, 123463], [5, 123682], [14, 124102], [20, 124442], [24, 124822], [29, 125042], [32, 125222], [38, 125868], [43, 126029], [54, 126709], [56, 126769], [60, 126989], [63, 127169], [68, 127749], [72, 127889], [76, 128169], [80, 128369], [83, 128509], [91, 128749], [94, 128989], [103, 129729], [107, 129929], [112, 130069], [115, 130209], [120, 130489], [124, 130709], [131, 130989], [135, 131743], [139, 131846], [144, 132046], [151, 132406], [158, 132766], [161, 132946], [167, 133686], [173, 133866], [178, 134246], [183, 134506], [187, 134706], [191, 134906]]}, {"verse": 20, "start": 136039, "end": 144017, "text": "For the Father loves the Son, and shows him all things that himself does: and he will show him greater works than these, that you may marvel.", "words": [[0, 136039], [4, 136147], [8, 136287], [15, 136587], [21, 137007], [25, 137267], [30, 137607], [34, 138047], [40, 138307], [44, 138547], [48, 138807], [55, 139107], [60, 139367], [68, 139567], [74, 140536], [78, 140824], [81, 140964], [86, 141124], [91, 141324], [95, 141524], [103, 141784], [109, 142104], [114, 142364], [121, 142644], [126, 143124], [130, 143304], [134, 143484]]}, {"verse": 21, "start": 144367, "end": 150290, "text": "For as the Father raises up the dead, and gives life to them; even so the Son gives life to whom he will.", "words": [[0, 144367], [4, 144476], [7, 144676], [11, 144836], [18, 145116], [25, 145556], [28, 145776], [32, 145916], [38, 146216], [42, 146616], [48, 146836], [53, 147116], [56, 147316], [62, 147840], [67, 148041], [70, 148461], [74, 148541], [78, 148761], [84, 149041], [89, 149321], [92, 149521], [97, 149721], [100, 149901]]}, {"verse": 22, "start": 150640, "end": 155348, "text": "For the Father judges no man, but has committed all judgment to the Son:", "words": [[0, 150640], [4, 150748], [8, 150888], [15, 151228], [22, 151628], [25, 152088], [30, 152788], [34, 153048], [38, 153228], [48, 153648], [52, 154088], [61, 154548], [64, 154848], [68, 154968]]}, {"verse": 23, "start": 155698, "end": 164079, "text": "That all men should honour the Son, even as they honour the Father. He that honours not the Son honours not the Father which has sent him.", "words": [[0, 155698], [5, 155823], [9, 156083], [13, 156403], [20, 156693], [27, 156983], [31, 157183], [36, 157863], [41, 158123], [44, 158383], [49, 158623], [56, 158863], [60, 159063], [68, 159903], [71, 160072], [76, 160402], [84, 160732], [88, 161072], [92, 161272], [96, 161674], [104, 162077], [108, 162437], [112, 162657], [119, 162977], [125, 163257], [129, 163437], [134, 163697]]}, {"verse": 24, "start": 164429, "end": 175680, "text": "Most assuredly, I say to you, He that hears my word, and believes on him that sent me, has everlasting life, and shall not come into condemnation; but is passed from death to life.", "words": [[0, 164429], [5, 164650], [16, 165290], [18, 165450], [22, 165710], [25, 165910], [30, 166550], [33, 166750], [38, 166950], [44, 167190], [47, 167470], [53, 167850], [57, 168330], [66, 168670], [69, 168930], [73, 169090], [78, 169290], [83, 169510], [87, 170170], [91, 170330], [103, 170690], [109, 171390], [113, 171870], [119, 172050], [123, 172270], [128, 172530], [133, 172690], [147, 173886], [151, 173990], [154, 174130], [161, 174450], [166, 174730], [172, 175050], [175, 175330]]}, {"verse": 25, "start": 176030, "end": 184685, "text": "Most assuredly, I say to you, The hour is coming, and now is, when the dead shall hear the voice of the Son of God: and they that hear shall live.", "words": [[0, 176030], [5, 176231], [16, 176871], [18, 177031], [22, 177251], [25, 177451], [30, 178071], [34, 178191], [39, 178511], [42, 178751], [50, 179551], [54, 179631], [58, 179871], [62, 180531], [67, 180691], [71, 180831], [76, 181031], [82, 181251], [87, 181431], [91, 181571], [97, 181871], [100, 182031], [104, 182151], [108, 182371], [111, 182491], [116, 183197], [120, 183315], [125, 183555], [130, 183795], [135, 184035], [141, 184255]]}, {"verse": 26, "start": 185035, "end": 190306, "text": "For as the Father has life in himself; so has he given to the Son to have life in himself;", "words": [[0, 185035], [4, 185143], [7, 185303], [11, 185443], [18, 185803], [22, 186103], [27, 186443], [30, 186603], [39, 187387], [42, 187552], [46, 187772], [49, 187932], [55, 188232], [58, 188452], [62, 188572], [66, 188892], [69, 189112], [74, 189312], [79, 189612], [82, 189772]]}, {"verse": 27, "start": 190656, "end": 195635, "text": "And has given him authority to execute judgment also, because he is the Son of man.", "words": [[0, 190656], [4, 190782], [8, 190942], [14, 191182], [18, 191402], [28, 191822], [31, 192102], [39, 192602], [48, 193062], [54, 193522], [62, 194182], [65, 194482], [68, 194722], [72, 194862], [76, 195062], [79, 195182]]}, {"verse": 28, "start": 195985, "end": 201900, "text": "Marvel not at this: for the hour is coming, in which all that are in the graves shall hear his voice,", "words": [[0, 195985], [7, 196324], [11, 196584], [14, 196744], [20, 197394], [24, 197490], [28, 197650], [33, 197950], [36, 198170], [44, 198890], [47, 199150], [53, 199350], [57, 199650], [62, 199810], [66, 199970], [69, 200110], [73, 200210], [80, 200590], [86, 200850], [91, 201090], [95, 201290]]}, {"verse": 29, "start": 202250, "end": 209492, "text": "And shall come forth; they that have done good, to the resurrection of life; and they that have done evil, to the resurrection of damnation.", "words": [[0, 202250], [4, 202398], [10, 202558], [15, 202818], [22, 203458], [27, 203684], [32, 203944], [37, 204084], [42, 204304], [48, 204604], [51, 204904], [55, 205024], [68, 205424], [71, 205744], [77, 206294], [81, 206437], [86, 206637], [91, 206817], [96, 206977], [101, 207177], [107, 207557], [110, 207792], [114, 207912], [127, 208432], [130, 208712]]}, {"verse": 30, "start": 209842, "end": 219716, "text": "I can of my own self do nothing: as I hear, I judge: and my judgment is just; because I seek not my own will, but the will of the Father which has sent me.", "words": [[0, 209842], [2, 210073], [6, 210343], [9, 210403], [12, 210623], [16, 210783], [21, 211063], [24, 211303], [33, 212047], [36, 212186], [38, 212346], [44, 212846], [46, 212926], [53, 213766], [57, 213885], [60, 214045], [69, 214405], [72, 214785], [78, 215425], [86, 215641], [88, 215861], [93, 216121], [97, 216381], [100, 216581], [104, 216741], [110, 217341], [114, 217681], [118, 217841], [123, 218081], [126, 218301], [130, 218441], [137, 218761], [143, 219021], [147, 219161], [152, 219401]]}, {"verse": 31, "start": 220066, "end": 223283, "text": "If I bear witness of myself, my witness is not true.", "words": [[0, 220066], [3, 220193], [5, 220313], [10, 220553], [18, 220813], [21, 221073], [29, 221933], [32, 222033], [40, 222293], [43, 222553], [47, 222733]]}, {"verse": 32, "start": 223633, "end": 229285, "text": "¶ There is another that bears witness of me; and I know that the witness which he witnesses of me is true.", "words": [[2, 223633], [8, 223810], [11, 224010], [19, 224330], [24, 224630], [30, 224930], [38, 225290], [41, 225590], [45, 226117], [49, 226243], [51, 226423], [56, 226663], [61, 226923], [65, 227063], [73, 227343], [79, 227603], [82, 227763], [92, 228083], [95, 228403], [98, 228583], [101, 228763]]}, {"verse": 33, "start": 229635, "end": 232341, "text": "You sent to John, and he bore witness to the truth.", "words": [[0, 229635], [4, 229781], [9, 230021], [12, 230201], [18, 230841], [22, 230941], [25, 231081], [30, 231321], [38, 231601], [41, 231881], [45, 231981]]}, {"verse": 34, "start": 232691, "end": 238229, "text": "But I receive not testimony from man: but these things I say, that you might be saved.", "words": [[0, 232691], [4, 232793], [6, 232933], [14, 233373], [18, 233733], [28, 234213], [33, 234613], [38, 235369], [42, 235469], [48, 235689], [55, 236009], [57, 236229], [62, 236629], [67, 236989], [71, 237169], [77, 237389], [80, 237569]]}, {"verse": 35, "start": 238579, "end": 243623, "text": "He was a burning and a shining light: and you were willing for a season to rejoice in his light.", "words": [[0, 238579], [3, 238640], [7, 238780], [9, 238900], [17, 239220], [21, 239660], [23, 239760], [31, 240080], [38, 240899], [42, 241023], [46, 241163], [51, 241263], [59, 241483], [63, 241763], [65, 241883], [72, 242203], [75, 242383], [83, 242743], [86, 243023], [90, 243163]]}, {"verse": 36, "start": 243973, "end": 253341, "text": "¶ But I have greater witness than that of John: for the works which the Father has given me to finish, the same works that I do, bear witness of me, that the Father has sent me.", "words": [[2, 243973], [6, 244053], [8, 244213], [13, 244413], [21, 244713], [29, 245133], [34, 245433], [39, 245593], [42, 245713], [48, 246462], [52, 246551], [56, 246671], [62, 246931], [68, 247131], [72, 247331], [79, 247571], [83, 247811], [89, 248011], [92, 248211], [95, 248331], [103, 249131], [107, 249331], [112, 249571], [118, 249831], [123, 250031], [125, 250211], [129, 250451], [134, 250891], [142, 251211], [145, 251491], [149, 251711], [154, 252191], [158, 252331], [165, 252571], [169, 252771], [174, 253011]]}, {"verse": 37, "start": 253691, "end": 261007, "text": "And the Father himself, which has sent me, has borne witness of me. You have neither heard his voice at any time, nor seen his shape.", "words": [[0, 253691], [4, 253789], [8, 253889], [15, 254149], [24, 254849], [30, 255069], [34, 255229], [39, 255429], [43, 256029], [47, 256189], [53, 256529], [61, 256769], [64, 257009], [68, 257549], [72, 257850], [77, 257990], [85, 258190], [91, 258490], [95, 258650], [101, 258890], [104, 259070], [108, 259270], [114, 259990], [118, 260090], [123, 260350], [127, 260510]]}, {"verse": 38, "start": 261357, "end": 266001, "text": "And you have not his word abiding in you: for whom he has sent, him you believe not.", "words": [[0, 261357], [4, 261474], [8, 261594], [13, 261754], [17, 261934], [21, 262134], [26, 262434], [34, 262894], [37, 263094], [42, 263614], [46, 263711], [51, 263911], [54, 264071], [58, 264231], [64, 264851], [68, 264991], [72, 265111], [80, 265451]]}, {"verse": 39, "start": 266351, "end": 272169, "text": "¶ Search the scriptures; for in them you think you have eternal life: and they are they which testify of me.", "words": [[2, 266351], [9, 266594], [13, 266814], [25, 267741], [29, 267854], [32, 268034], [37, 268174], [41, 268374], [47, 268574], [51, 268754], [56, 268894], [64, 269234], [70, 269974], [74, 270094], [79, 270294], [83, 270474], [88, 270714], [94, 271014], [102, 271454], [105, 271874]]}, {"verse": 40, "start": 272519, "end": 275229, "text": "And you will not come to me, that you might have life.", "words": [[0, 272519], [4, 272679], [8, 272839], [13, 272999], [17, 273199], [22, 273499], [25, 273699], [29, 273939], [34, 274299], [38, 274459], [44, 274659], [49, 274859]]}, {"verse": 41, "start": 275579, "end": 277357, "text": "I receive not honour from men.", "words": [[0, 275579], [2, 275704], [10, 276044], [14, 276364], [21, 276684], [26, 276924]]}, {"verse": 42, "start": 277707, "end": 281332, "text": "But I know you, that you have not the love of God in you.", "words": [[0, 277707], [4, 277829], [6, 277989], [11, 278249], [16, 278829], [21, 279229], [25, 279389], [30, 279609], [34, 279809], [38, 280009], [43, 280229], [46, 280369], [50, 280669], [53, 280969]]}, {"verse": 43, "start": 281682, "end": 288861, "text": "I am come in my Father’s name, and you receive me not: if another shall come in his own name, him you will receive.", "words": [[0, 281682], [2, 281861], [5, 282008], [10, 282154], [13, 282301], [16, 282581], [25, 283061], [31, 283581], [35, 283801], [39, 283961], [47, 284381], [50, 284621], [55, 285351], [58, 285491], [66, 285771], [72, 286071], [77, 286351], [80, 286471], [84, 286651], [88, 286831], [94, 287731], [98, 287891], [102, 288131], [107, 288291]]}, {"verse": 44, "start": 289211, "end": 294790, "text": "How can you believe, which receive honour one of another, and seek not the honour that comes from God only?", "words": [[0, 289211], [4, 289335], [8, 289535], [12, 289635], [21, 289995], [27, 290535], [35, 290905], [42, 291275], [46, 291515], [49, 291655], [58, 291995], [62, 292435], [67, 292675], [71, 292955], [75, 293175], [82, 293395], [87, 293595], [93, 293875], [98, 294095], [102, 294315]]}, {"verse": 45, "start": 295140, "end": 301396, "text": "Do not think that I will accuse you to the Father: there is one that accuses you, even Moses, in whom you trust.", "words": [[0, 295140], [3, 295307], [7, 295507], [13, 295807], [18, 296027], [20, 296167], [25, 296307], [32, 296627], [36, 296867], [39, 297007], [43, 297127], [51, 297880], [57, 297998], [60, 298178], [64, 298418], [69, 298598], [77, 299158], [82, 299458], [87, 299658], [94, 300298], [97, 300438], [102, 300618], [106, 300798]]}, {"verse": 46, "start": 301746, "end": 306020, "text": "For had you believed Moses, you would have believed me: for he wrote of me.", "words": [[0, 301746], [4, 301848], [8, 302008], [12, 302168], [21, 302548], [28, 303448], [32, 303588], [38, 303728], [43, 303808], [52, 304128], [56, 304878], [60, 305026], [63, 305226], [69, 305486], [72, 305666]]}, {"verse": 47, "start": 306370, "end": 310241, "text": "But if you believe not his writings, how shall you believe my words?", "words": [[0, 306370], [4, 306469], [7, 306589], [11, 306749], [19, 307129], [23, 307349], [27, 307589], [37, 308469], [41, 308649], [47, 308869], [51, 309009], [59, 309329], [62, 309589]]}]}