{"book": "MAT", "chapter": 27, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 517433, "verses": [{"verse": 1, "start": 300, "end": 11008, "text": "Y venida la mañana, entraron en consejo todos los príncipes de los sacerdotes, y los ancianos del pueblo, contra Jesús, para entregarle a muerte.", "words": [[0, 300], [2, 423], [9, 783], [12, 903], [20, 1903], [29, 2663], [32, 2823], [40, 3423], [46, 3743], [50, 4243], [60, 4883], [63, 5023], [67, 5143], [79, 5923], [81, 6343], [85, 6483], [94, 7023], [98, 7183], [106, 7663], [113, 8263], [120, 8743], [125, 9583], [136, 10363], [138, 10423]]}, {"verse": 2, "start": 11358, "end": 16277, "text": "Y le llevaron atado, y le entregaron a Poncio Pilato gobernador.", "words": [[0, 11358], [2, 11482], [5, 11642], [14, 12202], [21, 12922], [23, 13402], [26, 13542], [37, 14262], [39, 14382], [46, 14842], [53, 15367]]}, {"verse": 3, "start": 16627, "end": 28903, "text": "Entonces Judas, el que le había entregado, viendo que era condenado, volvió arrepentido las treinta piezas de plata a los príncipes de los sacerdotes y a los ancianos,", "words": [[0, 16627], [9, 17516], [16, 18359], [19, 18539], [23, 18699], [26, 18859], [32, 19139], [43, 20359], [50, 20619], [54, 20879], [58, 21079], [69, 22199], [76, 22719], [88, 23699], [92, 23899], [100, 24499], [107, 24959], [110, 25079], [116, 25399], [118, 25659], [122, 25779], [132, 26439], [135, 26559], [139, 26679], [150, 27459], [152, 27839], [154, 27899], [158, 28039]]}, {"verse": 4, "start": 29253, "end": 36823, "text": "Diciendo: Yo he pecado entregando la sangre inocente. Pero ellos dijeron: ¿Qué nos importa a nosotros? Allá tú.", "words": [[0, 29253], [10, 30281], [13, 30440], [16, 30580], [23, 31020], [34, 31580], [37, 31720], [44, 32040], [54, 33191], [59, 33336], [65, 33596], [74, 34581], [79, 34663], [83, 34803], [91, 35243], [93, 35383], [103, 36242], [108, 36521]]}, {"verse": 5, "start": 37103, "end": 42621, "text": "Y arrojando las piezas de plata en el templo, se partió; y fue, y se ahorcó.", "words": [[0, 37103], [2, 37244], [12, 37884], [16, 38184], [23, 38484], [26, 38604], [32, 38964], [35, 39124], [38, 39284], [46, 40004], [49, 40224], [57, 41043], [59, 41182], [64, 41342], [66, 41822], [69, 41922]]}, {"verse": 6, "start": 42971, "end": 52069, "text": "Y los príncipes de los sacerdotes, tomando las piezas de plata, dijeron: No es lícito echarlas en el tesoro de los dones, porque es precio de sangre.", "words": [[0, 42971], [2, 43060], [6, 43180], [16, 43920], [19, 44040], [23, 44180], [35, 45040], [43, 45680], [47, 45860], [54, 46220], [57, 46340], [64, 46720], [73, 47569], [76, 47727], [79, 47907], [86, 48287], [95, 48947], [98, 49147], [101, 49377], [108, 49607], [111, 49747], [115, 49867], [122, 50567], [129, 50927], [132, 51107], [139, 51387], [142, 51567]]}, {"verse": 7, "start": 52349, "end": 59336, "text": "Pero habido consejo, compraron con ellas el campo del alfarero, por sepultura para los extranjeros.", "words": [[0, 52349], [5, 52637], [12, 52817], [21, 53417], [31, 54097], [35, 54297], [41, 54557], [44, 54797], [50, 55277], [54, 55537], [64, 56337], [68, 57017], [78, 57797], [83, 58077], [87, 58277]]}, {"verse": 8, "start": 59686, "end": 64443, "text": "Por lo cual fue llamado aquel campo, Campo de sangre, hasta el día de hoy.", "words": [[0, 59686], [4, 59810], [7, 59950], [12, 60150], [16, 60330], [24, 60670], [30, 61050], [37, 61870], [43, 62310], [46, 62510], [54, 63250], [60, 63530], [63, 63690], [67, 63870], [70, 64050]]}, {"verse": 9, "start": 64793, "end": 75834, "text": "Entonces se cumplió lo que fue dicho por el profeta Jeremías, que dijo: Y tomaron las treinta piezas de plata, precio del apreciado, que fue apreciado por los hijos de Israel;", "words": [[0, 64793], [9, 65289], [12, 65629], [20, 66189], [23, 66329], [27, 66469], [31, 66649], [37, 66949], [41, 67189], [44, 67329], [52, 67809], [62, 68789], [66, 68849], [72, 69584], [74, 69690], [82, 70090], [86, 70400], [94, 70710], [101, 71190], [104, 71310], [111, 71770], [118, 72090], [122, 72370], [133, 73010], [137, 73470], [141, 73650], [151, 74250], [155, 74450], [159, 74610], [165, 74910], [168, 75090]]}, {"verse": 10, "start": 76184, "end": 80158, "text": "Y las dieron para el campo del alfarero, como me ordenó el Señor.", "words": [[0, 76184], [2, 76309], [6, 76449], [13, 76829], [18, 77109], [21, 77289], [27, 77609], [31, 77869], [41, 78589], [46, 78809], [49, 79029], [56, 79449], [59, 79529]]}, {"verse": 11, "start": 80508, "end": 90796, "text": "Y Jesús estuvo delante del gobernador; y el gobernador le preguntó, diciendo: ¿Eres tú el Rey de los judíos? Y Jesús le dijo: Tú lo dices.", "words": [[0, 80508], [2, 80630], [8, 81050], [15, 81650], [23, 82216], [27, 82781], [39, 83502], [41, 83666], [44, 83766], [55, 84446], [58, 84606], [68, 85226], [78, 86114], [84, 86301], [87, 86601], [90, 86781], [94, 87001], [97, 87061], [101, 87201], [109, 88190], [111, 88314], [117, 88694], [120, 89094], [126, 89859], [129, 89982], [132, 90102]]}, {"verse": 12, "start": 91146, "end": 97511, "text": "Y siendo acusado por los príncipes de los sacerdotes, y por los ancianos, nada respondió.", "words": [[0, 91146], [2, 91271], [9, 91571], [17, 92231], [21, 92451], [25, 92631], [35, 93231], [38, 93311], [42, 93451], [54, 94211], [56, 94371], [60, 94551], [64, 94731], [74, 95651], [79, 95971]]}, {"verse": 13, "start": 97861, "end": 102657, "text": "Pilato entonces le dice: ¿No oyes cuántas cosas testifican contra ti?", "words": [[0, 97861], [7, 98350], [16, 98830], [19, 99270], [25, 100105], [29, 100281], [34, 100581], [42, 101321], [48, 101321], [59, 102001], [66, 102281]]}, {"verse": 14, "start": 102937, "end": 109061, "text": "Y no le respondió ni una palabra; de tal manera que el gobernador se maravillaba mucho.", "words": [[0, 102937], [2, 103062], [5, 103222], [8, 103402], [18, 104102], [21, 104402], [25, 104642], [34, 105662], [37, 105801], [41, 106081], [48, 106441], [52, 106721], [55, 106901], [66, 107521], [69, 107721], [81, 108401]]}, {"verse": 15, "start": 109411, "end": 116480, "text": "Y en el día de la fiesta acostumbraba el gobernador soltar al pueblo un preso, el que quisiesen.", "words": [[0, 109411], [2, 109690], [5, 109830], [8, 109970], [12, 110270], [15, 110410], [18, 110530], [25, 111090], [38, 112030], [41, 112150], [52, 112770], [59, 113430], [62, 113630], [69, 113970], [72, 114370], [79, 115410], [82, 115530], [86, 115670]]}, {"verse": 16, "start": 116830, "end": 121207, "text": "Y tenían entonces un preso famoso que se llamaba Barrabás.", "words": [[0, 116830], [2, 117076], [9, 117356], [18, 117956], [21, 118276], [27, 118776], [34, 119136], [38, 119436], [41, 119576], [49, 120056]]}, {"verse": 17, "start": 121557, "end": 128636, "text": "Y juntos ellos, les dijo Pilato: ¿Cuál queréis que os suelte? ¿a Barrabás, o a Jesús que se dice el Cristo?", "words": [[0, 121557], [2, 121683], [9, 122143], [16, 122963], [20, 123083], [25, 123423], [33, 124327], [39, 124490], [47, 124890], [51, 125050], [54, 125170], [62, 125971], [65, 126098], [75, 126678], [77, 126878], [79, 126938], [85, 127258], [89, 127518], [92, 127638], [97, 127878], [100, 128038]]}, {"verse": 18, "start": 128916, "end": 132492, "text": "Porque sabía que por envidia le habían entregado.", "words": [[0, 128916], [7, 129159], [13, 129679], [17, 129879], [21, 130179], [29, 130939], [32, 131119], [39, 131519]]}, {"verse": 19, "start": 132842, "end": 144991, "text": "Y estando él sentado en el tribunal, su mujer envió a él, diciendo: No tengas que ver con aquel justo; porque hoy he padecido muchas cosas en sueños por causa de él.", "words": [[0, 132842], [2, 133191], [10, 133631], [13, 133791], [21, 134391], [24, 134531], [27, 134631], [37, 135591], [40, 135731], [46, 136151], [52, 136751], [54, 136891], [58, 137111], [68, 138655], [71, 138845], [78, 139285], [82, 139405], [86, 139585], [90, 139805], [96, 140125], [103, 140980], [110, 141209], [114, 141569], [117, 141809], [126, 142349], [133, 142689], [139, 143069], [142, 143329], [149, 143829], [153, 144049], [159, 144289], [162, 144649]]}, {"verse": 20, "start": 145271, "end": 154461, "text": "Pero los príncipes de los sacerdotes y los ancianos, persuadieron al pueblo que pidiese a Barrabás, y a Jesús matase.", "words": [[0, 145271], [5, 145455], [9, 145655], [19, 146435], [22, 146575], [26, 146715], [37, 147415], [39, 147555], [43, 147715], [53, 148535], [66, 150235], [69, 150435], [76, 150855], [80, 151235], [88, 151855], [90, 152175], [100, 152855], [102, 153115], [104, 153215], [110, 153535]]}, {"verse": 21, "start": 154811, "end": 162696, "text": "Y respondiendo el gobernador les dijo: ¿Cuál de los dos queréis que os suelte? Y ellos dijeron: A Barrabás.", "words": [[0, 154811], [2, 154916], [15, 155636], [18, 155756], [29, 156376], [33, 156576], [39, 157284], [45, 157605], [48, 157725], [52, 157885], [56, 158125], [64, 158605], [68, 158785], [71, 158905], [79, 159827], [81, 159994], [87, 160174], [96, 161649], [98, 162173]]}, {"verse": 22, "start": 162976, "end": 170046, "text": "Pilato les dijo: ¿Qué pues haré de Jesús que se dice el Cristo? Le dicen todos: Sea crucificado.", "words": [[0, 162976], [7, 163379], [11, 163579], [17, 164416], [22, 164536], [27, 164816], [32, 165256], [35, 165316], [41, 165696], [45, 165956], [48, 166096], [53, 166376], [56, 166496], [64, 167417], [67, 167543], [73, 167803], [80, 168806], [84, 169092]]}, {"verse": 23, "start": 170326, "end": 177340, "text": "Y el gobernador les dijo: Pues ¿qué mal ha hecho? Pero ellos gritaban más, diciendo: Sea crucificado.", "words": [[0, 170326], [2, 170470], [5, 170530], [16, 171090], [20, 171290], [26, 172034], [31, 172400], [36, 172460], [40, 172620], [43, 172760], [50, 173447], [55, 173609], [61, 173849], [70, 174509], [75, 174829], [85, 176101], [89, 176387]]}, {"verse": 24, "start": 177620, "end": 191148, "text": "Y viendo Pilato que nada adelantaba, antes se hacía más alboroto, tomando agua se lavó las manos delante del pueblo, diciendo: Inocente soy yo de la sangre de este justo: allá vosotros.", "words": [[0, 177620], [2, 177748], [9, 178048], [16, 178588], [20, 178788], [25, 179068], [37, 180188], [43, 180528], [46, 180828], [52, 181188], [56, 181448], [66, 182828], [74, 183268], [79, 183608], [82, 183848], [87, 184108], [91, 184268], [97, 184508], [105, 184968], [109, 185168], [117, 185748], [127, 187217], [136, 187859], [140, 188219], [143, 188479], [146, 188579], [149, 188719], [156, 189039], [159, 189279], [164, 189519], [171, 190339], [176, 190578]]}, {"verse": 25, "start": 191428, "end": 198606, "text": "Y respondiendo todo el pueblo, dijo: Su sangre sea sobre nosotros, y sobre nuestros hijos.", "words": [[0, 191492], [2, 191592], [15, 192512], [20, 192892], [23, 193172], [31, 193572], [37, 194425], [40, 194540], [47, 194900], [51, 195300], [57, 195580], [67, 196120], [69, 196540], [75, 196760], [84, 197080]]}, {"verse": 26, "start": 198886, "end": 205563, "text": "Entonces les soltó a Barrabás: y habiendo azotado a Jesús, le entregó para ser crucificado.", "words": [[0, 198886], [9, 199430], [13, 199895], [19, 200535], [21, 201067], [31, 201770], [33, 202007], [42, 202457], [50, 202907], [52, 202987], [59, 203247], [62, 203627], [70, 204107], [75, 204267], [79, 204507]]}, {"verse": 27, "start": 205563, "end": 214030, "text": "Entonces los soldados del gobernador llevaron a Jesús al palacio del gobernador, y juntaron a él toda la compañía;", "words": [[0, 205563], [9, 206163], [13, 206803], [22, 207503], [26, 207663], [37, 208263], [46, 208763], [48, 208863], [54, 209083], [57, 209403], [65, 209963], [69, 210103], [81, 211213], [83, 211623], [92, 212263], [94, 212423], [97, 212643], [102, 212943], [105, 213223]]}, {"verse": 28, "start": 214380, "end": 218728, "text": "Y desnudándole, le echaron encima un manto escarlata;", "words": [[0, 214380], [2, 214508], [16, 215588], [19, 215848], [27, 216428], [34, 216988], [37, 217308], [43, 218018]]}, {"verse": 29, "start": 219078, "end": 232569, "text": "Y pusieron sobre su cabeza una corona tejida de espinas, y una caña en su mano derecha; y arrodillándose delante de él, se burlaban de él, diciendo: ¡Salve, Rey de los judíos!", "words": [[0, 219078], [2, 219187], [11, 219627], [17, 219947], [20, 220147], [27, 220567], [31, 220827], [38, 221267], [45, 221967], [48, 222167], [57, 222907], [59, 223367], [63, 223547], [68, 224007], [71, 224267], [74, 224447], [79, 224707], [88, 225688], [90, 225814], [105, 226834], [113, 227354], [116, 227554], [120, 228074], [123, 228294], [132, 228974], [135, 229234], [139, 229714], [149, 230842], [157, 231267], [161, 231567], [164, 231667], [168, 231787]]}, {"verse": 30, "start": 232849, "end": 237425, "text": "Y escupiendo en él, tomaron la caña, y le herían en la cabeza.", "words": [[0, 232849], [2, 232992], [13, 233652], [16, 233832], [20, 234452], [28, 234872], [31, 235052], [37, 235552], [39, 235807], [42, 236007], [49, 236447], [52, 236607], [55, 236727]]}, {"verse": 31, "start": 237775, "end": 246098, "text": "Y después que se hubieron burlado de él, le desnudaron el manto, y le vistieron de sus vestidos, y le llevaron para crucificarle.", "words": [[0, 237775], [2, 237870], [10, 238170], [14, 238350], [17, 238510], [26, 238850], [34, 239370], [37, 239590], [41, 240070], [44, 240170], [55, 240890], [58, 241090], [65, 241590], [67, 242050], [70, 242170], [80, 242730], [83, 242910], [87, 243090], [97, 243710], [99, 243980], [102, 244250], [111, 244710], [116, 244950]]}, {"verse": 32, "start": 246448, "end": 254019, "text": "Y saliendo, hallaron a un cireneo, que se llamaba Simón: a este cargaron para que llevase su cruz.", "words": [[0, 246448], [2, 246596], [12, 247156], [21, 248036], [23, 248156], [26, 248616], [35, 249076], [39, 249356], [42, 249496], [50, 249956], [57, 251142], [59, 251342], [64, 251602], [73, 252362], [78, 252642], [82, 252802], [90, 253322], [93, 253422]]}, {"verse": 33, "start": 254369, "end": 261019, "text": "Y cuando llegaron al lugar que se llama Gólgota, que es dicho, El lugar de la calavera,", "words": [[0, 254369], [2, 254474], [9, 254714], [18, 255334], [21, 255614], [27, 256054], [31, 256514], [34, 256654], [40, 256994], [49, 258274], [53, 258334], [56, 258554], [63, 259414], [66, 259594], [72, 259914], [75, 260094], [78, 260234]]}, {"verse": 34, "start": 261369, "end": 267492, "text": "Le dieron a beber vinagre mezclado con hiel; y después de probarlo, no quiso beberlo.", "words": [[0, 261369], [3, 261475], [10, 261855], [12, 261955], [18, 262195], [26, 262875], [35, 263615], [39, 264025], [45, 264644], [47, 264789], [55, 264989], [58, 265189], [68, 266169], [71, 266269], [77, 266649]]}, {"verse": 35, "start": 267842, "end": 281869, "text": "Y después que le hubieron crucificado, repartieron sus vestidos, echando suertes: para que se cumpliese lo que fue dicho por el profeta: Se repartieron mis vestidos, y sobre mi ropa echaron suertes.", "words": [[0, 267842], [2, 267948], [10, 268268], [14, 268488], [17, 268628], [26, 269028], [39, 270028], [51, 271008], [55, 271228], [65, 271848], [73, 272588], [82, 273676], [87, 273894], [91, 274034], [94, 274174], [104, 274834], [107, 274994], [111, 275114], [115, 275294], [121, 275594], [125, 275914], [128, 276074], [137, 277222], [140, 277352], [152, 278032], [156, 278272], [166, 279372], [168, 279572], [174, 279852], [177, 280112], [182, 280612], [190, 281032]]}, {"verse": 36, "start": 282219, "end": 284919, "text": "Y sentados le guardaban allí.", "words": [[0, 282219], [2, 282343], [11, 283123], [14, 283683], [24, 284363]]}, {"verse": 37, "start": 285269, "end": 292842, "text": "Y pusieron sobre su cabeza la acusación escrita contra él: ESTE ES JESÚS EL REY DE LOS JUDÍOS.", "words": [[0, 285269], [2, 285358], [11, 285858], [17, 286178], [20, 286438], [27, 286998], [30, 287598], [40, 288378], [48, 288898], [55, 289238], [59, 289953], [64, 290242], [67, 290442], [73, 291302], [76, 291382], [80, 291842], [83, 292142], [87, 292282]]}, {"verse": 38, "start": 293192, "end": 300135, "text": "Entonces crucificaron con él dos ladrones, uno a la derecha, y otro a la izquierda.", "words": [[0, 293192], [9, 293788], [22, 294828], [26, 295048], [29, 295248], [33, 295508], [43, 296788], [47, 297128], [49, 297428], [52, 297508], [61, 298148], [63, 298668], [68, 298908], [70, 299208], [73, 299308]]}, {"verse": 39, "start": 300485, "end": 304934, "text": "Y los que pasaban, lo insultaban, meneando sus cabezas,", "words": [[0, 300485], [2, 300751], [6, 300871], [10, 301011], [19, 301691], [22, 302131], [34, 303211], [43, 303791], [47, 304011]]}, {"verse": 40, "start": 305284, "end": 314226, "text": "Y diciendo: Tú, el que derribas el templo, y en tres días lo reedificas, sálvate a ti mismo: si eres Hijo de Dios, desciende de la cruz.", "words": [[0, 305284], [2, 305402], [12, 306402], [16, 306559], [19, 306679], [23, 306799], [32, 307259], [35, 307379], [43, 308199], [45, 308319], [48, 308439], [53, 308639], [58, 308879], [61, 309539], [73, 310199], [81, 310619], [83, 310799], [86, 310879], [93, 311612], [96, 311791], [101, 311951], [106, 312231], [109, 312411], [115, 313071], [125, 313451], [128, 313611], [131, 313731]]}, {"verse": 41, "start": 314506, "end": 323457, "text": "De esta manera también los príncipes de los sacerdotes, burlándose de él con los escribas y los fariseos y los ancianos, decían:", "words": [[0, 314506], [3, 314674], [8, 314854], [15, 315134], [23, 315554], [27, 315814], [37, 316574], [40, 316834], [44, 316994], [56, 318314], [67, 319074], [70, 319254], [73, 319434], [77, 319614], [81, 319774], [90, 320394], [92, 320534], [96, 320674], [105, 321354], [107, 321454], [111, 321614], [121, 322614]]}, {"verse": 42, "start": 323657, "end": 330728, "text": "A otros salvó, a sí mismo no puede salvar: si es el Rey de Israel, descienda ahora de la cruz, y creeremos en él.", "words": [[0, 323657], [2, 323798], [8, 324058], [15, 324598], [17, 324658], [20, 324798], [26, 325178], [29, 325278], [35, 325498], [43, 326348], [46, 326528], [49, 326708], [52, 326848], [56, 327128], [59, 327168], [67, 327608], [77, 328388], [83, 328648], [86, 328788], [89, 328908], [95, 329428], [97, 329788], [107, 330148], [110, 330408]]}, {"verse": 43, "start": 331078, "end": 336826, "text": "Confió en Dios: que Dios lo libre ahora, si lo quiere, porque ha dicho: Soy Hijo de Dios.", "words": [[0, 331078], [7, 331497], [10, 331617], [16, 332389], [20, 332485], [25, 332705], [28, 332945], [34, 333165], [41, 333505], [44, 333745], [47, 333885], [55, 334445], [62, 334665], [65, 334865], [72, 335547], [76, 335766], [81, 336106], [84, 336286]]}, {"verse": 44, "start": 337106, "end": 342336, "text": "Lo mismo también le insultaban los ladrones que estaban crucificados con él.", "words": [[0, 337106], [3, 337233], [9, 337493], [17, 338013], [20, 338393], [31, 339333], [35, 339573], [44, 340173], [48, 340393], [56, 340693], [69, 341713], [73, 341953]]}, {"verse": 45, "start": 342686, "end": 347911, "text": "Y desde la hora de sexta fueron tinieblas sobre toda la tierra hasta la hora de nona.", "words": [[0, 342686], [2, 342958], [8, 343158], [11, 343438], [16, 343658], [19, 343818], [25, 344318], [32, 344558], [42, 345338], [48, 345558], [53, 345898], [56, 346138], [63, 346478], [69, 346938], [72, 347098], [77, 347278], [80, 347438]]}, {"verse": 46, "start": 348261, "end": 360799, "text": "Y cerca de la hora de nona, Jesús exclamó con grande voz, diciendo: Elí, Elí, ¿lama sabachtani? Esto es: Dios mío, Dios mío, ¿por qué me has desamparado?", "words": [[0, 348261], [2, 348385], [8, 348765], [11, 349125], [14, 349245], [19, 349465], [22, 349645], [28, 350325], [34, 350645], [42, 351825], [46, 351965], [53, 352365], [58, 352705], [68, 353883], [73, 354509], [78, 355355], [84, 356201], [96, 357204], [101, 357469], [105, 358091], [110, 358276], [115, 358676], [120, 358776], [125, 359296], [130, 359376], [134, 359516], [137, 359676], [141, 359796]]}, {"verse": 47, "start": 361149, "end": 366952, "text": "Y algunos de los que estaban allí, al oírlo, decían: A Elías llama este.", "words": [[0, 361149], [2, 361273], [10, 361613], [13, 361873], [17, 361993], [21, 362133], [29, 362453], [35, 363093], [38, 363373], [45, 364493], [53, 365619], [55, 365761], [61, 366161], [67, 366481]]}, {"verse": 48, "start": 367232, "end": 376971, "text": "Y luego, corriendo uno de ellos, tomó una esponja, y la empapó en vinagre, y poniéndola en una caña, le daba de beber.", "words": [[0, 367232], [2, 367376], [9, 367616], [19, 368416], [23, 368676], [26, 368856], [33, 369756], [38, 370216], [42, 370416], [51, 371216], [53, 371576], [56, 371936], [63, 372576], [66, 372676], [75, 373296], [77, 373656], [88, 374556], [91, 374736], [95, 374896], [101, 375416], [104, 375956], [109, 376276], [112, 376416]]}, {"verse": 49, "start": 377321, "end": 381620, "text": "Y los otros decían: Deja, veamos si viene Elías a librarle.", "words": [[0, 377321], [2, 377426], [6, 377566], [12, 377906], [20, 379153], [26, 379495], [33, 380015], [36, 380255], [42, 380475], [48, 380765], [50, 381055]]}, {"verse": 50, "start": 381900, "end": 387437, "text": "Pero Jesús, habiendo otra vez exclamado con grande voz, entregó el espíritu.", "words": [[0, 381900], [5, 382028], [12, 382768], [21, 383188], [26, 383408], [30, 383728], [40, 384588], [44, 384748], [51, 385088], [56, 385988], [64, 386648], [67, 386768]]}, {"verse": 51, "start": 387787, "end": 395910, "text": "Y he aquí, el velo del templo se rompió en dos, de alto a bajo: y la tierra tembló, y las rocas se partieron;", "words": [[0, 387787], [2, 387915], [5, 388115], [11, 388475], [14, 388775], [19, 389055], [23, 389195], [30, 389735], [33, 389855], [40, 390355], [43, 390515], [48, 391195], [51, 391275], [56, 391600], [58, 391926], [64, 392414], [66, 392540], [69, 392660], [76, 392960], [84, 394020], [86, 394260], [90, 394420], [96, 394880], [99, 395080]]}, {"verse": 52, "start": 396260, "end": 402398, "text": "Y se abrieron los sepulcros, y muchos cuerpos de santos que habían dormido, se levantaron;", "words": [[0, 396260], [2, 396554], [5, 396654], [14, 397114], [18, 397294], [29, 398054], [31, 398414], [38, 398694], [46, 399314], [49, 399434], [56, 400094], [60, 400274], [67, 400514], [76, 401114], [79, 401294]]}, {"verse": 53, "start": 402748, "end": 410904, "text": "Y salidos de los sepulcros, después de su resurrección, vinieron a la santa ciudad, y aparecieron a muchos.", "words": [[0, 402748], [2, 402889], [10, 403329], [13, 403489], [17, 403609], [28, 404749], [36, 405089], [39, 405289], [42, 405429], [56, 406379], [65, 407329], [67, 407609], [70, 407709], [76, 408029], [84, 408789], [86, 409309], [98, 410129], [100, 410229]]}, {"verse": 54, "start": 411254, "end": 423862, "text": "Y el centurión, y los que estaban con él guardando a Jesús, visto el terremoto, y las cosas que habían sido hechas, temieron en gran manera, diciendo: Verdaderamente Hijo de Dios era este.", "words": [[0, 411254], [2, 411437], [5, 411617], [16, 412437], [18, 412657], [22, 412797], [26, 412937], [34, 413217], [38, 413557], [41, 413757], [51, 414357], [53, 414497], [60, 415357], [66, 415777], [69, 415937], [80, 416637], [82, 416777], [86, 416957], [92, 417297], [96, 417477], [103, 417777], [108, 418117], [116, 418797], [125, 419357], [128, 419597], [133, 419777], [141, 420297], [151, 421504], [166, 422244], [171, 422524], [174, 422684], [179, 422924], [183, 423284]]}, {"verse": 55, "start": 424142, "end": 431567, "text": "Y estaban allí muchas mujeres mirando de lejos, las cuales habían seguido de Galilea a Jesús, sirviéndole:", "words": [[0, 424142], [2, 424266], [10, 424586], [15, 424906], [22, 425206], [30, 425766], [38, 426566], [41, 426746], [48, 427506], [52, 427746], [59, 428006], [66, 428446], [74, 428986], [77, 429146], [85, 429746], [87, 429906], [94, 430586]]}, {"verse": 56, "start": 431917, "end": 439906, "text": "Entre las cuales estaban María Magdalena, y María la madre de Jacobo y de José, y la madre de los hijos de Zebedeo.", "words": [[0, 431917], [6, 432141], [10, 432361], [17, 432641], [25, 433141], [31, 433581], [42, 434521], [44, 435141], [50, 435501], [53, 435701], [59, 436001], [62, 436221], [69, 436761], [71, 436821], [74, 436921], [80, 437241], [82, 437781], [85, 437921], [91, 438221], [94, 438461], [98, 438601], [104, 438941], [107, 439451]]}, {"verse": 57, "start": 440256, "end": 448756, "text": "Y como fue la tarde del día, vino un hombre rico de Arimatea, llamado José, el cual también había sido discípulo de Jesús.", "words": [[0, 440256], [2, 440362], [7, 440602], [11, 440822], [14, 440962], [20, 441242], [24, 441522], [29, 441882], [34, 442502], [37, 442722], [44, 442982], [49, 443362], [52, 443602], [62, 444262], [70, 444542], [76, 445622], [79, 445702], [84, 445882], [92, 446262], [98, 446562], [103, 446962], [113, 447902], [116, 448062]]}, {"verse": 58, "start": 449106, "end": 456259, "text": "Este llegó a Pilato, y pidió el cuerpo de Jesús: entonces Pilato mandó que se le diese el cuerpo.", "words": [[0, 449106], [5, 449392], [11, 449752], [13, 449872], [21, 450332], [23, 450792], [29, 451152], [32, 451292], [39, 451572], [42, 451812], [49, 452658], [58, 453199], [65, 453760], [71, 454322], [75, 454782], [78, 454942], [81, 455142], [87, 455342], [90, 455602]]}, {"verse": 59, "start": 456609, "end": 460789, "text": "Y tomando José el cuerpo, lo envolvió en una sábana limpia,", "words": [[0, 456609], [2, 456705], [10, 457085], [15, 457445], [18, 457645], [26, 458065], [29, 458465], [38, 459105], [41, 459285], [45, 459465], [52, 460005]]}, {"verse": 60, "start": 461139, "end": 470580, "text": "Y lo puso en su sepulcro nuevo, que había excavado en la roca: y después de hacer rodar una gran piedra a la puerta del sepulcro, se fue.", "words": [[0, 461139], [2, 461241], [5, 461361], [10, 461721], [13, 461861], [16, 462251], [25, 462641], [32, 463101], [36, 463621], [42, 463881], [51, 464641], [54, 464781], [57, 464901], [63, 465686], [65, 465787], [73, 466047], [76, 466207], [82, 466587], [88, 467147], [92, 467287], [97, 467507], [104, 468047], [106, 468147], [109, 468247], [116, 468547], [120, 468847], [130, 469947], [133, 470147]]}, {"verse": 61, "start": 470930, "end": 476974, "text": "Y estaban allí María Magdalena, y la otra María, sentadas delante del sepulcro.", "words": [[0, 470930], [2, 471054], [10, 471394], [15, 471794], [21, 472254], [32, 473234], [34, 473654], [37, 473794], [42, 474054], [49, 474554], [58, 475534], [66, 475974], [70, 476194]]}, {"verse": 62, "start": 477324, "end": 486055, "text": "Y el siguiente día, que es después de la preparación, se juntaron los príncipes de los sacerdotes y los fariseos a Pilato,", "words": [[0, 477324], [2, 477468], [5, 477628], [15, 478048], [20, 478828], [24, 478948], [27, 479148], [35, 479688], [38, 479948], [41, 480108], [54, 481268], [57, 481428], [66, 482008], [70, 482188], [80, 482928], [83, 483048], [87, 483188], [98, 484068], [100, 484288], [104, 484448], [113, 485248], [115, 485448]]}, {"verse": 63, "start": 486405, "end": 493754, "text": "Diciendo: Señor, nos acordamos que aquel engañador dijo, viviendo aún: Después de tres días resucitaré.", "words": [[0, 486405], [10, 487432], [17, 487771], [21, 488071], [31, 488691], [35, 488911], [41, 489171], [51, 489691], [57, 490431], [66, 490951], [71, 491707], [79, 491980], [82, 492220], [87, 492480], [92, 492920]]}, {"verse": 64, "start": 494104, "end": 505852, "text": "Manda, pues, que se asegure el sepulcro hasta el día tercero; porque no vengan sus discípulos de noche, y le hurten, y digan al pueblo: Resucitó de los muertos. Y será el último error peor que el primero.", "words": [[0, 494104], [7, 494424], [13, 494684], [17, 495004], [20, 495144], [28, 495624], [31, 495724], [40, 496304], [46, 496524], [49, 496684], [53, 496864], [62, 497775], [69, 497965], [72, 498145], [79, 498425], [83, 498605], [94, 499165], [97, 499325], [104, 499605], [106, 499905], [109, 500175], [117, 500445], [119, 500665], [125, 500985], [128, 501085], [136, 501846], [145, 502445], [148, 502545], [152, 502665], [161, 503561], [163, 503667], [168, 503887], [171, 504087], [178, 504367], [184, 504707], [189, 505107], [193, 505207], [196, 505307]]}, {"verse": 65, "start": 506132, "end": 510897, "text": "Y Pilato les dijo: Tenéis una guardia: id, aseguradlo como sabéis.", "words": [[0, 506132], [2, 506257], [9, 506717], [13, 506937], [19, 507631], [26, 507934], [30, 508094], [39, 508987], [43, 509097], [54, 510077], [59, 510277]]}, {"verse": 66, "start": 511177, "end": 517033, "text": "Y yendo ellos, aseguraron el sepulcro, sellando la piedra, con la guardia.", "words": [[0, 511177], [2, 511318], [8, 511698], [15, 512098], [26, 513058], [29, 513258], [39, 514438], [48, 514918], [51, 515058], [59, 515778], [63, 516118], [66, 516318]]}]}