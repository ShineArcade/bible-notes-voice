{"book": "PSA", "chapter": 17, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 110691, "verses": [{"verse": 1, "start": 300, "end": 9332, "text": "Oración de David. OYE, oh Jehová, justicia; está atento a mi clamor; escucha mi oración hecha sin labios de engaño.", "words": [[0, 300], [8, 771], [11, 1011], [18, 2184], [23, 2514], [26, 2844], [34, 3174], [44, 3804], [49, 4532], [56, 4912], [58, 5012], [61, 5412], [69, 6056], [77, 6525], [80, 6685], [88, 7125], [94, 7585], [98, 7845], [105, 8405], [108, 8565]]}, {"verse": 2, "start": 9782, "end": 14959, "text": "De delante de tu rostro salga mi juicio; vean tus ojos la rectitud.", "words": [[0, 9782], [3, 10042], [11, 10562], [14, 10722], [17, 10882], [24, 11362], [30, 11762], [33, 11942], [41, 12859], [46, 13208], [50, 13348], [55, 13668], [58, 13968]]}, {"verse": 3, "start": 15409, "end": 26591, "text": "Tú has probado mi corazón, me has visitado de noche; me has puesto a prueba, y nada inicuo hallaste: me he propuesto que mi boca no ha de propasarse.", "words": [[0, 15409], [3, 15536], [7, 15736], [15, 16176], [18, 16316], [27, 17356], [30, 17556], [34, 17776], [43, 18536], [46, 18696], [53, 19548], [56, 19768], [60, 19888], [67, 20088], [69, 20268], [77, 20648], [79, 21308], [84, 21890], [91, 22473], [101, 23355], [104, 23885], [107, 23985], [117, 24445], [121, 24645], [124, 24785], [129, 25045], [132, 25345], [135, 25505], [138, 25625]]}, {"verse": 4, "start": 27041, "end": 33814, "text": "Para las obras humanas, por la palabra de tus labios yo me he guardado de las vías del destructor.", "words": [[0, 27041], [5, 27185], [9, 27385], [15, 27725], [24, 28985], [28, 29245], [31, 29365], [39, 29685], [42, 29925], [46, 30105], [53, 31065], [56, 31145], [59, 31325], [62, 31445], [71, 32085], [74, 32225], [78, 32405], [83, 32745], [87, 32925]]}, {"verse": 5, "start": 34264, "end": 38343, "text": "Sustenta mis pasos en tus caminos, porque mis pies no resbalen.", "words": [[0, 34264],