{"book": "GEN", "chapter": 16, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 141177, "verses": [{"verse": 1, "start": 300, "end": 7282, "text": "Now Sarai Abram’s wife bore him no children: and she had a handmaid, an Egyptian, whose name was Hagar.", "words": [[0, 300], [4, 552], [10, 1072], [18, 1672], [23, 1992], [28, 2352], [32, 2552], [35, 2772], [45, 3789], [49, 3894], [53, 4034], [57, 4234], [59, 4314], [69, 5054], [72, 5154], [82, 5994], [88, 6094], [93, 6394], [97, 6574]]}, {"verse": 2, "start": 7732, "end": 20297, "text": "And Sarai said to Abram, Behold now, the LORD has restrained me from bearing: please, go in to my maid; it may be that I may obtain children by her. And Abram hearkened to the voice of Sarai.", "words": [[0, 7732], [4, 8161], [10, 8561], [15, 8801], [18, 8981], [25, 9884], [32, 10214], [37, 10494], [41, 10714], [46, 10914], [50, 11114], [61, 11734], [64, 11874], [69, 12054], [78, 13046], [86, 13373], [89, 13593], [92, 13813], [95, 14033], [98, 14253], [104, 15037], [107, 15124], [111, 15304], [114, 15444], [119, 15604], [121, 15744], [125, 15864], [132, 16264], [141, 16624], [144, 17004], [149, 17754], [153, 17883], [159, 18463], [169, 18883], [172, 19023], [176, 19123], [182, 19403], [185, 19883]]}, {"verse": 3, "start": 20747, "end": 31089, "text": "And Sarai Abram’s wife took Hagar her maid the Egyptian, after Abram had dwelt ten years in the land of Canaan, and gave her to her husband Abram to be his wife.", "words": [[0, 20747], [4, 20853], [10, 21373], [18, 21893], [23, 22153], [28, 22433], [34, 22933], [38, 23203], [43, 23473], [47, 23693], [57, 24433], [63, 24823], [69, 25213], [73, 25313], [79, 25693], [83, 26033], [89, 26433], [92, 26653], [96, 26773], [101, 26993], [104, 27113], [112, 28028], [116, 28177], [121, 28417], [125, 28617], [128, 28837], [132, 28957], [140, 29297], [146, 30037], [149, 30197], [152, 30377], [156, 30557]]}, {"verse": 4, "start": 31539, "end": 39593, "text": "¶ And he