{"book": "ISA", "chapter": 3, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 220694, "verses": [{"verse": 1, "start": 300, "end": 12220, "text": "Porque he aquí que el Señor Jehová de los ejércitos quita de Jerusalén y de Judá el sustentador y el fuerte, todo sustento de pan y todo socorro de agua;", "words": [[0, 300], [7, 602], [10, 942], [15, 1362], [19, 1582], [22, 1762], [28, 2042], [35, 2702], [38, 2802], [42, 2942], [52, 3742], [58, 4202], [61, 4362], [71, 5182], [73, 5362], [76, 5502], [81, 5992], [84, 6482], [96, 7382], [98, 7562], [101, 7702], [109, 8562], [114, 8922], [123, 9642], [126, 9842], [130, 10222], [132, 10562], [137, 10862], [145, 11442], [148, 11682]]}, {"verse": 2, "start": 12670, "end": 19939, "text": "El valiente y el hombre de guerra, el juez y el profeta, el adivino y el anciano;", "words": [[0, 12670], [3, 12795], [12, 13415], [14, 13715], [17, 13835], [24, 14115], [27, 14315], [35, 15435], [38, 15515], [43, 16175], [45, 16535], [48, 16655], [57, 17735], [60, 17855], [68, 18615], [70, 18995], [73, 19115]]}, {"verse": 3, "start": 20389, "end": 29492, "text": "El capitán de cincuenta, y el hombre de respeto, y el consejero, y el artífice excelente, y el hábil orador.", "words": [[0, 20389], [3, 20714], [11, 21074], [14, 21174], [25, 22294], [27, 22594], [30, 22734], [37, 22974], [40, 23214], [49, 24114], [51, 24394], [54, 24534], [65, 25674], [67, 25714], [70, 25854], [79, 26574], [90, 28034], [92, 28094], [95, 28274], [101, 28714]]}, {"verse": 4, "start": 29792, "end": 34453, "text": "Y les pondré jóvenes por príncipes, y muchachos serán sus señores.", "words": [[0, 29792], [2, 29893], [6, 29993], [13, 30433], [21, 30833], [25, 31153], [36, 32413], [38, 32493], [48, 33193], [54, 33533], [58, 33693]]}, {"verse": 5, "start": 35035, "end": 44938, "text": "Y el pueblo hará violencia los unos a los otros, cada cual contra su vecino: el joven se levantará contra el viejo, y el villano contra el noble.", "words": [[0, 35035], [2, 35157], [5, 35277], [12, 35637], [17, 36117], [27, 36657], [31, 36897], [36, 37117], [38, 37317], [42, 37437], [49, 38217], [54, 38397], [59, 38697], [66, 39137], [69, 39357], [77, 40299], [80, 40467], [86, 40867], [89, 41227], [99, 41807], [106, 42127], [109, 42327], [116, 42807], [118, 43127], [121, 43267], [129, 43727], [136, 44147], [139, 44347]]}, {"verse": 6, "start": 45388, "end": 56709, "text": "Cuando alguno agarra a su hermano, de la familia de su padre, y le dice, Que vestir tienes, tú serás nuestro príncipe, y sea en tu mano esta ruina;", "words": [[0, 45388], [7, 45604], [14, 46204], [21, 46704], [23, 46864], [26, 47044], [35, 47924], [38, 48204], [41, 48344], [49, 48804], [52, 49004], [55, 49144], [62, 51138], [64, 51260], [67, 51360], [73, 51660], [77, 51840], [84, 52280], [92, 53180], [95, 53320], [101, 53680], [109, 53840], [119, 54620], [121, 55060], [125, 55260], [128, 55400], [131, 55540], [136, 55800], [141, 56120]]}, {"verse": 7, "start": 57059, "end": 66188, "text": "Él jurará aquel día, diciendo: No tomaré ese cuidado; porque en mi casa ni hay pan, ni qué vestir: no me hagáis príncipe del pueblo.", "words": [[0, 57059], [3, 57327], [10, 57947], [16, 58427], [21, 58707], [31, 59871], [34, 60050], [41, 60490], [45, 60670], [54, 61580], [61, 61804], [64, 61984], [67, 62084], [72, 62324], [75, 62544], [79, 62684], [84, 62964], [87, 63464], [91, 63624], [99, 64509], [102, 64631], [105, 64751], [112, 65051], [121, 65531], [125, 65711]]}, {"verse": 8, "start": 66538, "end": 77694, "text": "Pues arruinada está Jerusalén, y Judá ha caído; porque la lengua de ellos y sus obras han sido contra Jehová, para irritar los ojos de su majestad.", "words": [[0, 66538], [5, 66783], [15, 67843], [20, 68063], [31, 68863], [33, 69363], [38, 69823], [41, 69963], [48, 70895], [55, 71117], [58, 71297], [65, 71677], [68, 71797], [74, 72077], [76, 72277], [80, 72457], [86, 72857], [90, 73477], [95, 73817], [102, 74197], [110, 74877], [115, 75447], [123, 76017], [127, 76277], [132, 76637], [135, 76817], [138, 76957]]}, {"verse": 9, "start": 78144, "end": 89802, "text": "La apariencia del rostro de ellos los convence: que como Sodoma predican su pecado, no lo disimulan. ¡Ay del alma de ellos! porque acumularon mal para sí.", "words": [[0, 78144], [3, 78350], [14, 79110], [18, 79410], [25, 79990], [28, 80130], [34, 80350], [38, 80550], [48, 81858], [52, 82098], [57, 82358], [64, 82898], [73, 83418], [76, 83638], [84, 84438], [87, 84638], [90, 84758], [101, 86022], [105, 86162], [109, 86482], [114, 86782], [117, 87062], [124, 87891], [131, 88134], [142, 88854], [146, 89054], [151, 89294]]}, {"verse": 10, "start": 90252, "end": 95518, "text": "Decid al justo que le irá bien: porque comerá de los frutos de sus manos.", "words": [[0, 90252], [6, 90779], [9, 91339], [15, 91639], [19, 91979], [22, 92139], [26, 92439], [32, 93188], [39, 93456], [46, 94016], [49, 94096], [53, 94236], [60, 94656], [63, 94816], [67, 94936]]}, {"verse": 11, "start": 95968, "end": 102252, "text": "¡Ay del impío! mal le irá: porque según las obras de sus manos le será pagado.", "words": [[0, 96360], [4, 96752], [8, 97144], [15, 98029], [19, 98302], [22, 98575], [27, 99097], [34, 99281], [40, 99641], [44, 99901], [50, 100201], [53, 100381], [57, 100521], [63, 100911], [66, 101301], [71, 101561]]}, {"verse": 12, "start": 102702, "end": 113242, "text": "Los opresores de mi pueblo son muchachos, y las mujeres gobernaron a mi pueblo. Pueblo mío, los que te guían te engañan, y te hacen perder el rumbo.", "words": [[0, 102702], [4, 102830], [14, 103450], [17, 103630], [20, 103790], [27, 104130], [31, 104470], [42, 105370], [44, 105690], [48, 105810], [56, 106210], [67, 107330], [69, 107530], [72, 107650], [80, 108788], [87, 109094], [92, 109401], [96, 109661], [100, 109821], [103, 109981], [109, 110341], [112, 110501], [121, 111261], [123, 111621], [126, 111761], [132, 112021], [139, 112361], [142, 112681]]}, {"verse": 13, "start": 113692, "end": 118171, "text": "Jehová está en pie para litigar, y está para juzgar los pueblos.", "words": [[0, 113692], [7, 114160], [12, 114380], [15, 114600], [19, 114820], [24, 115080], [33, 115820], [35, 116400], [40, 116600], [45, 116820], [52, 117260], [56, 117420]]}, {"verse": 14, "start": 118621, "end": 131353, "text": "Jehová vendrá a juicio contra los ancianos de su pueblo y contra sus príncipes; porque vosotros habéis devorado la viña, y el despojo del pobre está en vuestras casas.", "words": [[0, 118621], [7, 119305], [14, 119705], [16, 119905], [23, 120405], [30, 120865], [34, 121085], [43, 121745], [46, 121845], [49, 122005], [56, 122405], [58, 122865], [65, 123245], [69, 123445], [80, 124807], [87, 125070], [96, 125650], [103, 126150], [112, 126830], [115, 126990], [121, 127550], [123, 128070], [126, 128230], [134, 128910], [138, 129110], [144, 129610], [149, 129990], [152, 130170], [161, 130530]]}, {"verse": 15, "start": 131653, "end": 139472, "text": "¿Qué pensáis vosotros que aplastáis mi pueblo, y moléis las caras de los pobres? dice el Señor Jehová de los ejércitos.", "words": [[0, 131653], [5, 131751], [13, 132211], [22, 132751], [26, 132991], [36, 133511], [39, 133651], [47, 134051], [49, 134531], [56, 134931], [60, 135111], [66, 135531], [69, 135611], [73, 135731], [81, 137025], [86, 137313], [89, 137493], [95, 137793], [102, 138313], [105, 138393], [109, 138533]]}, {"verse": 16, "start": 139922, "end": 151857, "text": "Asimismo dice Jehová: Por cuanto las hijas de Sion se ensoberbecen, y andan con el cuello erguido y los ojos descompuestos; cuando andan van danzando, y haciendo son con los pies:", "words": [[0, 140210], [9, 140530], [14, 141017], [22, 141688], [26, 141792], [33, 142012], [37, 142272], [43, 142652], [46, 142792], [51, 143152], [54, 143682], [68, 144212], [70, 144652], [76, 144972], [80, 145112], [83, 145252], [90, 145592], [98, 146112], [100, 146432], [104, 146572], [109, 146832], [124, 148404], [131, 148547], [137, 149207], [141, 149327], [151, 150007], [153, 150347], [162, 150747], [166, 151027], [170, 151207], [174, 151367]]}, {"verse": 17, "start": 152556, "end": 159140, "text": "Por tanto, pelará el Señor la cabeza de las hijas de Sion, y Jehová descubrirá sus vergüenzas.", "words": [[0, 152556], [4, 152700], [11, 153260], [18, 153620], [21, 153820], [27, 154080], [30, 154300], [37, 154700], [40, 154920], [44, 155080], [50, 155420], [53, 155580], [59, 155940], [61, 156540], [68, 156960], [79, 157600], [83, 157760]]}, {"verse": 18, "start": 159774, "end": 166065, "text": "Aquel día quitará el Señor el atavío de los calzados, y las redecillas, y las lunetas;", "words": [[0, 159774], [6, 160104], [10, 160304], [18, 160864], [21, 160944], [27, 161304], [30, 161734], [37, 162164], [40, 162284], [44, 162404], [54, 163104], [56, 163604], [60, 163764], [72, 164544], [74, 165144], [78, 165284]]}, {"verse": 19, "start": 166515, "end": 169544, "text": "Los collares, y los joyeles, y los brazaletes;", "words": [[0, 166515], [4, 166621], [14, 167341], [16, 167521], [20, 167841], [29, 168161], [31, 168421], [35, 169011]]}, {"verse": 20, "start": 169994, "end": 177759, "text": "Las escofietas, y los atavíos de las piernas, los partidores del pelo, los pomitos de olor, y los zarcillos;", "words": [[0, 169994], [4, 170134], [16, 171234], [18, 171454], [22, 171784], [30, 172114], [33, 172254], [37, 172374], [46, 173134], [50, 173294], [61, 173914], [65, 174094], [71, 174994], [75, 175114], [83, 175594], [86, 175794], [92, 176414], [94, 176594], [98, 177199]]}, {"verse": 21, "start": 178209, "end": 181175, "text": "Los anillos, y los joyeles de las narices;", "words": [[0, 178209], [4, 178315], [13, 178895], [15, 179315], [19, 179455], [27, 180035], [30, 180215], [34, 180355]]}, {"verse": 22, "start": 181625, "end": 186376, "text": "Las ropas de gala, los mantoncillos, los velos, y los alfileres;", "words": [[0, 181625], [4, 181769], [10, 182169], [13, 182329], [19, 183169], [23, 183249], [37, 184589], [41, 184709], [48, 185169], [50, 185309], [54, 185429]]}, {"verse": 23, "start": 186826, "end": 190628, "text": "Los espejos, los pañizuelos, las gasas, y los tocados.", "words": [[0, 186826], [4, 186944], [13, 187884], [17, 187964], [29, 188924], [33, 189024], [40, 189564], [42, 189744], [46, 189884]]}, {"verse": 24, "start": 191078, "end": 207986, "text": "Y será que en lugar de los perfumes aromáticos vendrá mal olor; y desgarrón en lugar de cinta; y calvicie en lugar de la compostura del cabello; y en lugar de faja ceñimiento de saco; y quemadura en vez de hermosura.", "words": [[0, 191078], [2, 191458], [7, 191698], [11, 191958], [14, 192098], [20, 192438], [23, 192718], [27, 192858], [36, 193398], [47, 194218], [54, 194778], [58, 194998], [64, 195813], [66, 195920], [76, 196800], [79, 197000], [85, 197280], [88, 197520], [95, 198626], [97, 198888], [106, 199648], [109, 199828], [115, 200088], [118, 200348], [121, 200468], [132, 201248], [136, 201408], [145, 202414], [147, 202714], [150, 202854], [156, 203094], [159, 203334], [164, 203974], [175, 204754], [178, 204994], [184, 205900], [186, 206026], [196, 206586], [199, 206846], [203, 207046], [206, 207206]]}, {"verse": 25, "start": 208436, "end": 212717, "text": "Tus varones caerán a espada, y tu fuerza en la guerra.", "words": [[0, 208436], [4, 208559], [12, 209219], [19, 209999], [21, 210079], [29, 210999], [31, 211179], [34, 211499], [41, 211819], [44, 211979], [47, 212099]]}, {"verse": 26, "start": 213167, "end": 220294, "text": "Sus puertas se entristecerán y enlutarán, y ella, desamparada, se sentará en tierra.", "words": [[0, 213167], [4, 213306], [12, 213866], [15, 214146], [29, 215486], [31, 215706], [42, 216826], [44, 217046], [50, 217606], [63, 218706], [66, 218806], [74, 219426], [77, 219646]]}]}