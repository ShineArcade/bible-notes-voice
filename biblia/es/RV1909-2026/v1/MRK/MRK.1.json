{"book": "MRK", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 334494, "verses": [{"verse": 1, "start": 300, "end": 3734, "text": "Principio del evangelio de Jesucristo, Hijo de Dios.", "words": [[0, 300], [10, 822], [14, 1182], [24, 1922], [27, 2022], [39, 2902], [44, 3042], [47, 3202]]}, {"verse": 2, "start": 4084, "end": 12748, "text": "Como está escrito en Isaías el profeta: He aquí yo envío a mi mensajero delante de ti, quien preparará tu camino delante de ti.", "words": [[0, 4084], [5, 4227], [10, 4407], [18, 4787], [21, 5047], [28, 5507], [31, 5727], [40, 6595], [43, 6918], [48, 7238], [51, 7458], [57, 7918], [59, 8018], [62, 8118], [72, 8778], [80, 9198], [83, 9358], [87, 9598], [93, 9958], [103, 10998], [106, 11198], [113, 11518], [121, 12158], [124, 12338]]}, {"verse": 3, "start": 13098, "end": 20251, "text": "Voz del que clama en el desierto: Preparad el camino del Señor; enderezad sus veredas.", "words": [[0, 13098], [4, 13524], [8, 13899], [12, 14119], [18, 14339], [21, 14559], [24, 14759], [34, 16075], [43, 16375], [46, 16555], [53, 16855], [57, 17155], [64, 18568], [74, 19059], [78, 19359]]}, {"verse": 4, "start": 20601, "end": 28029, "text": "Bautizaba Juan en el desierto, y predicaba el bautismo del arrepentimiento para perdón de pecados.", "words": [[0, 20601], [10, 21321], [15, 21741], [18, 22061], [21, 22201], [31, 22921], [33, 23421], [43, 24161], [46, 24301], [55, 24941], [59, 25181], [75, 26341], [80, 26621], [87, 27201], [90, 27341]]}, {"verse": 5, "start": 28379, "end": 38479, "text": "Y salía a él toda la provincia de Judea, y los de Jerusalén; y eran todos bautizados por él en el río de Jordán, confesando sus pecados.", "words": [[0, 28379], [2, 28501], [8, 28981], [10, 29261], [13, 29481], [18, 29781], [21, 30021], [31, 30621], [34, 30741], [41, 31321], [43, 31461], [47, 31601], [50, 31721], [61, 32751], [63, 33031], [68, 33211], [74, 33571], [85, 34571], [89, 34831], [92, 35051], [95, 35491], [98, 35631], [102, 35931], [105, 36031], [113, 36771], [124, 37471], [128, 37651]]}, {"verse": 6, "start": 38829, "end": 49578, "text": "Y Juan andaba vestido de pelos de camello, y con un cinturón de cuero alrededor de su cintura; y comía langostas y miel silvestre.", "words": [[0, 38829], [2, 38967], [7, 39287], [14, 40067], [22, 40707], [25, 40947], [31, 41187], [34, 41387], [43, 41967], [45, 42447], [49, 42727], [52, 42927], [61, 43847], [64, 44007], [70, 44467], [80, 44947], [83, 45467], [86, 45607], [95, 46607], [97, 46863], [103, 47283], [113, 48163], [115, 48343], [120, 48643]]}, {"verse": 7, "start": 49928, "end": 58722, "text": "Y predicaba, diciendo: Viene tras mí el que es más poderoso que yo, al cual no soy digno de agacharme para desatar la correa de sus sandalias.", "words": [[0, 49928], [2, 50150], [13, 50830], [23, 51877], [29, 52108], [34, 52374], [37, 52641], [40, 52721], [44, 52881], [47, 53041], [51, 53221], [60, 53781], [64, 53961], [68, 54741], [71, 54921], [76, 55081], [79, 55261], [83, 55441], [89, 55861], [92, 55921], [102, 56441], [107, 56681], [115, 57081], [118, 57301], [125, 57661], [128, 57761], [132, 57921]]}, {"verse": 8, "start": 59072, "end": 64071, "text": "Yo a la verdad os he bautizado con agua; pero él os bautizará con Espíritu Santo.", "words": [[0, 59072], [3, 59248], [5, 59328], [8, 59368], [15, 59628], [18, 59948], [21, 60048], [31, 60508], [35, 60768], [41, 61407], [46, 61582], [49, 61802], [52, 61942], [62, 62702], [66, 62862], [75, 63502]]}, {"verse": 9, "start": 64351, "end": 72814, "text": "Y aconteció en aquellos días, que Jesús vino de Nazaret de Galilea, y fue bautizado por Juan en el Jordán.", "words": [[0, 64351], [2, 64476], [12, 65136], [15, 65276], [24, 65516], [30, 66616], [34, 66856], [40, 67196], [45, 67736], [48, 67996], [56, 68616], [59, 68956], [68, 69656], [70, 70016], [74, 70176], [84, 70876], [88, 71236], [93, 71656], [96, 71916], [99, 71996]]}, {"verse": 10, "start": 73164, "end": 80838, "text": "Y luego, subiendo del agua, vio abrirse los cielos, y al Espíritu como paloma, que descendía sobre él.", "words": [[0, 73164], [2, 73331], [9, 73491], [18, 74211], [22, 74451], [28, 75031], [32, 75351], [40, 75891], [44, 76051], [52, 76751], [54, 77011], [57, 77271], [66, 77911], [71, 78111], [79, 78671], [83, 79151], [93, 80011], [99, 80311]]}, {"verse": 11, "start": 81188, "end": 88168, "text": "Y hubo una voz de los cielos que decía: Tú eres mi Hijo amado; en ti tengo complacencia.", "words": [[0, 81188], [2, 81326], [7, 81646], [11, 81886], [15, 82146], [18, 82366], [22, 82706], [29, 83046], [33, 83166], [40, 84060], [43, 84222], [48, 84602], [51, 84942], [56, 85162], [63, 86201], [66, 86360], [69, 86520], [75, 86900]]}, {"verse": 12, "start": 88448, "end": 91256, "text": "Y luego el Espíritu le impulsa al desierto.", "words": [[0, 88448], [2, 88590], [8, 88750], [11, 88990], [20, 89590], [23, 89670], [31, 90310], [34, 90410]]}, {"verse": 13, "start": 91606, "end": 100377, "text": "Y estuvo allí en el desierto cuarenta días, y era tentado de Satanás; y estaba con las fieras; y los ángeles le servían.", "words": [[0, 91606], [2, 91686], [9, 92026], [14, 92326], [17, 92486], [20, 92606], [29, 93036], [38, 93466], [44, 94126], [46, 94586], [50, 94746], [58, 95386], [61, 95526], [70, 96582], [72, 96749], [79, 96949], [83, 97189], [87, 97329], [95, 98377], [97, 98463], [101, 98583], [109, 99063], [112, 99543]]}, {"verse": 14, "start": 100727, "end": 108065, "text": "Pero después que Juan fue encarcelado, Jesús vino a Galilea predicando el evangelio del reino de Dios,", "words": [[0, 100727], [5, 100871], [13, 101231], [17, 101491], [22, 101771], [26, 102131], [39, 103351], [45, 103611], [50, 104211], [52, 104491], [60, 105131], [71, 106071], [74, 106211], [84, 106891], [88, 107071], [94, 107451], [97, 107611]]}, {"verse": 15, "start": 108415, "end": 116391, "text": "Y diciendo: El tiempo se ha cumplido, y el reino de Dios está cerca: arrepentíos, y creed al evangelio.", "words": [[0, 108415], [2, 108655], [12, 109630], [15, 109779], [22, 110119], [25, 110359], [28, 110479], [38, 111219], [40, 111559], [43, 111719], [49, 112119], [52, 112259], [57, 112539], [62, 112819], [69, 113777], [82, 114820], [84, 114960], [90, 115400], [93, 115520]]}, {"verse": 16, "start": 116741, "end": 125800, "text": "Y pasando junto al mar de Galilea, vio a Simón, y a Andrés su hermano, que echaban la red en el mar; porque eran pescadores.", "words": [[0, 116741], [2, 116830], [10, 117250], [16, 117550], [19, 117830], [23, 118050], [26, 118210], [35, 119290], [39, 119530], [41, 119690], [48, 120190], [50, 120410], [52, 120490], [59, 121090], [62, 121150], [71, 122090], [75, 122170], [83, 122690], [86, 122830], [90, 123150], [93, 123430], [96, 123550], [101, 124178], [108, 124402], [113, 124722]]}, {"verse": 17, "start": 126150, "end": 131907, "text": "Y les dijo Jesús: Venid en pos de mí, y haré que seáis pescadores de hombres.", "words": [[0, 126150], [2, 126242], [6, 126372], [11, 126692], [18, 127647], [24, 128073], [27, 128313], [31, 128513], [34, 128733], [38, 128933], [40, 129653], [45, 129933], [49, 130013], [55, 130393], [66, 130993], [69, 131233]]}, {"verse": 18, "start": 132257, "end": 134905, "text": "Y luego, dejadas sus redes, le siguieron.", "words": [[0, 132257], [2, 132363], [9, 132583], [17, 133123], [21, 133343], [28, 133683], [31, 134123]]}, {"verse": 19, "start": 135255, "end": 146110, "text": "Y pasando de allí un poco más adelante, vio a Jacobo, hijo de Zebedeo, y a Juan su hermano, también ellos en el navío, que arreglaban las redes.", "words": [[0, 135255], [2, 135360], [10, 135780], [13, 136060], [18, 136300], [21, 136460], [26, 136680], [30, 136940], [40, 137660], [44, 137880], [46, 138080], [54, 139160], [59, 139420], [62, 140140], [71, 140860], [73, 141040], [75, 141120], [80, 141380], [83, 141580], [92, 142360], [100, 142660], [106, 143160], [109, 143480], [112, 143620], [119, 144480], [123, 144560], [134, 145180], [138, 145420]]}, {"verse": 20, "start": 146460, "end": 153146, "text": "Y luego los llamó: y dejando a su padre Zebedeo en el barco con los jornaleros, fueron en pos de él.", "words": [[0, 146460], [2, 146722], [8, 146942], [12, 147242], [19, 147971], [21, 148115], [29, 148575], [31, 148655], [34, 148795], [40, 149295], [48, 149795], [51, 149915], [54, 150015], [60, 150475], [64, 150695], [68, 150875], [80, 151915], [87, 152175], [90, 152405], [94, 152635], [97, 152855]]}, {"verse": 21, "start": 153496, "end": 159879, "text": "Y entraron en Capernaum; y luego los sábados, entrando en la sinagoga, enseñaba.", "words": [[0, 153496], [2, 153645], [11, 154245], [14, 154405], [25, 155610], [27, 155743], [33, 155903], [37, 156123], [46, 157043], [55, 157623], [58, 157783], [61, 157883], [71, 158923]]}, {"verse": 22, "start": 160229, "end": 167139, "text": "Y se admiraban de su enseñanza; porque les enseñaba como quien tiene autoridad, y no como los escribas.", "words": [[0, 160229], [2, 160393], [5, 160473], [15, 161053], [18, 161233], [21, 161393], [32, 162549], [39, 162793], [43, 163013], [52, 163813], [57, 164033], [63, 164313], [69, 164673], [80, 165453], [82, 165728], [85, 165888], [90, 166128], [94, 166308]]}, {"verse": 23, "start": 167489, "end": 172975, "text": "Y había en la sinagoga de ellos un hombre con espíritu inmundo, el cual gritó,", "words": [[0, 167489], [2, 167607], [8, 167807], [11, 168067], [14, 168187], [23, 168807], [26, 169007], [32, 169327], [35, 169707], [42, 170027], [46, 170267], [55, 170847], [64, 171887], [67, 172067], [72, 172267]]}, {"verse": 24, "start": 173325, "end": 181057, "text": "Diciendo: ¡Ah! ¿qué tienes con nosotros, Jesús nazareno? ¿Has venido a destruirnos? Sé quién eres, el Santo de Dios.", "words": [[0, 173325], [10, 174348], [15, 175000], [20, 175098], [27, 175378], [31, 175658], [41, 176378], [47, 176538], [57, 177585], [62, 177762], [69, 178102], [71, 178182], [84, 179291], [87, 179479], [93, 179679], [99, 179919], [102, 180079], [108, 180399], [111, 180519]]}, {"verse": 25, "start": 181337, "end": 186088, "text": "Y Jesús le reprendió, diciendo: Calla, y sal de él.", "words": [[0, 181337], [2, 181460], [8, 181820], [11, 182460], [22, 183100], [32, 184743], [39, 185053], [41, 185253], [45, 185413], [48, 185673]]}, {"verse": 26, "start": 186438, "end": 191616, "text": "Y el espíritu inmundo lo convulsionó y, clamando a gran voz, salió de él.", "words": [[0, 186503], [2, 186743], [5, 186863], [14, 187423], [22, 187843], [25, 188023], [37, 188903], [40, 189403], [49, 189923], [51, 190043], [56, 190203], [61, 190783], [67, 191103], [70, 191263]]}, {"verse": 27, "start": 191966, "end": 205220, "text": "Y todos se maravillaron, de tal manera que preguntaban entre sí, diciendo: ¿Qué es esto? ¿Qué nueva doctrina es esta, que con autoridad aun a los espíritus inmundos manda, y le obedecen?", "words": [[0, 191966], [2, 192089], [8, 192429], [11, 193049], [25, 194509], [28, 194689], [32, 194869], [39, 195229], [43, 195469], [55, 196209], [61, 196529], [65, 197349], [75, 198459], [80, 198590], [83, 198750], [89, 199373], [94, 199458], [100, 199658], [109, 200178], [112, 200418], [118, 201138], [122, 201178], [126, 201358], [136, 201631], [140, 201905], [142, 202178], [146, 202378], [156, 202978], [165, 203478], [172, 204158], [174, 204398], [177, 204478]]}, {"verse": 28, "start": 205500, "end": 210205, "text": "Y vino luego su fama por toda la provincia alrededor de Galilea.", "words": [[0, 205500], [2, 205627], [7, 205867], [13, 206207], [16, 206467], [21, 206967], [25, 207187], [30, 207487], [33, 207727], [43, 208427], [53, 208807], [56, 209387]]}, {"verse": 29, "start": 210555, "end": 217745, "text": "Y luego saliendo de la sinagoga, vinieron a casa de Simón y de Andrés, con Jacobo y Juan.", "words": [[0, 210555], [2, 210678], [8, 210918], [17, 211618], [20, 211778], [23, 211898], [33, 212978], [42, 213558], [44, 213698], [49, 213978], [52, 214198], [58, 214758], [60, 214938], [63, 215018], [71, 215858], [75, 216078], [82, 216878], [84, 217198]]}, {"verse": 30, "start": 218095, "end": 223548, "text": "Y la suegra de Simón estaba acostada con fiebre; y le hablaron luego de ella.", "words": [[0, 218095], [2, 218355], [5, 218695], [12, 219035], [15, 219155], [21, 219675], [28, 220075], [37, 220715], [41, 220915], [49, 221754], [51, 221878], [54, 222018], [63, 222538], [69, 222758], [72, 223078]]}, {"verse": 31, "start": 223898, "end": 231666, "text": "Entonces llegando él, la tomó de su mano y la levantó; y luego se le quitó la fiebre, y les servía.", "words": [[0, 223898], [9, 224404], [18, 225404], [22, 225704], [25, 226044], [30, 226384], [33, 226464], [36, 226624], [41, 227004], [43, 227524], [46, 227644], [55, 228627], [57, 228774], [63, 228994], [66, 229274], [69, 229394], [75, 229734], [78, 229834], [86, 230294], [88, 230614], [92, 230754]]}, {"verse": 32, "start": 232016, "end": 239777, "text": "Y cuando fue la tarde, luego que el sol se puso, traían a él todos los enfermos, y endemoniados;", "words": [[0, 232016], [2, 232288], [9, 232508], [13, 232768], [16, 232908], [23, 233708], [29, 233988], [33, 234288], [36, 234448], [40, 234668], [43, 234908], [49, 235868], [56, 236508], [58, 236668], [61, 236848], [67, 237188], [71, 237528], [81, 238368], [83, 238688]]}, {"verse": 33, "start": 240127, "end": 242739, "text": "Y toda la ciudad se juntó a la puerta.", "words": [[0, 240127], [2, 240264], [7, 240484], [10, 240724], [17, 241044], [20, 241404], [26, 241884], [28, 241944], [31, 242024]]}, {"verse": 34, "start": 243089, "end": 252800, "text": "Y sanó a muchos que estaban enfermos de diversas enfermedades, y echó fuera muchos demonios; y no dejaba decir a los demonios que le conocían.", "words": [[0, 243089], [2, 243216], [7, 243596], [9, 243696], [16, 243976], [20, 244216], [28, 244456], [37, 245116], [40, 245256], [49, 245796], [63, 246716], [65, 247316], [70, 247636], [76, 247896], [83, 248156], [93, 249306], [95, 249431], [98, 249571], [105, 250031], [111, 250451], [113, 250971], [117, 251111], [126, 251671], [130, 251791], [133, 251911]]}, {"verse": 35, "start": 253150, "end": 261909, "text": "Y levantándose muy de mañana, cuando todavía estaba oscuro, salió y se fue a un lugar desierto, y allí oraba.", "words": [[0, 253150], [2, 253271], [15, 254191], [19, 254451], [22, 254631], [30, 255511], [37, 255731], [45, 256211], [52, 256611], [60, 257491], [66, 258051], [68, 258571], [71, 258731], [75, 258951], [77, 259091], [80, 259211], [86, 259551], [96, 260371], [98, 260891], [103, 261111]]}, {"verse": 36, "start": 262259, "end": 265479, "text": "Y le siguió Simón, y los que estaban con él;", "words": [[0, 262259], [2, 262385], [5, 262485], [12, 262925], [19, 263525], [21, 263945], [25, 264105], [29, 264265], [37, 264605], [41, 264945]]}, {"verse": 37, "start": 265829, "end": 268985, "text": "Y hallándole, le dicen: Todos te buscan.", "words": [[0, 265829], [2, 265974], [14, 266894], [17, 267054], [24, 267974], [30, 268138], [33, 268398]]}, {"verse": 38, "start": 269265, "end": 275883, "text": "Y les dice: Vamos a los lugares vecinos, para que predique también allí; porque para esto he venido.", "words": [[0, 269265], [2, 269406], [6, 269526], [12, 270294], [18, 270601], [20, 270781], [24, 270921], [32, 271241], [41, 271881], [46, 272581], [50, 272741], [59, 273201], [67, 273541], [73, 274475], [80, 274625], [85, 274885], [90, 275165], [93, 275325]]}, {"verse": 39, "start": 276233, "end": 282503, "text": "Y predicaba en las sinagogas de ellos en toda Galilea, y echaba fuera los demonios.", "words": [[0, 276233], [2, 276398], [12, 277278], [15, 277458], [19, 277618], [29, 278418], [32, 278558], [38, 278858], [41, 279138], [46, 279378], [55, 280378], [57, 280718], [64, 281138], [70, 281398], [74, 281698]]}, {"verse": 40, "start": 282853, "end": 290792, "text": "Y un leproso vino a él, rogándole; y arrodillándose, le dice: Si quieres, puedes limpiarme.", "words": [[0, 282853], [2, 282992], [5, 283132], [13, 283752], [18, 284092], [20, 284332], [24, 285072], [35, 286373], [37, 286535], [53, 288055], [56, 288275], [62, 289015], [65, 289215], [74, 289535], [81, 289895]]}, {"verse": 41, "start": 291072, "end": 297546, "text": "Y Jesús, teniendo misericordia de él, extendió su mano, y le tocó, y le dice: Quiero, sé limpio.", "words": [[0, 291072], [2, 291195], [9, 292015], [18, 292475], [31, 293295], [34, 293435], [38, 293675], [47, 294195], [50, 294315], [56, 294615], [58, 294755], [61, 294855], [67, 295335], [69, 295455], [72, 295555], [78, 296301], [86, 296736], [89, 296916]]}, {"verse": 42, "start": 297896, "end": 302262, "text": "Y así que hubo él hablado, la lepra se fue luego de aquel, y fue limpio.", "words": [[0, 297896], [2, 298005], [6, 298165], [10, 298385], [15, 298725], [18, 298825], [27, 299625], [30, 299705], [36, 300065], [39, 300225], [43, 300385], [49, 300605], [52, 300895], [59, 301185], [61, 301325], [65, 301485]]}, {"verse": 43, "start": 302612, "end": 305721, "text": "Entonces le advirtió, y le despidió luego,", "words": [[0, 302612], [9, 303077], [12, 303397], [22, 304037], [24, 304297], [27, 304437], [36, 305097]]}, {"verse": 44, "start": 306071, "end": 318029, "text": "Y le dice: Mira, no digas a nadie nada; sino ve, muéstrate al sacerdote, y presenta por tu purificación la ofrenda que Moisés mandó, para testimonio a ellos.", "words": [[0, 306071], [2, 306194], [5, 306294], [11, 307064], [17, 307591], [20, 307851], [26, 308211], [28, 308311], [34, 308571], [40, 309611], [45, 309771], [49, 310171], [59, 310791], [62, 311031], [73, 311791], [75, 312031], [84, 312831], [88, 313051], [91, 313271], [104, 314071], [107, 314391], [115, 314931], [119, 315051], [126, 315471], [133, 316091], [138, 316551], [149, 317391], [151, 317511]]}, {"verse": 45, "start": 318379, "end": 334094, "text": "Pero cuando él salió, comenzó a publicarlo mucho, y a divulgar el hecho, de manera que ya Jesús no podía entrar públicamente en la ciudad, sino que estaba fuera en los lugares desiertos; y venían a él de todas partes.", "words": [[0, 318379], [5, 318503], [12, 318864], [15, 319225], [22, 319585], [30, 320258], [32, 320628], [43, 320998], [50, 321378], [52, 321898], [54, 321998], [63, 322558], [66, 322738], [73, 323098], [76, 323738], [83, 323958], [87, 324238], [90, 324398], [96, 324778], [99, 325138], [105, 325498], [112, 325838], [125, 326718], [128, 326858], [131, 326978], [139, 327787], [144, 328087], [148, 328287], [155, 328587], [161, 329007], [164, 329247], [168, 329427], [176, 330007], [187, 331594], [189, 331698], [196, 332178], [198, 332458], [201, 332778], [204, 332918], [210, 333138]]}]}