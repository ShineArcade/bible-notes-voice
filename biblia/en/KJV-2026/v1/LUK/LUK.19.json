{"book": "LUK", "chapter": 19, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 316043, "verses": [{"verse": 1, "start": 300, "end": 3077, "text": "And Jesus entered and passed through Jericho.", "words": [[0, 300], [4, 442], [10, 762], [18, 1342], [22, 1642], [29, 1982], [37, 2262]]}, {"verse": 2, "start": 3427, "end": 10084, "text": "And, behold, there was a man named Zacchæus, which was the chief among the tax collectors, and he was rich.", "words": [[0, 3427], [5, 3557], [13, 4337], [19, 4497], [23, 4657], [25, 4777], [29, 5037], [35, 5667], [45, 6297], [51, 6517], [55, 6717], [59, 6877], [65, 7117], [71, 7417], [75, 7617], [79, 7897], [91, 8997], [95, 9157], [98, 9297], [102, 9497]]}, {"verse": 3, "start": 10434, "end": 16187, "text": "And he sought to see Jesus who he was; and could not for the press, because he was little of stature.", "words": [[0, 10434], [4, 10568], [7, 10668], [14, 10908], [17, 11128], [21, 11288], [27, 11628], [31, 11928], [34, 12048], [39, 12823], [43, 12950], [49, 13110], [53, 13350], [57, 13530], [61, 13670], [68, 14310], [76, 14670], [79, 14870], [83, 15050], [90, 15330], [93, 15510]]}, {"verse": 4, "start": 16537, "end": 22270, "text": "And he ran before, and climbed up into a sycamore tree to see him: for he was to pass that way.", "words": [[0, 16537], [4, 16684], [7, 16764], [11, 17024], [19, 17404], [23, 17799], [31, 18139], [34, 18439], [39, 18659], [41, 18819], [50, 19279], [55, 19579], [58, 19759], [62, 20039], [67, 20599], [71, 20689], [74, 20849], [78, 21049], [81, 21269], [86, 21549], [91, 21829]]}, {"verse": 5, "start": 22620, "end": 32740, "text": "And when Jesus came to the place, he looked up, and saw him, and said to him, Zacchæus, make haste, and come down; for today I must abide at your house.", "words": [[0, 22620], [4, 22745], [9, 22905], [15, 23205], [20, 23565], [23, 23745], [27, 23845], [34, 24605], [37, 24845], [44, 25045], [48, 25405], [52, 25925], [56, 26285], [61, 26525], [65, 27005], [70, 27265], [73, 27465], [78, 27999], [88, 28495], [93, 28695], [100, 29415], [104, 29515], [109, 29735], [115, 30508], [119, 30587], [125, 31127], [127, 31207], [132, 31427], [138, 31867], [141, 32087], [146, 32207]]}, {"verse": 6, "start": 33020, "end": 36827, "text": "And he made haste, and came down, and received him joyfully.", "words": [[0, 33020], [4, 33152], [7, 33252], [12, 33492], [19, 34352], [23, 34512], [28, 34772], [34, 35172], [38, 35467], [47, 35847], [51, 36087]]}, {"verse": 7, "start": 37177, "end": 43190, "text": "And when they saw it, they all murmured, saying, That he was gone to be guest with a man that is a sinner.", "words": [[0, 37177], [4, 37477], [9, 37617], [14, 37797], [18, 38137], [22, 38517], [27, 38597], [31, 38817], [41, 39317], [49, 39617], [54, 40257], [57, 40377], [61, 40537], [66, 40817], [69, 41017], [72, 41247], [78, 41477], [83, 41797], [85, 41957], [89, 42197], [94, 42397], [97, 42537], [99, 42657]]}, {"verse": 8, "start": 43540, "end": 54144, "text": "And Zacchæus stood, and said to the Lord; Behold, Lord, the half of my goods I give to the poor; and if I have taken any thing from any man by false accusation, I restore him fourfold.", "words": [[0, 43540], [4, 43684], [13, 44204], [20, 44504], [24, 44784], [29, 45064], [32, 45244], [36, 45404], [42, 46115], [50, 46689], [56, 47269], [60, 47369], [65, 47589], [68, 47689], [71, 47869], [77, 48089], [79, 48309], [84, 48469], [87, 48629], [91, 48749], [97, 49394], [101, 49497], [104, 49597], [106, 49697], [111, 49777], [117, 50004], [121, 50230], [127, 50457], [132, 50817], [136, 51097], [140, 51357], [143, 51517], [149, 51777], [161, 52697], [163, 52857], [171, 53217], [175, 53417]]}, {"verse": 9, "start": 54424, "end": 61434, "text": "And Jesus said to him, This day is salvation come to this house, forsomuch as he also is a son of Abraham.", "words": [[0, 54424], [4, 54575], [10, 54875], [15, 55275], [18, 55475], [23, 55977], [28, 56237], [32, 56557], [35, 56877], [45, 57377], [50, 57797], [53, 57977], [58, 58157], [65, 58777], [75, 59397], [78, 59617], [81, 59757], [86, 60017], [89, 60277], [91, 60377], [95, 60597], [98, 60697]]}, {"verse": 10, "start": 61784, "end": 65275, "text": "For the Son of man is come to seek and to save that which was lost.", "words": [[0, 61784], [4, 61850], [8, 61970], [12, 62190], [15, 62310], [19, 62560], [22, 62810], [27, 63010], [30, 63170], [35, 63430], [39, 63670], [42, 63830], [47, 64110], [52, 64330], [58, 64530], [62, 64710]]}, {"verse": 11, "start": 65555, "end": 75487, "text": "And as they heard these things, he added and spoke a parable, because he was near to Jerusalem, and because they thought that the kingdom of God should immediately appear.", "words": [[0, 65555], [4, 65683], [7, 65883], [12, 66083], [18, 66323], [24, 66543], [32, 67363], [35, 67523], [41, 67943], [45, 68263], [51, 68603], [53, 68743], [62, 69283], [70, 69863], [73, 70103], [77, 70283], [82, 70483], [85, 70643], [96, 71243], [100, 71863], [108, 72183], [113, 72443], [121, 72743], [126, 72943], [130, 73083], [138, 73403], [141, 73643], [145, 73983], [152, 74263], [164, 74723]]}, {"verse": 12, "start": 75837, "end": 82167, "text": "He said therefore, A certain nobleman went into a far country to receive for himself a kingdom, and to return.", "words": [[0, 75837], [3, 76117], [8, 76357], [19, 77344], [21, 77481], [29, 77721], [38, 78361], [43, 78561], [48, 78861], [50, 79001], [54, 79221], [62, 79641], [65, 79801], [73, 80161], [77, 80361], [85, 80641], [87, 80861], [96, 81161], [100, 81446], [103, 81586]]}, {"verse": 13, "start": 82447, "end": 88202, "text": "And he called his ten servants, and delivered them ten pounds, and said to them, Occupy till I come.", "words": [[0, 82447], [4, 82578], [7, 82678], [14, 82918], [18, 83098], [22, 83338], [32, 83778], [36, 84398], [46, 84698], [51, 84958], [55, 85218], [63, 85618], [67, 86058], [72, 86278], [75, 86458], [81, 87152], [88, 87342], [93, 87602], [95, 87702]]}, {"verse": 14, "start": 88482, "end": 94518, "text": "But his citizens hated him, and sent a message after him, saying, We will not have this man to reign over us.", "words": [[0, 88482], [4, 88607], [8, 88727], [17, 89207], [23, 89587], [28, 89907], [32, 90227], [37, 90467], [39, 90607], [47, 90887], [53, 91287], [58, 91527], [66, 92324], [69, 92462], [74, 92602], [78, 92802], [83, 93002], [88, 93222], [92, 93462], [95, 93662], [101, 93842], [106, 94082]]}, {"verse": 15, "start": 94738, "end": 106142, "text": "And it came to pass, that when he was returned, having received the kingdom, then he commanded these servants to be called to him, to whom he had given the money, that he might know how much every man had gained by trading.", "words": [[0, 94738], [4, 94839], [7, 94919], [12, 95139], [15, 95299], [21, 95619], [26, 95894], [31, 96034], [34, 96154], [38, 96314], [48, 97054], [55, 97274], [64, 97714], [68, 97914], [77, 98734], [82, 98874], [85, 98994], [95, 99414], [101, 99654], [110, 99994], [113, 100254], [116, 100354], [123, 100594], [126, 100794], [131, 101311], [134, 101428], [139, 101668], [142, 101868], [146, 101988], [152, 102208], [156, 102388], [163, 102668], [168, 103148], [171, 103288], [177, 103488], [182, 103788], [186, 104008], [191, 104248], [197, 104528], [201, 104888], [205, 105088], [212, 105368], [215, 105588]]}, {"verse": 16, "start": 106422, "end": 110961, "text": "Then came the first, saying, Lord, your pound has gained ten pounds.", "words": [[0, 106422], [5, 106643], [10, 106943], [14, 107143], [21, 107823], [29, 108652], [35, 109068], [40, 109128], [46, 109468], [50, 109688], [57, 109908], [61, 110268]]}, {"verse": 17, "start": 111241, "end": 117568, "text": "And he said to him, Well, you good servant: because you have been faithful in a very little, have you authority over ten cities.", "words": [[0, 111241], [4, 111367], [7, 111467], [12, 111687], [15, 111887], [20, 112489], [26, 112668], [30, 112908], [35, 113128], [44, 113901], [52, 114083], [56, 114263], [61, 114383], [66, 114503], [75, 114843], [78, 115083], [80, 115163], [85, 115363], [93, 115943], [98, 116063], [102, 116163], [112, 116523], [117, 116773], [121, 117023]]}, {"verse": 18, "start": 117848, "end": 122385, "text": "And the second came, saying, Lord, your pound has gained five pounds.", "words": [[0, 117848], [4, 117991], [8, 118111], [15, 118391], [21, 118771], [29, 120034], [35, 120292], [40, 120512], [46, 120852], [50, 121072], [57, 121312], [62, 121672]]}, {"verse": 19, "start": 122665, "end": 126514, "text": "And he said likewise to him, Be also over five cities.", "words": [[0, 122665], [4, 122812], [7, 122952], [12, 123152], [21, 123632], [24, 123992], [29, 124543], [32, 124661], [37, 125061], [42, 125401], [47, 125781]]}, {"verse": 20, "start": 126794, "end": 132295, "text": "And another came, saying, Lord, behold, here is your pound, which I have kept laid up in a cloth:", "words": [[0, 126794], [4, 126938], [12, 127218], [18, 127558], [26, 128371], [32, 128667], [40, 129387], [45, 129547], [48, 129747], [53, 129867], [60, 130507], [66, 130667], [68, 130827], [73, 130967], [78, 131167], [83, 131427], [86, 131647], [89, 131747], [91, 131827]]}, {"verse": 21, "start": 132645, "end": 138880, "text": "For I feared you, because you are an austere man: you take up that you laid not down, and reap that you did not sow.", "words": [[0, 132645], [4, 132749], [6, 132969], [13, 133249], [18, 133489], [26, 133749], [30, 133989], [34, 134109], [37, 134229], [45, 134669], [50, 135357], [54, 135475], [59, 135695], [62, 135935], [67, 136115], [71, 136255], [76, 136455], [80, 136635], [86, 137015], [90, 137435], [95, 137855], [100, 138035], [104, 138155], [108, 138295], [112, 138615]]}, {"verse": 22, "start": 139160, "end": 149260, "text": "And he says to him, Out of your own mouth will I judge you, you wicked servant. You knew that I was an austere man, taking up that I laid not down, and reaping that I did not sow:", "words": [[0, 139160], [4, 139287], [7, 139387], [12, 139607], [15, 139787], [20, 141013], [24, 141158], [27, 141318], [32, 141438], [36, 141658], [42, 141978], [47, 142178], [49, 142298], [55, 142498], [60, 142958], [64, 143058], [71, 143298], [80, 144128], [84, 144267], [89, 144467], [94, 144667], [96, 144767], [100, 144927], [103, 145047], [111, 145467], [116, 145787], [123, 146207], [126, 146527], [131, 146707], [133, 146807], [138, 147007], [142, 147207], [148, 147527], [152, 147907], [160, 148267], [165, 148407], [167, 148507], [171, 148647], [175, 148977]]}, {"verse": 23, "start": 149610, "end": 155130, "text": "Why then did you not give my money into the bank, that at my coming I might have required my own with usury?", "words": [[0, 149610], [4, 149789], [9, 150009], [13, 150189], [17, 150329], [21, 150469], [26, 150669], [29, 150869], [35, 151149], [40, 151329], [44, 151449], [50, 151989], [55, 152249], [58, 152369], [61, 152529], [68, 152809], [70, 153009], [76, 153189], [81, 153369], [90, 153769], [93, 153989], [97, 154289], [102, 154509]]}, {"verse": 24, "start": 155410, "end": 161124, "text": "And he said to them that stood by, Take from him the pound, and give it to him that has ten pounds.", "words": [[0, 155410], [4, 155548], [7, 155668], [12, 155868], [15, 156068], [20, 156248], [25, 156468], [31, 156708], [35, 157506], [40, 157680], [45, 157860], [49, 158100], [53, 158320], [60, 158660], [64, 159140], [69, 159320], [72, 159460], [75, 159580], [79, 159800], [84, 159980], [88, 160230], [92, 160480]]}, {"verse": 25, "start": 161404, "end": 164277, "text": "(And they said to him, Lord, he has ten pounds.)", "words": [[0, 161404], [5, 161565], [10, 161685], [15, 161965], [18, 162165], [23, 162724], [29, 162943], [32, 163163], [36, 163383], [40, 163623]]}, {"verse": 26, "start": 164497, "end": 172840, "text": "For I say to you, That to every one which has shall be given; and from him that has not, even that he has shall be taken away from him.", "words": [[0, 164497], [4, 164647], [6, 164847], [10, 165067], [13, 165287], [18, 165467], [23, 165927], [26, 166167], [32, 166467], [36, 166807], [42, 167067], [46, 167347], [52, 167687], [55, 167867], [62, 168556], [66, 168692], [71, 168892], [75, 169152], [80, 169472], [84, 169692], [89, 170332], [94, 170652], [99, 170892], [102, 171072], [106, 171512], [112, 171612], [115, 171752], [121, 172012], [126, 172252], [131, 172492]]}, {"verse": 27, "start": 173060, "end": 178447, "text": "But those my enemies, which would not that I should reign over them, bring here, and slay them before me.", "words": [[0, 173060], [4, 173179], [10, 173379], [13, 173599], [22, 174279], [28, 174459], [34, 174639], [38, 174819], [43, 175019], [45, 175119], [52, 175259], [58, 175519], [63, 175779], [69, 176419], [75, 176659], [81, 176979], [85, 177379], [90, 177719], [95, 177819], [102, 178079]]}, {"verse": 28, "start": 178727, "end": 183593, "text": "¶ And when he had thus spoken, he went before, ascending up to Jerusalem.", "words": [[2, 178727], [6, 178869], [11, 179029], [14, 179229], [18, 179409], [23, 179569], [31, 180589], [34, 180729], [39, 180929], [47, 182029], [57, 182429], [60, 182629], [63, 182789]]}, {"verse": 29, "start": 183943, "end": 192227, "text": "And it came to pass, when he was come near to Bethphage and Bethany, at the mount called the mount of Olives, he sent two of his disciples,", "words": [[0, 183943], [4, 184122], [7, 184242], [12, 184502], [15, 184722], [21, 185082], [26, 185402], [29, 185502], [33, 185662], [38, 185882], [43, 186122], [46, 186282], [56, 186882], [60, 186982], [69, 187822], [72, 187962], [76, 188102], [82, 188362], [89, 188662], [93, 188862], [99, 189102], [102, 189282], [110, 190142], [113, 190262], [118, 190502], [122, 190782], [125, 190922], [129, 191022]]}, {"verse": 30, "start": 192577, "end": 202030, "text": "Saying, Go into the village over against you; in which at your entering you shall find a colt tied, on which yet never man sat: loose him, and bring him here.", "words": [[0, 192577], [8, 193189], [11, 193390], [16, 193630], [20, 193810], [28, 194090], [33, 194390], [41, 194770], [46, 195395], [49, 195533], [55, 195733], [58, 195913], [63, 196033], [72, 196453], [76, 196733], [82, 196933], [87, 197233], [89, 197613], [94, 197993], [100, 198373], [103, 198553], [109, 198773], [113, 198993], [119, 199273], [123, 199553], [128, 200374], [134, 200713], [139, 200873], [143, 201193], [149, 201413], [153, 201593]]}, {"verse": 31, "start": 202380, "end": 207890, "text": "And if any man ask you, Why do you loose him? thus shall you say to him, Because the Lord has need of him.", "words": [[0, 202380], [4, 202499], [7, 202599], [11, 202759], [15, 203019], [19, 203279], [24, 203599], [28, 203759], [31, 203939], [35, 204119], [41, 204299], [46, 204857], [51, 205064], [57, 205364], [61, 205544], [65, 205744], [68, 205884], [73, 206244], [81, 206504], [85, 206724], [90, 206924], [94, 207144], [99, 207364], [102, 207564]]}, {"verse": 32, "start": 208170, "end": 212261, "text": "And they that were sent went their way, and found even as he had said to them.", "words": [[0, 208170], [4, 208324], [9, 208504], [14, 208724], [19, 208884], [24, 209144], [29, 209424], [35, 209704], [40, 210064], [44, 210299], [50, 210639], [55, 211019], [58, 211239], [61, 211379], [65, 211499], [70, 211719], [73, 211939]]}, {"verse": 33, "start": 212611, "end": 217364, "text": "And as they were loosing the colt, the owners of it said to them, Why do you loose the colt?", "words": [[0, 212611], [4, 212794], [7, 213034], [12, 213194], [17, 213334], [25, 213754], [29, 213894], [35, 214374], [39, 214454], [46, 214754], [49, 215014], [52, 215114], [57, 215334], [60, 215554], [66, 216118], [70, 216305], [73, 216465], [77, 216625], [83, 216785], [87, 217100]]}, {"verse": 34, "start": 217644, "end": 220073, "text": "And they said, The Lord has need of him.", "words": [[0, 217644], [4, 217793], [9, 217913], [15, 218602], [19, 218728], [24, 219008], [28, 219228], [33, 219508], [36, 219708]]}, {"verse": 35, "start": 220353, "end": 225697, "text": "And they brought him to Jesus: and they cast their garments upon the colt, and they set Jesus on it.", "words": [[0, 220353], [4, 220496], [9, 220596], [17, 220856], [21, 221056], [24, 221216], [31, 222128], [35, 222268], [40, 222388], [45, 222688], [51, 222908], [60, 223268], [65, 223608], [69, 223978], [75, 224348], [79, 224448], [84, 224588], [88, 224788], [94, 225148], [97, 225488]]}, {"verse": 36, "start": 226047, "end": 228795, "text": "And as he went, they spread their clothes in the way.", "words": [[0, 226047], [4, 226176], [7, 226356], [10, 226496], [16, 227136], [21, 227276], [28, 227496], [34, 227716], [42, 228036], [45, 228276], [49, 228376]]}, {"verse": 37, "start": 229145, "end": 240670, "text": "And when he was come near, even now at the descent of the mount of Olives, the whole multitude of the disciples began to rejoice and praise God with a loud voice for all the mighty works that they had seen;", "words": [[0, 229145], [4, 229268], [9, 229388], [12, 229548], [16, 229688], [21, 229888], [27, 230408], [32, 230608], [36, 231048], [39, 231168], [43, 231248], [51, 231588], [54, 231828], [58, 231928], [64, 232148], [67, 232308], [75, 233238], [79, 233343], [85, 233523], [95, 234123], [98, 234383], [102, 234503], [112, 235023], [118, 235443], [121, 235663], [129, 236103], [133, 236423], [140, 236763], [144, 237163], [149, 237423], [151, 237543], [156, 237823], [162, 238183], [166, 238443], [170, 238683], [174, 238843], [181, 239123], [187, 239463], [192, 239723], [197, 239903], [201, 240063]]}, {"verse": 38, "start": 241020, "end": 247381, "text": "Saying, Blessed be the King that comes in the name of the Lord: peace in heaven, and glory in the highest.", "words": [[0, 241020], [8, 242092], [16, 242386], [19, 242646], [23, 242806], [28, 243046], [33, 243246], [39, 243526], [42, 243706], [46, 243806], [51, 244026], [54, 244166], [58, 244266], [64, 244916], [70, 245101], [73, 245281], [81, 245521], [85, 246001], [91, 246381], [94, 246701], [98, 246821]]}, {"verse": 39, "start": 247661, "end": 252726, "text": "And some of the Pharisees from among the multitude said to him, Master, rebuke your disciples.", "words": [[0, 247661], [4, 247786], [9, 248006], [12, 248126], [16, 248226], [26, 248866], [31, 249026], [37, 249286], [41, 249486], [51, 249926], [56, 250266], [59, 250466], [64, 251034], [72, 251454], [79, 251834], [84, 251934]]}, {"verse": 40, "start": 253006, "end": 259879, "text": "And he answered and said to them, I tell you that, if these should keep silent, the stones would immediately cry out.", "words": [[0, 253006], [4, 253142], [7, 253262], [16, 253642], [20, 253842], [25, 254082], [28, 254282], [34, 254837], [36, 255003], [41, 255263], [45, 255423], [51, 256063], [54, 256223], [60, 256483], [67, 256703], [72, 256943], [80, 257903], [84, 257963], [91, 258343], [97, 258583], [109, 258923], [113, 259383]]}, {"verse": 41, "start": 260159, "end": 264403, "text": "¶ And when he was come near, he beheld the city, and wept over it,", "words": [[2, 260159], [6, 260304], [11, 260464], [14, 260644], [18, 260844], [23, 261064], [29, 261904], [32, 262024], [39, 262564], [43, 262804], [49, 263104], [53, 263404], [58, 263764], [63, 264084]]}, {"verse": 42, "start": 264753, "end": 273459, "text": "Saying, If you had known, even you, at least in this your day, the things which belong to your peace! but now they are hid from your eyes.", "words": [[0, 264753], [8, 265635], [11, 265773], [15, 265933], [19, 266113], [26, 266993], [31, 267213], [36, 268013], [39, 268133], [45, 268393], [48, 268613], [53, 268773], [58, 268973], [63, 269413], [67, 269493], [74, 269793], [80, 269993], [87, 270333], [90, 270573], [95, 270733], [102, 271520], [106, 271619], [110, 271879], [115, 272119], [119, 272239], [123, 272439], [128, 272679], [133, 272839]]}, {"verse": 43, "start": 273809, "end": 281881, "text": "For the days shall come upon you, that your enemies shall cast a trench about you, and compass you round, and keep you in on every side,", "words": [[0, 273809], [4, 273901], [8, 274041], [13, 274341], [19, 274561], [24, 274801], [29, 275081], [34, 275901], [39, 276061], [44, 276221], [52, 276581], [58, 276901], [63, 277221], [65, 277421], [72, 277661], [78, 278001], [83, 278641], [87, 278721], [95, 279081], [99, 279321], [106, 280181], [110, 280241], [115, 280481], [119, 280681], [122, 280881], [125, 281021], [131, 281241]]}, {"verse": 44, "start": 282231, "end": 291466, "text": "And shall lay you even with the ground, and your children within you; and they shall not leave in you one stone upon another; because you knew not the time of your visitation.", "words": [[0, 282231], [4, 282355], [10, 282555], [14, 282835], [18, 282995], [23, 283315], [28, 283535], [32, 283675], [40, 284035], [44, 284615], [49, 284715], [58, 285055], [65, 285435], [70, 286045], [74, 286151], [79, 286271], [85, 286431], [89, 286631], [95, 286891], [98, 287051], [102, 287211], [106, 287491], [112, 287811], [117, 288071], [126, 288927], [134, 289316], [138, 289596], [143, 289816], [147, 290056], [151, 290216], [156, 290536], [159, 290676], [164, 290776]]}, {"verse": 45, "start": 291746, "end": 296958, "text": "And he went into the temple, and began to cast out them that sold in it, and them that bought;", "words": [[0, 291746], [4, 291892], [7, 291972], [12, 292152], [17, 292372], [21, 292532], [29, 292852], [33, 293392], [39, 293672], [42, 293852], [47, 294192], [51, 294432], [56, 294692], [61, 294952], [66, 295272], [69, 295512], [73, 295892], [77, 295992], [82, 296192], [87, 296452]]}, {"verse": 46, "start": 297308, "end": 303257, "text": "Saying to them, It is written, My house is the house of prayer: but you have made it a den of thieves.", "words": [[0, 297308], [7, 297588], [10, 297808], [16, 298436], [19, 298559], [22, 298699], [31, 299059], [34, 299239], [40, 299579], [43, 299819], [47, 299979], [53, 300199], [56, 300379], [64, 301117], [68, 301219], [72, 301359], [77, 301499], [82, 301739], [85, 301879], [87, 302039], [91, 302299], [94, 302559]]}, {"verse": 47, "start": 303537, "end": 310190, "text": "And he taught daily in the temple. But the chief priests and the scribes and the chief of the people sought to destroy him,", "words": [[0, 303537], [4, 303668], [7, 303768], [14, 303968], [20, 304368], [23, 304608], [27, 304688], [35, 305419], [39, 305753], [43, 305893], [49, 306113], [57, 306553], [61, 306893], [65, 307033], [73, 307713], [77, 307813], [81, 307933], [87, 308173], [90, 308333], [94, 308413], [101, 308733], [108, 309093], [111, 309313], [119, 309673]]}, {"verse": 48, "start": 310540, "end": 315643, "text": "And could not find what they might do: for all the people were very attentive to hear him.", "words": [[0, 310540], [4, 310644], [10, 310804], [14, 311024], [19, 311364], [24, 311584], [29, 311784], [35, 312004], [39, 312807], [43, 312927], [47, 313207], [51, 313367], [58, 313667], [63, 313927], [68, 314267], [78, 314747], [81, 315007], [86, 315247]]}]}