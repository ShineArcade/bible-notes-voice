{"book": "JHN", "chapter": 7, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 322137, "verses": [{"verse": 1, "start": 300, "end": 7016, "text": "After these things Jesus walked in Galilee: for he would not walk in Judea, because the Jews sought to kill him.", "words": [[0, 300], [6, 513], [12, 793], [19, 1293], [25, 1553], [32, 2053], [35, 2253], [44, 3237], [48, 3340], [51, 3500], [57, 3680], [61, 3900], [66, 4260], [69, 4440], [76, 5040], [84, 5380], [88, 5620], [93, 5880], [100, 6220], [103, 6420], [108, 6660]]}, {"verse": 2, "start": 7466, "end": 10157, "text": "Now the Jews’ feast of tabernacles was at hand.", "words": [[0, 7466], [4, 7671], [8, 7851], [14, 8271], [20, 8411], [23, 8631], [35, 9291], [39, 9531], [42, 9671]]}, {"verse": 3, "start": 10607, "end": 17984, "text": "His brethren therefore said to him, Depart from here, and go into Judæa, that your disciples also may see the works that you do.", "words": [[0, 10607], [4, 10726], [13, 11246], [23, 11826], [28, 11926], [31, 12106], [36, 12706], [43, 12964], [48, 13204], [54, 13484], [58, 13964], [61, 14204], [66, 14634], [73, 15064], [78, 15404], [83, 15504], [93, 15984], [98, 16364], [102, 16564], [106, 16784], [110, 16944], [116, 17184], [121, 17404], [125, 17564]]}, {"verse": 4, "start": 18434, "end": 25703, "text": "For there is no man that does any thing in secret, and he himself seeks to be known openly. If you do these things, show yourself to the world.", "words": [[0, 18434], [4, 18537], [10, 18697], [13, 18837], [16, 19037], [20, 19257], [25, 19457], [30, 19657], [34, 19857], [40, 20057], [43, 20257], [51, 20777], [55, 20997], [58, 21157], [66, 21517], [72, 21817], [75, 22057], [78, 22157], [84, 22357], [92, 23277], [95, 23413], [99, 23533], [102, 23653], [108, 23853], [116, 24353], [121, 24613], [130, 25033], [133, 25193], [137, 25293]]}, {"verse": 5, "start": 26053, "end": 28263, "text": "For neither did his brethren believe in him.", "words": [[0, 26053], [4, 26158], [12, 26418], [16, 26678], [20, 26838], [29, 27258], [37, 27698], [40, 27938]]}, {"verse": 6, "start": 28713, "end": 34508, "text": "Then Jesus said to them, My time is not yet come: but your time is always ready.", "words": [[0, 28713], [5, 28898], [11, 29218], [16, 29578], [19, 29738], [25, 30376], [28, 30543], [33, 30903], [36, 31163], [40, 31423], [44, 31703], [50, 32668], [54, 32771], [59, 32931], [64, 33291], [67, 33551], [74, 33911]]}, {"verse": 7, "start": 34958, "end": 41407, "text": "The world cannot hate you; but me it hates, because I testify of it, that the works of it are evil.", "words": [[0, 34958], [4, 35037], [10, 35317], [17, 35617], [22, 36037], [27, 36773], [31, 36896], [34, 37156], [37, 37396], [44, 38036], [52, 38376], [54, 38556], [62, 38956], [65, 39356], [69, 39696], [74, 39936], [78, 40056], [84, 40296], [87, 40496], [90, 40656], [94, 40876]]}, {"verse": 8, "start": 41857, "end": 48218, "text": "Go up to this feast: I go not up yet to this feast; for my time is not yet full come.", "words": [[0, 41857], [3, 42084], [6, 42344], [9, 42564], [14, 42764], [21, 43722], [23, 43884], [26, 44064], [30, 44264], [33, 44484], [37, 44684], [40, 44904], [45, 45104], [52, 45999], [56, 46099], [59, 46279], [64, 46619], [67, 46879], [71, 47079], [75, 47279], [80, 47619]]}, {"verse": 9, "start": 48568, "end": 51729, "text": "When he had said these words to them, he remained in Galilee.", "words": [[0, 48568], [5, 48695], [8, 48835], [12, 49015], [17, 49235], [23, 49455], [29, 49775], [32, 50015], [38, 50315], [41, 50375], [50, 50715], [53, 50935]]}, {"verse": 10, "start": 52179, "end": 59051, "text": "¶ But when his brethren were gone up, then went he also up to the feast, not openly, but as it were in secret.", "words": [[2, 52179], [6, 52324], [11, 52524], [15, 52704], [24, 53084], [29, 53404], [34, 53664], [38, 54284], [43, 54564], [48, 54744], [51, 54964], [56, 55304], [59, 55664], [62, 55804], [66, 55924], [73, 56624], [77, 56864], [85, 57644], [89, 57804], [92, 58004], [95, 58104], [100, 58304], [103, 58464]]}, {"verse": 11, "start": 59501, "end": 63190, "text": "Then the Jews sought him at the feast, and said, Where is he?", "words": [[0, 59501], [5, 59978], [9, 60138], [14, 60458], [21, 60838], [25, 61018], [28, 61158], [32, 61298], [39, 61578], [43, 61838], [49, 62523], [55, 62722], [58, 62962]]}, {"verse": 12, "start": 63540, "end": 72505, "text": "And there was much murmuring among the people concerning him: for some said, He is a good man: others said, No; but he deceives the people.", "words": [[0, 63540], [4, 63661], [10, 63781], [14, 63981], [19, 64261], [29, 64801], [35, 65021], [39, 65241], [46, 65501], [57, 66001], [62, 66753], [66, 66861], [71, 67121], [77, 67861], [80, 68011], [83, 68231], [85, 68351], [90, 68511], [95, 69231], [102, 69460], [108, 70258], [112, 71010], [116, 71137], [119, 71317], [128, 71877], [132, 72037]]}, {"verse": 13, "start": 72855, "end": 76655, "text": "However no man spoke openly of him for fear of the Jews.", "words": [[0, 72855], [8, 73415], [11, 73515], [15, 73795], [21, 74135], [28, 74675], [31, 74975], [35, 75115], [39, 75315], [44, 75615], [47, 75815], [51, 75955]]}, {"verse": 14, "start": 77105, "end": 81533, "text": "¶ Now about the midst of the feast Jesus went up into the temple, and taught.", "words": [[2, 77105], [6, 77474], [12, 77634], [16, 77834], [22, 78054], [25, 78274], [29, 78394], [35, 78934], [41, 79174], [46, 79554], [49, 79734], [54, 79934], [58, 80094], [66, 80434], [70, 80994]]}, {"verse": 15, "start": 81983, "end": 86696, "text": "And the Jews marvelled, saying, How knows this man letters, having never learned?", "words": [[0, 81983], [4, 82108], [8, 82208], [13, 82698], [24, 83188], [32, 83949], [36, 84126], [42, 84386], [47, 84646], [51, 84946], [60, 85286], [67, 85906], [73, 86206]]}, {"verse": 16, "start": 87046, "end": 92205, "text": "Jesus answered them, and said, My doctrine is not mine, but his that sent me.", "words": [[0, 87046], [6, 87339], [15, 87859], [21, 88139], [25, 88319], [31, 88913], [34, 89079], [43, 89459], [46, 89719], [50, 89939], [56, 90759], [60, 91039], [64, 91219], [69, 91539], [74, 91819]]}, {"verse": 17, "start": 92655, "end": 99183, "text": "If any man will do his will, he shall know of the doctrine, whether it be of God, or whether I speak of myself.", "words": [[0, 92655], [3, 92773], [7, 92953], [11, 93253], [16, 93433], [19, 93633], [23, 93833], [29, 94553], [32, 94673], [38, 94913], [43, 95153], [46, 95293], [50, 95413], [60, 96193], [68, 96413], [71, 96613], [74, 96753], [77, 96893], [82, 97213], [85, 97693], [93, 97953], [95, 98113], [101, 98353], [104, 98553]]}, {"verse": 18, "start": 99633, "end": 108108, "text": "He that speaks of himself seeks his own glory: but he that seeks his glory that sent him, the same is true, and no unrighteousness is in him.", "words": [[0, 99633], [3, 99803], [8, 99983], [15, 100283], [18, 100483], [26, 100863], [32, 101223], [36, 101463], [40, 101623], [47, 102506], [51, 102603], [54, 102863], [59, 103063], [65, 103303], [69, 103543], [75, 103923], [80, 104143], [85, 104383], [90, 104923], [94, 105063], [99, 105283], [102, 105443], [108, 106003], [112, 106283], [115, 106523], [131, 107403], [134, 107623], [137, 107803]]}, {"verse": 19, "start": 108558, "end": 114988, "text": "Did not Moses give you the law, and yet none of you keeps the law? Why do you go about to kill me?", "words": [[0, 108558], [4, 108673], [8, 108893], [14, 109413], [19, 109793], [23, 109973], [27, 110093], [32, 110873], [36, 111153], [40, 111313], [45, 111593], [48, 111773], [52, 111913], [58, 112213], [62, 112473], [67, 113257], [71, 113442], [74, 113642], [78, 113782], [81, 113942], [87, 114202], [90, 114422], [95, 114622]]}, {"verse": 20, "start": 115338, "end": 119604, "text": "The people answered and said, You have a demon: who goes about to kill you?", "words": [[0, 115338], [4, 115418], [11, 115618], [20, 116038], [24, 116278], [30, 116932], [34, 117078], [39, 117398], [41, 117618], [48, 118367], [52, 118490], [57, 118710], [63, 118970], [66, 119150], [71, 119330]]}, {"verse": 21, "start": 119954, "end": 124716, "text": "Jesus answered and said to them, I have done one work, and you all marvel.", "words": [[0, 119954], [6, 120219], [15, 120739], [19, 120959], [24, 121159], [27, 121339], [33, 122058], [35, 122275], [40, 122455], [45, 122675], [49, 122915], [55, 123315], [59, 123675], [63, 123855], [67, 124095]]}, {"verse": 22, "start": 125166, "end": 133515, "text": "Moses therefore gave to you circumcision; (not because it is of Moses, but of the fathers;) and you on the sabbath day circumcise a man.", "words": [[0, 125166], [6, 125529], [16, 126049], [21, 126389], [24, 126609], [28, 126749], [42, 127995], [47, 128155], [55, 128475], [58, 128715], [61, 128855], [64, 128995], [71, 129695], [75, 129795], [78, 129895], [82, 130015], [92, 130955], [96, 131075], [100, 131275], [103, 131475], [107, 131595], [115, 131935], [119, 132255], [130, 132995], [132, 133095]]}, {"verse": 23, "start": 133965, "end": 143474, "text": "If a man on the sabbath day receive circumcision, that the law of Moses should not be broken; are you angry at me, because I have made a man every whit whole on the sabbath day?", "words": [[0, 133965], [3, 134079], [5, 134179], [9, 134459], [12, 134599], [16, 134719], [24, 134999], [28, 135359], [36, 135719], [50, 136839], [55, 137079], [59, 137199], [63, 137459], [66, 137639], [72, 137979], [79, 138279], [83, 138479], [86, 138639], [94, 139507], [98, 139596], [102, 139716], [108, 140036], [111, 140236], [115, 140376], [123, 140756], [125, 140956], [130, 141036], [135, 141196], [137, 141316], [141, 141516], [147, 141809], [152, 142103], [158, 142396], [161, 142636], [165, 142736], [173, 142976]]}, {"verse": 24, "start": 143924, "end": 147052, "text": "Judge not according to the appearance, but judge righteous judgment.", "words": [[0, 143924], [6, 144065], [10, 144285], [20, 144605], [23, 144825], [27, 144905], [39, 145665], [43, 145785], [49, 146045], [59, 146425]]}, {"verse": 25, "start": 147402, "end": 151949, "text": "Then said some of them of Jerusalem, Is not this he, whom they seek to kill?", "words": [[0, 147402], [5, 147640], [10, 147960], [15, 148280], [18, 148440], [23, 148600], [26, 148760], [37, 149814], [40, 149917], [44, 150097], [49, 150337], [53, 150617], [58, 151037], [63, 151217], [68, 151397], [71, 151577]]}, {"verse": 26, "start": 152399, "end": 158345, "text": "But, lo, he speaks boldly, and they say nothing to him. Do the rulers know indeed that this is the very Christ?", "words": [[0, 152596], [5, 152830], [9, 153063], [12, 153143], [19, 153443], [27, 154003], [31, 154203], [36, 154343], [40, 154503], [48, 154723], [51, 154983], [56, 155578], [59, 155662], [63, 155782], [70, 156042], [75, 156342], [82, 156662], [87, 156902], [92, 157122], [95, 157242], [99, 157362], [104, 157702]]}, {"verse": 27, "start": 158795, "end": 164306, "text": "However we know this man from where he is: but when Christ comes, no man knows from where he is.", "words": [[0, 158795], [8, 159072], [11, 159312], [16, 159552], [21, 159832], [25, 160112], [30, 160312], [36, 160552], [39, 160812], [43, 161505], [47, 161602], [52, 161742], [59, 162002], [66, 162702], [69, 162962], [73, 163122], [79, 163382], [84, 163582], [90, 163762], [93, 163962]]}, {"verse": 28, "start": 164656, "end": 175702, "text": "Then cried Jesus in the temple as he taught, saying, You both know me, and you know from where I am: and I am not come of myself, but he that sent me is true, whom you know not.", "words": [[0, 164656], [5, 164872], [11, 165172], [17, 165552], [20, 165852], [24, 165952], [31, 166272], [34, 166552], [37, 166672], [45, 167072], [53, 168299], [57, 168418], [62, 168658], [67, 168898], [71, 169078], [75, 169578], [79, 169698], [84, 169858], [89, 170078], [95, 170238], [97, 170478], [101, 171166], [105, 171292], [107, 171432], [110, 171532], [114, 171732], [119, 171952], [122, 172092], [130, 172872], [134, 173132], [137, 173312], [142, 173532], [147, 173772], [150, 173952], [153, 174132], [159, 174692], [164, 174832], [168, 174992], [173, 175192]]}, {"verse": 29, "start": 176152, "end": 180400, "text": "But I know him: for I am from him, and he has sent me.", "words": [[0, 176152], [4, 176260], [6, 176380], [11, 176560], [16, 177250], [20, 177436], [22, 177756], [25, 178076], [30, 178416], [35, 179256], [39, 179436], [42, 179616], [46, 179796], [51, 180056]]}, {"verse": 30, "start": 180750, "end": 186602, "text": "Then they sought to take him: but no man laid hands on him, because his hour was not yet come.", "words": [[0, 180750], [5, 181049], [10, 181269], [17, 181509], [20, 181729], [25, 181969], [30, 182587], [34, 182711], [37, 182991], [41, 183331], [46, 183611], [52, 183971], [55, 184191], [60, 184411], [68, 184791], [72, 185031], [77, 185351], [81, 185651], [85, 185871], [89, 186071]]}, {"verse": 31, "start": 187052, "end": 194744, "text": "And many of the people believed on him, and said, When Christ comes, will he do more miracles than these which this man has done?", "words": [[0, 187052], [4, 187196], [9, 187416], [12, 187576], [16, 187696], [23, 187956], [32, 188396], [35, 188676], [40, 188916], [44, 189356], [50, 190210], [55, 190363], [62, 190703], [69, 191443], [74, 191623], [77, 191723], [80, 191923], [85, 192183], [94, 192703], [99, 193003], [105, 193263], [111, 193483], [116, 193843], [120, 194103], [124, 194303]]}, {"verse": 32, "start": 195094, "end": 204580, "text": "¶ The Pharisees heard that the people murmured such things concerning him; and the Pharisees and the chief priests sent officers to take him.", "words": [[2, 195094], [6, 195234], [16, 195954], [22, 196254], [27, 196694], [31, 196834], [38, 197114], [47, 197714], [52, 197954], [59, 198374], [70, 198974], [75, 199844], [79, 200208], [83, 200308], [93, 201188], [97, 201308], [101, 201448], [107, 201648], [115, 202228], [120, 202728], [129, 203228], [132, 203568], [137, 203828]]}, {"verse": 33, "start": 205030, "end": 210440, "text": "Then said Jesus to them, Yet a little while am I with you, and then I go to him that sent me.", "words": [[0, 205030], [5, 205231], [10, 205551], [16, 205991], [19, 206331], [25, 207028], [29, 207154], [31, 207254], [38, 207414], [44, 207654], [47, 207894], [49, 207994], [54, 208214], [59, 208794], [63, 208874], [68, 209054], [70, 209174], [73, 209394], [76, 209534], [80, 209714], [85, 209894], [90, 210114]]}, {"verse": 34, "start": 210890, "end": 215488, "text": "You shall seek me, and shall not find me: and where I am, there you cannot come.", "words": [[0, 210890], [4, 211010], [10, 211170], [15, 211430], [19, 211690], [23, 211930], [29, 212110], [33, 212310], [38, 212610], [42, 213255], [46, 213379], [52, 213539], [54, 213799], [58, 214379], [64, 214499], [68, 214639], [75, 214879]]}, {"verse": 35, "start": 215838, "end": 224728, "text": "Then said the Jews among themselves, Where will he go, that we shall not find him? will he go to the dispersed among the Gentiles, and teach the Gentiles?", "words": [[0, 215838], [5, 216082], [10, 216402], [14, 216582], [19, 216822], [25, 217122], [37, 218329], [43, 218514], [48, 218714], [51, 218854], [55, 219094], [60, 219554], [63, 219694], [69, 219874], [73, 220054], [78, 220314], [83, 220993], [88, 221153], [91, 221313], [94, 221513], [97, 221653], [101, 221773], [111, 222153], [117, 222433], [121, 222633], [131, 223233], [135, 223513], [141, 223793], [145, 223993]]}, {"verse": 36, "start": 225178, "end": 232173, "text": "What manner of saying is this that he said, You shall seek me, and shall not find me: and where I am, there you cannot come?", "words": [[0, 225178], [5, 225320], [12, 225600], [15, 225800], [22, 226080], [25, 226280], [30, 226480], [35, 226720], [38, 226900], [44, 227340], [48, 227580], [54, 227800], [59, 228120], [63, 228380], [67, 228740], [73, 228960], [77, 229160], [82, 229460], [86, 230098], [90, 230240], [96, 230420], [98, 230620], [102, 231140], [108, 231280], [112, 231440], [119, 231680]]}, {"verse": 37, "start": 232523, "end": 241418, "text": "In the last day, that great day of the feast, Jesus stood and cried, saying, If any man thirst, let him come to me, and drink.", "words": [[0, 232523], [3, 232634], [7, 232734], [12, 233054], [17, 233774], [22, 233934], [28, 234254], [32, 234574], [35, 234734], [39, 234854], [46, 235534], [52, 235854], [58, 236354], [62, 236674], [69, 237374], [77, 238536], [80, 238660], [84, 238840], [88, 239100], [96, 239900], [100, 240040], [104, 240180], [109, 240400], [112, 240580], [116, 240740], [120, 240980]]}, {"verse": 38, "start": 241868, "end": 247183, "text": "He that believes on me, as the scripture has said, out of his belly shall flow rivers of living water.", "words": [[0, 241868], [3, 242050], [8, 242290], [17, 242630], [20, 242890], [24, 243130], [27, 243410], [31, 243550], [41, 243810], [45, 244070], [51, 244670], [55, 244790], [58, 244910], [62, 245010], [68, 245290], [74, 245570], [79, 245830], [86, 246170], [89, 246430], [96, 246650]]}, {"verse": 39, "start": 247533, "end": 256968, "text": "(But this spoke he of the Spirit, which they that believe on him should receive: for the Holy Spirit was not yet given; because that Jesus was not yet glorified.)", "words": [[0, 247533], [5, 247663], [10, 247883], [16, 248243], [19, 248563], [22, 248703], [26, 248843], [34, 249383], [40, 249563], [45, 249863], [50, 250123], [58, 250463], [61, 250723], [65, 250903], [72, 251163], [81, 252213], [85, 252314], [89, 252414], [94, 252614], [101, 253034], [105, 253234], [109, 253454], [113, 253634], [120, 254534], [128, 254741], [133, 255001], [139, 255301], [143, 255621], [147, 255841], [151, 256001]]}, {"verse": 40, "start": 257418, "end": 263173, "text": "¶ Many of the people therefore, when they heard this saying, said, Of a truth this is the Prophet.", "words": [[2, 257418], [7, 257647], [10, 257807], [14, 257947], [21, 258347], [32, 259167], [37, 259267], [42, 259447], [48, 259687], [53, 259927], [61, 260307], [67, 261208], [70, 261404], [72, 261504], [78, 262044], [83, 262304], [86, 262464], [90, 262584]]}, {"verse": 41, "start": 263523, "end": 268603, "text": "Others said, This is the Christ. But some said, Shall Christ come out of Galilee?", "words": [[0, 263523], [7, 263752], [13, 264550], [18, 264752], [21, 264892], [25, 265012], [33, 265903], [37, 266010], [42, 266290], [48, 267019], [54, 267135], [61, 267475], [66, 267735], [70, 267895], [73, 267975]]}, {"verse": 42, "start": 269053, "end": 274719, "text": "Has not the scripture said, That Christ comes of the seed of David, and out of the town of Bethlehem, where David was?", "words": [[0, 269053], [4, 269190], [8, 269350], [12, 269530], [22, 269770], [28, 270110], [33, 270310], [40, 270610], [46, 270910], [49, 271070], [53, 271220], [58, 271370], [61, 271490], [68, 271810], [72, 272270], [76, 272530], [79, 272670], [83, 272770], [88, 272990], [91, 273110], [102, 273670], [108, 273850], [114, 274170]]}, {"verse": 43, "start": 275069, "end": 277887, "text": "So there was a division among the people because of him.", "words": [[0, 275069], [3, 275244], [9, 275424], [13, 275604], [15, 275744], [24, 276124], [30, 276424], [34, 276684], [41, 276964], [49, 277264], [52, 277584]]}, {"verse": 44, "start": 278337, "end": 282525, "text": "And some of them would have taken him; but no man laid hands on him.", "words": [[0, 278337], [4, 278499], [9, 278739], [12, 278919], [17, 279099], [23, 279279], [28, 279379], [34, 279699], [39, 280445], [43, 280785], [46, 281025], [50, 281345], [55, 281605], [61, 281925], [64, 282165]]}, {"verse": 45, "start": 282975, "end": 289246, "text": "¶ Then came the officers to the chief priests and Pharisees; and they said to them, Why have you not brought him?", "words": [[2, 282975], [7, 283213], [12, 283473], [16, 283713], [25, 284153], [28, 284513], [32, 284633], [38, 284853], [46, 285293], [50, 285533], [61, 286610], [65, 286773], [70, 286913], [75, 287153], [78, 287353], [84, 287965], [88, 288174], [93, 288354], [97, 288474], [101, 288614], [109, 288874]]}, {"verse": 46, "start": 289596, "end": 292917, "text": "The officers answered, Never man spoke like this man.", "words": [[0, 289596], [4, 289696], [13, 290036], [23, 291370], [29, 291570], [33, 291790], [39, 292030], [44, 292350], [49, 292530]]}, {"verse": 47, "start": 293267, "end": 296774, "text": "Then answered them the Pharisees, Are you also deceived?", "words": [[0, 293267], [5, 293457], [14, 293877], [19, 294197], [23, 294397], [34, 295550], [38, 295695], [42, 295855], [47, 296155]]}, {"verse": 48, "start": 297224, "end": 299954, "text": "Have any of the rulers or of the Pharisees believed on him?", "words": [[0, 297224], [5, 297371], [9, 297651], [12, 297791], [16, 297911], [23, 298231], [26, 298491], [29, 298591], [33, 298691], [43, 299171], [52, 299411], [55, 299611]]}, {"verse": 49, "start": 300404, "end": 302834, "text": "But this people who knows not the law are cursed.", "words": [[0, 300404], [4, 300544], [9, 300724], [16, 301064], [20, 301264], [26, 301524], [30, 301744], [34, 301904], [38, 302124], [42, 302304]]}, {"verse": 50, "start": 303184, "end": 307858, "text": "Nicodemus says to them, (he that came to Jesus by night, being one of them,)", "words": [[0, 303184], [10, 303792], [15, 303952], [18, 304172], [24, 304912], [28, 305192], [33, 305392], [38, 305632], [41, 305792], [47, 306052], [50, 306412], [57, 306712], [63, 307052], [67, 307352], [70, 307492]]}, {"verse": 51, "start": 308158, "end": 311765, "text": "Does our law judge any man, before it hear him, and know what he does?", "words": [[0, 308158], [5, 308275], [9, 308475], [13, 308695], [19, 308995], [23, 309295], [28, 309575], [35, 309895], [38, 310135], [43, 310355], [48, 310615], [52, 310835], [57, 311035], [62, 311235], [65, 311315]]}, {"verse": 52, "start": 312115, "end": 319330, "text": "They answered and said to him, Are you also of Galilee? Search, and look: for out of Galilee arises no prophet.", "words": [[0, 312115], [5, 312224], [14, 312624], [18, 312844], [23, 313044], [26, 313224], [31, 313725], [35, 313885], [39, 314065], [44, 314485], [47, 314765], [56, 315625], [64, 315976], [68, 316256], [74, 316994], [78, 317096], [82, 317396], [85, 317536], [93, 317876], [100, 318376], [103, 318881]]}, {"verse": 53, "start": 319680, "end": 321737, "text": "And every man went to his own house.", "words": [[0, 319680], [4, 319808], [10, 320068], [14, 320348], [19, 320588], [22, 320768], [26, 320928], [30, 321088]]}]}