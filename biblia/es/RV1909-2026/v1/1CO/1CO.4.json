{"book": "1CO", "chapter": 4, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 157167, "verses": [{"verse": 1, "start": 300, "end": 4983, "text": "NOS TENGAN los hombres por ministros de Cristo, y administradores de los misterios de Dios.", "words": [[0, 300], [4, 442], [11, 722], [15, 943], [23, 1262], [27, 1522], [37, 2062], [40, 2162], [48, 2522], [50, 2822], [66, 3622], [69, 3742], [73, 3862], [83, 4402], [86, 4502]]}, {"verse": 2, "start": 5333, "end": 9375, "text": "Pero ahora se requiere en los administradores, que cada uno sea hallado fiel.", "words": [[0, 5333], [5, 5475], [11, 5735], [14, 5948], [23, 6162], [26, 6375], [30, 6555], [47, 7435], [51, 7815], [56, 8035], [60, 8295], [64, 8595], [72, 8935]]}, {"verse": 3, "start": 9725, "end": 14716, "text": "Yo en muy poco tengo el ser juzgado de vosotros, o de juicio humano; y ni aun yo me juzgo.", "words": [[0, 9725], [3, 9873], [6, 9953], [10, 10053], [15, 10313], [21, 10553], [24, 10733], [28, 10893], [36, 11333], [39, 11513], [49, 11993], [51, 12253], [54, 12373], [61, 12673], [69, 13513], [71, 13633], [74, 13713], [78, 13893], [81, 14073], [84, 14213]]}, {"verse": 4, "start": 15066, "end": 21615, "text": "Porque aunque de nada tengo mala conciencia, no por eso soy justificado; pero el que me juzga, el Señor es.", "words": [[0, 15066], [7, 15249], [14, 15409], [17, 15629], [22, 15789], [28, 16109], [33, 16309], [45, 17369], [48, 17449], [52, 17629], [56, 17789], [60, 17969], [73, 19422], [78, 19560], [81, 19680], [85, 19800], [88, 19940], [95, 20680], [98, 20780], [104, 21020]]}, {"verse": 5, "start": 21965, "end": 34751, "text": "Así que, no juzguéis nada antes de tiempo, hasta que venga el Señor, el cual también aclarará lo oculto de las tinieblas, y manifestará las intenciones de los corazones: y entonces cada uno tendrá de Dios la alabanza.", "words": [[0, 21965], [4, 22142], [9, 22302], [12, 22442], [21, 22982], [26, 23262], [32, 23662], [35, 23822], [43, 24522], [49, 24782], [53, 24962], [59, 25222], [62, 25342], [69, 26122], [72, 26242], [77, 26442], [85, 26762], [94, 27422], [97, 27602], [104, 28122], [107, 28162], [111, 28322], [122, 28982], [124, 29302], [136, 29902], [140, 30062], [152, 30622], [155, 30782], [159, 30882], [170, 31912], [172, 32014], [181, 32354], [186, 32794], [190, 33074], [197, 33514], [200, 33634], [205, 33854], [208, 34094]]}, {"verse": 6, "start": 35101, "end": 47725, "text": "Pero esto, hermanos, he presentado como ejemplo en mí y en Apolos por amor de vosotros; para que en nosotros aprendáis a no saber más de lo que está escrito, para que ninguno se envanezca a favor de uno contra otro.", "words": [[0, 35101], [5, 35243], [11, 35603], [21, 36223], [24, 36243], [35, 36843], [40, 37043], [48, 37483], [51, 37863], [54, 38083], [56, 38323], [59, 38403], [66, 38923], [70, 39303], [75, 39523], [78, 39743], [88, 40623], [93, 40774], [97, 40854], [100, 40934], [109, 41234], [119, 42114], [121, 42254], [124, 42434], [130, 42714], [134, 43054], [137, 43334], [140, 43474], [144, 43574], [149, 43754], [158, 44634], [163, 44914], [167, 45054], [175, 45454], [178, 45574], [188, 46114], [190, 46214], [196, 46394], [199, 46634], [203, 46854], [210, 47214]]}, {"verse": 7, "start": 48075, "end": 55751, "text": "Porque ¿quién te distingue? ¿o qué tienes que no hayas recibido? Y si lo recibiste, ¿de qué te glorías como si no hubieras recibido?", "words": [[0, 48075], [7, 48233], [14, 48453], [17, 48613], [28, 49511], [31, 49617], [35, 49757], [42, 50137], [46, 50377], [49, 50577], [55, 50917], [65, 51907], [67, 52005], [70, 52085], [73, 52225], [84, 53245], [88, 53325], [92, 53445], [95, 53605], [103, 54045], [108, 54285], [111, 54465], [114, 54605], [123, 55045]]}, {"verse": 8, "start": 56101, "end": 64273, "text": "Ya estáis saciados, ya estáis ricos, sin nosotros reináis; y ojalá reinéis, para que nosotros reinemos también juntamente con vosotros.", "words": [[0, 56101], [3, 56258], [10, 56828], [20, 57398], [23, 57478], [30, 57838], [37, 58218], [41, 58538], [50, 58978], [59, 59982], [61, 60131], [67, 60531], [76, 60971], [81, 61231], [85, 61371], [94, 61711], [103, 62351], [111, 62651], [122, 63351], [126, 63571]]}, {"verse": 9, "start": 64623, "end": 75609, "text": "Porque a lo que pienso, Dios nos ha mostrado a nosotros los apóstoles por los últimos, como a sentenciados a muerte: porque somos hechos espectáculo al mundo, y a los ángeles, y a los hombres.", "words": [[0, 64623], [7, 64843], [9, 64943], [12, 65023], [16, 65143], [24, 65763], [29, 65923], [33, 66103], [36, 66203], [45, 66663], [47, 66783], [56, 67053], [60, 67323], [70, 67903], [74, 68083], [78, 68243], [87, 69143], [92, 69496], [94, 69850], [107, 70203], [109, 70323], [117, 71025], [124, 71220], [130, 71520], [137, 72000], [149, 72760], [152, 72940], [159, 73280], [161, 73760], [163, 73820], [167, 73960], [176, 74460], [178, 74740], [180, 74800], [184, 74960]]}, {"verse": 10, "start": 75959, "end": 86742, "text": "Nosotros necios por amor de Cristo, y vosotros prudentes en Cristo; nosotros débiles, y vosotros fuertes; vosotros estimados, y nosotros despreciados.", "words": [[0, 75959], [9, 76475], [16, 76995], [20, 77315], [25, 77495], [28, 77715], [36, 78095], [38, 78535], [47, 78955], [57, 79515], [60, 79735], [68, 80549], [77, 80975], [86, 81515], [88, 81835], [97, 82275], [106, 83874], [115, 84296], [126, 84996], [128, 85236], [137, 85516]]}, {"verse": 11, "start": 87092, "end": 94498, "text": "Hasta esta hora pasamos hambre, y tenemos sed, y estamos desnudos, y somos heridos de golpes, y andamos sin hogar fijo;", "words": [[0, 87092], [6, 87280], [11, 87580], [16, 87800], [24, 88300], [32, 88840], [34, 89060], [42, 89340], [47, 89780], [49, 90020], [57, 90360], [67, 91040], [69, 91500], [75, 91700], [83, 92180], [86, 92360], [94, 92860], [96, 93140], [104, 93560], [108, 93780], [114, 94060]]}, {"verse": 12, "start": 94848, "end": 101714, "text": "Y trabajamos, obrando con nuestras manos: nos maldicen, y bendecimos: padecemos persecución, y sufrimos:", "words": [[0, 94848], [2, 94952], [14, 95612], [22, 96132], [26, 96352], [35, 96592], [42, 97589], [46, 97712], [56, 98312], [58, 98392], [70, 99487], [80, 99970], [93, 100850], [95, 100990]]}, {"verse": 13, "start": 102064, "end": 108135, "text": "Somos calumniados, y rogamos: hemos venido a ser como la basura del mundo, el desecho de todos hasta ahora.", "words": [[0, 102064], [6, 102403], [19, 103083], [21, 103343], [30, 104123], [36, 104322], [43, 104682], [45, 104802], [49, 104922], [54, 105142], [57, 105282], [64, 105682], [68, 105862], [75, 106522], [78, 106602], [86, 107042], [89, 107122], [95, 107362], [101, 107702]]}, {"verse": 14, "start": 108485, "end": 113053, "text": "No escribo esto para avergonzaros: sino que os amonesto como a mis hijos amados.", "words": [[0, 108485], [3, 108707], [11, 108967], [16, 109167], [21, 109447], [35, 110572], [40, 110792], [44, 110972], [47, 111092], [56, 111632], [61, 111872], [63, 112012], [67, 112112], [73, 112312]]}, {"verse": 15, "start": 113403, "end": 120904, "text": "Porque aunque tengáis diez mil tutores en Cristo, no tendréis muchos padres; que en Cristo Jesús yo os engendré por el evangelio.", "words": [[0, 113403], [7, 113571], [14, 113731], [22, 114071], [27, 114411], [31, 114751], [39, 115171], [42, 115631], [50, 116091], [53, 116291], [62, 116791], [69, 116991], [77, 117811], [81, 117908], [84, 118008], [91, 118308], [97, 118888], [100, 119268], [103, 119408], [112, 119888], [116, 120068], [119, 120168]]}, {"verse": 16, "start": 121254, "end": 123311, "text": "Por tanto, os ruego que me imitéis.", "words": [[0, 121254], [4, 121370], [11, 121690], [14, 122030], [20, 122350], [24, 122510], [27, 122630]]}, {"verse": 17, "start": 123661, "end": 135285, "text": "Por lo cual os he enviado a Timoteo, que es mi hijo amado y fiel en el Señor, el cual os recordará cuáles son mis caminos en Cristo, de la manera que enseño en todas partes en todas las iglesias.", "words": [[0, 123661], [4, 123780], [7, 123880], [12, 124110], [15, 124340], [18, 124500], [26, 124960], [28, 125100], [37, 126100], [41, 126160], [44, 126320], [47, 126500], [52, 126700], [58, 127100], [60, 127240], [65, 127380], [68, 127560], [71, 127700], [78, 128500], [81, 128600], [86, 128820], [89, 129020], [99, 129620], [106, 130040], [110, 130220], [114, 130420], [122, 130840], [125, 131020], [133, 131763], [136, 131868], [139, 131968], [146, 132208], [150, 132448], [157, 132908], [160, 133028], [166, 133188], [173, 134028], [176, 134088], [182, 134268], [186, 134528]]}, {"verse": 18, "start": 135635, "end": 140023, "text": "Pero algunos están envanecidos, como si nunca hubiese yo de ir a vosotros.", "words": [[0, 135635], [5, 135774], [13, 136094], [19, 136494], [32, 137594], [37, 137914], [40, 138074], [46, 138294], [54, 138714], [57, 138974], [60, 139094], [63, 139254], [65, 139334]]}, {"verse": 19, "start": 140373, "end": 147381, "text": "Pero iré pronto a vosotros, si el Señor quiere; y entenderé, no las palabras de los que andan hinchados, sino el poder.", "words": [[0, 140373], [5, 140513], [9, 140773], [16, 140993], [18, 141193], [28, 141713], [31, 142073], [34, 142173], [40, 142373], [48, 143216], [50, 143317], [61, 143917], [64, 144157], [68, 144377], [77, 144757], [80, 145037], [84, 145157], [88, 145337], [94, 145597], [105, 146517], [110, 146697], [113, 146897]]}, {"verse": 20, "start": 147731, "end": 151473, "text": "Porque el reino de Dios no consiste en palabras, sino en poder.", "words": [[0, 147731], [7, 147937], [10, 148137], [16, 148437], [19, 148557], [24, 148797], [27, 149097], [36, 149497], [39, 149777], [49, 150457], [54, 150737], [57, 150977]]}, {"verse": 21, "start": 151823, "end": 156767, "text": "¿Qué queréis? ¿iré a vosotros con vara, o con amor y espíritu de mansedumbre?", "words": [[0, 151823], [5, 151923], [14, 152773], [19, 153071], [21, 153131], [30, 153631], [34, 153931], [40, 154291], [42, 154556], [46, 154736], [51, 155016], 