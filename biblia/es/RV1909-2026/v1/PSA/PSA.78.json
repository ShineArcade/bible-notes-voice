{"book": "PSA", "chapter": 78, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 437021, "verses": [{"verse": 1, "start": 300, "end": 7009, "text": "Masquil de Asaf. ESCUCHA, pueblo mío, mi ley: inclinad vuestro oído a las palabras de mi boca.", "words": [[0, 300], [8, 849], [11, 989], [17, 1623], [26, 2023], [33, 2183], [38, 2983], [41, 3083], [46, 4285], [55, 4691], [63, 5111], [68, 5511], [70, 5671], [74, 5751], [83, 6111], [86, 6331], [89, 6451]]}, {"verse": 2, "start": 7359, "end": 12046, "text": "Abriré mi boca en parábola; hablaré cosas reservadas de antiguo:", "words": [[0, 7359], [7, 8019], [10, 8139], [15, 8379], [18, 8579], [28, 9718], [36, 10160], [42, 10400], [53, 11180], [56, 11360]]}, {"verse": 3, "start": 12396, "end": 16941, "text": "Las cuales hemos oído y entendido; que nuestros padres nos las contaron.", "words": [[0, 12396], [4, 12505], [11, 12685], [17, 13045], [22, 13585], [24, 13745], [35, 14863], [39, 14944], [48, 15144], [55, 15724], [59, 16004], [63, 16164]]}, {"verse": 4, "start": 17291, "end": 27686, "text": "No las encubriremos a sus hijos, contando a la generación venidera las alabanzas de Jehová, y su fortaleza, y sus maravillas que hizo.", "words": [[0, 17291], [3, 17662], [7, 17942], [20, 19042], [22, 19262], [26, 19422], [33, 20322], [42, 21082], [44, 21202], [47, 21282], [58, 22002], [67, 22722], [71, 22902], [81, 23582], [84, 23682], [92, 24462], [94, 24622], [97, 24782], [108, 25742], [110, 26102], [114, 26262], [125, 26942], [129, 27142]]}, {"verse": 5, "start": 28036, "end": 36340, "text": "Él estableció testimonio en Jacob, y pusó ley en Israel; la cual mandó a nuestros padres que la notificasen a sus hijos;", "words": [[0, 28036], [3, 28240], [14, 29000], [25, 29660], [28, 29740], [35, 30060], [37, 30360], [42, 30720], [46, 30940], [49, 31300], [57, 32275], [60, 32381], [65, 32581], [71, 33141], [73, 33281], [82, 33481], [89, 34161], [93, 34461], [96, 34981], [108, 35501], [110, 35581], [114, 35761]]}, {"verse": 6, "start": 36690, "end": 43783, "text": "Para que lo sepa la generación venidera, y los hijos que nacerán; y los que se levantarán, lo cuenten a sus hijos;", "words": [[0, 36690], [5, 37025], [9, 37145], [12, 37285], [17, 37605], [20, 37705], [31, 38325], [41, 38965], [43, 39085], [47, 39265], [53, 39545], [57, 39765], [66, 40693], [68, 40819], [72, 40939], [76, 41099], [79, 41279], [91, 42099], [94, 42239], [102, 42779], [104, 42879], [108, 43059]]}, {"verse": 7, "start": 44133, "end": 51658, "text": "A fin de que pongan en Dios su confianza, y no se olviden de las obras de Dios, y guarden sus mandamientos:", "words": [[0, 44133], [2, 44273], [6, 44433], [9, 44593], [13, 44713], [20, 45233], [23, 45373], [28, 45633], [31, 46033], [42, 47053], [44, 47233], [47, 47373], [50, 47553], [58, 48113], [61, 48293], [65, 48473], [71, 48773], [74, 48973], [80, 49313], [82, 49793], [90, 50333], [94, 50553]]}, {"verse": 8, "start": 52008, "end": 62393, "text": "Y no sean como sus padres, generación obstinada y rebelde; generación que no preparó su corazón, ni fue fiel para con Dios su espíritu.", "words": [[0, 52008], [2, 52136], [5, 52276], [10, 52596], [15, 52936], [19, 53156], [27, 54236], [38, 55096], [48, 55976], [50, 56116], [59, 57114], [70, 57722], [74, 57882], [77, 58022], [85, 58502], [88, 58622], [97, 59482], [100, 59722], [104, 59942], [109, 60362], [114, 60662], [118, 60922], [123, 61202], [126, 61582]]}, {"verse": 9, "start": 62743, "end": 68199, "text": "Los hijos de Efraín armados, flecheros, volvieron las espaldas el día de la batalla.", "words": [[0, 62743], [4, 62871], [10, 63231], [13, 63691], [20, 64151], [29, 64811], [40, 65671], [50, 66111], [54, 66291], [63, 66971], [66, 67151], [70, 67371], [73, 67511], [76, 67611]]}, {"verse": 10, "start": 68549, "end": 72889, "text": "No guardaron el pacto de Dios, ni quisieron andar en su ley:", "words": [[0, 68549], [3, 68752], [13, 69392], [16, 69592], [22, 70112], [25, 70212], [31, 70552], [34, 70992], [44, 71612], [50, 72032], [53, 72272], [56, 72432]]}, {"verse": 11, "start": 73239, "end": 78902, "text": "Antes se olvidaron de sus obras, y de sus maravillas que les había mostrado.", "words": [[0, 73239], [6, 73707], [9, 74327], [19, 74967], [22, 75167], [26, 75347], [33, 75767], [35, 76302], [38, 76422], [42, 76602], [53, 77302], [57, 77542], [61, 77722], [67, 78022]]}, {"verse": 12, "start": 79252, "end": 85359, "text": "Delante de sus padres hizo maravillas en la tierra de Egipto, en el campo de Zoán.", "words": [[0, 79252], [8, 79720], [11, 79900], [15, 80020], [22, 80480], [27, 81220], [38, 82000], [41, 82220], [44, 82360], [51, 82720], [54, 82960], [62, 83600], [65, 83980], [68, 84140], [74, 84480], [77, 84952]]}, {"verse": 13, "start": 85709, "end": 90992, "text": "Rompió el mar, y los hizo pasar; e hizo estar las aguas como en un montón.", "words": [[0, 85709], [7, 86151], [10, 86311], [15, 86591], [17, 86826], [21, 86986], [26, 87206], [33, 88125], [35, 88406], [40, 88646], [46, 88966], [50, 89206], [56, 89666], [61, 89866], [64, 90046], [67, 90166]]}, {"verse": 14, "start": 91342, "end": 95834, "text": "Y los llevó de día con nube, y toda la noche con resplandor de fuego.", "words": [[0, 91342], [2, 91582], [6, 91722], [12, 92082], [15, 92162], [19, 92382], [23, 92602], [29, 93102], [31, 93462], [36, 93682], [39, 93922], [45, 94182], [49, 94462], [60, 95122], [63, 95222]]}, {"verse": 15, "start": 96184, "end": 101057, "text": "Hendió las peñas en el desierto: y les dio a beber como de grandes abismos;", "words": [[0, 96327], [7, 96507], [11, 96627], [17, 97147], [20, 97367], [23, 97487], [33, 98516], [35, 98793], [39, 98913], [43, 99073], [45, 99213], [51, 99393], [56, 99693], [59, 99873], [67, 100193]]}, {"verse": 16, "start": 101407, "end": 106232, "text": "Pues sacó de la peña corrientes, e hizo descender aguas como ríos.", "words": [[0, 101407], [5, 101739], [10, 102219], [13, 102299], [16, 102419], [21, 102739], [33, 103379], [35, 103759], [40, 104079], [50, 104719], [56, 105399], [61, 105639]]}, {"verse": 17, "start": 106582, "end": 111636, "text": "Pero aun volvieron a pecar contra él, enojando en la soledad al Altísimo.", "words": [[0, 106582], [5, 106749], [9, 106989], [19, 107549], [21, 107709], [27, 108069], [34, 108409], [38, 109289], [47, 109809], [50, 109929], [53, 110029], [61, 110609], [64, 110749]]}, {"verse": 18, "start": 111986, "end": 116427, "text": "Pues tentaron a Dios en su corazón, pidiendo comida a su gusto.", "words": [[0, 111986], [5, 112148], [14, 112748], [16, 112908], [21, 113168], [24, 113428], [27, 113588], [36, 114468], [45, 115048], [52, 115488], [54, 115668], [57, 115768]]}, {"verse": 19, "start": 116777, "end": 120731, "text": "Y hablaron contra Dios, diciendo: ¿Podrá poner mesa en el desierto?", "words": [[0, 116777], [2, 116881], [11, 117321], [18, 117641], [24, 117921], [34, 118940], [41, 119224], [47, 119404], [52, 119764], [55, 119904], [58, 120004]]}, {"verse": 20, "start": 121081, "end": 128506, "text": "He aquí ha herido la peña, y corrieron aguas, y arroyos salieron ondeando: ¿podrá también dar pan? ¿preparará carne a su pueblo?", "words": [[0, 121081], [3, 121225], [8, 121405], [11, 121585], [18, 121865], [21, 121985], [27, 122405], [29, 122765], [39, 123205], [46, 123685], [48, 123845], [56, 124245], [65, 124665], [75, 125593], [82, 125896], [90, 126136], [94, 126356], [99, 127263], [110, 127503], [116, 127743], [118, 127923], [121, 128003]]}, {"verse": 21, "start": 128786, "end": 136849, "text": "Por tanto, oyó Jehová y se indignó; se encendió el fuego contra Jacob, y el furor subió también contra Israel;", "words": [[0, 128786], [4, 128930], [11, 129423], [15, 129917], [22, 130410], [24, 130590], [27, 130690], [36, 131831], [39, 131991], [48, 132611], [51, 132731], [57, 133031], [64, 133471], [71, 133891], [73, 134211], [76, 134371], [82, 134831], [88, 135271], [96, 135571], [103, 136071]]}, {"verse": 22, "start": 137199, "end": 141719, "text": "Por cuanto no habían creído a Dios, ni habían confiado en su salvación:", "words": [[0, 137199], [4, 137301], [11, 137541], [14, 137881], [21, 138201], [28, 138681], [30, 138821], [36, 139231], [39, 139641], [46, 139941], [55, 140641], [58, 140761], [61, 140901]]}, {"verse": 23, "start": 142069, "end": 147106, "text": "A pesar de que mandó a las nubes de arriba, y abrió las puertas de los cielos,", "words": [[0, 142069], [2, 142211], [8, 142451], [11, 142671], [15, 142811], [21, 143271], [23, 143391], [27, 143491], [33, 143931], [36, 144071], [44, 144471], [46, 145031], [52, 145311], [56, 145471], [64, 146031], [67, 146211], [71, 146351]]}, {"verse": 24, "start": 147456, "end": 152459, "text": "E hizo llover sobre ellos maná para comer, y les dio trigo de los cielos.", "words": [[0, 147456], [2, 147600], [7, 147960], [14, 148440], [20, 148780], [26, 149100], [31, 149480], [36, 149600], [43, 150460], [45, 150820], [49, 150960], [53, 151120], [59, 151520], [62, 151640], [66, 151780]]}, {"verse": 25, "start": 152809, "end": 157248, "text": "Pan de nobles comió el hombre: les envió comida a hartura.", "words": [[0, 152809], [4, 152985], [7, 153125], [14, 153525], [20, 154305], [23, 154465], [31, 155189], [35, 155318], [41, 155738], [48, 156198], [50, 156745]]}, {"verse": 26, "start": 157598, "end": 161865, "text": "Movió el solano en el cielo, y trajo con su fortaleza el sur.", "words": [[0, 157598], [6, 158082], [9, 158202], [16, 158642], [19, 158762], [22, 158882], [29, 159342], [31, 159782], [37, 160202], [41, 160402], [44, 160582], [54, 161282], [57, 161422]]}, {"verse": 27, "start": 162215, "end": 168398, "text": "E hizo llover sobre ellos carne como polvo, y aves de alas como arena del mar.", "words": [[0, 162215], [2, 162360], [7, 162600], [14, 163080], [20, 163340], [26, 163720], [32, 164260], [37, 164560], [44, 165660], [46, 165900], [51, 166200], [54, 166460], [59, 166900], [64, 167200], [70, 167600], [74, 167900]]}, {"verse": 28, "start": 168748, "end": 173528, "text": "Y las hizo caer en medio de su campo, alrededor de sus tiendas.", "words": [[0, 168748], [2, 168873], [6, 169013], [11, 169313], [16, 169873], [19, 170013], [25, 170373], [28, 170593], [31, 170753], [38, 171213], [48, 171953], [51, 172573], [55, 172713]]}, {"verse": 29, "start": 173878, "end": 177997, "text": "Y comieron, y se hartaron mucho: les cumplió pues su deseo.", "words": [[0, 173878], [2, 173979], [12, 174439], [14, 174659], [17, 174779], [26, 175239], [33, 176100], [37, 176396], [45, 176726], [50, 177006], [53, 177346]]}, {"verse": 30, "start": 178347, "end": 183199, "text": "No habían quitado de sí su deseo, aún estaba su comida en su boca,", "words": [[0, 178347], [3, 178458], [10, 178678], [18, 179238], [21, 179478], [24, 179618], [27, 179818], [34, 180878], [38, 181138], [45, 181558], [48, 181838], [55, 182178], [58, 182398], [61, 182578]]}, {"verse": 31, "start": 183549, "end": 191595, "text": "Cuando vino sobre ellos el furor de Dios, y mató los más robustos de ellos, y derribó los escogidos de Israel.", "words": [[0, 183549], [7, 183732], [12, 184012], [18, 184352], [24, 184712], [27, 184932], [33, 185352], [36, 185512], [42, 185832], [44, 186312], [49, 186692], [53, 186852], [57, 187132], [66, 188212], [69, 188372], [76, 188692], [78, 189072], [86, 189912], [90, 190052], [100, 190712], [103, 190872]]}, {"verse": 32, "start": 191945, "end": 196437, "text": "Con todo esto pecaron aún, y no dieron crédito a sus maravillas.", "words": [[0, 191945], [4, 192070], [9, 192330], [14, 192590], [22, 193250], [27, 193510], [29, 194010], [32, 194170], [39, 194430], [47, 195150], [49, 195290], [53, 195430]]}, {"verse": 33, "start": 196787, "end": 201498, "text": "Consumió por tanto en nada sus días, y sus años en la tribulación.", "words": [[0, 196787], [9, 197391], [13, 197571], [19, 197911], [22, 198151], [27, 198491], [31, 198771], [37, 199111], [39, 199411], [43, 199591], [48, 199951], [51, 200336], [54, 200476]]}, {"verse": 34, "start": 201848, "end": 207938, "text": "Si los mataba, entonces buscaban a Dios; entonces se volvían solícitos en busca suya.", "words": [[0, 201848], [3, 201991], [7, 202111], [15, 202511], [24, 202891], [33, 203531], [35, 203631], [41, 204387], [50, 205049], [53, 205629], [61, 206069], [71, 206809], [74, 207009], [80, 207229]]}, {"verse": 35, "start": 208288, "end": 214086, "text": "Y se acordaban que Dios era su refugio, y el Dios Alto su redentor.", "words": [[0, 208288], [2, 208398], [5, 208518], [15, 209138], [19, 209338], [24, 209638], [28, 210018], [31, 210238], [40, 211038], [42, 211458], [45, 211598], [50, 211838], [55, 212918], [58, 213058]]}, {"verse": 36, "start": 214436, "end": 218370, "text": "Pero le halagaban con su boca, y con su lengua le mentían:", "words": [[0, 214436], [5, 214580], [8, 214980], [18, 215380], [22, 215540], [25, 215780], [31, 216160], [33, 216740], [37, 216920], [40, 217100], [47, 217480], [50, 217600]]}, {"verse": 37, "start": 218720, "end": 224344, "text": "Pues sus corazones no eran rectos con él, ni estuvieron firmes en su pacto.", "words": [[0, 218720], [5, 218924], [9, 219484], [19, 220184], [22, 220524], [27, 220784], [34, 221364], [38, 221604], [42, 221984], [45, 222364], [56, 222844], [63, 223424], [66, 223584], [69, 223764]]}, {"verse": 38, "start": 224694, "end": 233903, "text": "Pero él misericordioso, perdonaba la maldad, y no los destruía: y abundó para apartar su ira, y no despertó todo su enojo.", "words": [[0, 224694], [5, 224879], [8, 225319], [24, 226339], [34, 226779], [37, 226939], [45, 227399], [47, 227839], [50, 228019], [54, 228179], [64, 229355], [66, 229481], [73, 229941], [78, 230141], [86, 230801], [89, 231081], [94, 231501], [96, 231921], [99, 232081], [108, 232781], [113, 233001], [116, 233261]]}, {"verse": 39, "start": 234253, "end": 238255, "text": "Y se acordó que eran carne; soplo que va y no vuelve.", "words": [[0, 234253], [2, 234361], [5, 234481], [12, 234941], [16, 235061], [21, 235241], [28, 236101], [34, 236723], [38, 236883], [41, 237163], [43, 237503], [46, 237643]]}, {"verse": 40, "start": 238605, "end": 243913, "text": "¡Cuántas veces lo irritaron en el desierto, lo enojaron en la soledad!", "words": [[0, 238605], [9, 238948], [15, 239408], [18, 239748], [28, 240408], [31, 240608], [34, 240748], [44, 241888], [47, 242008], [56, 242888], [59, 243048], [62, 243188]]}, {"verse": 41, "start": 244263, "end": 249234, "text": "Y volvían, y tentaban a Dios, y ponían límite al Santo de Israel.", "words": [[0, 244263], [2, 244411], [11, 244971], [13, 245391], [22, 245911], [24, 246031], [30, 246271], [32, 246891], [39, 247251], [46, 247871], [49, 247991], [55, 248311], [58, 248551]]}, {"verse": 42, "start": 249584, "end": 254284, "text": "No se acordaron de su mano, del día que los redimió de angustia;", "words": [[0, 249584], [3, 249771], [6, 249931], [16, 250571], [19, 250751], [22, 250911], [28, 251331], [32, 252011], [36, 252291], [40, 252671], [44, 253051], [52, 253431], [55, 253531]]}, {"verse": 43, "start": 254634, "end": 259772, "text": "Cuando puso en Egipto sus señales, y sus maravillas en el campo de Zoán;", "words": [[0, 254634], [7, 254891], [12, 255351], [15, 255451], [22, 255991], [26, 256191], [35, 256991], [37, 257191], [41, 257331], [52, 258071], [55, 258391], [58, 258511], [64, 258851], [67, 259335]]}, {"verse": 44, "start": 260122, "end": 265187, "text": "Y volvió sus ríos en sangre, y sus corrientes, porque no bebiesen.", "words": [[0, 260122], [2, 260244], [9, 260664], [13, 260824], [18, 261304], [21, 261504], [29, 262064], [31, 262584], [35, 262744], [47, 263464], [54, 264004], [57, 264264]]}, {"verse": 45, "start": 265537, "end": 271614, "text": "Envió entre ellos una mezcla de moscas que los comían, y ranas que los destruyeron.", "words": [[0, 265537], [6, 265975], [12, 266315], [18, 266675], [22, 266915], [29, 267455], [32, 267595], [39, 268055], [43, 268215], [47, 268375], [55, 268955], [57, 269475], [63, 270095], [67, 270255], [71, 270455]]}, {"verse": 46, "start": 271964, "end": 276923, "text": "dio también al pulgón sus frutos, y sus trabajos a la langosta.", "words": [[0, 271964], [4, 272171], [12, 272631], [15, 272951], [22, 273491], [26, 273731], [34, 274351], [36, 275031], [40, 275211], [49, 275871], [51, 275971], [54, 276071]]}, {"verse": 47, "start": 277273, "end": 281762, "text": "Sus viñas destruyó con granizo, y sus higuerales con piedra;", "words": [[0, 277273], [4, 277416], [10, 277956], [19, 278716], [23, 278896], [32, 279496], [34, 279996], [38, 280196], [49, 280836], [53, 280976]]}, {"verse": 48, "start": 282112, "end": 286601, "text": "Y entregó al pedrisco sus bestias, y al fuego sus ganados.", "words": [[0, 282112], [2, 282233], [10, 282773], [13, 282893], [22, 283453], [26, 283693], [35, 284313], [37, 284748], [40, 284908], [46, 285188], [50, 285788]]}, {"verse": 49, "start": 286951, "end": 293985, "text": "Envió sobre ellos el furor de su saña, ira y enojo y angustia, con misión de malos ángeles.", "words": [[0, 286951], [6, 287395], [12, 287695], [18, 287975], [21, 288235], [27, 288655], [30, 288908], [33, 289162], [39, 289415], [43, 289968], [45, 290100], [51, 290620], [53, 290840], [63, 291880], [67, 292060], [74, 292540], [77, 292760], [83, 293140]]}, {"verse": 50, "start": 294335, "end": 301880, "text": "Dispuso el camino a su furor; no eximió la vida de ellos de la muerte, sino que entregó su vida a la mortandad.", "words": [[0, 294335], [8, 294965], [11, 295145], [18, 295525], [20, 295785], [23, 295905], [30, 296768], [33, 296974], [40, 297574], [43, 297734], [48, 297974], [51, 298194], [57, 298454], [60, 298614], [63, 298714], [71, 299454], [76, 299634], [80, 299834], [88, 300314], [91, 300454], [96, 300794], [98, 300934], [101, 301433]]}, {"verse": 51, "start": 302230, "end": 307308, "text": "E hirió a todo primogénito en Egipto, las primicias de las fuerzas en las tiendas de Cam.", "words": [[0, 302230], [2, 302566], [8, 302916], [10, 303036], [15, 303216], [27, 304136], [30, 304236], [38, 304696], [42, 304836], [52, 305336], [55, 305476], [59, 305576], [67, 306036], [70, 306216], [74, 306336], [82, 306736], [85, 306836]]}, {"verse": 52, "start": 307658, "end": 313126, "text": "Pero hizo salir a su pueblo como ovejas, y los llevó por el desierto, como un rebaño.", "words": [[0, 307658], [5, 307825], [10, 308105], [16, 308545], [18, 308705], [21, 308825], [28, 309185], [33, 309505], [41, 310005], [43, 310385], [47, 310525], [53, 310925], [57, 311085], [60, 311265], [70, 311845], [75, 312165], [78, 312345]]}, {"verse": 53, "start": 313476, "end": 318981, "text": "Y los guió con seguridad, que no tuvieron miedo; y el mar cubrió a sus enemigos.", "words": [[0, 313476], [2, 313580], [6, 313760], [11, 314060], [15, 314260], [26, 315320], [30, 315480], [33, 315660], [42, 316100], [49, 316943], [51, 317068], [54, 317168], [58, 317408], [65, 317928], [67, 318068], [71, 318188]]}, {"verse": 54, "start": 319331, "end": 324411, "text": "Los metió después en los términos de su santuario, en este monte que ganó su mano derecha.", "words": [[0, 319331], [4, 319479], [10, 319839], [18, 320139], [21, 320379], [25, 320519], [34, 321099], [37, 321179], [40, 321319], [51, 321999], [54, 322159], [59, 322359], [65, 322639], [69, 322899], [74, 323239], [77, 323399], [82, 323679]]}, {"verse": 55, "start": 324761, "end": 334521, "text": "Y echó las naciones de delante de ellos, y les repartió una herencia con cuerdas; e hizo habitar en sus moradas a las tribus de Israel.", "words": [[0, 324761], [2, 325094], [7, 325737], [11, 325917], [20, 326357], [23, 326557], [31, 326997], [34, 327177], [41, 327497], [43, 327917], [47, 328447], [56, 328977], [60, 329197], [69, 329857], [73, 330434], [82, 331205], [84, 331349], [89, 331609], [97, 332069], [100, 332209], [104, 332349], [112, 332889], [114, 333069], [118, 333189], [125, 333649], [128, 333769]]}, {"verse": 56, "start": 334871, "end": 340783, "text": "Mas tentaron y enojaron al Dios Altísimo, y no guardaron sus testimonios;", "words": [[0, 334871], [4, 335171], [13, 335911], [15, 336211], [24, 336851], [27, 337051], [32, 337311], [42, 338331], [44, 338891], [47, 339051], [57, 339611], [61, 339791]]}, {"verse": 57, "start": 341133, "end": 347491, "text": "Sino que se volvieron, y se rebelaron como sus padres: se volvieron como arco engañoso.", "words": [[0, 341133], [5, 341358], [9, 341538], [12, 341698], [23, 342278], [25, 342818], [28, 343268], [38, 343718], [43, 343978], [47, 344178], [55, 345185], [58, 345310], [68, 345810], [73, 346110], [78, 346530]]}, {"verse": 58, "start": 347841, "end": 353117, "text": "Y lo enojaron con sus altos, y lo provocaron a celo con sus esculturas.", "words": [[0, 347841], [2, 347967], [5, 348087], [14, 348747], [18, 348967], [22, 349207], [29, 349947], [31, 350267], [34, 350407], [45, 351107], [47, 351267], [52, 351627], [56, 351807], [60, 352027]]}, {"verse": 59, "start": 353467, "end": 358261, "text": "Lo oyó Dios, y se enojó, y en gran manera aborreció a Israel.", "words": [[0, 353467], [3, 353675], [7, 353975], [13, 354175], [15, 354595], [18, 354735], [25, 355475], [27, 355655], [30, 355815], [35, 356015], [42, 356535], [52, 357415], [54, 357495]]}, {"verse": 60, "start": 358611, "end": 364178, "text": "Dejó por tanto el tabernáculo de Silo, la tienda en que habitó entre los hombres;", "words": [[0, 358611], [5, 359098], [9, 359278], [15, 359698], [18, 359958], [30, 360698], [33, 360918], [39, 361898], [42, 361958], [49, 362398], [52, 362558], [56, 362678], [63, 363058], [69, 363218], [73, 363438]]}, {"verse": 61, "start": 364528, "end": 370245, "text": "Y dio en cautividad su fortaleza, y su gloria en mano del enemigo.", "words": [[0, 364528], [2, 364910], [6, 365210], [9, 365570], [20, 366330], [23, 366650], [34, 367570], [36, 367790], [39, 367950], [46, 368490], [49, 368830], [54, 369190], [58, 369470]]}, {"verse": 62, "start": 370595, "end": 375197, "text": "Entregó también su pueblo a filo de espada, y se airó contra su heredad.", "words": [[0, 370595], [8, 371204], [16, 371524], [19, 371804], [26, 372204], [28, 372404], [33, 372724], [36, 372844], [44, 373364], [46, 373504], [49, 373664], [54, 374004], [61, 374284], [64, 374544]]}, {"verse": 63, "start": 375547, "end": 382316, "text": "El fuego devoró sus jóvenes, y sus vírgenes no fueron alabadas en cantos nupciales.", "words": [[0, 375547], [3, 375890], [9, 376210], [16, 376790], [20, 376970], [29, 377530], [31, 378155], [35, 378335], [44, 378855], [47, 379235], [54, 379515], [63, 380355], [66, 380615], [73, 381235]]}, {"verse": 64, "start": 382666, "end": 387279, "text": "Sus sacerdotes cayeron a espada, y sus viudas no lamentaron.", "words": [[0, 382666], [4, 382791], [15, 383591], [23, 384351], [25, 384471], [33, 385091], [35, 385511], [39, 385711], [46, 385981], [49, 386251]]}, {"verse": 65, "start": 387629, "end": 395675, "text": "Entonces despertó el Señor a la manera del que ha dormido, como un valiente que grita excitado del vino:", "words": [[0, 387629], [9, 388233], [18, 389633], [21, 389973], [27, 390373], [29, 390753], [32, 390873], [39, 391233], [43, 391513], [47, 391713], [50, 391853], [59, 392633], [64, 392973], [67, 393173], [76, 393653], [80, 393913], [86, 394313], [95, 394973], [99, 395173]]}, {"verse": 66, "start": 396025, "end": 401698, "text": "E hirió a sus enemigos en las partes posteriores: les dio perpetua afrenta.", "words": [[0, 396025], [2, 396320], [8, 396650], [10, 396890], [14, 397090], [23, 397670], [26, 397850], [30, 398010], [37, 398370], [50, 399877], [54, 400007], [58, 400287], [67, 401023]]}, {"verse": 67, "start": 402048, "end": 406756, "text": "Y desechó el tabernáculo de José, y no escogió la tribu de Efraín;", "words": [[0, 402048], [2, 402174], [10, 402714], [13, 403124], [25, 403534], [28, 403734], [34, 404094], [36, 404534], [39, 404774], [47, 405314], [50, 405434], [56, 405834], [59, 405974]]}, {"verse": 68, "start": 407106, "end": 412036, "text": "Sino que escogió la tribu de Judá, el monte de Sion, al cual amó.", "words": [[0, 407106], [5, 407367], [9, 407627], [17, 408267], [20, 408537], [26, 408807], [29, 408907], [35, 409547], [38, 409647], [44, 409947], [47, 410167], [53, 411067], [56, 411207], [61, 411447]]}, {"verse": 69, "start": 412386, "end": 418669, "text": "Y edificó su santuario a manera de eminencia, como la tierra que cimentó para siempre.", "words": [[0, 412386], [2, 412531], [10, 413151], [13, 413311], [23, 414131], [25, 414291], [32, 414591], [35, 414831], [46, 415811], [51, 416251], [54, 416411], [61, 416751], [65, 416991], [73, 417651], [78, 417831]]}, {"verse": 70, "start": 419019, "end": 423662, "text": "Y eligió a David su siervo, y lo tomó de las majadas de las ovejas:", "words": [[0, 419019], [2, 419180], [9, 419660], [11, 419760], [17, 420080], [20, 420340], [28, 420920], [30, 421380], [33, 421500], [38, 421900], [41, 421960], [45, 422080], [53, 422620], [56, 422780], [60, 422920]]}, {"verse": 71, "start": 424012, "end": 430294, "text": "De tras las paridas lo trajo, para que apacentase a Jacob su pueblo, y a Israel su heredad.", "words": [[0, 424012], [3, 424140], [8, 424360], [12, 424540], [20, 424980], [23, 425180], [30, 425680], [35, 426160], [39, 426340], [50, 427120], [52, 427240], [58, 427560], [61, 427900], [69, 428320], [71, 428660], [73, 428760], [80, 429300], [83, 429700]]}, {"verse": 72, "start": 430644, "end": 436621, "text": "Y los apacentó con entereza de su corazón; y los pastoreó con la pericia de sus manos.", "words": [[0, 430644], [2, 430768], [6, 430908], [15, 431588], [19, 431998], [28, 432408], [31, 432588], [34, 432728], [43, 433751], [45, 433858], [49, 433978], [58, 434698], [62, 434878], [65, 435038], [73, 435498], [76, 435658], [80, 435778]]}]}