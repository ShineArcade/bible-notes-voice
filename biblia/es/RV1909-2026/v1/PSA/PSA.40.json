{"book": "PSA", "chapter": 40, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 149271, "verses": [{"verse": 1, "start": 300, "end": 8971, "text": "Al Músico principal: Salmo de David. PACIENTEMENTE esperé a Jehová, y se inclinó a mí, y oyó mi clamor.", "words": [[0, 300], [3, 487], [10, 987], [21, 2161], [27, 2699], [30, 2859], [37, 3718], [51, 4444], [58, 5164], [60, 5324], [68, 5884], [70, 6184], [73, 6364], [81, 7084], [83, 7204], [87, 7384], [89, 7964], [93, 8264], [96, 8384]]}, {"verse": 2, "start": 9421, "end": 18688, "text": "Y me hizo sacar de un lago de miseria, del lodo cenagoso; y puso mis pies sobre peña, y enderezó mis pasos.", "words": [[0, 9421], [2, 9545], [5, 9665], [10, 9965], [16, 10305], [19, 10585], [22, 10705], [27, 11025], [30, 11185], [39, 12225], [43, 12945], [48, 13693], [58, 14684], [60, 14829], [65, 15189], [69, 15389], [74, 15729], [80, 16219], [86, 16709], [88, 17189], [97, 17809], [101, 17949]]}, {"verse": 3, "start": 19138, "end": 26936, "text": "Puso luego en mi boca canción nueva, alabanza a nuestro Dios. Verán esto muchos, y temerán, y esperarán en Jehová.", "words": [[0, 19138], [5, 19422], [11, 19682], [14, 19902], [17, 20042], [22, 20282], [30, 20642], [37, 21392], [46, 22142], [48, 22262], [56, 22402], [62, 23399], [68, 23808], [73, 24101], [81, 24395], [83, 24688], [92, 25288], [94, 25688], [104, 26268], [107, 26368]]}, {"verse": 4, "start": 27386, "end": 35165, "text": "Bienaventurado el hombre que puso a Jehová por su confianza, y no mira a los soberbios, ni a los que declinan a la mentira.", "words": [[0, 27911], [15, 28471], [18, 28651], [25, 28951], [29, 29151], [34, 29531], [36, 29651], [43, 30091], [47, 30211], [50, 30411], [61, 31171], [63, 31291], [66, 31431], [71, 31671], [73, 31951], [77, 32111], [88, 32931], [91, 33431], [93, 33531], [97, 33671], [101, 34031], [110, 34391], [112, 34451], [115, 34551]]}, {"verse": 5, "start": 35615, "end": 48057, "text": "Aumentado has tú, oh Jehová Dios mío, tus maravillas; y tus pensamientos para con nosotros, no te los podremos contar: si yo los anuncio y hablo de ellos, no pueden ser enumerados.", "words": [[0, 35740], [10, 36070], [14, 36400], [18, 36725], [21, 37050], [28, 37375], [33, 37700], [38, 37980], [42, 38180], [54, 39862], [56, 39965], [60, 40105], [73, 40905], [78, 41185], [82, 41425], [92, 42245], [95, 42565], [98, 42705], [102, 42805], [111, 43225], [119, 44186], [122, 44330], [125, 44510], [129, 44690], [137, 45170], [139, 45310], [145, 45550], [148, 45710], [155, 46310], [158, 46530], [165, 46850], [169, 47090]]}, {"verse": 6, "start": 48507, "end": 55998, "text": "Sacrificio y ofrenda no te agrada; has abierto mis oídos; holocausto y expiación no has pedido.", "words": [[0, 48967], [11, 49327], [13, 49447], [21, 49947], [24, 50027], [27, 50147], [35, 51035], [39, 51298], [47, 51758], [51, 51958], [58, 53028], [69, 53733], [71, 53913], [81, 54613], [84, 54993], [88, 55213]]}, {"verse": 7, "start": 56448, "end": 62244, "text": "Entonces dije: He aquí, vengo; en el envoltorio del libro está escrito de mí:", "words": [[0, 56448], [9, 56918], [15, 57914], [18, 58024], [24, 58324], [31, 59566], [34, 59714], [37, 59834], [48, 60554], [52, 60654], [58, 61034], [63, 61314], [71, 61654], [74, 61934]]}, {"verse": 8, "start": 62694, "end": 69996, "text": "El hacer tu voluntad, Dios mío, me ha agradado; y tu ley está en medio de mis entrañas.", "words": [[0, 62694], [3, 62876], [9, 63236], [12, 63496], [22, 64416], [27, 64736], [32, 65536], [35, 65676], [38, 65896], [48, 66947], [50, 67069], [53, 67189], [57, 67529], [62, 67949], [65, 68209], [71, 68529], [74, 68789], [78, 68929]]}, {"verse": 9, "start": 70446, "end": 77608, "text": "Anunciado he justicia en grande congregación: he aquí no detuve mis labios, Jehová, tú lo sabes.", "words": [[0, 70446], [10, 70902], [13, 71382], [22, 72002], [25, 72162], [32, 72422], [46, 74186], [49, 74326], [54, 74586], [57, 74826], [64, 75306], [68, 75526], [76, 76126], [84, 76686], [87, 76746], [90, 76906]]}, {"verse": 10, "start": 78058, "end": 88666, "text": "No encubrí tu justicia dentro de mi corazón: tu verdad y tu salvación he dicho: no oculté tu misericordia y tu verdad en gran asamblea.", "words": [[0, 78058], [3, 78528], [11, 78998], [14, 79158], [23, 79858], [30, 80118], [33, 80458], [36, 80558], [45, 81647], [48, 81731], [55, 82111], [57, 82671], [60, 82791], [70, 83531], [73, 83711], [80, 84597], [83, 84924], [90, 85284], [93, 85424], [106, 86344], [108, 86484], [111, 86624], [118, 86964], [121, 87344], [126, 87564]]}, {"verse": 11, "start": 89116, "end": 96566, "text": "Tú, Jehová, no apartes de mí tus misericordias: tu misericordia y tu verdad me guarden siempre.", "words": [[0, 89116], [4, 89516], [12, 90376], [15, 90476], [23, 90996], [26, 91156], [29, 91316], [33, 91476], [48, 93020], [51, 93271], [64, 94131], [66, 94291], [69, 94451], [76, 94791], [79, 95331], [87, 95831]]}, {"verse": 12, "start": 97016, "end": 109428, "text": "Porque me han cercado males hasta no haber cuento: me han alcanzado mis maldades, y no puedo levantar la vista: se han aumentado más que los cabellos de mi cabeza, y mi corazón me falta.", "words": [[0, 97016], [7, 97241], [10, 97461], [14, 97601], [22, 98221], [28, 98841], [34, 99161], [37, 99401], [43, 99621], [51, 100659], [54, 100919], [58, 101059], [68, 101799], [72, 101979], [82, 102719], [84, 102979], [87, 103119], [93, 103379], [102, 103959], [105, 104079], [112, 104966], [115, 105108], [119, 105268], [129, 105868], [133, 106048], [137, 106188], [141, 106328], [150, 106808], [153, 106908], [156, 107028], [164, 107508], [166, 107988], [169, 108128], [177, 108548], [180, 108788]]}, {"verse": 13, "start": 109878, "end": 114704, "text": "Quieras, oh Jehová, librarme; Jehová, apresúrate a socorrerme.", "words": [[0, 109878], [9, 110181], [12, 110521], [20, 110861], [30, 111856], [38, 112656], [49, 113316], [51, 113816]]}, {"verse": 14, "start": 115154, "end": 124503, "text": "Sean avergonzados y confusos a una los que buscan mi vida para cortarla: vuelvan atrás y avergüéncense los que mi mal desean.", "words": [[0, 115154], [5, 115453], [18, 116533], [20, 116733], [29, 117693], [31, 117773], [35, 117853], [39, 117973], [43, 118113], [50, 118473], [53, 118653], [58, 118913], [63, 119133], [73, 120380], [81, 120767], [87, 121147], [89, 121917], [103, 122687], [107, 123027], [111, 123247], [114, 123407], [118, 123667]]}, {"verse": 15, "start": 124953, "end": 129876, "text": "Sean asolados en pago de su afrenta los que me dicen: ¡Ea, ea!", "words": [[0, 124953], [5, 125236], [14, 126076], [17, 126396], [22, 126856], [25, 126996], [28, 127366], [36, 127736], [40, 127856], [44, 128016], [47, 128176], [54, 129289], [59, 129583]]}, {"verse": 16, "start": 130226, "end": 139584, "text": "Gócense y alégrense en ti todos los que te buscan; y digan siempre los que aman tu salvación: Jehová sea enaltecido.", "words": [[0, 130226], [8, 130951], [10, 131211], [20, 131911], [23, 132071], [26, 132231], [32, 132611], [36, 132931], [40, 133071], [43, 133211], [51, 134127], [53, 134226], [59, 134566], [67, 134906], [71, 135146], [75, 135346], [80, 135526], [83, 135746], [94, 137478], [101, 138198], [105, 138918]]}, {"verse": 17, "start": 139934, "end": 148871, "text": "Aunque afligido yo y necesitado, Jehová pensará en mí: mi ayuda y mi libertador eres tú; Dios mío, no te tardes.", "words": [[0, 139934], [7, 140179], [16, 140839], [19, 141059], [21, 141179], [33, 142479], [40, 143239], [48, 143799], [51, 143899], [55, 144554], [58, 144699], [64, 145039], [66, 145259], [69, 145379], [80, 146139], [85, 146439], [89, 147242], [94, 147369], [99, 147969], [102, 148049], [105, 148169]]}]}