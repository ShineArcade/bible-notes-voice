{"book": "MRK", "chapter": 15, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 361690, "verses": [{"verse": 1, "start": 300, "end": 13764, "text": "Y luego por la mañana, habiendo tenido consejo los principales sacerdotes con los ancianos, y con los escribas, y con todo el concilio, llevaron a Jesús atado, y le entregaron a Pilato.", "words": [[0, 300], [2, 444], [8, 664], [12, 924], [15, 1044], [23, 2144], [32, 2644], [39, 2984], [47, 3624], [51, 3744], [63, 4464], [74, 5364], [78, 5584], [82, 5744], [92, 6404], [94, 6544], [98, 6724], [102, 6864], [112, 7664], [114, 8024], [118, 8264], [123, 8524], [126, 8684], [136, 10084], [145, 10584], [147, 10684], [153, 10944], [160, 12168], [162, 12277], [165, 12397], [176, 13077], [178, 13157]]}, {"verse": 2, "start": 14214, "end": 21156, "text": "Y Pilato le preguntó: ¿Eres tú el Rey de los judíos? Y respondiendo él, le dijo: Tú lo dices.", "words": [[0, 14214], [2, 14338], [9, 14798], [12, 14958], [22, 15949], [28, 16136], [31, 16436], [34, 16616], [38, 16836], [41, 16896], [45, 17036], [53, 18094], [55, 18220], [68, 19000], [72, 19240], [75, 19380], [81, 20181], [84, 20308], [87, 20448]]}, {"verse": 3, "start": 21606, "end": 24537, "text": "Y los principales sacerdotes le acusaban mucho.", "words": [[0, 21606], [2, 21682], [6, 21802], [18, 22602], [29, 23362], [32, 23522], [41, 24022]]}, {"verse": 4, "start": 24987, "end": 30989, "text": "Y le preguntó otra vez Pilato, diciendo: ¿No respondes algo? Mira de cuántas cosas te acusan.", "words": [[0, 24987], [2, 25074], [5, 25194], [14, 25754], [19, 25934], [23, 26174], [31, 26654], [41, 27625], [45, 27831], [55, 28391], [61, 29158], [66, 29341], [69, 29541], [77, 30281], [83, 30281], [86, 30421]]}, {"verse": 5, "start": 31339, "end": 36520, "text": "Pero Jesús ni aun con eso respondió; de modo que Pilato se maravillaba.", "words": [[0, 31339], [5, 31505], [11, 32305], [14, 32525], [18, 32765], [22, 33065], [26, 33405], [37, 34340], [40, 34485], [45, 34645], [49, 34865], [56, 35345], [59, 35545]]}, {"verse": 6, "start": 36970, "end": 41247, "text": "Pero en el día de la fiesta les soltaba un preso, el que pidiesen.", "words": [[0, 36970], [5, 37215], [8, 37355], [11, 37475], [15, 37695], [18, 37855], [21, 37995], [28, 38245], [32, 38495], [40, 39035], [43, 39215], [50, 39685], [53, 40155], [57, 40726]]}, {"verse": 7, "start": 41697, "end": 50807, "text": "Y había uno, que se llamaba Barrabás, preso con sus compañeros de motín que habían cometido asesinato durante una revuelta.", "words": [[0, 41697], [2, 41840], [8, 42000], [13, 42460], [17, 42640], [20, 42800], [28, 43340], [38, 44640], [44, 45200], [48, 45380], [52, 45580], [63, 46380], [66, 46480], [72, 46980], [76, 47440], [83, 47720], [92, 48420], [102, 49300], [110, 49620], [114, 49960]]}, {"verse": 8, "start": 51257, "end": 56594, "text": "Y viniendo la multitud, comenzó a pedir hiciese como siempre les había hecho.", "words": [[0, 51257], [2, 51403], [11, 51883], [14, 52023], [24, 52663], [32, 53563], [34, 53623], [40, 53923], [48, 54583], [53, 54843], [61, 55503], [65, 55643], [71, 56043]]}, {"verse": 9, "start": 57044, "end": 61885, "text": "Y Pilato les respondió, diciendo: ¿Queréis que os suelte al Rey de los judíos?", "words": [[0, 57044], [2, 57191], [9, 57691], [13, 57931], [24, 58611], [34, 59635], [43, 59956], [47, 60116], [50, 60256], [57, 60596], [60, 60756], [64, 60976], [67, 61036], [71, 61156]]}, {"verse": 10, "start": 62235, "end": 67361, "text": "Porque conocía que por envidia le habían entregado los principales sacerdotes.", "words": [[0, 62235], [7, 62459], [15, 63119], [19, 63259], [23, 63519], [31, 64139], [34, 64259], [41, 64599], [51, 65299], [55, 65439], [67, 66299]]}, {"verse": 11, "start": 67811, "end": 74484, "text": "Pero los principales sacerdotes incitaron a la multitud, que les soltase antes a Barrabás.", "words": [[0, 67811], [5, 68131], [9, 68311], [21, 69091], [32, 70031], [42, 71071], [44, 71171], [47, 71251], [57, 71911], [61, 72371], [65, 72551], [73, 73131], [79, 73491], [81, 74029]]}, {"verse": 12, "start": 74934, "end": 80494, "text": "Y respondiendo Pilato, les dice otra vez: ¿Qué pues queréis que haga del que llamáis Rey de los judíos?", "words": [[0, 74934], [2, 75370], [15, 75840], [23, 76300], [27, 76480], [32, 76700], [37, 76940], [42, 77710], [47, 77832], [52, 78012], [60, 78432], [64, 78592], [69, 78772], [73, 78932], [77, 79092], [85, 79472], [89, 79652], [92, 79792], [96, 79912]]}, {"verse": 13, "start": 80844, "end": 86979, "text": "Y ellos volvieron a gritar: Crucifícale.", "words": [[0, 80844], [2, 81025], [8, 81365], [18, 82005], [20, 82105], [28, 83018]]}, {"verse": 14, "start": 87329, "end": 100407, "text": "Pero Pilato les decía: ¿Pues qué mal ha hecho? Y ellos daban más voces: Crucifícale.", "words": [[0, 87329], [5, 87534], [12, 88074], [16, 88314], [23, 89376], [29, 89518], [33, 89648], [37, 89778], [40, 91933], [47, 94438], [49, 94602], [55, 94932], [61, 95262], [65, 95764], [72, 96446]]}, {"verse": 15, "start": 100757, "end": 110619, "text": "Y Pilato, queriendo satisfacer al pueblo, les soltó a Barrabás, y entregó a Jesús, después de azotarle, para que fuese crucificado.", "words": [[0, 100757], [2, 100882], [10, 101462], [20, 101962], [31, 102702], [34, 102882], [42, 103882], [46, 104022], [52, 104682], [54, 104902], [64, 105582], [66, 106082], [74, 106562], [76, 106662], [83, 107022], [91, 107762], [94, 108182], [104, 108602], [109, 109082], [113, 109222], [119, 109562]]}, {"verse": 16, "start": 111069, "end": 118609, "text": "Entonces los soldados le llevaron dentro de la sala, es decir, al Pretorio; y reunieron a toda la compañía.", "words": [[0, 111069], [9, 112084], [13, 112264], [22, 112634], [25, 113004], [34, 113404], [41, 113744], [44, 114004], [47, 114124], [53, 114504], [56, 114644], [63, 115084], [66, 115164], [76, 116189], [78, 116315], [88, 116955], [90, 117135], [95, 117375], [98, 117595]]}, {"verse": 17, "start": 119059, "end": 124187, "text": "Y le visten de púrpura; y poniéndole una corona tejida de espinas,", "words": [[0, 119059], [2, 119168], [5, 119268], [12, 119688], [15, 119908], [24, 121107], [26, 121212], [37, 122052], [41, 122252], [48, 122672], [55, 123212], [58, 123352]]}, {"verse": 18, "start": 124637, "end": 128632, "text": "Comenzaron luego a saludarle: ¡Salve, Rey de los judíos!", "words": [[0, 124637], [11, 125201], [17, 125481], [19, 125741], [30, 126905], [38, 127330], [42, 127630], [45, 127730], [49, 127850]]}, {"verse": 19, "start": 128982, "end": 135939, "text": "Y le herían en la cabeza con una caña, y escupían en él, y se arrodillaban ante él en burla.", "words": [[0, 128982], [2, 129143], [5, 129283], [12, 129763], [15, 129943], [18, 130083], [25, 130563], [29, 130843], [33, 131043], [39, 131563], [41, 132023], [50, 132643], [53, 132823], [57, 133163], [59, 133783], [62, 133943], [75, 134723], [80, 135043], [83, 135243], [86, 135343]]}, {"verse": 20, "start": 136389, "end": 145801, "text": "Y cuando se hubieron burlado de él, le quitaron el manto púrpura, y le vistieron sus propios vestidos, y le sacaron para crucificarle.", "words": [[0, 136389], [2, 136495], [9, 136715], [12, 136955], [21, 137235], [29, 137775], [32, 137995], [36, 138675], [39, 138835], [48, 139335], [51, 139475], [57, 139855], [66, 140615], [68, 141055], [71, 141155], [81, 141655], [85, 141935], [93, 142775], [103, 143355], [105, 143735], [108, 143835], [116, 144315], [121, 144575]]}, {"verse": 21, "start": 146251, "end": 156020, "text": "Y cargaron a uno que pasaba, Simón cireneo, padre de Alejandro y de Rufo, que venía del campo, para que llevase su cruz.", "words": [[0, 146251], [2, 146645], [11, 147075], [13, 147295], [17, 147475], [21, 147655], [29, 148215], [35, 149075], [44, 149935], [50, 150235], [53, 150495], [63, 151155], [65, 151375], [68, 151475], [74, 152515], [78, 152655], [84, 153228], [88, 153802], [95, 154375], [100, 154535], [104, 154815], [112, 155095], [115, 155375]]}, {"verse": 22, "start": 156470, "end": 162807, "text": "Y le llevan al lugar de Gólgota, que traducido significa: Lugar de la Calavera.", "words": [[0, 156470], [2, 156707], [5, 156967], [12, 157347], [15, 157547], [21, 157887], [24, 158447], [33, 159007], [37, 159247], [47, 159987], [58, 161341], [64, 161644], [67, 161924], [70, 162044]]}, {"verse": 23, "start": 163257, "end": 167848, "text": "Y le dieron a beber vino mezclado con mirra; pero él no lo tomó.", "words": [[0, 163257], [2, 163362], [5, 163462], [12, 163822], [14, 163962], [20, 164182], [25, 164462], [34, 165082], [38, 165553], [45, 166277], [50, 166441], [53, 166861], [56, 167201], [59, 167361]]}, {"verse": 24, "start": 168298, "end": 175857, "text": "Y cuando le hubieron crucificado, repartieron sus vestidos, echando suertes sobre ellos, qué llevaría cada uno.", "words": [[0, 168298], [2, 168405], [9, 168665], [12, 168985], [21, 169365], [34, 170685], [46, 171385], [50, 171625], [60, 172585], [68, 172995], [76, 173405], [82, 173765], [89, 174505], [93, 174605], [102, 175105], [107, 175305]]}, {"verse": 25, "start": 176307, "end": 180144, "text": "Y era la tercera hora del día cuando le crucificaron.", "words": [[0, 176307], [2, 176492], [6, 176692], [9, 176832], [17, 177472], [22, 177852], [26, 178132], [30, 178392], [37, 178692], [40, 178932]]}, {"verse": 26, "start": 180594, "end": 185477, "text": "Y el título escrito de su causa era: EL REY DE LOS JUDÍOS.", "words": [[0, 180594], [2, 180740], [5, 180880], [12, 181480], [20, 181920], [23, 182240], [26, 182400], [32, 182740], [37, 183671], [40, 183859], [44, 184259], [47, 184459], [51, 184599]]}, {"verse": 27, "start": 185927, "end": 192078, "text": "Y crucificaron con él dos ladrones, uno a su derecha, y el otro a su izquierda.", "words": [[0, 185927], [2, 186076], [15, 186996], [19, 187196], [22, 187396], [26, 187736], [36, 188896], [40, 189176], [42, 189336], [45, 189456], [54, 190156], [56, 190436], [59, 190576], [64, 190836], [66, 191056], [69, 191236]]}, {"verse": 28, "start": 192528, "end": 197487, "text": "Y se cumplió la Escritura, que dice: Y con los inicuos fue contado.", "words": [[0, 192528], [2, 192633], [5, 192753], [13, 193253], [16, 193393], [27, 193953], [31, 194133], [37, 195052], [39, 195292], [43, 195472], [47, 195872], [55, 196272], [59, 196672]]}, {"verse": 29, "start": 197937, "end": 207149, "text": "Y los que pasaban lo insultaban, meneando sus cabezas, y diciendo: ¡Ah! tú que derribas el templo de Dios, y en tres días lo edificas,", "words": [[0, 197937], [2, 198054], [6, 198194], [10, 198354], [18, 198954], [21, 199134], [33, 200374], [42, 201074], [46, 201274], [55, 202194], [57, 202374], [67, 203328], [72, 204004], [75, 204085], [79, 204185], [88, 204585], [91, 204705], [98, 205065], [101, 205125], [107, 205405], [109, 205745], [112, 205845], [117, 206005], [122, 206225], [125, 206425]]}, {"verse": 30, "start": 207599, "end": 210053, "text": "Sálvate a ti mismo, y desciende de la cruz.", "words": [[0, 207599], [8, 207968], [10, 208128], [13, 208168], [20, 208508], [22, 208908], [32, 209328], [35, 209448], [38, 209548]]}, {"verse": 31, "start": 210403, "end": 222273, "text": "Y de esta manera también los principales sacerdotes burlándose de él, decían unos a otros, con los escribas: A otros salvó, a sí mismo no se puede salvar.", "words": [[0, 210403], [2, 210570], [5, 210670], [10, 210910], [17, 211250], [25, 211690], [29, 211890], [41, 212610], [52, 213410], [63, 214610], [66, 214810], [70, 215470], [77, 216130], [82, 216790], [84, 217190], [91, 217590], [95, 218150], [99, 218370], [109, 219576], [111, 219760], [117, 219980], [124, 220440], [126, 220620], [129, 220700], [135, 221100], [138, 221260], [141, 221440], [147, 221640]]}, {"verse": 32, "start": 222723, "end": 232055, "text": "El Cristo, Rey de Israel, descienda ahora de la cruz, para que veamos y creamos. También los que estaban crucificados con él lo insultaban.", "words": [[0, 222723], [3, 222841], [11, 223181], [15, 223481], [18, 223581], [26, 224001], [36, 224861], [42, 225081], [45, 225221], [48, 225341], [54, 225881], [59, 226181], [63, 226341], [70, 226761], [72, 227061], [81, 228614], [89, 228880], [93, 229080], [97, 229220], [105, 229480], [118, 230380], [122, 230620], [125, 230820], [128, 231080]]}, {"verse": 33, "start": 232505, "end": 239227, "text": "Y cuando vino la sexta hora del día, fueron hechas tinieblas sobre toda la tierra hasta la novena hora.", "words": [[0, 232505], [2, 232588], [9, 232768], [14, 233088], [17, 233288], [23, 233708], [28, 233888], [32, 234088], [37, 234448], [44, 234968], [51, 235488], [61, 236148], [67, 236588], [72, 236928], [75, 237148], [82, 237528], [88, 238188], [91, 238388], [98, 238828]]}, {"verse": 34, "start": 239677, "end": 252036, "text": "Y a la novena hora, exclamó Jesús a gran voz, diciendo: Eloi, Eloi, ¿lama sabachthani? que declarado, quiere decir: Dios mío, Dios mío, ¿por qué me has desamparado?", "words": [[0, 239677], [2, 239825], [4, 239905], [7, 240005], [14, 240505], [20, 240805], [28, 241945], [34, 242185], [36, 242445], [41, 242625], [46, 242865], [56, 244650], [62, 245127], [68, 245642], [74, 246156], [87, 246911], [91, 247243], [102, 247613], [109, 247873], [116, 248944], [121, 249221], [126, 249741], [131, 249841], [136, 250361], [141, 250481], [145, 250661], [148, 250821], [152, 251001]]}, {"verse": 35, "start": 252486, "end": 258291, "text": "Y oyéndole unos de los que estaban allí, decían: He aquí, llama a Elías.", "words": [[0, 252486], [2, 252668], [11, 253148], [16, 253628], [19, 253848], [23, 254008], [27, 254168], [35, 254508], [41, 255368], [49, 256582], [52, 256672], [58, 256912], [64, 257312], [66, 257612]]}, {"verse": 36, "start": 258641, "end": 268883, "text": "Y corrió uno, y empapando una esponja en vinagre, y poniéndola en una caña, le dio a beber, diciendo: Dejad, veamos si vendrá Elías a quitarle.", "words": [[0, 258641], [2, 258785], [9, 259225], [14, 259625], [16, 259825], [26, 260445], [30, 260645], [38, 261325], [41, 261445], [50, 262305], [52, 262625], [63, 263305], [66, 263505], [70, 263665], [76, 264505], [79, 264665], [83, 264885], [85, 265185], [92, 265485], [102, 266687], [109, 267046], [116, 267446], [119, 267626], [126, 267906], [132, 268266], [134, 268346]]}, {"verse": 37, "start": 269233, "end": 274118, "text": "Pero Jesús, dando una grande voz, exhaló su último aliento.", "words": [[0, 269233], [5, 269378], [12, 270258], [18, 270558], [22, 270838], [29, 271178], [34, 272098], [41, 272678], [44, 272838], [51, 273278]]}, {"verse": 38, "start": 274568, "end": 279721, "text": "Entonces el velo del templo se rasgó en dos, de alto a bajo.", "words": [[0, 274568], [9, 275295], [12, 275675], [17, 276015], [21, 276175], [28, 276935], [31, 277075], [37, 277595], [40, 277775], [45, 278475], [48, 278715], [53, 279071], [55, 279427]]}, {"verse": 39, "start": 280171, "end": 290489, "text": "Y el centurión que estaba delante de él, viendo que había exhalado su último aliento dando aquel grito, dijo: Verdaderamente este hombre era el Hijo de Dios.", "words": [[0, 280171], [2, 280292], [5, 280432], [15, 281032], [19, 281192], [26, 281492], [34, 281972], [37, 282152], [41, 282512], [48, 283412], [52, 283632], [58, 283912], [67, 284652], [70, 284852], [77, 285272], [85, 285752], [91, 286092], [97, 286452], [104, 286832], [110, 287564], [125, 288443], [130, 288823], [137, 289143], [141, 289483], [144, 289663], [149, 289863], [152, 290003]]}, {"verse": 40, "start": 290839, "end": 301719, "text": "Y también estaban algunas mujeres mirando de lejos; entre las cuales estaban María Magdalena, y María la madre de Jacobo el menor y de José, y Salomé;", "words": [[0, 290839], [2, 290969], [10, 291249], [18, 291749], [26, 292049], [34, 292569], [42, 293109], [45, 293289], [52, 294244], [58, 294511], [62, 294691], [69, 295071], [77, 295831], [83, 296331], [94, 297231], [96, 297651], [102, 297991], [105, 298171], [111, 298451], [114, 298871], [121, 299291], [124, 299411], [130, 299811], [132, 300091], [135, 300191], [141, 300571], [143, 301091]]}, {"verse": 41, "start": 302169, "end": 312323, "text": "Las cuales, estando aún él en Galilea, le habían seguido, y le servían; y otras muchas que juntamente con él habían subido a Jerusalén.", "words": [[0, 302169], [4, 302314], [12, 303034], [20, 303554], [24, 303734], [27, 304134], [30, 304394], [39, 305754], [42, 305854], [49, 306074], [58, 306268], [60, 306462], [63, 306654], [72, 308004], [74, 308464], [80, 308684], [87, 309084], [91, 309304], [102, 309944], [106, 310224], [109, 310444], [116, 310824], [123, 311404], [125, 311484]]}, {"verse": 42, "start": 312773, "end": 319152, "text": "Y cuando fue la tarde, porque era la preparación, es decir, la víspera del sábado,", "words": [[0, 312773], [2, 312878], [9, 313078], [13, 313318], [16, 313458], [23, 314118], [30, 314618], [34, 314938], [37, 315098], [50, 316258], [53, 316478], [60, 317638], [63, 317778], [71, 318338], [75, 318498]]}, {"verse": 43, "start": 319602, "end": 331745, "text": "José de Arimatea, miembro respetado del Consejo, que también esperaba el reino de Dios, vino, y se presentó con valentía ante Pilato, y pidió el cuerpo de Jesús.", "words": [[0, 319602], [5, 319913], [8, 320193], [18, 321133], [26, 321593], [36, 322293], [40, 322473], [49, 323613], [53, 323713], [61, 324033], [70, 324593], [73, 324733], [79, 325113], [82, 325273], [88, 325533], [94, 326693], [96, 326933], [99, 327073], [108, 327653], [112, 327853], [121, 328733], [126, 329073], [134, 329713], [136, 330113], [142, 330453], [145, 330573], [152, 330833], [155, 331093]]}, {"verse": 44, "start": 332195, "end": 339315, "text": "Y Pilato se maravilló que ya fuese muerto; y haciendo venir al centurión, le preguntó si era ya muerto.", "words": [[0, 332195], [2, 332339], [9, 332819], [12, 333039], [22, 333619], [26, 333739], [29, 333879], [35, 334179], [43, 335084], [45, 335230], [54, 335690], [60, 336010], [63, 336230], [74, 337370], [77, 337570], [86, 338130], [89, 338310], [93, 338490], [96, 338650]]}, {"verse": 45, "start": 339765, "end": 343384, "text": "Y enterado del centurión, dio el cuerpo a José:", "words": [[0, 339765], [2, 339932], [11, 340572], [15, 341022], [26, 341472], [30, 341922], [33, 342372], [40, 342732], [42, 342932]]}, {"verse": 46, "start": 343834, "end": 356039, "text": "El cual compró una sábana, y quitándole, le envolvió en la sábana: y le puso en un sepulcro excavado en una roca; y hizo rodar una piedra a la puerta del sepulcro.", "words": [[0, 343834], [3, 343998], [8, 344178], [15, 344718], [19, 344898], [27, 345438], [29, 345598], [41, 346338], [44, 346838], [53, 347638], [56, 347798], [59, 347938], [67, 348827], [69, 348916], [72, 349016], [77, 349396], [80, 349556], [83, 349676], [92, 350396], [101, 351116], [104, 351236], [108, 351396], [114, 352379], [116, 352544], [121, 352924], [127, 353644], [131, 353784], [138, 354364], [140, 354524], [143, 354624], [150, 354924], [154, 355224]]}, {"verse": 47, "start": 356489, "end": 361290, "text": "Y María Magdalena, y María madre de José, miraban donde era puesto.", "words": [[0, 356489], [2, 356625], [8, 357205], [19, 357785], [21, 357905], [27, 358165], [33, 358565], [36, 358685], [42, 359025], [50, 359925], [56, 360245], [60, 360585]]}]}