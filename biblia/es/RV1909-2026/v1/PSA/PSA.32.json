{"book": "PSA", "chapter": 32, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 88763, "verses": [{"verse": 1, "start": 300, "end": 8703, "text": "Salmo de David: Masquil. BIENAVENTURADO aquel cuyas iniquidades son perdonadas, y borrados sus pecados.", "words": [[0, 300], [6, 893], [9, 1052], [16, 2193], [25, 2834], [40, 3760], [46, 4180], [52, 4620], [64, 5560], [68, 5880], [80, 6740], [82, 6980], [91, 7500], [95, 7962]]}, {"verse": 2, "start": 9053, "end": 16207, "text": "Bienaventurado el hombre a quien no imputa Jehová la iniquidad, y en cuyo espíritu no hay engaño.", "words": [[0, 9109], [15, 10069], [18, 10209], [25, 10489], [27, 10709], [33, 10869], [36, 11209], [43, 11929], [50, 12489], [53, 12569], [64, 13369], [66, 13829], [69, 13969], [74, 14309], [83, 14989], [86, 15189], [90, 15389]]}, {"verse": 3, "start": 16557, "end": 20855, "text": "Mientras callé, se envejecieron mis huesos en mi gemir todo el día.", "words": [[0, 16557], [9, 17055], [16, 17585], [19, 17705], [32, 18405], [36, 18645], [43, 19125], [46, 19305], [49, 19465], [55, 19865], [60, 20105], [63, 20405]]}, {"verse": 4, "start": 21205, "end": 28096, "text": "Porque de día y de noche se agravó sobre mí tu mano; se volvió mi verdor en sequedades de verano. (Selah.)", "words": [[0, 21205], [7, 21433], [10, 21699], [14, 21966], [16, 22066], [19, 22206], [25, 22486], [28, 22766], [35, 23266], [41, 23506], [44, 23746], [47, 23886], [53, 24703], [56, 24845], [63, 25225], [66, 25365], [73, 25825], [76, 26185], [87, 26545], [90, 26705], [98, 27821]]}, {"verse": 5, "start": 28446, "end": 39457, "text": "Mi pecado te declaré, y no encubrí mi iniquidad. Confesaré, dije, contra mí mis rebeliones a Jehová; y tú perdonaste la maldad de mi pecado. (Selah.)", "words": [[0, 28446], [3, 28575], [10, 29035], [13, 29255], [22, 29895], [24, 30455], [27, 30635], [35, 31195], [38, 31355], [49, 32397], [60, 33020], [66, 33620], [73, 33860], [76, 34140], [80, 34520], [91, 34900], [