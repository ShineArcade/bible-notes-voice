{"book": "JHN", "chapter": 15, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 179703, "verses": [{"verse": 1, "start": 300, "end": 3762, "text": "I am the true vine, and my Father is the vinedresser.", "words": [[0, 300], [2, 524], [5, 704], [9, 824], [14, 1104], [20, 1864], [24, 1964], [27, 2124], [34, 2504], [37, 2804], [41, 3304]]}, {"verse": 2, "start": 4112, "end": 11921, "text": "Every branch in me that bears not fruit he takes away: and every branch that bears fruit, he purges it, that it may bring forth more fruit.", "words": [[0, 4112], [6, 4354], [13, 4714], [16, 4934], [19, 5114], [24, 5314], [30, 5614], [34, 5854], [40, 6134], [43, 6314], [49, 6554], [55, 7274], [59, 7397], [65, 7637], [72, 7997], [77, 8237], [83, 8517], [90, 8897], [93, 9137], [100, 9557], [104, 10077], [109, 10297], [112, 10397], [116, 10517], [122, 10797], [128, 11117], [133, 11437]]}, {"verse": 3, "start": 12271, "end": 15124, "text": "Now you are clean through the word which I have spoken to you.", "words": [[0, 12271], [4, 12629], [8, 12869], [12, 12969], [18, 13249], [26, 13469], [30, 13589], [35, 13829], [41, 14049], [43, 14209], [48, 14289], [55, 14569], [58, 14829]]}, {"verse": 4, "start": 15474, "end": 25412, "text": "Abide in me, and I in you. As the branch cannot bear fruit of itself, unless it abide in the vine; no more can you, unless you abide in me.", "words": [[0, 15474], [6, 15962], [9, 16202], [13, 16442], [17, 16742], [19, 17142], [22, 17442], [27, 18139], [30, 18304], [34, 18444], [41, 18764], [48, 19104], [53, 19504], [59, 19804], [62, 19964], [70, 20444], [77, 20879], [80, 21119], [86, 21419], [89, 21639], [93, 21739], [99, 22359], [102, 22565], [107, 22845], [111, 23105], [116, 23425], [123, 24025], [127, 24305], [133, 24705], [136, 24985]]}, {"verse": 5, "start": 25762, "end": 34322, "text": "I am the vine, you are the branches: He that abides in me, and I in him, the same brings forth much fruit: for without me you can do nothing.", "words": [[0, 25762], [2, 25964], [5, 26104], [9, 26244], [15, 27004], [19, 27124], [23, 27264], [27, 27364], [37, 28305], [40, 28481], [45, 28681], [52, 29081], [55, 29221], [59, 29701], [63, 29801], [65, 30101], [68, 30301], [73, 30881], [77, 31001], [82, 31261], [89, 31541], [95, 31841], [100, 32121], [107, 32829], [111, 32932], [119, 33192], [122, 33452], [126, 33612], [130, 33772], [133, 33912]]}, {"verse": 6, "start": 34672, "end": 43832, "text": "If a man abide not in me, he is cast forth as a branch, and is withered; and men gather them, and cast them into the fire, and they are burned.", "words": [[0, 34672], [3, 34811], [5, 34931], [9, 35231], [15, 35551], [19, 35931], [22, 36211], [26, 36911], [29, 37051], [32, 37191], [37, 37511], [43, 37831], [46, 38071], [48, 38171], [56, 38531], [60, 39031], [63, 39171], [73, 39903], [77, 40083], [81, 40323], [88, 40663], [94, 40943], [98, 41323], [103, 41623], [108, 41883], [113, 42123], [117, 42283], [123, 42983], [127, 43043], [132, 43183], [136, 43303]]}, {"verse": 7, "start": 44182, "end": 50408, "text": "If you abide in me, and my words abide in you, you shall ask what you will, and it shall be done to you.", "words": [[0, 44182], [3, 44341], [7, 44481], [13, 44801], [16, 45061], [20, 45601], [24, 45741], [27, 45921], [33, 46241], [39, 46541], [42, 46801], [47, 47541], [51, 47661], [57, 47841], [61, 48161], [66, 48321], [70, 48521], [76, 49101], [80, 49261], [83, 49381], [89, 49541], [92, 49701], [97, 49921], [100, 50121]]}, {"verse": 8, "start": 50758, "end": 56321, "text": "Herein is my Father glorified, that you bear much fruit; so shall you be my disciples.", "words": [[0, 50758], [7, 51230], [10, 51450], [13, 51630], [20, 51870], [31, 52650], [36, 53090], [40, 53230], [45, 53470], [50, 53710], [57, 54518], [60, 54703], [66, 54923], [70, 55123], [73, 55283], [76, 55483]]}, {"verse": 9, "start": 56671, "end": 60919, "text": "As the Father has loved me, so have I loved you: continue in my love.", "words": [[0, 56671], [3, 56791], [7, 56911], [14, 57231], [18, 57491], [24, 57751], [28, 58271], [31, 58451], [36, 58631], [38, 58771], [44, 59011], [49, 59694], [58, 60018], [61, 60298], [64, 60438]]}, {"verse": 10, "start": 61269, "end": 67974, "text": "If you keep my commandments, you shall abide in my love; even as I have kept my Father’s commandments, and abide in his love.", "words": [[0, 61269], [3, 61391], [7, 61491], [12, 61671], [15, 61851], [29, 62691], [33, 62931], [39, 63131], [45, 63511], [48, 63691], [51, 63851], [57, 64531], [62, 64769], [65, 64969], [67, 65129], [72, 65229], [77, 65449], [80, 65649], [89, 66069], [103, 66509], [107, 66884], [113, 67164], [116, 67424], [120, 67564]]}, {"verse": 11, "start": 68324, "end": 73154, "text": "These things have I spoken to you, that my joy might remain in you, and that your joy might be full.", "words": [[0, 68324], [6, 68448], [13, 68768], [18, 68948], [20, 69048], [27, 69368], [30, 69628], [35, 70068], [40, 70168], [43, 70288], [47, 70548], [53, 70768], [60, 71028], [63, 71268], [68, 71648], [72, 71888], [77, 72008], [82, 72108], [86, 72388], [92, 72568], [95, 72728]]}, {"verse": 12, "start": 73504, "end": 77129, "text": "This is my commandment, That you love one another, as I have loved you.", "words": [[0, 73504], [5, 73695], [8, 73815], [11, 73975], [24, 74875], [29, 75035], [33, 75175], [38, 75415], [42, 75575], [51, 76115], [54, 76235], [56, 76435], [61, 76575], [67, 76755]]}, {"verse": 13, "start": 77479, "end": 81638, "text": "Greater love has no man than this, that a man lay down his life for his friends.", "words": [[0, 77479], [8, 77705], [13, 77965], [17, 78185], [20, 78405], [24, 78645], [29, 78825], [35, 79345], [40, 79565], [42, 79645], [46, 79865], [50, 80105], [55, 80325], [59, 80525], [64, 80785], [68, 80985], [72, 81105]]}, {"verse": 14, "start": 81988, "end": 84855, "text": "You are my friends, if you do whatever I command you.", "words": [[0, 81988], [4, 82130], [8, 82230], [11, 82390], [20, 83130], [23, 83290], [27, 83410], [30, 83570], [39, 83870], [41, 84150], [49, 84410]]}, {"verse": 15, "start": 85205, "end": 95856, "text": "From now on I call you not servants; for the servant knows not what his lord does: but I have called you friends; for all things that I have heard of my Father I have made known to you.", "words": [[0, 85205], [5, 85335], [9, 85595], [12, 85995], [14, 85995], [19, 86215], [23, 86355], [27, 86535], [37, 87529], [41, 87586], [45, 87706], [53, 88006], [59, 88286], [63, 88546], [68, 88726], [72, 88846], [77, 89066], [83, 89896], [87, 90002], [89, 90122], [94, 90262], [101, 90502], [105, 90662], [114, 91515], [118, 91657], [122, 91977], [129, 92437], [134, 92737], [136, 92897], [141, 93077], [147, 93337], [150, 93517], [153, 93697], [160, 94097], [162, 94617], [167, 94777], [172, 95017], [178, 95277], [181, 95537]]}, {"verse": 16, "start": 96206, "end": 108117, "text": "You have not chosen me, but I have chosen you, and ordained you, that you should go and bring forth fruit, and that your fruit should remain: that whatever you shall ask of the Father in my name, he may give it you.", "words": [[0, 96206], [4, 96356], [9, 96496], [13, 96676], [20, 97016], [24, 97756], [28, 98016], [30, 98216], [35, 98356], [42, 98716], [47, 99376], [51, 99476], [60, 99976], [65, 100616], [70, 100736], [74, 100936], [81, 101096], [84, 101356], [88, 101536], [94, 101756], [100, 102076], [107, 102816], [111, 102976], [116, 103116], [121, 103236], [127, 103576], [134, 103796], [142, 104653], [147, 104755], [156, 105055], [160, 105255], [166, 105435], [170, 105735], [173, 105855], [177, 105975], [184, 106295], [187, 106475], [190, 106695], [196, 107175], [199, 107255], [203, 107415], [208, 107635], [211, 107735]]}, {"verse": 17, "start": 108467, "end": 111484, "text": "These things I command you, that you love one another.", "words": [[0, 108467], [6, 108650], [13, 108990], [15, 109210], [23, 109530], [28, 110150], [33, 110330], [37, 110490], [42, 110770], [46, 110970]]}, {"verse": 18, "start": 111834, "end": 115263, "text": "If the world hate you, you know that it hated me before it hated you.", "words": [[0, 111834], [3, 111933], [7, 112073], [13, 112293], [18, 112553], [23, 113153], [27, 113273], [32, 113453], [37, 113613], [40, 113693], [46, 113933], [49, 114173], [56, 114453], [59, 114673], [65, 114893]]}, {"verse": 19, "start": 115613, "end": 124161, "text": "If you were of the world, the world would love his own: but because you are not of the world, but I have chosen you out of the world, therefore the world hates you.", "words": [[0, 115613], [3, 115750], [7, 115910], [12, 116050], [15, 116150], [19, 116270], [26, 116890], [30, 117010], [36, 117270], [42, 117410], [47, 117590], [51, 117770], [56, 118408], [60, 118505], [68, 118805], [72, 119065], [76, 119165], [80, 119345], [83, 119505], [87, 119625], [94, 120265], [98, 120445], [100, 120605], [105, 120725], [112, 121065], [116, 121305], [120, 121565], [123, 121685], [127, 121805], [134, 122465], [144, 122825], [148, 123145], [154, 123425], [160, 123705]]}, {"verse": 20, "start": 124511, "end": 135572, "text": "Remember the word that I said to you, The servant is not greater than his lord. If they have persecuted me, they will also persecute you; if they have kept my saying, they will keep yours also.", "words": [[0, 124511], [9, 124755], [13, 124995], [18, 125255], [23, 125455], [25, 125615], [30, 125855], [33, 126075], [38, 126595], [42, 126715], [50, 127055], [53, 127295], [57, 127495], [65, 127855], [70, 128135], [74, 128315], [80, 129060], [83, 129164], [88, 129344], [93, 129444], [104, 129824], [108, 130584], [113, 130724], [118, 130864], [123, 131124], [133, 131824], [138, 132364], [141, 132484], [146, 132664], [151, 132804], [156, 133004], [159, 133204], [167, 133864], [172, 134224], [177, 134364], [182, 134584], [188, 134884]]}, {"verse": 21, "start": 135922, "end": 140920, "text": "But all these things will they do to you for my name’s sake, because they know not him that sent me.", "words": [[0, 135922], [4, 136021], [8, 136221], [14, 136401], [21, 136781], [26, 137061], [31, 137201], [34, 137401], [37, 137561], [41, 137761], [45, 137921], [48, 138081], [55, 138461], [61, 138861], [69, 139201], [74, 139421], [79, 139641], [83, 139881], [87, 140121], [92, 140361], [97, 140601]]}, {"verse": 22, "start": 141270, "end": 147261, "text": "If I had not come and spoken to them, they had not had sin: but now they have no cloak for their sin.", "words": [[0, 141270], [3, 141411], [5, 141571], [9, 141731], [13, 141891], [18, 142171], [22, 142331], [29, 142651], [32, 142911], [38, 143511], [43, 143691], [47, 143851], [51, 144051], [55, 144271], [60, 145067], [64, 145169], [68, 145449], [73, 145669], [78, 145889], [81, 146069], [87, 146369], [91, 146609], [97, 146769]]}, {"verse": 23, "start": 147611, "end": 150231, "text": "He that hates me hates my Father also.", "words": [[0, 147611], [3, 147792], [8, 148112], [14, 148392], [17, 148832], [23, 149052], [26, 149252], [33, 149552]]}, {"verse": 24, "start": 150581, "end": 159202, "text": "If I had not done among them the works which none other man did, they had not had sin: but now have they both seen and hated both me and my Father.", "words": [[0, 150581], [3, 150699], [5, 150879], [9, 151039], [13, 151219], [18, 151519], [24, 151779], [29, 152099], [33, 152299], [39, 152599], [45, 152899], [50, 153179], [56, 153419], [60, 153679], [65, 154419], [70, 154559], [74, 154719], [78, 154899], [82, 155099], [87, 155863], [91, 155963], [95, 156183], [100, 156383], [105, 156523], [110, 156743], [115, 157103], [119, 157403], [125, 157683], [130, 157943], [133, 158263], [137, 158523], [140, 158703]]}, {"verse": 25, "start": 159552, "end": 165894, "text": "But this comes to pass, that the word might be fulfilled that is written in their law, They hated me without a cause.", "words": [[0, 159552], [4, 159654], [9, 159854], [15, 160114], [18, 160314], [24, 160954], [29, 161394], [33, 161514], [38, 161754], [44, 161954], [47, 162114], [57, 162554], [62, 162874], [65, 163034], [73, 163254], [76, 163434], [82, 163594], [87, 164294], [92, 164454], [98, 164754], [101, 164954], [109, 165234], [111, 165354]]}, {"verse": 26, "start": 166244, "end": 174355, "text": "But when the Comforter is come, whom I will send to you from the Father, even the Spirit of truth, which proceeds from the Father, he shall testify of me:", "words": [[0, 166244], [4, 166369], [9, 166569], [13, 166709], [23, 167209], [26, 167329], [32, 167969], [37, 168169], [39, 168389], [44, 168509], [49, 168769], [52, 168929], [56, 169069], [61, 169269], [65, 169389], [73, 170089], [78, 170289], [82, 170509], [89, 170729], [92, 170889], [99, 171449], [105, 171629], [114, 171989], [119, 172249], [123, 172389], [131, 173069], [134, 173169], [140, 173349], [148, 173729], [151, 174069]]}, {"verse": 27, "start": 174705, "end": 179303, "text": "And you also shall bear witness, because you have been with me from the beginning.", "words": [[0, 174705], [4, 174843], [8, 174983], [13, 175363], [19, 175703], [24, 175963], [33, 176703], [41, 177243], [45, 177503], [50, 177663], [55, 177903], [60, 178083], [63, 178323], [68, 178563], [72, 178703]]}]}