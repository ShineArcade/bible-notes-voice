6797], [81, 77087], [84, 77247]]}, {"verse": 14, "start": 78144, "end": 82982, "text": "Porque no dejará Jehová su pueblo, ni desamparará su heredad;", "words": [[0, 78144], [7, 78348], [10, 78568], [17, 79088], [24, 79448], [27, 79588], [35, 80228], [38, 80608], [50, 81988], [53, 82268]]}, {"verse": 15, "start": 83432, "end": 90442, "text": "Sino que el juicio será vuelto a justicia, y en pos de ella irán todos los rectos de corazón.", "words": [[0, 83432], [5, 83697], [9, 83937], [12, 84057], [19, 84457], [24, 84737], [31, 85157], [33, 85257], [43, 86017], [45, 86477], [48, 86617], [52, 86877], [55, 87157], [60, 87417], [65, 87897], [71, 88277], [75, 88917], [82, 89517], [85, 89677]]}, {"verse": 16, "start": 90892, "end": 96990, "text": "¿Quién se levantará por mí contra los malignos? ¿quién estará por mí contra los que hacen iniquidad?", "words": [[0, 90892], [7, 91176], [10, 91316], [20, 91836], [24, 92036], [27, 92256], [34, 92536], [38, 92736], [48, 93777], [55, 94039], [62, 94459], [66, 94579], [69, 94879], [76, 95179], [80, 95399], [84, 95539], [90, 95839]]}, {"verse": 17, "start": 97440, "end": 102162, "text": "Si no me ayudara Jehová, pronto morara mi alma en el silencio.", "words": [[0, 97440], [3, 97601], [6, 97781], [9, 98121], [17, 98461], [25, 99361], [32, 99641], [39, 100161], [42, 100401], [47, 100761], [50, 101121], [53, 101301]]}, {"verse": 18, "start": 102612, "end": 109033, "text": "Cuando yo decía: Mi pie resbala: tu misericordia, oh Jehová, me sustentaba.", "words": [[0, 102612], [7, 102978], [10, 103198], [17, 104267], [20, 104409], [24, 105102], [33, 106044], [36, 106146], [50, 106826], [53, 107506], [61, 107966], [64, 108046]]}, {"verse": 19, "start": 109483, "end": 116211, "text": "En la multitud de mis pensamientos dentro de mí, tus consolaciones alegraban mi alma.", "words": [[0, 109483], [3, 109644], [6, 109764], [15, 110444], [18, 110624], [22, 110824], [35, 111704], [42, 112044], [45, 112384], [49, 113104], [53, 113384], [67, 114524], [77, 115464], [80, 115664]]}, {"verse": 20, "start": 116661, "end": 122487, "text": "¿Se juntará contigo el trono de iniquidades, que forma agravio en el mandamiento?", "words": [[0, 116661], [4, 116806], [12, 117366], [20, 118026], [23, 118186], [29, 118646], [32, 118806], [45, 119666], [49, 120146], [55, 120546], [63, 121266], [66, 121386], [69, 121506]]}, {"verse": 21, "start": 122937, "end": 128865, "text": "Se juntan en grupos contra la vida del justo, y condenan la sangre inocente.", "words": [[0, 122937], [3, 123077], [10, 123697], [13, 123837], [20, 124177], [27, 124657], [30, 124857], [35, 125067], [39, 125277], [46, 125677], [48, 126257], [57, 127017], [60, 127217], [67, 127637]]}, {"verse": 22, "start": 129315, "end": 133912, "text": "Mas Jehová me ha sido por refugio; y mi Dios por roca de mi confianza.", "words": [[0, 129315], [4, 129521], [11, 129761], [14, 130001], [17, 130141], [22, 130341], [26, 130641], [35, 131787], [37, 131895], [40, 132015], [45, 132255], [49, 132515], [54, 132815], [57, 132955], [60, 133035]]}, {"verse": 23, "start": 134362, "end": 143235, "text": "Y él hará volver sobre ellos su iniquidad, y los destruirá por su propia maldad; los talará Jehová nuestro Dios.", "words": [[0, 134362], [2, 134526], [5, 134746], [10, 135126], [17, 135486], [23, 135946], [29, 136326], [32, 136686], [43, 137406], [45, 138086], [49, 138286], [59, 139186], [63, 139386], [66, 139626], [73, 140006], [81, 141090], [85, 141457], [92, 141863], [99, 142270], [107, 142530]]}]}