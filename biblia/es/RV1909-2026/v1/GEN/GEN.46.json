{"book": "GEN", "chapter": 46, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 280606, "verses": [{"verse": 1, "start": 300, "end": 8296, "text": "Salió Israel con todo lo que tenía, y vino a Beerseba, y ofreció sacrificios al Dios de su padre Isaac.", "words": [[0, 300], [6, 688], [13, 1188], [17, 1528], [22, 1868], [25, 2088], [29, 2488], [36, 2888], [38, 3168], [43, 3428], [45, 4016], [55, 4603], [57, 4683], [65, 5283], [77, 6223], [80, 6423], [85, 6683], [88, 6923], [91, 7063], [97, 7583]]}, {"verse": 2, "start": 8646, "end": 16427, "text": "Y habló Dios a Israel en visiones de noche, y dijo: Jacob, Jacob. Y él respondió: Aquí estoy.", "words": [[0, 8646], [2, 8950], [8, 9290], [13, 9430], [15, 9670], [22, 10150], [25, 10350], [34, 10850], [37, 10970], [44, 11770], [46, 12010], [52, 13107], [59, 13467], [66, 14332], [68, 14514], [71, 14654], [82, 15649], [87, 15873]]}, {"verse": 3, "start": 16707, "end": 24147, "text": "Y dijo: Yo soy Dios, el Dios de tu padre; no temas de descender a Egipto, porque yo te pondré allí en gran nación.", "words": [[0, 16707], [2, 16835], [8, 17557], [11, 17705], [15, 17885], [21, 18445], [24, 18505], [29, 18685], [32, 18865], [35, 18985], [42, 20010], [45, 20127], [51, 20447], [54, 20667], [64, 21127], [66, 21247], [74, 21927], [81, 22287], [84, 22467], [87, 22607], [94, 23007], [99, 23247], [102, 23387], [107, 23547]]}, {"verse": 4, "start": 24738, "end": 31469, "text": "Yo descenderé contigo a Egipto, y yo también te haré volver: y José pondrá su mano sobre tus ojos.", "words": [[0, 24738], [3, 25006], [14, 25586], [22, 26046], [24, 26126], [32, 26646], [34, 27026], [37, 27146], [45, 27426], [48, 27746], [53, 27946], [61, 28960], [63, 29079], [68, 29359], [75, 29839], [78, 29999], [83, 30279], [89, 30579], [93, 30799]]}, {"verse": 5, "start": 31978, "end": 44045, "text": "Y se levantó Jacob de Beerseba; y tomaron los hijos de Israel a su padre Jacob, y a sus niños, y a sus mujeres, en los carros que Faraón había enviado para llevarlo.", "words": [[0, 31978], [2, 32105], [5, 32225], [13, 32805], [19, 33145], [22, 33747], [32, 34506], [34, 34819], [42, 35219], [46, 35399], [52, 35679], [55, 35859], [62, 36239], [64, 36419], [67, 36539], [73, 36899], [80, 37339], [82, 37704], [84, 37764], [88, 37904], [95, 38324], [97, 38844], [99, 38904], [103, 39064], [112, 39524], [115, 40104], [119, 40244], [126, 40864], [130, 41344], [137, 41824], [143, 42164], [151, 42964], [156, 43244]]}, {"verse": 6, "start": 44395, "end": 54278, "text": "Y tomaron sus ganados, y sus bienes que había adquirido en la tierra de Canaán, y se vinieron a Egipto, Jacob, y toda su descendencia consigo;", "words": [[0, 44395], [2, 44492], [10, 44932], [14, 45152], [23, 45772], [25, 46127], [29, 46287], [36, 46767], [40, 46887], [46, 47167], [56, 47887], [59, 47987], [62, 48107], [69, 48427], [72, 48667], [80, 49247], [82, 49727], [85, 49847], [94, 50267], [96, 50427], [104, 51247], [111, 51667], [113, 52227], [118, 52447], [121, 52707], [134, 53507]]}, {"verse": 7, "start": 54628, "end": 64402, "text": "Sus hijos, y los hijos de sus hijos consigo; sus hijas, y las hijas de sus hijos, y a toda su descendencia trajo consigo a Egipto.", "words": [[0, 54628], [4, 54828], [11, 55208], [13, 55508], [17, 55688], [23, 56008], [26, 56568], [30, 56808], [36, 57108], [45, 58195], [49, 58360], [56, 58940], [58, 59300], [62, 59480], [68, 59900], [71, 60020], [75, 60220], [82, 60540], [84, 61020], [86, 61140], [91, 61300], [94, 61600], [107, 62480], [113, 63000], [121, 63420], [123, 63720]]}, {"verse": 8, "start": 64752, "end": 74160, "text": "Y estos son los nombres de los hijos de Israel, que entraron en Egipto, Jacob y sus hijos: Rubén, el primogénito de Jacob.", "words": [[0, 64752], [2, 64938], [8, 65158], [12, 65558], [16, 65738], [24, 66218], [27, 66398], [31, 66518], [37, 66838], [40, 67038], [48, 67538], [52, 68138], [61, 68898], [64, 69018], [72, 69698], [78, 69958], [80, 70398], [84, 70618], [91, 71490], [98, 72416], [101, 72516], [113, 73356], [116, 73496]]}, {"verse": 9, "start": 74510, "end": 78819, "text": "Y los hijos de Rubén: Hanoc, y Falú, y Hezrón, y Carmi.", "words": [[0, 74510], [2, 74611], [6, 74731], [12, 74991], [15, 75211], [22, 76380], [29, 76739], [31, 77097], [37, 77455], [39, 77814], [47, 78172], [49, 78531]]}, {"verse": 10, "start": 79169, "end": 86674, "text": "Y los hijos de Simeón: Jemuel, y Jamín, y Ohad, y Jaquín, y Zohar, y Saúl, hijo de la cananea.", "words": [[0, 79169], [2, 79268], [6, 79408], [12, 79667], [15, 79887], [23, 80900], [31, 81273], [33, 81684], [40, 82095], [42, 82506], [48, 82917], [50, 83327], [58, 83738], [60, 84149], [67, 84560], [69, 84971], [75, 85382], [80, 85542], [83, 85742], [86, 85882]]}, {"verse": 11, "start": 87024, "end": 91376, "text": "Y los hijos de Leví: Gersón, y Coat, y Merari.", "words": [[0, 87024], [2, 87346], [6, 87486], [12, 87786], [15, 88026], [21, 88979], [29, 89299], [31, 89579], [37, 90139], [39, 90699]]}, {"verse": 12, "start": 91726, "end": 103152, "text": "Y los hijos de Judá: Er, y Onán, y Sela, y Fares, y Zara: mas Er y Onán, murieron en la tierra de Canaán. Y los hijos de Fares fueron Hezrón y Hamul.", "words": [[0, 91726], [2, 91814], [6, 91954], [12, 92234], [15, 92414], [21, 93119], [25, 95249], [27, 95336], [33, 95423], [35, 95511], [41, 95598], [43, 95685], [50, 95772], [52, 95859], [58, 96147], [62, 96419], [65, 96724], [67, 97029], [73, 97334], [82, 98114], [85, 98394], [88, 98534], [95, 98914], [98, 99414], [106, 100084], [108, 100208], [112, 100348], [118, 100648], [121, 100828], [127, 101268], [134, 101818], [141, 102368], [143, 102788]]}, {"verse": 13, "start": 103502, "end": 108668, "text": "Y los hijos de Isacar: Tola, y Fúa, y Job, y Simrón.", "words": [[0, 103502], [2, 103591], [6, 103731], [12, 104051], [15, 104291], [23, 105228], [29, 105739], [31, 105919], [36, 106819], [38, 107229], [43, 107639], [45, 108182]]}, {"verse": 14, "start": 109018, "end": 113175, "text": "Y los hijos de Zabulón: Sered, y Elón, y Jahleel.", "words": [[0, 109018], [2, 109126], [6, 109266], [12, 109606], [15, 110176], [24, 111291], [31, 111675], [33, 112058], [39, 112442], [41, 112826]]}, {"verse": 15, "start": 113525, "end": 124011, "text": "Estos fueron los hijos de Lea, los que parió a Jacob en Padan-aram, y además su hija Dina: treinta y tres las almas todas de sus hijos e hijas.", "words": [[0, 113525], [6, 113749], [13, 114049], [17, 114249], [23, 114549], [26, 114749], [31, 115349], [35, 115789], [39, 115929], [45, 116349], [47, 116509], [53, 116849], [56, 117209], [68, 118069], [70, 118549], [77, 118849], [80, 119322], [85, 119796], [91, 120667], [99, 120947], [101, 121227], [106, 121507], [110, 121667], [116, 122047], [122, 122327], [125, 122587], [129, 122787], [135, 123067], [137, 123347]]}, {"verse": 16, "start": 124361, "end": 132495, "text": "Y los hijos de Gad: Zifión, y Hagui, y Ezbón, y Suni, y Heri, y Arodi, y Areli.", "words": [[0, 124361], [2, 124661], [6, 124821], [12, 125101], [15, 125421], [20, 126424], [28, 126714], [30, 127204], [37, 127694], [39, 128284], [46, 128874], [48, 129364], [54, 129854], [56, 130304], [62, 130754], [64, 130874], [71, 131714], [73, 131814]]}, {"verse": 17, "start": 132845, "end": 143095, "text": "Y los hijos de Aser: Imna, e Isúa, e Isúi, y Beria, y Sera, hermana de ellos. Los hijos de Beria: Heber, y Malquiel.", "words": [[0, 132845], [2, 132972], [6, 133092], [12, 133392], [15, 134132], [21, 135391], [27, 135766], [29, 136141], [35, 136516], [37, 136891], [43, 137266], [45, 137641], [52, 138016], [54, 138236], [60, 138496], [68, 139036], [71, 139216], [78, 139973], [82, 140391], [88, 140671], [91, 141101], [98, 141900], [105, 142110], [107, 142640]]}, {"verse": 18, "start": 143445, "end": 151816, "text": "Estos fueron los hijos de Zilpa, la que Labán dio a su hija Lea, y parió estos a Jacob; todas dieciséis almas.", "words": [[0, 143445], [6, 143712], [13, 143932], [17, 144132], [23, 144412], [26, 144912], [33, 145412], [36, 145532], [40, 145872], [46, 146212], [50, 146552], [52, 146812], [55, 147125], [60, 147439], [65, 147752], [67, 148092], [73, 148412], [79, 148732], [81, 148952], [88, 149775], [94, 150309], [104, 150879]]}, {"verse": 19, "start": 152166, "end": 156617, "text": "Y los hijos de Raquel, mujer de Jacob: José y Benjamín.", "words": [[0, 152166], [2, 152556], [6, 152696], [12, 152916], [15, 153156], [23, 153716], [29, 154196], [32, 154396], [39, 155168], [44, 155646], [46, 156161]]}, {"verse": 20, "start": 156967, "end": 165485, "text": "Y nacieron a José en la tierra de Egipto Manasés y Efraín, los que le parió Asenat, hija de Potifera, sacerdote de On.", "words": [[0, 156967], [2, 157067], [11, 157427], [13, 157547], [18, 157927], [21, 158227], [24, 158347], [31, 158687], [34, 158967], [41, 159547], [49, 160007], [51, 160267], [59, 161247], [63, 161327], [67, 161467], [70, 161587], [76, 162099], [84, 162612], [89, 162952], [92, 163032], [102, 164112], [112, 164570], [115, 165027]]}, {"verse": 21, "start": 165835, "end": 175502, "text": "Y los hijos de Benjamín fueron Bela, y Bequer y Asbel, y Gera, y Naamán, y Ehi, y Ros y Mupim, y Hupim, y Ard.", "words": [[0, 165835], [2, 165959], [6, 166099], [12, 166379], [15, 166599], [24, 167179], [31, 167439], [37, 168504], [39, 168781], [46, 169057], [48, 169334], [55, 169611], [57, 169887], [63, 170164], [65, 170604], [73, 171111], [75, 171617], [80, 172124], [82, 172324], [86, 172684], [88, 173044], [95, 173551], [97, 174057], [104, 174564], [106, 175044]]}, {"verse": 22, "start": 175852, "end": 182634, "text": "Estos fueron los hijos de Raquel, que nacieron a Jacob: en todas, catorce almas.", "words": [[0, 175852], [6, 176094], [13, 176474], [17, 176694], [23, 176994], [26, 177194], [34, 177754], [38, 177834], [47, 178294], [49, 178474], [56, 180392], [59, 180579], [66, 181089], [74, 181599]]}, {"verse": 23, "start": 182984, "end": 186602, "text": "Y los hijos de Dan: Husim.", "words": [[0, 182984], [2, 183110], [6, 183230], [12, 183490], [15, 183730], [20, 185814]]}, {"verse": 24, "start": 186952, "end": 189845, "text": "Y los hijos de Neftalí: Jahzeel, y Guni, y Jezer, y Silem.", "words": [[0, 187059], [2, 187195], [6, 187332], [12, 187468], [15, 187604], [24, 188154], [33, 188349], [35, 188543], [41, 188737], [43, 188931], [50, 189126], [52, 189320]]}, {"verse": 25, "start": 190195, "end": 198066, "text": "Estos fueron los hijos de Bilha, la que dio Labán a Raquel su hija, y parió estos a Jacob; todas siete almas.", "words": [[0, 190195], [6, 190458], [13, 190758], [17, 190978], [23, 191258], [26, 191718], [33, 192178], [36, 192418], [40, 192558], [44, 192778], [50, 193238], [52, 193518], [59, 193798], [62, 193998], [68, 194658], [70, 194818], [76, 195237], [82, 195655], [84, 196074], [91, 196649], [97, 196936], [103, 197316]]}, {"verse": 26, "start": 198416, "end": 208743, "text": "Todas las personas que vinieron con Jacob a Egipto, descendientes directos de Jacob, sin las mujeres de los hijos de Jacob, todas las personas fueron sesenta y seis.", "words": [[0, 198416], [6, 198680], [10, 198840], [19, 199240], [23, 199460], [32, 199900], [36, 200120], [42, 200460], [44, 200760], [52, 201580], [66, 202520], [75, 203140], [78, 203220], [85, 203620], [89, 204260], [93, 204500], [101, 204900], [104, 205140], [108, 205240], [114, 205500], [117, 205680], [124, 206400], [130, 206580], [134, 206760], [143, 207160], [150, 207571], [158, 207981], [160, 208392]]}, {"verse": 27, "start": 209093, "end": 218778, "text": "Y los hijos de José, que le nacieron en Egipto, dos personas. Todas las almas de la casa de Jacob, que entraron en Egipto, fueron setenta.", "words": [[0, 209093], [2, 209216], [6, 209356], [12, 209636], [15, 209836], [21, 210136], [25, 210356], [28, 210476], [37, 211016], [40, 211196], [48, 211936], [52, 212076], [62, 213180], [68, 213567], [72, 213807], [78, 214287], [81, 214447], [84, 214547], [89, 214847], [92, 215067], [99, 215467], [103, 215947], [112, 216647], [115, 216847], [123, 217447], [130, 218147]]}, {"verse": 28, "start": 219128, "end": 225660, "text": "Y envió a Judá delante de sí a José, para que le viniese a ver a Gosén; y llegaron a la tierra de Gosén.", "words": [[0, 219128], [2, 219252], [8, 219632], [10, 219792], [15, 220092], [23, 220472], [26, 220672], [29, 220832], [31, 220972], [37, 221272], [42, 221667], [46, 221807], [49, 221947], [57, 222407], [59, 222507], [63, 222647], [65, 223050], [72, 223622], [74, 223726], [83, 224206], [85, 224326], [88, 224386], [95, 224866], [98, 225288]]}, {"verse": 29, "start": 226010, "end": 237283, "text": "Y José unció su carro y vino a recibir a Israel su padre a Gosén; y se manifestó a él, y se echó sobre su cuello, y lloró sobre su cuello bastante.", "words": [[0, 226010], [2, 226152], [7, 226432], [13, 227032], [16, 227232], [22, 227652], [24, 228132], [29, 228372], [31, 228492], [39, 228852], [41, 229072], [48, 229552], [51, 229752], [57, 230151], [59, 230550], [66, 231125], [68, 231380], [71, 231500], [81, 232240], [83, 232380], [87, 232960], [89, 233220], [92, 233360], [97, 233700], [103, 233980], [106, 234180], [114, 235120], [116, 235220], [122, 235540], [128, 235780], [131, 236020], [138, 236380]]}, {"verse": 30, "start": 237633, "end": 243954, "text": "Entonces Israel dijo a José: Muera yo ahora, ya que he visto tu rostro, pues aun vives.", "words": [[0, 237633], [9, 238135], [16, 238835], [21, 239415], [23, 239775], [29, 240506], [35, 240825], [38, 241025], [45, 241325], [48, 241545], [52, 241725], [55, 241785], [61, 242045], [64, 242225], [72, 243025], [77, 243125], [81, 243305]]}, {"verse": 31, "start": 244234, "end": 256943, "text": "Y José dijo a sus hermanos, y a la casa de su padre: Subiré y haré saber a Faraón, y le diré: Mis hermanos y la casa de mi padre, que estaban en la tierra de Canaán, han venido a mí;", "words": [[0, 244234], [2, 244397], [7, 244637], [12, 245097], [14, 245257], [18, 245417], [28, 246277], [30, 246797], [32, 246897], [35, 246977], [40, 247297], [43, 247537], [46, 247697], [53, 248615], [60, 249021], [62, 249201], [67, 249441], [73, 249641], [75, 249931], [83, 250221], [85, 250301], [88, 250401], [94, 251042], [98, 251144], [107, 251704], [109, 251804], [112, 251904], [117, 252164], [120, 252344], [123, 252464], [130, 252804], [134, 253044], [142, 253384], [145, 253564], [148, 253684], [155, 253944], [158, 254144], [166, 254624], [170, 254924], [177, 255304], [179, 255444]]}, {"verse": 32, "start": 257293, "end": 264013, "text": "Y los hombres son pastores de ovejas, porque son hombres ganaderos: y han traído sus ovejas y sus vacas, y todo lo que tenían.", "words": [[0, 257293], [2, 257377], [6, 257497], [14, 257777], [18, 258017], [27, 258497], [30, 258677], [38, 259157], [45, 259432], [49, 259672], [57, 259952], [68, 261002], [70, 261121], [74, 261221], [81, 261541], [85, 261701], [92, 262141], [94, 262301], [98, 262461], [105, 262961], [107, 263081], [112, 263241], [115, 263401], [119, 263501]]}, {"verse": 33, "start": 264363, "end": 267717, "text": "Y cuando Faraón os llame y diga: ¿cuál es vuestro oficio?", "words": [[0, 264363], [2, 264448], [9, 264668], [16, 264888], [19, 265108], [25, 265508], [27, 265648], [33, 266252], [39, 266556], [42, 266676], [50, 267056]]}, {"verse": 34, "start": 268067, "end": 280206, "text": "Entonces diréis: Tus siervos se han dedicado a criar ganado desde nuestra juventud hasta ahora, al igual que nuestros padres; a fin de que moréis en la tierra de Gosén, porque los egipcios detestan el oficio de pastor.", "words": [[0, 268067], [9, 268448], [17, 269258], [21, 269359], [29, 269799], [32, 269959], [36, 270039], [45, 270559], [47, 270639], [53, 270879], [60, 271339], [66, 271519], [74, 271799], [83, 272499], [89, 272719], [96, 273259], [99, 273539], [105, 273739], [109, 273939], [118, 274159], [126, 275019], [128, 275144], [132, 275364], [135, 275524], [139, 275624], [146, 276064], [149, 276184], [152, 276304], [159, 276564], [162, 276914], [169, 277264], [176, 277604], [180, 277824], [189, 278364], [198, 278964], [201, 279084], [208, 279424], [211, 279564]]}]}