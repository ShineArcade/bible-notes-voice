{"book": "MAT", "chapter": 16, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 222428, "verses": [{"verse": 1, "start": 300, "end": 6762, "text": "The Pharisees also with the Sadducees came, and tempting desired him that he would show them a sign from heaven.", "words": [[0, 300], [4, 440], [14, 1120], [19, 1440], [24, 1720], [28, 1900], [38, 2600], [44, 3400], [48, 3500], [57, 3840], [65, 4220], [69, 4660], [74, 4860], [77, 5000], [83, 5160], [88, 5420], [93, 5600], [95, 5800], [100, 6040], [105, 6240]]}, {"verse": 2, "start": 7212, "end": 13470, "text": "He answered and said to them, When it is evening, you say, It will be fair weather: for the sky is red.", "words": [[0, 7212], [3, 7333], [12, 7753], [16, 7973], [21, 8233], [24, 8433], [30, 9044], [35, 9169], [38, 9309], [41, 9449], [50, 9949], [54, 10049], [59, 10709], [62, 10849], [67, 10969], [70, 11129], [75, 11409], [84, 12245], [88, 12352], [92, 12452], [96, 12732], [99, 12992]]}, {"verse": 3, "start": 13920, "end": 24470, "text": "And in the morning, It will be foul weather today: for the sky is red and lowring. O you hypocrites, you can discern the face of the sky; but can you not discern the signs of the times?", "words": [[0, 13920], [4, 14041], [7, 14141], [11, 14261], [20, 14901], [23, 14981], [28, 15101], [31, 15241], [36, 15541], [44, 15781], [51, 16700], [55, 16780], [59, 16900], [63, 17200], [66, 17480], [70, 17860], [74, 18275], [83, 19016], [85, 19136], [89, 19256], [101, 19916], [105, 19996], [109, 20136], [117, 20516], [121, 20736], [126, 20996], [129, 21136], [133, 21256], [138, 22116], [142, 22234], [146, 22374], [150, 22514], [154, 22694], [162, 23094], [166, 23294], [172, 23614], [175, 23774], [179, 23854]]}, {"verse": 4, "start": 24920, "end": 35339, "text": "A wicked and adulterous generation seeks after a sign; and there shall no sign be given to it, but the sign of the prophet Jonas. And he left them, and departed.", "words": [[0, 24920], [2, 25173], [9, 25493], [13, 25773], [24, 26353], [35, 26713], [41, 27233], [47, 27633], [49, 27853], [55, 28632], [59, 28777], [65, 28997], [71, 29257], [74, 29497], [79, 29977], [82, 30217], [88, 30437], [91, 30677], [95, 31137], [99, 31377], [103, 31517], [108, 31897], [111, 32057], [115, 32157], [123, 32517], [130, 33637], [134, 33778], [137, 33858], [142, 34118], [148, 34418], [152, 34658]]}, {"verse": 5, "start": 35789, "end": 40132, "text": "And when his disciples were come to the other side, they had forgotten to take bread.", "words": [[0, 35789], [4, 35912], [9, 36052], [13, 36212], [23, 36732], [28, 36972], [33, 37192], [36, 37352], [40, 37512], [46, 37672], [52, 38452], [57, 38572], [61, 38712], [71, 39092], [74, 39372], [79, 39592]]}, {"verse": 6, "start": 40582, "end": 46192, "text": "¶ Then Jesus said to them, Take heed and beware of the leaven of the Pharisees and of the Sadducees.", "words": [[2, 40582], [7, 40788], [13, 41088], [18, 41468], [21, 41648], [27, 42274], [32, 42432], [37, 42792], [41, 43012], [48, 43352], [51, 43492], [55, 43612], [62, 43892], [65, 44012], [69, 44132], [79, 44892], [83, 45052], [86, 45152], [90, 45292]]}, {"verse": 7, "start": 46542, "end": 51593, "text": "And they reasoned among themselves, saying, It is because we have taken no bread.", "words": [[0, 46542], [4, 46683], [9, 46823], [18, 47343], [24, 47483], [36, 48423], [44, 49218], [47, 49324], [50, 49444], [58, 49764], [61, 50044], [66, 50224], [72, 50644], [75, 51044]]}, {"verse": 8, "start": 51943, "end": 59484, "text": "Which when Jesus perceived, he said to them, O you of little faith, why do you reason among yourselves, because you have brought no bread?", "words": [[0, 51943], [6, 52090], [11, 52310], [17, 52590], [28, 53390], [31, 53450], [36, 53670], [39, 53850], [45, 54503], [47, 54670], [51, 54910], [54, 55130], [61, 55350], [68, 56110], [72, 56290], [75, 56430], [79, 56490], [86, 56850], [92, 57110], [104, 57690], [112, 58130], [116, 58370], [121, 58470], [129, 58710], [132, 58910]]}, {"verse": 9, "start": 59934, "end": 65966, "text": "Do you not yet understand, neither remember the five loaves of the five thousand, and how many baskets you took up?", "words": [[0, 59934], [3, 60027], [7, 60147], [11, 60347], [15, 60487], [27, 61567], [35, 61807], [44, 62207], [48, 62407], [53, 62687], [60, 63127], [63, 63207], [67, 63467], [72, 63727], [82, 63987], [86, 64527], [90, 64687], [95, 64847], [103, 65227], [107, 65467], [112, 65607]]}, {"verse": 10, "start": 66416, "end": 70898, "text": "Neither the seven loaves of the four thousand, and how many baskets you took up?", "words": [[0, 66416], [8, 66761], [12, 66981], [18, 67281], [25, 67781], [28, 67881], [32, 68261], [37, 68641], [47, 69021], [51, 69321], [55, 69481], [60, 69641], [68, 70061], [72, 70341], [77, 70521]]}, {"verse": 11, "start": 71348, "end": 79515, "text": "How is it that you do not understand that I spoke it not to you concerning bread, that you should beware of the leaven of the Pharisees and of the Sadducees?", "words": [[0, 71348], [4, 71516], [7, 71756], [10, 71876], [15, 72016], [19, 72136], [22, 72256], [26, 72416], [37, 72976], [42, 73336], [44, 73456], [50, 73736], [53, 73916], [57, 74096], [60, 74316], [64, 74416], [75, 74796], [82, 75732], [87, 75864], [91, 76024], [98, 76204], [105, 76684], [108, 76884], [112, 76984], [119, 77364], [122, 77484], [126, 77584], [136, 78324], [140, 78464], [143, 78584], [147, 78684]]}, {"verse": 12, "start": 79865, "end": 88397, "text": "Then understood they how that he bade them not beware of the leaven of bread, but of the doctrine of the Pharisees and of the Sadducees.", "words": [[0, 79865], [5, 80053], [16, 80613], [21, 80953], [25, 81233], [30, 81433], [33, 81593], [38, 82013], [43, 82173], [47, 82493], [54, 83153], [57, 83333], [61, 83493], [68, 83833], [71, 83993], [78, 84713], [82, 84953], [85, 85073], [89, 85213], [98, 85613], [101, 85853], [105, 85973], [115, 86873], [119, 87113], [122, 87233], [126, 87393]]}, {"verse": 13, "start": 88847, "end": 98349, "text": "¶ When Jesus came into the coasts of Caesarea Philippi, he asked his disciples, saying, Whom do men say that I the Son of man am?", "words": [[2, 88847], [7, 88973], [13, 89273], [18, 89673], [23, 89873], [27, 90013], [34, 90613], [37, 90693], [46, 91273], [56, 92293], [59, 92413], [65, 92713], [69, 92893], [80, 93493], [88, 95141], [93, 95449], [96, 95589], [100, 95849], [104, 96229], [109, 96529], [111, 96989], [115, 97069], [119, 97409], [122, 97569], [126, 97969]]}, {"verse": 14, "start": 98699, "end": 105577, "text": "And they said, Some say that you are John the Baptist: some, Elias; and others, Jeremias, or one of the prophets.", "words": [[0, 98699], [4, 98848], [9, 98968], [15, 99707], [20, 99863], [24, 100143], [29, 100323], [33, 100463], [37, 100583], [42, 100903], [46, 101083], [55, 102003], [61, 102307], [68, 103902], [72, 104057], [80, 104212], [90, 104367], [93, 104567], [97, 104767], [100, 104847], [104, 104967]]}, {"verse": 15, "start": 105927, "end": 108602, "text": "He says to them, But whom say you that I am?", "words": [[0, 105927], [3, 106017], [8, 106217], [11, 106437], [17, 107088], [21, 107192], [26, 107452], [30, 107692], [34, 107892], [39, 108072], [41, 108232]]}, {"verse": 16, "start": 108952, "end": 114826, "text": "And Simon Peter answered and said, You are the Christ, the Son of the living God.", "words": [[0, 108952], [4, 108952], [10, 109378], [16, 109718], [25, 110198], [29, 110458], [35, 111865], [39, 112003], [43, 112143], [47, 112283], [55, 113023], [59, 113143], [63, 113363], [66, 113463], [70, 113583], [77, 113783]]}, {"verse": 17, "start": 115176, "end": 126944, "text": "And Jesus answered and said to him, Blessed are you, Simon Bar-jona: for flesh and blood has not revealed it to you, but my Father which is in heaven.", "words": [[0, 115176], [4, 115340], [10, 115660], [19, 116280], [23, 116480], [28, 116780], [31, 116980], [36, 119451], [44, 119742], [48, 120142], [53, 120702]