{"book": "PSA", "chapter": 71, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 159609, "verses": [{"verse": 1, "start": 300, "end": 5570, "text": "In you, O LORD, do I put my trust: let me never be put to confusion.", "words": [[0, 300], [3, 487], [8, 967], [10, 967], [16, 1747], [19, 1887], [21, 2027], [25, 2287], [28, 2527], [35, 3532], [39, 3689], [42, 3869], [48, 4169], [51, 4389], [55, 4609], [58, 4769]]}, {"verse": 2, "start": 6020, "end": 12205, "text": "Deliver me in your righteousness, and cause me to escape: incline your ear to me, and save me.", "words": [[0, 6020], [8, 6242], [11, 6562], [14, 6742], [19, 6882], [34, 7442], [38, 7962], [44, 8282], [47, 8482], [50, 8642], [58, 9621], [66, 10184], [71, 10404], [75, 10664], [78, 10904], [82, 11124], [86, 11444], [91, 11784]]}, {"verse": 3, "start": 12655, "end": 21312, "text": "Be my strong habitation, to which I may continually resort: you have given commandment to save me; for you are my rock and my fortress.", "words": [[0, 12655], [3, 12766], [6, 12966], [13, 13326], [25, 14486], [28, 14686], [34, 14906], [36, 15066], [40, 15206], [52, 15826], [60, 16840], [64, 16968], [69, 17128], [75, 17328], [87, 17948], [90, 18088], [95, 18328], [99, 19017], [103, 19121], [107, 19361], [111, 19581], [114, 19761], [119, 20141], [123, 20461], [126, 20641]]}, {"verse": 4, "start": 21762, "end": 29321, "text": "Deliver me, O my God, out of the hand of the wicked, out of the hand of the unrighteous and cruel man.", "words": [[0, 21762], [8, 22080], [12, 22440], [14, 22620], [17, 22920], [22, 23980], [26, 24220], [29, 24380], [33, 24540], [38, 24840], [41, 25020], [45, 25140], [53, 25820], [57, 26220], [60, 26380], [64, 26540], [69, 26800], [72, 27020], [76, 27140], [88, 27960], [92, 28160], [98, 28580]]}, {"verse": 5, "start": 29771, "end": 34532, "text": "For you are my hope, O Lord GOD: you are my trust from my youth.", "words": [[0, 29771], [4, 29880], [8, 30120], [12, 30300], [15, 30480], [21, 30980], [23, 31080], [28, 31360], [33, 32369], [37, 32584], [41, 32844], [44, 33044], [50, 33374], [55, 33704], [58, 33944]]}, {"verse": 6, "start": 34982, "end": 43593, "text": "By you have I been held up from the womb: you are he that took me out of my mother’s bowels: my praise shall be continually of you.", "words": [[0, 34982], [3, 35123], [7, 35423], [12, 35663], [14, 35803], [19, 35983], [24, 36203], [27, 36463], [32, 36683], [36, 36823], [42, 37626], [46, 37774], [50, 38014], [53, 38334], [58, 38754], [63, 38934], [66, 39134], [70, 39334], [73, 39434], [76, 39594], [85, 39994], [93, 40945], [96, 41111], [103, 41531], [109, 41951], [112, 42131], [124, 42791], [127, 43131]]}, {"verse": 7, "start": 44043, "end": 48156, "text": "I am as a wonder to many; but you are my strong refuge.", "words": [[0, 44043], [2, 44267], [5, 44427], [8, 44587], [10, 44727], [17, 45027], [20, 45267], [26, 46108], [30, 46215], [34, 46495], [38, 46735], [41, 46915], [48, 47315]]}, {"verse": 8, "start": 48606, "end": 52701, "text": "Let my mouth be filled with your praise and with your honour all the day.", "words": [[0, 48606], [4, 48775], [7, 49015], [13, 49315], [16, 49555], [23, 49855], [28, 50095], [33, 50235], [40, 50635], [44, 50995], [49, 51175], [54, 51425], [61, 51675], [65, 52035], [69, 52195]]}, {"verse": 9, "start": 53151, "end": 58316, "text": "Cast me not off in the time of old age; forsake me not when my strength fails.", "words": [[0, 53151], [5, 53415], [8, 53675], [12, 53895], [16, 54215], [19, 54355], [23, 54455], [28, 54715], [31, 54875], [35, 55035], [40, 55940], [48, 56404], [51, 56564], [55, 56784], [60, 57024], [63, 57184], [72, 57524]]}, {"verse": 10, "start": 58766, "end": 64550, "text": "For my enemies speak against me; and they that lay wait for my soul take counsel together,", "words": [[0, 58766], [4, 58886], [7, 59086], [15, 59526], [21, 59926], [29, 60286], [33, 61042], [37, 61186], [42, 61346], [47, 61586], [51, 61786], [56, 62066], [60, 62266], [63, 62446], [68, 62746], [73, 63006], [81, 63406]]}, {"verse": 11, "start": 65000, "end": 70283, "text": "Saying, God has forsaken him: persecute and take him; for there is none to deliver him.", "words": [[0, 65132], [8, 65557], [12, 65816], [16, 66076], [25, 66596], [30, 67236], [40, 67762], [44, 67922], [49, 68162], [54, 68769], [58, 68876], [64, 69056], [67, 69176], [72, 69416], [75, 69636], [83, 69936]]}, {"verse": 12, "start": 70633, "end": 74587, "text": "O God, be not far from me: O my God, make haste for my help.", "words": [[0, 70688], [2, 70758], [7, 71118], [10, 71178], [14, 71358], [18, 71658], [23, 71878], [27, 72555], [29, 72655], [32, 72855], [37, 73415], [42, 73535], [48, 73975], [52, 74075], [55, 74255]]}, {"verse": 13, "start": 75037, "end": 82617, "text": "Let them be confounded and consumed that are adversaries to my soul; let them be covered with reproach and dishonour that seek my hurt.", "words": [[0, 75037], [4, 75203], [9, 75403], [12, 75563], [23, 76203], [27, 76463], [36, 77003], [41, 77323], [45, 77423], [57, 78083], [60, 78263], [63, 78443], [69, 79269], [73, 79386], [78, 79606], [81, 79766], [89, 80086], [94, 80306], [103, 80926], [107, 81276], [117, 81626], [122, 81766], [127, 81986], [130, 82206]]}, {"verse": 14, "start": 83067, "end": 86781, "text": "But I will hope continually, and will yet praise you more and more.", "words": [[0, 83067], [4, 83172], [6, 83272], [11, 83472], [16, 83712], [29, 84352], [33, 84752], [38, 84932], [42, 85152], [49, 85432], [53, 85812], [58, 86132], [62, 86292]]}, {"verse": 15, "start": 87231, "end": 93169, "text": "My mouth shall show forth your righteousness and your salvation all the day; for I know not the numbers of it.", "words": [[0, 87231], [3, 87379], [9, 87659], [15, 87899], [20, 88119], [26, 88439], [31, 88619], [45, 89139], [49, 89519], [54, 89639], [64, 90199], [68, 90519], [72, 90659], [77, 91432], [81, 91554], [83, 91714], [88, 91914], [92, 92114], [96, 92294], [104, 92614], [107, 92874]]}, {"verse": 16, "start": 93619, "end": 99971, "text": "I will go in the strength of the Lord GOD: I will make mention of your righteousness, even of your only.", "words": [[0, 93619], [2, 93762], [7, 93922], [10, 94122], [13, 94302], [17, 94402], [26, 94742], [29, 94962], [33, 95102], [38, 95342], [43, 96291], [45, 96445], [50, 96625], [55, 96885], [63, 97305], [66, 97565], [71, 97705], [86, 98745], [91, 99045], [94, 99285], [99, 99465]]}, {"verse": 17, "start": 100421, "end": 106397, "text": "O God, you have taught me from my youth: and until now have I declared your wondrous works.", "words": [[0, 100505], [2, 100625], [7, 101165], [11, 101245], [16, 101405], [23, 101665], [26, 101885], [31, 102125], [34, 102405], [41, 103176], [45, 103340], [51, 103660], [55, 104120], [60, 104280], [62, 104440], [71, 104860], [76, 105140], [85, 105740]]}, {"verse": 18, "start": 106847, "end": 117181, "text": "Now also when I am old and grayheaded, O God, forsake me not; until I have showed your strength to this generation, and your power to every one that is to come.", "words": [[0, 106847], [4, 107107], [9, 107707], [14, 107887], [16, 108067], [19, 108207], [23, 108587], [27, 109087], [39, 109587], [41, 109687], [46, 110227], [54, 110727], [57, 110907], [62, 111671], [68, 111947], [70, 112207], [75, 112387], [82, 112667], [87, 112907], [96, 113307], [99, 113547], [104, 113727], [116, 114347], [120, 114867], [125, 115007], [131, 115367], [134, 115560], [140, 115754], [144, 115947], [149, 116407], [152, 116567], [155, 116707]]}, {"verse": 19, "start": 117631, "end": 124287, "text": "Your righteousness also, O God, is very high, who have done great things: O God, who is like to you!", "words": [[0, 117631], [5, 117751], [19, 118271], [25, 118971], [27, 119191], [32, 119731], [35, 119851], [40, 120171], [46, 120591], [50, 120911], [55, 121051], [60, 121271], [66, 121551], [74, 122638], [76, 122748], [81, 123248], [85, 123348], [88, 123508], [93, 123728], [96, 123948]]}, {"ve