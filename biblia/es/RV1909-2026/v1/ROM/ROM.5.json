{"book": "ROM", "chapter": 5, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 176813, "verses": [{"verse": 1, "start": 300, "end": 5894, "text": "Justificados pues por la fe, tenemos paz para con Dios por medio de nuestro Señor Jesucristo:", "words": [[0, 300], [13, 1020], [18, 1340], [22, 1620], [25, 1760], [29, 2260], [37, 2640], [41, 2980], [46, 3260], [50, 3480], [55, 3720], [59, 4040], [65, 4300], [68, 4500], [76, 4660], [82, 5040]]}, {"verse": 2, "start": 6344, "end": 13924, "text": "Por el cual también tenemos entrada por la fe a esta gracia en la cual estamos firmes, y nos gloriamos en la esperanza de la gloria de Dios.", "words": [[0, 6344], [4, 6463], [7, 6543], [12, 6723], [20, 7043], [28, 7463], [36, 7843], [40, 8143], [43, 8263], [46, 8463], [48, 8583], [53, 8803], [60, 9403], [63, 9583], [66, 9683], [71, 9863], [79, 10183], [87, 10943], [89, 11283], [93, 11423], [103, 11903], [106, 12123], [109, 12223], [119, 12723], [122, 12843], [125, 12943], [132, 13303], [135, 13423]]}, {"verse": 3, "start": 14374, "end": 21330, "text": "Y no sólo esto, sino que también nos gloriamos en las tribulaciones, sabiendo que la tribulación produce paciencia;", "words": [[0, 14374], [2, 14472], [5, 14592], [10, 14812], [16, 15632], [21, 15932], [25, 16092], [33, 16412], [37, 16652], [47, 17172], [50, 17392], [54, 17512], [69, 18612], [78, 19132], [82, 19332], [85, 19452], [97, 20052], [105, 20412]]}, {"verse": 4, "start": 21780, "end": 26275, "text": "Y la paciencia, carácter probado; y el carácter probado, esperanza;", "words": [[0, 21780], [2, 21886], [5, 21966], [16, 22866], [25, 23426], [34, 24307], [36, 24425], [39, 24525], [48, 25045], [57, 25485]]}, {"verse": 5, "start": 26725, "end": 34796, "text": "Y la esperanza no avergüenza; porque el amor de Dios está derramado en nuestros corazones por el Espíritu Santo que nos es dado.", "words": [[0, 26725], [2, 26867], [5, 26967], [15, 27487], [18, 27667], [30, 29214], [37, 29445], [40, 29585], [45, 29805], [48, 30005], [53, 30245], [58, 30645], [68, 31285], [71, 31405], [80, 31585], [90, 32425], [94, 32705], [97, 32845], [106, 33405], [112, 33705], [116, 33985], [120, 34145], [123, 34365]]}, {"verse": 6, "start": 35246, "end": 40031, "text": "Porque Cristo, cuando aún éramos débiles, a su tiempo murió por los impíos.", "words": [[0, 35246], [7, 35482], [15, 35882], [22, 36182], [26, 36602], [33, 36942], [42, 37822], [44, 38022], [47, 38142], [54, 38462], [60, 38902], [64, 39082], [68, 39242]]}, {"verse": 7, "start": 40481, "end": 46706, "text": "Ciertamente apenas muere alguno por un justo: con todo podrá ser que alguno se atreviera a morir por el bueno.", "words": [[0, 40481], [12, 41150], [19, 41430], [25, 41870], [32, 42290], [36, 42430], [39, 42530], [46, 43338], [50, 43455], [55, 43775], [61, 44215], [65, 44375], [69, 44555], [76, 44975], [79, 45075], [89, 45575], [91, 45675], [97, 46055], [101, 46195], [104, 46315]]}, {"verse": 8, "start": 47156, "end": 53618, "text": "Pero Dios demuestra su amor para con nosotros, porque siendo aún pecadores, Cristo murió por nosotros.", "words": [[0, 47156], [5, 47313], [10, 47573], [20, 48213], [23, 48353], [28, 48673], [33, 48933], [37, 49173], [47, 49953], [54, 50353], [61, 50733], [65, 50993], [76, 51993], [83, 52313], [89, 52733], [93, 52913]]}, {"verse": 9, "start": 54068, "end": 60075, "text": "Luego mucho más ahora, justificados en su sangre, por él seremos salvos de la ira.", "words": [[0, 54068], [6, 54315], [12, 54655], [16, 54935], [23, 55655], [36, 56355], [39, 56535], [42, 56655], [50, 57375], [54, 57515], [57, 57655], [65, 57975], [72, 58435], [75, 58535], [78, 58655]]}, {"verse": 10, "start": 60525, "end": 70149, "text": "Porque si siendo enemigos, fuimos reconciliados con Dios por la muerte de su Hijo, mucho más, estando reconciliados, seremos salvos por su vida.", "words": [[0, 60525], [7, 60772], [10, 60972], [17, 61332], [27, 61952], [34, 62712], [48, 63572], [52, 63832], [57, 64012], [61, 64312], [64, 64452], [71, 64752], [74, 64952], [77, 65152], [83, 66012], [89, 66172], [94, 66952], [102, 67352], [117, 68612], [125, 68892], [132, 69372], [136, 69592], [139, 69732]]}, {"verse": 11, "start": 70599, "end": 78199, "text": "Y no sólo esto, sino que también nos gloriamos en Dios por el Señor nuestro Jesucristo, por el cual hemos ahora recibido la reconciliación.", "words": [[0, 70599], [2, 70703], [5, 70803], [10, 71023], [16, 71663], [21, 71823], [25, 71983], [33, 72263], [37, 72483], [47, 72963], [50, 73183], [55, 73363], [59, 73663], [62, 73783], [68, 73983], [76, 74283], [88, 75443], [92, 75683], [95, 75803], [100, 75943], [106, 76163], [112, 76443], [121, 77043], [124, 77163]]}, {"verse": 12, "start": 78649, "end": 90246, "text": "Por consiguiente, vino la reconciliación por uno, así como el pecado entró en el mundo por un hombre, y por el pecado la muerte, y la muerte así pasó a todos los hombres, pues que todos pecaron.", "words": [[0, 78649], [4, 78757], [18, 79437], [23, 79657], [26, 79857], [41, 80677], [45, 80897], [50, 81617], [54, 81917], [59, 82197], [62, 82317], [69, 82717], [75, 83057], [78, 83157], [81, 83257], [87, 83517], [91, 83777], [94, 83917], [102, 84197], [104, 84597], [108, 84777], [111, 84877], [118, 85277], [121, 85417], [129, 86258], [131, 86362], [134, 86462], [141, 86842], [145, 87162], [150, 87542], [152, 87762], [158, 88002], [162, 88282], [171, 88982], [176, 89102], [180, 89302], [186, 89542]]}, {"verse": 13, "start": 90696, "end": 95912, "text": "Porque hasta la ley, el pecado estaba en el mundo; pero no se imputa pecado no habiendo ley.", "words": [[0, 90696], [7, 90913], [13, 91173], [16, 91373], [21, 91633], [24, 91913], [31, 92353], [38, 92673], [41, 92853], [44, 92953], [51, 93700], [56, 93840], [59, 94000], [62, 94160], [69, 94580], [76, 95040], [79, 95200], [88, 95540]]}, {"verse": 14, "start": 96362, "end": 106574, "text": "No obstante, reinó la muerte desde Adam hasta Moisés, aun en los que no pecaron a la manera de la rebelión de Adam; el cual es figura del que había de venir.", "words": [[0, 96362], [3, 96541], [13, 97241], [19, 97601], [22, 97721], [29, 98061], [35, 98361], [40, 98781], [46, 99061], [54, 99981], [58, 100381], [61, 100721], [65, 100861], [69, 101041], [72, 101181], [80, 101661], [82, 101741], [85, 101801], [92, 102101], [95, 102281], [98, 102401], [107, 102841], [110, 103001], [116, 103730], [119, 103870], [124, 104090], [127, 104410], [134, 104770], [138, 105110], [142, 105290], [148, 105550], [151, 105730]]}, {"verse": 15, "start": 107024, "end": 119027, "text": "Pero no como el delito, tal fue el don: porque si por el delito de aquel uno murieron los muchos, mucho más abundó la gracia de Dios a los muchos, y el don por la gracia de un hombre, Jesucristo.", "words": [[0, 107024], [5, 107166], [8, 107366], [13, 107626], [16, 107766], [24, 108526], [28, 108726], [32, 108986], [35, 109126], [40, 109824], [47, 110011], [50, 110191], [54, 110411], [57, 110511], [64, 110891], [67, 111031], [73, 111331], [77, 111471], [86, 111931], [90, 112111], [98, 112991], [104, 113311], [108, 113531], [115, 114011], [118, 114111], [125, 114531], [128, 114651], [133, 114851], [135, 115051], [139, 115171], [147, 115591], [149, 116111], [152, 116251], [156, 116431], [160, 116671], [163, 116791], [170, 117191], [173, 117271], [176, 117411], [184, 118168]]}, {"verse": 16, "start": 119477, "end": 129432, "text": "Ni tampoco de la manera que por un pecado, así también el don: porque el juicio a la verdad vino de un pecado para condenación, pero la gracia vino de muchos delitos para justificación.", "words": [[0, 119477], [3, 119573], [11, 119873], [14, 120073], [17, 120173], [24, 120413], [28, 120613], [32, 120813], [35, 120933], [43, 121533], [47, 121693], [55, 122053], [58, 122253], [63, 122950], [70, 123042], [73, 123172], [80, 123672], [82, 123772], [85, 123832], [92, 124172], [97, 124432], [100, 124612], [103, 124692], [110, 125072], [115, 125252], [128, 126232], [133, 126492], [136, 126632], [143, 127052], [148, 127212], [151, 127412], [158, 127612], [166, 128132], [171, 128392]]}, {"verse": 17, "start": 129882, "end": 139737, "text": "Porque, si por un delito reinó la muerte por uno, mucho más reinarán en vida por un Jesucristo los que reciben la abundancia de la gracia, y del don de la justicia.", "words": [[0, 129882], [8, 130093], [11, 130313], [15, 130613], [18, 130753], [25, 131174], [31, 131513], [34, 131693], [41, 132033], [45, 132334], [50, 132894], [56, 133153], [60, 133394], [69, 133993], [72, 134093], [77, 134293], [81, 134614], [84, 134713], [95, 135433], [99, 135633], [103, 135834], [111, 136373], [114, 136513], [125, 137153], [128, 137273], [131, 137394], [139, 138272], [141, 138374], [145, 138514], [149, 138734], [152, 138874], [155, 138974]]}, {"verse": 18, "start": 140187, "end": 151475, "text": "Así que, de la manera que por un delito vino la culpa a todos los hombres para condenación, así por un acto de justicia vino la gracia a todos los hombres para justificación de vida.", "words": [[0, 140187], [4, 140364], [9, 140604], [12, 140664], [15, 140784], [22, 141024], [26, 141244], [30, 141464], [33, 141584], [40, 141924], [45, 142164], [48, 142344], [54, 142704], [56, 142984], [62, 143144], [66, 143364], [74, 143624], [79, 143884], [92, 145792], [96, 146033], [100, 146293], [103, 146453], [108, 146773], [111, 146853], [120, 147913], [125, 148233], [128, 148393], [135, 148893], [137, 149013], [143, 149193], [147, 149433], [155, 149733], [160, 150053], [174, 150833], [177, 151113]]}, {"verse": 19, "start": 151925, "end": 160742, "text": "Porque como por la desobediencia de un hombre los muchos fueron constituidos pecadores, así por la obediencia de uno los muchos serán constituidos justos.", "words": [[0, 151925], [7, 152125], [12, 152365], [16, 152565], [19, 152685], [33, 153445], [36, 153625], [39, 153765], [46, 154025], [50, 154225], [57, 154505], [64, 154885], [77, 155725], [88, 156765], [92, 156985], [96, 157225], [99, 157345], [110, 157945], [113, 158125], [117, 158385], [121, 158585], [128, 158965], [134, 159345], [147, 160085]]}, {"verse": 20, "start": 161192, "end": 167451, "text": "Pero la ley entró para que el pecado creciese; pero cuando el pecado aumentó, la gracia abundó mucho más;", "words": [[0, 161192], [5, 161334], [8, 161494], [12, 161694], [18, 162154], [23, 162314], [27, 162494], [30, 162594], [37, 162934], [47, 164015], [52, 164152], [59, 164392], [62, 164592], [69, 164952], [78, 165832], [81, 165932], [88, 166352], [95, 166732], [101, 166972]]}, {"verse": 21, "start": 167901, "end": 176413, "text": "Para que, de la manera que el pecado reinó para muerte, así también la gracia reine por la justicia para vida eterna por Jesucristo Señor nuestro.", "words": [[0, 167901], [5, 168053], [10, 168253], [13, 168313], [16, 168433], [23, 168653], [27, 168913], [30, 169033], [37, 169413], [43, 169793], [48, 169973], [56, 170873], [60, 171033], [68, 171413], [71, 171593], [78, 171973], [84, 172353], [88, 172533], [91, 172673], [100, 173573], [105, 173873], [110, 174073], [117, 174573], [121, 174753], [132, 175553], [138, 175753]]}]}