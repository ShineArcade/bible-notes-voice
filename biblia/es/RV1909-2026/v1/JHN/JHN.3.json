{"book": "JHN", "chapter": 3, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 268267, "verses": [{"verse": 1, "start": 300, "end": 6444, "text": "Y había un hombre de los fariseos que se llamaba Nicodemo, dirigente de los judíos.", "words": [[0, 300], [2, 427], [8, 627], [11, 947], [18, 1247], [21, 1467], [25, 1627], [34, 2307], [38, 2447], [41, 2587], [49, 3087], [59, 4502], [69, 5262], [72, 5442], [76, 5582]]}, {"verse": 2, "start": 6794, "end": 16683, "text": "Este vino a Jesús de noche, y le dijo: Rabí, sabemos que has venido de Dios por maestro; porque nadie puede hacer estas señales que tú haces, si no está Dios con él.", "words": [[0, 6794], [5, 7019], [10, 7279], [12, 7459], [18, 7679], [21, 7919], [28, 8259], [30, 8639], [33, 8759], [39, 9663], [45, 9883], [53, 10163], [57, 10403], [61, 10523], [68, 10863], [71, 11003], [76, 11203], [80, 11463], [89, 12384], [96, 12565], [102, 12825], [108, 13125], [114, 13445], [120, 13705], [128, 14225], [132, 14405], [135, 14605], [142, 15065], [145, 15545], [148, 15645], [153, 15865], [158, 16065], [162, 16385]]}, {"verse": 3, "start": 16963, "end": 25586, "text": "Respondió Jesús, y le dijo: De cierto, de cierto te digo, que el que no nazca otra vez, no puede ver el reino de Dios.", "words": [[0, 16963], [10, 17523], [17, 17843], [19, 18063], [22, 18203], [28, 19162], [31, 19466], [39, 19770], [42, 20074], [49, 20378], [52, 20558], [58, 20898], [62, 21618], [65, 21738], [69, 21878], [72, 22078], [78, 22478], [83, 22718], [88, 23358], [91, 23758], [97, 24018], [101, 24298], [104, 24438], [110, 24818], [113, 24978]]}, {"verse": 4, "start": 25936, "end": 32625, "text": "Le dice Nicodemo: ¿Cómo puede el hombre nacer siendo viejo? ¿puede entrar otra vez en el vientre de su madre, y nacer?", "words": [[0, 25936], [3, 26157], [8, 26417], [18, 27479], [24, 27639], [30, 27919], [33, 28079], [40, 28239], [46, 28619], [53, 28879], [60, 29625], [67, 29807], [74, 30147], [79, 30347], [83, 30607], [86, 30747], [89, 30847], [97, 31187], [100, 31287], [103, 31427], [110, 31747], [112, 32147]]}, {"verse": 5, "start": 32905, "end": 41990, "text": "Respondió Jesús: De cierto, de cierto te digo, que el que no nazca de agua y del Espíritu, no puede entrar en el reino de Dios.", "words": [[0, 33059], [10, 33479], [17, 34381], [20, 34381], [28, 34381], [31, 34606], [38, 35726], [41, 36046], [47, 36966], [51, 37246], [54, 37426], [58, 37586], [61, 37806], [67, 38246], [70, 38446], [75, 38766], [77, 38926], [81, 39046], [91, 39606], [94, 39726], [100, 40006], [107, 40406], [110, 40646], [113, 40786], [119, 41186], [122, 41366]]}, {"verse": 6, "start": 42340, "end": 48660, "text": "Lo que es nacido de la carne, carne es; y lo que es nacido del Espíritu, espíritu es.", "words": [[0, 42340], [3, 42485], [7, 42645], [10, 42885], [17, 43630], [20, 43790], [23, 43910], [30, 44750], [36, 45210], [40, 45993], [42, 46146], [45, 46266], [49, 46386], [52, 46486], [59, 47006], [63, 47206], [73, 47846], [82, 48366]]}, {"verse": 7, "start": 49010, "end": 54417, "text": "No te maravilles de que te dije: Os es necesario nacer otra vez.", "words": [[0, 49010], [3, 49295], [6, 49495], [17, 50075], [20, 50255], [24, 50315], [27, 50475], [33, 51292], [36, 51672], [39, 52012], [49, 52912], [55, 53492], [60, 53852]]}, {"verse": 8, "start": 54767, "end": 65215, "text": "El viento de donde quiere sopla, y oyes su sonido; pero ni sabes de dónde viene, ni a dónde vaya: así es todo aquel que es nacido del Espíritu.", "words": [[0, 54767], [3, 54949], [10, 55329], [13, 55549], [19, 55749], [26, 56149], [33, 56769], [35, 57179], [40, 57589], [43, 57769], [51, 58712], [56, 58971], [59, 59131], [65, 59451], [68, 59691], [74, 59871], [81, 60262], [84, 60653], [86, 61043], [92, 61434], [98, 62001], [102, 62312], [105, 62512], [110, 62792], [116, 63252], [120, 63372], [123, 63572], [130, 64212], [134, 64392]]}, {"verse": 9, "start": 65565, "end": 69628, "text": "Respondió Nicodemo, y le dijo: ¿Cómo puede esto hacerse?", "words": [[0, 65565], [10, 66252], [20, 66972], [22, 67152], [25, 67252], [31, 68053], [37, 68250], [43, 68630], [48, 68910]]}, {"verse": 10, "start": 69908, "end": 75226, "text": "Respondió Jesús, y le dijo: ¿Tú eres el maestro de Israel, y no sabes esto?", "words": [[0, 69908], [10, 70468], [17, 70788], [19, 71008], [22, 71148], [28, 71836], [32, 71981], [37, 72281], [40, 72501], [48, 73061], [51, 73261], [59, 73801], [61, 74176], [64, 74296], [70, 74576]]}, {"verse": 11, "start": 75576, "end": 84306, "text": "De cierto, de cierto te digo, que lo que sabemos hablamos, y lo que hemos visto, testificamos; y no recibís nuestro testimonio.", "words": [[0, 75800], [3, 76060], [11, 76320], [14, 76580], [21, 76840], [24, 77020], [30, 77340], [34, 77520], [37, 77660], [41, 77780], [49, 78260], [59, 79100], [61, 79340], [64, 79480], [68, 79640], [74, 79860], [81, 80360], [95, 82172], [97, 82314], [100, 82474], [108, 83074], [116, 83334]]}, {"verse": 12, "start": 84656, "end": 91706, "text": "Si os he hablado de cosas terrenales y no creéis, ¿cómo creeréis si os digo las celestiales?", "words": [[0, 84656], [3, 84789], [6, 84955], [9, 85122], [17, 85762], [20, 85902], [26, 86202], [37, 87182], [39, 87442], [42, 87582], [50, 88522], [56, 88842], [65, 89842], [68, 89982], [71, 90122], [76, 90462], [80, 90602]]}, {"verse": 13, "start": 92056, "end": 99205, "text": "Y nadie subió al cielo, sino el que descendió del cielo, el Hijo del hombre, que está en el cielo.", "words": [[0, 92056], [2, 92056], [8, 92478], [14, 93038], [17, 93198], [24, 93638], [29, 94258], [32, 94518], [36, 94658], [46, 95518], [50, 95658], [57, 96218], [60, 96698], [65, 96938], [69, 97158], [77, 97498], [81, 97918], [86, 98158], [89, 98398], [92, 98538]]}, {"verse": 14, "start": 99555, "end": 107544, "text": "Y como Moisés levantó la serpiente en el desierto, así es necesario que el Hijo del hombre sea levantado;", "words": [[0, 99555], [2, 99697], [7, 99997], [14, 100557], [22, 101337], [25, 101457], [35, 102137], [38, 102297], [41, 102417], [51, 103517], [55, 103857], [58, 104117], [68, 104897], [72, 105252], [75, 105452], [80, 105692], [84, 105872], [91, 106192], [95, 106612]]}, {"verse": 15, "start": 107894, "end": 113372, "text": "Para que todo aquel que en él crea, no se pierda, sino que tenga vida eterna.", "words": [[0, 107894], [5, 108057], [9, 108217], [14, 108577], [20, 109177], [24, 109330], [27, 109484], [30, 109637], [36, 110057], [39, 110237], [42, 110397], [50, 111337], [55, 111537], [59, 111737], [65, 112077], [70, 112417]]}, {"verse": 16, "start": 113722, "end": 124575, "text": "Porque de tal manera amó Dios al mundo, que ha dado a su Hijo unigénito, para que todo aquel que en él cree, no se pierda, sino que tenga vida eterna.", "words": [[0, 113722], [7, 113944], [10, 114144], [14, 114404], [21, 114842], [25, 115281], [30, 115719], [33, 115859], [40, 116299], [44, 116739], [47, 116879], [52, 117119], [54, 117259], [57, 117439], [62, 118019], [73, 118599], [78, 119044], [82, 119204], [87, 119464], [93, 119964], [97, 120064], [100, 120244], [103, 120344], [109, 120784], [112, 121404], [115, 121584], [123, 122493], [128, 122773], [132, 122993], [138, 123293], [143, 123653]]}, {"verse": 17, "start": 124925, "end": 131465, "text": "Porque no envió Dios a su Hijo al mundo para que condene al mundo, sino para que el mundo sea salvo por él.", "words": [[0, 124925], [7, 125147], [10, 125427], [16, 125787], [21, 126007], [23, 126187], [26, 126347], [31, 126567], [34, 126747], [40, 127007], [45, 127287], [49, 127447], [57, 128007], [60, 128107], [67, 128527], [72, 128707], [77, 128987], [81, 129167], [84, 129327], [90, 129687], [94, 130127], [100, 130847], [104, 131107]]}, {"verse": 18, "start": 131815, "end": 141529, "text": "El que en él cree, no es condenado; pero el que no cree, ya es condenado, porque no creyó en el nombre del unigénito Hijo de Dios.", "words": [[0, 131815], [3, 132001], [7, 132241], [10, 132501], [13, 132621], [19, 133101], [22, 133681], [25, 133881], [36, 134970], [41, 135102], [44, 135272], [48, 135412], [51, 135592], [57, 136252], [60, 136700], [63, 137147], [74, 137595], [81, 137807], [84, 138047], [90, 138487], [93, 138627], [96, 138767], [103, 139207], [107, 139487], [117, 140407], [122, 140787], [125, 140987]]}, {"verse": 19, "start": 141879, "end": 151938, "text": "Y esta es la condenación: porque la luz vino al mundo, y los hombres amaron más las tinieblas que la luz; porque sus obras eran malas.", "words": [[0, 141879], [2, 142036], [7, 142276], [10, 142396], [13, 142536], [26, 143626], [33, 143870], [36, 144070], [40, 144350], [45, 144810], [48, 145090], [55, 145510], [57, 145725], [61, 145925], [69, 146305], [76, 147225], [80, 147566], [84, 148115], [94, 148665], [98, 148865], [101, 149005], [106, 149740], [113, 149941], [117, 150181], [123, 150641], [128, 151081]]}, {"verse": 20, "start": 152288, "end": 161141, "text": "Porque todo aquel que hace lo malo, aborrece la luz y no viene a la luz, para que sus obras no sean puestas en evidencia.", "words": [[0, 152288], [7, 152512], [12, 152852], [18, 153392], [22, 153512], [27, 153792], [30, 153992], [36, 154692], [45, 155332], [48, 155532], [52, 155792], [54, 156072], [57, 156272], [63, 156632], [65, 156832], [68, 156932], [73, 157692], [78, 157972], [82, 158112], [86, 158292], [92, 158672], [95, 159172], [100, 159432], [108, 160032], [111, 160192]]}, {"verse": 21, "start": 161491, "end": 168324, "text": "Pero el que practica la verdad, viene a la luz, para que sus obras sean manifestadas que son hechas en Dios.", "words": [[0, 161491], [5, 161635], [8, 161815], [12, 162195], [21, 162575], [24, 162735], [32, 163135], [38, 163595], [40, 163795], [43, 163855], [48, 164155], [53, 164670], [57, 164810], [61, 164990], [67, 165390], [72, 165770], [85, 166650], [89, 166830], [93, 167150], [100, 167470], [103, 167750]]}, {"verse": 22, "start": 168674, "end": 175818, "text": "Pasado esto, vino Jesús con sus discípulos a la tierra de Judea; y estaba allí con ellos, y bautizaba.", "words": [[0, 168674], [7, 169058], [13, 169338], [18, 169618], [24, 170118], [28, 170718], [32, 170938], [43, 171618], [45, 171798], [48, 171878], [55, 172178], [58, 172378], [65, 173213], [67, 173464], [74, 173744], [79, 174024], [83, 174304], [90, 174584], [92, 174924]]}, {"verse": 23, "start": 176168, "end": 183918, "text": "Y bautizaba también Juan en Enón junto a Salim, porque había allí muchas aguas; y venían, y eran bautizados.", "words": [[0, 176168], [2, 176274], [12, 176894], [20, 177254], [25, 177674], [28, 177994], [33, 178274], [39, 178574], [41, 178834], [48, 179254], [55, 179754], [61, 180074], [66, 180334], [73, 180594], [80, 181533], [82, 181662], [90, 182122], [92, 182642], [97, 182822]]}, {"verse": 24, "start": 184268, "end": 187306, "text": "Porque Juan no había sido aún puesto en la carcel.", "words": [[0, 184268], [7, 184490], [12, 184810], [15, 185310], [21, 185470], [26, 185830], [30, 186070], [37, 186370], [40, 186570], [43, 186670]]}, {"verse": 25, "start": 187656, "end": 193650, "text": "Y hubo una discusión entre los discípulos de Juan y los judíos acerca de la purificación.", "words": [[0, 187656], [2, 187781], [7, 188021], [11, 188181], [21, 188901], [27, 189161], [31, 189361], [42, 189941], [45, 190101], [50, 190401], [52, 190821], [56, 190941], [63, 191481], [70, 192001], [73, 192301], [76, 192401]]}, {"verse": 26, "start": 194000, "end": 203729, "text": "Y vinieron a Juan, y le dijeron: Rabí, el que estaba contigo del otro lado del Jordán, del cual tú diste testimonio, he aquí bautiza, y todos vienen a él.", "words": [[0, 194000], [2, 194125], [11, 194545], [13, 194685], [19, 194965], [21, 195225], [24, 195325], [33, 196276], [39, 196462], [42, 196649], [46, 196729], [53, 197049], [61, 197569], [65, 197749], [70, 197989], [75, 198249], [79, 198469], [87, 199349], [91, 199449], [96, 199669], [99, 199889], [105, 200229], [117, 201189], [120, 201329], [125, 201549], [134, 202509], [136, 202589], [142, 202829], [149, 203209], [151, 203429]]}, {"verse": 27, "start": 204009, "end": 209472, "text": "Respondió Juan, y dijo: No puede el hombre recibir algo, si no le es dado del cielo.", "words": [[0, 204009], [10, 204653], [16, 204953], [18, 205213], [24, 205928], [27, 206069], [33, 206349], [36, 206549], [43, 206749], [51, 207149], [57, 207869], [60, 208089], [63, 208249], [66, 208389], [69, 208529], [74, 208749], [78, 208969]]}, {"verse": 28, "start": 209822, "end": 215944, "text": "Vosotros mismos me sois testigos que dije: Yo no soy el Cristo, sino que soy enviado delante de él.", "words": [[0, 209822], [9, 210264], [16, 210564], [19, 210844], [24, 211164], [33, 211604], [37, 211804], [43, 212469], [46, 212636], [49, 212756], [53, 213056], [56, 213176], [64, 213956], [69, 214136], [73, 214316], [77, 214496], [85, 215016], [93, 215456], [96, 215636]]}, {"verse": 29, "start": 216294, "end": 226549, "text": "El que tiene la esposa, es el esposo; pero el amigo del esposo, que está en pie y le oye, se goza grandemente de la voz del esposo; así pues, este mi gozo es cumplido.", "words": [[0, 216294], [3, 216426], [7, 216566], [13, 216826], [16, 216986], [24, 217526], [27, 217966], [30, 218106], [38, 218992], [43, 219113], [46, 219233], [52, 219473], [56, 219673], [64, 220173], [68, 220353], [73, 220533], [76, 220733], [80, 220913], [82, 221073], [85, 221133], [90, 221713], [93, 221813], [98, 222093], [110, 222773], [113, 222953], [116, 223053], [120, 223233], [124, 223413], [132, 224297], [136, 224474], [142, 224954], [147, 225181], [150, 225407], [155, 225634], [158, 225834]]}, {"verse": 30, "start": 226899, "end": 229147, "text": "A él conviene crecer, pero a mí menguar.", "words": [[0, 226899], [2, 227025], [5, 227185], [14, 227625], [22, 228225], [27, 228325], [29, 228425], [32, 228815]]}, {"verse": 31, "start": 229497, "end": 238260, "text": "El que de arriba viene, sobre todos es: el que es de la tierra, terreno es, y cosas terrenas habla: el que viene del cielo, sobre todos es.", "words": [[0, 229497], [3, 229618], [7, 229738], [10, 229878], [17, 230118], [24, 230498], [30, 230798], [36, 231118], [40, 231868], [43, 232018], [47, 232178], [50, 232338], [53, 232438], [56, 232538], [64, 232918], [72, 233478], [76, 233818], [78, 234218], [84, 234458], [93, 235158], [100, 235920], [103, 236042], [107, 236162], [113, 236402], [117, 236622], [124, 237022], [130, 237342], [136, 237662]]}, {"verse": 32, "start": 238610, "end": 243108, "text": "Y lo que vio y oyó, esto testifica: y nadie recibe su testimonio.", "words": [[0, 238610], [2, 238714], [5, 238814], [9, 238954], [13, 239274], [15, 239494], [20, 240014], [25, 240274], [36, 241368], [38, 241491], [44, 241691], [51, 242211], [54, 242311]]}, {"verse": 33, "start": 243458, "end": 248889, "text": "El que recibe su testimonio, este confirmó con su sello que Dios es verdadero.", "words": [[0, 243514], [3, 243584], [7, 243724], [14, 244264], [17, 244424], [29, 245764], [34, 245964], [43, 246604], [47, 246744], [50, 246924], [56, 247344], [60, 247524], [65, 247804], [68, 248124]]}, {"verse": 34, "start": 249239, "end": 255534, "text": "Porque el que Dios envió, las palabras de Dios habla: porque no da Dios el Espíritu por medida.", "words": [[0, 249239], [7, 249443], [10, 249603], [14, 249743], [19, 249963], [26, 250923], [30, 251043], [39, 251423], [42, 251663], [47, 252108], [54, 252725], [61, 252931], [64, 253151], [67, 253351], [72, 253551], [75, 253771], [84, 254331], [88, 254491]]}, {"verse": 35, "start": 255884, "end": 259491, "text": "El Padre ama al Hijo, y todas las cosas dio en su mano.", "words": [[0, 255884], [3, 256002], [9, 256422], [13, 256642], [16, 256842], [22, 257142], [24, 257622], [30, 257842], [34, 258102], [40, 258402], [44, 258762], [47, 258942], [50, 259082]]}, {"verse": 36, "start": 259841, "end": 267867, "text": "El que cree en el Hijo, tiene vida eterna; pero el que es incrédulo al Hijo, no verá la vida, sino que la ira de Dios está sobre él.", "words": [[0, 259841], [3, 259962], [7, 260082], [12, 260362], [15, 260522], [18, 260642], [24, 260942], [30, 261402], [35, 261682], [43, 262491], [48, 262626], [51, 262786], [55, 262926], [58, 263126], [68, 263726], [71, 263906], [77, 264226], [80, 264606], [85, 264886], [88, 264986], [94, 265566], [99, 265866], [103, 266066], [106, 266206], [110, 266506], [113, 266606], [118, 266866], [123, 267226], [129, 267506]]}]}