{"book": "ISA", "chapter": 28, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 307992, "verses": [{"verse": 1, "start": 300, "end": 13016, "text": "¡Ay de la corona de soberbia, de los ebrios de Efraín, y de la flor caduca de la hermosura de su gloria, que está sobre la cabeza del valle fértil de los aturdidos del vino!", "words": [[0, 428], [4, 588], [7, 748], [10, 868], [17, 1228], [20, 1428], [30, 2488], [33, 2808], [37, 3198], [44, 3588], [47, 3728], [55, 4468], [57, 5048], [60, 5188], [63, 5308], [68, 5588], [75, 6168], [78, 6348], [81, 6468], [91, 7148], [94, 7308], [97, 7468], [105, 8540], [109, 8661], [114, 8921], [120, 9341], [123, 9541], [130, 10001], [134, 10241], [140, 10561], [147, 11121], [150, 11341], [154, 11461], [164, 12201], [168, 12401]]}, {"verse": 2, "start": 13466, "end": 26775, "text": "He aquí Jehová tiene un fuerte y poderoso: como turbión de granizo y como torbellino trastornador; como ímpetu de recias aguas que inundan, con fuerza derriba a tierra.", "words": [[0, 13628], [3, 13828], [8, 14088], [15, 14568], [21, 14788], [24, 15008], [31, 15428], [33, 15588], [43, 16881], [48, 17066], [56, 17646], [59, 17846], [67, 18506], [69, 19046], [74, 19566], [85, 20086], [99, 21617], [104, 21842], [111, 22622], [114, 22972], [121, 23322], [127, 23822], [131, 23962], [140, 24682], [144, 25102], [151, 25572], [159, 26042], [161, 26262]]}, {"verse": 3, "start": 27225, "end": 32194, "text": "Con los pies será pisoteada la corona de soberbia de los borrachos de Efraín;", "words": [[0, 27225], [4, 27348], [8, 27508], [13, 27788], [18, 28368], [28, 29188], [31, 29348], [38, 29668], [41, 29888], [50, 30408], [53, 30568], [57, 30688], [67, 31368], [70, 31528]]}, {"verse": 4, "start": 32644, "end": 47347, "text": "Y será la flor caduca de la hermosura de su gloria que está sobre la cabeza del valle fértil, como la fruta temprana, la primera del verano, la cual, en viéndola el que la mira, se la traga tan luego como la tiene a mano.", "words": [[0, 32644], [2, 32807], [7, 33027], [10, 33207], [15, 33487], [22, 34027], [25, 34187], [28, 34327], [38, 34947], [41, 35087], [44, 35267], [51, 35727], [55, 35907], [60, 36127], [66, 36427], [69, 36627], [76, 36967], [80, 37247], [86, 37527], [94, 38447], [99, 38747], [102, 38927], [108, 39247], [118, 40487], [121, 40587], [129, 40927], [133, 41207], [141, 41707], [144, 41847], [150, 42853], [153, 43078], [162, 43303], [165, 43528], [169, 43668], [172, 43788], [178, 44068], [181, 44828], [184, 44988], [190, 45368], [194, 45588], [200, 45928], [205, 46268], [208, 46428], [214, 46708], [216, 46848]]}, {"verse": 5, "start": 47797, "end": 55963, "text": "En aquel día Jehová de los ejércitos será por corona de gloria y diadema de hermosura a las reliquias de su pueblo;", "words": [[0, 47797], [3, 47944], [9, 48324], [13, 48524], [20, 49084], [23, 49184], [27, 49364], [37, 50224], [42, 50784], [46, 51064], [53, 51484], [56, 51704], [63, 52224], [65, 52444], [73, 52964], [76, 53104], [86, 53824], [88, 54204], [92, 54364], [102, 55064], [105, 55184], [108, 55344]]}, {"verse": 6, "start": 56413, "end": 64927, "text": "Y por espíritu de juicio al que se sienta en juicio, y por fortaleza a los que harán tornar la batalla hasta la puerta.", "words": [[0, 56413], [2, 56537], [6, 56757], [15, 57477], [18, 57557], [25, 58437], [28, 58737], [32, 58877], [35, 59057], [42, 59617], [45, 59717], [53, 60277], [55, 60757], [59, 60957], [69, 61797], [71, 62057], [75, 62197], [79, 62397], [85, 62657], [92, 63037], [95, 63417], [103, 63897], [109, 64097], [112, 64257]]}, {"verse": 7, "start": 65377, "end": 83651, "text": "Pero también estos erraron con el vino, y con la sidra se entontecieron; el sacerdote y el profeta erraron con la sidra, fueron trastornados del vino, se aturdieron con la sidra, erraron en la visión, tropezaron en el juicio.", "words": [[0, 65377], [5, 65544], [13, 65984], [19, 66464], [27, 67324], [31, 67484], [34, 67684], [40, 68004], [42, 68664], [46, 68884], [49, 69044], [55, 69604], [58, 69784], [73, 71198], [76, 71343], [86, 72143], [88, 72383], [91, 72523], [99, 73153], [107, 73783], [111, 73943], [114, 74143], [121, 75103], [128, 75483], [141, 76543], [145, 76783], [151, 77563], [154, 77683], [165, 78423], [169, 78663], [172, 78883], [179, 79743], [187, 80603], [190, 80743], [193, 80903], [201, 81863], [212, 82503], [215, 82803], [218, 82943]]}, {"verse": 8, "start": 84101, "end": 89930, "text": "Porque todas las mesas están llenas de vómito y suciedad, hasta no haber lugar limpio.", "words": [[0, 84101], [7, 84285], [13, 84565], [17, 84825], [23, 85245], [29, 85545], [36, 85985], [39, 86125], [46, 86765], [48, 86865], [58, 87965], [64, 88245], [67, 88485], [73, 88665], [79, 89005]]}, {"verse": 9, "start": 90380, "end": 99193, "text": "¿A quién se enseñará ciencia, o a quién se hará entender doctrina? ¿A los quitados de la leche? ¿a los arrancados de los pechos?", "words": [[0, 90380], [3, 90550], [9, 90730], [12, 91030], [21, 91690], [30, 92410], [32, 92810], [34, 92910], [40, 93130], [43, 93390], [48, 93590], [57, 93930], [67, 95196], [70, 95446], [74, 95566], [83, 96046], [86, 96186], [89, 96306], [96, 97189], [99, 97335], [103, 97435], [114, 98175], [117, 98315], [121, 98435]]}, {"verse": 10, "start": 99643, "end": 109963, "text": "Porque mandamiento tras mandamiento, mandato sobre mandato, renglón tras renglón, línea sobre línea, un poquito allí, otro poquito allá:", "words": [[0, 99643], [7, 100121], [19, 101001], [24, 101241], [37, 102121], [45, 102641], [51, 102981], [60, 103861], [68, 104741], [73, 105411], [82, 106081], [88, 106501], [94, 106861], [101, 107841], [104, 107961], [112, 108261], [118, 108861], [123, 109061], [131, 109381]]}, {"verse": 11, "start": 110413, "end": 115841, "text": "Porque en lengua de tartamudos, y en extraña lengua hablará a este pueblo,", "words": [[0, 110413], [7, 110714], [10, 111094], [17, 111534], [20, 111674], [32, 112434], [34, 112734], [37, 112894], [45, 113594], [52, 114134], [60, 114674], [62, 114854], [67, 115114]]}, {"verse": 12, "start": 116291, "end": 125731, "text": "A los cuales él dijo: Este es el reposo: dad reposo al cansado; y este es el refrigerio: mas no quisieron oír.", "words": [[0, 116291], [2, 116511], [6, 116611], [13, 116851], [16, 117291], [22, 118267], [27, 118607], [30, 118927], [33, 119107], [41, 120390], [45, 120540], [52, 120970], [55, 121400], [64, 122377], [66, 122543], [71, 122803], [74, 123043], [77, 123163], [89, 124550], [93, 124620], [96, 124760], [106, 125220]]}, {"verse": 13, "start": 126181, "end": 145735, "text": "La palabra pues de Jehová les será mandamiento tras mandamiento, mandato sobre mandato, renglón tras renglón, línea sobre línea, un poquito allí, otro poquito allá; que vayan y caigan de espaldas, y sean quebrantados, y enlazados, y presos.", "words": [[0, 126181], [3, 126287], [11, 126667], [16, 126947], [19, 127107], [26, 127577], [30, 128047], [35, 128347], [47, 129280], [52, 130214], [65, 131147], [73, 131667], [79, 132027], [88, 132777], [96, 133527], [101, 134117], [110, 134707], [116, 135007], [122, 135367], [129, 136307], [132, 136427], [140, 136767], [146, 137507], [151, 137727], [159, 138467], [165, 139421], [169, 139522], [175, 139942], [177, 140062], [184, 140582], [187, 140722], [197, 141902], [199, 142062], [204, 142302], [218, 143322], [220, 143922], [231, 144762], [233, 145062]]}, {"verse": 14, "start": 146185, "end": 153758, "text": "Por tanto, varones burladores, que gobernáis a este pueblo que está en Jerusalén, oíd la palabra de Jehová.", "words": [[0, 146185], [4, 146305], [11, 147065], [19, 147645], [31, 148785], [35, 148885], [45, 149665], [47, 149845], [52, 150065], [59, 150405], [63, 150725], [68, 150965], [71, 151125], [82, 151985], [86, 152285], [89, 152665], [97, 153025], [100, 153225]]}, {"verse": 15, "start": 154208, "end": 168343, "text": "Porque habéis dicho: Pacto tenemos hecho con la muerte, e hicimos acuerdo con la sepultura; cuando pase el turbión del azote, no llegará a nosotros, pues que hemos puesto nuestra acogida en la mentira, y en la falsedad nos esconderemos:", "words": [[0, 154208], [7, 154434], [14, 154754], [21, 155570], [27, 155960], [35, 156220], [41, 156580], [45, 156800], [48, 156900], [56, 157280], [58, 157720], [66, 158100], [74, 158520], [78, 158840], [81, 158960], [92, 160046], [99, 160260], [104, 160580], [107, 160760], [115, 161120], [119, 161260], [126, 161760], [129, 162200], [137, 162580], [139, 162720], [149, 163180], [154, 163560], [158, 163780], [164, 163920], [171, 164240], [179, 164540], [187, 165260], [190, 165400], [193, 165500], [202, 166080], [204, 166440], [207, 166520], [210, 166620], [219, 167200], [223, 167360]]}, {"verse": 16, "start": 168693, "end": 181265, "text": "Por tanto, el Señor Jehová dice así: He aquí que yo fundo en Sion una piedra, piedra de fortaleza, de esquina, de precio, de cimiento estable: el que crea, no se apresure.", "words": [[0, 168693], [4, 168819], [11, 169379], [14, 169459], [20, 169759], [27, 170399], [32, 170579], [37, 171504], [40, 171594], [45, 171834], [49, 172034], [52, 172174], [58, 172574], [61, 172734], [66, 173054], [70, 173354], [78, 174294], [85, 174754], [88, 174834], [99, 175894], [102, 175994], [111, 176714], [114, 176774], [122, 177574], [125, 177654], [134, 178074], [143, 179301], [146, 179565], [150, 179705], [156, 180105], [159, 180385], [162, 180545]]}, {"verse": 17, "start": 181945, "end": 190598, "text": "Y ajustaré el juicio a cordel, y a nivel la justicia; y granizo barrerá la acogida de la mentira, y aguas arrollarán el escondrijo.", "words": [[0, 181945], [2, 182065], [11, 182625], [14, 182745], [21, 183105], [23, 183305], [31, 183745], [33, 184205], [35, 184285], [41, 184525], [44, 184725], [54, 186039], [56, 186158], [64, 186618], [72, 187078], [75, 187198], [83, 187658], [86, 187758], [89, 187838], [98, 188358], [100, 188818], [106, 189268], [117, 189718], [120, 189838]]}, {"verse": 18, "start": 191197, "end": 202640, "text": "Y será anulado vuestro pacto con la muerte, y vuestro acuerdo con el sepulcro no será firme: cuando pase el turbión del azote, seréis de él pisoteados.", "words": [[0, 191197], [2, 191340], [7, 191620], [15, 192440], [23, 192820], [29, 193280], [33, 193420], [36, 193560], [44, 194460], [46, 194540], [54, 194880], [62, 195260], [66, 195560], [69, 195700], [78, 196380], [81, 196960], [86, 197240], [93, 198227], [100, 198549], [105, 199009], [108, 199249], [116, 199749], [120, 199969], [127, 200749], [134, 201269], [137, 201469], [140, 201649]]}, {"verse": 19, "start": 203090, "end": 214951, "text": "Luego que comience a pasar, él os arrebatará; porque de mañana de mañana pasará, de día y de noche; y será que el espanto solamente haga entender lo oído.", "words": [[0, 203090], [6, 203357], [10, 203637], [19, 204197], [21, 204357], [28, 205277], [31, 205437], [34, 205777], [46, 207221], [53, 207502], [56, 207842], [63, 208202], [66, 208442], [73, 208802], [81, 209402], [84, 209582], [88, 209902], [90, 210042], [93, 210162], [100, 211057], [102, 211180], [107, 211400], [111, 211640], [114, 211760], [122, 212300], [132, 212800], [137, 213280], [146, 213760], [149, 214240]]}, {"verse": 20, "start": 215401, "end": 220367, "text": "Porque la cama es tan angosta que no basta, y la cubierta estrecha para recoger.", "words": [[0, 215401], [7, 215607], [10, 215807], [15, 216107], [18, 216367], [22, 216447], [30, 216907], [34, 217087], [37, 217247], [44, 217607], [46, 218187], [49, 218307], [58, 218867], [67, 219367], [72, 219587]]}, {"verse": 21, "start": 220817, "end": 233757, "text": "Porque Jehová se levantará como en el monte Perasim, como en el valle de Gabaón se enojará; para hacer su obra, su extraña obra, y para hacer su operación, su extraña operación.", "words": [[0, 220817], [7, 221157], [14, 221697], [17, 221797], [27, 222357], [32, 222597], [35, 222797], [38, 222917], [44, 223557], [53, 224197], [58, 224357], [61, 224517], [64, 224812], [70, 225107], [73, 225402], [80, 225697], [83, 225997], [92, 227044], [97, 227227], [103, 227567], [106, 227807], [112, 228467], [115, 228607], [123, 229207], [129, 229527], [131, 230067], [136, 230287], [142, 230627], [145, 230847], [156, 232007], [159, 232087], [167, 232747]]}, {"verse": 22, "start": 234207, "end": 246367, "text": "Ahora pues, no os burléis, porque no se aprieten más vuestras ataduras: porque consumación y acabamiento sobre toda la tierra he oído del Señor Jehová de los ejércitos.", "words": [[0, 234207], [6, 234426], [12, 234646], [15, 234746], [18, 234846], [27, 235646], [34, 236166], [37, 236366], [40, 236506], [49, 237006], [53, 237326], [62, 238086], [72, 239466], [79, 240120], [91, 240810], [93, 241170], [105, 241890], [111, 242250], [116, 242610], [119, 242870], [126, 243270], [129, 243630], [134, 244030], [138, 244250], [144, 244570], [151, 245130], [154, 245210], [158, 245370]]}, {"verse": 23, "start": 246817, "end": 251995, "text": "Estad atentos, y oíd mi voz; estad atentos, y oíd mi dicho.", "words": [[0, 246817], [6, 247433], [15, 248273], [17, 248673], [21, 248973], [24, 249133], [29, 250128], [35, 250328], [44, 250868], [46, 251058], [50, 251248], [53, 251408]]}, {"verse": 24, "start": 252445, "end": 259735, "text": "El que ara para sembrar, ¿arará todo el día; romperá y quebrará los terrones de la tierra?", "words": [[0, 252502], [3, 252592], [7, 252852], [11, 253112], [16, 253332], [25, 254172], [32, 255012], [37, 255312], [40, 255632], [45, 256909], [53, 257409], [55, 257509], [64, 258049], [68, 258229], [77, 258809], [80, 258989], [83, 259089]]}, {"verse": 25, "start": 260184, "end": 272162, "text": "Después que haya igualado su superficie, ¿no derrama el eneldo, siembra el comino, pone el trigo en hileras, la cebada en el lugar señalado, y la avena en su borde apropiado?", "words": [[0, 260184], [8, 260472], [12, 260652], [17, 260872], [26, 261412], [29, 261592], [41, 262812], [45, 262912], [53, 263352], [56, 263492], [64, 264332], [72, 264752], [75, 264852], [83, 265672], [88, 265892], [91, 266052], [97, 266432], [100, 266592], [109, 267352], [112, 267452], [119, 267892], [122, 268032], [125, 268152], [131, 268432], [141, 269611], [143, 269739], [146, 269899], [152, 270559], [155, 270759], [158, 270939], [164, 271239]]}, {"verse": 26, "start": 272612, "end": 276498, "text": "Porque su Dios le instruye, y le enseña a juicio;", "words": [[0, 272612], [7, 272815], [10, 273015], [15, 273295], [18, 273635], [28, 274475], [30, 274995], [33, 275115], [40, 275675], [42, 275875]]}, {"verse": 27, "start": 276948, "end": 288538, "text": "Que el eneldo no se trilla con trillo, ni sobre el comino se pasa rueda de carreta; sino que con un palo se sacude el eneldo, y el comino con una vara.", "words": [[0, 276948], [4, 277256], [7, 277456], [14, 277976], [17, 278156], [20, 278336], [27, 278756], [31, 278936], [39, 279446], [42, 279956], [48, 280216], [51, 280476], [58, 280876], [61, 281056], [66, 281296], [72, 281836], [75, 282303], [84, 283028], [89, 283369], [93, 283589], [97, 283829], [100, 284009], [105, 284509], [108, 284649], [115, 285269], [118, 285629], [126, 286449], [128, 286969], [131, 287109], [138, 287569], [142, 287789], [146, 288009]]}, {"verse": 28, "start": 288988, "end": 299384, "text": "El pan se trilla; pero no siempre lo trillará, ni lo comprimirá con la rueda de su carreta, ni lo quebrantará con los dientes de su trillo.", "words": [[0, 288988], [3, 289131], [7, 289351], [10, 289591], [18, 290614], [23, 290779], [26, 290959], [34, 291459], [37, 291699], [47, 292819], [50, 293079], [53, 293279], [64, 294239], [68, 294439], [71, 294639], [77, 295079], [80, 295219], [83, 295379], [92, 296399], [95, 296679], [98, 296859], [110, 297679], [114, 297899], [118, 298039], [126, 298419], [129, 298579], [132, 298739]]}, {"verse": 29, "start": 299834, "end": 307592, "text": "También esto salió de Jehová de los ejércitos, para hacer maravilloso el consejo y engrandecer la sabiduría.", "words": [[0, 299834], [8, 300098], [13, 300458], [19, 300958], [22, 301078], [29, 301498], [32, 301578], [36, 301718], [47, 302498], [52, 303098], [58, 303538], [70, 304318], [73, 304458], [81, 305158], [83, 305578], [95, 306458], [98, 306618]]}]}