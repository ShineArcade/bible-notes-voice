{"book": "MRK", "chapter": 12, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 402604, "verses": [{"verse": 1, "start": 300, "end": 18592, "text": "Y comenzó a hablarles por parábolas: Plantó un hombre una viña, y la rodeó con una cerca, y cavó un depósito para recoger el vino, y edificó una torre, y la arrendó a agricultores arrendatarios, y se fue lejos.", "words": [[0, 300], [2, 417], [10, 1097], [12, 1297], [22, 1857], [26, 2077], [37, 3320], [44, 3884], [47, 4064], [54, 4364], [58, 4624], [64, 5184], [66, 5824], [69, 5984], [75, 6544], [79, 6724], [83, 6884], [90, 7344], [92, 7914], [97, 8484], [100, 8584], [109, 9224], [114, 9484], [122, 10044], [125, 10204], [131, 10584], [133, 11324], [141, 12004], [145, 12204], [152, 13184], [154, 13504], [157, 13624], [165, 14424], [167, 14644], [180, 15704], [195, 17336], [197, 17463], [200, 17603], [204, 17803]]}, {"verse": 2, "start": 19042, "end": 26032, "text": "Y envió un siervo a los labradores, al tiempo, para que tomase de los labradores del fruto de la viña.", "words": [[0, 19042], [2, 19163], [8, 19523], [11, 19683], [18, 20143], [20, 20243], [24, 20383], [36, 21223], [39, 21643], [47, 22163], [52, 23043], [56, 23183], [63, 23683], [66, 23823], [70, 23983], [81, 24643], [85, 24823], [91, 25243], [94, 25343], [97, 25463]]}, {"verse": 3, "start": 26482, "end": 31378, "text": "Pero ellos, tomándole, lo golpearon, y le enviaron vacío.", "words": [[0, 26482], [5, 26846], [12, 27066], [23, 28346], [26, 28466], [37, 29226], [39, 29886], [42, 30026], [51, 30546]]}, {"verse": 4, "start": 31828, "end": 39606, "text": "Y volvió a enviarles otro siervo; pero apedreándole, le hirieron en la cabeza, y lo despidieron humillado.", "words": [[0, 31828], [2, 31974], [9, 32354], [11, 32434], [21, 32914], [26, 33154], [34, 34056], [39, 34242], [53, 35622], [56, 36062], [65, 36502], [68, 36682], [71, 36822], [79, 37282], [81, 37822], [84, 37962], [96, 38642]]}, {"verse": 5, "start": 40056, "end": 48376, "text": "Y volvió a enviar otro, y a aquel mataron; y a otros muchos, hiriendo a unos y matando a otros.", "words": [[0, 40056], [2, 40185], [9, 40665], [11, 40785], [18, 41225], [24, 41665], [26, 42105], [28, 42545], [34, 42985], [43, 44132], [45, 44274], [47, 44354], [53, 44614], [61, 45434], [70, 46254], [72, 46454], [77, 46714], [79, 47074], [87, 47594], [89, 47734]]}, {"verse": 6, "start": 48826, "end": 58743, "text": "Teniendo pues aún un hijo suyo amado, lo envió también a ellos por último, diciendo: Respetarán a mi hijo.", "words": [[0, 48826], [9, 49311], [14, 49591], [18, 49871], [21, 50091], [26, 50331], [31, 50771], [38, 51511], [41, 51911], [47, 52231], [55, 52531], [57, 52831], [63, 53051], [67, 53311], [75, 54131], [85, 56833], [96, 57133], [98, 57393], [101, 57513]]}, {"verse": 7, "start": 59193, "end": 67263, "text": "Pero aquellos labradores dijeron entre sí: Este es el heredero; venid, matémosle, y la herencia será nuestra.", "words": [[0, 59193], [5, 59335], [14, 59675], [25, 60595], [33, 61135], [39, 61375], [43, 62331], [48, 62331], [51, 62586], [54, 62826], [64, 64399], [71, 64399], [82, 65164], [84, 65524], [87, 65664], [96, 66184], [101, 66504]]}, {"verse": 8, "start": 67713, "end": 71836, "text": "Y prendiéndole, le mataron, y echaron fuera de la viña.", "words": [[0, 67713], [2, 67841], [16, 68701], [19, 68961], [28, 69561], [30, 70141], [38, 70561], [44, 70841], [47, 71101], [50, 71221]]}, {"verse": 9, "start": 72286, "end": 79973, "text": "¿Qué, pues, hará el señor de la viña? Vendrá, y destruirá a estos labradores, y dará su viña a otros.", "words": [[0, 72286], [6, 72388], [12, 72708], [17, 73268], [20, 73388], [26, 73688], [29, 73928], [32, 74048], [38, 74946], [46, 75532], [48, 75712], [58, 76412], [60, 76612], [66, 76892], [78, 77712], [80, 78052], [85, 78372], [88, 78572], [93, 79012], [95, 79252]]}, {"verse": 10, "start": 80423, "end": 88715, "text": "¿Ni aun esta Escritura habéis leído: La piedra que desecharon los que edificaban, esta se ha convertido en la piedra angular;", "words": [[0, 80539], [4, 80694], [8, 80849], [13, 81004], [23, 81564], [30, 81884], [37, 82777], [40, 82883], [47, 83383], [51, 83543], [62, 84263], [66, 84463], [70, 84643], [82, 85503], [87, 85823], [90, 86263], [93, 86363], [104, 87103], [107, 87303], [110, 87443], [117, 87903]]}, {"verse": 11, "start": 89166, "end": 93572, "text": "Por el Señor es hecho esto, y es cosa maravillosa en nuestros ojos?", "words": [[0, 89166], [4, 89308], [7, 89448], [13, 89728], [16, 89948], [22, 90188], [28, 90588], [30, 91088], [33, 91248], [38, 91448], [50, 92348], [53, 92528], [62, 92768]]}, {"verse": 12, "start": 94022, "end": 104009, "text": "Y procuraban prenderle, porque entendían que decía a ellos aquella parábola; pero temían a la multitud; y dejándole, se fueron.", "words": [[0, 94022], [2, 94143], [13, 94843], [24, 95683], [31, 96403], [41, 97283], [45, 97483], [51, 97923], [53, 98223], [59, 98463], [67, 98963], [77, 100003], [82, 100290], [89, 100850], [91, 101010], [94, 101090], [104, 102159], [106, 102263], [117, 102923], [120, 103383]]}, {"verse": 13, "start": 104459, "end": 111146, "text": "Y envían a él algunos de los fariseos y de los Herodianos, para atraparlo en sus propias palabras.", "words": [[0, 104459], [2, 104601], [9, 105021], [11, 105141], [14, 105361], [22, 105821], [25, 106041], [29, 106141], [38, 106781], [40, 106901], [43, 106981], [47, 107101], [59, 108021], [64, 108441], [74, 109441], [77, 109581], [81, 109761], [89, 110281]]}, {"verse": 14, "start": 111596, "end": 128313, "text": "Y viniendo ellos, le dicen: Maestro, sabemos que eres hombre de verdad, y que no te dejas influir por nadie; porque no miras a la apariencia de hombres, antes con verdad enseñas el camino de Dios: ¿Es lícito dar tributo a César, o no? ¿Daremos, o no daremos?", "words": [[0, 111596], [2, 111888], [11, 112388], [18, 112648], [21, 112908], [28, 113762], [37, 114346], [45, 114586], [49, 114886], [54, 115046], [61, 115346], [64, 115546], [72, 115886], [74, 116466], [78, 116586], [81, 116726], [84, 116866], [90, 117126], [98, 117646], [102, 117806], [109, 118621], [116, 118804], [119, 119004], [125, 119384], [127, 119484], [130, 119584], [141, 120084], [144, 120304], [153, 120984], [159, 121504], [163, 121604], [170, 122264], [178, 122804], [181, 122904], [188, 123144], [191, 123424], [197, 124209], [201, 124354], [208, 124754], [212, 124954], [220, 125474], [222, 125534], [229, 125934], [231, 126154], [235, 126797], [245, 127342], [247, 127542], [250, 127702]]}, {"verse": 15, "start": 128663, "end": 138601, "text": "Entonces él, como entendía la hipocresía de ellos, les dijo: ¿Por qué intentáis ponerme a prueba? Traedme la moneda para que la vea.", "words": [[0, 128663], [9, 129109], [13, 129669], [18, 129849], [27, 130489], [30, 130649], [41, 131509], [44, 131689], [51, 132349], [55, 132449], [61, 133253], [66, 133378], [70, 133658], [80, 134538], [88, 135178], [90, 135318], [98, 136322], [106, 136907], [109, 137067], [116, 137487], [121, 137727], [125, 137907], [128, 138067]]}, {"verse": 16, "start": 139051, "end": 147908, "text": "Y ellos se la trajeron y les dice: ¿De quién es esta imagen y esta inscripción? Y ellos le dijeron: De César.", "words": [[0, 139051], [2, 139216], [8, 139496], [11, 139716], [14, 139816], [23, 140576], [25, 140756], [29, 140896], [35, 141855], [39, 142038], [45, 142258], [48, 142738], [53, 143038], [60, 143518], [62, 143778], [67, 144018], [80, 145369], [82, 145572], [88, 145892], [91, 146212], [100, 147166], [103, 147310]]}, {"verse": 17, "start": 148258, "end": 157580, "text": "Y respondiendo Jesús, les dijo: Dad lo que es de César a César; y lo que es de Dios, a Dios. Y se maravillaron de ello.", "words": [[0, 148258], [2, 148382], [15, 149122], [22, 149922], [26, 150022], [32, 150842], [36, 151188], [39, 151848], [43, 152008], [46, 152108], [49, 152228], [55, 152688], [57, 152908], [64, 153688], [66, 153793], [69, 153913], [73, 154073], [76, 154173], [79, 154273], [85, 154701], [87, 155130], [93, 155807], [95, 155990], [98, 156110], [111, 156810], [114, 157030]]}, {"verse": 18, "start": 158030, "end": 165956, "text": "Entonces vienen a él los saduceos, que dicen que no hay resurrección, y le preguntaron, diciendo:", "words": [[0, 158030], [9, 158428], [16, 158948], [18, 159288], [21, 159548], [25, 159868], [35, 161108], [39, 161308], [45, 161588], [49, 161828], [52, 162088], [56, 162268], [70, 163728], [72, 163828], [75, 163908], [88, 164648]]}, {"verse": 19, "start": 166206, "end": 176046, "text": "Maestro, Moisés nos escribió, que si el hermano de alguno muriese, y dejase mujer, y no dejase hijos, que su hermano tome su mujer, y dé descendencia a su hermano.", "words": [[0, 166206], [9, 166606], [16, 166966], [20, 167166], [30, 167906], [34, 168406], [37, 168586], [40, 168706], [48, 169126], [51, 169206], [58, 169606], [67, 170086], [69, 170346], [76, 170766], [83, 171106], [85, 171666], [88, 171786], [95, 172226], [102, 172926], [106, 173006], [109, 173146], [117, 173526], [122, 173766], [125, 173906], [132, 174246], [134, 174526], [137, 174646], [150, 175346], [152, 175486], [155, 175546]]}, {"verse": 20, "start": 176496, "end": 181824, "text": "Fueron siete hermanos: y el primero tomó mujer, y muriendo, no dejó descendencia;", "words": [[0, 176496], [7, 176705], [13, 177005], [23, 178038], [25, 178139], [28, 178239], [36, 178559], [41, 178939], [48, 179299], [50, 179599], [60, 180419], [63, 180599], [68, 181239]]}, {"verse": 21, "start": 182274, "end": 188493, "text": "Y la tomó el segundo, y murió, y ni aquel tampoco dejó descendencia; y el tercero, de la misma manera.", "words": [[0, 182274], [2, 182376], [5, 182436], [10, 182716], [13, 182796], [22, 183196], [24, 183536], [31, 183976], [33, 184336], [36, 184436], [42, 184736], [50, 185036], [55, 185731], [69, 186672], [71, 186732], [74, 186832], [83, 187392], [86, 187532], [89, 187652], [95, 187872]]}, {"verse": 22, "start": 188943, "end": 195013, "text": "Y la tomaron los siete, y tampoco dejaron descendencia: después de todos murió también la mujer.", "words": [[0, 188943], [2, 189059], [5, 189159], [13, 189579], [17, 189759], [24, 190119], [26, 190759], [34, 191059], [42, 191619], [56, 192826], [64, 193173], [67, 193373], [73, 193633], [79, 194113], [87, 194333], [90, 194553]]}, {"verse": 23, "start": 195463, "end": 202180, "text": "En la resurrección, pues, cuando resuciten, ¿de cuál de ellos será mujer? porque los siete la tuvieron por mujer.", "words": [[0, 195463], [3, 195605], [6, 195685], [20, 196525], [26, 196905], [33, 197145], [44, 197805], [48, 198425], [53, 198685], [56, 198885], [62, 199105], [67, 199345], [74, 200209], [81, 200410], [85, 200590], [91, 200870], [94, 201090], [103, 201470], [107, 201630]]}, {"verse": 24, "start": 202530, "end": 210799, "text": "Entonces respondiendo Jesús, les dice: ¿No erráis por eso, porque no sabéis las Escrituras, ni el poder de Dios?", "words": [[0, 202530], [9, 203559], [22, 204299], [29, 204649], [33, 204999], [39, 205842], [43, 206150], [50, 206490], [54, 206710], [59, 207330], [66, 207630], [69, 207810], [76, 208230], [80, 208390], [92, 209000], [95, 209610], [98, 209730], [104, 210110], [107, 210250]]}, {"verse": 25, "start": 211249, "end": 220683, "text": "Porque cuando resuciten de los muertos, ni se casarán, ni serán dados en casamiento, sino que son como los ángeles que están en los cielos.", "words": [[0, 211249], [7, 211473], [14, 211813], [24, 212613], [27, 212793], [31, 212913], [40, 213813], [43, 214053], [46, 214213], [55, 215173], [58, 215393], [64, 215793], [70, 216133], [73, 216433], [85, 217493], [90, 217773], [94, 217973], [98, 218213], [103, 218513], [107, 218693], [115, 219293], [119, 219453], [125, 219693], [128, 219873], [132, 219993]]}, {"verse": 26, "start": 221133, "end": 235385, "text": "Y de que los muertos hayan de resucitar, ¿no habéis leído en el libro de Moisés cómo le habló Dios en la zarza, diciendo: Yo soy el Dios de Abraham, y el Dios de Isaac, y el Dios de Jacob?", "words": [[0, 221133], [2, 221257], [5, 221377], [9, 221517], [13, 221697], [21, 222257], [27, 222817], [30, 222937], [41, 224097], [45, 224257], [52, 224717], [58, 225157], [61, 225297], [64, 225437], [70, 225697], [73, 225897], [80, 226297], [85, 226757], [88, 226957], [94, 227257], [99, 227417], [102, 227677], [105, 228217], [112, 228757], [122, 229808], [125, 230017], [129, 230337], [132, 230577], [137, 230797], [140, 231017], [149, 231477], [151, 232417], [154, 232577], [159, 232877], [162, 233137], [169, 233717], [171, 234357], [174, 234477], [179, 234677], [182, 234837]]}, {"verse": 27, "start": 235835, "end": 240942, "text": "No es Dios de muertos, sino Dios de vivos; así que vosotros mucho erráis.", "words": [[0, 235835], [3, 236001], [6, 236141], [11, 236361], [14, 236561], [23, 237241], [28, 237541], [33, 237821], [36, 237981], [43, 238738], [47, 239098], [51, 239278], [60, 239778], [66, 240178]]}, {"verse": 28, "start": 241392, "end": 251955, "text": "Y llegándose uno de los escribas, que los había oído debatir, y sabía que les había respondido bien, le preguntó: ¿Cuál es el primer mandamiento de todos?", "words": [[0, 241392], [2, 241496], [13, 242176], [17, 242536], [20, 242696], [24, 242856], [34, 243956], [38, 244036], [42, 244196], [48, 244516], [53, 244876], [62, 245576], [64, 245916], [70, 246356], [74, 246456], [78, 246616], [84, 246936], [95, 247636], [101, 248476], [104, 248636], [114, 249731], [120, 249954], [123, 250074], [126, 250194], [133, 250454], [145, 251114], [148, 251334]]}, {"verse": 29, "start": 252305, "end": 262413, "text": "Y Jesús le respondió: El primer mandamiento de todos es: Oye, Israel, el Señor nuestro Dios, el Señor uno es.", "words": [[0, 252305], [2, 252426], [8, 252826], [11, 253246], [22, 254369], [25, 254536], [32, 254896], [44, 255716], [47, 255876], [53, 256156], [57, 257831], [62, 257831], [70, 258815], [73, 258975], [79, 259315], [87, 259795], [93, 260975], [96, 261135], [102, 261455], [106, 261895]]}, {"verse": 30, "start": 262863, "end": 273956, "text": "Amarás pues al Señor tu Dios de todo tu corazón, y de toda tu alma, y de toda tu mente, y de todas tus fuerzas; este es el principal mandamiento.", "words": [[0, 262863], [7, 263405], [12, 263625], [15, 263925], [21, 264285], [24, 264645], [29, 264945], [32, 265205], [37, 265485], [40, 265725], [49, 266165], [51, 266765], [54, 266885], [59, 267085], [62, 267345], [68, 267665], [70, 268225], [73, 268345], [78, 268605], [81, 268865], [88, 269245], [90, 269765], [93, 269885], [99, 270165], [103, 270425], [112, 271524], [117, 271788], [120, 272048], [123, 272208], [133, 272788]]}, {"verse": 31, "start": 274406, "end": 282459, "text": "Y el segundo es semejante a él: Amarás a tu prójimo como a ti mismo. No hay otro mandamiento mayor que estos.", "words": [[0, 274406], [2, 274552], [5, 274672], [13, 275092], [16, 275432], [26, 276132], [28, 276332], [32, 277056], [39, 277541], [41, 277641], [44, 277781], [52, 278401], [57, 278681], [59, 278841], [62, 278961], [69, 279844], [72, 280051], [76, 280271], [81, 280531], [93, 281211], [99, 281591], [103, 281851]]}, {"verse": 32, "start": 282909, "end": 289638, "text": "Entonces el escriba le dijo: Bien, Maestro, verdad has dicho, que uno es Dios, y no hay otro fuera de él;", "words": [[0, 282909], [9, 283432], [12, 283812], [20, 284312], [23, 284432], [29, 285188], [35, 285444], [44, 286084], [51, 286424], [55, 286524], [62, 286804], [66, 287084], [70, 287284], [73, 287524], [79, 287764], [81, 288344], [84, 288484], [88, 288644], [93, 288864], [99, 289144], [102, 289384]]}, {"verse": 33, "start": 290088, "end": 302167, "text": "Y que amarle de todo corazón, y de todo entendimiento, y de toda el alma, y de todas las fuerzas, y amar al prójimo como a sí mismo, más es que todos los holocaustos y sacrificios.", "words": [[0, 290088], [2, 290193], [6, 290293], [13, 290693], [16, 290813], [21, 290993], [30, 291533], [32, 292013], [35, 292113], [40, 292313], [55, 293233], [57, 293533], [60, 293653], [65, 293813], [68, 294033], [74, 294293], [76, 294653], [79, 294773], [85, 294953], [89, 295193], [98, 295600], [100, 296006], [105, 296413], [108, 296513], [116, 297033], [121, 297253], [123, 297413], [126, 297473], [133, 298320], [137, 298557], [140, 298697], [144, 298817], [150, 299037], [154, 299297], [166, 299997], [168, 300097]]}, {"verse": 34, "start": 302517, "end": 313797, "text": "Jesús entonces, viendo que había respondido sabiamente, le dice: No estás lejos del reino de Dios. Y ya ninguno se atrevía a preguntarle.", "words": [[0, 302517], [6, 302860], [16, 304300], [23, 304740], [27, 305000], [33, 305300], [44, 306120], [56, 307280], [59, 307360], [65, 308224], [68, 308410], [74, 308650], [80, 309190], [84, 309450], [90, 309910], [93, 310110], [99, 311009], [101, 311295], [104, 311435], [112, 311975], [115, 312175], [123, 312655], [125, 312795]]}, {"verse": 35, "start": 314247, "end": 321555, "text": "Y respondiendo Jesús decía, enseñando en el templo: ¿Cómo dicen los escribas que el Cristo es hijo de David?", "words": [[0, 314247], [2, 314371], [15, 315131], [21, 315471], [28, 316371], [38, 317111], [41, 317251], [44, 317391], [52, 318459], [58, 318646], [64, 318986], [68, 319226], [77, 319846], [81, 319986], [84, 320126], [91, 320506], [94, 320706], [99, 320946], [102, 321126]]}, {"verse": 36, "start": 322005, "end": 333215, "text": "Porque el mismo David dijo por el Espíritu Santo: Dijo el Señor a mi Señor: Siéntate a mi derecha, hasta que ponga tus enemigos por estrado de tus pies.", "words": [[0, 322005], [7, 322210], [10, 322370], [16, 322650], [22, 323110], [27, 323630], [31, 323990], [34, 324130], [43, 324650], [50, 325611], [55, 326001], [58, 326201], [64, 326481], [66, 326741], [69, 326821], [76, 327732], [85, 328233], [87, 328333], [90, 328393], [99, 328813], [105, 328973], [109, 329133], [115, 329573], [119, 329713], [128, 330253], [132, 330473], [140, 331013], [143, 331173], [147, 331333]]}, {"verse": 37, "start": 333665, "end": 341177, "text": "Luego llamándole el mismo David Señor, ¿cómo, pues, es su hijo? Y la gente común lo oía con agrado.", "words": [[0, 333665], [6, 333665], [17, 334411], [20, 334751], [26, 335071], [32, 335371], [39, 336651], [46, 336931], [52, 337351], [55, 337771], [58, 337971], [64, 338768], [66, 338856], [69, 338956], [75, 339216], [81, 339556], [84, 339856], [88, 340336], [92, 340556]]}, {"verse": 38, "start": 341627, "end": 351370, "text": "Y les decía en su enseñanza: Guardaos de los escribas, que quieren andar con ropas largas, y aman los saludos en las plazas,", "words": [[0, 341627], [2, 341751], [6, 341891], [12, 342351], [15, 342531], [18, 342671], [29, 344132], [38, 344402], [41, 344582], [45, 344682], [55, 345362], [59, 345922], [67, 346282], [73, 346642], [77, 346902], [83, 347322], [91, 348022], [93, 348842], [98, 349082], [102, 349722], [110, 350342], [113, 350482], [117, 350642]]}, {"verse": 39, "start": 351820, "end": 357840, "text": "Y los asientos principales en las sinagogas, y los lugares de honor en los banquetes;", "words": [[0, 351820], [2, 351965], [6, 352085], [15, 352545], [27, 353505], [30, 353725], [34, 353885], [45, 354725], [47, 355305], [51, 355465], [59, 355845], [62, 356085], [68, 356365], [71, 356825], [75, 356965]]}, {"verse": 40, "start": 358290, "end": 366506, "text": "Que devoran las casas de las viudas, y para aparentar hacen largas oraciones. Estos recibirán mayor juicio.", "words": [[0, 358290], [4, 358373], [12, 358853], [16, 359033], [22, 359473], [25, 359573], [29, 359693], [37, 360253], [39, 360613], [44, 360853], [54, 361813], [60, 362113], [67, 362693], [78, 363958], [84, 364618], [94, 365478], [100, 365758]]}, {"verse": 41, "start": 366956, "end": 376459, "text": "Y estando sentado Jesús delante del tesoro del templo, miraba cómo el pueblo echaba dinero en el tesoro: y muchos ricos echaban mucho.", "words": [[0, 366956], [2, 367077], [10, 367637], [18, 368257], [24, 368577], [32, 369237], [36, 369477], [43, 369957], [47, 370097], [55, 371017], [62, 371437], [67, 371757], [70, 371977], [77, 372217], [84, 372737], [91, 373117], [94, 373337], [97, 373457], [105, 374482], [107, 374603], [114, 374993], [120, 375383], [128, 375823]]}, {"verse": 42, "start": 376909, "end": 384525, "text": "Y cuando vino una viuda pobre, echó dos monedas pequeñas de cobre, que equivalen a un cuadrante romano.", "words": [[0, 376909], [2, 377014], [9, 377234], [14, 377574], [18, 377814], [24, 378174], [31, 378854], [36, 379514], [40, 379874], [48, 380454], [57, 381074], [60, 381174], [67, 381674], [71, 382134], [81, 382914], [83, 383074], [86, 383194], [96, 383774]]}, {"verse": 43, "start": 384975, "end": 393850, "text": "Entonces llamando a sus discípulos, les dice: De cierto os digo que esta viuda pobre echó más que todos los que han echado en el arca:", "words": [[0, 384975], [9, 385895], [18, 386295], [20, 386375], [24, 386555], [36, 387235], [40, 387375], [46, 388400], [49, 388614], [56, 388827], [59, 389027], [64, 389367], [68, 389627], [73, 389927], [79, 390347], [85, 390727], [90, 391107], [94, 391367], [98, 391587], [104, 391907], [108, 392207], [112, 392387], [116, 392567], [123, 392987], [126, 393127], [129, 393287]]}, {"verse": 44, "start": 394300, "end": 402204, "text": "Porque todos han echado de lo que les sobra; pero esta, aun en su pobreza, echó todo lo que tenía para vivir.", "words": [[0, 394300], [7, 394544], [13, 394904], [17, 395284], [24, 395844], [27, 396304], [30, 396444], [34, 396564], [38, 396704], [45, 397713], [50, 397858], [56, 398198], [60, 398558], [63, 398758], [66, 398918], [75, 399578], [80, 400318], [85, 400658], [88, 400898], [92, 401018], [98, 401358], [103, 401578]]}]}