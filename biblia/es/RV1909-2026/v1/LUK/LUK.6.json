{"book": "LUK", "chapter": 6, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 436366, "verses": [{"verse": 1, "start": 300, "end": 11921, "text": "Y aconteció que pasando él por los sembrados en un sábado segundo del primero, sus discípulos arrancaban espigas, y comían, restregándolas con las manos.", "words": [[0, 300], [2, 422], [12, 1062], [16, 1262], [24, 1642], [27, 1982], [31, 2182], [35, 2382], [45, 3042], [48, 3262], [51, 3382], [58, 3902], [66, 4402], [70, 4722], [79, 5782], [83, 6082], [94, 6862], [105, 7642], [114, 8422], [116, 8902], [124, 9862], [139, 10902], [143, 11122], [147, 11302]]}, {"verse": 2, "start": 12271, "end": 17588, "text": "Y algunos de los fariseos les dijeron: ¿Por qué hacéis lo que no es lícito hacer en los sábados?", "words": [[0, 12271], [2, 12350], [10, 12670], [13, 12890], [17, 12990], [26, 13670], [30, 13970], [39, 14730], [44, 14845], [48, 15045], [55, 15485], [58, 15585], [62, 15705], [65, 15885], [68, 16025], [75, 16445], [81, 16685], [84, 16865], [88, 16985]]}, {"verse": 3, "start": 17868, "end": 27408, "text": "Y respondiendo Jesús les dijo: ¿Ni aun esto habéis leído, qué hizo David cuando tuvo hambre, él, y los que con él estaban;", "words": [[0, 17868], [2, 17991], [15, 18771], [21, 19131], [25, 19491], [31, 20398], [35, 20498], [39, 20758], [44, 21218], [51, 21598], [58, 22078], [62, 22318], [67, 22718], [73, 23078], [80, 23418], [85, 23838], [93, 24858], [97, 25278], [99, 25743], [103, 25903], [107, 26043], [111, 26303], [114, 26463]]}, {"verse": 4, "start": 27758, "end": 40656, "text": "Cómo entró en la casa de Dios, y tomó los panes de la Presencia, y comió, y dio también a los que estaban con él, los cuales no era lícito comer, sino a solos los sacerdotes?", "words": [[0, 27758], [5, 27964], [11, 28444], [14, 28524], [17, 28644], [22, 28924], [25, 29144], [31, 29444], [33, 29919], [38, 30239], [42, 30359], [48, 30819], [51, 30899], [54, 31019], [65, 31679], [67, 31819], [74, 32299], [76, 32799], [80, 32959], [88, 33439], [90, 33999], [94, 34119], [98, 34259], [106, 34519], [110, 34859], [114, 35509], [118, 35636], [125, 35956], [128, 36596], [132, 36756], [139, 37156], [146, 38036], [151, 38236], [153, 38436], [159, 38976], [163, 39456]]}, {"verse": 5, "start": 41006, "end": 45276, "text": "Y les decía: El Hijo del hombre es Señor aun del sábado.", "words": [[0, 41006], [2, 41155], [6, 41255], [13, 42214], [16, 42531], [21, 42751], [25, 42931], [32, 43311], [35, 43571], [41, 43871], [45, 44251], [49, 44511]]}, {"verse": 6, "start": 45626, "end": 55130, "text": "Y aconteció también en otro sábado, que él entró en la sinagoga y enseñaba; y estaba allí un hombre que tenía la mano derecha atrofiada.", "words": [[0, 45626], [2, 45769], [12, 46449], [20, 46789], [23, 47089], [28, 47309], [36, 47869], [40, 48349], [43, 48749], [49, 49269], [52, 49369], [55, 49509], [64, 50149], [66, 50329], [76, 51438], [78, 51699], [85, 51979], [90, 52259], [93, 52419], [100, 52719], [104, 52899], [110, 53179], [113, 53359], [118, 53579], [126, 54139]]}, {"verse": 7, "start": 55480, "end": 62227, "text": "Y le acechaban los escribas y los fariseos, si sanaría en sábado, por hallar de qué le acusasen.", "words": [[0, 55480], [2, 55605], [5, 55745], [15, 56385], [19, 56545], [28, 57245], [30, 57405], [34, 57565], [44, 58565], [47, 58825], [55, 59325], [58, 59565], [66, 60125], [70, 60425], [77, 60725], [80, 61005], [84, 61205], [87, 61365]]}, {"verse": 8, "start": 62577, "end": 73173, "text": "Pero él sabía los pensamientos de ellos; y dijo al hombre que tenía la mano atrofiada: Levántate, y ponte en medio. Y él levantándose, se puso en pie.", "words": [[0, 62577], [5, 62720], [8, 62920], [14, 63320], [18, 63460], [31, 64040], [34, 64260], [41, 64995], [43, 65277], [48, 65517], [51, 65697], [58, 65917], [62, 66217], [68, 66517], [71, 66657], [76, 66997], [87, 68416], [98, 69081], [100, 69321], [106, 69681], [109, 69861], [116, 70665], [118, 70828], [121, 70968], [135, 71868], [138, 72048], [143, 72448], [146, 72588]]}, {"verse": 9, "start": 73523, "end": 82777, "text": "Entonces Jesús les dice: Os preguntaré una cosa: ¿Es lícito en sábados hacer bien, o hacer mal? ¿salvar la vida, o quitarla?", "words": [[0, 73523], [9, 74023], [15, 74503], [19, 74803], [25, 75570], [28, 75736], [39, 76516], [43, 76676], [49, 77371], [53, 77564], [60, 78144], [63, 78324], [71, 78844], [77, 79224], [83, 79584], [85, 80104], [91, 80384], [96, 81084], [104, 81441], [107, 81701], [113, 81921], [115, 82101]]}, {"verse": 10, "start": 83127, "end": 91101, "text": "Y mirándolos a todos alrededor, dice al hombre: Extiende tu mano. Y él lo hizo así, y su mano fue restaurada.", "words": [[0, 83127], [2, 83252], [13, 83992], [15, 84112], [21, 84372], [32, 85292], [37, 85492], [40, 85732], [48, 86403], [57, 87011], [60, 87211], [66, 88021], [68, 88190], [71, 88310], [74, 88490], [79, 88730], [84, 89090], [86, 89330], [89, 89510], [94, 89750], [98, 90010]]}, {"verse": 11, "start": 91451, "end": 97714, "text": "Y ellos se llenaron de rabia; y hablaban los unos a los otros qué harían a Jesús.", "words": [[0, 91451], [2, 91762], [8, 92062], [11, 92582], [20, 93082], [23, 93222], [30, 94171], [32, 94277], [41, 94777], [45, 95017], [50, 95417], [52, 95717], [56, 95877], [62, 96197], [66, 96497], [73, 96957], [75, 97077]]}, {"verse": 12, "start": 98064, "end": 104179, "text": "Y aconteció en aquellos días, que fue al monte a orar, y pasó la noche orando a Dios.", "words": [[0, 98064], [2, 98189], [12, 98969], [15, 99109], [24, 99349], [30, 99849], [34, 100109], [38, 100329], [41, 100469], [47, 100769], [49, 100929], [55, 101369], [57, 101989], [62, 102309], [65, 102529], [71, 102829], [78, 103469], [80, 103629]]}, {"verse": 13, "start": 104529, "end": 112571, "text": "Y como fue de día, llamó a sus discípulos, y escogió doce de ellos, a los cuales también llamó apóstoles:", "words": [[0, 104529], [2, 104632], [7, 104852], [11, 105072], [14, 105212], [19, 106172], [25, 106612], [27, 106692], [31, 106872], [43, 107712], [45, 108412], [53, 109092], [58, 109752], [61, 109972], [68, 110332], [70, 110592], [74, 110732], [81, 110912], [89, 111272], [95, 111692]]}, {"verse": 14, "start": 112921, "end": 121021, "text": "A Simón, al cual también llamó Pedro, y a Andrés su hermano, Jacobo y Juan, Felipe y Bartolomé,", "words": [[0, 112921], [2, 113085], [9, 113805], [12, 113905], [17, 114105], [25, 114465], [31, 114945], [38, 115845], [40, 116085], [42, 116165], [49, 116905], [52, 116945], [61, 117805], [68, 118445], [70, 118605], [76, 119365], [83, 119765], [85, 120205]]}, {"verse": 15, "start": 121371, "end": 127047, "text": "Mateo y Tomás, Jacobo hijo de Alfeo, y Simón el que se llama Zelote,", "words": [[0, 121371], [6, 121937], [8, 122097], [15, 122877], [22, 123537], [27, 123697], [30, 123897], [37, 124857], [39, 124917], [45, 125537], [48, 125697], [52, 125837], [55, 125977], [61, 126532]]}, {"verse": 16, "start": 127397, "end": 132563, "text": "Judas hermano de Jacobo, y Judas Iscariote, que también fue el traidor.", "words": [[0, 127397], [6, 127703], [14, 128303], [17, 128363], [25, 129283], [27, 129443], [33, 129823], [44, 130823], [48, 130923], [56, 131303], [60, 131543], [63, 131823]]}, {"verse": 17, "start": 132913, "end": 151404, "text": "Y descendió con ellos, y se paró en un lugar llano, y un grupo numeroso de sus discípulos, y una grande multitud de pueblo de toda Judea y de Jerusalén, y de la costa de Tiro y de Sidón, que habían venido a oírle, y para ser sanados de sus enfermedades;", "words": [[0, 132913], [2, 133037], [12, 133557], [16, 133817], [23, 134177], [25, 134582], [28, 134762], [33, 135162], [36, 135342], [39, 135482], [45, 135862], [52, 136922], [54, 137102], [57, 137222], [63, 137442], [72, 138082], [75, 138262], [79, 138442], [91, 139242], [93, 139682], [97, 139842], [104, 140142], [113, 140842], [116, 141042], [123, 141442], [126, 141682], [131, 141962], [137, 142642], [139, 142742], [142, 142862], [153, 144039], [155, 144175], [158, 144295], [161, 144435], [167, 144975], [170, 145075], [175, 145455], [177, 145655], [180, 145795], [187, 146415], [191, 146775], [198, 147015], [205, 147475], [207, 147575], [214, 148275], [216, 148675], [221, 148875], [225, 149155], [233, 149775], [236, 149975], [240, 150135]]}, {"verse": 18, "start": 151754, "end": 156988, "text": "Y los que habían sido atormentados de espíritus inmundos: y estaban curados.", "words": [[0, 151754], [2, 151876], [6, 151996], [10, 152136], [17, 152396], [22, 152736], [35, 153676], [38, 153816], [48, 154556], [58, 155688], [60, 155788], [68, 156048]]}, {"verse": 19, "start": 157338, "end": 163186, "text": "Y toda la gente procuraba tocarle; porque salía de él poder, y sanaba a todos.", "words": [[0, 157338], [2, 157482], [7, 157702], [10, 157922], [16, 158242], [26, 158982], [35, 160083], [42, 160246], [48, 160706], [51, 160846], [54, 161006], [61, 161306], [63, 161886], [70, 162366], [72, 162506]]}, {"verse": 20, "start": 163536, "end": 172082, "text": "Y alzando él los ojos a sus discípulos, decía: Bienaventurados vosotros los pobres; porque vuestro es el reino de Dios.", "words": [[0, 163536], [2, 163664], [10, 163984], [13, 164304], [17, 164464], [22, 164844], [24, 165064], [28, 165244], [40, 166224], [47, 167366], [63, 168262], [72, 168782], [76, 168962], [84, 169927], [91, 170132], [99, 170632], [102, 170952], [105, 171132], [111, 171552], [114, 171692]]}, {"verse": 21, "start": 172432, "end": 182137, "text": "Bienaventurados los que ahora tenéis hambre; porque seréis saciados. Bienaventurados los que ahora lloráis, porque reiréis.", "words": [[0, 172432], [16, 173559], [20, 174139], [24, 174359], [30, 174599], [37, 175139], [45, 176082], [52, 176264], [59, 176764], [69, 178057], [85, 179157], [89, 179357], [93, 179557], [99, 179797], [108, 180577], [115, 180957]]}, {"verse": 22, "start": 182487, "end": 194447, "text": "Bienaventurados seréis, cuando los hombres os aborrezcan, y cuando os aparten de sí, y os insulten, y desechen vuestro nombre como malo, por el Hijo del hombre.", "words": [[0, 182487], [16, 183292], [24, 183792], [31, 184272], [35, 184592], [43, 184972], [46, 185642], [58, 186312], [60, 186872], [67, 187092], [70, 187312], [78, 187872], [81, 188012], [85, 188332], [87, 189132], [90, 189272], [100, 190272], [102, 190592], [111, 191192], [119, 191572], [126, 191932], [131, 192252], [137, 192852], [141, 193272], [144, 193412], [149, 193672], [153, 193872]]}, {"verse": 23, "start": 194797, "end": 204830, "text": "Gozaos en aquel día, y alegraos; porque he aquí vuestro recompensa es grande en los cielos; porque así hacían sus padres a los profetas.", "words": [[0, 195083], [7, 195403], [10, 195643], [16, 196003], [21, 196323], [23, 196983], [33, 197817], [40, 197943], [43, 198103], [48, 198443], [56, 198963], [67, 199863], [70, 200063], [77, 200523], [80, 200763], [84, 200863], [92, 201819], [99, 202139], [103, 202519], [110, 202979], [114, 203219], [121, 203679], [123, 203919], [127, 204039]]}, {"verse": 24, "start": 205180, "end": 209135, "text": "Pero ¡ay de vosotros, ricos! porque tenéis vuestro consuelo.", "words": [[0, 205180], [5, 205500], [9, 205820], [12, 206040], [22, 206500], [29, 207460], [36, 207644], [43, 208004], [51, 208344]]}, {"verse": 25, "start": 209485, "end": 219498, "text": "¡Ay de vosotros, los que estáis hartos! porque tendréis hambre. ¡Ay de vosotros, los que ahora reís! porque lamentaréis y lloraréis.", "words": [[0, 209584], [4, 209724], [7, 209924], [17, 210444], [21, 210664], [25, 210804], [32, 211224], [40, 212313], [47, 212518], [56, 213138], [64, 214155], [68, 214265], [71, 214445], [81, 215005], [85, 215565], [89, 215765], [95, 216005], [101, 217138], [108, 217278], [120, 218438], [122, 218578]]}, {"verse": 26, "start": 219848, "end": 228299, "text": "¡Ay de vosotros, cuando todos los hombres hablen bien de vosotros! porque así hacían sus padres a los falsos profetas.", "words": [[0, 219928], [4, 220038], [7, 220258], [17, 220838], [24, 221138], [30, 221598], [34, 221858], [42, 222218], [49, 222818], [54, 223098], [57, 223378], [67, 224439], [74, 224799], [78, 225199], [85, 226019], [89, 226239], [96, 226759], [98, 227039], [102, 227139], [109, 227579]]}, {"verse": 27, "start": 228649, "end": 234923, "text": "Pero a vosotros los que oís, digo: Amad a vuestros enemigos, haced bien a los que os aborrecen;", "words": [[0, 228649], [5, 228816], [7, 228916], [16, 229376], [20, 229596], [24, 229816], [29, 230156], [35, 231131], [40, 231297], [42, 231464], [51, 231864], [61, 232664], [67, 232964], [72, 233324], [74, 233664], [78, 233784], [82, 233924], [85, 234064]]}, {"verse": 28, "start": 235273, "end": 240385, "text": "Bendecid a los que os maldicen, y orad por los que os calumnian.", "words": [[0, 235763], [9, 236253], [11, 236493], [15, 236613], [19, 236753], [22, 236893], [32, 237466], [34, 238040], [39, 238613], [43, 238973], [47, 239193], [51, 239353], [54, 239493]]}, {"verse": 29, "start": 240735, "end": 248714, "text": "Y al que te hiera en la mejilla, dale también la otra; y al que te quite la capa, no le niegues tampoco la túnica.", "words": [[0, 240735], [2, 240874], [5, 241014], [9, 241174], [12, 241464], [18, 241754], [21, 241914], [24, 241994], [33, 243054], [38, 243354], [46, 243694], [49, 244014], [55, 244839], [57, 244941], [60, 245021], [64, 245161], [67, 245321], [73, 245561], [76, 245821], [82, 246721], [85, 246821], [88, 246961], [96, 247421], [104, 247701], [107, 248021]]}, {"verse": 30, "start": 249064, "end": 253985, "text": "Y a cualquiera que te pida, dale; y al que tome lo que es tuyo, no vuelvas a pedir.", "words": [[0, 249064], [2, 249150], [4, 249210], [15, 249690], [19, 249830], [22, 249990], [28, 250290], [34, 251015], [36, 251202], [39, 251322], [43, 251502], [48, 251942], [51, 252062], [55, 252202], [58, 252402], [64, 252742], [67, 252902], [75, 253382], [77, 253462]]}, {"verse": 31, "start": 254335, "end": 259735, "text": "Y como queréis que os hagan los hombres, así hacedles también vosotros:", "words": [[0, 254335], [2, 254438], [7, 254638], [15, 255138], [19, 255318], [22, 255478], [28, 255778], [32, 255958], [41, 257018], [45, 257358], [54, 258398], [62, 258718]]}, {"verse": 32, "start": 260085, "end": 267900, "text": "Porque si amáis a los que os aman, ¿qué gracias tendréis? porque también los pecadores aman a los que los aman.", "words": [[0, 260085], [7, 260329], [10, 260549], [16, 261069], [18, 261489], [22, 261609], [26, 261789], [29, 261969], [35, 262769], [40, 263009], [48, 263409], [58, 264466], [65, 264650], [73, 265150], [77, 265350], [87, 265910], [92, 266450], [94, 266850], [98, 266970], [102, 267090], [106, 267230]]}, {"verse": 33, "start": 268250, "end": 275438, "text": "Y si hacéis bien a los que os hacen bien, ¿qué gracias tendréis? porque también los pecadores hacen lo mismo.", "words": [[0, 268250], [2, 268371], [5, 268511], [12, 269031], [17, 269251], [19, 269531], [23, 269651], [27, 269818], [30, 269984], [36, 270151], [42, 270831], [47, 271351], [55, 271751], [65, 272994], [72, 273199], [80, 273579], [84, 273759], [94, 274279], [100, 274659], [103, 274859]]}, {"verse": 34, "start": 275788, "end": 285803, "text": "Y si prestáis a aquellos de quienes esperáis recibir, ¿qué gracias tendréis? porque también los pecadores prestan a los pecadores, para recibir otro tanto.", "words": [[0, 275788], [2, 276095], [5, 276235], [14, 276935], [16, 277155], [25, 277515], [28, 277795], [36, 278055], [45, 278675], [54, 279535], [59, 279655], [67, 280055], [77, 281303], [84, 281655], [92, 282095], [96, 282275], [106, 282835], [114, 283475], [116, 283555], [120, 283655], [131, 284115], [136, 284375], [144, 284855], [149, 285135]]}, {"verse": 35, "start": 286153, "end": 301120, "text": "Amad, pues, a vuestros enemigos, y haced bien, y prestad, no esperando de ello nada; y será vuestro recompensa grande, y seréis hijos del Altísimo: porque él es benigno para con los ingratos y malos.", "words": [[0, 286333], [6, 286553], [12, 286793], [14, 287033], [23, 287393], [33, 288013], [35, 288273], [41, 288533], [47, 288933], [49, 289623], [58, 290313], [61, 290393], [71, 290813], [74, 291093], [79, 291233], [85, 292021], [87, 292147], [92, 292387], [100, 292999], [111, 293832], [119, 294312], [121, 294812], [128, 295332], [134, 295752], [138, 296072], [148, 297342], [155, 297586], [158, 297966], [161, 298246], [169, 299086], [174, 299306], [178, 299546], [182, 299686], [191, 300246], [193, 300486]]}, {"verse": 36, "start": 301470, "end": 306135, "text": "Sed pues misericordiosos, como también vuestro Padre es misericordioso.", "words": [[0, 301470], [4, 301953], [9, 302533], [26, 303113], [31, 303333], [39, 303693], [47, 304093], [53, 304793], [56, 304953]]}, {"verse": 37, "start": 306485, "end": 314467, "text": "No juzguéis, y no seréis juzgados: no condenéis, y no seréis condenados: perdonad, y seréis perdonados.", "words": [[0, 306485], [3, 306812], [13, 307172], [15, 307392], [18, 307532], [25, 307892], [35, 308987], [38, 309207], [49, 309827], [51, 310247], [54, 310407], [61, 310867], [73, 312053], [83, 312647], [85, 312867], [92, 313327]]}, {"verse": 38, "start": 314817, "end": 326725, "text": "Dad, y se os dará; medida buena, apretada, sacudida, y rebosando darán en vuestro regazo: porque con la misma medida con que medís, os será vuelto a medir.", "words": [[0, 314817], [5, 315317], [7, 315637], [10, 315777], [13, 315957], [19, 316820], [26, 317030], [33, 317490], [43, 318290], [53, 318950], [55, 319450], [65, 319950], [71, 320510], [74, 320730], [82, 321374], [90, 322288], [97, 322438], [101, 322638], [104, 322778], [110, 323078], [117, 323758], [121, 323978], [125, 324198], [132, 324708], [135, 325218], [140, 325578], [147, 326138], [149, 326218]]}, {"verse": 39, "start": 327075, "end": 333186, "text": "Y les decía una parábola: ¿Puede el ciego guiar al ciego? ¿No caerán ambos en el hoyo?", "words": [[0, 327075], [2, 327202], [6, 327342], [12, 327762], [16, 328002], [26, 329056], [33, 329300], [36, 329440], [42, 329880], [48, 330280], [51, 330420], [58, 331278], [62, 331424], [69, 331984], [75, 332364], [78, 332584], [81, 332915]]}, {"verse": 40, "start": 333536, "end": 341265, "text": "El discípulo no es superior a su maestro; pero cualquiera que sea como el maestro, estará plenamente formado.", "words": [[0, 333536], [3, 333702], [13, 334462], [16, 334782], [19, 334982], [28, 335502], [30, 335782], [33, 335862], [42, 336905], [47, 337050], [58, 337570], [62, 337730], [66, 337950], [71, 338210], [74, 338350], [83, 339350], [90, 339930], [101, 340470]]}, {"verse": 41, "start": 341615, "end": 348669, "text": "¿Por qué miras la paja que está en el ojo de tu hermano, y la viga que está en tu propio ojo no consideras?", "words": [[0, 341672], [5, 341766], [9, 341859], [15, 342459], [18, 342759], [23, 343139], [27, 343299], [32, 343519], [35, 343719], [38, 343839], [42, 344119], [45, 344259], [48, 344379], [57, 345439], [59, 345559], [62, 345719], [67, 346019], [71, 346159], [76, 346359], [79, 346479], [82, 346619], [89, 346959], [93, 347459], [96, 347619]]}, {"verse": 42, "start": 349019, "end": 366394, "text": "¿O cómo puedes decir a tu hermano: Hermano, deja, echaré fuera la paja que está en tu ojo, no mirando tú la viga que está en tu ojo? Hipócrita, echa primero fuera de tu ojo la viga, y entonces verás bien para sacar la paja que está en el ojo de tu hermano.", "words": [[0, 349019], [3, 349136], [8, 349396], [15, 349856], [21, 350316], [23, 350496], [26, 350616], [35, 351450], [44, 352258], [50, 352878], [57, 353613], [63, 353873], [66, 354153], [71, 354553], [75, 354753], [80, 354933], [83, 355093], [86, 355313], [91, 355793], [94, 356293], [102, 356753], [105, 357053], [108, 357233], [113, 357553], [117, 357693], [122, 357893], [125, 358033], [128, 358213], [133, 358922], [144, 359433], [149, 359983], [157, 360343], [163, 360663], [166, 360923], [169, 361103], [173, 361343], [176, 361503], [182, 361883], [184, 362023], [193, 362423], [199, 363323], [204, 363503], [209, 363823], [215, 364163], [218, 364423], [223, 364763], [227, 364903], [232, 365123], [235, 365223], [238, 365343], [242, 365583], [245, 365703], [248, 365843]]}, {"verse": 43, "start": 366744, "end": 372423, "text": "Porque no es buen árbol el que da malos frutos; ni árbol malo el que da buen fruto.", "words": [[0, 366744], [7, 366969], [10, 367229], [13, 367429], [18, 367629], [24, 368149], [27, 368409], [31, 368549], [34, 368709], [40, 369029], [48, 370161], [51, 370251], [57, 370651], [62, 371111], [65, 371238], [69, 371364], [72, 371491], [77, 371731]]}, {"verse": 44, "start": 372773, "end": 381836, "text": "Porque cada árbol por su fruto es conocido: que no cogen higos de los espinos, ni vendimian uvas de las zarzas.", "words": [[0, 372773], [7, 372958], [12, 373358], [18, 373938], [22, 374178], [25, 374398], [31, 374858], [34, 374978], [44, 376077], [48, 376160], [51, 376320], [57, 376880], [63, 377340], [66, 377500], [70, 377640], [79, 378353], [82, 379067], [92, 379780], [97, 380440], [100, 380760], [104, 381321]]}, {"verse": 45, "start": 382186, "end": 393066, "text": "El buen hombre del buen tesoro de su corazón saca bien; y el mal hombre del mal tesoro de su corazón saca mal; porque de la abundancia del corazón habla su boca.", "words": [[0, 382186], [3, 382310], [8, 382490], [15, 382790], [19, 383010], [24, 383210], [31, 383690], [34, 383810], [37, 383970], [45, 384410], [50, 384790], [56, 385487], [58, 385627], [61, 385767], [65, 386047], [72, 386627], [76, 386807], [80, 387067], [87, 387567], [90, 387707], [93, 387867], [101, 388307], [106, 388767], [111, 389462], [118, 389607], [121, 390167], [124, 390327], [135, 391167], [139, 391347], [147, 391847], [153, 392307], [156, 392507]]}, {"verse": 46, "start": 393416, "end": 396876, "text": "¿Por qué me llamáis, Señor, Señor, y no hacéis lo que digo?", "words": [[0, 393416], [5, 393520], [9, 393660], [12, 393780], [21, 394400], [28, 394880], [35, 395460], [37, 395540], [40, 395680], [47, 396120], [50, 396260], [54, 396400]]}, {"verse": 47, "start": 397226, "end": 404080, "text": "Todo aquel que viene a mí, y oye mis palabras, y las hace, os enseñaré a quién es semejante:", "words": [[0, 397226], [5, 397411], [11, 397851], [15, 397971], [21, 398231], [23, 398391], [27, 398571], [29, 398871], [33, 399131], [37, 399291], [47, 399791], [49, 400411], [53, 400611], [59, 401471], [62, 401591], [71, 402311], [73, 402511], [79, 402671], [82, 403071]]}, {"verse": 48, "start": 404430, "end": 421535, "text": "Semejante es al hombre que edifica una casa, el cual cavó y ahondó, y puso el fundamento sobre la roca; y cuando vino una crecida, el río dio con ímpetu en aquella casa, pero no la pudo mover: porque estaba fundada sobre la roca.", "words": [[0, 404793], [10, 405193], [13, 405433], [16, 405593], [23, 405853], [27, 406093], [35, 406813], [39, 407093], [45, 407933], [48, 408233], [53, 408663], [58, 409093], [60, 409233], [68, 409813], [70, 410293], [75, 410673], [78, 410793], [89, 411433], [95, 411673], [98, 411893], [104, 412724], [106, 412842], [113, 413062], [118, 413362], [122, 414015], [131, 414667], [134, 414807], [138, 415107], [142, 415327], [146, 415627], [153, 416427], [156, 416607], [164, 416907], [170, 417767], [175, 417887], [178, 418107], [181, 418227], [186, 418507], [193, 419274], [200, 419438], [207, 419718], [215, 420378], [221, 420658], [224, 420898]]}, {"verse": 49, "start": 421885, "end": 435966, "text": "Pero el que oyó y no hizo, semejante es al hombre que edificó su casa sobre tierra, sin fundamento; en la cual el río dio con ímpetu, y luego cayó; y fue grande la ruina de aquella casa.", "words": [[0, 421885], [5, 422047], [8, 422187], [12, 422347], [16, 422727], [18, 422927], [21, 423047], [27, 423887], [37, 424667], [40, 425027], [43, 425327], [50, 425607], [54, 425847], [62, 426467], [65, 426627], [70, 426927], [76, 427227], [84, 427667], [88, 428347], [100, 429686], [103, 429814], [106, 429934], [111, 430194], [114, 430534], [118, 430894], [122, 431074], [126, 431334], [134, 431934], [136, 432334], [142, 432554], [148, 433463], [150, 433569], [154, 433729], [161, 434049], [164, 434309], [170, 434769], [173, 434949], [181, 435309]]}]}