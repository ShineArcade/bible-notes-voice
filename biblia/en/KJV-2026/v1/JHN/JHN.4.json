{"book": "JHN", "chapter": 4, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 350426, "verses": [{"verse": 1, "start": 300, "end": 6697, "text": "When therefore the Lord knew how the Pharisees had heard that Jesus made and baptized more disciples than John,", "words": [[0, 300], [5, 430], [15, 870], [19, 1130], [24, 1370], [29, 1670], [33, 1910], [37, 2070], [47, 2790], [51, 2950], [57, 3190], [62, 3390], [68, 3670], [73, 4170], [77, 4370], [86, 4750], [91, 5230], [101, 5750], [106, 6110]]}, {"verse": 2, "start": 7047, "end": 10742, "text": "(Though Jesus himself baptized not, but his disciples,)", "words": [[0, 7047], [8, 7234], [14, 7574], [22, 8134], [31, 8654], [36, 9294], [40, 9694], [44, 9874]]}, {"verse": 3, "start": 11092, "end": 13876, "text": "He left Judæa, and departed again into Galilee.", "words": [[0, 11092], [3, 11162], [8, 11582], [15, 12002], [19, 12162], [28, 12542], [34, 12922], [39, 13122]]}, {"verse": 4, "start": 14226, "end": 16166, "text": "And he must needs go through Samaria.", "words": [[0, 14226], [4, 14354], [7, 14434], [12, 14594], [18, 14954], [21, 15214], [29, 15434]]}, {"verse": 5, "start": 16516, "end": 24234, "text": "Then comes he to a city of Samaria, which is called Sychar, near to the parcel of ground that Jacob gave to his son Joseph.", "words": [[0, 16516], [5, 16734], [11, 17094], [14, 17294], [17, 17494], [19, 17634], [24, 17874], [27, 18054], [36, 19114], [42, 19134], [45, 19274], [52, 19904], [60, 20534], [65, 20794], [68, 20974], [72, 21054], [79, 21414], [82, 21634], [89, 22034], [94, 22374], [100, 22674], [105, 23034], [108, 23234], [112, 23394], [116, 23634]]}, {"verse": 6, "start": 24584, "end": 32585, "text": "Now Jacob’s well was there. Jesus therefore, being wearied with his journey, sat thus on the well: and it was about the sixth hour.", "words": [[0, 24584], [4, 24791], [12, 25331], [17, 25571], [21, 25851], [28, 26517], [34, 26917], [45, 27437], [51, 27637], [59, 28157], [64, 28337], [68, 28477], [77, 29397], [81, 29637], [86, 29897], [89, 30157], [93, 30277], [99, 30943], [103, 31069], [106, 31149], [110, 31329], [116, 31549], [120, 31749], [126, 31989]]}, {"verse": 7, "start": 32935, "end": 38118, "text": "There comes a woman of Samaria to draw water: Jesus says to her, Give me to drink.", "words": [[0, 32935], [6, 33097], [12, 33357], [14, 33517], [20, 33737], [23, 33937], [31, 34477], [34, 34697], [39, 34937], [46, 35740], [52, 36170], [57, 36510], [60, 36750], [65, 37188], [70, 37332], [73, 37512], [76, 37632]]}, {"verse": 8, "start": 38398, "end": 41590, "text": "(For his disciples were gone away to the city to buy food.)", "words": [[0, 38398], [5, 38515], [9, 38655], [19, 39175], [24, 39435], [29, 39695], [34, 39995], [37, 40195], [41, 40315], [46, 40575], [49, 40775], [53, 41015]]}, {"verse": 9, "start": 41940, "end": 52229, "text": "Then says the woman of Samaria to him, How is it that you, being a Jew, ask drink of me, which am a woman of Samaria? for the Jews have no dealings with the Samaritans.", "words": [[0, 41940], [5, 42164], [10, 42444], [14, 42664], [20, 42904], [23, 43064], [31, 43564], [34, 43764], [39, 44576], [43, 44776], [46, 44976], [49, 45096], [54, 45216], [59, 45576], [65, 45716], [67, 45896], [72, 46576], [76, 47056], [82, 47196], [85, 47376], [89, 47896], [95, 48176], [98, 48236], [100, 48316], [106, 48496], [109, 48636], [118, 49635], [122, 49724], [126, 49824], [131, 50044], [136, 50384], [139, 50624], [148, 51124], [153, 51244], [157, 51344]]}, {"verse": 10, "start": 52509, "end": 61536, "text": "Jesus answered and said to her, If you knew the gift of God, and who it is that says to you, Give me to drink; you would have asked of him, and he would have given you living water.", "words": [[0, 52509], [6, 52753], [15, 53273], [19, 53513], [24, 53693], [27, 53873], [32, 54374], [35, 54500], [39, 54620], [44, 54840], [48, 55000], [53, 55240], [56, 55400], [61, 55760], [65, 56240], [69, 56420], [72, 56540], [75, 56720], [80, 56900], [85, 57100], [88, 57320], [93, 57388], [98, 57456], [101, 57524], [104, 57592], [111, 58686], [115, 58819], [121, 58959], [126, 59039], [132, 59319], [135, 59459], [140, 59819], [144, 59999], [147, 60139], [153, 60259], [158, 60359], [164, 60559], [168, 60759], [175, 60999]]}, {"verse": 11, "start": 61816, "end": 70038, "text": "The woman says to him, Sir, you have nothing to draw with, and the well is deep: from where then have you that living water?", "words": [[0, 61816], [4, 61936], [10, 62116], [15, 62416], [18, 62636], [23, 63218], [28, 63618], [32, 63758], [37, 64058], [45, 64458], [48, 64678], [53, 64958], [59, 65698], [63, 65898], [67, 66038], [72, 66338], [75, 66718], [81, 67491], [86, 67639], [92, 67919], [97, 68179], [102, 68519], [106, 68659], [111, 68899], [118, 69139]]}, {"verse": 12, "start": 70388, "end": 77585, "text": "Are you greater than our father Jacob, which gave us the well, and drank of it himself, and his children, and his cattle?", "words": [[0, 70388], [4, 70548], [8, 70828], [16, 71168], [21, 71488], [25, 71648], [32, 71948], [39, 72888], [45, 73108], [50, 73328], [53, 73528], [57, 73688], [63, 73968], [67, 74278], [73, 74588], [76, 74768], [79, 74888], [88, 75308], [92, 75788], [96, 75948], [106, 76388], [110, 76888], [114, 77048]]}, {"verse": 13, "start": 77865, "end": 82047, "text": "Jesus answered and said to her, Whoever drinks of this water shall thirst again:", "words": [[0, 77865], [6, 78109], [15, 78629], [19, 78869], [24, 79049], [27, 79229], [32, 79730], [40, 79964], [47, 80324], [50, 80504], [55, 80684], [61, 80964], [67, 81184], [74, 81464]]}, {"verse": 14, "start": 82397, "end": 91671, "text": "But whoever drinks of the water that I shall give him shall never thirst; but the water that I shall give him shall be in him a well of water springing up into everlasting life.", "words": [[0, 82397], [4, 82494], [12, 82714], [19, 83094], [22, 83254], [26, 83354], [32, 83594], [37, 83774], [39, 83914], [45, 84074], [50, 84314], [54, 84494], [60, 84694], [66, 84934], [74, 85793], [78, 85863], [82, 86003], [88, 86263], [93, 86483], [95, 86643], [101, 86803], [106, 87023], [110, 87303], [116, 87763], [119, 87983], [122, 88183], [126, 88383], [128, 88603], [133, 88823], [136, 89003], [142, 89263], [152, 89803], [155, 89983], [160, 90403], [172, 90923]]}, {"verse": 15, "start": 91951, "end": 98050, "text": "The woman says to him, Sir, give me this water, that I thirst not, neither come here to draw.", "words": [[0, 91951], [4, 92071], [10, 92251], [15, 92551], [18, 92771], [23, 93354], [28, 93834], [33, 94114], [36, 94314], [41, 94554], [48, 95254], [53, 95474], [55, 95634], [62, 95874], [67, 96594], [75, 96794], [80, 97134], [85, 97334], [88, 97494]]}, {"verse": 16, "start": 98330, "end": 101670, "text": "Jesus says to her, Go, call your husband, and come here.", "words": [[0, 98330], [6, 98570], [11, 98910], [14, 99130], [19, 99684], [23, 99801], [28, 100041], [33, 100201], [42, 100521], [46, 101021], [51, 101241]]}, {"verse": 17, "start": 101950, "end": 108996, "text": "The woman answered and said, I have no husband. Jesus said to her, You have well said, I have no husband:", "words": [[0, 101950], [4, 102045], [10, 102265], [19, 102745], [23, 103025], [29, 103677], [31, 103954], [36, 104194], [39, 104494], [48, 105566], [54, 105836], [59, 106176], [62, 106396], [67, 106872], [71, 106994], [76, 107154], [81, 107354], [87, 107814], [89, 107994], [94, 108214], [97, 108394]]}, {"verse": 18, "start": 109346, "end": 115103, "text": "For you have had five husbands; and he whom you now have is not your husband: in that did you say truly.", "words": [[0, 109346], [4, 109435], [8, 109575], [13, 109715], [17, 109895], [22, 110175], [32, 111124], [36, 111246], [39, 111446], [44, 111626], [48, 111806], [52, 111986], [57, 112286], [60, 112466], [64, 112666], [69, 112826], [78, 113631], [81, 113774], [86, 114114], [90, 114174], [94, 114314], [98, 114514]]}, {"verse": 19, "start": 115383, "end": 120011, "text": "The woman says to him, Sir, I perceive that you are a prophet.", "words": [[0, 115383], [4, 115503], [10, 115683], [15, 115983], [18, 116203], [23, 116786], [28, 117691], [30, 117891], [39, 118311], [44, 118691], [48, 118971], [52, 119271], [54, 119351]]}, {"verse": 20, "start": 120291, "end": 126468, "text": "Our fathers worshipped in this mountain; and you say, that in Jerusalem is the place where men ought to worship.", "words": [[0, 120291], [4, 120418], [12, 120998], [23, 121578], [26, 121698], [31, 121878], [41, 122663], [45, 122780], [49, 122920], [54, 123220], [59, 123660], [62, 123820], [72, 124320], [75, 124600], [79, 124720], [85, 125000], [91, 125240], [95, 125500], [101, 125780], [104, 125980]]}, {"verse": 21, "start": 126818, "end": 135091, "text": "Jesus says to her, Woman, believe me, the hour comes, when you shall neither in this mountain, nor yet at Jerusalem, worship the Father.", "words": [[0, 126818], [6, 127055], [11, 127375], [14, 127595], [19, 128136], [26, 128573], [34, 128693], [38, 129533], [42, 129633], [47, 129893], [54, 130353], [59, 130913], [63, 131053], [69, 131213], [77, 131473], [80, 131673], [85, 131813], [95, 132173], [99, 132733], [103, 133013], [106, 133233], [117, 133753], [125, 134313], [129, 134573]]}, {"verse": 22, "start": 135441, "end": 140871, "text": "You worship you know not what: we know what we worship: for salvation is of the Jews.", "words": [[0, 135441], [4, 135561], [12, 136101], [16, 136161], [21, 136341], [25, 136541], [31, 137227], [34, 137372], [39, 137652], [44, 137952], [47, 138112], [56, 138885], [60, 139036], [70, 139476], [73, 140036], [76, 140176], [80, 140296]]}, {"verse": 23, "start": 141221, "end": 149524, "text": "But the hour comes, and now is, when the true worshippers shall worship the Father in spirit and in truth: for the Father seeks such to worship him.", "words": [[0, 141221], [4, 141320], [8, 141460], [13, 141660], [20, 142360], [24, 142620], [28, 142880], [32, 143440], [37, 143680], [41, 143800], [46, 144040], [58, 144600], [64, 144880], [72, 145260], [76, 145440], [83, 145660], [86, 145880], [93, 146240], [97, 146740], [100, 146860], [107, 147496], [111, 147585], [115, 147685], [122, 147925], [128, 148265], [133, 148545], [136, 148745], [144, 148985]]}, {"verse": 24, "start": 149874, "end": 155631, "text": "God is a Spirit: and they that worship him must worship him in spirit and in truth.", "words": [[0, 149874], [4, 150231], [7, 150611], [9, 150751], [17, 151600], [21, 151763], [26, 152003], [31, 152243], [39, 152603], [43, 152983], [48, 153263], [56, 153703], [60, 154043], [63, 154303], [70, 154723], [74, 155043], [77, 155163]]}, {"verse": 25, "start": 155911, "end": 163250, "text": "The woman says to him, I know that Messias comes, which is called Christ: when he is come, he will tell us all things.", "words": [[0, 155911], [4, 156031], [10, 156211], [15, 156511], [18, 156731], [23, 157313], [25, 157433], [30, 157593], [35, 158003], [43, 158413], [50, 158873], [56, 159073], [59, 159213], [66, 159473], [74, 160593], [79, 160721], [82, 160911], [85, 161101], [91, 161621], [94, 161701], [99, 161841], [104, 162061], [107, 162281], [111, 162501]]}, {"verse": 26, "start": 163530, "end": 166878, "text": "Jesus says to her, I that speak to you am he.", "words": [[0, 163530], [6, 163770], [11, 164110], [14, 164330], [19, 164884], [21, 165128], [26, 165388], [32, 165668], [35, 165928], [39, 166188], [42, 166533]]}, {"verse": 27, "start": 167158, "end": 176246, "text": "¶ And upon this came his disciples, and marvelled that he talked with the woman: yet no man said, What do you seek? or, Why do you talk with her?", "words": [[2, 167158], [6, 167331], [11, 167571], [16, 167971], [21, 168331], [25, 168571], [36, 169591], [40, 170011], [50, 170431], [55, 170551], [58, 170691], [65, 170971], [70, 171211], [74, 171351], [81, 172064], [85, 172214], [88, 172494], [92, 172734], [98, 173514], [103, 173754], [106, 173954], [110, 174054], [116, 174810], [120, 174935], [124, 175155], [127, 175315], [131, 175395], [136, 175655], [141, 175915]]}, {"verse": 28, "start": 176596, "end": 181267, "text": "The woman then left her waterpot, and went her way into the city, and says to the men,", "words": [[0, 176596], [4, 176690], [10, 176930], [15, 177190], [20, 177450], [24, 177810], [34, 178170], [38, 178430], [43, 178630], [47, 178810], [51, 179010], [56, 179230], [60, 179410], [66, 179690], [70, 180230], [75, 180450], [78, 180690], [82, 180810]]}, {"verse": 29, "start": 181467, "end": 186979, "text": "Come, see a man, which told me all things that ever I did: is not this the Christ?", "words": [[0, 181467], [6, 181647], [10, 181927], [12, 182067], [17, 182367], [23, 182787], [28, 183147], [31, 183347], [35, 183607], [42, 183967], [47, 184247], [52, 184527], [54, 184747], [59, 185386], [62, 185552], [66, 185812], [71, 186132], [75, 186312]]}, {"verse": 30, "start": 187259, "end": 190088, "text": "Then they went out of the city, and came to him.", "words": [[0, 187259], [5, 187542], [10, 187802], [15, 188002], [19, 188262], [22, 188402], [26, 188522], [32, 188822], [36, 189282], [41, 189582], [44, 189822]]}, {"verse": 31, "start": 190438, "end": 194203, "text": "¶ In the mean while his disciples prayed him, saying, Master, eat.", "words": [[2, 190438], [5, 190583], [9, 190703], [14, 190943], [20, 191243], [24, 191423], [34, 191923], [41, 192303], [46, 192763], [54, 193444], [62, 193847]]}, {"verse": 32, "start": 194483, "end": 197840, "text": "But he said to them, I have food to eat that you know not of.", "words": [[0, 194483], [4, 194611], [7, 194691], [12, 194891], [15, 195091], [21, 195609], [23, 195750], [28, 195970], [33, 196250], [36, 196470], [40, 196710], [45, 196930], [49, 197110], [54, 197290], [58, 197490]]}, {"verse": 33, "start": 198120, "end": 203037, "text": "Therefore said the disciples one to another, Has any man brought him anything to eat?", "words": [[0, 198120], [10, 198480], [15, 198840], [19, 199020], [29, 199520], [33, 199920], [36, 200160], [45, 200877], [49, 201062], [53, 201302], [57, 201602], [65, 201842], [69, 202042], [78, 202362], [81, 202622]]}, {"verse": 34, "start": 203317, "end": 208349, "text": "Jesus says to them, My food is to do the will of him that sent me, and to finish his work.", "words": [[0, 203317], [6, 203601], [11, 203941], [14, 204181], [20, 204788], [23, 204951], [28, 205231], [31, 205391], [34, 205531], [37, 205651], [41, 205771], [46, 205951], [49, 206111], [53, 206271], [58, 206471], [63, 206711], [67, 206951], [71, 207251], [74, 207391], [81, 207631], [85, 207871]]}, {"verse": 35, "start": 208699, "end": 219000, "text": "Say not you, There are yet four months, and then comes harvest? behold, I say to you, Lift up your eyes, and look on the fields; for they are white already to harvest.", "words": [[0, 208699], [4, 208904], [8, 209104], [13, 209464], [19, 209564], [23, 209664], [27, 209864], [32, 210144], [40, 210804], [44, 210964], [49, 211084], [55, 211324], [64, 212236], [72, 212754], [74, 212834], [78, 213074], [81, 213254], [86, 213894], [91, 214154], [94, 214434], [99, 214574], [105, 214994], [109, 215454], [114, 215634], [117, 215794], [121, 215934], [129, 216805], [133, 216892], [138, 217072], [142, 217212], [148, 217532], [156, 218112], [159, 218372]]}, {"verse": 36, "start": 219350, "end": 226850, "text": "And he that reaps receives wages, and gathers fruit to life eternal: that both he that sows and he that reaps may rejoice together.", "words": [[0, 219350], [4, 219493], [7, 219653], [12, 219873], [18, 220273], [27, 220713], [34, 221213], [38, 221693], [46, 222033], [52, 222353], [55, 222533], [60, 222753], [69, 223540], [74, 223665], [79, 223905], [82, 224125], [87, 224305], [92, 224725], [96, 224945], [99, 225065], [104, 225245], [110, 225585], [114, 225805], [122, 226185]]}, {"verse": 37, "start": 227200, "end": 230872, "text": "And herein is that saying true, One sows, and another reaps.", "words": [[0, 227200], [4, 227412], [11, 227662], [14, 227842], [19, 228022], [26, 228382], [32, 228662], [36, 229002], [42, 229482], [46, 229902], [54, 230182]]}, {"verse": 38, "start": 231222, "end": 237739, "text": "I sent you to reap that on which you bestowed no labour: other men laboured, and you are entered into their labours.", "words": [[0, 231222], [2, 231347], [7, 231607], [11, 231787], [14, 231927], [19, 232167], [24, 232407], [27, 232627], [33, 232827], [37, 233007], [46, 233527], [49, 233987], [57, 234653], [63, 234852], [67, 235302], [77, 235752], [81, 235972], [85, 236112], [89, 236232], [97, 236572], [102, 236952], [108, 237372]]}, {"verse": 39, "start": 238019, "end": 246164, "text": "¶ And many of the Samaritans of that city believed on him for the saying of the woman, which testified, He told me all that ever I did.", "words": [[2, 238019], [6, 238164], [11, 238424], [14, 238584], [18, 238704], [29, 239364], [32, 239484], [37, 239664], [42, 239964], [51, 240364], [54, 240684], [58, 240884], [62, 241084], [66, 241204], [73, 241524], [76, 241704], [80, 241844], [87, 242684], [93, 242864], [104, 244039], [107, 244139], [112, 244359], [115, 244559], [119, 244879], [124, 245119], [129, 245419], [131, 245679]]}, {"verse": 40, "start": 246444, "end": 253116, "text": "So when the Samaritans were come to him, they besought him that he would stay with them: and he stayed there two days.", "words": [[0, 246444], [3, 246564], [8, 246764], [12, 246904], [23, 247544], [28, 247684], [33, 247984], [36, 248204], [41, 248824], [46, 248984], [55, 249424], [59, 249644], [64, 249824], [67, 249924], [73, 250104], [78, 250404], [83, 250684], [89, 251314], [93, 251482], [96, 251602], [103, 251862], [109, 252222], [113, 252462]]}, {"verse": 41, "start": 253466, "end": 256286, "text": "And many more believed because of his own word;", "words": [[0, 253466], [4, 253628], [9, 253868], [14, 254148], [23, 254588], [31, 255068], [34, 255288], [38, 255428], [42, 255628]]}, {"verse": 42, "start": 256636, "end": 265731, "text": "And said to the woman, Now we believe, not because of your saying: for we have heard him ourselves, and know that this is indeed the Christ, the Saviour of the world.", "words": [[0, 256636], [4, 256757], [9, 257077], [12, 257337], [16, 257457], [23, 258163], [27, 258440], [30, 258660], [39, 259040], [43, 259380], [51, 259740], [54, 259960], [59, 260080], [67, 260813], [71, 260883], [74, 261043], [79, 261183], [85, 261463], [89, 261603], [100, 262123], [104, 262703], [109, 262983], [114, 263183], [119, 263383], [122, 263503], [129, 263803], [133, 264023], [141, 264543], [145, 264733], [153, 264923], [156, 265143], [160, 265263]]}, {"verse": 43, "start": 266011, "end": 270097, "text": "¶ Now after two days he departed from there, and went into Galilee.", "words": [[2, 266011], [6, 266182], [12, 266482], [16, 266762], [21, 267122], [24, 267302], [33, 267722], [38, 268082], [45, 268402], [49, 268687], [54, 268907], [59, 269207]]}, {"verse": 44, "start": 270447, "end": 274927, "text": "For Jesus himself testified, that a prophet has no honour in his own country.", "words": [[0, 270447], [4, 270554], [10, 270854], [18, 271334], [29, 271974], [34, 272414], [36, 272514], [44, 272874], [48, 273174], [51, 273474], [58, 273774], [61, 273994], [65, 274154], [69, 274294]]}, {"verse": 45, "start": 275277, "end": 283661, "text": "Then when he was come into Galilee, the Galilæans received him, having seen all the things that he did at Jerusalem at the feast: for they also went to the feast.", "words": [[0, 275277], [5, 275457], [10, 275617], [13, 275757], [17, 275957], [22, 276157], [27, 276357], [36, 277017], [40, 277347], [50, 277677], [59, 278077], [64, 278757], [71, 278937], [76, 279257], [80, 279557], [84, 279737], [91, 279977], [96, 280197], [99, 280297], [103, 280517], [106, 280617], [116, 281037], [119, 281297], [123, 281397], [130, 282110], [134, 282200], [139, 282340], [144, 282600], [149, 282880], [152, 283040], [156, 283140]]}, {"verse": 46, "start": 284011, "end": 292318, "text": "So Jesus came again into Cana of Galilee, where he made the water wine. And there was a certain nobleman, whose son was sick at Capernaum.", "words": [[0, 284011], [3, 284131], [9, 284451], [14, 284831], [20, 285171], [25, 285391], [30, 285931], [33, 286071], [42, 287071], [48, 287231], [51, 287391], [56, 287591], [60, 287731], [66, 287971], [72, 288701], [76, 288827], [82, 288927], [86, 289087], [88, 289247], [96, 289467], [106, 290127], [112, 290347], [116, 290707], [120, 290887], [125, 291227], [128, 291427]]}, {"verse": 47, "start": 292668, "end": 301650, "text": "When he heard that Jesus was come out of Judæa into Galilee, he went to him, and besought him that he would come down, and heal his son: for he was at the point of death.", "words": [[0, 292668], [5, 292774], [8, 292894], [14, 293134], [19, 293314], [25, 293614], [29, 293894], [34, 294074], [38, 294254], [41, 294534], [47, 294814], [52, 294934], [61, 296014], [64, 296074], [69, 296294], [72, 296474], [77, 296694], [81, 296954], [90, 297374], [94, 297594], [99, 297894], [102, 297994], [108, 298094], [113, 298294], [119, 298614], [123, 298954], [128, 299154], [132, 299374], [137, 300070], [141, 300210], [144, 300410], [148, 300630], [151, 300790], [155, 300930], [161, 301170], [164, 301330]]}, {"verse": 48, "start": 302000, "end": 307122, "text": "Then said Jesus to him, Unless you see signs and wonders, you will not believe.", "words": [[0, 302000], [5, 302205], [10, 302485], [16, 302825], [19, 303145], [24, 303644], [31, 303893], [35, 304113], [39, 304333], [45, 304733], [49, 304973], [58, 305873], [62, 306033], [67, 306173], [71, 306393]]}, {"verse": 49, "start": 307402, "end": 312449, "text": "The nobleman says to him, Sir, come down before my child die.", "words": [[0, 307402], [4, 307489], [13, 308029], [18, 308289], [21, 308529], [26, 309497], [31, 310112], [36, 310292], [41, 310532], [48, 310812], [51, 311052], [57, 311312]]}, {"verse": 50, "start": 312729, "end": 321758, "text": "Jesus says to him, Go your way; your son lives. And the man believed the word that Jesus had spoken to him, and he went his way.", "words": [[0, 312729], [6, 312984], [11, 313344], [14, 313584], [19, 314859], [22, 314999], [27, 315179], [32, 315901], [37, 316001], [41, 316281], [48, 317211], [52, 317339], [56, 317439], [60, 317679], [69, 318079], [73, 318319], [78, 318579], [83, 318779], [89, 319099], [93, 319399], [100, 319779], [103, 320059], [108, 320499], [112, 320679], [115, 320819], [120, 321019], [124, 321239]]}, {"verse": 51, "start": 322108, "end": 327486, "text": "And as he was now going down, his servants met him, and told him, saying, Your son lives.", "words": [[0, 322108], [4, 322249], [7, 322449], [10, 322569], [14, 322749], [18, 322949], [24, 323249], [30, 323909], [34, 324009], [43, 324369], [47, 324709], [52, 324909], [56, 325069], [61, 325309], [66, 325629], [74, 326403], [79, 326536], [83, 326836]]}, {"verse": 52, "start": 327766, "end": 335332, "text": "Then enquired he of them the hour when he began to amend. And they said to him, Yesterday at the seventh hour the fever left him.", "words": [[0, 327766], [5, 328156], [14, 328546], [17, 328706], [20, 328886], [25, 329066], [29, 329286], [34, 329606], [39, 329886], [42, 330026], [48, 330326], [51, 330526], [58, 331324], [62, 331452], [67, 331592], [72, 331832], [75, 332052], [80, 332562], [90, 332826], [93, 333246], [97, 333346], [105, 333626], [110, 334326], [114, 334406], [120, 334706], [125, 335006]]}, {"verse": 53, "start": 335612, "end": 344029, "text": "So the father knew that it was at the same hour, in which Jesus said to him, Your son lives: and himself believed, and his whole house.", "words": [[0, 335612], [3, 335732], [7, 335872], [14, 336172], [19, 336532], [24, 336812], [27, 336912], [31, 337052], [34, 337192], [38, 337292], [43, 337572], [49, 337892], [52, 338412], [58, 338592], [64, 338932], [69, 339332], [72, 339532], [77, 340032], [82, 340212], [86, 340492], [93, 341433], [97, 341574], [105, 341914], [115, 342464], [119, 343014], [123, 343174], [129, 343414]]}, {"verse": 54, "start": 344379, "end": 350025, "text": "This is again the second miracle that Jesus did, when he was come out of Judæa into Galilee.", "words": [[0, 344379], [5, 344622], [8, 344782], [14, 345022], [18, 345242], [25, 345502], [33, 345982], [38, 346222], [44, 346482], [49, 346922], [54, 347602], [57, 347722], [61, 347862], [66, 348082], [70, 348282], [73, 348642], [79, 349002], [84, 349222]]}]}