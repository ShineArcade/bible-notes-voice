{"book": "ROM", "chapter": 16, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 191408, "verses": [{"verse": 1, "start": 300, "end": 6200, "text": "Pero os recomiendo a Febe nuestra hermana, la cual es diaconisa de la iglesia que está en Cencrea:", "words": [[0, 300], [5, 480], [8, 640], [19, 1220], [21, 1480], [26, 1740], [34, 1920], [43, 2880], [46, 2980], [51, 3180], [54, 3400], [64, 4000], [67, 4160], [70, 4260], [78, 4640], [82, 4800], [87, 5020], [90, 5635]]}, {"verse": 2, "start": 6650, "end": 16524, "text": "Que la recibáis en el Señor, como es digno a los santos, y que la ayudéis en cualquiera cosa en que necesite de vosotros: porque ella ha ayudado a muchos, y a mí mismo.", "words": [[0, 6650], [4, 6747], [7, 6847], [16, 7447], [19, 7627], [22, 7747], [29, 8087], [34, 8547], [37, 8727], [43, 9087], [45, 9087], [49, 9187], [57, 10087], [59, 10227], [63, 10367], [66, 10507], [74, 10987], [77, 11187], [88, 11387], [93, 11907], [96, 12087], [100, 12167], [109, 12747], [112, 12867], [122, 13873], [129, 14057], [134, 14397], [137, 14617], [145, 14997], [147, 15117], [155, 15417], [157, 15817], [159, 15877], [162, 15997]]}, {"verse": 3, "start": 16974, "end": 20831, "text": "Saludad a Priscila y a Aquila, mis colaboradores en Cristo Jesús;", "words": [[0, 17136], [8, 17302], [10, 17469], [19, 18129], [21, 18189], [23, 18249], [31, 18749], [35, 18849], [49, 19629], [52, 19889], [59, 20169]]}, {"verse": 4, "start": 21281, "end": 28460, "text": "(Que pusieron sus cuellos por mi vida: a los cuales no doy gracias yo solo, sino también todas las iglesias de los Gentiles;)", "words": [[0, 21281], [5, 21360], [14, 21800], [18, 22100], [26, 22400], [30, 22600], [33, 22780], [39, 23490], [41, 23601], [45, 23701], [52, 23961], [55, 24301], [59, 24521], [67, 24781], [70, 25041], [76, 25801], [81, 25961], [89, 26361], [95, 26661], [99, 26961], [108, 27481], [111, 27621], [115, 27721]]}, {"verse": 5, "start": 28910, "end": 35413, "text": "Asimismo a la iglesia de su casa. Saludad a Epeneto, amado mío, que es las primicias de Acaya en Cristo.", "words": [[0, 28910], [9, 29570], [11, 29690], [14, 29750], [22, 30130], [25, 30270], [28, 30430], [34, 31231], [42, 31776], [44, 31856], [53, 32336], [59, 32636], [64, 33156], [68, 33256], [71, 33416], [75, 33556], [85, 34136], [88, 34356], [94, 34716], [97, 34836]]}, {"verse": 6, "start": 35863, "end": 38971, "text": "Saludad a María, la cual ha trabajado mucho con vosotros.", "words": [[0, 35863], [8, 36321], [10, 36401], [17, 36741], [20, 36841], [25, 37081], [28, 37241], [38, 37781], [44, 38001], [48, 38281]]}, {"verse": 7, "start": 39421, "end": 49533, "text": "Saludad a Andrónico y a Junias, mis parientes, y mis compañeros en la cautividad, los que son destacados entre los apóstoles; los cuales también fueron antes de mí en Cristo.", "words": [[0, 39695], [8, 39975], [10, 40075], [20, 40615], [22, 40735], [24, 40815], [32, 41415], [36, 41495], [47, 42035], [49, 42355], [53, 42495], [64, 43115], [67, 43275], [70, 43375], [82, 44395], [86, 44495], [90, 44635], [94, 44835], [105, 45475], [111, 45715], [115, 45895], [126, 47029], [130, 47151], [137, 47471], [145, 47831], [152, 48151], [158, 48491], [161, 48691], [164, 48851], [167, 48971]]}, {"verse": 8, "start": 49983, "end": 52271, "text": "Saludad a Amplias, amado mío en el Señor.", "words": [[0, 49983], [8, 50467], [10, 50737], [19, 51007], [25, 51227], [29, 51567], [32, 51667], [35, 51767]]}, {"verse": 9, "start": 52721, "end": 57269, "text": "Saludad a Urbano, nuestro colaborador en Cristo Jesús, y a Estaquis, amado mío.", "words": [[0, 52721], [8, 53182], [10, 53262], [18, 53622], [26, 53862], [38, 54502], [41, 54642], [48, 54882], [55, 55402], [57, 55862], [59, 56232], [69, 56602], [75, 56842]]}, {"verse": 10, "start": 57719, "end": 61707, "text": "Saludad a Apeles, probado en Cristo. Saludad a los que son de Aristóbulo.", "words": [[0, 57928], [8, 58178], [10, 58378], [18, 58578], [26, 58918], [29, 59038], [37, 60069], [45, 60329], [47, 60469], [51, 60609], [55, 60729], [59, 60909], [62, 61029]]}, {"verse": 11, "start": 62157, "end": 68472, "text": "Saludad a Herodión, mi pariente. Saludad a los que son de la casa de Narciso, los que están en el Señor.", "words": [[0, 62157], [8, 62693], [10, 62793], [20, 63333], [23, 63373], [33, 64406], [41, 64926], [43, 65046], [47, 65166], [51, 65306], [55, 65506], [58, 65646], [61, 65746], [66, 65986], [69, 66166], [78, 67106], [82, 67246], [86, 67426], [92, 67686], [95, 67846], [98, 67966]]}, {"verse": 12, "start": 68922, "end": 77008, "text": "Saludad a Trifena y a Trifosa, las cuales trabajan en el Señor. Saludad a Pérsida amada, la cual ha trabajado mucho en el Señor.", "words": [[0, 69074], [8, 69260], [10, 69447], [18, 69987], [20, 70360], [22, 70734], [31, 71107], [35, 71207], [42, 71467], [51, 72067], [54, 72167], [57, 72307], [64, 73282], [72, 73462], [74, 73642], [82, 74142], [89, 74962], [92, 75142], [97, 75342], [100, 75502], [110, 76002], [116, 76262], [119, 76442], [122, 76562]]}, {"verse": 13, "start": 77458, "end": 80844, "text": "Saludad a Rufo, escogido en el Señor, y a su madre y mía.", "words": [[0, 77458], [8, 77896], [10, 77996], [16, 78316], [25, 78776], [28, 78876], [31, 78976], [38, 79256], [40, 79796], [42, 79876], [45, 79996], [51, 80256], [53, 80476]]}, {"verse": 14, "start": 81294, "end": 87493, "text": "Saludad a Asíncrito, y a Flegonte, a Hermas, a Patrobas, a Hermes, y a los hermanos que están con ellos.", "words": [[0, 81519], [8, 81749], [10, 82039], [21, 82329], [23, 82469], [25, 82509], [35, 83409], [37, 83449], [45, 84089], [47, 84149], [57, 84949], [59, 85009], [67, 85529], [69, 85869], [71, 85929], [75, 86029], [84, 86509], [88, 86589], [94, 86789], [98, 87009]]}, {"verse": 15, "start": 87943, "end": 95459, "text": "Saludad a Filólogo y a Julia, a Nereo y a su hermana, y a Olimpas, y a todos los santos que están con ellos.", "words": [[0, 88122], [8, 88308], [10, 88495], [19, 89155], [21, 89335], [23, 89395], [30, 90255], [32, 90315], [38, 90755], [40, 90875], [42, 90955], [45, 91095], [54, 91975], [56, 92195], [58, 92275], [67, 92855], [69, 93395], [71, 93455], [77, 93655], [81, 93935], [88, 94395], [92, 94515], [98, 94735], [102, 94995]]}, {"verse": 16, "start": 95909, "end": 101367, "text": "Saludaos los unos a los otros con beso santo. Os saludan todas las iglesias de Cristo.", "words": [[0, 95909], [9, 96531], [13, 96711], [18, 96991], [20, 97191], [24, 97311], [30, 97611], [34, 97941], [39, 98271], [46, 99013], [49, 99119], [57, 99659], [63, 99839], [67, 100159], [76, 100659], [79, 100799]]}, {"verse": 17, "start": 101817, "end": 109992, "text": "Y os ruego hermanos, que miréis los que causan divisiones y escándalos contra la doctrina que vosotros habéis aprendido; y apartaos de ellos.", "words": [[0, 101817], [2, 101936], [5, 102076], [11, 102396], [21, 103036], [25, 103356], [32, 103776], [36, 103916], [40, 104076], [47, 104496], [58, 105116], [60, 105216], [71, 105836], [78, 106116], [81, 106256], [90, 106716], [94, 106916], [103, 107316], [110, 107676], [121, 108671], [123, 108953], [132, 109273], [135, 109473]]}, {"verse": 18, "start": 110442, "end": 118973, "text": "Porque los tales no sirven al Señor nuestro Jesucristo, sino a sus vientres; y con palabras suaves y halagos engañan los corazones de los ingenuos.", "words": [[0, 110442], [7, 110630], [11, 110830], [17, 111070], [20, 111310], [27, 111710], [30, 111870], [36, 112090], [44, 112370], [56, 113550], [61, 113730], [63, 113910], [67, 114050], [77, 115056], [79, 115140], [83, 115280], [92, 115600], [99, 116080], [101, 116260], [109, 116700], [117, 117260], [121, 117380], [131, 117960], [134, 118080], [138, 118180]]}, {"verse": 19, "start": 119423, "end": 128543, "text": "Porque vuestra obediencia ha venido a ser notoria a todos; así que me gozo de vosotros; pero quiero que seáis sabios en el bien, y inocentes en cuanto al mal.", "words": [[0, 119423], [7, 119603], [15, 119963], [26, 120523], [29, 120803], [36, 121123], [38, 121263], [42, 121403], [50, 121903], [52, 122023], [59, 122874], [63, 123053], [67, 123233], [70, 123333], [75, 123633], [78, 123773], [88, 124748], [93, 125028], [100, 125268], [104, 125468], [110, 125808], [117, 126188], [120, 126368], [123, 126488], [129, 126708], [131, 127048], [141, 127568], [144, 127788], [151, 127948], [154, 128208]]}, {"verse": 20, "start": 128993, "end": 137202, "text": "Y el Dios de paz quebrantará pronto a Satanás debajo de vuestros pies. La gracia del Señor nuestro Jesucristo sea con vosotros.", "words": [[0, 128993], [2, 129113], [5, 129273], [10, 129473], [13, 129753], [17, 130013], [29, 130773], [36, 131133], [38, 131353], [46, 131913], [53, 132413], [56, 132553], [65, 132873], [71, 133806], [74, 133949], [81, 134389], [85, 134489], [91, 134949], [99, 135209], [110, 136029], [114, 136189], [118, 136449]]}, {"verse": 21, "start": 137652, "end": 143185, "text": "Os saludan Timoteo, mi colaborador, y Lucio y Jasón y Sosipater, mis parientes.", "words": [[0, 137652], [3, 137773], [11, 138293], [20, 138913], [23, 138993], [36, 139753], [38, 140253], [44, 140713], [46, 141033], [52, 141353], [54, 141453], [65, 142213], [69, 142293]]}, {"verse": 22, "start": 143635, "end": 146966, "text": "Yo Tercio, que escribí la epístola, os saludo en el Señor.", "words": [[0, 143635], [3, 143778], [11, 144138], [15, 144298], [23, 144718], [26, 144798], [36, 145698], [39, 145798], [46, 146218], [49, 146338], [52, 146458]]}, {"verse": 23, "start": 147416, "end": 155639, "text": "Os saluda Gayo, mi anfitrión, y de toda la iglesia. Os saluda Erasto, tesorero de la ciudad, y el hermano Cuarto.", "words": [[0, 147416], [3, 147539], [10, 147889], [16, 148239], [19, 148379], [30, 148959], [32, 149199], [35, 149319], [40, 149459], [43, 149659], [52, 151617], [55, 151762], [62, 152302], [70, 152822], [79, 153522], [82, 153662], [85, 153802], [93, 154462], [95, 154622], [98, 154702], [106, 155102]]}, {"verse": 24, "start": 156089, "end": 160550, "text": "La gracia del Señor nuestro Jesucristo sea con todos vosotros. Amén.", "words": [[0, 156089], [3, 156207], [10, 156627], [14, 156727], [20, 157047], [28, 157347], [39, 158107], [43, 158387], [47, 158647], [53, 158967], [63, 160114]]}, {"verse": 25, "start": 161000, "end": 169921, "text": "Y al que puede fortaleceros según mi evangelio y la predicación de Jesucristo, según la revelación del misterio encubierto desde tiempos eternos,", "words": [[0, 161000], [2, 161100], [5, 161200], [9, 161320], [15, 161580], [28, 162680], [34, 162880], [37, 163120], [47, 163860], [49, 163960], [52, 164060], [64, 164720], [67, 164880], [79, 165960], [85, 166280], [88, 166480], [99, 167040], [103, 167220], [112, 167760], [123, 168400], [129, 168620], [137, 169200]]}, {"verse": 26, "start": 170371, "end": 179880, "text": "Pero manifestado ahora, y por las Escrituras de los profetas, según el mandamiento del Dios eterno, declarado a todas las naciones para que obedezcan a la fe;", "words": [[0, 170371], [5, 170529], [17, 171269], [24, 171629], [26, 171889], [30, 172069], [34, 172249], [45, 172829], [48, 172989], [52, 173129], [62, 174149], [68, 174449], [71, 174669], [83, 175249], [87, 175509], [92, 175749], [100, 176789], [110, 177249], [112, 177389], [118, 177549], [122, 177869], [131, 178289], [136, 178569], [140, 178749], [150, 179329], [152, 179449], [155, 179509]]}, {"verse": 27, "start": 180330, "end": 191008, "text": "Al solo Dios sabio, sea gloria por Jesucristo para siempre. Amén. fue escrita de Corinto a los Romanos, enviada por medio de Febe, diaconisa de la iglesia de Cencrea.", "words": [[0, 180330], [3, 180509], [8, 180829], [13, 181249], [20, 181909], [24, 182069], [31, 182549], [35, 182749], [46, 183409], [51, 183589], [60, 184520], [66, 185259], [70, 185403], [78, 185803], [81, 185923], [89, 186363], [91, 186483], [95, 186563], [104, 187203], [112, 187623], [116, 187863], [122, 188143], [125, 188303], [131, 188883], [141, 189583], 