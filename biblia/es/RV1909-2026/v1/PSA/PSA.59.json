{"book": "PSA", "chapter": 59, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 138123, "verses": [{"verse": 1, "start": 300, "end": 15916, "text": "Al Músico principal: sobre No destruyas: Michtam de David, cuando envió Saúl, y guardaron la casa para matarlo. LÍBRAME de mis enemigos, oh Dios mío: ponme en salvo de los que contra mí se levantan.", "words": [[0, 300], [3, 489], [10, 989], [21, 2173], [27, 2537], [30, 2977], [41, 4685], [49, 4945], [52, 5165], [59, 6005], [66, 6345], [72, 6745], [78, 7385], [80, 7685], [90, 8245], [93, 8405], [98, 8725], [103, 9005], [112, 10091], [120, 10556], [123, 10716], [127, 10856], [137, 11326], [140, 11796], [145, 11956], [150, 12739], [156, 13123], [159, 13283], [165, 13843], [168, 14123], [172, 14263], [176, 14443], [183, 14803], [186, 15003], [189, 15163]]}, {"verse": 2, "start": 16366, "end": 21929, "text": "Líbrame de los que obran iniquidad, y sálvame de hombres sanguinarios.", "words": [[0, 16366], [8, 17194], [11, 17434], [15, 17574], [19, 17854], [25, 18134], [36, 19034], [38, 19534], [46, 20074], [49, 20294], [57, 20614]]}, {"verse": 3, "start": 22379, "end": 31087, "text": "Porque he aquí están acechando mi vida: se han juntado contra mí fuertes, no por falta mía, ni pecado mío, oh Jehová.", "words": [[0, 22683], [7, 23023], [10, 23063], [15, 23563], [21, 23823], [31, 24423], [34, 24623], [40, 25474], [43, 25633], [47, 25793], [55, 26353], [62, 26633], [65, 26913], [74, 27833], [77, 27973], [81, 28193], [87, 28513], [92, 28933], [95, 29353], [102, 29773], [107, 30228], [110, 30683]]}, {"verse": 4, "start": 31537, "end": 37395, "text": "Sin delito mío corren y se preparan: despierta para venir a mi encuentro, y mira.", "words": [[0, 31537], [4, 31744], [11, 32164], [15, 32564], [22, 33084], [24, 33324], [27, 33504], [37, 35090], [47, 35490], [52, 35690], [58, 35970], [60, 36130], [63, 36230], [74, 36850], [76, 36990]]}, {"verse": 5, "start": 37845, "end": 51955, "text": "Y tú, Jehová Dios de los ejércitos, Dios de Israel, despierta para castigar a todas las naciones: no hayas misericordia de todos los que se rebelan con iniquidad. (Selah.)", "words": [[0, 37845], [2, 37987], [6, 38487], [13, 39667], [18, 39847], [21, 40047], [25, 40167], [36, 41327], [41, 41527], [44, 41727], [52, 42627], [62, 43587], [67, 43807], [76, 44427], [78, 44452], [84, 44476], [88, 44501], [98, 46158], [101, 46338], [107, 46578], [120, 47378], [123, 47518], [129, 47738], [133, 48018], [137, 48178], [140, 48578], [148, 48978], [152, 49098], [163, 51137]]}, {"verse": 6, "start": 52406, "end": 57712, "text": "Se volverán a la tarde, ladrarán como perros, y rodearán la ciudad.", "words": [[0, 52406], [3, 52549], [12, 53089], [14, 53169], [17, 53269], [24, 54009], [33, 54549], [38, 54769], [46, 55589], [48, 56149], [57, 56849], [60, 56989]]}, {"verse": 7, "start": 58162, "end": 63981, "text": "He aquí proferirán con su boca; cuchillos están en sus labios, porque dicen: ¿Quién oye?", "words": [[0, 58294], [3, 58464], [8, 58964], [19, 59464], [23, 59624], [26, 59844], [32, 60585], [42, 61045], [48, 61365], [51, 61565], [55, 61705], [63, 62085], [70, 62465], [77, 63564], [84, 63798]]}, {"verse": 8, "start": 64331, "end": 69981, "text": "Mas tú, Jehová, te reirás de ellos, te burlarás de todas las naciones.", "words": [[0, 64331], [4, 64497], [8, 65077], [16, 65977], [19, 66177], [26, 66617], [29, 66797], [36, 67637], [39, 67857], [48, 68517], [51, 68657], [57, 68877], [61, 69117]]}, {"verse": 9, "start": 70431, "end": 74581, "text": "De su fuerza esperaré yo en ti: porque Dios es mi defensa.", "words": [[0, 70431], [3, 70599], [6, 70739], [13, 71459], [22, 71939], [25, 72159], [28, 72339], [32, 72957], [39, 73143], [44, 73463], [47, 73663], [50, 73803]]}, {"verse": 10, "start": 75031, "end": 81219, "text": "El Dios de mi misericordia saldrá a mi encuentro: Dios me hará ver en mis enemigos mi deseo.", "words": [[0, 75031], [3, 75406], [8, 75606], [11, 75786], [14, 75906], [27, 76746], [34, 77326], [36, 77466], [39, 77606], [50, 78658], [55, 78924], [58, 79284], [63, 79544], [67, 79664], [70, 79804], [74, 80004], [83, 80484], [86, 80624]]}, {"verse": 11, "start": 81669, "end": 90920, "text": "No los matarás, porque mi pueblo no se olvide: hazlos vagar con tu fortaleza; y abátelos, oh Jehová, escudo nuestro,", "words": [[0, 81669], [3, 81892], [7, 82072], [16, 82752], [23, 83232], [26, 83452], [33, 83812], [36, 84072], [39, 84212], [47, 85186], [54, 85666], [60, 86086], [64, 86266], [67, 86426], [78, 87698], [80, 88203], [90, 88708], [93, 89213], [101, 89718], [108, 90258]]}, {"verse": 12, "start": 91370, "end": 100301, "text": "Por el pecado de su boca, por la palabra de sus labios; y sean presos por su soberbia y por las maldiciones y mentiras que profieren.", "words": [[0, 91370], [4, 91515], [7, 91655], [14, 92115], [17, 92295], [20, 92435], [26, 92915], [30, 93095], [33, 93235], [41, 93535], [44, 93775], [48, 93915], [56, 94917], [58, 95047], [63, 95287], [70, 95987], [74, 96307], [77, 96527], [86, 97187], [88, 97567], [92, 97727], [96, 97867], [108, 98467], [110, 98747], [119, 99287], [123, 99427]]}, {"verse": 13, "start": 100751, "end": 110965, "text": "Acábalos con furor, acábalos, y no sean: y sepan que Dios domina en Jacob hasta los fines de la tierra. (Selah.)", "words": [[0, 100751], [9, 101311], [13, 101531], [20, 102451], [30, 103051], [32, 103351], [35, 103511], [41, 104490], [43, 104611], [49, 104991], [53, 105191], [58, 105491], [65, 106111], [68, 106231], [74, 106571], [80, 106951], [84, 107111], [90, 107391], [93, 107551], [96, 107671], [104, 110146]]}, {"verse": 14, "start": 111415, "end": 114448, "text": "Vuelvan pues a la tarde, y ladren como perros, y rodeen la ciudad.", "words": [[0, 111415], [8, 111415], [13, 111415], [15, 111415], [18, 111415], [25, 111415], [27, 111540], [34, 111940], [39, 112200], [47, 112680], [49, 113160], [56, 113640], [59, 113780]]}, {"verse": 15, "start": 114898, "end": 119618, "text": "Anden ellos errantes para hallar qué comer: y si no se sacian, murmuren.", "words": [[0, 114898], [6, 115358], [12, 115718], [21, 116378], [26, 116748], [33, 117118], [37, 117218], [44, 118074], [46, 118199], [49, 118319], [52, 118539], [55, 118719], [63, 119194]]}, {"verse": 16, "start": 120068, "end": 130623, "text": "Pero yo cantaré tu fortaleza, y alabaré de mañana tu misericordia: porque has sido mi amparo y refugio en el día de mi angustia.", "words": [[0, 120954], [5, 121374], [8, 121574], [16, 122114], [19, 122274], [30, 123154], [32, 123614], [40, 124094], [43, 124214], [50, 124574], [53, 124814], [67, 126219], [74, 126579], [78, 126939], [83, 127379], [86, 127619], [93, 128259], [95, 128379], [103, 129039], [106, 129239], [109, 129379], [113, 129599], [116, 129759], [119, 129879]]}, {"verse": 17, "start": 131073, "end": 137723, "text": "Fortaleza mía, a ti cantaré; porque eres Dios de mi amparo, Dios de mi misericordia.", "words": [[0, 131073], [10, 131737], [15, 132157], [17, 132417], [20, 132537], [29, 133651], [36, 133896], [41, 134116], [46, 134416], [49, 134636], [52, 134776], [60, 135756], [65, 136136], [68, 136336], [71, 136456]]}]}