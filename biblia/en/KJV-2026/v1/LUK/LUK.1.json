{"book": "LUK", "chapter": 1, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 490186, "verses": [{"verse": 1, "start": 300, "end": 6723, "text": "Since many have taken in hand to set forth in order a declaration of those things which are most surely believed among us,", "words": [[0, 300], [6, 460], [11, 780], [16, 980], [22, 1280], [25, 1480], [30, 1740], [33, 1920], [37, 2120], [43, 2460], [46, 2680], [52, 2880], [54, 3040], [66, 3500], [69, 3900], [75, 4100], [82, 4460], [88, 4700], [92, 4860], [97, 5060], [104, 5500], [113, 5940], [119, 6240]]}, {"verse": 2, "start": 7073, "end": 13287, "text": "Even as they delivered them to us, which from the beginning were eyewitnesses, and ministers of the word;", "words": [[0, 7073], [5, 7286], [8, 7526], [13, 7666], [23, 8026], [28, 8306], [31, 8526], [35, 9406], [41, 9586], [46, 9786], [50, 9886], [60, 10226], [65, 10486], [79, 11486], [83, 11886], [93, 12266], [96, 12666], [100, 12806]]}, {"verse": 3, "start": 13637, "end": 23827, "text": "It seemed good to me also, having had perfect understanding of all things from the very first, to write to you in order, most excellent Theophilus,", "words": [[0, 13637], [3, 13797], [10, 14197], [15, 14537], [18, 14777], [21, 14997], [27, 15997], [34, 16157], [38, 16417], [46, 16777], [60, 17517], [63, 17797], [67, 18097], [74, 18497], [79, 18797], [83, 18957], [88, 19217], [95, 19697], [98, 20197], [104, 20437], [107, 20697], [111, 20897], [114, 21057], [121, 21777], [126, 22077], [136, 22637]]}, {"verse": 4, "start": 24177, "end": 27983, "text": "That you might know the certainty of those things, in which you have been instructed.", "words": [[0, 24177], [5, 24290], [9, 24430], [15, 24630], [20, 24930], [24, 25070], [34, 25430], [37, 25730], [43, 25890], [51, 26290], [54, 26565], [60, 26725], [64, 26905], [69, 27065], [74, 27225]]}, {"verse": 5, "start": 28333, "end": 38951, "text": "¶ There was in the days of Herod, the king of Judæa, a certain priest named Zacharias, of the course of Abia: and his wife was of the daughters of Aaron, and her name was Elisabeth.", "words": [[2, 28333], [8, 28442], [12, 28682], [15, 28822], [19, 28902], [24, 29162], [27, 29322], [34, 30322], [38, 30442], [43, 30662], [46, 31232], [53, 31802], [55, 31902], [63, 32122], [70, 32542], [76, 33192], [87, 33842], [90, 34042], [94, 34142], [101, 34402], [104, 34562], [110, 35322], [114, 35456], [118, 35576], [123, 35856], [127, 36076], [130, 36196], [134, 36296], [144, 36596], [147, 36816], [154, 37136], [158, 37656], [162, 37816], [167, 38056], [171, 38533]]}, {"verse": 6, "start": 39301, "end": 45441, "text": "And they were both righteous before God, walking in all the commandments and ordinances of the Lord blameless.", "words": [[0, 39301], [4, 39544], [9, 39664], [14, 39804], [19, 40024], [29, 40504], [36, 40884], [41, 41784], [49, 42164], [52, 42384], [56, 42584], [60, 42724], [73, 43164], [77, 43504], [88, 44104], [91, 44324], [95, 44444], [100, 44664]]}, {"verse": 7, "start": 45791, "end": 52038, "text": "And they had no child, because that Elisabeth was barren, and they both were now well stricken in years.", "words": [[0, 45791], [4, 45943], [9, 46043], [13, 46223], [16, 46423], [23, 47303], [31, 47683], [36, 48013], [46, 48343], [50, 48763], [58, 49523], [62, 49783], [67, 49923], [72, 50183], [77, 50383], [81, 50563], [86, 50803], [95, 51283], [98, 51443]]}, {"verse": 8, "start": 52388, "end": 58298, "text": "And it came to pass, that while he executed the priest’s office before God in the order of his course,", "words": [[0, 52388], [4, 52522], [7, 52622], [12, 52862], [15, 53022], [21, 53402], [26, 53717], [32, 53997], [35, 54237], [44, 54797], [48, 55057], [57, 55517], [64, 55817], [71, 56257], [75, 56737], [78, 56997], [82, 57097], [88, 57337], [91, 57557], [95, 57677]]}, {"verse": 9, "start": 58648, "end": 65301, "text": "According to the custom of the priest’s office, his lot was to burn incense when he went into the temple of the Lord.", "words": [[0, 58648], [10, 58941], [13, 59241], [17, 59361], [24, 59721], [27, 59961], [31, 60121], [40, 60601], [48, 61401], [52, 61601], [56, 61861], [60, 62101], [63, 62281], [68, 62541], [76, 62901], [81, 63341], [84, 63481], [89, 63661], [94, 63981], [98, 64161], [105, 64441], [108, 64661], [112, 64801]]}, {"verse": 10, "start": 65651, "end": 69686, "text": "And the whole multitude of the people were praying without at the time of incense.", "words": [[0, 65651], [4, 65797], [8, 65917], [14, 66077], [24, 66597], [27, 66817], [31, 66937], [38, 67237], [43, 67457], [51, 67857], [59, 68217], [62, 68417], [66, 68497], [71, 68837], [74, 68977]]}, {"verse": 11, "start": 70036, "end": 75231, "text": "And there appeared to him an angel of the Lord standing on the right side of the altar of incense.", "words": [[0, 70036], [4, 70174], [10, 70354], [19, 70714], [22, 70954], [26, 71154], [29, 71334], [35, 71734], [38, 71914], [42, 72054], [47, 72514], [56, 72834], [59, 73094], [63, 73214], [69, 73434], [74, 73754], [77, 73914], [81, 74014], [87, 74314], [90, 74534]]}, {"verse": 12, "start": 75581, "end": 79780, "text": "And when Zacharias saw him, he was troubled, and fear fell upon him.", "words": [[0, 75581], [4, 75711], [9, 75871], [19, 76451], [23, 76891], [28, 77451], [31, 77531], [35, 77711], [45, 78091], [49, 78531], [54, 78831], [59, 79071], [64, 79351]]}, {"verse": 13, "start": 80130, "end": 88673, "text": "But the angel said to him, Fear not, Zacharias: for your prayer is heard; and your wife Elisabeth shall bear you a son, and you shall call his name John.", "words": [[0, 80130], [4, 80234], [8, 80374], [14, 80694], [19, 80994], [22, 81194], [27, 81746], [32, 81901], [37, 82161], [48, 83122], [52, 83248], [57, 83348], [64, 83628], [67, 83948], [74, 84627], [78, 84751], [83, 84891], [88, 85301], [98, 85711], [104, 86111], [109, 86351], [113, 86511], [115, 86611], [120, 87151], [124, 87251], [128, 87351], [134, 87491], [139, 87731], [143, 87931], [148, 88151]]}, {"verse": 14, "start": 89023, "end": 92919, "text": "And you shall have joy and gladness; and many shall rejoice at his birth.", "words": [[0, 89023], [4, 89142], [8, 89222], [14, 89422], [19, 89622], [23, 89942], [27, 90182], [37, 91075], [41, 91182], [46, 91422], [52, 91682], [60, 92062], [63, 92382], [67, 92522]]}, {"verse": 15, "start": 93269, "end": 101576, "text": "For he shall be great in the sight of the Lord, and shall drink neither wine nor strong drink; and he shall be filled with the Holy Spirit, even from his mother’s womb.", "words": [[0, 93269], [4, 93351], [7, 93471], [13, 93651], [16, 93811], [22, 94071], [25, 94291], [29, 94391], [35, 94611], [38, 94731], [42, 94831], [48, 95351], [52, 95451], [58, 95651], [64, 95931], [72, 96271], [77, 96651], [81, 97051], [88, 97431], [95, 98141], [99, 98271], [102, 98391], [108, 98571], [111, 98711], [118, 98931], [123, 99091], [127, 99191], [132, 99391], [140, 100191], [145, 100491], [150, 100691], [154, 100831], [163, 101191]]}, {"verse": 16, "start": 101926, "end": 105469, "text": "And many of the children of Israel shall he turn to the Lord their God.", "words": [[0, 101926], [4, 102051], [9, 102271], [12, 102391], [16, 102511], [25, 102871], [28, 103051], [35, 103411], [41, 103811], [44, 104011], [49, 104311], [52, 104471], [56, 104611], [61, 104811], [67, 105011]]}, {"verse": 17, "start": 105819, "end": 116199, "text": "And he shall go before him in the spirit and power of Elias, to turn the hearts of the fathers to the children, and the disobedient to the wisdom of the just; to make ready a people prepared for the Lord.", "words": [[0, 105819], [4, 105925], [7, 106005], [13, 106185], [16, 106365], [23, 106665], [27, 106945], [30, 107165], [34, 107285], [41, 107645], [45, 107925], [51, 108225], [54, 108385], [61, 108845], [64, 109205], [69, 109425], [73, 109565], [80, 109765], [83, 109945], [87, 110065], [95, 110285], [98, 110525], [102, 110645], [112, 111348], [116, 111432], [120, 111552], [132, 112312], [135, 112492], [139, 112612], [146, 112892], [149, 113112], [153, 113252], [159, 113892], [162, 113989], [167, 114149], [173, 114489], [175, 114669], [182, 114889], [191, 115349], [195, 115589], [199, 115729]]}, {"verse": 18, "start": 116479, "end": 123182, "text": "And Zacharias said to the angel, How shall I know this? for I am an old man, and my wife well stricken in years.", "words": [[0, 116479], [4, 116902], [14, 117352], [19, 117551], [22, 117712], [26, 117892], [33, 118647], [37, 118787], [43, 118987], [45, 119127], [50, 119267], [56, 119874], [60, 119976], [62, 120236], [65, 120396], [68, 120496], [72, 120776], [77, 121116], [81, 121556], [84, 121676], [89, 121936], [94, 122176], [103, 122536], [106, 122696]]}, {"verse": 19, "start": 123462, "end": 132021, "text": "And the angel answering said to him, I am Gabriel, that stand in the presence of God; and am sent to speak to you, and to show you these glad tidings.", "words": [[0, 123462], [4, 123587], [8, 123707], [14, 124047], [24, 124527], [29, 124827], [32, 125047], [37, 125791], [39, 125931], [42, 126251], [51, 126631], [56, 126991], [62, 127251], [65, 127411], [69, 127511], [78, 127771], [81, 127991], [86, 128667], [90, 128790], [93, 129010], [98, 129230], [101, 129450], [107, 129650], [110, 129870], [115, 130030], [119, 130410], [122, 130550], [127, 130790], [131, 130910], [137, 131050], [142, 131330]]}, {"verse": 20, "start": 132371, "end": 142050, "text": "And, behold, you shall be dumb, and not able to speak, until the day that these things shall be performed, because you believe not my words, which shall be fulfilled in their season.", "words": [[0, 132371], [5, 132519], [13, 133219], [17, 133439], [23, 133659], [26, 133819], [32, 134179], [36, 134579], [40, 134779], [45, 135079], [48, 135239], [55, 135579], [61, 136039], [65, 136279], [69, 136519], [74, 136719], [80, 136899], [87, 137239], [93, 137459], [96, 137599], [107, 138379], [115, 138599], [119, 138799], [127, 139059], [131, 139319], [134, 139559], [141, 140275], [147, 140396], [153, 140556], [156, 140676], [166, 141076], [169, 141356], [175, 141516]]}, {"verse": 21, "start": 142330, "end": 146886, "text": "And the people waited for Zacharias, and marvelled that he stayed so long in the temple.", "words": [[0, 142330], [4, 142471], [8, 142551], [15, 142811], [22, 143151], [26, 143371], [37, 144051], [41, 144511], [51, 144971], [56, 145071], [59, 145191], [66, 145451], [69, 145791], [74, 146071], [77, 146271], [81, 146371]]}, {"verse": 22, "start": 147236, "end": 155458, "text": "And when he came out, he could not speak to them: and they perceived that he had seen a vision in the temple: for he beckoned to them, and remained speechless.", "words": [[0, 147236], [4, 147357], [9, 147517], [12, 147677], [17, 147897], [22, 148317], [25, 148417], [31, 148577], [35, 148757], [41, 149037], [44, 149277], [50, 149832], [54, 149978], [59, 150078], [69, 150538], [74, 150858], [77, 150998], [81, 151118], [86, 151338], [88, 151478], [95, 151818], [98, 152018], [102, 152098], [110, 152828], [114, 153096], [117, 153256], [126, 153676], [129, 153856], [135, 154016], [139, 154216], [148, 154516]]}, {"verse": 23, "start": 155808, "end": 162313, "text": "And it came to pass, that, as soon as the days of his ministration were accomplished, he departed to his own house.", "words": [[0, 155808], [4, 155941], [7, 156021], [12, 156241], [15, 156421], [21, 156781], [27, 157521], [30, 157821], [35, 158061], [38, 158161], [42, 158301], [47, 158601], [50, 158761], [54, 159091], [67, 159421], [72, 159781], [86, 160661], [89, 160721], [98, 161101], [101, 161361], [105, 161541], [109, 161721]]}, {"verse": 24, "start": 162663, "end": 167953, "text": "And after those days his wife Elisabeth conceived, and hid herself five months, saying,", "words": [[0, 162663], [4, 162811], [10, 163091], [16, 163331], [21, 163871], [25, 163931], [30, 164391], [40, 164851], [51, 165351], [55, 165716], [59, 165956], [67, 166236], [72, 166736], [80, 167396]]}, {"verse": 25, "start": 168153, "end": 173599, "text": "Thus has the Lord dealt with me in the days in which he looked on me, to take away my reproach among men.", "words": [[0, 168153], [5, 168293], [9, 168513], [13, 168733], [18, 168913], [24, 169173], [29, 169353], [32, 169553], [35, 169713], [39, 169813], [44, 170113], [47, 170273], [53, 170433], [56, 170613], [63, 170813], [66, 171013], [70, 171253], [73, 171673], [78, 171873], [83, 172073], [86, 172333], [95, 172873], [101, 173013]]}, {"verse": 26, "start": 173879, "end": 179575, "text": "And in the sixth month the angel Gabriel was sent from God to a city of Galilee, named Nazareth,", "words": [[0, 173879], [4, 174005], [7, 174125], [11, 174225], [17, 174505], [23, 175085], [27, 175105], [33, 175425], [41, 175845], [45, 176185], [50, 176405], [55, 176605], [59, 176925], [62, 177165], [64, 177285], [69, 177485], [72, 177665], [81, 178205], [87, 178825]]}, {"verse": 27, "start": 179925, "end": 186473, "text": "To a virgin espoused to a man whose name was Joseph, of the house of David; and the virgin’s name was Mary.", "words": [[0, 179925], [3, 180025], [5, 180165], [12, 180465], [21, 181085], [24, 181265], [26, 181365], [30, 181585], [36, 181825], [41, 182145], [45, 182345], [53, 182845], [56, 183405], [60, 183525], [66, 183765], [69, 183925], [76, 184693], [80, 184836], [84, 184936], [93, 185436], [98, 185656], [102, 185896]]}, {"verse": 28, "start": 186823, "end": 194245, "text": "And the angel came in to her, and said, Hail, you that are highly favoured, the Lord is with you: blessed are you among women.", "words": [[0, 186823], [4, 186943], [8, 187063], [14, 187343], [19, 187543], [22, 187743], [25, 187943], [30, 188123], [34, 188343], [40, 188952], [46, 189167], [50, 189427], [55, 189627], [59, 189767], [66, 190337], [76, 190907], [80, 191007], [85, 191347], [88, 191707], [93, 191947], [98, 192510], [106, 192931], [110, 193231], [114, 193431], [120, 193711]]}, {"verse": 29, "start": 194525, "end": 201176, "text": "And when she saw him, she was troubled at his saying, and cast in her mind what manner of salutation this should be.", "words": [[0, 194525], [4, 194672], [9, 194832], [13, 195032], [17, 195372], [22, 195732], [26, 195832], [30, 196012], [39, 196352], [42, 196592], [46, 196752], [54, 197452], [58, 197712], [63, 198072], [66, 198292], [70, 198432], [75, 198772], [80, 199032], [87, 199392], [90, 199592], [101, 200332], [106, 200592], [113, 200772]]}, {"verse": 30, "start": 201526, "end": 206299, "text": "And the angel said to her, Fear not, Mary: for you have found favour with God.", "words": [[0, 201526], [4, 201846], [8, 201986], [14, 202286], [19, 202566], [22, 202786], [27, 203333], [32, 203485], [37, 203825], [43, 204512], [47, 204609], [51, 204749], [56, 204909], [62, 205209], [69, 205509], [74, 205849]]}, {"verse": 31, "start": 206649, "end": 212128, "text": "And, behold, you shall conceive in your womb, and bring forth a son, and shall call his name JESUS.", "words": [[0, 206649], [5, 206789], [13, 207529], [17, 207689], [23, 207869], [32, 208309], [35, 208489], [40, 208609], [46, 209249], [50, 209309], [56, 209489], [62, 209729], [64, 209889], [69, 210489], [73, 210589], [79, 210769], [84, 211009], [88, 211209], [93, 211489]]}, {"verse": 32, "start": 212478, "end": 218887, "text": "He shall be great, and shall be called the Son of the Highest: and the Lord God shall give to him the throne of his father David:", "words": [[0, 212478], [3, 212592], [9, 212772], [12, 212932], [19, 213232], [23, 213732], [29, 213932], [32, 214092], [39, 214352], [43, 214572], [47, 214812], [50, 214952], [54, 215072], [63, 215829], [67, 215952], [71, 216072], [76, 216272], [80, 216552], [86, 216832], [91, 217052], [94, 217212], [98, 217392], [102, 217532], [109, 217772], [112, 217952], [116, 218072], [123, 218332]]}, {"verse": 33, "start": 219237, "end": 224133, "text": "And he shall reign over the house of Jacob for ever; and of his kingdom there shall be no end.", "words": [[0, 219237], [4, 219397], [7, 219537], [13, 219737], [19, 220037], [24, 220277], [28, 220477], [34, 220717], [37, 220877], [43, 221244], [47, 221610], [53, 222150], [57, 222264], [60, 222404], [64, 222524], [72, 222824], [78, 223104], [84, 223304], [87, 223484], [90, 223684]]}, {"verse": 34, "start": 224413, "end": 229574, "text": "Then said Mary to the angel, How shall this be, seeing I know not a man?", "words": [[0, 224413], [5, 224628], [10, 224928], [15, 225268], [18, 225488], [22, 225648], [29, 226358], [33, 226538], [39, 226778], [44, 227058], [48, 227598], [55, 227878], [57, 228238], [62, 228498], [66, 228818], [68, 229078]]}, {"verse": 35, "start": 229854, "end": 241129, "text": "And the angel answered and said to her, The Holy Spirit shall come upon you, and the power of the Highest shall overshadow you: therefore also that holy thing which shall be born of you shall be called the Son of God.", "words": [[0, 229854], [4, 229996], [8, 230116], [14, 230476], [23, 230936], [27, 231136], [32, 231376], [35, 231576], [40, 232098], [44, 232249], [49, 232509], [56, 232849], [62, 233129], [67, 233349], [72, 233629], [77, 234009], [81, 234249], [85, 234389], [91, 234629], [94, 234829], [98, 234929], [106, 235269], [112, 235629], [123, 236289], [128, 236739], [138, 237039], [143, 237419], [148, 237639], [153, 237899], [159, 238199], [165, 238359], [171, 238559], [174, 238699], [179, 238919], [182, 239079], [186, 239239], [192, 239639], [195, 239799], [202, 240099], [206, 240319], [210, 240579], [213, 240699]]}, {"verse": 36, "start": 241479, "end": 249126, "text": "And, behold, your cousin Elisabeth, she has also conceived a son in her old age: and this is the sixth month with her, who was called barren.", "words": [[0, 241479], [5, 241703], [13, 242443], [18, 242623], [25, 243153], [36, 243683], [40, 243823], [44, 243963], [49, 244223], [59, 244663], [61, 244883], [65, 245103], [68, 245303], [72, 245443], [76, 245703], [81, 246425], [85, 246550], [90, 246810], [93, 246990], [97, 247140], [103, 247290], [109, 247510], [114, 247810], [119, 247970], [123, 248210], [127, 248350], [134, 248765]]}, {"verse": 37, "start": 249476, "end": 251357, "text": "For with God nothing shall be impossible.", "words": [[0, 249476], [4, 249559], [9, 249739], [13, 250099], [21, 250299], [27, 250599], [30, 250759]]}, {"verse": 38, "start": 251637, "end": 258959, "text": "And Mary said, Behold the handmaid of the Lord; be it to me according to your word. And the angel departed from her.", "words": [[0, 251637], [4, 251790], [9, 252010], [15, 252690], [22, 253068], [26, 253268], [35, 253868], [38, 253948], [42, 254068], [48, 254802], [51, 254988], [54, 255108], [57, 255268], [60, 255448], [70, 255828], [73, 256148], [78, 256348], [84, 257137], [88, 257264], [92, 257384], [98, 257724], [107, 258224], [112, 258504]]}, {"verse": 39, "start": 259309, "end": 264960, "text": "And Mary arose in those days, and went into the hill country with haste, into a city of Juda;", "words": [[0, 259309], [4, 259470], [9, 259730], [15, 260170], [18, 260450], [24, 260630], [30, 260930], [34, 261470], [39, 261670], [44, 262010], [48, 262170], [53, 262350], [61, 262730], [66, 262990], [73, 263630], [78, 263790], [80, 264010], [85, 264230], [88, 264595]]}, {"verse": 40, "start": 265310, "end": 269287, "text": "And entered into the house of Zacharias, and saluted Elisabeth.", "words": [[0, 265310], [4, 265453], [12, 265853], [17, 266133], [21, 266293], [27, 266533], [30, 266713], [41, 267333], [45, 268053], [53, 268700]]}, {"verse": 41, "start": 269637, "end": 278265, "text": "And it came to pass, that, when Elisabeth heard the salutation of Mary, the babe leaped in her womb; and Elisabeth was filled with the Holy Spirit:", "words": [[0, 269637], [4, 269785], [7, 269865], [12, 270085], [15, 270265], [21, 270585], [27, 270940], [32, 271260], [42, 271580], [48, 271960], [52, 272120], [63, 272760], [66, 272980], [72, 273820], [76, 273920], [81, 274220], [88, 274660], [91, 274820], [95, 275000], [101, 275790], [105, 276049], [115, 276329], [119, 276709], [126, 276969], [131, 277209], [135, 277369], [140, 277589]]}, {"verse": 42, "start": 278615, "end": 285294, "text": "And she spoke out with a loud voice, and said, Blessed are you among women, and blessed is the fruit of your womb.", "words": [[0, 278615], [4, 278720], [8, 278860], [14, 279120], [18, 279360], [23, 279520], [25, 279640], [30, 279900], [37, 280340], [41, 280540], [47, 281208], [55, 281417], [59, 281697], [63, 281857], [69, 282097], [76, 282857], [80, 283177], [88, 283537], [91, 283877], [95, 284037], [101, 284317], [104, 284577], [109, 284737]]}, {"verse": 43, "start": 285644, "end": 290311, "text": "And from where is this to me, that the mother of my Lord should come to me?", "words": [[0, 285644], [4, 285768], [9, 286008], [15, 286328], [18, 286648], [23, 286888], [26, 287108], [30, 287668], [35, 287848], [39, 288008], [46, 288228], [49, 288468], [52, 288708], [57, 289028], [64, 289288], [69, 289668], [72, 289928]]}, {"verse": 44, "start": 290661, "end": 297277, "text": "For, lo, as soon as the voice of your salutation sounded in my ears, the babe leaped in my womb for joy.", "words": [[0, 290661], [5, 290832], [9, 291312], [12, 291412], [17, 291692], [20, 291832], [24, 291952], [30, 292213], [33, 292372], [38, 292882], [49, 293392], [57, 293792], [60, 293972], [63, 294172], [69, 295112], [73, 295172], [78, 295412], [85, 295812], [88, 295932], [91, 296112], [96, 296392], [100, 296612]]}, {"verse": 45, "start": 297627, "end": 303766, "text": "And blessed is she that believed: for there shall be a performance of those things which were told her from the Lord.", "words": [[0, 297627], [4, 297770], [12, 298130], [15, 298450], [19, 298590], [24, 298770], [34, 299646], [38, 299752], [44, 299972], [50, 300192], [53, 300392], [55, 300492], [67, 300912], [70, 301292], [76, 301512], [83, 301932], [89, 302152], [94, 302312], [99, 302552], [103, 302812], [108, 303032], [112, 303192]]}, {"verse": 46, "start": 304046, "end": 307335, "text": "And Mary said, My soul does magnify the Lord,", "words": [[0, 304046], [4, 304199], [9, 304419], [15, 305098], [18, 305269], [23, 305669], [28, 305909], [36, 306589], [40, 306789]]}, {"verse": 47, "start": 307685, "end": 310461, "text": "And my spirit has rejoiced in God my Saviour.", "words": [[0, 307685], [4, 307793], [7, 307953], [14, 308293], [18, 308553], [27, 309073], [30, 309193], [34, 309473], [37, 309997]]}, {"verse": 48, "start": 310811, "end": 318618, "text": "For he has regarded the low estate of his handmaiden: for, behold, from now on all generations shall call me blessed.", "words": [[0, 310811], [4, 310911], [7, 311071], [11, 311231], [20, 311711], [24, 311978], [28, 312244], [35, 312511], [38, 312691], [42, 312851], [54, 313996], [59, 314146], [67, 315206], [72, 315386], [76, 315726], [79, 316026], [83, 316346], [95, 316946], [101, 317366], [106, 317666], [109, 317886]]}, {"verse": 49, "start": 318968, "end": 323746, "text": "For he that is mighty has done to me great things; and holy is his name.", "words": [[0, 318968], [4, 319065], [7, 319325], [12, 319545], [15, 319725], [22, 320105], [26, 320385], [31, 320605], [34, 320765], [37, 320925], [43, 321285], [51, 322230], [55, 322410], [60, 322730], [63, 323010], [67, 323190]]}, {"verse": 50, "start": 324096, "end": 328798, "text": "And his mercy is on them that fear him from generation to generation.", "words": [[0, 324096], [4, 324236], [8, 324376], [14, 324836], [17, 325076], [20, 325376], [25, 325596], [30, 325836], [35, 326156], [39, 326416], [44, 326616], [55, 327376], [58, 327736]]}, {"verse": 51, "start": 329148, "end": 334560, "text": "He has showed strength with his arm; he has scattered the proud in the imagination of their hearts.", "words": [[0, 329148], [3, 329261], [7, 329421], [14, 329661], [23, 330081], [28, 330361], [32, 330501], [37, 331246], [40, 331351], [44, 331531], [54, 331931], [58, 332151], [64, 332531], [67, 332751], [71, 332851], [83, 333371], [86, 333711], [92, 333891]]}, {"verse": 52, "start": 334910, "end": 339144, "text": "He has put down the mighty from their seats, and exalted them of low degree.", "words": [[0, 334910], [3, 335030], [7, 335190], [11, 335370], [16, 335610], [20, 335790], [27, 336070], [32, 336330], [38, 336530], [45, 336930], [49, 337450], [57, 337890], [62, 338170], [65, 338330], [69, 338490]]}, {"verse": 53, "start": 339494, "end": 344095, "text": "He has filled the hungry with good things; and the rich he has sent empty away.", "words": [[0, 339494], [3, 339583], [7, 339783], [14, 340043], [18, 340243], [25, 340603], [30, 340903], [35, 341103], [43, 341992], [47, 342121], [51, 342241], [56, 342481], [59, 342661], [63, 342841], [68, 343041], [74, 343381]]}, {"verse": 54, "start": 344445, "end": 348322, "text": "He has helped his servant Israel, in remembrance of his mercy;", "words": [[0, 344445], [3, 344576], [7, 344816], [14, 345156], [18, 345336], [26, 345716], [34, 346256], [37, 346716], [49, 347156], [52, 347516], [56, 347656]]}, {"verse": 55, "start": 348672, "end": 353191, "text": "As he spoke to our fathers, to Abraham, and to his seed for ever.", "words": [[0, 348672], [3, 348854], [6, 348974], [12, 349194], [15, 349454], [19, 349614], [28, 350314], [31, 350394], [40, 351494], [44, 351634], [47, 351814], [51, 351994], [56, 352402], [60, 352811]]}, {"verse": 56, "start": 353471, "end": 358344, "text": "And Mary remained with her about three months, and returned to her own house.", "words": [[0, 353471], [4, 353660], [9, 353960], [18, 354400], [23, 354780], [27, 354960], [33, 355240], [39, 355660], [47, 356040], [51, 356395], [60, 356855], [63, 357235], [67, 357455], [71, 357715]]}, {"verse": 57, "start": 358694, "end": 364121, "text": "Now Elisabeth’s full time came that she should be delivered; and she brought forth a son.", "words": [[0, 358694], [4, 359274], [16, 359854], [21, 360054], [26, 360414], [31, 360774], [36, 361054], [40, 361274], [47, 361494], [50, 361634], [61, 362531], [65, 362672], [69, 362812], [77, 363072], [83, 363352], [85, 363737]]}, {"verse": 58, "start": 364471, "end": 370231, "text": "And her neighbours and her cousins heard how the Lord had showed great mercy upon her; and they rejoiced with her.", "words": [[0, 364471], [4, 364609], [8, 364859], [19, 365109], [23, 365429], [27, 365569], [35, 365969], [41, 366249], [45, 366489], [49, 366669], [54, 366929], [58, 367109], [65, 367329], [71, 367629], [77, 368009], [82, 368289], [87, 368970], [91, 369099], [96, 369239], [105, 369759], [110, 369939]]}, {"verse": 59, "start": 370581, "end": 378789, "text": "And it came to pass, that on the eighth day they came to circumcise the child; and they called him Zacharias, after the name of his father.", "words": [[0, 370581], [4, 370720], [7, 370840], [12, 371060], [15, 371220], [21, 371540], [26, 372240], [29, 372400], [33, 372540], [40, 372760], [44, 373100], [49, 373280], [54, 373500], [57, 373660], [68, 374300], [72, 374460], [79, 375234], [83, 375362], [88, 375442], [95, 375702], [99, 375922], [110, 377242], [116, 377522], [120, 377702], [125, 377942], [128, 378102], [132, 378222]]}, {"verse": 60, "start": 379139, "end": 383799, "text": "And his mother answered and said, Not so; but he shall be called John.", "words": [[0, 379139], [4, 379285], [8, 379425], [15, 379705], [24, 380225], [28, 380485], [34, 381192], [38, 381392], [42, 382198], [46, 382306], [49, 382466], [55, 382646], [58, 382786], [65, 383046]]}, {"verse": 61, "start": 384079, "end": 388229, "text": "And they said to her, There is none of your kindred that is called by this name.", "words": [[0, 384079], [4, 384209], [9, 384329], [14, 384569], [17, 384789], [22, 385326], [28, 385462], [31, 385642], [36, 385882], [39, 386042], [44, 386342], [52, 386642], [57, 387022], [60, 387182], [67, 387442], [70, 387642], [75, 387842]]}, {"verse": 62, "start": 388509, "end": 391799, "text": "And they made signs to his father, how he would have him called.", "words": [[0, 388509], [4, 388661], [9, 388801], [14, 389021], [20, 389361], [23, 389621], [27, 389781], [35, 390161], [39, 390486], [42, 390666], [48, 390806], [53, 390986], [57, 391206]]}, {"verse": 63, "start": 392149, "end": 398132, "text": "And he asked for a writing table, and wrote, saying, His name is John. And they marvelled all.", "words": [[0, 392149], [4, 392296], [7, 392376], [13, 392716], [17, 392956], [19, 393096], [27, 393336], [34, 393776], [38, 394156], [45, 394556], [53, 395411], [57, 395568], [62, 395808], [65, 395968], [71, 396722], [75, 396864], [80, 397254], [90, 397644]]}, {"verse": 64, "start": 398482, "end": 404569, "text": "And his mouth was opened immediately, and his tongue loosed, and he spoke, and praised God.", "words": [[0, 398482], [4, 398629], [8, 398769], [14, 399109], [18, 399369], [25, 399769], [38, 400729], [42, 401029], [46, 401169], [53, 401449], [61, 402229], [65, 402369], [68, 402489], [75, 402869], [79, 403409], [87, 403789]]}, {"verse": 65, "start": 404919, "end": 412689, "text": "And fear came on all that dwelt round about them: and all these sayings were noised abroad throughout all the hill country of Judæa.", "words": [[0, 404919], [4, 405219], [9, 405519], [14, 405839], [17, 406099], [21, 406399], [26, 406579], [32, 406999], [38, 407259], [44, 407599], [50, 408298], [54, 408441], [58, 408641], [64, 408821], [72, 409301], [77, 409461], [84, 409921], [91, 410341], [102, 410741], [106, 411101], [110, 411261], [115, 411441], [123, 411841], [126, 412291]]}, {"verse": 66, "start": 413039, "end": 420650, "text": "And all they that heard them laid them up in their hearts, saying, What manner of child shall this be! And the hand of the Lord was with him.", "words": [[0, 413039], [4, 413319], [8, 413519], [13, 413739], [18, 413959], [24, 414159], [29, 414379], [34, 414639], [39, 414879], [42, 415059], [45, 415219], [51, 415359], [59, 415999], [67, 416725], [72, 416864], [79, 417084], [82, 417224], [88, 417544], [94, 417764], [99, 417984], [103, 418662], [107, 418812], [111, 418932], [116, 419152], [119, 419272], [123, 419392], [128, 419672], [132, 420032], [137, 420332]]}, {"verse": 67, "start": 421000, "end": 426000, "text": "And his father Zacharias was filled with the Holy Spirit, and prophesied, saying,", "words": [[0, 421000], [4, 421145], [8, 421285], [15, 421625], [25, 422325], [29, 422625], [36, 422965], [41, 423205], [45, 423345], [50, 423545], [58, 424045], [62, 424605], [74, 425405]]}, {"verse": 68, "start": 426200, "end": 430721, "text": "Blessed be the Lord God of Israel; for he has visited and redeemed his people,", "words": [[0, 426200], [8, 426554], [11, 426914], [15, 427094], [20, 427314], [24, 427574], [27, 427734], [35, 428453], [39, 428559], [42, 428759], [46, 428979], [54, 429339], [58, 429639], [67, 430059], [71, 430199]]}, {"verse": 69, "start": 431071, "end": 434876, "text": "And has raised up a horn of salvation for us in the house of his servant David;", "words": [[0, 431071], [4, 431199], [8, 431339], [15, 431599], [18, 431859], [20, 432019], [25, 432259], [28, 432399], [38, 432839], [42, 433179], [45, 433339], [48, 433499], [52, 433599], [58, 433799], [61, 433959], [65, 434099], [73, 434359]]}, {"verse": 70, "start": 435226, "end": 439791, "text": "As he spoke by the mouth of his holy prophets, which have been since the world began:", "words": [[0, 435226], [3, 435440], [6, 435520], [12, 435820], [15, 436080], [19, 436220], [25, 436460], [28, 436620], [32, 436740], [37, 437020], [47, 437840], [53, 438020], [58, 438180], [63, 438420], [69, 438660], [73, 438880], [79, 439140]]}, {"verse": 71, "start": 440141, "end": 444374, "text": "That we should be saved from our enemies, and from the hand of all that hate us;", "words": [[0, 440141], [5, 440269], [8, 440429], [15, 440589], [18, 440729], [24, 441109], [29, 441349], [33, 441529], [42, 441849], [46, 442289], [51, 442469], [55, 442609], [60, 442909], [63, 443129], [67, 443429], [72, 443649], [77, 443929]]}, {"verse": 72, "start": 444724, "end": 448702, "text": "To perform the mercy promised to our fathers, and to remember his holy covenant;", "words": [[0, 444724], [3, 444820], [11, 445140], [15, 445340], [21, 445620], [30, 446020], [33, 446280], [37, 446420], [46, 446760], [50, 447065], [53, 447205], [62, 447525], [66, 447765], [71, 448045]]}, {"verse": 73, "start": 449052, "end": 451674, "text": "The oath which he swore to our father Abraham,", "words": [[0, 449052], [4, 449170], [9, 449430], [15, 449690], [18, 449810], [24, 450190], [27, 450350], [31, 450490], [38, 450870]]}, {"verse": 74, "start": 452024, "end": 457503, "text": "That he would grant to us, that we being delivered out of the hand of our enemies might serve him without fear,", "words": [[0, 452024], [5, 452235], [8, 452375], [14, 452535], [20, 452775], [23, 453015], [27, 453255], [32, 453695], [35, 453895], [41, 454115], [51, 454495], [55, 454795], [58, 454955], [62, 455055], [67, 455275], [70, 455395], [74, 455535], [82, 455855], [88, 456215], [94, 456575], [98, 456755], [106, 456995]]}, {"verse": 75, "start": 457853, "end": 461450, "text": "In holiness and righteousness before him, all the days of our life.", "words": [[0, 457853], [3, 457991], [12, 458331], [16, 458611], [30, 459071], [37, 459471], [42, 459771], [46, 460271], [50, 460451], [55, 460771], [58, 460951], [62, 461111]]}, {"verse": 76, "start": 461800, "end": 468166, "text": "And you, child, shall be called the prophet of the Highest: for you shall go before the face of the Lord to prepare his ways;", "words": [[0, 461800], [4, 461999], [9, 462219], [16, 462919], [22, 463139], [25, 463279], [32, 463499], [36, 463679], [44, 463999], [47, 464159], [51, 464299], [60, 465039], [64, 465132], [68, 465272], [74, 465452], [77, 465632], [84, 465892], [88, 466072], [93, 466352], [96, 466512], [100, 466612], [105, 466852], [108, 467032], [116, 467392], [120, 467612]]}, {"verse": 77, "start": 468516, "end": 472004, "text": "To give knowledge of salvation to his people by the remission of their sins,", "words": [[0, 468516], [3, 468614], [8, 468854], [18, 469234], [21, 469434], [31, 469814], [34, 470074], [38, 470194], [45, 470474], [48, 470674], [52, 470834], [62, 471214], [65, 471354], [71, 471514]]}, {"verse": 78, "start": 472354, "end": 476629, "text": "Through the tender mercy of our God; by which the dayspring from on high has visited us,", "words": [[0, 472354], [8, 472467], [12, 472607], [19, 472867], [25, 473307], [28, 473487], [32, 473607], [37, 474272], [40, 474373], [46, 474553], [50, 474863], [60, 475173], [65, 475373], [68, 475533], [73, 475773], [77, 475953], [85, 476273]]}, {"verse": 79, "start": 476979, "end": 482866, "text": "To give light to them that sit in darkness and in the shadow of death, to guide our feet into the way of peace.", "words": [[0, 476979], [3, 477072], [8, 477312], [14, 477672], [17, 477892], [22, 478092], [27, 478272], [31, 478532], [34, 478672], [43, 479152], [47, 479472], [50, 479592], [54, 479672], [61, 479972], [64, 480172], [71, 480732], [74, 480932], [80, 481152], [84, 481332], [89, 481592], [94, 481872], [98, 482052], [102, 482212], [105, 482352]]}, {"verse": 80, "start": 483146, "end": 489786, "text": "And the child grew, and grew strong in spirit, and was in the deserts till the day of his showing to Israel.", "words": [[0, 483146], [4, 483290], [8, 483370], [14, 483710], [20, 484570], [24, 484810], [29, 485050], [36, 485470], [39, 485730], [47, 486490], [51, 486730], [55, 486910], [58, 487050], [62, 487170], [70, 487750], [75, 487870], [79, 488030], [83, 488290], [86, 488450], [90, 488590], [98, 488950], [101, 489190]]}]}