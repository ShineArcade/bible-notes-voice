{"book": "1CO", "chapter": 13, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 85111, "verses": [{"verse": 1, "start": 300, "end": 7111, "text": "Though I speak with the tongues of men and of angels, and have not love, I am become as sounding brass, or a tinkling cymbal.", "words": [[0, 300], [7, 473], [9, 613], [15, 833], [20, 1073], [24, 1193], [32, 1433], [35, 1633], [39, 1873], [43, 2133], [46, 2293], [54, 3133], [58, 3233], [63, 3413], [67, 3633], [73, 4213], [75, 4353], [78, 4453], [85, 4683], [88, 4913], [97, 5253], [104, 5653], [107, 6133], [109, 6233], [118, 6593]]}, {"verse": 2, "start": 7561, "end": 17268, "text": "And though I have the gift of prophecy, and understand all mysteries, and all knowledge; and though I have all faith, so that I could remove mountains, and have not love, I am nothing.", "words": [[0, 7561], [4, 7712], [11, 7832], [13, 7972], [18, 8172], [22, 8312], [27, 8512], [30, 8672], [40, 9152], [44, 9632], [55, 10112], [59, 10472], [70, 10972], [74, 11312], [78, 11492], [89, 12329], [93, 12472], [100, 12652], [102, 12812], [107, 13012], [111, 13292], [118, 13612], [121, 14092], [126, 14252], [128, 14352], [134, 14472], [141, 14792], [152, 15292], [156, 15632], [161, 15732], [165, 15912], [171, 16472], [173, 16632], [176, 16772]]}, {"verse": 3, "start": 17718, "end": 24093, "text": "And though I bestow all my goods to feed the poor, and though I give my body to be burned, and have not love, it profits me nothing.", "words": [[0, 17718], [4, 17866], [11, 17986], [13, 18086], [20, 18526], [24, 18746], [27, 18926], [33, 19146], [36, 19346], [41, 19566], [45, 19706], [51, 20326], [55, 20426], [62, 20566], [64, 20666], [69, 20826], [72, 21026], [77, 21286], [80, 21466], [83, 21606], [91, 21906], [95, 22086], [100, 22246], [104, 22406], [110, 23026], [113, 23106], [121, 23386], [124, 23626]]}, {"verse": 4, "start": 24543, "end": 30273, "text": "Love suffers long, and is kind; love envies not; love vaunts not i