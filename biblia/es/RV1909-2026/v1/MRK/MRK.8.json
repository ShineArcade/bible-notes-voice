{"book": "MRK", "chapter": 8, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 307869, "verses": [{"verse": 1, "start": 300, "end": 9008, "text": "En aquellos días, cuando hubo gran multitud, y no tenían qué comer, Jesús llamó a sus discípulos, y les dijo:", "words": [[0, 300], [3, 407], [12, 647], [18, 1667], [25, 1827], [30, 2247], [35, 2487], [45, 3247], [47, 3827], [50, 4087], [57, 4347], [61, 4567], [68, 5747], [74, 6127], [80, 6947], [82, 7027], [86, 7207], [98, 8067], [100, 8287], [104, 8447]]}, {"verse": 2, "start": 9458, "end": 15862, "text": "Tengo compasión de la multitud, porque ya hace tres días que están conmigo, y no tienen qué comer:", "words": [[0, 9458], [6, 9700], [16, 10360], [19, 10500], [22, 10600], [32, 11240], [39, 11820], [42, 12160], [47, 12540], [52, 12820], [57, 13180], [61, 13380], [67, 13580], [76, 14440], [78, 14640], [81, 14830], [88, 15020], [92, 15260]]}, {"verse": 3, "start": 16312, "end": 23943, "text": "Y si los envío en ayunas a sus casas, desmayarán en el camino; porque algunos de ellos han venido de lejos.", "words": [[0, 16312], [2, 16591], [5, 16711], [9, 16871], [15, 17371], [18, 17471], [25, 17951], [27, 18071], [31, 18211], [38, 18831], [49, 19971], [52, 20231], [55, 20371], [63, 21276], [70, 21480], [78, 21900], [81, 22120], [87, 22380], [91, 22620], [98, 23080], [101, 23220]]}, {"verse": 4, "start": 24393, "end": 30836, "text": "Y sus discípulos le respondieron: ¿De dónde podrá alguien hartar a estos de pan aquí en el desierto?", "words": [[0, 24393], [2, 24500], [6, 24680], [17, 25480], [20, 25700], [34, 27131], [38, 27307], [44, 27507], [50, 27987], [58, 28227], [65, 28687], [67, 28767], [73, 28967], [76, 29187], [80, 29447], [85, 29747], [88, 30047], [91, 30147]]}, {"verse": 5, "start": 31186, "end": 36497, "text": "Y les preguntó: ¿Cuántos panes tenéis? Y ellos dijeron: Siete.", "words": [[0, 31186], [2, 31329], [6, 31409], [16, 32722], [25, 33108], [31, 33528], [39, 34547], [41, 34715], [47, 34915], [56, 36205]]}, {"verse": 6, "start": 36847, "end": 51132, "text": "Entonces mandó a la multitud que se recostase en tierra; y tomando los siete panes, habiendo dado gracias, partió, y dio a sus discípulos que los pusiesen delante: y los pusieron delante a la multitud.", "words": [[0, 36847], [9, 37427], [15, 38287], [17, 38367], [20, 38467], [29, 39027], [33, 39207], [36, 39347], [46, 39987], [49, 40207], [57, 41188], [59, 41296], [67, 41716], [71, 41876], [77, 42176], [84, 43056], [93, 43396], [98, 43636], [107, 44556], [115, 45056], [117, 45696], [121, 45936], [123, 46176], [127, 46376], [138, 47276], [142, 47456], [146, 47816], [155, 48176], [164, 49113], [166, 49216], [170, 49316], [179, 49756], [187, 50256], [189, 50376], [192, 50436]]}, {"verse": 7, "start": 51582, "end": 57609, "text": "Tenían también unos pocos pececillos: y los bendijo, y mandó que también los pusiesen delante.", "words": [[0, 51582], [7, 51845], [15, 52225], [20, 52465], [26, 53175], [38, 54133], [40, 54220], [44, 54340], [53, 55380], [55, 55460], [61, 55780], [65, 55880], [73, 56200], [77, 56340], [86, 56800]]}, {"verse": 8, "start": 58059, "end": 64587, "text": "Y comieron, y se saciaron: y levantaron de los pedazos que habían sobrado, siete canastas.", "words": [[0, 58059], [2, 58166], [12, 58566], [14, 58766], [17, 58866], [27, 59999], [29, 60124], [40, 60784], [43, 60984], [47, 61124], [55, 62144], [59, 62364], [66, 62604], [75, 63204], [81, 63524]]}, {"verse": 9, "start": 65037, "end": 69090, "text": "Y eran los que comieron, como cuatro mil: y los despidió.", "words": [[0, 65037], [2, 65333], [7, 65533], [11, 65733], [15, 65893], [25, 66333], [30, 66816], [37, 67300], [42, 68029], [44, 68169], [48, 68289]]}, {"verse": 10, "start": 69540, "end": 75233, "text": "Y luego entrando en el barco con sus discípulos, vino a las partes de Dalmanutha.", "words": [[0, 69540], [2, 69681], [8, 69861], [17, 70501], [20, 70661], [23, 70801], [29, 71261], [33, 71481], [37, 71681], [49, 72881], [54, 73361], [56, 73581], [60, 73701], [67, 74121], [70, 74697]]}, {"verse": 11, "start": 75683, "end": 83289, "text": "Y vinieron los fariseos, y comenzaron a discutir con él, pidiéndole señal del cielo, poniéndolo a prueba.", "words": [[0, 75683], [2, 75804], [11, 76244], [15, 76444], [25, 77304], [27, 77704], [38, 78464], [40, 78584], [49, 79164], [53, 79344], [57, 80044], [68, 80604], [74, 81064], [78, 81184], [85, 81964], [96, 82584], [98, 82704]]}, {"verse": 12, "start": 83739, "end": 93184, "text": "Y gimiendo en su espíritu, dice: ¿Por qué pide señal esta generación? De cierto os digo que no se dará señal a esta generación.", "words": [[0, 83739], [2, 84082], [11, 84442], [14, 84562], [17, 84742], [27, 85542], [33, 86409], [38, 86534], [42, 86714], [47, 87054], [53, 87554], [58, 87754], [70, 89103], [73, 89269], [80, 89829], [83, 89929], [88, 90209], [92, 90449], [95, 90629], [98, 90809], [103, 91149], [109, 91669], [111, 91829], [116, 92149]]}, {"verse": 13, "start": 93634, "end": 98381, "text": "Y dejándolos, volvió a entrar en el barco, y se fue de la otra parte.", "words": [[0, 93634], [2, 93756], [14, 94556], [21, 95176], [23, 95236], [30, 95596], [33, 95856], [36, 95976], [43, 96516], [45, 96936], [48, 97076], [52, 97276], [55, 97396], [58, 97516], [63, 97696]]}, {"verse": 14, "start": 98831, "end": 104292, "text": "Y se habían olvidado de tomar pan, y no tenían sino un pan consigo en el barco.", "words": [[0, 98831], [2, 98949], [5, 99049], [12, 99249], [21, 99909], [24, 100089], [30, 100369], [35, 100709], [37, 101189], [40, 101329], [47, 101729], [52, 102149], [55, 102509], [59, 102809], [67, 103369], [70, 103609], [73, 103749]]}, {"verse": 15, "start": 104742, "end": 112027, "text": "Y les advirtió, diciendo: Mirad, guardaos de la levadura de los fariseos, y de la levadura de Herodes.", "words": [[0, 104742], [2, 104887], [6, 105087], [16, 105827], [26, 106837], [33, 107663], [42, 108303], [45, 108482], [48, 108622], [57, 109122], [60, 109282], [64, 109402], [74, 110182], [76, 110402], [79, 110523], [82, 110663], [91, 111163], [94, 111342]]}, {"verse": 16, "start": 112477, "end": 115305, "text": "Y discutían entre sí porque no tenían pan.", "words": [[0, 112477], [2, 112985], [12, 113566], [18, 113806], [21, 114066], [28, 114306], [31, 114506], [38, 114786]]}, {"verse": 17, "start": 115655, "end": 125880, "text": "Y como Jesús lo entendió, les dice: ¿Por qué discutís, porque no tenéis pan? ¿no consideráis ni entendéis? ¿aún tenéis endurecido vuestro corazón?", "words": [[0, 115655], [2, 115776], [7, 116036], [13, 116396], [16, 116696], [26, 117696], [30, 117916], [36, 118783], [41, 118887], [45, 119067], [55, 119627], [62, 119847], [65, 120067], [72, 120427], [77, 121198], [81, 121306], [93, 122066], [96, 122206], [107, 123476], [112, 123660], [119, 124080], [130, 124720], [138, 125060]]}, {"verse": 18, "start": 126330, "end": 131717, "text": "¿Teniendo ojos no veis, y teniendo oídos no oís? ¿y no os acordáis?", "words": [[0, 126330], [10, 126734], [15, 127034], [18, 127294], [24, 127694], [26, 127874], [35, 128374], [41, 129114], [44, 129434], [49, 130384], [52, 130513], [55, 130653], [58, 130793]]}, {"verse": 19, "start": 132167, "end": 141732, "text": "Cuando partí los cinco panes entre cinco mil, ¿cuántas cestas llenas de los pedazos recogisteis? Y ellos dijeron: Doce.", "words": [[0, 132167], [7, 132349], [13, 132849], [17, 132969], [23, 133289], [29, 133829], [35, 134029], [41, 134509], [46, 135169], [55, 136269], [62, 136889], [69, 137309], [72, 137449], [76, 137569], [84, 138269], [97, 139825], [99, 139993], [105, 140193], [114, 141459]]}, {"verse": 20, "start": 142082, "end": 150670, "text": "Y cuando los siete panes entre cuatro mil, ¿cuántas canastas llenas de los pedazos recogisteis? Y ellos dijeron: Siete.", "words": [[0, 142082], [2, 142185], [9, 142385], [13, 142645], [19, 143005], [25, 143585], [31, 143825], [38, 144125], [43, 144585], [52, 145705], [61, 146365], [68, 146685], [71, 146785], [75, 146905], [83, 147365], [96, 148720], [98, 148888], [104, 149088], [113, 150378]]}, {"verse": 21, "start": 151020, "end": 153960, "text": "Y les dijo: ¿Cómo aún no entendéis?", "words": [[0, 151020], [2, 151168], [6, 151308], [12, 152123], [18, 152510], [22, 152750], [25, 152990]]}, {"verse": 22, "start": 154410, "end": 159329, "text": "Y vino a Betsaida; y le traen un ciego, y le ruegan que le tocase.", "words": [[0, 154410], [2, 154536], [7, 154796], [9, 155245], [19, 155955], [21, 156067], [24, 156147], [30, 156587], [33, 156727], [40, 157267], [42, 157747], [45, 157867], [52, 158287], [56, 158447], [59, 158547]]}, {"verse": 23, "start": 159779, "end": 170630, "text": "Entonces, tomando la mano del ciego, le sacó fuera de la aldea; y escupiendo en sus ojos, y poniéndole las manos encima, le preguntó si veía algo.", "words": [[0, 159779], [10, 160299], [18, 160919], [21, 161039], [26, 161259], [30, 161459], [37, 161959], [40, 162419], [45, 162799], [51, 163079], [54, 163259], [57, 163419], [64, 164491], [66, 164634], [77, 165354], [80, 165514], [84, 165674], [90, 166114], [92, 166674], [103, 167047], [107, 167421], [113, 167794], [121, 168354], [124, 168894], [133, 169474], [136, 169634], [141, 170034]]}, {"verse": 24, "start": 171080, "end": 178542, "text": "Y él mirando, dijo: Veo a los hombres; parecen árboles que caminan.", "words": [[0, 171080], [2, 171268], [5, 171488], [14, 172228], [20, 173046], [24, 173422], [26, 173522], [30, 173662], [39, 174668], [47, 175112], [55, 175692], [59, 175872]]}, {"verse": 25, "start": 178892, "end": 188539, "text": "Luego le puso otra vez las manos sobre sus ojos, y le hizo que mirase; y fue restablecido, y vio a todos de lejos y con claridad.", "words": [[0, 178892], [6, 179115], [9, 179395], [14, 179855], [19, 180115], [23, 180475], [27, 180755], [33, 181235], [39, 181635], [43, 181875], [49, 182275], [51, 182975], [54, 183115], [59, 183375], [63, 183833], [71, 184532], [73, 184636], [77, 184796], [91, 185776], [93, 186156], [97, 186396], [99, 186496], [105, 186736], [108, 186956], [114, 187376], [116, 187596], [120, 187776]]}, {"verse": 26, "start": 188989, "end": 195881, "text": "Y le envió a su casa, diciendo: No entres en la aldea, ni lo digas a nadie en la aldea.", "words": [[0, 188989], [2, 189108], [5, 189208], [11, 189488], [13, 189608], [16, 189708], [22, 190048], [32, 191085], [35, 191329], [42, 192149], [45, 192529], [48, 192749], [55, 193329], [58, 193789], [61, 193989], [67, 194349], [69, 194469], [75, 194789], [78, 195029], [81, 195229]]}, {"verse": 27, "start": 196331, "end": 208080, "text": "Y salió Jesús y sus discípulos por las aldeas de Cesarea de Filipo. Y en el camino preguntó a sus discípulos, diciéndoles: ¿Quién dicen los hombres que soy yo?", "words": [[0, 196331], [2, 196456], [8, 196796], [14, 197336], [16, 197876], [20, 198096], [31, 198876], [35, 199076], [39, 199276], [46, 199716], [49, 200086], [57, 200456], [60, 200861], [68, 201512], [70, 201674], [73, 201804], [76, 201934], [83, 202434], [92, 203034], [94, 203134], [98, 203294], [110, 204514], [123, 205962], [130, 206266], [136, 206606], [140, 206826], [148, 207206], [152, 207406], [156, 207606]]}, {"verse": 28, "start": 208530, "end": 215185, "text": "Y ellos respondieron: Juan Bautista; y otros, Elías; y otros, Alguno de los profetas.", "words": [[0, 208530], [2, 208815], [8, 209015], [22, 210264], [27, 210528], [37, 211707], [39, 211869], [46, 212149], [53, 213287], [55, 213412], [62, 213772], [69, 214132], [72, 214312], [76, 214412]]}, {"verse": 29, "start": 215535, "end": 225377, "text": "Entonces él les dice: Y vosotros, ¿quién decís que soy yo? Y respondiendo Pedro, le dice: Tú eres el Cristo.", "words": [[0, 215535], [9, 216640], [12, 217140], [16, 217460], [22, 218452], [24, 218560], [34, 219380], [41, 219660], [47, 220080], [51, 220200], [55, 220440], [59, 221210], [61, 221320], [74, 222420], [81, 222760], [84, 223360], [90, 224211], [93, 224356], [98, 224596], [101, 224796]]}, {"verse": 30, "start": 225727, "end": 228358, "text": "Y les mandó que no hablasen de él a ninguno.", "words": [[0, 225727], [2, 225848], [6, 225968], [12, 226388], [16, 226528], [19, 226858], [28, 227188], [31, 227348], [34, 227568], [36, 227648]]}, {"verse": 31, "start": 228808, "end": 243026, "text": "Y comenzó a enseñarles, que convenía que el Hijo del hombre padeciese mucho, fuese rechazado por los ancianos, los principales sacerdotes y los escribas, fuera muerto y resucitara después de tres días.", "words": [[0, 228808], [2, 228932], [10, 229432], [12, 229512], [24, 230292], [28, 230752], [37, 231372], [41, 231532], [44, 231792], [49, 232052], [53, 232192], [60, 232682], [70, 233172], [77, 234072], [83, 234512], [93, 235652], [97, 235852], [101, 236052], [111, 237152], [115, 237252], [127, 238012], [138, 238712], [140, 238872], [144, 238992], [154, 240113], [160, 240375], [167, 240915], [169, 240995], [180, 241735], [188, 242035], [191, 242255], [196, 242455]]}, {"verse": 32, "start": 243476, "end": 250411, "text": "Y claramente decía esta palabra. Entonces Pedro le tomó, y le comenzó a reprender.", "words": [[0, 243476], [2, 243603], [13, 244263], [19, 244783], [24, 245123], [33, 246146], [42, 246688], [48, 247428], [51, 247708], [57, 248208], [59, 248528], [62, 248668], [70, 249328], [72, 249528]]}, {"verse": 33, "start": 250861, "end": 263988, "text": "Y él, volviéndose y mirando a sus discípulos, reprendió a Pedro, diciendo: Apártate de mí, Satanás; porque no pones la mira en las cosas de Dios, sino en las que son de los hombres.", "words": [[0, 250861], [2, 251008], [6, 251148], [18, 252028], [20, 252248], [28, 252668], [30, 252788], [34, 253008], [46, 254128], [56, 254828], [58, 254928], [65, 255268], [75, 256636], [84, 257377], [87, 257537], [91, 257697], [100, 258954], [107, 259159], [110, 259379], [116, 259759], [119, 259939], [124, 260219], [127, 260439], [131, 260599], [137, 260899], [140, 261139], [146, 261719], [151, 262039], [154, 262239], [158, 262399], [162, 262579], [166, 262859], [169, 263039], [173, 263199]]}, {"verse": 34, "start": 264438, "end": 274846, "text": "Y llamando a la gente con sus discípulos, les dijo: Si alguno quiere venir en pos de mí, niéguese a sí mismo, y tome su cruz, y sígame.", "words": [[0, 264438], [2, 264544], [11, 265064], [13, 265164], [16, 265224], [22, 265564], [26, 265824], [30, 266064], [42, 267084], [46, 267204], [52, 268073], [55, 268220], [62, 268640], [69, 268860], [75, 269240], [78, 269440], [82, 269660], [85, 269840], [89, 270580], [98, 271340], [100, 271520], [103, 271620], [110, 272060], [112, 272620], [117, 272980], [120, 273120], [126, 274040], [128, 274160]]}, {"verse": 35, "start": 275296, "end": 284339, "text": "Porque todo el que quiera salvar su vida, la perderá; y todo el que pierda su vida por causa de mí y del evangelio, la salvará.", "words": [[0, 275296], [7, 275540], [12, 275940], [15, 276180], [19, 276340], [26, 276660], [33, 277040], [36, 277320], [42, 277680], [45, 278340], [54, 279510], [56, 279633], [61, 279953], [64, 280213], [68, 280353], [75, 280833], [78, 281013], [83, 281333], [87, 281553], [93, 281873], [96, 282173], [99, 282353], [101, 282593], [105, 282733], [116, 283433], [119, 283633]]}, {"verse": 36, "start": 284789, "end": 289634, "text": "Porque ¿qué aprovechará al hombre, si gana todo el mundo, y pierde su alma?", "words": [[0, 284923], [7, 285093], [12, 285313], [24, 286133], [27, 286273], [35, 286573], [38, 286873], [43, 287173], [48, 287373], [51, 287573], [58, 287913], [60, 288353], [67, 288833], [70, 289033]]}, {"verse": 37, "start": 290084, "end": 293335, "text": "¿O qué dará el hombre a cambio de su alma?", "words": [[0, 290084], [3, 290225], [7, 290425], [12, 290865], [15, 291085], [22, 291445], [24, 291705], [31, 292125], [34, 292385], [37, 292605]]}, {"verse": 38, "start": 293785, "end": 307469, "text": "Porque el que se avergüence de mí y de mis palabras en esta generación adúltera y pecadora, el Hijo del hombre se avergonzará también de él, cuando venga en la gloria de su Padre con los santos ángeles.", "words": [[0, 293785], [7, 294047], [10, 294327], [14, 294487], [17, 294907], [28, 295327], [31, 295547], [34, 295827], [36, 296047], [39, 296187], [43, 296307], [52, 296787], [55, 297107], [60, 297367], [71, 298047], [80, 298727], [82, 298887], [92, 300107], [95, 300247], [100, 300527], [104, 300707], [111, 301127], [114, 301487], [126, 302267], [134, 302567], [137, 302887], [141, 303584], [148, 303766], [154, 304246], [157, 304366], [160, 304506], [167, 304886], [170, 305046], [173, 305206], [179, 305786], [183, 305946], [187, 306146], [194, 306646]]}]}