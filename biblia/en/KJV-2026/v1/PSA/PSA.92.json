{"book": "PSA", "chapter": 92, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 86548, "verses": [{"verse": 1, "start": 300, "end": 5789, "text": "It is a good thing to give thanks to the LORD, and to sing praises to your name, O most High:", "words": [[0, 300], [3, 422], [6, 522], [8, 622], [13, 802], [19, 1042], [22, 1202], [27, 1362], [34, 1682], [37, 1942], [41, 2102], [47, 2402], [51, 2942], [54, 3102], [59, 3282], [67, 3802], [70, 4042], [75, 4202], [81, 4762], [83, 4882], [88, 5202]]}, {"verse": 2, "start": 6239, "end": 10848, "text": "To show forth your lovingkindness in the morning, and your faithfulness every night,", "words": [[0, 6239], [3, 6340], [8, 6580], [14, 6900], [19, 7380], [34, 7860], [37, 8160], [41, 8240], [50, 8580], [54, 9180], [59, 9340], [72, 9980], [78, 10320]]}, {"verse": 3, "start": 11298, "end": 17745, "text": "Upon an instrument of ten strings, and upon the psaltery; upon the harp with a solemn sound.", "words": [[0, 11298], [5, 11587], [8, 11767], [19, 12247], [22, 12667], [26, 13027], [35, 13667], [39, 14067], [44, 14367], [48, 14874], [58, 15652], [63, 15869], [67, 16109], [72, 16349], [77, 16589], [79, 16729], [86, 17049]]}, {"verse": 4, "start": 18195, "end": 23841, "text": "For you, LORD, have made me glad through your work: I will triumph in the works of your hands.", "words": [[0, 18195], [4, 18314], [9, 18654], [15, 19174], [20, 19294], [25, 19534], [28, 19734], [33, 20154], [41, 20474], [46, 20674], [52, 21515], [54, 21659], [59, 21839], [67, 22299], [70, 22519], [74, 22619], [80, 22879], [83, 23099], [88, 23239]]}, {"verse": 5, "start": 24291, "end": 28218, "text": "O LORD, how great are your works! and your thoughts are very deep.", "words": [[0, 24354], [2, 24454], [8, 24974], [12, 25114], [18, 25494], [22, 25634], [27, 25774], [34, 26714], [38, 26856], [43, 26956], [52, 27196], [56, 27396], [61, 27676]]}, {"verse": 6, "start": 28668, "end": 32715, "text": "A brutish man knows not; neithe