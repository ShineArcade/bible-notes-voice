{"book": "MAT", "chapter": 24, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 380162, "verses": [{"verse": 1, "start": 300, "end": 8007, "text": "Y salido Jesús, se iba del templo; y se llegaron sus discípulos, para mostrarle los edificios del templo.", "words": [[0, 300], [2, 422], [9, 842], [16, 1162], [19, 1582], [23, 1802], [27, 2022], [35, 2982], [37, 3108], [40, 3188], [49, 3648], [53, 3908], [65, 4828], [70, 5348], [80, 6188], [84, 6368], [94, 7148], [98, 7328]]}, {"verse": 2, "start": 8357, "end": 19129, "text": "Y respondiendo él, les dijo: ¿Veis todo esto? de cierto os digo, que no será dejada aquí piedra sobre piedra, que no sea destruida.", "words": [[0, 8357], [2, 8561], [15, 9301], [19, 9741], [23, 10181], [29, 10936], [35, 11316], [40, 11516], [46, 12479], [49, 12732], [56, 13018], [59, 13305], [65, 14165], [69, 14405], [72, 14565], [77, 14825], [84, 15445], [89, 15725], [96, 16245], [102, 16505], [110, 17585], [114, 17645], [117, 17825], [121, 18085]]}, {"verse": 3, "start": 19479, "end": 31929, "text": "Y sentándose él en el monte de los Olivos, se llegaron a él los discípulos aparte, diciendo: Dinos, ¿cuándo serán estas cosas, y qué señal habrá de tu venida, y del fin del mundo?", "words": [[0, 19479], [2, 19604], [13, 20584], [16, 21024], [19, 21304], [22, 21624], [28, 21944], [31, 22104], [35, 22284], [43, 23124], [46, 23424], [55, 23944], [57, 24064], [60, 24264], [64, 24444], [75, 25084], [83, 26124], [93, 27223], [100, 27519], [108, 27939], [114, 28279], [120, 28439], [127, 28899], [129, 29379], [133, 29519], [139, 29899], [145, 30139], [148, 30199], [151, 30319], [159, 30759], [161, 30959], [165, 31119], [169, 31279], [173, 31439]]}, {"verse": 4, "start": 32209, "end": 36680, "text": "Y respondiendo Jesús, les dijo: Mirad que nadie os engañe.", "words": [[0, 32209], [2, 32330], [15, 33130], [22, 33490], [26, 33850], [32, 34660], [38, 35107], [42, 35307], [48, 35667], [51, 35947]]}, {"verse": 5, "start": 37030, "end": 43516, "text": "Porque vendrán muchos en mi nombre, diciendo: Yo soy el Cristo; y a muchos engañarán.", "words": [[0, 37030], [7, 37232], [15, 37772], [22, 38112], [25, 38412], [28, 38572], [36, 38932], [46, 40100], [49, 40457], [53, 40677], [56, 40897], [64, 41937], [66, 42061], [68, 42141], [75, 42641]]}, {"verse": 6, "start": 43866, "end": 53729, "text": "Y oiréis guerras, y rumores de guerras: mirad que no os turbéis; porque es necesario que todo esto acontezca; pero aún no es el fin.", "words": [[0, 43866], [2, 44030], [9, 44470], [18, 44990], [20, 45390], [28, 45950], [31, 46130], [40, 47070], [46, 47515], [50, 47735], [53, 47975], [56, 48135], [65, 49268], [72, 49418], [75, 49498], [85, 50078], [89, 50298], [94, 50498], [99, 50942], [110, 51605], [115, 51872], [119, 52272], [122, 52632], [125, 52892], [128, 53052]]}, {"verse": 7, "start": 53729, "end": 62097, "text": "Porque se levantará nación contra nación, y reino contra reino; y habrá pestes, y hambres, y terremotos por los lugares.", "words": [[0, 53729], [7, 53949], [10, 54109], [20, 54689], [27, 55109], [34, 55509], [42, 55989], [44, 56429], [50, 56969], [57, 57349], [64, 58391], [66, 58515], [72, 58885], [80, 59255], [82, 59565], [91, 59875], [93, 60315], [104, 60995], [108, 61175], [112, 61335]]}, {"verse": 8, "start": 62447, "end": 65823, "text": "Y todas estas cosas, principio de dolores.", "words": [[0, 62447], [2, 62548], [8, 62728], [14, 63108], [21, 63968], [31, 64648], [34, 64988]]}, {"verse": 9, "start": 66173, "end": 75389, "text": "Entonces os entregarán para ser afligidos, y os matarán; y seréis aborrecidos de todas las gentes por causa de mi nombre.", "words": [[0, 66173], [9, 67079], [12, 67199], [23, 68039], [28, 68219], [32, 68459], [43, 69179], [45, 69359], [48, 69479], [57, 70436], [59, 70539], [66, 71189], [78, 71839], [81, 71999], [87, 72459], [91, 72919], [98, 73439], [102, 73899], [108, 74259], [111, 74559], [114, 74679]]}, {"verse": 10, "start": 75739, "end": 84718, "text": "Y muchos entonces serán escandalizados; y se entregarán unos a otros, y unos a otros se aborrecerán.", "words": [[0, 75739], [2, 75867], [9, 76207], [18, 76967], [24, 77827], [40, 79313], [42, 79659], [45, 79779], [56, 80579], [61, 80859], [63, 81219], [70, 82039], [72, 82419], [77, 82659], [79, 82879], [85, 83199], [88, 83719]]}, {"verse": 11, "start": 85068, "end": 89712, "text": "Y muchos falsos profetas se levantarán y engañarán a muchos.", "words": [[0, 85068], [2, 85190], [9, 85410], [16, 86010], [25, 86530], [28, 86730], [39, 87450], [41, 87810], [51, 88670], [53, 88850]]}, {"verse": 12, "start": 90062, "end": 94577, "text": "Y por haberse multiplicado la maldad, el amor de muchos se enfriará.", "words": [[0, 90062], [2, 90315], [6, 90495], [14, 90875], [27, 91695], [30, 91855], [38, 92635], [41, 92715], [46, 92975], [49, 93155], [56, 93435], [59, 93815]]}, {"verse": 13, "start": 94927, "end": 98576, "text": "Pero el que persevere hasta el fin, este será salvo.", "words": [[0, 94927], [5, 95072], [8, 95252], [12, 95352], [22, 96132], [28, 96392], [31, 96572], [36, 97412], [41, 97612], [46, 97932]]}, {"verse": 14, "start": 98926, "end": 107746, "text": "Y será predicado este evangelio del reino en todo el mundo, por testimonio a todos los Gentiles; y entonces vendrá el fin.", "words": [[0, 98926], [2, 99047], [7, 99307], [17, 100147], [22, 100367], [32, 101127], [36, 101267], [42, 101767], [45, 101907], [50, 102107], [53, 102307], [60, 103067], [64, 103307], [75, 104167], [77, 104267], [83, 104447], [87, 104747], [97, 105807], [99, 105936], [108, 106416], [115, 107276], [118, 107511]]}, {"verse": 15, "start": 108096, "end": 116147, "text": "Por tanto, cuando veáis en el lugar santo la abominación desoladora de que habló el profeta Daniel (el que lee, entienda),", "words": [[0, 108096], [4, 108221], [11, 108681], [18, 108881], [24, 109361], [27, 109541], [30, 109661], [36, 109961], [42, 110664], [45, 110796], [57, 111736], [68, 112516], [71, 112716], [75, 112856], [81, 113196], [84, 113296], [92, 113836], [99, 114541], [103, 114661], [107, 114821], [112, 115510]]}, {"verse": 16, "start": 116497, "end": 120437, "text": "Entonces los que están en Judea, huyan a los montes;", "words": [[0, 116497], [9, 117095], [13, 117675], [17, 117835], [23, 118035], [26, 118195], [33, 118795], [39, 119415], [41, 119615], [45, 119735]]}, {"verse": 17, "start": 120787, "end": 126018, "text": "Y el que sobre la azotea, no descienda a tomar algo de su casa;", "words": [[0, 120787], [2, 120949], [5, 121049], [9, 121229], [15, 121649], [18, 121889], [26, 122729], [29, 123309], [39, 123969], [41, 124169], [47, 124469], [52, 125049], [55, 125269], [58, 125409]]}, {"verse": 18, "start": 126368, "end": 131081, "text": "Y el que en el campo, no vuelva atrás a tomar sus vestidos.", "words": [[0, 126368], [2, 126574], [5, 126774], [9, 126994], [12, 127294], [15, 127454], [22, 128014], [25, 128489], [32, 128969], [38, 129289], [40, 129529], [46, 129849], [50, 130109]]}, {"verse": 19, "start": 131431, "end": 136154, "text": "Pero ¡ay de las embarazadas, y de las que crían en aquellos días!", "words": [[0, 131431], [5, 131716], [9, 132036], [12, 132216], [16, 132356], [29, 133296], [31, 133521], [34, 133621], [38, 133761], [42, 133901], [48, 134361], [51, 134501], [60, 134741]]}, {"verse": 20, "start": 136504, "end": 141185, "text": "Orad, pues, que vuestra huida no sea en invierno ni en sábado;", "words": [[0, 136504], [6, 136854], [12, 137154], [16, 137734], [24, 138114], [30, 138514], [33, 138674], [37, 139014], [40, 139254], [49, 139854], [52, 140334], [55, 140494]]}, {"verse": 21, "start": 141535, "end": 148706, "text": "Porque habrá entonces grande aflicción, cual no fue desde el principio del mundo hasta ahora, ni será.", "words": [[0, 141535], [7, 141740], [13, 142060], [22, 142480], [29, 143200], [40, 144460], [45, 144920], [48, 145080], [52, 145340], [58, 145640], [61, 145820], [71, 146380], [75, 146700], [81, 147020], [87, 147280], [94, 147920], [97, 148120]]}, {"verse": 22, "start": 149056, "end": 157468, "text": "Y si aquellos días no fuesen acortados, nadie sobreviviría; pero por causa de los escogidos, aquellos días serán acortados.", "words": [[0, 149056], [2, 149196], [5, 149296], [14, 149536], [19, 149846], [22, 150156], [29, 150596], [40, 151716], [46, 152256], [60, 153892], [65, 154056], [69, 154316], [75, 154596], [78, 154876], [82, 154976], [93, 155656], [102, 155936], [107, 156256], [113, 156656]]}, {"verse": 23, "start": 157818, "end": 165122, "text": "Entonces, si alguno os dice: Mirad, aquí está el Cristo» o «Mirad, allí está», no lo creáis.", "words": [[0, 157818], [10, 158758], [13, 158998], [20, 159288], [23, 159578], [29, 160348], [36, 160658], [41, 161138], [46, 161358], [49, 161498], [57, 161918], [59, 162518], [67, 163238], [72, 163538], [79, 163878], [82, 164218], [85, 164358]]}, {"verse": 24, "start": 165472, "end": 177238, "text": "Porque se levantarán falsos Cristos, y falsos profetas, y darán señales grandes y prodigios; de tal manera que engañarán, si es posible, aun a los escogidos.", "words": [[0, 165472], [7, 165655], [10, 165835], [21, 166435], [28, 166975], [37, 167675], [39, 167795], [46, 168215], [56, 168815], [58, 169455], [64, 169815], [72, 170275], [80, 170735], [82, 171155], [93, 172352], [96, 172478], [100, 172658], [107, 172998], [111, 173238], [122, 174138], [125, 174498], [128, 174698], [137, 175278], [141, 175898], [143, 176238], [147, 176418]]}, {"verse": 25, "start": 177588, "end": 179800, "text": "He aquí os lo he dicho antes.", "words": [[0, 177688], [3, 177788], [8, 178068], [11, 178408], [14, 178628], [17, 178748], [23, 178988]]}, {"verse": 26, "start": 180150, "end": 188162, "text": "Así que, si os dicen: He aquí en el desierto está; no salgáis: He aquí en lugares ocultos; no creáis.", "words": [[0, 180150], [4, 180458], [9, 180658], [12, 180828], [15, 180998], [22, 181873], [25, 181963], [30, 182223], [33, 182463], [36, 182583], [45, 183103], [51, 183858], [54, 184400], [63, 185191], [66, 185271], [71, 185491], [74, 185711], [82, 186051], [91, 187269], [94, 187447]]}, {"verse": 27, "start": 188512, "end": 196219, "text": "Porque como el relámpago que sale del oriente y se muestra hasta el occidente, así será también la venida del Hijo del hombre.", "words": [[0, 188512], [7, 188774], [12, 189094], [15, 189314], [25, 190054], [29, 190234], [34, 190614], [38, 190834], [46, 191314], [48, 191494], [51, 191594], [59, 192014], [65, 192214], [68, 192354], [79, 192974], [83, 193614], [88, 193954], [96, 194394], [99, 194724], [106, 195054], [110, 195254], [115, 195474], [119, 195694]]}, {"verse": 28, "start": 196569, "end": 201576, "text": "Porque donde quiera que esté el cuerpo muerto, allí se juntarán las águilas.", "words": [[0, 196569], [7, 196793], [13, 197053], [20, 197593], [24, 197753], [29, 197953], [32, 198073], [39, 198353], [47, 199433], [52, 199853], [55, 200053], [64, 200593], [68, 201103]]}, {"verse": 29, "start": 201926, "end": 215717, "text": "Y luego después de la aflicción de aquellos días, el sol se oscurecerá, y la luna no dará su resplandor, y las estrellas caerán del cielo, y las potencias de los cielos serán conmovidas.", "words": [[0, 201926], [2, 202048], [8, 202388], [16, 202668], [19, 202928], [22, 203048], [32, 203788], [35, 203968], [44, 204228], [50, 204698], [53, 205168], [57, 205548], [60, 206008], [72, 206908], [74, 207348], [77, 207488], [82, 207868], [85, 208368], [90, 208728], [93, 208908], [105, 209668], [107, 210348], [111, 210528], [121, 211088], [128, 211548], [132, 211728], [139, 212697], [141, 212937], [145, 213077], [155, 213737], [158, 213877], [162, 214017], [169, 214497], [175, 214817]]}, {"verse": 30, "start": 216067, "end": 231263, "text": "Y entonces se mostrará la señal del Hijo del hombre en el cielo; y entonces lamentarán todas las tribus de la tierra, y verán al Hijo del hombre que vendrá sobre las nubes del cielo, con grande poder y gloria.", "words": [[0, 216067], [2, 216220], [11, 216660], [14, 217220], [23, 217820], [26, 217920], [32, 218420], [36, 218580], [41, 218880], [45, 219040], [52, 219480], [55, 219680], [58, 219820], [65, 220664], [67, 220807], [76, 221307], [87, 222387], [93, 222747], [97, 223287], [104, 223827], [107, 223927], [110, 224047], [118, 224487], [120, 225147], [126, 225527], [129, 225747], [134, 225967], [138, 226207], [145, 226567], [149, 226787], [156, 227227], [162, 227527], [166, 227767], [172, 228247], [176, 228407], [183, 228847], [187, 229547], [194, 229987], [200, 230407], [202, 230607]]}, {"verse": 31, "start": 231613, "end": 241956, "text": "Y enviará sus ángeles con gran voz de trompeta, y juntarán sus escogidos de los cuatro vientos, de un extremo del cielo hasta el otro.", "words": [[0, 231613], [2, 231732], [10, 232332], [14, 232532], [22, 233252], [26, 233692], [31, 233972], [35, 234292], [38, 234472], [48, 235392], [50, 235852], [59, 236572], [63, 236772], [73, 237592], [76, 237772], [80, 237912], [87, 238172], [96, 238792], [99, 239252], [102, 239432], [110, 240172], [114, 240312], [120, 240832], [126, 241252], [129, 241452]]}, {"verse": 32, "start": 242306, "end": 250747, "text": "De la higuera aprended la parábola: Cuando ya su rama se pone tierna, y las hojas brotan, sabéis que el verano está cerca.", "words": [[0, 242306], [3, 242471], [6, 242878], [14, 243284], [23, 243691], [26, 243971], [36, 244988], [43, 245173], [46, 245453], [49, 245733], [54, 246013], [57, 246193], [62, 246373], [70, 247013], [72, 247433], [76, 247613], [82, 247913], [90, 248753], [97, 249193], [101, 249373], [104, 249493], [111, 249853], [116, 250053]]}, {"verse": 33, "start": 251097, "end": 257708, "text": "Así también vosotros, cuando veáis todas estas cosas, conoced que está cerca, a las puertas.", "words": [[0, 251097], [4, 251438], [12, 251778], [22, 252818], [29, 253018], [35, 253538], [41, 253798], [47, 254198], [54, 254758], [62, 255318], [66, 255608], [71, 255898], [78, 256378], [80, 256878], [84, 256978]]}, {"verse": 34, "start": 258058, "end": 264484, "text": "De cierto os digo, que no pasará esta generación, que todas estas cosas no acontezcan.", "words": [[0, 258058], [3, 258246], [10, 258546], [13, 258966], [19, 259846], [23, 260026], [26, 260146], [33, 260586], [38, 260906], [50, 262046], [54, 262346], [60, 262566], [66, 262846], [72, 263246], [75, 263546]]}, {"verse": 35, "start": 264834, "end": 269209, "text": "El cielo y la tierra pasarán, pero mis palabras no pasarán.", "words": [[0, 264834], [3, 264977], [9, 265377], [11, 265677], [14, 265817], [21, 266077], [30, 266997], [35, 267357], [39, 267577], [48, 268017], [51, 268537]]}, {"verse": 36, "start": 269559, "end": 276098, "text": "Pero del día y hora nadie sabe, ni aun los ángeles de los cielos, sino mi Padre solo.", "words": [[0, 269559], [5, 269721], [9, 269981], [13, 270301], [15, 270521], [20, 270721], [26, 271081], [32, 272201], [35, 272481], [39, 272761], [43, 273021], [51, 273561], [54, 273701], [58, 273841], [66, 274581], [71, 274821], [74, 275061], [80, 275321]]}, {"verse": 37, "start": 276448, "end": 280710, "text": "Pero como los días de Noé, así será la venida del Hijo del hombre.", "words": [[0, 276448], [5, 276592], [10, 276852], [14, 277072], [19, 277412], [22, 277632], [27, 277992], [31, 278352], [36, 278732], [39, 279052], [46, 279372], [50, 279612], [55, 279932], [59, 280112]]}, {"verse": 38, "start": 281060, "end": 290719, "text": "Porque como en los días antes del diluvio estaban comiendo y bebiendo, casándose y dando en casamiento, hasta el día que Noé entró en el arca,", "words": [[0, 281060], [7, 281321], [12, 281601], [15, 281761], [19, 281881], [24, 282121], [30, 282581], [34, 282821], [42, 283361], [50, 283641], [59, 284381], [61, 284481], [71, 285441], [81, 286121], [83, 286421], [89, 286701], [92, 286901], [104, 287921], [110, 288201], [113, 288401], [117, 288641], [121, 288941], [125, 289241], [131, 289881], [134, 290041], [137, 290181]]}, {"verse": 39, "start": 291069, "end": 297780, "text": "Y no conocieron hasta que vino el diluvio y llevó a todos, así será también la venida del Hijo del hombre.", "words": [[0, 291069], [2, 291198], [5, 291318], [16, 291938], [22, 292198], [26, 292398], [31, 292618], [34, 292818], [42, 293358], [44, 293518], [50, 293838], [52, 293898], [59, 294978], [63, 295198], [68, 295518], [76, 295938], [79, 296138], [86, 296578], [90, 296798], [95, 297038], [99, 297258]]}, {"verse": 40, "start": 298130, "end": 304797, "text": "Entonces estarán dos en el campo; el uno será tomado, y el otro será dejado:", "words": [[0, 298643], [9, 299179], [17, 299739], [21, 300059], [24, 300499], [27, 300639], [34, 301486], [37, 301654], [41, 301914], [46, 302154], [54, 302894], [56, 303179], [59, 303339], [64, 303599], [69, 303959]]}, {"verse": 41, "start": 305147, "end": 311533, "text": "Dos mujeres moliendo en un molino; la una será tomada, y la otra será dejada.", "words": [[0, 305147], [4, 305809], [12, 306349], [21, 307189], [24, 307389], [27, 307529], [35, 308542], [38, 308687], [42, 308907], [47, 309187], [55, 309827], [57, 309947], [60, 310087], [65, 310367], [70, 310667]]}, {"verse": 42, "start": 311883, "end": 316169, "text": "Velad pues, porque no sabéis a qué hora ha de venir vuestro Señor.", "words": [[0, 311883], [6, 312271], [12, 312663], [19, 313056], [22, 313196], [29, 313756], [31, 313996], [35, 314136], [40, 314436], [43, 314696], [46, 314856], [52, 315116], [60, 315516]]}, {"verse": 43, "start": 316519, "end": 325302, "text": "Pero sabed esto, que si el padre de la familia supiese a qué hora vendría el ladrón, velaría, y no dejaría entrar a robar en su casa.", "words": [[0, 316519], [5, 316803], [11, 317123], [17, 317363], [21, 317543], [24, 317723], [27, 317883], [33, 318203], [36, 318403], [39, 318523], [47, 318903], [55, 319463], [57, 319623], [61, 319783], [66, 320003], [74, 320523], [77, 320783], [85, 321803], [94, 322303], [96, 322598], [99, 322738], [107, 323218], [114, 323658], [116, 323938], [122, 324378], [125, 324498], [128, 324678]]}, {"verse": 44, "start": 325652, "end": 332924, "text": "Por tanto, también vosotros estad preparados; porque el Hijo del hombre ha de venir a la hora que no pensáis.", "words": [[0, 325652], [4, 325776], [11, 326236], [19, 326516], [28, 326946], [34, 327376], [46, 328899], [53, 329161], [56, 329481], [61, 329741], [65, 329921], [72, 330241], [75, 330541], [78, 330681], [84, 331001], [86, 331261], [89, 331401], [94, 331621], [98, 331801], [101, 331941]]}, {"verse": 45, "start": 333274, "end": 341640, "text": "¿Quién pues es el siervo fiel y prudente, al cual puso su señor sobre su familia para que les dé alimento a tiempo?", "words": [[0, 333274], [7, 333632], [12, 334022], [15, 334222], [18, 334342], [25, 334822], [30, 335142], [32, 335502], [42, 335862], [45, 336342], [50, 336502], [55, 337082], [58, 337262], [64, 337662], [70, 338042], [73, 338282], [81, 338882], [86, 339422], [90, 339602], [94, 339742], [97, 340022], [106, 340682], [108, 340842]]}, {"verse": 46, "start": 341990, "end": 348232, "text": "Bienaventurado aquel siervo, al cual, cuando su señor venga, le halle haciendo así.", "words": [[0, 341990], [15, 343077], [21, 343477], [29, 344037], [32, 344237], [38, 344957], [45, 345297], [48, 345497], [54, 345797], [61, 346697], [64, 346857], [70, 347177], [79, 347517]]}, {"verse": 47, "start": 348582, "end": 352216, "text": "De cierto os digo, que sobre todos sus bienes le pondrá.", "words": [[0, 348582], [3, 348727], [10, 349007], [13, 349427], [19, 349727], [23, 349927], [29, 350257], [35, 350587], [39, 350887], [46, 351407], [49, 351507]]}, {"verse": 48, "start": 352566, "end": 358085, "text": "Y si aquel siervo malo dice en su corazón: Mi señor se tarda en venir:", "words": [[0, 352566], [2, 352692], [5, 352812], [11, 353152], [18, 353612], [23, 354172], [28, 354607], [31, 354987], [34, 355147], [43, 356118], [46, 356243], [52, 356783], [55, 356803], [61, 357263], [64, 357443]]}, {"verse": 49, "start": 358435, "end": 365546, "text": "Y comienza a herir a sus compañeros de servicio, y aun a comer y a beber con los borrachos;", "words": [[0, 358435], [2, 358543], [11, 359183], [13, 359503], [19, 359923], [21, 360023], [25, 360203], [36, 361063], [39, 361183], [49, 361843], [51, 362543], [55, 362783], [57, 363103], [63, 363423], [65, 363823], [67, 363943], [73, 364143], [77, 364523], [81, 364683]]}, {"verse": 50, "start": 365896, "end": 371030, "text": "Vendrá el señor de aquel siervo en el día que no espera, y a la hora que no sabe,", "words": [[0, 365896], [7, 366353], [10, 366493], [16, 366793], [19, 367053], [25, 367353], [32, 367873], [35, 367993], [38, 368133], [42, 368373], [46, 368553], [49, 368713], [57, 369393], [59, 369753], [61, 369873], [64, 369953], [69, 370213], [73, 370393], [76, 370533]]}, {"verse": 51, "start": 371380, "end": 379762, "text": "Y le cortará por medio, y pondrá su parte con los hipócritas: allí será el llanto y el crujir de dientes.", "words": [[0, 371380], [2, 371505], [5, 371625], [13, 372225], [17, 372485], [24, 373045], [26, 373565], [33, 373985], [36, 374165], [42, 374665], [46, 374985], [50, 375125], [62, 376447], [67, 376850], [72, 377110], [75, 377310], [82, 377950], [84, 378095], [87, 378455], [94, 378815], [97, 378975]]}]}