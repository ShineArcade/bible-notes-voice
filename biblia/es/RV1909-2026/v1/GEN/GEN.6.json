16], [173, 69756], [176, 69916], [185, 70256]]}, {"verse": 8, "start": 71376, "end": 74205, "text": "Pero Noé halló gracia en los ojos de Jehová.", "words": [[0, 71376], [5, 71700], [9, 72060], [15, 72420], [22, 72780], [25, 72940], [29, 73080], [34, 73400], [37, 73620]]}, {"verse": 9, "start": 74655, "end": 83765, "text": "Estas son las generaciones de Noé: Noé, varón justo, perfecto fue en sus generaciones; con Dios caminó Noé.", "words": [[0, 74655], [6, 75197], [10, 75397], [14, 75617], [27, 76417], [30, 76577], [35, 78293], [40, 78419], [46, 78546], [53, 79026], [62, 79846], [66, 80286], [69, 80546], [73, 80766], [87, 82209], [91, 82554], [96, 82734], [103, 83264]]}, {"verse": 10, "start": 84215, "end": 88954, "text": "Y engendró Noé tres hijos: a Sem, a Cam, y a Jafet.", "words": [[0, 84215], [2, 84544], [11, 84904], [15, 85264], [20, 85504], [27, 86728], [29, 86908], [34, 87088], [36, 87268], [41, 87968], [43, 88268], [45, 88348]]}, {"verse": 11, "start": 89404, "end": 94595, "text": "Y se corrompió la tierra delante de Dios, y estaba la tierra llena de violencia.", "words": [[0, 89404], [2, 89510], [5, 89630], [15, 90310], [18, 90470], [25, 90810], [33, 91330], [36, 91510], [42, 91790], [44, 92290], [51, 92570], [54, 92750], [61, 93030], [67, 93550], [70, 93670]]}, {"verse": 12, "start": 95045, "end": 104547, "text": "Y miró Dios la tierra, y he aquí que estaba corrompida; porque toda carne había corrompido su camino sobre la tierra.", "words": [[0, 95045], [2, 95190], [7, 95550], [12, 95870], [15, 96470], [23, 97790], [25, 97890], [28, 98030], [33, 98430], [37, 98710], [44, 99050], [56, 100436], [63, 100640], [68, 100940], [74, 101460], [80, 101840], [91, 102680], [94, 102860], [101, 103240], [107, 103600], [110, 103820]]}, {"verse": 13, "start": 104997, "end": 116995, "text": "Y dijo Dios a Noé: El fin de toda carne ha venido delante de mí; porque la tierra está llena de violencia a causa de ellos; y he aquí que yo los destruiré con la tierra.", "words": [[0, 104997], [2, 105286], [7, 105566], [12, 105846], [14, 106246], [19, 106909], [22, 107057], [26, 107317], [29, 107497], [34, 107677], [40, 108137], [43, 108437], [50, 108857], [58, 109277], [61, 109417], [65, 110269], [72, 110433], [75, 110613], [82, 110953], [87, 111393], [93, 111813], [96, 111913], [106, 112513], [108, 112733], [114, 113013], [117, 113273], [124, 114305], [126, 114443], [129, 114623], [134, 114883], [138, 115063], [141, 115223], [145, 115363], [155, 115983], [159, 116103], [162, 116223]]}, {"verse": 14, "start": 117445, "end": 125254, "text": "Hazte un arca de madera de Gopher: harás compartimentos en el arca, y la cubrirás con brea por dentro y por fuera.", "words": [[0, 117580], [6, 117750], [9, 117950], [14, 118270], [17, 118390], [24, 118770], [27, 119080], [35, 119938], [41, 120276], [56, 121136], [59, 121336], [62, 121456], [68, 121816], [70, 122196], [73, 122316], [82, 122856], [86, 123076], [91, 123436], [95, 123636], [102, 124016], [104, 124316], [108, 124476]]}, {"verse": 15, "start": 125704, "end": 135700, "text": "Y de esta manera la harás: de trescientos codos la longitud del arca, de cincuenta codos su anchura, y de treinta codos su altura.", "words": [[0, 125704], [2, 126006], [5, 126106], [10, 126326], [17, 126726], [20, 127146], [27, 128919], [30, 129186], [42, 129496], [48, 130096], [51, 130216], [60, 130516], [64, 130876], [70, 131696], [73, 131896], [83, 132096], [89, 132736], [92, 132856], [101, 133356], [103, 133776], [106, 133996], [114, 134216], [120, 134716], [123, 134856]]}, {"verse": 16, "start": 136150, "end": 149546, "text": "Una ventana harás al arca, y la acabarás a un codo de elevación por la parte de arriba: y pondrás la puerta del arca a su lado; y le harás piso bajo, segundo y tercero.", "words": [[0, 136150], [4, 136335], [12, 136915], [18, 137335], [21, 137515], [27, 137875], [29, 138395], [32, 138535], [41, 139115], [43, 139295], [46, 139395], [51, 139735], [54, 139875], [64, 140415], [68, 140675], [71, 140