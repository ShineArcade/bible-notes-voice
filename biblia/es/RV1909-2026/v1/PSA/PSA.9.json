{"book": "PSA", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 136840, "verses": [{"verse": 1, "start": 300, "end": 10332, "text": "Al Músico principal: sobre Mut-laben: Salmo de David. TE alabaré, oh Jehová, con todo mi corazón; contaré todas tus maravillas.", "words": [[0, 300], [3, 484], [10, 984], [21, 2065], [27, 2788], [38, 3704], [44, 4250], [47, 4390], [54, 5236], [57, 5342], [66, 5732], [69, 6122], [77, 6582], [81, 6882], [86, 7202], [89, 7462], [98, 8426], [106, 8830], [112, 9130], [116, 9450]]}, {"verse": 2, "start": 10682, "end": 16218, "text": "Me alegraré y me regocijaré en ti: cantaré a tu nombre, oh Altísimo;", "words": [[0, 10682], [3, 11001], [12, 11621], [14, 11881], [17, 12041], [28, 12981], [31, 13201], [35, 13962], [43, 14168], [45, 14375], [48, 14575], [56, 14935], [59, 15295]]}, {"verse": 3, "start": 16568, "end": 21644, "text": "Por haber sido mis enemigos vueltos atrás: caerán y perecerán delante de ti.", "words": [[0, 16568], [4, 16713], [10, 16893], [15, 17233], [19, 17413], [28, 17913], [36, 18393], [43, 19251], [50, 19855], [52, 20035], [62, 20655], [70, 21115], [73, 21295]]}, {"verse": 4, "start": 21994, "end": 27641, "text": "Porque has hecho mi juicio y mi causa: te sentaste en silla juzgando justicia.", "words": [[0, 21994], [7, 22156], [11, 22396], [17, 22616], [20, 22816], [27, 23356], [29, 23656], [32, 23776], [39, 24660], [42, 24765], [51, 25365], [54, 25645], [60, 26045], [69, 26725]]}, {"verse": 5, "start": 27991, "end": 34664, "text": "Reprendiste a las naciones, destruiste al malo, borraste el nombre de ellos para siempre.", "words": [[0, 28367], [12, 28777], [14, 28917], [18, 29037], [28, 30317], [39, 30917], [42, 31097], [48, 31827], [57, 32557], [60, 32657], [67, 33037], [70, 33317], [76, 33577], [81, 33877]]}, {"verse": 6, "start": 35014, "end": 42932, "text": "Oh enemigo, acabados son para siempre los asolamientos; y las ciudades que derribaste, su memoria pereció con ellas.", "words": [[0, 35254], [3, 35528], [12, 35801], [21, 36421], [25, 36721], [30, 37001], [38, 37541], [42, 38041], [56, 39351], [58, 39460], [62, 39600], [71, 40280], [75, 40420], [87, 41100], [90, 41320], [98, 41760], [106, 42200], [110, 42400]]}, {"verse": 7, "start": 43282, "end": 48427, "text": "Pero Jehová permanecerá para siempre: dispuesto ha su trono para juicio.", "words": [[0, 43282], [5, 43567], [12, 43887], [24, 44687], [29, 44867], [38, 46155], [48, 46429], [51, 46702], [54, 46942], [60, 47502], [65, 47722]]}, {"verse": 8, "start": 48777, "end": 54181, "text": "Y él juzgará el mundo con justicia; y juzgará los pueblos con rectitud.", "words": [[0, 48777], [2, 48946], [5, 49146], [13, 49986], [16, 50066], [22, 50406], [26, 50686], [36, 51756], [38, 51898], [46, 52498], [50, 52618], [58, 53138], [62, 53318]]}, {"verse": 9, "start": 54531, "end": 60176, "text": "Y será Jehová refugio al pobre, refugio para el tiempo de angustia.", "words": [[0, 54531], [2, 54676], [7, 55106], [14, 55536], [22, 56256], [25, 56396], [32, 57316], [40, 58176], [45, 58436], [48, 58616], [55, 59036], [58, 59296]]}, {"verse": 10, "start": 60526, "end": 68117, "text": "Y en ti confiarán los que conocen tu nombre; por cuanto tú, oh Jehová, no desamparaste a los que te buscaron.", "words": [[0, 60526], [2, 60656], [5, 60816], [8, 60976], [18, 61696], [22, 61836], [26, 61996], [34, 62616], [37, 62796], [45, 63752], [49, 63876], [56, 64196], [60, 64649], [63, 65103], [71, 65556], [74, 65676], [87, 66636], [89, 66816], [93, 66936], [97, 67076], [100, 67236]]}, {"verse": 11, "start": 68467, "end": 73076, "text": "Cantad a Jehová, que habita en Sion: anunciad en los pueblos sus obras.", "words": [[0, 68701], [7, 68971], [9, 69241], [17, 69511], [21, 69795], [28, 70080], [31, 70364], [37, 71213], [46, 71593], [49, 71713], [53, 71833], [61, 72313], [65, 72413]]}, {"verse": 12, "start": 73076, "end": 79062, "text": "Porque reclamando la sangre se acordó de ellos: no se olvidó del clamor de los pobres.", "words": [[0, 73076], [7, 73786], [18, 74496], [21, 74636], [28, 75136], [31, 75256], [38, 75756], [41, 75896], [48, 76680], [51, 76809], [54, 76969], [61, 77469], [65, 77609], [72, 78129], [75, 78249], [79, 78369]]}, {"verse": 13, "start": 79062, "end": 87792, "text": "Ten misericordia de mí, Jehová: mira mi aflicción que padezco de los que me aborrecen, tú que me levantas de las puertas de la muerte;", "words": [[0, 79062], [4, 79322], [17, 80142], [20, 80459], [24, 80775], [32, 81285], [37, 81593], [40, 81833], [50, 82553], [54, 82753], [62, 83433], [65, 83573], [69, 83693], [73, 83853], [76, 84493], [87, 85133], [90, 85533], [94, 85733], [97, 85853], [106, 86333], [109, 86413], [113, 86533], [121, 86933], [124, 87073], [127, 87173]]}, {"verse": 14, "start": 88142, "end": 94395, "text": "Porque cuente yo todas tus alabanzas en las puertas de la hija de Sion, y me goce en tu salvación.", "words": [[0, 88142], [7, 88484], [14, 88864], [17, 89104], [23, 89484], [27, 89724], [37, 90484], [40, 90624], [44, 90764], [52, 91184], [55, 91344], [58, 91444], [63, 91744], [66, 91844], [72, 92244], [74, 92724], [77, 92864], [82, 93244], [85, 93364], [88, 93504]]}, {"verse": 15, "start": 94745, "end": 100647, "text": "Se hundieron las naciones en la fosa que hicieron; en la red que escondieron fue tomado su pie.", "words": [[0, 94745], [3, 94980], [13, 95420], [17, 95620], [26, 96080], [29, 96320], [32, 96460], [37, 96780], [41, 96960], [51, 98018], [54, 98196], [57, 98396], [61, 98696], [65, 98936], [77, 99496], [81, 99716], [88, 100096], [91, 100236]]}, {"verse": 16, "start": 100997, "end": 109648, "text": "Jehová fue conocido en el juicio que hizo; en la obra de sus manos fue enlazado el malo. (Higaion. Selah.)", "words": [[0, 100997], [7, 101696], [11, 101816], [20, 102496], [23, 102616], [26, 102756], [33, 103176], [37, 103416], [43, 104204], [46, 104352], [49, 104512], [54, 104792], [57, 104972], [61, 105132], [67, 105572], [71, 106152], [80, 106792], [83, 106912], [89, 108206], [99, 109329]]}, {"verse": 17, "start": 109998, "end": 115508, "text": "Los malos serán trasladados al infierno, todas las gentes que se olvidan de Dios.", "words": [[0, 109998], [4, 110117], [10, 110597], [16, 110957], [28, 111737], [31, 111917], [41, 112917], [47, 113317], [51, 113717], [58, 114117], [62, 114197], [65, 114337], [73, 114797], [76, 114937]]}, {"verse": 18, "start": 115858, "end": 122241, "text": "Porque no para siempre será olvidado el pobre; ni la esperanza de los pobres perecerá perpetuamente.", "words": [[0, 115858], [7, 116063], [10, 116283], [15, 116523], [23, 116823], [28, 117303], [37, 117983], [40, 118123], [47, 119035], [50, 119173], [53, 119333], [63, 119853], [66, 119993], [70, 120133], [77, 120493], [86, 121073]]}, {"verse": 19, "start": 122241, "end": 129031, "text": "Levántate, oh Jehová; no se fortalezca el hombre; sean juzgadas las naciones delante de ti.", "words": [[0, 122241], [11, 122920], [14, 123598], [22, 124440], [25, 124567], [28, 124727], [39, 125347], [42, 125467], [50, 126165], [55, 126426], [64, 127125], [68, 127545], [77, 128086], [85, 128505], [88, 128646]]}, {"verse": 20, "start": 129381, "end": 136440, "text": "Pon, oh Jehová, temor en ellos: conozcan las naciones que son no más que hombres. (Selah.)", "words": [[0, 129381], [5, 129683], [8, 130023], [16, 130363], [22, 130823], [25, 130983], [32, 132135], [41, 132679], [45, 132879], [54, 133379], [58, 133599], [62, 134299], [65, 134439], [69, 134619], [73, 134779], [82, 136092]]}]}