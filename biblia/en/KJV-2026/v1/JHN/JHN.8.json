{"book": "JHN", "chapter": 8, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 418718, "verses": [{"verse": 1, "start": 300, "end": 2305, "text": "Jesus went to the mount of Olives.", "words": [[0, 300], [6, 579], [11, 959], [14, 1159], [18, 1259], [24, 1479], [27, 1699]]}, {"verse": 2, "start": 2755, "end": 9100, "text": "And early in the morning he came again into the temple, and all the people came to him; and he sat down, and taught them.", "words": [[0, 2755], [4, 2876], [10, 3156], [13, 3336], [17, 3416], [25, 3676], [28, 3916], [33, 4116], [39, 4436], [44, 4676], [48, 4856], [56, 5496], [60, 5716], [64, 5916], [68, 6036], [75, 6256], [80, 6556], [83, 6756], [88, 7389], [92, 7512], [95, 7592], [99, 7852], [105, 8212], [109, 8452], [116, 8692]]}, {"verse": 3, "start": 9550, "end": 16496, "text": "And the scribes and Pharisees brought to him a woman taken in adultery; and when they had set her in the midst,", "words": [[0, 9550], [4, 9677], [8, 9817], [16, 10457], [20, 10557], [30, 11357], [38, 11557], [41, 11817], [45, 11997], [47, 12177], [53, 12457], [59, 12857], [62, 13097], [72, 14200], [76, 14335], [81, 14495], [86, 14675], [90, 14835], [94, 15095], [98, 15275], [101, 15455], [105, 15555]]}, {"verse": 4, "start": 16946, "end": 21585, "text": "They say to him, Master, this woman was taken in adultery, in the very act.", "words": [[0, 16946], [5, 17067], [9, 17307], [12, 17487], [17, 18159], [25, 18682], [30, 18822], [36, 19102], [40, 19382], [46, 19702], [49, 19942], [59, 20462], [62, 20722], [66, 20862], [71, 21102]]}, {"verse": 5, "start": 22035, "end": 26949, "text": "Now Moses in the law commanded us, that such should be stoned: but what do you say?", "words": [[0, 22035], [4, 22214], [10, 22594], [13, 22854], [17, 22954], [21, 23134], [31, 23534], [35, 23874], [40, 24314], [45, 24614], [52, 24954], [55, 25094], [63, 25938], [67, 26078], [72, 26298], [75, 26478], [79, 26578]]}, {"verse": 6, "start": 27299, "end": 35739, "text": "This they said, tempting him, that they might have to accuse him. But Jesus stooped down, and with his finger wrote on the ground, as though he heard them not.", "words": [[0, 27299], [5, 27756], [10, 27856], [16, 28056], [25, 28436], [30, 28756], [35, 28996], [40, 29156], [46, 29336], [51, 29556], [54, 29696], [61, 29996], [66, 30739], [70, 30847], [76, 31147], [84, 31647], [90, 32007], [94, 32347], [99, 32527], [103, 32687], [110, 33107], [116, 33387], [119, 33547], [123, 33647], [131, 34027], [134, 34367], [141, 34607], [144, 34787], [150, 35007], [155, 35167]]}, {"verse": 7, "start": 36189, "end": 44750, "text": "So when they continued asking him, he lifted up himself, and said to them, He that is without sin among you, let him first cast a stone at her.", "words": [[0, 36189], [3, 36342], [8, 36522], [13, 36642], [23, 37042], [30, 37442], [35, 37922], [38, 38022], [45, 38322], [48, 38522], [57, 38962], [61, 39382], [66, 39602], [69, 39762], [75, 40379], [78, 40547], [83, 40807], [86, 40947], [94, 41227], [98, 41587], [104, 41867], [109, 42667], [113, 42807], [117, 42967], [123, 43327], [128, 43727], [130, 43947], [136, 44227], [139, 44447]]}, {"verse": 8, "start": 45100, "end": 47915, "text": "And again he stooped down, and wrote on the ground.", "words": [[0, 45100], [4, 45228], [10, 45488], [13, 45728], [21, 46228], [27, 46568], [31, 46808], [37, 47048], [40, 47228], [44, 47328]]}, {"verse": 9, "start": 48365, "end": 60045, "text": "And they which heard it, being convicted by their own conscience, went out one by one, beginning at the eldest, even to the last: and Jesus was left alone, and the woman standing in the midst.", "words": [[0, 48365], [4, 48512], [9, 48732], [15, 48972], [21, 49272], [25, 49692], [31, 49892], [41, 50412], [44, 50692], [50, 50912], [54, 51052], [66, 51892], [71, 52132], [75, 52392], [79, 52672], [82, 52892], [87, 53272], [97, 53752], [100, 54032], [104, 54172], [112, 54392], [117, 54912], [120, 55132], [124, 55252], [130, 56125], [134, 56279], [140, 56579], [144, 56919], [149, 57219], [156, 57779], [160, 58259], [164, 58379], [170, 58639], [179, 59179], [182, 59439], [186, 59519]]}, {"verse": 10, "start": 60495, "end": 69007, "text": "When Jesus had lifted up himself, and saw none but the woman, he said to her, Woman, where are those your accusers? has no man condemned you?", "words": [[0, 60495], [5, 60624], [11, 60944], [15, 61224], [22, 61524], [25, 61744], [34, 62184], [38, 62504], [42, 62764], [47, 62984], [51, 63204], [55, 63384], [62, 64124], [65, 64204], [70, 64424], [73, 64644], [78, 65381], [85, 65611], [91, 65731], [95, 65911], [101, 66161], [106, 66411], [116, 67461], [120, 67644], [123, 67884], [127, 68184], [137, 68524]]}, {"verse": 11, "start": 69357, "end": 77076, "text": "She said, No man, Lord. And Jesus said to her, Neither do I condemn you: go, and sin no more.", "words": [[0, 69357], [4, 69477], [10, 70198], [13, 70504], [18, 71104], [24, 72009], [28, 72150], [34, 72410], [39, 72810], [42, 72990], [47, 73573], [55, 73920], [58, 74220], [60, 74360], [68, 74720], [73, 75408], [77, 75753], [81, 76193], [85, 76433], [88, 76653]]}, {"verse": 12, "start": 77426, "end": 87029, "text": "¶ Then spoke Jesus again to them, saying, I am the light of the world: he that follows me shall not walk in darkness, but shall have the light of life.", "words": [[2, 77426], [7, 77673], [13, 78013], [19, 78413], [25, 78773], [28, 79033], [34, 79613], [42, 80558], [44, 80836], [47, 81036], [51, 81176], [57, 81416], [60, 81556], [64, 81676], [71, 82530], [74, 82712], [79, 82972], [87, 83292], [90, 83572], [96, 83792], [100, 84072], [105, 84392], [108, 84552], [118, 85252], [122, 85532], [128, 85712], [133, 85952], [137, 86112], [143, 86332], [146, 86472]]}, {"verse": 13, "start": 87379, "end": 92193, "text": "The Pharisees therefore said to him, You bear record of yourself; your record is not true.", "words": [[0, 87379], [4, 87482], [14, 88062], [24, 88362], [29, 88682], [32, 88882], [37, 89411], [41, 89491], [46, 89651], [53, 90011], [56, 90171], [66, 91031], [71, 91134], [78, 91334], [81, 91514], [85, 91694]]}, {"verse": 14, "start": 92543, "end": 104162, "text": "Jesus answered and said to them, Though I bear record of myself, yet my record is true: for I know from where I came, and where I go; but you cannot tell from where I come, and where I go.", "words": [[0, 92543], [6, 92808], [15, 93328], [19, 93548], [24, 93748], [27, 93928], [33, 94647], [40, 94826], [42, 94986], [47, 95226], [54, 95526], [57, 95706], [65, 96606], [69, 96786], [72, 96986], [79, 97326], [82, 97506], [88, 98366], [92, 98470], [94, 98610], [99, 98830], [104, 99050], [110, 99230], [112, 99390], [118, 99750], [122, 100050], [128, 100230], [130, 100390], [134, 101157], [138, 101417], [142, 101537], [149, 101797], [154, 102157], [159, 102377], [165, 102537], [167, 102697], [173, 103017], [177, 103337], [183, 103537], [185, 103717]]}, {"verse": 15, "start": 104612, "end": 107811, "text": "You judge after the flesh; I judge no man.", "words": [[0, 104612], [4, 104753], [10, 105033], [16, 105413], [20, 105593], [27, 106492], [29, 106678], [35, 106938], [38, 107278]]}, {"verse": 16, "start": 108261, "end": 114269, "text": "And yet if I judge, my judgment is true: for I am not alone, but I and the Father that sent me.", "words": [[0, 108261], [4, 108384], [8, 108564], [11, 108824], [13, 108984], [20, 109524], [23, 109664], [32, 110044], [35, 110364], [41, 111150], [45, 111253], [47, 111453], [50, 111553], [54, 111773], [61, 112433], [65, 112573], [67, 112853], [71, 113013], [75, 113113], [82, 113413], [87, 113673], [92, 113893]]}, {"verse": 17, "start": 114719, "end": 118491, "text": "It is also written in your law, that the testimony of two men is true.", "words": [[0, 114719], [3, 114804], [6, 114924], [11, 115204], [19, 115484], [22, 115664], [27, 115784], [32, 116064], [37, 116564], [41, 116664], [51, 117064], [54, 117364], [58, 117564], [62, 117804], [65, 118004]]}, {"verse": 18, "start": 118941, "end": 123436, "text": "I am one that bear witness of myself, and the Father that sent me bears witness of me.", "words": [[0, 118941], [2, 119145], [5, 119285], [9, 119425], [14, 119605], [19, 119805], [27, 120065], [30, 120305], [38, 121105], [42, 121345], [46, 121445], [53, 121725], [58, 121945], [63, 122145], [66, 122305], [72, 122565], [80, 122885], [83, 123145]]}, {"verse": 19, "start": 123786, "end": 134106, "text": "Then said they to him, Where is your Father? Jesus answered, You neither know me, nor my Father: if you had known me, you should have known my Father also.", "words": [[0, 123786], [5, 124027], [10, 124347], [15, 124567], [18, 124767], [23, 125367], [29, 125547], [32, 125727], [37, 125847], [45, 126726], [51, 127004], [61, 128025], [65, 128207], [73, 128487], [78, 128767], [82, 129107], [86, 129527], [89, 129767], [97, 130676], [100, 130818], [104, 130978], [108, 131158], [114, 131398], [118, 132058], [122, 132258], [129, 132458], [134, 132638], [140, 132858], [143, 133078], [150, 133398]]}, {"verse": 20, "start": 134456, "end": 142770, "text": "These words spoke Jesus in the treasury, as he taught in the temple: and no man laid hands on him; for his hour was not yet come.", "words": [[0, 134456], [6, 134634], [12, 134974], [18, 135394], [24, 135774], [27, 136054], [31, 136154], [41, 136614], [44, 137254], [47, 137394], [54, 137654], [57, 137814], [61, 137914], [69, 138752], [73, 138879], [76, 139059], [80, 139319], [85, 139579], [91, 139879], [94, 140139], [99, 140772], [103, 140877], [107, 141037], [112, 141357], [116, 141617], [120, 141837], [124, 142037]]}, {"verse": 21, "start": 143220, "end": 151505, "text": "Then said Jesus again to them, I go my way, and you shall seek me, and shall die in your sins: where I go, you cannot come.", "words": [[0, 143220], [5, 143364], [10, 143584], [16, 143924], [22, 144344], [25, 144564], [31, 145334], [33, 145519], [36, 145699], [39, 145919], [44, 146639], [48, 146719], [52, 146899], [58, 147119], [63, 147379], [67, 147899], [71, 147979], [77, 148179], [81, 148499], [84, 148699], [89, 148819], [95, 149702], [101, 149869], [103, 150049], [107, 150569], [111, 150649], [118, 150909]]}, {"verse": 22, "start": 151855, "end": 156803, "text": "Then said the Jews, Will he kill himself? because he says, Where I go, you cannot come.", "words": [[0, 151855], [5, 152065], [10, 152305], [14, 152465], [20, 153235], [25, 153396], [28, 153596], [33, 153856], [42, 154732], [50, 154896], [53, 155096], [59, 155396], [65, 155496], [67, 155616], [71, 155916], [75, 155976], [82, 156276]]}, {"verse": 23, "start": 157153, "end": 165006, "text": "And he said to them, You are from beneath; I am from above: you are of this world; I am not of this world.", "words": [[0, 157153], [4, 157284], [7, 157404], [12, 157644], [15, 157844], [21, 158439], [25, 158665], [29, 158985], [34, 159245], [43, 160075], [45, 160334], [48, 160554], [53, 160754], [60, 161660], [64, 161822], [68, 161982], [71, 162162], [76, 162462], [83, 163382], [85, 163602], [88, 163722], [92, 163962], [95, 164222], [100, 164462]]}, {"verse": 24, "start": 165456, "end": 173648, "text": "I said therefore to you, that you shall die in your sins: for if you believe not that I am he, you shall die in your sins.", "words": [[0, 165456], [2, 165676], [7, 165916], [17, 166376], [20, 166676], [25, 166936], [30, 167336], [34, 167516], [40, 167716], [44, 168076], [47, 168336], [52, 168456], [58, 169426], [62, 169588], [65, 169768], [69, 169908], [77, 170248], [81, 170528], [86, 170788], [88, 170988], [91, 171128], [95, 171988], [99, 172088], [105, 172288], [109, 172648], [112, 172888], [117, 173008]]}, {"verse": 25, "start": 173998, "end": 181063, "text": "Then said they to him, Who are you? And Jesus says to them, Even the same that I said to you from the beginning.", "words": [[0, 173998], [5, 174238], [10, 174558], [15, 174778], [18, 174978], [23, 175578], [27, 175735], [31, 175955], [36, 176742], [40, 176881], [46, 177201], [51, 177541], [54, 177761], [60, 178438], [65, 178700], [69, 178920], [74, 179200], [79, 179420], [81, 179540], [86, 179800], [89, 180020], [93, 180160], [98, 180360], [102, 180480]]}, {"verse": 26, "start": 181513, "end": 189494, "text": "I have many things to say and to judge of you: but he that sent me is true; and I speak to the world those things which I have heard of him.", "words": [[0, 181513], [2, 181657], [7, 181877], [12, 182157], [19, 182477], [22, 182717], [26, 182997], [30, 183257], [33, 183377], [39, 183637], [42, 183817], [47, 184343], [51, 184592], [54, 184792], [59, 184992], [64, 185252], [67, 185492], [70, 185652], [76, 186459], [80, 186581], [82, 186681], [88, 186941], [91, 187181], [95, 187301], [101, 187561], [107, 187821], [114, 188201], [120, 188481], [122, 188661], [127, 188801], [133, 189001], [136, 189161]]}, {"verse": 27, "start": 189844, "end": 193062, "text": "They understood not that he spoke to them of the Father.", "words": [[0, 189844], [5, 190003], [16, 190423], [20, 190883], [25, 191163], [28, 191303], [34, 191623], [37, 191903], [42, 192103], [45, 192323], [49, 192463]]}, {"verse": 28, "start": 193512, "end": 205348, "text": "Then said Jesus to them, When you have lifted up the Son of man, then shall you know that I am he, and that I do nothing of myself; but as my Father has taught me, I speak these things.", "words": [[0, 193512], [5, 193699], [10, 193979], [16, 194379], [19, 194739], [25, 195376], [30, 195514], [34, 195674], [39, 195854], [46, 196174], [49, 196394], [53, 196574], [57, 196794], [60, 196934], [65, 197654], [70, 197934], [76, 198174], [80, 198414], [85, 198694], [90, 198974], [92, 199294], [95, 199514], [99, 199814], [103, 200294], [108, 200454], [110, 200574], [113, 200714], [121, 201054], [124, 201314], [132, 202234], [136, 202355], [139, 202535], [142, 202715], [149, 203055], [153, 203335], [160, 203575], [164, 204095], [166, 204235], [172, 204495], [178, 204735]]}, {"verse": 29, "start": 205798, "end": 212419, "text": "And he that sent me is with me: the Father has not left me alone; for I do always those things that please him.", "words": [[0, 205798], [4, 205914], [7, 206094], [12, 206274], [17, 206574], [20, 206794], [23, 206954], [28, 207134], [32, 207766], [36, 207850], [43, 208130], [47, 208410], [51, 208590], [56, 208810], [59, 209010], [66, 209829], [70, 209969], [72, 210169], [75, 210329], [82, 210769], [88, 211089], [95, 211449], [100, 211689], [107, 211969]]}, {"verse": 30, "start": 212769, "end": 215638, "text": "As he spoke these words, many believed on him.", "words": [[0, 212769], [3, 212933], [6, 213053], [12, 213333], [18, 213613], [25, 214333], [30, 214613], [39, 215013], [42, 215333]]}, {"verse": 31, "start": 216088, "end": 223394, "text": "Then said Jesus to those Jews which believed on him, If you continue in my word, then are you my disciples indeed;", "words": [[0, 216088], [5, 216272], [10, 216552], [16, 216972], [19, 217272], [25, 217472], [30, 217832], [36, 218132], [45, 218512], [48, 218832], [53, 219443], [56, 219582], [60, 219682], [69, 220082], [72, 220302], [75, 220462], [81, 221282], [86, 221542], [90, 221842], [94, 222042], [97, 222222], [107, 222682]]}, {"verse": 32, "start": 223844, "end": 227092, "text": "And you shall know the truth, and the truth shall make you free.", "words": [[0, 223844], [4, 223984], [8, 224144], [14, 224364], [19, 224604], [23, 224764], [30, 225284], [34, 225604], [38, 225704], [44, 225984], [50, 226264], [55, 226484], [59, 226644]]}, {"verse": 33, "start": 227442, "end": 235281, "text": "¶ They answered him, We are Abraham’s seed, and were never in bondage to any man: how do you say, You shall be made free?", "words": [[2, 227442], [7, 227607], [16, 227967], [21, 229130], [24, 229277], [28, 229457], [38, 230197], [44, 230397], [48, 230877], [53, 231097], [59, 231357], [62, 231577], [70, 232037], [73, 232197], [77, 232357], [82, 233118], [86, 233280], [89, 233400], [93, 233500], [98, 234040], [102, 234260], [108, 234480], [111, 234660], [116, 234860]]}, {"verse": 34, "start": 235631, "end": 241589, "text": "Jesus answered them, Most assuredly, I say to you, Whoever commits sin is the servant of sin.", "words": [[0, 235631], [6, 235907], [15, 236347], [21, 237007], [26, 237191], [37, 237911], [39, 238051], [43, 238311], [46, 238511], [51, 239111], [59, 239291], [67, 239771], [71, 240111], [74, 240471], [78, 240631], [86, 240931], [89, 241171]]}, {"verse": 35, "start": 242039, "end": 246120, "text": "And the servant abides not in the house for ever: but the Son abides ever.", "words": [[0, 242039], [4, 242160], [8, 242280], [16, 242520], [23, 243060], [27, 243260], [30, 243420], [34, 243520], [40, 243803], [44, 244087], [50, 244670], [54, 244770], [58, 244940], [62, 245110], [69, 245650]]}, {"verse": 36, "start": 246570, "end": 250347, "text": "If the Son therefore shall make you free, you shall be free indeed.", "words": [[0, 246570], [3, 246686], [7, 246826], [11, 247086], [21, 247386], [27, 247706], [32, 247966], [36, 248106], [42, 248906], [46, 249006], [52, 249206], [55, 249366], [60, 249666]]}, {"verse": 37, "start": 250797, "end": 255985, "text": "I know that you are Abraham’s seed; but you seek to kill me, because my word has no place in you.", "words": [[0, 250797], [2, 250966], [7, 251166], [12, 251326], [16, 251466], [20, 251566], [30, 252286], [36, 252931], [40, 253089], [44, 253229], [49, 253429], [52, 253609], [57, 253829], [61, 254069], [69, 254469], [72, 254689], [77, 254929], [81, 255109], [84, 255269], [90, 255529], [93, 255749]]}, {"verse": 38, "start": 256435, "end": 261658, "text": "I speak that which I have seen with my Father: and you do that which you have seen with your father.", "words": [[0, 256435], [2, 256559], [8, 256839], [13, 257139], [19, 257379], [21, 257579], [26, 257739], [31, 258039], [36, 258239], [39, 258439], [47, 259301], [51, 259419], [55, 259559], [58, 259719], [63, 259979], [69, 260199], [73, 260379], [78, 260539], [83, 260799], [88, 260999], [93, 261119]]}, {"verse": 39, "start": 262008, "end": 271661, "text": "They answered and said to him, Abraham is our father. Jesus says to them, If you were Abraham’s children, you would do the works of Abraham.", "words": [[0, 262008], [5, 262117], [14, 262517], [18, 262737], [23, 262937], [26, 263117], [31, 263619], [39, 263979], [42, 264239], [46, 264379], [54, 265175], [60, 265460], [65, 265800], [68, 266040], [74, 268380], [77, 268500], [81, 268680], [86, 268780], [96, 269360], [106, 270000], [110, 270160], [116, 270300], [119, 270400], [123, 270520], [129, 270760], [132, 270960]]}, {"verse": 40, "start": 272111, "end": 278347, "text": "But now you seek to kill me, a man that has told you the truth, which I have heard of God: this did not Abraham.", "words": [[0, 272111], [4, 272195], [8, 272375], [12, 272535], [17, 272755], [20, 272935], [25, 273155], [29, 273555], [31, 273675], [35, 273855], [40, 274055], [44, 274195], [49, 274415], [53, 274575], [57, 274675], [64, 274995], [70, 275315], [72, 275495], [77, 275615], [83, 275795], [86, 275935], [91, 276776], [96, 277041], [100, 277301], [104, 277501]]}, {"verse": 41, "start": 278797, "end": 286148, "text": "You do the deeds of your father. Then said they to him, We are not born of fornication; we have one Father, even God.", "words": [[0, 278797], [4, 278938], [7, 279078], [11, 279218], [17, 279498], [20, 279718], [25, 279838], [33, 280762], [38, 281002], [43, 281322], [48, 281542], [51, 281742], [56, 282342], [59, 282459], [63, 282559], [67, 282759], [72, 283039], [75, 283219], [88, 284345], [91, 284481], [96, 284621], [100, 284841], [108, 285461], [113, 285621]]}, {"verse": 42, "start": 286498, "end": 297676, "text": "Jesus said to them, If God were your Father, you would love me: for I proceeded forth and came from God; neither came I of myself, but he sent me.", "words": [[0, 286498], [6, 286757], [11, 287097], [14, 287277], [20, 289554], [23, 289699], [27, 290039], [32, 290299], [37, 290459], [45, 291379], [49, 291539], [55, 291719], [60, 291919], [64, 292567], [68, 292681], [70, 292801], [80, 293221], [86, 293601], [90, 293841], [95, 294101], [100, 294341], [105, 295181], [113, 295380], [118, 295680], [120, 295920], [123, 296040], [131, 296780], [135, 296980], [138, 297100], [143, 297340]]}, {"verse": 43, "start": 298126, "end": 302791, "text": "Why do you not understand my speech? even because you cannot hear my word.", "words": [[0, 298126], [4, 298426], [7, 298586], [11, 298706], [15, 298826], [26, 299326], [29, 299586], [37, 300482], [42, 300717], [50, 301077], [54, 301357], [61, 301677], [66, 301997], [69, 302217]]}, {"verse": 44, "start": 303241, "end": 318822, "text": "You are of your father the devil, and the lusts of your father you will do. He was a murderer from the beginning, and does not stand in the truth, because there is no truth in him. When he speaks a lie, he speaks of his own: for he is a liar, and the father of it.", "words": [[0, 303241], [4, 303441], [8, 303621], [11, 303841], [16, 304001], [23, 304381], [27, 304641], [34, 305361], [38, 305581], [42, 305721], [48, 306221], [51, 306321], [56, 306461], [63, 306841], [67, 307161], [72, 307321], [76, 308061], [79, 308156], [83, 308316], [85, 308436], [94, 308796], [99, 309116], [103, 309236], [114, 309596], [118, 310136], [123, 310356], [127, 310556], [133, 310916], [136, 311096], [140, 311196], [147, 311516], [155, 312016], [161, 312276], [164, 312416], [167, 312596], [173, 312896], [176, 313096], [181, 313691], [186, 313984], [189, 314104], [196, 314324], [198, 314544], [203, 315084], [206, 315144], [213, 315424], [216, 315584], [220, 315724], [225, 316435], [229, 316583], [232, 316803], [235, 316983], [237, 317103], [243, 317383], [247, 317943], [251, 318083], [258, 318343], [261, 318583]]}, {"verse": 45, "start": 319272, "end": 322076, "text": "And because I tell you the truth, you believe me not.", "words": [[0, 319272], [4, 319398], [12, 319658], [14, 319838], [19, 320038], [23, 320198], [27, 320318], [34, 320998], [38, 321078], [46, 321358], [49, 321598]]}, {"verse": 46, "start": 322526, "end": 327818, "text": "Which of you convinces me of sin? And if I say the truth, why do you not believe me?", "words": [[0, 322526], [6, 322667], [9, 322867], [13, 322987], [23, 323507], [26, 323727], [29, 323867], [34, 324664], [38, 324770], [41, 324930], [43, 325110], [47, 325350], [51, 325510], [58, 326210], [62, 326510], [65, 326730], [69, 326890], [73, 327070], [81, 327370]]}, {"verse": 47, "start": 328268, "end": 334312, "text": "He that is of God hears God’s words: you therefore hear them not, because you are not of God.", "words": [[0, 328268], [3, 328790], [8, 328910], [11, 329090], [14, 329210], [18, 329490], [24, 329850], [30, 330290], [37, 331147], [41, 331285], [51, 331665], [56, 331985], [61, 332165], [66, 332645], [74, 332965], [78, 333205], [82, 333325], [86, 333485], [89, 333625]]}, {"verse": 48, "start": 334662, "end": 340697, "text": "Then answered the Jews, and said to him, Say we not well that you are a Samaritan, and have a demon?", "words": [[0, 334662], [5, 334905], [14, 335345], [18, 335525], [24, 336465], [28, 336545], [33, 336805], [36, 337025], [41, 337596], [45, 337811], [48, 337991], [52, 338211], [57, 338471], [62, 338651], [66, 338791], [70, 338891], [72, 338971], [83, 339491], [87, 339991], [92, 340191], [94, 340271]]}, {"verse": 49, "start": 341047, "end": 346620, "text": "Jesus answered, I have not a demon; but I honour my Father, and you do dishonour me.", "words": [[0, 341047], [6, 341325], [16, 342345], [18, 342491], [23, 342691], [27, 342911], [29, 343071], [36, 343861], [40, 343969], [42, 344169], [49, 344369], [52, 344589], [60, 345249], [64, 345349], [68, 345509], [71, 345919], [81, 346329]]}, {"verse": 50, "start": 347070, "end": 351047, "text": "And I seek not my own glory: there is one that seeks and judges.", "words": [[0, 347070], [4, 347194], [6, 347314], [11, 347594], [15, 347854], [18, 348114], [22, 348254], [29, 349150], [35, 349252], [38, 349432], [42, 349652], [47, 349872], [53, 350172], [57, 350412]]}, {"verse": 51, "start": 351497, "end": 356472, "text": "Most assuredly, I say to you, If a man keep my saying, he shall never see death.", "words": [[0, 351497], [5, 351643], [16, 352303], [18, 352443], [22, 352643], [25, 352823], [30, 353443], [33, 353623], [35, 353723], [39, 353943], [44, 354143], [47, 354343], [55, 355063], [58, 355183], [64, 355363], [70, 355723], [74, 355983]]}, {"verse": 52, "start": 356822, "end": 367114, "text": "Then said the Jews to him, Now we know that you have a demon. Abraham is dead, and the prophets; and you say, If a man keep my saying, he shall never taste of death.", "words": [[0, 356822], [5, 357025], [10, 357285], [14, 357445], [19, 357665], [22, 357965], [27, 358999], [31, 359215], [34, 359415], [39, 359575], [44, 359775], [48, 359895], [53, 360075], [55, 360155], [62, 360914], [70, 361375], [73, 361695], [79, 362015], [83, 362295], [87, 362415], [97, 363379], [101, 363501], [105, 363601], [110, 364101], [113, 364321], [115, 364441], [119, 364701], [124, 364881], [127, 365081], [135, 365741], [138, 365801], [144, 366001], [150, 366261], [156, 366621], [159, 366781]]}, {"verse": 53, "start": 367564, "end": 372994, "text": "Are you greater than our father Abraham, which is dead? and the prophets are dead: whom do you make yourself?", "words": [[0, 367564], [4, 367681], [8, 367801], [16, 368061], [21, 368281], [25, 368401], [32, 368661], [41, 369141], [47, 369441], [50, 369581], [56, 370354], [60, 370459], [64, 370539], [73, 370879], [77, 371099], [83, 371862], [88, 372074], [91, 372154], [95, 372234], [100, 372394]]}, {"verse": 54, "start": 373344, "end": 382455, "text": "Jesus answered, If I honour myself, my honour is nothing: it is my Father that honours me; of whom you say, that he is your God:", "words": [[0, 373344], [6, 373622], [16, 374643], [19, 374799], [21, 374979], [28, 375159], [36, 376239], [39, 376459], [46, 376679], [49, 376959], [58, 377899], [61, 377997], [64, 378117], [67, 378297], [74, 378637], [79, 378907], [87, 379177], [91, 379973], [94, 380137], [99, 380317], [103, 380497], [108, 380857], [113, 381337], [116, 381557], [119, 381717], [124, 381857]]}, {"verse": 55, "start": 382905, "end": 391534, "text": "Yet you have not known him; but I know him: and if I should say, I know him not, I shall be a liar like to you: but I know him, and keep his saying.", "words": [[0, 382905], [4, 383029], [8, 383209], [13, 383349], [17, 383529], [23, 383809], [28, 384537], [32, 384719], [34, 384839], [39, 385039], [44, 385762], [48, 385883], [51, 386023], [53, 386163], [60, 386343], [65, 386863], [67, 387023], [72, 387223], [76, 387383], [81, 387983], [83, 388143], [89, 388303], [92, 388463], [94, 388603], [99, 388803], [104, 389043], [107, 389243], [112, 389802], [116, 389908], [118, 390028], [123, 390248], [128, 390448], [132, 390648], [137, 390868], [141, 391028]]}, {"verse": 56, "start": 391984, "end": 396755, "text": "Your father Abraham rejoiced to see my day: and he saw it, and was glad.", "words": [[0, 391984], [5, 392081], [12, 392361], [20, 392861], [29, 393441], [32, 393561], [36, 393701], [39, 393881], [44, 394568], [48, 394708], [51, 394848], [55, 395208], [59, 395808], [63, 395928], [67, 396108]]}, {"verse": 57, "start": 397105, "end": 402406, "text": "Then said the Jews to him, You are not yet fifty years old, and have you seen Abraham?", "words": [[0, 397105], [5, 397308], [10, 397568], [14, 397728], [19, 397948], [22, 398248], [27, 399282], [31, 399371], [35, 399511], [39, 399691], [43, 399941], [49, 400191], [55, 400491], [60, 401111], [64, 401211], [69, 401371], [73, 401511], [78, 401731]]}, {"verse": 58, "start": 402756, "end": 409320, "text": "Jesus said to them, Most assuredly, I say to you, Before Abraham was, I am.", "words": [[0, 402756], [6, 403014], [11, 403354], [14, 403534], [20, 405811], [25, 405980], [36, 406640], [38, 406720], [42, 406960], [45, 407140], [50, 407400], [57, 407640], [65, 408100], [70, 408780], [72, 408960]]}, {"verse": 59, "start": 409670, "end": 418318, "text": "Then took they up stones to cast at him: but Jesus hid himself, and went out of the temple, going through the midst of them, and so passed by.", "words": [[0, 409670], [5, 409937], [10, 410277], [15, 410477], [18, 410677], [25, 411017], [28, 411297], [33, 411557], [36, 411817], [41, 412440], [45, 412544], [51, 412904], [55, 413264], [64, 413744], [68, 414344], [73, 414544], [77, 414764], [80, 414904], [84, 415004], [92, 415364], [98, 415744], [106, 416004], [110, 416164], [116, 416384], [119, 416604], [125, 416784], [129, 417204], [132, 417404], [139, 417724]]}]}