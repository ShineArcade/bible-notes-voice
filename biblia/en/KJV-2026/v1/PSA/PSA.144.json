{"book": "PSA", "chapter": 144, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 101833, "verses": [{"verse": 1, "start": 300, "end": 5360, "text": "Blessed be the LORD my strength, which teaches my hands to war, and my fingers to fight:", "words": [[0, 300], [8, 539], [11, 799], [15, 939], [20, 1139], [23, 1379], [33, 2099], [39, 2259], [47, 2559], [50, 2839], [56, 3099], [59, 3279], [64, 4019], [68, 4179], [71, 4319], [79, 4639], [82, 4879]]}, {"verse": 2, "start": 5810, "end": 15208, "text": "My goodness, and my fortress; my high tower, and my deliverer; my shield, and he in whom I trust; who subdues my people under me.", "words": [[0, 5810], [3, 5975], [13, 6775], [17, 6855], [20, 7015], [30, 8055], [33, 8395], [38, 8635], [45, 9035], [49, 9335], [52, 9495], [63, 10601], [66, 10766], [74, 11206], [78, 11506], [81, 11746], [84, 11926], [89, 12086], [91, 12306], [98, 13256], [102, 13372], [110, 13972], [113, 14132], [120, 14512], [126, 14852]]}, {"verse": 3, "start": 15658, "end": 21380, "text": "LORD, what is man, that you take knowledge of him! or the son of man, that you make account of him!", "words": [[0, 15658], [6, 16083], [11, 16183], [14, 16343], [19, 16683], [24, 17243], [28, 17423], [33, 17663], [43, 18023], [46, 18263], [51, 18959], [54, 19084], [58, 19224], [62, 19484], [65, 19624], [70, 19944], [75, 20204], [79, 20364], [84, 20584], [92, 20904], [95, 21104]]}, {"verse": 4, "start": 21830, "end": 26216, "text": "Man is like to vanity: his days are as a shadow that passes away.", "words": [[0, 21830], [4, 22074], [7, 22274], [12, 22631], [15, 22988], [23, 23641], [27, 23783], [32, 24103], [36, 24323], [39, 24503], [41, 24583], [48, 24943], [53, 25183], [60, 25563]]}, {"verse": 5, "start": 26666, "end": 31302, "text": "Bow your heavens, O LORD, and come down: touch the mountains, and they shall smoke.", "words": [[0, 26666], [4, 26873], [9, 27053], [18, 27593], [20, 27633], [26, 28093], [30, 28153], [35, 28353], [41, 29324], [47, 29484], [51, 29704], [62, 30064], [66, 30344], [71, 30524], [77, 30724]]}, {"verse": 6, "start": 31752, "end": 35877, "text": "Cast forth lightning, and scatter them: shoot out your arrows, and destroy them.", "words": [[0, 31752], [5, 31973], [11, 32273], [22, 32653], [26, 32893], [34, 33193], [40, 33958], [46, 34195], [50, 34395], [55, 34575], [63, 34875], [67, 35135], [75, 35475]]}, {"verse": 7, "start": 36327, "end": 42547, "text": "Send your hand from above; rid me, and deliver me out of great waters, from the hand of strange children;", "words": [[0, 36327], [5, 36566], [10, 36806], [15, 37066], [20, 37246], [27, 38099], [31, 38384], [35, 38524], [39, 38844], [47, 39144], [50, 39384], [54, 39524], [57, 39624], [63, 39864], [71, 40324], [76, 40844], [80, 41024], [85, 41304], [88, 41444], [96, 41804]]}, {"verse": 8, "start": 42997, "end": 47251, "text": "Whose mouth speaks vanity, and their right hand is a right hand of falsehood.", "words": [[0, 42997], [6, 43104], [12, 43464], [19, 43884], [27, 44604], [31, 44744], [37, 44884], [43, 45164], [48, 45524], [51, 45784], [53, 45904], [59, 46104], [64, 46424], [67, 46544]]}, {"verse": 9, "start": 47701, "end": 55245, "text": "I will sing a new song to you, O God: upon a psaltery and an instrument of ten strings will I sing praises to you.", "words": [[0, 47701], [2, 47850], [7, 48010], [12, 48290], [14, 48450], [18, 48610], [23, 48970], [26, 49230], [31, 49570], [33, 49730], [38, 50651], [43, 50953], [45, 51313], [54, 51673], [58, 51893], [61, 51993], [72, 52433], [75, 52673], [79, 52933], [87, 53433], [92, 53673], [94, 53833], [99, 54093], [107, 54653], [110, 54853]]}, {"verse": 10, "start": 55695, "end": 61562, "text": "It is he that gives salvation to kings: who delivers David his servant from the hurtful sword.", "words": [[0, 55695], [3, 55818], [6, 55998], [9, 56218], [14, 56498], [20, 56738], [30, 57378], [33, 57638], [40, 58630], [44, 58719], [53, 59099], [59, 59519], [63, 59779], [71, 60179], [76, 60479], [80, 60619], [88, 60959]]}, {"verse": 11, "start": 62012, "end": 70152, "text": "Rid me, and deliver me from the hand of strange children, whose mouth speaks vanity, and their right hand is a right hand of falsehood:", "words": [[0, 62012], [4, 62195], [8, 62435], [12, 62815], [20, 63115], [23, 63355], [28, 63555], [32, 63715], [37, 63975], [40, 64095], [48, 64475], [58, 65335], [64, 65615], [70, 65935], [77, 66355], [85, 67355], [89, 67475], [95, 67655], [101, 67935], [106, 68275], [109, 68595], [111, 68715], [117, 68955], [122, 69275], [125, 69415]]}, {"verse": 12, "start": 70602, "end": 78425, "text": "That our sons may be as plants grown up in their youth; that our daughters may be as corner stones, polished after the similitude of a palace:", "words": [[0, 70602], [5, 70718], [9, 70818], [14, 71098], [18, 71358], [21, 71538], [24, 71698], [31, 72078], [37, 72398], [40, 72618], [43, 72758], [49, 72878], [56, 73628], [61, 73737], [65, 73857], [75, 74157], [79, 74477], [82, 74677], [85, 75144], [92, 75610], [100, 76077], [109, 76417], [115, 76777], [119, 76957], [130, 77517], [133, 77717], [135, 77797]]}, {"verse": 13, "start": 78875, "end": 86534, "text": "That our garners may be full, affording all manner of store: that our sheep may bring forth thousands and ten thousands in our streets:", "words": [[0, 78875], [5, 79007], [9, 79337], [17, 79667], [21, 79827], [24, 80007], [30, 80627], [40, 81067], [44, 81287], [51, 81567], [54, 81747], [61, 82628], [66, 82755], [70, 82875], [76, 83155], [80, 83355], [86, 83605], [92, 83855], [102, 84495], [106, 84835], [110, 85075], [120, 85515], [123, 85775], [127, 85895]]}, {"verse": 14, "start": 86984, "end": 94455, "text": "That our oxen may be strong to labour; that there be no breaking in, nor going out; that there be no complaining in our streets.", "words": [[0, 86984], [5, 87106], [9, 87226], [14, 87686], [18, 87846], [21, 87986], [28, 88326], [31, 88709], [39, 89331], [44, 89469], [50, 89609], [53, 89749], 