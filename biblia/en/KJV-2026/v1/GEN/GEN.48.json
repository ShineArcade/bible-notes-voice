{"book": "GEN", "chapter": 48, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 197123, "verses": [{"verse": 1, "start": 300, "end": 10194, "text": "And it came to pass after these things, that one told Joseph, Behold, your father is sick: and he took with him his two sons, Manasseh and Ephraim.", "words": [[0, 300], [4, 437], [7, 537], [12, 777], [15, 977], [20, 1357], [26, 1737], [32, 1977], [40, 2637], [45, 2997], [49, 3237], [54, 3497], [62, 4437], [70, 4957], [75, 5017], [82, 5357], [85, 5637], [91, 6339], [95, 6466], [98, 6566], [103, 6786], [108, 7046], [112, 7226], [116, 7426], [120, 7646], [126, 8446], [135, 9346], [139, 9466]]}, {"verse": 2, "start": 10544, "end": 18562, "text": "And one told Jacob, and said, Behold, your son Joseph comes to you: and Israel strengthened himself, and sat upon the bed.", "words": [[0, 10544], [4, 10826], [8, 11046], [13, 11306], [20, 11786], [24, 12186], [30, 12891], [38, 13473], [43, 13573], [47, 13873], [54, 14293], [60, 14673], [63, 14893], [68, 15386], [72, 15507], [79, 15907], [92, 16447], [101, 16987], [105, 17407], [109, 17667], [114, 17947], [118, 18147]]}, {"verse": 3, "start": 18912, "end": 24737, "text": "And Jacob said to Joseph, God Almighty appeared to me at Luz in the land of Canaan, and blessed me,", "words": [[0, 18912], [4, 19036], [10, 19356], [15, 19636], [18, 19836], [26, 20551], [30, 20771], [39, 21151], [48, 21671], [51, 21911], [54, 22051], [57, 22251], [61, 22451], [64, 22711], [68, 22791], [73, 23011], [76, 23311], [84, 23611], [88, 24031], [96, 24291]]}, {"verse": 4, "start": 25087, "end": 35225, "text": "And said to me, Behold, I will make you fruitful, and multiply you, and I will make of you a multitude of people; and will give this land to your seed after you for an everlasting possession.", "words": [[0, 25087], [4, 25233], [9, 25493], [12, 25653], [16, 25893], [24, 26593], [26, 26773], [31, 26933], [36, 27133], [40, 27253], [50, 27613], [54, 28073], [63, 28533], [68, 29113], [72, 29173], [74, 29293], [79, 29433], [84, 29693], [87, 29853], [91, 29993], [93, 30093], [103, 30413], [106, 30673], [114, 31321], [118, 31427], [123, 31567], [128, 31767], [133, 32007], [138, 32327], [141, 32507], [146, 32647], [151, 32967], [157, 33407], [161, 33647], [165, 33847], [168, 33947], [180, 34387]]}, {"verse": 5, "start": 35575, "end": 45638, "text": "¶ And now your two sons, Ephraim and Manasseh, which were born to you in the land of Egypt before I came to you into Egypt, are mine; as Reuben and Simeon, they shall be mine.", "words": [[2, 35575], [6, 35718], [10, 35938], [15, 36098], [19, 36298], [25, 37018], [33, 37618], [37, 37818], [47, 38638], [53, 38818], [58, 38958], [63, 39198], [66, 39358], [70, 39498], [73, 39618], [77, 39738], [82, 39938], [85, 40078], [91, 40298], [98, 40598], [100, 40778], [105, 40938], [108, 41098], [112, 41258], [117, 41418], [124, 42158], [128, 42258], [134, 42933], [137, 43253], [144, 43603], [148, 43823], [156, 44683], [161, 44783], [167, 45023], [170, 45183]]}, {"verse": 6, "start": 45988, "end": 52712, "text": "And your issue, which you beget after them, shall be yours, and shall be called after the name of their brethren in their inheritance.", "words": [[0, 45988], [4, 46109], [9, 46269], [16, 46669], [22, 46929], [26, 47049], [32, 47369], [38, 47709], [44, 47929], [50, 48169], [53, 48369], [60, 48669], [64, 49149], [70, 49349], [73, 49489], [80, 49769], [86, 50109], [90, 50289], [95, 50569], [98, 50729], [104, 50889], [113, 51289], [116, 51609], [122, 51769]]}, {"verse": 7, "start": 53062, "end": 64266, "text": "And as for me, when I came from Padan, Rachel died by me in the land of Canaan in the way, when yet there was but a little way to come to Ephrath: and I buried her there in the way of Ephrath; the same is Beth-lehem.", "words": [[0, 53062], [4, 53216], [7, 53356], [11, 53516], [15, 54096], [20, 54116], [22, 54236], [27, 54396], [32, 54596], [39, 55336], [46, 55556], [51, 55836], [54, 56076], [57, 56296], [60, 56576], [64, 56676], [69, 56856], [72, 56976], [79, 57336], [82, 57496], [86, 57616], [91, 58190], [96, 58311], [100, 58451], [106, 58591], [110, 58811], [114, 58991], [116, 59091], [123, 59231], [127, 59451], [130, 59611], [135, 59791], [138, 60106], [147, 60616], [151, 60716], [153, 60796], [160, 61076], [164, 61296], [170, 61576], [173, 61756], [177, 61836], [181, 62016], [184, 62351], [193, 62857], [197, 62935], [202, 63275], [205, 63475]]}, {"verse": 8, "start": 64546, "end": 68461, "text": "And Israel beheld Joseph’s sons, and said, Who are these?", "words": [[0, 64546], [4, 64672], [11, 65052], [18, 65512], [27, 66152], [33, 66892], [37, 66992], [43, 67504], [47, 67689], [51, 67869]]}, {"verse": 9, "start": 68741, "end": 78108, "text": "And Joseph said to his father, They are my sons, whom God has given me in this place. And he said, Bring them, please, to me, and I will bless them.", "words": [[0, 68741], [4, 68884], [11, 69184], [16, 69504], [19, 69664], [23, 69764], [31, 70545], [36, 70684], [40, 70824], [43, 71024], [49, 71364], [54, 71764], [58, 72044], [62, 72284], [68, 72504], [71, 72744], [74, 72964], [79, 73144], [86, 73976], [90, 74110], [93, 74250], [99, 75659], [105, 75918], [111, 76178], [119, 76458], [122, 76738], [126, 76978], [130, 77203], [132, 77363], [137, 77503], [143, 77743]]}, {"verse": 10, "start": 78388, "end": 86669, "text": "Now the eyes of Israel were dim for age, so that he could not see. And he brought them near to him; and he kissed them, and embraced them.", "words": [[0, 78388], [4, 78569], [8, 78749], [13, 79069], [16, 79229], [23, 79589], [28, 79849], [32, 80129], [36, 80429], [41, 81009], [44, 81369], [49, 81549], [52, 81689], [58, 81909], [62, 82149], [67, 82953], [71, 83100], [74, 83220], [82, 83440], [87, 83720], [92, 83980], [95, 84180], [100, 84729], [104, 84856], [107, 84976], [114, 85296], [120, 85576], [124, 85796], [133, 86176]]}, {"verse": 11, "start": 87019, "end": 93148, "text": "And Israel