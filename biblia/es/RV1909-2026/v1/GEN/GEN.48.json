{"book": "GEN", "chapter": 48, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 212629, "verses": [{"verse": 1, "start": 300, "end": 10065, "text": "Y sucedió después de estas cosas el haberse dicho a José: He aquí tu padre está enfermo. Y él tomó consigo sus dos hijos Manasés y Efraín.", "words": [[0, 300], [2, 427], [10, 1007], [18, 1307], [21, 1507], [27, 1687], [33, 2207], [36, 2572], [44, 2972], [50, 3232], [52, 3412], [58, 4123], [61, 4203], [66, 4403], [69, 4603], [75, 4903], [80, 5223], [89, 6072], [91, 6249], [94, 6369], [99, 6709], [107, 7129], [111, 7409], [115, 7669], [121, 7989], [129, 8829], [131, 9269]]}, {"verse": 2, "start": 10415, "end": 19596, "text": "Y se hizo saber a Jacob, diciendo: He aquí tu hijo José viene a ti. Entonces se esforzó Israel, y se sentó sobre la cama;", "words": [[0, 10415], [2, 10734], [5, 10914], [10, 11194], [16, 11554], [18, 11714], [25, 12094], [35, 13452], [38, 13532], [43, 13712], [46, 13932], [51, 14132], [56, 14432], [62, 14792], [64, 14952], [68, 15493], [77, 16023], [80, 16503], [88, 17183], [96, 17683], [98, 18008], [101, 18148], [107, 18608], [113, 18828], [116, 19048]]}, {"verse": 3, "start": 19946, "end": 25840, "text": "Y dijo a José: El Dios Omnipotente me apareció en Luz en la tierra de Canaán, y me bendijo,", "words": [[0, 19946], [2, 20238], [7, 20498], [9, 20698], [15, 21388], [18, 21547], [23, 21867], [35, 22587], [38, 22727], [47, 23227], [50, 23307], [54, 23447], [57, 23607], [60, 23707], [67, 23967], [70, 24127], [78, 24607], [80, 25047], [83, 25167]]}, {"verse": 4, "start": 26190, "end": 36039, "text": "Y me dijo: He aquí, yo te haré crecer, y te multiplicaré, y te pondré por estirpe de pueblos: y daré esta tierra a tu descendencia después de ti por heredad perpetua.", "words": [[0, 26190], [2, 26292], [5, 26392], [11, 27068], [14, 27197], [20, 27637], [23, 27717], [26, 27857], [31, 28077], [39, 28557], [41, 28677], [44, 28777], [58, 29577], [60, 29977], [63, 30117], [70, 30477], [74, 30637], [82, 31097], [85, 31217], [94, 32085], [96, 32185], [101, 32465], [106, 32665], [113, 33005], [115, 33205], [118, 33305], [131, 34025], [139, 34285], [142, 34525], [145, 34705], [149, 34965], [157, 35345]]}, {"verse": 5, "start": 36389, "end": 47794, "text": "Y ahora tus dos hijos Efraín y Manasés, que te nacieron en la tierra de Egipto, antes que viniese a ti a la tierra de Egipto, míos son; como Rubén y Simeón, serán míos:", "words": [[0, 36389], [2, 36509], [8, 36729], [12, 36949], [16, 37169], [22, 37449], [29, 38029], [31, 38499], [40, 38969], [44, 39169], [47, 39289], [56, 39729], [59, 39889], [62, 39989], [69, 40209], [72, 40449], [80, 41269], [86, 41549], [90, 41749], [98, 42169], [100, 42349], [103, 42489], [105, 42749], [108, 42829], [115, 43069], [118, 43269], [126, 43739], [131, 44209], [136, 44834], [141, 44979], [147, 45399], [149, 45519], [157, 45999], [163, 46499]]}, {"verse": 6, "start": 48144, "end": 54585, "text": "Y los que después de ellos has engendrado, serán tuyos; por el nombre de sus hermanos serán llamados en sus heredades.", "words": [[0, 48144], [2, 48244], [6, 48364], [10, 48524], [18, 48824], [21, 49004], [27, 49364], [31, 49724], [43, 50084], [49, 50504], [56, 51349], [60, 51467], [63, 51587], [70, 51867], [73, 52047], [77, 52187], [86, 52727], [92, 53027], [101, 53467], [104, 53627], [108, 53827]]}, {"verse": 7, "start": 54935, "end": 66116, "text": "Porque cuando yo venía de Padan-aram, se me murió Raquel en la tierra de Canaán, en el camino, como media legua de tierra viniendo a Efrata; y la sepulté allí en el camino de Efrata, que es Belén.", "words": [[0, 54935], [7, 55108], [14, 55388], [17, 55588], [23, 55928], [26, 56068], [38, 56768], [41, 57248], [44, 57408], [50, 57708], [57, 58088], [60, 58228], [63, 58308], [70, 58568], [73, 58988], [81, 59408], [84, 59468], [87, 59588], [95, 60448], [100, 60648], [106, 60948], [112, 61348], [115, 61448], [122, 61728], [131, 62268], [133, 62348], [141, 63072], [143, 63157], [146, 63257], [154, 63777], [159, 63997], [162, 64137], [165, 64257], [172, 64517], [175, 64757], [183, 65517], [187, 65557], [190, 65697]]}, {"verse": 8, "start": 66396, "end": 70781, "text": "Y vio Israel los hijos de José, y dijo: ¿Quiénes son estos?", "words": [[0, 66396], [2, 66538], [6, 66778], [13, 67398], [17, 67718], [23, 68058], [26, 68258], [32, 68658], [34, 68923], [40, 69905], [49, 70203], [53, 70500]]}, {"verse": 9, "start": 71061, "end": 79597, "text": "Y respondió José a su padre: Son mis hijos, que Dios me ha dado aquí. Y él dijo: Acércalos ahora a mí, y los bendeciré.", "words": [[0, 71061], [2, 71189], [12, 71829], [17, 72189], [19, 72469], [22, 72589], [29, 73459], [33, 73640], [37, 73820], [44, 74060], [48, 74320], [53, 74520], [56, 74780], [59, 74880], [64, 75060], [70, 75774], [72, 75963], [75, 76123], [81, 76842], [91, 77506], [97, 77726], [99, 77946], [103, 78066], [105, 78586], [109, 78746]]}, {"verse": 10, "start": 79877, "end": 88498, "text": "Y los ojos de Israel estaban tan agravados de la vejez, que no podía ver. Les hizo, pues, llegar a él, y él los besó y abrazó.", "words": [[0, 79877], [2, 79996], [6, 80136], [11, 80436], [14, 80656], [21, 81096], [29, 81496], [33, 81816], [43, 82496], [46, 82723], [49, 82949], [56, 83176], [60, 83536], [63, 83696], [69, 84036], [74, 84641], [78, 84783], [84, 85043], [90, 85403], [97, 85883], [99, 86123], [103, 86603], [105, 86983], [108, 87143], [112, 87283], [117, 87755], [119, 87868]]}, {"verse": 11, "start": 88848, "end": 95394, "text": "Y dijo Israel a José: No pensaba yo ver tu rostro, y he aquí Dios me ha hecho ver también tu descendencia.", "words": [[0, 88848], [2, 88971], [7, 89231], [14, 89831], [16, 90131], [22, 90807], [25, 90949], [33, 91369], [36, 91569], [40, 91709], [43, 91829], [51, 92349], [53, 92559], [56, 92769], [61, 92929], [66, 93369], [69, 93609], [72, 93709], [78, 93909], [82, 94089], [90, 94369], [93, 94569]]}, {"verse": 12, "start": 95674, "end": 100481, "text": "Entonces José los sacó de entre sus rodillas, y se inclinó a tierra.", "words": [[0, 95674], [9, 96217], [14, 96577], [18, 96937], [23, 97437], [26, 97537], [32, 97817], [36, 98077], [46, 98657], [48, 98972], [51, 99132], [59, 99792], [61, 99892]]}, {"verse": 13, "start": 100831, "end": 112635, "text": "Y los tomó José a ambos, Efraín a su derecha, a la izquierda de Israel; y a Manasés a su izquierda, a la derecha de Israel; y los acercó a él.", "words": [[0, 100831], [2, 100936], [6, 101056], [11, 101396], [16, 101716], [18, 102036], [25, 102976], [32, 103616], [34, 103736], [37, 103896], [46, 104856], [48, 104916], [51, 105016], [61, 105656], [64, 105796], [72, 106773], [74, 107079], [76, 107425], [84, 107772], [86, 108032], [89, 108252], [100, 109272], [102, 109532], [105, 109632], [113, 110092], [116, 110232], [124, 111188], [126, 111300], [130, 111440], [137, 112020], [139, 112200]]}, {"verse": 14, "start": 112985, "end": 128437, "text": "Entonces Israel extendió su diestra, y la puso sobre la cabeza de Efraín, que era el menor, y su siniestra sobre la cabeza de Manasés, colocando así sus manos adrede, aunque Manasés era el primogénito.", "words": [[0, 112985], [9, 113529], [16, 114309], [25, 115249], [28, 115429], [37, 115989], [39, 116609], [42, 116729], [47, 117089], [53, 117389], [56, 117569], [63, 117969], [66, 118249], [74, 119189], [78, 119369], [82, 119549], [85, 119709], [92, 120404], [94, 120504], [97, 120644], [107, 121484], [113, 121804], [116, 122004], [123, 122404], [126, 122644], [135, 123584], [145, 124284], [149, 124504], [153, 124784], [159, 125426], [167, 126233], [174, 126478], [182, 127098], [186, 127563], [189, 128028]]}, {"verse": 15, "start": 128787, "end": 138214, "text": "Y bendijo a José, y dijo: El Dios en cuya presencia anduvieron mis padres Abraham e Isaac, el Dios que me mantiene desde que yo soy hasta este día,", "words": [[0, 128787], [2, 128894], [10, 129334], [12, 129434], [18, 129814], [20, 130234], [26, 131025], [29, 131095], [34, 131295], [37, 131535], [42, 131795], [52, 132335], [63, 132875], [67, 133035], [74, 133395], [82, 134015], [84, 134495], [91, 135375], [94, 135455], [99, 135675], [103, 135855], [106, 135955], [115, 136455], [121, 136655], [125, 136875], [128, 137055], [132, 137255], [138, 137495], [143, 137755]]}, {"verse": 16, "start": 138564, "end": 150002, "text": "El Ángel que me libra de todo mal, bendiga a estos jóvenes: y mi nombre sea llamado en ellos, y el nombre de mis padres Abraham e Isaac: y multipliquen en gran manera en medio de la tierra.", "words": [[0, 138564], [3, 138706], [9, 139106], [13, 139226], [16, 139366], [22, 139666], [25, 139786], [30, 139986], [35, 140326], [43, 140966], [45, 141046], [51, 141246], [60, 142293], [62, 142399], [65, 142479], [72, 142819], [76, 143159], [84, 143439], [87, 143659], [94, 143959], [96, 144479], [99, 144579], [106, 144879], [109, 145079], [113, 145219], [120, 145579], [128, 146219], [130, 146659], [137, 147485], [139, 147585], [152, 148165], [155, 148285], [160, 148425], [167, 148825], [170, 149025], [176, 149245], [179, 149405], [182, 149525]]}, {"verse": 17, "start": 150282, "end": 165133, "text": "Entonces viendo José que su padre ponía la mano derecha sobre la cabeza de Efraín, le causó esto disgusto; y tomó la mano de su padre, para cambiarla de sobre la cabeza de Efraín a la cabeza de Manasés.", "words": [[0, 150282], [9, 151322], [16, 151642], [21, 152042], [25, 152242], [28, 152402], [34, 152782], [40, 153242], [43, 153362], [48, 153582], [56, 154062], [62, 154342], [65, 154542], [72, 154942], [75, 155202], [83, 156182], [86, 156282], [92, 156922], [97, 157302], [107, 158697], [109, 158841], [114, 159201], [117, 159341], [122, 159581], [125, 159761], [128, 159921], [135, 160381], [140, 160676], [150, 161396], [153, 161556], [159, 161896], [162, 162116], [169, 162536], [172, 162756], [179, 163456], [181, 163696], [184, 163776], [191, 164156], [194, 164679]]}, {"verse": 18, "start": 165483, "end": 172659, "text": "Y dijo José a su padre: No así, padre mío, porque este es el primogénito; pon tu diestra sobre su cabeza.", "words": [[0, 165483], [2, 165588], [7, 165848], [12, 166168], [14, 166348], [17, 166428], [24, 167230], [27, 167408], [32, 167828], [38, 168088], [43, 168748], [50, 168968], [55, 169328], [58, 169568], [61, 169688], [74, 170828], [78, 170968], [81, 171148], [89, 171528], [95, 171808], [98, 171988]]}, {"verse": 19, "start": 172939, "end": 185807, "text": "Mas su padre no quiso, y dijo: Lo sé, hijo mío, lo sé: también él vendrá a ser un pueblo, y será también acrecentado; pero su hermano menor será más grande que él, y su descendencia formará multitud de naciones.", "words": [[0, 172939], [4, 173106], [7, 173226], [13, 173526], [16, 173786], [23, 174266], [25, 174786], [31, 175521], [34, 175646], [38, 175846], [43, 176046], [48, 176506], [51, 176626], [55, 177207], [63, 177551], [66, 177731], [73, 178111], [75, 178211], [79, 178371], [82, 178491], [90, 178831], [92, 179331], [97, 179551], [105, 180181], [118, 180977], [123, 181117], [126, 181257], [134, 181617], [140, 181837], [145, 182097], [149, 182297], [156, 182617], [160, 182817], [164, 183037], [166, 183337], [169, 183477], [182, 184217], [190, 184617], [199, 185117], [202, 185237]]}, {"verse": 20, "start": 186087, "end": 196940, "text": "Y los bendijo aquel día, diciendo: En ti bendecirá Israel, diciendo: Que Dios te ponga como a Efraín y como a Manasés. Y puso a Efraín delante de Manasés.", "words": [[0, 186087], [2, 186211], [6, 186311], [14, 186831], [20, 187211], [25, 187431], [35, 188553], [38, 188735], [41, 188895], [51, 189475], [59, 189895], [69, 190831], [73, 190915], [78, 191095], [81, 191315], [87, 191715], [92, 191915], [94, 192055], [101, 192535], [103, 192735], [108, 192915], [110, 193095], [119, 194039], [121, 194164], [126, 194564], [128, 194664], [135, 195124], [143, 195604], [146, 195764]]}, {"verse": 21, "start": 197290, "end": 204873, "text": "Y dijo Israel a José: He aquí, yo muero, pero Dios será con vosotros, y os hará volver a la tierra de vuestros padres.", "words": [[0, 197290], [2, 197412], [7, 197672], [14, 198272], [16, 198572], [22, 199248], [25, 199410], [31, 199650], [34, 199850], [41, 200370], [46, 200510], [51, 200810], [56, 201190], [60, 201470], [70, 202490], [72, 202550], [75, 202710], [80, 202950], [87, 203150], [89, 203350], [92, 203430], [99, 203710], [102, 203910], [111, 204210]]}, {"verse": 22, "start": 205223, "end": 212229, "text": "Y yo te he dado a ti una parte sobre tus hermanos, la cual tomé yo de mano del amorreo con mi espada y con mi arco.", "words": [[0, 205223], [2, 205341], [5, 205561], [8, 205721], [11, 205861], [16, 206101], [18, 206221], [21, 206381], [25, 206561], [31, 206901], [37, 207201], [41, 207421], [51, 208521], [54, 208601], [59, 208841], [64, 209221], [67, 209421], [70, 209581], [75, 209821], [79, 210181], [87, 210541], [91, 210741], [94, 210921], [101, 211341], [103, 211501], [107, 211661], [110, 211841]]}]}