08687], [247, 208847], [252, 209147], [255, 209627], [261, 209847]]}, {"verse": 24, "start": 210764, "end": 216996, "text": "Era Abraham de edad de noventa y nueve años cuando circuncidó la carne de su prepucio.", "words": [[0, 210764], [4, 211014], [12, 211614], [15, 211914], [20, 212314], [23, 212414], [31, 212914], [33, 212974], [39, 213274], [44, 213654], [51, 214234], [62, 215314], [65, 215514], [71, 215894], [74, 216074], [77, 216572]]}, {"verse": 25, "start": 217346, "end": 223478, "text": "E Ismael su hijo era de trece años, cuando fue circuncidada la carne de su prepucio.", "words": [[0, 217562], [2, 217808], [9, 218055], [12, 218155], [17, 218475], [21, 218575], [24, 218735], [30, 219115], [36, 219815], [43, 220015], [47, 220295], [60, 221255], [63, 221415], [69, 221775], [72, 221975], [75, 222275]]}, {"verse": 26, "start": 223828, "end": 229120, "text": "En el mismo día fue circuncidado Abraham e Ismael su hijo.", "words": [[0, 223828], [3, 223998], [6, 224138], [12, 224438], [16, 224798], [20, 225098], [33, 226418], [41, 227018], [43, 227618], [50, 228478], [53, 228618]]}, {"verse": 27, "start": 229470, "end": 238666, "text": "Y todos los varones de su casa, el siervo nacido en casa, y el comprado por dinero del extranjero, fueron circuncidados con él.", "words": [[0, 229470], [2, 229746], [8, 229946], [12, 230166], [20, 230566], [23, 230706], [26, 230866], [32, 231566], [35, 231686], [42, 232226], [49, 232926], [52, 233146], [58, 233566], [60, 234026], [63, 234166], [72, 234806], [76, 235066], [83, 235386], [87, 235646], [99, 236446], [106, 236906], [120, 238106], [124, 238366]]}]}