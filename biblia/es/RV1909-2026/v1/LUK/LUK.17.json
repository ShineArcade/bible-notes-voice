{"book": "LUK", "chapter": 17, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 270029, "verses": [{"verse": 1, "start": 300, "end": 8069, "text": "Y A SUS discípulos dice: Imposible es que no vengan escándalos; pero ¡ay de aquel por quien vienen!", "words": [[0, 300], [2, 443], [4, 543], [8, 683], [19, 1523], [25, 2742], [35, 3102], [38, 3282], [42, 3382], [45, 3562], [52, 3942], [64, 5148], [69, 5520], [73, 5930], [76, 6330], [82, 6770], [86, 6990], [92, 7250]]}, {"verse": 2, "start": 8419, "end": 18075, "text": "Mejor le fuera, si le pusiesen al cuello una piedra de molino, y le lanzasen en el mar, que escandalizar a uno de estos pequeñitos.", "words": [[0, 8419], [6, 8804], [9, 8984], [16, 9384], [19, 9924], [22, 10064], [31, 10564], [34, 10844], [41, 11244], [45, 11464], [52, 11944], [55, 12064], [63, 12804], [65, 13104], [68, 13224], [77, 14044], [80, 14184], [83, 14344], [88, 14624], [92, 15084], [105, 16124], [107, 16384], [111, 16584], [114, 16764], [120, 17004]]}, {"verse": 3, "start": 18425, "end": 25256, "text": "Mirad por vosotros: si peca contra ti tu hermano, repréndele; y si se arrepiente, perdónale.", "words": [[0, 18425], [6, 18873], [10, 19213], [20, 20123], [23, 20267], [28, 20687], [35, 21007], [38, 21347], [41, 21447], [50, 21947], [62, 23129], [64, 23214], [67, 23334], [70, 23534], [82, 24214]]}, {"verse": 4, "start": 25606, "end": 33270, "text": "Y si siete veces al día peca contra ti, y siete veces al día se vuelve a ti, diciendo, me arrepiento, perdónalo.", "words": [[0, 25606], [2, 25713], [5, 25833], [11, 26173], [17, 26453], [20, 26813], [24, 27033], [29, 27573], [36, 27893], [40, 28153], [42, 28533], [48, 28793], [54, 29093], [57, 29333], [61, 29533], [64, 29713], [71, 30073], [73, 30193], [77, 30333], [87, 30933], [90, 31453], [102, 32193]]}, {"verse": 5, "start": 33620, "end": 37162, "text": "Y dijeron los apóstoles al Señor: Auméntanos la fe.", "words": [[0, 33620], [2, 33744], [10, 34204], [14, 34344], [24, 35004], [27, 35224], [34, 35986], [45, 36634], [48, 36814]]}, {"verse": 6, "start": 37442, "end": 49527, "text": "Entonces el Señor dijo: Si tuvieseis fe como un grano de mostaza, diréis a este sicómoro: Desarráigate, y plántate en el mar; y os obedecerá.", "words": [[0, 37442], [9, 37915], [12, 38275], [18, 38575], [24, 39416], [27, 39878], [37, 40358], [40, 40678], [45, 40998], [48, 41178], [54, 41538], [57, 41638], [66, 42738], [73, 43378], [75, 43578], [80, 44223], [90, 45573], [104, 46143], [106, 46583], [115, 47303], [118, 47483], [121, 47603], [126, 48288], [128, 48374], [131, 48461]]}, {"verse": 7, "start": 49877, "end": 57697, "text": "¿Y quién de vosotros tiene un siervo que ara o apacienta, que vuelto del campo le diga enseguida: Pasa, siéntate a la mesa?", "words": [[0, 49877], [3, 50019], [9, 50219], [12, 50379], [21, 50859], [27, 51159], [30, 51359], [37, 51859], [41, 52019], [45, 52379], [47, 52659], [58, 53499], [62, 53559], [69, 53999], [73, 54139], [79, 54779], [82, 54959], [87, 55139], [98, 56170], [104, 56654], [113, 57074], [115, 57194], [118, 57294]]}, {"verse": 8, "start": 58047, "end": 67388, "text": "¿No le dice antes: Prepárame la cena, y arremángate, y sírveme hasta que haya comido y bebido; y después de esto, come tú y bebe?", "words": [[0, 58047], [4, 58346], [7, 58466], [12, 58706], [19, 59586], [29, 60169], [32, 60309], [38, 60609], [40, 60809], [53, 61609], [55, 62009], [63, 62589], [69, 63049], [73, 63229], [78, 63409], [85, 63949], [87, 64069], [95, 64828], [97, 64934], [105, 65194], [108, 65394], [114, 66134], [119, 66354], [122, 66654], [124, 66954]]}, {"verse": 9, "start": 67738, "end": 72857, "text": "¿Da gracias al siervo porque hizo lo que le había sido mandado? Pienso que no.", "words": [[0, 67738], [4, 67961], [12, 68361], [15, 68681], [22, 69121], [29, 69421], [34, 69841], [37, 70121], [41, 70261], [44, 70401], [50, 70601], [55, 70961], [64, 71961], [71, 72327], [75, 72487]]}, {"verse": 10, "start": 73207, "end": 83020, "text": "Así también vosotros, cuando hayáis hecho todo lo que os es mandado, decid: Siervos inútiles somos, porque lo que debíamos hacer, hicimos.", "words": [[0, 73207], [4, 73437], [12, 73777], [22, 74437], [29, 74737], [36, 75297], [42, 75517], [47, 75857], [50, 76117], [54, 76277], [57, 76457], [60, 76637], [69, 77737], [76, 78845], [84, 79125], [93, 79785], [100, 80665], [107, 81005], [110, 81185], [114, 81325], [123, 81785], [130, 82245]]}, {"verse": 11, "start": 83370, "end": 89411, "text": "Y aconteció que yendo él a Jerusalén, pasaba por medio de Samaria y de Galilea.", "words": [[0, 83370], [2, 83515], [12, 84255], [16, 84495], [22, 84795], [25, 85135], [27, 85375], [38, 86655], [45, 87135], [49, 87375], [55, 87655], [58, 87875], [66, 88395], [68, 88575], [71, 88675]]}, {"verse": 12, "start": 89761, "end": 97373, "text": "Y entrando en una aldea, le vinieron al encuentro diez hombres leprosos, los cuales se pararon de lejos,", "words": [[0, 89761], [2, 89887], [11, 90367], [14, 90567], [18, 90807], [25, 91867], [28, 92087], [37, 92547], [40, 92727], [50, 93327], [55, 93507], [63, 94047], [73, 95087], [77, 95207], [84, 95607], [87, 96107], [95, 96627], [98, 96767]]}, {"verse": 13, "start": 97723, "end": 103145, "text": "Y alzaron la voz, diciendo: Jesús, Maestro, ten misericordia de nosotros.", "words": [[0, 97723], [2, 97847], [10, 98347], [13, 98507], [18, 98867], [28, 100110], [35, 100755], [44, 101595], [48, 101675], [61, 102455], [64, 102555]]}, {"verse": 14, "start": 103425, "end": 111209, "text": "Y como él los vio, les dijo: Id, mostraos a los sacerdotes. Y aconteció, que yendo ellos, fueron limpios.", "words": [[0, 103425], [2, 103547], [7, 103787], [10, 104047], [14, 104187], [19, 104447], [23, 104567], [29, 105455], [33, 105575], [42, 106715], [44, 106835], [48, 106975], [60, 108357], [62, 108457], [73, 109117], [77, 109327], [83, 109537], [90, 109857], [97, 110257]]}, {"verse": 15, "start": 111559, "end": 118377, "text": "Entonces uno de ellos, como se vio que estaba limpio, volvió, glorificando a Dios a gran voz;", "words": [[0, 111559], [9, 112083], [13, 112623], [16, 112823], [23, 113203], [28, 113503], [31, 113703], [35, 113923], [39, 114043], [46, 114263], [54, 115363], [62, 116683], [75, 117163], [77, 117303], [82, 117443], [84, 117683], [89, 117843]]}, {"verse": 16, "start": 118727, "end": 124465, "text": "Y se postró sobre el rostro a sus pies, dándole gracias: y este era samaritano.", "words": [[0, 118727], [2, 118834], [5, 118974], [12, 119434], [18, 119734], [21, 119954], [28, 120414], [30, 120514], [34, 120674], [40, 121394], [48, 121774], [57, 122817], [59, 122956], [64, 123196], [68, 123436]]}, {"verse": 17, "start": 124815, "end": 130850, "text": "Y respondiendo Jesús, dijo: ¿No son diez los que fueron limpios? ¿Y los nueve dónde están?", "words": [[0, 124815], [2, 124939], [15, 125679], [22, 126399], [28, 127103], [32, 127253], [36, 127503], [41, 127753], [45, 128053], [49, 128213], [56, 128493], [65, 129505], [68, 129613], [72, 129733], [78, 130053], [84, 130193]]}, {"verse": 18, "start": 131200, "end": 135642, "text": "¿No hubo quien volviese y diese gloria a Dios sino este extranjero?", "words": [[0, 131200], [4, 131386], [9, 131706], [15, 131886], [24, 132526], [26, 132786], [32, 133046], [39, 133566], [41, 133746], [46, 134046], [51, 134706], [56, 134766]]}, {"verse": 19, "start": 135992, "end": 139763, "text": "Y le dijo: Levántate, vete; tu fe te ha salvado.", "words": [[0, 135992], [2, 136135], [5, 136255], [11, 137014], [22, 137781], [28, 138463], [31, 138566], [34, 138766], [37, 138926], [40, 139006]]}, {"verse": 20, "start": 140113, "end": 150260, "text": "Y preguntado por los fariseos, cuándo había de venir el reino de Dios, les respondió y dijo: El reino de Dios no vendrá con advertencia;", "words": [[0, 140113], [2, 140218], [13, 140878], [17, 141118], [21, 141278], [31, 142218], [38, 142758], [44, 143218], [47, 143398], [53, 143698], [56, 143958], [62, 144318], [65, 144478], [71, 145318], [75, 145498], [85, 146458], [87, 146558], [93, 147234], [96, 147380], [102, 147760], [105, 147920], [110, 148160], [113, 148460], [120, 148940], [124, 149140]]}, {"verse": 21, "start": 150610, "end": 157524, "text": "Ni dirán: Está aquí, o está allí: porque he aquí el reino de Dios entre vosotros está.", "words": [[0, 150934], [3, 151292], [10, 151851], [15, 152216], [21, 152536], [23, 153056], [28, 153316], [34, 154022], [41, 154244], [44, 154524], [49, 154844], [52, 155004], [58, 155404], [61, 155544], [66, 155844], [72, 156304], [81, 157144]]}, {"verse": 22, "start": 157874, "end": 165174, "text": "Y dijo a sus discípulos: Tiempo vendrá, cuando desearéis ver uno de los días del Hijo del hombre, y no lo veréis.", "words": [[0, 157874], [2, 158124], [7, 158364], [9, 158524], [13, 158644], [25, 159811], [32, 160177], [40, 160597], [47, 160837], [57, 161737], [61, 161997], [65, 162357], [68, 162517], [72, 162657], [77, 162917], [81, 163177], [86, 163437], [90, 163597], [98, 164037], [100, 164197], [103, 164337], [106, 164457]]}, {"verse": 23, "start": 165524, "end": 170069, "text": "Y os dirán: Está aquí, o está allí. No vayáis, ni sigáis.", "words": [[0, 165524], [2, 165673], [5, 165773], [12, 166567], [17, 166872], [23, 167152], [25, 167552], [30, 167812], [36, 168490], [39, 168619], [47, 169079], [50, 169339]]}, {"verse": 24, "start": 170419, "end": 181993, "text": "Porque como el relámpago, relampagueando desde una parte de debajo del cielo, resplandece hasta la otra debajo del cielo, así también será el Hijo del hombre en su día.", "words": [[0, 170419], [7, 170663], [12, 171043], [15, 171263], [26, 172623], [41, 173763], [47, 174023], [51, 174263], [57, 174643], [60, 174843], [67, 175243], [71, 175483], [78, 176458], [90, 177098], [96, 177318], [99, 177498], [104, 177698], [111, 178138], [115, 178338], [122, 178938], [126, 179118], [134, 179538], [139, 179898], [142, 180218], [147, 180478], [151, 180678], [158, 180998], [161, 181338], [164, 181498]]}, {"verse": 25, "start": 182343, "end": 188207, "text": "Pero primero es necesario que padezca mucho, y sea rechazado por esta generación.", "words": [[0, 182343], [5, 182505], [13, 182905], [16, 183125], [26, 183785], [30, 184105], [38, 184685], [45, 185045], [47, 185340], [51, 185700], [61, 186780], [65, 187040], [70, 187220]]}, {"verse": 26, "start": 188557, "end": 194055, "text": "Y como fue en los días de Noé, así también será en los días del Hijo del hombre.", "words": [[0, 188557], [2, 188814], [7, 189054], [11, 189354], [14, 189594], [18, 189734], [23, 189974], [26, 190154], [31, 190874], [35, 191074], [43, 191594], [48, 192034], [51, 192434], [55, 192594], [60, 192834], [64, 193094], [69, 193314], [73, 193514]]}, {"verse": 27, "start": 194405, "end": 204750, "text": "Comían, bebían, se casaban y se daban en casamiento, hasta el día que entró Noé en el arca; y vino el diluvio, y destruyó a todos.", "words": [[0, 194405], [8, 194969], [16, 195829], [19, 195929], [27, 196629], [29, 196834], [32, 196954], [38, 197254], [41, 197394], [53, 198574], [59, 198954], [62, 199114], [66, 199294], [70, 199474], [76, 199954], [80, 200434], [83, 200674], [86, 200814], [92, 201636], [94, 201742], [99, 201962], [102, 202122], [111, 202802], [113, 203182], [122, 203902], [124, 204102]]}, {"verse": 28, "start": 205100, "end": 213040, "text": "Asimismo también como fue en los días de Lot; comían, bebían, compraban, vendían, plantaban, edificaban;", "words": [[0, 205100], [9, 205784], [17, 206144], [22, 206584], [26, 206924], [29, 207104], [33, 207244], [38, 207563], [41, 207882], [46, 208375], [54, 209019], [62, 209639], [73, 210479], [82, 211139], [93, 212119]]}, {"verse": 29, "start": 213390, "end": 219843, "text": "Pero el día que Lot salió de Sodoma, llovió del cielo fuego y azufre, y destruyó a todos:", "words": [[0, 213390], [5, 213535], [8, 213695], [12, 213895], [16, 214095], [20, 214315], [26, 214875], [29, 215015], [37, 216115], [44, 216495], [48, 216635], [54, 216955], [60, 217415], [62, 217795], [70, 218175], [72, 218555], [81, 219155], [83, 219275]]}, {"verse": 30, "start": 220193, "end": 223846, "text": "Como esto será el día en que el Hijo del hombre se manifestará.", "words": [[0, 220193], [5, 220377], [10, 220637], [15, 221017], [18, 221257], [22, 221497], [25, 221717], [29, 221857], [32, 222017], [37, 222277], [41, 222437], [48, 222697], [51, 222897]]}, {"verse": 31, "start": 224196, "end": 234308, "text": "En aquel día, el que esté en la azotea, y sus bienes en casa, no descienda a tomarlos: y el que en el campo, asimismo no vuelva atrás.", "words": [[0, 224196], [3, 224335], [9, 224695], [14, 224935], [17, 225255], [21, 225455], [26, 225775], [29, 226135], [32, 226315], [40, 227095], [42, 227235], [46, 227415], [53, 227775], [56, 227915], [62, 228235], [65, 228855], [75, 229455], [77, 229655], [87, 230722], [89, 230886], [92, 231066], [96, 231246], [99, 231546], [102, 231706], [109, 232286], [118, 233161], [121, 233301], [128, 233681]]}, {"verse": 32, "start": 234658, "end": 236963, "text": "Acordaos de la mujer de Lot.", "words": [[0, 235058], [9, 235458], [12, 235678], [15, 235778], [21, 236108], [24, 236438]]}, {"verse": 33, "start": 237313, "end": 242788, "text": "Todo el que procure salvar su vida, la perderá; y todo el que la pierda, la salvará.", "words": [[0, 237313], [5, 237487], [8, 237697], [12, 237797], [20, 238217], [27, 238657], [30, 238977], [36, 239257], [39, 239417], [48, 240379], [50, 240521], [55, 240721], [58, 240941], [62, 241081], [65, 241221], [73, 241821], [76, 242121]]}, {"verse": 34, "start": 243138, "end": 249199, "text": "Os digo que en aquella noche estarán dos en una cama; el uno será tomado, y el otro será dejado.", "words": [[0, 243138], [3, 243244], [8, 243504], [12, 243764], [15, 243924], [23, 244284], [29, 244464], [37, 245004], [41, 245164], [44, 245384], [48, 245584], [54, 246309], [57, 246453], [61, 246673], [66, 246893], [74, 247533], [76, 247793], [79, 247953], [84, 248193], [89, 248493]]}, {"verse": 35, "start": 249549, "end": 255174, "text": "Dos mujeres estarán moliendo juntas: la una será tomada, y la otra dejada.", "words": [[0, 249549], [4, 249738], [12, 250178], [20, 250898], [29, 251398], [37, 252471], [40, 252620], [44, 252820], [49, 253060], [57, 253640], [59, 254080], [62, 254220], [67, 254727]]}, {"verse": 36, "start": 255524, "end": 260626, "text": "Dos estarán en el campo; el uno será tomado, y el otro dejado.", "words": [[0, 255524], [4, 255829], [12, 256549], [15, 256749], [18, 256869], [25, 257765], [28, 257913], [32, 258133], [37, 258353], [45, 259073], [47, 259473], [50, 259613], [55, 259833]]}, {"verse": 37, "start": 260976, "end": 269629, "text": "Y respondiendo, le dicen: ¿Dónde, Señor? Y él les dijo: Donde esté el cuerpo, allá se juntarán también las águilas.", "words": [[0, 260976], [2, 261311], [16, 261677], [19, 262044], [26, 262990], [34, 263330], [41, 264104], [43, 264287], [46, 264427], [50, 264567], [56, 265359], [62, 265606], [67, 265946], [70, 266226], [78, 267146], [83, 267366], [86, 267606], [95, 268266], [103, 268566], [107, 268846]]}]}