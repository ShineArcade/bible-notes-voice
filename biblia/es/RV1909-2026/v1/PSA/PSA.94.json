494], [81, 73784], [84, 73944]]}, {"verse": 14, "start": 74741, "end": 79580, "text": "Porque no dejará Jehová su pueblo, ni desamparará su heredad;", "words": [[0, 74741], [7, 74945], [10, 75165], [17, 75685], [24, 76045], [27, 76185], [35, 76825], [38, 77205], [50, 78585], [53, 78865]]}, {"verse": 15, "start": 79930, "end": 86940, "text": "Sino que el juicio será vuelto a justicia, y en pos de ella irán todos los rectos de corazón.", "words": [[0, 79930], [5, 80194], [9, 80434], [12, 80554], [19, 80954], [24, 81234], [31, 81654], [33, 81754], [43, 82514], [45, 82974], [48, 83114], [52, 83374], [55, 83654], [60, 83914], [65, 84394], [71, 84774], [75, 85414], [82, 86014], [85, 86174]]}, {"verse": 16, "start": 87290, "end": 93307, "text": "¿Quién se levantará por mí contra los malignos? ¿quién estará por mí contra los que hacen iniquidad?", "words": [[0, 87290], [7, 87574], [10, 87714], [20, 88234], [24, 88434], [27, 88654], [34, 88934], [38, 89134], [48, 90094], [55, 90356], [62, 90776], [66, 90896], [69, 91196], [76, 91496], [80, 91716], [84, 91856], [90, 92156]]}, {"verse": 17, "start": 93657, "end": 98379, "text": "Si no me ayudara Jehová, pronto morara mi alma en el silencio.", "words": [[0, 93657], [3, 93819], [6, 93999], [9, 94339], [17, 94679], [25, 95579], [32, 95859], [39, 96379], [42, 96619], [47, 96979], [50, 97339], [53, 97519]]}, {"verse": 18, "start": 98729, "end": 104990, "text": "Cuando yo decía: Mi pie resbala: tu misericordia, oh Jehová, me sustentaba.", "words": [[0, 98729], [7, 99095], [10, 99315], [17, 100304], [20, 100446], [24, 101139], [33, 102001], [36, 102103], [50, 102783], [53, 103463], [61, 103923], [64, 104003]]}, {"verse": 19, "start": 105340, "end": 112068, "text": "En la multitud de mis pensamientos dentro de mí, tus consolaciones alegraban mi alma.", "words": [[0, 105340], [3, 105501], [6, 105621], [15, 106301], [18, 106481], [22, 106681], [35, 107561], [42, 107901], [45, 108241], [49, 108961], [53, 109241], [67, 110381], [77, 11132