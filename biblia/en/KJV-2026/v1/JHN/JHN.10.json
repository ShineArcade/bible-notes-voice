{"book": "JHN", "chapter": 10, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 243094, "verses": [{"verse": 1, "start": 300, "end": 9063, "text": "Most assuredly, I say to you, He that enters not by the door into the sheepfold, but climbs up some other way, the same is a thief and a robber.", "words": [[0, 300], [5, 531], [16, 1191], [18, 1311], [22, 1531], [25, 1731], [30, 2331], [33, 2491], [38, 2771], [45, 3131], [49, 3411], [52, 3651], [56, 3771], [61, 4071], [66, 4331], [70, 4511], [81, 5371], [85, 5491], [92, 5831], [95, 6111], [100, 6291], [106, 6491], [111, 7091], [115, 7171], [120, 7511], [123, 7771], [125, 7891], [131, 8151], [135, 8511], [137, 8611]]}, {"verse": 2, "start": 9413, "end": 12689, "text": "But he that enters in by the door is the shepherd of the sheep.", "words": [[0, 9413], [4, 9556], [7, 9796], [12, 10016], [19, 10336], [22, 10536], [25, 10716], [29, 10856], [34, 11176], [37, 11456], [41, 11596], [50, 11876], [53, 12096], [57, 12216]]}, {"verse": 3, "start": 13039, "end": 20100, "text": "To him the porter opens; and the sheep hear his voice: and he calls his own sheep by name, and leads them out.", "words": [[0, 13039], [3, 13138], [7, 13598], [11, 13678], [18, 13918], [25, 14856], [29, 15176], [33, 15276], [39, 15536], [44, 15856], [48, 16056], [55, 16858], [59, 16992], [62, 17071], [68, 17351], [72, 17571], [76, 17751], [82, 18031], [85, 18292], [91, 18652], [95, 19152], [101, 19431], [106, 19691]]}, {"verse": 4, "start": 20450, "end": 26079, "text": "And when he puts forth his own sheep, he goes before them, and the sheep follow him: for they know his voice.", "words": [[0, 20450], [4, 20552], [9, 20672], [12, 20772], [17, 20952], [23, 21232], [27, 21452], [31, 21632], [38, 22272], [41, 22372], [46, 22592], [53, 23012], [59, 23532], [63, 23712], [67, 23812], [73, 24032], [80, 24412], [85, 25009], [89, 25090], [94, 25190], [99, 25390], [103, 25530]]}, {"verse": 5, "start": 26429, "end": 31950, "text": "And a stranger will they not follow, but will flee from him: for they know not the voice of strangers.", "words": [[0, 26429], [4, 26554], [6, 26654], [15, 27034], [20, 27294], [25, 27434], [29, 27614], [37, 28414], [41, 28674], [46, 28874], [51, 29154], [56, 29374], [61, 29936], [65, 30020], [70, 30160], [75, 30360], [79, 30560], [83, 30760], [89, 31000], [92, 31160]]}, {"verse": 6, "start": 32230, "end": 37688, "text": "This parable spoke Jesus to them: but they understood not what things they were which he spoke to them.", "words": [[0, 32230], [5, 32364], [13, 32824], [19, 33124], [25, 33444], [28, 33744], [34, 34471], [38, 34570], [43, 34750], [54, 35110], [58, 35390], [63, 35630], [70, 35950], [75, 36150], [80, 36550], [86, 36670], [89, 36810], [95, 37070], [98, 37290]]}, {"verse": 7, "start": 38038, "end": 43346, "text": "Then said Jesus to them again, Most assuredly, I say to you, I am the door of the sheep.", "words": [[0, 38038], [5, 38393], [10, 38653], [16, 38973], [19, 39253], [24, 39453], [31, 40286], [36, 40511], [47, 41131], [49, 41251], [53, 41471], [56, 41591], [61, 42031], [63, 42231], [66, 42351], [70, 42471], [75, 42711], [78, 42851], [82, 42951]]}, {"verse": 8, "start": 43696, "end": 47841, "text": "All that ever came before me are thieves and robbers: but the sheep did not hear them.", "words": [[0, 43696], [4, 43854], [9, 44014], [14, 44154], [19, 44394], [26, 44694], [29, 44914], [33, 45074], [41, 45394], [45, 45634], [54, 46440], [58, 46640], [62, 46760], [68, 46960], [72, 47140], [76, 47300], [81, 47520]]}, {"verse": 9, "start": 48191, "end": 55825, "text": "I am the door: by me if any man enter in, he shall be saved, and shall go in and out, and find pasture.", "words": [[0, 48191], [2, 48571], [5, 48671], [9, 48771], [15, 49430], [18, 49570], [21, 49830], [24, 50050], [28, 50310], [32, 50630], [38, 50970], [42, 51690], [45, 51790], [51, 51990], [54, 52110], [61, 53030], [65, 53110], [71, 53310], [74, 53530], [77, 53930], [81, 54150], [86, 54810], [90, 54870], [95, 55130]]}, {"verse": 10, "start": 56175, "end": 64676, "text": "The thief comes not, but to steal, and to kill, and to destroy: I am come that they might have life, and that they might have it more abundantly.", "words": [[0, 56175], [4, 56277], [10, 56517], [16, 56817], [21, 57317], [25, 57637], [28, 57757], [35, 58157], [39, 58617], [42, 58737], [48, 59077], [52, 59417], [55, 59537], [64, 60462], [66, 60707], [69, 60947], [74, 61247], [79, 61627], [84, 61807], [90, 62027], [95, 62247], [101, 62547], [105, 62862], [110, 63042], [115, 63202], [121, 63422], [126, 63622], [129, 63742], [134, 63942]]}, {"verse": 11, "start": 65026, "end": 68813, "text": "I am the good shepherd: the good shepherd gives his life for the sheep.", "words": [[0, 65026], [2, 65223], [5, 65483], [9, 65683], [14, 65863], [24, 66686], [28, 66783], [33, 66963], [42, 67283], [48, 67623], [52, 67823], [57, 68123], [61, 68263], [65, 68383]]}, {"verse": 12, "start": 69163, "end": 79167, "text": "But he that is a hireling, and not the shepherd, whose own the sheep are not, sees the wolf coming, and leaves the sheep, and flees: and the wolf catches them, and scatters the sheep.", "words": [[0, 69163], [4, 69285], [7, 69505], [12, 69725], [15, 69865], [17, 69945], [27, 70445], [31, 70825], [35, 71005], [39, 71165], [49, 71745], [55, 71925], [59, 72185], [63, 72345], [69, 72525], [73, 72705], [78, 73305], [83, 73565], [87, 73785], [92, 73965], [100, 74265], [104, 74645], [111, 74885], [115, 75105], [122, 75365], [126, 75645], [133, 76461], [137, 76587], [141, 76687], [146, 76927], [154, 77367], [160, 77707], [164, 78067], [173, 78587], [177, 78727]]}, {"verse": 13, "start": 79517, "end": 83586, "text": "The hireling flees, because he is a hireling, and cares not for the sheep.", "words": [[0, 79517], [4, 79624], [13, 80104], [20, 80644], [28, 80884], [31, 81144], [34, 81304], [36, 81404], [46, 81904], [50, 82204], [56, 82504], [60, 82804], [64, 83044], [68, 83164]]}, {"verse": 14, "start": 83936, "end": 88166, "text": "I am the good shepherd, and know my sheep, and am known of mine.", "words": [[0, 83936], [2, 84217], [5, 84437], [9, 84577], [14, 84777], [24, 85717], [28, 85817], [33, 86017], [36, 86217], [43, 86977], [47, 87097], [50, 87217], [56, 87417], [59, 87617]]}, {"verse": 15, "start": 88516, "end": 93467, "text": "As the Father knows me, even so know I the Father: and I lay down my life for the sheep.", "words": [[0, 88516], [3, 88660], [7, 88800], [14, 89060], [20, 89340], [24, 89860], [29, 90020], [32, 90320], [37, 90520], [39, 90680], [43, 90800], [51, 91498], [55, 91678], [57, 91798], [61, 91978], [66, 92218], [69, 92458], [74, 92758], [78, 92918], [82, 93018]]}, {"verse": 16, "start": 93817, "end": 102248, "text": "And other sheep I have, which are not of this fold: them also I must bring, and they shall hear my voice; and there shall be one fold, and one shepherd.", "words": [[0, 93817], [4, 93981], [10, 94201], [16, 94481], [18, 94741], [24, 95421], [30, 95541], [34, 95661], [38, 95841], [41, 96001], [46, 96181], [52, 96882], [57, 97044], [62, 97364], [64, 97564], [69, 97744], [76, 98364], [80, 98444], [85, 98564], [91, 98724], [96, 98924], [99, 99124], [106, 99938], [110, 100058], [116, 100198], [122, 100378], [125, 100538], [129, 100818], [135, 101158], [139, 101498], [143, 101678]]}, {"verse": 17, "start": 102598, "end": 107449, "text": "Therefore does my Father love me, because I lay down my life, that I might take it again.", "words": [[0, 102598], [10, 102878], [15, 103138], [18, 103338], [25, 103618], [30, 103938], [34, 104298], [42, 104678], [44, 104858], [48, 105058], [53, 105298], [56, 105538], [62, 106118], [67, 106358], [69, 106458], [75, 106578], [80, 106838], [83, 106958]]}, {"verse": 18, "start": 107799, "end": 117782, "text": "No man takes it from me, but I lay it down of myself. I have power to lay it down, and I have power to take it again. This commandment have I received of my Father.", "words": [[0, 107799], [3, 107979], [7, 108239], [13, 108519], [16, 108699], [21, 108879], [25, 109239], [29, 109499], [31, 109599], [35, 109799], [38, 109879], [43, 110099], [46, 110259], [54, 111112], [56, 111291], [61, 111431], [67, 111771], [70, 111971], [74, 112191], [77, 112311], [83, 112671], [87, 112956], [89, 113136], [94, 113316], [100, 113696], [103, 113916], [108, 114176], [111, 114276], [118, 115061], [123, 115263], [135, 115923], [140, 116103], [142, 116243], [151, 116703], [154, 117003], [157, 117183]]}, {"verse": 19, "start": 118062, "end": 121553, "text": "¶ There was a division therefore again among the Jews for these sayings.", "words": [[2, 118062], [8, 118208], [12, 118408], [14, 118508], [23, 118848], [33, 119228], [39, 119608], [45, 119868], [49, 120068], [54, 120368], [58, 120628], [64, 120828]]}, {"verse": 20, "start": 121903, "end": 126300, "text": "And many of them said, He has a demon, and is mad; why do you hear him?", "words": [[0, 121903], [4, 122011], [9, 122211], [12, 122391], [17, 122531], [23, 123231], [26, 123363], [30, 123683], [32, 123863], [39, 124163], [43, 124543], [46, 124683], [51, 125408], [55, 125546], [58, 125646], [62, 125746], [67, 125966]]}, {"verse": 21, "start": 126580, "end": 132131, "text": "Others said, These are not the words of him that has a demon. Can a demon open the eyes of the blind?", "words": [[0, 126580], [7, 126809], [13, 127557], [19, 127720], [23, 127900], [27, 128100], [31, 128320], [37, 128560], [40, 128760], [44, 128940], [49, 129160], [53, 129400], [55, 129500], [62, 130206], [66, 130351], [68, 130451], [74, 130691], [79, 130991], [83, 131171], [88, 131391], [91, 131531], [95, 131631]]}, {"verse": 22, "start": 132411, "end": 136195, "text": "¶ And it was at Jerusalem the feast of the dedication, and it was winter.", "words": [[2, 132411], [6, 132530], [9, 132610], [13, 132750], [16, 132890], [26, 133390], [30, 133770], [36, 134070], [39, 134270], [43, 134370], [55, 134950], [59, 135370], [62, 135470], [66, 135610]]}, {"verse": 23, "start": 136545, "end": 139617, "text": "And Jesus walked in the temple in Solomon’s porch.", "words": [[0, 136545], [4, 136667], [10, 136967], [17, 137407], [20, 137627], [24, 137727], [31, 138067], [34, 138287], [44, 138907]]}, {"verse": 24, "start": 139967, "end": 146344, "text": "Then came the Jews round about him, and said to him, How long do you make us to doubt? If you be the Christ, tell us plainly.", "words": [[0, 139967], [5, 140114], [10, 140394], [14, 140574], [19, 140854], [25, 141194], [31, 141514], [36, 141754], [40, 141954], [45, 142134], [48, 142334], [53, 142852], [57, 143002], [62, 143202], [65, 143402], [69, 143462], [74, 143642], [77, 143822], [80, 143942], [87, 144623], [90, 144760], [94, 144840], [97, 144960], [101, 145080], [109, 145500], [114, 145700], [117, 145840]]}, {"verse": 25, "start": 146624, "end": 153582, "text": "Jesus answered them, I told you, and you believed not: the works that I do in my Father’s name, they bear witness of me.", "words": [[0, 146624], [6, 146900], [15, 147340], [21, 147810], [23, 147976], [28, 148256], [33, 148556], [37, 148836], [41, 148996], [50, 149336], [55, 150155], [59, 150239], [65, 150479], [70, 150679], [72, 150819], [75, 150999], [78, 151119], [81, 151279], [90, 151739], [96, 152319], [101, 152479], [106, 152699], [114, 152979], [117, 153279]]}, {"verse": 26, "start": 153932, "end": 157618, "text": "But you believe not, because you are not of my sheep, as I said to you.", "words": [[0, 153932], [4, 154017], [8, 154197], [16, 154497], [21, 154837], [29, 155377], [33, 155617], [37, 155717], [41, 155857], [44, 156017], [47, 156177], [54, 156637], [57, 156737], [59, 156857], [64, 157057], [67, 157237]]}, {"verse": 27, "start": 157968, "end": 161174, "text": "My sheep hear my voice, and I know them, and they follow me:", "words": [[0, 157968], [3, 158090], [9, 158330], [14, 158590], [17, 158770], [24, 159370], [28, 159470], [30, 159590], [35, 159790], [41, 160270], [45, 160370], [50, 160470], [57, 160790]]}, {"verse": 28, "start": 161524, "end": 167678, "text": "And I give to them eternal life; and they shall never perish, neither shall any man pluck them out of my hand.", "words": [[0, 161524], [4, 161658], [6, 161798], [11, 162038], [14, 162218], [19, 162418], [27, 162878], [33, 163617], [37, 163724], [42, 163844], [48, 164044], [54, 164404], [62, 165244], [70, 165464], [76, 165724], [80, 165964], [84, 166264], [90, 166524], [95, 166744], [99, 166904], [102, 167004], [105, 167184]]}, {"verse": 29, "start": 168028, "end": 173857, "text": "My Father, which gave them me, is greater than all; and no man is able to pluck them out of my Father’s hand.", "words": [[0, 168028], [3, 168150], [11, 168590], [17, 168690], [22, 168930], [27, 169130], [31, 169690], [34, 169790], [42, 170050], [47, 170310], [52, 170874], [56, 170999], [59, 171219], [63, 171519], [66, 171739], [71, 171919], [74, 172059], [80, 172279], [85, 172519], [89, 172679], [92, 172779], [95, 172939], [104, 173399]]}, {"verse": 30, "start": 174207, "end": 175963, "text": "I and my Father are one.", "words": [[0, 174207], [2, 174485], [6, 174705], [9, 174845], [16, 175185], [20, 175465]]}, {"verse": 31, "start": 176243, "end": 179101, "text": "Then the Jews took up stones again to stone him.", "words": [[0, 176243], [5, 176474], [9, 176634], [14, 176934], [19, 177254], [22, 177434], [29, 177754], [35, 178214], [38, 178414], [44, 178674]]}, {"verse": 32, "start": 179451, "end": 185496, "text": "Jesus answered them, Many good works have I showed you from my Father; for which of those works do you stone me?", "words": [[0, 179451], [6, 179773], [15, 180233], [21, 180856], [26, 181083], [31, 181343], [37, 181703], [42, 181963], [44, 182103], [51, 182363], [55, 182543], [60, 182723], [63, 182903], [71, 183664], [75, 183746], [81, 183946], [84, 184086], [90, 184286], [96, 184586], [99, 184846], [103, 184966], [109, 185246]]}, {"verse": 33, "start": 185776, "end": 193907, "text": "The Jews answered him, saying, For a good work we stone you not; but for blasphemy; and because that you, being a man, make yourself God.", "words": [[0, 185776], [4, 185938], [9, 186158], [18, 186578], [23, 186958], [31, 187769], [35, 187873], [37, 187993], [42, 188113], [47, 188553], [50, 188653], [56, 188913], [60, 189093], [65, 189833], [69, 189992], [73, 190192], [84, 191075], [88, 191186], [96, 191426], [101, 191706], [106, 191926], [112, 192126], [114, 192306], [119, 192526], [124, 192986], [133, 193326]]}, {"verse": 34, "start": 194187, "end": 198553, "text": "Jesus answered them, Is it not written in your law, I said, You are gods?", "words": [[0, 194187], [6, 194463], [15, 194903], [21, 195373], [24, 195510], [27, 195610], [31, 195790], [39, 196110], [42, 196310], [47, 196430], [52, 196950], [54, 197090], [60, 197590], [64, 197830], [68, 197930]]}, {"verse": 35, "start": 198903, "end": 203120, "text": "If he called them gods to whom the word of God came and the scripture can not be broken", "words": [[0, 198903], [3, 199030], [6, 199130], [13, 199370], [18, 199590], [23, 199910], [26, 200130], [31, 200310], [35, 200450], [40, 200670], [43, 200770], [47, 201010], [52, 201370], [56, 201590], [60, 201710], [70, 201917], [74, 202123], [78, 202330], [81, 202550]]}, {"verse": 36, "start": 203470, "end": 211448, "text": "Say you of him, whom the Father has sanctified, and sent into the world, You blaspheme; because I said, I am the Son of God?", "words": [[0, 203470], [4, 203715], [8, 203955], [11, 204135], [16, 204375], [21, 204855], [25, 204995], [32, 205275], [36, 205455], [48, 206175], [52, 206615], [57, 206855], [62, 207095], [66, 207235], [73, 207995], [77, 208095], [88, 209166], [96, 209351], [98, 209591], [104, 210011], [106, 210391], [109, 210531], [113, 210651], [117, 210831], [120, 210951]]}, {"verse": 37, "start": 211798, "end": 214760, "text": "If I do not the works of my Father, believe me not.", "words": [[0, 211798], [3, 211942], [5, 212102], [8, 212262], [12, 212422], [16, 212602], [22, 212842], [25, 213022], [28, 213182], [36, 213762], [44, 213982], [47, 214262]]}, {"verse": 38, "start": 215110, "end": 223756, "text": "But if I do, though you believe not me, believe the works: that you may know, and believe, that the Father is in me, and I in him.", "words": [[0, 215110], [4, 215213], [7, 215353], [9, 215493], [13, 216093], [20, 216293], [24, 216513], [32, 216793], [36, 217053], [40, 217673], [48, 217993], [52, 218233], [59, 219034], [64, 219151], [68, 219311], [72, 219491], [78, 219851], [82, 220311], [91, 220751], [96, 221046], [100, 221186], [107, 221486], [110, 221846], [113, 222006], [117, 222226], [121, 222606], [123, 223026], [126, 223326]]}, {"verse": 39, "start": 224036, "end": 227787, "text": "Therefore they sought again to take him: but he escaped out of their hand,", "words": [[0, 224036], [10, 224396], [15, 224616], [22, 224896], [28, 225236], [31, 225416], [36, 225676], [41, 226170], [45, 226274], [48, 226394], [56, 226794], [60, 227034], [63, 227174], [69, 227314]]}, {"verse": 40, "start": 228137, "end": 233645, "text": "And went away again beyond Jordan into the place where John at first baptized; and there he stayed.", "words": [[0, 228137], [4, 228280], [9, 228440], [14, 228740], [20, 229060], [27, 229440], [34, 229900], [39, 230200], [43, 230360], [49, 230620], [55, 230840], [60, 231160], [63, 231340], [69, 231520], [79, 232656], [83, 232782], [89, 232942], [92, 233082]]}, {"verse": 41, "start": 233995, "end": 240627, "text": "And many resorted to him, and said, John did no miracle: but all things that John spoke of this man were true.", "words": [[0, 233995], [4, 234150], [9, 234350], [18, 234870], [21, 235090], [26, 235370], [30, 235850], [36, 236580], [41, 236777], [45, 236997], [48, 237217], [57, 238049], [61, 238154], [65, 238374], [72, 238674], [77, 238894], [82, 239114], [88, 239414], [91, 239634], [96, 239814], [100, 240054], [105, 240234]]}, {"verse": 42, "start": 240907, "end": 242694, "text": "And many believed on him there.", "words": [[0, 240907], [4, 241051], [9, 241271], [18, 241631], [21, 241931], [25, 242091]]}]}