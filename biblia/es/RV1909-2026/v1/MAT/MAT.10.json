{"book": "MAT", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 339472, "verses": [{"verse": 1, "start": 300, "end": 12325, "text": "Entonces llamando a sus doce discípulos, les dio autoridad contra los espíritus inmundos, para que los echasen fuera, y sanasen toda enfermedad y toda dolencia.", "words": [[0, 300], [9, 1109], [18, 1669], [20, 1729], [24, 1909], [29, 2309], [41, 3329], [45, 3589], [49, 4049], [59, 4889], [66, 5289], [70, 5549], [80, 6209], [90, 6769], [95, 7389], [99, 7529], [103, 7709], [111, 8309], [118, 8689], [120, 9169], [128, 9649], [133, 9969], [144, 11049], [146, 11209], [151, 11389]]}, {"verse": 2, "start": 12675, "end": 24740, "text": "Y los nombres de los doce apóstoles son estos: el primero, Simón, que es llamado Pedro, y Andrés su hermano; Jacobo, hijo de Zebedeo, y Juan su hermano;", "words": [[0, 12675], [2, 12997], [6, 13137], [14, 13557], [17, 13717], [21, 13947], [26, 14177], [36, 14897], [40, 15217], [47, 15957], [50, 16141], [59, 16521], [66, 17181], [70, 17361], [73, 17541], [81, 17881], [88, 18481], [90, 18901], [97, 19361], [100, 19761], [109, 20682], [117, 21853], [122, 22033], [125, 22543], [134, 23053], [136, 23473], [141, 23773], [144, 24073]]}, {"verse": 3, "start": 25090, "end": 33682, "text": "Felipe, y Bartolomé; Tomás, y Mateo el publicano; Jacobo hijo de Alfeo, y Lebeo, por sobrenombre Tadeo;", "words": [[0, 25090], [8, 25520], [10, 25900], [21, 26951], [28, 27453], [30, 27773], [36, 28233], [39, 28353], [50, 29436], [57, 30242], [62, 30402], [65, 30602], [72, 31122], [74, 31632], [81, 32142], [85, 32242], [97, 33082]]}, {"verse": 4, "start": 34032, "end": 37943, "text": "Simón el cananista y Judas Iscariote, que también le entregó.", "words": [[0, 34032], [6, 34659], [9, 34719], [19, 35399], [21, 35759], [27, 36119], [38, 36479], [42, 36659], [50, 37039], [53, 37279]]}, {"verse": 5, "start": 38293, "end": 50382, "text": "A estos doce envió Jesús, a los cuales dio mandamiento, diciendo: Por el camino de los Gentiles no iréis, y en ciudad de samaritanos no entréis;", "words": [[0, 38293], [2, 38659], [8, 38899], [13, 39719], [19, 40239], [26, 41299], [28, 41499], [32, 41619], [39, 41879], [43, 42419], [56, 43619], [66, 44595], [70, 44717], [73, 44877], [80, 45277], [83, 45417], [87, 45537], [96, 46057], [99, 46357], [106, 47417], [108, 47697], [111, 47837], [118, 48397], [121, 48877], [133, 49357], [136, 49577]]}, {"verse": 6, "start": 50732, "end": 54360, "text": "Pero id antes a las ovejas perdidas de la casa de Israel.", "words": [[0, 50732], [5, 50898], [8, 51198], [14, 51638], [16, 51898], [20, 51998], [27, 52418], [36, 53058], [39, 53238], [42, 53318], [47, 53558], [50, 53778]]}, {"verse": 7, "start": 54710, "end": 60112, "text": "Y yendo, predicad, diciendo: El reino de los cielos se ha acercado.", "words": [[0, 54710], [2, 54874], [9, 55174], [19, 55894], [29, 56992], [32, 57154], [38, 57654], [41, 57754], [45, 57894], [52, 58534], [55, 58754], [58, 58954]]}, {"verse": 8, "start": 60462, "end": 71282, "text": "Sanad enfermos, limpiad leprosos, resucitad muertos, echad fuera demonios: gratis recibisteis, dad gratis.", "words": [[0, 60462], [6, 61027], [16, 62247], [24, 63087], [34, 64087], [44, 65087], [53, 66187], [59, 66587], [65, 67027], [75, 68153], [82, 68882], [95, 70222], [99, 70422]]}, {"verse": 9, "start": 71632, "end": 75141, "text": "No llevéis oro, ni plata, ni cobre en vuestras bolsas;", "words": [[0, 71843], [3, 71923], [11, 72383], [16, 72663], [19, 72903], [26, 73243], [29, 73583], [35, 73923], [38, 74063], [47, 74423]]}, {"verse": 10, "start": 75491, "end": 83868, "text": "Ni bolsa para el camino, ni dos ropas de vestir, ni zapatos, ni bastón; porque el obrero digno es de su alimento.", "words": [[0, 75491], [3, 75635], [9, 76075], [14, 76295], [17, 76455], [25, 77295], [28, 77515], [32, 77755], [38, 78275], [41, 78435], [49, 79135], [52, 79235], [61, 80095], [64, 80175], [72, 81007], [79, 81248], [82, 81468], [89, 81828], [95, 82568], [98, 82768], [101, 82908], [104, 83048]]}, {"verse": 11, "start": 84218, "end": 93282, "text": "Pero en cualquier ciudad o aldea donde entréis, investigad quién sea en ella digno, y reposad allí hasta que salgáis.", "words": [[0, 84218], [5, 84362], [8, 84502], [18, 84842], [25, 85422], [27, 85922], [33, 86462], [39, 86682], [48, 87782], [59, 88642], [65, 88882], [69, 89342], [72, 89622], [77, 89802], [84, 90602], [86, 90762], [94, 91462], [99, 91762], [105, 92302], [109, 92502]]}, {"verse": 12, "start": 93632, "end": 96737, "text": "Y entrando en la casa, saludadla.", "words": [[0, 93632], [2, 93986], [11, 94566], [14, 94766], [17, 94906], [23, 95746]]}, {"verse": 13, "start": 97087, "end": 105371, "text": "Y si la casa es digna, vuestra paz vendrá sobre ella; pero si no es digna, vuestra paz se volverá a vosotros.", "words": [[0, 97087], [2, 97209], [5, 97329], [8, 97489], [13, 97689], [16, 97909], [23, 98809], [31, 99309], [35, 99589], [42, 100329], [48, 100609], [54, 101423], [59, 101570], [62, 101770], [65, 101970], [68, 102110], [75, 102910], [83, 103330], [87, 103630], [90, 104090], [98, 104610], [100, 104690]]}, {"verse": 14, "start": 105721, "end": 115172, "text": "Y cualquiera que no os reciba, ni oiga vuestras palabras, salid de aquella casa o ciudad, y sacudid el polvo de vuestros pies.", "words": [[0, 105721], [2, 105818], [13, 106458], [17, 106638], [20, 106898], [23, 107058], [31, 107618], [34, 107858], [39, 108258], [48, 108698], [58, 109678], [64, 110258], [67, 110518], [75, 110838], [80, 111218], [82, 111478], [90, 111918], [92, 112558], [100, 113358], [103, 113558], [109, 114118], [112, 114238], [121, 114578]]}, {"verse": 15, "start": 115522, "end": 124996, "text": "De cierto os digo, que el castigo será más tolerable a la tierra de los de Sodoma y de los de Gomorra en el día del juicio, que a aquella ciudad.", "words": [[0, 115522], [3, 115750], [10, 116010], [13, 116270], [19, 116490], [23, 116735], [26, 116895], [34, 117595], [39, 117895], [43, 118175], [53, 118975], [55, 119095], [58, 119175], [65, 119555], [68, 119745], [72, 119935], [75, 120115], [82, 120715], [84, 120860], [87, 120980], [91, 121120], [94, 121280], [102, 121900], [105, 122180], [108, 122340], [112, 122620], [116, 122800], [124, 123763], [128, 123845], [130, 123945], [138, 124225]]}, {"verse": 16, "start": 125346, "end": 135410, "text": "He aquí, yo os envío como a ovejas en medio de lobos: sed pues prudentes como serpientes, y sencillos como palomas.", "words": [[0, 125395], [3, 125475], [9, 126355], [12, 126635], [15, 126955], [21, 127535], [26, 127835], [28, 128055], [35, 128575], [38, 128795], [44, 129075], [47, 129295], [54, 130146], [58, 130647], [63, 130967], [73, 131867], [78, 132147], [90, 132907], [92, 133427], [102, 134267], [107, 134527]]}, {"verse": 17, "start": 135760, "end": 142624, "text": "Y guardaos de los hombres: porque os entregarán en tribunales, y en sus sinagogas os azotarán;", "words": [[0, 135760], [2, 135929], [11, 136589], [14, 136789], [18, 136949], [27, 137809], [34, 138071], [37, 138251], [48, 139031], [51, 139171], [63, 139851], [65, 140111], [68, 140271], [72, 140431], [82, 141271], [85, 141511]]}, {"verse": 18, "start": 142974, "end": 150994, "text": "Y aun a príncipes y a reyes seréis llevados por causa de mí, por testimonio a ellos y a los Gentiles.", "words": [[0, 142974], [2, 143008], [6, 143078], [8, 143505], [18, 143931], [20, 144358], [22, 144458], [28, 144898], [35, 145638], [44, 146178], [48, 146418], [54, 146758], [57, 147058], [61, 147678], [65, 147998], [76, 148898], [78, 149078], [84, 149418], [86, 149798], [88, 149918], [92, 150018]]}, {"verse": 19, "start": 151344, "end": 160026, "text": "Pero cuando os entreguen, no os preocupéis por cómo o qué hablaréis; porque en aquella hora os será dado qué habéis de hablar.", "words": [[0, 151344], [5, 151491], [12, 151751], [15, 152031], [26, 152931], [29, 153191], [32, 153331], [43, 154231], [47, 154471], [52, 154911], [54, 155231], [58, 155491], [69, 156693], [76, 157053], [79, 157293], [87, 157533], [92, 157773], [95, 157973], [100, 158313], [105, 158673], [109, 159033], [116, 159413], [119, 159593]]}, {"verse": 20, "start": 160376, "end": 166609, "text": "Porque no sois vosotros los que habláis, sino el Espíritu de vuestro Padre que habla en vosotros.", "words": [[0, 160376], [7, 160597], [10, 160837], [15, 161237], [24, 161797], [28, 162057], [32, 162257], [41, 162897], [46, 163337], [49, 163557], [58, 164217], [61, 164317], [69, 164717], [75, 165197], [79, 165357], [85, 165657], [88, 165817]]}, {"verse": 21, "start": 166959, "end": 175826, "text": "Y el hermano entregará al hermano a la muerte, y el padre al hijo; y los hijos se levantarán contra los padres, y los harán morir.", "words": [[0, 166959], [2, 167108], [5, 167288], [13, 167828], [23, 168508], [26, 168708], [34, 169148], [36, 169208], [39, 169248], [47, 169688], [49, 170168], [52, 170288], [58, 170708], [61, 171128], [67, 171786], [69, 171888], [73, 172048], [79, 172328], [82, 172668], [93, 173348], [100, 173688], [104, 173908], [112, 174368], [114, 174733], [118, 174893], [124, 175253]]}, {"verse": 22, "start": 176176, "end": 182018, "text": "Y seréis aborrecidos de todos por mi nombre; pero el que soporte hasta el fin, este será salvo.", "words": [[0, 176176], [2, 176282], [9, 176662], [21, 177442], [24, 177602], [30, 177822], [34, 178102], [37, 178262], [45, 179200], [50, 179360], [53, 179520], [57, 179620], [65, 180100], [71, 180320], [74, 180480], [79, 180960], [84, 181080], [89, 181400]]}, {"verse": 23, "start": 182368, "end": 195290, "text": "Pero cuando os persigan en esta ciudad, huid a la otra: porque de cierto os digo, que no acabaréis de recorrer todas las ciudades de Israel antes de que venga el Hijo del hombre.", "words": [[0, 182368], [5, 182511], [12, 182851], [15, 183171], [24, 183951], [27, 184291], [32, 184571], [40, 185051], [45, 186151], [47, 186351], [50, 186491], [56, 187300], [63, 187523], [66, 187663], [73, 187923], [76, 188323], [82, 188623], [86, 189023], [89, 189203], [99, 189763], [102, 189923], [111, 190603], [117, 191103], [121, 191643], [130, 192303], [133, 192483], [140, 192943], [146, 193343], [149, 193563], [153, 193663], [159, 194023], [162, 194303], [167, 194603], [171, 194783]]}, {"verse": 24, "start": 195640, "end": 200240, "text": "El discípulo no es más que su maestro, ni el siervo más que su señor.", "words": [[0, 195640], [3, 195788], [13, 196408], [16, 196648], [19, 196788], [23, 196948], [27, 197108], [30, 197288], [39, 198068], [42, 198428], [45, 198568], [52, 199068], [56, 199248], [60, 199408], [63, 199568]]}, {"verse": 25, "start": 200590, "end": 210826, "text": "Le basta al discípulo ser como su maestro, y al siervo como su señor. Si al padre de la familia llamaron Beelzebú, ¿cuánto más a los de su casa?", "words": [[0, 200590], [3, 200739], [9, 201039], [12, 201439], [22, 201959], [26, 202239], [31, 202479], [34, 202679], [43, 203279], [45, 203639], [48, 203779], [55, 204259], [60, 204479], [63, 204679], [70, 205481], [73, 205656], [76, 205836], [82, 206276], [85, 206476], [88, 206616], [96, 207136], [105, 208083], [115, 209031], [123, 209371], [127, 209611], [129, 209751], [133, 209891], [136, 210031], [139, 210171]]}, {"verse": 26, "start": 211176, "end": 219805, "text": "Así que, no los temáis; porque nada hay encubierto, que no haya de ser manifestado; ni oculto, que no haya de saberse.", "words": [[0, 211176], [4, 211494], [9, 211654], [12, 211794], [16, 211934], [24, 212901], [31, 213117], [36, 213557], [40, 213897], [52, 214697], [56, 215217], [59, 215437], [64, 215617], [67, 215857], [71, 216037], [84, 217304], [87, 217542], [95, 218202], [99, 218342], [102, 218562], [107, 218802], [110, 219002]]}, {"verse": 27, "start": 220155, "end": 228181, "text": "Lo que os digo en tinieblas, decidlo en la luz; y lo que oís al oído predicadlo desde las azoteas.", "words": [[0, 220155], [3, 220284], [7, 220424], [10, 220564], [15, 220764], [18, 220964], [29, 221984], [37, 222784], [40, 223044], [43, 223184], [48, 223928], [50, 224162], [53, 224302], [57, 224442], [61, 224822], [64, 225082], [69, 225772], [80, 226462], [86, 226782], [90, 227142]]}, {"verse": 28, "start": 228531, "end": 239198, "text": "Y no temáis a los que matan el cuerpo, pero al alma no pueden matar: temed antes a aquel que puede destruir el alma y el cuerpo en el infierno.", "words": [[0, 228531], [2, 228655], [5, 228775], [12, 229335], [14, 229795], [18, 229915], [22, 230035], [28, 230435], [31, 230575], [39, 231515], [44, 231795], [47, 231935], [52, 232215], [55, 232535], [62, 232875], [69, 233765], [75, 234087], [81, 234607], [83, 235127], [89, 235427], [93, 235547], [99, 235827], [108, 236727], [111, 236907], [116, 237247], [118, 237447], [121, 237607], [128, 238047], [131, 238267], [134, 238367]]}, {"verse": 29, "start": 239548, "end": 246513, "text": "¿No se venden dos pajarillos por una moneda pequeña? Con todo, ni uno de ellos cae a tierra sin vuestro Padre.", "words": [[0, 239548], [4, 239676], [7, 239816], [14, 240116], [18, 240356], [29, 240996], [33, 241276], [37, 241456], [44, 241896], [53, 242935], [57, 243059], [63, 243279], [66, 243539], [70, 243799], [73, 243959], [79, 244319], [83, 244919], [85, 244979], [92, 245259], [96, 245539], [104, 245919]]}, {"verse": 30, "start": 246863, "end": 249784, "text": "Pues aun vuestros cabellos están todos contados.", "words": [[0, 246863], [5, 246987], [9, 247207], [18, 247647], [27, 248207], [33, 248487], [39, 248887]]}, {"verse": 31, "start": 250134, "end": 254586, "text": "Así que, no temáis: más valéis vosotros que muchos pajarillos.", "words": [[0, 250134], [4, 250414], [9, 250574], [12, 250714], [20, 251611], [24, 251938], [31, 252578], [40, 253118], [44, 253318], [51, 253558]]}, {"verse": 32, "start": 254936, "end": 262614, "text": "Cualquiera, pues, que me confiese delante de los hombres, le confesaré yo también delante de mi Padre que está en los cielos.", "words": [[0, 254936], [12, 255556], [18, 256456], [22, 256596], [25, 256716], [34, 257316], [42, 257816], [45, 257956], [49, 258076], [58, 258796], [61, 258856], [71, 259596], [74, 259736], [82, 260056], [90, 260676], [93, 260856], [96, 260996], [102, 261416], [106, 261516], [111, 261696], [114, 261836], [118, 261956]]}, {"verse": 33, "start": 262964, "end": 270164, "text": "Y cualquiera que me niegue delante de los hombres, le negaré yo también delante de mi Padre que está en los cielos.", "words": [[0, 262964], [2, 263068], [13, 263568], [17, 263728], [20, 263888], [27, 264308], [35, 264808], [38, 264968], [42, 265088], [51, 266248], [54, 266508], [61, 266908], [64, 267128], [72, 267428], [80, 268028], [83, 268188], [86, 268328], [92, 268728], [96, 268848], [101, 269048], [104, 269188], [108, 269348]]}, {"verse": 34, "start": 270514, "end": 277208, "text": "No penséis que he venido para traer paz en la tierra: no he venido para traer paz, sino espada.", "words": [[0, 270514], [3, 270640], [11, 271120], [15, 271340], [18, 271440], [25, 271800], [30, 272000], [36, 272420], [40, 272780], [43, 273200], [46, 273360], [54, 274262], [57, 274468], [60, 274568], [67, 274948], [72, 275148], [78, 275568], [83, 276308], [88, 276508]]}, {"verse": 35, "start": 277558, "end": 284206, "text": "Porque he venido para poner al hombre contra su padre, a la hija contra su madre y a la nuera contra su suegra.", "words": [[0, 277670], [7, 277820], [10, 277920], [17, 278200], [22, 278420], [28, 278700], [31, 278920], [38, 279180], [45, 279520], [48, 279760], [55, 280600], [57, 280700], [60, 280800], [65, 281160], [72, 281400], [75, 281640], [81, 282000], [83, 282400], [85, 282480], [88, 282580], [94, 282920], [101, 283240], [104, 283500]]}, {"verse": 36, "start": 284556, "end": 287941, "text": "Y los enemigos del hombre serán los de su casa.", "words": [[0, 284556], [2, 284681], [6, 284801], [15, 285401], [19, 285601], [26, 285921], [32, 286521], [36, 286921], [39, 287081], [42, 287241]]}, {"verse": 37, "start": 288291, "end": 296901, "text": "El que ama padre o madre más que a mí, no es digno de mí; y el que ama hijo o hija más que a mí, no es digno de mí.", "words": [[0, 288291], [3, 288458], [7, 288598], [11, 288838], [17, 289318], [19, 289618], [25, 289958], [29, 290258], [33, 290418], [35, 290538], [39, 290638], [42, 291318], [45, 291478], [51, 291918], [54, 292018], [58, 292505], [60, 292662], [63, 292782], [67, 292962], [71, 293362], [76, 293682], [78, 294022], [83, 294362], [87, 294602], [91, 294842], [93, 294962], [97, 295142], [100, 295802], [103, 295962], [109, 296462], [112, 296562]]}, {"verse": 38, "start": 297251, "end": 302024, "text": "Y el que no toma su cruz, y sigue en pos de mí, no es digno de mí.", "words": [[0, 297251], [2, 297471], [5, 297591], [9, 297711], [12, 297931], [17, 298251], [20, 298471], [26, 298971], [28, 299151], [34, 299511], [37, 299851], [41, 300071], [44, 300271], [48, 300791], [51, 300911], [54, 301091], [60, 301551], [63, 301691]]}, {"verse": 39, "start": 302374, "end": 308821, "text": "El que halla su vida, la perderá; y el que pierde su vida por causa de mí, la hallará.", "words": [[0, 302421], [3, 302501], [7, 302701], [13, 302901], [16, 303201], [22, 303981], [25, 304241], [34, 305294], [36, 305418], [39, 305538], [43, 305678], [50, 306118], [53, 306278], [58, 306558], [62, 306778], [68, 307138], [71, 307418], [75, 307598], [78, 308098]]}, {"verse": 40, "start": 309171, "end": 315916, "text": "El que os recibe a vosotros, a mí recibe; y el que a mí recibe, recibe al que me envió.", "words": [[0, 309171], [3, 309451], [7, 309591], [10, 309731], [17, 310251], [19, 310331], [29, 310851], [31, 311151], [34, 311650], [42, 312328], [44, 312506], [47, 312606], [51, 312866], [53, 313026], [56, 313326], [64, 314291], [71, 314691], [74, 314831], [78, 315031], [81, 315231]]}, {"verse": 41, "start": 316266, "end": 328561, "text": "El que recibe profeta en nombre de profeta, recompensa de profeta recibirá; y el que recibe justo en nombre de justo, recompensa de justo recibirá.", "words": [[0, 316266], [3, 316536], [7, 316676], [14, 317196], [22, 317816], [25, 317976], [32, 318396], [35, 318596], [44, 319716], [55, 320796], [58, 320996], [66, 321636], [76, 322729], [78, 322894], [81, 323014], [85, 323214], [92, 323834], [98, 324124], [101, 324414], [108, 324774], [111, 325014], [118, 325954], [129, 327034], [132, 327234], [138, 327554]]}, {"verse": 42, "start": 328911, "end": 339072, "text": "Y cualquiera que dé a uno de estos pequeñitos un vaso de agua fría solamente, por ser discípulo, de cierto os digo, que no perderá su recompensa.", "words": [[0, 328911], [2, 329052], [13, 329672], [17, 329872], [20, 330072], [22, 330312], [26, 330572], [29, 330772], [35, 330992], [46, 331752], [49, 331992], [54, 332392], [57, 332512], [62, 332712], [67, 333152], [78, 333552], [82, 333972], [86, 334212], [97, 335352], [100, 335472], [107, 335892], [110, 336332], [116, 336692], [120, 336927], [123, 337107], [131, 337667], [134, 337847]]}]}