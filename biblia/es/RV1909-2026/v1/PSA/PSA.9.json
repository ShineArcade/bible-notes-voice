{"book": "PSA", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 141843, "verses": [{"verse": 1, "start": 300, "end": 10652, "text": "Al Músico principal: sobre Mut-laben: Salmo de David. TE alabaré, oh Jehová, con todo mi corazón; contaré todas tus maravillas.", "words": [[0, 300], [3, 484], [10, 984], [21, 2145], [27, 2868], [38, 3864], [44, 4410], [47, 4550], [54, 5476], [57, 5582], [66, 5972], [69, 6362], [77, 6822], [81, 7122], [86, 7442], [89, 7702], [98, 8746], [106, 9150], [112, 9450], [116, 9770]]}, {"verse": 2, "start": 11102, "end": 16939, "text": "Me alegraré y me regocijaré en ti: cantaré a tu nombre, oh Altísimo;", "words": [[0, 11102], [3, 11422], [12, 12042], [14, 12302], [17, 12462], [28, 13402], [31, 13622], [35, 14683], [43, 14889], [45, 15096], [48, 15296], [56, 15656], [59, 16016]]}, {"verse": 3, "start": 17389, "end": 22545, "text": "Por haber sido mis enemigos vueltos atrás: caerán y perecerán delante de ti.", "words": [[0, 17389], [4, 17533], [10, 17713], [15, 18053], [19, 18233], [28, 18733], [36, 19213], [43, 20152], [50, 20755], [52, 20935], [62, 21555], [70, 22015], [73, 22195]]}, {"verse": 4, "start": 22995, "end": 28721, "text": "Porque has hecho mi juicio y mi causa: te sentaste en silla juzgando justicia.", "words": [[0, 22995], [7, 23157], [11, 23397], [17, 23617], [20, 23817], [27, 24357], [29, 24657], [32, 24777], [39, 25741], [42, 25846], [51, 26446], [54, 26726], [60, 27126], [69, 27806]]}, {"verse": 5, "start": 29171, "end": 35845, "text": "Reprendiste a las naciones, destruiste al malo, borraste el nombre de ellos para siempre.", "words": [[0, 29548], [12, 29958], [14, 30098], [18, 30218], [28, 31498], [39, 32098], [42, 32278], [48, 33008], [57, 33738], [60, 33838], [67, 34218], [70, 34498], [76, 34758], [81, 35058]]}, {"verse": 6, "start": 36295, "end": 44425, "text": "Oh enemigo, acabados son para siempre los asolamientos; y las ciudades que derribaste, su memoria pereció con