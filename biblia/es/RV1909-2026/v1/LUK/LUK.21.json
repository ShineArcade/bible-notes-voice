{"book": "LUK", "chapter": 21, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 290759, "verses": [{"verse": 1, "start": 300, "end": 4858, "text": "Y mirando, vio a los ricos que echaban sus ofrendas en la caja de las ofrendas.", "words": [[0, 300], [2, 438], [11, 898], [15, 1238], [17, 1358], [21, 1478], [27, 1838], [31, 2018], [39, 2378], [43, 2558], [52, 3178], [55, 3318], [58, 3458], [63, 3818], [66, 3938], [70, 4058]]}, {"verse": 2, "start": 5208, "end": 11293, "text": "Y vio también una viuda pobrecilla, que echaba allí dos monedas de poco valor.", "words": [[0, 5402], [2, 5502], [6, 5762], [14, 6142], [18, 6622], [24, 7022], [36, 7902], [40, 8342], [47, 8882], [52, 9182], [56, 9602], [64, 10362], [67, 10462], [72, 10722]]}, {"verse": 3, "start": 11643, "end": 16266, "text": "Y dijo: De verdad os digo, que esta pobre viuda echó más que todos:", "words": [[0, 11643], [2, 11787], [8, 12476], [11, 12624], [18, 12844], [21, 13084], [27, 13944], [31, 14144], [36, 14304], [42, 14611], [48, 14917], [53, 15224], [57, 15404], [61, 15564]]}, {"verse": 4, "start": 16616, "end": 24847, "text": "Porque todos estos, de lo que les sobra echaron para las ofrendas de Dios; pero esta de su pobreza echó todo el sustento que tenía.", "words": [[0, 16616], [7, 16822], [13, 17122], [20, 17542], [23, 17802], [26, 17922], [30, 18042], [34, 18322], [40, 18602], [48, 19062], [53, 19302], [57, 19502], [66, 20082], [69, 20202], [75, 20980], [80, 21121], [85, 21361], [88, 21561], [91, 21721], [99, 22221], [104, 22721], [109, 23181], [112, 23421], [121, 23941], [125, 24161]]}, {"verse": 5, "start": 25197, "end": 30844, "text": "Y a unos que decían del templo, que estaba adornado de hermosas piedras y dones, dijo:", "words": [[0, 25197], [2, 25304], [4, 25424], [9, 25644], [13, 25904], [20, 26404], [24, 26624], [32, 27284], [36, 27364], [43, 27664], [52, 28524], [55, 28684], [64, 29224], [72, 29724], [74, 29884], [81, 30284]]}, {"verse": 6, "start": 31194, "end": 37495, "text": "Estas cosas que veis, días vendrán que no quedará piedra sobre piedra que no sea destruida.", "words": [[0, 31194], [6, 31638], [12, 31998], [16, 32258], [22, 32718], [27, 33238], [35, 33898], [39, 34058], [42, 34218], [50, 34658], [57, 35198], [63, 35498], [70, 36038], [74, 36158], [77, 36318], [81, 36558]]}, {"verse": 7, "start": 37845, "end": 45151, "text": "Y le preguntaron, diciendo: Maestro, ¿cuándo será esto? ¿y qué señal habrá cuando estas cosas hayan de comenzar a ser hechas?", "words": [[0, 37845], [2, 37952], [5, 38032], [18, 38712], [28, 39647], [37, 40326], [45, 40626], [50, 40806], [56, 41569], [59, 41671], [63, 41791], [69, 42271], [75, 42571], [82, 42711], [88, 43031], [94, 43391], [100, 43791], [103, 43851], [112, 44371], [114, 44451], [118, 44631]]}, {"verse": 8, "start": 45431, "end": 57637, "text": "Él entonces dijo: Mirad, no seáis engañados; porque vendrán muchos en mi nombre, diciendo: Yo soy; y, El tiempo está cerca: por tanto, no vayáis en pos de ellos.", "words": [[0, 45431], [3, 45676], [12, 46136], [18, 47405], [25, 47725], [28, 47905], [34, 48085], [45, 49493], [52, 49709], [60, 50189], [67, 50529], [70, 50789], [73, 50949], [81, 51289], [91, 52310], [94, 52514], [99, 53193], [102, 53338], [105, 53458], [112, 53858], [117, 54098], [124, 55028], [128, 55134], [135, 55794], [138, 56054], [145, 56534], [148, 56704], [152, 56874], [155, 57114]]}, {"verse": 9, "start": 57987, "end": 68077, "text": "Pero cuando oigáis guerras y sediciones, no os espantéis; porque es necesario que estas cosas acontezcan primero; pero el fin no será inmediatamente.", "words": [[0, 57987], [5, 58135], [12, 58435], [19, 59075], [27, 59595], [29, 59755], [41, 60915], [44, 61115], [47, 61335], [58, 62506], [65, 62754], [68, 62874], [78, 63474], [82, 63654], [88, 63834], [94, 64134], [105, 64914], [114, 65785], [119, 65949], [122, 66049], [126, 66249], [129, 66449], [134, 66689]]}, {"verse": 10, "start": 68427, "end": 74392, "text": "Entonces les dijo: Se levantará nación contra nación, y reino contra reino;", "words": [[0, 68427], [9, 68904], [13, 69424], [19, 70174], [22, 70337], [32, 70857], [39, 71257], [46, 71617], [54, 72157], [56, 72707], [62, 73257], [69, 73847]]}, {"verse": 11, "start": 74742, "end": 83515, "text": "Y habrá grandes terremotos, y en varios lugares hambrunas y epidemias: y habrá espantos y grandes señales del cielo.", "words": [[0, 74742], [2, 74870], [8, 75210], [16, 75490], [28, 76450], [30, 76730], [33, 76870], [40, 77150], [48, 77590], [58, 78750], [60, 78990], [71, 80332], [73, 80412], [79, 80672], [88, 81472], [90, 81652], [98, 81972], [106, 82692], [110, 82912]]}, {"verse": 12, "start": 83865, "end": 96634, "text": "Pero antes de todas estas cosas os echarán mano, y perseguirán, entregándoos a las sinagogas y a las cárceles, siendo llevados a los reyes y a los gobernadores por causa de mi nombre.", "words": [[0, 83865], [5, 84007], [11, 84347], [14, 84547], [20, 84787], [26, 85147], [32, 85607], [35, 85807], [43, 86327], [49, 86767], [51, 86932], [64, 88052], [77, 89172], [79, 89352], [83, 89472], [93, 90332], [95, 90472], [97, 90532], [101, 90652], [111, 91717], [118, 92157], [127, 92757], [129, 92917], [133, 93057], [139, 93657], [141, 93957], [143, 94037], [147, 94157], [160, 94917], [164, 95217], [170, 95617], [173, 95917], [176, 96037]]}, {"verse": 13, "start": 96984, "end": 99129, "text": "Y os será para testimonio.", "words": [[0, 97043], [2, 97143], [5, 97243], [10, 97743], [15, 98023]]}, {"verse": 14, "start": 99479, "end": 104109, "text": "Poned pues en vuestros corazones no pensar antes cómo habéis de responder:", "words": [[0, 99606], [6, 99766], [11, 100006], [14, 100226], [23, 100586], [33, 101346], [36, 101826], [43, 102166], [49, 102566], [54, 102906], [61, 103246], [64, 103386]]}, {"verse": 15, "start": 104459, "end": 112123, "text": "Porque yo os daré boca y sabiduría, a la cual no podrán resistir ni contradecir todos los que se os opondrán.", "words": [[0, 104459], [7, 104682], [10, 104832], [13, 104982], [18, 105422], [23, 105682], [25, 105882], [36, 106642], [38, 107082], [41, 107122], [46, 107342], [49, 107542], [56, 107982], [65, 108532], [68, 109082], [80, 109982], [86, 110622], [90, 110942], [94, 111102], [97, 111282], [100, 111382]]}, {"verse": 16, "start": 112473, "end": 120767, "text": "Pero seréis entregados aun de vuestros padres, y hermanos, y parientes, y amigos; y matarán a algunos de vosotros.", "words": [[0, 112473], [5, 112638], [12, 113138], [23, 113878], [27, 114098], [30, 114278], [39, 114558], [47, 114978], [49, 115398], [59, 116118], [61, 116298], [72, 116958], [74, 117298], [82, 118267], [84, 118388], [92, 119048], [94, 119228], [102, 119588], [105, 119828]]}, {"verse": 17, "start": 121117, "end": 124574, "text": "Y seréis aborrecidos de todos por causa de mi nombre.", "words": [[0, 121117], [2, 121223], [9, 121623], [21, 122423], [24, 122583], [30, 122903], [34, 123243], [40, 123563], [43, 123843], [46, 123943]]}, {"verse": 18, "start": 124924, "end": 127781, "text": "Pero un pelo de vuestra cabeza no perecerá.", "words": [[0, 124924], [5, 125067], [8, 125247], [13, 125667], [16, 125927], [24, 126287], [31, 126667], [34, 127252]]}, {"verse": 19, "start": 128131, "end": 131237, "text": "En vuestra paciencia poseeréis vuestras almas.", "words": [[0, 128131], [3, 128433], [11, 128753], [21, 129413], [31, 130173], [40, 130593]]}, {"verse": 20, "start": 131587, "end": 138777, "text": "Y cuando veáis a Jerusalén rodeada de ejércitos, sabed entonces que su destrucción ha llegado.", "words": [[0, 131587], [2, 131692], [9, 131952], [15, 132512], [17, 132672], [27, 133392], [35, 134012], [38, 134232], [49, 135392], [55, 135872], [64, 136272], [68, 136712], [71, 136952], [83, 137812], [86, 138032]]}, {"verse": 21, "start": 139127, "end": 149864, "text": "Entonces los que estén en Judea, huyan a los montes; y los que estén en la ciudad, salgan; y los que estén en los campos, no entren en ella.", "words": [[0, 139127], [9, 139754], [13, 140279], [17, 140459], [23, 140819], [26, 140959], [33, 141519], [39, 141959], [41, 142179], [45, 142319], [53, 143292], [55, 143371], [59, 143491], [63, 143631], [69, 143911], [72, 144011], [75, 144091], [83, 144842], [91, 145761], [93, 145882], [97, 146022], [101, 146222], [107, 146562], [110, 146662], [114, 146802], [122, 147882], [125, 148322], [132, 148942], [135, 149322]]}, {"verse": 22, "start": 150214, "end": 156344, "text": "Porque estos son días de venganza: para que se cumplan todas las cosas que están escritas.", "words": [[0, 150214], [7, 150438], [13, 150758], [17, 151118], [22, 151418], [25, 151618], [35, 152709], [40, 152877], [44, 153017], [47, 153177], [55, 153737], [61, 154217], [65, 154597], [71, 154997], [75, 155197], [81, 155437]]}, {"verse": 23, "start": 156694, "end": 166818, "text": "Pero ¡ay de las embarazadas, y de las que amamantan en aquellos días! porque habrá gran angustia sobre la tierra e ira en este pueblo.", "words": [[0, 156694], [5, 157029], [9, 157399], [12, 157704], [16, 157864], [29, 158844], [31, 159169], [34, 159289], [38, 159469], [42, 159689], [52, 160769], [55, 160889], [64, 161169], [70, 162270], [77, 162476], [83, 162936], [88, 163336], [97, 164236], [103, 164476], [106, 164696], [113, 165136], [115, 165476], [119, 165876], [122, 166016], [127, 166196]]}, {"verse": 24, "start": 167168, "end": 179655, "text": "Y caerán a filo de espada, y serán llevados cautivos a todas las naciones: y Jerusalén será pisoteada por los gentiles, hasta que los tiempos de los gentiles sean cumplidos.", "words": [[0, 167168], [2, 167305], [9, 167865], [11, 167925], [16, 168305], [19, 168425], [27, 169025], [29, 169685], [35, 170005], [44, 170425], [53, 171045], [55, 171225], [61, 171525], [65, 171805], [75, 172879], [77, 173006], [87, 173786], [92, 174166], [102, 174906], [106, 175146], [110, 175306], [120, 176026], [126, 176526], [130, 176746], [134, 176886], [142, 177406], [145, 177506], [149, 177606], [158, 178186], [163, 178586]]}, {"verse": 25, "start": 180005, "end": 192243, "text": "Entonces habrá señales en el sol, y en la luna, y en las estrellas; y en la tierra angustia de gentes por la confusión del sonido del mar y de las olas:", "words": [[0, 180005], [9, 180487], [15, 181107], [23, 181747], [26, 181947], [29, 182107], [34, 183067], [36, 183107], [39, 183267], [42, 183427], [48, 184387], [50, 184427], [53, 184567], [57, 184747], [68, 186021], [70, 186431], [73, 186531], [76, 186671], [83, 187051], [92, 187931], [95, 188051], [102, 188511], [106, 188751], [109, 188871], [119, 189691], [123, 189931], [130, 190491], [134, 190691], [138, 191031], [140, 191271], [143, 191391], [147, 191531]]}, {"verse": 26, "start": 192593, "end": 204050, "text": "Desfalleciendo los hombres a causa del temor y expectación de las cosas que sobrevendrán al mundo: porque las potencias de los cielos serán conmovidas.", "words": [[0, 192593], [15, 193681], [19, 193921], [27, 194341], [29, 194581], [35, 194861], [39, 195181], [45, 195861], [47, 196161], [59, 197141], [62, 197361], [66, 197521], [72, 198001], [76, 198541], [89, 199441], [92, 199561], [99, 200364], [106, 200546], [110, 200766], [120, 201426], [123, 201606], [127, 201726], [134, 202346], [140, 202946]]}, {"verse": 27, "start": 204400, "end": 210889, "text": "Y entonces verán al Hijo del hombre, que vendrá en una nube con poder y majestad grande.", "words": [[0, 204400], [2, 204525], [11, 204925], [17, 205685], [20, 205945], [25, 206205], [29, 206365], [37, 206885], [41, 207485], [48, 207945], [51, 208065], [55, 208245], [60, 208645], [64, 208885], [70, 209345], [72, 209645], [81, 210185]]}, {"verse": 28, "start": 211239, "end": 219212, "text": "Y cuando estas cosas comiencen a hacerse, mirad, y levantad vuestras cabezas, porque vuestra redención está cerca.", "words": [[0, 211239], [2, 211324], [9, 211524], [15, 211784], [21, 212124], [31, 212784], [33, 212924], [42, 213484], [49, 214044], [51, 214714], [60, 215384], [69, 215824], [78, 216644], [85, 217064], [93, 217674], [103, 218284], [108, 218544]]}, {"verse": 29, "start": 219562, "end": 223540, "text": "Y les dijo una parábola: Mirad la higuera y todos los árboles:", "words": [[0, 219562], [2, 219690], [6, 219810], [11, 220070], [15, 220310], [25, 221380], [31, 221580], [34, 221700], [42, 222200], [44, 222360], [50, 222540], [54, 222800]]}, {"verse": 30, "start": 223890, "end": 228978, "text": "Cuando ya brotan, viéndolo, de vosotros mismos entendéis que el verano está ya cerca.", "words": [[0, 223960], [7, 224050], [10, 224270], [18, 224950], [28, 225430], [31, 225670], [40, 226090], [47, 226710], [57, 227230], [61, 227450], [64, 227570], [71, 227970], [76, 228180], [79, 228390]]}, {"verse": 31, "start": 229328, "end": 235684, "text": "Así también vosotros, cuando veáis que suceden estas cosas, sabed que está cerca el reino de Dios.", "words": [[0, 229328], [4, 229552], [12, 229892], [22, 230572], [29, 230732], [35, 231212], [39, 231392], [47, 232012], [53, 232232], [60, 233232], [66, 233652], [70, 233832], [75, 233992], [81, 234352], [84, 234612], [90, 235012], [93, 235172]]}, {"verse": 32, "start": 236034, "end": 241053, "text": "De cierto os digo, que no pasará esta generación hasta que todo sea hecho.", "words": [[0, 236034], [3, 236182], [10, 236802], [13, 236882], [19, 237082], [23, 237262], [26, 237462], [33, 237942], [38, 238282], [49, 239102], [55, 239662], [59, 239902], [64, 240122], [68, 240442]]}, {"verse": 33, "start": 241403, "end": 245971, "text": "El cielo y la tierra pasarán; pero mis palabras no pasarán.", "words": [[0, 241403], [3, 241545], [9, 241965], [11, 242245], [14, 242365], [21, 242645], [30, 243861], [35, 243985], [39, 244165], [48, 244605], [51, 245125]]}, {"verse": 34, "start": 246321, "end": 258770, "text": "Y mirad por vosotros, que vuestros corazones no sean cargados de glotonería y embriaguez, y de las preocupaciones de esta vida, y venga de repente sobre vosotros aquel día.", "words": [[0, 246321], [2, 246485], [8, 246885], [12, 247105], [22, 247725], [26, 248205], [35, 248605], [45, 249165], [48, 249385], [53, 249705], [62, 250325], [65, 250815], [76, 251305], [78, 251805], [90, 252305], [92, 252785], [95, 253158], [99, 253532], [114, 253905], [117, 254085], [122, 254325], [128, 255305], [130, 255565], [136, 255905], [139, 256045], [147, 256465], [153, 257005], [162, 257825], [168, 258265]]}, {"verse": 35, "start": 259120, "end": 265965, "text": "Porque como un lazo vendrá sobre todos los que habitan sobre la faz de toda la tierra.", "words": [[0, 259120], [7, 259362], [12, 259722], [15, 259922], [20, 260382], [27, 260882], [33, 261222], [39, 261742], [43, 262382], [47, 262602], [55, 263182], [61, 263482], [64, 263702], [68, 264102], [71, 264702], [76, 264962], [79, 265222]]}, {"verse": 36, "start": 266315, "end": 277845, "text": "Velad pues, orando en todo tiempo, que seáis tenidos por dignos de evitar todas estas cosas que han de venir, y de estar en pie delante del Hijo del hombre.", "words": [[0, 266315], [6, 266920], [12, 267460], [19, 268080], [22, 268280], [27, 268460], [35, 269600], [39, 269820], [45, 270280], [53, 270840], [57, 271120], [64, 271720], [67, 271860], [74, 272200], [80, 272740], [86, 273200], [92, 273640], [96, 273860], [100, 274000], [103, 274100], [110, 274440], [112, 274900], [115, 275060], [121, 275340], [124, 275580], [128, 275940], [136, 276540], [140, 276780], [145, 277040], [149, 277240]]}, {"verse": 37, "start": 278195, "end": 285208, "text": "Y enseñaba de día en el templo; y de noche saliendo, se estaba en el monte que se llama de los Olivos.", "words": [[0, 278195], [2, 278376], [11, 279116], [14, 279276], [18, 279516], [21, 279676], [24, 279796], [32, 280674], [34, 280800], [37, 280900], [43, 281120], [53, 281880], [56, 282420], [63, 282720], [66, 282880], [69, 283020], [75, 283340], [79, 283600], [82, 283720], [88, 284020], [91, 284180], [95, 284300]]}, {"verse": 38, "start": 285558, "end": 290359, "text": "Y todo el pueblo venía a él por la mañana, para oírle en el templo.", "words": [[0, 285558], [2, 285683], [7, 285943], [10, 286163], [17, 286483], [23, 287023], [25, 287303], [28, 287483], [32, 287703], [35, 287883], [43, 288343], [48, 288708], [54, 289408], [57, 289608], [60, 289748]]}]}