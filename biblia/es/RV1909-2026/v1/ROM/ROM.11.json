{"book": "ROM", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 267685, "verses": [{"verse": 1, "start": 300, "end": 9998, "text": "Digo pues: ¿Ha desechado Dios a su pueblo? En ninguna manera. Porque también yo soy israelita, de la descendencia de Abraham, de la tribu de Benjamín.", "words": [[0, 300], [5, 576], [11, 1286], [15, 1428], [25, 1968], [30, 2228], [32, 2408], [35, 2528], [43, 3352], [46, 3496], [54, 3816], [62, 4671], [69, 4875], [77, 5255], [80, 5475], [84, 5675], [95, 6395], [98, 6795], [101, 6895], [114, 7735], [117, 7875], [126, 8735], [129, 8755], [132, 8875], [138, 9215], [141, 9315]]}, {"verse": 2, "start": 10348, "end": 19148, "text": "No ha desechado Dios a su pueblo, al cual antes conoció. ¿O no sabéis qué dice de Elías la Escritura? cómo hablando con Dios contra Israel dice:", "words": [[0, 10348], [3, 10491], [6, 10611], [16, 11151], [21, 11391], [23, 11571], [26, 11691], [34, 12411], [37, 12531], [42, 12691], [48, 13071], [57, 13959], [60, 14065], [63, 14145], [70, 14585], [74, 14745], [79, 15045], [82, 15205], [88, 15625], [91, 15745], [102, 16633], [107, 17013], [116, 17333], [120, 17613], [125, 17793], [132, 18133], [139, 18693]]}, {"verse": 3, "start": 19498, "end": 26539, "text": "Señor, han dado muerte a tus profetas, y tus altares han derribado; y yo he quedado solo, y procuran matarme.", "words": [[0, 19498], [7, 19841], [11, 20201], [16, 20421], [23, 20761], [25, 20961], [29, 21081], [39, 21661], [41, 22101], [45, 22261], [53, 22861], [57, 23081], [68, 24009], [70, 24131], [73, 24291], [76, 24431], [84, 24791], [90, 25111], [92, 25391], [101, 25871]]}, {"verse": 4, "start": 26889, "end": 34691, "text": "Pero ¿qué le dice la divina respuesta? He dejado para mí siete mil hombres, que no han doblado la rodilla delante de Baal.", "words": [[0, 26889], [5, 27052], [10, 27292], [13, 27432], [18, 27672], [21, 27832], [28, 28172], [39, 29129], [42, 29254], [49, 29774], [54, 29994], [57, 30254], [63, 30574], [67, 30914], [76, 31834], [80, 31934], [83, 32134], [87, 32294], [95, 32734], [98, 32854], [106, 33334], [114, 33834], [117, 33974]]}, {"verse": 5, "start": 34911, "end": 39400, "text": "Así también, aun en este tiempo ha quedado un remanente por la elección de gracia.", "words": [[0, 34911], [4, 35175], [13, 35775], [17, 35895], [20, 36075], [25, 36255], [32, 36795], [35, 36855], [43, 37275], [46, 37415], [56, 37935], [60, 38175], [63, 38295], [72, 38695], [75, 38835]]}, {"verse": 6, "start": 39750, "end": 49407, "text": "Y si por gracia, luego no por las obras; de otra manera la gracia ya no es gracia. Y si por las obras, ya no es gracia; de otra manera la obra ya no es obra.", "words": [[0, 39750], [2, 39856], [5, 39956], [9, 40156], [17, 40576], [23, 40756], [26, 41016], [30, 41216], [34, 41376], [41, 42178], [44, 42280], [49, 42440], [56, 42940], [59, 43020], [66, 43460], [69, 43600], [72, 43780], [75, 43940], [83, 44703], [85, 44802], [88, 44902], [92, 45122], [96, 45282], [103, 45882], [106, 46122], [109, 46262], [112, 46422], [120, 47257], [123, 47376], [128, 47536], [135, 48076], [138, 48156], [143, 48416], [146, 48636], [149, 48796], [152, 48976]]}, {"verse": 7, "start": 49757, "end": 57222, "text": "¿Qué pues? Lo que buscaba Israel aquello no ha alcanzado; pero la elección lo ha alcanzado: y los demás fueron endurecidos;", "words": [[0, 49757], [5, 49880], [11, 50638], [14, 50739], [18, 50839], [26, 51199], [33, 51599], [41, 51999], [44, 52119], [47, 52179], [58, 53077], [63, 53199], [66, 53359], [75, 53799], [78, 53959], [81, 54079], [92, 55158], [94, 55263], [98, 55403], [104, 55743], [111, 56488]]}, {"verse": 8, "start": 57572, "end": 65622, "text": "Como está escrito: Les dio Dios espíritu de aturdimiento, ojos con que no vean, y oídos con que no oigan, hasta el día de hoy.", "words": [[0, 57572], [5, 57749], [10, 57989], [19, 58845], [23, 58971], [27, 59231], [32, 59531], [41, 60151], [44, 60251], [58, 61331], [63, 61631], [67, 61891], [71, 62011], [74, 62171], [80, 62791], [82, 63091], [88, 63531], [92, 63711], [96, 63851], [99, 64031], [106, 64451], [112, 64771], [115, 64931], [119, 65111], [122, 65271]]}, {"verse": 9, "start": 65972, "end": 71116, "text": "Y David dice: Les sea vuelta su mesa en lazo, y en red, y en tropezadero, y en paga:", "words": [[0, 65972], [2, 66121], [8, 66361], [14, 67217], [18, 67287], [22, 67527], [29, 67807], [32, 68047], [37, 68287], [40, 68427], [46, 68847], [48, 69007], [51, 69157], [56, 69307], [58, 69627], [61, 69747], [74, 70387], [76, 70567], [79, 70687]]}, {"verse": 10, "start": 71466, "end": 76097, "text": "Sus ojos sean obscurecidos para que no vean, y agóbiales siempre el espinazo.", "words": [[0, 71466], [4, 71605], [9, 71885], [14, 72165], [27, 72925], [32, 73225], [36, 73385], [39, 73525], [45, 73985], [47, 74205], [57, 74865], [65, 75165], [68, 75385]]}, {"verse": 11, "start": 76447, "end": 86181, "text": "Digo pues: ¿Han tropezado para que cayesen? En ninguna manera; pero por el tropiezo de ellos vino la salvación a los Gentiles, para que fuesen provocados a celos.", "words": [[0, 76447], [5, 76705], [11, 77454], [16, 77612], [26, 78212], [31, 78432], [35, 78872], [44, 79488], [47, 79625], [55, 79905], [63, 80720], [68, 80842], [72, 81129], [75, 81415], [84, 81702], [87, 81842], [93, 82122], [98, 82402], [101, 82582], [111, 83102], [113, 83202], [117, 83302], [127, 84082], [132, 84382], [136, 84522], [143, 84862], [154, 85482], [156, 85642]]}, {"verse": 12, "start": 86531, "end": 93879, "text": "Y si la falta de ellos es la riqueza del mundo, y el menoscabo de ellos la riqueza de los Gentiles, ¿cuánto más la plenitud de ellos?", "words": [[0, 86531], [2, 86639], [5, 86719], [8, 86859], [14, 87119], [17, 87339], [23, 87539], [26, 87759], [29, 87919], [37, 88319], [41, 88499], [48, 88899], [50, 89184], [53, 89304], [63, 89844], [66, 90004], [72, 90224], [75, 90384], [83, 90804], [86, 90924], [90, 91044], [100, 92024], [108, 92424], [112, 92584], [115, 92764], [124, 93204], [127, 93404]]}, {"verse": 13, "start": 94229, "end": 100970, "text": "Porque a vosotros hablo, Gentiles. Por cuanto pues, yo soy apóstol de los Gentiles, mi ministerio honro,", "words": [[0, 94229], [7, 94411], [9, 94531], [18, 94911], [25, 95331], [35, 96469], [39, 96635], [46, 96975], [52, 97675], [55, 97775], [59, 97935], [67, 98575], [70, 98655], [74, 98775], [84, 99735], [87, 99835], [98, 100475]]}, {"verse": 14, "start": 101320, "end": 106307, "text": "Por si en alguna manera provocase a celos a mi carne, e hiciese salvos a algunos de ellos.", "words": [[0, 101320], [4, 101457], [7, 101617], [10, 101697], [17, 101897], [24, 102337], [34, 102997], [36, 103197], [42, 103497], [44, 103597], [47, 103677], [54, 104037], [56, 104437], [64, 104817], [71, 105297], [73, 105437], [81, 105697], [84, 105937]]}, {"verse": 15, "start": 106657, "end": 113877, "text": "Porque si el rechazo de ellos es la reconciliación del mundo, ¿qué será el recibimiento de ellos, sino vida de los muertos?", "words": [[0, 106657], [7, 106852], [10, 107052], [13, 107192], [21, 107692], [24, 107872], [30, 108112], [33, 108372], [36, 108532], [51, 109372], [55, 109572], [62, 110432], [67, 110552], [72, 110852], [75, 111012], [88, 111672], [91, 111872], [98, 112352], [103, 112612], [108, 112892], [111, 113052], [115, 113172]]}, {"verse": 16, "start": 114227, "end": 120740, "text": "Y si el primer fruto es santo, también lo es el todo, y si la raíz es santa, también lo son las ramas.", "words": [[0, 114227], [2, 114354], [5, 114474], [8, 114574], [15, 114834], [21, 115274], [24, 115474], [31, 116194], [39, 116514], [42, 116754], [45, 116934], [48, 117054], [54, 117814], [56, 117894], [59, 118014], [62, 118174], [67, 118534], [70, 118674], [77, 119489], [85, 119569], [88, 119749], [92, 119969], [96, 120109]]}, {"verse": 17, "start": 121090, "end": 131847, "text": "Que si algunas de las ramas fueron quebradas, y tú, siendo olivo silvestre, has sido injertado en lugar de ellas, y has sido hecho participante de la raíz y del rico alimento del olivo;", "words": [[0, 121090], [4, 121164], [7, 121304], [15, 121604], [18, 121824], [22, 121984], [28, 122404], [35, 122644], [46, 123304], [48, 123544], [52, 124224], [59, 124504], [65, 124984], [76, 125464], [80, 125944], [85, 126204], [95, 126844], [98, 126944], [104, 127124], [107, 127384], [114, 128044], [116, 128134], [120, 128264], [125, 128464], [131, 128724], [144, 129544], [147, 129704], [150, 129824], [155, 130264], [157, 130424], [161, 130564], [166, 130804], [175, 131204], [179, 131424]]}, {"verse": 18, "start": 132197, "end": 138667, "text": "No te jactes contra las ramas; y si te jactas, sabe que no sustentas tú a la raíz, sino la raíz a ti.", "words": [[0, 132197], [3, 132302], [6, 132442], [13, 132882], [20, 133102], [24, 133342], [31, 134122], [33, 134224], [36, 134344], [39, 134484], [47, 135304], [52, 135644], [56, 135804], [59, 135924], [69, 136504], [72, 136684], [74, 136804], [77, 136884], [83, 137314], [88, 137744], [91, 137864], [96, 138224], [98, 138384]]}, {"verse": 19, "start": 139017, "end": 142544, "text": "Pues las ramas, dirás, fueron quebradas para que yo fuese injertado.", "words": [[0, 139017], [5, 139105], [9, 139285], [16, 139785], [23, 140285], [30, 140445], [40, 141005], [45, 141285], [49, 141445], [52, 141585], [58, 141825]]}, {"verse": 20, "start": 142894, "end": 149651, "text": "Bien: por su incredulidad fueron quebradas, pero tú por la fe estás en pie. No te ensoberbezcas, antes teme,", "words": [[0, 142894], [6, 143499], [10, 143606], [13, 143766], [26, 144446], [33, 144706], [44, 145686], [49, 145906], [52, 146086], [56, 146326], [59, 146466], [62, 146646], [68, 146886], [71, 147106], [76, 147714], [79, 148040], [82, 148400], [97, 148760], [103, 149080]]}, {"verse": 21, "start": 150001, "end": 155315, "text": "Que si Dios no libró del corte a las ramas naturales, puede que tampoco te libre a ti.", "words": [[0, 150040], [4, 150100], [7, 150260], [12, 150520], [15, 150880], [21, 151300], [25, 151420], [31, 151920], [33, 152000], [37, 152140], [43, 152500], [54, 153520], [60, 153840], [64, 154060], [72, 154360], [75, 154620], [81, 154880], [83, 155100]]}, {"verse": 22, "start": 155665, "end": 167585, "text": "Mira, pues, la bondad y la severidad de Dios: la severidad ciertamente en los que cayeron; pero la bondad para contigo, si permaneces en esa bondad; pues de otra manera tú también serás cortado.", "words": [[0, 155665], [6, 155865], [12, 156145], [15, 156665], [22, 157265], [24, 157385], [27, 157485], [37, 158065], [40, 158205], [46, 158946], [49, 159052], [59, 159692], [71, 160432], [74, 160552], [78, 160652], [82, 160812], [91, 161580], [96, 161718], [99, 161858], [106, 162198], [111, 162358], [120, 162978], [123, 163378], [134, 164018], [137, 164198], [141, 164338], [149, 165151], [154, 165258], [157, 165438], [162, 165618], [169, 166138], [172, 166238], [180, 166498], [186, 166958]]}, {"verse": 23, "start": 167935, "end": 174573, "text": "Y aun ellos, si no permanecen en incredulidad, serán injertados; que poderoso es Dios para volverlos a injertar.", "words": [[0, 167935], [2, 168056], [6, 168196], [13, 168596], [16, 168756], [19, 168836], [30, 169456], [33, 169536], [47, 170516], [53, 170776], [65, 171869], [69, 171949], [78, 172529], [81, 172669], [86, 172929], [91, 173289], [101, 173809], [103, 173949]]}, {"verse": 24, "start": 174923, "end": 188773, "text": "Porque si tú fuiste cortado de un olivo silvestre, al que por naturaleza pertenecías, y contra lo natural fuiste injertado en el buen olivo, ¿cuánto más estos, que son las ramas naturales, serán injertados en su propio olivo?", "words": [[0, 174923], [7, 175150], [10, 175350], [13, 175510], [20, 175870], [28, 176430], [31, 176570], [34, 176730], [40, 177010], [51, 178110], [54, 178230], [58, 178370], [62, 178590], [73, 179270], [86, 180110], [88, 180390], [95, 180690], [98, 180850], [106, 181270], [113, 181690], [123, 182330], [126, 182450], [129, 182570], [134, 182750], [141, 183650], [149, 184030], [153, 184190], [160, 185042], [164, 185123], [168, 185283], [172, 185463], [178, 185803], [189, 186683], [195, 187123], [206, 187703], [209, 187843], [212, 187983], [219, 188243]]}, {"verse": 25, "start": 189123, "end": 201151, "text": "Porque no quiero, hermanos, que ignoréis este misterio, para que no seáis acerca de vosotros mismos arrogantes: que el endurecimiento en parte ha acontecido en Israel, hasta que haya entrado la plenitud de los Gentiles;", "words": [[0, 189123], [7, 189306], [10, 189446], [18, 189666], [28, 190286], [32, 190426], [41, 190906], [46, 191106], [56, 191766], [61, 192166], [65, 192326], [68, 192526], [74, 192726], [81, 193166], [84, 193386], [93, 193786], [100, 194046], [112, 195201], [116, 195302], [119, 195422], [134, 196202], [137, 196322], [143, 196682], [146, 196982], [157, 197662], [160, 197762], [168, 198182], [174, 198822], [178, 199022], [183, 199202], [191, 199602], [194, 199722], [203, 200142], [206, 200282], [210, 200382]]}, {"verse": 26, "start": 201501, "end": 208640, "text": "Y así todo Israel será salvo; como está escrito: Vendrá de Sion el Libertador, que quitará de Jacob la impiedad;", "words": [[0, 201501], [2, 201582], [6, 201762], [11, 202002], [18, 202402], [23, 202682], [30, 203457], [35, 203621], [40, 203841], [49, 204627], [56, 204878], [59, 205164], [64, 205451], [67, 205591], [79, 206251], [83, 206651], [91, 207091], [94, 207211], [100, 207491], [103, 207771]]}, {"verse": 27, "start": 208990, "end": 213049, "text": "Y este es mi pacto con ellos, cuando yo quite sus pecados.", "words": [[0, 208990], [2, 209151], [7, 209391], [10, 209571], [13, 209691], [19, 210171], [23, 210331], [30, 211071], [37, 211311], [40, 211591], [46, 211871], [50, 212051]]}, {"verse": 28, "start": 213269, "end": 221409, "text": "Así que, cuanto al evangelio, son enemigos por causa de vosotros: pero cuanto a la elección, son muy amados por causa de los padres.", "words": [[0, 213269], [4, 213511], [9, 213691], [16, 213991], [19, 214211], [30, 214951], [34, 215271], [43, 215931], [47, 216231], [53, 216531], [56, 216771], [66, 217646], [71, 217808], [78, 218048], [80, 218268], [83, 218328], [93, 219088], [97, 219328], [101, 219568], [108, 219968], [112, 220188], [118, 220468], [121, 220688], [125, 220808]]}, {"verse": 29, "start": 221759, "end": 224807, "text": "Porque irrevocables son los dones y el llamado de Dios.", "words": [[0, 221759], [7, 221979], [20, 222679], [24, 222899], [28, 223059], [34, 223519], [36, 223699], [39, 223799], [47, 224099], [50, 224319]]}, {"verse": 30, "start": 225157, "end": 233369, "text": "Porque como también vosotros en algún tiempo no creísteis a Dios, pero ahora habéis alcanzado misericordia por la incredulidad de ellos;", "words": [[0, 225157], [7, 225381], [12, 225641], [20, 226021], [29, 226581], [32, 226761], [38, 226981], [45, 227361], [48, 227641], [58, 228321], [60, 228421], [66, 229081], [71, 229401], [77, 229701], [84, 230061], [94, 230741], [107, 231581], [111, 231761], [114, 231881], [127, 232641], [130, 232841]]}, {"verse": 31, "start": 233719, "end": 241080, "text": "Así también estos ahora no han creído, para que, por la misericordia para con vosotros, ellos también alcancen misericordia.", "words": [[0, 233719], [4, 233939], [12, 234359], [18, 234659], [24, 235019], [27, 235239], [31, 235379], [39, 235859], [44, 236439], [49, 236599], [53, 236799], [56, 236919], [69, 237739], [74, 237939], [78, 238179], [88, 238739], [94, 239259], [102, 239599], [111, 240159]]}, {"verse": 32, "start": 241430, "end": 246011, "text": "Porque Dios encerró a todos en incredulidad, para tener misericordia de todos.", "words": [[0, 241430], [7, 241611], [12, 241911], [20, 242531], [22, 242631], [28, 242851], [31, 243111], [45, 243871], [50, 244431], [56, 244691], [69, 245491], [72, 245591]]}, {"verse": 33, "start": 246361, "end": 254376, "text": "¡Oh profundidad de las riquezas de la sabiduría y del conocimiento de Dios! ¡Cuán incomprensibles son sus juicios, e inescrutables sus caminos!", "words": [[0, 246398], [4, 246478], [16, 247118], [19, 247258], [23, 247378], [32, 247858], [35, 248018], [38, 248138], [48, 248778], [50, 248898], [54, 249018], [67, 249678], [70, 249858], [76, 250640], [82, 250823], [98, 251583], [102, 251823], [106, 252023], [115, 252563], [117, 252763], [131, 253503], [135, 253703]]}, {"verse": 34, "start": 254726, "end": 258374, "text": "Porque ¿quién entendió la mente del Señor? ¿o quién fue su consejero?", "words": [[0, 254726], [7, 254893], [14, 255113], [23, 255633], [26, 255753], [32, 255973], [36, 256173], [43, 257000], [46, 257085], [52, 257225], [56, 257445], [59, 257565]]}, {"verse": 35, "start": 258724, "end": 261467, "text": "¿O quién le dio a él primero, para que le sea pagado?", "words": [[0, 258724], [3, 258828], [9, 259028], [12, 259228], [16, 259428], [18, 259548], [21, 259668], [30, 260068], [35, 260388], [39, 260538], [42, 260688], [46, 260848]]}, {"verse": 36, "start": 261817, "end": 267285, "text": "Porque de él, y por él, y en él, son todas las cosas. A él sea gloria por siglos. Amén.", "words": [[0, 261817], [7, 261994], [10, 262234], [14, 262414], [16, 262534], [20, 262714], [24, 262914], [26, 263114], [29, 263274], [33, 263454], [37, 263714], [43, 263954], [47, 264194], [54, 264998], [56, 265127], [59, 265287], [63, 265487], [70, 265927], [74, 266087], [82, 266867]]}]}