{"book": "JHN", "chapter": 4, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 350178, "verses": [{"verse": 1, "start": 300, "end": 6697, "text": "When therefore the Lord knew how the Pharisees had heard that Jesus made and baptized more disciples than John,", "words": [[0, 300], [5, 430], [15, 870], [19, 1130], [24, 1370], [29, 1670], [33, 1910], [37, 2070], [47, 2790], [51, 2950], [57, 3190], [62, 3390], [68, 3670], [73, 4170], [77, 4370], [86, 4750], [91, 5230], [101, 5750], [106, 6110]]}, {"verse": 2, "start": 7047, "end": 10742, "text": "(Though Jesus himself baptized not, but his disciples,)", "words": [[0, 7047], [8, 7234], [14, 7574], [22, 8134], [31, 8654], [36, 9294], [40, 9694], [44, 9874]]}, {"verse": 3, "start": 11092, "end": 13876, "text": "He left Judæa, and departed again into Galilee.", "words": [[0, 11092], [3, 11162], [8, 11582], [15, 12002], [19, 12162], [28, 12542], [34, 12922], [39, 13122]]}, {"verse": 4, "start": 14226, "end": 16166, "text": "And he must needs go through Samaria.", "words": [[0, 14226], [4, 14354], [7, 14434], [12, 14594], [18, 14954], [21, 15214], [29, 15434]]}, {"verse": 5, "start": 16516, "end": 24234, "text": "Then comes he to a city of Samaria, which is called Sychar, near to the parcel of ground that Jacob gave to his son Joseph.", "words": [[0, 16516], [5, 16734], [11, 17094], [14, 17294], [17, 17494], [19, 17634], [24, 17874], [27, 18054], [36, 19114], [42, 19134], [45, 19274], [52, 19904], [60, 20534], [65, 20794], [68, 20974], [72, 21054], [79, 21414], [82, 21634], [89, 22034], [94, 22374], [100, 22674], [105, 23034], [108, 23234], [112, 23394], [116, 23634]]}, {"verse": 6, "start": 24584, "end": 32585, "text": "Now Jacob’s well was there. Jesus therefore, being wearied with his journey, sat thus on the well: and it was about the sixth hour.", "words": [[0, 24584], [4, 24791], [12, 25331], [17, 25571], [21, 25851], [28, 26517], [34, 26917], [45, 27437], [51, 27637], [59, 28157], [64, 28337], [68, 28477], [77, 29397], [81, 29637], [86, 29897], [89, 30157], [93, 30277], [99, 30943], [103, 31069], [106, 31149], [110, 31329], [116, 31549], [120, 31749], [126, 31989]]}, {"verse": 7, "start": 32935, "end": 37980, "text": "There comes a woman of Samaria to draw water: Jesus says to her, Give me to drink.", "words": [[0, 32935], [6, 33097], [12, 33357], [14, 33517], [20, 33737], [23, 33937], [31, 34477], [34, 34697], [39, 34937], [46, 35740], [52, 36000], [57, 36300], [60, 36500], [65, 37050], [70, 37195], [73, 37375], [76, 37495]]}, {"verse": 8, "start": 38260, "end": 41452, "text": "(For his disciples were gone away to the city to buy food.)", "words": [[0, 38260], [5, 38378], [9, 38518], [19, 39038], [24, 39298], [29, 39558], [34, 39858], [37, 40058], [41, 40178], [46, 40438], [49, 40638], [53, 40878]]}, {"verse": 9, "start": 41802, "end": 52091, "text": "Then says the woman of Samaria to him, How is it that you, being a Jew, ask drink of me, which am a woman of Samaria? for the Jews have no dealings with the Samaritans.", "words": [[0, 41802], [5, 42026], [10, 42306], [14, 42526], [20, 42766], [23, 42926], [31, 43426], [34, 43626], [39, 44439], [43, 44639], [46, 44839], [49, 44959], [54, 45079], [59, 45439], [65, 45579], [67, 45759], [72, 46439], [76, 46919], [82, 47059], [85, 47239], [89, 47759], [95, 48039], [98, 48099], [100, 48179], [106, 48359], [109, 48499], [118, 49497], [122, 49586], [126, 49686], [131, 49906], [136, 50246], [139, 50486], [148, 50986], [153, 51106], [157, 51206]]}, {"verse": 10, "start": 52371, "end": 61398, "text": "Jesus answered and said to her, If you knew the gift of God, and who it is that says to you, Give me to drink; you would have asked of him, and he would have given you living water.", "words": [[0, 52371], [6, 52616], [15, 53136], [19, 53376], [24, 53556], [27, 53736], [32, 54237], [35, 54362], [39, 54482], [44, 54702], [48, 54862], [53, 55102], [56, 55262], [61, 55622], [65, 56102], [69, 56282], [72, 56402], [75, 56582], [80, 56762], [85, 56962], [88, 57182], [93, 57250], [98, 57318], [101, 57386], [104, 57454], [111, 58548], [115, 58682], [121, 58822], [126, 58902], [132, 59182], [135, 59322], [140, 59682], [144, 59862], [147, 60002], [153, 60122], [158, 60222], [164, 60422], [168, 60622], [175, 60862]]}, {"verse": 11, "start": 61678, "end": 69900, "text": "The woman says to him, Sir, you have nothing to draw with, and the well is deep: from where then have you that living water?", "words": [[0, 61678], [4, 61798], [10, 61978], [15, 62278], [18, 62498], [23, 63081], [28, 63481], [32, 63621], [37, 63921], [45, 64321], [48, 64541], [53, 64821], [59, 65561], [63, 65761], [67, 65901], [72, 66201], [75, 66581], [81, 67354], [86, 67501], [92, 67781], [97, 68041], [102, 68381], [106, 68521], [111, 68761], [118, 69001]]}, {"verse": 12, "start": 70250, "end": 77447, "text": "Are you greater than our father Jacob, which gave us the well, and drank of it himself, and his children, and his cattle?", "words": [[0, 70250], [4, 70410], [8, 70690], [16, 71030], [21, 71350], [25, 71510], [32, 71810], [39, 72750], [45, 72970], [50, 73190], [53, 73390], [57, 73550], [63, 73830], [67, 74140], [73, 74450], [76, 74630], [79, 74750], [88, 75170], [92, 75650], [96, 75810], [106, 76250], [110, 76750], [114, 76910]]}, {"verse": 13, "start": 77727, "end": 81910, "text": "Jesus answered and said to her, Whoever drinks of this water shall thirst again:", "words": [[0, 77727], [6, 77971], [15, 78491], [19, 78731], [24, 78911], [27, 79091], [32, 79592], [40, 79827], [47, 80187], [50, 80367], [55, 80547], [61, 80827], [67, 81047], [74, 81327]]}, {"verse": 14, "start": 82260, "end": 91534, "text": "But whoever drinks of the water that I shall give him shall never thirst; but the water that I shall give him shall be in him a well of water springing up into everlasting life.", "words": [[0, 82260], [4, 82356], [12, 82576], [19, 82956], [22, 83116], [26, 83216], [32, 83456], [37, 83636], [39, 83776], [45, 83936], [50, 84176], [54, 84356], [60, 84556], [66, 84796], [74, 85655], [78, 85725], [82, 85865], [88, 86125], [93, 86345], [95, 86505], [101, 86665], [106, 86885], [110, 87165], [116, 87625], [119, 87845], [122, 88045], [126, 88245], [128, 88465], [133, 88685], [136, 88865], [142, 89125], [152, 89665], [155, 89845], [160, 90265], [172, 90785]]}, {"verse": 15, "start": 91814, "end": 97913, "text": "The woman says to him, Sir, give me this water, that I thirst not, neither come here to draw.", "words": [[0, 91814], [4, 91934], [10, 92114], [15, 92414], [18, 92634], [23, 93216], [28, 93696], [33, 93976], [36, 94176], [41, 94416], [48, 95116], [53, 95336], [55, 95496], [62, 95736], [67, 96456], [75, 96656], [80, 96996], [85, 97196], [88, 97356]]}, {"verse": 16, "start": 98193, "end": 101532, "text": "Jesus says to her, Go, call your husband, and come here.", "words": [[0, 98193], [6, 98433], [11, 98773], [14, 98993], [19, 99546], [23, 99663], [28, 99903], [33, 100063], [42, 100383], [46, 100883], [51, 101103]]}, {"verse": 17, "start": 101812, "end": 108859, "text": "The woman answered and said, I have no husband. Jesus said to her, You have well said, I have no husband:", "words": [[0, 101812], [4, 101907], [10, 102127], [19, 102607], [23, 102887], [29, 103539], [31, 103817], [36, 104057], [39, 104357], [48, 105429], [54, 105698], [59, 106038], [62, 106258], [67, 106735], [71, 106857], [76, 107017], [81, 107217], [87, 107677], [89, 107857], [94, 108077], [97, 108257]]}, {"verse": 18, "start": 109209, "end": 114966, "text": "For you have had five husbands; and he whom you now have is not your husband: in that did you say truly.", "words": [[0, 109209], [4, 109297], [8, 109437], [13, 109577], [17, 109757], [22, 110037], [32, 110986], [36, 111109], [39, 111309], [44, 111489], [48, 111669], [52, 111849], [57, 112149], [60, 112329], [64, 112529], [69, 112689], [78, 113493], [81, 113636], [86, 113976], [90, 114036], [94, 114176], [98, 114376]]}, {"verse": 19, "start": 115246, "end": 119874, "text": "The woman says to him, Sir, I perceive that you are a prophet.", "words": [[0, 115246], [4, 115366], [10, 115546], [15, 115846], [18, 116066], [23, 116648], [28, 117553], [30, 117753], [39, 118173], [44, 118553], [48, 118833], [52, 119133], [54, 119213]]}, {"verse": 20, "start": 120154, "end": 126330, "text": "Our fathers worshipped in this mountain; and you say, that in Jerusalem is the place where men ought to worship.", "words": [[0, 120154], [4, 120280], [12, 120860], [23, 121440], [26, 121560], [31, 121740], [41, 122526], [45, 122643], [49, 122783], [54, 123083], [59, 123523], [62, 123683], [72, 124183], [75, 124463], [79, 124583], [85, 124863], [91, 125103], [95, 125363], [101, 125643], [104, 125843]]}, {"verse": 21, "start": 126680, "end": 134953, "text": "Jesus says to her, Woman, believe me, the hour comes, when you shall neither in this mountain, nor yet at Jerusalem, worship the Father.", "words": [[0, 126680], [6, 126918], [11, 127238], [14, 127458], [19, 127999], [26, 128436], [34, 128556], [38, 129396], [42, 129496], [47, 129756], [54, 130216], [59, 130776], [63, 130916], [69, 131076], [77, 131336], [80, 131536], [85, 131676], [95, 132036], [99, 132596], [103, 132876], [106, 133096], [117, 133616], [125, 134176], [129, 134436]]}, {"verse": 22, "start": 135303, "end": 140734, "text": "You worship you know not what: we know what we worship: for salvation is of the Jews.", "words": [[0, 135303], [4, 135423], [12, 135963], [16, 136023], [21, 136203], [25, 136403], [31, 137089], [34, 137234], [39, 137514], [44, 137814], [47, 137974], [56, 138748], [60, 138899], [70, 139339], [73, 139899], [76, 140039], [80, 140159]]}, {"verse": 23, "start": 141084, "end": 149387, "text": "But the hour comes, and now is, when the true worshippers shall worship the Father in spirit and in truth: for the Father seeks such to worship him.", "words": [[0, 141084], [4, 141183], [8, 141323], [13, 141523], [20, 142223], [24, 142483], [28, 142743], [32, 143303], [37, 143543], [41, 143663], [46, 143903], [58, 144463], [64, 144743], [72, 145123], [76, 145303], [83, 145523], [86, 145743], [93, 146103], [97, 146603], [100, 146723], [107, 147358], [111, 147448], [115, 147547], [122, 147788], [128, 148128], [133, 148407], [136, 148608], [144, 148848]]}, {"verse": 24, "start": 149737, "end": 155493, "text": "God is a Spirit: and they that worship him must worship him in spirit and in truth.", "words": [[0, 149737], [4, 150093], [7, 150473], [9, 150613], [17, 151462], [21, 151626], [26, 151866], [31, 152106], [39, 152466], [43, 152846], [48, 153126], [56, 153566], [60, 153906], [63, 154166], [70, 154586], [74, 154906], [77, 155026]]}, {"verse": 25, "start": 155773, "end": 163113, "text": "The woman says to him, I know that Messias comes, which is called Christ: when he is come, he will tell us all things.", "words": [[0, 155773], [4, 155893], [10, 156073], [15, 156373], [18, 156593], [23, 157175], [25, 157295], [30, 157455], [35, 157865], [43, 158275], [50, 158735], [56, 158935], [59, 159075], [66, 159335], [74, 160456], [79, 160583], [82, 160773], [85, 160963], [91, 161483], [94, 161563], [99, 161703], [104, 161923], [107, 162143], [111, 162363]]}, {"verse": 26, "start": 163393, "end": 166630, "text": "Jesus says to her, I that speak to you am he.", "words": [[0, 163393], [6, 163633], [11, 163973], [14, 164193], [19, 164746], [21, 164990], [26, 165210], [32, 165450], [35, 165690], [39, 165970], [42, 166290]]}, {"verse": 27, "start": 166910, "end": 175998, "text": "¶ And upon this came his disciples, and marvelled that he talked with the woman: yet no man said, What do you seek? or, Why do you talk with her?", "words": [[2, 166910], [6, 167083], [11, 167323], [16, 167723], [21, 168083], [25, 168323], [36, 169343], [40, 169763], [50, 170183], [55, 170303], [58, 170443], [65, 170723], [70, 170963], [74, 171103], [81, 171816], [85, 171966], [88, 172246], [92, 172486], [98, 173266], [103, 173506], [106, 173706], [110, 173806], [116, 174562], [120, 174687], [124, 174907], [127, 175067], [131, 175147], [136, 175407], [141, 175667]]}, {"verse": 28, "start": 176348, "end": 181019, "text": "The woman then left her waterpot, and went her way into the city, and says to the men,", "words": [[0, 176348], [4, 176442], [10, 176682], [15, 176942], [20, 177202], [24, 177562], [34, 177922], [38, 178182], [43, 178382], [47, 178562], [51, 178762], [56, 178982], [60, 179162], [66, 179442], [70, 179982], [75, 180202], [78, 180442], [82, 180562]]}, {"verse": 29, "start": 181219, "end": 186731, "text": "Come, see a man, which told me all things that ever I did: is not this the Christ?", "words": [[0, 181219], [6, 181399], [10, 181679], [12, 181819], [17, 182119], [23, 182539], [28, 182899], [31, 183099], [35, 183359], [42, 183719], [47, 183999], [52, 184279], [54, 184499], [59, 185138], [62, 185304], [66, 185564], [71, 185884], [75, 186064]]}, {"verse": 30, "start": 187011, "end": 189841, "text": "Then they went out of the city, and came to him.", "words": [[0, 187011], [5, 187294], [10, 187554], [15, 187754], [19, 188014], [22, 188154], [26, 188274], [32, 188574], [36, 189034], [41, 189334], [44, 189574]]}, {"verse": 31, "start": 190191, "end": 193955, "text": "¶ In the mean while his disciples prayed him, saying, Master, eat.", "words": [[2, 190191], [5, 190335], [9, 190455], [14, 190695], [20, 190995], [24, 191175], [34, 191675], [41, 192055], [46, 192515], [54, 193196], [62, 193600]]}, {"verse": 32, "start": 194235, "end": 197592, "text": "But he said to them, I have food to eat that you know not of.", "words": [[0, 194235], [4, 194363], [7, 194443], [12, 194643], [15, 194843], [21, 195361], [23, 195502], [28, 195722], [33, 196002], [36, 196222], [40, 196462], [45, 196682], [49, 196862], [54, 197042], [58, 197242]]}, {"verse": 33, "start": 197872, "end": 202789, "text": "Therefore said the disciples one to another, Has any man brought him anything to eat?", "words": [[0, 197872], [10, 198232], [15, 198592], [19, 198772], [29, 199272], [33, 199672], [36, 199912], [45, 200629], [49, 200814], [53, 201054], [57, 201354], [65, 201594], [69, 201794], [78, 202114], [81, 202374]]}, {"verse": 34, "start": 203069, "end": 208101, "text": "Jesus says to them, My food is to do the will of him that sent me, and to finish his work.", "words": [[0, 203069], [6, 203353], [11, 203693], [14, 203933], [20, 204540], [23, 204703], [28, 204983], [31, 205143], [34, 205283], [37, 205403], [41, 205523], [46, 205703], [49, 205863], [53, 206023], [58, 206223], [63, 206463], [67, 206703], [71, 207003], [74, 207143], [81, 207383], [85, 207623]]}, {"verse": 35, "start": 208451, "end": 218753, "text": "Say not you, There are yet four months, and then comes harvest? behold, I say to you, Lift up your eyes, and look on the fields; for they are white already to harvest.", "words": [[0, 208451], [4, 208656], [8, 208856], [13, 209216], [19, 209316], [23, 209416], [27, 209616], [32, 209896], [40, 210556], [44, 210716], [49, 210836], [55, 211076], [64, 211988], [72, 212506], [74, 212586], [78, 212826], [81, 213006], [86, 213646], [91, 213906], [94, 214186], [99, 214326], [105, 214746], [109, 215206], [114, 215386], [117, 215546], [121, 215686], [129, 216557], [133, 216644], [138, 216824], [142, 216964], [148, 217284], [156, 217864], [159, 218124]]}, {"verse": 36, "start": 219103, "end": 226602, "text": "And he that reaps receives wages, and gathers fruit to life eternal: that both he that sows and he that reaps may rejoice together.", "words": [[0, 219103], [4, 219245], [7, 219405], [12, 219625], [18, 220025], [27, 220465], [34, 220965], [38, 221445], [46, 221785], [52, 222105], [55, 222285], [60, 222505], [69, 223293], [74, 223417], [79, 223657], [82, 223877], [87, 224057], [92, 224477], [96, 224697], [99, 224817], [104, 224997], [110, 225337], [114, 225557], [122, 225937]]}, {"verse": 37, "start": 226952, "end": 230624, "text": "And herein is that saying true, One sows, and another reaps.", "words": [[0, 226952], [4, 227164], [11, 227414], [14, 227594], [19, 227774], [26, 228134], [32, 228414], [36, 228754], [42, 229234], [46, 229654], [54, 229934]]}, {"verse": 38, "start": 230974, "end": 237491, "text": "I sent you to reap that on which you bestowed no labour: other men laboured, and you are entered into their labours.", "words": [[0, 230974], [2, 231099], [7, 231359], [11, 231539], [14, 231679], [19, 231919], [24, 232159], [27, 232379], [33, 232579], [37, 232759], [46, 233279], [49, 233739], [57, 234405], [63, 234604], [67, 235054], [77, 235504], [81, 235724], [85, 235864], [89, 235984], [97, 236324], [102, 236704], [108, 237124]]}, {"verse": 39, "start": 237771, "end": 245916, "text": "¶ And many of the Samaritans of that city believed on him for the saying of the woman, which testified, He told me all that ever I did.", "words": [[2, 237771], [6, 237916], [11, 238176], [14, 238336], [18, 238456], [29, 239116], [32, 239236], [37, 239416], [42, 239716], [51, 240116], [54, 240436], [58, 240636], [62, 240836], [66, 240956], [73, 241276], [76, 241456], [80, 241596], [87, 242436], [93, 242616], [104, 243791], [107, 243891], [112, 244111], [115, 244311], [119, 244631], [124, 244871], [129, 245171], [131, 245431]]}, {"verse": 40, "start": 246196, "end": 252868, "text": "So when the Samaritans were come to him, they besought him that he would stay with them: and he stayed there two days.", "words": [[0, 246196], [3, 246316], [8, 246516], [12, 246656], [23, 247296], [28, 247436], [33, 247736], [36, 247956], [41, 248576], [46, 248736], [55, 249176], [59, 249396], [64, 249576], [67, 249676], [73, 249856], [78, 250156], [83, 250436], [89, 251067], [93, 251234], [96, 251354], [103, 251614], [109, 251974], [113, 252214]]}, {"verse": 41, "start": 253218, "end": 256038, "text": "And many more believed because of his own word;", "words": [[0, 253218], [4, 253380], [9, 253620], [14, 253900], [23, 254340], [31, 254820], [34, 255040], [38, 255180], [42, 255380]]}, {"verse": 42, "start": 256388, "end": 265483, "text": "And said to the woman, Now we believe, not because of your saying: for we have heard him ourselves, and know that this is indeed the Christ, the Saviour of the world.", "words": [[0, 256388], [4, 256509], [9, 256829], [12, 257089], [16, 257209], [23, 257915], [27, 258192], [30, 258412], [39, 258792], [43, 259132], [51, 259492], [54, 259712], [59, 259832], [67, 260565], [71, 260635], [74, 260795], [79, 260935], [85, 261215], [89, 261355], [100, 261875], [104, 262455], [109, 262735], [114, 262935], [119, 263135], [122, 263255], [129, 263555], [133, 263775], [141, 264295], [145, 264485], [153, 264675], [156, 264895], [160, 265015]]}, {"verse": 43, "start": 265763, "end": 269849, "text": "¶ Now after two days he departed from there, and went into Galilee.", "words": [[2, 265763], [6, 265934], [12, 266234], [16, 266514], [21, 266874], [24, 267054], [33, 267474], [38, 267834], [45, 268154], [49, 268439], [54, 268659], [59, 268959]]}, {"verse": 44, "start": 270199, "end": 274679, "text": "For Jesus himself testified, that a prophet has no honour in his own country.", "words": [[0, 270199], [4, 270306], [10, 270606], [18, 271086], [29, 271726], [34, 272166], [36, 272266], [44, 272626], [48, 272926], [51, 273226], [58, 273526], [61, 273746], [65, 273906], [69, 274046]]}, {"verse": 45, "start": 275029, "end": 283413, "text": "Then when he was come into Galilee, the Galilæans received him, having seen all the things that he did at Jerusalem at the feast: for they also went to the feast.", "words": [[0, 275029], [5, 275209], [10, 275369], [13, 275509], [17, 275709], [22, 275909], [27, 276109], [36, 276769], [40, 277099], [50, 277429], [59, 277829], [64, 278509], [71, 278689], [76, 279009], [80, 279309], [84, 279489], [91, 279729], [96, 279949], [99, 280049], [103, 280269], [106, 280369], [116, 280789], [119, 281049], [123, 281149], [130, 281862], [134, 281952], [139, 282092], [144, 282352], [149, 282632], [152, 282792], [156, 282892]]}, {"verse": 46, "start": 283763, "end": 292070, "text": "So Jesus came again into Cana of Galilee, where he made the water wine. And there was a certain nobleman, whose son was sick at Capernaum.", "words": [[0, 283763], [3, 283883], [9, 284203], [14, 284583], [20, 284923], [25, 285143], [30, 285683], [33, 285823], [42, 286823], [48, 286983], [51, 287143], [56, 287343], [60, 287483], [66, 287723], [72, 288453], [76, 288579], [82, 288679], [86, 288839], [88, 288999], [96, 289219], [106, 289879], [112, 290099], [116, 290459], [120, 290639], [125, 290979], [128, 291179]]}, {"verse": 47, "start": 292420, "end": 301402, "text": "When he heard that Jesus was come out of Judæa into Galilee, he went to him, and besought him that he would come down, and heal his son: for he was at the point of death.", "words": [[0, 292420], [5, 292526], [8, 292646], [14, 292886], [19, 293066], [25, 293367], [29, 293646], [34, 293826], [38, 294006], [41, 294287], [47, 294566], [52, 294686], [61, 295766], [64, 295826], [69, 296047], [72, 296227], [77, 296446], [81, 296706], [90, 297126], [94, 297346], [99, 297646], [102, 297746], [108, 297846], [113, 298047], [119, 298367], [123, 298706], [128, 298906], [132, 299126], [137, 299822], [141, 299962], [144, 300162], [148, 300382], [151, 300542], [155, 300682], [161, 300922], [164, 301082]]}, {"verse": 48, "start": 301752, "end": 306874, "text": "Then said Jesus to him, Unless you see signs and wonders, you will not believe.", "words": [[0, 301752], [5, 301957], [10, 302237], [16, 302577], [19, 302897], [24, 303397], [31, 303645], [35, 303865], [39, 304085], [45, 304485], [49, 304725], [58, 305625], [62, 305785], [67, 305925], [71, 306145]]}, {"verse": 49, "start": 307154, "end": 312201, "text": "The nobleman says to him, Sir, come down before my child die.", "words": [[0, 307154], [4, 307241], [13, 307781], [18, 308041], [21, 308281], [26, 309249], [31, 309864], [36, 310044], [41, 310284], [48, 310564], [51, 310804], [57, 311064]]}, {"verse": 50, "start": 312481, "end": 321510, "text": "Jesus says to him, Go your way; your son lives. And the man believed the word that Jesus had spoken to him, and he went his way.", "words": [[0, 312481], [6, 312736], [11, 313096], [14, 313336], [19, 314611], [22, 314751], [27, 314931], [32, 315653], [37, 315753], [41, 316033], [48, 316963], [52, 317091], [56, 317191], [60, 317431], [69, 317831], [73, 318071], [78, 318331], [83, 318531], [89, 318851], [93, 319151], [100, 319531], [103, 319811], [108, 320251], [112, 320431], [115, 320571], [120, 320771], [124, 320991]]}, {"verse": 51, "start": 321860, "end": 327238, "text": "And as he was now going down, his servants met him, and told him, saying, Your son lives.", "words": [[0, 321860], [4, 322001], [7, 322201], [10, 322321], [14, 322501], [18, 322701], [24, 323001], [30, 323661], [34, 323761], [43, 324121], [47, 324461], [52, 324661], [56, 324821], [61, 325061], [66, 325381], [74, 326155], [79, 326288], [83, 326588]]}, {"verse": 52, "start": 327518, "end": 335084, "text": "Then enquired he of them the hour when he began to amend. And they said to him, Yesterday at the seventh hour the fever left him.", "words": [[0, 327518], [5, 327908], [14, 328298], [17, 328458], [20, 328638], [25, 328818], [29, 329038], [34, 329358], [39, 329638], [42, 329778], [48, 330078], [51, 330278], [58, 331076], [62, 331204], [67, 331344], [72, 331584], [75, 331804], [80, 332314], [90, 332578], [93, 332998], [97, 333098], [105, 333378], [110, 334078], [114, 334158], [120, 334458], [125, 334758]]}, {"verse": 53, "start": 335364, "end": 343782, "text": "So the father knew that it was at the same hour, in which Jesus said to him, Your son lives: and himself believed, and his whole house.", "words": [[0, 335364], [3, 335484], [7, 335624], [14, 335924], [19, 336284], [24, 336564], [27, 336664], [31, 336804], [34, 336944], [38, 337044], [43, 337324], [49, 337644], [52, 338164], [58, 338344], [64, 338684], [69, 339084], [72, 339284], [77, 339784], [82, 339964], [86, 340244], [93, 341185], [97, 341327], [105, 341667], [115, 342217], [119, 342767], [123, 342927], [129, 343167]]}, {"verse": 54, "start": 344132, "end": 349778, "text": "This is again the second miracle that Jesus did, when he was come out of Judæa into Galilee.", "words": [[0, 344132], [5, 344374], [8, 344534], [14, 344774], [18, 344994], [25, 345254], [33, 345734], [38, 345974], [44, 346234], [49, 346674], [54, 347354], [57, 347474], [61, 347614], [66, 347834], [70, 348034], [73, 348394], [79, 348754], [84, 348974]]}]}