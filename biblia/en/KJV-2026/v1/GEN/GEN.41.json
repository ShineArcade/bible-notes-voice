{"book": "GEN", "chapter": 41, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 440701, "verses": [{"verse": 1, "start": 300, "end": 6372, "text": "And it came to pass at the end of two full years, that Pharaoh dreamed: and, behold, he stood by the river.", "words": [[0, 300], [4, 433], [7, 553], [12, 773], [15, 993], [20, 1333], [23, 1533], [27, 1653], [31, 1893], [34, 2013], [38, 2233], [43, 2533], [50, 2873], [55, 3153], [63, 3493], [72, 4485], [77, 4646], [85, 5226], [88, 5306], [94, 5526], [97, 5786], [101, 5906]]}, {"verse": 2, "start": 6822, "end": 13616, "text": "And, behold, there came up out of the river seven well favoured cows and fatfleshed; and they fed in a meadow.", "words": [[0, 6822], [5, 6990], [13, 7850], [19, 8030], [24, 8250], [27, 8510], [31, 8750], [34, 8870], [38, 8970], [44, 9170], [50, 9590], [55, 9960], [64, 10330], [69, 10770], [73, 11349], [85, 12173], [89, 12528], [94, 12668], [98, 12928], [101, 13088], [103, 13168]]}, {"verse": 3, "start": 14066, "end": 23099, "text": "And, behold, seven other cows came up after them out of the river, ill favoured and leanfleshed; and stood by the other cows upon the brink of the river.", "words": [[0, 14066], [5, 14212], [13, 15052], [19, 15432], [25, 15712], [30, 16092], [35, 16392], [38, 16612], [44, 16952], [49, 17172], [53, 17332], [56, 17452], [60, 17552], [67, 18192], [71, 18522], [80, 18852], [84, 19406], [97, 20197], [101, 20341], [107, 20621], [110, 20881], [114, 21041], [120, 21201], [125, 21561], [130, 21901], [134, 22121], [140, 22401], [143, 22521], [147, 22621]]}, {"verse": 4, "start": 23549, "end": 31039, "text": "And the ill favoured and leanfleshed cows did eat up the seven well favoured and fat cows. So Pharaoh awoke.", "words": [[0, 23549], [4, 23711], [8, 23831], [12, 24231], [21, 24631], [25, 25121], [37, 25611], [42, 25931], [46, 26251], [50, 26571], [53, 26791], [57, 26971], [63, 27271], [68, 27691], [77, 28111], [81, 28331], [85, 28631], [91, 29613], [94, 29982], [102, 30392]]}, {"verse": 5, "start": 31489, "end": 39885, "text": "And he slept and dreamed the second time: and, behold, seven heads of grain came up upon one stalk, rank and good.", "words": [[0, 31489], [4, 31631], [7, 31751], [13, 32051], [17, 32371], [25, 32751], [29, 33051], [36, 33331], [42, 34279], [47, 34429], [55, 35249], [61, 35649], [67, 36029], [70, 36169], [76, 36489], [81, 36829], [84, 37049], [89, 37369], [93, 37989], [100, 38609], [105, 39309], [109, 39409]]}, {"verse": 6, "start": 40335, "end": 45452, "text": "And, behold, seven thin ears and blasted with the east wind sprung up after them.", "words": [[0, 40335], [5, 40498], [13, 41358], [19, 41738], [24, 42078], [29, 42478], [33, 42738], [41, 43338], [46, 43478], [50, 43638], [55, 43938], [60, 44238], [67, 44698], [70, 44798], [76, 45098]]}, {"verse": 7, "start": 45902, "end": 53599, "text": "And the seven thin ears devoured the seven rank and full ears. And Pharaoh awoke, and, behold, it was a dream.", "words": [[0, 45902], [4, 46030], [8, 46150], [14, 46510], [19, 46830], [24, 47230], [33, 47870], [37, 48050], [43, 48350], [48, 48750], [52, 49030], [57, 49350], [63, 50338], [67, 50505], [75, 50925], [82, 51545], [87, 51785], [95, 52585], [98, 52665], [102, 52885], [104, 53005]]}, {"verse": 8, "start": 54049, "end": 68329, "text": "And it came to pass in the morning that his spirit was troubled; and he sent and called for all the magicians of Egypt, and all the wise men of it: and Pharaoh told them his dream; but there was none that could interpret them to Pharaoh.", "words": [[0, 54049], [4, 54207], [7, 54327], [12, 54587], [15, 54787], [20, 55087], [23, 55327], [27, 55427], [35, 55727], [40, 56007], [44, 56127], [51, 56527], [55, 56767], [65, 58727], [69, 58862], [72, 58962], [77, 59302], [81, 59462], [88, 59862], [92, 60142], [96, 60342], [100, 60482], [110, 60962], [113, 61142], [120, 61482], [124, 62022], [128, 62242], [132, 62382], [137, 62642], [141, 62902], [144, 63082], [148, 63642], [152, 63911], [160, 64211], [165, 64431], [170, 64671], [174, 64851], [181, 65690], [185, 65795], [191, 65975], [195, 66155], [200, 66475], [205, 66715], [211, 66875], [221, 67295], [226, 67595], [229, 67755]]}, {"verse": 9, "start": 68779, "end": 74321, "text": "¶ Then spoke the chief butler to Pharaoh, saying, I do remember my faults this day:", "words": [[2, 68779], [7, 69027], [13, 69407], [17, 69627], [23, 69867], [30, 70427], [33, 70607], [42, 71227], [50, 72480], [52, 72626], [55, 72866], [64, 73206], [67, 73446], [74, 73686], [79, 73926]]}, {"verse": 10, "start": 74771, "end": 80929, "text": "Pharaoh was angry with his servants, and put me in ward in the captain of the guard’s house, both me and the chief baker:", "words": [[0, 74918], [8, 75098], [12, 75278], [18, 75698], [23, 75918], [27, 76038], [37, 76398], [41, 76898], [45, 77078], [48, 77298], [51, 77398], [56, 77678], [59, 77858], [63, 77958], [71, 78238], [74, 78398], [78, 78498], [86, 78698], [93, 79318], [98, 79498], [101, 79798], [105, 80178], [109, 80278], [115, 80438]]}, {"verse": 11, "start": 81379, "end": 87490, "text": "And we dreamed a dream in one night, I and he; we dreamed each man according to the interpretation of his dream.", "words": [[0, 81379], [4, 81501], [7, 81641], [15, 81871], [17, 82101], [23, 82421], [26, 82621], [30, 82861], [37, 83361], [39, 83581], [43, 83701], [47, 84340], [50, 84439], [58, 84719], [63, 85019], [67, 85319], [77, 85699], [80, 85959], [84, 86079], [99, 86639], [102, 86939], [106, 87059]]}, {"verse": 12, "start": 87940, "end": 97584, "text": "And there was there with us a young man, a Hebrew, servant to the captain of the guard; and we told him, and he interpreted to us our dreams; to each man according to his dream he did interpret.", "words": [[0, 87940], [4, 88095], [10, 88255], [14, 88495], [20, 88735], [25, 88955], [28, 89095], [30, 89195], [36, 89395], [41, 89895], [43, 89995], [51, 90595], [59, 90935], [62, 91195], [66, 91315], [74, 91575], [77, 91755], [81, 91835], [88, 92550], [92, 92673], [95, 92793], [100, 93053], [105, 93273], [109, 93453], [112, 93633], [124, 94013], [127, 94273], [130, 94413], [134, 94553], [142, 95397], [145, 95494], [150, 95634], [154, 95814], [164, 96054], [167, 96294], [171, 96394], [177, 96614], [180, 96794], [184, 96954]]}, {"verse": 13, "start": 98034, "end": 104345, "text": "And it came to pass, as he interpreted to us, so it was; me he restored to my office, and him he hanged.", "words": [[0, 98034], [4, 98136], [7, 98236], [12, 98356], [15, 98496], [21, 98896], [24, 99236], [27, 99356], [39, 99696], [42, 100016], [46, 100556], [49, 100756], [52, 100876], [57, 101640], [60, 101861], [63, 102081], [72, 102421], [75, 102621], [78, 102761], [86, 103061], [90, 103501], [94, 103681], [97, 103861]]}, {"verse": 14, "start": 104695, "end": 114527, "text": "¶ Then Pharaoh sent and called Joseph, and they brought him hastily out of the dungeon: and he shaved himself, and changed his clothing, and came in to Pharaoh.", "words": [[2, 104695], [7, 104979], [15, 105399], [20, 105799], [24, 105999], [31, 106279], [39, 107259], [43, 107419], [48, 107559], [56, 107799], [60, 108039], [68, 108679], [72, 108959], [75, 109059], [79, 109179], [88, 110093], [92, 110217], [95, 110357], [102, 110697], [111, 111097], [115, 111777], [123, 112197], [127, 112417], [137, 112837], [141, 113337], [146, 113510], [149, 113684], [152, 113857]]}, {"verse": 15, "start": 114977, "end": 123993, "text": "And Pharaoh said to Joseph, I have dreamed a dream, and there is none that can interpret it: and I have heard say of you, that you can understand a dream to interpret it.", "words": [[0, 114977], [4, 115275], [12, 115575], [17, 115875], [20, 116035], [28, 116869], [30, 116989], [35, 117149], [43, 117429], [45, 117569], [52, 117849], [56, 118269], [62, 118429], [65, 118569], [70, 118829], [75, 119069], [79, 119169], [89, 119589], [93, 120242], [97, 120362], [99, 120482], [104, 120642], [110, 120842], [114, 121122], [117, 121282], [122, 121482], [127, 121902], [131, 122062], [135, 122202], [146, 122642], [148, 122882], [154, 123082], [157, 123262], [167, 123622]]}, {"verse": 16, "start": 124343, "end": 130465, "text": "And Joseph answered Pharaoh, saying, It is not in me: God shall give Pharaoh an answer of peace.", "words": [[0, 124343], [4, 124512], [11, 124752], [20, 125192], [29, 126092], [37, 126885], [40, 127015], [43, 127135], [47, 127355], [50, 127615], [54, 128222], [58, 128489], [64, 128749], [69, 128969], [77, 129289], [80, 129469], [87, 129789], [90, 129929]]}, {"verse": 17, "start": 130815, "end": 136475, "text": "And Pharaoh said to Joseph, In my dream, behold, I stood upon the bank of the river:", "words": [[0, 130815], [4, 130960], [12, 131380], [17, 131720], [20, 131920], [28, 133597], [31, 133719], [34, 133879], [41, 134359], [49, 134879], [51, 134979], [57, 135219], [62, 135439], [66, 135619], [71, 135879], [74, 135999], [78, 136119]]}, {"verse": 18, "start": 136925, "end": 142170, "text": "And, behold, there came up out of the river seven cows, fatfleshed and well favoured; and they fed in a meadow:", "words": [[0, 136925], [5, 137067], [13, 137547], [19, 137627], [24, 137827], [27, 138027], [31, 138187], [34, 138287], [38, 138387], [44, 138547], [50, 138867], [56, 139457], [67, 140047], [71, 140127], [76, 140487], [86, 141130], [90, 141278], [95, 141398], [99, 141618], [102, 141758], [104, 141818]]}, {"verse": 19, "start": 142620, "end": 151808, "text": "And, behold, seven other cows came up after them, poor and very ill favoured and leanfleshed, such as I never saw in all the land of Egypt for badness:", "words": [[0, 142620], [5, 142783], [13, 143503], [19, 143863], [25, 144203], [30, 144523], [35, 144763], [38, 144963], [44, 145243], [50, 145763], [55, 146063], [59, 146323], [64, 146623], [68, 147023], [77, 147423], [81, 148003], [94, 148583], [99, 148803], [102, 148943], [104, 149083], [110, 149323], [114, 149623], [117, 149803], [121, 150063], [125, 150243], [130, 150463], [133, 150603], [139, 150923], [143, 151163]]}, {"verse": 20, "start": 152258, "end": 155810, "text": "And the lean and the ill favoured cows did eat up the first seven fat cows:", "words": [[0, 152258], [4, 152384], [8, 152464], [13, 152664], [17, 152844], [21, 152944], [25, 153194], [34, 153444], [39, 153804], [43, 154104], [47, 154244], [50, 154364], [54, 154484], [60, 154754], [66, 155024], [70, 155244]]}, {"verse": 21, "start": 156260, "end": 163756, "text": "And when they had eaten them up, it could not be known that they had eaten them; but they were still ill favoured, as at the beginning. So I awoke.", "words": [[0, 156260], [4, 156370], [9, 156490], [14, 156650], [18, 156830], [24, 157030], [29, 157250], [33, 157670], [36, 157830], [42, 157970], [46, 158150], [49, 158310], [55, 158570], [60, 158870], [65, 159010], [69, 159150], [75, 159390], [81, 160043], [85, 160143], [90, 160303], [95, 160423], [101, 160743], [105, 161253], [115, 161763], [118, 161983], [121, 162123], [125, 162203], [136, 162954], [139, 163144], [141, 163304]]}, {"verse": 22, "start": 164206, "end": 168791, "text": "And I saw in my dream, and, behold, seven ears came up in one stalk, full and good:", "words": [[0, 164206], [4, 164307], [6, 164407], [10, 164607], [13, 164727], [16, 164847], [23, 165387], [28, 165527], [36, 166167], [42, 166407], [47, 166647], [52, 166887], [55, 167087], [58, 167227], [62, 167627], [69, 168027], [74, 168207], [78, 168407]]}, {"verse": 23, "start": 169241, "end": 174568, "text": "And, behold, seven ears, withered, thin, and blasted with the east wind, sprung up after them:", "words": [[0, 169241], [5, 169358], [13, 170038], [19, 170378], [25, 170718], [35, 171838], [41, 171938], [45, 172198], [53, 172718], [58, 172818], [62, 172998], [67, 173238], [73, 173498], [80, 173898], [83, 173998], [89, 174258]]}, {"verse": 24, "start": 175018, "end": 181537, "text": "And the thin ears devoured the seven good ears: and I told this to the magicians; but there was none that could declare it to me.", "words": [[0, 175018], [4, 175116], [8, 175216], [13, 175416], [18, 175696], [27, 176236], [31, 176416], [37, 176636], [42, 176856], [48, 177693], [52, 177800], [54, 177920], [59, 178100], [64, 178320], [67, 178460], [71, 178540], [82, 179439], [86, 179576], [92, 179736], [96, 179896], [101, 180196], [106, 180436], [112, 180596], [120, 180896], [123, 181076], [126, 181216]]}, {"verse": 25, "start": 181887, "end": 187869, "text": "¶ And Joseph said to Pharaoh, The dream of Pharaoh is one: God has showed Pharaoh what he is about to do.", "words": [[2, 181887], [6, 182034], [13, 182354], [18, 182694], [21, 182874], [30, 183708], [34, 183814], [40, 184094], [43, 184344], [51, 184594], [54, 184794], [59, 185504], [63, 185721], [67, 185921], [74, 186251], [82, 186581], [87, 186781], [90, 187021], [93, 187161], [99, 187381], [102, 187581]]}, {"verse": 26, "start": 188319, "end": 194058, "text": "The seven good cows are seven years; and the seven good ears are seven years: the dream is one.", "words": [[0, 188319], [4, 188400], [10, 188700], [15, 188940], [20, 189200], [24, 189440], [30, 189760], [37, 190637], [41, 190756], [45, 190876], [51, 191136], [56, 191446], [61, 191756], [65, 192016], [71, 192316], [78, 193200], [82, 193298], [88, 193518], [91, 193698]]}, {"verse": 27, "start": 194508, "end": 203213, "text": "And the seven thin and ill favoured cows that came up after them are seven years; and the seven empty ears blasted with the east wind shall be seven years of famine.", "words": [[0, 194508], [4, 194628], [8, 194768], [14, 195008], [19, 195328], [23, 195488], [27, 195788], [36, 196088], [41, 196448], [46, 196688], [51, 196908], [54, 197068], [60, 197348], [65, 197548], [69, 197668], [75, 198008], [82, 198851], [86, 198976], [90, 199116], [96, 199396], [102, 199676], [107, 199956], [115, 200536], [120, 200676], [124, 200796], [129, 201036], [134, 201396], [140, 201816], [143, 201996], [149, 202316], [155, 202556], [158, 202756]]}, {"verse": 28, "start": 203663, "end": 208681, "text": "This is the thing which I have spoken to Pharaoh: What God is about to do he shows to Pharaoh.", "words": [[0, 203663], [5, 204007], [8, 204287], [12, 204487], [18, 204707], [24, 204947], [26, 205087], [31, 205207], [38, 205567], [41, 205787], [50, 206569], [55, 206711], [59, 206931], [62, 207091], [68, 207331], [71, 207531], [74, 207771], [77, 207831], [83, 208051], [86, 208231]]}, {"verse": 29, "start": 209131, "end": 213161, "text": "Behold, there come seven years of great plenty throughout all the land of Egypt:", "words": [[0, 209131], [8, 209555], [14, 209635], [19, 209835], [25, 210215], [31, 210595], [34, 210875], [40, 211175], [47, 211535], [58, 211855], [62, 212215], [66, 212355], [71, 212575], [74, 212735]]}, {"verse": 30, "start": 213611, "end": 221758, "text": "And there shall arise after them seven years of famine; and all the plenty shall be forgotten in the land of Egypt; and the famine shall consume the land;", "words": [[0, 213611], [4, 213717], [10, 213877], [16, 214057], [22, 214357], [28, 214717], [33, 214937], [39, 215277], [45, 215577], [48, 215797], [56, 216577], [60, 216698], [64, 216958], [68, 217158], [75, 217478], [81, 217758], [84, 217898], [94, 218358], [97, 218598], [101, 218698], [106, 218898], [109, 219038], [116, 219817], [120, 219919], [124, 220019], [131, 220299], [137, 220559], [145, 221059], [149, 221299]]}, {"verse": 31, "start": 222208, "end": 228000, "text": "And the plenty shall not be known in the land by reason of that famine following; for it shall be very grievous.", "words": [[0, 222208], [4, 222350], [8, 222450], [15, 222770], [21, 223070], [25, 223330], [28, 223490], [34, 223650], [37, 223770], [41, 223890], [46, 224150], [49, 224350], [56, 224730], [59, 224950], [64, 225130], [71, 225450], [82, 226354], [86, 226458], [89, 226578], [95, 226738], [98, 226918], [103, 227298]]}, {"verse": 32, "start": 228450, "end": 235505, "text": "And for that the dream was doubled to Pharaoh twice; it is because the thing is established by God, and God will shortly bring it to pass.", "words": [[0, 228450], [4, 228574], [8, 228754], [13, 228954], [17, 229114], [23, 229374], [27, 229554], [35, 229894], [38, 230114], [46, 230394], [53, 231387], [56, 231486], [59, 231586], [67, 231846], [71, 232046], [77, 232266], [80, 232406], [92, 232786], [95, 233066], [100, 233306], [104, 233626], [108, 233866], [113, 234086], [121, 234406], [127, 234746], [130, 234906], [133, 235026]]}, {"verse": 33, "start": 235955, "end": 241073, "text": "Now therefore let Pharaoh look out a man discreet and wise, and set him over the land of Egypt.", "words": [[0, 235955], [4, 236170], [14, 236610], [18, 236810], [26, 237210], [31, 237730], [35, 237910], [37, 237990], [41, 238150], [50, 238650], [54, 238790], [60, 239090], [64, 239550], [68, 239790], [72, 239930], [77, 240150], [81, 240310], [86, 240470], [89, 240590]]}, {"verse": 34, "start": 241523, "end": 249416, "text": "Let Pharaoh do this, and let him appoint officers over the land, and take up the fifth part of the land of Egypt in the seven plenteous years.", "words": [[0, 241523], [4, 241797], [12, 242097], [15, 242297], [21, 242717], [25, 243137], [29, 243357], [33, 243517], [41, 243757], [50, 244437], [55, 244777], [59, 244977], [65, 245277], [69, 245677], [74, 245897], [77, 246017], [81, 246137], [87, 246357], [92, 246677], [95, 246877], [99, 246997], [104, 247217], [107, 247357], [113, 247677], [116, 247957], [120, 248097], [126, 248497], [136, 248897]]}, {"verse": 35, "start": 249866, "end": 256811, "text": "And let them gather all the food of those good years that come, and lay up grain under the hand of Pharaoh, and let them keep food in the cities.", "words": [[0, 249866], [4, 250012], [8, 250112], [13, 250292], [20, 250552], [24, 250932], [28, 251092], [33, 251332], [36, 251552], [42, 251732], [47, 251952], [53, 252172], [58, 252372], [64, 252692], [68, 253132], [72, 253292], [75, 253412], [81, 253692], [87, 254032], [91, 254212], [96, 254392], [99, 254492], [108, 254812], [112, 255252], [116, 255392], [121, 255552], [126, 255752], [131, 256052], [134, 256192], [138, 256292]]}, {"verse": 36, "start": 257261, "end": 264865, "text": "And that food shall be for store to the land against the seven years of famine, which shall be in the land of Egypt; that the land perish not through the famine.", "words": [[0, 257261], [4, 257404], [9, 257584], [14, 257824], [20, 258044], [23, 258224], [27, 258404], [33, 258724], [36, 258944], [40, 259084], [45, 259304], [53, 259624], [57, 259844], [63, 260124], [69, 260304], [72, 260464], [80, 261164], [86, 261364], [92, 261564], [95, 261744], [98, 261864], [102, 261964], [107, 262144], [110, 262304], [117, 263004], [122, 263108], [126, 263228], [131, 263558], [138, 263888], [142, 264068], [150, 264268], [154, 264368]]}, {"verse": 37, "start": 265215, "end": 269716, "text": "¶ And the thing was good in the eyes of Pharaoh, and in the eyes of all his servants.", "words": [[2, 265215], [6, 265358], [10, 265458], [16, 265678], [20, 265938], [25, 266258], [28, 266478], [32, 266598], [37, 266818], [40, 266998], [49, 267358], [53, 267978], [56, 268138], [60, 268238], [65, 268458], [68, 268658], [72, 268818], [76, 268998]]}, {"verse": 38, "start": 270166, "end": 277203, "text": "And Pharaoh said to his servants, Can we find such a one as this is, a man in whom the Spirit of God is?", "words": [[0, 270166], [4, 270329], [12, 270689], [17, 270969], [20, 271169], [24, 271329], [34, 272208], [38, 272343], [41, 272503], [46, 272803], [51, 273103], [53, 273243], [57, 273443], [60, 273743], [65, 274003], [69, 274843], [71, 274903], [75, 275203], [78, 275443], [83, 275663], [87, 275843], [94, 276283], [97, 276443], [101, 276663]]}, {"verse": 39, "start": 277553, "end": 284424, "text": "And Pharaoh said to Joseph, Since God has showed you all this, there is none so discreet and wise as you are:", "words": [[0, 277553], [4, 277698], [12, 278118], [17, 278458], [20, 278658], [28, 280335], [34, 280491], [38, 280771], [42, 280971], [49, 281251], [53, 281411], [57, 281591], [63, 282071], [69, 282251], [72, 282371], [77, 282551], [80, 282751], [89, 283271], [93, 283431], [98, 283731], [101, 283971], [105, 284131]]}, {"verse": 40, "start": 284874, "end": 292002, "text": "You shall be over my house, and according to your word shall all my people be ruled: only in the throne will I be greater than you.", "words": [[0, 284874], [4, 284976], [10, 285136], [13, 285296], [18, 285456], [21, 285656], [28, 286136], [32, 286316], [42, 286576], [45, 286776], [50, 286916], [55, 287216], [61, 287456], [65, 287716], [68, 287896], [75, 288156], [78, 288356], [85, 289073], [90, 289352], [93, 289492], [97, 289612], [104, 289872], [109, 290112], [111, 290212], [114, 290352], [122, 290712], [127, 291012]]}, {"verse": 41, "start": 292352, "end": 297795, "text": "And Pharaoh said to Joseph, See, I have set you over all the land of Egypt.", "words": [[0, 292352], [4, 292497], [12, 292917], [17, 293257], [20, 293457], [28, 295134], [33, 295428], [35, 295508], [40, 295688], [44, 295968], [48, 296188], [53, 296528], [57, 296828], [61, 296968], [66, 297188], [69, 297328]]}, {"verse": 42, "start": 298145, "end": 307768, "text": "And Pharaoh took off his ring from his hand, and put it upon Joseph’s hand, and arrayed him in vestures of fine linen, and put a gold chain about his neck;", "words": [[0, 298145], [4, 298286], [12, 298646], [17, 298906], [21, 299186], [25, 299366], [30, 299626], [35, 299806], [39, 300006], [45, 300406], [49, 300886], [53, 301066], [56, 301186], [61, 301466], [70, 302126], [76, 302426], [80, 302946], [88, 303386], [92, 303566], [95, 303746], [104, 303926], [107, 304246], [112, 304586], [119, 305710], [123, 305818], [127, 305978], [129, 306118], [134, 306378], [140, 306778], [146, 307058], [150, 307278]]}, {"verse": 43, "start": 308218, "end": 317927, "text": "And he made him to ride in the second chariot which he had; and they cried before him, Bow the knee: and he made him ruler over all the land of Egypt.", "words": [[0, 308218], [4, 308344], [7, 308444], [12, 308664], [16, 308824], [19, 308984], [24, 309344], [27, 309624], [31, 309724], [38, 310084], [46, 310624], [52, 310864], [55, 311024], [60, 311861], [64, 312005], [69, 312125], [75, 312445], [82, 312805], [87, 313485], [91, 313805], [95, 314045], [101, 314828], [105, 314972], [108, 315112], [113, 315392], [117, 315572], [123, 316012], [128, 316412], [132, 316732], [136, 316892], [141, 317152], [144, 317312]]}, {"verse": 44, "start": 318377, "end": 326218, "text": "And Pharaoh said to Joseph, I am Pharaoh, and without you shall no man lift up his hand or foot in all the land of Egypt.", "words": [[0, 318377], [4, 318522], [12, 318942], [17, 319282], [20, 319482], [28, 321159], [30, 321392], [33, 321552], [42, 321952], [46, 322292], [54, 322572], [58, 322792], [64, 322972], [67, 323192], [71, 323432], [76, 323612], [79, 323832], [83, 323972], [88, 324162], [91, 324352], [96, 324652], [99, 325052], [103, 325272], [107, 325412], [112, 325632], [115, 325752]]}, {"verse": 45, "start": 326568, "end": 337060, "text": "And Pharaoh called Joseph’s name Zaphnath-paaneah; and he gave him to wife Asenath the daughter of Poti-pherah priest of On. And Joseph went out over all the land of Egypt.", "words": [[0, 326568], [4, 326701], [12, 327201], [19, 327501], [28, 328141], [33, 329034], [51, 330184], [55, 330328], [58, 330428], [63, 330588], [67, 330768], [70, 330908], [75, 331208], [83, 332008], [87, 332028], [96, 332288], [99, 332818], [111, 333348], [118, 333568], [121, 333973], [125, 334613], [129, 334755], [136, 335075], [141, 335395], [145, 335555], [150, 335815], [154, 336055], [158, 336215], [163, 336415], [166, 336555]]}, {"verse": 46, "start": 337510, "end": 346355, "text": "¶ And Joseph was thirty years old when he stood before Pharaoh king of Egypt. And Joseph went out from the presence of Pharaoh, and went throughout all the land of Egypt.", "words": [[2, 337510], [6, 337655], [13, 337995], [17, 338295], [24, 338595], [30, 338835], [34, 339155], [39, 339375], [42, 339495], [48, 339715], [55, 340035], [63, 340455], [68, 340735], [71, 340895], [78, 341689], [82, 341835], [89, 342135], [94, 342475], [98, 342635], [103, 342835], [107, 342934], [116, 343275], [119, 343554], [128, 343875], [132, 344494], [137, 344655], [148, 344895], [152, 345275], [156, 345434], [161, 345695], [164, 345835]]}, {"verse": 47, "start": 346805, "end": 350692, "text": "And in the seven plenteous years the earth brought forth by handfuls.", "words": [[0, 346805], [4, 346936], [7, 347056], [11, 347176], [17, 347476], [27, 348156], [33, 348456], [37, 348736], [43, 348996], [51, 349276], [57, 349576], [60, 349876]]}, {"verse": 48, "start": 351142, "end": 362810, "text": "And he gathered up all the food of the seven years, which were in the land of Egypt, and laid up the food in the cities: the food of the field, which was round about every city, laid he up in the same.", "words": [[0, 351142], [4, 351264], [7, 351364], [16, 351704], [19, 351944], [23, 352184], [27, 352344], [32, 352584], [35, 352764], [39, 352884], [45, 353164], [52, 353924], [58, 354244], [63, 354444], [66, 354584], [70, 354704], [75, 354924], [78, 355084], [85, 355744], [89, 355884], [94, 356064], [97, 356204], [101, 356364], [106, 356644], [109, 356824], [113, 356944], [121, 357849], [125, 357939], [130, 358219], [133, 358379], [137, 358479], [144, 359179], [150, 359359], [154, 359539], [160, 359839], [166, 360139], [172, 360499], [178, 361299], [183, 361539], [186, 361739], [189, 361979], [192, 362099], [196, 362199]]}, {"verse": 49, "start": 363260, "end": 369882, "text": "And Joseph gathered grain as the sand of the sea, very much, until he left numbering; for it was without number.", "words": [[0, 363260], [4, 363404], [11, 363724], [20, 364164], [26, 364564], [29, 364784], [33, 364944], [38, 365264], [41, 365404], [45, 365484], [50, 365844], [55, 366284], [61, 366644], [67, 367064], [70, 367264], [75, 367484], [86, 368472], [90, 368651], [93, 368751], [97, 368911], [105, 369251]]}, {"verse": 50, "start": 370332, "end": 380657, "text": "And to Joseph were born two sons before the years of famine came, which Asenath the daughter of Poti-pherah priest of On bore to him.", "words": [[0, 370332], [4, 370497], [7, 370617], [14, 370957], [19, 371257], [24, 371637], [28, 371937], [33, 372397], [40, 372777], [44, 373057], [50, 373377], [53, 373597], [60, 373957], [66, 374777], [72, 374957], [80, 375597], [84, 375817], [93, 376117], [96, 376687], [108, 377257], [115, 377577], [118, 377817], [121, 378057], [126, 378317], [129, 378537]]}, {"verse": 51, "start": 381107, "end": 390243, "text": "And Joseph called the name of the firstborn Manasseh: For God, said he, has made me forget all my toil, and all my father’s house.", "words": [[0, 381107], [4, 381253], [11, 381593], [18, 381953], [22, 382153], [27, 382433], [30, 382633], [34, 382753], [44, 383353], [54, 384329], [58, 384502], [63, 385393], [68, 385633], [72, 386958], [76, 387076], [81, 387236], [84, 387396], [91, 387696], [95, 388076], [98, 388296], [104, 388616], [108, 389056], [112, 389236], [115, 389396], [124, 389816]]}, {"verse": 52, "start": 390593, "end": 397232, "text": "And the name of the second called he Ephraim: For God has caused me to be fruitful in the land of my affliction.", "words": [[0, 390593], [4, 390734], [8, 390834], [13, 391074], [16, 391214], [20, 391354], [27, 391694], [34, 392174], [37, 392534], [46, 393831], [50, 393953], [54, 394173], [58, 394433], [65, 394713], [68, 394913], [71, 395033], [74, 395173], [83, 395573], [86, 395893], [90, 396013], [95, 396253], [98, 396393], [101, 396593]]}, {"verse": 53, "start": 397582, "end": 402329, "text": "¶ And the seven years of plenteousness, that was in the land of Egypt, were ended.", "words": [[2, 397582], [6, 397723], [10, 397823], [16, 398083], [22, 398443], [25, 398603], [40, 399423], [45, 399943], [49, 400163], [52, 400303], [56, 400403], [61, 400623], [64, 400783], [71, 401083], [76, 401723]]}, {"verse": 54, "start": 402779, "end": 412613, "text": "And the seven years of dearth began to come, according as Joseph had said: and the dearth was in all lands; but in all the land of Egypt there was bread.", "words": [[0, 402779], [4, 402915], [8, 403035], [14, 403315], [20, 403635], [23, 403795], [30, 404195], [36, 404495], [39, 404715], [45, 405275], [55, 405635], [58, 405955], [65, 406295], [69, 406555], [75, 407327], [79, 407467], [83, 407567], [90, 407987], [94, 408187], [97, 408367], [101, 408707], [108, 409830], [112, 410166], [115, 410326], [119, 410606], [123, 410786], [128, 411006], [131, 411186], [137, 411546], [143, 411866], [147, 412026]]}, {"verse": 55, "start": 413063, "end": 423173, "text": "And when all the land of Egypt was famished, the people cried to Pharaoh for bread: and Pharaoh said to all the Egyptians, Go to Joseph; what he says to you, do.", "words": [[0, 413063], [4, 413189], [9, 413329], [13, 413649], [17, 413809], [22, 414089], [25, 414249], [31, 414589], [35, 414889], [45, 415789], [49, 415889], [56, 416149], [62, 416529], [65, 416729], [73, 417149], [77, 417429], [84, 418270], [88, 418426], [96, 418826], [101, 419206], [104, 419446], [108, 419686], [112, 419866], [123, 421049], [126, 421183], [129, 421316], [137, 422016], [142, 422133], [145, 422253], [150, 422433], [153, 422613], [158, 422853]]}, {"verse": 56, "start": 423523, "end": 433641, "text": "And the famine was over all the face of the earth: and Joseph opened all the storehouses, and sold to the Egyptians; and the famine became severe in the land of Egypt.", "words": [[0, 423523], [4, 423646], [8, 423746], [15, 424106], [19, 424386], [24, 424606], [28, 424966], [32, 425186], [37, 425426], [40, 425626], [44, 425746], [51, 426491], [55, 426638], [62, 426978], [69, 427458], [73, 427738], [77, 427918], [90, 428578], [94, 429038], [99, 429378], [102, 429618], [106, 429758], [117, 430852], [121, 430979], [125, 431099], [132, 431419], [139, 431819], [146, 432419], [149, 432659], [153, 432739], [158, 432979], [161, 433119]]}, {"verse": 57, "start": 434091, "end": 440301, "text": "And all countries came into Egypt to Joseph to buy grain; because that the famine was so severe in all lands.", "words": [[0, 434091], [4, 434193], [8, 434373], [18, 434733], [23, 435033], [28, 435213], [34, 435593], [37, 435793], [44, 436153], [47, 436413], [51, 436593], [58, 437484], [66, 437684], [71, 437924], [75, 438084], [82, 438384], [86, 438644], [89, 438824], [96, 439204], [99, 439424], [103, 439584]]}]}