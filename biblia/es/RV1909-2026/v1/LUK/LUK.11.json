{"book": "LUK", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 497488, "verses": [{"verse": 1, "start": 300, "end": 13637, "text": "Y aconteció que estando él orando en un lugar, cuando acabó, uno de sus discípulos le dijo: Señor, enséñanos a orar, como también Juan enseñó a sus discípulos.", "words": [[0, 300], [2, 419], [12, 1179], [16, 1439], [24, 1939], [27, 2179], [34, 2599], [37, 2759], [40, 2899], [47, 3799], [54, 4019], [61, 5099], [65, 5259], [68, 5439], [72, 5619], [83, 6299], [86, 6499], [92, 7275], [99, 7670], [109, 8150], [111, 8370], [117, 8910], [122, 9050], [130, 9470], [135, 9810], [142, 10370], [144, 10450], [148, 10590]]}, {"verse": 2, "start": 13987, "end": 28025, "text": "Y les dijo: Cuando oréis, decid: Padre nuestro que estás en los cielos; sea tu nombre santificado. Venga tu reino. Sea hecha tu voluntad, como en el cielo, así también en la tierra.", "words": [[0, 13987], [2, 14116], [6, 14276], [12, 15099], [19, 15363], [26, 15840], [33, 17300], [39, 17660], [47, 17860], [51, 18320], [57, 18560], [60, 18800], [64, 18940], [72, 20119], [76, 20355], [79, 20595], [86, 20915], [99, 22417], [105, 22744], [108, 22924], [115, 23934], [119, 24274], [125, 24674], [128, 24854], [138, 25534], [143, 25754], [146, 25914], [149, 26034], [156, 26554], [160, 26734], [168, 27114], [171, 27294], [174, 27414]]}, {"verse": 3, "start": 28475, "end": 31445, "text": "El pan nuestro de cada día, dánoslo hoy.", "words": [[0, 28475], [3, 28633], [7, 28933], [15, 29473], [18, 29713], [23, 29933], [28, 30733], [36, 31089]]}, {"verse": 4, "start": 31895, "end": 42657, "text": "Y perdónanos nuestros pecados, porque también nosotros perdonamos a todos los que nos deben. Y no nos metas en tentación, sino líbranos del malo.", "words": [[0, 32186], [2, 32626], [13, 33346], [22, 33726], [31, 34606], [38, 34966], [46, 35406], [55, 35846], [66, 36726], [68, 36906], [74, 37266], [78, 37586], [82, 37766], [86, 37886], [93, 38838], [95, 38964], [98, 39064], [102, 39244], [108, 39704], [111, 39844], [122, 40464], [127, 40964], [136, 41864], [140, 42124]]}, {"verse": 5, "start": 43107, "end": 51847, "text": "Les dijo también: ¿Quién de vosotros tendrá un amigo, e irá a él a media noche, y le dirá: Amigo, préstame tres panes,", "words": [[0, 43107], [4, 43242], [9, 43522], [18, 44449], [25, 44751], [28, 44851], [37, 45371], [44, 45811], [47, 45971], [54, 46951], [56, 47051], [60, 47391], [62, 47571], [65, 47771], [67, 48038], [73, 48304], [80, 48571], [82, 48811], [85, 49142], [91, 49729], [98, 50272], [107, 50732], [112, 51072]]}, {"verse": 6, "start": 52297, "end": 57659, "text": "Porque un amigo mío ha venido a mí de camino, y no tengo qué ponerle delante;", "words": [[0, 52297], [7, 52500], [10, 52680], [16, 52940], [20, 53360], [23, 53480], [30, 53860], [32, 53980], [35, 54080], [38, 54220], [46, 54640], [48, 54880], [51, 55040], [57, 55340], [61, 55580], [69, 56120]]}, {"verse": 7, "start": 58109, "end": 70189, "text": "Y aquel, respondiendo desde adentro, le dice: No me molestes; la puerta ya está cerrada, y mis niños están conmigo en cama; no puedo levantarme y dártelos?", "words": [[0, 58109], [2, 58109], [9, 58109], [22, 58855], [28, 59095], [37, 60155], [40, 60235], [46, 61154], [49, 61421], [52, 61561], [62, 62866], [65, 63012], [72, 63312], [75, 63672], [80, 63892], [89, 64492], [91, 64612], [95, 64772], [101, 65092], [107, 65492], [115, 66052], [118, 66212], [124, 67414], [127, 67414], [133, 67601], [144, 68501], [146, 68701]]}, {"verse": 8, "start": 70639, "end": 79773, "text": "Os digo, que aunque no se levante a darle por ser su amigo, cierto por su insistencia se levantará, y le dará todo lo que necesite.", "words": [[0, 70639], [3, 70754], [9, 71034], [13, 71434], [20, 71634], [23, 71914], [26, 72074], [34, 72534], [36, 72674], [42, 72954], [46, 73194], [50, 73454], [53, 73694], [60, 74554], [67, 74874], [71, 75234], [74, 75414], [86, 76574], [89, 76714], [100, 77394], [102, 77834], [105, 77974], [110, 78314], [115, 78614], [118, 78894], [122, 79014]]}, {"verse": 9, "start": 80223, "end": 87049, "text": "Y yo os digo: Pedid, y se os dará; buscad, y hallaréis; llamad, y os será abierto.", "words": [[0, 80223], [2, 80371], [5, 80571], [8, 80711], [14, 81646], [21, 81836], [23, 82096], [26, 82236], [29, 82396], [35, 83191], [43, 83756], [45, 84349], [56, 85183], [64, 85744], [66, 86164], [69, 86284], [74, 86524]]}, {"verse": 10, "start": 87499, "end": 94151, "text": "Porque todo aquel que pide, recibe; y el que busca, halla; y al que llama, se abre.", "words": [[0, 87499], [7, 88086], [12, 88446], [18, 88886], [22, 88986], [28, 89586], [36, 90684], [38, 90798], [41, 90918], [45, 91266], [52, 91614], [59, 92262], [61, 92411], [64, 92511], [68, 92691], [75, 93351], [78, 93631]]}, {"verse": 11, "start": 94601, "end": 104035, "text": "¿Y cuál padre de vosotros, si su hijo le pide pan, le dará una piedra? o, si pescado, ¿en lugar de pescado, le dará una serpiente?", "words": [[0, 94601], [3, 94719], [8, 94919], [14, 95269], [17, 95619], [27, 96319], [30, 96859], [33, 97079], [38, 97339], [41, 97519], [46, 97839], [51, 98139], [54, 98739], [59, 99079], [63, 99219], [71, 100248], [74, 100471], [77, 100631], [86, 101231], [90, 101451], [96, 101691], [99, 101931], [108, 102491], [111, 102671], [116, 102951], [120, 103051]]}, {"verse": 12, "start": 104485, "end": 107971, "text": "O, si le pide un huevo, ¿le dará un escorpión?", "words": [[0, 104485], [3, 104611], [6, 104731], [9, 104871], [14, 105191], [17, 105331], [24, 106151], [28, 106411], [33, 106831], [36, 107011]]}, {"verse": 13, "start": 108421, "end": 119392, "text": "Pues si vosotros, siendo malos, sabéis dar buenos regalos a vuestros hijos, ¿cuánto más vuestro Padre celestial dará el Espíritu Santo a los que se lo pidan?", "words": [[0, 108421], [5, 109045], [8, 109565], [18, 110325], [25, 110565], [32, 111445], [39, 111865], [43, 112045], [50, 112385], [58, 112965], [60, 113105], [69, 113465], [76, 114285], [84, 114785], [88, 115005], [96, 115405], [102, 115745], [112, 116265], [117, 116705], [120, 116905], [129, 117445], [135, 117825], [137, 118385], [141, 118505], [145, 118625], [148, 118765], [151, 118905]]}, {"verse": 14, "start": 119842, "end": 128571, "text": "Y estaba él lanzando un demonio, el cual era mudo: y aconteció que salido fuera el demonio, el mudo habló, y la gente se maravilló.", "words": [[0, 119842], [2, 119966], [9, 120266], [12, 120506], [21, 121086], [24, 121226], [33, 121846], [36, 121906], [41, 122086], [45, 122406], [51, 123245], [53, 123334], [63, 123954], [67, 124094], [74, 124554], [80, 124794], [83, 125014], [92, 125954], [95, 126074], [100, 126414], [107, 126754], [109, 127194], [112, 127314], [118, 127594], [121, 127814]]}, {"verse": 15, "start": 129021, "end": 135014, "text": "Pero algunos de ellos decían: En Beelzebú, príncipe de los demonios, echa fuera los demonios.", "words": [[0, 129021], [5, 129223], [13, 129463], [16, 129912], [22, 130361], [30, 131047], [33, 131439], [43, 131869], [52, 132309], [55, 132469], [59, 132609], [69, 133229], [74, 133849], [80, 134049], [84, 134309]]}, {"verse": 16, "start": 135364, "end": 138484, "text": "Y otros, tentando, pedían de él señal del cielo.", "words": [[0, 135364], [2, 135525], [9, 135705], [19, 136385], [26, 136905], [29, 137065], [32, 137225], [38, 137725], [42, 137845]]}, {"verse": 17, "start": 138934, "end": 148922, "text": "Pero él, conociendo los pensamientos de ellos, les dijo: Todo reino dividido contra sí mismo, es asolado; y una casa dividida contra sí misma, cae.", "words": [[0, 138934], [5, 139188], [9, 139478], [20, 139938], [24, 140118], [37, 140798], [40, 140998], [47, 141658], [51, 141798], [57, 142565], [62, 142727], [68, 143287], [77, 143887], [84, 144187], [87, 144447], [94, 144807], [97, 144987], [106, 146215], [108, 146318], [112, 146478], [117, 146798], [126, 147458], [133, 147738], [136, 147958], [143, 148378]]}, {"verse": 18, "start": 149372, "end": 158725, "text": "Y si también Satanás está dividido contra sí mismo, ¿cómo estará en pie su reino? porque decís que en Beelzebú echo yo fuera los demonios.", "words": [[0, 149372], [2, 149478], [5, 149618], [13, 149958], [21, 150758], [26, 151018], [35, 151508], [42, 151998], [45, 152488], [52, 152978], [58, 153218], [65, 153718], [68, 153878], [72, 154038], [75, 154238], [82, 155348], [89, 155488], [95, 155928], [99, 156008], [102, 156361], [111, 156715], [116, 157068], [119, 157328], [125, 157628], [129, 157888]]}, {"verse": 19, "start": 159175, "end": 168628, "text": "Pues si yo echo fuera los demonios en Beelzebú, ¿vuestros hijos en quién los echan fuera? Por tanto, ellos serán vuestros jueces.", "words": [[0, 159175], [5, 159337], [8, 159617], [11, 159927], [16, 160237], [22, 160557], [26, 160797], [35, 161477], [38, 162197], [48, 162917], [58, 163557], [64, 163917], [67, 164437], [73, 164717], [77, 165017], [83, 165317], [90, 166223], [94, 166327], [101, 166687], [107, 167007], [113, 167487], [122, 167907]]}, {"verse": 20, "start": 169078, "end": 176129, "text": "Pero si por el dedo de Dios echo yo fuera los demonios, cierto el reino de Dios ha llegado a vosotros.", "words": [[0, 169078], [5, 169242], [8, 169462], [12, 169742], [15, 169902], [20, 170302], [23, 170402], [28, 170752], [33, 171102], [36, 171242], [42, 171522], [46, 171762], [56, 172822], [63, 173182], [66, 173522], [72, 173982], [75, 174142], [80, 174502], [83, 174742], [91, 175222], [93, 175342]]}, {"verse": 21, "start": 176579, "end": 182195, "text": "Cuando el hombre fuerte y armado guarda su atrio, en paz está lo que posee.", "words": [[0, 176579], [7, 176805], [10, 177025], [17, 177285], [24, 177805], [26, 178045], [33, 178545], [40, 179025], [43, 179205], [50, 180265], [53, 180565], [57, 180845], [62, 181205], [65, 181405], [69, 181545]]}, {"verse": 22, "start": 182645, "end": 190969, "text": "Pero si sobreviniendo otro más fuerte que él, le vence, le quita todas sus armas en que confiaba, y reparte el botín.", "words": [[0, 182645], [5, 182811], [8, 183331], [22, 183851], [27, 184231], [31, 184491], [38, 184871], [42, 185131], [46, 185551], [49, 185811], [56, 186611], [59, 186731], [65, 187051], [71, 187291], [75, 187631], [81, 188011], [84, 188291], [88, 188431], [98, 189151], [100, 189631], [108, 190171], [111, 190593]]}, {"verse": 23, "start": 191419, "end": 197353, "text": "El que no es conmigo, contra mí es; y el que conmigo no recoge, desparrama.", "words": [[0, 191419], [3, 191561], [7, 191701], [10, 191921], [13, 192081], [22, 192621], [29, 192981], [32, 193281], [36, 194019], [38, 194144], [41, 194264], [45, 194404], [53, 195004], [56, 195807], [64, 196609]]}, {"verse": 24, "start": 197803, "end": 209423, "text": "Cuando el espíritu inmundo sale del hombre, anda por lugares secos, buscando reposo; y no hallándolo, dice: Volveré a mi casa, de donde salí.", "words": [[0, 197803], [7, 197990], [10, 198190], [19, 198810], [27, 199290], [32, 199630], [36, 199870], [44, 200230], [49, 200790], [53, 201090], [61, 201490], [68, 202270], [77, 202750], [85, 204073], [87, 204280], [90, 205100], [102, 205920], [108, 206802], [116, 207328], [118, 207428], [121, 207548], [127, 207968], [130, 208568], [136, 208808]]}, {"verse": 25, "start": 209873, "end": 212607, "text": "Y viniendo, la halla barrida y adornada.", "words": [[0, 209873], [2, 209995], [12, 210515], [15, 210735], [21, 211055], [29, 211595], [31, 211775]]}, {"verse": 26, "start": 213057, "end": 223112, "text": "Entonces va, y toma otros siete espíritus peores que él; y entrados, habitan allí: y lo postrero del tal hombre es peor que lo primero.", "words": [[0, 213057], [9, 213605], [13, 214145], [15, 214385], [20, 214665], [26, 215005], [32, 215445], [42, 216145], [49, 216605], [53, 216845], [57, 217544], [59, 217705], [69, 218405], [77, 219185], [83, 219879], [85, 219985], [88, 220105], [97, 220685], [101, 220885], [105, 221085], [112, 221465], [115, 221825], [120, 222245], [124, 222385], [127, 222505]]}, {"verse": 27, "start": 223562, "end": 235232, "text": "Y aconteció que diciendo estas cosas, una mujer de la multitud, levantando la voz, le dijo: Bienaventurado el vientre que te trajo, y los pechos que mamaste.", "words": [[0, 223562], [2, 223725], [12, 224465], [16, 224805], [25, 225125], [31, 225465], [38, 226705], [42, 226885], [48, 227305], [51, 227465], [54, 227565], [64, 228445], [75, 229045], [78, 229185], [83, 229825], [86, 229945], [92, 230827], [107, 231666], [110, 231806], [118, 232306], [122, 232386], [125, 232526], [132, 233126], [134, 233566], [138, 233746], [145, 234166], [149, 234386]]}, {"verse": 28, "start": 235582, "end": 242361, "text": "Y él dijo: Más bien, bienaventurados los que oyen la palabra de Dios, y la guardan.", "words": [[0, 235582], [2, 235742], [5, 236076], [11, 236648], [15, 236795], [21, 237795], [37, 238795], [41, 239295], [45, 239515], [50, 239915], [53, 240075], [61, 240435], [64, 240655], [70, 240975], [72, 241535], [75, 241675]]}, {"verse": 29, "start": 242811, "end": 255384, "text": "Y apiñándose las multitudes en torno a él, comenzó a decir: Esta generación mala es: señal busca, pero señal no le será dada, sino la señal de Jonás.", "words": [[0, 242811], [2, 242936], [13, 243756], [17, 243956], [28, 244656], [31, 244936], [37, 245356], [39, 245476], [43, 245656], [51, 246496], [53, 246596], [60, 247412], [65, 247872], [76, 248692], [81, 249092], [85, 249916], [91, 250380], [98, 250940], [103, 251100], [109, 251700], [112, 252000], [115, 252180], [120, 252440], [126, 253400], [131, 253740], [134, 253960], [140, 254460], [143, 254600]]}, {"verse": 30, "start": 255834, "end": 262779, "text": "Porque como Jonás fue señal a los ninivitas, así también será el Hijo del hombre a esta generación.", "words": [[0, 255834], [7, 256036], [12, 256296], [18, 256676], [22, 256956], [28, 257576], [30, 257736], [34, 258526], [45, 259316], [49, 259496], [57, 259916], [62, 260256], [65, 260556], [70, 260816], [74, 260976], [81, 261296], [83, 261536], [88, 261796]]}, {"verse": 31, "start": 263229, "end": 278668, "text": "La reina del Sur se levantará en juicio con los hombres de esta generación, y los condenará; porque vino de los fines de la tierra a oír la sabiduría de Salomón; y he aquí más que Salomón en este lugar.", "words": [[0, 263229], [3, 263352], [9, 263752], [13, 263932], [17, 264392], [20, 265032], [30, 265672], [33, 265852], [40, 266312], [44, 266612], [48, 266772], [56, 267192], [59, 267472], [64, 267672], [76, 268572], [78, 269252], [82, 269452], [93, 270766], [100, 270951], [105, 271291], [108, 271471], [112, 271631], [118, 271971], [121, 272171], [124, 272311], [131, 272711], [133, 273431], [137, 273891], [140, 274051], [150, 274771], [153, 274911], [162, 276003], [164, 276119], [167, 276269], [172, 276569], [176, 276869], [180, 277069], [188, 277809], [191, 277929], [196, 278149]]}, {"verse": 32, "start": 279118, "end": 292000, "text": "Los hombres de Nínive se levantarán en juicio con esta generación, y la condenarán; porque a la predicación de Jonás se arrepintieron; y he aquí más que Jonás en este lugar.", "words": [[0, 279118], [4, 279242], [12, 279622], [15, 279972], [22, 280322], [25, 280782], [36, 281522], [39, 281642], [46, 282122], [50, 282382], [55, 282582], [67, 283362], [69, 283782], [72, 283922], [84, 285186], [91, 285490], [93, 285770], [96, 285870], [108, 286610], [111, 286790], [117, 287350], [120, 288345], [135, 289577], [137, 289714], [140, 289894], [145, 290174], [149, 290414], [153, 290614], [159, 291114], [162, 291254], [167, 291434]]}, {"verse": 33, "start": 292450, "end": 302305, "text": "Nadie pone en oculto la lámpara encendida, ni debajo de un recipiente para medir grano, sino en el candelero, para que los que entran vean la luz.", "words": [[0, 292450], [6, 292810], [11, 293130], [14, 293391], [21, 293951], [24, 294090], [32, 294570], [43, 295850], [46, 296050], [53, 296470], [56, 296670], [59, 296770], [70, 297391], [75, 297590], [81, 297951], [88, 298350], [93, 298590], [96, 299030], [99, 299170], [110, 299870], [115, 300350], [119, 300490], [123, 300650], [127, 300830], [134, 301230], [139, 301590], [142, 301750]]}, {"verse": 34, "start": 302755, "end": 314733, "text": "La lámpara del cuerpo es el ojo: cuando tu ojo es bueno, también todo tu cuerpo está lleno de luz; pero cuando tu ojo es maligno, también tu cuerpo está en tinieblas.", "words": [[0, 302755], [3, 302860], [11, 303260], [15, 303440], [22, 303860], [25, 304320], [28, 304600], [33, 305319], [40, 305520], [43, 305780], [47, 306020], [50, 306160], [57, 307140], [65, 307620], [70, 308040], [73, 308320], [80, 308640], [85, 308900], [91, 309300], [94, 309400], [99, 310243], [104, 310387], [111, 310687], [114, 310967], [118, 311227], [121, 311347], [130, 312347], [138, 312727], [141, 313007], [148, 313327], [153, 313627], [156, 313807]]}, {"verse": 35, "start": 315183, "end": 318936, "text": "Mira pues, si la luz que en ti hay, es tinieblas.", "words": [[0, 315183], [5, 315381], [11, 315601], [14, 316261], [17, 316441], [21, 316601], [25, 316781], [28, 316941], [31, 317081], [36, 317381], [39, 318021]]}, {"verse": 36, "start": 319386, "end": 330746, "text": "Así que, siendo todo tu cuerpo resplandeciente, no teniendo alguna parte de tinieblas, será todo luminoso, como cuando una lámpara te alumbra con su resplandor.", "words": [[0, 319386], [4, 319628], [9, 319928], [16, 320268], [21, 320688], [24, 320988], [31, 321388], [48, 323148], [51, 323248], [60, 323788], [67, 324048], [73, 324488], [76, 325088], [87, 325688], [92, 325948], [97, 326288], [107, 327408], [112, 327608], [119, 327968], [123, 328268], [131, 328808], [134, 329028], [142, 329508], [146, 329708], [149, 329888]]}, {"verse": 37, "start": 331196, "end": 338128, "text": "Y luego que hubo hablado, le rogó un fariseo que comiese con él: y entrado Jesús, se sentó a la mesa.", "words": [[0, 331196], [2, 331317], [8, 331517], [12, 331797], [17, 332177], [26, 332617], [29, 332897], [34, 333357], [37, 333497], [45, 334177], [49, 334297], [57, 334797], [61, 335097], [65, 335722], [67, 335820], [75, 336240], [82, 336700], [85, 337120], [91, 337500], [93, 337560], [96, 337640]]}, {"verse": 38, "start": 338578, "end": 343787, "text": "Y el fariseo, como lo vio, se maravilló de que no se lavó antes de comer.", "words": [[0, 338578], [2, 338701], [5, 338821], [14, 339501], [19, 339661], [22, 339841], [27, 340701], [30, 340901], [40, 341621], [43, 341821], [47, 341941], [50, 342121], [53, 342281], [58, 342721], [64, 343101], [67, 343281]]}, {"verse": 39, "start": 344237, "end": 354887, "text": "Y el Señor le dijo: Ahora vosotros los fariseos lo de fuera del vaso y del plato limpiáis; pero lo interior de vosotros está lleno de robo y de maldad.", "words": [[0, 344237], [2, 344344], [5, 344464], [11, 344784], [14, 344984], [20, 345802], [26, 346222], [35, 347342], [39, 347442], [48, 348342], [51, 348542], [54, 348682], [60, 348882], [64, 349182], [69, 349602], [71, 349682], [75, 349822], [81, 350162], [91, 351449], [96, 351593], [99, 351753], [108, 352173], [111, 352373], [120, 352833], [125, 353113], [131, 353473], [134, 353573], [139, 354013], [141, 354093], [144, 354233]]}, {"verse": 40, "start": 355337, "end": 359411, "text": "Necios, ¿el que hizo lo de fuera, no hizo también lo de dentro?", "words": [[0, 355337], [8, 356355], [12, 356555], [16, 356735], [21, 356975], [24, 357155], [27, 357295], [34, 357575], [37, 357835], [42, 358015], [50, 358435], [53, 358675], [56, 358815]]}, {"verse": 41, "start": 359861, "end": 365080, "text": "Pero de lo que os resta, dad limosna; y he aquí todo os será limpio.", "words": [[0, 359861], [5, 360005], [8, 360165], [11, 360325], [15, 360445], [18, 360565], [25, 361485], [29, 361705], [38, 362915], [40, 362980], [43, 363080], [48, 363400], [53, 363580], [56, 363760], [61, 364220]]}, {"verse": 42, "start": 365530, "end": 379854, "text": "Pero ¡ay de vosotros, fariseos! que diezmáis la menta, y la ruda, y toda hortaliza; y pasáis por alto la justicia y el amor de Dios. Pues estas cosas era necesario hacer, y no dejar las otras.", "words": [[0, 365607], [5, 365721], [9, 365834], [12, 366034], [22, 366574], [32, 367945], [36, 368219], [45, 368529], [48, 368839], [55, 369149], [57, 369249], [60, 369409], [66, 369969], [68, 370189], [73, 370449], [84, 371707], [86, 371812], [93, 372292], [97, 372612], [102, 372972], [105, 373212], [114, 373952], [116, 374152], [119, 374272], [124, 374472], [127, 374712], [133, 375529], [138, 375673], [144, 375953], [150, 376413], [154, 376873], [164, 377413], [171, 377853], [173, 378413], [176, 378660], [182, 378906], [186, 379153]]}, {"verse": 43, "start": 380304, "end": 387766, "text": "¡Ay de vosotros, fariseos! que amáis los asientos de honor en las sinagogas, y los saludos en las plazas.", "words": [[0, 380469], [4, 380669], [7, 381229], [17, 381649], [27, 382953], [31, 383037], [37, 383397], [41, 383557], [50, 384097], [53, 384317], [59, 384537], [62, 384797], [66, 384937], [77, 385837], [79, 386117], [83, 386257], [91, 386817], [94, 386957], [98, 387077]]}, {"verse": 44, "start": 388216, "end": 398326, "text": "¡Ay de vosotros, escribas y fariseos, hipócritas! que sois como sepulcros que no se ven, y los hombres que andan encima no lo saben.", "words": [[0, 388371], [4, 388561], [7, 389061], [17, 389521], [26, 390221], [28, 390361], [38, 391041], [50, 392593], [54, 392675], [59, 393075], [64, 393335], [74, 394075], [78, 394275], [81, 394435], [84, 394595], [89, 394815], [91, 395295], [95, 395455], [103, 395835], [107, 396095], [113, 396495], [120, 397175], [123, 397515], [126, 397655]]}, {"verse": 45, "start": 398776, "end": 408655, "text": "Y respondiendo uno de los intérpretes de la ley, le dice: Maestro, cuando dices esto, también nos afrentas a nosotros.", "words": [[0, 398878], [2, 399018], [15, 399898], [19, 400258], [22, 400418], [26, 400968], [38, 401518], [41, 401598], [44, 401738], [49, 402318], [52, 402498], [58, 403319], [67, 404045], [74, 404105], [80, 404525], [86, 405545], [94, 405645], [98, 405885], [107, 406445], [109, 406545]]}, {"verse": 46, "start": 409005, "end": 421287, "text": "Y él dijo: ¡Ay de vosotros también, intérpretes de la ley! que cargáis a los hombres con cargas que no pueden llevar; pero vosotros ni aun con un dedo tocáis las cargas.", "words": [[0, 409005], [2, 409165], [5, 409499], [11, 410251], [15, 410431], [18, 410591], [27, 411091], [36, 411471], [48, 412951], [51, 413111], [54, 413231], [59, 414017], [63, 414101], [71, 414581], [73, 414701], [77, 414821], [85, 415161], [89, 415421], [96, 415941], [100, 416081], [103, 416241], [110, 416561], [118, 417471], [123, 417711], [132, 418311], [135, 418911], [139, 419111], [143, 419351], [146, 419511], [151, 419911], [158, 420331], [162, 420491]]}, {"verse": 47, "start": 421737, "end": 428584, "text": "¡Ay de vosotros! que edificáis los sepulcros de los profetas, y los mataron vuestros padres.", "words": [[0, 421909], [4, 422115], [7, 422322], [17, 423541], [21, 423625], [31, 424565], [35, 424865], [45, 425565], [48, 425745], [52, 425845], [62, 426445], [64, 426945], [68, 427085], [76, 427565], [85, 427925]]}, {"verse": 48, "start": 429034, "end": 439873, "text": "De cierto dais testimonio que consentís en los hechos de vuestros padres; porque a la verdad ellos los mataron, pero vosotros edificáis sus sepulcros.", "words": [[0, 429411], [3, 429821], [10, 430231], [15, 430641], [26, 431321], [30, 431661], [40, 432001], [43, 432341], [47, 432521], [54, 432861], [57, 433021], [66, 433361], [74, 434351], [81, 434597], [83, 434717], [86, 434797], [93, 435077], [99, 435497], [103, 435717], [112, 436337], [117, 436537], [126, 437257], [136, 438337], [140, 439136]]}, {"verse": 49, "start": 440323, "end": 450754, "text": "Por tanto, la sabiduría de Dios también dijo: Enviaré a ellos profetas y apóstoles; y de ellos a unos matarán y a otros perseguirán;", "words": [[0, 440323], [4, 440427], [11, 441147], [14, 441707], [24, 442267], [27, 442387], [32, 442627], [40, 442927], [46, 443881], [54, 444446], [56, 444526], [62, 444726], [71, 445326], [73, 445506], [84, 446649], [86, 446787], [89, 446927], [95, 447214], [97, 447500], [102, 447787], [110, 448487], [112, 448867], [114, 448987], [120, 449327]]}, {"verse": 50, "start": 451204, "end": 458986, "text": "Para que de esta generación sea demandada la sangre de todos los profetas, que ha sido derramada desde la fundación del mundo;", "words": [[0, 451204], [5, 451445], [9, 451625], [12, 451785], [17, 452025], [28, 452865], [32, 453125], [42, 453825], [45, 453965], [52, 454385], [55, 454585], [61, 454845], [65, 455125], [75, 455725], [79, 456105], [82, 456225], [87, 456465], [97, 457185], [103, 457405], [106, 457665], [116, 458205], [120, 458405]]}, {"verse": 51, "start": 459436, "end": 469857, "text": "Desde la sangre de Abel, hasta la sangre de Zacarías, que murió entre el altar y el templo: así os digo, será demandada de esta generación.", "words": [[0, 459436], [6, 459672], [9, 459932], [16, 460292], [19, 460492], [25, 460892], [31, 461692], [34, 461872], [41, 462312], [44, 462532], [54, 463192], [58, 463652], [64, 464092], [70, 464452], [73, 464692], [79, 465052], [81, 465392], [84, 465532], [92, 466483], [96, 466668], [99, 466828], [105, 467568], [110, 467848], [120, 468528], [123, 468708], [128, 468908]]}, {"verse": 52, "start": 470307, "end": 481212, "text": "¡Ay de vosotros, intérpretes de la ley! que habéis quitado la llave del conocimiento; vosotros mismos no entrasteis, y a los que entraban impedisteis.", "words": [[0, 470505], [4, 470735], [7, 470935], [17, 471375], [29, 472355], [32, 472455], [35, 472575], [40, 473578], [44, 473682], [51, 473982], [59, 474462], [62, 474602], [68, 474922], [72, 475062], [86, 476457], [95, 476856], [102, 477156], [105, 477416], [117, 478376], [119, 478816], [121, 478876], [125, 478976], [129, 479116], [138, 479716]]}, {"verse": 53, "start": 481662, "end": 491809, "text": "Y diciéndoles estas cosas, los escribas y los fariseos comenzaron a presionarle en gran manera, y a provocarle a que hablase de muchas cosas;", "words": [[0, 481662], [2, 481806], [14, 482466], [20, 482806], [27, 484026], [31, 484126], [40, 484766], [42, 484946], [46, 485046], [55, 485766], [66, 486686], [68, 486786], [80, 487606], [83, 487766], [88, 487966], [96, 488486], [98, 489106], [100, 489186], [111, 489986], [113, 490126], [117, 490246], [125, 490646], [128, 490766], [135, 490986]]}, {"verse": 54, "start": 492259, "end": 497088, "text": "Acechándole, y procurando cazar algo de su boca para acusarle.", "words": [[0, 492259], [13, 493200], [15, 493580], [26, 494170], [32, 494760], [37, 495120], [40, 495340], [43, 495520], [48, 495880], [53, 496160]]}]}