{"book": "PSA", "chapter": 139, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 162279, "verses": [{"verse": 1, "start": 300, "end": 7363, "text": "Al Músico principal: Salmo de David. OH Jehová, tú me has examinado y conocido.", "words": [[0, 300], [3, 461], [10, 941], [21, 2161], [27, 2724], [30, 2884], [37, 4183], [40, 4569], [48, 4956], [51, 5196], [54, 5396], [58, 5576], [68, 6356], [70, 6496]]}, {"verse": 2, "start": 7813, "end": 14301, "text": "Tú has conocido mi sentarme y mi levantarme, has entendido desde lejos mis pensamientos.", "words": [[0, 7813], [3, 7917], [7, 8117], [16, 8777], [19, 8937], [28, 9677], [30, 9917], [33, 10037], [45, 11177], [49, 11337], [59, 12097], [65, 12317], [71, 12877], [75, 13157]]}, {"verse": 3, "start": 14751, "end": 19757, "text": "Mi senda y mi acostarme has rodeado, y conoces todos mis caminos.", "words": [[0, 14751], [3, 14911], [9, 15411], [11, 15511], [14, 15611], [24, 16231], [28, 16471], [37, 17311], [39, 18071], [47, 18551], [53, 18771], [57, 19031]]}, {"verse": 4, "start": 20207, "end": 26179, "text": "Pues aún no está la palabra en mi lengua, y he aquí, oh Jehová, tú la sabes toda.", "words": [[0, 20207], [5, 20483], [9, 20743], [12, 20983], [17, 21183], [20, 21323], [28, 21703], [31, 21903], [34, 22063], [42, 22743], [44, 22983], [47, 23123], [53, 23670], [56, 24216], [64, 24763], [67, 25003], [70, 25163], [76, 25483]]}, {"verse": 5, "start": 26629, "end": 32029, "text": "Detrás y delante me rodeaste, y sobre mí pusiste tu mano.", "words": [[0, 26629], [7, 27313], [9, 27953], [17, 28393], [20, 28593], [30, 29273], [32, 29993], [38, 30253], [41, 30533], [49, 31133], [52, 31373]]}, {"verse": 6, "start": 32479, "end": 39229, "text": "Más maravilloso es el conocimiento que mi capacidad; alta es, no puedo comprenderla.", "words": [[0, 32479], [4, 32787], [16, 33667], [19, 33827], [22, 33967], [35, 34747], [39, 34907], [42, 35067], [53, 36379], [58, 36999], [62, 37479], [65, 37659], [71, 37959]]}, {"verse": 7, "start": 39679, "end": 44139, "text": "¿Adónde me iré de tu espíritu? ¿y adónde huiré de tu presencia?", "words": [[0, 39813], [8, 39983], [11, 40283], [15, 40583], [18, 40683], [21, 40823], [31, 41805], [34, 42144], [41, 42518], [47, 42891], [50, 43091], [53, 43251]]}, {"verse": 8, "start": 44589, "end": 51222, "text": "Si subo a los cielos, allí estás tú: y si en abismo hago mi estrado, he aquí allí tú estás.", "words": [[0, 44589], [3, 44789], [8, 45229], [10, 45309], [14, 45409], [22, 46249], [27, 46469], [33, 46729], [37, 47413], [39, 47537], [42, 47697], [45, 47817], [52, 48217], [57, 48457], [60, 48657], [69, 49477], [72, 49917], [77, 50167], [82, 50417], [85, 50637]]}, {"verse": 9, "start": 51672, "end": 55804, "text": "Si tomo las alas del alba, y habito en el extremo del mar,", "words": [[0, 51672], [3, 51836], [8, 52216], [12, 52356], [17, 52756], [21, 52936], [27, 53556], [29, 53956], [36, 54296], [39, 54436], [42, 54556], [50, 55176], [54, 55316]]}, {"verse": 10, "start": 56254, "end": 60549, "text": "Aun allí me guiará tu mano, y me asirá tu diestra.", "words": [[0, 56254], [4, 56601], [9, 56981], [12, 57441], [19, 57961], [22, 58101], [28, 58501], [30, 58961], [33, 59281], [39, 59601], [42, 59701]]}, {"verse": 11, "start": 60999, "end": 68231, "text": "Si digo: Ciertamente las tinieblas me encubrirán; aun la noche resplandecerá tocante a mí.", "words": [[0, 60999], [3, 61391], [9, 62120], [21, 62923], [25, 63083], [35, 63803], [38, 63983], [50, 65231], [54, 65433], [57, 65673], [63, 65993], [77, 66853], [85, 67713], [87, 67933]]}, {"verse": 12, "start": 68681, "end": 77121, "text": "Aun las tinieblas no encubren de ti, y la noche resplandece como el día: lo mismo te son las tinieblas que la luz.", "words": [[0, 68681], [4, 69006], [8, 69246], [18, 69966], [21, 70146], [30, 70686], [33, 70866], [37, 71146], [39, 71626], [42, 71766], [48, 72066], [60, 73066], [65, 73306], [68, 73506], [73, 74195], [76, 74323], [82, 74603], [85, 74843], [89, 75143], [93, 75703], [103, 76263], [107, 76463], [110, 76623]]}, {"verse": 13, "start": 77571, "end": 83223, "text": "Porque tú formaste mis riñones; me cubriste en el vientre de mi madre.", "words": [[0, 77571], [7, 77797], [10, 78077], [19, 78697], [23, 79476], [32, 80491], [35, 80965], [44, 81475], [47, 81695], [50, 81835], [58, 82355], [61, 82475], [64, 82615]]}, {"verse": 14, "start": 83673, "end": 92290, "text": "Te alabaré; porque formidables, maravillosas son tus obras: estoy maravillado, y mi alma lo conoce mucho.", "words": [[0, 83912], [3, 84188], [12, 84763], [19, 85183], [32, 86403], [45, 87143], [49, 87423], [53, 87623], [60, 88696], [66, 88936], [79, 89756], [81, 90156], [84, 90336], [89, 90736], [92, 91216], [99, 91696]]}, {"verse": 15, "start": 92740, "end": 101112, "text": "No fue encubierto de ti mi cuerpo, bien que en oculto fui formado, y entretejido en lo más bajo de la tierra.", "words": [[0, 92740], [3, 92926], [7, 93206], [18, 93986], [21, 94146], [24, 94406], [27, 94546], [35, 95546], [40, 95866], [44, 96126], [47, 96406], [54, 97006], [58, 97186], [67, 97866], [69, 98046], [81, 98966], [84, 99106], [87, 99226], [91, 99546], [96, 100026], [99, 100266], [102, 100386]]}, {"verse": 16, "start": 101562, "end": 110897, "text": "Mi embrión vieron tus ojos, y en tu libro estaban escritas todas aquellas cosas que fueron luego formadas, sin faltar una de ellas.", "words": [[0, 101562], [3, 101848], [11, 102168], [18, 102448], [22, 102648], [28, 103048], [30, 103388], [33, 103548], [36, 103688], [42, 104068], [50, 104628], [59, 105268], [65, 105508], [74, 106088], [80, 106288], [84, 106528], [91, 106768], [97, 107108], [107, 107808], [111, 108348], [118, 108868], [122, 109028], [125, 109228]]}, {"verse": 17, "start": 111347, "end": 117599, "text": "Así que ¡cuán preciosos me son, oh Dios, tus pensamientos! ¡cuán grande es la suma de ellos!", "words": [[0, 111347], [4, 111347], [8, 111347], [14, 111591], [24, 112231], [27, 112331], [32, 112631], [35, 112931], [41, 113491], [45, 113691], [59, 115127], [65, 115492], [72, 115932], [75, 116312], [78, 116492], [83, 116872], [86, 117032]]}, {"verse": 18, "start": 118049, "end": 125220, "text": "Si los cuento, se multiplican más que la arena: despierto, y aún estoy contigo.", "words": [[0, 118049], [3, 118226], [7, 118616], [15, 119006], [18, 119146], [30, 120026], [34, 120226], [38, 120426], [41, 120586], [48, 122568], [59, 122568], [61, 122712], [65, 122892], [71, 123292]]}, {"verse": 19, "start": 125670, "end": 132308, "text": "De cierto, oh Dios, matarás al impío; apartaos pues de mí, hombres sanguinarios.", "words": [[0, 126018], [3, 126391], [11, 126764], [14, 127136], [20, 127509], [28, 127882], [31, 128255], [38, 129091], [47, 129281], [52, 129501], [55, 129721], [59, 130201], [67, 130681]]}, {"verse": 20, "start": 132758, "end": 138077, "text": "Porque blasfemias dicen ellos contra ti: tus enemigos toman en vano tu nombre.", "words": [[0, 132758], [7, 133000], [18, 133860], [24, 134280], [30, 134700], [37, 135100], [41, 135831], [45, 136101], [54, 136621], [60, 136941], [63, 137061], [68, 137341], [71, 137441]]}, {"verse": 21, "start": 138527, "end": 143968, "text": "¿No tengo en odio, oh Jehová, a los que te aborrecen, y me conmuevo contra tus enemigos?", "words": [[0, 138527], [4, 138655], [10, 138880], [13, 139105], [19, 139330], [22, 139555], [30, 140275], [32, 140355], [36, 140475], [40, 140615], [43, 140775], [54, 141395], [56, 141815], [59, 141955], [68, 142635], [75, 142875], [79, 143135]]}, {"verse": 22, "start": 144418, "end": 148796, "text": "Los aborrezco con perfecto odio; los tengo por enemigos.", "words": [[0, 144418], [4, 144836], [14, 145286], [18, 145526], [27, 146346], [33, 147227], [37, 147487], [43, 147787], [47, 148027]]}, {"verse": 23, "start": 149246, "end": 155781, "text": "Examíname, oh Dios, y conoce mi corazón: pruébame y reconoce mis pensamientos:", "words": [[0, 149246], [11, 150052], [14, 150152], [20, 151032], [2