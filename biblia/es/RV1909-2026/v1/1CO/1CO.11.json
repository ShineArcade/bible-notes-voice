{"book": "1CO", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 220787, "verses": [{"verse": 1, "start": 300, "end": 3426, "text": "Sed imitadores de mí, así como yo de Cristo.", "words": [[0, 473], [4, 653], [15, 1173], [18, 1413], [22, 2033], [26, 2233], [31, 2533], [34, 2693], [37, 2833]]}, {"verse": 2, "start": 3776, "end": 12125, "text": "Y os alabo, hermanos, que en todo os acordáis de mí, y retenéis las instrucciones mías, de la manera que os enseñé.", "words": [[0, 3776], [2, 3875], [5, 4015], [12, 4335], [22, 4995], [26, 5275], [29, 5455], [34, 5635], [37, 5915], [46, 6375], [49, 6555], [53, 6775], [55, 7375], [64, 7895], [68, 8035], [82, 8695], [88, 9295], [91, 9615], [94, 9735], [101, 9995], [105, 10255], [108, 10375]]}, {"verse": 3, "start": 12475, "end": 20161, "text": "Pero quiero que sepáis, que Cristo es la cabeza de todo varón; y el varón es la cabeza de la mujer; y Dios la cabeza de Cristo.", "words": [[0, 12475], [5, 12612], [12, 12912], [16, 13072], [24, 13632], [28, 14052], [35, 14512], [38, 14772], [41, 14892], [48, 15292], [51, 15512], [56, 15672], [63, 16419], [65, 16547], [68, 16647], [74, 16987], [77, 17107], [80, 17207], [87, 17587], [90, 17767], [93, 17867], [100, 18577], [102, 18723], [107, 18923], [110, 19123], [117, 19463], [120, 19663]]}, {"verse": 4, "start": 20511, "end": 24909, "text": "Todo varón que ora o profetiza cubierta la cabeza, deshonra su cabeza.", "words": [[0, 20511], [5, 20675], [11, 21095], [15, 21255], [19, 21495], [21, 21675], [31, 22275], [40, 22835], [43, 22955], [51, 23375], [60, 24135], [63, 24295]]}, {"verse": 5, "start": 25259, "end": 33191, "text": "Pero toda mujer que ora o profetiza no cubierta su cabeza, deshonra su cabeza; porque lo mismo es que si se afeitara la cabeza.", "words": [[0, 25259], [5, 25401], [10, 25621], [16, 26001], [20, 26281], [24, 26521], [26, 26661], [36, 27301], [39, 27501], [48, 28041], [51, 28161], [59, 29061], [68, 29501], [71, 29661], [79, 30442], [86, 30622], [89, 30762], [95, 31062], [98, 31402], [102, 31622], [105, 31782], [108, 32122], [117, 32462], [120, 32542]]}, {"verse": 6, "start": 33541, "end": 41816, "text": "Porque si la mujer no se cubre, córtese también el cabello: y si es vergonzoso para la mujer cortarse el cabello o afeitarse la cabeza, cúbrase.", "words": [[0, 33541], [7, 33706], [10, 33846], [13, 33966], [19, 34206], [22, 34466], [25, 34626], [32, 35506], [40, 35886], [48, 36226], [51, 36386], [60, 37119], [62, 37214], [65, 37314], [68, 37474], [79, 38054], [84, 38294], [87, 38414], [93, 38634], [102, 39194], [105, 39314], [113, 39734], [115, 39874], [125, 40374], [128, 40494], [136, 41234]]}, {"verse": 7, "start": 42166, "end": 48699, "text": "Porque el varón no ha de cubrir la cabeza, porque es imagen y gloria de Dios: pero la mujer es gloria del varón.", "words": [[0, 42166], [7, 42370], [10, 42510], [16, 42810], [19, 42990], [22, 43110], [25, 43210], [32, 43550], [35, 43650], [43, 44410], [50, 44710], [53, 44890], [60, 45270], [62, 45570], [69, 45950], [72, 46090], [78, 46802], [83, 46941], [86, 47061], [92, 47381], [95, 47621], [102, 48001], [106, 48181]]}, {"verse": 8, "start": 49049, "end": 52065, "text": "Porque el varón no es de la mujer, sino la mujer del varón.", "words": [[0, 49049], [7, 49266], [10, 49406], [16, 49706], [19, 49906], [22, 50026], [25, 50126], [28, 50246], [35, 50806], [40, 50986], [43, 51146], [49, 51406], [53, 51586]]}, {"verse": 9, "start": 52415, "end": 57472, "text": "Porque tampoco el varón fue creado por causa de la mujer, sino la mujer por causa del varón.", "words": [[0, 52415], [7, 52595], [15, 52915], [18, 53195], [24, 53515], [28, 53675], [35, 54155], [39, 54355], [45, 54575], [48, 54795], [51, 54895], [58, 55215], [63, 55775], [66, 55955], [72, 56235], [76, 56515], [82, 56735], [86, 57015]]}, {"verse": 10, "start": 57822, "end": 62890, "text": "Por lo cual, la mujer debe tener señal de autoridad sobre su cabeza, por causa de los ángeles.", "words": [[0, 57822], [4, 57950], [7, 58050], [13, 58330], [16, 58510], [22, 58810], [27, 59150], [33, 59470], [39, 59930], [42, 60010], [52, 60530], [58, 60790], [61, 60990], [69, 61410], [73, 61625], [79, 61885], [82, 62085], [86, 62165]]}, {"verse": 11, "start": 63240, "end": 66930, "text": "Pero ni el varón sin la mujer, ni la mujer sin el varón, en el Señor.", "words": [[0, 63240], [5, 63385], [8, 63545], [11, 63665], [17, 63985], [21, 64165], [24, 64305], [31, 64825], [34, 64925], [37, 65045], [43, 65265], [47, 65525], [50, 65665], [57, 66105], [60, 66325], [63, 66425]]}, {"verse": 12, "start": 67280, "end": 72685, "text": "Porque como la mujer es del varón, así también el varón es por la mujer: pero todo de Dios.", "words": [[0, 67280], [7, 67504], [12, 67784], [15, 67904], [21, 68224], [24, 68424], [28, 68564], [35, 69304], [39, 69544], [47, 69944], [50, 70164], [56, 70464], [59, 70584], [63, 70784], [66, 70884], [73, 71560], [78, 71703], [83, 71963], [86, 72203]]}, {"verse": 13, "start": 73035, "end": 77235, "text": "Juzgad vosotros mismos: ¿es apropiado orar la mujer a Dios no cubierta?", "words": [[0, 73035], [7, 73466], [16, 73926], [24, 74798], [28, 74959], [38, 75459], [43, 75739], [46, 75839], [52, 76079], [54, 76239], [59, 76419], [62, 76579]]}, {"verse": 14, "start": 77585, "end": 82832, "text": "La misma naturaleza ¿no os enseña que al hombre sea deshonroso dejarse crecer el cabello?", "words": [[0, 77585], [3, 77682], [9, 77941], [20, 78782], [24, 79002], [27, 79202], [34, 79741], [38, 79922], [41, 80081], [48, 80282], [52, 80581], [63, 81301], [71, 81741], [78, 82122], [81, 82262]]}, {"verse": 15, "start": 83182, "end": 89505, "text": "Por el contrario, a la mujer dejarse crecer el cabello le es honroso; porque en lugar de velo le es dado el cabello.", "words": [[0, 83182], [4, 83308], [7, 83408], [18, 84048], [20, 84128], [23, 84208], [29, 84448], [37, 85008], [44, 85368], [47, 85508], [55, 85948], [58, 86128], [61, 86563], [70, 87161], [77, 87388], [80, 87528], [86, 87748], [89, 88008], [94, 88288], [97, 88418], [100, 88548], [105, 88788], [108, 88948]]}, {"verse": 16, "start": 89855, "end": 96359, "text": "Con todo eso, si alguno parece ser contencioso, nosotros no tenemos tal costumbre, ni las iglesias de Dios.", "words": [[0, 89855], [4, 89977], [9, 90197], [14, 90617], [17, 90717], [24, 91117], [31, 91397], [35, 91697], [48, 92877], [57, 93197], [60, 93557], [68, 93897], [72, 94157], [83, 94817], [86, 95117], [90, 95317], [99, 95777], [102, 95917]]}, {"verse": 17, "start": 96709, "end": 101934, "text": "Pero os doy esta instrucción sin alabaros, porque os reunís no para lo mejor, sino para lo peor.", "words": [[0, 96709], [5, 96866], [8, 97026], [12, 97286], [17, 97466], [29, 98046], [33, 98226], [43, 98966], [50, 99126], [53, 99326], [60, 99746], [63, 99926], [68, 100126], [71, 100286], [78, 100926], [83, 101086], [88, 101346], [91, 101506]]}, {"verse": 18, "start": 102284, "end": 108399, "text": "Porque lo primero, cuando os juntáis en la iglesia, oigo que hay entre vosotros divisiones; y en parte lo creo.", "words": [[0, 102284], [7, 102469], [10, 102629], [19, 103069], [26, 103249], [29, 103489], [37, 103909], [40, 104029], [43, 104129], [52, 104989], [57, 105169], [61, 105369], [65, 105529], [71, 105729], [80, 106189], [92, 107272], [94, 107411], [97, 107491], [103, 107751], [106, 107971]]}, {"verse": 19, "start": 108749, "end": 115196, "text": "Porque preciso es que haya entre vosotros aun bandos, para que los que son probados se manifiesten entre vosotros.", "words": [[0, 108749], [7, 108954], [15, 109394], [18, 109694], [22, 109854], [27, 110054], [33, 110334], [42, 110894], [46, 111134], [54, 111734], [59, 112254], [63, 112414], [67, 112534], [71, 112694], [75, 112874], [84, 113394], [87, 113594], [99, 114234], [105, 114434]]}, {"verse": 20, "start": 115546, "end": 119659, "text": "Cuando pues os juntáis en uno, esto no es comer la cena del Señor:", "words": [[0, 115546], [7, 115755], [12, 116009], [15, 116262], [23, 116762], [26, 116942], [31, 117662], [36, 117882], [39, 118082], [42, 118182], [48, 118422], [51, 118602], [56, 118862], [60, 119042]]}, {"verse": 21, "start": 120009, "end": 126046, "text": "Porque cada uno toma antes para comer su propia cena; y el uno tiene hambre, y el otro está embriagado.", "words": [[0, 120009], [7, 120193], [12, 120453], [16, 120693], [21, 121053], [27, 121373], [32, 121613], [38, 121873], [41, 122113], [48, 122333], [54, 123152], [56, 123270], [59, 123370], [63, 123510], [69, 123810], [77, 124290], [79, 124690], [82, 124810], [87, 125030], [92, 125270]]}, {"verse": 22, "start": 126396, "end": 136776, "text": "Pues qué, ¿no tenéis casas en que comáis y bebáis? ¿o menospreciáis la iglesia de Dios, y avergonzáis a los que no tienen? ¿Qué os diré? ¿os alabaré? En esto no os alabo.", "words": [[0, 126396], [5, 126543], [10, 126763], [14, 126883], [21, 127263], [27, 127723], [30, 127883], [34, 128003], [41, 128483], [43, 128643], [51, 129490], [54, 129907], [68, 130367], [71, 130507], [79, 130867], [82, 131047], [88, 131347], [90, 131727], [102, 132367], [104, 132527], [108, 132647], [112, 132767], [115, 132907], [123, 133597], [128, 133709], [131, 133809], [137, 134758], [141, 135052], [150, 135510], [153, 135648], [158, 135888], [161, 136168], [164, 136328]]}, {"verse": 23, "start": 137126, "end": 143744, "text": "Porque yo recibí del Señor lo que también os he enseñado: Que el Señor Jesús, la noche que fue entregado, tomó pan;", "words": [[0, 137126], [7, 137318], [10, 137498], [17, 137978], [21, 138058], [27, 138398], [30, 138618], [34, 138738], [42, 139058], [45, 139298], [48, 139418], [58, 140334], [62, 140418], [65, 140498], [71, 140718], [78, 141438], [81, 141538], [87, 141738], [91, 141918], [95, 142098], [106, 143058], [111, 143318]]}, {"verse": 24, "start": 144094, "end": 153613, "text": "Y habiendo dado gracias, lo partió, y dijo: Tomad, comed: esto es mi cuerpo que por vosotros es partido: haced esto en memoria de mí.", "words": [[0, 144094], [2, 144219], [11, 144519], [16, 144739], [25, 145479], [28, 145559], [36, 146019], [38, 146259], [44, 147296], [51, 147634], [58, 148134], [63, 148412], [66, 148632], [69, 148812], [76, 149172], [80, 149452], [84, 149672], [93, 150252], [96, 150432], [105, 151429], [111, 152008], [116, 152528], [119, 152668], [127, 153128], [130, 153288]]}, {"verse": 25, "start": 153833, "end": 165367, "text": "Asimismo tomó también la copa, después de haber cenado, diciendo: Esta copa es el nuevo pacto en mi sangre: haced esto todas las veces que bebáis, en memoria de mí.", "words": [[0, 154132], [9, 154462], [14, 154842], [22, 155062], [25, 155282], [31, 155922], [39, 156162], [42, 156402], [48, 156522], [56, 157342], [66, 158216], [71, 158495], [76, 159015], [79, 159115], [82, 159295], [88, 159535], [94, 160155], [97, 160255], [100, 160435], [108, 161446], [114, 161636], [119, 162136], [125, 162596], [129, 162976], [135, 163296], [139, 163496], [147, 164076], [150, 164416], [158, 164876], [161, 165056]]}, {"verse": 26, "start": 165587, "end": 172238, "text": "Porque todas las veces que coméis este pan, y bebéis esta copa, la muerte del Señor anunciáis hasta que venga.", "words": [[0, 165587], [7, 165794], [13, 166034], [17, 166334], [23, 166654], [27, 166874], [34, 167294], [39, 167554], [44, 167894], [46, 168174], [53, 168554], [58, 168814], [64, 169654], [67, 169714], [74, 170014], [78, 170234], [84, 170574], [94, 171374], [100, 171594], [104, 171774]]}, {"verse": 27, "start": 172588, "end": 180360, "text": "De manera que, cualquiera que coma este pan o beba esta copa del Señor indignamente, será culpado del cuerpo y de la sangre del Señor.", "words": [[0, 172588], [3, 172683], [10, 172903], [15, 173183], [26, 173703], [30, 173863], [35, 174143], [40, 174463], [44, 174863], [46, 175143], [51, 175363], [56, 175583], [61, 176023], [65, 176143], [71, 176463], [85, 177303], [90, 177823], [98, 178363], [102, 178523], [109, 178883], [111, 179163], [114, 179243], [117, 179363], [124, 179703], [128, 179903]]}, {"verse": 28, "start": 180710, "end": 186083, "text": "Por tanto, pruébese cada uno a sí mismo, y coma así de aquel pan, y beba de aquella copa.", "words": [[0, 180710], [4, 180836], [11, 181236], [20, 181796], [25, 182036], [29, 182316], [31, 182496], [34, 182596], [41, 182976], [43, 183336], [48, 183616], [52, 183916], [55, 184056], [61, 184336], [66, 184556], [68, 184936], [73, 185216], [76, 185316], [84, 185636]]}, {"verse": 29, "start": 186433, "end": 192775, "text": "Porque el que come y bebe indignamente, juicio come y bebe para sí, no discerniendo el cuerpo del Señor.", "words": [[0, 186433], [7, 186613], [10, 186733], [14, 186853], [19, 187193], [21, 187413], [26, 187633], [40, 188673], [47, 189233], [52, 189593], [54, 189813], [59, 190113], [64, 190313], [68, 190993], [71, 191073], [84, 191733], [87, 191853], [94, 192073], [98, 192313]]}, {"verse": 30, "start": 193125, "end": 197620, "text": "Por lo cual hay muchos enfermos y debilitados entre vosotros; y muchos duermen.", "words": [[0, 193125], [4, 193226], [7, 193386], [12, 193566], [16, 193746], [23, 193966], [32, 194686], [34, 194826], [46, 195446], [52, 195726], [62, 196716], [64, 196801], [71, 197021]]}, {"verse": 31, "start": 197970, "end": 202318, "text": "Que si nos examinásemos a nosotros mismos, cierto no seríamos juzgados.", "words": [[0, 197970], [4, 198048], [7, 198168], [11, 198288], [24, 199148], [26, 199288], [35, 199528], [43, 200588], [50, 200988], [53, 201068], [62, 201508]]}, {"verse": 32, "start": 202668, "end": 207697, "text": "Pero siendo juzgados, somos castigados del Señor, para que no seamos condenados con el mundo.", "words": [[0, 202668], [5, 202812], [12, 203132], [22, 203772], [28, 204112], [39, 204582], [43, 205052], [50, 205392], [55, 205657], [59, 205797], [62, 205917], [69, 206297], [80, 206877], [84, 207037], [87, 207197]]}, {"verse": 33, "start": 208047, "end": 213218, "text": "Así, que, hermanos míos, cuando os juntáis a comer, esperaos unos a otros.", "words": [[0, 208047], [5, 208292], [10, 208552], [19, 208932], [25, 209652], [32, 209792], [35, 209992], [43, 210432], [45, 210532], [52, 211232], [61, 211892], [66, 212252], [68, 212652]]}, {"verse": 34, "start": 213568, "end": 220387, "text": "Si alguno tiene hambre, coma en su casa, porque no os juntéis para juicio. Las demás cosas ordenaré cuando llegue.", "words": [[0, 213568], [3, 213714], [10, 214094], [16, 214334], [24, 214954], [29, 215154], [32, 215334], [35, 215454], [41, 216094], [48, 216374], [51, 216634], [54, 216754], [62, 217174], [67, 217414], [75, 218233], [79, 218352], [85, 218612], [91, 219012], [100, 219612], [107, 219792]]}]}