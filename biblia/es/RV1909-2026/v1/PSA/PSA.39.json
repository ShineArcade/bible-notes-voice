{"book": "PSA", "chapter": 39, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 104916, "verses": [{"verse": 1, "start": 300, "end": 13936, "text": "Al Músico principal, a Jedutún: Salmo de David. YO DIJE: Atenderé a mis caminos, para no pecar con mi lengua: guardaré mi boca con freno, en tanto que el impío esté contra mí.", "words": [[0, 300], [3, 478], [10, 958], [21, 1562], [23, 2165], [32, 3011], [38, 3450], [41, 3610], [48, 4644], [51, 4913], [57, 5421], [66, 6161], [68, 6221], [72, 6361], [81, 6921], [86, 7401], [89, 7581], [95, 7921], [99, 8121], [102, 8321], [110, 9134], [119, 9597], [122, 9757], [127, 9957], [131, 10237], [138, 10957], [141, 11177], [147, 11437], [151, 11677], [154, 11837], [160, 12477], [165, 13097], [172, 13497]]}, {"verse": 2, "start": 14386, "end": 20462, "text": "Enmudecí con silencio, me callé aun respecto de lo bueno: y se excitó mi dolor.", "words": [[0, 14733], [9, 15113], [13, 15273], [23, 15913], [26, 16093], [32, 16533], [36, 16973], [45, 17413], [48, 17713], [51, 17853], [58, 18690], [60, 18857], [63, 18977], [70, 19777], [73, 19877]]}, {"verse": 3, "start": 20912, "end": 29306, "text": "Se enardeció mi corazón dentro de mí; en mi meditación se encendió fuego, y así proferí con mi lengua:", "words": [[0, 20912], [3, 21355], [13, 21835], [16, 21995], [24, 22435], [31, 22815], [34, 23135], [38, 23778], [41, 24058], [44, 24238], [55, 24958], [58, 25158], [67, 25758], [74, 26738], [76, 26818], [80, 26998], [88, 27658], [92, 27838], [95, 28018]]}, {"verse": 4, "start": 29756, "end": 37681, "text": "Hazme saber, Jehová, mi fin, y cuánta sea la medida de mis días; sepa yo cuánto tengo de ser del mundo.", "words": [[0, 29756], [6, 30216], [13, 30616], [21, 31016], [24, 31216], [29, 31696], [31, 32376], [38, 32816], [42, 33076], [45, 33236], [52, 33596], [55, 33836], [59, 33976], [65, 34948], [70, 35393], [73, 35573], [80, 36153], [86, 36413], [89, 36593], [93, 36813], [97, 37013]]}, {"verse": 5, "start": 38131, "end": 48903, "text": "He aquí diste a mis días término corto, y mi edad es como nada delante de ti: ciertamente es completa vanidad todo hombre que vive. (Selah.)", "words": [[0, 38173], [3, 38253], [8, 38493], [14, 38933], [16, 38933], [20, 39033], [25, 39253], [33, 39793], [40, 40733], [42, 40993], [45, 41193], [50, 41573], [53, 41733], [58, 41973], [63, 42253], [71, 42793], [74, 42933], [78, 43611], [90, 44451], [93, 44571], [102, 45071], [110, 45771], [115, 45971], [122, 46471], [126, 46671], [132, 48622]]}, {"verse": 6, "start": 49353, "end": 56829, "text": "Ciertamente en tinieblas anda el hombre; ciertamente en vano se afana: amontona riquezas y no sabe quién las recogerá.", "words": [[0, 49394], [12, 49464], [15, 49534], [25, 49604], [30, 49674], [33, 49744], [41, 50574], [53, 51380], [56, 51560], [61, 51960], [64, 52360], [71, 53310], [80, 53610], [89, 54330], [91, 54930], [94, 55070], [99, 55350], [105, 55650], [109, 55930]]}, {"verse": 7, "start": 57279, "end": 61546, "text": "Y ahora, Señor, ¿qué esperaré? Mi esperanza en ti está.", "words": [[0, 57279], [2, 57626], [9, 57966], [16, 58726], [21, 58866], [31, 59937], [34, 60084], [44, 60644], [47, 60844], [50, 61004]]}, {"verse": 8, "start": 61996, "end": 67836, "text": "Líbrame de todas mis rebeliones; no me pongas por burla del insensato.", "words": [[0, 61996], [8, 62767], [11, 62947], [17, 63247], [21, 63547], [33, 65002], [36, 65171], [39, 65311], [46, 65831], [50, 66051], [56, 66571], [60, 66771]]}, {"verse": 9, "start": 68286, "end": 72271, "text": "Enmudecí, no abrí mi boca; porque tú lo hiciste.", "words": [[0, 68724], [10, 69194], [13, 69614], [18, 69934], [21, 70074], [27, 70932], [34, 71232], [37, 71552], [40, 71752]]}, {"verse": 10, "start": 72721, "end": 77890, "text": "Quita de sobre mí tu plaga; de la guerra de tu mano soy consumido.", "words": [[0, 73003], [6, 73317], [9, 73630], [15, 73930], [18, 74210], [21, 74369], [28, 75416], [31, 75676], [34, 75796], [41, 76076], [44, 76316], [47, 76456], [52, 76696], [56, 76956]]}, {"verse": 11, "start": 78340, "end": 89978, "text": "Con castigos sobre el pecado corriges al hombre, y haces consumirse como de polilla su grandeza: ciertamente vanidad es todo hombre. (Selah.)", "words": [[0, 78340], [4, 78704], [13, 79104], [19, 79424], [22, 79644], [29, 80174], [38, 80704], [41, 80904], [49, 81184], [51, 81704], [57, 82024], [68, 83004], [73, 83564], [76, 83784], [84, 84284], [87, 84484], [97, 86141], [109, 86141], [117, 87265], [120, 87665], [125, 88265], [133, 89696]]}, {"verse": 12, "start": 90428, "end": 100805, "text": "Oye mi oración, oh Jehová, y escucha mi clamor: no calles a mis lágrimas; porque forastero soy para ti, y advenedizo, como todos mis padres.", "words": [[0, 90428], [4, 90713], [7, 90873], [16, 91386], [19, 91900], [27, 92413], [29, 92573], [37, 93073], [40, 93213], [48, 94143], [51, 94330], [58, 94750], [60, 94870], [64, 94970], [74, 96002], [81, 96426], [91, 96886], [95, 97086], [100, 97366], [104, 97686], [106, 98246], [118, 99166], [123, 99626], [129, 99886], [133, 100146]]}, {"verse": 13, "start": 101255, "end": 104516, "text": "Déjame, y tomaré fuerzas, antes que vaya y perezca.", "words": [[0, 101255], [8, 101741], [10, 101941], [17, 102361], [26, 102901], [32, 103221], [36, 103441], [41, 103806], [43, 104172]]}]}