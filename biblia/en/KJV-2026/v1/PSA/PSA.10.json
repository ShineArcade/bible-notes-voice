{"book": "PSA", "chapter": 10, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 121253, "verses": [{"verse": 1, "start": 300, "end": 4911, "text": "Why do you stand afar off, O LORD? why do you hide yourself in times of trouble?", "words": [[0, 300], [4, 467], [7, 607], [11, 707], [17, 1007], [22, 1287], [27, 1567], [29, 1847], [35, 2702], [39, 2868], [42, 3008], [46, 3108], [51, 3328], [60, 3728], [63, 3928], [69, 4188], [72, 4368]]}, {"verse": 2, "start": 5361, "end": 11717, "text": "The wicked in his pride does persecute the poor: let them be taken in the devices that they have imagined.", "words": [[0, 5361], [4, 5442], [11, 5722], [14, 5942], [18, 6062], [24, 6422], [29, 6702], [39, 7442], [43, 7522], [49, 8421], [53, 8559], [58, 8759], [61, 8939], [67, 9299], [70, 9599], [74, 9719], [82, 10239], [87, 10579], [92, 10759], [97, 10939]]}, {"verse": 3, "start": 12167, "end": 18099, "text": "For the wicked boasts of his heart’s desire, and blesses the covetous, whom the LORD abhors.", "words": [[0, 12167], [4, 12266], [8, 12366], [15, 12626], [22, 13206], [25, 13446], [29, 13586], [37, 14026], [45, 14506], [49, 15026], [57, 15526], [61, 15686], [71, 16606], [76, 16806], [80, 17006], [85, 17266]]}, {"verse": 4, "start": 18549, "end": 24670, "text": "The wicked, through the pride of his countenance, will not seek after God: God is not in all his thoughts.", "words": [[0, 18549], [4, 18655], [12, 18895], [20, 19175], [24, 19295], [30, 19655], [33, 19795], [37, 19935], [50, 20615], [55, 21015], [59, 21235], [64, 21555], [70, 21915], [75, 22815], [79, 23038], [82, 23278], [86, 23458], [89, 23638], [93, 23858], [97, 24038]]}, {"verse": 5, "start": 25120, "end": 32471, "text": "His ways are always grievous; your judgments are far above out of his sight: as for all his enemies, he puffs at them.", "words": [[0, 25120], [4, 25259], [9, 25559], [13, 25819], [20, 26159], [30, 27265], [35, 27411], [45, 27831], [49, 28171], [53, 28431], [59, 28