{"book": "MRK", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 343572, "verses": [{"verse": 1, "start": 300, "end": 3734, "text": "Principio del evangelio de Jesucristo, Hijo de Dios.", "words": [[0, 300], [10, 822], [14, 1182], [24, 1922], [27, 2022], [39, 2902], [44, 3042], [47, 3202]]}, {"verse": 2, "start": 4184, "end": 12928, "text": "Como está escrito en Isaías el profeta: He aquí yo envío a mi mensajero delante de ti, quien preparará tu camino delante de ti.", "words": [[0, 4184], [5, 4327], [10, 4507], [18, 4887], [21, 5147], [28, 5607], [31, 5827], [40, 6775], [43, 7098], [48, 7418], [51, 7638], [57, 8098], [59, 8198], [62, 8298], [72, 8958], [80, 9378], [83, 9538], [87, 9778], [93, 10138], [103, 11178], [106, 11378], [113, 11698], [121, 12338], [124, 12518]]}, {"verse": 3, "start": 13378, "end": 19843, "text": "Voz del que clama en el desierto: Preparad el camino del Señor; enderezad sus veredas.", "words": [[0, 13378], [4, 13804], [8, 14524], [12, 14744], [18, 14964], [21, 15184], [24, 15384], [34, 16780], [43, 17080], [46, 17260], [53, 17560], [57, 17860], [64, 19108], [74, 19353], [78, 19599]]}, {"verse": 4, "start": 20293, "end": 29149, "text": "Bautizaba Juan en el desierto, y predicaba el bautismo del arrepentimiento para perdón de pecados.", "words": [[0, 21621], [10, 22441], [15, 22861], [18, 23181], [21, 23321], [31, 24041], [33, 24541], [43, 25281], [46, 25421], [55, 26061], [59, 26301], [75, 27461], [80, 27741], [87, 28321], [90, 28461]]}, {"verse": 5, "start": 29599, "end": 39779, "text": "Y salía a él toda la provincia de Judea, y los de Jerusalén; y eran todos bautizados por él en el río de Jordán, confesando sus pecados.", "words": [[0, 29599], [2, 29721], [8, 30201], [10, 30481], [13, 30701], [18, 31001], [21, 31241], [31, 31841], [34, 31961], [41, 32541], [43, 32681], [47, 32821], [50, 32941], [61, 34052], [63, 34332], [68, 34512], [74, 34872], [85, 35872], [89, 36132], [92, 36352], [95, 36792], [98, 36932], [102, 37232], [105, 37332], [113, 38072], [124, 38772], [128, 38952]]}, {"verse": 6, "start": 40229, "end": 51059, "text": "Y Juan andaba vestido de pelos de camello, y con un cinturón de cuero alrededor de su cintura; y comía langostas y miel silvestre.", "words": [[0, 40229], [2, 40368], [7, 40688], [14, 41468], [22, 42108], [25, 42348], [31, 42588], [34, 42788], [43, 43368], [45, 43848], [49, 44128], [52, 44328], [61, 45248], [64, 45408], [70, 45868], [80, 46348], [83, 46868], [86, 47008], [95, 48087], [97, 48344], [103, 48764], [113, 49644], [115, 49824], [120, 50124]]}, {"verse": 7, "start": 51509, "end": 60352, "text": "Y predicaba, diciendo: Viene tras mí el que es más poderoso que yo, al cual no soy digno de agacharme para desatar la correa de sus sandalias.", "words": [[0, 51509], [2, 51730], [13, 52410], [23, 53508], [29, 53738], [34, 54004], [37, 54271], [40, 54351], [44, 54511], [47, 54671], [51, 54851], [60, 55411], [64, 55591], [68, 56371], [71, 56551], [76, 56711], [79, 56891], [83, 57071], [89, 57491], [92, 57551], [102, 58071], [107, 58311], [115, 58711], [118, 58931], [125, 59291], [128, 59391], [132, 59551]]}, {"verse": 8, "start": 60802, "end": 65881, "text": "Yo a la verdad os he bautizado con agua; pero él os bautizará con Espíritu Santo.", "words": [[0, 60802], [3, 60978], [5, 61058], [8, 61098], [15, 61358], [18, 61678], [21, 61778], [31, 62238], [35, 62498], [41, 63218], [46, 63392], [49, 63612], [52, 63752], [62, 64512], [66, 64672], [75, 65312]]}, {"verse": 9, "start": 66231, "end": 74695, "text": "Y aconteció en aquellos días, que Jesús vino de Nazaret de Galilea, y fue bautizado por Juan en el Jordán.", "words": [[0, 66231], [2, 66357], [12, 67017], [15, 67157], [24, 67397], [30, 68497], [34, 68737], [40, 69077], [45, 69617], [48, 69877], [56, 70497], [59, 70837], [68, 71537], [70, 71897], [74, 72057], [84, 72757], [88, 73117], [93, 73537], [96, 73797], [99, 73877]]}, {"verse": 10, "start": 75145, "end": 82818, "text": "Y luego, subiendo del agua, vio abrirse los cielos, y al Espíritu como paloma, que descendía sobre él.", "words": [[0, 75145], [2, 75311], [9, 75471], [18, 76191], [22, 76431], [28, 77011], [32, 77331], [40, 77871], [44, 78031], [52, 78731], [54, 78991], [57, 79251], [66, 79891], [71, 80091], [79, 80651], [83, 81131], [93, 81991], [99, 82291]]}, {"verse": 11, "start": 83268, "end": 90378, "text": "Y hubo una voz de los cielos que decía: Tú eres mi Hijo amado; en ti tengo complacencia.", "words": [[0, 83268], [2, 83407], [7, 83727], [11, 83967], [15, 84227], [18, 84447], [22, 84787], [29, 85127], [33, 85247], [40, 86190], [43, 86352], [48, 86732], [51, 87072], [56, 87292], [63, 88411], [66, 88570], [69, 88730], [75, 89110]]}, {"verse": 12, "start": 90728, "end": 93537, "text": "Y luego el Espíritu le impulsa al desierto.", "words": [[0, 90728], [2, 90870], [8, 91030], [11, 91270], [20, 91870], [23, 91950], [31, 92590], [34, 92690]]}, {"verse": 13, "start": 93987, "end": 102917, "text": "Y estuvo allí en el desierto cuarenta días, y era tentado de Satanás; y estaba con las fieras; y los ángeles le servían.", "words": [[0, 93987], [2, 94067], [9, 94407], [14, 94707], [17, 94867], [20, 94987], [29, 95417], [38, 95847], [44, 96507], [46, 96967], [50, 97127], [58, 97767], [61, 97907], [70, 99043], [72, 99209], [79, 99409], [83, 99649], [87, 99789], [95, 100917], [97, 101004], [101, 101124], [109, 101604], [112, 102084]]}, {"verse": 14, "start": 103367, "end": 110706, "text": "Pero después que Juan fue encarcelado, Jesús vino a Galilea predicando el evangelio del reino de Dios,", "words": [[0, 103367], [5, 103511], [13, 103871], [17, 104131], [22, 104411], [26, 104771], [39, 105991], [45, 106251], [50, 106851], [52, 107131], [60, 107771], [71, 108711], [74, 108851], [84, 109531], [88, 109711], [94, 110091], [97, 110251]]}, {"verse": 15, "start": 111156, "end": 119291, "text": "Y diciendo: El tiempo se ha cumplido, y el reino de Dios está cerca: arrepentíos, y creed al evangelio.", "words": [[0, 111156], [2, 111396], [12, 112450], [15, 112600], [22, 112940], [25, 113180], [28, 113300], [38, 114040], [40, 114380], [43, 114540], [49, 114940], [52, 115080], [57, 115360], [62, 115640], [69, 116678], [82, 117720], [84, 117860], [90, 118300], [93, 118420]]}, {"verse": 16, "start": 119741, "end": 128880, "text": "Y pasando junto al mar de Galilea, vio a Simón, y a Andrés su hermano, que echaban la red en el mar; porque eran pescadores.", "words": [[0, 119741], [2, 119830], [10, 120250], [16, 120550], [19, 120830], [23, 121050], [26, 121210], [35, 122290], [39, 122530], [41, 122690], [48, 123190], [50, 123410], [52, 123490], [59, 124090], [62, 124150], [71, 125090], [75, 125170], [83, 125690], [86, 125830], [90, 126150], [93, 126430], [96, 126550], [101, 127259], [108, 127483], [113, 127803]]}, {"verse": 17, "start": 129330, "end": 135168, "text": "Y les dijo Jesús: Venid en pos de mí, y haré que seáis pescadores de hombres.", "words": [[0, 129330], [2, 129422], [6, 129552], [11, 129872], [18, 130908], [24, 131333], [27, 131573], [31, 131773], [34, 131993], [38, 132193], [40, 132913], [45, 133193], [49, 133273], [55, 133653], [66, 134253], [69, 134493]]}, {"verse": 18, "start": 135618, "end": 138265, "text": "Y luego, dejadas sus redes, le siguieron.", "words": [[0, 135618], [2, 135723], [9, 135943], [17, 136483], [21, 136703], [28, 137043], [31, 137483]]}, {"verse": 19, "start": 138715, "end": 149570, "text": "Y pasando de allí un poco más adelante, vio a Jacobo, hijo de Zebedeo, y a Juan su hermano, también ellos en el navío, que arreglaban las redes.", "words": [[0, 138715], [2, 138821], [10, 139241], [13, 139521], [18, 139761], [21, 139921], [26, 140141], [30, 140401], [40, 141121], [44, 141341], [46, 141541], [54, 142621], [59, 142881], [62, 143601], [71, 144321], [73, 144501], [75, 144581], [80, 144841], [83, 145041], [92, 145821], [100, 146121], [106, 146621], [109, 146941], [112, 147081], [119, 147941], [123, 148021], [134, 148641], [138, 148881]]}, {"verse": 20, "start": 150020, "end": 156787, "text": "Y luego los llamó: y dejando a su padre Zebedeo en el barco con los jornaleros, fueron en pos de él.", "words": [[0, 150020], [2, 150283], [8, 150503], [12, 150803], [19, 151612], [21, 151755], [29, 152215], [31, 152295], [34, 152435], [40, 152935], [48, 153435], [51, 153555], [54, 153655], [60, 154115], [64, 154335], [68, 154515], [80, 155555], [87, 155815], [90, 156045], [94, 156275], [97, 156495]]}, {"verse": 21, "start": 157237, "end": 163699, "text": "Y entraron en Capernaum; y luego los sábados, entrando en la sinagoga, enseñaba.", "words": [[0, 157237], [2, 157386], [11, 157986], [14, 158146], [25, 159431], [27, 159564], [33, 159724], [37, 159944], [46, 160864], [55, 161444], [58, 161604], [61, 161704], [71, 162744]]}, {"verse": 22, "start": 164149, "end": 171464, "text": "Y se admiraban de su enseñanza; porque les enseñaba como quien tiene autoridad, y no como los escribas.", "words": [[0, 164149], [2, 164314], [5, 164394], [15, 164974], [18, 165154], [21, 165314], [32, 166549], [39, 166793], [43, 167013], [52, 167813], [57, 168033], [63, 168313], [69, 168673], [80, 169453], [82, 170053], [85, 170213], [90, 170453], [94, 170633]]}, {"verse": 23, "start": 171914, "end": 177400, "text": "Y había en la sinagoga de ellos un hombre con espíritu inmundo, el cual gritó,", "words": [[0, 171914], [2, 172033], [8, 172233], [11, 172493], [14, 172613], [23, 173233], [26, 173433], [32, 173753], [35, 174133], [42, 174453], [46, 174693], [55, 175273], [64, 176313], [67, 176493], [72, 176693]]}, {"verse": 24, "start": 177850, "end": 185873, "text": "Diciendo: ¡Ah! ¿qué tienes con nosotros, Jesús nazareno? ¿Has venido a destruirnos? Sé quién eres, el Santo de Dios.", "words": [[0, 177850], [10, 178924], [15, 179656], [20, 179754], [27, 180034], [31, 180314], [41, 181034], [47, 181194], [57, 182320], [62, 182498], [69, 182838], [71, 182918], [84, 184106], [87, 184295], [93, 184495], [99, 184735], [102, 184895], [108, 185215], [111, 185335]]}, {"verse": 25, "start": 186223, "end": 189962, "text": "Y Jesús le reprendió, diciendo: Calla, y sal de él.", "words": [[0, 186223], [2, 186346], [8, 186706], [11, 187346], [22, 187986], [32, 189501], [39, 189605], [41, 189708], [45, 189811], [48, 189915]]}, {"verse": 26, "start": 190412, "end": 196771, "text": "Y el espíritu inmundo lo convulsionó y, clamando a gran voz, salió de él.", "words": [[0, 191658], [2, 191898], [5, 192018], [14, 192578], [22, 192998], [25, 193178], [37, 194058], [40, 194558], [49, 195078], [51, 195198], [56, 195358], [61, 195938], [67, 196258], [70, 196418]]}, {"verse": 27, "start": 197221, "end": 210605, "text": "Y todos se maravillaron, de tal manera que preguntaban entre sí, diciendo: ¿Qué es esto? ¿Qué nueva doctrina es esta, que con autoridad aun a los espíritus inmundos manda, y le obedecen?", "words": [[0, 197221], [2, 197344], [8, 197684], [11, 198304], [25, 199764], [28, 199944], [32, 200124], [39, 200484], [43, 200724], [55, 201464], [61, 201784], [65, 202604], [75, 203763], [80, 203895], [83, 204055], [89, 204758], [94, 204843], [100, 205043], [109, 205563], [112, 205803], [118, 206523], [122, 206563], [126, 206743], [136, 207016], [140, 207290], [142, 207563], [146, 207763], [156, 208363], [165, 208863], [172, 209543], [174, 209783], [177, 209863]]}, {"verse": 28, "start": 210955, "end": 215660, "text": "Y vino luego su fama por toda la provincia alrededor de Galilea.", "words": [[0, 210955], [2, 211082], [7, 211322], [13, 211662], [16, 211922], [21, 212422], [25, 212642], [30, 212942], [33, 213182], [43, 213882], [53, 214262], [56, 214842]]}, {"verse": 29, "start": 216110, "end": 223300, "text": "Y luego saliendo de la sinagoga, vinieron a casa de Simón y de Andrés, con Jacobo y Juan.", "words": [[0, 216110], [2, 216233], [8, 216473], [17, 217173], [20, 217333], [23, 217453], [33, 218533], [42, 219113], [44, 219253], [49, 219533], [52, 219753], [58, 220313], [60, 220493], [63, 220573], [71, 221413], [75, 221633], [82, 222433], [84, 222753]]}, {"verse": 30, "start": 223750, "end": 229283, "text": "Y la suegra de Simón estaba acostada con fiebre; y le hablaron luego de ella.", "words": [[0, 223750], [2, 224010], [5, 224350], [12, 224690], [15, 224810], [21, 225330], [28, 225730], [37, 226370], [41, 226570], [49, 227489], [51, 227613], [54, 227753], [63, 228273], [69, 228493], [72, 228813]]}, {"verse": 31, "start": 229733, "end": 237581, "text": "Entonces llegando él, la tomó de su mano y la levantó; y luego se le quitó la fiebre, y les servía.", "words": [[0, 229733], [9, 230239], [18, 231239], [22, 231539], [25, 231879], [30, 232219], [33, 232299], [36, 232459], [41, 232839], [43, 233359], [46, 233479], [55, 234542], [57, 234689], [63, 234909], [66, 235189], [69, 235309], [75, 235649], [78, 235749], [86, 236209], [88, 236529], [92, 236669]]}, {"verse": 32, "start": 238031, "end": 245792, "text": "Y cuando fue la tarde, luego que el sol se puso, traían a él todos los enfermos, y endemoniados;", "words": [[0, 238031], [2, 238303], [9, 238523], [13, 238783], [16, 238923], [23, 239723], [29, 240003], [33, 240303], [36, 240463], [40, 240683], [43, 240923], [49, 241883], [56, 242523], [58, 242683], [61, 242863], [67, 243203], [71, 243543], [81, 244383], [83, 244703]]}, {"verse": 33, "start": 246242, "end": 248854, "text": "Y toda la ciudad se juntó a la puerta.", "words": [[0, 246242], [2, 246379], [7, 246599], [10, 246839], [17, 247159], [20, 247519], [26, 247999], [28, 248059], [31, 248139]]}, {"verse": 34, "start": 249304, "end": 259095, "text": "Y sanó a muchos que estaban enfermos de diversas enfermedades, y echó fuera muchos demonios; y no dejaba decir a los demonios que le conocían.", "words": [[0, 249304], [2, 249431], [7, 249811], [9, 249911], [16, 250191], [20, 250431], [28, 250671], [37, 251331], [40, 251471], [49, 252011], [63, 252931], [65, 253531], [70, 253851], [76, 254111], [83, 254371], [93, 255601], [95, 255726], [98, 255866], [105, 256326], [111, 256746], [113, 257266], [117, 257406], [126, 257966], [130, 258086], [133, 258206]]}, {"verse": 35, "start": 259545, "end": 268304, "text": "Y levantándose muy de mañana, cuando todavía estaba oscuro, salió y se fue a un lugar desierto, y allí oraba.", "words": [[0, 259545], [2, 259666], [15, 260586], [19, 260846], [22, 261026], [30, 261906], [37, 262126], [45, 262606], [52, 263006], [60, 263886], [66, 264446], [68, 264966], [71, 265126], [75, 265346], [77, 265486], [80, 265606], [86, 265946], [96, 266766], [98, 267286], [103, 267506]]}, {"verse": 36, "start": 268754, "end": 271974, "text": "Y le siguió Simón, y los que estaban con él;", "words": [[0, 268754], [2, 268880], [5, 268980], [12, 269420], [19, 270020], [21, 270440], [25, 270600], [29, 270760], [37, 271100], [41, 271440]]}, {"verse": 37, "start": 272424, "end": 275630, "text": "Y hallándole, le dicen: Todos te buscan.", "words": [[0, 272424], [2, 272569], [14, 273489], [17, 273649], [24, 274619], [30, 274783], [33, 275043]]}, {"verse": 38, "start": 275980, "end": 282758, "text": "Y les dice: Vamos a los lugares vecinos, para que predique también allí; porque para esto he venido.", "words": [[0, 275980], [2, 276121], [6, 276241], [12, 277089], [18, 277396], [20, 277576], [24, 277716], [32, 278036], [41, 278676], [46, 279376], [50, 279536], [59, 279996], [67, 280336], [73, 281350], [80, 281500], [85, 281760], [90, 282040], [93, 282200]]}, {"verse": 39, "start": 283208, "end": 289478, "text": "Y predicaba en las sinagogas de ellos en toda Galilea, y echaba fuera los demonios.", "words": [[0, 283208], [2, 283373], [12, 284253], [15, 284433], [19, 284593], [29, 285393], [32, 285533], [38, 285833], [41, 286113], [46, 286353], [55, 287353], [57, 287693], [64, 288113], [70, 288373], [74, 288673]]}, {"verse": 40, "start": 289928, "end": 297997, "text": "Y un leproso vino a él, rogándole; y arrodillándose, le dice: Si quieres, puedes limpiarme.", "words": [[0, 289928], [2, 290067], [5, 290207], [13, 290827], [18, 291167], [20, 291407], [24, 292147], [35, 293528], [37, 293690], [53, 295210], [56, 295430], [62, 296220], [65, 296420], [74, 296740], [81, 297100]]}, {"verse": 41, "start": 298347, "end": 304999, "text": "Y Jesús, teniendo misericordia de él, extendió su mano, y le tocó, y le dice: Quiero, sé limpio.", "words": [[0, 298347], [2, 298470], [9, 299290], [18, 299750], [31, 300570], [34, 300710], [38, 300950], [47, 301470], [50, 301590], [56, 301890], [58, 302030], [61, 302130], [67, 302610], [69, 302730], [72, 302830], [78, 304228], [86, 304228], [89, 304364]]}, {"verse": 42, "start": 305449, "end": 309816, "text": "Y así que hubo él hablado, la lepra se fue luego de aquel, y fue limpio.", "words": [[0, 305449], [2, 305558], [6, 305718], [10, 305938], [15, 306278], [18, 306378], [27, 307178], [30, 307258], [36, 307618], [39, 307778], [43, 307938], [49, 308158], [52, 308448], [59, 308738], [61, 308878], [65, 309038]]}, {"verse": 43, "start": 310266, "end": 313374, "text": "Entonces le advirtió, y le despidió luego,", "words": [[0, 310266], [9, 310730], [12, 311050], [22, 311690], [24, 311950], [27, 312090], [36, 312750]]}, {"verse": 44, "start": 313824, "end": 326502, "text": "Y le dice: Mira, no digas a nadie nada; sino ve, muéstrate al sacerdote, y presenta por tu purificación la ofrenda que Moisés mandó, para testimonio a ellos.", "words": [[0, 313824], [2, 313947], [5, 314047], [11, 314897], [17, 315424], [20, 315684], [26, 316044], [28, 316144], [34, 316404], [40, 317525], [45, 317685], [49, 318085], [59, 318705], [62, 318945], [73, 319705], [75, 319945], [84, 320745], [88, 320965], [91, 321185], [104, 321985], [107, 322305], [115, 322845], [119, 322965], [126, 323385], [133, 324005], [138, 325025], [149, 325865], [151, 325985]]}, {"verse": 45, "start": 326952, "end": 343172, "text": "Pero cuando él salió, comenzó a publicarlo mucho, y a divulgar el hecho, de manera que ya Jesús no podía entrar públicamente en la ciudad, sino que estaba fuera en los lugares desiertos; y venían a él de todas partes.", "words": [[0, 326952], [5, 327076], [12, 327550], [15, 328024], [22, 328496], [30, 329176], [32, 329546], [43, 329916], [50, 330296], [52, 330816], [54, 330916], [63, 331476], [66, 331656], [73, 332016], [76, 332656], [83, 332876], [87, 333156], [90, 333316], [96, 333696], [99, 334056], [105, 334416], [112, 334756], [125, 335636], [128, 335776], [131, 335896], [139, 336785], [144, 337085], [148, 337285], [155, 337585], [161, 338005], [164, 338245], [168, 338425], [176, 339005], [187, 340673], [189, 340777], [196, 341257], [198, 341537], [201, 341857], [204, 341996], [210, 342217]]}]}