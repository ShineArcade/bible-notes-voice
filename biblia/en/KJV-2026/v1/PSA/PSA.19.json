{"book": "PSA", "chapter": 19, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 94045, "verses": [{"verse": 1, "start": 300, "end": 4865, "text": "The heavens declare the glory of God; and the firmament shows his handywork.", "words": [[0, 300], [4, 396], [12, 656], [20, 1096], [24, 1356], [30, 1716], [33, 1876], [38, 2691], [42, 2836], [46, 2936], [56, 3396], [62, 3776], [66, 4341]]}, {"verse": 2, "start": 5315, "end": 8738, "text": "Day to day utters speech, and night to night shows knowledge.", "words": [[0, 5315], [4, 5544], [7, 5704], [11, 5954], [18, 6204], [26, 6844], [30, 7024], [36, 7264], [39, 7464], [45, 7644], [51, 7964]]}, {"verse": 3, "start": 9188, "end": 13231, "text": "There is no speech nor language, where their voice is not heard.", "words": [[0, 9188], [6, 9332], [9, 9492], [12, 9692], [19, 10172], [23, 10412], [33, 11012], [39, 11652], [45, 11832], [51, 12212], [54, 12412], [58, 12612]]}, {"verse": 4, "start": 13681, "end": 20866, "text": "Their line is gone out through all the earth, and their words to the end of the world. In them has he set a tabernacle for the sun,", "words": [[0, 13681], [6, 13805], [11, 14145], [14, 14345], [19, 14585], [23, 14865], [31, 15145], [35, 15365], [39, 15526], [46, 15766], [50, 16145], [56, 16325], [62, 16705], [65, 16966], [69, 17106], [73, 17286], [76, 17405], [80, 17525], [87, 18351], [90, 18481], [95, 18621], [99, 18881], [102, 19121], [106, 19361], [108, 19481], [119, 20021], [123, 20201], [127, 20341]]}, {"verse": 5, "start": 21316, "end": 26789, "text": "Which is as a bridegroom coming out of his chamber, and rejoices as a strong man to run a race.", "words": [[0, 21316], [6, 21465], [9, 21625], [12, 21765], [14, 21885], [25, 22445], [32, 22685], [36, 22945], [39, 23045], [43, 23165], [52, 23585], [56, 24145], [65, 24745], [68, 24985], [70, 25085], [77, 25405], [81, 25785], [84, 25965], [88, 26165], [90, 26285]]}, {"verse": 6, "start": 27239, "end": 35422, "text": "His go