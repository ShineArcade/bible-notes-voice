{"book": "GEN", "chapter": 34, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 238925, "verses": [{"verse": 1, "start": 300, "end": 5585, "text": "And Dinah the daughter of Leah, which she bore to Jacob, went out to see the daughters of the land.", "words": [[0, 300], [4, 440], [10, 880], [14, 880], [23, 1140], [26, 1360], [32, 2020], [38, 2200], [42, 2400], [47, 2600], [50, 2760], [57, 3600], [62, 3920], [66, 4100], [69, 4240], [73, 4400], [77, 4540], [87, 4800], [90, 5040], [94, 5120]]}, {"verse": 2, "start": 5935, "end": 13619, "text": "And when Shechem the son of Hamor the Hivite, prince of the country, saw her, he took her, and lay with her, and defiled her.", "words": [[0, 5935], [4, 6076], [9, 6426], [17, 6776], [21, 6916], [25, 7216], [28, 7356], [34, 7836], [38, 8316], [46, 8796], [53, 9016], [56, 9236], [60, 9356], [69, 9996], [73, 10256], [78, 10876], [81, 10996], [86, 11216], [91, 11496], [95, 11836], [99, 12056], [104, 12276], [109, 12456], [113, 12696], [121, 13236]]}, {"verse": 3, "start": 13969, "end": 21066, "text": "And his soul clung to Dinah the daughter of Jacob, and he loved the young woman, and spoke kindly to the young woman.", "words": [[0, 13969], [4, 14117], [8, 14237], [13, 14557], [19, 14997], [22, 15177], [28, 15577], [32, 15677], [41, 15977], [44, 16217], [51, 17077], [55, 17357], [58, 17517], [64, 17897], [68, 18137], [74, 18337], [81, 18677], [85, 19217], [91, 19497], [98, 19957], [101, 20277], [105, 20437], [111, 20637]]}, {"verse": 4, "start": 21416, "end": 26053, "text": "And Shechem spoke to his father Hamor, saying, Get me this young woman to wife.", "words": [[0, 21416], [4, 21776], [12, 22136], [18, 22396], [21, 22636], [25, 22836], [32, 23296], [39, 23756], [47, 24496], [51, 24677], [54, 24817], [59, 24997], [65, 25237], [71, 25517], [74, 25717]]}, {"verse": 5, "start": 26333, "end": 34442, "text": "And Jacob heard that he had defiled Dinah his daughter: now his sons were with his cattle in the field: and Jacob kept silent until they were come.", "words": [[0, 26333], [4, 26468], [10, 26728], [16, 27048], [21, 27228], [24, 27368], [28, 27488], [36, 27928], [42, 28368], [46, 28568], [56, 29354], [60, 29563], [64, 29763], [69, 30063], [74, 30283], [79, 30483], [83, 30603], [90, 30943], [93, 31163], [97, 31263], [104, 32015], [108, 32156], [114, 32456], [119, 32756], [126, 33216], [132, 33616], [137, 33816], [142, 33936]]}, {"verse": 6, "start": 34792, "end": 38408, "text": "¶ And Hamor the father of Shechem went out to Jacob to commune with him.", "words": [[2, 34792], [6, 35083], [12, 35393], [16, 35433], [23, 35733], [26, 36093], [34, 36453], [39, 36573], [43, 36733], [46, 36913], [52, 37233], [55, 37433], [63, 37893], [68, 38033]]}, {"verse": 7, "start": 38758, "end": 50768, "text": "And the sons of Jacob came out of the field when they heard it: and the men were grieved, and they were very angry, because he had wrought folly in Israel in lying with Jacob’s daughter; which thing ought not to be done.", "words": [[0, 38758], [4, 38886], [8, 38986], [13, 39246], [16, 39406], [22, 39746], [27, 40046], [31, 40286], [34, 40386], [38, 40486], [44, 40766], [49, 41006], [54, 41166], [60, 41386], [64, 41797], [68, 41959], [72, 42039], [76, 42239], [81, 42419], [90, 43299], [94, 43579], [99, 43699], [104, 43839], [109, 44159], [116, 44959], [124, 45359], [127, 45599], [131, 45719], [139, 45999], [145, 46299], [148, 46599], [155, 46979], [158, 47259], [164, 47579], [169, 47839], [177, 48319], [187, 49041], [193, 49190], [199, 49530], [205, 49770], [209, 49950], [212, 50150], [215, 50270]]}, {"verse": 8, "start": 51118, "end": 57315, "text": "And Hamor communed with them, saying, The soul of my son Shechem longs for your daughter: please give her him to wife.", "words": [[0, 51118], [4, 51398], [10, 51708], [19, 52268], [24, 52408], [30, 52828], [38, 53579], [42, 53664], [47, 53964], [50, 54084], [53, 54224], [57, 54504], [65, 54864], [71, 55264], [75, 55384], [80, 55504], [90, 56148], [97, 56325], [102, 56565], [106, 56685], [110, 56865], [113, 57025]]}, {"verse": 9, "start": 57665, "end": 61667, "text": "And make marriages with us, and give your daughters to us, and take our daughters to you.", "words": [[0, 57665], [4, 57768], [9, 57908], [19, 58308], [24, 58568], [28, 58748], [32, 59068], [37, 59248], [42, 59368], [52, 59668], [55, 59928], [59, 60168], [63, 60488], [68, 60728], [72, 60868], [82, 61148], [85, 61408]]}, {"verse": 10, "start": 62017, "end": 68229, "text": "And you shall dwell with us: and the land shall be before you; dwell and trade you in it, and get you possessions in it.", "words": [[0, 62017], [4, 62176], [8, 62296], [14, 62476], [20, 62716], [25, 62936], [29, 63565], [33, 63701], [37, 63821], [42, 64061], [48, 64281], [51, 64441], [58, 64781], [63, 65311], [69, 65597], [73, 65857], [79, 66157], [83, 66317], [86, 66417], [90, 66597], [94, 66917], [98, 67097], [102, 67257], [114, 67617], [117, 67937]]}, {"verse": 11, "start": 68509, "end": 75374, "text": "And Shechem said to her father and to her brethren, Let me find grace in your eyes, and what you shall say to me I will give.", "words": [[0, 68509], [4, 68764], [12, 69054], [17, 69254], [20, 69454], [24, 69574], [31, 69954], [35, 70354], [38, 70534], [42, 70654], [52, 71530], [56, 71674], [59, 71814], [64, 72054], [70, 72414], [73, 72634], [78, 72774], [84, 73294], [88, 73534], [93, 73694], [97, 73854], [103, 74014], [107, 74254], [110, 74394], [113, 74554], [115, 74754], [120, 74914]]}, {"verse": 12, "start": 75724, "end": 81724, "text": "Ask me never so much dowry and gift, and I will give according as you shall say to me: but give me the young woman to wife.", "words": [[0, 75724], [4, 75923], [7, 76103], [13, 76343], [16, 76603], [21, 76783], [27, 77263], [31, 77363], [37, 77943], [41, 78083], [43, 78203], [48, 78323], [53, 78503], [63, 78863], [66, 79123], [70, 79243], [76, 79403], [80, 79623], [83, 79803], [87, 80247], [91, 80344], [96, 80504], [99, 80624], [103, 80704], [109, 80924], [115, 81184], [118, 81364]]}, {"verse": 13, "start": 82004, "end": 89212, "text": "And the sons of Jacob answered Shechem and Hamor his father deceitfully, and said, because he had defiled Dinah their sister:", "words": [[0, 82004], [4, 82156], [8, 82256], [13, 82536], [16, 82736], [22, 83116], [31, 83646], [39, 84176], [43, 84416], [49, 84656], [53, 84776], [60, 85136], [73, 86256], [77, 86396], [83, 86716], [91, 87096], [94, 87356], [98, 87516], [106, 87996], [112, 88476], [118, 88616]]}, {"verse": 14, "start": 89562, "end": 97328, "text": "And they said to them, We cannot do this thing, to give our sister to one that is uncircumcised; for that were a reproach to us:", "words": [[0, 89562], [4, 89684], [9, 89824], [14, 90064], [17, 90244], [23, 90704], [26, 90904], [33, 91264], [36, 91644], [41, 91904], [48, 92384], [51, 92624], [56, 92784], [60, 92984], [67, 93324], [70, 93544], [74, 93824], [79, 94024], [82, 94164], [97, 95566], [101, 95677], [106, 95897], [111, 96157], [113, 96277], [122, 96737], [125, 96937]]}, {"verse": 15, "start": 97678, "end": 103659, "text": "But in this will we consent to you: If you will be as we are, that every male of you be circumcised;", "words": [[0, 97678], [4, 97801], [7, 97941], [12, 98221], [17, 98501], [20, 98701], [28, 99081], [31, 99381], [36, 99954], [39, 100087], [43, 100247], [48, 100427], [51, 100627], [54, 100807], [57, 101027], [62, 101467], [67, 101647], [73, 101927], [78, 102227], [81, 102407], [85, 102567], [88, 102727]]}, {"verse": 16, "start": 104009, "end": 112224, "text": "Then will we give our daughters to you, and we will take your daughters to us, and we will dwell with you, and we will become one people.", "words": [[0, 104009], [5, 104264], [10, 104504], [13, 104664], [18, 104844], [22, 105024], [32, 105384], [35, 105724], [40, 106304], [44, 106844], [47, 107004], [52, 107144], [57, 107384], [62, 107584], [72, 107924], [75, 108264], [79, 108784], [83, 109024], [86, 109204], [91, 109344], [97, 109604], [102, 109884], [107, 110444], [111, 110764], [114, 110924], [119, 111064], [126, 111404], [130, 111684]]}, {"verse": 17, "start": 112574, "end": 118485, "text": "But if you will not hearken to us, to be circumcised; then will we take our daughter, and we will be gone.", "words": [[0, 112574], [4, 112687], [7, 112787], [11, 112947], [16, 113087], [20, 113307], [28, 113687], [31, 113927], [35, 114187], [38, 114547], [41, 114687], [54, 115826], [59, 115947], [64, 116187], [67, 116387], [72, 116607], [76, 116807], [86, 117127], [90, 117487], [93, 117687], [98, 117847], [101, 118007]]}, {"verse": 18, "start": 118835, "end": 122006, "text": "And their words pleased Hamor, and Shechem Hamor’s son.", "words": [[0, 118835], [4, 118972], [10, 119092], [16, 119392], [24, 119902], [31, 120412], [35, 120805], [43, 121199], [51, 121592]]}, {"verse": 19, "start": 122356, "end": 130038, "text": "And the young man deferred not to do the thing, because he had delight in Jacob’s daughter: and he was more honourable than all the house of his father.", "words": [[0, 122356], [4, 122480], [8, 122580], [14, 122780], [18, 122980], [27, 123460], [31, 123680], [34, 123920], [37, 124060], [41, 124180], [48, 124680], [56, 125100], [59, 125380], [63, 125580], [71, 125960], [74, 126240], [82, 126700], [92, 127394], [96, 127524], [99, 127604], [103, 127744], [108, 128054], [119, 128364], [124, 128664], [128, 128844], [132, 129004], [138, 129224], [141, 129364], [145, 129484]]}, {"verse": 20, "start": 130388, "end": 136429, "text": "¶ And Hamor and Shechem his son came to the gate of their city, and communed with the men of their city, saying,", "words": [[2, 130388], [6, 130649], [12, 130939], [16, 131359], [24, 131779], [28, 131959], [32, 132259], [37, 132579], [40, 132779], [44, 132899], [49, 133099], [52, 133219], [58, 133379], [64, 133699], [68, 134239], [77, 134779], [82, 134879], [86, 135019], [90, 135219], [93, 135319], [99, 135479], [105, 135899]]}, {"verse": 21, "start": 136779, "end": 150403, "text": "These men are peaceable with us; therefore let them dwell in the land, and trade in it; for the land, behold, it is large enough for them; let us take their daughters to us for wives, and let us give them our daughters.", "words": [[0, 136779], [6, 137022], [10, 137362], [14, 137682], [24, 138222], [29, 138482], [33, 139168], [43, 139668], [47, 139868], [52, 140048], [58, 140328], [61, 140608], [65, 140728], [71, 141108], [75, 141468], [81, 141788], [84, 142028], [88, 142516], [92, 142664], [96, 142864], [102, 143524], [110, 144444], [113, 144564], [116, 144704], [122, 145004], [129, 145244], [133, 145544], [139, 146274], [143, 146407], [146, 146567], [151, 146767], [157, 146987], [167, 147327], [170, 147647], [173, 147867], [177, 148047], [184, 148447], [188, 148792], [192, 148972], [195, 149132], [200, 149352], [205, 149572], [209, 149712]]}, {"verse": 22, "start": 150753, "end": 160394, "text": "Only herein will the men consent to us to dwell with us, to be one people, if every male among us be circumcised, as they are circumcised.", "words": [[0, 150753], [5, 151048], [12, 151668], [17, 151868], [21, 152028], [25, 152268], [33, 152748], [36, 153088], [39, 153308], [42, 153468], [48, 153768], [53, 154048], [57, 154628], [60, 154848], [63, 155048], [67, 155308], [75, 156348], [78, 156448], [84, 156808], [89, 157068], [95, 157408], [98, 157668], [101, 157868], [114, 158788], [117, 159028], [122, 159248], [126, 159388]]}, {"verse": 23, "start": 160744, "end": 168254, "text": "Shall not their cattle and their substance and every beast of theirs be ours? only let us consent to them, and they will dwell with us.", "words": [[0, 160744], [6, 160884], [10, 161084], [16, 161304], [23, 161594], [27, 161884], [33, 162024], [43, 162744], [47, 162864], [53, 163164], [59, 163504], [62, 163724], [69, 163944], [72, 164244], [78, 165089], [83, 165337], [87, 165577], [90, 165697], [98, 166137], [101, 166377], [107, 166597], [111, 167097], [116, 167217], [121, 167377], [127, 167617], [132, 167897]]}, {"verse": 24, "start": 168604, "end": 178173, "text": "And to Hamor and to Shechem his son hearkened all that went out of the gate of his city; and every male was circumcised, all that went out of the gate of his city.", "words": [[0, 168604], [4, 168767], [7, 169057], [13, 169347], [17, 169567], [20, 169927], [28, 170287], [32, 170387], [36, 170807], [46, 171227], [50, 171467], [55, 171647], [60, 171827], [64, 172027], [67, 172167], [71, 172267], [76, 172487], [79, 172627], [83, 172747], [89, 173448], [93, 173844], [99, 174304], [104, 174644], [108, 174884], [121, 176124], [125, 176344], [130, 176544], [135, 176744], [139, 176944], [142, 177104], [146, 177204], [151, 177404], [154, 177544], [158, 177704]]}, {"verse": 25, "start": 178523, "end": 191460, "text": "¶ And it came to pass on the third day, when they were in pain, that two of the sons of Jacob, Simeon and Levi, Dinah’s brethren, took each man his sword, and came upon the city boldly, and killed all the males.", "words": [[2, 178523], [6, 178642], [9, 178742], [14, 178902], [17, 179042], [22, 179262], [25, 179462], [29, 179602], [35, 179842], [40, 180202], [45, 180442], [50, 180602], [55, 180762], [58, 180882], [64, 181562], [69, 182002], [73, 182262], [76, 182382], [80, 182522], [85, 182762], [88, 182942], [95, 183782], [102, 184322], [106, 184722], [112, 185122], [120, 185522], [130, 186405], [135, 186545], [140, 186765], [144, 187025], [148, 187245], [155, 187665], [159, 188165], [164, 188365], [169, 188625], [173, 188845], [178, 189085], [186, 189705], [190, 190125], [197, 190385], [201, 190645], [205, 190805]]}, {"verse": 26, "start": 191810, "end": 198685, "text": "And they killed Hamor and Shechem his son with the edge of the sword, and took Dinah out of Shechem’s house, and went out.", "words": [[0, 191810], [4, 191956], [9, 192096], [16, 192486], [22, 192876], [26, 193176], [34, 193836], [38, 193956], [42, 194356], [47, 194456], [51, 194576], [56, 194796], [59, 194936], [63, 195036], [70, 195696], [74, 195876], [79, 196176], [85, 196476], [89, 196736], [92, 196836], [102, 197436], [109, 197696], [113, 198016], [118, 198196]]}, {"verse": 27, "start": 199035, "end": 204726, "text": "The sons of Jacob came upon the slain, and spoiled the city, because they had defiled their sister.", "words": [[0, 199035], [4, 199146], [9, 199406], [12, 199586], [18, 199886], [23, 200166], [28, 200466], [32, 200706], [39, 201146], [43, 201666], [51, 202026], [55, 202306], [61, 202586], [69, 203146], [74, 203386], [78, 203526], [86, 203966], [92, 204146]]}, {"verse": 28, "start": 205076, "end": 212223, "text": "They took their sheep, and their oxen, and their donkeys, and that which was in the city, and that which was in the field,", "words": [[0, 205076], [5, 205258], [10, 205478], [16, 205698], [23, 206038], [27, 206578], [33, 206718], [39, 207258], [43, 207778], [49, 207938], [58, 208438], [62, 208998], [67, 209238], [73, 209458], [77, 209658], [80, 209838], [84, 209958], [90, 210218], [94, 210778], [99, 211018], [105, 211198], [109, 211398], [112, 211578], [116, 211678]]}, {"verse": 29, "start": 212573, "end": 219393, "text": "And all their wealth, and all their little ones, and their wives took they captive, and spoiled even all that was in the house.", "words": [[0, 212573], [4, 212700], [8, 212960], [14, 213160], [22, 213520], [26, 213820], [30, 214020], [36, 214180], [43, 214440], [49, 214780], [53, 215000], [59, 215140], [65, 215640], [70, 215960], [75, 216180], [84, 216620], [88, 217145], [96, 217585], [101, 217945], [105, 218245], [110, 218405], [114, 218565], [117, 218745], [121, 218885]]}, {"verse": 30, "start": 219743, "end": 234908, "text": "And Jacob said to Simeon and Levi, You have troubled me to make me to stink among the inhabitants of the land, among the Canaanites and the Perizzites: and I being few in number, they shall gather themselves together against me, and slay me; and I shall be destroyed, I and my house.", "words": [[0, 219743], [4, 219868], [10, 220208], [15, 220508], [18, 220708], [25, 221268], [29, 221690], [35, 222236], [39, 222336], [44, 222436], [53, 222736], [56, 222916], [59, 223076], [64, 223236], [67, 223356], [70, 223496], [76, 223776], [82, 224036], [86, 224256], [98, 224676], [101, 224956], [105, 225076], [111, 225616], [117, 225816], [121, 226036], [132, 226676], [136, 226996], [140, 227451], [152, 228068], [156, 228185], [158, 228345], [164, 228525], [168, 228905], [171, 229065], [179, 229665], [184, 229805], [190, 229965], [197, 230265], [208, 230585], [217, 231005], [225, 231365], [229, 231865], [233, 231945], [238, 232345], [242, 232727], [246, 232832], [248, 232912], [254, 233052], [257, 233172], [268, 233992], [270, 234092], [274, 234252], [277, 234412]]}, {"verse": 31, "start": 235188, "end": 238525, "text": "And they said, Should he deal with our sister as with a harlot?", "words": [[0, 235188], [4, 235308], [9, 235448], [15, 235708], [22, 235928], [25, 236128], [30, 236388], [35, 236588], [39, 236768], [46, 237208], [49, 237648], [54, 237818], [56, 237988]]}]}