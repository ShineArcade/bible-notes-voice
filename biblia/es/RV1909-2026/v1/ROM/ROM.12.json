{"book": "ROM", "chapter": 12, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 150294, "verses": [{"verse": 1, "start": 300, "end": 10676, "text": "Así que, hermanos, os ruego por las misericordias de Dios, que presentéis vuestros cuerpos en sacrificio vivo, santo, agradable a Dios, que es vuestro racional culto.", "words": [[0, 300], [4, 560], [9, 800], [19, 1760], [22, 1900], [28, 2200], [32, 2400], [36, 2560], [50, 3360], [53, 3540], [59, 3840], [63, 4360], [74, 4940], [83, 5280], [91, 5780], [94, 5940], [105, 6580], [111, 7280], [118, 7780], [128, 8280], [130, 8400], [136, 9020], [140, 9100], [143, 9240], [151, 9600], [160, 10040]]}, {"verse": 2, "start": 11126, "end": 21479, "text": "Y no os conforméis a este siglo; sino transformaos por la renovación de vuestro entendimiento, para que experimentéis cuál sea la buena voluntad de Dios, agradable y perfecta.", "words": [[0, 11126], [2, 11251], [5, 11391], [8, 11531], [19, 12151], [21, 12271], [26, 12451], [33, 13305], [38, 13481], [51, 14261], [55, 14441], [58, 14561], [69, 15221], [72, 15421], [80, 15761], [95, 16661], [100, 17241], [104, 17401], [118, 18181], [123, 18381], [127, 18641], [130, 18801], [136, 19001], [145, 19541], [148, 19641], [154, 19901], [164, 20721], [166, 20801]]}, {"verse": 3, "start": 21929, "end": 37049, "text": "Digo pues por la gracia que me es dada, a cada cual que está entre vosotros, que no tenga más alto concepto de sí que el que debe tener, sino que piense de sí con sensatez, conforme a la medida de fe que Dios repartió a cada uno.", "words": [[0, 21929], [5, 22125], [10, 22385], [14, 22665], [17, 22805], [24, 23245], [28, 23325], [31, 23465], [34, 23605], [40, 23925], [42, 24385], [47, 24585], [52, 24805], [56, 25025], [61, 25185], [67, 25405], [77, 25925], [81, 26445], [84, 26605], [90, 26825], [94, 27045], [99, 27285], [108, 27905], [111, 28005], [114, 28225], [118, 28425], [121, 28545], [125, 28685], [130, 28865], [137, 29695], [142, 29889], [146, 30049], [153, 30489], [156, 30629], [159, 30829], [163, 31419], [173, 32009], [182, 32609], [184, 32689], [187, 32749], [194, 33089], [197, 33309], [200, 33549], [204, 33709], [209, 33989], [218, 34569], [220, 34709], [225, 34889]]}, {"verse": 4, "start": 37499, "end": 43086, "text": "Porque de la manera que en un cuerpo tenemos muchos miembros, pero no todos los miembros tienen la misma función;", "words": [[0, 37499], [7, 37730], [10, 37870], [13, 37990], [20, 38270], [24, 38510], [27, 38610], [30, 38730], [37, 39050], [45, 39390], [52, 39830], [62, 40510], [67, 40650], [70, 40870], [76, 41170], [80, 41390], [89, 41830], [96, 42050], [99, 42230], [105, 42410]]}, {"verse": 5, "start": 43536, "end": 48315, "text": "Así muchos somos un cuerpo en Cristo, pero todos miembros los unos de los otros.", "words": [[0, 43536], [4, 43775], [11, 44035], [17, 44415], [20, 44655], [27, 44995], [30, 45195], [38, 46055], [43, 46135], [49, 46395], [58, 46955], [62, 47135], [67, 47395], [70, 47575], [74, 47735]]}, {"verse": 6, "start": 48765, "end": 56070, "text": "De manera que, teniendo diferentes dones según la gracia que nos es dada, si el de profecía, úsese conforme a la medida de la fe;", "words": [[0, 48765], [3, 48870], [10, 49070], [15, 49350], [24, 49730], [35, 50090], [41, 50750], [47, 50970], [50, 51210], [57, 51650], [61, 51750], [65, 51890], [68, 52090], [74, 52830], [77, 52890], [80, 52990], [83, 53110], [93, 53780], [99, 54450], [108, 55010], [110, 55070], [113, 55130], [120, 55430], [123, 55590], [126, 55710]]}, {"verse": 7, "start": 56520, "end": 60372, "text": "O si ministerio, en servir; o el que enseña, en doctrina;", "words": [[0, 56520], [2, 56637], [5, 56797], [17, 57517], [20, 57677], [28, 58538], [30, 58684], [33, 58824], [37, 58944], [45, 59504], [48, 59724]]}, {"verse": 8, "start": 60822, "end": 69889, "text": "El que exhorta, en exhortar; el que reparte, hágalo con generosidad; el que dirige, con dedicación; el que hace misericordia, con alegría.", "words": [[0, 60864], [3, 60944], [7, 61064], [16, 61604], [19, 61884], [29, 62900], [32, 63036], [36, 63156], [45, 63916], [52, 64316], [56, 64456], [69, 65576], [72, 65675], [76, 65795], [84, 66295], [88, 66555], [100, 67765], [103, 67845], [107, 67965], [112, 68185], [126, 69005], [130, 69225]]}, {"verse": 9, "start": 70339, "end": 74952, "text": "El amor sea sin fingimiento: aborreciendo lo malo, llegándoos a lo bueno;", "words": [[0, 70339], [3, 70442], [8, 70662], [12, 70962], [16, 71222], [29, 72671], [42, 72945], [45, 73218], [51, 73738], [62, 74258], [64, 74398], [67, 74478]]}, {"verse": 10, "start": 75402, "end": 81502, "text": "Amándoos los unos a los otros con amor fraternal; dándoos preferencia en honra los unos a los otros;", "words": [[0, 75402], [9, 76046], [13, 76186], [18, 76446], [20, 76666], [24, 76786], [30, 77066], [34, 77326], [39, 77546], [50, 78644], [58, 79129], [70, 79849], [73, 79989], [79, 80249], [83, 80449], [88, 80649], [90, 80849], [94, 80949]]}, {"verse": 11, "start": 81952, "end": 86808, "text": "En el cuidado no perezosos; ardientes en espíritu; sirviendo al Señor;", "words": [[0, 81952], [3, 82078], [6, 82158], [14, 82498], [17, 82718], [28, 83813], [38, 84412], [41, 84612], [51, 85554], [61, 86095], [64, 86255]]}, {"verse": 12, "start": 87258, "end": 92705, "text": "Gozosos en la esperanza; sufridos en la tribulación; constantes en la oración;", "words": [[0, 87258], [8, 87858], [11, 87978], [14, 88078], [25, 89132], [34, 89692], [37, 89832], [40, 89932], [53, 91126], [64, 91810], [67, 91930], [70, 92050]]}, {"verse": 13, "start": 93155, "end": 97683, "text": "Contribuyendo a las necesidades de los santos; siguiendo la hospitalidad.", "words": [[0, 93594], [14, 93914], [16, 94014], [20, 94114], [32, 94734], [35, 94914], [39, 95034], [47, 96034], [57, 96654], [60, 96814]]}, {"verse": 14, "start": 98133, "end": 102631, "text": "Bendecid a los que os persiguen: bendecid, y no maldigáis.", "words": [[0, 98585], [9, 99055], [11, 99235], [15, 99355], [19, 99475], [22, 99595], [33, 101325], [43, 101665], [45, 102005], [48, 102345]]}, {"verse": 15, "start": 103081, "end": 106295, "text": "Gozaos con los que se gozan: llorad con los que lloran.", "words": [[0, 103081], [7, 103642], [11, 103822], [15, 103922], [19, 104062], [22, 104182], [29, 105012], [36, 105375], [40, 105515], [44, 105655], [48, 105795]]}, {"verse": 16, "start": 106745, "end": 113550, "text": "Unánimes entre vosotros: no altivos, sino relacionándoos con los humildes. No seáis sabios en vuestra opinión.", "words": [[0, 106944], [9, 107184], [15, 107424], [25, 108493], [28, 108634], [37, 109074], [42, 109684], [57, 110294], [61, 110534], [65, 110694], [75, 111641], [78, 111828], [84, 112188], [91, 112568], [94, 112728], [102, 113008]]}, {"verse": 17, "start": 114000, "end": 118725, "text": "No paguéis a nadie mal por mal; procurad lo bueno delante de todos los hombres.", "words": [[0, 114000], [3, 114146], [11, 114546], [13, 114666], [19, 114926], [23, 115186], [27, 115366], [32, 116103], [41, 116569], [44, 116689], [50, 116989], [58, 117469], [61, 117629], [67, 117829], [71, 118049]]}, {"verse": 18, "start": 119175, "end": 124146, "text": "Si se puede hacer, en cuanto dependa de vosotros, tened paz con todos los hombres.", "words": [[0, 119175], [3, 119296], [6, 119456], [12, 119716], [19, 120096], [22, 120456], [29, 120656], [37, 121256], [40, 121336], [50, 122156], [56, 122556], [60, 122776], [64, 123056], [70, 123276], [74, 123496]]}, {"verse": 19, "start": 124596, "end": 136139, "text": "No os venguéis vosotros mismos, amados míos; más bien, dejad lugar a la ira de Dios; porque escrito está: Mía es la venganza: yo pagaré, dice el Señor.", "words": [[0, 124596], [3, 124781], [6, 125081], [15, 125381], [24, 125841], [32, 126501], [39, 126881], [45, 127761], [49, 127945], [55, 128425], [61, 128705], [67, 128925], [69, 129105], [72, 129205], [76, 129485], [79, 129605], [85, 130363], [92, 130569], [100, 131009], [106, 131850], [110, 132112], [113, 132392], [116, 132492], [126, 133750], [129, 133914], [137, 135053], [142, 135452], [145, 135592]]}, {"verse": 20, "start": 136589, "end": 145554, "text": "Así que, si tu enemigo tiene hambre, dale de comer; si tiene sed, dale de beber: que haciendo esto, brasas de fuego amontonas sobre su cabeza.", "words": [[0, 136589], [4, 136797], [9, 136977], [12, 137117], [15, 137277], [23, 137677], [29, 137957], [37, 138377], [42, 138677], [45, 138837], [52, 139654], [55, 139778], [61, 140018], [66, 140578], [71, 140818], [74, 140978], [81, 141737], [85, 141839], [94, 142199], [100, 142789], [107, 143379], [110, 143539], [116, 143859], [126, 144559], [132, 144759], [135, 144959]]}, {"verse": 21, "start": 146004, "end": 149894, "text": "No seas vencido de lo malo; pero vence con el bien el mal.", "words": [[0, 146004], [3, 146170], [8, 146430], [16, 147030], [19, 147170], [22, 147290], [28, 148033], [33, 148190], [39, 148570], [43, 148750], [46, 148870], [51, 149430], [54, 149510]]}]}