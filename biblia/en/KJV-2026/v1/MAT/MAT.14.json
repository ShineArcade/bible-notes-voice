{"book": "MAT", "chapter": 14, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 236487, "verses": [{"verse": 1, "start": 300, "end": 4154, "text": "At that time Herod the tetrarch heard of the fame of Jesus,", "words": [[0, 300], [3, 448], [8, 668], [13, 1448], [19, 1868], [23, 1988], [32, 2568], [38, 2748], [41, 2928], [45, 3048], [50, 3328], [53, 3468]]}, {"verse": 2, "start": 4604, "end": 12599, "text": "And said to his servants, This is John the Baptist; he is risen from the dead; and therefore mighty works do show forth themselves in him.", "words": [[0, 4604], [4, 4753], [9, 4973], [12, 5213], [16, 5373], [26, 6297], [31, 6496], [34, 6676], [39, 6936], [43, 7116], [52, 8080], [55, 8185], [58, 8345], [64, 8605], [69, 8825], [73, 8965], [79, 9664], [83, 9806], [93, 10146], [100, 10526], [106, 10826], [109, 11046], [114, 11286], [120, 11546], [131, 11986], [134, 12266]]}, {"verse": 3, "start": 12949, "end": 19799, "text": "¶ For Herod had laid hold on John, and bound him, and put him in prison for Herodias’ sake, his brother Philip’s wife.", "words": [[2, 12949], [6, 13049], [12, 13469], [16, 13649], [21, 13829], [26, 14129], [29, 14389], [35, 14749], [39, 15149], [45, 15469], [50, 15749], [54, 16249], [58, 16429], [62, 16589], [65, 16709], [72, 17009], [76, 17249], [86, 17929], [92, 18529], [96, 18609], [104, 18889], [113, 19409]]}, {"verse": 4, "start": 20249, "end": 24110, "text": "For John said to him, It is not lawful for you to have her.", "words": [[0, 20249], [4, 20374], [9, 20654], [14, 20954], [17, 21174], [22, 21761], [25, 21886], [28, 22026], [32, 22186], [39, 22626], [43, 22786], [47, 22986], [50, 23086], [55, 23326]]}, {"verse": 5, "start": 24460, "end": 30124, "text": "And when he would have put him to death, he feared the multitude, because they counted him as a prophet.", "words": [[0, 24460], [4, 24592], [9, 24752], [12, 24952], [18, 25112], [23, 25232], [27, 25452], [31, 25592], [34, 25752], [41, 26432], [44, 26632], [51, 26932], [55, 27112], [66, 27972], [74, 28292], [79, 28532], [87, 28912], [91, 29212], [94, 29432], [96, 29532]]}, {"verse": 6, "start": 30574, "end": 36456, "text": "But when Herod’s birthday was kept, the daughter of Herodias danced before them, and pleased Herod.", "words": [[0, 30574], [4, 30682], [9, 30882], [17, 31362], [26, 31682], [30, 32022], [36, 32722], [40, 32862], [49, 33182], [52, 33362], [61, 34042], [68, 34322], [75, 34842], [81, 35162], [85, 35362], [93, 35682]]}, {"verse": 7, "start": 36906, "end": 40838, "text": "Whereupon he promised with an oath to give her whatever she would ask.", "words": [[0, 36906], [10, 37626], [13, 37746], [22, 38146], [27, 38466], [30, 38586], [35, 38806], [38, 39066], [43, 39246], [47, 39446], [56, 39726], [60, 40086], [66, 40266]]}, {"verse": 8, "start": 41288, "end": 46786, "text": "And she, being before instructed of her mother, said, Give me here John Baptist’s head in a platter.", "words": [[0, 41288], [4, 41403], [9, 41583], [15, 41883], [22, 42483], [33, 42843], [36, 43103], [40, 43223], [48, 43703], [54, 44307], [59, 44431], [62, 44631], [67, 44831], [72, 45111], [82, 45851], [87, 45991], [90, 46131], [92, 46231]]}, {"verse": 9, "start": 47136, "end": 55267, "text": "And the king was sorry: nevertheless for the oath’s sake, and them which sat with him at the table, he commanded it to be given her.", "words": [[0, 47136], [4, 47259], [8, 47379], [13, 47599], [17, 47819], [24, 48670], [37, 49158], [41, 49498], [45, 49658], [52, 50058], [58, 50598], [62, 50858], [67, 51098], [73, 51338], [77, 51578], [82, 51818], [86, 51918], [89, 52058], [93, 52138], [100, 52918], [103, 53038], [113, 53518], [116, 53738], [119, 53878], [122, 54058], [128, 54278]]}, {"verse": 10, "start": 55717, "end": 58242, "text": "And he sent, and beheaded John in the prison.", "words": [[0, 55717], [4, 55854], [7, 56014], [13, 56394], [17, 56594], [26, 56974], [31, 57374], [34, 57574], [38, 57674]]}, {"verse": 11, "start": 58692, "end": 64322, "text": "And his head was brought in a platter, and given to the girl: and she brought it to her mother.", "words": [[0, 58692], [4, 58838], [8, 58978], [13, 59238], [17, 59458], [25, 59778], [28, 60038], [30, 60118], [39, 60618], [43, 61138], [49, 61398], [52, 61638], [56, 61758], [62, 62567], [66, 62887], [70, 63047], [78, 63307], [81, 63487], [84, 63687], [88, 63847]]}, {"verse": 12, "start": 64772, "end": 69585, "text": "And his disciples came, and took up the body, and buried it, and went and told Jesus.", "words": [[0, 64772], [4, 64907], [8, 65007], [18, 65527], [24, 65927], [28, 66267], [33, 66447], [36, 66627], [40, 66767], [46, 67087], [50, 67387], [57, 67707], [61, 67927], [65, 68127], [70, 68367], [74, 68627], [79, 68807]]}, {"verse": 13, "start": 70035, "end": 78554, "text": "¶ When Jesus heard of it, he departed from there by ship into a desert place apart: and when the people had heard of it, they followed him on foot out of the cities.", "words": [[2, 70035], [7, 70182], [13, 70442], [19, 70802], [22, 70962], [26, 71382], [29, 71462], [38, 71882], [43, 72162], [49, 72402], [52, 72622], [57, 72922], [62, 73222], [64, 73422], [71, 73702], [77, 74022], [84, 74948], [88, 75069], [93, 75209], [97, 75349], [104, 75609], [108, 75789], [114, 75969], [117, 76089], [121, 76389], [126, 76489], [135, 76849], [139, 77069], [142, 77229], [147, 77469], [151, 77689], [154, 77849], [158, 77949]]}, {"verse": 14, "start": 79004, "end": 86367, "text": "And Jesus went forth, and saw a great multitude, and was moved with compassion toward them, and he healed their sick.", "words": [[0, 79004], [4, 79143], [10, 79443], [15, 79843], [22, 80683], [26, 80843], [30, 81103], [32, 81263], [38, 81463], [49, 82423], [53, 82663], [57, 82823], [63, 83123], [68, 83343], [79, 83883], [86, 84243], [92, 85043], [96, 85243], [99, 85363], [106, 85663], [112, 85903]]}, {"verse": 15, "start": 86817, "end": 98426, "text": "¶ And when it was evening, his disciples came to him, saying, This is a desert place, and the time is now past; send the multitude away, that they may go into the villages, and buy themselves provisions.", "words": [[2, 86817], [6, 87137], [11, 87317], [14, 87437], [18, 87577], [27, 88237], [31, 88357], [41, 88897], [46, 89217], [49, 89437], [54, 89597], [62, 91039], [67, 91214], [70, 91414], [72, 91534], [79, 91754], [86, 92094], [90, 92394], [94, 92514], [99, 92734], [102, 92834], [106, 93014], [112, 93803], [117, 94023], [121, 94163], [131, 94523], [137, 94943], [142, 95343], [147, 95523], [151, 95603], [154, 95843], [159, 96043], [163, 96183], [173, 96523], [177, 97003], [181, 97183], [192, 97523]]}, {"verse": 16, "start": 98776, "end": 103416, "text": "But Jesus said to them, They need not depart; you give them something to eat.", "words": [[0, 98776], [4, 98886], [10, 99206], [15, 99526], [18, 99706], [24, 100294], [29, 100414], [34, 100674], [38, 100934], [46, 101979], [50, 102085], [55, 102265], [60, 102445], [70, 102805], [73, 103025]]}, {"verse": 17, "start": 103766, "end": 107785, "text": "And they say to him, We have here but five loaves, and two fishes.", "words": [[0, 103766], [4, 103904], [9, 104024], [13, 104244], [16, 104424], [21, 105038], [24, 105138], [29, 105358], [34, 105618], [38, 105798], [43, 106078], [51, 106618], [55, 106938], [59, 107158]]}, {"verse": 18, "start": 108135, "end": 110870, "text": "He said, Bring them here to me.", "words": [[0, 108135], [3, 108218], [9, 108957], [15, 109190], [20, 109450], [25, 109710], [28, 109950]]}, {"verse": 19, "start": 111220, "end": 124127, "text": "And he commanded the multitude to sit down on the grass, and took the five loaves, and the two fishes, and looking up to heaven, he blessed, and broke, and gave the loaves to his disciples, and the disciples to the multitude.", "words": [[0, 111220], [4, 111354], [7, 111474], [17, 111934], [21, 112154], [31, 112634], [34, 112914], [38, 113114], [43, 113414], [46, 113574], [50, 113674], [57, 114074], [61, 114374], [66, 114574], [70, 114774], [75, 115094], [83, 115694], [87, 115874], [91, 115994], [95, 116194], [103, 116854], [107, 117214], [115, 117474], [118, 117734], [121, 117894], [129, 118334], [132, 118434], [141, 118874], [145, 119134], [152, 119964], [156, 120084], [161, 120264], [165, 120464], [172, 120904], [175, 121064], [179, 121204], [190, 121784], [194, 122384], [198, 122504], [208, 122984], [211, 123264], [215, 123404]]}, {"verse": 20, "start": 124577, "end": 130519, "text": "And they did all eat, and were filled: and they took up of the fragments that remained twelve baskets full.", "words": [[0, 124577], [4, 124705], [9, 124825], [13, 124965], [17, 125225], [22, 125505], [26, 125845], [31, 126005], [39, 126881], [43, 127007], [48, 127107], [53, 127287], [56, 127487], [59, 127587], [63, 127707], [73, 128127], [78, 128447], [87, 128877], [94, 129307], [102, 129887]]}, {"verse": 21, "start": 130969, "end": 135504, "text": "And they that had eaten were about five thousand men, beside women and children.", "words": [[0, 130969], [4, 131120], [9, 131280], [14, 131480], [18, 131620], [24, 131900], [29, 132260], [35, 132607], [40, 132953], [49, 133300], [54, 133940], [61, 134320], [67, 134740], [71, 134940]]}, {"verse": 22, "start": 135954, "end": 144181, "text": "¶ And immediately Jesus constrained his disciples to get into a ship, and to go before him to the other side, while he sent the multitudes away.", "words": [[2, 135954], [6, 136103], [18, 136443], [24, 137003], [36, 137663], [40, 137843], [50, 138363], [53, 138643], [57, 138823], [62, 139043], [64, 139243], [70, 139543], [74, 140023], [77, 140183], [80, 140323], [87, 140703], [91, 140943], [94, 141123], [98, 141263], [104, 141443], [110, 141903], [116, 142443], [119, 142623], [124, 142843], [128, 143023], [139, 143603]]}, {"verse": 23, "start": 144631, "end": 152372, "text": "And when he had sent the multitudes away, he went up into a mountain apart to pray: and when the evening was come, he was there alone.", "words": [[0, 144631], [4, 144755], [9, 144895], [12, 145095], [16, 145255], [21, 145515], [25, 145695], [36, 146275], [42, 147075], [45, 147235], [50, 147415], [53, 147595], [58, 147795], [60, 147955], [69, 148215], [75, 148555], [78, 148795], [84, 149590], [88, 149718], [93, 149858], [97, 150018], [105, 150258], [109, 150538], [115, 151198], [118, 151358], [122, 151538], [128, 151738]]}, {"verse": 24, "start": 152822, "end": 158355, "text": "But the ship was now in the midst of the sea, tossed with waves: for the wind was contrary.", "words": [[0, 152822], [4, 152946], [8, 153086], [13, 153306], [17, 153546], [21, 153766], [24, 153946], [28, 154046], [34, 154306], [37, 154506], [41, 154626], [46, 155206], [53, 155586], [58, 155886], [65, 156876], [69, 156981], [73, 157101], [78, 157341], [82, 157541]]}, {"verse": 25, "start": 158805, "end": 162501, "text": "And in the fourth watch of the night Jesus went to them, walking on the sea.", "words": [[0, 158805], [4, 158933], [7, 159033], [11, 159133], [18, 159373], [24, 159713], [27, 159853], [31, 159953], [37, 160273], [43, 160453], [48, 160833], [51, 160993], [57, 161413], [65, 161693], [68, 161913], [72, 162033]]}, {"verse": 26, "start": 162951, "end": 170323, "text": "And when the disciples saw him walking on the sea, they were troubled, saying, It is a spirit; and they cried out for fear.", "words": [[0, 162951], [4, 163075], [9, 163195], [13, 163315], [23, 163735], [27, 164055], [31, 164235], [39, 164535], [42, 164775], [46, 164895], [51, 165275], [56, 165315], [61, 165455], [71, 165895], [79, 167613], [82, 167716], [85, 167836], [87, 167936], [95, 168861], [99, 168996], [104, 169116], [110, 169376], [114, 169596], [118, 169796]]}, {"verse": 27, "start": 170773, "end": 177534, "text": "But immediately Jesus spoke to them, saying, Be of good cheer; it is I; be not afraid.", "words": [[0, 170773], [4, 170881], [16, 171521], [22, 171801], [28, 172241], [31, 172441], [37, 172741], [45, 173977], [48, 174114], [51, 174254], [56, 174454], [63, 175358], [66, 175480], [69, 175700], [72, 176626], [75, 176704], [79, 176884]]}, {"verse": 28, "start": 177884, "end": 184116, "text": "And Peter answered him and said, Lord, if it is you, bid me come to you on the water.", "words": [[0, 177884], [4, 178033], [10, 178333], [19, 178773], [23, 179013], [27, 179193], [33, 181164], [39, 181580], [42, 181580], [45, 181700], [48, 181840], [53, 182440], [57, 182640], [60, 182800], [65, 183020], [68, 183200], [72, 183400], [75, 183580], [79, 183700]]}, {"verse": 29, "start": 184466, "end": 191643, "text": "And he said, Come. And when Peter was come down out of the ship, he walked on the water, to go to Jesus.", "words": [[0, 184466], [4, 184601], [7, 184741], [13, 186200], [19, 187098], [23, 187231], [28, 187351], [34, 187611], [38, 187851], [43, 188051], [48, 188331], [52, 188571], [55, 188691], [59, 188811], [65, 189411], [68, 189571], [75, 189871], [78, 190071], [82, 190191], [89, 190491], [92, 190711], [95, 190871], [98, 191011]]}, {"verse": 30, "start": 192093, "end": 199552, "text": "But when he saw the wind boisterous, he was afraid; and beginning to sink, he cried, saying, Lord, save me.", "words": [[0, 192093], [4, 192197], [9, 192337], [12, 192457], [16, 192677], [20, 192837], [25, 193057], [37, 193897], [40, 193957], [44, 194097], [52, 195081], [56, 195211], [66, 195531], [69, 195791], [75, 196271], [78, 196351], [85, 197071], [93, 198621], [99, 199046], [104, 199246]]}, {"verse": 31, "start": 199902, "end": 207703, "text": "And immediately Jesus stretched forth his hand, and caught him, and said to him, O you of little faith, why did you doubt?", "words": [[0, 199902], [4, 200045], [16, 200685], [22, 201005], [32, 201525], [38, 201905], [42, 202145], [48, 202525], [52, 203005], [59, 203285], [64, 203485], [68, 203665], [73, 203865], [76, 204045], [81, 204595], [83, 204793], [87, 205153], [90, 205453], [97, 205673], [104, 206533], [108, 206793], [112, 206993], [116, 207153]]}, {"ver