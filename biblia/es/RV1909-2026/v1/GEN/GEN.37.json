{"book": "GEN", "chapter": 37, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 326857, "verses": [{"verse": 1, "start": 300, "end": 5555, "text": "Y habitó Jacob en la tierra donde vivió su padre, en la tierra de Canaán.", "words": [[0, 300], [2, 477], [9, 897], [15, 1217], [18, 1537], [21, 1677], [28, 2057], [34, 2397], [40, 2937], [43, 3097], [50, 3997], [53, 4137], [56, 4237], [63, 4617], [66, 5114]]}, {"verse": 2, "start": 5905, "end": 25767, "text": "Estas fueron las generaciones de Jacob. José, siendo de edad de diecisiete años apacentaba las ovejas con sus hermanos; y el joven estaba con los hijos de Bilha, y con los hijos de Zilpa, mujeres de su padre: y José informaba a su padre de la mala fama de ellos.", "words": [[0, 5905], [6, 6205], [13, 6425], [17, 6685], [30, 7405], [33, 7565], [40, 8386], [46, 8826], [53, 9426], [56, 9786], [61, 10226], [64, 10686], [75, 11146], [80, 12026], [91, 12906], [95, 13086], [102, 13566], [106, 13806], [110, 13986], [120, 14982], [122, 15111], [125, 15211], [131, 15611], [138, 15891], [142, 16131], [146, 16291], [152, 16571], [155, 16981], [162, 17391], [164, 17811], [168, 18011], [172, 18231], [178, 18511], [181, 19221], [188, 19931], [196, 20311], [199, 20551], [202, 20711], [209, 21617], [211, 21887], [216, 22207], [226, 23187], [228, 23387], [231, 23527], [237, 23947], [240, 24207], [243, 24347], [248, 24647], [253, 25187], [256, 25307]]}, {"verse": 3, "start": 26117, "end": 34008, "text": "Y amaba Israel a José más que a todos sus hijos, porque le había tenido en su vejez: y le hizo una ropa de diversos colores.", "words": [[0, 26117], [2, 26238], [8, 26618], [15, 27038], [17, 27218], [22, 27458], [26, 27738], [30, 27918], [32, 28018], [38, 28258], [42, 28558], [49, 28858], [56, 29478], [59, 29658], [65, 29858], [72, 30178], [75, 30510], [78, 30841], [85, 31323], [87, 31519], [90, 31679], [95, 31959], [99, 32179], [104, 32599], [107, 32719], [116, 33259]]}, {"verse": 4, "start": 34358, "end": 42591, "text": "Y viendo sus hermanos que su padre lo amaba más que a todos sus hermanos, le aborrecían, y no le podían hablar pacíficamente.", "words": [[0, 34358], [2, 34474], [9, 34714], [13, 34934], [22, 35494], [26, 35594], [29, 35754], [35, 36155], [38, 36475], [44, 36875], [48, 37074], [52, 37235], [54, 37354], [60, 37534], [64, 37774], [74, 38475], [77, 38875], [89, 39714], [91, 40195], [94, 40354], [97, 40475], [104, 40915], [111, 41195]]}, {"verse": 5, "start": 42941, "end": 50119, "text": "Y soñó José un sueño, y lo contó a sus hermanos; y ellos vinieron a aborrecerle más todavía.", "words": [[0, 42941], [2, 43211], [7, 43481], [12, 44041], [15, 44121], [22, 44741], [24, 45161], [27, 45301], [33, 45681], [35, 45801], [39, 45921], [49, 46820], [51, 46970], [57, 47290], [66, 47970], [68, 48230], [80, 49110], [84, 49270]]}, {"verse": 6, "start": 50469, "end": 54986, "text": "Y él les dijo: Oíd ahora este sueño que he soñado:", "words": [[0, 50469], [2, 50674], [5, 50914], [9, 51354], [15, 52131], [19, 52537], [25, 52977], [30, 53417], [36, 53957], [40, 54137], [43, 54237]]}, {"verse": 7, "start": 55336, "end": 67505, "text": "He aquí que atábamos manojos en medio del campo, y he aquí que mi manojo se levantaba, y estaba derecho, y que vuestros manojos estaban alrededor, y se inclinaban al mío.", "words": [[0, 55336], [3, 55496], [8, 55776], [12, 55996], [21, 56676], [29, 57216], [32, 57436], [38, 57696], [42, 57916], [49, 58396], [51, 58681], [54, 58861], [59, 59281], [63, 59521], [66, 59661], [73, 60181], [76, 60401], [87, 61281], [89, 61701], [96, 61981], [105, 62561], [107, 62906], [111, 63046], [120, 63346], [128, 63886], [136, 64266], [147, 65634], [149, 65780], [152, 66250], [163, 66720], [166, 66940]]}, {"verse": 8, "start": 67855, "end": 79468, "text": "Y le respondieron sus hermanos: ¿Has de reinar tú sobre nosotros, o nos vas a gobernar? Y le aborrecieron aún más a causa de sus sueños y de sus palabras.", "words": [[0, 67855], [2, 67978], [5, 68118], [18, 68838], [22, 69038], [32, 70239], [37, 70429], [40, 70749], [47, 71209], [50, 71529], [56, 71869], [66, 72529], [68, 73109], [72, 73249], [76, 73469], [78, 73609], [88, 74619], [90, 74760], [93, 74880], [106, 75780], [110, 75980], [114, 76380], [116, 76660], [122, 77000], [125, 77260], [129, 77460], [136, 78120], [138, 78300], [141, 78440], [145, 78620]]}, {"verse": 9, "start": 79818, "end": 92902, "text": "Y soñó aún otro sueño, y lo contó a sus hermanos, diciendo: He aquí que he soñado otro sueño, y he aquí que el sol y la luna y once estrellas se inclinaban a mí.", "words": [[0, 79818], [2, 79940], [7, 80420], [11, 80900], [16, 81220], [23, 82020], [25, 82520], [28, 82660], [34, 83040], [36, 83120], [40, 83260], [50, 83980], [60, 85096], [63, 85243], [68, 85483], [72, 85683], [75, 85783], [82, 86283], [87, 86543], [94, 87483], [96, 87663], [99, 87843], [104, 88083], [108, 88303], [111, 88543], [115, 88863], [117, 89323], [120, 89463], [125, 89883], [127, 90233], [132, 90583], [142, 91363], [145, 91683], [156, 92483], [158, 92623]]}, {"verse": 10, "start": 93252, "end": 106154, "text": "Y lo contó a su padre y a sus hermanos: y su padre le reprendió, y le dijo: ¿Qué sueño es este que soñaste? ¿Hemos de venir yo y tu madre, y tus hermanos, a inclinarnos a ti a tierra?", "words": [[0, 93252], [2, 93362], [5, 93482], [11, 93962], [13, 94062], [16, 94182], [22, 94622], [24, 94902], [26, 95002], [30, 95142], [40, 96206], [42, 96328], [45, 96428], [51, 96868], [54, 97228], [65, 98068], [67, 98728], [70, 98848], [76, 99619], [81, 99719], [87, 100099], [90, 100259], [95, 100499], [99, 100639], [108, 101604], [115, 101843], [118, 102063], [124, 102343], [127, 102703], [129, 102843], [132, 102963], [139, 103283], [141, 103643], [145, 103803], [155, 104463], [157, 104603], [169, 105223], [171, 105403], [174, 105523], [176, 105623]]}, {"verse": 11, "start": 106434, "end": 111451, "text": "Y sus hermanos le tenían envidia, mas su padre meditaba en esto.", "words": [[0, 106434], [2, 106562], [6, 106702], [15, 107262], [18, 107382], [25, 107722], [34, 108962], [38, 109262], [41, 109462], [47, 109822], [56, 110762], [59, 110942]]}, {"verse": 12, "start": 111801, "end": 116057, "text": "Y fueron sus hermanos a apacentar las ovejas de su padre en Siquem.", "words": [[0, 111801], [2, 111908], [9, 112148], [13, 112408], [22, 113008], [24, 113148], [34, 113788], [38, 114028], [45, 114488], [48, 114628], [51, 114788], [57, 115108], [60, 115595]]}, {"verse": 13, "start": 116407, "end": 125027, "text": "Y dijo Israel a José: Tus hermanos apacientan las ovejas en Siquem: ven, y te enviaré a ellos. Y él respondió: Aquí estoy.", "words": [[0, 116407], [2, 116556], [7, 116756], [14, 117236], [16, 117436], [22, 118108], [26, 118192], [35, 118812], [46, 119432], [50, 119572], [57, 119932], [60, 120327], [68, 120891], [73, 121113], [75, 121493], [78, 121613], [86, 122053], [88, 122113], [95, 122906], [97, 123056], [100, 123196], [111, 124158], [116, 124383]]}, {"verse": 14, "start": 125377, "end": 135539, "text": "Y él le dijo: Ve ahora, mira cómo están tus hermanos y cómo están las ovejas, y tráeme la respuesta. Y lo envió del valle de Hebrón, y llegó a Siquem.", "words": [[0, 125377], [2, 125534], [5, 125694], [8, 125874], [14, 126629], [17, 126807], [24, 127087], [29, 127367], [34, 127687], [40, 127947], [44, 128167], [53, 128767], [55, 128887], [60, 129087], [66, 129347], [70, 129507], [78, 130007], [80, 130427], [87, 130787], [90, 130947], [101, 132026], [103, 132150], [106, 132270], [112, 132690], [116, 132890], [122, 133310], [125, 133490], [133, 134090], [135, 134275], [141, 134555], [143, 135083]]}, {"verse": 15, "start": 135889, "end": 143635, "text": "Y lo halló un hombre, andando él perdido por el campo, y le preguntó aquel hombre, diciendo: ¿Qué buscas?", "words": [[0, 135889], [2, 135988], [5, 136128], [11, 136388], [14, 136568], [22, 136988], [30, 137468], [33, 137948], [41, 138528], [45, 138748], [48, 138868], [55, 140068], [57, 140288], [60, 140388], [69, 141048], [75, 141248], [83, 141508], [93, 142905], [98, 143003]]}, {"verse": 16, "start": 143915, "end": 148821, "text": "Y él respondió: Busco a mis hermanos: te ruego que me muestres dónde pastan.", "words": [[0, 143915], [2, 144065], [5, 144205], [16, 145167], [22, 145616], [24, 145736], [28, 145856], [38, 146961], [41, 147071], [47, 147391], [51, 147551], [54, 147801], [63, 148051], [69, 148436]]}, {"verse": 17, "start": 149171, "end": 159787, "text": "Y aquel hombre respondió: Ya se han ido de aquí; y yo les oí decir: Vamos a Dotán. Entonces José fue tras de sus hermanos, y los halló en Dotán.", "words": [[0, 149171], [2, 149346], [8, 149556], [15, 149816], [26, 150995], [29, 151137], [32, 151257], [36, 151397], [40, 151517], [43, 151717], [49, 152369], [51, 152509], [54, 152609], [58, 152729], [61, 152969], [68, 153675], [74, 153915], [76, 154305], [83, 154915], [92, 155559], [97, 156299], [101, 156619], [106, 156879], [109, 157039], [113, 157179], [123, 158279], [125, 158439], [129, 158619], [135, 158979], [138, 159119]]}, {"verse": 18, "start": 160137, "end": 166887, "text": "Y como ellos lo vieron de lejos, antes que cerca de ellos llegara, tramaron contra él para matarle.", "words": [[0, 160137], [2, 160262], [7, 160502], [13, 160722], [16, 160962], [23, 161242], [26, 161402], [33, 162202], [39, 162622], [43, 162902], [49, 163242], [52, 163502], [58, 163722], [67, 164582], [76, 165062], [83, 165482], [86, 165762], [91, 166042]]}, {"verse": 19, "start": 167237, "end": 170837, "text": "Y dijeron el uno al otro: He aquí viene el soñador;", "words": [[0, 167237], [2, 167360], [10, 167880], [13, 168020], [17, 168240], [20, 168460], [26, 169253], [29, 169333], [34, 169533], [40, 169933], [43, 170133]]}, {"verse": 20, "start": 171187, "end": 181089, "text": "Ahora pues, venid, y matémoslo y echémosle en una cisterna, y diremos: Alguna mala bestia le devoró: y veremos qué serán sus sueños.", "words": [[0, 171187], [6, 171473], [12, 172113], [19, 172533], [21, 172893], [31, 173533], [33, 173653], [43, 174313], [46, 174453], [50, 174593], [60, 175413], [62, 175573], [71, 176439], [78, 176981], [83, 177201], [90, 177841], [93, 178201], [101, 179027], [103, 179151], [111, 179551], [115, 179731], [121, 180131], [125, 180311]]}, {"verse": 21, "start": 181439, "end": 186779, "text": "Y como Rubén oyó esto, lo libró de sus manos, y dijo: No lo matemos.", "words": [[0, 181439], [2, 181547], [7, 181787], [13, 182327], [17, 182767], [23, 183647], [26, 183747], [32, 184167], [35, 184247], [39, 184407], [46, 184787], [48, 185007], [54, 185710], [57, 185869], [60, 185989]]}, {"verse": 22, "start": 187059, "end": 197738, "text": "Y les dijo Rubén: No derraméis sangre; echadlo en esta cisterna que está en el desierto, y no pongáis mano en él; por librarlo así de sus manos, para hacerlo volver a su padre.", "words": [[0, 187059], [2, 187208], [6, 187328], [11, 187608], [18, 188546], [21, 188712], [31, 189272], [39, 190055], [47, 190493], [50, 190573], [55, 190773], [64, 191373], [68, 191473], [73, 191693], [76, 191853], [79, 191953], [89, 192513], [91, 192953], [94, 193073], [102, 193493], [107, 193793], [110, 193993], [114, 194559], [118, 194680], [127, 195160], [131, 195400], [134, 195540], [138, 195680], [145, 196020], [150, 196400], [158, 196700], [165, 197040], [167, 197180], [170, 197280]]}, {"verse": 23, "start": 198018, "end": 207149, "text": "Y sucedió que, cuando llegó José a sus hermanos, ellos hicieron desnudar a José su ropa, la ropa de colores que tenía sobre sí;", "words": [[0, 198018], [2, 198184], [10, 198884], [15, 199064], [22, 199384], [28, 199704], [33, 200144], [35, 200344], [39, 200484], [49, 201324], [55, 201604], [64, 202224], [73, 203004], [75, 203084], [80, 203384], [83, 203664], [89, 204624], [92, 204684], [97, 205104], [100, 205244], [108, 205704], [112, 205904], [118, 206264], [124, 206624]]}, {"verse": 24, "start": 207499, "end": 214746, "text": "Y lo tomaron, y le echaron en la cisterna; pero la cisterna estaba vacía, no había en ella agua.", "words": [[0, 207499], [2, 207648], [5, 207768], [14, 208448], [16, 209128], [19, 209248], [27, 209768], [30, 209948], [33, 210108], [43, 211207], [48, 211349], [51, 211739], [60, 212129], [67, 212429], [74, 213129], [77, 213269], [83, 213529], [86, 213869], [91, 214069]]}, {"verse": 25, "start": 215096, "end": 229255, "text": "Y se sentaron a comer pan: y alzando los ojos miraron, y he aquí una compañía de ismaelitas que venía de Galaad, y sus camellos traían aromas y bálsamo y mirra, e iban a llevarlo a Egipto.", "words": [[0, 215096], [2, 215203], [5, 215323], [14, 215963], [16, 216103], [22, 216383], [27, 217401], [29, 217518], [37, 218018], [41, 218258], [46, 218498], [55, 219473], [57, 219573], [60, 219713], [65, 219973], [69, 220193], [78, 220953], [81, 221443], [92, 221933], [96, 222133], [102, 222513], [105, 223013], [113, 223513], [115, 223833], [119, 223973], [128, 224553], [135, 224973], [142, 225473], [144, 225673], [152, 226293], [154, 226823], [161, 227526], [163, 227630], [168, 227890], [170, 227970], [179, 228470], [181, 228610]]}, {"verse": 26, "start": 229605, "end": 236579, "text": "Entonces Judá dijo a sus hermanos: ¿Qué provecho hay en que matemos a nuestro hermano y encubramos su muerte?", "words": [[0, 229605], [9, 230210], [14, 231233], [19, 231575], [21, 231835], [25, 231975], [35, 232988], [40, 233086], [49, 233646], [53, 233866], [56, 233986], [60, 234086], [68, 234506], [70, 234666], [78, 234766], [86, 235326], [88, 235426], [99, 235866], [102, 236086]]}, {"verse": 27, "start": 236929, "end": 245024, "text": "Venid, y vendámosle a los ismaelitas, y no sea nuestra mano sobre él; que nuestro hermano es nuestra carne. Y sus hermanos acordaron con él.", "words": [[0, 236929], [7, 237348], [9, 237508], [20, 238148], [22, 238228], [26, 238618], [38, 239008], [40, 239308], [43, 239428], [47, 239608], [55, 239848], [60, 240128], [66, 240428], [70, 240974], [74, 241053], [82, 241273], [90, 241713], [93, 241793], [101, 242073], [108, 242871], [110, 242995], [114, 243135], [123, 243715], [133, 244355], [137, 244595]]}, {"verse": 28, "start": 245374, "end": 259489, "text": "Y como pasaban los madianitas mercaderes, sacaron ellos a José de la cisterna, y le trajeron arriba, y le vendieron a los ismaelitas por veinte piezas de plata. Y llevaron a José a Egipto.", "words": [[0, 245374], [2, 245621], [7, 245841], [15, 246401], [19, 246581], [30, 247281], [42, 248521], [50, 249101], [56, 249321], [58, 249541], [63, 249881], [66, 250041], [69, 250161], [79, 251141], [81, 251301], [84, 251401], [93, 251981], [101, 252941], [103, 253261], [106, 253361], [116, 253901], [118, 254061], [122, 254201], [133, 255301], [137, 255621], [144, 256061], [151, 256641], [154, 256761], [161, 257576], [163, 257681], [172, 258121], [174, 258261], [179, 258521], [181, 258741]]}, {"verse": 29, "start": 259839, "end": 265880, "text": "Y Rubén volvió a la cisterna, y no halló a José dentro, y rasgó sus vestidos.", "words": [[0, 259839], [2, 259926], [8, 260386], [15, 260906], [17, 261006], [20, 261106], [30, 261906], [32, 262206], [35, 262466], [41, 262846], [43, 262966], [48, 263146], [56, 263686], [58, 264061], [64, 264761], [68, 264961]]}, {"verse": 30, "start": 266230, "end": 271191, "text": "Y volvió a sus hermanos, y dijo: El joven no aparece; y yo, ¿adónde iré yo?", "words": [[0, 266230], [2, 266354], [9, 266754], [11, 266754], [15, 266914], [25, 267534], [27, 267654], [33, 268401], [36, 268488], [42, 268768], [45, 268928], [54, 269765], [56, 269905], [60, 270225], [68, 270545], [72, 270905]]}, {"verse": 31, "start": 271471, "end": 280024, "text": "Entonces tomaron ellos la ropa de José, y degollaron un cabrito de las cabras, y tiñeron la ropa con la sangre;", "words": [[0, 271471], [9, 272096], [17, 272836], [23, 273076], [26, 273296], [31, 273656], [34, 273776], [40, 274156], [42, 274776], [53, 275496], [56, 275776], [64, 276356], [67, 276516], [71, 276676], [79, 277316], [81, 277876], [89, 278396], [92, 278576], [97, 279016], [101, 279196], [104, 279356]]}, {"verse": 32, "start": 280374, "end": 289740, "text": "Y enviaron la ropa de colores y la trajeron a su padre, y dijeron: Esta hemos hallado, reconoce ahora si es o no la ropa de tu hijo.", "words": [[0, 280374], [2, 280521], [11, 281041], [14, 281261], [19, 281621], [22, 281741], [30, 282241], [32, 282481], [35, 282621], [44, 283201], [46, 283281], [49, 283401], [56, 283781], [58, 284066], [67, 285117], [72, 285237], [78, 285437], [87, 286337], [96, 286917], [102, 287177], [105, 287437], [108, 287677], [110, 287877], [113, 288337], [116, 288647], [121, 288957], [124, 289097], [127, 289277]]}, {"verse": 33, "start": 290090, "end": 297195, "text": "Y él la conoció, y dijo: La ropa de mi hijo es; alguna mala bestia le devoró; José ha sido despedazado.", "words": [[0, 290090], [2, 290274], [5, 290434], [8, 290554], [17, 291094], [19, 291314], [25, 291979], [28, 292120], [33, 292440], [36, 292580], [39, 292700], [44, 292880], [48, 293575], [55, 293856], [60, 294136], [67, 294636], [70, 294736], [78, 295435], [83, 295790], [86, 296070], [91, 296290]]}, {"verse": 34, "start": 297475, "end": 304971, "text": "Entonces Jacob rasgó sus vestidos, y puso saco sobre sus lomos, y se enlutó por su hijo muchos días.", "words": [[0, 297475], [9, 298040], [15, 298540], [21, 299360], [25, 299560], [35, 300200], [37, 300720], [42, 301040], [47, 301480], [53, 301720], [57, 302030], [64, 302340], [66, 302780], [69, 302900], [76, 303480], [80, 303640], [83, 303860], [88, 304020], [95, 304360]]}, {"verse": 35, "start": 305321, "end": 318633, "text": "Y se levantaron todos sus hijos y todas sus hijas para consolarlo; mas él no quiso recibir consuelo, y dijo: Porque yo he de descender a mi hijo enlutado hasta la sepultura. Y lo lloró su padre.", "words": [[0, 305321], [2, 305421], [5, 305501], [16, 306121], [22, 306441], [26, 306821], [32, 307161], [34, 307601], [40, 307821], [44, 308141], [50, 308481], [55, 308661], [67, 309877], [71, 310034], [74, 310174], [77, 310334], [83, 310674], [91, 311134], [101, 312394], [103, 312574], [109, 313325], [116, 313558], [119, 313838], [122, 313958], [125, 314038], [135, 314578], [137, 314718], [140, 314878], [145, 315158], [154, 315758], [160, 315978], [163, 316138], [174, 317183], [176, 317345], [179, 317465], [185, 317865], [188, 317925]]}, {"verse": 36, "start": 318983, "end": 326457, "text": "Y los madianitas lo vendieron en Egipto a Potifar, oficial de Faraón, capitán de los de la guardia.", "words": [[0, 318983], [2, 319201], [6, 319321], [17, 320121], [20, 320601], [30, 321101], [33, 321301], [40, 321921], [42, 322161], [51, 323101], [59, 323561], [62, 323781], [70, 324661], [78, 325161], [81, 325301], [85, 325461], [88, 325701], [91, 325821]]}]}