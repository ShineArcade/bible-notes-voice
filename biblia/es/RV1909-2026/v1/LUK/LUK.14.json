{"book": "LUK", "chapter": 14, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 295525, "verses": [{"verse": 1, "start": 300, "end": 8187, "text": "Y aconteció que entrando en casa de un príncipe de los fariseos un sábado a comer pan, ellos le acechaban.", "words": [[0, 300], [2, 423], [12, 1163], [16, 1363], [25, 2063], [28, 2263], [33, 2583], [36, 2843], [39, 2983], [48, 3723], [51, 3883], [55, 4003], [64, 4683], [67, 4863], [74, 5323], [76, 5443], [82, 5663], [87, 6563], [93, 6703], [96, 7445]]}, {"verse": 2, "start": 8637, "end": 14308, "text": "Y he aquí un hombre con hinchazón por retención de líquidos estaba delante de él.", "words": [[0, 8637], [2, 8822], [5, 8962], [10, 9282], [13, 9522], [20, 9822], [24, 10082], [34, 10982], [38, 11222], [48, 11942], [51, 12122], [60, 12682], [67, 13162], [75, 13742], [78, 13922]]}, {"verse": 3, "start": 14758, "end": 23747, "text": "Y respondiendo Jesús, habló a los intérpretes de la ley y a los fariseos, diciendo: ¿Es lícito sanar en sábado?", "words": [[0, 14758], [2, 14886], [15, 15666], [22, 16646], [28, 17066], [30, 17166], [34, 17286], [46, 18166], [49, 18266], [52, 18406], [56, 18726], [58, 19126], [60, 19186], [64, 19306], [74, 20346], [84, 21389], [88, 21573], [95, 22253], [101, 22833], [104, 22993]]}, {"verse": 4, "start": 24197, "end": 29579, "text": "Y ellos callaron. Entonces él tomándole, le sanó, y le despidió.", "words": [[0, 24197], [2, 24361], [8, 24975], [18, 25832], [27, 26320], [30, 26740], [41, 27160], [44, 27580], [50, 28000], [52, 28560], [55, 28680]]}, {"verse": 5, "start": 30029, "end": 38999, "text": "Y respondiendo a ellos dijo: ¿El asno o el buey de cuál de vosotros caerá en algún pozo, y no lo sacará enseguida en día de sábado?", "words": [[0, 30029], [2, 30155], [15, 31015], [17, 31175], [23, 31415], [29, 32458], [33, 32608], [38, 33068], [40, 33348], [43, 33688], [48, 34028], [51, 34208], [56, 34408], [59, 34628], [68, 35048], [74, 35548], [77, 35628], [83, 35868], [89, 36388], [91, 36708], [94, 36848], [97, 36948], [104, 37408], [114, 37928], [117, 38028], [121, 38228], [124, 38368]]}, {"verse": 6, "start": 39449, "end": 42050, "text": "Y no le podían replicar a estas cosas.", "words": [[0, 39449], [2, 39558], [5, 39658], [8, 39798], [15, 40238], [24, 40918], [26, 41078], [32, 41238]]}, {"verse": 7, "start": 42500, "end": 50989, "text": "Y observando cómo escogían los primeros asientos a la mesa, refirió una parábola a los invitados, diciéndoles:", "words": [[0, 42500], [2, 42638], [13, 43298], [18, 43618], [27, 44198], [31, 44418], [40, 44998], [49, 45458], [51, 45678], [54, 45778], [60, 46718], [68, 47418], [72, 47698], [81, 48318], [83, 48558], [87, 48678], [98, 49858]]}, {"verse": 8, "start": 51439, "end": 60514, "text": "Cuando seas invitado de alguno a bodas, no te sientes en el primer lugar, no sea que otro más honrado que tú esté por él invitado,", "words": [[0, 51439], [7, 51640], [12, 51940], [21, 52640], [24, 52800], [31, 53240], [33, 53340], [40, 54160], [43, 54440], [46, 54620], [54, 55040], [57, 55260], [60, 55420], [67, 55800], [74, 56680], [77, 56880], [81, 57120], [85, 57340], [90, 57560], [94, 57920], [102, 58660], [106, 58860], [109, 59060], [114, 59300], [118, 59580], [121, 59720]]}, {"verse": 9, "start": 60964, "end": 70252, "text": "Y viniendo el que te llamó a ti y a él, te diga: Da lugar a este: y entonces comiences con vergüenza a tener el lugar último.", "words": [[0, 60964], [2, 61071], [11, 61591], [14, 61711], [18, 61811], [21, 61971], [27, 62311], [29, 62471], [32, 62591], [34, 62751], [36, 62831], [40, 63151], [43, 63431], [49, 64242], [52, 64407], [58, 64687], [60, 64927], [66, 65852], [68, 65997], [77, 66457], [87, 67377], [91, 67597], [101, 68277], [103, 68477], [109, 68737], [112, 68977], [118, 69297]]}, {"verse": 10, "start": 70702, "end": 84767, "text": "Pero cuando seas invitado, ve, y siéntate en el último lugar; para que cuando venga el que te convidó, te diga: Amigo, sube más arriba: entonces tendrás gloria delante de los que juntamente se asientan a la mesa.", "words": [[0, 70702], [5, 70829], [12, 71129], [17, 71449], [27, 72129], [31, 72389], [33, 73029], [42, 73629], [45, 73789], [48, 73909], [55, 74169], [62, 75092], [67, 75257], [71, 75417], [78, 75637], [84, 75957], [87, 76277], [91, 76377], [94, 76537], [103, 77017], [106, 77177], [112, 77912], [119, 78258], [124, 78838], [128, 79018], [136, 79905], [145, 80389], [153, 81009], [160, 81629], [168, 82129], [171, 82289], [175, 82429], [179, 82609], [190, 83269], [193, 83529], [202, 84109], [204, 84169], [207, 84269]]}, {"verse": 11, "start": 85217, "end": 92319, "text": "Porque cualquiera que se enaltece, será humillado; y el que se humilla, será enaltecido.", "words": [[0, 85217], [7, 85422], [18, 86062], [22, 86222], [25, 86382], [35, 87162], [40, 87762], [51, 89052], [53, 89366], [56, 89486], [60, 89626], [63, 89806], [72, 90386], [77, 90866]]}, {"verse": 12, "start": 92769, "end": 108500, "text": "Y dijo también al que le había invitado: Cuando haces comida o cena, no llames a tus amigos, ni a tus hermanos, ni a tus parientes, ni a vecinos ricos; no sea que ellos también te vuelvan a invitar, y te sea hecha compensación.", "words": [[0, 92769], [2, 92893], [7, 93173], [15, 93593], [18, 94013], [22, 94193], [25, 94353], [31, 94633], [41, 95763], [48, 96007], [54, 96467], [61, 96947], [63, 97187], [69, 97927], [72, 98027], [79, 98427], [81, 98587], [85, 98707], [93, 99227], [96, 99747], [98, 99867], [102, 100007], [112, 100527], [115, 101047], [117, 101127], [121, 101207], [132, 101797], [135, 102387], [137, 102467], [145, 102887], [152, 103926], [155, 104051], [159, 104271], [163, 104491], [169, 104751], [177, 105111], [180, 105391], [188, 105811], [190, 105891], [199, 106371], [201, 106564], [204, 106758], [208, 106951], [214, 107231]]}, {"verse": 13, "start": 108950, "end": 115538, "text": "Pero cuando haces banquete, llama a los pobres, los mancos, los cojos, los ciegos;", "words": [[0, 108950], [5, 109114], [12, 109394], [18, 109934], [28, 110854], [34, 111294], [36, 111554], [40, 111674], [48, 112654], [52, 112754], [60, 113674], [64, 113774], [71, 114614], [75, 114734]]}, {"verse": 14, "start": 115988, "end": 124501, "text": "Y serás bienaventurado; porque no te pueden retribuir; pero te será recompensado en la resurrección de los justos.", "words": [[0, 115988], [2, 116094], [8, 117062], [24, 118303], [31, 118507], [34, 118767], [37, 118927], [44, 119267], [55, 120540], [60, 120844], [63, 121044], [68, 121284], [81, 122384], [84, 122524], [87, 122704], [100, 123584], [103, 123744], [107, 123884]]}, {"verse": 15, "start": 124951, "end": 133604, "text": "Y oyendo esto uno de los que juntamente estaban sentados a la mesa, le dijo: Bienaventurado el que comerá pan en el reino de los cielos.", "words": [[0, 124951], [2, 125271], [9, 125651], [14, 126411], [18, 126591], [21, 126771], [25, 126891], [29, 127051], [40, 127651], [48, 128011], [57, 128571], [59, 128751], [62, 128871], [68, 129491], [71, 129571], [77, 130754], [92, 131234], [95, 131394], [99, 131534], [106, 131934], [110, 132214], [113, 132414], [116, 132534], [122, 132794], [125, 132894], [129, 133014]]}, {"verse": 16, "start": 133954, "end": 140161, "text": "Él entonces le dijo: Un hombre hizo una grande cena, y invitó a muchos.", "words": [[0, 133954], [3, 134216], [12, 134856], [15, 135236], [21, 136074], [24, 136223], [31, 136543], [36, 136983], [40, 137343], [47, 137683], [53, 138123], [55, 138723], [62, 139423], [64, 139523]]}, {"verse": 17, "start": 140611, "end": 147598, "text": "Y a la hora de la cena envió a su siervo a decir a los invitados: Venid, que ya está todo preparado.", "words": [[0, 140611], [2, 140718], [4, 140798], [7, 140918], [12, 141178], [15, 141338], [18, 141458], [23, 141798], [29, 142598], [31, 142718], [34, 142858], [41, 143358], [43, 143478], [49, 143718], [51, 143898], [55, 144058], [66, 145299], [73, 145723], [77, 145883], [80, 146083], [85, 146323], [90, 146703]]}, {"verse": 18, "start": 148048, "end": 158493, "text": "Y comenzaron todos a una a excusarse. El primero le dijo: He comprado un terreno, y necesito salir y verlo; te ruego que me des por excusado.", "words": [[0, 148048], [2, 148171], [13, 148871], [19, 149251], [21, 149631], [25, 149851], [27, 150111], [38, 151439], [41, 151583], [49, 151943], [52, 152143], [58, 152946], [61, 153031], [70, 153571], [73, 153731], [82, 154271], [84, 154611], [93, 155211], [99, 155471], [101, 155691], [108, 156515], [111, 156600], [117, 156960], [121, 157120], [124, 157240], [128, 157420], [132, 157580]]}, {"verse": 19, "start": 158943, "end": 166675, "text": "Y el otro dijo: He comprado cinco yuntas de bueyes, y voy a probarlos; te ruego que me des por excusado.", "words": [[0, 158943], [2, 159089], [5, 159209], [10, 159489], [16, 160596], [19, 160780], [28, 161280], [34, 161770], [41, 162260], [44, 162380], [52, 162800], [54, 163280], [58, 163420], [60, 163580], [71, 164698], [74, 164783], [80, 165143], [84, 165303], [87, 165423], [91, 165603], [95, 165763]]}, {"verse": 20, "start": 167125, "end": 171819, "text": "Y el otro dijo: Acabo de casarme, y por tanto no puedo ir.", "words": [[0, 167125], [2, 167272], [5, 167392], [10, 167672], [16, 168779], [22, 169161], [25, 169301], [34, 169901], [36, 170381], [40, 170561], [46, 170881], [49, 171081], [55, 171341]]}, {"verse": 21, "start": 172269, "end": 188663, "text": "Y vuelto el siervo, hizo saber estas cosas a su señor. Entonces enojado el padre de la familia, dijo a su siervo: Ve pronto por las plazas y por las calles de la ciudad, y mete acá los pobres, los mancos, y cojos, y ciegos.", "words": [[0, 172269], [2, 172430], [9, 172850], [12, 173030], [20, 173760], [25, 174490], [31, 174810], [37, 175090], [43, 175490], [45, 175750], [48, 175890], [55, 176810], [64, 177423], [72, 178203], [75, 178343], [81, 178603], [84, 178823], [87, 178923], [96, 179343], [101, 179703], [103, 179963], [106, 180103], [114, 180978], [117, 181162], [124, 181542], [128, 181882], [132, 182062], [139, 182642], [141, 182782], [145, 182942], [149, 183142], [156, 183562], [159, 183682], [162, 183782], [170, 184062], [172, 184422], [177, 184702], [181, 185042], [185, 185562], [193, 186502], [197, 186562], [205, 187202], [207, 187402], [214, 187842], [216, 188022]]}, {"verse": 22, "start": 189113, "end": 193528, "text": "Y dijo el siervo: Señor, hecho es como mandaste, y aún hay lugar.", "words": [[0, 189113], [2, 189240], [7, 189500], [10, 189660], [18, 190562], [25, 190939], [31, 191299], [34, 191519], [39, 191739], [49, 192719], [51, 193019], [55, 193206], [59, 193393]]}, {"verse": 23, "start": 193978, "end": 202492, "text": "Y dijo el señor al siervo: Ve por los caminos y por las cercas, y fuérzalos a entrar, para que se llene mi casa.", "words": [[0, 194878], [2, 195118], [7, 195418], [10, 195538], [16, 195798], [19, 196038], [27, 196985], [30, 197190], [34, 197470], [38, 197630], [46, 198110], [48, 198270], [52, 198490], [56, 198670], [64, 199370], [66, 199790], [76, 200210], [78, 200290], [86, 200710], [91, 201150], [95, 201310], [98, 201430], [104, 201730], [107, 201870]]}, {"verse": 24, "start": 202942, "end": 207632, "text": "Porque os digo que ninguno de aquellos hombres que fueron llamados, gustará mi cena.", "words": [[0, 202942], [7, 203125], [10, 203305], [15, 203525], [19, 203705], [27, 204185], [30, 204285], [39, 204505], [47, 204945], [51, 205145], [58, 205405], [68, 206045], [76, 206865], [79, 207125]]}, {"verse": 25, "start": 208082, "end": 212651, "text": "Y grandes multitudes iban con él; y volviéndose les dijo:", "words": [[0, 208082], [2, 208389], [10, 208749], [21, 209589], [26, 210029], [30, 210249], [34, 210953], [36, 211058], [48, 211578], [52, 212098]]}, {"verse": 26, "start": 213101, "end": 224702, "text": "Si alguno viene a mí, y no aborrece a su padre, y madre, y mujer, e hijos, y hermanos, y hermanas, y aun también su vida, no puede ser mi discípulo.", "words": [[0, 213101], [3, 213266], [10, 213766], [16, 213966], [18, 214166], [22, 214326], [24, 214826], [27, 215026], [36, 215646], [38, 215786], [41, 215926], [48, 216746], [50, 216966], [57, 217686], [59, 217706], [66, 218546], [68, 218646], [75, 219386], [77, 219466], [87, 220246], [89, 220326], [99, 220451], [101, 220577], [105, 220702], [113, 220828], [116, 220953], [122, 222625], [125, 222805], [131, 223085], [135, 223465], [138, 223705]]}, {"verse": 27, "start": 225152, "end": 230885, "text": "Y cualquiera que no lleva su cruz, y viene en pos de mí, no puede ser mi discípulo.", "words": [[0, 225152], [2, 225250], [13, 225810], [17, 225960], [20, 226110], [26, 226350], [29, 226550], [35, 227150], [37, 227370], [43, 227650], [46, 228010], [50, 228230], [53, 228410], [57, 228670], [60, 229310], [66, 229550], [70, 229870], [73, 230050]]}, {"verse": 28, "start": 231335, "end": 239904, "text": "Porque ¿cuál de vosotros, queriendo edificar una torre, no cuenta primero sentado los gastos, si tiene lo que necesita para acabarla?", "words": [[0, 231457], [7, 231617], [13, 231977], [16, 232117], [26, 232617], [36, 233257], [45, 233817], [49, 234057], [56, 234597], [59, 235097], [66, 235457], [74, 235837], [82, 236497], [86, 236657], [94, 237277], [97, 237557], [103, 237857], [106, 238037], [110, 238177], [119, 238717], [124, 239037]]}, {"verse": 29, "start": 240354, "end": 248686, "text": "No sea que, después de poner los cimientos, no pueda terminarla, todos los que lo vean, no comiencen a hacer burla de él,", "words": [[0, 240354], [3, 240498], [7, 240738], [12, 240958], [20, 241258], [23, 241478], [29, 241718], [33, 241978], [44, 242598], [47, 243058], [53, 243398], [65, 244518], [71, 244778], [75, 245238], [79, 245418], [82, 245558], [88, 246058], [91, 246398], [101, 247018], [103, 247158], [109, 247458], [115, 248038], [118, 248238]]}, {"verse": 30, "start": 249136, "end": 253652, "text": "Diciendo: Este hombre comenzó a edificar, y no pudo acabar.", "words": [[0, 249136], [10, 250338], [15, 250706], [22, 250946], [30, 251486], [32, 251546], [42, 252046], [44, 252366], [47, 252506], [52, 252946]]}, {"verse": 31, "start": 254102, "end": 265248, "text": "¿O cuál rey, habiendo de ir a hacer guerra contra otro rey, sentándose primero no consulta si puede salir al encuentro con diez mil al que viene contra él con veinte mil?", "words": [[0, 254102], [3, 254224], [8, 254424], [13, 255024], [22, 255444], [25, 255644], [28, 255864], [30, 256004], [36, 256304], [43, 256644], [50, 257104], [55, 257444], [60, 258164], [71, 258824], [79, 259164], [82, 259404], [91, 260064], [94, 260204], [100, 260484], [106, 260824], [109, 261024], [119, 261192], [123, 261361], [128, 261529], [132, 261698], [135, 263166], [139, 263326], [145, 263566], [152, 263966], [155, 264226], [159, 264446], [166, 264766]]}, {"verse": 32, "start": 265698, "end": 272127, "text": "De otra manera, cuando aun el otro está lejos, le ruega por la paz, enviándole una delegación.", "words": [[0, 265698], [3, 265843], [8, 266023], [16, 266383], [23, 266623], [27, 267103], [30, 267343], [35, 267563], [40, 267783], [47, 268223], [50, 268683], [56, 269043], [60, 269223], [63, 269363], [68, 270043], [79, 270883], [83, 271143]]}, {"verse": 33, "start": 272577, "end": 279560, "text": "Así pues, cualquiera de vosotros que no renuncia a todas las cosas que posee, no puede ser mi discípulo.", "words": [[0, 272577], [4, 272868], [10, 273168], [21, 273848], [24, 273988], [33, 274588], [37, 274848], [40, 275068], [49, 275788], [51, 275948], [57, 276108], [61, 276408], [67, 276688], [71, 276928], [78, 277668], [81, 277928], [87, 278248], [91, 278568], [94, 278788]]}, {"verse": 34, "start": 280010, "end": 286389, "text": "Buena es la sal; pero si aun la sal pierde su sabor, ¿con qué se sazonará?", "words": [[0, 280010], [6, 280237], [9, 280497], [12, 280757], [17, 281543], [22, 281687], [25, 281947], [29, 282307], [32, 282527], [36, 282887], [43, 283407], [46, 283587], [53, 284567], [58, 284907], [62, 285207], [65, 285427]]}, {"verse": 35, "start": 286839, "end": 295125, "text": "Ni para la tierra, ni para el montón de estiércol es buena; fuera la arrojan. Quien tiene oídos para oír, oiga.", "words": [[0, 286888], [3, 286968], [8, 287188], [11, 287368], [19, 287838], [22, 288308], [27, 288488], [30, 288628], [37, 289068], [40, 289368], [50, 289668], [53, 289968], [60, 290909], [66, 291218], [69, 291743], [78, 292503], [84, 292727], [90, 293007], [96, 293487], [101, 293727], [106, 294627]]}]}