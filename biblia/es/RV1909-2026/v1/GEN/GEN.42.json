{"book": "GEN", "chapter": 42, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 336168, "verses": [{"verse": 1, "start": 300, "end": 6464, "text": "Y viendo Jacob que en Egipto había alimentos, dijo a sus hijos: ¿Por qué os estáis mirando?", "words": [[0, 300], [2, 426], [9, 686], [15, 1066], [19, 1426], [22, 1726], [29, 2266], [35, 2506], [46, 3666], [51, 4026], [53, 4206], [57, 4346], [64, 5130], [69, 5272], [73, 5452], [76, 5592], [83, 5912]]}, {"verse": 2, "start": 6744, "end": 16178, "text": "Y dijo: He aquí, yo he oído que hay víveres en Egipto; descended allá, y comprad de allí para nosotros, para que podamos vivir, y no nos muramos.", "words": [[0, 6744], [2, 6873], [8, 7646], [11, 7736], [17, 7996], [20, 8276], [23, 8376], [28, 8676], [32, 8876], [36, 9036], [44, 9496], [47, 9596], [55, 10372], [65, 10876], [71, 11196], [73, 11716], [81, 12196], [84, 12296], [89, 12496], [94, 12736], [104, 13616], [109, 13936], [113, 14056], [121, 14476], [128, 14716], [130, 15236], [133, 15376], [137, 15536]]}, {"verse": 3, "start": 16458, "end": 20234, "text": "Y descendieron los diez hermanos de José a comprar trigo a Egipto.", "words": [[0, 16458], [2, 16564], [15, 17204], [19, 17497], [24, 17791], [33, 18084], [36, 18224], [41, 18484], [43, 18744], [51, 19044], [57, 19544], [59, 19664]]}, {"verse": 4, "start": 20584, "end": 28828, "text": "Mas Jacob no envió a Benjamín hermano de José con sus hermanos; porque dijo: No sea acaso que le acontezca algún desastre.", "words": [[0, 20584], [4, 20852], [10, 21412], [13, 21832], [19, 22212], [21, 22432], [30, 23052], [38, 23552], [41, 23632], [46, 23892], [50, 24172], [54, 24372], [64, 25154], [71, 25361], [77, 26134], [80, 26282], [84, 26522], [90, 26962], [94, 27142], [97, 27282], [107, 27922], [113, 28162]]}, {"verse": 5, "start": 29178, "end": 36618, "text": "Y vinieron los hijos de Israel a comprar entre los que venían: porque había hambre en la tierra de Canaán.", "words": [[0, 29178], [2, 29300], [11, 29780], [15, 29980], [21, 30300], [24, 30480], [31, 30860], [33, 31020], [41, 31560], [47, 32100], [51, 32320], [55, 32500], [63, 33446], [70, 33832], [76, 34312], [83, 34952], [86, 35232], [89, 35372], [96, 35692], [99, 36184]]}, {"verse": 6, "start": 36968, "end": 48784, "text": "Y José era el gobernador del país, quien vendía alimento a todo el pueblo: y llegaron los hermanos de José, y se inclinaron a él rostro por tierra.", "words": [[0, 36968], [2, 37096], [7, 37476], [11, 37911], [14, 38211], [25, 38971], [29, 39151], [35, 39691], [41, 40531], [48, 41171], [57, 41731], [59, 41971], [64, 42211], [67, 42411], [75, 43643], [77, 43749], [86, 44169], [90, 44369], [99, 44849], [102, 44949], [108, 45309], [110, 45784], [113, 45944], [124, 46844], [126, 47024], [129, 47224], [136, 47824], [140, 48044]]}, {"verse": 7, "start": 49134, "end": 63056, "text": "Y José como vio a sus hermanos, los conoció; mas hizo que no los conocía, y les habló ásperamente, y les dijo: ¿De dónde habéis venido? Ellos respondieron: De la tierra de Canaán a comprar alimentos.", "words": [[0, 49134], [2, 49399], [7, 49919], [12, 50079], [16, 50379], [18, 50499], [22, 50639], [32, 51559], [36, 51719], [45, 52740], [49, 52906], [54, 53073], [58, 53273], [61, 53433], [65, 53573], [74, 54213], [76, 54393], [80, 54553], [86, 55053], [99, 55873], [101, 56133], [105, 56253], [111, 57056], [115, 57213], [121, 57373], [128, 57733], [136, 58571], [142, 58938], [156, 60200], [159, 60342], [162, 60462], [169, 60782], [172, 61022], [179, 61462], [181, 61662], [189, 62022]]}, {"verse": 8, "start": 63406, "end": 68456, "text": "José, pues, conoció a sus hermanos; pero ellos no le conocieron.", "words": [[0, 63406], [6, 63834], [12, 64294], [20, 65054], [22, 65254], [26, 65374], [36, 66378], [41, 66544], [47, 66864], [50, 67444], [53, 67584]]}, {"verse": 9, "start": 68806, "end": 78609, "text": "Entonces se acordó José de los sueños que había tenido de ellos, y les dijo: Espías sois; habéis venido a ver las zonas desprotegidas del país.", "words": [[0, 68806], [9, 69584], [12, 69844], [19, 70344], [24, 70664], [27, 70864], [31, 71004], [38, 71504], [42, 71644], [48, 71844], [55, 72184], [58, 72484], [65, 72764], [67, 73064], [71, 73244], [77, 74062], [84, 74630], [90, 75444], [97, 75762], [104, 76162], [106, 76282], [110, 76402], [114, 76562], [120, 76922], [134, 77742], [138, 77942]]}, {"verse": 10, "start": 78889, "end": 85220, "text": "Y ellos le respondieron: No, señor mío: mas tus siervos han venido a comprar alimentos.", "words": [[0, 78889], [2, 79056], [8, 79416], [11, 79836], [25, 80756], [29, 80956], [35, 81156], [40, 81916], [44, 82167], [48, 82307], [56, 82927], [60, 83187], [67, 83647], [69, 83767], [77, 84127]]}, {"verse": 11, "start": 85570, "end": 92171, "text": "Todos nosotros somos hijos de un varón: somos hombres de verdad: tus siervos nunca fueron espías.", "words": [[0, 85570], [6, 85812], [15, 86292], [21, 86672], [27, 86992], [30, 87232], [33, 87531], [40, 88082], [46, 88472], [54, 88862], [57, 89252], [65, 89829], [69, 89933], [77, 90373], [83, 90853], [90, 91313]]}, {"verse": 12, "start": 92521, "end": 96765, "text": "Y él les dijo: No; a ver lo descubierto del país habéis venido.", "words": [[0, 92521], [2, 92705], [5, 92845], [9, 93025], [15, 93816], [19, 94395], [21, 94517], [25, 94637], [28, 94797], [40, 95397], [44, 95577], [49, 95857], [56, 96237]]}, {"verse": 13, "start": 97045, "end": 109591, "text": "Y ellos respondieron: Tus siervos somos doce hermanos, hijos de un varón en la tierra de Canaán; y he aquí el menor está hoy con nuestro padre, y otro no aparece.", "words": [[0, 97045], [2, 97209], [8, 97449], [22, 98901], [26, 99115], [34, 99328], [40, 99748], [45, 100288], [55, 101268], [61, 101468], [64, 101768], [67, 101908], [73, 102728], [76, 102928], [79, 103088], [86, 103468], [89, 103688], [97, 104458], [99, 104667], [102, 104787], [107, 105067], [110, 105227], [116, 105507], [121, 105787], [125, 106147], [129, 106367], [137, 106667], [144, 107347], [146, 107887], [151, 108187], [154, 108807]]}, {"verse": 14, "start": 109941, "end": 114651, "text": "Y José les dijo: Eso es lo que os he dicho, afirmando que sois espías:", "words": [[0, 109941], [2, 110143], [7, 110423], [11, 110703], [17, 111568], [21, 111793], [24, 111933], [27, 112053], [31, 112173], [34, 112313], [37, 112413], [44, 113033], [54, 113493], [58, 113633], [63, 113893]]}, {"verse": 15, "start": 115001, "end": 121027, "text": "En esto seréis probados: Vive Faraón que no saldréis de aquí, sino cuando vuestro hermano menor aquí venga.", "words": [[0, 115001], [3, 115167], [8, 115377], [15, 115797], [25, 116746], [30, 116951], [37, 117411], [41, 117551], [44, 117671], [53, 118171], [56, 118271], [62, 118851], [67, 119031], [74, 119271], [82, 119671], [90, 120051], [96, 120211], [101, 120511]]}, {"verse": 16, "start": 121377, "end": 132213, "text": "Enviad uno de vosotros, y traiga a vuestro hermano; y vosotros quedad presos, y vuestras palabras serán probadas, si hay verdad con vosotros: y si no, vive Faraón, que sois espías.", "words": [[0, 121377], [7, 121820], [11, 121980], [14, 122140], [24, 122700], [26, 123020], [33, 123420], [35, 123500], [43, 123820], [52, 124615], [54, 124740], [63, 125200], [70, 125640], [78, 126220], [80, 126500], [89, 126820], [98, 127160], [104, 127540], [114, 128080], [117, 128440], [121, 128580], [128, 128860], [132, 129140], [142, 130026], [144, 130153], [147, 130273], [151, 130573], [156, 130753], [164, 131273], [168, 131473], [173, 131733]]}, {"verse": 17, "start": 132493, "end": 134971, "text": "Y los juntó en la cárcel por tres días.", "words": [[0, 132493], [2, 132590], [6, 132720], [12, 133140], [15, 133200], [18, 133340], [25, 133720], [29, 133940], [34, 134280]]}, {"verse": 18, "start": 135321, "end": 140192, "text": "Y al tercer día les dijo José: Haced esto, y vivid: Yo temo a Dios:", "words": [[0, 135321], [2, 135425], [5, 135545], [12, 135845], [16, 136245], [20, 136445], [25, 136765], [31, 137683], [37, 137873], [43, 138253], [45, 138603], [52, 139120], [55, 139276], [60, 139636], [62, 139736]]}, {"verse": 19, "start": 140542, "end": 149160, "text": "Si sois hombres de verdad, quede preso en la casa de vuestra cárcel uno de vuestros hermanos; y vosotros id, llevad el alimento para el hambre de vuestra casa:", "words": [[0, 140542], [3, 140684], [8, 141024], [16, 141264], [19, 141504], [27, 142244], [33, 142464], [39, 142884], [42, 142944], [45, 143064], [50, 143324], [53, 143524], [61, 143864], [68, 144304], [72, 144604], [75, 144784], [84, 145124], [94, 145854], [96, 145961], [105, 146261], [109, 146561], [116, 146861], [119, 147161], [128, 147581], [133, 147881], [136, 148021], [143, 148261], [146, 148381], [154, 148701]]}, {"verse": 20, "start": 149510, "end": 157574, "text": "Pero habéis de traerme a vuestro hermano menor, y serán verificadas vuestras palabras, y no moriréis. Y ellos lo hicieron así.", "words": [[0, 149510], [5, 149652], [12, 149932], [15, 150052], [23, 150432], [25, 150572], [33, 150832], [41, 151232], [48, 151512], [50, 151912], [56, 152212], [68, 152832], [77, 153212], [87, 153632], [89, 154152], [92, 154292], [102, 155296], [104, 155461], [110, 155821], [113, 156321], [122, 156821]]}, {"verse": 21, "start": 157924, "end": 171097, "text": "Y decían el uno al otro: Verdaderamente hemos pecado contra nuestro hermano, que vimos la angustia de su alma cuando nos rogaba, y no le oímos: por eso ha venido sobre nosotros esta angustia.", "words": [[0, 157924], [2, 158012], [9, 158472], [12, 158652], [16, 158872], [19, 159072], [25, 159812], [40, 160697], [46, 160937], [53, 161457], [60, 161817], [68, 162057], [77, 162817], [81, 163097], [87, 163337], [90, 163557], [99, 164057], [102, 164197], [105, 164397], [110, 164697], [117, 164957], [121, 165277], [129, 165857], [131, 166277], [134, 166477], [137, 166617], [144, 167559], [148, 167681], [152, 167981], [155, 168321], [162, 168741], [168, 169001], [177, 169621], [182, 170261]]}, {"verse": 22, "start": 171447, "end": 182256, "text": "Entonces Rubén les respondió, diciendo: ¿No os hablé yo y dije: No pequéis contra el joven; y no escuchasteis? He aquí también su sangre es requerida.", "words": [[0, 171556], [9, 172228], [15, 172899], [19, 173199], [30, 173999], [40, 175581], [44, 175763], [47, 175923], [53, 176223], [56, 176443], [58, 176583], [64, 177220], [67, 177457], [75, 177727], [82, 177987], [85, 178167], [92, 178825], [94, 178923], [97, 179023], [111, 180224], [114, 180294], [119, 180514], [127, 180794], [130, 181074], [137, 181454], [140, 181634]]}, {"verse": 23, "start": 182536, "end": 187703, "text": "Y ellos no sabían que los entendía José, porque había intérprete entre ellos.", "words": [[0, 182536], [2, 182680], [8, 182900], [11, 183120], [18, 183560], [22, 183720], [26, 183880], [35, 184520], [41, 185160], [48, 185560], [54, 185900], [65, 186800], [71, 187060]]}, {"verse": 24, "start": 188053, "end": 199007, "text": "Y se apartó él de ellos, y lloró: después volvió a ellos, y les habló, y tomó de entre ellos a Simeón, y lo aprisionó a vista de ellos.", "words": [[0, 188053], [2, 188200], [5, 188280], [12, 188800], [15, 189100], [18, 189320], [25, 189640], [27, 190180], [34, 190855], [42, 191277], [49, 192317], [51, 192437], [58, 192737], [60, 193122], [64, 193302], [71, 194022], [73, 194222], [78, 194662], [81, 194782], [87, 195082], [93, 195422], [95, 195702], [103, 196282], [105, 196702], [108, 196882], [118, 197862], [120, 198002], [126, 198262], [129, 198542]]}, {"verse": 25, "start": 199357, "end": 211991, "text": "Y mandó José que llenaran sus sacos de trigo, y devolviesen el dinero de cada uno de ellos, poniéndolo en su saco, y les diesen comida para el camino: y se hizo así con ellos.", "words": [[0, 199357], [2, 199499], [8, 199959], [13, 200279], [17, 200519], [26, 201059], [30, 201339], [36, 201919], [39, 202019], [46, 202519], [48, 202979], [60, 203639], [63, 203979], [70, 204339], [73, 204579], [78, 204799], [82, 205119], [85, 205279], [92, 205859], [103, 206639], [106, 206779], [109, 206919], [115, 207659], [117, 207939], [121, 208079], [128, 208459], [135, 208979], [140, 209239], [143, 209399], [151, 210235], [153, 210364], [156, 210504], [161, 210784], [165, 211024], [169, 211324]]}, {"verse": 26, "start": 212341, "end": 216219, "text": "Y ellos pusieron su trigo sobre sus asnos, y se fueron de allí.", "words": [[0, 212341], [2, 212469], [8, 212669], [17, 213129], [20, 213349], [26, 213769], [32, 214069], [36, 214309], [43, 214789], [45, 215189], [48, 215309], [55, 215529], [58, 215809]]}, {"verse": 27, "start": 216569, "end": 224227, "text": "Y abriendo uno de ellos su saco para dar de comer a su asno en el posada, vio su dinero que estaba en la boca de su costal.", "words": [[0, 216569], [2, 216686], [11, 217226], [15, 217566], [18, 217766], [24, 218066], [27, 218286], [32, 218766], [37, 218986], [41, 219226], [44, 219426], [50, 219686], [52, 219886], [55, 220046], [60, 220446], [63, 220566], [66, 220686], [74, 221506], [78, 221826], [81, 221966], [88, 222346], [92, 222586], [99, 222806], [102, 222966], [105, 223086], [110, 223286], [113, 223466], [116, 223606]]}, {"verse": 28, "start": 224577, "end": 237820, "text": "Y dijo a sus hermanos: Mi dinero se me ha devuelto, y aquí está en mi saco. Se les sobresaltó entonces el corazón, y espantados dijeron el uno al otro: ¿Qué es esto que nos ha hecho Dios?", "words": [[0, 224577], [2, 224721], [7, 225041], [9, 225241], [13, 225381], [23, 226421], [26, 226548], [33, 226908], [36, 227188], [39, 227328], [42, 227428], [52, 228068], [54, 228568], [59, 228828], [64, 229148], [67, 229328], [70, 229468], [76, 230249], [79, 230395], [83, 230615], [94, 231595], [103, 232075], [106, 232415], [115, 232875], [117, 233375], [128, 233975], [136, 234515], [139, 234655], [143, 234855], [146, 235035], [152, 235795], [157, 235961], [160, 236161], [165, 236461], [169, 236641], [173, 236841], [176, 237021], [182, 237221]]}, {"verse": 29, "start": 238170, "end": 246106, "text": "Y venidos a Jacob su padre en tierra de Canaán, le contaron todo lo que les había acontecido, diciendo:", "words": [[0, 238170], [2, 238296], [10, 238736], [12, 238916], [18, 239596], [21, 239736], [27, 240076], [30, 240436], [37, 240796], [40, 241036], [48, 242056], [51, 242156], [60, 242736], [65, 243076], [68, 243456], [72, 243656], [76, 243836], [82, 244236], [94, 245276]]}, {"verse": 30, "start": 246456, "end": 252513, "text": "Aquel varón, señor de la tierra, nos habló ásperamente, y nos trató como a espías de la tierra:", "words": [[0, 246456], [6, 246784], [13, 247104], [19, 247404], [22, 247644], [25, 247764], [33, 248204], [37, 248844], [43, 249264], [56, 250084], [58, 250204], [62, 250324], [68, 250784], [73, 251024], [75, 251184], [82, 251704], [85, 251904], [88, 252004]]}, {"verse": 31, "start": 252513, "end": 257819, "text": "Y nosotros le dijimos: Somos hombres de verdad, nunca fuimos espías:", "words": [[0, 252513], [2, 252873], [11, 253193], [14, 253573], [23, 254214], [29, 254801], [37, 255241], [40, 255461], [48, 255861], [54, 256421], [61, 257153]]}, {"verse": 32, "start": 258169, "end": 266874, "text": "Somos doce hermanos, hijos de nuestro padre; uno no aparece, y el menor está hoy con nuestro padre en la tierra de Canaán.", "words": [[0, 258169], [6, 258667], [11, 259107], [21, 259747], [27, 259947], [30, 260227], [38, 260407], [45, 261409], [49, 261654], [52, 262014], [61, 262674], [63, 262959], [66, 263099], [72, 263439], [77, 263759], [81, 264039], [85, 264259], [93, 264639], [99, 265299], [102, 265499], [105, 265639], [112, 265999], [115, 266436]]}, {"verse": 33, "start": 267224, "end": 280014, "text": "Y aquel varón, señor de la tierra, nos dijo: En esto conoceré que sois hombres de verdad; dejad conmigo uno de vuestros hermanos, y tomad para el hambre de vuestras casas, y andad,", "words": [[0, 267224], [2, 267414], [8, 267694], [15, 268014], [21, 268334], [24, 268534], [27, 268674], [35, 268954], [39, 269334], [45, 270113], [48, 270257], [53, 270517], [62, 271237], [66, 271357], [71, 271737], [79, 272197], [82, 272477], [90, 273363], [96, 274054], [104, 274594], [108, 274894], [111, 275054], [120, 275474], [130, 276314], [132, 276534], [138, 276754], [143, 277114], [146, 277434], [153, 277794], [156, 277954], [165, 278274], [172, 279114], [174, 279354]]}, {"verse": 34, "start": 280364, "end": 291820, "text": "Y traedme a vuestro hermano el menor, para que yo sepa que no sois espías, sino hombres de verdad: así os daré a vuestro hermano, y negociaréis en la tierra.", "words": [[0, 280364], [2, 280514], [10, 281194], [12, 281314], [20, 281634], [28, 282074], [31, 282154], [38, 283174], [43, 283454], [47, 283594], [50, 283754], [55, 284134], [59, 284294], [62, 284474], [67, 284834], [75, 285954], [80, 286294], [88, 286834], [91, 287074], [99, 287905], [103, 288139], [106, 288359], [111, 288679], [113, 288699], [121, 288999], [130, 289819], [132, 289959], [144, 290779], [147, 290979], [150, 291139]]}, {"verse": 35, "start": 292170, "end": 303236, "text": "Y aconteció que vaciando ellos sus sacos, he aquí que en el saco de cada uno estaba el atado de su dinero: y viendo ellos y su padre los atados de su dinero, tuvieron temor.", "words": [[0, 292170], [2, 292299], [12, 293018], [16, 293218], [25, 293798], [31, 294098], [35, 294379], [42, 294978], [45, 295578], [50, 295918], [54, 296138], [57, 296318], [60, 296439], [65, 296898], [68, 296958], [73, 297138], [77, 297439], [84, 297739], [87, 298038], [93, 298338], [96, 298478], [99, 298619], [107, 299441], [109, 299545], [116, 299805], [122, 300065], [124, 300305], [127, 300445], [133, 300905], [137, 301025], [144, 301525], [147, 301685], [150, 301805], [158, 302165], [167, 302665]]}, {"verse": 36, "start": 303586, "end": 314455, "text": "Entonces su padre Jacob les dijo: Me habéis privado de mis hijos; José no aparece, ni Simeón tampoco, y a Benjamín le llevaréis: contra mí son todas estas cosas.", "words": [[0, 303586], [9, 304371], [12, 304591], [18, 305091], [24, 305711], [28, 305811], [34, 306529], [37, 306633], [44, 306853], [52, 307313], [55, 307433], [59, 307553], [66, 308343], [71, 308571], [74, 308811], [83, 309251], [86, 309571], [93, 310071], [102, 310491], [104, 311111], [106, 311191], [115, 311711], [118, 311811], [129, 312571], [136, 312909], [139, 313029], [143, 313229], [149, 313429], [155, 313729]]}, {"verse": 37, "start": 314735, "end": 323335, "text": "Y Rubén habló a su padre, diciendo: Harás morir a mis dos hijos, si no te lo devuelvo; entrégalo en mi mano, que yo te lo devolveré.", "words": [[0, 314735], [2, 315014], [8, 315324], [14, 315864], [16, 315964], [19, 316084], [26, 317024], [36, 318134], [42, 318394], [48, 318714], [50, 318774], [54, 318894], [58, 319034], [65, 319374], [68, 319694], [71, 319774], [74, 319914], [77, 320034], [87, 321098], [97, 321378], [100, 321498], [103, 321618], [109, 322218], [113, 322298], [116, 322458], [119, 322598], [122, 322698]]}, {"verse": 38, "start": 323615, "end": 335768, "text": "Y él dijo: No descenderá mi hijo con vosotros; que su hermano es muerto, y él solo ha quedado: y si le acontece algún desastre en el camino por donde vais, haréis descender mis canas con dolor a la sepultura.", "words": [[0, 323615], [2, 323804], [5, 323964], [11, 324682], [14, 324807], [25, 325427], [28, 325567], [33, 325787], [37, 325987], [47, 326976], [51, 327056], [54, 327216], [62, 327616], [65, 327736], [73, 328176], [75, 328496], [78, 328616], [83, 328896], [86, 329076], [95, 329813], [97, 329896], [100, 329976], [103, 330076], [112, 330476], [118, 330836], [127, 331376], [130, 331496], [133, 331576], [140, 331876], [144, 332136], [150, 332336], [156, 333116], [163, 333376], [173, 333836], [177, 334016], [183, 334396], [187, 334556], [193, 334836], [195, 334956], [198, 335056]]}]}