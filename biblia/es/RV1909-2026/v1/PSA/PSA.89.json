{"book": "PSA", "chapter": 89, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 326072, "verses": [{"verse": 1, "start": 300, "end": 10657, "text": "Masquil de Etán ezraíta. LAS misericordias de Jehová cantaré perpetuamente: en generación y generación haré notoria tu verdad con mi boca.", "words": [[0, 300], [8, 962], [11, 1202], [16, 1928], [25, 3180], [29, 3486], [43, 3793], [46, 3913], [53, 4333], [61, 4813], [76, 6460], [79, 6608], [90, 7368], [92, 7588], [103, 8328], [108, 8668], [116, 9188], [119, 9368], [126, 9568], [130, 9948], [133, 10128]]}, {"verse": 2, "start": 11107, "end": 18356, "text": "Porque dije: Para siempre será edificada misericordia; en los mismos cielos apoyarás tu verdad.", "words": [[0, 11107], [7, 11447], [13, 12282], [18, 12468], [26, 13008], [31, 13548], [41, 14428], [55, 15843], [58, 15986], [62, 16126], [69, 16406], [76, 17006], [85, 17646], [88, 17766]]}, {"verse": 3, "start": 18656, "end": 23510, "text": "Hice pacto con mi escogido; juré a David mi siervo, diciendo:", "words": [[0, 18801], [5, 18951], [11, 19471], [15, 19651], [18, 19771], [28, 21062], [33, 21408], [35, 21488], [41, 21848], [44, 21968], [52, 22548]]}, {"verse": 4, "start": 23960, "end": 30959, "text": "Para siempre confirmaré tu descendencia, y edificaré tu trono por todas las generaciones. (Selah.)", "words": [[0, 23960], [5, 24125], [13, 24525], [24, 25265], [27, 25405], [41, 26285], [43, 26745], [53, 27305], [56, 27465], [62, 27845], [66, 28065], [72, 28285], [76, 28565], [90, 30376]]}, {"verse": 5, "start": 31309, "end": 38603, "text": "Y celebrarán los cielos tu maravilla, oh Jehová; tu verdad también en la congregación de los santos.", "words": [[0, 31309], [2, 31416], [13, 32196], [17, 32336], [24, 32856], [27, 32996], [38, 33517], [41, 34039], [49, 34795], [52, 34900], [59, 35180], [67, 35880], [70, 36440], [73, 36580], [86, 37480], [89, 37680], [93, 37800]]}, {"verse": 6, "start": 39053, "end": 46559, "text": "Porque ¿quién en los cielos se igualará con Jehová? ¿quién será semejante a Jehová entre los hijos de los potentados?", "words": [[0, 39053], [7, 39315], [14, 39855], [17, 40055], [21, 40215], [28, 40755], [31, 40895], [40, 41395], [44, 41635], [52, 42585], [59, 42905], [64, 43125], [74, 43845], [76, 43985], [83, 44425], [89, 44625], [93, 44865], [99, 45185], [102, 45345], [106, 45465]]}, {"verse": 7, "start": 47009, "end": 54517, "text": "Dios temible en la grande congregación de los santos, y formidable sobre todos cuantos están alrededor suyo.", "words": [[0, 47009], [5, 47296], [13, 48056], [16, 48276], [19, 48416], [26, 48776], [39, 49636], [42, 49796], [46, 49936], [54, 50796], [56, 51286], [67, 51776], [73, 52016], [79, 52506], [87, 52996], [93, 53276], [103, 53616]]}, {"verse": 8, "start": 54967, "end": 62331, "text": "Oh Jehová, Dios de los ejércitos, ¿quién como tú? Poderoso eres, Jehová, y tu fidelidad te rodea.", "words": [[0, 55162], [3, 55388], [11, 55615], [16, 55855], [19, 56135], [23, 56295], [34, 57275], [41, 57575], [46, 57775], [50, 58623], [59, 59145], [65, 59405], [73, 60185], [75, 60445], [78, 60605], [88, 61365], [91, 61605]]}, {"verse": 9, "start": 62781, "end": 69269, "text": "Tú tienes dominio sobre la bravura del mar: cuando se levantan sus ondas, tú las sosiegas.", "words": [[0, 62781], [3, 63103], [10, 63403], [18, 64003], [24, 64243], [27, 64463], [35, 64903], [39, 65083], [44, 65975], [51, 66315], [54, 66535], [63, 67095], [67, 67295], [74, 68075], [77, 68235], [81, 68773]]}, {"verse": 10, "start": 69719, "end": 76960, "text": "Tú quebrantaste a Rahab como a un muerto: con el brazo de tu fortaleza esparciste a tus enemigos.", "words": [[0, 69719], [3, 69822], [16, 70642], [18, 70872], [24, 71102], [29, 71369], [31, 71635], [34, 71902], [42, 73025], [46, 73317], [49, 73477], [55, 73897], [58, 74017], [61, 74177], [71, 74917], [82, 75757], [84, 75897], [88, 76017]]}, {"verse": 11, "start": 77410, "end": 84025, "text": "Tuyos los cielos, tuya también la tierra: el mundo y su plenitud, tú lo fundaste.", "words": [[0, 77586], [6, 77796], [10, 77936], [18, 78496], [23, 78816], [31, 79176], [34, 79436], [42, 80489], [45, 80650], [51, 81030], [53, 81230], [56, 81390], [66, 82590], [69, 83030], [72, 83170]]}, {"verse": 12, "start": 84475, "end": 90826, "text": "Al norte y al sur tú los creaste: Tabor y Hermón cantarán en tu nombre.", "words": [[0, 84475], [3, 84686], [9, 85166], [11, 85526], [14, 85706], [18, 86446], [21, 86706], [25, 86906], [34, 88073], [40, 88398], [42, 88578], [49, 89248], [58, 89918], [61, 90078], [64, 90218]]}, {"verse": 13, "start": 91276, "end": 96958, "text": "Tuyo el brazo con valentía; fuerte es tu mano, exaltada tu diestra.", "words": [[0, 91276], [5, 91578], [8, 91718], [14, 92098], [18, 92318], [28, 93551], [35, 93988], [38, 94288], [41, 94388], [47, 95208], [56, 95968], [59, 96188]]}, {"verse": 14, "start": 97408, "end": 104029, "text": "Justicia y juicio son el asiento de tu trono: misericordia y verdad van delante de tu rostro.", "words": [[0, 97408], [9, 97967], [11, 98067], [18, 98567], [22, 99307], [25, 99507], [33, 99907], [36, 100107], [39, 100247], [46, 101182], [59, 101987], [61, 102067], [68, 102287], [72, 102607], [80, 103027], [83, 103187], [86, 103347]]}, {"verse": 15, "start": 104479, "end": 110762, "text": "Bienaventurado el pueblo que sabe aclamarte: andarán, oh Jehová, a la luz de tu rostro.", "words": [[0, 105036], [15, 105606], [18, 105746], [25, 106026], [29, 106246], [34, 106830], [45, 107654], [54, 108098], [57, 108578], [65, 109058], [67, 109258], [70, 109338], [74, 109658], [77, 109978], [80, 110118]]}, {"verse": 16, "start": 111212, "end": 117096, "text": "En tu nombre se alegrarán todo el día; y en tu justicia serán ensalzados.", "words": [[0, 111212], [3, 111376], [6, 111536], [13, 111896], [16, 112176], [26, 112896], [31, 113136], [34, 113476], [39, 114246], [41, 114598], [44, 114738], [47, 114898], [56, 115578], [62, 115978]]}, {"verse": 17, "start": 117546, "end": 124268, "text": "Porque tú eres la gloria de su fortaleza; y por tu buena voluntad acrecentarás nuestro poder.", "words": [[0, 117546], [7, 117750], [10, 118070], [15, 118450], [18, 118810], [25, 119270], [28, 119430], [31, 119610], [42, 120882], [44, 121109], [48, 121289], [51, 121449], [57, 121689], [66, 122479], [79, 123269], [87, 123429]]}, {"verse": 18, "start": 124718, "end": 130006, "text": "Porque Jehová es nuestro escudo; y nuestro rey es el Santo de Israel.", "words": [[0, 124718], [7, 125102], [14, 125522], [17, 125762], [25, 126182], [33, 127483], [35, 127569], [43, 127749], [47, 128209], [50, 128489], [53, 128629], [59, 128969], [62, 129249]]}, {"verse": 19, "start": 130456, "end": 139939, "text": "Entonces hablaste en visión a tu santo, y dijiste: Yo he puesto el socorro sobre valiente; he ensalzado un escogido de mi pueblo.", "words": [[0, 130456], [9, 131279], [18, 132219], [21, 132419], [28, 132799], [30, 132939], [33, 133019], [40, 133399], [42, 133539], [51, 134542], [54, 134674], [57, 134794], [64, 135014], [67, 135294], [75, 135734], [81, 136014], [91, 137334], [94, 137516], [104, 138176], [107, 138316], [116, 138876], [119, 138996], [122, 139116]]}, {"verse": 20, "start": 140389, "end": 144772, "text": "Hallé a David mi siervo; lo ungí con el aceite de mi santidad.", "words": [[0, 140490], [6, 140630], [8, 140770], [14, 141150], [17, 141270], [25, 142420], [28, 142677], [33, 142977], [37, 143097], [40, 143217], [47, 143517], [50, 143757], [53, 143857]]}, {"verse": 21, "start": 145222, "end": 149809, "text": "Mi mano será firme con él, mi brazo también lo fortificará.", "words": [[0, 145222], [3, 145347], [8, 145607], [13, 145887], [19, 146367], [23, 146567], [27, 147347], [30, 147527], [36, 147947], [44, 148307], [47, 148567]]}, {"verse": 22, "start": 150259, "end": 154819, "text": "No lo avasallará enemigo, ni hijo de iniquidad lo quebrantará.", "words": [[0, 150259], [3, 150459], [6, 150639], [17, 151379], [26, 152139], [29, 152539], [34, 152839], [37, 152999], [47, 153579], [50, 153739]]}, {"verse": 23, "start": 155269, "end": 160646, "text": "Mas yo quebrantaré delante de él a sus enemigos, y heriré a sus aborrecedores.", "words": [[0, 155269], [4, 155448], [7, 155688], [19, 156368], [27, 156808], [30, 156968], [33, 157128], [35, 157228], [39, 157348], [49, 158008], [51, 158568], [58, 159048], [60, 159208], [64, 159328]]}, {"verse": 24, "start": 161096, "end": 166887, "text": "Y mi verdad y mi misericordia serán con él; y en mi nombre será exaltado su cuerno.", "words": [[0, 161096], [2, 161193], [5, 161273], [12, 161653], [14, 162073], [17, 162173], [30, 162913], [36, 163233], [40, 163373], [44, 164258], [46, 164377], [49, 164477], [52, 164597], [59, 164937], [64, 165257], [73, 165937], [76, 166077]]}, {"verse": 25, "start": 167337, "end": 171376, "text": "Asimismo pondré su mano en el mar, y en los ríos su diestra.", "words": [[0, 167337], [9, 167897], [16, 168257], [19, 168397], [24, 168617], [27, 168757], [30, 168877], [35, 169097], [37, 169497], [40, 169597], [44, 169697], [49, 170197], [52, 170477]]}, {"verse": 26, "start": 171826, "end": 177901, "text": "Él me llamará: Mi padre eres tú, mi Dios, y la roca de mi salvación.", "words": [[0, 171826], [3, 172002], [6, 172122], [15, 173257], [18, 173375], [24, 173775], [29, 174015], [33, 174695], [36, 174775], [42, 175095], [44, 175635], [47, 175755], [52, 176075], [55, 176195], [58, 176295]]}, {"verse": 27, "start": 178201, "end": 182626, "text": "Yo también le pondré por primogénito, alto sobre los reyes de la tierra.", "words": [[0, 178201], [3, 178337], [11, 178577], [14, 178797], [21, 179157], [25, 179317], [38, 180417], [43, 180777], [49, 181117], [53, 181317], [59, 181657], [62, 181757], [65, 181837]]}, {"verse": 28, "start": 183076, "end": 188146, "text": "Para siempre le conservaré mi misericordia; y mi pacto será firme con él.", "words": [[0, 183076], [5, 183239], [13, 183639], [16, 183839], [27, 184439], [30, 184579], [44, 186084], [46, 186156], [49, 186266], [55, 186766], [60, 186946], [66, 187386], [70, 187546]]}, {"verse": 29, "start": 188596, "end": 194069, "text": "Y pondré su descendencia para siempre, y su trono como los días de los cielos.", "words": [[0, 188596], [2, 188703], [9, 189163], [12, 189363], [25, 190223], [30, 190443], [39, 190963], [41, 191443], [44, 191583], [50, 192063], [55, 192303], [59, 192483], [64, 192783], [67, 193003], [71, 193123]]}, {"verse": 30, "start": 194519, "end": 198338, "text": "Si dejan sus hijos mi ley, y no andan en mis juicios;", "words": [[0, 194519], [3, 194664], [9, 195044], [13, 195244], [19, 195564], [22, 195824], [27, 196104], [29, 196564], [32, 196764], [38, 197184], [41, 197304], [45, 197464]]}, {"verse": 31, "start": 198788, "end": 202802, "text": "Si profanan mis estatutos, y no guardan mis mandamientos;", "words": [[0, 198788], [3, 198937], [12, 199477], [16, 199697], [27, 200297], [29, 200877], [32, 201017], [40, 201457], [44, 201617]]}, {"verse": 32, "start": 203252, "end": 208000, "text": "Entonces visitaré con vara su rebelión, y con azotes sus iniquidades.", "words": [[0, 203252], [9, 203712], [18, 204492], [22, 204742], [27, 204992], [30, 205112], [40, 205632], [42, 206072], [46, 206352], [53, 206632], [57, 206852]]}, {"verse": 33, "start": 208450, "end": 212321, "text": "Mas no quitaré de él mi misericordia, ni falsearé mi verdad.", "words": [[0, 208450], [4, 208633], [7, 208773], [15, 209233], [18, 209333], [21, 209473], [24, 209553], [38, 210673], [41, 211023], [50, 211373], [53, 211513]]}, {"verse": 34, "start": 212771, "end": 217061, "text": "No olvidaré mi pacto, ni mudaré lo que ha salido de mis labios.", "words": [[0, 212771], [3, 212975], [12, 213455], [15, 213575], [22, 214535], [25, 214695], [32, 215095], [35, 215255], [39, 215375], [42, 215475], [49, 215855], [52, 215975], [56, 216095]]}, {"verse": 35, "start": 217511, "end": 221089, "text": "Una vez he jurado por mi santidad, que no mentiré a David.", "words": [[0, 217511], [4, 217695], [8, 217935], [11, 218115], [18, 218475], [22, 218655], [25, 218795], [35, 219635], [39, 219735], [42, 219875], [50, 220395], [52, 220435]]}, {"verse": 36, "start": 221539, "end": 226281, "text": "Su descendencia será para siempre, y su trono como el sol delante de mí.", "words": [[0, 221539], [3, 221700], [16, 222500], [21, 222720], [26, 223000], [35, 223460], [37, 223960], [40, 224100], [46, 224520], [51, 224740], [54, 224880], [58, 225080], [66, 225540], [69, 225700]]}, {"verse": 37, "start": 226731, "end": 233397, "text": "Como la luna será firme para siempre, y como un testigo fiel en el cielo. (Selah.)", "words": [[0, 226731], [5, 226895], [8, 227035], [13, 227375], [18, 227595], [24, 228055], [29, 228235], [38, 228675], [40, 229155], [45, 229375], [48, 229515], [56, 229995], [61, 230355], [64, 230495], [67, 230615], [74, 232814]]}, {"verse": 38, "start": 233747, "end": 238635, "text": "Mas tú desechaste y menospreciaste a tu ungido; y te has airado con él.", "words": [[0, 233747], [4, 233948], [7, 234148], [18, 234888], [20, 235408], [35, 235928], [37, 236088], [40, 236188], [48, 237203], [50, 237307], [53, 237547], [57, 237787], [64, 238027], [68, 238267]]}, {"verse": 39, "start": 239085, "end": 244668, "text": "Rompiste el pacto de tu siervo; has profanado su corona hasta la tierra.", "words": [[0, 239411], [9, 239771], [12, 239931], [18, 240511], [21, 240631], [24, 240791], [32, 241755], [36, 241980], [46, 242880], [49, 243100], [56, 243500], [62, 243800], [65, 243980]]}, {"verse": 40, "start": 245118, "end": 249904, "text": "Rompiste todos sus vallados; has quebrantado sus fortalezas.", "words": [[0, 245118], [9, 245698], [15, 246018], [19, 246605], [29, 247430], [33, 247685], [45, 248443], [49, 249201]]}, {"verse": 41, "start": 250354, "end": 256064, "text": "Lo saquearon todos los que pasaron por el camino: es deshonra a sus vecinos.", "words": [[0, 250354], [3, 250674], [13, 251314], [19, 251594], [23, 251834], [27, 251994], [35, 252474], [39, 252644], [42, 252814], [50, 253754], [53, 253959], [62, 254859], [64, 255059], [68, 255199]]}, {"verse": 42, "start": 256514, "end": 263133, "text": "Has exaltado la diestra de sus enemigos; has alegrado a todos sus adversarios.", "words": [[0, 256654], [4, 256794], [13, 257794], [16, 257934], [24, 258374], [27, 258574], [31, 258714], [41, 259947], [45, 260287], [54, 261087], [56, 261307], [62, 261587], [66, 261907]]}, {"verse": 43, "start": 263583, "end": 269194, "text": "Embotaste asimismo el filo de su espada, y no lo levantaste en la batalla.", "words": [[0, 263583], [10, 264359], [19, 265179], [22, 265499], [27, 265939], [30, 266039], [33, 266179], [41, 266699], [43, 267119], [46, 267279], [49, 267419], [60, 268259], [63, 268399], [66, 268539]]}, {"verse": 44, "start": 269644, "end": 274076, "text": "Hiciste cesar su brillo, y echaste su trono por tierra.", "words": [[0, 269644], [8, 270249], [14, 270749], [17, 270909], [25, 271869], [27, 272009], [35, 272449], [38, 272689], [44, 273089], [48, 273309]]}, {"verse": 45, "start": 274526, "end": 280028, "text": "Has acortado los días de su juventud; lo has cubierto de afrenta. (Selah.)", "words": [[0, 274812], [4, 275138], [13, 275465], [17, 275625], [22, 275905], [25, 276085], [28, 276265], [38, 277382], [41, 277507], [45, 277707], [54, 278287], [57, 278467], [66, 279714]]}, {"verse": 46, "start": 280478, "end": 286052, "text": "¿Hasta cuándo, oh Jehová? ¿te esconderás para siempre? ¿arderá tu ira como el fuego?", "words": [[0, 280478], [7, 280702], [15, 281042], [18, 281382], [26, 282194], [30, 282336], [41, 282976], [46, 283136], [55, 284078], [63, 284644], [66, 284804], [70, 285084], [75, 285284], [78, 285424]]}, {"verse": 47, "start": 286502, "end": 292974, "text": "Acuérdate de cuán corto sea mi tiempo: ¿por qué habrás creado en vano a todos los hijos del hombre?", "words": [[0, 286502], [10, 287066], [13, 287366], [18, 287726], [24, 288346], [28, 288546], [31, 288806], [39, 289713], [44, 289820], [48, 290080], [55, 290460], [62, 290880], [65, 291020], [70, 291380], [72, 291460], [78, 291660], [82, 291900], [88, 292180], [92, 292420]]}, {"verse": 48, "start": 293424, "end": 299999, "text": "¿Qué hombre vivirá y no verá muerte? ¿librarás su vida del poder del sepulcro? (Selah.)", "words": [[0, 293424], [5, 293552], [12, 293892], [19, 294472], [21, 294552], [24, 294712], [29, 294952], [37, 296148], [47, 296438], [50, 296718], [55, 297018], [59, 297238], [65, 297798], [69, 298098], [79, 299684]]}, {"verse": 49, "start": 300449, "end": 306023, "text": "Señor, ¿dónde están tus antiguas misericordias, que juraste a David por tu verdad?", "words": [[0, 300449], [7, 301312], [14, 301592], [20, 301832], [24, 302052], [33, 302692], [48, 304032], [52, 304112], [60, 304592], [62, 304772], [68, 305012], [72, 305272], [75, 305452]]}, {"verse": 50, "start": 306473, "end": 313312, "text": "Señor, acuérdate de la deshonra de tus siervos; deshonra que llevo yo en mi seno de muchos pueblos.", "words": [[0, 306473], [7, 307213], [17, 307753], [20, 307993], [23, 308373], [32, 308753], [35, 308913], [39, 309093], [48, 310496], [57, 310786], [61, 310946], [67, 311286], [70, 311486], [73, 311646], [76, 311826], [81, 312186], [84, 312286], [91, 312506]]}, {"verse": 51, "start": 313762, "end": 321446, "text": "Porque tus enemigos, oh Jehová, han deshonrado, porque tus enemigos han deshonrado los pasos de tu ungido.", "words": [[0, 313762], [7, 314004], [11, 314244], [21, 314731], [24, 315217], [32, 315704], [36, 315924], [48, 317084], [55, 317664], [59, 317924], [68, 318564], [72, 318864], [83, 319744], [87, 319924], [93, 320464], [96, 320811], [99, 321159]]}, {"verse": 52, "start": 321896, "end": 325672, "text": "Bendito Jehová para siempre. Amén, y Amén.", "words": [[0, 321896], [8, 322523], [15, 323023], [20, 323183], [29, 324339], [35, 324776], [37, 325056]]}]}