{"book": "MRK", "chapter": 12, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 327666, "verses": [{"verse": 1, "start": 300, "end": 13180, "text": "And he began to speak to them by parables. A certain man planted a vineyard, and set a hedge about it, and dug a place for the winepress, and built a tower, and let it out to vinedressers, and went into a far country.", "words": [[0, 300], [4, 412], [7, 512], [13, 812], [16, 972], [22, 1192], [25, 1432], [30, 1592], [33, 1832], [43, 3341], [45, 3445], [53, 3745], [57, 4085], [65, 4525], [67, 4685], [77, 5105], [81, 5445], [85, 5665], [87, 5805], [93, 5985], [99, 6245], [103, 6445], [107, 6825], [111, 7025], [113, 7145], [119, 7405], [123, 7605], [127, 7935], [138, 8265], [142, 8665], [148, 8865], [150, 9005], [157, 9365], [161, 9865], [165, 10045], [168, 10165], [172, 10305], [175, 10870], [189, 11598], [193, 11744], [198, 11924], [203, 12184], [205, 12344], [209, 12564]]}, {"verse": 2, "start": 13530, "end": 19420, "text": "And at the season he sent to the vinedressers a servant, that he might receive from the vinedressers of the fruit of the vineyard.", "words": [[0, 13530], [4, 13637], [7, 13737], [11, 13877], [18, 14297], [21, 14477], [26, 14717], [29, 14877], [33, 15207], [46, 15537], [48, 15697], [57, 16057], [62, 16517], [65, 16637], [71, 16817], [79, 17237], [84, 17477], [88, 17837], [101, 18197], [104, 18357], [108, 18457], [114, 18697], [117, 18857], [121, 18957]]}, {"verse": 3, "start": 19770, "end": 23285, "text": "And they caught him, and beat him, and sent him away empty.", "words": [[0, 19770], [4, 19891], [9, 20011], [16, 20291], [21, 20531], [25, 20991], [30, 21251], [35, 21531], [39, 21971], [44, 22191], [48, 22391], [53, 22631]]}, {"verse": 4, "start": 23635, "end": 31204, "text": "And again he sent to them another servant; and at him they cast stones, and wounded him in the head, and sent him away shamefully handled.", "words": [[0, 23635], [4, 23735], [10, 23995], [13, 24195], [18, 24415], [21, 24595], [26, 24735], [34, 25035], [43, 25860], [47, 25999], [50, 26159], [54, 26439], [59, 26679], [64, 26959], [72, 27499], [76, 27814], [84, 28114], [88, 28334], [91, 28454], [95, 28574], [101, 28834], [105, 29314], [110, 29574], [114, 29774], [119, 30034], [130, 30614]]}, {"verse": 5, "start": 31554, "end": 37513, "text": "And again he sent another; and him they killed, and many others; beating some, and killing some.", "words": [[0, 31554], [4, 31672], [10, 32212], [13, 32312], [18, 32532], [27, 33264], [31, 33408], [35, 33628], [40, 33928], [48, 34348], [52, 34628], [57, 34848], [65, 35600], [73, 35868], [79, 36268], [83, 36608], [91, 36948]]}, {"verse": 6, "start": 37863, "end": 44948, "text": "Having yet therefore one son, his wellbeloved, he sent him also last to them, saying, They will reverence my son.", "words": [[0, 37863], [7, 38067], [11, 38327], [21, 38807], [25, 39147], [30, 39787], [34, 40367], [47, 40947], [50, 41067], [55, 41287], [59, 41447], [64, 41787], [69, 42167], [72, 42367], [78, 42567], [86, 43347], [91, 43527], [96, 43707], [106, 44227], [109, 44407]]}, {"verse": 7, "start": 45298, "end": 52650, "text": "But those vinedressers said among themselves, This is the heir; come, let us kill him, and the inheritance shall be ours.", "words": [[0, 45298], [4, 45382], [10, 45782], [23, 46182], [28, 46462], [34, 46682], [46, 47662], [51, 48042], [54, 48302], [58, 48612], [64, 49108], [70, 49807], [74, 49907], [77, 50027], [82, 50287], [87, 50787], [91, 50907], [95, 51007], [107, 51487], [113, 51827], [116, 51987]]}, {"verse": 8, "start": 53000, "end": 56474, "text": "And they took him, and killed him, and cast him out of the vineyard.", "words": [[0, 53000], [4, 53125], [9, 53265], [14, 53525], [19, 53745], [23, 54065], [30, 54385], [35, 54685], [39, 55005], [44, 55305], [48, 55565], [52, 55725], [55, 55845], [59, 55965]]}, {"verse": 9, "start": 56824, "end": 63244, "text": "What shall therefore the lord of the vineyard do? he will come and destroy the vinedressers, and will give the vineyard to others.", "words": [[0, 56824], [5, 56946], [11, 57166], [21, 57626], [25, 57866], [30, 58106], [33, 58266], [37, 58386], [46, 58746], [50, 59426], [53, 59534], [58, 59674], [63, 59974], [67, 60234], [75, 60634], [79, 61094], [93, 61554], [97, 61739], [102, 61879], [107, 62059], [111, 62219], [120, 62559], [123, 62719]]}, {"verse": 10, "start": 63594, "end": 68479, "text": "And have you not read this scripture; The stone which the builders rejected is become the head of the corner:", "words": [[0, 63594], [4, 63711], [9, 63851], [13, 63991], [17, 64151], [22, 64361], [27, 64571], [38, 65383], [42, 65464], [48, 65784], [54, 66064], [58, 66244], [67, 66504], [76, 66864], [79, 67224], [86, 67524], [90, 67724], [95, 67824], [98, 67944], [102, 68024]]}, {"verse": 11, "start": 68829, "end": 72357, "text": "This was the Lord’s doing, and it is marvellous in our eyes?", "words": [[0, 68829], [5, 68977], [9, 69137], [13, 69317], [20, 69677], [27, 70557], [31, 70677], [34, 70797], [37, 71067], [48, 71337], [51, 71677], [55, 71857]]}, {"verse": 12, "start": 72637, "end": 81505, "text": "And they sought to lay hold on him, but feared the people: for they knew that he had spoken the parable against them: and they left him, and went their way.", "words": [[0, 72637], [4, 72778], [9, 72898], [16, 73158], [19, 73378], [23, 73538], [28, 73778], [31, 74158], [36, 74738], [40, 74878], [47, 75178], [51, 75398], [59, 76142], [63, 76232], [68, 76412], [73, 76652], [78, 76912], [81, 77072], [85, 77172], [92, 77552], [96, 77812], [104, 78272], [112, 78632], [118, 79439], [122, 79582], [127, 79722], [132, 80002], [137, 80302], [141, 80582], [146, 80762], [152, 80982]]}, {"verse": 13, "start": 81855, "end": 87262, "text": "¶ And they send to him certain of the Pharisees and of the Herodians, to catch him in his words.", "words": [[2, 81855], [6, 81974], [11, 82094], [16, 82374], [19, 82574], [23, 82694], [31, 83054], [34, 83314], [38, 83454], [48, 84314], [52, 84494], [55, 84634], [59, 84754], [70, 85554], [73, 85769], [79, 86049], [83, 86249], [86, 86389], [90, 86529]]}, {"verse": 14, "start": 87612, "end": 100304, "text": "And when they were come, they say to him, Master, we know that you are true, and care for no man: for you regard not the person of men, but teach the way of God in truth: Is it lawful to give tribute to Cæsar, or not?", "words": [[0, 87612], [4, 87773], [9, 87953], [14, 88153], [19, 88313], [25, 88953], [30, 89093], [34, 89373], [37, 89533], [42, 90113], [50, 90678], [53, 90738], [58, 90898], [63, 91078], [67, 91198], [71, 91318], [77, 91658], [81, 92018], [86, 92298], [90, 92498], [93, 92698], [98, 93418], [102, 93507], [106, 93667], [113, 94027], [117, 94287], [121, 94487], [128, 94747], [131, 94907], [136, 95307], [140, 95527], [146, 95767], [150, 95947], [154, 96087], [157, 96207], [161, 96447], [164, 96667], [171, 97262], [174, 97425], [177, 97545], [184, 98065], [187, 98205], [192, 98365], [200, 98745], [203, 99075], [210, 99405], [213, 99825]]}, {"verse": 15, "start": 100654, "end": 109360, "text": "Shall we give, or shall we not give? But he, knowing their hypocrisy, said to them, Why do you tempt me? bring me a denarius, that I may see it.", "words": [[0, 100654], [6, 100900], [9, 101080], [15, 101360], [18, 101620], [24, 101880], [27, 102080], [31, 102280], [37, 103039], [41, 103165], [45, 103325], [53, 103665], [59, 103945], [70, 104605], [75, 104845], [78, 105025], [84, 105524], [88, 105777], [91, 106037], [95, 106197], [101, 106397], [105, 106992], [111, 107216], [114, 107436], [116, 107796], [126, 108156], [131, 108516], [133, 108676], [137, 108816], [141, 109076]]}, {"verse": 16, "start": 109640, "end": 116655, "text": "And they brought it. And he says to them, Whose is this image and inscription? And they said to him, Cæsar’s.", "words": [[0, 109640], [4, 109782], [9, 109902], [17, 110202], [21, 110735], [25, 110879], [28, 110999], [33, 111259], [36, 111499], [42, 112253], [48, 112433], [51, 112573], [56, 112813], [62, 113233], [66, 113613], [79, 114708], [83, 114850], [88, 114970], [93, 115210], [96, 115430], [101, 116336]]}, {"verse": 17, "start": 116935, "end": 125746, "text": "And Jesus answering said to them, Render to Cæsar the things that are Cæsar’s, and to God the things that are God’s. And they marvelled at him.", "words": [[0, 116935], [4, 117083], [10, 117403], [20, 118003], [25, 118283], [28, 118483], [34, 119063], [41, 119345], [44, 119645], [50, 119945], [54, 120245], [61, 120565], [66, 120805], [70, 121255], [79, 121705], [83, 122085], [86, 122245], [90, 122605], [94, 122885], [101, 123225], [106, 123465], [110, 123605], [117, 124542], [121, 124666], [126, 125016], [136, 125366], [139, 125466]]}, {"verse": 18, "start": 126096, "end": 131095, "text": "¶ Then come to him the Sadducees, which say there is no resurrection; and they asked him, saying,", "words": [[2, 126096], [7, 126304], [12, 126584], [15, 126764], [19, 126864], [23, 126984], [34, 127424], [40, 127864], [44, 128104], [50, 128304], [53, 128444], [56, 128624], [70, 129669], [74, 129831], [79, 129991], [85, 130291], [90, 130531]]}, {"verse": 19, "start": 131295, "end": 140344, "text": "Master, Moses wrote to us, If a man’s brother die, and leave his wife behind him, and leave no children, that his brother should take his wife, and raise up seed to his brother.", "words": [[0, 131295], [8, 131598], [14, 131998], [20, 132298], [23, 132478], [27, 132838], [30, 132938], [32, 133018], [38, 133298], [46, 133538], [51, 133898], [55, 134138], [61, 134318], [65, 134498], [70, 134778], [77, 135158], [82, 135438], [86, 135618], [92, 135838], [95, 136038], [105, 136838], [110, 136978], [114, 137158], [122, 137498], [129, 137738], [134, 137998], [138, 138158], [144, 138767], [148, 138907], [154, 139147], [157, 139347], [162, 139627], [165, 139827], [169, 139927]]}, {"verse": 20, "start": 140694, "end": 144806, "text": "Now there were seven brethren: and the first took a wife, and dying left no seed.", "words": [[0, 140694], [4, 140909], [10, 141109], [15, 141249], [21, 141569], [31, 142385], [35, 142489], [39, 142569], [45, 142769], [50, 142989], [52, 143089], [58, 143309], [62, 143589], [68, 143909], [73, 144149], [76, 144349]]}, {"verse": 21, "start": 145156, "end": 149902, "text": "And the second took her, and died, neither left he any seed: and the third likewise.", "words": [[0, 145156], [4, 145288], [8, 145388], [15, 145708], [20, 145968], [25, 146168], [29, 146528], [35, 147068], [43, 147328], [48, 147648], [51, 147888], [55, 148068], [61, 148718], [65, 148836], [69, 148916], [75, 149176]]}, {"verse": 22, "start": 150252, "end": 154431, "text": "And the seven had her, and left no seed: last of all the woman died also.", "words": [[0, 150252], [4, 150397], [8, 150517], [14, 150777], [18, 151117], [23, 151297], [27, 151577], [32, 151797], [35, 152057], [41, 152748], [46, 152951], [49, 153151], [53, 153371], [57, 153411], [63, 153611], [68, 153911]]}, {"verse": 23, "start": 154781, "end": 160921, "text": "In the resurrection therefore, when they shall rise, whose wife shall she be of them? for the seven had her to wife.", "words": [[0, 154781], [3, 154901], [7, 155001], [20, 155441], [31, 156141], [36, 156401], [41, 156561], [47, 156781], [53, 157401], [59, 157561], [64, 157881], [70, 158141], [74, 158301], [77, 158441], [80, 158581], [86, 159179], [90, 159291], [94, 159471], [100, 159791], [104, 160231], [108, 160431], [111, 160611]]}, {"verse": 24, "start": 161201, "end": 168002, "text": "And Jesus answering said to them, Do you not therefore err, because you know not the scriptures, neither the power of God?", "words": [[0, 161201], [4, 161349], [10, 161669], [20, 162269], [25, 162549], [28, 162749], [34, 163329], [37, 163429], [41, 163529], [45, 163749], [55, 164149], [60, 164529], [68, 165129], [72, 165369], [77, 165509], [81, 165689], [85, 165849], [97, 166649], [105, 166809], [109, 167009], [115, 167329], [118, 167489]]}, {"verse": 25, "start": 168352, "end": 175154, "text": "For when they shall rise from the dead, they neither marry, nor are given in marriage; but are as the angels which are in heaven.", "words": [[0, 168352], [4, 168451], [9, 168591], [14, 168731], [20, 168911], [25, 169211], [30, 169411], [34, 169531], [40, 170031], [45, 170191], [53, 170411], [60, 170791], [64, 171191], [68, 171411], [74, 171671], [77, 171891], [87, 172716], [91, 172840], [95, 173120], [98, 173340], [102, 173480], [109, 173960], [115, 174260], [119, 174460], [122, 174620]]}, {"verse": 26, "start": 175504, "end": 186929, "text": "And as touching the dead, that they rise: have you not read in the book of Moses, how in the bush God spoke to him, saying, I am the God of Abraham, and the God of Isaac, and the God of Jacob?", "words": [[0, 175504], [4, 175667], [7, 175847], [16, 176167], [20, 176427], [26, 176807], [31, 177187], [36, 177347], [42, 178187], [47, 178348], [51, 178528], [55, 178708], [60, 178968], [63, 179128], [67, 179208], [72, 179448], [75, 179568], [82, 179988], [86, 180333], [89, 180493], [93, 180573], [98, 180853], [102, 181153], [108, 181493], [111, 181713], [116, 181933], [124, 182733], [126, 183053], [129, 183193], [133, 183293], [137, 183553], [140, 183673], [149, 184173], [153, 184633], [157, 184733], [161, 184973], [164, 185073], [171, 185841], [175, 185950], [179, 186050], [183, 186270], [186, 186390]]}, {"verse": 27, "start": 187279, "end": 193122, "text": "He is not the God of the dead, but the God of the living: you therefore do greatly err.", "words": [[0, 187279], [3, 187419], [6, 187619], [10, 187859], [14, 188099], [18, 188339], [21, 188479], [25, 188619], [31, 189299], [35, 189659], [39, 189839], [43, 190099], [46, 190219], [50, 190359], [58, 191116], [62, 191235], [72, 191695], [75, 192035], [83, 192475]]}, {"verse": 28, "start": 193402, "end": 202820, "text": "¶ And one of the scribes came, and having heard them reasoning together, and perceiving that he had answered them well, asked him, Which is the first commandment of all?", "words": [[2, 193402], [6, 193537], [10, 193697], [13, 193817], [17, 193957], [25, 194457], [31, 195257], [35, 195377], [42, 195597], [48, 195877], [53, 196057], [63, 196397], [73, 196897], [77, 197297], [88, 197877], [93, 198057], [96, 198157], [100, 198277], [109, 198597], [114, 198857], [120, 199497], [126, 199937], [131, 200555], [137, 200705], [140, 200865], [144, 201025], [150, 201285], [162, 201965], [165, 202165]]}, {"verse": 29, "start": 203100, "end": 211112, "text": "And Jesus answered him, The first of all the commandments is, Hear, O Israel; The Lord our God is one Lord:", "words": [[0, 203100], [4, 203240], [10, 203560], [19, 204020], [24, 204598], [28, 204701], [34, 205001], [37, 205241], [41, 205441], [45, 205561], [58, 206001], [62, 206763], [68, 207526], [70, 207826], [78, 208748], [82, 208830], [87, 209190], [91, 209490], [95, 209890], [98, 210250], [102, 210530]]}, {"verse": 30, "start": 211462, "end": 219670, "text": "And you shall love the Lord your God with all your heart, and with all your soul, and with all your mind, and with all your strength: this is the first commandment.", "words": [[0, 211462], [4, 211606], [8, 211766], [14, 211986], [19, 212246], [23, 212386], [28, 212586], [33, 212786], [37, 213106], [42, 213326], [46, 213506], [51, 213646], [58, 213986], [62, 214406], [67, 214566], [71, 214746], [76, 214886], [82, 215266], [86, 215666], [91, 215806], [95, 215966], [100, 216106], [106, 216426], [110, 216886], [115, 217026], [119, 217186], [124, 217326], [134, 218106], [139, 218384], [142, 218604], [146, 218744], [152, 218964]]}, {"verse": 31, "start": 220020, "end": 226725, "text": "And the second is like, namely this, You shall love your neighbour as yourself. There is none other commandment greater than these.", "words": [[0, 220020], [4, 220145], [8, 220245], [15, 220585], [18, 220805], [24, 221285], [31, 221565], [37, 222285], [41, 222425], [47, 222585], [52, 222885], [57, 223125], [67, 223365], [70, 223625], [80, 224385], [86, 224505], [89, 224645], [94, 224885], [100, 225165], [112, 225745], [120, 226005], [125, 226285]]}, {"verse": 32, "start": 227005, "end": 233913, "text": "And the scribe said to him, Well, Master, you have said the truth: for there is one God; and there is none other but he:", "words": [[0, 227005], [4, 227149], [8, 227249], [15, 227669], [20, 227869], [23, 228089], [28, 228624], [34, 228884], [42, 229484], [46, 229564], [51, 229744], [56, 229944], [60, 230104], [67, 230726], [71, 230823], [77, 231043], [80, 231203], [84, 231463], [89, 232233], [93, 232373], [99, 232553], [102, 232693], [107, 232953], [113, 233293], [117, 233513]]}, {"verse": 33, "start": 234263, "end": 244490, "text": "And to love him with all the heart, and with all the understanding, and with all the soul, and with all the strength, and to love his neighbour as himself, is more than all whole burnt offerings and sacrifices.", "words": [[0, 234263], [4, 234359], [7, 234499], [12, 234679], [16, 234859], [21, 235039], [25, 235179], [29, 235299], [36, 235999], [40, 235999], [45, 236179], [49, 236319], [53, 236439], [68, 237439], [72, 237499], [77, 237639], [81, 237799], [85, 237919], [91, 238639], [95, 238679], [100, 238839], [104, 238979], [108, 239119], [118, 239819], [122, 239939], [125, 240059], [130, 240219], [134, 240449], [144, 240679], [147, 240899], [156, 241620], [159, 241752], [164, 241952], [169, 242132], [173, 242372], [179, 242612], [185, 242872], [195, 243392], [199, 243612]]}, {"verse": 34, "start": 244770, "end": 254246, "text": "And when Jesus saw that he answered discreetly, he said to him, You are not far from the kingdom of God. And no man after that dared ask him any question.", "words": [[0, 244770], [4, 244881], [9, 245021], [15, 245301], [19, 245701], [24, 245881], [27, 246001], [36, 246301], [48, 247121], [51, 247201], [56, 247401], [59, 247601], [64, 248692], [68, 248855], [72, 248975], [76, 249155], [80, 249555], [85, 249835], [89, 249955], [97, 250255], [100, 250495], [105, 251316], [109, 251463], [112, 251703], [116, 251963], [122, 252323], [127, 252623], [133, 252963], [137, 253263], [141, 253423], [145, 253563]]}, {"verse": 35, "start": 254596, "end": 261481, "text": "¶ And Jesus answered and said, while he taught in the temple, How say the scribes that Christ is the Son of David?", "words": [[2, 254596], [6, 254723], [12, 255043], [21, 255583], [25, 255783], [31, 256403], [37, 256663], [40, 256843], [47, 257083], [50, 257303], [54, 257383], [62, 258586], [66, 258745], [70, 258985], [74, 259145], [82, 259745], [87, 259865], [94, 260205], [97, 260485], [101, 260625], [105, 260845], [108, 260965]]}, {"verse": 36, "start": 261831, "end": 268771, "text": "For David himself said by the Holy Spirit, The LORD said to my Lord, Sit on my right hand, till I make your enemies your footstool.", "words": [[0, 261831], [4, 261936], [10, 262236], [18, 262596], [23, 262896], [26, 263076], [30, 263196], [35, 263356], [43, 264196], [47, 264296], [52, 264536], [57, 264756], [60, 264896], [63, 265036], [69, 265616], [73, 265836], [76, 265996], [79, 266156], [85, 266356], [91, 266736], [96, 267136], [98, 267296], [103, 267496], [108, 267636], [116, 267916], [121, 268136]]}, {"verse": 37, "start": 269121, "end": 276433, "text": "David therefore himself calls him Lord; and from where is he then his son? And the common people heard him gladly.", "words": [[0, 269121], [6, 269385], [16, 269745], [24, 270205], [30, 270465], [34, 270725], [40, 271397], [44, 271721], [49, 271966], [55, 272266], [58, 272526], [61, 272686], [66, 272966], [70, 273146], [73, 274159], [75, 274539], [79, 274679], [83, 274779], [90, 275059], [97, 275399], [103, 275699], [107, 275819]]}, {"verse": 38, "start": 276783, "end": 285086, "text": "¶ And he said to them in his doctrine, Beware of the scribes, which love to go in long clothing, and love salutations in the marketplaces,", "words": [[2, 276783], [6, 276908], [9, 277028], [14, 277268], [17, 277468], [22, 277648], [25, 277828], [29, 278008], [39, 278884], [46, 279301], [49, 279461], [53, 279561], [62, 280441], [68, 280661], [73, 280981], [76, 281181], [79, 281401], [82, 281661], [87, 281941], [97, 282361], [101, 282676], [106, 282916], [118, 283776], [121, 284016], [125, 284116]]}, {"verse": 39, "start": 285436, "end": 289647, "text": "And the chief seats in the synagogues, and the uppermost rooms at feasts:", "words": [[0, 285436], [4, 285559], [8, 285679], [14, 285899], [20, 286259], [23, 286499], [27, 286579], [39, 287339], [43, 287699], [47, 287819], [57, 288359], [63, 288719], [66, 288939]]}, {"verse": 40, "start": 289997, "end": 296378, "text": "Which devour widows’ houses, and for a pretence make long prayers: these shall receive greater damnation.", "words": [[0, 289997], [6, 290138], [13, 290638], [21, 291118], [29, 291418], [33, 292138], [37, 292298], [39, 292638], [48, 292978], [53, 293118], [58, 293358], [67, 294205], [73, 294668], [79, 294948], [87, 295288], [95, 295648]]}, {"verse": 41, "start": 296658, "end": 304985, "text": "¶ And Jesus sat over against the treasury, and beheld how the people cast money into the treasury: and many that were rich cast in much.", "words": [[2, 296658], [6, 296807], [12, 297127], [16, 297567], [21, 297887], [29, 298267], [33, 298467], [43, 298947], [47, 299222], [54, 299702], [58, 299902], [62, 300022], [69, 300322], [74, 300702], [80, 301102], [85, 301402], [89, 301582], [99, 302461], [103, 302604], [108, 302904], [113, 303184], [118, 303364], [123, 303744], [128, 304144], [131, 304424]]}, {"verse": 42, "start": 305335, "end": 310173, "text": "And there came a certain poor widow, and she threw in two mites, which make a farthing.", "words": [[0, 305335], [4, 305466], [10, 305606], [15, 305826], [17, 305986], [25, 306226], [30, 306566], [37, 307326], [41, 307566], [45, 307726], [51, 307966], [54, 308166], [58, 308386], [65, 309026], [71, 309246], [76, 309466], [78, 309606]]}, {"verse": 43, "start": 310523, "end": 319669, "text": "And he called to him his disciples, and says to them, Assuredly I say to you, That this poor widow has cast more in, than all they which have cast into the treasury:", "words": [[0, 310523], [4, 310649], [7, 310749], [14, 311009], [17, 311229], [21, 311389], [25, 311629], [36, 312169], [40, 312589], [45, 312809], [48, 313029], [54, 313560], [64, 314124], [66, 314244], [70, 314444], [73, 314624], [78, 315204], [83, 315364], [88, 315564], [93, 315884], [99, 316164], [103, 316404], [108, 316704], [113, 316944], [117, 317204], [122, 317644], [126, 317884], [131, 318064], [137, 318244], [142, 318364], [147, 318664], [152, 318924], [156, 319104]]}, {"verse": 44, "start": 320019, "end": 327266, "text": "For all they did cast in of their abundance; but she of her want did cast in all that she had, even all her living.", "words": [[0, 320019], [4, 320125], [8, 320305], [13, 320485], [17, 320665], [22, 320965], [25, 321265], [28, 321445], [34, 321585], [45, 322566], [49, 322757], [53, 323017], [56, 323157], [60, 323277], [65, 323577], [69, 323957], [74, 324417], [77, 324657], [81, 324877], [86, 325037], [90, 325217], [95, 326017], [100, 326257], [104, 326617], [108, 326797]]}]}