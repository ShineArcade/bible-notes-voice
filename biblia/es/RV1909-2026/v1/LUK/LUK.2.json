{"book": "LUK", "chapter": 2, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 395749, "verses": [{"verse": 1, "start": 300, "end": 8240, "text": "Y aconteció en aquellos días que salió edicto de parte de Augusto César, que toda la tierra fuese empadronada.", "words": [[0, 300], [2, 425], [12, 1185], [15, 1385], [24, 1625], [29, 2065], [33, 2265], [39, 2705], [46, 3425], [49, 3525], [55, 3825], [58, 4105], [66, 4745], [73, 5305], [77, 5765], [82, 6025], [85, 6245], [92, 6505], [98, 7402]]}, {"verse": 2, "start": 8690, "end": 14198, "text": "Este empadronamiento primero fue hecho siendo Cirenio gobernador de la Siria.", "words": [[0, 8690], [5, 9307], [21, 10607], [29, 10967], [33, 11327], [39, 11567], [46, 12047], [54, 12527], [65, 13267], [68, 13427], [71, 13527]]}, {"verse": 3, "start": 14648, "end": 18629, "text": "E iban todos para ser empadronados, cada uno a su ciudad.", "words": [[0, 14648], [2, 14774], [7, 15074], [13, 15414], [18, 15774], [22, 16014], [36, 17154], [41, 17394], [45, 17734], [47, 17894], [50, 18014]]}, {"verse": 4, "start": 19079, "end": 30638, "text": "Y subió José de Galilea, de la ciudad de Nazaret, a Judea, a la ciudad de David, que se llama Belén, por cuanto era de la casa y familia de David;", "words": [[0, 19079], [2, 19362], [8, 19782], [13, 20182], [16, 20382], [25, 21582], [28, 21642], [31, 21782], [38, 22042], [41, 22382], [50, 23442], [52, 23562], [59, 24562], [61, 24682], [64, 24762], [71, 25102], [74, 25422], [81, 26202], [85, 26282], [88, 26422], [94, 26722], [101, 27975], [105, 28104], [112, 28364], [116, 28684], [119, 28824], [122, 28964], [127, 29264], [129, 29424], [137, 29904], [140, 30064]]}, {"verse": 5, "start": 31088, "end": 36840, "text": "Para ser empadronado con María su mujer, desposada con él, la cual estaba encinta.", "words": [[0, 31088], [5, 31233], [9, 31473], [21, 32353], [25, 32573], [31, 33013], [34, 33113], [41, 33803], [51, 34493], [55, 34773], [59, 35193], [62, 35413], [67, 35613], [74, 36255]]}, {"verse": 6, "start": 37290, "end": 43539, "text": "Y aconteció que estando ellos allí, se cumplieron los días en que ella había de parir.", "words": [[0, 37290], [2, 37399], [12, 38159], [16, 38379], [24, 38899], [30, 39159], [36, 40059], [39, 40319], [50, 40999], [54, 41219], [59, 41539], [62, 41859], [66, 42019], [71, 42339], [77, 42719], [80, 43148]]}, {"verse": 7, "start": 43989, "end": 53678, "text": "Y parió a su hijo primogénito, y le envolvió en pañales, y lo acostó en un pesebre, porque no había lugar para ellos en el mesón.", "words": [[0, 43989], [2, 44133], [8, 44593], [10, 44813], [13, 44993], [18, 45903], [31, 46813], [33, 47013], [36, 47153], [45, 47673], [48, 47773], [57, 48373], [59, 48813], [62, 48933], [69, 49453], [72, 49553], [75, 49713], [84, 50773], [91, 51053], [94, 51253], [100, 51493], [106, 51793], [111, 52133], [117, 52513], [120, 52893], [123, 53033]]}, {"verse": 8, "start": 54128, "end": 61246, "text": "Y había pastores en la misma tierra, que velaban y guardaban las vigilias de la noche sobre su ganado.", "words": [[0, 54128], [2, 54265], [8, 54505], [17, 55125], [20, 55365], [23, 55505], [29, 55705], [37, 56185], [41, 56765], [49, 57325], [51, 57745], [61, 58345], [65, 58545], [74, 59365], [77, 59485], [80, 59625], [86, 59905], [92, 60325], [95, 60565]]}, {"verse": 9, "start": 61696, "end": 69991, "text": "Y he aquí el ángel del Señor vino sobre ellos, y la claridad de Dios los cercó de resplandor; y tuvieron gran temor.", "words": [[0, 61696], [2, 61841], [5, 62121], [10, 62461], [13, 62641], [19, 63041], [23, 63221], [29, 63521], [34, 63901], [40, 64221], [47, 64861], [49, 65141], [52, 65281], [61, 65841], [64, 66021], [69, 66341], [73, 66801], [79, 67131], [82, 67461], [94, 68616], [96, 68717], [105, 69117], [110, 69397]]}, {"verse": 10, "start": 70441, "end": 78349, "text": "Pero el ángel les dijo: No temáis; porque he aquí os anuncio buenas noticias de gran gozo, que será para todo el pueblo:", "words": [[0, 70441], [5, 70585], [8, 70765], [14, 71185], [18, 71345], [24, 72097], [27, 72589], [35, 73360], [42, 73577], [45, 73857], [50, 74117], [53, 74297], [61, 74777], [68, 75057], [77, 75657], [80, 75837], [85, 76017], [91, 76757], [95, 76897], [100, 77137], [105, 77397], [110, 77657], [113, 77857]]}, {"verse": 11, "start": 78799, "end": 83352, "text": "Que os ha nacido hoy, en la ciudad de David, un Salvador, que es CRISTO el Señor.", "words": [[0, 78799], [4, 78900], [7, 79080], [10, 79200], [17, 79640], [22, 79880], [25, 80100], [28, 80200], [35, 80480], [38, 80700], [45, 81220], [48, 81340], [58, 81800], [62, 82220], [65, 82490], [72, 82760], [75, 82920]]}, {"verse": 12, "start": 83802, "end": 89030, "text": "Y esto os será por señal: hallaréis al niño envuelto en pañales, echado en un pesebre.", "words": [[0, 83802], [2, 83947], [7, 84077], [10, 84207], [15, 84567], [19, 84767], [26, 85627], [36, 86087], [39, 86227], [44, 86467], [53, 86967], [56, 87067], [65, 87647], [72, 88167], [75, 88287], [78, 88387]]}, {"verse": 13, "start": 89380, "end": 97633, "text": "Y repentinamente hubo con el ángel una multitud de los ejércitos celestiales, que alababan a Dios, y decían:", "words": [[0, 89380], [2, 89505], [17, 90405], [22, 90865], [26, 90985], [29, 91185], [35, 91585], [39, 91825], [48, 92525], [51, 92725], [55, 92865], [65, 93645], [78, 95085], [82, 95325], [91, 95905], [93, 95985], [99, 96245], [101, 96825]]}, {"verse": 14, "start": 97883, "end": 102969, "text": "Gloria en las alturas a Dios, y en la tierra paz, buena voluntad para con los hombres.", "words": [[0, 97883], [7, 98309], [10, 98409], [14, 98529], [22, 99029], [24, 99189], [30, 99389], [32, 99789], [35, 99889], [38, 99989], [45, 100449], [50, 100969], [56, 101269], [65, 101869], [70, 102089], [74, 102289], [78, 102429]]}, {"verse": 15, "start": 103319, "end": 117182, "text": "Y aconteció que como los ángeles se fueron de ellos al cielo, los pastores dijeron los unos a los otros: Pasemos pues hasta Belén, y veamos esto que ha sucedido, que el Señor nos ha manifestado.", "words": [[0, 103319], [2, 103441], [12, 104201], [16, 104401], [21, 104661], [25, 104881], [33, 105501], [36, 105721], [43, 106081], [46, 106381], [52, 106641], [55, 106941], [62, 108061], [66, 108181], [75, 108761], [83, 109361], [87, 109521], [92, 109801], [94, 110061], [98, 110221], [105, 111186], [113, 111594], [118, 111914], [124, 112414], [131, 112934], [133, 113394], [140, 113834], [145, 114314], [149, 114554], [152, 114654], [162, 115314], [166, 115534], [169, 115694], [175, 115954], [179, 116254], [182, 116374]]}, {"verse": 16, "start": 117532, "end": 124019, "text": "Y vinieron aprisa, y hallaron a María, y a José, y al niño acostado en el pesebre.", "words": [[0, 117532], [2, 117628], [11, 118478], [19, 119328], [21, 119408], [30, 119828], [32, 119928], [39, 120268], [41, 120868], [43, 120948], [49, 121288], [51, 121808], [54, 121948], [59, 122288], [68, 123028], [71, 123148], [74, 123288]]}, {"verse": 17, "start": 124469, "end": 129279, "text": "Y viéndolo, hicieron notorio lo que les había sido dicho del niño.", "words": [[0, 124469], [2, 124615], [12, 125215], [21, 125875], [29, 126595], [32, 127015], [36, 127155], [40, 127295], [46, 127615], [51, 127975], [57, 128315], [61, 128575]]}, {"verse": 18, "start": 129729, "end": 134222, "text": "Y todos los que oyeron, se maravillaron de lo que los pastores les decían.", "words": [[0, 129729], [2, 129873], [8, 130113], [12, 130413], [16, 130613], [24, 131113], [27, 131273], [40, 131993], [43, 132173], [46, 132293], [50, 132393], [54, 132533], [63, 133113], [67, 133453]]}, {"verse": 19, "start": 134672, "end": 140073, "text": "Pero María guardaba todas estas cosas, meditándolas en su corazón.", "words": [[0, 134672], [5, 134894], [11, 135294], [20, 136274], [26, 136534], [32, 136954], [39, 137854], [52, 138794], [55, 139094], [58, 139294]]}, {"verse": 20, "start": 140523, "end": 149298, "text": "Y se volvieron los pastores glorificando y alabando a Dios de todas las cosas que habían oído y visto, como les había sido dicho.", "words": [[0, 140523], [2, 140645], [5, 140765], [15, 141285], [19, 141465], [28, 142185], [41, 143385], [43, 143525], [52, 144085], [54, 144205], [59, 144425], [62, 144985], [68, 145205], [72, 145485], [78, 145825], [82, 146085], [89, 146325], [94, 146705], [96, 146825], [103, 147205], [108, 147845], [112, 148025], [118, 148365], [123, 148645]]}, {"verse": 21, "start": 149748, "end": 160277, "text": "Y pasados los ocho días para circuncidar al niño, llamaron su nombre JESÚS; el cual le fue puesto por el ángel antes que él fuese concebido en el vientre.", "words": [[0, 149748], [2, 149853], [10, 150333], [14, 150513], [19, 150913], [24, 151093], [29, 151353], [41, 152093], [44, 152293], [50, 153073], [59, 153693], [62, 153893], [69, 154193], [76, 155270], [79, 155436], [84, 155656], [87, 155856], [91, 156036], [98, 156396], [102, 156676], [105, 156836], [111, 157276], [117, 157736], [121, 158316], [124, 158476], [130, 158816], [140, 159496], [143, 159616], [146, 159716]]}, {"verse": 22, "start": 160727, "end": 170001, "text": "Y como se cumplieron los días de la purificación de ella, conforme a la ley de Moisés, le trajeron a Jerusalén para presentarle al Señor,", "words": [[0, 160727], [2, 160872], [7, 161152], [10, 161372], [21, 162092], [25, 162312], [30, 162612], [33, 162792], [36, 162912], [49, 163592], [52, 163892], [58, 164552], [67, 165172], [69, 165272], [72, 165312], [76, 165512], [79, 165652], [87, 166512], [90, 166592], [99, 167172], [101, 167252], [111, 167932], [116, 168372], [128, 169132], [131, 169432]]}, {"verse": 23, "start": 170451, "end": 176778, "text": "(Como está escrito en la ley del Señor: Todo varón que abra la matriz, será llamado santo al Señor),", "words": [[0, 170451], [6, 170615], [11, 170795], [19, 171135], [22, 171415], [25, 171535], [29, 171755], [33, 171935], [40, 172830], [45, 172975], [51, 173315], [55, 173495], [60, 173715], [63, 173895], [71, 174655], [76, 175055], [84, 175435], [90, 175955], [93, 176095]]}, {"verse": 24, "start": 177228, "end": 184819, "text": "Y para dar la ofrenda, conforme a lo que está dicho en la ley del Señor: un par de tórtolas, o dos palominos.", "words": [[0, 177228], [2, 177336], [7, 177556], [11, 177816], [14, 177996], [23, 178676], [32, 179436], [34, 179536], [37, 179616], [41, 179716], [46, 179916], [52, 180236], [55, 180476], [58, 180636], [62, 180876], [66, 181076], [73, 182008], [76, 182153], [80, 182413], [83, 182553], [93, 183253], [95, 183693], [99, 183893]]}, {"verse": 25, "start": 185269, "end": 197986, "text": "Y he aquí, había un hombre en Jerusalén, llamado Simeón, y este hombre, justo y piadoso, esperaba la consolación de Israel: y el Espíritu Santo era sobre él.", "words": [[0, 185269], [2, 185354], [5, 185474], [11, 185734], [17, 186194], [20, 186534], [27, 186854], [30, 187254], [41, 188114], [49, 188914], [57, 189934], [59, 190474], [64, 190734], [72, 191054], [78, 191474], [80, 191714], [89, 192394], [98, 193114], [101, 193254], [113, 194074], [116, 194254], [124, 195275], [126, 195560], [129, 195660], [138, 196220], [144, 196620], [148, 197120], [154, 197460]]}, {"verse": 26, "start": 198436, "end": 204812, "text": "Y había recibido respuesta del Espíritu Santo, que no vería la muerte antes que viese al Cristo del Señor.", "words": [[0, 198436], [2, 198561], [8, 198761], [17, 199481], [27, 199921], [31, 200261], [40, 200761], [47, 201581], [51, 201741], [54, 201921], [60, 202241], [63, 202341], [70, 202621], [76, 202961], [80, 203161], [86, 203461], [89, 203641], [96, 203941], [100, 204201]]}, {"verse": 27, "start": 205262, "end": 215098, "text": "Y vino por Espíritu al templo. Y cuando metieron al niño Jesús sus padres en el templo, para hacer por él conforme a la costumbre de la ley,", "words": [[0, 205262], [2, 205387], [7, 205607], [11, 205827], [20, 206387], [23, 206487], [31, 207421], [33, 207541], [40, 207781], [49, 208401], [52, 208581], [57, 208921], [63, 209321], [67, 209641], [74, 210201], [77, 210541], [80, 210701], [88, 211901], [93, 212161], [99, 212501], [103, 212741], [106, 212901], [115, 213601], [117, 213661], [120, 213741], [130, 214361], [133, 214501], [136, 214641]]}, {"verse": 28, "start": 215548, "end": 220715, "text": "Entonces él le tomó en sus brazos, y bendijo a Dios, y dijo:", "words": [[0, 215548], [9, 216154], [12, 216714], [15, 216914], [20, 217294], [23, 217374], [27, 217534], [35, 218094], [37, 218314], [45, 218914], [47, 219074], [53, 219354], [55, 220214]]}, {"verse": 29, "start": 220965, "end": 224892, "text": "Ahora despides, Señor, a tu siervo, conforme a tu palabra, en paz;", "words": [[0, 220965], [6, 221267], [16, 221927], [23, 222447], [25, 222507], [28, 222587], [36, 223067], [45, 223647], [47, 223687], [50, 223787], [59, 224147], [62, 224387]]}, {"verse": 30, "start": 225342, "end": 227496, "text": "Porque han visto mis ojos tu salvación,", "words": [[0, 225342], [7, 225520], [11, 225700], [17, 225980], [21, 226200], [26, 226460], [29, 226680]]}, {"verse": 31, "start": 227946, "end": 230870, "text": "La cual has preparado en presencia de todos los pueblos;", "words": [[0, 227946], [3, 228067], [8, 228247], [12, 228467], [22, 229027], [25, 229127], [35, 229687], [38, 229827], [44, 230007], [48, 230227]]}, {"verse": 32, "start": 231320, "end": 235749, "text": "Luz para ser revelada a los Gentiles, y la gloria de tu pueblo Israel.", "words": [[0, 231320], [4, 231528], [9, 231928], [13, 232188], [22, 232748], [24, 232908], [28, 233268], [38, 233628], [40, 234068], [43, 234188], [50, 234528], [53, 234648], [56, 234808], [63, 235088]]}, {"verse": 33, "start": 236099, "end": 241002, "text": "Y José y su madre estaban maravillados de las cosas que se decían de él.", "words": [[0, 236099], [2, 236281], [7, 236581], [9, 237001], [12, 237181], [18, 237601], [26, 238041], [39, 238921], [42, 239081], [46, 239201], [52, 239501], [56, 239741], [59, 239881], [66, 240381], [69, 240601]]}, {"verse": 34, "start": 241452, "end": 251459, "text": "Y los bendijo Simeón, y dijo a su madre María: He aquí, este es puesto para caída y para levantamiento de muchos en Israel; y para señal que será contradicha;", "words": [[0, 241452], [2, 241658], [6, 241898], [14, 242138], [22, 242838], [24, 243478], [29, 243778], [31, 243918], [34, 244038], [40, 244318], [47, 245342], [50, 245485], [56, 245965], [61, 246185], [64, 246325], [71, 246525], [76, 246865], [82, 247285], [84, 247405], [89, 247565], [103, 248265], [106, 248405], [113, 248645], [116, 248865], [124, 249712], [126, 249810], [131, 249970], [137, 250350], [141, 250470], [146, 250670]]}, {"verse": 35, "start": 251909, "end": 257921, "text": "Y una espada traspasará tu misma alma, para que sean manifestados los pensamientos de muchos corazones.", "words": [[0, 251909], [2, 252009], [6, 252169], [13, 252589], [24, 253229], [27, 253409], [33, 253649], [39, 254029], [44, 254649], [48, 254809], [53, 255069], [66, 255809], [70, 255969], [83, 256629], [86, 256809], [93, 257029]]}, {"verse": 36, "start": 258271, "end": 272507, "text": "Estaba también allí Ana, profetisa, hija de Fanuel, de la tribu de Aser; la cual había venido en grande edad, y había vivido con su marido siete años desde su virginidad;", "words": [[0, 258271], [7, 258616], [15, 258996], [20, 259236], [25, 260546], [36, 261856], [41, 262176], [44, 262276], [52, 263356], [55, 263376], [58, 263496], [64, 263876], [67, 264306], [73, 264979], [76, 265084], [81, 265384], [87, 265804], [94, 266264], [97, 266424], [104, 266624], [110, 267524], [112, 267684], [118, 267924], [125, 268444], [129, 268584], [132, 268824], [139, 269304], [145, 269904], [150, 270604], [156, 271204], [159, 271874]]}, {"verse": 37, "start": 272957, "end": 281889, "text": "Y era viuda de hasta ochenta y cuatro años, que no se apartaba del templo, sirviendo de noche y de día con ayunos y oraciones.", "words": [[0, 272957], [2, 273134], [6, 273314], [12, 273714], [15, 273894], [21, 274084], [29, 274274], [31, 274464], [38, 274654], [44, 275974], [48, 276054], [51, 276214], [54, 276354], [63, 276854], [67, 277054], [75, 277854], [85, 278534], [88, 278694], [94, 278994], [96, 279374], [99, 279514], [103, 279774], [107, 280014], [114, 280454], [116, 280574]]}, {"verse": 38, "start": 282339, "end": 292719, "text": "Y esta, sobreviniendo en la misma hora, juntamente confesaba al Señor, y hablaba de él a todos los que esperaban la redención en Jerusalén.", "words": [[0, 282339], [2, 282497], [8, 283167], [22, 283837], [25, 283957], [28, 284097], [34, 284357], [40, 284757], [51, 285777], [61, 286537], [64, 286757], [71, 287137], [73, 287717], [81, 288157], [84, 288337], [87, 288577], [89, 288817], [95, 289097], [99, 289377], [103, 289557], [113, 290177], [116, 290637], [126, 291357], [129, 291737]]}, {"verse": 39, "start": 293169, "end": 300250, "text": "Pero como cumplieron todas las cosas según la ley del Señor, se volvieron a Galilea, a su ciudad de Nazaret.", "words": [[0, 293169], [5, 293296], [10, 293536], [21, 294256], [27, 294496], [31, 294796], [37, 295236], [43, 295596], [46, 295796], [50, 295996], [54, 296176], [61, 297196], [64, 297356], [74, 297816], [76, 297996], [85, 298756], [87, 298796], [90, 298936], [97, 299296], [100, 299536]]}, {"verse": 40, "start": 300700, "end": 308502, "text": "Y el niño crecía, y se fortalecía, y se llenaba de sabiduría; y la gracia de Dios era sobre él.", "words": [[0, 300700], [2, 300805], [5, 300945], [10, 301245], [18, 301925], [20, 302705], [23, 302845], [35, 303665], [37, 304145], [40, 304265], [48, 304765], [51, 304905], [62, 306151], [64, 306277], [67, 306377], [74, 306877], [77, 306997], [82, 307297], [86, 307657], [92, 307997]]}, {"verse": 41, "start": 308952, "end": 313466, "text": "E iban sus padres todos los años a Jerusalén en la fiesta de la Pascua.", "words": [[0, 308952], [2, 309074], [7, 309334], [11, 309494], [18, 309874], [24, 310194], [28, 310454], [33, 310814], [35, 311034], [45, 311754], [48, 312074], [51, 312194], [58, 312574], [61, 312694], [64, 312814]]}, {"verse": 42, "start": 313916, "end": 320755, "text": "Y cuando fue de doce años, subieron ellos a Jerusalén conforme a la costumbre del día de la fiesta.", "words": [[0, 313916], [2, 314013], [9, 314233], [13, 314633], [16, 314853], [21, 315073], [27, 315993], [36, 316693], [42, 316913], [44, 317133], [54, 317813], [63, 318163], [65, 318513], [68, 318633], [78, 319293], [82, 319553], [86, 319793], [89, 319933], [92, 320073]]}, {"verse": 43, "start": 321205, "end": 328815, "text": "Y acabados los días, volviendo ellos, se quedó el niño Jesús en Jerusalén, sin saberlo José y su madre.", "words": [[0, 321205], [2, 321330], [11, 321850], [15, 322030], [21, 322310], [31, 322970], [38, 323550], [41, 323810], [47, 324170], [50, 324290], [55, 324710], [61, 325170], [64, 325470], [75, 326290], [79, 326790], [87, 327490], [92, 327870], [94, 328150], [97, 328290]]}, {"verse": 44, "start": 329265, "end": 336967, "text": "Y pensando que estaba en el grupo, anduvieron camino de un día; y le buscaban entre los parientes y entre los conocidos:", "words": [[0, 329265], [2, 329603], [11, 330003], [15, 330263], [22, 330483], [25, 330663], [28, 330783], [35, 331683], [46, 332163], [53, 332463], [56, 332783], [59, 332883], [64, 333657], [66, 333781], [69, 333881], [78, 334481], [84, 334741], [88, 334941], [98, 335461], [100, 335661], [106, 335841], [110, 336041]]}, {"verse": 45, "start": 337417, "end": 341635, "text": "Pero como no le hallasen, volvieron a Jerusalén buscándole.", "words": [[0, 337417], [5, 337561], [10, 337821], [13, 338041], [16, 338621], [26, 339201], [36, 339741], [38, 340141], [48, 340541]]}, {"verse": 46, "start": 342085, "end": 350246, "text": "Y aconteció, que tres días después le hallaron en el templo, sentado en medio de los maestros, oyéndoles y preguntándoles.", "words": [[0, 342085], [2, 342223], [13, 342943], [17, 343123], [22, 343363], [27, 343643], [35, 343943], [38, 344143], [47, 344623], [50, 344783], [53, 344943], [61, 345623], [69, 346403], [72, 346583], [78, 346863], [81, 347063], [85, 347203], [95, 348363], [105, 348843], [107, 349023]]}, {"verse": 47, "start": 350696, "end": 356787, "text": "Y todos los que le oían, se maravillaban de su entendimiento y de sus respuestas.", "words": [[0, 350696], [2, 350818], [8, 351198], [12, 351818], [16, 351978], [19, 352158], [25, 352678], [28, 353258], [41, 354018], [44, 354218], [47, 354358], [61, 355418], [63, 355538], [66, 355658], [70, 355838]]}, {"verse": 48, "start": 357237, "end": 367826, "text": "Y cuando le vieron, se maravillaron; y le dijo su madre: Hijo, ¿por qué nos has hecho así? He aquí, tu padre y yo te hemos buscado con dolor.", "words": [[0, 357237], [2, 357325], [9, 357525], [12, 357745], [20, 358385], [23, 358485], [37, 359910], [39, 360105], [42, 360300], [47, 360495], [50, 360795], [57, 361656], [63, 362071], [68, 362151], [72, 362331], [76, 362491], [80, 362711], [86, 362951], [91, 363887], [94, 363977], [100, 364197], [103, 364397], [109, 364777], [111, 365197], [114, 365337], [117, 365457], [123, 365637], [131, 366137], [135, 366357]]}, {"verse": 49, "start": 368176, "end": 376555, "text": "Entonces él les dice: ¿Qué hay? ¿por qué me buscabais? ¿No sabíais que en los asuntos de mi Padre me conviene estar?", "words": [[0, 368176], [9, 368724], [12, 369244], [16, 369584], [22, 370454], [27, 370618], [32, 371217], [37, 371343], [41, 371483], [44, 371646], [55, 372803], [59, 373323], [67, 373843], [71, 374103], [74, 374263], [78, 374403], [86, 374963], [89, 375063], [92, 375183], [98, 375463], [101, 375663], [110, 376063]]}, {"verse": 50, "start": 377005, "end": 379543, "text": "Pero ellos no entendieron las palabras que les habló.", "words": [[0, 377005], [5, 377185], [11, 377425], [14, 377645], [26, 378205], [30, 378365], [39, 378705], [43, 378925], [47, 379065]]}, {"verse": 51, "start": 379993, "end": 388560, "text": "Y descendió con ellos, y vino a Nazaret, y estaba sujeto a ellos. Y su madre guardaba todas estas cosas en su corazón.", "words": [[0, 379993], [2, 380115], [12, 380635], [16, 380855], [23, 381095], [25, 381695], [30, 381895], [32, 382035], [41, 382515], [43, 382935], [50, 383195], [57, 383775], [59, 383875], [66, 384718], [68, 384817], [71, 384937], [77, 385317], [86, 386217], [92, 386537], [98, 386957], [104, 387377], [107, 387657], [110, 387817]]}, {"verse": 52, "start": 389010, "end": 395349, "text": "Y Jesús crecía en sabiduría, y en edad, y en gracia para con Dios y los hombres.", "words": [[0, 389010], [2, 389135], [8, 389515], [15, 390335], [18, 390515], [29, 391315], [31, 391575], [34, 391755], [40, 392415], [42, 392655], [45, 392815], [52, 393375], [57, 393575], [61, 393815], [66, 394135], [68, 394535], [72, 394715]]}]}