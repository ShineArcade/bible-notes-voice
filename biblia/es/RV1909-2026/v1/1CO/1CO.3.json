{"book": "1CO", "chapter": 3, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 149943, "verses": [{"verse": 1, "start": 300, "end": 7609, "text": "De manera que yo, hermanos, no pude hablaros como a espirituales, sino como a carnales, como a niños en Cristo.", "words": [[0, 300], [3, 425], [10, 665], [14, 985], [18, 1385], [28, 2465], [31, 2585], [36, 2825], [45, 3325], [50, 3425], [52, 3525], [66, 4705], [71, 5045], [76, 5305], [78, 5465], [88, 6405], [93, 6485], [95, 6625], [101, 6805], [104, 7105]]}, {"verse": 2, "start": 7959, "end": 13573, "text": "Os di a beber leche, y no alimento sólido: porque aún no podíais, ni aun podéis ahora;", "words": [[0, 7959], [3, 8100], [6, 8280], [8, 8360], [14, 8600], [21, 9020], [23, 9380], [26, 9500], [35, 9920], [43, 10822], [50, 11002], [54, 11202], [57, 11382], [66, 12182], [69, 12402], [73, 12602], [80, 13022]]}, {"verse": 3, "start": 13923, "end": 21829, "text": "Porque todavía sois carnales: pues habiendo entre vosotros celos, y contiendas, y divisiones, ¿no sois carnales, y andáis como hombres?", "words": [[0, 13923], [7, 14112], [15, 14512], [20, 14912], [30, 15867], [35, 15994], [44, 16394], [50, 16634], [59, 17134], [66, 17574], [68, 17934], [80, 18294], [82, 18394], [94, 19174], [98, 19594], [103, 19854], [113, 20514], [115, 20634], [122, 20934], [127, 21194]]}, {"verse": 4, "start": 22179, "end": 28123, "text": "Porque diciendo el uno: Yo cierto soy de Pablo; y el otro: Yo de Apolos; ¿no sois carnales?", "words": [[0, 22179], [7, 22373], [16, 22813], [19, 23108], [24, 23567], [27, 23786], [34, 24166], [38, 24286], [41, 24406], [48, 25096], [50, 25216], [53, 25316], [59, 25964], [62, 26107], [65, 26467], [73, 27036], [77, 27175], [82, 27415]]}, {"verse": 5, "start": 28473, "end": 36407, "text": "¿Qué pues es Pablo? ¿y qué es Apolos? Ministros por los cuales habéis creído; y eso según que a cada uno ha concedido el Señor.", "words": [[0, 28473], [5, 28571], [10, 28791], [13, 29051], [20, 29730], [23, 29866], [27, 29986], [30, 30106], [38, 30966], [48, 31485], [52, 31645], [56, 31785], [63, 32005], [70, 32425], [78, 33191], [80, 33340], [84, 33620], [90, 33980], [94, 34240], [96, 34340], [101, 34520], [105, 34820], [108, 35060], [118, 35700], [121, 35840]]}, {"verse": 6, "start": 36757, "end": 40244, "text": "Yo planté, Apolos regó: pero Dios ha dado el crecimiento.", "words": [[0, 37046], [3, 37376], [11, 37706], [18, 38036], [24, 38525], [29, 38662], [34, 38882], [37, 39102], [42, 39282], [45, 39402]]}, {"verse": 7, "start": 40594, "end": 45271, "text": "Así que, ni el que planta es algo, ni el que riega; sino Dios, que da el crecimiento.", "words": [[0, 40594], [4, 40780], [9, 40940], [12, 41080], [15, 41180], [19, 41280], [26, 41660], [29, 41780], [35, 42080], [38, 42360], [41, 42460], [45, 42600], [52, 43417], [57, 43592], [63, 43872], [67, 44112], [70, 44272], [73, 44372]]}, {"verse": 8, "start": 45621, "end": 51976, "text": "Y el que planta y el que riega son una misma cosa; aunque cada uno recibirá su recompensa conforme a su labor.", "words": [[0, 45621], [2, 45745], [5, 45825], [9, 45945], [16, 46485], [18, 46605], [21, 46705], [25, 46825], [31, 47265], [35, 47445], [39, 47645], [45, 47885], [51, 48744], [58, 48930], [63, 49190], [67, 49430], [76, 49990], [79, 50110], [90, 50810], [99, 51370], [101, 51430], [104, 51550]]}, {"verse": 9, "start": 52326, "end": 58395, "text": "Porque nosotros, colaboradores somos de Dios; y vosotros labranza de Dios sois, edificio de Dios sois.", "words": [[0, 52326], [7, 52505], [17, 52785], [31, 53685], [37, 53965], [40, 54225], [46, 55157], [48, 55260], [57, 55660], [66, 56200], [69, 56500], [74, 56800], [80, 57100], [89, 57600], [92, 57883], [97, 58167]]}, {"verse": 10, "start": 58745, "end": 67556, "text": "Conforme a la gracia de Dios que me ha sido dada, yo como perito arquitecto puse el fundamento, y otro edifica encima: pero cada uno vea cómo edifica encima.", "words": [[0, 58745], [9, 59127], [11, 59287], [14, 59347], [21, 59707], [24, 59807], [29, 59987], [33, 60187], [36, 60307], [39, 60387], [44, 60547], [50, 61347], [53, 61447], [58, 61647], [65, 62027], [76, 62627], [81, 62867], [84, 62947], [96, 63747], [98, 63887], [103, 64107], [111, 64507], [119, 65282], [124, 65419], [129, 65679], [133, 65979], [137, 66319], [142, 66559], [150, 66999]]}, {"verse": 11, "start": 67906, "end": 72699, "text": "Porque nadie puede poner otro fundamento que el que está puesto, el cual es Jesucristo.", "words": [[0, 67906], [7, 68107], [13, 68347], [19, 68667], [25, 69007], [30, 69247], [41, 70007], [45, 70107], [48, 70227], [52, 70307], [57, 70507], [65, 71347], [68, 71447], [73, 71667], [76, 71927]]}, {"verse": 12, "start": 73049, "end": 78675, "text": "Y si alguno edifica sobre este fundamento oro, plata, piedras preciosas, madera, heno, hojarasca;", "words": [[0, 73049], [2, 73155], [5, 73275], [12, 73655], [20, 74095], [26, 74375], [31, 74615], [42, 75295], [47, 75655], [54, 76075], [62, 76435], [73, 77115], [81, 77635], [87, 78155]]}, {"verse": 13, "start": 79025, "end": 88393, "text": "La obra de cada uno será manifestada: porque el día la declarará; porque por el fuego será manifestada; y la obra de cada uno cuál sea, el fuego hará la prueba.", "words": [[0, 79025], [3, 79149], [8, 79389], [11, 79529], [16, 79729], [20, 80009], [25, 80229], [38, 81305], [45, 81469], [48, 81649], [52, 81849], [55, 81989], [66, 82903], [73, 83063], [77, 83263], [80, 83383], [86, 83603], [91, 83883], [104, 84924], [106, 85043], [109, 85163], [114, 85403], [117, 85583], [122, 85803], [126, 86143], [131, 86363], [136, 87123], [139, 87203], [145, 87463], [150, 87803], [153, 87883]]}, {"verse": 14, "start": 88743, "end": 93286, "text": "Si permanece la obra de alguno que edificó encima, recibirá recompensa.", "words": [[0, 88743], [3, 88886], [13, 89486], [16, 89646], [21, 89866], [24, 90026], [31, 90446], [35, 90566], [43, 91106], [51, 91966], [60, 92466]]}, {"verse": 15, "start": 93636, "end": 99253, "text": "Si la obra de alguno es quemada, será perdida: pero él será salvo, pero así como por fuego.", "words": [[0, 93636], [3, 93758], [6, 93898], [11, 94118], [14, 94298], [21, 94718], [24, 94838], [33, 95298], [38, 95618], [47, 96532], [52, 96693], [55, 96913], [60, 97153], [67, 97773], [72, 97913], [76, 98213], [81, 98453], [85, 98693]]}, {"verse": 16, "start": 99603, "end": 103800, "text": "¿No sabéis que sois templo de Dios, y que el Espíritu de Dios mora en vosotros?", "words": [[0, 99603], [4, 99726], [11, 100086], [15, 100226], [20, 100506], [27, 100906], [30, 100986], [36, 101226], [38, 101546], [42, 101706], [45, 101846], [54, 102366], [57, 102426], [62, 102646], [67, 103026], [70, 103086]]}, {"verse": 17, "start": 104150, "end": 112282, "text": "Si alguno profana el templo de Dios, Dios destruirá al tal: porque el templo de Dios, el cual sois vosotros, santo es.", "words": [[0, 104150], [3, 104307], [10, 104687], [18, 105127], [21, 105267], [28, 105687], [31, 105747], [37, 106607], [42, 106907], [52, 107627], [55, 107807], [60, 108396], [67, 108593], [70, 108753], [77, 109153], [80, 109213], [86, 109953], [89, 110073], [94, 110253], [99, 110593], [109, 111413], [115, 111813]]}, {"verse": 18, "start": 112632, "end": 119785, "text": "Nadie se engañe a sí mismo: si alguno entre vosotros parece ser sabio en este siglo, hágase necio, para ser sabio.", "words": [[0, 112632], [6, 113058], [9, 113198], [16, 113758], [18, 113778], [21, 113938], [28, 114619], [31, 114747], [38, 115187], [44, 115287], [53, 115787], [60, 116167], [64, 116447], [70, 116827], [73, 116907], [78, 117127], [85, 117687], [92, 118247], [99, 118807], [104, 119027], [108, 119207]]}, {"verse": 19, "start": 120135, "end": 127265, "text": "Porque la sabiduría de este mundo es necedad para con Dios; pues escrito está: El que prende a los sabios en la astucia de ellos.", "words": [[0, 120135], [7, 120319], [10, 120459], [20, 121039], [23, 121139], [28, 121299], [34, 121579], [37, 121919], [45, 122259], [50, 122459], [54, 122659], [60, 123375], [65, 123523], [73, 123883], [79, 124629], [82, 124754], [86, 124874], [93, 125084], [95, 125294], [99, 125414], [106, 125874], [109, 126014], [112, 126134], [120, 126554], [123, 126734]]}, {"verse": 20, "start": 127615, "end": 131987, "text": "Y otra vez: El Señor conoce los pensamientos de los sabios, que son vanos.", "words": [[0, 127615], [2, 127742], [7, 127922], [12, 128677], [15, 128775], [21, 129035], [28, 129515], [32, 129635], [45, 130295], [48, 130455], [52, 130575], [60, 131035], [64, 131195], [68, 131375]]}, {"verse": 21, "start": 132337, "end": 136088, "text": "Así que, ninguno se gloríe en los hombres; porque todo es vuestro;", "words": [[0, 132337], [4, 132717], [9, 132857], [17, 133337], [20, 133617], [27, 133897], [30, 133977], [34, 134097], [43, 134787], [50, 134996], [55, 135236], [58, 135456]]}, {"verse": 22, "start": 136438, "end": 145828, "text": "Sea Pablo, sea Apolos, sea Cefas, sea el mundo, sea la vida, sea la muerte, sea lo presente, sea lo por venir; todo es vuestro;", "words": [[0, 136438], [4, 136657], [11, 137357], [15, 137557], [23, 138457], [27, 138967], [34, 139477], [38, 139637], [41, 139797], [48, 140477], [52, 140657], [55, 140817], [61, 141457], [65, 141597], [68, 141757], [76, 142537], [80, 142677], [83, 142817], [93, 143757], [97, 143937], [100, 144214], [104, 144490], [111, 144987], [116, 145147], [119, 145307]]}, {"verse": 23, "start": 146178, "end": 149543, "text": "Y vosotros de Cristo; y Cristo de Dios.", "words": [[0, 146178], [2, 146301], [11, 146761], [14, 147001], [22, 147727], [24, 147853], [31, 148273], [34, 148473]]}]}