{"book": "MRK", "chapter": 4, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 314777, "verses": [{"verse": 1, "start": 300, "end": 12240, "text": "Y otra vez comenzó a enseñar junto al mar, y se juntó a él mucha gente; tanto, que entrando él en un barco, se sentó en el mar: y toda la gente estaba en tierra junto al mar.", "words": [[0, 300], [2, 467], [7, 607], [11, 967], [19, 1587], [21, 1667], [29, 2187], [35, 2387], [38, 2647], [43, 2887], [45, 3347], [48, 3507], [54, 3967], [56, 4067], [59, 4167], [65, 4427], [72, 5320], [79, 5657], [83, 6117], [92, 6697], [95, 6957], [98, 7097], [101, 7217], [108, 7677], [111, 8037], [117, 8677], [120, 8817], [123, 8957], [128, 9559], [130, 9687], [135, 9887], [138, 10107], [144, 10347], [151, 10687], [154, 10907], [161, 11207], [167, 11547], [170, 11807]]}, {"verse": 2, "start": 12590, "end": 17864, "text": "Y les enseñaba por parábolas muchas cosas, y les decía en su enseñanza:", "words": [[0, 12590], [2, 12695], [6, 12855], [15, 13615], [19, 13855], [29, 14395], [36, 14695], [43, 15815], [45, 15895], [49, 16015], [55, 16455], [58, 16675], [61, 16775]]}, {"verse": 3, "start": 18214, "end": 21483, "text": "Oíd: He aquí, el sembrador salió a sembrar.", "words": [[0, 18262], [5, 19047], [8, 19141], [14, 19610], [17, 19790], [27, 20350], [33, 20770], [35, 20870]]}, {"verse": 4, "start": 21833, "end": 29432, "text": "Y aconteció sembrando, que una parte cayó junto al camino; y vinieron las aves del cielo y se la comieron.", "words": [[0, 21833], [2, 22012], [12, 22752], [23, 23372], [27, 23552], [31, 23712], [37, 24092], [42, 24632], [48, 24872], [51, 25112], [59, 26000], [61, 26190], [70, 26650], [74, 26890], [79, 27350], [83, 27610], [89, 28070], [91, 28310], [94, 28430], [97, 28550]]}, {"verse": 5, "start": 29782, "end": 38195, "text": "Y otra parte cayó en terreno pedregoso, donde no tenía mucha tierra; y luego salió, porque no tenía la tierra profunda:", "words": [[0, 29782], [2, 29929], [7, 30109], [13, 30429], [18, 30869], [21, 30969], [29, 31429], [40, 32389], [46, 33029], [49, 33439], [55, 33849], [61, 34129], [69, 35139], [71, 35260], [77, 35460], [84, 36020], [91, 36360], [94, 36560], [100, 36920], [103, 37100], [110, 37340]]}, {"verse": 6, "start": 38545, "end": 43866, "text": "Pero salido el sol, se quemó; y por cuanto no tenía raíz, se secó.", "words": [[0, 38545], [5, 38712], [12, 39192], [15, 39332], [20, 39672], [23, 40332], [30, 41085], [32, 41209], [36, 41349], [43, 41609], [46, 41959], [52, 42309], [58, 43109], [61, 43329]]}, {"verse": 7, "start": 44216, "end": 51141, "text": "Y otra parte cayó en espinas; y subieron las espinas, y la ahogaron, y no dio fruto.", "words": [[0, 44216], [2, 44484], [7, 44664], [13, 45024], [18, 45504], [21, 45584], [30, 46533], [32, 46655], [41, 47115], [45, 47355], [54, 48075], [56, 48675], [59, 48835], [69, 49575], [71, 50115], [74, 50295], [78, 50455]]}, {"verse": 8, "start": 51491, "end": 60526, "text": "Y otra parte cayó en buena tierra, y dio fruto, que subió y creció: y produjo a treinta, a sesenta y a ciento por uno.", "words": [[0, 51491], [2, 51637], [7, 51777], [13, 52197], [18, 52737], [21, 52897], [27, 53097], [35, 53537], [37, 54157], [41, 54337], [48, 54797], [52, 54997], [58, 55577], [60, 55732], [68, 56653], [70, 56774], [78, 57294], [80, 57594], [89, 57894], [91, 58434], [99, 58974], [101, 59227], [103, 59481], [110, 59734], [114, 60054]]}, {"verse": 9, "start": 60876, "end": 65180, "text": "Entonces les dijo: El que tiene oídos para oír, oiga.", "words": [[0, 60876], [9, 61924], [13, 62124], [19, 62916], [22, 63044], [26, 63164], [32, 63464], [38, 63964], [43, 64164], [48, 64484]]}, {"verse": 10, "start": 65530, "end": 71747, "text": "Y cuando estuvo solo, le preguntaron los que estaban cerca de él con los doce, sobre la parábola.", "words": [[0, 65530], [2, 65649], [9, 65829], [16, 66229], [22, 66689], [25, 66914], [37, 67674], [41, 67854], [45, 67994], [53, 68314], [59, 68714], [62, 69014], [65, 69194], [69, 69374], [73, 69574], [79, 70094], [85, 70814], [88, 71034]]}, {"verse": 11, "start": 72097, "end": 80445, "text": "Y les dijo: A vosotros es dado saber el misterio del reino de Dios; pero a los que están fuera, por parábolas todas las cosas;", "words": [[0, 72097], [2, 72195], [6, 72315], [12, 73048], [14, 73285], [23, 73635], [26, 73985], [31, 74265], [37, 74625], [40, 74865], [49, 75465], [53, 75645], [59, 76065], [62, 76205], [68, 76946], [73, 77108], [75, 77208], [79, 77308], [83, 77428], [89, 77648], [96, 78048], [100, 78393], [110, 79013], [116, 79353], [120, 79673]]}, {"verse": 12, "start": 80795, "end": 90828, "text": "Para que viendo, vean y no perciban; y oyendo, oigan y no entiendan: no sea que se conviertan, y les sean perdonados los pecados.", "words": [[0, 80795], [5, 80939], [9, 81119], [17, 81459], [22, 82059], [24, 82239], [27, 82379], [37, 83529], [39, 83855], [47, 84182], [53, 84582], [55, 84942], [58, 85102], [69, 86304], [72, 86472], [76, 86692], [80, 86852], [83, 86992], [95, 88232], [97, 88422], [101, 88612], [106, 88952], [117, 89772], [121, 89992]]}, {"verse": 13, "start": 91178, "end": 97523, "text": "Y les dijo: ¿No sabéis esta parábola? ¿Cómo, pues, entenderéis todas las parábolas?", "words": [[0, 91178], [2, 91276], [6, 91396], [12, 92128], [16, 92419], [23, 93019], [28, 93519], [38, 94595], [45, 94783], [51, 95123], [63, 96023], [69, 96463], [73, 96723]]}, {"verse": 14, "start": 97873, "end": 100648, "text": "El que siembra es el que siembra la palabra.", "words": [[0, 97873], [3, 97995], [7, 98115], [15, 98675], [18, 98955], [21, 99115], [25, 99235], [33, 99735], [36, 99975]]}, {"verse": 15, "start": 100998, "end": 111496, "text": "Y estos son los de junto al camino: en los que la palabra es sembrada: pero después que la oyeron, luego viene Satanás, y quita la palabra que fue sembrada en sus corazones.", "words": [[0, 100998], [2, 101162], [8, 101402], [12, 101802], [16, 102049], [19, 102295], [25, 102542], [28, 102642], [36, 103435], [39, 103563], [43, 103643], [47, 103783], [50, 103903], [58, 104203], [61, 104403], [71, 105350], [76, 105494], [84, 105774], [88, 106154], [91, 106534], [99, 106914], [105, 107094], [111, 107414], [120, 108114], [122, 108554], [128, 108854], [131, 108994], [139, 109294], [143, 109494], [147, 109654], [156, 110274], [159, 110354], [163, 110494]]}, {"verse": 16, "start": 111846, "end": 120263, "text": "Y asimismo estos son los que son sembrados en pedregales: los que cuando han oído la palabra, luego la reciben con alegría;", "words": [[0, 111846], [2, 112172], [11, 112532], [17, 112812], [21, 113272], [25, 113432], [29, 113552], [33, 113752], [43, 114352], [46, 114592], [58, 115974], [62, 116100], [66, 116340], [73, 116480], [77, 116720], [82, 117040], [85, 117220], [94, 118180], [100, 118360], [103, 118620], [111, 119180], [115, 119360]]}, {"verse": 17, "start": 120613, "end": 130700, "text": "Pero no tienen raíz en sí, sino que duran poco tiempo; cuando surge la tribulación o la persecución por causa de la palabra, enseguida se apartan.", "words": [[0, 120613], [5, 120738], [8, 120898], [15, 121218], [20, 121718], [23, 121878], [27, 122518], [32, 122738], [36, 122918], [42, 123218], [47, 123398], [55, 124361], [62, 124545], [68, 124965], [71, 125245], [83, 126065], [85, 126265], [88, 126405], [100, 127205], [104, 127405], [110, 127725], [113, 128025], [116, 128125], [125, 128965], [135, 129685], [138, 129865]]}, {"verse": 18, "start": 131050, "end": 136245, "text": "Y estos son los que son sembrados entre espinas: los que oyen la palabra;", "words": [[0, 131050], [2, 131192], [8, 131472], [12, 131872], [16, 132012], [20, 132152], [24, 132372], [34, 133052], [40, 133532], [49, 134798], [53, 134926], [57, 135106], [62, 135446], [65, 135566]]}, {"verse": 19, "start": 136595, "end": 146446, "text": "Pero las preocupaciones de este mundo, y el engaño de las riquezas, y los deseos de otras cosas, entrando, ahogan la palabra, y se hace infructuosa.", "words": [[0, 136595], [5, 136759], [9, 136939], [24, 137799], [27, 137999], [32, 138139], [39, 138479], [41, 138679], [44, 138779], [51, 139259], [54, 139399], [58, 139559], [68, 140179], [70, 140639], [74, 140799], [81, 141279], [84, 141379], [90, 141559], [97, 141999], [107, 142879], [114, 143699], [117, 143959], [126, 144499], [128, 144754], [131, 144914], [136, 145174]]}, {"verse": 20, "start": 146796, "end": 158117, "text": "Y estos son los que fueron sembrados en buena tierra: los que oyen la palabra, y la reciben, y dan fruto, uno a treinta, otro a sesenta y otro a ciento por uno.", "words": [[0, 146796], [2, 146979], [8, 147239], [12, 147679], [16, 147819], [20, 147999], [27, 148279], [37, 148959], [40, 149159], [46, 149379], [54, 150266], [58, 150391], [62, 150591], [67, 150891], [70, 151011], [79, 151531], [81, 151851], [84, 151991], [93, 153171], [95, 153251], [99, 153431], [106, 154031], [110, 154631], [112, 154851], [121, 155471], [126, 155671], [128, 155871], [136, 156391], [138, 156631], [143, 156811], [145, 157031], [152, 157251], [156, 157671]]}, {"verse": 21, "start": 158467, "end": 168650, "text": "También les dijo: ¿Se trae la lámpara para ser puesta debajo de una canasta, o debajo de la cama? ¿No es para ser puesta en el soporte para lámpara?", "words": [[0, 158467], [8, 158773], [12, 158993], [18, 159754], [22, 159895], [27, 160195], [30, 160315], [38, 160815], [43, 161015], [47, 161255], [54, 161675], [61, 162075], [64, 162235], [68, 162355], [77, 162935], [79, 163435], [86, 163815], [89, 163935], [92, 164055], [98, 164804], [102, 164989], [105, 165329], [110, 165829], [114, 166049], [121, 166569], [124, 166709], [127, 166849], [135, 167469], [140, 168084]]}, {"verse": 22, "start": 169000, "end": 175851, "text": "Porque no hay nada oculto que no haya de ser manifestado, ni secreto que no haya de descubrirse.", "words": [[0, 169000], [7, 169224], [10, 169504], [14, 169684], [19, 170004], [26, 170724], [30, 170844], [33, 171064], [38, 171284], [41, 171504], [45, 171724], [58, 172534], [61, 173344], [69, 173964], [73, 174144], [76, 174364], [81, 174604], [84, 174804]]}, {"verse": 23, "start": 176201, "end": 178621, "text": "Si alguno tiene oídos para oír, oiga.", "words": [[0, 176201], [3, 176466], [10, 176886], [16, 177086], [22, 177526], [27, 177726], [32, 178206]]}, {"verse": 24, "start": 178971, "end": 188531, "text": "Les dijo también: Mirad lo que oís: con la medida que medís, os medirán otros, y se os añadirá a vosotros los que oís.", "words": [[0, 178978], [4, 179118], [9, 179358], [18, 180227], [24, 180800], [27, 180980], [31, 181361], [36, 181901], [40, 182045], [43, 182205], [50, 182525], [54, 183105], [61, 183685], [64, 183885], [72, 184505], [79, 184945], [81, 185430], [84, 185610], [87, 185810], [95, 186570], [97, 186710], [106, 187290], [110, 187730], [114, 187970]]}, {"verse": 25, "start": 188881, "end": 195734, "text": "Porque al que tiene, le será dado; y al que no tiene, aun lo que tiene le será quitado.", "words": [[0, 188881], [7, 189106], [10, 189446], [14, 189646], [21, 190106], [24, 190606], [29, 190866], [35, 191672], [37, 191797], [40, 191937], [44, 192117], [47, 192337], [54, 193237], [58, 193597], [61, 193897], [65, 194057], [71, 194477], [74, 194677], [79, 194977]]}, {"verse": 26, "start": 196084, "end": 202116, "text": "Decía más: Así es el reino de Dios, como si un hombre echa semilla en la tierra;", "words": [[0, 196084], [6, 196591], [11, 197515], [15, 197726], [18, 198006], [21, 198186], [27, 198606], [30, 198746], [36, 199046], [41, 199706], [44, 199906], [47, 200066], [54, 200306], [59, 200686], [67, 201246], [70, 201366], [73, 201486]]}, {"verse": 27, "start": 202466, "end": 208732, "text": "Y duerme, y se levanta de noche y de día, y la semilla brota y crece como él no sabe.", "words": [[0, 202466], [2, 202572], [10, 203032], [12, 203432], [15, 203532], [23, 204052], [26, 204132], [32, 204432], [34, 204612], [37, 204732], [42, 205572], [44, 205872], [47, 205992], [55, 206392], [61, 206832], [63, 207012], [69, 207472], [74, 207752], [77, 208012], [80, 208192]]}, {"verse": 28, "start": 209082, "end": 217053, "text": "Porque por sí sola fructifica la tierra, primero hierba, luego espiga, después grano lleno en la espiga;", "words": [[0, 209082], [7, 209346], [11, 209626], [14, 209906], [19, 210266], [30, 211086], [33, 211246], [41, 212266], [49, 213176], [57, 214086], [63, 214226], [71, 215266], [79, 215506], [85, 215926], [91, 216266], [94, 216366], [97, 216466]]}, {"verse": 29, "start": 217403, "end": 223110, "text": "Y cuando el fruto está maduro, enseguida se usa la hoz, porque ha llegado la cosecha.", "words": [[0, 217403], [2, 217880], [9, 218113], [12, 218353], [18, 218693], [23, 218893], [31, 219373], [41, 220373], [44, 220553], [48, 220753], [51, 220973], [56, 221193], [63, 221733], [66, 221893], [74, 222273], [77, 222393]]}, {"verse": 30, "start": 223460, "end": 229650, "text": "Y decía: ¿A qué asemejaremos el reino de Dios? ¿o con qué parábola le compararemos?", "words": [[0, 223460], [2, 223604], [9, 224416], [12, 224581], [16, 224681], [29, 225441], [32, 225681], [38, 226021], [41, 226161], [47, 226923], [50, 227067], [54, 227327], [58, 227607], [67, 228267], [70, 228527]]}, {"verse": 31, "start": 230000, "end": 237708, "text": "Es como el grano de mostaza, que, cuando se siembra en tierra, es la más pequeña de todas las semillas que hay en la tierra;", "words": [[0, 230000], [3, 230145], [8, 230345], [11, 230525], [17, 230905], [20, 231025], [29, 231705], [34, 232205], [41, 232785], [44, 233005], [52, 233425], [55, 233545], [63, 233965], [66, 234545], [69, 234665], [73, 234805], [81, 235125], [84, 235405], [90, 235645], [94, 235885], [103, 236325], [107, 236525], [111, 236745], [114, 236885], [117, 237005]]}, {"verse": 32, "start": 238058, "end": 249998, "text": "Pero después de sembrado, sube, y se hace la mayor de todas las plantas del huerto, y echa grandes ramas, de tal manera que las aves del cielo puedan refugiarse bajo su sombra.", "words": [[0, 238058], [5, 238203], [13, 238463], [16, 238663], [26, 239303], [32, 240223], [34, 240823], [37, 241023], [42, 241303], [45, 241523], [51, 241883], [54, 242143], [60, 242403], [64, 242703], [72, 242983], [76, 243263], [84, 243683], [86, 244223], [91, 244463], [99, 244843], [106, 245807], [109, 245911], [113, 246031], [120, 246351], [124, 246571], [128, 246731], [133, 247111], [137, 247271], [143, 247591], [150, 248071], [161, 248971], [166, 249131], [169, 249411]]}, {"verse": 33, "start": 250348, "end": 255801, "text": "Y con muchas tales parábolas les hablaba la palabra, conforme a lo que podían oír.", "words": [[0, 250348], [2, 250452], [6, 250632], [13, 250972], [19, 251352], [29, 252052], [33, 252572], [41, 253072], [44, 253192], [53, 253692], [62, 254152], [64, 254612], [67, 254752], [71, 254872], [78, 255272]]}, {"verse": 34, "start": 256151, "end": 262185, "text": "Y sin parábola no les hablaba; pero a sus discípulos en particular explicaba todo.", "words": [[0, 256151], [2, 256255], [6, 256455], [15, 257135], [18, 257315], [22, 257515], [31, 258405], [36, 258549], [38, 258669], [42, 258809], [53, 259849], [56, 260069], [67, 260729], [77, 261589]]}, {"verse": 35, "start": 262535, "end": 267020, "text": "Y les dijo aquel día cuando fue tarde: Pasemos de la otra parte.", "words": [[0, 262535], [2, 262661], [6, 262841], [11, 263261], [17, 263701], [21, 263941], [28, 264221], [32, 264521], [39, 265383], [47, 265749], [50, 265909], [53, 266049], [58, 266269]]}, {"verse": 36, "start": 267370, "end": 274053, "text": "Y despidiendo a la multitud, le tomaron como estaba, en el barco; y había también con él otras barcas.", "words": [[0, 267370], [2, 267490], [14, 267830], [16, 268170], [19, 268330], [29, 269330], [32, 269490], [40, 269890], [45, 270130], [53, 270430], [56, 270630], [59, 270730], [66, 271525], [68, 271810], [74, 271990], [82, 272410], [86, 272690], [89, 272870], [95, 273190]]}, {"verse": 37, "start": 274403, "end": 282522, "text": "Y se levantó una grande tempestad de viento, y echaba las olas en el barco, de tal manera que ya se llenaba.", "words": [[0, 274403], [2, 274522], [5, 274642], [13, 275142], [17, 275322], [24, 275722], [34, 276742], [37, 276942], [45, 277502], [47, 278062], [54, 278522], [58, 278742], [63, 279202], [66, 279362], [69, 279522], [76, 280502], [79, 280662], [83, 280882], [90, 281222], [94, 281522], [97, 281742], [100, 281922]]}, {"verse": 38, "start": 282872, "end": 292113, "text": "Y él estaba en la popa, durmiendo sobre una almohada, y le despertaron, y le dicen: ¿Maestro, no tienes cuidado que perecemos?", "words": [[0, 282872], [2, 283036], [5, 283216], [12, 283596], [15, 283796], [18, 283936], [24, 284816], [34, 285456], [40, 285776], [44, 286056], [54, 287496], [56, 287516], [59, 287636], [72, 288496], [74, 288836], [77, 288936], [84, 289764], [94, 290366], [97, 290446], [104, 290726], [112, 291126], [116, 291326]]}, {"verse": 39, "start": 292393, "end": 300813, "text": "Y levantándose, reprendió al viento, y dijo al mar: Calla, enmudece. Y cesó el viento, y fue hecha gran calma.", "words": [[0, 292393], [2, 292514], [16, 293594], [26, 294094], [29, 294234], [37, 294674], [39, 295334], [44, 295614], [47, 295794], [52, 296400], [59, 297265], [69, 298327], [71, 298534], [76, 298774], [79, 299014], [87, 299254], [89, 299414], [93, 299574], [99, 299834], [104, 300094]]}, {"verse": 40, "start": 301163, "end": 306495, "text": "Y a ellos dijo: ¿Por qué estáis así atemorizados? ¿Cómo no tenéis fe?", "words": [[0, 301163], [2, 301163], [4, 301477], [10, 301827], [16, 302718], [21, 303022], [25, 303182], [32, 303522], [36, 303842], [50, 305265], [56, 305431], [59, 305631], [66, 306051]]}, {"verse": 41, "start": 306845, "end": 314377, "text": "Y temieron con gran temor, y decían el uno al otro. ¿Quién es este, que aun el viento y el mar le obedecen?", "words": [[0, 306845], [2, 307026], [11, 307506], [15, 307726], [20, 308026], [27, 308566], [29, 309006], [36, 309646], [39, 309966], [43, 310226], [46, 310546], [52, 311272], [59, 311513], [62, 311653], [68, 312013], [72, 312213], [76, 312433], [79, 312633], [86, 313013], [88, 313153], [91, 313273], [95, 313453], [98, 313613]]}]}