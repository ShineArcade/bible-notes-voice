{"book": "LUK", "chapter": 24, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 398693, "verses": [{"verse": 1, "start": 300, "end": 10989, "text": "Y el primer día de la semana, muy de mañana, vinieron al sepulcro, trayendo las especias aromáticas que habían preparado, y algunas otras mujeres con ellas.", "words": [[0, 300], [2, 444], [5, 564], [12, 864], [16, 1164], [19, 1304], [22, 1444], [30, 1924], [34, 2104], [37, 2264], [45, 2824], [54, 3284], [57, 3544], [67, 4784], [76, 5424], [80, 5964], [89, 6504], [100, 7264], [104, 7524], [111, 7784], [122, 8504], [124, 8884], [132, 9264], [138, 9624], [146, 10084], [150, 10424]]}, {"verse": 2, "start": 11439, "end": 15360, "text": "Y hallaron la piedra rodada a un lado del sepulcro.", "words": [[0, 11439], [2, 11583], [11, 12063], [14, 12243], [21, 12823], [28, 13523], [30, 13783], [33, 13903], [38, 14203], [42, 14463]]}, {"verse": 3, "start": 15810, "end": 19504, "text": "Y entrando, no hallaron el cuerpo del Señor Jesús.", "words": [[0, 15810], [2, 15935], [12, 16535], [15, 17035], [24, 17555], [27, 17735], [34, 18095], [38, 18395], [44, 18695]]}, {"verse": 4, "start": 19954, "end": 28918, "text": "Y aconteció, que estando ellas espantadas de esto, he aquí se pararon junto a ellas dos varones con vestiduras resplandecientes;", "words": [[0, 19954], [2, 20328], [13, 20738], [17, 20918], [25, 21378], [31, 21678], [42, 22498], [45, 22718], [51, 23258], [54, 23798], [59, 24018], [62, 24238], [70, 24738], [76, 24998], [78, 25238], [84, 25438], [88, 25758], [96, 26338], [100, 26858], [111, 27558]]}, {"verse": 5, "start": 29368, "end": 36567, "text": "Y como tuviesen ellas temor, y bajasen el rostro a tierra, les dijeron: ¿Por qué buscáis entre los muertos al que vive?", "words": [[0, 29368], [2, 29628], [7, 29848], [16, 30388], [22, 30728], [29, 31268], [31, 31448], [39, 31988], [42, 32108], [49, 32508], [51, 32628], [59, 33088], [63, 33168], [72, 34171], [77, 34279], [81, 34419], [89, 34899], [95, 35199], [99, 35379], [107, 35799], [110, 35999], [114, 36139]]}, {"verse": 6, "start": 37017, "end": 42291, "text": "No está aquí, pero ha resucitado: acordaos de lo que os habló, cuando aún estaba en Galilea,", "words": [[0, 37017], [3, 37136], [8, 37356], [14, 37736], [19, 37856], [22, 38016], [34, 39116], [43, 39761], [46, 39901], [49, 40021], [53, 40141], [56, 40261], [63, 40621], [70, 40881], [74, 41181], [81, 41481], [84, 41661]]}, {"verse": 7, "start": 42741, "end": 51553, "text": "Diciendo: Es necesario que el Hijo del hombre sea entregado en manos de hombres pecadores, y que sea crucificado, y resucite al tercer día.", "words": [[0, 42741], [10, 43753], [13, 43937], [23, 44537], [27, 44817], [30, 44937], [35, 45137], [39, 45277], [46, 45617], [50, 45837], [60, 46517], [63, 46617], [69, 46837], [72, 47117], [80, 47337], [91, 47997], [93, 48517], [97, 48617], [101, 48817], [114, 49677], [116, 49997], [125, 50597], [128, 50777], [135, 51017]]}, {"verse": 8, "start": 51903, "end": 55022, "text": "Entonces ellas se acordaron de sus palabras,", "words": [[0, 51903], [9, 52647], [15, 52967], [18, 53207], [28, 53807], [31, 54007], [35, 54147]]}, {"verse": 9, "start": 55472, "end": 61685, "text": "Y volviendo del sepulcro, contaron todas estas cosas a los once, y a todos los demás.", "words": [[0, 55472], [2, 55580], [12, 56060], [16, 56280], [26, 57140], [35, 57640], [41, 58220], [47, 58640], [53, 59040], [55, 59300], [59, 59400], [65, 59800], [67, 60140], [69, 60240], [75, 60540], [79, 60980]]}, {"verse": 10, "start": 62135, "end": 71928, "text": "Y eran María Magdalena, y Juana, y María madre de Jacobo, y las demás con ellas, las que dijeron estas cosas a los apóstoles.", "words": [[0, 62135], [2, 62296], [7, 62496], [13, 62916], [24, 63896], [26, 64496], [33, 64996], [35, 65176], [41, 65436], [47, 65976], [50, 66136], [58, 67256], [60, 67496], [64, 67636], [70, 67836], [74, 68176], [81, 68476], [85, 68996], [89, 69176], [97, 69716], [103, 69916], [109, 70396], [111, 70816], [115, 70936]]}, {"verse": 11, "start": 72378, "end": 77768, "text": "Pero a ellos les parecían como locura las palabras de ellas, y no las creyeron.", "words": [[0, 72378], [5, 72522], [7, 72682], [13, 72922], [17, 73122], [26, 73702], [31, 73982], [38, 74562], [42, 74702], [51, 75122], [54, 75402], [61, 75622], [63, 75862], [66, 75962], [70, 76122]]}, {"verse": 12, "start": 78218, "end": 88321, "text": "Pero levantándose Pedro, corrió al sepulcro: y como miró dentro, vio solos los lienzos echados; y se fue maravillándose de lo que había sucedido.", "words": [[0, 78218], [5, 78218], [18, 78966], [25, 79346], [32, 79866], [35, 79986], [45, 81158], [47, 81264], [52, 81504], [57, 81864], [65, 82504], [69, 82704], [75, 83244], [79, 83544], [87, 84064], [96, 85195], [98, 85322], [101, 85442], [105, 85642], [120, 86662], [123, 86942], [126, 87082], [130, 87222], [136, 87482]]}, {"verse": 13, "start": 88771, "end": 97413, "text": "Y he aquí, dos de ellos iban el mismo día a una aldea que estaba de Jerusalén sesenta estadios, llamada Emaús.", "words": [[0, 88771], [2, 89104], [5, 89224], [11, 89524], [15, 89764], [18, 89964], [24, 90264], [29, 90564], [32, 90704], [38, 90984], [42, 91284], [44, 91564], [48, 91744], [54, 92384], [58, 92544], [65, 92904], [68, 93124], [78, 93784], [86, 94444], [96, 95804], [104, 96364]]}, {"verse": 14, "start": 97863, "end": 102702, "text": "E iban hablando entre sí de todas aquellas cosas que habían acontecido.", "words": [[0, 97863], [2, 98012], [7, 98312], [16, 98612], [22, 99012], [25, 99352], [28, 99512], [34, 99792], [43, 100412], [49, 100752], [53, 101332], [60, 101672]]}, {"verse": 15, "start": 103152, "end": 112511, "text": "Y aconteció que yendo hablando entre sí, y preguntándose el uno al otro, el mismo Jesús se llegó, e iba con ellos juntamente.", "words": [[0, 103152], [2, 103317], [12, 104157], [16, 104397], [22, 104797], [31, 105137], [37, 105637], [41, 105957], [43, 106217], [57, 107217], [60, 107497], [64, 107697], [67, 107917], [73, 108877], [76, 108997], [82, 109257], [88, 109517], [91, 109857], [98, 110737], [100, 110837], [104, 111017], [108, 111277], [114, 111457]]}, {"verse": 16, "start": 112961, "end": 116347, "text": "Pero los ojos de ellos estaban impedidos de reconocerlo.", "words": [[0, 112961], [5, 113085], [9, 113245], [14, 113565], [17, 113785], [23, 113985], [31, 114385], [41, 115145], [44, 115305]]}, {"verse": 17, "start": 116797, "end": 122518, "text": "Y les dijo: ¿De qué conversáis entre vosotros mientras camináis, y estáis tristes?", "words": [[0, 116797], [2, 117064], [6, 117368], [12, 117909], [16, 118036], [20, 118466], [31, 118896], [37, 119216], [46, 119856], [55, 120136], [65, 120936], [67, 121356], [74, 121776]]}, {"verse": 18, "start": 122968, "end": 133220, "text": "Y respondiendo el uno, que se llamaba Cleofas, le dijo: ¿Eres tú el único visitante en Jerusalén que no se ha enterado de las cosas que en ella han acontecido estos días?", "words": [[0, 122968], [2, 123126], [15, 124006], [18, 124186], [23, 124446], [27, 124946], [30, 125086], [38, 125636], [47, 126186], [50, 126426], [56, 127204], [62, 127432], [65, 127612], [68, 127772], [74, 127972], [84, 128592], [87, 128732], [97, 129292], [101, 129512], [104, 129712], [107, 129892], [110, 129992], [119, 130452], [122, 130572], [126, 130712], [132, 131032], [136, 131312], [139, 131452], [144, 131632], [148, 131772], [159, 132412], [165, 132592]]}, {"verse": 19, "start": 133570, "end": 145688, "text": "Entonces él les dijo: ¿Qué cosas? Y ellos le dijeron: De Jesús nazareno, el cual fue varón profeta, poderoso en obra y en palabra delante de Dios y de todo el pueblo;", "words": [[0, 133570], [9, 134207], [12, 134967], [16, 135207], [22, 136377], [27, 136694], [34, 137251], [36, 137437], [42, 137657], [45, 137837], [54, 138864], [57, 138981], [63, 139241], [73, 140261], [76, 140281], [81, 140481], [85, 140741], [91, 141041], [100, 142021], [109, 142581], [112, 142741], [117, 142981], [119, 143141], [122, 143261], [130, 143541], [138, 144141], [141, 144261], [146, 144501], [148, 144721], [151, 144841], [156, 144981], [159, 145181]]}, {"verse": 20, "start": 146138, "end": 152401, "text": "Y cómo le entregaron los principales sacerdotes y nuestros dirigentes a condenación de muerte, y le crucificaron.", "words": [[0, 146138], [2, 146242], [7, 146482], [10, 146642], [21, 147182], [25, 147322], [37, 148002], [48, 148602], [50, 148782], [59, 148962], [70, 149762], [72, 149982], [84, 150562], [87, 150762], [95, 151082], [97, 151422], [100, 151522]]}, {"verse": 21, "start": 152851, "end": 161481, "text": "Pero nosotros esperábamos que él era el que había de redimir a Israel: y ahora sobre todo esto, hoy es el tercer día que esto ha acontecido.", "words": [[0, 152851], [5, 152996], [14, 153416], [26, 154256], [30, 154516], [33, 154696], [37, 154896], [40, 155056], [44, 155196], [50, 155436], [53, 155616], [61, 155996], [63, 156116], [71, 156955], [73, 157103], [79, 157543], [85, 157703], [90, 157983], [96, 158803], [100, 158963], [103, 159143], [106, 159263], [113, 159543], [117, 159963], [121, 160203], [126, 160443], [129, 160663]]}, {"verse": 22, "start": 161931, "end": 167588, "text": "Aunque también unas mujeres de los nuestros nos han asombrado, las cuales antes del día fueron al sepulcro:", "words": [[0, 161931], [7, 162116], [15, 162476], [20, 162716], [28, 163096], [31, 163276], [35, 163416], [44, 163776], [48, 164056], [52, 164216], [63, 165136], [67, 165216], [74, 165516], [80, 165956], [84, 166176], [88, 166436], [95, 166736], [98, 166956]]}, {"verse": 23, "start": 168038, "end": 175350, "text": "Y no hallando su cuerpo, vinieron diciendo que también habían visto visión de ángeles, los cuales dijeron que él vive.", "words": [[0, 168038], [2, 168160], [5, 168300], [14, 168720], [17, 168920], [25, 169740], [34, 170260], [43, 170580], [47, 170920], [55, 171280], [62, 171520], [68, 171980], [75, 172480], [78, 172600], [87, 173520], [91, 173640], [98, 173940], [106, 174500], [110, 174640], [113, 174820]]}, {"verse": 24, "start": 175800, "end": 182265, "text": "Y fueron algunos de los nuestros al sepulcro, y hallaron así como las mujeres habían dicho; pero a él no le vieron.", "words": [[0, 175800], [2, 175923], [9, 176123], [17, 176583], [20, 176743], [24, 176883], [33, 177263], [36, 177523], [46, 178063], [48, 178483], [57, 178883], [61, 179123], [66, 179343], [70, 179523], [78, 179863], [85, 180223], [92, 181035], [97, 181197], [99, 181357], [102, 181517], [105, 181657], [108, 181777]]}, {"verse": 25, "start": 182615, "end": 190438, "text": "Entonces él les dijo: ¡Oh insensatos, y tardos de corazón para creer todo lo que los profetas han dicho!", "words": [[0, 182615], [9, 183251], [12, 184011], [16, 184251], [22, 185563], [26, 186023], [38, 186483], [40, 186623], [47, 187043], [50, 187163], [58, 187643], [63, 188003], [69, 188483], [74, 188723], [77, 189003], [81, 189123], [85, 189243], [94, 189743], [98, 189943]]}, {"verse": 26, "start": 190888, "end": 196025, "text": "¿No era necesario que el Cristo padeciera estas cosas, y que entrara en su gloria?", "words": [[0, 190888], [4, 191076], [8, 191276], [18, 191876], [22, 192096], [25, 192236], [32, 192616], [42, 193316], [48, 193496], [55, 193956], [57, 194536], [61, 194776], [69, 195016], [72, 195216], [75, 195416]]}, {"verse": 27, "start": 196475, "end": 204575, "text": "Y comenzando desde Moisés, y de todos los profetas, les explicaba en todas las Escrituras lo que de él decían.", "words": [[0, 196475], [2, 196580], [13, 197460], [19, 197640], [27, 198280], [29, 198880], [32, 199000], [38, 199260], [42, 199480], [52, 200320], [56, 200580], [66, 201480], [69, 201680], [75, 202000], [79, 202320], [90, 203040], [93, 203440], [97, 203580], [100, 203720], [103, 204161]]}, {"verse": 28, "start": 205025, "end": 210605, "text": "Y llegaron a la aldea a donde iban: y él hizo como que iba más lejos.", "words": [[0, 205025], [2, 205272], [11, 205732], [13, 205972], [16, 206052], [22, 206652], [24, 206852], [30, 207032], [36, 208046], [38, 208235], [41, 208355], [46, 208815], [51, 209135], [55, 209355], [59, 209615], [63, 209875]]}, {"verse": 29, "start": 211055, "end": 221607, "text": "Pero ellos le rogaron con insistencia, diciendo: Quédate con nosotros, porque se hace tarde, y el día ya ha declinado. Entró pues a quedarse con ellos.", "words": [[0, 211055], [5, 211217], [11, 211497], [14, 211777], [22, 212517], [26, 212677], [39, 213837], [49, 215141], [57, 215459], [61, 215659], [71, 215999], [78, 216339], [81, 216579], [86, 216759], [93, 217159], [95, 217679], [98, 217819], [102, 218019], [105, 218279], [108, 218399], [119, 219429], [125, 219920], [130, 220120], [132, 220340], [141, 220780], [145, 221060]]}, {"verse": 30, "start": 222057, "end": 228363, "text": "Y aconteció, que estando sentado con ellos a la mesa, tomando el pan, bendijo, y partió, y les dio.", "words": [[0, 222057], [2, 222158], [13, 222718], [17, 223038], [25, 223358], [33, 223958], [37, 224198], [43, 224398], [45, 224618], [48, 224718], [54, 224978], [62, 225478], [65, 225618], [70, 226118], [79, 226718], [81, 226938], [89, 227458], [91, 227738], [95, 227878]]}, {"verse": 31, "start": 228813, "end": 237135, "text": "Entonces fueron abiertos los ojos de ellos, y le reconocieron; pero él se desapareció de los ojos de ellos.", "words": [[0, 228813], [9, 229398], [16, 229858], [25, 230718], [29, 230938], [34, 231298], [37, 231538], [44, 231898], [46, 232338], [49, 232498], [63, 233955], [68, 234155], [71, 234535], [74, 234875], [86, 235755], [89, 235895], [93, 236035], [98, 236295], [101, 236575]]}, {"verse": 32, "start": 237585, "end": 245758, "text": "Y decían el uno al otro: ¿No ardía nuestro corazón en nosotros, mientras nos hablaba en el camino, y cuando nos abría las Escrituras?", "words": [[0, 237585], [2, 237707], [9, 238307], [12, 238587], [16, 238827], [19, 239027], [25, 239806], [29, 239992], [35, 240292], [43, 240472], [51, 241012], [54, 241212], [64, 241672], [73, 242192], [77, 242492], [85, 242892], [88, 242992], [91, 243092], [99, 243512], [101, 243952], [108, 244152], [112, 244372], [118, 244692], [122, 244832]]}, {"verse": 33, "start": 246108, "end": 254898, "text": "Y levantándose en la misma hora, se volvieron a Jerusalén, y hallaron a los once reunidos, y a los que estaban con ellos.", "words": [[0, 246108], [2, 246229], [15, 247109], [18, 247269], [21, 247369], [27, 247609], [33, 248269], [36, 248469], [46, 249069], [48, 249229], [59, 250029], [61, 250489], [70, 251009], [72, 251169], [76, 251349], [81, 251909], [91, 252749], [93, 253229], [95, 253289], [99, 253409], [103, 253549], [111, 253909], [115, 254309]]}, {"verse": 34, "start": 255348, "end": 260565, "text": "Que decían: Ha resucitado el Señor verdaderamente, y ha aparecido a Simón.", "words": [[0, 255348], [4, 255805], [12, 256499], [15, 256639], [26, 257279], [29, 257359], [35, 257579], [51, 258459], [53, 259119], [56, 259219], [66, 259879], [68, 260059]]}, {"verse": 35, "start": 260915, "end": 269709, "text": "Entonces ellos contaban las cosas que les habían acontecido en el camino, y cómo había sido reconocido por ellos al partir el pan.", "words": [[0, 260915], [9, 261438], [15, 261938], [24, 262698], [28, 262898], [34, 263298], [38, 263538], [42, 263678], [49, 263998], [60, 264738], [63, 264858], [66, 264998], [74, 265738], [76, 266058], [81, 266338], [87, 266618], [92, 266958], [103, 267738], [107, 267978], [113, 268218], [116, 268578], [123, 268968], [126, 269357]]}, {"verse": 36, "start": 270159, "end": 277463, "text": "Y entre tanto que ellos hablaban estas cosas, él se puso en medio de ellos, y les dijo: Paz a vosotros.", "words": [[0, 270159], [2, 270288], [8, 270548], [14, 270948], [18, 271168], [24, 271408], [33, 271928], [39, 272148], [46, 273148], [49, 273288], [52, 273488], [57, 273868], [60, 274028], [66, 274288], [69, 274528], [76, 274888], [78, 275548], [82, 275668], [88, 276557], [92, 276677], [94, 276777]]}, {"verse": 37, "start": 277913, "end": 283041, "text": "Entonces ellos espantados y asombrados, pensaban que veían espíritu.", "words": [[0, 277913], [9, 278850], [15, 279350], [26, 280190], [28, 280310], [40, 280970], [49, 281710], [53, 281890], [59, 282310]]}, {"verse": 38, "start": 283491, "end": 289535, "text": "Pero él les dice: ¿Por qué estáis turbados, y suben pensamientos a vuestros corazones?", "words": [[0, 283491], [5, 283656], [8, 283986], [12, 284316], [18, 285173], [23, 285298], [27, 285645], [34, 285991], [44, 286338], [46, 286598], [52, 287078], [65, 287898], [67, 288138], [76, 288518]]}, {"verse": 39, "start": 289985, "end": 299291, "text": "Mirad mis manos y mis pies, que yo mismo soy: palpad, y ved; que el espíritu ni tiene carne ni huesos, como veis que yo tengo.", "words": [[0, 289985], [6, 290313], [10, 290473], [16, 290833], [18, 291053], [22, 291193], [28, 291853], [32, 291973], [35, 292153], [41, 292433], [46, 293607], [54, 293907], [56, 294224], [61, 294802], [65, 294929], [68, 295109], [77, 295729], [80, 295849], [86, 296189], [92, 296649], [95, 296929], [103, 297829], [108, 297989], [113, 298389], [117, 298509], [120, 298649]]}, {"verse": 40, "start": 299741, "end": 303604, "text": "Y al decir esto, les mostró las manos y los pies.", "words": [[0, 299741], [2, 299869], [5, 299969], [11, 300309], [17, 300909], [21, 301629], [28, 302109], [32, 302269], [38, 302629], [40, 302849], [44, 302989]]}, {"verse": 41, "start": 304054, "end": 311285, "text": "Y no creyéndolo aún ellos de gozo, y maravillados, les dijo: ¿Tenéis aquí algo de comer?", "words": [[0, 304054], [2, 304197], [5, 304337], [16, 305157], [20, 305557], [26, 305937], [29, 306217], [35, 307037], [37, 307277], [51, 308377], [55, 308617], [61, 309486], [69, 309831], [74, 310151], [79, 310511], [82, 310711]]}, {"verse": 42, "start": 311735, "end": 317437, "text": "Entonces ellos le presentaron parte de un pez asado, y un panal de miel.", "words": [[0, 311735], [9, 312817], [15, 313117], [18, 313357], [30, 314077], [36, 314417], [39, 314697], [42, 315010], [46, 315324], [53, 315637], [55, 316057], [58, 316347], [64, 316637], [67, 316857]]}, {"verse": 43, "start": 317887, "end": 320749, "text": "Y él tomó, y comió delante de ellos.", "words": [[0, 317887], [2, 318076], [5, 318236], [11, 319016], [13, 319156], [19, 319556], [27, 320016], [30, 320156]]}, {"verse": 44, "start": 321199, "end": 335677, "text": "Y él les dijo: Estas son las palabras que os hablé, estando aún con vosotros: que era necesario que se cumpliesen todas las cosas que están escritas de mí en la ley de Moisés, y en los profetas, y en los salmos.", "words": [[0, 321199], [2, 321362], [5, 321502], [9, 321642], [15, 322491], [21, 322915], [25, 323075], [29, 323215], [38, 323555], [42, 323815], [45, 323935], [52, 324515], [60, 324855], [64, 325055], [68, 325275], [78, 326385], [82, 326528], [86, 326748], [96, 327408], [100, 327648], [103, 327788], [114, 328468], [120, 328908], [124, 329208], [130, 329608], [134, 329828], [140, 330048], [149, 330648], [152, 330788], [155, 331028], [158, 331648], [161, 331788], [165, 332008], [168, 332148], [176, 332588], [178, 333188], [181, 333308], [185, 333428], [195, 334088], [197, 334708], [200, 334808], [204, 334948]]}, {"verse": 45, "start": 336127, "end": 341531, "text": "Entonces les abrió el entendimiento, para que entendiesen las Escrituras;", "words": [[0, 336127], [9, 336654], [13, 337134], [19, 337554], [22, 337714], [37, 338674], [42, 339214], [46, 339374], [58, 340134], [62, 340414]]}, {"verse": 46, "start": 341981, "end": 350612, "text": "Y les dijo: Así está escrito, y así fue necesario que el Cristo padeciese, y resucitase de los muertos al tercer día;", "words": [[0, 341981], [2, 342248], [6, 342552], [12, 343093], [16, 343394], [21, 343654], [30, 344114], [32, 344694], [36, 344874], [40, 345134], [50, 345754], [54, 345994], [57, 346154], [64, 346474], [75, 347494], [77, 347674], [88, 348574], [91, 348754], [95, 348894], [103, 349374], [106, 349634], [113, 349914]]}, {"verse": 47, "start": 351062, "end": 360210, "text": "Y que se predicase en su nombre el arrepentimiento y el perdón de pecados en todas las naciones, comenzando de Jerusalén.", "words": [[0, 351062], [2, 351169], [6, 351309], [9, 351649], [19, 351989], [22, 352329], [25, 352609], [32, 353029], [35, 353409], [51, 354429], [53, 354609], [56, 354769], [63, 355249], [66, 355369], [74, 356029], [77, 356509], [83, 356869], [87, 357289], [97, 358269], [108, 359149], [111, 359329]]}, {"verse": 48, "start": 360660, "end": 363801, "text": "Y vosotros sois testigos de estas cosas.", "words": [[0, 360660], [2, 360767], [11, 361267], [16, 361947], [25, 362547], [28, 362767], [34, 362947]]}, {"verse": 49, "start": 364251, "end": 376021, "text": "Y he aquí, yo enviaré la promesa de mi Padre sobre vosotros: pero vosotros permaneced en la ciudad de Jerusalén, hasta que seáis revestidos de poder de lo alto.", "words": [[0, 364251], [2, 364317], [5, 364417], [11, 364857], [14, 365157], [22, 365657], [25, 365777], [33, 366257], [36, 366437], [39, 366557], [45, 367037], [51, 367297], [61, 368482], [66, 368682], [75, 369262], [86, 370422], [89, 370742], [92, 370862], [99, 371242], [102, 371522], [113, 372622], [119, 373062], [123, 373262], [129, 373702], [140, 374562], [143, 374722], [149, 375042], [152, 375262], [155, 375402]]}, {"verse": 50, "start": 376471, "end": 381349, "text": "Y los sacó fuera hasta Betania, y alzando sus manos, los bendijo.", "words": [[0, 376471], [2, 376576], [6, 376716], [11, 377156], [17, 377436], [23, 377636], [32, 378756], [34, 379036], [42, 379516], [46, 379696], [53, 380056], [57, 380616]]}, {"verse": 51, "start": 381799, "end": 387582, "text": "Y aconteció que bendiciéndolos, se fue de ellos; y era llevado arriba al cielo.", "words": [[0, 381799], [2, 382088], [12, 382748], [16, 382948], [32, 384268], [35, 384388], [39, 384548], [42, 384728], [49, 385630], [51, 385786], [55, 385946], [63, 386386], [70, 386646], [73, 386966]]}, {"verse": 52, "start": 388032, "end": 392370, "text": "Y ellos, después de haberle adorado, se volvieron a Jerusalén con gran gozo;", "words": [[0, 388032], [2, 388206], [9, 388446], [17, 388786], [20, 388966], [28, 389366], [37, 389966], [40, 390046], [50, 390526], [52, 390646], [62, 391266], [66, 391446], [71, 391706]]}, {"verse": 53, "start": 392820, "end": 398293, "text": "Y estaban siempre en el templo, alabando y bendiciendo a Dios. Amén.", "words": [[0, 392820], [2, 392928], [10, 393208], [18, 393848], [21, 394108], [24, 394268], [32, 395328], [41, 395828], [43, 395948], [55, 396728], [57, 396868], [63, 397700]]}]}