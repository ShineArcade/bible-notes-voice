{"book": "MAT", "chapter": 14, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 268830, "verses": [{"verse": 1, "start": 300, "end": 4614, "text": "En aquel tiempo Herodes el tetrarca oyó la fama de Jesús,", "words": [[0, 300], [3, 424], [9, 724], [16, 1260], [24, 1796], [27, 2333], [36, 2869], [40, 3349], [43, 3489], [48, 3869], [51, 3949]]}, {"verse": 2, "start": 4964, "end": 13360, "text": "Y dijo a sus criados: Este es Juan el Bautista: él ha resucitado de los muertos, y por eso actúan en él poderes milagrosos.", "words": [[0, 4964], [2, 5244], [7, 5544], [9, 5724], [13, 5844], [22, 7002], [27, 7286], [30, 7526], [35, 7786], [38, 7986], [48, 8913], [51, 9092], [54, 9252], [65, 9932], [68, 10072], [72, 10192], [81, 10692], [83, 10917], [87, 11097], [91, 11297], [98, 11857], [101, 11957], [104, 12117], [112, 12557]]}, {"verse": 3, "start": 13640, "end": 23123, "text": "Porque Herodes había prendido a Juan, y le había aprisionado y puesto en la cárcel, por causa de Herodías, mujer de Felipe su hermano;", "words": [[0, 13640], [7, 13906], [15, 14466], [21, 15006], [30, 15546], [32, 15646], [38, 15966], [40, 16506], [43, 16626], [49, 16906], [61, 17826], [63, 17946], [70, 18426], [73, 18646], [76, 18766], [84, 19286], [88, 19666], [94, 19946], [97, 20246], [107, 21386], [113, 21646], [116, 21886], [123, 22226], [126, 22486]]}, {"verse": 4, "start": 23473, "end": 26914, "text": "Porque Juan le decía: No te es lícito tenerla.", "words": [[0, 23473], [7, 23674], [12, 24034], [15, 24454], [22, 25316], [25, 25518], [28, 25771], [31, 26025], [38, 26278]]}, {"verse": 5, "start": 27194, "end": 32122, "text": "Y quería matarle, pero temía al pueblo; porque le tenían como a profeta.", "words": [[0, 27194], [2, 27312], [9, 27572], [18, 28412], [23, 28532], [29, 29032], [32, 29212], [40, 30129], [47, 30336], [50, 30496], [57, 30876], [62, 31304], [64, 31732]]}, {"verse": 6, "start": 32472, "end": 40790, "text": "Pero celebrándose el día del nacimiento de Herodes, la hija de Herodías danzó en medio, y agradó a Herodes.", "words": [[0, 32472], [5, 32636], [18, 33476], [21, 33776], [25, 33996], [29, 34196], [40, 34816], [43, 34996], [52, 36056], [55, 36136], [60, 36516], [63, 36616], [72, 37176], [78, 38116], [81, 38276], [88, 38696], [90, 39256], [97, 39816], [99, 39996]]}, {"verse": 7, "start": 41140, "end": 44943, "text": "Y prometió él con juramento de darle todo lo que pidiese.", "words": [[0, 41140], [2, 41264], [11, 41864], [14, 42044], [18, 42284], [28, 42884], [31, 43124], [37, 43484], [42, 43884], [45, 44124], [49, 44244]]}, {"verse": 8, "start": 45293, "end": 54107, "text": "Y ella, instruída primero de su madre, dijo: Dame aquí en un plato la cabeza de Juan el Bautista.", "words": [[0, 45293], [2, 45462], [8, 45922], [18, 46582], [26, 46882], [29, 47162], [32, 47322], [39, 48062], [45, 48867], [50, 49127], [55, 49547], [58, 49847], [61, 49987], [67, 50427], [70, 50567], [77, 51007], [80, 51207], [85, 51587], [88, 51847]]}, {"verse": 9, "start": 54387, "end": 62928, "text": "Entonces el rey se entristeció; pero por el juramento, y por los que estaban juntamente a la mesa, mandó que se le diese.", "words": [[0, 54387], [9, 54948], [12, 55388], [16, 55768], [19, 55868], [32, 57040], [37, 57204], [41, 57424], [44, 57544], [55, 58624], [57, 58884], [61, 59024], [65, 59184], [69, 59324], [77, 59664], [88, 60364], [90, 60524], [93, 60604], [99, 61344], [105, 61884], [109, 62004], [112, 62144], [115, 62284]]}, {"verse": 10, "start": 63278, "end": 66232, "text": "Y enviando, degolló a Juan en la cárcel.", "words": [[0, 63278], [2, 63402], [12, 64002], [20, 64602], [22, 64742], [27, 65082], [30, 65362], [33, 65522]]}, {"verse": 11, "start": 66582, "end": 73194, "text": "Y fue traída su cabeza en un plato, y dada a la muchacha; y ella la presentó a su madre.", "words": [[0, 66582], [2, 66707], [6, 66847], [13, 67307], [16, 67527], [23, 68007], [26, 68207], [29, 68347], [36, 68967], [38, 69387], [43, 69787], [45, 69887], [48, 69947], [58, 70970], [60, 71117], [65, 71437], [68, 71837], [77, 72457], [79, 72537], [82, 72637]]}, {"verse": 12, "start": 73544, "end": 81784, "text": "Entonces llegaron sus discípulos, y tomaron el cuerpo, y lo enterraron; y fueron, y dieron la noticia a Jesús.", "words": [[0, 73544], [9, 74197], [18, 75097], [22, 75297], [34, 76137], [36, 76357], [44, 76777], [47, 76937], [55, 77437], [57, 77797], [60, 77937], [72, 78907], [74, 79071], [82, 79351], [84, 79811], [91, 80151], [94, 80331], [102, 80951], [104, 81111]]}, {"verse": 13, "start": 82134, "end": 92783, "text": "Y oyéndolo Jesús, se apartó de allí en un barco a un lugar desierto, apartado: y cuando la gente lo oyó y lo siguió a pie desde las ciudades.", "words": [[0, 82134], [2, 82488], [11, 82878], [18, 83738], [21, 83858], [28, 84358], [31, 84478], [36, 84738], [39, 84978], [42, 85158], [48, 85618], [50, 85878], [53, 85998], [59, 86298], [69, 87158], [79, 88198], [81, 88304], [88, 88544], [91, 88744], [97, 89064], [100, 89384], [104, 89864], [106, 90304], [109, 90444], [116, 90904], [118, 91024], [122, 91244], [128, 91524], [132, 91724]]}, {"verse": 14, "start": 93133, "end": 101458, "text": "Y saliendo Jesús, vio una gran multitud, y tuvo compasión de ellos, y sanó a los que de ellos había enfermos.", "words": [[0, 93133], [2, 93254], [11, 93734], [18, 94854], [22, 95234], [26, 95434], [31, 95694], [41, 96474], [43, 96954], [48, 97174], [58, 97894], [61, 98074], [68, 98394], [70, 98694], [75, 99314], [77, 99654], [81, 99774], [85, 99914], [88, 100054], [94, 100304], [100, 100554]]}, {"verse": 15, "start": 101808, "end": 115291, "text": "Y cuando fue la tarde del día, se llegaron a él sus discípulos, diciendo: El lugar es desierto, y el tiempo es ya pasado: despide a la multitud, para que se vayan por las aldeas, y compren para sí de comer.", "words": [[0, 101808], [2, 101910], [9, 102130], [13, 102430], [16, 102590], [22, 102870], [26, 103190], [31, 103970], [34, 104110], [43, 104630], [45, 104750], [48, 104910], [52, 105090], [64, 106130], [74, 107306], [77, 107427], [83, 107667], [86, 107867], [96, 108467], [98, 108867], [101, 109007], [108, 109327], [111, 109567], [114, 109687], [122, 110532], [130, 111012], [132, 111112], [135, 111172], [145, 111752], [150, 112192], [154, 112332], [157, 112472], [163, 112772], [167, 112932], [171, 113132], [179, 113672], [181, 113852], [189, 114252], [194, 114462], [197, 114672], [200, 114792]]}, {"verse": 16, "start": 115571, "end": 121639, "text": "Y Jesús les dijo: No tienen necesidad de irse: dadles vosotros de comer.", "words": [[0, 115571], [2, 115713], [8, 116113], [12, 116513], [18, 117245], [21, 117354], [28, 117674], [38, 118494], [41, 118614], [47, 119610], [54, 120216], [63, 120916], [66, 121297]]}, {"verse": 17, "start": 121989, "end": 126383, "text": "Y ellos dijeron: No tenemos aquí sino cinco panes y dos peces.", "words": [[0, 121989], [2, 122169], [8, 122369], [17, 123308], [20, 123492], [28, 123832], [33, 124292], [38, 124592], [44, 124892], [50, 125412], [52, 125542], [56, 125672]]}, {"verse": 18, "start": 126663, "end": 129056, "text": "Y él les dijo: Traédmelos acá.", "words": [[0, 126663], [2, 126870], [5, 127010], [9, 127170], [15, 128230], [26, 128580]]}, {"verse": 19, "start": 129406, "end": 143566, "text": "Y mandando a la gente recostarse sobre la hierba, tomando los cinco panes y los dos peces, alzando los ojos al cielo, bendijo, y partió y dio los panes a los discípulos, y los discípulos a la multitud.", "words": [[0, 129406], [2, 129510], [11, 130010], [13, 130089], [16, 130149], [22, 130429], [33, 131210], [39, 131510], [42, 131730], [50, 132249], [58, 132610], [62, 132789], [68, 133129], [74, 133730], [76, 133870], [80, 134010], [84, 134189], [91, 135069], [99, 135550], [103, 135749], [108, 136029], [111, 136310], [118, 137029], [127, 137987], [129, 138113], [136, 138793], [138, 139113], [142, 139293], [146, 139493], [152, 140073], [154, 140173], [158, 140293], [170, 141053], [172, 141493], [176, 141633], [187, 142353], [189, 142633], [192, 142713]]}, {"verse": 20, "start": 143916, "end": 151365, "text": "Y comieron todos, y se saciaron; y alzaron lo que sobró de los pedazos, doce cestas llenas.", "words": [[0, 143916], [2, 144026], [11, 144386], [18, 144786], [20, 145141], [23, 145281], [33, 146403], [35, 146529], [43, 147129], [46, 147329], [50, 147469], [56, 148289], [59, 148469], [63, 148609], [72, 149242], [77, 149876], [84, 150509]]}, {"verse": 21, "start": 151715, "end": 157593, "text": "Y los que comieron fueron como cinco mil hombres, sin las mujeres y los niños.", "words": [[0, 151715], [2, 151839], [6, 151959], [10, 152139], [19, 152679], [26, 152999], [31, 153369], [37, 153739], [41, 154239], [50, 155219], [54, 155719], [58, 155939], [66, 156379], [68, 156619], [72, 156759]]}, {"verse": 22, "start": 157943, "end": 169501, "text": "Y luego Jesús hizo a sus discípulos entrar en el barco, e ir delante de él al otro lado del lago, entre tanto que él despedía a la multitud.", "words": [[0, 157943], [2, 158124], [8, 158424], [14, 159164], [19, 159924], [21, 160184], [25, 160364], [36, 161064], [43, 161604], [46, 161924], [49, 162104], [56, 162564], [58, 162984], [61, 163204], [69, 163824], [72, 164024], [75, 164344], [78, 164624], [83, 164884], [88, 165224], [92, 165524], [98, 166364], [104, 166764], [110, 167204], [114, 167484], [117, 167704], [126, 168384], [128, 168564], [131, 168644]]}, {"verse": 23, "start": 169851, "end": 178500, "text": "Y despedida la multitud, subió al monte, apartado, a orar: y como fue la tarde del día, estaba allí solo.", "words": [[0, 169851], [2, 169957], [12, 170517], [15, 170637], [25, 171237], [31, 171777], [34, 171997], [41, 172797], [51, 174017], [53, 174351], [59, 174850], [61, 175093], [66, 175293], [70, 175533], [73, 175693], [79, 175993], [83, 176273], [88, 176993], [95, 177393], [100, 177733]]}, {"verse": 24, "start": 178850, "end": 185417, "text": "Y ya el barco estaba en medio del mar, atormentado de las olas; porque el viento era contrario.", "words": [[0, 178850], [2, 179112], [5, 179312], [8, 179432], [14, 179812], [21, 180072], [24, 180252], [30, 180492], [34, 180712], [39, 181432], [51, 182292], [54, 182452], [58, 182612], [64, 183502], [71, 183723], [74, 183883], [81, 184263], [85, 184463]]}, {"verse": 25, "start": 185767, "end": 191470, "text": "Pero a la cuarta vigilia de la noche, Jesús fue a ellos andando sobre el mar.", "words": [[0, 185767], [5, 185911], [7, 186031], [10, 186091], [17, 186491], [25, 186951], [28, 187071], [31, 187211], [38, 188031], [44, 188531], [48, 189291], [50, 189611], [56, 189851], [64, 190531], [70, 190831], [73, 191031]]}, {"verse": 26, "start": 191820, "end": 199856, "text": "Y los discípulos, viéndole andar sobre el mar, se turbaron, diciendo: Fantasma es. Y dieron voces de miedo.", "words": [[0, 191820], [2, 192066], [6, 192206], [18, 192826], [27, 193306], [33, 193666], [39, 194066], [42, 194266], [47, 194466], [50, 194986], [60, 196026], [70, 197417], [79, 197797], [83, 198411], [85, 198536], [92, 198816], [98, 199276], [101, 199396]]}, {"verse": 27, "start": 200206, "end": 205943, "text": "Pero luego Jesús les habló, diciendo: Confiad, yo soy; no tengáis miedo.", "words": [[0, 200211], [5, 200371], [11, 200671], [17, 201011], [21, 201351], [28, 201962], [38, 203616], [47, 203616], [50, 203824], [55, 204400], [58, 204740], [66, 205260]]}, {"verse": 28, "start": 206293, "end": 212577, "text": "Entonces le respondió Pedro, y dijo: Señor, si tú eres, manda que yo vaya a ti sobre las aguas.", "words": [[0, 206293], [9, 206810], [12, 207330], [22, 207930], [29, 208310], [31, 208510], [37, 209222], [44, 209580], [47, 209660], [50, 209820], [56, 210480], [62, 210780], [66, 210880], [69, 211020], [74, 211200], [76, 211420], [79, 211540], [85, 211760], [89, 212000]]}, {"verse": 29, "start": 212857, "end": 218906, "text": "Y él dijo: Ven. Y descendiendo Pedro del barco, andaba sobre las aguas para ir a Jesús.", "words": [[0, 212857], [2, 213018], [5, 213138], [11, 214085], [16, 214558], [18, 214666], [31, 215326], [37, 215706], [41, 215946], [48, 216426], [55, 216946], [61, 217186], [65, 217466], [71, 217926], [76, 218126], [79, 218346], [81, 218406]]}, {"verse": 30, "start": 219256, "end": 226596, "text": "Pero viendo el viento fuerte, tuvo miedo; y comenzándose a hundir, dio voces, diciendo: Señor, sálvame.", "words": [[0, 219256], [5, 219400], [12, 219680], [15, 219840], [22, 220140], [30, 220580], [35, 220900], [42, 221888], [44, 221996], [57, 222816], [59, 222976], [67, 223436], [71, 223796], [78, 224336], [88, 225447], [95, 225764]]}, {"verse": 31, "start": 226876, "end": 235187, "text": "Y luego Jesús, extendiendo la mano, lo sujetó, y le dice: Oh hombre de poca fe, ¿por qué dudaste?", "words": [[0, 226876], [2, 227023], [8, 227263], [15, 227783], [27, 228983], [30, 229123], [36, 229883], [39, 230103], [47, 230843], [49, 231203], [52, 231343], [58, 232193], [61, 232313], [68, 232653], [71, 232873], [76, 233233], [80, 233873], [85, 234173], [89, 234353]]}, {"verse": 32, "start": 235537, "end": 239546, "text": "Y como ellos entraron en el barco, se sosegó el viento.", "words": [[0, 235537], [2, 235721], [7, 235981], [13, 236261], [22, 237101], [25, 237221], [28, 237401], [35, 238181], [38, 238281], [45, 238821], [48, 238941]]}, {"verse": 33, "start": 239896, "end": 247856, "text": "Entonces los que estaban en el barco, vinieron y le adoraron, diciendo: Verdaderamente eres Hijo de Dios.", "words": [[0, 239896], [9, 240562], [13, 241037], [17, 241177], [25, 241477], [28, 241697], [31, 241837], [38, 242297], [47, 243097], [49, 243397], [52, 243497], [62, 244537], [72, 245617], [87, 246401], [92, 246661], [97, 247141], [100, 247321]]}, {"verse": 34, "start": 248136, "end": 251782, "text": "Y llegando a la otra parte, vinieron a la tierra de Genezaret.", "words": [[0, 248136], [2, 248265], [11, 248665], [13, 248785], [16, 248845], [21, 249025], [28, 249405], [37, 249965], [39, 250125], [42, 250205], [49, 250545], [52, 251197]]}, {"verse": 35, "start": 252132, "end": 261030, "text": "Y como le conocieron los hombres de aquel lugar, enviaron por toda aquella tierra alrededor, y trajeron a él todos los enfermos;", "words": [[0, 252132], [2, 252240], [7, 252440], [10, 252580], [21, 253240], [25, 253380], [33, 253740], [36, 253920], [42, 254220], [49, 255020], [58, 255740], [62, 256000], [67, 256360], [75, 256860], [82, 257200], [93, 257700], [95, 258120], [104, 258640], [106, 258740], [109, 258940], [115, 259620], [119, 260060]]}, {"verse": 36, "start": 261380, "end": 268430, "text": "Y le rogaban que solamente tocasen el borde de su manto; y todos los que tocaron, quedaron sanos.", "words": [[0, 261380], [2, 261501], [5, 261601], [13, 262181], [17, 262361], [27, 263041], [35, 263721], [38, 263861], [44, 264201], [47, 264341], [50, 264501], [57, 265348], [59, 265631], [65, 265971], [69, 266451], [73, 266611], [82, 267111], [91, 267571]]}]}