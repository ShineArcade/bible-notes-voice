{"book": "MRK", "chapter": 6, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 458110, "verses": [{"verse": 1, "start": 300, "end": 5039, "text": "Y salió de allí, y vino a su pueblo, y le siguieron sus discípulos.", "words": [[0, 300], [2, 441], [8, 761], [11, 901], [17, 1201], [19, 1701], [24, 1921], [26, 2101], [29, 2241], [37, 2601], [39, 2971], [42, 3341], [52, 3761], [56, 3981]]}, {"verse": 2, "start": 5389, "end": 20077, "text": "Y llegado el sábado, comenzó a enseñar en la sinagoga; y muchos oyéndole, estaban atónitos, diciendo: ¿De dónde tiene este estas cosas? ¿Y qué sabiduría es esta que le es dada, y tales milagros realizados por sus manos?", "words": [[0, 5389], [2, 5474], [10, 5874], [13, 5994], [21, 6474], [29, 7134], [31, 7274], [39, 7874], [42, 7994], [45, 8154], [55, 9214], [57, 9496], [64, 9936], [74, 10896], [82, 11276], [92, 12436], [102, 13303], [106, 13420], [112, 13560], [118, 13940], [123, 14240], [129, 14440], [136, 15310], [139, 15409], [143, 15529], [153, 16169], [156, 16349], [161, 16589], [165, 16749], [168, 16889], [171, 17049], [177, 17389], [179, 17769], [185, 17949], [194, 18509], [205, 19109], [209, 19329], [213, 19489]]}, {"verse": 3, "start": 20427, "end": 29912, "text": "¿No es este el carpintero, hijo de María, hermano de Jacobo, y de José, y de Judas, y de Simón? ¿No están también aquí con nosotros, sus hermanas? Y lo rechazaban.", "words": [[0, 20427], [4, 20623], [7, 20783], [12, 21023], [15, 21123], [27, 21843], [32, 22023], [35, 22183], [42, 22823], [50, 23143], [53, 23183], [61, 23743], [63, 23883], [66, 23943], [72, 24203], [74, 24603], [77, 24683], [84, 24943], [86, 25303], [89, 25363], [96, 26101], [100, 26245], [106, 26465], [114, 26765], [119, 26965], [123, 27165], [133, 27685], [137, 27765], [147, 28747], [149, 28851], [152, 28991]]}, {"verse": 4, "start": 30262, "end": 38338, "text": "Pero Jesús les decía: No hay profeta deshonrado sino en su tierra, y entre sus parientes, y en su casa.", "words": [[0, 30262], [5, 30449], [11, 30889], [15, 31369], [22, 32259], [25, 32446], [29, 32666], [37, 33346], [48, 34026], [53, 34306], [56, 34546], [59, 34706], [67, 35226], [69, 35946], [75, 36246], [79, 36486], [90, 37046], [92, 37446], [95, 37586], [98, 37746]]}, {"verse": 5, "start": 38688, "end": 46188, "text": "Y no pudo hacer allí alguna maravilla; solamente sanó unos pocos enfermos, poniendo sobre ellos las manos.", "words": [[0, 38688], [2, 38793], [5, 38933], [10, 39273], [16, 39533], [21, 39853], [28, 40293], [39, 41406], [49, 41904], [54, 42604], [59, 42784], [65, 43224], [75, 43964], [84, 44589], [90, 44929], [96, 45249], [100, 45489]]}, {"verse": 6, "start": 46538, "end": 53840, "text": "Y estaba maravillado de la incredulidad de ellos. Y rodeaba las aldeas de alrededor, enseñando.", "words": [[0, 46538], [2, 46649], [9, 46929], [21, 47729], [24, 47929], [27, 48069], [40, 49029], [43, 49309], [50, 50144], [52, 50269], [60, 50989], [64, 51209], [71, 51789], [74, 51909], [85, 52549]]}, {"verse": 7, "start": 54190, "end": 62451, "text": "Y llamó a los doce, y comenzó a enviarlos de dos en dos: y les dio autoridad sobre los espíritus inmundos.", "words": [[0, 54190], [2, 54338], [8, 54758], [10, 54958], [14, 55218], [20, 55478], [22, 55954], [30, 56594], [32, 56734], [42, 57374], [45, 57654], [49, 57954], [52, 58154], [57, 58916], [59, 59035], [63, 59195], [67, 59435], [77, 60275], [83, 60635], [87, 60875], [97, 61698]]}, {"verse": 8, "start": 62801, "end": 71011, "text": "Y les mandó que no llevasen nada para el camino, sino solamente bastón; no bolsa de viaje, ni pan, ni dinero en la bolsa;", "words": [[0, 62801], [2, 62918], [6, 63038], [12, 63438], [16, 63548], [19, 63658], [28, 64178], [33, 64478], [38, 64718], [41, 64878], [49, 65518], [54, 65778], [64, 66378], [72, 67420], [75, 67584], [81, 68004], [84, 68124], [91, 68804], [94, 68984], [99, 69644], [102, 69804], [109, 70144], [112, 70364], [115, 70444]]}, {"verse": 9, "start": 71361, "end": 75039, "text": "Pero que calzasen sandalias, y no vistiesen dos túnicas.", "words": [[0, 71361], [5, 71507], [9, 71947], [18, 72387], [29, 73147], [31, 73327], [34, 73687], [44, 74047], [48, 74207]]}, {"verse": 10, "start": 75389, "end": 82282, "text": "Y les decía: Donde quiera que entréis en una casa, quedaos en ella hasta que salgáis de allí.", "words": [[0, 75389], [2, 75652], [6, 75952], [13, 76851], [19, 77097], [26, 77557], [30, 77697], [38, 78217], [41, 78377], [45, 78537], [51, 79117], [59, 79897], [62, 80177], [67, 80477], [73, 80837], [77, 81037], [85, 81597], [88, 81857]]}, {"verse": 11, "start": 82632, "end": 100546, "text": "Y todos aquellos que no os reciban ni os oigan, saliendo de allí, sacudid el polvo que está debajo de vuestros pies, en testimonio a ellos. De cierto les digo que más tolerable será el castigo de los de Sodoma y Gomorra el día del juicio, que el de aquella ciudad.", "words": [[0, 82632], [2, 82756], [8, 83036], [17, 83536], [21, 83683], [24, 83829], [27, 83976], [35, 84656], [38, 85016], [41, 85176], [48, 86076], [57, 86616], [60, 86796], [66, 87426], [74, 88056], [77, 88196], [83, 88776], [87, 88936], [92, 89136], [99, 89536], [102, 89716], [111, 89996], [117, 90296], [120, 90796], [131, 91556], [133, 91676], [140, 92397], [143, 92562], [150, 92842], [154, 93202], [159, 93562], [163, 93722], [167, 93922], [177, 94622], [182, 94862], [185, 95082], [193, 95602], [196, 95762], [200, 95882], [203, 96062], [210, 96742], [212, 97022], [220, 97742], [223, 97982], [227, 98172], [231, 98362], [239, 98962], [243, 99202], [246, 99362], [249, 99482], [257, 99822]]}, {"verse": 12, "start": 100896, "end": 104944, "text": "Y saliendo, predicaban que los hombres se arrepintiesen.", "words": [[0, 100896], [2, 101199], [12, 101759], [23, 102559], [27, 102719], [31, 102919], [39, 103319], [42, 104157]]}, {"verse": 13, "start": 105294, "end": 110887, "text": "Y echaban fuera muchos demonios, y ungían con aceite a muchos enfermos, y sanaban.", "words": [[0, 105294], [2, 105442], [10, 105922], [16, 106142], [23, 106482], [33, 107282], [35, 107662], [42, 108182], [46, 108422], [53, 108762], [55, 108982], [62, 109142], [72, 109882], [74, 110182]]}, {"verse": 14, "start": 111237, "end": 122680, "text": "Y oyó el rey Herodes la fama de Jesús, porque su nombre se había hecho notorio; y dijo: Juan el que bautizaba, ha resucitado de los muertos, y por tanto, poderes milagrosos actúan en él.", "words": [[0, 111237], [2, 111387], [6, 111667], [9, 111807], [13, 112127], [21, 112647], [24, 112727], [29, 113047], [32, 113127], [39, 113827], [46, 114027], [49, 114227], [56, 114567], [59, 114767], [65, 115007], [71, 115347], [80, 116339], [82, 116539], [88, 117198], [93, 117430], [96, 117530], [100, 117670], [111, 118390], [114, 118545], [125, 119265], [128, 119385], [132, 119505], [141, 119985], [143, 120200], [147, 120360], [154, 120740], [162, 121280], [173, 121880], [180, 122260], [183, 122360]]}, {"verse": 15, "start": 122960, "end": 129364, "text": "Otros decían: Elías es. Y otros decían: Profeta es, o alguno de los profetas.", "words": [[0, 122960], [6, 123331], [14, 124559], [20, 125039], [24, 125759], [26, 125925], [32, 126105], [40, 127220], [48, 127661], [52, 127881], [54, 128021], [61, 128401], [64, 128461], [68, 128581]]}, {"verse": 16, "start": 129644, "end": 136208, "text": "Y oyéndolo Herodes, dijo: Este es Juan el que yo degollé: él ha resucitado de los muertos.", "words": [[0, 129644], [2, 129806], [11, 130406], [20, 131066], [26, 132050], [31, 132371], [34, 132591], [39, 132851], [42, 133171], [46, 133311], [49, 133721], [58, 134295], [61, 134592], [64, 134932], [75, 135272], [78, 135392], [82, 135512]]}, {"verse": 17, "start": 136488, "end": 149543, "text": "Porque el mismo Herodes había enviado, y prendido a Juan, y le había aprisionado en la cárcel a causa de Herodías, mujer de Felipe su hermano; pues la había tomado por mujer.", "words": [[0, 136488], [7, 136810], [10, 137010], [16, 137350], [24, 137830], [30, 138250], [39, 138890], [41, 139330], [50, 139930], [52, 140030], [58, 140470], [60, 141030], [63, 141190], [69, 141550], [81, 142550], [84, 142690], [87, 142850], [94, 143430], [96, 143610], [102, 143970], [105, 144310], [115, 145290], [121, 145730], [124, 145990], [131, 146630], [134, 146730], [143, 147585], [148, 147688], [151, 147888], [157, 148148], [164, 148648], [168, 148928]]}, {"verse": 18, "start": 149893, "end": 155068, "text": "Porque Juan decía a Herodes: No te es lícito tener la mujer de tu hermano.", "words": [[0, 149893], [7, 150097], [12, 150477], [18, 151257], [20, 151697], [29, 152729], [32, 152872], [35, 153099], [38, 153325], [45, 153552], [51, 153832], [54, 154012], [60, 154272], [63, 154452], [66, 154552]]}, {"verse": 19, "start": 155348, "end": 160189, "text": "Pero Herodías le guardaba rencor, y deseaba matarle, y no podía:", "words": [[0, 155348], [5, 155713], [14, 156113], [17, 156633], [26, 157193], [34, 157753], [36, 157948], [44, 158678], [53, 159408], [55, 159508], [58, 159608]]}, {"verse": 20, "start": 160539, "end": 171556, "text": "Porque Herodes temía a Juan, sabiendo que era varón justo y santo, y le tenía respeto: y oyéndole, hacía muchas cosas; y le oía de buena gana.", "words": [[0, 160539], [7, 160783], [15, 161323], [21, 162123], [23, 162323], [29, 163043], [38, 163483], [42, 163683], [46, 163823], [52, 164143], [58, 164483], [60, 164683], [67, 165483], [69, 165543], [72, 165683], [78, 166023], [87, 167100], [89, 167400], [99, 167960], [105, 168480], [112, 168820], [119, 169929], [121, 170070], [124, 170210], [128, 170570], [131, 170730], [137, 170950]]}, {"verse": 21, "start": 171906, "end": 183358, "text": "Y venido un día oportuno, en que Herodes, en la fiesta de su nacimiento, daba una cena a sus nobles y comandantes militares, y a los principales de Galilea;", "words": [[0, 171906], [2, 172035], [9, 172415], [12, 172575], [16, 172775], [26, 174115], [29, 174295], [33, 174475], [42, 175415], [45, 175715], [48, 175855], [55, 176215], [58, 176395], [61, 176535], [73, 177815], [78, 178135], [82, 178335], [87, 178675], [89, 178955], [93, 179155], [100, 179795], [102, 179975], [114, 180595], [125, 181315], [127, 181655], [129, 181695], [133, 181815], [145, 182515], [148, 182655]]}, {"verse": 22, "start": 183708, "end": 196035, "text": "Y entrando la hija de Herodías, y danzando, y agradando a Herodes y a los que estaban con él a la mesa, el rey dijo a la muchacha: Pídeme lo que quieras, que yo te lo daré.", "words": [[0, 183708], [2, 183872], [11, 184412], [14, 184632], [19, 185072], [22, 185192], [32, 186492], [34, 186692], [44, 188012], [46, 188092], [56, 188712], [58, 188952], [66, 189452], [68, 189832], [70, 189912], [74, 190012], [78, 190152], [86, 190452], [90, 190752], [93, 190912], [95, 190992], [98, 191092], [104, 191892], [107, 192092], [111, 192452], [116, 192912], [118, 193052], [121, 193092], [131, 194014], [138, 194352], [141, 194492], [145, 194612], [154, 195132], [158, 195332], [161, 195472], [164, 195592], [167, 195692]]}, {"verse": 23, "start": 196315, "end": 201521, "text": "Y le juró: Todo lo que me pidas te daré, hasta la mitad de mi reino.", "words": [[0, 196315], [2, 196460], [5, 196560], [11, 197331], [16, 197489], [19, 197689], [23, 197809], [26, 197929], [32, 198249], [35, 198409], [41, 198829], [47, 199149], [50, 199329], [56, 199589], [59, 199829], [62, 199949]]}, {"verse": 24, "start": 201801, "end": 207880, "text": "Y saliendo ella, dijo a su madre: ¿Qué pediré? Y ella dijo: La cabeza de Juan Bautista.", "words": [[0, 201801], [2, 201910], [11, 202390], [17, 202630], [22, 202970], [24, 203130], [27, 203250], [34, 204046], [39, 204170], [47, 204987], [49, 205149], [54, 205349], [60, 206139], [63, 206246], [70, 206606], [73, 206846], [78, 207046]]}, {"verse": 25, "start": 208160, "end": 216385, "text": "Entonces ella entró de inmediato al rey, y pidió, diciendo: Quiero que ahora mismo me des en un plato la cabeza de Juan Bautista.", "words": [[0, 208160], [9, 208705], [14, 209260], [20, 209740], [23, 209840], [33, 210440], [36, 210600], [41, 211020], [43, 211180], [50, 212000], [60, 212906], [67, 213086], [71, 213206], [77, 213386], [83, 213726], [86, 213926], [90, 214066], [93, 214206], [96, 214326], [102, 214646], [105, 214766], [112, 215086], [115, 215286], [120, 215506]]}, {"verse": 26, "start": 216665, "end": 225171, "text": "Y el rey se entristeció mucho; pero a causa del juramento, y de los que estaban con él a la mesa, no quiso desecharla.", "words": [[0, 216665], [2, 216863], [5, 217023], [9, 217463], [12, 217543], [24, 218403], [31, 219327], [36, 219471], [38, 219611], [44, 219931], [48, 220251], [59, 221251], [61, 221491], [64, 221591], [68, 221751], [72, 221911], [80, 222231], [84, 222511], [87, 222711], [89, 222791], [92, 222911], [98, 223731], [101, 223851], [107, 224191]]}, {"verse": 27, "start": 225521, "end": 231305, "text": "Y luego el rey, enviando un verdugo de la guardia, mandó que fuese traída su cabeza;", "words": [[0, 225521], [2, 225683], [8, 225843], [11, 226083], [16, 226563], [25, 227203], [28, 227363], [36, 227783], [39, 227943], [42, 228063], [51, 228903], [57, 229343], [61, 229463], [67, 229953], [74, 230443], [77, 230603]]}, {"verse": 28, "start": 231655, "end": 241385, "text": "El cual fue, y le degolló en la cárcel, y trajo su cabeza en un plato, y la dio a la muchacha, y la muchacha la dio a su madre.", "words": [[0, 231655], [3, 231800], [8, 232080], [13, 232600], [15, 232960], [18, 233120], [26, 233740], [29, 233900], [32, 234060], [40, 234640], [42, 235140], [48, 235560], [51, 235740], [58, 236080], [61, 236360], [64, 236480], [71, 237080], [73, 237580], [76, 237720], [80, 237900], [82, 238080], [85, 238140], [95, 239080], [97, 239520], [100, 239640], [109, 240140], [112, 240300], [116, 240520], [118, 240660], [121, 240780]]}, {"verse": 29, "start": 241735, "end": 248679, "text": "Y oyéndolo sus discípulos, vinieron y tomaron su cuerpo, y le pusieron en un sepulcro.", "words": [[0, 241735], [2, 241892], [11, 242512], [15, 242792], [27, 244272], [36, 244892], [38, 245152], [46, 245632], [49, 245872], [57, 246372], [59, 246607], [62, 246747], [71, 247267], [74, 247627], [77, 247807]]}, {"verse": 30, "start": 249029, "end": 255569, "text": "Y los apóstoles se juntaron con Jesús, y le contaron todo lo que habían hecho, y lo que habían enseñado.", "words": [[0, 249029], [2, 249131], [6, 249251], [16, 249851], [19, 250211], [28, 250711], [32, 250931], [39, 251311], [41, 251786], [44, 251906], [53, 252426], [58, 252746], [61, 253006], [65, 253166], [72, 253446], [79, 253826], [81, 254081], [84, 254201], [88, 254321], [95, 254601]]}, {"verse": 31, "start": 255919, "end": 268458, "text": "Y él les dijo: Venid vosotros aparte al lugar desierto, y descansad un poco. Porque eran muchos los que iban y venían, que ni siquiera tenían tiempo para comer.", "words": [[0, 255919], [2, 256073], [5, 256233], [9, 256513], [15, 257675], [21, 258142], [30, 258722], [37, 259302], [40, 259422], [46, 259762], [56, 260562], [58, 261142], [68, 261982], [71, 262142], [77, 263004], [84, 263229], [89, 263449], [96, 263949], [100, 264449], [104, 264669], [109, 265009], [111, 265109], [119, 265769], [123, 266049], [126, 266229], [135, 266649], [142, 267029], [149, 267529], [154, 267809]]}, {"verse": 32, "start": 268808, "end": 272367, "text": "Y se fueron en un barco al lugar desierto aparte.", "words": [[0, 268808], [2, 268916], [5, 269016], [12, 269316], [15, 269876], [18, 270016], [24, 270496], [27, 270636], [33, 271066], [42, 271496]]}, {"verse": 33, "start": 272717, "end": 281820, "text": "Y los vieron ir muchos, y le conocieron; y corrieron allá muchos a pie de las ciudades, y llegaron antes que ellos, y se juntaron a él.", "words": [[0, 272717], [2, 272843], [6, 272963], [13, 273263], [16, 273423], [24, 273823], [26, 274444], [29, 274543], [41, 275636], [43, 275762], [53, 276362], [58, 276862], [65, 276862], [67, 277132], [71, 277402], [74, 277562], [78, 277702], [88, 278442], [90, 278602], [99, 279002], [105, 279262], [109, 279482], [116, 280382], [118, 280642], [121, 280762], [130, 281322], [132, 281442]]}, {"verse": 34, "start": 282170, "end": 291978, "text": "Y saliendo Jesús vio grande multitud, y tuvo compasión de ellos, porque eran como ovejas que no tenían pastor; y les comenzó a enseñar muchas cosas.", "words": [[0, 282170], [2, 282291], [11, 282731], [17, 283171], [21, 283671], [28, 283951], [38, 284631], [40, 284866], [45, 285046], [55, 285686], [58, 285866], [65, 286166], [72, 286906], [77, 287166], [82, 287446], [89, 287946], [93, 288146], [96, 288286], [103, 288606], [111, 289526], [113, 289624], [117, 289744], [125, 290284], [127, 290344], [135, 290864], [142, 291124]]}, {"verse": 35, "start": 292328, "end": 300383, "text": "Y como ya era muy tarde, sus discípulos llegaron a él, diciendo: El lugar es desierto, y ya es muy tarde;", "words": [[0, 292328], [2, 292434], [7, 292634], [10, 292894], [14, 293074], [18, 293254], [25, 294074], [29, 294314], [40, 295354], [49, 296174], [51, 296314], [55, 296554], [65, 297888], [68, 298001], [74, 298201], [77, 298401], [87, 299001], [89, 299381], [92, 299541], [95, 299681], [99, 299821]]}, {"verse": 36, "start": 300733, "end": 307033, "text": "Envíalos para que vayan a los caseríos y aldeas de alrededor, y compren para sí pan; porque no tienen qué comer.", "words": [[0, 300733], [9, 301278], [14, 301498], [18, 301658], [24, 301978], [26, 302078], [30, 302428], [39, 302778], [41, 302878], [48, 303258], [51, 303568], [62, 303878], [64, 304278], [72, 304678], [77, 304981], [80, 305285], [85, 305747], [92, 305913], [95, 306093], [102, 306333], [106, 306533]]}, {"verse": 37, "start": 307313, "end": 317254, "text": "Y respondiendo él, les dijo: Dadles de comer vosotros. Y le dijeron: ¿ Que vayamos y compremos pan por doscientos denarios, y les demos de comer?", "words": [[0, 307313], [2, 307438], [15, 308218], [19, 308458], [23, 308598], [29, 309299], [36, 309905], [39, 310105], [45, 310405], [55, 311641], [57, 311765], [60, 311865], [69, 312790], [71, 312790], [75, 312891], [83, 313371], [85, 313531], [95, 313971], [99, 314331], [103, 314631], [114, 314931], [124, 315671], [126, 316131], [130, 316251], [136, 316551], [139, 316751]]}, {"verse": 38, "start": 317534, "end": 324957, "text": "Y él les dice: ¿Cuántos panes tenéis? Id, y vedlo. Y sabiéndolo, dijeron: Cinco, y dos peces.", "words": [[0, 317534], [2, 317740], [5, 318017], [9, 318294], [15, 318781], [24, 319167], [30, 319607], [38, 320521], [42, 320521], [44, 320949], [51, 321641], [53, 321901], [65, 322601], [74, 323728], [81, 323908], [83, 324098], [87, 324288]]}, {"verse": 39, "start": 325237, "end": 330209, "text": "Y les mandó que hiciesen recostar a todos por grupos sobre la hierba verde.", "words": [[0, 325237], [2, 325360], [6, 325500], [12, 325960], [16, 326120], [25, 326640], [34, 327280], [36, 327380], [42, 327580], [46, 327880], [53, 328280], [59, 328960], [62, 329180], [69, 329600]]}, {"verse": 40, "start": 330559, "end": 336071, "text": "Y se recostaron en grupos, de ciento en ciento, y de cincuenta en cincuenta.", "words": [[0, 330559], [2, 330687], [5, 330807], [16, 331567], [19, 331747], [27, 332107], [30, 332537], [37, 332967], [40, 333317], [48, 333667], [50, 334102], [53, 334432], [63, 334762], [66, 335426]]}, {"verse": 41, "start": 336421, "end": 348753, "text": "Y tomados los cinco panes y los dos peces, mirando al cielo, bendijo, y partió los panes, y dio a sus discípulos para que los pusiesen delante: y repartió a todos los dos peces.", "words": [[0, 336421], [2, 336526], [10, 336966], [14, 337186], [20, 337586], [26, 338166], [28, 338286], [32, 338426], [36, 338586], [43, 339546], [51, 339946], [54, 340106], [61, 340446], [70, 341446], [72, 341486], [79, 341966], [83, 342106], [90, 342686], [92, 343006], [96, 343226], [98, 343406], [102, 343586], [113, 344206], [118, 344426], [122, 344566], [126, 344726], [135, 345186], [144, 346106], [146, 346232], [155, 346952], [157, 347172], [163, 347472], [167, 347972], [171, 348172]]}, {"verse": 42, "start": 349103, "end": 352291, "text": "Y comieron todos, y quedaron satisfechos.", "words": [[0, 349103], [2, 349226], [11, 349666], [18, 350146], [20, 350706], [29, 351186]]}, {"verse": 43, "start": 352641, "end": 357444, "text": "Y alzaron de los pedazos doce cestas llenas, y de los peces.", "words": [[0, 352641], [2, 352783], [10, 353403], [13, 353583], [17, 353743], [25, 354343], [30, 354943], [37, 355543], [45, 356143], [47, 356383], [50, 356503], [54, 356643]]}, {"verse": 44, "start": 357794, "end": 360903, "text": "Y los que comieron eran cinco mil hombres.", "words": [[0, 357794], [2, 358038], [6, 358158], [10, 358298], [19, 358858], [24, 359271], [30, 359685], [34, 360098]]}, {"verse": 45, "start": 361253, "end": 372185, "text": "Y luego hizo que sus discípulos subieran de inmediato al barco y fueran delante de él a Betsaida de la otra parte, entre tanto que él despedía la multitud.", "words": [[0, 361253], [2, 361374], [8, 361594], [13, 362174], [17, 362474], [21, 362674], [32, 363434], [41, 364074], [44, 364254], [54, 364894], [57, 365034], [63, 365534], [65, 365914], [72, 366354], [80, 366774], [83, 366974], [86, 367174], [88, 367574], [97, 367974], [100, 368134], [103, 368254], [108, 368454], [115, 369294], [121, 369614], [127, 370014], [131, 370274], [134, 370474], [143, 371354], [146, 371474]]}, {"verse": 46, "start": 372535, "end": 375708, "text": "Y después que los hubo despedido, se fue al monte a orar.", "words": [[0, 372535], [2, 372661], [10, 372961], [14, 373208], [18, 373454], [23, 373701], [34, 374261], [37, 374421], [41, 374601], [44, 374761], [50, 375021], [52, 375201]]}, {"verse": 47, "start": 376058, "end": 380868, "text": "Y como fue la tarde, el barco estaba en medio del mar, y él solo en tierra.", "words": [[0, 376058], [2, 376228], [7, 376448], [11, 376648], [14, 376808], [21, 377388], [24, 377468], [30, 377888], [37, 378188], [40, 378408], [46, 378628], [50, 378868], [55, 379148], [57, 379393], [60, 379553], [65, 380013], [68, 380473]]}, {"verse": 48, "start": 381218, "end": 393259, "text": "Y los vio esforzándose por remar, porque el viento les era contrario: y cerca del cuarto turno de vigilancia nocturna, vino a ellos andando sobre el mar, y quería precederlos.", "words": [[0, 381218], [2, 381341], [6, 381481], [10, 381761], [23, 382721], [27, 382941], [34, 383781], [41, 384181], [44, 384341], [51, 384701], [55, 384881], [59, 385081], [70, 386168], [72, 386429], [78, 386709], [82, 386969], [89, 387289], [95, 387909], [98, 388009], [109, 388669], [119, 389629], [124, 389849], [126, 390049], [132, 390249], [140, 390849], [146, 391149], [149, 391389], [154, 391629], [156, 391994], [163, 392294]]}, {"verse": 49, "start": 393609, "end": 399757, "text": "Y viéndole ellos, que andaba sobre el mar, pensaron que era fantasma, y dieron voces;", "words": [[0, 393609], [2, 393772], [11, 394272], [18, 394672], [22, 394932], [29, 395332], [35, 395652], [38, 395872], [43, 396572], [52, 397032], [56, 397272], [60, 397432], [70, 398272], [72, 398712], [79, 398992]]}, {"verse": 50, "start": 400107, "end": 408021, "text": "Porque todos le veían, y se turbaron. Pero luego habló con ellos, y les dijo: Ánimo; yo soy, no temáis.", "words": [[0, 400107], [7, 400269], [13, 400589], [16, 400829], [23, 401369], [25, 401809], [28, 401929], [38, 402986], [43, 403130], [49, 403450], [55, 403930], [59, 404090], [66, 404350], [68, 404710], [72, 404850], [78, 405920], [85, 406506], [88, 406733], [93, 407013], [96, 407551]]}, {"verse": 51, "start": 408371, "end": 416143, "text": "Y subió a ellos en el barco, y calmó el viento: y ellos en gran manera estaban fuera de sí, y se maravillaban:", "words": [[0, 408371], [2, 408519], [8, 408919], [10, 409059], [16, 409279], [19, 409519], [22, 409659], [29, 410219], [31, 410599], [37, 411059], [40, 411179], [48, 412065], [50, 412211], [56, 412511], [59, 412731], [64, 412931], [71, 413311], [79, 413711], [85, 414031], [88, 414291], [92, 414531], [94, 414951], [97, 415091]]}, {"verse": 52, "start": 416493, "end": 423337, "text": "Porque aún no habían considerado lo de los panes, por cuanto sus corazones estaban endurecidos.", "words": [[0, 416493], [7, 416755], [11, 417215], [14, 417475], [21, 417775], [33, 418675], [36, 418835], [39, 418975], [43, 419095], [50, 419935], [54, 420335], [61, 420615], [65, 420935], [75, 421795], [83, 422155]]}, {"verse": 53, "start": 423687, "end": 429155, "text": "Y cuando estuvieron de la otra parte, vinieron a tierra de Genezaret, y llegaron a la orilla.", "words": [[0, 423687], [2, 423827], [9, 424007], [20, 424547], [23, 424667], [26, 424787], [31, 424947], [38, 425447], [47, 426207], [49, 426367], [56, 426627], [59, 427117], [70, 427607], [72, 427907], [81, 428367], [83, 428487], [86, 428567]]}, {"verse": 54, "start": 429505, "end": 433026, "text": "Y saliendo ellos del barco, luego le conocieron.", "words": [[0, 429505], [2, 429622], [11, 430122], [17, 430382], [21, 430662], [28, 431542], [34, 431842], [37, 432062]]}, {"verse": 55, "start": 433376, "end": 441450, "text": "Y recorriendo toda la tierra de alrededor, comenzaron a traer de todas partes enfermos en lechos, a donde oían que estaba.", "words": [[0, 433376], [2, 433561], [14, 434221], [19, 434461], [22, 434701], [29, 435101], [32, 435301], [43, 435801], [54, 436801], [56, 436981], [62, 437361], [65, 437481], [71, 437701], [78, 438141], [87, 438861], [90, 439041], [98, 439641], [100, 439921], [106, 440141], [111, 440581], [115, 440781]]}, {"verse": 56, "start": 441800, "end": 457710, "text": "Y donde quiera que entraba, en aldeas, o ciudades, o campos, ponían en las calles a los que estaban enfermos, y le rogaban que tocasen siquiera el borde de su vestido; y todos los que le tocaban quedaban sanos.", "words": [[0, 441800], [2, 442033], [8, 442299], [15, 442566], [19, 442846], [28, 443946], [31, 444326], [39, 445126], [41, 445586], [51, 446286], [53, 446426], [61, 447286], [68, 447866], [71, 448046], [75, 448206], [82, 448706], [84, 448826], [88, 448926], [92, 449046], [100, 449326], [110, 450454], [112, 450624], [115, 450794], [123, 451434], [127, 451594], [135, 452214], [144, 452734], [147, 452894], [153, 453274], [156, 453454], [159, 453594], [168, 454532], [170, 454650], [176, 455010], [180, 455530], [184, 455710], [187, 455810], [195, 456390], [204, 456890]]}]}