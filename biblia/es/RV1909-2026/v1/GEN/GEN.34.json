{"book": "GEN", "chapter": 34, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 278842, "verses": [{"verse": 1, "start": 300, "end": 7442, "text": "Y salió Dina la hija de Lea, la cual había esta parido a Jacob, a ver las hijas del país.", "words": [[0, 300], [2, 444], [8, 844], [13, 1324], [16, 1404], [21, 1804], [24, 1884], [29, 2584], [32, 2824], [37, 3104], [43, 3524], [48, 3944], [55, 4364], [57, 4504], [64, 5344], [66, 5444], [70, 5604], [74, 5804], [80, 6304], [84, 6684]]}, {"verse": 2, "start": 7792, "end": 16981, "text": "Y la vio Siquem, hijo de Hamor heveo, príncipe de aquella tierra, y la tomó, y se acostó con ella, y la deshonró.", "words": [[0, 7792], [2, 7933], [5, 8053], [9, 8693], [17, 9333], [22, 9713], [25, 10233], [31, 10753], [38, 11273], [47, 11833], [50, 12033], [58, 12353], [66, 13353], [68, 13453], [71, 13573], [77, 14073], [79, 14493], [82, 14653], [89, 15193], [93, 15393], [99, 15693], [101, 15958], [104, 16078]]}, {"verse": 3, "start": 17331, "end": 24564, "text": "Pero su alma se apegó a Dina la hija de Lea, y se enamoró de la joven, y habló al corazón de la joven.", "words": [[0, 17331], [5, 17493], [8, 17713], [13, 18033], [16, 18293], [22, 18713], [24, 18853], [29, 19173], [32, 19253], [37, 19613], [40, 19693], [45, 20393], [47, 20713], [50, 20853], [58, 21533], [61, 21633], [64, 21753], [71, 22473], [73, 22653], [79, 23013], [82, 23133], [90, 23593], [93, 23833], [96, 23933]]}, {"verse": 4, "start": 24914, "end": 29804, "text": "Y habló Siquem a Hamor su padre, diciendo: Tómame por mujer esta joven.", "words": [[0, 24914], [2, 25227], [8, 25727], [15, 26227], [17, 26387], [23, 26547], [26, 26767], [33, 27327], [43, 28289], [50, 28573], [54, 28793], [60, 29113], [65, 29333]]}, {"verse": 5, "start": 30084, "end": 40831, "text": "Y oyó Jacob que había Siquem deshonrado a Dina su hija: y estando sus hijos con su ganado en el campo, calló Jacob hasta que ellos viniesen.", "words": [[0, 30084], [2, 30273], [6, 30503], [12, 31323], [16, 31423], [22, 31703], [29, 32323], [40, 33183], [42, 33383], [47, 33603], [50, 33823], [56, 34542], [58, 34642], [66, 35082], [70, 35382], [76, 35702], [80, 36062], [83, 36302], [90, 36822], [93, 36942], [96, 37042], [103, 37802], [109, 38562], [115, 38902], [121, 39462], [125, 39682], [131, 39902]]}, {"verse": 6, "start": 41181, "end": 45798, "text": "Y se dirigió Hamor padre de Siquem a Jacob, para hablar con él.", "words": [[0, 41181], [2, 41305], [5, 41445], [13, 41925], [19, 42405], [25, 42925], [28, 43225], [35, 43525], [37, 43885], [44, 44245], [49, 44805], [56, 45125], [60, 45425]]}, {"verse": 7, "start": 46148, "end": 60830, "text": "Y los hijos de Jacob vinieron del campo cuando lo supieron; y se entristecieron los varones, y se ensañaron mucho, porque hizo vileza en Israel echándose con la hija de Jacob, lo que no se debía haber hecho.", "words": [[0, 46148], [2, 46235], [6, 46375], [12, 46675], [15, 46835], [21, 47135], [30, 47775], [34, 48035], [40, 48475], [47, 48795], [50, 49055], [60, 50177], [62, 50342], [65, 50462], [80, 51562], [84, 51762], [93, 52702], [95, 52962], [98, 53082], [108, 53782], [115, 54322], [122, 54942], [127, 55512], [134, 56082], [137, 56222], [144, 56642], [154, 57482], [158, 57722], [161, 57902], [166, 58242], [169, 58619], [176, 58997], [179, 59137], [183, 59277], [186, 59457], [189, 59657], [195, 60057], [201, 60297]]}, {"verse": 8, "start": 61180, "end": 69173, "text": "Y Hamor habló con ellos, diciendo: El alma de mi hijo Siquem se ha apegado a vuestra hija; os ruego que se la deis por mujer.", "words": [[0, 61180], [2, 61412], [8, 61682], [14, 62482], [18, 62682], [25, 62982], [35, 64290], [38, 64407], [43, 64667], [46, 64847], [49, 64947], [54, 65297], [61, 65647], [64, 65787], [67, 66077], [75, 66367], [77, 66447], [85, 66747], [91, 67385], [94, 67509], [100, 67869], [104, 68009], [107, 68149], [110, 68269], [115, 68509], [119, 68669]]}, {"verse": 9, "start": 69523, "end": 74453, "text": "Y emparentad con nosotros; dadnos vuestras hijas, y tomad vosotros las nuestras.", "words": [[0, 69523], [2, 69641], [13, 70221], [17, 70381], [27, 71309], [34, 71716], [43, 72116], [50, 72776], [52, 72896], [58, 73216], [67, 73656], [71, 73836]]}, {"verse": 10, "start": 74803, "end": 82844, "text": "Y habitad con nosotros; porque la tierra estará delante de vosotros; morad y negociad en ella, y tomad en ella posesión.", "words": [[0, 74803], [2, 74925], [10, 75385], [14, 75545], [24, 76581], [31, 76783], [34, 76963], [41, 77303], [48, 77923], [56, 78343], [59, 78483], [69, 79313], [75, 79713], [77, 79893], [86, 80473], [89, 80633], [95, 80893], [97, 81333], [103, 81673], [106, 81793], [111, 81993]]}, {"verse": 11, "start": 83124, "end": 90176, "text": "Siquem también dijo a su padre y a sus hermanos: Halle yo gracia en vuestros ojos, y daré lo que me digáis.", "words": [[0, 83347], [7, 83607], [15, 83987], [20, 84427], [22, 84627], [25, 84747], [31, 85127], [33, 85547], [35, 85647], [39, 85767], [49, 86980], [55, 87120], [58, 87300], [65, 87680], [68, 87780], [77, 88120], [83, 88460], [85, 88920], [90, 89180], [93, 89280], [97, 89380], [100, 89520]]}, {"verse": 12, "start": 90526, "end": 96102, "text": "Aumentad a cargo mío mucho dote y dones, que yo daré cuanto me digáis, y dadme la joven por mujer.", "words": [[0, 90686], [9, 90886], [11, 91086], [17, 91306], [21, 91786], [27, 91966], [32, 92326], [34, 92466], [41, 92966], [45, 93046], [48, 93186], [53, 93426], [60, 93586], [63, 93866], [71, 94346], [73, 94626], [79, 94966], [82, 95046], [88, 95386], [92, 95566]]}, {"verse": 13, "start": 96382, "end": 104975, "text": "Y respondieron los hijos de Jacob a Siquem y a Hamor su padre con engaño; y hablaron, por cuanto había deshonrado a Dina su hermana.", "words": [[0, 96382], [2, 96501], [15, 97201], [19, 97421], [25, 97721], [28, 97921], [34, 98301], [36, 98711], [43, 99121], [45, 99341], [47, 99621], [53, 99901], [56, 100101], [62, 100441], [66, 100721], [74, 101687], [76, 101789], [86, 102209], [90, 102389], [97, 102689], [103, 103239], [114, 103789], [116, 103969], [121, 104209], [124, 104389]]}, {"verse": 14, "start": 105325, "end": 114001, "text": "Y les dijeron: No podemos hacer esto de dar nuestra hermana a hombre que tiene prepucio; porque entre nosotros es abominación.", "words": [[0, 105325], [2, 105443], [6, 105543], [15, 106521], [18, 106646], [26, 107026], [32, 107366], [37, 107666], [40, 107846], [44, 108066], [52, 108386], [60, 108906], [62, 109126], [69, 109386], [73, 109586], [79, 109886], [89, 111006], [96, 111251], [102, 111771], [111, 112291], [114, 112751]]}, {"verse": 15, "start": 114351, "end": 122135, "text": "Mas con esta condición aceptaremos: si habéis de ser como nosotros, que se circuncide entre vosotros todo varón;", "words": [[0, 114351], [4, 114459], [8, 114659], [13, 114819], [23, 115479], [36, 116807], [39, 116973], [46, 117313], [49, 117433], [53, 117633], [58, 117873], [68, 118313], [72, 118693], [75, 119213], [86, 120293], [92, 120593], [101, 121193], [106, 121413]]}, {"verse": 16, "start": 122485, "end": 130283, "text": "Entonces os daremos nuestras hijas, y tomaremos nosotros las vuestras; y habitaremos con vosotros, y seremos un pueblo.", "words": [[0, 122485], [9, 123105], [12, 123365], [20, 123805], [29, 124125], [36, 124865], [38, 125025], [48, 125485], [57, 125965], [61, 126265], [71, 127142], [73, 127363], [85, 127903], [89, 128123], [99, 128723], [101, 129083], [109, 129403], [112, 129643]]}, {"verse": 17, "start": 130633, "end": 136941, "text": "Mas si no nos prestáis oído para circuncidaros, tomaremos nuestra hija, y nos iremos.", "words": [[0, 130730], [4, 130860], [7, 131040], [10, 131220], [14, 131380], [23, 131960], [28, 132340], [33, 132600], [48, 134060], [58, 134580], [66, 135000], [72, 135820], [74, 136020], [78, 136180]]}, {"verse": 18, "start": 137291, "end": 141717, "text": "Y parecieron bien sus palabras a Hamor y a Siquem, hijo de Hamor.", "words": [[0, 137291], [2, 137435], [13, 138015], [18, 138195], [22, 138395], [31, 138835], [33, 139145], [39, 139455], [41, 139762], [43, 140068], [51, 140375], [56, 141035], [59, 141391]]}, {"verse": 19, "start": 142067, "end": 151608, "text": "Y el mozo no tardó en hacer aquello, porque la hija de Jacob le había agradado: y él era el más honrado de toda la casa de su padre.", "words": [[0, 142067], [2, 142208], [5, 142348], [10, 142688], [13, 142928], [19, 143408], [22, 143588], [28, 143868], [37, 144468], [44, 145148], [47, 145408], [52, 145688], [55, 145808], [61, 146188], [64, 146513], [70, 147169], [80, 147994], [82, 148183], [85, 148323], [89, 148623], [92, 148803], [96, 149003], [104, 149783], [107, 150023], [112, 150203], [115, 150423], [120, 150683], [123, 150903], [126, 151043]]}, {"verse": 20, "start": 151958, "end": 160244, "text": "Entonces Hamor y Siquem su hijo vinieron a la puerta de su ciudad, y hablaron a los varones de su ciudad, diciendo:", "words": [[0, 151958], [9, 152471], [15, 153021], [17, 153361], [24, 153701], [27, 154181], [32, 154421], [41, 154941], [43, 155181], [46, 155281], [53, 155581], [56, 155881], [59, 156061], [67, 156541], [69, 157141], [78, 157701], [80, 157881], [84, 158061], [92, 158561], [95, 158721], [98, 158921], [106, 159361]]}, {"verse": 21, "start": 160594, "end": 175701, "text": "Estos varones son pacíficos con nosotros, y habitarán en el país, y comerciarán en él: pues he aquí la tierra es bastante ancha para ellos: nosotros tomaremos sus hijas por mujeres, y les daremos las nuestras.", "words": [[0, 160594], [6, 160896], [14, 161276], [18, 161496], [28, 162176], [32, 162316], [42, 162876], [44, 163516], [54, 164116], [57, 164256], [60, 164416], [66, 164756], [68, 165296], [80, 166256], [83, 166496], [87, 167049], [92, 167196], [95, 167496], [100, 168296], [103, 168436], [110, 168716], [113, 168996], [122, 169276], [128, 169816], [133, 170036], [140, 170809], [149, 171713], [159, 172248], [163, 172528], [169, 172908], [173, 173108], [182, 173608], [184, 173993], [188, 174173], [196, 174633], [200, 174813]]}, {"verse": 22, "start": 176051, "end": 188936, "text": "Mas con esta condición nos harán estos hombres el placer de habitar con nosotros, para que seamos un pueblo: que se circuncide todo varón entre nosotros, así como ellos son circuncidados.", "words": [[0, 176051], [4, 176218], [8, 176398], [13, 176578], [23, 177218], [27, 177458], [33, 177818], [39, 178018], [47, 178458], [50, 178718], [57, 179478], [60, 179658], [68, 180018], [72, 180218], [82, 180798], [87, 181558], [91, 181718], [98, 182098], [101, 182278], [109, 183136], [113, 183240], [116, 183860], [127, 184480], [132, 184740], [138, 185180], [144, 185400], [154, 186620], [158, 186860], [163, 187160], [169, 187360], [173, 187660]]}, {"verse": 23, "start": 189286, "end": 197563, "text": "Sus ganados, y sus bienes y todas sus bestias, serán nuestros: solamente convengamos con ellos, y habitarán con nosotros.", "words": [[0, 189286], [4, 189393], [13, 189933], [15, 190093], [19, 190273], [26, 190693], [28, 190833], [34, 191033], [38, 191333], [47, 191793], [53, 192493], [63, 193433], [73, 193963], [85, 194863], [89, 195123], [96, 195463], [98, 195983], [108, 196543], [112, 196743]]}, {"verse": 24, "start": 197913, "end": 209295, "text": "Y obedecieron a Hamor y a Siquem su hijo todos los que salían por la puerta de la ciudad, y circuncidaron a todo varón, a cuantos salían por la puerta de su ciudad.", "words": [[0, 197913], [2, 198077], [14, 198817], [16, 199097], [22, 199377], [24, 199657], [26, 199937], [33, 200217], [36, 200457], [41, 201037], [47, 201337], [51, 201737], [55, 201897], [62, 202357], [66, 202577], [69, 202737], [76, 203057], [79, 203317], [82, 203417], [90, 203717], [92, 204417], [106, 205457], [108, 205597], [113, 205777], [120, 206685], [122, 206817], [130, 206987], [137, 207667], [141, 207887], [144, 208027], [151, 208327], [154, 208670], [157, 209013]]}, {"verse": 25, "start": 209645, "end": 225922, "text": "Y sucedió que al tercer día, cuando sentían ellos el mayor dolor, los dos hijos de Jacob, Simeón y Leví, hermanos de Dina, tomaron cada uno su espada, y vinieron contra la ciudad animosamente, y mataron a todo varón.", "words": [[0, 209645], [2, 209769], [10, 210329], [14, 210529], [17, 210689], [24, 211009], [29, 212049], [36, 212189], [44, 212809], [50, 213109], [53, 213349], [59, 213629], [66, 214589], [70, 214689], [74, 214889], [80, 215429], [83, 215749], [90, 216369], [97, 216989], [99, 217429], [105, 217869], [114, 218329], [117, 218449], [123, 219249], [131, 219649], [136, 219869], [140, 220189], [143, 220429], [151, 221308], [153, 221429], [162, 221889], [169, 222309], [172, 222509], [179, 222789], [193, 223829], [195, 224169], [203, 224709], [205, 224949], [210, 225189]]}, {"verse": 26, "start": 226272, "end": 234375, "text": "Y a Hamor y a Siquem su hijo los mataron a filo de espada: y tomaron a Dina de casa de Siquem, y se salieron.", "words": [[0, 226272], [2, 226410], [4, 226690], [10, 226970], [12, 227283], [14, 227597], [21, 227910], [24, 228230], [29, 228610], [33, 228935], [41, 229495], [43, 229635], [48, 229995], [51, 230135], [59, 231101], [61, 231206], [69, 231626], [71, 231826], [76, 232046], [79, 232206], [84, 232426], [87, 232806], [95, 233186], [97, 233401], [100, 233561]]}, {"verse": 27, "start": 234725, "end": 241257, "text": "Y los hijos de Jacob vinieron a los muertos, y saquearon la ciudad; por cuanto habían deshonrado a su hermana.", "words": [[0, 234725], [2, 234807], [6, 234927], [12, 235207], [15, 235387], [21, 235667], [30, 236327], [32, 236507], [36, 236607], [45, 237047], [47, 237307], [57, 237867], [60, 238007], [68, 238834], [72, 238978], [79, 239451], [86, 239925], [97, 240398], [99, 240518], [102, 240618]]}, {"verse": 28, "start": 241607, "end": 247177, "text": "Tomaron sus ovejas y vacas y sus asnos, y lo que había en la ciudad y en el campo,", "words": [[0, 241607], [8, 241971], [12, 242351], [19, 242731], [21, 242851], [27, 243291], [29, 243411], [33, 243591], [40, 244371], [42, 244631], [45, 244771], [49, 244931], [55, 245131], [58, 245331], [61, 245471], [68, 245771], [70, 246071], [73, 246211], [76, 246331]]}, {"verse": 29, "start": 247527, "end": 255625, "text": "Y todos sus bienes; se llevaron cautivos a todos sus niños y sus mujeres, y robaron todo lo que había en casa.", "words": [[0, 247527], [2, 247527], [8, 247769], [12, 248269], [20, 249212], [23, 249357], [32, 249777], [41, 250357], [43, 250657], [49, 250937], [53, 251197], [59, 251657], [61, 251937], [65, 252117], [74, 252557], [76, 253052], [84, 253692], [89, 254052], [92, 254352], [96, 254532], [102, 254732], [105, 255012]]}, {"verse": 30, "start": 255975, "end": 272051, "text": "Entonces dijo Jacob a Simeón y a Leví: Me habéis turbado con hacerme abominable a los moradores de esta tierra, el cananeo y el ferezeo; y teniendo yo pocos hombres, se juntarán contra mí, y me herirán, y seré destruido yo y mi casa.", "words": [[0, 255975], [9, 256444], [14, 257204], [20, 257624], [22, 258124], [29, 258624], [31, 258924], [33, 259044], [39, 259695], [42, 259797], [49, 260057], [57, 260557], [61, 260737], [69, 261157], [80, 261837], [82, 261977], [86, 262077], [96, 262537], [99, 262777], [104, 262977], [112, 263937], [115, 264037], [123, 264617], [125, 264717], [128, 265132], [137, 265735], [139, 265840], [148, 266300], [151, 266460], [157, 266880], [166, 267600], [169, 267740], [178, 268260], [185, 268600], [189, 268860], [191, 269160], [194, 269280], [203, 269980], [205, 270240], [210, 270520], [220, 271100], [223, 271300], [225, 271420], [228, 271520]]}, {"verse": 31, "start": 272331, "end": 278442, "text": "Y ellos respondieron: ¿Había él de tratar a nuestra hermana como a una ramera?", "words": [[0, 272331], [2, 272534], [8, 272894], [22, 274284], [29, 274644], [32, 275124], [35, 275304], [42, 275664], [44, 275924], [52, 276224], [60, 276884], [65, 277204], [67, 277404], [71, 277947]]}]}