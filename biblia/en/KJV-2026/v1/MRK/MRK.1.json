{"book": "MRK", "chapter": 1, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 310786, "verses": [{"verse": 1, "start": 300, "end": 3761, "text": "The beginning of the gospel of Jesus Christ, the Son of God;", "words": [[0, 300], [4, 377], [14, 697], [17, 937], [21, 1057], [28, 1437], [31, 1677], [37, 1957], [45, 2777], [49, 2877], [53, 3117], [56, 3237]]}, {"verse": 2, "start": 4211, "end": 11348, "text": "As it is written in the prophets, Behold, I send my messenger before your face, which shall prepare your way before you.", "words": [[0, 4211], [3, 4421], [6, 4541], [9, 4661], [17, 4901], [20, 5081], [24, 5181], [34, 6121], [42, 6861], [44, 7021], [49, 7301], [52, 7521], [62, 7981], [69, 8341], [74, 8581], [80, 9341], [86, 9481], [92, 9721], [100, 10121], [105, 10381], [109, 10601], [116, 10921]]}, {"verse": 3, "start": 11798, "end": 17298, "text": "The voice of one crying in the wilderness, Prepare the way of the Lord, make his paths straight.", "words": [[0, 11798], [4, 11888], [10, 12148], [13, 12388], [17, 12608], [24, 13048], [27, 13248], [31, 13368], [43, 14328], [51, 14668], [55, 14948], [59, 15128], [62, 15248], [66, 15368], [72, 16048], [77, 16168], [81, 16398], [87, 16628]]}, {"verse": 4, "start": 17748, "end": 23606, "text": "John did baptize in the wilderness, and preach the baptism of repentance for the remission of sins.", "words": [[0, 17748], [5, 17968], [9, 18228], [17, 18968], [20, 19088], [24, 19188], [36, 19608], [40, 20078], [47, 20548], [51, 20768], [59, 21148], [62, 21508], [73, 21908], [77, 22268], [81, 22408], [91, 22808], [94, 22968]]}, {"verse": 5, "start": 24056, "end": 33822, "text": "And there went out to him all the land of Judæa, and they of Jerusalem, and were all baptized of him in the river of Jordan, confessing their sins.", "words": [[0, 24056], [4, 24179], [10, 24339], [15, 24539], [19, 24739], [22, 24959], [26, 25159], [30, 25519], [34, 25719], [39, 26079], [42, 26529], [49, 26979], [53, 27539], [58, 27779], [61, 27959], [72, 29019], [76, 29299], [81, 29459], [85, 29659], [94, 30079], [97, 30559], [101, 30719], [104, 30919], [108, 31019], [114, 31279], [117, 31479], [125, 32179], [136, 32879], [142, 33079]]}, {"verse": 6, "start": 34272, "end": 42203, "text": "And John was clothed with camel’s hair, and with a girdle of a skin about his loins; and he did eat locusts and wild honey;", "words": [[0, 34272], [4, 34422], [9, 34682], [13, 34902], [21, 35482], [26, 35582], [34, 36202], [40, 36442], [44, 36962], [49, 37122], [51, 37222], [58, 37622], [61, 37722], [63, 37822], [68, 38102], [74, 38362], [78, 38542], [85, 39638], [89, 39918], [92, 40038], [96, 40278], [100, 40438], [108, 41178], [112, 41298], [117, 41618]]}, {"verse": 7, "start": 42653, "end": 50051, "text": "And preached, saying, There comes one mightier than I after me, the strap of whose shoes I am not worthy to stoop down and unloose.", "words": [[0, 42653], [4, 42799], [14, 43499], [22, 44355], [28, 44519], [34, 44739], [38, 45039], [47, 45339], [52, 45639], [54, 45779], [60, 46039], [64, 46559], [68, 46679], [74, 46959], [77, 47159], [83, 47319], [89, 47599], [91, 47859], [94, 47999], [98, 48179], [105, 48519], [108, 48719], [114, 49039], [119, 49279], [123, 49459]]}, {"verse": 8, "start": 50501, "end": 56058, "text": "I indeed have baptized you with water: but he shall baptize you with the Holy Spirit.", "words": [[0, 50501], [2, 50662], [9, 50882], [14, 51122], [23, 51442], [27, 51782], [32, 51942], [39, 53472], [43, 53668], [46, 53868], [52, 54108], [60, 54768], [64, 54888], [69, 55068], [73, 55208], [78, 55428]]}, {"verse": 9, "start": 56408, "end": 64216, "text": "And it came to pass in those days, that Jesus came from Nazareth of Galilee, and was baptized of John in Jordan.", "words": [[0, 56408], [4, 56516], [7, 56616], [12, 56876], [15, 57076], [20, 57376], [23, 57716], [29, 57936], [35, 58716], [40, 59036], [46, 59396], [51, 59816], [56, 60056], [65, 60636], [68, 60876], [77, 61496], [81, 62036], [85, 62196], [94, 62636], [97, 63076], [102, 63366], [105, 63656]]}, {"verse": 10, "start": 64666, "end": 71107, "text": "And immediately coming up out of the water, he saw the heavens opened, and the Spirit like a dove descending upon him:", "words": [[0, 64666], [4, 64829], [16, 65169], [23, 65669], [26, 65949], [30, 66109], [33, 66229], [37, 66349], [44, 66989], [47, 67149], [51, 67369], [55, 67529], [63, 67749], [71, 68549], [75, 68669], [79, 68809], [86, 69129], [91, 69389], [93, 69549], [98, 69789], [109, 70249], [114, 70629]]}, {"verse": 11, "start": 71557, "end": 77159, "text": "And there came a voice from heaven, saying, You are my beloved Son, in whom I am well pleased.", "words": [[0, 71557], [4, 71661], [10, 71781], [15, 71981], [17, 72121], [23, 72401], [28, 72641], [36, 72901], [44, 73871], [48, 74010], [52, 74110], [55, 74250], [63, 74570], [68, 75470], [71, 75590], [76, 75750], [78, 75930], [81, 76030], [86, 76170]]}, {"verse": 12, "start": 77509, "end": 80727, "text": "And immediately the Spirit drives him into the wilderness.", "words": [[0, 77509], [4, 77655], [16, 78435], [20, 78515], [27, 78875], [34, 79235], [38, 79495], [43, 79695], [47, 79815]]}, {"verse": 13, "start": 81177, "end": 89318, "text": "And he was there in the wilderness forty days, tempted of Satan; and was with the wild beasts; and the angels ministered to him.", "words": [[0, 81177], [4, 81417], [7, 81497], [11, 81677], [17, 81957], [20, 82157], [24, 82257], [35, 82717], [41, 83177], [47, 83637], [55, 84097], [58, 84357], [65, 85311], [69, 85591], [73, 85731], [78, 85931], [82, 86111], [87, 86391], [95, 87515], [99, 87641], [103, 87741], [110, 88101], [121, 88841], [124, 88961]]}, {"verse": 14, "start": 89768, "end": 96430, "text": "Now after that John was put in prison, Jesus came into Galilee, preaching the gospel of the kingdom of God,", "words": [[0, 89768], [4, 89946], [10, 90326], [15, 90566], [20, 90886], [24, 91166], [28, 91366], [31, 91506], [39, 92306], [45, 92626], [50, 92986], [55, 93206], [64, 94086], [74, 94466], [78, 94706], [85, 95046], [88, 95286], [92, 95446], [100, 95666], [103, 95906]]}, {"verse": 15, "start": 96880, "end": 104398, "text": "And saying, The time is fulfilled, and the kingdom of God is at hand: repent, and believe the gospel.", "words": [[0, 96880], [4, 97018], [12, 97873], [16, 97975], [21, 98315], [24, 98475], [35, 98935], [39, 99615], [43, 99755], [51, 100075], [54, 100295], [58, 100695], [61, 101055], [64, 101195], [70, 102045], [78, 102450], [82, 103130], [90, 103550], [94, 103810]]}, {"verse": 16, "start": 104748, "end": 112779, "text": "Now as he walked by the sea of Galilee, he saw Simon and Andrew his brother casting a net into the sea: for they were fishers.", "words": [[0, 104748], [4, 104971], [7, 105231], [10, 105351], [17, 105631], [20, 105931], [24, 106091], [28, 106371], [31, 106511], [40, 107551], [43, 107611], [47, 107911], [53, 108311], [57, 108531], [64, 109011], [68, 109091], [76, 109551], [84, 109911], [86, 110091], [90, 110291], [95, 110591], [99, 110751], [104, 111492], [108, 111592], [113, 111752], [118, 111952]]}, {"verse": 17, "start": 113229, "end": 119249, "text": "And Jesus said to them, Come after me, and I will make you to become fishers of men.", "words": [[0, 113229], [4, 113390], [10, 113690], [15, 114070], [18, 114230], [24, 115721], [29, 115908], [35, 116228], [39, 116908], [43, 116988], [45, 117168], [50, 117328], [55, 117588], [59, 117788], [62, 117908], [69, 118188], [77, 118708], [80, 118848]]}, {"verse": 18, "start": 119599, "end": 122764, "text": "And immediately they forsook their nets, and followed him.", "words": [[0, 119599], [4, 119780], [16, 120180], [21, 120620], [29, 121200], [35, 121340], [41, 121660], [45, 122100], [54, 122400]]}, {"verse": 19, "start": 123214, "end": 131623, "text": "And when he had gone a little further from there, he saw James the son of Zebedee, and John his brother, who also were in the ship mending their nets.", "words": [[0, 123214], [4, 123347], [9, 123487], [12, 123667], [16, 123767], [21, 124007], [23, 124167], [30, 124327], [38, 124727], [43, 125007], [50, 125727], [53, 125847], [57, 126087], [63, 126527], [67, 126767], [71, 127007], [74, 127127], [83, 127787], [87, 128247], [92, 128507], [96, 128707], [105, 129027], [109, 129307], [114, 129647], [119, 129907], [122, 130027], [126, 130127], [131, 130407], [139, 130847], [145, 131087]]}, {"verse": 20, "start": 132073, "end": 138452, "text": "And immediately he called them: and they left their father Zebedee in the ship with the hired servants, and went after him.", "words": [[0, 132073], [4, 132210], [16, 132570], [19, 132930], [26, 133190], [32, 133832], [36, 133957], [41, 134057], [46, 134277], [52, 134457], [59, 134797], [67, 135437], [70, 135577], [74, 135697], [79, 135917], [84, 136137], [88, 136257], [94, 136517], [104, 136957], [108, 137517], [113, 137697], [119, 138037]]}, {"verse": 21, "start": 138902, "end": 145273, "text": "And they went into Capernaum; and immediately on the sabbath day he entered into the synagogue, and taught.", "words": [[0, 138902], [4, 139047], [9, 139147], [14, 139327], [19, 139884], [30, 140671], [34, 140817], [46, 141257], [49, 141637], [53, 141797], [61, 142117], [65, 142497], [68, 142717], [76, 143097], [81, 143397], [85, 143577], [96, 144077], [100, 144677]]}, {"verse": 22, "start": 145723, "end": 151917, "text": "And they were astonished at his doctrine: for he taught them as one that had authority, and not as the scribes.", "words": [[0, 145723], [4, 145868], [9, 145988], [14, 146188], [25, 146868], [28, 147008], [32, 147128], [42, 148102], [46, 148209], [49, 148349], [56, 148629], [61, 148869], [64, 149049], [68, 149289], [73, 149489], [77, 149649], [88, 150169], [92, 150569], [96, 150769], [99, 150969], [103, 151109]]}, {"verse": 23, "start": 152367, "end": 157006, "text": "And there was in their synagogue a man with an unclean spirit; and he cried out,", "words": [[0, 152367], [4, 152498], [10, 152658], [14, 152918], [17, 153138], [23, 153258], [33, 153718], [35, 154038], [39, 154238], [44, 154478], [47, 154638], [55, 155158], [63, 156097], [67, 156206], [70, 156306], [76, 156626]]}, {"verse": 24, "start": 157456, "end": 166276, "text": "Saying, Let us alone; what have we to do with you, you Jesus of Nazareth? are you come to destroy us? I know you who you are, the Holy One of God.", "words": [[0, 157456], [8, 158332], [12, 158503], [15, 158683], [22, 159510], [27, 159645], [32, 159785], [35, 159925], [38, 160045], [41, 160165], [46, 160365], [51, 160685], [55, 160805], [61, 161105], [64, 161345], [74, 162186], [78, 162289], [82, 162409], [87, 162589], [90, 162749], [98, 163049], [102, 163813], [104, 163938], [109, 164138], [113, 164337], [117, 164498], [121, 164638], [126, 165177], [130, 165258], [135, 165498], [139, 165718], [142, 165818]]}, {"verse": 25, "start": 166626, "end": 171015, "text": "And Jesus rebuked him, saying, Be quiet, and come out of him.", "words": [[0, 166626], [4, 166771], [10, 167111], [18, 167851], [23, 168091], [31, 168828], [34, 169038], [41, 169498], [45, 170038], [50, 170278], [54, 170518], [57, 170658]]}, {"verse": 26, "start": 171365, "end": 176351, "text": "And when the unclean spirit had torn him, and cried with a loud voice, he came out of him.", "words": [[0, 171365], [4, 171492], [9, 171632], [13, 171812], [21, 172272], [28, 172652], [32, 172892], [37, 173192], [42, 173432], [46, 173632], [52, 173992], [57, 174192], [59, 174292], [64, 174532], [71, 175352], [74, 175472], [79, 175672], [83, 175932], [86, 176052]]}, {"verse": 27, "start": 176801, "end": 188894, "text": "And they were all amazed, so that they questioned among themselves, saying, What thing is this? what new doctrine is this? for with authority commands he even the unclean spirits, and they do obey him.", "words": [[0, 176801], [4, 177176], [9, 177316], [14, 177476], [18, 177736], [26, 178436], [29, 178776], [34, 178956], [39, 179076], [50, 179556], [56, 179856], [68, 180776], [76, 181567], [81, 181690], [87, 181890], [90, 182050], [96, 182805], [101, 182929], [105, 183109], [114, 183509], [117, 183769], [123, 184528], [127, 184615], [132, 184755], [142, 185155], [151, 185615], [154, 185935], [159, 186275], [163, 186495], [171, 186995], [180, 187355], [184, 187715], [189, 187875], [192, 188095], [197, 188475]]}, {"verse": 28, "start": 189244, "end": 193886, "text": "And immediately his fame spread abroad throughout all the region round about Galilee.", "words": [[0, 189244], [4, 189396], [16, 189716], [20, 190156], [25, 190496], [32, 190876], [39, 191356], [50, 191696], [54, 192056], [58, 192196], [65, 192496], [71, 192816], [77, 193136]]}, {"verse": 29, "start": 194336, "end": 201497, "text": "And forthwith, when they were come out of the synagogue, they entered into the house of Simon and Andrew, with James and John.", "words": [[0, 194336], [4, 194450], [15, 195070], [20, 195350], [25, 195490], [30, 195630], [35, 195850], [39, 196050], [42, 196150], [46, 196270], [57, 196690], [62, 197270], [70, 197570], [75, 197830], [79, 197970], [85, 198210], [88, 198390], [94, 198730], [98, 198990], [106, 199410], [111, 199690], [117, 200030], [121, 200270]]}, {"verse": 30, "start": 201947, "end": 206391, "text": "But Simon’s wife’s mother lay sick of a fever, and immediately they tell him of her.", "words": [[0, 201947], [4, 202100], [12, 202620], [19, 202960], [26, 203200], [30, 203440], [35, 203700], [38, 203860], [40, 203940], [47, 204660], [51, 204880], [63, 205240], [68, 205620], [73, 205900], [77, 206020], [80, 206200]]}, {"verse": 31, "start": 206841, "end": 213236, "text": "And he came and took her by the hand, and lifted her up; and immediately the fever left her, and she ministered to them.", "words": [[0, 206841], [4, 206970], [7, 207090], [12, 207330], [16, 207570], [21, 207750], [25, 207850], [28, 208030], [32, 208170], [38, 208550], [42, 208990], [49, 209270], [53, 209530], [57, 210156], [61, 210284], [73, 210604], [77, 210984], [83, 211204], [88, 211564], [93, 211764], [97, 212004], [101, 212184], [112, 212784], [115, 212884]]}, {"verse": 32, "start": 213686, "end": 219024, "text": "And at even, when the sun did set, they brought to him all that were diseased, and them that were demon-possessed.", "words": [[0, 213686], [4, 213778], [7, 213908], [13, 214088], [18, 214288], [22, 214448], [26, 214688], [30, 214908], [35, 215388], [40, 215468], [48, 215688], [51, 215908], [55, 216108], [59, 216348], [64, 216528], [69, 216648], [79, 217288], [83, 217488], [88, 217688], [93, 217908], [98, 218502]]}, {"verse": 33, "start": 219474, "end": 222504, "text": "And all the city was gathered together at the door.", "words": [[0, 219474], [4, 219588], [8, 219888], [12, 220088], [17, 220408], [21, 220688], [30, 221108], [39, 221528], [42, 221788], [46, 221908]]}, {"verse": 34, "start": 222954, "end": 232028, "text": "And he healed many that were sick of various diseases, and cast out many demons; and did not allow the demons to speak, because they knew him.", "words": [[0, 222954], [4, 223081], [7, 223201], [14, 223581], [19, 223961], [24, 224241], [29, 224421], [34, 224741], [37, 224941], [45, 225281], [55, 226271], [59, 226601], [64, 227001], [68, 227301], [73, 227581], [81, 228707], [85, 228829], [89, 228989], [93, 229169], [99, 229549], [103, 229769], [110, 230049], [113, 230329], [120, 230669], [128, 231189], [133, 231449], [138, 231689]]}, {"verse": 35, "start": 232478, "end": 240104, "text": "And in the morning, rising up a great while before day, he went out, and departed into a solitary place, and there prayed.", "words": [[0, 232478], [4, 232632], [7, 232732], [11, 232832], [20, 233532], [27, 233912], [30, 234172], [32, 234272], [38, 234472], [44, 234792], [51, 235152], [56, 236012], [59, 236112], [64, 236332], [69, 236592], [73, 236952], [82, 237292], [87, 237612], [89, 237792], [98, 238252], [105, 239212], [109, 239372], [115, 239512]]}, {"verse": 36, "start": 240554, "end": 243406, "text": "And Simon and they that were with him followed after him.", "words": [[0, 240554], [4, 240681], [10, 241081], [14, 241401], [19, 241581], [24, 241781], [29, 241921], [34, 242181], [38, 242341], [47, 242721], [53, 243081]]}, {"verse": 37, "start": 243856, "end": 247330, "text": "And when they had found him, they said to him, All men seek for you.", "words": [[0, 243856], [4, 243970], [9, 244130], [14, 244310], [18, 244430], [24, 244670], [29, 244990], [34, 245070], [39, 245290], [42, 245490], [47, 246067], [51, 246301], [55, 246501], [60, 246801], [64, 247081]]}, {"verse": 38, "start": 247680, "end": 254008, "text": "And he said to them, Let us go into the next towns, that I may preach there also: for therefore came I forth.", "words": [[0, 247680], [4, 247811], [7, 247931], [12, 248171], [15, 248371], [21, 248966], [25, 249146], [28, 249286], [31, 249466], [36, 249666], [40, 249826], [45, 250026], [52, 250506], [57, 251026], [59, 251146], [63, 251246], [70, 251526], [76, 251806], [82, 252708], [86, 252795], [96, 253135], [101, 253435], [103, 253595]]}, {"verse": 39, "start": 254358, "end": 259170, "text": "And he preached in their synagogues throughout all Galilee, and cast out demons.", "words": [[0, 254358], [4, 254487], [7, 254567], [16, 254907], [19, 255147], [25, 255267], [36, 256047], [47, 256287], [51, 256707], [60, 257367], [64, 257787], [69, 258127], [73, 258327]]}, {"verse": 40, "start": 259620, "end": 267696, "text": "And there came a leper to him, beseeching him, and kneeling down to him, and saying to him, If you will, you can make me clean.", "words": [[0, 259620], [4, 259749], [10, 259889], [15, 260129], [17, 260309], [23, 260629], [26, 260849], [31, 261389], [42, 261909], [47, 262229], [51, 262269], [60, 262709], [65, 263009], [68, 263229], [73, 263929], [77, 264009], [84, 264329], [87, 264589], [92, 265702], [95, 265887], [99, 266027], [105, 266627], [109, 266727], [113, 266927], [118, 267127], [121, 267307]]}, {"verse": 41, "start": 268046, "end": 276267, "text": "And Jesus, moved with compassion, put forth his hand, and touched him, and says to him, I will; be clean.", "words": [[0, 268046], [4, 268188], [11, 268508], [17, 269108], [22, 269408], [34, 270388], [38, 270828], [44, 271108], [48, 271368], [54, 271768], [58, 272268], [66, 272588], [71, 272868], [75, 273268], [80, 273528], [83, 273768], [88, 274335], [90, 274594], [96, 275444], [99, 275641]]}, {"verse": 42, "start": 276617, "end": 282284, "text": "And as soon as he had spoken, immediately the leprosy departed from him, and he was cleansed.", "words": [[0, 276617], [4, 276749], [7, 276869], [12, 277109], [15, 277249], [18, 277369], [22, 277509], [30, 278429], [42, 278969], [46, 279349], [54, 279889], [63, 280289], [68, 280589], [73, 280829], [77, 281249], [80, 281389], [84, 281549]]}, {"verse": 43, "start": 282734, "end": 286711, "text": "And he sternly charged him, and forthwith sent him away;", "words": [[0, 282734], [4, 283129], [7, 283229], [15, 283809], [23, 284249], [28, 284789], [32, 285049], [42, 285629], [47, 285989], [51, 286189]]}, {"verse": 44, "start": 287161, "end": 297800, "text": "And says to him, See that you say nothing to any man: but go your way, show yourself to the priest, and offer for your cleansing those things which Moses commanded, for a testimony to them.", "words": [[0, 287161], [4, 287286], [9, 287546], [12, 287786], [17, 288739], [21, 288945], [26, 289145], [30, 289265], [34, 289465], [42, 289745], [45, 289985], [49, 290165], [54, 290951], [58, 291050], [61, 291230], [66, 291390], [71, 291950], [76, 292170], [85, 292570], [88, 292730], [92, 292850], [100, 293470], [104, 293550], [110, 293830], [114, 294050], [119, 294170], [129, 294530], [135, 294810], [142, 295110], [148, 295330], [154, 295610], [165, 296550], [169, 296650], [171, 296790], [181, 297130], [184, 297430]]}, {"verse": 45, "start": 298150, "end": 310386, "text": "But he went out, and began to publish it much, and to blaze abroad the matter, so that Jesus could no more openly enter into the city, but was without in desert places: and they came to him from every quarter.", "words": [[0, 298150], [4, 298256], [7, 298376], [12, 298576], [17, 298836], [21, 299436], [27, 299736], [30, 299896], [38, 300176], [41, 300416], [47, 300676], [51, 301176], [54, 301316], [60, 301676], [67, 301956], [71, 302156], [79, 302456], [82, 302936], [87, 303116], [93, 303336], [99, 303656], [102, 303856], [107, 304076], [114, 304496], [120, 304876], [125, 305136], [129, 305296], [135, 306028], [139, 306135], [143, 306375], [151, 306755], [154, 307035], [161, 307295], [169, 308392], [173, 308520], [178, 308640], [183, 308880], [186, 309080], [190, 309220], [195, 309440], [201, 309740]]}]}