{"book": "PSA", "chapter": 37, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 257724, "verses": [{"verse": 1, "start": 300, "end": 7939, "text": "Salmo de David. NO te impacientes a causa de los malignos, ni tengas envidia de los que hacen iniquidad.", "words": [[0, 300], [6, 744], [9, 904], [16, 1868], [19, 2016], [22, 2196], [34, 2856], [36, 3116], [42, 3396], [45, 3616], [49, 3756], [59, 4836], [62, 5156], [69, 5596], [77, 6256], [80, 6376], [84, 6536], [88, 6696], [94, 6996]]}, {"verse": 2, "start": 8289, "end": 13201, "text": "Porque como hierba serán pronto cortados, y decaerán como verdor de renuevo.", "words": [[0, 8289], [7, 8513], [12, 8903], [19, 9293], [25, 9633], [32, 9973], [42, 10793], [44, 11113], [53, 11693], [58, 12063], [65, 12433], [68, 12553]]}, {"verse": 3, "start": 13551, "end": 19596, "text": "Espera en Jehová, y haz bien; vivirás en la tierra, y en verdad serás alimentado.", "words": [[0, 13551], [7, 14190], [10, 14310], [18, 14730], [20, 14910], [24, 15070], [30, 15878], [38, 16323], [41, 16503], [44, 16643], [52, 17083], [54, 17583], [57, 17703], [64, 18063], [70, 18623]]}, {"verse": 4, "start": 19946, "end": 25373, "text": "Pon asimismo tu delicia en Jehová, y él te dará las peticiones de tu corazón.", "words": [[0, 19946], [4, 20428], [13, 20938], [16, 21178], [24, 21778], [27, 21958], [35, 22638], [37, 22958], [40, 23158], [43, 23338], [48, 23638], [52, 23778], [63, 24398], [66, 24578], [69, 24718]]}, {"verse": 5, "start": 25723, "end": 30292, "text": "Encomienda a Jehová tu camino, y espera en él; y él hará.", "words": [[0, 25723], [11, 26407], [13, 26667], [20, 27127], [23, 27227], [31, 27707], [33, 27962], [40, 28402], [43, 28822], [47, 29410], [49, 29570], [52, 29730]]}, {"verse": 6, "start": 30642, "end": 35773, "text": "Y exhibirá tu justicia como la luz, y tus derechos como el medio día.", "words": [[0, 30642], [2, 30932], [11, 31512], [14, 31652], [23, 32332], [28, 32552], [31, 32712], [36, 33032], [38, 33692], [42, 33872], [51, 34292], [56, 34772], [59, 35121], [65, 35470]]}, {"verse": 7, "start": 36123, "end": 44663, "text": "Calla a Jehová, y espera en él: no te alteres con motivo del que prospera en su camino, por el hombre que hace maldades.", "words": [[0, 36123], [6, 36619], [8, 36759], [16, 37279], [18, 37439], [25, 37759], [28, 38139], [32, 38756], [35, 38905], [38, 39065], [46, 39585], [50, 39765], [57, 40145], [61, 40525], [65, 40645], [74, 41305], [77, 41385], [80, 41565], [88, 42525], [92, 42665], [95, 42825], [102, 43105], [106, 43345], [111, 43585]]}, {"verse": 8, "start": 45013, "end": 51325, "text": "Déjate de la ira, y depón el enojo: no te excites en manera alguna a hacer lo malo.", "words": [[0, 45013], [7, 45561], [10, 45701], [13, 45841], [18, 46401], [20, 46601], [26, 47021], [29, 47281], [36, 48165], [39, 48292], [42, 48492], [50, 49032], [53, 49252], [60, 49532], [67, 49992], [69, 50212], [75, 50432], [78, 50652]]}, {"verse": 9, "start": 51675, "end": 58207, "text": "Porque los malignos serán destruidos, pero los que esperan en Jehová, ellos heredarán la tierra.", "words": [[0, 51675], [7, 51881], [11, 52061], [20, 52681], [26, 52981], [38, 53961], [43, 54161], [47, 54361], [51, 54561], [59, 55041], [62, 55161], [70, 55921], [76, 56321], [86, 57321], [89, 57481]]}, {"verse": 10, "start": 58557, "end": 64549, "text": "Pues de aquí a poco no será el malo: y contemplarás sobre su lugar, y no aparecerá.", "words": [[0, 58557], [5, 58700], [8, 58820], [13, 59040], [15, 59260], [20, 59480], [23, 59720], [28, 59980], [31, 60180], [37, 60833], [39, 60955], [52, 62055], [58, 62495], [61, 62795], [68, 63195], [70, 63475], [73, 63635]]}, {"verse": 11, "start": 64899, "end": 71086, "text": "Pero los mansos heredarán la tierra, y se recrearán con abundancia de paz.", "words": [[0, 64899], [5, 65199], [9, 65359], [16, 66379], [26, 67219], [29, 67379], [37, 67899], [39, 68359], [42, 68519], [52, 69399], [56, 69559], [67, 70359], [70, 70499]]}, {"verse": 12, "start": 71436, "end": 76656, "text": "Maquina el impío contra el justo, y cruje sobre él sus dientes.", "words": [[0, 71436], [8, 72021], [11, 72341], [17, 73001], [24, 73401], [27, 73601], [34, 74021], [36, 74541], [42, 75021], [48, 75321], [51, 75601], [55, 75781]]}, {"verse": 13, "start": 77006, "end": 80579, "text": "El Señor se reirá de él; porque ve que viene su día.", "words": [[0, 77006], [3, 77149], [9, 77529], [12, 77909], [18, 78289], [21, 78449], [25, 79039], [32, 79255], [35, 79435], [39, 79575], [45, 79835], [48, 80075]]}, {"verse": 14, "start": 80929, "end": 92169, "text": "Los impíos desenvainaron espada, y tensaron su arco, para derribar al pobre y al necesitado, para matar a los de recto proceder.", "words": [[0, 80929], [4, 81037], [11, 81917], [25, 82797], [33, 83397], [35, 83837], [44, 84417], [47, 84677], [53, 85117], [58, 85637], [67, 86497], [70, 86657], [76, 87717], [78, 88057], [81, 88197], [93, 89097], [98, 89537], [104, 89837], [106, 90077], [110, 90350], [113, 90624], [119, 90897]]}, {"verse": 15, "start": 92519, "end": 97975, "text": "La espada de ellos entrará en su mismo corazón, y su arco será quebrado.", "words": [[0, 92519], [3, 92665], [10, 93245], [13, 93425], [19, 93805], [27, 94685], [30, 94905], [33, 95125], [39, 95485], [48, 96025], [50, 96390], [53, 96590], [58, 96930], [63, 97190]]}, {"verse": 16, "start": 98325, "end": 102315, "text": "Mejor es lo poco del justo, que las riquezas de muchos pecadores.", "words": [[0, 98325], [6, 98652], [9, 98772], [12, 98892], [17, 99292], [21, 99692], [28, 100092], [32, 100192], [36, 100332], [45, 100912], [48, 101112], [55, 101332]]}, {"verse": 17, "start": 102665, "end": 108769, "text": "Porque los brazos de los impíos serán quebrados: mas el que sostiene a los justos es Jehová.", "words": [[0, 102665], [7, 103065], [11, 103445], [18, 103925], [21, 104065], [25, 104425], [32, 104785], [38, 105125], [49, 106167], [53, 106354], [56, 106614], [60, 106774], [69, 107354], [71, 107648], [75, 107943], [82, 108237], [85, 108531]]}, {"verse": 18, "start": 109119, "end": 114342, "text": "Conoce Jehová los días de los perfectos: y la heredad de ellos será para siempre.", "words": [[0, 109119], [7, 109544], [14, 110004], [18, 110144], [23, 110424], [26, 110624], [30, 110744], [41, 111923], [43, 112041], [46, 112181], [54, 112701], [57, 112861], [63, 113081], [68, 113361], [73, 113601]]}, {"verse": 19, "start": 114692, "end": 120241, "text": "No serán avergonzados en el mal tiempo; y en los días de hambre serán hartos.", "words": [[0, 114692], [3, 114920], [9, 115360], [22, 116260], [25, 116480], [28, 116640], [32, 116780], [40, 117714], [42, 117845], [45, 117965], [49, 118105], [54, 118345], [57, 118545], [64, 118905], [70, 119345]]}, {"verse": 20, "start": 120591, "end": 129754, "text": "Mas los impíos perecerán, y los enemigos de Jehová como la grasa de los carneros serán consumidos: se disiparán como humo.", "words": [[0, 120591], [4, 120738], [8, 120898], [15, 121638], [26, 122558], [28, 123118], [32, 123238], [41, 123758], [44, 123918], [51, 124418], [56, 124578], [59, 124738], [65, 125118], [68, 125278], [72, 125708], [81, 126138], [87, 126738], [99, 128034], [102, 128175], [112, 128915], [117, 129115]]}, {"verse": 21, "start": 130104, "end": 135501, "text": "El impío toma prestado, y no paga; mas el justo tiene misericordia, y da.", "words": [[0, 130104], [3, 130243], [9, 130803], [14, 131103], [24, 131803], [26, 131923], [29, 132043], [35, 132868], [39, 132954], [42, 133041], [48, 133541], [54, 133961], [68, 135021], [70, 135161]]}, {"verse": 22, "start": 135851, "end": 141662, "text": "Porque los benditos de él heredarán la tierra; y los malditos de él serán destruidos.", "words": [[0, 135851], [7, 136013], [11, 136213], [20, 136773], [23, 136973], [26, 137193], [36, 137893], [39, 138013], [47, 138934], [49, 139039], [53, 139179], [62, 139859], [65, 140059], [68, 140259], [74, 140679]]}, {"verse": 23, "start": 142012, "end": 146721, "text": "Por Jehová son ordenados los pasos del hombre, y aprueba su camino.", "words": [[0, 142012], [4, 142176], [11, 142696], [15, 142896], [25, 143676], [29, 143876], [35, 144336], [39, 144496], [47, 144816], [49, 145336], [57, 145836], [60, 146036]]}, {"verse": 24, "start": 147071, "end": 152545, "text": "Cuando caiga el hombre, no quedará postrado; porque Jehová sostiene su mano.", "words": [[0, 147071], [7, 147255], [13, 147835], [16, 148015], [24, 148335], [27, 148895], [35, 149335], [45, 150396], [52, 150641], [59, 151201], [68, 151741], [71, 151941]]}, {"verse": 25, "start": 152895, "end": 160017, "text": "Joven fui, y he envejecido, y no he visto justo desamparado, ni su descendencia que mendigue pan.", "words": [[0, 152895], [6, 153237], [11, 153517], [13, 154197], [16, 154357], [28, 155117], [30, 155637], [33, 155797], [36, 155877], [42, 156137], [48, 156457], [61, 157117], [64, 157777], [67, 157957], [80, 158797], [84, 159097], [93, 159397]]}, {"verse": 26, "start": 160367, "end": 166097, "text": "En todo tiempo tiene misericordia, y presta; y su descendencia es para bendición.", "words": [[0, 160367], [3, 160536], [8, 160816], [15, 161216], [21, 161556], [35, 162436], [37, 162556], [45, 163516], [47, 163776], [50, 163896], [63, 164836], [66, 164996], [71, 165216]]}, {"verse": 27, "start": 166447, "end": 170208, "text": "Apártate del mal, y haz el bien, y vivirás para siempre.", "words": [[0, 166447], [9, 167134], [13, 167354], [18, 167634], [20, 167874], [24, 168114], [27, 168274], [33, 168534], [35, 168839], [43, 169319], [48, 169519]]}, {"verse": 28, "start": 170558, "end": 181098, "text": "Porque Jehová ama la rectitud, y no desampara sus santos: para siempre serán guardados; mas la descendencia de los impíos será extirpada.", "words": [[0, 170558], [7, 170840], [14, 171440], [18, 171680], [21, 171900], [31, 172600], [33, 173140], [36, 173320], [46, 173980], [50, 174160], [58, 175187], [63, 175353], [71, 175653], [77, 176293], [88, 177334], [92, 177334], [95, 177483], [108, 178343], [111, 178463], [115, 178583], [122, 179383], [127, 179803]]}, {"verse": 29, "start": 181448, "end": 186191, "text": "Los justos heredarán la tierra, y vivirán para siempre sobre ella.", "words": [[0, 181448], [4, 181644], [11, 182244], [21, 182964], [24, 183104], [32, 183564], [34, 184084], [42, 184564], [47, 184784], [55, 185104], [61, 185604]]}, {"verse": 30, "start": 186541, "end": 191176, "text": "La boca del justo hablará sabiduría; y su lengua proferirá juicio.", "words": [[0, 186541], [3, 186669], [8, 186869], [12, 187089], [18, 187429], [26, 187949], [37, 189111], [39, 189218], [42, 189358], [49, 189858], [59, 190358]]}, {"verse": 31, "start": 191526, "end": 197157, "text": "La ley de su Dios está en su corazón; por tanto sus pasos no vacilarán.", "words": [[0, 191526], [3, 191806], [7, 192106], [10, 192286], [13, 192446], [18, 192766], [23, 193126], [26, 193286], [29, 193446], [38, 194561], [42, 194706], [48, 195006], [52, 195306], [58, 195826], [61, 196126]]}, {"verse": 32, "start": 197507, "end": 200859, "text": "Acecha el impío al justo, y procura matarlo.", "words": [[0, 197817], [7, 198157], [10, 198507], [16, 198857], [19, 198997], [26, 199357], [28, 199597], [36, 200017]]}, {"verse": 33, "start": 201209, "end": 206524, "text": "Jehová no lo dejará en sus manos, ni lo condenará cuando le juzguen.", "words": [[0, 201209], [7, 201754], [10, 202194], [13, 202314], [20, 202814], [23, 202914], [27, 203054], [34, 204034], [37, 204314], [40, 204474], [50, 205134], [57, 205354], [60, 205654]]}, {"verse": 34, "start": 206874, "end": 215661, "text": "Espera en Jehová, y guarda su camino, y él te ensalzará para heredar la tierra: cuando serán talados los pecadores, lo verás.", "words": [[0, 207077], [7, 207307], [10, 207467], [18, 207867], [20, 207947], [27, 208307], [30, 208427], [38, 209147], [40, 209467], [43, 209627], [46, 209807], [56, 210627], [61, 210887], [69, 211407], [72, 211547], [80, 212478], [87, 212641], [93, 213061], [101, 213581], [105, 214211], [116, 214841], [119, 215081]]}, {"verse": 35, "start": 216011, "end": 222297, "text": "Vi yo al impío sumamente enaltecido, y que se extendía como un laurel verde.", "words": [[0, 216207], [3, 216435], [6, 216663], [9, 216891], [15, 217119], [25, 217959], [37, 218799], [39, 219379], [43, 219539], [46, 219739], [55, 220699], [60, 220979], [63, 221179], [70, 221765]]}, {"verse": 36, "start": 222647, "end": 228331, "text": "Pero se pasó, y he aquí no aparece; y lo busqué, y no fue hallado.", "words": [[0, 222647], [5, 222811], [8, 222951], [14, 223391], [16, 223751], [19, 224111], [24, 224391], [27, 224991], [36, 226073], [38, 226188], [41, 226308], [49, 226788], [51, 227308], [54, 227448], [58, 227668]]}, {"verse": 37, "start": 228681, "end": 234557, "text": "Considera al íntegro, y mira al justo: que el final de cada uno de ellos es paz.", "words": [[0, 228681], [10, 229464], [13, 229684], [22, 230384], [24, 230964], [29, 231244], [32, 231384], [39, 232248], [43, 232353], [46, 232433], [52, 232733], [55, 232953], [60, 233093], [64, 233393], [67, 233553], [73, 233813], [76, 234033]]}, {"verse": 38, "start": 234907, "end": 241242, "text": "Mas los transgresores fueron todos a una destruidos: el final de los impíos fue talado.", "words": [[0, 234907], [4, 235193], [8, 235573], [22, 236413], [29, 236773], [35, 237066], [37, 237360], [41, 237653], [53, 238992], [56, 239252], [62, 239592], [65, 239752], [69, 240092], [76, 240432], [80, 240592]]}, {"verse": 39, "start": 241592, "end": 247487, "text": "Pero la salvación de los justos es de Jehová, y él es su fortaleza en el tiempo de angustia.", "words": [[0, 241592], [5, 241738], [8, 241898], [18, 242518], [21, 242678], [25, 242778], [32, 243298], [35, 243438], [38, 243598], [46, 244298], [48, 244538], [51, 244718], [54, 244838], [57, 244998], [67, 245798], [70, 245938], [73, 246078], [80, 246438], [83, 246698]]}, {"verse": 40, "start": 247837, "end": 257324, "text": "Y Jehová los ayudará, y los librará: y los libertará de los impíos, y los salvará, por cuanto en él esperaron.", "words": [[0, 247837], [2, 247983], [9, 248463], [13, 248583], [22, 249203], [24, 249663], [28, 249863], [37, 251038], [39, 251162], [43, 251342], [53, 252182], [56, 252302], [60, 252422], [68, 253182], [70, 253762], [74, 253902], [83, 254662], [87, 255242], [94, 255682], [97, 255922], [100, 256122]]}]}