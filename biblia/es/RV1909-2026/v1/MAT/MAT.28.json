[76, 107385]]}, {"verse": 14, "start": 108459, "end": 113553, "text": "Y si esto llega a oídos del gobernador, nosotros le persuadiremos, y os pondremos a salvo.", "words": [[0, 108459], [2, 108559], [5, 108679], [10, 108919], [16, 109179], [18, 109339], [24, 109699], [28, 109819], [40, 110799], [49, 111079], [52, 111379], [67, 112179], [69, 112339], [72, 112459], [82, 112899], [84, 113059]]}, {"verse": 15, "start": 113833, "end": 122162, "text": "Y ellos, tomando el dinero, hicieron como estaban instruidos: y este dicho fue divulgado entre los judíos hasta el día de hoy.", "words": [[0, 113833], [2, 113995], [9, 114235], [17, 114815], [20, 114935], [28, 115395], [37, 116415], [42, 116675], [50, 117015], [62, 118335], [64, 118535], [69, 118735], [75, 119015], [79, 119255], [89, 119955], [95, 120215], [99, 120435], [106, 121015], [112, 121275], [115, 121435], [119, 121595], [122, 121775]]}, {"verse": 16, "start": 122512, "end": 128405, "text": "Pero los once discípulos se fueron a Galilea, al monte donde Jesús les había ordenado.", "words": [[0, 122512], [5, 122654], [9, 122894], [14, 123134], [25, 123954], [28, 124334], [35, 124614], [37, 124814], [46, 125494], [49, 125734], [55, 126074], [61, 126374], [67, 126814], [71, 127214], [77, 127554]]}, {"verse": 17, "start": 128755, "end": 132956, "text": "Y como le vieron, le adoraron: pero algunos dudaban.", "words": [[0, 128755], [2, 128862], [7, 129102], [10, 129282], [18, 130102], [21, 130302], [31, 131370], [36, 131695], [44, 132035]]}, {"verse": 18, "start": 133306, "end": 140185, "text": "Y llegando Jesús, les habló, diciendo: Toda autoridad me ha sido dada en el cielo y en la tierra.", "words": [[0, 133306], [2, 133412], [11, 133812], [18, 134212], [22, 134612], [29, 135132], [39, 136232], [44, 136517], [54, 137117], [57, 137377], [60, 137517], [65, 137777], [70, 138217], [73, 138357], [76, 138497], [82, 138917], [84, 139157], [87, 139257], [90, 139417]]}, {"verse": 19, "start": 140535, "end": 150507, "text": "Por