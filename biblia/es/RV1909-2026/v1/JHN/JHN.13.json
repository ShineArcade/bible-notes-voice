{"book": "JHN", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 313527, "verses": [{"verse": 1, "start": 300, "end": 13605, "text": "Antes de la fiesta de la Pascua, sabiendo Jesús que su hora había venido para que pasase de este mundo al Padre, como había amado a los suyos que estaban en el mundo, los amó hasta el fin.", "words": [[0, 300], [6, 642], [9, 822], [12, 942], [19, 1362], [22, 1482], [25, 1602], [33, 2562], [42, 3222], [48, 3642], [52, 4102], [55, 4342], [60, 4702], [66, 5082], [73, 5562], [78, 5822], [82, 6002], [89, 6522], [92, 6682], [97, 6942], [103, 7242], [106, 7422], [113, 8368], [118, 8617], [124, 8957], [130, 9617], [132, 9717], [136, 9857], [142, 10337], [146, 10457], [154, 10757], [157, 10977], [160, 11137], [167, 11877], [171, 12277], [175, 12717], [181, 12977], [184, 13137]]}, {"verse": 2, "start": 14055, "end": 23247, "text": "Y la cena acabada, como el diablo ya había metido en el corazón de Judas, hijo de Simón Iscariote, que le entregase,", "words": [[0, 14055], [2, 14181], [5, 14321], [10, 14601], [19, 15321], [24, 15701], [27, 15941], [34, 16421], [37, 16701], [43, 16941], [50, 17541], [53, 17661], [56, 17781], [64, 18201], [67, 18441], [74, 19221], [79, 19601], [82, 19841], [88, 20421], [99, 22161], [103, 22241], [106, 22381]]}, {"verse": 3, "start": 23697, "end": 31683, "text": "Sabiendo Jesús que el Padre le había dado todas las cosas en las manos, y que había salido de Dios, y a Dios iba,", "words": [[0, 23697], [9, 24076], [15, 24496], [19, 25056], [22, 25216], [28, 25656], [31, 25776], [37, 26036], [42, 26376], [48, 26716], [52, 27016], [58, 27316], [61, 27576], [65, 27716], [72, 28136], [74, 28556], [78, 28696], [84, 28916], [91, 29456], [94, 29636], [100, 29976], [102, 30636], [104, 30756], [109, 30976]]}, {"verse": 4, "start": 32133, "end": 38135, "text": "Se levanta de la cena, y se quita su ropa, y tomando una toalla, se la ató a la cintura.", "words": [[0, 32133], [3, 32293], [11, 32833], [14, 32933], [17, 33053], [23, 33393], [25, 33653], [28, 33813], [34, 34113], [37, 34293], [43, 34773], [45, 34973], [53, 35433], [57, 35593], [65, 36593], [68, 36693], [71, 36900], [75, 37106], [77, 37313], [80, 37393]]}, {"verse": 5, "start": 38585, "end": 48727, "text": "Luego puso agua en una palangana, y comenzó a lavar los pies de los discípulos, y a limpiarlos con la toalla que llevaba atada a la cintura.", "words": [[0, 38585], [6, 38869], [11, 39589], [16, 39969], [19, 40249], [23, 40429], [34, 41189], [36, 41869], [44, 42409], [46, 42529], [52, 42869], [56, 43009], [61, 43369], [64, 43589], [68, 43729], [80, 44449], [82, 44669], [84, 44769], [95, 45549], [99, 45809], [102, 45989], [109, 46409], [113, 46609], [121, 47029], [127, 47629], [129, 47849], [132, 47949]]}, {"verse": 6, "start": 49177, "end": 55672, "text": "Entonces vino a Simón Pedro; y Pedro le dice: ¿Señor, tú me lavas los pies?", "words": [[0, 49177], [9, 49741], [14, 50441], [16, 50681], [22, 51081], [29, 52066], [31, 52212], [37, 52532], [40, 52752], [46, 53574], [54, 53982], [57, 54042], [60, 54162], [66, 54442], [70, 54582]]}, {"verse": 7, "start": 56022, "end": 62941, "text": "Respondió Jesús, y le dijo: Lo que yo hago, tú no entiendes ahora; pero lo entenderás después.", "words": [[0, 56162], [10, 56622], [17, 56922], [19, 57162], [22, 57262], [28, 58040], [31, 58260], [35, 58420], [38, 58640], [44, 59320], [47, 59500], [50, 59660], [60, 60300], [67, 61267], [72, 61409], [75, 61589], [86, 62269]]}, {"verse": 8, "start": 63391, "end": 71304, "text": "Le dice Pedro: No me lavarás los pies jamás. Le respondió Jesús: Si no te lavo, no tendrás parte conmigo.", "words": [[0, 63391], [3, 63516], [8, 63756], [15, 64584], [18, 64744], [21, 64884], [29, 65364], [33, 65504], [38, 65764], [45, 66752], [48, 66880], [58, 67460], [65, 68417], [68, 68562], [71, 68702], [74, 68842], [80, 69482], [83, 69722], [91, 70122], [97, 70462]]}, {"verse": 9, "start": 71754, "end": 76600, "text": "Le dice Simón Pedro: Señor, no sólo mis pies, sino también las manos y la cabeza.", "words": [[0, 71754], [3, 71896], [8, 72136], [14, 72556], [21, 73345], [28, 73760], [31, 73840], [36, 74060], [40, 74240], [46, 74780], [51, 74920], [59, 75300], [63, 75480], [69, 75780], [71, 75960], [74, 76060]]}, {"verse": 10, "start": 76950, "end": 86891, "text": "Le dice Jesús: El que se ha bañado, no necesita sino que lave los pies, pero está todo limpio: y vosotros limpios estáis, aunque no todos.", "words": [[0, 76950], [3, 77153], [8, 77393], [15, 78520], [18, 78647], [22, 78787], [25, 78927], [28, 79067], [36, 79587], [39, 79767], [48, 80327], [53, 80627], [57, 80847], [62, 81167], [66, 81287], [72, 82187], [77, 82367], [82, 82547], [87, 82787], [95, 83846], [97, 83952], [106, 84392], [114, 84952], [122, 85792], [129, 85992], [132, 86232]]}, {"verse": 11, "start": 87341, "end": 92980, "text": "Porque sabía quién le había de entregar; por eso dijo: No estáis limpios todos.", "words": [[0, 87341], [7, 87804], [13, 88264], [19, 88524], [22, 88784], [28, 89004], [31, 89164], [41, 90137], [45, 90260], [49, 90460], [55, 91340], [58, 91445], [65, 91825], [73, 92305]]}, {"verse": 12, "start": 93430, "end": 102561, "text": "Así que, después que les hubo lavado los pies, y tomado su ropa, volviéndose a sentar a la mesa, les dijo: ¿Sabéis lo que os he hecho?", "words": [[0, 93430], [4, 93675], [9, 93875], [17, 94275], [21, 94495], [25, 94675], [30, 95135], [37, 95555], [41, 95695], [47, 95975], [49, 96255], [56, 96655], [59, 96855], [65, 97535], [77, 98415], [79, 98595], [86, 99075], [88, 99135], [91, 99255], [97, 99615], [101, 99695], [107, 100780], [115, 101243], [118, 101563], [122, 101743], [125, 101903], [128, 102043]]}, {"verse": 13, "start": 103011, "end": 109145, "text": "Vosotros me llamáis, Maestro, y, Señor: y decís bien; porque lo soy.", "words": [[0, 103011], [9, 103535], [12, 103755], [21, 104235], [30, 104975], [33, 105615], [40, 106656], [42, 106784], [48, 107264], [54, 108313], [61, 108467], [64, 108620]]}, {"verse": 14, "start": 109595, "end": 117923, "text": "Pues si yo, el Señor y el Maestro, he lavado vuestros pies, vosotros también debéis lavar los pies los unos a los otros.", "words": [[0, 109595], [5, 109739], [8, 109919], [12, 110519], [15, 110539], [21, 110959], [23, 111279], [26, 111459], [35, 112499], [38, 112799], [45, 113219], [54, 113639], [60, 114479], [69, 114899], [77, 115159], [84, 115639], [90, 115999], [94, 116139], [99, 116399], [103, 116679], [108, 116959], [110, 117179], [114, 117339]]}, {"verse": 15, "start": 118373, "end": 124088, "text": "Porque ejemplo os he dado, para que como yo os he hecho, vosotros también hagáis.", "words": [[0, 118373], [7, 118615], [15, 119075], [18, 119355], [21, 119455], [27, 119695], [32, 119995], [36, 120195], [41, 120515], [44, 120835], [47, 121075], [50, 121315], [57, 122275], [66, 122795], [74, 123135]]}, {"verse": 16, "start": 124538, "end": 133144, "text": "De cierto, de cierto os digo: El siervo no es mayor que su señor, ni el apóstol es mayor que el que le envió.", "words": [[0, 124799], [3, 125091], [11, 125383], [14, 125675], [21, 125967], [24, 126207], [30, 126966], [33, 127123], [40, 127743], [43, 128303], [46, 128543], [52, 128963], [56, 129143], [59, 129323], [66, 130163], [69, 130303], [72, 130503], [80, 131243], [83, 131503], [89, 131903], [93, 132183], [96, 132323], [100, 132463], [103, 132603]]}, {"verse": 17, "start": 133594, "end": 137988, "text": "Si sabéis estas cosas, bienaventurados seréis, si las hacéis.", "words": [[0, 133594], [3, 133717], [10, 134137], [16, 134337], [23, 135237], [39, 136077], [47, 136657], [50, 137137], [54, 137317]]}, {"verse": 18, "start": 138438, "end": 149683, "text": "No hablo de todos vosotros: yo sé los que he elegido: pero para que se cumpla la Escritura: El que come pan conmigo, levantó contra mí su talón.", "words": [[0, 138438], [3, 138806], [9, 139226], [12, 139386], [18, 139686], [28, 141072], [31, 141319], [34, 141529], [38, 141739], [42, 141939], [45, 142119], [54, 143143], [59, 143290], [64, 143530], [68, 143710], [71, 143870], [78, 144550], [81, 144710], [92, 145945], [95, 146073], [99, 146193], [104, 146433], [108, 146733], [117, 147473], [125, 148333], [132, 148573], [135, 148853], [138, 148993]]}, {"verse": 19, "start": 150133, "end": 156338, "text": "Desde ahora os lo digo antes que se haga, para que cuando se haga, creáis que yo soy.", "words": [[0, 150133], [6, 150358], [12, 150698], [15, 150918], [18, 151078], [23, 151358], [29, 151858], [33, 152098], [36, 152298], [42, 152998], [47, 153398], [51, 153558], [58, 153818], [61, 154158], [67, 154938], [74, 155458], [78, 155638], [81, 155818]]}, {"verse": 20, "start": 156788, "end": 166446, "text": "De cierto, de cierto os digo: El que recibe al que yo envío, a mí recibe; y quien me recibe a mí, recibe al que me envió.", "words": [[0, 157049], [3, 157341], [11, 157633], [14, 157925], [21, 158217], [24, 158457], [30, 159216], [33, 159401], [37, 159521], [44, 160141], [47, 160281], [51, 160421], [54, 160641], [61, 161161], [63, 161361], [66, 161621], [74, 163303], [76, 163427], [82, 163687], [85, 163967], [92, 164467], [94, 164547], [98, 165067], [105, 165547], [108, 165647], [112, 165787], [115, 165927]]}, {"verse": 21, "start": 166896, "end": 176516, "text": "Cuando hubo dicho Jesús esto, fue conmovido en el espíritu, y declaró, y dijo: De cierto, de cierto os digo, que uno de vosotros me ha de entregar.", "words": [[0, 166896], [7, 167081], [12, 167461], [18, 167681], [24, 168021], [30, 168701], [34, 168721], [44, 169561], [47, 169681], [50, 169801], [60, 170421], [62, 170561], [71, 171141], [73, 171281], [79, 172291], [82, 172551], [90, 172811], [93, 173071], [100, 173331], [103, 173531], [109, 173851], [113, 174431], [117, 174631], [120, 174811], [129, 175291], [132, 175551], [135, 175671], [138, 175791]]}, {"verse": 22, "start": 176966, "end": 182223, "text": "Entonces los discípulos se miraban los unos a los otros, sin saber de quién hablaba.", "words": [[0, 176966], [9, 177608], [13, 177928], [24, 178588], [27, 178808], [35, 179168], [39, 179348], [44, 179588], [46, 179768], [50, 179928], [57, 180528], [61, 180788], [67, 181148], [70, 181328], [76, 181508]]}, {"verse": 23, "start": 182673, "end": 190186, "text": "Y uno de sus discípulos, al cual Jesús amaba, estaba recostado junto al pecho de Jesús.", "words": [[0, 182673], [2, 182815], [6, 182975], [9, 183135], [13, 183295], [25, 184215], [28, 184495], [33, 184675], [39, 185015], [46, 186135], [53, 186375], [63, 187215], [69, 187435], [72, 187735], [78, 188135], [81, 188275]]}, {"verse": 24, "start": 190636, "end": 196908, "text": "A este, pues, hizo señas Simón Pedro, para que preguntase quién era aquel de quien decía.", "words": [[0, 190636], [2, 190636], [8, 190636], [14, 190636], [19, 191424], [25, 192004], [31, 192364], [38, 193264], [43, 193404], [47, 193544], [58, 194204], [64, 194744], [68, 195244], [74, 195804], [77, 195924], [83, 196104]]}, {"verse": 25, "start": 197358, "end": 203357, "text": "Él entonces recostándose sobre el pecho de Jesús, le dice: Señor, ¿quién es?", "words": [[0, 197358], [3, 197544], [12, 198564], [25, 199524], [31, 199884], [34, 200184], [40, 200564], [43, 200684], [50, 201564], [53, 201644], [59, 202429], [66, 202853], [73, 203033]]}, {"verse": 26, "start": 203707, "end": 212319, "text": "Respondió Jesús: Aquel es, a quien yo dé el pan mojado. Y mojando el pan, lo dio a Judas Iscariote, hijo de Simón.", "words": [[0, 203963], [10, 204243], [17, 205171], [23, 205519], [27, 205799], [29, 206379], [35, 206579], [38, 206746], [41, 206912], [44, 207079], [48, 207419], [56, 208370], [58, 208497], [66, 208957], [69, 209137], [74, 209397], [77, 209637], [81, 209877], [83, 210077], [89, 210237], [100, 211317], [105, 211517], [108, 211717]]}, {"verse": 27, "start": 212769, "end": 219498, "text": "Y tras el bocado Satanás entró en él. Entonces Jesús le dice: Lo que haces, hazlo más pronto.", "words": [[0, 212769], [2, 213176], [7, 213356], [10, 213596], [17, 214016], [25, 214736], [31, 215356], [34, 215576], [38, 216233], [47, 216755], [53, 217335], [56, 217715], [62, 218615], [65, 218741], [69, 218881], [76, 219049], [82, 219216], [86, 219384]]}, {"verse": 28, "start": 219948, "end": 226579, "text": "Pero ninguno de los que estaban a la mesa entendió a qué propósito le dijo esto.", "words": [[0, 221445], [5, 221765], [13, 222705], [16, 222825], [20, 222965], [24, 223105], [32, 223365], [34, 223565], [37, 223665], [42, 223905], [51, 224505], [53, 224705], [57, 224865], [67, 225665], [70, 225805], [75, 226085]]}, {"verse": 29, "start": 227029, "end": 238109, "text": "Porque los unos pensaban, porque Judas tenía la bolsa, que Jesús le decía: Compra lo que necesitamos para la fiesta: o, que diese algo a los pobres.", "words": [[0, 227029], [7, 227253], [11, 227453], [16, 227653], [26, 228833], [33, 229173], [39, 229553], [45, 229953], [48, 230133], [55, 230653], [59, 231113], [65, 231473], [68, 231853], [75, 232837], [82, 233322], [85, 233562], [89, 233702], [101, 234522], [106, 234802], [109, 234982], [117, 235953], [120, 236337], [124, 236527], [130, 236717], [135, 237137], [137, 237277], [141, 237357]]}, {"verse": 30, "start": 238559, "end": 243292, "text": "Como él pues hubo tomado el bocado, salió de inmediato: y era ya noche.", "words": [[0, 238559], [5, 238741], [8, 239101], [13, 239301], [18, 239541], [25, 239941], [28, 240021], [36, 240541], [42, 240881], [45, 241021], [56, 242162], [58, 242328], [62, 242508], [65, 242688]]}, {"verse": 31, "start": 243742, "end": 251658, "text": "Entonces como él salió, dijo Jesús: Ahora es glorificado el Hijo del hombre, y Dios es glorificado en él.", "words": [[0, 243742], [9, 244427], [14, 244567], [17, 244747], [24, 245447], [29, 245607], [36, 246664], [42, 247009], [45, 247249], [57, 248089], [60, 248209], [65, 248429], [69, 248649], [77, 249389], [79, 249549], [84, 249869], [87, 250309], [99, 251229], [102, 251369]]}, {"verse": 32, "start": 252108, "end": 259871, "text": "Si Dios es glorificado en él, Dios también le glorificará en sí mismo, y de inmediato le glorificará.", "words": [[0, 252108], [3, 252270], [8, 252530], [11, 252770], [23, 253570], [26, 253750], [30, 254430], [35, 254750], [43, 255230], [46, 255510], [58, 256290], [61, 256450], [64, 256590], [71, 257030], [73, 257690], [76, 257830], [86, 258630], [89, 258830]]}, {"verse": 33, "start": 260321, "end": 271751, "text": "Hijitos, aun un poco estoy con vosotros. Me buscaréis; pero, como dije a los judíos: Donde yo voy, vosotros no podéis venir; así digo a vosotros ahora.", "words": [[0, 260321], [9, 260837], [13, 261137], [16, 261377], [21, 261757], [27, 262097], [31, 262417], [41, 263441], [44, 263537], [55, 264727], [61, 265237], [66, 265377], [71, 265657], [73, 265817], [77, 265897], [85, 266915], [91, 267156], [94, 267456], [99, 267636], [108, 268536], [111, 268756], [118, 269136], [125, 269939], [129, 270259], [134, 270659], [136, 270799], [145, 271219]]}, {"verse": 34, "start": 272201, "end": 281189, "text": "Un mandamiento nuevo os doy: Que os améis unos a otros: como os he amado, que también os améis los unos a los otros.", "words": [[0, 272201], [3, 272385], [15, 273065], [21, 273465], [24, 273805], [29, 274603], [33, 274705], [36, 274825], [42, 275245], [47, 275885], [49, 276285], [56, 277221], [61, 277445], [64, 277665], [67, 277945], [74, 278385], [78, 278545], [86, 278825], [89, 279085], [95, 279405], [99, 279585], [104, 279945], [106, 280285], [110, 280465]]}, {"verse": 35, "start": 281639, "end": 287720, "text": "En esto conocerán todos que sois mis discípulos, si tenéis amor los unos con los otros.", "words": [[0, 281639], [3, 281954], [8, 282174], [18, 282854], [24, 283134], [28, 283414], [33, 283734], [37, 283934], [49, 285134], [52, 285394], [59, 285814], [64, 286134], [68, 286414], [73, 286674], [77, 286914], [81, 287114]]}, {"verse": 36, "start": 288170, "end": 297763, "text": "Le dice Simón Pedro: Señor, ¿adónde vas? Le respondió Jesús: Donde yo voy, no me puedes ahora seguir; pero me seguirás después.", "words": [[0, 288170], [3, 288312], [8, 288552], [14, 288972], [21, 289761], [28, 290383], [36, 290643], [41, 291502], [44, 291630], [54, 292210], [61, 293167], [67, 293370], [70, 293610], [75, 294190], [78, 294530], [81, 294670], [88, 294990], [94, 295370], [102, 296278], [107, 296421], [110, 296581], [119, 297041]]}, {"verse": 37, "start": 298213, "end": 303116, "text": "Le dice Pedro: Señor, ¿por qué no te puedo seguir ahora? daré mi vida por ti.", "words": [[0, 298213], [3, 298338], [8, 298578], [15, 299406], [22, 300142], [27, 300262], [31, 300382], [34, 300502], [37, 300622], [43, 300822], [50, 301122], [57, 301998], [62, 302276], [65, 302356], [70, 302576], [74, 302756]]}, {"verse": 38, "start": 303466, "end": 313127, "text": "Le respondió Jesús: ¿Darás tu vida por mí? De cierto, de cierto te digo: No cantará el gallo, sin que me hayas negado tres veces.", "words": [[0, 303466], [3, 303595], [13, 304175], [20, 305132], [27, 305557], [30, 305677], [35, 305957], [39, 306217], [43, 307131], [46, 307403], [54, 307675], [57, 307947], [64, 308219], [67, 308439], [73, 309237], [76, 309556], [84, 309910], [87, 310263], [94, 310723], [98, 311083], [102, 311283], [105, 311463], [111, 311723], [118, 312183], [123, 312403]]}]}