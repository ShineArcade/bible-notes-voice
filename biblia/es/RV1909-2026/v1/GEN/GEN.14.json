{"book": "GEN", "chapter": 14, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 237230, "verses": [{"verse": 1, "start": 300, "end": 12280, "text": "Y aconteció en los días de Amrafel, rey de Sinar, Arioc, rey de Elasar, Quedorlaomer, rey de Elá, y Tidal, rey de naciones,", "words": [[0, 300], [2, 466], [12, 1266], [15, 1466], [19, 1566], [24, 1786], [27, 1946], [36, 3066], [40, 3426], [43, 3546], [50, 4346], [57, 5266], [61, 5806], [64, 6505], [72, 7204], [86, 7904], [90, 8446], [93, 8606], [98, 9166], [100, 9706], [107, 10566], [111, 11146], [114, 11306]]}, {"verse": 2, "start": 12630, "end": 29743, "text": "Que estos hicieron guerra contra Bera, rey de Sodoma, y contra Birsa, rey de Gomorra, y contra Sinab, rey de Adma, y contra Semeber, rey de Zeboim, y contra el rey de Bela, la cual es Zoar.", "words": [[0, 12630], [4, 12754], [10, 13114], [19, 13834], [26, 14254], [33, 15134], [39, 16014], [43, 16274], [46, 16354], [54, 17514], [56, 17534], [63, 18184], [70, 18834], [74, 19134], [77, 19234], [86, 20474], [88, 20494], [95, 20814], [102, 21734], [106, 22274], [109, 22394], [115, 23189], [117, 23209], [124, 24029], [133, 24849], [137, 25509], [140, 26098], [148, 26908], [150, 27032], [157, 27332], [160, 27572], [164, 27892], [167, 28212], [173, 28532], [176, 28772], [181, 29012], [184, 29408]]}, {"verse": 3, "start": 30093, "end": 34980, "text": "Todos estos se juntaron en el valle de Siddim, que es el mar salado.", "words": [[0, 30093], [6, 30336], [12, 30736], [15, 31036], [24, 31656], [27, 31836], [30, 32016], [36, 32276], [39, 32796], [47, 33316], [51, 33536], [54, 33736], [57, 33896], [61, 34196]]}, {"verse": 4, "start": 35330, "end": 41791, "text": "Doce años habían servido a Quedorlaomer, y al décimotercio año se rebelaron.", "words": [[0, 35477], [5, 35657], [10, 36177], [17, 36657], [25, 37357], [27, 37927], [41, 38497], [43, 38852], [46, 39512], [59, 40172], [63, 40492], [66, 41174]]}, {"verse": 5, "start": 42141, "end": 56369, "text": "Y en el año decimocuarto vino Quedorlaomer, y los reyes que estaban de su parte, y derrotaron a los refaítas en Astarot Karnaim, a los zuzitas en Ham, y a los emitas en Save-quiriataim.", "words": [[0, 42141], [2, 42266], [5, 42406], [8, 42526], [12, 43006], [25, 43486], [30, 44462], [44, 45439], [46, 45551], [50, 45871], [56, 46191], [60, 46271], [68, 46610], [71, 46811], [74, 46931], [81, 47311], [83, 47811], [94, 48610], [96, 48851], [100, 49320], [109, 49791], [112, 50418], [120, 51044], [129, 51671], [131, 51691], [135, 52041], [143, 52390], [146, 52930], [151, 53688], [153, 53815], [155, 53895], [159, 54035], [166, 54575], [169, 55498]]}, {"verse": 6, "start": 56719, "end": 63133, "text": "Y a los horeos en el monte de Seir, hasta la llanura de Parán, que está junto al desierto.", "words": [[0, 56719], [2, 56841], [4, 56921], [8, 57271], [15, 57621], [18, 57841], [21, 57981], [27, 58281], [30, 58521], [36, 59301], [42, 59741], [45, 59921], [53, 60301], [56, 60461], [63, 61421], [67, 61501], [72, 61721], [78, 62061], [81, 62321]]}, {"verse": 7, "start": 63483, "end": 74903, "text": "Y volvieron, y vinieron a En-mispat, que es Cades, y devastaron todo el territorio de los amalecitas, y también al amorreo, que habitaba en Hazezón-tamar.", "words": [[0, 63483], [2, 63609], [13, 64069], [15, 64309], [24, 64769], [26, 65459], [37, 66149], [41, 66229], [44, 66409], [51, 67369], [53, 67449], [64, 68129], [69, 68389], [72, 68629], [83, 69269], [86, 69369], [90, 69489], [102, 70789], [104, 70849], [112, 71169], [115, 71529], [124, 72769], [128, 72889], [137, 73429], [140, 74187]]}, {"verse": 8, "start": 75253, "end": 88565, "text": "Y salió el rey de Sodoma, y el rey de Gomorra, y el rey de Adma, y el rey de Zeboim, y el rey de Bela, que es Zoar, y ordenaron contra ellos batalla en el valle de Siddim;", "words": [[0, 75253], [2, 75397], [8, 75797], [11, 75997], [15, 76277], [18, 76357], [26, 77157], [28, 77677], [31, 77817], [35, 78077], [38, 78157], [47, 79057], [49, 79357], [52, 79517], [56, 79837], [59, 79917], [65, 80797], [67, 81057], [70, 81197], [74, 81497], [77, 82047], [85, 82597], [87, 82857], [90, 83017], [94, 83317], [97, 83417], [103, 84097], [107, 84197], [110, 84597], [116, 85162], [118, 85342], [128, 86002], [135, 86342], [141, 86682], [149, 87262], [152, 87422], [155, 87612], [161, 87802], [164, 88212]]}, {"verse": 9, "start": 88915, "end": 102013, "text": "Es decir, contra Quedorlaomer, rey de Elam, y Tidal, rey de naciones, y Amrafel, rey de Sinar, y Arioc, rey de Elasar; cuatro reyes contra cinco.", "words": [[0, 88915], [3, 89253], [10, 89986], [17, 90720], [31, 91453], [35, 91893], [38, 91993], [44, 92453], [46, 92833], [53, 93653], [57, 94093], [60, 94153], [70, 94713], [72, 95323], [81, 95933], [85, 96353], [88, 96473], [95, 96893], [97, 97193], [104, 98153], [108, 98713], [111, 98913], [119, 100127], [126, 100297], [132, 100897], [139, 101483]]}, {"verse": 10, "start": 102363, "end": 113084, "text": "Y el valle de Siddim estaba lleno de pozos de asfalto: y huyeron el rey de Sodoma y el de Gomorra, y cayeron allí; y los demás huyeron al monte.", "words": [[0, 102363], [2, 102508], [5, 102648], [11, 102928], [14, 103328], [21, 103728], [28, 104148], [34, 104588], [37, 104688], [43, 105168], [46, 105288], [55, 106087], [57, 106247], [65, 106787], [68, 107007], [72, 107387], [75, 107447], [82, 108027], [84, 108227], [87, 108347], [90, 108467], [99, 109147], [101, 109602], [109, 110057], [115, 110675], [117, 110957], [121, 111117], [127, 111457], [135, 112257], [138, 112397]]}, {"verse": 11, "start": 113434, "end": 119427, "text": "Y tomaron toda la riqueza de Sodoma y de Gomorra, y todas sus provisiones, y se fueron.", "words": [[0, 113434], [2, 113538], [10, 113978], [15, 114298], [18, 114558], [26, 115098], [29, 115238], [36, 115778], [38, 115898], [41, 115998], [50, 116598], [52, 117018], [58, 117278], [62, 117578], [75, 118503], [77, 118643], [80, 118783]]}, {"verse": 12, "start": 119777, "end": 127140, "text": "Tomaron también a Lot, hijo del hermano de Abram, que moraba en Sodoma, y sus bienes, y se fueron.", "words": [[0, 119777], [8, 120160], [16, 120520], [18, 120840], [23, 121560], [28, 121940], [32, 122200], [40, 122740], [43, 122840], [50, 123720], [54, 123800], [61, 124260], [64, 124440], [72, 125080], [74, 125440], [78, 125600], [86, 126280], [88, 126520], [91, 126640]]}, {"verse": 13, "start": 127490, "end": 142071, "text": "Y vino uno de los que escaparon, y se lo comunicó a Abram el hebreo, que habitaba en el valle de Mamre amorreo, hermano de Escol y hermano de Aner, los cuales estaban confederados con Abram.", "words": [[0, 127490], [2, 127631], [7, 127891], [11, 128311], [14, 128511], [18, 128631], [22, 128811], [33, 130011], [35, 130231], [38, 130331], [41, 130471], [50, 131191], [52, 131511], [58, 131831], [61, 132191], [69, 133291], [73, 133351], [82, 133891], [85, 134051], [88, 134171], [94, 134451], [97, 134781], [103, 135111], [112, 136251], [120, 136771], [123, 137151], [129, 137531], [131, 137931], [139, 138391], [142, 138511], [148, 139390], [152, 139531], [159, 139791], [167, 140291], [180, 141311], [184, 141691]]}, {"verse": 14, "start": 142421, "end": 152784, "text": "Y oyó Abram que su hermano estaba prisionero, y armó sus criados, los criados de su casa, trescientos dieciocho, y los siguió hasta Dan.", "words": [[0, 142421], [2, 142735], [6, 143215], [12, 143515], [16, 143655], [19, 143835], [27, 144315], [34, 144535], [46, 145435], [48, 145855], [53, 146195], [57, 146335], [66, 147395], [70, 147535], [78, 147975], [81, 148135], [84, 148295], [90, 149208], [102, 150122], [113, 151035], [115, 151235], [119, 151395], [126, 151873], [132, 152350]]}, {"verse": 15, "start": 153134, "end": 162314, "text": "Y cayó sobre ellos de noche él y sus siervos, y los hirió, y los fue siguiendo hasta Hobah, que está a la izquierda de Damasco.", "words": [[0, 153134], [2, 153264], [7, 153664], [13, 153924], [19, 154224], [22, 154404], [28, 154724], [31, 155144], [33, 155364], [37, 155524], [46, 156144], [48, 156597], [52, 157051], [59, 157504], [61, 157644], [65, 157784], [69, 158004], [79, 158564], [85, 159194], [92, 159824], [96, 159884], [101, 160224], [103, 160544], [106, 160644], [116, 161324], [119, 161464]]}, {"verse": 16, "start": 162664, "end": 169845, "text": "Y recobró todos los bienes, y también a Lot su hermano y sus bienes, y también las mujeres y gente.", "words": [[0, 162664], [2, 162832], [10, 163532], [16, 163792], [20, 164152], [28, 165052], [30, 165112], [38, 165452], [40, 165732], [44, 166072], [47, 166252], [55, 166832], [57, 166932], [61, 167112], [69, 167992], [71, 168012], [79, 168312], [83, 168492], [91, 168852], [93, 169152]]}, {"verse": 17, "start": 170195, "end": 181393, "text": "Y salió el rey de Sodoma a recibirlo, cuando volvía de la derrota de Quedorlaomer y de los reyes que con él estaban, al valle de Save, que es el valle del Rey.", "words": [[0, 170195], [2, 170339], [8, 170739], [11, 170979], [15, 171379], [18, 171459], [25, 172019], [27, 172179], [38, 173259], [45, 173719], [52, 174359], [55, 174499], [58, 174639], [66, 175119], [69, 175679], [82, 176239], [84, 176419], [87, 176519], [91, 176679], [97, 177079], [101, 177259], [105, 177519], [108, 177639], [117, 178639], [120, 178759], [126, 178999], [129, 179414], [135, 179987], [139, 180132], [142, 180292], [145, 180412], [151, 180692], [155, 180892]]}, {"verse": 18, "start": 181743, "end": 189476, "text": "Entonces Melquisedec, rey de Salem, sacó pan y vino; el cual era sacerdote del Dios alto;", "words": [[0, 181743], [9, 182688], [22, 183668], [26, 184148], [29, 184248], [36, 184628], [41, 185388], [45, 185688], [47, 185908], [53, 186628], [56, 186774], [61, 187214], [65, 187654], [75, 188094], [79, 188434], [84, 188694]]}, {"verse": 19, "start": 189826, "end": 196497, "text": "Y le bendijo, y dijo: Bendito sea Abram del Dios alto, poseedor de los cielos y de la tierra;", "words": [[0, 189826], [2, 189952], [5, 190052], [14, 190672], [16, 191292], [22, 192012], [30, 192519], [34, 192759], [40, 193179], [44, 193319], [49, 193539], [55, 194379], [64, 194919], [67, 195079], [71, 195199], [78, 195639], [80, 195739], [83, 195819], [86, 195919]]}, {"verse": 20, "start": 196847, "end": 203636, "text": "Y bendito sea el Dios alto, que entregó tus enemigos en tu mano. Y le dio Abram los diezmos de todo.", "words": [[0, 196847], [2, 196945], [10, 197425], [14, 197705], [17, 197825], [22, 198085], [28, 198405], [32, 198865], [40, 199325], [44, 199485], [53, 199965], [56, 200165], [59, 200265], [65, 200996], [67, 201143], [70, 201283], [74, 201723], [80, 202163], [84, 202323], [92, 202863], [95, 203063]]}, {"verse": 21, "start": 203986, "end": 210458, "text": "Entonces el rey de Sodoma dijo a Abram: Dame las personas, y toma para ti los bienes.", "words": [[0, 203986], [9, 204556], [12, 205116], [16, 205456], [19, 205516], [26, 205996], [31, 206316], [33, 206636], [40, 207494], [45, 207718], [49, 207938], [59, 208458], [61, 208838], [66, 209098], [71, 209338], [74, 209578], [78, 209758]]}, {"verse": 22, "start": 210738, "end": 218288, "text": "Y respondió Abram al rey de Sodoma: He alzado mi mano a Jehová Dios alto, poseedor de los cielos y de la tierra,", "words": [[0, 210738], [2, 210861], [12, 211401], [18, 211941], [21, 212581], [25, 213001], [28, 213101], [36, 214022], [39, 214148], [46, 214568], [49, 214708], [54, 214968], [56, 215274], [63, 215579], [68, 215885], [74, 216191], [83, 216713], [86, 216873], [90, 216993], [97, 217473], [99, 217573], [102, 217673], [105, 217753]]}, {"verse": 23, "start": 218638, "end": 226690, "text": "Que desde un hilo hasta la correa de un calzado, nada tomaré de todo lo que es tuyo, para que no digas: Yo enriquecí a Abram:", "words": [[0, 218638], [4, 218736], [10, 218896], [13, 219176], [18, 219416], [24, 219656], [27, 219956], [34, 220256], [37, 220336], [40, 220436], [49, 221456], [54, 221736], [61, 222236], [64, 222356], [69, 222596], [72, 222816], [76, 222936], [79, 223156], [85, 223696], [90, 223996], [94, 224156], [97, 224276], [104, 225070], [107, 225231], [117, 225891], [119, 226171]]}, {"verse": 24, "start": 227040, "end": 236830, "text": "Sacando solamente lo que comieron los jóvenes, y la porción de los varones que fueron conmigo, Aner, Escol, y Mamre; los cuales tomarán su parte.", "words": [[0, 227040], [8, 227473], [18, 227853], [21, 228133], [25, 228253], [34, 228593], [38, 228813], [47, 229233], [49, 229613], [52, 229733], [60, 230093], [63, 230253], [67, 230373], [75, 230753], [79, 230933], [86, 231473], [95, 232013], [101, 232683], [108, 233353], [110, 233798], [117, 234422], [121, 234522], [128, 235032], [136, 235432], [139, 235592]]}]}