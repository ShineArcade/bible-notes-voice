{"book": "JHN", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 370669, "verses": [{"verse": 1, "start": 300, "end": 9402, "text": "Y pasadas estas cosas andaba Jesús en Galilea: que no quería andar en Judea, porque los judíos procuraban matarle.", "words": [[0, 300], [2, 407], [10, 967], [16, 1227], [22, 1727], [29, 2427], [35, 2807], [38, 3267], [47, 4383], [51, 4466], [54, 4626], [61, 5006], [67, 5466], [70, 5706], [77, 6426], [84, 7046], [88, 7306], [95, 7806], [106, 8506]]}, {"verse": 2, "start": 9852, "end": 13907, "text": "Y estaba cerca la fiesta de los judíos, la de los tabernáculos.", "words": [[0, 9852], [2, 10103], [9, 10383], [15, 10823], [18, 11103], [25, 11463], [28, 11583], [32, 11703], [40, 12503], [43, 12623], [46, 12723], [50, 13346]]}, {"verse": 3, "start": 14357, "end": 21929, "text": "Y le dijeron sus hermanos: Pásate de aquí, y vete a Judea, para que también tus discípulos vean las obras que haces.", "words": [[0, 14357], [2, 14481], [5, 14601], [13, 15101], [17, 15261], [27, 16353], [34, 16743], [37, 16923], [43, 17243], [45, 17543], [50, 17843], [52, 17963], [59, 18423], [64, 19043], [68, 19203], [76, 19543], [80, 19803], [91, 20383], [96, 20783], [100, 20903], [106, 21163], [110, 21383]]}, {"verse": 4, "start": 22379, "end": 29000, "text": "Que ninguno que busca ser conocido públicamente, hace algo en oculto. Si estas cosas haces, manifiéstate al mundo.", "words": [[0, 22379], [4, 22459], [12, 22899], [16, 23059], [22, 23319], [26, 23559], [35, 24079], [49, 24819], [54, 25199], [59, 25459], [62, 25579], [70, 26424], [73, 26563], [79, 26743], [85, 27023], [92, 27763], [105, 28383], [108, 28523]]}, {"verse": 5, "start": 29350, "end": 32263, "text": "Porque ni aun sus hermanos creían en él.", "words": [[0, 29350], [7, 29594], [10, 29894], [14, 30134], [18, 30454], [27, 31174], [34, 31654], [37, 31814]]}, {"verse": 6, "start": 32713, "end": 38793, "text": "Les dice entonces Jesús: Mi tiempo aún no ha venido; pero vuestro tiempo siempre es oportuno.", "words": [[0, 32847], [4, 33013], [9, 33180], [18, 33620], [25, 34677], [28, 34805], [35, 35185], [39, 35485], [42, 35765], [45, 35865], [53, 36698], [58, 36845], [66, 37205], [73, 37505], [81, 37845], [84, 38045]]}, {"verse": 7, "start": 39243, "end": 48008, "text": "No puede el mundo aborreceros a vosotros; pero a mí me aborrece, porque yo doy testimonio de él, que sus obras son malas.", "words": [[0, 39243], [3, 39370], [9, 39730], [12, 40170], [18, 40670], [30, 41690], [32, 41810], [42, 42903], [47, 43047], [49, 43187], [52, 43327], [55, 43857], [65, 44387], [72, 44747], [75, 44987], [79, 45227], [90, 45927], [93, 46087], [97, 46407], [101, 46487], [105, 46647], [111, 47007], [115, 47307]]}, {"verse": 8, "start": 48458, "end": 55993, "text": "Vosotros subid a esta fiesta; yo no subo aún a esta fiesta, porque mi tiempo aún no es cumplido.", "words": [[0, 48458], [9, 48978], [15, 49512], [17, 50045], [22, 50245], [30, 51237], [33, 51416], [36, 51576], [41, 51996], [45, 52176], [47, 52376], [52, 52536], [60, 53296], [67, 53776], [70, 53996], [77, 54396], [81, 54656], [84, 54976], [87, 55176]]}, {"verse": 9, "start": 56443, "end": 59156, "text": "Y habiéndoles dicho esto, se quedó en Galilea.", "words": [[0, 56443], [2, 56592], [14, 57092], [20, 57392], [26, 57712], [29, 57952], [35, 58292], [38, 58392]]}, {"verse": 10, "start": 59606, "end": 67147, "text": "Pero como sus hermanos hubieron subido, entonces él también subió a la fiesta, no abiertamente, sino como en secreto.", "words": [[0, 59606], [5, 59770], [10, 60030], [14, 60230], [23, 60790], [32, 61130], [40, 62090], [49, 62410], [52, 62850], [60, 63210], [66, 63790], [68, 63890], [71, 63970], [79, 64690], [82, 64870], [96, 65690], [101, 65990], [106, 66310], [109, 66470]]}, {"verse": 11, "start": 67597, "end": 73103, "text": "Y le buscaban los judíos en la fiesta, y decían: ¿Dónde está aquel?", "words": [[0, 67597], [2, 67721], [5, 67801], [14, 68321], [18, 68481], [25, 69001], [28, 69161], [31, 69281], [39, 69821], [41, 70401], [49, 71501], [56, 71783], [61, 72023]]}, {"verse": 12, "start": 73453, "end": 83260, "text": "Y había grande murmullo de él entre la gente: porque unos decían: Bueno es; y otros decían: No, antes engaña a la gente.", "words": [[0, 73453], [2, 73569], [8, 73749], [15, 74229], [24, 74909], [27, 75049], [30, 75289], [36, 75689], [39, 75869], [46, 76766], [53, 77051], [58, 77471], [66, 79031], [72, 79325], [76, 79916], [78, 80082], [84, 80262], [92, 81427], [96, 81672], [102, 82012], [109, 82552], [111, 82652], [114, 82692]]}, {"verse": 13, "start": 83610, "end": 88030, "text": "Pero ninguno hablaba abiertamente de él, por miedo de los judíos.", "words": [[0, 83610], [5, 83777], [13, 84257], [21, 84657], [34, 85397], [37, 85577], [41, 85997], [45, 86617], [51, 86977], [54, 87177], [58, 87297]]}, {"verse": 14, "start": 88480, "end": 92122, "text": "Y al medio de la fiesta subió Jesús al templo, y enseñaba.", "words": [[0, 88480], [2, 88578], [5, 88678], [11, 88918], [14, 89098], [17, 89198], [24, 89518], [30, 89918], [36, 90198], [39, 90518], [47, 91098], [49, 91198]]}, {"verse": 15, "start": 92572, "end": 98185, "text": "Y se maravillaban los judíos, diciendo: ¿Cómo tiene este conocimientos, sin haber estudiado?", "words": [[0, 92572], [2, 92678], [5, 92818], [18, 93518], [22, 93678], [30, 94258], [40, 95335], [46, 95495], [52, 95835], [57, 96315], [72, 96795], [76, 97215], [82, 97455]]}, {"verse": 16, "start": 98535, "end": 104199, "text": "Les respondió Jesús, y dijo: Mi doctrina no es mía, sino de aquel que me envió.", "words": [[0, 98535], [4, 98690], [14, 99250], [21, 99690], [23, 100109], [29, 100774], [32, 100900], [41, 101420], [44, 101680], [47, 101820], [52, 102480], [57, 102680], [60, 102920], [66, 103300], [70, 103460], [73, 103600]]}, {"verse": 17, "start": 104649, "end": 112290, "text": "El que quiera hacer la voluntad de Dios, conocerá si la doctrina es de Dios, o si yo hablo de mí mismo.", "words": [[0, 104649], [3, 104795], [7, 104955], [14, 105395], [20, 105795], [23, 106035], [32, 106695], [35, 106855], [41, 107675], [50, 108615], [53, 108715], [56, 108895], [65, 109395], [68, 109675], [71, 109815], [77, 110155], [79, 110675], [82, 110835], [85, 111075], [91, 111435], [94, 111575], [97, 111715]]}, {"verse": 18, "start": 112740, "end": 123763, "text": "El que habla de sí mismo, su propia gloria busca; pero el que busca la gloria del que le envió, este es verdadero, y no hay en él injusticia.", "words": [[0, 112740], [3, 112863], [7, 113003], [13, 113243], [16, 113443], [19, 113643], [26, 114023], [29, 114463], [36, 114923], [43, 115403], [50, 116326], [55, 116489], [58, 116629], [62, 116729], [68, 117009], [71, 117229], [78, 117629], [82, 117809], [86, 118009], [89, 118189], [96, 119129], [101, 119669], [104, 119929], [115, 120749], [117, 121169], [120, 121389], [124, 121749], [127, 122249], [130, 122469]]}, {"verse": 19, "start": 124213, "end": 130873, "text": "¿No os dio Moisés la ley, y ninguno de vosotros cumple la ley? ¿Por qué me procuráis matar?", "words": [[0, 124213], [4, 124442], [7, 124602], [11, 124862], [18, 125462], [21, 125802], [26, 126122], [28, 126562], [36, 127062], [39, 127162], [48, 127612], [55, 128062], [58, 128182], [63, 129186], [68, 129291], [72, 129491], [75, 129631], [85, 130271]]}, {"verse": 20, "start": 131323, "end": 135636, "text": "Respondió la gente, y dijo: Demonio tienes: ¿quién te procura matar?", "words": [[0, 131323], [10, 131867], [13, 131987], [20, 132287], [22, 132507], [28, 133248], [36, 133692], [44, 134517], [51, 134720], [54, 134780], [62, 135140]]}, {"verse": 21, "start": 135986, "end": 141816, "text": "Jesús respondió, y les dijo: Una obra hice, y todos os maravilláis.", "words": [[0, 135986], [6, 136338], [17, 137378], [19, 137638], [23, 137738], [29, 138560], [33, 138784], [38, 139144], [44, 139604], [46, 140164], [52, 140484], [55, 140764]]}, {"verse": 22, "start": 142266, "end": 151111, "text": "Cierto, Moisés os dio la circuncisión (no porque sea de Moisés, sino de los padres); y en sábado circuncidáis al hombre.", "words": [[0, 142266], [8, 142750], [15, 143310], [18, 143630], [22, 143910], [25, 144090], [38, 145510], [42, 145590], [49, 145910], [53, 146170], [56, 146330], [64, 147090], [69, 147370], [72, 147550], [76, 147690], [85, 148659], [87, 148808], [90, 148948], [97, 149528], [110, 150428], [113, 150628]]}, {"verse": 23, "start": 151561, "end": 164141, "text": "Si recibe el hombre la circuncisión en sábado, para que la ley de Moisés no sea quebrantada, ¿os enojáis conmigo porque en sábado hice sano todo un hombre?", "words": [[0, 151561], [3, 151712], [10, 152292], [13, 152452], [20, 152732], [23, 153192], [36, 154172], [39, 154332], [47, 154952], [52, 155732], [56, 155912], [59, 156052], [63, 156252], [66, 156392], [73, 156812], [76, 157432], [80, 157672], [93, 158992], [97, 159732], [105, 160492], [113, 161192], [120, 161532], [123, 161752], [130, 162352], [135, 162652], [140, 163032], [145, 163312], [148, 163572]]}, {"verse": 24, "start": 164591, "end": 169627, "text": "No juzguéis según lo que parece, sino juzgad con justicia.", "words": [[0, 164591], [3, 164758], [12, 165438], [18, 165898], [21, 166158], [25, 166278], [33, 167338], [38, 167678], [45, 168398], [49, 168698]]}, {"verse": 25, "start": 170077, "end": 176160, "text": "Decían entonces unos de los de Jerusalén: ¿No es este al que buscan para matarlo?", "words": [[0, 170077], [7, 170603], [16, 171163], [21, 171943], [24, 172343], [28, 172503], [31, 172823], [42, 173975], [46, 174175], [49, 174415], [54, 174695], [57, 174795], [61, 174935], [68, 175335], [73, 175515]]}, {"verse": 26, "start": 176610, "end": 183587, "text": "Y he aquí, habla públicamente, y no le dicen nada; ¿Habrán entendido verdaderamente los dirigentes, que este es el Cristo?", "words": [[0, 176610], [2, 176721], [5, 176871], [11, 177131], [17, 177391], [31, 178191], [33, 178471], [36, 178591], [39, 178691], [45, 178931], [51, 179791], [59, 180271], [69, 180771], [84, 181471], [88, 181691], [100, 182311], [104, 182571], [109, 182751], [112, 182891], [115, 183011]]}, {"verse": 27, "start": 184037, "end": 189646, "text": "Pero este, sabemos de dónde es; mas cuando venga el Cristo, nadie sabrá de dónde sea.", "words": [[0, 184037], [5, 184337], [11, 184557], [19, 184957], [22, 185157], [28, 185277], [32, 186135], [36, 186312], [43, 186512], [49, 186972], [52, 187092], [60, 187952], [66, 188252], [72, 188772], [75, 188932], [81, 189072]]}, {"verse": 28, "start": 189996, "end": 204561, "text": "Entonces clamaba Jesús en el templo, enseñando y diciendo: Y a mí me conocéis, y sabéis de dónde soy; y no he venido de mí mismo; pero el que me envió es verdadero, al cual vosotros no conocéis.", "words": [[0, 189996], [9, 190983], [17, 191503], [23, 191823], [26, 192163], [29, 192323], [37, 193123], [47, 193843], [49, 193963], [59, 194960], [61, 195108], [63, 195148], [66, 195288], [69, 195448], [79, 196148], [81, 196488], [88, 196908], [91, 197048], [97, 197248], [102, 198139], [104, 198267], [107, 198447], [110, 198587], [117, 199007], [120, 199147], [123, 199307], [130, 200246], [135, 200430], [138, 200590], [142, 200750], [145, 200950], [151, 201330], [154, 201470], [165, 201950], [168, 202430], [173, 202650], [182, 203270], [185, 203530]]}, {"verse": 29, "start": 205011, "end": 208453, "text": "Yo le conozco, porque de él soy, y él me envió.", "words": [[0, 205011], [3, 205196], [6, 205336], [15, 205896], [22, 206236], [25, 206436], [28, 206556], [33, 206996], [35, 207536], [38, 207736], [41, 207916]]}, {"verse": 30, "start": 208903, "end": 215482, "text": "Entonces procuraban prenderle; pero ninguno puso en él mano, porque aún no había venido su hora.", "words": [[0, 208903], [9, 209386], [20, 210266], [31, 211596], [36, 211758], [44, 212218], [49, 212598], [52, 212738], [55, 212858], [61, 213198], [68, 213578], [72, 213858], [75, 214058], [81, 214318], [88, 214758], [91, 214978]]}, {"verse": 31, "start": 215932, "end": 224131, "text": "Y muchos del pueblo creyeron en él, y decían: El Cristo, cuando venga, ¿hará más señales que las que este hace?", "words": [[0, 215932], [2, 216215], [9, 216515], [13, 216775], [20, 217155], [29, 217995], [32, 218135], [36, 218735], [38, 219175], [46, 220334], [49, 220462], [57, 220782], [64, 221042], [71, 221582], [77, 222282], [81, 222402], [89, 222882], [93, 223082], [97, 223222], [101, 223422], [106, 223662]]}, {"verse": 32, "start": 224481, "end": 234410, "text": "Los fariseos oyeron a la gente que murmuraba de él estas cosas; y los príncipes de los sacerdotes y los fariseos enviaron guardias que lo arrestaran.", "words": [[0, 224481], [4, 224857], [13, 225267], [20, 225767], [22, 225927], [25, 226007], [31, 226347], [35, 226607], [45, 227347], [48, 227567], [51, 227787], [57, 227987], [64, 229142], [66, 229229], [70, 229329], [80, 229929], [83, 230049], [87, 230169], [98, 230869], [100, 231049], [104, 231169], [113, 231929], [122, 232649], [131, 233309], [135, 233429], [138, 233589]]}, {"verse": 33, "start": 234860, "end": 240355, "text": "Y Jesús dijo: Aun un poco de tiempo estaré con vosotros, e iré al que me envió.", "words": [[0, 234860], [2, 234984], [8, 235304], [14, 236236], [18, 236475], [21, 236675], [26, 236915], [29, 237075], [36, 237315], [43, 237835], [47, 237975], [57, 238595], [59, 239015], [63, 239375], [66, 239515], [70, 239675], [73, 239835]]}, {"verse": 34, "start": 240805, "end": 246338, "text": "Me buscaréis, y no me hallaréis; y donde yo estaré, vosotros no podréis venir.", "words": [[0, 240805], [3, 240909], [14, 241669], [16, 242149], [19, 242309], [22, 242844], [33, 243618], [35, 243716], [41, 243896], [44, 244136], [52, 244856], [61, 245336], [64, 245516], [72, 245956]]}, {"verse": 35, "start": 246788, "end": 255806, "text": "Entonces los judíos dijeron entre sí: ¿A dónde se ha de ir este que no le hallemos? ¿Se ha de ir a los esparcidos entre los griegos, y a enseñar a los griegos?", "words": [[0, 246788], [9, 247496], [13, 248056], [20, 248516], [28, 249016], [34, 249256], [38, 249930], [41, 250055], [47, 250195], [50, 250335], [53, 250475], [56, 250635], [59, 250755], [64, 250975], [68, 251115], [71, 251235], [74, 251355], [84, 252231], [88, 252389], [91, 252489], [94, 252549], [97, 252649], [99, 252729], [103, 252869], [114, 253449], [120, 253709], [124, 253889], [133, 254369], [135, 254569], [137, 254629], [145, 255009], [147, 255029], [151, 255169]]}, {"verse": 36, "start": 256256, "end": 262967, "text": "¿Qué dicho es este que dijo: Me buscaréis, y no me hallaréis; y donde yo estaré, vosotros no podréis venir?", "words": [[0, 256256], [5, 256360], [11, 256580], [14, 256740], [19, 256980], [23, 257120], [29, 258104], [32, 258184], [43, 258744], [45, 258944], [48, 259064], [51, 259204], [62, 260070], [64, 260167], [70, 260327], [73, 260547], [81, 261187], [90, 261547], [93, 261727], [101, 262127]]}, {"verse": 37, "start": 263317, "end": 272444, "text": "Pero en el último día grande de la fiesta, Jesús se ponía en pie y clamaba, diciendo: Si alguno tiene sed, venga a mí y beba.", "words": [[0, 263317], [5, 263459], [8, 263619], [11, 263719], [18, 263979], [22, 264379], [29, 264739], [32, 264959], [35, 265079], [43, 265899], [49, 266339], [52, 266899], [58, 267339], [61, 267499], [65, 267779], [67, 268079], [76, 268639], [86, 269745], [89, 270038], [96, 270478], [102, 270658], [107, 271218], [113, 271498], [115, 271678], [118, 271818], [120, 272018]]}, {"verse": 38, "start": 272894, "end": 278780, "text": "El que cree en mí, como dice la Escritura, ríos de agua viva correrán de su vientre.", "words": [[0, 272894], [3, 273040], [7, 273180], [12, 273460], [15, 273680], [19, 274340], [24, 274500], [29, 274800], [32, 275000], [43, 275710], [48, 276420], [51, 276560], [56, 276820], [61, 277200], [70, 277800], [73, 277920], [76, 278080]]}, {"verse": 39, "start": 279230, "end": 289108, "text": "(Y esto dijo del Espíritu que habían de recibir los que creyesen en él: pues aún no había venido el Espíritu Santo; porque Jesús no estaba aún glorificado.)", "words": [[0, 279230], [3, 279568], [8, 279788], [13, 280068], [17, 280288], [26, 280828], [30, 280948], [37, 281188], [40, 281408], [48, 281788], [52, 282048], [56, 282188], [65, 282808], [68, 282908], [72, 283590], [77, 283712], [81, 283972], [84, 284212], [90, 284452], [97, 284912], [100, 285012], [109, 285512], [116, 286416], [123, 286603], [129, 287003], [132, 287483], [139, 287803], [143, 288123]]}, {"verse": 40, "start": 289558, "end": 296647, "text": "Entonces algunos de la multitud, oyendo este dicho, decían: Verdaderamente este es el profeta.", "words": [[0, 289558], [9, 290397], [17, 290857], [20, 291077], [23, 291177], [33, 292137], [40, 292497], [45, 292777], [52, 293697], [60, 294667], [75, 295389], [80, 295729], [83, 295909], [86, 296049]]}, {"verse": 41, "start": 296997, "end": 306971, "text": "Otros decían: Este es el Cristo. Pero algunos decían: ¿De Galilea ha de venir el Cristo?", "words": [[0, 296997], [6, 297368], [14, 298646], [19, 298952], [22, 299292], [25, 299432], [33, 303434], [38, 303598], [46, 303978], [54, 305106], [58, 305234], [66, 305489], [69, 305744], [72, 305999], [78, 306254], [81, 306354]]}, {"verse": 42, "start": 307421, "end": 313743, "text": "¿No dice la Escritura, que del linaje de David, y de la aldea de Belén, de donde era David, vendrá el Cristo?", "words": [[0, 307421], [4, 307523], [9, 307723], [12, 307883], [23, 308363], [27, 308603], [31, 308743], [38, 309203], [41, 309323], [48, 309643], [50, 309963], [53, 310063], [56, 310203], [62, 310503], [65, 310643], [72, 311063], [75, 311483], [81, 311723], [85, 311963], [92, 312363], [99, 313023], [102, 313143]]}, {"verse": 43, "start": 314093, "end": 317270, "text": "Así que había división entre la gente acerca de él.", "words": [[0, 314093], [4, 314328], [8, 314528], [14, 314748], [23, 315388], [29, 315628], [32, 315828], [38, 316108], [45, 316488], [48, 316848]]}, {"verse": 44, "start": 317720, "end": 322909, "text": "Y algunos de ellos querían prenderle; pero ninguno echó sobre él manos.", "words": [[0, 317720], [2, 317980], [10, 318270], [13, 318530], [19, 318770], [27, 319190], [38, 320427], [43, 320572], [51, 321252], [56, 321752], [62, 322072], [65, 322272]]}, {"verse": 45, "start": 323359, "end": 331427, "text": "Y los guardias vinieron a los principales sacerdotes y a los fariseos; y ellos les dijeron: ¿Por qué no le trajisteis?", "words": [[0, 323359], [2, 323627], [6, 323787], [15, 324247], [24, 324867], [26, 325047], [30, 325147], [42, 325867], [53, 326707], [55, 326947], [57, 327047], [61, 327167], [71, 328396], [73, 328580], [79, 328850], [83, 329120], [92, 330062], [97, 330184], [101, 330424], [104, 330524], [107, 330604]]}, {"verse": 46, "start": 331777, "end": 335968, "text": "Los guardias respondieron: Nunca ha hablado hombre así como este hombre.", "words": [[0, 331777], [4, 331902], [13, 332482], [27, 333948], [33, 334270], [36, 334370], [44, 334670], [51, 334890], [55, 335090], [60, 335330], [65, 335570]]}, {"verse": 47, "start": 336318, "end": 341974, "text": "Entonces los fariseos les respondieron: ¿Estáis también vosotros engañados?", "words": [[0, 336318], [9, 336904], [13, 337564], [22, 338364], [26, 338644], [40, 339910], [48, 340250], [56, 340570], [65, 341030]]}, {"verse": 48, "start": 342424, "end": 345665, "text": "¿Ha creído en él alguno de los dirigentes, o de los fariseos?", "words": [[0, 342424], [4, 342526], [11, 342886], [14, 343006], [17, 343106], [24, 343506], [27, 343586], [31, 343706], [43, 344366], [45, 344626], [48, 344726], [52, 344846]]}, {"verse": 49, "start": 346115, "end": 348777, "text": "Pero esta gente que no sabe la ley, maldita es.", "words": [[0, 346115], [5, 346237], [10, 346457], [16, 346777], [20, 346997], [23, 347117], [28, 347357], [31, 347517], [36, 347937], [44, 348357]]}, {"verse": 50, "start": 349127, "end": 354532, "text": "Les dice Nicodemo (el que vino a él de noche, el cual era uno de ellos):", "words": [[0, 349192], [4, 349292], [9, 349532], [18, 350712], [22, 350832], [26, 350972], [31, 351192], [33, 351372], [36, 351492], [39, 351632], [46, 352472], [49, 352632], [54, 352912], [58, 353372], [62, 353732], [65, 353952]]}, {"verse": 51, "start": 354782, "end": 359532, "text": "¿Juzga nuestra ley a hombre, si primero no oye de él, y entiende lo que ha hecho?", "words": [[0, 354782], [7, 355168], [15, 355368], [19, 355808], [21, 355948], [29, 356248], [32, 356668], [40, 357048], [43, 357288], [47, 357548], [50, 357708], [54, 357948], [56, 358268], [65, 358708], [68, 358868], [72, 359008], [75, 359128]]}, {"verse": 52, "start": 359882, "end": 367854, "text": "Respondieron y le dijeron: ¿Eres tú también galileo? Escudriña y ve que de Galilea nunca se levantó profeta.", "words": [[0, 359882], [13, 360687], [15, 361107], [18, 361227], [27, 362157], [33, 362381], [36, 362621], [44, 362981], [53, 364036], [63, 364818], [65, 365138], [68, 365278], [72, 365438], [75, 365578], [83, 366118], [89, 366398], [92, 366698], [100, 367198]]}, {"verse": 53, "start": 368204, "end": 370269, "text": "Y se fue cada uno a su casa.", "words": [[0, 368204], [2, 368330], [5, 368470], [9, 368690], [14, 368990], [18, 369330], [20, 369530], [23, 369630]]}]}