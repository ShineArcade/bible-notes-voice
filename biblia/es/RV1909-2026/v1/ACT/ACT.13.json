{"book": "ACT", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 449006, "verses": [{"verse": 1, "start": 300, "end": 16131, "text": "Había entonces en la iglesia que estaba en Antioquía, profetas y maestros: Bernabé, y Simón el que se llamaba Niger, y Lucio cireneo, y Manaén, que había sido criado con Herodes el tetrarca, y Saulo.", "words": [[0, 300], [6, 656], [15, 1136], [18, 1476], [21, 1676], [29, 2176], [33, 2336], [40, 2696], [43, 2956], [54, 4276], [63, 4976], [65, 5156], [75, 6325], [84, 6991], [86, 7172], [92, 7951], [95, 8212], [99, 8332], [102, 8452], [110, 8912], [117, 9992], [119, 10092], [125, 10631], [134, 11171], [136, 11412], [144, 12491], [148, 12572], [154, 12772], [159, 13092], [166, 13651], [170, 13891], [178, 14292], [181, 14532], [191, 15232], [193, 15392]]}, {"verse": 2, "start": 16581, "end": 27581, "text": "Ministrando pues estos al Señor, y ayunando, dijo el Espíritu Santo: Apartadme a Bernabé y a Saulo para la obra para la cual los he llamado.", "words": [[0, 16581], [12, 17350], [17, 17590], [23, 17890], [26, 18190], [33, 18490], [35, 18790], [45, 19610], [50, 20110], [53, 20270], [62, 20770], [69, 21580], [79, 22342], [81, 22422], [89, 23062], [91, 23342], [93, 23402], [99, 23742], [104, 23962], [107, 24122], [112, 24642], [117, 24942], [120, 25082], [125, 25329], [129, 25575], [132, 25822]]}, {"verse": 3, "start": 27931, "end": 34946, "text": "Entonces habiendo ayunado y orado, y puesto las manos encima de ellos, los despidieron.", "words": [[0, 27931], [9, 29151], [18, 29691], [26, 30431], [28, 30611], [35, 31111], [37, 31711], [44, 31951], [48, 32191], [54, 32471], [61, 32971], [64, 33211], [71, 33911], [75, 34011]]}, {"verse": 4, "start": 35396, "end": 43032, "text": "Y ellos, enviados así por el Espíritu Santo, descendieron a Seleucia; y de allí navegaron a Chipre.", "words": [[0, 35396], [2, 35711], [9, 36011], [18, 36731], [22, 37051], [26, 37351], [29, 37531], [38, 38091], [45, 38451], [58, 39811], [60, 40338], [70, 41143], [72, 41343], [75, 41463], [80, 41643], [90, 42303], [92, 42693]]}, {"verse": 5, "start": 43482, "end": 53200, "text": "Y llegados a Salamina, anunciaban la palabra de Dios en las sinagogas de los judíos: y tenían también a Juan como ayudante.", "words": [[0, 43482], [2, 43586], [11, 44066], [13, 44266], [23, 45346], [34, 46186], [37, 46386], [45, 46766], [48, 47006], [53, 47286], [56, 47666], [60, 47846], [70, 48946], [73, 49146], [77, 49306], [85, 50371], [87, 50792], [94, 51152], [102, 51532], [104, 51812], [109, 52032], [114, 52332]]}, {"verse": 6, "start": 53650, "end": 63182, "text": "Y habiendo atravesado toda la isla hasta Pafos, hallaron un hombre mago, falso profeta, judío, llamado Barjesús;", "words": [[0, 53650], [2, 53779], [11, 54159], [22, 54859], [27, 55159], [30, 55439], [35, 55859], [41, 56549], [48, 57239], [57, 57959], [60, 58259], [67, 58539], [73, 59379], [79, 60119], [88, 61039], [95, 61899], [103, 62577]]}, {"verse": 7, "start": 63632, "end": 73852, "text": "El cual estaba con el procónsul Sergio Paulo, varón prudente. Este, llamando a Bernabé y a Saulo, deseaba oír la palabra de Dios.", "words": [[0, 63632], [3, 63810], [8, 64090], [15, 64650], [19, 64950], [22, 65437], [32, 65923], [39, 66410], [46, 67050], [52, 67550], [62, 68684], [68, 69031], [77, 69571], [79, 69751], [87, 70411], [89, 70611], [91, 70711], [98, 71651], [106, 72191], [110, 72611], [113, 72751], [121, 73111], [124, 73351]]}, {"verse": 8, "start": 74302, "end": 82769, "text": "Pero les resistía Elimas el hechicero (que así se interpreta su nombre), procurando apartar de la fe al procónsul.", "words": [[0, 74302], [5, 74666], [9, 75046], [18, 75816], [25, 76586], [28, 76786], [38, 77726], [43, 77886], [47, 78126], [50, 78286], [61, 78966], [64, 79126], [73, 79946], [84, 80566], [92, 81226], [95, 81326], [98, 81466], [101, 81706], [104, 81906]]}, {"verse": 9, "start": 83219, "end": 89627, "text": "Entonces Saulo, que también es Pablo, lleno del Espíritu Santo, poniendo en él los ojos,", "words": [[0, 83219], [9, 84049], [16, 84789], [20, 84849], [28, 85189], [31, 85429], [38, 86349], [44, 86749], [48, 86889], [57, 87489], [64, 87949], [73, 88429], [76, 88589], [79, 88749], [83, 88949]]}, {"verse": 10, "start": 90077, "end": 99892, "text": "Dijo: Oh, lleno de todo engaño y de toda maldad, hijo del diablo, enemigo de toda justicia, ¿no cesarás de trastornar los caminos rectos del Señor?", "words": [[0, 90077], [6, 90959], [10, 91049], [16, 91369], [19, 91509], [24, 91689], [31, 92289], [33, 92389], [36, 92509], [41, 92709], [49, 93749], [54, 93929], [58, 94109], [66, 94869], [74, 95249], [77, 95389], [82, 95589], [92, 96769], [96, 96889], [104, 97409], [107, 97549], [118, 98189], [122, 98309], [130, 98769], [137, 99269], [141, 99409]]}, {"verse": 11, "start": 100342, "end": 115156, "text": "Ahora pues, he aquí la mano del Señor es contra ti, y serás ciego, que no veas el sol por un tiempo. Y de inmediato cayeron en él oscuridad y tinieblas; y andando alrededor, buscaba quién le condujese por la mano.", "words": [[0, 100342], [6, 100597], [12, 101137], [15, 101217], [20, 101457], [23, 101597], [28, 101837], [32, 102017], [38, 102357], [41, 102637], [48, 102937], [52, 103537], [54, 103777], [60, 104077], [67, 104917], [71, 104977], [74, 105157], [79, 105357], [82, 105557], [86, 105757], [90, 105997], [93, 106117], [101, 107029], [103, 107134], [106, 107254], [116, 107874], [124, 108474], [127, 108614], [130, 108814], [140, 109634], [142, 109814], [153, 110973], [155, 111275], [163, 111735], [174, 112035], [182, 113015], [188, 113315], [191, 113535], [201, 114215], [205, 114475], [208, 114655]]}, {"verse": 12, "start": 115606, "end": 123530, "text": "Entonces el procónsul, viendo lo que había sido hecho, creyó, maravillado de la doctrina del Señor.", "words": [[0, 115606], [9, 117049], [12, 117309], [23, 118169], [30, 118469], [33, 118709], [37, 118849], [43, 119069], [48, 119429], [55, 120349], [62, 121149], [74, 121809], [77, 122009], [80, 122149], [89, 122709], [93, 122949]]}, {"verse": 13, "start": 123980, "end": 135240, "text": "Y partidos de Pafos, Pablo y sus compañeros arribaron a Perge de Panfilia: entonces Juan, apartándose de ellos, se volvió a Jerusalén.", "words": [[0, 123980], [2, 124256], [11, 124796], [14, 124976], [21, 126036], [27, 126776], [29, 126976], [33, 127136], [44, 127936], [54, 128696], [56, 128996], [62, 129296], [65, 129436], [75, 130621], [84, 131118], [90, 131799], [102, 132739], [105, 132919], [112, 133239], [115, 133759], [122, 134299], [124, 134419]]}, {"verse": 14, "start": 135690, "end": 144002, "text": "Y ellos pasando de Perge, llegaron a Antioquía de Pisidia, y entrando en la sinagoga un día de sábado, se sentaron.", "words": [[0, 135690], [2, 135835], [8, 136075], [16, 136475], [19, 136865], [26, 137255], [35, 138135], [37, 138455], [47, 139175], [50, 139315], [59, 140015], [61, 140355], [70, 140875], [73, 141015], [76, 141115], [85, 141675], [88, 141855], [92, 142035], [95, 142175], [103, 142715], [106, 143275]]}, {"verse": 15, "start": 144452, "end": 156449, "text": "Y después de la lectura de la ley y de los profetas, los dirigentes de la sinagoga enviaron a ellos, diciendo: Varones hermanos, si tenéis alguna palabra de exhortación para el pueblo, hablad.", "words": [[0, 144452], [2, 144574], [10, 144834], [13, 145054], [16, 145194], [24, 145714], [27, 145854], [30, 146014], [34, 146294], [36, 146494], [39, 146594], [43, 146714], [53, 147914], [57, 148014], [68, 148654], [71, 148814], [74, 148934], [83, 149534], [92, 150074], [94, 150254], [101, 150634], [111, 152217], [119, 152387], [129, 152967], [132, 153047], [139, 153367], [146, 153667], [154, 154067], [157, 154247], [169, 154867], [174, 155147], [177, 155287], [185, 155897]]}, {"verse": 16, "start": 156799, "end": 166209, "text": "Entonces Pablo, levantándose, hecha señal de silencio con la mano, dice: Varones israelitas, y los que teméis a Dios, oíd:", "words": [[0, 156799], [9, 157239], [16, 157879], [30, 159029], [36, 160179], [42, 160699], [45, 160799], [54, 161459], [58, 161659], [61, 161819], [67, 162159], [73, 163023], [81, 163399], [93, 164199], [95, 164399], [99, 164519], [103, 164659], [110, 164992], [112, 165326], [118, 165659]]}, {"verse": 17, "start": 166659, "end": 176782, "text": "El Dios del pueblo de Israel escogió a nuestros padres, y enalteció al pueblo, siendo ellos extranjeros en la tierra de Egipto, y con brazo levantado los sacó de ella.", "words": [[0, 166659], [3, 166779], [8, 166979], [12, 167179], [19, 167499], [22, 167719], [29, 168139], [37, 168839], [39, 168939], [48, 169119], [56, 169679], [58, 170239], [68, 170779], [71, 170939], [79, 171759], [86, 172059], [92, 172339], [104, 173159], [107, 173279], [110, 173379], [117, 173619], [120, 173839], [128, 174319], [130, 174639], [134, 174779], [140, 175119], [150, 175489], [154, 175859], [159, 176239], [162, 176379]]}, {"verse": 18, "start": 177232, "end": 181185, "text": "Y por tiempo como de cuarenta años soportó sus costumbres en el desierto;", "words": [[0, 177232], [2, 177340], [6, 177480], [13, 177720], [18, 178040], [21, 178310], [30, 178580], [35, 178960], [43, 179540], [47, 179680], [58, 180240], [61, 180380], [64, 180480]]}, {"verse": 19, "start": 181635, "end": 186846, "text": "Y destruyendo siete naciones en la tierra de Canaán, les repartió por suerte la tierra de ellas.", "words": [[0, 181635], [2, 181703], [14, 182113], [20, 182523], [29, 183083], [32, 183263], [35, 183363], [42, 183583], [45, 184013], [53, 184443], [57, 184763], [66, 185263], [70, 185403], [77, 185763], [80, 185903], [87, 186163], [90, 186363]]}, {"verse": 20, "start": 187296, "end": 192517, "text": "Y después, como por cuatrocientos cincuenta años, les dio jueces hasta el profeta Samuel.", "words": [[0, 187296], [2, 187397], [11, 187977], [16, 188137], [20, 188424], [34, 188710], [44, 188997], [50, 190357], [54, 190537], [58, 190757], [65, 191157], [71, 191417], [74, 191537], [82, 191937]]}, {"verse": 21, "start": 192967, "end": 200499, "text": "Y entonces pidieron rey; y les dio Dios a Saúl, hijo de Cis, varón de la tribu de Benjamín, por cuarenta años.", "words": [[0, 192967], [2, 193086], [11, 193446], [20, 194006], [25, 194732], [27, 194854], [31, 195054], [35, 195334], [40, 195574], [42, 195854], [48, 196394], [53, 196554], [56, 196734], [61, 197394], [67, 197814], [70, 197914], [73, 198014], [79, 198394], [82, 198514], [92, 199354], [96, 199474], [105, 200034]]}, {"verse": 22, "start": 200949, "end": 213981, "text": "Y quitado aquel, les levantó por rey a David, al que dio también testimonio, diciendo: He hallado a David, hijo de Isaí, varón conforme a mi corazón, el cual hará todo lo que yo quiero.", "words": [[0, 200949], [2, 201050], [10, 201450], [17, 201870], [21, 202030], [29, 202530], [33, 202683], [37, 202837], [39, 202990], [46, 203067], [49, 203143], [53, 203220], [57, 203297], [65, 203373], [77, 205490], [87, 206419], [90, 206557], [98, 206997], [100, 207137], [107, 207757], [112, 208057], [115, 208217], [121, 208997], [127, 209417], [136, 210037], [138, 210117], [141, 210197], [150, 211137], [153, 211317], [158, 211617], [163, 212057], [168, 212277], [171, 212537], [175, 212677], [178, 212837]]}, {"verse": 23, "start": 214281, "end": 220398, "text": "De la descendencia de este, Dios, conforme a la promesa, levantó a Jesús por Salvador a Israel;", "words": [[0, 214281], [3, 214407], [6, 214507], [19, 215227], [22, 215367], [28, 215887], [34, 216547], [43, 217047], [45, 217127], [48, 217167], [57, 218127], [65, 218607], [67, 218687], [73, 218907], [77, 219247], [86, 219627], [88, 219847]]}, {"verse": 24, "start": 220848, "end": 225934, "text": "Predicando Juan antes de su llegada el bautismo de arrepentimiento a todo el pueblo de Israel.", "words": [[0, 220848], [11, 221334], [16, 221654], [22, 222054], [25, 222214], [28, 222334], [36, 222624], [39, 222914], [48, 223454], [51, 223614], [67, 224414], [69, 224574], [74, 224714], [77, 224874], [84, 225154], [87, 225294]]}, {"verse": 25, "start": 226384, "end": 236298, "text": "Pero como Juan cumpliese su carrera, dijo: ¿Quién pensáis que soy? No soy yo él; pero he aquí, viene tras mí uno, cuyo calzado de los pies no soy digno de desatar.", "words": [[0, 226384], [5, 226501], [10, 226701], [15, 227101], [25, 227501], [28, 227681], [37, 228181], [43, 228884], [50, 229068], [58, 229408], [62, 229588], [67, 230301], [70, 230422], [74, 230622], [77, 230782], [81, 231378], [86, 231514], [89, 231674], [95, 232174], [101, 232354], [106, 232554], [109, 232774], [114, 232994], [119, 233334], [127, 233814], [130, 233894], [134, 234034], [139, 234294], [142, 234554], [146, 234754], [152, 235134], [155, 235174]]}, {"verse": 26, "start": 236748, "end": 245252, "text": "Varones hermanos, hijos del linaje de Abraham, y los que entre vosotros temen a Dios, a vosotros es enviada la palabra de esta salvación.", "words": [[0, 236748], [8, 237172], [18, 237932], [24, 238052], [28, 238332], [35, 238752], [38, 238892], [47, 239952], [49, 240012], [53, 240152], [57, 240312], [63, 240552], [72, 241072], [78, 241472], [80, 241572], [86, 242352], [88, 242452], [97, 242872], [100, 243052], [108, 243492], [111, 243672], [119, 244052], [122, 244252], [127, 244472]]}, {"verse": 27, "start": 245702, "end": 255164, "text": "Porque los que habitaban en Jerusalén, y sus príncipes, no conociendo a este, y las voces de los profetas que se leen todos los sábados, condenándolo, las cumplieron.", "words": [[0, 245702], [7, 245907], [11, 246087], [15, 246247], [25, 246747], [28, 246867], [39, 247487], [41, 247587], [45, 247767], [56, 248587], [59, 248687], [70, 249167], [72, 249387], [78, 249727], [80, 250107], [84, 250267], [90, 250627], [93, 250767], [97, 250867], [106, 251447], [110, 251667], [113, 251807], [118, 252127], [124, 252327], [128, 252587], [137, 253507], [151, 254367], [155, 254427]]}, {"verse": 28, "start": 255614, "end": 259974, "text": "Y sin hallar en él causa de muerte, pidieron a Pilato que le matasen.", "words": [[0, 255614], [2, 255744], [6, 255984], [13, 256304], [16, 256424], [19, 256564], [25, 256824], [28, 257084], [36, 258004], [45, 258484], [47, 258584], [54, 258984], [58, 259124], [61, 259244]]}, {"verse": 29, "start": 260424, "end": 267131, "text": "Y habiendo cumplido todas las cosas que de él estaban escritas, quitándolo del madero, lo pusieron en el sepulcro.", "words": [[0, 260424], [2, 260524], [11, 260824], [20, 261384], [26, 261564], [30, 261844], [36, 262184], [40, 262444], [43, 262564], [46, 262764], [54, 263064], [64, 264104], [75, 264604], [79, 264764], [87, 265644], [90, 265804], [99, 266224], [102, 266544], [105, 266864]]}, {"verse": 30, "start": 267581, "end": 269616, "text": "Pero Dios le levantó de los muertos.", "words": [[0, 267581], [5, 267719], [10, 267959], [13, 268219], [21, 268699], [24, 268779], [28, 268899]]}, {"verse": 31, "start": 270066, "end": 277606, "text": "Y él fue visto por muchos días de los que habían subido juntamente con él de Galilea a Jerusalén, los cuales son sus testigos al pueblo.", "words": [[0, 270066], [2, 270202], [5, 270302], [9, 270462], [15, 270702], [19, 270942], [26, 271202], [31, 271582], [34, 271822], [38, 271962], [42, 272142], [49, 272382], [56, 272822], [67, 273362], [71, 273602], [74, 273742], [77, 273862], [85, 274152], [87, 274442], [98, 275502], [102, 275602], [109, 275902], [113, 276182], [117, 276402], [126, 276882], [129, 277062]]}, {"verse": 32, "start": 278056, "end": 282627, "text": "Y nosotros también os anunciamos el evangelio de aquella promesa que fue hecha a los padres,", "words": [[0, 278056], [2, 278159], [11, 278399], [19, 278669], [22, 278939], [33, 279479], [36, 279719], [46, 280299], [49, 280399], [57, 280679], [65, 281159], [69, 281319], [73, 281519], [79, 281799], [81, 281879], [85, 281979]]}, {"verse": 33, "start": 283077, "end": 293310, "text": "La cual Dios ha cumplido a los hijos de ellos, a nosotros, resucitando a Jesús: como también en el salmo segundo está escrito: Mi hijo eres tú, yo te he engendrado hoy.", "words": [[0, 283077], [3, 283204], [8, 283404], [13, 283724], [16, 284084], [25, 284564], [27, 284664], [31, 284784], [37, 285024], [40, 285244], [47, 285724], [49, 285804], [59, 286764], [71, 287224], [73, 287324], [80, 288230], [85, 288394], [93, 288794], [96, 288954], [99, 289074], [105, 289394], [113, 289754], [118, 290014], [127, 290933], [130, 291095], [135, 291295], [140, 291515], [144, 292095], [147, 292195], [150, 292375], [153, 292455], [164, 292955]]}, {"verse": 34, "start": 293760, "end": 300560, "text": "Y que le levantó de los muertos para nunca más volver a corrupción, así lo dijo: Os daré las misericordias fieles de David.", "words": [[0, 293760], [2, 293868], [6, 293968], [9, 294068], [17, 294548], [20, 294608], [24, 294748], [32, 295148], [37, 295408], [43, 295648], [47, 295988], [54, 296168], [56, 296348], [68, 297128], [72, 297308], [75, 297468], [81, 298183], [84, 298300], [89, 298640], [93, 298740], [107, 299460], [114, 299960], [117, 300060]]}, {"verse": 35, "start": 301010, "end": 305507, "text": "Por eso dice también en otro lugar: No permitirás que tu Santo vea corrupción.", "words": [[0, 301010], [4, 301134], [8, 301334], [13, 301574], [21, 301874], [24, 302114], [29, 302274], [36, 303138], [39, 303262], [50, 303882], [54, 303982], [57, 304102], [63, 304442], [67, 304782]]}, {"verse": 36, "start": 305957, "end": 313506, "text": "Porque a la verdad David, habiendo servido en su generación a la voluntad de Dios, durmió, y fue reunido con sus padres, y vio corrupción:", "words": [[0, 305957], [7, 306165], [9, 306305], [12, 306365], [19, 306805], [26, 307285], [35, 307585], [43, 308025], [46, 308125], [49, 308245], [60, 308845], [62, 308985], [65, 309025], [74, 309505], [77, 309605], [83, 310225], [91, 310785], [93, 311045], [97, 311205], [105, 311645], [109, 311785], [113, 311985], [121, 312305], [123, 312645], [127, 312825]]}, {"verse": 37, "start": 313956, "end": 317653, "text": "Pero aquel que Dios levantó, no vio corrupción.", "words": [[0, 313956], [5, 314093], [11, 314373], [15, 314453], [20, 314613], [29, 315213], [32, 315493], [36, 315673]]}, {"verse": 38, "start": 318103, "end": 323963, "text": "Os sea pues notorio, varones hermanos, que por este os es anunciado el perdón de pecados;", "words": [[0, 318132], [3, 318202], [7, 318562], [12, 318682], [21, 319312], [29, 319942], [39, 320742], [43, 320982], [47, 321182], [52, 321442], [55, 321702], [58, 321962], [68, 322622], [71, 322742], [78, 323162], [81, 323262]]}, {"verse": 39, "start": 324413, "end": 331434, "text": "Y de todo lo que por la ley de Moisés no pudisteis ser justificados, en este es justificado todo aquel que cree.", "words": [[0, 324413], [2, 324537], [5, 324657], [10, 324957], [13, 325177], [17, 325317], [21, 325537], [24, 325657], [28, 325857], [31, 325997], [38, 326377], [41, 326697], [51, 327397], [55, 327537], [69, 328877], [72, 329077], [77, 329317], [80, 329517], [92, 330277], [97, 330477], [103, 330897], [107, 330997]]}, {"verse": 40, "start": 331884, "end": 336028, "text": "Mirad, pues, que no venga sobre vosotros lo que está dicho en los profetas;", "words": [[0, 331884], [7, 332242], [13, 332442], [17, 333002], [20, 333142], [26, 333462], [32, 333682], [41, 334242], [44, 334422], [48, 334542], [53, 334722], [59, 335002], [62, 335142], [66, 335242]]}, {"verse": 41, "start": 336478, "end": 345197, "text": "Mirad, oh menospreciadores, y asombraos y pereced; porque yo hago una obra en vuestros días, obra que no creeréis, si alguien os la cuenta.", "words": [[0, 336478], [7, 336959], [10, 337479], [28, 337999], [30, 338519], [40, 339239], [42, 339459], [51, 340435], [58, 340635], [61, 340835], [66, 341015], [70, 341275], [75, 341555], [78, 341715], [87, 342075], [93, 342715], [98, 342915], [102, 343095], [105, 343215], [115, 343775], [118, 344115], [126, 344325], [129, 344535], [132, 344655]]}, {"verse": 42, "start": 345547, "end": 354608, "text": "Y saliendo ellos de la sinagoga de los judíos, los Gentiles les rogaron que el sábado siguiente les hablasen estas palabras.", "words": [[0, 345547], [2, 345670], [11, 346190], [17, 346550], [20, 346790], [23, 346930], [32, 347590], [35, 347790], [39, 347910], [47, 348970], [51, 349150], [60, 349770], [64, 350470], [72, 351170], [76, 351430], [79, 351610], [86, 352030], [96, 352350], [100, 352880], [109, 353410], [115, 353650]]}, {"verse": 43, "start": 355058, "end": 370563, "text": "Y despedida la congregación, muchos de los judíos y de los convertidos devotos al judaísmo siguieron a Pablo y a Bernabé; los cuales hablándoles, les persuadían que permaneciesen en la gracia de Dios.", "words": [[0, 355058], [2, 355192], [12, 356052], [15, 356132], [29, 357672], [36, 358152], [39, 358372], [43, 358512], [50, 359172], [52, 359352], [55, 359432], [59, 359572], [71, 360232], [79, 360892], [82, 361032], [91, 361852], [101, 362752], [103, 362992], [109, 363432], [111, 363752], [113, 363832], [122, 364819], [126, 364965], [133, 365305], [146, 366285], [150, 366805], [161, 367605], [165, 367825], [179, 369165], [182, 369285], [185, 369425], [192, 369825], [195, 369965]]}, {"verse": 44, "start": 371013, "end": 376308, "text": "Y el sábado siguiente se juntó casi toda la ciudad a oír la palabra de Dios.", "words": [[0, 371013], [2, 371136], [5, 371256], [12, 371696], [22, 372156], [25, 372496], [31, 373016], [36, 373216], [41, 373676], [44, 373916], [51, 374256], [53, 374656], [57, 374996], [60, 375156], [68, 375516], [71, 375776]]}, {"verse": 45, "start": 376758, "end": 385274, "text": "Pero los judíos, al ver la multitud, se llenaron de celo, y se oponían a lo que Pablo decía, contradiciendo y blasfemando.", "words": [[0, 376758], [5, 376903], [9, 377083], [17, 377583], [20, 377783], [24, 377963], [27, 378103], [37, 378743], [40, 379363], [49, 380103], [52, 380363], [58, 381043], [60, 381203], [63, 381323], [71, 381923], [73, 382163], [76, 382263], [80, 382363], [86, 382683], [93, 383403], [108, 384263], [110, 384383]]}, {"verse": 46, "start": 385724, "end": 401367, "text": "Entonces Pablo y Bernabé, hablando con franqueza, dijeron: A vosotros a la verdad era necesario que se os hablase la palabra de Dios; pero pues que la desecháis, y os juzgáis indignos de la vida eterna, he aquí, nos volvemos a los Gentiles.", "words": [[0, 385724], [9, 386374], [15, 387154], [17, 387394], [26, 388114], [35, 388514], [39, 389064], [50, 389614], [59, 390641], [61, 390764], [70, 391364], [72, 391484], [75, 391564], [82, 392084], [86, 392264], [96, 392884], [100, 393084], [103, 393224], [106, 393384], [114, 393744], [117, 393864], [125, 394144], [128, 394344], [134, 395124], [139, 395283], [144, 395543], [148, 395683], [151, 395803], [162, 396443], [164, 396723], [167, 396863], [175, 397263], [184, 397903], [187, 398003], [190, 398103], [195, 398283], [203, 398803], [206, 399323], [212, 399643], [216, 399943], [225, 400463], [227, 400563], [231, 400663]]}, {"verse": 47, "start": 401817, "end": 409838, "text": "Porque así nos ha mandado el Señor, diciendo: Te he puesto para luz de los Gentiles, para que seas salvación hasta lo último de la tierra.", "words": [[0, 401817], [7, 401955], [11, 402195], [15, 402355], [18, 402495], [26, 402895], [29, 402995], [36, 403295], [46, 404511], [49, 404645], [52, 404745], [59, 405005], [64, 405385], [68, 405585], [71, 405765], [75, 405885], [85, 406465], [90, 407065], [94, 407275], [99, 407485], [109, 408185], [115, 408545], [118, 408725], [125, 409025], [128, 409245], [131, 409345]]}, {"verse": 48, "start": 410188, "end": 419522, "text": "Y los Gentiles oyendo esto, fueron gozosos, y glorificaban la palabra del Señor: y creyeron todos los que estaban ordenados para vida eterna.", "words": [[0, 410188], [2, 410313], [6, 410453], [15, 411053], [22, 411613], [28, 411913], [35, 412533], [44, 413293], [46, 413473], [59, 414293], [62, 414453], [70, 414813], [74, 415073], [81, 415919], [83, 416027], [92, 416567], [98, 416847], [102, 417127], [106, 417287], [114, 417587], [124, 418207], [129, 418467], [134, 418687]]}, {"verse": 49, "start": 419972, "end": 423920, "text": "Y la palabra del Señor era sembrada por toda aquella provincia.", "words": [[0, 419972], [2, 420221], [5, 420341], [13, 420601], [17, 420881], [23, 421141], [27, 421441], [36, 422081], [40, 422301], [45, 422561], [53, 423021]]}, {"verse": 50, "start": 424370, "end": 437855, "text": "Pero los judíos incitaron a mujeres devotas y de posición distinguida, y a los principales de la ciudad, y levantaron persecución contra Pablo y Bernabé, y los echaron de su territorio.", "words": [[0, 424370], [5, 424552], [9, 424732], [16, 425212], [26, 425952], [28, 425992], [36, 426562], [44, 427132], [46, 427572], [49, 427712], [58, 428132], [71, 429252], [73, 429812], [75, 429892], [79, 430012], [91, 430812], [94, 430972], [97, 431072], [105, 431472], [107, 432372], [118, 433012], [130, 433852], [137, 434232], [143, 434692], [145, 434852], [154, 435830], [156, 436097], [160, 436363], [168, 436630], [171, 436810], [174, 436970]]}, {"verse": 51, "start": 438305, "end": 444033, "text": "Ellos entonces sacudiendo en ellos el polvo de sus pies, vinieron a Iconio.", "words": [[0, 438305], [6, 438693], [15, 439113], [26, 440153], [29, 440333], [35, 440573], [38, 440813], [44, 441353], [47, 441473], [51, 441653], [57, 442013], [66, 443133], [68, 443313]]}, {"verse": 52, "start": 444483, "end": 448606, "text": "Y los discípulos estaban llenos de gozo, y del Espíritu Santo.", "words": [[0, 444483], [2, 444570], [6, 444690], [17, 445310], [25, 445670], [32, 446210], [35, 446330], [41, 446790], [43, 447210], [47, 447350], [56, 447910]]}]}