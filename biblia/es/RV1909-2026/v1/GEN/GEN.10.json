{"book": "GEN", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 203749, "verses": [{"verse": 1, "start": 300, "end": 9041, "text": "Estas son las generaciones de los hijos de Noé: Sem, Cam y Jafet, a los cuales nacieron hijos después del diluvio.", "words": [[0, 300], [6, 758], [10, 978], [14, 1178], [27, 1998], [30, 2198], [34, 2338], [40, 2638], [43, 2838], [48, 3489], [53, 4046], [57, 4636], [59, 5116], [66, 6016], [68, 6096], [72, 6216], [79, 6396], [88, 7056], [94, 7496], [102, 8056], [106, 8296]]}, {"verse": 2, "start": 9391, "end": 15657, "text": "Los hijos de Jafet: Gomer, y Magog, y Madai, y Javán, y Tubal, y Mesec, y Tiras.", "words": [[0, 9391], [4, 9500], [10, 9740], [13, 10149], [20, 10730], [27, 11195], [29, 11455], [36, 11955], [38, 12325], [45, 12695], [47, 13075], [54, 13455], [56, 13675], [63, 14155], [65, 14505], [72, 14855], [74, 15055]]}, {"verse": 3, "start": 16007, "end": 19916, "text": "Y los hijos de Gomer: Askenaz, y Rifat, y Togarma.", "words": [[0, 16007], [2, 16116], [6, 16256], [12, 16556], [15, 16796], [22, 17887], [31, 18257], [33, 18637], [40, 19017], [42, 19217]]}, {"verse": 4, "start": 20266, "end": 25107, "text": "Y los hijos de Javán: Elisa, y Tarsis, Quitim, y Dodanim.", "words": [[0, 20266], [2, 20369], [6, 20489], [12, 20809], [15, 21260], [22, 21914], [29, 22454], [31, 22694], [39, 23254], [47, 23814], [49, 24294]]}, {"verse": 5, "start": 25457, "end": 31925, "text": "Por estos se poblaron las costas, cada cual según su lengua, conforme a sus familias en sus naciones.", "words": [[0, 25457], [4, 25621], [10, 25821], [13, 26041], [22, 26541], [26, 26701], [34, 27681], [39, 28081], [44, 28401], [50, 28741], [53, 29021], [61, 29481], [70, 30061], [72, 30121], [76, 30241], [85, 30821], [88, 30941], [92, 31081]]}, {"verse": 6, "start": 32275, "end": 36369, "text": "Los hijos de Cam: Cus, y Mizraim, y Fut, y Canaán.", "words": [[0, 32275], [4, 32380], [10, 32660], [13, 33142], [18, 33845], [23, 33845], [25, 34380], [34, 34920], [36, 35240], [41, 35560], [43, 35964]]}, {"verse": 7, "start": 36719, "end": 45127, "text": "Y los hijos de Cus: Seba, Havila, y Sabta, y Raama, y Sabteca. Y los hijos de Raama: Sheba y Dedán.", "words": [[0, 36719], [2, 36856], [6, 36976], [12, 37216], [15, 37541], [20, 38481], [26, 38911], [34, 39342], [36, 39772], [43, 40203], [45, 40633], [52, 41064], [54, 41495], [63, 42086], [65, 42214], [69, 42354], [75, 42634], [78, 43064], [85, 43927], [91, 44177], [93, 44652]]}, {"verse": 8, "start": 45477, "end": 50736, "text": "Y Cus engendró a Nimrod: este comenzó a ser poderoso en la tierra.", "words": [[0, 45477], [2, 45695], [6, 45955], [15, 46575], [17, 46795], [25, 47786], [30, 48056], [38, 48796], [40, 48896], [44, 49136], [53, 49856], [56, 50016], [59, 50136]]}, {"verse": 9, "start": 51086, "end": 60985, "text": "Este fue vigoroso cazador delante de Jehová; por lo cual se dice: Así como Nimrod, vigoroso cazador delante de Jehová.", "words": [[0, 51086], [5, 51473], [9, 51813], [18, 52493], [26, 53153], [34, 53673], [37, 53833], [45, 54794], [49, 54922], [52, 55042], [57, 55302], [60, 55522], [66, 56355], [70, 56715], [75, 57035], [83, 58295], [92, 58995], [100, 59635], [108, 60135], [111, 60295]]}, {"verse": 10, "start": 61335, "end": 67621, "text": "Y fue la cabecera de su reino Babel, y Erec, y Accad, y Calne, en la tierra de Sinar.", "words": [[0, 61335], [2, 61459], [6, 61619], [9, 61779], [18, 62339], [21, 62459], [24, 62639], [30, 63099], [37, 63559], [39, 63959], [45, 64359], [47, 64799], [54, 65239], [56, 65659], [63, 66079], [66, 66419], [69, 66519], [76, 66903], [79, 67286]]}, {"verse": 11, "start": 67971, "end": 73537, "text": "De esta tierra salió Assur, y edificó a Nínive, y a Rehobot, y a Cala,", "words": [[0, 67971], [3, 68096], [8, 68256], [15, 68616], [21, 69056], [28, 69496], [30, 70026], [38, 70556], [40, 70736], [48, 71316], [50, 71796], [52, 72206], [61, 72616], [63, 72976], [65, 73076]]}, {"verse": 12, "start": 73887, "end": 78904, "text": "Y a Resén entre Nínive y Cala; la cual es ciudad grande.", "words": [[0, 73887], [2, 74090], [4, 74316], [10, 74542], [16, 75212], [23, 75883], [25, 76356], [31, 76997], [34, 77120], [39, 77320], [42, 77560], [49, 78160]]}, {"verse": 13, "start": 79254, "end": 84951, "text": "Y Mizraim engendró a Ludim, y a Anamim, y a Lehabim, y a naftuhim,", "words": [[0, 79254], [2, 79600], [10, 79976], [19, 80352], [21, 80728], [28, 81104], [30, 81480], [32, 81856], [40, 82232], [42, 82608], [44, 82984], [53, 83357], [55, 83731], [57, 84104]]}, {"verse": 14, "start": 85301, "end": 91261, "text": "Y a patrusim, y a Casluhim, de donde salieron los filisteos, y a caftoreos.", "words": [[0, 85301], [2, 85446], [4, 85896], [14, 86346], [16, 86646], [18, 87326], [28, 88006], [31, 88126], [37, 88306], [46, 88906], [50, 89106], [61, 89966], [63, 90206], [65, 90763]]}, {"verse": 15, "start": 91611, "end": 96479, "text": "Y Canaán engendró a Sidón, su primogénito, y a Het,", "words": [[0, 91611], [2, 91928], [9, 92278], [18, 92950], [20, 93622], [27, 94294], [30, 94966], [43, 95638], [45, 95938], [47, 96238]]}, {"verse": 16, "start": 96829, "end": 100852, "text": "Y al jebuseo, y al amorreo, y al gergeseo,", "words": [[0, 96829], [2, 96993], [5, 97483], [14, 97973], [16, 98353], [19, 98473], [28, 99273], [30, 99633], [33, 100243]]}, {"verse": 17, "start": 101202, "end": 104446, "text": "Y al heveo, y al araceo, y al sineo,", "words": [[0, 101202], [2, 101381], [5, 101691], [12, 102001], [14, 102241], [17, 102731], [25, 103221], [27, 103641], [30, 104077]]}, {"verse": 18, "start": 104796, "end": 112061, "text": "Y al arvadeo, y al zemareo, y al amateo: y después se derramaron las familias de los cananeos.", "words": [[0, 104796], [2, 104925], [5, 105025], [14, 106245], [16, 106285], [19, 106845], [28, 107405], [30, 107405], [33, 107525], [41, 108472], [43, 108574], [51, 108934], [54, 109554], [65, 110214], [69, 110394], [78, 110974], [81, 111034], [85, 111154]]}, {"verse": 19, "start": 112411, "end": 121853, "text": "Y fue el término de los cananeos desde Sidón, viniendo a Gerar hasta Gaza, hasta entrar en Sodoma y Gomorra, Adma, y Zeboim hasta Lasa.", "words": [[0, 112411], [2, 112529], [6, 112709], [9, 112889], [17, 113429], [20, 113489], [24, 113629], [33, 114209], [39, 114389], [46, 114969], [55, 115709], [57, 115809], [63, 116059], [69, 116309], [75, 116709], [81, 117129], [88, 117529], [91, 117709], [98, 118209], [100, 118329], [109, 118959], [115, 119589], [117, 120189], [124, 120789], [130, 121354]]}, {"verse": 20, "start": 122203, "end": 128519, "text": "Estos son los hijos de Cam por sus familias, por sus lenguas, en sus tierras, en sus naciones.", "words": [[0, 122203], [6, 122508], [10, 122728], [14, 122868], [20, 123168], [23, 123388], [27, 123628], [31, 123948], [35, 124108], [45, 125108], [49, 125188], [53, 125368], [62, 126248], [65, 126368], [69, 126528], [78, 127308], [81, 127368], [85, 127588]]}, {"verse": 21, "start": 128869, "end": 135390, "text": "También le nacieron hijos a Sem, padre de todos los hijos de Heber, y hermano mayor de Jafet.", "words": [[0, 128869], [8, 129113], [11, 129333], [20, 129833], [26, 130113], [28, 130393], [33, 131013], [39, 131373], [42, 131593], [48, 131853], [52, 132173], [58, 132473], [61, 132843], [68, 133213], [70, 133753], [78, 134273], [84, 134533], [87, 134753]]}, {"verse": 22, "start": 135740, "end": 141311, "text": "Y los hijos de Sem: Elam, y Assur, y Arfaxad, y Lud, y Aram.", "words": [[0, 135740], [2, 135972], [6, 136132], [12, 136432], [15, 136672], [20, 137502], [26, 137977], [28, 138537], [35, 139097], [37, 139462], [46, 139827], [48, 140192], [53, 140557], [55, 140722]]}, {"verse": 23, "start": 141661, "end": 146720, "text": "Y los hijos de Aram: Uz, y Hul, y Geter, y Mas.", "words": [[0, 141661], [2, 141791], [6, 141911], [12, 142211], [15, 142491], [21, 143731], [25, 144101], [27, 144661], [32, 145221], [34, 145621], [41, 146022], [43, 146242]]}, {"verse": 24, "start": 147070, "end": 151504, "text": "Y Arfaxad engendró a Sala, y Sala engendró a Heber.", "words": [[0, 147115], [2, 147375], [10, 148175], [19, 148895], [21, 149035], [27, 149395], [29, 149835], [34, 150175], [43, 150815], [45, 151187]]}, {"verse": 25, "start": 151854, "end": 162202, "text": "Y a Heber nacieron dos hijos: el nombre del uno fue Peleg, porque en sus días fue repartida la tierra; y el nombre de su hermano, Joctán.", "words": [[0, 151854], [2, 152119], [4, 152269], [10, 152419], [19, 152979], [23, 153279], [30, 154207], [33, 154370], [40, 154730], [44, 154950], [48, 155190], [52, 155450], [59, 156190], [66, 156870], [69, 157190], [73, 157370], [78, 157650], [82, 157930], [92, 158710], [95, 158870], [103, 159792], [105, 160002], [108, 160122], [115, 160482], [118, 160722], [121, 160862], [130, 161532]]}, {"verse": 26, "start": 162552, "end": 168426, "text": "Y Joctán engendró a Almodad, y a Selef, y Hazarmaveth, y a Jera,", "words": [[0, 162816], [2, 163116], [9, 163416], [18, 164196], [20, 164416], [29, 165276], [31, 165456], [33, 165806], [40, 166156], [42, 166806], [55, 167456], [57, 167816], [59, 167916]]}, {"verse": 27, "start": 168776, "end": 171672, "text": "Y a Adoram, y a Uzal, y a Dicla,", "words": [[0, 168776], [2, 168919], [4, 169179], [12, 169779], [14, 170039], [16, 170339], [22, 170639], [24, 171019], [26, 171119]]}, {"verse": 28, "start": 172022, "end": 175226, "text": "Y a Obal, y a Abimael, y a Seba,", "words": [[0, 172022], [2, 172206], [4, 172266], [10, 172806], [12, 173326], [14, 173406], [23, 174166], [25, 174586], [27, 174906]]}, {"verse": 29, "start": 175576, "end": 180850, "text": "Y a Ofir, y a Havila, y a Jobab: todos estos fueron hijos de Joctán.", "words": [[0, 175689], [2, 175803], [4, 175916], [10, 176295], [12, 176675], [14, 177054], [22, 177434], [24, 177813], [26, 178193], [33, 178731], [39, 178954], [45, 179274], [52, 179614], [58, 179954], [61, 180437]]}, {"verse": 30, "start": 181200, "end": 186708, "text": "Y fue su habitación desde Mesa viniendo de Sefar, monte a la parte del oriente.", "words": [[0, 181200], [2, 181321], [6, 181481], [9, 181721], [20, 182401], [26, 182681], [31, 183161], [40, 183641], [43, 183821], [50, 184761], [56, 185021], [58, 185281], [61, 185501], [67, 185781], [71, 186041]]}, {"verse": 31, "start": 187058, "end": 193804, "text": "Estos fueron los hijos de Sem por sus familias, por sus lenguas, en sus tierras, en sus naciones.", "words": [[0, 187058], [6, 187600], [13, 187860], [17, 188140], [23, 188520], [26, 188760], [30, 188920], [34, 189200], [38, 189400], [48, 190100], [52, 190140], [56, 190340], [65, 191140], [68, 191380], [72, 191540], [81, 192740], [84, 192820], [88, 192980]]}, {"verse": 32, "start": 194154, "end": 203349, "text": "Estas son las familias de Noé por sus descendencias, en sus naciones; y de estos se esparcieron las naciones en la tierra después del diluvio.", "words": [[0, 194154], [6, 194558], [10, 194698], [14, 194858], [23, 195378], [26, 195498], [30, 195798], [34, 195958], [38, 196138], [53, 197018], [56, 197218], [60, 197418], [70, 198503], [72, 198723], [75, 198863], [81, 199143], [84, 199443], [96, 200263], [100, 200443], [109, 200903], [112, 201123], [115, 201243], [122, 201583], [130, 202303], [134, 202603]]}]}