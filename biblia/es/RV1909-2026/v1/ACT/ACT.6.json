{"book": "ACT", "chapter": 6, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 142439, "verses": [{"verse": 1, "start": 300, "end": 14783, "text": "En aquellos días, creciendo el número de los discípulos, hubo murmuración de los judíos de habla griega contra los de habla hebrea, porque sus viudas eran desatendidas en la distribución diaria.", "words": [[0, 300], [3, 442], [12, 722], [18, 1742], [28, 2402], [31, 2602], [38, 2962], [41, 3182], [45, 3322], [57, 4022], [62, 4522], [74, 5402], [77, 5642], [81, 5742], [88, 6262], [91, 6442], [97, 6722], [104, 7422], [111, 7802], [115, 8042], [118, 8262], [124, 8522], [132, 9625], [139, 9808], [143, 10048], [150, 10848], [155, 11168], [168, 12648], [171, 12968], [174, 13108], [187, 13968]]}, {"verse": 2, "start": 15233, "end": 24346, "text": "Así que, los doce convocaron la multitud de los discípulos, y dijeron: No es justo que nosotros dejemos la palabra de Dios, y sirvamos a las mesas.", "words": [[0, 15233], [4, 15417], [9, 15597], [13, 15827], [18, 16057], [29, 16877], [32, 16877], [41, 17397], [44, 17537], [48, 17637], [60, 18297], [62, 18757], [71, 19686], [74, 19845], [77, 20025], [83, 20345], [87, 20585], [96, 20865], [104, 21465], [107, 21645], [115, 21965], [118, 22165], [124, 22405], [126, 23025], [135, 23505], [137, 23645], [141, 23745]]}, {"verse": 3, "start": 24796, "end": 33549, "text": "Buscad pues, hermanos, siete varones de vosotros de buen testimonio, llenos de Espíritu Santo y de sabiduría, los cuales pongamos en esta obra.", "words": [[0, 25043], [7, 25333], [13, 25433], [23, 26393], [29, 26613], [37, 27053], [40, 27253], [49, 27673], [52, 27873], [57, 28053], [69, 29153], [76, 29433], [79, 29573], [88, 30113], [94, 30373], [96, 30613], [99, 30713], [110, 31753], [114, 31853], [121, 32133], [130, 32693], [133, 32893], [138, 33113]]}, {"verse": 4, "start": 33999, "end": 38121, "text": "Y nosotros persistiremos en la oración, y en el ministerio de la palabra.", "words": [[0, 33999], [2, 34103], [11, 34383], [25, 35363], [28, 35523], [31, 35643], [40, 36063], [42, 36603], [45, 36723], [48, 36803], [59, 37383], [62, 37463], [65, 37563]]}, {"verse": 5, "start": 38471, "end": 56611, "text": "La propuesta agradó a toda la multitud; y eligieron a Esteban, varón lleno de fe y de Espíritu Santo, y a Felipe, y a Prócoro, y a Nicanor, y a Timón, y a Parmenas, y a Nicolás, convertido al judaísmo de Antioquía:", "words": [[0, 38471], [3, 38597], [13, 39277], [20, 39917], [22, 40017], [27, 40217], [30, 40437], [40, 41627], [42, 41784], [52, 42384], [54, 42644], [63, 43724], [69, 44164], [75, 44584], [78, 44684], [81, 45004], [83, 45344], [86, 45504], [95, 46164], [102, 47304], [104, 47544], [106, 47624], [114, 47984], [116, 48524], [118, 48844], [127, 49164], [129, 49564], [131, 49664], [140, 50304], [142, 50504], [144, 50604], [151, 51184], [153, 51524], [155, 51624], [165, 52364], [167, 52764], [169, 52844], [178, 53889], [189, 54673], [192, 54793], [201, 55533], [204, 55673]]}, {"verse": 6, "start": 57061, "end": 64084, "text": "A estos presentaron delante de los apóstoles, los cuales orando les pusieron las manos encima.", "words": [[0, 57061], [2, 57329], [8, 57549], [20, 58409], [28, 58909], [31, 59069], [35, 59189], [46, 60229], [50, 60349], [57, 60969], [64, 62089], [68, 62229], [77, 62709], [81, 62889], [87, 63209]]}, {"verse": 7, "start": 64534, "end": 76217, "text": "Y crecía la palabra del Señor, y el número de los discípulos se multiplicaba mucho en Jerusalén: también una gran multitud de los sacerdotes obedecía a la fe.", "words": [[0, 64534], [2, 64683], [9, 65223], [12, 65423], [20, 65863], [24, 66103], [31, 66483], [33, 67283], [36, 67483], [43, 67883], [46, 68103], [50, 68243], [61, 68923], [64, 69103], [77, 70003], [83, 70463], [86, 70683], [97, 71859], [105, 72285], [109, 72665], [114, 72945], [123, 73725], [126, 73905], [130, 74065], [141, 74825], [150, 75505], [152, 75805], [155, 75865]]}, {"verse": 8, "start": 76667, "end": 83203, "text": "Pero Esteban, lleno de gracia y de poder, hacía prodigios y milagros grandes en el pueblo.", "words": [[0, 76667], [5, 76830], [14, 77890], [20, 78470], [23, 78590], [30, 79070], [32, 79150], [35, 79270], [42, 80070], [48, 80370], [58, 81090], [60, 81230], [69, 81770], [77, 82090], [80, 82410], [83, 82550]]}, {"verse": 9, "start": 83653, "end": 94992, "text": "Se levantaron entonces unos de la sinagoga que se llama de los Libertos, y cireneos, y alejandrinos, y de los de Cilicia, y de Asia, disputando con Esteban.", "words": [[0, 83653], [3, 83818], [14, 84478], [23, 85098], [28, 85578], [31, 85758], [34, 85878], [43, 86498], [47, 86678], [50, 86838], [56, 87138], [59, 87298], [63, 87398], [73, 88198], [75, 88758], [85, 89318], [87, 89498], [101, 90538], [103, 90878], [106, 91018], [110, 91178], [113, 91578], [122, 91978], [124, 92258], [127, 92338], [133, 93058], [144, 93898], [148, 94138]]}, {"verse": 10, "start": 95442, "end": 99584, "text": "Pero no podían resistir a la sabiduría y al Espíritu con que hablaba.", "words": [[0, 95442], [5, 95589], [8, 95749], [15, 96149], [24, 96789], [26, 96869], [29, 96969], [39, 97689], [41, 97829], [44, 97969], [53, 98549], [57, 98729], [61, 98909]]}, {"verse": 11, "start": 100034, "end": 107212, "text": "Entonces sobornaron a unos que dijesen que le habían oído hablar palabras blasfemas contra Moisés y Dios.", "words": [[0, 100034], [9, 101173], [20, 102133], [22, 102453], [27, 102613], [31, 102983], [39, 103353], [43, 103553], [46, 103693], [53, 103933], [58, 104273], [65, 104453], [74, 104933], [84, 105593], [91, 105953], [98, 106413], [100, 106653]]}, {"verse": 12, "start": 107662, "end": 116698, "text": "Y agitaron al pueblo, y a los ancianos, y a los escribas; y arremetiendo le arrebataron, y le trajeron al Consejo.", "words": [[0, 107662], [2, 107798], [11, 108478], [14, 108618], [22, 109078], [24, 109938], [26, 109998], [30, 110158], [40, 110818], [42, 110978], [44, 111018], [48, 111158], [58, 112389], [60, 112800], [73, 113246], [76, 113693], [89, 114653], [91, 114953], [94, 115073], [103, 115733], [106, 115873]]}, {"verse": 13, "start": 117148, "end": 125009, "text": "Y pusieron testigos falsos, que dijesen: Este hombre no cesa de hablar palabras blasfemas contra este lugar santo y la ley:", "words": [[0, 117148], [2, 117255], [11, 117715], [20, 118315], [28, 119195], [32, 119415], [41, 120414], [46, 120615], [53, 120895], [56, 121115], [61, 121535], [64, 121615], [71, 121835], [80, 122315], [90, 122995], [97, 123395], [102, 123655], [108, 123915], [114, 124415], [116, 124575], [119, 124655]]}, {"verse": 14, "start": 125459, "end": 132633, "text": "Porque le hemos oído decir, que este Jesús de Nazaret destruirá este lugar, y cambiará las ordenanzas que nos dio Moisés.", "words": [[0, 125459], [7, 125712], [10, 125872], [16, 126072], [21, 126472], [28, 126872], [32, 127472], [37, 127692], [43, 128012], [46, 128272], [54, 128672], [64, 129252], [69, 129392], [76, 129752], [78, 130272], [87, 130712], [91, 130892], [102, 131572], [106, 131672], [110, 131792], [114, 131972]]}, {"verse": 15, "start": 132983, "end": 142039, "text": "Entonces todos los que estaban sentados en el Consejo, puestos los ojos en él, vieron su rostro como el rostro de un ángel.", "words": [[0, 132983], [9, 133947], [15, 134267], [19, 134567], [23, 134707], [31, 135067], [40, 135787], [43, 135987], [46, 136127], [55, 137047], [63, 137507], [67, 137847], [72, 138247], [75, 138527], [79, 139007], [86, 139307], [89, 139527], [96, 140107], [101, 140367], [104, 140567], [111, 141107], [114, 141227], [117, 141347]]}]}