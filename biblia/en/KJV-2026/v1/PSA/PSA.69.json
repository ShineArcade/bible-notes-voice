{"book": "PSA", "chapter": 69, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 214975, "verses": [{"verse": 1, "start": 300, "end": 3890, "text": "Save me, O God; for the waters are come in to my soul.", "words": [[0, 300], [5, 500], [9, 880], [11, 960], [16, 1788], [20, 1896], [24, 2036], [31, 2396], [35, 2616], [40, 2782], [43, 2948], [46, 3116], [49, 3336]]}, {"verse": 2, "start": 4240, "end": 10958, "text": "I sink in deep mire, where there is no standing: I am come into deep waters, where the floods overflow me.", "words": [[0, 4240], [2, 4381], [7, 4701], [10, 4921], [15, 5161], [21, 5661], [27, 6061], [33, 6261], [36, 6421], [39, 6601], [49, 7546], [51, 7676], [54, 7796], [59, 8016], [64, 8236], [69, 8536], [77, 9016], [83, 9476], [87, 9636], [94, 9996], [103, 10436]]}, {"verse": 3, "start": 11308, "end": 17522, "text": "I am weary of my crying: my throat is dried: my eyes fail while I wait for my God.", "words": [[0, 11308], [2, 11508], [5, 11628], [11, 11948], [14, 12188], [17, 12348], [25, 13244], [28, 13584], [35, 13824], [38, 14044], [45, 14927], [48, 15208], [53, 15468], [58, 15888], [64, 16168], [66, 16348], [71, 16548], [75, 16748], [78, 16928]]}, {"verse": 4, "start": 17872, "end": 27626, "text": "They that hate me without a cause are more than the hairs of my head: they that would destroy me, being my enemies wrongfully, are mighty: then I restored that which I took not away.", "words": [[0, 17872], [5, 17999], [10, 18199], [15, 18479], [18, 18719], [26, 18999], [28, 19139], [34, 19499], [38, 19719], [43, 19939], [48, 20139], [52, 20259], [58, 20479], [61, 20679], [64, 20859], [70, 21577], [75, 21671], [80, 21851], [86, 22011], [94, 22491], [98, 22931], [104, 23091], [107, 23331], [115, 23611], [127, 24471], [131, 24551], [139, 25269], [144, 25397], [146, 25537], [155, 25937], [160, 26237], [166, 26457], [168, 26597], [173, 26797], [177, 27017]]}, {"verse": 5, "start": 27976, "end": 32086, "text": "O God, you know my foolishness; and my sins are not hid from you.", "words": [[0, 28031], [2, 28121], [7, 28621], [11, 28621], [16, 28821], [19, 29001], [32, 30176], [36, 30436], [39, 30616], [44, 30996], [48, 31256], [52, 31436], [56, 31696], [61, 31996]]}, {"verse": 6, "start": 32436, "end": 42360, "text": "Let not them that wait on you, O Lord GOD of hosts, be ashamed for my sake: let not those that seek you be confounded for my sake, O God of Israel.", "words": [[0, 32436], [4, 32583], [8, 32823], [13, 33143], [18, 33423], [23, 33643], [26, 33883], [31, 34223], [33, 34383], [38, 34643], [42, 34983], [45, 35163], [52, 35983], [55, 36163], [63, 36583], [67, 36863], [70, 37083], [76, 37847], [80, 37977], [84, 38197], [90, 38497], [95, 38777], [100, 39017], [104, 39237], [107, 39397], [118, 40077], [122, 40277], [125, 40477], [131, 41217], [133, 41297], [137, 41577], [140, 41737]]}, {"verse": 7, "start": 42710, "end": 47205, "text": "Because for your sake I have borne reproach; shame has covered my face.", "words": [[0, 42710], [8, 42890], [12, 43150], [17, 43330], [22, 43670], [24, 43950], [29, 44130], [35, 44470], [45, 45398], [51, 45699], [55, 45939], [63, 46279], [66, 46539]]}, {"verse": 8, "start": 47555, "end": 52478, "text": "I am become a stranger to my brethren, and an alien to my mother’s children.", "words": [[0, 47555], [2, 47758], [5, 47898], [12, 48178], [14, 48358], [23, 48778], [26, 49058], [29, 49238], [39, 49678], [43, 50338], [46, 50498], [52, 50858], [55, 51178], [58, 51358], [67, 51798]]}, {"verse": 9, "start": 52828, "end": 58775, "text": "For the zeal of your house has eaten me up; and the reproaches of them that reproached you are fallen upon me.", "words": [[0, 52828], [4, 52913], [8, 53033], [13, 53433], [16, 53553], [21, 53673], [27, 54053], [31, 54253], [37, 54433], [40, 54693], [44, 55191], [48, 55319], [52, 55439], [63, 55979], [66, 56219], [71, 56399], [76, 56579], [87, 57179], [91, 57379], [95, 57619], [102, 57959], [107, 58239]]}, {"verse": 10, "start": 59125, "end": 63926, "text": "When I wept, and chastened my soul with fasting, that was to my reproach.", "words": [[0, 59125], [5, 59252], [7, 59392], [13, 59772], [17, 59952], [27, 60452], [30, 60652], [35, 60972], [40, 61192], [49, 62412], [54, 62672], [58, 62892], [61, 63032], [64, 63192]]}, {"verse": 11, "start": 64276, "end": 68398, "text": "I made sackcloth also my garment; and I became a proverb to them.", "words": [[0, 64276], [2, 64399], [7, 64579], [17, 65339], [22, 65659], [25, 65879], [34, 66721], [38, 66858], [40, 66958], [47, 67218], [49, 67418], [57, 67758], [60, 68058]]}, {"verse": 12, "start": 68748, "end": 72933, "text": "They that sit in the gate speak against me; and I was the song of the drunkards.", "words": [[0, 68748], [5, 68864], [10, 69024], [14, 69264], [17, 69424], [21, 69544], [26, 69724], [32, 70024], [40, 70364], [44, 71086], [48, 71229], [50, 71409], [54, 71569], [58, 71709], [63, 71989], [66, 72149], [70, 72249]]}, {"verse": 13, "start": 73283, "end": 82589, "text": "But as for me, my prayer is to you, O LORD, in an acceptable time: O God, in the multitude of your mercy hear me, in the truth of your salvation.", "words": [[0, 73283], [4, 73407], [7, 73587], [11, 73767], [15, 74407], [18, 74567], [25, 74887], [28, 75127], [31, 75307], [36, 75667], [38, 75787], [44, 76347], [47, 76467], [50, 76587], [61, 77047], [67, 78031], [69, 78180], [74, 78700], [77, 78760], [81, 78840], [91, 79200], [94, 79520], [99, 79640], [105, 80000], [110, 80360], [114, 80900], [117, 81020], [121, 81120], [127, 81420], [130, 81640], [135, 81740]]}, {"verse": 14, "start": 82939, "end": 89722, "text": "Deliver me out of the mire, and let me not sink: let me be delivered from them that hate me, and out of the deep waters.", "words": [[0, 82939], [8, 83260], [11, 83420], [15, 83620], [18, 83700], [22, 83820], [28, 84280], [32, 84520], [36, 84680], [39, 84840], [43, 85060], [49, 85903], [53, 86032], [56, 86192], [59, 86332], [69, 86712], [74, 87012], [79, 87212], [84, 87412], [89, 87632], [93, 87912], [97, 88392], [101, 88632], [104, 88752], [108, 88852], [113, 89052]]}, {"verse": 15, "start": 90072, "end": 97030, "text": "Let not the waterflood overflow me, neither let the deep swallow me up, and let not the pit shut her mouth upon me.", "words": [[0, 90072], [4, 90239], [8, 90539], [12, 90959], [23, 91379], [32, 91759], [36, 92619], [44, 92819], [48, 93099], [52, 93239], [57, 93439], [65, 93739], [68, 94099], [72, 94539], [76, 94819], [80, 94999], [84, 95259], [88, 95439], [92, 95639], [97, 95919], [101, 96059], [107, 96319], [112, 96599]]}, {"verse": 16, "start": 97380, "end": 104439, "text": "Hear me, O LORD; for your lovingkindness is good: turn to me according to the multitude of your tender mercies.", "words": [[0, 97380], [5, 97591], [9, 97871], [11, 98051], [17, 98770], [21, 99070], [26, 99630], [41, 100190], [44, 100350], [50, 101068], [55, 101268], [58, 101468], [61, 101648], [71, 102048], [74, 102308], [78, 102428], [88, 102908], [91, 103208], [96, 103348], [103, 103628]]}, {"verse": 17, "start": 104789, "end": 109834, "text": "And hide not your face from your servant; for I am in trouble: hear me speedily.", "words": [[0, 104789], [4, 104936], [9, 105196], [13, 105476], [18, 105676], [23, 105996], [28, 106236], [33, 106396], [42, 107261], [46, 107388], [48, 107688], [51, 107828], [54, 107948], [63, 108739], [68, 108902], [71, 109082]]}, {"verse": 18, "start": 110184, "end": 114193, "text": "Draw near to my soul, and redeem it: deliver me because of my enemies.", "words": [[0, 110184], [5, 110344], [10, 110564], [13, 110744], [16, 110904], [22, 111284], [26, 111524], [33, 111844], [37, 112387], [45, 112729], [48, 112889], [56, 113169], [59, 113369], [62, 113529]]}, {"verse": 19, "start": 114543, "end": 120688, "text": "You have known my reproach, and my shame, and my dishonour: my adversaries are all before you.", "words": [[0, 114543], [4, 114672], [9, 114832], [15, 115012], [18, 115252], [28, 116092], [32, 116132], [35, 116312], [42, 116972], [46, 116992], [49, 117422], [60, 118023], [63, 118303], [75, 119043], [79, 119223], [83, 119403], [90, 119703]]}, {"verse": 20, "start": 121038, "end": 129863, "text": "Reproach has broken my heart; and I am full of heaviness: and I looked for some to take pity, but there was none; and for comforters, but I found none.", "words": [[0, 121038], [9, 121547], [13, 121667], [20, 121967], [23, 122267], [30, 122971], [34, 123092], [36, 123252], [39, 123372], [44, 123632], [47, 123792], [58, 124773], [62, 125093], [64, 125213], [71, 125413], [75, 125593], [80, 125833], [83, 126013], [88, 126233], [94, 126693], [98, 126773], [104, 126973], [108, 127213], [114, 127803], [118, 127963], [122, 128123], [134, 129023], [138, 129183], [140, 129343], [146, 129603]]}, {"verse": 21, "start": 130213, "end": 134770, "text": "They gave me also gall for my food; and in my thirst they gave me vinegar to drink.", "words": [[0, 130213], [5, 130309], [10, 130509], [13, 130709], [18, 130929], [23, 131309], [27, 131529], [30, 131729], [36, 132479], [40, 132601], [43, 132721], [46, 132901], [53, 133341], [58, 133481], [63, 133641], [66, 133801], [74, 134101], [77, 134321]]}, {"verse": 22, "start": 135120, "end": 141377, "text": "Let their table become a snare before them: and that which should have been for their welfare, let it become a trap.", "words": [[0, 135120], [4, 135247], [10, 135387], [16, 135687], [23, 135987], [25, 136187], [31, 136447], [38, 136787], [44, 137464], [48, 137608], [53, 137848], [59, 138088], [66, 138348], [71, 138488], [76, 138708], [80, 138888], [86, 139048], [95, 140008], [99, 140288], [102, 140408], [109, 140668], [111, 140868]]}, {"verse": 23, "start": 141727, "end": 147104, "text": "Let their eyes be darkened, that they see not; and make their loins continually to shake.", "words": [[0, 141727], [4, 141853], [10, 142053], [15, 142353], [18, 142593], [28, 143193], [33, 143473], [38, 143633], [42, 143853], [47, 144602], [51, 144747], [56, 144947], [62, 145167], [68, 145607], [80, 146307], [83, 146587]]}, {"verse": 24, "start": 147454, "end": 152395, "text": "Pour out your indignation upon them, and let your wrathful anger take hold of them.", "words": [[0, 147454], [5, 147622], [9, 147882], [14, 148042], [26, 148782], [31, 149062], [37, 149782], [41, 149982], [45, 150162], [50, 150342], [59, 150902], [65, 151262], [70, 151582], [75, 151862], [78, 152062]]}, {"verse": 25, "start": 152745, "end": 157124, "text": "Let their habitation be desolate; and let none dwell in their tents.", "words": [[0, 152745], [4, 152892], [10, 153112], [21, 153712], [24, 153972], [34, 154912], [38, 155212], [42, 155392], [47, 155652], [53, 156032], [56, 156332], [62, 156472]]}, {"verse": 26, "start": 157474, "end": 162718, "text": "For they persecute him whom you have struck; and they talk to the grief of those whom you have wounded.", "words": [[0, 157474], [4, 157574], [9, 157754], [19, 158514], [23, 158654], [28, 158874], [32, 159094], [37, 159274], [45, 160053], [49, 160195], [54, 160315], [59, 160555], [62, 160755], [66, 160875], [72, 161115], [75, 161335], [81, 161575], [86, 161815], [90, 161995], [95, 162175]]}, {"verse": 27, "start": 163068, "end": 167346, "text": "Add iniquity to their iniquity: and let them not come into your righteousness.", "words": [[0, 163068], [4, 163294], [13, 163814], [16, 163994], [22, 164174], [32, 165042], [36, 165170], [40, 165330], [45, 165530], [49, 165730], [54, 166010], [59, 166270], [64, 166470]]}, {"verse": 28, "start": 167696, "end": 172077, "text": "Let them be blotted out of the book of the living, and not be written with the righteous.", "words": [[0, 167696], [4, 167823], [9, 168023], [12, 168203], [20, 168643], [24, 168883], [27, 169003], [31, 169123], [36, 169323], [39, 169463], [43, 169603], [51, 169843], [55, 170403], [59, 170603], [62, 170803], [70, 171103], [75, 171263], [79, 171423]]}, {"verse": 29, "start": 172427, "end": 177753, "text": "But I am poor and sorrowful: let your salvation, O God, set me up on high.", "words": [[0, 172427], [4, 172544], [6, 172744], [9, 172904], [14, 173224], [18, 173504], [29, 174483], [33, 174609], [38, 174789], [49, 175549], [51, 175829], [56, 176509], [60, 176689], [63, 176869], [66, 177089], [69, 177249]]}, {"verse": 30, "start": 178103, "end": 183338, "text": "I will praise the name of God with a song, and will magnify him with thanksgiving.", "words": [[0, 178103], [2, 178269], [7, 178409], [14, 178789], [18, 179049], [23, 179309], [26, 179509], [30, 179869], [35, 180109], [37, 180229], [43, 181089], [47, 181189], [52, 181329], [60, 181989], [64, 182269], [69, 182489]]}, {"verse": 31, "start": 183688, "end": 188614, "text": "This also shall please the LORD better than an ox or bullock that has horns and hoofs.", "words": [[0, 183688], [5, 183853], [10, 184233], [16, 184513], [23, 184833], [27, 185113], [32, 185373], [39, 185733], [44, 185993], [47, 186113], [50, 186453], [53, 186613], [61, 187053], [66, 187253], [70, 187473], [76, 187833], [80, 188073]]}, {"verse": 32, "start": 188964, "end": 193445, "text": "The humble shall see this, and be glad: and your heart shall live that seek God.", "words": [[0, 188964], [4, 189078], [11, 189318], [17, 189638], [21, 189918], [27, 190138], [31, 190378], [34, 190538], [40, 191314], [44, 191461], [49, 191581], [55, 191821], [61, 192101], [66, 192361], [71, 192681], [76, 193001]]}, {"verse": 33, "start": 193795, "end": 197196, "text": "For the LORD hears the poor, and despises not his prisoners.", "words": [[0, 193795], [4, 193883], [8, 194003], [13, 194263], [19, 194543], [23, 194823], [29, 195143], [33, 195403], [42, 196003], [46, 196243], [50, 196423]]}, {"verse": 34, "start": 197546, "end": 201436, "text": "Let the heaven and earth praise him, the seas, and every thing that moves in it.", "words": [[0, 197546], [4, 197691], [8, 197851], [15, 198131], [19, 198331], [25, 198571], [32, 198911], [37, 199491], [41, 199531], [47, 200091], [51, 200198], [57, 200304], [63, 200411], [68, 200751], [74, 200971], [77, 201231]]}, {"verse": 35, "start": 201786, "end": 208455, "text": "For God will save Zion, and will build the cities of Judah: that they may dwell there, and have it in possession.", "words": [[0, 201786], [4, 201889], [8, 202129], [13, 202349], [18, 202629], [24, 202989], [28, 203509], [33, 203649], [39, 203949], [43, 204129], [50, 204409], [53, 204609], [60, 205275], [65, 205411], [70, 205571], [74, 205811], [80, 206151], [87, 206591], [91, 207131], [96, 207391], [99, 207531], [102, 207671]]}, {"verse": 36, "start": 208805, "end": 214575, "text": "The seed also of his servants shall inherit it: and they that love his name shall dwell in it.", "words": [[0, 208805], [4, 208912], [9, 209192], [14, 209572], [17, 209892], [21, 210032], [30, 210412], [36, 210752], [44, 211152], [48, 211945], [52, 212093], [57, 212313], [62, 212593], [67, 212853], [71, 213093], [76, 213373], [82, 213673], [88, 213973], [91, 214253]]}]}