{"book": "ACT", "chapter": 25, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 236953, "verses": [{"verse": 1, "start": 300, "end": 7416, "text": "Festo pues, entrado en la provincia, tres días después subió de Cesarea a Jerusalén.", "words": [[0, 300], [6, 780], [12, 1360], [20, 1920], [23, 2020], [26, 2160], [37, 3320], [42, 3620], [47, 4020], [55, 4460], [61, 5320], [64, 5580], [72, 6140], [74, 6460]]}, {"verse": 2, "start": 7766, "end": 15299, "text": "Y vinieron a él los principales sacerdotes y los principales de los judíos contra Pablo; y le rogaron,", "words": [[0, 7766], [2, 7890], [11, 8370], [13, 8570], [16, 8830], [20, 9210], [32, 9950], [43, 10790], [45, 11190], [49, 11330], [61, 12010], [64, 12150], [68, 12270], [75, 12830], [82, 13190], [89, 14217], [91, 14358], [94, 14846]]}, {"verse": 3, "start": 15649, "end": 23582, "text": "Pidiendo como favor contra él, que le hiciese traer a Jerusalén, poniendo ellos emboscadas para matarle en el camino.", "words": [[0, 15649], [9, 16132], [14, 16372], [20, 16732], [27, 17152], [31, 17872], [35, 18112], [38, 18252], [46, 18732], [52, 19232], [54, 19292], [65, 20452], [74, 20932], [80, 21152], [91, 21992], [96, 22232], [104, 22772], [107, 22912], [110, 23012]]}, {"verse": 4, "start": 23932, "end": 30590, "text": "Pero Festo respondió, que Pablo estaba guardado en Cesarea, y que él mismo partiría en breve.", "words": [[0, 23932], [5, 24118], [11, 24738], [22, 25443], [26, 25583], [32, 25963], [39, 26243], [48, 26883], [51, 27043], [60, 27583], [62, 28223], [66, 28383], [69, 28703], [75, 29063], [84, 29923], [87, 30063]]}, {"verse": 5, "start": 30810, "end": 37638, "text": "Los que de vosotros pueden, dijo, desciendan juntamente; y si hay algún crimen en este hombre, acúsenle.", "words": [[0, 30810], [4, 30951], [8, 31131], [11, 31211], [20, 31651], [28, 32593], [34, 33368], [45, 34013], [57, 35140], [59, 35289], [62, 35369], [66, 35529], [72, 35789], [79, 36189], [82, 36289], [87, 36529], [95, 36849]]}, {"verse": 6, "start": 37918, "end": 47964, "text": "Y permaneciendo entre ellos no más de ocho o diez días, venido a Cesarea, el siguiente día se sentó en el tribunal, y mandó que Pablo fuese traído.", "words": [[0, 37918], [2, 38042], [16, 38922], [22, 39202], [28, 39562], [31, 39802], [35, 40002], [38, 40182], [43, 40602], [45, 40722], [50, 40982], [56, 41842], [63, 42182], [65, 42322], [74, 43222], [77, 43342], [87, 43622], [91, 44062], [94, 44242], [100, 44662], [103, 44762], [106, 44882], [116, 45502], [118, 45922], [124, 46262], [128, 46362], [134, 46802], [140, 47162]]}, {"verse": 7, "start": 48314, "end": 58410, "text": "El cual venido, le rodearon los judíos que habían venido de Jerusalén, poniendo contra Pablo muchas y graves acusaciones, las cuales no podían probar;", "words": [[0, 48314], [3, 48476], [8, 48716], [16, 49236], [19, 49416], [28, 50016], [32, 50216], [39, 50716], [43, 50856], [50, 51116], [57, 51556], [60, 51716], [71, 52436], [80, 53116], [87, 53456], [93, 53936], [100, 54516], [102, 54936], [109, 55216], [122, 56556], [126, 56676], [133, 56936], [136, 57436], [143, 57816]]}, {"verse": 8, "start": 58760, "end": 66584, "text": "Alegando él por su parte: Ni contra la ley de los judíos, ni contra el templo, ni contra César he pecado en nada.", "words": [[0, 59012], [9, 59302], [12, 59502], [16, 59682], [19, 59862], [26, 60729], [29, 60851], [36, 61231], [39, 61411], [43, 61631], [46, 61751], [50, 61871], [58, 62711], [61, 62951], [68, 63311], [71, 63451], [79, 64251], [82, 64311], [89, 64671], [95, 65431], [98, 65531], [105, 65951], [108, 66131]]}, {"verse": 9, "start": 66864, "end": 77007, "text": "Pero Festo, queriendo congraciarse con los judíos, respondiendo a Pablo, dijo: ¿Quieres subir a Jerusalén, y allá ser juzgado de estas cosas delante de mí?", "words": [[0, 67107], [5, 67384], [12, 67662], [22, 68054], [35, 69034], [39, 69234], [43, 69394], [51, 70274], [64, 71094], [66, 71254], [73, 71754], [79, 72495], [88, 72750], [94, 72930], [96, 73070], [107, 73790], [109, 74290], [114, 74470], [118, 74690], [126, 75210], [129, 75430], [135, 75630], [141, 76050], [149, 76570], [152, 76710]]}, {"verse": 10, "start": 77287, "end": 86571, "text": "Y Pablo dijo: Ante el tribunal de César estoy, donde conviene que sea juzgado. A los judíos no he hecho ningún agravio, como tú sabes muy bien.", "words": [[0, 77287], [2, 77432], [8, 77772], [14, 78520], [19, 78734], [22, 78814], [31, 79234], [34, 79394], [40, 79854], [47, 80754], [53, 80894], [62, 81454], [66, 81594], [70, 81814], [79, 82787], [81, 82873], [85, 82993], [92, 83473], [95, 83633], [98, 83813], [104, 84013], [111, 84293], [120, 85233], [125, 85393], [128, 85593], [134, 85893], [138, 86133]]}, {"verse": 11, "start": 86921, "end": 98174, "text": "Porque si algún agravio, o cosa alguna digna de muerte he hecho, no rehuso morir; pero si nada hay de las cosas de que estos me acusan, nadie puede darme a ellos. A César apelo.", "words": [[0, 86921], [7, 87111], [10, 87351], [16, 87651], [25, 88291], [27, 88551], [32, 88831], [39, 89191], [45, 89651], [48, 89751], [55, 89901], [58, 90051], [65, 90931], [68, 91261], [75, 91591], [82, 92312], [87, 92454], [90, 92634], [95, 92874], [99, 93154], [102, 93274], [106, 93414], [112, 93774], [115, 94034], [119, 94174], [125, 94414], [128, 94674], [136, 95414], [142, 95734], [148, 95994], [154, 96454], [156, 96554], [163, 97474], [165, 97724], [171, 97974]]}, {"verse": 12, "start": 98454, "end": 105183, "text": "Entonces Festo, habiendo hablado con el consejo, respondió: ¿A César has apelado? a César irás.", "words": [[0, 98454], [9, 99365], [16, 99837], [25, 100197], [33, 100677], [37, 100857], [40, 100997], [49, 101677], [60, 102786], [63, 103066], [69, 103346], [73, 103626], [82, 104334], [84, 104629], [90, 104924]]}, {"verse": 13, "start": 105463, "end": 111742, "text": "Y pasados algunos días, el rey Agripa y Bernice vinieron a Cesarea a saludar a Festo.", "words": [[0, 105463], [2, 105606], [10, 106026], [18, 106386], [24, 106706], [27, 106986], [31, 107566], [38, 108146], [40, 108266], [48, 108846], [57, 109546], [59, 109786], [67, 110466], [69, 110566], [77, 111106], [79, 111166]]}, {"verse": 14, "start": 112092, "end": 120273, "text": "Y como estuvieron allí muchos días, Festo declaró la causa de Pablo al rey, diciendo: Un hombre ha sido dejado preso por Félix,", "words": [[0, 112092], [2, 112178], [7, 112358], [18, 112898], [23, 113078], [30, 113318], [36, 114138], [42, 114678], [50, 115278], [53, 115398], [59, 115738], [62, 115998], [68, 116278], [71, 116478], [76, 117098], [86, 118076], [89, 118181], [96, 118421], [99, 118581], [104, 118741], [111, 119141], [117, 119541], [121, 119701]]}, {"verse": 15, "start": 120623, "end": 129135, "text": "Sobre el cual, cuando fui a Jerusalén, vinieron a mí los principales sacerdotes y los ancianos de los judíos, pidiendo condenación contra él:", "words": [[0, 120623], [6, 120885], [9, 121045], [15, 121505], [22, 121745], [26, 121985], [28, 122085], [39, 123105], [48, 123445], [50, 123545], [53, 123685], [57, 123845], [69, 124585], [80, 125345], [82, 125545], [86, 125705], [95, 126165], [98, 126305], [102, 126425], [110, 127245], [119, 127785], [131, 128405], [138, 128765]]}, {"verse": 16, "start": 129485, "end": 139962, "text": "A los cuales respondí, no ser costumbre de los Romanos dar alguno a la muerte antes que el que es acusado tenga presentes sus acusadores, y haya lugar de defenderse de la acusación.", "words": [[0, 129485], [2, 129581], [6, 129681], [13, 129941], [23, 131141], [26, 131321], [30, 131501], [40, 132061], [43, 132181], [47, 132301], [55, 132801], [59, 132961], [66, 133441], [68, 133481], [71, 133541], [78, 134341], [84, 134661], [88, 134881], [91, 134961], [95, 135061], [98, 135181], [106, 135621], [112, 135991], [122, 136361], [126, 136581], [138, 137700], [140, 137791], [145, 137921], [151, 138181], [154, 138421], [165, 139001], [168, 139121], [171, 139221]]}, {"verse": 17, "start": 140312, "end": 147482, "text": "Así que, habiendo venido ellos juntos acá, sin ninguna demora, al día siguiente, sentado en el tribunal, mandé traer al hombre;", "words": [[0, 140312], [4, 140532], [9, 140812], [18, 141072], [25, 141472], [31, 141692], [38, 142032], [43, 142832], [47, 142952], [55, 143352], [63, 143832], [66, 144112], [70, 144252], [81, 144592], [89, 145352], [92, 145472], [95, 145552], [105, 146272], [111, 146652], [117, 146952], [120, 147092]]}, {"verse": 18, "start": 147832, "end": 152736, "text": "Y estando presentes los acusadores, ningún cargo produjeron de los que yo sospechaba:", "words": [[0, 147832], [2, 147929], [10, 148289], [20, 148849], [24, 148949], [36, 150069], [43, 150309], [49, 150749], [60, 151429], [63, 151549], [67, 151669], [71, 151829], [74, 151969]]}, {"verse": 19, "start": 153086, "end": 162461, "text": "Solamente tenían contra él ciertas cuestiones acerca de su superstición, y de un cierto Jesús, difunto, el cual Pablo afirmaba que estaba vivo.", "words": [[0, 153086], [10, 153651], [17, 154051], [24, 154431], [27, 154691], [35, 155211], [46, 155771], [53, 156111], [56, 156391], [59, 156531], [73, 157811], [75, 158051], [78, 158171], [81, 158331], [88, 158591], [95, 159551], [104, 160551], [107, 160651], [112, 160811], [118, 161171], [127, 161651], [131, 161771], [138, 162051]]}, {"verse": 20, "start": 162811, "end": 169725, "text": "Y yo, dudando en cuestión semejante, dije, si quería ir a Jerusalén, y allá ser juzgado de estas cosas.", "words": [[0, 162811], [2, 162955], [6, 163115], [14, 163575], [17, 163755], [26, 164055], [37, 164975], [43, 165615], [46, 165815], [53, 166155], [56, 166375], [58, 166475], [69, 167195], [71, 167535], [76, 167715], [80, 167975], [88, 168535], [91, 168735], [97, 168935]]}, {"verse": 21, "start": 170075, "end": 177527, "text": "Pero apelando Pablo a quedar bajo custodia para la decisión del emperador, mandé que le guardasen hasta que le enviara a César.", "words": [[0, 170075], [5, 170207], [14, 170727], [20, 171107], [22, 171307], [29, 171507], [34, 171827], [43, 172467], [48, 172727], [51, 172867], [60, 173427], [64, 173547], [75, 174507], [81, 174927], [85, 175027], [88, 175407], [98, 175787], [104, 176087], [108, 176287], [111, 176427], [119, 176847], [121, 177007]]}, {"verse": 22, "start": 177807, "end": 185385, "text": "Entonces Agripa dijo a Festo: Yo también quisiera oír a ese hombre. Y él dijo: Mañana le oirás.", "words": [[0, 177807], [9, 178493], [16, 179413], [21, 179953], [23, 180173], [30, 180928], [33, 181091], [41, 181331], [50, 181851], [54, 182151], [56, 182231], [60, 182391], [68, 183139], [70, 183328], [73, 183488], [79, 184206], [86, 184592], [89, 184812]]}, {"verse": 23, "start": 185665, "end": 198220, "text": "Y al otro día, viniendo Agripa y Bernice con gran pompa, y entrando en la audiencia con los comandantes y principales hombres de la ciudad, por mandato de Festo, fue traído Pablo.", "words": [[0, 185665], [2, 185808], [5, 185908], [10, 186148], [15, 187108], [24, 187718], [31, 188328], [33, 188678], [41, 189028], [45, 189308], [50, 189548], [57, 190228], [59, 190388], [68, 191048], [71, 191188], [74, 191348], [84, 191988], [88, 192208], [92, 192368], [104, 193068], [106, 193228], [118, 193868], [126, 194188], [129, 194408], [132, 194508], [140, 194848], [144, 195488], [152, 195948], [155, 196128], [162, 196949], [166, 197098], [173, 197518]]}, {"verse": 24, "start": 198570, "end": 213438, "text": "Entonces Festo dijo: Rey Agripa, y todos los varones que estáis aquí juntos con nosotros: veis a este, por el cual toda la multitud de los judíos me ha pedido en Jerusalén y aquí, dando voces que no conviene que viva más;", "words": [[0, 198570], [9, 199576], [15, 200056], [21, 200869], [25, 201288], [33, 201748], [35, 201948], [41, 202128], [45, 202368], [53, 202768], [57, 202948], [64, 203288], [69, 203468], [76, 203808], [80, 204168], [90, 205160], [95, 205457], [97, 205577], [103, 205897], [107, 206137], [110, 206277], [115, 206497], [120, 206817], [123, 207077], [132, 207617], [135, 207777], [139, 207897], [146, 208377], [149, 208537], [152, 208637], [159, 209037], [162, 209157], [172, 210177], [174, 210237], [180, 210957], [186, 211217], [192, 211677], [196, 211877], [199, 212037], [208, 212517], [212, 212677], [217, 212957]]}, {"verse": 25, "start": 213788, "end": 220385, "text": "Pero yo, hallando que ninguna cosa digna de muerte ha hecho, y él mismo apelando al emperador, he determinado enviarle:", "words": [[0, 213788], [5, 213945], [9, 214125], [18, 214505], [22, 214665], [30, 214965], [35, 215385], [41, 215805], [44, 215885], [51, 216165], [54, 216425], [61, 217105], [63, 217185], [66, 217305], [72, 217565], [81, 218165], [84, 218265], [95, 218845], [98, 219065], [110, 219685]]}, {"verse": 26, "start": 220735, "end": 231467, "text": "Del cual no tengo cosa cierta que escriba al señor; por lo que le he sacado a vosotros, y mayormente a ti, oh rey Agripa, para que realizada la investigación, tenga yo qué escribir.", "words": [[0, 220735], [4, 220906], [9, 221126], [12, 221346], [18, 221606], [23, 221906], [30, 222446], [34, 222639], [42, 222833], [45, 223026], [52, 223744], [56, 223892], [59, 224012], [63, 224132], [66, 224292], [69, 224432], [76, 224832], [78, 224912], [88, 225452], [90, 225712], [101, 226292], [103, 226472], [107, 226702], [110, 226932], [114, 227192], [122, 227632], [127, 228192], [131, 228352], [141, 228932], [144, 229092], [159, 229792], [165, 230452], [168, 230692], [172, 230832]]}, {"verse": 27, "start": 231817, "end": 236553, "text": "Porque fuera de razón me parece enviar un preso, y no informar de las causas.", "words": [[0, 231817], [7, 232025], [13, 232305], [16, 232525], [22, 232925], [25, 233145], [32, 233505], [39, 233985], [42, 234105], [49, 234825], [51, 234985], [54, 235085], [63, 235645], [66, 235725], [70, 235885]]}]}