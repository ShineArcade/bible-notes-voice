{"book": "1CO", "chapter": 15, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 357253, "verses": [{"verse": 1, "start": 300, "end": 6961, "text": "Moreover, brethren, I declare to you the gospel which I preached to you, which also you have received, and in which you stand;", "words": [[0, 300], [10, 793], [20, 1633], [22, 1753], [30, 2033], [33, 2253], [37, 2373], [41, 2493], [48, 2873], [54, 3153], [56, 3343], [65, 3533], [68, 3773], [73, 4233], [79, 4393], [84, 4813], [88, 5053], [93, 5233], [103, 5673], [107, 5973], [110, 6073], [116, 6233], [120, 6393]]}, {"verse": 2, "start": 7411, "end": 12961, "text": "By which also you are saved, if you keep in memory what I preached to you, unless you have believed in vain.", "words": [[0, 7411], [3, 7582], [9, 7822], [14, 8202], [18, 8422], [22, 8562], [29, 9022], [32, 9382], [36, 9522], [41, 9782], [44, 9922], [51, 10222], [56, 10442], [58, 10622], [67, 10802], [70, 11082], [75, 11462], [82, 11702], [86, 11862], [91, 12022], [100, 12322], [103, 12542]]}, {"verse": 3, "start": 13411, "end": 19952, "text": "For I delivered to you first of all that which I also received, how that Christ died for our sins according to the scriptures;", "words": [[0, 13411], [4, 13579], [6, 13759], [16, 14059], [19, 14319], [23, 14439], [29, 14679], [32, 14899], [36, 15079], [41, 15339], [47, 15539], [49, 15699], [54, 15899], [64, 16799], [68, 16959], [73, 17159], [80, 17439], [85, 17819], [89, 18079], [93, 18239], [98, 18579], [108, 18879], [111, 19139], [115, 19239]]}, {"verse": 4, "start": 20402, "end": 24572, "text": "And that he was buried, and that he rose again the third day according to the scriptures:", "words": [[0, 20402], [4, 20552], [9, 20672], [12, 20752], [16, 20892], [24, 21672], [28, 21752], [33, 21892], [36, 21992], [41, 22172], [47, 22432], [51, 22612], [57, 22852], [61, 23092], [71, 23472], [74, 23752], [78, 23872]]}, {"verse": 5, "start": 25022, "end": 27723, "text": "And that he was seen of Cephas, then of the twelve:", "words": [[0, 25022], [4, 25153], [9, 25273], [12, 25393], [16, 25513], [21, 25753], [24, 26083], [32, 26413], [37, 26813], [40, 27033], [44, 27378]]}, {"verse": 6, "start": 28173, "end": 37006, "text": "After that, he was seen of above five hundred brethren at once; of whom the greater part remain to this present, but some are fallen asleep.", "words": [[0, 28173], [6, 28399], [12, 28919], [15, 29019], [19, 29199], [24, 29479], [27, 29839], [33, 30199], [38, 30559], [46, 30919], [55, 31499], [58, 31819], [64, 32715], [67, 32858], [72, 33098], [76, 33298], [84, 33618], [89, 33918], [96, 34278], [99, 34478], [104, 34658], [113, 35458], [117, 35578], [122, 35858], [126, 36078], [133, 36358]]}, {"verse": 7, "start": 37456, "end": 41485, "text": "After that, he was seen of James; then of all the apostles.", "words": [[0, 37456], [6, 37739], [12, 38259], [15, 38359], [19, 38519], [24, 38759], [27, 38899], [34, 39807], [39, 40024], [42, 40324], [46, 40604], [50, 40744]]}, {"verse": 8, "start": 41935, "end": 45908, "text": "And last of all he was seen of me also, as of one born out of due time.", "words": [[0, 41935], [4, 42072], [9, 42312], [12, 42512], [16, 42812], [19, 42872], [23, 43032], [28, 43232], [31, 43392], [34, 43572], [40, 43932], [43, 44232], [46, 44372], [50, 44612], [55, 44852], [59, 45112], [62, 45252], [66, 45412]]}, {"verse": 9, "start": 46358, "end": 52644, "text": "For I am the least of the apostles, that am not meet to be called an apostle, because I persecuted the church of God.", "words": [[0, 46358], [4, 46465], [6, 46765], [9, 46965], [13, 47125], [19, 47365], [22, 47545], [26, 47665], [36, 48505], [41, 48675], [44, 48845], [48, 49025], [53, 49205], [56, 49385], [59, 49505], [66, 49745], [69, 49925], [78, 50645], [86, 50905], [88, 51085], [99, 51565], [103, 51845], [110, 52085], [113, 52285]]}, {"verse": 10, "start": 53094, "end": 64350, "text": "But by the grace of God I am what I am: and his grace which was bestowed upon me was not in vain; but I laboured more abundantly than they all: yet not I, but the grace of God which was with me.", "words": [[0, 53094], [4, 53268], [7, 53508], [11, 53648], [17, 53908], [20, 54128], [24, 54348], [26, 54668], [29, 54808], [34, 54968], [36, 55208], [40, 55860], [44, 55983], [48, 56103], [54, 56383], [60, 56623], [64, 56803], [73, 57223], [78, 57403], [81, 57643], [85, 57823], [89, 58003], [92, 58183], [98, 58879], [102, 59002], [104, 59302], [113, 59602], [118, 59842], [129, 60522], [134, 60722], [139, 60902], [144, 61605], [148, 61731], [152, 61971], [155, 62371], [159, 62471], [163, 62631], [169, 62911], [172, 63191], [176, 63451], [182, 63691], [186, 63871], [191, 64071]]}, {"verse": 11, "start": 64800, "end": 68948, "text": "Therefore whether it were I or they, so we preach, and so you believed.", "words": [[0, 64800], [10, 65217], [18, 65417], [21, 65697], [26, 65917], [28, 66217], [31, 66457], [37, 67017], [40, 67117], [43, 67257], [51, 67577], [55, 68057], [58, 68237], [62, 68357]]}, {"verse": 12, "start": 69398, "end": 75357, "text": "Now if Christ be preached that he rose from the dead, how say some among you that there is no resurrection of the dead?", "words": [[0, 69398], [4, 69752], [7, 69792], [14, 70052], [17, 70252], [26, 70572], [31, 70792], [34, 70972], [39, 71192], [44, 71392], [48, 71512], [54, 72152], [58, 72352], [62, 72692], [67, 73012], [73, 73212], [77, 73532], [82, 73752], [88, 73912], [91, 74032], [94, 74212], [107, 74612], [110, 74912], [114, 75012]]}, {"verse": 13, "start": 75807, "end": 79637, "text": "But if there be no resurrection of the dead, then is Christ not risen:", "words": [[0, 75807], [4, 75930], [7, 76030], [13, 76150], [16, 76370], [19, 76550], [32, 76930], [35, 77310], [39, 77430], [45, 77970], [50, 78350], [53, 78510], [60, 78790], [64, 79110]]}, {"verse": 14, "start": 80087, "end": 84910, "text": "And if Christ be not risen, then is our preaching vain, and your faith is also vain.", "words": [[0, 80087], [4, 80210], [7, 80310], [14, 80590], [17, 80850], [21, 81050], [28, 81770], [33, 81970], [36, 82130], [40, 82290], [50, 82590], [56, 83270], [60, 83410], [65, 83530], [71, 83810], [74, 84190], [79, 84550]]}, {"verse": 15, "start": 85360, "end": 94291, "text": "Yes, and we are found false witnesses of God; because we have testified of God that he raised up Christ: whom he raised not up, if so be that the dead rise not.", "words": [[0, 85360], [5, 85844], [9, 85924], [12, 86064], [16, 86184], [22, 86404], [28, 86684], [38, 87144], [41, 87424], [46, 88125], [54, 88292], [57, 88492], [62, 88672], [72, 89032], [75, 89352], [79, 89552], [84, 89732], [87, 89852], [94, 90132], [97, 90292], [105, 91161], [110, 91404], [113, 91504], [120, 91764], [124, 92004], [128, 92544], [131, 92644], [134, 92844], [137, 92984], [142, 93184], [146, 93284], [151, 93584], [156, 93884]]}, {"verse": 16, "start": 94741, "end": 98018, "text": "For if the dead rise not, then is not Christ raised:", "words": [[0, 94741], [4, 94888], [7, 95048], [11, 95228], [16, 95528], [21, 95768], [26, 96568], [31, 96668], [34, 96848], [38, 97048], [45, 97428]]}, {"verse": 17, "start": 98468, "end": 102741, "text": "And if Christ be not raised, your faith is vain; you are yet in your sins.", "words": [[0, 98468], [4, 98573], [7, 98673], [14, 99033], [17, 99313], [21, 99533], [29, 100093], [34, 100193], [40, 100473], [43, 100653], [49, 101386], [53, 101512], [57, 101633], [61, 101852], [64, 102012], [69, 102133]]}, {"verse": 18, "start": 103191, "end": 106111, "text": "Then they also which are fallen asleep in Christ are perished.", "words": [[0, 103191], [5, 103395], [10, 103575], [15, 104095], [21, 104215], [25, 104355], [32, 104595], [39, 104955], [42, 105135], [49, 105495], [53, 105555]]}, {"verse": 19, "start": 106561, "end": 110528, "text": "If in this life only we have hope in Christ, we are of all men most miserable.", "words": [[0, 106561], [3, 106685], [6, 106805], [11, 106945], [16, 107205], [21, 107385], [24, 107565], [29, 107765], [34, 108005], [37, 108145], [45, 108805], [48, 108965], [52, 109085], [55, 109245], [59, 109485], [63, 109705], [68, 109925]]}, {"verse": 20, "start": 110978, "end": 115179, "text": "But now is Christ risen from the dead, and become the firstfruits of them that slept.", "words": [[0, 110978], [4, 111098], [8, 111318], [11, 111478], [18, 111718], [24, 112098], [29, 112318], [33, 112478], [39, 112758], [43, 113178], [50, 113418], [54, 113768], [66, 114118], [69, 114338], [74, 114498], [79, 114678]]}, {"verse": 21, "start": 115629, "end": 119617, "text": "For since by man came death, by man came also the resurrection of the dead.", "words": [[0, 115629], [4, 115715], [10, 115975], [13, 116195], [17, 116495], [22, 116655], [29, 117235], [32, 117415], [36, 117695], [41, 117855], [46, 118215], [50, 118435], [63, 118815], [66, 119195], [70, 119295]]}, {"verse": 22, "start": 120067, "end": 124055, "text": "For as in Adam all die, even so in Christ shall all be made alive.", "words": [[0, 120067], [4, 120178], [7, 120358], [10, 120518], [15, 120878], [19, 121198], [24, 121758], [29, 121918], [32, 122218], [35, 122358], [42, 122638], [48, 122898], [52, 123158], [55, 123338], [60, 123558]]}, {"verse": 23, "start": 124505, "end": 129931, "text": "But every man in his own order: Christ the firstfruits; afterward they that are Christ’s at his coming.", "words": [[0, 124505], [4, 124612], [10, 124872], [14, 125152], [17, 125272], [21, 125412], [25, 125692], [32, 126485], [39, 126705], [43, 127165], [56, 127866], [66, 128215], [71, 128605], [76, 128773], [80, 128941], [89, 129109], [92, 129277], [96, 129445]]}, {"verse": 24, "start": 130381, "end": 138522, "text": "Then comes the end, when he shall have delivered up the kingdom to God, even the Father; when he shall have put down all rule and all authority and power.", "words": [[0, 130381], [5, 130582], [11, 130842], [15, 131042], [20, 131642], [25, 131822], [28, 131942], [34, 132142], [39, 132302], [49, 132622], [52, 132842], [56, 132982], [64, 133262], [67, 133542], [72, 133982], [77, 134142], [81, 134322], [89, 135143], [94, 135280], [97, 135360], [103, 135540], [108, 135720], [112, 135940], [117, 136200], [121, 136480], [126, 136800], [130, 137080], [134, 137300], [144, 137720], [148, 138020]]}, {"verse": 25, "start": 138972, "end": 142890, "text": "For he must reign, till he has put all enemies under his feet.", "words": [[0, 138972], [4, 139091], [7, 139271], [12, 139571], [19, 139911], [24, 140471], [27, 140691], [31, 140831], [35, 141011], [39, 141331], [47, 141811], [53, 142251], [57, 142491]]}, {"verse": 26, "start": 143340, "end": 146021, "text": "The last enemy that shall be destroyed is death.", "words": [[0, 143340], [4, 143461], [9, 143741], [15, 144141], [20, 144381], [26, 144581], [29, 144721], [39, 145221], [42, 145621]]}, {"verse": 27, "start": 146471, "end": 155499, "text": "For he has put all things under his feet. But when he says all things are put under him, it is manifest that he is excepted, which did put all things under him.", "words": [[0, 146471], [4, 146613], [7, 146793], [11, 146973], [15, 147173], [19, 147433], [26, 147733], [32, 148053], [36, 148293], [42, 149004], [46, 149159], [51, 149359], [54, 149479], [59, 149719], [63, 150059], [70, 150299], [74, 150479], [78, 150659], [84, 150999], [89, 151599], [92, 151759], [95, 151899], [104, 152259], [109, 152639], [112, 152779], [115, 153259], [125, 153739], [131, 153919], [135, 154139], [139, 154339], [143, 154619], [150, 154859], [156, 155199]]}, {"verse": 28, "start": 155949, "end": 164932, "text": "And when all things shall be subdued to him, then shall the Son also himself be subject to him that put all things under him, that God may be all in all.", "words": [[0, 155949], [4, 156107], [9, 156327], [13, 156607], [20, 156887], [26, 157167], [29, 157307], [37, 157747], [40, 157867], [45, 158407], [50, 158647], [56, 158887], [60, 159087], [64, 159307], [69, 159687], [77, 160007], [80, 160407], [88, 160707], [91, 160987], [95, 161167], [100, 161507], [104, 161687], [108, 161987], [115, 162267], [121, 162607], [126, 163278], [131, 163444], [135, 163684], [139, 163924], [142, 164084], [146, 164364], [149, 164544]]}, {"verse": 29, "start": 165382, "end": 171784, "text": "Else what shall they do which are baptized for the dead, if the dead rise not at all? why are they then baptized for the dead?", "words": [[0, 165382], [5, 165604], [10, 165864], [16, 166104], [21, 166304], [24, 166724], [30, 166864], [34, 167004], [43, 167344], [47, 167664], [51, 167844], [57, 168244], [60, 168344], [64, 168484], [69, 168704], [74, 168964], [78, 169244], [81, 169444], [86, 170054], [90, 170214], [94, 170374], [99, 170514], [104, 170714], [113, 170994], [117, 171294], [121, 171434]]}, {"verse": 30, "start": 172234, "end": 174206, "text": "And why stand we in jeopardy every hour?", "words": [[0, 172234], [4, 172355], [8, 172495], [14, 172755], [17, 172955], [20, 173055], [29, 173515], [35, 173735]]}, {"verse": 31, "start": 174656, "end": 178876, "text": "I protest by your rejoicing which I have in Christ Jesus our Lord, I die daily.", "words": [[0, 174656], [2, 174801], [10, 175121], [13, 175461], [18, 175561], [28, 176101], [34, 176301], [36, 176441], [41, 176641], [44, 176761], [51, 176961], [57, 177341], [61, 177601], [67, 178081], [69, 178161], [73, 178361]]}, {"verse": 32, "start": 179326, "end": 188804, "text": "If after the manner of men I have fought with beasts at Ephesus, what advantage is it to me, if the dead rise not? let us eat and drink; for tomorrow we die.", "words": [[0, 179326], [3, 179468], [9, 179768], [13, 179968], [20, 180228], [23, 180428], [27, 180628], [29, 180808], [34, 180948], [41, 181248], [46, 181448], [53, 181748], [56, 182048], [65, 182988], [70, 183128], [80, 183548], [83, 183808], [86, 183928], [89, 184048], [93, 184268], [96, 184628], [100, 184748], [105, 184988], [110, 185228], [115, 186060], [119, 186182], [122, 186342], [126, 186642], [130, 186982], [137, 187748], [141, 187833], [150, 188133], [153, 188373]]}, {"verse": 33, "start": 189254, "end": 192802, "text": "Be not deceived: evil communications corrupt good manners.", "words": [[0, 189254], [3, 189340], [7, 189520], [17, 190522], [22, 190740], [37, 191480], [45, 191900], [50, 192180]]}, {"verse": 34, "start": 193252, "end": 198901, "text": "Awake to righteousness, and sin not; for some have not the knowledge of God: I speak this to your shame.", "words": [[0, 193252], [6, 193455], [9, 193695], [24, 194155], [28, 194475], [32, 194675], [37, 195465], [41, 195562], [46, 195802], [51, 195982], [55, 196142], [59, 196342], [69, 196642], [72, 196822], [77, 197544], [79, 197724], [85, 197904], [90, 198164], [93, 198304], [98, 198424]]}, {"verse": 35, "start": 199351, "end": 204059, "text": "But some man will say, How are the dead raised up? and with what body do they come?", "words": [[0, 199351], [4, 199494], [9, 199704], [13, 199914], [18, 200114], [23, 200878], [27, 201052], [31, 201252], [35, 201372], [40, 201612], [47, 201892], [51, 202522], [55, 202722], [60, 202882], [65, 203042], [70, 203342], [73, 203502], [78, 203622]]}, {"verse": 36, "start": 204509, "end": 207823, "text": "You fool, that which you sow is not made alive, unless it die:", "words": [[0, 204509], [4, 204635], [10, 204895], [15, 205135], [21, 205355], [25, 205515], [29, 205735], [32, 205895], [36, 206095], [41, 206315], [48, 206675], [55, 207155], [58, 207415]]}, {"verse": 37, "start": 208273, "end": 216055, "text": "And that which you sow, you sow not that body that shall be, but bare grain, it may chance of wheat, or of some other grain:", "words": [[0, 208273], [4, 208415], [9, 208615], [15, 208835], [19, 209055], [24, 209735], [28, 209875], [32, 210235], [36, 210695], [41, 210975], [46, 211315], [51, 211495], [57, 211815], [61, 212095], [65, 212495], [70, 212775], [77, 213475], [80, 213575], [84, 213715], [91, 214075], [94, 214255], [101, 214455], [104, 214975], [107, 215215], [112, 215415], [118, 215595]]}, {"verse": 38, "start": 216505, "end": 220753, "text": "But God gives it a body as it has pleased him, and to every seed his own body.", "words": [[0, 216505], [4, 216666], [8, 216966], [14, 217306], [17, 217466], [19, 217566], [24, 217846], [27, 218046], [30, 218146], [34, 218286], [42, 218546], [47, 219006], [51, 219226], [54, 219366], [60, 219666], [65, 219926], [69, 220126], [73, 220286]]}, {"verse": 39, "start": 221203, "end": 229458, "text": "All flesh is not the same flesh: but there is one kind of flesh of men, another flesh of beasts, another of fishes, and another of birds.", "words": [[0, 221203], [4, 221362], [10, 221642], [13, 221902], [17, 222082], [21, 222282], [26, 222442], [33, 223218], [37, 223394], [43, 223594], [46, 223754], [50, 224014], [55, 224234], [58, 224394], [64, 224614], [67, 224834], [72, 225494], [80, 225814], [86, 226194], [89, 226334], [97, 227134], [105, 227374], [108, 227634], [116, 227934], [120, 228374], [128, 228674], [131, 228894]]}, {"verse": 40, "start": 229908, "end": 237362, "text": "There are also celestial bodies, and bodies terrestrial: but the glory of the celestial is one, and the glory of the terrestrial is another.", "words": [[0, 229908], [6, 230030], [10, 230150], [15, 230350], [25, 230890], [33, 231330], [37, 231650], [44, 231950], [57, 233084], [61, 233180], [65, 233300], [71, 233620], [74, 233860], [78, 233960], [88, 234360], [91, 234620], [96, 235180], [100, 235500], [104, 235600], [110, 235940], [113, 236140], [117, 236220], [129, 236720], [132, 236940]]}, {"verse": 41, "start": 237812, "end": 246167, "text": "There is one glory of the sun, and another glory of the moon, and another glory of the stars: for one star differs from another star in glory.", "words": [[0, 237812], [6, 237928], [9, 238128], [13, 238428], [19, 238728], [22, 238968], [26, 239108], [31, 239408], [35, 239908], [43, 240188], [49, 240528], [52, 240748], [56, 240868], [62, 241108], [66, 241608], [74, 241848], [80, 242168], [83, 242408], [87, 242528], [94, 243474], [98, 243602], [102, 243842], [107, 244142], [115, 244442], [120, 244802], [128, 245142], [133, 245462], [136, 245642]]}, {"verse": 42, "start": 246617, "end": 252113, "text": "So also is the resurrection of the dead. It is sown in corruption; it is raised in incorruption:", "words": [[0, 246663], [3, 246713], [8, 247073], [11, 247333], [15, 247473], [28, 247933], [31, 248213], [35, 248333], [41, 249012], [44, 249132], [47, 249272], [52, 249532], [55, 249632], [67, 250622], [70, 250721], [73, 250861], [80, 251161], [83, 251381]]}, {"verse": 43, "start": 252563, "end": 258221, "text": "It is sown in dishonour; it is raised in glory: it is sown in weakness; it is raised in power:", "words": [[0, 252563], [3, 252686], [6, 252846], [11, 253006], [14, 253406], [25, 254065], [28, 254161], [31, 254281], [38, 254541], [41, 254721], [48, 255518], [51, 255623], [54, 255763], [59, 255903], [62, 256003], [72, 257004], [75, 257135], [78, 257295], [85, 257535], [88, 257735]]}, {"verse": 44, "start": 258671, "end": 265668, "text": "It is sown a natural body; it is raised a spiritual body. There is a natural body, and there is a spiritual body.", "words": [[0, 258671], [3, 258808], [6, 258968], [11, 259129], [13, 259269], [21, 259608], [27, 260436], [30, 260557], [33, 260717], [40, 260997], [42, 261237], [52, 261717], [58, 262481], [64, 262664], [67, 262844], [69, 262944], [77, 263244], [83, 263624], [87, 264124], [93, 264304], [96, 264464], [98, 264584], [108, 265004]]}, {"verse": 45, "start": 266118, "end": 272911, "text": "And so it is written, The first man Adam was made a living soul; the last Adam was made a life-giving spirit.", "words": [[0, 266118], [4, 266557], [7, 266797], [10, 266897], [13, 267017], [22, 267795], [26, 267945], [32, 268185], [36, 268485], [41, 268785], [45, 269105], [50, 269325], [52, 269425], [59, 269665], [65, 270548], [69, 270687], [74, 270947], [79, 271267], [83, 271507], [88, 271687], [90, 271987], [102, 272287]]}, {"verse": 46, "start": 273361, "end": 279533, "text": "However that was not first which is spiritual, but that which is natural; and afterward that which is spiritual.", "words": [[0, 273361], [8, 273922], [13, 274022], [17, 274242], [21, 274442], [27, 274762], [33, 275042], [36, 275182], [47, 275942], [51, 276122], [56, 276362], [62, 276582], [65, 276722], [74, 277565], [78, 277727], [88, 278087], [93, 278467], [99, 278707], [102, 278847]]}, {"verse": 47, "start": 279983, "end": 284469, "text": "The first man is of the earth, earthy: the second man is the Lord from heaven.", "words": [[0, 279983], [4, 280100], [10, 280360], [14, 280660], [17, 280920], [20, 281040], [24, 281200], [31, 281780], [39, 282613], [43, 282700], [50, 282980], [54, 283220], [57, 283460], [61, 283620], [66, 283800], [71, 284020]]}, {"verse": 48, "start": 284919, "end": 291786, "text": "As is the earthy, such are they also that are earthy: and as is the heavenly, such are they also that are heavenly.", "words": [[0, 284919], [3, 285086], [6, 285206], [10, 285346], [18, 286026], [23, 286206], [27, 286426], [32, 286566], [37, 287026], [42, 287286], [46, 287426], [54, 288200], [58, 288340], [61, 288620], [64, 288860], [68, 289040], [78, 289840], [83, 290120], [87, 290380], [92, 290520], [97, 290880], [102, 291100], [106, 291240]]}, {"verse": 49, "start": 292236, "end": 296304, "text": "And as we have borne the image of the earthy, we shall also bear the image of the heavenly.", "words": [[0, 292236], [4, 292341], [7, 292461], [10, 292621], [15, 292801], [21, 293121], [25, 293241], [31, 293381], [34, 293561], [38, 293721], [46, 294281], [49, 294381], [55, 294561], [60, 294901], [65, 295141], [69, 295361], [75, 295561], [78, 295781], [82, 295861]]}, {"verse": 50, "start": 296754, "end": 304061, "text": "Now this I say, brethren, that flesh and blood cannot inherit the kingdom of God; neither does corruption inherit incorruption.", "words": [[0, 296754], [4, 297088], [9, 297228], [11, 297428], [16, 297848], [26, 298528], [31, 298588], [37, 298888], [41, 299148], [47, 299408], [54, 299748], [62, 300268], [66, 300508], [74, 300768], [77, 300988], [82, 301684], [90, 301906], [95, 302166], [106, 302606], [114, 303186]]}, {"verse": 51, "start": 304511, "end": 309362, "text": "Behold, I show you a mystery; We shall not all sleep, but we shall all be changed,", "words": [[0, 304511], [8, 305011], [10, 305051], [15, 305251], [19, 305391], [21, 305451], [30, 306183], [33, 306282], [39, 306462], [43, 306662], [47, 307062], [54, 307722], [58, 307982], [61, 308142], [67, 308362], [71, 308662], [74, 308842]]}, {"verse": 52, "start": 309812, "end": 318441, "text": "In a moment, in the twinkling of an eye, at the last trumpet: for the trumpet shall sound, and the dead shall be raised incorruptible, and we shall be changed.", "words": [[0, 309812], [3, 309972], [5, 310052], [13, 310412], [16, 310612], [20, 310752], [30, 311112], [33, 311352], [36, 311492], [41, 311752], [44, 312132], [48, 312232], [53, 312512], [62, 313459], [66, 313563], [70, 313663], [78, 314043], [84, 314363], [91, 314863], [95, 315083], [99, 315203], [104, 315443], [110, 315643], [113, 315803], [120, 316063], [135, 316903], [139, 317303], [142, 317463], [148, 317663], [151, 317803]]}, {"verse": 53, "start": 318891, "end": 324180, "text": "For this corruptible must put on incorruption, and this mortal must put on immortality.", "words": [[0, 318891], [4, 318970], [9, 319170], [21, 319830], [26, 320190], [30, 320450], [33, 320890], [47, 321330], [51, 321810], [56, 322010], [63, 322370], [68, 322810], [72, 323010], [75, 323270]]}, {"verse": 54, "start": 324630, "end": 334913, "text": "So when this corruptible shall have put on incorruption, and this mortal shall have put on immortality, then shall be brought to pass the saying that is written, Death is swallowed up in victory.", "words": [[0, 324630], [3, 324743], [8, 324903], [13, 325103], [25, 325683], [31, 325903], [36, 326163], [40, 326423], [43, 326563], [57, 327163], [61, 327663], [66, 327903], [73, 328263], [79, 328603], [84, 328843], [88, 329043], [91, 329183], [104, 329923], [109, 330323], [115, 330543], [118, 330703], [126, 330903], [129, 331103], [134, 331363], [138, 331563], [145, 331803], [150, 332023], [153, 332183], [162, 332983], [168, 333238], [171, 333498], [181, 333858], [184, 334158], [187, 334358]]}, {"verse": 55, "start": 335363, "end": 338907, "text": "O death, where is your sting? O grave, where is your victory?", "words": [[0, 335363], [2, 335501], [9, 335981], [15, 336081], [18, 336261], [23, 336381], [30, 337271], [32, 337371], [39, 337971], [45, 338071], [48, 338211], [53, 338331]]}, {"verse": 56, "start": 339357, "end": 343040, "text": "The sting of death is sin; and the strength of sin is the law.", "words": [[0, 339357], [4, 339457], [10, 339717], [13, 339877], [19, 340217], [22, 340457], [27, 341228], [31, 341351], [35, 341451], [44, 341691], [47, 341891], [51, 342151], [54, 342411], [58, 342571]]}, {"verse": 57, "start": 343490, "end": 347714, "text": "But thanks be to God, which gives us the victory through our Lord Jesus Christ.", "words": [[0, 343490], [4, 343629], [11, 343829], [14, 344049], [17, 344189], [22, 344729], [28, 344889], [34, 345109], [37, 345309], [41, 345469], [49, 345849], [57, 346129], [61, 346349], [66, 346609], [72, 346929]]}, {"verse": 58, "start": 348164, "end": 356853, "text": "Therefore, my beloved brethren, be steadfast, unmoveable, always abounding in the work of the Lord, since you know that your labour is not in vain in the Lord.", "words": [[0, 348164], [11, 348946], [14, 349025], [22, 349366], [32, 350206], [35, 350326], [46, 351225], [58, 352126], [65, 352426], [75, 352986], [78, 353186], [82, 353266], [87, 353465], [90, 353606], [94, 353725], [100, 354266], [106, 354465], [110, 354665], [115, 354826], [120, 355006], [125, 355186], [132, 355366], [135, 355626], [139, 355886], [142, 356046], [147, 356266], [150, 356386], [154, 356486]]}]}