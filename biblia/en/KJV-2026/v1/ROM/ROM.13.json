{"book": "ROM", "chapter": 13, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 110520, "verses": [{"verse": 1, "start": 300, "end": 8004, "text": "Let every soul be subject to the higher powers. For there is no power but of God: the powers that be are ordained of God.", "words": [[0, 300], [4, 486], [10, 906], [15, 1246], [18, 1466], [26, 1806], [29, 2086], [33, 2186], [40, 2406], [48, 3430], [52, 3534], [58, 3694], [61, 3814], [64, 4034], [70, 4454], [74, 4674], [77, 4834], [82, 5599], [86, 5684], [93, 5984], [98, 6204], [101, 6424], [105, 6664], [114, 7304], [117, 7544]]}, {"verse": 2, "start": 8454, "end": 15625, "text": "Whoever therefore resists the power, resists the ordinance of God: and they that resist shall receive to themselves damnation.", "words": [[0, 8454], [8, 8913], [18, 9413], [26, 9813], [30, 9933], [37, 10533], [45, 11133], [49, 11253], [59, 11573], [62, 11873], [67, 12611], [71, 12756], [76, 12936], [81, 13156], [88, 13476], [94, 13756], [102, 14136], [105, 14316], [116, 14796]]}, {"verse": 3, "start": 16075, "end": 24753, "text": "For rulers are not a terror to good works, but to the evil. Will you then not be afraid of the power? do that which is good, and you shall have praise of the same:", "words": [[0, 16075], [4, 16174], [11, 16474], [15, 16794], [19, 16954], [21, 17114], [28, 17354], [31, 17534], [36, 17714], [43, 18214], [47, 18274], [50, 18494], [54, 18594], [60, 19292], [65, 19397], [69, 19517], [74, 19757], [78, 20017], [81, 20237], [88, 20537], [91, 20677], [95, 20797], [102, 21586], [105, 21670], [110, 21850], [116, 22030], [119, 22190], [125, 22630], [129, 23010], [133, 23170], [139, 23350], [144, 23570], [151, 23910], [154, 24110], [158, 24230]]}, {"verse": 4, "start": 25203, "end": 37015, "text": "For he is the minister of God to you for good. But if you do that which is evil, be afraid; for he bears not the sword in vain: for he is the minister of God, a revenger to execute wrath upon him that does evil.", "words": [[0, 25203], [4, 25300], [7, 25480], [10, 25600], [14, 25740], [23, 26020], [26, 26220], [30, 26460], [33, 26680], [37, 26840], [41, 27020], [47, 27703], [51, 27803], [54, 27923], [58, 28023], [61, 28163], [66, 28383], [72, 28503], [75, 28663], [81, 29263], [84, 29383], [92, 30218], [96, 30353], [99, 30513], [105, 30793], [109, 31073], [113, 31273], [119, 31493], [122, 31653], [128, 32398], [132, 32505], [135, 32665], [138, 32825], [142, 32945], [151, 33245], [154, 33465], [159, 34045], [161, 34125], [170, 34585], [173, 34705], [181, 35065], [187, 35425], [192, 35725], [196, 36065], [201, 36385], [206, 36605]]}, {"verse": 5, "start": 37465, "end": 42378, "text": "Therefore you must needs be subject, not only for wrath, but also for conscience sake.", "words": [[0, 37465], [10, 37808], [14, 38048], [19, 38208], [25, 38508], [28, 38688], [37, 39408], [41, 39548], [46, 39768], [50, 39948], [57, 40568], [61, 40688], [66, 40928], [70, 41328], [81, 41728]]}, {"verse": 6, "start": 42828, "end": 48968, "text": "For for this cause pay you tribute also: for they are God’s ministers, attending continually upon this very thing.", "words": [[0, 42828], [4, 42828], [8, 43013], [13, 43403], [19, 43793], [23, 44093], [27, 44233], [35, 44573], [41, 45475], [45, 45575], [50, 45695], [54, 45815], [60, 46175], [71, 46915], [81, 47235], [93, 47835], [98, 48075], [103, 48315], [108, 48535]]}, {"verse": 7, "start": 49418, "end": 57360, "text": "Render therefore to all their dues: tribute to whom tribute is due; custom to whom custom; fear to whom fear; honour to whom honour.", "words": [[0, 49418], [7, 49818], [17, 50198], [20, 50318], [24, 50558], [30, 50698], [36, 51444], [44, 51692], [47, 51932], [52, 52112], [60, 52432], [63, 52752], [68, 53396], [75, 53694], [78, 54014], [83, 54214], [91, 55080], [96, 55258], [99, 55438], [104, 55618], [110, 56422], [117, 56552], [120, 56732], [125, 57067]]}, {"verse": 8, "start": 57810, "end": 62664, "text": "Owe no man any thing, but to love one another: for he that loves another has fulfilled the law.", "words": [[0, 57851], [4, 57931], [7, 58091], [11, 58351], [15, 58611], [22, 58871], [26, 59251], [29, 59411], [34, 59631], [38, 59791], [47, 60514], [51, 60612], [54, 60752], [59, 60932], [65, 61152], [73, 61532], [77, 61812], [87, 62132], [91, 62312]]}, {"verse": 9, "start": 63114, "end": 77690, "text": "For this, You shall not commit adultery, You shall not kill, You shall not steal, You shall not bear false witness, You shall not covet; and if there be any other commandment, it is briefly comprehended in this saying, namely, You shall love your neighbour as yourself.", "words": [[0, 63114], [4, 63213], [10, 63793], [14, 63893], [20, 64093], [24, 64313], [31, 64553], [41, 65713], [45, 65713], [51, 65913], [55, 66133], [61, 66833], [65, 66893], [71, 67093], [75, 67293], [82, 68013], [86, 68133], [92, 68313], [96, 68553], [101, 68833], [107, 69113], [116, 69933], [120, 70033], [126, 70273], [130, 70513], [137, 71414], [141, 71511], [144, 71631], [150, 71751], [153, 71931], [157, 72191], [163, 72391], [176, 73151], [179, 73311], [182, 73451], [190, 73731], [203, 74411], [206, 74591], [211, 74811], [219, 75271], [227, 75911], [231, 76071], [237, 76251], [242, 76451], [247, 76671], [257, 76891], [260, 77151]]}, {"verse": 10, "start": 78140, "end": 82605, "text": "Love works no ill to his neighbour: therefore love is the fulfilling of the law.", "words": [[0, 78140], [5, 78299], [11, 78619], [14, 78799], [18, 79099], [21, 79259], [25, 79559], [36, 80111], [46, 80587], [51, 80927], [54, 81327], [58, 81467], [69, 81847], [72, 82127], [76, 82247]]}, {"verse": 11, "start": 83055, "end": 89523, "text": "And that, knowing the time, that now it is high time to awake out of sleep: for now is our salvation nearer than when we believed.", "words": [[0, 83055], [4, 83178], [10, 83338], [18, 83538], [22, 83718], [28, 84358], [33, 84518], [37, 84758], [40, 84898], [43, 85018], [48, 85218], [53, 85478], [56, 85658], [62, 85918], [66, 86158], [69, 86238], [76, 87000], [80, 87109], [84, 87339], [87, 87569], [91, 87629], [101, 87949], [108, 88589], [113, 88689], [118, 88869], [121, 88989]]}, {"verse": 12, "start": 89973, "end": 96794, "text": "The night is far spent, the day is at hand: let us therefore cast off the works of darkness, and let us put on the armour of light.", "words": [[0, 89973], [4, 90070], [10, 90270], [13, 90450], [17, 90630], [24, 91290], [28, 91390], [32, 91610], [35, 91730], [38, 91850], [44, 92557], [48, 92694], [51, 92834], [61, 93134], [66, 93494], [70, 93734], [74, 93894], [80, 94094], [83, 94274], [93, 94954], [97, 95154], [101, 95294], [104, 95434], [108, 95614], [111, 95774], [115, 95994], [122, 96214], [125, 96434]]}, {"verse": 13, "start": 97244, "end": 104999, "text": "Let us walk honestly, as in the day; not in rioting and drunkenness, not in sexual promiscuity and wantonness, not in strife and envying.", "words": [[0, 97244], [4, 97426], [7, 97586], [12, 97806], [22, 98326], [25, 98606], [28, 98746], [32, 98826], [37, 99493], [41, 99673], [44, 99883], [52, 100093], [56, 100313], [69, 101273], [73, 101373], [76, 101473], [83, 101793], [95, 102553], [99, 102733], [111, 103693], [115, 103813], [118, 103933], [125, 104413], [129, 104513]]}, {"verse": 14, "start": 105449, "end": 110120, "text": "But put on the Lord Jesus Christ, and make not provision for the flesh, to fulfil the lusts of it.", "words": [[0, 105449], [4, 105547], [8, 105707], [11, 105827], [15, 105927], [20, 106107], [26, 106367], [34, 106787], [38, 107067], [43, 107247], [47, 107487], [57, 107867], [61, 108147], [65, 108267], [72, 108587], [75, 108947], [82, 109307], [86, 109547], [92, 109967], [95, 109967]]}]}