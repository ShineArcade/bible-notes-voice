{"book": "GEN", "chapter": 26, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 327144, "verses": [{"verse": 1, "start": 300, "end": 11328, "text": "Y hubo hambre en la tierra, además de la primera hambre que fue en los días de Abraham: y se fue Isaac a Abimelec rey de los filisteos, en Gerar.", "words": [[0, 300], [2, 500], [7, 840], [14, 1200], [17, 1380], [20, 1480], [28, 2100], [35, 2380], [38, 2940], [41, 3060], [49, 3360], [56, 3820], [60, 3980], [64, 4200], [67, 4520], [71, 4680], [76, 5020], [79, 5200], [88, 6293], [90, 6442], [93, 6522], [97, 6762], [103, 7342], [105, 8082], [114, 8742], [118, 9402], [121, 9582], [125, 9742], [136, 10582], [139, 10982]]}, {"verse": 2, "start": 11778, "end": 19466, "text": "Y se le apareció Jehová, y le dijo: No desciendas a Egipto: habita en la tierra que yo te diré;", "words": [[0, 11778], [2, 11924], [5, 12004], [8, 12184], [17, 12804], [25, 13784], [27, 14084], [30, 14204], [36, 14968], [39, 15186], [50, 15806], [52, 16026], [60, 17363], [67, 17529], [70, 17696], [73, 17876], [80, 18256], [84, 18456], [87, 18616], [90, 18756]]}, {"verse": 3, "start": 19916, "end": 32446, "text": "Habita en esta tierra, y seré contigo, y te bendeciré; porque a ti y a tu descendencia daré todas estas tierras, y confirmaré el juramento que juré a Abraham tu padre:", "words": [[0, 19916], [7, 20355], [10, 20475], [15, 20675], [23, 21095], [25, 21615], [30, 21915], [39, 22555], [41, 22855], [44, 23015], [55, 24381], [62, 24630], [64, 24810], [67, 25050], [69, 25330], [71, 25390], [74, 25510], [87, 26290], [92, 26830], [98, 27030], [104, 27410], [113, 28010], [115, 28530], [126, 29270], [129, 29490], [139, 30070], [143, 30330], [148, 30770], [150, 30910], [158, 31370], [161, 31710]]}, {"verse": 4, "start": 32896, "end": 44643, "text": "Y multiplicaré tu descendencia como las estrellas del cielo, y daré a tu descendencia todas estas tierras; y todas las naciones de la tierra serán benditas en tu simiente:", "words": [[0, 32896], [2, 33034], [15, 33874], [18, 34034], [31, 34854], [36, 35094], [40, 35314], [50, 35874], [54, 35994], [61, 36394], [63, 37054], [68, 37394], [70, 37454], [73, 37574], [86, 38494], [92, 38994], [98, 39394], [107, 40705], [109, 40804], [115, 41044], [119, 41324], [128, 41784], [131, 41964], [134, 42064], [141, 42444], [147, 42904], [156, 43424], [159, 43584], [162, 43684]]}, {"verse": 5, "start": 45093, "end": 52122, "text": "Por cuanto oyó Abraham mi voz, y guardó mi precepto, mis mandamientos, mis estatutos y mis leyes.", "words": [[0, 45093], [4, 45257], [11, 45644], [15, 46030], [23, 46417], [26, 46577], [31, 46917], [33, 47257], [40, 47677], [43, 47797], [53, 48697], [57, 48777], [71, 50017], [75, 50097], [85, 50657], [87, 51097], [91, 51237]]}, {"verse": 6, "start": 52472, "end": 55169, "text": "Habitó, pues, Isaac en Gerar.", "words": [[0, 52472], [8, 52983], [14, 53223], [20, 54003], [23, 54604]]}, {"verse": 7, "start": 55619, "end": 74270, "text": "Y los hombres de aquel lugar le preguntaron acerca de su mujer; y él respondió: Es mi hermana; porque tuvo miedo de decir: Es mi mujer; que tal vez, dijo, los hombres del lugar me matarían por causa de Rebeca; porque era de hermoso aspecto.", "words": [[0, 55619], [2, 55728], [6, 55848], [14, 56228], [17, 56428], [23, 56728], [29, 57048], [32, 57288], [44, 58128], [51, 58628], [54, 58968], [57, 59148], [64, 60286], [66, 60572], [69, 60859], [80, 61771], [83, 61958], [86, 62158], [95, 63045], [102, 63247], [107, 63567], [113, 64007], [116, 64247], [123, 65176], [126, 65538], [129, 65738], [136, 66720], [140, 66803], [144, 66983], [149, 67663], [155, 68723], [159, 68843], [167, 69183], [171, 69343], [177, 69683], [180, 69943], [189, 70543], [193, 70620], [199, 70697], [202, 70775], [210, 72196], [217, 72556], [221, 72896], [224, 73056], [232, 73536]]}, {"verse": 8, "start": 74720, "end": 86259, "text": "Y sucedió que, después que él estuvo allí muchos días, Abimelec, rey de los filisteos, mirando por una ventana, vio a Isaac que jugaba con Rebeca su mujer.", "words": [[0, 74720], [2, 74847], [10, 75387], [15, 75567], [23, 75967], [27, 76267], [30, 76567], [37, 76967], [42, 77187], [49, 77447], [55, 78347], [65, 79247], [69, 79847], [72, 79947], [76, 80087], [87, 81127], [95, 81507], [99, 81747], [103, 81927], [112, 82887], [116, 83087], [118, 83347], [124, 84227], [128, 84307], [135, 84807], [139, 85007], [146, 85467], [149, 85667]]}, {"verse": 9, "start": 86709, "end": 100475, "text": "Y llamó Abimelec a Isaac, y dijo: He aquí ella es de cierto tu mujer: ¿cómo, pues, dijiste: Es mi hermana? E Isaac le respondió: Porque dije: Quizá moriré por causa de ella.", "words": [[0, 86709], [2, 86834], [8, 87014], [17, 87194], [19, 87994], [26, 89094], [28, 89194], [34, 89963], [37, 90043], [42, 90303], [47, 90623], [50, 90863], [53, 90963], [60, 91283], [63, 91543], [70, 92348], [77, 92576], [83, 92846], [92, 93711], [95, 93830], [98, 93970], [107, 94825], [109, 94825], [115, 95374], [118, 95934], [129, 97244], [136, 97384], [142, 98146], [148, 98485], [155, 98885], [159, 99065], [165, 99305], [168, 99565]]}, {"verse": 10, "start": 100825, "end": 110823, "text": "Y Abimelec dijo: ¿Por qué nos has hecho esto? Por poco hubiera dormido alguno del pueblo con tu mujer, y hubieras traído sobre nosotros el pecado.", "words": [[0, 101079], [2, 101365], [11, 101652], [17, 102644], [22, 102789], [26, 102929], [30, 103089], [34, 103289], [40, 103509], [46, 104368], [50, 104493], [55, 104793], [63, 105153], [71, 105553], [78, 105953], [82, 106033], [89, 106333], [93, 106573], [96, 106693], [103, 107033], [105, 107493], [114, 107853], [121, 108193], [127, 108453], [136, 108853], [139, 109113]]}, {"verse": 11, "start": 111173, "end": 118875, "text": "Entonces Abimelec mandó a todo el pueblo, diciendo: El que toque a este hombre o a su mujer, de cierto morirá.", "words": [[0, 111173], [9, 111885], [18, 112635], [24, 113335], [26, 113415], [31, 113595], [34, 113815], [42, 114175], [52, 115254], [55, 115373], [59, 115493], [65, 115833], [67, 115933], [72, 116173], [79, 116553], [81, 116753], [83, 116853], [86, 116973], [93, 117793], [96, 117853], [103, 118153]]}, {"verse": 12, "start": 119225, "end": 126665, "text": "Y sembró Isaac en aquella tierra, y halló aquel año ciento por uno: y le bendijo Jehová.", "words": [[0, 119225], [2, 119343], [9, 119903], [15, 120263], [18, 121183], [26, 121543], [34, 122103], [36, 122663], [42, 123223], [48, 123483], [52, 123763], [59, 124043], [63, 124423], [68, 125191], [70, 125318], [73, 125418], [81, 125898]]}, {"verse": 13, "start": 127115, "end": 134328, "text": "Y el varón se engrandeció, y fue adelantando y engrandeciéndose, hasta hacerse muy poderoso:", "words": [[0, 127115], [2, 127242], [5, 127342], [11, 127742], [14, 127882], [27, 128722], [29, 129282], [33, 129482], [45, 130622], [47, 130882], [65, 132162], [71, 132582], [79, 133262], [83, 133482]]}, {"verse": 14, "start": 134778, "end": 141458, "text": "Y tuvo hato de ovejas, y hato de vacas, y grande apero; y los filisteos le tuvieron envidia.", "words": [[0, 134778], [2, 134899], [7, 135219], [12, 135539], [15, 135639], [23, 136159], [25, 136599], [30, 137039], [33, 137139], [40, 137799], [42, 138099], [49, 138419], [56, 139277], [58, 139505], [62, 139625], [72, 140245], [75, 140385], [84, 140785]]}, {"verse": 15, "start": 141908, "end": 150498, "text": "Y todos los pozos que habían abierto los criados de Abraham su padre en sus días, los filisteos los habían cegado y llenado de tierra.", "words": [[0, 141908], [2, 142051], [8, 142331], [12, 142591], [18, 143151], [22, 143311], [29, 143611], [37, 144091], [41, 144271], [49, 144851], [52, 145071], [60, 145671], [63, 145751], [69, 146071], [72, 146251], [76, 146391], [82, 147091], [86, 147601], [96, 148111], [100, 148271], [107, 148591], [114, 149251], [116, 149371], [124, 149811], [127, 149951]]}, {"verse": 16, "start": 150948, "end": 157075, "text": "Y dijo Abimelec a Isaac: Apártate de nosotros, porque mucho más poderoso que nosotros te has hecho.", "words": [[0, 150948], [2, 151114], [7, 151640], [16, 152167], [18, 152693], [25, 153442], [34, 153980], [37, 154080], [47, 154480], [54, 154780], [60, 155100], [64, 155280], [73, 155800], [77, 155960], [86, 156240], [89, 156580], [93, 156720]]}, {"verse": 17, "start": 157425, "end": 163641, "text": "E Isaac se fue de allí; y asentó sus tiendas en el valle de Gerar, y habitó allí.", "words": [[0, 157425], [2, 157693], [8, 157993], [11, 158573], [15, 158773], [18, 159153], [24, 159761], [26, 159927], [33, 160467], [37, 160667], [45, 161267], [48, 161407], [51, 161547], [57, 161827], [60, 162117], [67, 162407], [69, 162787], [76, 163207]]}, {"verse": 18, "start": 164091, "end": 178982, "text": "Y volvió a abrir Isaac los pozos de agua que habían abierto en los días de Abraham su padre, y que los filisteos habían cegado, muerto Abraham; y los llamó por los nombres que su padre los había llamado.", "words": [[0, 164091], [2, 164228], [9, 164688], [11, 164848], [17, 165278], [23, 165708], [27, 166628], [33, 167128], [36, 167268], [41, 167668], [45, 168308], [52, 168548], [60, 169028], [63, 169208], [67, 169328], [72, 169588], [75, 169768], [83, 170348], [86, 170428], [93, 171328], [95, 171368], [99, 171468], [103, 171608], [113, 172308], [120, 172588], [128, 173288], [135, 173828], [144, 174919], [146, 175020], [150, 175160], [156, 175620], [160, 175820], [164, 175980], [172, 176600], [176, 177060], [179, 177220], [185, 177593], [189, 177967], [195, 178340]]}, {"verse": 19, "start": 179432, "end": 185691, "text": "Y los siervos de Isaac cavaron en el valle, y hallaron allí un pozo de aguas vivas.", "words": [[0, 179432], [2, 179518], [6, 179658], [14, 180198], [17, 180318], [23, 180858], [31, 181858], [34, 182018], [37, 182178], [44, 182498], [46, 182958], [55, 183378], [60, 183618], [63, 183858], [68, 184338], [71, 184498], [77, 184898]]}, {"verse": 20, "start": 186141, "end": 197708, "text": "Y los pastores de Gerar riñeron con los pastores de Isaac, diciendo: El agua es nuestra: por eso llamó el nombre del pozo Esek, porque habían altercado con él.", "words": [[0, 186141], [2, 186266], [6, 186386], [15, 186886], [18, 187216], [24, 187546], [32, 188546], [36, 188746], [40, 188946], [49, 189426], [52, 189586], [59, 190006], [69, 191246], [72, 191386], [77, 191686], [80, 192066], [89, 193091], [93, 193257], [97, 193437], [103, 193797], [106, 193897], [113, 194197], [117, 194417], [122, 194937], [128, 195457], [135, 195897], [142, 196257], [152, 197037], [156, 197297]]}, {"verse": 21, "start": 198158, "end": 204651, "text": "Y abrieron otro pozo, y también riñeron sobre él: y llamó su nombre Sitna.", "words": [[0, 198158], [2, 198428], [11, 198948], [16, 199148], [22, 199748], [24, 200108], [32, 200848], [40, 201588], [46, 201908], [50, 202744], [52, 202871], [58, 203191], [61, 203331], [68, 204000]]}, {"verse": 22, "start": 205101, "end": 218091, "text": "Y se apartó de allí, y abrió otro pozo, y no riñeron sobre él: y llamó su nombre Rehobot, y dijo: Porque ahora nos ha hecho ensanchar Jehová, y fructificaremos en la tierra.", "words": [[0, 205101], [2, 205287], [5, 205387], [12, 205947], [15, 206107], [21, 206407], [23, 206947], [29, 207287], [34, 207547], [40, 208167], [42, 208687], [45, 209117], [53, 209547], [59, 209867], [63, 210679], [65, 210826], [71, 211146], [74, 211306], [81, 212206], [90, 213106], [92, 213286], [98, 214050], [105, 214259], [111, 214539], [115, 214739], [118, 214919], [124, 215119], [134, 215689], [142, 216259], [144, 216459], [160, 217279], [163, 217479], [166, 217579]]}, {"verse": 23, "start": 218441, "end": 220152, "text": "Y de allí subió a Beerseba.", "words": [[0, 218441], [2, 218605], [5, 218665], [10, 218865], [16, 219325], [18, 219763]]}, {"verse": 24, "start": 220602, "end": 235205, "text": "Y se le apareció Jehová aquella noche, y dijo: Yo soy el Dios de Abraham tu padre; no temas, que yo soy contigo, y yo te bendeciré, y multiplicaré tu descendencia por amor de Abraham mi siervo.", "words": [[0, 220602], [2, 220748], [5, 220868], [8, 221028], [17, 221668], [24, 222228], [32, 222588], [39, 222928], [41, 223208], [47, 224996], [50, 225156], [54, 225456], [57, 225656], [62, 225876], [65, 226096], [73, 226736], [76, 226796], [83, 227899], [86, 228059], [93, 228439], [97, 228839], [100, 228999], [104, 229199], [113, 229939], [115, 230199], [118, 230339], [121, 230479], [132, 231279], [134, 231579], [147, 232299], [150, 232439], [163, 233199], [167, 233399], [172, 233619], [175, 233909], [183, 234199], [186, 234399]]}, {"verse": 25, "start": 235555, "end": 245972, "text": "Y edificó allí un altar, e invocó el nombre de Jehová, y tendió allí su tienda: y abrieron allí los siervos de Isaac un pozo.", "words": [[0, 235555], [2, 235715], [10, 236475], [15, 236695], [18, 236975], [25, 237995], [27, 238095], [34, 238795], [37, 238955], [44, 239335], [47, 239535], [55, 240375], [57, 240615], [64, 241155], [69, 241435], [72, 241655], [80, 242644], [82, 242749], [91, 243109], [96, 243469], [100, 243709], [108, 244289], [111, 244469], [117, 244869], [120, 245309]]}, {"verse": 26, "start": 246422, "end": 254531, "text": "Y Abimelec vino a él desde Gerar, y Ahuzat, amigo suyo, y Ficol, capitán de su ejército.", "words": [[0, 246422], [2, 246816], [11, 247246], [16, 247526], [18, 247806], [21, 247966], [27, 248406], [34, 248846], [36, 249586], [44, 250326], [50, 250646], [56, 251286], [58, 251446], [65, 252186], [73, 252746], [76, 252866], [79, 252986]]}, {"verse": 27, "start": 254981, "end": 261436, "text": "Y les dijo Isaac: ¿Por qué venís a mí, pues que me habéis aborrecido, y me echasteis de entre vosotros?", "words": [[0, 255061], [2, 255181], [6, 255301], [11, 255781], [18, 256571], [23, 256697], [27, 256817], [33, 257137], [35, 257237], [39, 257817], [44, 257897], [48, 258037], [51, 258157], [58, 258397], [70, 259137], [72, 259577], [75, 259697], [85, 260297], [88, 260397], [94, 260617]]}, {"verse": 28, "start": 261786, "end": 272451, "text": "Y ellos respondieron: Hemos visto que Jehová es contigo; y dijimos: Haya ahora juramento entre nosotros, entre nosotros y ti, y haremos pacto contigo:", "words": [[0, 261786], [2, 261970], [8, 262310], [22, 263976], [28, 264194], [34, 264594], [38, 264944], [45, 265294], [48, 265414], [57, 266684], [59, 266984], [68, 267529], [73, 267794], [79, 268054], [89, 268634], [95, 268894], [105, 269634], [111, 269834], [120, 270294], [122, 270594], [126, 271094], [128, 271174], [136, 271434], [142, 271894]]}, {"verse": 29, "start": 272901, "end": 280998, "text": "Que no nos hagas mal, como nosotros no te hemos tocado, y como solamente te hemos hecho bien, y te enviamos en paz: tú ahora, bendito de Jehová.", "words": [[0, 272901], [4, 272982], [7, 273162], [11, 273342], [17, 273662], [22, 274082], [27, 274262], [36, 274702], [39, 274922], [42, 275082], [48, 275222], [56, 275762], [58, 275982], [63, 276162], [73, 276562], [76, 276862], [82, 277022], [88, 277282], [94, 277582], [96, 277822], [99, 277982], [108, 278402], [111, 278582], [116, 279369], [119, 279486], [126, 279926], [134, 280366], [137, 280486]]}, {"verse": 30, "start": 281348, "end": 286304, "text": "Entonces él les hizo banquete, y comieron y bebieron.", "words": [[0, 281348], [9, 281951], [12, 282611], [16, 283271], [21, 283531], [31, 284231], [33, 284771], [42, 285291], [44, 285491]]}, {"verse": 31, "start": 286754, "end": 295057, "text": "Y se levantaron de madrugada, y juraron el uno al otro; e Isaac los despidió, y ellos se partieron de él en paz.", "words": [[0, 286754], [2, 286861], [5, 286981], [16, 287621], [19, 287781], [30, 288481], [32, 288581], [40, 289121], [43, 289321], [47, 289541], [50, 289741], [56, 290581], [58, 291019], [64, 291489], [68, 291869], [78, 292529], [80, 293049], [86, 293329], [89, 293529], [99, 294049], [102, 294269], [105, 294429], [108, 294569]]}, {"verse": 32, "start": 295507, "end": 305756, "text": "Y en aquel día sucedió que vinieron los criados de Isaac, y le dieron nuevas acerca del pozo que habían abierto, y le dijeron: Agua hemos hallado.", "words": [[0, 295507], [2, 295665], [5, 295785], [11, 296125], [15, 296405], [23, 297185], [27, 297345], [36, 297905], [40, 298105], [48, 298645], [51, 298785], [58, 299305], [60, 299885], [63, 300005], [70, 300345], [77, 300685], [84, 301205], [88, 301505], [93, 301965], [97, 302125], [104, 302365], [113, 302985], [115, 303525], [118, 303645], [127, 304640], [132, 304978], [138, 305118]]}, {"verse": 33, "start": 306106, "end": 312646, "text": "Y lo llamó Seba: por cuya causa el nombre de aquella ciudad es Beerseba hasta este día.", "words": [[0, 306106], [2, 306370], [5, 306670], [11, 306970], [17, 307500], [21, 307645], [26, 308005], [32, 308445], [35, 308705], [42, 309085], [45, 309305], [53, 309705], [60, 310005], [63, 310695], [72, 311385], [78, 311765], [83, 312065]]}, {"verse": 34, "start": 313096, "end": 322421, "text": "Y cuando Esaú fue de cuarenta años, tomó por mujer a Judit hija de Beeri heteo, y a Basemat hija de Elón heteo:", "words": [[0, 313096], [2, 313220], [9, 313650], [14, 314080], [18, 314340], [21, 314480], [30, 315080], [36, 316060], [41, 316540], [45, 316720], [51, 317120], [53, 317690], [59, 318260], [64, 318560], [67, 319093], [73, 319627], [80, 320160], [82, 320567], [84, 320973], [92, 321380], [97, 321700], [100, 321820], [105, 322121]]}, {"verse": 35, "start": 322871, "end": 326744, "text": "Y fueron amargura de espíritu a Isaac y a Rebeca.", "words": [[0, 323474], [2, 324114], [9, 324514], [18, 324914], [21, 325054], [30, 325494], [32, 325764], [38, 326034], [40, 326154], [42, 326194]]}]}