{"book": "PSA", "chapter": 40, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 144134, "verses": [{"verse": 1, "start": 300, "end": 8672, "text": "Al Músico principal: Salmo de David. PACIENTEMENTE esperé a Jehová, y se inclinó a mí, y oyó mi clamor.", "words": [[0, 300], [3, 487], [10, 987], [21, 2081], [27, 2619], [30, 2779], [37, 3419], [51, 4145], [58, 4865], [60, 5025], [68, 5585], [70, 5885], [73, 6065], [81, 6785], [83, 6905], [87, 7085], [89, 7665], [93, 7965], [96, 8085]]}, {"verse": 2, "start": 9022, "end": 18209, "text": "Y me hizo sacar de un lago de miseria, del lodo cenagoso; y puso mis pies sobre peña, y enderezó mis pasos.", "words": [[0, 9022], [2, 9146], [5, 9266], [10, 9566], [16, 9906], [19, 10186], [22, 10306], [27, 10626], [30, 10786], [39, 11826], [43, 12546], [48, 13294], [58, 14205], [60, 14350], [65, 14710], [69, 14910], [74, 15250], [80, 15740], [86, 16230], [88, 16710], [97, 17330], [101, 17470]]}, {"verse": 3, "start": 18559, "end": 26277, "text": "Puso luego en mi boca canción nueva, alabanza a nuestro Dios. Verán esto muchos, y temerán, y esperarán en Jehová.", "words": [[0, 18559], [5, 18844], [11, 19104], [14, 19324], [17, 19464], [22, 19704], [30, 20064], [37, 20814], [46, 21564], [48, 21684], [56, 21824], [62, 22740], [68, 23149], [73, 23442], [81, 23736], [83, 24029], [92, 24629], [94, 25029], [104, 25609], [107, 25709]]}, {"verse": 4, "start": 26627, "end": 34406, "text": "Bienaventurado el hombre que puso a Jehová por su confianza, y no mira a los soberbios, ni a los que declinan a la mentira.", "words": [[0, 27152], [15, 27712], [18, 27892], [25, 28192], [29, 28392], [34, 28772], [36, 28892], [43, 29332], [47, 29452], [50, 29652], [61, 30412], [63, 30532], [66, 30672], [71, 30912], [73, 31192], [77, 31352], [88, 32172], [91, 32672], [93, 32772], [97, 32912], [101, 33272], [110, 33632], [112, 33692], [115, 33792]]}, {"verse": 5, "start": 34756, "end": 47038, "text": "Aumentado has tú, oh Jehová Dios mío, tus maravillas; y tus pensamientos para con nosotros, no te los podremos contar: si yo los anuncio y hablo de ellos, no pueden ser enumerados.", "words": [[0, 34881], [10, 35211], [14, 35541], [18, 35866], [21, 36191], [28, 36516], [33, 36841], [38, 37121], [42, 37321], [54, 38923], [56, 39026], [60, 39166], [73, 39966], [78, 40246], [82, 40486], [92, 41306], [95, 41626], [98, 41766], [102, 41866], [111, 42286], [119, 43167], [122, 43311], [125, 43491], [129, 43671], [137, 44151], [139, 44291], [145, 44531], [148, 44691], [155, 45291], [158, 45511], [165, 45831], [169, 46071]]}, {"verse": 6, "start": 47038, "end": 54370, "text": "Sacrificio y ofrenda no te agrada; has abierto mis oídos; holocausto y expiación no has pedido.", "words": [[0, 47498], [11, 47858], [13, 47978], [21, 48478], [24, 48558], [27, 48678], [35, 49486], [39, 49749], [47, 50209], [51, 50409], [58, 51399], [69, 52104], [71, 52284], [81, 52984], [84, 53364], [88, 53584]]}, {"verse": 7, "start": 54720, "end": 60355, "text": "Entonces dije: He aquí, vengo; en el envoltorio del libro está escrito de mí:", "words": [[0, 54720], [9, 55189], [15, 56105], [18, 56215], [24, 56515], [31, 57677], [34, 57825], [37, 57945], [48, 58665], [52, 58765], [58, 59145], [63, 59425], [71, 59765], [74, 60045]]}, {"verse": 8, "start": 60705, "end": 67927, "text": "El hacer tu voluntad, Dios mío, me ha agradado; y tu ley está en medio de mis entrañas.", "words": [[0, 60705], [3, 60887], [9, 61247], [12, 61507], [22, 62427], [27, 62747], [32, 63547], [35, 63687], [38, 63907], [48, 64878], [50, 65000], [53, 65120], [57, 65460], [62, 65880], [65, 66140], [71, 66460], [74, 66720], [78, 66860]]}, {"verse": 9, "start": 68277, "end": 75261, "text": "Anunciado he justicia en grande congregación: he aquí no detuve mis labios, Jehová, tú lo sabes.", "words": [[0, 68277], [10, 68733], [13, 69213], [22, 69833], [25, 70013], [32, 70253], [46, 71839], [49, 71979], [54, 72239], [57, 72479], [64, 72959], [68, 73179], [76, 73779], [84, 74339], [87, 74399], [90, 74559]]}, {"verse": 10, "start": 75611, "end": 86059, "text": "No encubrí tu justicia dentro de mi corazón: tu verdad y tu salvación he dicho: no oculté tu misericordia y tu verdad en gran asamblea.", "words": [[0, 75611], [3, 76081], [11, 76551], [14, 76711], [23, 77411], [30, 77671], [33, 78011], [36, 78111], [45, 79120], [48, 79204], [55, 79584], [57, 80144], [60, 80264], [70, 81004], [73, 81184], [80, 81990], [83, 82317], [90, 82677], [93, 82817], [106, 83737], [108, 83877], [111, 84017], [118, 84357], [121, 84737], [126, 84957]]}, {"verse": 11, "start": 86409, "end": 93779, "text": "Tú, Jehová, no apartes de mí tus misericordias: tu misericordia y tu verdad me guarden siempre.", "words": [[0, 86409], [4, 86809], [12, 87669], [15, 87769], [23, 88289], [26, 88449], [29, 88609], [33, 88769], [48, 90233], [51, 90484], [64, 91344], [66, 91504], [69, 91664], [76, 92004], [79, 92544], [87, 93044]]}, {"verse": 12, "start": 94129, "end": 106381, "text": "Porque me han cercado males hasta no haber cuento: me han alcanzado mis maldades, y no puedo levantar la vista: se han aumentado más que los cabellos de mi cabeza, y mi corazón me falta.", "words": [[0, 94129], [7, 94354], [10, 94574], [14, 94714], [22, 95334], [28, 95954], [34, 96274], [37, 96514], [43, 96734], [51, 97692], [54, 97952], [58, 98092], [68, 98832], [72, 99012], [82, 99752], [84, 100012], [87, 100152], [93, 100412], [102, 100992], [105, 101112], [112, 101919], [115, 102061], [119, 102221], [129, 102821], [133, 103001], [137, 103141], [141, 103281], [150, 103761], [153, 103861], [156, 103981], [164, 104461], [166, 104941], [169, 105081], [177, 105501], [180, 105741]]}, {"verse": 13, "start": 106731, "end": 111477, "text": "Quieras, oh Jehová, librarme; Jehová, apresúrate a socorrerme.", "words": [[0, 106731], [9, 107034], [12, 107374], [20, 107714], [30, 108629], [38, 109429], [49, 110089], [51, 110589]]}, {"verse": 14, "start": 111827, "end": 120950, "text": "Sean avergonzados y confusos a una los que buscan mi vida para cortarla: vuelvan atrás y avergüéncense los que mi mal desean.", "words": [[0, 111827], [5, 112126], [18, 113206], [20, 113406], [29, 114366], [31, 114446], [35, 114526], [39, 114646], [43, 114786], [50, 115146], [53, 115326], [58, 115586], [63, 115806], [73, 116973], [81, 117360], [87, 117740], [89, 118510], [103, 119280], [107, 119620], [111, 119840], [114, 120000], [118, 120260]]}, {"verse": 15, "start": 121300, "end": 126174, "text": "Sean asolados en pago de su afrenta los que me dicen: ¡Ea, ea!", "words": [[0, 121300], [5, 121584], [14, 122424], [17, 122744], [22, 123204], [25, 123344], [28, 123714], [36, 124084], [40, 124204], [44, 124364], [47, 124524], [54, 125587], [59, 125881]]}, {"verse": 16, "start": 126454, "end": 134677, "text": "Gócense y alégrense en ti todos los que te buscan; y digan siempre los que aman tu salvación: Jehová sea enaltecido.", "words": [[0, 126454], [8, 127179], [10, 127439], [20, 128139], [23, 128299], [26, 128459], [32, 128839], [36, 129159], [40, 129299], [43, 129439], [51, 130275], [53, 130374], [59, 130714], [67, 131054], [71, 131294], [75, 131494], [80, 131674], [83, 131894], [94, 133324], [101, 133791], [105, 134259]]}, {"verse": 17, "start": 134957, "end": 143734, "text": "Aunque afligido yo y necesitado, Jehová pensará en mí: mi ayuda y mi libertador eres tú; Dios mío, no te tardes.", "words": [[0, 134957], [7, 135201], [16, 135861], [19, 136081], [21, 136201], [33, 137501], [40, 138261], [48, 138821], [51, 138921], [55, 139497], [58, 139641], [64, 139981], [66, 140201], [69, 140321], [80, 141081], [85, 141381], [89, 142105], [94, 142232], [99, 142832], [102, 142912], [105, 143032]]}]}