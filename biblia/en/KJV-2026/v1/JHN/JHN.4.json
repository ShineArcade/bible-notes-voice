{"book": "JHN", "chapter": 4, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 364379, "verses": [{"verse": 1, "start": 300, "end": 6697, "text": "When therefore the Lord knew how the Pharisees had heard that Jesus made and baptized more disciples than John,", "words": [[0, 300], [5, 430], [15, 870], [19, 1130], [24, 1370], [29, 1670], [33, 1910], [37, 2070], [47, 2790], [51, 2950], [57, 3190], [62, 3390], [68, 3670], [73, 4170], [77, 4370], [86, 4750], [91, 5230], [101, 5750], [106, 6110]]}, {"verse": 2, "start": 7147, "end": 10842, "text": "(Though Jesus himself baptized not, but his disciples,)", "words": [[0, 7147], [8, 7334], [14, 7674], [22, 8234], [31, 8754], [36, 9394], [40, 9794], [44, 9974]]}, {"verse": 3, "start": 11292, "end": 14076, "text": "He left Judæa, and departed again into Galilee.", "words": [[0, 11292], [3, 11362], [8, 11782], [15, 12202], [19, 12362], [28, 12742], [34, 13122], [39, 13322]]}, {"verse": 4, "start": 14526, "end": 16466, "text": "And he must needs go through Samaria.", "words": [[0, 14526], [4, 14654], [7, 14734], [12, 14894], [18, 15254], [21, 15514], [29, 15734]]}, {"verse": 5, "start": 16916, "end": 24787, "text": "Then comes he to a city of Samaria, which is called Sychar, near to the parcel of ground that Jacob gave to his son Joseph.", "words": [[0, 16916], [5, 17134], [11, 17494], [14, 17694], [17, 17894], [19, 18034], [24, 18274], [27, 18454], [36, 19514], [42, 19534], [45, 19674], [52, 20304], [60, 20934], [65, 21194], [68, 21374], [72, 21454], [79, 21813], [82, 22034], [89, 22434], [94, 22774], [100, 23074], [105, 23434], [108, 23633], [112, 23794], [116, 24034]]}, {"verse": 6, "start": 25237, "end": 33398, "text": "Now Jacob’s well was there. Jesus therefore, being wearied with his journey, sat thus on the well: and it was about the sixth hour.", "words": [[0, 25237], [4, 25444], [12, 25984], [17, 26224], [21, 26504], [28, 27250], [34, 27650], [45, 28170], [51, 28370], [59, 28890], [64, 29070], [68, 29210], [77, 30130], [81, 30370], [86, 30630], [89, 30890], [93, 31010], [99, 31756], [103, 31882], [106, 31962], [110, 32142], [116, 32362], [120, 32562], [126, 32802]]}, {"verse": 7, "start": 33848, "end": 39271, "text": "There comes a woman of Samaria to draw water: Jesus says to her, Give me to drink.", "words": [[0, 33848], [6, 34010], [12, 34270], [14, 34430], [20, 34650], [23, 34850], [31, 35390], [34, 35610], [39, 35850], [46, 36733], [52, 37273], [57, 37613], [60, 37853], [65, 38341], [70, 38485], [73, 38665], [76, 38785]]}, {"verse": 8, "start": 39621, "end": 42812, "text": "(For his disciples were gone away to the city to buy food.)", "words": [[0, 39621], [5, 39738], [9, 39878], [19, 40398], [24, 40658], [29, 40918], [34, 41218], [37, 41418], [41, 41538], [46, 41798], [49, 41998], [53, 42238]]}, {"verse": 9, "start": 43262, "end": 53682, "text": "Then says the woman of Samaria to him, How is it that you, being a Jew, ask drink of me, which am a woman of Samaria? for the Jews have no dealings with the Samaritans.", "words": [[0, 43262], [5, 43487], [10, 43767], [14, 43987], [20, 44227], [23, 44387], [31, 44887], [34, 45087], [39, 45949], [43, 46149], [46, 46349], [49, 46469], [54, 46589], [59, 46949], [65, 47089], [67, 47269], [72, 47949], [76, 48429], [82, 48569], [85, 48749], [89, 49269], [95, 49549], [98, 49609], [100, 49689], [106, 49869], [109, 50009], [118, 51088], [122, 51177], [126, 51277], [131, 51497], [136, 51837], [139, 52077], [148, 52577], [153, 52697], [157, 52797]]}, {"verse": 10, "start": 54032, "end": 63474, "text": "Jesus answered and said to her, If you knew the gift of God, and who it is that says to you, Give me to drink; you would have asked of him, and he would have given you living water.", "words": [[0, 54032], [6, 54276], [15, 54796], [19, 55036], [24, 55216], [27, 55396], [32, 55947], [35, 56073], [39, 56192], [44, 56412], [48, 56573], [53, 56812], [56, 56973], [61, 57332], [65, 57812], [69, 57992], [72, 58113], [75, 58293], [80, 58473], [85, 58672], [88, 58893], [93, 58960], [98, 59028], [101, 59097], [104, 59165], [111, 60577], [115, 60757], [121, 60897], [126, 60977], [132, 61257], [135, 61397], [140, 61757], [144, 61937], [147, 62077], [153, 62197], [158, 62297], [164, 62497], [168, 62697], [175, 62937]]}, {"verse": 11, "start": 63824, "end": 72608, "text": "The woman says to him, Sir, you have nothing to draw with, and the well is deep: from where then have you that living water?", "words": [[0, 63824], [4, 63944], [10, 64124], [15, 64424], [18, 64644], [23, 65708], [28, 66108], [32, 66248], [37, 66548], [45, 66948], [48, 67168], [53, 67448], [59, 68188], [63, 68388], [67, 68528], [72, 68828], [75, 69208], [81, 70061], [86, 70209], [92, 70489], [97, 70749], [102, 71089], [106, 71229], [111, 71469], [118, 71709]]}, {"verse": 12, "start": 73058, "end": 80254, "text": "Are you greater than our father Jacob, which gave us the well, and drank of it himself, and his children, and his cattle?", "words": [[0, 73058], [4, 73218], [8, 73498], [16, 73838], [21, 74158], [25, 74318], [32, 74618], [39, 75558], [45, 75778], [50, 75998], [53, 76198], [57, 76358], [63, 76638], [67, 76948], [73, 77258], [76, 77438], [79, 77558], [88, 77978], [92, 78458], [96, 78618], [106, 79058], [110, 79558], [114, 79718]]}, {"verse": 13, "start": 80604, "end": 84837, "text": "Jesus answered and said to her, Whoever drinks of this water shall thirst again:", "words": [[0, 80604], [6, 80849], [15, 81369], [19, 81609], [24, 81789], [27, 81969], [32, 82520], [40, 82754], [47, 83114], [50, 83294], [55, 83474], [61, 83754], [67, 83974], [74, 84254]]}, {"verse": 14, "start": 85287, "end": 94641, "text": "But whoever drinks of the water that I shall give him shall never thirst; but the water that I shall give him shall be in him a well of water springing up into everlasting life.", "words": [[0, 85287], [4, 85384], [12, 85604], [19, 85984], [22, 86144], [26, 86244], [32, 86484], [37, 86664], [39, 86804], [45, 86964], [50, 87204], [54, 87384], [60, 87584], [66, 87824], [74, 88763], [78, 88833], [82, 88973], [88, 89233], [93, 89453], [95, 89613], [101, 89773], [106, 89993], [110, 90273], [116, 90733], [119, 90953], [122, 91153], [126, 91353], [128, 91573], [133, 91793], [136, 91973], [142, 92233], [152, 92773], [155, 92953], [160, 93373], [172, 93893]]}, {"verse": 15, "start": 94991, "end": 101572, "text": "The woman says to him, Sir, give me this water, that I thirst not, neither come here to draw.", "words": [[0, 94991], [4, 95111], [10, 95291], [15, 95591], [18, 95811], [23, 96875], [28, 97355], [33, 97635], [36, 97835], [41, 98075], [48, 98775], [53, 98995], [55, 99155], [62, 99395], [67, 100115], [75, 100315], [80, 100655], [85, 100855], [88, 101015]]}, {"verse": 16, "start": 101922, "end": 105312, "text": "Jesus says to her, Go, call your husband, and come here.", "words": [[0, 101922], [6, 102162], [11, 102502], [14, 102722], [19, 103326], [23, 103442], [28, 103682], [33, 103842], [42, 104162], [46, 104662], [51, 104882]]}, {"verse": 17, "start": 105661, "end": 112878, "text": "The woman answered and said, I have no husband. Jesus said to her, You have well said, I have no husband:", "words": [[0, 105661], [4, 105757], [10, 105977], [19, 106457], [23, 106737], [29, 107439], [31, 107716], [36, 107956], [39, 108256], [48, 109398], [54, 109668], [59, 110008], [62, 110228], [67, 110754], [71, 110876], [76, 111036], [81, 111236], [87, 111696], [89, 111876], [94, 112096], [97, 112276]]}, {"verse": 18, "start": 113328, "end": 119245, "text": "For you have had five husbands; and he whom you now have is not your husband: in that did you say truly.", "words": [[0, 113328], [4, 113416], [8, 113556], [13, 113696], [17, 113876], [22, 114156], [32, 115186], [36, 115308], [39, 115508], [44, 115688], [48, 115868], [52, 116048], [57, 116348], [60, 116528], [64, 116728], [69, 116888], [78, 117772], [81, 117916], [86, 118256], [90, 118316], [94, 118456], [98, 118656]]}, {"verse": 19, "start": 119595, "end": 124705, "text": "The woman says to him, Sir, I perceive that you are a prophet.", "words": [[0, 119595], [4, 119715], [10, 119895], [15, 120195], [18, 120415], [23, 121479], [28, 122384], [30, 122584], [39, 123004], [44, 123384], [48, 123664], [52, 123964], [54, 124044]]}, {"verse": 20, "start": 125055, "end": 131311, "text": "Our fathers worshipped in this mountain; and you say, that in Jerusalem is the place where men ought to worship.", "words": [[0, 125055], [4, 125182], [12, 125762], [23, 126342], [26, 126462], [31, 126642], [41, 127507], [45, 127624], [49, 127764], [54, 128064], [59, 128504], [62, 128664], [72, 129164], [75, 129444], [79, 129564], [85, 129844], [91, 130084], [95, 130344], [101, 130624], [104, 130824]]}, {"verse": 21, "start": 131761, "end": 140084, "text": "Jesus says to her, Woman, believe me, the hour comes, when you shall neither in this mountain, nor yet at Jerusalem, worship the Father.", "words": [[0, 131761], [6, 131999], [11, 132319], [14, 132539], [19, 133130], [26, 133567], [34, 133687], [38, 134527], [42, 134627], [47, 134887], [54, 135347], [59, 135907], [63, 136047], [69, 136207], [77, 136467], [80, 136667], [85, 136807], [95, 137167], [99, 137727], [103, 138007], [106, 138227], [117, 138747], [125, 139307], [129, 139567]]}, {"verse": 22, "start": 140534, "end": 146125, "text": "You worship you know not what: we know what we worship: for salvation is of the Jews.", "words": [[0, 140534], [4, 140654], [12, 141194], [16, 141254], [21, 141434], [25, 141634], [31, 142401], [34, 142546], [39, 142826], [44, 143126], [47, 143286], [56, 144139], [60, 144290], [70, 144730], [73, 145290], [76, 145430], [80, 145550]]}, {"verse": 23, "start": 146575, "end": 154958, "text": "But the hour comes, and now is, when the true worshippers shall worship the Father in spirit and in truth: for the Father seeks such to worship him.", "words": [[0, 146575], [4, 146674], [8, 146814], [13, 147014], [20, 147714], [24, 147974], [28, 148234], [32, 148794], [37, 149034], [41, 149154], [46, 149394], [58, 149954], [64, 150234], [72, 150614], [76, 150794], [83, 151014], [86, 151234], [93, 151594], [97, 152094], [100, 152214], [107, 152930], [111, 153019], [115, 153119], [122, 153359], [128, 153699], [133, 153979], [136, 154179], [144, 154419]]}, {"verse": 24, "start": 155408, "end": 161244, "text": "God is a Spirit: and they that worship him must worship him in spirit and in truth.", "words": [[0, 155408], [4, 155765], [7, 156145], [9, 156285], [17, 157214], [21, 157377], [26, 157617], [31, 157857], [39, 158217], [43, 158597], [48, 158877], [56, 159317], [60, 159657], [63, 159917], [70, 160337], [74, 160657], [77, 160777]]}, {"verse": 25, "start": 161594, "end": 169496, "text": "The woman says to him, I know that Messias comes, which is called Christ: when he is come, he will tell us all things.", "words": [[0, 161594], [4, 161714], [10, 161894], [15, 162194], [18, 162414], [23, 163478], [25, 163598], [30, 163758], [35, 164168], [43, 164578], [50, 165038], [56, 165238], [59, 165378], [66, 165638], [74, 166839], [79, 166966], [82, 167156], [85, 167346], [91, 167866], [94, 167946], [99, 168086], [104, 168306], [107, 168526], [111, 168746]]}, {"verse": 26, "start": 169846, "end": 173244, "text": "Jesus says to her, I that speak to you am he.", "words": [[0, 169846], [6, 170086], [11, 170426], [14, 170646], [19, 171249], [21, 171494], [26, 171754], [32, 172034], [35, 172294], [39, 172554], [42, 172899]]}, {"verse": 27, "start": 173594, "end": 182841, "text": "¶ And upon this came his disciples, and marvelled that he talked with the woman: yet no man said, What do you seek? or, Why do you talk with her?", "words": [[2, 173594], [6, 173767], [11, 174007], [16, 174407], [21, 174767], [25, 175007], [36, 176027], [40, 176447], [50, 176867], [55, 176987], [58, 177127], [65, 177407], [70, 177647], [74, 177787], [81, 178580], [85, 178730], [88, 179010], [92, 179250], [98, 180030], [103, 180270], [106, 180470], [110, 180570], [116, 181406], [120, 181530], [124, 181750], [127, 181910], [131, 181990], [136, 182250], [141, 182510]]}, {"verse": 28, "start": 183291, "end": 187962, "text": "The woman then left her waterpot, and went her way into the city, and says to the men,", "words": [[0, 183291], [4, 183386], [10, 183626], [15, 183886], [20, 184146], [24, 184506], [34, 184866], [38, 185126], [43, 185326], [47, 185506], [51, 185706], [56, 185926], [60, 186106], [66, 186386], [70, 186926], [75, 187146], [78, 187386], [82, 187506]]}, {"verse": 29, "start": 188212, "end": 193804, "text": "Come, see a man, which told me all things that ever I did: is not this the Christ?", "words": [[0, 188212], [6, 188392], [10, 188672], [12, 188812], [17, 189112], [23, 189532], [28, 189892], [31, 190092], [35, 190352], [42, 190712], [47, 190992], [52, 191272], [54, 191492], [59, 192211], [62, 192378], [66, 192638], [71, 192958], [75, 193138]]}, {"verse": 30, "start": 194154, "end": 196984, "text": "Then they went out of the city, and came to him.", "words": [[0, 194154], [5, 194437], [10, 194697], [15, 194897], [19, 195157], [22, 195297], [26, 195417], [32, 195717], [36, 196177], [41, 196477], [44, 196717]]}, {"verse": 31, "start": 197434, "end": 201248, "text": "¶ In the mean while his disciples prayed him, saying, Master, eat.", "words": [[2, 197434], [5, 197578], [9, 197698], [14, 197938], [20, 198238], [24, 198418], [34, 198918], [41, 199298], [46, 199758], [54, 200490], [62, 200893]]}, {"verse": 32, "start": 201598, "end": 205115, "text": "But he said to them, I have food to eat that you know not of.", "words": [[0, 201598], [4, 201726], [7, 201806], [12, 202006], [15, 202206], [21, 202774], [23, 202915], [28, 203135], [33, 203415], [36, 203635], [40, 203875], [45, 204095], [49, 204275], [54, 204455], [58, 204655]]}, {"verse": 33, "start": 205465, "end": 210432, "text": "Therefore said the disciples one to another, Has any man brought him anything to eat?", "words": [[0, 205465], [10, 205826], [15, 206186], [19, 206366], [29, 206866], [33, 207266], [36, 207506], [45, 208272], [49, 208457], [53, 208697], [57, 208997], [65, 209237], [69, 209437], [78, 209757], [81, 210017]]}, {"verse": 34, "start": 210782, "end": 217548, "text": "Jesus says to them, My food is to do the will of him that sent me, and to finish his work.", "words": [[0, 210782], [6, 211066], [11, 211406], [14, 211646], [20, 213987], [23, 214150], [28, 214430], [31, 214590], [34, 214730], [37, 214850], [41, 214970], [46, 215150], [49, 215310], [53, 215470], [58, 215670], [63, 215910], [67, 216150], [71, 216450], [74, 216590], [81, 216830], [85, 217070]]}, {"verse": 35, "start": 217998, "end": 228460, "text": "Say not you, There are yet four months, and then comes harvest? behold, I say to you, Lift up your eyes, and look on the fields; for they are white already to harvest.", "words": [[0, 217998], [4, 218204], [8, 218404], [13, 218764], [19, 218864], [23, 218964], [27, 219164], [32, 219444], [40, 220104], [44, 220264], [49, 220384], [55, 220624], [64, 221616], [72, 222134], [74, 222214], [78, 222454], [81, 222634], [86, 223274], [91, 223534], [94, 223814], [99, 223954], [105, 224374], [109, 224834], [114, 225014], [117, 225174], [121, 225314], [129, 226265], [133, 226352], [138, 226532], [142, 226672], [148, 226992], [156, 227572], [159, 227832]]}, {"verse": 36, "start": 228910, "end": 236489, "text": "And he that reaps receives wages, and gathers fruit to life eternal: that both he that sows and he that reaps may rejoice together.", "words": [[0, 228910], [4, 229052], [7, 229212], [12, 229432], [18, 229832], [27, 230272], [34, 230772], [38, 231252], [46, 231592], [52, 231912], [55, 232092], [60, 232312], [69, 233180], [74, 233304], [79, 233544], [82, 233764], [87, 233944], [92, 234364], [96, 234584], [99, 234704], [104, 234884], [110, 235224], [114, 235444], [122, 235824]]}, {"verse": 37, "start": 236939, "end": 240611, "text": "And herein is that saying true, One sows, and another reaps.", "words": [[0, 236939], [4, 237151], [11, 237401], [14, 237581], [19, 237761], [26, 238121], [32, 238401], [36, 238741], [42, 239221], [46, 239641], [54, 239921]]}, {"verse": 38, "start": 241061, "end": 247658, "text": "I sent you to reap that on which you bestowed no labour: other men laboured, and you are entered into their labours.", "words": [[0, 241061], [2, 241186], [7, 241446], [11, 241626], [14, 241766], [19, 242006], [24, 242246], [27, 242466], [33, 242666], [37, 242846], [46, 243366], [49, 243826], [57, 244573], [63, 244772], [67, 245222], [77, 245672], [81, 245892], [85, 246032], [89, 246152], [97, 246492], [102, 246872], [108, 247292]]}, {"verse": 39, "start": 248008, "end": 256204, "text": "¶ And many of the Samaritans of that city believed on him for the saying of the woman, which testified, He told me all that ever I did.", "words": [[2, 248008], [6, 248153], [11, 248413], [14, 248573], [18, 248693], [29, 249353], [32, 249473], [37, 249653], [42, 249953], [51, 250353], [54, 250673], [58, 250873], [62, 251073], [66, 251193], [73, 251513], [76, 251693], [80, 251833], [87, 252673], [93, 252853], [104, 254078], [107, 254178], [112, 254398], [115, 254598], [119, 254918], [124, 255158], [129, 255458], [131, 255718]]}, {"verse": 40, "start": 256554, "end": 263306, "text": "So when the Samaritans were come to him, they besought him that he would stay with them: and he stayed there two days.", "words": [[0, 256554], [3, 256674], [8, 256874], [12, 257014], [23, 257654], [28, 257794], [33, 258094], [36, 258314], [41, 258934], [46, 259094], [55, 259534], [59, 259754], [64, 259934], [67, 260034], [73, 260214], [78, 260514], [83, 260794], [89, 261504], [93, 261671], [96, 261791], [103, 262051], [109, 262411], [113, 262651]]}, {"verse": 41, "start": 263756, "end": 266575, "text": "And many more believed because of his own word;", "words": [[0, 263756], [4, 263918], [9, 264158], [14, 264438], [23, 264878], [31, 265358], [34, 265578], [38, 265718], [42, 265918]]}, {"verse": 42, "start": 267025, "end": 276250, "text": "And said to the woman, Now we believe, not because of your saying: for we have heard him ourselves, and know that this is indeed the Christ, the Saviour of the world.", "words": [[0, 267025], [4, 267147], [9, 267467], [12, 267727], [16, 267847], [23, 268603], [27, 268880], [30, 269100], [39, 269480], [43, 269820], [51, 270180], [54, 270400], [59, 270520], [67, 271333], [71, 271403], [74, 271563], [79, 271703], [85, 271983], [89, 272123], [100, 272643], [104, 273223], [109, 273503], [114, 273703], [119, 273903], [122, 274023], [129, 274323], [133, 274543], [141, 275063], [145, 275253], [153, 275443], [156, 275663], [160, 275783]]}, {"verse": 43, "start": 276600, "end": 280961, "text": "¶ Now after two days he departed from there, and went into Galilee.", "words": [[2, 276600], [6, 276772], [12, 277072], [16, 277352], [21, 277712], [24, 277892], [33, 278312], [38, 278672], [45, 278992], [49, 279552], [54, 279772], [59, 280072]]}, {"verse": 44, "start": 281411, "end": 286620, "text": "For Jesus himself testified, that a prophet has no honour in his own country.", "words": [[0, 281411], [4, 281518], [10, 281818], [18, 282298], [29, 282939], [34, 283379], [36, 283478], [44, 283838], [48, 284138], [51, 284439], [58, 284738], [61, 284958], [65, 285118], [69, 285258]]}, {"verse": 45, "start": 287070, "end": 295534, "text": "Then when he was come into Galilee, the Galilæans received him, having seen all the things that he did at Jerusalem at the feast: for they also went to the feast.", "words": [[0, 287070], [5, 287250], [10, 287410], [13, 287550], [17, 287750], [22, 287950], [27, 288150], [36, 288810], [40, 289140], [50, 289470], [59, 289870], [64, 290550], [71, 290730], [76, 291050], [80, 291350], [84, 291530], [91, 291770], [96, 291990], [99, 292090], [103, 292310], [106, 292410], [116, 292830], [119, 293090], [123, 293190], [130, 293982], [134, 294072], [139, 294212], [144, 294472], [149, 294752], [152, 294912], [156, 295012]]}, {"verse": 46, "start": 295984, "end": 304528, "text": "So Jesus came again into Cana of Galilee, where he made the water wine. And there was a certain nobleman, whose son was sick at Capernaum.", "words": [[0, 295984], [3, 296104], [9, 296424], [14, 296804], [20, 297144], [25, 297364], [30, 297904], [33, 298044], [42, 299044], [48, 299204], [51, 299364], [56, 299564], [60, 299704], [66, 299944], [72, 300911], [76, 301037], [82, 301137], [86, 301297], [88, 301457], [96, 301677], [106, 302337], [112, 302557], [116, 302917], [120, 303097], [125, 303437], [128, 303637]]}, {"verse": 47, "start": 304978, "end": 314186, "text": "When he heard that Jesus was come out of Judæa into Galilee, he went to him, and besought him that he would come down, and heal his son: for he was at the point of death.", "words": [[0, 304978], [5, 305084], [8, 305204], [14, 305444], [19, 305624], [25, 305924], [29, 306204], [34, 306384], [38, 306564], [41, 306844], [47, 307124], [52, 307244], [61, 308324], [64, 308384], [69, 308604], [72, 308784], [77, 309004], [81, 309264], [90, 309684], [94, 309904], [99, 310204], [102, 310304], [108, 310404], [113, 310604], [119, 310924], [123, 311264], [128, 311464], [132, 311684], [137, 312460], [141, 312600], [144, 312800], [148, 313020], [151, 313180], [155, 313320], [161, 313560], [164, 313720]]}, {"verse": 48, "start": 314636, "end": 319807, "text": "Then said Jesus to him, Unless you see signs and wonders, you will not believe.", "words": [[0, 314636], [5, 314840], [10, 315120], [16, 315460], [19, 315780], [24, 316330], [31, 316579], [35, 316799], [39, 317019], [45, 317419], [49, 317659], [58, 318559], [62, 318719], [67, 318859], [71, 319079]]}, {"verse": 49, "start": 320157, "end": 325255, "text": "The nobleman says to him, Sir, come down before my child die.", "words": [[0, 320157], [4, 320245], [13, 320785], [18, 321045], [21, 321285], [26, 322302], [31, 322918], [36, 323098], [41, 323338], [48, 323618], [51, 323858], [57, 324118]]}, {"verse": 50, "start": 325605, "end": 334834, "text": "Jesus says to him, Go your way; your son lives. And the man believed the word that Jesus had spoken to him, and he went his way.", "words": [[0, 325605], [6, 325859], [11, 326219], [14, 326459], [19, 327785], [22, 327925], [27, 328105], [32, 328907], [37, 329006], [41, 329286], [48, 330286], [52, 330414], [56, 330514], [60, 330754], [69, 331154], [73, 331394], [78, 331654], [83, 331854], [89, 332174], [93, 332474], [100, 332854], [103, 333134], [108, 333574], [112, 333754], [115, 333894], [120, 334094], [124, 334314]]}, {"verse": 51, "start": 335284, "end": 340990, "text": "And as he was now going down, his servants met him, and told him, saying, Your son lives.", "words": [[0, 335284], [4, 335424], [7, 335624], [10, 335744], [14, 335924], [18, 336124], [24, 336424], [30, 337084], [34, 337184], [43, 337544], [47, 337884], [52, 338084], [56, 338244], [61, 338484], [66, 338804], [74, 339907], [79, 340040], [83, 340340]]}, {"verse": 52, "start": 341340, "end": 349036, "text": "Then enquired he of them the hour when he began to amend. And they said to him, Yesterday at the seventh hour the fever left him.", "words": [[0, 341340], [5, 341730], [14, 342120], [17, 342280], [20, 342460], [25, 342640], [29, 342860], [34, 343180], [39, 343460], [42, 343600], [48, 343900], [51, 344100], [58, 344978], [62, 345106], [67, 345246], [72, 345486], [75, 345706], [80, 346266], [90, 346530], [93, 346950], [97, 347050], [105, 347330], [110, 348030], [114, 348110], [120, 348410], [125, 348710]]}, {"verse": 53, "start": 349386, "end": 357883, "text": "So the father knew that it was at the same hour, in which Jesus said to him, Your son lives: and himself believed, and his whole house.", "words": [[0, 349386], [3, 349506], [7, 349646], [14, 349946], [19, 350306], [24, 350586], [27, 350686], [31, 350826], [34, 350966], [38, 351066], [43, 351346], [49, 351666], [52, 352186], [58, 352366], [64, 352706], [69, 353106], [72, 353306], [77, 353806], [82, 353986], [86, 354266], [93, 355287], [97, 355428], [105, 355768], [115, 356318], [119, 356868], [123, 357028], [129, 357268]]}, {"verse": 54, "start": 358333, "end": 363979, "text": "This is again the second miracle that Jesus did, when he was come out of Judæa into Galilee.", "words": [[0, 358333], [5, 358576], [8, 358736], [14, 358976], [18, 359196], [25, 359456], [33, 359936], [38, 360176], [44, 360436], [49, 360876], [54, 361556], [57, 361676], [61, 361816], [66, 362036], [70, 362236], [73, 362596], [79, 362956], [84, 363176]]}]}