{"book": "MAT", "chapter": 15, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 255214, "verses": [{"verse": 1, "start": 300, "end": 5167, "text": "Then came to Jesus scribes and Pharisees, which were of Jerusalem, saying,", "words": [[0, 300], [5, 486], [10, 786], [13, 986], [19, 1586], [27, 1926], [31, 2046], [42, 3206], [48, 3486], [53, 3726], [56, 3866], [67, 4646]]}, {"verse": 2, "start": 5367, "end": 11093, "text": "Why do your disciples transgress the tradition of the elders? for they wash not their hands when they eat bread.", "words": [[0, 5367], [4, 5611], [7, 5811], [12, 5971], [22, 6451], [33, 7091], [37, 7311], [47, 7791], [50, 7991], [54, 8131], [62, 8835], [66, 8905], [71, 9065], [76, 9365], [80, 9585], [86, 9825], [92, 10145], [97, 10345], [102, 10505], [106, 10685]]}, {"verse": 3, "start": 11373, "end": 17148, "text": "But he answered and said to them, Why do you also transgress the commandment of God by your tradition?", "words": [[0, 11373], [4, 11558], [7, 11738], [16, 12198], [20, 12518], [25, 12798], [28, 12998], [34, 13564], [38, 13730], [41, 13870], [45, 14010], [50, 14270], [61, 14890], [65, 15090], [77, 15610], [80, 15790], [84, 16090], [87, 16390], [92, 16530]]}, {"verse": 4, "start": 17498, "end": 23896, "text": "For God commanded, saying, Honour your father and mother: and, He that curses father or mother, let him die the death.", "words": [[0, 17498], [4, 17607], [8, 17867], [19, 18287], [27, 18917], [34, 19547], [39, 19787], [46, 20127], [50, 20407], [58, 21083], [63, 21083], [66, 21229], [71, 21429], [78, 21809], [85, 22149], [88, 22349], [96, 22849], [100, 23009], [104, 23149], [108, 23409], [112, 23549]]}, {"verse": 5, "start": 24246, "end": 30144, "text": "But you say, Whoever shall say to his father or his mother, It is a gift, by whatever you might be profited by me;", "words": [[0, 24246], [4, 24345], [8, 24505], [13, 24765], [21, 25025], [27, 25305], [31, 25525], [34, 25645], [38, 25785], [45, 26105], [48, 26345], [52, 26505], [60, 27225], [63, 27365], [66, 27505], [68, 27605], [74, 27905], [77, 28385], [86, 28625], [90, 28845], [96, 28985], [99, 29145], [108, 29565], [111, 29785]]}, {"verse": 6, "start": 30494, "end": 38083, "text": "And honour not his father or his mother, he shall be free. Thus have you made the commandment of God of none effect by your tradition.", "words": [[0, 30494], [4, 30710], [11, 30960], [15, 31200], [19, 31440], [26, 31780], [29, 32060], [33, 32280], [41, 32940], [44, 33020], [50, 33240], [53, 33400], [59, 34075], [64, 34300], [69, 34560], [73, 34680], [78, 34860], [82, 35000], [94, 35580], [97, 35740], [101, 36040], [104, 36200], [109, 36680], [116, 36940], [119, 37240], [124, 37380]]}, {"verse": 7, "start": 38433, "end": 41859, "text": "You hypocrites, well did Esaias prophesy of you, saying,", "words": [[0, 38433], [4, 38590], [16, 39230], [21, 39430], [25, 39850], [32, 40270], [41, 40690], [44, 40990], [49, 41310]]}, {"verse": 8, "start": 42209, "end": 47314, "text": "This people draws near to me with their mouth, and honours me with their lips; but their heart is far from me.", "words": [[0, 42209], [5, 42346], [12, 42646], [18, 42966], [23, 43226], [26, 43406], [29, 43546], [34, 43726], [40, 43866], [47, 44186], [51, 44526], [59, 44866], [62, 45106], [67, 45266], [73, 45406], [79, 46158], [83, 46255], [89, 46395], [95, 46635], [98, 46775], [102, 47055], [107, 47275]]}, {"verse": 9, "start": 47665, "end": 52567, "text": "But in vain they do worship me, teaching for doctrines the commandments of men.", "words": [[0, 47665], [4, 47768], [7, 47948], [12, 48228], [17, 48548], [20, 48808], [28, 49168], [32, 49928], [41, 50308], [45, 50608], [55, 51228], [59, 51368], [72, 51808], [75, 52148]]}, {"verse": 10, "start": 52847, "end": 57080, "text": "¶ And he called the multitude, and said to them, Hear, and understand:", "words": [[2, 52847], [6, 52970], [9, 53070], [16, 53350], [20, 53530], [31, 54010], [35, 54650], [40, 54890], 