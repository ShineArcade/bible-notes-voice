{"book": "GEN", "chapter": 16, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 145922, "verses": [{"verse": 1, "start": 300, "end": 7022, "text": "Y Sarai, mujer de Abram, no le paría: y ella tenía una sierva egipcia, que se llamaba Agar.", "words": [[0, 300], [2, 531], [9, 801], [15, 1061], [18, 1281], [25, 2061], [28, 2221], [31, 2361], [38, 3223], [40, 3340], [45, 3560], [51, 3867], [55, 4172], [62, 4480], [71, 5300], [75, 5720], [78, 5880], [86, 6380]]}, {"verse": 2, "start": 7372, "end": 19540, "text": "Dijo, pues, Sarai a Abram: Ya ves que Jehová me ha hecho estéril: te ruego que entres a mi sierva; quizá tendré hijos de ella. Y atendió Abram al dicho de Sarai.", "words": [[0, 7372], [6, 8116], [12, 8636], [18, 9236], [20, 9496], [27, 10106], [30, 10290], [34, 10510], [38, 10690], [45, 11170], [48, 11310], [51, 11450], [57, 11650], [66, 12704], [69, 12824], [75, 12944], [79, 13244], [86, 13604], [88, 13724], [91, 13864], [99, 14662], [105, 15026], [112, 15466], [118, 15686], [121, 15946], [127, 16630], [129, 16771], [137, 17531], [143, 18291], [146, 18451], [152, 18711], [155, 19148]]}, {"verse": 3, "start": 19890, "end": 31378, "text": "Y Sarai, mujer de Abram, tomó a Agar su sierva egipcia, al cabo de diez años que había habitado Abram en la tierra de Canaán, y la dio a Abram su marido por mujer.", "words": [[0, 19890], [2, 20231], [9, 20601], [15, 20901], [18, 21181], [25, 21981], [30, 22441], [32, 22601], [37, 22941], [40, 23101], [47, 23521], [56, 24101], [59, 24301], [64, 24581], [67, 24801], [72, 25061], [77, 25501], [81, 25761], [87, 26041], [96, 26761], [102, 27221], [105, 27381], [108, 27501], [115, 27781], [118, 28365], [126, 29113], [128, 29277], [131, 29377], [135, 29597], [137, 29887], [143, 30177], [146, 30277], [153, 30637], [157, 30837]]}, {"verse": 4, "start": 31728, "end": 39125, "text": "Y él cohabitó con Agar, la cual concibió: y cuando vio que había concebido, miraba con desprecio a su señora.", "words": [[0, 31728], [2, 32148], [5, 32568], [14, 32988], [18, 33168], [24, 33908], [27, 33988], [32, 34512], [42, 35200], [44, 35298], [51, 35498], [55, 35838], [59, 35978], [65, 36198], [76, 37078], [83, 37418], [87, 37618], [97, 38278], [99, 38298], [102, 38418]]}, {"verse": 5, "start": 39475, "end": 51778, "text": "Entonces Sarai dijo a Abram: Mi afrenta sea sobre ti: yo puse mi sierva en tu seno, y viéndose embarazada, me mira con desprecio; juzgue Jehová entre mí y ti.", "words": [[0, 39475], [9, 40105], [15, 40735], [20, 41335], [22, 41634], [29, 42338], [32, 42463], [40, 43023], [44, 43243], [50, 43583], [54, 44253], [57, 44481], [62, 44801], [65, 44981], [72, 45361], [75, 45481], [78, 45601], [84, 46201], [86, 46521], [95, 46961], [107, 48061], [110, 48181], [115, 48421], [119, 48621], [130, 49718], [137, 50192], [144, 50672], [150, 50932], [153, 51212], [155, 51412]]}, {"verse": 6, "start": 52058, "end": 62831, "text": "Y respondió Abram a Sarai: He ahí tu sierva en tu mano, haz con ella lo que bien te parezca. Y como Sarai la afligiese, huyó de su presencia.", "words": [[0, 52058], [2, 52475], [12, 52925], [18, 53422], [20, 53920], [27, 54559], [30, 54738], [34, 54978], [37, 55138], [44, 55558], [47, 55658], [50, 55778], [56, 56618], [60, 56818], [64, 57078], [69, 57278], [72, 57478], [76, 57618], [81, 57818], [84, 57998], [93, 58886], [95, 59011], [100, 59298], [106, 59584], [109, 59871], [120, 60891], [125, 61611], [128, 61771], [131, 61931]]}, {"verse": 7, "start": 63181, "end": 70810, "text": "Y la halló el ángel de Jehová junto a una fuente de agua en el desierto, junto a la fuente que está en el camino del Sur.", "words": [[0, 63181], [2, 63327], [5, 63487], [11, 63867], [14, 64027], [20, 64487], [23, 64647], [30, 65147], [36, 65347], [38, 65607], [42, 65767], [49, 66227], [52, 66387], [57, 66627], [60, 66767], [63, 66887], [73, 67547], [79, 68107], [81, 68407], [84, 68467], [91, 68927], [95, 69107], [100, 69387], [103, 69607], [106, 69727], [113, 70007], [117, 70307]]}, {"verse": 8, "start": 71160, "end": 80987, "text": "Y le dijo: Agar, sierva de Sarai, ¿de dónde vienes tú, y a dónde vas? Y ella respondió: Huyo de delante de Sarai, mi señora.", "words": [[0, 71160], [2, 71282], [5, 71402], [11, 72173], [17, 72530], [24, 73030], [27, 73640], [34, 74250], [38, 74510], [44, 74710], [51, 75230], [55, 75390], [57, 75850], [59, 75950], [65, 76110], [70, 76961], [72, 77198], [77, 77418], [88, 78459], [93, 78739], [96, 78899], [104, 79339], [107, 79439], [114, 80019], [117, 80419]]}, {"verse": 9, "start": 81267, "end": 87320, "text": "Y le dijo el ángel de Jehová: Vuélvete a tu señora, y ponte sumisa bajo de su mano.", "words": [[0, 81267], [2, 81393], [5, 81493], [10, 81753], [13, 81953], [19, 82313], [22, 82433], [30, 83255], [39, 83742], [41, 83862], [44, 83942], [52, 84442], [54, 84922], [60, 85472], [67, 86022], [72, 86302], [75, 86542], [78, 86722]]}, {"verse": 10, "start": 87670, "end": 96636, "text": "Le dijo también el ángel de Jehová: Multiplicaré tanto tu descendencia, que no podrá ser contada a causa de la multitud.", "words": [[0, 87670], [3, 87755], [8, 88015], [16, 88455], [19, 88795], [25, 89215], [28, 89335], [36, 90141], [49, 91007], [55, 91387], [58, 91787], [72, 93227], [76, 93447], [79, 93607], [85, 94067], [89, 94267], [97, 94947], [99, 95107], [105, 95407], [108, 95667], [111, 95747]]}, {"verse": 11, "start": 96986, "end": 105344, "text": "Le dijo aún el ángel de Jehová: He aquí que has concebido, y darás a luz un hijo, y llamarás su nombre Ismael, porque Jehová ha oído tu aflicción.", "words": [[0, 96986], [3, 97093], [8, 97393], [12, 97673], [15, 97833], [21, 98253], [24, 98604], [32, 99195], [35, 99265], [40, 99525], [44, 99685], [48, 99825], [59, 100405], [61, 100505], [67, 100845], [69, 100945], [73, 101165], [76, 101265], [82, 101525], [84, 101720], [93, 102140], [96, 102280], [103, 102520], [111, 103260], [118, 103520], [125, 104060], [128, 104180], [133, 104480], [136, 104660]]}, {"verse": 12, "start": 105624, "end": 114738, "text": "Y él será hombre fiero; su mano contra todos, y las manos de todos contra él, y delante de todos sus hermanos habitará.", "words": [[0, 105624], [2, 105846], [5, 106046], [10, 106406], [17, 106946], [24, 107772], [27, 107955], [32, 108215], [39, 108615], [46, 109115], [48, 109815], [52, 109955], [58, 110215], [61, 110375], [67, 110715], [74, 111235], [78, 111755], [80, 112295], [88, 112815], [91, 112995], [97, 113255], [101, 113535], [110, 114172]]}, {"verse": 13, "start": 115088, "end": 124553, "text": "Entonces llamó el nombre de Jehová que con ella hablaba: Tú eres el Dios que ve; porque dijo: ¿No he visto también aquí al que me ve?", "words": [[0, 115088], [9, 115519], [15, 116319], [18, 116419], [25, 116739], [28, 116939], [35, 117499], [39, 117839], [43, 118059], [48, 118239], [57, 119301], [60, 119442], [65, 119662], [68, 119922], [73, 120102], [77, 120362], [81, 121712], [88, 121882], [94, 122602], [98, 122748], [101, 122808], [107, 123028], [115, 123368], [120, 123768], [123, 123968], [127, 124088], [130, 124208]]}, {"verse": 14, "start": 124833, "end": 131745, "text": "Por lo cual llamó al pozo, Pozo del Viviente que me ve. He aquí está entre Cades y Bered.", "words": [[0, 124833], [4, 125019], [7, 125119], [12, 125399], [18, 125819], [21, 125979], [27, 126859], [32, 127519], [36, 127719], [45, 128279], [49, 128479], [52, 128639], [56, 129311], [59, 129401], [64, 129641], [69, 130001], [75, 130541], [81, 131081], [83, 131441]]}, {"verse": 15, "start": 132095, "end": 139425, "text": "Y parió Agar a Abram un hijo, y llamó Abram el nombre de su hijo que le parió Agar, Ismael.", "words": [[0, 132095], [2, 132240], [8, 132750], [13, 133260], [15, 133560], [21, 134200], [24, 134420], [30, 135360], [32, 135440], [38, 135800], [44, 136280], [47, 136420], [54, 136780], [57, 137000], [60, 137240], [65, 137500], [69, 137720], [72, 137880], [78, 138346], [84, 138813]]}, {"verse": 16, "start": 139775, "end": 145522, "text":