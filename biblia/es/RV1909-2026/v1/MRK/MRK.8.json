{"book": "MRK", "chapter": 8, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 295782, "verses": [{"verse": 1, "start": 300, "end": 8248, "text": "En aquellos días, cuando hubo gran multitud, y no tenían qué comer, Jesús llamó a sus discípulos, y les dijo:", "words": [[0, 300], [3, 407], [12, 647], [18, 1667], [25, 1827], [30, 2247], [35, 2487], [45, 3247], [47, 3472], [50, 3732], [57, 3992], [61, 4212], [68, 4987], [74, 5367], [80, 6187], [82, 6267], [86, 6447], [98, 7307], [100, 7527], [104, 7687]]}, {"verse": 2, "start": 8598, "end": 15002, "text": "Tengo compasión de la multitud, porque ya hace tres días que están conmigo, y no tienen qué comer:", "words": [[0, 8598], [6, 8840], [16, 9500], [19, 9640], [22, 9740], [32, 10380], [39, 10960], [42, 11300], [47, 11680], [52, 11960], [57, 12320], [61, 12520], [67, 12720], [76, 13580], [78, 13780], [81, 13970], [88, 14160], [92, 14400]]}, {"verse": 3, "start": 15352, "end": 22903, "text": "Y si los envío en ayunas a sus casas, desmayarán en el camino; porque algunos de ellos han venido de lejos.", "words": [[0, 15352], [2, 15631], [5, 15751], [9, 15911], [15, 16411], [18, 16511], [25, 16991], [27, 17111], [31, 17251], [38, 17871], [49, 19011], [52, 19271], [55, 19411], [63, 20236], [70, 20440], [78, 20860], [81, 21080], [87, 21340], [91, 21580], [98, 22040], [101, 22180]]}, {"verse": 4, "start": 23253, "end": 29646, "text": "Y sus discípulos le respondieron: ¿De dónde podrá alguien hartar a estos de pan aquí en el desierto?", "words": [[0, 23253], [2, 23360], [6, 23540], [17, 24340], [20, 24560], [34, 25941], [38, 26117], [44, 26317], [50, 26797], [58, 27037], [65, 27497], [67, 27577], [73, 27777], [76, 27997], [80, 28257], [85, 28557], [88, 28857], [91, 28957]]}, {"verse": 5, "start": 29926, "end": 34803, "text": "Y les preguntó: ¿Cuántos panes tenéis? Y ellos dijeron: Siete.", "words": [[0, 29926], [2, 30069], [6, 30149], [16, 31159], [25, 31544], [31, 31964], [39, 32903], [41, 33071], [47, 33271], [56, 34511]]}, {"verse": 6, "start": 35083, "end": 49208, "text": "Entonces mandó a la multitud que se recostase en tierra; y tomando los siete panes, habiendo dado gracias, partió, y dio a sus discípulos que los pusiesen delante: y los pusieron delante a la multitud.", "words": [[0, 35083], [9, 35664], [15, 36524], [17, 36604], [20, 36704], [29, 37264], [33, 37444], [36, 37584], [46, 38224], [49, 38444], [57, 39345], [59, 39453], [67, 39873], [71, 40033], [77, 40333], [84, 41213], [93, 41553], [98, 41793], [107, 42713], [115, 43213], [117, 43853], [121, 44093], [123, 44333], [127, 44533], [138, 45433], [142, 45613], [146, 45973], [155, 46333], [164, 47190], [166, 47293], [170, 47393], [179, 47833], [187, 48333], [189, 48453], [192, 48513]]}, {"verse": 7, "start": 49558, "end": 55505, "text": "Tenían también unos pocos pececillos: y los bendijo, y mandó que también los pusiesen delante.", "words": [[0, 49558], [7, 49822], [15, 50202], [20, 50442], [26, 51152], [38, 52030], [40, 52116], [44, 52236], [53, 53276], [55, 53356], [61, 53676], [65, 53776], [73, 54096], [77, 54236], [86, 54696]]}, {"verse": 8, "start": 55855, "end": 62303, "text": "Y comieron, y se saciaron: y levantaron de los pedazos que habían sobrado, siete canastas.", "words": [[0, 55855], [2, 55962], [12, 56362], [14, 56562], [17, 56662], [27, 57715], [29, 57841], [40, 58501], [43, 58701], [47, 58841], [55, 59861], [59, 60081], [66, 60321], [75, 60921], [81, 61241]]}, {"verse": 9, "start": 62653, "end": 66626, "text": "Y eran los que comieron, como cuatro mil: y los despidió.", "words": [[0, 62653], [2, 62949], [7, 63149], [11, 63349], [15, 63509], [25, 63949], [30, 64432], [37, 64916], [42, 65565], [44, 65706], [48, 65826]]}, {"verse": 10, "start": 66976, "end": 72669, "text": "Y luego entrando en el barco con sus discípulos, vino a las partes de Dalmanutha.", "words": [[0, 66976], [2, 67117], [8, 67297], [17, 67937], [20, 68097], [23, 68237], [29, 68697], [33, 68917], [37, 69117], [49, 70317], [54, 70797], [56, 71017], [60, 71137], [67, 71557], [70, 72133]]}, {"verse": 11, "start": 73019, "end": 80625, "text": "Y vinieron los fariseos, y comenzaron a discutir con él, pidiéndole señal del cielo, poniéndolo a prueba.", "words": [[0, 73019], [2, 73140], [11, 73580], [15, 73780], [25, 74640], [27, 75040], [38, 75800], [40, 75920], [49, 76500], [53, 76680], [57, 77380], [68, 77940], [74, 78400], [78, 78520], [85, 79300], [96, 79920], [98, 80040]]}, {"verse": 12, "start": 80975, "end": 90261, "text": "Y gimiendo en su espíritu, dice: ¿Por qué pide señal esta generación? De cierto os digo que no se dará señal a esta generación.", "words": [[0, 80975], [2, 81318], [11, 81678], [14, 81798], [17, 81978], [27, 82778], [33, 83566], [38, 83690], [42, 83870], [47, 84210], [53, 84710], [58, 84910], [70, 86180], [73, 86345], [80, 86905], [83, 87005], [88, 87285], [92, 87525], [95, 87705], [98, 87885], [103, 88225], [109, 88745], [111, 88905], [116, 89225]]}, {"verse": 13, "start": 90611, "end": 95358, "text": "Y dejándolos, volvió a entrar en el barco, y se fue de la otra parte.", "words": [[0, 90611], [2, 90732], [14, 91532], [21, 92152], [23, 92212], [30, 92572], [33, 92832], [36, 92952], [43, 93492], [45, 93912], [48, 94052], [52, 94252], [55, 94372], [58, 94492], [63, 94672]]}, {"verse": 14, "start": 95708, "end": 101169, "text": "Y se habían olvidado de tomar pan, y no tenían sino un pan consigo en el barco.", "words": [[0, 95708], [2, 95826], [5, 95926], [12, 96126], [21, 96786], [24, 96966], [30, 97246], [35, 97586], [37, 98066], [40, 98206], [47, 98606], [52, 99026], [55, 99386], [59, 99686], [67, 100246], [70, 100486], [73, 100626]]}, {"verse": 15, "start": 101519, "end": 108723, "text": "Y les advirtió, diciendo: Mirad, guardaos de la levadura de los fariseos, y de la levadura de Herodes.", "words": [[0, 101519], [2, 101663], [6, 101863], [16, 102603], [26, 103533], [33, 104359], [42, 104999], [45, 105179], [48, 105319], [57, 105819], [60, 105979], [64, 106099], [74, 106879], [76, 107099], [79, 107219], [82, 107359], [91, 107859], [94, 108039]]}, {"verse": 16, "start": 109073, "end": 111959, "text": "Y discutían entre sí porque no tenían pan.", "words": [[0, 109073], [2, 109639], [12, 110220], [18, 110460], [21, 110720], [28, 110960], [31, 111160], [38, 111440]]}, {"verse": 17, "start": 112239, "end": 122224, "text": "Y como Jesús lo entendió, les dice: ¿Por qué discutís, porque no tenéis pan? ¿no consideráis ni entendéis? ¿aún tenéis endurecido vuestro corazón?", "words": [[0, 112239], [2, 112360], [7, 112620], [13, 112980], [16, 113280], [26, 114280], [30, 114500], [36, 115287], [41, 115391], [45, 115571], [55, 116131], [62, 116351], [65, 116571], [72, 116931], [77, 117622], [81, 117731], [93, 118491], [96, 118631], [107, 119820], [112, 120005], [119, 120425], [130, 121065], [138, 121405]]}, {"verse": 18, "start": 122574, "end": 127881, "text": "¿Teniendo ojos no veis, y teniendo oídos no oís? ¿y no os acordáis?", "words": [[0, 122574], [10, 122978], [15, 123278], [18, 123538], [24, 123938], [26, 124118], [35, 124618], [41, 125358], [44, 125678], [49, 126548], [52, 126677], [55, 126817], [58, 126957]]}, {"verse": 19, "start": 128231, "end": 137296, "text": "Cuando partí los cinco panes entre cinco mil, ¿cuántas cestas llenas de los pedazos recogisteis? Y ellos dijeron: Doce.", "words": [[0, 128231], [7, 128413], [13, 128913], [17, 129033], [23, 129353], [29, 129893], [35, 130093], [41, 130573], [46, 131233], [55, 131963], [62, 132583], [69, 133003], [72, 133143], [76, 133263], [84, 133963], [97, 135440], [99, 135607], [105, 135807], [114, 137024]]}, {"verse": 20, "start": 137576, "end": 145510, "text": "Y cuando los siete panes entre cuatro mil, ¿cuántas canastas llenas de los pedazos recogisteis? Y ellos dijeron: Siete.", "words": [[0, 137576], [2, 137679], [9, 137879], [13, 138139], [19, 138499], [25, 139079], [31, 139319], [38, 139619], [43, 140079], [52, 140674], [61, 141334], [68, 141654], [71, 141754], [75, 141874], [83, 142334], [96, 143610], [98, 143777], [104, 143977], [113, 145218]]}, {"verse": 21, "start": 145790, "end": 148649, "text": "Y les dijo: ¿Cómo aún no entendéis?", "words": [[0, 145790], [2, 145937], [6, 146077], [12, 146812], [18, 147200], [22, 147440], [25, 147680]]}, {"verse": 22, "start": 148999, "end": 153829, "text": "Y vino a Betsaida; y le traen un ciego, y le ruegan que le tocase.", "words": [[0, 148999], [2, 149125], [7, 149385], [9, 149834], [19, 150464], [21, 150566], [24, 150646], [30, 151086], [33, 151226], [40, 151766], [42, 152246], [45, 152366], [52, 152786], [56, 152946], [59, 153046]]}, {"verse": 23, "start": 153829, "end": 164315, "text": "Entonces, tomando la mano del ciego, le sacó fuera de la aldea; y escupiendo en sus ojos, y poniéndole las manos encima, le preguntó si veía algo.", "words": [[0, 153829], [10, 154349], [18, 154969], [21, 155089], [26, 155309], [30, 155509], [37, 156009], [40, 156469], [45, 156849], [51, 157129], [54, 157309], [57, 157469], [64, 158461], [66, 158604], [77, 159324], [80, 159484], [84, 159644], [90, 160084], [92, 160359], [103, 160732], [107, 161106], [113, 161479], [121, 162039], [124, 162579], [133, 163159], [136, 163319], [141, 163719]]}, {"verse": 24, "start": 164665, "end": 170030, "text": "Y él mirando, dijo: Veo a los hombres; parecen árboles que caminan.", "words": [[0, 164665], [2, 164852], [5, 165072], [14, 165812], [20, 166580], [24, 166957], [26, 167057], [30, 167197], [39, 168123], [47, 168567], [55, 169147], [59, 169327]]}, {"verse": 25, "start": 170310, "end": 179876, "text": "Luego le puso otra vez las manos sobre sus ojos, y le hizo que mirase; y fue restablecido, y vio a todos de lejos y con claridad.", "words": [[0, 170310], [6, 170533], [9, 170813], [14, 171273], [19, 171533], [23, 171893], [27, 172173], [33, 172653], [39, 173053], [43, 173293], [49, 173693], [51, 174393], [54, 174533], [59, 174793], [63, 175251], [71, 175870], [73, 175973], [77, 176133], [91, 177113], [93, 177493], [97, 177733], [99, 177833], [105, 178073], [108, 178293], [114, 178713], [116, 178933], [120, 179113]]}, {"verse": 26, "start": 180226, "end": 187039, "text": "Y le envió a su casa, diciendo: No entres en la aldea, ni lo digas a nadie en la aldea.", "words": [[0, 180226], [2, 180346], [5, 180446], [11, 180726], [13, 180846], [16, 180946], [22, 181286], [32, 182242], [35, 182486], [42, 183306], [45, 183686], [48, 183906], [55, 184486], [58, 184946], [61, 185146], [67, 185506], [69, 185626], [75, 185946], [78, 186186], [81, 186386]]}, {"verse": 27, "start": 187389, "end": 198977, "text": "Y salió Jesús y sus discípulos por las aldeas de Cesarea de Filipo. Y en el camino preguntó a sus discípulos, diciéndoles: ¿Quién dicen los hombres que soy yo?", "words": [[0, 187389], [2, 187514], [8, 187854], [14, 188394], [16, 188934], [20, 189154], [31, 189934], [35, 190134], [39, 190334], [46, 190774], [49, 191144], [57, 191514], [60, 191919], [68, 192490], [70, 192651], [73, 192781], [76, 192911], [83, 193411], [92, 194011], [94, 194111], [98, 194271], [110, 195491], [123, 196859], [130, 197163], [136, 197503], [140, 197723], [148, 198103], [152, 198303], [156, 198503]]}, {"verse": 28, "start": 199327, "end": 205772, "text": "Y ellos respondieron: Juan Bautista; y otros, Elías; y otros, Alguno de los profetas.", "words": [[0, 199327], [2, 199612], [8, 199812], [22, 201011], [27, 201275], [37, 202375], [39, 202536], [46, 202816], [53, 203875], [55, 203999], [62, 204359], [69, 204719], [72, 204899], [76, 204999]]}, {"verse": 29, "start": 206052, "end": 215309, "text": "Entonces él les dice: Y vosotros, ¿quién decís que soy yo? Y respondiendo Pedro, le dice: Tú eres el Cristo.", "words": [[0, 206052], [9, 207039], [12, 207282], [16, 207602], [22, 208515], [24, 208623], [34, 209443], [41, 209723], [47, 210143], [51, 210263], [55, 210503], [59, 211193], [61, 211302], [74, 212402], [81, 212742], [84, 213342], [90, 214144], [93, 214288], [98, 214528], [101, 214728]]}, {"verse": 30, "start": 215589, "end": 218220, "text": "Y les mandó que no hablasen de él a ninguno.", "words": [[0, 215589], [2, 215711], [6, 215831], [12, 216251], [16, 216391], [19, 216721], [28, 217051], [31, 217211], [34, 217431], [36, 217511]]}, {"verse": 31, "start": 218570, "end": 232709, "text": "Y comenzó a enseñarles, que convenía que el Hijo del hombre padeciese mucho, fuese rechazado por los ancianos, los principales sacerdotes y los escribas, fuera muerto y resucitara después de tres días.", "words": [[0, 218570], [2, 218695], [10, 219195], [12, 219275], [24, 220055], [28, 220515], [37, 221135], [41, 221295], [44, 221555], [49, 221815], [53, 221955], [60, 222445], [70, 222935], [77, 223835], [83, 224275], [93, 225415], [97, 225615], [101, 225815], [111, 226915], [115, 227015], [127, 227775], [138, 228475], [140, 228635], [144, 228755], [154, 229795], [160, 230057], [167, 230597], [169, 230677], [180, 231417], [188, 231717], [191, 231937], [196, 232137]]}, {"verse": 32, "start": 233059, "end": 239618, "text": "Y claramente decía esta palabra. Entonces Pedro le tomó, y le comenzó a reprender.", "words": [[0, 233059], [2, 233185], [13, 233845], [19, 234365], [24, 234705], [33, 235649], [42, 236190], [48, 236635], [51, 236915], [57, 237415], [59, 237735], [62, 237875], [70, 238535], [72, 238735]]}, {"verse": 33, "start": 239968, "end": 252935, "text": "Y él, volviéndose y mirando a sus discípulos, reprendió a Pedro, diciendo: Apártate de mí, Satanás; porque no pones la mira en las cosas de Dios, sino en las que son de los hombres.", "words": [[0, 239968], [2, 240115], [6, 240255], [18, 241135], [20, 241355], [28, 241775], [30, 241895], [34, 242115], [46, 243235], [56, 243935], [58, 244035], [65, 244375], [75, 245664], [84, 246405], [87, 246565], [91, 246725], [100, 247902], [107, 248106], [110, 248326], [116, 248706], [119, 248886], [124, 249166], [127, 249386], [131, 249546], [137, 249846], [140, 250086], [146, 250666], [151, 250986], [154, 251186], [158, 251346], [162, 251526], [166, 251806], [169, 251986], [173, 252146]]}, {"verse": 34, "start": 253285, "end": 263319, "text": "Y llamando a la gente con sus discípulos, les dijo: Si alguno quiere venir en pos de mí, niéguese a sí mismo, y tome su cruz, y sígame.", "words": [[0, 253285], [2, 253391], [11, 253911], [13, 254011], [16, 254071], [22, 254411], [26, 254671], [30, 254911], [42, 255931], [46, 256051], [52, 256841], [55, 256987], [62, 257407], [69, 257627], [75, 258007], [78, 258207], [82, 258427], [85, 258607], [89, 259347], [98, 260107], [100, 260287], [103, 260387], [110, 260827], [112, 261092], [117, 261452], [120, 261592], [126, 262512], [128, 262632]]}, {"verse": 35, "start": 263669, "end": 272631, "text": "Porque todo el que quiera salvar su vida, la perderá; y todo el que pierda su vida por causa de mí y del evangelio, la salvará.", "words": [[0, 263669], [7, 263913], [12, 264313], [15, 264553], [19, 264713], [26, 265033], [33, 265413], [36, 265693], [42, 266053], [45, 266713], [54, 267803], [56, 267925], [61, 268245], [64, 268505], [68, 268645], [75, 269125], [78, 269305], [83, 269625], [87, 269845], [93, 270165], [96, 270465], [99, 270645], [101, 270885], [105, 271025], [116, 271725], [119, 271925]]}, {"verse": 36, "start": 272981, "end": 277826, "text": "Porque ¿qué aprovechará al hombre, si gana todo el mundo, y pierde su alma?", "words": [[0, 273115], [7, 273285], [12, 273505], [24, 274325], [27, 274465], [35, 274765], [38, 275065], [43, 275365], [48, 275565], [51, 275765], [58, 276105], [60, 276545], [67, 277025], [70, 277225]]}, {"verse": 37, "start": 278176, "end": 281428, "text": "¿O qué dará el hombre a cambio de su alma?", "words": [[0, 278176], [3, 278317], [7, 278517], [12, 278957], [15, 279177], [22, 279537], [24, 279797], [31, 280217], [34, 280477], [37, 280697]]}, {"verse": 38, "start": 281778, "end": 295382, "text": "Porque el que se avergüence de mí y de mis palabras en esta generación adúltera y pecadora, el Hijo del hombre se avergonzará también de él, cuando venga en la gloria de su Padre con los santos ángeles.", "words": [[0, 281778], [7, 282040], [10, 282320], [14, 282480], [17, 282900], [28, 283320], [31, 283540], [34, 283820], [36, 284040], [39, 284180], [43, 284300], [52, 284780], [55, 285100], [60, 285360], [71, 286040], [80, 286720], [82, 286880], [92, 288100], [95, 288240], [100, 288520], [104, 288700], [111, 289120], [114, 289480], [126, 290260], [134, 290560], [137, 290880], [141, 291496], [148, 291679], [154, 292159], [157, 292279], [160, 292419], [167, 292799], [170, 292959], [173, 293119], [179, 293699], [183, 293859], [187, 294059], [194, 294559]]}]}