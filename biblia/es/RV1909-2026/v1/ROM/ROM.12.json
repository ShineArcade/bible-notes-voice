{"book": "ROM", "chapter": 12, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 143928, "verses": [{"verse": 1, "start": 300, "end": 10401, "text": "Así que, hermanos, os ruego por las misericordias de Dios, que presentéis vuestros cuerpos en sacrificio vivo, santo, agradable a Dios, que es vuestro racional culto.", "words": [[0, 300], [4, 560], [9, 800], [19, 1760], [22, 1900], [28, 2200], [32, 2400], [36, 2560], [50, 3360], [53, 3540], [59, 3840], [63, 4085], [74, 4665], [83, 5005], [91, 5505], [94, 5665], [105, 6305], [111, 7005], [118, 7505], [128, 8005], [130, 8125], [136, 8745], [140, 8825], [143, 8965], [151, 9325], [160, 9765]]}, {"verse": 2, "start": 10751, "end": 21024, "text": "Y no os conforméis a este siglo; sino transformaos por la renovación de vuestro entendimiento, para que experimentéis cuál sea la buena voluntad de Dios, agradable y perfecta.", "words": [[0, 10751], [2, 10876], [5, 11016], [8, 11156], [19, 11776], [21, 11896], [26, 12076], [33, 12850], [38, 13026], [51, 13806], [55, 13986], [58, 14106], [69, 14766], [72, 14966], [80, 15306], [95, 16206], [100, 16786], [104, 16946], [118, 17726], [123, 17926], [127, 18186], [130, 18346], [136, 18546], [145, 19086], [148, 19186], [154, 19446], [164, 20266], [166, 20346]]}, {"verse": 3, "start": 21374, "end": 34404, "text": "Digo pues por la gracia que me es dada, a cada cual que está entre vosotros, que no tenga más alto concepto de sí que el que debe tener, sino que piense de sí con sensatez, conforme a la medida de fe que Dios repartió a cada uno.", "words": [[0, 21374], [5, 21570], [10, 21830], [14, 22110], [17, 22250], [24, 22690], [28, 22770], [31, 22910], [34, 23050], [40, 23370], [42, 23830], [47, 24030], [52, 24250], [56, 24470], [61, 24630], [67, 24850], [77, 25370], [81, 25555], [84, 25715], [90, 25935], [94, 26155], [99, 26395], [108, 27015], [111, 27115], [114, 27335], [118, 27535], [121, 27655], [125, 27795], [130, 27975], [137, 28725], [142, 28919], [146, 29079], [153, 29519], [156, 29659], [159, 29859], [163, 30449], [173, 31039], [182, 31639], [184, 31719], [187, 31779], [194, 32119], [197, 32339], [200, 32579], [204, 32739], [209, 33019], [218, 33599], [220, 33739], [225, 33919]]}, {"verse": 4, "start": 34754, "end": 40340, "text": "Porque de la manera que en un cuerpo tenemos muchos miembros, pero no todos los miembros tienen la misma función;", "words": [[0, 34754], [7, 34984], [10, 35124], [13, 35244], [20, 35524], [24, 35764], [27, 35864], [30, 35984], [37, 36304], [45, 36644], [52, 37084], [62, 37764], [67, 37904], [70, 38124], [76, 38424], [80, 38644], [89, 39084], [96, 39304], [99, 39484], [105, 39664]]}, {"verse": 5, "start": 40690, "end": 45469, "text": "Así muchos somos un cuerpo en Cristo, pero todos miembros los unos de los otros.", "words": [[0, 40690], [4, 40930], [11, 41190], [17, 41570], [20, 41810], [27, 42150], [30, 42350], [38, 43210], [43, 43290], [49, 43550], [58, 44110], [62, 44290], [67, 44550], [70, 44730], [74, 44890]]}, {"verse": 6, "start": 45819, "end": 53124, "text": "De manera que, teniendo diferentes dones según la gracia que nos es dada, si el de profecía, úsese conforme a la medida de la fe;", "words": [[0, 45819], [3, 45924], [10, 46124], [15, 46404], [24, 46784], [35, 47144], [41, 47804], [47, 48024], [50, 48264], [57, 48704], [61, 48804], [65, 48944], [68, 49144], [74, 49884], [77, 49944], [80, 50044], [83, 50164], [93, 50834], [99, 51504], [108, 52064], [110, 52124], [113, 52184], [120, 52484], [123, 52644], [126, 52764]]}, {"verse": 7, "start": 53474, "end": 57246, "text": "O si ministerio, en servir; o el que enseña, en doctrina;", "words": [[0, 53474], [2, 53592], [5, 53752], [17, 54472], [20, 54632], [28, 55412], [30, 55558], [33, 55698], [37, 55818], [45, 56378], [48, 56598]]}, {"verse": 8, "start": 57596, "end": 66424, "text": "El que exhorta, en exhortar; el que reparte, hágalo con generosidad; el que dirige, con dedicación; el que hace misericordia, con alegría.", "words": [[0, 57638], [3, 57718], [7, 57838], [16, 58378], [19, 58658], [29, 59594], [32, 59730], [36, 59850], [45, 60610], [52, 61010], [56, 61150], [69, 62190], [72, 62290], [76, 62410], [84, 62910], [88, 63170], [100, 64300], [103, 64380], [107, 64500], [112, 64720], [126, 65540], [130, 65760]]}, {"verse": 9, "start": 66774, "end": 71306, "text": "El amor sea sin fingimiento: aborreciendo lo malo, llegándoos a lo bueno;", "words": [[0, 66774], [3, 66877], [8, 67097], [12, 67397], [16, 67657], [29, 69026], [42, 69300], [45, 69573], [51, 70093], [62, 70613], [64, 70753], [67, 70833]]}, {"verse": 10, "start": 71656, "end": 77676, "text": "Amándoos los unos a los otros con amor fraternal; dándoos preferencia en honra los unos a los otros;", "words": [[0, 71656], [9, 72300], [13, 72440], [18, 72700], [20, 72920], [24, 73040], [30, 73320], [34, 73580], [39, 73800], [50, 74819], [58, 75303], [70, 76023], [73, 76163], [79, 76423], [83, 76623], [88, 76823], [90, 77023], [94, 77123]]}, {"verse": 11, "start": 78026, "end": 82722, "text": "En el cuidado no perezosos; ardientes en espíritu; sirviendo al Señor;", "words": [[0, 78026], [3, 78152], [6, 78232], [14, 78572], [17, 78792], [28, 79807], [38, 80406], [41, 80606], [51, 81469], [61, 82009], [64, 82169]]}, {"verse": 12, "start": 83072, "end": 88359, "text": "Gozosos en la esperanza; sufridos en la tribulación; constantes en la oración;", "words": [[0, 83072], [8, 83672], [11, 83792], [14, 83892], [25, 84866], [34, 85427], [37, 85567], [40, 85667], [53, 86781], [64, 87464], [67, 87584], [70, 87704]]}, {"verse": 13, "start": 88709, "end": 93157, "text": "Contribuyendo a las necesidades de los santos; siguiendo la hospitalidad.", "words": [[0, 89148], [14, 89468], [16, 89568], [20, 89668], [32, 90288], [35, 90468], [39, 90588], [47, 91508], [57, 92128], [60, 92288]]}, {"verse": 14, "start": 93507, "end": 97926, "text": "Bendecid a los que os persiguen: bendecid, y no maldigáis.", "words": [[0, 93959], [9, 94429], [11, 94609], [15, 94729], [19, 94849], [22, 94969], [33, 96619], [43, 96959], [45, 97299], [48, 97639]]}, {"verse": 15, "start": 98276, "end": 101409, "text": "Gozaos con los que se gozan: llorad con los que lloran.", "words": [[0, 98276], [7, 98836], [11, 99016], [15, 99116], [19, 99256], [22, 99376], [29, 100127], [36, 100490], [40, 100630], [44, 100770], [48, 100910]]}, {"verse": 16, "start": 101759, "end": 108405, "text": "Unánimes entre vosotros: no altivos, sino relacionándoos con los humildes. No seáis sabios en vuestra opinión.", "words": [[0, 101958], [9, 102198], [15, 102438], [25, 103428], [28, 103568], [37, 104008], [42, 104618], [57, 105228], [61, 105468], [65, 105628], [75, 106495], [78, 106683], [84, 107043], [91, 107423], [94, 107583], [102, 107863]]}, {"verse": 17, "start": 108755, "end": 113400, "text": "No paguéis a nadie mal por mal; procurad lo bueno delante de todos los hombres.", "words": [[0, 108755], [3, 108901], [11, 109301], [13, 109421], [19, 109681], [23, 109941], [27, 110121], [32, 110777], [41, 111243], [44, 111363], [50, 111663], [58, 112143], [61, 112303], [67, 112503], [71, 112723]]}, {"verse": 18, "start": 113750, "end": 118721, "text": "Si se puede hacer, en cuanto dependa de vosotros, tened paz con todos los hombres.", "words": [[0, 113750], [3, 113870], [6, 114030], [12, 114290], [19, 114670], [22, 115030], [29, 115230], [37, 115830], [40, 115910], [50, 116730], [56, 117130], [60, 117350], [64, 117630], [70, 117850], [74, 118070]]}, {"verse": 19, "start": 119071, "end": 130213, "text": "No os venguéis vosotros mismos, amados míos; más bien, dejad lugar a la ira de Dios; porque escrito está: Mía es la venganza: yo pagaré, dice el Señor.", "words": [[0, 119071], [3, 119255], [6, 119555], [15, 119855], [24, 120315], [32, 120975], [39, 121355], [45, 122155], [49, 122339], [55, 122819], [61, 123099], [67, 123319], [69, 123499], [72, 123599], [76, 123879], [79, 123999], [85, 124677], [92, 124884], [100, 125324], [106, 126084], [110, 126346], [113, 126626], [116, 126726], [126, 127904], [129, 128069], [137, 129127], [142, 129526], [145, 129666]]}, {"verse": 20, "start": 130563, "end": 139368, "text": "Así que, si tu enemigo tiene hambre, dale de comer; si tiene sed, dale de beber: que haciendo esto, brasas de fuego amontonas sobre su cabeza.", "words": [[0, 130563], [4, 130772], [9, 130952], [12, 131092], [15, 131252], [23, 131652], [29, 131932], [37, 132352], [42, 132652], [45, 132812], [52, 133549], [55, 133673], [61, 133913], [66, 134473], [71, 134713], [74, 134873], [81, 135552], [85, 135653], [94, 136013], [100, 136603], [107, 137193], [110, 137353], [116, 137673], [126, 138373], [132, 138573], [135, 138773]]}, {"verse": 21, "start": 139718, "end": 143528, "text": "No seas vencido de lo malo; pero vence con el bien el mal.", "words": [[0, 139718], [3, 139884], [8, 140144], [16, 140744], [19, 140884], [22, 141004], [28, 141668], [33, 141824], [39, 142204], [43, 142384], [46, 142504], [51, 143064], [54, 143144]]}]}