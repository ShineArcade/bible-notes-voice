{"book": "MAT", "chapter": 10, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 278802, "verses": [{"verse": 1, "start": 300, "end": 11576, "text": "And when he had called to him his twelve disciples, he gave them power against unclean spirits, to cast them out, and to heal all manner of sickness and all manner of disease.", "words": [[0, 300], [4, 435], [9, 595], [12, 775], [16, 875], [23, 1155], [26, 1435], [30, 1575], [34, 1795], [41, 2115], [52, 3315], [55, 3455], [60, 3655], [65, 3875], [71, 4235], [79, 4635], [87, 5375], [96, 5855], [99, 6335], [104, 6655], [109, 6895], [114, 7546], [118, 7846], [121, 8006], [126, 8246], [130, 8586], [137, 8926], [140, 9166], [149, 9566], [153, 10106], [157, 10286], [164, 10606], [167, 10826]]}, {"verse": 2, "start": 11926, "end": 21801, "text": "Now the names of the twelve apostles are these; The first, Simon, who is called Peter, and Andrew his brother; James the son of Zebedee, and John his brother;", "words": [[0, 11926], [4, 12046], [8, 12226], [14, 12506], [17, 12706], [21, 12806], [28, 13086], [37, 13606], [41, 13906], [48, 14717], [52, 14817], [59, 15417], [66, 16097], [70, 16207], [73, 16317], [80, 16577], [87, 17357], [91, 17537], [98, 17917], [102, 18117], [111, 18883], [117, 19443], [121, 19503], [125, 19803], [128, 19903], [137, 20683], [141, 20763], [146, 21163], [150, 21243]]}, {"verse": 3, "start": 22151, "end": 30329, "text": "Philip, and Bartholomew; Thomas, and Matthew the tax collector; James the son of Alphaeus, and Lebbaeus, whose surname was Thaddaeus;", "words": [[0, 22151], [8, 22454], [12, 22834], [25, 23764], [33, 24021], [37, 24261], [45, 24741], [49, 24821], [53, 25081], [64, 26023], [70, 26321], [74, 26501], [78, 26721], [81, 27021], [91, 27321], [95, 27891], [105, 28461], [111, 28561], [119, 28981], [123, 29655]]}, {"verse": 4, "start": 30679, "end": 34799, "text": "Simon the Canaanite, and Judas Iscariot, who also betrayed him.", "words": [[0, 30679], [6, 31039], [10, 31239], [21, 32299], [25, 32479], [31, 32779], [41, 33679], [45, 33799], [50, 34139], [59, 34499]]}, {"verse": 5, "start": 35149, "end": 43250, "text": "These twelve Jesus sent forth, and commanded them, saying, Go not into the way of the Gentiles, and into any city of the Samaritans enter you not:", "words": [[0, 35149], [6, 35278], [13, 35558], [19, 35878], [24, 36238], [31, 36538], [35, 36738], [45, 37098], [51, 37418], [59, 38070], [62, 38237], [66, 38477], [71, 38737], [75, 38877], [79, 39077], [82, 39197], [86, 39297], [96, 40217], [100, 40437], [105, 40697], [109, 40977], [114, 41337], [117, 41497], [121, 41617], [132, 42257], [138, 42497], [142, 42737]]}, {"verse": 6, "start": 43600, "end": 46282, "text": "But go rather to the lost sheep of the house of Israel.", "words": [[0, 43600], [4, 43738], [7, 43939], [14, 44158], [17, 44359], [21, 44479], [26, 44759], [32, 45099], [35, 45338], [39, 45439], [45, 45658], [48, 45819]]}, {"verse": 7, "start": 46632, "end": 50476, "text": "And as you go, preach, saying, The kingdom of heaven is at hand.", "words": [[0, 46632], [4, 46750], [7, 46970], [11, 47090], [15, 47470], [23, 47970], [31, 48650], [35, 48750], [43, 49030], [46, 49270], [53, 49550], [56, 49830], [59, 49970]]}, {"verse": 8, "start": 50826, "end": 57609, "text": "Heal the sick, cleanse the lepers, raise the dead, cast out demons: freely you have received, freely give.", "words": [[0, 50826], [5, 51100], [9, 51220], [15, 51600], [23, 51760], [27, 52040], [35, 52680], [41, 52960], [45, 53180], [51, 53800], [56, 54020], [60, 54260], [68, 55160], [75, 55489], [79, 55749], [84, 55909], [94, 56709], [101, 57029]]}, {"verse": 9, "start": 57959, "end": 61621, "text": "Provide neither gold, nor silver, nor brass in your purses,", "words": [[0, 57959], [8, 58372], [16, 58532], [22, 58952], [26, 59192], [34, 59632], [38, 60152], [44, 60572], [47, 60852], [52, 60952]]}, {"verse": 10, "start": 61971, "end": 68656, "text": "Nor bag for your journey, neither two coats, neither shoes, nor yet staves: for the workman is worthy of his food.", "words": [[0, 61971], [4, 62132], [8, 62392], [12, 62632], [17, 62752], [26, 63512], [34, 63672], [38, 63952], [45, 64632], [53, 64772], [60, 65552], [64, 65712], [68, 65912], [76, 66868], [80, 66950], [84, 67070], [92, 67470], [95, 67610], [102, 67870], [105, 68070], [109, 68190]]}, {"verse": 11, "start": 69006, "end": 76075, "text": "And into whatever city or town you shall enter, enquire who in it is worthy; and there abide till you go from there.", "words": [[0, 69006], [4, 69150], [9, 69370], [18, 69690], [23, 70070], [26, 70270], [31, 70590], [35, 70810], [41, 71050], [48, 71760], [56, 72470], [60, 72690], [63, 72850], [66, 72970], [69, 73110], [77, 73893], [81, 74038], [87, 74258], [93, 74638], [98, 74978], [102, 75138], [105, 75358], [110, 75558]]}, {"verse": 12, "start": 76425, "end": 78769, "text": "And when you come into a house, salute it.", "words": [[0, 76425], [4, 76570], [9, 76710], [13, 76870], [18, 77110], [23, 77310], [25, 77470], [32, 78090], [39, 78370]]}, {"verse": 13, "start": 79119, "end": 85146, "text": "And if the house be worthy, let your peace come upon it: but if it be not worthy, let your peace return to you.", "words": [[0, 79119], [4, 79261], [7, 79361], [11, 79521], [17, 79741], [20, 79941], [28, 80681], [32, 80821], [37, 80981], [43, 81261], [48, 81521], [53, 81801], [57, 82328], [61, 82425], [64, 82565], [67, 82685], [70, 82765], [74, 82945], [82, 83625], [86, 83765], [91, 83925], [97, 84225], [104, 84605], [107, 84845]]}, {"verse": 14, "start": 85496, "end": 92982, "text": "And whoever shall not receive you, nor hear your words, when you depart out of that house or city, shake off the dust of your feet.", "words": [[0, 85496], [4, 85620], [12, 85880], [18, 86240], [22, 86460], [30, 86840], [35, 87440], [39, 87640], [44, 87940], [49, 88160], [56, 88940], [61, 89100], [65, 89220], [72, 89560], [76, 89860], [79, 89980], [84, 90140], [90, 90440], [93, 90680], [99, 91320], [105, 91580], [109, 91840], [113, 92020], [118, 92280], [121, 92440], [126, 92560]]}, {"verse": 15, "start": 93332, "end": 100199, "text": "Assuredly I say to you, It shall be more tolerable for the land of Sodom and Gomorrha in the day of judgment, than for that city.", "words": [[0, 93332], [10, 93893], [12, 94053], [16, 94193], [19, 94393], [24, 94993], [27, 95133], [33, 95293], [36, 95473], [41, 95693], [51, 96293], [55, 96493], [59, 96613], [64, 96893], [67, 97053], [73, 97473], [77, 97753], [86, 98033], [89, 98173], [93, 98273], [97, 98493], [100, 98593], [110, 98973], [115, 99278], [119, 99498], [124, 99698]]}, {"verse": 16, "start": 100549, "end": 106639, "text": "¶ Behold, I send you forth as sheep in the midst of wolves: be therefore wise as serpents, and harmless as doves.", "words": [[2, 100549], [10, 100991], [12, 101071], [17, 101331], [21, 101451], [27, 101711], [30, 101931], [36, 102211], [39, 102411], [43, 102491], [49, 102691], [52, 102911], [60, 103671], [63, 103768], [73, 104108], [78, 104488], [81, 104708], [91, 105228], [95, 105488], [104, 105828], [107, 106068]]}, {"verse": 17, "start": 106989, "end": 112522, "text": "But beware of men: for they will deliver you up to the councils, and they will scourge you in their synagogues;", "words": [[0, 107006], [4, 107066], [11, 107426], [14, 107606], [19, 108281], [23, 108388], [28, 108528], [33, 108668], [41, 109008], [45, 109208], [48, 109448], [51, 109608], [55, 109728], [65, 110108], [69, 110483], [74, 110603], [79, 110723], [87, 111243], [91, 111363], [94, 111503], [100, 111643]]}, {"verse": 18, "start": 112872, "end": 118725, "text": "And you shall be brought before governors and kings for my sake, for a testimony against them and the Gentiles.", "words": [[0, 112872], [4, 113011], [8, 113211], [14, 113411], [17, 113571], [25, 113831], [32, 114151], [42, 114611], [46, 114871], [52, 115131], [56, 115371], [59, 115551], [65, 116211], [69, 116391], [71, 116531], [81, 116871], [89, 117331], [94, 117631], [98, 117851], [102, 117971]]}, {"verse": 19, "start": 119075, "end": 126628, "text": "But when they deliver you up, take no thought how or what you shall speak: for it shall be given you in that same hour what you shall speak.", "words": [[0, 119075], [4, 119197], [9, 119357], [14, 119537], [22, 119877], [26, 120077], [30, 120697], [35, 120897], [38, 121137], [46, 121417], [50, 121777], [53, 122077], [58, 122337], [62, 122497], [68, 122697], [75, 123470], [79, 123601], [82, 123721], [88, 123881], [91, 124041], [97, 124261], [101, 124481], [104, 124681], [109, 124861], [114, 125141], [119, 125481], [124, 125741], [128, 125901], [134, 126101]]}, {"verse": 20, "start": 126978, "end": 131136, "text": "For it is not you that speak, but the Spirit of your Father which speaks in you.", "words": [[0, 126978], [4, 127151], [7, 127251], [10, 127351], [14, 127551], [18, 127871], [23, 128051], [30, 128811], [34, 128971], [38, 129111], [45, 129431], [48, 129591], [53, 129691], [60, 130031], [66, 130291], [73, 130531], [76, 130771]]}, {"verse": 21, "start": 131486, "end": 139357, "text": "And the brother shall deliver up the brother to death, and the father the child: and the children shall rise up against their parents, and cause them to be put to death.", "words": [[0, 131486], [4, 131603], [8, 131703], [16, 131903], [22, 132163], [30, 132483], [33, 132683], [37, 132823], [45, 133043], [48, 133243], [55, 133723], [59, 133943], [63, 134043], [70, 134303], [74, 134483], [81, 135276], [85, 135402], [89, 135502], [98, 135902], [104, 136182], [109, 136522], [112, 136742], [120, 137002], [126, 137222], [135, 137662], [139, 137897], [145, 138177], [150, 138397], [153, 138537], [156, 138657], [160, 138817], [163, 138977]]}, {"verse": 22, "start": 139707, "end": 145516, "text": "And you shall be hated of all men for my name’s sake: but he that endures to the end shall be saved.", "words": [[0, 139707], [4, 139826], [8, 139946], [14, 140126], [17, 140286], [23, 140586], [26, 140806], [30, 140966], [34, 141366], [38, 141426], [41, 141586], [48, 141966], [54, 142556], [58, 142699], [61, 143039], [66, 143339], [74, 143899], [77, 144039], [81, 144159], [85, 144439], [91, 144699], [94, 144859]]}, {"verse": 23, "start": 145866, "end": 155629, "text": "But when they persecute you in this city, flee into another: for indeed I say to you, You shall not have gone over the cities of Israel, till the Son of man be come.", "words": [[0, 145866], [4, 145964], [9, 146104], [14, 146244], [24, 146904], [28, 147044], [31, 147204], [36, 147364], [42, 147944], [47, 148284], [52, 148684], [61, 149475], [65, 149643], [72, 150003], [74, 150283], [78, 150563], [81, 150783], [86, 151263], [90, 151463], [96, 151663], [100, 151923], [105, 152163], [110, 152443], [115, 152683], [119, 152863], [126, 153123], [129, 153343], [137, 153743], [142, 154143], [146, 154283], [150, 154503], [153, 154623], [157, 154963], [160, 155303]]}, {"verse": 24, "start": 155979, "end": 159850, "text": "The disciple is not above his master, nor the servant above his lord.", "words": [[0, 155979], [4, 156065], [13, 156445], [16, 156685], [20, 156825], [26, 157105], [30, 157325], [38, 158045], [42, 158305], [46, 158505], [54, 158825], [60, 159085], [64, 159365]]}, {"verse": 25, "start": 160200, "end": 170205, "text": "It is enough for the disciple that he be as his master, and the servant as his lord. If they have called the master of the house Beelzebub, how much more shall they call them of his household?", "words": [[0, 160200], [3, 160335], [6, 160455], [13, 160715], [17, 160935], [21, 161035], [30, 161475], [35, 161715], [38, 161915], [41, 162115], [44, 162435], [48, 162595], [56, 163035], [60, 163455], [64, 163595], [72, 163895], [75, 164195], [79, 164375], [85, 165066], [88, 165204], [93, 165344], [98, 165504], [105, 165744], [109, 165924], [116, 166264], [119, 166424], [123, 166544], [129, 166784], [140, 167884], [144, 168084], [149, 168324], [154, 168544], [160, 168764], [165, 168904], [170, 169144], [175, 169324], [178, 169444], [182, 169564]]}, {"verse": 26, "start": 170555, "end": 177130, "text": "Fear them not therefore: for there is nothing covered, that shall not be revealed; and hid, that shall not be known.", "words": [[0, 170555], [5, 170722], [10, 170922], [14, 171142], [25, 172018], [29, 172318], [35, 172478], [38, 172598], [46, 172818], [55, 173238], [60, 173738], [66, 173918], [70, 174118], [73, 174278], [83, 175073], [87, 175220], [92, 175500], [97, 175800], [103, 176180], [107, 176440], [110, 176620]]}, {"verse": 27, "start": 177480, "end": 184483, "text": "What I tell you in darkness, that speak you in light: and what you hear in the ear, that preach you upon the housetops.", "words": [[0, 177480], [5, 177586], [7, 177726], [12, 177946], [16, 178166], [19, 178326], [29, 179166], [34, 179406], [40, 179726], [44, 179946], [47, 180106], [54, 180830], [58, 180935], [63, 181115], [67, 181295], [72, 181595], [75, 181795], [79, 181915], [84, 182235], [89, 182705], [96, 183175], [100, 183315], [105, 183515], [109, 183715]]}, {"verse": 28, "start": 184833, "end": 192868, "text": "And fear not them which kill the body, but are not able to kill the soul: but rather fear him which is able to destroy both soul and body in hell.", "words": [[0, 184833], [4, 184971], [9, 185211], [13, 185411], [18, 185711], [24, 185931], [29, 186211], [33, 186351], [39, 186951], [43, 187231], [47, 187331], [51, 187511], [56, 187811], [59, 187991], [64, 188191], [68, 188351], [74, 188999], [78, 189098], [85, 189358], [90, 189678], [94, 189938], [100, 190158], [103, 190298], [108, 190518], [111, 190658], [119, 190998], [124, 191238], [129, 191618], [133, 191898], [138, 192238], [141, 192478]]}, {"verse": 29, "start": 193218, "end": 198636, "text": "Are not two sparrows sold for a farthing? and one of them shall not fall on the ground without your Father.", "words": [[0, 193218], [4, 193323], [8, 193483], [12, 193743], [21, 194343], [26, 194643], [30, 194863], [32, 194963], [42, 195803], [46, 195922], [50, 196122], [53, 196242], [58, 196382], [64, 196582], [68, 196762], [73, 197042], [76, 197202], [80, 197302], [87, 197562], [95, 197842], [100, 198022]]}, {"verse": 30, "start": 198986, "end": 201228, "text": "But the very hairs of your head are all numbered.", "words": [[0, 198986], [4, 199246], [8, 199386], [13, 199586], [19, 199846], [22, 200046], [27, 200166], [32, 200366], [36, 200486], [40, 200646]]}, {"verse": 31, "start": 201578, "end": 205242, "text": "Do not fear therefore, you are of more value than many sparrows.", "words": [[0, 201578], [3, 201678], [7, 201898], [12, 202398], [23, 203018], [27, 203198], [31, 203338], [34, 203458], [39, 203638], [45, 204078], [50, 204298], [55, 204558]]}, {"verse": 32, "start": 205592, "end": 211193, "text": "Whoever therefore shall confess me before men, him will I confess also before my Father which is in heaven.", "words": [[0, 205592], [8, 205829], [18, 206329], [24, 206629], [32, 207009], [35, 207249], [42, 207529], [47, 208169], [51, 208349], [56, 208549], [58, 208669], [66, 209029], [71, 209429], [78, 209729], [81, 209969], [88, 210429], [94, 210549], [97, 210669], [100, 210789]]}, {"verse": 33, "start": 211543, "end": 217310, "text": "But whoever shall deny me before men, him will I also deny before my Father which is in heaven.", "words": [[0, 211543], [4, 211633], [12, 211953], [18, 212293], [23, 212673], [26, 212873], [33, 213213], [38, 213933], [42, 214233], [47, 214433], [49, 214593], [54, 214913], [59, 215313], [66, 215653], [69, 215913], [76, 216433], [82, 216533], [85, 216693], [88, 216833]]}, {"verse": 34, "start": 217660, "end": 223068, "text": "Think not that I am come to send peace on earth: I came not to send peace, but a sword.", "words": [[0, 217660], [6, 217844], [10, 218084], [15, 218304], [17, 218464], [20, 218564], [25, 218744], [28, 218944], [33, 219184], [39, 219484], [42, 219784], [49, 220300], [51, 220460], [56, 220720], [60, 220980], [63, 221220], [68, 221460], [75, 222280], [79, 222380], [81, 222480]]}, {"verse": 35, "start": 223418, "end": 231212, "text": "For I am come to set a man at variance against his father, and the daughter against her mother, and the daughter in law against her mother in law.", "words": [[0, 223418], [4, 223587], [6, 223927], [9, 224067], [14, 224327], [17, 224567], [21, 224807], [23, 224927], [27, 225167], [30, 225427], [39, 225827], [47, 226147], [51, 226407], [59, 227007], [63, 227427], [67, 227547], [76, 227807], [84, 228127], [88, 228347], [96, 228907], [100, 229107], [104, 229247], [113, 229507], [116, 229687], [120, 229927], [128, 230327], [132, 230527], [139, 230727], [142, 230907]]}, {"verse": 36, "start": 231562, "end": 234408, "text": "And a man’s foes shall be they of his own household.", "words": [[0, 231562], [4, 231687], [6, 231787], [12, 232167], [17, 232607], [23, 232787], [26, 233027], [31, 233227], [34, 233387], [38, 233527], [42, 233667]]}, {"verse": 37, "start": 234758, "end": 241898, "text": "He that loves father or mother more than me is not worthy of me: and he that loves son or daughter more than me is not worthy of me.", "words": [[0, 234758], [3, 234877], [8, 235057], [14, 235337], [21, 235797], [24, 235997], [31, 236277], [36, 236517], [41, 236717], [44, 236957], [47, 237157], [51, 237337], [58, 237657], [61, 237837], [65, 238321], [69, 238461], [72, 238681], [77, 238941], [83, 239201], [87, 239621], [90, 239801], [99, 240121], [104, 240381], [109, 240601], [112, 240801], [115, 240941], [119, 241121], [126, 241401], [129, 241621]]}, {"verse": 38, "start": 242248, "end": 245947, "text": "And he that takes not his cross, and follows after me, is not worthy of me.", "words": [[0, 242248], [4, 242387], [7, 242547], [12, 242747], [18, 243007], [22, 243227], [26, 243407], [33, 243727], [37, 243987], [45, 244287], [51, 244647], [55, 244867], [58, 245187], [62, 245367], [69, 245667], [72, 245887]]}, {"verse": 39, "start": 246297, "end": 251483, "text": "He that finds his life shall lose it: and he that loses his life for my sake shall find it.", "words": [[0, 246297], [3, 246485], [8, 246705], [14, 247025], [18, 247285], [23, 247585], [29, 247805], [34, 248085], [38, 248611], [42, 248734], [45, 248934], [50, 249174], [56, 249454], [60, 249674], [65, 249954], [69, 250174], [72, 250394], [77, 250694], [83, 250874], [88, 251194]]}, {"verse": 40, "start": 251833, "end": 257159, "text": "¶ He that receives you receives me, and he that receives me receives him that sent me.", "words": [[2, 251833], [5, 252043], [10, 252263], [19, 252683], [23, 252943], [32, 253283], [36, 254263], [40, 254303], [43, 254543], [48, 254723], [57, 255203], [60, 255423], [69, 255803], [73, 256263], [78, 256523], [83, 256783]]}, {"verse": 41, "start": 257509, "end": 268370, "text": "He that receives a prophet in the name of a prophet shall receive a prophet’s reward; and he that receives a righteous man in the name of a righteous man shall receive a righteous man’s reward.", "words": [[0, 257509], [3, 257679], [8, 257919], [17, 258259], [19, 258499], [27, 258839], [30, 259139], [34, 259239], [39, 259499], [42, 259719], [44, 259819], [52, 260199], [58, 260639], [66, 261019], [68, 261179], [78, 261679], [86, 262489], [90, 262630], [93, 262870], [98, 263090], [107, 263510], [109, 263750], [119, 264050], [123, 264430], [126, 264630], [130, 264730], [135, 264970], [138, 265130], [140, 265210], [150, 265490], [154, 265950], [160, 266490], [168, 266830], [170, 266970], [180, 267270], [186, 267750]]}, {"verse": 42, "start": 268720, "end": 278402, "text": "And whoever shall give to drink to one of these little ones a cup of cold water only in the name of a disciple, indeed I say to you, he shall by no means lose his reward.", "words": [[0, 268720], [4, 268845], [12, 269065], [18, 269385], [23, 269645], [26, 269865], [32, 270145], [35, 270345], [39, 270485], [42, 270585], [48, 270725], [55, 271025], [60, 271305], [62, 271565], [66, 271765], [69, 271905], [74, 272165], [80, 272565], [85, 272905], [88, 273045], [92, 273145], [97, 273365], [100, 273505], [102, 273605], [112, 274685], [119, 275125], [121, 275185], [125, 275405], [128, 275605], [133, 276159], [136, 276252], [142, 276472], [145, 276652], [148, 276832], [154, 277192], [159, 277552], [163, 277772]]}]}