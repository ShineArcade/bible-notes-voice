{"book": "ACT", "chapter": 22, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 245144, "verses": [{"verse": 1, "start": 300, "end": 4386, "text": "Varones hermanos y padres, oíd la defensa que ahora os presento.", "words": [[0, 493], [8, 723], [17, 1303], [19, 1383], [27, 2043], [31, 2463], [34, 2603], [42, 3103], [46, 3263], [52, 3483], [55, 3663]]}, {"verse": 2, "start": 4666, "end": 10740, "text": "(Y cuando oyeron que les hablaba en lengua hebrea, guardaron más silencio.) Y dijo:", "words": [[0, 4666], [3, 4769], [10, 5029], [17, 5569], [21, 5689], [25, 5849], [33, 6449], [36, 6589], [43, 7029], [51, 7929], [61, 8649], [65, 8889], [76, 10149], [78, 10229]]}, {"verse": 3, "start": 10940, "end": 24831, "text": "Yo de cierto soy judío, nacido en Tarso de Cilicia, pero criado en esta ciudad a los pies de Gamaliel, enseñado conforme a la verdad de la ley de la patria, celoso de Dios, como todos vosotros sois hoy.", "words": [[0, 10940], [3, 11203], [6, 11263], [13, 11883], [17, 12043], [24, 12943], [31, 13463], [34, 13643], [40, 13983], [43, 14513], [52, 15043], [57, 15263], [64, 15683], [67, 15823], [72, 16043], [79, 16383], [81, 16623], [85, 16743], [90, 16963], [93, 17123], [103, 17982], [112, 18646], [121, 19246], [123, 19326], [126, 19386], [133, 19766], [136, 20026], [139, 20146], [143, 20346], [146, 20466], [149, 20606], [157, 21606], [164, 21986], [167, 22206], [173, 23006], [178, 23166], [184, 23486], [193, 24086], [198, 24486]]}, {"verse": 4, "start": 25181, "end": 30623, "text": "Que he perseguido este camino hasta la muerte, prendiendo y entregando en cárceles hombres y mujeres:", "words": [[0, 25181], [4, 25281], [7, 25361], [18, 26001], [23, 26201], [30, 26621], [36, 26861], [39, 27021], [47, 27681], [58, 28261], [60, 28381], [71, 28881], [74, 28981], [83, 29521], [91, 29801], [93, 30021]]}, {"verse": 5, "start": 30973, "end": 44222, "text": "Como también el sumo sacerdote me es testigo, y todos los ancianos; de los cuales también tomando cartas a los hermanos, iba a Damasco para traer presos a Jerusalén aun a los que estuviesen allí, para que fuesen castigados.", "words": [[0, 30973], [5, 31137], [13, 31537], [16, 31717], [21, 32037], [31, 32290], [34, 32544], [37, 32797], [46, 33417], [48, 33657], [54, 33837], [58, 34057], [68, 34979], [71, 35097], [75, 35217], [82, 35477], [90, 35877], [98, 36457], [105, 36937], [107, 37037], [111, 37117], [121, 38017], [125, 38317], [127, 38537], [135, 38917], [140, 39137], [146, 39497], [153, 39957], [155, 40057], [165, 40837], [169, 41057], [171, 41217], [175, 41357], [179, 41517], [190, 42017], [196, 42717], [201, 42857], [205, 42997], [212, 43337]]}, {"verse": 6, "start": 44572, "end": 51851, "text": "Pero aconteció que yendo yo, y llegando cerca de Damasco, como a medio día, de repente me rodeó mucha luz del cielo:", "words": [[0, 44572], [5, 44731], [15, 45371], [19, 45531], [25, 45871], [29, 46691], [31, 46731], [40, 47131], [46, 47431], [49, 47671], [58, 48251], [63, 48491], [65, 48631], [71, 48831], [76, 49551], [79, 49631], [87, 50011], [90, 50291], [96, 50691], [102, 50931], [106, 51151], [110, 51351]]}, {"verse": 7, "start": 52201, "end": 58194, "text": "Y caí en el suelo, y oí una voz que me decía: Saulo, Saulo, ¿por qué me persigues?", "words": [[0, 52201], [2, 52303], [6, 52603], [9, 52723], [12, 52823], [19, 53203], [21, 53543], [24, 53743], [28, 53903], [32, 54143], [36, 54303], [39, 54423], [46, 55474], [53, 55814], [60, 56774], [65, 56874], [69, 57034], [72, 57174]]}, {"verse": 8, "start": 58414, "end": 66192, "text": "Yo entonces respondí: ¿Quién eres, Señor? Y me dijo: Yo soy Jesús de Nazaret, a quien tú persigues.", "words": [[0, 58414], [3, 58631], [12, 58971], [22, 60011], [29, 60270], [35, 60590], [42, 61260], [44, 61365], [47, 61465], [53, 62193], [56, 62398], [60, 62698], [66, 63138], [69, 63438], [78, 64438], [80, 64698], [86, 64878], [89, 65178]]}, {"verse": 9, "start": 66412, "end": 73126, "text": "Y los que estaban conmigo vieron a la verdad la luz, y se espantaron; pero no oyeron la voz del que hablaba conmigo.", "words": [[0, 66412], [2, 66516], [6, 66636], [10, 66796], [18, 67096], [26, 67696], [33, 68016], [35, 68176], [38, 68256], [45, 68536], [48, 68776], [53, 69096], [55, 69536], [58, 69636], [70, 70621], [75, 70760], [78, 70980], [85, 71400], [88, 71520], [92, 71740], [96, 71940], [100, 72120], [108, 72500]]}, {"verse": 10, "start": 73476, "end": 82979, "text": "Y dije: ¿Qué haré, Señor? Y el Señor me dijo: Levántate, y ve a Damasco, y allí te será dicho todo lo que te está señalado hacer.", "words": [[0, 73476], [2, 73619], [8, 74291], [13, 74411], [19, 74671], [26, 75390], [28, 75490], [31, 75590], [37, 75830], [40, 76050], [46, 76783], [57, 77502], [59, 77762], [62, 77922], [64, 78042], [73, 78722], [75, 79112], [80, 79502], [83, 79742], [88, 80062], [94, 80362], [99, 80862], [102, 81162], [106, 81302], [109, 81462], [114, 81742], [123, 82602]]}, {"verse": 11, "start": 83199, "end": 89609, "text": "Y como yo no viese por causa de la claridad de la luz, llevado de la mano por los que estaban conmigo, vine a Damasco.", "words": [[0, 83199], [2, 83287], [7, 83467], [10, 83647], [13, 83787], [19, 84087], [23, 84287], [29, 84547], [32, 84767], [35, 84867], [44, 85287], [47, 85407], [50, 85527], [55, 86127], [63, 86567], [66, 86687], [69, 86787], [74, 87027], [78, 87227], [82, 87367], [86, 87487], [94, 87727], [103, 88687], [108, 88867], [110, 89027]]}, {"verse": 12, "start": 89959, "end": 96051, "text": "Entonces un Ananías, hombre piadoso conforme a la ley, que tenía buen testimonio de todos los judíos que allí moraban,", "words": [[0, 89959], [9, 90301], [12, 90741], [21, 91201], [28, 91541], [36, 92101], [45, 92581], [47, 92641], [50, 92701], [55, 93061], [59, 93201], [65, 93461], [70, 93661], [81, 94301], [84, 94421], [90, 94601], [94, 94841], [101, 95241], [105, 95361], [110, 95501]]}, {"verse": 13, "start": 96051, "end": 101836, "text": "Viniendo a mí, y acercándose, me dijo: Hermano Saulo, recibe la vista. Y yo en aquella hora le miré.", "words": [[0, 96226], [9, 96401], [11, 96501], [15, 96621], [17, 96921], [30, 97601], [33, 97681], [39, 98299], [47, 98619], [54, 99139], [61, 99559], [64, 99659], [71, 100327], [73, 100448], [76, 100608], [79, 100728], [87, 101028], [92, 101248], [95, 101408]]}, {"verse": 14, "start": 102186, "end": 110632, "text": "Y él dijo: El Dios de nuestros padres te ha predestinado para que conocieses su voluntad, y vieses a aquel Justo, y oyeses la voz de su boca.", "words": [[0, 102186], [2, 102310], [5, 102430], [11, 103100], [14, 103220], [19, 103420], [22, 103580], [31, 103740], [38, 104260], [41, 104540], [44, 104660], [57, 105320], [62, 105540], [66, 105680], [77, 106320], [80, 106440], [90, 107260], [92, 107480], [99, 107840], [101, 107980], [107, 108220], [114, 108980], [116, 109080], [123, 109520], [126, 109660], [130, 109880], [133, 110020], [136, 110160]]}, {"verse": 15, "start": 110982, "end": 115060, "text": "Porque has de ser testigo suyo a todos los hombres, de lo que has visto y oído.", "words": [[0, 110982], [7, 111169], [11, 111369], [14, 111489], [18, 111649], [26, 112169], [31, 112569], [33, 112669], [39, 112849], [43, 113049], [52, 113429], [55, 113704], [58, 113824], [62, 113964], [66, 114104], [72, 114364], [74, 114604]]}, {"verse": 16, "start": 115410, "end": 121900, "text": "Ahora pues, ¿por qué te detienes? Levántate, y bautízate, y lava tus pecados, invocando su nombre.", "words": [[0, 115410], [6, 115652], [12, 116452], [17, 116552], [21, 116692], [24, 116812], [34, 117726], [45, 118310], [47, 118470], [58, 119070], [60, 119330], [65, 119470], [69, 119710], [78, 120430], [88, 120910], [91, 121090]]}, {"verse": 17, "start": 122250, "end": 127318, "text": "Y me aconteció, vuelto a Jerusalén, que orando en el templo, entré en éxtasis.", "words": [[0, 122250], [2, 122351], [5, 122431], [16, 123071], [23, 123431], [25, 123511], [36, 124491], [40, 124751], [47, 125011], [50, 125171], [53, 125291], [61, 126091], [67, 126451], [70, 126551]]}, {"verse": 18, "start": 127668, "end": 135639, "text": "Y le vi que me decía: Date prisa, y sal rápidamente fuera de Jerusalén; porque no recibirán tu testimonio de mí.", "words": [[0, 127668], [2, 127752], [5, 127872], [8, 127992], [12, 128112], [15, 128252], [22, 129116], [27, 129364], [34, 129924], [36, 130004], [40, 130264], [52, 131084], [58, 131404], [61, 132001], [72, 132770], [79, 133169], [82, 133409], [92, 134189], [95, 134389], [106, 135169], [109, 135269]]}, {"verse": 19, "start": 135859, "end": 142082, "text": "Y yo dije: Señor, ellos saben que yo encerraba en cárcel, y hería por las sinagogas a los que creían en ti;", "words": [[0, 135859], [2, 135968], [5, 136088], [11, 136772], [18, 137558], [24, 137738], [30, 138018], [34, 138198], [37, 138358], [47, 138838], [50, 138938], [58, 139418], [60, 139758], [66, 140018], [70, 140158], [74, 140318], [84, 140898], [86, 141018], [90, 141118], [94, 141218], [101, 141598], [104, 141758]]}, {"verse": 20, "start": 142432, "end": 151701, "text": "Y cuando se derramaba la sangre de Esteban tu testigo, yo también estaba presente, y consentía a su muerte, y guardaba las ropas de los que le mataban.", "words": [[0, 142432], [2, 142539], [9, 142759], [12, 143019], [22, 143539], [25, 143679], [32, 144059], [35, 144259], [43, 144759], [46, 144939], [55, 145999], [58, 146139], [66, 146419], [73, 146759], [83, 147779], [85, 147819], [95, 148459], [97, 148579], [100, 148679], [108, 149519], [110, 149559], [119, 149979], [123, 150159], [129, 150519], [132, 150679], [136, 150799], [140, 150979], [143, 151079]]}, {"verse": 21, "start": 152051, "end": 155977, "text": "Y me dijo: Ve, porque yo te tengo que enviar lejos a los Gentiles.", "words": [[0, 152051], [2, 152158], [5, 152238], [11, 152973], [15, 153122], [22, 153362], [25, 153562], [28, 153702], [34, 153982], [38, 154162], [45, 154562], [51, 154942], [53, 155102], [57, 155222]]}, {"verse": 22, "start": 156327, "end": 164873, "text": "Y le oyeron hasta esta palabra: entonces alzaron la voz, diciendo: Quita de la tierra a un tal hombre, porque no conviene que viva.", "words": [[0, 156327], [2, 156450], [5, 156570], [12, 157130], [18, 157430], [23, 157650], [32, 158380], [41, 158887], [49, 159767], [52, 159967], [57, 160327], [67, 161461], [73, 161717], [76, 161857], [79, 161957], [86, 162277], [88, 162537], [91, 162677], [95, 162817], [103, 163377], [110, 163697], [113, 163877], [122, 164297], [126, 164457]]}, {"verse": 23, "start": 165153, "end": 170243, "text": "Y dando ellos voces, y arrojando sus ropas y echando polvo al aire,", "words": [[0, 165153], [2, 165297], [8, 165517], [14, 165777], [21, 166437], [23, 166777], [33, 167357], [37, 167557], [43, 168157], [45, 168597], [53, 169017], [59, 169577], [62, 169737]]}, {"verse": 24, "start": 170593, "end": 180280, "text": "Mandó el comandante que le llevasen a la fortaleza, y ordenó que fuese interrogado con azotes, para saber por qué causa clamaban así contra él.", "words": [[0, 170593], [6, 170880], [9, 170960], [20, 171560], [24, 171760], [27, 171960], [36, 172160], [38, 172360], [41, 172500], [52, 173300], [54, 174160], [61, 174640], [65, 174780], [71, 175120], [83, 175860], [87, 176080], [95, 176580], [100, 177340], [106, 177680], [110, 177980], [114, 178180], [120, 178740], [129, 179300], [133, 179540], [140, 179900]]}, {"verse": 25, "start": 180630, "end": 189679, "text": "Y como le ataron con correas, Pablo dijo al centurión que estaba presente: ¿Os es lícito azotar a un hombre Romano sin ser condenado?", "words": [[0, 180630], [2, 180756], [7, 180996], [10, 181216], [17, 181676], [21, 181916], [30, 183216], [36, 183696], [41, 184036], [44, 184276], [54, 184896], [58, 185036], [65, 185276], [75, 186264], [79, 186430], [82, 186590], [89, 186970], [96, 187470], [98, 187530], [101, 187690], [108, 187950], [115, 188430], [119, 188650], [123, 188910]]}, {"verse": 26, "start": 189959, "end": 198942, "text": "Y como el centurión oyó esto, fue y dio aviso al comandante, diciendo: ¿Qué vas a hacer? porque este hombre es Romano.", "words": [[0, 189959], [2, 190085], [7, 190345], [10, 190505], [20, 191225], [24, 191645], [30, 192505], [34, 192945], [36, 193265], [40, 193625], [46, 193985], [49, 194185], [61, 195465], [71, 196545], [76, 196650], [80, 196810], [82, 196950], [89, 197742], [96, 197882], [101, 198042], [108, 198242], [111, 198402]]}, {"verse": 27, "start": 199222, "end": 206969, "text": "Y viniendo el comandante, le dijo: Dime, ¿eres tú Romano? Y él dijo: Sí.", "words": [[0, 199222], [2, 199329], [11, 199829], [14, 199929], [26, 200889], [29, 201149], [35, 201887], [41, 202492], [47, 202672], [50, 202892], [58, 205527], [60, 205715], [63, 205875], [69, 206808]]}, {"verse": 28, "start": 207249, "end": 215684, "text": "Y respondió el comandante: Yo con grande suma alcancé esta ciudadanía. Entonces Pablo dijo: Pero yo lo soy de nacimiento.", "words": [[0, 207249], [2, 207373], [12, 208013], [15, 208093], [27, 209261], [30, 209403], [34, 209563], [41, 209843], [46, 210323], [54, 210803], [59, 211023], [71, 212115], [80, 212559], [86, 213179], [92, 214019], [97, 214160], [100, 214380], [103, 214500], [107, 214740], [110, 214860]]}, {"verse": 29, "start": 215964, "end": 227282, "text": "Así que, luego se apartaron de él los que le habían de atormentar: y aun el comandante también tuvo temor, entendido que era Romano, por haberle atado.", "words": [[0, 215964], [4, 216244], [9, 216424], [15, 216704], [18, 216964], [28, 217604], [31, 217844], [34, 218064], [38, 218504], [42, 218664], [45, 218844], [52, 219104], [55, 219324], [67, 220451], [69, 220613], [73, 220813], [76, 220993], [87, 221813], [95, 222233], [100, 222653], [107, 223453], [117, 224353], [121, 224573], [125, 224753], [133, 225953], [137, 226113], [145, 226613]]}, {"verse": 30, "start": 227632, "end": 244744, "text": "Y al día siguiente, queriendo saber de cierto la causa por qué era acusado de los judíos, le soltó de las ataduras, y mandó venir a los principales sacerdotes, y a todo su Consejo: y sacando a Pablo, le presentó delante de ellos.", "words": [[0, 227632], [2, 227755], [5, 227875], [9, 228015], [20, 229075], [30, 229475], [36, 229795], [39, 230035], [46, 230415], [49, 230975], [55, 231355], [59, 231755], [63, 231955], [67, 232335], [75, 233075], [78, 233235], [82, 233375], [90, 234315], [93, 234395], [99, 234935], [102, 235075], [106, 235255], [116, 235935], [118, 236475], [124, 236855], [130, 237175], [132, 237335], [136, 237455], [148, 238155], [160, 239356], [162, 239482], [164, 239582], [169, 239802], [172, 240062], [181, 241160], [183, 241286], [191, 241766], [193, 241886], [200, 242326], [203, 242966], [212, 243566], [220, 243986], [223, 244166]]}]}