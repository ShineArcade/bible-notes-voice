{"book": "JHN", "chapter": 18, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 319948, "verses": [{"verse": 1, "start": 300, "end": 9119, "text": "When Jesus had spoken these words, he went forth with his disciples over the brook Cedron, where was a garden, into which he entered, and his disciples.", "words": [[0, 300], [5, 449], [11, 729], [15, 989], [22, 1329], [28, 1589], [35, 2389], [38, 2509], [43, 2689], [49, 3009], [54, 3249], [58, 3369], [68, 3909], [73, 4229], [77, 4389], [83, 4669], [91, 5609], [97, 5729], [101, 5949], [103, 6069], [111, 6749], [116, 6989], [122, 7249], [125, 7429], [134, 7809], [138, 8109], [142, 8269]]}, {"verse": 2, "start": 9569, "end": 15871, "text": "And Judas also, which betrayed him, knew the place: for Jesus often resorted there with his disciples.", "words": [[0, 9569], [4, 9734], [10, 9954], [16, 10614], [22, 10794], [31, 11114], [36, 11874], [41, 12074], [45, 12214], [52, 13057], [56, 13181], [62, 13441], [68, 13901], [77, 14421], [83, 14681], [88, 14881], [92, 15021]]}, {"verse": 3, "start": 16321, "end": 24598, "text": "Judas then, having received a band of men and officers from the chief priests and Pharisees, comes there with lanterns and torches and weapons.", "words": [[0, 16321], [6, 16540], [12, 17060], [19, 17260], [28, 17720], [30, 17980], [35, 18260], [38, 18460], [42, 18700], [46, 18880], [55, 19280], [60, 19640], [64, 19780], [70, 20040], [78, 20440], [82, 20700], [93, 21740], [99, 22060], [105, 22360], [110, 22580], [119, 23260], [123, 23360], [131, 23800], [135, 24000]]}, {"verse": 4, "start": 25048, "end": 32219, "text": "Jesus therefore, knowing all things that should come upon him, went forth, and said to them, Whom do you seek?", "words": [[0, 25048], [6, 25628], [17, 26068], [25, 26348], [29, 26748], [36, 27088], [41, 27368], [48, 27548], [53, 27788], [58, 28108], [63, 29028], [68, 29148], [75, 29548], [79, 30028], [84, 30288], [87, 30508], [93, 31152], [98, 31425], [101, 31565], [105, 31685]]}, {"verse": 5, "start": 32569, "end": 43764, "text": "They answered him, Jesus of Nazareth. Jesus says to them, I am he. And Judas also, which betrayed him, stood with them.", "words": [[0, 32569], [5, 32734], [14, 33094], [19, 34257], [25, 34555], [28, 34855], [38, 36190], [44, 36474], [49, 36814], [52, 37054], [58, 39394], [60, 39692], [63, 39972], [67, 40752], [71, 40897], [77, 41137], [83, 41817], [89, 41977], [98, 42317], [103, 42917], [109, 43117], [114, 43437]]}, {"verse": 6, "start": 44214, "end": 49738, "text": "As soon then as he had said to them, I am he, they went backward, and fell to the ground.", "words": [[0, 44214], [3, 44378], [8, 44658], [13, 44918], [16, 45078], [19, 45218], [23, 45398], [28, 45618], [31, 45818], [37, 46458], [39, 46738], [42, 46918], [46, 47518], [51, 47638], [56, 47838], [66, 48278], [70, 48678], [75, 48898], [78, 49058], [82, 49158]]}, {"verse": 7, "start": 50188, "end": 56082, "text": "Then asked he them again, Whom do you seek? And they said, Jesus of Nazareth.", "words": [[0, 50188], [5, 50475], [11, 50761], [14, 51048], [19, 51248], [26, 52074], [31, 52347], [34, 52487], [38, 52607], [44, 53491], [48, 53641], [53, 53761], [59, 54500], [65, 54798], [68, 55098]]}, {"verse": 8, "start": 56432, "end": 63152, "text": "Jesus answered, I have told you that I am he: if therefore you seek me, let these go their way:", "words": [[0, 56432], [6, 56710], [16, 57730], [18, 57888], [23, 58048], [28, 58308], [32, 58608], [37, 58828], [39, 59068], [42, 59228], [46, 59886], [49, 60088], [59, 60488], [63, 60768], [68, 61068], [72, 61708], [76, 61828], [82, 62128], [85, 62428], [91, 62648]]}, {"verse": 9, "start": 63502, "end": 69238, "text": "That the saying might be fulfilled, which he spoke, Of them which you gave me have I lost none.", "words": [[0, 63502], [5, 63630], [9, 63750], [16, 64050], [22, 64330], [25, 64530], [36, 65490], [42, 65770], [45, 65910], [52, 66210], [55, 66790], [60, 67070], [66, 67370], [70, 67510], [75, 67750], [78, 68010], [83, 68250], [85, 68390], [90, 68670]]}, {"verse": 10, "start": 69688, "end": 78447, "text": "Then Simon Peter having a sword drew it, and struck the high priest’s servant, and cut off his right ear. The servant’s name was Malchus.", "words": [[0, 69688], [5, 69970], [11, 70390], [17, 70990], [24, 71210], [26, 71410], [32, 71690], [37, 71970], [41, 72570], [45, 72630], [52, 72910], [56, 73170], [61, 73390], [70, 74030], [79, 74330], [83, 74810], [87, 75050], [91, 75230], [95, 75430], [101, 75670], [106, 76585], [110, 76686], [120, 77186], [125, 77406], [129, 77957]]}, {"verse": 11, "start": 78897, "end": 85865, "text": "Then said Jesus to Peter, Put up your sword into the sheath: the cup which my Father has given me, shall I not drink it?", "words": [[0, 78897], [5, 79079], [10, 79399], [16, 79839], [19, 80139], [26, 80927], [30, 81042], [33, 81182], [38, 81301], [44, 81622], [49, 81861], [53, 82042], [61, 82722], [65, 82813], [69, 83093], [75, 83333], [78, 83513], [85, 83813], [89, 84053], [95, 84293], [99, 84733], [105, 84973], [107, 85113], [111, 85293], [117, 85553]]}, {"verse": 12, "start": 86215, "end": 91032, "text": "Then the band and the captain and officers of the Jews took Jesus, and bound him,", "words": [[0, 86215], [5, 86365], [9, 86505], [14, 86845], [18, 87005], [22, 87145], [30, 87465], [34, 87725], [43, 88105], [46, 88385], [50, 88505], [55, 88785], [60, 89105], [67, 89565], [71, 90285], [77, 90605]]}, {"verse": 13, "start": 91482, "end": 98658, "text": "And led him away to Annas first; for he was father in law to Caiaphas, which was the high priest that same year.", "words": [[0, 91482], [4, 91607], [8, 91807], [12, 91967], [17, 92207], [20, 92407], [26, 92827], [33, 93670], [37, 93798], [40, 93998], [44, 94198], [51, 94498], [54, 94738], [58, 94938], [61, 95138], [71, 96238], [77, 96398], [81, 96598], [85, 96758], [90, 96958], [97, 97318], [102, 97738], [107, 98118]]}, {"verse": 14, "start": 99108, "end": 106264, "text": "Now Caiaphas was he, which gave counsel to the Jews, that it was expedient that one man should die for the people.", "words": [[0, 99108], [4, 99634], [13, 100174], [17, 100474], [21, 101114], [27, 101294], [32, 101494], [40, 101914], [43, 102134], [47, 102254], [53, 102594], [58, 103214], [61, 103294], [65, 103434], [75, 104154], [80, 104334], [84, 104594], [88, 104854], [95, 105094], [99, 105414], [103, 105614], [107, 105734]]}, {"verse": 15, "start": 106714, "end": 116355, "text": "¶ And Simon Peter followed Jesus, and so did another disciple: that disciple was known to the high priest, and went in with Jesus into the palace of the high priest.", "words": [[2, 106714], [6, 106859], [12, 107159], [18, 107519], [27, 107919], [34, 108879], [38, 109059], [41, 109219], [45, 109439], [53, 109739], [63, 110876], [68, 111037], [77, 111457], [81, 111797], [87, 112057], [90, 112257], [94, 112377], [99, 112557], [107, 113317], [111, 113517], [116, 113717], [119, 113897], [124, 114097], [130, 114437], [135, 114777], [139, 114937], [146, 115277], [149, 115477], [153, 115597], [158, 115777]]}, {"verse": 16, "start": 116805, "end": 126350, "text": "But Peter stood at the door without. Then went out that other disciple, which was known to the high priest, and spoke to her that kept the door, and brought in Peter.", "words": [[0, 116805], [4, 116932], [10, 117192], [16, 117492], [19, 117672], [23, 117772], [28, 118012], [37, 118970], [42, 119211], [47, 119451], [51, 119691], [56, 119911], [62, 120151], [72, 121131], [78, 121311], [82, 121532], [88, 121811], [91, 122032], [95, 122151], [100, 122351], [108, 123211], [112, 123392], [118, 123671], [121, 123911], [125, 124071], [130, 124252], [135, 124471], [139, 124711], [145, 124991], [149, 125351], [157, 125611], [160, 125831]]}, {"verse": 17, "start": 126800, "end": 135152, "text": "Then says the girl that kept the door to Peter, Are you not also one of this man’s disciples? He says, I am not.", "words": [[0, 126800], [5, 126945], [10, 127145], [14, 127365], [19, 127585], [24, 127725], [29, 127965], [33, 128125], [38, 128305], [41, 128405], [48, 130541], [52, 130641], [56, 130781], [60, 130941], [65, 131341], [69, 131581], [72, 131701], [77, 131861], [83, 132241], [94, 133427], [97, 133511], [103, 134392], [105, 134532], [108, 134672]]}, {"verse": 18, "start": 135502, "end": 145457, "text": "And the servants and officers stood there, who had made a fire of coals; for it was cold: and they warmed themselves: and Peter stood with them, and warmed himself.", "words": [[0, 135502], [4, 135653], [8, 135773], [17, 136193], [21, 136433], [30, 136833], [36, 137233], [43, 137553], [47, 138113], [51, 138273], [56, 138453], [58, 138553], [63, 138873], [66, 139053], [73, 139975], [77, 140128], [80, 140268], [84, 140408], [90, 141293], [94, 141451], [99, 141571], [106, 141871], [118, 143061], [122, 143184], [128, 143464], [134, 143764], [139, 144024], [145, 144284], [149, 144584], [156, 144864]]}, {"verse": 19, "start": 145907, "end": 150159, "text": "¶ The high priest then asked Jesus of his disciples, and of his doctrine.", "words": [[2, 145907], [6, 146019], [11, 146239], [18, 146619], [23, 146899], [29, 147179], [35, 147639], [38, 147959], [42, 148099], [53, 148679], [57, 149179], [60, 149319], [64, 149479]]}, {"verse": 20, "start": 150459, "end": 159692, "text": "Jesus answered him, I spoke openly to the world; I ever taught in the synagogue, and in the temple, where the Jews always resort; and in secret have I said nothing.", "words": [[0, 150459], [6, 150695], [15, 151155], [20, 151515], [22, 151615], [28, 151875], [35, 152355], [38, 152635], [42, 152755], [49, 153553], [51, 153670], [56, 153930], [63, 154190], [66, 154370], [70, 154450], [81, 154830], [85, 155350], [88, 155470], [92, 155570], [100, 155870], [106, 156150], [110, 156270], [115, 156570], [122, 156950], [130, 157921], [134, 158062], [137, 158162], [144, 158522], [149, 158782], [151, 158902], [156, 159102]]}, {"verse": 21, "start": 160142, "end": 166250, "text": "Why do you ask me? ask them which heard me, what I have said to them: behold, they know what I said.", "words": [[0, 160142], [4, 160359], [7, 160579], [11, 160719], [15, 161039], [19, 161652], [23, 161877], [28, 162117], [34, 162357], [40, 162657], [44, 163237], [49, 163357], [51, 163517], [56, 163637], [61, 163857], [64, 164057], [70, 164691], [78, 165229], [83, 165309], [88, 165489], [93, 165649], [95, 165769]]}, {"verse": 22, "start": 166600, "end": 175860, "text": "And when he had thus spoken, one of the officers which stood by struck Jesus with the palm of his hand, saying, Do you answer the high priest so?", "words": [[0, 166600], [4, 166745], [9, 166885], [12, 167085], [16, 167325], [21, 167545], [29, 168505], [33, 168725], [36, 168825], [40, 168945], [49, 169405], [55, 169745], [61, 169965], [64, 170245], [71, 170565], [77, 170985], [82, 171305], [86, 171425], [91, 171685], [94, 171825], [98, 171965], [104, 172605], [112, 173934], [115, 174057], [119, 174157], [126, 174557], [130, 174777], [135, 174957], [142, 175297]]}, {"verse": 23, "start": 176210, "end": 182853, "text": "Jesus answered him, If I have spoken evil, bear witness of the evil: but if well, why do you strike me?", "words": [[0, 176210], [6, 176482], [15, 176902], [20, 177540], [23, 177665], [25, 177845], [30, 177945], [37, 178285], [43, 179105], [48, 179225], [56, 179545], [59, 179825], [63, 179945], [69, 180681], [73, 180779], [76, 180919], [82, 181679], [86, 181899], [89, 182039], [93, 182139], [100, 182439]]}, {"verse": 24, "start": 183203, "end": 186654, "text": "Now Annas had sent him bound to Caiaphas the high priest.", "words": [[0, 183203], [4, 183463], [10, 183923], [14, 184063], [19, 184283], [23, 184463], [29, 184763], [32, 184983], [41, 185643], [45, 185883], [50, 186083]]}, {"verse": 25, "start": 187104, "end": 197700, "text": "And Simon Peter stood and warmed himself. They said therefore to him, Are you not also one of his disciples? He denied it, and said, I am not.", "words": [[0, 187104], [4, 187230], [10, 187530], [16, 187850], [22, 188230], [26, 188570], [33, 188850], [42, 189822], [47, 189926], [52, 190146], [62, 190526], [65, 190786], [70, 192582], [74, 192702], [78, 192822], [82, 192982], [87, 193422], [91, 193722], [94, 193862], [98, 194062], [109, 195342], [112, 195430], [119, 195770], [123, 196010], [127, 196210], [133, 196940], [135, 197080], [138, 197220]]}, {"verse": 26, "start": 198050, "end": 205287, "text": "One of the servants of the high priest, being his kinsman whose ear Peter cut off, says, Did not I see you in the garden with him?", "words": [[0, 198050], [4, 198174], [7, 198273], [11, 198414], [20, 198694], [23, 198954], [27, 199074], [32, 199234], [40, 199974], [46, 200294], [50, 200514], [58, 201074], [64, 201273], [68, 201574], [74, 201854], [78, 202174], [83, 202533], [89, 203237], [93, 203419], [97, 203639], [99, 203799], [103, 204019], [107, 204179], [110, 204299], [114, 204399], [121, 204699], [126, 204979]]}, {"verse": 27, "start": 205637, "end": 209131, "text": "Peter then denied again: and immediately the rooster crew.", "words": [[0, 205637], [6, 205837], [11, 206117], [18, 206457], [25, 207411], [29, 207555], [41, 207915], [45, 208295], [53, 208615]]}, {"verse": 28, "start": 209581, "end": 221425, "text": "¶ Then led they Jesus from Caiaphas to the hall of judgment: and it was early; and they themselves went not into the judgment hall, lest they should be defiled; but that they might eat the passover.", "words": [[2, 209581], [7, 209727], [11, 209987], [16, 210187], [22, 210607], [27, 211117], [36, 211627], [39, 211827], [43, 211927], [48, 212127], [51, 212227], [61, 213195], [65, 213339], [68, 213439], [72, 213579], [79, 214354], [83, 214503], [88, 214663], [99, 215183], [104, 215543], [108, 215883], [113, 216183], [117, 216343], [126, 216663], [132, 217603], [137, 217863], [142, 218043], [149, 218243], [152, 218423], [161, 219570], [165, 219658], [170, 219798], [175, 219998], [181, 220238], [185, 220478], [189, 220638]]}, {"verse": 29, "start": 221875, "end": 226012, "text": "Pilate then went out to them, and said, What accusation bring you against this man?", "words": [[0, 221999], [7, 222159], [12, 222479], [17, 222679], [21, 222879], [24, 223079], [30, 223239], [34, 223439], [40, 224106], [45, 224224], [56, 224804], [62, 225004], [66, 225144], [74, 225404], [79, 225644]]}, {"verse": 30, "start": 226362, "end": 231536, "text": "They answered and said to him, If he were not a malefactor, we would not have delivered him up to you.", "words": [[0, 226362], [5, 226471], [14, 226871], [18, 227091], [23, 227291], [26, 227471], [31, 227972], [34, 228108], [37, 228268], [42, 228368], [46, 228548], [48, 229108], [60, 229668], [63, 229828], [69, 229988], [73, 230148], [78, 230368], [88, 230688], [92, 230968], [95, 231128], [98, 231288]]}, {"verse": 31, "start": 231886, "end": 243668, "text": "Then said Pilate to them, Take him, and judge him according to your law. The Jews therefore said to him, It is not lawful for us to put any man to death:", "words": [[0, 231886], [5, 232114], [10, 232434], [17, 232754], [20, 233014], [26, 235299], [31, 235475], [36, 235635], [40, 235755], [46, 235935], [50, 236075], [60, 236355], [63, 236575], [68, 236755], [73, 239045], [77, 239204], [82, 239464], [92, 239844], [97, 240224], [100, 240424], [105, 241040], [108, 241151], [111, 241291], [115, 241451], [122, 241931], [126, 242151], [129, 242351], [132, 242491], [136, 242671], [140, 242931], [144, 243211], [147, 243351]]}, {"verse": 32, "start": 244018, "end": 249544, "text": "That the saying of Jesus might be fulfilled, which he spoke, signifying what death he should die.", "words": [[0, 244018], [5, 244144], [9, 244304], [16, 244584], [19, 244764], [25, 245024], [31, 245344], [34, 245544], [45, 246424], [51, 246624], [54, 246764], [61, 247424], [72, 248064], [77, 248324], [83, 248604], [86, 248784], [93, 248984]]}, {"verse": 33, "start": 249994, "end": 256372, "text": "Then Pilate entered into the judgment hall again, and called Jesus, and said to him, Are you the King of the Jews?", "words": [[0, 249994], [5, 250243], [12, 250763], [20, 251003], [25, 251263], [29, 251403], [38, 251703], [43, 252063], [50, 252443], [54, 252663], [61, 252883], [68, 253303], [72, 253863], [77, 254103], [80, 254303], [85, 254927], [89, 255062], [93, 255202], [97, 255342], [102, 255542], [105, 255702], [109, 255802]]}, {"verse": 34, "start": 256722, "end": 261696, "text": "Jesus answered him, Do you say this thing of yourself, or did others tell it you of me?", "words": [[0, 256722], [6, 256994], [15, 257414], [20, 258052], [23, 258136], [27, 258276], [31, 258476], [36, 258696], [42, 258896], [45, 259056], [55, 259796], [58, 260036], [62, 260196], [69, 260516], [74, 260836], [77, 260976], [81, 261136], [84, 261296]]}, {"verse": 35, "start": 262046, "end": 268003, "text": "Pilate answered, Am I a Jew? Your own nation and the chief priests have delivered you to me: what have you done?", "words": [[0, 262188], [7, 262338], [17, 263258], [20, 263421], [22, 263561], [24, 263641], [29, 264378], [34, 264543], [38, 264723], [45, 265103], [49, 265383], [53, 265503], [59, 265683], [67, 265983], [72, 266163], [82, 266463], [86, 266663], [89, 266783], [93, 267344], [98, 267465], [103, 267585], [107, 267665]]}, {"verse": 36, "start": 268353, "end": 280357, "text": "Jesus answered, My kingdom is not of this world: if my kingdom were of this world, then would my servants fight, that I should not be delivered to the Jews: but now is my kingdom not from here.", "words": [[0, 268353], [6, 268631], [16, 269651], [19, 269815], [27, 270175], [30, 270455], [34, 270675], [37, 270835], [42, 271015], [49, 271918], [52, 272038], [55, 272218], [63, 272538], [68, 272838], [71, 273078], [76, 273298], [83, 273918], [88, 274238], [94, 274398], [97, 274618], [106, 274958], [113, 275538], [118, 275778], [120, 275918], [127, 276098], [131, 276278], [134, 276438], [144, 276778], [147, 276998], [151, 277118], [157, 277999], [161, 278084], [165, 278404], [168, 278644], [171, 278844], [179, 279184], [183, 279584], [188, 279844]]}, {"verse": 37, "start": 280707, "end": 295497, "text": "Pilate therefore said to him, Are you a king then? Jesus answered, You say that I am a king. To this end was I born, and for this cause came I into the world, that I should bear witness to the truth. Every one that is of the truth hears my voice.", "words": [[0, 280707], [7, 281087], [17, 281427], [22, 281747], [25, 281967], [30, 282585], [34, 282731], [38, 282871], [40, 282971], [45, 283131], [51, 283866], [57, 284143], [67, 285164], [71, 285326], [75, 285566], [80, 285746], [82, 285966], [85, 286066], [87, 286146], [93, 286925], [96, 287008], [101, 287228], [105, 287488], [109, 287608], [111, 287788], [117, 288488], [121, 288688], [125, 288828], [130, 289048], [136, 289388], [141, 289688], [143, 289868], [148, 290128], [152, 290288], [159, 290648], [164, 291068], [166, 291208], [173, 291388], [178, 291608], [186, 291968], [189, 292268], [193, 292368], [200, 293076], [206, 293288], [210, 293588], [215, 293768], [218, 293888], [221, 294008], [225, 294128], [231, 294408], [237, 294668], [240, 294928]]}, {"verse": 38, "start": 295847, "end": 306105, "text": "Pilate says to him, What is truth? And when he had said this, he went out again to the Jews, and says to them, I find in him no fault at all.", "words": [[0, 295847], [7, 296247], [12, 296447], [15, 296747], [20, 297948], [25, 298185], [28, 298325], [35, 299130], [39, 299261], [44, 299421], [47, 299621], [51, 299761], [56, 299981], [62, 300581], [65, 300881], [70, 301081], [74, 301241], [80, 301521], [83, 301701], [87, 301801], [93, 302141], [97, 302401], [102, 302641], [105, 302841], [111, 304267], [113, 304387], [118, 304707], [121, 304887], [125, 305087], [128, 305347], [134, 305647], [137, 305827]]}, {"verse": 39, "start": 306555, "end": 312892, "text": "But you have a custom, that I should release to you one at the passover: will you therefore that I release to you the King of the Jews?", "words": [[0, 306555], [4, 306653], [8, 306773], [13, 306933], [15, 307053], [23, 307433], [28, 307813], [30, 307953], [37, 308093], [45, 308473], [48, 308673], [52, 308833], [56, 309113], [59, 309373], [63, 309473], [73, 310287], [78, 310385], [82, 310505], [92, 310885], [97, 311125], [99, 311225], [107, 311505], [110, 311685], [114, 311805], [118, 311925], [123, 312185], [126, 312325], [130, 312405]]}, {"verse": 40, "start": 313242, "end": 319548, "text": "Then cried they all again, saying, Not this man, but Barabbas. Now Barabbas was a robber.", "words": [[0, 313242], [5, 313451], [11, 313791], [16, 314031], [20, 314231], [27, 314731], [35, 315986], [39, 316207], [44, 316447], [49, 316707], [53, 317167], [63, 317918], [67, 318308], [76, 318698], [80, 318918], [82, 319038]]}]}