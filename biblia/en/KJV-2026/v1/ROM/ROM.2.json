{"book": "ROM", "chapter": 2, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 187372, "verses": [{"verse": 1, "start": 300, "end": 8945, "text": "Therefore you are inexcusable, O man, whoever you are that judge: for in whatever you judge another, you condemn yourself; for you that judge do the same things.", "words": [[0, 300], [10, 781], [14, 881], [18, 1021], [31, 1531], [33, 2041], [38, 2541], [46, 2761], [50, 3061], [54, 3201], [59, 3381], [66, 4150], [70, 4269], [73, 4369], [82, 4629], [86, 4889], [92, 5129], [101, 5789], [105, 5889], [113, 6209], [123, 7068], [127, 7192], [131, 7352], [136, 7532], [142, 7772], [145, 7992], [149, 8112], [154, 8352]]}, {"verse": 2, "start": 9395, "end": 14344, "text": "But we are sure that the judgment of God is according to truth against them which commit such things.", "words": [[0, 9395], [4, 9495], [7, 9675], [11, 9815], [16, 10095], [21, 10295], [25, 10435], [34, 10775], [37, 11015], [41, 11255], [44, 11495], [54, 11775], [57, 12015], [63, 12295], [71, 12695], [76, 12995], [82, 13235], [89, 13595], [94, 13855]]}, {"verse": 3, "start": 14794, "end": 21487, "text": "And do you think this, O man, that judge them which do such things, and do the same, that you shall escape the judgment of God?", "words": [[0, 14794], [4, 14937], [7, 15077], [11, 15177], [17, 15377], [23, 15717], [25, 15857], [30, 16337], [35, 16577], [41, 16917], [46, 17158], [52, 17357], [55, 17597], [60, 17798], [68, 18117], [72, 18478], [75, 18697], [79, 18838], [85, 19178], [90, 19597], [94, 19777], [100, 19937], [107, 20357], [111, 20518], [120, 20797], [123, 21037]]}, {"verse": 4, "start": 21937, "end": 28696, "text": "Or do you despise the riches of his goodness and forbearance and longsuffering; not knowing that the goodness of God leads you to repentance?", "words": [[0, 21937], [3, 22057], [6, 22157], [10, 22217], [18, 22737], [22, 22877], [29, 23137], [32, 23357], [36, 23457], [45, 23757], [49, 23997], [61, 24577], [65, 24697], [80, 25819], [84, 25983], [92, 26303], [97, 26503], [101, 26623], [110, 26883], [113, 27143], [117, 27383], [123, 27663], [127, 27803], [130, 27903]]}, {"verse": 5, "start": 29146, "end": 36129, "text": "But after your hardness and impenitent heart treasure up to yourself wrath against the day of wrath and revelation of the righteous judgment of God;", "words": [[0, 29146], [4, 29263], [10, 29463], [15, 29663], [24, 30143], [28, 30403], [39, 31003], [45, 31203], [54, 31543], [57, 31823], [60, 31943], [69, 32343], [75, 32623], [83, 32943], [87, 33183], [91, 33383], [94, 33483], [100, 33783], [104, 33963], [115, 34303], [118, 34643], [122, 34763], [132, 35063], [141, 35483], [144, 35663]]}, {"verse": 6, "start": 36579, "end": 39306, "text": "Who will render to every man according to his deeds:", "words": [[0, 36579], [4, 36733], [9, 36893], [16, 37233], [19, 37473], [25, 37773], [29, 38073], [39, 38413], [42, 38653], [46, 38813]]}, {"verse": 7, "start": 39756, "end": 45771, "text": "To them who by patient continuance in well doing seek for glory and honour and immortality, eternal life:", "words": [[0, 39756], [3, 39858], [8, 40058], [12, 40258], [15, 40418], [23, 40778], [35, 41478], [38, 41618], [43, 41818], [49, 42078], [54, 42378], [58, 42618], [64, 42958], [68, 43268], [75, 43578], [79, 43978], [92, 44998], [100, 45298]]}, {"verse": 8, "start": 46221, "end": 51435, "text": "But to them that are contentious, and do not obey the truth, but obey unrighteousness, indignation and wrath,", "words": [[0, 46221], [4, 46341], [7, 46461], [12, 46681], [17, 46841], [21, 46961], [34, 47621], [38, 47921], [41, 48041], [45, 48181], [50, 48421], [54, 48561], [61, 48981], [65, 49121], [70, 49381], [87, 50401], [99, 51061], [103, 51081]]}, {"verse": 9, "start": 51885, "end": 58592, "text": "Tribulation and anguish, upon every soul of man that does evil, of the Jew first, and also of the Gentile;", "words": [[0, 51885], [12, 52458], [16, 52678], [25, 53278], [30, 53718], [36, 54178], [41, 54498], [44, 54618], [48, 54878], [53, 55078], [58, 55318], [64, 55658], [67, 56198], [71, 56338], [75, 56518], [82, 56878], [86, 57438], [91, 57758], [94, 57898], [98, 57998]]}, {"verse": 10, "start": 59042, "end": 65152, "text": "But glory, honour, and peace, to every man that works good, to the Jew first, and also to the Gentile:", "words": [[0, 59042], [4, 59138], [11, 59648], [19, 60158], [23, 60218], [30, 60578], [33, 61118], [39, 61398], [43, 61638], [48, 61798], [54, 62038], [60, 62658], [63, 62878], [67, 63018], [71, 63238], [78, 63818], [82, 64018], [87, 64218], [90, 64378], [94, 64498]]}, {"verse": 11, "start": 65602, "end": 67647, "text": "For there is no respect of persons with God.", "words": [[0, 65602], [4, 65682], [10, 65822], [13, 65922], [16, 66102], [24, 66422], [27, 66682], [35, 67002], [40, 67262]]}, {"verse": 12, "start": 68097, "end": 75826, "text": "For as many as have sinned without law shall also perish without law: and as many as have sinned in the law shall be judged by the law;", "words": [[0, 68097], [4, 68207], [7, 68367], [12, 68667], [15, 68927], [20, 69157], [27, 69387], [35, 69727], [39, 70127], [45, 70367], [50, 70787], [57, 71187], [65, 71607], [70, 72447], [74, 72551], [77, 72691], [82, 72971], [85, 73251], [90, 73481], [97, 73711], [100, 73951], [104, 74091], [108, 74331], [114, 74531], [117, 74711], [124, 75051], [127, 75351], [131, 75491]]}, {"verse": 13, "start": 76276, "end": 80811, "text": "(For not the hearers of the law are just before God, but the doers of the law shall be justified.", "words": [[0, 76276], [5, 76384], [9, 76544], [13, 76724], [21, 77104], [24, 77224], [28, 77324], [32, 77544], [36, 77724], [41, 77904], [48, 78184], [53, 78804], [57, 78944], [61, 79064], [67, 79404], [70, 79524], [74, 79644], [78, 79824], [84, 80024], [87, 80164]]}, {"verse": 14, "start": 81261, "end": 89380, "text": "For when the Gentiles, which have not the law, do by nature the things contained in the law, these, having not the law, are a law to themselves:", "words": [[0, 81261], [4, 81374], [9, 81534], [13, 81634], [23, 82694], [29, 82854], [34, 83014], [38, 83214], [42, 83414], [47, 83954], [50, 84054], [53, 84214], [60, 84534], [64, 84714], [71, 84914], [81, 85354], [84, 85534], [88, 85614], [93, 86174], [100, 86434], [107, 86994], [111, 87294], [115, 87514], [120, 88014], [124, 88214], [126, 88314], [130, 88454], [133, 88614]]}, {"verse": 15, "start": 89830, "end": 98272, "text": "Which show the work of the law written in their hearts, their conscience also bearing witness, and their thoughts the mean while accusing or else excusing one another;)", "words": [[0, 89830], [6, 89977], [11, 90177], [15, 90297], [20, 90577], [23, 90797], [27, 90917], [31, 91217], [39, 91497], [42, 91677], [48, 91837], [56, 92517], [62, 92617], [73, 93097], [78, 93597], [86, 93937], [95, 94777], [99, 94897], [105, 95057], [114, 95377], [118, 95597], [123, 95917], [129, 96197], [138, 96577], [141, 96877], [146, 97037], [155, 97637], [159, 97777]]}, {"verse": 16, "start": 98722, "end": 103471, "text": "In the day when God shall judge the secrets of men by Jesus Christ according to my gospel.", "words": [[0, 98722], [3, 98845], [7, 98965], [11, 99185], [16, 99385], [20, 99625], [26, 99865], [32, 100165], [36, 100385], [44, 100745], [47, 101005], [51, 101205], [54, 101445], [60, 101725], [67, 102145], [77, 102505], [80, 102745], [83, 102905]]}, {"verse": 17, "start": 103921, "end": 108138, "text": "Behold, you are called a Jew, and rest in the law, and make your boast of God,", "words": [[0, 103921], [8, 104337], [12, 104497], [16, 104637], [23, 104857], [25, 105017], [30, 105257], [34, 105717], [39, 105997], [42, 106157], [46, 106237], [51, 106517], [55, 106877], [60, 107077], [65, 107237], [71, 107557], [74, 107737]]}, {"verse": 18, "start": 108588, "end": 113224, "text": "And know his will, and approve the things that are more excellent, being instructed out of the law;", "words": [[0, 108588], [4, 108746], [9, 108926], [13, 109126], [19, 109446], [23, 109866], [31, 110186], [35, 110406], [42, 110686], [47, 110866], [51, 110986], [56, 111126], [67, 111526], [73, 111986], [84, 112426], [88, 112666], [91, 112786], [95, 112886]]}, {"verse": 19, "start": 113674, "end": 118935, "text": "And are confident that you yourself are a guide of the blind, a light of them which are in darkness,", "words": [[0, 113674], [4, 113834], [8, 113994], [18, 114454], [23, 114794], [27, 114974], [36, 115434], [40, 115754], [42, 115854], [48, 116094], [51, 116254], [55, 116354], [62, 117094], [64, 117254], [70, 117454], [73, 117594], [78, 117774], [84, 117954], [88, 118114], [91, 118234]]}, {"verse": 20, "start": 119385, "end": 124677, "text": "An instructor of the foolish, a teacher of babes, which have the form of knowledge and of the truth in the law.", "words": [[0, 119385], [3, 119529], [14, 119889], [17, 120209], [21, 120349], [30, 120989], [32, 121049], [40, 121329], [43, 121489], [50, 122049], [56, 122229], [61, 122389], [65, 122509], [70, 122749], [73, 122889], [83, 123229], [87, 123589], [90, 123709], [94, 123809], [100, 124049], [103, 124269], [107, 124369]]}, {"verse": 21, "start": 125127, "end": 130956, "text": "You therefore which teach another, do you not teach yourself? you that preach a man should not steal, do you steal?", "words": [[0, 125127], [4, 125225], [14, 125725], [20, 125885], [26, 126125], [35, 126905], [38, 126945], [42, 126985], [46, 127225], [52, 127485], [62, 128405], [66, 128514], [71, 128654], [78, 128914], [80, 129054], [84, 129254], [91, 129454], [95, 129654], [102, 130234], [105, 130314], [109, 130434]]}, {"verse": 22, "start": 131406, "end": 138051, "text": "You that say a man should not commit adultery, do you commit adultery? you that abhor idols, do you commit sacrilege?", "words": [[0, 131406], [4, 131518], [9, 131678], [13, 131878], [15, 131978], [19, 132158], [26, 132378], [30, 132598], [37, 132938], [47, 133898], [50, 133998], [54, 134098], [61, 134378], [71, 135411], [75, 135514], [80, 135694], [86, 136134], [93, 136854], [96, 136954], [100, 137054], [107, 137294]]}, {"verse": 23, "start": 138501, "end": 142553, "text": "You that make your boast of the law, through breaking the law do you dishonour God?", "words": [[0, 138501], [4, 138685], [9, 138885], [14, 139085], [19, 139225], [25, 139505], [28, 139665], [32, 139765], [37, 140045], [45, 140545], [54, 140905], [58, 141105], [62, 141305], [65, 141505], [69, 141805], [79, 142105]]}, {"verse": 24, "start": 143003, "end": 147872, "text": "For the name of God is blasphemed among the Gentiles through you, as it is written.", "words": [[0, 143003], [4, 143072], [8, 143172], [13, 143392], [16, 143512], [20, 143752], [23, 143912], [34, 144592], [40, 144752], [44, 144952], [53, 145472], [61, 145672], [66, 145932], [69, 146332], [72, 146432], [75, 146552]]}, {"verse": 25, "start": 148322, "end": 155386, "text": "For circumcision indeed profits, if you keep the law: but if you be a breaker of the law, your circumcision is made uncircumcision.", "words": [[0, 148322], [4, 148424], [17, 149144], [24, 149464], [33, 149924], [36, 150424], [40, 150544], [45, 150764], [49, 150904], [54, 151525], [58, 151644], [61, 151744], [65, 151844], [68, 151984], [70, 152064], [78, 152364], [81, 152564], [85, 152684], [90, 153184], [95, 153264], [108, 153964], [111, 154144], [116, 154324]]}, {"verse": 26, "start": 155836, "end": 162282, "text": "Therefore if the uncircumcision keep the righteousness of the law, shall not his uncircumcision be counted for circumcision?", "words": [[0, 155836], [10, 156317], [13, 156437], [17, 156597], [32, 157457], [37, 157717], [41, 157877], [55, 158237], [58, 158557], [62, 158677], [67, 159237], [73, 159497], [77, 159717], [81, 159957], [96, 160817], [99, 161017], [107, 161317], [111, 161497]]}, {"verse": 27, "start": 162732, "end": 170853, "text": "And shall not uncircumcision which is by nature, if it fulfil the law, judge you, who by the letter and circumcision do transgress the law?", "words": [[0, 162732], [4, 162872], [10, 163072], [14, 163292], [29, 164392], [35, 164512], [38, 164632], [41, 164812], [49, 165612], [52, 165752], [55, 166002], [62, 166252], [66, 166532], [71, 166992], [77, 167152], [82, 167792], [86, 167912], [89, 168092], [93, 168252], [100, 168492], [104, 168732], [117, 169452], [120, 169792], [131, 170332], [135, 170532]]}, {"verse": 28, "start": 171303, "end": 177307, "text": "For he is not a Jew, which is one outwardly; neither is that circumcision, which is outward in the flesh:", "words": [[0, 171303], [4, 171427], [7, 171627], [10, 171867], [14, 172047], [16, 172167], [21, 172587], [27, 172787], [30, 172927], [34, 173127], [45, 174137], [53, 174393], [56, 174733], [61, 174953], [75, 175773], [81, 175893], [84, 176033], [92, 176393], [95, 176733], [99, 176853]]}, {"verse": 29, "start": 177757, "end": 186972, "text": "But he is a Jew, which is one inwardly; and circumcision is that of the heart, in the spirit, and not in the letter; whose praise is not of men, but of God.", "words": [[0, 177757], [4, 177896], [7, 178116], [10, 178336], [12, 178456], [17, 178636], [23, 178976], [26, 179116], [30, 179296], [40, 180194], [44, 180337], [57, 180977], [60, 181277], [65, 181497], [68, 181657], [72, 181797], [79, 182017], [82, 182417], [86, 182517], [94, 182857], [98, 183317], [102, 183557], [105, 183817], [109, 183917], [117, 184606], [123, 184713], [130, 185093], [133, 185313], [137, 185533], [140, 185673], [145, 185953], [149, 186393], [152, 186533]]}]}