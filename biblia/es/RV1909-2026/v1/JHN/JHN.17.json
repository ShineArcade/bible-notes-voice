{"book": "JHN", "chapter": 17, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 201774, "verses": [{"verse": 1, "start": 300, "end": 11633, "text": "Estas cosas habló Jesús, y levantados los ojos al cielo, dijo: Padre, la hora es llegada; glorifica a tu Hijo, para que también tu Hijo te glorifique a ti;", "words": [[0, 300], [6, 676], [12, 1016], [18, 1476], [25, 1856], [27, 2441], [38, 3141], [42, 3341], [47, 3681], [50, 3981], [57, 4301], [63, 5141], [70, 5883], [73, 6023], [78, 6203], [81, 6483], [90, 7915], [100, 8305], [102, 8505], [105, 8665], [111, 8925], [116, 9505], [120, 9645], [128, 9965], [131, 10205], [136, 10445], [139, 10645], [150, 11205], [152, 11365]]}, {"verse": 2, "start": 11983, "end": 18653, "text": "Como le has dado autoridad sobre toda carne, para que dé vida eterna a todos los que le diste.", "words": [[0, 11983], [5, 12171], [8, 12331], [12, 12451], [17, 12691], [27, 13331], [33, 13651], [38, 14011], [45, 15071], [50, 15451], [54, 15631], [57, 15791], [62, 16191], [69, 16831], [71, 17071], [77, 17511], [81, 17791], [85, 17951], [88, 18071]]}, {"verse": 3, "start": 19003, "end": 27073, "text": "Y esta es la vida eterna: que te conozcan a ti, el único Dios verdadero, y a Jesucristo, al cual has enviado.", "words": [[0, 19003], [2, 19169], [7, 19349], [10, 19509], [13, 19609], [18, 19769], [26, 20698], [30, 20802], [33, 20922], [42, 21482], [44, 21622], [48, 22302], [51, 22602], [57, 23042], [62, 23482], [73, 24282], [75, 24462], [77, 24582], [89, 25342], [92, 25622], [97, 25842], [101, 26222]]}, {"verse": 4, "start": 27423, "end": 32521, "text": "Yo te he glorificado en la tierra: he acabado la obra que me diste que hiciese.", "words": [[0, 27423], [3, 27609], [6, 27789], [9, 28249], [21, 28709], [24, 28809], [27, 28909], [35, 29818], [38, 30062], [46, 30562], [49, 30722], [54, 30982], [58, 31182], [61, 31322], [67, 31682], [71, 31782]]}, {"verse": 5, "start": 32871, "end": 40451, "text": "Ahora pues, Padre, glorifícame tú cerca de ti mismo con aquella gloria que tuve cerca de ti antes que el mundo fuese.", "words": [[0, 32871], [6, 33357], [12, 33757], [19, 34497], [31, 35237], [34, 35517], [40, 35877], [43, 36197], [46, 36317], [52, 36657], [56, 36937], [64, 37297], [71, 37697], [75, 37837], [80, 38117], [86, 38397], [89, 38657], [92, 38837], [98, 39237], [102, 39437], [105, 39557], [111, 39797]]}, {"verse": 6, "start": 40801, "end": 47907, "text": "He manifestado tu nombre a los hombres que del mundo me diste: tuyos eran, y me los diste, y guardaron tu palabra.", "words": [[0, 40801], [3, 41046], [15, 41726], [18, 41886], [25, 42226], [27, 42386], [31, 42526], [39, 42906], [43, 43106], [47, 43246], [53, 43677], [56, 44107], [63, 44915], [69, 45175], [75, 45435], [77, 45575], [80, 45695], [84, 45835], [91, 46315], [93, 46475], [103, 47095], [106, 47275]]}, {"verse": 7, "start": 48257, "end": 51669, "text": "Ahora han conocido que todas las cosas que me diste, son de ti;", "words": [[0, 48257], [6, 48505], [10, 48725], [19, 49265], [23, 49385], [29, 49645], [33, 49945], [39, 50245], [43, 50445], [46, 50565], [53, 50925], [57, 51065], [60, 51325]]}, {"verse": 8, "start": 52019, "end": 61638, "text": "Porque las palabras que me diste, les he dado; y ellos las recibieron, y han conocido verdaderamente que salí de ti, y han creído que tú me enviaste.", "words": [[0, 52019], [7, 52399], [11, 52579], [20, 52959], [24, 53199], [27, 53339], [34, 53859], [38, 54139], [41, 54359], [47, 55141], [49, 55284], [55, 55544], [59, 55764], [71, 56484], [73, 56759], [77, 56879], [86, 57439], [101, 58219], [105, 58439], [110, 58819], [113, 58919], [117, 59179], [119, 59859], [123, 59979], [130, 60419], [134, 60599], [137, 60759], [140, 60879]]}, {"verse": 9, "start": 61988, "end": 68128, "text": "Yo ruego por ellos: no ruego por el mundo, sino por los que me diste; porque tuyos son:", "words": [[0, 61988], [3, 62176], [9, 62516], [13, 62736], [20, 63577], [23, 63741], [29, 64121], [33, 64341], [36, 64481], [43, 64761], [48, 65061], [52, 65581], [56, 65721], [60, 65881], [63, 66021], [70, 66852], [77, 67186], [83, 67556]]}, {"verse": 10, "start": 68478, "end": 75007, "text": "Y todas mis cosas son tus cosas, y tus cosas son mis cosas: y he sido glorificado en ellas.", "words": [[0, 68478], [2, 68586], [8, 68746], [12, 69026], [18, 69386], [22, 69706], [26, 69866], [33, 70686], [35, 70886], [39, 71026], [45, 71326], [49, 71646], [53, 71806], [60, 72766], [62, 73043], [65, 73143], [70, 73363], [82, 74263], [85, 74423]]}, {"verse": 11, "start": 75357, "end": 86926, "text": "Y ya no estoy en el mundo; pero estos están en el mundo, y yo a ti vengo. Padre santo, a los que me has dado, guárdalos por tu nombre, para que sean uno, como también nosotros.", "words": [[0, 75357], [2, 75474], [5, 75614], [8, 75734], [14, 75934], [17, 76134], [20, 76234], [27, 77037], [32, 77179], [38, 77439], [44, 77879], [47, 78079], [50, 78219], [57, 78599], [59, 79379], [62, 79639], [64, 79899], [67, 80059], [74, 80885], [80, 81187], [87, 81527], [89, 81767], [93, 81847], [97, 81987], [100, 82107], [104, 82267], [110, 82987], [120, 83607], [124, 83787], [127, 83967], [135, 84307], [140, 84627], [144, 84767], [149, 85047], [154, 85447], [159, 85707], [167, 86087]]}, {"verse": 12, "start": 87276, "end": 100145, "text": "Cuando estaba con ellos en el mundo, yo los guardaba en tu nombre; a los que me diste, yo los guardé, y ninguno de ellos se perdió, sino el hijo de perdición; para que la Escritura se cumpliese.", "words": [[0, 87276], [7, 87460], [14, 87760], [18, 88120], [24, 88300], [27, 88580], [30, 88720], [37, 89040], [40, 89240], [44, 89440], [53, 89980], [56, 90160], [59, 90300], [67, 91218], [69, 91358], [73, 91478], [77, 91618], [80, 91798], [87, 92578], [90, 92738], [94, 92938], [102, 93818], [104, 93898], [112, 94578], [115, 94738], [121, 95018], [124, 95278], [132, 96078], [137, 96338], [140, 96558], [145, 96818], [148, 96958], [159, 98132], [164, 98276], [168, 98436], [171, 98556], [181, 99096], [184, 99256]]}, {"verse": 13, "start": 100495, "end": 107139, "text": "Pero ahora vengo a ti; y hablo esto en el mundo, para que tengan mi gozo cumplido en sí mismos.", "words": [[0, 100495], [5, 100641], [11, 100861], [17, 101241], [19, 101341], [23, 101862], [25, 102007], [31, 102347], [36, 102587], [39, 102767], [42, 102887], [49, 103247], [54, 103847], [58, 104007], [65, 104347], [68, 104647], [73, 105027], [82, 105727], [85, 105907], [88, 106067]]}, {"verse": 14, "start": 107489, "end": 114753, "text": "Yo les he dado tu palabra; y el mundo los aborreció, porque no son del mundo, como tampoco yo soy del mundo.", "words": [[0, 107489], [3, 107739], [7, 108079], [10, 108279], [15, 108559], [18, 108759], [27, 109735], [29, 109874], [32, 110054], [38, 110354], [42, 110634], [53, 111474], [60, 111754], [63, 111974], [67, 112194], [71, 112374], [78, 112754], [83, 113034], [91, 113434], [94, 113774], [98, 113994], [102, 114174]]}, {"verse": 15, "start": 115103, "end": 119565, "text": "No ruego que los quites del mundo, sino que los guardes del mal.", "words": [[0, 115103], [3, 115436], [9, 115896], [13, 116076], [17, 116256], [24, 116616], [28, 116796], [35, 117636], [40, 117976], [44, 118196], [48, 118356], [56, 118856], [60, 119016]]}, {"verse": 16, "start": 119915, "end": 122946, "text": "No son del mundo, como tampoco yo soy del mundo.", "words": [[0, 119915], [3, 120099], [7, 120299], [11, 120479], [18, 120859], [23, 121119], [31, 121539], [34, 121919], [38, 122159], [42, 122339]]}, {"verse": 17, "start": 123296, "end": 126531, "text": "Santifícalos en tu verdad: tu palabra es verdad.", "words": [[0, 123782], [13, 124302], [16, 124462], [19, 124562], [27, 125314], [30, 125400], [38, 125760], [41, 125980]]}, {"verse": 18, "start": 126881, "end": 131512, "text": "Como tú me enviaste al mundo, también los he enviado al mundo.", "words": [[0, 126881], [5, 127045], [8, 127305], [11, 127525], [20, 128165], [23, 128345], [30, 129145], [38, 129425], [42, 129805], [45, 130185], [53, 130785], [56, 130945]]}, {"verse": 19, "start": 131862, "end": 138707, "text": "Y por ellos yo me santifico a mí mismo, para que también ellos sean santificados en verdad.", "words": [[0, 131862], [2, 131979], [6, 132239], [12, 132619], [15, 133259], [18, 133439], [28, 134159], [30, 134179], [33, 134299], [40, 134999], [45, 135419], [49, 135579], [57, 135959], [63, 136379], [68, 136919], [81, 137859], [84, 138059]]}, {"verse": 20, "start": 139057, "end": 145348, "text": "Mas no ruego solamente por estos, sino también por los que han de creer en mí por la palabra de ellos.", "words": [[0, 139057], [4, 139057], [7, 139342], [13, 139722], [23, 140082], [27, 140542], [34, 141422], [39, 141762], [47, 142162], [51, 142482], [55, 142662], [59, 142862], [63, 143022], [66, 143162], [72, 143522], [75, 143642], [78, 143802], [82, 144042], [85, 144182], [93, 144522], [96, 144742]]}, {"verse": 21, "start": 145698, "end": 155509, "text": "Para que todos sean uno; como tú, oh Padre, en mí, y yo en ti, que también ellos sean uno en nosotros: para que el mundo crea que tú me enviaste.", "words": [[0, 145698], [5, 145845], [9, 145965], [15, 146185], [20, 146545], [25, 147219], [30, 147402], [34, 147642], [37, 147882], [44, 148262], [47, 148602], [51, 148822], [53, 149102], [56, 149302], [59, 149482], [63, 149982], [67, 150162], [75, 150522], [81, 150842], [86, 151202], [90, 151602], [93, 151802], [103, 152863], [108, 153067], [112, 153267], [115, 153407], [121, 153667], [126, 154147], [130, 154247], [133, 154467], [136, 154667]]}, {"verse": 22, "start": 155859, "end": 161720, "text": "Y yo, la gloria que me diste les he dado; para que sean uno, como también nosotros somos uno.", "words": [[0, 155859], [2, 155965], [6, 156145], [9, 156305], [16, 156705], [20, 156845], [23, 157005], [29, 157425], [33, 157505], [36, 157705], [42, 158405], [47, 158572], [51, 158732], [56, 159012], [61, 159632], [66, 159812], [74, 160192], [83, 160512], [89, 161032]]}, {"verse": 23, "start": 162070, "end": 172928, "text": "Yo en ellos, y tú en mí, para que sean plenamente uno; que el mundo conozca que tú me enviaste, y que los has amado, como también a mí me has amado.", "words": [[0, 162070], [3, 162577], [6, 162777], [13, 163097], [15, 163437], [18, 163677], [21, 163857], [25, 164077], [30, 164617], [34, 164777], [39, 165077], [50, 165817], [55, 166541], [59, 166663], [62, 166783], [68, 167063], [76, 167683], [80, 167823], [83, 167983], [86, 168123], [96, 168703], [98, 169283], [102, 169403], [106, 169563], [110, 169823], [117, 170523], [122, 170943], [130, 171403], [132, 171683], [135, 171863], [138, 172063], [142, 172283]]}, {"verse": 24, "start": 173278, "end": 185154, "text": "Padre, aquellos que me has dado, quiero que donde yo estoy, ellos estén también conmigo; para que vean mi gloria que me has dado: por cuanto me has amado desde antes de la fundación del mundo.", "words": [[0, 173278], [7, 173722], [16, 173982], [20, 174282], [23, 174422], [27, 174602], [33, 175082], [40, 175282], [44, 175502], [50, 175682], [53, 176022], [60, 176942], [66, 177342], [72, 177822], [80, 178376], [89, 179080], [94, 179410], [98, 179570], [103, 179910], [106, 180090], [113, 180510], [117, 180670], [120, 180830], [124, 181010], [130, 181753], [134, 181877], [141, 182097], [144, 182417], [148, 182577], [154, 183017], [160, 183257], [166, 183557], [169, 183737], [172, 183837], [182, 184357], [186, 184557]]}, {"verse": 25, "start": 185504, "end": 191676, "text": "Padre justo, el mundo no te ha conocido, pero yo te he conocido; y estos han conocido que tú me enviaste;", "words": [[0, 185504], [6, 185884], [13, 186124], [16, 186364], [22, 186724], [25, 186824], [28, 186964], [31, 187044], [41, 187684], [46, 187824], [49, 188044], [52, 188224], [55, 188324], [65, 189269], [67, 189414], [73, 189674], [77, 189934], [86, 190474], [90, 190614], [93, 190774], [96, 190914]]}, {"verse": 26, "start": 192026, "end": 201374, "text": "Y yo les he m