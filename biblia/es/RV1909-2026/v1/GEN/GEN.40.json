{"book": "GEN", "chapter": 40, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 197019, "verses": [{"verse": 1, "start": 300, "end": 9746, "text": "Y aconteció después de estas cosas, que el copero del rey de Egipto y el panadero delinquieron contra su señor el rey de Egipto.", "words": [[0, 300], [2, 445], [12, 1225], [20, 1545], [23, 1785], [29, 1985], [36, 3025], [40, 3145], [43, 3265], [50, 3865], [54, 4105], [58, 4405], [61, 4505], [68, 5065], [70, 5185], [73, 5345], [82, 5885], [95, 6745], [102, 7125], [105, 7405], [111, 7845], [114, 8485], [118, 8905], [121, 9005]]}, {"verse": 2, "start": 10096, "end": 18385, "text": "Y se enojó Faraón contra sus dos eunucos, contra el principal de los coperos, y contra el principal de los panaderos:", "words": [[0, 10096], [2, 10240], [5, 10440], [11, 10980], [18, 11580], [25, 11960], [29, 12300], [33, 12560], [42, 13780], [49, 14240], [52, 14420], [62, 14840], [65, 15180], [69, 15300], [78, 15780], [80, 16200], [87, 16560], [90, 16720], [100, 17160], [103, 17460], [107, 17580]]}, {"verse": 3, "start": 18735, "end": 26148, "text": "Y los puso en prisión en la casa del capitán de los de la guardia, en la casa de la cárcel donde José estaba preso.", "words": [[0, 18735], [2, 18859], [6, 18959], [11, 19359], [14, 19499], [22, 19959], [25, 20179], [28, 20299], [33, 20539], [37, 20759], [45, 21299], [48, 21439], [52, 21579], [55, 21839], [58, 21979], [67, 22939], [70, 23039], [73, 23159], [78, 23419], [81, 23599], [84, 23719], [91, 24179], [97, 24739], [102, 25099], [109, 25499]]}, {"verse": 4, "start": 26498, "end": 34167, "text": "Y el capitán de los de la guardia dio cargo de ellos a José, y él les servía: y estuvieron días en la prisión.", "words": [[0, 26498], [2, 26621], [5, 26701], [13, 27221], [16, 27341], [20, 27481], [23, 27581], [26, 27701], [34, 28101], [38, 28321], [44, 28661], [47, 28901], [53, 29121], [55, 29361], [61, 29721], [63, 30381], [66, 30631], [70, 30881], [78, 31824], [80, 32048], [91, 32508], [96, 32888], [99, 33348], [102, 33488]]}, {"verse": 5, "start": 34517, "end": 48006, "text": "Y ambos, el copero y el panadero del rey de Egipto, que estaban arrestados en la prisión, vieron un sueño, cada uno su sueño en una misma noche, cada uno conforme a la interpretación de su sueño.", "words": [[0, 34517], [2, 34676], [9, 34956], [12, 35176], [19, 35636], [21, 35776], [24, 35916], [33, 36456], [37, 36616], [41, 36956], [44, 37056], [52, 37656], [56, 37736], [64, 38016], [75, 38921], [78, 39141], [81, 39281], [90, 40221], [97, 40641], [100, 40841], [107, 41601], [112, 41881], [116, 42201], [119, 42441], [125, 43001], [128, 43281], [132, 43441], [138, 43681], [145, 44478], [150, 44662], [154, 44942], [163, 45722], [165, 45822], [168, 45902], [183, 47002], [186, 47222], [189, 47382]]}, {"verse": 6, "start": 48356, "end": 53711, "text": "Y vino a ellos José por la mañana, y los miró, y he aquí que estaban tristes.", "words": [[0, 48356], [2, 48479], [7, 48739], [9, 48919], [15, 49179], [20, 49579], [24, 49839], [27, 49979], [35, 50399], [37, 50859], [41, 51019], [47, 51819], [49, 52039], [52, 52179], [57, 52439], [61, 52579], [69, 52859]]}, {"verse": 7, "start": 54061, "end": 64171, "text": "Y él preguntó a aquellos oficiales de Faraón, que estaban con él en la prisión de la casa de su señor, diciendo: ¿Por qué tenéis hoy tan mala cara?", "words": [[0, 54061], [2, 54287], [5, 54527], [14, 55347], [16, 55567], [25, 55907], [35, 56827], [38, 57197], [46, 57567], [50, 58107], [58, 58387], [62, 58687], [65, 58867], [68, 59107], [71, 59397], [79, 59687], [82, 59827], [85, 59947], [90, 60187], [93, 60407], [96, 60567], [103, 60987], [113, 62221], [118, 62363], [122, 62563], [129, 63003], [133, 63203], [137, 63403], [142, 63663]]}, {"verse": 8, "start": 64451, "end": 75262, "text": "Y ellos le dijeron: Hemos tenido un sueño, y no hay quien lo interprete. Entonces les dijo José: ¿No son de Dios las interpretaciones? Contádmelo ahora.", "words": [[0, 64451], [2, 64634], [8, 64834], [11, 65014], [20, 65921], [26, 66114], [33, 66414], [36, 66654], [43, 67454], [45, 67634], [48, 67834], [52, 68054], [58, 68354], [61, 68574], [73, 69711], [82, 70278], [86, 70678], [91, 70998], [97, 71666], [101, 71847], [105, 72107], [108, 72267], [113, 72467], [117, 72667], [135, 74163], [146, 74741]]}, {"verse": 9, "start": 75542, "end": 83051, "text": "Entonces el principal de los coperos contó su sueño a José, y le dijo: Yo soñaba que veía una vid delante de mí,", "words": [[0, 75542], [9, 76625], [12, 76725], [22, 77265], [25, 77565], [29, 77665], [37, 78125], [43, 78625], [46, 78785], [52, 79165], [54, 79285], [60, 79565], [62, 79825], [65, 79945], [71, 80686], [74, 80791], [81, 81211], [85, 81371], [90, 81711], [94, 81871], [98, 82071], [106, 82531], [109, 82711]]}, {"verse": 10, "start": 83401, "end": 90210, "text": "Y en la vid tres ramas; y ella como que brotaba, y arrojaba su flor, viniendo a madurar sus racimos de uvas:", "words": [[0, 83401], [2, 83519], [5, 83619], [8, 83789], [12, 83959], [17, 84319], [24, 85194], [26, 85356], [31, 85556], [36, 85876], [40, 86196], [49, 86516], [51, 86656], [60, 87096], [63, 87256], [69, 87596], [78, 88316], [80, 88376], [88, 88756], [92, 88996], [100, 89496], [103, 89696]]}, {"verse": 11, "start": 90560, "end": 99063, "text": "Y que la copa de Faraón estaba en mi mano, y tomaba yo las uvas, y las exprimía en la copa de Faraón, y daba yo la copa en mano de Faraón.", "words": [[0, 90560], [2, 90665], [6, 90765], [9, 90905], [14, 91225], [17, 91305], [24, 91765], [31, 92065], [34, 92265], [37, 92385], [43, 92685], [45, 93305], [52, 93665], [55, 93845], [59, 93985], [65, 94465], [67, 94725], [71, 94885], [80, 95545], [83, 95645], [86, 95745], [91, 96045], [94, 96125], [102, 97015], [104, 97122], [109, 97362], [112, 97482], [115, 97622], [120, 97982], [123, 98082], [128, 98302], [131, 98707]]}, {"verse": 12, "start": 99343, "end": 104191, "text": "Y le dijo José: Esta es su interpretación: Los tres sarmientos son tres días:", "words": [[0, 99343], [2, 99504], [5, 99674], [10, 99844], [16, 100628], [21, 100928], [24, 101128], [27, 101268], [43, 102479], [47, 102581], [52, 102951], [63, 103321], [67, 103541], [72, 103761]]}, {"verse": 13, "start": 104541, "end": 113384, "text": "Al cabo de tres días Faraón te hará levantar cabeza, y te restituirá a tu puesto: y darás la copa a Faraón en su mano, como solías cuando eras su copero.", "words": [[0, 104541], [3, 104683], [8, 104883], [11, 105063], [16, 105283], [21, 105683], [28, 106083], [31, 106203], [36, 106363], [45, 106843], [53, 107263], [55, 107683], [58, 107823], [69, 108503], [71, 108563], [74, 108683], [82, 109449], [84, 109553], [90, 109833], [93, 109953], [98, 110113], [100, 110273], [107, 110653], [110, 110773], [113, 110893], [119, 111593], [124, 111753], [131, 112193], [138, 112433], [143, 112793], [146, 112933]]}, {"verse": 14, "start": 113734, "end": 121859, "text": "Acuérdate de mí cuando te vaya bien, y te ruego que uses conmigo de misericordia, y hagas mención de mí a Faraón, y me saques de esta casa:", "words": [[0, 113734], [10, 114192], [13, 114452], [16, 114572], [23, 114812], [26, 115072], [31, 115292], [37, 115632], [39, 115807], [42, 115997], [48, 116187], [52, 116407], [57, 116667], [65, 117207], [68, 117347], [82, 118187], [84, 118487], [90, 118787], [98, 119187], [101, 119347], [104, 119527], [106, 119837], [114, 120147], [116, 120487], [119, 120627], [126, 120967], [129, 121167], [134, 121347]]}, {"verse": 15, "start": 122209, "end": 128259, "text": "Porque fui secuestrado de la tierra de los hebreos; y tampoco he hecho aquí motivo para que me pusieran en la cárcel.", "words": [[0, 122209], [7, 122389], [11, 122589], [23, 123309], [26, 123429], [29, 123529], [36, 123809], [39, 123989], [43, 124089], [52, 125035], [54, 125140], [62, 125400], [65, 125700], [71, 125900], [76, 126060], [83, 126500], [88, 126800], [92, 126920], [95, 127040], [104, 127460], [107, 127600], [110, 127720]]}, {"verse": 16, "start": 128539, "end": 138439, "text": "Y viendo el principal de los panaderos que había interpretado para bien, dijo a José: También yo soñaba que veía tres canastillos blancos sobre mi cabeza;", "words": [[0, 128539], [2, 128644], [9, 128944], [12, 129104], [22, 129684], [25, 129964], [29, 130064], [39, 130664], [43, 130764], [49, 131024], [62, 131924], [67, 132144], [73, 133184], [78, 133564], [80, 133784], [86, 134432], [94, 134731], [97, 134931], [104, 135391], [108, 135591], [113, 136011], [118, 136231], [130, 136911], [138, 137471], [144, 137671], [147, 137851]]}, {"verse": 17, "start": 138789, "end": 146036, "text": "En la canasta más alta había toda clase de panes y pasteles para Faraón, y las aves los comían de la canasta que estaba sobre mi cabeza.", "words": [[0, 138789], [3, 138900], [6, 138980], [14, 139380], [18, 139560], [23, 139880], [29, 140120], [34, 140380], [40, 140740], [43, 140900], [49, 141300], [51, 141380], [60, 141820], [65, 142060], [73, 142600], [75, 142880], [79, 143040], [84, 143360], [88, 143460], [95, 143880], [98, 144020], [101, 144140], [109, 144560], [113, 144760], [120, 145040], [126, 145320], [129, 145480]]}, {"verse": 18, "start": 146316, "end": 153143, "text": "Entonces respondió José, y dijo: Esta es su interpretación: Los tres canastillos tres días son;", "words": [[0, 146316], [9, 147236], [19, 147756], [25, 148156], [27, 148516], [33, 149238], [38, 149538], [41, 149738], [44, 149878], [60, 151090], [64, 151211], [69, 151451], [81, 152111], [86, 152391], [91, 152691]]}, {"verse": 19, "start": 153493, "end": 161211, "text": "Al cabo de tres días quitará Faraón tu cabeza de sobre ti, y te hará colgar en la horca, y las aves comerán tu carne de sobre ti.", "words": [[0, 153493], [3, 153651], [8, 153871], [11, 154071], [16, 154331], [21, 154591], [29, 155111], [36, 155571], [39, 155731], [46, 156091], [49, 156331], [55, 156571], [59, 156851], [61, 157391], [64, 157551], [69, 157751], [76, 158091], [79, 158231], [82, 158491], [89, 158751], [91, 158938], [95, 159124], [100, 159311], [108, 159791], [111, 159951], [117, 160211], [120, 160411], [126, 160631]]}, {"verse": 20, "start": 161491, "end": 177593, "text": "Y fue el tercero día el día del nacimiento de Faraón, e hizo banquete a todos sus sirvientes: y alzó la cabeza del principal de los coperos, y la cabeza del principal de los panaderos, entre sus servidores.", "words": [[0, 161491], [2, 161632], [6, 161852], [9, 162152], [17, 162792], [21, 163312], [24, 163312], [28, 163552], [32, 163792], [43, 164432], [46, 164739], [54, 165045], [56, 165352], [61, 166172], [70, 167132], [72, 167432], [78, 167712], [82, 168172], [94, 169505], [96, 169655], [101, 170075], [104, 170195], [111, 170575], [115, 170875], [125, 171495], [128, 171775], [132, 171875], [141, 172415], [143, 172935], [146, 173055], [153, 173455], [157, 173715], [167, 174455], [170, 174715], [174, 174835], [185, 175555], [191, 176155], [195, 176495]]}, {"verse": 21, "start": 177943, "end": 185046, "text": "E hizo volver a su oficio al principal de los coperos; y dio él la copa en mano de Faraón.", "words": [[0, 177943], [2, 178362], [7, 178642], [14, 179022], [16, 179182], [19, 179382], [26, 179902], [29, 180202], [39, 180882], [42, 181262], [46, 181382], [55, 182329], [57, 182523], [61, 182753], [64, 183013], [67, 183193], [72, 183673], [75, 183793], [80, 184053], [83, 184573]]}, {"verse": 22, "start": 185396, "end": 191168, "text": "Mas hizo ahorcar al principal de los panaderos, como le había interpretado José.", "words": [[0, 185396], [4, 185561], [9, 185921], [17, 186701], [20, 186981], [30, 187541], [33, 187881], [37, 188001], [48, 189001], [53, 189281], [56, 189441], [62, 189721], [75, 190561]]}, {"verse": 23, "start": 191518, "end": 196619, "text": "Y el principal de los coperos no se acordó de José, sino que le olvidó.", "words": [[0, 191518], [2, 191682], [5, 191822], [15, 192442], [18, 192722], [22, 192902], [30, 193442], [33, 193982], [36, 194182], [43, 194722], [46, 194822], [52, 195082], [57, 195542], [61, 195762], [64, 195922]]}]}