{"book": "PSA", "chapter": 39, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 100984, "verses": [{"verse": 1, "start": 300, "end": 13606, "text": "Al Músico principal, a Jedutún: Salmo de David. YO DIJE: Atenderé a mis caminos, para no pecar con mi lengua: guardaré mi boca con freno, en tanto que el impío esté contra mí.", "words": [[0, 300], [3, 446], [10, 946], [21, 1552], [23, 2158], [32, 2921], [38, 3405], [41, 3585], [48, 4546], [51, 4787], [57, 5188], [66, 5848], [68, 5908], [72, 6028], [81, 6608], [86, 7128], [89, 7328], [95, 7868], [99, 8108], [102, 8328], [110, 9154], [119, 9622], [122, 9822], [127, 10082], [131, 10342], [138, 11062], [141, 11362], [147, 11662], [151, 11922], [154, 12262], [160, 12602], [165, 12842], [172, 13182]]}, {"verse": 2, "start": 13956, "end": 19951, "text": "Enmudecí con silencio, me callé aun respecto de lo bueno: y se excitó mi dolor.", "words": [[0, 14302], [9, 14682], [13, 14842], [23, 15482], [26, 15662], [32, 16102], [36, 16542], [45, 16982], [48, 17282], [51, 17422], [58, 18180], [60, 18347], [63, 18467], [70, 19267], [73, 19367]]}, {"verse": 3, "start": 20301, "end": 28616, "text": "Se enardeció mi corazón dentro de mí; en mi meditación se encendió fuego, y así proferí con mi lengua:", "words": [[0, 20301], [3, 20744], [13, 21224], [16, 21384], [24, 21824], [31, 22204], [34, 22524], [38, 23087], [41, 23367], [44, 23547], [55, 24267], [58, 24467], [67, 25067], [74, 26047], [76, 26127], [80, 26307], [88, 26967], [92, 27147], [95, 27327]]}, {"verse": 4, "start": 28966, "end": 37000, "text": "Hazme saber, Jehová, mi fin, y cuánta sea la medida de mis días; sepa yo cuánto tengo de ser del mundo.", "words": [[0, 28966], [6, 29390], [13, 29950], [21, 30510], [24, 30610], [29, 31410], [31, 31490], [38, 31990], [42, 32290], [45, 32510], [52, 32910], [55, 33170], [59, 33330], [65, 34608], [70, 34868], [73, 34988], [80, 35468], [86, 35707], [89, 35887], [93, 36148], [97, 36308]]}, {"verse": 5, "start": 37350, "end": 47295, "text": "He aquí diste a mis días término corto, y mi edad es como nada delante de ti: ciertamente es completa vanidad todo hombre que vive. (Selah.)", "words": [[0, 37350], [3, 37590], [8, 37864], [14, 38137], [16, 38237], [20, 38337], [25, 38557], [33, 39177], [40, 39957], [42, 40157], [45, 40337], [50, 40757], [53, 40957], [58, 41197], [63, 41537], [71, 42077], [74, 42257], [78, 42843], [90, 43587], [93, 43747], [102, 44207], [110, 44727], [115, 44987], [122, 45367], [126, 45587], [132, 47084]]}, {"verse": 6, "start": 47645, "end": 56018, "text": "Ciertamente en tinieblas anda el hombre; ciertamente en vano se afana: amontona riquezas y no sabe quién las recogerá.", "words": [[0, 47645], [12, 48355], [15, 48515], [25, 49175], [30, 49515], [33, 49755], [41, 50482], [53, 51329], [56, 51489], [61, 51789], [64, 51909], [71, 52834], [80, 53285], [89, 53771], [91, 54258], [94, 54418], [99, 54698], [105, 54938], [109, 55158]]}, {"verse": 7, "start": 56368, "end": 60617, "text": "Y ahora, Señor, ¿qué esperaré? Mi esperanza en ti está.", "words": [[0, 56368], [2, 56628], [9, 56868], [16, 57728], [21, 57828], [31, 58990], [34, 59101], [44, 59601], [47, 59801], [50, 59961]]}, {"verse": 8, "start": 60967, "end": 66105, "text": "Líbrame de todas mis rebeliones; no me pongas por burla del insensato.", "words": [[0, 60967], [8, 61503], [11, 61723], [17, 61923], [21, 62263], [33, 63563], [36, 63690], [39, 63830], [46, 64250], [50, 64490], [56, 64870], [60, 65090]]}, {"verse": 9, "start": 66455, "end": 69819, "text": "Enmudecí, no abrí mi boca; porque tú lo hiciste.", "words": [[0, 66812], [10, 67202], [13, 67662], [18, 67982], [21, 68122], [27, 68796], [34, 68980], [37, 69220], [40, 69380]]}, {"verse": 10, "start": 70169, "end": 74782, "text": "Quita de sobre mí tu plaga; de la guerra de tu mano soy consumido.", "words": [[0, 70169], [6, 70863], [9, 71003], [15, 71243], [18, 71483], [21, 71623], [28, 72448], [31, 72574], [34, 72694], [41, 72954], [44, 73174], [47, 73334], [52, 73574], [56, 73834]]}, {"verse": 11, "start": 75132, "end": 84983, "text": "Con castigos sobre el pecado corriges al hombre, y haces consumirse como de polilla su grandeza: ciertamente vanidad es todo hombre. (Selah.)", "words": [[0, 75132], [4, 75448], [13, 75798], [19, 76138], [22, 76338], [29, 76868], [38, 77398], [41, 77578], [49, 77878], [51, 78398], [57, 78698], [68, 79538], [73, 79838], [76, 80018], [84, 80518], [87, 80718], [97, 81758], [109, 82608], [117, 83088], [120, 83308], [125, 83488], [133, 84701]]}, {"verse": 12, "start": 85333, "end": 96421, "text": "Oye mi oración, oh Jehová, y escucha mi clamor: no calles a mis lágrimas; porque forastero soy para ti, y advenedizo, como todos mis padres.", "words": [[0, 85333], [4, 85658], [7, 85818], [16, 86331], [19, 86845], [27, 87358], [29, 87638], [37, 88138], [40, 88484], [48, 89022], [51, 89338], [58, 89688], [60, 89828], [64, 89948], [74, 91126], [81, 91782], [91, 92472], [95, 92732], [100, 93032], [104, 93332], [106, 93832], [118, 94672], [123, 95192], [129, 95512], [133, 95752]]}, {"verse": 13, "start": 96771, "end": 100584, "text": "Déjame, y tomaré fuerzas, antes que vaya y perezca.", "words": [[0, 96771], [8, 97358], [10, 97778], [17, 98158], [26, 98878], [32, 99298], [36, 99538], [41, 99887], [43, 100235]]}]}