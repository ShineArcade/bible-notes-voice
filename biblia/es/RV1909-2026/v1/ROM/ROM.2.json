{"book": "ROM", "chapter": 2, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 204135, "verses": [{"verse": 1, "start": 300, "end": 9802, "text": "Por lo cual eres inexcusable, oh hombre, cualquiera que juzgas: porque en lo que juzgas a otro, te condenas a ti mismo; porque lo mismo haces, tú que juzgas.", "words": [[0, 300], [4, 428], [7, 548], [12, 808], [17, 1028], [30, 1598], [33, 2168], [41, 2728], [52, 3148], [56, 3328], [64, 4269], [71, 4527], [74, 4687], [77, 4787], [81, 4887], [88, 5307], [90, 5487], [96, 5727], [99, 5967], [108, 6527], [110, 6667], [113, 6727], [120, 7579], [127, 7765], [130, 7945], [136, 8165], [143, 8725], [146, 8985], [150, 9165]]}, {"verse": 2, "start": 10252, "end": 14732, "text": "Pero sabemos que el juicio de Dios es según verdad contra los que hacen tales cosas.", "words": [[0, 10252], [5, 10389], [13, 10749], [17, 11029], [20, 11109], [27, 11449], [30, 11589], [35, 11869], [38, 12289], [44, 12529], [51, 12889], [58, 13269], [62, 13449], [66, 13609], [72, 13849], [78, 14109]]}, {"verse": 3, "start": 15182, "end": 23326, "text": "¿Y piensas esto, oh hombre, que juzgas a los que hacen tales cosas, y haces las mismas, que tú escaparás del juicio de Dios?", "words": [[0, 15182], [3, 15310], [11, 15830], [17, 16170], [20, 16510], [28, 17030], [32, 17130], [39, 17650], [41, 17870], [45, 18010], [49, 18150], [55, 18410], [61, 18770], [68, 19250], [70, 19890], [76, 20170], [80, 20350], [88, 21090], [92, 21290], [95, 21470], [105, 22110], [109, 22230], [116, 22650], [119, 22830]]}, {"verse": 4, "start": 23776, "end": 31492, "text": "¿O menosprecias las riquezas de su bondad, y tolerancia, y paciencia, ignorando que su bondad te guía a arrepentimiento?", "words": [[0, 23776], [3, 23900], [16, 24660], [20, 25030], [29, 25400], [32, 25680], [35, 25960], [43, 26240], [45, 26680], [57, 27380], [59, 27620], [70, 28600], [80, 29200], [84, 29440], [87, 29680], [94, 29920], [97, 30040], [102, 30200], [104, 30360]]}, {"verse": 5, "start": 31942, "end": 40795, "text": "Pero por tu dureza, y por tu corazón no arrepentido, atesoras para ti mismo ira para el día de la ira y de la manifestación del justo juicio de Dios;", "words": [[0, 31942], [5, 32101], [9, 32281], [12, 32421], [20, 32921], [22, 33061], [26, 33241], [29, 33381], [37, 33741], [40, 34414], [53, 35088], [62, 35761], [67, 36041], [70, 36262], [76, 36541], [80, 36921], [85, 37122], [88, 37302], [92, 37482], [95, 37622], [98, 37781], [102, 38081], [104, 38162], [107, 38281], [110, 38381], [124, 39141], [128, 39321], [134, 39622], [141, 40041], [144, 40221]]}, {"verse": 6, "start": 41245, "end": 44047, "text": "El cual pagará a cada uno conforme a sus obras:", "words": [[0, 41245], [3, 41365], [8, 41565], [15, 42065], [17, 42165], [22, 42305], [26, 42605], [35, 43245], [37, 43285], [41, 43405]]}, {"verse": 7, "start": 44497, "end": 49554, "text": "A los que perseverando en bien hacer, buscan gloria y honra e inmortalidad, la vida eterna.", "words": [[0, 44497], [2, 44583], [6, 44683], [10, 44803], [23, 45483], [26, 45716], [31, 45950], [38, 46183], [45, 46663], [52, 47163], [54, 47323], [60, 47723], [62, 48123], [76, 48523], [79, 48763], [84, 48943]]}, {"verse": 8, "start": 50004, "end": 56979, "text": "Pero a los que son contenciosos, y no obedecen a la verdad, antes obedecen a la injusticia, enojo e ira;", "words": [[0, 50004], [5, 50164], [7, 50324], [11, 50484], [15, 50604], [19, 50804], [33, 51824], [35, 52004], [38, 52184], [47, 52764], [49, 52844], [52, 52904], [60, 54144], [66, 54504], [75, 54864], [77, 54924], [80, 55024], [92, 55714], [98, 56404], [100, 56564]]}, {"verse": 9, "start": 57429, "end": 63978, "text": "Tribulación y angustia sobre toda persona humana que obra lo malo, el judío primeramente, y también el griego:", "words": [[0, 57429], [12, 58064], [14, 58204], [23, 58784], [29, 58984], [34, 59204], [42, 59644], [49, 60164], [53, 60284], [58, 60504], [61, 60664], [67, 61504], [70, 61544], [76, 61924], [90, 62644], [92, 63064], [100, 63304], [103, 63504]]}, {"verse": 10, "start": 64428, "end": 69971, "text": "Pero gloria y honra y paz a cualquiera que obra el bien, al judío primeramente, y también al griego.", "words": [[0, 64428], [5, 64587], [12, 64967], [14, 65107], [20, 65507], [22, 65737], [26, 65967], [28, 66067], [39, 66507], [43, 66687], [48, 66887], [51, 67047], [57, 67567], [60, 67667], [66, 68087], [80, 68827], [82, 69067], [90, 69307], [93, 69507]]}, {"verse": 11, "start": 70421, "end": 72568, "text": "Porque Dios no muestra favoritismo.", "words": [[0, 70421], [7, 70599], [12, 70899], [15, 71159], [23, 71539]]}, {"verse": 12, "start": 73018, "end": 80600, "text": "Porque todos los que sin ley pecaron, sin ley también perecerán; y todos los que en la ley pecaron, por la ley serán juzgados:", "words": [[0, 73018], [7, 73176], [13, 73496], [17, 73776], [21, 73976], [25, 74196], [29, 74396], [38, 75136], [42, 75296], [46, 75536], [54, 75976], [65, 77036], [67, 77155], [73, 77395], [77, 77655], [81, 77875], [84, 77975], [87, 78055], [91, 78255], [100, 78755], [104, 79015], [107, 79155], [111, 79315], [117, 79635]]}, {"verse": 13, "start": 81050, "end": 87842, "text": "Porque no los oyentes de la ley son justos para con Dios, sino que los hacedores de la ley serán justificados.", "words": [[0, 81050], [7, 81260], [10, 81460], [14, 81620], [22, 82040], [25, 82260], [28, 82400], [32, 82620], [36, 82840], [43, 83400], [48, 83600], [52, 83860], [58, 84600], [63, 84940], [67, 85160], [71, 85340], [81, 85980], [84, 86120], [87, 86260], [91, 86480], [97, 86800]]}, {"verse": 14, "start": 88292, "end": 96873, "text": "Porque los Gentiles que no tienen ley, naturalmente haciendo lo que es de la ley, los tales, aunque no tengan ley, ellos son ley a sí mismos:", "words": [[0, 88292], [7, 88472], [11, 88632], [20, 89112], [24, 89332], [27, 89492], [34, 89772], [39, 90372], [52, 91192], [61, 91532], [64, 91792], [68, 91932], [71, 92092], [74, 92212], [77, 92372], [82, 93012], [86, 93152], [93, 93812], [100, 93992], [103, 94212], [110, 94512], [115, 95232], [121, 95452], [125, 95712], [129, 95972], [131, 96072], [134, 96192]]}, {"verse": 15, "start": 97323, "end": 108291, "text": "Mostrando la obra de la ley escrita en sus corazones, dando testimonio juntamente sus conciencias, y acusándose y también excusándose sus pensamientos unos con otros;", "words": [[0, 97323], [10, 97801], [13, 97961], [18, 98181], [21, 98321], [24, 98441], [28, 98661], [36, 99181], [39, 99261], [43, 99421], [54, 100641], [60, 100821], [71, 101561], [82, 102101], [86, 102361], [99, 103501], [101, 103781], [112, 104521], [114, 104641], [122, 104861], [134, 105681], [138, 105901], [151, 106581], [156, 106901], [160, 107181]]}, {"verse": 16, "start": 108741, "end": 114954, "text": "En el día que juzgará el Señor lo encubierto de los hombres, conforme a mi evangelio, por Jesucristo.", "words": [[0, 108741], [3, 108866], [6, 108966], [10, 109206], [14, 109386], [22, 109906], [25, 110026], [31, 110346], [34, 110626], [45, 111206], [48, 111346], [52, 111466], [61, 112246], [70, 112906], [72, 112986], [75, 113066], [86, 113826], [90, 114146]]}, {"verse": 17, "start": 115404, "end": 120729, "text": "He aquí, tú llevas el nombre de judío, y descansas en la ley, y te glorías en Dios,", "words": [[0, 115404], [3, 115531], [9, 115831], [12, 116051], [19, 116451], [22, 116551], [29, 116791], [32, 116951], [39, 117531], [41, 117871], [51, 118531], [54, 118671], [57, 118791], [62, 119091], [64, 119531], [67, 119651], [75, 120051], [78, 120251]]}, {"verse": 18, "start": 121179, "end": 124994, "text": "Y sabes su voluntad, y apruebas lo mejor, instruido por la ley;", "words": [[0, 121179], [2, 121308], [8, 121478], [11, 121678], [21, 122318], [23, 122478], [32, 122898], [35, 123038], [42, 123378], [52, 124258], [56, 124458], [59, 124578]]}, {"verse": 19, "start": 125444, "end": 130296, "text": "Y confías en que eres guía de los ciegos, luz de los que están en tinieblas,", "words": [[0, 125444], [2, 125535], [10, 126055], [13, 126255], [17, 126415], [22, 126655], [27, 127095], [30, 127215], [34, 127335], [42, 128335], [46, 128615], [49, 128835], [53, 128955], [57, 129095], [63, 129335], [66, 129555]]}, {"verse": 20, "start": 130746, "end": 136769, "text": "Instructor de los que no saben, maestro de niños, que tienes la forma del conocimiento y de la verdad en la ley:", "words": [[0, 131046], [11, 131376], [14, 131476], [18, 131596], [22, 131756], [25, 131876], [32, 132256], [40, 132696], [43, 132836], [50, 133416], [54, 133616], [61, 133836], [64, 134016], [70, 134276], [74, 134456], [87, 135296], [89, 135536], [92, 135616], [95, 135716], [102, 135996], [105, 136316], [108, 136416]]}, {"verse": 21, "start": 137219, "end": 143496, "text": "Tú pues, que enseñas a otro, ¿no te enseñas a ti mismo? ¿Tú, que predicas que no se ha de hurtar, hurtas?", "words": [[0, 137219], [3, 137343], [9, 137683], [13, 137863], [21, 138303], [23, 138423], [29, 139083], [33, 139203], [36, 139343], [44, 139803], [46, 139903], [49, 139983], [56, 140826], [61, 140923], [65, 141043], [74, 141623], [78, 141743], [81, 141876], [84, 142010], [87, 142143], [90, 142613], [98, 143083]]}, {"verse": 22, "start": 143946, "end": 149715, "text": "¿Tú, que dices que no se ha de adulterar, adulteras? ¿Tú, que abominas los ídolos, cometes sacrilegio?", "words": [[0, 143946], [5, 144022], [9, 144142], [15, 144442], [19, 144622], [22, 144802], [25, 145002], [28, 145122], [31, 145202], [42, 145862], [53, 146935], [58, 147055], [62, 147155], [71, 147655], [75, 147815], [83, 148315], [91, 148815]]}, {"verse": 23, "start": 150165, "end": 154548, "text": "¿Tú, que te jactas de la ley, con infracción de la ley deshonras a Dios?", "words": [[0, 150165], [5, 150323], [9, 150443], [12, 150603], [19, 151103], [22, 151223], [25, 151383], [30, 151643], [34, 151943], [45, 152623], [48, 152783], [51, 152923], [55, 153163], [65, 153883], [67, 154043]]}, {"verse": 24, "start": 154998, "end": 160778, "text": "Porque el nombre de Dios es blasfemado por causa de vosotros entre los Gentiles, como está escrito.", "words": [[0, 154998], [7, 155220], [10, 155360], [17, 155620], [20, 155800], [25, 156100], [28, 156440], [39, 157180], [43, 157380], [49, 157620], [52, 157900], [61, 158340], [67, 158640], [71, 158820], [81, 159400], [86, 159920], [91, 160160]]}, {"verse": 25, "start": 161228, "end": 169706, "text": "Porque la circuncisión en verdad aprovecha, si guardas la ley; pero si eres rebelde a la ley, tu circuncisión es hecha incircuncisión.", "words": [[0, 161228], [7, 161436], [10, 161636], [23, 162456], [26, 162556], [33, 162816], [44, 163596], [47, 163816], [55, 164236], [58, 164356], [63, 164989], [68, 165111], [71, 165311], [76, 165531], [84, 166071], [86, 166131], [89, 166231], [94, 166811], [97, 166931], [110, 167791], [113, 168091], [119, 168926]]}, {"verse": 26, "start": 170156, "end": 176575, "text": "De manera que, si el incircunciso guardare las ordenanzas de la ley, ¿no será tenida su incircuncisión por circuncisión?", "words": [[0, 170156], [3, 170252], [10, 170472], [15, 170732], [18, 170892], [21, 170972], [34, 171712], [43, 172152], [47, 172292], [58, 172952], [61, 173052], [64, 173172], [69, 173712], [73, 173832], [78, 174012], [85, 174412], [88, 174572], [103, 175352], [107, 175552]]}, {"verse": 27, "start": 177025, "end": 186190, "text": "Y el que no está circuncidado físicamente, pero guarda perfectamente la ley, te juzgará a ti, que con la letra y con la circuncisión eres rebelde a la ley.", "words": [[0, 177025], [2, 177184], [5, 177304], [9, 177424], [12, 177564], [17, 177784], [30, 178644], [43, 179644], [48, 179944], [55, 180344], [69, 181104], [72, 181264], [77, 181824], [80, 181964], [88, 182484], [90, 182624], [94, 182744], [98, 183144], [102, 183324], [105, 183464], [111, 183804], [113, 183864], [117, 183964], [120, 184064], [133, 184844], [138, 185104], [146, 185684], [148, 185764], [151, 185824]]}, {"verse": 28, "start": 186640, "end": 192936, "text": "Porque no es judío el que lo es exteriormente; ni la circuncisión es la que es exteriormente en la carne:", "words": [[0, 186640], [7, 186820], [10, 187000], [13, 187180], [19, 187560], [22, 187700], [26, 187820], [29, 187960], [32, 188120], [47, 189418], [50, 189567], [53, 189707], [66, 190727], [69, 191007], [72, 191107], [76, 191267], [79, 191427], [93, 192167], [96, 192287], [99, 192407]]}, {"verse": 29, "start": 193386, "end": 203735, "text": "Pero es judío el que lo es en lo interior; y la circuncisión es la del corazón, en espíritu, no en letra; la alabanza del cual no es de los hombres, sino de Dios.", "words": [[0, 193386], [5, 193525], [8, 193725], [14, 193985], [17, 194245], [21, 194365], [24, 194545], [27, 194785], [30, 195005], [33, 195105], [43, 196006], [45, 196099], [48, 196199], [61, 197179], [64, 197379], [67, 197559], [71, 197739], [80, 198639], [83, 198839], [93, 199759], [96, 199839], [99, 199979], [106, 200728], [109, 200854], [118, 201414], [122, 201554], [127, 201774], [130, 202014], [133, 202114], [136, 202234], [140, 202354], [149, 202714], [154, 203014], [157, 203214]]}]}