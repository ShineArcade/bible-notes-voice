{"book": "GEN", "chapter": 14, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 245771, "verses": [{"verse": 1, "start": 300, "end": 13060, "text": "Y aconteció en los días de Amrafel, rey de Sinar, Arioc, rey de Elasar, Quedorlaomer, rey de Elá, y Tidal, rey de naciones,", "words": [[0, 300], [2, 466], [12, 1266], [15, 1466], [19, 1566], [24, 1786], [27, 1946], [36, 3066], [40, 3426], [43, 3546], [50, 4346], [57, 5266], [61, 5806], [64, 6746], [72, 7686], [86, 8626], [90, 9226], [93, 9386], [98, 9946], [100, 10486], [107, 11346], [111, 11926], [114, 12086]]}, {"verse": 2, "start": 13510, "end": 31108, "text": "Que estos hicieron guerra contra Bera, rey de Sodoma, y contra Birsa, rey de Gomorra, y contra Sinab, rey de Adma, y contra Semeber, rey de Zeboim, y contra el rey de Bela, la cual es Zoar.", "words": [[0, 13510], [4, 13634], [10, 13994], [19, 14714], [26, 15134], [33, 16014], [39, 16894], [43, 17154], [46, 17234], [54, 18394], [56, 18414], [63, 19064], [70, 19714], [74, 20014], [77, 20114], [86, 21354], [88, 21374], [95, 21694], [102, 22614], [106, 23154], [109, 23274], [115, 24474], [117, 24494], [124, 25314], [133, 26134], [137, 26794], [140, 27383], [148, 28273], [150, 28397], [157, 28697], [160, 28937], [164, 29257], [167, 29577], [173, 29897], [176, 30137], [181, 30377], [184, 30773]]}, {"verse": 3, "start": 31558, "end": 36445, "text": "Todos estos se juntaron en el valle de Siddim, que es el mar salado.", "words": [[0, 31558], [6, 31801], [12, 32201], [15, 32501], [24, 33121], [27, 33301], [30, 33481], [36, 33741], [39, 34261], [47, 34781], [51, 35001], [54, 35201], [57, 35361], [61, 35661]]}, {"verse": 4, "start": 36895, "end": 43741, "text": "Doce años habían servido a Quedorlaomer, y al décimotercio año se rebelaron.", "words": [[0, 37042], [5, 37222], [10, 37742], [17, 38222], [25, 38922], [27, 39492], [41, 40062], [43, 40802], [46, 41462], [59, 42122], [63, 42442], [66, 43124]]}, {"verse": 5, "start": 44191, "end": 58874, "text": "Y en el año decimocuarto vino Quedorlaomer, y los reyes que estaban de su parte, y derrotaron a los refaítas en Astarot Karnaim, a los zuzitas en Ham, y a los emitas en Save-quiriataim.", "words": [[0, 44191], [2, 44316], [5, 44456], [8, 44576], [12, 45056], [25, 45536], [30, 46676], [44, 47816], [46, 47976], [50, 48296], [56, 48616], [60, 48696], [68, 49036], [71, 49236], [74, 49356], [81, 49736], [83, 50236], [94, 51036], [96, 51276], [100, 51746], [109, 52216], [112, 52842], [120, 53469], [129, 54096], [131, 54116], [135, 54466], [143, 54816], [146, 55354], [151, 56193], [153, 56320], [155, 56400], [159, 56540], [166, 57080], [169, 58003]]}, {"verse": 6, "start": 59324, "end": 65738, "text": "Y a los horeos en el monte de Seir, hasta la llanura de Parán, que está junto al desierto.", "words": [[0, 59324], [2, 59446], [4, 59526], [8, 59876], [15, 60226], [18, 60446], [21, 60586], [27, 60886], [30, 61126], [36, 61906], [42, 62346], [45, 62526], [53, 62906], [56, 63066], [63, 64026], [67, 64106], [72, 64326], [78, 64666], [81, 64926]]}, {"verse": 7, "start": 66188, "end": 77608, "text": "Y volvieron, y vinieron a En-mispat, que es Cades, y devastaron todo el territorio de los amalecitas, y también al amorreo, que habitaba en Hazezón-tamar.", "words": [[0, 66188], [2, 66314], [13, 66774], [15, 67014], [24, 67474], [26, 68164], [37, 68854], [41, 68934], [44, 69114], [51, 70074], [53, 70154], [64, 70834], [69, 71094], [72, 71334], [83, 71974], [86, 72074], [90, 72194], [102, 73494], [104, 73554], [112, 73874], [115, 74234], [124, 75474], [128, 75594], [137, 76134], [140, 76892]]}, {"verse": 8, "start": 78058, "end": 92867, "text": "Y salió el rey de Sodoma, y el rey de Gomorra, y el rey de Adma, y el rey de Zeboim, y el rey de Bela, que es Zoar, y ordenaron contra ellos batalla en el valle de Siddim;", "words": [[0, 78058], [2, 78202], [8, 78602], [11, 78802], [15, 79082], [18, 79162], [26, 79962], [28, 80482], [31, 80622], [35, 80882], [38, 80962], [47, 81862], [49, 82162], [52, 82322], [56, 82642], [59, 82722], [65, 83602], [67, 83862], [70, 84002], [74, 84302], [77, 84852], [85, 85402], [87, 85662], [90, 85822], [94, 86122], [97, 86222], [103, 86902], [107, 87002], [110, 87402], [116, 88047], [118, 88227], [128, 88887], [135, 89227], [141, 89567], [149, 90147], [152, 90307], [155, 90497], [161, 90687], [164, 91777]]}, {"verse": 9, "start": 93317, "end": 105481, "text": "Es decir, contra Quedorlaomer, rey de Elam, y Tidal, rey de naciones, y Amrafel, rey de Sinar, y Arioc, rey de Elasar; cuatro reyes contra cinco.", "words": [[0, 93593], [3, 93905], [10, 94217], [17, 94529], [31, 94841], [35, 95281], [38, 95381], [44, 95841], [46, 96221], [53, 97041], [57, 97481], [60, 97541], [70, 98101], [72, 98711], [81, 99321], [85, 99741], [88, 99861], [95, 100281], [97, 100581], [104, 101541], [108, 102101], [111, 102301], [119, 103595], [126, 103765], [132, 104365], [139, 104951]]}, {"verse": 10, "start": 105931, "end": 117001, "text": "Y el valle de Siddim estaba lleno de pozos de asfalto: y huyeron el rey de Sodoma y el de Gomorra, y cayeron allí; y los demás huyeron al monte.", "words": [[0, 105931], [2, 106077], [5, 106217], [11, 106497], [14, 106897], [21, 107297], [28, 107717], [34, 108157], [37, 108257], [43, 108737], [46, 108857], [55, 109956], [57, 110084], [65, 110624], [68, 110844], [72, 111224], [75, 111284], [82, 111864], [84, 112064], [87, 112184], [90, 112304], [99, 112984], [101, 113439], [109, 113894], [115, 114592], [117, 114874], [121, 115034], [127, 115374], [135, 116174], [138, 116314]]}, {"verse": 11, "start": 117451, "end": 123760, "text": "Y tomaron toda la riqueza de Sodoma y de Gomorra, y todas sus provisiones, y se fueron.", "words": [[0, 117451], [2, 117555], [10, 117995], [15, 118315], [18, 118575], [26, 119115], [29, 119255], [36, 119795], [38, 119915], [41, 120015], [50, 120615], [52, 121035], [58, 121295], [62, 121595], [75, 122835], [77, 122975], [80, 123115]]}, {"verse": 12, "start": 124210, "end": 131762, "text": "Tomaron también a Lot, hijo del hermano de Abram, que moraba en Sodoma, y sus bienes, y se fueron.", "words": [[0, 124210], [8, 124592], [16, 124952], [18, 125272], [23, 125992], [28, 126372], [32, 126632], [40, 127172], [43, 127272], [50, 128152], [54, 128232], [61, 128692], [64, 128872], [72, 129512], [74, 129872], [78, 130032], [86, 130712], [88, 130952], [91, 131072]]}, {"verse": 13, "start": 132212, "end": 147000, "text": "Y vino uno de los que escaparon, y se lo comunicó a Abram el hebreo, que habitaba en el valle de Mamre amorreo, hermano de Escol y hermano de Aner, los cuales estaban confederados con Abram.", "words": [[0, 132212], [2, 132354], [7, 132614], [11, 133034], [14, 133234], [18, 133354], [22, 133534], [33, 134734], [35, 134954], [38, 135054], [41, 135194], [50, 135914], [52, 136234], [58, 136554], [61, 136914], [69, 138014], [73, 138074], [82, 138614], [85, 138774], [88, 138894], [94, 139174], [97, 139504], [103, 139834], [112, 140974], [120, 141494], [123, 141874], [129, 142254], [131, 142654], [139, 143114], [142, 143234], [148, 144193], [152, 144334], [159, 144594], [167, 145094], [180, 146114], [184, 146583]]}, {"verse": 14, "start": 147450, "end": 157813, "text": "Y oyó Abram que su hermano estaba prisionero, y armó sus criados, los criados de su casa, trescientos dieciocho, y los siguió hasta Dan.", "words": [[0, 147450], [2, 147763], [6, 148243], [12, 148543], [16, 148683], [19, 148863], [27, 149343], [34, 149563], [46, 150463], [48, 150883], [53, 151223], [57, 151363], [66, 152423], [70, 152563], [78, 153003], [81, 153163], [84, 153323], [90, 154236], [102, 155150], [113, 156063], [115, 156263], [119, 156423], [126, 156901], [132, 157378]]}, {"verse": 15, "start": 158263, "end": 167442, "text": "Y cayó sobre ellos de noche él y sus siervos, y los hirió, y los fue siguiendo hasta Hobah, que está a la izquierda de Damasco.", "words": [[0, 158263], [2, 158393], [7, 158793], [13, 159053], [19, 159353], [22, 159533], [28, 159853], [31, 160273], [33, 160493], [37, 160653], [46, 161273], [48, 161726], [52, 162180], [59, 162633], [61, 162773], [65, 162913], [69, 163133], [79, 163693], [85, 164323], [92, 164953], [96, 165013], [101, 165353], [103, 165673], [106, 165773], [116, 166453], [119, 166593]]}, {"verse": 16, "start": 167892, "end": 175074, "text": "Y recobró todos los bienes, y también a Lot su hermano y sus bienes, y también las mujeres y gente.", "words": [[0, 167892], [2, 168061], [10, 168761], [16, 169021], [20, 169381], [28, 170281], [30, 170341], [38, 170681], [40, 170961], [44, 171301], [47, 171481], [55, 172061], [57, 172161], [61, 172341], [69, 173221], [71, 173241], [79, 173541], [83, 173721], [91, 174081], [93, 174381]]}, {"verse": 17, "start": 175523, "end": 186801, "text": "Y salió el rey de Sodoma a recibirlo, cuando volvía de la derrota de Quedorlaomer y de los reyes que con él estaban, al valle de Save, que es el valle del Rey.", "words": [[0, 175523], [2, 175668], [8, 176068], [11, 176308], [15, 176708], [18, 176788], [25, 177348], [27, 177508], [38, 178588], [45, 179048], [52, 179688], [55, 179828], [58, 179968], [66, 180448], [69, 181008], [82, 181568], [84, 181748], [87, 181848], [91, 182008], [97, 182408], [101, 182588], [105, 182848], [108, 182968], [117, 183968], [120, 184088], [126, 184328], [129, 184743], [135, 185395], [139, 185541], [142, 185701], [145, 185821], [151, 186101], [155, 186301]]}, {"verse": 18, "start": 187251, "end": 195064, "text": "Entonces Melquisedec, rey de Salem, sacó pan y vino; el cual era sacerdote del Dios alto;", "words": [[0, 187251], [9, 188197], [22, 189177], [26, 189657], [29, 189757], [36, 190137], [41, 190897], [45, 191197], [47, 191417], [53, 192216], [56, 192363], [61, 192803], [65, 193243], [75, 193683], [79, 194023], [84, 194283]]}, {"verse": 19, "start": 195514, "end": 202235, "text": "Y le bendijo, y dijo: Bendito sea Abram del Dios alto, poseedor de los cielos y de la tierra;", "words": [[0, 195514], [2, 195640], [5, 195740], [14, 196360], [16, 196980], [22, 197751], [30, 198258], [34, 198498], [40, 198918], [44, 199058], [49, 199278], [55, 200118], [64, 200658], [67, 200818], [71, 200938], [78, 201378], [80, 201478], [83, 201558], [86, 201658]]}, {"verse": 20, "start": 202685, "end": 209545, "text": "Y bendito sea el Dios alto, que entregó tus enemigos en tu mano. Y le dio Abram los diezmos de todo.", "words": [[0, 202685], [2, 202784], [10, 203264], [14, 203544], [17, 203664], [22, 203924], [28, 204244], [32, 204704], [40, 205164], [44, 205324], [53, 205804], [56, 206004], [59, 206104], [65, 206904], [67, 207052], [70, 207192], [74, 207632], [80, 208072], [84, 208232], [92, 208772], [95, 208972]]}, {"verse": 21, "start": 209995, "end": 218016, "text": "Entonces el rey de Sodoma dijo a Abram: Dame las personas, y toma para ti los bienes.", "words": [[0, 209995], [9, 210564], [12, 211124], [16, 211464], [19, 211524], [26, 212004], [31, 212324], [33, 212644], [40, 213553], [45, 213776], [49, 213996], [59, 214516], [61, 214896], [66, 215156], [71, 215396], [74, 215636], [78, 215816]]}, {"verse": 22, "start": 218366, "end": 226281, "text": "Y respondió Abram al rey de Sodoma: He alzado mi mano a Jehová Dios alto, poseedor de los cielos y de la tierra,", "words": [[0, 218366], [2, 218490], [12, 219030], [18, 219570], [21, 220210], [25, 220630], [28, 220730], [36, 221701], [39, 221827], [46, 222247], [49, 222387], [54, 222647], [56, 222987], [63, 223327], [68, 223667], [74, 224007], [83, 224707], [86, 224867], [90, 224987], [97, 225467], [99, 225567], [102, 225667], [105, 225747]]}, {"verse": 23, "start": 226731, "end": 234864, "text": "Que desde un hilo hasta la correa de un calzado, nada tomaré de todo lo que es tuyo, para que no digas: Yo enriquecí a Abram:", "words": [[0, 226731], [4, 226830], [10, 226990], [13, 227270], [18, 227510], [24, 227750], [27, 228050], [34, 228350], [37, 228430], [40, 228530], [49, 229550], [54, 229830], [61, 230330], [64, 230450], [69, 230690], [72, 230910], [76, 231030], [79, 231250], [85, 231790], [90, 232090], [94, 232250], [97, 232370], [104, 233244], [107, 233405], [117, 234065], [119, 234345]]}, {"verse": 24, "start": 235314, "end": 245371, "text": "Sacando solamente lo que comieron los jóvenes, y la porción de los varones que fueron conmigo, Aner, Escol, y Mamre; los cuales tomarán su parte.", "words": [[0, 235314], [8, 235747], [18, 236127], [21, 236407], [25, 236527], [34, 236867], [38, 237087], [47, 237507], [49, 237887], [52, 238007], [60, 238367], [63, 238527], [67, 238647], [75, 239027], [79, 239207], [86, 239747], [95, 240287], [101, 240957], [108, 241627], [110, 242462], [117, 243597], [121, 243597], [128, 243597], [136, 243973], [139, 244133]]}]}