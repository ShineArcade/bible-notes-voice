{"book": "GEN", "chapter": 35, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 214612, "verses": [{"verse": 1, "start": 300, "end": 10532, "text": "And God said to Jacob, Arise, go up to Beth-el, and dwell there: and make there an altar to God, that appeared to you when you fled from the face of Esau your brother.", "words": [[0, 300], [4, 444], [8, 804], [13, 1124], [16, 1324], [23, 2048], [30, 2652], [33, 2772], [36, 2952], [39, 3092], [48, 3952], [52, 4052], [58, 4352], [65, 5403], [69, 5542], [74, 5742], [80, 5922], [83, 6042], [89, 6342], [92, 6522], [97, 6842], [102, 7282], [111, 7562], [114, 7842], [118, 8022], [123, 8242], [127, 8362], [132, 8622], [137, 8842], [141, 8962], [146, 9222], [149, 9442], [154, 9802], [159, 9942]]}, {"verse": 2, "start": 11043, "end": 19255, "text": "Then Jacob said to his household, and to all that were with him, Put away the strange gods that are among you, and be clean, and change your garments:", "words": [[0, 11043], [5, 11327], [11, 11687], [16, 12027], [19, 12247], [23, 12407], [34, 13327], [38, 13587], [41, 13747], [45, 13987], [50, 14207], [55, 14367], [60, 14607], [65, 15096], [69, 15218], [74, 15438], [78, 15638], [86, 15918], [91, 16198], [96, 16418], [100, 16558], [106, 16738], [111, 17018], [115, 17338], [118, 17458], [125, 17798], [129, 18218], [136, 18478], [141, 18638]]}, {"verse": 3, "start": 19605, "end": 27930, "text": "And let us arise, and go up to Beth-el; and I will make there an altar to God, who answered me in the day of my distress, and was with me in the way which I went.", "words": [[0, 19605], [4, 19722], [8, 19842], [11, 20002], [18, 20362], [22, 20702], [25, 20922], [28, 21102], [31, 21222], [40, 22004], [44, 22149], [46, 22249], [51, 22349], [56, 22549], [62, 22729], [65, 22849], [71, 23149], [74, 23389], [79, 23989], [83, 24209], [92, 24509], [95, 24769], [98, 24869], [102, 24969], [106, 25129], [109, 25229], [112, 25369], [122, 26169], [126, 26329], [130, 26489], [135, 26689], [138, 26889], [141, 26989], [145, 27069], [149, 27209], [155, 27409], [157, 27549]]}, {"verse": 4, "start": 28210, "end": 38767, "text": "And they gave to Jacob all the strange gods which were in their hand, and all their earrings which were in their ears; and Jacob hid them under the oak which was by Shechem.", "words": [[0, 28210], [4, 28336], [9, 28476], [14, 28736], [17, 28916], [23, 29276], [27, 29716], [31, 29956], [39, 30396], [44, 30836], [50, 31156], [55, 31376], [58, 31616], [64, 31836], [70, 32496], [74, 32776], [78, 33056], [84, 33276], [93, 33696], [99, 34116], [104, 34316], [107, 34576], [113, 34796], [119, 35687], [123, 35824], [129, 36124], [133, 36444], [138, 36684], [144, 36924], [148, 37144], [152, 37544], [158, 37664], [162, 37864], [165, 38351]]}, {"verse": 5, "start": 39117, "end": 46811, "text": "And they journeyed: and the terror of God was upon the cities that were round about them, and they did not pursue after the sons of Jacob.", "words": [[0, 39117], [4, 39271], [9, 39391], [20, 40286], [24, 40409], [28, 40529], [35, 40849], [38, 41049], [42, 41369], [46, 41589], [51, 41849], [55, 42069], [62, 42329], [67, 42589], [72, 42729], [78, 43009], [84, 43309], [90, 43849], [94, 44129], [99, 44269], [103, 44449], [107, 44609], [114, 45109], [120, 45449], [124, 45629], [129, 45889], [132, 46049]]}, {"verse": 6, "start": 47161, "end": 54451, "text": "¶ So Jacob came to Luz, which is in the land of Canaan, that is, Beth-el, he and all the people that were with him.", "words": [[2, 47161], [5, 47281], [11, 47661], [16, 47981], [19, 48181], [24, 49001], [30, 49241], [33, 49401], [36, 49541], [40, 49661], [45, 49921], [48, 50081], [56, 50936], [61, 50936], [65, 51136], [74, 52196], [77, 52696], [81, 52796], [85, 53036], [89, 53176], [96, 53436], [101, 53676], [106, 53816], [111, 54096]]}, {"verse": 7, "start": 54801, "end": 62039, "text": "And he built there an altar, and called the place El-beth-el: because there God appeared to him, when he fled from the face of his brother.", "words": [[0, 54801], [4, 54937], [7, 55017], [13, 55257], [19, 55497], [22, 55637], [29, 56017], [33, 56497], [40, 56737], [44, 56897], [50, 57626], [62, 58523], [70, 58717], [76, 58947], [80, 59267], [89, 59607], [92, 59867], [97, 60067], [102, 60327], [105, 60467], [110, 60687], [115, 60907], [119, 61027], [124, 61267], [127, 61407], [131, 61507]]}, {"verse": 8, "start": 62389, "end": 69885, "text": "But Deborah Rebekah’s nurse died, and she was buried beneath Beth-el under an oak: and the name of it was called Allon-bachuth.", "words": [[0, 62389], [4, 62501], [12, 62991], [22, 63481], [28, 63741], [34, 64181], [38, 64541], [42, 64721], [46, 64881], [53, 65221], [61, 65581], [69, 66141], [75, 66441], [78, 66641], [83, 67320], [87, 67465], [91, 67545], [96, 67805], [99, 67945], [102, 68065], [106, 68265], [113, 69075]]}, {"verse": 9, "start": 70235, "end": 75250, "text": "¶ And God appeared to Jacob again, when he came out of Padan-aram, and blessed him.", "words": [[2, 70235], [6, 70377], [10, 70597], [19, 70877], [22, 71117], [28, 71437], [35, 71857], [40, 72417], [43, 72537], [48, 72777], [52, 73057], [55, 73597], [67, 74137], [71, 74477], [79, 74737]]}, {"verse": 10, "start": 75600, "end": 84358, "text": "And God said to him, Your name is Jacob: your name shall not be called any more Jacob, but Israel shall be your name: and he called his name Israel.", "words": [[0, 75600], [4, 75704], [8, 75944], [13, 76204], [16, 76424], [21, 76991], [26, 77083], [31, 77283], [34, 77443], [41, 78516], [46, 78617], [51, 78817], [57, 79057], [61, 79277], [64, 79437], [71, 79657], [75, 79837], [80, 80017], [87, 80757], [91, 80857], [98, 81197], [104, 81477], [107, 81637], [112, 81757], [118, 82782], [122, 82910], [125, 83010], [132, 83270], [136, 83450], [141, 83690]]}, {"verse": 11, "start": 84708, "end": 94834, "text": "And God said to him, I am God Almighty: be fruitful and multiply; a nation and a company of nations shall be of you, and kings shall come out of your loins;", "words": [[0, 84708], [4, 84832], [8, 85072], [13, 85352], [16, 85552], [21, 86072], [23, 86277], [26, 86417], [30, 86697], [40, 87910], [43, 88009], [52, 88469], [56, 88869], [66, 89269], [68, 89774], [75, 90134], [79, 90414], [81, 90554], [89, 90834], [92, 91034], [100, 91354], [106, 91694], [109, 91914], [112, 92094], [117, 92494], [121, 92854], [127, 93134], [133, 93474], [138, 93694], [142, 93894], [145, 94014], [150, 94114]]}, {"verse": 12, "start": 95407, "end": 101159, "text": "And the land which I gave Abraham and Isaac, to you I will give it, and to your seed after you will I give the land.", "words": [[0, 95407], [4, 95539], [8, 95659], [13, 95919], [19, 96119], [21, 96259], [26, 96439], [34, 96819], [38, 97079], [45, 97299], [48, 97539], [52, 97699], [54, 97859], [59, 97999], [64, 98179], [68, 98739], [72, 98859], [75, 98999], [80, 99139], [85, 99499], [91, 99839], [95, 100059], [100, 100199], [102, 100319], [107, 100479], [111, 100639]]}, {"verse": 13, "start": 101672, "end": 104703, "text": "And God went up from him in the place where he talked with him.", "words": [[0, 101672], [4, 101795], [8, 102075], [13, 102295], [16, 102495], [21, 102735], [25, 102935], [28, 103095], [32, 103195], [38, 103455], [44, 103675], [47, 103815], [54, 104095], [59, 104355]]}, {"verse": 14, "start": 105053, "end": 113251, "text": "And Jacob set up a pillar in the place where he talked with him, even a pillar of stone: and he poured a drink offering on it, and he poured oil on it.", "words": [[0, 105053], [4, 105200], [10, 105540], [14, 105820], [17, 105980], [19, 106080], [26, 106340], [29, 106580], [33, 106680], [39, 106940], [45, 107140], [48, 107260], [55, 107520], [60, 107780], [65, 108280], [70, 108540], [72, 108700], [79, 108920], [82, 109120], [89, 109994], [93, 110118], [96, 110218], [103, 110478], [105, 110618], [111, 110858], [120, 111258], [123, 111598], [127, 111758], [131, 111938], [134, 112058], [141, 112338], [145, 112698], [148, 112998]]}, {"verse": 15, "start": 113601, "end": 117497, "text": "And Jacob called the name of the place where God spoke with him, Beth-el.", "words": [[0, 113601], [4, 113726], [10, 114026], [17, 114346], [21, 114546], [26, 114766], [29, 114946], [33, 115066], [39, 115366], [45, 115586], [49, 115846], [55, 116186], [60, 116506], [65, 116926]]}, {"verse": 16, "start": 117847, "end": 125628, "text": "¶ And they journeyed from Beth-el; and there was but a little way to come to Ephrath: and Rachel travailed, and she had hard labour.", "words": [[2, 117847], [6, 117969], [11, 118089], [21, 118609], [26, 119114], [35, 119781], [39, 119930], [45, 120150], [49, 120410], [53, 120630], [55, 120750], [62, 120970], [66, 121250], [69, 121430], [74, 121630], [77, 122016], [86, 122622], [90, 122768], [97, 123148], [108, 124168], [112, 124268], [116, 124448], [120, 124688], [125, 125191]]}, {"verse": 17, "start": 125978, "end": 133487, "text": "And it came to pass, when she was in hard labour, that the midwife said to her, Fear not; you shall have this son also.", "words": [[0, 125978], [4, 126113], [7, 126233], [12, 126453], [15, 126613], [21, 126953], [26, 127293], [30, 127493], [34, 127673], [37, 127813], [42, 128123], [50, 128433], [55, 129053], [59, 129233], [67, 129633], [72, 129953], [75, 130153], [80, 130676], [85, 130835], [90, 131624], [94, 131790], [100, 131990], [105, 132230], [110, 132480], [114, 132730]]}, {"verse": 18, "start": 133767, "end": 141754, "text": "And it came to pass, as her soul was in departing, (for she died) that she called his name Ben-oni: but his father called him Benjamin.", "words": [[0, 133767], [4, 133897], [7, 134017], [12, 134237], [15, 134397], [21, 134757], [24, 135017], [28, 135177], [33, 135517], [37, 135737], [40, 135857], [51, 136477], [56, 136637], [60, 136837], [66, 137737], [71, 137857], [75, 138017], [82, 138317], [86, 138517], [91, 139203], [100, 140040], [104, 140140], [108, 140260], [115, 140580], [122, 140880], [126, 141080]]}, {"verse": 19, "start": 142104, "end": 146858, "text": "And Rachel died, and was buried in the way to Ephrath, which is Beth-lehem.", "words": [[0, 142104], [4, 142244], [11, 142544], [17, 143024], [21, 143384], [25, 143564], [32, 143924], [35, 144124], [39, 144204], [43, 144404], [46, 144584], [55, 145484], [61, 145644], [64, 145824]]}, {"verse": 20, "start": 147208, "end": 152680, "text": "And Jacob set a pillar upon her grave: that is the pillar of Rachel’s grave to this day.", "words": [[0, 147208], [4, 147352], [10, 147712], [14, 148012], [16, 148112], [23, 148392], [28, 148712], [32, 148972], [39, 149837], [44, 150042], [47, 150202], [51, 150342], [58, 150662], [61, 150882], [70, 151382], [76, 151702], [79, 151902], [84, 152142]]}, {"verse": 21, "start": 153030, "end": 157116, "text": "¶ And Israel journeyed, and spread his tent beyond the tower of Edar.", "words": [[2, 153030], [6, 153155], [13, 153515], [24, 154275], [28, 154355], [35, 154715], [39, 154975], [44, 155295], [51, 155655], [55, 155895], [61, 156255], [64, 156515]]}, {"verse": 22, "start": 157466, "end": 168056, "text": "And it came to pass, when Israel dwelt in that land, that Reuben went and lay with Bilhah his father’s concubine: and Israel heard it. Now the sons of Jacob were twelve:", "words": [[0, 157466], [4, 157596], [7, 157696], [12, 157916], [15, 158116], [21, 158436], [26, 158716], [33, 159136], [39, 159676], [42, 159856], [47, 160056], [53, 160896], [58, 161076], [65, 161476], [70, 161756], [74, 161976], [78, 162176], [83, 162376], [90, 162876], [94, 163096], [103, 163556], [114, 164550], [118, 164695], [125, 165075], [131, 165415], [135, 165898], [139, 166162], [143, 166422], [148, 166682], [151, 166882], [157, 167202], [162, 167482]]}, {"verse": 23, "start": 168406, "end": 175722, "text": "The sons of Leah; Reuben, Jacob’s firstborn, and Simeon, and Levi, and Judah, and Issachar, and Zebulun:", "words": [[0, 168406], [4, 168506], [9, 168746], [12, 168946], [18, 1