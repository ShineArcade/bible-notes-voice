{"book": "LUK", "chapter": 17, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 251367, "verses": [{"verse": 1, "start": 300, "end": 7673, "text": "Then said he to the disciples, It is impossible but that offences will come: but woe to him, through whom they come!", "words": [[0, 300], [5, 525], [10, 825], [13, 1065], [16, 1205], [20, 1345], [31, 2467], [34, 2593], [37, 2753], [48, 3613], [52, 3713], [57, 4033], [66, 4353], [71, 4673], [77, 5504], [81, 5646], [85, 5966], [88, 6106], [93, 6326], [101, 6666], [106, 6966], [111, 7186]]}, {"verse": 2, "start": 8123, "end": 14992, "text": "It were better for him that a millstone were hanged about his neck, and he cast into the sea, than that he should offend one of these little ones.", "words": [[0, 8123], [3, 8225], [8, 8345], [15, 8605], [19, 8825], [23, 9005], [28, 9185], [30, 9285], [40, 9785], [45, 10005], [52, 10405], [58, 10525], [62, 10745], [68, 11065], [72, 11505], [75, 11605], [80, 11885], [85, 12185], [89, 12345], [94, 12685], [99, 13085], [104, 13245], [107, 13345], [114, 13485], [121, 13805], [125, 14025], [128, 14145], [134, 14265], [141, 14525]]}, {"verse": 3, "start": 15442, "end": 21840, "text": "¶ Take heed to yourselves: If your brother trespass against you, rebuke him; and if he repent, forgive him.", "words": [[2, 15442], [7, 15578], [12, 15858], [15, 16038], [27, 17037], [30, 17163], [35, 17283], [43, 17543], [52, 18203], [60, 18483], [65, 19063], [72, 19483], [77, 20076], [81, 20182], [84, 20322], [87, 20422], [95, 21142], [103, 21342]]}, {"verse": 4, "start": 22290, "end": 30982, "text": "And if he trespass against you seven times in a day, and seven times in a day turn again to you, saying, I repent; you shall forgive him.", "words": [[0, 22290], [4, 22412], [7, 22572], [10, 22672], [19, 23352], [27, 23632], [31, 23912], [37, 24192], [43, 24652], [46, 24812], [48, 24912], [53, 25212], [57, 25632], [63, 25912], [69, 26352], [72, 26512], [74, 26612], [78, 26892], [83, 27112], [89, 27372], [92, 27612], [97, 27872], [105, 28692], [107, 28912], [115, 29885], [119, 30007], [125, 30207], [133, 30507]]}, {"verse": 5, "start": 31332, "end": 34376, "text": "And the apostles said to the Lord, Increase our faith.", "words": [[0, 31332], [4, 31458], [8, 31578], [17, 32138], [22, 32318], [25, 32478], [29, 32638], [35, 33366], [44, 33896], [48, 34016]]}, {"verse": 6, "start": 34726, "end": 45210, "text": "And the Lord said, If you had faith as a grain of mustard seed, you might say to this sycamine tree, Be plucked up by the root, and be planted in the sea; and it should obey you.", "words": [[0, 34726], [4, 34855], [8, 34975], [13, 35175], [19, 36516], [22, 36661], [26, 36801], [30, 37001], [36, 37301], [39, 37561], [41, 37661], [47, 37861], [50, 38021], [58, 38321], [64, 39141], [68, 39281], [74, 39481], [78, 39721], [81, 39841], [86, 40101], [95, 40361], [101, 41141], [104, 41281], [112, 41641], [115, 41701], [118, 41881], [122, 42021], [128, 42261], [132, 42601], [135, 42741], [143, 43061], [146, 43261], [150, 43361], [155, 44133], [159, 44270], [162, 44390], [169, 44510], [174, 44770]]}, {"verse": 7, "start": 45660, "end": 53158, "text": "But which of you, having a servant plowing or feeding cattle, will say to him immediately, when he is come from the field, Go and sit down to food?", "words": [[0, 45660], [4, 45762], [10, 46002], [13, 46162], [18, 46582], [25, 46782], [27, 46962], [35, 47242], [43, 47722], [46, 47902], [54, 48182], [62, 48922], [67, 49042], [71, 49262], [74, 49382], [78, 49522], [91, 50302], [96, 50482], [99, 50612], [102, 50742], [107, 50922], [112, 51102], [116, 51222], [123, 51842], [126, 52002], [130, 52182], [134, 52342], [139, 52602], [142, 52742]]}, {"verse": 8, "start": 53608, "end": 62432, "text": "And will not rather say to him, Prepare something for my supper, and gird yourself, and serve me, till I have eaten and drunken; and afterward you shall eat and drink?", "words": [[0, 53608], [4, 53708], [9, 53888], [13, 54108], [20, 54368], [24, 54608], [27, 54768], [32, 55148], [40, 55428], [50, 55788], [54, 56008], [57, 56168], [65, 56888], [69, 56988], [74, 57188], [84, 58048], [88, 58168], [94, 58428], [98, 58688], [103, 58988], [105, 59168], [110, 59308], [116, 59568], [120, 59868], [129, 60722], [133, 60861], [143, 61381], [147, 61461], [153, 61641], [157, 61861], [161, 61981]]}, {"verse": 9, "start": 62882, "end": 67348, "text": "Does he thank that servant because he did the things that were commanded him? I think not.", "words": [[0, 62882], [5, 63020], [8, 63220], [14, 63480], [19, 63700], [27, 64060], [35, 64400], [38, 64620], [42, 64800], [46, 64940], [53, 65200], [58, 65400], [63, 65520], [73, 65860], [78, 66595], [80, 66741], [86, 66961]]}, {"verse": 10, "start": 67798, "end": 77362, "text": "So likewise you, when you shall have done all those things which are commanded you, say, We are unprofitable servants: we have done that which was our duty to do.", "words": [[0, 67798], [3, 67975], [12, 68355], [17, 69035], [22, 69175], [26, 69335], [32, 69495], [37, 69675], [42, 69875], [46, 70155], [52, 70375], [59, 70755], [65, 71015], [69, 71155], [79, 71515], [84, 72315], [89, 73015], [92, 73195], [96, 73335], [109, 74155], [119, 75164], [122, 75272], [127, 75412], [132, 75612], [137, 75992], [143, 76112], [147, 76292], [151, 76452], [156, 76732], [159, 76952]]}, {"verse": 11, "start": 77712, "end": 83757, "text": "¶ And it came to pass, as he went to Jerusalem, that he passed through the midst of Samaria and Galilee.", "words": [[2, 77712], [6, 77844], [9, 77944], [14, 78184], [17, 78384], [23, 78784], [26, 79144], [29, 79284], [34, 79484], [37, 79624], [48, 80244], [53, 80824], [56, 80944], [63, 81264], [71, 81504], [75, 81644], [81, 81944], [84, 82224], [92, 82804], [96, 83064]]}, {"verse": 12, "start": 84207, "end": 90444, "text": "And as he entered into a certain village, there met him ten men that were lepers, which stood afar off:", "words": [[0, 84207], [4, 84342], [7, 84542], [10, 84682], [18, 85022], [23, 85362], [25, 85562], [33, 85802], [42, 86762], [48, 86902], [52, 87102], [56, 87322], [60, 87642], [64, 87982], [69, 88182], [74, 88322], [82, 89062], [88, 89242], [94, 89542], [99, 89902]]}, {"verse": 13, "start": 90894, "end": 95567, "text": "And they lifted up their voices, and said, Jesus, Master, have mercy on us.", "words": [[0, 90894], [4, 91021], [9, 91141], [16, 91421], [19, 91641], [25, 91821], [33, 92261], [37, 92601], [43, 93304], [50, 93542], [58, 94402], [63, 94522], [69, 94902], [72, 95142]]}, {"verse": 14, "start": 95917, "end": 104841, "text": "And when he saw them, he said to them, Go show yourselves to the priests. And it came to pass, that, as they went, they were cleansed.", "words": [[0, 95917], [4, 96024], [9, 96204], [12, 96404], [16, 96664], [22, 97084], [25, 97184], [30, 97424], [33, 97624], [39, 98157], [42, 98336], [47, 98616], [58, 99116], [61, 99396], [65, 99536], [74, 100675], [78, 100815], [81, 100915], [86, 101155], [89, 101375], [95, 101735], [101, 102575], [104, 102875], [109, 103055], [115, 103775], [120, 103915], [125, 104095]]}, {"verse": 15, "start": 105291, "end": 111424, "text": "And one of them, when he saw that he was healed, turned back, and with a loud voice glorified God,", "words": [[0, 105291], [4, 105453], [8, 105633], [11, 105773], [17, 106173], [22, 106453], [25, 106613], [29, 106893], [34, 107073], [37, 107193], [41, 107373], [49, 108013], [56, 108193], [62, 108553], [66, 109173], [71, 109333], [73, 109473], [78, 109713], [84, 110053], [94, 110833]]}, {"verse": 16, "start": 111874, "end": 116656, "text": "And fell down on his face at his feet, giving him thanks: and he was a Samaritan.", "words": [[0, 111874], [4, 111989], [9, 112229], [14, 112509], [17, 112689], [21, 112849], [26, 113109], [29, 113309], [33, 113469], [39, 114049], [46, 114289], [50, 114509], [58, 115412], [62, 115530], [65, 115670], [69, 115830], [71, 115970]]}, {"verse": 17, "start": 117106, "end": 122263, "text": "And Jesus answering said, Were there not ten cleansed? but where are the nine?", "words": [[0, 117106], [4, 117406], [10, 117746], [20, 118266], [26, 119081], [31, 119279], [37, 119439], [41, 119709], [45, 119979], [55, 121017], [59, 121181], [65, 121401], [69, 121601], [73, 121761]]}, {"verse": 18, "start": 122713, "end": 126371, "text": "There are not found that returned to give glory to God, save this stranger.", "words": [[0, 122713], [6, 122835], [10, 122955], [14, 123095], [20, 123475], [25, 123765], [34, 124055], [37, 124255], [42, 124435], [48, 124775], [51, 124935], [56, 125255], [61, 125575], [66, 125815]]}, {"verse": 19, "start": 126721, "end": 131347, "text": "And he said to him, Arise, go your way: your faith has made you whole.", "words": [[0, 126721], [4, 126847], [7, 126947], [12, 127167], [15, 127367], [20, 128019], [27, 128622], [30, 128742], [35, 128962], [40, 129803], [45, 129922], [51, 130202], [55, 130462], [60, 130682], [64, 130842]]}, {"verse": 20, "start": 131697, "end": 141566, "text": "¶ And when he was demanded of the Pharisees, when the kingdom of God should come, he answered them and said, The kingdom of God comes not with observation:", "words": [[2, 131697], [6, 131844], [11, 132004], [14, 132184], [18, 132364], [27, 132824], [30, 133044], [34, 133164], [45, 134244], [50, 134444], [54, 134584], [62, 134864], [65, 135104], [69, 135384], [76, 135624], [82, 136424], [85, 136564], [94, 136924], [99, 137204], [103, 137344], [109, 139082], [113, 139164], [121, 139464], [124, 139684], [128, 139964], [134, 140224], [138, 140524], [143, 140704]]}, {"verse": 21, "start": 142016, "end": 147915, "text": "Neither shall they say, Lo here! or, lo there! for, behold, the kingdom of God is within you.", "words": [[0, 142016], [8, 142235], [14, 142535], [19, 142715], [24, 143175], [27, 143635], [33, 144541], [37, 144781], [40, 145057], [47, 145634], [52, 145751], [60, 146351], [64, 146411], [72, 146651], [75, 146851], [79, 147111], [82, 147271], [89, 147551]]}, {"verse": 22, "start": 148265, "end": 156101, "text": "And he said to the disciples, The days will come, when you shall desire to see one of the days of the Son of man, and you shall not see it.", "words": [[0, 148265], [4, 148392], [7, 148512], [12, 148712], [15, 148892], [19, 148992], [30, 150066], [34, 150145], [39, 150485], [44, 150684], [50, 151045], [55, 151265], [59, 151425], [65, 151645], [72, 152104], [75, 152305], [79, 152545], [83, 152784], [86, 152884], [90, 153004], [95, 153324], [98, 153585], [102, 153705], [106, 153925], [109, 154045], [114, 154684], [118, 154884], [122, 155085], [128, 155305], [132, 155545], [136, 155824]]}, {"verse": 23, "start": 156551, "end": 162067, "text": "And they shall say to you, See here; or, see there: go not after them, nor follow them.", "words": [[0, 156551], [4, 156657], [9, 156817], [15, 157017], [19, 157277], [22, 157417], [27, 157777], [31, 158037], [37, 158837], [41, 158964], [45, 159224], [52, 159981], [55, 160085], [59, 160245], [65, 160565], [71, 161045], [75, 161265], [82, 161625]]}, {"verse": 24, "start": 162517, "end": 170851, "text": "For as the lightning, that lightens out of the one part under heaven, shines to the other part under heaven; so shall also the Son of man be in his day.", "words": [[0, 162517], [4, 162602], [7, 162802], [11, 162942], [22, 163302], [27, 163842], [36, 164282], [40, 164422], [43, 164542], [47, 164642], [51, 164882], [56, 165142], [62, 165422], [70, 165762], [77, 166202], [80, 166522], [84, 166662], [90, 166842], [95, 167102], [101, 167362], [109, 168147], [112, 168356], [118, 168556], [123, 168936], [127, 169136], [131, 169376], [134, 169496], [138, 169796], [141, 170036], [144, 170176], [148, 170356]]}, {"verse": 25, "start": 171301, "end": 175351, "text": "But first must he suffer many things, and be rejected of this generation.", "words": [[0, 171301], [4, 171401], [10, 171681], [15, 171961], [18, 172141], [25, 172441], [30, 172801], [38, 173261], [42, 173721], [45, 173841], [54, 174281], [57, 174521], [62, 174661]]}, {"verse": 26, "start": 175801, "end": 180915, "text": "And as it was in the days of Noe, so shall it be also in the days of the Son of man.", "words": [[0, 175801], [4, 175938], [7, 176178], [10, 176318], [14, 176538], [17, 176718], [21, 176818], [26, 177078], [29, 177538], [34, 177998], [37, 178258], [43, 178538], [46, 178678], [49, 178798], [54, 179138], [57, 179518], [61, 179618], [66, 179898], [69, 180058], [73, 180158], [77, 180358], [80, 180478]]}, {"verse": 27, "start": 181365, "end": 189512, "text": "They did eat, they drank, they married wives, they were given in marriage, until the day that Noe entered into the ark, and the flood came, and destroyed them all.", "words": [[0, 181365], [5, 181521], [9, 181741], [14, 182061], [19, 182121], [26, 182741], [31, 182841], [39, 183141], [46, 183861], [51, 183941], [56, 184061], [62, 184281], [65, 184461], [75, 185101], [81, 185381], [85, 185581], [89, 185801], [94, 185961], [98, 186121], [106, 186481], [111, 186761], [115, 186921], [120, 187461], [124, 187541], [128, 187641], [134, 187861], [140, 188461], [144, 188561], [154, 188921], [159, 189181]]}, {"verse": 28, "start": 189962, "end": 197009, "text": "Likewise also as it was in the days of Lot; they did eat, they drank, they bought, they sold, they planted, they built;", "words": [[0, 189962], [9, 190264], [14, 190984], [17, 191184], [20, 191304], [24, 191524], [27, 191744], [31, 191844], [36, 192104], [39, 192264], [44, 193027], [49, 193130], [53, 193370], [58, 194010], [63, 194070], [70, 194730], [75, 194790], [83, 195290], [88, 195350], [94, 195790], [99, 195870], [108, 196450], [113, 196550]]}, {"verse": 29, "start": 197459, "end": 203297, "text": "But the same day that Lot went out of Sodom it rained fire and brimstone from heaven, and destroyed them all.", "words": [[0, 197459], [4, 197631], [8, 197771], [13, 198091], [17, 198371], [22, 198591], [26, 198811], [31, 199031], [35, 199211], [38, 199331], [44, 199771], [47, 199851], [54, 200131], [59, 200531], [63, 200731], [73, 201211], [78, 201471], [86, 201751], [90, 202211], [100, 202611], [105, 202891]]}, {"verse": 30, "start": 203747, "end": 207524, "text": "Even thus shall it be in the day when the Son of man is revealed.", "words": [[0, 203747], [5, 203990], [10, 204310], [16, 204770], [19, 204950], [22, 205150], [25, 205330], [29, 205430], [33, 205710], [38, 205970], [42, 206090], [46, 206330], [49, 206430], [53, 206730], [56, 206910]]}, {"verse": 31, "start": 207974, "end": 218933, "text": "In that day, he which shall be upon the housetop, and his stuff in the house, let him not come down to take it away: and he that is in the field, let him likewise not return back.", "words": [[0, 207974], [3, 208111], [8, 208371], [13, 208871], [16, 209071], [22, 209331], [28, 209671], [31, 209851], [36, 210111], [40, 210331], [50, 210911], [54, 211351], [58, 211511], [64, 211831], [67, 212031], [71, 212151], [78, 212691], [82, 212891], [86, 213051], [90, 213291], [95, 213511], [100, 213791], [103, 213971], [108, 214191], [111, 214291], [117, 215049], [121, 215213], [124, 215453], [129, 215733], [132, 215913], [135, 216033], [139, 216153], [146, 216973], [150, 217153], [154, 217313], [163, 217693], [167, 218013], [174, 218353]]}, {"verse": 32, "start": 219383, "end": 220721, "text": "Remember Lot’s wife.", "words": [[0, 219383], [9, 219699], [15, 220159]]}, {"verse": 33, "start": 221171, "end": 226774, "text": "Whoever shall seek to save his life shall lose it; and whoever shall lose his life shall preserve it.", "words": [[0, 221171], [8, 221398], [14, 221698], [19, 221918], [22, 222118], [27, 222358], [31, 222558], [36, 222898], [42, 223138], [47, 223418], [51, 224047], [55, 224171], [63, 224451], [69, 224831], [74, 225091], [78, 225331], [83, 225731], [89, 226031], [98, 226371]]}, {"verse": 34, "start": 227224, "end": 233639, "text": "I tell you, in that night there shall be two men in one bed; the one shall be taken, and the other shall be left.", "words": [[0, 227224], [2, 227364], [7, 227624], [12, 227804], [15, 227984], [20, 228164], [26, 228444], [32, 228904], [38, 229084], [41, 229244], [45, 229464], [49, 229724], [52, 229984], [56, 230184], [61, 230982], [65, 231058], [69, 231238], [75, 231438], [78, 231578], [85, 231918], [89, 232398], [93, 232538], [99, 232738], [105, 232998], [108, 233138]]}, {"verse": 35, "start": 234089, "end": 238618, "text": "Two women shall be grinding together; the one shall be taken, and the other left.", "words": [[0, 234089], [4, 234268], [10, 234628], [16, 234908], [19, 235048], [28, 235428], [38, 236452], [42, 236536], [46, 236716], [52, 236936], [55, 237076], [62, 237696], [66, 237796], [70, 237916], [76, 238076]]}, {"verse": 36, "start": 239068, "end": 243094, "text": "Two men shall be in the field; the one shall be taken, and the other left.", "words": [[0, 239068], [4, 239206], [8, 239466], [14, 239706], [17, 239886], [20, 239986], [24, 240086], [31, 240890], [35, 240954], [39, 241154], [45, 241354], [48, 241494], [55, 241814], [59, 242194], [63, 242374], [69, 242514]]}, {"verse": 37, "start": 243394, "end": 250967, "text": "And they answered and said to him, Where, Lord? And he said to them, Wherever the body is, there will the eagles be gathered together.", "words": [[0, 243394], [4, 243514], [9, 243634], [18, 244014], [22, 244194], [27, 244454], [30, 244614], [35, 245034], [42, 245214], [48, 246050], [52, 246181], [55, 246301], [60, 246541], [63, 246741], [69, 247336], [78, 247586], [82, 247846], [87, 248126], [91, 248746], [97, 249006], [102, 249246], [106, 249426], [113, 249846], [116, 250086], [125, 250366]]}]}