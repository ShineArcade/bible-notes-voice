{"book": "MAT", "chapter": 7, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 194093, "verses": [{"verse": 1, "start": 300, "end": 2235, "text": "Judge not, that you be not judged.", "words": [[0, 300], [6, 495], [11, 855], [16, 1095], [20, 1275], [23, 1415], [27, 1615]]}, {"verse": 2, "start": 2685, "end": 8829, "text": "For with what judgment you judge, you shall be judged: and with what measure you measure, it shall be measured to you again.", "words": [[0, 2685], [4, 2770], [9, 2950], [14, 3150], [23, 3470], [27, 3750], [34, 4270], [38, 4450], [44, 4690], [47, 4870], [55, 5725], [59, 5848], [64, 6008], [69, 6188], [77, 6508], [81, 6688], [90, 7248], [93, 7328], [99, 7528], [102, 7668], [111, 7968], [114, 8148], [118, 8328]]}, {"verse": 3, "start": 9279, "end": 14809, "text": "And why do you look at the speck that is in your brother’s eye, but consider not the beam that is in your own eye?", "words": [[0, 9279], [4, 9385], [8, 9605], [11, 9725], [15, 9805], [20, 10045], [23, 10145], [27, 10245], [33, 10645], [38, 10765], [41, 10885], [44, 11025], [49, 11125], [59, 11605], [64, 12225], [68, 12465], [77, 12845], [81, 13065], [85, 13295], [90, 13525], [95, 13745], [98, 13885], [101, 14005], [106, 14125], [110, 14365]]}, {"verse": 4, "start": 15259, "end": 22439, "text": "Or how will you say to your brother, Let me pull out the speck out of your eye; and, behold, a beam is in your own eye?", "words": [[0, 15259], [3, 15400], [7, 15580], [12, 15760], [16, 15880], [20, 16080], [23, 16200], [28, 16300], [37, 16980], [41, 17100], [44, 17240], [49, 17480], [53, 17640], [57, 17780], [63, 18120], [67, 18220], [70, 18340], [75, 18460], [80, 20076], [85, 20076], [93, 20978], [95, 21118], [100, 21378], [103, 21578], [106, 21698], [111, 21858], [115, 21998]]}, {"verse": 5, "start": 22889, "end": 29893, "text": "You hypocrite, first cast out the beam out of your own eye; and then shall you see clearly to cast out the speck out of your brother’s eye.", "words": [[0, 22889], [4, 23046], [15, 23646], [21, 23866], [26, 24286], [30, 24566], [34, 24706], [39, 24966], [43, 25206], [46, 25326], [51, 25466], [55, 25646], [60, 26324], [64, 26504], [69, 26624], [75, 26864], [79, 27064], [83, 27264], [91, 27644], [94, 27864], [99, 28184], [103, 28364], [107, 28504], [113, 28864], [117, 28984], [120, 29084], [125, 29184], [135, 29644]]}, {"verse": 6, "start": 30343, "end": 38798, "text": "¶ Give not that which is holy to the dogs, neither cast you your pearls before swine, lest they trample them under their feet, and turn again and rend you.", "words": [[2, 30343], [7, 30619], [11, 30939], [16, 31279], [22, 31559], [25, 31699], [30, 31979], [33, 32199], [37, 32319], [43, 33059], [51, 33219], [56, 33559], [60, 33779], [65, 33919], [72, 34219], [79, 34619], [86, 35459], [91, 35659], [96, 35819], [104, 36279], [109, 36419], [115, 36679], [121, 36879], [127, 37159], [131, 37379], [136, 37639], [142, 37999], [146, 38199], [151, 38439]]}, {"verse": 7, "start": 39248, "end": 45398, "text": "¶ Ask, and it shall be given you; seek, and you shall find; knock, and it shall be opened to you:", "words": [[2, 39248], [7, 39615], [11, 39995], [14, 40115], [20, 40315], [23, 40475], [29, 40735], [34, 41460], [40, 41918], [44, 42198], [48, 42318], [54, 42498], [60, 43462], [67, 43726], [71, 44146], [74, 44266], [80, 44386], [83, 44576], [90, 44766], [93, 45066]]}, {"verse": 8, "start": 45848, "end": 52105, "text": "For every one that asks receives; and he that seeks finds; and to him that knocks it shall be opened.", "words": [[0, 45848], [4, 45940], [10, 46074], [14, 46207], [19, 46547], [24, 47047], [34, 47960], [38, 48086], [41, 48246], [46, 48426], [52, 48666], [59, 49774], [63, 49903], [66, 50043], [70, 50323], [75, 50603], [82, 50883], [85, 51163], [91, 51363], [94, 51543]]}, {"verse": 9, "start": 52555, "end": 56987, "text": "Or what man is there of you, whom if his son ask bread, will he give him a stone?", "words": [[0, 52555]