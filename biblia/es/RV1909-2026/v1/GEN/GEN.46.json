{"book": "GEN", "chapter": 46, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 279685, "verses": [{"verse": 1, "start": 300, "end": 8296, "text": "Salió Israel con todo lo que tenía, y vino a Beerseba, y ofreció sacrificios al Dios de su padre Isaac.", "words": [[0, 300], [6, 688], [13, 1188], [17, 1528], [22, 1868], [25, 2088], [29, 2488], [36, 2888], [38, 3168], [43, 3428], [45, 4016], [55, 4603], [57, 4683], [65, 5283], [77, 6223], [80, 6423], [85, 6683], [88, 6923], [91, 7063], [97, 7583]]}, {"verse": 2, "start": 8646, "end": 16427, "text": "Y habló Dios a Israel en visiones de noche, y dijo: Jacob, Jacob. Y él respondió: Aquí estoy.", "words": [[0, 8646], [2, 8950], [8, 9290], [13, 9430], [15, 9670], [22, 10150], [25, 10350], [34, 10850], [37, 10970], [44, 11770], [46, 12010], [52, 13107], [59, 13467], [66, 14332], [68, 14514], [71, 14654], [82, 15649], [87, 15873]]}, {"verse": 3, "start": 16707, "end": 24147, "text": "Y dijo: Yo soy Dios, el Dios de tu padre; no temas de descender a Egipto, porque yo te pondré allí en gran nación.", "words": [[0, 16707], [2, 16835], [8, 17557], [11, 17705], [15, 17885], [21, 18445], [24, 18505], [29, 18685], [32, 18865], [35, 18985], [42, 20010], [45, 20127], [51, 20447], [54, 20667], [64, 21127], [66, 21247], [74, 21927], [81, 22287], [84, 22467], [87, 22607], [94, 23007], [99, 23247], [102, 23387], [107, 23547]]}, {"verse": 4, "start": 24738, "end": 31469, "text": "Yo descenderé contigo a Egipto, y yo también te haré volver: y José pondrá su mano sobre tus ojos.", "words": [[0, 24738], [3, 25006], [14, 25586], [22, 26046], [24, 26126], [32, 26646], [34, 27026], [37, 27146], [45, 27426], [48, 27746], [53, 27946], [61, 28960], [63, 29079], [68, 29359], [75, 29839], [78, 29999], [83, 30279], [89, 30579], [93, 30799]]}, {"verse": 5, "start": 31978, "end": 44045, "text": "Y se levantó Jacob de Beerseba; y tomaron los hijos de Israel a su padre Jacob, y a sus niños, y a sus mujeres, en los carros que Faraón había enviado para llevarlo.", "words": [[0, 31978], [2, 32105], [5, 32225], [13, 32805], [19, 33145], [22, 33747], [32, 34506], [34, 34819], [42, 35219], [46, 35399], [52, 35679], [55, 35859], [62, 36239], [64, 36419], [67, 36539], [73, 36899], [80, 37339], [82, 37704], [84, 37764], [88, 37904], [95, 38324], [97, 38844], [99, 38904], [103, 39064], [112, 39524], [115, 40104], [119, 40244], [126, 40864], [130, 41344], [137, 41824], [143, 42164], [151, 42964], [156, 43244]]}, {"verse": 6, "start": 44395, "end": 54278, "text": "Y tomaron sus ganados, y sus bienes que había adquirido en la tierra de Canaán, y se vinieron a Egipto, Jacob, y toda su descendencia consigo;", "words": [[0, 44395], [2, 44492], [10, 44932], [14, 45152], [23, 45772], [25, 46127], [29, 46287], [36, 46767], [40, 46887], [46, 47167], [56, 47887], [59, 47987], [62, 48107], [69, 48427], [72, 48667], [80, 49247], [82, 49727], [85, 49847], [94, 50267], [96, 50427], [104, 51247], [111, 51667], [113, 52227], [118, 52447], [121, 52707], [134, 53507]]}, {"verse": 7, "start": 54628, "end": 64402, "text": "Sus hijos, y los hijos de sus hijos consigo; sus hijas, y las hijas de sus hijos, y a toda su descendencia trajo consigo a Egipto.", "words": [[0, 54628], [4, 54828], [11, 55208], [13, 55508], [17, 55688], [23, 56008], [26, 56568], [30, 56808], [36, 57108], [45, 58195], [49, 58360], [56, 58940], [58, 59300], [62, 59480], [68, 59900], [71, 60020], [75, 60220], [82, 60540], [84, 61020], [86, 61140], [91, 61300], [94, 61600], [107, 62480], [113, 63000], [121, 63420], [123, 63720]]}, {"verse": 8, "start": 64752, "end": 74160, "text": "Y estos son los nombres de los hijos de Israel, que entraron en Egipto, Jacob y sus hijos: Rubén, el primogénito de Jacob.", "words": [[0, 64752], [2, 64938], [8, 65158], [12, 65558], [16, 65738], [24, 66218], [27, 66398], [31, 66518], [37, 66838], [40, 67038], [48, 67538], [52, 68138], [61, 68898], [64, 69018], [72, 69698], [78, 69958], [80, 70398], [84, 70618], [91, 71490], [98, 72416], [101, 72516], [113, 73356], [116, 73496]]}, {"verse": 9, "start": 74510, "end": 78819, "text": "Y los hijos de Rubén: Hanoc, y Falú, y Hezrón, y Carmi.", "words": [[0, 74510], [2, 74611], [6, 74731], [12, 74991], [15, 75211], [22, 76380], [29, 76739], [31, 77097], [37, 77455], [39, 77814], [47, 78172], [49, 78531]]}, {"verse": 10, "start": 79169, "end": 86674, "text": "Y los hijos de Simeón: Jemuel, y Jamín, y Ohad, y Jaquín, y Zohar, y Saúl, hijo de la cananea.", "words": [[0, 79169], [2, 79268], [6, 79408], [12, 79667], [15, 79887], [23, 80900], [31, 81273], [33, 81684], [40, 82095], [42, 82506], [48, 82917], [50, 83327], [58, 83738], [60, 84149], [67, 84560], [69, 84971], [75, 85382], [80, 85542], [83, 85742], [86, 85882]]}, {"verse": 11, "start": 87024, "end": 91376, "text": "Y los hijos de Leví: Gersón, y Coat, y Merari.", "words": [[0, 87024], [2, 87346], [6, 87486], [12, 87786], [15, 88026], [21, 88979], [29, 89299], [31, 89579], [37, 90139], [39, 90699]]}, {"verse": 12, "start": 91726, "end": 103152, "text": "Y los hijos de Judá: Er, y Onán, y Sela, y Fares, y Zara: mas Er y Onán, murieron en la tierra de Canaán. Y los hijos de Fares fueron Hezrón y Hamul.", "words": [[0, 91726], [2, 91814], [6, 91954], [12, 92234], [15, 92414], [21, 93119], [25, 95249], [27, 95336], [33, 95423], [35, 95511], [41, 95598], [43, 95685], [50, 95772], [52, 95859], [58, 96147], [62, 96419], [65, 96724], [67, 97029], [73, 97334], [82, 98114], [85, 98394], [88, 98534], [95, 98914], [98, 99414], [106, 100084], [108, 100208], [112, 100348], [118, 100648], [121, 100828], [127, 101268], [134, 101818], [141, 102368], [143, 102788]]}, {"verse": 13, "start": 103502, "end": 108668, "text": "Y los hijos de Isacar: Tola, y Fúa, y Job, y Simrón.", "words": [[0, 103502], [2, 103591], [6, 103731], [12, 104051], [15, 104291], [23, 105228], [29, 105739], [31, 105919], [36, 106819], [38, 107229], [43, 107639], [45, 108181]]}, {"verse": 14, "start": 109018, "end": 113175, "text": "Y los hijos de Zabulón: Sered, y Elón, y Jahleel.", "words": [[0, 109018], [2, 109126], [6, 109266], [12, 109606], [15, 110176], [24, 111291], [31, 111675], [33, 112058], [39, 112442], [41, 112826]]}, {"verse": 15, "start": 113525, "end": 124011, "text": "Estos fueron los hijos de Lea, los que parió a Jacob en Padan-aram, y además su hija Dina: treinta y tres las almas todas de sus hijos e hijas.", "words": [[0, 113525], [6, 113749], [13, 114049], [17, 114249], [23, 114549], [26, 114749], [31, 115349], [35, 115789], [39, 115929], [45, 116349], [47, 116509], [53, 116849], [56, 117209], [68, 118069], [70, 118549], [77, 118849], [80, 119322], [85, 119796], [91, 120667], [99, 120947], [101, 121227], [106, 121507], [110, 121667], [116, 122047], [122, 122327], [125, 122587], [129, 122787], [135, 123067], [137, 123347]]}, {"verse": 16, "start": 124361, "end": 132495, "text": "Y los hijos de Gad: Zifión, y Hagui, y Ezbón, y Suni, y Heri, y Arodi, y Areli.", "words": [[0, 124361], [2, 124661], [6, 124821], [12, 125101], [15, 125421], [20, 126424], [28, 126714], [30, 127204], [37, 127694], [39, 128284], [46, 128874], [48, 129364], [54, 129854], [56, 130304], [62, 130754], [64, 130874], [71, 131714], [73, 131814]]}, {"verse": 17, "start": 132845, "end": 143095, "text": "Y los hijos de Aser: Imna, e Isúa, e Isúi, y Beria, y Sera, hermana de ellos. Los hijos de Beria: Heber, y Malquiel.", "words": [[0, 132845], [2, 132972], [6, 133092], [12, 133392], [15, 134132], [21, 135391], [27, 135766], [29, 136141], [35, 136516], [37, 136891], [43, 137266], [45, 137641], [52, 138016], [54, 138236], [60, 138496], [68, 139036], [71, 139216], [78, 139973], [82, 140391], [88, 140671], [91, 141101], [98, 141900], [105, 142110], [107, 142640]]}, {"verse": 18, "start": 143445, "end": 151816, "text": "Estos fueron los hijos de Zilpa, la que Labán dio a su hija Lea, y parió estos a Jacob; todas dieciséis almas.", "words": [[0, 143445], [6, 143712], [13, 143932], [17, 144132], [23, 144412], [26, 144912], [33, 145412], [36, 145532], [40, 145872], [46, 146212], [50, 146552], [52, 146812], [55, 147125], [60, 147439], [65, 147752], [67, 148092], [73, 148412], [79, 148732], [81, 148952], [88, 149775], [94, 150309], [104, 150879]]}, {"verse": 19, "start": 152166, "end": 156617, "text": "Y los hijos de Raquel, mujer de Jacob: José y Benjamín.", "words": [[0, 152166], [2, 152556], [6, 152696], [12, 152916], [15, 153156], [23, 153716], [29, 154196], [32, 154396], [39, 155168], [44, 155646], [46, 156161]]}, {"verse": 20, "start": 156967, "end": 165485, "text": "Y nacieron a José en la tierra de Egipto Manasés y Efraín, los que le parió Asenat, hija de Potifera, sacerdote de On.", "words": [[0, 156967], [2, 157067], [11, 157427], [13, 157547], [18, 157927], [21, 158227], [24, 158347], [31, 158687], [34, 158967], [41, 159547], [49, 160007], [51, 160267], [59, 161247], [63, 161327], [67, 161467], [70, 161587], [76, 162099], [84, 162612], [89, 162952], [92, 163032], [102, 164112], [112, 164570], [115, 165027]]}, {"verse": 21, "start": 165835, "end": 175502, "text": "Y los hijos de Benjamín fueron Bela, y Bequer y Asbel, y Gera, y Naamán, y Ehi, y Ros y Mupim, y Hupim, y Ard.", "words": [[0, 165835], [2, 165959], [6, 166099], [12, 166379], [15, 166599], [24, 167179], [31, 167439], [37, 168504], [39, 168781], [46, 169057], [48, 169334], [55, 169611], [57, 169887], [63, 170164], [65, 170604], [73, 171111], [75, 171617], [80, 172124], [82, 172324], [86, 172684], [88, 173044], [95, 173551], [97, 174057], [104, 174564], [106, 175044]]}, {"verse": 22, "start": 175852, "end": 181714, "text": "Estos fueron los hijos de Raquel, que nacieron a Jacob: en todas, catorce almas.", "words": [[0, 175852], [6, 176094], [13, 176474], [17, 176694], [23, 176994], [26, 177194], [34, 177754], [38, 177834], [47, 178294], [49, 178474], [56, 180392], [59, 180392], [66, 180392], [74, 181014]]}, {"verse": 23, "start": 182064, "end": 185681, "text": "Y los hijos de Dan: Husim.", "words": [[0, 182064], [2, 182189], [6, 182309], [12, 182569], [15, 182809], [20, 184893]]}, {"verse": 24, "start": 186031, "end": 188924, "text": "Y los hijos de Neftalí: Jahzeel, y Guni, y Jezer, y Silem.", "words": [[0, 186138], [2, 186274], [6, 186411], [12, 186547], [15, 186683], [24, 187233], [33, 187428], [35, 187622], [41, 187816], [43, 188010], [50, 188205], [52, 188399]]}, {"verse": 25, "start": 189274, "end": 197145, "text": "Estos fueron los hijos de Bilha, la que dio Labán a Raquel su hija, y parió estos a Jacob; todas siete almas.", "words": [[0, 189274], [6, 189537], [13, 189837], [17, 190057], [23, 190337], [26, 190797], [33, 191257], [36, 191497], [40, 191637], [44, 191857], [50, 192317], [52, 192597], [59, 192877], [62, 193077], [68, 193737], [70, 193897], [76, 194316], [82, 194734], [84, 195153], [91, 195728], [97, 196016], [103, 196396]]}, {"verse": 26, "start": 197495, "end": 207823, "text": "Todas las personas que vinieron con Jacob a Egipto, descendientes directos de Jacob, sin las mujeres de los hijos de Jacob, todas las personas fueron sesenta y seis.", "words": [[0, 197495], [6, 197760], [10, 197920], [19, 198320], [23, 198540], [32, 198980], [36, 199200], [42, 199540], [44, 199840], [52, 200660], [66, 201600], [75, 202220], [78, 202300], [85, 202700], [89, 203340], [93, 203580], [101, 203980], [104, 204220], [108, 204320], [114, 204580], [117, 204760], [124, 205480], [130, 205660], [134, 205840], [143, 206240], [150, 206651], [158, 207061], [160, 207472]]}, {"verse": 27, "start": 208173, "end": 217857, "text": "Y los hijos de José, que le nacieron en Egipto, dos personas. Todas las almas de la casa de Jacob, que entraron en Egipto, fueron setenta.", "words": [[0, 208173], [2, 208296], [6, 208436], [12, 208716], [15, 208916], [21, 209216], [25, 209436], [28, 209556], [37, 210096], [40, 210276], [48, 211016], [52, 211156], [62, 212259], [68, 212646], [72, 212886], [78, 213366], [81, 213526], [84, 213626], [89, 213926], [92, 214146], [99, 214546], [103, 215026], [112, 215726], [115, 215926], [123, 216526], [130, 217226]]}, {"verse": 28, "start": 218207, "end": 224739, "text": "Y envió a Judá delante de sí a José, para que le viniese a ver a Gosén; y llegaron a la tierra de Gosén.", "words": [[0, 218207], [2, 218331], [8, 218711], [10, 218871], [15, 219171], [23, 219551], [26, 219751], [29, 219911], [31, 220051], [37, 220351], [42, 220746], [46, 220886], [49, 221026], [57, 221486], [59, 221586], [63, 221726], [65, 222129], [72, 222702], [74, 222806], [83, 223286], [85, 223406], [88, 223466], [95, 223946], [98, 224368]]}, {"verse": 29, "start": 225089, "end": 236362, "text": "Y José unció su carro y vino a recibir a Israel su padre a Gosén; y se manifestó a él, y se echó sobre su cuello, y lloró sobre su cuello bastante.", "words": [[0, 225089], [2, 225231], [7, 225511], [13, 226111], [16, 226311], [22, 226731], [24, 227211], [29, 227451], [31, 227571], [39, 227931], [41, 228151], [48, 228631], [51, 228831], [57, 229230], [59, 229629], [66, 230204], [68, 230459], [71, 230579], [81, 231319], [83, 231459], [87, 232039], [89, 232299], [92, 232439], [97, 232779], [103, 233059], [106, 233259], [114, 234199], [116, 234299], [122, 234619], [128, 234859], [131, 235099], [138, 235459]]}, {"verse": 30, "start": 236712, "end": 243034, "text": "Entonces Israel dijo a José: Muera yo ahora, ya que he visto tu rostro, pues aun vives.", "words": [[0, 236712], [9, 237214], [16, 237914], [21, 238494], [23, 238854], [29, 239586], [35, 239904], [38, 240104], [45, 240404], [48, 240624], [52, 240804], [55, 240864], [61, 241124], [64, 241304], [72, 242104], [77, 242204], [81, 242384]]}, {"verse": 31, "start": 243314, "end": 256022, "text": "Y José dijo a sus hermanos, y a la casa de su padre: Subiré y haré saber a Faraón, y le diré: Mis hermanos y la casa de mi padre, que estaban en la tierra de Canaán, han venido a mí;", "words": [[0, 243314], [2, 243476], [7, 243716], [12, 244176], [14, 244336], [18, 244496], [28, 245356], [30, 245876], [32, 245976], [35, 246056], [40, 246376], [43, 246616], [46, 246776], [53, 247694], [60, 248101], [62, 248281], [67, 248521], [73, 248721], [75, 249011], [83, 249301], [85, 249381], [88, 249481], [94, 250121], [98, 250223], [107, 250783], [109, 250883], [112, 250983], [117, 251243], [120, 251423], [123, 251543], [130, 251883], [134, 252123], [142, 252463], [145, 252643], [148, 252763], [155, 253023], [158, 253223], [166, 253703], [170, 254003], [177, 254383], [179, 254523]]}, {"verse": 32, "start": 256372, "end": 263092, "text": "Y los hombres son pastores de ovejas, porque son hombres ganaderos: y han traído sus ovejas y sus vacas, y todo lo que tenían.", "words": [[0, 256372], [2, 256456], [6, 256576], [14, 256856], [18, 257096], [27, 257576], [30, 257756], [38, 258236], [45, 258511], [49, 258751], [57, 259031], [68, 260082], [70, 260200], [74, 260300], [81, 260620], [85, 260780], [92, 261220], [94, 261380], [98, 261540], [105, 262040], [107, 262160], [112, 262320], [115, 262480], [119, 262580]]}, {"verse": 33, "start": 263442, "end": 266796, "text": "Y cuando Faraón os llame y diga: ¿cuál es vuestro oficio?", "words": [[0, 263442], [2, 263527], [9, 263747], [16, 263967], [19, 264187], [25, 264587], [27, 264727], [33, 265331], [39, 265635], [42, 265755], [50, 266135]]}, {"verse": 34, "start": 267146, "end": 279285, "text": "Entonces diréis: Tus siervos se han dedicado a criar ganado desde nuestra juventud hasta ahora, al igual que nuestros padres; a fin de que moréis en la tierra de Gosén, porque los egipcios detestan el oficio de pastor.", "words": [[0, 267146], [9, 267527], [17, 268337], [21, 268439], [29, 268879], [32, 269039], [36, 269119], [45, 269639], [47, 269719], [53, 269959], [60, 270419], [66, 270599], [74, 270879], [83, 271579], [89, 271799], [96, 272339], [99, 272619], [105, 272819], [109, 273019], [118, 273239], [126, 274099], [128, 274223], [132, 274443], [135, 274603], [139, 274703], [146, 275143], [149, 275263], [152, 275383], [159, 275643], [162, 275993], [169, 276343], [176, 276683], [180, 276903], [189, 277443], [198, 278043], [201, 278163], [208, 278503], [211, 278643]]}]}