{"book": "GEN", "chapter": 11, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 202173, "verses": [{"verse": 1, "start": 300, "end": 3741, "text": "And the whole earth was of one language, and of one speech.", "words": [[0, 300], [4, 433], [8, 553], [14, 793], [20, 1093], [24, 1333], [27, 1493], [31, 1733], [41, 2193], [45, 2733], [48, 2873], [52, 3053]]}, {"verse": 2, "start": 4091, "end": 10826, "text": "And it came to pass, as they journeyed from the east, that they found a plain in the land of Shinar; and they dwelt there.", "words": [[0, 4091], [4, 4216], [7, 4336], [12, 4516], [15, 4696], [21, 5156], [24, 5516], [29, 5676], [39, 6156], [44, 6296], [48, 6436], [54, 6816], [59, 7396], [64, 7536], [70, 7776], [72, 7976], [78, 8176], [81, 8416], [85, 8516], [90, 8756], [93, 8856], [101, 9783], [105, 9904], [110, 10024], [116, 10364]]}, {"verse": 3, "start": 11176, "end": 18926, "text": "And they said one to another, Go to, let us make brick, and burn them thoroughly. And they had brick for stone, and tar had they for mortar.", "words": [[0, 11176], [4, 11306], [9, 11406], [14, 11626], [18, 11906], [21, 12126], [30, 12921], [33, 13065], [37, 13245], [41, 13425], [44, 13565], [49, 13765], [56, 14065], [60, 14585], [65, 14885], [70, 15165], [82, 16043], [86, 16179], [91, 16279], [95, 16419], [101, 16639], [105, 16879], [112, 17219], [116, 17479], [120, 17799], [124, 18099], [129, 18259], [133, 18419]]}, {"verse": 4, "start": 19276, "end": 28636, "text": "And they said, Go to, let us build us a city and a tower, whose top may reach to heaven; and let us make us a name, lest we be scattered abroad upon the face of the whole earth.", "words": [[0, 19276], [4, 19616], [9, 19756], [15, 20363], [18, 20482], [22, 20642], [26, 20802], [29, 20942], [35, 21142], [38, 21342], [40, 21502], [45, 21682], [49, 21822], [51, 21922], [58, 22462], [64, 22702], [68, 23002], [72, 23242], [78, 23522], [81, 23682], [89, 24316], [93, 24416], [97, 24556], [1