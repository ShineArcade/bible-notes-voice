{"book": "LUK", "chapter": 23, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 440184, "verses": [{"verse": 1, "start": 300, "end": 5634, "text": "Levantándose entonces toda la multitud de ellos, le llevaron a Pilato.", "words": [[0, 300], [13, 1218], [22, 1858], [27, 2338], [30, 2558], [39, 3118], [42, 3338], [49, 3878], [52, 4418], [61, 4878], [63, 4998]]}, {"verse": 2, "start": 6084, "end": 16527, "text": "Y comenzaron a acusarle, diciendo: A este hemos hallado que pervierte la nación, y que prohíbe pagar impuestos a César, diciendo que él es el Cristo, el rey.", "words": [[0, 6084], [2, 6210], [13, 6870], [15, 7150], [25, 7870], [35, 9353], [37, 9471], [42, 9711], [48, 9911], [56, 10371], [60, 10681], [70, 10991], [73, 11151], [81, 11611], [83, 12111], [87, 12231], [95, 12631], [101, 12851], [111, 13431], [113, 13671], [120, 14451], [129, 14811], [133, 15131], [136, 15311], [139, 15471], [142, 15591], [150, 16131], [153, 16191]]}, {"verse": 3, "start": 16877, "end": 26038, "text": "Entonces Pilato le preguntó, diciendo: ¿Eres tú el Rey de los judíos? Y respondiéndole él, dijo: Tú lo dices.", "words": [[0, 16877], [9, 17442], [16, 18222], [19, 18422], [29, 19382], [39, 20767], [45, 20955], [48, 21255], [51, 21435], [55, 21655], [58, 21715], [62, 21855], [70, 22913], [72, 23037], [87, 23957], [91, 24237], [97, 25065], [100, 25189], [103, 25329]]}, {"verse": 4, "start": 26488, "end": 32506, "text": "Y Pilato dijo a los principales sacerdotes, y a la gente: Ninguna culpa hallo en este hombre.", "words": [[0, 26488], [2, 26762], [9, 27262], [14, 27562], [16, 27742], [20, 27842], [32, 28662], [44, 29582], [46, 29722], [48, 29802], [51, 29822], [58, 30683], [66, 30981], [72, 31371], [78, 31761], [81, 31841], [86, 32061]]}, {"verse": 5, "start": 32856, "end": 40645, "text": "Pero ellos insistían, diciendo: Alborota al pueblo, enseñando por toda Judea, comenzando desde Galilea hasta aquí.", "words": [[0, 32856], [5, 33043], [11, 33323], [22, 34163], [32, 36034], [41, 36470], [44, 36610], [52, 36850], [62, 37490], [66, 37650], [71, 37830], [78, 38670], [89, 39290], [95, 39470], [103, 40030], [109, 40230]]}, {"verse": 6, "start": 40995, "end": 45774, "text": "Entonces Pilato, oyendo de Galilea, preguntó si el hombre era galileo.", "words": [[0, 40995], [9, 41469], [17, 42289], [24, 42669], [27, 42849], [36, 43569], [45, 44049], [48, 44209], [51, 44389], [58, 44669], [62, 44949]]}, {"verse": 7, "start": 46224, "end": 54869, "text": "Y como entendió que era de la jurisdicción de Herodes, le remitió a Herodes, el cual también estaba en Jerusalén en aquellos días.", "words": [[0, 46224], [2, 46324], [7, 46524], [16, 47064], [20, 47244], [24, 47424], [27, 47564], [30, 47704], [43, 48524], [46, 48684], [55, 49524], [58, 49624], [66, 50324], [68, 50604], [77, 51424], [80, 51544], [85, 51784], [93, 52224], [100, 52604], [103, 52784], [113, 53524], [116, 53724], [125, 54004]]}, {"verse": 8, "start": 55319, "end": 67475, "text": "Y Herodes, viendo a Jesús, se alegró mucho, porque hacía mucho que deseaba verle; porque había oído de él muchas cosas, y tenía esperanza que le vería hacer alguna señal.", "words": [[0, 55319], [2, 55503], [11, 55883], [18, 56303], [20, 56563], [27, 56923], [30, 57503], [37, 57843], [44, 58703], [51, 59103], [57, 59463], [63, 59783], [67, 60003], [75, 60503], [82, 61451], [89, 61654], [95, 62014], [100, 62614], [103, 62834], [106, 63034], [113, 63294], [120, 63834], [122, 64594], [128, 64834], [138, 65474], [142, 65634], [145, 65774], [151, 66114], [157, 66414], [164, 66714]]}, {"verse": 9, "start": 67925, "end": 72970, "text": "Y le preguntaba con muchas palabras; pero él nada le respondió:", "words": [[0, 67925], [2, 68051], [5, 68151], [16, 68811], [20, 69071], [27, 69391], [37, 70600], [42, 70785], [45, 71045], [50, 71745], [53, 72025]]}, {"verse": 10, "start": 73420, "end": 80084, "text": "Y estaban los principales sacerdotes y los escribas acusándolo con gran insistencia.", "words": [[0, 73420], [2, 73528], [10, 73888], [14, 74148], [26, 75048], [37, 76028], [39, 76288], [43, 76408], [52, 77088], [63, 78108], [67, 78348], [72, 78648]]}, {"verse": 11, "start": 80534, "end": 89701, "text": "Pero Herodes con su corte le menospreció, y se burló de él, vistiéndole de una ropa rica; y le volvió a enviar a Pilato.", "words": [[0, 80534], [5, 80717], [13, 81097], [17, 81377], [20, 81707], [26, 82037], [29, 82117], [42, 83037], [44, 83417], [47, 83597], [53, 84057], [56, 84217], [60, 84657], [72, 85617], [75, 85777], [79, 85897], [84, 86317], [90, 87277], [92, 87420], [95, 87500], [102, 88100], [104, 88280], [111, 88820], [113, 89040]]}, {"verse": 12, "start": 90151, "end": 96994, "text": "Y fueron hechos amigos entre sí Pilato y Herodes en el mismo día; porque antes eran enemigos entre sí.", "words": [[0, 90151], [2, 90272], [9, 90492], [16, 90852], [23, 91232], [29, 91632], [32, 91912], [39, 92472], [41, 92672], [49, 93132], [52, 93312], [55, 93432], [61, 93712], [66, 94487], [73, 94729], [79, 95269], [84, 95649], [93, 96229], [99, 96569]]}, {"verse": 13, "start": 97444, "end": 103658, "text": "Entonces Pilato, convocando los principales sacerdotes, y los dirigentes, y el pueblo,", "words": [[0, 97444], [9, 98067], [17, 98987], [28, 99787], [32, 99967], [44, 100767], [56, 101567], [58, 101727], [62, 101847], [74, 102507], [76, 102827], [79, 103007]]}, {"verse": 14, "start": 104108, "end": 115478, "text": "Les dijo: Me habéis presentado a este por hombre que desvía al pueblo: y he aquí, preguntando yo delante de vosotros, no he hallado culpa alguna en este hombre de aquellas de que le acusáis.", "words": [[0, 104108], [4, 104325], [10, 105556], [13, 105657], [20, 105877], [31, 106557], [33, 106697], [38, 106937], [42, 107197], [49, 107417], [53, 107617], [60, 108077], [63, 108197], [71, 108995], [73, 109136], [76, 109236], [82, 109496], [94, 110176], [97, 110336], [105, 110756], [108, 110876], [118, 111736], [121, 111936], [124, 112076], [132, 112396], [138, 112616], [145, 113076], [148, 113276], [153, 113476], [160, 113756], [163, 113936], [172, 114416], [175, 114556], [179, 114656], [182, 114796]]}, {"verse": 15, "start": 115928, "end": 121871, "text": "Y ni aun Herodes; porque os remití a él, y he aquí, ninguna cosa digna de muerte ha hecho.", "words": [[0, 115928], [2, 116091], [5, 116171], [9, 116676], [18, 117432], [25, 117631], [28, 117811], [35, 118311], [37, 118411], [41, 118651], [43, 118891], [46, 119011], [52, 119311], [60, 119931], [65, 120391], [71, 120811], [74, 120911], [81, 121171], [84, 121431]]}, {"verse": 16, "start": 122321, "end": 124678, "text": "Le soltaré, pues, después de castigarlo.", "words": [[0, 122366], [3, 122446], [12, 122716], [18, 122986], [26, 123226], [29, 123826]]}, {"verse": 17, "start": 125027, "end": 128574, "text": "Y tenía necesidad de soltarles uno en cada fiesta.", "words": [[0, 125027], [2, 125254], [8, 125514], [18, 126274], [21, 126434], [31, 127214], [35, 127574], [38, 127714], [43, 127934]]}, {"verse": 18, "start": 129024, "end": 135745, "text": "Pero toda la multitud dio voces a una, diciendo: Quita a este, y suéltanos a Barrabás:", "words": [[0, 129024], [5, 129169], [10, 129609], [13, 129889], [22, 130649], [26, 130949], [32, 131389], [34, 131589], [39, 132169], [49, 133191], [55, 133351], [57, 133551], [63, 133951], [65, 134371], [75, 134951], [77, 135131]]}, {"verse": 19, "start": 136095, "end": 142498, "text": "(El cual había sido echado en la cárcel por una revuelta ocurrida en la ciudad y un homicidio.)", "words": [[0, 136095], [4, 136252], [9, 136532], [15, 136932], [20, 137352], [27, 137872], [30, 137992], [33, 138132], [40, 138652], [44, 138952], [48, 139132], [57, 139832], [66, 140632], [69, 140812], [72, 140932], [79, 141252], [81, 141572], [84, 141712]]}, {"verse": 20, "start": 142948, "end": 146410, "text": "Y les habló otra vez Pilato, queriendo soltar a Jesús.", "words": [[0, 142948], [2, 143055], [6, 143195], [12, 143615], [17, 143875], [21, 144095], [29, 144715], [39, 145195], [46, 145675], [48, 145775]]}, {"verse": 21, "start": 146860, "end": 156754, "text": "Pero ellos volvieron a dar voces, diciendo: Crucifícale, crucifícale.", "words": [[0, 146860], [5, 147042], [11, 147342], [21, 147922], [23, 148062], [27, 148202], [34, 148842], [44, 150215], [57, 151074]]}, {"verse": 22, "start": 157104, "end": 166663, "text": "Y él les dijo la tercera vez: ¿Pues qué mal ha hecho este? Ninguna culpa de muerte he hallado en él: le castigaré, pues, y le soltaré.", "words": [[0, 157104], [2, 157324], [5, 157564], [9, 157964], [14, 158424], [17, 158624], [25, 159204], [30, 160043], [36, 160199], [40, 160379], [44, 160599], [47, 160759], [53, 160999], [59, 161838], [67, 162241], [73, 162481], [76, 162721], [83, 163061], [86, 163341], [94, 163721], [97, 163901], [101, 164488], [104, 164573], [115, 165193], [121, 165493], [123, 165813], [126, 165933]]}, {"verse": 23, "start": 167013, "end": 175793, "text": "Pero ellos instaban a grandes voces, pidiendo que fuese crucificado. Y las voces de ellos y de los principales sacerdotes crecían.", "words": [[0, 167013], [5, 167178], [11, 167418], [20, 168158], [22, 168298], [30, 168558], [37, 169358], [46, 169798], [50, 169958], [56, 170298], [69, 171726], [71, 171834], [75, 171954], [81, 172354], [84, 172514], [90, 172814], [92, 173274], [95, 173354], [99, 173474], [111, 174214], [122, 174874]]}, {"verse": 24, "start": 176243, "end": 180473, "text": "Entonces Pilato juzgó que se hiciese lo que ellos pedían;", "words": [[0, 176243], [9, 176873], [16, 177453], [22, 178013], [26, 178173], [29, 178373], [37, 179033], [40, 179253], [44, 179413], [50, 179633]]}, {"verse": 25, "start": 180923, "end": 192222, "text": "Y les soltó a aquel que había sido echado en la cárcel por una revuelta y un homicidio, al cual habían pedido; y entregó a Jesús a la voluntad de ellos.", "words": [[0, 180923], [2, 181080], [6, 181200], [12, 181820], [14, 182160], [20, 182600], [24, 182740], [30, 182960], [35, 183340], [42, 183780], [45, 183900], [48, 184040], [55, 184520], [59, 184780], [63, 184980], [72, 185700], [74, 185840], [77, 186000], [88, 186710], [91, 187420], [96, 187640], [103, 188160], [111, 189328], [113, 189469], [121, 189969], [123, 190069], [129, 190429], [131, 190729], [134, 190809], [143, 191449], [146, 191629]]}, {"verse": 26, "start": 192672, "end": 201603, "text": "Y llevándole, tomaron a un Simón cireneo, que venía del campo, y le pusieron encima la cruz para que la llevase tras Jesús.", "words": [[0, 192672], [2, 192793], [14, 193353], [22, 194013], [24, 194273], [27, 194413], [33, 194953], [42, 195493], [46, 196013], [52, 196273], [56, 196533], [63, 197033], [65, 197593], [68, 197713], [77, 198173], [84, 198773], [87, 198993], [92, 199673], [97, 199973], [101, 200113], [104, 200253], [112, 200673], [117, 200893]]}, {"verse": 27, "start": 202053, "end": 208368, "text": "Y le seguía una grande multitud de pueblo, y de mujeres, las cuales le lloraban y lamentaban.", "words": [[0, 202053], [2, 202157], [5, 202297], [12, 202757], [16, 202917], [23, 203257], [32, 203977], [35, 204137], [43, 204577], [45, 204737], [48, 204857], [57, 205697], [61, 205817], [68, 206137], [71, 206597], [80, 207117], [82, 207377]]}, {"verse": 28, "start": 208818, "end": 218827, "text": "Pero Jesús, vuelto a ellas, les dice: Hijas de Jerusalén, no me lloréis a mí, sino llorad por vosotras mismas, y por vuestros hijos.", "words": [[0, 208818], [5, 208946], [12, 209606], [19, 209986], [21, 210106], [28, 210646], [32, 210746], [38, 211561], [44, 212024], [47, 212204], [58, 213024], [61, 213264], [64, 213564], [72, 213864], [74, 213984], [78, 214524], [83, 215074], [90, 215624], [94, 215984], [103, 216624], [111, 217504], [113, 217624], [117, 217844], [126, 218264]]}, {"verse": 29, "start": 219277, "end": 229206, "text": "Porque he aquí vendrán días en que dirán: Bienaventuradas las estériles, y los vientres que no engendraron, y los pechos que no amamantaron.", "words": [[0, 219277], [7, 219362], [10, 219482], [15, 219702], [23, 220402], [28, 220762], [31, 221102], [35, 221242], [42, 222766], [58, 223336], [62, 223556], [73, 224356], [75, 224936], [79, 225076], [88, 225536], [92, 225696], [95, 226236], [108, 226776], [110, 227096], [114, 227236], [121, 227676], [125, 227836], [128, 228036]]}, {"verse": 30, "start": 229656, "end": 236765, "text": "Entonces comenzarán a decir a los montes: Caed sobre nosotros: y a las colinas: Cubridnos.", "words": [[0, 229656], [9, 230061], [20, 230921], [22, 230981], [28, 231301], [30, 231461], [34, 231581], [42, 232608], [47, 232973], [53, 233273], [63, 234419], [65, 234659], [67, 234719], [71, 234839], [80, 236321]]}, {"verse": 31, "start": 237215, "end": 242223, "text": "Porque si en el árbol verde hacen estas cosas, ¿en el seco, qué se hará?", "words": [[0, 237215], [7, 237439], [10, 237679], [13, 237879], [16, 238019], [22, 238359], [28, 238819], [34, 239279], [40, 239559], [47, 240559], [51, 240799], [54, 240919], [60, 241419], [64, 241519], [67, 241719]]}, {"verse": 32, "start": 242673, "end": 247364, "text": "Y llevaban también con él otros dos, malhechores, a ser muertos.", "words": [[0, 242673], [2, 242780], [11, 243260], [19, 243640], [23, 243880], [26, 244100], [32, 244420], [37, 245130], [50, 245840], [52, 246320], [56, 246500]]}, {"verse": 33, "start": 247814, "end": 257017, "text": "Y cuando vinieron al lugar que se llama de la Calavera, le crucificaron allí, y a los malhechores, uno a la derecha, y otro a la izquierda.", "words": [[0, 247814], [2, 247933], [9, 248153], [18, 248753], [21, 248933], [27, 249273], [31, 249493], [34, 249613], [40, 249873], [43, 250053], [46, 250173], [56, 251273], [59, 251353], [72, 252273], [78, 252633], [80, 253133], [82, 253233], [86, 253793], [99, 254353], [103, 254693], [105, 254893], [108, 254973], [117, 255533], [119, 255773], [124, 255993], [126, 256153], [129, 256233]]}, {"verse": 34, "start": 257467, "end": 265771, "text": "Y Jesús decía: Padre, perdónalos, porque no saben lo que hacen. Y partiendo sus vestidos, echaron suertes.", "words": [[0, 257467], [2, 257592], [8, 257912], [15, 259010], [22, 259413], [34, 260233], [41, 260793], [44, 261013], [50, 261393], [53, 261613], [57, 261753], [64, 262706], [66, 262794], [76, 263414], [80, 263654], [90, 264274], [98, 264874]]}, {"verse": 35, "start": 266221, "end": 278630, "text": "Y el pueblo estaba mirando; y se burlaban de él los dirigentes con ellos, diciendo: A otros hizo salvos: sálvese a sí, si este es el Mesías, el escogido de Dios.", "words": [[0, 266221], [2, 266477], [5, 266597], [12, 266937], [19, 267277], [28, 268418], [30, 268565], [33, 268705], [42, 269305], [45, 269565], [48, 269745], [52, 269885], [63, 270485], [67, 270765], [74, 271065], [84, 272349], [86, 272493], [92, 272956], [97, 273420], [105, 274131], [113, 274375], [115, 274661], [119, 274948], [122, 275288], [127, 275528], [130, 275688], [133, 275788], [141, 276648], [144, 276728], [153, 277228], [156, 277368]]}, {"verse": 36, "start": 278980, "end": 284579, "text": "Se burlaban de él también los soldados, llegándose y presentándole vinagre,", "words": [[0, 278980], [3, 279182], [12, 279762], [15, 280002], [18, 280222], [26, 280542], [30, 280822], [40, 281662], [51, 282582], [53, 282882], [67, 283842]]}, {"verse": 37, "start": 285029, "end": 289406, "text": "Y diciendo: Si tú eres el Rey de los judíos, sálvate a ti mismo.", "words": [[0, 285029], [2, 285159], [12, 286180], [15, 286360], [18, 286540], [23, 286740], [26, 286940], [30, 287180], [33, 287240], [37, 287360], [45, 288160], [53, 288640], [55, 288800], [58, 288880]]}, {"verse": 38, "start": 289756, "end": 298719, "text": "Y había también sobre él un letrero escrito con letras griegas, y latinas, y hebreas: ESTE ES EL REY DE LOS JUDÍOS.", "words": [[0, 289756], [2, 289863], [8, 290063], [16, 290363], [22, 290783], [25, 291103], [28, 291323], [36, 291943], [44, 292323], [48, 292843], [55, 293343], [64, 294063], [66, 294283], [75, 294803], [77, 295103], [86, 296085], [91, 296473], [94, 296873], [97, 297373], [101, 297713], [104, 297793], [108, 297953]]}, {"verse": 39, "start": 299169, "end": 307818, "text": "Y uno de los malhechores que estaban colgados, le injuriaba, diciendo: Si tú eres el Cristo, sálvate a ti mismo y a nosotros.", "words": [[0, 299169], [2, 299293], [6, 299453], [9, 299573], [13, 299693], [25, 300313], [29, 300513], [37, 301023], [47, 301533], [50, 301993], [61, 302853], [71, 304134], [74, 304339], [77, 304499], [82, 304679], [85, 304839], [93, 305839], [101, 306199], [103, 306379], [106, 306459], [112, 306819], [114, 306999], [116, 307079]]}, {"verse": 40, "start": 308168, "end": 315715, "text": "Y respondiendo el otro, le reprendió, diciendo: ¿Ni aun tú temes a Dios, estando en la misma condenación?", "words": [[0, 308168], [2, 308573], [15, 309013], [18, 309213], [24, 309973], [27, 310213], [38, 310993], [48, 312295], [52, 312452], [56, 312612], [59, 312872], [65, 313252], [67, 313352], [73, 313872], [81, 314272], [84, 314372], [87, 314472], [93, 314712]]}, {"verse": 41, "start": 316165, "end": 323672, "text": "Y nosotros, a la verdad, justamente padecemos; porque recibimos lo que merecieron nuestros hechos: pero este ningún mal hizo.", "words": [[0, 316165], [2, 316251], [12, 316771], [14, 316871], [17, 316951], [25, 317611], [36, 317951], [47, 319247], [54, 319430], [64, 320050], [67, 320230], [71, 320350], [82, 320890], [91, 321150], [99, 322128], [104, 322446], [109, 322666], [116, 323006], [120, 323366]]}, {"verse": 42, "start": 324022, "end": 327761, "text": "Y dijo a Jesús: Acuérdate de mí cuando vengas a tu reino.", "words": [[0, 324022], [2, 324189], [7, 324469], [9, 324569], [16, 325550], [26, 326072], [29, 326312], [32, 326432], [39, 326652], [46, 327132], [48, 327212], [51, 327332]]}, {"verse": 43, "start": 328111, "end": 334148, "text": "Entonces Jesús le dijo: De cierto te digo, que hoy estarás conmigo en el paraíso.", "words": [[0, 328111], [9, 328575], [15, 329075], [18, 329395], [24, 330183], [27, 330330], [34, 330630], [37, 331010], [43, 331370], [47, 331890], [51, 332150], [59, 332630], [67, 333150], [70, 333270], [73, 333736]]}, {"verse": 44, "start": 334598, "end": 342547, "text": "Y cuando era como la hora de sexta, fueron hechas tinieblas sobre toda la tierra hasta la hora de nona.", "words": [[0, 334598], [2, 334722], [9, 334982], [13, 335322], [18, 335582], [21, 335782], [26, 335962], [29, 336142], [36, 337062], [43, 337522], [50, 338042], [60, 338562], [66, 338822], [71, 339182], [74, 339382], [81, 339722], [87, 340182], [90, 340782], [95, 341381], [98, 341981]]}, {"verse": 45, "start": 342997, "end": 347566, "text": "Y el sol se oscureció: y el velo del templo se rompió por medio.", "words": [[0, 342997], [2, 342997], [5, 342997], [9, 342997], [12, 343243], [23, 344548], [25, 344676], [28, 344816], [33, 345116], [37, 345276], [44, 345916], [47, 345996], [54, 346576], [58, 346836]]}, {"verse": 46, "start": 348016, "end": 358547, "text": "Entonces Jesús, clamando a gran voz, dijo: Padre, en tus manos encomiendo mi espíritu. Y habiendo dicho esto, exhaló su último aliento.", "words": [[0, 348016], [9, 348494], [16, 349234], [25, 349734], [27, 349814], [32, 349974], [37, 350574], [43, 351294], [50, 351782], [53, 352042], [57, 352222], [63, 352622], [74, 353462], [77, 353702], [87, 354828], [89, 354955], [98, 355275], [104, 355575], [110, 356595], [117, 357095], [120, 357255], [127, 357715]]}, {"verse": 47, "start": 358997, "end": 367216, "text": "Y como el centurión vio lo que había acontecido, dio gloria a Dios, diciendo: Verdaderamente este hombre era justo.", "words": [[0, 358997], [2, 359099], [7, 359339], [10, 359539], [20, 360159], [24, 360439], [27, 360559], [31, 360719], [37, 360959], [49, 362179], [53, 362579], [60, 363179], [62, 363499], [68, 363759], [78, 365129], [93, 365928], [98, 366148], [105, 366408], [109, 366668]]}, {"verse": 48, "start": 367566, "end": 377283, "text": "Y toda la multitud de los que estaban presentes a este espectáculo, viendo lo que había acontecido, se volvían golpeándose el pecho.", "words": [[0, 367566], [2, 367691], [7, 367971], [10, 368211], [19, 368991], [22, 369271], [26, 369411], [30, 369531], [38, 369871], [48, 370611], [50, 370731], [55, 370971], [68, 372191], [75, 372691], [78, 372991], [82, 373131], [88, 373451], [100, 374691], [103, 374871], [111, 375411], [123, 376371], [126, 376571]]}, {"verse": 49, "start": 377733, "end": 385233, "text": "Pero todos sus conocidos, y las mujeres que le habían seguido desde Galilea, estaban lejos mirando estas cosas.", "words": [[0, 377733], [5, 377875], [11, 378195], [15, 378495], [26, 379295], [28, 379455], [32, 379595], [40, 380015], [44, 380335], [47, 380495], [54, 380755], [62, 381335], [68, 381515], [77, 382295], [85, 382875], [91, 383475], [99, 384295], [105, 384455]]}, {"verse": 50, "start": 385683, "end": 392749, "text": "Y he aquí un varón llamado José, el cual era miembro del Consejo, varón bueno y justo,", "words": [[0, 385683], [2, 385829], [5, 385989], [10, 386269], [13, 386509], [19, 386869], [27, 387149], [33, 388329], [36, 388429], [41, 388689], [45, 389089], [53, 389669], [57, 389849], [66, 391109], [72, 391549], [78, 391849], [80, 392129]]}, {"verse": 51, "start": 393199, "end": 403150, "text": "(El cual no había consentido en el consejo ni en los hechos de ellos), de Arimatea, ciudad de la Judea, el cual también esperaba el reino de Dios;", "words": [[0, 393199], [4, 393341], [9, 393501], [12, 393741], [18, 393981], [29, 394761], [32, 394861], [35, 394961], [43, 395541], [46, 395661], [49, 395761], [53, 395921], [60, 396241], [63, 396441], [71, 397221], [74, 397461], [84, 398481], [91, 398921], [94, 399221], [97, 399341], [104, 400241], [107, 400361], [112, 400581], [120, 401141], [129, 401941], [132, 402101], [138, 402501], [141, 402641]]}, {"verse": 52, "start": 403600, "end": 407456, "text": "Este llegó a Pilato, y pidió el cuerpo de Jesús.", "words": [[0, 403600], [5, 403857], [11, 404177], [13, 404277], [21, 404817], [23, 405617], [29, 405957], [32, 406057], [39, 406417], [42, 406697]]}, {"verse": 53, "start": 407906, "end": 417272, "text": "Y quitado, lo envolvió en una sábana, y le puso en un sepulcro abierto en una peña, en el cual ninguno había aún sido puesto.", "words": [[0, 407906], [2, 408033], [11, 408473], [14, 408613], [23, 409133], [26, 409233], [30, 409393], [38, 410013], [40, 410673], [43, 410813], [48, 411233], [51, 411373], [54, 411533], [63, 412273], [71, 413013], [74, 413233], [78, 413393], [84, 413913], [87, 414393], [90, 414513], [95, 414773], [103, 415493], [109, 415773], [113, 416153], [118, 416513]]}, {"verse": 54, "start": 417722, "end": 422416, "text": "Y era día de la víspera de la Pascua; y estaba para comenzar el sábado.", "words": [[0, 417722], [2, 417924], [6, 418064], [10, 418304], [13, 418504], [16, 418644], [24, 419104], [27, 419184], [30, 419284], [38, 420239], [40, 420363], [47, 420683], [52, 420963], [61, 421623], [64, 421743]]}, {"verse": 55, "start": 422866, "end": 431745, "text": "Y las mujeres que con él habían venido de Galilea, siguieron también y vieron el sepulcro, y cómo fue puesto su cuerpo.", "words": [[0, 422866], [2, 423105], [6, 423225], [14, 423705], [18, 424325], [22, 424545], [25, 424685], [32, 424925], [39, 425385], [42, 425545], [51, 426245], [61, 427025], [69, 427445], [71, 428045], [78, 428385], [81, 428585], [91, 429305], [93, 429905], [98, 430205], [102, 430485], [109, 430865], [112, 431105]]}, {"verse": 56, "start": 432195, "end": 439784, "text": "Y vueltas, prepararon especias aromáticas y ungüentos; y descansaron el sábado, conforme al mandamiento.", "words": [[0, 432195], [2, 432316], [11, 432776], [22, 433496], [31, 434216], [42, 434976], [44, 435256], [55, 436472], [57, 436593], [69, 437333], [72, 437513], [80, 438153], [89, 438813], [92, 438913]]}]}