{"book": "ISA", "chapter": 36, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 226529, "verses": [{"verse": 1, "start": 300, "end": 11349, "text": "Aconteció en el año catorce del rey Ezequías, que Senaquerib rey de Asiria subió contra todas las ciudades fortificadas de Judá, y las tomó.", "words": [[0, 300], [10, 1107], [13, 1407], [16, 1527], [20, 1747], [28, 2487], [32, 2687], [36, 2967], [46, 3807], [50, 4647], [61, 5487], [65, 5807], [68, 6477], [75, 7147], [81, 7547], [88, 7867], [94, 8247], [98, 8527], [107, 9167], [120, 9807], [123, 9987], [129, 10527], [131, 10707], [135, 10847]]}, {"verse": 2, "start": 11799, "end": 26795, "text": "Y el rey de Asiria envió a Rabsaces con grande ejército desde Laquis a Jerusalén al rey Ezequías: y asentó el campo a los caños de la pesquera de arriba, en el camino de la heredad del Lavador.", "words": [[0, 11799], [2, 11940], [5, 12080], [9, 12380], [12, 12750], [19, 13120], [25, 13780], [27, 14200], [36, 14620], [40, 15220], [47, 15660], [56, 16580], [62, 16967], [69, 17353], [71, 17740], [81, 18640], [84, 18960], [88, 19360], [98, 20550], [100, 20674], [107, 21234], [110, 21314], [116, 21674], [118, 21854], [122, 21974], [128, 22474], [131, 22614], [134, 22714], [143, 23154], [146, 23294], [154, 23674], [157, 24374], [160, 24514], [167, 24834], [170, 25114], [173, 25254], [181, 25794], [185, 26034]]}, {"verse": 3, "start": 27245, "end": 36225, "text": "Y salió a él Eliaquim hijo de Hilcías mayordomo, y Sebna, escriba, y Joa hijo de Asaf, canciller.", "words": [[0, 27245], [2, 27348], [8, 27728], [10, 27848], [13, 28578], [22, 29308], [27, 29668], [30, 30078], [38, 30488], [49, 31081], [51, 31675], [58, 32268], [67, 32848], [69, 33428], [73, 34008], [78, 34408], [81, 34648], [87, 35388]]}, {"verse": 4, "start": 36675, "end": 45555, "text": "A los cuales dijo Rabsaces: Ahora pues, diréis a Ezequías: El gran rey, el rey de Asiria, dice así: ¿Qué confianza es esta en que confías?", "words": [[0, 36675], [2, 36840], [6, 36940], [13, 37160], [18, 37965], [28, 38970], [34, 39249], [40, 39469], [47, 39949], [49, 40049], [59, 41056], [62, 41152], [67, 41352], [72, 41832], [75, 41932], [79, 42092], [82, 42212], [90, 42712], [95, 42872], [100, 43601], [105, 43702], [115, 44302], [118, 44442], [123, 44682], [126, 44762], [130, 44862]]}, {"verse": 5, "start": 46005, "end": 54666, "text": "Digo, alegas tú, (pero palabras vanas) que tengo consejo y fortaleza para la guerra. Ahora bien, ¿en quién confías que te rebelas contra mí?", "words": [[0, 46005], [6, 46202], [13, 46682], [17, 47262], [23, 47422], [32, 47802], [39, 48742], [43, 48882], [49, 49142], [57, 49702], [59, 49762], [69, 50382], [74, 50582], [77, 50742], [85, 51565], [91, 51865], [97, 52485], [101, 52585], [107, 52765], [115, 53245], [119, 53425], [122, 53725], [130, 54025], [137, 54285]]}, {"verse": 6, "start": 55116, "end": 66657, "text": "He aquí que confías en este bordón de caña frágil, en Egipto, sobre el cual si alguien se apoya, se le entrará por la mano, y se la atravesará. Tal es Faraón rey de Egipto para con todos los que en él confían.", "words": [[0, 55167], [3, 55227], [8, 55407], [12, 55587], [20, 56107], [23, 56307], [28, 56507], [35, 56987], [38, 57107], [43, 57467], [51, 58207], [54, 58287], [62, 58927], [68, 59107], [71, 59287], [76, 59447], [79, 59707], [87, 59947], [90, 60167], [97, 60787], [100, 60867], [103, 60967], [111, 61427], [115, 61507], [118, 61647], [124, 61927], [126, 62147], [129, 62287], [132, 62407], [144, 63455], [148, 63613], [151, 63753], [158, 64173], [162, 64433], [165, 64513], [172, 64893], [177, 65073], [181, 65293], [187, 65473], [191, 65673], [195, 65813], [198, 65913], [201, 65973]]}, {"verse": 7, "start": 67107, "end": 78328, "text": "Y si me decís: «En Jehová nuestro Dios confiamos»; ¿no es este aquel cuyos altos y cuyos altares hizo quitar Ezequías, y dijo a Judá y a Jerusalén: Delante de este altar adoraréis?", "words": [[0, 67107], [2, 67184], [5, 67294], [8, 67454], [15, 68333], [19, 68459], [26, 68920], [34, 69180], [39, 69580], [51, 70733], [55, 70862], [58, 71022], [63, 71302], [69, 71642], [75, 71942], [81, 72322], [83, 72402], [89, 72682], [97, 73122], [102, 73302], [109, 73802], [119, 74302], [121, 74722], [126, 74982], [128, 75102], [133, 75422], [135, 75542], [137, 75582], [148, 76580], [156, 76964], [159, 77144], [164, 77354], [170, 77564]]}, {"verse": 8, "start": 78778, "end": 88329, "text": "Ahora pues yo te ruego que des rehenes al rey de Asiria mi señor, y yo te daré dos mil caballos, si tú puedes dar jinetes que cabalguen sobre ellos.", "words": [[0, 78778], [6, 79059], [11, 79939], [14, 80039], [17, 80199], [23, 80539], [27, 80852], [31, 81166], [39, 81479], [42, 81619], [46, 81819], [49, 82129], [56, 82439], [59, 82559], [66, 82939], [68, 83479], [71, 83639], [74, 83739], [79, 84019], [83, 84199], [87, 84459], [97, 85259], [100, 85599], [103, 85799], [110, 86099], [114, 86299], [122, 86839], [126, 86959], [136, 87459], [142, 87679]]}, {"verse": 9, "start": 88779, "end": 97497, "text": "¿Cómo pues harás volver el rostro de un capitán de los más pequeños siervos de mi señor, aunque estés confiado en Egipto por sus carros y hombres de a caballo?", "words": [[0, 88779], [6, 89034], [11, 89294], [17, 89674], [24, 89954], [27, 90214], [34, 90634], [37, 90734], [40, 90834], [48, 91354], [51, 91474], [55, 91614], [59, 91794], [68, 92334], [76, 92774], [79, 92934], [82, 93054], [89, 93814], [96, 93974], [102, 94334], [111, 94894], [114, 95014], [121, 95454], [125, 95594], [129, 95774], [136, 96274], [138, 96434], [146, 96674], [149, 96874], [151, 96954]]}, {"verse": 10, "start": 97947, "end": 106336, "text": "¿Y por ventura vine yo ahora a esta tierra para destruirla sin Jehová? Jehová me dijo: Sube a esta tierra para destruirla.", "words": [[0, 97947], [3, 98073], [7, 98253], [15, 98793], [20, 99013], [23, 99273], [29, 99593], [31, 99833], [36, 100053], [43, 100373], [48, 100793], [59, 101213], [63, 101633], [71, 102591], [78, 102717], [81, 102844], [87, 103662], [92, 104146], [94, 104266], [99, 104486], [106, 104886], [111, 105286]]}, {"verse": 11, "start": 106929, "end": 122652, "text": "Entonces dijo Eliaquim, y Sebna y Joa a Rabsaces: Te rogamos que hables a tus siervos en lengua siriaca, porque nosotros la entendemos: y no hables con nosotros en lengua judáica, oyéndolo el pueblo que está sobre el muro.", "words": [[0, 106929], [9, 107494], [14, 108124], [24, 108754], [26, 109384], [32, 110014], [34, 110434], [38, 110966], [40, 111497], [50, 112279], [53, 112377], [61, 112837], [65, 113057], [72, 113377], [74, 113477], [78, 113617], [86, 114117], [89, 114337], [96, 114697], [105, 115597], [112, 115957], [121, 116397], [124, 116717], [136, 117875], [138, 117995], [141, 118115], [148, 118455], [152, 118635], [161, 119055], [164, 119295], [171, 119635], [180, 120375], [189, 121075], [192, 121195], [199, 121415], [203, 121655], [208, 121855], [214, 122115], [217, 122255]]}, {"verse": 12, "start": 123002, "end": 134676, "text": "Y dijo Rabsaces: ¿Me envió mi señor a ti y a tu señor, a que dijese estas palabras, y no a los hombres que están sobre el muro, para comer su estiércol y beber su orina con vosotros?", "words": [[0, 123002], [2, 123165], [7, 124044], [17, 125173], [21, 125313], [27, 125593], [30, 125713], [36, 126033], [38, 126253], [41, 126393], [43, 126673], [45, 126753], [48, 126873], [55, 127793], [57, 127873], [61, 127953], [68, 128373], [74, 128593], [84, 129093], [86, 129493], [89, 129653], [91, 129753], [95, 129893], [103, 130173], [107, 130413], [113, 130633], [119, 130893], [122, 131073], [128, 131720], [133, 131867], [139, 132147], [142, 132347], [152, 132867], [154, 133067], [160, 133267], [163, 133527], [169, 133787], [173, 133987]]}, {"verse": 13, "start": 135026, "end": 145119, "text": "Se puso luego en pie Rabsaces, y gritó a grande voz en lengua judáica, diciendo: Oíd las palabras del gran rey, el rey de Asiria.", "words": [[0, 135026], [3, 135151], [8, 135451], [14, 135651], [17, 135931], [21, 136531], [31, 137131], [33, 137891], [39, 138411], [41, 138531], [48, 138831], [52, 139171], [55, 139391], [62, 139791], [71, 140411], [81, 141706], [85, 142013], [89, 142153], [98, 142593], [102, 142873], [107, 143073], [112, 143953], [115, 144073], [119, 144233], [122, 144433]]}, {"verse": 14, "start": 145569, "end": 150359, "text": "El rey dice así: No os engañe Ezequías, porque no os podrá librar.", "words": [[0, 145569], [3, 145733], [7, 146033], [12, 146233], [17, 147091], [20, 147308], [23, 147468], [30, 148028], [40, 148588], [47, 149028], [50, 149308], [53, 149448], [59, 149808]]}, {"verse": 15, "start": 150809, "end": 159260, "text": "Ni os haga Ezequías confiar en Jehová, diciendo: Ciertamente Jehová nos librará: no será entregada esta ciudad en manos del rey de Asiria.", "words": [[0, 150809], [3, 150948], [6, 151128], [11, 151308], [20, 151828], [28, 152328], [31, 152448], [39, 152948], [49, 154069], [61, 154463], [68, 154897], [72, 155330], [81, 156266], [84, 156392], [89, 156592], [99, 157172], [104, 157372], [111, 157712], [114, 157912], [120, 158132], [124, 158392], [128, 158652], [131, 158987]]}, {"verse": 16, "start": 159710, "end": 172472, "text": "No escuchéis a Ezequías: porque el rey de Asiria dice así: Haced conmigo paz, y salid a mí; y coma cada uno de su viña, y cada uno de su higuera, y beba cada cual las aguas de su pozo;", "words": [[0, 159710], [3, 159852], [13, 160412], [15, 160837], [25, 161507], [32, 161705], [35, 161845], [39, 162065], [42, 162315], [49, 162565], [54, 162805], [59, 163721], [65, 163891], [73, 164291], [78, 164571], [80, 164791], [86, 165151], [88, 165231], [92, 166861], [94, 166987], [99, 167267], [104, 167507], [108, 167767], [111, 167927], [114, 168087], [120, 168527], [122, 168867], [127, 169067], [131, 169287], [134, 169467], [137, 169627], [146, 170047], [148, 170407], [153, 170667], [158, 170827], [163, 171127], [167, 171367], [173, 171767], [176, 171867], [179, 172007]]}, {"verse": 17, "start": 172922, "end": 179407, "text": "Hasta que yo venga y os lleve a una tierra como la vuestra, tierra de grano y de vino, tierra de pan y de viñas.", "words": [[0, 172922], [6, 173144], [10, 173304], [13, 173464], [19, 173844], [21, 173984], [24, 174104], [30, 174324], [32, 174404], [36, 174564], [43, 174904], [48, 175244], [51, 175384], [60, 176284], [67, 176504], [70, 176684], [76, 177024], [78, 177104], [81, 177244], [87, 177844], [94, 178084], [97, 178284], [101, 178544], [103, 178664], [106, 178784]]}, {"verse": 18, "start": 179857, "end": 188659, "text": "Mirad no os engañe Ezequías diciendo: Jehová nos librará. ¿Libraron los dioses de las naciones cada uno a su tierra de la mano del rey de Asiria?", "words": [[0, 179857], [6, 180294], [9, 180394], [12, 180554], [19, 181024], [28, 181494], [38, 182514], [45, 182917], [49, 183017], [58, 183960], [68, 184400], [72, 184560], [79, 184960], [82, 185120], [86, 185260], [95, 185840], [100, 186120], [104, 186400], [106, 186540], [109, 186640], [116, 186960], [119, 187140], [122, 187240], [127, 187460], [131, 187700], [135, 187940], [138, 188020]]}, {"verse": 19, "start": 189109, "end": 195517, "text": "¿Dónde está el dios de Hamat y de Arfad? ¿dónde está el dios de Sefarvaim? ¿libraron a Samaria de mi mano?", "words": [[0, 189109], [7, 189393], [12, 189713], [15, 189853], [20, 190113], [23, 190280], [29, 190446], [31, 190613], [34, 190773], [41, 191672], [48, 191933], [53, 192213], [56, 192313], [61, 192613], [64, 193138], [75, 193907], [85, 194165], [87, 194465], [95, 194845], [98, 194965], [101, 195085]]}, {"verse": 20, "start": 195967, "end": 203224, "text": "¿Qué dios hay entre los dioses de estas tierras, que haya librado su tierra de mi mano, para que Jehová libre de mi mano a Jerusalén?", "words": [[0, 195967], [5, 196067], [10, 196307], [14, 196547], [20, 196787], [24, 196987], [31, 197407], [34, 197627], [40, 197827], [49, 198467], [53, 198847], [58, 199007], [66, 199447], [69, 199587], [76, 199867], [79, 200067], [82, 200187], [88, 200527], [93, 201027], [97, 201187], [104, 201567], [110, 201767], [113, 201947], [116, 202067], [121, 202387], [123, 202527]]}, {"verse": 21, "start": 203574, "end": 212211, "text": "Mas callaron, y no le respondieron palabra; porque el rey así lo había mandado, diciendo: No le respondáis.", "words": [[0, 203574], [4, 203743], [14, 204363], [16, 204983], [19, 205123], [22, 205263], [35, 205983], [44, 207213], [51, 207458], [54, 207738], [58, 208078], [62, 208258], [65, 208478], [71, 208718], [80, 209258], [90, 210336], [93, 210516], [96, 210636]]}, {"verse": 22, "start": 212561, "end": 226129, "text": "Entonces Eliaquim hijo de Hilcías mayordomo, y Sebna escriba, y Joa hijo de Asaf canciller, vinieron a Ezequías rotos sus vestidos, y le contaron las palabras de Rabsaces.", "words": [[0, 212561], [9, 213377], [18, 214227], [23, 214547], [26, 214977], [34, 215407], [45, 215907], [47, 216407], [53, 216907], [62, 217407], [64, 217907], [68, 218407], [73, 218727], [76, 219067], [81, 219937], [92, 220807], [101, 221327], [103, 221617], [112, 221907], [118, 222487], [122, 222787], [132, 223407], [134, 223827], [137, 223947], [146, 224427], [150, 224567], [159, 224947], [162, 225565]]}]}