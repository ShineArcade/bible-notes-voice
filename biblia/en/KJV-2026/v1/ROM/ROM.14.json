, 84403], [54, 84723], [57, 85023]]}, {"verse": 13, "start": 85843, "end": 94140, "text": "Let us not therefore judge one another any more: but judge this rather, that no man put a stumblingblock or an occasion to fall in his brother’s way.", "words": [[0, 85843], [4, 85989], [7, 86129], [11, 86329], [21, 86609], [27, 86929], [31, 87209], [39, 87529], [43, 87849], [49, 88409], [53, 88529], [59, 88809], [64, 89129], [72, 89829], [77, 90089], [80, 90369], [84, 90629], [88, 90829], [90, 91239], [105, 91649], [108, 92049], [111, 92189], [120, 92549], [123, 92789], [128, 93089], [131, 93249], [135, 93369], [145, 93809]]}, {"verse": 14, "start": 94590, "end": 103817, "text": "I know, and am persuaded by the Lord Jesus, that there is nothing unclean of itself: but to him that esteems any thing to be unclean, to him it is unclean.", "words": [[0, 94590], [2, 94734], [8, 94974], [12, 95234], [15, 95514], [25, 95954], [28, 96294], [32, 96454], [37, 96634], [44, 96994], [49, 97534], [55, 97674], [58, 97814], [66, 98174], [74, 98734], [77, 98814], [85, 99569], [89, 99710], [92, 99870], [96, 100110], [101, 100350], [109, 100597], [113, 100843], [119, 101090], [122, 101450], [125, 101590], [134, 102270], [137, 102410], [141, 102690], [144, 103070], [147, 103210]]}, {"verse": 15, "start": 104267, "end": 111161, "text": "But if your brother be grieved with your food, now do you not walk charitably. Destroy not him with your food, for whom Christ died.", "words": [[0, 104267], [4, 104364], [7, 104484], [12, 104624], [20, 104904], [23, 105124], [31, 105504], [36, 105644], [41, 105784], [47, 106384], [51, 106624], [54, 106824], [58, 106964], [62, 107104], [67, 107404], [79, 108479], [87, 108777], [91, 109017], [95, 109297], [100, 109497], [105, 109617], [111, 109977], [115, 110057], [120, 110237], [127, 110517]]}, {"verse": 16, "start": 111611, "end": 113525, "text": "Let not then your good be evil spoken of:", "words": [[0, 111611], [4, 111728], [8, 111908], [13, 112108], [18, 112248], [23, 112428], [26, 112588], [31, 112848], [38, 113228]]}, {"verse": 17, "start": 113975, "end": 119737, "text": "For the kingdom of God is not food and drink; but righteousness, and peace, and joy in the Holy Spirit.", "words": [[0, 113975], [4, 114069], [8, 114189], [16, 114449], [19, 114669], [23, 114929], [26, 115109], [30, 115289], [35, 115649], [39, 115849], [46, 116586], [50, 116727], [65, 117207], [69, 117787], [76, 118127], [80, 118447], [84, 118767], [87, 118927], [91, 119027], [96, 119207]]}, {"verse": 18, "start": 120187, "end": 124558, "text": "For he that in these things serves Christ is acceptable to God, and approved of men.", "words": [[0, 120187], [4, 120320], [7, 120520], [12, 120720], [15, 120880], [21, 121060], [28, 121380], [35, 121580], [42, 121980], [45, 122380], [56, 122840], [59, 123140], [64, 123340], [68, 123720], [77, 124020], [80, 124240]]}, {"verse": 19, "start": 125008, "end": 130749, "text": "Let us therefore follow after the things which make for peace, and things with which one may edify another.", "words": [[0, 125008], [4, 125199], [7, 125359], [17, 125759], [24, 126139], [30, 126539], [34, 126739], [41, 126999], [47, 127239], [52, 127459], [56, 127659], [63, 127999], [67, 128559], [74, 128859], [79, 129099], [85, 129279], [89, 129559], [93, 129819], [99, 130219]]}, {"verse": 20, "start": 131199, "end": 137742, "text": "For food destroy not the work of God. All things indeed are pure; but it is evil for that man who eats with offence.", "words": [[0, 131199], [4, 131292], [9, 131572], [17, 131932], [21, 132232], [25, 132432], [30, 132612], [33, 132732], [38, 133432], [42, 133593], [49, 133853], [56, 134233], [60, 134513], [66, 135272], [70, 135448], [73, 135548], [76, 135688], [81, 135968], [85, 136168], [90, 136328], [94, 136568], [98, 136748], [103, 136908], [108, 137353]]}, {"verse": 21, "start": 138192, "end": 145051, "text": "It is good neither to eat flesh, nor to drink wine, nor any thing by which your brother stumbles, 