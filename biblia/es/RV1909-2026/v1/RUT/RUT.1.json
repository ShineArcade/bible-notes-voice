{"book": "RUT", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 216039, "verses": [{"verse": 1, "start": 300, "end": 13770, "text": "Y aconteció en los días que gobernaban los jueces, que hubo hambre en la tierra. Y un varón de Belén de Judá, fue a morar en los campos de Moab, él y su mujer, y dos hijos suyos.", "words": [[0, 300], [2, 482], [12, 1302], [15, 1482], [19, 1622], [24, 2002], [28, 2342], [39, 3102], [43, 3342], [51, 4522], [55, 4582], [60, 4982], [67, 5442], [70, 5742], [73, 5902], [81, 6672], [83, 6795], [86, 6935], [92, 7295], [95, 7435], [101, 7775], [104, 7875], [110, 8295], [114, 8475], [116, 8615], [122, 9015], [125, 9135], [129, 9275], [136, 9835], [139, 9935], [145, 10955], [148, 11375], [150, 11595], [153, 11755], [160, 12215], [162, 12430], [166, 12670], [172, 12890]]}, {"verse": 2, "start": 14120, "end": 29044, "text": "El nombre de aquel varón era Elimelec, y el de su mujer Noemí; y los nombres de sus dos hijos eran, Mahlón y Quelión, efrateos de Belén de Judá. Llegaron pues a los campos de Moab, y asentaron allí.", "words": [[0, 14120], [3, 14261], [10, 14621], [13, 14821], [19, 15121], [25, 15581], [29, 16261], [39, 16941], [41, 17176], [44, 17316], [47, 17516], [50, 17696], [56, 18116], [63, 19174], [65, 19261], [69, 19381], [77, 19841], [80, 20001], [84, 20181], [88, 20401], [94, 20761], [100, 21391], [107, 22021], [109, 22581], [118, 23141], [127, 23801], [130, 23941], [136, 24321], [139, 24441], [145, 25230], [154, 25697], [159, 25937], [161, 26137], [165, 26277], [172, 26797], [175, 26917], [181, 27397], [183, 27857], [193, 28537]]}, {"verse": 3, "start": 29394, "end": 33905, "text": "Y murió Elimelec, marido de Noemí, y quedó ella con sus dos hijos;", "words": [[0, 29394], [2, 29523], [8, 30173], [18, 30823], [25, 31223], [28, 31363], [35, 32063], [37, 32203], [43, 32503], [48, 32703], [52, 32923], [56, 33103], [60, 33303]]}, {"verse": 4, "start": 34255, "end": 43080, "text": "Los cuales se casaron con mujeres moabitas, el nombre de la una Orfa, y el nombre de la otra Ruth; y habitaron allí unos diez años.", "words": [[0, 34255], [4, 34362], [11, 34562], [14, 34782], [22, 35242], [26, 35422], [34, 36130], [44, 36837], [47, 36957], [54, 37297], [57, 37517], [60, 37657], [64, 37857], [70, 38537], [72, 38912], [75, 39072], [82, 39472], [85, 39672], [88, 39812], [93, 40287], [99, 40924], [101, 41000], [111, 41560], [116, 41800], [121, 42070], [126, 42340]]}, {"verse": 5, "start": 43430, "end": 51333, "text": "Y murieron también los dos, Mahlón y Quelión, quedando así la mujer desamparada de sus dos hijos y de su marido.", "words": [[0, 43430], [2, 43572], [11, 44032], [19, 44392], [23, 44732], [28, 45502], [35, 46272], [37, 46785], [46, 47297], [55, 47657], [59, 47837], [62, 47957], [68, 48277], [80, 49157], [83, 49317], [87, 49517], [91, 49777], [97, 50177], [99, 50437], [102, 50537], [105, 50697]]}, {"verse": 6, "start": 51683, "end": 62666, "text": "Entonces se levantó con sus nueras, y se volvió de los campos de Moab: porque oyó en el campo de Moab que Jehová había visitado a su pueblo para darles pan.", "words": [[0, 51683], [9, 52350], [12, 53030], [20, 53550], [24, 53710], [28, 53890], [36, 54390], [38, 54665], [41, 54805], [48, 55165], [51, 55265], [55, 55385], [62, 55865], [65, 55965], [71, 56749], [78, 57011], [82, 57511], [85, 57671], [88, 57811], [94, 58131], [97, 58411], [102, 58991], [106, 59431], [113, 59951], [119, 60231], [128, 60911], [130, 60991], [133, 61111], [140, 61431], [145, 61731], [152, 62151]]}, {"verse": 7, "start": 63016, "end": 70796, "text": "Salió pues del lugar donde había estado, y con ella sus dos nueras, y comenzaron a caminar para volverse a la tierra de Judá.", "words": [[0, 63016], [6, 63416], [11, 63656], [15, 63936], [21, 64356], [27, 64656], [33, 65016], [41, 65456], [43, 65656], [47, 65876], [52, 66036], [56, 66236], [60, 66496], [68, 67176], [70, 67616], [81, 68216], [83, 68336], [91, 68796], [96, 69016], [105, 69556], [107, 69716], [110, 69756], [117, 70076], [120, 70296]]}, {"verse": 8, "start": 71146, "end": 83180, "text": "Y Noemí dijo a sus dos nueras: Andad, volveos cada una a la casa de su madre: Jehová haga con vosotras misericordia, como la habéis hecho con los muertos y conmigo.", "words": [[0, 71325], [2, 71405], [8, 71746], [13, 72445], [15, 72845], [19, 72985], [23, 73265], [31, 74385], [38, 74909], [46, 75449], [51, 75689], [55, 76089], [57, 76289], [60, 76329], [65, 76609], [68, 76809], [71, 76949], [78, 77723], [85, 78224], [90, 78484], [94, 78724], [103, 79264], [117, 80564], [122, 80684], [125, 80934], [132, 81184], [138, 81484], [142, 81684], [146, 81844], [154, 82324], [156, 82504]]}, {"verse": 9, "start": 83530, "end": 94815, "text": "Os conceda Jehová que halléis descanso, cada una en casa de su marido: las besó luego, y ellas lloraron a voz en grito.", "words": [[0, 83600], [3, 83670], [11, 84290], [18, 84730], [22, 84930], [30, 85310], [40, 86210], [45, 86460], [49, 86710], [52, 86870], [57, 87090], [60, 87330], [63, 87450], [71, 90550], [75, 90749], [80, 91349], [87, 91849], [89, 92144], [95, 92424], [104, 93364], [106, 93584], [110, 93824], [113, 94144]]}, {"verse": 10, "start": 95165, "end": 100004, "text": "Y le dijeron: Ciertamente nosotras volveremos contigo a tu pueblo.", "words": [[0, 95165], [2, 95313], [5, 95413], [14, 96378], [26, 97098], [35, 97658], [46, 98218], [54, 98698], [56, 98778], [59, 98858]]}, {"verse": 11, "start": 100284, "end": 108262, "text": "Y Noemí respondió: Volveos, hijas mías: ¿para qué habéis de ir conmigo? ¿tengo yo más hijos en el vientre, que puedan ser vuestros maridos?", "words": [[0, 100284], [2, 100516], [8, 100786], [19, 101787], [28, 102393], [34, 102713], [40, 103373], [46, 103542], [50, 103702], [57, 104002], [60, 104122], [63, 104222], [72, 105144], [79, 105340], [82, 105500], [86, 105680], [92, 105900], [95, 106140], [98, 106260], [107, 106620], [111, 106720], [118, 106960], [122, 107200], [131, 107560]]}, {"verse": 12, "start": 108612, "end": 118638, "text": "Volveos, hijas mías, e idos; que yo ya soy vieja para tener marido. Y aunque dijese: Esperanza tengo; y esta noche fuese con varón, y aun pariese hijos;", "words": [[0, 108612], [9, 109137], [15, 109357], [21, 109764], [23, 110171], [29, 110759], [33, 110843], [36, 110983], [39, 111123], [43, 111283], [49, 111663], [54, 111843], [60, 112083], [68, 112955], [70, 113084], [77, 113244], [85, 114129], [95, 114738], [102, 115494], [104, 115621], [109, 115821], [115, 116061], [121, 116461], [125, 116681], [132, 117161], [134, 117381], [138, 117501], [146, 117981]]}, {"verse": 13, "start": 118988, "end": 132057, "text": "¿Habíais vosotras de esperarlos hasta que fuesen grandes? ¿habíais vosotras de quedaros sin casar por amor de ellos? No, hijas mías; que mayor amargura tengo yo que vosotras, pues la mano de Jehová ha salido contra mí.", "words": [[0, 118988], [9, 119372], [18, 119932], [21, 120032], [32, 120572], [38, 120812], [42, 120952], [49, 121372], [58, 122266], [67, 122650], [76, 123210], [79, 123330], [88, 123690], [92, 123890], [98, 124250], [102, 124430], [107, 124630], [110, 124850], [117, 125543], [121, 125773], [127, 126193], [133, 127038], [137, 127122], [143, 127422], [152, 127962], [158, 128242], [161, 128462], [165, 128602], [175, 129642], [180, 129722], [183, 129942], [188, 130162], [191, 130482], [198, 130802], [201, 130962], [208, 131382], [215, 131682]]}, {"verse": 14, "start": 132337, "end": 139875, "text": "Mas ellas alzando otra vez su voz, lloraron: y Orfa besó a su suegra, mas Ruth se quedó con ella.", "words": [[0, 132337], [4, 132542], [10, 133202], [18, 133742], [23, 134002], [27, 134302], [30, 134502], [35, 135222], [45, 136392], [47, 136617], [52, 136842], [57, 137067], [59, 137379], [62, 137691], [70, 138003], [74, 138315], [79, 138627], [82, 138967], [88, 139307], [92, 139507]]}, {"verse": 15, "start": 140225, "end": 146613, "text": "Y Noemí dijo: He aquí tu cuñada se ha vuelto a su pueblo y a sus dioses; vuélvete tú tras ella.", "words": [[0, 140225], [2, 140449], [8, 140709], [14, 141664], [17, 141664], [22, 142004], [25, 142204], [32, 142704], [35, 142884], [38, 142984], [45, 143284], [47, 143404], [50, 143504], [57, 143864], [59, 144104], [61, 144164], [65, 144344], [73, 145287], [82, 145716], [85, 145916], [90, 146156]]}, {"verse": 16, "start": 146893, "end": 159565, "text": "Y Ruth respondió: No me ruegues que te deje, y me aparte de ti: porque donde quiera que tú vayas, iré yo; y donde quiera que vivas, viviré. Tu pueblo será mi pueblo, y tu Dios mi Dios.", "words": [[0, 146893], [2, 147320], [7, 147786], [18, 148799], [21, 148985], [24, 149235], [32, 149485], [36, 149625], [39, 149785], [45, 150185], [47, 150405], [50, 150525], [57, 150945], [60, 151065], [64, 151638], [71, 151841], [77, 152021], [84, 152441], [88, 152581], [91, 152741], [98, 153241], [102, 153581], [106, 154187], [108, 154295], [114, 154415], [121, 154835], [125, 154995], [132, 155615], [140, 156358], [143, 156440], [150, 156800], [155, 157100], [158, 157320], [166, 157780], [168, 158360], [171, 158520], [176, 158800], [179, 159060]]}, {"verse": 17, "start": 159915, "end": 168448, "text": "Donde tú mueras, moriré yo, y allí seré sepultada: que el Señor me castigue severamente si algo que no sea la muerte me separa de ti.", "words": [[0, 159915], [6, 160120], [9, 160400], [17, 160800], [24, 161320], [28, 161940], [30, 162000], [35, 162220], [40, 162600], [51, 163663], [55, 163744], [58, 163864], [64, 164164], [67, 164424], [76, 164924], [88, 165744], [91, 165964], [96, 166224], [100, 166404], [103, 166544], [107, 166764], [110, 166964], [117, 167244], [120, 167504], [127, 167984], [130, 168104]]}, {"verse": 18, "start": 168728, "end": 173970, "text": "Y viendo Noemí que estaba tan resuelta a ir con ella, dejó de insistirle.", "words": [[0, 168728], [2, 168855], [9, 169175], [15, 169855], [19, 169915], [26, 170235], [30, 170515], [39, 171115], [41, 171215], [44, 171355], [48, 171575], [54, 172275], [59, 172695], [62, 172795]]}, {"verse": 19, "start": 174320, "end": 186596, "text": "Anduvieron pues ellas dos hasta que llegaron a Belén: y aconteció que entrando en Belén, toda la ciudad se conmovió por razón de ellas, y decían: ¿No es esta Noemí?", "words": [[0, 174320], [11, 174657], [16, 175037], [22, 175417], [26, 175797], [32, 176497], [36, 176657], [45, 177077], [47, 177157], [54, 177987], [56, 178106], [66, 178786], [70, 179046], [79, 179506], [82, 179686], [89, 180646], [94, 180826], [97, 181106], [104, 181426], [107, 181766], [116, 182486], [120, 182686], [126, 183066], [129, 183386], [136, 184106], [138, 184426], [146, 185316], [150, 185500], [153, 185760], [158, 186000]]}, {"verse": 20, "start": 186876, "end": 195030, "text": "Y ella les respondía: No me llaméis Noemí, sino llamadme Mara: porque en grande amargura me ha puesto el Todopoderoso.", "words": [[0, 186876], [2, 187059], [7, 187379], [11, 187659], [22, 188914], [25, 189100], [28, 189220], [36, 189660], [43, 190500], [48, 190950], [57, 191400], [63, 192052], [70, 192229], [73, 192409], [80, 192689], [89, 193249], [92, 193409], [95, 193549], [102, 193789], [105, 193969]]}, {"verse": 21, "start": 195380, "end": 204808, "text": "Yo me fui llena, pero vacía me ha vuelto Jehová. ¿Por qué me llamaréis Noemí, ya que Jehová ha dado testimonio contra mí, y el Todopoderoso me ha afligido?", "words": [[0, 195380], [3, 195545], [6, 195665], [10, 195825], [17, 196525], [22, 196665], [28, 197165], [31, 197305], [34, 197385], [41, 197857], [49, 198487], [54, 198587], [58, 198747], [61, 198887], [71, 199367], [78, 200207], [81, 200467], [85, 200607], [92, 201047], [95, 201107], [100, 201307], [111, 201967], [118, 202247], [122, 202487], [124, 202927], [127, 203067], [140, 203787], [143, 203987], [146, 204127]]}, {"verse": 22, "start": 205088, "end": 215639, "text": "Así volvió Noemí y Ruth moabita su nuera con ella; volvió de los campos de Moab, y llegaron a Belén en el principio de la siega de las cebadas.", "words": [[0, 205088], [4, 205408], [11, 205908], [17, 206308], [19, 206588], [24, 206868], [32, 207608], [35, 207848], [41, 208208], [45, 208488], [51, 209220], [58, 209745], [61, 209865], [65, 209985], [72, 210525], [75, 210605], [81, 211145], [83, 211605], [92, 212025], [94, 212285], [100, 212665], [103, 212865], [106, 213025], [116, 213545], [119, 213925], [122, 214175], [128, 214425], [131, 214605], [135, 214765]]}]}