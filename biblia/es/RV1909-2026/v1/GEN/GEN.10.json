{"book": "GEN", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 203073, "verses": [{"verse": 1, "start": 300, "end": 9041, "text": "Estas son las generaciones de los hijos de Noé: Sem, Cam y Jafet, a los cuales nacieron hijos después del diluvio.", "words": [[0, 300], [6, 758], [10, 978], [14, 1178], [27, 1998], [30, 2198], [34, 2338], [40, 2638], [43, 2838], [48, 3489], [53, 4046], [57, 4636], [59, 5116], [66, 6016], [68, 6096], [72, 6216], [79, 6396], [88, 7056], [94, 7496], [102, 8056], [106, 8296]]}, {"verse": 2, "start": 9391, "end": 15657, "text": "Los hijos de Jafet: Gomer, y Magog, y Madai, y Javán, y Tubal, y Mesec, y Tiras.", "words": [[0, 9391], [4, 9500], [10, 9740], [13, 10149], [20, 10730], [27, 11195], [29, 11455], [36, 11955], [38, 12325], [45, 12695], [47, 13075], [54, 13455], [56, 13675], [63, 14155], [65, 14505], [72, 14855], [74, 15055]]}, {"verse": 3, "start": 16007, "end": 19916, "text": "Y los hijos de Gomer: Askenaz, y Rifat, y Togarma.", "words": [[0, 16007], [2, 16116], [6, 16256], [12, 16556], [15, 16796], [22, 17887], [31, 18257], [33, 18637], [40, 19017], [42, 19217]]}, {"verse": 4, "start": 20266, "end": 25107, "text": "Y los hijos de Javán: Elisa, y Tarsis, Quitim, y Dodanim.", "words": [[0, 20266], [2, 20369], [6, 20489], [12, 20809], [15, 21260], [22, 21914], [29, 22454], [31, 22694], [39, 23254], [47, 23814], [49, 24294]]}, {"verse": 5, "start": 25457, "end": 31925, "text": "Por estos se poblaron las costas, cada cual según su lengua, conforme a sus familias en sus naciones.", "words": [[0, 25457], [4, 25621], [10, 25821], [13, 26041], [22, 26541], [26, 26701], [34, 27681], [39, 28081], [44, 28401], [50, 28741], [53, 29021], [61, 29481], [70, 30061], [72, 30121], [76, 30241], [85, 30821], [88, 30941], [92, 31081]]}, {"verse": 6, "start": 31925, "end": 36053, "text": "Los hijos de Cam: Cus, y Mizraim, y Fut, y Canaán.", "words": [[0, 31925], [4, 32065], [10, 32345], [13, 32827], [18, 33530], [23, 33530], [25, 34065], [34, 34605], [36, 34925], [41, 35245], [43, 35649]]}, {"verse": 7, "start": 36403, "end": 44811, "text": "Y los hijos de Cus: Seba, Havila, y Sabta, y Raama, y Sabteca. Y los hijos de Raama: Sheba y Dedán.", "words": [[0, 36403], [2, 36540], [6, 36660], [12, 36900], [15, 37225], [20, 38166], [26, 38596], [34, 39027], [36, 39457], [43, 39888], [45, 40318], [52, 40748], [54, 41180], [63, 41770], [65, 41899], [69, 42039], [75, 42319], [78, 42749], [85, 43611], [91, 43861], [93, 44336]]}, {"verse": 8, "start": 45161, "end": 50421, "text": "Y Cus engendró a Nimrod: este comenzó a ser poderoso en la tierra.", "words": [[0, 45161], [2, 45379], [6, 45639], [15, 46259], [17, 46479], [25, 47470], [30, 47741], [38, 48481], [40, 48581], [44, 48821], [53, 49541], [56, 49701], [59, 49821]]}, {"verse": 9, "start": 50771, "end": 60669, "text": "Este fue vigoroso cazador delante de Jehová; por lo cual se dice: Así como Nimrod, vigoroso cazador delante de Jehová.", "words": [[0, 50771], [5, 51157], [9, 51497], [18, 52177], [26, 52837], [34, 53357], [37, 53517], [45, 54479], [49, 54606], [52, 54726], [57, 54986], [60, 55206], [66, 56039], [70, 56399], [75, 56719], [83, 57979], [92, 58679], [100, 59319], [108, 59819], [111, 59979]]}, {"verse": 10, "start": 61019, "end": 67306, "text": "Y fue la cabecera de su reino Babel, y Erec, y Accad, y Calne, en la tierra de Sinar.", "words": [[0, 61019], [2, 61144], [6, 61304], [9, 61464], [18, 62024], [21, 62144], [24, 62324], [30, 62784], [37, 63244], [39, 63644], [45, 64044], [47, 64484], [54, 64924], [56, 65344], [63, 65764], [66, 66104], [69, 66204], [76, 66588], [79, 66971]]}, {"verse": 11, "start": 67656, "end": 73222, "text": "De esta tierra salió Assur, y edificó a Nínive, y a Rehobot, y a Cala,", "words": [[0, 67656], [3, 67780], [8, 67940], [15, 68300], [21, 68740], [28, 69180], [30, 69710], [38, 70240], [40, 70420], [48, 71000], [50, 71480], [52, 71890], [61, 72300], [63, 72660], [65, 72760]]}, {"verse": 12, "start": 73572, "end": 78589, "text": "Y a Resén entre Nínive y Cala; la cual es ciudad grande.", "words": [[0, 73572], [2, 73774], [4, 74000], [10, 74227], [16, 74897], [23, 75567], [25, 76040], [31, 76682], [34, 76805], [39, 77005], [42, 77245], [49, 77845]]}, {"verse": 13, "start": 78939, "end": 84636, "text": "Y Mizraim engendró a Ludim, y a Anamim, y a Lehabim, y a naftuhim,", "words": [[0, 78939], [2, 79284], [10, 79660], [19, 80036], [21, 80412], [28, 80788], [30, 81164], [32, 81540], [40, 81916], [42, 82292], [44, 82668], [53, 83041], [55, 83415], [57, 83788]]}, {"verse": 14, "start": 84986, "end": 90946, "text": "Y a patrusim, y a Casluhim, de donde salieron los filisteos, y a caftoreos.", "words": [[0, 84986], [2, 85130], [4, 85580], [14, 86030], [16, 86330], [18, 87010], [28, 87690], [31, 87810], [37, 87990], [46, 88590], [50, 88790], [61, 89650], [63, 89890], [65, 90447]]}, {"verse": 15, "start": 91296, "end": 96164, "text": "Y Canaán engendró a Sidón, su primogénito, y a Het,", "words": [[0, 91296], [2, 91613], [9, 91963], [18, 92635], [20, 93307], [27, 93979], [30, 94651], [43, 95323], [45, 95623], [47, 95923]]}, {"verse": 16, "start": 96514, "end": 100536, "text": "Y al jebuseo, y al amorreo, y al gergeseo,", "words": [[0, 96514], [2, 96677], [5, 97167], [14, 97657], [16, 98037], [19, 98157], [28, 98957], [30, 99317], [33, 99927]]}, {"verse": 17, "start": 100886, "end": 104130, "text": "Y al heveo, y al araceo, y al sineo,", "words": [[0, 100886], [2, 101066], [5, 101376], [12, 101686], [14, 101926], [17, 102416], [25, 102906], [27, 103326], [30, 103762]]}, {"verse": 18, "start": 104480, "end": 111746, "text": "Y al arvadeo, y al zemareo, y al amateo: y después se derramaron las familias de los cananeos.", "words": [[0, 104480], [2, 104609], [5, 104709], [14, 105929], [16, 105969], [19, 106529], [28, 107089], [30, 107089], [33, 107209], [41, 108156], [43, 108259], [51, 108619], [54, 109239], [65, 109899], [69, 110079], [78, 110659], [81, 110719], [85, 110839]]}, {"verse": 19, "start": 112096, "end": 121537, "text": "Y fue el término de los cananeos desde Sidón, viniendo a Gerar hasta Gaza, hasta entrar en Sodoma y Gomorra, Adma, y Zeboim hasta Lasa.", "words": [[0, 112096], [2, 112214], [6, 112394], [9, 112574], [17, 113114], [20, 113174], [24, 113314], [33, 113894], [39, 114074], [46, 114654], [55, 115394], [57, 115494], [63, 115744], [69, 115994], [75, 116394], [81, 116814], [88, 117214], [91, 117394], [98, 117894], [100, 118014], [109, 118644], [115, 119274], [117, 119874], [124, 120474], [130, 121039]]}, {"verse": 20, "start": 121887, "end": 128204, "text": "Estos son los hijos de Cam por sus familias, por sus lenguas, en sus tierras, en sus naciones.", "words": [[0, 121887], [6, 122193], [10, 122413], [14, 122553], [20, 122853], [23, 123073], [27, 123313], [31, 123633], [35, 123793], [45, 124793], [49, 124873], [53, 125053], [62, 125933], [65, 126053], [69, 126213], [78, 126993], [81, 127053], [85, 127273]]}, {"verse": 21, "start": 128554, "end": 135074, "text": "También le nacieron hijos a Sem, padre de todos los hijos de Heber, y hermano mayor de Jafet.", "words": [[0, 128554], [8, 128797], [11, 129017], [20, 129517], [26, 129797], [28, 130077], [33, 130697], [39, 131057], [42, 131277], [48, 131537], [52, 131857], [58, 132157], [61, 132527], [68, 132897], [70, 133437], [78, 133957], [84, 134217], [87, 134437]]}, {"verse": 22, "start": 135424, "end": 140635, "text": "Y los hijos de Sem: Elam, y Assur, y Arfaxad, y Lud, y Aram.", "words": [[0, 135424], [2, 135655], [6, 135815], [12, 136115], [15, 136335], [20, 136855], [26, 137315], [28, 137735], [35, 138155], [37, 138580], [46, 139005], [48, 139430], [53, 139855], [55, 140055]]}, {"verse": 23, "start": 140985, "end": 146044, "text": "Y los hijos de Aram: Uz, y Hul, y Geter, y Mas.", "words": [[0, 140985], [2, 141115], [6, 141235], [12, 141535], [15, 141815], [21, 143055], [25, 143425], [27, 143985], [32, 144545], [34, 144945], [41, 145346], [43, 145566]]}, {"verse": 24, "start": 146394, "end": 150828, "text": "Y Arfaxad engendró a Sala, y Sala engendró a Heber.", "words": [[0, 146439], [2, 146699], [10, 147499], [19, 148219], [21, 148359], [27, 148719], [29, 149159], [34, 149499], [43, 150139], [45, 150511]]}, {"verse": 25, "start": 151178, "end": 161526, "text": "Y a Heber nacieron dos hijos: el nombre del uno fue Peleg, porque en sus días fue repartida la tierra; y el nombre de su hermano, Joctán.", "words": [[0, 151178], [2, 151443], [4, 151593], [10, 151743], [19, 152303], [23, 152603], [30, 153531], [33, 153694], [40, 154054], [44, 154274], [48, 154514], [52, 154774], [59, 155514], [66, 156194], [69, 156514], [73, 156694], [78, 156974], [82, 157254], [92, 158034], [95, 158194], [103, 159116], [105, 159326], [108, 159446], [115, 159806], [118, 160046], [121, 160186], [130, 160856]]}, {"verse": 26, "start": 161876, "end": 167749, "text": "Y Joctán engendró a Almodad, y a Selef, y Hazarmaveth, y a Jera,", "words": [[0, 162140], [2, 162440], [9, 162740], [18, 163520], [20, 163740], [29, 164600], [31, 164780], [33, 165130], [40, 165480], [42, 166130], [55, 166780], [57, 167140], [59, 167240]]}, {"verse": 27, "start": 168099, "end": 170996, "text": "Y a Adoram, y a Uzal, y a Dicla,", "words": [[0, 168099], [2, 168243], [4, 168503], [12, 169103], [14, 169363], [16, 169663], [22, 169963], [24, 170343], [26, 170443]]}, {"verse": 28, "start": 171346, "end": 174550, "text": "Y a Obal, y a Abimael, y a Seba,", "words": [[0, 171346], [2, 171529], [4, 171589], [10, 172129], [12, 172649], [14, 172729], [23, 173489], [25, 173909], [27, 174229]]}, {"verse": 29, "start": 174900, "end": 180173, "text": "Y a Ofir, y a Havila, y a Jobab: todos estos fueron hijos de Joctán.", "words": [[0, 175013], [2, 175127], [4, 175240], [10, 175619], [12, 175999], [14, 176378], [22, 176758], [24, 177137], [26, 177517], [33, 178055], [39, 178278], [45, 178598], [52, 178938], [58, 179278], [61, 179761]]}, {"verse": 30, "start": 180523, "end": 186032, "text": "Y fue su habitación desde Mesa viniendo de Sefar, monte a la parte del oriente.", "words": [[0, 180523], [2, 180645], [6, 180805], [9, 181045], [20, 181725], [26, 182005], [31, 182485], [40, 182965], [43, 183145], [50, 184085], [56, 184345], [58, 184605], [61, 184825], [67, 185105], [71, 185365]]}, {"verse": 31, "start": 186382, "end": 193127, "text": "Estos fueron los hijos de Sem por sus familias, por sus lenguas, en sus tierras, en sus naciones.", "words": [[0, 186382], [6, 186924], [13, 187184], [17, 187464], [23, 187844], [26, 188084], [30, 188244], [34, 188524], [38, 188724], [48, 189424], [52, 189464], [56, 189664], [65, 190464], [68, 190704], [72, 190864], [81, 192064], [84, 192144], [88, 192304]]}, {"verse": 32, "start": 193477, "end": 202673, "text": "Estas son las familias de Noé por sus descendencias, en sus naciones; y de estos se esparcieron las naciones en la tierra después del diluvio.", "words": [[0, 193477], [6, 193882], [10, 194022], [14, 194182], [23, 194702], [26, 194822], [30, 195122], [34, 195282], [38, 195462], [53, 196342], [56, 196542], [60, 196742], [70, 197827], [72, 198047], [75, 198187], [81, 198467], [84, 198767], [96, 199587], [100, 199767], [109, 200227], [112, 200447], [115, 200567], [122, 200907], [130, 201627], [134, 201927]]}]}