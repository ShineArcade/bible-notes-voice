{"book": "PSA", "chapter": 66, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 111849, "verses": [{"verse": 1, "start": 300, "end": 3273, "text": "Make a joyful noise to God, all you lands:", "words": [[0, 300], [5, 428], [7, 568], [14, 988], [20, 1388], [23, 1648], [28, 2288], [32, 2428], [36, 2887]]}, {"verse": 2, "start": 3723, "end": 7691, "text": "Sing forth the honour of his name: make his praise glorious.", "words": [[0, 3723], [5, 3987], [11, 4347], [15, 4607], [22, 4867], [25, 5067], [29, 5207], [35, 6026], [40, 6171], [44, 6391], [51, 6771]]}, {"verse": 3, "start": 8141, "end": 15447, "text": "Say to God, How terrible are you in your works! through the greatness of your power shall your enemies submit themselves to you.", "words": [[0, 8141], [4, 8361], [7, 8481], [12, 8841], [16, 8961], [25, 9401], [29, 9701], [33, 9901], [36, 10061], [41, 10161], [48, 11063], [56, 11203], [60, 11343], [70, 11683], [73, 11983], [78, 12103], [84, 12783], [90, 13103], [95, 13303], [103, 13643], [110, 14123], [121, 14623], [124, 14943]]}, {"verse": 4, "start": 15897, "end": 21781, "text": "All the earth shall worship you, and shall sing to you; they shall sing to your name. Selah.", "words": [[0, 15897], [4, 16096], [8, 16276], [14, 16536], [20, 16836], [28, 17236], [33, 17616], [37, 18056], [43, 18256], [48, 18556], [51, 18776], [56, 19427], [61, 19535], [67, 19715], [72, 19995], [75, 20155], [80, 20295], [86, 21484]]}, {"verse": 5, "start": 22231, "end": 26952, "text": "Come and see the works of God: he is terrible in his doing toward the children of men.", "words": [[0, 22231], [5, 22391], [9, 22551], [13, 22771], [17, 22911], [23, 23151], [26, 23351], [31, 24150], [34, 24238], [37, 24378], [46, 24798], [49, 25078], [53, 25218], [59, 25418], [66, 25758], [70, 25938], [79, 26278], [82, 26478]]}, {"verse": 6, "start": 27402, "end": 33123, "text": "He turned the sea into dry land: they went through the flood on foot: there did we rejoice in him.", "words": [[0, 27402], [3, 27502], [10, 27762], [14, 27962], [18, 28202], [23, 28402], [27, 28762], [33, 29661], [38, 29749], [43, 29969], [51, 30169], [55, 30329], [61, 30589], [64, 30789], [70, 31647], [76, 31757], [80, 31937], [83, 32137], [91, 32497], [94, 32817]]}, {"verse": 7, "start": 33573, "end": 41376, "text": "He rules by his power for ever; his eyes behold the nations: let not the rebellious exalt themselves. Selah.", "words": [[0, 33573], [3, 33699], [9, 34019], [12, 34359], [16, 34579], [22, 34976], [26, 35373], [32, 36005], [36, 36118], [41, 36418], [48, 36778], [52, 37018], [61, 38058], [65, 38224], [69, 38444], [73, 38664], [84, 39244], [90, 39624], [102, 41096]]}, {"verse": 8, "start": 41826, "end": 46482, "text": "O bless our God, you people, and make the voice of his praise to be heard:", "words": [[0, 41826], [2, 41973], [8, 42253], [12, 42513], [17, 43053], [21, 43153], [29, 44133], [33, 44233], [38, 44413], [42, 44613], [48, 44913], [51, 45093], [55, 45233], [62, 45593], [65, 45813], [68, 45973]]}, {"verse": 9, "start": 46932, "end": 50749, "text": "Which holds our soul in life, and suffers not our feet to be moved.", "words": [[0, 46932], [6, 47059], [12, 47359], [16, 47559], [21, 47879], [24, 48059], [30, 48339], [34, 48799], [42, 49079], [46, 49399], [50, 49599], [55, 49819], [58, 50019], [61, 50159]]}, {"verse": 10, "start": 51199, "end": 56247, "text": "For you, O God, have proved us: you have tried us, as silver is tried.", "words": [[0, 51199], [4, 51328], [9, 51788], [11, 51868], [16, 52428], [21, 52548], [28, 52908], [32, 53737], [36, 54052], [41, 54212], [47, 54592], [51, 54852], [54, 55092], [61, 55472], [64, 55692]]}, {"verse": 11, "start": 56697, "end": 60591, "text": "You brought us into the net; you laidst affliction upon our loins.", "words": [[0, 56697], [4, 56937], [12, 57157], [15, 57357], [20, 57597], [24, 57737], [29, 58443], [33, 58752], [40, 59092], [51, 59432], [56, 59672], [60, 59932]]}, {"verse": 12, "start": 61041, "end": 68498, "text": "You have caused men to ride over our heads; we went through fire and through water: but you brought us out into a wealthy place.", "words": [[0, 61041], [4, 61144], [9, 61264], [16, 61544], [20, 61764], [23, 61924], [28, 62184], [33, 62444], [37, 62664], [44, 63586], [47, 63886], [52, 64106], [60, 64326], [65, 64746], [69, 64966], [77, 65146], [84, 66048], [88, 66308], [92, 66468], [100, 66708], [103, 66928], [107, 67108], [112, 67348], [114, 67508], [122, 67788]]}, {"verse": 13, "start": 68948, "end": 73301, "text": "I will go into your house with burnt offerings: I will pay you my vows,", "words": [[0, 68948], [2, 69074], [7, 69214], [10, 69414], [15, 69614], [20, 69774], [26, 70014], [31, 70234], [37, 70454], [48, 71549], [50, 71695], [55, 71855], [59, 72135], [63, 72315], [66, 72535]]}, {"verse": 14, "start": 73751, "end": 78355, "text": "Which my lips have uttered, and my mouth has spoken, when I was in trouble.", "words": [[0, 73751], [6, 73899], [9, 74119], [14, 74379], [19, 74619], [28, 75419], [32, 75619], [35, 75799], [41, 76099], [45, 76319], [53, 76699], [58, 77399], [60, 77559], [64, 77739], [67, 77859]]}, {"verse": 15, "start": 78805, "end": 86404, "text": "I will offer to you burnt sacrifices of fatlings, with the incense of rams; I will offer bullocks with goats. Selah.", "words": [[0, 78805], [2, 78949], [7, 79089], [13, 79389], [16, 79589], [20, 79749], [26, 80029], [37, 80789], [40, 81109], [50, 81649], [55, 81929], [59, 82069], [67, 82389], [70, 82669], [76, 83604], [78, 83726], [83, 83866], [89, 84106], [98, 84686], [103, 84866], [110, 86107]]}, {"verse": 16, "start": 86854, "end": 92207, "text": "Come and hear, all you that fear God, and I will declare what he has done for my soul.", "words": [[0, 86854], [5, 87024], [9, 87144], [15, 87364], [19, 87704], [23, 87964], [28, 88164], [33, 88484], [38, 89284], [42, 89564], [44, 89744], [49, 89924], [57, 90324], [62, 90624], [65, 90804], [69, 90984], [74, 91224], [78, 91424], [81, 91624]]}, {"verse": 17, "start": 92657, "end": 97218, "text": "I cried to him with my mouth, and he was extolled with my tongue.", "words": [[0, 92657], [2, 92784], [8, 93024], [11, 93304], [15, 93444], [20, 93604], [23, 93824], [30, 94544], [34, 94724], [37, 94884], [41, 95064], [50, 95744], [55, 95864], [58, 96104]]}, {"verse": 18, "start": 97668, "end": 101504, "text": "If I regard iniquity in my heart, the Lord will not hear me:", "words": [[0, 97668], [3, 97828], [5, 97948], [12, 98308], [21, 98968], [24, 99148], [27, 99348], [34, 100048], [38, 100128], [43, 100388], [48, 100628], [52, 100868], [57, 101128]]}, {"verse": 19, "start": 101954, "end": 106440, "text": "But indeed God has heard me; he has attended to the voice of my prayer.", "words": [[0, 101954], [4, 102053], [11, 102693], [15, 102793], [19, 103133], [25, 103413], [29, 104096], [32, 104209], [36, 104359], [45, 104719], [48, 104999], [52, 105119], [58, 105419], [61, 105639], [64, 105799]]}, {"verse": 20, "start": 106890, "end": 111449, "text": "Blessed be God, which has not turned away my prayer, nor his mercy from me.", "words": [[0, 107002], [8, 107133], [11, 107352], [16, 107692], [22, 107952], [26, 108152], [30, 108352], [37, 108652], [42, 108932], [45, 109152], [53, 110012], [57, 110172], [61, 110412], [67, 110792], [72, 111092]]}]}