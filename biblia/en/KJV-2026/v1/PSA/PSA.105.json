{"book": "PSA", "chapter": 105, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 221121, "verses": [{"verse": 1, "start": 300, "end": 5785, "text": "O give thanks to the LORD; call upon his name: make known his deeds among the people.", "words": [[0, 300], [2, 442], [7, 662], [14, 1022], [17, 1282], [21, 1422], [27, 2192], [32, 2399], [37, 2659], [41, 2959], [47, 3820], [52, 4006], [58, 4286], [62, 4526], [68, 4806], [74, 5066], [78, 5286]]}, {"verse": 2, "start": 6235, "end": 10742, "text": "Sing to him, sing psalms to him: talk of all his wondrous works.", "words": [[0, 6235], [5, 6478], [8, 6738], [13, 7038], [18, 7238], [25, 7878], [28, 8038], [33, 8754], [38, 8935], [41, 9155], [45, 9435], [49, 9635], [58, 10095]]}, {"verse": 3, "start": 11192, "end": 15824, "text": "Glory in his holy name: let the heart of them rejoice that seek the LORD.", "words": [[0, 11192], [6, 11601], [9, 11921], [13, 12061], [18, 12321], [24, 13131], [28, 13257], [32, 13437], [38, 13697], [41, 13837], [46, 14017], [54, 14457], [59, 14797], [64, 15057], [68, 15317]]}, {"verse": 4, "start": 16274, "end": 20006, "text": "Seek the LORD, and his strength: seek his face evermore.", "words": [[0, 16274], [5, 16500], [9, 16760], [15, 17040], [19, 17320], [23, 17460], [33, 18352], [38, 18575], [42, 18835], [47, 19455]]}, {"verse": 5, "start": 20456, "end": 25559, "text": "Remember his marvellous works that he has done; his wonders, and the judgments of his mouth;", "words": [[0, 20456], [9, 20766], [13, 21116], [24, 21466], [30, 21886], [35, 22146], [38, 22286], [42, 22446], [48, 23276], [52, 23437], [61, 23897], [65, 24177], [69, 24297], [79, 24657], [82, 25017], [86, 25137]]}, {"verse": 6, "start": 26009, "end": 30144, "text": "O you seed of Abraham his servant, you children of Jacob his chosen.", "words": [[0, 26009], [2, 26156], [6, 26356], [11, 26556], [14, 26756], [22, 27216], [26, 27576], [35, 28216], [39, 28336], [48, 28736], [51, 28916], [57, 29256], [61, 29516]]}, {"verse": 7, "start": 30594, "end": 34673, "text": "He is the LORD our God: his judgments are in all the earth.", "words": [[0, 30594], [3, 30934], [6, 31174], [10, 31354], [15, 31634], [19, 31914], [24, 32806], [28, 32914], [38, 33374], [42, 33754], [45, 33914], [49, 34114], [53, 34294]]}, {"verse": 8, "start": 35123, "end": 40491, "text": "He has remembered his covenant for ever, the word which he commanded to a thousand generations.", "words": [[0, 35123], [3, 35217], [7, 35397], [18, 35777], [22, 35997], [31, 36484], [35, 36970], [41, 37457], [45, 37577], [50, 37837], [56, 38097], [59, 38197], [69, 38597], [72, 38877], [74, 39037], [83, 39377]]}, {"verse": 9, "start": 40941, "end": 44438, "text": "Which covenant he made with Abraham, and his oath to Isaac;", "words": [[0, 40941], [6, 41090], [15, 41510], [18, 41810], [23, 42050], [28, 42230], [37, 42790], [41, 43190], [45, 43350], [50, 43590], [53, 43830]]}, {"verse": 10, "start": 44888, "end": 50092, "text": "And confirmed the same to Jacob for a law, and to Israel for an everlasting covenant:", "words": [[0, 44888], [4, 45014], [14, 45434], [18, 45674], [23, 45914], [26, 46114], [32, 46474], [36, 46794], [38, 46914], [43, 47234], [47, 47754], [50, 47874], [57, 48314], [61, 48634], [64, 48774], [76, 49154]]}, {"verse": 11, "start": 50542, "end": 55721, "text": "Saying, To you will I give the land of Canaan, the lot of your inheritance:", "words": [[0, 50858], [8, 51391], [11, 51504], [15, 51724], [20, 51984], [22, 52124], [27, 52324], [31, 52524], [36, 52824], [39, 53314], [47, 53804], [51, 54144], [55, 54364], [58, 54504], [63, 54644]]}, {"verse": 12, "start": 56071, "end": 60493, "text": "When they were but a few men in number; yes, very few, and strangers in it.", "words": [[0, 56071], [5, 56198], [10, 56318], [15, 56478], [19, 56638], [21, 56758], [25, 56978], [29, 57198], [32, 57338], [40, 58191], [45, 58640], [50, 58880], [55, 59240], [59, 59560], [69, 59980], [72, 60260]]}, {"verse": 13, "start": 60943, "end": 65099, "text": "When they went from one nation to another, from one kingdom to another people;", "words": [[0, 60943], [5, 61070], [10, 61190], [15, 61390], [20, 61590], [24, 61870], [31, 62190], [34, 62410], [43, 63130], [48, 63330], [52, 63570], [60, 63910], [63, 64230], [71, 64530]]}, {"verse": 14, "start": 65549, "end": 70050, "text": "He permitted no one to do them wrong: yes, he reproved kings for their sakes;", "words": [[0, 65549], [3, 65631], [13, 65951], [16, 66291], [20, 66491], [23, 66631], [26, 66791], [31, 66971], [38, 67770], [43, 68154], [46, 68254], [55, 68774], [61, 69074], [65, 69334], [71, 69494]]}, {"verse": 15, "start": 70500, "end": 74686, "text": "Saying, Touch not my anointed, and do my prophets no harm.", "words": [[0, 70775], [8, 71258], [14, 71453], [18, 71673], [21, 71913], [31, 72853], [35, 72933], [38, 73073], [41, 73233], [50, 73593], [53, 73893]]}, {"verse": 16, "start": 75036, "end": 79991, "text": "Moreover he called for a famine upon the land: he broke the whole staff of bread.", "words": [[0, 75036], [9, 75651], [12, 75751], [19, 76051], [23, 76291], [25, 76411], [32, 76791], [37, 77071], [41, 77311], [47, 78089], [50, 78198], [56, 78458], [60, 78698], [66, 78898], [72, 79258], [75, 79458]]}, {"verse": 17, "start": 80441, "end": 84363, "text": "He sent a man before them, even Joseph, who was sold for a servant:", "words": [[0, 80441], [3, 80541], [8, 80761], [10, 80921], [14, 81161], [21, 81481], [27, 82141], [32, 82321], [40, 83001], [44, 83081], [48, 83261], [53, 83461], [57, 83701], [59, 83821]]}, {"verse": 18, "start": 84813, "end": 88331, "text": "Whose feet they hurt with fetters: he was laid in iron:", "words": [[0, 84813], [6, 84932], [11, 85272], [16, 85572], [21, 85812], [26, 86012], [35, 86942], [38, 87042], [42, 87182], [47, 87462], [50, 87642]]}, {"verse": 19, "start": 88781, "end": 92884, "text": "Until the time that his word came: the word of the LORD tried him.", "words": [[0, 88781], [6, 89181], [10, 89361], [15, 89661], [20, 89861], [24, 89961], [29, 90201], [35, 91219], [39, 91303], [44, 91543], [47, 91683], [51, 91823], [56, 92103], [62, 92463]]}, {"verse": 20, "start": 93334, "end": 97938, "text": "The king sent and loosed him; even the ruler of the people, and let him go free.", "words": [[0, 93334], [4, 93419], [9, 93639], [14, 93999], [18, 94239], [25, 94599], [30, 95170], [35, 95394], [39, 95574], [45, 95894], [48, 96154], [52, 96274], [60, 96554], [64, 96874], [68, 97054], [72, 97194], [75, 97434]]}, {"verse": 21, "start": 98388, "end": 102098, "text": "He made him lord of his house, and ruler of all his substance:", "words": [[0, 98388], [3, 98489], [8, 98709], [12, 98889], [17, 99169], [20, 99369], [24, 99529], [31, 99829], [35, 100189], [41, 100549], [44, 100849], [48, 101049], [52, 101269]]}, {"verse": 22, "start": 102548, "end": 106840, "text": "To bind his princes at his pleasure; and teach his senators wisdom.", "words": [[0, 102548], [3, 102652], [8, 103012], [12, 103232], [20, 103692], [23, 103992], [27, 104132], [37, 105073], [41, 105183], [47, 105423], [51, 105603], [60, 106103]]}, {"verse": 23, "start": 107290, "end": 112361, "text": "Israel also came into Egypt; and Jacob sojourned in the land of Ham.", "words": [[0, 107290], [7, 107672], [12, 108132], [17, 108492], [22, 108752], [29, 109742], [33, 109890], [39, 110210], [49, 111050], [52, 111190], [56, 111310], [61, 111570], [64, 111750]]}, {"verse": 24, "start": 112811, "end": 117240, "text": "And he increased his people greatly; and made them stronger than their enemies.", "words": [[0, 112811], [4, 112956], [7, 113076], [17, 113516], [21, 113716], [28, 114076], [37, 115075], [41, 115182], [46, 115362], [51, 115562], [60, 115962], [65, 116302], [71, 116502]]}, {"verse": 25, "start": 117690, "end": 122245, "text": "He turned their heart to hate his people, to deal craftily with his servants.", "words": [[0, 117690], [3, 117787], [10, 118127], [16, 118347], [22, 118647], [25, 118887], [30, 119167], [34, 119367], [42, 120187], [45, 120327], [50, 120567], [59, 121187], [64, 121407], [68, 121547]]}, {"verse": 26, "start": 122695, "end": 126344, "text": "He sent Moses his servant; and Aaron whom he had chosen.", "words": [[0, 122695], [3, 122785], [8, 123025], [14, 123425], [18, 123705], [27, 124584], [31, 124767], [37, 125087], [42, 125407], [45, 125607], [49, 125747]]}, {"verse": 27, "start": 126794, "end": 130588, "text": "They showed his signs among them, and wonders in the land of Ham.", "words": [[0, 126794], [5, 126940], [12, 127180], [16, 127380], [22, 127760], [28, 128080], [34, 128620], [38, 129000], [46, 129340], [49, 129600], [53, 129720], [58, 129900], [61, 130060]]}, {"verse": 28, "start": 131038, "end": 136449, "text": "He sent darkness, and made it dark; and they rebelled not against his word.", "words": [[0, 131038], [3, 131147], [8, 131367], [18, 131887], [22, 132287], [27, 132507], [30, 132607], [36, 133409], [40, 133769], [45, 133909], [54, 134409], [58, 134609], [66, 134929], [70, 135189]]}, {"verse": 29, "start": 136899, "end": 140011, "text": "He turned their waters into blood, and killed their fish.", "words": [[0, 136899], [3, 136990], [10, 137270], [16, 137470], [23, 137810], [28, 138130], [35, 138510], [39, 138910], [46, 139210], [52, 139430]]}, {"verse": 30, "start": 140461, "end": 144621, "text": "Their land brought forth frogs in abundance, in the chambers of their kings.", "words": [[0, 140461], [6, 140581], [11, 140961], [19, 141241], [25, 141581], [31, 142061], [34, 142281], [45, 142701], [48, 143201], [52, 143301], [61, 143621], [64, 143881], [70, 144041]]}, {"verse": 31, "start": 145071, "end": 149826, "text": "He spoke, and there came various sorts of flies, and lice in all their coasts.", "words": [[0, 145071], [3, 145173], [10, 145513], [14, 145813], [20, 145953], [25, 146173], [33, 146613], [39, 146913], [42, 147133], [49, 147613], [53, 148253], [58, 148693], [61, 148813], [65, 148973], [71, 149113]]}, {"verse": 32, "start": 150276, "end": 153909, "text": "He gave them hail for rain, and flaming fire in their land.", "words": [[0, 150276], [3, 150360], [8, 150580], [13, 150800], [18, 151060], [22, 151280], [28, 151660], [32, 152000], [40, 152440], [45, 152920], [48, 153200], [54, 153340]]}, {"verse": 33, "start": 154359, "end": 160156, "text": "He struck their vines also and their fig trees; and broke the trees of their coasts.", "words": [[0, 154359], [3, 154458], [10, 154778], [16, 155058], [22, 155578], [27, 155958], [31, 156338], [37, 156478], [41, 156758], [48, 157892], [52, 158035], [58, 158315], [62, 158575], [68, 158895], [71, 159115], [77, 159295]]}, {"verse": 34, "start": 160606, "end": 165056, "text": "He spoke, and the locusts came, and caterpillers, and that without number,", "words": [[0, 160606], [3, 160716], [10, 161396], [14, 161516], [18, 161636], [26, 162236], [32, 162636], [36, 163146], [50, 163656], [54, 163796], [59, 164016], [67, 164316]]}, {"verse": 35, "start": 165506, "end": 169954, "text": "And did eat up all the herbs in their land, and devoured the fruit of their ground.", "words": [[0, 165506], [4, 165656], [8, 165876], [12, 166156], [15, 166356], [19, 166616], [23, 166756], [29, 167036], [32, 167216], [38, 167356], [44, 167736], [48, 168236], [57, 168736], [61, 168896], [67, 169116], [70, 169236], [76, 169396]]}, {"verse": 36, "start": 170404, "end": 174554, "text": "He struck also all the firstborn in their land, the chief of all their strength.", "words": [[0, 170404], [3, 170494], [10, 170754], [15, 171154], [19, 171434], [23, 171774], [33, 172114], [36, 172254], [42, 172394], [48, 173054], [52, 173154], [58, 173394], [61, 173634], [65, 173774], [71, 173934]]}, {"verse": 37, "start": 175004, "end": 181490, "text": "He brought them forth also with silver and gold: and there was not one feeble person among their tribes.", "words": [[0, 175004], [3, 175090], [11, 175330], [16, 175570], [22, 175870], [27, 176330], [32, 176570], [39, 176970], [43, 177290], [49, 178210], [53, 178550], [59, 178670], [63, 178830], [67, 179050], [71, 179350], [78, 179790], [85, 180170], [91, 180450], [97, 180670]]}, {"verse": 38, "start": 181940, "end": 186411, "text": "Egypt was glad when they departed: for the fear of them fell upon them.", "words": [[0, 181940], [6, 182360], [10, 182700], [15, 183020], [20, 183300], [25, 183460], [35, 184449], [39, 184527], [43, 184667], [48, 184947], [51, 185127], [56, 185307], [61, 185587], [66, 185907]]}, {"verse": 39, "start": 186861, "end": 190908, "text": "He spread a cloud for a covering; and fire to give light in the night.", "words": [[0, 186861], [3, 186955], [10, 187235], [12, 187395], [18, 187755], [22, 187955], [24, 188095], [34, 188984], [38, 189109], [43, 189469], [46, 189689], [51, 189889], [57, 190209], [60, 190389], [64, 190489]]}, {"verse": 40, "start": 191358, "end": 195578, "text": "The people asked, and he brought quails, and satisfied them with the bread of heaven.", "words": [[0, 191358], [4, 191442], [11, 191682], [18, 192202], [22, 192402], [25, 192522], [33, 192782], [41, 193362], [45, 193562], [55, 194022], [60, 194442], [65, 194622], [69, 194742], [75, 194962], [78, 195102]]}, {"verse": 41, "start": 196028, "end": 201503, "text": "He opened the rock, and the waters gushed out; they ran in the dry places like a river.", "words": [[0, 196028], [3, 196131], [10, 196451], [14, 196651], [20, 197231], [24, 197531], [28, 197651], [35, 197971], [42, 198491], [47, 199129], [52, 199236], [56, 199496], [59, 199676], [63, 199776], [67, 200056], [74, 200536], [79, 200816], [81, 200936]]}, {"verse": 42, "start": 201953, "end": 205559, "text": "For he remembered his holy promise, and Abraham his servant.", "words": [[0, 201953], [4, 202173], [7, 202313], [18, 202693], [22, 202913], [27, 203213], [36, 203933], [40, 204253], [48, 204733], [52, 205013]]}, {"verse": 43, "start": 206009, "end": 210404, "text": "And he brought forth his people with joy, and his chosen with gladness:", "words": [[0, 206009], [4, 206133], [7, 206233], [15, 206453], [21, 206773], [25, 206993], [32, 207373], [37, 207633], [42, 208073], [46, 208673], [50, 208833], [57, 209313], [62, 209553]]}, {"verse": 44, "start": 210854, "end": 215651, "text": "And gave them the lands of the heathen: and they inherited the labour of the people;", "words": [[0, 210854], [4, 210991], [9, 211231], [14, 211511], [18, 211671], [24, 212071], [27, 212311], [31, 212431], [40, 213343], [44, 213485], [49, 213605], [59, 214065], [63, 214375], [70, 214685], [73, 214945], [77, 215045]]}, {"verse": 45, "start": 216101, "end": 220721, "text": "That they might observe his statutes, and keep his laws. Praise the LORD.", "words": [[0, 216101], [5, 216254], [10, 216434], [16, 216634], [24, 217014], [28, 217214], [38, 217874], [42, 218334], [47, 218574], [51, 218754], [57, 219681], [64, 219907], [68, 220167]]}]}