{"book": "PSA", "chapter": 55, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 165464, "verses": [{"verse": 1, "start": 300, "end": 9056, "text": "Al Músico principal: en Neginoth: Masquil de David. ESCUCHA, oh Dios, mi oración, y no te escondas de mi súplica.", "words": [[0, 300], [3, 485], [10, 985], [21, 2231], [24, 2708], [34, 3486], [42, 4013], [45, 4113], [52, 4975], [61, 5306], [64, 5672], [70, 6039], [73, 6299], [82, 6819], [84, 7319], [87, 7459], [90, 7619], [99, 8179], [102, 8299], [105, 8379]]}, {"verse": 2, "start": 9506, "end": 15230, "text": "Préstame atención, y respóndeme: clamo en mi oración, y levanto el grito,", "words": [[0, 9761], [9, 10051], [19, 10651], [21, 11381], [33, 12484], [39, 12654], [42, 12794], [45, 12954], [54, 13494], [56, 14034], [64, 14354], [67, 14674]]}, {"verse": 3, "start": 15680, "end": 25049, "text": "A causa de la voz del enemigo, por la opresión del impío; porque echaron sobre mí iniquidad, y con furor me han amenazado.", "words": [[0, 15680], [2, 15822], [8, 16162], [11, 16422], [14, 16542], [18, 16762], [22, 16922], [31, 17542], [35, 18222], [38, 18382], [47, 18942], [51, 19122], [58, 20263], [65, 20527], [73, 21187], [79, 21447], [82, 21747], [93, 22507], [95, 22967], [99, 23247], [105, 23727], [108, 23887], [112, 24107]]}, {"verse": 4, "start": 25499, "end": 31271, "text": "Mi corazón está doloroso dentro de mí, y terrores de muerte sobre mí han caído.", "words": [[0, 25499], [3, 25662], [11, 26122], [16, 26502], [25, 27122], [32, 27382], [35, 27682], [39, 27862], [41, 28282], [50, 28902], [53, 29022], [60, 29402], [66, 29802], [69, 30142], [73, 30502]]}, {"verse": 5, "start": 31721, "end": 36286, "text": "Temor y temblor vinieron sobre mí, y terror me ha cubierto.", "words": [[0, 31721], [6, 32182], [8, 32442], [16, 33022], [25, 33522], [31, 33882], [35, 34602], [37, 34702], [44, 35022], [47, 35322], [50, 35462]]}, {"verse": 6, "start": 36736, "end": 42404, "text": "Y dije: ¡Quién me diese alas como de paloma! volaría yo, y descansaría.", "words": [[0, 36938], [2, 37184], [8, 37715], [15, 37999], [18, 38209], [24, 38419], [29, 39079], [34, 39319], [37, 39499], [45, 40501], [53, 40963], [57, 41223], [59, 41343]]}, {"verse": 7, "start": 42854, "end": 48062, "text": "Ciertamente huiría lejos: moraría en el desierto. (Selah.)", "words": [[0, 42854], [12, 43722], [19, 44382], [26, 45418], [34, 45966], [37, 46126], [40, 46266], [50, 47766]]}, {"verse": 8, "start": 48512, "end": 53526, "text": "Me apresuraría a escapar del viento tempestuoso, de la tempestad.", "words": [[0, 48512], [3, 48660], [15, 49660], [17, 49860], [25, 50540], [29, 50720], [36, 51240], [49, 52320], [52, 52520], [55, 52640]]}, {"verse": 9, "start": 53976, "end": 61090, "text": "Deshace, oh Señor, divide la lengua de ellos; porque he visto violencia y rencilla en la ciudad.", "words": [[0, 53976], [9, 54863], [12, 54883], [19, 55463], [26, 55623], [29, 55903], [36, 56263], [39, 56383], [46, 57295], [53, 57655], [56, 57915], [62, 58175], [72, 58915], [74, 59055], [83, 59815], [86, 60155], [89, 60335]]}, {"verse": 10, "start": 61540, "end": 67396, "text": "Día y noche la rodean sobre sus muros; e iniquidad y trabajo hay en medio de ella.", "words": [[0, 61540], [4, 61865], [6, 61965], [12, 62165], [15, 62405], [22, 62945], [28, 63245], [32, 63485], [39, 64407], [41, 64553], [51, 65253], [53, 65413], [61, 65893], [65, 66153], [68, 66333], [74, 66633], [77, 66873]]}, {"verse": 11, "start": 67846, "end": 73484, "text": "Agravios hay en medio de ella, y el fraude y engaño no se apartan de sus plazas.", "words": [[0, 67846], [9, 68512], [13, 68792], [16, 68992], [22, 69252], [25, 69492], [31, 69852], [33, 70612], [36, 70772], [43, 71292], [45, 71552], [52, 72112], [55, 72412], [58, 72572], [66, 73112], [69, 73236], [73, 73360]]}, {"verse": 12, "start": 73934, "end": 83930, "text": "Porque no me afrentó un enemigo, lo cual habría soportado; ni se alzó contra mí el que me aborrecía, porque me hubiera ocultado de él:", "words": [[0, 74681], [7, 74881], [10, 75081], [13, 75241], [21, 75741], [24, 75881], [33, 76361], [36, 76481], [41, 76701], [48, 77041], [59, 78259], [62, 78404], [65, 78584], [70, 78964], [77, 79324], [80, 79624], [83, 79904], [87, 80044], [90, 80224], [101, 81304], [108, 81844], [111, 82064], [119, 82444], [128, 83284], [131, 83504]]}, {"verse": 13, "start": 84380, "end": 89346, "text": "Mas tú, hombre, al parecer íntimo mío, mi guía, y mi familiar:", "words": [[0, 84380], [4, 84626], [8, 85086], [16, 85826], [19, 85946], [27, 86516], [34, 87086], [39, 87506], [42, 87606], [48, 88106], [50, 88366], [53, 88526]]}, {"verse": 14, "start": 89796, "end": 96248, "text": "Que juntos comunicábamos dulcemente los secretos, a la casa de Dios andábamos en compañía.", "words": [[0, 89796], [4, 89881], [11, 90241], [25, 91201], [36, 91921], [40, 92081], [50, 93221], [52, 93481], [55, 93581], [60, 93821], [63, 94061], [68, 94341], [78, 95241], [81, 95401]]}, {"verse": 15, "start": 96698, "end": 104285, "text": "Condenados sean a muerte, desciendan vivos al infierno: porque maldades hay en su compañía, entre ellos.", "words": [[0, 96698], [11, 97447], [16, 97667], [18, 97827], [26, 98727], [37, 99307], [43, 99867], [46, 100027], [56, 101176], [63, 101360], [72, 102000], [76, 102320], [79, 102500], [82, 102620], [92, 103320], [98, 103540]]}, {"verse": 16, "start": 104735, "end": 107896, "text": "Yo a Dios clamaré; y Jehová me salvará.", "words": [[0, 104735], [3, 105089], [5, 105476], [10, 105862], [19, 106485], [21, 106727], [28, 107007], [31, 107147]]}, {"verse": 17, "start": 108346, "end": 114005, "text": "Tarde y mañana y a medio día oraré y clamaré; y él oirá mi voz.", "words": [[0, 108346], [6, 108631], [8, 108871], [15, 109551], [17, 109611], [19, 109831], [25, 110051], [29, 110271], [35, 110851], [37, 111111], [46, 112865], [48, 112990], [51, 113115], [56, 113240], [59, 113360]]}, {"verse": 18, "start": 114455, "end": 120392, "text": "Él ha redimido en paz mi alma de la guerra contra mí; pues fueron contra mí muchos.", "words": [[0, 114455], [3, 114896], [6, 115136], [15, 115836], [18, 115996], [22, 116296], [25, 116636], [30, 116896], [33, 117116], [36, 117236], [43, 117516], [50, 117936], [54, 118594], [59, 118700], [66, 118980], [73, 119400], [76, 119620]]}, {"verse": 19, "start": 120842, "end": 130320, "text": "Dios oirá, y los quebrantará luego, el que desde la antigüedad permanece (Selah); por cuanto no se mudan, ni temen a Dios.", "words": [[0, 120842], [5, 121166], [11, 122006], [13, 122446], [17, 122626], [29, 123406], [36, 124186], [39, 124526], [43, 124666], [49, 124886], [52, 125126], [63, 125726], [73, 126560], [82, 127653], [86, 127933], [93, 128153], [96, 128433], [99, 128573], [106, 129013], [109, 129313], [115, 129673], [117, 129793]]}, {"verse": 20, "start": 130770, "end": 135430, "text": "Extendió sus manos contra sus pacíficos: violó su pacto.", "words": [[0, 130770], [9, 131690], [13, 131890], [19, 132270], [26, 132610], [30, 132830], [41, 134160], [47, 134605], [50, 134705]]}, {"verse": 21, "start": 135880, "end": 145212, "text": "Ablandan más que manteca su boca, pero guerra hay en su corazón: suavizan sus palabras más que el aceite, mas ellas son cuchillos.", "words": [[0, 136250], [9, 136620], [13, 136860], [17, 137060], [25, 137600], [28, 137780], [34, 138200], [39, 138440], [46, 138800], [50, 139220], [53, 139380], [56, 139560], [65, 141028], [74, 141398], [78, 141598], [87, 141978], [91, 142378], [95, 142578], [98, 142758], [106, 143098], [110, 143438], [116, 144058], [120, 144338]]}, {"verse": 22, "start": 145662, "end": 152558, "text": "Echa sobre Jehová tu carga, y él te sustentará; no dejará para siempre caído al justo.", "words": [[0, 145813], [5, 146003], [11, 146363], [18, 146883], [21, 146983], [28, 147383], [30, 147943], [33, 148103], [36, 148223], [48, 149453], [51, 149580], [58, 150060], [63, 150180], [71, 150620], [77, 151060], [80, 151180]]}, {"verse": 23, "start": 153008, "end": 165064, "text": "Mas tú, oh Dios, harás descender aquellos al pozo de la sepultura: los hombres sanguinarios y engañadores no llegarán a la mitad de sus días: pero yo confiaré en ti.", "words": [[0, 153017], [4, 153057], [8, 153097], [11, 153137], [17, 153377], [23, 154317], [33, 155117], [42, 155577], [45, 156037], [50, 156497], [53, 156577], [56, 156697], [67, 157835], [71, 157961], [79, 158381], [92, 159581], [94, 159701], [106, 160461], [109, 160961], [118, 161541], [120, 161621], [123, 161701], [129, 161941], [132, 162281], [136, 162441], [142, 163371], [147, 163515], [150, 163695], [159, 164435], [162, 164695]]}]}