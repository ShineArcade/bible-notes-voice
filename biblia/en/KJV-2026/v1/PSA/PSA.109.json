{"book": "PSA", "chapter": 109, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 179165, "verses": [{"verse": 1, "start": 300, "end": 3283, "text": "Hold not your peace, O God of my praise;", "words": [[0, 300], [5, 504], [9, 844], [14, 1164], [21, 1844], [23, 1944], [27, 2224], [30, 2384], [33, 2564]]}, {"verse": 2, "start": 3733, "end": 10573, "text": "For the mouth of the wicked and the mouth of the deceitful are opened against me: they have spoken against me with a lying tongue.", "words": [[0, 3733], [4, 3822], [8, 3962], [14, 4242], [17, 4442], [21, 4562], [28, 4842], [32, 5142], [36, 5282], [42, 5482], [45, 5682], [49, 5782], [59, 6362], [63, 6542], [70, 6802], [78, 7142], [82, 7947], [87, 8034], [92, 8174], [99, 8574], [107, 8914], [110, 9254], [115, 9454], [117, 9574], [123, 9914]]}, {"verse": 3, "start": 11023, "end": 16367, "text": "They compassed me about also with words of hatred; and fought against me without a cause.", "words": [[0, 11023], [5, 11164], [15, 11744], [18, 11844], [24, 12124], [29, 12544], [34, 12784], [40, 13084], [43, 13264], [51, 14205], [55, 14323], [62, 14583], [70, 14863], [73, 15163], [81, 15483], [83, 15643]]}, {"verse": 4, "start": 16817, "end": 21287, "text": "For my love they are my adversaries: but I give myself to prayer.", "words": [[0, 16817], [4, 16936], [7, 17156], [12, 17616], [17, 17736], [21, 17856], [24, 18016], [37, 19518], [41, 19623], [43, 19723], [48, 19903], [55, 20363], [58, 20623]]}, {"verse": 5, "start": 21737, "end": 26049, "text": "And they have rewarded me evil for good, and hatred for my love.", "words": [[0, 21737], [4, 21883], [9, 22043], [14, 22223], [23, 22683], [26, 23003], [31, 23403], [35, 23663], [41, 24043], [45, 24623], [52, 24983], [56, 25323], [59, 25523]]}, {"verse": 6, "start": 26499, "end": 31026, "text": "Set a wicked man over him: and let Satan stand at his right hand.", "words": [[0, 26499], [4, 26718], [6, 26858], [13, 27118], [17, 27498], [22, 27798], [27, 28634], [31, 28782], [35, 28942], [41, 29402], [47, 29822], [50, 30102], [54, 30242], [60, 30482]]}, {"verse": 7, "start": 31476, "end": 36227, "text": "When he shall be judged, let him be condemned: and let his prayer become sin.", "words": [[0, 31476], [5, 31587], [8, 31767], [14, 31967], [17, 32127], [25, 32887], [29, 33147], [33, 33307], [36, 33467], [47, 34490], [51, 34595], [55, 34755], [59, 34935], [66, 35255], [73, 35595]]}, {"verse": 8, "start": 36677, "end": 40077, "text": "Let his days be few; and let another take his office.", "words": [[0, 36677], [4, 36824], [8, 36984], [13, 37264], [16, 37524], [21, 38350], [25, 38496], [29, 38656], [37, 38976], [42, 39296], [46, 39496]]}, {"verse": 9, "start": 40527, "end": 43469, "text": "Let his children be fatherless, and his wife a widow.", "words": [[0, 40527], [4, 40656], [8, 40816], [17, 41216], [20, 41436], [32, 42216], [36, 42276], [40, 42436], [45, 42756], [47, 42976]]}, {"verse": 10, "start": 43919, "end": 50589, "text": "Let his children be continually vagabonds, and beg: let them seek their bread also out of their desolate places.", "words": [[0, 43919], [4, 44087], [8, 44247], [17, 44607], [20, 44807], [32, 45407], [43, 46247], [47, 46507], [52, 47367], [56, 47495], [61, 47695], [66, 47915], [72, 48135], [78, 48355], [83, 48755], [87, 49075], [90, 49195], [96, 49335], [105, 49815]]}, {"verse": 11, "start": 51039, "end": 56187, "text": "Let the extortioner catch all that he has; and let the strangers spoil his labour.", "words": [[0, 51039], [4, 51167], [8, 51347], [20, 52087], [26, 52347], [30, 52687], [35, 52867], [38, 52987], [43, 53975], [47, 54085], [51, 54245], [55, 54405], [65, 54845], [71, 55305], [75, 55779]]}, {"verse": 12, "start": 56637, "end": 63324, "text": "Let there be none to extend mercy to him: neither let there be any to favour his fatherless children.", "words": [[0, 56637], [4, 56801], [10, 57021], [13, 57181], [18, 57481], [21, 57741], [28, 58161], [34, 58641], [37, 58921], [42, 59705], [50, 59931], [54, 60231], [60, 60411], [63, 60571], [67, 60851], [70, 61101], [77, 61351], [81, 61631], [92, 62211]]}, {"verse": 13, "start": 63774, "end": 69247, "text": "Let his posterity be cut off; and in the generation following let their name be blotted out.", "words": [[0, 63774], [4, 63904], [8, 64044], [18, 64684], [21, 64824], [25, 65044], [30, 65852], [34, 65999], [37, 66119], [41, 66219], [52, 66699], [62, 67519], [66, 67699], [72, 67859], [77, 68159], [80, 68319], [88, 68739]]}, {"verse": 14, "start": 69697, "end": 75708, "text": "Let the iniquity of his fathers be remembered with the LORD; and let not the sin of his mother be blotted out.", "words": [[0, 69697], [4, 69842], [8, 69982], [17, 70482], [20, 70622], [24, 70742], [32, 71122], [35, 71422], [46, 71802], [51, 72082], [55, 72222], [61, 73014], [65, 73159], [69, 73299], [73, 73559], [77, 73759], [81, 74019], [84, 74179], [88, 74319], [95, 74619], [98, 74839], [106, 75219]]}, {"verse": 15, "start": 76158, "end": 81300, "text": "Let them be before the LORD continually, that he may cut off the memory of them from the earth.", "words": [[0, 76158], [4, 76294], [9, 76494], [12, 76694], [19, 77074], [23, 77274], [28, 77474], [41, 78754], [46, 78894], [49, 79014], [53, 79134], [57, 79394], [61, 79574], [65, 79794], [72, 80134], [75, 80354], [80, 80534], [85, 80754], [89, 80954]]}, {"verse": 16, "start": 81750, "end": 89202, "text": "Because that he remembered not to show mercy, but persecuted the poor and needy man, that he might even slay the broken in heart.", "words": [[0, 81750], [8, 81983], [13, 82183], [16, 82283], [27, 82723], [31, 83063], [34, 83303], [39, 83503], [46, 84343], [50, 84503], [61, 85023], [65, 85403], [70, 85763], [74, 85943], [80, 86303], [85, 87003], [90, 87123], [93, 87243], [99, 87443], [104, 87663], [109, 88123], [113, 88223], [120, 88563], [123, 88743]]}, {"verse": 17, "start": 89652, "end": 96517, "text": "As he loved cursing, so let it come to him: as he delighted not in blessing, so let it be far from him.", "words": [[0, 89652], [3, 89818], [6, 89938], [12, 90198], [21, 90938], [24, 91158], [28, 91358], [31, 91458], [36, 91718], [39, 91918], [44, 92521], [47, 92700], [50, 92840], [60, 93300], [64, 93600], [67, 93820], [77, 94720], [80, 94940], [84, 95160], [87, 95300], [90, 95460], [94, 95820], [99, 96120]]}, {"verse": 18, "start": 96967, "end": 105192, "text": "As he clothed himself with cursing like as with his garment, so let it come into his bowels like water, and like oil into his bones.", "words": [[0, 96967], [3, 97123], [6, 97243], [14, 97763], [22, 97923], [27, 98363], [35, 98903], [40, 99103], [43, 99323], [48, 99523], [52, 99663], [61, 100343], [64, 100623], [68, 100843], [71, 100943], [76, 101183], [81, 101423], [85, 101603], [92, 102123], [97, 102343], [104, 102803], [108, 103303], [113, 103503], [117, 103943], [122, 104303], [126, 104503]]}, {"verse": 19, "start": 105642, "end": 111458, "text": "Let it be to him as the garment which covers him, and for a girdle with which he is girded continually.", "words": [[0, 105642], [4, 105777], [7, 105917], [10, 106097], [13, 106297], [17, 106517], [20, 106757], [24, 106917], [32, 107217], [38, 107517], [45, 107837], [50, 108497], [54, 108757], [58, 108937], [60, 109077], [67, 109477], [72, 109677], [78, 109897], [81, 110037], [84, 110177], [91, 110577]]}, {"verse": 20, "start": 111908, "end": 118153, "text": "Let this be the reward of my adversaries from the LORD, and of them that speak evil against my soul.", "words": [[0, 111908], [4, 112062], [9, 112302], [12, 112522], [16, 112662], [23, 113122], [26, 113322], [29, 113502], [41, 114282], [46, 114542], [50, 114722], [56, 115362], [60, 115542], [63, 115722], [68, 115942], [73, 116162], [79, 116482], [84, 116902], [92, 117262], [95, 117582]]}, {"verse": 21, "start": 118603, "end": 124377, "text": "But do you for me, O GOD the Lord, for your name’s sake: because your mercy is good, deliver me.", "words": [[0, 118603], [4, 118706], [7, 118866], [11, 119026], [15, 119226], [19, 119606], [21, 119766], [25, 119986], [29, 120186], [35, 120586], [39, 120686], [44, 121031], [51, 121377], [57, 121980], [65, 122120], [70, 122380], [76, 122760], [79, 123000], [85, 123640], [93, 124060]]}, {"verse": 22, "start": 124827, "end": 128734, "text": "For I am poor and needy, and my heart is wounded within me.", "words": [[0, 124827], [4, 125147], [6, 125447], [9, 125607], [14, 125947], [18, 126147], [25, 126947], [29, 127067], [32, 127287], [38, 127587], [41, 127747], [49, 128027], [56, 128387]]}, {"verse": 23, "start": 129184, "end": 134061, "text": "I am gone like the shadow when it declines: I am tossed up and down as the locust.", "words": [[0, 129184], [2, 129348], [5, 129488], [10, 129768], [15, 130028], [19, 130188], [26, 130528], [31, 130768], [34, 130888], [44, 131956], [46, 132069], [49, 132149], [56, 132449], [59, 132709], [63, 132849], [68, 133089], [71, 133269], [75, 133409]]}, {"verse": 24, "start": 134511, "end": 138506, "text": "My knees are weak through fasting; and my flesh fails of fatness.", "words": [[0, 134511], [3, 134640], [9, 134920], [13, 135160], [18, 135400], [26, 135640], [35, 136660], [39, 136784], [42, 136924], [48, 137204], [54, 137604], [57, 137804]]}, {"verse": 25, "start": 138956, "end": 144749, "text": "I became also a reproach to them: when they looked upon me they shook their heads.", "words": [[0, 138956], [2, 139254], [9, 139474], [14, 139914], [16, 140114], [25, 140594], [28, 140754], [34, 142373], [39, 142496], [44, 142636], [51, 142856], [56, 143156], [59, 143536], [64, 143636], [70, 143876], [76, 144136]]}, {"verse": 26, "start": 145199, "end": 149281, "text": "Help me, O LORD my God: O save me according to your mercy:", "words": [[0, 145199], [5, 145368], [9, 145668], [11, 145748], [16, 146048], [19, 146288], [24, 147330], [26, 147510], [31, 147630], [34, 147870], [44, 148190], [47, 148470], [52, 148630]]}, {"verse": 27, "start": 149731, "end": 153496, "text": "That they may know that this is your hand; that you, LORD, have done it.", "words": [[0, 149731], [5, 149854], [10, 150014], [14, 150174], [19, 150414], [24, 150574], [29, 150774], [32, 150914], [37, 151054], [43, 151890], [48, 152010], [53, 152350], [59, 152810], [64, 152930], [69, 153210]]}, {"verse": 28, "start": 153946, "end": 160772, "text": "Let them curse, but you bless: when they arise, let them be ashamed; but let your servant rejoice.", "words": [[0, 153946], [4, 154090], [9, 154330], [16, 154910], [20, 155030], [24, 155190], [31, 156177], [36, 156306], [41, 156466], [48, 157126], [52, 157306], [57, 157506], [60, 157666], [69, 158850], [73, 159150], [77, 159310], [82, 159470], [90, 159850]]}, {"verse": 29, "start": 161222, "end": 167932, "text": "Let my adversaries be clothed with shame, and let them cover themselves with their own confusion, as with a mantle.", "words": [[0, 161222], [4, 161350], [7, 161570], [19, 162250], [22, 162470], [30, 162990], [35, 163090], [42, 163790], [46, 164150], [50, 164310], [55, 164490], [61, 164790], [72, 165110], [77, 165590], [83, 165750], [87, 165970], [98, 166910], [101, 167110], [106, 167310], [108, 167410]]}, {"verse": 30, "start": 168382, "end": 173434, "text": "I will greatly praise the LORD with my mouth; yes, I will praise him among the multitude.", "words": [[0, 168382], [2, 168525], [7, 168685], [15, 169005], [22, 169365], [26, 169645], [31, 169885], [36, 170085], [39, 170285], [46, 171112], [51, 171476], [53, 171536], [58, 171676], [65, 171936], [69, 172156], [75, 172376], [79, 172596]]}, {"verse": 31, "start": 173884, "end": 178765, "text": "For he shall stand at the right hand of the poor, to save him from those that condemn his soul.", "words": [[0, 173884], [4, 174184], [7, 174344], [13, 174524], [19, 174824], [22, 175024], [26, 175124], [32, 175324], [37, 175584], [40, 175764], [44, 175864], [50, 176384], [53, 176584], [58, 176844], [62, 177044], [67, 177224], [73, 177484], [78, 177724], [86, 17