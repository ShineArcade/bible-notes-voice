{"book": "PSA", "chapter": 51, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 131199, "verses": [{"verse": 1, "start": 300, "end": 16042, "text": "Al Músico principal: Salmo de David, cuando después que entró a Betsabé, vino a él Natán el profeta. TEN piedad de mí, oh Dios, conforme a tu misericordia: conforme a la multitud de tus piedades borra mis rebeliones.", "words": [[0, 300], [3, 468], [10, 948], [21, 2118], [27, 2638], [30, 2778], [37, 3378], [44, 3638], [52, 4078], [56, 4258], [62, 4658], [64, 4798], [73, 5358], [78, 5918], [80, 6118], [83, 6298], [89, 6778], [92, 6978], [101, 8128], [105, 8334], [112, 8540], [115, 8801], [119, 9088], [122, 9374], [128, 9660], [137, 10300], [139, 10381], [142, 10481], [156, 11872], [165, 12481], [167, 12541], [170, 12621], [179, 13201], [182, 13361], [186, 13501], [195, 14161], [201, 14941], [205, 15101]]}, {"verse": 2, "start": 16392, "end": 21017, "text": "Lávame más y más de mi maldad, y límpiame de mi pecado.", "words": [[0, 16638], [7, 16918], [11, 17438], [13, 17718], [17, 17978], [20, 18098], [23, 18218], [31, 18718], [33, 19438], [42, 20158], [45, 20278], [48, 20358]]}, {"verse": 3, "start": 21367, "end": 26304, "text": "Porque yo reconozco mis rebeliones; y mi pecado está siempre delante de mí.", "words": [[0, 21367], [7, 21551], [10, 21751], [20, 22371], [24, 22531], [36, 23710], [38, 23833], [41, 23973], [48, 24553], [53, 24773], [61, 25153], [69, 25753], [72, 25933]]}, {"verse": 4, "start": 26654, "end": 36936, "text": "A ti, a ti solo he pecado, y he hecho lo malo delante de tus ojos: porque seas reconocido justo en tu palabra, y tenido por puro en tu juicio.", "words": [[0, 26654], [2, 26793], [6, 27053], [8, 27133], [11, 27293], [16, 27593], [19, 27793], [27, 28293], [29, 28973], [32, 29113], [38, 29553], [41, 29913], [46, 30253], [54, 30633], [57, 30793], [61, 30973], [67, 31949], [74, 32156], [79, 32456], [90, 33196], [96, 33436], [99, 33696], [102, 33816], [111, 34316], [113, 34996], [120, 35396], [124, 35616], [129, 36016], [132, 36156], [135, 36276]]}, {"verse": 5, "start": 37286, "end": 41699, "text": "He aquí, en maldad he sido formado, y en pecado me concibió mi madre.", "words": [[0, 37286], [3, 37449], [9, 37709], [12, 37869], [19, 38409], [22, 38469], [27, 38709], [36, 39269], [38, 39449], [41, 39589], [48, 40109], [51, 40289], [60, 40929], [63, 41089]]}, {"verse": 6, "start": 42049, "end": 47877, "text": "He aquí, tú amas la verdad en lo íntimo: y en lo secreto me has hecho comprender sabiduría.", "words": [[0, 42095], [3, 42175], [9, 42395], [12, 42695], [17, 43015], [20, 43115], [27, 43355], [30, 43655], [33, 43775], [41, 44613], [43, 44740], [46, 44860], [49, 44980], [57, 45560], [60, 45720], [64, 45880], [70, 46080], [81, 46999]]}, {"verse": 7, "start": 48227, "end": 54693, "text": "Purifícame con hisopo, y seré limpio: lávame, y seré emblanquecido más que la nieve.", "words": [[0, 48227], [11, 48833], [15, 49313], [23, 49793], [25, 50033], [30, 50293], [38, 51277], [46, 51806], [48, 52226], [53, 52626], [67, 53566], [71, 53806], [75, 53966], [78, 54106]]}, {"verse": 8, "start": 55043, "end": 60820, "text": "Hazme oír gozo y alegría; y se recrearán los huesos que has abatido.", "words": [[0, 55043], [6, 55520], [10, 55960], [15, 56420], [17, 56580], [26, 57506], [28, 57635], [31, 57815], [41, 58815], [45, 58995], [52, 59635], [56, 60042], [60, 60449]]}, {"verse": 9, "start": 61170, "end": 65348, "text": "Esconde tu rostro de mis pecados, y borra todas mis maldades.", "words": [[0, 61170], [8, 61618], [11, 61818], [18, 62298], [21, 62418], [25, 62538], [34, 63118], [36, 63558], [42, 63958], [48, 64218], [52, 64538]]}, {"verse": 10, "start": 65348, "end": 71700, "text": "Crea en mí, oh Dios, un corazón limpio; y renueva un espíritu recto dentro de mí.", "words": [[0, 65528], [5, 65708], [8, 65888], [12, 66138], [15, 66388], [21, 66608], [24, 66947], [32, 67348], [40, 68395], [42, 68577], [50, 69257], [53, 69417], [62, 70237], [68, 70777], [75, 71017], [78, 71357]]}, {"verse": 11, "start": 72050, "end": 76213, "text": "No me eches de delante de ti; y no quites de mí tu santo espíritu.", "words": [[0, 72050], [3, 72177], [6, 72357], [12, 72637], [15, 72877], [23, 73297], [26, 73497], [30, 74128], [32, 74251], [35, 74351], [42, 74751], [45, 74898], [48, 75044], [51, 75191], [57, 75511]]}, {"verse": 12, "start": 76563, "end": 81029, "text": "Vuélveme el gozo de tu salvación; y el espíritu libre me sustente.", "words": [[0, 76563], [9, 76921], [12, 77311], [17, 77611], [20, 77771], [23, 77891], [34, 78971], [36, 79081], [39, 79201], [48, 79701], [54, 80121], [57, 80181]]}, {"verse": 13, "start": 81379, "end": 87369, "text": "Enseñaré a los transgresores tus caminos; y los pecadores se convertirán a ti.", "words": [[0, 81379], [9, 82104], [11, 82244], [15, 82384], [29, 83304], [33, 83524], [42, 84655], [44, 84761], [48, 84861], [58, 85521], [61, 86081], [73, 86881], [75, 86981]]}, {"verse": 14, "start": 87719, "end": 94872, "text": "Líbrame de homicidios, oh Dios, Dios de mi salvación: cantará mi lengua tu justicia.", "words": [[0, 88100], [8, 88520], [11, 88680], [23, 89800], [26, 90020], [32, 90780], [37, 91120], [40, 91620], [43, 91740], [54, 92748], [62, 93288], [65, 93468], [72, 93948], [75, 94008]]}, {"verse": 15, "start": 95222, "end": 99810, "text": "Señor, abre mis labios; y publicará mi boca tu alabanza.", "words": [[0, 95222], [7, 95627], [12, 96247], [16, 96487], [24, 97474], [26, 97619], [36, 98299], [39, 98499], [44, 98759], [47, 98999]]}, {"verse": 16, "start": 100160, "end": 104937, "text": "Porque no quieres tú sacrificio, que yo daría; no quieres holocausto.", "words": [[0, 100160], [7, 100519], [10, 100739], [18, 101059], [21, 101359], [33, 102279], [37, 102399], [40, 102559], [47, 103425], [50, 103907], [58, 104422]]}, {"verse": 17, "start": 105287, "end": 113491, "text": "Los sacrificios de Dios son el espíritu quebrantado: al corazón contrito y humillado no despreciarás tú, oh Dios.", "words": [[0, 105287], [4, 105445], [16, 106325], [19, 106485], [24, 106745], [28, 107245], [31, 107445], [40, 108145], [53, 109377], [56, 109584], [64, 110024], [73, 110764], [75, 110924], [85, 111536], [88, 112003], [101, 112469], [105, 112719], [108, 112969]]}, {"verse": 18, "start": 113841, "end": 118998, "text": "Haz bien con tu benevolencia a Sion: edifica los muros de Jerusalén.", "words": [[0, 113841], [4, 114045], [9, 114305], [13, 114605], [16, 114845], [29, 115446], [31, 116047], [37, 116868], [45, 117377], [49, 117577], [55, 118017], [58, 118117]]}, {"verse": 19, "start": 119348, "end": 130799, "text": "Entonces te agradarán los sacrificios de justicia, el holocausto u ofrenda del todo quemada: entonces ofrecerán sobre tu altar becerros.", "words": [[0, 119348], [9, 119792], [12, 120112], [22, 120732], [26, 120872], [38, 121752], [41, 121852], [51, 123032], [54, 123172], [65, 124092], [67, 124532], [75, 125272], [79, 125472], [84, 125772], [93, 126827], [102, 127548], [112, 128948], [118, 129248], [121, 129508], [127, 129848]]}]}