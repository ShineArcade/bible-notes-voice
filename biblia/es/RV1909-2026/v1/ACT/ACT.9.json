{"book": "ACT", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 398552, "verses": [{"verse": 1, "start": 300, "end": 8016, "text": "Y Saulo, respirando aún amenazas y muerte contra los discípulos del Señor, vino al sumo sacerdote,", "words": [[0, 300], [2, 421], [9, 985], [20, 1549], [24, 2113], [33, 2677], [35, 3241], [42, 3601], [49, 4001], [53, 4241], [64, 4881], [68, 5041], [75, 6041], [80, 6381], [83, 6741], [88, 7161]]}, {"verse": 2, "start": 8466, "end": 19224, "text": "Y pidió de él cartas para las sinagogas de Damasco, para que si hallase algunos hombres o mujeres de esta secta, los trajese presos a Jerusalén.", "words": [[0, 8466], [2, 8624], [8, 9024], [11, 9164], [14, 9344], [21, 10024], [26, 10304], [30, 10524], [40, 11304], [43, 11444], [52, 12524], [57, 12864], [61, 13144], [64, 13184], [72, 13604], [80, 13944], [88, 14584], [90, 14924], [98, 15384], [101, 15604], [106, 15844], [113, 16944], [117, 17044], [125, 17504], [132, 18264], [134, 18384]]}, {"verse": 3, "start": 19674, "end": 28609, "text": "Y yendo por el camino, aconteció que llegando cerca de Damasco, repentinamente le cercó un resplandor de luz del cielo;", "words": [[0, 19674], [2, 19674], [8, 20140], [12, 20400], [15, 20560], [23, 21740], [33, 22420], [37, 22620], [46, 23120], [52, 23440], [55, 23700], [64, 24680], [79, 25640], [82, 25880], [88, 26400], [91, 26540], [102, 27360], [105, 27480], [109, 27680], [113, 27940]]}, {"verse": 4, "start": 29059, "end": 35915, "text": "Y cayendo en tierra, oyó una voz que le decía: Saulo, Saulo, ¿por qué me persigues?", "words": [[0, 29059], [2, 29182], [10, 29642], [13, 29782], [21, 30222], [25, 31002], [29, 31222], [33, 31522], [37, 31782], [40, 31902], [47, 33172], [54, 33442], [61, 34542], [66, 34642], [70, 34802], [73, 34942]]}, {"verse": 5, "start": 36365, "end": 45617, "text": "Y él dijo: ¿Quién eres, Señor? Y él dijo: Yo soy Jesús a quien tú persigues: dura cosa te es dar coces contra el aguijón.", "words": [[0, 36365], [2, 36532], [5, 36909], [11, 37493], [18, 37693], [24, 37953], [31, 38740], [33, 38930], [36, 39050], [42, 39899], [45, 40088], [49, 40328], [55, 40708], [57, 40948], [63, 41088], [66, 41348], [77, 42557], [82, 42840], [87, 43160], [90, 43440], [93, 43640], [97, 43920], [103, 44200], [110, 44700], [113, 45158]]}, {"verse": 6, "start": 46067, "end": 59498, "text": "Él, temblando y temeroso, dijo: Señor, ¿qué quieres que haga? Y el Señor le dice: Levántate y entra en la ciudad, y se te dirá lo que te conviene hacer.", "words": [[0, 46067], [4, 46498], [14, 47158], [16, 47278], [26, 47798], [32, 48699], [39, 49461], [44, 49581], [52, 49841], [56, 50041], [62, 51901], [64, 52058], [67, 52198], [73, 52518], [76, 52758], [82, 53621], [92, 54349], [94, 54879], [100, 55409], [103, 55549], [106, 55649], [114, 56009], [116, 56929], [119, 57069], [122, 57399], [127, 57729], [130, 58129], [134, 58269], [137, 58409], [146, 58889]]}, {"verse": 7, "start": 59948, "end": 67793, "text": "Y los hombres que iban con Saulo, se pararon atónitos, oyendo a la verdad la voz, pero no viendo a nadie.", "words": [[0, 59948], [2, 60049], [6, 60209], [14, 60589], [18, 60889], [23, 61189], [27, 61409], [34, 62159], [37, 62909], [45, 63659], [55, 64409], [62, 64829], [64, 64969], [67, 65029], [74, 65309], [77, 65569], [82, 66269], [87, 66589], [90, 66769], [97, 67069], [99, 67249]]}, {"verse": 8, "start": 68243, "end": 78185, "text": "Entonces Saulo se levantó de tierra, y abriendo los ojos, no veía a nadie: así que, llevándole por la mano, le metieron en Damasco;", "words": [[0, 68243], [9, 68827], [15, 69427], [18, 69667], [26, 70267], [29, 70367], [37, 70827], [39, 71467], [48, 71887], [52, 72127], [58, 72447], [61, 73187], [66, 73667], [68, 73807], [75, 74672], [79, 74916], [84, 75516], [95, 75996], [99, 76216], [102, 76396], [108, 76756], [111, 76816], [120, 77276], [123, 77456]]}, {"verse": 9, "start": 78635, "end": 82562, "text": "Donde estuvo tres días sin ver, y no comió, ni bebió.", "words": [[0, 78635], [6, 78861], [13, 79301], [18, 79581], [23, 79961], [27, 80241], [32, 80481], [34, 80821], [37, 81001], [44, 81541], [47, 82021]]}, {"verse": 10, "start": 83012, "end": 93692, "text": "Había entonces un discípulo en Damasco llamado Ananías, al cual el Señor dijo en visión: Ananías. Y él respondió: Aquí estoy, Señor.", "words": [[0, 83012], [6, 83323], [15, 83703], [18, 84043], [28, 84623], [31, 84763], [39, 85203], [47, 85443], [56, 86883], [59, 86983], [64, 87203], [67, 87423], [73, 87743], [78, 88343], [81, 88723], [89, 89721], [98, 91099], [100, 91246], [103, 91386], [114, 92427], [119, 92686], [126, 93146]]}, {"verse": 11, "start": 94042, "end": 106231, "text": "Y el Señor le dijo: Levántate, y ve a la calle que se llama la Derecha, y busca en casa de Judas a uno llamado Saulo, de Tarso: porque he aquí, él ora;", "words": [[0, 94042], [2, 94209], [5, 94349], [11, 94629], [14, 94889], [20, 95656], [31, 96323], [33, 96823], [36, 96983], [38, 97123], [41, 97223], [47, 97623], [51, 97923], [54, 98083], [60, 98383], [63, 98563], [72, 99343], [74, 99543], [80, 99823], [83, 100063], [88, 100363], [91, 100643], [97, 100963], [99, 101383], [103, 101543], [111, 101843], [118, 102623], [121, 103043], [128, 104137], [135, 104383], [138, 104663], [144, 105003], [147, 105637]]}, {"verse": 12, "start": 106681, "end": 114905, "text": "Y ha visto en visión un varón llamado Ananías, que entra y le pone la mano encima, para que reciba la vista.", "words": [[0, 106681], [2, 106825], [5, 106925], [11, 107185], [14, 107385], [21, 107805], [24, 108065], [30, 108505], [38, 108785], [47, 110185], [51, 110445], [57, 110885], [59, 111365], [62, 111485], [67, 111745], [70, 111965], [75, 112225], [83, 112805], [88, 113445], [92, 113775], [99, 114105], [102, 114265]]}, {"verse": 13, "start": 115355, "end": 123934, "text": "Entonces Ananías respondió: Señor, he oído a muchos acerca de este hombre, cuántos males ha hecho a tus santos en Jerusalén:", "words": [[0, 115355], [9, 115995], [17, 116875], [28, 118218], [35, 118914], [38, 118994], [43, 119254], [45, 119394], [52, 119614], [59, 120074], [62, 120354], [67, 120574], [75, 121314], [83, 121654], [89, 121934], [92, 122214], [98, 122434], [100, 122554], [104, 122694], [111, 123154], [114, 123274]]}, {"verse": 14, "start": 124384, "end": 129916, "text": "Y aun aquí tiene autoridad de los principales sacerdotes de prender a todos los que invocan tu nombre.", "words": [[0, 124384], [2, 124485], [6, 124625], [11, 124985], [17, 125285], [27, 125825], [30, 125965], [34, 126045], [46, 126725], [57, 127425], [60, 127605], [68, 128085], [70, 128165], [76, 128385], [80, 128625], [84, 128825], [92, 129285], [95, 129425]]}, {"verse": 15, "start": 130266, "end": 140936, "text": "Y le dijo el Señor: Ve: porque instrumento escogido me es este, para que lleve mi nombre en presencia de los Gentiles, y de reyes, y de los hijos de Israel:", "words": [[0, 130266], [2, 130389], [5, 130489], [10, 130749], [13, 130909], [20, 131951], [24, 132433], [31, 132637], [43, 133617], [52, 134197], [55, 134377], [58, 134617], [64, 135017], [69, 135617], [73, 135737], [79, 136057], [82, 136197], [89, 136517], [92, 136697], [102, 137297], [105, 137457], [109, 137597], [119, 138217], [121, 138637], [124, 138757], [131, 139237], [133, 139497], [136, 139617], [140, 139737], [146, 140037], [149, 140257]]}, {"verse": 16, "start": 141386, "end": 145388, "text": "Porque yo le mostraré cuánto tendrá que padecer por mi nombre.", "words": [[0, 141386], [7, 141634], [10, 141894], [13, 142034], [22, 142654], [29, 143174], [36, 143554], [40, 143674], [48, 144334], [52, 144594], [55, 144794]]}, {"verse": 17, "start": 145838, "end": 161315, "text": "Ananías entonces fue, y entró en la casa, y poniéndole las manos encima, dijo: Saulo hermano, el Señor Jesús, que te apareció en el camino por donde venías, me ha enviado para que recibas la vista y seas lleno de Espíritu Santo.", "words": [[0, 145838], [8, 146438], [17, 146858], [22, 147378], [24, 147718], [30, 148118], [33, 148218], [36, 148358], [42, 148758], [44, 149278], [55, 149738], [59, 150198], [65, 150658], [73, 151078], [79, 152299], [85, 152812], [94, 153212], [97, 153252], [103, 153512], [110, 154652], [114, 154712], [117, 154852], [126, 155312], [129, 155392], [132, 155512], [139, 155812], [143, 156112], [149, 156352], [157, 157332], [160, 157512], [163, 157632], [171, 158092], [176, 158312], [180, 158622], [188, 158932], [191, 159112], [197, 159372], [199, 159572], [204, 159772], [210, 160172], [213, 160272], [222, 160732]]}, {"verse": 18, "start": 161665, "end": 170106, "text": "Y de inmediato le cayeron de los ojos como escamas, y recibió al punto la vista: y levantándose, fue bautizado.", "words": [[0, 161665], [2, 161866], [5, 161946], [15, 162706], [18, 162866], [26, 163366], [29, 163486], [33, 163626], [38, 163946], [43, 164246], [52, 164886], [54, 165426], [62, 166186], [65, 166366], [71, 166706], [74, 166946], [81, 167863], [83, 168121], [97, 168901], [101, 169141]]}, {"verse": 19, "start": 170556, "end": 177601, "text": "Y como comió, recobró las fuerzas. Y estuvo Saulo por algunos días con los discípulos que estaban en Damasco.", "words": [[0, 170556], [2, 170694], [7, 171134], [14, 171574], [22, 172074], [26, 172234], [35, 173422], [37, 173578], [44, 173768], [50, 174308], [54, 174548], [62, 174828], [67, 175168], [71, 175388], [75, 175508], [86, 176108], [90, 176308], [98, 176628], [101, 176848]]}, {"verse": 20, "start": 178051, "end": 184830, "text": "Y de inmediato en las sinagogas predicaba a Cristo, diciendo que este era el Hijo de Dios.", "words": [[0, 178051], [2, 178391], [5, 178471], [15, 179371], [18, 179658], [22, 179944], [32, 180231], [42, 180991], [44, 181171], [52, 182271], [61, 182711], [65, 183071], [70, 183411], [74, 183651], [77, 183811], [82, 184071], [85, 184211]]}, {"verse": 21, "start": 185280, "end": 197965, "text": "Y todos los que le oían estaban atónitos, y decían: ¿No es este el que asolaba en Jerusalén a los que invocaban este nombre, y a eso vino acá, para llevarlos presos a los principales sacerdotes?", "words": [[0, 185280], [2, 185407], [8, 185747], [12, 186287], [16, 186467], [19, 186607], [24, 186967], [32, 187247], [42, 188487], [44, 188567], [52, 189732], [56, 189930], [59, 190090], [64, 190370], [67, 190470], [71, 190590], [79, 191010], [82, 191110], [92, 191710], [94, 191790], [98, 191910], [102, 192050], [112, 192550], [117, 192790], [125, 193130], [127, 193790], [129, 193910], [133, 194110], [138, 194390], [143, 194750], [148, 195270], [158, 195790], [165, 196250], [167, 196350], [171, 196470], [183, 197090]]}, {"verse": 22, "start": 198315, "end": 206715, "text": "Pero Saulo mucho más se esforzaba, y confundía a los judíos que moraban en Damasco, afirmando que este es el Cristo.", "words": [[0, 198315], [5, 198500], [11, 198900], [17, 199220], [21, 199520], [24, 199760], [35, 200540], [37, 201020], [47, 201760], [49, 201980], [53, 202080], [60, 202600], [64, 202760], [72, 203220], [75, 203400], [84, 204280], [94, 205020], [98, 205220], [103, 205560], [106, 205840], [109, 205960]]}, {"verse": 23, "start": 207165, "end": 210812, "text": "Y como pasaron muchos días, los judíos tramaron matarlo;", "words": [[0, 207165], [2, 207274], [7, 207494], [15, 207934], [22, 208214], [28, 208934], [32, 209014], [39, 209474], [48, 209954]]}, {"verse": 24, "start": 211262, "end": 218317, "text": "Pero las tramas de ellos fueron entendidas de Saulo. Y ellos guardaban las puertas de día y de noche para matarle.", "words": [[0, 211262], [5, 211404], [9, 211604], [16, 212004], [19, 212164], [25, 212344], [32, 212664], [43, 213464], [46, 213624], [53, 214513], [55, 214881], [61, 215101], [71, 215661], [75, 215841], [83, 216241], [86, 216401], [90, 216641], [92, 216841], [95, 216961], [101, 217261], [106, 217541]]}, {"verse": 25, "start": 218767, "end": 226098, "text": "Entonces los discípulos, tomándole de noche, le bajaron por el muro en una canasta.", "words": [[0, 218767], [9, 219452], [13, 220392], [25, 221552], [35, 222692], [38, 222892], [45, 223232], [48, 223772], [56, 224252], [60, 224492], [63, 224672], [68, 225052], [71, 225192], [75, 225352]]}, {"verse": 26, "start": 226548, "end": 235868, "text": "Y cuando vino a Jerusalén, intentaba juntarse con los discípulos; pero todos tenían miedo de él, no creyendo que era discípulo.", "words": [[0, 226548], [2, 226634], [9, 226854], [14, 227154], [16, 227314], [27, 228054], [37, 228874], [46, 229614], [50, 229834], [54, 230014], [66, 231220], [71, 231364], [77, 231764], [84, 232304], [90, 232764], [93, 233024], [97, 233664], [100, 233944], [109, 234524], [113, 234724], [117, 234924]]}, {"verse": 27, "start": 236318, "end": 251700, "text": "Entonces Bernabé, tomándole, lo trajo a los apóstoles, y les contó cómo había visto al Señor en el camino, y que le había hablado, y cómo en Damasco había hablado confiadamente en el nombre de Jesús.", "words": [[0, 236318], [9, 236916], [18, 237756], [29, 239156], [32, 239436], [38, 239836], [40, 239936], [44, 240056], [55, 240796], [57, 241616], [61, 241756], [67, 242256], [72, 242516], [78, 242876], [84, 243216], [87, 243396], [93, 243736], [96, 243996], [99, 244096], [107, 244616], [109, 245156], [113, 245276], [116, 245456], [122, 245736], [131, 246816], [133, 246941], [138, 247281], [141, 247481], [149, 248081], [155, 248381], [163, 249041], [177, 249841], [180, 250281], [183, 250421], [190, 250801], [193, 251001]]}, {"verse": 28, "start": 252150, "end": 255376, "text": "Y entraba y salía con ellos en Jerusalén;", "words": [[0, 252150], [2, 252314], [10, 253034], [12, 253254], [18, 253714], [22, 253974], [28, 254274], [31, 254514]]}, {"verse": 29, "start": 255826, "end": 264639, "text": "Y hablaba confiadamente en el nombre del Señor: y debatía con los judíos de habla griega; pero ellos procuraban matarle.", "words": [[0, 255826], [2, 256160], [10, 256581], [24, 257441], [27, 257781], [30, 257920], [37, 258240], [41, 258480], [48, 259420], [50, 259541], [58, 260181], [62, 260421], [66, 260581], [73, 261201], [76, 261361], [82, 261601], [90, 262650], [95, 262797], [101, 263017], [112, 263757]]}, {"verse": 30, "start": 265089, "end": 271242, "text": "Lo cual, como los hermanos entendieron, le acompañaron hasta Cesarea, y le enviaron a Tarso.", "words": [[0, 265089], [3, 265234], [9, 265554], [14, 265694], [18, 265874], [27, 266394], [40, 267194], [43, 267234], [55, 268034], [61, 268334], [70, 269034], [72, 269714], [75, 269854], [84, 270474], [86, 270634]]}, {"verse": 31, "start": 271692, "end": 285650, "text": "Las iglesias entonces tenían paz por toda Judea y Galilea y Samaria, y eran edificadas, andando en el temor del Señor; y con consuelo del Espíritu Santo eran multiplicadas.", "words": [[0, 271692], [4, 271831], [13, 272511], [22, 273031], [29, 273631], [33, 274031], [37, 274451], [42, 274771], [48, 275531], [50, 275631], [58, 276291], [60, 276431], [69, 277031], [71, 277651], [76, 277951], [88, 279451], [96, 280051], [99, 280171], [102, 280311], [108, 280731], [112, 280891], [119, 281941], [121, 282040], [125, 282260], [134, 282980], [138, 283080], [147, 283640], [153, 283900], [158, 284180]]}, {"verse": 32, "start": 286100, "end": 293865, "text": "Y aconteció que Pedro, recorriendo todos aquellos lugares, vino también a los santos que habitaban en Lida.", "words": [[0, 286100], [2, 286227], [12, 286827], [16, 287007], [23, 287987], [35, 289007], [41, 289307], [50, 289707], [59, 290827], [64, 290987], [72, 291447], [74, 291727], [78, 291827], [85, 292387], [89, 292507], [99, 293007], [102, 293187]]}, {"verse": 33, "start": 294315, "end": 301657, "text": "Y halló allí a uno que se llamaba Eneas, que hacía ocho años que estaba en cama, que era paralítico.", "words": [[0, 294315], [2, 294456], [8, 294756], [13, 295096], [15, 295356], [19, 295536], [23, 295696], [26, 295836], [34, 296676], [41, 297516], [45, 297556], [51, 297896], [56, 298456], [61, 298756], [65, 298996], [72, 299276], [75, 299516], [81, 300456], [85, 300576], [89, 300716]]}, {"verse": 34, "start": 302107, "end": 311913, "text": "Y le dijo Pedro: Eneas, Jesucristo te sana; levántate, y hazte tu cama. Y de inmediato se levantó.", "words": [[0, 302107], [2, 302254], [5, 302314], [10, 302574], [17, 304213], [24, 304713], [35, 305433], [38, 305613], [44, 306427], [55, 307110], [57, 307410], [63, 307750], [66, 307910], [72, 309910], [74, 310072], [77, 310152], [87, 310912], [90, 311092]]}, {"verse": 35, "start": 312363, "end": 318408, "text": "Y le vieron todos los que habitaban en Lida y en Sarón, los cuales se convirtieron al Señor.", "words": [[0, 312363], [2, 312492], [5, 312612], [12, 312932], [18, 313332], [22, 313792], [26, 313992], [36, 314512], [39, 314652], [44, 315052], [46, 315192], [49, 315702], [56, 316212], [60, 316312], [67, 316552], [70, 316792], [83, 317592], [86, 317792]]}, {"verse": 36, "start": 318858, "end": 329342, "text": "Entonces en Jope había una discípula llamada Tabita, que traducido quiere decir Dorcas. Esta era llena de buenas obras y de limosnas que hacía.", "words": [[0, 318858], [9, 319583], [12, 320033], [17, 320483], [23, 320703], [27, 320943], [37, 321723], [45, 322163], [53, 322783], [57, 323283], [67, 323983], [74, 324223], [80, 324934], [88, 325894], [93, 326161], [97, 326341], [103, 326701], [106, 326841], [113, 327081], [119, 327561], [121, 327901], [124, 328201], [133, 328501], [137, 328701]]}, {"verse": 37, "start": 329792, "end": 336862, "text": "Y aconteció en aquellos días que enfermando, murió; a la cual, después de lavada, pusieron en una sala.", "words": [[0, 329792], [2, 330108], [12, 330454], [15, 330801], [24, 331001], [29, 331361], [33, 331621], [45, 332721], [52, 333569], [54, 333675], [57, 333755], [63, 333955], [71, 334235], [74, 334595], [82, 334955], [91, 335795], [94, 336135], [98, 336295]]}, {"verse": 38, "start": 337312, "end": 348158, "text": "Y como Lida estaba cerca de Jope, los discípulos, oyendo que Pedro estaba allí, le enviaron dos hombres, rogándole: No tardes en venir hasta nosotros.", "words": [[0, 337312], [2, 337579], [7, 337949], [12, 338319], [19, 338659], [25, 339039], [28, 339339], [34, 340279], [38, 340359], [50, 341479], [57, 341779], [61, 341959], [67, 342199], [74, 342499], [80, 343339], [83, 343439], [92, 343959], [96, 344239], [105, 345059], [116, 346093], [119, 346296], [126, 346716], [129, 346876], [135, 347136], [141, 347376]]}, {"verse": 39, "start": 348508, "end": 364100, "text": "Pedro entonces levantándose, fue con ellos: y llegado que hubo, le llevaron a la sala, donde le rodearon todas las viudas, llorando y mostrando las túnicas y los vestidos que Dorcas hacía cuando estaba con ellas.", "words": [[0, 348508], [6, 348752], [15, 349852], [29, 351112], [33, 351352], [37, 351612], [44, 352503], [46, 352611], [54, 353011], [58, 353231], [64, 353711], [67, 354191], [76, 354651], [78, 354771], [81, 354851], [87, 355791], [93, 356151], [96, 356511], [105, 357211], [111, 357571], [115, 357891], [123, 358831], [132, 359291], [134, 359391], [144, 359931], [148, 360111], [156, 360771], [158, 361051], [162, 361191], [171, 361711], [175, 361871], [182, 362251], [188, 362671], [195, 362951], [202, 363291], [206, 363551]]}, {"verse": 40, "start": 364550, "end": 378018, "text": "Entonces echados fuera todos, Pedro puesto de rodillas, oró; y vuelto al cuerpo, dijo: Tabita, levántate. Y ella abrió los ojos, y viendo a Pedro, se incorporó.", "words": [[0, 364550], [9, 365111], [17, 365911], [23, 366251], [30, 367051], [36, 367491], [43, 367931], [46, 368231], [56, 369011], [61, 369721], [63, 369846], [70, 370246], [73, 370346], [81, 370766], [87, 371711], [95, 372132], [106, 373092], [108, 373291], [113, 373551], [119, 374051], [123, 374231], [129, 374711], [131, 375431], [138, 375711], [140, 375891], [147, 376231], [150, 376931]]}, {"verse": 41, "start": 378468, "end": 386240, "text": "Y él le dio la mano, y la levantó: entonces llamando a los santos y las viudas, la presentó viva.", "words": [[0, 378468], [2, 378628], [5, 378768], [8, 378928], [12, 379108], [15, 379248], [21, 379648], [23, 380188], [26, 380308], [35, 381369], [44, 382249], [53, 382749], [55, 382829], [59, 382929], [66, 383529], [68, 383649], [72, 383809], [80, 384709], [83, 385049], [92, 385589]]}, {"verse": 42, "start": 386690, "end": 391466, "text": "Esto fue notorio por toda Jope; y creyeron muchos en el Señor.", "words": [[0, 386690], [5, 386997], [9, 387237], [17, 387817], [21, 388057], [26, 388534], [32, 389238], [34, 389592], [43, 389982], [50, 390462], [53, 390742], [56, 390922]]}, {"verse": 43, "start": 391916, "end": 398152, "text": "Y aconteció que se quedó muchos días en Jope en casa de un cierto Simón, curtidor.", "words": [[0, 391916], [2, 392236], [12, 392996], [16, 393196], [19, 393356], [25, 393716], [32, 393956], [37, 394336], [40, 394656], [45, 394976], [48, 395336], [53, 395676], [56, 395976], [59, 396096], [66, 396316], [73, 397252]]}]}