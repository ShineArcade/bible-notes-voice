{"book": "GEN", "chapter": 24, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 549220, "verses": [{"verse": 1, "start": 300, "end": 6490, "text": "And Abraham was old, and well stricken in age: and the LORD had blessed Abraham in all things.", "words": [[0, 300], [4, 425], [12, 725], [16, 1205], [21, 1645], [25, 1965], [30, 2225], [39, 2765], [42, 2925], [47, 3796], [51, 3940], [55, 4060], [60, 4320], [64, 4520], [72, 4800], [80, 5400], [83, 5640], [87, 5800]]}, {"verse": 2, "start": 6940, "end": 14719, "text": "And Abraham said to his eldest servant of his house, that ruled over all that he had, Put, please, your hand under my thigh:", "words": [[0, 6940], [4, 7108], [12, 7448], [17, 7888], [20, 8108], [24, 8268], [31, 8568], [39, 9068], [42, 9308], [46, 9428], [53, 10268], [58, 10468], [64, 10808], [69, 11168], [73, 11588], [78, 11828], [81, 11968], [86, 12651], [91, 12758], [99, 13378], [104, 13498], [109, 13778], [115, 13978], [118, 14178]]}, {"verse": 3, "start": 15169, "end": 23901, "text": "And I will make you swear by the LORD, the God of heaven, and the God of the earth, that you shall not take a wife to my son of the daughters of the Canaanites, among whom I dwell:", "words": [[0, 15169], [4, 15272], [6, 15372], [11, 15492], [16, 15672], [20, 15792], [26, 16132], [29, 16352], [33, 16512], [39, 16872], [43, 16972], [47, 17192], [50, 17292], [58, 17572], [62, 17972], [66, 18092], [70, 18292], [73, 18412], [77, 18552], [84, 19192], [89, 19316], [93, 19456], [99, 19676], [103, 19936], [108, 20156], [110, 20296], [115, 20496], [118, 20676], [121, 20796], [125, 21076], [128, 21176], [132, 21296], [142, 21576], [145, 21796], [149, 21916], [161, 22776], [167, 22976], [172, 23276], [174, 23456]]}, {"verse": 4, "start": 24351, "end": 28666, "text": "But you shall go to my country, and to my kindred, and take a wife to my son Isaac.", "words": [[0, 24351], [4, 24506], [8, 24626], [14, 24806], [17, 25006], [20, 25146], [23, 25306], [32, 25686], [36, 26066], [39, 26186], [42, 26326], [51, 26766], [55, 26986], [60, 27186], [62, 27326], [67, 27566], [70, 27746], [73, 27846], [77, 28066]]}, {"verse": 5, "start": 29016, "end": 36750, "text": "And the servant said to him, Perhaps the woman will not be willing to follow me to this land: must I needs bring your son again to the land from where you came?", "words": [[0, 29016], [4, 29143], [8, 29283], [16, 29543], [21, 29843], [24, 30043], [29, 30589], [37, 30882], [41, 31142], [47, 31342], [52, 31562], [56, 31762], [59, 31882], [67, 32122], [70, 32322], [77, 32602], [80, 32762], [83, 32882], [88, 33062], [94, 33814], [99, 33993], [101, 34153], [107, 34313], [113, 34553], [118, 34693], [122, 34933], [128, 35193], [131, 35413], [135, 35553], [140, 35753], [145, 35933], [151, 36113], [155, 36253]]}, {"verse": 6, "start": 37100, "end": 42396, "text": "And Abraham said to him, Beware that you bring not my son there again.", "words": [[0, 37100], [4, 37225], [12, 37625], [17, 37985], [20, 38185], [25, 38817], [32, 39196], [37, 39396], [41, 39536], [47, 39756], [51, 39996], [54, 40236], [58, 40516], [64, 40696]]}, {"verse": 7, "start": 42846, "end": 56819, "text": "¶ The LORD God of heaven, which took me from my father’s house, and from the land of my kindred, and which spoke to me, and that swore to me, saying, To your seed will I give this land; he shall send his angel before you, and you shall take a wife to my son from there.", "words": [[2, 42846], [6, 43008], [11, 43308], [15, 43668], [18, 43828], [26, 44088], [32, 44508], [37, 44728], [40, 44888], [45, 45048], [48, 45228], [57, 45648], [64, 45848], [68, 46388], [73, 46528], [77, 46668], [82, 46888], [85, 47008], [88, 47148], [97, 47628], [101, 47888], [107, 48048], [113, 48328], [116, 48528], [120, 48668], [124, 48848], [129, 49008], [135, 49328], [138, 49468], [142, 49588], [150, 50493], [153, 50588], [158, 50928], [163, 51268], [168, 51368], [170, 51488], [175, 51688], [180, 51928], [186, 52798], [18