{"book": "JHN", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 301316, "verses": [{"verse": 1, "start": 300, "end": 13525, "text": "Antes de la fiesta de la Pascua, sabiendo Jesús que su hora había venido para que pasase de este mundo al Padre, como había amado a los suyos que estaban en el mundo, los amó hasta el fin.", "words": [[0, 300], [6, 642], [9, 822], [12, 942], [19, 1362], [22, 1482], [25, 1602], [33, 2562], [42, 3222], [48, 3642], [52, 4102], [55, 4342], [60, 4702], [66, 5082], [73, 5562], [78, 5822], [82, 6002], [89, 6522], [92, 6682], [97, 6942], [103, 7242], [106, 7422], [113, 8288], [118, 8537], [124, 8877], [130, 9537], [132, 9637], [136, 9777], [142, 10257], [146, 10377], [154, 10677], [157, 10897], [160, 11057], [167, 11797], [171, 12197], [175, 12637], [181, 12897], [184, 13057]]}, {"verse": 2, "start": 13875, "end": 22622, "text": "Y la cena acabada, como el diablo ya había metido en el corazón de Judas, hijo de Simón Iscariote, que le entregase,", "words": [[0, 13875], [2, 14001], [5, 14141], [10, 14421], [19, 15141], [24, 15521], [27, 15761], [34, 16241], [37, 16521], [43, 16761], [50, 17361], [53, 17481], [56, 17601], [64, 18021], [67, 18261], [74, 19041], [79, 19421], [82, 19661], [88, 20241], [99, 21536], [103, 21616], [106, 21756]]}, {"verse": 3, "start": 22972, "end": 30653, "text": "Sabiendo Jesús que el Padre le había dado todas las cosas en las manos, y que había salido de Dios, y a Dios iba,", "words": [[0, 22972], [9, 23351], [15, 23771], [19, 24331], [22, 24491], [28, 24931], [31, 25051], [37, 25311], [42, 25651], [48, 25991], [52, 26291], [58, 26591], [61, 26851], [65, 26991], [72, 27411], [74, 27831], [78, 27971], [84, 28191], [91, 28731], [94, 28911], [100, 29251], [102, 29606], [104, 29726], [109, 29946]]}, {"verse": 4, "start": 31003, "end": 37005, "text": "Se levanta de la cena, y se quita su ropa, y tomando una toalla, se la ató a la cintura.", "words": [[0, 31003], [3, 31163], [11, 31703], [14, 31803], [17, 31923], [23, 32263], [25, 32523], [28, 32683], [34, 32983], [37, 33163], [43, 33643], [45, 33843], [53, 34303], [57, 34463], [65, 35463], [68, 35563], [71, 35770], [75, 35976], [77, 36183], [80, 36263]]}, {"verse": 5, "start": 37355, "end": 47497, "text": "Luego puso agua en una palangana, y comenzó a lavar los pies de los discípulos, y a limpiarlos con la toalla que llevaba atada a la cintura.", "words": [[0, 37355], [6, 37639], [11, 38359], [16, 38739], [19, 39019], [23, 39199], [34, 39959], [36, 40639], [44, 41179], [46, 41299], [52, 41639], [56, 41779], [61, 42139], [64, 42359], [68, 42499], [80, 43219], [82, 43439], [84, 43539], [95, 44319], [99, 44579], [102, 44759], [109, 45179], [113, 45379], [121, 45799], [127, 46399], [129, 46619], [132, 46719]]}, {"verse": 6, "start": 47847, "end": 53641, "text": "Entonces vino a Simón Pedro; y Pedro le dice: ¿Señor, tú me lavas los pies?", "words": [[0, 47847], [9, 48411], [14, 49111], [16, 49351], [22, 49751], [29, 50656], [31, 50802], [37, 51122], [40, 51342], [46, 52114], [54, 52522], [57, 52582], [60, 52702], [66, 52982], [70, 53122]]}, {"verse": 7, "start": 53921, "end": 60644, "text": "Respondió Jesús, y le dijo: Lo que yo hago, tú no entiendes ahora; pero lo entenderás después.", "words": [[0, 53921], [10, 54522], [17, 54802], [19, 55062], [22, 55162], [28, 56077], [31, 56342], [35, 56502], [38, 56722], [44, 57082], [47, 57282], [50, 57442], [60, 58062], [67, 58970], [72, 59111], [75, 59291], [86, 59971]]}, {"verse": 8, "start": 60994, "end": 68707, "text": "Le dice Pedro: No me lavarás los pies jamás. Le respondió Jesús: Si no te lavo, no tendrás parte conmigo.", "words": [[0, 60994], [3, 61118], [8, 61358], [15, 62137], [18, 62296], [21, 62436], [29, 62916], [33, 63056], [38, 63316], [45, 64234], [48, 64363], [58, 64943], [65, 65820], [68, 65964], [71, 66104], [74, 66244], [80, 66884], [83, 67124], [91, 67524], [97, 67864]]}, {"verse": 9, "start": 69057, "end": 73853, "text": "Le dice Simón Pedro: Señor, no sólo mis pies, sino también las manos y la cabeza.", "words": [[0, 69057], [3, 69199], [8, 69439], [14, 69859], [21, 70598], [28, 71013], [31, 71093], [36, 71313], [40, 71493], [46, 72033], [51, 72173], [59, 72553], [63, 72733], [69, 73033], [71, 73213], [74, 73313]]}, {"verse": 10, "start": 74133, "end": 83914, "text": "Le dice Jesús: El que se ha bañado, no necesita sino que lave los pies, pero está todo limpio: y vosotros limpios estáis, aunque no todos.", "words": [[0, 74133], [3, 74335], [8, 74575], [15, 75623], [18, 75750], [22, 75890], [25, 76030], [28, 76170], [36, 76690], [39, 76870], [48, 77430], [53, 77730], [57, 77950], [62, 78270], [66, 78390], [72, 79290], [77, 79470], [82, 79650], [87, 79890], [95, 80868], [97, 80975], [106, 81415], [114, 81975], [122, 82815], [129, 83015], [132, 83255]]}, {"verse": 11, "start": 84264, "end": 89743, "text": "Porque sabía quién le había de entregar; por eso dijo: No estáis limpios todos.", "words": [[0, 84264], [7, 84726], [13, 85186], [19, 85446], [22, 85706], [28, 85926], [31, 86086], [41, 86980], [45, 87102], [49, 87302], [55, 88102], [58, 88208], [65, 88588], [73, 89068]]}, {"verse": 12, "start": 90093, "end": 99143, "text": "Así que, después que les hubo lavado los pies, y tomado su ropa, volviéndose a sentar a la mesa, les dijo: ¿Sabéis lo que os he hecho?", "words": [[0, 90093], [4, 90338], [9, 90538], [17, 90938], [21, 91158], [25, 91338], [30, 91798], [37, 92218], [41, 92358], [47, 92638], [49, 92918], [56, 93318], [59, 93518], [65, 94198], [77, 95078], [79, 95258], [86, 95738], [88, 95798], [91, 95918], [97, 96278], [101, 96358], [107, 97362], [115, 97826], [118, 98146], [122, 98326], [125, 98486], [128, 98626]]}, {"verse": 13, "start": 99493, "end": 105468, "text": "Vosotros me llamáis, Maestro, y, Señor: y decís bien; porque lo soy.", "words": [[0, 99493], [9, 100018], [12, 100238], [21, 100718], [30, 101458], [33, 102098], [40, 103059], [42, 103186], [48, 103666], [54, 104635], [61, 104789], [64, 104942]]}, {"verse": 14, "start": 105818, "end": 114145, "text": "Pues si yo, el Señor y el Maestro, he lavado vuestros pies, vosotros también debéis lavar los pies los unos a los otros.", "words": [[0, 105818], [5, 105962], [8, 106142], [12, 106742], [15, 106762], [21, 107182], [23, 107502], [26, 107682], [35, 108722], [38, 109022], [45, 109442], [54, 109862], [60, 110702], [69, 111122], [77, 111382], [84, 111862], [90, 112222], [94, 112362], [99, 112622], [103, 112902], [108, 113182], [110, 113402], [114, 113562]]}, {"verse": 15, "start": 114495, "end": 120211, "text": "Porque ejemplo os he dado, para que como yo os he hecho, vosotros también hagáis.", "words": [[0, 114495], [7, 114738], [15, 115198], [18, 115478], [21, 115578], [27, 115818], [32, 116118], [36, 116318], [41, 116638], [44, 116958], [47, 117198], [50, 117438], [57, 118398], [66, 118918], [74, 119258]]}, {"verse": 16, "start": 120561, "end": 128761, "text": "De cierto, de cierto os digo: El siervo no es mayor que su señor, ni el apóstol es mayor que el que le envió.", "words": [[0, 120821], [3, 121113], [11, 121405], [14, 121697], [21, 121989], [24, 122229], [30, 122908], [33, 123065], [40, 123685], [43, 123920], [46, 124160], [52, 124580], [56, 124760], [59, 124940], [66, 125780], [69, 125920], [72, 126120], [80, 126860], [83, 127120], [89, 127520], [93, 127800], [96, 127940], [100, 128080], [103, 128220]]}, {"verse": 17, "start": 129111, "end": 133505, "text": "Si sabéis estas cosas, bienaventurados seréis, si las hacéis.", "words": [[0, 129111], [3, 129235], [10, 129655], [16, 129855], [23, 130755], [39, 131595], [47, 132175], [50, 132655], [54, 132835]]}, {"verse": 18, "start": 133855, "end": 144576, "text": "No hablo de todos vosotros: yo sé los que he elegido: pero para que se cumpla la Escritura: El que come pan conmigo, levantó contra mí su talón.", "words": [[0, 133855], [3, 134095], [9, 134515], [12, 134675], [18, 134975], [28, 136125], [31, 136372], [34, 136582], [38, 136792], [42, 136992], [45, 137172], [54, 138116], [59, 138263], [64, 138503], [68, 138683], [71, 138843], [78, 139523], [81, 139683], [92, 140839], [95, 140966], [99, 141086], [104, 141326], [108, 141626], [117, 142366], [125, 143226], [132, 143466], [135, 143746], [138, 143886]]}, {"verse": 19, "start": 144926, "end": 151132, "text": "Desde ahora os lo digo antes que se haga, para que cuando se haga, creáis que yo soy.", "words": [[0, 144926], [6, 145151], [12, 145491], [15, 145711], [18, 145871], [23, 146151], [29, 146651], [33, 146891], [36, 147091], [42, 147791], [47, 148191], [51, 148351], [58, 148611], [61, 148951], [67, 149731], [74, 150251], [78, 150431], [81, 150611]]}, {"verse": 20, "start": 151482, "end": 160979, "text": "De cierto, de cierto os digo: El que recibe al que yo envío, a mí recibe; y quien me recibe a mí, recibe al que me envió.", "words": [[0, 151742], [3, 152034], [11, 152326], [14, 152618], [21, 152910], [24, 153150], [30, 153829], [33, 154015], [37, 154135], [44, 154755], [47, 154895], [51, 155035], [54, 155255], [61, 155775], [63, 155975], [66, 156235], [74, 157836], [76, 157961], [82, 158221], [85, 158501], [92, 159001], [94, 159081], [98, 159601], [105, 160081], [108, 160181], [112, 160321], [115, 160461]]}, {"verse": 21, "start": 161329, "end": 170514, "text": "Cuando hubo dicho Jesús esto, fue conmovido en el espíritu, y declaró, y dijo: De cierto, de cierto os digo, que uno de vosotros me ha de entregar.", "words": [[0, 161329], [7, 161515], [12, 161895], [18, 162115], [24, 162455], [30, 163135], [34, 163155], [44, 163995], [47, 164115], [50, 164235], [60, 164855], [62, 164995], [71, 165575], [73, 165715], [79, 166645], [82, 166905], [90, 167165], [93, 167425], [100, 167685], [103, 167885], [109, 168205], [113, 168430], [117, 168630], [120, 168810], [129, 169290], [132, 169550], [135, 169670], [138, 169790]]}, {"verse": 22, "start": 170864, "end": 176020, "text": "Entonces los discípulos se miraban los unos a los otros, sin saber de quién hablaba.", "words": [[0, 170864], [9, 171404], [13, 171724], [24, 172384], [27, 172604], [35, 172964], [39, 173144], [44, 173384], [46, 173564], [50, 173724], [57, 174324], [61, 174584], [67, 174944], [70, 175124], [76, 175304]]}, {"verse": 23, "start": 176370, "end": 182646, "text": "Y uno de sus discípulos, al cual Jesús amaba, estaba recostado junto al pecho de Jesús.", "words": [[0, 176370], [2, 176531], [6, 176691], [9, 176831], [13, 176991], [25, 177911], [28, 178191], [33, 178371], [39, 178711], [46, 179831], [53, 180111], [63, 180911], [69, 181131], [72, 181431], [78, 181831], [81, 181971]]}, {"verse": 24, "start": 182996, "end": 190189, "text": "A este, pues, hizo señas Simón Pedro, para que preguntase quién era aquel de quien decía.", "words": [[0, 182996], [2, 183137], [8, 183477], [14, 183937], [19, 184717], [25, 185277], [31, 185637], [38, 186617], [43, 186677], [47, 186817], [58, 187477], [64, 188037], [68, 188517], [74, 189057], [77, 189197], [83, 189397]]}, {"verse": 25, "start": 190539, "end": 196174, "text": "Él entonces recostándose sobre el pecho de Jesús, le dice: Señor, ¿quién es?", "words": [[0, 190539], [3, 190726], [12, 191459], [25, 192391], [31, 192751], [34, 193051], [40, 193431], [43, 193551], [50, 194431], [53, 194511], [59, 195245], [66, 195669], [73, 195849]]}, {"verse": 26, "start": 196454, "end": 204531, "text": "Respondió Jesús: Aquel es, a quien yo dé el pan mojado. Y mojando el pan, lo dio a Judas Iscariote, hijo de Simón.", "words": [[0, 196709], [10, 196989], [17, 197837], [23, 198185], [27, 198465], [29, 198670], [35, 198870], [38, 199037], [41, 199203], [44, 199370], [48, 199710], [56, 200582], [58, 200708], [66, 201168], [69, 201348], [74, 201608], [77, 201848], [81, 202088], [83, 202288], [89, 202448], [100, 203528], [105, 203728], [108, 203928]]}, {"verse": 27, "start": 204881, "end": 212656, "text": "Y tras el bocado Satanás entró en él. Entonces Jesús le dice: Lo que haces, hazlo más pronto.", "words": [[0, 204881], [2, 205112], [7, 205292], [10, 205532], [17, 205952], [25, 206672], [31, 207292], [34, 207512], [38, 208090], [47, 208611], [53, 209191], [56, 209571], [62, 210391], [65, 210517], [69, 210657], [76, 211328], [82, 211788], [86, 212008]]}, {"verse": 28, "start": 213006, "end": 218012, "text": "Pero ninguno de los que estaban a la mesa entendió a qué propósito le dijo esto.", "words": [[0, 213006], [5, 213197], [13, 214137], [16, 214257], [20, 214397], [24, 214537], [32, 214797], [34, 214997], [37, 215097], [42, 215337], [51, 215937], [53, 216137], [57, 216297], [67, 217097], [70, 217237], [75, 217517]]}, {"verse": 29, "start": 218362, "end": 228793, "text": "Porque los unos pensaban, porque Judas tenía la bolsa, que Jesús le decía: Compra lo que necesitamos para la fiesta: o, que diese algo a los pobres.", "words": [[0, 218362], [7, 218586], [11, 218786], [16, 218986], [26, 220166], [33, 220506], [39, 220886], [45, 221286], [48, 221466], [55, 221986], [59, 222161], [65, 222521], [68, 222901], [75, 223805], [82, 224290], [85, 224530], [89, 224670], [101, 225490], [106, 225770], [109, 225950], [117, 226841], [120, 227021], [124, 227211], [130, 227401], [135, 227821], [137, 227961], [141, 228041]]}, {"verse": 30, "start": 229143, "end": 233796, "text": "Como él pues hubo tomado el bocado, salió de inmediato: y era ya noche.", "words": [[0, 229143], [5, 229325], [8, 229685], [13, 229885], [18, 230125], [25, 230525], [28, 230605], [36, 231125], [42, 231465], [45, 231605], [56, 232666], [58, 232832], [62, 233012], [65, 233192]]}, {"verse": 31, "start": 234146, "end": 241982, "text": "Entonces como él salió, dijo Jesús: Ahora es glorificado el Hijo del hombre, y Dios es glorificado en él.", "words": [[0, 234146], [9, 234831], [14, 234971], [17, 235151], [24, 235851], [29, 236011], [36, 236988], [42, 237333], [45, 237573], [57, 238413], [60, 238533], [65, 238753], [69, 238973], [77, 239713], [79, 239873], [84, 240193], [87, 240633], [99, 241553], [102, 241693]]}, {"verse": 32, "start": 242332, "end": 250095, "text": "Si Dios es glorificado en él, Dios también le glorificará en sí mismo, y de inmediato le glorificará.", "words": [[0, 242332], [3, 242494], [8, 242754], [11, 242994], [23, 243794], [26, 243974], [30, 244654], [35, 244974], [43, 245454], [46, 245734], [58, 246514], [61, 246674], [64, 246814], [71, 247254], [73, 247914], [76, 248054], [86, 248854], [89, 249054]]}, {"verse": 33, "start": 250445, "end": 261270, "text": "Hijitos, aun un poco estoy con vosotros. Me buscaréis; pero, como dije a los judíos: Donde yo voy, vosotros no podéis venir; así digo a vosotros ahora.", "words": [[0, 250445], [9, 250961], [13, 251261], [16, 251501], [21, 251881], [27, 252221], [31, 252541], [41, 253485], [44, 253581], [55, 254691], [61, 255201], [66, 255341], [71, 255621], [73, 255781], [77, 255861], [85, 256799], [91, 257041], [94, 257341], [99, 257521], [108, 258233], [111, 258356], [118, 258736], [125, 259458], [129, 259778], [134, 260178], [136, 260318], [145, 260738]]}, {"verse": 34, "start": 261620, "end": 270093, "text": "Un mandamiento nuevo os doy: Que os améis unos a otros: como os he amado, que también os améis los unos a los otros.", "words": [[0, 261620], [3, 261804], [15, 262484], [21, 262884], [24, 263224], [29, 263942], [33, 264044], [36, 264164], [42, 264584], [47, 264869], [49, 265269], [56, 266125], [61, 266349], [64, 266569], [67, 266849], [74, 267289], [78, 267449], [86, 267729], [89, 267989], [95, 268309], [99, 268489], [104, 268849], [106, 269189], [110, 269369]]}, {"verse": 35, "start": 270443, "end": 276430, "text": "En esto conocerán todos que sois mis discípulos, si tenéis amor los unos con los otros.", "words": [[0, 270443], [3, 270663], [8, 270883], [18, 271563], [24, 271843], [28, 272123], [33, 272443], [37, 272643], [49, 273843], [52, 274103], [59, 274523], [64, 274843], [68, 275123], [73, 275383], [77, 275623], [81, 275823]]}, {"verse": 36, "start": 276780, "end": 286092, "text": "Le dice Simón Pedro: Señor, ¿adónde vas? Le respondió Jesús: Donde yo voy, no me puedes ahora seguir; pero me seguirás después.", "words": [[0, 276780], [3, 276921], [8, 277161], [14, 277581], [21, 278320], [28, 278943], [36, 279203], [41, 279991], [44, 280119], [54, 280699], [61, 281577], [67, 281779], [70, 282019], [75, 282599], [78, 282939], [81, 283079], [88, 283399], [94, 283779], [102, 284608], [107, 284750], [110, 284910], [119, 285370]]}, {"verse": 37, "start": 286442, "end": 291215, "text": "Le dice Pedro: Señor, ¿por qué no te puedo seguir ahora? daré mi vida por ti.", "words": [[0, 286442], [3, 286567], [8, 286807], [15, 287586], [22, 288321], [27, 288441], [31, 288561], [34, 288681], [37, 288801], [43, 289001], [50, 289301], [57, 290097], [62, 290375], [65, 290455], [70, 290675], [74, 290855]]}, {"verse": 38, "start": 291495, "end": 300916, "text": "Le respondió Jesús: ¿Darás tu vida por mí? De cierto, de cierto te digo: No cantará el gallo, sin que me hayas negado tres veces.", "words": [[0, 291495], [3, 291624], [13, 292204], [20, 293081], [27, 293506], [30, 293626], [35, 293906], [39, 294166], [43, 295001], [46, 295273], [54, 295545], [57, 295817], [64, 296089], [67, 296309], [73, 297026], [76, 297345], [84, 297699], [87, 298052], [94, 298512], [98, 298872], [102, 299072], [105, 299252], [111, 299512], [118, 299972], [123, 300192]]}]}