{"book": "LUK", "chapter": 15, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 245882, "verses": [{"verse": 1, "start": 300, "end": 6062, "text": "Y se llegaban a él todos los recaudadores de impuestos y pecadores a oírle.", "words": [[0, 300], [2, 446], [5, 566], [14, 1146], [16, 1266], [19, 1486], [25, 1946], [29, 2446], [42, 3486], [45, 3706], [55, 4366], [57, 4566], [67, 5166], [69, 5406]]}, {"verse": 2, "start": 6412, "end": 13717, "text": "Y murmuraban los fariseos y los escribas, diciendo: Este a los pecadores recibe, y con ellos come.", "words": [[0, 6412], [2, 6696], [13, 7456], [17, 7696], [26, 8476], [28, 8616], [32, 8756], [42, 9476], [52, 10558], [57, 10844], [59, 10984], [63, 11124], [73, 11584], [81, 12244], [83, 12764], [87, 12964], [93, 13164]]}, {"verse": 3, "start": 13997, "end": 17286, "text": "Y él les refirió esta parábola, diciendo:", "words": [[0, 13997], [2, 14159], [5, 14379], [9, 14679], [17, 15319], [22, 15539], [32, 16240]]}, {"verse": 4, "start": 17636, "end": 28917, "text": "¿Qué hombre de vosotros, teniendo cien ovejas, si pierde una de ellas, no deja las noventa y nueve en el desierto, y va a la que se perdió, hasta que la halle?", "words": [[0, 17636], [5, 17738], [12, 17978], [15, 18158], [25, 18858], [34, 19338], [39, 19758], [47, 20678], [50, 20798], [57, 21338], [61, 21538], [64, 21738], [71, 22438], [74, 22558], [79, 22818], [83, 23038], [91, 23618], [93, 23718], [99, 24158], [102, 24278], [105, 24398], [115, 25558], [117, 25818], [120, 26038], [122, 26478], [125, 26578], [129, 26718], [132, 26858], [140, 27774], [146, 28038], [150, 28350], [153, 28662]]}, {"verse": 5, "start": 29267, "end": 32123, "text": "Y hallada, la pone sobre sus hombros gozoso;", "words": [[0, 29267], [2, 29514], [11, 29804], [14, 29964], [19, 30364], [25, 30684], [29, 30944], [37, 31384]]}, {"verse": 6, "start": 32473, "end": 42179, "text": "Y viniendo a casa, junta a los amigos y a los vecinos, diciéndoles: Alegraos conmigo, porque he hallado mi oveja que se había perdido.", "words": [[0, 32473], [2, 32808], [11, 33288], [13, 33408], [19, 34248], [25, 34848], [27, 34988], [31, 35088], [38, 35548], [40, 35788], [42, 35828], [46, 35968], [55, 36508], [68, 38131], [77, 38669], [86, 39409], [93, 39749], [96, 39989], [104, 40369], [107, 40569], [113, 40989], [117, 41149], [120, 41289], [126, 41449]]}, {"verse": 7, "start": 42529, "end": 51737, "text": "Os digo, que así habrá más gozo en el cielo de un pecador que se arrepiente, que de noventa y nueve justos, que no necesitan arrepentimiento.", "words": [[0, 42529], [3, 42655], [9, 42975], [13, 43215], [17, 43455], [23, 43835], [27, 44015], [32, 44555], [35, 44815], [38, 44975], [44, 45295], [47, 45515], [50, 45615], [58, 46075], [62, 46215], [65, 46355], [77, 46995], [81, 47555], [84, 47675], [92, 48115], [94, 48285], [100, 48455], [108, 49155], [112, 49355], [115, 49515], [125, 50215]]}, {"verse": 8, "start": 52087, "end": 63688, "text": "¿O qué mujer que tiene diez dracmas, si pierde una dracma, no enciende la lámpara, y barre la casa, y busca con diligencia hasta encontrarla?", "words": [[0, 52087], [3, 52209], [7, 52389], [13, 52709], [17, 53009], [23, 53389], [28, 53889], [37, 55389], [40, 55629], [47, 56169], [51, 56409], [59, 57469], [62, 57709], [71, 58189], [74, 58369], [83, 58969], [85, 59429], [91, 59769], [94, 59889], [100, 60249], [102, 60829], [108, 61109], [112, 61429], [123, 62269], [129, 62529]]}, {"verse": 9, "start": 64037, "end": 73396, "text": "Y cuando la encuentra, reúne a sus amigas y vecinas, diciendo: Alegraos conmigo, porque he hallado la dracma que había perdido.", "words": [[0, 64037], [2, 64159], [9, 64379], [12, 64599], [23, 65659], [29, 66419], [31, 66519], [35, 66679], [42, 67239], [44, 67339], [53, 68079], [63, 69451], [72, 69711], [81, 70311], [88, 70691], [91, 70891], [99, 71231], [102, 71391], [109, 71771], [113, 71931], [119, 72131]]}, {"verse": 10, "start": 73676, "end": 79816, "text": "Así os digo que hay gozo delante de los ángeles de Dios por un pecador que se arrepiente.", "words": [[0, 73676], [4, 73961], [7, 74141], [12, 74381], [16, 74621], [20, 74761], [25, 75161], [33, 75721], [36, 75861], [40, 76001], [48, 76541], [51, 76721], [56, 76981], [60, 77541], [63, 77721], [71, 78401], [75, 78601], [78, 78781]]}, {"verse": 11, "start": 80166, "end": 82985, "text": "Y dijo: Un hombre tenía dos hijos;", "words": [[0, 80166], [2, 80308], [8, 81043], [11, 81230], [18, 81570], [24, 81970], [28, 82270]]}, {"verse": 12, "start": 83335, "end": 90632, "text": "Y el menor de ellos dijo a su padre: Padre, dame la parte de los bienes que me pertenece: y les repartió los bienes.", "words": [[0, 83335], [2, 83479], [5, 83599], [11, 83899], [14, 84139], [20, 84399], [25, 84879], [27, 85079], [30, 85199], [37, 86034], [44, 86414], [49, 86634], [52, 86774], [58, 87074], [61, 87274], [65, 87414], [72, 87814], [76, 87914], [79, 88014], [90, 89057], [92, 89179], [96, 89339], [105, 89859], [109, 90019]]}, {"verse": 13, "start": 90912, "end": 102541, "text": "Y no muchos días después, juntándolo todo el hijo menor, partió lejos a una provincia apartada; y allí desperdició sus bienes viviendo perdidamente.", "words": [[0, 90912], [2, 91059], [5, 91219], [12, 91519], [17, 91839], [26, 92819], [37, 93659], [42, 93979], [45, 94199], [50, 94439], [57, 95109], [64, 95769], [70, 96249], [72, 96469], [76, 96649], [86, 97529], [96, 98658], [98, 98783], [103, 99003], [115, 99843], [119, 100023], [126, 100723], [135, 101243]]}, {"verse": 14, "start": 102891, "end": 110555, "text": "Y cuando todo lo hubo malgastado, vino una gran hambruna en aquella provincia, y comenzó a pasar necesidad.", "words": [[0, 102891], [2, 102996], [9, 103216], [14, 103636], [17, 103896], [22, 104216], [34, 104956], [39, 105196], [43, 105556], [48, 105836], [57, 106616], [60, 106756], [68, 107076], [79, 107876], [81, 108516], [89, 109116], [91, 109196], [97, 109476]]}, {"verse": 15, "start": 110905, "end": 118960, "text": "Y fue y se llegó a uno de los ciudadanos de aquella tierra, el cual le envió a su hacienda para que apacentase los cerdos.", "words": [[0, 110905], [2, 111066], [6, 111226], [8, 111546], [11, 111706], [17, 112006], [19, 112286], [23, 112466], [26, 112606], [30, 112746], [41, 113706], [44, 113826], [52, 114146], [60, 115006], [63, 115126], [68, 115366], [71, 115726], [77, 116146], [79, 116266], [82, 116386], [91, 116906], [96, 117126], [100, 117306], [111, 118046], [115, 118246]]}, {"verse": 16, "start": 119310, "end": 124997, "text": "Y deseaba llenar su vientre de las algarrobas que comían los cerdos; pero nadie se las daba.", "words": [[0, 119310], [2, 119419], [10, 119819], [17, 120219], [20, 120399], [28, 120979], [31, 121346], [35, 121712], [46, 122079], [50, 122239], [57, 122619], [61, 122779], [69, 123630], [74, 123775], [80, 124075], [83, 124295], [87, 124435]]}, {"verse": 17, "start": 125347, "end": 133006, "text": "Y volviendo en sí, dijo: ¡Cuántos jornaleros en casa de mi padre tienen abundancia de pan, y yo aquí perezco de hambre!", "words": [[0, 125347], [2, 125472], [12, 125992], [15, 126212], [19, 126872], [25, 127657], [34, 128037], [45, 128577], [48, 128757], [53, 128957], [56, 129137], [59, 129257], [65, 129557], [72, 129917], [83, 130517], [86, 130677], [91, 131457], [93, 131537], [96, 131737], [101, 132097], [109, 132457], [112, 132597]]}, {"verse": 18, "start": 133356, "end": 138500, "text": "Me levantaré, e iré a mi padre, y le diré: Padre, he pecado contra el cielo, y contra ti;", "words": [[0, 133356], [3, 133443], [14, 133983], [16, 134163], [20, 134423], [22, 134463], [25, 134543], [32, 134843], [34, 135203], [37, 135283], [43, 135913], [50, 136293], [53, 136373], [60, 136793], [67, 137093], [70, 137253], [77, 137593], [79, 137773], [86, 138093]]}, {"verse": 19, "start": 138850, "end": 143936, "text": "Ya no soy digno de ser llamado tu hijo; hazme como a uno de tus jornaleros.", "words": [[0, 138850], [3, 138977], [6, 139137], [10, 139357], [16, 139797], [19, 139857], [23, 140017], [31, 140337], [34, 140617], [40, 141215], [46, 141533], [51, 141753], [53, 141893], [57, 142073], [60, 142233], [64, 142393]]}, {"verse": 20, "start": 144216, "end": 156633, "text": "Y levantándose, vino a su padre. Y como aun estuviese lejos, lo vio su padre, y fue movido a misericordia, y corrió, y se echó sobre su cuello, y le besó.", "words": [[0, 144216], [2, 144362], [16, 145282], [21, 145722], [23, 145902], [26, 146022], [33, 146903], [35, 147216], [40, 147476], [44, 147756], [54, 148316], [61, 149196], [64, 149356], [68, 149556], [71, 149696], [78, 150696], [80, 150796], [84, 150956], [91, 151436], [93, 151556], [107, 152516], [109, 152956], [117, 153496], [119, 154016], [122, 154156], [127, 154496], [133, 154796], [136, 155036], [144, 155516], [146, 155936], [149, 156056]]}, {"verse": 21, "start": 156983, "end": 163428, "text": "Y el hijo le dijo: Padre, he pecado contra el cielo, y contra ti, y ya no soy digno de ser llamado tu hijo.", "words": [[0, 156983], [2, 157168], [5, 157288], [10, 157568], [13, 157768], [19, 158573], [26, 159053], [29, 159133], [36, 159513], [43, 159813], [46, 159973], [53, 160293], [55, 160633], [62, 160933], [66, 161193], [68, 161368], [71, 161508], [74, 161608], [78, 161828], [84, 162228], [87, 162288], [91, 162468], [99, 162768], [102, 163028]]}, {"verse": 22, "start": 163708, "end": 171713, "text": "Pero el padre dijo a sus siervos: Sacad el mejor vestido, y vestidle; y poned un anillo en su mano, y zapatos en sus pies.", "words": [[0, 163708], [5, 163872], [8, 164032], [14, 164472], [19, 164812], [21, 164992], [25, 165092], [34, 166091], [40, 166446], [43, 166586], [49, 166886], [58, 167506], [60, 167666], [70, 168603], [72, 168762], [78, 168962], [81, 169202], [88, 169522], [91, 169642], [94, 169802], [100, 170062], [102, 170342], [110, 170862], [113, 171022], [117, 171162]]}, {"verse": 23, "start": 172063, "end": 176323, "text": "Y traed el becerro engordado, y matadlo, y comamos, y hagamos fiesta:", "words": [[0, 172063], [2, 172220], [8, 172414], [11, 172607], [19, 173127], [30, 173727], [32, 173907], [41, 174427], [43, 174627], [52, 175107], [54, 175387], [62, 175727]]}, {"verse": 24, "start": 176673, "end": 184238, "text": "Porque este mi hijo muerto era, y ha revivido; se había perdido, y es hallado. Y comenzaron a regocijarse.", "words": [[0, 176673], [7, 176872], [12, 177132], [15, 177352], [20, 177572], [27, 177972], [32, 178292], [34, 178692], [37, 178812], [47, 179685], [50, 179867], [56, 180067], [65, 180787], [67, 181007], [70, 181207], [79, 182021], [81, 182126], [92, 182806], [94, 183066]]}, {"verse": 25, "start": 184588, "end": 192832, "text": "Y su hijo el mayor estaba en el campo; el cual cuando vino, y llegó cerca de casa, oyó la música y las danzas;", "words": [[0, 184588], [2, 184716], [5, 184876], [10, 185216], [13, 185416], [19, 185796], [26, 186236], [29, 186476], [32, 186596], [39, 187489], [42, 187654], [47, 187934], [54, 188234], [60, 188694], [62, 188969], [68, 189229], [74, 189569], [77, 189829], [83, 190489], [87, 190949], [90, 191089], [97, 191589], [99, 191869], [103, 192049]]}, {"verse": 26, "start": 193182, "end": 197674, "text": "Y llamando a uno de los criados, le preguntó qué era aquello.", "words": [[0, 193182], [2, 193286], [11, 193866], [13, 194146], [17, 194366], [20, 194526], [24, 194666], [33, 195546], [36, 195846], [45, 196486], [49, 196746], [53, 197026]]}, {"verse": 27, "start": 198024, "end": 204709, "text": "Y él le dijo: Tu hermano ha venido; y tu padre ha matado el becerro engordado, por haberle recibido salvo.", "words": [[0, 198024], [2, 198213], [5, 198373], [8, 198533], [14, 199324], [17, 199401], [25, 199821], [28, 199921], [36, 200674], [38, 200776], [41, 200896], [47, 201156], [50, 201316], [57, 201696], [60, 201816], [68, 202236], [79, 202816], [83, 203276], [91, 203656], [100, 204156]]}, {"verse": 28, "start": 204989, "end": 212294, "text": "Entonces se enojó, y no quería entrar. Salió por tanto su padre, y le rogaba que entrase.", "words": [[0, 204989], [9, 205571], [12, 206171], [19, 206751], [21, 206891], [24, 207011], [31, 207311], [39, 208362], [45, 208743], [49, 208923], [55, 209203], [58, 209503], [65, 209923], [67, 210483], [70, 210893], [77, 211303], [81, 211523]]}, {"verse": 29, "start": 212644, "end": 224315, "text": "Pero él respondiendo, dijo al padre: He aquí tantos años te sirvo, no habiendo traspasado jamás tu mandamiento, y nunca me has dado un cabrito para gozarme con mis amigos:", "words": [[0, 212644], [5, 212808], [8, 213228], [22, 214268], [27, 214608], [30, 214848], [37, 216429], [40, 216590], [45, 216830], [52, 217330], [57, 217550], [60, 217770], [67, 218590], [70, 218770], [79, 219110], [90, 219770], [96, 220210], [99, 220330], [112, 221030], [114, 221275], [120, 221535], [123, 221795], [127, 221915], [132, 222095], [135, 222275], [143, 222695], [148, 222935], [156, 223495], [160, 223635], [164, 223835]]}, {"verse": 30, "start": 224665, "end": 231132, "text": "Pero cuando vino este tu hijo, que ha consumido tus bienes con rameras, has matado para él el becerro engordado.", "words": [[0, 224665], [5, 224802], [12, 225022], [17, 225342], [22, 225602], [25, 225822], [31, 226362], [35, 226562], [38, 226682], [48, 227242], [52, 227402], [59, 227822], [63, 227982], [72, 228822], [76, 229002], [83, 229442], [88, 229642], [91, 229862], [94, 229962], [102, 230462]]}, {"verse": 31, "start": 231412, "end": 237730, "text": "Él entonces le dijo: Hijo, tú siempre estás conmigo, y todas mis cosas son tuyas.", "words": [[0, 231412], [3, 231682], [12, 232282], [15, 232622], [21, 233370], [27, 234136], [30, 234256], [38, 234636], [44, 234936], [53, 235576], [55, 235976], [61, 236156], [65, 236416], [71, 236716], [75, 237036]]}, {"verse": 32, "start": 237950, "end": 245482, "text": "Pero era necesario celebrar y alegrarnos, porque este hermano tuyo estaba muerto y ha vuelto a vivir; estaba perdido y ha sido hallado.", "words": [[0, 237950], [5, 238090], [9, 238310], [19, 238830], [28, 239430], [30, 239510], [42, 240350], [49, 240690], [54, 240950], [62, 241350], [67, 241570], [74, 241790], [81, 242350], [83, 242490], [86, 242570], [93, 242850], [95, 242910], [102, 243532], [109, 243811], [117, 244391], [119, 244591], [122, 244711], [127, 244871]]}]}