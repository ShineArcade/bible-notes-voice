7490], [60, 67790], [66, 68070], [69, 68370], [74, 68590], [83, 69410], [85, 69830], [87, 69930], [90, 70090], [95, 70430]]}, {"verse": 11, "start": 71759, "end": 76812, "text": "El diablo entonces le dejó: y he aquí los ángeles llegaron y le servían.", "words": [[0, 71759], [3, 72023], [10, 72423], [19, 72803], [22, 73103], [28, 73802], [30, 73982], [33, 74162], [38, 74442], [42, 74842], [50, 75422], [59, 75962], [61, 76112], [64, 76262]]}, {"verse": 12, "start": 77162, "end": 82737, "text": "Pero oyendo Jesús que Juan había sido encarcelado, se volvió a Galilea;", "words": [[0, 77162], [5, 77323], [12, 77843], [18, 78203], [22, 78523], [27, 78983], [33, 79343], [38, 79783], [51, 81123], [54, 81363], [61, 81843], [63, 81963]]}, {"verse": 13, "start": 83087, "end": 91758, "text": "Y dejando a Nazaret, vino y habitó en Capernaum, ciudad junto al mar, en los confines de Zabulón y de Neftalí:", "words": [[0, 83087], [2, 83185], [10, 83625], [12, 83745], [21, 84285], [26, 85225], [28, 85525], [35, 85925], [38, 86505], [49, 87085], [56, 87665], [62, 87985], [65, 88265], [70, 89105], [73, 89205], [77, 89325], [86, 89845], [89, 90235], [97, 90625], [99, 90845], [102, 90925]]}, {"verse": 14, "start": 92108, "end": 97147, "text": "Para que se cumpliese lo que fue dicho por el profeta Isaías, que dijo:", "words": [[0, 92108], [5, 92272], [9, 92432], [12, 92862], [22, 93292], [25, 93532], [29, 93672], [33, 93872], [39, 94172], [43, 94472], [46, 94612], [54, 95292], [62, 96432], [66, 96592]]}, {"verse": 15, "start": 97497, "end": 106678, "text": "La tierra de Zabulón, y la tierra de Neftalí, camino del mar, del otro lado del Jordán, Galilea de los Gentiles;", "words": [[0, 97497], [3, 97671], [10, 98031], [13, 98491], [22, 98951], [24, 99611], [27, 99731], [34, 100071], [37, 100311], [46, 101171], [53, 101411], [57, 101731], [62, 102531], [66, 102651], [71, 102971], [76, 103291], [80, 103591], [88, 104731], [96, 105311], [99, 105431], [103, 105571]]}, {"verse": 16, "start": 107028, "end": 116988, "text": "El pueblo asentado en tinieblas, vio gran luz; y a los sentados en región y sombra de muerte, una luz les resplandeció.", "words": [[0, 107028], [3, 107156], [10, 107456], [19, 108216], [22, 108336], [33, 109016], [37, 109636], [42, 110096], [47, 110473], [49, 110642], [51, 110742], [55, 110882], [64, 111702], [67, 111942], [74, 112382], [76, 112682], [83, 113202], [86, 113342], [94, 114242], [98, 114602], [102, 115102], [106, 115582]]}, {"verse": 17, "start": 117338, "end": 126000, "text": "Desde entonces comenzó Jesús a predicar, y a decir: Arrepentíos, que el reino de los cielos se ha acercado.", "words": [[0, 117338], [6, 117664], [15, 118304], [23, 119104], [29, 119364], [31, 119644], [41, 120284], [43, 120764], [45, 120884], [52, 121617], [65, 122657], [69, 123057], [72, 123217], [78, 123577], [81, 123697], [85, 123877], [92, 124657], [95, 124977], [98, 125137]]}, {"verse": 18, "start": 126350, "end": 138824, "text": "Y andando Jesús junto al mar de Galilea, vio a dos hermanos, Simón, que es llamado Pedro, y Andrés su hermano, que echaban la red en el mar; porque eran pescadores.", "words": [[0, 126350], [2, 126475], [10, 126895], [16, 127315], [22, 127695], [25, 127995], [29, 128195], [32, 128355], [41, 129255], [45, 129635], [47, 129835], [51, 130015], [61, 130875], [68, 131815], [72, 131905], [75, 131995], [83, 132335], [90, 132815], [92, 133070], [99, 133810], [102, 134010], [111, 134930], [115, 135030], [123, 135510], [126, 135730], [130, 136010], [133, 136430], [136, 136610], [141, 137326], [148, 137552], [153, 137772]]}, {"verse": 19, "start": 139174, "end": 144227, "text": "Y les dice: Venid en pos de mí, y os haré pescadores de hombres.", "words": [[0, 139174], [2, 139354], [6, 139474], [12, 140308], [18, 140734], [21, 140934], [25, 141134], [28, 141334], [32, 141574], [34, 141954], [37, 142334], [42, 142714], [53, 143234], [56, 143494]]}, {"verse": 20, "start": 144577, "end": 149197, "text": "Ellos entonces, dejando luego