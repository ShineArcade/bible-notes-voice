{"book": "PSA", "chapter": 104, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 213956, "verses": [{"verse": 1, "start": 300, "end": 9464, "text": "Bendice, alma mía, a Jehová. Jehová, Dios mío, mucho te has engrandecido; te has vestido de gloria y de magnificencia.", "words": [[0, 300], [9, 885], [14, 1205], [19, 1825], [21, 2085], [29, 2862], [37, 3262], [42, 3422], [47, 4182], [53, 4642], [56, 5164], [60, 5684], [74, 6369], [77, 6473], [81, 6573], [89, 7193], [92, 7333], [99, 7893], [101, 8093], [104, 8213]]}, {"verse": 2, "start": 9814, "end": 15724, "text": "El que se cubre de luz como de vestidura, que extiende los cielos como una cortina;", "words": [[0, 9814], [3, 9982], [7, 10122], [10, 10282], [16, 10742], [19, 10902], [23, 11082], [28, 11442], [31, 11622], [42, 12342], [46, 12902], [55, 13562], [59, 13742], [66, 14322], [71, 14542], [75, 14782]]}, {"verse": 3, "start": 16074, "end": 24282, "text": "Que establece sus aposentos entre las aguas; el que pone las nubes por su carroza, el que anda sobre las alas del viento;", "words": [[0, 16074], [4, 16175], [14, 16655], [18, 16795], [28, 17575], [34, 17795], [38, 18055], [45, 18939], [48, 19066], [52, 19206], [57, 19526], [61, 19746], [67, 20146], [71, 20366], [74, 21006], [83, 21646], [86, 21986], [90, 22166], [95, 22446], [101, 22826], [105, 23066], [110, 23406], [114, 23586]]}, {"verse": 4, "start": 24632, "end": 29645, "text": "El que hace a sus ángeles espíritus, sus ministros al fuego flameante.", "words": [[0, 24632], [3, 24757], [7, 24917], [12, 25217], [14, 25397], [18, 25497], [26, 26077], [37, 27197], [41, 27377], [51, 28077], [54, 28257], [60, 28557]]}, {"verse": 5, "start": 29995, "end": 34608, "text": "Él fundó la tierra sobre sus bases; no será jamás removida.", "words": [[0, 29995], [3, 30160], [9, 30620], [12, 30740], [19, 31100], [25, 31460], [29, 31700], [36, 32653], [39, 32923], [44, 33163], [50, 33895]]}, {"verse": 6, "start": 34958, "end": 39994, "text": "Con el abismo, como con vestido, la cubriste; sobre los montes estaban las aguas.", "words": [[0, 34958], [4, 35082], [7, 35222], [15, 35622], [20, 35902], [24, 36102], [33, 36682], [36, 36802], [46, 37781], [52, 38045], [56, 38265], [63, 38705], [71, 39065], [75, 39345]]}, {"verse": 7, "start": 40344, "end": 46198, "text": "A tu reprensión huyeron; al sonido de tu trueno se apresuraron;", "words": [[0, 40344], [2, 40656], [5, 40776], [16, 41576], [25, 42751], [28, 43130], [35, 43870], [38, 44050], [41, 44250], [48, 44710], [51, 45466]]}, {"verse": 8, "start": 46548, "end": 51411, "text": "Subieron los montes, descendieron los valles, al lugar que tú les fundaste.", "words": [[0, 46548], [9, 47006], [13, 47186], [21, 48126], [34, 48846], [38, 49066], [46, 49546], [49, 49926], [55, 50266], [59, 50486], [62, 50666], [66, 50846]]}, {"verse": 9, "start": 51761, "end": 57368, "text": "Les pusiste un límite, el cual no traspasarán; ni volverán a cubrir la tierra.", "words": [[0, 51761], [4, 52304], [12, 52784], [15, 52924], [23, 53504], [26, 53964], [31, 54124], [34, 54324], [47, 55658], [50, 55728], [59, 56308], [61, 56408], [68, 56788], [71, 56948]]}, {"verse": 10, "start": 57718, "end": 62454, "text": "Tú eres el que envías las fuentes por los arroyos; van entre los montes.", "words": [[0, 57718], [3, 57860], [8, 58120], [11, 58320], [15, 58480], [22, 58813], [26, 59147], [34, 59480], [38, 59720], [42, 59900], [51, 60908], [55, 61107], [61, 61407], [65, 61607]]}, {"verse": 11, "start": 62804, "end": 68635, "text": "Dan de beber a todas las bestias del campo: quebrantan su sed los asnos montaraces.", "words": [[0, 62804], [4, 63014], [7, 63174], [13, 63454], [15, 63634], [21, 63854], [25, 64134], [33, 64534], [37, 64654], [44, 65853], [55, 66163], [58, 66403], [62, 66763], [66, 67143], [72, 67603]]}, {"verse": 12, "start": 68985, "end": 74679, "text": "Junto a aquellos habitarán las aves de los cielos; entre las ramas dan voces.", "words": [[0, 68985], [6, 69246], [8, 69466], [17, 69766], [27, 70606], [31, 70786], [36, 71206], [39, 71346], [43, 71486], [51, 72565], [57, 72966], [61, 73206], [67, 73686], [71, 74183]]}, {"verse": 13, "start": 75029, "end": 81447, "text": "El que riega los montes desde sus aposentos: del fruto de sus obras se sacia la tierra.", "words": [[0, 75029], [3, 75175], [7, 75315], [13, 75755], [17, 75915], [24, 76455], [30, 76715], [34, 77015], [45, 78142], [49, 78482], [55, 78942], [58, 79082], [62, 79242], [68, 79682], [71, 80142], [77, 80622], [80, 80762]]}, {"verse": 14, "start": 81797, "end": 89434, "text": "El que hace producir el heno para las bestias, y la hierba para el servicio del hombre; sacando el pan de la tierra.", "words": [[0, 81797], [3, 81925], [7, 82085], [12, 82365], [21, 83045], [24, 83355], [29, 83665], [34, 83885], [38, 84065], [47, 84685], [49, 85105], [52, 85225], [59, 85745], [64, 86025], [67, 86185], [76, 86610], [80, 87035], [88, 87612], [96, 88054], [99, 88194], [103, 88514], [106, 88694], [109, 88794]]}, {"verse": 15, "start": 89784, "end": 99209, "text": "Y el vino que alegra el corazón del hombre, y el aceite que hace lucir el rostro, y el pan que sustenta el corazón del hombre.", "words": [[0, 89784], [2, 89927], [5, 90087], [10, 90387], [14, 90647], [21, 91087], [24, 91207], [32, 91607], [36, 91907], [44, 92887], [46, 93247], [49, 93407], [56, 93787], [60, 94127], [65, 94387], [71, 94927], [74, 95067], [82, 95847], [84, 96027], [87, 96187], [91, 96567], [95, 97067], [104, 97827], [107, 97967], [115, 98367], [119, 98707]]}, {"verse": 16, "start": 99559, "end": 104619, "text": "Se llenan de jugo los árboles de Jehová, los cedros del Líbano que él plantó.", "words": [[0, 99559], [3, 99722], [10, 100062], [13, 100242], [18, 100682], [22, 100842], [30, 101382], [33, 101522], [41, 102322], [45, 102402], [52, 102842], [56, 103022], [63, 103522], [67, 103742], [70, 103882]]}, {"verse": 17, "start": 104969, "end": 109517, "text": "Allí anidan las aves; en las hayas hace su casa la cigüeña.", "words": [[0, 104969], [5, 105307], [12, 105667], [16, 105907], [22, 106790], [25, 106956], [29, 107306], [35, 107656], [40, 107956], [43, 108196], [48, 108496], [51, 108716]]}, {"verse": 18, "start": 109867, "end": 115132, "text": "Los montes altos para las cabras monteses; las peñas, madrigueras para los conejos.", "words": [[0, 109867], [4, 110077], [11, 110557], [17, 111017], [22, 111197], [26, 111417], [33, 111837], [43, 112953], [47, 113084], [54, 113444], [66, 114084], [71, 114264], [75, 114404]]}, {"verse": 19, "start": 115482, "end": 119374, "text": "Hizo la luna para los tiempos: el sol conoce su ocaso.", "words": [[0, 115482], [5, 115864], [8, 116044], [13, 116344], [18, 116504], [22, 116664], [31, 117625], [34, 117725], [38, 117925], [45, 118505], [48, 118705]]}, {"verse": 20, "start": 119724, "end": 124805, "text": "Pone las tinieblas, y es la noche: en ella corretean todas las bestias de la selva.", "words": [[0, 119724], [5, 119950], [9, 120130], [20, 120770], [22, 120910], [25, 120990], [28, 121130], [35, 121860], [38, 122025], [43, 122525], [53, 123125], [59, 123365], [63, 123665], [71, 124045], [74, 124165], [77, 124265]]}, {"verse": 21, "start": 125155, "end": 128941, "text": "Los leoncillos rugen a la presa, y para buscar de Dios su comida.", "words": [[0, 125155], [4, 125304], [15, 126104], [21, 126424], [23, 126584], [26, 126664], [33, 127044], [35, 127124], [40, 127304], [47, 127624], [50, 127884], [55, 128104], [58, 128304]]}, {"verse": 22, "start": 129291, "end": 133007, "text": "Sale el sol, se recogen, y se echan en sus cuevas.", "words": [[0, 129291], [5, 129594], [8, 129854], [13, 130094], [16, 130314], [25, 130994], [27, 131514], [30, 131654], [36, 131914], [39, 132094], [43, 132274]]}, {"verse": 23, "start": 133357, "end": 137221, "text": "Sale el hombre a su labor, y a su labranza hasta la tarde.", "words": [[0, 133357], [5, 133703], [8, 134043], [15, 134343], [17, 134503], [20, 134623], [27, 135043], [29, 135258], [31, 135338], [34, 135458], [43, 136178], [49, 136463], [52, 136623]]}, {"verse": 24, "start": 137571, "end": 145858, "text": "¡Cuán muchas son tus obras, oh Jehová! Hiciste todas ellas con sabiduría: la tierra está llena de tus beneficios.", "words": [[0, 137571], [6, 137778], [13, 138118], [17, 138398], [21, 138578], [28, 139040], [31, 139503], [39, 140185], [47, 140742], [53, 141042], [59, 141442], [63, 142140], [74, 142998], [77, 143188], [84, 143548], [89, 143988], [95, 144428], [98, 144568], [102, 144768]]}, {"verse": 25, "start": 146208, "end": 154321, "text": "Asimismo esta gran mar y ancha de términos: en ella pescados sin número, animales pequeños y grandes.", "words": [[0, 146208], [9, 146932], [14, 147312], [19, 147752], [23, 148172], [25, 148432], [31, 148772], [34, 148912], [44, 149944], [47, 150112], [52, 150492], [61, 150872], [65, 151192], [73, 151772], [82, 152552], [91, 153432], [93, 153532]]}, {"verse": 26, "start": 154671, "end": 160922, "text": "Allí andan navíos; allí este leviathán que hiciste para que jugase en ella.", "words": [[0, 154671], [5, 155021], [11, 155641], [19, 156700], [24, 157092], [29, 157802], [39, 158512], [43, 158712], [51, 159312], [56, 159572], [60, 159752], [67, 160332], [70, 160552]]}, {"verse": 27, "start": 161272, "end": 166032, "text": "Todos ellos esperan en ti, para que les des su comida a su tiempo.", "words": [[0, 161272], [6, 161474], [12, 161814], [20, 162454], [23, 162614], [27, 162874], [32, 163634], [36, 163774], [40, 163914], [44, 164174], [47, 164614], [54, 164974], [56, 165294], [59, 165394]]}, {"verse": 28, "start": 166382, "end": 170386, "text": "Les das, recogen; abres tu mano, se hartan de bien.", "words": [[0, 166382], [4, 166491], [9, 167091], [18, 168095], [24, 168562], [27, 168742], [33, 169182], [36, 169322], [43, 169782], [46, 169902]]}, {"verse": 29, "start": 170386, "end": 177741, "text": "Escondes tu rostro, se turban: les quitas el espíritu, dejan de ser, y se convierten en su polvo.", "words": [[0, 170386], [9, 171066], [12, 171226], [20, 171706], [23, 171846], [31, 172814], [35, 172934], [42, 173394], [45, 173534], [55, 174634], [61, 175114], [64, 175294], [69, 175614], [71, 175779], [74, 175939], [85, 176599], [88, 176979], [91, 177139]]}, {"verse": 30, "start": 178091, "end": 182821, "text": "Envías tu espíritu, son creados: y renuevas la faz de la tierra.", "words": [[0, 178091], [7, 178496], [10, 178636], [20, 179176], [24, 179256], [33, 180278], [35, 180414], [44, 181134], [47, 181474], [51, 181774], [54, 182054], [57, 182174]]}, {"verse": 31, "start": 183171, "end": 187657, "text": "Sea la gloria de Jehová para siempre; alégrese Jehová en sus obras;", "words": [[0, 183171], [4, 183335], [7, 183595], [14, 183855], [17, 184165], [24, 184475], [29, 184635], [38, 185539], [47, 186030], [54, 186550], [57, 186690], [61, 186830]]}, {"verse": 32, "start": 188007, "end": 193285, "text": "El cual mira a la tierra, y ella tiembla; toca los montes, y humean.", "words": [[0, 188007], [3, 188174], [8, 188374], [13, 188714], [15, 188934], [18, 189014], [26, 189514], [28, 190054], [33, 190274], [42, 191192], [47, 191374], [51, 191574], [59, 192254], [61, 192574]]}, {"verse": 33, "start": 193635, "end": 198636, "text": "A Jehová cantaré en mi vida: a mi Dios cantaré salmos mientras viva.", "words": [[0, 193635], [2, 193772], [9, 194172], [17, 194652], [20, 194912], [23, 195092], [29, 195595], [31, 195795], [34, 195935], [39, 196175], [47, 196675], [54, 197335], [63, 197775]]}, {"verse": 34, "start": 198986, "end": 203947, "text": "Dulce será mi meditación en él: yo me alegraré en Jehová.", "words": [[0, 198986], [6, 199596], [11, 199916], [14, 200156], [25, 200996], [28, 201256], [32, 201959], [35, 202079], [38, 202259], [47, 202959], [50, 203472]]}, {"verse": 35, "start": 204297, "end": 213556, "text": "Sean consumidos de la tierra los pecadores, y los impíos dejen de ser. Bendice, alma mía, a Jehová. Aleluya.", "words": [[0, 204297], [5, 204555], [16, 205395], [19, 205535], [22, 205635], [29, 206115], [33, 206215], [44, 206835], [46, 207170], [50, 207330], [57, 208170], [63, 208810], [66, 208990], [71, 210012], [80, 210317], [85, 210777], [90, 211377], [92, 211677], [100, 213098]]}]}