{"book": "GEN", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 218350, "verses": [{"verse": 1, "start": 300, "end": 8413, "text": "Y Jehová dijo a Noé: Entra tú y toda tu casa en el arca; porque a ti he visto justo delante de mí en esta generación.", "words": [[0, 454], [2, 648], [9, 841], [14, 1061], [16, 1281], [21, 1832], [27, 2192], [30, 2492], [32, 2772], [37, 2992], [40, 3212], [45, 3452], [48, 3652], [51, 3752], [57, 4712], [64, 4917], [66, 5077], [69, 5237], [72, 5357], [78, 5637], [84, 5977], [92, 6557], [95, 6697], [98, 6897], [101, 7157], [106, 7377]]}, {"verse": 2, "start": 8763, "end": 17869, "text": "De todo animal limpio te tomarás siete parejas, macho y hembra; mas de los animales que no son limpios, una pareja, macho y hembra.", "words": [[0, 8763], [3, 8902], [8, 9062], [15, 9342], [22, 9922], [25, 10162], [33, 10402], [39, 10662], [48, 11542], [54, 11922], [56, 12062], [64, 12985], [68, 13229], [71, 13409], [75, 13529], [84, 14009], [88, 14309], [91, 14469], [95, 14669], [104, 15509], [108, 15669], [116, 16489], [122, 16969], [124, 17129]]}, {"verse": 3, "start": 18219, "end": 26287, "text": "También de las aves de los cielos de siete en siete, macho y hembra; para guardar en vida la casta sobre la faz de toda la tierra.", "words": [[0, 18219], [8, 18519], [11, 18699], [15, 18819], [20, 19179], [23, 19319], [27, 19459], [34, 19919], [37, 20139], [43, 20359], [46, 20799], [53, 21239], [59, 21679], [61, 21819], [69, 22758], [74, 22926], [82, 23386], [85, 23486], [90, 23686], [93, 23866], [99, 24406], [105, 24646], [108, 24826], [112, 25046], [115, 25246], [120, 25406], [123, 25626]]}, {"verse": 4, "start": 26637, "end": 36590, "text": "Porque pasados aún siete días, yo haré llover sobre la tierra cuarenta días y cuarenta noches; y borraré toda sustancia que hice de sobre la faz de la tierra.", "words": [[0, 26637], [7, 26800], [15, 27300], [19, 27560], [25, 27840], [31, 28560], [34, 28920], [39, 29180], [46, 29500], [52, 29700], [55, 29880], [62, 30200], [71, 30760], [76, 31040], [78, 31280], [87, 31760], [95, 32543], [97, 32647], [105, 33107], [110, 33267], [120, 34047], [124, 34267], [129, 34527], [132, 34707], [138, 34967], [141, 35147], [145, 35447], [148, 35667], [151, 35767]]}, {"verse": 5, "start": 36870, "end": 40134, "text": "E hizo Noé conforme a todo lo que le mandó Jehová.", "words": [[0, 36870], [2, 37151], [7, 37465], [11, 37778], [20, 38458], [22, 38538], [27, 38738], [30, 38978], [34, 39078], [37, 39178], [43, 39598]]}, {"verse": 6, "start": 40484, "end": 46105, "text": "Y siendo Noé de seiscientos años, el diluvio de las aguas fue sobre la tierra.", "words": [[0, 40484], [2, 40807], [9, 41117], [13, 41427], [16, 41757], [28, 42087], [34, 43307], [37, 43507], [45, 44007], [48, 44127], [52, 44307], [58, 44727], [62, 44887], [68, 45267], [71, 45487]]}, {"verse": 7, "start": 46455, "end": 54369, "text": "Y vino Noé, y sus hijos, y su mujer, y las mujeres de sus hijos con él al arca, por las aguas del diluvio.", "words": [[0, 46455], [2, 46573], [7, 46853], [12, 47393], [14, 47633], [18, 47833], [25, 48833], [27, 48933], [30, 49073], [37, 49493], [39, 49933], [43, 50093], [51, 50453], [54, 50693], [58, 50873], [64, 51213], [68, 51513], [71, 51806], [74, 52100], [80, 52393], [84, 52913], [88, 53133], [94, 53513], [98, 53653]]}, {"verse": 8, "start": 54719, "end": 63772, "text": "De los animales limpios, y de los animales que no eran limpios, y de las aves, y de todo lo que anda arrastrando sobre la tierra,", "words": [[0, 54719], [3, 54844], [7, 54964], [16, 55384], [25, 56304], [27, 56924], [30, 57044], [34, 57164], [43, 57644], [47, 57904], [50, 58104], [55, 58344], [64, 59064], [66, 59184], [69, 59304], [73, 59484], [79, 59924], [81, 60364], [84, 60524], [89, 60824], [92, 61104], [96, 61264], [101, 61544], [113, 62604], [119, 62884], [122, 63104]]}, {"verse": 9, "start": 64122, "end": 70607, "text": "De dos en dos entraron a Noé en el arca: macho y hembra, como mandó Dios a Noé.", "words": [[0, 64122], [3, 64258], [7, 64458], [10, 64638], [14, 64838], [23, 65518], [25, 65638], [29, 65958], [32, 66178], [35, 66338], [41, 67158], [47, 67805], [49, 67985], [57, 68945], [62, 69145], [68, 69605], [73, 69765], [75, 70145]]}, {"verse": 10, "start": 70957, "end": 76369, "text": "Y sucedió que al séptimo día las aguas del diluvio fueron sobre la tierra.", "words": [[0, 70957], [2, 71078], [10, 71658], [14, 71878], [17, 72058], [25, 72678], [29, 73018], [33, 73538], [39, 74078], [43, 74258], [51, 74778], [58, 75078], [64, 75458], [67, 75678]]}, {"verse": 11, "start": 76719, "end": 90379, "text": "El año seiscientos de la vida de Noé, en el mes segundo, a diecisiete días del mes, aquel día fueron rotas todas las fuentes del grande abismo, y las cataratas de los cielos fueron abiertas;", "words": [[0, 76719], [3, 76867], [7, 77217], [19, 77567], [22, 78047], [25, 78147], [30, 78387], [33, 78587], [38, 79247], [41, 79647], [44, 79767], [48, 79927], [57, 81107], [59, 81477], [70, 81847], [75, 82247], [79, 82487], [84, 83327], [90, 83647], [94, 83827], [101, 84167], [107, 84827], [113, 85327], [117, 85747], [125, 86167], [129, 86387], [136, 86687], [144, 87571], [146, 87678], [150, 87798], [160, 88538], [163, 88618], [167, 88968], [174, 89318], [181, 89518]]}, {"verse": 12, "start": 90729, "end": 94549, "text": "Y hubo lluvia sobre la tierra cuarenta días y cuarenta noches.", "words": [[0, 90729], [2, 90998], [7, 91318], [14, 91638], [20, 91838], [23, 92058], [30, 92318], [39, 92998], [44, 93218], [46, 93438], [55, 93938]]}, {"verse": 13, "start": 94899, "end": 105780, "text": "En este mismo día entraron Noé, y Sem y Cam y Jafet, hijos de Noé, la mujer de Noé, y las tres mujeres de sus hijos con él en el arca;", "words": [[0, 94899], [3, 95066], [8, 95266], [14, 95566], [18, 95866], [27, 96648], [32, 97069], [34, 97490], [38, 97911], [40, 98131], [44, 99011], [46, 99111], [53, 100031], [59, 100271], [62, 100491], [67, 101038], [70, 101218], [76, 101578], [79, 101778], [84, 102473], [86, 102733], [90, 102913], [95, 103133], [103, 103633], [106, 103833], [110, 104013], [116, 104353], [120, 104673], [123, 104873], [126, 105033], [129, 105173]]}, {"verse": 14, "start": 106130, "end": 125000, "text": "Ellos, y todos los animales silvestres según sus especies, y todos los animales mansos según sus especies, y todo reptil que anda arrastrando sobre la tierra según su especie, y toda ave según su especie, todo pájaro, toda especie de volátil.", "words": [[0, 106130], [7, 106518], [9, 106818], [15, 107198], [19, 107618], [28, 108058], [39, 109218], [45, 109478], [49, 109818], [59, 110838], [61, 110918], [67, 111258], [71, 111498], [80, 111898], [87, 112878], [93, 113198], [97, 113598], [107, 114603], [109, 114683], [114, 114963], [121, 115985], [125, 116088], [130, 116388], [142, 117308], [148, 117588], [151, 117808], [158, 118148], [164, 118508], [167, 118788], [176, 119673], [178, 119810], [183, 120050], [187, 120550], [193, 120910], [196, 121190], [205, 122350], [210, 122510], [218, 123395], [223, 123575], [231, 124015], [234, 124235]]}, {"verse": 15, "start": 125350, "end": 132007, "text": "Y vinieron a Noé al arca, de dos en dos de toda carne en que había espíritu de vida.", "words": [[0, 125350], [2, 125458], [11, 125958], [13, 126278], [17, 126805], [20, 127331], [26, 127858], [29, 127958], [33, 128258], [36, 128578], [40, 128918], [43, 129338], [48, 129558], [54, 129778], [57, 129998], [61, 130258], [67, 130518], [76, 131398], [79, 131518]]}, {"verse": 16, "start": 132357, "end": 141310, "text": "Y los que vinieron, macho y hembra de toda carne vinieron, como le había mandado Dios: y Jehová le cerró la puerta.", "words": [[0, 132357], [2, 132485], [6, 132625], [10, 132765], [20, 133385], [26, 134270], [28, 134570], [35, 135190], [38, 135350], [43, 135570], [49, 136170], [59, 136830], [64, 137510], [67, 137710], [73, 137990], [81, 138470], [87, 139301], [89, 139466], [96, 140046], [99, 140346], [105, 140806], [108, 140946]]}, {"verse": 17, "start": 141660, "end": 150731, "text": "Y fue el diluvio cuarenta días sobre la tierra; y las aguas crecieron, y alzaron el arca, y se elevó sobre la tierra.", "words": [[0, 141660], [2, 142227], [6, 142407], [9, 142547], [17, 142937], [26, 143327], [31, 143907], [37, 144307], [40, 144507], [48, 145389], [50, 145510], [54, 145670], [60, 146230], [71, 147050], [73, 147370], [81, 147910], [84, 148090], [90, 148490], [92, 148950], [95, 149090], [101, 149570], [107, 149870], [110, 150090]]}, {"verse": 18, "start": 151081, "end": 159933, "text": "Y prevalecieron las aguas, y crecieron en gran manera sobre la tierra; y andaba el arca sobre la faz de las aguas.", "words": [[0, 151081], [2, 151189], [16, 151969], [20, 152149], [27, 152749], [29, 153409], [39, 154129], [42, 154569], [47, 154809], [54, 155329], [60, 155689], [63, 155909], [71, 156793], [73, 156933], [80, 157393], [83, 157613], [88, 157993], [94, 158313], [97, 158513], [101, 158873], [104, 159133], [108, 159293]]}, {"verse": 19, "start": 160283, "end": 170328, "text": "Y las aguas prevalecieron mucho en extremo sobre la tierra; y todos los montes altos que había debajo de todos los cielos, fueron cubiertos.", "words": [[0, 160283], [2, 160389], [6, 160529], [12, 160969], [26, 161749], [32, 162209], [35, 162409], [43, 163069], [49, 163309], [52, 163489], [60, 164339], [62, 164446], [68, 164786], [72, 165226], [79, 165886], [85, 166546], [89, 166706], [95, 166926], [102, 167386], [105, 167566], [111, 167806], [115, 168246], [123, 168966], [130, 169326]]}, {"verse": 20, "start": 170678, "end": 176297, "text": "Quince codos en alto prevalecieron las aguas; y fueron cubiertos los montes.", "words": [[0, 170861], [7, 171081], [13, 171721], [16, 171881], [21, 172201], [35, 173201], [39, 173401], [46, 174340], [48, 174430], [55, 174670], [65, 175370], [69, 175490]]}, {"verse": 21, "start": 176647, "end": 188868, "text": "Y murió toda carne que se mueve sobre la tierra, así de aves como de ganados, y de bestias, y de todo reptil que anda arrastrando sobre la tierra, y todo hombre:", "words": [[0, 176647], [2, 176772], [8, 177152], [13, 177332], [19, 177792], [23, 177972], [26, 178152], [32, 178592], [38, 178832], [41, 179052], [49, 179952], [53, 180272], [56, 180472], [61, 180832], [66, 181112], [69, 181272], [78, 182372], [80, 182412], [83, 182552], [92, 183532], [94, 183572], [97, 183712], [102, 183912], [109, 185032], [113, 185212], [118, 185472], [130, 186412], [136, 186672], [139, 186872], [147, 187816], [149, 187816], [154, 188026]]}, {"verse": 22, "start": 189218, "end": 196632, "text": "Todo lo que tenía aliento de espíritu de vida en sus narices, de todo lo que había en la tierra, murió.", "words": [[0, 189218], [5, 189482], [8, 189842], [12, 189982], [18, 190362], [26, 191082], [29, 191362], [38, 192082], [41, 192202], [46, 192422], [49, 192582], [53, 192762], [62, 193882], [65, 193962], [70, 194202], [73, 194442], [77, 194602], [83, 194802], [86, 194982], [89, 195102], [97, 196022]]}, {"verse": 23, "start": 196982, "end": 212923, "text": "Así fue destruida toda sustancia que vivía sobre la faz de la tierra, desde el hombre hasta la bestia, y los reptiles, y las aves del cielo; y fueron borrados de la tierra; y quedó solamente Noé, y lo que con él estaba en el arca.", "words": [[0, 196982], [4, 197287], [8, 197547], [18, 198327], [23, 198627], [33, 199527], [37, 199747], [43, 200167], [49, 200427], [52, 200647], [56, 200907], [59, 201087], [62, 201187], [70, 202087], [76, 202367], [79, 202667], [86, 202947], [92, 203227], [95, 203407], [103, 203987], [105, 204407], [109, 204567], [119, 205307], [121, 205807], [125, 205987], [130, 206287], [134, 206467], [141, 207374], [143, 207483], [150, 207743], [159, 208363], [162, 208583], [165, 208703], [173, 209403], [175, 209585], [181, 209805], [191, 210381], [196, 210958], [198, 211134], [201, 211310], [205, 211430], [209, 211630], [212, 211750], [219, 212050], [222, 2