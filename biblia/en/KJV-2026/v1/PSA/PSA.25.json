{"book": "PSA", "chapter": 25, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 117937, "verses": [{"verse": 1, "start": 300, "end": 2754, "text": "To you, O LORD, do I lift up my soul.", "words": [[0, 300], [3, 400], [8, 820], [10, 880], [16, 1380], [19, 1460], [21, 1600], [26, 1840], [29, 2000], [32, 2180]]}, {"verse": 2, "start": 3204, "end": 8765, "text": "O my God, I trust in you: let me not be ashamed, let not my enemies triumph over me.", "words": [[0, 3255], [2, 3345], [5, 3505], [10, 3905], [12, 3965], [18, 4225], [21, 4525], [26, 5124], [30, 5251], [33, 5391], [37, 5591], [40, 5811], [49, 6711], [53, 6811], [57, 7011], [60, 7231], [68, 7571], [76, 8031], [81, 8431]]}, {"verse": 3, "start": 9215, "end": 15673, "text": "Yes, let none that wait on you be ashamed: let them be ashamed which transgress without cause.", "words": [[0, 9215], [5, 9985], [9, 10265], [14, 10545], [19, 10805], [24, 11005], [27, 11185], [31, 11365], [34, 11525], [43, 12564], [47, 12709], [52, 12909], [55, 13069], [63, 13469], [69, 13789], [80, 14489], [88, 14869]]}, {"verse": 4, "start": 16123, "end": 19246, "text": "Show me your ways, O LORD; teach me your paths.", "words": [[0, 16123], [5, 16342], [8, 16522], [13, 16662], [19, 17162], [21, 17242], [27, 18022], [33, 18186], [36, 18426], [41, 18566]]}, {"verse": 5, "start": 19696, "end": 26206, "text": "Lead me in your truth, and teach me: for you are the God of my salvation; on you do I wait all the day.", "words": [[0, 19696], [5, 19905], [8, 20105], [11, 20265], [16, 20385], [23, 20745], [27, 21005], [33, 21265], [37, 21955], [41, 22074], [45, 22314], [49, 22434], [53, 22574], [57, 22814], [60, 22954], [63, 23154], [74, 24345], [77, 24509], [81, 24709], [84, 24889], [86, 25109], [91, 25349], [95, 25569], [99, 25709]]}, {"verse": 6, "start": 26656, "end": 32079, "text": "Remember, O LORD, your tender mercies and your lovingkindnesses; for they have been ever of old.", "words": [[0, 26656], [10, 27146], [12, 27246], [18, 27766], [23, 27886], [30, 28166], [38, 28806], [42, 28926], [47, 29620], [65, 30547], [69, 30645], [74, 30785], [79, 30925], [84, 31145], [89, 31405], [92, 31665]]}, {"verse": 7, "start": 32529, "end": 39935, "text": "Remember not the sins of my youth, nor my transgressions: according to your mercy remember you me for your goodness’ sake, O LORD.", "words": [[0, 32529], [9, 32797], [13, 33077], [17, 33297], [22, 33517], [25, 33737], [28, 33937], [35, 34297], [39, 34657], [42, 34877], [58, 36208], [68, 36514], [71, 36794], [76, 36934], [82, 37354], [91, 37674], [95, 38014], [98, 38194], [102, 38414], [107, 38554], [117, 38814], [123, 39414], [125, 39474]]}, {"verse": 8, "start": 40385, "end": 45406, "text": "Good and upright is the LORD: therefore will he teach sinners in the way.", "words": [[0, 40385], [5, 40605], [9, 40905], [17, 41345], [20, 41725], [24, 41905], [30, 42760], [40, 43325], [45, 43545], [48, 43705], [54, 44005], [62, 44465], [65, 44785], [69, 44905]]}, {"verse": 9, "start": 45857, "end": 50788, "text": "The meek will he guide in judgment: and the meek will he teach his way.", "words": [[0, 45857], [4, 46003], [9, 46423], [14, 46683], [17, 46843], [23, 47183], [26, 47423], [36, 48447], [40, 48609], [44, 48729], [49, 49129], [54, 49489], [57, 49649], [63, 49929], [67, 50249]]}, {"verse": 10, "start": 51238, "end": 56844, "text": "All the paths of the LORD are mercy and truth to such as keep his covenant and his testimonies.", "words": [[0, 51238], [4, 51445], [8, 51605], [14, 51905], [17, 52165], [21, 52285], [26, 52565], [30, 52805], [36, 53205], [40, 53425], [46, 53805], [49, 54165], [54, 54385], [57, 54585], [62, 54825], [66, 55065], [75, 55425], [79, 55785], [83, 55945]]}, {"verse": 11, "start": 57294, "end": 61220, "text": "For your name’s sake, O LORD, pardon my iniquity; for it is great.", "words": [[0, 57294], [4, 57405], [9, 57545], [16, 57945], [22, 58305], [24, 58345], [30, 58845], [37, 59125], [40, 59405], [50, 60318],