{"book": "LUK", "chapter": 4, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 364649, "verses": [{"verse": 1, "start": 300, "end": 7460, "text": "Y Jesús, lleno del Espíritu Santo, volvió del Jordán, y fue llevado por el Espíritu al desierto", "words": [[0, 300], [2, 465], [9, 1405], [15, 1925], [19, 2065], [28, 2625], [35, 3545], [42, 3985], [46, 4125], [54, 4865], [56, 5285], [60, 5445], [68, 5905], [72, 6145], [75, 6265], [84, 6825], [87, 6945]]}, {"verse": 2, "start": 7910, "end": 16595, "text": "Por cuarenta días, y era tentado del diablo. Y no comió cosa en aquellos días: los cuales pasados, tuvo hambre.", "words": [[0, 7910], [4, 8330], [13, 8750], [19, 9210], [21, 9710], [25, 9850], [33, 10450], [37, 10690], [45, 11778], [47, 11903], [50, 12023], [56, 12443], [61, 12863], [64, 13043], [73, 13303], [79, 14456], [83, 14536], [90, 14876], [99, 15596], [104, 15936]]}, {"verse": 3, "start": 17045, "end": 23193, "text": "Entonces el diablo le dijo: Si eres Hijo de Dios, di a esta piedra que se haga pan.", "words": [[0, 17045], [9, 17992], [12, 18312], [19, 18752], [22, 18932], [28, 19737], [31, 19950], [36, 20190], [41, 20450], [44, 20610], [50, 21330], [53, 21510], [55, 21610], [60, 21790], [67, 22270], [71, 22370], [74, 22550], [79, 22710]]}, {"verse": 4, "start": 23543, "end": 32391, "text": "Y Jesús respondiéndole, dijo: Escrito está: Que no con pan solo vivirá el hombre, sino con toda palabra de Dios.", "words": [[0, 23543], [2, 23671], [8, 24541], [24, 25411], [30, 26304], [38, 26904], [44, 27770], [48, 27852], [51, 28099], [55, 28345], [59, 28592], [64, 28912], [71, 29452], [74, 29592], [82, 30232], [87, 30472], [91, 30792], [96, 31052], [104, 31592], [107, 31832]]}, {"verse": 5, "start": 32841, "end": 40044, "text": "Y le llevó el diablo a un alto monte, y le mostró en un momento de tiempo todos los reinos de la tierra.", "words": [[0, 32841], [2, 32960], [5, 33080], [11, 33460], [14, 33580], [21, 34020], [23, 34260], [26, 34440], [31, 34680], [38, 35140], [40, 35560], [43, 35700], [50, 36300], [53, 36540], [56, 36700], [64, 37140], [67, 37340], [74, 37740], [80, 38200], [84, 38660], [91, 39200], [94, 39320], [97, 39420]]}, {"verse": 6, "start": 40494, "end": 47715, "text": "Y le dijo el diablo: A ti te daré toda esta potestad, y la gloria de ellos; porque a mí es entregada, y a quien quiero la doy:", "words": [[0, 40494], [2, 40622], [5, 40722], [10, 40982], [13, 41142], [21, 42001], [23, 42108], [26, 42268], [29, 42388], [34, 42688], [39, 42848], [44, 43168], [54, 43868], [56, 44168], [59, 44288], [66, 44628], [69, 44748], [76, 45533], [83, 45781], [85, 45921], [88, 46001], [91, 46141], [102, 46661], [104, 46821], [106, 46881], [112, 47021], [119, 47281], [122, 47421]]}, {"verse": 7, "start": 48165, "end": 51078, "text": "Pues si tú adoras delante de mí, serán todos tuyos.", "words": [[0, 48165], [5, 48305], [8, 48465], [11, 48565], [18, 48945], [26, 49345], [29, 49445], [33, 49885], [39, 50185], [45, 50405]]}, {"verse": 8, "start": 51428, "end": 61667, "text": "Y respondiendo Jesús, le dijo: Vete de mí, Satanás, porque escrito está: A tu Señor Dios adorarás, y a él solo servirás.", "words": [[0, 51428], [2, 51549], [15, 52329], [22, 52669], [25, 53049], [31, 53917], [36, 54221], [39, 54401], [43, 54661], [52, 55701], [59, 55921], [67, 56381], [73, 57321], [75, 57527], [78, 57647], [84, 58007], [89, 58427], [99, 59387], [101, 59747], [103, 59847], [106, 60087], [111, 60507]]}, {"verse": 9, "start": 62117, "end": 70479, "text": "Y le llevó a Jerusalén, y le puso sobre el pináculo del templo, y le dijo: Si eres Hijo de Dios, échate de aquí abajo:", "words": [[0, 62117], [2, 62259], [5, 62359], [11, 62719], [13, 62819], [24, 63999], [26, 64219], [29, 64359], [34, 64779], [40, 65099], [43, 65299], [52, 66019], [56, 66239], [64, 66899], [66, 66999], [69, 67079], [75, 67852], [78, 68043], [83, 68243], [88, 68523], [91, 68683], [97, 69243], [104, 69563], [107, 69763], [112, 69943]]}, {"verse": 10, "start": 70929, "end": 74946, "text": "Porque escrito está: Que a sus ángeles mandará de ti, que te guarden;", "words": [[0, 70929], [7, 71222], [15, 71562], [21, 72392], [25, 72472], [27, 72572], [31, 72672], [39, 73072], [47, 73512], [50, 73672], [54, 73872], [58, 74212], [61, 74332]]}, {"verse": 11, "start": 75396, "end": 79108, "text": "Y en las manos te llevarán, para que no dañes tu pie en piedra.", "words": [[0, 75396], [2, 75523], [5, 75623], [9, 75743], [15, 76043], [18, 76263], [28, 76823], [33, 77283], [37, 77443], [40, 77583], [46, 78003], [49, 78123], [53, 78363], [56, 78563]]}, {"verse": 12, "start": 79458, "end": 85101, "text": "Y respondiendo Jesús, le dijo: Dicho está: No tentarás al Señor tu Dios.", "words": [[0, 79458], [2, 79580], [15, 80360], [22, 80700], [25, 81080], [31, 81948], [37, 82258], [43, 83120], [46, 83467], [55, 83847], [58, 83987], [64, 84307], [67, 84547]]}, {"verse": 13, "start": 85551, "end": 90019, "text": "Y acabada toda tentación, el diablo se fue de él por un tiempo.", "words": [[0, 85551], [2, 85775], [10, 86315], [15, 86535], [26, 87755], [29, 87855], [36, 88215], [39, 88455], [43, 88675], [46, 88875], [49, 89035], [53, 89235], [56, 89395]]}, {"verse": 14, "start": 90469, "end": 97246, "text": "Y Jesús volvió en el poder del Espíritu a Galilea, y salió la fama de él por toda la tierra de alrededor.", "words": [[0, 90469], [2, 90611], [8, 90971], [15, 91771], [18, 91871], [21, 92011], [27, 92311], [31, 92591], [40, 93171], [42, 93231], [51, 93891], [53, 94251], [59, 94571], [62, 94711], [67, 95051], [70, 95171], [73, 95291], [77, 95471], [82, 95771], [85, 95951], [92, 96271], [95, 96471]]}, {"verse": 15, "start": 97696, "end": 102974, "text": "Y enseñaba en las sinagogas de ellos, y era glorificado de todos.", "words": [[0, 97696], [2, 97965], [11, 98625], [14, 98745], [18, 98885], [28, 99645], [31, 99825], [38, 100665], [40, 101205], [44, 101655], [56, 102105], [59, 102285]]}, {"verse": 16, "start": 103424, "end": 113482, "text": "Y vino a Nazaret, donde había sido criado; y entró, conforme a su costumbre, el día del sábado en la sinagoga, y se levantó a leer.", "words": [[0, 103424], [2, 103560], [7, 103780], [9, 103940], [18, 104420], [24, 105240], [30, 105600], [35, 105920], [43, 106955], [45, 107100], [52, 107600], [61, 108340], [63, 108400], [66, 108520], [77, 109180], [80, 109620], [84, 109880], [88, 110100], [95, 110760], [98, 110880], [101, 111020], [111, 111700], [113, 112160], [116, 112280], [124, 112880], [126, 113020]]}, {"verse": 17, "start": 113932, "end": 121345, "text": "Y le fue dado el libro del profeta Isaías; y como abrió el libro, halló el lugar donde estaba escrito:", "words": [[0, 113932], [2, 114058], [5, 114158], [9, 114338], [14, 114638], [17, 114898], [23, 115158], [27, 115398], [35, 116038], [43, 117275], [45, 117379], [50, 117599], [56, 118019], [59, 118218], [66, 119019], [72, 119459], [75, 119599], [81, 119959], [87, 120259], [94, 120639]]}, {"verse": 18, "start": 121795, "end": 139517, "text": "El Espíritu del Señor es sobre mí, por cuanto me ha ungido para dar buenas nuevas a los pobres: me ha enviado para sanar a los quebrantados de corazón; para pregonar a los cautivos libertad, y a los ciegos vista; para poner en libertad a los quebrantados:", "words": [[0, 121795], [3, 121936], [12, 122576], [16, 122716], [22, 123056], [25, 123276], [31, 123496], [35, 124096], [39, 124256], [46, 124436], [49, 124736], [52, 125016], [59, 125296], [64, 125536], [68, 125796], [75, 126076], [82, 126396], [84, 126736], [88, 126836], [96, 127898], [99, 128027], [102, 128167], [110, 128647], [115, 128907], [121, 129407], [123, 129467], [127, 129607], [140, 130507], [143, 130687], [152, 131760], [157, 131927], [166, 132607], [168, 132667], [172, 132807], [181, 133347], [191, 134107], [193, 134287], [195, 134367], [199, 134547], [206, 135187], [213, 136230], [218, 136490], [224, 136850], [227, 137230], [236, 137910], [238, 138110], [242, 138250]]}, {"verse": 19, "start": 139967, "end": 142704, "text": "Para predicar el año agradable del Señor.", "words": [[0, 139967], [5, 140114], [14, 140754], [17, 141034], [21, 141464], [31, 141894], [35, 142054]]}, {"verse": 20, "start": 143154, "end": 152102, "text": "Y enrollando el libro, lo dio al ministro, y se sentó: y los ojos de todos en la sinagoga estaban fijos en él.", "words": [[0, 143154], [2, 143278], [13, 143938], [16, 144138], [23, 145038], [26, 145278], [30, 145518], [33, 145758], [43, 146538], [45, 147118], [48, 147278], [55, 148335], [57, 148443], [61, 148583], [66, 148903], [69, 149143], [75, 149483], [78, 149763], [81, 149903], [90, 150463], [98, 150843], [104, 151543], [107, 151763]]}, {"verse": 21, "start": 152552, "end": 157935, "text": "Y comenzó a decirles: Hoy se ha cumplido esta Escritura en vuestros oídos.", "words": [[0, 152552], [2, 152927], [10, 153487], [12, 153587], [22, 154762], [26, 154948], [29, 155148], [32, 155288], [41, 155988], [46, 156168], [56, 156808], [59, 156908], [68, 157268]]}, {"verse": 22, "start": 158385, "end": 167171, "text": "Y todos le daban testimonio, y estaban maravillados de las palabras de gracia que salían de su boca, y decían: ¿No es este el hijo de José?", "words": [[0, 158385], [2, 158510], [8, 158730], [11, 158970], [17, 159270], [29, 160190], [31, 160310], [39, 160610], [52, 161490], [55, 161650], [59, 161770], [68, 162170], [71, 162350], [78, 162850], [82, 162950], [89, 163370], [92, 163530], [95, 163670], [101, 163990], [103, 164430], [111, 165401], [115, 165617], [118, 165857], [123, 166177], [126, 166357], [131, 166537], [134, 166657]]}, {"verse": 23, "start": 167521, "end": 179115, "text": "Y les dijo: Sin duda me diréis este refrán: Médico, cúrate a ti mismo: de tantas cosas que hemos oído haber sido hechas en Capernaum, haz también aquí en tu tierra.", "words": [[0, 167521], [2, 167669], [6, 167769], [12, 168637], [16, 168823], [21, 169083], [24, 169303], [31, 169663], [36, 169943], [44, 170920], [52, 171870], [59, 172150], [61, 172329], [64, 172430], [71, 173327], [74, 173472], [81, 173892], [87, 174272], [91, 174852], [97, 175032], [102, 175412], [108, 175592], [113, 175912], [120, 176232], [123, 176657], [134, 177082], [138, 177507], [146, 177932], [151, 178152], [154, 178332], [157, 178452]]}, {"verse": 24, "start": 179565, "end": 185654, "text": "Y dijo: De cierto os digo, que ningún profeta es acepto en su tierra.", "words": [[0, 179565], [2, 179768], [8, 181025], [11, 181227], [18, 181547], [21, 181967], [27, 182267], [31, 182867], [38, 183227], [46, 183947], [49, 184127], [56, 184667], [59, 184767], [62, 184927]]}, {"verse": 25, "start": 186104, "end": 198950, "text": "Pero en verdad os digo, que muchas viudas había en Israel en los días de Elías, cuando el cielo fue cerrado por tres años y seis meses, que hubo una gran hambruna en toda la tierra;", "words": [[0, 186104], [5, 186307], [8, 186427], [15, 186687], [18, 186967], [24, 187327], [28, 187567], [35, 187867], [42, 188647], [48, 189047], [51, 189307], [58, 189707], [61, 190187], [65, 190347], [70, 190607], [73, 190827], [80, 191287], [87, 191867], [90, 192127], [96, 192407], [100, 192687], [108, 193187], [112, 193447], [117, 193947], [122, 194367], [124, 194587], [129, 194827], [136, 195812], [140, 195917], [145, 196317], [149, 196457], [154, 196757], [163, 197697], [166, 197877], [171, 198017], [174, 198237]]}, {"verse": 26, "start": 199400, "end": 205495, "text": "Pero a ninguna de ellas fue enviado Elías, sino a Sarepta de Sidón, a una mujer viuda.", "words": [[0, 199400], [5, 199542], [7, 199662], [15, 199909], [18, 200155], [24, 200402], [28, 200582], [36, 201082], [43, 202182], [48, 202602], [50, 202922], [58, 203242], [61, 203382], [68, 204322], [70, 204402], [74, 204542], [80, 204882]]}, {"verse": 27, "start": 205945, "end": 215711, "text": "Y muchos leprosos había en Israel en tiempo del profeta Eliseo; pero ninguno de ellos fue limpio, sino Naamán el sirio.", "words": [[0, 205945], [2, 206090], [9, 206370], [18, 207330], [24, 207770], [27, 208030], [34, 208530], [37, 208970], [44, 209430], [48, 209690], [56, 210409], [64, 211379], [69, 211524], [77, 212024], [80, 212204], [86, 212464], [90, 212724], [98, 213644], [103, 214154], [110, 214664], [113, 214984]]}, {"verse": 28, "start": 216161, "end": 221805, "text": "Entonces todos en la sinagoga fueron llenos de ira, oyendo estas cosas;", "words": [[0, 216161], [9, 216948], [15, 217408], [18, 217848], [21, 217968], [30, 218608], [37, 218928], [44, 219568], [47, 219768], [52, 220308], [59, 220848], [65, 221048]]}, {"verse": 29, "start": 222255, "end": 233529, "text": "Y levantándose, le echaron fuera de la ciudad, y le llevaron hasta la cumbre del monte sobre el cual la ciudad de ellos estaba edificada, para despeñarle.", "words": [[0, 222255], [2, 222376], [16, 223796], [19, 223996], [27, 224396], [33, 224656], [36, 224876], [39, 224996], [47, 225256], [49, 226096], [52, 226216], [61, 226696], [67, 227016], [70, 227196], [77, 227636], [81, 227816], [87, 228116], [93, 228436], [96, 228656], [101, 228876], [104, 229516], [111, 229936], [114, 230156], [120, 230416], [127, 230836], [138, 231616], [143, 232036]]}, {"verse": 30, "start": 233979, "end": 236812, "text": "Pero él, pasando por medio de ellos, se fue.", "words": [[0, 233979], [5, 234143], [9, 234423], [17, 234863], [21, 235223], [27, 235483], [30, 235743], [37, 236043], [40, 236323]]}, {"verse": 31, "start": 237262, "end": 243543, "text": "Y descendió a Capernaum, ciudad de Galilea. Y los enseñaba en los sábados.", "words": [[0, 237262], [2, 237533], [12, 238173], [14, 238773], [25, 239373], [32, 239693], [35, 240013], [44, 241092], [46, 241283], [50, 241513], [59, 242393], [62, 242573], [66, 242693]]}, {"verse": 32, "start": 243993, "end": 248755, "text": "Y se maravillaban de su doctrina, porque su palabra era con autoridad.", "words": [[0, 243993], [2, 244313], [5, 244473], [18, 245253], [21, 245433], [24, 245613], [34, 246213], [41, 246593], [44, 246793], [52, 247273], [56, 247653], [60, 247913]]}, {"verse": 33, "start": 249205, "end": 256623, "text": "Y estaba en la sinagoga un hombre que tenía un espíritu de un demonio inmundo, el cual exclamó a gran voz,", "words": [[0, 249205], [2, 249334], [9, 249734], [12, 249934], [15, 250054], [24, 250734], [27, 250994], [34, 251354], [38, 251574], [44, 251934], [47, 252134], [56, 252774], [59, 252894], [62, 253014], [70, 253494], [79, 254114], [82, 254634], [87, 255204], [95, 255774], [97, 255874], [102, 256054]]}, {"verse": 34, "start": 257073, "end": 265037, "text": "Diciendo: Déjanos, ¿qué tenemos contigo, Jesús nazareno? ¿has venido a destruirnos? Yo te conozco quién eres, el Santo de Dios.", "words": [[0, 257073], [10, 258157], [19, 258602], [24, 258742], [32, 259082], [41, 259642], [47, 259802], [57, 260902], [62, 261072], [69, 261472], [71, 261572], [84, 262717], [87, 262799], [90, 262919], [98, 263359], [104, 263539], [110, 264059], [113, 264119], [119, 264419], [122, 264619]]}, {"verse": 35, "start": 265387, "end": 278770, "text": "Y Jesús le reprendió, diciendo: Enmudece, y sal de él. Entonces el demonio, derribándole en medio, salió de él, y no le hizo daño alguno.", "words": [[0, 265387], [2, 265511], [8, 265891], [11, 266711], [22, 267193], [32, 269085], [42, 269324], [44, 269564], [48, 269803], [51, 270043], [55, 272119], [64, 272719], [67, 273099], [76, 273639], [89, 274419], [92, 274699], [99, 275059], [105, 275899], [108, 276099], [112, 276379], [114, 277019], [117, 277179], [120, 277319], [125, 277619], [130, 278179]]}, {"verse": 36, "start": 279220, "end": 289311, "text": "Y hubo espanto en todos, y hablaban unos a otros, diciendo: ¿Qué palabra es esta, que con autoridad y poder manda a los espíritus inmundos, y salen?", "words": [[0, 279220], [2, 279381], [7, 279681], [15, 280261], [18, 280481], [25, 280961], [27, 281741], [36, 282241], [41, 282561], [43, 282821], [50, 283241], [60, 284628], [65, 284708], [73, 284988], [76, 285268], [82, 285908], [86, 285908], [90, 286088], [100, 286628], [102, 286728], [108, 286968], [114, 287188], [116, 287408], [120, 287528], [130, 288068], [140, 288528], [142, 288828]]}, {"verse": 37, "start": 289661, "end": 294282, "text": "Y la fama de él se divulgaba de todas partes por todos los lugares de la comarca.", "words": [[0, 289661], [2, 289769], [5, 289909], [10, 290269], [13, 290369], [16, 290549], [19, 290709], [29, 291309], [32, 291469], [38, 291629], [45, 292109], [49, 292329], [55, 292609], [59, 292869], [67, 293209], [70, 293429], [73, 293549]]}, {"verse": 38, "start": 294732, "end": 305598, "text": "Y levantándose Jesús de la sinagoga, entró en casa de Simón: y la suegra de Simón estaba con una grande fiebre; y le rogaron por ella.", "words": [[0, 294732], [2, 295234], [15, 295994], [21, 296454], [24, 296874], [27, 296994], [37, 298154], [43, 298594], [46, 298774], [51, 299034], [54, 299294], [61, 300271], [63, 300394], [66, 300514], [73, 301074], [76, 301194], [82, 301734], [89, 302114], [93, 302414], [97, 302614], [104, 302954], [112, 304069], [114, 304203], [117, 304373], [125, 304953], [129, 305133]]}, {"verse": 39, "start": 306048, "end": 315523, "text": "E inclinándose hacia ella, reprendió a la fiebre; y la fiebre la dejó; y ella levantándose luego, les servía.", "words": [[0, 306048], [2, 306208], [15, 307488], [21, 307888], [27, 308688], [37, 309428], [39, 309568], [42, 309628], [50, 310561], [52, 310785], [55, 310905], [62, 311285], [65, 311445], [71, 312281], [73, 312427], [78, 312727], [91, 313827], [98, 314207], [102, 314727]]}, {"verse": 40, "start": 315973, "end": 327387, "text": "Y poniéndose el sol, todos los que tenían enfermos de diversas enfermedades, los traían a él; y él, poniendo las manos sobre cada uno de ellos, los sanaba.", "words": [[0, 315973], [2, 316101], [13, 316781], [16, 316961], [21, 317621], [27, 317941], [31, 318241], [35, 318381], [42, 318721], [51, 319401], [54, 319521], [63, 320061], [77, 321321], [81, 321561], [88, 322121], [90, 322261], [94, 323006], [96, 323193], [100, 323753], [109, 324153], [113, 324333], [119, 324693], [125, 325053], [130, 325333], [134, 325693], [137, 325893], [144, 326273], [148, 326653]]}, {"verse": 41, "start": 327837, "end": 340529, "text": "Y salían también demonios de muchos, dando voces, y diciendo: Tú eres el Hijo de Dios. Pero reprendiéndolos no les dejaba hablar; porque sabían que él era el Cristo.", "words": [[0, 327837], [2, 327962], [9, 328442], [17, 328782], [26, 329422], [29, 329542], [37, 330282], [43, 330602], [50, 331302], [52, 331762], [62, 332788], [65, 332905], [70, 333145], [73, 333345], [78, 333545], [81, 333685], [87, 334821], [92, 335518], [108, 336248], [111, 336708], [115, 336928], [122, 337368], [130, 338307], [137, 338492], [144, 338952], [148, 339152], [151, 339372], [155, 339572], [158, 339772]]}, {"verse": 42, "start": 340979, "end": 351689, "text": "Y siendo ya de día salió, y se fue a un lugar desierto: y la gente lo buscaba y acudía a él; y le detenían para que no se apartase de ellos.", "words": [[0, 340979], [2, 341103], [9, 341443], [12, 341723], [15, 341883], [19, 342163], [26, 343303], [28, 343423], [31, 343523], [35, 343743], [37, 343883], [40, 343983], [46, 344323], [56, 345668], [58, 345792], [61, 345892], [67, 346172], [70, 346412], [78, 346952], [80, 347092], [87, 347632], [89, 347852], [93, 348656], [95, 348800], [98, 348920], [107, 349500], [112, 349760], [116, 349920], [119, 350060], [122, 350240], [131, 350860], [134, 351060]]}, {"verse": 43, "start": 352139, "end": 361294, "text": "Pero él les dijo: Que también a otras ciudades es necesario que anuncie el evangelio del reino de Dios; porque para esto soy enviado.", "words": [[0, 352139], [5, 352281], [8, 352501], [12, 352621], [18, 353441], [22, 353526], [30, 353826], [32, 354086], [38, 354286], [47, 354926], [50, 355146], [60, 356046], [64, 356306], [72, 357166], [75, 357426], [85, 358086], [89, 358286], [95, 358686], [98, 358846], [104, 359554], [111, 359757], [116, 360057], [121, 360277], [125, 360557]]}, {"verse": 44, "start": 361744, "end": 364249, "text": "Y predicaba en las sinagogas de Galilea.", "words": [[0, 361744], [2, 361854], [12, 362474], [15, 362634], [19, 362754], [29, 363354], [32, 363434]]}]}