{"book": "PSA", "chapter": 69, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 246773, "verses": [{"verse": 1, "start": 300, "end": 9167, "text": "Al Músico principal: sobre Sosannim: Salmo de David. SÁLVAME, oh Dios, porque las aguas han entrado hasta el alma.", "words": [[0, 300], [3, 484], [10, 984], [21, 2083], [27, 2367], [37, 3649], [43, 4433], [46, 4633], [53, 5382], [62, 5751], [65, 6131], [71, 6811], [78, 6971], [82, 7251], [88, 7631], [92, 7771], [100, 8311], [106, 8471], [109, 8651]]}, {"verse": 2, "start": 9517, "end": 17405, "text": "Estoy hundido en cieno profundo, donde no hay pie: he venido a abismos de aguas, y la corriente me ha anegado.", "words": [[0, 9517], [6, 9903], [14, 10383], [17, 10563], [23, 10943], [33, 11503], [39, 12003], [42, 12303], [46, 12463], [51, 13124], [54, 13251], [61, 13651], [63, 13831], [71, 14251], [74, 14391], [81, 14971], [83, 15391], [86, 15511], [96, 16111], [99, 16411], [102, 16945]]}, {"verse": 3, "start": 17755, "end": 25897, "text": "Cansado estoy de llamar; mi garganta se ha enronquecido; han desfallecido mis ojos esperando a mi Dios.", "words": [[0, 17755], [8, 18317], [14, 18557], [17, 18797], [25, 19595], [28, 19895], [37, 20162], [40, 20428], [43, 20695], [57, 22245], [61, 22545], [74, 23385], [78, 23565], [83, 23885], [93, 24405], [95, 24725], [98, 24805]]}, {"verse": 4, "start": 26247, "end": 39949, "text": "Se han aumentado más que los cabellos de mi cabeza los que me aborrecen sin causa; se han fortalecido mis enemigos, los que me destruyen sin por qué: he venido pues a pagar lo que no he tomado.", "words": [[0, 26247], [3, 26393], [7, 26553], [17, 27273], [21, 27533], [25, 27753], [29, 27913], [38, 28493], [41, 28573], [44, 28693], [51, 29693], [55, 29753], [59, 29913], [62, 30053], [72, 30633], [76, 30833], [83, 31868], [86, 32197], [90, 32337], [102, 33277], [106, 33457], [116, 34477], [120, 34837], [124, 34977], [127, 35117], [137, 35837], [141, 36077], [145, 36397], [150, 37107], [153, 37211], [160, 37611], [165, 37851], [167, 38071], [173, 38371], [176, 38771], [180, 38911], [183, 39151], [186, 39291]]}, {"verse": 5, "start": 40299, "end": 44230, "text": "Dios, tú sabes mi locura; y mis delitos no te son ocultos.", "words": [[0, 40299], [6, 40544], [9, 40784], [15, 41044], [18, 41324], [26, 42074], [28, 42183], [32, 42323], [40, 42823], [43, 43043], [46, 43203], [50, 43443]]}, {"verse": 6, "start": 44580, "end": 54359, "text": "No sean avergonzados por mi causa los que te esperan, oh Señor Jehová de los ejércitos; no sean confusos por mí los que te buscan, oh Dios de Israel.", "words": [[0, 44580], [3, 44707], [8, 44987], [21, 45907], [25, 46147], [28, 46327], [34, 46707], [38, 46947], [42, 47087], [45, 47187], [54, 47697], [57, 48207], [63, 48607], [70, 49207], [73, 49307], [77, 49467], [88, 50693], [91, 50798], [96, 51038], [105, 51698], [109, 51905], [112, 52111], [116, 52318], [120, 52438], [123, 52558], [131, 52918], [134, 53278], [139, 53478], [142, 53698]]}, {"verse": 7, "start": 54709, "end": 60472, "text": "Porque por amor de ti he sufrido afrenta; confusión ha cubierto mi rostro.", "words": [[0, 54709], [7, 54973], [11, 55253], [16, 55513], [19, 55773], [22, 55993], [25, 56233], [33, 56833], [42, 57966], [52, 58793], [55, 58993], [64, 59553], [67, 59733]]}, {"verse": 8, "start": 60822, "end": 66180, "text": "He sido extrañado de mis hermanos, y extraño a los hijos de mi madre.", "words": [[0, 60822], [3, 60929], [8, 61229], [18, 62209], [21, 62389], [25, 62529], [35, 63549], [37, 63729], [45, 64509], [47, 64769], [51, 64949], [57, 65249], [60, 65449], [63, 65569]]}, {"verse": 9, "start": 66530, "end": 73004, "text": "Porque me consumió el celo de tu casa; y los denuestos de los que te vituperaban, cayeron sobre mí.", "words": [[0, 66530], [7, 66755], [10, 66955], [19, 67755], [22, 68015], [27, 68475], [30, 68575], [33, 68755], [39, 69501], [41, 69732], [45, 69892], [55, 70512], [58, 70632], [62, 70732], [66, 70872], [69, 71032], [82, 71732], [90, 72332], [96, 72592]]}, {"verse": 10, "start": 73354, "end": 78398, "text": "Y lloré afligiendo con ayuno mi alma; y esto me ha sido por afrenta.", "words": [[0, 73354], [2, 73480], [8, 74000], [19, 74900], [23, 75120], [29, 75520], [32, 75780], [38, 76567], [40, 76684], [45, 76884], [48, 77084], [51, 77184], [56, 77404], [60, 77664]]}, {"verse": 11, "start": 78748, "end": 83811, "text": "Puse además saco por mi vestido; y vine a serles por proverbio.", "words": [[0, 78748], [5, 79030], [12, 79290], [17, 79910], [21, 80110], [24, 80290], [33, 81277], [35, 81611], [40, 81811], [42, 82191], [49, 82571], [53, 82851]]}, {"verse": 12, "start": 84161, "end": 92304, "text": "Hablaban contra mí los que se sentaban a la puerta, y se burlaban de mí en sus canciones de los bebedores de sidra.", "words": [[0, 84161], [9, 84585], [16, 84965], [19, 85245], [23, 85565], [27, 85725], [30, 85865], [39, 86485], [41, 86585], [44, 86685], [52, 87675], [54, 87965], [57, 88165], [66, 88765], [69, 89005], [72, 89185], [75, 89485], [79, 89805], [89, 90665], [92, 90885], [96, 91005], [106, 91545], [109, 91955]]}, {"verse": 13, "start": 92654, "end": 103510, "text": "Pero yo enderezaba mi oración a ti, oh Jehová, al tiempo de tu buena voluntad: oh Dios, por la multitud de tu misericordia, por la verdad de tu salvación, óyeme.", "words": [[0, 92654], [5, 92802], [8, 93102], [19, 93902], [22, 94082], [30, 94502], [32, 94702], [36, 94912], [39, 95122], [47, 95642], [50, 95822], [57, 96102], [60, 96362], [63, 96502], [69, 96722], [79, 98771], [82, 98771], [88, 98771], [92, 99133], [95, 99313], [104, 99933], [107, 100113], [110, 100253], [124, 101253], [128, 101333], [131, 101493], [138, 101753], [141, 102013], [144, 102153], [155, 102973]]}, {"verse": 14, "start": 103860, "end": 111743, "text": "Sácame del lodo, y no sea yo sumergido: sea yo libertado de los que me aborrecen, y del profundo de las aguas.", "words": [[0, 103860], [7, 104344], [11, 104624], [17, 105004], [19, 105104], [22, 105284], [26, 105464], [29, 105744], [40, 106898], [44, 107115], [47, 107335], [57, 108055], [60, 108215], [64, 108315], [68, 108475], [71, 108615], [82, 109315], [84, 109775], [88, 109935], [97, 110615], [100, 110815], [104, 110995]]}, {"verse": 15, "start": 112093, "end": 119087, "text": "No me anegue el ímpetu de las aguas, ni me trague la hondura, ni el pozo cierre sobre mí su boca.", "words": [[0, 112093], [3, 112277], [6, 112577], [13, 112877], [16, 113137], [23, 113717], [26, 113877], [30, 114077], [37, 115117], [40, 115457], [43, 115617], [50, 115937], [53, 116427], [62, 116917], [65, 117057], [68, 117177], [73, 117517], [80, 117937], [86, 118177], [89, 118417], [92, 118597]]}, {"verse": 16, "start": 119437, "end": 126316, "text": "Óyeme, Jehová, porque apacible es tu misericordia; mírame conforme a la multitud de tus misericordias.", "words": [[0, 119757], [7, 120077], [15, 120397], [22, 120597], [31, 121357], [34, 121537], [37, 121597], [51, 122998], [58, 123303], [67, 123603], [69, 123903], [72, 124003], [81, 124623], [84, 124863], [88, 125023]]}, {"verse": 17, "start": 126666, "end": 132196, "text": "Y no escondas tu rostro de tu siervo; porque estoy angustiado; apresúrate, óyeme.", "words": [[0, 126666], [2, 126783], [5, 126923], [14, 127483], [17, 127623], [24, 128123], [27, 128243], [30, 128403], [38, 129250], [45, 129434], [51, 129674], [63, 130765], [75, 131464]]}, {"verse": 18, "start": 132546, "end": 137151, "text": "Acércate a mi alma, redímela: líbrame a causa de mis enemigos.", "words": [[0, 132546], [9, 133166], [11, 133346], [14, 133466], [20, 134173], [30, 135302], [38, 135542], [40, 135682], [46, 135982], [49, 136242], [53, 136342]]}, {"verse": 19, "start": 137501, "end": 144241, "text": "Tú sabes mi afrenta, y mi confusión, y mi deshonra: delante de ti están todos mis enemigos.", "words": [[0, 137501], [3, 137608], [9, 137868], [12, 138108], [21, 138948], [23, 139108], [26, 139228], [37, 140068], [39, 140328], [42, 140814], [52, 141464], [60, 142064], [63, 142224], [66, 142464], [72, 142724], [78, 143124], [82, 143404]]}, {"verse": 20, "start": 144591, "end": 154586, "text": "La afrenta ha quebrantado mi corazón, y estoy acongojado: y esperé quien se compadeciese de mí, y no lo hubo: y consoladores, y ninguno hallé.", "words": [[0, 144591], [3, 144741], [11, 145421], [14, 145581], [26, 146401], [29, 146581], [38, 147081], [40, 147561], [46, 147801], [58, 148980], [60, 149126], [67, 149606], [73, 149806], [76, 150336], [89, 150866], [92, 151086], [96, 151246], [98, 151426], [101, 151566], [104, 151726], [110, 152368], [112, 152473], [126, 153353], [128, 153713], [136, 154176]]}, {"verse": 21, "start": 154936, "end": 160056, "text": "Me pusieron además hiel por comida, y en mi sed me dieron a beber vinagre.", "words": [[0, 154936], [3, 155025], [12, 155545], [19, 156055], [24, 156565], [28, 156825], [36, 157345], [38, 157625], [41, 157805], [44, 158005], [48, 158325], [51, 158585], [58, 158945], [60, 159065], [66, 159265]]}, {"verse": 22, "start": 160406, "end": 165347, "text": "Sea su mesa delante de ellos por lazo, y lo que es para bien por tropiezo.", "words": [[0, 160406], [4, 160649], [7, 160889], [12, 161209], [20, 161729], [23, 161929], [29, 162109], [33, 162349], [39, 162849], [41, 163289], [44, 163429], [48, 163589], [51, 163749], [56, 163929], [61, 164149], [65, 164409]]}, {"verse": 23, "start": 165697, "end": 171791, "text": "Sean oscurecidos sus ojos para ver, y haz siempre titubear sus lomos.", "words": [[0, 165697], [5, 166137], [17, 167237], [21, 167537], [26, 167837], [31, 168157], [36, 168457], [38, 168877], [42, 169057], [50, 169717], [59, 170757], [63, 170977]]}, {"verse": 24, "start": 172141, "end": 176900, "text": "Derrama sobre ellos tu ira, y el furor de tu enojo los alcance.", "words": [[0, 172141], [8, 172675], [14, 172975], [20, 173295], [23, 173615], [28, 174475], [30, 174655], [33, 174795], [39, 175195], [42, 175355], [45, 175515], [51, 175895], [55, 176075]]}, {"verse": 25, "start": 177250, "end": 181668, "text": "Sea su palacio asolado: en sus tiendas no haya habitante.", "words": [[0, 177250], [4, 177534], [7, 177774], [15, 178424], [24, 179293], [27, 179401], [31, 179541], [39, 180161], [42, 180541], [47, 180761]]}, {"verse": 26, "start": 182018, "end": 187659, "text": "Porque persiguieron al que tú heriste; y cuentan del dolor de los que tú llagaste.", "words": [[0, 182018], [7, 182998], [20, 183398], [23, 183558], [27, 183718], [30, 184236], [39, 184940], [41, 185042], [49, 185562], [53, 185762], [59, 186142], [62, 186362], [66, 186482], [70, 186662], [73, 187189]]}, {"verse": 27, "start": 188009, "end": 192263, "text": "Pon maldad sobre su maldad, y no entren en tu justicia.", "words": [[0, 188009], [4, 188152], [11, 188692], [17, 189112], [20, 189332], [28, 189952], [30, 190392], [33, 190572], [40, 190892], [43, 191152], [46, 191312]]}, {"verse": 28, "start": 192613, "end": 197043, "text": "Sean raídos del libro de los vivientes, y no sean escritos con los justos.", "words": [[0, 192613], [5, 192835], [12, 193415], [16, 193575], [22, 193895], [25, 194075], [29, 194195], [40, 194755], [42, 195195], [45, 195315], [50, 195555], [59, 196075], [63, 196275], [67, 196455]]}, {"verse": 29, "start": 197393, "end": 202267, "text": "Y yo afligido y dolorido, tu salvación, oh Dios, me defenderá.", "words": [[0, 197393], [2, 197539], [5, 197739], [14, 198499], [16, 198599], [26, 199619], [29, 199699], [40, 200859], [43, 200999], [49, 201379], [52, 201499]]}, {"verse": 30, "start": 202617, "end": 207683, "text": "Alabaré yo el nombre de Dios con cántico, lo ensalzaré con alabanza.", "words": [[0, 202806], [8, 203032], [11, 203259], [14, 203419], [21, 203799], [24, 203999], [29, 204259], [33, 204559], [42, 205699], [45, 205779], [55, 206579], [59, 206719]]}, {"verse": 31, "start": 208033, "end": 214096, "text": "Y agradará a Jehová más que sacrificio de buey, o becerro que echa cuernos y uñas.", "words": [[0, 208033], [2, 208197], [11, 208837], [13, 209077], [20, 209537], [24, 209717], [28, 210127], [39, 210537], [42, 210977], [48, 211417], [50, 211857], [58, 212297], [62, 212507], [67, 212717], [75, 213277], [77, 213437]]}, {"verse": 32, "start": 214446, "end": 220202, "text": "Lo verán los humildes, y se gozarán; buscad a Dios, y vivirá vuestro corazón.", "words": [[0, 214446], [3, 214594], [9, 214894], [13, 215054], [23, 215914], [25, 216294], [28, 216474], [37, 217494], [44, 217978], [46, 218078], [52, 218318], [54, 218678], [61, 219118], [69, 219458]]}, {"verse": 33, "start": 220552, "end": 225802, "text": "Porque Jehová oye a los necesitados, y no menosprecia a sus prisioneros.", "words": [[0, 220552], [7, 220815], [14, 221395], [18, 221735], [20, 221895], [24, 221995], [37, 222995], [39, 223260], [42, 223460], [54, 224360], [56, 224640], [60, 224820]]}, {"verse": 34, "start": 226152, "end": 232198, "text": "Alábenlo los cielos y la tierra, los mares, y todo lo que se mueve en ellos.", "words": [[0, 226496], [9, 226876], [13, 227056], [20, 227616], [22, 227736], [25, 227876], [33, 228816], [37, 228896], [44, 229456], [46, 229856], [51, 230196], [54, 230496], [58, 230636], [61, 230816], [67, 231396], [70, 231616]]}, {"verse": 35, "start": 232548, "end": 239985, "text": "Porque Dios guardará a Sion, y reedificará las ciudades de Judá; y habitarán allí, y la poseerán.", "words": [[0, 232548], [7, 232793], [12, 233073], [21, 233533], [23, 233993], [29, 234453], [31, 234882], [43, 235311], [47, 235740], [56, 236169], [59, 236598], [65, 237452], [67, 237672], [77, 238212], [83, 238552], [85, 238892], [88, 239012]]}, {"verse": 36, "start": 240335, "end": 246373, "text": "Y la descendencia de sus siervos la heredará, y los que aman su nombre habitarán en ella.", "words": [[0, 240335], [2, 240437], [5, 240557], [18, 241517], [21, 241657], [25, 241817], [33, 242497], [36, 242937], [46, 243677], [48, 244117], [52, 244257], [56, 244417], [61, 244597], [64, 244857], [71, 245137], [81, 245717], [84, 245837]]}]}