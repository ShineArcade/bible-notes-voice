{"book": "PSA", "chapter": 91, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 96228, "verses": [{"verse": 1, "start": 300, "end": 5877, "text": "El que habita al abrigo del Altísimo, morará bajo la sombra del Omnipotente.", "words": [[0, 300], [3, 466], [7, 626], [14, 1086], [17, 1226], [24, 1646], [28, 1746], [38, 2426], [45, 3121], [50, 3521], [53, 3741], [60, 4241], [64, 4461]]}, {"verse": 2, "start": 6227, "end": 12152, "text": "Diré yo a Jehová: Esperanza mía, y castillo mío; mi Dios, en él confiaré.", "words": [[0, 6227], [5, 6767], [8, 6967], [10, 7147], [18, 7894], [28, 8354], [33, 8934], [35, 9074], [44, 9554], [49, 10232], [52, 10363], [58, 11044], [61, 11234], [64, 11424]]}, {"verse": 3, "start": 12502, "end": 17579, "text": "Y él te librará del lazo del cazador: de la peste destruidora.", "words": [[0, 12502], [2, 12665], [5, 12805], [8, 12945], [16, 13485], [20, 13665], [25, 14165], [29, 14345], [38, 15368], [41, 15511], [44, 15631], [50, 16151]]}, {"verse": 4, "start": 17929, "end": 24564, "text": "Con sus plumas te cubrirá, y debajo de sus alas estarás seguro: escudo y defensa es su verdad.", "words": [[0, 17929], [4, 18223], [8, 18463], [15, 19023], [18, 19163], [27, 19823], [29, 20203], [36, 20603], [39, 20763], [43, 20943], [48, 21383], [56, 21863], [64, 22496], [71, 23096], [73, 23196], [81, 23716], [84, 23896], [87, 24056]]}, {"verse": 5, "start": 24914, "end": 30022, "text": "No tendrás temor de espanto nocturno, ni de flecha que vuele de día;", "words": [[0, 24914], [3, 25063], [11, 25523], [17, 25963], [20, 26123], [28, 26683], [38, 27963], [41, 28223], [44, 28363], [51, 28803], [55, 29063], [61, 29323], [64, 29482]]}, {"verse": 6, "start": 30372, "end": 36607, "text": "Ni de pestilencia que ande en oscuridad, ni de mortandad que en medio del día destruya.", "words": [[0, 30372], [3, 30500], [6, 30640], [18, 31420], [22, 31680], [27, 32000], [30, 32160], [41, 33240], [44, 33440], [47, 33580], [57, 34380], [61, 34620], [64, 34760], [70, 35060], [74, 35360], [78, 35660]]}, {"verse": 7, "start": 36957, "end": 42231, "text": "Caerán a tu lado mil, y diez mil a tu diestra: mas a ti no llegará.", "words": [[0, 36957], [7, 37441], [9, 37561], [12, 37661], [17, 37941], [22, 38221], [24, 38841], [29, 39101], [33, 39521], [35, 39701], [38, 39841], [47, 40955], [51, 41083], [53, 41211], [56, 41339], [59, 41467]]}, {"verse": 8, "start": 42581, "end": 48352, "text": "Ciertamente con tus ojos mirarás, y verás la recompensa de los impíos.", "words": [[0, 42581], [12, 43386], [16, 43626], [20, 43846], [25, 44166], [34, 45046], [36, 45466], [42, 45926], [45, 46246], [56, 47166], [59, 47306], [63, 47426]]}, {"verse": 9, "start": 48702, "end": 53686, "text": "Porque tú has puesto a Jehová, que es mi esperanza, al Altísimo por tu habitación,", "words": [[0, 48702], [7, 48925], [10, 49165], [14, 49345], [21, 49545], [23, 49825], [31, 50305], [35, 50365], [38, 50505], [41, 50625], [52, 51645], [55, 51845], [64, 52485], [68, 52765], [71, 52925]]}, {"verse": 10, "start": 54036, "end": 57423, "text": "No te sobrevendrá mal, ni plaga tocará tu morada.", "words": [[0, 54036], [3, 54163], [6, 54283], [18, 55003], [23, 55323], [26, 55723], [32, 56183], [39, 56663], [42, 56763]]}, {"verse": 11, "start": 57773, "end": 64395, "text": "Pues que a sus ángeles mandará acerca de ti, que te guarden en todos tus caminos.", "words": [[0, 57773], [5, 58017], [9, 58377], [11, 58517], [15, 58637], [23, 59257], [31, 60017], [38, 60417], [41, 60757], [45, 61297], [49, 61857], [52, 62017], [60, 62597], [63, 62717], [69, 63097], [73, 63640]]}, {"verse": 12, "start": 64745, "end": 68492, "text": "En las manos te llevarán, porque tu pie no tropiece en piedra.", "words": [[0, 64836], [3, 65016], [7, 65156], [13, 65496], [16, 65716], [26, 66236], [33, 66496], [36, 66736], [40, 66976], [43, 67176], [52, 67696], [55, 67876]]}, {"verse": 13, "start": 68842, "end": 75359, "text": "Sobre el león y el áspid pisarás; hollarás al cachorro del león y al dragón.", "words": [[0, 68842], [6, 69228], [9, 69568], [14, 70008], [16, 70478], [19, 70947], [25, 71417], [34, 72315], [43, 72635], [46, 72795], [55, 73375], [59, 73595], [64, 74175], [66, 74435], [69, 74615]]}, {"verse": 14, "start": 75579, "end": 83276, "text": "Por cuanto en mí ha puesto su voluntad, yo también lo libraré: lo pondré en alto, por cuanto ha conocido mi nombre.", "words": [[0, 75579], [4, 75743], [11, 76043], [14, 76283], [17, 76523], [20, 76723], [27, 77003], [30, 77243], [40, 78383], [43, 78503], [51, 78863], [54, 79063], [63, 80171], [66, 80276], [73, 80676], [76, 80796], [82, 81376], [86, 81636], [93, 81896], [96, 82096], [105, 82576], [108, 82716]]}, {"verse": 15, "start": 83902, "end": 91199, "text": "Me invocará, y yo le responderé: con él estaré yo en la angustia: lo libraré, y le glorificaré.", "words": [[0, 83902], [3, 84005], [13, 84565], [15, 84885], [18, 85025], [21, 85145], [33, 86417], [37, 86581], [40, 86761], [47, 87201], [50, 87381], [53, 87641], [56, 87781], [66, 89021], [69, 89119], [78, 89639], [80, 90119], [83, 90259]]}, {"verse": 16, "start": 91782, "end": 95601, "text": "Lo saciaré de larga vida, y mostraréle mi salvación.", "words": [[0, 91981], [3, 92221], [11, 92461], [14, 92601], [20, 92961], [26, 93241], [28, 93761], [39, 94481], [42, 94741]]}]}