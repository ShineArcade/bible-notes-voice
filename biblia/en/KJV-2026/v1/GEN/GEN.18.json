{"book": "GEN", "chapter": 18, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 259950, "verses": [{"verse": 1, "start": 300, "end": 6112, "text": "And the LORD appeared to him in the plains of Mamre: and he sat in the tent door in the heat of the day;", "words": [[0, 300], [4, 422], [8, 562], [13, 782], [22, 1102], [25, 1382], [29, 1562], [32, 1802], [36, 1922], [43, 2282], [46, 2522], [53, 3421], [57, 3549], [60, 3669], [64, 3909], [67, 4149], [71, 4249], [76, 4489], [81, 4809], [84, 5069], [88, 5209], [93, 5409], [96, 5529], [100, 5649]]}, {"verse": 2, "start": 6462, "end": 16978, "text": "And he lift up his eyes and looked, and, lo, three men stood by him: and when he saw them, he ran to meet them from the tent door, and bowed himself toward the ground,", "words": [[0, 6462], [4, 6585], [7, 6705], [12, 6885], [15, 7125], [19, 7285], [24, 7605], [28, 7805], [36, 8545], [41, 8745], [45, 9365], [51, 9645], [55, 9965], [61, 10245], [64, 10565], [69, 11133], [73, 11295], [78, 11435], [81, 11635], [85, 11915], [91, 12495], [94, 12635], [98, 12895], [101, 13115], [106, 13295], [111, 13595], [116, 13815], [120, 13995], [125, 14235], [131, 14575], [135, 15115], [141, 15475], [149, 15695], [156, 16175], [160, 16415]]}, {"verse": 3, "start": 17328, "end": 22513, "text": "And said, My Lord, if now I have found favour in your sight, pass not away, please, from your servant:", "words": [[0, 17328], [4, 17677], [10, 18195], [13, 18315], [19, 18635], [22, 18655], [26, 18835], [28, 19015], [33, 19115], [39, 19335], [46, 19555], [49, 19775], [54, 19855], [61, 20335], [66, 20515], [70, 20735], [76, 21115], [84, 21735], [89, 21815], [94, 21955]]}, {"verse": 4, "start": 22863, "end": 27230, "text": "Let a little water, please, be fetched, and wash your feet, and rest yourselves under the tree:", "words": [[0, 22863], [4, 23026], [6, 23146], [13, 23286], [20, 23646], [28, 23966], [31, 24226], [40, 24766], [44, 24886], [49, 25146], [54, 25266], [60, 25486], [64, 25786], [69, 26026], [80, 26366], [86, 26686], [90, 26866]]}, {"verse": 5, "start": 27510, "end": 37139, "text": "And I will fetch a morsel of bread, and comfort your hearts; after that you shall pass on: for therefore are you come to your servant. And they said, So do, as you have said.", "words": [[0, 27510], [4, 27635], [6, 27755], [11, 27915], [17, 28135], [19, 28295], [26, 28675], [29, 28835], [36, 29155], [40, 29455], [48, 29775], [53, 29995], [61, 30776], [67, 30997], [72, 31357], [76, 31477], [82, 31637], [87, 31857], [91, 32581], [95, 32875], [105, 33215], [109, 33475], [113, 33595], [118, 33815], [121, 33975], [126, 34075], [135, 34859], [139, 35004], [144, 35124], [150, 35424], [153, 35684], [157, 36304], [160, 36424], [164, 36584], [169, 36704]]}, {"verse": 6, "start": 37489, "end": 45198, "text": "And Abraham hastened into the tent to Sarah, and said, Make ready quickly three measures of fine meal, knead it, and make cakes upon the hearth.", "words": [[0, 37489], [4, 37834], [12, 38234], [21, 38874], [26, 39074], [30, 39234], [35, 39454], [38, 39654], [45, 39974], [49, 40254], [55, 40957], [60, 41117], [66, 41377], [74, 41717], [80, 42017], [89, 42297], [92, 42517], [97, 42737], [103, 43277], [109, 43477], [113, 43657], [117, 44017], [122, 44157], [128, 44437], [133, 44717], [137, 44917]]}, {"verse": 7, "start": 45478, "end": 52712, "text": "And Abraham ran to the herd, and fetched a calf tender and good, and gave it to a young man; and he hasted to dress it.", "words": [[0, 45478], [4, 45579], [12, 46039], [16, 46519], [19, 46719], [23, 46839], [29, 47159], [33, 47699], [41, 48119], [43, 48179], [48, 48479], [55, 48839], [59, 49119], [65, 49419], [69, 49919], [74, 50139], [77, 50279], [80, 50419], [82, 50539], [88, 50739], [93, 51509], [97, 51654], [100, 51754], [107, 52094], [110, 52234], [116, 52454]]}, {"verse": 8, "start": 53062, "end": 60923, "text": "And he took butter, and milk, and the calf which he had dressed, and set it before them; and he stood by them under the tree, and they did eat.", "words": [[0, 53062], [4, 53190], [7, 53290], [12, 53470], [20, 53870], [24, 54350], [30, 54650], [34, 54875], [38, 54995], [43, 55255], [49, 55515], [52, 55675], [56, 55835], [65, 56135], [69, 56505], [73, 56875], [76, 56995], [83, 57255], [89, 57901], [93, 58030], [96, 58170], [102, 58390], [105, 58650], [110, 58850], [116, 59070], [120, 59250], [126, 59890], [130, 60070], [135, 60210], [139, 60430]]}, {"verse": 9, "start": 61273, "end": 66562, "text": "¶ And they said to him, Where is Sarah your wife? And he said, Behold, in the tent.", "words": [[2, 61273], [6, 61428], [11, 61548], [16, 61788], [19, 61988], [24, 62588], [30, 62888], [33, 63168], [39, 63628], [44, 63728], [50, 64593], [54, 64740], [57, 64860], [63, 65140], [71, 65800], [74, 66000], [78, 66120]]}, {"verse": 10, "start": 66912, "end": 77754, "text": "And he said, I will certainly return to you according to the time of life; and, lo, Sarah your wife shall have a son. And Sarah heard it in the tent door, which was behind him.", "words": [[0, 66912], [4, 67055], [7, 67175], [13, 67455], [15, 67655], [20, 67835], [30, 68275], [37, 68755], [40, 69035], [44, 69195], [54, 69575], [57, 69955], [61, 70055], [66, 70375], [69, 70515], [75, 71283], [80, 71430], [84, 72070], [90, 72690], [95, 72830], [100, 73130], [106, 73450], [111, 73690], [113, 73790], [118, 74540], [122, 74664], [128, 75004], [134, 75344], [137, 75524], [140, 75724], [144, 75824], [149, 76064], [155, 76404], [161, 76724], [165, 76924], [172, 77304]]}, {"verse": 11, "start": 78104, "end": 84905, "text": "Now Abraham and Sarah were old and well stricken in age; and it ceased to be with Sarah after the manner of women.", "words": [[0, 78104], [4, 78288], [12, 78808], [16, 79148], [22, 79448], [27, 79708], [31, 80128], [35, 80368], [40, 80588], [49, 81088], [52, 81248], [57, 82039], [61, 82168], [64, 82268], [71, 82508], [74, 82768], [77, 82868], [82, 83068], [88, 83408], [94, 83808], [98, 83988], [105, 84268], [108, 84468]]}, {"verse": 12, "start": 85255, "end": 92872, "text": "Therefore Sarah laughed within herself, saying, After I have grown old shall I have pleasure, my lord being old also?", "words": [[0, 85255], [10, 85765], [16, 85985], [24, 86385], [31, 86685], [40, 87345], [48, 88019], [54, 88299], [56, 88579], [61, 88779], [67, 89079], [71, 89779], [77, 89919], [79, 90119], [84, 90279], [94, 91139], [97, 91259], [102, 91499], [108, 91819], [112, 92219]]}, {"verse": 13, "start": 93152, "end": 99688, "text": "And the LORD said to Abraham, Why did Sarah laugh, saying, Shall I of a surety bear a child, which am old?", "words": [[0, 93152], [4, 93281], [8, 93421], [13, 93641], [18, 93921], [21, 94141], [30, 94994], [34, 95138], [38, 95238], [44, 95518], [51, 95998], [59, 96698], [65, 97018], [67, 97228], [70, 97438], [72, 97678], [79, 97918], [84, 98138], [86, 98278], [93, 98958], [99, 99098], [102, 99238]]}, {"verse": 14, "start": 100259, "end": 108090, "text": "Is any thing too hard for the LORD? At the time appointed I will return to you, according to the time of life, and Sarah shall have a son.", "words": [[0, 100259], [3, 100431], [7, 100637], [13, 100844], [17, 101124], [22, 101384], [26, 101544], [30, 101644], [36, 102622], [39, 102770], [43, 102870], [48, 103130], [58, 103550], [60, 103770], [65, 103910], [72, 104310], [75, 104510], [80, 104670], [90, 105030], [93, 105270], [97, 105390], [102, 105630], [105, 105790], [111, 106610], [115, 106730], [121, 107030], [127, 107230], [132, 107450], [134, 107570]]}, {"verse": 15, "start": 108595, "end": 114780, "text": "Then Sarah denied, saying, I laughed not; for she was afraid. And he said, No; but you did laugh.", "words": [[0, 108595], [5, 108814], [11, 109154], [19, 109514], [27, 110174], [29, 110374], [37, 110654], [42, 111400], [46, 111506], [50, 111686], [54, 111866], [62, 112682], [66, 112787], [69, 112907], [75, 113267], [79, 113884], [83, 113988], [87, 114128], [91, 114348]]}, {"verse": 16, "start": 115130, "end": 120582, "text": "¶ And the men rose up from there, and looked toward Sodom: and Abraham went with them to bring them on the way.", "words": [[2, 115130], [6, 115253], [10, 115333], [14, 115553], [19, 115793], [22, 116013], [27, 116193], [34, 116433], [38, 116753], [45, 117013], [52, 117273], [59, 118090], [63, 118199], [71, 118579], [76, 118899], [81, 119159], [86, 119339], [89, 119519], [95, 119719], [100, 119879], [103, 120019], [107, 120139]]}, {"verse": 17, "start": 120932, "end": 124686, "text": "And the LORD said, Shall I hide from Abraham that thing which I do;", "words": [[0, 120932], [4, 121039], [8, 121139], [13, 121319], [19, 122033], [25, 122216], [27, 122376], [32, 122636], [37, 122836], [45, 123276], [50, 123596], [56, 123856], [62, 124036], [64, 124196]]}, {"verse": 18, "start": 125258, "end": 131558, "text": "Seeing that Abraham shall surely become a great and mighty nation, and all the nations of the earth shall be blessed in him?", "words": [[0, 125258], [7, 125538], [12, 125758], [20, 126138], [26, 126458], [33, 126778], [40, 127098], [42, 127258], [48, 127598], [52, 127738], [59, 127998], [67, 128898], [71, 129158], [75, 129378], [79, 129518], [87, 129818], [90, 130058], [94, 130178], [100, 130338], [106, 130518], [109, 130658], [117, 130958], [120, 131158]]}, {"verse": 19, "start": 132151, "end": 143746, "text": "For I know him, that he will command his children and his household after him, and they shall keep the way of the LORD, to do justice and judgment; that the LORD may bring upon Abraham that which he has spoken of him.", "words": [[0, 132151], [4, 132266], [6, 132406], [11, 132626], [16, 132886], [21, 133111], [24, 133251], [29, 133371], [37, 133691], [41, 133911], [50, 134351], [54, 134651], [58, 134831], [68, 135211], [74, 135571], [79, 136131], [83, 136491], [88, 136611], [94, 136751], [99, 136931], [103, 137131], [107, 137271], [110, 137391], [114, 137511], [120, 137771], [123, 138071], [126, 138231], [134, 138651], [138, 139011], [148, 140120], [153, 140221], [157, 140341], [162, 140581], [166, 140781], [172, 141021], [177, 141301], [185, 142163], [190, 142256], [196, 142436], [199, 142596], [203, 142756], [210, 143096], [213, 143336]]}, {"verse": 20, "start": 144310, "end": 150878, "text": "And the LORD said, Because the cry of Sodom and Gomorrah is great, and because their sin is very grievous;", "words": [[0, 144310], [4, 144439], [8, 144559], [13, 144759], [19, 145526], [27, 145708], [31, 145908], [35, 146188], [38, 146348], [44, 146848], [48, 147218], [57, 147588], [60, 148108], [67, 148428], [71, 148928], [79, 149188], [85, 149408], [89, 149728], [92, 149928], [97, 150148]]}, {"verse": 21, "start": 151461, "end": 158629, "text": "I will go down now, and see whether they have done altogether according to the cry of it, which is come to me; and if not, I will know.", "words": [[0, 151461], [2, 151586], [7, 151706], [10, 151846], [15, 152126], [20, 152426], [24, 152681], [28, 152881], [36, 153141], [41, 153341], [46, 153481], [51, 153701], [62, 154201], [72, 154661], [75, 154881], [79, 155021], [83, 155241], [86, 155461], [90, 155861], [96, 156001], [99, 156141], [104, 156321], [107, 156481], [111, 157324], [115, 157459], [118, 157559], [123, 157959], [125, 158059], [130, 158199]]}, {"verse": 22, "start": 159168, "end": 164913, "text": "And the men turned their faces from there, and went toward Sodom: but Abraham stood yet before the LORD.", "words": [[0, 159168], [4, 159306], [8, 159426], [12, 159626], [19, 159906], [25, 160146], [31, 160526], [36, 160846], [43, 161166], [47, 161426], [52, 161676], [59, 161926], [66, 162769], [70, 162873], [78, 163313], [84, 163613], [88, 163873], [95, 164233], [99, 164433]]}, {"verse": 23, "start": 165263, "end": 169505, "text": "¶ And Abraham drew near, and said, Will you also destroy the righteous with the wicked?", "words": [[2, 165263], [6, 165392], [14, 165772], [19, 166112], [25, 166352], [29, 166572], [35, 167210], [40, 167311], [44, 167471], [49, 167711], [57, 168191], [61, 168371], [71, 168731], [76, 168991], [80, 169091]]}, {"verse": 24, "start": 169855, "end": 176175, "text": "Perhaps there are fifty righteous within the city: will you also destroy and not spare the place for the fifty righteous that are in it?", "words": [[0, 169855], [8, 170137], [14, 170417], [18, 170517], [24, 170757], [34, 171177], [41, 171497], [45, 171677], [51, 172291], [56, 172413], [60, 172553], [65, 172793], [73, 173293], [77, 173553], [81, 173753], [87, 174053], [91, 174213], [97, 174453], [101, 174653], [105, 174803], [111, 174953], [121, 175293], [126, 175593], [130, 175733], [133, 175893]]}, {"verse": 25, "start": 176525, "end": 187013, "text": "That be far from you to do after this manner, to slay the righteous with the wicked: and that the righteous should be as the wicked, that be far from you: Shall not the Judge of all the earth do right?", "words": [[0, 176525], [5, 176683], [8, 176823], [12, 177143], [17, 177343], [21, 177503], [24, 177643], [27, 177863], [33, 178243], [38, 178503], [46, 179023], [49, 179263], [54, 179663], [58, 179783], [68, 180123], [73, 180423], [77, 180523], [85, 181138], [89, 181281], [94, 181401], [98, 181541], [108, 181881], [115, 182301], [118, 182521], [121, 182801], [125, 182941], [133, 183221], [138, 183581], [141, 183741], [145, 184021], [150, 184241], [155, 184765], [161, 184962], [165, 185222], [169, 185422], [175, 185622], [178, 185802], [182, 186082], [186, 186222], [192, 186502], [195, 186782]]}, {"verse": 26, "start": 187293, "end": 194017, "text": "And the LORD said, If I find in Sodom fifty righteous within the city, then I will spare all the place for their sakes.", "words": [[0, 187293], [4, 187422], [8, 187542], [13, 187742], [19, 188510], [22, 188647], [24, 188807], [29, 189127], [32, 189267], [38, 189597], [44, 189927], [54, 190367], [61, 190707], [65, 190887], [71, 191567], [76, 191827], [78, 191967], [83, 192107], [89, 192367], [93, 192647], [97, 192787], [103, 193047], [107, 193247], [113, 193407]]}, {"verse": 27, "start": 194532, "end": 201229, "text": "And Abraham answered and said, Behold now, I have taken upon me to speak to the Lord, which am but dust and ashes:", "words": [[0, 194532], [4, 194657], [12, 195017], [21, 195477], [25, 195737], [31, 196304], [38, 196837], [43, 196957], [45, 197137], [50, 197237], [56, 197517], [61, 197777], [64, 198017], [67, 198157], [73, 198437], [76, 198637], [80, 198757], [86, 199397], [92, 199557], [95, 199677], [99, 199897], [104, 200297], [108, 200557]]}, {"verse": 28, "start": 201509, "end": 211471, "text": "Perhaps there shall lack five of the fifty righteous: will you destroy all the city for lack of five? And he said, If I find there forty and five, I will not destroy it.", "words": [[0, 201509], [8, 201789], [14, 202109], [20, 202329], [25, 202709], [30, 203149], [33, 203469], [37, 203589], [43, 203869], [54, 204914], [59, 205040], [63, 205160], [71, 205520], [75, 205820], [79, 205980], [84, 206200], [88, 206440], [93, 206680], [96, 206920], [102, 207678], [106, 207813], [109, 207913], [115, 208173], [118, 208273], [120, 208393], [125, 208733], [131, 208993], [137, 209253], [141, 209433], [147, 210153], [149, 210313], [154, 210473], [158, 210693], [166, 211073]]}, {"verse": 29, "start": 211821, "end": 220373, "text": "And he spoke to him yet again, and said, Perhaps there shall be forty found there. And he said, I will not do it for forty’s sake.", "words": [[0, 211821], [4, 211937], [7, 212077], [13, 212357], [16, 212597], [20, 212837], [24, 213077], [31, 213717], [35, 213797], [41, 214530], [49, 214842], [55, 215102], [61, 215282], [64, 215482], [70, 215802], [76, 216122], [83, 216734], [87, 216868], [90, 217008], [96, 218417], [98, 218523], [103, 218643], [107, 218863], [110, 219143], [113, 219283], [117, 219463], [125, 219963]]}, {"verse": 30, "start": 220884, "end": 231173, "text": "And he said to him, Oh let not the Lord be angry, and I will speak: Perhaps there shall thirty be found there. And he said, I will not do it, if I find thirty there.", "words": [[0, 220884], [4, 221010], [7, 221110], [12, 221330], [15, 221530], [20, 222132], [23, 222452], [27, 222532], [31, 222732], [35, 222952], [40, 223072], [43, 223232], [50, 223792], [54, 223872], [56, 223992], [61, 224112], [68, 224801], [76, 225023], [82, 225303], [88, 225553], [95, 225803], [98, 225983], [104, 226203], [111, 226894], [115, 227029], [118, 227169], [124, 228577], [126, 228703], [131, 228883], [135, 229083], [138, 229323], [142, 229763], [145, 229883], [147, 230023], [152, 230323], [159, 230623]]}, {"verse": 31, "start": 231726, "end": 242770, "text": "And he said, Behold now, I have taken upon me to speak to the Lord: Perhaps there shall be twenty found there. And he said, I will not destroy it for twenty’s sake.", "words": [[0, 231726], [4, 231861], [7, 232001], [13, 233409], [20, 233823], [25, 234083], [27, 234323], [32, 234463], [38, 234783], [43, 235063], [46, 235323], [49, 235483], [55, 235743], [58, 235943], [62, 236063], [68, 236689], [76, 236910], [82, 237170], [88, 237370], [91, 237530], [98, 237830], [104, 238130], [111, 238815], [115, 238949], [118, 239089], [124, 240498], [126, 240620], [131, 240740], [135, 240980], [143, 241420], [146, 241660], [150, 241970], [159, 242280]]}, {"verse": 32, "start": 243291, "end": 253163, "text": "And he said, Oh let not the Lord be angry, and I will speak yet but this once: Perhaps ten shall be found there. And he said, I will not destroy it for ten’s sake.", "words": [[0, 243291], [4, 243415], [7, 243535], [13, 243975], [16, 244315], [20, 244415], [24, 244675], [28, 244955], [33, 245195], [36, 245435], [43, 245995], [47, 246075], [49, 246215], [54, 246355], [60, 246595], [64, 247135], [68, 247215], [73, 247435], [79, 248317], [87, 248656], [91, 249056], [97, 249336], [100, 249516], [106, 249796], [113, 250474], [117, 250579], [120, 250699], [126, 250979], [128, 251099], [133, 251259], [137, 251499], [145, 251979], [148, 252159], [152, 252339], [158, 252759]]}, {"verse": 33, "start": 253513, "end": 259550, "text": "And the LORD went his way, as soon as he had left communing with Abraham: and Abraham returned to his place.", "words": [[0, 253513], [4, 253640], [8, 253760], [13, 253960], [18, 254180], [22, 254380], [27, 254700], [30, 254960], [35, 255140], [38, 255260], [41, 255380], [45, 255500], [50, 255660], [60, 256160], [65, 256300], [74, 257423], [78, 257723], [86, 258223], [95, 258623], [98, 258863], [102, 259003]]}]}