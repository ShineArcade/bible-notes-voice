{"book": "MAT", "chapter": 27, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 446421, "verses": [{"verse": 1, "start": 300, "end": 6491, "text": "When the morning was come, all the chief priests and elders of the people took counsel against Jesus to put him to death:", "words": [[0, 300], [5, 449], [9, 569], [17, 809], [21, 1049], [27, 1569], [31, 1829], [35, 2049], [41, 2309], [49, 2689], [53, 2929], [60, 3189], [63, 3429], [67, 3549], [74, 3829], [79, 4069], [87, 4509], [95, 4849], [101, 5269], [104, 5529], [108, 5729], [112, 5869], [115, 6009]]}, {"verse": 2, "start": 6941, "end": 12330, "text": "And when they had bound him, they led him away, and delivered him to Pontius Pilate the governor.", "words": [[0, 6941], [4, 7096], [9, 7276], [14, 7476], [18, 7636], [24, 7976], [29, 8636], [34, 8756], [38, 8976], [42, 9156], [48, 9536], [52, 9976], [62, 10316], [66, 10556], [69, 10676], [77, 11176], [84, 11736], [88, 11816]]}, {"verse": 3, "start": 12780, "end": 22000, "text": "¶ Then Judas, which had betrayed him, when he saw that he was condemned, repented himself, and brought again the thirty pieces of silver to the chief priests and elders,", "words": [[2, 12780], [7, 13023], [14, 13563], [20, 13703], [24, 13863], [33, 14163], [38, 14883], [43, 14983], [46, 15123], [50, 15383], [55, 15563], [58, 15683], [62, 15843], [73, 16743], [82, 17223], [91, 17643], [95, 18043], [103, 18263], [109, 18563], [113, 18763], [120, 19003], [127, 19423], [130, 19643], [137, 20023], [140, 20243], [144, 20383], [150, 20643], [158, 21063], [162, 21343]]}, {"verse": 4, "start": 22450, "end": 29812, "text": "Saying, I have sinned in that I have betrayed the innocent blood. And they said, What is that to us? you see to that.", "words": [[0, 22450], [8, 23288], [10, 23467], [15, 23707], [22, 24127], [25, 24227], [30, 24427], [32, 24567], [37, 24727], [46, 25127], [50, 25407], [59, 25687], [66, 26563], [70, 26712], [75, 26832], [81, 27571], [86, 27711], [89, 27811], [94, 28011], [97, 28211], [101, 28936], [105, 29059], [109, 29239], [112, 29379]]}, {"verse": 5, "start": 30162, "end": 35411, "text": "And he cast down the pieces of silver in the temple, and departed, and went and hanged himself.", "words": [[0, 30162], [4, 30283], [7, 30363], [12, 30643], [17, 30923], [21, 31083], [28, 31363], [31, 31583], [38, 31983], [41, 32203], [45, 32303], [53, 32643], [57, 33183], [67, 33643], [71, 34183], [76, 34383], [80, 34583], [87, 34883]]}, {"verse": 6, "start": 35861, "end": 42966, "text": "And the chief priests took the silver pieces, and said, It is not lawful to put them into the treasury, because it is the price of blood.", "words": [[0, 35861], [4, 36000], [8, 36080], [14, 36300], [22, 36700], [27, 37060], [31, 37240], [38, 37520], [46, 38000], [50, 38280], [56, 38960], [59, 39076], [62, 39196], [66, 39396], [73, 39876], [76, 40036], [80, 40236], [85, 40396], [90, 40596], [94, 40716], [104, 41136], [112, 41756], [115, 41956], [118, 42056], [122, 42156], [128, 42436], [131, 42596]]}, {"verse": 7, "start": 43317, "end": 48297, "text": "And they took counsel, and bought with them the potter’s field, to bury strangers in.", "words": [[0, 43317], [4, 43470], [9, 43570], [14, 43810], [23, 44310], [27, 44950], [34, 45270], [39, 45490], [44, 45690], [48, 45850], [57, 46310], [64, 46630], [67, 47050], [72, 47330], [82, 47810]]}, {"verse": 8, "start": 48747, "end": 52590, "text": "Therefore that field was called, The field of blood, to this day.", "words": [[0, 48747], [10, 49444], [15, 49644], [21, 49944], [25, 50164], [33, 50504], [37, 50824], [43, 51104], [46, 51224], [53, 51564], [56, 51924], [61, 52124]]}, {"verse": 9, "start": 53040, "end": 65694, "text": "Then was fulfilled that which was spoken by Jeremy the prophet, saying, And they took the thirty pieces of silver, the price of him that was valued, whom they of the children of Israel did value;", "words": [[0, 53040], [5, 53291], [9, 53591], [19, 54011], [24, 54491], [30, 54791], [34, 54971], [41, 55391], [44, 55691], [51, 56131], [55, 56391], [64, 56771], [72, 57511], [76, 57831], [81, 57971], [86, 58171], [90, 58351], [97, 58611], [104, 59031], [107, 59231], [115, 59991], [119, 60091], [125, 60411], [128, 60571], [132, 60751], [137, 60911], [141, 61091], [149, 63165], [154, 63301], [159, 63461], [162, 63601], [166, 63721], [175, 64101], [178, 64281], [185, 64661], [189, 64941]]}, {"verse": 10, "start": 66144, "end": 69379, "text": "And gave them for the potter’s field, as the Lord appointed me.", "words": [[0, 66144], [4, 66286], [9, 66486], [14, 66706], [18, 66866], [22, 66966], [31, 67426], [38, 68106], [41, 68226], [45, 68366], [50, 68546], [60, 68926]]}, {"verse": 11, "start": 69829, "end": 78616, "text": "And Jesus stood before the governor: and the governor asked him, saying, Are you the King of the Jews? And Jesus said to him, You say.", "words": [[0, 69829], [4, 69954], [10, 70254], [16, 70654], [23, 71014], [27, 71254], [37, 72182], [41, 72462], [45, 72562], [54, 72822], [60, 73262], [65, 73502], [73, 74362], [77, 74497], [81, 74637], [85, 74777], [90, 74977], [93, 75137], [97, 75237], [103, 76156], [107, 76307], [113, 76607], [118, 77007], [121, 77207], [126, 77759], [130, 78039]]}, {"verse": 12, "start": 78966, "end": 83480, "text": "And when he was accused of the chief priests and elders, he answered nothing.", "words": [[0, 78966], [4, 79097], [9, 79257], [12, 79417], [16, 79557], [24, 79897], [27, 80177], [31, 80297], [37, 80537], [45, 81017], [49, 81397], [57, 82317], [60, 82497], [69, 82857]]}, {"verse": 13, "start": 83930, "end": 88425, "text": "Then said Pilate to him, Do you not hear how many things they witness against you?", "words": [[0, 83930], [5, 84116], [10, 84396], [17, 84936], [20, 85096], [25, 85722], [28, 85866], [32, 85986], [36, 86146], [41, 86446], [45, 86626], [50, 86826], [57, 87186], [62, 87346], [70, 87646], [78, 88026]]}, {"verse": 14, "start": 88775, "end": 93142, "text": "And he answered him to never a word; so that the governor marvelled greatly.", "words": [[0, 88775], [4, 88906], [7, 89026], [16, 89366], [20, 89586], [23, 89726], [29, 90046], [31, 90286], [37, 91084], [40, 91344], [45, 91544], [49, 91664], [58, 92114], [68, 92564]]}, {"verse": 15, "start": 93592, "end": 99190, "text": "Now at that feast the governor was accustomed to release to the people a prisoner, whom they would.", "words": [[0, 93592], [4, 93820], [7, 94040], [12, 94200], [18, 94940], [22, 95060], [31, 95340], [35, 95620], [46, 95960], [49, 96340], [57, 96680], [60, 96960], [64, 97100], [71, 97300], [73, 97500], [83, 97900], [88, 98420], [93, 98660]]}, {"verse": 16, "start": 99640, "end": 103419, "text": "And they had then a notable prisoner, called Barabbas.", "words": [[0, 99640], [4, 99788], [9, 99948], [13, 100288], [18, 100648], [20, 100888], [28, 101228], [38, 101828], [45, 102408]]}, {"verse": 17, "start": 103869, "end": 111893, "text": "Therefore when they were gathered together, Pilate said to them, Whom will you that I release to you? Barabbas, or Jesus which is called Christ?", "words": [[0, 103869], [10, 104554], [15, 104654], [20, 104794], [25, 104934], [34, 105234], [44, 105864], [51, 106494], [56, 106694], [59, 106874], [65, 107500], [70, 107742], [75, 107922], [79, 108042], [84, 108242], [86, 108362], [94, 108642], [97, 108882], [102, 109751], [112, 110061], [115, 110201], [121, 110741], [127, 110861], [130, 111021], [137, 111261]]}, {"verse": 18, "start": 112243, "end": 114713, "text": "For he knew that for envy they had delivered him.", "words": [[0, 112243], [4, 112345], [7, 112505], [12, 112745], [17, 112985], [21, 113205], [26, 113605], [31, 113785], [35, 113945], [45, 114305]]}, {"verse": 19, "start": 115163, "end": 125426, "text": "¶ When he was set down on the judgment seat, his wife sent to him, saying, Have you nothing to do with that just man: for I have suffered many things this day in a dream because of him.", "words": [[2, 115163], [7, 115291], [10, 115411], [14, 115551], [18, 115771], [23, 116051], [26, 116211], [30, 116331], [39, 116631], [45, 117211], [49, 117371], [54, 117611], [59, 117931], [62, 118111], [67, 118311], [75, 119116], [80, 119236], [84, 119356], [92, 119656], [95, 119936], [98, 120116], [103, 120316], [108, 120456], [113, 120676], [118, 121723], [122, 121826], [124, 121986], [129, 122126], [138, 122466], [143, 122886], [150, 123246], [155, 123486], [159, 123746], [162, 123926], [164, 124046], [170, 124366], [178, 124726], [181, 124986]]}, {"verse": 20, "start": 125776, "end": 132265, "text": "But the chief priests and elders persuaded the multitude that they should ask Barabbas, and destroy Jesus.", "words": [[0, 125776], [4, 125876], [8, 125996], [14, 126256], [22, 126716], [26, 126996], [33, 127336], [43, 127916], [47, 128256], [57, 128716], [62, 129096], [67, 129276], [74, 129456], [78, 129736], [88, 130496], [92, 130996], [100, 131416]]}, {"verse": 21, "start": 132715, "end": 139176, "text": "The governor answered and said to them, Whether of the two will you that I release to you? They said, Barabbas.", "words": [[0, 132715], [4, 132799], [13, 133099], [22, 133639], [26, 133839], [31, 134059], [34, 134239], [40, 134926], [48, 135112], [51, 135292], [55, 135412], [59, 135652], [64, 135852], [68, 136012], [73, 136212], [75, 136352], [83, 136712], [86, 136992], [91, 137568], [96, 137726], [102, 138808]]}, {"verse": 22, "start": 139526, "end": 148491, "text": "Pilate says to them, What shall I do then with Jesus which is called Christ? They all say to him, Let him be crucified.", "words": [[0, 139716], [7, 139906], [12, 140266], [15, 140566], [21, 141229], [26, 141348], [32, 141568], [34, 141728], [37, 141948], [42, 142148], [47, 142368], [53, 142668], [59, 142948], [62, 143068], [69, 143288], [77, 144368], [82, 144476], [86, 144716], [90, 144996], [93, 145136], [98, 147275], [102, 147444], [106, 147604], [109, 147724]]}, {"verse": 23, "start": 148841, "end": 155733, "text": "And the governor said, Why, what evil has he done? But they cried out the more, saying, Let him be crucified.", "words": [[0, 148841], [4, 148959], [8, 149039], [17, 149319], [23, 150181], [28, 150427], [33, 150687], [38, 150887], [42, 151127], [45, 151247], [51, 151934], [55, 152036], [60, 152176], [66, 152516], [70, 152816], [74, 153016], [80, 153556], [88, 154517], [92, 154686], [96, 154846], [99, 154966]]}, {"verse": 24, "start": 156083, "end": 168219, "text": "¶ When Pilate saw that he could prevail nothing, but that rather a tumult was made, he took water, and washed his hands before the multitude, saying, I am innocent of the blood of this just person: you see to it.", "words": [[2, 156083], [7, 156233], [14, 156713], [18, 156973], [23, 157173], [26, 157273], [32, 157433], [40, 157813], [49, 158633], [53, 158713], [58, 158893], [65, 159173], [67, 159413], [74, 159793], [78, 160013], [84, 160733], [87, 160833], [92, 161033], [99, 161473], [103, 162053], [110, 162353], [114, 162573], [120, 162893], [127, 163213], [131, 163413], [142, 164029], [150, 164844], [152, 165041], [155, 165161], [164, 165521], [167, 165761], [171, 165861], [177, 166061], [180, 166181], [185, 166341], [190, 166521], [198, 167373], [202, 167499], [206, 167759], [209, 167979]]}, {"verse": 25, "start": 168569, "end": 173610, "text": "Then answered all the people, and said, His blood be on us, and on our children.", "words": [[0, 168569], [5, 168798], [14, 169278], [18, 169598], [22, 169778], [30, 170118], [34, 170598], [40, 171378], [44, 171504], [50, 171784], [53, 172024], [56, 172204], [60, 172464], [64, 172804], [67, 172924], [71, 173044]]}, {"verse": 26, "start": 173960, "end": 179572, "text": "¶ Then released he Barabbas to them: and when he had scourged Jesus, he delivered him to be crucified.", "words": [[2, 173960], [7, 174127], [16, 174480], [19, 174834], [28, 175187], [31, 175347], [37, 175877], [41, 175997], [46, 176157], [49, 176337], [53, 176477], [62, 176977], [69, 177797], [72, 177917], [82, 178237], [86, 178477], [89, 178597], [92, 178737]]}, {"verse": 27, "start": 180022, "end": 187054, "text": "Then the soldiers of the governor took Jesus into the common hall, and gathered to him the whole band of soldiers.", "words": [[0, 180022], [5, 180307], [9, 180547], [18, 180947], [21, 181227], [25, 181347], [34, 181647], [39, 181987], [45, 182447], [50, 182827], [54, 182987], [61, 183347], [67, 183747], [71, 184407], [80, 184807], [83, 185047], [87, 185227], [91, 185427], [97, 185687], [102, 186067], [105, 186227]]}, {"verse": 28, "start": 187504, "end": 191098, "text": "And they stripped him, and put on him a scarlet robe.", "words": [[0, 187504], [4, 187951], [9, 188111], [18, 188411], [23, 188731], [27, 189251], [31, 189491], [34, 189671], [38, 189891], [40, 190031], [48, 190551]]}, {"verse": 29, "start": 191548, "end": 202729, "text": "¶ And when they had platted a crown of thorns, they put it upon his head, and a reed in his right hand: and they bowed the knee before him, and mocked him, saying, Hail, King of the Jews!", "words": [[2, 191548], [6, 191696], [11, 191856], [16, 192036], [20, 192366], [28, 192696], [30, 192776], [36, 193076], [39, 193316], [47, 194256], [52, 194416], [56, 194636], [59, 194776], [64, 195016], [68, 195276], [74, 195616], [78, 196076], [80, 196196], [85, 196636], [88, 196736], [92, 196896], [98, 197116], [104, 198009], [108, 198152], [113, 198292], [119, 198712], [123, 198792], [128, 199012], [135, 199392], [140, 199692], [144, 199912], [151, 200372], [156, 200592], [164, 201569], [170, 201752], [175, 201992], [178, 202152], [182, 202252]]}, {"verse": 30, "start": 203079, "end": 206991, "text": "And they spit upon him, and took the reed, and struck him on the head.", "words": [[0, 203079], [4, 203231], [9, 203351], [14, 203611], [19, 203871], [24, 204211], [28, 204711], [33, 204891], [37, 205091], [43, 205531], [47, 205831], [54, 206111], [58, 206271], [61, 206411], [65, 206571]]}, {"verse": 31, "start": 207441, "end": 214837, "text": "And after that they had mocked him, they took the robe off from him, and put his own clothing on him, and led him away to crucify him.", "words": [[0, 207441], [4, 207573], [10, 207853], [15, 208073], [20, 208293], [24, 208433], [31, 208853], [36, 209333], [41, 209433], [46, 209633], [50, 209813], [55, 210073], [59, 210273], [64, 210493], [69, 210673], [73, 211133], [77, 211313], [81, 211493], [85, 211653], [94, 212093], [97, 212353], [102, 212633], [106, 213013], [110, 213193], [114, 213373], [119, 213673], [122, 213893], [130, 214453]]}, {"verse": 32, "start": 215287, "end": 222071, "text": "And as they came out, they found a man of Cyrene, Simon by name: him they compelled to bear his cross.", "words": [[0, 215287], [4, 215477], [7, 215637], [12, 215777], [17, 215977], [22, 216737], [27, 216837], [33, 217097], [35, 217237], [39, 217437], [42, 217987], [50, 218537], [56, 218977], [59, 219337], [65, 220105], [69, 220547], [74, 220667], [84, 220967], [87, 221187], [92, 221307], [96, 221467]]}, {"verse": 33, "start": 222521, "end": 226944, "text": "And when they were come to a place called Golgotha, that is to say, a place of a skull,", "words": [[0, 222521], [4, 222667], [9, 222807], [14, 222967], [19, 223107], [24, 223327], [27, 223507], [29, 223607], [35, 223827], [42, 224167], [52, 225267], [57, 225347], [60, 225507], [63, 225627], [68, 225847], [70, 225947], [76, 226147], [79, 226327], [81, 226427]]}, {"verse": 34, "start": 227394, "end": 232656, "text": "¶ They gave him vinegar to drink mingled with gall: and when he had tasted of it, he would not drink.", "words": [[2, 227394], [7, 227493], [12, 227713], [16, 227913], [24, 228273], [27, 228553], [33, 228773], [41, 229273], [46, 229433], [52, 230197], [56, 230329], [61, 230489], [64, 230689], [68, 230809], [75, 231169], [78, 231429], [82, 231629], [85, 231729], [91, 231869], [95, 232089]]}, {"verse": 35, "start": 233106, "end": 244724, "text": "And they crucified him, and parted his garments, casting lots: that it might be fulfilled which was spoken by the prophet, They parted my garments among them, and upon my vesture did they cast lots.", "words": [[0, 233106], [4, 233232], [9, 233332], [19, 233752], [24, 234192], [28, 234412], [35, 234812], [39, 234932], [49, 235332], [57, 235872], [63, 236919], [68, 237051], [71, 237131], [77, 237311], [80, 237491], [90, 237911], [96, 238331], [100, 238511], [107, 238911], [110, 239211], [114, 239331], [123, 240171], [128, 240351], [135, 240771], [138, 240931], [147, 241291], [153, 241651], [159, 242171], [163, 242351], [168, 242611], [171, 242891], [179, 243411], [183, 243571], [188, 243751], [193, 244011]]}, {"verse": 36, "start": 245174, "end": 247064, "text": "And sitting down they watched him there;", "words": [[0, 245174], [4, 245302], [12, 245562], [17, 245922], [22, 246122], [30, 246422], [34, 246622]]}, {"verse": 37, "start": 247514, "end": 252617, "text": "And set up over his head his accusation written, THIS IS JESUS THE KING OF THE JEWS.", "words": [[0, 247514], [4, 247630], [8, 247870], [11, 248050], [16, 248250], [20, 248510], [25, 248750], [29, 248930], [40, 249710], [49, 250430], [54, 250670], [57, 250830], [63, 251430], [67, 251530], [72, 251730], [75, 251890], [79, 252030]]}, {"verse": 38, "start": 253067, "end": 258319, "text": "Then were there two thieves crucified with him, one on the right hand, and another on the left.", "words": [[0, 253067], [5, 253299], [10, 253479], [16, 253659], [20, 253959], [28, 254339], [38, 254839], [43, 255359], [48, 255899], [52, 256059], [55, 256219], [59, 256319], [65, 256539], [71, 256819], [75, 257219], [83, 257519], [86, 257739], [90, 257859]]}, {"verse": 39, "start": 258769, "end": 262699, "text": "¶ And they that passed by reviled him, wagging their heads,", "words": [[2, 258769], [6, 258894], [11, 259074], [16, 259234], [23, 259594], [26, 259854], [34, 260434], [39, 260934], [47, 261374], [53, 261554]]}, {"verse": 40, "start": 263149, "end": 270973, "text": "And saying, You that destroy the temple, and build it in three days, save yourself. If you be the Son of God, come down from the cross.", "words": [[0, 263149], [4, 263526], [12, 264181], [16, 264321], [21, 264481], [29, 264841], [33, 265001], [41, 265301], [45, 265801], [51, 266081], [54, 266221], [57, 266321], [63, 266581], [69, 267141], [74, 267421], [84, 268292], [87, 268429], [91, 268529], [94, 268669], [98, 268809], [102, 269029], [105, 269109], [110, 269749], [115, 269829], [120, 270129], [125, 270329], [129, 270469]]}, {"verse": 41, "start": 271323, "end": 276199, "text": "Likewise also the chief priests mocking him, with the scribes and elders, said,", "words": [[0, 271323], [9, 271650], [14, 272130], [18, 272350], [24, 272630], [32, 273110], [40, 273570], [45, 273890], [50, 274450], [54, 274570], [62, 275170], [66, 275270], [74, 275570]]}, {"verse": 42, "start": 276449, "end": 283618, "text": "He saved others; himself he cannot save. If he be the King of Israel, let him now come down from the cross, and we will believe him.", "words": [[0, 276449], [3, 276569], [9, 276869], [17, 277795], [25, 278155], [28, 278315], [35, 278515], [41, 279321], [44, 279464], [47, 279544], [50, 279644], [54, 279784], [59, 279984], [62, 280144], [70, 280864], [74, 281004], [78, 281144], [82, 281304], [87, 281504], [92, 281744], [97, 281904], [101, 282044], [108, 282324], [112, 282724], [115, 282864], [120, 283004], [128, 283304]]}, {"verse": 43, "start": 284068, "end": 290197, "text": "He trusted in God; let him deliver him now, if he will have him: for he said, I am the Son of God.", "words": [[0, 284068], [3, 284133], [11, 284453], [14, 284693], [19, 285353], [23, 285545], [27, 285725], [35, 286025], [39, 286225], [44, 286785], [47, 286945], [50, 287065], [55, 287225], [60, 287465], [65, 288037], [69, 288144], [72, 288284], [78, 288824], [80, 289144], [83, 289324], [87, 289424], [91, 289664], [94, 289784]]}, {"verse": 44, "start": 290547, "end": 295148, "text": "The thieves also, which were crucified with him, cast the same in his teeth.", "words": [[0, 290547], [4, 290641], [12, 290941], [18, 291621], [24, 291801], [29, 291941], [39, 292401], [44, 292841], [49, 293441], [54, 293681], [58, 293941], [63, 294221], [66, 294481], [70, 294641]]}, {"verse": 45, "start": 295598, "end": 300195, "text": "Now from the sixth hour there was darkness over all the land to the ninth hour.", "words": [[0, 295598], [4, 295824], [9, 296064], [13, 296204], [19, 296504], [24, 296964], [30, 297244], [34, 297424], [43, 297884], [48, 298284], [52, 298584], [56, 298744], [61, 299024], [64, 299244], [68, 299364], [74, 299644]]}, {"verse": 46, "start": 300645, "end": 311371, "text": "And about the ninth hour Jesus cried with a loud voice, saying, Eli, Eli, lama sabachthani? that is to say, My God, my God, why have you forsaken me?", "words": [[0, 300645], [4, 300772], [10, 300972], [14, 301132], [20, 301452], [25, 301832], [31, 302072], [37, 302612], [42, 302852], [44, 302992], [49, 303292], [56, 303872], [64, 304988], [69, 305348], [74, 305708], [79, 306368], [90, 307774], [92, 308470], [97, 308470], [100, 308470], [103, 308470], [108, 308470], [111, 308734], [116, 309374], [119, 309534], [124, 310094], [128, 310234], [133, 310454], [137, 310554], [146, 311014]]}, {"verse": 47, "start": 311821, "end": 316368, "text": "Some of them that stood there, when they heard that, said, This man calls for Elias.", "words": [[0, 311821], [5, 312028], [8, 312208], [13, 312368], [18, 312528], [24, 312788], [31, 313168], [36, 313288], [41, 313448], [47, 313688], [53, 314068], [59, 314711], [64, 314910], [68, 315170], [74, 315490], [78, 315730]]}, {"verse": 48, "start": 316718, "end": 323650, "text": "And immediately one of them ran, and took a sponge, and filled it with vinegar, and put it on a reed, and gave him to drink.", "words": [[0, 316718], [4, 316846], [16, 317186], [20, 317706], [23, 317826], [28, 318006], [33, 318366], [37, 318706], [42, 318866], [44, 318986], [52, 319426], [56, 319786], [63, 320066], [66, 320226], [71, 320406], [80, 320766], [84, 321266], [88, 321466], [91, 321606], [94, 321726], [96, 321826], [102, 322226], [106, 322546], [111, 322766], [115, 322986], [118, 323126]]}, {"verse": 49, "start": 324100, "end": 328082, "text": "The rest said, Let be, let us see whether Elias will come to save him.", "words": [[0, 324100], [4, 324204], [9, 324404], [15, 325149], [19, 325369], [23, 325949], [27, 326129], [30, 326249], [34, 326409], [42, 326609], [48, 327089], [53, 327229], [58, 327409], [61, 327549], [66, 327769]]}, {"verse": 50, "start": 328432, "end": 332643, "text": "¶ Jesus, when he had cried again with a loud voice, yielded up his spirit.", "words": [[2, 328432], [9, 328692], [14, 329012], [17, 329152], [21, 329272], [27, 329612], [33, 329972], [38, 330232], [40, 330352], [45, 330632], [52, 331312], [60, 331772], [63, 331912], [67, 332052]]}, {"verse": 51, "start": 333093, "end": 340712, "text": "And, behold, the veil of the temple was torn in two from the top to the bottom; and the earth did quake, and the rocks were split;", "words": [[0, 333093], [5, 333239], [13, 333559], [17, 333879], [22, 334139], [25, 334279], [29, 334419], [36, 334739], [40, 335019], [45, 335359], [48, 335559], [52, 335819], [57, 336099], [61, 336239], [65, 336519], [68, 336739], [72, 336839], [80, 337654], [84, 337802], [88, 337902], [94, 338142], [98, 338462], [105, 339382], [109, 339482], [113, 339582], [119, 339902], [124, 340102]]}, {"verse": 52, "start": 341162, "end": 345589, "text": "And the graves were opened; and many bodies of the saints which slept arose,", "words": [[0, 341162], [4, 341288], [8, 341388], [15, 341728], [20, 342008], [28, 342914], [32, 343050], [37, 343250], [44, 343590], [47, 343850], [51, 344010], [58, 344290], [64, 344550], [70, 344850]]}, {"verse": 53, "start": 346039, "end": 352516, "text": "And came out of the graves after his resurrection, and went into the holy city, and appeared to many.", "words": [[0, 346039], [4, 346147], [9, 346387], [13, 346647], [16, 346747], [20, 346847], [27, 347247], [33, 347667], [37, 347887], [51, 349167], [55, 349427], [60, 349627], [65, 349867], [69, 350047], [74, 350267], [80, 351167], [84, 351347], [93, 351667], [96, 351947]]}, {"verse": 54, "start": 352966, "end": 363393, "text": "Now when the centurion, and they that were with him, watching Jesus, saw the earthquake, and those things that were done, they feared greatly, saying, Truly this was the Son of God.", "words": [[0, 352966], [4, 353446], [9, 353586], [13, 353726], [24, 354506], [28, 354606], [33, 354766], [38, 354926], [43, 355046], [48, 355306], [53, 355586], [62, 355826], [69, 356866], [73, 357086], [77, 357246], [89, 357646], [93, 357926], [99, 358086], [106, 358366], [111, 358566], [116, 358686], [122, 359506], [127, 359606], [134, 359926], [143, 360326], [151, 361623], [157, 362140], [162, 362340], [166, 362500], [170, 362640], [174, 362820], [177, 362960]]}, {"verse": 55, "start": 363743, "end": 370358, "text": "And many women were there beholding afar off, which followed Jesus from Galilee, ministering to him:", "words": [[0, 363743], [4, 363900], [9, 364140], [15, 364520], [20, 364760], [26, 365020], [36, 365720], [41, 365980], [46, 366900], [52, 367080], [61, 367480], [67, 367920], [72, 368280], [81, 368900], [93, 369800], [96, 369940]]}, {"verse": 56, "start": 370808, "end": 377347, "text": "Among which was Mary Magdalene, and Mary the mother of James and Joses, and the mother of Zebedee’s children.", "words": [[0, 370808], [6, 371051], [12, 371371], [16, 371571], [21, 371851], [32, 372931], [36, 372991], [41, 373271], [45, 373431], [52, 373651], [55, 373911], [61, 374271], [65, 374791], [72, 375311], [76, 375571], [80, 375671], [87, 375911], [90, 376131], [100, 376751]]}, {"verse": 57, "start": 377797, "end": 384998, "text": "When the even was come, there came a rich man of Arimathæa, named Joseph, who also himself was Jesus’ disciple:", "words": [[0, 377797], [5, 377948], [9, 378108], [14, 378288], [18, 378568], [24, 379048], [30, 379108], [35, 379308], [37, 379488], [42, 379728], [46, 380048], [49, 380628], [60, 381208], [66, 381408], [74, 382348], [78, 382468], [83, 382788], [91, 383168], [95, 383648], [102, 384228]]}, {"verse": 58, "start": 385448, "end": 391198, "text": "He went to Pilate, and begged the body of Jesus. Then Pilate commanded the body to be delivered.", "words": [[0, 385448], [3, 385550], [8, 385730], [11, 385910], [19, 386450], [23, 386630], [30, 386930], [34, 387170], [39, 387470], [42, 387630], [49, 388617], [54, 388837], [61, 389337], [71, 389577], [75, 389917], [80, 390217], [83, 390397], [86, 390557]]}, {"verse": 59, "start": 391648, "end": 396068, "text": "And when Joseph had taken the body, he wrapped it in a clean linen cloth,", "words": [[0, 391648], [4, 391792], [9, 391932], [16, 392272], [20, 392532], [26, 392812], [30, 393012], [36, 393772], [39, 393912], [47, 394272], [50, 394452], [53, 394632], [55, 394712], [61, 395032], [67, 395392]]}, {"verse": 60, "start": 396518, "end": 404054, "text": "And laid it in his own new tomb, which he had hewn out in the rock: and he rolled a great stone to the door of the tomb, and departed.", "words": [[0, 396518], [4, 396667], [9, 396907], [12, 397067], [15, 397207], [19, 397367], [23, 397547], [27, 397827], [33, 398607], [39, 398787], [42, 398927], [46, 399087], [51, 399367], [55, 399527], [58, 399687], [62, 399767], [68, 400531], [72, 400674], [75, 400794], [82, 401014], [84, 401154], [90, 401374], [96, 401754], [99, 401994], [103, 402114], [108, 402354], [111, 402494], [115, 402574], [121, 402894], [125, 403394]]}, {"verse": 61, "start": 404504, "end": 408855, "text": "And there was Mary Magdalene, and the other Mary, sitting over against the tomb.", "words": [[0, 404504], [4, 404656], [10, 404776], [14, 404956], [19, 405236], [30, 405976], [34, 406456], [38, 406576], [44, 406736], [50, 407116], [58, 407436], [63, 407756], [71, 408156], [75, 408356]]}, {"verse": 62, "start": 409305, "end": 415785, "text": "¶ Now the next day, that followed the day of the preparation, the chief priests and Pharisees came together to Pilate,", "words": [[2, 409305], [6, 409475], [10, 409635], [15, 409815], [20, 410355], [25, 410515], [34, 410855], [38, 411075], [42, 411275], [45, 411415], [49, 411515], [62, 412615], [66, 412695], [72, 412955], [80, 413375], [84, 413615], [94, 414335], [99, 414515], [108, 414915], [111, 415378]]}, {"verse": 63, "start": 416235, "end": 423926, "text": "Saying, Sir, we remember that that deceiver said, while he was yet alive, After three days I will rise again.", "words": [[0, 416235], [8, 417848], [13, 418483], [16, 418583], [25, 418983], [30, 419223], [35, 419403], [44, 419863], [50, 420523], [56, 420743], [59, 420923], [63, 421103], [67, 421303], [74, 421963], [80, 422183], [86, 422523], [91, 422783], [93, 423103], [98, 423283], [103, 423543]]}, {"verse": 64, "start": 424376, "end": 436048, "text": "Command therefore that the tomb be made sure until the third day, lest his disciples come by night, and steal him away, and say to the people, He is risen from the dead: so the last error shall be worse than the first.", "words": [[0, 424376], [8, 424581], [18, 425001], [23, 425301], [27, 425421], [32, 425681], [35, 425821], [40, 426021], [45, 426301], [51, 426641], [55, 426861], [61, 427081], [66, 427381], [71, 427941], [75, 428061], [85, 428561], [90, 428861], [93, 429041], [100, 429341], [104, 429681], [110, 429961], [114, 430121], [120, 430401], [124, 430741], [128, 430981], [131, 431121], [135, 431221], [143, 431978], [146, 432054], [149, 432214], [155, 432494], [160, 432734], [164, 432874], [170, 433542], [173, 433637], [177, 433757], [182, 433977], [188, 434237], [194, 434517], [197, 434677], [203, 434997], [208, 435357], [212, 435517]]}, {"verse": 65, "start": 436398, "end": 441162, "text": "Pilate said to them, You have a watch: go your way, make it as sure as you can.", "words": [[0, 436648], [7, 436898], [12, 437098], [15, 437278], [21, 437828], [25, 437933], [30, 438093], [32, 438213], [39, 439057], [42, 439236], [47, 439436], [52, 439976], [57, 440136], [60, 440256], [63, 440336], [68, 440516], [71, 440656], [75, 440756]]}, {"verse": 66, "start": 441512, "end": 446021, "text": "So they went, and made the tomb sure, sealing the stone, and setting a watch.", "words": [[0, 441512], [3, 441632], [8, 441792], [14, 442032], [18, 442212], [23, 442432], [27, 442592], [32, 442892], [38, 443752], [46, 444152], [50, 444412], [57, 444752], [61, 445032], [69, 445292], [71, 445472]]}]}