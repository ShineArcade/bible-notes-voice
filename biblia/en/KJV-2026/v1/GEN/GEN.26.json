{"book": "GEN", "chapter": 26, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 286053, "verses": [{"verse": 1, "start": 300, "end": 9591, "text": "And there was a famine in the land, beside the first famine that was in the days of Abraham. And Isaac went to Abimelech king of the Philistines to Gerar.", "words": [[0, 300], [4, 442], [10, 542], [14, 702], [16, 822], [23, 1182], [26, 1402], [30, 1502], [36, 2042], [43, 2422], [47, 2742], [53, 3002], [60, 3402], [65, 3602], [69, 3762], [72, 3902], [76, 4002], [81, 4262], [84, 4402], [93, 5365], [97, 5745], [103, 6105], [108, 6425], [111, 7005], [121, 7585], [126, 7885], [129, 8065], [133, 8205], [145, 8825], [148, 9208]]}, {"verse": 2, "start": 10041, "end": 16998, "text": "And the LORD appeared to him, and said, Go not down into Egypt; dwell in the land which I shall tell you of:", "words": [[0, 10041], [4, 10185], [8, 10305], [13, 10505], [22, 10865], [25, 11185], [30, 11405], [34, 11885], [40, 12595], [43, 12719], [47, 12939], [52, 13199], [57, 13479], [64, 14638], [70, 14855], [73, 15095], [77, 15195], [82, 15495], [88, 15755], [90, 15895], [96, 16055], [101, 16275], [105, 16455]]}, {"verse": 3, "start": 17448, "end": 29624, "text": "Sojourn in this land, and I will be with you, and will bless you; for to you, and to your seed, I will give all these countries, and I will perform the oath which I swore to Abraham your father;", "words": [[0, 17448], [8, 18001], [11, 18101], [16, 18261], [22, 19001], [26, 19121], [28, 19261], [33, 19381], [36, 19561], [41, 19821], [46, 20001], [50, 20281], [55, 20421], [61, 20661], [66, 21640], [70, 21780], [73, 21960], [78, 22280], [82, 22640], [85, 22840], [90, 23020], [96, 23900], [98, 24040], [103, 24180], [108, 24380], [112, 24760], [118, 24940], [129, 25840], [133, 26000], [135, 26120], [140, 26240], [148, 26580], [152, 26840], [157, 27060], [163, 27340], [165, 27460], [171, 27800], [174, 27980], [182, 28700], [187, 28740]]}, {"verse": 4, "start": 30074, "end": 39258, "text": "And I will make your seed to multiply as the stars of heaven, and will give to your seed all these countries; and in your seed shall all the nations of the earth be blessed;", "words": [[0, 30074], [4, 30214], [6, 30334], [11, 30454], [16, 30654], [21, 30794], [26, 31094], [29, 31254], [38, 31754], [41, 32054], [45, 32154], [51, 32414], [54, 32594], [62, 33234], [66, 33394], [71, 33514], [76, 33714], [79, 33874], [84, 34014], [89, 34294], [93, 34554], [99, 34734], [110, 35978], [114, 36105], [117, 36245], [122, 36385], [127, 36785], [133, 37085], [137, 37345], [141, 37465], [149, 37765], [152, 37985], [156, 38085], [162, 38205], [165, 38405]]}, {"verse": 5, "start": 39708, "end": 45969, "text": "Because that Abraham obeyed my voice, and kept my charge, my commandments, my statutes, and my laws.", "words": [[0, 39708], [8, 39885], [13, 40125], [21, 40545], [28, 41145], [31, 41265], [38, 41725], [42, 42225], [47, 42405], [50, 42565], [58, 43345], [61, 43465], [75, 44165], [78, 44245], [88, 44905], [92, 45005], [95, 45145]]}, {"verse": 6, "start": 46319, "end": 48140, "text": "¶ And Isaac dwelt in Gerar:", "words": [[2, 46319], [6, 46475], [12, 46795], [18, 47295], [21, 47752]]}, {"verse": 7, "start": 48590, "end": 62640, "text": "And the men of the place asked him of his wife; and he said, She is my sister: for he feared to say, She is my wife; lest, said he, the men of the place should kill me for Rebekah; because she was fair to look upon.", "words": [[0, 48590], [4, 48716], [8, 48856], [12, 49016], [15, 49156], [19, 49276], [25, 49516], [31, 49916], [35, 50116], [38, 50256], [42, 50396], [48, 51238], [52, 51402], [55, 51542], [61, 52284], [65, 52448], [68, 52608], [71, 52748], [79, 53614], [83, 53739], [86, 53899], [93, 54159], [96, 54379], [101, 54959], [105, 55279], [108, 55499], [111, 55699], [117, 56576], [123, 57124], [128, 57384], [132, 58184], [136, 58304], [140, 58524], [143, 58664], [147, 58784], [153, 59044], [160, 59284], [165, 59564], [168, 59724], [172, 59944], [181, 60873], [189, 61076], [193, 61316], [197, 61496], [202, 61756], [205, 61916], [210, 62076]]}, {"verse": 8, "start": 63090, "end": 74732, "text": "And it came to pass, when he had been there a long time, that Abimelech king of the Philistines looked out at a window, and saw, and, behold, Isaac was sporting with Rebekah his wife.", "words": [[0, 63090], [4, 63221], [7, 63321], [12, 63481], [15, 63641], [21, 63961], [26, 64261], [29, 64441], [33, 64541], [38, 64721], [44, 64941], [46, 65061], [51, 65281], [57, 66041], [62, 66521], [72, 67001], [77, 67261], [80, 67461], [84, 67581], [96, 68241], [103, 68541], [107, 68781], [110, 68961], [112, 69061], [120, 69361], [124, 69841], [129, 70261], [134, 70981], [142, 72193], [148, 72521], [152, 72781], [161, 73181], [166, 73471], [174, 73761], [178, 74101]]}, {"verse": 9, "start": 75182, "end": 86642, "text": "And Abimelech called Isaac, and said, Behold, of a surety she is your wife: and how did you say, She is my sister? And Isaac said to him, Because I said, Lest I die for her.", "words": [[0, 75182], [4, 75609], [14, 76069], [21, 76349], [28, 76789], [32, 77069], [38, 77807], [46, 78192], [49, 78392], [51, 78512], [58, 79312], [62, 79452], [65, 79592], [70, 79752], [76, 80434], [80, 80570], [84, 80770], [88, 80930], [92, 81030], [97, 81510], [101, 81810], [104, 81990], [107, 82170], [115, 83102], [119, 83232], [125, 83592], [130, 83932], [133, 84152], [138, 84723], [146, 84962], [148, 85182], [154, 85462], [159, 85822], [161, 85942], [165, 86142], [169, 86362]]}, {"verse": 10, "start": 86992, "end": 95243, "text": "And Abimelech said, What is this you have done to us? one of the people might lightly have lain with your wife, and you should have brought guiltiness upon us.", "words": [[0, 86992], [4, 87426], [14, 87896], [20, 88670], [25, 88810], [28, 88970], [33, 89230], [37, 89390], [42, 89490], [47, 89670], [50, 89850], [54, 90627], [58, 90768], [61, 90868], [65, 91008], [72, 91248], [78, 91468], [86, 91848], [91, 92088], [96, 92328], [101, 92508], [106, 92648], [112, 92948], [116, 93408], [120, 93528], [127, 93668], [132, 93768], [140, 93968], [151, 94508], [156, 94788]]}, {"verse": 11, "start": 95593, "end": 102894, "text": "And Abimelech charged all his people, saying, He that touches this man or his wife shall surely be put to death.", "words": [[0, 95593], [4, 96031], [14, 96501], [22, 96881], [26, 97301], [30, 97501], [38, 98341], [46, 99614], [49, 99798], [54, 99998], [62, 100338], [67, 100618], [71, 100898], [74, 101118], [78, 101278], [83, 101578], [89, 101838], [96, 102178], [99, 102318], [103, 102478], [106, 102618]]}, {"verse": 12, "start": 103244, "end": 109811, "text": "Then Isaac sowed in that land, and received in the same year a hundredfold: and the LORD blessed him.", "words": [[0, 103244], [5, 103530], [11, 103970], [17, 104510], [20, 104630], [25, 104810], [31, 105190], [35, 105810], [44, 106230], [47, 106490], [51, 106610], [56, 106870], [61, 107230], [63, 107510], [76, 108617], [80, 108739], [84, 108859], [89, 109079], [97, 109399]]}, {"verse": 13, "start": 110261, "end": 115290, "text": "And the man grew great, and went forward, and grew until he became very great:", "words": [[0, 110261], [4, 110388], [8, 110488], [12, 110728], [17, 111008], [24, 111388], [28, 111828], [33, 112028], [42, 112468], [46, 113148], [51, 113448], [57, 113748], [60, 113988], [67, 114368], [72, 114728]]}, {"verse": 14, "start": 115740, "end": 122690, "text": "For he had possession of flocks, and possession of herds, and great store of servants: and the Philistines envied him.", "words": [[0, 115740], [4, 115863], [7, 116083], [11, 116263], [22, 116703], [25, 116943], [33, 117583], [37, 117983], [48, 118383], [51, 118643], [58, 119223], [62, 119403], [68, 119663], [74, 120023], [77, 120183], [87, 121219], [91, 121341], [95, 121441], [107, 122041], [114, 122421]]}, {"verse": 15, "start": 123140, "end": 132185, "text": "For all the wells which his father’s servants had dug in the days of Abraham his father, the Philistines had stopped them, and filled them with earth.", "words": [[0, 123140], [4, 123249], [8, 123569], [12, 123789], [18, 124129], [24, 124529], [28, 124729], [37, 125309], [46, 125649], [50, 125909], [54, 126189], [57, 126429], [61, 126509], [66, 126809], [69, 126989], [77, 127429], [81, 127769], [89, 128749], [93, 128829], [105, 129489], [109, 129689], [117, 130029], [123, 130409], [127, 130929], [134, 131209], [139, 131489], [144, 131689]]}, {"verse": 16, "start": 132635, "end": 137454, "text": "And Abimelech said to Isaac, Go from us; for you are much mightier than we.", "words": [[0, 132635], [4, 133052], [14, 133512], [19, 133752], [22, 133972], [29, 134796], [32, 134972], [37, 135172], [41, 135869], [45, 135972], [49, 136112], [53, 136232], [58, 136492], [67, 136952], [72, 137132]]}, {"verse": 17, "start": 137804, "end": 143517, "text": "¶ And Isaac departed from there, and pitched his tent in the valley of Gerar, and dwelt there.", "words": [[2, 137804], [6, 137950], [12, 138250], [21, 138750], [26, 139050], [33, 139390], [37, 139930], [45, 140210], [49, 140450], [54, 140710], [57, 140910], [61, 141030], [68, 141330], [71, 141680], [78, 142030], [82, 142570], [88, 142950]]}, {"verse": 18, "start": 143967, "end": 156605, "text": "And Isaac dug again the wells of water, which they had dug in the days of Abraham his father; for the Philistines had stopped them after the death of Abraham: and he called their names after the names by which his father had called them.", "words": [[0, 143967], [4, 144100], [10, 144420], [14, 144700], [20, 145060], [24, 145240], [30, 145480], [33, 145720], [40, 146060], [46, 146320], [51, 146520], [55, 146680], [59, 146900], [62, 147060], [66, 147140], [71, 147380], [74, 147540], [82, 147980], [86, 148300], [94, 149155], [98, 149490], [102, 149610], [114, 150230], [118, 150390], [126, 150630], [131, 150870], [137, 151090], [141, 151270], [147, 151510], [150, 151710], [159, 152828], [163, 152966], [166, 153086], [173, 153326], [179, 153546], [185, 153886], [191, 154306], [195, 154486], [201, 154786], [204, 155046], [210, 155286], [214, 155446], [221, 155766], [225, 155966], [232, 156266]]}, {"verse": 19, "start": 157055, "end": 161352, "text": "And Isaac’s servants dug in the valley, and found there a well of springing water.", "words": [[0, 157055], [4, 157181], [12, 157701], [21, 158041], [25, 158361], [28, 158541], [32, 158641], [40, 158961], [44, 159481], [50, 159761], [56, 159981], [58, 160081], [63, 160221], [66, 160381], [76, 160801]]}, {"verse": 20, "start": 161802, "end": 171570, "text": "And the herdmen of Gerar did strive with Isaac’s herdmen, saying, The water is ours: and he called the name of the well Esek; because they strove with him.", "words": [[0, 161802], [4, 161956], [8, 162206], [16, 162456], [19, 162796], [25, 163136], [29, 163296], [36, 163716], [41, 163996], [49, 164566], [58, 165136], [66, 166040], [70, 166145], [76, 166425], [79, 166705], [85, 167691], [89, 167819], [92, 167919], [99, 168159], [103, 168359], [108, 168639], [111, 168799], [115, 168919], [120, 169382], [126, 170080], [134, 170278], [139, 170498], [146, 170978], [151, 171118]]}, {"verse": 21, "start": 172020, "end": 177264, "text": "And they dug another well, and strove for that also: and he called the name of it Sitnah.", "words": [[0, 172020], [4, 172165], [9, 172265], [13, 172505], [21, 172785], [27, 173145], [31, 173445], [38, 173885], [42, 173985], [47, 174165], [53, 175071], [57, 175411], [60, 175531], [67, 175791], [71, 175991], [76, 176271], [79, 176622], [82, 176973]]}, {"verse": 22, "start": 177714, "end": 190158, "text": "And he removed from there, and dug another well; and for that they strove not: and he called the name of it Rehoboth; and he said, For now the LORD has made room for us, and we shall be fruitful in the land.", "words": [[0, 177714], [4, 177862], [7, 177942], [15, 178282], [20, 178522], [27, 178782], [31, 179302], [35, 179522], [43, 179782], [49, 180576], [53, 180675], [57, 180815], [62, 181115], [67, 181215], [74, 181655], [79, 182417], [83, 182525], [86, 182625], [93, 182865], [97, 183025], [102, 183245], [105, 183365], [108, 183465], [118, 184521], [122, 184803], [125, 184903], [131, 185601], [135, 185699], [139, 185999], [143, 186239], [148, 186499], [152, 186759], [157, 187039], [162, 187339], [166, 187599], [170, 188059], [174, 188339], [177, 188559], [183, 188819], [186, 188959], [195, 189319], [198, 189639], [202, 189739]]}, {"verse": 23, "start": 190508, "end": 192742, "text": "And he went up from there to Beer-sheba.", "words": [[0, 190508], [4, 190634], [7, 190734], [12, 190914], [15, 191034], [20, 191274], [26, 191574], [29, 191774]]}, {"verse": 24, "start": 193192, "end": 204498, "text": "And the LORD appeared to him the same night, and said, I am the God of Abraham your father: fear not, for I am with you, and will bless you, and multiply your seed for my servant Abraham’s sake.", "words": [[0, 193192], [4, 193298], [8, 193418], [13, 193658], [22, 193958], [25, 194218], [29, 194358], [33, 194538], [38, 194778], [45, 195098], [49, 195538], [55, 196240], [57, 196412], [60, 196512], [64, 196612], [68, 196832], [71, 196952], [79, 197632], [84, 197672], [92, 198793], [97, 198941], [102, 199481], [106, 199581], [108, 199741], [111, 199861], [116, 200061], [121, 200281], [125, 200521], [130, 200661], [136, 200901], [141, 201521], [145, 201621], [154, 202061], [159, 202281], [164, 202561], [168, 202741], [171, 202881], [179, 203141], [189, 203881]]}, {"verse": 25, "start": 204848, "end": 212166, "text": "And he built an altar there, and called upon the name of the LORD, and pitched his tent there: and there Isaac’s servants dug a well.", "words": [[0, 204848], [4, 204977], [7, 205077], [13, 205317], [16, 205457], [22, 205777], [29, 206457], [33, 206637], [40, 206897], [45, 207137], [49, 207317], [54, 207557], [57, 207717], [61, 207837], [67, 208457], [71, 208517], [79, 208777], [83, 209037], [88, 209297], [95, 210081], [99, 210274], [105, 210508], [113, 210741], [122, 211301], [126, 211601], [128, 211741]]}, {"verse": 26, "start": 212616, "end": 219722, "text": "¶ Then Abimelech went to him from Gerar, and Ahuzzath one of his friends, and Phichol the chief captain of his army.", "words": [[2, 212616], [7, 213024], [17, 213464], [22, 213624], [25, 213844], [29, 214004], [34, 214584], [41, 215164], [45, 215554], [54, 215944], [58, 216144], [61, 216264], [65, 216404], [74, 217324], [78, 217684], [86, 218044], [90, 218204], [96, 218444], [104, 218844], [107, 219084], [111, 219244]]}, {"verse": 27, "start": 220172, "end": 225988, "text": "And Isaac said to them, Why do you come to me, seeing you hate me, and have sent me away from you?", "words": [[0, 220172], [4, 220339], [10, 220699], [15, 221039], [18, 221259], [24, 221935], [28, 222116], [31, 222316], [35, 222476], [40, 222716], [43, 222896], [47, 223356], [54, 223556], [58, 223776], [63, 224016], [67, 224536], [71, 224636], [76, 224776], [81, 225016], [84, 225196], [89, 225456], [94, 225656]]}, {"verse": 28, "start": 226338, "end": 236801, "text": "And they said, We saw certainly that the LORD was with you: and we said, Let there be now an oath between us, even between us and you, and let us make a covenant with you;", "words": [[0, 226338], [4, 226465], [9, 226605], [15, 226845], [18, 227045], [22, 227325], [32, 227765], [37, 228085], [41, 228225], [46, 228485], [50, 228745], [55, 228985], [60, 229692], [64, 229816], [67, 229996], [73, 230496], [77, 230936], [83, 231176], [86, 231336], [90, 231636], [93, 231856], [98, 232156], [106, 232656], [110, 233136], [115, 233376], [123, 233736], [126, 233966], [130, 234196], [135, 234896], [139, 235016], [143, 235176], [146, 235316], [151, 235536], [153, 235676], [162, 236036], [167, 236396]]}, {"verse": 29, "start": 237101, "end": 245698, "text": "That you will do us no hurt, as we have not touched you, and as we have done to you nothing but good, and have sent you away in peace: you are now the blessed of the LORD.", "words": [[0, 237101], [5, 237259], [9, 237339], [14, 237499], [17, 237639], [20, 237799], [23, 237979], [29, 238279], [32, 238519], [35, 238679], [40, 238819], [44, 238999], [52, 239359], [57, 239619], [61, 240079], [64, 240219], [67, 240339], [72, 240459], [77, 240659], [80, 240799], [84, 240919], [92, 241139], [96, 241399], [102, 241659], [106, 241879], [111, 241999], [116, 242219], [120, 242399], [125, 242639], [128, 242819], [135, 243573], [139, 243733], [143, 243993], [147, 244253], [151, 244433], [159, 244813], [162, 245093], [166, 245253]]}, {"verse": 30, "start": 246048, "end": 249126, "text": "And he made them a feast, and they did eat and drink.", "words": [[0, 246048], [4, 246195], [7, 246275], [12, 246495], [17, 246695], [19, 246795], [26, 247535], [30, 247715], [35, 247855], [39, 248055], [43, 248335], [47, 248595]]}, {"verse": 31, "start": 249576, "end": 257484, "text": "And they rose up early in the morning, and swore one to another: and Isaac sent them away, and they departed from him in peace.", "words": [[0, 249576], [4, 249700], [9, 249800], [14, 250060], [17, 250340], [23, 250680], [26, 250840], [30, 250920], [39, 251240], [43, 251760], [49, 252220], [53, 252420], [56, 252640], [65, 253548], [69, 253715], [75, 254015], [80, 254335], [85, 254555], [91, 255335], [95, 255535], [100, 255675], [109, 256095], [114, 256435], [118, 256675], [121, 256855]]}, {"verse": 32, "start": 257934, "end": 267487, "text": "And it came to pass the same day, that Isaac’s servants came, and told him concerning the well which they had dug, and said to him, We have found water.", "words": [[0, 257934], [4, 258070], [7, 258170], [12, 258410], [15, 258590], [20, 258870], [24, 259090], [29, 259390], [34, 259750], [39, 260270], [47, 260810], [56, 261090], [62, 261850], [66, 262030], [71, 262270], [75, 262510], [86, 262990], [90, 263330], [95, 263570], [101, 263870], [106, 264090], [110, 264250], [115, 265010], [119, 265290], [124, 265530], [127, 265730], [132, 266327], [135, 266465], [140, 266605], [146, 266865]]}, {"verse": 33, "start": 267837, "end": 273082, "text": "And he called it Shebah: therefore the name of the city is Beer-sheba to this day.", "words": [[0, 267837], [4, 267957], [7, 268057], [14, 268297], [17, 268777], [25, 269489], [35, 269976], [39, 270096], [44, 270296], [47, 270436], [51, 270536], [56, 270816], [59, 271536], [70, 272256], [73, 272456], [78, 272656]]}, {"verse": 34, "start": 273532, "end": 281092, "text": "¶ And Esau was forty years old when he took to wife Judith the daughter of Beeri the Hittite, and Bashemath the daughter of Elon the Hittite:", "words": [[2, 273532], [6, 273680], [11, 274140], [15, 274420], [21, 274700], [27, 274960], [31, 275360], [36, 275600], [39, 275720], [44, 275900], [47, 276060], [52, 276280], [59, 276620], [63, 276900], [72, 277160], [75, 277430], [81, 277700], [85, 277860], [94, 278780], [98, 279110], [108, 279440], [112, 279600], [121, 279860], [124, 280060], [129, 280340], [133, 280560]]}, {"verse": 35, "start": 281542, "end": 285653, "text": "Which were a grief of mind to Isaac and to Rebekah.", "words": [[0, 281542], [6, 281692], [11, 281912], [13, 282032], [19, 282232], [22, 282482], [27, 282732], [30, 282932], [36, 283312], [40, 283572], [43, 284613]]}]}