{"book": "JHN", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 359520, "verses": [{"verse": 1, "start": 300, "end": 6275, "text": "En el principio era el Verbo, y el Verbo era con Dios, y el Verbo era Dios.", "words": [[0, 300], [3, 467], [6, 567], [16, 1167], [20, 1507], [23, 1667], [30, 2467], [32, 2707], [35, 2847], [41, 3267], [45, 3427], [49, 3647], [55, 4607], [57, 4707], [60, 4887], [66, 5367], [70, 5567]]}, {"verse": 2, "start": 6625, "end": 9271, "text": "Este era en el principio con Dios.", "words": [[0, 6625], [5, 7006], [9, 7286], [12, 7426], [15, 7586], [25, 8166], [29, 8606]]}, {"verse": 3, "start": 9621, "end": 15660, "text": "Todas las cosas por él fueron hechas; y sin él nada de lo que es hecho, fue hecho.", "words": [[0, 9621], [6, 9947], [10, 10127], [16, 10447], [20, 10787], [23, 10927], [30, 11247], [38, 12246], [40, 12369], [44, 12569], [47, 12789], [52, 13169], [55, 13429], [58, 13569], [62, 13709], [65, 13909], [72, 14389], [76, 15069]]}, {"verse": 4, "start": 16010, "end": 20617, "text": "En él estaba la vida, y la vida era la luz de los hombres.", "words": [[0, 16010], [3, 16208], [6, 16488], [13, 17108], [16, 17348], [22, 17988], [24, 18108], [27, 18248], [32, 18468], [36, 18748], [39, 18928], [43, 19308], [46, 19688], [50, 19828]]}, {"verse": 5, "start": 20967, "end": 26791, "text": "Y la luz en las tinieblas resplandece; pero las tinieblas no la comprendieron.", "words": [[0, 20967], [2, 21055], [5, 21195], [9, 21515], [12, 21935], [16, 22095], [26, 23056], [39, 24194], [44, 24340], [48, 24540], [58, 25300], [61, 25580], [64, 25720]]}, {"verse": 6, "start": 27141, "end": 31755, "text": "fue un hombre enviado de Dios, el cual se llamaba Juan.", "words": [[0, 27141], [4, 27471], [7, 27811], [14, 28151], [22, 28851], [25, 29051], [31, 29811], [34, 30031], [39, 30311], [42, 30651], [50, 31131]]}, {"verse": 7, "start": 32105, "end": 38889, "text": "Este vino por testimonio, para que diese testimonio de la luz, para que todos creyesen por él.", "words": [[0, 32105], [5, 32449], [10, 32849], [14, 33109], [26, 34189], [31, 34409], [35, 34689], [41, 34969], [52, 35709], [55, 35789], [58, 35949], [63, 36589], [68, 36989], [72, 37129], [78, 37469], [87, 38289], [91, 38509]]}, {"verse": 8, "start": 39239, "end": 43424, "text": "No era él la luz, sino para que diese testimonio de la luz.", "words": [[0, 39239], [3, 39465], [7, 39745], [10, 40005], [13, 40185], [18, 40805], [23, 41125], [28, 41365], [32, 41595], [38, 41825], [49, 42705], [52, 42805], [55, 42945]]}, {"verse": 9, "start": 43774, "end": 49369, "text": "Aquel era la luz verdadera, que alumbra a todo hombre que viene a este mundo.", "words": [[0, 43944], [6, 44114], [10, 44459], [13, 44639], [17, 44979], [28, 45879], [32, 46179], [40, 46719], [42, 46939], [47, 47159], [54, 47759], [58, 48019], [64, 48359], [66, 48539], [71, 48759]]}, {"verse": 10, "start": 49719, "end": 55373, "text": "En el mundo estaba, y el mundo fue hecho por él; y el mundo no le conoció.", "words": [[0, 49719], [3, 49866], [6, 50006], [12, 50306], [20, 50806], [22, 51346], [25, 51506], [31, 51806], [35, 52086], [41, 52366], [45, 52666], [49, 53275], [51, 53373], [54, 53513], [60, 53893], [63, 54333], [66, 54493]]}, {"verse": 11, "start": 55723, "end": 59931, "text": "A lo suyo vino, y los suyos no le recibieron.", "words": [[0, 55723], [2, 55922], [5, 56022], [10, 56482], [16, 57042], [18, 57562], [22, 57722], [28, 58302], [31, 58632], [34, 58962]]}, {"verse": 12, "start": 60281, "end": 67843, "text": "Pero a todos los que le recibieron, les dio potestad de ser hechos hijos de Dios, a los que creen en su nombre:", "words": [[0, 60281], [5, 60423], [7, 60563], [13, 60943], [17, 61203], [21, 61703], [24, 62203], [36, 62703], [40, 62963], [44, 63163], [53, 63863], [56, 64023], [60, 64243], [67, 64543], [73, 64843], [76, 65043], [82, 65683], [84, 65903], [88, 66043], [92, 66183], [98, 66723], [101, 67003], [104, 67163]]}, {"verse": 13, "start": 68193, "end": 76015, "text": "Los cuales no son engendrados de sangre, ni de voluntad de carne, ni de voluntad de varón, sino de Dios.", "words": [[0, 68193], [4, 68373], [11, 68693], [14, 69233], [18, 69493], [30, 70233], [33, 70413], [41, 71273], [44, 71533], [47, 71673], [56, 72213], [59, 72353], [66, 73133], [69, 73373], [72, 73493], [81, 74073], [84, 74193], [91, 75113], [96, 75213], [99, 75453]]}, {"verse": 14, "start": 76365, "end": 86709, "text": "Y aquel Verbo fue hecho carne, y habitó entre nosotros (y vimos su gloria, gloria como del unigénito del Padre), lleno de gracia y de verdad.", "words": [[0, 76365], [2, 76489], [8, 76809], [14, 77209], [18, 77449], [24, 77729], [31, 78289], [33, 78809], [40, 79229], [46, 79449], [55, 79989], [58, 80389], [64, 80689], [67, 81262], [75, 81836], [82, 82409], [87, 82649], [91, 82889], [101, 83789], [105, 83989], [113, 84969], [119, 85269], [122, 85369], [129, 85889], [131, 86009], [134, 86109]]}, {"verse": 15, "start": 87059, "end": 97303, "text": "Juan dio testimonio de él, y clamó diciendo: Este es del que yo decía: El que viene tras mí, es superior a mí: porque existía antes que yo.", "words": [[0, 87059], [5, 87576], [9, 87896], [20, 88876], [23, 89036], [27, 89336], [29, 89756], [35, 90216], [45, 91144], [50, 91427], [53, 91707], [57, 91867], [61, 92047], [64, 92207], [71, 93049], [74, 93175], [78, 93315], [84, 93515], [89, 93755], [93, 94055], [96, 94575], [105, 94915], [107, 95175], [111, 95636], [118, 95854], [126, 96454], [132, 96734], [136, 96974]]}, {"verse": 16, "start": 97583, "end": 101567, "text": "Porque de su plenitud tomamos todos, y gracia por gracia.", "words": [[0, 97583], [7, 97807], [10, 97967], [13, 98127], [22, 98687], [30, 99267], [37, 99707], [39, 100092], [46, 100755], [50, 100897]]}, {"verse": 17, "start": 101917, "end": 108556, "text": "Porque la ley por Moisés fue dada: pero la gracia y la verdad por Jesucristo fue hecha.", "words": [[0, 101917], [7, 102158], [10, 102338], [14, 102578], [18, 102798], [25, 103298], [29, 103638], [35, 104433], [40, 104576], [43, 104756], [50, 105256], [52, 105336], [55, 105476], [62, 105736], [66, 106256], [77, 107116], [81, 107356]]}, {"verse": 18, "start": 108906, "end": 116025, "text": "A Dios nadie le vio jamás: el unigénito Hijo, que está en el seno del Padre, él le dio a conocer.", "words": [[0, 108906], [2, 108906], [7, 108906], [13, 109486], [16, 109666], [20, 109906], [27, 110843], [30, 110991], [40, 111461], [46, 111931], [50, 112171], [55, 112351], [58, 112491], [61, 112631], [66, 112931], [70, 113031], [77, 114131], [80, 114531], [83, 114891], [87, 115151], [89, 115291]]}, {"verse": 19, "start": 116375, "end": 126236, "text": "Y este es el testimonio de Juan, cuando los judíos enviaron de Jerusalén sacerdotes y levitas, que le preguntasen: ¿Tú, quién eres?", "words": [[0, 116375], [2, 116520], [7, 116800], [10, 117000], [13, 117140], [24, 117820], [27, 117920], [33, 118280], [40, 118920], [44, 119140], [51, 119600], [60, 120100], [63, 120320], [73, 121000], [84, 121880], [86, 122100], [95, 122640], [99, 123100], [102, 123565], [115, 124230], [120, 124370], [126, 124610]]}, {"verse": 20, "start": 126516, "end": 130598, "text": "Y confesó, y no negó; pero declaró: No soy yo el Cristo.", "words": [[0, 126516], [2, 126640], [11, 127360], [13, 127600], [16, 127800], [22, 128472], [27, 128636], [36, 129537], [39, 129663], [43, 129843], [46, 130003], [49, 130103]]}, {"verse": 21, "start": 130878, "end": 139392, "text": "Y le preguntaron: ¿Qué pues? ¿Eres tú Elías? Dijo: No soy. ¿Eres tú el profeta? Y respondió: No.", "words": [[0, 130878], [2, 131002], [5, 131102], [18, 132362], [23, 132463], [29, 133193], [35, 133425], [38, 133785], [45, 134635], [51, 135449], [54, 135653], [59, 136358], [65, 136576], [68, 136836], [71, 136976], [80, 137900], [82, 138047], [93, 139055]]}, {"verse": 22, "start": 139672, "end": 145933, "text": "Le dijeron: ¿Pues quién eres? para que demos respuesta a los que nos enviaron. ¿Qué dices de ti mismo?", "words": [[0, 139672], [3, 139772], [12, 140747], [18, 140876], [24, 141096], [30, 141726], [35, 141890], [39, 142030], [45, 142310], [55, 142850], [57, 143310], [61, 143450], [65, 143590], [69, 143750], [79, 144683], [84, 144785], [90, 145105], [93, 145285], [96, 145405]]}, {"verse": 23, "start": 146213, "end": 152779, "text": "Dijo: Yo soy la voz del que clama en el desierto: Enderezad el camino del Señor, como dijo Isaías profeta.", "words": [[0, 146213], [6, 147027], [9, 147144], [13, 147304], [16, 147444], [20, 147604], [24, 147744], [28, 147884], [34, 148244], [37, 148344], [40, 148424], [50, 149554], [60, 149824], [63, 149984], [70, 150244], [74, 150464], [81, 151304], [86, 151424], [91, 151704], [98, 152144]]}, {"verse": 24, "start": 153059, "end": 156293, "text": "Y los que habían sido enviados eran de los fariseos.", "words": [[0, 153059], [2, 153186], [6, 153346], [10, 153526], [17, 153806], [22, 154166], [31, 154786], [36, 155146], [39, 155366], [43, 155506]]}, {"verse": 25, "start": 156643, "end": 164029, "text": "Y le preguntaron, y le dijeron: ¿Por qué pues bautizas, si tú no eres el Cristo, ni Elías, ni el profeta?", "words": [[0, 156643], [2, 156791], [5, 156851], [18, 157631], [20, 157926], [23, 158006], [32, 158990], [37, 159114], [41, 159434], [46, 159734], [56, 160434], [59, 160814], [62, 161034], [65, 161174], [70, 161414], [73, 161554], [81, 162194], [84, 162674], [91, 163154], [94, 163254], [97, 163354]]}, {"verse": 26, "start": 164309, "end": 172849, "text": "Y Juan les respondió, diciendo: Yo bautizo con agua; pero en medio de vosotros está uno a quien vosotros no conocéis.", "words": [[0, 164309], [2, 164458], [7, 164758], [11, 165318], [22, 166418], [32, 167800], [35, 167938], [43, 168378], [47, 168618], [53, 169272], [58, 169418], [61, 169558], [67, 169758], [70, 169918], [79, 170398], [84, 170718], [88, 170998], [90, 171178], [96, 171318], [105, 171838], [108, 172098]]}, {"verse": 27, "start": 173199, "end": 180414, "text": "Este es el que ha de venir tras mí, el cual es superior a mí: del cual yo no soy digno de desatar la correa del zapato.", "words": [[0, 173199], [5, 173501], [8, 173741], [11, 173901], [15, 174041], [18, 174161], [21, 174241], [27, 174501], [32, 174741], [36, 175361], [39, 175461], [44, 175641], [47, 175841], [56, 176141], [58, 176401], [62, 176845], [66, 177024], [71, 177344], [74, 177644], [77, 177784], [81, 178024], [87, 178524], [90, 178584], [98, 179064], [101, 179304], [108, 179704], [112, 179864]]}, {"verse": 28, "start": 180694, "end": 186718, "text": "Estas cosas acontecieron en Betábara, del otro lado del Jordán, donde Juan bautizaba.", "words": [[0, 180694], [6, 181003], [12, 181263], [25, 182203], [28, 182733], [38, 183263], [42, 183363], [47, 183603], [52, 183923], [56, 184143], [64, 185003], [70, 185183], [75, 185603]]}, {"verse": 29, "start": 187068, "end": 194607, "text": "El siguiente día ve Juan a Jesús que venía a él, y dice: He aquí el Cordero de Dios, que quita el pecado del mundo.", "words": [[0, 187068], [3, 187228], [13, 187528], [17, 187928], [20, 188128], [25, 188408], [27, 188648], [33, 188948], [37, 189348], [43, 189808], [45, 190048], [49, 190328], [51, 190510], [57, 191388], [60, 191533], [65, 191813], [68, 191933], [76, 192353], [79, 192473], [85, 193073], [89, 193133], [95, 193453], [98, 193553], [105, 193913], [109, 194093]]}, {"verse": 30, "start": 194957, "end": 200954, "text": "Este es del que dije: Tras mí viene un varón, el cual es superior a mí: porque existía antes que yo.", "words": [[0, 194957], [5, 195216], [8, 195376], [12, 195536], [16, 195656], [22, 196341], [27, 196603], [30, 196683], [36, 196943], [39, 197063], [46, 197763], [49, 197843], [54, 198043], [57, 198263], [66, 198543], [68, 198783], [72, 199288], [79, 199505], [87, 200105], [93, 200385], [97, 200625]]}, {"verse": 31, "start": 201304, "end": 206747, "text": "Y yo no le conocía; pero para que fuese manifestado a Israel, por eso vine yo bautizando con agua.", "words": [[0, 201304], [2, 201411], [5, 201551], [8, 201671], [11, 201771], [20, 202694], [25, 202815], [30, 203035], [34, 203195], [40, 203495], [52, 204155], [54, 204235], [62, 204835], [66, 204875], [70, 205075], [75, 205315], [78, 205515], [89, 206135], [93, 206335]]}, {"verse": 32, "start": 207027, "end": 213986, "text": "Y Juan dio testimonio, diciendo: Vi al Espíritu que descendía del cielo como paloma, y reposó sobre él.", "words": [[0, 207027], [2, 207149], [7, 207449], [11, 207754], [23, 208734], [33, 209856], [36, 210010], [39, 210163], [48, 210763], [52, 210863], [62, 211423], [66, 211583], [72, 211943], [77, 212223], [85, 212743], [87, 212908], [94, 213368], [100, 213608]]}, {"verse": 33, "start": 214336, "end": 226258, "text": "Y yo no le conocía; pero el que me envió a bautizar con agua, aquel me dijo: Sobre quien veas descender el Espíritu, y que reposa sobre él, este es el que bautiza con Espíritu Santo.", "words": [[0, 214336], [2, 214443], [5, 214583], [8, 214703], [11, 214803], [20, 215727], [25, 215854], [28, 215954], [32, 216074], [35, 216194], [41, 216494], [43, 216594], [52, 217034], [56, 217254], [62, 217854], [68, 218154], [71, 218254], [77, 218944], [83, 219227], [89, 219507], [94, 219987], [104, 220527], [107, 220667], [117, 221347], [119, 221727], [123, 221867], [130, 222347], [136, 222667], [140, 223267], [145, 223587], [148, 223907], [151, 224147], [155, 224287], [163, 224847], [167, 225067], [176, 225647]]}, {"verse": 34, "start": 226608, "end": 230365, "text": "Y yo le vi, y he dado testimonio que este es el Hijo de Dios.", "words": [[0, 226608], [2, 226725], [5, 226885], [8, 227025], [12, 227225], [14, 227785], [17, 227885], [22, 228085], [33, 228865], [37, 229005], [42, 229305], [45, 229545], [48, 229685], [53, 229905], [56, 230045]]}, {"verse": 35, "start": 230645, "end": 235399, "text": "El siguiente día otra vez estaba Juan, y dos de sus discípulos.", "words": [[0, 230645], [3, 230825], [13, 231205], [17, 231705], [22, 232005], [26, 232345], [33, 232585], [39, 233065], [41, 233430], [45, 233750], [48, 234170], [52, 234390]]}, {"verse": 36, "start": 235399, "end": 240858, "text": "Y mirando a Jesús que andaba por allí, dijo: He aquí el Cordero de Dios.", "words": [[0, 235399], [2, 235639], [10, 236019], [12, 236159], [18, 236419], [22, 236739], [29, 237079], [33, 237339], [39, 238259], [45, 239058], [48, 239199], [53, 239499], [56, 239759], [64, 240179], [67, 240299]]}, {"verse": 37, "start": 241138, "end": 245025, "text": "Y le oyeron los dos discípulos hablar, y siguieron a Jesús.", "words": [[0, 241138], [2, 241260], [5, 241380], [12, 241800], [16, 241980], [20, 242200], [31, 242880], [39, 243260], [41, 243720], [51, 244260], [53, 244380]]}, {"verse": 38, "start": 245375, "end": 255771, "text": "Y volviéndose Jesús, y viéndolos seguirle, les dice: ¿Qué buscáis? Y ellos le dijeron: Rabí (que traducido quiere decir Maestro) ¿dónde te hospedas?", "words": [[0, 245375], [2, 245463], [14, 246043], [21, 246763], [23, 247033], [33, 247303], [43, 247773], [47, 248243], [53, 249048], [58, 249150], [67, 250267], [69, 250724], [75, 250944], [78, 251164], [87, 252323], [92, 252534], [97, 252607], [107, 253187], [114, 253407], [120, 253747], [129, 254727], [136, 254967], [139, 255107]]}, {"verse": 39, "start": 256051, "end": 264732, "text": "Les dice: Venid y ved. Vinieron, y vieron donde moraba, y se quedaron con él aquel día: porque era como la hora de las diez.", "words": [[0, 256051], [4, 256239], [10, 257148], [16, 257656], [18, 257896], [23, 258575], [33, 259102], [35, 259362], [42, 259662], [48, 259882], [56, 260502], [58, 260702], [61, 260842], [70, 261282], [74, 261482], [77, 261642], [83, 261942], [88, 262598], [95, 262842], [99, 263062], [104, 263302], [107, 263522], [112, 263742], [115, 263902], [119, 264317]]}, {"verse": 40, "start": 265082, "end": 272021, "text": "Era Andrés, hermano de Simón Pedro, uno de los dos que habían oído de Juan, y le habían seguido.", "words": [[0, 265082], [4, 265347], [12, 265987], [20, 266667], [23, 266747], [29, 267287], [36, 268272], [40, 268612], [43, 268772], [47, 268952], [51, 269192], [55, 269412], [62, 269692], [67, 270032], [70, 270212], [76, 270492], [78, 270992], [81, 271112], [88, 271352]]}, {"verse": 41, "start": 272371, "end": 278804, "text": "Este halló primero a su hermano Simón, y le dijo: Hemos hallado al Mesías (que traducido es, el Cristo).", "words": [[0, 272371], [5, 272616], [11, 272876], [19, 273176], [21, 273376], [24, 273476], [32, 273916], [39, 274316], [41, 274516], [44, 274636], [50, 275413], [56, 275614], [64, 276014], [67, 276134], [74, 277111], [79, 277195], [89, 277855], [93, 277975], [96, 278135]]}, {"verse": 42, "start": 279154, "end": 289100, "text": "Y le trajo a Jesús. Y mirándole Jesús, dijo: Tú eres Simón, hijo de Jonás: tú serás llamado Cefas (que quiere decir, Piedra).", "words": [[0, 279154], [2, 279319], [5, 279519], [11, 279719], [13, 279799], [20, 280626], [22, 280743], [32, 281223], [39, 281623], [45, 282708], [48, 282852], [53, 283092], [60, 284192], [65, 284392], [68, 284572], [75, 285422], [78, 285504], [84, 285844], [92, 286210], [98, 286797], [103, 287217], [110, 287597], [117, 288037]]}, {"verse": 43, "start": 289450, "end": 296021, "text": "El siguiente día quiso Jesús ir a Galilea, y halla a Felipe, al cual dijo: Sígueme.", "words": [[0, 289499], [3, 289579], [13, 289939], [17, 290399], [23, 290939], [29, 291399], [32, 291819], [34, 291919], [43, 292879], [45, 293159], [51, 293439], [53, 293639], [61, 294299], [64, 294399], [69, 294579], [75, 295405]]}, {"verse": 44, "start": 296371, "end": 300267, "text": "Y era Felipe de Betsaida, la ciudad de Andrés y de Pedro.", "words": [[0, 296371], [2, 296468], [6, 296608], [13, 296948], [16, 297628], [26, 298308], [29, 298388], [36, 298668], [39, 298968], [46, 299388], [48, 299608], [51, 299708]]}, {"verse": 45, "start": 300617, "end": 309642, "text": "Felipe halló a Natanael, y le dice: Hemos hallado a aquel de quien escribió Moisés en la ley, y los profetas: a Jesús, el hijo de José, de Nazaret.", "words": [[0, 300617], [7, 301007], [13, 301429], [15, 301851], [25, 302273], [27, 302695], [30, 303117], [36, 303739], [42, 303906], [50, 304106], [52, 304306], [58, 304566], [61, 304666], [67, 304786], [76, 305246], [83, 305546], [86, 305726], [89, 305826], [94, 306046], [96, 306426], [100, 306546], [110, 307479], [112, 307577], [119, 308177], [122, 308257], [127, 308457], [130, 308537], [136, 308857], [139, 309037]]}, {"verse": 46, "start": 309922, "end": 316330, "text": "Y le dijo Natanael: ¿De Nazaret puede haber algo de bueno? Le dice Felipe: Ven y ve.", "words": [[0, 309922], [2, 310059], [5, 310159], [10, 310942], [20, 311926], [24, 312072], [32, 312632], [38, 312872], [44, 313092], [49, 313352], [52, 313512], [59, 314295], [62, 314444], [67, 314664], [75, 315766], [79, 315968], [81, 316171]]}, {"verse": 47, "start": 316610, "end": 324339, "text": "Jesús vio venir a sí a Natanael, y dijo de él: He aquí un verdadero israelita, en el cual no hay engaño.", "words": [[0, 316610], [6, 316938], [10, 317418], [16, 318098], [18, 318408], [21, 318718], [23, 318898], [33, 319078], [35, 319358], [40, 319638], [43, 319838], [47, 320383], [50, 320703], [55, 320983], [58, 321143], [68, 321683], [79, 322803], [82, 322923], [85, 323043], [90, 323223], [93, 323483], [97, 323663]]}, {"verse": 48, "start": 324689, "end": 333977, "text": "Le dice Natanael: ¿De dónde me conoces? Respondió Jesús, y le dijo: Antes que Felipe te llamara, cuando estabas debajo de la higuera te vi.", "words": [[0, 324689], [3, 325112], [8, 325567], [18, 326195], [22, 326356], [28, 326496], [31, 326736], [40, 328021], [50, 328311], [57, 328611], [59, 328871], [62, 328991], [68, 329720], [74, 330200], [78, 330360], [85, 330680], [88, 330960], [97, 331440], [104, 331940], [112, 332400], [119, 332760], [122, 332940], [125, 333060], [133, 333386], [136, 333713]]}, {"verse": 49, "start": 334327, "end": 339934, "text": "Respondió Natanael, y le dijo: Rabí, tú eres el Hijo de Dios; tú eres el Rey de Israel.", "words": [[0, 334327], [10, 334955], [20, 335615], [22, 335815], [25, 335895], [31, 336818], [37, 337038], [40, 337138], [45, 337358], [48, 337538], [53, 337718], [56, 337838], [62, 338577], [65, 338719], [70, 338899], [73, 339119], [77, 339279], [80, 339399]]}, {"verse": 50, "start": 340214, "end": 347096, "text": "Respondió Jesús y le dijo: ¿Porque te dije, te vi debajo de la higuera, crees? cosas mayores que estas verás.", "words": [[0, 340214], [10, 340718], [16, 341038], [18, 341298], [21, 341418], [27, 342052], [35, 342258], [38, 342478], [44, 342718], [47, 342958], [50, 343198], [57, 343638], [60, 343778], [63, 343898], [72, 344478], [79, 345303], [85, 345506], [93, 346066], [97, 346286], [103, 346506]]}, {"verse": 51, "start": 347096, "end": 359120, "text": "Y le dice: De cierto, de cierto os digo: De aquí en adelante veréis el cielo abierto, y los ángeles de Dios que suben y descienden sobre el Hijo del hombre.", "words": [[0, 347161], [2, 347226], [5, 347346], [11, 348978], [14, 349190], [22, 349402], [25, 349614], [32, 349826], [35, 350166], [41, 351002], [44, 351170], [49, 351490], [52, 351710], [61, 352130], [68, 352670], [71, 352870], [77, 353210], [86, 353930], [88, 354095], [92, 354275], [100, 354815], [103, 355035], [108, 355375], [112, 355875], [118, 356495], [120, 356715], [131, 357375], [137, 357795], [140, 358075], [145, 358335], [149, 358535]]}]}