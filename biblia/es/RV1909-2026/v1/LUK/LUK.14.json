{"book": "LUK", "chapter": 14, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 288087, "verses": [{"verse": 1, "start": 300, "end": 8023, "text": "Y aconteció que entrando en casa de un príncipe de los fariseos un sábado a comer pan, ellos le acechaban.", "words": [[0, 300], [2, 423], [12, 1163], [16, 1363], [25, 2063], [28, 2263], [33, 2583], [36, 2843], [39, 2983], [48, 3723], [51, 3883], [55, 4003], [64, 4683], [67, 4863], [74, 5323], [76, 5443], [82, 5663], [87, 6563], [93, 6703], [96, 7363]]}, {"verse": 2, "start": 8373, "end": 13967, "text": "Y he aquí un hombre con hinchazón por retención de líquidos estaba delante de él.", "words": [[0, 8373], [2, 8557], [5, 8697], [10, 9017], [13, 9257], [20, 9557], [24, 9817], [34, 10717], [38, 10957], [48, 11677], [51, 11857], [60, 12417], [67, 12897], [75, 13477], [78, 13657]]}, {"verse": 3, "start": 14317, "end": 23226, "text": "Y respondiendo Jesús, habló a los intérpretes de la ley y a los fariseos, diciendo: ¿Es lícito sanar en sábado?", "words": [[0, 14317], [2, 14445], [15, 15225], [22, 16205], [28, 16625], [30, 16725], [34, 16845], [46, 17725], [49, 17825], [52, 17965], [56, 18285], [58, 18685], [60, 18745], [64, 18865], [74, 19905], [84, 20868], [88, 21052], [95, 21732], [101, 22312], [104, 22472]]}, {"verse": 4, "start": 23576, "end": 28878, "text": "Y ellos callaron. Entonces él tomándole, le sanó, y le despidió.", "words": [[0, 23576], [2, 23740], [8, 24354], [18, 25131], [27, 25620], [30, 26040], [41, 26460], [44, 26880], [50, 27300], [52, 27859], [55, 27979]]}, {"verse": 5, "start": 29228, "end": 38118, "text": "Y respondiendo a ellos dijo: ¿El asno o el buey de cuál de vosotros caerá en algún pozo, y no lo sacará enseguida en día de sábado?", "words": [[0, 29228], [2, 29354], [15, 30214], [17, 30374], [23, 30614], [29, 31577], [33, 31727], [38, 32187], [40, 32467], [43, 32807], [48, 33147], [51, 33327], [56, 33527], [59, 33747], [68, 34167], [74, 34667], [77, 34747], [83, 34987], [89, 35507], [91, 35827], [94, 35967], [97, 36067], [104, 36527], [114, 37047], [117, 37147], [121, 37347], [124, 37487]]}, {"verse": 6, "start": 38468, "end": 41069, "text": "Y no le podían replicar a estas cosas.", "words": [[0, 38468], [2, 38577], [5, 38677], [8, 38817], [15, 39257], [24, 39937], [26, 40097], [32, 40257]]}, {"verse": 7, "start": 41419, "end": 49908, "text": "Y observando cómo escogían los primeros asientos a la mesa, refirió una parábola a los invitados, diciéndoles:", "words": [[0, 41419], [2, 41557], [13, 42217], [18, 42537], [27, 43117], [31, 43337], [40, 43917], [49, 44377], [51, 44597], [54, 44697], [60, 45637], [68, 46337], [72, 46617], [81, 47237], [83, 47477], [87, 47597], [98, 48777]]}, {"verse": 8, "start": 50258, "end": 59333, "text": "Cuando seas invitado de alguno a bodas, no te sientes en el primer lugar, no sea que otro más honrado que tú esté por él invitado,", "words": [[0, 50258], [7, 50460], [12, 50759], [21, 51460], [24, 51619], [31, 52060], [33, 52160], [40, 52980], [43, 53259], [46, 53439], [54, 53860], [57, 54079], [60, 54240], [67, 54620], [74, 55500], [77, 55700], [81, 55939], [85, 56160], [90, 56380], [94, 56740], [102, 57480], [106, 57680], [109, 57880], [114, 58120], [118, 58399], [121, 58540]]}, {"verse": 9, "start": 59683, "end": 68811, "text": "Y viniendo el que te llamó a ti y a él, te diga: Da lugar a este: y entonces comiences con vergüenza a tener el lugar último.", "words": [[0, 59683], [2, 59790], [11, 60310], [14, 60430], [18, 60530], [21, 60690], [27, 61030], [29, 61190], [32, 61310], [34, 61470], [36, 61550], [40, 61870], [43, 62150], [49, 62881], [52, 63046], [58, 63326], [60, 63566], [66, 64411], [68, 64556], [77, 65016], [87, 65936], [91, 66156], [101, 66836], [103, 67036], [109, 67296], [112, 67536], [118, 67856]]}, {"verse": 10, "start": 69161, "end": 82986, "text": "Pero cuando seas invitado, ve, y siéntate en el último lugar; para que cuando venga el que te convidó, te diga: Amigo, sube más arriba: entonces tendrás gloria delante de los que juntamente se asientan a la mesa.", "words": [[0, 69161], [5, 69288], [12, 69588], [17, 69908], [27, 70588], [31, 70848], [33, 71488], [42, 72088], [45, 72248], [48, 72368], [55, 72628], [62, 73471], [67, 73636], [71, 73796], [78, 74016], [84, 74336], [87, 74656], [91, 74756], [94, 74916], [103, 75396], [106, 75556], [112, 76211], [119, 76557], [124, 77137], [128, 77317], [136, 78124], [145, 78608], [153, 79228], [160, 79848], [168, 80348], [171, 80508], [175, 80648], [179, 80828], [190, 81488], [193, 81748], [202, 82328], [204, 82388], [207, 82488]]}, {"verse": 11, "start": 83336, "end": 90358, "text": "Porque cualquiera que se enaltece, será humillado; y el que se humilla, será enaltecido.", "words": [[0, 83336], [7, 83541], [18, 84181], [22, 84341], [25, 84501], [35, 85281], [40, 85881], [51, 87091], [53, 87405], [56, 87525], [60, 87665], [63, 87845], [72, 88425], [77, 88905]]}, {"verse": 12, "start": 90708, "end": 106279, "text": "Y dijo también al que le había invitado: Cuando haces comida o cena, no llames a tus amigos, ni a tus hermanos, ni a tus parientes, ni a vecinos ricos; no sea que ellos también te vuelvan a invitar, y te sea hecha compensación.", "words": [[0, 90708], [2, 90832], [7, 91112], [15, 91532], [18, 91952], [22, 92132], [25, 92292], [31, 92572], [41, 93622], [48, 93866], [54, 94326], [61, 94806], [63, 95046], [69, 95786], [72, 95886], [79, 96286], [81, 96446], [85, 96566], [93, 97086], [96, 97606], [98, 97726], [102, 97866], [112, 98386], [115, 98906], [117, 98986], [121, 99066], [132, 99656], [135, 100246], [137, 100326], [145, 100746], [152, 101705], [155, 101830], [159, 102050], [163, 102270], [169, 102530], [177, 102890], [180, 103170], [188, 103590], [190, 103670], [199, 104150], [201, 104343], [204, 104537], [208, 104730], [214, 105010]]}, {"verse": 13, "start": 106629, "end": 113043, "text": "Pero cuando haces banquete, llama a los pobres, los mancos, los cojos, los ciegos;", "words": [[0, 106629], [5, 106793], [12, 107073], [18, 107613], [28, 108533], [34, 108973], [36, 109233], [40, 109353], [48, 110333], [52, 110433], [60, 111353], [64, 111453], [71, 112293], [75, 112413]]}, {"verse": 14, "start": 113393, "end": 121746, "text": "Y serás bienaventurado; porque no te pueden retribuir; pero te será recompensado en la resurrección de los justos.", "words": [[0, 113393], [2, 113499], [8, 114467], [24, 115628], [31, 115832], [34, 116092], [37, 116252], [44, 116592], [55, 117785], [60, 118089], [63, 118289], [68, 118529], [81, 119629], [84, 119769], [87, 119949], [100, 120829], [103, 120989], [107, 121129]]}, {"verse": 15, "start": 122096, "end": 130699, "text": "Y oyendo esto uno de los que juntamente estaban sentados a la mesa, le dijo: Bienaventurado el que comerá pan en el reino de los cielos.", "words": [[0, 122096], [2, 122416], [9, 122796], [14, 123556], [18, 123736], [21, 123916], [25, 124036], [29, 124196], [40, 124796], [48, 125156], [57, 125716], [59, 125896], [62, 126016], [68, 126636], [71, 126716], [77, 127849], [92, 128329], [95, 128489], [99, 128629], [106, 129029], [110, 129309], [113, 129509], [116, 129629], [122, 129889], [125, 129989], [129, 130109]]}, {"verse": 16, "start": 130979, "end": 136761, "text": "Él entonces le dijo: Un hombre hizo una grande cena, y invitó a muchos.", "words": [[0, 130979], [3, 131241], [12, 131881], [15, 132261], [21, 133019], [24, 133168], [31, 133488], [36, 133928], [40, 134288], [47, 134628], [53, 135068], [55, 135323], [62, 136023], [64, 136123]]}, {"verse": 17, "start": 137111, "end": 144018, "text": "Y a la hora de la cena envió a su siervo a decir a los invitados: Venid, que ya está todo preparado.", "words": [[0, 137111], [2, 137218], [4, 137298], [7, 137418], [12, 137678], [15, 137838], [18, 137958], [23, 138298], [29, 139098], [31, 139218], [34, 139358], [41, 139858], [43, 139978], [49, 140218], [51, 140398], [55, 140558], [66, 141719], [73, 142143], [77, 142303], [80, 142503], [85, 142743], [90, 143123]]}, {"verse": 18, "start": 144368, "end": 154572, "text": "Y comenzaron todos a una a excusarse. El primero le dijo: He comprado un terreno, y necesito salir y verlo; te ruego que me des por excusado.", "words": [[0, 144368], [2, 144491], [13, 145191], [19, 145571], [21, 145951], [25, 146171], [27, 146431], [38, 147679], [41, 147823], [49, 148183], [52, 148383], [58, 149106], [61, 149191], [70, 149731], [73, 149891], [82, 150431], [84, 150771], [93, 151371], [99, 151631], [101, 151851], [108, 152595], [111, 152680], [117, 153040], [121, 153200], [124, 153320], [128, 153500], [132, 153660]]}, {"verse": 19, "start": 154922, "end": 162495, "text": "Y el otro dijo: He comprado cinco yuntas de bueyes, y voy a probarlos; te ruego que me des por excusado.", "words": [[0, 154922], [2, 155069], [5, 155189], [10, 155469], [16, 156496], [19, 156680], [28, 157180], [34, 157670], [41, 158160], [44, 158280], [52, 158700], [54, 159180], [58, 159320], [60, 159480], [71, 160518], [74, 160603], [80, 160963], [84, 161123], [87, 161243], [91, 161423], [95, 161583]]}, {"verse": 20, "start": 162845, "end": 167184, "text": "Y el otro dijo: Acabo de casarme, y por tanto no puedo ir.", "words": [[0, 162845], [2, 162992], [5, 163112], [10, 163392], [16, 164419], [22, 164801], [25, 164941], [34, 165541], [36, 165746], [40, 165926], [46, 166246], [49, 166446], [55, 166706]]}, {"verse": 21, "start": 167534, "end": 183293, "text": "Y vuelto el siervo, hizo saber estas cosas a su señor. Entonces enojado el padre de la familia, dijo a su siervo: Ve pronto por las plazas y por las calles de la ciudad, y mete acá los pobres, los mancos, y cojos, y ciegos.", "words": [[0, 167534], [2, 167695], [9, 168115], [12, 168295], [20, 168787], [25, 169280], [31, 169600], [37, 169880], [43, 170280], [45, 170540], [48, 170680], [55, 171520], [64, 172133], [72, 172913], [75, 173053], [81, 173313], [84, 173533], [87, 173633], [96, 174053], [101, 174413], [103, 174673], [106, 174813], [114, 175608], [117, 175792], [124, 176172], [128, 176512], [132, 176692], [139, 177272], [141, 177412], [145, 177572], [149, 177772], [156, 178192], [159, 178312], [162, 178412], [170, 178692], [172, 179052], [177, 179332], [181, 179672], [185, 180192], [193, 181132], [197, 181192], [205, 181832], [207, 182032], [214, 182472], [216, 182652]]}, {"verse": 22, "start": 183643, "end": 188874, "text": "Y dijo el siervo: Señor, hecho es como mandaste, y aún hay lugar.", "words": [[0, 183643], [2, 183770], [7, 184030], [10, 184190], [18, 185012], [25, 185389], [31, 185749], [34, 185969], [39, 186189], [49, 187169], [51, 187469], [55, 188030], [59, 188230]]}, {"verse": 23, "start": 189224, "end": 196634, "text": "Y dijo el señor al siervo: Ve por los caminos y por las cercas, y fuérzalos a entrar, para que se llene mi casa.", "words": [[0, 189224], [2, 189340], [7, 189640], [10, 189760], [16, 190020], [19, 190260], [27, 191127], [30, 191332], [34, 191612], [38, 191772], [46, 192252], [48, 192412], [52, 192632], [56, 192812], [64, 193512], [66, 193932], [76, 194352], [78, 194432], [86, 194852], [91, 195292], [95, 195452], [98, 195572], [104, 195872], [107, 196012]]}, {"verse": 24, "start": 196984, "end": 201674, "text": "Porque os digo que ninguno de aquellos hombres que fueron llamados, gustará mi cena.", "words": [[0, 196984], [7, 197167], [10, 197347], [15, 197567], [19, 197747], [27, 198227], [30, 198327], [39, 198547], [47, 198987], [51, 199187], [58, 199447], [68, 200087], [76, 200907], [79, 201167]]}, {"verse": 25, "start": 202024, "end": 206513, "text": "Y grandes multitudes iban con él; y volviéndose les dijo:", "words": [[0, 202024], [2, 202331], [10, 202691], [21, 203531], [26, 203971], [30, 204191], [34, 204815], [36, 204920], [48, 205440], [52, 205960]]}, {"verse": 26, "start": 206863, "end": 218483, "text": "Si alguno viene a mí, y no aborrece a su padre, y madre, y mujer, e hijos, y hermanos, y hermanas, y aun también su vida, no puede ser mi discípulo.", "words": [[0, 206863], [3, 207027], [10, 207527], [16, 207727], [18, 207927], [22, 208087], [24, 208587], [27, 208787], [36, 209407], [38, 209547], [41, 209687], [48, 210507], [50, 210727], [57, 211447], [59, 211467], [66, 212307], [68, 212407], [75, 213147], [77, 213227], [87, 214007], [89, 214087], [99, 214839], [101, 214999], [105, 215139], [113, 215539], [116, 215799], [122, 216339], [125, 216519], [131, 216799], [135, 217179], [138, 217419]]}, {"verse": 27, "start": 218833, "end": 224566, "text": "Y cualquiera que no lleva su cruz, y viene en pos de mí, no puede ser mi discípulo.", "words": [[0, 218833], [2, 218930], [13, 219490], [17, 219640], [20, 219790], [26, 220030], [29, 220230], [35, 220830], [37, 221050], [43, 221330], [46, 221690], [50, 221910], [53, 222090], [57, 222350], [60, 222990], [66, 223230], [70, 223550], [73, 223730]]}, {"verse": 28, "start": 224916, "end": 233484, "text": "Porque ¿cuál de vosotros, queriendo edificar una torre, no cuenta primero sentado los gastos, si tiene lo que necesita para acabarla?", "words": [[0, 225038], [7, 225198], [13, 225558], [16, 225698], [26, 226198], [36, 226838], [45, 227398], [49, 227638], [56, 228178], [59, 228678], [66, 229038], [74, 229418], [82, 230078], [86, 230238], [94, 230858], [97, 231138], [103, 231438], [106, 231618], [110, 231758], [119, 232298], [124, 232618]]}, {"verse": 29, "start": 233834, "end": 242166, "text": "No sea que, después de poner los cimientos, no pueda terminarla, todos los que lo vean, no comiencen a hacer burla de él,", "words": [[0, 233834], [3, 233979], [7, 234219], [12, 234439], [20, 234739], [23, 234959], [29, 235199], [33, 235459], [44, 236079], [47, 236539], [53, 236879], [65, 237999], [71, 238259], [75, 238719], [79, 238899], [82, 239039], [88, 239539], [91, 239879], [101, 240499], [103, 240639], [109, 240939], [115, 241519], [118, 241719]]}, {"verse": 30, "start": 242516, "end": 246952, "text": "Diciendo: Este hombre comenzó a edificar, y no pudo acabar.", "words": [[0, 242516], [10, 243638], [15, 244006], [22, 244246], [30, 244786], [32, 244846], [42, 245346], [44, 245666], [47, 245806], [52, 246246]]}, {"verse": 31, "start": 247302, "end": 258450, "text": "¿O cuál rey, habiendo de ir a hacer guerra contra otro rey, sentándose primero no consulta si puede salir al encuentro con diez mil al que viene contra él con veinte mil?", "words": [[0, 247302], [3, 247404], [8, 247644], [13, 248104], [22, 248644], [25, 248844], [28, 249064], [30, 249204], [36, 249504], [43, 249844], [50, 250304], [55, 250644], [60, 251364], [71, 252024], [79, 252364], [82, 252604], [91, 253264], [94, 253424], [100, 253684], [106, 254004], [109, 254224], [119, 255064], [123, 255244], [128, 255484], [132, 255844], [135, 256459], [139, 256524], [145, 256764], [152, 257184], [155, 257444], [159, 257624], [166, 257964]]}, {"verse": 32, "start": 258800, "end": 265228, "text": "De otra manera, cuando aun el otro está lejos, le ruega por la paz, enviándole una delegación.", "words": [[0, 258800], [3, 258945], [8, 259125], [16, 259485], [23, 259725], [27, 260205], [30, 260445], [35, 260665], [40, 260885], [47, 261325], [50, 261785], [56, 262145], [60, 262325], [63, 262465], [68, 263145], [79, 263985], [83, 264245]]}, {"verse": 33, "start": 265578, "end": 272561, "text": "Así pues, cualquiera de vosotros que no renuncia a todas las cosas que posee, no puede ser mi discípulo.", "words": [[0, 265578], [4, 265870], [10, 266170], [21, 266850], [24, 266990], [33, 267590], [37, 267850], [40, 268070], [49, 268790], [51, 268950], [57, 269110], [61, 269410], [67, 269690], [71, 269930], [78, 270670], [81, 270930], [87, 271250], [91, 271570], [94, 271790]]}, {"verse": 34, "start": 272911, "end": 279211, "text": "Buena es la sal; pero si aun la sal pierde su sabor, ¿con qué se sazonará?", "words": [[0, 272911], [6, 273138], [9, 273398], [12, 273658], [17, 274365], [22, 274508], [25, 274768], [29, 275128], [32, 275348], [36, 275708], [43, 276228], [46, 276408], [53, 277388], [58, 277728], [62, 278028], [65, 278248]]}, {"verse": 35, "start": 279561, "end": 287687, "text": "Ni para la tierra, ni para el montón de estiércol es buena; fuera la arrojan. Quien tiene oídos para oír, oiga.", "words": [[0, 279609], [3, 279689], [8, 279910], [11, 280090], [19, 280559], [22, 281030], [27, 281210], [30, 281350], [37, 281790], [40, 282090], [50, 282389], [53, 282689], [60, 283551], [66, 283860], [69, 284385], [78, 285065], [84, 285288], [90, 285568], [96, 286048], [101, 286288], [106, 287188]]}]}