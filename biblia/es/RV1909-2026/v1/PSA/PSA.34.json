, 102456], [51, 103418], [53, 103546], [61, 104246], [63, 104446], [67, 104586], [77, 105266], [80, 105426]]}, {"verse": 19, "start": 106477, "end": 111399, "text": "Muchos son los males del justo; pero de todos ellos lo librará Jehová.", "words": [[0, 106477], [7, 106922], [11, 107122], [15, 107262], [21, 107602], [25, 107862], [32, 108672], [37, 108816], [40, 108976], [46, 109216], [52, 109616], [55, 110056], [63, 110696]]}, {"verse": 20, "start": 111399, "end": 115490, "text": "Él guarda todos sus huesos; ni uno de ellos será quebrantado.", "words": [[0, 111399], [3, 111399], [10, 111919], [16, 112139], [20, 112479], [28, 113513], [31, 113623], [35, 113883], [38, 114043], [44, 114283], [49, 114563]]}, {"verse": 21, "start": 115840, "end": 121012, "text": "Matará al malo la maldad; y los que aborrecen al justo serán asolados.", "words": [[0, 115840], [7, 116329], [10, 116609], [15, 117029], [18, 117189], [26, 118078], [28, 118181], [32, 118301], [36, 118441], [46, 119041], [49, 119221], [55, 119481], [61, 120041]]}, {"verse": 22, "start": 121362, "end": 127529, "text": "Jehová redime el alma de sus siervos; y no serán asolados cuantos en él confían.", "words": [[0, 121362], [7, 121957], [14, 122590], [17, 122790], [22, 123070], [25, 123230], [29, 123410], [38, 124412], [40, 124519], [43, 124659], [49, 125119], [58, 125839], [66, 126439], [69, 126599], [72, 126759]]}]}