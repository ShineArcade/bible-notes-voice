{"book": "PSA", "chapter": 80, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 129169, "verses": [{"verse": 1, "start": 300, "end": 13401, "text": "Al Músico principal: sobre Sosannim Eduth: Salmo de Asaf. OH Pastor de Israel, escucha: tú que pastoreas como a ovejas a José, que estás entre querubines, resplandece.", "words": [[0, 300], [3, 444], [10, 924], [21, 2164], [27, 2769], [36, 3416], [43, 4363], [49, 4804], [52, 4964], [58, 5900], [61, 5980], [68, 6340], [71, 6640], [79, 7015], [88, 8394], [91, 8454], [95, 8614], [105, 9274], [110, 9547], [112, 9821], [119, 10094], [121, 10194], [127, 10854], [131, 10934], [137, 11114], [143, 11434], [155, 12394]]}, {"verse": 2, "start": 13851, "end": 21079, "text": "Despierta tu valentía delante de Efraín, y de Benjamín, y de Manasés, y ven a salvarnos.", "words": [[0, 13851], [10, 14554], [13, 14734], [22, 15374], [30, 15834], [33, 16014], [41, 16774], [43, 16974], [46, 17094], [56, 17454], [58, 17954], [61, 18334], [70, 18714], [72, 19114], [76, 19254], [78, 19374]]}, {"verse": 3, "start": 21529, "end": 27643, "text": "Oh Dios, haznos volver; y haz resplandecer tu rostro, y seremos salvos.", "words": [[0, 21619], [3, 21739], [9, 21859], [16, 21979], [24, 23567], [26, 23888], [30, 24068], [43, 25268], [46, 25568], [54, 26208], [56, 26528], [64, 26888]]}, {"verse": 4, "start": 28093, "end": 34428, "text": "Jehová, Dios de los ejércitos, ¿hasta cuándo humearás tú contra la oración de tu pueblo?", "words": [[0, 28311], [8, 28565], [13, 28818], [16, 28938], [20, 29098], [31, 30418], [38, 30838], [45, 31418], [54, 31958], [57, 32198], [64, 32638], [67, 32878], [75, 33418], [78, 33598], [81, 33718]]}, {"verse": 5, "start": 34878, "end": 40354, "text": "Les diste a comer pan de lágrimas, y les diste a beber lágrimas en gran abundancia.", "words": [[0, 34878], [4, 35042], [10, 35442], [12, 35522], [18, 35802], [22, 36262], [25, 36462], [35, 37122], [37, 37442], [41, 37562], [47, 37922], [49, 37982], [55, 38182], [64, 38882], [67, 39102], [72, 39282]]}, {"verse": 6, "start": 40804, "end": 46675, "text": "Nos pusiste por contienda a nuestros vecinos: y nuestros enemigos se burlan entre sí.", "words": [[0, 40804], [4, 40929], [12, 41469], [16, 41709], [26, 42429], [28, 42729], [37, 42889], [46, 44127], [48, 44227], [57, 44467], [66, 45147], [69, 45347], [76, 45807], [82, 46187]]}, {"verse": 7, "start": 47125, "end": 54355, "text": "Oh Dios de los ejércitos, haznos volver; y haz resplandecer tu rostro, y seremos salvos.", "words": [[0, 47200], [3, 47310], [8, 47630], [11, 47970], [15, 48110], [26, 48760], [33, 49410], [41, 50279], [43, 50600], [47, 50780], [60, 51980], [63, 52280], [71, 52920], [73, 53240], [81, 53600]]}, {"verse": 8, "start": 54805, "end": 59763, "text": "Hiciste venir una vid de Egipto: echaste las naciones, y la plantaste.", "words": [[0, 54805], [8, 55309], [14, 55549], [18, 55829], [22, 56029], [25, 56289], [33, 57319], [41, 57845], [45, 58025], [55, 58565], [57, 58805], [60, 58905]]}, {"verse": 9, "start": 60213, "end": 66541, "text": "Limpiaste sitio delante de ella, e hiciste arraigar sus raíces, y llenó la tierra.", "words": [[0, 60213], [10, 61153], [16, 61633], [24, 62193], [27, 62413], [33, 62733], [35, 62953], [43, 63613], [52, 64213], [56, 64373], [64, 65053], [66, 65453], [72, 65793], [75, 65873]]}, {"verse": 10, "start": 66991, "end": 72541, "text": "Los montes fueron cubiertos de su sombra; y sus sarmientos como cedros de Dios.", "words": [[0, 66991], [4, 67293], [11, 67773], [18, 68033], [28, 68813], [31, 68933], [34, 69073], [42, 70053], [44, 70162], [48, 70582], [59, 71002], [64, 71282], [71, 71862], [74, 71982]]}, {"verse": 11, "start": 72991, "end": 77234, "text": "Extendió sus vástagos hasta el mar, y hasta el río sus renuevos.", "words": [[0, 72991], [9, 73717], [13, 73917], [22, 74657], [28, 74857], [31, 75057], [36, 75277], [38, 75517], [44, 75737], [47, 75957], [51, 76257], [55, 76437]]}, {"verse": 12, "start": 77684, "end": 83144, "text": "¿Por qué rompiste sus vallados, y la vendimian todos los que pasan por el camino?", "words": [[0, 77684], [5, 77809], [9, 78029], [18, 78789], [22, 79009], [32, 79649], [34, 80169], [37, 80599], [47, 81029], [53, 81329], [57, 81609], [61, 81789], [67, 82209], [71, 82389], [74, 82529]]}, {"verse": 13, "start": 83594, "end": 87530, "text": "La estropeó el jabalí, y la comió la bestia del campo.", "words": [[0, 83594], [3, 83757], [12, 84517], [15, 84637], [23, 85237], [25, 85617], [28, 85737], [34, 86137], [37, 86297], [44, 86697], [48, 86857]]}, {"verse": 14, "start": 87980, "end": 95111, "text": "Oh Dios de los ejércitos, vuelve ahora: mira desde el cielo, y considera, y visita esta viña,", "words": [[0, 88052], [3, 88162], [8, 88402], [11, 88702], [15, 88862], [26, 89622], [33, 90342], [40, 91173], [45, 91520], [51, 91780], [54, 92040], [61, 92460], [63, 92700], [74, 93640], [76, 93780], [83, 94240], [88, 94440]]}, {"verse": 15, "start": 95561, "end": 100677, "text": "Y la planta que plantó tu diestra, y el renuevo que para ti afirmaste.", "words": [[0, 95561], [2, 95664], [5, 95784], [12, 96204], [16, 96304], [23, 96764], [26, 96884], [35, 97464], [37, 98124], [40, 98304], [48, 98984], [52, 99124], [57, 99404], [60, 99664]]}, {"verse": 16, "start": 101127, "end": 106439, "text": "Quemada a fuego está, asolada: perezcan por la reprensión de tu rostro.", "words": [[0, 101127], [8, 101331], [10, 101571], [16, 101911], [22, 102311], [31, 103691], [40, 104358], [44, 104578], [47, 104998], [58, 105418], [61, 105638], [64, 105758]]}, {"verse": 17, "start": 106889, "end": 114195, "text": "Sea tu mano sobre el varón de tu diestra, sobre el hijo del hombre que para ti corroboraste.", "words": [[0, 106889], [4, 107113], [7, 107353], [12, 107653], [18, 108013], [21, 108233], [27, 108633], [30, 108733], [33, 108913], [42, 109973], [48, 110493], [51, 110833], [56, 111113], [60, 111353], [67, 111753], [71, 112233], [76, 112493], [79, 112813]]}, {"verse": 18, "start": 114645, "end": 119765, "text": "Así no nos volveremos de ti: vida nos darás, e invocaremos tu nombre.", "words": [[0, 114645], [4, 114872], [7, 115112], [11, 115252], [22, 115892], [25, 116052], [29, 116671], [34, 117038], [38, 117178], [45, 117738], [47, 118318], [59, 118978], [62, 119178]]}, {"verse": 19, "start": 120215, "end": 128769, "text": "Oh Jehová, Dios de los ejércitos, haznos volver; haz resplandecer tu rostro, y seremos salvos.", "words": [[0, 120215], [3, 120522], [11, 121542], [16, 121822], [19, 122082], [23, 122222], [34, 123362], [41, 123842], [49, 124886], [53, 125636], [66, 126386], [69, 126586], [77, 127166], [79, 127486], [87, 127906]]}]}