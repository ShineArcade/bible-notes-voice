{"book": "ROM", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 177019, "verses": [{"verse": 1, "start": 300, "end": 7271, "text": "¿Ignoráis, hermanos, (porque hablo con los que saben la ley) que la ley tiene autoridad sobre una persona mientras vive?", "words": [[0, 300], [11, 845], [21, 1805], [29, 2145], [35, 2525], [39, 2665], [43, 2785], [47, 2905], [53, 3165], [56, 3345], [61, 3965], [65, 4125], [68, 4285], [72, 4485], [78, 4805], [88, 5425], [94, 5705], [98, 5905], [106, 6345], [115, 6645]]}, {"verse": 2, "start": 7721, "end": 16049, "text": "Porque la mujer que está sujeta a marido, mientras el marido vive está obligada a la ley; pero muerto el marido, libre es de la ley del marido.", "words": [[0, 7721], [7, 7910], [10, 8110], [16, 8390], [20, 8650], [25, 8910], [32, 9530], [34, 9530], [42, 9950], [51, 10210], [54, 10550], [61, 10930], [66, 11190], [71, 11550], [80, 12130], [82, 12230], [85, 12310], [90, 13013], [95, 13137], [102, 13617], [105, 13757], [113, 14397], [119, 14717], [122, 14957], [125, 15077], [128, 15197], [132, 15377], [136, 15517]]}, {"verse": 3, "start": 16499, "end": 26790, "text": "Así que, viviendo el marido, se llamará adúltera si es de otro varón; pero si su marido muere, es libre de la ley; de tal manera que no será adúltera si es de otro marido.", "words": [[0, 16499], [4, 16669], [9, 16849], [18, 17269], [21, 17409], [29, 17869], [32, 18209], [40, 18609], [49, 19149], [52, 19509], [55, 19649], [58, 19789], [63, 19989], [70, 20798], [75, 20920], [78, 21080], [81, 21240], [88, 21600], [95, 22140], [98, 22300], [104, 22560], [107, 22760], [110, 22880], [115, 23497], [118, 23617], [122, 23797], [129, 24157], [133, 24397], [136, 24557], [141, 24797], [150, 25397], [153, 25677], [156, 25857], [159, 25977], [164, 26197]]}, {"verse": 4, "start": 27240, "end": 39363, "text": "Así también vosotros, hermanos míos, estáis muertos a la ley por el cuerpo de Cristo, para que seáis de otro, a saber, del que resucitó de los muertos, a fin de que fructifiquemos a Dios.", "words": [[0, 27240], [4, 27456], [12, 27896], [22, 28456], [31, 28876], [37, 29576], [44, 29976], [52, 30396], [54, 30576], [57, 30656], [61, 30876], [65, 31056], [68, 31156], [75, 31416], [78, 31636], [86, 32036], [91, 32596], [95, 32736], [101, 33116], [104, 33276], [110, 33896], [112, 33976], [119, 34376], [123, 34916], [127, 35056], [136, 35756], [139, 35836], [143, 35956], [152, 37331], [154, 37431], [158, 37631], [161, 37811], [165, 37931], [180, 38771], [182, 38911]]}, {"verse": 5, "start": 39813, "end": 47502, "text": "Porque mientras estábamos en la carne, las pasiones pecaminosas que eran por la ley, obraban en nuestros miembros fructificando para muerte.", "words": [[0, 39813], [7, 39957], [16, 40297], [26, 40977], [29, 41157], [32, 41257], [39, 42137], [43, 42237], [52, 42677], [64, 43437], [68, 43697], [73, 43897], [77, 44097], [80, 44237], [85, 44517], [93, 45177], [96, 45277], [105, 45477], [114, 46097], [128, 46917], [133, 47117]]}, {"verse": 6, "start": 47952, "end": 56818, "text": "Pero ahora estamos libres de la ley, habiendo muerto a aquella en la cual estábamos detenidos, para que sirvamos en novedad de espíritu, y no en vejez de letra.", "words": [[0, 47952], [5, 48080], [11, 48341], [19, 48680], [26, 49140], [29, 49241], [32, 49360], [37, 49921], [46, 50241], [53, 50430], [55, 50620], [63, 51080], [66, 51201], [69, 51280], [74, 51460], [84, 52040], [95, 52680], [100, 53180], [104, 53320], [113, 53841], [116, 54021], [124, 54460], [127, 54580], [137, 55360], [139, 55521], [142, 55748], [145, 55974], [151, 56201], [154, 56360]]}, {"verse": 7, "start": 57268, "end": 68155, "text": "¿Qué pues diremos? ¿La ley es pecado? En ninguna manera. Pero yo no conocí el pecado sino por la ley: porque tampoco conociera la codicia, si la ley no dijera: No codiciarás.", "words": [[0, 57268], [5, 57369], [10, 57549], [19, 58463], [23, 58586], [27, 58746], [30, 58946], [38, 59866], [41, 60005], [49, 60305], [57, 61254], [62, 61378], [65, 61518], [68, 61638], [75, 62058], [78, 62158], [85, 62538], [90, 62758], [94, 63018], [97, 63138], [102, 63832], [109, 63985], [117, 64305], [127, 64945], [130, 65065], [139, 65605], [142, 65765], [145, 65905], [149, 66085], [152, 66185], [160, 67085], [163, 67208]]}, {"verse": 8, "start": 68605, "end": 76229, "text": "Pero el pecado, tomando ocasión, obró en mí por el mandamiento toda clase de codicia: porque sin la ley el pecado está muerto.", "words": [[0, 68605], [5, 68744], [8, 68884], [16, 69324], [24, 69764], [33, 70604], [38, 71124], [41, 71264], [44, 71384], [48, 71604], [51, 71704], [63, 72284], [68, 72604], [74, 73004], [77, 73144], [86, 74116], [93, 74297], [97, 74497], [100, 74677], [104, 74877], [107, 75037], [114, 75477], [119, 75677]]}, {"verse": 9, "start": 76679, "end": 82875, "text": "Así que, yo sin la ley vivía por algún tiempo: pero venido el mandamiento, el pecado revivió, y yo morí.", "words": [[0, 76679], [4, 76924], [9, 77104], [12, 77304], [16, 77504], [19, 77664], [23, 77884], [29, 78244], [33, 78404], [39, 78624], [47, 79491], [52, 79649], [59, 80009], [62, 80109], [75, 80929], [78, 81049], [85, 81429], [94, 82029], [96, 82329], [99, 82449]]}, {"verse": 10, "start": 83325, "end": 87303, "text": "Y hallé que el mandamiento, destinado a dar vida, para mí era mortal:", "words": [[0, 83325], [2, 83428], [8, 83668], [12, 83768], [15, 83868], [28, 84488], [38, 85408], [40, 85508], [44, 85608], [50, 85908], [55, 86248], [58, 86468], [62, 86728]]}, {"verse": 11, "start": 87753, "end": 92701, "text": "Porque el pecado, tomando ocasión, me engañó por el mandamiento, y por él me mató.", "words": [[0, 87753], [7, 87984], [10, 88124], [18, 88544], [26, 89004], [35, 89664], [38, 90044], [45, 90544], [49, 90724], [52, 90844], [65, 91524], [67, 91844], [71, 92044], [74, 92164], [77, 92284]]}, {"verse": 12, "start": 93151, "end": 97914, "text": "De manera que la ley a la verdad es santa, y el mandamiento santo, y justo, y bueno.", "words": [[0, 93151], [3, 93253], [10, 93453], [14, 93713], [17, 93873], [21, 94093], [23, 94193], [26, 94273], [33, 94553], [36, 94813], [43, 95273], [45, 95573], [48, 95673], [60, 96193], [67, 96773], [69, 96973], [76, 97273], [78, 97473]]}, {"verse": 13, "start": 98364, "end": 108865, "text": "¿Luego lo que es bueno, a mí me es hecho muerte? No; sino que el pecado, para mostrarse pecado, por lo bueno me obró la muerte, haciéndose pecado sumamente pecaminoso por el mandamiento.", "words": [[0, 98364], [7, 98584], [10, 98764], [14, 98884], [17, 99024], [24, 99544], [26, 99564], [29, 99704], [32, 99804], [35, 99904], [41, 100124], [49, 101064], [53, 101728], [58, 101930], [62, 102150], [65, 102290], [73, 102670], [78, 102890], [88, 103450], [96, 103870], [100, 104070], [103, 104230], [109, 104450], [112, 104630], [117, 104830], [120, 104930], [128, 105670], [139, 106170], [146, 106590], [156, 107130], [167, 107790], [171, 107990], [174, 108090]]}, {"verse": 14, "start": 109315, "end": 114864, "text": "Porque sabemos que la ley es espiritual; pero yo soy carnal, vendido a sujeción del pecado.", "words": [[0, 109315], [7, 109510], [15, 109870], [19, 110150], [22, 110270], [26, 110470], [29, 110670], [41, 111821], [46, 111959], [49, 112159], [53, 112379], [61, 113039], [69, 113439], [71, 113519], [80, 114099], [84, 114239]]}, {"verse": 15, "start": 115314, "end": 121171, "text": "Porque lo que hago, no lo entiendo; ni lo que quiero, hago; antes lo que aborrezco, aquello hago.", "words": [[0, 115314], [7, 115513], [10, 115653], [14, 115813], [20, 116073], [23, 116353], [26, 116473], [36, 117424], [39, 117566], [42, 117706], [46, 117826], [54, 118346], [60, 119035], [66, 119299], [69, 119519], [73, 119639], [84, 120279], [92, 120779]]}, {"verse": 16, "start": 121621, "end": 125039, "text": "Y si lo que no quiero, esto hago, apruebo que la ley es buena.", "words": [[0, 121621], [2, 121729], [5, 121809], [8, 121929], [12, 122049], [15, 122169], [23, 122749], [28, 122969], [34, 123589], [42, 123989], [46, 124109], [49, 124229], [53, 124449], [56, 124589]]}, {"verse": 17, "start": 125489, "end": 129592, "text": "De manera que ya no obro aquello, sino el pecado que mora en mí.", "words": [[0, 125489], [3, 125612], [10, 125832], [14, 126112], [17, 126292], [20, 126432], [25, 126692], [34, 127192], [39, 127512], [42, 127692], [49, 128112], [53, 128272], [58, 128552], [61, 128632]]}, {"verse": 18, "start": 130042, "end": 137191, "text": "Y yo sé que en mí (es decir, en mi carne) no mora el bien: porque tengo el querer, pero efectuar el bien no lo alcanzo.", "words": [[0, 130042], [2, 130187], [5, 130327], [8, 130507], [12, 130687], [15, 130847], [18, 131327], [22, 131407], [29, 132007], [32, 132107], [35, 132227], [42, 132547], [45, 132827], [50, 133127], [53, 133187], [59, 133914], [66, 134100], [72, 134400], [75, 134560], [83, 135200], [88, 135360], [97, 135860], [100, 136000], [105, 136200], [108, 136420], [111, 136540]]}, {"verse": 19, "start": 137641, "end": 141681, "text": "Porque no hago el bien que quiero; pero el mal que no quiero, este hago.", "words": [[0, 137641], [7, 137825], [10, 138045], [15, 138245], [18, 138385], [23, 138525], [27, 138705], [35, 139494], [40, 139634], [43, 139794], [47, 139954], [51, 140154], [54, 140294], [62, 140994], [67, 141254]]}, {"verse": 20, "start": 142131, "end": 146143, "text": "Y si hago lo que no quiero, ya no lo hago yo, sino el pecado que mora en mí.", "words": [[0, 142131], [2, 142256], [5, 142376], [10, 142596], [13, 142736], [17, 142856], [20, 142996], [28, 143616], [31, 143796], [34, 143936], [37, 144076], [42, 144216], [46, 144596], [51, 144776], [54, 144936], [61, 145296], [65, 145456], [70, 145756], [73, 145856]]}, {"verse": 21, "start": 146593, "end": 151107, "text": "Así que, queriendo yo hacer el bien, hallo esta ley: Que el mal está en mí.", "words": [[0, 146593], [4, 146830], [9, 147030], [19, 147510], [22, 147690], [28, 147950], [31, 148170], [37, 148620], [43, 149070], [48, 149270], [53, 149955], [57, 150097], [60, 150177], [64, 150397], [69, 150677], [72, 150817]]}, {"verse": 22, "start": 151557, "end": 154909, "text": "Porque según el hombre interior, me deleito en la ley de Dios:", "words": [[0, 151557], [7, 151718], [13, 152078], [16, 152258], [23, 152438], [33, 152978], [36, 153378], [44, 153858], [47, 153978], [50, 154078], [54, 154238], [57, 154378]]}, {"verse": 23, "start": 155359, "end": 163188, "text": "Pero veo otra ley en mis miembros, que se rebela contra la ley de mi espíritu, y que me lleva cautivo a la ley del pecado que está en mis miembros.", "words": [[0, 155359], [5, 155519], [9, 155739], [14, 156039], [18, 156279], [21, 156439], [25, 156559], [35, 157099], [39, 157579], [42, 157859], [49, 158139], [56, 158399], [59, 158579], [63, 158739], [66, 158879], [69, 158979], [79, 159920], [81, 159999], [85, 160099], [88, 160219], [94, 160419], [102, 160919], [104, 161039], [107, 161099], [111, 161299], [115, 161459], [122, 161919], [126, 162059], [131, 162279], [134, 162399], [138, 162519]]}, {"verse": 24, "start": 163638, "end": 167550, "text": "¡Miserable hombre de mí! ¿quién me librará del cuerpo de esta muerte?", "words": [[0, 163638], [11, 164140], [18, 164520], [21, 164740], [25, 165321], [32, 165539], [35, 165639], [43, 166039], [47, 166219], [54, 166499], [57, 166779], [62, 166959]]}, {"verse": 25, "start": 168000, "end": 176619, "text": "Gracias doy a Dios, por Jesucristo Señor nuestro. Así que, yo mismo con la mente sirvo a la ley de Dios, pero con la carne a la ley del pecado.", "words": [[0, 168000], [8, 168339], [12, 168719], [14, 168779], [20, 169399], [24, 169519], [35, 170259], [41, 170439], [50, 171443], [54, 171595], [59, 171795], [62, 171955], [68, 172215], [72, 172475], [75, 172615], [81, 172875], [87, 173335], [89, 173435], [92, 173495], [96, 173695], [99, 173835], [105, 174515], [110, 174695], [114, 174895], [117, 175055], [123, 175375], [125, 175555], [128, 175655], [132, 175855], [136, 176015]]}]}