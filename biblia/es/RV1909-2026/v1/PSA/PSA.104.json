{"book": "PSA", "chapter": 104, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 223129, "verses": [{"verse": 1, "start": 300, "end": 9624, "text": "Bendice, alma mía, a Jehová. Jehová, Dios mío, mucho te has engrandecido; te has vestido de gloria y de magnificencia.", "words": [[0, 300], [9, 885], [14, 1205], [19, 1825], [21, 2085], [29, 2942], [37, 3342], [42, 3502], [47, 4262], [53, 4722], [56, 5243], [60, 5764], [74, 6529], [77, 6633], [81, 6733], [89, 7353], [92, 7493], [99, 8053], [101, 8253], [104, 8373]]}, {"verse": 2, "start": 10074, "end": 15984, "text": "El que se cubre de luz como de vestidura, que extiende los cielos como una cortina;", "words": [[0, 10074], [3, 10242], [7, 10382], [10, 10542], [16, 11002], [19, 11162], [23, 11342], [28, 11702], [31, 11882], [42, 12602], [46, 13162], [55, 13822], [59, 14002], [66, 14582], [71, 14802], [75, 15042]]}, {"verse": 3, "start": 16434, "end": 24722, "text": "Que establece sus aposentos entre las aguas; el que pone las nubes por su carroza, el que anda sobre las alas del viento;", "words": [[0, 16434], [4, 16535], [14, 17015], [18, 17155], [28, 17935], [34, 18155], [38, 18415], [45, 19379], [48, 19505], [52, 19646], [57, 19966], [61, 20185], [67, 20586], [71, 20806], [74, 21446], [83, 22086], [86, 22426], [90, 22606], [95, 22886], [101, 23266], [105, 23505], [110, 23845], [114, 24025]]}, {"verse": 4, "start": 25172, "end": 30185, "text": "El que hace a sus ángeles espíritus, sus ministros al fuego flameante.", "words": [[0, 25172], [3, 25297], [7, 25457], [12, 25757], [14, 25937], [18, 26037], [26, 26617], [37, 27737], [41, 27917], [51, 28617], [54, 28797], [60, 29097]]}, {"verse": 5, "start": 30635, "end": 35431, "text": "Él fundó la tierra sobre sus bases; no será jamás removida.", "words": [[0, 30635], [3, 30800], [9, 31260], [12, 31380], [19, 31740], [25, 32100], [29, 32340], [36, 33373], [39, 33746], [44, 33986], [50, 34718]]}, {"verse": 6, "start": 35881, "end": 40997, "text": "Con el abismo, como con vestido, la cubriste; sobre los montes estaban las aguas.", "words": [[0, 35881], [4, 36005], [7, 36145], [15, 36545], [20, 36825], [24, 37025], [33, 37605], [36, 37725], [46, 38784], [52, 39048], [56, 39268], [63, 39708], [71, 40068], [75, 40348]]}, {"verse": 7, "start": 41447, "end": 47381, "text": "A tu reprensión huyeron; al sonido de tu trueno se apresuraron;", "words": [[0, 41447], [2, 41759], [5, 41879], [16, 42679], [25, 43934], [28, 44313], [35, 45053], [38, 45233], [41, 45433], [48, 45893], [51, 46649]]}, {"verse": 8, "start": 47831, "end": 52694, "text": "Subieron los montes, descendieron los valles, al lugar que tú les fundaste.", "words": [[0, 47831], [9, 48289], [13, 48469], [21, 49409], [34, 50129], [38, 50349], [46, 50829], [49, 51209], [55, 51549], [59, 51769], [62, 51949], [66, 52129]]}, {"verse": 9, "start": 53144, "end": 59148, "text": "Les pusiste un límite, el cual no traspasarán; ni volverán a cubrir la tierra.", "words": [[0, 53144], [4, 53688], [12, 54168], [15, 54308], [23, 54888], [26, 55348], [31, 55508], [34, 55708], [47, 57170], [50, 57280], [59, 57860], [61, 58100], [68, 58340], [71, 58500]]}, {"verse": 10, "start": 59598, "end": 64578, "text": "Tú eres el que envías las fuentes por los arroyos; van entre los montes.", "words": [[0, 59598], [3, 59741], [8, 60000], [11, 60201], [15, 60360], [22, 60694], [26, 61028], [34, 61360], [38, 61601], [42, 61780], [51, 62869], [55, 63231], [61, 63531], [65, 63731]]}, {"verse": 11, "start": 65028, "end": 70939, "text": "Dan de beber a todas las bestias del campo: quebrantan su sed los asnos montaraces.", "words": [[0, 65028], [4, 65238], [7, 65398], [13, 65678], [15, 65858], [21, 66078], [25, 66358], [33, 66758], [37, 66878], [44, 68158], [55, 68468], [58, 68708], [62, 69068], [66, 69448], [72, 69908]]}, {"verse": 12, "start": 71389, "end": 77163, "text": "Junto a aquellos habitarán las aves de los cielos; entre las ramas dan voces.", "words": [[0, 71389], [6, 71651], [8, 71870], [17, 72170], [27, 73011], [31, 73190], [36, 73610], [39, 73750], [43, 73890], [51, 75049], [57, 75450], [61, 75690], [67, 76170], [71, 76667]]}, {"verse": 13, "start": 77613, "end": 84111, "text": "El que riega los montes desde sus aposentos: del fruto de sus obras se sacia la tierra.", "words": [[0, 77613], [3, 77759], [7, 77899], [13, 78339], [17, 78499], [24, 79039], [30, 79299], [34, 79599], [45, 80807], [49, 81147], [55, 81607], [58, 81747], [62, 81907], [68, 82347], [71, 82807], [77, 83287], [80, 83427]]}, {"verse": 14, "start": 84561, "end": 92278, "text": "El que hace producir el heno para las bestias, y la hierba para el servicio del hombre; sacando el pan de la tierra.", "words": [[0, 84561], [3, 84689], [7, 84849], [12, 85129], [21, 85809], [24, 86119], [29, 86429], [34, 86649], [38, 86829], [47, 87449], [49, 87869], [52, 87989], [59, 88509], [64, 88789], [67, 88949], [76, 89374], [80, 89799], [88, 90456], [96, 90899], [99, 91039], [103, 91359], [106, 91539], [109, 91639]]}, {"verse": 15, "start": 92728, "end": 102154, "text": "Y el vino que alegra el corazón del hombre, y el aceite que hace lucir el rostro, y el pan que sustenta el corazón del hombre.", "words": [[0, 92728], [2, 92871], [5, 93031], [10, 93331], [14, 93591], [21, 94031], [24, 94151], [32, 94551], [36, 94851], [44, 95831], [46, 96191], [49, 96351], [56, 96731], [60, 97071], [65, 97331], [71, 97871], [74, 98011], [82, 98791], [84, 98971], [87, 99131], [91, 99511], [95, 100011], [104, 100771], [107, 100911], [115, 101311], [119, 101651]]}, {"verse": 16, "start": 102604, "end": 107663, "text": "Se llenan de jugo los árboles de Jehová, los cedros del Líbano que él plantó.", "words": [[0, 102604], [3, 102767], [10, 103107], [13, 103287], [18, 103727], [22, 103887], [30, 104427], [33, 104567], [41, 105367], [45, 105447], [52, 105887], [56, 106067], [63, 106567], [67, 106787], [70, 106927]]}, {"verse": 17, "start": 108113, "end": 112741, "text": "Allí anidan las aves; en las hayas hace su casa la cigüeña.", "words": [[0, 108113], [5, 108452], [12, 108812], [16, 109052], [22, 110014], [25, 110180], [29, 110530], [35, 110880], [40, 111180], [43, 111420], [48, 111720], [51, 111940]]}, {"verse": 18, "start": 113191, "end": 118660, "text": "Los montes altos para las cabras monteses; las peñas, madrigueras para los conejos.", "words": [[0, 113191], [4, 113525], [11, 114005], [17, 114465], [22, 114645], [26, 114865], [33, 115285], [43, 116480], [47, 116611], [54, 116971], [66, 117611], [71, 117791], [75, 117931]]}, {"verse": 19, "start": 119110, "end": 123082, "text": "Hizo la luna para los tiempos: el sol conoce su ocaso.", "words": [[0, 119110], [5, 119491], [8, 119671], [13, 119971], [18, 120131], [22, 120291], [31, 121332], [34, 121432], [38, 121632], [45, 122212], [48, 122412]]}, {"verse": 20, "start": 123532, "end": 128693, "text": "Pone las tinieblas, y es la noche: en ella corretean todas las bestias de la selva.", "words": [[0, 123532], [5, 123757], [9, 123937], [20, 124577], [22, 124717], [25, 124797], [28, 124937], [35, 125747], [38, 125912], [43, 126412], [53, 127012], [59, 127252], [63, 127552], [71, 127932], [74, 128052], [77, 128152]]}, {"verse": 21, "start": 129143, "end": 132928, "text": "Los leoncillos rugen a la presa, y para buscar de Dios su comida.", "words": [[0, 129143], [4, 129291], [15, 130091], [21, 130411], [23, 130571], [26, 130651], [33, 131031], [35, 131111], [40, 131291], [47, 131611], [50, 131871], [55, 132091], [58, 132291]]}, {"verse": 22, "start": 133378, "end": 137094, "text": "Sale el sol, se recogen, y se echan en sus cuevas.", "words": [[0, 133378], [5, 133682], [8, 133942], [13, 134182], [16, 134402], [25, 135082], [27, 135602], [30, 135742], [36, 136002], [39, 136182], [43, 136362]]}, {"verse": 23, "start": 137544, "end": 142268, "text": "Sale el hombre a su labor, y a su labranza hasta la tarde.", "words": [[0, 137544], [5, 137890], [8, 138230], [15, 138530], [17, 138690], [20, 138810], [27, 139230], [29, 139971], [31, 140050], [34, 140170], [43, 140890], [49, 141510], [52, 141670]]}, {"verse": 24, "start": 142718, "end": 151535, "text": "¡Cuán muchas son tus obras, oh Jehová! Hiciste todas ellas con sabiduría: la tierra está llena de tus beneficios.", "words": [[0, 142718], [6, 142926], [13, 143266], [17, 143545], [21, 143725], [28, 144188], [31, 144650], [39, 145412], [47, 145970], [53, 146270], [59, 146670], [63, 147368], [74, 148305], [77, 148662], [84, 149022], [89, 149462], [95, 149902], [98, 150042], [102, 150242]]}, {"verse": 25, "start": 151985, "end": 160179, "text": "Asimismo esta gran mar y ancha de términos: en ella pescados sin número, animales pequeños y grandes.", "words": [[0, 151985], [9, 152710], [14, 153090], [19, 153530], [23, 153950], [25, 154210], [31, 154550], [34, 154690], [44, 155801], [47, 155969], [52, 156349], [61, 156729], [65, 157049], [73, 157629], [82, 158409], [91, 159289], [93, 159389]]}, {"verse": 26, "start": 160629, "end": 167194, "text": "Allí andan navíos; allí este leviathán que hiciste para que jugase en ella.", "words": [[0, 160629], [5, 161092], [11, 161712], [19, 162851], [24, 163243], [29, 163953], [39, 164663], [43, 164863], [51, 165463], [56, 165723], [60, 165903], [67, 166483], [70, 166703]]}, {"verse": 27, "start": 167644, "end": 172404, "text": "Todos ellos esperan en ti, para que les des su comida a su tiempo.", "words": [[0, 167644], [6, 167846], [12, 168186], [20, 168826], [23, 168986], [27, 169246], [32, 170006], [36, 170146], [40, 170286], [44, 170546], [47, 170986], [54, 171346], [56, 171666], [59, 171766]]}, {"verse": 28, "start": 172854, "end": 176938, "text": "Les das, recogen; abres tu mano, se hartan de bien.", "words": [[0, 172854], [4, 172963], [9, 173563], [18, 174647], [24, 175114], [27, 175294], [33, 175734], [36, 175874], [43, 176334], [46, 176454]]}, {"verse": 29, "start": 177388, "end": 185119, "text": "Escondes tu rostro, se turban: les quitas el espíritu, dejan de ser, y se convierten en su polvo.", "words": [[0, 177388], [9, 178068], [12, 178228], [20, 178708], [23, 178848], [31, 179897], [35, 180018], [42, 180478], [45, 180618], [55, 181718], [61, 182198], [64, 182378], [69, 182698], [71, 183158], [74, 183318], [85, 183978], [88, 184358], [91, 184518]]}, {"verse": 30, "start": 185569, "end": 190379, "text": "Envías tu espíritu, son creados: y renuevas la faz de la tierra.", "words": [[0, 185569], [7, 185975], [10, 186115], [20, 186655], [24, 186735], [33, 187837], [35, 187973], [44, 188693], [47, 189033], [51, 189333], [54, 189613], [57, 189733]]}, {"verse": 31, "start": 190829, "end": 195396, "text": "Sea la gloria de Jehová para siempre; alégrese Jehová en sus obras;", "words": [[0, 190829], [4, 190993], [7, 191253], [14, 191513], [17, 191823], [24, 192133], [29, 192293], [38, 193277], [47, 193768], [54, 194288], [57, 194428], [61, 194568]]}, {"verse": 32, "start": 195846, "end": 201203, "text": "El cual mira a la tierra, y ella tiembla; toca los montes, y humean.", "words": [[0, 195846], [3, 196013], [8, 196213], [13, 196553], [15, 196773], [18, 196853], [26, 197353], [28, 197893], [33, 198113], [42, 199110], [47, 199292], [51, 199492], [59, 200172], [61, 200492]]}, {"verse": 33, "start": 201653, "end": 206955, "text": "A Jehová cantaré en mi vida: a mi Dios cantaré salmos mientras viva.", "words": [[0, 201653], [2, 201791], [9, 202191], [17, 202671], [20, 202931], [23, 203111], [29, 203914], [31, 204114], [34, 204254], [39, 204494], [47, 204994], [54, 205654], [63, 206094]]}, {"verse": 34, "start": 207405, "end": 212446, "text": "Dulce será mi meditación en él: yo me alegraré en Jehová.", "words": [[0, 207405], [6, 208014], [11, 208334], [14, 208574], [25, 209414], [28, 209674], [32, 210457], [35, 210577], [38, 210757], [47, 211457], [50, 211970]]}, {"verse": 35, "start": 212896, "end": 222729, "text": "Sean consumidos de la tierra los pecadores, y los impíos dejen de ser. Bendice, alma mía, a Jehová. Aleluya.", "words": [[0, 212896], [5, 213154], [16, 213994], [19, 214134], [22, 214234], [29, 214714], [33, 214814], [44, 215434], [46, 216054], [50, 216214], [57, 217054], [63, 217694], [66, 217874], [71, 219041], [80, 219411], [85, 219871], [90, 220471], [92, 220771], [100, 222271]]}]}