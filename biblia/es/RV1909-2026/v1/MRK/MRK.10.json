{"book": "MRK", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 432060, "verses": [{"verse": 1, "start": 300, "end": 10747, "text": "Y partiéndose de allí, vino a la región de Judea y tras el Jordán: y volvió el pueblo a juntarse a él; y de nuevo les enseñaba como solía.", "words": [[0, 300], [2, 402], [14, 1302], [17, 1522], [23, 1882], [28, 2842], [30, 3102], [33, 3182], [40, 3542], [43, 3742], [49, 4282], [51, 4402], [56, 4602], [59, 4842], [67, 5814], [69, 6182], [76, 6562], [79, 6662], [86, 6882], [88, 7122], [97, 7662], [99, 7802], [103, 8022], [105, 8262], [108, 8582], [114, 8822], [118, 9142], [127, 9822], [132, 10082]]}, {"verse": 2, "start": 11097, "end": 19333, "text": "Y llegándose los fariseos, le preguntaron, para ponerlo a prueba, si era lícito al marido divorciarse de su mujer.", "words": [[0, 11097], [2, 11218], [13, 11938], [17, 12138], [27, 12978], [30, 13678], [43, 14378], [48, 14693], [56, 15253], [58, 15353], [66, 15753], [69, 16393], [73, 16553], [80, 17073], [83, 17253], [90, 17653], [102, 18453], [105, 18673], [108, 18833]]}, {"verse": 3, "start": 19333, "end": 22529, "text": "Pero él respondiendo, les dijo: ¿Qué os mandó Moisés?", "words": [[0, 19333], [5, 19333], [8, 19333], [22, 20273], [26, 20373], [32, 21096], [37, 21197], [40, 21337], [46, 21717]]}, {"verse": 4, "start": 22879, "end": 28312, "text": "Y ellos dijeron: Moisés permitió escribir un certificado de divorcio y divorciarse.", "words": [[0, 22879], [2, 23006], [8, 23166], [17, 24029], [24, 24373], [33, 25073], [42, 25553], [45, 25673], [57, 26453], [60, 26573], [69, 27213], [71, 27433]]}, {"verse": 5, "start": 28592, "end": 34724, "text": "Y respondiendo Jesús, les dijo: Por la dureza de vuestro corazón os escribió este mandamiento;", "words": [[0, 28592], [2, 28714], [15, 29374], [22, 29754], [26, 30274], [32, 31017], [36, 31140], [39, 31340], [46, 31800], [49, 31960], [57, 32340], [65, 32820], [68, 33080], [77, 33660], [82, 33820]]}, {"verse": 6, "start": 35074, "end": 39536, "text": "Pero al principio de la creación, varón y hembra los hizo Dios.", "words": [[0, 35074], [5, 35215], [8, 35395], [18, 35935], [21, 36295], [24, 36435], [34, 37335], [40, 37895], [42, 38115], [49, 38535], [53, 38695], [58, 38955]]}, {"verse": 7, "start": 39886, "end": 44741, "text": "Por esto dejará el hombre a su padre y a su madre, y se juntará a su mujer.", "words": [[0, 39886], [4, 39988], [9, 40248], [16, 40808], [19, 40948], [26, 41208], [28, 41368], [31, 41468], [37, 41868], [39, 42128], [41, 42188], [44, 42348], [51, 42728], [53, 43288], [56, 43428], [64, 43948], [66, 44048], [69, 44168]]}, {"verse": 8, "start": 45091, "end": 51390, "text": "Y los que eran dos, serán hechos una carne: así que no son más dos, sino una carne.", "words": [[0, 45091], [2, 45176], [6, 45296], [10, 45476], [15, 45696], [20, 46016], [26, 46836], [33, 47196], [37, 47496], [44, 48341], [48, 48581], [52, 48761], [55, 48901], [59, 49201], [63, 49401], [68, 50261], [73, 50441], [77, 50681]]}, {"verse": 9, "start": 51740, "end": 54859, "text": "Pues lo que Dios juntó, no lo aparte el hombre.", "words": [[0, 51740], [5, 51902], [8, 52242], [12, 52402], [17, 52562], [24, 52942], [27, 53337], [30, 53477], [37, 54037], [40, 54257]]}, {"verse": 10, "start": 55209, "end": 59682, "text": "Y en casa volvieron los discípulos a preguntarle de lo mismo.", "words": [[0, 55209], [2, 55354], [5, 55494], [10, 55894], [20, 56874], [24, 57094], [35, 57814], [37, 57994], [49, 58794], [52, 58954], [55, 59074]]}, {"verse": 11, "start": 60032, "end": 67198, "text": "Y les dice: Cualquiera que se divorcie de su mujer y se case con otra, comete adulterio contra ella:", "words": [[0, 60213], [2, 60428], [6, 60642], [12, 61074], [23, 61576], [27, 61716], [30, 61876], [39, 62436], [42, 62576], [45, 62756], [51, 63156], [53, 63436], [56, 63576], [61, 63836], [65, 64136], [71, 65076], [78, 65436], [88, 66256], [95, 66576]]}, {"verse": 12, "start": 67548, "end": 72610, "text": "Y si la mujer se divorcia de su marido y se casa con otro, comete adulterio.", "words": [[0, 67548], [2, 67654], [5, 67774], [8, 67914], [14, 68194], [17, 68454], [26, 69034], [29, 69154], [32, 69334], [39, 69774], [41, 69874], [44, 69994], [49, 70234], [53, 70534], [59, 71194], [66, 71734]]}, {"verse": 13, "start": 72960, "end": 80215, "text": "Y le presentaban niños para que los tocase; y los discípulos reprendían a quienes los presentaban.", "words": [[0, 72960], [2, 73068], [5, 73188], [17, 73848], [23, 74388], [28, 74968], [32, 75108], [36, 75268], [44, 76311], [46, 76419], [50, 76559], [61, 77359], [72, 78499], [74, 78719], [82, 78979], [86, 79219]]}, {"verse": 14, "start": 80565, "end": 90175, "text": "Y viéndolo Jesús, se enojó, y les dijo: Dejad que los niños vengan, y no se lo impidáis; porque de los tales es el reino de Dios.", "words": [[0, 80565], [2, 80693], [11, 81133], [18, 81433], [21, 81813], [28, 82753], [30, 82903], [34, 83053], [40, 83807], [46, 84447], [50, 84587], [54, 84747], [60, 85197], [68, 85648], [70, 86027], [73, 86187], [76, 86367], [79, 86488], [89, 87682], [96, 87904], [99, 88064], [103, 88224], [109, 88464], [112, 88764], [115, 88964], [121, 89364], [124, 89524]]}, {"verse": 15, "start": 90525, "end": 96849, "text": "De cierto os digo, que el que no reciba el reino de Dios como un niño, no entrará en él.", "words": [[0, 90730], [3, 90970], [10, 91210], [13, 91470], [19, 91750], [23, 92310], [26, 92430], [30, 92570], [33, 92750], [40, 93310], [43, 93430], [49, 93790], [52, 93950], [57, 94170], [62, 94450], [65, 94670], [71, 95110], [74, 95650], [82, 96290], [85, 96490]]}, {"verse": 16, "start": 97199, "end": 102456, "text": "Y tomándolos en los brazos, poniendo las manos sobre ellos, los bendecía.", "words": [[0, 97199], [2, 97303], [13, 97983], [16, 98123], [20, 98243], [28, 99223], [37, 99723], [41, 99903], [47, 100203], [53, 100603], [60, 101523], [64, 101623]]}, {"verse": 17, "start": 102806, "end": 114665, "text": "Y saliendo él para ir su camino, vino uno corriendo, y arrodillándose delante de él, le preguntó: Maestro bueno, ¿qué haré para heredar la vida eterna?", "words": [[0, 102806], [2, 102910], [11, 103450], [14, 103750], [19, 103990], [22, 104210], [25, 104430], [33, 104930], [38, 105750], [42, 106030], [53, 106750], [55, 107230], [70, 108270], [78, 108810], [81, 108990], [85, 109190], [88, 109490], [98, 110504], [106, 111064], [113, 111864], [118, 111964], [123, 112264], [128, 112444], [136, 112924], [139, 113044], [144, 113244]]}, {"verse": 18, "start": 114945, "end": 121307, "text": "Y Jesús le dijo: ¿Por qué me dices bueno? Ninguno hay bueno, sino sólo uno, Dios.", "words": [[0, 114945], [2, 115090], [8, 115470], [11, 115830], [17, 116545], [22, 116648], [26, 116848], [29, 116988], [35, 117308], [42, 118104], [50, 118941], [54, 119201], [61, 119561], [66, 119881], [71, 120281], [76, 120661]]}, {"verse": 19, "start": 121657, "end": 131900, "text": "Los mandamientos sabes: No adulteres: No mates: No robes: No digas falso testimonio: No defraudes: Honra a tu padre y a tu madre.", "words": [[0, 121657], [4, 121765], [17, 122405], [24, 123143], [27, 123323], [38, 124332], [41, 124552], [48, 125223], [51, 125378], [58, 126153], [61, 126373], [67, 126733], [73, 127173], [85, 128187], [88, 128630], [99, 129286], [105, 129932], [107, 130132], [110, 130252], [116, 130672], [118, 131057], [120, 131137], [123, 131257]]}, {"verse": 20, "start": 132250, "end": 137930, "text": "Él entonces respondiendo, le dijo: Maestro, todo esto he guardado desde mi juventud.", "words": [[0, 132250], [3, 132432], [12, 133392], [26, 134172], [29, 134252], [35, 134955], [44, 135597], [49, 135697], [54, 136077], [57, 136257], [66, 136797], [72, 136977], [75, 137237]]}, {"verse": 21, "start": 138210, "end": 152365, "text": "Entonces Jesús mirándole, le amó, y le dijo: Una cosa te falta: ve, vende todo lo que tienes, y da a los pobres, y tendrás tesoro en el cielo; y ven, sígueme, tomando tu cruz.", "words": [[0, 138210], [9, 138697], [15, 139817], [26, 140517], [29, 140517], [34, 141177], [36, 141397], [39, 141497], [45, 142270], [49, 142456], [54, 142676], [57, 142896], [64, 143790], [68, 144177], [74, 144437], [79, 144717], [82, 144917], [86, 145057], [94, 145497], [96, 146137], [99, 146337], [101, 146477], [105, 146597], [113, 147197], [115, 147657], [123, 148057], [130, 148477], [133, 148617], [136, 148757], [143, 149649], [145, 149773], [150, 150013], [159, 150893], [167, 151553], [170, 151773]]}, {"verse": 22, "start": 152715, "end": 158825, "text": "Pero él, entristecido por esta palabra, se fue triste, porque tenía muchas posesiones.", "words": [[0, 152715], [5, 152897], [9, 153177], [22, 154337], [26, 154577], [31, 154757], [40, 155317], [43, 155682], [47, 155862], [55, 156722], [62, 157002], [68, 157382], [75, 157782]]}, {"verse": 23, "start": 159175, "end": 168825, "text": "Entonces Jesús, mirando alrededor, dice a sus discípulos: ¡Cuán difícilmente entrarán en el reino de Dios los que tienen riquezas!", "words": [[0, 159175], [9, 159919], [16, 160959], [24, 161359], [35, 162639], [40, 162899], [42, 163059], [46, 163239], [58, 164365], [64, 164572], [77, 165432], [86, 166152], [89, 166292], [92, 166452], [98, 166832], [101, 166992], [106, 167232], [110, 167432], [114, 167612], [121, 167912]]}, {"verse": 24, "start": 169175, "end": 182909, "text": "Y los discípulos se espantaron de sus palabras; pero Jesús respondiendo, les volvió a decir: ¡Hijos, cuán difícil es para los que confían en las riquezas entrar en el reino de Dios!", "words": [[0, 169175], [2, 169264], [6, 169404], [17, 170084], [20, 170284], [31, 171124], [34, 171284], [38, 171464], [48, 172525], [53, 172673], [59, 173233], [73, 174613], [77, 174733], [84, 175333], [86, 175453], [93, 176168], [101, 176570], [106, 177090], [114, 177450], [117, 177910], [122, 178550], [126, 178730], [130, 178890], [138, 179490], [141, 179670], [145, 179850], [154, 180410], [161, 181110], [164, 181530], [167, 181690], [173, 182130], [176, 182290]]}, {"verse": 25, "start": 183259, "end": 190463, "text": "Más fácil es pasar un camello por el ojo de una aguja, que el rico entrar en el reino de Dios.", "words": [[0, 183259], [4, 183607], [10, 184147], [13, 184447], [19, 184827], [22, 185107], [30, 185667], [34, 185907], [37, 186067], [41, 186387], [44, 186507], [48, 186727], [55, 187567], [59, 187847], [62, 188047], [67, 188287], [74, 188827], [77, 189067], [80, 189227], [86, 189707], [89, 189867]]}, {"verse": 26, "start": 190813, "end": 196238, "text": "Y ellos se espantaban más, diciendo dentro de sí: ¿Y quién podrá salvarse?", "words": [[0, 190813], [2, 190980], [8, 191220], [11, 191480], [22, 192320], [27, 192720], [36, 193380], [43, 194000], [46, 194280], [50, 194797], [53, 194919], [59, 195119], [65, 195479]]}, {"verse": 27, "start": 196518, "end": 206276, "text": "Entonces Jesús mirándolos, dice: Para los hombres es imposible; pero para Dios, no; porque todas las cosas son posibles para Dios.", "words": [[0, 196518], [9, 197403], [15, 198156], [27, 198936], [33, 199658], [38, 199824], [42, 200004], [50, 200384], [53, 200604], [64, 201926], [69, 202090], [74, 202330], [80, 203030], [84, 203511], [91, 203694], [97, 204014], [101, 204294], [107, 204614], [111, 204934], [120, 205474], [125, 205714]]}, {"verse": 28, "start": 206626, "end": 213209, "text": "Entonces Pedro comenzó a decirle: He aquí, nosotros hemos dejado todas las cosas, y te hemos seguido.", "words": [[0, 206626], [9, 207231], [15, 207611], [23, 208231], [25, 208351], [34, 209259], [37, 209400], [43, 209820], [52, 210080], [58, 210480], [65, 210980], [71, 211160], [75, 211460], [82, 211800], [84, 212320], [87, 212460], [93, 212640]]}, {"verse": 29, "start": 213489, "end": 227393, "text": "Y respondiendo Jesús, dijo: De cierto os digo, que no hay ninguno que haya dejado casa, o hermanos, o hermanas, o padre, o madre, o mujer, o hijos, o tierras, por causa de mí y del evangelio,", "words": [[0, 213489], [2, 213615], [15, 214375], [22, 214715], [28, 216033], [31, 216238], [38, 216443], [41, 216648], [47, 217008], [51, 217248], [54, 217468], [58, 217628], [66, 218168], [70, 218308], [75, 218628], [82, 218948], [88, 219328], [90, 219723], [100, 220463], [102, 220783], [112, 221343], [114, 221623], [121, 222003], [123, 222283], [130, 222623], [132, 222843], [139, 223183], [141, 223443], [148, 223763], [150, 224003], [159, 224959], [163, 225101], [169, 225461], [172, 225781], [175, 226001], [177, 226281], [181, 226441]]}, {"verse": 30, "start": 227743, "end": 240087, "text": "Que no reciba cien veces más ahora en este tiempo, casas, y hermanos, y hermanas, y madres, e hijos, y tierras, con persecuciones; y en el siglo venidero la vida eterna.", "words": [[0, 227743], [4, 227827], [7, 228237], [14, 228647], [19, 228927], [25, 229207], [29, 229487], [35, 229887], [38, 230027], [43, 230207], [51, 231107], [58, 231807], [60, 232007], [70, 232607], [72, 232787], [82, 233307], [84, 233647], [92, 234107], [94, 234307], [101, 234820], [103, 235334], [112, 235847], [116, 236047], [131, 237517], [133, 237641], [136, 237781], [139, 237901], [145, 238281], [154, 238961], [157, 239081], [162, 239301]]}, {"verse": 31, "start": 240437, "end": 245212, "text": "Pero muchos de los primeros serán últimos, y los últimos serán primeros.", "words": [[0, 240437], [5, 240697], [12, 241117], [15, 241317], [19, 241437], [28, 241957], [34, 242317], [43, 242837], [45, 243377], [49, 243537], [57, 243917], [63, 244397]]}, {"verse": 32, "start": 245562, "end": 262041, "text": "Y estaban en el camino subiendo a Jerusalén; y Jesús iba delante de ellos, y se espantaban, y le seguían con miedo: entonces volviendo a tomar a los doce aparte, les comenzó a decir las cosas que le habían de acontecer:", "words": [[0, 245562], [2, 245667], [10, 246007], [13, 246247], [16, 246387], [23, 246827], [32, 247707], [34, 247827], [45, 248889], [47, 248999], [53, 249359], [57, 249919], [65, 250479], [68, 250679], [75, 250999], [77, 251299], [80, 251459], [92, 252399], [94, 253079], [97, 253199], [105, 253679], [109, 253859], [116, 254635], [125, 255731], [135, 256211], [137, 256331], [143, 256651], [145, 256871], [149, 256991], [154, 257371], [162, 258371], [166, 258471], [174, 259131], [176, 259231], [182, 259511], [186, 259871], [192, 260291], [196, 260531], [199, 260691], [206, 260991], [209, 261211]]}, {"verse": 33, "start": 262391, "end": 275118, "text": "He aquí subimos a Jerusalén, y el Hijo del hombre será entregado a los principales sacerdotes, y a los escribas, y le condenarán a muerte, y le entregarán a los Gentiles:", "words": [[0, 262442], [3, 262532], [8, 262712], [16, 263312], [18, 263452], [29, 264192], [31, 264732], [34, 264852], [39, 265132], [43, 265272], [50, 265712], [55, 265952], [65, 266952], [67, 267092], [71, 267192], [83, 268012], [95, 268932], [97, 269412], [99, 269492], [103, 269612], [113, 270412], [115, 271092], [118, 271212], [129, 271912], [131, 271972], [139, 272885], [141, 272990], [144, 273130], [155, 273850], [157, 274010], [161, 274130]]}, {"verse": 34, "start": 275468, "end": 284303, "text": "Y se burlarán de él, y le golpearán con látigos, y escupirán en él, y le matarán; pero al tercer día resucitará.", "words": [[0, 275468], [2, 275588], [5, 276008], [14, 276428], [17, 276608], [21, 276908], [23, 277408], [26, 277528], [36, 278228], [40, 278388], [49, 279028], [51, 279548], [61, 280228], [64, 280368], [68, 280648], [70, 281028], [73, 281128], [82, 282110], [87, 282272], [90, 282472], [97, 282732], [101, 283152]]}, {"verse": 35, "start": 284653, "end": 293557, "text": "Entonces Jacobo y Juan, hijos de Zebedeo, se llegaron a él, diciendo: Maestro, querríamos que nos hagas lo que pidamos.", "words": [[0, 284653], [9, 285338], [16, 286398], [18, 286518], [24, 287298], [30, 287538], [33, 288088], [42, 288638], [45, 288778], [54, 289258], [56, 289378], [60, 289638], [70, 290821], [79, 291426], [90, 291866], [94, 292126], [98, 292306], [104, 292646], [107, 292766], [111, 292866]]}, {"verse": 36, "start": 293837, "end": 296343, "text": "Y él les dijo: ¿Qué queréis que os haga?", "words": [[0, 293837], [2, 294023], [5, 294163], [9, 294303], [15, 295005], [20, 295108], [28, 295488], [32, 295668], [35, 295828]]}, {"verse": 37, "start": 296693, "end": 303299, "text": "Y ellos le dijeron: Danos que en tu gloria nos sentemos el uno a tu derecha, y el otro a tu izquierda.", "words": [[0, 296693], [2, 296873], [8, 297093], [11, 297313], [20, 298238], [26, 298663], [30, 298823], [33, 298943], [36, 299063], [43, 299423], [47, 299583], [56, 300203], [59, 300503], [63, 300703], [65, 300883], [68, 300983], [77, 301843], [79, 302023], [82, 302163], [87, 302363], [89, 302543], [92, 302663]]}, {"verse": 38, "start": 303579, "end": 313353, "text": "Entonces Jesús les dijo: No sabéis lo que pedís. ¿Podéis beber del vaso que yo bebo, o ser bautizados del bautismo de que yo soy bautizado?", "words": [[0, 303579], [9, 304085], [15, 304403], [19, 304720], [25, 306004], [28, 306144], [35, 306584], [38, 306744], [42, 306864], [49, 307686], [57, 308052], [63, 308352], [67, 308672], [72, 309072], [76, 309132], [79, 309332], [85, 309712], [87, 310052], [91, 310472], [102, 310892], [106, 311192], [115, 311752], [118, 311932], [122, 312052], [125, 312232], [129, 312452]]}, {"verse": 39, "start": 313703, "end": 325782, "text": "Y ellos dijeron: Podemos. Y Jesús les dijo: A la verdad, del vaso que yo bebo, beberéis; y del bautismo de que yo soy bautizado, seréis bautizados.", "words": [[0, 313703], [2, 313830], [8, 313990], [17, 314853], [26, 315798], [28, 315922], [34, 316342], [38, 316802], [44, 317519], [46, 317689], [49, 317769], [57, 318049], [61, 318729], [66, 319149], [70, 319249], [73, 319469], [79, 319809], [89, 321130], [91, 321255], [95, 321415], [104, 322135], [107, 322555], [111, 322695], [114, 322895], [118, 323115], [129, 324215], [136, 324635]]}, {"verse": 40, "start": 326132, "end": 332583, "text": "Pero que os sentéis a mi derecha y a mi izquierda, no es mío darlo, sino a quienes está preparado.", "words": [[0, 326132], [5, 326279], [9, 326479], [12, 326659], [20, 327239], [22, 327379], [25, 327499], [33, 328019], [35, 328179], [37, 328259], [40, 328439], [51, 329359], [54, 329559], [57, 329679], [61, 329999], [68, 330739], [73, 330979], [75, 331179], [83, 331319], [88, 331779]]}, {"verse": 41, "start": 332933, "end": 338221, "text": "Y como lo oyeron los diez, comenzaron a enojarse de Jacobo y de Juan.", "words": [[0, 332933], [2, 333036], [7, 333276], [10, 333476], [17, 334096], [21, 334236], [27, 335076], [38, 335796], [40, 335976], [49, 336616], [52, 336776], [59, 337396], [61, 337516], [64, 337616]]}, {"verse": 42, "start": 338571, "end": 350626, "text": "Pero Jesús, llamándolos, les dice: Sabéis que los que son reconocidos como gobernantes entre las naciones, las dominan, y los que entre ellas son grandes, tienen sobre ellas autoridad.", "words": [[0, 338571], [5, 338714], [12, 339254], [25, 339894], [29, 340534], [35, 341267], [42, 341650], [46, 341870], [50, 342210], [54, 342410], [58, 342690], [70, 343470], [75, 343710], [87, 344390], [93, 344650], [97, 344870], [107, 345390], [111, 345850], [120, 346490], [122, 346930], [126, 347090], [130, 347230], [136, 347450], [142, 347750], [146, 348010], [155, 348410], [162, 348945], [168, 349305], [174, 349665]]}, {"verse": 43, "start": 350976, "end": 358675, "text": "Pero no será así entre vosotros, sino que el que quiera hacerse grande entre vosotros será vuestro servidor;", "words": [[0, 350976], [5, 351140], [8, 351360], [13, 351620], [17, 352040], [23, 352360], [33, 353540], [38, 353920], [42, 354220], [45, 354540], [49, 354720], [56, 355160], [64, 355840], [71, 356240], [77, 356580], [86, 357200], [91, 357480], [99, 357900]]}, {"verse": 44, "start": 359025, "end": 363575, "text": "Y el que de vosotros quiera ser el primero, será siervo de todos.", "words": [[0, 359025], [2, 359235], [5, 359395], [9, 359595], [12, 359735], [21, 360255], [28, 360655], [32, 360855], [35, 361035], [44, 361595], [49, 362090], [56, 362770], [59, 362910]]}, {"verse": 45, "start": 363925, "end": 371861, "text": "Porque el Hijo del hombre tampoco vino para ser servido, sino para servir, y dar su vida en rescate por muchos.", "words": [[0, 363925], [7, 364189], [10, 364549], [15, 364809], [19, 364949], [26, 365329], [34, 365609], [39, 366189], [44, 366509], [48, 366769], [57, 367909], [62, 368209], [67, 368449], [75, 368929], [77, 369429], [81, 369629], [84, 369849], [89, 370149], [92, 370269], [100, 370829], [104, 371089]]}, {"verse": 46, "start": 372211, "end": 386050, "text": "Entonces vienen a Jericó: y saliendo él de Jericó y sus discípulos y una gran multitud, Bartimeo el ciego, hijo de Timeo, estaba sentado junto al camino mendigando.", "words": [[0, 372211], [9, 372713], [16, 373073], [18, 373293], [26, 374082], [28, 374244], [37, 374824], [40, 375164], [43, 375364], [50, 376044], [52, 376219], [56, 376419], [67, 377259], [69, 377424], [73, 377584], [78, 377844], [88, 379064], [97, 380264], [100, 380384], [107, 381464], [112, 381664], [115, 381864], [122, 382824], [129, 383144], [137, 383904], [143, 384184], [146, 384484], [153, 384904]]}, {"verse": 47, "start": 386400, "end": 394862, "text": "Y oyendo que era Jesús el nazareno, comenzó a dar voces y decir: Jesús, Hijo de David, ten misericordia de mí.", "words": [[0, 386400], [2, 386565], [9, 386925], [13, 387185], [17, 387385], [23, 388125], [26, 388285], [36, 389425], [44, 390125], [46, 390245], [50, 390345], [56, 390865], [58, 391025], [65, 391847], [72, 392395], [77, 392615], [80, 392735], [87, 393195], [91, 393655], [104, 394435], [107, 394575]]}, {"verse": 48, "start": 395142, "end": 403160, "text": "Y muchos le reprendían, que callase: pero él daba mayores voces: Hijo de David, ten misericordia de mí.", "words": [[0, 395142], [2, 395264], [9, 395664], [12, 396064], [24, 396924], [28, 397129], [37, 398141], [42, 398328], [45, 398748], [50, 399328], [58, 399748], [65, 400712], [70, 400969], [73, 401109], [80, 401669], [84, 401789], [97, 402589], [100, 402729]]}, {"verse": 49, "start": 403440, "end": 411270, "text": "Entonces Jesús parándose, mandó llamarle: y llaman al ciego, diciéndole: Ten ánimo: levántate, te llama.", "words": [[0, 403440], [9, 403845], [15, 404305], [26, 405245], [32, 405805], [42, 406721], [44, 406849], [51, 407129], [54, 407329], [61, 408169], [73, 409472], [77, 409706], [84, 410127], [95, 410455], [98, 410825]]}, {"verse": 50, "start": 411550, "end": 416292, "text": "Él entonces, echando su capa, se levantó, y vino a Jesús.", "words": [[0, 411550], [3, 411833], [13, 412493], [21, 413133], [24, 413333], [30, 414053], [33, 414213], [42, 414873], [44, 415293], [49, 415533], [51, 415693]]}, {"verse": 51, "start": 416642, "end": 423700, "text": "Y respondiendo Jesús, le dice: ¿Qué quieres que te haga? Y el ciego le dice: Maestro, que recobre la vista.", "words": [[0, 416642], [2, 416747], [15, 417367], [22, 417687], [25, 418047], [31, 418759], [36, 418875], [44, 419195], [48, 419415], [51, 419595], [57, 420288], [59, 420413], [62, 420533], [68, 420973], [71, 421133], [77, 421861], [86, 422385], [90, 422585], [98, 423085], [101, 423205]]}, {"verse": 52, "start": 423980, "end": 431660, "text": "Y Jesús le dijo: Ve, tu fe te ha salvado. Y luego recobró la vista, y seguía a Jesús en el camino.", "words": [[0, 423980], [2, 424125], [8, 424505], [11, 424865], [17, 425738], [21, 425930], [24, 426032], [27, 426232], [30, 426432], [33, 426572], [42, 427551], [44, 427833], [50, 428073], [58, 428793], [61, 428953], [68, 429253], [70, 429513], [77, 430033], [79, 430213], [85, 430513], [88, 430853], [91, 430973]]}]}