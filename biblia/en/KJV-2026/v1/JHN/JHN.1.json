{"book": "JHN", "chapter": 1, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 323595, "verses": [{"verse": 1, "start": 300, "end": 5257, "text": "In the beginning was the Word, and the Word was with God, and the Word was God.", "words": [[0, 300], [3, 428], [7, 528], [17, 868], [21, 1228], [25, 1408], [31, 2168], [35, 2348], [39, 2488], [44, 2728], [48, 2988], [53, 3208], [58, 4008], [62, 4088], [66, 4248], [71, 4468], [75, 4748]]}, {"verse": 2, "start": 5607, "end": 8098, "text": "The same was in the beginning with God.", "words": [[0, 5607], [4, 5867], [9, 6227], [13, 6487], [16, 6707], [20, 6807], [30, 7167], [35, 7567]]}, {"verse": 3, "start": 8448, "end": 13375, "text": "All things were made by him; and without him was not any thing made that was made.", "words": [[0, 8448], [4, 8894], [11, 9214], [16, 9494], [21, 9734], [24, 9974], [29, 10633], [33, 10749], [41, 11009], [45, 11269], [49, 11429], [53, 11622], [57, 11816], [63, 12009], [68, 12469], [73, 12669], [77, 12849]]}, {"verse": 4, "start": 13725, "end": 16893, "text": "In him was life; and the life was the light of men.", "words": [[0, 13725], [3, 13905], [7, 14145], [11, 14505], [17, 15185], [21, 15303], [25, 15443], [30, 15763], [34, 15983], [38, 16143], [44, 16383], [47, 16523]]}, {"verse": 5, "start": 17243, "end": 21725, "text": "And the light shines in darkness; and the darkness comprehended it not.", "words": [[0, 17243], [4, 17368], [8, 17508], [14, 17748], [21, 18188], [24, 18508], [34, 19532], [38, 19677], [42, 19777], [51, 20197], [64, 21057], [67, 21197]]}, {"verse": 6, "start": 22075, "end": 25191, "text": "¶ There was a man sent from God, whose name was John.", "words": [[2, 22075], [8, 22182], [12, 22342], [14, 22482], [18, 22762], [23, 23062], [28, 23322], [33, 23722], [39, 23967], [44, 24287], [48, 24507]]}, {"verse": 7, "start": 25541, "end": 31347, "text": "The same came for a witness, to bear witness of the Light, that all men through him might believe.", "words": [[0, 25541], [4, 25700], [9, 26000], [14, 26260], [18, 26560], [20, 26700], [29, 27040], [32, 27620], [37, 27820], [45, 28160], [48, 28420], [52, 28560], [59, 28880], [64, 29360], [68, 29560], [72, 29820], [80, 30100], [84, 30340], [90, 30560]]}, {"verse": 8, "start": 31697, "end": 35238, "text": "He was not that Light, but was sent to bear witness of that Light.", "words": [[0, 31697], [3, 31798], [7, 31998], [11, 32198], [16, 32458], [23, 33018], [27, 33138], [31, 33318], [36, 33558], [39, 33758], [44, 33958], [52, 34238], [55, 34558], [60, 34758]]}, {"verse": 9, "start": 35588, "end": 39673, "text": "That was the true Light, which lights every man that comes into the world.", "words": [[0, 35588], [5, 35768], [9, 35928], [13, 36068], [18, 36328], [25, 36908], [31, 37268], [38, 37568], [44, 38008], [48, 38348], [53, 38528], [59, 38748], [64, 39028], [68, 39168]]}, {"verse": 10, "start": 40023, "end": 44271, "text": "He was in the world, and the world was made by him, and the world knew him not.", "words": [[0, 40023], [3, 40130], [7, 40310], [10, 40490], [14, 40630], [21, 41130], [25, 41230], [29, 41350], [35, 41610], [39, 41810], [44, 42050], [47, 42310], [52, 42810], [56, 43010], [60, 43150], [66, 43390], [71, 43610], [75, 43810]]}, {"verse": 11, "start": 44621, "end": 47691, "text": "He came to his own, and his own received him not.", "words": [[0, 44621], [3, 44707], [8, 44947], [11, 45167], [15, 45347], [20, 45987], [24, 46167], [28, 46347], [32, 46547], [41, 46927], [45, 47207]]}, {"verse": 12, "start": 48041, "end": 54914, "text": "But as many as received him, to them gave he power to become the sons of God, even to them that believe on his name:", "words": [[0, 48041], [4, 48148], [7, 48268], [12, 48508], [15, 48688], [24, 49128], [29, 49748], [32, 49848], [37, 50028], [42, 50248], [45, 50448], [51, 50828], [54, 51028], [61, 51308], [65, 51548], [70, 51828], [73, 52028], [78, 52788], [83, 52988], [86, 53208], [91, 53428], [96, 53628], [104, 53948], [107, 54188], [111, 54388]]}, {"verse": 13, "start": 55264, "end": 60751, "text": "Which were born, not of blood, nor of the will of the flesh, nor of the will of man, but of God.", "words": [[0, 55264], [6, 55372], [11, 55532], [17, 55852], [21, 56132], [24, 56332], [31, 56852], [35, 57052], [38, 57252], [42, 57372], [47, 57552], [50, 57692], [54, 57812], [61, 58412], [65, 58592], [68, 58812], [72, 58932], [77, 59132], [80, 59312], [85, 59912], [89, 60032], [92, 60172]]}, {"verse": 14, "start": 61101, "end": 70851, "text": "And the Word was made flesh, and dwelt among us, (and we beheld his glory, the glory as of the only begotten of the Father,) full of grace and truth.", "words": [[0, 61101], [4, 61256], [8, 61356], [13, 61596], [17, 61836], [22, 62056], [29, 62436], [33, 63016], [39, 63396], [45, 63616], [49, 64396], [54, 64536], [57, 64696], [64, 65116], [68, 65316], [75, 66316], [79, 66436], [85, 66856], [88, 67216], [91, 67396], [95, 67516], [100, 67816], [109, 68396], [112, 68516], [116, 68636], [125, 69396], [130, 69596], [133, 69776], [139, 70116], [143, 70336]]}, {"verse": 15, "start": 71201, "end": 79879, "text": "¶ John bore witness of him, and cried, saying, This was he of whom I spoke, He that comes after me is preferred before me: for he was before me.", "words": [[2, 71201], [7, 71441], [12, 71721], [20, 72041], [23, 72341], [28, 72521], [32, 72741], [39, 73361], [47, 74147], [52, 74307], [56, 74507], [59, 74747], [62, 74987], [67, 75187], [69, 75447], [76, 76147], [79, 76347], [84, 76527], [90, 76767], [96, 77127], [99, 77327], [102, 77507], [112, 77867], [119, 78207], [123, 78813], [127, 78901], [130, 79081], [134, 79261], [141, 79561]]}, {"verse": 16, "start": 80159, "end": 84547, "text": "And of his fulness have all we received, and grace for grace.", "words": [[0, 80159], [4, 80298], [7, 80478], [11, 80778], [19, 81078], [24, 81378], [28, 81698], [31, 81898], [41, 83058], [45, 83178], [51, 83558], [55, 83878]]}, {"verse": 17, "start": 84897, "end": 89771, "text": "For the law was given by Moses, but grace and truth came by Jesus Christ.", "words": [[0, 84897], [4, 84982], [8, 85102], [12, 85362], [16, 85582], [22, 85822], [25, 86102], [32, 86882], [36, 87162], [42, 87502], [46, 87722], [52, 88042], [57, 88382], [60, 88622], [66, 88962]]}, {"verse": 18, "start": 90121, "end": 96917, "text": "No man has seen God at any time; the only begotten Son, which is in the bosom of the Father, he has declared him.", "words": [[0, 90121], [3, 90323], [7, 90603], [11, 90843], [16, 91123], [20, 91443], [23, 91643], [27, 91823], [33, 92670], [37, 92773], [42, 92993], [51, 93553], [56, 94073], [62, 94233], [65, 94373], [68, 94533], [72, 94633], [78, 95033], [81, 95133], [85, 95253], [93, 95893], [96, 95993], [100, 96153], [109, 96493]]}, {"verse": 19, "start": 97267, "end": 103772, "text": "¶ And this is the record of John, when the Jews sent priests and Levites from Jerusalem to ask him, Who are you?", "words": [[2, 97267], [6, 97415], [11, 97635], [14, 97795], [18, 97935], [25, 98235], [28, 98435], [34, 98775], [39, 99095], [43, 99235], [48, 99495], [53, 99875], [61, 100235], [65, 100535], [73, 100995], [78, 101195], [88, 101755], [91, 102095], [95, 102415], [100, 102958], [104, 103115], [108, 103335]]}, {"verse": 20, "start": 104052, "end": 109016, "text": "And he confessed, and denied not; but confessed, I am not the Christ.", "words": [[0, 104052], [4, 104189], [7, 104309], [18, 104849], [22, 105189], [29, 105529], [34, 106364], [38, 106711], [49, 107868], [51, 107988], [54, 108128], [58, 108308], [62, 108488]]}, {"verse": 21, "start": 109296, "end": 116850, "text": "And they asked him, What then? Are you Elias? And he says, I am not. Are you that prophet? And he answered, No.", "words": [[0, 109296], [4, 109457], [9, 109577], [15, 109857], [20, 110315], [25, 110510], [31, 111170], [35, 111337], [39, 111497], [46, 112402], [50, 112527], [53, 112647], [59, 113377], [61, 113577], [64, 113697], [69, 114317], [73, 114417], [77, 114537], [82, 114697], [91, 115536], [95, 115669], [98, 115789], [108, 116597]]}, {"verse": 22, "start": 117130, "end": 123356, "text": "Then said they to him, Who are you? that we may give an answer to them that sent us. What do you say of yourself?", "words": [[0, 117130], [5, 117371], [10, 117691], [15, 117911], [18, 118111], [23, 118660], [27, 118804], [31, 118924], [36, 119662], [41, 119765], [44, 119865], [48, 120025], [53, 120245], [56, 120365], [63, 120705], [66, 120885], [71, 121065], [76, 121225], [81, 121485], [85, 122150], [90, 122254], [93, 122394], [97, 122474], [101, 122714], [104, 122894]]}, {"verse": 23, "start": 123636, "end": 130574, "text": "He said, I am the voice of one crying in the wilderness, Make straight the way of the Lord, as said the prophet Esaias.", "words": [[0, 123636], [3, 123719], [9, 124408], [11, 124568], [14, 124688], [18, 124788], [24, 125028], [27, 125228], [31, 125408], [38, 125768], [41, 125948], [45, 126028], [57, 126948], [62, 127068], [71, 127388], [75, 127628], [79, 127788], [82, 127888], [86, 128008], [92, 128643], [95, 128865], [100, 129185], [104, 129325], [112, 129984]]}, {"verse": 24, "start": 130924, "end": 133389, "text": "And they which were sent were of the Pharisees.", "words": [[0, 130924], [4, 131071], [9, 131251], [15, 131491], [20, 131711], [25, 131971], [30, 132231], [33, 132391], [37, 132491]]}, {"verse": 25, "start": 133739, "end": 140674, "text": "And they asked him, and said to him, Why do you baptize then, if you be not that Christ, nor Elias, neither that prophet?", "words": [[0, 133739], [4, 133906], [9, 134046], [15, 134386], [20, 134606], [24, 134986], [29, 135266], [32, 135466], [37, 136036], [41, 136214], [44, 136374], [48, 136474], [56, 137034], [62, 137534], [65, 137634], [69, 137734], [72, 137834], [76, 137994], [81, 138194], [89, 138734], [93, 139174], [100, 139614], [108, 139834], [113, 140094]]}, {"verse": 26, "start": 140954, "end": 146029, "text": "John answered them, saying, I baptize with water: but there stands one among you, whom you know not;", "words": [[0, 140954], [5, 141194], [14, 141494], [20, 141754], [28, 142491], [30, 142693], [38, 143133], [43, 143273], [50, 143863], [54, 144003], [60, 144123], [67, 144343], [71, 144623], [77, 144803], [82, 145043], [87, 145243], [91, 145383], [96, 145583]]}, {"verse": 27, "start": 146379, "end": 151665, "text": "He it is, who coming after me is preferred before me, whose shoe’s strap I am not worthy to unloose.", "words": [[0, 146379], [3, 146809], [6, 146909], [10, 147249], [14, 147349], [21, 147609], [27, 147949], [30, 148149], [33, 148269], [43, 148569], [50, 148869], [54, 149429], [60, 149569], [67, 149849], [73, 150169], [75, 150389], [78, 150529], [82, 150669], [89, 150949], [92, 151129]]}, {"verse": 28, "start": 151945, "end": 156283, "text": "These things were done in Bethabara beyond Jordan, where John was baptizing.", "words": [[0, 151945], [6, 152112], [13, 152432], [18, 152632], [23, 152872], [26, 153032], [36, 153712], [43, 154092], [51, 154612], [57, 154872], [62, 155212], [66, 155452]]}, {"verse": 29, "start": 156633, "end": 163622, "text": "¶ The next day John sees Jesus coming to him, and says, Behold the Lamb of God, which takes away the sin of the world.", "words": [[2, 156633], [6, 156718], [11, 156918], [15, 157258], [20, 157558], [25, 157838], [31, 158298], [38, 158718], [41, 158938], [46, 159138], [50, 159298], [56, 160032], [63, 160385], [67, 160625], [72, 160845], [75, 161005], [80, 161645], [86, 161845], [92, 162145], [97, 162505], [101, 162685], [105, 162925], [108, 163065], [112, 163185]]}, {"verse": 30, "start": 163972, "end": 170419, "text": "This is he of whom I said, After me comes a man which is preferred before me: for he was before me.", "words": [[0, 163972], [5, 164250], [8, 164530], [11, 164810], [14, 165050], [19, 165250], [21, 165410], [27, 166070], [33, 166430], [36, 166630], [42, 166850], [44, 167030], [48, 167290], [54, 167650], [57, 167790], [67, 168210], [74, 168630], [78, 169277], [82, 169410], [85, 169590], [89, 169790], [96, 170090]]}, {"verse": 31, "start": 170769, "end": 176657, "text": "And I knew him not: but that he should be made manifest to Israel, therefore am I come baptizing with water.", "words": [[0, 170769], [4, 170889], [6, 171009], [11, 171169], [15, 171329], [20, 171920], [24, 172040], [29, 172200], [32, 172340], [39, 172580], [42, 172760], [47, 173000], [56, 173480], [59, 173660], [67, 174360], [77, 174820], [80, 174940], [82, 175180], [87, 175420], [97, 176080], [102, 176240]]}, {"verse": 32, "start": 176937, "end": 183140, "text": "And John bore witness, saying, I saw the Spirit descending from heaven like a dove, and it remained upon him.", "words": [[0, 176937], [4, 177092], [9, 177412], [14, 177732], [23, 178072], [31, 179154], [33, 179254], [37, 179454], [41, 179634], [48, 179934], [59, 180354], [64, 180634], [71, 180934], [76, 181174], [78, 181314], [84, 181574], [88, 182014], [91, 182134], [100, 182434], [105, 182774]]}, {"verse": 33, "start": 183490, "end": 195180, "text": "And I knew him not: but he that sent me to baptize with water, the same said to me, Upon whom you shall see the Spirit descending, and remaining on him, the same is he which baptizes with the Holy Spirit.", "words": [[0, 183490], [4, 183608], [6, 183708], [11, 183868], [15, 184068], [20, 184683], [24, 184784], [27, 185024], [32, 185224], [37, 185444], [40, 185604], [43, 185724], [51, 186244], [56, 186364], [63, 187084], [67, 187224], [72, 187424], [77, 187684], [80, 187844], [84, 188024], [89, 188524], [94, 188904], [98, 189144], [104, 189324], [108, 189544], [112, 189684], [119, 189964], [131, 190464], [135, 190924], [145, 191244], [148, 191504], [153, 192036], [157, 192188], [162, 192548], [165, 192788], [168, 193048], [174, 193333], [183, 193993], [188, 194233], [192, 194373], [197, 194593]]}, {"verse": 34, "start": 195530, "end": 198404, "text": "And I saw, and bore witness that this is the Son of God.", "words": [[0, 195530], [4, 195635], [6, 195775], [11, 196055], [15, 196255], [20, 196475], [28, 196855], [33, 197195], [38, 197415], [41, 197535], [45, 197675], [49, 197875], [52, 197995]]}, {"verse": 35, "start": 198684, "end": 202622, "text": "¶ Again the next day after John stood, and two of his disciples;", "words": [[2, 198684], [8, 198988], [12, 199208], [17, 199428], [21, 199728], [27, 199968], [32, 200328], [39, 201168], [43, 201308], [47, 201548], [50, 201708], [54, 201828]]}, {"verse": 36, "start": 202972, "end": 207229, "text": "And looking upon Jesus as he walked, he says, Behold the Lamb of God!", "words": [[0, 202972], [4, 203119], [12, 203359], [17, 203679], [23, 204139], [26, 204479], [29, 204619], [37, 205119], [40, 205219], [46, 205900], [53, 206285], [57, 206445], [62, 206625], [65, 206765]]}, {"verse": 37, "start": 207509, "end": 210967, "text": "And the two disciples heard him speak, and they followed Jesus.", "words": [[0, 207509], [4, 207664], [8, 207744], [12, 207904], [22, 208364], [28, 208684], [32, 208844], [39, 209684], [43, 209764], [48, 209884], [57, 210224]]}, {"verse": 38, "start": 211317, "end": 220546, "text": "Then Jesus turned, and saw them following, and says to them, What do you seek? They said to him, Rabbi, (which is to say, being interpreted, Master,) where do you dwell?", "words": [[0, 211317], [5, 211507], [11, 211787], [19, 212247], [23, 212447], [27, 212667], [32, 212847], [43, 213267], [47, 213587], [52, 213807], [55, 214027], [61, 214565], [66, 214688], [69, 214848], [73, 214948], [79, 215728], [84, 215905], [89, 216185], [92, 216345], [97, 216807], [104, 217246], [111, 217606], [114, 217746], [117, 217866], [122, 218106], [128, 218386], [141, 218946], [150, 219386], [156, 219751], [159, 219951], [163, 220051]]}, {"verse": 39, "start": 220826, "end": 228603, "text": "He says to them, Come and see. They came and saw where he dwelt, and stayed with him that day: for it was about the tenth hour.", "words": [[0, 220826], [3, 220916], [8, 221116], [11, 221336], [17, 221936], [22, 222136], [26, 222276], [31, 223097], [36, 223209], [41, 223509], [45, 223689], [49, 223989], [55, 224229], [58, 224369], [65, 224829], [69, 225269], [76, 225589], [81, 225869], [85, 226069], [90, 226309], [95, 226990], [99, 227140], [102, 227260], [106, 227400], [112, 227640], [116, 227840], [122, 228080]]}, {"verse": 40, "start": 228953, "end": 234628, "text": "One of the two which heard John speak, and followed him, was Andrew, Simon Peter’s brother.", "words": [[0, 228953], [4, 229102], [7, 229202], [11, 229302], [15, 229522], [21, 229762], [27, 230022], [32, 230382], [39, 230862], [43, 231422], [52, 231782], [57, 232102], [61, 232377], [69, 232897], [75, 233577], [83, 234117]]}, {"verse": 41, "start": 234978, "end": 242486, "text": "He first finds his own brother Simon, and says to him, We have found the Messias, which is, being interpreted, the Christ.", "words": [[0, 234978], [3, 235079], [9, 235339], [15, 235739], [19, 235979], [23, 236159], [31, 236479], [38, 236959], [42, 237439], [47, 237659], [50, 237879], [55, 238439], [58, 238563], [63, 238703], [69, 238983], [73, 239423], [82, 240066], [88, 240232], [92, 240392], [98, 240652], [111, 241312], [115, 241792]]}, {"verse": 42, "start": 242836, "end": 253632, "text": "And he brought him to Jesus. And when Jesus beheld him, he said, You are Simon the son of Jona: you shall be called Cephas, which is by interpretation, A stone.", "words": [[0, 242836], [4, 243000], [7, 243160], [15, 243440], [19, 243660], [22, 243840], [29, 244745], [33, 245045], [38, 245225], [44, 245585], [51, 246185], [56, 246445], [59, 246525], [65, 247224], [69, 247466], [73, 247746], [79, 248146], [83, 248346], [87, 248566], [90, 248891], [96, 249389], [100, 249512], [106, 249692], [109, 249852], [116, 250152], [124, 251285], [130, 251430], [133, 251590], [136, 251770], [152, 252870], [154, 252990]]}, {"verse": 43, "start": 253982, "end": 259573, "text": "¶ The day following Jesus would go forth into Galilee, and finds Philip, and says to him, Follow me.", "words": [[2, 253982], [6, 254129], [10, 254329], [20, 254889], [26, 255109], [32, 255429], [35, 255589], [41, 255909], [46, 256109], [55, 256709], [59, 256989], [65, 257269], [73, 257669], [77, 258029], [82, 258229], [85, 258469], [90, 259011], [97, 259262]]}, {"verse": 44, "start": 259853, "end": 263728, "text": "Now Philip was of Bethsaida, the city of Andrew and Peter.", "words": [[0, 259853], [4, 260133], [11, 260513], [15, 260813], [18, 260993], [29, 262213], [33, 262253], [38, 262513], [41, 262713], [48, 263053], [52, 263253]]}, {"verse": 45, "start": 264078, "end": 273304, "text": "Philip finds Nathanael, and says to him, We have found him, of whom Moses in the law, and the prophets, did write, Jesus of Nazareth, the son of Joseph.", "words": [[0, 264078], [7, 264307], [13, 264727], [24, 265787], [28, 265987], [33, 266207], [36, 266447], [41, 266996], [44, 267112], [49, 267292], [55, 267612], [60, 267812], [63, 268232], [68, 268432], [74, 268732], [77, 268992], [81, 269072], [86, 269272], [90, 269592], [94, 269712], [104, 270032], [108, 270632], [115, 270952], [121, 271432], [124, 271752], [134, 272452], [138, 272572], [142, 272812], [145, 272892]]}, {"verse": 46, "start": 273584, "end": 279863, "text": "And Nathanael said to him, Can there any good thing come out of Nazareth? Philip says to him, Come and see.", "words": [[0, 273584], [4, 274168], [14, 274788], [19, 274908], [22, 275068], [27, 275524], [31, 275729], [37, 275929], [41, 276189], [46, 276409], [52, 276649], [57, 276869], [61, 277029], [64, 277129], [74, 277988], [81, 278228], [86, 278508], [89, 278748], [94, 279270], [99, 279410], [103, 279530]]}, {"verse": 47, "start": 280143, "end": 288158, "text": "Jesus saw Nathanael coming to him, and says of him, Behold an Israelite indeed, in whom is no guile!", "words": [[0, 280143], [6, 280428], [10, 280868], [20, 281868], [27, 282168], [30, 282448], [35, 282688], [39, 