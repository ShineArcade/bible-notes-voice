{"book": "PSA", "chapter": 90, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 118821, "verses": [{"verse": 1, "start": 300, "end": 7408, "text": "Oración de Moisés varón de Dios. SEÑOR, tú nos has sido refugio en generación y en generación.", "words": [[0, 300], [8, 742], [11, 962], [18, 1642], [24, 1922], [27, 2042], [33, 2950], [40, 3668], [43, 3788], [47, 3958], [51, 4128], [56, 4408], [64, 5108], [67, 5268], [78, 6028], [80, 6268], [83, 6448]]}, {"verse": 2, "start": 7858, "end": 15570, "text": "Antes que naciesen los montes, y formases la tierra y el mundo, y desde el siglo y hasta el siglo, tú eres Dios.", "words": [[0, 7858], [6, 8139], [10, 8319], [19, 8759], [23, 8999], [31, 9499], [33, 9839], [42, 10179], [45, 10439], [52, 10839], [54, 11139], [57, 11279], [64, 11619], [66, 12059], [72, 12299], [75, 12599], [81, 13099], [83, 13319], [89, 13499], [92, 13719], [99, 14099], [102, 14599], [107, 14959]]}, {"verse": 3, "start": 16020, "end": 21900, "text": "Vuelves al hombre hasta ser quebrantado, y dices: Convertíos, hijos de los hombres.", "words": [[0, 16020], [8, 16486], [11, 16666], [18, 16946], [24, 17146], [28, 17466], [41, 18266], [43, 18386], [50, 19619], [62, 20019], [68, 20619], [71, 20899], [75, 21019]]}, {"verse": 4, "start": 22250, "end": 29648, "text": "Porque mil años delante de tus ojos, son como el día de ayer, que pasó, y como una de las vigilias de la noche.", "words": [[0, 22250], [7, 22487], [11, 22767], [16, 23167], [24, 23687], [27, 23867], [31, 24027], [37, 24447], [41, 25107], [46, 25387], [49, 25587], [53, 25807], [56, 25967], [62, 26287], [66, 26487], [72, 26907], [74, 27367], [79, 27647], [83, 27987], [86, 28127], [90, 28267], [99, 28827], [102, 28927], [105, 29047]]}, {"verse": 5, "start": 30098, "end": 37110, "text": "Los haces pasar como avenida de aguas; son como sueño; como la hierba que crece en la mañana:", "words": [[0, 30098], [4, 30224], [10, 30644], [16, 31004], [21, 31384], [29, 31964], [32, 32124], [39, 32995], [43, 33221], [48, 33521], [55, 34540], [60, 34868], [63, 35028], [70, 35448], [74, 35608], [80, 36108], [83, 36268], [86, 36388]]}, {"verse": 6, "start": 37560, "end": 42523, "text": "En la mañana florece y crece; a la tarde es cortada, y se seca.", "words": [[0, 37560], [3, 37696], [6, 37776], [13, 38076], [21, 38816], [23, 39036], [30, 40033], [32, 40155], [35, 40235], [41, 40535], [44, 40815], [53, 41515], [55, 41715], [58, 41855]]}, {"verse": 7, "start": 42973, "end": 47522, "text": "Porque con tu furor somos consumidos, y con tu ira somos turbados.", "words": [[0, 42973], [7, 43197], [11, 43457], [14, 43597], [20, 44057], [26, 44337], [38, 45237], [40, 45617], [44, 45837], [47, 46057], [51, 46277], [57, 46577]]}, {"verse": 8, "start": 47972, "end": 53717, "text": "Pusiste nuestras maldades delante de ti, nuestros yerros a la luz de tu rostro.", "words": [[0, 47972], [8, 48454], [17, 48674], [26, 49454], [34, 49934], [37, 50094], [41, 50714], [50, 50974], [57, 51694], [59, 52014], [62, 52114], [66, 52414], [69, 52894], [72, 53054]]}, {"verse": 9, "start": 54167, "end": 60263, "text": "Porque todos nuestros días declinan a causa de tu ira; acabamos nuestros años como un pensamiento.", "words": [[0, 54167], [7, 54484], [13, 54824], [22, 55164], [27, 55604], [36, 56244], [38, 56344], [44, 56624], [47, 56864], [50, 57044], [55, 57773], [64, 58270], [73, 58550], [78, 58930], [83, 59210], [86, 59350]]}, {"verse": 10, "start": 60713, "end": 71804, "text": "Los días de nuestra edad son setenta años; que si en los más robustos son ochenta años, con todo su fortaleza es molestia y trabajo; porque es cortado pronto, y volamos.", "words": [[0, 60713], [4, 60838], [9, 61058], [12, 61238], [20, 61458], [25, 61818], [29, 62078], [37, 62338], [43, 63423], [47, 63504], [50, 63644], [53, 63744], [57, 63884], [61, 64064], [70, 64644], [74, 64864], [82, 65084], [88, 65924], [92, 66084], [97, 66364], [100, 66584], [110, 67364], [113, 67724], [122, 68324], [124, 68424], [133, 69353], [140, 69578], [143, 69758], [151, 70258], [159, 70718], [161, 71058]]}, {"verse": 11, "start": 72254, "end": 77888, "text": "¿Quién conoce la fortaleza de tu ira, y tu indignación según que debes ser temido?", "words": [[0, 72254], [7, 72436], [14, 73156], [17, 73276], [27, 73996], [30, 74156], [33, 74396], [38, 74796], [40, 74936], [43, 75116], [55, 75916], [61, 76316], [65, 76556], [71, 76796], [75, 77116]]}, {"verse": 12, "start": 78338, "end": 83924, "text": "Enséñanos de tal modo a contar nuestros días, que traigamos al corazón sabiduría.", "words": [[0, 78338], [10, 79264], [13, 79504], [17, 79724], [22, 80064], [24, 80244], [31, 80584], [40, 80884], [46, 81444], [50, 81924], [60, 82484], [63, 82664], [71, 83064]]}, {"verse": 13, "start": 84374, "end": 89733, "text": "Vuélvete, oh Jehová: ¿hasta cuándo? y compadécete de tus siervos.", "words": [[0, 84374], [10, 84899], [13, 85449], [21, 86431], [28, 86596], [36, 87516], [38, 88007], [50, 88537], [53, 88757], [57, 88917]]}, {"verse": 14, "start": 90183, "end": 96981, "text": "Sácianos pronto de tu misericordia: y cantaremos y nos alegraremos todos nuestros días.", "words": [[0, 90472], [9, 90802], [16, 91622], [19, 91922], [22, 92062], [36, 93466], [38, 93590], [49, 94290], [51, 94750], [55, 94890], [67, 95630], [73, 95850], [82, 96150]]}, {"verse": 15, "start": 97431, "end": 102561, "text": "Alégranos conforme a los días que nos afligiste, y los años que vimos mal.", "words": [[0, 97431], [10, 98314], [19, 99094], [21, 99174], [25, 99314], [30, 99574], [34, 99754], [38, 99894], [49, 100634], [51, 101014], [55, 101174], [60, 101454], [64, 101654], [70, 101894]]}, {"verse": 16, "start": 103011, "end": 108029, "text": "Aparezca en tus siervos tu obra, y tu gloria sobre sus hijos.", "words": [[0, 103011], [9, 103756], [12, 103956], [16, 104136], [24, 104736], [27, 104996], [33, 105416], [35, 106116], [38, 106456], [45, 106796], [51, 107076], [55, 107356]]}, {"verse": 17, "start": 108479, "end": 118421, "text": "Y sea la luz de Jehová nuestro Dios sobre nosotros: y ordena en nosotros la obra de nuestras manos, la obra de nuestras manos confirma.", "words": [[0, 108479], [2, 108789], [6, 109069], [9, 109289], [13, 109569], [16, 109829], [23, 110309], [31, 110429], [36, 110849], [42, 111209], [52, 112416], [54, 112578], [61, 113098], [64, 113178], [73, 113718], [76, 114338], [81, 114698], [84, 114878], [93, 115058], [100, 115958], [103, 116238], [108, 116578], [111, 116778], [120, 116978], [126, 117458]]}]}