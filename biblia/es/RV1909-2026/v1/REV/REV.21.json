{"book": "REV", "chapter": 21, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 252497, "verses": [{"verse": 1, "start": 300, "end": 7201, "text": "Y vi un cielo nuevo, y una tierra nueva: porque el primer cielo y la primera tierra se fueron, y el mar ya no es.", "words": [[0, 300], [2, 404], [5, 524], [8, 644], [14, 884], [21, 1404], [23, 1684], [27, 1844], [34, 2204], [41, 3147], [48, 3311], [51, 3471], [58, 3691], [64, 4091], [66, 4271], [69, 4391], [77, 4631], [84, 4931], [87, 5171], [95, 5511], [97, 5891], [100, 6051], [104, 6231], [107, 6491], [110, 6711]]}, {"verse": 2, "start": 7651, "end": 16480, "text": "Y yo Juan vi la santa ciudad, Jerusalén nueva, que descendía del cielo, de Dios, dispuesta como una esposa ataviada para su marido.", "words": [[0, 7651], [2, 7772], [5, 8032], [10, 8412], [13, 8512], [16, 8652], [22, 8952], [30, 9532], [40, 10172], [47, 10812], [51, 11012], [61, 11632], [65, 11792], [72, 12592], [75, 12712], [81, 13492], [91, 13972], [96, 14292], [100, 14532], [107, 15012], [116, 15592], [121, 15792], [124, 15972]]}, {"verse": 3, "start": 16930, "end": 28531, "text": "Y oí una gran voz del cielo que decía: He aquí el tabernáculo de Dios con los hombres, y morará con ellos; y ellos serán su pueblo, y el mismo Dios será su Dios con ellos.", "words": [[0, 16930], [2, 17071], [5, 17291], [9, 17531], [14, 17791], [18, 18051], [22, 18251], [28, 18591], [32, 18811], [39, 19645], [42, 19769], [47, 20069], [50, 20229], [62, 20889], [65, 21049], [70, 21309], [74, 21569], [78, 21729], [87, 22049], [89, 22669], [96, 23029], [100, 23249], [107, 24332], [109, 24491], [115, 24691], [121, 25051], [124, 25211], [132, 25911], [134, 26151], [137, 26271], [143, 26571], [148, 26871], [153, 27231], [156, 27491], [161, 27711], [165, 28031]]}, {"verse": 4, "start": 29241, "end": 41021, "text": "Y limpiará Dios toda lágrima de los ojos de ellos; y la muerte no será más; y no habrá más llanto, ni clamor, ni dolor: porque las primeras cosas son pasadas.", "words": [[0, 29241], [2, 29358], [11, 29898], [16, 30058], [21, 30338], [29, 30918], [32, 31038], [36, 31178], [41, 31498], [44, 31738], [51, 32856], [53, 32973], [56, 33073], [63, 33433], [66, 33693], [71, 33913], [76, 35045], [78, 35163], [81, 35323], [87, 35663], [91, 35823], [99, 36663], [102, 36763], [110, 37543], [113, 37623], [120, 38666], [127, 38851], [131, 39071], [140, 39551], [146, 39871], [150, 40171]]}, {"verse": 5, "start": 41576, "end": 51888, "text": "Y el que estaba sentado en el trono dijo: He aquí, yo hago nuevas todas las cosas. Y me dijo: Escribe; porque estas palabras son fieles y verdaderas.", "words": [[0, 41576], [2, 41694], [5, 41794], [9, 41894], [16, 42194], [24, 42694], [27, 42814], [30, 42914], [36, 43194], [42, 43989], [45, 44029], [51, 44249], [54, 44569], [59, 44769], [66, 45169], [72, 45509], [76, 45809], [83, 46953], [85, 47053], [88, 47133], [94, 47878], [103, 49109], [110, 49328], [116, 49588], [125, 50108], [129, 50408], [136, 50928], [138, 51008]]}, {"verse": 6, "start": 52418, "end": 62809, "text": "Y me dijo: Hecho es. Yo soy Alfa y Omega, el principio y el fin. Al que tenga sed, yo le daré de la fuente del agua de vida gratuitamente.", "words": [[0, 52418], [2, 52518], [5, 52598], [11, 53569], [17, 53829], [21, 54621], [24, 54822], [28, 55042], [33, 55522], [35, 55662], [42, 56462], [45, 56522], [55, 57042], [57, 57562], [60, 57682], [65, 58634], [68, 58759], [72, 58859], [78, 59099], [83, 59899], [86, 59999], [89, 60119], [94, 60379], [97, 60459], [100, 60559], [107, 60899], [111, 61079], [116, 61299], [119, 61459], [124, 61679]]}, {"verse": 7, "start": 63509, "end": 69339, "text": "El que venza, poseerá todas las cosas; y yo seré su Dios, y él será mi hijo.", "words": [[0, 63509], [3, 63789], [7, 63929], [14, 64409], [22, 64889], [28, 65049], [32, 65329], [39, 66403], [41, 66549], [44, 66689], [49, 67069], [52, 67189], [58, 68249], [60, 68269], [63, 68409], [68, 68649], [71, 68889]]}, {"verse": 8, "start": 70021, "end": 86006, "text": "Pero a los cobardes e incrédulos, a los abominables y homicidas, a los sexualmente inmorales y hechiceros, y a los idólatras, y a todos los mentirosos, su parte será en el lago ardiendo con fuego y azufre, que es la muerte segunda.", "words": [[0, 70021], [5, 70205], [7, 70345], [11, 70485], [20, 71125], [22, 71225], [34, 72365], [36, 72405], [40, 72525], [52, 73305], [54, 73485], [65, 74425], [67, 74465], [71, 74585], [83, 75425], [93, 76025], [95, 76185], [107, 77245], [109, 77305], [111, 77345], [115, 77505], [126, 78205], [128, 78445], [130, 78545], [136, 78785], [140, 79025], [152, 80478], [155, 80636], [161, 80996], [166, 81336], [169, 81536], [172, 81656], [177, 82016], [186, 82656], [190, 82876], [196, 83356], [198, 83696], [206, 84636], [210, 84716], [213, 84836], [216, 84936], [223, 85216]]}, {"verse": 9, "start": 86564, "end": 97505, "text": "Y vino a mí uno de los siete ángeles que tenían las siete copas llenas de las siete últimas plagas, y habló conmigo, diciendo: Ven acá, yo te mostraré la esposa, mujer del Cordero.", "words": [[0, 86564], [2, 86686], [7, 86906], [9, 87086], [12, 87226], [16, 87606], [19, 87746], [23, 87886], [29, 88186], [37, 88706], [41, 88926], [48, 89226], [52, 89446], [58, 89686], [64, 90106], [71, 90466], [74, 90646], [78, 90806], [84, 91086], [92, 91566], [100, 92306], [102, 92566], [108, 92806], [117, 93286], [127, 94281], [131, 94480], [136, 95200], [139, 95300], [142, 95380], [151, 95900], [154, 95980], [162, 96420], [168, 96680], [172, 96900]]}, {"verse": 10, "start": 97955, "end": 106022, "text": "Y me llevó en Espíritu a un grande y alto monte, y me mostró la grande ciudad santa de Jerusalén, que descendía del cielo de Dios,", "words": [[0, 97955], [2, 98053], [5, 98153], [11, 98493], [14, 98593], [23, 99213], [25, 99313], [28, 99433], [35, 99773], [37, 99973], [42, 100193], [49, 100633], [51, 101193], [54, 101293], [61, 101733], [64, 101833], [71, 102133], [78, 102493], [84, 103033], [87, 103193], [98, 103913], [102, 104273], [112, 104873], [116, 105013], [122, 105293], [125, 105493]]}, {"verse": 11, "start": 106472, "end": 114977, "text": "Teniendo la gloria de Dios: y su luz era semejante a una piedra preciosísima, como piedra de jaspe, resplandeciente como cristal.", "words": [[0, 106472], [9, 106858], [12, 106998], [19, 107378], [22, 107518], [28, 108389], [30, 108497], [33, 108617], [37, 108857], [41, 109137], [51, 109877], [53, 110017], [57, 110137], [64, 110577], [78, 111717], [83, 111837], [90, 112237], [93, 112337], [100, 113197], [116, 114057], [121, 114297]]}, {"verse": 12, "start": 115427, "end": 125122, "text": "Y tenía un muro grande y alto con doce puertas; y en las puertas, doce ángeles, y nombres escritos, que son los de las doce tribus de los hijos de Israel.", "words": [[0, 115427], [2, 115528], [8, 115788], [11, 115968], [16, 116188], [23, 116508], [25, 116688], [30, 116908], [34, 117148], [39, 117428], [48, 118448], [50, 118549], [53, 118649], [57, 118769], [66, 119309], [71, 120109], [80, 120689], [82, 121009], [90, 121349], [100, 122369], [104, 122489], [108, 122689], [112, 122869], [115, 123009], [119, 123129], [124, 123449], [131, 123869], [134, 124009], [138, 124109], [144, 124369], [147, 124549]]}, {"verse": 13, "start": 125572, "end": 133320, "text": "Al oriente tres puertas; al norte tres puertas; al sur tres puertas; al occidente tres puertas.", "words": [[0, 125572], [3, 125700], [11, 126060], [16, 126340], [25, 127390], [28, 127532], [34, 127812], [39, 128132], [48, 129102], [51, 129257], [55, 129437], [60, 129697], [69, 131617], [72, 131717], [82, 132217], [87, 132517]]}, {"verse": 14, "start": 133770, "end": 140312, "text": "Y el muro de la ciudad tenía doce fundamentos, y en ellos los doce nombres de los doce apóstoles del Cordero.", "words": [[0, 133770], [2, 133869], [5, 133989], [10, 134289], [13, 134389], [16, 134489], [23, 134789], [29, 135289], [34, 135749], [47, 136769], [49, 136969], [52, 137089], [58, 137349], [62, 137589], [67, 137969], [75, 138369], [78, 138569], [82, 138709], [87, 139009], [97, 139549], [101, 139749]]}, {"verse": 15, "start": 140762, "end": 146912, "text": "Y el que hablaba conmigo, tenía una caña de medir de oro para medir la ciudad, y sus puertas, y su muro.", "words": [[0, 140762], [2, 140880], [5, 141000], [9, 141140], [17, 141500], [26, 142060], [32, 142580], [36, 142840], [41, 143180], [44, 143300], [50, 143640], [53, 143780], [57, 143980], [62, 144220], [68, 144560], [71, 144680], [79, 144940], [81, 145500], [85, 145640], [94, 146120], [96, 146380], [99, 146500]]}, {"verse": 16, "start": 147362, "end": 160461, "text": "Y la ciudad está dispuesta en forma de cuadrado, y su longitud es tanta como su anchura: y él midió la ciudad con la caña, doce mil estadios: la largura y la altura y la anchura de ella son iguales.", "words": [[0, 147362], [2, 147447], [5, 147527], [12, 147787], [17, 148127], [27, 148607], [30, 148787], [36, 149047], [39, 149227], [49, 149787], [51, 150227], [54, 150367], [63, 150687], [66, 151147], [72, 151327], [77, 151647], [80, 151827], [89, 152700], [91, 152845], [94, 152985], [100, 153305], [103, 153425], [110, 153665], [114, 153945], [117, 154085], [123, 154532], [128, 154978], [132, 155425], [142, 157270], [145, 157350], [153, 157850], [155, 157950], [158, 158050], [165, 158310], [167, 158610], [170, 158730], [178, 159130], [181, 159330], [186, 159530], [190, 159770]]}, {"verse": 17, "start": 160911, "end": 166301, "text": "Y midió su muro, ciento cuarenta y cuatro codos, de medida de hombre, la cual es del ángel.", "words": [[0, 160911], [2, 161008], [8, 161348], [11, 161488], [17, 161784], [24, 162080], [33, 162376], [35, 162672], [42, 162968], [49, 163928], [52, 164108], [59, 164428], [62, 164628], [70, 165228], [73, 165328], [78, 165528], [81, 165668], [85, 165828]]}, {"verse": 18, "start": 166751, "end": 173041, "text": "Y el material de su muro era de jaspe: pero la ciudad era de oro puro, semejante al vidrio limpio.", "words": [[0, 166751], [2, 166852], [5, 166952], [14, 167332], [17, 167512], [20, 167672], [25, 167952], [29, 168132], [32, 168272], [39, 169164], [44, 169303], [47, 169483], [54, 169803], [58, 170303], [61, 170503], [65, 170703], [71, 171363], [81, 172023], [84, 172163], [91, 172483]]}, {"verse": 19, "start": 173491, "end": 185499, "text": "Y los fundamentos del muro de la ciudad estaban adornados de toda piedra preciosa. El primer fundamento era jaspe; el segundo, zafiro; el tercero, calcedonia; el cuarto, esmeralda;", "words": [[0, 173491], [2, 173570], [6, 173690], [18, 174430], [22, 174570], [27, 174850], [30, 174950], [33, 175050], [40, 175390], [48, 176010], [58, 176650], [61, 176830], [66, 177010], [73, 177470], [83, 178689], [86, 178809], [93, 179049], [104, 179709], [108, 179789], [115, 180716], [118, 180796], [127, 181496], [135, 182337], [138, 182460], [147, 183140], [159, 184139], [162, 184229], [170, 184569]]}, {"verse": 20, "start": 185949, "end": 199006, "text": "El quinto, sardónica; el sexto, sardio; el séptimo, crisólito; el octavo, berilo; el noveno, topacio; el décimo, crisopraso; el undécimo, jacinto; el duodécimo, amatista.", "words": [[0, 185949], [3, 186091], [11, 186491], [22, 187663], [25, 187806], [32, 188306], [40, 189242], [43, 189361], [52, 189981], [63, 190901], [66, 191044], [74, 191554], [82, 192419], [85, 192499], [93, 192979], [102, 193879], [105, 194002], [113, 194667], [125, 195577], [128, 195909], [138, 196279], [147, 197284], [150, 197697], [161, 198147]]}, {"verse": 21, "start": 199456, "end": 210773, "text": "Y las doce puertas eran doce perlas, en cada una, una; cada puerta era de una perla. Y la plaza de la ciudad era de oro puro como vidrio trasparente.", "words": [[0, 199456], [2, 199540], [6, 199760], [11, 199980], [19, 200500], [24, 200790], [29, 201080], [37, 201660], [40, 201960], [45, 202180], [50, 202820], [55, 203532], [60, 203694], [67, 203954], [71, 204294], [74, 204474], [78, 204594], [85, 206784], [87, 206886], [90, 207006], [96, 207326], [99, 207506], [102, 207626], [109, 208186], [113, 208386], [116, 208586], [120, 208746], [125, 209186], [130, 209406], [137, 210111]]}, {"verse": 22, "start": 211223, "end": 216738, "text": "Y no vi en ella templo; porque el Señor Dios Todopoderoso es el templo de ella, y el Cordero.", "words": [[0, 211223], [2, 211341], [5, 211461], [8, 211661], [11, 211801], [16, 211961], [24, 212841], [31, 213026], [34, 213166], [40, 213366], [45, 213966], [58, 214566], [61, 214746], [64, 214886], [71, 215286], [74, 215346], [80, 215626], [82, 216086], [85, 216186]]}, {"verse": 23, "start": 217188, "end": 225987, "text": "Y la ciudad no tenía necesidad de sol, ni de luna, para que brillen en ella: porque la gloria de Dios la iluminó, y el Cordero era su lumbrera.", "words": [[0, 217188], [2, 217294], [5, 217414], [12, 217714], [15, 218034], [21, 218334], [31, 218994], [34, 219134], [39, 219454], [42, 219814], [45, 219974], [51, 220334], [56, 220594], [60, 220754], [68, 221194], [71, 221294], [77, 221990], [84, 222173], [87, 222333], [94, 222733], [97, 222853], [102, 223133], [105, 223333], [114, 223913], [116, 224313], [119, 224433], [127, 224913], [131, 225153], [134, 225313]]}, {"verse": 24, "start": 226437, "end": 233848, "text": "Y las naciones que hayan sido salvas andarán en la luz de ella: y los reyes de la tierra traerán su gloria y honor a ella.", "words": [[0, 226437], [2, 226544], [6, 226684], [15, 227164], [19, 227444], [25, 227764], [30, 228004], [37, 228564], [45, 229184], [48, 229364], [51, 229484], [55, 229704], [58, 229944], [64, 230626], [66, 230725], [70, 230845], [76, 231205], [79, 231305], [82, 231405], [89, 231705], [97, 232245], [100, 232425], [107, 232905], [109, 233105], [115, 233285], [117, 233485]]}, {"verse": 25, "start": 234298, "end": 238780, "text": "Y sus puertas nunca serán cerradas de día, porque allí no habrá noche.", "words": [[0, 234298], [2, 234380], [6, 234520], [14, 235000], [20, 235400], [26, 235900], [35, 236320], [38, 236540], [43, 237220], [50, 237540], [55, 237820], [58, 238020], [64, 238340]]}, {"verse": 26, "start": 239230, "end": 242833, "text": "Y llevarán la gloria y la honra de las naciones a ella.", "words": [[0, 239230], [2, 239328], [11, 239768], [14, 239888], [21, 240328], [23, 240448], [26, 240588], [32, 240928], [35, 241008], [39, 241188], [48, 241608], [50, 241808]]}, {"verse": 27, "start": 243283, "end": 252097, "text": "No entrará en ella ninguna cosa sucia, o que hace abominación y mentira; sino solamente los que están escritos en el libro de la vida del Cordero.", "words": [[0, 243283], [3, 243461], [11, 243981], [14, 244101], [19, 244281], [27, 244601], [32, 244981], [39, 245641], [41, 246041], [45, 246201], [50, 246461], [62, 247221], [64, 247481], [73, 248356], [78, 248597], [88, 249057], [92, 249397], [96, 249557], [102, 249817], [111, 250317], [114, 250537], [117, 250677], [123, 250897], [126, 251097], [129, 251177], [134, 251357], [138, 251557]]}]}