{"book": "PSA", "chapter": 31, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 189144, "verses": [{"verse": 1, "start": 300, "end": 10195, "text": "Al Músico principal: Salmo de David. EN ti, oh Jehová, he esperado; no sea yo confundido para siempre: líbrame en tu justicia.", "words": [[0, 300], [3, 480], [10, 960], [21, 2083], [27, 2561], [30, 2721], [37, 3485], [40, 3671], [44, 3991], [47, 4311], [55, 5071], [58, 5231], [68, 6202], [71, 6362], [75, 6556], [78, 6749], [89, 7429], [94, 7649], [103, 8767], [111, 8967], [114, 9167], [117, 9367]]}, {"verse": 2, "start": 10545, "end": 18027, "text": "Inclina a mí tu oído, líbrame pronto; sé para mí roca de fortaleza, por casa fuerte para salvarme.", "words": [[0, 11015], [8, 11485], [10, 11585], [13, 11725], [16, 11905], [22, 12585], [30, 13265], [38, 14293], [41, 14501], [46, 14701], [49, 14881], [54, 15281], [57, 15421], [68, 16161], [72, 16361], [77, 16541], [84, 16941], [89, 17221]]}, {"verse": 3, "start": 18377, "end": 25248, "text": "Porque tú eres mi roca y mi castillo; y por tu nombre me guiarás, y me encaminarás.", "words": [[0, 18377], [7, 18581], [10, 19107], [15, 19367], [18, 19787], [23, 20327], [25, 20567], [28, 20707], [38, 21715], [40, 21813], [44, 21973], [47, 22173], [54, 22533], [57, 23013], [66, 23753], [68, 24073], [71, 24213]]}, {"verse": 4, "start": 25598, "end": 30843, "text": "Me sacarás de la red que han escondido para mí; porque tú eres mi fortaleza.", "words": [[0, 25598], [3, 25727], [11, 26287], [14, 26387], [17, 26507], [21, 26727], [25, 27007], [29, 27127], [39, 27727], [44, 27947], [48, 28618], [55, 28825], [58, 29125], [63, 29485], [66, 29845]]}, {"verse": 5, "start": 31193, "end": 37034, "text": "En tu mano encomiendo mi espíritu: tú me has redimido, oh Jehová, Dios de verdad.", "words": [[0, 31193], [3, 31361], [6, 31481], [11, 31781], [22, 32441], [25, 32661], [35, 33630], [38, 33714], [41, 33874], [45, 34034], [55, 34734], [58, 34954], [66, 35734], [71, 35974], [74, 36334]]}, {"verse": 6, "start": 37384, "end": 43521, "text": "Aborrecí a los que esperan en vanidades ilusorias; mas yo en Jehová he esperado.", "words": [[0, 37724], [9, 38064], [11, 38324], [15, 38464], [19, 38624], [27, 39204], [30, 39464], [40, 39964], [51, 41402], [55, 41630], [58, 41970], [61, 42150], [68, 42470], [71, 42790]]}, {"verse": 7, "start": 43871, "end": 51325, "text": "Me gozaré y alegraré en tu misericordia; porque has visto mi aflicción; has conocido mi alma en las angustias.", "words": [[0, 43871], [3, 44071], [10, 44631], [12, 44771], [21, 45391], [24, 45531], [27, 45631], [41, 47029], [48, 47189], [52, 47349], [58, 47529], [61, 47749], [72, 48737], [76, 48878], [85, 49518], [88, 49718], [93, 49998], [96, 50158], [100, 50298]]}, {"verse": 8, "start": 51675, "end": 57361, "text": "Y no me encerraste en mano del enemigo; hiciste estar mis pies en anchura.", "words": [[0, 51675], [2, 51800], [5, 51960], [8, 52120], [19, 53040], [22, 53280], [27, 53620], [31, 53880], [40, 54967], [48, 55494], [54, 55794], [58, 56014], [63, 56314], [66, 56534]]}, {"verse": 9, "start": 57711, "end": 65924, "text": "Ten misericordia de mí, oh Jehová, que estoy en angustia: se han consumido de pesar mis ojos, mi alma, y mis entrañas.", "words": [[0, 57711], [4, 57874], [17, 58774], [20, 58934], [24, 59261], [27, 59587], [35, 59914], [39, 59974], [45, 60234], [48, 60434], [58, 61445], [61, 61612], [65, 61752], [75, 62532], [78, 62672], [84, 62952], [88, 63272], [94, 64152], [97, 64252], [103, 64552], [105, 64837], [109, 64977]]}, {"verse": 10, "start": 66274, "end": 76984, "text": "Porque mi vida se va gastando de dolor, y mis años de suspirar: se ha enflaquecido mi fuerza a causa de mi iniquidad, y mis huesos se han consumido.", "words": [[0, 66274], [7, 66462], [10, 66662], [15, 66942], [18, 67122], [21, 67262], [30, 67822], [33, 67982], [40, 68362], [42, 68842], [46, 69062], [51, 69342], [54, 69542], [64, 70489], [67, 70657], [70, 70817], [83, 71597], [86, 71777], [93, 72197], [95, 72577], [101, 72877], [104, 73157], [107, 73337], [118, 74137], [120, 74577], [124, 74797], [131, 75617], [134, 75917], [138, 76077]]}, {"verse": 11, "start": 77334, "end": 87299, "text": "De todos mis enemigos he sido deshonra, y de mis vecinos en gran manera, y horror a mis conocidos: los que me veían fuera, huían de mí.", "words": [[0, 77334], [3, 77478], [9, 77718], [13, 77998], [22, 78618], [25, 78798], [30, 79368], [40, 79938], [42, 80378], [45, 80518], [49, 80658], [57, 81218], [60, 81438], [65, 81678], [73, 82178], [75, 82818], [82, 83118], [84, 83398], [88, 83558], [99, 84822], [103, 84928], [107, 85088], [110, 85248], [116, 85708], [123, 86108], [129, 86793], [132, 87013]]}, {"verse": 12, "start": 87649, "end": 93575, "text": "He sido olvidado de su corazón como un muerto: he venido a ser como un vaso perdido.", "words": [[0, 87649], [3, 87771], [8, 88051], [17, 88831], [20, 89011], [23, 89171], [31, 89671], [36, 89821], [39, 89971], [47, 90946], [50, 91070], [57, 91510], [59, 91650], [63, 91890], [68, 92130], [71, 92350], [76, 92790]]}, {"verse": 13, "start": 93925, "end": 102897, "text": "Porque he oído afrenta de muchos; miedo por todas partes, cuando consultaban juntos contra mí, e ideaban quitarme la vida.", "words": [[0, 93925], [7, 94188], [10, 94468], [15, 94808], [23, 95428], [26, 95548], [34, 96591], [40, 96953], [44, 97193], [50, 97493], [58, 98473], [65, 98693], [77, 99513], [84, 99833], [91, 100293], [95, 100573], [97, 101193], [105, 101713], [114, 102313], [117, 102433]]}, {"verse": 14, "start": 103247, "end": 108009, "text": "Mas yo en ti confié, oh Jehová: yo dije: Dios mío eres tú.", "words": [[0, 103247], [4, 103247], [7, 103437], [10, 103617], [13, 103797], [21, 104367], [24, 104937], [32, 105953], [35, 106285], [41, 106617], [46, 106937], [50, 107357], [55, 107497]]}, {"verse": 15, "start": 108359, "end": 114335, "text": "En tu mano están mis tiempos: líbrame de la mano de mis enemigos, y de mis perseguidores.", "words": [[0, 108359], [3, 108543], [6, 108703], [11, 108963], [17, 109223], [21, 109463], [30, 110731], [38, 111031], [41, 111191], [44, 111331], [49, 111591], [52, 111771], [56, 111931], [66, 112591], [68, 112771], [71, 112911], [75, 113131]]}, {"verse": 16, "start": 114685, "end": 120360, "text": "Haz resplandecer tu rostro sobre tu siervo: sálvame por tu misericordia.", "words": [[0, 114685], [4, 115416], [17, 116182], [20, 116402], [27, 117002], [33, 117242], [36, 117462], [44, 118312], [52, 118834], [56, 119134], [59, 119274]]}, {"verse": 17, "start": 120710, "end": 129549, "text": "No sea yo avergonzado, oh Jehová, ya que te he invocado; sean avergonzados los impíos, estén mudos en el profundo.", "words": [[0, 120710], [3, 120835], [7, 121075], [10, 121335], [23, 121922], [26, 122508], [34, 123095], [37, 123335], [41, 123535], [44, 123715], [47, 123835], [57, 124815], [62, 125162], [75, 126202], [79, 126422], [87, 127442], [93, 127842], [99, 128382], [102, 128522], [105, 128642]]}, {"verse": 18, "start": 129899, "end": 137060, "text": "Enmudezcan los labios mentirosos, que hablan contra el justo cosas duras, con soberbia y menosprecio.", "words": [[0, 130272], [11, 130682], [15, 130882], [22, 131342], [34, 132182], [38, 132562], [45, 132962], [52, 133282], [55, 133462], [61, 133682], [67, 134102], [74, 134962], [78, 135282], [87, 135942], [89, 136182]]}, {"verse": 19, "start": 137410, "end": 147601, "text": "¡Cuán grande es tu bien, que has guardado para los que te temen, que has obrado para los que esperan en ti, delante de los hijos de los hombres!", "words": [[0, 137410], [6, 137753], [13, 138253], [16, 138513], [19, 138613], [25, 139393], [29, 139633], [33, 139813], [42, 140473], [47, 140713], [51, 140913], [55, 141073], [58, 141233], [65, 141993], [69, 142413], [73, 142613], [80, 143133], [85, 143473], [89, 143693], [93, 143853], [101, 144573], [104, 144733], [108, 145073], [116, 145933], [119, 146093], [123, 146233], [129, 146593], [132, 146733], [136, 146853]]}, {"verse": 20, "start": 147951, "end": 158097, "text": "Los esconderás en el secreto de tu rostro de las arrogancias del hombre: los pondrás en un tabernáculo a cubierto de contención de lenguas.", "words": [[0, 147951], [4, 148095], [15, 149115], [18, 149295], [21, 149435], [29, 150035], [32, 150155], [35, 150315], [42, 150955], [45, 151095], [49, 151605], [61, 152115], [65, 152355], [73, 153499], [77, 153659], [85, 154179], [88, 154379], [91, 154539], [103, 155099], [105, 155659], [114, 156219], [117, 156379], [128, 157059], [131, 157239]]}, {"verse": 21, "start": 158447, "end": 164991, "text": "Bendito Jehová, porque ha hecho maravillosa su misericordia para conmigo en ciudad fuerte.", "words": [[0, 158447], [8, 159034], [16, 159834], [23, 160194], [26, 160394], [32, 160654], [44, 161794], [47, 161994], [60, 162974], [65, 163154], [73, 163734], [76, 163854], [83, 164154]]}, {"verse": 22, "start": 165341, "end": 173945, "text": "Y decía yo en mi premura: Cortado soy de delante de tus ojos: pero tú oíste la voz de mis ruegos, cuando a ti clamaba.", "words": [[0, 165341], [2, 165635], [8, 166015], [11, 166335], [14, 166455], [17, 166635], [26, 168018], [34, 168392], [38, 168765], [41, 168825], [49, 169345], [52, 169505], [56, 169645], [62, 170345], [67, 170490], [70, 170750], [76, 171230], [79, 171370], [83, 171570], [86, 171710], [90, 171830], [98, 172450], [105, 172930], [107, 173150], [110, 173581]]}, {"verse": 23, "start": 174295, "end": 182361, "text": "Amad a Jehová todos vosotros sus santos: a los fieles guarda Jehová, y paga abundantemente al que obra con soberbia.", "words": [[0, 174448], [5, 174634], [7, 174821], [14, 175361], [20, 175521], [29, 176044], [33, 176568], [41, 177235], [43, 177454], [47, 177574], [54, 177994], [61, 178394], [69, 179014], [71, 179254], [76, 179694], [91, 180714], [94, 180894], [98, 181054], [103, 181334], [107, 181554]]}, {"verse": 24, "start": 182711, "end": 188744, "text": "Esforzaos todos vosotros los que esperáis en Jehová, y tome vuestro corazón aliento.", "words": [[0, 183083], [10, 183493], [16, 183853], [25, 184533], [29, 184753], [33, 184933], [42, 185413], [45, 185573], [53, 186413], [55, 186593], [60, 187033], [68, 187493], [76, 187893]]}]}