{"book": "1CO", "chapter": 15, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 391146, "verses": [{"verse": 1, "start": 300, "end": 7991, "text": "Además os declaro, hermanos, el evangelio que os he predicado, el cual también recibisteis, en el cual también perseveráis;", "words": [[0, 300], [7, 599], [10, 839], [19, 1299], [29, 2259], [32, 2359], [42, 3059], [46, 3159], [49, 3299], [52, 3379], [63, 4399], [66, 4459], [71, 4659], [79, 4979], [92, 6119], [95, 6199], [98, 6319], [103, 6539], [111, 6979]]}, {"verse": 2, "start": 8441, "end": 15234, "text": "Por el cual asimismo, si retenéis la palabra que os he predicado, sois salvos, si no creísteis en vano.", "words": [[0, 8441], [4, 8595], [7, 8675], [12, 9185], [22, 9695], [25, 9855], [34, 10435], [37, 10595], [45, 10915], [49, 11235], [52, 11395], [55, 11615], [66, 12675], [71, 12935], [79, 13835], [82, 13915], [85, 14075], [95, 14675], [98, 14815]]}, {"verse": 3, "start": 15684, "end": 23606, "text": "Porque primeramente os he enseñado lo que asimismo recibí: Que Cristo fue muerto por nuestros pecados, conforme a las Escrituras;", "words": [[0, 15684], [7, 15880], [20, 16660], [23, 16800], [26, 17040], [35, 17600], [38, 17740], [42, 18060], [51, 18380], [59, 19354], [63, 19454], [70, 19854], [74, 20174], [81, 20634], [85, 20874], [94, 21154], [103, 21894], [112, 22514], [114, 22594], [118, 22754]]}, {"verse": 4, "start": 24056, "end": 29185, "text": "Y que fue sepultado, y que resucitó al tercer día, conforme a las Escrituras;", "words": [[0, 24056], [2, 24156], [6, 24256], [10, 24436], [21, 25196], [23, 25616], [27, 25736], [36, 26396], [39, 26496], [46, 26736], [51, 27256], [60, 28136], [62, 28196], [66, 28336]]}, {"verse": 5, "start": 29635, "end": 32535, "text": "Y que apareció a Cefas, y después a los doce.", "words": [[0, 29635], [2, 29742], [6, 29862], [15, 30382], [17, 30712], [24, 31042], [26, 31262], [34, 31542], [36, 31842], [40, 31962]]}, {"verse": 6, "start": 32985, "end": 39671, "text": "Después apareció a más de quinientos hermanos juntos; de los cuales muchos viven aún, y otros son muertos.", "words": [[0, 32985], [8, 33329], [17, 34049], [19, 34189], [23, 34329], [26, 34589], [37, 34849], [46, 35489], [54, 36375], [57, 36456], [61, 36576], [68, 36836], [75, 37196], [81, 37696], [86, 37936], [88, 38416], [94, 38656], [98, 38976]]}, {"verse": 7, "start": 40121, "end": 44172, "text": "Después apareció a Jacobo; después a todos los apóstoles.", "words": [[0, 40121], [8, 40487], [17, 41147], [19, 41287], [27, 42196], [35, 42521], [37, 42821], [43, 43041], [47, 43241]]}, {"verse": 8, "start": 44622, "end": 49146, "text": "Y el último de todos, como a un nacido fuera de tiempo, me apareció a mí.", "words": [[0, 44622], [2, 44728], [5, 44828], [12, 45128], [15, 45368], [22, 46288], [27, 46415], [29, 46541], [32, 46668], [39, 47168], [45, 47408], [48, 47628], [56, 48108], [59, 48208], [68, 48768], [70, 48888]]}, {"verse": 9, "start": 49596, "end": 56077, "text": "Porque yo soy el más pequeño de los apóstoles, que no soy digno de ser llamado apóstol, porque perseguí la iglesia de Dios.", "words": [[0, 49596], [7, 49776], [10, 49956], [14, 50116], [17, 50236], [21, 50376], [29, 50696], [32, 50916], [36, 51016], [47, 51856], [51, 51916], [54, 52076], [58, 52256], [64, 52636], [67, 52716], [71, 52836], [79, 53156], [88, 54096], [95, 54436], [104, 54936], [107, 55036], [115, 55436], [118, 55576]]}, {"verse": 10, "start": 56527, "end": 67496, "text": "Pero por la gracia de Dios soy lo que soy: y su gracia no ha sido en vano para conmigo; antes he trabajado más que todos ellos: pero no yo, sino la gracia de Dios que fue conmigo.", "words": [[0, 56527], [5, 56675], [9, 56875], [12, 56995], [19, 57415], [22, 57535], [27, 57755], [31, 58095], [34, 58255], [38, 58375], [43, 59050], [45, 59139], [48, 59279], [55, 59739], [58, 59899], [61, 60019], [66, 60239], [69, 60459], [74, 60739], [79, 60919], [88, 61896], [94, 62238], [97, 62418], [107, 62998], [111, 63198], [115, 63418], [121, 63638], [128, 64550], [133, 64691], [136, 64911], [140, 65511], [145, 65631], [148, 65811], [155, 66211], [158, 66331], [163, 66511], [167, 66711], [171, 66871]]}, {"verse": 11, "start": 67946, "end": 71952, "text": "Porque, o sea yo o sean ellos, así predicamos, y así habéis creído.", "words": [[0, 67946], [8, 68154], [10, 68334], [14, 68494], [17, 68754], [19, 68894], [24, 69134], [31, 69354], [35, 69614], [47, 70274], [49, 70754], [53, 70954], [60, 71334]]}, {"verse": 12, "start": 72402, "end": 79750, "text": "Y si Cristo es predicado que resucitó de los muertos, ¿cómo dicen algunos entre vosotros que no hay resurrección de muertos?", "words": [[0, 72402], [2, 72524], [5, 72644], [12, 73044], [15, 73204], [25, 73804], [29, 73964], [38, 74624], [41, 74724], [45, 74844], [54, 75884], [60, 76024], [66, 76384], [74, 76744], [80, 77104], [89, 77624], [93, 77864], [96, 78104], [100, 78244], [113, 78944], [116, 79064]]}, {"verse": 13, "start": 80200, "end": 83855, "text": "Porque si no hay resurrección de muertos, Cristo tampoco resucitó:", "words": [[0, 80200], [7, 80377], [10, 80537], [13, 80717], [17, 80857], [30, 81537], [33, 81657], [42, 82277], [49, 82537], [57, 82957]]}, {"verse": 14, "start": 84305, "end": 90025, "text": "Y si Cristo no resucitó, vana es entonces nuestra predicación, vana es también vuestra fe.", "words": [[0, 84305], [2, 84425], [5, 84545], [12, 84885], [15, 85105], [25, 85695], [30, 86285], [33, 86405], [42, 86725], [50, 87105], [63, 87935], [68, 88765], [71, 88905], [79, 89165], [87, 89625]]}, {"verse": 15, "start": 90475, "end": 100381, "text": "Y aun somos hallados falsos testigos de Dios; porque hemos testificado de Dios que él haya levantado a Cristo; al cual no levantó, si en verdad los muertos no resucitan.", "words": [[0, 90475], [2, 90618], [6, 90738], [12, 91118], [21, 91578], [28, 92098], [37, 92538], [40, 92718], [46, 93469], [53, 93692], [59, 93932], [71, 94672], [74, 94812], [79, 95072], [83, 95332], [86, 95492], [91, 95632], [101, 96172], [103, 96272], [111, 97096], [114, 97225], [119, 97405], [122, 97605], [131, 98165], [134, 98425], [137, 98525], [144, 98765], [148, 98965], [156, 99365], [159, 99585]]}, {"verse": 16, "start": 100831, "end": 104496, "text": "Porque si los muertos no resucitan, tampoco Cristo resucitó:", "words": [[0, 100831], [7, 101014], [10, 101194], [14, 101354], [22, 101734], [25, 101954], [36, 102914], [44, 103174], [51, 103674]]}, {"verse": 17, "start": 104946, "end": 109942, "text": "Y si Cristo no resucitó, vuestra fe es vana; aún estáis en vuestros pecados.", "words": [[0, 104946], [2, 105048], [5, 105148], [12, 105488], [15, 105668], [25, 106408], [33, 106868], [36, 107088], [39, 107248], [45, 107986], [49, 108264], [56, 108784], [59, 108884], [68, 109184]]}, {"verse": 18, "start": 110392, "end": 113462, "text": "Entonces también los que durmieron en Cristo son perdidos.", "words": [[0, 110392], [9, 110813], [17, 111193], [21, 111393], [25, 111533], [35, 111973], [38, 112133], [45, 112413], [49, 112693]]}, {"verse": 19, "start": 113912, "end": 119991, "text": "Si en esta vida solamente esperamos en Cristo, somos los más dignos de compasión de todos los hombres.", "words": [[0, 113912], [3, 114093], [6, 114193], [11, 114453], [16, 114713], [26, 115093], [36, 115813], [39, 115973], [47, 116373], [53, 117073], [57, 117353], [61, 117573], [68, 118093], [71, 118193], [81, 118793], [84, 118953], [90, 119133], [94, 119393]]}, {"verse": 20, "start": 120441, "end": 125759, "text": "Pero ahora Cristo ha resucitado de los muertos; primicias de los que durmieron es hecho.", "words": [[0, 120441], [5, 120609], [11, 120909], [18, 121349], [21, 121609], [32, 122229], [35, 122349], [39, 122469], [48, 123422], [58, 123889], [61, 124089], [65, 124209], [69, 124389], [79, 124889], [82, 125229]]}, {"verse": 21, "start": 126209, "end": 131604, "text": "Porque por cuanto la muerte entró por un hombre, también por un hombre la resurrección de los muertos.", "words": [[0, 126209], [7, 126433], [11, 126653], [18, 126913], [21, 127133], [28, 127433], [34, 127993], [38, 128113], [41, 128273], [49, 128813], [57, 129113], [61, 129453], [64, 129593], [71, 129833], [74, 129973], [87, 130713], [90, 130833], [94, 130933]]}, {"verse": 22, "start": 132054, "end": 137306, "text": "Porque así como en Adam todos mueren, así también en Cristo todos serán vivificados.", "words": [[0, 132054], [7, 132232], [11, 132512], [16, 132792], [19, 132932], [24, 133172], [30, 133472], [38, 134192], [42, 134372], [50, 134732], [53, 134932], [60, 135272], [66, 135672], [72, 136052]]}, {"verse": 23, "start": 137756, "end": 144060, "text": "Pero cada uno en su orden: Cristo las primicias; luego los que son de Cristo, en su venida.", "words": [[0, 137756], [5, 137912], [10, 138192], [14, 138512], [17, 138712], [20, 138852], [27, 139733], [34, 140150], [38, 140370], [49, 141561], [55, 141760], [59, 142020], [63, 142140], [67, 142320], [70, 142520], [78, 142940], [81, 143200], [84, 143380]]}, {"verse": 24, "start": 144510, "end": 152457, "text": "Luego el fin; cuando entregará el reino a Dios y al Padre, cuando habrá quitado todo dominio, y toda autoridad y poder.", "words": [[0, 144510], [6, 144850], [9, 145050], [14, 145782], [21, 145991], [31, 146631], [34, 146771], [40, 147071], [42, 147211], [47, 147371], [49, 147551], [52, 147651], [59, 148431], [66, 148631], [72, 148951], [80, 149371], [85, 149631], [94, 150411], [96, 150711], [101, 150931], [111, 151591], [113, 151931]]}, {"verse": 25, "start": 152907, "end": 157945, "text": "Porque es necesario que él reine, hasta poner a todos sus enemigos debajo de sus pies.", "words": [[0, 152907], [7, 153132], [10, 153312], [20, 153872], [24, 154112], [27, 154252], [34, 154712], [40, 155212], [46, 155532], [48, 155692], [54, 155912], [58, 156172], [67, 156652], [74, 157072], [77, 157212], [81, 157352]]}, {"verse": 26, "start": 158395, "end": 162987, "text": "Y el último enemigo que será deshecho, será la muerte.", "words": [[0, 158395], [2, 158517], [5, 158677], [12, 158937], [20, 159457], [24, 159557], [29, 159987], [39, 160417], [44, 160817], [47, 160997]]}, {"verse": 27, "start": 163437, "end": 173267, "text": "Porque todas las cosas sujetó debajo de sus pies. Y cuando dice: Todas las cosas son sujetadas a él, claro está exceptuado aquel que sujetó a él todas las cosas.", "words": [[0, 163437], [7, 163644], [13, 163884], [17, 164164], [23, 164504], [30, 165024], [37, 165364], [40, 165504], [44, 165644], [50, 166532], [52, 166637], [59, 166837], [65, 167732], [71, 168014], [75, 168134], [81, 168434], [85, 168714], [95, 169294], [97, 169474], [101, 169894], [107, 170054], [112, 170314], [123, 170974], [129, 171314], [133, 171414], [140, 171934], [142, 172034], [145, 172154], [151, 172354], [155, 172654]]}, {"verse": 28, "start": 173717, "end": 184356, "text": "Pero luego que todas las cosas le estén sujetas, entonces también el mismo Hijo se sujetará al que le sujetó a él todas las cosas, para que Dios sea todas las cosas en todos.", "words": [[0, 173717], [5, 173854], [11, 174114], [15, 174334], [21, 174554], [25, 174854], [31, 175154], [34, 175414], [40, 175674], [49, 176574], [58, 176954], [66, 177534], [69, 177854], [75, 178174], [80, 178474], [83, 178674], [92, 179314], [95, 179574], [99, 179714], [102, 179834], [109, 180354], [111, 180454], [114, 180574], [120, 180814], [124, 181114], [131, 182005], [136, 182143], [140, 182303], [145, 182483], [149, 182763], [155, 183063], [159, 183303], [165, 183603], [168, 183843]]}, {"verse": 29, "start": 184806, "end": 193208, "text": "De otro modo, ¿qué harán los que se bautizan por los muertos, si en ninguna manera los muertos resucitan? ¿Por qué pues se bautizan por los muertos?", "words": [[0, 184806], [3, 184944], [8, 185164], [14, 185704], [19, 185804], [25, 186084], [29, 186204], [33, 186364], [36, 186504], [45, 187024], [49, 187144], [53, 187284], [62, 188144], [65, 188464], [68, 188564], [76, 188864], [83, 189264], [87, 189464], [95, 189864], [106, 191010], [111, 191129], [115, 191329], [120, 191549], [123, 191709], [132, 192209], [136, 192369], [140, 192509]]}, {"verse": 30, "start": 193658, "end": 196645, "text": "¿Y por qué nosotros peligramos a toda hora?", "words": [[0, 193658], [3, 193784], [7, 193964], [11, 194104], [20, 194504], [31, 195244], [33, 195404], [38, 195524]]}, {"verse": 31, "start": 197094, "end": 201998, "text": "Sí, por la gloria que en orden a vosotros tengo en Cristo Jesús Señor nuestro, cada día muero.", "words": [[0, 197094], [4, 197094], [8, 197198], [11, 197338], [18, 197678], [22, 197858], [25, 198018], [31, 198198], [33, 198418], [42, 198818], [48, 199098], [51, 199298], [58, 199538], [64, 200178], [70, 200378], [79, 201238], [84, 201338], [88, 201558]]}, {"verse": 32, "start": 202448, "end": 211040, "text": "Si como hombre batallé en Éfeso contra las bestias, ¿qué me aprovecha? Si los muertos no resucitan, comamos y bebamos, que mañana moriremos.", "words": [[0, 202448], [3, 202611], [8, 202831], [15, 203091], [23, 203631], [26, 203891], [32, 204151], [39, 204411], [43, 204631], [52, 205491], [57, 205571], [60, 205691], [71, 206644], [74, 206748], [78, 206908], [86, 207268], [89, 207488], [100, 208488], [108, 208968], [110, 209228], [119, 209868], [123, 209928], [130, 210228]]}, {"verse": 33, "start": 211490, "end": 215222, "text": "No erréis: las malas compañías corrompen las buenas costumbres.", "words": [[0, 211490], [3, 211836], [11, 212496], [15, 212596], [21, 212936], [31, 213516], [41, 213996], [45, 214156], [52, 214376]]}, {"verse": 34, "start": 215672, "end": 221517, "text": "Velad debidamente, y no pequéis; porque algunos no conocen a Dios: para vergüenza vuestra hablo.", "words": [[0, 215672], [6, 215990], [19, 216530], [21, 216770], [24, 216850], [33, 217832], [40, 218009], [48, 218329], [51, 218629], [59, 219089], [61, 219169], [67, 219981], [72, 220124], [82, 220644], [90, 221044]]}, {"verse": 35, "start": 221967, "end": 226610, "text": "Pero dirá alguno: ¿Cómo resucitarán los muertos? ¿Con qué cuerpo vendrán?", "words": [[0, 221967], [5, 222110], [10, 222410], [18, 223305], [24, 223483], [36, 224243], [40, 224343], [49, 225353], [54, 225469], [58, 225609], [65, 225889]]}, {"verse": 36, "start": 227060, "end": 230787, "text": "Necio, lo que tú siembras no se vivifica, si no muere antes.", "words": [[0, 227060], [7, 227464], [10, 227644], [14, 227784], [17, 227964], [26, 228384], [29, 228604], [32, 228764], [42, 229137], [45, 229511], [48, 229884], [54, 230204]]}, {"verse": 37, "start": 231237, "end": 238205, "text": "Y lo que siembras, no siembras el cuerpo que ha de salir, sino el grano desnudo, acaso de trigo, o de otro grano:", "words": [[0, 231237], [2, 231331], [5, 231431], [9, 231551], [19, 232391], [22, 232591], [31, 233131], [34, 233271], [41, 233571], [45, 233851], [48, 233971], [51, 234051], [58, 234731], [63, 234951], [66, 235151], [72, 235451], [81, 235961], [87, 236471], [90, 236651], [97, 237091], [99, 237351], [102, 237471], [107, 237711]]}, {"verse": 38, "start": 238655, "end": 242890, "text": "Pero Dios le da el cuerpo como quiso, y a cada semilla su propio cuerpo.", "words": [[0, 238655], [5, 238794], [10, 239034], [13, 239274], [16, 239434], [19, 239554], [26, 239854], [31, 240134], [38, 240574], [40, 241014], [42, 241154], [47, 241334], [55, 241854], [58, 242054], [65, 242314]]}, {"verse": 39, "start": 243340, "end": 253100, "text": "No toda carne es la misma carne; pero una carne ciertamente es la de los hombres, y otra carne la de los animales, y otra la de los peces, y otra la de las aves.", "words": [[0, 243340], [3, 243521], [8, 243721], [14, 244121], [17, 244361], [20, 244461], [26, 244661], [33, 245525], [38, 245665], [42, 245845], [48, 246165], [60, 247005], [63, 247365], [66, 247505], [69, 247605], [73, 247725], [82, 248145], [84, 248625], [89, 248765], [95, 249145], [98, 249285], [101, 249405], [105, 249505], [115, 250325], [117, 250565], [122, 250745], [125, 250885], [128, 251005], [132, 251105], [139, 251945], [141, 251985], [146, 252125], [149, 252285], [152, 252405], [156, 252525]]}, {"verse": 40, "start": 253550, "end": 261744, "text": "Y cuerpos hay celestiales, y cuerpos terrestres; pero ciertamente una es la gloria de los celestiales, y otra la de los terrestres.", "words": [[0, 253550], [2, 253647], [10, 253947], [14, 254247], [27, 255127], [29, 255327], [37, 255707], [49, 256780], [54, 256921], [66, 257721], [70, 258021], [73, 258321], [76, 258481], [83, 258861], [86, 258961], [90, 259081], [103, 259961], [105, 260241], [110, 260501], [113, 260661], [116, 260781], [120, 260901]]}, {"verse": 41, "start": 262194, "end": 270472, "text": "Otra es la gloria del sol, y otra la gloria de la luna, y otra la gloria de las estrellas: porque una estrella es diferente de otra en gloria.", "words": [[0, 262194], [5, 262496], [8, 262636], [11, 262776], [18, 263116], [22, 263276], [27, 263596], [29, 263976], [34, 264176], [37, 264336], [44, 264676], [47, 264816], [50, 264916], [56, 265276], [58, 265736], [63, 265936], [66, 266096], [73, 266476], [76, 266616], [80, 266756], [91, 267848], [98, 268045], [102, 268245], [111, 268725], [114, 268825], [124, 269185], [127, 269525], [132, 269745], [135, 269905]]}, {"verse": 42, "start": 270922, "end": 277078, "text": "Así también es la resurrección de los muertos. Se siembra en corrupción, se levantará en incorrupción;", "words": [[0, 270922], [4, 271143], [12, 271523], [15, 271763], [18, 271903], [31, 272583], [34, 272703], [38, 272823], [47, 273798], [50, 273960], [58, 274380], [61, 274440], [73, 275440], [76, 275520], [86, 276120], [89, 276220]]}, {"verse": 43, "start": 277528, "end": 283338, "text": "Se siembra en vergüenza, se levantará con gloria; se siembra en debilidad, se levantará con poder;", "words": [[0, 277528], [3, 277666], [11, 278126], [14, 278206], [25, 279026], [28, 279106], [38, 279626], [42, 279806], [50, 280688], [53, 280937], [61, 281227], [64, 281327], [75, 282027], [78, 282107], [88, 282607], [92, 282787]]}, {"verse": 44, "start": 283788, "end": 290694, "text": "Se siembra cuerpo natural, resucitará cuerpo espiritual. Hay cuerpo natural, y hay cuerpo espiritual.", "words": [[0, 283788], [3, 283948], [11, 284408], [18, 284648], [27, 285628], [38, 286348], [45, 286608], [57, 287824], [61, 288124], [68, 288444], [77, 289004], [79, 289324], [83, 289484], [90, 289764]]}, {"verse": 45, "start": 291144, "end": 298404, "text": "Así también está escrito: fue hecho el primer hombre Adam en alma viviente; el último Adam en espíritu que da vida.", "words": [[0, 291144], [4, 291484], [12, 291824], [17, 292104], [26, 293017], [30, 293175], [36, 293395], [39, 293515], [46, 293755], [53, 294095], [58, 294575], [61, 294895], [66, 295115], [76, 296185], [79, 296327], [86, 296647], [91, 297007], [94, 297227], [103, 297747], [107, 297847], [110, 297967]]}, {"verse": 46, "start": 298854, "end": 303024, "text": "Pero lo espiritual no es primero, sino lo natural; luego lo espiritual.", "words": [[0, 298854], [5, 298976], [8, 299136], [19, 299636], [22, 299876], [25, 300036], [34, 300416], [39, 300716], [42, 300876], [51, 301808], [57, 302057], [60, 302257]]}, {"verse": 47, "start": 303474, "end": 309393, "text": "El primer hombre, es de la tierra, formado de ella: el segundo hombre, que es el Señor, es del cielo.", "words": [[0, 303474], [3, 303590], [10, 303830], [18, 304170], [21, 304450], [24, 304570], [27, 304670], [35, 305010], [43, 305570], [46, 305770], [52, 306440], [55, 306520], [63, 306860], [71, 307320], [75, 307540], [78, 307680], [81, 307800], [88, 308180], [91, 308680], [95, 308840]]}, {"verse": 48, "start": 309843, "end": 317413, "text": "Como es el hombre hecho de tierra, así son también los hechos de tierra; y como es el celestial, así son también los celestiales.", "words": [[0, 309843], [5, 310047], [8, 310267], [11, 310407], [18, 310647], [24, 310947], [27, 311107], [35, 311807], [39, 311947], [43, 312227], [51, 312547], [55, 312727], [62, 313027], [65, 313187], [73, 314060], [75, 314163], [80, 314383], [83, 314543], [86, 314703], [97, 315623], [101, 315743], [105, 315983], [113, 316283], [117, 316483]]}, {"verse": 49, "start": 317863, "end": 322983, "text": "Y como hemos llevado la imagen del hombre hecho de tierra, también llevaremos la imagen del celestial.", "words": [[0, 317863], [2, 317962], [7, 318182], [13, 318382], [21, 318782], [24, 318902], [31, 319202], [35, 319422], [42, 319642], [48, 319902], [51, 320042], [59, 320842], [67, 321042], [78, 321602], [81, 321762], [88, 322042], [92, 322282]]}, {"verse": 50, "start": 323433, "end": 330541, "text": "Pero esto digo, hermanos: que la carne y la sangre no pueden heredar el reino de Dios; ni la corrupción hereda la incorrupción.", "words": [[0, 323433], [5, 323596], [10, 323835], [16, 324096], [26, 325136], [30, 325212], [33, 325332], [39, 325652], [41, 325832], [44, 325912], [51, 326252], [54, 326432], [61, 326752], [69, 327152], [72, 327272], [78, 327592], [81, 327712], [87, 328503], [90, 328624], [93, 328764], [104, 329304], [111, 329624], [114, 329764]]}, {"verse": 51, "start": 330991, "end": 336400, "text": "He aquí, os digo un misterio: Ciertamente no todos dormiremos, pero todos seremos transformados,", "words": [[0, 331031], [3, 331111], [9, 331251], [12, 331431], [17, 331631], [20, 331811], [30, 332732], [42, 333370], [45, 333550], [51, 333790], [63, 334690], [68, 334830], [74, 335170], [82, 335510]]}, {"verse": 52, "start": 336850, "end": 347541, "text": "En un momento, en un abrir y cerrar de ojos, a la final trompeta; porque será tocada la trompeta, y los muertos serán levantados sin corrupción, y nosotros seremos transformados.", "words": [[0, 336850], [3, 336971], [6, 337071], [15, 337531], [18, 338031], [21, 338151], [27, 338451], [29, 338591], [36, 338971], [39, 339131], [45, 339371], [47, 339711], [50, 339791], [56, 340031], [66, 341055], [73, 341235], [78, 341455], [85, 341915], [88, 342035], [98, 342715], [100, 343035], [104, 343155], [112, 343595], [118, 343915], [129, 344475], [133, 344655], [145, 345295], [147, 345695], [156, 345935], [164, 346495]]}, {"verse": 53, "start": 347991, "end": 355165, "text": "Porque es necesario que esto corruptible sea vestido de incorrupción, y esto mortal sea vestido de inmortalidad.", "words": [[0, 347991], [7, 348175], [10, 348355], [20, 348855], [24, 349095], [29, 349295], [41, 349975], [45, 350195], [53, 350675], [56, 350815], [70, 351495], [72, 351895], [77, 352175], [84, 352535], [88, 352815], [96, 353315], [99, 353435]]}, {"verse": 54, "start": 355615, "end": 366742, "text": "Y cuando esto corruptible se haya vestido de incorrupción, y esto mortal se haya vestido de inmortalidad, entonces se efectuará la palabra que está escrita: La muerte ha sido tragada en victoria.", "words": [[0, 355615], [2, 355746], [9, 355986], [14, 356306], [26, 356966], [29, 357186], [34, 357306], [42, 357786], [45, 357946], [59, 358646], [61, 358946], [66, 359186], [73, 359546], [76, 359806], [81, 359946], [89, 360386], [92, 360506], [106, 361506], [115, 361826], [118, 362226], [128, 362746], [131, 362846], [139, 363206], [143, 363386], [148, 363586], [157, 364536], [160, 364641], [167, 364981], [170, 365341], [175, 365541], [183, 366021], [186, 366121]]}, {"verse": 55, "start": 367192, "end": 371484, "text": "¿Dónde está, oh muerte, tu aguijón? ¿dónde, oh sepulcro, tu victoria?", "words": [[0, 367192], [7, 367498], [13, 367708], [16, 367918], [24, 368298], [27, 368498], [36, 369484], [44, 369821], [47, 370195], [57, 370568], [60, 370748]]}, {"verse": 56, "start": 371934, "end": 376181, "text": "Ya que el aguijón de la muerte es el pecado, y el poder del pecado, la ley.", "words": [[0, 371934], [3, 372079], [7, 372259], [10, 372399], [18, 372839], [21, 372939], [24, 373059], [31, 373359], [34, 373639], [37, 373779], [45, 374299], [47, 374599], [50, 374719], [56, 374979], [60, 375179], [68, 375679], [71, 375839]]}, {"verse": 57, "start": 376631, "end": 381075, "text": "Pero a Dios gracias, que nos da la victoria por el Señor nuestro Jesucristo.", "words": [[0, 376631], [5, 376836], [7, 377042], [12, 377249], [21, 378069], [25, 378189], [29, 378369], [32, 378569], [35, 378669], [44, 379209], [48, 379409], [51, 379549], [57, 379769], [65, 380089]]}, {"verse": 58, "start": 381525, "end": 390746, "text": "Así que, hermanos míos amados, estad firmes y constantes, creciendo en la obra del Señor siempre, sabiendo que vuestro trabajo en el Señor no es vano.", "words": [[0, 381525], [4, 381719], [9, 381939], [18, 382299], [23, 382639], [31, 383269], [37, 383899], [44, 384499], [46, 384579], [58, 385359], [68, 386039], [71, 386179], [74, 386279], [79, 386519], [83, 386699], [89, 386979], [98, 387959], [107, 388379], [111, 388559], [119, 388879], [127, 389259], [130, 389439], [133, 389539], [139, 389779], [142, 390159], [145, 390319]]}]}