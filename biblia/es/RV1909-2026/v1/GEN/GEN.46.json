{"book": "GEN", "chapter": 46, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 289902, "verses": [{"verse": 1, "start": 300, "end": 8661, "text": "Salió Israel con todo lo que tenía, y vino a Beerseba, y ofreció sacrificios al Dios de su padre Isaac.", "words": [[0, 300], [6, 688], [13, 1188], [17, 1528], [22, 1868], [25, 2088], [29, 2488], [36, 2888], [38, 3168], [43, 3428], [45, 4198], [55, 4968], [57, 5048], [65, 5648], [77, 6588], [80, 6788], [85, 7048], [88, 7288], [91, 7428], [97, 7948]]}, {"verse": 2, "start": 9111, "end": 17667, "text": "Y habló Dios a Israel en visiones de noche, y dijo: Jacob, Jacob. Y él respondió: Aquí estoy.", "words": [[0, 9111], [2, 9415], [8, 9755], [13, 9895], [15, 10135], [22, 10615], [25, 10815], [34, 11315], [37, 11435], [44, 12235], [46, 12475], [52, 13622], [59, 13982], [66, 14917], [68, 15099], [71, 15239], [82, 16284], [87, 16508]]}, {"verse": 3, "start": 18017, "end": 25828, "text": "Y dijo: Yo soy Dios, el Dios de tu padre; no temas de descender a Egipto, porque yo te pondré allí en gran nación.", "words": [[0, 18017], [2, 18146], [8, 18918], [11, 19066], [15, 19246], [21, 19806], [24, 19866], [29, 20046], [32, 20226], [35, 20346], [42, 21450], [45, 21567], [51, 21887], [54, 22107], [64, 22567], [66, 22687], [74, 23367], [81, 23727], [84, 23907], [87, 24047], [94, 24447], [99, 24687], [102, 24827], [107, 24987]]}, {"verse": 4, "start": 26278, "end": 33318, "text": "Yo descenderé contigo a Egipto, y yo también te haré volver: y José pondrá su mano sobre tus ojos.", "words": [[0, 26278], [3, 26546], [14, 27126], [22, 27586], [24, 27666], [32, 28186], [34, 28566], [37, 28686], [45, 28966], [48, 29286], [53, 29486], [61, 30580], [63, 30699], [68, 30979], [75, 31459], [78, 31619], [83, 31899], [89, 32199], [93, 32419]]}, {"verse": 5, "start": 33668, "end": 46110, "text": "Y se levantó Jacob de Beerseba; y tomaron los hijos de Israel a su padre Jacob, y a sus niños, y a sus mujeres, en los carros que Faraón había enviado para llevarlo.", "words": [[0, 33668], [2, 33795], [5, 33915], [13, 34495], [19, 34835], [22, 35437], [32, 36277], [34, 36590], [42, 36990], [46, 37170], [52, 37450], [55, 37630], [62, 38010], [64, 38190], [67, 38310], [73, 38670], [80, 39110], [82, 39770], [84, 39830], [88, 39970], [95, 40390], [97, 40910], [99, 40970], [103, 41130], [112, 41590], [115, 42170], [119, 42310], [126, 42930], [130, 43410], [137, 43890], [143, 44230], [151, 45030], [156, 45310]]}, {"verse": 6, "start": 46560, "end": 56729, "text": "Y tomaron sus ganados, y sus bienes que había adquirido en la tierra de Canaán, y se vinieron a Egipto, Jacob, y toda su descendencia consigo;", "words": [[0, 46560], [2, 46657], [10, 47097], [14, 47317], [23, 47937], [25, 48577], [29, 48737], [36, 49217], [40, 49337], [46, 49617], [56, 50337], [59, 50437], [62, 50557], [69, 50877], [72, 51117], [80, 51697], [82, 52177], [85, 52297], [94, 52717], [96, 52877], [104, 53697], [111, 54117], [113, 54677], [118, 54897], [121, 55157], [134, 55957]]}, {"verse": 7, "start": 57179, "end": 67033, "text": "Sus hijos, y los hijos de sus hijos consigo; sus hijas, y las hijas de sus hijos, y a toda su descendencia trajo consigo a Egipto.", "words": [[0, 57179], [4, 57378], [11, 57758], [13, 58058], [17, 58238], [23, 58558], [26, 59118], [30, 59358], [36, 59658], [45, 60825], [49, 60990], [56, 61570], [58, 61930], [62, 62110], [68, 62530], [71, 62650], [75, 62850], [82, 63170], [84, 63650], [86, 63770], [91, 63930], [94, 64230], [107, 65110], [113, 65630], [121, 66050], [123, 66350]]}, {"verse": 8, "start": 67483, "end": 76971, "text": "Y estos son los nombres de los hijos de Israel, que entraron en Egipto, Jacob y sus hijos: Rubén, el primogénito de Jacob.", "words": [[0, 67483], [2, 67668], [8, 67888], [12, 68288], [16, 68468], [24, 68948], [27, 69128], [31, 69248], [37, 69568], [40, 69768], [48, 70268], [52, 70868], [61, 71628], [64, 71748], [72, 72428], [78, 72688], [80, 73128], [84, 73348], [91, 74301], [98, 75226], [101, 75326], [113, 76166], [116, 76306]]}, {"verse": 9, "start": 77421, "end": 82344, "text": "Y los hijos de Rubén: Hanoc, y Falú, y Hezrón, y Carmi.", "words": [[0, 77421], [2, 77521], [6, 77641], [12, 77901], [15, 78121], [22, 79438], [29, 79864], [31, 80289], [37, 80714], [39, 81139], [47, 81564], [49, 81990]]}, {"verse": 10, "start": 82794, "end": 90380, "text": "Y los hijos de Simeón: Jemuel, y Jamín, y Ohad, y Jaquín, y Zohar, y Saúl, hijo de la cananea.", "words": [[0, 82794], [2, 82893], [6, 83033], [12, 83293], [15, 83513], [23, 84606], [31, 84978], [33, 85389], [40, 85800], [42, 86211], [48, 86622], [50, 87032], [58, 87443], [60, 87854], [67, 88265], [69, 88676], [75, 89087], [80, 89247], [83, 89447], [86, 89587]]}, {"verse": 11, "start": 90830, "end": 95261, "text": "Y los hijos de Leví: Gersón, y Coat, y Merari.", "words": [[0, 90830], [2, 91152], [6, 91292], [12, 91592], [15, 91832], [21, 92864], [29, 93184], [31, 93464], [37, 94024], [39, 94584]]}, {"verse": 12, "start": 95711, "end": 107641, "text": "Y los hijos de Judá: Er, y Onán, y Sela, y Fares, y Zara: mas Er y Onán, murieron en la tierra de Canaán. Y los hijos de Fares fueron Hezrón y Hamul.", "words": [[0, 95711], [2, 95819], [6, 95939], [12, 96199], [15, 96333], [21, 97118], [25, 97469], [27, 97820], [33, 98171], [35, 98522], [41, 98873], [43, 99224], [50, 99575], [52, 99926], [58, 100556], [62, 100828], [65, 101133], [67, 101438], [73, 101743], [82, 102523], [85, 102803], [88, 102943], [95, 103323], [98, 103823], [106, 104574], [108, 104698], [112, 104838], [118, 105138], [121, 105318], [127, 105758], [134, 106308], [141, 106858], [143, 107278]]}, {"verse": 13, "start": 108091, "end": 113489, "text": "Y los hijos de Isacar: Tola, y Fúa, y Job, y Simrón.", "words": [[0, 108091], [2, 108180], [6, 108320], [12, 108640], [15, 108880], [23, 110596], [29, 110596], [31, 110739], [36, 111639], [38, 112049], [43, 112459], [45, 113002]]}, {"verse": 14, "start": 113939, "end": 118176, "text": "Y los hijos de Zabulón: Sered, y Elón, y Jahleel.", "words": [[0, 113939], [2, 114047], [6, 114187], [12, 114527], [15, 115097], [24, 116292], [31, 116676], [33, 117059], [39, 117443], [41, 117827]]}, {"verse": 15, "start": 118626, "end": 129192, "text": "Estos fueron los hijos de Lea, los que parió a Jacob en Padan-aram, y además su hija Dina: treinta y tres las almas todas de sus hijos e hijas.", "words": [[0, 118626], [6, 118851], [13, 119151], [17, 119351], [23, 119651], [26, 119851], [31, 120451], [35, 120891], [39, 121031], [45, 121451], [47, 121611], [53, 121951], [56, 122311], [68, 123171], [70, 123651], [77, 123951], [80, 124424], [85, 124898], [91, 125848], [99, 126128], [101, 126408], [106, 126688], [110, 126848], [116, 127228], [122, 127508], [125, 127768], [129, 127968], [135, 128248], [137, 128529]]}, {"verse": 16, "start": 129642, "end": 137857, "text": "Y los hijos de Gad: Zifión, y Hagui, y Ezbón, y Suni, y Heri, y Arodi, y Areli.", "words": [[0, 129642], [2, 129942], [6, 130102], [12, 130382], [15, 130702], [20, 131786], [28, 132076], [30, 132566], [37, 133056], [39, 133646], [46, 134236], [48, 134726], [54, 135216], [56, 135666], [62, 136116], [64, 136236], [71, 137076], [73, 137176]]}, {"verse": 17, "start": 138307, "end": 148797, "text": "Y los hijos de Aser: Imna, e Isúa, e Isúi, y Beria, y Sera, hermana de ellos. Los hijos de Beria: Heber, y Malquiel.", "words": [[0, 138307], [2, 138433], [6, 138553], [12, 138853], [15, 139593], [21, 140932], [27, 141307], [29, 141682], [35, 142057], [37, 142432], [43, 142807], [45, 143182], [52, 143557], [54, 143777], [60, 144037], [68, 144577], [71, 144757], [78, 145594], [82, 146012], [88, 146292], [91, 146722], [98, 147601], [105, 147811], [107, 148341]]}, {"verse": 18, "start": 149247, "end": 157697, "text": "Estos fueron los hijos de Zilpa, la que Labán dio a su hija Lea, y parió estos a Jacob; todas dieciséis almas.", "words": [[0, 149247], [6, 149513], [13, 149733], [17, 149933], [23, 150213], [26, 150713], [33, 151213], [36, 151333], [40, 151673], [46, 152013], [50, 152353], [52, 152613], [55, 152926], [60, 153240], [65, 153553], [67, 153893], [73, 154213], [79, 154533], [81, 154753], [88, 155656], [94, 156190], [104, 156760]]}, {"verse": 19, "start": 158147, "end": 162678, "text": "Y los hijos de Raquel, mujer de Jacob: José y Benjamín.", "words": [[0, 158147], [2, 158537], [6, 158677], [12, 158897], [15, 159137], [23, 159697], [29, 160177], [32, 160377], [39, 161229], [44, 161707], [46, 162222]]}, {"verse": 20, "start": 163128, "end": 171961, "text": "Y nacieron a José en la tierra de Egipto Manasés y Efraín, los que le parió Asenat, hija de Potifera, sacerdote de On.", "words": [[0, 163128], [2, 163228], [11, 163588], [13, 163709], [18, 164088], [21, 164389], [24, 164508], [31, 164848], [34, 165128], [41, 165709], [49, 166168], [51, 166428], [59, 167408], [63, 167489], [67, 167628], [70, 167748], [76, 168418], [84, 169088], [89, 169428], [92, 169508], [102, 170588], [112, 171046], [115, 171504]]}, {"verse": 21, "start": 172411, "end": 182434, "text": "Y los hijos de Benjamín fueron Bela, y Bequer y Asbel, y Gera, y Naamán, y Ehi, y Ros y Mupim, y Hupim, y Ard.", "words": [[0, 172411], [2, 172535], [6, 172675], [12, 172955], [15, 173175], [24, 173755], [31, 174015], [37, 175435], [39, 175712], [46, 175988], [48, 176265], [55, 176542], [57, 176818], [63, 177095], [65, 177535], [73, 178042], [75, 178548], [80, 179055], [82, 179255], [86, 179615], [88, 179975], [95, 180482], [97, 180988], [104, 181495], [106, 181975]]}, {"verse": 22, "start": 182884, "end": 188825, "text": "Estos fueron los hijos de Raquel, que nacieron a Jacob: en todas, catorce almas.", "words": [[0, 182884], [6, 183125], [13, 183505], [17, 183725], [23, 184025], [26, 184225], [34, 184785], [38, 184865], [47, 185325], [49, 185505], [56, 187504], [59, 187504], [66, 187504], [74, 188126]]}, {"verse": 23, "start": 189275, "end": 192972, "text": "Y los hijos de Dan: Husim.", "words": [[0, 189275], [2, 189400], [6, 189520], [12, 189780], [15, 190020], [20, 192185]]}, {"verse": 24, "start": 193422, "end": 196395, "text": "Y los hijos de Neftalí: Jahzeel, y Guni, y Jezer, y Silem.", "words": [[0, 193529], [2, 193665], [6, 193802], [12, 193938], [15, 194074], [24, 194705], [33, 194900], [35, 195094], [41, 195288], [43, 195482], [50, 195677], [52, 195871]]}, {"verse": 25, "start": 196845, "end": 204797, "text": "Estos fueron los hijos de Bilha, la que dio Labán a Raquel su hija, y parió estos a Jacob; todas siete almas.", "words": [[0, 196845], [6, 197108], [13, 197408], [17, 197628], [23, 197908], [26, 198368], [33, 198828], [36, 199068], [40, 199208], [44, 199428], [50, 199888], [52, 200168], [59, 200448], [62, 200648], [68, 201308], [70, 201468], [76, 201887], [82, 202305], [84, 202724], [91, 203380], [97, 203667], [103, 204047]]}, {"verse": 26, "start": 205247, "end": 215574, "text": "Todas las personas que vinieron con Jacob a Egipto, descendientes directos de Jacob, sin las mujeres de los hijos de Jacob, todas las personas fueron sesenta y seis.", "words": [[0, 205247], [6, 205511], [10, 205671], [19, 206071], [23, 206291], [32, 206731], [36, 206951], [42, 207291], [44, 207591], [52, 208411], [66, 209351], [75, 209971], [78, 210051], [85, 210451], [89, 211091], [93, 211331], [101, 211731], [104, 211971], [108, 212071], [114, 212331], [117, 212511], [124, 213231], [130, 213411], [134, 213591], [143, 213991], [150, 214402], [158, 214812], [160, 215223]]}, {"verse": 27, "start": 216024, "end": 225789, "text": "Y los hijos de José, que le nacieron en Egipto, dos personas. Todas las almas de la casa de Jacob, que entraron en Egipto, fueron setenta.", "words": [[0, 216024], [2, 216147], [6, 216287], [12, 216567], [15, 216767], [21, 217067], [25, 217287], [28, 217407], [37, 217947], [40, 218127], [48, 218867], [52, 219007], [62, 220191], [68, 220577], [72, 220817], [78, 221297], [81, 221457], [84, 221557], [89, 221857], [92, 222077], [99, 222477], [103, 222957], [112, 223657], [115, 223857], [123, 224457], [130, 225157]]}, {"verse": 28, "start": 226239, "end": 233195, "text": "Y envió a Judá delante de sí a José, para que le viniese a ver a Gosén; y llegaron a la tierra de Gosén.", "words": [[0, 226239], [2, 226362], [8, 226742], [10, 226902], [15, 227202], [23, 227582], [26, 227782], [29, 227942], [31, 228082], [37, 228382], [42, 229122], [46, 229262], [49, 229402], [57, 229862], [59, 229962], [63, 230102], [65, 230505], [72, 231158], [74, 231262], [83, 231742], [85, 231862], [88, 231922], [95, 232402], [98, 232824]]}, {"verse": 29, "start": 233645, "end": 244999, "text": "Y José unció su carro y vino a recibir a Israel su padre a Gosén; y se manifestó a él, y se echó sobre su cuello, y lloró sobre su cuello bastante.", "words": [[0, 233645], [2, 233787], [7, 234067], [13, 234667], [16, 234867], [22, 235287], [24, 235767], [29, 236007], [31, 236127], [39, 236487], [41, 236707], [48, 237187], [51, 237387], [57, 237786], [59, 238185], [66, 238841], [68, 239096], [71, 239216], [81, 239956], [83, 240096], [87, 240676], [89, 240936], [92, 241076], [97, 241416], [103, 241696], [106, 241896], [114, 242836], [116, 242936], [122, 243256], [128, 243496], [131, 243736], [138, 244096]]}, {"verse": 30, "start": 245449, "end": 251820, "text": "Entonces Israel dijo a José: Muera yo ahora, ya que he visto tu rostro, pues aun vives.", "words": [[0, 245449], [9, 245950], [16, 246650], [21, 247230], [23, 247590], [29, 248372], [35, 248691], [38, 248891], [45, 249191], [48, 249411], [52, 249591], [55, 249651], [61, 249911], [64, 250091], [72, 250891], [77, 250991], [81, 251171]]}, {"verse": 31, "start": 252170, "end": 265008, "text": "Y José dijo a sus hermanos, y a la casa de su padre: Subiré y haré saber a Faraón, y le diré: Mis hermanos y la casa de mi padre, que estaban en la tierra de Canaán, han venido a mí;", "words": [[0, 252170], [2, 252333], [7, 252573], [12, 253033], [14, 253193], [18, 253353], [28, 254213], [30, 254733], [32, 254833], [35, 254913], [40, 255233], [43, 255473], [46, 255633], [53, 256601], [60, 257007], [62, 257187], [67, 257427], [73, 257627], [75, 257917], [83, 258207], [85, 258287], [88, 258387], [94, 259107], [98, 259210], [107, 259770], [109, 259870], [112, 259970], [117, 260230], [120, 260410], [123, 260530], [130, 260870], [134, 261110], [142, 261450], [145, 261630], [148, 261750], [155, 262010], [158, 262210], [166, 262690], [170, 262990], [177, 263370], [179, 263510]]}, {"verse": 32, "start": 265458, "end": 272564, "text": "Y los hombres son pastores de ovejas, porque son hombres ganaderos: y han traído sus ovejas y sus vacas, y todo lo que tenían.", "words": [[0, 265458], [2, 265543], [6, 265663], [14, 265943], [18, 266183], [27, 266663], [30, 266843], [38, 267323], [45, 267903], [49, 268143], [57, 268423], [68, 269553], [70, 269671], [74, 269771], [81, 270091], [85, 270251], [92, 270691], [94, 270851], [98, 271011], [105, 271511], [107, 271631], [112, 271791], [115, 271951], [119, 272051]]}, {"verse": 33, "start": 273014, "end": 276448, "text": "Y cuando Faraón os llame y diga: ¿cuál es vuestro oficio?", "words": [[0, 273014], [2, 273099], [9, 273319], [16, 273539], [19, 273759], [25, 274159], [27, 274299], [33, 274983], [39, 275286], [42, 275406], [50, 275786]]}, {"verse": 34, "start": 276898, "end": 289502, "text": "Entonces diréis: Tus siervos se han dedicado a criar ganado desde nuestra juventud hasta ahora, al igual que nuestros padres; a fin de que moréis en la tierra de Gosén, porque los egipcios detestan el oficio de pastor.", "words": [[0, 276898], [9, 277278], [17, 278332], [21, 278433], [29, 278873], [32, 279033], [36, 279113], [45, 279633], [47, 279713], [53, 279953], [60, 280413], [66, 280593], [74, 280873], [83, 281573], [89, 281793], [96, 282333], [99, 282613], [105, 282813], [109, 283013], [118, 283233], [126, 284316], [128, 284440], [132, 284660], [135, 284820], [139, 284920], [146, 285360], [149, 285480], [152, 285600], [159, 285860], [162, 286210], [169, 286560], [176, 286900], [180, 287120], [189, 287660], [198, 288260], [201, 288380], [208, 288720], [211, 288860]]}]}