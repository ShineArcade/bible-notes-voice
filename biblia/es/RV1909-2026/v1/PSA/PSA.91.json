{"book": "PSA", "chapter": 91, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 96459, "verses": [{"verse": 1, "start": 300, "end": 5877, "text": "El que habita al abrigo del Altísimo, morará bajo la sombra del Omnipotente.", "words": [[0, 300], [3, 466], [7, 626], [14, 1086], [17, 1226], [24, 1646], [28, 1746], [38, 2426], [45, 3121], [50, 3521], [53, 3741], [60, 4241], [64, 4461]]}, {"verse": 2, "start": 6227, "end": 12152, "text": "Diré yo a Jehová: Esperanza mía, y castillo mío; mi Dios, en él confiaré.", "words": [[0, 6227], [5, 6767], [8, 6967], [10, 7147], [18, 7894], [28, 8354], [33, 8934], [35, 9074], [44, 9554], [49, 10232], [52, 10363], [58, 11044], [61, 11234], [64, 11424]]}, {"verse": 3, "start": 12502, "end": 17579, "text": "Y él te librará del lazo del cazador: de la peste destruidora.", "words": [[0, 12502], [2, 12665], [5, 12805], [8, 12945], [16, 13485], [20, 13665], [25, 14165], [29, 14345], [38, 15368], [41, 15511], [44, 15631], [50, 16151]]}, {"verse": 4, "start": 17929, "end": 24795, "text": "Con sus plumas te cubrirá, y debajo de sus alas estarás seguro: escudo y defensa es su verdad.", "words": [[0, 17929], [4, 18223], [8, 18463], [15, 19023], [18, 19163], [27, 19823], [29, 20203], [36, 20603], [39, 20763], [43, 20943], [48, 21383], [56, 21863], [64, 22716], [71, 23316], [73, 23416], [81, 23936], [84, 24116], [87, 24276]]}, {"verse": 5, "start": 25145, "end": 30253, "text": "No tendrás temor de espanto nocturno, ni de flecha que vuele de día;", "words": [[0, 25145], [3, 25294], [11, 25754], [17, 26194], [20, 26354], [28, 26914], [38, 28194], [41, 28454], [44, 28594], [51, 29034], [55, 29294], [61, 29554], [64, 29714]]}, {"verse": 6, "start": 30603, "end": 36838, "text": "Ni de pestilencia que ande en oscuridad, ni de mortandad que en medio del día destruya.", "words": [[0, 30603], [3, 30731], [6, 30871], [18, 31651], [22, 31911], [27, 32231], [30, 32391], [41, 33471], [44, 33671], [47, 33811], [57, 34611], [61, 34851], [64, 34991], [70, 35291], [74, 35591], [78, 35891]]}, {"verse": 7, "start": 37188, "end": 42462, "text": "Caerán a tu lado mil, y diez mil a tu diestra: mas a ti no llegará.", "words": [[0, 37188], [7, 37672], [9, 37792], [12, 37892], [17, 38172], [22, 38452], [24, 39072], [29, 39332], [33, 39752], [35, 39932], [38, 40072], [47, 41186], [51, 41314], [53, 41442], [56, 41570], [59, 41698]]}, {"verse": 8, "start": 42812, "end": 48584, "text": "Ciertamente con tus ojos mirarás, y verás la recompensa de los impíos.", "words": [[0, 42812], [12, 43617], [16, 43857], [20, 44077], [25, 44397], [34, 45277], [36, 45697], [42, 46157], [45, 46477], [56, 47397], [59, 47537], [63, 47657]]}, {"verse": 9, "start": 48934, "end": 53917, "text": "Porque tú has puesto a Jehová, que es mi esperanza, al Altísimo por tu habitación,", "words": [[0, 48934], [7, 49156], [10, 49396], [14, 49576], [21, 49776], [23, 50056], [31, 50536], [35, 50596], [38, 50736], [41, 50856], [52, 51876], [55, 52076], [64, 52716], [68, 52996], [71, 53156]]}, {"verse": 10, "start": 54267, "end": 57654, "text": "No te sobrevendrá mal, ni plaga tocará tu morada.", "words": [[0, 54267], [3, 54395], [6, 54515], [18, 55235], [23, 55555], [26, 55955], [32, 56415], [39, 56895], [42, 56995]]}, {"verse": 11, "start": 58004, "end": 64626, "text": "Pues que a sus ángeles mandará acerca de ti, que te guarden en todos tus caminos.", "words": [[0, 58004], [5, 58248], [9, 58608], [11, 58748], [15, 58868], [23, 59488], [31, 60248], [38, 60648], [41, 60988], [45, 61528], [49, 62088], [52, 62248], [60, 62828], [63, 62948], [69, 63328], [73, 63871]]}, {"verse": 12, "start": 64976, "end": 68723, "text": "En las manos te llevarán, porque tu pie no tropiece en piedra.", "words": [[0, 65067], [3, 65247], [7, 65387], [13, 65727], [16, 65947], [26, 66467], [33, 66727], [36, 66967], [40, 67207], [43, 67407], [52, 67927], [55, 68107]]}, {"verse": 13, "start": 69073, "end": 75590, "text": "Sobre el león y el áspid pisarás; hollarás al cachorro del león y al dragón.", "words": [[0, 69073], [6, 69459], [9, 69799], [14, 70239], [16, 70709], [19, 71178], [25, 71648], [34, 72546], [43, 72866], [46, 73026], [55, 73606], [59, 73826], [64, 74406], [66, 74666], [69, 74846]]}, {"verse": 14, "start": 75810, "end": 83783, "text": "Por cuanto en mí ha puesto su voluntad, yo también lo libraré: lo pondré en alto, por cuanto ha conocido mi nombre.", "words": [[0, 75810], [4, 75974], [11, 76274], [14, 76514], [17, 76754], [20, 76954], [27, 77234], [30, 77474], [40, 78614], [43, 78734], [51, 79094], [54, 79294], [63, 80402], [66, 80507], [73, 80907], [76, 81027], [82, 81607], [86, 81867], [93, 82127], [96, 82327], [105, 82807], [108, 82947]]}, {"verse": 15, "start": 84133, "end": 91663, "text": "Me invocará, y yo le responderé: con él estaré yo en la angustia: lo libraré, y le glorificaré.", "words": [[0, 84133], [3, 84236], [13, 84796], [15, 85116], [18, 85256], [21, 85376], [33, 86648], [37, 86812], [40, 86992], [47, 87432], [50, 87612], [53, 87872], [56, 88012], [66, 89252], [69, 89350], [78, 89870], [80, 90350], [83, 90490]]}, {"verse": 16, "start": 92013, "end": 96059, "text": "Lo saciaré de larga vida, y mostraréle mi salvación.", "words": [[0, 92212], [3, 92452], [11, 92692], [14, 92832], [20, 93192], [26, 93472], [28, 93992], [39, 94712], [42, 94972]]}]}