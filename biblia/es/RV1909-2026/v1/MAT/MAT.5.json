{"book": "MAT", "chapter": 5, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 389589, "verses": [{"verse": 1, "start": 300, "end": 6727, "text": "Y viendo la multitud, subió al monte; y sentándose, se llegaron a él sus discípulos.", "words": [[0, 300], [2, 446], [9, 746], [12, 966], [22, 1606], [28, 2226], [31, 2386], [38, 3236], [40, 3363], [52, 4683], [55, 4903], [64, 5443], [66, 5523], [69, 5723], [73, 5923]]}, {"verse": 2, "start": 7077, "end": 9753, "text": "Y abriendo su boca, les enseñaba, diciendo:", "words": [[0, 7077], [2, 7363], [11, 7823], [14, 8003], [20, 8343], [24, 8583], [34, 9323]]}, {"verse": 3, "start": 9753, "end": 16331, "text": "Bienaventurados los pobres en espíritu: porque de ellos es el reino de los cielos.", "words": [[0, 9843], [16, 11423], [20, 11603], [27, 12063], [30, 12243], [40, 13152], [47, 13472], [50, 13732], [56, 14072], [59, 14492], [62, 14812], [68, 15332], [71, 15452], [75, 15572]]}, {"verse": 4, "start": 16681, "end": 21162, "text": "Bienaventurados los que lloran: porque ellos recibirán consolación.", "words": [[0, 17329], [16, 17689], [20, 17869], [24, 18049], [32, 18853], [39, 19090], [45, 19350], [55, 20110]]}, {"verse": 5, "start": 21512, "end": 26589, "text": "Bienaventurados los mansos: porque ellos heredarán la tierra.", "words": [[0, 22252], [16, 23092], [20, 23212], [28, 24265], [35, 24489], [41, 24889], [51, 25729], [54, 25869]]}, {"verse": 6, "start": 26939, "end": 33133, "text": "Bienaventurados los que tienen hambre y sed de justicia: porque ellos serán satisfechos.", "words": [[0, 26939], [16, 27926], [20, 28086], [24, 28266], [31, 28586], [38, 29126], [40, 29346], [44, 29686], [47, 29926], [57, 30974], [64, 31218], [70, 31498], [76, 32038]]}, {"verse": 7, "start": 33483, "end": 38861, "text": "Bienaventurados los misericordiosos: porque ellos alcanzarán misericordia.", "words": [[0, 33483], [16, 34428], [20, 34668], [37, 36346], [44, 36547], [50, 36787], [61, 37687]]}, {"verse": 8, "start": 39211, "end": 43766, "text": "Bienaventurados los de limpio corazón: porque ellos verán a Dios.", "words": [[0, 39719], [16, 40229], [20, 40502], [23, 40776], [30, 41049], [39, 41961], [46, 42186], [52, 42606], [58, 43146], [60, 43206]]}, {"verse": 9, "start": 44116, "end": 49547, "text": "Bienaventurados los pacificadores: porque ellos serán llamados hijos de Dios.", "words": [[0, 44601], [16, 45121], [20, 45421], [35, 46747], [42, 47067], [48, 47347], [54, 47807], [63, 48307], [69, 48647], [72, 48947]]}, {"verse": 10, "start": 49897, "end": 58445, "text": "Bienaventurados los que padecen persecución por causa de la justicia: porque de ellos es el reino de los cielos.", "words": [[0, 49897], [16, 51062], [20, 51602], [24, 51782], [32, 52382], [44, 53282], [48, 53562], [54, 53922], [57, 54182], [60, 54282], [70, 55266], [77, 55586], [80, 55846], [86, 56186], [89, 56606], [92, 56926], [98, 57446], [101, 57566], [105, 57686]]}, {"verse": 11, "start": 58795, "end": 66774, "text": "Bienaventurados sois cuando os insulten, os persigan y digan de vosotros todo mal por mi causa, mintiendo.", "words": [[0, 58795], [16, 59864], [21, 60284], [28, 60544], [31, 60884], [41, 62004], [44, 62144], [53, 62884], [55, 63144], [61, 63404], [64, 63544], [73, 64064], [78, 64284], [82, 64664], [86, 64904], [89, 65064], [96, 65924]]}, {"verse": 12, "start": 67124, "end": 76464, "text": "Gozaos y alegraos; porque vuestra recompensa es grande en los cielos: que así persiguieron a los profetas que fueron antes de vosotros.", "words": [[0, 67371], [7, 67651], [9, 68245], [19, 69058], [26, 69242], [34, 69892], [45, 70542], [48, 70702], [55, 71142], [58, 71402], [62, 71502], [70, 72590], [74, 72674], [78, 72914], [91, 73834], [93, 73934], [97, 74074], [106, 74554], [110, 74734], [117, 75014], [123, 75474], [126, 75654]]}, {"verse": 13, "start": 76814, "end": 88659, "text": "Vosotros sois la sal de la tierra: y si la sal pierde su sabor ¿con qué será salada? no vale más para nada, sino para ser echada fuera y pisoteada de los hombres.", "words": [[0, 76814], [9, 77270], [14, 77768], [17, 78008], [21, 78228], [24, 78428], [27, 78568], [35, 78948], [37, 79548], [40, 79668], [43, 79828], [47, 80202], [54, 80702], [57, 80922], [63, 81442], [68, 81780], [72, 82119], [77, 82457], [85, 83467], [88, 83595], [93, 83795], [97, 83975], [102, 84215], [108, 84475], [113, 84815], [118, 85095], [122, 85395], [129, 85945], [135, 86495], [137, 86695], [147, 87555], [150, 87735], [154, 87895]]}, {"verse": 14, "start": 89009, "end": 95982, "text": "Vosotros sois la luz del mundo: una ciudad asentada sobre un monte no se puede esconder.", "words": [[0, 89009], [9, 89615], [14, 90355], [17, 90615], [21, 90875], [25, 91175], [32, 92053], [36, 92273], [43, 92673], [52, 93713], [58, 93993], [61, 94193], [67, 94553], [70, 94773], [73, 94953], [79, 95253]]}, {"verse": 15, "start": 96332, "end": 105037, "text": "Ni se enciende una lámpara y se pone debajo de un recipiente, sino sobre el candelero, y alumbra a todos los que están en casa.", "words": [[0, 96332], [3, 96476], [6, 96636], [15, 97076], [19, 97236], [27, 97696], [29, 97816], [32, 97916], [37, 98156], [44, 98576], [47, 98756], [50, 98836], [62, 99816], [67, 100136], [73, 100476], [76, 100636], [87, 101296], [89, 101976], [97, 102616], [99, 103036], [105, 103376], [109, 103896], [113, 104036], [119, 104296], [122, 104476]]}, {"verse": 16, "start": 105387, "end": 114346, "text": "Así alumbre vuestra luz delante de los hombres, para que vean vuestras obras buenas, y glorifiquen a vuestro Padre que está en los cielos.", "words": [[0, 105387], [4, 105774], [12, 106474], [20, 106894], [24, 107234], [32, 107939], [35, 108099], [39, 108239], [48, 108699], [53, 109339], [57, 109519], [62, 109859], [71, 110279], [77, 110539], [85, 110919], [87, 111359], [99, 112159], [101, 112239], [109, 112559], [115, 113019], [119, 113119], [124, 113339], [127, 113519], [131, 113639]]}, {"verse": 17, "start": 114696, "end": 121134, "text": "No penséis que he venido para abolir la ley o los profetas: no he venido para abolir, sino a cumplir.", "words": [[0, 114696], [3, 114804], [11, 115284], [15, 115464], [18, 115544], [25, 115864], [30, 116084], [37, 116564], [40, 116684], [44, 116944], [46, 117124], [50, 117264], [60, 118246], [63, 118391], [66, 118491], [73, 118851], [78, 119091], [86, 120131], [91, 120271], [93, 120451]]}, {"verse": 18, "start": 121484, "end": 131581, "text": "Porque de cierto os digo, que hasta que pasen el cielo y la tierra, ni una jota ni un tilde perecerá de la ley, hasta que todas las cosas sean hechas.", "words": [[0, 121484], [7, 121848], [10, 121908], [17, 122668], [20, 122788], [26, 123248], [30, 123513], [36, 123733], [40, 124103], [46, 124473], [49, 124633], [55, 125013], [57, 125213], [60, 125353], [68, 125793], [71, 126373], [75, 126553], [80, 126993], [83, 127153], [86, 127503], [92, 127853], [101, 128453], [104, 128553], [107, 128693], [112, 129181], [118, 129521], [122, 129681], [128, 129961], [132, 130221], [138, 130561], [143, 130921]]}, {"verse": 19, "start": 131931, "end": 149203, "text": "De manera que cualquiera que infrinja uno de estos mandamientos muy pequeños, y así enseñe a los hombres, muy pequeño será llamado en el reino de los cielos: pero cualquiera que los haga y los enseñe, este será llamado grande en el reino de los cielos.", "words": [[0, 131931], [3, 132047], [10, 132247], [14, 132587], [25, 133187], [29, 133677], [38, 134167], [42, 134487], [45, 134707], [51, 134967], [64, 135727], [68, 136067], [78, 136887], [80, 137227], [84, 137707], [91, 138187], [93, 138267], [97, 138427], [106, 138807], [110, 139507], [118, 140207], [123, 140427], [131, 140827], [134, 141067], [137, 141227], [143, 141667], [146, 141807], [150, 141927], [158, 142902], [163, 143045], [174, 143645], [178, 143825], [182, 144005], [187, 144465], [189, 144625], [193, 144785], [201, 145745], [206, 146105], [211, 146405], [219, 146765], [226, 147245], [229, 147585], [232, 147765], [238, 148165], [241, 148305], [245, 148445]]}, {"verse": 20, "start": 149553, "end": 157874, "text": "Porque os digo, que si vuestra justicia no es mayor que la de los escribas y de los fariseos, no entraréis en el reino de los cielos.", "words": [[0, 149553], [7, 149775], [10, 149895], [16, 150135], [20, 150315], [23, 150475], [31, 150835], [40, 151435], [43, 151655], [46, 151755], [52, 152095], [56, 152335], [59, 152835], [62, 152975], [66, 153115], [75, 153735], [77, 153875], [80, 154015], [84, 154135], [94, 155095], [97, 155355], [107, 156095], [110, 156315], [113, 156495], [119, 156895], [122, 157035], [126, 157175]]}, {"verse": 21, "start": 158224, "end": 165666, "text": "Oísteis que fue dicho a los antiguos: No matarás; pero cualquiera que mate, será culpable de juicio.", "words": [[0, 158224], [8, 158950], [12, 159070], [16, 159290], [22, 159610], [24, 159770], [28, 159870], [38, 161040], [41, 161246], [50, 162304], [55, 162448], [66, 163048], [70, 163208], [76, 163568], [81, 164108], [90, 164788], [93, 164988]]}, {"verse": 22, "start": 166016, "end": 182945, "text": "Pero yo os digo que cualquiera que se enoje sin causa con su hermano, será culpable de juicio; y cualquiera que le diga a su hermano: Necio, será culpable ante el concilio; y cualquiera que le diga: Insensato, quedará expuesto al infierno de fuego.", "words": [[0, 166016], [5, 166160], [8, 166420], [11, 166520], [16, 166780], [20, 166960], [31, 167480], [35, 167620], [38, 167800], [44, 168240], [48, 168440], [54, 168900], [58, 169200], [61, 169400], [70, 169820], [75, 170020], [84, 170600], [87, 170760], [95, 171657], [97, 171780], [108, 172320], [112, 172480], [115, 172620], [120, 172980], [122, 173040], [125, 173180], [134, 174067], [141, 174627], [146, 174827], [155, 175527], [160, 175927], [163, 176127], [173, 177267], [175, 177353], [186, 177833], [190, 177973], [193, 178093], [199, 178827], [210, 180110], [218, 180510], [227, 181250], [230, 181430], [239, 182150], [242, 182350]]}, {"verse": 23, "start": 183295, "end": 189171, "text": "Por tanto, si traes tu ofrenda al altar y allí te acuerdas de que tu hermano tiene algo contra ti,", "words": [[0, 183295], [4, 183417], [11, 183917], [14, 184077], [20, 184437], [23, 184557], [31, 185097], [34, 185237], [40, 185657], [42, 185977], [47, 186297], [50, 186457], [59, 186977], [62, 187137], [66, 187237], [69, 187377], [77, 187757], [83, 187957], [88, 188297], [95, 188717]]}, {"verse": 24, "start": 189521, "end": 199071, "text": "Deja allí tu ofrenda delante del altar, y vete, reconcíliate primero con tu hermano, y entonces ven y ofrece tu ofrenda.", "words": [[0, 189521], [5, 190008], [10, 190288], [13, 190508], [21, 191148], [29, 191608], [33, 191848], [40, 192148], [42, 192568], [48, 193328], [61, 194288], [69, 194708], [73, 195028], [76, 195188], [85, 195928], [87, 196108], [96, 196508], [100, 197088], [102, 197668], [109, 198128], [112, 198368]]}, {"verse": 25, "start": 199421, "end": 213939, "text": "Concíliate con tu adversario pronto, entre tanto que estás con él en el camino; porque no acontezca que el adversario te entregue al juez, y el juez te entregue al guardia, y seas echado en prisión.", "words": [[0, 199782], [11, 200182], [15, 200462], [18, 200622], [29, 201342], [37, 202322], [43, 202582], [49, 203002], [53, 203202], [59, 203442], [63, 203742], [66, 203982], [69, 204202], [72, 204342], [80, 205201], [87, 205424], [90, 205684], [100, 206464], [104, 206644], [107, 206984], [118, 207764], [121, 208051], [130, 208337], [133, 208624], [139, 209184], [141, 209684], [144, 209824], [149, 210284], [152, 210557], [161, 210831], [164, 211104], [173, 211984], [175, 212304], [180, 212544], [187, 213084], [190, 213224]]}, {"verse": 26, "start": 214289, "end": 219333, "text": "De cierto te digo, que no saldrás de allí, hasta que pagues la última moneda.", "words": [[0, 214289], [3, 214454], [10, 214754], [13, 215094], [19, 215474], [23, 215734], [26, 215894], [34, 216454], [37, 216574], [43, 216894], [49, 217434], [53, 217634], [60, 218054], [63, 218214], [70, 218554]]}, {"verse": 27, "start": 219683, "end": 223081, "text": "Oísteis que fue dicho: No adulterarás:", "words": [[0, 219683], [8, 220471], [12, 220631], [16, 220831], [23, 221667], [26, 221852]]}, {"verse": 28, "start": 223431, "end": 231075, "text": "Pero yo os digo, que cualquiera que mira a una mujer para codiciarla, ya adulteró con ella en su corazón.", "words": [[0, 223431], [5, 223573], [8, 223833], [11, 223953], [17, 224233], [21, 224488], [32, 225188], [36, 225408], [41, 225688], [43, 225988], [47, 226148], [53, 226488], [58, 227068], [70, 227648], [73, 228528], [82, 229508], [86, 229728], [91, 229988], [94, 230188], [97, 230348]]}, {"verse": 29, "start": 231425, "end": 243333, "text": "Por tanto, si tu ojo derecho te es ocasión de caer, sácalo, y échalo de ti: que mejor te es que se pierda uno de tus miembros, que no que todo tu cuerpo sea echado al infierno.", "words": [[0, 231425], [4, 231550], [11, 231990], [14, 232150], [17, 232310], [21, 232610], [29, 232970], [32, 233220], [35, 233470], [43, 233990], [46, 234110], [52, 234910], [60, 235430], [62, 235810], [69, 236150], [72, 236350], [76, 236931], [80, 237013], [86, 237333], [89, 237553], [92, 237713], [96, 237793], [99, 237973], [106, 238433], [110, 238753], [113, 238953], [117, 239133], [127, 240013], [131, 240233], [134, 240393], [138, 240553], [143, 240793], [146, 241053], [153, 241393], [157, 241833], [164, 242433], [167, 242553]]}, {"verse": 30, "start": 243683, "end": 255089, "text": "Y si tu mano derecha te es ocasión de caer, córtala, y échala de ti: que mejor te es que se pierda uno de tus miembros, que no que todo tu cuerpo sea echado al infierno.", "words": [[0, 243683], [2, 243785], [5, 243905], [8, 244065], [13, 244365], [21, 244665], [24, 244965], [27, 245185], [35, 245685], [38, 245825], [44, 246545], [53, 247125], [55, 247390], [62, 247870], [65, 248130], [69, 248687], [73, 248769], [79, 249089], [82, 249309], [85, 249469], [89, 249549], [92, 249729], [99, 250189], [103, 250509], [106, 250709], [110, 250889], [120, 251769], [124, 251989], [127, 252149], [131, 252309], [136, 252549], [139, 252809], [146, 253149], [150, 253589], [157, 254189], [160, 254309]]}, {"verse": 31, "start": 255439, "end": 261275, "text": "También fue dicho: Cualquiera que se divorcie de su mujer, déle carta de divorcio:", "words": [[0, 255439], [8, 255862], [12, 256102], [19, 256863], [30, 257387], [34, 257527], [37, 257687], [46, 258267], [49, 258427], [52, 258567], [59, 259247], [64, 259667], [70, 260067], [73, 260387]]}, {"verse": 32, "start": 261625, "end": 272945, "text": "Pero yo os digo, que el que se divorcie de su mujer, a no ser por causa de fornicación, hace que ella adultere; y el que se casa con la divorciada, comete adulterio.", "words": [[0, 261625], [5, 261789], [8, 262029], [11, 262289], [17, 262609], [21, 262894], [24, 263074], [28, 263194], [31, 263374], [40, 263954], [43, 264094], [46, 264274], [53, 264694], [55, 264974], [58, 265114], [62, 265374], [66, 265594], [72, 265894], [75, 266154], [88, 266914], [93, 267274], [97, 267514], [102, 267734], [112, 268884], [114, 269030], [117, 269150], [121, 269310], [124, 269490], [129, 269850], [133, 270190], [136, 270370], [148, 271530], [155, 272264]]}, {"verse": 33, "start": 273295, "end": 282096, "text": "Además habéis oído que fue dicho a los antiguos: No jurarás falsamente; sino que cumplirás al Señor tus juramentos.", "words": [[0, 273295], [7, 273918], [14, 274250], [19, 274590], [23, 274770], [27, 274970], [33, 275290], [35, 275430], [39, 275530], [49, 276674], [52, 276919], [60, 277539], [72, 278872], [77, 279116], [81, 279316], [91, 280156], [94, 280556], [100, 280916], [104, 281196]]}, {"verse": 34, "start": 282446, "end": 289286, "text": "Pero yo os digo: No juréis en ninguna manera: ni por el cielo, porque es el trono de Dios;", "words": [[0, 282446], [5, 282588], [8, 282868], [11, 283068], [17, 283795], [20, 283983], [27, 284483], [30, 284603], [38, 285003], [46, 285895], [49, 286023], [53, 286263], [56, 286403], [63, 287203], [70, 287583], [73, 287963], [76, 288123], [82, 288543], [85, 288703]]}, {"verse": 35, "start": 289636, "end": 297401, "text": "Ni por la tierra, porque es el estrado de sus pies; ni por Jerusalén, porque es la ciudad del gran Rey.", "words": [[0, 289636], [3, 289763], [7, 290003], [10, 290183], [18, 291043], [25, 291403], [28, 291683], [31, 291823], [39, 292363], [42, 292543], [46, 292683], [52, 293735], [55, 293825], [59, 294025], [70, 295085], [77, 295345], [80, 295605], [83, 295785], [90, 296125], [94, 296525], [99, 296805]]}, {"verse": 36, "start": 297751, "end": 302132, "text": "Ni por tu cabeza jurarás, porque no puedes hacer un cabello blanco o negro.", "words": [[0, 297796], [3, 297876], [7, 298076], [10, 298216], [17, 298516], [26, 299079], [33, 299641], [36, 299761], [43, 300041], [49, 300361], [52, 300561], [60, 300921], [67, 301421], [69, 301541]]}, {"verse": 37, "start": 302482, "end": 310322, "text": "Pero sea vuestro hablar: Sí, sí; No, no; porque lo que es más de esto, de mal procede.", "words": [[0, 302482], [5, 302646], [9, 302986], [17, 303386], [25, 304086], [29, 304469], [33, 305264], [37, 305471], [41, 307471], [48, 307621], [51, 307781], [55, 307901], [58, 308021], [62, 308161], [65, 308321], [71, 308901], [74, 309221], [78, 309481]]}, {"verse": 38, "start": 310672, "end": 315835, "text": "Oísteis que fue dicho a los antiguos: Ojo por ojo, y diente por diente.", "words": [[0, 310672], [8, 311398], [12, 311518], [16, 311738], [22, 312058], [24, 312218], [28, 312318], [38, 313489], [42, 313774], [46, 313994], [51, 314534], [53, 314694], [60, 314974], [64, 315174]]}, {"verse": 39, "start": 315835, "end": 324401, "text": "Pero yo os digo: No resistáis al mal; antes a cualquiera que te hiera en tu mejilla derecha, vuélvele también la otra;", "words": [[0, 315835], [5, 316015], [8, 316295], [11, 316495], [17, 317222], [20, 317387], [30, 318027], [33, 318247], [38, 318973], [44, 319439], [46, 319619], [57, 320179], [61, 320339], [64, 320519], [70, 320819], [73, 320919], [76, 321039], [84, 321459], [93, 322279], [102, 322979], [110, 323299], [113, 323759]]}, {"verse": 40, "start": 324751, "end": 329887, "text": "Y al que quiera ponerte a pleito y quitarte la túnica, déjale también la capa;", "words": [[0, 324751], [2, 324876], [5, 324996], [9, 325136], [16, 325456], [24, 326016], [26, 326336], [33, 326656], [35, 326796], [44, 327276], [47, 327456], [55, 328351], [62, 328731], [70, 329051], [73, 329331]]}, {"verse": 41, "start": 330237, "end": 335099, "text": "Y a cualquiera que te obligue a llevar carga por una milla, ve con él dos.", "words": [[0, 330237], [2, 330392], [4, 330472], [15, 330842], [19, 331212], [22, 331332], [30, 331832], [32, 331892], [39, 332172], [45, 332652], [49, 332972], [53, 333152], [60, 333792], [63, 333892], [67, 334152], [70, 334651]]}, {"verse": 42, "start": 335449, "end": 340649, "text": "Al que te pida, dale; y al que quiera tomar de ti prestado, no se lo rehúses.", "words": [[0, 335449], [3, 335619], [7, 335759], [10, 335939], [16, 336299], [22, 337048], [24, 337174], [27, 337274], [31, 337554], [38, 337834], [44, 338114], [47, 338354], [50, 338514], [60, 339154], [63, 339374], [66, 339574], [69, 340148]]}, {"verse": 43, "start": 340999, "end": 346455, "text": "Oísteis que fue dicho: Amarás a tu prójimo, y odiarás a tu enemigo.", "words": [[0, 340999], [8, 341788], [12, 341948], [16, 342148], [23, 342984], [30, 343470], [32, 343570], [35, 343690], [44, 344830], [46, 345030], [54, 345550], [56, 345630], [59, 345770]]}, {"verse": 44, "start": 346805, "end": 358259, "text": "Pero yo os digo: Amad a vuestros enemigos, bendecid a los que os maldicen, haced bien a los que os aborrecen, y orad por los que os maltratan y os persiguen;", "words": [[0, 346805], [5, 346948], [8, 347228], [11, 347428], [17, 348155], [22, 348556], [24, 348736], [33, 349156], [43, 350251], [52, 350811], [54, 351211], [58, 351351], [62, 351491], [65, 351591], [75, 352731], [81, 353031], [86, 353311], [88, 353651], [92, 353771], [96, 353871], [99, 354031], [110, 355151], [112, 355211], [117, 355571], [121, 355816], [125, 356016], [129, 356216], [132, 356356], [142, 357116], [144, 357316], [147, 357416]]}, {"verse": 45, "start": 358609, "end": 368272, "text": "Para que seáis hijos de vuestro Padre que está en los cielos: que hace que su sol salga sobre malos y buenos, y llueve sobre justos e injustos.", "words": [[0, 358609], [5, 358775], [9, 358935], [15, 359375], [21, 359835], [24, 360115], [32, 360475], [38, 360815], [42, 361055], [47, 361275], [50, 361455], [54, 361575], [62, 362395], [66, 362517], [71, 362737], [75, 362937], [78, 363097], [82, 363397], [88, 363917], [94, 364197], [100, 364777], [102, 364917], [110, 365337], [112, 365832], [119, 366212], [125, 366472], [132, 367332], [134, 367472]]}, {"verse": 46, "start": 368622, "end": 376328, "text": "Porque si amáis a los que os aman, ¿qué recompensa tendréis? ¿No hacen también lo mismo los publicanos?", "words": [[0, 368622], [7, 368845], [10, 369105], [16, 369625], [18, 370025], [22, 370145], [26, 370325], [29, 370505], [35, 371365], [40, 371545], [51, 372645], [61, 373749], [65, 373898], [71, 374178], [79, 374578], [82, 374798], [88, 375098], [92, 375318]]}, {"verse": 47, "start": 376678, "end": 383361, "text": "Y si saludáis solamente a vuestros hermanos, ¿qué hacéis de más? ¿no hacen también así los Gentiles?", "words": [[0, 376678], [2, 376824], [5, 376924], [14, 377644], [24, 378024], [26, 378444], [35, 378804], [45, 379504], [50, 379784], [57, 380284], [60, 380384], [65, 381089], [69, 381256], [75, 381556], [83, 382036], [87, 382356], [91, 382536]]}, {"verse": 48, "start": 383711, "end": 389189, "text": "Sed, pues, vosotros perfectos, como vuestro Padre que está en los cielos es perfecto.", "words": [[0, 383826], [5, 383976], [11, 384316], [20, 385136], [31, 386016], [36, 386416], [44, 386856], [50, 387296], [54, 387416], [59, 387596], [62, 387716], [66, 387856], [73, 388256], [76, 388376]]}]}