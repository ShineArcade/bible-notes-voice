{"book": "JHN", "chapter": 10, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 251973, "verses": [{"verse": 1, "start": 300, "end": 9063, "text": "Most assuredly, I say to you, He that enters not by the door into the sheepfold, but climbs up some other way, the same is a thief and a robber.", "words": [[0, 300], [5, 531], [16, 1191], [18, 1311], [22, 1531], [25, 1731], [30, 2331], [33, 2491], [38, 2771], [45, 3131], [49, 3411], [52, 3651], [56, 3771], [61, 4071], [66, 4331], [70, 4511], [81, 5371], [85, 5491], [92, 5831], [95, 6111], [100, 6291], [106, 6491], [111, 7091], [115, 7171], [120, 7511], [123, 7771], [125, 7891], [131, 8151], [135, 8511], [137, 8611]]}, {"verse": 2, "start": 9513, "end": 12789, "text": "But he that enters in by the door is the shepherd of the sheep.", "words": [[0, 9513], [4, 9656], [7, 9896], [12, 10116], [19, 10436], [22, 10636], [25, 10816], [29, 10956], [34, 11276], [37, 11556], [41, 11696], [50, 11976], [53, 12196], [57, 12316]]}, {"verse": 3, "start": 13239, "end": 20460, "text": "To him the porter opens; and the sheep hear his voice: and he calls his own sheep by name, and leads them out.", "words": [[0, 13239], [3, 13338], [7, 13798], [11, 13878], [18, 14118], [25, 15136], [29, 15456], [33, 15556], [39, 15816], [44, 16136], [48, 16336], [55, 17218], [59, 17352], [62, 17432], [68, 17712], [72, 17932], [76, 18112], [82, 18392], [85, 18652], [91, 19012], [95, 19512], [101, 19792], [106, 20052]]}, {"verse": 4, "start": 20910, "end": 26619, "text": "And when he puts forth his own sheep, he goes before them, and the sheep follow him: for they know his voice.", "words": [[0, 20910], [4, 21012], [9, 21132], [12, 21232], [17, 21412], [23, 21692], [27, 21912], [31, 22092], [38, 22732], [41, 22832], [46, 23052], [53, 23472], [59, 23992], [63, 24172], [67, 24272], [73, 24492], [80, 24872], [85, 25549], [89, 25630], [94, 25730], [99, 25930], [103, 26070]]}, {"verse": 5, "start": 27069, "end": 32670, "text": "And a stranger will they not follow, but will flee from him: for they know not the voice of strangers.", "words": [[0, 27069], [4, 27194], [6, 27294], [15, 27674], [20, 27934], [25, 28074], [29, 28254], [37, 29054], [41, 29314], [46, 29514], [51, 29794], [56, 30014], [61, 30656], [65, 30740], [70, 30880], [75, 31080], [79, 31280], [83, 31480], [89, 31720], [92, 31880]]}, {"verse": 6, "start": 33020, "end": 38558, "text": "This parable spoke Jesus to them: but they understood not what things they were which he spoke to them.", "words": [[0, 33020], [5, 33154], [13, 33614], [19, 33914], [25, 34234], [28, 34534], [34, 35341], [38, 35440], [43, 35620], [54, 35980], [58, 36260], [63, 36500], [70, 36820], [75, 37020], [80, 37420], [86, 37540], [89, 37680], [95, 37940], [98, 38160]]}, {"verse": 7, "start": 39008, "end": 44366, "text": "Then said Jesus to them again, Most assuredly, I say to you, I am the door of the sheep.", "words": [[0, 39008], [5, 39363], [10, 39623], [16, 39943], [19, 40223], [24, 40423], [31, 41306], [36, 41531], [47, 42151], [49, 42271], [53, 42491], [56, 42611], [61, 43051], [63, 43251], [66, 43371], [70, 43491], [75, 43731], [78, 43871], [82, 43971]]}, {"verse": 8, "start": 44816, "end": 49041, "text": "All that ever came before me are thieves and robbers: but the sheep did not hear them.", "words": [[0, 44816], [4, 44974], [9, 45134], [14, 45274], [19, 45514], [26, 45814], [29, 46034], [33, 46194], [41, 46514], [45, 46754], [54, 47640], [58, 47840], [62, 47960], [68, 48160], [72, 48340], [76, 48500], [81, 48720]]}, {"verse": 9, "start": 49491, "end": 57205, "text": "I am the door: by me if any man enter in, he shall be saved, and shall go in and out, and find pasture.", "words": [[0, 49491], [2, 49871], [5, 49971], [9, 50071], [15, 50810], [18, 50950], [21, 51210], [24, 51430], [28, 51690], [32, 52010], [38, 52350], [42, 53070], [45, 53170], [51, 53370], [54, 53490], [61, 54410], [65, 54490], [71, 54690], [74, 54910], [77, 55310], [81, 55530], [86, 56190], [90, 56250], [95, 56510]]}, {"verse": 10, "start": 57655, "end": 66521, "text": "The thief comes not, but to steal, and to kill, and to destroy: I am come that they might have life, and that they might have it more abundantly.", "words": [[0, 57655], [4, 57757], [10, 57997], [16, 58297], [21, 58797], [25, 59117], [28, 59237], [35, 59637], [39, 60097], [42, 60217], [48, 60557], [52, 60897], [55, 61017], [64, 62022], [66, 62267], [69, 62507], [74, 62807], [79, 63187], [84, 63367], [90, 63587], [95, 63807], [101, 64107], [105, 64707], [110, 64887], [115, 65047], [121, 65267], [126, 65467], [129, 65587], [134, 65787]]}, {"verse": 11, "start": 66971, "end": 70838, "text": "I am the good shepherd: the good shepherd gives his life for the sheep.", "words": [[0, 66971], [2, 67168], [5, 67428], [9, 67628], [14, 67808], [24, 68711], [28, 68808], [33, 68988], [42, 69308], [48, 69648], [52, 69848], [57, 70148], [61, 70288], [65, 70408]]}, {"verse": 12, "start": 71288, "end": 81372, "text": "But he that is a hireling, and not the shepherd, whose own the sheep are not, sees the wolf coming, and leaves the sheep, and flees: and the wolf catches them, and scatters the sheep.", "words": [[0, 71288], [4, 71410], [7, 71630], [12, 71850], [15, 71990], [17, 72070], [27, 72570], [31, 72950], [35, 73130], [39, 73290], [49, 73870], [55, 74050], [59, 74310], [63, 74470], [69, 74650], [73, 74830], [78, 75430], [83, 75690], [87, 75910], [92, 76090], [100, 76390], [104, 76770], [111, 77010], [115, 77230], [122, 77490], [126, 77770], [133, 78666], [137, 78792], [141, 78892], [146, 79132], [154, 79572], [160, 79912], [164, 80272], [173, 80792], [177, 80932]]}, {"verse": 13, "start": 81822, "end": 85891, "text": "The hireling flees, because he is a hireling, and cares not for the sheep.", "words": [[0, 81822], [4, 81929], [13, 82409], [20, 82949], [28, 83189], [31, 83449], [34, 83609], [36, 83709], [46, 84209], [50, 84509], [56, 84809], [60, 85109], [64, 85349], [68, 85469]]}, {"verse": 14, "start": 86341, "end": 90571, "text": "I am the good shepherd, and know my sheep, and am known of mine.", "words": [[0, 86341], [2, 86622], [5, 86842], [9, 86982], [14, 87182], [24, 88122], [28, 88222], [33, 88422], [36, 88622], [43, 89382], [47, 89502], [50, 89622], [56, 89822], [59, 90022]]}, {"verse": 15, "start": 91021, "end": 96052, "text": "As the Father knows me, even so know I the Father: and I lay down my life for the sheep.", "words": [[0, 91021], [3, 91165], [7, 91305], [14, 91565], [20, 91845], [24, 92365], [29, 92525], [32, 92825], [37, 93025], [39, 93185], [43, 93305], [51, 94083], [55, 94263], [57, 94383], [61, 94563], [66, 94803], [69, 95043], [74, 95343], [78, 95503], [82, 95603]]}, {"verse": 16, "start": 96502, "end": 106113, "text": "And other sheep I have, which are not of this fold: them also I must bring, and they shall hear my voice; and there shall be one fold, and one shepherd.", "words": [[0, 96502], [4, 96667], [10, 96887], [16, 97167], [18, 97427], [24, 98107], [30, 98227], [34, 98347], [38, 98527], [41, 98687], [46, 98867], [52, 99647], [57, 99809], [62, 100129], [64, 100329], [69, 100509], [76, 101129], [80, 101209], [85, 101329], [91, 101489], [96, 101689], [99, 101889], [106, 102783], [110, 102903], [116, 103043], [122, 103223], [125, 103383], [129, 103663], [135, 104003], [139, 104343], [143, 104523]]}, {"verse": 17, "start": 106563, "end": 111415, "text": "Therefore does my Father love me, because I lay down my life, that I might take it again.", "words": [[0, 106563], [10, 106843], [15, 107103], [18, 107303], [25, 107583], [30, 107903], [34, 108263], [42, 108643], [44, 108823], [48, 109023], [53, 109263], [56, 109503], [62, 110083], [67, 110323], [69, 110423], [75, 110543], [80, 110803], [83, 110923]]}, {"verse": 18, "start": 111865, "end": 122302, "text": "No man takes it from me, but I lay it down of myself. I have power to lay it down, and I have power to take it again. This commandment have I received of my Father.", "words": [[0, 111865], [3, 112045], [7, 112305], [13, 112585], [16, 112765], [21, 112945], [25, 113305], [29, 113565], [31, 113665], [35, 113865], [38, 113945], [43, 114165], [46, 114325], [54, 115257], [56, 115436], [61, 115576], [67, 115916], [70, 116116], [74, 116336], [77, 116456], [83, 116816], [87, 117396], [89, 117576], [94, 117756], [100, 118136], [103, 118356], [108, 118616], [111, 118716], [118, 119581], [123, 119783], [135, 120443], [140, 120623], [142, 120763], [151, 121223], [154, 121523], [157, 121703]]}, {"verse": 19, "start": 122652, "end": 126143, "text": "¶ There was a division therefore again among the Jews for these sayings.", "words": [[2, 122652], [8, 122798], [12, 122998], [14, 123098], [23, 123438], [33, 123818], [39, 124198], [45, 124458], [49, 124658], [54, 124958], [58, 125218], [64, 125418]]}, {"verse": 20, "start": 126593, "end": 131120, "text": "And many of them said, He has a demon, and is mad; why do you hear him?", "words": [[0, 126593], [4, 126701], [9, 126901], [12, 127081], [17, 127221], [23, 127971], [26, 128103], [30, 128423], [32, 128603], [39, 128903], [43, 129283], [46, 129423], [51, 130228], [55, 130367], [58, 130467], [62, 130567], [67, 130787]]}, {"verse": 21, "start": 131470, "end": 137151, "text": "Others said, These are not the words of him that has a demon. Can a demon open the eyes of the blind?", "words": [[0, 131470], [7, 131699], [13, 132497], [19, 132660], [23, 132840], [27, 133040], [31, 133260], [37, 133500], [40, 133700], [44, 133880], [49, 134100], [53, 134340], [55, 134440], [62, 135226], [66, 135371], [68, 135471], [74, 135711], [79, 136011], [83, 136191], [88, 136411], [91, 136551], [95, 136651]]}, {"verse": 22, "start": 137501, "end": 141285, "text": "¶ And it was at Jerusalem the feast of the dedication, and it was winter.", "words": [[2, 137501], [6, 137620], [9, 137700], [13, 137840], [16, 137980], [26, 138480], [30, 138860], [36, 139160], [39, 139360], [43, 139460], [55, 140040], [59, 140460], [62, 140560], [66, 140700]]}, {"verse": 23, "start": 141735, "end": 144808, "text": "And Jesus walked in the temple in Solomon’s porch.", "words": [[0, 141735], [4, 141857], [10, 142157], [17, 142597], [20, 142817], [24, 142917], [31, 143257], [34, 143477], [44, 144097]]}, {"verse": 24, "start": 145258, "end": 151764, "text": "Then came the Jews round about him, and said to him, How long do you make us to doubt? If you be the Christ, tell us plainly.", "words": [[0, 145258], [5, 145404], [10, 145684], [14, 145864], [19, 146144], [25, 146484], [31, 146804], [36, 147044], [40, 147244], [45, 147424], [48, 147624], [53, 148192], [57, 148343], [62, 148543], [65, 148743], [69, 148803], [74, 148983], [77, 149163], [80, 149283], [87, 150043], [90, 150180], [94, 150260], [97, 150380], [101, 150500], [109, 150920], [114, 151120], [117, 151260]]}, {"verse": 25, "start": 152114, "end": 159342, "text": "Jesus answered them, I told you, and you believed not: the works that I do in my Father’s name, they bear witness of me.", "words": [[0, 152114], [6, 152390], [15, 152830], [21, 153490], [23, 153656], [28, 153936], [33, 154236], [37, 154516], [41, 154676], [50, 155016], [55, 155915], [59, 155999], [65, 156239], [70, 156439], [72, 156579], [75, 156759], [78, 156879], [81, 157039], [90, 157499], [96, 158079], [101, 158239], [106, 158459], [114, 158739], [117, 159039]]}, {"verse": 26, "start": 159792, "end": 163478, "text": "But you believe not, because you are not of my sheep, as I said to you.", "words": [[0, 159792], [4, 159877], [8, 160057], [16, 160357], [21, 160697], [29, 161237], [33, 161477], [37, 161577], [41, 161717], [44, 161877], [47, 162037], [54, 162497], [57, 162597], [59, 162717], [64, 162917], [67, 163097]]}, {"verse": 27, "start": 163928, "end": 167134, "text": "My sheep hear my voice, and I know them, and they follow me:", "words": [[0, 163928], [3, 164050], [9, 164290], [14, 164550], [17, 164730], [24, 165330], [28, 165430], [30, 165550], [35, 165750], [41, 166230], [45, 166330], [50, 166430], [57, 166750]]}, {"verse": 28, "start": 167584, "end": 173818, "text": "And I give to them eternal life; and they shall never perish, neither shall any man pluck them out of my hand.", "words": [[0, 167584], [4, 167718], [6, 167858], [11, 168098], [14, 168278], [19, 168478], [27, 168938], [33, 169757], [37, 169864], [42, 169984], [48, 170184], [54, 170544], [62, 171384], [70, 171604], [76, 171864], [80, 172104], [84, 172404], [90, 172664], [95, 172884], [99, 173044], [102, 173144], [105, 173324]]}, {"verse": 29, "start": 174268, "end": 180177, "text": "My Father, which gave them me, is greater than all; and no man is able to pluck them out of my Father’s hand.", "words": [[0, 174268], [3, 174390], [11, 174830], [17, 174930], [22, 175170], [27, 175370], [31, 175930], [34, 176030], [42, 176290], [47, 176550], [52, 177194], [56, 177318], [59, 177538], [63, 177838], [66, 178058], [71, 178238], [74, 178378], [80, 178598], [85, 178838], [89, 178998], [92, 179098], [95, 179258], [104, 179718]]}, {"verse": 30, "start": 180627, "end": 182383, "text": "I and my Father are one.", "words": [[0, 180627], [2, 180905], [6, 181125], [9, 181265], [16, 181605], [20, 181885]]}, {"verse": 31, "start": 182733, "end": 185590, "text": "Then the Jews took up stones again to stone him.", "words": [[0, 182733], [5, 182964], [9, 183124], [14, 183424], [19, 183744], [22, 183924], [29, 184244], [35, 184704], [38, 184904], [44, 185164]]}, {"verse": 32, "start": 186040, "end": 192361, "text": "Jesus answered them, Many good works have I showed you from my Father; for which of those works do you stone me?", "words": [[0, 186040], [6, 186363], [15, 186823], [21, 187496], [26, 187723], [31, 187983], [37, 188343], [42, 188603], [44, 188743], [51, 189003], [55, 189183], [60, 189363], [63, 189543], [71, 190384], [75, 190466], [81, 190666], [84, 190806], [90, 191006], [96, 191306], [99, 191566], [103, 191686], [109, 191966]]}, {"verse": 33, "start": 192711, "end": 201052, "text": "The Jews answered him, saying, For a good work we stone you not; but for blasphemy; and because that you, being a man, make yourself God.", "words": [[0, 192711], [4, 192873], [9, 193093], [18, 193513], [23, 193893], [31, 194754], [35, 194858], [37, 194978], [42, 195098], [47, 195538], [50, 195638], [56, 195898], [60, 196078], [65, 196898], [69, 197057], [73, 197257], [84, 198220], [88, 198331], [96, 198571], [101, 198851], [106, 199071], [112, 199271], [114, 199451], [119, 199671], [124, 200131], [133, 200471]]}, {"verse": 34, "start": 201402, "end": 205958, "text": "Jesus answered them, Is it not written in your law, I said, You are gods?", "words": [[0, 201402], [6, 201678], [15, 202118], [21, 202778], [24, 202915], [27, 203015], [31, 203195], [39, 203515], [42, 203715], [47, 203835], [52, 204355], [54, 204495], [60, 204995], [64, 205235], [68, 205335]]}, {"verse": 35, "start": 206408, "end": 210625, "text": "If he called them gods to whom the word of God came and the scripture can not be broken", "words": [[0, 206408], [3, 206534], [6, 206634], [13, 206874], [18, 207094], [23, 207414], [26, 207634], [31, 207814], [35, 207954], [40, 208174], [43, 208274], [47, 208514], [52, 208874], [56, 209094], [60, 209214], [70, 209421], [74, 209627], [78, 209834], [81, 210054]]}, {"verse": 36, "start": 211075, "end": 219133, "text": "Say you of him, whom the Father has sanctified, and sent into the world, You blaspheme; because I said, I am the Son of God?", "words": [[0, 211075], [4, 211320], [8, 211560], [11, 211740], [16, 211980], [21, 212460], [25, 212600], [32, 212880], [36, 213060], [48, 213780], [52, 214220], [57, 214460], [62, 214700], [66, 214840], [73, 215600], [77, 215700], [88, 216851], [96, 217035], [98, 217275], [104, 217695], [106, 218075], [109, 218215], [113, 218335], [117, 218515], [120, 218635]]}, {"verse": 37, "start": 219583, "end": 222545, "text": "If I do not the works of my Father, believe me not.", "words": [[0, 219583], [3, 219726], [5, 219886], [8, 220046], [12, 220206], [16, 220386], [22, 220626], [25, 220806], [28, 220966], [36, 221546], [44, 221766], [47, 222046]]}, {"verse": 38, "start": 222995, "end": 232006, "text": "But if I do, though you believe not me, believe the works: that you may know, and believe, that the Father is in me, and I in him.", "words": [[0, 222995], [4, 223097], [7, 223237], [9, 223377], [13, 223977], [20, 224177], [24, 224397], [32, 224677], [36, 224937], [40, 225557], [48, 225877], [52, 226117], [59, 226999], [64, 227116], [68, 227276], [72, 227456], [78, 227816], [82, 228276], [91, 228716], [96, 229296], [100, 229436], [107, 229736], [110, 230096], [113, 230256], [117, 230476], [121, 230856], [123, 231276], [126, 231576]]}, {"verse": 39, "start": 232356, "end": 236187, "text": "Therefore they sought again to take him: but he escaped out of their hand,", "words": [[0, 232356], [10, 232716], [15, 232936], [22, 233216], [28, 233556], [31, 233736], [36, 233996], [41, 234570], [45, 234674], [48, 234794], [56, 235194], [60, 235434], [63, 235574], [69, 235714]]}, {"verse": 40, "start": 236637, "end": 242225, "text": "And went away again beyond Jordan into the place where John at first baptized; and there he stayed.", "words": [[0, 236637], [4, 236780], [9, 236940], [14, 237240], [20, 237560], [27, 237940], [34, 238400], [39, 238700], [43, 238860], [49, 239120], [55, 239340], [60, 239660], [63, 239840], [69, 240020], [79, 241235], [83, 241362], [89, 241522], [92, 241662]]}, {"verse": 41, "start": 242675, "end": 249437, "text": "And many resorted to him, and said, John did no miracle: but all things that John spoke of this man were true.", "words": [[0, 242675], [4, 242830], [9, 243030], [18, 243550], [21, 243770], [26, 244050], [30, 244530], [36, 245310], [41, 245507], [45, 245727], [48, 245947], [57, 246859], [61, 246964], [65, 247184], [72, 247484], [77, 247704], [82, 247924], [88, 248224], [91, 248444], [96, 248624], [100, 248864], [105, 249044]]}, {"verse": 42, "start": 249787, "end": 251573, "text": "And many believed on him there.", "words": [[0, 249787], [4, 249931], [9, 250151], [18, 250511], [21, 250811], [25, 250971]]}]}