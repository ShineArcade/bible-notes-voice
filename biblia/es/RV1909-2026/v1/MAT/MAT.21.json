{"book": "MAT", "chapter": 21, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 395910, "verses": [{"verse": 1, "start": 300, "end": 9267, "text": "Y como se acercaron a Jerusalén, y vinieron a Betfagé, al monte de los Olivos, entonces Jesús envió dos discípulos,", "words": [[0, 300], [2, 401], [7, 601], [10, 801], [20, 1481], [22, 1601], [33, 2461], [35, 2721], [44, 3241], [46, 3791], [55, 4341], [58, 4721], [64, 5021], [67, 5221], [71, 5361], [79, 6221], [88, 6661], [94, 7281], [100, 8041], [104, 8341]]}, {"verse": 2, "start": 9617, "end": 20655, "text": "Diciéndoles: Id a la aldea que está delante de vosotros, y luego hallaréis una asna atada, y un pollino con ella: desatadla, y traédmelos.", "words": [[0, 9617], [13, 10903], [16, 11023], [18, 11283], [21, 11403], [27, 11843], [31, 12003], [36, 12183], [44, 12603], [47, 12763], [57, 13303], [59, 13763], [65, 14003], [75, 14723], [79, 15023], [84, 15643], [91, 16283], [93, 16703], [96, 16843], [104, 17283], [108, 17503], [114, 19107], [125, 19377], [127, 20039]]}, {"verse": 3, "start": 21005, "end": 27113, "text": "Y si alguno os dice algo, decid: El Señor los necesita. Y luego los dejará.", "words": [[0, 21005], [2, 21130], [5, 21250], [12, 21730], [15, 21850], [20, 22110], [26, 22850], [33, 23702], [36, 23846], [42, 24166], [46, 24586], [56, 25881], [58, 26004], [64, 26204], [68, 26464]]}, {"verse": 4, "start": 27463, "end": 32984, "text": "Y todo esto fue hecho, para que se cumpliese lo que fue dicho por el profeta, que dijo:", "words": [[0, 27463], [2, 27724], [7, 27964], [12, 28304], [16, 28584], [23, 28964], [28, 29279], [32, 29439], [35, 29599], [45, 30259], [48, 30479], [52, 30599], [56, 30799], [62, 31119], [66, 31399], [69, 31539], [78, 32299], [82, 32479]]}, {"verse": 5, "start": 33334, "end": 43518, "text": "Decid a la hija de Sion: He aquí, tu Rey viene a ti, manso, y sentado sobre una asna, y sobre un pollino, hijo de bestia de carga.", "words": [[0, 33334], [6, 34138], [8, 34338], [11, 34438], [16, 34818], [19, 34918], [25, 35795], [28, 35885], [34, 36105], [37, 36325], [41, 36705], [47, 36885], [49, 37105], [53, 37645], [60, 38245], [62, 38485], [70, 39045], [76, 39325], [80, 39625], [86, 40125], [88, 40525], [94, 40765], [97, 40965], [106, 42005], [111, 42145], [114, 42345], [121, 42745], [124, 42885]]}, {"verse": 6, "start": 43868, "end": 48093, "text": "Y los discípulos fueron, e hicieron como Jesús les mandó;", "words": [[0, 43868], [2, 43973], [6, 44093], [17, 44833], [25, 45273], [27, 45853], [36, 46373], [41, 46633], [47, 47013], [51, 47573]]}, {"verse": 7, "start": 48443, "end": 55075, "text": "Y trajeron el asna y el pollino, y pusieron sobre ellos sus mantos; y se sentó sobre ellos.", "words": [[0, 48443], [2, 48567], [11, 49187], [14, 49407], [19, 49847], [21, 50067], [24, 50227], [33, 50847], [35, 51032], [44, 51512], [50, 51832], [56, 52152], [60, 52705], [68, 53420], [70, 53545], [73, 53665], [79, 54085], [85, 54365]]}, {"verse": 8, "start": 55425, "end": 64813, "text": "Y la multitud, que era muy numerosa, tendía sus mantos en el camino: y otros cortaban ramas de los árboles, y los tendían por el camino.", "words": [[0, 55425], [2, 55511], [5, 55631], [15, 56171], [19, 56351], [23, 56511], [27, 56691], [37, 57331], [44, 58151], [48, 58351], [55, 58931], [58, 59091], [61, 59211], [69, 60103], [71, 60279], [77, 60499], [86, 61139], [92, 61779], [95, 61959], [99, 62079], [108, 62659], [110, 63079], [114, 63219], [122, 63779], [126, 64019], [129, 64119]]}, {"verse": 9, "start": 65163, "end": 75611, "text": "Y la gente que iba delante y la que iba detrás aclamaba diciendo: ¡Hosanna al Hijo de David! ¡Bendito el que viene en el nombre del Señor! ¡Hosanna en las alturas!", "words": [[0, 65163], [2, 65251], [5, 65371], [11, 65631], [15, 65851], [19, 66221], [27, 66591], [29, 67071], [32, 67191], [36, 67331], [40, 67571], [47, 68191], [56, 68866], [66, 69890], [75, 70160], [78, 70480], [83, 70700], [86, 70820], [93, 71470], [102, 71968], [105, 72068], [109, 72188], [115, 72508], [118, 72708], [121, 72828], [128, 73108], [132, 73308], [139, 74283], [148, 74533], [151, 74713], [155, 74833]]}, {"verse": 10, "start": 75891, "end": 82542, "text": "Y entrando él en Jerusalén, toda la ciudad se alborotó, diciendo: ¿Quién es este?", "words": [[0, 75891], [2, 76048], [11, 76588], [14, 76928], [17, 77128], [28, 78368], [33, 78568], [36, 78868], [43, 79228], [46, 79648], [56, 80768], [66, 81730], [73, 81971], [76, 82091]]}, {"verse": 11, "start": 82822, "end": 87577, "text": "Y la gente decía: Este es Jesús, el profeta, de Nazaret de Galilea.", "words": [[0, 82822], [2, 82924], [5, 83024], [11, 83384], [18, 84457], [23, 84698], [26, 84878], [33, 85238], [36, 85458], [45, 86278], [48, 86358], [56, 86798], [59, 86978]]}, {"verse": 12, "start": 87857, "end": 99712, "text": "Y entró Jesús en el templo de Dios, y echó fuera todos los que vendían y compraban en el templo, y volcó las mesas de los cambistas, y las sillas de los que vendían palomas;", "words": [[0, 87857], [2, 88001], [8, 88401], [14, 88741], [17, 89041], [20, 89181], [27, 89641], [30, 89721], [36, 90021], [38, 90291], [43, 90561], [49, 90881], [55, 91301], [59, 91621], [63, 91801], [71, 92361], [73, 92481], [83, 93221], [86, 93361], [89, 93541], [97, 94341], [99, 94481], [105, 94801], [109, 95121], [115, 95441], [118, 95661], [122, 96211], [133, 96938], [135, 97042], [139, 97202], [146, 97722], [149, 98122], [153, 98222], [157, 98362], [165, 98782]]}, {"verse": 13, "start": 100062, "end": 107967, "text": "Y les dice: Escrito está: Mi casa, casa de oración será llamada; pero vosotros cueva de ladrones la habéis hecho.", "words": [[0, 100062], [2, 100188], [6, 100328], [12, 101138], [20, 101738], [26, 102520], [29, 102685], [35, 103245], [40, 103445], [43, 103665], [51, 104137], [56, 104609], [65, 105243], [70, 105503], [79, 105973], [85, 106443], [88, 106563], [97, 106883], [100, 107203], [107, 107503]]}, {"verse": 14, "start": 108317, "end": 112772, "text": "Entonces vinieron a él ciegos y cojos en el templo, y los sanó.", "words": [[0, 108317], [9, 108754], [18, 109414], [20, 109574], [23, 109794], [30, 110354], [32, 110494], [38, 110874], [41, 111074], [44, 111214], [52, 111974], [54, 112114], [58, 112274]]}, {"verse": 15, "start": 113122, "end": 124721, "text": "Pero los príncipes de los sacerdotes y los escribas, viendo las maravillas que hacía, y a los muchachos aclamando en el templo y diciendo: ¡Hosanna al Hijo de David! se indignaron,", "words": [[0, 113122], [5, 113286], [9, 113466], [19, 114166], [22, 114286], [26, 114426], [37, 115206], [39, 115386], [43, 115526], [53, 116166], [60, 116659], [64, 117153], [75, 117646], [79, 117826], [86, 118246], [88, 118451], [90, 118531], [94, 118631], [104, 119191], [114, 119771], [117, 119891], [120, 120031], [127, 120591], [129, 120631], [139, 121858], [148, 122128], [151, 122448], [156, 122668], [159, 122788], [166, 123498], [169, 123715]]}, {"verse": 16, "start": 125071, "end": 136133, "text": "Y le dijeron: ¿Oyes lo que estos dicen? Y Jesús les dice: Sí: ¿nunca leísteis: De la boca de los niños y de los niños de pecho perfeccionaste la alabanza?", "words": [[0, 125071], [2, 125253], [5, 125333], [14, 126474], [20, 126757], [23, 126937], [27, 127097], [33, 127277], [40, 128243], [42, 128389], [48, 128749], [52, 129209], [58, 130042], [62, 130400], [69, 130824], [79, 131916], [82, 132011], [85, 132111], [90, 132331], [93, 132491], [97, 132631], [103, 132931], [105, 133171], [108, 133251], [112, 133371], [118, 133611], [121, 133811], [127, 134231], [142, 135131], [145, 135351]]}, {"verse": 17, "start": 136483, "end": 141501, "text": "Y dejándolos, se salió fuera de la ciudad, a Betania; y pasó allí la noche.", "words": [[0, 136483], [2, 136765], [14, 137465], [17, 137705], [23, 138045], [29, 138285], [32, 138485], [35, 138585], [43, 138905], [45, 139245], [54, 140064], [56, 140165], [61, 140475], [66, 140785], [69, 140965]]}, {"verse": 18, "start": 141851, "end": 144915, "text": "Y por la mañana volviendo a la ciudad, tuvo hambre.", "words": [[0, 141851], [2, 141978], [6, 142158], [9, 142318], [16, 142638], [26, 143298], [28, 143418], [31, 143478], [39, 143818], [44, 144198]]}, {"verse": 19, "start": 145265, "end": 158075, "text": "Y viendo una higuera cerca del camino, vino a ella, y no halló nada en ella, sino hojas solamente; y le dijo: Nunca más para siempre nazca de ti fruto. Y luego se secó la higuera.", "words": [[0, 145265], [2, 145389], [9, 145749], [13, 146149], [21, 146769], [27, 147109], [31, 147429], [39, 147909], [44, 148489], [46, 148689], [52, 148969], [54, 149189], [57, 149389], [63, 149709], [68, 149929], [71, 150189], [77, 150489], [82, 150829], [88, 151429], [99, 152659], [101, 152787], [104, 152887], [110, 153580], [116, 153940], [120, 154080], [125, 154300], [133, 154860], [139, 155165], [142, 155470], [145, 155775], [152, 156300], [154, 156398], [160, 156598], [163, 156838], [168, 157218], [171, 157358]]}, {"verse": 20, "start": 158425, "end": 163899, "text": "Y viendo esto los discípulos, maravillados decían: ¿Cómo se secó luego la higuera?", "words": [[0, 158425], [2, 158551], [9, 158851], [14, 159191], [18, 159391], [30, 160171], [43, 161271], [51, 162301], [57, 162485], [60, 162665], [65, 163045], [71, 163165], [74, 163405]]}, {"verse": 21, "start": 164179, "end": 178942, "text": "Y respondiendo Jesús les dijo: De cierto os digo, que si tenéis fe, y no dudáis, no sólo haréis esto de la higuera: sino que si a este monte decís: Quítate y échate en el mar, será hecho.", "words": [[0, 164271], [2, 164401], [15, 165381], [21, 165641], [25, 165881], [31, 166717], [34, 166882], [41, 167242], [44, 167702], [50, 168442], [54, 168762], [57, 168922], [64, 169382], [68, 169742], [70, 170102], [73, 170242], [81, 171362], [84, 171542], [89, 171882], [96, 172262], [101, 172542], [104, 172722], [107, 173147], [116, 173751], [121, 173971], [125, 174151], [128, 174331], [130, 174451], [135, 174651], [141, 174991], [148, 176117], [156, 176519], [158, 176799], [165, 177199], [168, 177339], [171, 177479], [176, 178039], [181, 178299]]}, {"verse": 22, "start": 179292, "end": 183788, "text": "Y todo lo que pidáis en oración, creyendo, lo recibiréis.", "words": [[0, 179292], [2, 179419], [7, 179719], [10, 179939], [14, 180239], [21, 180539], [24, 180719], [33, 181579], [43, 182299], [46, 182739]]}, {"verse": 23, "start": 184138, "end": 197675, "text": "Y cuando vino al templo, se llegaron a él cuando estaba enseñando, los príncipes de los sacerdotes y los ancianos del pueblo, diciendo: ¿Con qué autoridad haces esto? ¿y quién te dio esta autoridad?", "words": [[0, 184138], [2, 184243], [9, 184463], [14, 184743], [17, 184963], [25, 185863], [28, 186023], [37, 186503], [39, 186703], [42, 186903], [49, 187143], [56, 187663], [67, 188543], [71, 189023], [81, 189983], [84, 190123], [88, 190243], [99, 191163], [101, 191323], [105, 191483], [114, 192023], [118, 192143], [126, 192563], [136, 193977], [141, 194097], [145, 194337], [155, 194877], [161, 195257], [167, 196003], [170, 196131], [176, 196311], [179, 196491], [183, 196731], [188, 196991]]}, {"verse": 24, "start": 197955, "end": 207551, "text": "Y respondiendo Jesús, les dijo: Yo también os haré una pregunta, la cual si me decís, también yo os diré con qué autoridad hago esto.", "words": [[0, 197955], [2, 198077], [15, 198857], [22, 199217], [26, 199577], [32, 200409], [35, 200616], [43, 200936], [46, 201256], [51, 201556], [55, 201676], [65, 202696], [68, 202776], [73, 202936], [76, 203156], [79, 203296], [86, 204336], [94, 204636], [97, 204996], [100, 205216], [105, 205596], [109, 205776], [113, 206036], [123, 206736], [128, 206996]]}, {"verse": 25, "start": 207901, "end": 220557, "text": "El bautismo de Juan, ¿de dónde era? ¿del cielo, o de los hombres? Ellos entonces pensaron entre sí, diciendo: Si decimos, del cielo, nos dirá: ¿Por qué pues no le creísteis?", "words": [[0, 207901], [3, 208267], [12, 208807], [15, 208987], [21, 209527], [25, 209747], [31, 209987], [36, 210778], [41, 211024], [48, 211544], [50, 212024], [53, 212124], [57, 212244], [66, 213286], [72, 213611], [81, 214051], [90, 214951], [96, 215271], [100, 216011], [110, 216955], [113, 217068], [122, 217548], [126, 217728], [133, 218028], [137, 218268], [143, 218905], [148, 219047], [152, 219247], [157, 219467], [160, 219627], [163, 219747]]}, {"verse": 26, "start": 220907, "end": 226266, "text": "Y si decimos, de los hombres, tememos al pueblo; porque todos tienen a Juan por profeta.", "words": [[0, 220907], [2, 221030], [5, 221130], [14, 221610], [17, 221770], [21, 221910], [30, 222210], [38, 222810], [41, 223010], [49, 223880], [56, 224200], [62, 224560], [69, 225000], [71, 225160], [76, 225400], [80, 225620]]}, {"verse": 27, "start": 226546, "end": 234353, "text": "Y respondiendo a Jesús, dijeron: No sabemos. Y él también les dijo: Ni yo os digo con qué autoridad hago esto.", "words": [[0, 226546], [2, 226942], [15, 227372], [17, 227532], [24, 228272], [33, 229167], [36, 229324], [45, 230351], [47, 230515], [50, 230655], [58, 230935], [62, 231155], [68, 231838], [71, 232004], [74, 232244], [77, 232344], [82, 232544], [86, 232804], [90, 232984], [100, 233544], [105, 233844]]}, {"verse": 28, "start": 234703, "end": 242788, "text": "Pero, ¿qué os parece? Un hombre tenía dos hijos, y llegando al primero, le dijo: Hijo, ve hoy a trabajar en mi viña.", "words": [[0, 234703], [6, 234887], [11, 235127], [14, 235267], [22, 236096], [25, 236243], [32, 236483], [38, 236903], [42, 237263], [49, 237703], [51, 238243], [60, 238703], [63, 238823], [72, 239163], [75, 239403], [81, 240091], [87, 240494], [90, 240854], [94, 241234], [96, 241374], [105, 241814], [108, 242034], [111, 242194]]}, {"verse": 29, "start": 243138, "end": 247809, "text": "Y respondiendo él, dijo: No quiero; pero después, arrepentido, fue.", "words": [[0, 243138], [2, 243244], [15, 244004], [19, 244104], [25, 244856], [28, 245160], [36, 245946], [41, 246091], [50, 246451], [63, 247371]]}, {"verse": 30, "start": 248159, "end": 255991, "text": "Y llegando al otro, le dijo de la misma manera; y respondiendo él, dijo: Yo, señor, voy. Y no fue.", "words": [[0, 248159], [2, 248256], [11, 248696], [14, 248836], [20, 249476], [23, 249676], [28, 249976], [31, 250116], [34, 250236], [40, 250456], [48, 251555], [50, 251855], [63, 252575], [67, 252955], [73, 254194], [77, 254384], [84, 254804], [89, 255393], [91, 255517], [94, 255617]]}, {"verse": 31, "start": 256341, "end": 268283, "text": "¿Cuál de los dos hizo la voluntad de su padre? Dicen ellos: El primero. Les dice Jesús: De cierto os digo, que los publicanos y las prostitutas os van delante al reino de Dios.", "words": [[0, 256341], [6, 256705], [9, 256845], [13, 257005], [17, 257265], [22, 257705], [25, 257945], [34, 258565], [37, 258685], [40, 258845], [47, 259654], [53, 259962], [60, 260908], [63, 260988], [72, 261922], [76, 262032], [81, 262312], [88, 263162], [91, 263327], [98, 263647], [101, 264027], [107, 264407], [111, 264587], [115, 264747], [126, 265427], [128, 265587], [132, 265707], [144, 266407], [147, 266507], [151, 266707], [159, 267147], [162, 267287], [168, 267627], [171, 267787]]}, {"verse": 32, "start": 268633, "end": 282415, "text": "Porque vino a vosotros Juan en camino de justicia, y no le creísteis; y los publicanos y las prostitutas le creyeron; y vosotros, viendo esto, no os arrepentisteis después para creerle.", "words": [[0, 268633], [7, 269007], [12, 269287], [14, 269447], [23, 269887], [28, 270287], [31, 270767], [38, 271087], [41, 271327], [51, 272047], [53, 272487], [56, 272627], [59, 272747], [70, 273968], [72, 274113], [76, 274213], [87, 274933], [89, 275093], [93, 275233], [105, 276033], [108, 276193], [118, 277212], [120, 277322], [130, 278042], [137, 278322], [143, 279222], [146, 279422], [149, 279642], [164, 280842], [172, 281222], [177, 281582]]}, {"verse": 33, "start": 282765, "end": 299852, "text": "Oíd otra parábola: fue un hombre, padre de familia, el cual plantó una viña; y la rodeó con una cerca, y cavó en ella un lagar para prensar uvas, y edificó una torre, y la arrendó a labradores, y se fue lejos.", "words": [[0, 282830], [4, 283347], [9, 283727], [19, 284856], [23, 285020], [26, 285220], [34, 285980], [40, 286300], [43, 286520], [52, 287220], [55, 287360], [60, 287580], [67, 288380], [71, 288620], [77, 289606], [79, 289748], [82, 290058], [88, 290368], [92, 290568], [96, 290748], [103, 291188], [105, 291661], [110, 292133], [113, 292233], [118, 292413], [121, 292613], [127, 293073], [132, 293313], [140, 293933], [146, 294473], [148, 295273], [156, 295853], [160, 296013], [167, 296613], [169, 296973], [172, 297133], [180, 297833], [182, 297913], [194, 298553], [196, 298793], [199, 298933], [203, 299133]]}, {"verse": 34, "start": 300202, "end": 308029, "text": "Y cuando se acercó el tiempo de los frutos, envió sus siervos a los labradores, para que recibiesen sus frutos.", "words": [[0, 300202], [2, 300311], [9, 300551], [12, 300811], [19, 301351], [22, 301471], [29, 301791], [32, 301991], [36, 302131], [44, 303071], [50, 303611], [54, 303811], [62, 304371], [64, 304551], [68, 304691], [80, 305491], [85, 306171], [89, 306331], [100, 307071], [104, 307331]]}, {"verse": 35, "start": 308379, "end": 315485, "text": "Pero los labradores, tomando a los siervos, al uno hirieron, y al otro mataron, y al otro apedrearon.", "words": [[0, 308379], [5, 308526], [9, 308686], [21, 309326], [29, 309866], [31, 309946], [35, 310066], [44, 310566], [47, 310826], [51, 311482], [61, 312138], [63, 312241], [66, 312361], [71, 312581], [80, 313741], [82, 313781], [85, 313941], [90, 314221]]}, {"verse": 36, "start": 315835, "end": 321918, "text": "Envió de nuevo otros siervos, más que los primeros; e hicieron con ellos de la misma manera.", "words": [[0, 315835], [6, 316299], [9, 316419], [15, 316679], [21, 317119], [30, 317759], [34, 318079], [38, 318279], [42, 318419], [52, 319385], [54, 319520], [63, 320100], [67, 320340], [73, 320640], [76, 320820], [79, 320940], [85, 321140]]}, {"verse": 37, "start": 322268, "end": 327571, "text": "Y finalmente les envió su hijo, diciendo: Tendrán respeto a mi hijo.", "words": [[0, 322268], [2, 322522], [13, 322882], [17, 323382], [23, 323842], [26, 324062], [32, 324362], [42, 325442], [50, 326091], [58, 326791], [60, 326931], [63, 327071]]}, {"verse": 38, "start": 327921, "end": 336427, "text": "Pero los labradores, viendo al hijo, dijeron entre sí: Este es el heredero; venid, matémosle, y tomemos su herencia.", "words": [[0, 327921], [5, 328343], [9, 328543], [21, 329223], [28, 329383], [31, 329603], [37, 329923], [45, 330383], [51, 330623], [55, 331246], [60, 331531], [63, 331791], [66, 332329], [76, 333031], [83, 333518], [94, 334278], [96, 334698], [104, 335118], [107, 335598]]}, {"verse": 39, "start": 336777, "end": 340289, "text": "Y tomado, le echaron fuera de la viña, y le mataron.", "words": [[0, 336777], [2, 336900], [10, 337380], [13, 337580], [21, 338060], [27, 338340], [30, 338560], [33, 338700], [39, 339160], [41, 339360], [44, 339460]]}, {"verse": 40, "start": 340639, "end": 345025, "text": "Pues cuando venga el señor de la viña, ¿qué hará a aquellos labradores?", "words": [[0, 340639], [5, 340743], [12, 341063], [18, 341383], [21, 341483], [27, 341763], [30, 342003], [33, 342123], [39, 342723], [44, 343023], [49, 343273], [51, 343523], [60, 343883]]}, {"verse": 41, "start": 345375, "end": 353231, "text": "Le dicen: a los malos destruirá miserablemente, y su viña dará en arriendo a otros labradores, que le paguen el fruto a sus tiempos.", "words": [[0, 345375], [3, 345805], [10, 346444], [12, 346542], [16, 346642], [22, 347042], [32, 347622], [48, 348522], [50, 348697], [53, 348877], [58, 349217], [63, 349477], [66, 349577], [75, 350057], [77, 350177], [83, 350377], [95, 351077], [99, 351437], [102, 351557], [109, 351897], [112, 352107], [118, 352317], [120, 352397], [124, 352517]]}, {"verse": 42, "start": 353511, "end": 367650, "text": "Les dice Jesús: ¿Nunca leísteis en las Escrituras: La piedra que desecharon los que edificaban, esta fue hecha por piedra angular: por el Señor es hecho esto, y es cosa maravillosa en nuestros ojos?", "words": [[0, 353585], [4, 353695], [9, 353975], [16, 354825], [23, 355313], [32, 356113], [35, 356253], [39, 356413], [51, 357543], [54, 357650], [61, 358130], [65, 358270], [76, 359010], [80, 359210], [84, 359370], [96, 360470], [101, 360710], [105, 360950], [111, 361190], [115, 361430], [122, 361890], [131, 362905], [135, 363289], [138, 363449], [144, 363749], [147, 364049], [153, 364309], [159, 364709], [161, 364989], [164, 365149], [169, 365409], [181, 366469], [184, 366609], [193, 366849]]}, {"verse": 43, "start": 368000, "end": 374576, "text": "Por tanto os digo, que el reino de Dios será quitado de vosotros, y será dado a gente que haga los frutos de él.", "words": [[0, 368000], [4, 368127], [10, 368297], [13, 368467], [19, 368867], [23, 369107], [26, 369247], [32, 369647], [35, 369807], [40, 370047], [45, 370327], [53, 370887], [56, 371067], [66, 371607], [68, 371992], [73, 372232], [78, 372512], [80, 372672], [86, 372932], [90, 373192], [95, 373372], [99, 373592], [106, 373992], [109, 374192]]}, {"verse": 44, "start": 374926, "end": 381537, "text": "Y el que caiga sobre esta piedra, será quebrantado; y sobre quien ella caiga, lo aplastará.", "words": [[0, 374926], [2, 375033], [5, 375153], [9, 375313], [15, 375753], [21, 376053], [26, 376273], [34, 376833], [39, 377663], [52, 378661], [54, 378817], [60, 379077], [66, 379357], [71, 379677], [78, 380317], [81, 380927]]}, {"verse": 45, "start": 381887, "end": 390008, "text": "Y oyendo los príncipes de los sacerdotes y los fariseos sus parábolas, entendieron que hablaba de ellos.", "words": [[0, 382354], [2, 382834], [9, 383194], [13, 383414], [23, 384114], [26, 384254], [30, 384374], [41, 385274], [43, 385474], [47, 385614], [56, 386574], [60, 386774], [71, 387974], [83, 388694], [87, 388914], [95, 389354], [98, 389494]]}, {"verse": 46, "start": 390358, "end": 395510, "text": "Y buscando cómo echarle mano, temieron al pueblo; porque le tenían por profeta.", "words": [[0, 390358], [2, 390633], [11, 390933], [16, 391313], [24, 391720], [30, 392126], [39, 392533], [42, 392713], [50, 393621], [57, 393846], [60, 394006], [67, 394366], [71, 394686]]}]}