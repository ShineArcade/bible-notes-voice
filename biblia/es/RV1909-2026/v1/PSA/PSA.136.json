{"book": "PSA", "chapter": 136, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 157678, "verses": [{"verse": 1, "start": 300, "end": 6272, "text": "Alabad a Jehová, porque es bueno; porque para siempre es su misericordia.", "words": [[0, 594], [7, 924], [9, 1144], [17, 1564], [24, 1824], [27, 2064], [34, 2942], [41, 3184], [46, 3404], [54, 3984], [57, 4824], [60, 5144]]}, {"verse": 2, "start": 6722, "end": 11844, "text": "Alabad al Dios de los dioses, porque para siempre es su misericordia.", "words": [[0, 7053], [7, 7413], [10, 7673], [15, 8073], [18, 8233], [22, 8393], [30, 8933], [37, 9433], [42, 9713], [50, 10133], [53, 10513], [56, 10753]]}, {"verse": 3, "start": 12294, "end": 18032, "text": "Alabad al Señor de los señores, porque para siempre es su misericordia.", "words": [[0, 12294], [7, 12960], [10, 13200], [16, 13560], [19, 13820], [23, 13960], [32, 14900], [39, 15420], [44, 15700], [52, 16140], [55, 16480], [58, 16680]]}, {"verse": 4, "start": 18482, "end": 23497, "text": "Al solo que hace grandes maravillas, porque para siempre es su misericordia.", "words": [[0, 18482], [3, 18677], [8, 18917], [12, 19137], [17, 19377], [25, 19757], [37, 20877], [44, 21297], [49, 21557], [57, 21877], [60, 22157], [63, 22537]]}, {"verse": 5, "start": 23947, "end": 29456, "text": "Al que hizo los cielos con entendimiento, porque para siempre es su misericordia.", "words": [[0, 23947], [3, 24108], [7, 24248], [12, 24508], [16, 24728], [23, 25408], [27, 25608], [42, 26808], [49, 27048], [54, 27328], [62, 27828], [65, 28188], [68, 28328]]}, {"verse": 6, "start": 29906, "end": 36098, "text": "Al que tendió la tierra sobre las aguas, porque para siempre es su misericordia;", "words": [[0, 30010], [3, 30120], [7, 30260], [14, 30680], [17, 30820], [24, 31310], [30, 31800], [34, 32020], [41, 32740], [48, 32960], [53, 33220], [61, 33620], [64, 33940], [67, 34080]]}, {"verse": 7, "start": 36548, "end": 42064, "text": "Al que hizo las grandes lum