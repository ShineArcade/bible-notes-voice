{"book": "LUK", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 308617, "verses": [{"verse": 1, "start": 300, "end": 9467, "text": "Y en este mismo tiempo estaban allí unos que le contaban acerca de los galileos, cuya sangre Pilato había mezclado con sus sacrificios.", "words": [[0, 300], [2, 442], [5, 542], [10, 742], [16, 1022], [23, 1422], [31, 1802], [36, 2162], [41, 2622], [45, 2982], [48, 3102], [57, 3662], [64, 3982], [67, 4282], [71, 4422], [81, 5142], [86, 5802], [93, 6142], [100, 6762], [106, 7123], [115, 8003], [119, 8222], [123, 8423]]}, {"verse": 2, "start": 9817, "end": 19734, "text": "Y respondiendo Jesús, les dijo: ¿Pensáis que estos galileos, porque han padecido tales cosas, hayan sido más pecadores que todos los galileos?", "words": [[0, 9817], [2, 10120], [15, 10820], [22, 11240], [26, 11780], [32, 12624], [41, 13006], [45, 13206], [51, 13386], [61, 14486], [68, 14826], [72, 15066], [81, 15606], [87, 15886], [94, 16946], [100, 17226], [105, 17486], [109, 17686], [119, 18166], [123, 18366], [129, 18626], [133, 18806]]}, {"verse": 3, "start": 20084, "end": 25509, "text": "No, os digo; sino que si no os arrepentís, todos pereceréis igualmente.", "words": [[0, 20144], [4, 20238], [7, 20331], [13, 21215], [18, 21611], [22, 21811], [25, 22011], [28, 22231], [31, 22431], [43, 23531], [49, 23751], [60, 24571]]}, {"verse": 4, "start": 25859, "end": 36280, "text": "O aquellos dieciocho, sobre los cuales cayó la torre en Siloé, y los mató, ¿pensáis que ellos fueron más culpables que todos los hombres que habitan en Jerusalén?", "words": [[0, 25859], [2, 25967], [11, 26437], [22, 26907], [28, 27387], [32, 27587], [39, 27867], [44, 28387], [47, 28507], [53, 28927], [56, 29147], [63, 29727], [65, 30347], [69, 30487], [75, 31287], [84, 31827], [88, 32087], [94, 32287], [101, 32587], [105, 32887], [115, 33607], [119, 33767], [125, 34047], [129, 34287], [137, 34627], [141, 34827], [149, 35267], [152, 35367]]}, {"verse": 5, "start": 36630, "end": 41953, "text": "No, os digo; sino que si no os arrepentís, todos pereceréis asimismo.", "words": [[0, 36690], [4, 36784], [7, 36877], [13, 37760], [18, 37983], [22, 38163], [25, 38343], [28, 38523], [31, 38703], [43, 39923], [49, 40363], [60, 41196]]}, {"verse": 6, "start": 42303, "end": 49709, "text": "Y dijo esta parábola: Tenía uno una higuera plantada en su viña, y vino a buscar fruto en ella, y no lo halló.", "words": [[0, 42303], [2, 42431], [7, 42671], [12, 42871], [22, 44001], [28, 44181], [32, 44501], [36, 44881], [44, 45401], [53, 45941], [56, 46061], [59, 46221], [65, 46701], [67, 47281], [72, 47481], [74, 47641], [81, 47841], [87, 48321], [90, 48481], [96, 48721], [98, 49001], [101, 49161], [104, 49465]]}, {"verse": 7, "start": 50059, "end": 60256, "text": "Y dijo al encargado de la viña: He aquí hace tres años que vengo a buscar fruto en esta higuera, y no lo hallo; córtala, ¿por qué ocupará aún la tierra?", "words": [[0, 50059], [2, 50266], [7, 50506], [10, 50646], [20, 51266], [23, 51426], [26, 51546], [32, 52509], [35, 52689], [40, 52989], [45, 53409], [50, 53749], [55, 54169], [59, 54429], [65, 54729], [67, 54789], [74, 55029], [80, 55649], [83, 55809], [88, 56029], [97, 56509], [99, 56649], [102, 56809], [105, 57009], [112, 57701], [121, 58066], [126, 58306], [130, 58466], [138, 59046], [142, 59386], [145, 59586]]}, {"verse": 8, "start": 60606, "end": 69690, "text": "Él entonces respondiendo, le dijo: Señor, déjala aún este año, hasta que cave a su alrededor y la abone con estiércol.", "words": [[0, 60606], [3, 60870], [12, 61570], [26, 62635], [29, 62795], [35, 63547], [42, 64334], [49, 64754], [53, 65134], [58, 65454], [63, 66214], [69, 66454], [73, 66754], [78, 67054], [80, 67254], [83, 67414], [93, 67834], [95, 68174], [98, 68314], [104, 68734], [108, 68934]]}, {"verse": 9, "start": 70040, "end": 74389, "text": "Y si da fruto, bien; y si no, la cortarás después.", "words": [[0, 70040], [2, 70142], [5, 70282], [8, 70462], [15, 71202], [21, 72010], [23, 72139], [26, 72259], [30, 72779], [33, 73079], [42, 73699]]}, {"verse": 10, "start": 74739, "end": 77338, "text": "Y enseñaba en una sinagoga en sábado.", "words": [[0, 74739], [2, 74862], [11, 75482], [14, 75642], [18, 75802], [27, 76462], [30, 76642]]}, {"verse": 11, "start": 77688, "end": 87031, "text": "Y he aquí una mujer que tenía espíritu de enfermedad dieciocho años, y andaba encorvada, que en ninguna manera se podía enderezar.", "words": [[0, 77688], [2, 77912], [5, 78192], [10, 78452], [14, 78692], [20, 78992], [24, 79252], [30, 79592], [39, 80412], [42, 80532], [53, 81162], [63, 81792], [69, 82492], [71, 82807], [78, 83287], [89, 84447], [93, 84567], [96, 84687], [104, 85127], [111, 85507], [114, 85747], [120, 86087]]}, {"verse": 12, "start": 87381, "end": 93972, "text": "Y como Jesús la vio, la llamó, y le dijo: Mujer, libre eres de tu enfermedad.", "words": [[0, 87381], [2, 87488], [7, 87728], [13, 88028], [16, 88368], [21, 89088], [24, 89248], [31, 89768], [33, 90128], [36, 90268], [42, 91025], [49, 91894], [55, 92354], [60, 92794], [63, 93014], [66, 93154]]}, {"verse": 13, "start": 94322, "end": 99985, "text": "Y puso las manos sobre ella; y enseguida se enderezó, y glorificaba a Dios.", "words": [[0, 94322], [2, 94448], [7, 94728], [11, 94888], [17, 95168], [23, 95528], [29, 96349], [31, 96656], [41, 97256], [44, 97456], [54, 98176], [56, 98516], [68, 99236], [70, 99416]]}, {"verse": 14, "start": 100335, "end": 115175, "text": "Y respondiendo el dirigente de la sinagoga, enojado de que Jesús hubiese curado en sábado, dijo a la multitud: Seis días hay en que es necesario trabajar: en estos, pues, venid y sed curados, y no en día de sábado.", "words": [[0, 100335], [2, 100457], [15, 100937], [18, 101417], [28, 102117], [31, 102237], [34, 102377], [44, 103137], [52, 104257], [55, 104437], [59, 104557], [65, 104957], [73, 105697], [80, 106177], [83, 106357], [91, 106937], [96, 107577], [98, 107737], [101, 107817], [111, 108842], [116, 109013], [121, 109353], [125, 109773], [128, 109913], [132, 110073], [135, 110213], [145, 110693], [155, 111661], [158, 111786], [165, 112326], [171, 112586], [177, 112906], [179, 113026], [183, 113166], [192, 113686], [194, 113966], [197, 114146], [200, 114266], [204, 114426], [207, 114586]]}, {"verse": 15, "start": 115455, "end": 126581, "text": "Entonces el Señor le respondió, y dijo: Hipócrita, cada uno de vosotros ¿no desata en sábado su buey o su asno del pesebre, y lo lleva a beber?", "words": [[0, 115455], [9, 115916], [12, 116296], [18, 116596], [21, 116896], [32, 117536], [34, 117756], [40, 118438], [51, 119505], [56, 119705], [60, 120045], [63, 120205], [72, 120845], [76, 121405], [83, 121925], [86, 122145], [93, 122645], [96, 123085], [101, 123525], [103, 123665], [106, 123825], [111, 124365], [115, 124545], [124, 125125], [126, 125505], [129, 125645], [135, 125905], [137, 126105]]}, {"verse": 16, "start": 126931, "end": 136385, "text": "Y a esta hija de Abraham, que he aquí Satanás la había atado dieciocho años, ¿no convino desatarla de esta ligadura en día de sábado?", "words": [[0, 126931], [2, 127113], [4, 127213], [9, 127493], [14, 127953], [17, 128073], [26, 128513], [30, 128786], [33, 129058], [38, 129498], [46, 130238], [49, 130378], [55, 130678], [61, 131128], [71, 131578], [77, 132738], [81, 133118], [89, 133498], [99, 134318], [102, 134478], [107, 134678], [116, 135218], [119, 135398], [123, 135578], [126, 135738]]}, {"verse": 17, "start": 136735, "end": 147170, "text": "Y diciendo estas cosas, se avergonzaban todos sus adversarios: pero todo el pueblo se gozaba de todas las cosas gloriosas que eran por él hechas.", "words": [[0, 136735], [2, 137115], [11, 137495], [17, 137755], [24, 138755], [27, 139035], [40, 139855], [46, 140255], [50, 140695], [63, 142097], [68, 142241], [73, 142601], [76, 142801], [83, 143201], [86, 143441], [93, 143901], [96, 144061], [102, 144321], [106, 144601], [112, 144881], [122, 145641], [126, 145821], [131, 146021], [135, 146261], [138, 146461]]}, {"verse": 18, "start": 147520, "end": 152014, "text": "Y dijo: ¿A qué es semejante el reino de Dios, y a qué le compararé?", "words": [[0, 147520], [2, 147649], [8, 148109], [11, 148389], [15, 148529], [18, 148869], [28, 149529], [31, 149669], [37, 150029], [40, 150169], [46, 150629], [48, 150709], [50, 150849], [54, 150989], [57, 151129]]}, {"verse": 19, "start": 152364, "end": 164305, "text": "Semejante es a la semilla de mostaza, que tomándola un hombre la metió en su huerto; y creció, y fue hecho árbol grande, y las aves del cielo hicieron nidos en sus ramas.", "words": [[0, 152364], [10, 152988], [13, 153228], [15, 153328], [18, 153448], [26, 153908], [29, 154068], [38, 154628], [42, 154843], [52, 155483], [55, 155663], [62, 156003], [65, 156383], [71, 156703], [74, 156803], [77, 156943], [85, 157619], [87, 158259], [95, 158995], [97, 159135], [101, 159315], [107, 159595], [113, 159995], [121, 160475], [123, 160915], [127, 161055], [132, 161515], [136, 161655], [142, 162015], [151, 162605], [157, 163195], [160, 163355], [164, 163555]]}, {"verse": 20, "start": 164655, "end": 168307, "text": "Y otra vez dijo: ¿A qué compararé el reino de Dios?", "words": [[0, 164655], [2, 164841], [7, 165001], [11, 165321], [17, 166038], [20, 166182], [24, 166262], [34, 167022], [37, 167222], [43, 167602], [46, 167742]]}, {"verse": 21, "start": 168657, "end": 177444, "text": "Semejante es a la levadura, que tomó una mujer, y la escondió en tres medidas de harina, hasta que todo hubo fermentado.", "words": [[0, 168990], [10, 169360], [13, 169620], [15, 169740], [18, 169860], [28, 170440], [32, 170640], [37, 171020], [41, 171160], [48, 171560], [50, 172260], [53, 172400], [62, 173080], [65, 173340], [70, 173580], [78, 174060], [81, 174280], [89, 174780], [95, 175600], [99, 175800], [104, 176080], [109, 176480]]}, {"verse": 22, "start": 177794, "end": 184385, "text": "Y pasaba por todas las ciudades y aldeas, enseñando, y caminando a Jerusalén.", "words": [[0, 177794], [2, 177909], [9, 178349], [13, 178629], [19, 178949], [23, 179269], [32, 180089], [34, 180249], [42, 181089], [53, 182169], [55, 182729], [65, 183429], [67, 183529]]}, {"verse": 23, "start": 184735, "end": 190096, "text": "Y le dijo uno: Señor, ¿son pocos los que se salvan? Y él les dijo:", "words": [[0, 184735], [2, 184926], [5, 185066], [10, 185386], [15, 186481], [22, 187227], [27, 187487], [33, 187987], [37, 188087], [41, 188267], [44, 188387], [52, 189232], [54, 189376], [57, 189476], [61, 189616]]}, {"verse": 24, "start": 190376, "end": 198096, "text": "Esforzaos por entrar por la puerta angosta; porque os digo que muchos procurarán entrar, y no podrán.", "words": [[0, 190904], [10, 191464], [14, 191744], [21, 192224], [25, 192504], [28, 192664], [35, 193104], [44, 194449], [51, 194821], [54, 195001], [59, 195181], [63, 195381], [70, 195621], [81, 196481], [89, 196901], [91, 197201], [94, 197361]]}, {"verse": 25, "start": 198446, "end": 213244, "text": "Después que el padre de familia se levante, y cierre la puerta, y comencéis a estar fuera, y llamar a la puerta, diciendo: Señor, Señor, ábrenos; y respondiendo os dirá: No os conozco de dónde seáis.", "words": [[0, 198446], [8, 198771], [12, 199071], [15, 199191], [21, 199471], [24, 199691], [32, 200051], [35, 200331], [44, 201111], [46, 201371], [53, 201911], [56, 202051], [64, 202451], [66, 202931], [76, 203651], [78, 203751], [84, 203931], [91, 204391], [93, 204871], [100, 205211], [102, 205291], [105, 205391], [113, 205691], [123, 206787], [130, 207340], [137, 208103], [146, 209050], [148, 209157], [161, 209977], [164, 210257], [170, 210962], [173, 211171], [176, 211311], [184, 211931], [187, 212071], [193, 212681]]}, {"verse": 26, "start": 213594, "end": 220301, "text": "Entonces comenzaréis a decir: Delante de ti hemos comido y bebido, y en nuestras plazas enseñaste;", "words": [[0, 213594], [9, 214062], [21, 214962], [23, 215122], [30, 215917], [38, 216363], [41, 216523], [44, 216763], [50, 217043], [57, 217543], [59, 217643], [67, 218103], [69, 218463], [72, 218563], [81, 218743], [88, 219423]]}, {"verse": 27, "start": 220651, "end": 227874, "text": "Y os dirá: Os digo que no os conozco de dónde seáis; apartaos de mí todos los obreros de iniquidad.", "words": [[0, 220651], [2, 220799], [5, 220899], [11, 221558], [14, 221666], [19, 221906], [23, 222106], [26, 222366], [29, 222506], [37, 223026], [40, 223166], [46, 223366], [53, 224789], [62, 225149], [65, 225369], [68, 225669], [74, 225789], [78, 226069], [86, 226669], [89, 227302]]}, {"verse": 28, "start": 228224, "end": 240792, "text": "Allí será el llanto y el crujir de dientes, cuando veáis a Abraham, a Isaac, a Jacob y a todos los profetas en el reino de Dios, y vosotros estéis excluidos.", "words": [[0, 228224], [5, 228588], [10, 228828], [13, 229088], [20, 229528], [22, 229688], [25, 230058], [32, 230428], [35, 230548], [44, 231528], [51, 231808], [57, 232408], [59, 232668], [68, 233868], [70, 233948], [77, 234748], [79, 234788], [85, 235168], [87, 235708], [89, 235788], [95, 236028], [99, 236348], [108, 236908], [111, 237128], [114, 237268], [120, 237668], [123, 237808], [129, 238543], [131, 238668], [140, 239208], [147, 239748]]}, {"verse": 29, "start": 241142, "end": 248203, "text": "Y vendrán del Oriente y del Occidente, del Norte y del Sur, y se sentarán a la mesa en el reino de Dios.", "words": [[0, 241142], [2, 241270], [10, 241770], [14, 241970], [22, 242450], [24, 242610], [28, 242790], [39, 243490], [43, 243770], [49, 244190], [51, 244410], [55, 244590], [60, 245450], [62, 245530], [65, 245650], [74, 246270], [76, 246370], [79, 246430], [84, 246710], [87, 246890], [90, 247050], [96, 247490], [99, 247630]]}, {"verse": 30, "start": 248553, "end": 254412, "text": "Y he aquí, son últimos los que eran primeros, y son primeros los que eran últimos.", "words": [[0, 248553], [2, 248715], [5, 248915], [11, 249255], [15, 249515], [23, 250448], [27, 250560], [31, 250720], [36, 250900], [46, 251880], [48, 252100], [52, 252240], [61, 253040], [65, 253260], [69, 253440], [74, 253680]]}, {"verse": 31, "start": 254762, "end": 262794, "text": "Aquel mismo día llegaron unos de los fariseos, diciéndole: Sal, y vete de aquí, porque Herodes te quiere matar.", "words": [[0, 254762], [6, 255180], [12, 255420], [16, 255780], [25, 256260], [30, 256740], [33, 256940], [37, 257060], [47, 257860], [59, 259180], [64, 259514], [66, 259814], [71, 260054], [74, 260194], [80, 260914], [87, 261314], [95, 261674], [98, 261954], [105, 262174]]}, {"verse": 32, "start": 263074, "end": 273567, "text": "Y les dijo: Id, y decid a aquella zorra: He aquí, echo fuera demonios y acabo sanidades hoy y mañana, y al tercer día culmino mi obra.", "words": [[0, 263074], [2, 263223], [6, 263343], [12, 264218], [16, 264368], [18, 264748], [24, 265048], [26, 265508], [34, 266046], [41, 266738], [44, 266881], [50, 267301], [55, 267721], [61, 268021], [70, 268801], [72, 268901], [78, 269321], [88, 269881], [92, 270281], [94, 270481], [102, 271421], [104, 271501], [107, 271621], [114, 271861], [118, 272281], [126, 272941], [129, 273061]]}, {"verse": 33, "start": 273917, "end": 282713, "text": "Pero es necesario que hoy, y mañana, y pasado mañana camine; porque no es posible que profeta muera fuera de Jerusalén.", "words": [[0, 273917], [5, 274082], [8, 274342], [18, 275362], [22, 275662], [27, 276042], [29, 276662], [37, 277102], [39, 277467], [46, 277867], [53, 278347], [61, 279437], [68, 279598], [71, 279778], [74, 279878], [82, 280278], [86, 280458], [94, 280918], [100, 281298], [106, 281678], [109, 281798]]}, {"verse": 34, "start": 283063, "end": 296916, "text": "¡Jerusalén, Jerusalén! que matas a los profetas, y apedreas a los que son enviados a ti: ¡cuántas veces quise juntar tus hijos, como la gallina sus pollos debajo de sus alas, y no quisiste!", "words": [[0, 283063], [12, 284309], [23, 285379], [27, 285464], [33, 285964], [35, 286064], [39, 286184], [49, 286864], [51, 287319], [60, 288019], [62, 288139], [66, 288259], [70, 288419], [74, 288659], [83, 289239], [85, 289459], [89, 290038], [98, 290465], [104, 290945], [110, 291365], [117, 291905], [121, 292105], [128, 292525], [133, 293125], [136, 293305], [144, 293865], [148, 294005], [155, 294565], [162, 294945], [165, 295105], [169, 295225], [175, 295765], [177, 296025], [180, 296165]]}, {"verse": 35, "start": 297266, "end": 308217, "text": "He aquí, os es dejada vuestra casa desierta: y os digo que no me veréis, hasta que venga tiempo cuando digáis: Bendito el que viene en nombre del Señor.", "words": [[0, 297338], [3, 297448], [9, 297728], [12, 298048], [15, 298268], [22, 298928], [30, 299328], [35, 299588], [45, 300795], [47, 300961], [50, 301081], [55, 301321], [59, 301521], [62, 301761], [65, 301921], [73, 302421], [79, 303081], [83, 303301], [89, 303621], [96, 303981], [103, 304301], [111, 305343], [119, 306030], [122, 306170], [126, 306310], [132, 306590], [135, 306950], [142, 307310], [146, 307590]]}]}