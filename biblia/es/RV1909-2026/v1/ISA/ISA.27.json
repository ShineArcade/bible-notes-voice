{"book": "ISA", "chapter": 27, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 143277, "verses": [{"verse": 1, "start": 300, "end": 14753, "text": "En aquel día Jehová visitará con su espada dura, grande y fuerte, sobre leviathán, serpiente rolliza, y sobre leviathán serpiente retuerta; y matará al dragón que está en el mar.", "words": [[0, 300], [3, 421], [9, 761], [13, 981], [20, 1561], [29, 2121], [33, 2341], [36, 2561], [43, 3041], [49, 3441], [56, 3821], [58, 4001], [66, 5121], [72, 5791], [83, 6461], [93, 7131], [102, 7801], [104, 8441], [110, 9251], [120, 10061], [130, 10641], [140, 11861], [142, 12275], [149, 12775], [152, 13055], [159, 13635], [163, 13795], [168, 14015], [171, 14175], [174, 14315]]}, {"verse": 2, "start": 15203, "end": 18306, "text": "En aquel día cantad de la viña del vino rojo.", "words": [[0, 15203], [3, 15328], [9, 15608], [13, 15788], [20, 16488], [23, 16628], [26, 16748], [31, 17168], [35, 17348], [40, 17608]]}, {"verse": 3, "start": 18606, "end": 25104, "text": "Yo Jehová la guardo, cada momento la regaré; la guardaré de noche y de día, porque nadie la visite.", "words": [[0, 18606], [3, 18792], [10, 19212], [13, 19252], [21, 19912], [26, 20032], [34, 20452], [37, 20712], [45, 21883], [48, 22004], [57, 22504], [60, 22624], [66, 22884], [68, 23064], [71, 23164], [76, 23784], [83, 23984], [89, 24244], [92, 24424]]}, {"verse": 4, "start": 25777, "end": 33583, "text": "No hay en mí enojo. ¿Quién pondrá contra mí en batalla espinas y cardos? Yo los hollaré, los quemaré juntamente.", "words": [[0, 25777], [3, 25980], [7, 26120], [10, 26240], [13, 26380], [20, 27480], [27, 27681], [34, 28001], [41, 28281], [44, 28541], [47, 28868], [55, 29194], [63, 29521], [65, 29701], [73, 30932], [76, 31043], [80, 31493], [89, 31943], [93, 32023], [101, 32503]]}, {"verse": 5, "start": 34277, "end": 39377, "text": "¿O forzará alguien mi fortaleza? Haga conmigo paz, sí, haga paz conmigo.", "words": [[0, 34277], [3, 34384], [11, 34864], [19, 35224], [22, 35444], [33, 36897], [38, 37027], [46, 37567], [51, 37707], [55, 38087], [60, 38467], [64, 38727]]}, {"verse": 6, "start": 39975, "end": 49025, "text": "Días vendrán cuando Jacob echará raíces, florecerá y echará renuevos Israel, y la faz del mundo se llenará de fruto.", "words": [[0, 39975], [5, 40260], [13, 40720], [20, 40920], [26, 41440], [33, 42020], [41, 43140], [51, 43940], [53, 44380], [60, 44900], [69, 45420], [77, 45820], [79, 46420], [82, 46580], [86, 46880], [90, 47200], [96, 47520], [99, 47780], [107, 48300], [110, 48420]]}, {"verse": 7, "start": 49475, "end": 55044, "text": "¿Acaso ha sido herido como quien lo hirió? ¿o ha sido muerto como los que lo mataron?", "words": [[0, 49475], [7, 50179], [10, 50339], [15, 50579], [22, 50959], [27, 51199], [33, 51439], [36, 51659], [43, 52490], [46, 52637], [49, 52757], [54, 52957], [61, 53497], [66, 53737], [70, 53957], [74, 54117], [77, 54237]]}, {"verse": 8, "start": 55494, "end": 62645, "text": "Con medida la castigarás en sus vástagos. El reprime su recio viento en el día del aire solano.", "words": [[0, 55494], [4, 55618], [11, 55998], [14, 56238], [25, 56938], [28, 57078], [32, 57258], [42, 58398], [45, 58524], [53, 59144], [56, 59364], [62, 59804], [69, 60304], [72, 60764], [75, 60924], [79, 61224], [83, 61444], [88, 61844]]}, {"verse": 9, "start": 63095, "end": 80256, "text": "De esta manera pues será purgada la iniquidad de Jacob; y este será todo el fruto, la remoción de su pecado, cuando torne todas las piedras del altar como piedras de cal desmenuzadas, y no se levantarán los bosques, ni las imágenes del sol.", "words": [[0, 63152], [3, 63242], [8, 63342], [15, 63642], [20, 63922], [25, 64122], [33, 64682], [36, 64862], [46, 65542], [49, 65960], [56, 66619], [58, 66801], [63, 67181], [68, 67561], [73, 67861], [76, 68081], [83, 68981], [86, 69061], [95, 69621], [98, 69781], [101, 69881], [109, 70861], [116, 70961], [122, 71621], [128, 72021], [132, 72481], [140, 730