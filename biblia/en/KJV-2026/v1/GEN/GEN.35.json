{"book": "GEN", "chapter": 35, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 221229, "verses": [{"verse": 1, "start": 300, "end": 10893, "text": "And God said to Jacob, Arise, go up to Beth-el, and dwell there: and make there an altar to God, that appeared to you when you fled from the face of Esau your brother.", "words": [[0, 300], [4, 444], [8, 804], [13, 1124], [16, 1324], [23, 2098], [30, 2702], [33, 2822], [36, 3002], [39, 3142], [48, 4002], [52, 4102], [58, 4402], [65, 5533], [69, 5672], [74, 5872], [80, 6052], [83, 6172], [89, 6472], [92, 6652], [97, 6972], [102, 7412], [111, 7692], [114, 7972], [118, 8152], [123, 8372], [127, 8492], [132, 8752], [137, 8972], [141, 9092], [146, 9352], [149, 9572], [154, 9932], [159, 10072]]}, {"verse": 2, "start": 11243, "end": 19505, "text": "Then Jacob said to his household, and to all that were with him, Put away the strange gods that are among you, and be clean, and change your garments:", "words": [[0, 11243], [5, 11527], [11, 11887], [16, 12227], [19, 12447], [23, 12607], [34, 13527], [38, 13787], [41, 13947], [45, 14187], [50, 14407], [55, 14567], [60, 14807], [65, 15346], [69, 15468], [74, 15688], [78, 15888], [86, 16168], [91, 16448], [96, 16668], [100, 16808], [106, 16988], [111, 17268], [115, 17588], [118, 17708], [125, 18048], [129, 18468], [136, 18728], [141, 18888]]}, {"verse": 3, "start": 19955, "end": 28360, "text": "And let us arise, and go up to Beth-el; and I will make there an altar to God, who answered me in the day of my distress, and was with me in the way which I went.", "words": [[0, 19955], [4, 20072], [8, 20192], [11, 20352], [18, 20712], [22, 21052], [25, 21272], [28, 21452], [31, 21572], [40, 22434], [44, 22579], [46, 22679], [51, 22779], [56, 22979], [62, 23159], [65, 23279], [71, 23579], [74, 23819], [79, 24419], [83, 24639], [92, 24939], [95, 25199], [98, 25299], [102, 25399], [106, 25559], [109, 25659], [112, 25799], [122, 26599], [126, 26759], [130, 26919], [135, 27119], [138, 27319], [141, 27419], [145, 27499], [149, 27639], [155, 27839], [157, 27979]]}, {"verse": 4, "start": 28710, "end": 39347, "text": "And they gave to Jacob all the strange gods which were in their hand, and all their earrings which were in their ears; and Jacob hid them under the oak which was by Shechem.", "words": [[0, 28710], [4, 28836], [9, 28976], [14, 29236], [17, 29416], [23, 29776], [27, 30216], [31, 30456], [39, 30896], [44, 31336], [50, 31656], [55, 31876], [58, 32116], [64, 32336], [70, 32996], [74, 33276], [78, 33556], [84, 33776], [93, 34196], [99, 34616], [104, 34816], [107, 35076], [113, 35296], [119, 36267], [123, 36404], [129, 36704], [133, 37024], [138, 37264], [144, 37504], [148, 37724], [152, 38124], [158, 38244], [162, 38444], [165, 38931]]}, {"verse": 5, "start": 39797, "end": 47571, "text": "And they journeyed: and the terror of God was upon the cities that were round about them, and they did not pursue after the sons of Jacob.", "words": [[0, 39797], [4, 39951], [9, 40071], [20, 41046], [24, 41169], [28, 41289], [35, 41609], [38, 41809], [42, 42129], [46, 42349], [51, 42609], [55, 42829], [62, 43089], [67, 43349], [72, 43489], [78, 43769], [84, 44069], [90, 44609], [94, 44889], [99, 45029], [103, 45209], [107, 45369], [114, 45869], [120, 46209], [124, 46389], [129, 46649], [132, 46809]]}, {"verse": 6, "start": 48021, "end": 55636, "text": "¶ So Jacob came to Luz, which is in the land of Canaan, that is, Beth-el, he and all the people that were with him.", "words": [[2, 48021], [5, 48141], [11, 48521], [16, 48841], [19, 49041], [24, 49861], [30, 50101], [33, 50261], [36, 50401], [40, 50521], [45, 50781], [48, 50941], [56, 52121], [61, 52121], [65, 52321], [74, 53381], [77, 53881], [81, 53981], [85, 54221], [89, 54361], [96, 54621], [101, 54861], [106, 55001], [111, 55281]]}, {"verse": 7, "start": 56086, "end": 63404, "text": "And he built there an altar, and called the place El-beth-el: because there God appeared to him, when he fled from the face of his brother.", "words": [[0, 56086], [4, 56222], [7, 56302], [13, 56542], [19, 56782], [22, 56922], [29, 57302], [33, 57782], [40, 58022], [44, 58182], [50, 58911], [62, 59888], [70, 60082], [76, 60312], [80, 60632], [89, 60972], [92, 61232], [97, 61432], [102, 61692], [105, 61832], [110, 62052], [115, 62272], [119, 62392], [124, 62632], [127, 62772], [131, 62872]]}, {"verse": 8, "start": 63854, "end": 71592, "text": "But Deborah Rebekah’s nurse died, and she was buried beneath Beth-el under an oak: and the name of it was called Allon-bachuth.", "words": [[0, 63854], [4, 63966], [12, 64456], [22, 64946], [28, 65206], [34, 65646], [38, 66006], [42, 66186], [46, 66346], [53, 66686], [61, 67046], [69, 67606], [75, 67906], [78, 68106], [83, 68865], [87, 69010], [91, 69090], [96, 69350], [99, 69490], [102, 69610], [106, 69810], [113, 70709]]}, {"verse": 9, "start": 72042, "end": 77057, "text": "¶ And God appeared to Jacob again, when he came out of Padan-aram, and blessed him.", "words": [[2, 72042], [6, 72183], [10, 72403], [19, 72683], [22, 72923], [28, 73243], [35, 73663], [40, 74223], [43, 74343], [48, 74583], [52, 74863], [55, 75403], [67, 75943], [71, 76283], [79, 76543]]}, {"verse": 10, "start": 77507, "end": 86465, "text": "And God said to him, Your name is Jacob: your name shall not be called any more Jacob, but Israel shall be your name: and he called his name Israel.", "words": [[0, 77507], [4, 77611], [8, 77851], [13, 78111], [16, 78331], [21, 78948], [26, 79039], [31, 79239], [34, 79399], [41, 80553], [46, 80654], [51, 80854], [57, 81094], [61, 81314], [64, 81474], [71, 81694], [75, 81874], [80, 82054], [87, 82794], [91, 82894], [98, 83234], [104, 83514], [107, 83674], [112, 83794], [118, 84889], [122, 85017], [125, 85117], [132, 85377], [136, 85557], [141, 85797]]}, {"verse": 11, "start": 86915, "end": 98274, "text": "And God said to him, I am God Almighty: be fruitful and multiply; a nation and a company of nations shall be of you, and kings shall come out of your loins;", "words": [[0, 86915], [4, 87039], [8, 87279], [13, 87559], [16, 87759], [21, 88328], [23, 88534], [26, 88674], [30, 88954], [40, 90247], [43, 90346], [52, 90806], [56, 91206], [66, 92190], [68, 92990], [75, 93350], [79, 93630], [81, 93770], [89, 94050], [92, 94250], [100, 94570], [106, 94910], [109, 95130], [112, 95310], [117, 95710], [121, 96070], [127, 96350], [133, 96690], [138, 96910], [142, 97110], [145, 97230], [150, 97330]]}, {"verse": 12, "start": 98724, "end": 104709, "text": "And the land which I gave Abraham and Isaac, to you I will give it, and to your seed after you will I give the land.", "words": [[0, 98724], [4, 98856], [8, 98976], [13, 99236], [19, 99436], [21, 99576], [26, 99756], [34, 100136], [38, 100396], [45, 100616], [48, 100856], [52, 101016], [54, 101176], [59, 101316], [64, 101496], [68, 102056], [72, 102176], [75, 102316], [80, 102456], [85, 102816], [91, 103156], [95, 103376], [100, 103516], [102, 103636], [107, 103796], [111, 103956]]}, {"verse": 13, "start": 105059, "end": 108090, "text": "And God went up from him in the place where he talked with him.", "words": [[0, 105059], [4, 105182], [8, 105462], [13, 105682], [16, 105881], [21, 106122], [25, 106322], [28, 106482], [32, 106581], [38, 106842], [44, 107062], [47, 107202], [54, 107482], [59, 107742]]}, {"verse": 14, "start": 108540, "end": 116818, "text": "And Jacob set up a pillar in the place where he talked with him, even a pillar of stone: and he poured a drink offering on it, and he poured oil on it.", "words": [[0, 108540], [4, 108687], [10, 109027], [14, 109307], [17, 109467], [19, 109567], [26, 109827], [29, 110067], [33, 110167], [39, 110427], [45, 110627], [48, 110747], [55, 111007], [60, 111267], [65, 111767], [70, 112027], [72, 112187], [79, 112407], [82, 112607], [89, 113561], [93, 113685], [96, 113785], [103, 114045], [105, 114185], [111, 114425], [120, 114825], [123, 115165], [127, 115325], [131, 115505], [134, 115625], [141, 115905], [145, 116265], [148, 116565]]}, {"verse": 15, "start": 117268, "end": 121164, "text": "And Jacob called the name of the place where God spoke with him, Beth-el.", "words": [[0, 117268], [4, 117393], [10, 117693], [17, 118013], [21, 118213], [26, 118433], [29, 118613], [33, 118733], [39, 119033], [45, 119253], [49, 119513], [55, 119853], [60, 120173], [65, 120593]]}, {"verse": 16, "start": 121614, "end": 129555, "text": "¶ And they journeyed from Beth-el; and there was but a little way to come to Ephrath: and Rachel travailed, and she had hard labour.", "words": [[2, 121614], [6, 121736], [11, 121856], [21, 122376], [26, 122881], [35, 123628], [39, 123777], [45, 123997], [49, 124257], [53, 124477], [55, 124597], [62, 124817], [66, 125097], [69, 125277], [74, 125477], [77, 125863], [86, 126549], [90, 126695], [97, 127075], [108, 128095], [112, 128195], [116, 128375], [120, 128615], [125, 129118]]}, {"verse": 17, "start": 130005, "end": 137644, "text": "And it came to pass, when she was in hard labour, that the midwife said to her, Fear not; you shall have this son also.", "words": [[0, 130005], [4, 130140], [7, 130260], [12, 130480], [15, 130640], [21, 130980], [26, 131320], [30, 131520], [34, 131700], [37, 131840], [42, 132150], [50, 132460], [55, 133080], [59, 133260], [67, 133660], [72, 133980], [75, 134180], [80, 134753], [85, 134911], [90, 135781], [94, 135946], [100, 136146], [105, 136386], [110, 136636], [114, 136886]]}, {"verse": 18, "start": 137994, "end": 146061, "text": "And it came to pass, as her soul was in departing, (for she died) that she called his name Ben-oni: but his father called him Benjamin.", "words": [[0, 137994], [4, 138124], [7, 138244], [12, 138464], [15, 138624], [21, 138984], [24, 139244], [28, 139404], [33, 139744], [37, 139964], [40, 140084], [51, 140704], [56, 140864], [60, 141064], [66, 141964], [71, 142084], [75, 142244], [82, 142544], [86, 142744], [91, 143430], [100, 144347], [104, 144447], [108, 144567], [115, 144887], [122, 145187], [126, 145387]]}, {"verse": 19, "start": 146511, "end": 151265, "text": "And Rachel died, and was buried in the way to Ephrath, which is Beth-lehem.", "words": [[0, 146511], [4, 146651], [11, 146951], [17, 147431], [21, 147791], [25, 147971], [32, 148331], [35, 148531], [39, 148611], [43, 148811], [46, 148991], [55, 149891], [61, 150051], [64, 150231]]}, {"verse": 20, "start": 151715, "end": 157267, "text": "And Jacob set a pillar upon her grave: that is the pillar of Rachel’s grave to this day.", "words": [[0, 151715], [4, 151858], [10, 152218], [14, 152518], [16, 152618], [23, 152898], [28, 153218], [32, 153478], [39, 154424], [44, 154629], [47, 154789], [51, 154929], [58, 155249], [61, 155469], [70, 155969], [76, 156289], [79, 156489], [84, 156729]]}, {"verse": 21, "start": 157717, "end": 161803, "text": "¶ And Israel journeyed, and spread his tent beyond the tower of Edar.", "words": [[2, 157717], [6, 157841], [13, 158201], [24, 158961], [28, 159041], [35, 159401], [39, 159661], [44, 159981], [51, 160341], [55, 160581], [61, 160941], [64, 161201]]}, {"verse": 22, "start": 162253, "end": 173003, "text": "And it came to pass, when Israel dwelt in that land, that Reuben went and lay with Bilhah his father’s concubine: and Israel heard it. Now the sons of Jacob were twelve:", "words": [[0, 162253], [4, 162383], [7, 162483], [12, 162703], [15, 162903], [21, 163223], [26, 163503], [33, 163923], [39, 164463], [42, 164643], [47, 164843], [53, 165683], [58, 165863], [65, 166263], [70, 166543], [74, 166763], [78, 166963], [83, 167163], [90, 167663], [94, 167883], [103, 168343], [114, 169416], [118, 169562], [125, 169942], [131, 170282], [135, 170844], [139, 171108], [143, 171368], [148, 171628], [151, 171828], [157, 172148], [162, 172428]]}, {"verse": 23, "start": 173453, "end": 180849, "text": "The sons of Leah; Reuben, Jacob’s firstborn, and Simeon, and Levi, and Judah, and Issachar, and Zebulun:", "words": [[0, 173453], [4, 173553], [9, 173793], [12, 