{"book": "JHN", "chapter": 4, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 403220, "verses": [{"verse": 1, "start": 300, "end": 8098, "text": "De manera que como Jesús entendió que los fariseos habían oído que Jesús hacía y bautizaba más discípulos que Juan,", "words": [[0, 300], [3, 407], [10, 627], [14, 1027], [19, 1167], [25, 1487], [34, 2247], [38, 2367], [42, 2527], [51, 3187], [58, 3447], [63, 3907], [67, 4087], [73, 4427], [79, 5067], [81, 5247], [91, 5947], [95, 6207], [106, 7347], [110, 7487]]}, {"verse": 2, "start": 8448, "end": 12462, "text": "(Aunque Jesús no bautizaba, sino sus discípulos),", "words": [[0, 8448], [8, 8705], [14, 9105], [17, 9525], [28, 10625], [33, 10905], [37, 11525]]}, {"verse": 3, "start": 12812, "end": 15889, "text": "Salió de Judea y se fue otra vez a Galilea.", "words": [[0, 12812], [6, 13218], [9, 13338], [15, 13858], [17, 13958], [20, 14058], [24, 14298], [29, 14538], [33, 14898], [35, 15158]]}, {"verse": 4, "start": 16239, "end": 19008, "text": "Y era necesario que pasase por Samaria.", "words": [[0, 16239], [2, 16405], [6, 16565], [16, 17245], [20, 17445], [27, 17965], [31, 18205]]}, {"verse": 5, "start": 19358, "end": 27368, "text": "Vino, pues, a una ciudad de Samaria que se llamaba Sicar, junto a la parcela que Jacob dio a José su hijo.", "words": [[0, 19358], [6, 19624], [12, 20484], [14, 20724], [18, 20884], [25, 21184], [28, 21464], [36, 21964], [40, 22224], [43, 22384], [51, 23074], [58, 23764], [64, 24144], [66, 24364], [69, 24444], [77, 25004], [81, 25184], [87, 25564], [91, 26024], [93, 26164], [98, 26444], [101, 26744]]}, {"verse": 6, "start": 27718, "end": 35770, "text": "Y estaba allí la fuente de Jacob. Pues Jesús, cansado del camino, así se sentó a la fuente. Era como la hora de sexta.", "words": [[0, 27718], [2, 27823], [9, 28083], [14, 28403], [17, 28563], [24, 28963], [27, 29103], [34, 29937], [39, 30121], [46, 30841], [54, 31171], [58, 31501], [66, 32521], [70, 32701], [73, 32861], [79, 33281], [81, 33361], [84, 33421], [92, 34230], [96, 34415], [101, 34675], [104, 34855], [109, 35035], [112, 35195]]}, {"verse": 7, "start": 36120, "end": 41572, "text": "Vino una mujer de Samaria a sacar agua: y Jesús le dice: Dame de beber.", "words": [[0, 36120], [5, 36383], [9, 36663], [15, 36963], [18, 37163], [26, 37643], [28, 37883], [34, 38103], [40, 39038], [42, 39259], [48, 39579], [51, 39919], [57, 40613], [62, 40880], [65, 41244]]}, {"verse": 8, "start": 41922, "end": 45843, "text": "(Porque sus discípulos habían ido a la ciudad a comprar de comer.)", "words": [[0, 41922], [8, 42109], [12, 42349], [23, 43089], [30, 43369], [34, 43729], [36, 43869], [39, 43929], [46, 44269], [48, 44509], [56, 44989], [59, 45249]]}, {"verse": 9, "start": 46193, "end": 57131, "text": "Y la mujer samaritana le dice: ¿Cómo tú, siendo judío, me pides a mí de beber, que soy mujer samaritana? porque los judíos no se tratan con los samaritanos.", "words": [[0, 46193], [2, 46488], [5, 46588], [11, 46888], [22, 47748], [25, 47908], [31, 48671], [37, 48885], [41, 49125], [48, 49485], [55, 50425], [58, 50565], [64, 50905], [66, 51065], [69, 51225], [72, 51365], [79, 51665], [83, 52145], [87, 52385], [93, 52705], [105, 53967], [112, 54191], [116, 54391], [123, 54891], [126, 55051], [129, 55211], [136, 55711], [140, 55871], [144, 56071]]}, {"verse": 10, "start": 57481, "end": 69296, "text": "Respondió Jesús y le dijo: Si conocieses el don de Dios, y quién es el que te dice: Dame de beber: tú pedirías de él, y él te daría agua viva.", "words": [[0, 57481], [10, 58021], [16, 58441], [18, 58861], [21, 59001], [27, 59728], [30, 59893], [41, 60893], [44, 61053], [48, 61313], [51, 61533], [57, 61833], [59, 62193], [65, 62453], [68, 62793], [71, 63053], [75, 63213], [78, 63353], [84, 64142], [89, 64582], [92, 64960], [99, 65535], [102, 65639], [111, 66279], [114, 66539], [118, 66839], [120, 67659], [123, 67819], [126, 67959], [132, 68399], [137, 68719]]}, {"verse": 11, "start": 69646, "end": 78035, "text": "La mujer le dice: Señor, no tienes con qué sacarla, y el pozo es hondo: ¿de dónde, pues, tienes el agua viva?", "words": [[0, 69646], [3, 69734], [9, 70094], [12, 70594], [18, 71306], [25, 72088], [28, 72188], [35, 72628], [39, 72928], [43, 73088], [52, 73808], [54, 73983], [57, 74143], [62, 74463], [65, 74623], [72, 75457], [76, 75645], [83, 75925], [89, 76685], [96, 76945], [99, 77185], [104, 77385]]}, {"verse": 12, "start": 78385, "end": 86197, "text": "¿Eres tú mayor que nuestro padre Jacob, que nos dio este pozo, del cual él bebió, y sus hijos, y sus ganados?", "words": [[0, 78385], [6, 78605], [9, 78845], [15, 79185], [19, 79465], [27, 79665], [33, 80085], [40, 81005], [44, 81045], [48, 81245], [52, 81445], [57, 81705], [63, 82365], [67, 82965], [72, 83265], [75, 83485], [82, 84245], [84, 84525], [88, 84725], [95, 85065], [97, 85325], [101, 85465]]}, {"verse": 13, "start": 86477, "end": 92835, "text": "Respondió Jesús y le dijo: Cualquiera que bebe de esta agua, volverá a tener sed;", "words": [[0, 86477], [10, 87017], [16, 87437], [18, 87857], [21, 87997], [27, 88724], [38, 89454], [42, 89634], [47, 89974], [50, 90114], [55, 90374], [61, 90794], [69, 91814], [71, 91954], [77, 92234]]}, {"verse": 14, "start": 93185, "end": 104086, "text": "Pero el que beba del agua que yo le daré, no tendrá sed jamás; sino que el agua que yo le daré, será en él una fuente de agua que salte para vida eterna.", "words": [[0, 93185], [5, 93350], [8, 93510], [12, 93650], [17, 93950], [21, 94170], [26, 94430], [30, 94610], [33, 94790], [36, 94930], [42, 95390], [45, 95690], [52, 96090], [56, 96390], [63, 97542], [68, 97902], [72, 98142], [75, 98482], [80, 98762], [84, 98982], [87, 99202], [90, 99342], [96, 99782], [101, 100142], [104, 100462], [107, 100622], [111, 100942], [118, 101422], [121, 101602], [126, 101922], [130, 102142], [136, 102702], [141, 102962], [146, 103242]]}, {"verse": 15, "start": 104436, "end": 110661, "text": "La mujer le dice: Señor, dame esta agua, para que no tenga sed, ni venga acá a sacarla.", "words": [[0, 104436], [3, 104525], [9, 104885], [12, 105385], [18, 106097], [25, 106637], [30, 106897], [35, 107197], [41, 107597], [46, 107872], [50, 108012], [53, 108172], [59, 108412], [64, 108752], [67, 109192], [73, 109512], [77, 109792], [79, 109932]]}, {"verse": 16, "start": 110941, "end": 115304, "text": "Jesús le dice: Ve, llama a tu marido, y ven acá.", "words": [[0, 110941], [6, 111315], [9, 111795], [15, 112901], [19, 113201], [25, 113681], [27, 113901], [30, 114021], [38, 114501], [40, 114641], [44, 114741]]}, {"verse": 17, "start": 115654, "end": 123198, "text": "Respondió la mujer, y dijo: No tengo marido. Le dice Jesús: Bien has dicho, No tengo marido;", "words": [[0, 115654], [10, 116498], [13, 116658], [20, 116978], [22, 117178], [28, 117930], [31, 118096], [37, 118376], [45, 119340], [48, 119489], [53, 119709], [60, 120675], [65, 121082], [69, 121202], [76, 122062], [79, 122182], [85, 122482]]}, {"verse": 18, "start": 123548, "end": 130615, "text": "Porque cinco maridos has tenido: y el que ahora tienes no es tu marido; esto has dicho con verdad.", "words": [[0, 123548], [7, 123751], [13, 124091], [21, 124731], [25, 125031], [33, 125958], [35, 126115], [38, 126275], [42, 126475], [48, 126775], [55, 127235], [58, 127615], [61, 127835], [64, 127975], [72, 128905], [77, 129305], [81, 129485], [87, 129745], [91, 130025]]}, {"verse": 19, "start": 130965, "end": 135043, "text": "Le dice la mujer: Señor, me parece que tú eres profeta.", "words": [[0, 130965], [3, 131245], [8, 131505], [11, 131685], [18, 132453], [25, 133189], [28, 133269], [35, 133669], [39, 133869], [42, 134069], [47, 134269]]}, {"verse": 20, "start": 135393, "end": 141692, "text": "Nuestros padres adoraron en este monte, y vosotros decís que en Jerusalén es el lugar donde es necesario adorar.", "words": [[0, 135393], [9, 135801], [16, 136101], [25, 136701], [28, 136841], [33, 137021], [40, 137361], [42, 137841], [51, 138261], [57, 138801], [61, 138941], [64, 139021], [74, 139661], [77, 139881], [80, 140021], [86, 140241], [92, 140501], [95, 140701], [105, 141221]]}, {"verse": 21, "start": 141972, "end": 150198, "text": "Le dice Jesús: Mujer, créeme, que la hora viene, cuando ni en este monte, ni en Jerusalén adoraréis al Padre.", "words": [[0, 141972], [3, 142121], [8, 142341], [15, 143307], [22, 144112], [30, 144592], [34, 145072], [37, 145232], [42, 145432], [49, 145852], [56, 146312], [59, 146592], [62, 146692], [67, 146912], [74, 147232], [77, 147532], [80, 147632], [90, 148372], [100, 149112], [103, 149412]]}, {"verse": 22, "start": 150548, "end": 158310, "text": "Vosotros adoráis lo que no sabéis; nosotros adoramos lo que sabemos: porque la salvación viene de los judíos.", "words": [[0, 150548], [9, 151015], [17, 151775], [20, 152175], [24, 152315], [27, 152455], [35, 153435], [44, 153902], [53, 154542], [56, 154822], [60, 154942], [69, 155814], [76, 156018], [79, 156218], [89, 156838], [95, 157178], [98, 157398], [102, 157518]]}, {"verse": 23, "start": 158660, "end": 171779, "text": "Pero la hora viene, y ahora es, cuando los verdaderos adoradores adorarán al Padre en espíritu y en verdad; porque también el Padre tales adoradores busca que le adoren.", "words": [[0, 158660], [5, 158805], [8, 159005], [13, 159185], [20, 159645], [22, 160205], [28, 160465], [32, 160905], [39, 161425], [43, 161725], [54, 162505], [65, 163205], [74, 164045], [77, 164185], [83, 164805], [86, 165005], [95, 165925], [97, 166085], [100, 166185], [108, 167050], [115, 167252], [123, 167732], [126, 168052], [132, 168732], [138, 168972], [149, 170172], [155, 170632], [159, 170912], [162, 171072]]}, {"verse": 24, "start": 172129, "end": 179320, "text": "Dios es Espíritu; y los que le adoran, en espíritu y en verdad es necesario que adoren.", "words": [[0, 172129], [5, 172492], [8, 172932], [18, 174251], [20, 174355], [24, 174496], [28, 174676], [31, 174816], [39, 175516], [42, 175896], [51, 176676], [53, 176776], [56, 176915], [63, 177236], [66, 177616], [76, 178355], [80, 178596]]}, {"verse": 25, "start": 179670, "end": 188001, "text": "Le dice la mujer: Sé que el Mesías ha de venir, llamado el Cristo: cuando él venga nos declarará todas las cosas.", "words": [[0, 179670], [3, 179950], [8, 180210], [11, 180390], [18, 181159], [21, 181467], [25, 181687], [28, 181907], [35, 182427], [38, 182727], [41, 182847], [48, 183507], [56, 184027], [59, 184307], [67, 185112], [74, 185336], [77, 185556], [83, 186135], [87, 186236], [97, 186836], [103, 187075], [107, 187336]]}, {"verse": 26, "start": 188281, "end": 191432, "text": "Le dice Jesús: Yo soy, que hablo contigo.", "words": [[0, 188281], [3, 188430], [8, 188650], [15, 189616], [18, 189806], [23, 190086], [27, 190366], [33, 190706]]}, {"verse": 27, "start": 191782, "end": 200874, "text": "Y en esto vinieron sus discípulos, y se maravillaron de que hablaba con mujer; pero ninguno dijo: ¿Qué preguntas? o, ¿Qué hablas con ella?", "words": [[0, 191782], [2, 191926], [5, 192026], [10, 192266], [19, 192786], [23, 193046], [35, 193866], [37, 194326], [40, 194486], [53, 195226], [56, 195426], [60, 195546], [68, 195946], [72, 196126], [79, 196873], [84, 197017], [92, 197537], [98, 198342], [103, 198617], [114, 199148], [117, 199568], [122, 199818], [129, 200068], [133, 200368]]}, {"verse": 28, "start": 201224, "end": 206880, "text": "Entonces la mujer dejó su cántaro, y fue a la ciudad, y dijo a aquellos hombres:", "words": [[0, 201224], [9, 202031], [12, 202133], [18, 202413], [23, 202853], [26, 202973], [35, 203593], [37, 204073], [41, 204293], [43, 204493], [46, 204513], [54, 204873], [56, 205238], [61, 205558], [63, 205698], [72, 205938]]}, {"verse": 29, "start": 207080, "end": 211881, "text": "Venid, ved un hombre que me ha dicho todo lo que he hecho: ¿No será este el Cristo?", "words": [[0, 207080], [7, 207563], [11, 208083], [14, 208243], [21, 208443], [25, 208583], [28, 208723], [31, 208823], [37, 209043], [42, 209283], [45, 209503], [49, 209663], [52, 209823], [59, 210559], [63, 210685], [68, 210885], [73, 211165], [76, 211305]]}, {"verse": 30, "start": 212161, "end": 215356, "text": "Entonces salieron de la ciudad, y vinieron a él.", "words": [[0, 212161], [9, 212621], [18, 213521], [21, 213661], [24, 213781], [32, 214101], [34, 214466], [43, 214946], [45, 215146]]}, {"verse": 31, "start": 215706, "end": 220804, "text": "Entre tanto los discípulos le rogaban, diciendo: Rabí, come.", "words": [[0, 215706], [6, 215947], [12, 216347], [16, 216587], [27, 217347], [30, 217747], [39, 218747], [49, 219914], [55, 220114]]}, {"verse": 32, "start": 221084, "end": 226374, "text": "Y él les dijo: Yo tengo una comida que comer, que vosotros no sabéis.", "words": [[0, 221084], [2, 221271], [5, 221391], [9, 221571], [15, 222263], [18, 222451], [24, 222871], [28, 223271], [35, 223711], [39, 223911], [46, 224311], [50, 224596], [59, 225136], [62, 225516]]}, {"verse": 33, "start": 226724, "end": 232453, "text": "Entonces los discípulos decían el uno al otro: ¿Le habrá traído alguien de comer?", "words": [[0, 226724], [9, 227272], [13, 227892], [24, 228672], [31, 229412], [34, 229672], [38, 229932], [41, 230232], [47, 230979], [51, 231099], [57, 231319], [64, 231599], [72, 231859], [75, 232039]]}, {"verse": 34, "start": 232733, "end": 238401, "text": "Les dice Jesús: Mi comida es que haga la voluntad del que me envió, y que acabe su obra.", "words": [[0, 232733], [4, 232920], [9, 233220], [16, 234000], [19, 234105], [26, 234485], [29, 234725], [33, 234905], [38, 235145], [41, 235325], [50, 235641], [54, 235957], [58, 236273], [61, 236589], [68, 236905], [70, 237165], [74, 237305], [80, 237665], [83, 237885]]}, {"verse": 35, "start": 238751, "end": 250092, "text": "¿No decís vosotros: Aun hay cuatro meses hasta que llegue la siega? He aquí os digo: Alzad vuestros ojos, y mirad los campos, porque ya están blancos para la siega.", "words": [[0, 238751], [4, 238979], [10, 239249], [20, 240409], [24, 240709], [28, 240849], [35, 241129], [41, 241589], [47, 242169], [51, 242369], [58, 242669], [61, 243044], [68, 243641], [71, 243731], [76, 243971], [79, 244191], [85, 244898], [91, 245333], [100, 245693], [106, 246033], [108, 246593], [114, 246913], [118, 247053], [126, 247733], [133, 248153], [136, 248413], [142, 248673], [150, 249173], [155, 249373], [158, 249760]]}, {"verse": 36, "start": 250442, "end": 259279, "text": "Y el que siega, recibe salario, y recoge fruto para vida eterna; para que el que siembra también goce, y el que siega.", "words": [[0, 250442], [2, 250724], [5, 250824], [9, 251154], [16, 251484], [23, 252124], [32, 252764], [34, 253331], [41, 253897], [47, 254464], [52, 254744], [57, 254984], [65, 255903], [70, 256064], [74, 256284], [77, 256404], [81, 256564], [89, 257104], [97, 257384], [103, 258084], [105, 258404], [108, 258504], [112, 258919]]}, {"verse": 37, "start": 259629, "end": 264846, "text": "Porque en esto es el dicho verdadero: Que uno es el que siembra, y otro es el que siega.", "words": [[0, 259629], [7, 259873], [10, 260093], [15, 260293], [18, 260473], [21, 260613], [27, 260853], [38, 261880], [42, 261924], [46, 262124], [49, 262304], [52, 262424], [56, 262544], [65, 263356], [67, 263556], [72, 263796], [75, 263996], [78, 264136], [82, 264516]]}, {"verse": 38, "start": 265196, "end": 274504, "text": "Yo os he enviado a segar lo que vosotros no labrasteis: otros labraron, y vosotros habéis entrado en sus labores.", "words": [[0, 265196], [3, 265485], [6, 265765], [9, 266005], [17, 266685], [19, 266965], [25, 267245], [28, 267365], [32, 267505], [41, 268125], [44, 268745], [56, 270261], [62, 270609], [72, 271450], [74, 271890], [83, 272350], [90, 272830], [98, 273390], [101, 273510], [105, 273670]]}, {"verse": 39, "start": 274854, "end": 285241, "text": "Y muchos de los samaritanos de aquella ciudad creyeron en él por la palabra de la mujer, que daba testimonio, diciendo: Que me dijo todo lo que he hecho.", "words": [[0, 274854], [2, 274975], [9, 275415], [12, 275635], [16, 276085], [28, 276535], [31, 276595], [39, 276935], [46, 277375], [55, 278455], [58, 278595], [61, 278735], [65, 278975], [68, 279175], [76, 279555], [79, 279715], [82, 279855], [89, 280615], [93, 280655], [98, 280955], [110, 282075], [120, 283199], [124, 283305], [127, 283445], [132, 283745], [137, 284125], [140, 284405], [144, 284585], [147, 284765]]}, {"verse": 40, "start": 285521, "end": 291959, "text": "Viniendo pues los samaritanos a él, le rogaron que se quedase allí: y se quedó allí dos días.", "words": [[0, 285521], [9, 285984], [14, 286284], [18, 286804], [30, 287324], [32, 287484], [36, 287844], [39, 288264], [47, 288764], [51, 288884], [54, 289024], [62, 289464], [68, 290235], [70, 290342], [73, 290462], [79, 290782], [84, 290962], [88, 291202]]}, {"verse": 41, "start": 292309, "end": 295600, "text": "Y creyeron muchos más por la palabra de él.", "words": [[0, 292309], [2, 292418], [11, 293038], [18, 293498], [22, 293998], [26, 294438], [29, 294598], [37, 294938], [40, 295178]]}, {"verse": 42, "start": 295950, "end": 305270, "text": "Y decían a la mujer: Ya no creemos por tu dicho; porque nosotros mismos hemos oído, y sabemos que verdaderamente este es el Salvador del mundo, el Cristo.", "words": [[0, 295950], [2, 296077], [9, 296617], [11, 296817], [14, 296897], [21, 297644], [24, 297808], [27, 297948], [35, 298348], [39, 298588], [42, 298728], [49, 299328], [56, 299529], [65, 299769], [72, 300209], [78, 300509], [84, 300949], [86, 301429], [94, 301749], [98, 301969], [113, 302749], [118, 303029], [121, 303249], [124, 303329], [133, 303669], [137, 303969], [144, 304589], [147, 304789]]}, {"verse": 43, "start": 305550, "end": 310170, "text": "Y dos días después, salió de allí, y se fue a Galilea.", "words": [[0, 305550], [2, 305671], [6, 305871], [11, 306191], [20, 307471], [26, 307991], [29, 308111], [35, 308431], [37, 308951], [40, 309051], [44, 309251], [46, 309371]]}, {"verse": 44, "start": 310520, "end": 316385, "text": "Porque el mismo Jesús dio testimonio de que el profeta en su tierra no tiene honra.", "words": [[0, 310520], [7, 310901], [10, 311081], [16, 311421], [22, 311981], [26, 312661], [37, 313481], [40, 313601], [44, 313741], [47, 313901], [55, 314441], [58, 314541], [61, 314701], [68, 315041], [71, 315341], [77, 315641]]}, {"verse": 45, "start": 316735, "end": 328076, "text": "Y cuando vino a Galilea, los galileos le recibieron, vistas todas las cosas que había hecho en Jerusalén en el día de la fiesta: porque también ellos habían ido a la fiesta.", "words": [[0, 316735], [2, 316836], [9, 317036], [14, 317336], [16, 317496], [25, 318376], [29, 318636], [38, 319256], [41, 319396], [53, 320156], [60, 320936], [66, 321216], [70, 321516], [76, 321836], [80, 322076], [86, 322316], [92, 322616], [95, 322736], [105, 323456], [108, 323896], [111, 324036], [115, 324236], [118, 324376], [121, 324476], [129, 325272], [136, 325478], [144, 325898], [150, 326398], [157, 326833], [161, 327213], [163, 327353], [166, 327413]]}, {"verse": 46, "start": 328426, "end": 340178, "text": "Vino pues Jesús otra vez a Caná de Galilea, donde había hecho el vino del agua. Y había en Capernaum un funcionario del rey, cuyo hijo estaba enfermo.", "words": [[0, 328426], [5, 328672], [10, 328972], [16, 329492], [21, 330192], [25, 330572], [27, 330852], [32, 331192], [35, 331292], [44, 332332], [50, 332692], [56, 333092], [62, 333372], [65, 333552], [70, 333772], [74, 333992], [80, 334824], [82, 334953], [88, 335213], [91, 335833], [101, 336453], [104, 336733], [116, 337533], [120, 337773], [125, 338513], [130, 338933], [135, 339113], [142, 339413]]}, {"verse": 47, "start": 340528, "end": 351642, "text": "Este, cuando oyó que Jesús venía de Judea a Galilea, fue a él, y le rogaba que descendiese, y sanase a su hijo, porque se comenzaba a morir.", "words": [[0, 340528], [6, 340907], [13, 341227], [17, 341767], [21, 341887], [27, 342267], [33, 342927], [36, 343067], [42, 343667], [44, 343867], [53, 345047], [57, 345127], [59, 345447], [63, 345747], [65, 346227], [68, 346387], [75, 346927], [79, 347107], [92, 348727], [94, 348787], [101, 349247], [103, 349367], [106, 349547], [112, 349787], [119, 350167], [122, 350327], [132, 350987], [134, 351107]]}, {"verse": 48, "start": 351992, "end": 358084, "text": "Entonces Jesús le dijo: Si no veis señales y milagros no creeréis.", "words": [[0, 351992], [9, 352474], [15, 353214], [18, 353674], [24, 354425], [27, 354590], [30, 354750], [35, 355190], [43, 355970], [45, 356150], [54, 356830], [57, 357010]]}, {"verse": 49, "start": 358434, "end": 364667, "text": "El funcionario del rey le dijo: Señor, desciende antes que mi hijo muera.", "words": [[0, 358434], [3, 358601], [15, 359341], [19, 359541], [23, 360041], [26, 360181], [32, 360966], [39, 361292], [49, 361992], [55, 362412], [59, 362672], [62, 362872], [67, 363072]]}, {"verse": 50, "start": 364947, "end": 371881, "text": "Le dice Jesús: Ve, tu hijo vive. Y el hombre creyó a la palabra que Jesús le dijo, y se fue.", "words": [[0, 364947], [3, 365096], [8, 365316], [15, 366529], [19, 366809], [22, 367009], [27, 367249], [33, 368050], [35, 368148], [38, 368248], [45, 368508], [51, 369048], [53, 369168], [56, 369248], [64, 369628], [68, 369848], [74, 370148], [77, 370568], [83, 370868], [85, 371328], [88, 371468]]}, {"verse": 51, "start": 372231, "end": 379934, "text": "Y cuando ya él descendía, los siervos le salieron a recibir, y le dieron nuevas, diciendo: Tu hijo vive.", "words": [[0, 372231], [2, 372336], [9, 372616], [12, 372876], [15, 373076], [26, 374476], [30, 374596], [38, 375196], [41, 375556], [50, 376036], [52, 376196], [61, 376596], [63, 377116], [66, 377236], [73, 377536], [81, 377896], [91, 379109], [94, 379213], [99, 379433]]}, {"verse": 52, "start": 380214, "end": 387694, "text": "Entonces él les preguntó a qué hora comenzó a estar mejor. Y le dijeron: Ayer a las siete le dejó la fiebre.", "words": [[0, 380214], [9, 380839], [12, 381139], [16, 381379], [25, 382099], [27, 382279], [31, 382459], [36, 382839], [44, 383479], [46, 383559], [52, 383739], [59, 384593], [61, 384739], [64, 384799], [73, 385803], [78, 386093], [80, 386213], [84, 386393], [90, 386573], [93, 386793], [98, 387073], [101, 387173]]}, {"verse": 53, "start": 387974, "end": 397093, "text": "El padre entonces entendió, que aquella hora era cuando Jesús le dijo: Tu hijo vive; y creyó él y toda su casa.", "words": [[0, 387974], [3, 388116], [9, 388696], [18, 389156], [28, 390116], [32, 390336], [40, 390736], [45, 391076], [49, 391416], [56, 391676], [62, 392316], [65, 392756], [71, 393502], [74, 393623], [79, 393843], [85, 394624], [87, 394768], [93, 395248], [96, 395668], [98, 396048], [103, 396228], [106, 396488]]}, {"verse": 54, "start": 397443, "end": 402820, "text": "Esta segunda señal volvió Jesús a hacer, cuando vino de Judea a Galilea.", "words": [[0, 397443], [5, 397752], [13, 398192], [19, 398772], [26, 399112], [32, 399412], [34, 399712], [41, 400172], [48, 400672], [53, 401072], [56, 401292], [62, 401852], [64, 402052]]}]}