{"book": "PSA", "chapter": 145, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 132189, "verses": [{"verse": 1, "start": 300, "end": 9123, "text": "Salmo de alabanza: de David. TE ENSALZARÉ, mi Dios, mi Rey; y bendeciré tu nombre por siglo y para siempre.", "words": [[0, 300], [6, 787], [9, 947], [19, 2071], [22, 2275], [29, 3177], [32, 3319], [43, 4079], [46, 4299], [52, 4939], [55, 5039], [60, 5864], [62, 5979], [72, 6719], [75, 6859], [82, 7179], [86, 7439], [92, 7919], [94, 8119], [99, 8299]]}, {"verse": 2, "start": 9573, "end": 14689, "text": "Cada día te bendeciré, y alabaré tu nombre por siglo y para siempre.", "words": [[0, 9573], [5, 9850], [9, 10150], [12, 10330], [23, 11170], [25, 11550], [33, 12030], [36, 12210], [43, 12590], [47, 12870], [53, 13410], [55, 13650], [60, 13850]]}, {"verse": 3, "start": 15139, "end": 21213, "text": "Grande es Jehová y digno de suprema alabanza: y su grandeza es inescrutable.", "words": [[0, 15139], [7, 15544], [10, 15924], [17, 16304], [19, 16484], [25, 17004], [28, 17274], [36, 17544], [46, 18702], [48, 18826], [51, 18986], [60, 19686], [63, 20476]]}, {"verse": 4, "start": 21663, "end": 27895, "text": "Generación a generación narrará tus obras, y anunciarán tus poderosos hechos.", "words": [[0, 21663], [11, 22419], [13, 22639], [24, 23419], [32, 24159], [36, 24379], [43, 24839], [45, 25359], [56, 26079], [60, 26299], [70, 27199]]}, {"verse": 5, "start": 28345, "end": 33243, "text": "La hermosura de la gloria de tu magnificencia, y tus hechos maravillosos, hablaré.", "words": [[0, 28345], [3, 28462], [13, 29222], [16, 29382], [19, 29522], [26, 29902], [29, 30022], [32, 30162], [47, 31142], [49, 31242], [53, 31442], [60, 31722], [74, 32522]]}, {"verse": 6, "start": 33693, "end": 38729, "text": "Y lo temible de tus proezas dirán los hombres; y yo contaré tu grandeza.", "words": [[0, 33693], [2, 33936], [5, 34056], [13, 34556], [16, 34716], [20, 35076], [28, 35436], [34, 35896], [38, 36056], [47, 37018], [49, 37139], [52, 37279], [60, 37799], [63, 37899]]}, {"verse": 7, "start": 39179, "end": 45019, "text": "Publicarán la memoria de la muchedumbre de tu bondad, y cantarán tu justicia.", "words": [[0, 39179], [11, 39905], [14, 40065], [22, 40625], [25, 40785], [28, 40925], [40, 41645], [43, 41785], [46, 41945], [54, 42625], [56, 43225], [65, 43905], [68, 44065]]}, {"verse": 8, "start": 45469, "end": 51654, "text": "Clemente y misericordioso es Jehová, lento para la ira, y grande en misericordia.", "words": [[0, 45469], [9, 46053], [11, 46173], [26, 47113], [29, 47393], [37, 48293], [43, 48633], [48, 48913], [51, 49113], [56, 49533], [58, 49913], [65, 50333], [68, 50573]]}, {"verse": 9, "start": 52104, "end": 57826, "text": "Bueno es Jehová para con todos; y sus misericordias sobre todas sus obras.", "words": [[0, 52104], [6, 52451], [9, 52661], [16, 52871], [21, 53071], [25, 53291], [32, 54304], [34, 54430], [38, 54590], [52, 55890], [58, 56490], [64, 56830], [68, 57130]]}, {"verse": 10, "start": 58276, "end": 63698, "text": "Alábente, oh Jehová, todas tus obras; y tus santos te bendigan.", "words": [[0, 58616], [10, 58991], [13, 59366], [21, 59741], [27, 60501], [31, 60821], [38, 61861], [40, 61966], [44, 62106], [51, 62746], [54, 63235]]}, {"verse": 11, "start": 64148, "end": 68786, "text": "La gloria de tu reino digan, y hablen de tu fortaleza;", "words": [[0, 64148], [3, 64398], [10, 64838], [13, 64998], [16, 65158], [22, 65598], [29, 66018], [31, 66378], [38, 66798], [41, 66978], [44, 67138]]}, {"verse": 12, "start": 69236, "end": 76181, "text": "Para notificar a los hijos de los hombres sus valentías, y la gloria de la magnificencia de su reino.", "words": [[0, 69236], [5, 69435], [15, 70095], [17, 70275], [21, 70435], [27, 70715], [30, 70915], [34, 71035], [42, 71395], [46, 71675], [57, 72575], [59, 73215], [62, 73375], [69, 73855], [72, 74015], [75, 74175], [89, 75215], [92, 75375], [95, 75535]]}, {"verse": 13, "start": 76631, "end": 83894, "t