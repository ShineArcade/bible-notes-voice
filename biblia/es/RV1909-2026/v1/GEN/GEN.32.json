{"book": "GEN", "chapter": 32, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 271388, "verses": [{"verse": 1, "start": 300, "end": 5465, "text": "Y Jacob se fue su camino, y le salieron al encuentro ángeles de Dios.", "words": [[0, 519], [2, 773], [8, 1026], [11, 1106], [15, 1326], [18, 1506], [26, 2006], [28, 2746], [31, 2866], [40, 3426], [43, 3606], [53, 4206], [61, 4686], [64, 4866]]}, {"verse": 2, "start": 5915, "end": 14006, "text": "Y dijo Jacob cuando los vio: El campo de Dios es este: y llamó el nombre de aquel lugar Mahanaim.", "words": [[0, 5915], [2, 6060], [7, 6340], [13, 6760], [20, 7200], [24, 7640], [29, 8292], [32, 8410], [38, 8730], [41, 8930], [46, 9210], [49, 9610], [55, 10599], [57, 10706], [63, 11066], [66, 11166], [73, 11526], [76, 11746], [82, 12126], [88, 12406]]}, {"verse": 3, "start": 14456, "end": 21719, "text": "Y envió Jacob mensajeros delante de sí a Esaú su hermano, a la tierra de Seir, campo de Edom.", "words": [[0, 14456], [2, 14600], [8, 14980], [14, 15680], [25, 16380], [33, 16880], [36, 17060], [39, 17500], [41, 17800], [46, 18100], [49, 18220], [58, 19020], [60, 19120], [63, 19200], [70, 19540], [73, 20010], [79, 20480], [85, 20880], [88, 21140]]}, {"verse": 4, "start": 22169, "end": 30533, "text": "Y les mandó diciendo: Así diréis a mi señor Esaú: Así dice tu siervo Jacob: Con Labán he morado, y me he detenido hasta ahora;", "words": [[0, 22169], [2, 22456], [6, 22596], [12, 23036], [22, 24090], [26, 24272], [33, 24672], [35, 24941], [38, 25211], [44, 25481], [50, 26000], [54, 26181], [59, 26461], [62, 26621], [69, 27086], [76, 27884], [80, 28014], [86, 28144], [89, 28274], [97, 28734], [99, 29074], [102, 29254], [105, 29334], [114, 29834], [120, 30074]]}, {"verse": 5, "start": 30983, "end": 38340, "text": "Y tengo vacas, y asnos, y ovejas, y siervos y siervas; y envío a decirlo a mi señor, por hallar gracia en tus ojos.", "words": [[0, 30983], [2, 31073], [8, 31293], [15, 31773], [17, 31913], [24, 32293], [26, 32513], [34, 32953], [36, 33153], [44, 33553], [46, 33733], [55, 34687], [57, 34789], [63, 35169], [65, 35269], [73, 35769], [75, 35869], [78, 35969], [85, 36689], [89, 36829], [96, 37109], [103, 37509], [106, 37589], [110, 37709]]}, {"verse": 6, "start": 38690, "end": 47760, "text": "Y los mensajeros volvieron a Jacob, diciendo: Vinimos a tu hermano Esaú, y él también viene a recibirte, y cuatrocientos hombres con él.", "words": [[0, 38690], [2, 38794], [6, 38894], [17, 39474], [27, 40014], [29, 40234], [36, 40634], [46, 42273], [54, 42691], [56, 42831], [59, 42931], [67, 43331], [73, 43751], [75, 44271], [78, 44411], [86, 44711], [92, 45051], [94, 45211], [105, 45851], [107, 46141], [121, 46431], [129, 47151], [133, 47491]]}, {"verse": 7, "start": 48110, "end": 58842, "text": "Entonces Jacob tuvo gran temor, y se angustió; y partió el pueblo que tenía consigo, y las ovejas y las vacas y los camellos, en dos cuadrillas;", "words": [[0, 48110], [9, 49262], [15, 49682], [20, 50102], [25, 50482], [32, 50902], [34, 51102], [37, 51242], [47, 52383], [49, 52493], [56, 52893], [59, 53033], [66, 53373], [70, 53673], [76, 54013], [85, 54633], [87, 55193], [91, 55333], [98, 55893], [100, 56153], [104, 56293], [110, 56713], [112, 56833], [116, 56973], [126, 57593], [129, 57773], [133, 57973]]}, {"verse": 8, "start": 59292, "end": 64770, "text": "Y dijo: Si viene Esaú contra un campamento y lo ataca, el otro campamento escapará.", "words": [[0, 59292], [2, 59435], [8, 60204], [11, 60440], [17, 60680], [22, 60920], [29, 61180], [32, 61380], [43, 61980], [45, 62100], [48, 62200], [55, 63040], [58, 63140], [63, 63320], [74, 64000]]}, {"verse": 9, "start": 65120, "end": 74640, "text": "Y dijo Jacob: Dios de mi padre Abraham, y Dios de mi padre Isaac, Jehová, que me dijiste: Vuélvete a tu tierra y a tu parentela, y yo te haré bien;", "words": [[0, 65120], [2, 65248], [7, 65488], [14, 66302], [19, 66524], [22, 66704], [25, 66804], [31, 67184], [40, 67564], [42, 68264], [47, 68464], [50, 68624], [53, 68724], [59, 69124], [66, 69764], [74, 70364], [78, 70424], [81, 70544], [90, 71462], [99, 71947], [101, 72047], [104, 72167], [111, 72467], [113, 72687], [115, 72767], [118, 72867], [129, 73467], [131, 73867], [134, 73987], [137, 74107], [142, 74327]]}, {"verse": 10, "start": 75090, "end": 85143, "text": "Menor soy que todas las misericordias, y que toda la verdad que has usado para con tu siervo; que con mi bastón pasé este Jordán, y ahora estoy sobre dos cuadrillas.", "words": [[0, 75090], [6, 75329], [10, 75609], [14, 75769], [20, 75989], [24, 76229], [39, 77169], [41, 77589], [45, 77709], [50, 77969], [53, 78149], [60, 78409], [64, 78729], [68, 78829], [74, 79209], [79, 79449], [83, 79689], [86, 79809], [94, 80657], [98, 80754], [102, 80934], [105, 81094], [112, 81514], [117, 81914], [122, 82094], [130, 82534], [132, 83074], [138, 83374], [144, 83714], [150, 84034], [154, 84294]]}, {"verse": 11, "start": 85593, "end": 94480, "text": "Líbrame ahora de la mano de mi hermano, de la mano de Esaú, porque le temo; no venga quizá, y me hiera la madre con los hijos.", "words": [[0, 85593], [8, 86018], [14, 86238], [17, 86418], [20, 86538], [25, 86758], [28, 86918], [31, 87038], [40, 87778], [43, 87858], [46, 87958], [51, 88158], [54, 88558], [60, 88958], [67, 89117], [70, 89298], [76, 91426], [79, 91426], [85, 91426], [92, 91426], [94, 91529], [97, 91649], [103, 91909], [106, 92009], [112, 92269], [116, 92469], [120, 92669]]}, {"verse": 12, "start": 94930, "end": 102161, "text": "Y tú has dicho: Yo te haré bien, y pondré tu simiente como la arena del mar, que no se puede contar por la multitud.", "words": [[0, 95240], [2, 95578], [5, 95916], [9, 96254], [16, 96892], [19, 97036], [22, 97196], [27, 97436], [33, 97656], [35, 98016], [42, 98416], [45, 98576], [54, 99096], [59, 99376], [62, 99556], [68, 99796], [72, 99996], [77, 100196], [81, 100416], [84, 100556], [87, 100716], [93, 100916], [100, 101256], [104, 101476], [107, 101616]]}, {"verse": 13, "start": 102511, "end": 109961, "text": "Y durmió allí aquella noche, y tomó de lo que le vino a la mano un presente para su hermano Esaú:", "words": [[0, 102511], [2, 102635], [9, 103135], [14, 103415], [22, 103875], [29, 104235], [31, 104875], [36, 105295], [39, 105375], [42, 105515], [46, 105655], [49, 105775], [54, 106035], [56, 106215], [59, 106295], [64, 106535], [67, 106695], [76, 107075], [81, 107535], [84, 107735], [92, 108870]]}, {"verse": 14, "start": 110411, "end": 115899, "text": "Doscientas cabras y veinte machos cabríos, doscientas ovejas y veinte carneros,", "words": [[0, 110411], [11, 110411], [18, 110953], [20, 111413], [27, 111793], [34, 112533], [43, 113273], [54, 113933], [61, 114453], [63, 114733], [70, 115053]]}, {"verse": 15, "start": 116349, "end": 122655, "text": "Treinta camellas paridas, con sus hijos, cuarenta vacas y diez novillos, veinte asnas y diez borricos.", "words": [[0, 116635], [8, 116955], [17, 117275], [26, 117695], [30, 117915], [34, 118135], [41, 118715], [50, 119295], [56, 119815], [58, 119975], [63, 120135], [73, 120695], [80, 121255], [86, 121915], [88, 122183], [93, 122450]]}, {"verse": 16, "start": 123105, "end": 134720, "text": "Y lo entregó en mano de sus siervos, cada manada de por sí; y dijo a sus siervos: Pasad delante de mí, y poned espacio entre manada y manada.", "words": [[0, 123571], [2, 123831], [5, 123931], [13, 124411], [16, 124511], [21, 124731], [24, 124891], [28, 125381], [37, 125871], [42, 126191], [49, 126691], [52, 126871], [56, 127071], [60, 127767], [62, 127942], [67, 128152], [69, 128312], [73, 128452], [82, 129640], [88, 129800], [96, 130260], [99, 130420], [103, 130580], [105, 131007], [111, 131433], [119, 131860], [125, 132080], [132, 132520], [134, 132720]]}, {"verse": 17, "start": 135070, "end": 147108, "text": "Y mandó al primero, diciendo: Si Esaú mi hermano te encuentra, y te pregunta, diciendo: ¿De quién eres? ¿y adónde vas? ¿y para quién es esto que llevas delante de ti?", "words": [[0, 135070], [2, 135211], [8, 135491], [11, 135771], [20, 136171], [30, 138359], [33, 138578], [38, 138832], [41, 139085], [49, 139465], [52, 139565], [63, 140025], [65, 140185], [68, 140305], [78, 140825], [88, 142198], [92, 142356], [98, 142556], [104, 143395], [107, 143573], [114, 143853], [119, 144627], [122, 144708], [127, 144888], [133, 145128], [136, 145348], [141, 145648], [145, 145788], [152, 146148], [160, 146568], [163, 146748]]}, {"verse": 18, "start": 147558, "end": 155025, "text": "Entonces dirás: Es un regalo de tu siervo Jacob, que envía a mi señor Esaú; y he aquí también él viene tras nosotros.", "words": [[0, 147558], [9, 147993], [16, 149014], [19, 149139], [22, 149259], [29, 149659], [32, 149779], [35, 149919], [42, 150339], [49, 150659], [53, 150999], [59, 151359], [61, 151439], [64, 151519], [70, 151839], [76, 152710], [78, 152761], [81, 152851], [86, 153071], [94, 153411], [97, 153771], [103, 153991], [108, 154271]]}, {"verse": 19, "start": 155375, "end": 166617, "text": "Y mandó también al segundo, y al tercero, y a todos los que iban tras aquellas manadas, diciendo: Conforme a esto hablaréis a Esaú, cuando lo encontréis.", "words": [[0, 155375], [2, 155538], [8, 155898], [16, 156318], [19, 156638], [28, 157238], [30, 158038], [33, 158218], [42, 159138], [44, 159418], [46, 159498], [52, 159818], [56, 160138], [60, 160358], [65, 160698], [70, 160898], [79, 161458], [88, 161978], [98, 163595], [107, 163957], [109, 164097], [114, 164337], [124, 164857], [126, 164997], [132, 165297], [139, 165657], [142, 165857]]}, {"verse": 20, "start": 167067, "end": 178719, "text": "Y diréis también: He aquí tu siervo Jacob viene tras nosotros. Porque dijo: Apaciguaré su ira con el regalo que va delante de mí, y después veré su rostro: quizá me reciba bien.", "words": [[0, 167067], [2, 167167], [9, 167487], [18, 168462], [21, 168542], [26, 168742], [29, 168942], [36, 169302], [42, 169602], [48, 170002], [53, 170282], [63, 171480], [70, 171650], [76, 172740], [87, 173060], [90, 173200], [94, 173480], [98, 173640], [101, 173780], [108, 174160], [112, 174300], [115, 174440], [123, 174860], [126, 175020], [130, 175220], [132, 175680], [140, 175980], [145, 176440], [148, 176520], [156, 177409], [162, 177793], [165, 177893], [172, 178353]]}, {"verse": 21, "start": 179069, "end": 185367, "text": "Y pasó el presente delante de él; y él durmió aquella noche en el campamento.", "words": [[0, 179069], [2, 179218], [7, 179638], [10, 179998], [19, 180558], [27, 181238], [30, 181438], [34, 182234], [36, 182657], [39, 182777], [46, 183237], [54, 183697], [60, 184157], [63, 184297], [66, 184417]]}, {"verse": 22, "start": 185817, "end": 194700, "text": "Y se levantó aquella noche, y tomó sus dos mujeres, y sus dos siervas, y sus once hijos, y pasó el vado de Jaboc.", "words": [[0, 185817], [2, 185941], [5, 186061], [13, 186641], [21, 186981], [28, 187961], [30, 188301], [35, 188641], [39, 188821], [43, 189001], [52, 189481], [54, 189821], [58, 189961], [62, 190181], [71, 190801], [73, 191181], [77, 191341], [82, 191801], [89, 192201], [91, 192861], [96, 193221], [99, 193621], [104, 193981], [107, 194373]]}, {"verse": 23, "start": 195150, "end": 200173, "text": "Los tomó pues, y los hizo pasar el arroyo, e hizo pasar lo que tenía.", "words": [[0, 195150], [4, 195298], [9, 195658], [15, 196078], [17, 196418], [21, 196598], [26, 196898], [32, 197278], [35, 197498], [43, 198418], [45, 198598], [50, 198838], [56, 199118], [59, 199378], [63, 199518]]}, {"verse": 24, "start": 200623, "end": 205742, "text": "Y se quedó Jacob solo, y luchó con él un varón hasta que rayaba el alba.", "words": [[0, 200623], [2, 200769], [5, 200849], [11, 201189], [17, 201469], [23, 201989], [25, 202569], [31, 202969], [35, 203149], [38, 203329], [41, 203549], [47, 204049], [53, 204309], [57, 204489], [64, 204989], [67, 205149]]}, {"verse": 25, "start": 206192, "end": 215060, "text": "Y cuando vio que no podía con él, tocó en la coyuntura de su cadera, y se dislocó la cadera de Jacob mientras con él luchaba.", "words": [[0, 206192], [2, 206317], [9, 206557], [13, 206937], [17, 207097], [20, 207257], [26, 207637], [30, 207917], [34, 208517], [39, 208857], [42, 209017], [45, 209157], [55, 209797], [58, 209957], [61, 210117], [69, 210597], [71, 211077], [74, 211557], [82, 212037], [85, 212177], [92, 212597], [95, 212717], [101, 213117], [110, 213717], [114, 214137], [117, 214277]]}, {"verse": 26, "start": 215510, "end": 221216, "text": "Y dijo: Déjame, que raya el alba. Y él dijo: No te dejaré, si no me bendices.", "words": [[0, 215510], [2, 215654], [8, 216447], [16, 216825], [20, 217005], [25, 217405], [28, 217525], [34, 218273], [36, 218462], [39, 218622], [45, 219390], [48, 219572], [51, 219732], [59, 220172], [62, 220292], [65, 220372], [68, 220492]]}, {"verse": 27, "start": 221566, "end": 225939, "text": "Y él le dijo: ¿Cuál es tu nombre? Y él respondió: Jacob.", "words": [[0, 221566], [2, 221733], [5, 221873], [8, 222033], [14, 222808], [20, 223008], [23, 223148], [26, 223268], [34, 224115], [36, 224297], [39, 224437], [50, 225719]]}, {"verse": 28, "start": 226289, "end": 233834, "text": "Y él dijo: No se dirá más tu nombre Jacob, sino Israel: porque has peleado con Dios y con los hombres, y has vencido.", "words": [[0, 226289], [2, 226478], [5, 226638], [11, 227406], [14, 227544], [17, 227664], [22, 227964], [26, 228084], [29, 228304], [36, 228664], [43, 229384], [48, 229544], [56, 230542], [63, 230721], [67, 230901], [75, 231381], [79, 231581], [84, 231821], [86, 232061], [90, 232201], [94, 232341], [103, 232721], [105, 233021], [109, 233181]]}, {"verse": 29, "start": 234184, "end": 243206, "text": "Entonces Jacob le preguntó, y dijo: Dime ahora tu nombre. Y él respondió: ¿Por qué preguntas por mi nombre? Y lo bendijo allí.", "words": [[0, 234184], [9, 234929], [15, 235189], [18, 235549], [28, 236189], [30, 236369], [36, 237080], [41, 237338], [47, 237558], [50, 237758], [58, 238615], [60, 238797], [63, 238937], [74, 239982], [79, 240142], [83, 240262], [93, 240703], [97, 241022], [100, 241162], [108, 241975], [110, 242085], [113, 242225], [121, 242725]]}, {"verse": 30, "start": 243656, "end": 251110, "text": "Y llamó Jacob el nombre de aquel lugar, Peniel: porque vi a Dios cara a cara, y fue librada mi alma.", "words": [[0, 243656], [2, 243764], [8, 244124], [14, 244344], [17, 244684], [24, 245024], [27, 245244], [33, 245604], [40, 246304], [48, 247287], [55, 248202], [58, 248399], [60, 248539], [65, 248759], [70, 249059], [72, 249219], [78, 249479], [80, 249959], [84, 250139], [92, 250539], [95, 250699]]}, {"verse": 31, "start": 251460, "end": 256514, "text": "Y le salió el sol después que hubo pasado Peniel; y cojeaba de su cadera.", "words": [[0, 251460], [2, 251586], [5, 251686], [11, 252086], [14, 252266], [18, 252486], [26, 252906], [30, 253146], [35, 253366], [42, 253706], [50, 254652], [52, 255110], [60, 255570], [63, 255730], [66, 255870]]}, {"verse": 32, "start": 256964, "end": 270988, "text": "Por esto no comen los hijos de Israel, hasta hoy día, del tendón que se contrajo, el cual está en el encaje del muslo: porque tocó a Jacob este sitio de su muslo en el tendón que se contrajo.", "words": [[0, 256964], [4, 257108], [9, 257328], [12, 257568], [18, 257888], [22, 258128], [28, 258468], [31, 258628], [39, 259188], [45, 259668], [49, 260028], [54, 260548], [58, 261188], [65, 261708], [69, 261828], [72, 261988], [82, 262728], [85, 263388], [90, 263628], [95, 264068], [98, 264328], [101, 264488], [108, 265128], [112, 265288], [119, 266287], [126, 266470], [131, 266990], [133, 267090], [139, 267430], [144, 267830], [150, 268270], [153, 268450], [156, 268610], [162, 269110], [165, 269350], [168, 269490], [175, 269910], [179, 270070], [182, 270190]]}]}