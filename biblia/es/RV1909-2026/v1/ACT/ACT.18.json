{"book": "ACT", "chapter": 18, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 254998, "verses": [{"verse": 1, "start": 300, "end": 4510, "text": "Pasadas estas cosas, Pablo salió de Atenas, y vino a Corinto.", "words": [[0, 300], [8, 708], [14, 948], [21, 1288], [27, 1768], [33, 2188], [36, 2328], [44, 2868], [46, 3288], [51, 3548], [53, 3748]]}, {"verse": 2, "start": 4860, "end": 19699, "text": "Y hallando a un judío llamado Aquila, natural del Ponto, que hacía poco que había venido de Italia, y a Priscila su mujer, (porque Claudio había mandado que todos los judíos saliesen de Roma) se vino a ellos;", "words": [[0, 4860], [2, 5120], [11, 5600], [13, 5840], [16, 6020], [22, 6500], [30, 6760], [38, 7760], [46, 8220], [50, 8480], [57, 9440], [61, 9520], [67, 9780], [72, 10220], [76, 10520], [82, 10720], [89, 11140], [92, 11320], [100, 12320], [102, 12720], [104, 13120], [113, 13520], [116, 13760], [123, 14537], [131, 14937], [139, 15377], [145, 15577], [153, 16157], [157, 16317], [163, 16597], [167, 16837], [174, 17317], [183, 17757], [186, 17997], [192, 18529], [195, 18672], [200, 18892], [202, 19072]]}, {"verse": 3, "start": 20049, "end": 28249, "text": "Y porque era del mismo oficio, se alojó con ellos, y trabajaba; porque el oficio de ellos era hacer tiendas.", "words": [[0, 20049], [2, 20134], [9, 20374], [13, 20734], [17, 20914], [23, 21274], [31, 22334], [34, 22574], [40, 23094], [44, 23314], [51, 23554], [53, 23914], [64, 24994], [71, 25240], [74, 25460], [81, 25900], [84, 26160], [90, 26420], [94, 26680], [100, 27493]]}, {"verse": 4, "start": 28599, "end": 34133, "text": "Y disputaba en la sinagoga todos los sábados, y persuadía a judíos y a griegos.", "words": [[0, 28599], [2, 28724], [12, 29264], [15, 29404], [18, 29504], [27, 30084], [33, 30324], [37, 30664], [46, 31324], [48, 31684], [58, 32444], [60, 32664], [67, 33224], [69, 33364], [71, 33504]]}, {"verse": 5, "start": 34483, "end": 44165, "text": "Y cuando Silas y Timoteo vinieron de Macedonia, Pablo se dedicaba por completo a la palabra, testificando a los judíos que Jesús era el Cristo.", "words": [[0, 34483], [2, 34560], [9, 34935], [15, 35310], [17, 35685], [25, 36060], [34, 36480], [37, 36640], [48, 37640], [54, 38260], [57, 38500], [66, 39120], [70, 39360], [79, 39960], [81, 40160], [84, 40240], [93, 41060], [106, 41820], [108, 41940], [112, 42060], [119, 42540], [123, 42660], [129, 42960], [133, 43380], [136, 43540]]}, {"verse": 6, "start": 44515, "end": 56134, "text": "Pero contradiciendo y blasfemando ellos, les dijo, sacudiendo sus vestidos: Vuestra sangre sea sobre vuestra cabeza; yo, limpio; desde ahora me iré a los Gentiles.", "words": [[0, 44515], [5, 44698], [20, 45758], [22, 45898], [34, 46718], [41, 47638], [45, 47918], [51, 48698], [62, 49438], [66, 49638], [76, 50625], [84, 50985], [91, 51325], [95, 51665], [101, 51945], [109, 52325], [117, 53125], [121, 53370], [129, 54296], [135, 54444], [141, 54804], [144, 55044], [148, 55304], [150, 55364], [154, 55484]]}, {"verse": 7, "start": 56414, "end": 65342, "text": "Y partiendo de allí, entró en casa de uno llamado Justo, temeroso de Dios, la casa del cual estaba junto a la sinagoga.", "words": [[0, 56414], [2, 56537], [12, 57117], [15, 57317], [21, 58117], [27, 58697], [30, 58817], [35, 59097], [38, 59377], [42, 59557], [50, 59877], [57, 61157], [66, 61657], [69, 61857], [75, 62557], [78, 62637], [83, 62917], [87, 63137], [92, 63377], [99, 63757], [105, 64117], [107, 64337], [110, 64417]]}, {"verse": 8, "start": 65692, "end": 75941, "text": "Y Crispo, el dirigente de la sinagoga, creyó al Señor con toda su casa: y muchos de los Corintios oyendo creían, y eran bautizados.", "words": [[0, 65692], [2, 65852], [10, 66672], [13, 67032], [23, 67672], [26, 67812], [29, 67952], [39, 69012], [45, 69452], [48, 69732], [54, 70072], [58, 70412], [63, 70732], [66, 70992], [72, 71811], [74, 71991], [81, 72311], [84, 72531], [88, 72631], [98, 73231], [105, 73691], [113, 74331], [115, 74611], [120, 74811]]}, {"verse": 9, "start": 76291, "end": 82524, "text": "Entonces el Señor dijo de noche en visión a Pablo: No temas, sino habla, y no calles:", "words": [[0, 76291], [9, 76772], [12, 77132], [18, 77452], [23, 77812], [26, 77992], [32, 78252], [35, 78472], [42, 78872], [44, 78992], [51, 79730], [54, 79899], [61, 80279], [66, 80819], [73, 81399], [75, 81654], [78, 82121]]}, {"verse": 10, "start": 82874, "end": 89252, "text": "Porque yo estoy contigo, y ninguno te podrá hacer mal; porque yo tengo mucho pueblo en esta ciudad.", "words": [[0, 82874], [7, 83061], [10, 83261], [16, 83481], [25, 84221], [27, 84641], [35, 85181], [38, 85361], [44, 85801], [50, 86021], [55, 86789], [62, 86953], [65, 87133], [71, 87393], [77, 87713], [84, 88193], [87, 88393], [92, 88573]]}, {"verse": 11, "start": 89602, "end": 95012, "text": "Y permaneció allí un año y seis meses, enseñándoles la palabra de Dios.", "words": [[0, 89602], [2, 89728], [13, 90488], [18, 90748], [21, 91028], [25, 91268], [27, 91428], [32, 91628], [39, 92168], [52, 93323], [55, 93783], [63, 94163], [66, 94403]]}, {"verse": 12, "start": 95362, "end": 103975, "text": "Y siendo Galión procónsul de Acaya, los judíos se levantaron de común acuerdo contra Pablo, y le llevaron al tribunal,", "words": [[0, 95362], [2, 95658], [9, 96118], [16, 96578], [26, 97378], [29, 97538], [36, 98558], [40, 98698], [47, 99238], [50, 99398], [61, 99998], [64, 100198], [70, 100478], [78, 100958], [85, 101418], [92, 101938], [94, 102258], [97, 102578], [106, 103058], [109, 103178]]}, {"verse": 13, "start": 104325, "end": 108715, "text": "Diciendo: Que este persuade a los hombres a honrar a Dios contra la ley.", "words": [[0, 104325], [10, 105375], [14, 105496], [19, 105736], [28, 106296], [30, 106416], [34, 106536], [42, 106836], [44, 107096], [51, 107416], [53, 107536], [58, 107756], [65, 108136], [68, 108336]]}, {"verse": 14, "start": 108995, "end": 118871, "text": "Y comenzando Pablo a abrir la boca, Galión dijo a los judíos: Si fuera algún agravio o algún crimen enorme, oh judíos, conforme a derecho yo os tolerara:", "words": [[0, 108995], [2, 109103], [13, 109783], [19, 110013], [21, 110243], [27, 110543], [30, 110743], [36, 111283], [43, 111963], [48, 112663], [50, 112843], [54, 112963], [62, 113851], [65, 113972], [71, 114212], [77, 114452], [85, 114932], [87, 115032], [93, 115252], [100, 115612], [108, 116082], [111, 116552], [119, 117072], [128, 117572], [130, 117612], [138, 117912], [141, 118112], [144, 118272]]}, {"verse": 15, "start": 119221, "end": 126680, "text": "Pero si son cuestiones de palabras, y de nombres, y de vuestra ley, vedlo vosotros; porque yo no quiero ser juez de estas cosas.", "words": [[0, 119221], [5, 119345], [8, 119485], [12, 119665], [23, 120125], [26, 120265], [36, 120685], [38, 121045], [41, 121125], [50, 121525], [52, 121865], [55, 121965], [63, 122305], [68, 122715], [74, 123125], [84, 123925], [91, 124132], [94, 124352], [97, 124492], [104, 124792], [108, 125092], [113, 125572], [116, 125692], [122, 125892]]}, {"verse": 16, "start": 126960, "end": 128611, "text": "Y los echó del tribunal.", "words": [[0, 126960], [2, 127081], [6, 127221], [11, 127661], [15, 127761]]}, {"verse": 17, "start": 128961, "end": 140134, "text": "Entonces todos los griegos tomando a Sóstenes, dirigente de la sinagoga, le herían delante del tribunal: y a Galión nada de ello le importaba.", "words": [[0, 128961], [9, 129822], [15, 130262], [19, 130582], [27, 131022], [35, 131469], [37, 131915], [47, 132362], [57, 133202], [60, 133382], [63, 133502], [73, 134222], [76, 134742], [83, 135362], [91, 135942], [95, 136202], [105, 137252], [107, 137433], [109, 137553], [116, 137933], [121, 138473], [124, 138793], [129, 139033], [132, 139233]]}, {"verse": 18, "start": 140484, "end": 156365, "text": "Pero Pablo habiendo permanecido aún allí muchos días, después se despidió de los hermanos, y navegó a Siria, y con él Priscila y Aquila, habiéndose cortado el cabello de la cabeza en Cencrea, porque tenía voto.", "words": [[0, 140484], [5, 140729], [11, 141624], [20, 142164], [32, 143064], [36, 143284], [41, 143544], [48, 143844], [54, 145224], [62, 145224], [65, 145764], [74, 146304], [77, 146424], [81, 146544], [91, 147364], [93, 147684], [100, 148164], [102, 148324], [109, 148844], [111, 149464], [115, 149684], [118, 150084], [127, 150484], [129, 150664], [137, 151605], [148, 152145], [156, 152765], [159, 152885], [167, 153365], [170, 153505], [173, 153645], [180, 154159], [183, 154673], [192, 155188], [199, 155360], [205, 155720]]}, {"verse": 19, "start": 156715, "end": 164130, "text": "Y llegó a Éfeso, y los dejó allí: y él entrando en la sinagoga, disputó con los judíos,", "words": [[0, 156715], [2, 157124], [8, 157569], [10, 158014], [17, 158459], [19, 158619], [23, 158779], [28, 159196], [34, 159766], [36, 160130], [39, 160390], [48, 161030], [51, 161190], [54, 161330], [64, 162350], [72, 163010], [76, 163190], [80, 163350]]}, {"verse": 20, "start": 164480, "end": 169487, "text": "Los cuales le rogaban que se quedase con ellos por más tiempo; pero no accedió,", "words": [[0, 164480], [4, 164599], [11, 164879], [14, 165299], [22, 165879], [26, 166079], [29, 166239], [37, 166679], [41, 166939], [47, 167179], [51, 167419], [55, 167599], [63, 168425], [68, 168590], [71, 168790]]}, {"verse": 21, "start": 169837, "end": 180419, "text": "Sino que se despidió de ellos, diciendo: Es necesario que en todo caso tenga la fiesta que viene, en Jerusalén; pero otra vez volveré a vosotros, queriendo Dios. Y partió de Éfeso.", "words": [[0, 169837], [5, 170157], [9, 170357], [12, 170517], [21, 171137], [24, 171277], [31, 171637], [41, 172070], [44, 172192], [54, 172772], [58, 173012], [61, 173132], [66, 173312], [71, 173612], [77, 173952], [80, 174132], [87, 174512], [91, 174672], [98, 174952], [101, 175212], [112, 176140], [117, 176281], [122, 176501], [126, 176741], [134, 177221], [136, 177221], [146, 177681], [156, 178221], [162, 179023], [164, 179149], [171, 179609], [174, 180040]]}, {"verse": 22, "start": 180769, "end": 187955, "text": "Y habiendo arribado a Cesarea subió a Jerusalén; y después de saludar a la iglesia, descendió a Antioquía.", "words": [[0, 180769], [2, 180879], [11, 181219], [20, 181619], [22, 182019], [30, 182419], [36, 182819], [38, 182899], [49, 183916], [51, 184260], [59, 184520], [62, 184720], [70, 185240], [72, 185300], [75, 185440], [84, 185840], [94, 186640], [96, 186940]]}, {"verse": 23, "start": 188305, "end": 198085, "text": "Y habiendo estado allí algún tiempo, salió, andando por orden la provincia de Galacia, y la Frigia, fortaleciendo a todos los discípulos.", "words": [[0, 188305], [2, 188429], [11, 188789], [18, 189089], [23, 189409], [29, 189689], [37, 190629], [44, 191649], [52, 192289], [56, 192549], [62, 192869], [65, 193149], [75, 194049], [78, 194169], [87, 194769], [89, 194969], [92, 195109], [100, 195649], [114, 196489], [116, 196689], [122, 196889], [126, 197149]]}, {"verse": 24, "start": 198435, "end": 208105, "text": "Llegó entonces a Éfeso un judío, llamado Apolos, natural de Alejandría, varón elocuente, poderoso en las Escrituras.", "words": [[0, 198435], [6, 198782], [15, 199202], [17, 199642], [23, 200082], [26, 200282], [33, 200822], [41, 201162], [49, 202422], [57, 202902], [60, 203122], [72, 204302], [78, 204822], [89, 205742], [98, 206562], [101, 206842], [105, 207022]]}, {"verse": 25, "start": 208455, "end": 220944, "text": "Este era instruido en el camino del Señor; y ferviente de espíritu, hablaba y enseñaba con exactitud las cosas que son del Señor, conociendo solamente el bautismo de Juan.", "words": [[0, 208455], [5, 208780], [9, 209100], [19, 209760], [22, 209880], [25, 209980], [32, 210240], [36, 210560], [43, 211400], [45, 211524], [55, 212104], [58, 212324], [68, 213164], [76, 213944], [78, 214304], [87, 214924], [91, 215144], [101, 215964], [105, 216384], [111, 216764], [115, 216964], [119, 217244], [123, 217424], [130, 218344], [141, 218924], [151, 219324], [154, 219684], [163, 220244], [166, 220424]]}, {"verse": 26, "start": 221294, "end": 232708, "text": "Y comenzó a hablar confiadamente en la sinagoga: al cual cuando oyeron Priscila y Aquila, le tomaron, y le explicaron con más precisión el camino de Dios.", "words": [[0, 221294], [2, 221411], [10, 221971], [12, 222071], [19, 222621], [33, 223171], [36, 223331], [39, 223451], [49, 224436], [52, 224646], [57, 224926], [64, 225346], [71, 226026], [80, 226706], [82, 226846], [90, 227386], [93, 227826], [102, 228486], [104, 229026], [107, 229126], [118, 230026], [122, 230246], [126, 230546], [136, 231366], [139, 231526], [146, 231806], [149, 232086]]}, {"verse": 27, "start": 233058, "end": 245654, "text": "Y queriendo él pasar a Acaya, los hermanos exhortados, escribieron a los discípulos que le recibiesen; y venido él, ayudó mucho por la gracia a los que habían creído:", "words": [[0, 233058], [2, 233199], [12, 233699], [15, 233899], [21, 234239], [23, 234519], [30, 235499], [34, 235579], [43, 236139], [55, 237119], [67, 238044], [69, 238344], [73, 238484], [84, 239164], [88, 239384], [91, 239564], [103, 241145], [105, 241249], [112, 241609], [116, 242109], [122, 242549], [128, 242849], [132, 243149], [135, 243349], [142, 244229], [144, 244369], [148, 244489], [152, 244629], [159, 244929]]}, {"verse": 28, "start": 246004, "end": 254598, "text": "Porque con gran vehemencia convencía públicamente a los judíos, mostrando por las Escrituras que Jesús era el Cristo.", "words": [[0, 246004], [7, 246291], [11, 246711], [16, 247011], [27, 248031], [37, 248811], [50, 249631], [52, 249751], [56, 249871], [64, 250871], [74, 251571], [78, 251891], [82, 252071], [93, 252731], [97, 252891], [103, 253291], [107, 253751], [110, 253931]]}]}