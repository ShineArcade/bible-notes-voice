{"book": "PSA", "chapter": 76, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 85396, "verses": [{"verse": 1, "start": 300, "end": 11188, "text": "Al Músico principal: sobre Neginoth: Salmo de Asaf: Canción. DIOS es conocido en Judá: en Israel es grande su nombre.", "words": [[0, 300], [3, 469], [10, 949], [21, 2163], [27, 2849], [37, 3816], [43, 4343], [46, 4663], [52, 5698], [61, 6767], [66, 7073], [69, 7413], [78, 8033], [81, 8153], [87, 8954], [90, 9153], [97, 9573], [100, 9913], [107, 10253], [110, 10553]]}, {"verse": 2, "start": 11638, "end": 16747, "text": "Y en Salem está su tabernáculo, y su habitación en Sion.", "words": [[0, 11638], [2, 11759], [5, 11899], [11, 12259], [16, 12859], [19, 13379], [32, 14279], [34, 14759], [37, 14939], [48, 15599], [51, 15959]]}, {"verse": 3, "start": 17197, "end": 23627, "text": "Allí quebró las flechas del arco, el escudo, y la espada, y el equipo de guerra. (Selah.)", "words": [[0, 17197], [5, 17502], [12, 17802], [16, 17942], [24, 18322], [28, 18502], [34, 19082], [37, 19142], [45, 19662], [47, 19782], [50, 19902], [58, 20382], [60, 20842], [63, 20942], [70, 21222], [73, 21980], [81, 23318]]}, {"verse": 4, "start": 24077, "end": 27727, "text": "Majestuoso eres tú; fuerte, más que los montes de caza.", "words": [[0, 24240], [11, 24420], [16, 24620], [20, 25393], [28, 26240], [32, 26380], [36, 26540], [40, 26680], [47, 27080], [50, 27423]]}, {"verse": 5, "start": 28177, "end": 36388, "text": "Los fuertes de corazón fueron despojados, durmieron su sueño; y nada hallaron en sus manos todos los varones fuertes.", "words": [[0, 28177], [4, 28302], [12, 28842], [15, 28922], [23, 29302], [30, 30172], [42, 31042], [52, 31762], [55, 32002], [62, 33007], [64, 33111], [69, 33351], [78, 33931], [81, 34091], [85, 34231], [91, 34571], [97, 34851], [101, 35111], [109, 35531]]}, {"verse": 6, "start": 36838, "end": 43377, "text": "A tu reprensión, oh Dios de Jacob, el carro y el caballo fueron entorpe