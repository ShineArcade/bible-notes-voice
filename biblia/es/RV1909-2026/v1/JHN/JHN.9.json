{"book": "JHN", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 293888, "verses": [{"verse": 1, "start": 300, "end": 5202, "text": "Y pasando Jesús, vio un hombre ciego desde su nacimiento.", "words": [[0, 300], [2, 404], [10, 764], [17, 2044], [21, 2504], [24, 2684], [31, 2924], [37, 3504], [43, 3764], [46, 4104]]}, {"verse": 2, "start": 5552, "end": 12550, "text": "Y le preguntaron sus discípulos, diciendo: Rabí, ¿quién pecó, este o sus padres, para que naciese ciego?", "words": [[0, 5552], [2, 5677], [5, 5817], [17, 6717], [21, 6997], [33, 8077], [43, 9088], [49, 9390], [56, 9590], [62, 9970], [67, 10250], [69, 10370], [73, 10530], [81, 11170], [86, 11390], [90, 11690], [98, 11990]]}, {"verse": 3, "start": 12830, "end": 19614, "text": "Respondió Jesús: Ni este pecó, ni sus padres: pero para que las obras de Dios se manifiesten en él.", "words": [[0, 12830], [10, 13334], [17, 14276], [20, 14576], [25, 14966], [31, 15356], [34, 15613], [38, 15869], [46, 16806], [51, 17007], [56, 17227], [60, 17367], [64, 17527], [70, 17827], [73, 18007], [78, 18247], [81, 18447], [93, 19107], [96, 19247]]}, {"verse": 4, "start": 19964, "end": 27245, "text": "Debo realizar las obras del que me envió, entre tanto que el día dura: la noche viene, cuando nadie puede obrar.", "words": [[0, 19964], [5, 20268], [14, 20748], [18, 21048], [24, 21328], [28, 21528], [32, 21688], [35, 21848], [42, 22608], [48, 23008], [54, 23388], [58, 23608], [61, 23808], [65, 23988], [71, 24767], [74, 24884], [80, 25104], [87, 25464], [94, 25704], [100, 26184], [106, 26504]]}, {"verse": 5, "start": 27595, "end": 30886, "text": "Entre tanto que estoy en el mundo, luz soy del mundo.", "words": [[0, 27595], [6, 27817], [12, 28197], [16, 28417], [22, 28697], [25, 28937], [28, 29057], [35, 29347], [39, 29637], [43, 29977], [47, 30197]]}, {"verse": 6, "start": 31236, "end": 38489, "text": "Esto dicho, escupió en tierra, e hizo lodo con la saliva, y untó con el lodo sobre los ojos del ciego,", "words": [[0, 31236], [5, 31624], [12, 32164], [20, 32664], [23, 32844], [31, 33224], [33, 33589], [38, 33929], [43, 34329], [47, 34589], [50, 34749], [58, 35209], [60, 35829], [65, 36169], [69, 36369], [72, 36529], [77, 36949], [83, 37229], [87, 37469], [92, 37789], [96, 38069]]}, {"verse": 7, "start": 38489, "end": 48013, "text": "Y le dijo: Ve, lávate en el estanque de Siloé (que traducido significa Enviado). Y fue entonces, y se lavó, y volvió viendo.", "words": [[0, 38569], [2, 38689], [5, 38769], [11, 39840], [15, 39840], [22, 40366], [25, 40606], [28, 40726], [37, 41246], [40, 41406], [46, 42232], [51, 42317], [61, 42997], [71, 43537], [81, 44596], [83, 44724], [87, 44884], [97, 45544], [99, 46104], [102, 46244], [108, 46904], [110, 47064], [117, 47784]]}, {"verse": 8, "start": 48363, "end": 55832, "text": "Entonces los vecinos, y los que antes le habían visto que era ciego, decían: ¿No es este el que se sentaba y mendigaba?", "words": [[0, 48363], [9, 48810], [13, 49090], [22, 49610], [24, 49770], [28, 49890], [32, 50050], [38, 50290], [41, 50530], [48, 50770], [54, 51050], [58, 51270], [62, 51410], [69, 51890], [77, 53176], [81, 53335], [84, 53515], [89, 53895], [92, 54035], [96, 54155], [99, 54275], [107, 54815], [109, 55095]]}, {"verse": 9, "start": 56112, "end": 62497, "text": "Unos decían: Este es; y otros: A él se parece. Él decía: Yo soy.", "words": [[0, 56197], [5, 56317], [13, 57577], [18, 57853], [22, 58410], [24, 58547], [31, 59395], [33, 59559], [36, 59759], [39, 59959], [47, 60869], [50, 61040], [57, 61846], [60, 62067]]}, {"verse": 10, "start": 62777, "end": 65916, "text": "Y le dijeron: ¿Cómo te fueron abiertos los ojos?", "words": [[0, 62777], [2, 62924], [5, 63004], [14, 63967], [20, 64124], [23, 64304], [30, 64584], [39, 65164], [43, 65304]]}, {"verse": 11, "start": 66196, "end": 77833, "text": "Respondió él y dijo: El hombre que se llama Jesús, hizo lodo, y me untó los ojos, y me dijo: Ve al Siloé, y lávate: y fui, y me lavé, y recibí la vista.", "words": [[0, 66196], [10, 66881], [13, 67201], [15, 67441], [21, 68230], [24, 68370], [31, 68650], [35, 68850], [38, 69010], [44, 69270], [51, 69810], [56, 70350], [62, 70890], [64, 71170], [67, 71270], [72, 71530], [76, 71730], [82, 71970], [84, 72190], [87, 72310], [93, 72984], [96, 73142], [99, 73342], [106, 73762], [108, 74002], [116, 74780], [118, 74903], [123, 75123], [125, 75403], [128, 75503], [134, 75823], [136, 76023], [143, 76443], [146, 76523]]}, {"verse": 12, "start": 78113, "end": 82377, "text": "Entonces le dijeron: ¿Dónde está aquel? Él dijo: No sé.", "words": [[0, 78113], [9, 78561], [12, 78821], [21, 79723], [28, 79986], [33, 80246], [40, 80955], [43, 81165], [49, 81866], [52, 82025]]}, {"verse": 13, "start": 82657, "end": 86412, "text": "Llevaron a los fariseos al que antes había sido ciego.", "words": [[0, 82657], [9, 83204], [11, 83504], [15, 83664], [24, 84114], [27, 84564], [31, 84744], [37, 84984], [43, 85324], [48, 85664]]}, {"verse": 14, "start": 86762, "end": 92198, "text": "Y era sábado cuando Jesús había hecho el lodo, y le había abierto los ojos.", "words": [[0, 86762], [2, 87060], [6, 87240], [13, 87780], [20, 88040], [26, 88440], [32, 88960], [38, 89340], [41, 89540], [47, 89980], [49, 90440], [52, 90540], [58, 90800], [66, 91240], [70, 91480]]}, {"verse": 15, "start": 92548, "end": 103545, "text": "Y le volvieron a preguntar también los fariseos de qué manera había recibido la vista. Y él les dijo: Me puso lodo sobre los ojos, y me lavé, y veo.", "words": [[0, 92548], [2, 92690], [5, 92790], [15, 93350], [17, 93450], [27, 94130], [35, 94490], [39, 95030], [48, 95850], [51, 96030], [55, 96290], [62, 96670], [68, 97230], [77, 97930], [80, 98070], [87, 98909], [89, 99260], [92, 99420], [96, 99640], [102, 100483], [105, 100600], [110, 100940], [115, 101240], [121, 101520], [125, 101720], [131, 102080], [133, 102380], [136, 102500], [142, 102860], [144, 103140]]}, {"verse": 16, "start": 103825, "end": 116493, "text": "Entonces unos de los fariseos decían: Este hombre no es de Dios, que no guarda el sábado. Otros decían: ¿Cómo puede un hombre pecador hacer estas señales? Y había división entre ellos.", "words": [[0, 103825], [9, 104326], [14, 104864], [17, 105004], [21, 105124], [30, 105744], [38, 106769], [43, 107010], [50, 107310], [53, 107550], [56, 107690], [59, 107810], [65, 108450], [69, 108530], [72, 108690], [79, 109130], [82, 109170], [90, 109991], [96, 110362], [104, 111589], [110, 111768], [116, 112128], [119, 112288], [126, 112508], [134, 113028], [140, 113288], [146, 113528], [155, 114539], [157, 114703], [163, 114903], [172, 115503], [178, 115743]]}, {"verse": 17, "start": 116843, "end": 123024, "text": "Vuelven a decir al ciego: ¿Tú, qué dices del que te abrió los ojos? Y él dijo: Que es profeta.", "words": [[0, 116843], [8, 117309], [10, 117409], [16, 117689], [19, 117909], [26, 118739], [31, 118859], [35, 118959], [41, 119279], [45, 119439], [49, 119599], [52, 119719], [58, 119979], [62, 120139], [68, 120979], [70, 121168], [73, 121328], [79, 122047], [83, 122168], [86, 122328]]}, {"verse": 18, "start": 123304, "end": 133216, "text": "Pero los judíos no creían de él, que había sido ciego, y hubiese recibido la vista, hasta que llamaron a los padres del que había recibido la vista;", "words": [[0, 123304], [5, 123449], [9, 123649], [16, 124209], [19, 124609], [26, 125169], [29, 125409], [33, 126089], [37, 126329], [43, 126509], [48, 126849], [55, 127389], [57, 127769], [65, 128049], [74, 128689], [77, 128809], [84, 129449], [90, 129769], [94, 129909], [103, 130349], [105, 130489], [109, 130609], [116, 131069], [120, 131489], [124, 131669], [130, 131889], [139, 132509], [142, 132629]]}, {"verse": 19, "start": 133566, "end": 141214, "text": "Y les preguntaron, diciendo: ¿Es este vuestro hijo, el que vosotros decís que nació ciego? ¿Cómo, pues, ve ahora?", "words": [[0, 133566], [2, 133798], [6, 133898], [19, 134678], [29, 136087], [33, 136263], [38, 136523], [46, 136903], [52, 137583], [55, 137663], [59, 137783], [68, 138203], [74, 138743], [78, 138903], [84, 139223], [91, 140063], [98, 140223], [104, 140703], [107, 140763]]}, {"verse": 20, "start": 141494, "end": 147358, "text": "Les respondieron sus padres y dijeron: Sabemos que este es nuestro hijo, y que nació ciego:", "words": [[0, 141494], [4, 141792], [17, 142732], [21, 142912], [28, 143312], [30, 143592], [39, 144516], [47, 144921], [51, 145161], [56, 145361], [59, 145501], [67, 145641], [73, 146141], [75, 146441], [79, 146541], [85, 146841]]}, {"verse": 21, "start": 147708, "end": 156242, "text": "Pero cómo vea ahora, no sabemos; o quién le haya abierto los ojos, nosotros no lo sabemos; él ya es adulto, preguntadle a él; él hablará de sí.", "words": [[0, 147708], [5, 147835], [10, 148095], [14, 148435], [21, 148755], [24, 148835], [33, 149709], [35, 149808], [41, 150008], [44, 150208], [49, 150368], [57, 150768], [61, 150948], [67, 151588], [76, 151988], [79, 152188], [82, 152288], [91, 153146], [94, 153308], [97, 153488], [100, 153628], [108, 154148], [120, 154668], [122, 154808], [126, 155263], [129, 155421], [137, 155781], [140, 155901]]}, {"verse": 22, "start": 156522, "end": 169255, "text": "Esto dijeron sus padres, porque tenían miedo de los judíos: porque ya los judíos habían resuelto que si alguno confesase ser él el Mesías, fuese expulsado de la sinagoga.", "words": [[0, 156522], [5, 156847], [13, 157467], [17, 157607], [25, 158647], [32, 159027], [39, 159467], [45, 160107], [48, 160327], [52, 160487], [60, 161567], [67, 161749], [70, 162009], [74, 162169], [81, 162749], [88, 162989], [97, 163669], [101, 163809], [104, 163949], [111, 164429], [121, 165149], [125, 165509], [128, 165849], [131, 166049], [139, 166629], [145, 167379], [155, 168129], [158, 168309], [161, 168409]]}, {"verse": 23, "start": 169605, "end": 173293, "text": "Por eso dijeron sus padres: Ya es adulto, preguntadle a él.", "words": [[0, 169605], [4, 169711], [8, 169891], [16, 170431], [20, 170571], [28, 171576], [31, 171739], [34, 171899], [42, 172409], [54, 172919], [56, 173039]]}, {"verse": 24, "start": 173573, "end": 182386, "text": "Así que, volvieron a llamar al hombre que había sido ciego, y le dijeron: Da gloria a Dios: nosotros sabemos que este hombre es pecador.", "words": [[0, 173573], [4, 173813], [9, 174053], [19, 174653], [21, 174793], [28, 175173], [31, 175293], [38, 175553], [42, 175753], [48, 175993], [53, 176313], [60, 176913], [62, 177473], [65, 177613], [74, 178588], [77, 178784], [84, 179204], [86, 179364], [92, 180098], [101, 180503], [109, 180803], [113, 181123], [118, 181343], [125, 181603], [128, 181823]]}, {"verse": 25, "start": 182666, "end": 191344, "text": "Entonces él respondió, y dijo: Si es pecador, no lo sé: una cosa sé, que habiendo yo sido ciego, ahora veo.", "words": [[0, 182666], [9, 183631], [12, 184051], [23, 185071], [25, 185331], [31, 186100], [34, 186275], [37, 186515], [46, 186995], [49, 187115], [52, 187235], [56, 187841], [60, 188028], [65, 188328], [69, 189088], [73, 189168], [82, 189528], [85, 189728], [90, 189948], [97, 190728], [103, 190868]]}, {"verse": 26, "start": 191624, "end": 195389, "text": "Y le volvieron a decir: ¿Qué te hizo? ¿Cómo te abrió los ojos?", "words": [[0, 191624], [2, 191751], [5, 191851], [15, 192391], [17, 192511], [24, 193263], [29, 193363], [32, 193503], [38, 194146], [44, 194288], [47, 194448], [53, 194668], [57, 194808]]}, {"verse": 27, "start": 195669, "end": 203597, "text": "Les respondió: Ya os lo he dicho, y no habéis atendido: ¿por qué lo queréis otra vez oír? ¿queréis también vosotros haceros sus discípulos?", "words": [[0, 195669], [4, 195822], [15, 196866], [18, 197083], [21, 197223], [24, 197363], [27, 197463], [34, 197723], [36, 198083], [39, 198223], [46, 198463], [56, 199262], [61, 199378], [65, 199538], [68, 199678], [76, 199978], [81, 200198], [85, 200458], [90, 201109], [99, 201431], [107, 201651], [116, 202211], [124, 202671], [128, 202791]]}, {"verse": 28, "start": 203877, "end": 210393, "text": "Y le ultrajaron, y dijeron: Tú eres su discípulo; pero nosotros discípulos de Moisés somos.", "words": [[0, 203877], [2, 204060], [5, 204630], [17, 205200], [19, 205535], [28, 206468], [31, 206596], [36, 206776], [39, 207016], [50, 208010], [55, 208152], [64, 208492], [75, 209212], [78, 209372], [85, 209732]]}, {"verse": 29, "start": 210743, "end": 215243, "text": "Nosotros sabemos que a Moisés habló Dios: pero este no sabemos de dónde es.", "words": [[0, 210743], [9, 211189], [17, 211549], [21, 211829], [23, 211929], [30, 212249], [36, 212729], [42, 213402], [47, 213543], [52, 213823], [55, 214023], [63, 214363], [66, 214663], [72, 214843]]}, {"verse": 30, "start": 215523, "end": 224112, "text": "Respondió aquel hombre, y les dijo: Por cierto, maravillosa cosa es esta, que vosotros no sabéis de dónde sea, y a mí me abrió los ojos.", "words": [[0, 215523], [10, 216246], [16, 216446], [24, 216706], [26, 217006], [30, 217166], [36, 217956], [40, 218062], [48, 218582], [60, 219142], [65, 219342], [68, 219702], [74, 220442], [78, 220522], [87, 220942], [90, 221142], [97, 221522], [100, 221662], [106, 221822], [111, 222762], [113, 222862], [115, 222922], [118, 223042], [121, 223182], [127, 223522], [131, 223682]]}, {"verse": 31, "start": 224462, "end": 231065, "text": "Y sabemos que Dios no oye a los pecadores: pero si alguno es temeroso de Dios, y hace su voluntad, a este oye.", "words": [[0, 224462], [2, 224546], [10, 224806], [14, 225106], [19, 225366], [22, 225746], [26, 226006], [28, 226086], [32, 226186], [43, 227126], [48, 227292], [51, 227472], [58, 227932], [61, 228112], [70, 228552], [73, 228732], [79, 228972], [81, 229292], [86, 229492], [89, 229672], [99, 230252], [101, 230352], [106, 230592]]}, {"verse": 32, "start": 231415, "end": 236647, "text": "Desde el principio del mundo no fue oído, que abriese alguno los ojos de uno que nació ciego.", "words": [[0, 231415], [6, 231599], [9, 231799], [19, 232239], [23, 232459], [29, 232719], [32, 232919], [36, 233159], [42, 233819], [46, 234019], [54, 234369], [61, 234719], [65, 234899], [70, 235179], [73, 235419], [77, 235619], [81, 235779], [87, 236119]]}, {"verse": 33, "start": 236997, "end": 240199, "text": "Si este no fuera de Dios, no pudiera hacer nada.", "words": [[0, 236997], [3, 237131], [8, 237451], [11, 237651], [17, 237891], [20, 238071], [26, 238771], [29, 239051], [37, 239451], [43, 239711]]}, {"verse": 34, "start": 240479, "end": 247627, "text": "Respondieron, y le dijeron: Tú naciste enteramente en pecado, ¿y tú nos enseñas? Y le echaron fuera.", "words": [[0, 240479], [14, 241284], [16, 241704], [19, 241824], [28, 242704], [31, 242806], [39, 243266], [51, 243846], [54, 244026], [62, 244466], [65, 244846], [68, 244986], [72, 245146], [81, 246192], [83, 246340], [86, 246480], [94, 246960]]}, {"verse": 35, "start": 247977, "end": 254559, "text": "Oyó Jesús que le habían echado fuera; y hallándole, le dijo: ¿Crees tú en el Hijo de Dios?", "words": [[0, 248136], [4, 248326], [10, 248998], [14, 249071], [17, 249211], [24, 249491], [31, 249891], [38, 250820], [40, 250938], [52, 251478], [55, 251598], [61, 252606], [68, 252892], [71, 253192], [74, 253492], [77, 253612], [82, 253832], [85, 254032]]}, {"verse": 36, "start": 254909, "end": 258895, "text": "Respondió él, y dijo: ¿Quién es, Señor, para que crea en él?", "words": [[0, 254909], [10, 255533], [14, 255913], [16, 256193], [22, 256982], [29, 257119], [33, 257239], [40, 257599], [45, 258019], [49, 258159], [54, 258499], [57, 258639]]}, {"verse": 37, "start": 259175, "end": 264282, "text": "Y le dijo Jesús: Y le has visto, y el que habla contigo, él es.", "words": [[0, 259175], [2, 259302], [5, 259402], [10, 259682], [17, 260712], [19, 260851], [22, 260931], [26, 261111], [33, 261511], [35, 261806], [38, 261946], [42, 262126], [48, 262406], [57, 263346], [60, 263706]]}, {"verse": 38, "start": 264632, "end": 267763, "text": "Y él dice: Creo, Señor; y le adoró.", "words": [[0, 264632], [2, 264829], [5, 264989], [11, 265683], [17, 265980], [24, 266802], [26, 266984], [29, 267104]]}, {"verse": 39, "start": 268113, "end": 276538, "text": "Y dijo Jesús: Yo, para juicio he venido a este mundo: para que los que no ven, vean; y los que ven, sean cegados.", "words": [[0, 268113], [2, 268372], [7, 268592], [14, 269470], [18, 269677], [23, 269937], [30, 270497], [33, 270737], [40, 271137], [42, 271237], [47, 271417], [54, 272226], [59, 272392], [63, 272532], [67, 272672], [71, 272812], [74, 272972], [79, 273212], [85, 274394], [87, 274473], [91, 274593], [95, 274773], [100, 275013], [105, 275553]]}, {"verse": 40, "start": 276888, "end": 283991, "text": "Y ciertos de los fariseos que estaban con él oyeron esto, y le dijeron: ¿Somos nosotros también ciegos?", "words": [[0, 276888], [2, 277051], [10, 277611], [13, 277711], [17, 277831], [26, 278651], [30, 278811], [38, 279111], [42, 279431], [45, 279631], [52, 280351], [58, 280811], [60, 281151], [63, 281291], [72, 282169], [79, 282573], [88, 282913], [96, 283253]]}, {"verse": 41, "start": 284271, "end": 293488, "text": "Jesús les respondió: Si fuerais ciegos, no tuvierais pecado: pero ahora porque decís, Vemos, por tanto vuestro pecado permanece.", "words": [[0, 284271], [6, 284578], [10, 284898], [21, 285974], [24, 286116], [32, 286556], [40, 287436], [43, 287636], [53, 288156], [61, 289066], [66, 289210], [72, 289510], [79, 289830], [86, 290670], [93, 290950], [97, 291430], [103, 291710], [111, 292150], [118, 292590]]}]}