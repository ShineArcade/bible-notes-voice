{"book": "GEN", "chapter": 41, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 466753, "verses": [{"verse": 1, "start": 300, "end": 6608, "text": "Y aconteció que pasados dos años tuvo Faraón un sueño: Le parecía que estaba junto al río;", "words": [[0, 300], [2, 426], [12, 1086], [16, 1326], [24, 1846], [28, 2066], [33, 2386], [38, 2666], [45, 3246], [48, 3406], [55, 4250], [58, 4528], [66, 5048], [70, 5208], [77, 5468], [83, 5768], [86, 6028]]}, {"verse": 2, "start": 6958, "end": 14041, "text": "Y que del río subían siete vacas, hermosas a la vista, y muy gordas, y pacían en el prado:", "words": [[0, 6958], [2, 7061], [6, 7201], [10, 7421], [14, 7801], [21, 8281], [27, 8641], [34, 9721], [43, 10341], [45, 10461], [48, 10521], [55, 10841], [57, 11141], [61, 11321], [69, 12421], [71, 12761], [78, 13101], [81, 13261], [84, 13401]]}, {"verse": 3, "start": 14391, "end": 25504, "text": "Y que otras siete vacas subían tras ellas del río, de fea vista, y flacas de carne, y se pararon cerca de las vacas hermosas a la orilla del río:", "words": [[0, 14391], [2, 14517], [6, 14657], [12, 15037], [18, 15637], [24, 16237], [31, 16637], [36, 16877], [42, 17237], [46, 17517], [51, 17897], [54, 18457], [58, 18817], [65, 19257], [67, 19777], [74, 20217], [77, 20397], [84, 20917], [86, 21310], [89, 21704], [97, 22097], [103, 22517], [106, 22757], [110, 22877], [116, 23277], [125, 23977], [127, 24177], [130, 24297], [137, 24717], [141, 24977]]}, {"verse": 4, "start": 25854, "end": 34676, "text": "Y que las vacas de fea vista y flacas de carne devoraban a las siete vacas hermosas y muy gordas. Y despertó Faraón.", "words": [[0, 25854], [2, 25972], [6, 26112], [10, 26332], [16, 26812], [19, 26932], [23, 27432], [29, 27892], [31, 28072], [38, 28452], [41, 28612], [47, 29052], [57, 30047], [59, 30327], [63, 30427], [69, 30787], [75, 31307], [84, 31867], [86, 31987], [90, 32167], [98, 33213], [100, 33340], [109, 33940]]}, {"verse": 5, "start": 35026, "end": 42526, "text": "Se durmió de nuevo, y soñó la segunda vez: Que siete espigas llenas y hermosas subían de una sola caña:", "words": [[0, 35026], [3, 35286], [10, 35746], [13, 35846], [20, 36146], [22, 36606], [27, 36986], [30, 37106], [38, 37386], [43, 38277], [47, 38361], [53, 38761], [61, 39521], [68, 39921], [70, 40041], [79, 40701], [86, 41301], [89, 41461], [93, 41601], [98, 41881]]}, {"verse": 6, "start": 42876, "end": 48427, "text": "Y que otras siete espigas menudas y abatidas del Solano, salían después de ellas:", "words": [[0, 42876], [2, 42982], [6, 43102], [12, 43382], [18, 44092], [26, 44802], [34, 45302], [36, 45422], [45, 45942], [49, 46102], [57, 46622], [64, 47342], [72, 47582], [75, 47822]]}, {"verse": 7, "start": 48777, "end": 57194, "text": "Y las siete espigas menudas devoraban a las siete espigas gruesas y llenas. Y despertó Faraón, y he aquí que era sueño.", "words": [[0, 48777], [2, 48906], [6, 49046], [12, 49586], [20, 50126], [28, 50706], [38, 51346], [40, 51466], [44, 51646], [50, 52106], [58, 52566], [66, 53126], [68, 53246], [76, 53987], [78, 54197], [87, 54857], [95, 55517], [97, 55737], [100, 55957], [105, 56217], [109, 56417], [113, 56597]]}, {"verse": 8, "start": 57544, "end": 72271, "text": "Y acaeció que a la mañana estaba agitado su espíritu; y envió e hizo llamar a todos los magos de Egipto, y a todos sus sabios: y les contó Faraón sus sueños, pero nadie podía interpretarlos para Faraón.", "words": [[0, 57544], [2, 57850], [10, 58550], [14, 58810], [16, 58910], [19, 58970], [26, 59250], [33, 59650], [41, 60170], [44, 60330], [54, 61217], [56, 61354], [62, 61834], [64, 62094], [69, 62394], [76, 62814], [78, 62894], [84, 63094], [88, 63334], [94, 63774], [97, 63894], [105, 64914], [107, 65114], [109, 65174], [115, 65434], [119, 65874], [127, 66933], [129, 67041], [133, 67161], [139, 67671], [146, 68181], [150, 68361], [158, 69181], [163, 69461], [169, 69921], [175, 70361], [190, 71421], [195, 71846]]}, {"verse": 9, "start": 72621, "end": 79351, "text": "Entonces el principal de los coperos habló a Faraón, diciendo: Hoy me acuerdo de mis faltas:", "words": [[0, 72621], [9, 73415], [12, 73567], [22, 74187], [25, 74467], [29, 74587], [37, 75027], [43, 75467], [45, 76077], [53, 76687], [63, 77733], [67, 77890], [70, 78010], [78, 78330], [81, 78550], [85, 78670]]}, {"verse": 10, "start": 79701, "end": 88022, "text": "Faraón se enojó contra sus siervos, y a mí me echó a la prisión de la casa del capitán de los de la guardia, a mí y al principal de los panaderos:", "words": [[0, 79934], [7, 80184], [10, 80344], [16, 80744], [23, 80964], [27, 81184], [36, 81904], [38, 82184], [40, 82264], [43, 82424], [46, 82584], [51, 82884], [53, 82964], [56, 83044], [64, 83464], [67, 83604], [70, 83704], [75, 83944], [79, 84144], [87, 84664], [90, 84764], [94, 84884], [97, 85004], [100, 85104], [109, 85888], [111, 85995], [114, 86175], [116, 86435], [119, 86535], [129, 86875], [132, 87115], [136, 87235]]}, {"verse": 11, "start": 88372, "end": 93982, "text": "Y yo y él vimos un sueño una misma noche: cada uno soñó conforme a la interpretación de su sueño.", "words": [[0, 88372], [2, 88531], [5, 88751], [7, 89031], [10, 89171], [16, 89311], [19, 89591], [25, 89951], [29, 90131], [35, 90331], [42, 91108], [47, 91252], [51, 91492], [56, 91912], [65, 92432], [67, 92492], [70, 92532], [85, 93212], [88, 93352], [91, 93472]]}, {"verse": 12, "start": 94332, "end": 105534, "text": "Y estaba allí con nosotros un joven hebreo, sirviente del capitán de los de la guardia; y se lo contamos, y él nos interpretó nuestros sueños, e interpretó a cada uno conforme a su sueño.", "words": [[0, 94332], [2, 94431], [9, 94771], [14, 95031], [18, 95231], [27, 95631], [30, 95891], [36, 96231], [44, 97031], [54, 97631], [58, 97851], [66, 98391], [69, 98511], [73, 98651], [76, 98791], [79, 98891], [88, 99669], [90, 99796], [93, 99856], [96, 99976], [106, 100556], [108, 100996], [111, 101136], [115, 101296], [126, 101896], [135, 102036], [143, 102736], [145, 103136], [156, 103756], [158, 103856], [163, 103976], [167, 104296], [176, 104856], [178, 104916], [181, 105016]]}, {"verse": 13, "start": 105884, "end": 112445, "text": "Y aconteció que como él nos interpretó, así fue: a mí me hizo volver a mi puesto, e hizo colgar al otro.", "words": [[0, 105884], [2, 106204], [12, 106804], [16, 107044], [21, 107184], [24, 107384], [28, 107544], [40, 108324], [44, 108524], [49, 109202], [51, 109299], [54, 109479], [57, 109779], [62, 110039], [69, 110319], [71, 110459], [74, 110579], [82, 110999], [84, 111419], [89, 111639], [96, 111979], [99, 112099]]}, {"verse": 14, "start": 112725, "end": 124324, "text": "Entonces Faraón envió y llamó a José; y le hicieron salir corriendo de la cárcel, y le cortaron el pelo, y cambiaron sus vestidos, y vino a Faraón.", "words": [[0, 112725], [9, 113377], [16, 114064], [22, 114684], [24, 114924], [30, 115304], [32, 115404], [38, 116164], [40, 116327], [43, 116467], [52, 117007], [58, 117387], [68, 118107], [71, 118247], [74, 118367], [82, 118927], [84, 119107], [87, 119227], [96, 119827], [99, 120027], [105, 120487], [107, 120927], [117, 121567], [121, 121807], [131, 122867], [133, 123167], [138, 123387], [140, 123883]]}, {"verse": 15, "start": 124674, "end": 132498, "text": "Y dijo Faraón a José: Yo he tenido un sueño, y no hay quien lo interprete; mas he oído decir de ti, que puedes interpretar sueños.", "words": [[0, 124674], [2, 124820], [7, 125240], [14, 125660], [16, 125860], [22, 126608], [25, 126775], [28, 126835], [35, 127075], [38, 127255], [45, 127755], [47, 127955], [50, 128075], [54, 128175], [60, 128335], [63, 128475], [75, 129406], [79, 129568], [82, 129708], [87, 129968], [93, 130268], [96, 130488], [100, 130688], [104, 130948], [111, 131208], [123, 131868]]}, {"verse": 16, "start": 132778, "end": 139681, "text": "Y respondió José a Faraón, diciendo: No está en mí; Dios dará una respuesta favorable a Faraón.", "words": [[0, 132778], [2, 132903], [12, 133603], [17, 134056], [19, 134510], [27, 134963], [37, 136333], [40, 136478], [45, 136658], [48, 136858], [52, 137302], [57, 137519], [62, 137899], [66, 137979], [76, 138319], [86, 138939], [88, 139339]]}, {"verse": 17, "start": 139961, "end": 145564, "text": "Entonces Faraón dijo a José: En mi sueño me parecía que estaba a la orilla del río:", "words": [[0, 139961], [9, 140648], [16, 141378], [21, 141658], [23, 141858], [29, 142443], [32, 142567], [35, 142687], [41, 143047], [44, 143187], [52, 143707], [56, 143927], [63, 144267], [65, 144487], [68, 144567], [75, 144907], [79, 145087]]}, {"verse": 18, "start": 145914, "end": 151926, "text": "Y que del río subían siete vacas de gruesas carnes y hermosa apariencia, que pacían en el prado:", "words": [[0, 145914], [2, 146019], [6, 146119], [10, 146299], [14, 146599], [21, 147059], [27, 147399], [33, 147919], [36, 148039], [44, 148479], [51, 148979], [53, 149199], [61, 149679], [73, 150299], [77, 150759], [84, 151219], [87, 151339], [90, 151459]]}, {"verse": 19, "start": 152276, "end": 161377, "text": "Y que otras siete vacas subían después de ellas, flacas y de muy fea traza; tan extenuadas, que no he visto otras semejantes en toda la tierra de Egipto en fealdad:", "words": [[0, 152276], [2, 152376], [6, 152496], [12, 152716], [18, 153056], [24, 153516], [31, 153896], [39, 154176], [42, 154456], [49, 155116], [56, 155556], [58, 155776], [61, 155876], [65, 156036], [69, 156466], [76, 157090], [80, 157226], [92, 157866], [96, 158106], [99, 158266], [102, 158346], [108, 158586], [114, 158826], [125, 159466], [128, 159626], [133, 159786], [136, 159966], [143, 160246], [146, 160406], [153, 160786], [156, 160866]]}, {"verse": 20, "start": 161727, "end": 165665, "text": "Y las vacas flacas y feas devoraban a las siete primeras vacas gruesas:", "words": [[0, 161727], [2, 161822], [6, 161942], [12, 162322], [19, 162702], [21, 162882], [26, 163102], [36, 163742], [38, 163862], [42, 163962], [48, 164182], [57, 164682], [63, 165042]]}, {"verse": 21, "start": 166015, "end": 174878, "text": "Y entraban en sus entrañas, mas no se conocía que hubiesen entrado en ellas, porque su apariencia seguía tan mala como antes. Y yo desperté.", "words": [[0, 166015], [2, 166114], [11, 166594], [14, 166714], [18, 166814], [28, 167814], [32, 168114], [35, 168334], [38, 168454], [46, 168974], [50, 169114], [59, 169494], [67, 169974], [70, 170114], [77, 170794], [84, 171174], [87, 171394], [98, 171974], [105, 172454], [109, 172614], [114, 172874], [119, 173134], [126, 173974], [128, 174131], [131, 174211]]}, {"verse": 22, "start": 175228, "end": 179560, "text": "Vi también soñando, que siete espigas subían en una misma caña llenas y hermosas;", "words": [[0, 175228], [3, 175348], [11, 175568], [20, 176188], [24, 176328], [30, 176588], [38, 177128], [45, 177528], [48, 177648], [52, 177788], [58, 178008], [63, 178428], [70, 178828], [72, 178948]]}, {"verse": 23, "start": 179910, "end": 185702, "text": "Y que otras siete espigas menudas, marchitas, abatidas del Solano, subían después de ellas:", "words": [[0, 179910], [2, 179992], [6, 180092], [12, 180292], [18, 180632], [26, 181132], [35, 181772], [46, 182712], [55, 183152], [59, 183332], [67, 184132], [74, 184532], [82, 184772], [85, 185052]]}, {"verse": 24, "start": 186052, "end": 193415, "text": "Y las espigas menudas devoraban a las siete espigas hermosas: y lo he dicho a los magos, mas no hay quien me lo interprete.", "words": [[0, 186052], [2, 186156], [6, 186316], [14, 186856], [22, 187356], [32, 188016], [34, 188136], [38, 188276], [44, 188536], [52, 189076], [62, 190013], [64, 190117], [67, 190237], [70, 190337], [76, 190557], [78, 190697], [82, 190817], [89, 191517], [93, 191717], [96, 191977], [100, 192157], [106, 192337], [109, 192497], [112, 192597]]}, {"verse": 25, "start": 193695, "end": 201345, "text": "Entonces respondió José a Faraón: El sueño de Faraón es uno mismo: Dios ha mostrado a Faraón lo que va a hacer.", "words": [[0, 193695], [9, 194720], [19, 195260], [24, 195684], [26, 196107], [34, 196657], [37, 196784], [43, 197144], [46, 197454], [53, 197764], [56, 197904], [60, 198064], [67, 198816], [72, 199080], [75, 199360], [84, 199860], [86, 200000], [93, 200440], [96, 200580], [100, 200700], [103, 200900], [105, 201000]]}, {"verse": 26, "start": 201695, "end": 208588, "text": "Las siete vacas hermosas siete años son; y las espigas hermosas son siete años: el sueño es uno mismo.", "words": [[0, 201695], [4, 201840], [10, 202160], [16, 202640], [25, 203120], [31, 203400], [36, 203680], [41, 204351], [43, 204562], [47, 204722], [55, 205242], [64, 205782], [68, 205962], [74, 206282], [80, 206992], [83, 207114], [89, 207594], [92, 207914], [96, 208074]]}, {"verse": 27, "start": 208938, "end": 218477, "text": "También las siete vacas flacas y feas que subían tras ellas, son siete años; y las siete espigas menudas y marchitas del Solano, siete años serán de hambre.", "words": [[0, 208938], [8, 209260], [12, 209480], [18, 209780], [24, 210220], [31, 210600], [33, 210780], [38, 211020], [42, 211260], [49, 211680], [54, 211860], [61, 212220], [65, 212680], [71, 212980], [77, 213825], [79, 213927], [83, 214067], [89, 214387], [97, 214947], [105, 215447], [107, 215567], [117, 216020], [121, 216474], [129, 216927], [135, 217207], [140, 217567], [146, 217927], [149, 218047]]}, {"verse": 28, "start": 218827, "end": 223667, "text": "Esto es lo que respondo a Faraón. Lo que Dios va a hacer, lo ha mostrado a Faraón.", "words": [[0, 218827], [5, 219095], [8, 219295], [11, 219415], [15, 219535], [24, 220055], [26, 220370], [34, 220843], [37, 220966], [41, 221086], [46, 221326], [49, 221546], [51, 221686], [58, 222006], [61, 222446], [64, 222546], [73, 222986], [75, 223356]]}, {"verse": 29, "start": 224017, "end": 227617, "text": "He aquí vienen siete años de gran abundancia en toda la tierra de Egipto:", "words": [[0, 224017], [3, 224017], [8, 224295], [15, 224595], [21, 224915], [26, 225275], [29, 225475], [34, 225595], [45, 226235], [48, 226375], [53, 226515], [56, 226695], [63, 226935], [66, 227115]]}, {"verse": 30, "start": 227967, "end": 235859, "text": "Y se levantarán tras ellos siete años de hambre; y toda la abundancia será olvidada en la tierra de Egipto; y el hambre consumirá la tierra;", "words": [[0, 227967], [2, 228070], [5, 228170], [16, 228790], [21, 228910], [27, 229250], [33, 229610], [38, 229910], [41, 230110], [49, 230769], [51, 230915], [56, 231075], [59, 231275], [70, 231975], [75, 232235], [84, 232795], [87, 232915], [90, 232995], [97, 233235], [100, 233435], [108, 234145], [110, 234268], [113, 234368], [120, 234668], [130, 235288], [133, 235348]]}, {"verse": 31, "start": 236209, "end": 241083, "text": "Y aquella abundancia no se echará de ver a causa del hambre siguiente, la cual será gravísima.", "words": [[0, 236209], [2, 236329], [10, 236629], [21, 237209], [24, 237369], [27, 237509], [34, 237909], [37, 238009], [41, 238169], [43, 238249], [49, 238509], [53, 238739], [60, 238969], [71, 239809], [74, 239869], [79, 240089], [84, 240369]]}, {"verse": 32, "start": 241433, "end": 248889, "text": "Y el suceder el sueño a Faraón dos veces, significa que la cosa es firme de parte de Dios, y que Dios se apresura a hacerla.", "words": [[0, 241433], [2, 241538], [5, 241638], [13, 242158], [16, 242298], [22, 242678], [24, 242798], [31, 243258], [35, 243438], [42, 243878], [52, 244598], [56, 245078], [59, 245198], [64, 245458], [67, 245678], [73, 245958], [76, 246058], [82, 246318], [85, 246518], [91, 246758], [93, 247033], [97, 247153], [102, 247393], [105, 247593], [114, 248113], [116, 248253]]}, {"verse": 33, "start": 249239, "end": 255262, "text": "Por tanto, provéase ahora Faraón de un varón prudente y sabio, y póngalo sobre la tierra de Egipto.", "words": [[0, 249239], [4, 249350], [11, 250070], [20, 250510], [26, 250830], [33, 251350], [36, 251470], [39, 251590], [45, 251890], [54, 252310], [56, 252470], [63, 253250], [65, 253430], [73, 253930], [79, 254190], [82, 254350], [89, 254630], [92, 254810]]}, {"verse": 34, "start": 255612, "end": 262850, "text": "Haga esto Faraón, y ponga gobernadores sobre el país, y recoja la quinta parte de las cosechas de Egipto en los siete años de abundancia;", "words": [[0, 255612], [5, 255751], [10, 256031], [18, 256531], [20, 256631], [26, 256951], [39, 257551], [45, 257831], [48, 257991], [54, 258291], [56, 258506], [63, 258986], [66, 259086], [73, 259446], [79, 259766], [82, 259986], [86, 260106], [95, 260606], [98, 260746], [105, 261166], [108, 261286], [112, 261386], [118, 261606], [123, 261926], [126, 262106]]}, {"verse": 35, "start": 263200, "end": 271908, "text": "Y junten toda la provisión de estos buenos años que vienen, y acumulen el trigo bajo la mano de Faraón para mantenimiento de las ciudades; y guárdenlo.", "words": [[0, 263200], [2, 263318], [9, 263658], [14, 263878], [17, 264058], [27, 264558], [30, 264738], [36, 264918], [43, 265218], [48, 265578], [52, 265838], [60, 266218], [62, 266478], [71, 266938], [74, 267158], [80, 267518], [85, 267718], [88, 267918], [93, 268158], [96, 268498], [103, 268838], [108, 269098], [122, 269878], [125, 270018], [129, 270158], [139, 271126], [141, 271228]]}, {"verse": 36, "start": 272258, "end": 281076, "text": "Y esté aquella provisión en depósito para el país, para los siete años del hambre que serán en la tierra de Egipto; y el país no perecerá de hambre.", "words": [[0, 272258], [2, 272361], [7, 272581], [15, 272961], [25, 273541], [28, 273701], [37, 274301], [42, 274541], [45, 274681], [51, 275421], [56, 275681], [60, 275841], [66, 276101], [71, 276461], [75, 276741], [82, 277041], [86, 277201], [92, 277581], [95, 277661], [98, 277761], [105, 278061], [108, 278261], [116, 279061], [118, 279160], [121, 279260], [126, 279540], [129, 279880], [138, 280520], [141, 280600]]}, {"verse": 37, "start": 281356, "end": 284722, "text": "Y el asunto pareció bien a Faraón, y a sus siervos.", "words": [[0, 281356], [2, 281520], [5, 281620], [12, 282020], [20, 282540], [25, 282760], [27, 282900], [35, 283480], [37, 283725], [39, 283765], [43, 283945]]}, {"verse": 38, "start": 285072, "end": 290713, "text": "Y dijo Faraón a sus siervos: ¿Hemos de hallar otro hombre como este, en quien haya espíritu de Dios?", "words": [[0, 285072], [2, 285198], [7, 285458], [14, 285958], [16, 286038], [20, 286198], [29, 287192], [36, 287372], [39, 287572], [46, 287792], [51, 287992], [58, 288252], [63, 288472], [69, 289152], [72, 289312], [78, 289472], [83, 289652], [92, 290172], [95, 290272]]}, {"verse": 39, "start": 290993, "end": 297488, "text": "Y dijo Faraón a José: Pues que Dios te ha hecho saber todo esto, no hay entendido ni sabio como tú:", "words": [[0, 290993], [2, 291139], [7, 291559], [14, 291979], [16, 292179], [22, 292927], [27, 293057], [31, 293217], [36, 293457], [39, 293737], [42, 293877], [48, 294077], [54, 294357], [59, 294637], [65, 295577], [68, 295697], [72, 295897], [82, 296397], [85, 296517], [91, 296917], [96, 297097]]}, {"verse": 40, "start": 297838, "end": 304572, "text": "Tú serás sobre mi casa, y por tu palabra se gobernará todo mi pueblo: solamente en el trono seré yo mayor que tú.", "words": [[0, 297838], [3, 297922], [9, 298302], [15, 298562], [18, 298722], [24, 299062], [26, 299522], [30, 299702], [33, 299842], [41, 300202], [44, 300462], [54, 301002], [59, 301162], [62, 301362], [70, 302163], [80, 302584], [83, 302864], [86, 302984], [92, 303304], [97, 303604], [100, 303704], [106, 303984], [110, 304204]]}, {"verse": 41, "start": 304852, "end": 310092, "text": "Dijo más Faraón a José: He aquí yo te he puesto sobre toda la tierra de Egipto.", "words": [[0, 304852], [5, 305157], [9, 305477], [16, 306117], [18, 306317], [24, 307055], [27, 307194], [32, 307654], [35, 307754], [38, 307914], [41, 307994], [48, 308274], [54, 308574], [59, 308834], [62, 309054], [69, 309334], [72, 309554]]}, {"verse": 42, "start": 310372, "end": 321131, "text": "Entonces Faraón quitó su anillo de su mano, y lo puso en la mano de José, y le hizo vestir de ropas de lino finísimo, y puso un collar de oro en su cuello;", "words": [[0, 310372], [9, 311088], [16, 311838], [22, 312258], [25, 312438], [32, 312818], [35, 312978], [38, 313158], [44, 313478], [46, 313683], [49, 313803], [54, 314143], [57, 314283], [60, 314383], [65, 314603], [68, 314763], [74, 315103], [76, 315563], [79, 315723], [84, 315963], [91, 316543], [94, 316823], [100, 317103], [103, 317263], [108, 317563], [118, 318532], [120, 318793], [125, 319133], [128, 319413], [135, 319693], [138, 319853], [142, 320173], [145, 320333], [148, 320533]]}, {"verse": 43, "start": 321481, "end": 330437, "text": "Y lo hizo subir en su segundo carro, y pregonaron delante de él: Doblad la rodilla: y lo puso sobre toda la tierra de Egipto.", "words": [[0, 321481], [2, 321606], [5, 321766], [10, 322046], [16, 322526], [19, 322746], [22, 322926], [30, 323366], [37, 323926], [39, 324191], [50, 324871], [58, 325451], [61, 325651], [65, 326151], [72, 326556], [75, 326676], [84, 327545], [86, 327653], [89, 327793], [94, 328153], [100, 328433], [105, 328833], [108, 329093], [115, 329453], [118, 329713]]}, {"verse": 44, "start": 330787, "end": 337805, "text": "Y dijo Faraón a José: Yo Faraón; y sin ti ninguno alzará su mano ni su pie en toda la tierra de Egipto.", "words": [[0, 330787], [2, 330932], [7, 331352], [14, 331772], [16, 331972], [22, 332795], [25, 332905], [33, 333720], [35, 333809], [39, 333969], [42, 334209], [50, 334669], [57, 335069], [60, 335209], [65, 335469], [68, 335649], [71, 335849], [75, 336069], [78, 336409], [83, 336589], [86, 336789], [93, 337049], [96, 337249]]}, {"verse": 45, "start": 338085, "end": 350531, "text": "Y llamó Faraón el nombre de José, Zafnat-panea; y le dio por mujer a Asenat, hija de Potifera, sacerdote de On. Y salió José por toda la tierra de Egipto.", "words": [[0, 338085], [2, 338194], [8, 338594], [15, 338994], [18, 339094], [25, 339394], [28, 339614], [34, 340602], [48, 341769], [50, 342066], [53, 342186], [57, 342406], [61, 342646], [67, 343026], [69, 343326], [77, 344446], [82, 344886], [85, 345006], [95, 345906], [105, 346342], [108, 346777], [112, 347391], [114, 347658], [120, 348018], [125, 348398], [129, 348698], [134, 349018], [137, 349258], [144, 349538], [147, 349838]]}, {"verse": 46, "start": 350881, "end": 362879, "text": "Y era José de edad de treinta años cuando fue presentado delante de Faraón, rey de Egipto: y salió José de delante de Faraón, y transitó por toda la tierra de Egipto.", "words": [[0, 350881], [2, 351042], [6, 351222], [11, 351502], [14, 351782], [19, 352142], [22, 352412], [30, 352682], [35, 353182], [42, 353402], [46, 353722], [57, 354462], [65, 354962], [68, 355122], [76, 356002], [80, 356442], [83, 356582], [91, 357543], [93, 357669], [99, 358009], [104, 358349], [107, 358529], [115, 359029], [118, 359409], [126, 359789], [128, 360269], [137, 360869], [141, 361149], [146, 361389], [149, 361649], [156, 361989], [159, 362209]]}, {"verse": 47, "start": 363229, "end": 368014, "text": "E hizo la tierra en aquellos siete años de abundancia a montones.", "words": [[0, 363229], [2, 363372], [7, 363632], [10, 363832], [17, 364252], [20, 364472], [29, 364752], [35, 365392], [40, 365892], [43, 366112], [54, 366892], [56, 367152]]}, {"verse": 48, "start": 368364, "end": 381097, "text": "Y él juntó todo el alimento de los siete años que fueron en la tierra de Egipto, y guardó alimento en las ciudades, poniendo en cada ciudad el alimento del campo de sus alrededores.", "words": [[0, 368364], [2, 368528], [5, 368668], [11, 369128], [16, 369388], [19, 369608], [28, 370048], [31, 370288], [35, 370408], [41, 370708], [46, 371228], [50, 371468], [57, 371768], [60, 372008], [63, 372108], [70, 372448], [73, 372668], [81, 373308], [83, 373988], [90, 374428], [99, 374968], [102, 375188], [106, 375368], [116, 376583], [125, 377007], [128, 377167], [133, 377427], [140, 377827], [143, 378167], [152, 378667], [156, 378927], [162, 379387], [165, 379647], [169, 379787]]}, {"verse": 49, "start": 381447, "end": 388742, "text": "Y acumuló José trigo como arena del mar, mucho en extremo, hasta no poderse contar, porque no tenía número.", "words": [[0, 381447], [2, 381586], [10, 382186], [15, 382466], [21, 382966], [26, 383246], [32, 383586], [36, 383866], [41, 384706], [47, 385046], [50, 385186], [59, 386206], [65, 386446], [68, 386626], [76, 387046], [84, 387386], [91, 387726], [94, 387906], [100, 388206]]}, {"verse": 50, "start": 389092, "end": 398718, "text": "Y nacieron a José dos hijos antes que viniese el primer año del hambre, los cuales le parió Asenat, hija de Potifera, sacerdote de On.", "words": [[0, 389092], [2, 389237], [11, 389717], [13, 389877], [18, 390137], [22, 390397], [28, 390717], [34, 391097], [38, 391477], [46, 391857], [49, 392077], [56, 392397], [60, 392737], [64, 392957], [72, 393377], [76, 393797], [83, 394217], [86, 394357], [92, 395097], [100, 395837], [105, 396097], [108, 396197], [118, 397297], [128, 397790], [131, 398283]]}, {"verse": 51, "start": 399068, "end": 409024, "text": "Y llamó José el nombre del primogénito Manasés; porque Dios ( dijo ) me hizo olvidar todo mi trabajo, y toda la casa de mi padre.", "words": [[0, 399068], [2, 399344], [8, 399624], [13, 399964], [16, 400264], [23, 400684], [27, 400964], [39, 401837], [48, 402866], [55, 403149], [60, 403589], [62, 404029], [67, 404489], [69, 404949], [72, 405109], [77, 405409], [85, 406049], [90, 406289], [93, 406549], [102, 407049], [104, 407334], [109, 407514], [112, 407754], [117, 408014], [120, 408234], [123, 408374]]}, {"verse": 52, "start": 409374, "end": 417534, "text": "Y el nombre del segundo lo llamó Efraín; porque Dios ( dijo ) me hizo fértil en la tierra de mi aflicción.", "words": [[0, 409374], [2, 409520], [5, 409660], [12, 410040], [16, 410320], [24, 410760], [27, 411020], [33, 411400], [41, 412508], [48, 412726], [53, 412866], [55, 413006], [60, 413496], [62, 413986], [65, 414206], [70, 414446], [77, 415006], [80, 415266], [83, 415366], [90, 415646], [93, 415826], [96, 415926]]}, {"verse": 53, "start": 417814, "end": 422940, "text": "Y se cumplieron los siete años de la abundancia, que hubo en la tierra de Egipto.", "words": [[0, 417814], [2, 417921], [5, 418041], [16, 418721], [20, 418901], [26, 419181], [31, 419541], [34, 419741], [37, 419901], [49, 421001], [53, 421206], [58, 421506], [61, 421586], [64, 421706], [71, 421986], [74, 422266]]}, {"verse": 54, "start": 423290, "end": 433429, "text": "Y comenzaron a venir los siete años del hambre, como José había dicho: y hubo hambre en todos los países, mas en toda la tierra de Egipto había pan.", "words": [[0, 423290], [2, 423380], [13, 424020], [15, 424140], [21, 424400], [25, 424620], [31, 424980], [36, 425360], [40, 425580], [48, 426240], [53, 426460], [58, 426760], [64, 427040], [71, 427842], [73, 427999], [78, 428319], [85, 428839], [88, 429159], [94, 429379], [98, 429619], [106, 430199], [110, 430779], [113, 431039], [118, 431199], [121, 431419], [128, 431739], [131, 431979], [138, 432419], [144, 432859]]}, {"verse": 55, "start": 433779, "end": 445618, "text": "Y cuando se sintió el hambre en toda la tierra de Egipto, el pueblo clamó a Faraón por pan. Y dijo Faraón a todos los egipcios: Id a José, y haced lo que él os diga.", "words": [[0, 433779], [2, 433888], [9, 434128], [12, 434388], [19, 434908], [22, 435048], [29, 435448], [32, 435728], [37, 435968], [40, 436208], [47, 436588], [50, 436768], [58, 437908], [61, 438028], [68, 438508], [74, 438988], [76, 439088], [83, 439548], [87, 439768], [92, 440632], [94, 440732], [99, 441162], [106, 441592], [108, 441752], [114, 442032], [118, 442292], [128, 443393], [131, 443493], [133, 443593], [139, 443933], [141, 444273], [147, 444573], [150, 444733], [154, 444893], [157, 445033], [160, 445153]]}, {"verse": 56, "start": 445898, "end": 458649, "text": "Y el hambre estaba por toda la extensión del país. Entonces abrió José todo granero donde había, y vendía a los egipcios; porque había crecido el hambre en la tierra de Egipto.", "words": [[0, 445898], [2, 446044], [5, 446204], [12, 446684], [19, 446964], [23, 447304], [28, 447564], [31, 447824], [41, 448544], [45, 448764], [51, 449750], [60, 450377], [66, 451137], [71, 451457], [76, 451737], [84, 452337], [90, 452557], [97, 453057], [99, 453352], [106, 453932], [108, 454132], [112, 454272], [122, 455390], [129, 455755], [135, 456175], [143, 456595], [146, 456775], [153, 457135], [156, 457335], [159, 457435], [166, 457695], [169, 457995]]}, {"verse": 57, "start": 458999, "end": 466353, "text": "Y toda la tierra venía a Egipto para comprar de José, porque por toda la tierra había crecido el hambre.", "words": [[0, 458999], [2, 459123], [7, 459403], [10, 459643], [17, 460103], [23, 460783], [25, 461003], [32, 461603], [37, 461803], [45, 462223], [48, 462643], [54, 463063], [61, 463468], [65, 463748], [70, 464048], [73, 464308], [80, 464708], [86, 465068], [94, 465668], [97, 465848]]}]}