{"book": "MAT", "chapter": 21, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 396132, "verses": [{"verse": 1, "start": 300, "end": 9267, "text": "Y como se acercaron a Jerusalén, y vinieron a Betfagé, al monte de los Olivos, entonces Jesús envió dos discípulos,", "words": [[0, 300], [2, 401], [7, 601], [10, 801], [20, 1481], [22, 1601], [33, 2461], [35, 2721], [44, 3241], [46, 3791], [55, 4341], [58, 4721], [64, 5021], [67, 5221], [71, 5361], [79, 6221], [88, 6661], [94, 7281], [100, 8041], [104, 8341]]}, {"verse": 2, "start": 9617, "end": 20655, "text": "Diciéndoles: Id a la aldea que está delante de vosotros, y luego hallaréis una asna atada, y un pollino con ella: desatadla, y traédmelos.", "words": [[0, 9617], [13, 10903], [16, 11023], [18, 11283], [21, 11403], [27, 11843], [31, 12003], [36, 12183], [44, 12603], [47, 12763], [57, 13303], [59, 13763], [65, 14003], [75, 14723], [79, 15023], [84, 15643], [91, 16283], [93, 16703], [96, 16843], [104, 17283], [108, 17503], [114, 19107], [125, 19377], [127, 20039]]}, {"verse": 3, "start": 21005, "end": 27113, "text": "Y si alguno os dice algo, decid: El Señor los necesita. Y luego los dejará.", "words": [[0, 21005], [2, 21130], [5, 21250], [12, 21730], [15, 21850], [20, 22110], [26, 22850], [33, 23702], [36, 23846], [42, 24166], [46, 24586], [56, 25881], [58, 26004], [64, 26204], [68, 26464]]}, {"verse": 4, "start": 27463, "end": 32984, "text": "Y todo esto fue hecho, para que se cumpliese lo que fue dicho por el profeta, que dijo:", "words": [[0, 27463], [2, 27724], [7, 27964], [12, 28304], [16, 28584], [23, 28964], [28, 29279], [32, 29439], [35, 29599], [45, 30259], [48, 30479], [52, 30599], [56, 30799], [62, 31119], [66, 31399], [69, 31539], [78, 32299], [82, 32479]]}, {"verse": 5, "start": 33334, "end": 43518, "text": "Decid a la hija de Sion: He aquí, tu Rey viene a ti, manso, y sentado sobre una asna, y sobre un pollino, hijo de bestia de carga.", "words": [[0, 33334], [6, 34138], [8, 34338], [11, 34438], [16, 34818], [19, 34918], [25, 35795], [28, 35885], [34, 36105], [37, 36325], [41, 36705], [47, 36885], [49, 37105], [53, 37645], [60, 38245], [62, 38485], [70, 39045], [76, 39325], [80, 39625], [86, 40125], [88, 40525], [94, 40765], [97, 40965], [106, 42005], [111, 42145], [114, 42345], [121, 42745], [124, 42885]]}, {"verse": 6, "start": 43868, "end": 48093, "text": "Y los discípulos fueron, e hicieron como Jesús les mandó;", "words": [[0, 43868], [2, 43973], [6, 44093], [17, 44833], [25, 45273], [27, 45853], [36, 46373], [41, 46633], [47, 47013], [51, 47573]]}, {"verse": 7, "start": 48443, "end": 55075, "text": "Y trajeron el asna y el pollino, y pusieron sobre ellos sus mantos; y se sentó sobre ellos.", "words": [[0, 48443], [2, 48567], [11, 49187], [14, 49407], [19, 49847], [21, 50067], [24, 50227], [33, 50847], [35, 51032], [44, 51512], [50, 51832], [56, 52152], [60, 52705], [68, 53420], [70, 53545], [73, 53665], [79, 54085], [85, 54365]]}, {"verse": 8, "start": 55425, "end": 64813, "text": "Y la multitud, que era muy numerosa, tendía sus mantos en el camino: y otros cortaban ramas de los árboles, y los tendían por el camino.", "words": [[0, 55425], [2, 55511], [5, 55631], [15, 56171], [19, 56351], [23, 56511], [27, 56691], [37, 57331], [44, 58151], [48, 58351], [55, 58931], [58, 59091], [61, 59211], [69, 60103], [71, 60279], [77, 60499], [86, 61139], [92, 61779], [95, 61959], [99, 62079], [108, 62659], [110, 63079], [114, 63219], [122, 63779], [126, 64019], [129, 64119]]}, {"verse": 9, "start": 65163, "end": 75611, "text": "Y la gente que iba delante y la que iba detrás aclamaba diciendo: ¡Hosanna al Hijo de David! ¡Bendito el que viene en el nombre del Señor! ¡Hosanna en las alturas!", "words": [[0, 65163], [2, 65251], [5, 65371], [11, 65631], [15, 65851], [19, 66221], [27, 66591], [29, 67071], [32, 67191], [36, 67331], [40, 67571], [47, 68191], [56, 68866], [66, 69890], [75, 70160], [78, 70480], [83, 70700], [86, 70820], [93, 71470], [102, 71968], [105, 72068], [109, 72188], [115, 72508], [118, 72708], [121, 72828], [128, 73108], [132, 73308], [139, 74283], [148, 74533], [151, 74713], [155, 74833]]}, {"verse": 10, "start": 75891, "end": 82542, "text": "Y entrando él en Jerusalén, toda la ciudad se alborotó, diciendo: ¿Quién es este?", "words": [[0, 75891], [2, 76048], [11, 76588], [14, 76928], [17, 77128], [28, 78368], [33, 78568], [36, 78868], [43, 79228], [46, 79648], [56, 80768], [66, 81730], [73, 81971], [76, 82091]]}, {"verse": 11, "start": 82822, "end": 87577, "text": "Y la gente decía: Este es Jesús, el profeta, de Nazaret de Galilea.", "words": [[0, 82822], [2, 82924], [5, 83024], [11, 83384], [18, 84457], [23, 84698], [26, 84878], [33, 85238], [36, 85458], [45, 86278], [48, 86358], [56, 86798], [59, 86978]]}, {"verse": 12, "start": 87857, "end": 99712, "text": "Y entró Jesús en el templo de Dios, y echó fuera todos los que vendían y compraban en el templo, y volcó las mesas de los cambistas, y las sillas de los que vendían palomas;", "words": [[0, 87857], [2, 88001], [8, 88401], [14, 88741], [17, 89041], [20, 89181], [27, 89641], [30, 89721], [36, 90021], [38, 90291], [43, 90561], [49, 90881], [55, 91301], [59, 91621], [63, 91801], [71, 92361], [73, 92481], [83, 93221], [86, 93361], [89, 93541], [97, 94341], [99, 94481], [105, 94801], [109, 95121], [115, 95441], [118, 95661], [122, 96211], [133, 96938], [135, 97042], [139, 97202], [146, 97722], [149, 98122], [153, 98222], [157, 98362], [165, 98782]]}, {"verse": 13, "start": 100062, "end": 107967, "text": "Y les dice: Escrito está: Mi casa, casa de oración será llamada; pero vosotros cueva de ladrones la habéis hecho.", "words": [[0, 100062], [2, 100188], [6, 100328], [12, 101138], [20, 101738], [26, 102520], [29, 102685], [35, 103245], [40, 103445], [43, 103665], [51, 104137], [56, 104609], [65, 105243], [70, 105503], [79, 105973], [85, 106443], [88, 106563], [97, 106883], [100, 107203], [107, 107503]]}, {"verse": 14, "start": 108317, "end": 112772, "text": "Entonces vinieron a él ciegos y cojos en el templo, y los sanó.", "words": [[0, 108317], [9, 108754], [18, 109414], [20, 109574], [23, 109794], [30, 110354], [32, 110494], [38, 110874], [41, 111074], [44, 111214], [52, 111974], [54, 112114], [58, 112274]]}, {"verse": 15, "start": 113122, "end": 124721, "text": "Pero los príncipes de los sacerdotes y los escribas, viendo las maravillas que hacía, y a los muchachos aclamando en el templo y diciendo: ¡Hosanna al Hijo de David! se indignaron,", "words": [[0, 113122], [5, 113286], [9, 113466], [19, 114166], [22, 114286], [26, 114426], [37, 115206], [39, 115386], [43, 115526], [53, 116166], [60, 116659], [64, 117153], [75, 117646], [79, 117826], [86, 118246], [88, 118451], [90, 118531], [94, 118631], [104, 119191], [114, 119771], [117, 119891], [120, 120031], [127, 120591], [129, 120631], [139, 121858], [148, 122128], [151, 122448], [156, 122668], [159, 122788], [166, 123498], [169, 123715]]}, {"verse": 16, "start": 125071, "end": 136354, "text": "Y le dijeron: ¿Oyes lo que estos dicen? Y Jesús les dice: Sí: ¿nunca leísteis: De la boca de los niños y de los niños de pecho perfeccionaste la alabanza?", "words": [[0, 125071], [2, 125253], [5, 125333], [14, 126474], [20, 126757], [23, 126937], [27, 127097], [33, 127277], [40, 128243], [42, 128389], [48, 128749], [52, 129209], [58, 130042], [62, 130621], [69, 131045], [79, 132137], [82, 132232], [85, 132332], [90, 132552], [93, 132712], [97, 132852], [103, 133152], [105, 133392], [108, 133472], [112, 133592], [118, 133832], [121, 134032], [127, 134452], [142, 135352], [145, 135572]]}, {"verse": 17, "start": 136704, "end": 141723, "text": "Y dejándolos, se salió fuera de la ciudad, a Betania; y pasó allí la noche.", "words": [[0, 136704], [2, 136987], [14, 137687], [17, 137927], [23, 138267], [29, 138507], [32, 138707], [35, 138807], [43, 139127], [45, 139467], [54, 140286], [56, 140387], [61, 140697], [66, 141007], [69, 141187]]}, {"verse": 18, "start": 142073, "end": 145137, "text": "Y por la mañana volviendo a la ciudad, tuvo hambre.", "words": [[0, 142073], [2, 142200], [6, 142380], [9, 142540], [16, 142860], [26, 143520], [28, 143640], [31, 143700], [39, 144040], [44, 144420]]}, {"verse": 19, "start": 145487, "end": 158297, "text": "Y viendo una higuera cerca del camino, vino a ella, y no halló nada en ella, sino hojas solamente; y le dijo: Nunca más para siempre nazca de ti fruto. Y luego se secó la higuera.", "words": [[0, 145487], [2, 145610], [9, 145970], [13, 146370], [21, 146990], [27, 147330], [31, 147650], [39, 148130], [44, 148710], [46, 148910], [52, 149190], [54, 149410], [57, 149610], [63, 149930], [68, 150150], [71, 150410], [77, 150710], [82, 151050], [88, 151650], [99, 152881], [101, 153008], [104, 153108], [110, 153802], [116, 154161], [120, 154301], [125, 154521], [133, 155081], [139, 155386], [142, 155691], [145, 155996], [152, 156521], [154, 156619], [160, 156819], [163, 157059], [168, 157439], [171, 157579]]}, {"verse": 20, "start": 158647, "end": 164121, "text": "Y viendo esto los discípulos, maravillados decían: ¿Cómo se secó luego la higuera?", "words": [[0, 158647], [2, 158772], [9, 159072], [14, 159412], [18, 159612], [30, 160392], [43, 161492], [51, 162522], [57, 162706], [60, 162886], [65, 163266], [71, 163386], [74, 163626]]}, {"verse": 21, "start": 164401, "end": 179163, "text": "Y respondiendo Jesús les dijo: De cierto os digo, que si tenéis fe, y no dudáis, no sólo haréis esto de la higuera: sino que si a este monte decís: Quítate y échate en el mar, será hecho.", "words": [[0, 164492], [2, 164622], [15, 165602], [21, 165862], [25, 166102], [31, 166938], [34, 167103], [41, 167463], [44, 167923], [50, 168663], [54, 168983], [57, 169143], [64, 169603], [68, 169963], [70, 170323], [73, 170463], [81, 171583], [84, 171763], [89, 172103], [96, 172483], [101, 172763], [104, 172943], [107, 173368], [116, 173973], [121, 174193], [125, 174373], [128, 174553], [130, 174673], [135, 174873], [141, 175213], [148, 176339], [156, 176741], [158, 177021], [165, 177421], [168, 177561], [171, 177701], [176, 178261], [181, 178521]]}, {"verse": 22, "start": 179513, "end": 184010, "text": "Y todo lo que pidáis en oración, creyendo, lo recibiréis.", "words": [[0, 179513], [2, 179640], [7, 179940], [10, 180160], [14, 180460], [21, 180760], [24, 180940], [33, 181800], [43, 182520], [46, 182960]]}, {"verse": 23, "start": 184360, "end": 197896, "text": "Y cuando vino al templo, se llegaron a él cuando estaba enseñando, los príncipes de los sacerdotes y los ancianos del pueblo, diciendo: ¿Con qué autoridad haces esto? ¿y quién te dio esta autoridad?", "words": [[0, 184360], [2, 184465], [9, 184685], [14, 184965], [17, 185185], [25, 186085], [28, 186245], [37, 186725], [39, 186925], [42, 187125], [49, 187365], [56, 187885], [67, 188765], [71, 189245], [81, 190205], [84, 190345], [88, 190465], [99, 191385], [101, 191545], [105, 191705], [114, 192245], [118, 192365], [126, 192785], [136, 194198], [141, 194318], [145, 194558], [155, 195098], [161, 195478], [167, 196225], [170, 196352], [176, 196532], [179, 196712], [183, 196952], [188, 197212]]}, {"verse": 24, "start": 198176, "end": 207772, "text": "Y respondiendo Jesús, les dijo: Yo también os haré una pregunta, la cual si me decís, también yo os diré con qué autoridad hago esto.", "words": [[0, 198176], [2, 198298], [15, 199078], [22, 199438], [26, 199798], [32, 200630], [35, 200837], [43, 201157], [46, 201477], [51, 201777], [55, 201897], [65, 202917], [68, 202997], [73, 203157], [76, 203377], [79, 203517], [86, 204557], [94, 204857], [97, 205217], [100, 205437], [105, 205817], [109, 205997], [113, 206257], [123, 206957], [128, 207217]]}, {"verse": 25, "start": 208122, "end": 220778, "text": "El bautismo de Juan, ¿de dónde era? ¿del cielo, o de los hombres? Ellos entonces pensaron entre sí, diciendo: Si decimos, del cielo, nos dirá: ¿Por qué pues no le creísteis?", "words": [[0, 208122], [3, 208488], [12, 209028], [15, 209208], [21, 209748], [25, 209968], [31, 210208], [36, 210999], [41, 211245], [48, 211765], [50, 212245], [53, 212345], [57, 212465], [66, 213508], [72, 213832], [81, 214272], [90, 215172], [96, 215492], [100, 216232], [110, 217177], [113, 217289], [122, 217769], [126, 217949], [133, 218249], [137, 218489], [143, 219127], [148, 219268], [152, 219468], [157, 219688], [160, 219848], [163, 219968]]}, {"verse": 26, "start": 221128, "end": 226488, "text": "Y si decimos, de los hombres, tememos al pueblo; porque todos tienen a Juan por profeta.", "words": [[0, 221128], [2, 221251], [5, 221351], [14, 221831], [17, 221991], [21, 222131], [30, 222431], [38, 223031], [41, 223231], [49, 224101], [56, 224421], [62, 224781], [69, 225221], [71, 225381], [76, 225621], [80, 225841]]}, {"verse": 27, "start": 226768, "end": 234575, "text": "Y respondiendo a Jesús, dijeron: No sabemos. Y él también les dijo: Ni yo os digo con qué autoridad hago esto.", "words": [[0, 226768], [2, 227163], [15, 227593], [17, 227753], [24, 228493], [33, 229388], [36, 229546], [45, 230572], [47, 230737], [50, 230877], [58, 231157], [62, 231377], [68, 232060], [71, 232225], [74, 232465], [77, 232565], [82, 232765], [86, 233025], [90, 233205], [100, 233765], [105, 234065]]}, {"verse": 28, "start": 234925, "end": 243009, "text": "Pero, ¿qué os parece? Un hombre tenía dos hijos, y llegando al primero, le dijo: Hijo, ve hoy a trabajar en mi viña.", "words": [[0, 234925], [6, 235109], [11, 235349], [14, 235489], [22, 236317], [25, 236464], [32, 236704], [38, 237124], [42, 237484], [49, 237924], [51, 238464], [60, 238924], [63, 239044], [72, 239384], [75, 239624], [81, 240312], [87, 240716], [90, 241076], [94, 241456], [96, 241596], [105, 242036], [108, 242256], [111, 242416]]}, {"verse": 29, "start": 243359, "end": 248030, "text": "Y respondiendo él, dijo: No quiero; pero después, arrepentido, fue.", "words": [[0, 243359], [2, 243465], [15, 244225], [19, 244325], [25, 245078], [28, 245382], [36, 246168], [41, 246312], [50, 246672], [63, 247592]]}, {"verse": 30, "start": 248380, "end": 256212, "text": "Y llegando al otro, le dijo de la misma manera; y respondiendo él, dijo: Yo, señor, voy. Y no fue.", "words": [[0, 248380], [2, 248477], [11, 248917], [14, 249057], [20, 249697], [23, 249897], [28, 250197], [31, 250337], [34, 250457], [40, 250677], [48, 251776], [50, 252076], [63, 252796], [67, 253176], [73, 254415], [77, 254605], [84, 255025], [89, 255615], [91, 255738], [94, 255838]]}, {"verse": 31, "start": 256562, "end": 268505, "text": "¿Cuál de los dos hizo la voluntad de su padre? Dicen ellos: El primero. Les dice Jesús: De cierto os digo, que los publicanos y las prostitutas os van delante al reino de Dios.", "words": [[0, 256562], [6, 256926], [9, 257066], [13, 257226], [17, 257486], [22, 257926], [25, 258166], [34, 258786], [37, 258906], [40, 259066], [47, 259875], [53, 260184], [60, 261129], [63, 261209], [72, 262143], [76, 262253], [81, 262533], [88, 263383], [91, 263548], [98, 263868], [101, 264248], [107, 264628], [111, 264808], [115, 264968], [126, 265648], [128, 265808], [132, 265928], [144, 266628], [147, 266728], [151, 266928], [159, 267368], [162, 267508], [168, 267848], [171, 268008]]}, {"verse": 32, "start": 268855, "end": 282636, "text": "Porque vino a vosotros Juan en camino de justicia, y no le creísteis; y los publicanos y las prostitutas le creyeron; y vosotros, viendo esto, no os arrepentisteis después para creerle.", "words": [[0, 268855], [7, 269228], [12, 269508], [14, 269668], [23, 270108], [28, 270508], [31, 270988], [38, 271308], [41, 271548], [51, 272268], [53, 272708], [56, 272848], [59, 272968], [70, 274190], [72, 274335], [76, 274435], [87, 275155], [89, 275315], [93, 275455], [105, 276255], [108, 276415], [118, 277434], [120, 277544], [130, 278264], [137, 278544], [143, 279444], [146, 279644], [149, 279864], [164, 281064], [172, 281444], [177, 281804]]}, {"verse": 33, "start": 282986, "end": 300073, "text": "Oíd otra parábola: fue un hombre, padre de familia, el cual plantó una viña; y la rodeó con una cerca, y cavó en ella un lagar para prensar uvas, y edificó una torre, y la arrendó a labradores, y se fue lejos.", "words": [[0, 283051], [4, 283568], [9, 283948], [19, 285078], [23, 285241], [26, 285441], [34, 286201], [40, 286521], [43, 286741], [52, 287441], [55, 287581], [60, 287801], [67, 288601], [71, 288841], [77, 289827], [79, 289969], [82, 290279], [88, 290589], [92, 290789], [96, 290969], [103, 291409], [105, 291882], [110, 292354], [113, 292454], [118, 292634], [121, 292834], [127, 293294], [132, 293534], [140, 294154], [146, 294694], [148, 295494], [156, 296074], [160, 296234], [167, 296834], [169, 297194], [172, 297354], [180, 298054], [182, 298134], [194, 298774], [196, 299014], [199, 299154], [203, 299354]]}, {"verse": 34, "start": 300423, "end": 308250, "text": "Y cuando se acercó el tiempo de los frutos, envió sus siervos a los labradores, para que recibiesen sus frutos.", "words": [[0, 300423], [2, 300533], [9, 300773], [12, 301033], [19, 301573], [22, 301693], [29, 302013], [32, 302213], [36, 302353], [44, 303293], [50, 303833], [54, 304033], [62, 304593], [64, 304773], [68, 304913], [80, 305713], [85, 306393], [89, 306553], [100, 307293], [104, 307553]]}, {"verse": 35, "start": 308600, "end": 315707, "text": "Pero los labradores, tomando a los siervos, al uno hirieron, y al otro mataron, y al otro apedrearon.", "words": [[0, 308600], [5, 308748], [9, 308908], [21, 309548], [29, 310088], [31, 310168], [35, 310288], [44, 310788], [47, 311048], [51, 311704], [61, 312360], [63, 312463], [66, 312583], [71, 312803], [80, 313963], [82, 314003], [85, 314163], [90, 314443]]}, {"verse": 36, "start": 316057, "end": 322139, "text": "Envió de nuevo otros siervos, más que los primeros; e hicieron con ellos de la misma manera.", "words": [[0, 316057], [6, 316520], [9, 316640], [15, 316900], [21, 317340], [30, 317980], [34, 318300], [38, 318500], [42, 318640], [52, 319607], [54, 319742], [63, 320322], [67, 320562], [73, 320862], [76, 321042], [79, 321162], [85, 321362]]}, {"verse": 37, "start": 322489, "end": 327793, "text": "Y finalmente les envió su hijo, diciendo: Tendrán respeto a mi hijo.", "words": [[0, 322489], [2, 322743], [13, 323103], [17, 323603], [23, 324063], [26, 324283], [32, 324583], [42, 325664], [50, 326312], [58, 327012], [60, 327152], [63, 327292]]}, {"verse": 38, "start": 328143, "end": 336648, "text": "Pero los labradores, viendo al hijo, dijeron entre sí: Este es el heredero; venid, matémosle, y tomemos su herencia.", "words": [[0, 328143], [5, 328564], [9, 328764], [21, 329444], [28, 329604], [31, 329824], [37, 330144], [45, 330604], [51, 330844], [55, 331467], [60, 331753], [63, 332013], [66, 332551], [76, 333253], [83, 333739], [94, 334499], [96, 334919], [104, 335339], [107, 335819]]}, {"verse": 39, "start": 336998, "end": 340510, "text": "Y tomado, le echaron fuera de la viña, y le mataron.", "words": [[0, 336998], [2, 337121], [10, 337601], [13, 337801], [21, 338281], [27, 338561], [30, 338781], [33, 338921], [39, 339381], [41, 339581], [44, 339681]]}, {"verse": 40, "start": 340860, "end": 345246, "text": "Pues cuando venga el señor de la viña, ¿qué hará a aquellos labradores?", "words": [[0, 340860], [5, 340964], [12, 341284], [18, 341604], [21, 341704], [27, 341984], [30, 342224], [33, 342344], [39, 342944], [44, 343244], [49, 343494], [51, 343744], [60, 344104]]}, {"verse": 41, "start": 345596, "end": 353453, "text": "Le dicen: a los malos destruirá miserablemente, y su viña dará en arriendo a otros labradores, que le paguen el fruto a sus tiempos.", "words": [[0, 345596], [3, 346027], [10, 346665], [12, 346764], [16, 346864], [22, 347264], [32, 347844], [48, 348744], [50, 348919], [53, 349099], [58, 349439], [63, 349699], [66, 349799], [75, 350279], [77, 350399], [83, 350599], [95, 351299], [99, 351659], [102, 351779], [109, 352119], [112, 352329], [118, 352539], [120, 352619], [124, 352739]]}, {"verse": 42, "start": 353733, "end": 367872, "text": "Les dice Jesús: ¿Nunca leísteis en las Escrituras: La piedra que desecharon los que edificaban, esta fue hecha por piedra angular: por el Señor es hecho esto, y es cosa maravillosa en nuestros ojos?", "words": [[0, 353806], [4, 353916], [9, 354196], [16, 355046], [23, 355534], [32, 356334], [35, 356474], [39, 356634], [51, 357764], [54, 357871], [61, 358351], [65, 358491], [76, 359231], [80, 359431], [84, 359591], [96, 360691], [101, 360931], [105, 361171], [111, 361411], [115, 361651], [122, 362111], [131, 363126], [135, 363510], [138, 363670], [144, 363970], [147, 364270], [153, 364530], [159, 364930], [161, 365210], [164, 365370], [169, 365630], [181, 366690], [184, 366830], [193, 367070]]}, {"verse": 43, "start": 368222, "end": 374797, "text": "Por tanto os digo, que el reino de Dios será quitado de vosotros, y será dado a gente que haga los frutos de él.", "words": [[0, 368222], [4, 368348], [10, 368518], [13, 368688], [19, 369088], [23, 369328], [26, 369468], [32, 369868], [35, 370028], [40, 370268], [45, 370548], [53, 371108], [56, 371288], [66, 371828], [68, 372213], [73, 372453], [78, 372733], [80, 372893], [86, 373153], [90, 373413], [95, 373593], [99, 373813], [106, 374213], [109, 374413]]}, {"verse": 44, "start": 375147, "end": 381758, "text": "Y el que caiga sobre esta piedra, será quebrantado; y sobre quien ella caiga, lo aplastará.", "words": [[0, 375147], [2, 375254], [5, 375374], [9, 375534], [15, 375974], [21, 376274], [26, 376494], [34, 377054], [39, 377884], [52, 378882], [54, 379039], [60, 379299], [66, 379579], [71, 379899], [78, 380539], [81, 381149]]}, {"verse": 45, "start": 382108, "end": 390229, "text": "Y oyendo los príncipes de los sacerdotes y los fariseos sus parábolas, entendieron que hablaba de ellos.", "words": [[0, 382575], [2, 383055], [9, 383415], [13, 383635], [23, 384335], [26, 384475], [30, 384595], [41, 385495], [43, 385695], [47, 385835], [56, 386795], [60, 386995], [71, 388195], [83, 388915], [87, 389135], [95, 389575], [98, 389715]]}, {"verse": 46, "start": 390579, "end": 395732, "text": "Y buscando cómo echarle mano, temieron al pueblo; porque le tenían por profeta.", "words": [[0, 390579], [2, 390854], [11, 391154], [16, 391534], [24, 391941], [30, 392347], [39, 392754], [42, 392934], [50, 393843], [57, 394067], [60, 394227], [67, 394587], [71, 394907]]}]}