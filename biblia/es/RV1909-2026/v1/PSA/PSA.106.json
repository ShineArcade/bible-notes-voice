{"book": "PSA", "chapter": 106, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 302582, "verses": [{"verse": 1, "start": 300, "end": 7030, "text": "Aleluya. Alabad a Jehová, porque es bueno; porque para siempre es su misericordia.", "words": [[0, 770], [9, 1514], [16, 1514], [18, 2166], [26, 2586], [33, 2846], [36, 3046], [43, 3998], [50, 4205], [55, 4465], [63, 4865], [66, 5065], [69, 5265]]}, {"verse": 2, "start": 7480, "end": 12487, "text": "¿Quién expresará las valentías de Jehová? ¿ quién contará sus alabanzas?", "words": [[0, 7650], [7, 7844], [17, 8037], [21, 8417], [31, 9297], [34, 9537], [42, 10532], [44, 10532], [50, 10816], [58, 11276], [62, 11456]]}, {"verse": 3, "start": 12937, "end": 17833, "text": "Dichosos los que guardan juicio, los que hacen justicia en todo tiempo.", "words": [[0, 12937], [9, 13624], [13, 13864], [17, 14064], [25, 14484], [33, 15504], [37, 15784], [41, 15944], [47, 16244], [56, 16844], [59, 17004], [64, 17164]]}, {"verse": 4, "start": 18283, "end": 25293, "text": "Acuérdate de mí, oh Jehová, según tu benevolencia para con tu pueblo: visítame con tu salvación;", "words": [[0, 18283], [10, 18983], [13, 19283], [17, 19596], [20, 19910], [28, 20223], [34, 20523], [37, 20883], [50, 21763], [55, 21983], [59, 22243], [62, 22423], [70, 23362], [79, 24011], [83, 24271], [86, 24431]]}, {"verse": 5, "start": 25743, "end": 33761, "text": "Para que yo vea el bien de tus escogidos, para que me goce en la alegría de tu nación, y me gloríe con tu heredad.", "words": [[0, 25743], [5, 25868], [9, 26008], [12, 26188], [16, 26548], [19, 26768], [24, 27048], [27, 27288], [31, 27468], [42, 28528], [47, 28988], [51, 29148], [54, 29288], [59, 29708], [62, 29928], [65, 30088], [73, 30668], [76, 30828], [79, 30988], [87, 31608], [89, 32028], [92, 32168], [99, 32708], [103, 32928], [106, 33148]]}, {"verse": 6, "start": 34211, "end": 39498, "text": "Pecamos con nuestros padres, hicimos iniquidad, hicimos impiedad.", "words": [[0, 34437], [8, 34697], [12, 35017], [21, 35297], [29, 36317], [37, 37157], [48, 37997], [56, 38497]]}, {"verse": 7, "start": 39948, "end": 50557, "text": "Nuestros padres en Egipto no entendieron tus maravillas; no se acordaron de la muchedumbre de tus misericordias; sino que se rebelaron junto al mar, en el Mar Rojo.", "words": [[0, 39948], [9, 40632], [16, 40972], [19, 41272], [26, 41732], [29, 41892], [41, 42452], [45, 42692], [57, 43888], [60, 44180], [63, 44320], [73, 44900], [76, 45080], [79, 45220], [91, 45880], [94, 46020], [98, 46160], [113, 47583], [118, 47784], [122, 47964], [125, 48354], [135, 48744], [141, 48944], [144, 49164], [149, 49444], [152, 49664], [155, 49784], [159, 49984]]}, {"verse": 8, "start": 51007, "end": 56256, "text": "Pero los salvó por amor de su nombre, para hacer notoria su fortaleza.", "words": [[0, 51007], [5, 51160], [9, 51350], [15, 52010], [19, 52210], [24, 52490], [27, 52670], [30, 52810], [38, 53230], [43, 53830], [49, 54330], [57, 55030], [60, 55250]]}, {"verse": 9, "start": 56706, "end": 63789, "text": "Y reprendió al Mar Rojo, y lo secó; y les hizo ir por el abismo, como por un desierto.", "words": [[0, 56706], [2, 56846], [12, 57626], [15, 57886], [19, 58106], [25, 59006], [27, 59226], [30, 59366], [36, 60180], [38, 60482], [42, 60702], [47, 61082], [50, 61422], [54, 61662], [57, 61822], [65, 62202], [70, 62522], [74, 62822], [77, 62982]]}, {"verse": 10, "start": 64239, "end": 69252, "text": "Y los salvó de mano del enemigo, y los rescató de mano del adversario.", "words": [[0, 64239], [2, 64360], [6, 64500], [12, 64960], [15, 65060], [20, 65280], [24, 65520], [33, 66180], [35, 66800], [39, 66960], [47, 67580], [50, 67720], [55, 67960], [59, 68200]]}, {"verse": 11, "start": 69702, "end": 74610, "text": "Y cubrieron las aguas a sus enemigos: no quedó uno de ellos.", "words": [[0, 69702], [2, 69810], [12, 70490], [16, 70690], [22, 71190], [24, 71290], [28, 71450], [38, 72707], [41, 73007], [47, 73447], [51, 73687], [54, 73927]]}, {"verse": 12, "start": 75060, "end": 79748, "text": "Entonces creyeron a sus palabras, y cantaron su alabanza.", "words": [[0, 75060], [9, 75553], [18, 76333], [20, 76433], [24, 76573], [34, 77133], [36, 77953], [45, 78613], [48, 78853]]}, {"verse": 13, "start": 80198, "end": 85603, "text": "Se apresuraron, se olvidaron de sus obras; no esperaron en su consejo.", "words": [[0, 80198], [3, 80321], [16, 81501], [19, 81581], [29, 82121], [32, 82301], [36, 82461], [43, 83490], [46, 83650], [56, 84290], [59, 84470], [62, 84650]]}, {"verse": 14, "start": 86053, "end": 91566, "text": "Y desearon con ansia en el desierto; y tentaron a Dios en la soledad.", "words": [[0, 86053], [2, 86313], [11, 86973], [15, 87133], [21, 87893], [24, 88013], [27, 88133], [37, 89340], [39, 89466], [48, 90046], [50, 90206], [55, 90426], [58, 90646], [61, 90786]]}, {"verse": 15, "start": 92016, "end": 97040, "text": "Y él les dio lo que pidieron; mas envió flaqueza en sus almas.", "words": [[0, 92016], [2, 92186], [5, 92386], [9, 92706], [13, 92966], [16, 93146], [20, 93286], [30, 94437], [34, 94625], [40, 95275], [49, 95925], [52, 96025], [56, 96205]]}, {"verse": 16, "start": 97490, "end": 103522, "text": "Tomaron después celo contra Moisés en el campamento, y contra Aarón el santo de Jehová.", "words": [[0, 97490], [8, 97813], [16, 98093], [21, 98633], [28, 98913], [35, 99373], [38, 99613], [41, 99733], [53, 100493], [55, 100633], [62, 101343], [68, 102053], [71, 102333], [77, 102813], [80, 102953]]}, {"verse": 17, "start": 103972, "end": 109560, "text": "Se abrió la tierra, y tragó a Datán, y cubrió la compañía de Abiram.", "words": [[0, 103972], [3, 104090], [9, 104350], [12, 104490], [20, 104930], [22, 105590], [28, 105990], [30, 106110], [37, 106670], [39, 107170], [46, 107590], [49, 107750], [58, 108650], [61, 108790]]}, {"verse": 18, "start": 110010, "end": 114616, "text": "Y se encendió el fuego en su junta; la llama quemó los impíos.", "words": [[0, 110010], [2, 110127], [5, 110267], [14, 110867], [17, 111027], [23, 111307], [26, 111527], [29, 111687], [36, 112669], [39, 112850], [45, 113070], [51, 113490], [55, 113650]]}, {"verse": 19, "start": 115066, "end": 120398, "text": "Hicieron becerro en Horeb, y se postraron ante un ídolo fundido.", "words": [[0, 115066], [9, 115521], [17, 116221], [20, 116541], [27, 116861], [29, 117301], [32, 117421], [42, 118281], [47, 118621], [50, 118861], [56, 119441]]}, {"verse": 20, "start": 120848, "end": 125098, "text": "Así trocaron su gloria por la imagen de un buey que come hierba.", "words": [[0, 120848], [4, 121108], [13, 121708], [16, 121988], [23, 122268], [27, 122468], [30, 122648], [37, 123028], [40, 123248], [43, 123368], [48, 123868], [52, 124168], [57, 124428]]}, {"verse": 21, "start": 125548, "end": 130855, "text": "Olvidaron al Dios de su salvación, que había hecho grandezas en Egipto;", "words": [[0, 125548], [10, 126364], [13, 126684], [18, 126884], [21, 127144], [24, 127304], [35, 128484], [39, 128804], [45, 129024], [51, 129344], [61, 130024], [64, 130164]]}, {"verse": 22, "start": 131305, "end": 136471, "text": "Maravillas en la tierra de Cam, cosas formidables sobre el Mar Rojo.", "words": [[0, 131305], [11, 131929], [14, 132169], [17, 132329], [24, 132689], [27, 132889], [32, 133589], [38, 134029], [50, 134929], [56, 135269], [59, 135529], [63, 135769]]}, {"verse": 23, "start": 136921, "end": 146728, "text": "Y trató de destruirlos, a no haberse puesto Moisés su escogido en la brecha delante de él, a fin de apartar su ira, para que no los destruyese.", "words": [[0, 136921], [2, 137084], [8, 137544], [11, 137664], [24, 139104], [26, 139184], [29, 139324], [37, 139724], [44, 139944], [51, 140564], [54, 140864], [63, 141504], [66, 141624], [69, 141744], [76, 142084], [84, 142524], [87, 142924], [91, 143324], [93, 143424], [97, 143584], [100, 143744], [108, 144284], [111, 144504], [116, 144884], [121, 145464], [125, 145604], [128, 145744], [132, 145884]]}, {"verse": 24, "start": 147178, "end": 152500, "text": "Pero aborrecieron la tierra deseable: no creyeron a su palabra;", "words": [[0, 147178], [5, 147702], [18, 148522], [21, 148682], [28, 148962], [38, 150109], [41, 150297], [50, 150977], [52, 151057], [55, 151157]]}, {"verse": 25, "start": 152950, "end": 157085, "text": "Antes murmuraron en sus tiendas, y no oyeron la voz de Jehová.", "words": [[0, 153190], [6, 153430], [17, 153870], [20, 154070], [24, 154230], [33, 154950], [35, 155270], [38, 155510], [45, 155990], [48, 156130], [52, 156330], [55, 156470]]}, {"verse": 26, "start": 157535, "end": 162070, "text": "Por lo que alzó su mano a ellos, para postrarlos en el desierto,", "words": [[0, 157535], [4, 157700], [7, 157800], [11, 157960], [16, 158340], [19, 158460], [24, 158780], [26, 159020], [33, 159320], [38, 159880], [49, 160900], [52, 161120], [55, 161240]]}, {"verse": 27, "start": 162520, "end": 168546, "text": "Y humillar a su pueblo entre las naciones, y esparcirlos por las tierras.", "words": [[0, 162520], [2, 162705], [11, 163105], [13, 163265], [16, 163405], [23, 163885], [29, 164425], [33, 164685], [43, 165425], [45, 166085], [57, 167205], [61, 167445], [65, 167705]]}, {"verse": 28, "start": 168996, "end": 174438, "text": "Se juntaron asimismo a Baal-peor, y comieron los sacrificios de los muertos.", "words": [[0, 168996], [3, 169114], [12, 169414], [21, 169714], [23, 170524], [34, 171334], [36, 171734], [45, 172274], [49, 172514], [61, 173394], [64, 173494], [68, 173634]]}, {"verse": 29, "start": 174888, "end": 179812, "text": "Y enojaron a Dios con sus obras, y se desató la mortandad en ellos.", "words": [[0, 174888], [2, 175014], [11, 175654], [13, 175774], [18, 175954], [22, 176214], [26, 176374], [33, 176774], [35, 177374], [38, 177514], [45, 178114], [48, 178254], [58, 179074], [61, 179214]]}, {"verse": 30, "start": 180262, "end": 185020, "text": "Entonces se levantó Finees, e hizo juicio; y se detuvo la plaga.", "words": [[0, 180262], [9, 180793], [12, 181113], [20, 181613], [28, 182113], [30, 182333], [35, 182553], [43, 183499], [45, 183681], [48, 183801], [55, 184241], [58, 184441]]}, {"verse": 31, "start": 185470, "end": 190270, "text": "Y le fue contado a justicia de generación en generación para siempre.", "words": [[0, 185470], [2, 185591], [5, 185671], [9, 185851], [17, 186471], [19, 186591], [28, 187171], [31, 187311], [42, 188111], [45, 188571], [56, 189251], [61, 189471]]}, {"verse": 32, "start": 190720, "end": 197069, "text": "También le irritaron en las aguas de Meriba: e hizo mal a Moisés por causa de ellos;", "words": [[0, 190720], [8, 191004], [11, 191244], [21, 192324], [24, 192464], [28, 192664], [34, 193104], [37, 193490], [45, 194175], [47, 194303], [52, 194623], [56, 194963], [58, 195183], [65, 195563], [69, 195883], [75, 196203], [78, 196523]]}, {"verse": 33, "start": 197519, "end": 202739, "text": "Porque hicieron se rebelase su espíritu, como lo expresó con sus labios.", "words": [[0, 197519], [7, 197763], [16, 198383], [19, 198873], [28, 199363], [31, 199563], [41, 200423], [46, 200703], [49, 200883], [57, 201583], [61, 201783], [65, 201983]]}, {"verse": 34, "start": 203189, "end": 206283, "text": "No destruyeron los pueblos que Jehová les dijo;", "words": [[0, 203189], [3, 203445], [15, 204405], [19, 204565], [27, 205085], [31, 205205], [38, 205685], [42, 205765]]}, {"verse": 35, "start": 206733, "end": 211004, "text": "Antes se mezclaron con las naciones, y aprendieron sus obras,", "words": [[0, 206733], [6, 207061], [9, 207441], [19, 207981], [23, 208101], [27, 208301], [37, 208881], [39, 209381], [51, 209981], [55, 210221]]}, {"verse": 36, "start": 211454, "end": 215600, "text": "Y sirvieron a sus ídolos; los cuales les fueron por ruina.", "words": [[0, 211454], [2, 211582], [12, 212242], [14, 212382], [18, 212542], [26, 213715], [30, 213822], [37, 214062], [41, 214302], [48, 214602], [52, 214882]]}, {"verse": 37, "start": 216050, "end": 219436, "text": "Y sacrificaron sus hijos y sus hijas a los demonios;", "words": [[0, 216050], [2, 216138], [15, 216898], [19, 217118], [25, 217558], [27, 217838], [31, 218058], [37, 218418], [39, 218538], [43, 218638]]}, {"verse": 38, "start": 219886, "end": 231565, "text": "Y derramaron la sangre inocente, la sangre de sus hijos y de sus hijas, que sacrificaron a los ídolos de Canaán: y la tierra fue contaminada con sangre.", "words": [[0, 219886], [2, 220003], [13, 220623], [16, 220803], [23, 221203], [33, 222723], [36, 222823], [43, 223203], [46, 223403], [50, 223583], [56, 224003], [58, 224383], [61, 224483], [65, 224743], [72, 225603], [76, 225743], [89, 226663], [91, 227043], [95, 227203], [102, 227843], [105, 228003], [113, 228950], [115, 229055], [118, 229175], [125, 229455], [129, 229815], [141, 230595], [145, 230815]]}, {"verse": 39, "start": 232015, "end": 237019, "text": "Se contaminaron así con sus obras, y fornicaron con sus hechos.", "words": [[0, 232015], [3, 232158], [16, 232978], [20, 233198], [24, 233438], [28, 233618], [35, 234078], [37, 234998], [48, 235798], [52, 236018], [56, 236298]]}, {"verse": 40, "start": 237469, "end": 242637, "text": "Se encendió por tanto el furor de Jehová sobre su pueblo, y abominó su heredad:", "words": [[0, 237469], [3, 237612], [12, 238172], [16, 238372], [22, 238712], [25, 238952], [31, 239412], [34, 239612], [41, 240072], [47, 240292], [50, 240512], [58, 240932], [60, 241192], [68, 241852], [71, 242012]]}, {"verse": 41, "start": 243087, "end": 249170, "text": "Y los entregó en poder de las gentes, y se enseñorearon de ellos los que los aborrecían.", "words": [[0, 243087], [2, 243211], [6, 243331], [14, 243911], [17, 243991], [23, 244271], [26, 244441], [30, 244611], [38, 245191], [40, 245731], [43, 245911], [56, 246911], [59, 247171], [65, 247531], [69, 247851], [73, 248011], [77, 248151]]}, {"verse": 42, "start": 249620, "end": 254079, "text": "Y sus enemigos los oprimieron, y fueron quebrantados debajo de su mano.", "words": [[0, 249620], [2, 249721], [6, 249841], [15, 250294], [19, 250748], [31, 251201], [33, 251621], [40, 251861], [53, 252901], [60, 253281], [63, 253441], [66, 253581]]}, {"verse": 43, "start": 254529, "end": 261950, "text": "Muchas veces los libró; mas ellos se rebelaron a su consejo, y fueron humillados por su maldad.", "words": [[0, 254529], [7, 254755], [13, 255235], [17, 255695], [24, 256558], [28, 256767], [34, 257227], [37, 257887], [47, 258547], [49, 258647], [52, 258767], [61, 259367], [63, 259447], [70, 259727], [81, 260787], [85, 261067], [88, 261267]]}, {"verse": 44, "start": 262400, "end": 266832, "text": "El con todo, miraba cuando estaban en angustia, y oía su clamor:", "words": [[0, 262400], [3, 262800], [7, 263040], [13, 263380], [20, 263940], [27, 264180], [35, 264640], [38, 264840], [48, 265480], [50, 265700], [54, 265980], [57, 266435]]}, {"verse": 45, "start": 267282, "end": 274360, "text": "Y se acordaba de su pacto con ellos, y se arrepentía conforme a la muchedumbre de sus compasiones.", "words": [[0, 267282], [2, 267423], [5, 267523], [14, 268103], [17, 268263], [20, 268443], [26, 268963], [30, 269163], [37, 269503], [39, 270343], [42, 270483], [53, 271423], [62, 271763], [64, 272103], [67, 272243], [79, 272983], [82, 273103], [86, 273263]]}, {"verse": 46, "start": 274810, "end": 280853, "text": "Hizo asimismo tuviesen de ellos misericordia todos los que los tenían cautivos.", "words": [[0, 274810], [5, 275500], [14, 276210], [23, 276770], [26, 276990], [32, 277250], [45, 278170], [51, 278470], [55, 279050], [59, 279210], [63, 279350], [70, 279710]]}, {"verse": 47, "start": 281303, "end": 293314, "text": "Sálvanos, Jehová Dios nuestro, y reúnenos de entre las naciones, para que alabemos tu santo nombre, para que nos gloriemos en tus alabanzas.", "words": [[0, 281303], [10, 281855], [17, 282441], [22, 283028], [31, 284208], [33, 284228], [42, 285348], [45, 285768], [51, 286068], [55, 286308], [65, 287468], [70, 287848], [74, 288068], [83, 288788], [86, 289028], [92, 289408], [100, 290348], [105, 290608], [109, 290768], [113, 290988], [123, 291808], [126, 292008], [130, 292168]]}, {"verse": 48, "start": 293764, "end": 302181, "text": "Bendito Jehová Dios de Israel, desde el siglo y hasta el siglo: y diga todo el pueblo, Amén. Aleluya.", "words": [[0, 293764], [8, 294165], [15, 294599], [20, 295032], [23, 295212], [31, 295712], [37, 296532], [40, 296812], [46, 297232], [48, 297592], [54, 297812], [57, 298052], [64, 299034], [66, 299243], [71, 299493], [76, 299633], [79, 299833], [87, 300273], [93, 301737]]}]}