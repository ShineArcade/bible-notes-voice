50], [173, 68490], [176, 68650], [185, 68990]]}, {"verse": 8, "start": 70040, "end": 72869, "text": "Pero Noé halló gracia en los ojos de Jehová.", "words": [[0, 70040], [5, 70364], [9, 70724], [15, 71084], [22, 71444], [25, 71604], [29, 71744], [34, 72064], [37, 72284]]}, {"verse": 9, "start": 73219, "end": 81834, "text": "Estas son las generaciones de Noé: Noé, varón justo, perfecto fue en sus generaciones; con Dios caminó Noé.", "words": [[0, 73219], [6, 73762], [10, 73962], [14, 74182], [27, 74982], [30, 75142], [35, 76778], [40, 76904], [46, 77031], [53, 77511], [62, 78254], [66, 78436], [69, 78696], [73, 78916], [87, 80278], [91, 80624], [96, 80804], [103, 81334]]}, {"verse": 10, "start": 82184, "end": 86844, "text": "Y engendró Noé tres hijos: a Sem, a Cam, y a Jafet.", "words": [[0, 82184], [2, 82514], [11, 82874], [15, 83234], [20, 83474], [27, 84617], [29, 84797], [34, 84977], [36, 85157], [41, 85857], [43, 86157], [45, 86237]]}, {"verse": 11, "start": 87194, "end": 92385, "text": "Y se corrompió la tierra delante de Dios, y estaba la tierra llena de violencia.", "words": [[0, 87194], [2, 87300], [5, 87420], [15, 88100], [18, 88260], [25, 88600], [33, 89120], [36, 89300], [42, 89580], [44, 90080], [51, 90360], [54, 90540], [61, 90820], [67, 91340], [70, 91460]]}, {"verse": 12, "start": 92735, "end": 102157, "text": "Y miró Dios la tierra, y he aquí que estaba corrompida; porque toda carne había corrompido su camino sobre la tierra.", "words": [[0, 92735], [2, 92880], [7, 93240], [12, 93560], [15, 94160], [23, 95480], [25, 95580], [28, 95720], [33, 96120], [37, 96400], [44, 96740], [56, 98046], [63, 98250], [68, 98550], [74, 99070], [80, 99450], [91, 100290], [94, 100470], [101, 100850], [107, 101210], [110, 101430]]}, {"verse": 13, "start": 102507, "end": 114295, "text": "Y dijo Dios a Noé: El fin de toda carne ha venido delante de mí; porque la tierra está llena de violencia a causa de ellos; y he aquí que yo los destruiré con la tierra.", "words": [[0, 1