{"book": "PSA", "chapter": 79, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 111941, "verses": [{"verse": 1, "start": 300, "end": 10538, "text": "Salmo de Asaf. OH Dios, vinieron las naciones a tu heredad; el templo de tu santidad han contaminado; pusieron a Jerusalén en montones.", "words": [[0, 300], [6, 744], [9, 924], [15, 1805], [18, 2002], [24, 2542], [33, 3002], [37, 3222], [46, 3762], [48, 3962], [51, 4102], [60, 5010], [63, 5152], [70, 5832], [73, 5932], [76, 6072], [85, 6712], [89, 6892], [102, 8357], [111, 8741], [113, 8901], [123, 9501], [126, 9621]]}, {"verse": 2, "start": 10988, "end": 18966, "text": "Dieron los cuerpos de tus siervos por comida a las aves de los cielos; la carne de tus santos a las bestias de la tierra.", "words": [[0, 10988], [7, 11353], [11, 11573], [19, 12073], [22, 12353], [26, 12633], [34, 12913], [38, 13073], [45, 13513], [47, 13713], [51, 13873], [56, 14173], [59, 14293], [63, 14433], [71, 15415], [74, 15543], [80, 15943], [83, 16203], [87, 16383], [94, 17343], [96, 17543], [100, 17663], [108, 18103], [111, 18223], [114, 18323]]}, {"verse": 3, "start": 19416, "end": 27046, "text": "Derramaron su sangre como agua en los alrededores de Jerusalén; y no hubo quien los enterrase.", "words": [[0, 19416], [11, 20225], [14, 20625], [21, 21025], [26, 21265], [31, 21745], [34, 22025], [38, 22205], [50, 23025], [53, 23205], [64, 24430], [66, 24731], [69, 24891], [74, 25411], [80, 25651], [84, 26384]]}, {"verse": 4, "start": 27496, "end": 34173, "text": "Somos afrentados de nuestros vecinos, escarnecidos y burlados de los que están en nuestros alrededores.", "words": [[0, 27496], [6, 27822], [17, 28562], [20, 28722], [29, 28882], [38, 29772], [51, 30662], [53, 30862], [62, 31482], [65, 31782], [69, 31942], [73, 32082], [79, 32322], [82, 32502], [91, 32822]]}, {"verse": 5, "start": 34623, "end": 41380, "text": "¿Hasta cuándo, oh Jehová? ¿has de estar airado para siempre? ¿arderá como fuego tu celo?", 