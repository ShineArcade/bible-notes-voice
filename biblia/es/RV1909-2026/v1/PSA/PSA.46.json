{"book": "PSA", "chapter": 46, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 85990, "verses": [{"verse": 1, "start": 300, "end": 12186, "text": "Al Músico principal: de los hijos de Coré: Salmo sobre Alamoth. DIOS es nuestro amparo y fortaleza, nuestro pronto auxilio en las tribulaciones.", "words": [[0, 300], [3, 464], [10, 944], [21, 2076], [24, 2221], [28, 2361], [34, 2621], [37, 2960], [43, 3535], [49, 4115], [55, 4754], [64, 5640], [69, 6090], [72, 6550], [80, 6770], [87, 7650], [89, 7710], [100, 8750], [108, 9190], [115, 9650], [123, 10570], [126, 10770], [130, 10970]]}, {"verse": 2, "start": 12636, "end": 20011, "text": "Por tanto no temeremos aunque la tierra sea removida; aunque se traspasen los montes al corazón del mar.", "words": [[0, 12636], [4, 12879], [10, 13439], [13, 13740], [23, 14260], [30, 14580], [33, 14879], [40, 15180], [44, 15778], [54, 16642], [61, 16850], [64, 17070], [74, 17850], [78, 17990], [85, 18610], [88, 18750], [96, 19230], [100, 19510]]}, {"verse": 3, "start": 20461, "end": 26808, "text": "Bramarán, se turbarán sus aguas; temblarán los montes a causa de su braveza. (Selah.)", "words": [[0, 20727], [10, 21027], [13, 21327], [22, 21887], [26, 22087], [33, 23071], [43, 23633], [47, 23773], [54, 24373], [56, 24493], [62, 24833], [65, 25073], [68, 25529], [77, 26543]]}, {"verse": 4, "start": 27258, "end": 33809, "text": "Del río sus conductos alegrarán la ciudad de Dios, el santuario de las tiendas del Altísimo.", "words": [[0, 27258], [4, 27506], [8, 28446], [12, 28526], [22, 29206], [32, 29866], [35, 29986], [42, 30286], [45, 30526], [51, 31266], [54, 31346], [64, 31986], [67, 32146], [71, 32266], [79, 32766], [83, 32926]]}, {"verse": 5, "start": 34259, "end": 41304, "text": "Dios está en medio de ella; no será conmovida: Dios la ayudará al clarear la mañana.", "words": [[0, 34259], [5, 34639], [10, 35019], [13, 35179], [19, 35439], [22, 35739], [28, 36545], [31, 36674], [36, 36874], [47, 38109], [52, 38573], [55, 38893], [63, 39426], [66, 39960], [74, 40493], [77, 40633]]}, {"verse": 6, "start": 41754, "end": 48751, "text": "Bramaron las naciones, titubearon los reinos; dio él su voz, se derritió la tierra.", "words": [[0, 41754], [9, 42324], [13, 42544], [23, 43624], [34, 44324], [38, 44564], [46, 45549], [50, 45814], [53, 46154], [56, 46374], [61, 47234], [64, 47584], [73, 47934], [76, 48074]]}, {"verse": 7, "start": 49201, "end": 55852, "text": "Jehová de los ejércitos es con nosotros; nuestro refugio es el Dios de Jacob. (Selah.)", "words": [[0, 49201], [7, 49667], [10, 49767], [14, 49927], [24, 50667], [27, 50927], [31, 51187], [41, 52425], [49, 52853], [57, 53553], [60, 53733], [63, 53933], [68, 54233], [71, 54353], [78, 55587]]}, {"verse": 8, "start": 56302, "end": 61169, "text": "Venid, ved las obras de Jehová, que ha puesto asolamientos en la tierra.", "words": [[0, 56302], [7, 56867], [11, 57127], [15, 57467], [21, 57827], [24, 58047], [32, 58807], [36, 59027], [39, 59187], [46, 59327], [59, 60067], [62, 60347], [65, 60487]]}, {"verse": 9, "start": 61619, "end": 69669, "text": "Que hace cesar las guerras hasta los fines de la tierra: que quiebra el arco, corta la lanza, y quema los carros en el fuego.", "words": [[0, 61619], [4, 61703], [9, 61923], [15, 62603], [19, 62863], [27, 63523], [33, 64063], [37, 64263], [43, 64543], [46, 64723], [49, 64843], [57, 65832], [61, 65936], [69, 66416], [72, 66576], [78, 67016], [84, 67336], [87, 67456], [94, 67856], [96, 67936], [102, 68176], [106, 68356], [113, 68796], [116, 68956], [119, 69096]]}, {"verse": 10, "start": 69969, "end": 78589, "text": "Estad quietos, y conoced que yo soy Dios: enaltecido he de ser entre las naciones, enaltecido seré en la tierra.", "words": [[0, 69969], [6, 70429], [15, 71029], [17, 71129], [25, 71629], [29, 71849], [32, 72029], [36, 72269], [42, 73864], [53, 74304], [56, 74524], [59, 74624], [63, 74904], [69, 75144], [73, 75364], [83, 76274], [94, 77184], [99, 77544], [102, 7