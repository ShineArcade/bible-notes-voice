{"book": "MRK", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 455884, "verses": [{"verse": 1, "start": 300, "end": 11037, "text": "Y partiéndose de allí, vino a la región de Judea y tras el Jordán: y volvió el pueblo a juntarse a él; y de nuevo les enseñaba como solía.", "words": [[0, 300], [2, 402], [14, 1302], [17, 1522], [23, 1882], [28, 2842], [30, 3102], [33, 3182], [40, 3542], [43, 3742], [49, 4282], [51, 4402], [56, 4602], [59, 4842], [67, 5894], [69, 6262], [76, 6642], [79, 6742], [86, 7002], [88, 7202], [97, 7742], [99, 7902], [103, 8624], [105, 8760], [108, 8860], [114, 9140], [118, 9440], [127, 10120], [132, 10360]]}, {"verse": 2, "start": 11487, "end": 21075, "text": "Y llegándose los fariseos, le preguntaron, para ponerlo a prueba, si era lícito al marido divorciarse de su mujer.", "words": [[0, 11487], [2, 11608], [13, 12328], [17, 12528], [27, 13388], [30, 14078], [43, 14768], [48, 15448], [56, 16008], [58, 16108], [66, 16508], [69, 17148], [73, 17328], [80, 17828], [83, 18008], [90, 18408], [102, 19208], [105, 19428], [108, 19588]]}, {"verse": 3, "start": 21525, "end": 24813, "text": "Pero él respondiendo, les dijo: ¿Qué os mandó Moisés?", "words": [[0, 21525], [5, 21525], [8, 21525], [22, 22465], [26, 22565], [32, 23380], [37, 23482], [40, 23622], [46, 24002]]}, {"verse": 4, "start": 25263, "end": 30746, "text": "Y ellos dijeron: Moisés permitió escribir un certificado de divorcio y divorciarse.", "words": [[0, 25263], [2, 25391], [8, 25551], [17, 26464], [24, 26807], [33, 27507], [42, 27987], [45, 28107], [57, 28887], [60, 29007], [69, 29647], [71, 29867]]}, {"verse": 5, "start": 31096, "end": 37308, "text": "Y respondiendo Jesús, les dijo: Por la dureza de vuestro corazón os escribió este mandamiento;", "words": [[0, 31096], [2, 31218], [15, 31878], [22, 32258], [26, 32778], [32, 33602], [36, 33725], [39, 33925], [46, 34385], [49, 34545], [57, 34925], [65, 35405], [68, 35665], [77, 36245], [82, 36405]]}, {"verse": 6, "start": 37758, "end": 42221, "text": "Pero al principio de la creación, varón y hembra los hizo Dios.", "words": [[0, 37758], [5, 37900], [8, 38080], [18, 38620], [21, 38980], [24, 39120], [34, 40020], [40, 40580], [42, 40800], [49, 41220], [53, 41380], [58, 41640]]}, {"verse": 7, "start": 42671, "end": 47526, "text": "Por esto dejará el hombre a su padre y a su madre, y se juntará a su mujer.", "words": [[0, 42671], [4, 42773], [9, 43033], [16, 43593], [19, 43733], [26, 43993], [28, 44153], [31, 44253], [37, 44653], [39, 44913], [41, 44973], [44, 45133], [51, 45513], [53, 46073], [56, 46213], [64, 46733], [66, 46833], [69, 46953]]}, {"verse": 8, "start": 47976, "end": 54355, "text": "Y los que eran dos, serán hechos una carne: así que no son más dos, sino una carne.", "words": [[0, 47976], [2, 48061], [6, 48181], [10, 48361], [15, 48581], [20, 48901], [26, 49721], [33, 50081], [37, 50381], [44, 51305], [48, 51545], [52, 51725], [55, 51865], [59, 52165], [63, 52365], [68, 53225], [73, 53405], [77, 53645]]}, {"verse": 9, "start": 54805, "end": 58248, "text": "Pues lo que Dios juntó, no lo aparte el hombre.", "words": [[0, 54805], [5, 54967], [8, 55307], [12, 55467], [17, 55627], [24, 56007], [27, 56727], [30, 56867], [37, 57427], [40, 57647]]}, {"verse": 10, "start": 58698, "end": 63172, "text": "Y en casa volvieron los discípulos a preguntarle de lo mismo.", "words": [[0, 58698], [2, 58843], [5, 58983], [10, 59383], [20, 60363], [24, 60583], [35, 61303], [37, 61483], [49, 62283], [52, 62443], [55, 62563]]}, {"verse": 11, "start": 63622, "end": 70867, "text": "Y les dice: Cualquiera que se divorcie de su mujer y se case con otra, comete adulterio contra ella:", "words": [[0, 63803], [2, 64018], [6, 64232], [12, 64744], [23, 65245], [27, 65385], [30, 65545], [39, 66105], [42, 66245], [45, 66425], [51, 66825], [53, 67105], [56, 67245], [61, 67505], [65, 67805], [71, 68745], [78, 69105], [88, 69925], [95, 70245]]}, {"verse": 12, "start": 71317, "end": 76989, "text": "Y si la mujer se divorcia de su marido y se casa con otro, comete adulterio.", "words": [[0, 71317], [2, 71424], [5, 71544], [8, 71684], [14, 71964], [17, 72224], [26, 72804], [29, 72924], [32, 73104], [39, 73544], [41, 73644], [44, 73764], [49, 74004], [53, 74304], [59, 74964], [66, 75504]]}, {"verse": 13, "start": 77439, "end": 84773, "text": "Y le presentaban niños para que los tocase; y los discípulos reprendían a quienes los presentaban.", "words": [[0, 77439], [2, 77547], [5, 77667], [17, 78327], [23, 78867], [28, 79447], [32, 79587], [36, 79747], [44, 80869], [46, 80977], [50, 81117], [61, 81917], [72, 83057], [74, 83277], [82, 83537], [86, 83777]]}, {"verse": 14, "start": 85223, "end": 94993, "text": "Y viéndolo Jesús, se enojó, y les dijo: Dejad que los niños vengan, y no se lo impidáis; porque de los tales es el reino de Dios.", "words": [[0, 85223], [2, 85351], [11, 85791], [18, 86091], [21, 86471], [28, 87411], [30, 87561], [34, 87711], [40, 88546], [46, 89186], [50, 89326], [54, 89486], [60, 89936], [68, 90386], [70, 90766], [73, 90926], [76, 91106], [79, 91226], [89, 92500], [96, 92722], [99, 92882], [103, 93042], [109, 93282], [112, 93582], [115, 93782], [121, 94182], [124, 94342]]}, {"verse": 15, "start": 95443, "end": 101767, "text": "De cierto os digo, que el que no reciba el reino de Dios como un niño, no entrará en él.", "words": [[0, 95648], [3, 95888], [10, 96128], [13, 96388], [19, 96668], [23, 97228], [26, 97348], [30, 97488], [33, 97668], [40, 98228], [43, 98348], [49, 98708], [52, 98868], [57, 99088], [62, 99368], [65, 99588], [71, 100028], [74, 100568], [82, 101208], [85, 101408]]}, {"verse": 16, "start": 102217, "end": 107475, "text": "Y tomándolos en los brazos, poniendo las manos sobre ellos, los bendecía.", "words": [[0, 102217], [2, 102321], [13, 103001], [16, 103141], [20, 103261], [28, 104241], [37, 104741], [41, 104921], [47, 105221], [53, 105621], [60, 106541], [64, 106641]]}, {"verse": 17, "start": 107925, "end": 119833, "text": "Y saliendo él para ir su camino, vino uno corriendo, y arrodillándose delante de él, le preguntó: Maestro bueno, ¿qué haré para heredar la vida eterna?", "words": [[0, 107925], [2, 108029], [11, 108569], [14, 108869], [19, 109109], [22, 109329], [25, 109549], [33, 110049], [38, 110869], [42, 111149], [53, 111869], [55, 112349], [70, 113389], [78, 113929], [81, 114109], [85, 114309], [88, 114609], [98, 115672], [106, 116232], [113, 117032], [118, 117132], [123, 117432], [128, 117612], [136, 118092], [139, 118212], [144, 118412]]}, {"verse": 18, "start": 120183, "end": 126705, "text": "Y Jesús le dijo: ¿Por qué me dices bueno? Ninguno hay bueno, sino sólo uno, Dios.", "words": [[0, 120183], [2, 120328], [8, 120708], [11, 121068], [17, 121864], [22, 121967], [26, 122167], [29, 122307], [35, 122627], [42, 123503], [50, 124339], [54, 124599], [61, 124959], [66, 125279], [71, 125679], [76, 126059]]}, {"verse": 19, "start": 127155, "end": 138504, "text": "Los mandamientos sabes: No adulteres: No mates: No robes: No digas falso testimonio: No defraudes: Honra a tu padre y a tu madre.", "words": [[0, 127155], [4, 127389], [17, 128029], [24, 129067], [27, 129212], [38, 130301], [41, 130521], [48, 131272], [51, 131427], [58, 132282], [61, 132502], [67, 132862], [73, 133302], [85, 134396], [88, 134839], [99, 135575], [105, 136221], [107, 136421], [110, 136541], [116, 136961], [118, 137661], [120, 137741], [123, 137861]]}, {"verse": 20, "start": 138954, "end": 144684, "text": "Él entonces respondiendo, le dijo: Maestro, todo esto he guardado desde mi juventud.", "words": [[0, 138954], [3, 139136], [12, 140096], [26, 140876], [29, 140956], [35, 141709], [44, 142351], [49, 142451], [54, 142831], [57, 143011], [66, 143551], [72, 143731], [75, 143991]]}, {"verse": 21, "start": 145034, "end": 159429, "text": "Entonces Jesús mirándole, le amó, y le dijo: Una cosa te falta: ve, vende todo lo que tienes, y da a los pobres, y tendrás tesoro en el cielo; y ven, sígueme, tomando tu cruz.", "words": [[0, 145034], [9, 145520], [15, 146640], [26, 147340], [29, 147340], [34, 148000], [36, 148220], [39, 148320], [45, 149174], [49, 149360], [54, 149580], [57, 149800], [64, 150774], [68, 151161], [74, 151421], [79, 151701], [82, 151901], [86, 152041], [94, 152481], [96, 153121], [99, 153321], [101, 153461], [105, 153581], [113, 154181], [115, 154641], [123, 155041], [130, 155461], [133, 155601], [136, 155741], [143, 156713], [145, 156837], [150, 157077], [159, 157957], [167, 158617], [170, 158837]]}, {"verse": 22, "start": 159879, "end": 166304, "text": "Pero él, entristecido por esta palabra, se fue triste, porque tenía muchas posesiones.", "words": [[0, 159879], [5, 160061], [9, 160341], [22, 161501], [26, 161741], [31, 161921], [40, 162481], [43, 163161], [47, 163341], [55, 164201], [62, 164481], [68, 164861], [75, 165261]]}, {"verse": 23, "start": 166754, "end": 176484, "text": "Entonces Jesús, mirando alrededor, dice a sus discípulos: ¡Cuán difícilmente entrarán en el reino de Dios los que tienen riquezas!", "words": [[0, 166754], [9, 167498], [16, 168538], [24, 168938], [35, 170218], [40, 170478], [42, 170638], [46, 170818], [58, 172024], [64, 172231], [77, 173091], [86, 173811], [89, 173951], [92, 174111], [98, 174491], [101, 174651], [106, 174891], [110, 175091], [114, 175271], [121, 175571]]}, {"verse": 24, "start": 176934, "end": 190828, "text": "Y los discípulos se espantaron de sus palabras; pero Jesús respondiendo, les volvió a decir: ¡Hijos, cuán difícil es para los que confían en las riquezas entrar en el reino de Dios!", "words": [[0, 176934], [2, 177023], [6, 177163], [17, 177843], [20, 178043], [31, 178883], [34, 179043], [38, 179223], [48, 180364], [53, 180512], [59, 181072], [73, 182452], [77, 182572], [84, 183172], [86, 183292], [93, 184087], [101, 184489], [106, 185009], [114, 185369], [117, 185829], [122, 186469], [126, 186649], [130, 186809], [138, 187409], [141, 187589], [145, 187769], [154, 188329], [161, 189029], [164, 189449], [167, 189609], [173, 190049], [176, 190209]]}, {"verse": 25, "start": 191278, "end": 198482, "text": "Más fácil es pasar un camello por el ojo de una aguja, que el rico entrar en el reino de Dios.", "words": [[0, 191278], [4, 191626], [10, 192166], [13, 192466], [19, 192846], [22, 193126], [30, 193686], [34, 193926], [37, 194086], [41, 194406], [44, 194526], [48, 194746], [55, 195586], [59, 195866], [62, 196066], [67, 196306], [74, 196846], [77, 197086], [80, 197246], [86, 197726], [89, 197886]]}, {"verse": 26, "start": 198932, "end": 204407, "text": "Y ellos se espantaban más, diciendo dentro de sí: ¿Y quién podrá salvarse?", "words": [[0, 198932], [2, 199098], [8, 199338], [11, 199598], [22, 200438], [27, 200838], [36, 201498], [43, 202118], [46, 202398], [50, 202966], [53, 203088], [59, 203288], [65, 203648]]}, {"verse": 27, "start": 204757, "end": 215200, "text": "Entonces Jesús mirándolos, dice: Para los hombres es imposible; pero para Dios, no; porque todas las cosas son posibles para Dios.", "words": [[0, 204757], [9, 205940], [15, 206840], [27, 207620], [33, 208422], [38, 208588], [42, 208768], [50, 209148], [53, 209368], [64, 210770], [69, 210934], [74, 211174], [80, 211874], [84, 212435], [91, 212618], [97, 212938], [101, 213218], [107, 213538], [111, 213858], [120, 214398], [125, 214638]]}, {"verse": 28, "start": 215650, "end": 222283, "text": "Entonces Pedro comenzó a decirle: He aquí, nosotros hemos dejado todas las cosas, y te hemos seguido.", "words": [[0, 215650], [9, 216255], [15, 216635], [23, 217255], [25, 217375], [34, 218333], [37, 218474], [43, 218894], [52, 219154], [58, 219554], [65, 220054], [71, 220234], [75, 220534], [82, 220874], [84, 221394], [87, 221534], [93, 221714]]}, {"verse": 29, "start": 222633, "end": 236882, "text": "Y respondiendo Jesús, dijo: De cierto os digo, que no hay ninguno que haya dejado casa, o hermanos, o hermanas, o padre, o madre, o mujer, o hijos, o tierras, por causa de mí y del evangelio,", "words": [[0, 222633], [2, 222759], [15, 223519], [22, 223859], [28, 225257], [31, 225462], [38, 225667], [41, 225872], [47, 226232], [51, 226472], [54, 226692], [58, 226852], [66, 227392], [70, 227532], [75, 227852], [82, 228172], [88, 228552], [90, 229132], [100, 229872], [102, 230192], [112, 230752], [114, 231032], [121, 231412], [123, 231692], [130, 232032], [132, 232252], [139, 232592], [141, 232852], [148, 233172], [150, 233412], [159, 234448], [163, 234590], [169, 234950], [172, 235270], [175, 235490], [177, 235770], [181, 235930]]}, {"verse": 30, "start": 237332, "end": 249756, "text": "Que no reciba cien veces más ahora en este tiempo, casas, y hermanos, y hermanas, y madres, e hijos, y tierras, con persecuciones; y en el siglo venidero la vida eterna.", "words": [[0, 237332], [4, 237416], [7, 237826], [14, 238236], [19, 238516], [25, 238796], [29, 239076], [35, 239476], [38, 239616], [43, 239796], [51, 240696], [58, 241396], [60, 241596], [70, 242196], [72, 242376], [82, 242896], [84, 243236], [92, 243696], [94, 243896], [101, 244409], [103, 244923], [112, 245436], [116, 245636], [131, 247186], [133, 247310], [136, 247450], [139, 247570], [145, 247950], [154, 248630], [157, 248750], [162, 248970]]}, {"verse": 31, "start": 250206, "end": 254981, "text": "Pero muchos de los primeros serán últimos, y los últimos serán primeros.", "words": [[0, 250206], [5, 250466], [12, 250886], [15, 251086], [19, 251206], [28, 251726], [34, 252086], [43, 252606], [45, 253146], [49, 253306], [57, 253686], [63, 254166]]}, {"verse": 32, "start": 255431, "end": 272070, "text": "Y estaban en el camino subiendo a Jerusalén; y Jesús iba delante de ellos, y se espantaban, y le seguían con miedo: entonces volviendo a tomar a los doce aparte, les comenzó a decir las cosas que le habían de acontecer:", "words": [[0, 255431], [2, 255536], [10, 255876], [13, 256116], [16, 256256], [23, 256696], [32, 257576], [34, 257696], [45, 258838], [47, 258948], [53, 259308], [57, 259868], [65, 260428], [68, 260628], [75, 260948], [77, 261248], [80, 261408], [92, 262348], [94, 263028], [97, 263148], [105, 263628], [109, 263808], [116, 264664], [125, 265760], [135, 266240], [137, 266360], [143, 266680], [145, 266900], [149, 267020], [154, 267400], [162, 268400], [166, 268500], [174, 269160], [176, 269260], [182, 269540], [186, 269900], [192, 270320], [196, 270560], [199, 270720], [206, 271020], [209, 271240]]}, {"verse": 33, "start": 272520, "end": 285327, "text": "He aquí subimos a Jerusalén, y el Hijo del hombre será entregado a los principales sacerdotes, y a los escribas, y le condenarán a muerte, y le entregarán a los Gentiles:", "words": [[0, 272571], [3, 272661], [8, 272841], [16, 273441], [18, 273581], [29, 274321], [31, 274861], [34, 274981], [39, 275261], [43, 275401], [50, 275841], [55, 276081], [65, 277081], [67, 277221], [71, 277321], [83, 278141], [95, 279061], [97, 279541], [99, 279621], [103, 279741], [113, 280541], [115, 281221], [118, 281341], [129, 282041], [131, 282101], [139, 283094], [141, 283198], [144, 283338], [155, 284058], [157, 284218], [161, 284338]]}, {"verse": 34, "start": 285777, "end": 294692, "text": "Y se burlarán de él, y le golpearán con látigos, y escupirán en él, y le matarán; pero al tercer día resucitará.", "words": [[0, 285777], [2, 285897], [5, 286317], [14, 286737], [17, 286917], [21, 287217], [23, 287717], [26, 287837], [36, 288537], [40, 288697], [49, 289337], [51, 289857], [61, 290537], [64, 290677], [68, 290957], [70, 291337], [73, 291437], [82, 292499], [87, 292661], [90, 292861], [97, 293121], [101, 293541]]}, {"verse": 35, "start": 295142, "end": 304096, "text": "Entonces Jacobo y Juan, hijos de Zebedeo, se llegaron a él, diciendo: Maestro, querríamos que nos hagas lo que pidamos.", "words": [[0, 295142], [9, 295827], [16, 296887], [18, 297007], [24, 297787], [30, 298027], [33, 298577], [42, 299127], [45, 299267], [54, 299747], [56, 299867], [60, 300127], [70, 301360], [79, 301964], [90, 302404], [94, 302664], [98, 302844], [104, 303184], [107, 303304], [111, 303404]]}, {"verse": 36, "start": 304446, "end": 307031, "text": "Y él les dijo: ¿Qué queréis que os haga?", "words": [[0, 304446], [2, 304632], [5, 304772], [9, 304912], [15, 305694], [20, 305797], [28, 306177], [32, 306357], [35, 306517]]}, {"verse": 37, "start": 307481, "end": 316220, "text": "Y ellos le dijeron: Danos que en tu gloria nos sentemos el uno a tu derecha, y el otro a tu izquierda.", "words": [[0, 307481], [2, 307662], [8, 307882], [11, 308102], [20, 309077], [26, 309502], [30, 309662], [33, 309782], [36, 309902], [43, 310262], [47, 310422], [56, 311042], [59, 311342], [63, 311542], [65, 311722], [68, 311822], [77, 312682], [79, 312862], [82, 313002], [87, 313202], [89, 313382], [92, 313502]]}, {"verse": 38, "start": 316570, "end": 326504, "text": "Entonces Jesús les dijo: No sabéis lo que pedís. ¿Podéis beber del vaso que yo bebo, o ser bautizados del bautismo de que yo soy bautizado?", "words": [[0, 316570], [9, 317076], [15, 317394], [19, 317711], [25, 319076], [28, 319216], [35, 319656], [38, 319816], [42, 319936], [49, 320838], [57, 321204], [63, 321504], [67, 321824], [72, 322224], [76, 322284], [79, 322484], [85, 322864], [87, 323204], [91, 323624], [102, 324044], [106, 324344], [115, 324904], [118, 325084], [122, 325204], [125, 325384], [129, 325604]]}, {"verse": 39, "start": 326954, "end": 342041, "text": "Y ellos dijeron: Podemos. Y Jesús les dijo: A la verdad, del vaso que yo bebo, beberéis; y del bautismo de que yo soy bautizado, seréis bautizados.", "words": [[0, 326954], [2, 327081], [8, 327241], [17, 328155], [26, 331896], [28, 332020], [34, 332440], [38, 332900], [44, 333697], [46, 333867], [49, 333947], [57, 334227], [61, 334907], [66, 335327], [70, 335427], [73, 335647], [79, 335987], [89, 337388], [91, 337513], [95, 337673], [104, 338393], [107, 338813], [111, 338953], [114, 339153], [118, 339373], [129, 340473], [136, 340893]]}, {"verse": 40, "start": 342491, "end": 348941, "text": "Pero que os sentéis a mi derecha y a mi izquierda, no es mío darlo, sino a quienes está preparado.", "words": [[0, 342491], [5, 342637], [9, 342837], [12, 343017], [20, 343597], [22, 343737], [25, 343857], [33, 344377], [35, 344537], [37, 344617], [40, 344797], [51, 345717], [54, 345917], [57, 346037], [61, 346357], [68, 347097], [73, 347337], [75, 347537], [83, 347677], [88, 348137]]}, {"verse": 41, "start": 349391, "end": 354679, "text": "Y como lo oyeron los diez, comenzaron a enojarse de Jacobo y de Juan.", "words": [[0, 349391], [2, 349495], [7, 349735], [10, 349935], [17, 350555], [21, 350695], [27, 351535], [38, 352255], [40, 352435], [49, 353075], [52, 353235], [59, 353855], [61, 353975], [64, 354075]]}, {"verse": 42, "start": 355129, "end": 367670, "text": "Pero Jesús, llamándolos, les dice: Sabéis que los que son reconocidos como gobernantes entre las naciones, las dominan, y los que entre ellas son grandes, tienen sobre ellas autoridad.", "words": [[0, 355129], [5, 355273], [12, 355813], [25, 356453], [29, 357093], [35, 357906], [42, 358288], [46, 358508], [50, 358848], [54, 359048], [58, 359328], [70, 360108], [75, 360348], [87, 361028], [93, 361288], [97, 361508], [107, 362028], [111, 362488], [120, 363128], [122, 363568], [126, 363728], [130, 363868], [136, 364088], [142, 364388], [146, 364648], [155, 365048], [162, 365988], [168, 366348], [174, 366708]]}, {"verse": 43, "start": 368120, "end": 375819, "text": "Pero no será así entre vosotros, sino que el que quiera hacerse grande entre vosotros será vuestro servidor;", "words": [[0, 368120], [5, 368284], [8, 368504], [13, 368764], [17, 369184], [23, 369504], [33, 370684], [38, 371064], [42, 371364], [45, 371684], [49, 371864], [56, 372304], [64, 372984], [71, 373384], [77, 373724], [86, 374344], [91, 374624], [99, 375044]]}, {"verse": 44, "start": 376269, "end": 381310, "text": "Y el que de vosotros quiera ser el primero, será siervo de todos.", "words": [[0, 376269], [2, 376586], [5, 376746], [9, 376946], [12, 377086], [21, 377606], [28, 378006], [32, 378206], [35, 378386], [44, 378946], [49, 379826], [56, 380506], [59, 380646]]}, {"verse": 45, "start": 381760, "end": 389697, "text": "Porque el Hijo del hombre tampoco vino para ser servido, sino para servir, y dar su vida en rescate por muchos.", "words": [[0, 381760], [7, 382024], [10, 382384], [15, 382644], [19, 382784], [26, 383164], [34, 383444], [39, 384024], [44, 384344], [48, 384604], [57, 385744], [62, 386044], [67, 386284], [75, 386764], [77, 387264], [81, 387464], [84, 387684], [89, 387984], [92, 388104], [100, 388664], [104, 388924]]}, {"verse": 46, "start": 390147, "end": 404625, "text": "Entonces vienen a Jericó: y saliendo él de Jericó y sus discípulos y una gran multitud, Bartimeo el ciego, hijo de Timeo, estaba sentado junto al camino mendigando.", "words": [[0, 390147], [9, 390649], [16, 391009], [18, 391229], [26, 392097], [28, 392259], [37, 392839], [40, 393179], [43, 393379], [50, 394059], [52, 394519], [56, 394719], [67, 395559], [69, 395999], [73, 396159], [78, 396419], [88, 397639], [97, 398839], [100, 398959], [107, 400039], [112, 400239], [115, 400439], [122, 401399], [129, 401719], [137, 402479], [143, 402759], [146, 403059], [153, 403479]]}, {"verse": 47, "start": 405075, "end": 413588, "text": "Y oyendo que era Jesús el nazareno, comenzó a dar voces y decir: Jesús, Hijo de David, ten misericordia de mí.", "words": [[0, 405075], [2, 405240], [9, 405600], [13, 405860], [17, 406060], [23, 406800], [26, 406960], [36, 408100], [44, 408800], [46, 408920], [50, 409020], [56, 409540], [58, 409700], [65, 410572], [72, 411120], [77, 411340], [80, 411460], [87, 411920], [91, 412380], [104, 413160], [107, 413300]]}, {"verse": 48, "start": 413938, "end": 425640, "text": "Y muchos le reprendían, que callase: pero él daba mayores voces: Hijo de David, ten misericordia de mí.", "words": [[0, 413938], [2, 414059], [9, 414459], [12, 414859], [24, 415719], [28, 416259], [37, 417351], [42, 417538], [45, 417958], [50, 418538], [58, 418958], [65, 419972], [70, 420230], [73, 420370], [80, 420930], [84, 421050], [97, 421850], [100, 421990]]}, {"verse": 49, "start": 425990, "end": 434029, "text": "Entonces Jesús parándose, mandó llamarle: y llaman al ciego, diciéndole: Ten ánimo: levántate, te llama.", "words": [[0, 425990], [9, 426395], [15, 426855], [26, 427795], [32, 428355], [42, 429350], [44, 429478], [51, 429758], [54, 429958], [61, 430798], [73, 432152], [77, 432386], [84, 432887], [95, 433215], [98, 433585]]}, {"verse": 50, "start": 434379, "end": 439121, "text": "Él entonces, echando su capa, se levantó, y vino a Jesús.", "words": [[0, 434379], [3, 434662], [13, 435322], [21, 435962], [24, 436162], [30, 436882], [33, 437042], [42, 437702], [44, 438122], [49, 438362], [51, 438522]]}, {"verse": 51, "start": 439571, "end": 446840, "text": "Y respondiendo Jesús, le dice: ¿Qué quieres que te haga? Y el ciego le dice: Maestro, que recobre la vista.", "words": [[0, 439571], [2, 439677], [15, 440297], [22, 440617], [25, 440977], [31, 441769], [36, 441884], [44, 442204], [48, 442424], [51, 442604], [57, 443378], [59, 443503], [62, 443623], [68, 444063], [71, 444223], [77, 445000], [86, 445525], [90, 445725], [98, 446225], [101, 446345]]}, {"verse": 52, "start": 447190, "end": 455484, "text": "Y Jesús le dijo: Ve, tu fe te ha salvado. Y luego recobró la vista, y seguía a Jesús en el camino.", "words": [[0, 447190], [2, 447334], [8, 447714], [11, 448074], [17, 449166], [21, 449496], [24, 449776], [27, 449976], [30, 450176], [33, 450316], [42, 451376], [44, 451657], [50, 451897], [58, 452617], [61, 452777], [68, 453077], [70, 453337], [77, 453857], [79, 454037], [85, 454337], [88, 454677], [91, 454797]]}]}