{"book": "1CO", "chapter": 8, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 98822, "verses": [{"verse": 1, "start": 300, "end": 8534, "text": "Y por lo que hace a lo sacrificado a los ídolos, sabemos que todos tenemos conocimiento. El conocimiento envanece, pero el amor edifica.", "words": [[0, 300], [2, 425], [6, 625], [9, 805], [13, 965], [18, 1225], [20, 1385], [23, 1445], [35, 2125], [37, 2245], [41, 2365], [49, 3165], [57, 3565], [61, 3865], [67, 4105], [75, 4505], [89, 5815], [92, 5919], [105, 6559], [115, 7199], [120, 7499], [123, 7639], [128, 7839]]}, {"verse": 2, "start": 8984, "end": 13368, "text": "Y si alguno se imagina que sabe algo, aún no sabe nada como debe saber.", "words": [[0, 8984], [2, 9073], [5, 9193], [12, 9613], [15, 9713], [23, 10213], [27, 10313], [32, 10573], [38, 11213], [42, 11593], [45, 11813], [50, 12053], [55, 12333], [60, 12613], [65, 12833]]}, {"verse": 3, "start": 13818, "end": 16715, "text": "Pero si alguno ama a Dios, el tal es conocido de él.", "words": [[0, 13818], [5, 13977], [8, 14157], [15, 14577], [19, 14717], [21, 14877], [27, 15357], [30, 15477], [34, 15657], [37, 15797], [46, 16297], [49, 16457]]}, {"verse": 4, "start": 17165, "end": 24686, "text": "Acerca, pues, de los alimentos sacrificados a los ídolos, sabemos que el ídolo nada es en el mundo, y que no hay más de un Dios.", "words": [[0, 17165], [8, 17581], [14, 18301], [17, 18381], [21, 18501], [31, 18841], [44, 19761], [46, 19941], [50, 20061], [58, 20801], [66, 21141], [70, 21441], [73, 21561], [79, 21841], [84, 22081], [87, 22381], [90, 22501], [93, 22641], [100, 22981], [102, 23381], [106, 23501], [109, 23681], [113, 23761], [117, 23941], [120, 24101], [123, 24201]]}, {"verse": 5, "start": 25136, "end": 32017, "text": "Porque aunque haya algunos que se llamen dioses, o en el cielo, o en la tierra (como hay muchos dioses y muchos señores),", "words": [[0, 25136], [7, 25347], [14, 25527], [19, 25827], [27, 26187], [31, 26427], [34, 26637], [41, 26847], [49, 27387], [51, 27787], [54, 27907], [57, 28027], [64, 28387], [66, 28667], [69, 28767], [72, 28867], [79, 29547], [85, 29807], [89, 29947], [96, 30167], [103, 30747], [105, 31007], [112, 31247]]}, {"verse": 6, "start": 32467, "end": 43501, "text": "Pero nosotros no tenemos más de un Dios, el Padre, del cual son todas las cosas, y nosotros en él: y un Señor Jesucristo, por el cual son todas las cosas, y nosotros por él.", "words": [[0, 32467], [5, 32604], [14, 32904], [17, 33224], [25, 33524], [29, 33864], [32, 34044], [35, 34224], [41, 34984], [44, 35124], [51, 35864], [55, 36024], [60, 36224], [64, 36484], [70, 36684], [74, 36964], [81, 37324], [83, 37884], [92, 38204], [95, 38584], [99, 39154], [101, 39312], [104, 39432], [110, 39712], [122, 40692], [126, 40792], [129, 40912], [134, 41052], [138, 41312], [144, 41572], [148, 41852], [155, 42232], [157, 42552], [166, 42812], [170, 43252]]}, {"verse": 7, "start": 43951, "end": 54875, "text": "Pero no en todos hay este conocimiento: porque algunos con conciencia del ídolo hasta aquí, comen como sacrificado a ídolos; y su conciencia, siendo débil, es contaminada.", "words": [[0, 43951], [5, 44095], [8, 44275], [11, 44435], [17, 44615], [21, 44955], [26, 45195], [40, 47350], [47, 47530], [55, 47830], [59, 48110], [70, 48670], [74, 48870], [80, 49130], [86, 49350], [92, 49650], [98, 50130], [103, 50390], [115, 51150], [117, 51270], [125, 52122], [127, 52223], [130, 52323], [142, 53163], [149, 53383], [156, 53983], [159, 54083]]}, {"verse": 8, "start": 55325, "end": 63028, "text": "Si bien el alimento no nos hace más aceptos a Dios: porque ni que comamos, seremos mejores; ni que no comamos, seremos peores.", "words": [[0, 55325], [3, 55500], [8, 55710], [11, 55830], [20, 56130], [23, 56330], [27, 56510], [32, 56830], [36, 57190], [44, 57510], [46, 57830], [52, 58394], [59, 58600], [62, 58820], [66, 58940], [75, 59420], [83, 59840], [92, 60870], [95, 61029], [99, 61169], [102, 61349], [111, 61849], [119, 62289]]}, {"verse": 9, "start": 63478, "end": 67935, "text": "Pero mirad que esta vuestra libertad no sea ocasión de tropiezo a los que son débiles.", "words": [[0, 63478], [5, 63625], [11, 64025], [15, 64165], [20, 64365], [28, 64765], [37, 65305], [40, 65445], [44, 65645], [52, 66165], [55, 66265], [64, 66785], [66, 66905], [70, 67025], [74, 67165], [78, 67365]]}, {"verse": 10, "start": 68385, "end": 79650, "text": "Porque si te ve alguno, a ti que tienes conocimiento, que estás sentado a la mesa en el lugar de los ídolos, ¿la conciencia de aquel que es débil, no será animada a comer de lo sacrificado a los ídolos?", "words": [[0, 68385], [7, 68563], [10, 68723], [13, 68883], [16, 69003], [24, 69743], [26, 69783], [29, 69903], [33, 70023], [40, 70283], [54, 71303], [58, 71473], [64, 71643], [72, 72163], [74, 72283], [77, 72363], [82, 72663], [85, 72843], [88, 72963], [94, 73203], [97, 73363], [101, 73503], [109, 74383], [113, 74523], [124, 75123], [127, 75283], [133, 75643], [137, 75783], [140, 75943], [147, 76672], [150, 76775], [155, 76975], [163, 77515], [165, 77655], [171, 77895], [174, 78115], [177, 78215], [189, 78875], [191, 78975], [195, 79095]]}, {"verse": 11, "start": 80100, "end": 84056, "text": "Y por tu conocimiento se perderá el hermano débil por el cual Cristo murió.", "words": [[0, 80100], [2, 80206], [6, 80326], [9, 80426], [22, 81126], [25, 81266], [33, 81766], [36, 81846], [44, 82246], [50, 82546], [54, 82766], [57, 82886], [62, 83046], [69, 83466]]}, {"verse": 12, "start": 84506, "end": 91383, "text": "De esta manera, pues, pecando contra los hermanos, e hiriendo su débil conciencia, contra Cristo pecáis.", "words": [[0, 84506], [3, 84623], [8, 84843], [16, 85183], [22, 85543], [30, 86383], [37, 86703], [41, 86883], [51, 87823], [53, 88103], [62, 88383], [65, 88603], [71, 88863], [83, 89663], [90, 90243], [97, 90843]]}, {"verse": 13, "start": 91833, "end": 98422, "text": "Por lo cual, si la comida puede hacer pecar a mi hermano, j