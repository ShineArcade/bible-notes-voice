{"book": "ACT", "chapter": 5, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 361795, "verses": [{"verse": 1, "start": 300, "end": 5461, "text": "Pero un hombre llamado Ananías, con Safira su mujer, vendió una posesión,", "words": [[0, 300], [5, 442], [8, 602], [15, 842], [23, 1102], [32, 2502], [36, 2822], [43, 3142], [46, 3222], [53, 4002], [60, 4422], [64, 4582]]}, {"verse": 2, "start": 5811, "end": 15418, "text": "Y retuvo fraudulentamente parte del precio, sabiéndolo también su mujer; y trayendo una parte, la puso a los pies de los apóstoles.", "words": [[0, 5811], [2, 5934], [9, 6494], [26, 7974], [32, 8434], [36, 8794], [44, 9374], [55, 10474], [63, 10814], [66, 11114], [73, 11924], [75, 12131], [84, 12511], [88, 12691], [95, 13431], [98, 13511], [103, 13851], [105, 13931], [109, 14051], [114, 14251], [117, 14411], [121, 14531]]}, {"verse": 3, "start": 15768, "end": 25655, "text": "Y dijo Pedro: Ananías, ¿por qué ha llenado Satanás tu corazón a que mintieses al Espíritu Santo, y retuvieses fraudulentamente parte del precio del terreno?", "words": [[0, 15768], [2, 15915], [7, 16155], [14, 16957], [23, 18002], [28, 18102], [32, 18302], [35, 18422], [43, 18762], [51, 19342], [54, 19442], [62, 19902], [64, 20102], [68, 20222], [78, 20882], [81, 21062], [90, 21562], [97, 21922], [99, 22157], [110, 22837], [127, 23817], [133, 24157], [137, 24477], [144, 24797], [148, 24977]]}, {"verse": 4, "start": 26005, "end": 35235, "text": "Reteniéndola, ¿no se te quedaba a ti? y vendida, ¿no estaba en tu potestad? ¿Por qué pusiste esto en tu corazón? No has mentido a los hombres, sino a Dios.", "words": [[0, 26392], [14, 27232], [18, 27412], [21, 27552], [24, 27672], [32, 28032], [34, 28172], [38, 28685], [40, 28795], [49, 29275], [53, 29595], [60, 29875], [63, 30035], [66, 30135], [76, 30995], [81, 31122], [85, 31262], [93, 31722], [98, 31982], [101, 32142], [104, 32242], [113, 33135], [116, 33276], [120, 33416], [128, 33816], [130, 33896], [134, 34016], [143, 34536], [148, 34656], [150, 34816]]}, {"verse": 5, "start": 35515, "end": 43622, "text": "Entonces Ananías, oyendo estas palabras, cayó y murió. Y vino un gran temor sobre todos los que lo oyeron.", "words": [[0, 35515], [9, 36057], [18, 37317], [25, 37737], [31, 37957], [41, 38957], [46, 39397], [48, 39537], [55, 40300], [57, 40405], [62, 40625], [65, 40845], [70, 41045], [76, 41545], [82, 41825], [88, 42325], [92, 42625], [96, 42765], [99, 42945]]}, {"verse": 6, "start": 43972, "end": 49572, "text": "Y levantándose los jóvenes, le tomaron, y sacándolo, lo sepultaron.", "words": [[0, 43972], [2, 44061], [15, 44881], [19, 45021], [28, 46021], [31, 46121], [40, 47061], [42, 47301], [53, 48501], [56, 49059]]}, {"verse": 7, "start": 49922, "end": 56454, "text": "Y pasado espacio como de tres horas, sucedió que entró su mujer, no sabiendo lo que había acontecido.", "words": [[0, 49922], [2, 50044], [9, 50444], [17, 51004], [22, 51344], [25, 51544], [30, 51824], [37, 52144], [45, 52944], [49, 53124], [55, 53444], [58, 53584], [65, 54004], [68, 54364], [77, 54824], [80, 55004], [84, 55144], [90, 55464]]}, {"verse": 8, "start": 56804, "end": 64784, "text": "Entonces Pedro le dijo: Dime: ¿vendisteis el terreno por esa cantidad? Y ella dijo: Sí, por esa cantidad.", "words": [[0, 56804], [9, 57446], [15, 57986], [18, 58246], [24, 58953], [30, 59613], [42, 60315], [45, 60435], [53, 60815], [57, 61015], [61, 61155], [71, 62052], [73, 62214], [78, 62414], [84, 63204], [88, 63584], [92, 63704], [96, 63884]]}, {"verse": 9, "start": 65064, "end": 73532, "text": "Y Pedro le dijo: ¿Por qué os concertasteis para tentar al Espíritu del Señor? He aquí a la puerta los pies de los que han sepultado a tu marido, y te sacarán.", "words": [[0, 65064], [2, 65173], [8, 65513], [11, 65753], [17, 66512], [22, 66652], [26, 66812], [29, 66932], [43, 67812], [48, 68062], [55, 68312], [58, 68472], [67, 68972], [71, 69052], [78, 69842], [81, 69911], [86, 70072], [88, 70191], [91, 70271], [98, 70512], [102, 70771], [107, 71012], [110, 71152], [114, 71271], [118, 71432], [122, 71551], [132, 72072], [134, 72172], [137, 72232], [145, 72672], [147, 72831], [150, 72932]]}, {"verse": 10, "start": 73812, "end": 84076, "text": "Y de inmediato cayó a los pies de él y murió: y entrados los jóvenes, la hallaron muerta; y la sacaron, y la sepultaron junto a su marido.", "words": [[0, 73812], [2, 73958], [5, 74058], [15, 74738], [20, 75158], [22, 75258], [26, 75358], [31, 75578], [34, 75818], [37, 75998], [39, 76198], [46, 76931], [48, 77061], [57, 77641], [61, 77801], [70, 78301], [73, 78646], [82, 79086], [90, 80044], [92, 80167], [95, 80287], [104, 80947], [106, 81727], [109, 81847], [120, 82687], [126, 83047], [128, 83327], [131, 83447]]}, {"verse": 11, "start": 84426, "end": 89663, "text": "Y vino un gran temor en toda la iglesia, y en todos los que oyeron estas cosas.", "words": [[0, 84426], [2, 84585], [7, 84825], [10, 85025], [15, 85225], [21, 85725], [24, 85925], [29, 86105], [32, 86365], [41, 86965], [43, 87185], [46, 87385], [52, 87705], [56, 88085], [60, 88305], [67, 88785], [73, 88965]]}, {"verse": 12, "start": 90013, "end": 99206, "text": "Y por las manos de los apóstoles eran hechos muchos milagros y prodigios en el pueblo; y estaban todos unánimes en el pórtico de Salomón.", "words": [[0, 90013], [2, 90122], [6, 90282], [10, 90462], [16, 90782], [19, 90942], [23, 91042], [33, 91642], [38, 91982], [45, 92662], [52, 92922], [61, 93682], [63, 93802], [73, 94442], [76, 94622], [79, 94742], [87, 95596], [89, 95714], [97, 96014], [103, 96454], [112, 97354], [115, 97554], [118, 97694], [126, 98294], [129, 98454]]}, {"verse": 13, "start": 99556, "end": 106271, "text": "Y de los otros, ninguno se atrevía a juntarse con ellos; pero el pueblo los alababa grandemente.", "words": [[0, 99556], [2, 99664], [5, 99764], [9, 99944], [16, 100744], [24, 101424], [27, 101564], [35, 102084], [37, 102244], [46, 102844], [50, 103064], [57, 103754], [62, 103898], [65, 104078], [72, 104338], [76, 104678], [84, 105258]]}, {"verse": 14, "start": 106621, "end": 112637, "text": "Y aumentaba el número de quienes creían en el Señor, tanto hombres como mujeres;", "words": [[0, 106621], [2, 106744], [12, 107544], [15, 107744], [22, 108064], [25, 108324], [33, 108644], [40, 109344], [43, 109504], [46, 109664], [53, 110584], [59, 110824], [67, 111384], [72, 111804]]}, {"verse": 15, "start": 112987, "end": 124372, "text": "Tanto que sacaban los enfermos por las calles, y los ponían en camas y en lechos, para que viniendo Pedro, a lo menos su sombra tocase a alguno de ellos.", "words": [[0, 112987], [6, 113171], [10, 113391], [18, 113931], [22, 114071], [31, 114731], [35, 114931], [39, 115131], [47, 115771], [49, 116191], [53, 116311], [60, 116751], [63, 117071], [69, 117711], [71, 117911], [74, 118051], [82, 118511], [87, 119191], [91, 119351], [100, 119911], [107, 121211], [109, 121271], [112, 121411], [118, 121631], [121, 122051], [128, 122671], [135, 122861], [137, 123051], [144, 123651], [147, 123771]]}, {"verse": 16, "start": 124722, "end": 136744, "text": "Y aun de las ciudades vecinas concurría multitud a Jerusalén, trayendo enfermos y atormentados de espíritus inmundos; los cuales todos eran curados.", "words": [[0, 124722], [2, 124882], [6, 125102], [9, 125362], [13, 125482], [22, 126022], [30, 126862], [40, 127702], [49, 128322], [51, 128462], [62, 129422], [71, 130022], [80, 130742], [82, 130922], [95, 131962], [98, 132472], [108, 132982], [118, 134072], [122, 134349], [129, 134709], [135, 135349], [140, 135769]]}, {"verse": 17, "start": 137094, "end": 146513, "text": "Entonces levantándose el sumo sacerdote, y todos los que estaban con él, que es la secta de los saduceos, se llenaron de celos;", "words": [[0, 137094], [9, 138338], [22, 139218], [25, 139338], [30, 139798], [41, 140478], [43, 140818], [49, 141098], [53, 141358], [57, 141518], [65, 141818], [69, 142138], [73, 142578], [77, 142838], [80, 143058], [83, 143438], [89, 143958], [92, 144058], [96, 144638], [106, 145218], [109, 145318], [118, 145758], [121, 145918]]}, {"verse": 18, "start": 146863, "end": 151464, "text": "Y echaron mano a los apóstoles, y los pusieron en la cárcel pública.", "words": [[0, 146863], [2, 147007], [10, 147427], [15, 147847], [17, 148107], [21, 148227], [32, 148987], [34, 149347], [38, 149467], [47, 149947], [50, 150107], [53, 150247], [60, 150667]]}, {"verse": 19, "start": 151814, "end": 157709, "text": "Pero el ángel del Señor, abriendo de noche las puertas de la cárcel, y sacándolos, dijo:", "words": [[0, 151814], [5, 152074], [8, 152254], [14, 152594], [18, 152734], [25, 153534], [34, 154014], [37, 154154], [43, 154334], [47, 154614], [55, 155034], [58, 155174], [61, 155274], [69, 155754], [71, 155974], [83, 157114]]}, {"verse": 20, "start": 157909, "end": 162298, "text": "Id, y estando en el templo, hablad al pueblo todas las palabras de esta vida.", "words": [[0, 157909], [4, 157909], [6, 158111], [14, 158711], [17, 158831], [20, 158931], [28, 159378], [35, 159824], [38, 160271], [45, 160491], [51, 160831], [55, 161131], [64, 161471], [67, 161731], [72, 161871]]}, {"verse": 21, "start": 162578, "end": 181707, "text": "Y oído que hubieron esto, entraron de mañana en el templo, y enseñaban. Entre tanto, viniendo el sumo sacerdote, y los que eran con él, convocaron el Consejo, y a todos los ancianos de los hijos de Israel, y enviaron a la cárcel para que fuesen traídos.", "words": [[0, 162578], [2, 162766], [7, 163026], [11, 163276], [20, 163526], [26, 163946], [35, 164711], [38, 164851], [45, 165191], [48, 165431], [51, 165591], [59, 166371], [61, 166531], [72, 167651], [78, 167953], [85, 168753], [94, 169493], [97, 169673], [102, 170193], [113, 170993], [115, 171593], [119, 171773], [123, 171933], [128, 172173], [132, 172413], [136, 173173], [147, 173813], [150, 173993], [159, 174973], [161, 175333], [163, 175413], [169, 175633], [173, 175893], [182, 176493], [185, 176633], [189, 176733], [195, 177053], [198, 177233], [206, 178221], [208, 178502], [217, 179082], [219, 179242], [222, 179342], [229, 179862], [234, 180262], [238, 180422], [245, 180822]]}, {"verse": 22, "start": 182057, "end": 187807, "text": "Pero cuando llegaron los guardias, y no los hallaron en la cárcel, volvieron, y dieron aviso,", "words": [[0, 182057], [5, 182219], [12, 182499], [21, 183099], [25, 183299], [35, 183959], [37, 184234], [40, 184374], [44, 184574], [53, 185074], [56, 185234], [59, 185374], [67, 186034], [78, 186554], [80, 186874], [87, 187194]]}, {"verse": 23, "start": 188157, "end": 198021, "text": "Diciendo: Por cierto, la cárcel hemos hallado cerrada con toda seguridad, y los guardas que estaban delante de las puertas; pero cuando abrimos, a nadie hallamos dentro.", "words": [[0, 188157], [10, 189177], [14, 189285], [22, 189785], [25, 189845], [32, 190245], [38, 190445], [46, 190925], [54, 191385], [58, 191605], [63, 191825], [74, 192325], [76, 192965], [80, 193105], [88, 193505], [92, 193665], [100, 193925], [108, 194345], [111, 194465], [115, 194585], [124, 195465], [129, 195586], [136, 195826], [145, 196646], [147, 196786], [153, 197136], [162, 197486]]}, {"verse": 24, "start": 198301, "end": 208883, "text": "Y cuando oyeron estas palabras el sumo sacerdote y el jefe de la guardia del templo y los principales sacerdotes, dudaban en qué vendría a parar aquello.", "words": [[0, 198301], [2, 198426], [9, 198726], [16, 199426], [22, 199646], [31, 200186], [34, 200726], [39, 201226], [49, 201966], [51, 202106], [54, 202226], [59, 202646], [62, 202746], [65, 202866], [73, 203306], [77, 203506], [84, 204346], [86, 204506], [90, 204646], [102, 205286], [114, 206106], [122, 207106], [125, 207266], [129, 207446], [137, 207906], [139, 207986], [145, 208206]]}, {"verse": 25, "start": 209233, "end": 217124, "text": "Pero viniendo uno, les dio esta noticia: He aquí, los varones que echasteis en la cárcel, están en el templo, y enseñan al pueblo.", "words": [[0, 209233], [5, 209473], [14, 210013], [19, 210453], [23, 210913], [27, 211113], [32, 211313], [41, 212340], [44, 212448], [50, 212708], [54, 212848], [62, 213248], [66, 213468], [76, 214028], [79, 214108], [82, 214208], [90, 214808], [96, 215048], [99, 215208], [102, 215328], [110, 215888], [112, 216028], [120, 216488], [123, 216608]]}, {"verse": 26, "start": 217404, "end": 225615, "text": "Entonces fue el jefe de la guardia con los guardias, y los trajo sin violencia; porque temían del pueblo ser apedreados.", "words": [[0, 217404], [9, 217952], [13, 218412], [16, 218682], [21, 218952], [24, 219112], [27, 219232], [35, 219692], [39, 219892], [43, 220052], [53, 220592], [55, 221072], [59, 221332], [65, 221592], [69, 221792], [80, 222818], [87, 223020], [94, 223520], [98, 223740], [105, 224060], [109, 224420]]}, {"verse": 27, "start": 225965, "end": 232506, "text": "Y como los trajeron, los presentaron en el Consejo: y el sumo sacerdote les preguntó,", "words": [[0, 225965], [2, 226246], [7, 226506], [11, 226686], [21, 227746], [25, 227846], [37, 228626], [40, 228806], [43, 228946], [52, 229966], [54, 230129], [57, 230289], [62, 230769], [72, 231449], [76, 231609]]}, {"verse": 28, "start": 232856, "end": 243799, "text": "Diciendo: ¿No os ordenamos estrictamente que no enseñaseis en este nombre? y he aquí, habéis llenado a Jerusalén de vuestra doctrina, y queréis echar sobre nosotros la sangre de este hombre.", "words": [[0, 232856], [10, 233872], [14, 234075], [17, 234235], [27, 234755], [41, 235635], [45, 235815], [48, 235995], [59, 236655], [62, 236815], [67, 237015], [75, 237806], [77, 237860], [80, 237950], [86, 238250], [93, 238710], [101, 239130], [103, 239230], [113, 239790], [116, 239910], [124, 240190], [134, 240710], [136, 240925], [144, 241265], [150, 241585], [156, 241845], [165, 242265], [168, 242545], [175, 242865], [178, 243065], [183, 243225]]}, {"verse": 29, "start": 244079, "end": 251215, "text": "Y respondiendo Pedro y los apóstoles, dijeron: Es necesario obedecer a Dios antes que a los hombres.", "words": [[0, 244079], [2, 244206], [15, 244966], [21, 245426], [23, 245626], [27, 245786], [38, 246746], [47, 247669], [50, 247815], [60, 248535], [69, 249235], [71, 249375], [76, 249615], [82, 250115], [86, 250395], [88, 250475], [92, 250595]]}, {"verse": 30, "start": 251565, "end": 257369, "text": "El Dios de nuestros padres levantó a Jesús, al cual vosotros matasteis colgándole en un madero.", "words": [[0, 251565], [3, 251709], [8, 251949], [11, 252129], [20, 252289], [27, 252849], [35, 253389], [37, 253509], [44, 254369], [47, 254449], [52, 254629], [61, 255129], [71, 255949], [82, 256569], [85, 256729], [88, 256829]]}, {"verse": 31, "start": 257719, "end": 264290, "text": "A este Dios ha exaltado con su diestra por Príncipe y Salvador, para dar a Israel arrepentimiento y perdón de pecados.", "words": [[0, 257719], [2, 257818], [7, 258038], [12, 258418], [15, 258518], [24, 259058], [28, 259218], [31, 259378], [39, 259738], [43, 259938], [52, 260498], [54, 260598], [64, 261118], [69, 261618], [73, 261818], [75, 261918], [82, 262238], [98, 263118], [100, 263238], [107, 263558], [110, 263638]]}, {"verse": 32, "start": 264640, "end": 272079, "text": "Y nosotros somos testigos suyos de estas cosas, y también el Espíritu Santo, el cual ha dado Dios a los que le obedecen.", "words": [[0, 264640], [2, 264745], [11, 264985], [17, 265425], [26, 265985], [32, 266425], [35, 266545], [41, 266745], [48, 267645], [50, 267865], [58, 268145], [61, 268305], [70, 268825], [77, 269765], [80, 269865], [85, 270045], [88, 270225], [93, 270405], [98, 270685], [100, 271005], [104, 271125], [108, 271245], [111, 271345]]}, {"verse": 33, "start": 272359, "end": 277551, "text": "Ellos, oyendo esto, se enfurecían y planeaban matarlos.", "words": [[0, 272359], [7, 272867], [14, 273287], [20, 274207], [23, 274427], [34, 275447], [36, 275767], [46, 276407]]}, {"verse": 34, "start": 277901, "end": 289826, "text": "Entonces levantándose en el Consejo un fariseo llamado Gamaliel, maestro de la ley, venerable a todo el pueblo, mandó que sacasen fuera por un momento a los apóstoles.", "words": [[0, 277901], [9, 279142], [22, 280042], [25, 280222], [28, 280362], [36, 280962], [39, 281162], [47, 281802], [55, 282042], [65, 283222], [73, 283702], [76, 283882], [79, 284002], [84, 284642], [94, 285222], [96, 285382], [101, 285582], [104, 285782], [112, 286662], [118, 287022], [122, 287342], [130, 287662], [136, 287962], [140, 288242], [143, 288382], [151, 288722], [153, 288862], [157, 288962]]}, {"verse": 35, "start": 290176, "end": 296267, "text": "Y les dijo: Varones israelitas, mirad por vosotros acerca de estos hombres en lo que habéis de hacer.", "words": [[0, 290176], [2, 290344], [6, 290424], [12, 291278], [20, 291488], [32, 292628], [38, 292968], [42, 293088], [51, 293588], [58, 293968], [61, 294248], [67, 294428], [75, 294848], [78, 295148], [81, 295248], [85, 295388], [92, 295668], [95, 295808]]}, {"verse": 36, "start": 296617, "end": 309396, "text": "Porque antes de estos días se levantó Teudas, diciendo que era alguien; al que se agregó un número de hombres como cuatrocientos: el cual fue matado; y todos los que le creyeron fueron dispersos, y reducidos a nada.", "words": [[0, 296617], [7, 296801], [13, 297101], [16, 297321], [22, 297501], [27, 297881], [30, 298241], [38, 298741], [46, 299261], [55, 299661], [59, 300041], [63, 300261], [72, 301060], [75, 301198], [79, 301338], [82, 301478], [89, 301918], [92, 302038], [99, 302318], [102, 302518], [110, 302798], [115, 303498], [130, 304355], [133, 304473], [138, 304633], [142, 304873], [150, 305705], [152, 305823], [158, 306023], [162, 306303], [166, 306483], [169, 306583], [178, 307083], [185, 307283], [196, 308083], [198, 308243], [208, 308763], [210, 308983]]}, {"verse": 37, "start": 309746, "end": 319992, "text": "Después de este, se levantó Judas el galileo en los días del censo, y llevó mucho pueblo tras sí. Pereció también aquel; y todos los que consintieron con él, fueron dispersados.", "words": [[0, 309746], [8, 310052], [11, 310272], [17, 310552], [20, 310712], [28, 311172], [34, 311472], [37, 311692], [45, 312192], [48, 312312], [52, 312432], [57, 312632], [61, 312852], [68, 313372], [70, 313852], [76, 314132], [82, 314372], [89, 314732], [94, 314992], [98, 315585], [106, 315944], [114, 316204], [121, 317014], [123, 317116], [129, 317316], [133, 317576], [137, 317966], [150, 318356], [154, 318556], [158, 318756], [165, 319016]]}, {"verse": 38, "start": 320342, "end": 329067, "text": "Y ahora os digo: Apartaos de estos hombres y dejadlos en paz; porque si este consejo o esta obra es de los hombres, se desvanecerá:", "words": [[0, 320342], [2, 320460], [8, 320601], [11, 320821], [17, 321735], [26, 322045], [29, 322265], [35, 322505], [43, 323025], [45, 323375], [54, 323725], [57, 323985], [62, 324647], [69, 324827], [72, 325047], [77, 325327], [85, 326027], [87, 326187], [92, 326427], [97, 326767], [100, 327007], [103, 327127], [107, 327307], [116, 328087], [119, 328187]]}, {"verse": 39, "start": 329417, "end": 335117, "text": "Pero si es de Dios, no la podréis deshacer; no seáis tal vez hallados resistiendo a Dios.", "words": [[0, 329417], [5, 329564], [8, 329784], [11, 329964], [14, 330104], [20, 330704], [23, 330824], [26, 330944], [34, 331464], [44, 332337], [47, 332523], [53, 332943], [57, 333123], [61, 333363], [70, 333843], [82, 334563], [84, 334683]]}, {"verse": 40, "start": 335397, "end": 345627, "text": "Y convinieron con él: y llamando a los apóstoles, después de azotados, les ordenaron que no hablasen en el nombre de Jesús, y los soltaron.", "words": [[0, 335397], [2, 335519], [14, 336239], [18, 336459], [22, 337102], [24, 337262], [33, 337742], [35, 337842], [39, 337982], [50, 339102], [58, 339302], [61, 339922], [71, 340542], [75, 340682], [85, 341542], [89, 341782], [92, 342002], [101, 342642], [104, 342802], [107, 342962], [114, 343362], [117, 343562], [124, 343942], [126, 344407], [130, 344567]]}, {"verse": 41, "start": 345977, "end": 354617, "text": "Y ellos salieron de delante del Consejo, gozosos de que fuesen tenidos por dignos de padecer deshonra por el Nombre.", "words": [[0, 345977], [2, 346113], [8, 346373], [17, 347093], [20, 347293], [28, 347753], [32, 347933], [41, 349013], [49, 349793], [52, 350213], [56, 350353], [63, 350803], [71, 351253], [75, 351493], [82, 352033], [85, 352133], [93, 352693], [102, 353653], [106, 353853], [109, 354013]]}, {"verse": 42, "start": 354967, "end": 361395, "text": "Y todos los días, en el templo y por las casas, no cesaban de enseñar y predicar a Jesucristo.", "words": [[0, 354967], [2, 355070], [8, 355290], [12, 355570], [18, 355930], [21, 356385], [24, 356545], [31, 357065], [33, 357145], [37, 357345], [41, 357505], [48, 358125], [51, 358505], [59, 359025], [62, 359225], [70, 359765], [72, 359825], [81, 360325], [83, 360867]]}]}