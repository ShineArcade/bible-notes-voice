{"book": "MRK", "chapter": 14, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 577483, "verses": [{"verse": 1, "start": 300, "end": 11678, "text": "Y dos días después era la Pascua y la fiesta de los panes sin levadura: y buscaban los principales sacerdotes y los escribas cómo le prenderían con engaño, y le matarían.", "words": [[0, 300], [2, 426], [6, 606], [11, 906], [19, 1306], [23, 1766], [26, 2116], [33, 2466], [35, 2526], [38, 2606], [45, 3006], [48, 3146], [52, 3286], [58, 3826], [62, 3966], [72, 5027], [74, 5132], [83, 5632], [87, 5772], [99, 6452], [110, 7152], [112, 7292], [116, 7432], [125, 8052], [130, 8612], [133, 8832], [144, 9472], [148, 9652], [156, 10292], [158, 10772], [161, 10872]]}, {"verse": 2, "start": 12028, "end": 16746, "text": "Y decían: No en el día de la fiesta, porque no se haga alboroto del pueblo.", "words": [[0, 12028], [2, 12250], [10, 13229], [13, 13410], [16, 13570], [19, 13670], [23, 13830], [26, 13950], [29, 14050], [37, 14790], [44, 14990], [47, 15170], [50, 15370], [55, 15710], [64, 16050], [68, 16210]]}, {"verse": 3, "start": 17026, "end": 32903, "text": "Y estando él en Betania en casa de Simón el leproso, y sentado a la mesa, vino una mujer teniendo un frasco de alabastro con perfume de nardo puro muy costoso; y rompiendo el frasco, se lo derramó sobre su cabeza.", "words": [[0, 17026], [2, 17190], [10, 17710], [13, 18090], [16, 18370], [24, 19190], [27, 19290], [32, 19530], [35, 19750], [41, 20405], [44, 20525], [53, 21545], [55, 21645], [63, 22125], [65, 22205], [68, 22285], [74, 23009], [79, 23295], [83, 23575], [89, 23915], [98, 24490], [101, 24630], [108, 25070], [111, 25190], [121, 25750], [125, 25950], [133, 26450], [136, 26710], [142, 27150], [147, 27530], [151, 27770], [160, 28817], [162, 28942], [172, 29562], [175, 29742], [183, 30762], [186, 31042], [189, 31182], [197, 31742], [203, 32002], [206, 32202]]}, {"verse": 4, "start": 33253, "end": 39681, "text": "Y hubo algunos que se enojaron dentro de sí, y dijeron: ¿Para qué se ha hecho este desperdicio de perfume?", "words": [[0, 33253], [2, 33534], [7, 33834], [15, 34194], [19, 34434], [22, 34594], [31, 35194], [38, 35494], [41, 35794], [45, 36034], [47, 36274], [56, 37236], [62, 37398], [66, 37578], [69, 37758], [72, 37878], [78, 38058], [83, 38298], [95, 38898], [98, 39018]]}, {"verse": 5, "start": 40031, "end": 46820, "text": "Porque podía esto ser vendido por más de trescientos denarios, y darse a los pobres. Y murmuraban contra ella.", "words": [[0, 40031], [7, 40196], [13, 40576], [18, 40856], [22, 41096], [30, 41556], [34, 41776], [38, 41936], [41, 42206], [53, 42476], [63, 43236], [65, 43461], [71, 43821], [73, 43881], [77, 44001], [85, 44887], [87, 45012], [98, 45792], [105, 46252]]}, {"verse": 6, "start": 47170, "end": 53481, "text": "Pero Jesús dijo: Dejadla; ¿por qué la molestáis? Ha hecho una buena obra conmigo;", "words": [[0, 47170], [5, 47320], [11, 47660], [17, 48707], [26, 49703], [31, 49828], [35, 49968], [38, 50088], [49, 51398], [52, 51659], [58, 51859], [62, 52039], [68, 52279], [73, 52599]]}, {"verse": 7, "start": 53831, "end": 62144, "text": "Que siempre tendréis los pobres con vosotros, y cuando queráis les podréis hacer bien; pero a mí no siempre me tendréis.", "words": [[0, 53831], [4, 53913], [12, 54333], [21, 55073], [25, 55233], [32, 55773], [36, 56033], [46, 56633], [48, 57093], [55, 57313], [63, 57933], [67, 58273], [75, 58993], [81, 59313], [87, 60161], [92, 60304], [94, 60444], [97, 60584], [100, 60724], [108, 61004], [111, 61304]]}, {"verse": 8, "start": 62494, "end": 69103, "text": "Esta ha hecho lo que podía; porque se ha anticipado a ungir mi cuerpo para la sepultura.", "words": [[0, 62494], [5, 62830], [8, 63170], [14, 63490], [17, 63670], [21, 63810], [28, 64750], [35, 64954], [38, 65194], [41, 65354], [52, 66534], [54, 66824], [60, 67114], [63, 67334], [70, 67674], [75, 67994], [78, 68154]]}, {"verse": 9, "start": 69453, "end": 80350, "text": "De cierto os digo que dondequiera que se predique este evangelio en todo el mundo, también se contará, en memoria de esta mujer, lo que ella ha hecho.", "words": [[0, 69453], [3, 69659], [10, 70059], [13, 70459], [18, 70859], [22, 71519], [34, 72179], [38, 72379], [41, 72539], [50, 73159], [55, 73539], [65, 74279], [68, 74399], [73, 74659], [76, 74879], [83, 75599], [91, 75859], [94, 76179], [103, 76759], [106, 77279], [114, 77779], [117, 77999], [122, 78219], [129, 78619], [132, 79059], [136, 79199], [141, 79479], [144, 79799]]}, {"verse": 10, "start": 80700, "end": 88627, "text": "Entonces Judas Iscariote, uno de los doce, vino a los príncipes de los sacerdotes, para entregársele.", "words": [[0, 80700], [9, 81702], [15, 82142], [26, 83122], [30, 83362], [33, 83502], [37, 83642], [43, 84462], [48, 84702], [50, 84862], [54, 84982], [64, 85702], [67, 85822], [71, 85942], [83, 86702], [88, 87698]]}, {"verse": 11, "start": 88977, "end": 97291, "text": "Y ellos al oírlo se alegraron, y prometieron que le darían dinero. Y buscaba oportunidad cómo le entregaría.", "words": [[0, 88977], [2, 89143], [8, 89483], [11, 89643], [17, 90423], [20, 90543], [31, 91263], [33, 91623], [45, 92283], [49, 92463], [52, 92583], [59, 93023], [67, 94003], [69, 94129], [77, 94629], [89, 95509], [94, 96089], [97, 96269]]}, {"verse": 12, "start": 97641, "end": 110195, "text": "Y el primer día de los panes sin levadura, cuando sacrificaban el cordero pascual, sus discípulos le dicen: ¿Dónde quieres que vayamos a preparar para que comas la pascua?", "words": [[0, 97641], [2, 97774], [5, 97894], [12, 98314], [16, 98694], [19, 98874], [23, 99014], [29, 99574], [33, 99974], [43, 101214], [50, 101594], [63, 102574], [66, 102694], [74, 103584], [83, 104474], [87, 104674], [98, 105634], [101, 106034], [108, 106854], [115, 107131], [123, 107471], [127, 107691], [135, 108111], [137, 108251], [146, 108771], [151, 108951], [155, 109131], [161, 109491], [164, 109591]]}, {"verse": 13, "start": 110475, "end": 120333, "text": "Y envía dos de sus discípulos, y les dice: Id a la ciudad, y os encontrará un hombre que lleva un cántaro de agua; seguidle;", "words": [[0, 110475], [2, 110617], [8, 111058], [12, 111598], [15, 112078], [19, 112298], [31, 113058], [33, 113338], [37, 113518], [43, 114324], [46, 114418], [48, 114511], [51, 114651], [59, 115531], [61, 115811], [64, 115931], [75, 116691], [78, 116871], [85, 117171], [89, 117371], [95, 117631], [98, 117871], [106, 118491], [109, 118731], [115, 119538]]}, {"verse": 14, "start": 120683, "end": 129721, "text": "Y donde entre, decid al señor de la casa: El Maestro dice: ¿Dónde está el aposento donde he de comer la pascua con mis discípulos?", "words": [[0, 120683], [2, 120940], [8, 121180], [15, 122120], [21, 122580], [24, 122800], [30, 123099], [33, 123340], [36, 123459], [42, 124230], [45, 124368], [53, 124888], [59, 125764], [66, 126090], [71, 126330], [74, 126470], [83, 127010], [89, 127250], [92, 127470], [95, 127590], [101, 127830], [104, 128160], [111, 128490], [115, 128610], [119, 128810]]}, {"verse": 15, "start": 130071, "end": 136891, "text": "Y él os mostrará una gran habitación superior ya preparada: preparad para nosotros allí.", "words": [[0, 130071], [2, 130218], [5, 130378], [8, 130598], [17, 131458], [21, 131618], [26, 131878], [37, 132478], [46, 132958], [49, 133358], [60, 134816], [69, 135444], [74, 135784], [83, 136164]]}, {"verse": 16, "start": 137241, "end": 144185, "text": "Y fueron sus discípulos, y vinieron a la ciudad, y hallaron como les había dicho; y prepararon la pascua.", "words": [[0, 137241], [2, 137362], [9, 137602], [13, 137942], [25, 138702], [27, 138882], [36, 139282], [38, 139442], [41, 139522], [49, 139882], [51, 140202], [60, 140682], [65, 140962], [69, 141162], [75, 141482], [82, 142314], [84, 142423], [95, 143103], [98, 143343]]}, {"verse": 17, "start": 144535, "end": 146874, "text": "Y llegada la tarde, fue con los doce.", "words": [[0, 144535], [2, 144644], [10, 145024], [13, 145184], [20, 145504], [24, 145844], [28, 146064], [32, 146499]]}, {"verse": 18, "start": 147224, "end": 156030, "text": "Y como se sentaron a la mesa y comiesen, dice Jesús: De cierto os digo que uno de vosotros, que come conmigo, me ha de entregar.", "words": [[0, 147224], [2, 147348], [7, 147648], [10, 147868], [19, 148468], [21, 148608], [24, 148688], [29, 148968], [31, 149128], [41, 149988], [46, 150308], [53, 151248], [56, 151392], [63, 151732], [66, 152112], [71, 152432], [75, 152652], [79, 152852], [82, 153012], [92, 153532], [96, 153952], [101, 154212], [110, 154892], [113, 155212], [116, 155292], [119, 155412]]}, {"verse": 19, "start": 156380, "end": 165035, "text": "Entonces ellos comenzaron a entristecerse, y a decirle cada uno por sí: ¿ Seré yo? Y el otro: ¿ Seré yo?", "words": [[0, 156380], [9, 156943], [15, 157423], [26, 158243], [28, 158383], [43, 159463], [45, 160083], [47, 160183], [55, 160763], [60, 161023], [64, 161443], [68, 161743], [72, 162382], [74, 162382], [79, 162724], [83, 163337], [85, 163518], [88, 163638], [94, 164360], [96, 164360], [101, 164702]]}, {"verse": 20, "start": 165315, "end": 170948, "text": "Y él respondiendo les dijo: Es uno de los doce que moja conmigo en el plato.", "words": [[0, 165315], [2, 165510], [5, 165650], [18, 166410], [22, 166590], [28, 167286], [31, 167626], [35, 168006], [38, 168206], [42, 168366], [47, 168826], [51, 169026], [56, 169486], [64, 170106], [67, 170226], [70, 170366]]}, {"verse": 21, "start": 171298, "end": 183572, "text": "A la verdad el Hijo del hombre va, como está de él escrito; pero ¡ay de aquel hombre por quien el Hijo del hombre es entregado! bueno le fuera a aquel hombre si nunca hubiera nacido.", "words": [[0, 171298], [2, 171518], [5, 171618], [12, 171958], [15, 172378], [20, 172658], [24, 172798], [31, 173118], [35, 173678], [40, 173958], [45, 174198], [48, 174378], [51, 174538], [60, 175429], [65, 175748], [69, 176100], [72, 176260], [78, 176540], [85, 176800], [89, 177140], [95, 177480], [98, 177960], [103, 178280], [107, 178440], [114, 178780], [117, 179060], [128, 180163], [134, 180490], [137, 180570], [143, 180770], [145, 181130], [151, 181450], [158, 181710], [161, 181970], [167, 182390], [175, 182950]]}, {"verse": 22, "start": 183922, "end": 193080, "text": "Y estando ellos comiendo, tomó Jesús pan, y bendiciendo, partió y les dio, y dijo: Tomad, esto es mi cuerpo.", "words": [[0, 183922], [2, 184059], [10, 184619], [16, 184859], [26, 185799], [31, 186239], [37, 186479], [42, 186999], [44, 187539], [57, 188939], [64, 189639], [66, 189899], [70, 190079], [75, 190419], [77, 190654], [83, 191687], [90, 192067], [95, 192247], [98, 192387], [101, 192487]]}, {"verse": 23, "start": 193430, "end": 199642, "text": "Y tomando la copa, habiendo dado gracias, les dio: y todos bebieron de ella.", "words": [[0, 193430], [2, 193529], [10, 193969], [13, 194149], [19, 195029], [28, 195569], [33, 195809], [42, 196349], [46, 196969], [51, 197619], [53, 197799], [59, 198119], [68, 198919], [71, 199179]]}, {"verse": 24, "start": 199992, "end": 205719, "text": "Y les dice: Esto es mi sangre del nuevo pacto, que por muchos es derramada.", "words": [[0, 199992], [2, 200102], [6, 200202], [12, 201320], [17, 201470], [20, 201650], [23, 201770], [30, 202170], [34, 202450], [40, 202690], [47, 203530], [51, 203750], [55, 203970], [62, 204370], [65, 204670]]}, {"verse": 25, "start": 206069, "end": 214064, "text": "De cierto os digo que no beberé más del fruto de la vid, hasta aquel día cuando lo beba nuevo en el reino de Dios.", "words": [[0, 206254], [3, 206474], [10, 206694], [13, 206894], [18, 207174], [22, 207414], [25, 207674], [32, 208174], [36, 208374], [40, 208614], [46, 209094], [49, 209254], [52, 209424], [57, 209594], [63, 210074], [69, 210554], [73, 210794], [80, 211054], [83, 211354], [88, 211634], [94, 212054], [97, 212434], [100, 212614], [106, 213234], [109, 213414]]}, {"verse": 26, "start": 214414, "end": 218600, "text": "Y después de cantar el himno, salieron al monte de los Olivos.", "words": [[0, 214414], [2, 214542], [10, 214842], [13, 215042], [20, 215522], [23, 215642], [30, 216022], [39, 216842], [42, 217182], [48, 217502], [51, 217742], [55, 217882]]}, {"verse": 27, "start": 218950, "end": 228749, "text": "Jesús entonces les dice: Todos me abandonaréis esta noche; porque escrito está: Heriré al pastor, y serán dispersadas las ovejas.", "words": [[0, 218950], [6, 219296], [15, 219876], [19, 220316], [25, 221140], [31, 221521], [34, 221981], [47, 222761], [52, 223021], [59, 223798], [66, 224085], [74, 224605], [80, 225608], [87, 225838], [90, 225958], [98, 226358], [100, 226878], [106, 227218], [118, 227958], [122, 228158]]}, {"verse": 28, "start": 229099, "end": 233534, "text": "Pero después que haya resucitado, iré delante de vosotros a Galilea.", "words": [[0, 229099], [5, 229245], [13, 229585], [17, 229765], [22, 229965], [34, 230905], [38, 231345], [46, 231965], [49, 232125], [58, 232605], [60, 232845]]}, {"verse": 29, "start": 233884, "end": 237934, "text": "Entonces Pedro le dijo: Aunque todos te abandonen, yo no.", "words": [[0, 233884], [9, 234410], [15, 234950], [18, 235230], [24, 235953], [31, 236169], [37, 236489], [40, 236689], [51, 237589], [54, 237689]]}, {"verse": 30, "start": 238214, "end": 247333, "text": "Y le dice Jesús: De cierto te digo que tú, hoy, en esta noche, antes que el gallo haya cantado dos veces, me negarás tres veces.", "words": [[0, 238214], [2, 238335], [5, 238475], [10, 238795], [17, 239854], [20, 240043], [27, 240363], [30, 240783], [35, 241143], [39, 241363], [43, 241623], [48, 242143], [51, 242343], [56, 242583], [63, 243163], [69, 243463], [73, 243663], [76, 243803], [82, 244143], [87, 244303], [95, 244903], [99, 245103], [106, 245863], [109, 245983], [117, 246443], [122, 246683]]}, {"verse": 31, "start": 247333, "end": 255583, "text": "Pero él con mayor insistencia decía: Si me es necesario morir contigo, no te negaré. También todos decían lo mismo.", "words": [[0, 247333], [5, 247573], [8, 247753], [12, 247973], [18, 248253], [30, 249173], [37, 250076], [40, 250237], [43, 250397], [46, 250537], [56, 251037], [62, 251477], [71, 252517], [74, 252697], [77, 252857], [85, 253648], [93, 253973], [99, 254313], [106, 254913], [109, 255053]]}, {"verse": 32, "start": 255933, "end": 264272, "text": "Y vienen al lugar que se llama Getsemaní, y dice a sus discípulos: Sentaos aquí, entre tanto que yo oro.", "words": [[0, 255933], [2, 256035], [9, 256315], [12, 256655], [18, 257035], [22, 257235], [25, 257415], [31, 258145], [42, 258875], [44, 259295], [49, 259655], [51, 259955], [55, 260175], [67, 261609], [75, 261889], [81, 262709], [87, 262949], [93, 263369], [97, 263569], [100, 263769]]}, {"verse": 33, "start": 264622, "end": 271582, "text": "Y toma consigo a Pedro y a Jacobo y a Juan, y comenzó a sentir temor y profunda angustia.", "words": [[0, 264622], [2, 264744], [7, 265024], [15, 265624], [17, 265924], [23, 266344], [25, 266584], [27, 266664], [34, 267304], [36, 267504], [38, 267564], [44, 267904], [46, 268369], [54, 268949], [56, 269009], [63, 269349], [69, 269909], [71, 270029], [80, 270629]]}, {"verse": 34, "start": 271932, "end": 277530, "text": "Y les dice: Está muy triste mi alma, hasta la muerte: quedaos aquí y velad.", "words": [[0, 271932], [2, 272039], [6, 272139], [12, 273009], [17, 273119], [21, 273339], [28, 273799], [31, 274019], [37, 274699], [43, 274939], [46, 275079], [54, 275966], [62, 276350], [67, 276650], [69, 277010]]}, {"verse": 35, "start": 277880, "end": 285735, "text": "Y yéndose un poco adelante, se postró en tierra, y oró que si fuese posible, pasase de él aquella hora.", "words": [[0, 278057], [2, 278271], [10, 278484], [13, 278644], [18, 278904], [28, 279984], [31, 280064], [38, 280624], [41, 280804], [49, 281264], [51, 281804], [55, 282144], [59, 282324], [62, 282424], [68, 282724], [77, 283824], [84, 284324], [87, 284544], [90, 284784], [98, 285224]]}, {"verse": 36, "start": 286085, "end": 293177, "text": "Y decía: Abba, Padre, todo te es posible; aparta de mí esta copa; pero no lo que yo quiero, sino lo que tú quieres.", "words": [[0, 286085], [2, 286211], [9, 287178], [15, 287328], [22, 287848], [27, 287988], [30, 288208], [33, 288308], [42, 289340], [49, 289640], [52, 289739], [55, 290064], [60, 290388], [66, 290873], [71, 291017], [74, 291217], [77, 291357], [81, 291497], [84, 291657], [92, 292017], [97, 292297], [100, 292497], [104, 292637], [107, 292817]]}, {"verse": 37, "start": 293177, "end": 301112, "text": "Y vino y los halló durmiendo; y dice a Pedro: ¿Simón, duermes? ¿No has podido velar una hora?", "words": [[0, 293277], [2, 293752], [7, 294387], [9, 294527], [13, 294707], [19, 295027], [30, 296109], [32, 296442], [37, 296702], [39, 296882], [46, 297694], [54, 298111], [63, 299072], [67, 299394], [71, 299534], [78, 299974], [84, 300374], [88, 300514]]}, {"verse": 38, "start": 301462, "end": 308383, "text": "Velad y orad, para que no entréis en tentación: el espíritu está dispuesto, pero la carne es débil.", "words": [[0, 301462], [6, 302027], [8, 302227], [14, 302567], [19, 302887], [23, 303047], [26, 303247], [34, 303747], [37, 303907], [48, 305017], [51, 305143], [60, 305663], [65, 305823], [76, 306703], [81, 306843], [84, 307003], [90, 307363], [93, 307843]]}, {"verse": 39, "start": 308733, "end": 312469, "text": "Y volviéndose a ir, oró, y dijo las mismas palabras.", "words": [[0, 308733], [2, 308856], [14, 309476], [16, 309636], [20, 309816], [25, 310416], [27, 310751], [32, 311051], [36, 311211], [43, 311611]]}, {"verse": 40, "start": 312819, "end": 320592, "text": "Y vuelto, los halló otra vez durmiendo, porque los ojos de ellos estaban cargados; y no sabían qué responderle.", "words": [[0, 312819], [2, 312955], [10, 313415], [14, 313575], [20, 314055], [25, 314335], [29, 314615], [40, 315495], [47, 315790], [51, 316010], [56, 316350], [59, 316550], [65, 316730], [73, 317150], [83, 318559], [85, 318664], [88, 318804], [95, 319244], [99, 319504]]}, {"verse": 41, "start": 320942, "end": 331313, "text": "Y vino la tercera vez, y les dice: Dormid ya y descansad: basta, la hora es venida; he aquí, el Hijo del hombre es entregado en manos de los pecadores.", "words": [[0, 320942], [2, 321060], [7, 321260], [10, 321440], [18, 321980], [23, 322160], [25, 322380], [29, 322540], [35, 323352], [42, 323931], [45, 324271], [47, 324944], [58, 325806], [65, 326309], [68, 326389], [73, 326569], [76, 326709], [84, 327547], [87, 327637], [93, 327917], [96, 328337], [101, 328597], [105, 328717], [112, 329097], [115, 329317], [125, 329977], [128, 330077], [134, 330337], [137, 330517], [141, 330617]]}, {"verse": 42, "start": 331663, "end": 335858, "text": "Levantaos, vamos: he aquí, el que me entrega está cerca.", "words": [[0, 331663], [11, 332563], [18, 333403], [21, 333483], [27, 333803], [30, 334243], [34, 334383], [37, 334523], [45, 335023], [50, 335163]]}, {"verse": 43, "start": 336208, "end": 350070, "text": "Y luego, aun hablando él, vino Judas, que era uno de los doce, y con él una multitud con espadas y palos, de parte de los principales sacerdotes, y de los escribas y de los ancianos.", "words": [[0, 336208], [2, 336351], [9, 336851], [13, 337011], [22, 337391], [26, 338191], [31, 338351], [38, 339351], [42, 339431], [46, 339611], [50, 339851], [53, 340011], [57, 340171], [63, 341091], [65, 341191], [69, 341391], [72, 341571], [76, 341891], [85, 342631], [89, 342891], [97, 343351], [99, 343551], [106, 344091], [109, 344411], [115, 344651], [118, 344911], [122, 345011], [134, 345791], [146, 347155], [148, 347276], [151, 347376], [155, 347536], [164, 348296], [166, 348796], [169, 348916], [173, 349076]]}, {"verse": 44, "start": 350420, "end": 358864, "text": "Y el que le entregaba les había dado una señal acordada, diciendo: Al que yo bese, aquel es: prendedle, y llevadle con seguridad.", "words": [[0, 350420], [2, 350547], [5, 350687], [9, 350827], [12, 350987], [22, 351647], [26, 351827], [32, 352147], [37, 352407], [41, 352627], [47, 353087], [57, 353707], [67, 354729], [70, 354849], [74, 354949], [77, 355229], [83, 355509], [89, 355969], [93, 356893], [104, 357193], [106, 357623], [115, 358053], [119, 358193]]}, {"verse": 45, "start": 359144, "end": 365935, "text": "Y cuando vino, se acercó luego a él, y le dice: Maestro, Maestro. Y le besó.", "words": [[0, 359144], [2, 359246], [9, 359466], [15, 359926], [18, 360281], [25, 360941], [31, 361281], [33, 361661], [37, 361981], [39, 362681], [42, 362821], [48, 363554], [57, 364154], [66, 365224], [68, 365388], [71, 365468]]}, {"verse": 46, "start": 366285, "end": 370077, "text": "Entonces ellos echaron en él sus manos, y le prendieron.", "words": [[0, 366285], [9, 366822], [15, 367362], [23, 368042], [26, 368222], [29, 368402], [33, 368542], [40, 368922], [42, 369162], [45, 369282]]}, {"verse": 47, "start": 370427, "end": 377609, "text": "Y uno de los que estaban allí, sacando la espada, hirió al siervo del sumo sacerdote, y le cortó la oreja.", "words": [[0, 370427], [2, 370568], [6, 370748], [9, 370888], [13, 371008], [17, 371148], [25, 371448], [31, 372048], [39, 372528], [42, 372688], [50, 373278], [56, 373868], [59, 374238], [66, 374608], [70, 374748], [75, 375188], [86, 375848], [88, 376248], [91, 376368], [97, 376828], [100, 376948]]}, {"verse": 48, "start": 377959, "end": 385131, "text": "Y respondiendo Jesús, les dijo: ¿Cómo contra un bandido habéis salido con espadas y con palos a tomarme?", "words": [[0, 377959], [2, 378084], [15, 378844], [22, 379204], [26, 379584], [32, 380333], [38, 380752], [45, 381192], [48, 381372], [56, 381932], [63, 382312], [70, 382732], [74, 382972], [82, 383492], [84, 383692], [88, 383892], [94, 384332], [96, 384452]]}, {"verse": 49, "start": 385481, "end": 393863, "text": "Cada día estaba con vosotros enseñando en el templo, y no me tomasteis; pero es así, para que se cumplan las Escrituras.", "words": [[0, 385481], [5, 385756], [9, 386096], [16, 386476], [20, 386776], [29, 387276], [39, 388116], [42, 388236], [45, 388376], [53, 389176], [55, 389316], [58, 389476], [61, 389616], [72, 390761], [77, 390922], [80, 391122], [85, 391422], [90, 391722], [94, 391882], [97, 392062], [105, 392642], [109, 392842]]}, {"verse": 50, "start": 394213, "end": 398115, "text": "Entonces dejándole todos sus discípulos, huyeron.", "words": [[0, 394213], [9, 395198], [19, 395938], [25, 396198], [29, 396518], [41, 397318]]}, {"verse": 51, "start": 398465, "end": 405670, "text": "Pero un joven le seguía cubierto de una sábana sobre el cuerpo desnudo; y los jóvenes le prendieron:", "words": [[0, 398465], [5, 398591], [8, 398731], [14, 399151], [17, 399311], [24, 399751], [33, 400311], [36, 400491], [40, 400631], [47, 401211], [53, 401771], [56, 402051], [63, 402451], [72, 403597], [74, 403705], [78, 403825], [86, 404325], [89, 404805]]}, {"verse": 52, "start": 406020, "end": 409870, "text": "Pero él, dejando la sábana, se huyó de ellos desnudo.", "words": [[0, 406020], [5, 406167], [9, 406567], [17, 406907], [20, 407087], [28, 408067], [31, 408227], [36, 408567], [39, 408727], [45, 408987]]}, {"verse": 53, "start": 410220, "end": 419587, "text": "Y trajeron a Jesús al sumo sacerdote; y se juntaron a él todos los principales sacerdotes y los ancianos y los escribas.", "words": [[0, 410220], [2, 410318], [11, 410918], [13, 410978], [19, 411318], [22, 411678], [27, 412178], [38, 413316], [40, 413576], [43, 413696], [52, 414416], [54, 414556], [57, 414736], [63, 415356], [67, 415716], [79, 416496], [90, 417356], [92, 417556], [96, 417736], [105, 418416], [107, 418576], [111, 418736]]}, {"verse": 54, "start": 419937, "end": 429867, "text": "Pero Pedro le siguió de lejos hasta dentro del patio del sumo sacerdote; y estaba sentado con los servidores, y calentándose al fuego.", "words": [[0, 419937], [5, 420102], [11, 420642], [14, 420922], [21, 421362], [24, 421462], [30, 422042], [36, 422502], [43, 422922], [47, 423222], [53, 423722], [57, 424162], [62, 424742], [73, 425864], [75, 425952], [82, 426272], [90, 426852], [94, 427032], [98, 427192], [110, 427792], [112, 428272], [125, 429132], [128, 429272]]}, {"verse": 55, "start": 430217, "end": 439065, "text": "Y los principales sacerdotes y todo el Consejo buscaban testimonio contra Jesús, para entregarle a la muerte; pero no lo hallaban.", "words": [[0, 430217], [2, 430315], [6, 430435], [18, 431255], [29, 431995], [31, 432195], [36, 432515], [39, 432715], [47, 433295], [56, 433795], [67, 434535], [74, 434855], [81, 435275], [86, 435970], [97, 436670], [99, 436750], [102, 436850], [110, 437788], [115, 437858], [118, 437978], [121, 438548]]}, {"verse": 56, "start": 439415, "end": 445477, "text": "Porque muchos decían falso testimonio contra él; pero sus testimonios no coincidían.", "words": [[0, 439415], [7, 439755], [14, 440035], [21, 440595], [27, 441095], [38, 441855], [45, 442175], [49, 442894], [54, 443294], [58, 443494], [70, 444194], [73, 444354]]}, {"verse": 57, "start": 445827, "end": 451865, "text": "Entonces levantándose unos, dieron falso testimonio contra él, diciendo:", "words": [[0, 445827], [9, 446751], [22, 447491], [28, 447871], [35, 448491], [41, 449051], [52, 449891], [59, 450231], [63, 450871]]}, {"verse": 58, "start": 452065, "end": 460335, "text": "Nosotros le hemos oído decir: Yo derribaré este templo hecho por manos humanas, y en tres días edificaré otro no hecho por manos humanas.", "words": [[0, 452065], [9, 452471], [12, 452651], [18, 452831], [23, 453191], [30, 453936], [33, 454035], [43, 454515], [48, 454755], [55, 455255], [61, 455455], [65, 455655], [71, 455895], [80, 456735], [82, 456875], [85, 457015], [90, 457255], [95, 457535], [105, 458335], [110, 458715], [113, 458955], [119, 459195], [123, 459395], [129, 459635]]}, {"verse": 59, "start": 460615, "end": 464422, "text": "Pero ni aun así coincidía el testimonio de ellos.", "words": [[0, 460615], [5, 460920], [8, 461260], [12, 461460], [16, 461820], [26, 462660], [29, 462820], [40, 463580], [43, 463720]]}, {"verse": 60, "start": 464772, "end": 474966, "text": "Entonces el sumo sacerdote, levantándose en medio, preguntó a Jesús, diciendo: ¿No respondes algo? ¿Qué atestiguan estos contra ti?", "words": [[0, 464772], [9, 465738], [12, 466261], [17, 466681], [28, 467501], [41, 468441], [44, 468641], [51, 469341], [60, 469821], [62, 469841], [69, 470141], [79, 471341], [83, 471561], [93, 472281], [99, 473049], [104, 473166], [115, 473866], [121, 474106], [128, 474566]]}, {"verse": 61, "start": 475246, "end": 483238, "text": "Pero él callaba, y nada respondía. El sumo sacerdote le volvió a preguntar, y le dice: ¿Eres tú el Cristo, el Hijo del Bendito?", "words": [[0, 475246], [5, 475408], [8, 475568], [17, 476068], [19, 476228], [24, 476408], [35, 477565], [38, 477691], [43, 478111], [53, 478691], [56, 478851], [63, 479231], [65, 479251], [76, 479831], [78, 479911], [81, 480011], [87, 480725], [93, 480965], [96, 481225], [99, 481385], [107, 482145], [110, 482225], [115, 482425], [119, 482860]]}, {"verse": 62, "start": 483518, "end": 493220, "text": "Y Jesús le dijo: Yo soy; y veréis al Hijo del hombre sentado a la derecha del poder de Dios, y viniendo en las nubes del cielo.", "words": [[0, 483518], [2, 483641], [8, 484021], [11, 484421], [17, 485168], [20, 485416], [25, 486275], [27, 486414], [34, 486854], [37, 487174], [42, 487494], [46, 487694], [53, 488154], [61, 488834], [63, 488974], [66, 489054], [74, 489494], [78, 489654], [84, 490034], [87, 490294], [93, 490634], [95, 491094], [104, 491654], [107, 491774], [111, 491914], [117, 492374], [121, 492534]]}, {"verse": 63, "start": 493570, "end": 500801, "text": "Entonces el sumo sacerdote, rasgando sus vestidos, dijo: ¿Qué más tenemos necesidad de testigos?", "words": [[0, 493570], [9, 494155], [12, 494455], [17, 494915], [28, 496035], [37, 496655], [41, 496915], [51, 497955], [57, 498619], [62, 498720], [66, 498960], [74, 499320], [84, 499960], [87, 500080]]}, {"verse": 64, "start": 501151, "end": 507650, "text": "Oído habéis la blasfemia: ¿qué os parece? Y ellos todos lo condenaron como merecedor de muerte.", "words": [[0, 501308], [5, 501503], [12, 501698], [15, 501893], [26, 502802], [31, 502902], [34, 503022], [42, 503822], [44, 503969], [50, 504229], [56, 504629], [59, 505009], [70, 505729], [75, 506029], [85, 506789], [88, 506929]]}, {"verse": 65, "start": 508000, "end": 518496, "text": "Y algunos comenzaron a escupir en él, y cubrir su rostro, y a darle bofetadas, y decirle: Profetiza. Y los servidores le herían de bofetadas.", "words": [[0, 508000], [2, 508087], [10, 508387], [21, 509067], [23, 509167], [31, 509647], [34, 509767], [38, 509987], [40, 510807], [47, 511227], [50, 511447], [58, 512007], [60, 512127], [62, 512317], [68, 512507], [79, 513187], [81, 513627], [90, 514520], [101, 515534], [103, 515640], [107, 515780], [118, 516460], [121, 516940], [128, 517340], [131, 517500]]}, {"verse": 66, "start": 518846, "end": 524595, "text": "Y estando Pedro abajo en el patio, vino una de las criadas del sumo sacerdote;", "words": [[0, 518846], [2, 519166], [10, 519486], [16, 519806], [22, 520146], [25, 520346], [28, 520466], [35, 521526], [40, 521886], [44, 522286], [47, 522426], [51, 522586], [59, 523066], [63, 523266], [68, 523706]]}, {"verse": 67, "start": 524945, "end": 531344, "text": "Y cuando vio a Pedro que se calentaba, mirándole, dice: Y tú con Jesús el nazareno estabas.", "words": [[0, 524945], [2, 525287], [9, 525507], [13, 525847], [15, 525927], [21, 526167], [25, 526387], [28, 526507], [39, 527347], [50, 527887], [56, 528704], [58, 528831], [61, 529071], [65, 529371], [71, 529771], [74, 530131], [83, 530671]]}, {"verse": 68, "start": 531624, "end": 538873, "text": "Pero él negó, diciendo: No conozco, ni sé lo que dices. Y se salió fuera a la entrada; y cantó el gallo.", "words": [[0, 531624], [5, 531792], [8, 532132], [14, 532692], [24, 533624], [27, 533750], [36, 534290], [39, 534430], [42, 534630], [45, 534750], [49, 534870], [56, 535530], [58, 535634], [61, 535754], [67, 536174], [73, 536294], [75, 536414], [78, 536754], [87, 537681], [89, 537828], [95, 538118], [98, 538408]]}, {"verse": 69, "start": 539223, "end": 545000, "text": "Y la criada viéndole otra vez, comenzó a decir a los que estaban allí: Este es de ellos.", "words": [[0, 539223], [2, 539403], [5, 539523], [12, 539983], [21, 540503], [26, 540723], [31, 541023], [39, 541703], [41, 541783], [47, 542163], [49, 542423], [53, 542543], [57, 542663], [65, 542963], [71, 543710], [76, 544035], [79, 544295], [82, 544495]]}, {"verse": 70, "start": 545280, "end": 558554, "text": "Pero él negó otra vez. Y poco después, los que estaban allí dijeron otra vez a Pedro: Verdaderamente tú eres de ellos; porque eres galileo, y tu manera de hablar es semejante a la de ellos.", "words": [[0, 545280], [5, 545443], [8, 545783], [13, 546243], [18, 546583], [23, 547392], [25, 547673], [30, 548013], [39, 548653], [43, 549073], [47, 549213], [55, 549533], [60, 549873], [68, 550753], [73, 550993], [77, 551293], [79, 551433], [86, 552160], [101, 552963], [104, 553243], [109, 553463], [112, 553643], [119, 554449], [126, 554686], [131, 554946], [140, 555646], [142, 556006], [145, 556126], [152, 556366], [155, 556586], [162, 556866], [165, 557186], [175, 557706], [177, 557806], [180, 557866], [183, 558006]]}, {"verse": 71, "start": 558834, "end": 563710, "text": "Y él comenzó a maldecir y a jurar: No conozco a este hombre de quien habláis.", "words": [[0, 558834], [2, 559000], [5, 559120], [13, 559740], [15, 559840], [24, 560460], [26, 560660], [28, 560740], [35, 561542], [38, 561688], [46, 562168], [48, 562248], [53, 562408], [60, 562688], [63, 562888], [69, 563048]]}, {"verse": 72, "start": 563990, "end": 577083, "text": "Y el gallo cantó la segunda vez: y Pedro se acordó de las palabras que Jesús le había dicho: Antes que el gallo cante dos veces, me negarás tres veces. Y pensando en esto, lloraba.", "words": [[0, 563990], [2, 564094], [5, 564234], [11, 564574], [17, 565014], [20, 565134], [28, 565494], [33, 566320], [35, 566465], [41, 566905], [44, 567385], [51, 567925], [54, 568005], [58, 568145], [67, 568545], [71, 568785], [77, 569105], [80, 569465], [86, 569665], [93, 570427], [99, 570751], [103, 570931], [106, 571051], [112, 571391], [118, 571751], [122, 571891], [129, 572571], [132, 572751], [140, 573171], [145, 573371], [152, 574343], [154, 574466], [163, 574886], [166, 575146], [172, 576166]]}]}