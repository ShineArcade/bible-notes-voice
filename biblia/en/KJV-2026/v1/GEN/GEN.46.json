{"book": "GEN", "chapter": 46, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 276690, "verses": [{"verse": 1, "start": 300, "end": 8477, "text": "And Israel took his journey with all that he had, and came to Beer-sheba, and offered sacrifices to the God of his father Isaac.", "words": [[0, 300], [4, 442], [11, 842], [16, 1182], [20, 1422], [28, 1822], [33, 2042], [37, 2302], [42, 2502], [45, 2622], [50, 3362], [54, 3582], [59, 3842], [62, 4042], [74, 5262], [78, 5362], [86, 5702], [97, 6362], [100, 6782], [104, 6902], [108, 7142], [111, 7302], [115, 7462], [122, 7822]]}, {"verse": 2, "start": 8927, "end": 16531, "text": "And God spoke to Israel in the visions of the night, and said, Jacob, Jacob. And he said, Here am I.", "words": [[0, 8927], [4, 9057], [8, 9317], [14, 9657], [17, 9877], [24, 10297], [27, 10517], [31, 10617], [39, 10917], [42, 11177], [46, 11277], [53, 11537], [57, 11797], [63, 12513], [70, 12734], [77, 13890], [81, 14025], [84, 14165], [90, 15623], [95, 15831], [98, 16111]]}, {"verse": 3, "start": 16881, "end": 26388, "text": "And he said, I am God, the God of your father: fear not to go down into Egypt; for I will there make of you a great nation:", "words": [[0, 16881], [4, 17016], [7, 17156], [13, 18615], [15, 18818], [18, 18958], [23, 19718], [27, 19818], [31, 20078], [34, 20218], [39, 20358], [47, 21542], [52, 21644], [56, 21864], [59, 22064], [62, 22224], [67, 22484], [72, 22724], [79, 23878], [83, 24027], [85, 24127], [90, 24347], [96, 24507], [101, 24707], [104, 24887], [108, 25067], [110, 25227], [116, 25447]]}, {"verse": 4, "start": 26838, "end": 34523, "text": "I will go down with you into Egypt; and I will also surely bring you up again: and Joseph shall put his hand upon your eyes.", "words": [[0, 26838], [2, 26956], [7, 27096], [10, 27256], [15, 27476], [20, 27696], [24, 27896], [29, 28056], [36, 29205], [40, 29316], [42, 29416], [47, 29576], [52, 29876], [59, 30236], [65, 30576], [69, 30736], [72, 30916], [79, 31978], [83, 32099], [90, 32419], [96, 32639], [100, 32819], [104, 32979], [109, 33219], [114, 33479], [119, 33719]]}, {"verse": 5, "start": 34873, "end": 45030, "text": "And Jacob rose up from Beer-sheba: and the sons of Israel carried Jacob their father, and their little ones, and their wives, in the wagons which Pharaoh had sent to carry him.", "words": [[0, 34873], [4, 35006], [10, 35326], [15, 35646], [18, 35906], [23, 36517], [35, 37358], [39, 37481], [43, 37601], [48, 37841], [51, 38041], [58, 38441], [66, 38821], [72, 39201], [78, 39461], [86, 40061], [90, 40241], [96, 40361], [103, 40601], [109, 41261], [113, 41381], [119, 41521], [126, 42401], [129, 42541], [133, 42661], [140, 43101], [146, 43301], [154, 43661], [158, 43901], [163, 44101], [166, 44301], [172, 44601]]}, {"verse": 6, "start": 45480, "end": 53372, "text": "And they took their cattle, and their goods, which they had gotten in the land of Canaan, and came into Egypt, Jacob, and all his seed with him:", "words": [[0, 45480], [4, 45620], [9, 45720], [14, 45960], [20, 46180], [28, 46580], [32, 46920], [38, 47080], [45, 47580], [51, 47720], [56, 47920], [60, 48060], [67, 48380], [70, 48580], [74, 48680], [79, 48900], [82, 49000], [90, 49940], [94, 50020], [99, 50260], [104, 50480], [111, 51180], [118, 51980], [122, 52140], [126, 52320], [130, 52520], [135, 52820], [140, 53060]]}, {"verse": 7, "start": 53822, "end": 61829, "text": "His sons, and his sons’ sons with him, his daughters, and his sons’ daughters, and all his seed brought he with him into Egypt.", "words": [[0, 53822], [4, 53941], [10, 54381], [14, 54781], [18, 54941], [24, 55261], [29, 55561], [34, 55901], [39, 56461], [43, 56621], [54, 56961], [58, 57441], [62, 57581], [68, 57881], [79, 58881], [83, 59041], [87, 59341], [91, 59561], [96, 59921], [104, 60281], [107, 60501], [112, 60761], [116, 60981], [121, 61161]]}, {"verse": 8, "start": 62279, "end": 70274, "text": "¶ And these are the names of the children of Israel, which came into Egypt, Jacob and his sons: Reuben, Jacob’s firstborn.", "words": [[2, 62279], [6, 62435], [12, 62695], [16, 62875], [20, 63015], [26, 63355], [29, 63575], [33, 63695], [42, 64035], [45, 64255], [53, 65095], [59, 65275], [64, 65535], [69, 65815], [76, 66575], [82, 66935], [86, 67235], [90, 67395], [96, 68343], [104, 68950], [112, 69430]]}, {"verse": 9, "start": 70724, "end": 75574, "text": "And the sons of Reuben; Hanoch, and Phallu, and Hezron, and Carmi.", "words": [[0, 70724], [4, 70865], [8, 71005], [13, 71345], [16, 71605], [24, 72676], [32, 72936], [36, 73396], [44, 73856], [48, 74286], [56, 74716], [60, 75174]]}, {"verse": 10, "start": 76024, "end": 84727, "text": "¶ And the sons of Simeon; Jemuel, and Jamin, and Ohad, and Jachin, and Zohar, and Shaul the son of a Canaanitish woman.", "words": [[2, 76024], [6, 76167], [10, 76287], [15, 76587], [18, 76767], [26, 78101], [34, 78431], [38, 78831], [45, 79231], [49, 79471], [55, 79991], [59, 80451], [67, 80911], [71, 81331], [78, 81991], [82, 82411], [88, 82831], [92, 82931], [96, 83211], [99, 83351], [101, 83681], [113, 84011]]}, {"verse": 11, "start": 85177, "end": 88925, "text": "¶ And the sons of Levi; Gershon, Kohath, and Merari.", "words": [[2, 85177], [6, 85323], [10, 85463], [15, 85703], [18, 85903], [24, 87069], [33, 87439], [41, 88139], [45, 88566]]}, {"verse": 12, "start": 89375, "end": 100678, "text": "¶ And the sons of Judah; Er, and Onan, and Shelah, and Pharez, and Zerah: but Er and Onan died in the land of Canaan. And the sons of Pharez were Hezron and Hamul.", "words": [[2, 89375], [6, 89502], [10, 89642], [15, 89902], [18, 90102], [25, 91151], [29, 91391], [33, 91451], [39, 92031], [43, 92421], [51, 92811], [55, 93181], [63, 93551], [67, 93911], [74, 94572], [78, 94862], [81, 95152], [85, 95452], [90, 95752], [95, 96052], [98, 96312], [102, 96392], [107, 96672], [110, 96792], [118, 97783], [122, 97911], [126, 98051], [131, 98331], [134, 98701], [141, 99071], [146, 99251], [153, 99831], [157, 100294]]}, {"verse": 13, "start": 101128, "end": 107014, "text": "¶ And the sons of Issachar; Tola, and Phuvah, and Job, and Shimron.", "words": [[2, 101128], [6, 101277], [10, 101377], [15, 101777], [18, 102373], [28, 103233], [34, 104096], [38, 104586], [46, 105076], [50, 105536], [55, 105996], [59, 106156]]}, {"verse": 14, "start": 107464, "end": 112085, "text": "¶ And the sons of Zebulun; Sered, and Elon, and Jahleel.", "words": [[2, 107464], [6, 107724], [10, 107844], [15, 108144], [18, 108344], [27, 109872], [34, 110272], [38, 110552], [44, 110992], [48, 111557]]}, {"verse": 15, "start": 112535, "end": 122005, "text": "These are the sons of Leah, which she bore to Jacob in Padan-aram, with his daughter Dinah: all the souls of his sons and his daughters were thirty and three.", "words": [[0, 112535], [6, 112782], [10, 112942], [14, 113082], [19, 113402], [22, 113642], [28, 114322], [34, 114462], [38, 114702], [43, 114982], [46, 115182], [52, 115675], [55, 116169], [67, 116662], [72, 117142], [76, 117322], [85, 117602], [92, 118502], [96, 118706], [100, 118906], [106, 119206], [109, 119446], [113, 119586], [118, 119906], [122, 120166], [126, 120306], [136, 120686], [141, 120966], [148, 121306], [152, 121506]]}, {"verse": 16, "start": 122455, "end": 129299, "text": "¶ And the sons of Gad; Ziphion, and Haggi, Shuni, and Ezbon, Eri, and Arodi, and Areli.", "words": [[2, 122455], [6, 122614], [10, 122754], [15, 123014], [18, 123214], [23, 124563], [32, 125063], [36, 125473], [43, 125883], [50, 126503], [54, 126956], [61, 127410], [66, 127863], [70, 128233], [77, 128603], [81, 128951]]}, {"verse": 17, "start": 129749, "end": 140682, "text": "¶ And the sons of Asher; Jimnah, and Ishuah, and Isui, and Beriah, and Serah their sister: and the sons of Beriah; Heber, and Malchiel.", "words": [[2, 129749], [6, 130029], [10, 130149], [15, 130369], [18, 130569], [25, 131841], [33, 132261], [37, 132621], [45, 132981], [49, 133461], [55, 133941], [59, 134481], [67, 135021], [71, 135691], [77, 136361], [83, 136501], [91, 137455], [95, 137598], [99, 137698], [104, 137998], [107, 138472], [115, 139189], [122, 139632], [126, 140188]]}, {"verse": 18, "start": 141132, "end": 148447, "text": "These are the sons of Zilpah, whom Laban gave to Leah his daughter, and these she bore to Jacob, even sixteen souls.", "words": [[0, 141132], [6, 141302], [10, 141462], [14, 141582], [19, 141842], [22, 142152], [30, 142462], [35, 143002], [41, 143462], [46, 143702], [49, 143902], [54, 144162], [58, 144402], [68, 145322], [72, 145462], [78, 145642], [82, 145822], [87, 146062], [90, 146222], [97, 146622], [102, 147102], [110, 147602]]}, {"verse": 19, "start": 148897, "end": 153076, "text": "The sons of Rachel Jacob’s wife; Joseph, and Benjamin.", "words": [[0, 148897], [4, 149035], [9, 149375], [12, 149655], [19, 149955], [27, 150635], [33, 151418], [41, 151924], [45, 152384]]}, {"verse": 20, "start": 153526, "end": 162493, "text": "¶ And to Joseph in the land of Egypt were born Manasseh and Ephraim, which Asenath the daughter of Poti-pherah priest of On bore to him.", "words": [[2, 153526], [6, 153695], [9, 153815], [16, 154215], [19, 154475], [23, 154575], [28, 154815], [31, 154975], [37, 155335], [42, 155615], [47, 155935], [56, 156755], [60, 156895], [69, 157915], [75, 158465], [83, 159015], [87, 159075], [96, 159375], [99, 159985], [111, 160595], [118, 160855], [121, 161168], [124, 161482], [129, 161795], [132, 162015]]}, {"verse": 21, "start": 162943, "end": 173463, "text": "¶ And the sons of Benjamin were Belah, and Becher, and Ashbel, Gera, and Naaman, Ehi, and Rosh, Muppim, and Huppim, and Ard.", "words": [[2, 162943], [6, 163091], [10, 163191], [15, 163471], [18, 163651], [27, 164111], [32, 164861], [39, 165611], [43, 166161], [51, 166711], [55, 166751], [63, 167751], [69, 168751], [73, 169264], [81, 169778], [86, 170291], [90, 170391], [96, 171311], [104, 172011], [108, 172031], [116, 172831], [120, 172891]]}, {"verse": 22, "start": 173913, "end": 179556, "text": "These are the sons of Rachel, which were born to Jacob: all the souls were fourteen.", "words": [[0, 173913], [6, 174473], [10, 174673], [14, 174813], [19, 175113], [22, 175353], [30, 176013], [36, 176133], [41, 176313], [46, 176673], [49, 176873], [56, 177853], [60, 178044], [64, 178204], [70, 178484], [75, 178744]]}, {"verse": 23, "start": 180006, "end": 182081, "text": "¶ And the sons of Dan; Hushim.", "words": [[2, 180006], [6, 180139], [10, 180239], [15, 180519], [18, 180719], [23, 181564]]}, {"verse": 24, "start": 182531, "end": 187247, "text": "¶ And the sons of Naphtali; Jahzeel, and Guni, and Jezer, and Shillem.", "words": [[2, 182531], [6, 182660], [10, 182780], [15, 183060], [18, 183567], [28, 184735], [37, 185175], [41, 185545], [47, 185915], [51, 186215], [58, 186515], [62, 186715]]}, {"verse": 25, "start": 187697, "end": 195449, "text": "These are the sons of Bilhah, which Laban gave to Rachel his daughter, and she bore these to Jacob: all the souls were seven.", "words": [[0, 187697], [6, 187906], [10, 188106], [14, 188226], [19, 188546], [22, 188726], [30, 189506], [36, 189786], [42, 190266], [47, 190586], [50, 190766], [57, 191126], [61, 191366], [71, 192126], [75, 192246], [79, 192406], [84, 192646], [90, 192886], [93, 193126], [100, 193976], [104, 194182], [108, 194322], [114, 194642], [119, 194902]]}, {"verse": 26, "start": 195899, "end": 204371, "text": "All the souls that came with Jacob into Egypt, which came out of his loins, besides Jacob’s sons’ wives, all the souls were threescore and six;", "words": [[0, 195899], [4, 196065], [8, 196225], [14, 196505], [19, 196785], [24, 197025], [29, 197225], [35, 197525], [40, 197785], [47, 198545], [53, 198745], [58, 198965], [62, 199185], [65, 199265], [69, 199365], [76, 199785], [84, 200225], [92, 200885], [98, 201165], [105, 201985], [109, 202225], [113, 202425], [119, 202685], [124, 203105], [135, 203525], [139, 203805]]}, {"verse": 27, "start": 204821, "end": 214734, "text": "And the sons of Joseph, which were born him in Egypt, were two souls: all the souls of the house of Jacob, which came into Egypt, were threescore and ten.", "words": [[0, 204821], [4, 204956], [8, 205076], [13, 205356], [16, 205536], [24, 206336], [30, 206496], [35, 206676], [40, 206956], [44, 207156], [47, 207276], [54, 208136], [59, 208296], [63, 208576], [70, 209650], [74, 209838], [78, 210018], [84, 210298], [87, 210538], [91, 210618], [97, 210858], [100, 211018], [107, 211398], [113, 211678], [118, 211938], [123, 212158], [130, 212618], [135, 213188], [146, 213758], [150, 214118]]}, {"verse": 28, "start": 215184, "end": 221684, "text": "¶ And he sent Judah before him to Joseph, to direct his face to Goshen; and they came into the land of Goshen.", "words": [[2, 215184], [6, 215308], [9, 215448], [14, 215708], [20, 216048], [27, 216428], [31, 216688], [34, 216868], [42, 217268], [45, 217848], [52, 218168], [56, 218408], [61, 218688], [64, 218888], [72, 219740], [76, 219865], [81, 219985], [86, 220225], [91, 220485], [95, 220665], [100, 220905], [103, 221065]]}, {"verse": 29, "start": 222134, "end": 233251, "text": "And Joseph made ready his chariot, and went up to meet Israel his father, to Goshen, and presented himself to him; and he fell on his neck, and wept on his neck a good while.", "words": [[0, 222134], [4, 222275], [11, 222555], [16, 222915], [22, 223235], [26, 223435], [35, 224015], [39, 224455], [44, 224615], [47, 224755], [50, 224915], [55, 225055], [62, 225495], [66, 225855], [74, 226235], [77, 226535], [85, 227095], [89, 227455], [99, 227875], [107, 228335], [110, 228575], [115, 229715], [119, 229865], [122, 229965], [127, 230185], [130, 230425], [134, 230585], [140, 230865], [144, 231385], [149, 231745], [152, 231885], [156, 232085], [161, 232365], [163, 232465], [168, 232685]]}, {"verse": 30, "start": 233701, "end": 239407, "text": "And Israel said to Joseph, Now let me die, since I have seen your face, because you are yet alive.", "words": [[0, 233701], [4, 233825], [11, 234185], [16, 234505], [19, 234685], [27, 235517], [31, 235697], [35, 235917], [38, 236037], [43, 236577], [49, 236757], [51, 236937], [56, 237057], [61, 237237], [66, 237397], [72, 238057], [80, 238257], [84, 238497], [88, 238597], [92, 238797]]}, {"verse": 31, "start": 239757, "end": 249791, "text": "And Joseph said to his brethren, and to his father’s house, I will go up, and show Pharaoh, and say to him, My brethren, and my father’s house, which were in the land of Canaan, are come to me;", "words": [[0, 239757], [4, 239914], [11, 240214], [16, 240534], [19, 240734], [23, 240854], [33, 241234], [37, 241894], [40, 242054], [44, 242194], [53, 242674], [60, 243450], [62, 243595], [67, 243735], [70, 243915], [74, 244215], [78, 244475], [83, 244675], [92, 245075], [96, 245575], [100, 245835], [103, 246015], [108, 246155], [111, 246315], [121, 246635], [125, 246855], [128, 246995], [137, 247415], [144, 247575], [150, 247702], [155, 247828], [158, 247955], [162, 248075], [167, 248295], [170, 248395], [178, 248835], [182, 249195], [187, 249395], [190, 249555]]}, {"verse": 32, "start": 250241, "end": 257600, "text": "And the men are shepherds, for their trade has been to feed cattle; and they have brought their flocks, and their herds, and all that they have.", "words": [[0, 250241], [4, 250414], [8, 250554], [12, 250754], [16, 250934], [27, 251674], [31, 251874], [37, 252094], [43, 252474], [47, 252634], [52, 252854], [55, 253014], [60, 253214], [68, 254039], [72, 254181], [77, 254301], [82, 254501], [90, 254761], [96, 254981], [104, 255521], [108, 255781], [114, 255941], [121, 256361], [125, 256741], [129, 256981], [134, 257161], [139, 257301]]}, {"verse": 33, "start": 258050, "end": 262993, "text": "And it shall come to pass, when Pharaoh shall call you, and shall say, What is your occupation?", "words": [[0, 258050], [4, 258208], [7, 258328], [13, 258488], [18, 258708], [21, 258868], [27, 259228], [32, 259648], [40, 259988], [46, 260208], [51, 260488], [56, 260628], [60, 260988], [66, 261168], [71, 261900], [76, 262063], [79, 262183], [84, 262303]]}, {"verse": 34, "start": 263443, "end": 276290, "text": "That you shall say, Your servants’ trade has been about cattle from our youth even until now, both we, and also our fathers: that you may dwell in the land of Goshen; for every shepherd is an abomination to the Egyptians.", "words": [[0, 263443], [5, 263633], [9, 263773], [15, 263973], [20, 264313], [25, 264713], [35, 265373], [41, 265533], [45, 265793], [50, 266033], [56, 266213], [63, 266593], [68, 266873], [72, 267033], [78, 267253], [83, 267593], [89, 267913], [94, 268553], [99, 268753], [103, 269073], [107, 269493], [112, 269733], [116, 269913], [125, 270780], [130, 270900], [134, 271060], [138, 271220], [144, 271520], [147, 271820], [151, 271940], [156, 272160], [159, 272280], [167, 273098], [171, 273243], [177, 273443], [186, 273783], [189, 274223], [192, 274383], [204, 275023], [207, 275423], [211, 275543]]}]}