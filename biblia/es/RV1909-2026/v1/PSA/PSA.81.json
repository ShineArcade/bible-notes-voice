{"book": "PSA", "chapter": 81, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 101734, "verses": [{"verse": 1, "start": 300, "end": 10569, "text": "Al Músico principal: sobre Gittith: Salmo de Asaf. CANTAD a Dios, fortaleza nuestra: al Dios de Jacob celebrad con júbilo.", "words": [[0, 300], [3, 487], [10, 987], [21, 2073], [27, 2420], [36, 3345], [42, 4085], [45, 4245], [51, 5087], [58, 5287], [60, 5487], [66, 5767], [76, 6607], [85, 7569], [88, 8140], [93, 8480], [96, 8580], [102, 8920], [111, 9640], [115, 9800]]}, {"verse": 2, "start": 10919, "end": 15849, "text": "Tomad la canción, y tañed el pandero, el arpa deliciosa con el salterio.", "words": [[0, 10919], [6, 11257], [9, 11357], [18, 11837], [20, 12110], [26, 12384], [29, 12657], [38, 13297], [41, 13537], [46, 13917], [56, 14677], [60, 14877], [63, 15017]]}, {"verse": 3, "start": 16199, "end": 22479, "text": "Tocad la trompeta en la nueva luna, en el día señalado, en el día de nuestra solemnidad.", "words": [[0, 16311], [6, 16461], [9, 16781], [18, 17541], [21, 17641], [24, 17801], [30, 18061], [36, 18701], [39, 18981], [42, 19141], [46, 19341], [56, 20381], [59, 20521], [62, 20681], [66, 20901], [69, 21061], [77, 21281]]}, {"verse": 4, "start": 22829, "end": 27472, "text": "Porque estatuto es de Israel, ordenanza del Dios de Jacob.", "words": [[0, 22829], [7, 23113], [16, 23913], [19, 24113], [22, 24253], [30, 25033], [40, 26113], [44, 26373], [49, 26653], [52, 26813]]}, {"verse": 5, "start": 27822, "end": 35653, "text": "Por testimonio en José lo ha constituido, cuando salió por la tierra de Egipto; donde oí lenguaje que no entendía.", "words": [[0, 27822], [4, 27822], [15, 28747], [18, 28827], [23, 29087], [26, 29347], [29, 29467], [42, 30347], [49, 30967], [55, 31467], [59, 31667], [62, 31827], [69, 32127], [72, 32387], [80, 33255], [86, 33525], [89, 33885], [98, 34445], [102, 34605], [105, 34785]]}, {"verse": 6, "start": 35873, "end": 41076, "text": "Aparté su hombro de debajo de la carga; sus manos se quitaron de vasijas de barro.", "words": [[0, 35873], [7, 36397], [10, 36577], [17, 36977], [20, 37077], [27, 37477], [30, 37597], [33, 37697], [40, 38715], [44, 38832], [50, 39172], [53, 39412], [62, 39832], [65, 39932], [73, 40432], [76, 40552]]}, {"verse": 7, "start": 41426, "end": 50458, "text": "En la calamidad clamaste, y yo te libré: te respondí en el secreto del trueno; te probé sobre las aguas de Meriba. (Selah.)", "words": [[0, 41426], [3, 41569], [6, 41669], [16, 42229], [26, 43089], [28, 43169], [31, 43289], [34, 43409], [41, 44357], [44, 44438], [53, 45078], [56, 45298], [59, 45398], [67, 45898], [71, 46038], [79, 46926], [82, 46976], [88, 47396], [94, 47896], [98, 48156], [104, 48556], [107, 48896], [115, 50118]]}, {"verse": 8, "start": 50678, "end": 55098, "text": "Oye, pueblo mío, y te advertiré. Israel, si me oyes,", "words": [[0, 50678], [5, 50965], [12, 51145], [17, 51865], [19, 52025], [22, 52125], [33, 53375], [41, 53801], [44, 54081], [47, 54241]]}, {"verse": 9, "start": 55448, "end": 59890, "text": "No habrá en ti dios ajeno, ni te encorvarás a dios extraño.", "words": [[0, 55448], [3, 55598], [9, 55958], [12, 56098], [15, 56258], [20, 56498], [27, 57318], [30, 57578], [33, 57998], [44, 58418], [46, 58518], [51, 58698]]}, {"verse": 10, "start": 60240, "end": 67405, "text": "Yo soy Jehová tu Dios, que te hice subir de la tierra de Egipto: ensancha tu boca, y yo la llenaré.", "words": [[0, 60240], [3, 60429], [7, 60649], [14, 61089], [17, 61209], [23, 61889], [27, 62209], [30, 62369], [35, 62589], [41, 62949], [44, 63229], [47, 63329], [54, 63609], [57, 63849], [65, 65197], [74, 65477], [77, 65637], [83, 65977], [85, 66262], [88, 66442], [91, 66562]]}, {"verse": 11, "start": 67755, "end": 71332, "text": "Pero mi pueblo no oyó mi voz, e Israel no me quiso a mí.", "words": [[0, 67755], [5, 67896], [8, 68056], [15, 68376], [18, 68616], [22, 68856], [25, 68976], [30, 69616], [32, 69696], [39, 70056], [42, 70296], [45, 70416], [51, 70716], [53, 70836]]}, {"verse": 12, "start": 71682, "end": 76679, "text": "Los dejé por tanto a la dureza de su corazón: caminaron en sus consejos.", "words": [[0, 71682], [4, 71824], [9, 72224], [13, 72344], [19, 72724], [21, 73084], [24, 73184], [31, 73584], [34, 73724], [37, 73844], [46, 74974], [56, 75476], [59, 75656], [63, 75776]]}, {"verse": 13, "start": 77029, "end": 82404, "text": "¡Oh, si me hubiera oído mi pueblo, si en mis caminos hubiera Israel andado!", "words": [[0, 77116], [5, 77236], [8, 77496], [11, 77636], [19, 78016], [24, 78316], [27, 78496], [35, 79456], [38, 79776], [41, 79876], [45, 80036], [53, 80576], [61, 81056], [68, 81436]]}, {"verse": 14, "start": 82754, "end": 88192, "text": "En una nada habría yo derribado sus enemigos, y vuelto mi mano sobre sus adversarios.", "words": [[0, 82754], [3, 82893], [7, 83073], [12, 83413], [19, 83793], [22, 83933], [32, 84473], [36, 84653], [46, 85253], [48, 85693], [55, 86073], [58, 86213], [63, 86473], [69, 86773], [73, 86973]]}, {"verse": 15, "start": 88472, "end": 94407, "text": "Los aborrecedores de Jehová se le hubieran sometido; y el tiempo de ellos fuera para siempre.", "words": [[0, 88472], [4, 88953], [18, 89453], [21, 89593], [28, 90033], [31, 90113], [34, 90273], [43, 90713], [53, 91833], [55, 92001], [58, 92161], [65, 92581], [68, 92801], [74, 93081], [80, 93461], [85, 93701]]}, {"verse": 16, "start": 94757, "end": 101334, "text": "Y Dios lo hubiera mantenido de lo mejor del trigo: y de miel de la piedra te hubiera saciado.", "words": [[0, 94757], [2, 95002], [7, 95342], [10, 95822], [18, 96202], [28, 96882], [31, 97042], [34, 97142], [40, 97442], [44, 97642], [51, 98546], [53, 98670], [56, 98770], [61, 99070], [64, 99250], [67, 99370], [74, 99712], [77, 100053], [85, 100395]]}]}