{"book": "ISA", "chapter": 52, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 161121, "verses": [{"verse": 1, "start": 300, "end": 13990, "text": "Despierta, despierta, vístete tu fortaleza, oh Sion; vístete tu ropa de hermosura, oh Jerusalén, ciudad santa: porque nunca más acontecerá que venga a ti incircunciso ni inmundo.", "words": [[0, 300], [11, 1329], [22, 2269], [30, 2849], [33, 3069], [44, 3585], [47, 4100], [53, 4916], [61, 5426], [64, 5626], [69, 5986], [72, 6126], [83, 6446], [86, 6766], [97, 7786], [104, 8206], [111, 9151], [118, 9531], [124, 9731], [128, 10131], [139, 10891], [143, 11011], [149, 11371], [151, 11491], [154, 12241], [167, 12991], [170, 13519]]}, {"verse": 2, "start": 14440, "end": 22520, "text": "Sacúdete del polvo; levántate y siéntate, Jerusalén; suéltate de las ataduras de tu cuello, cautiva hija de Sion.", "words": [[0, 14440], [9, 15137], [13, 15319], [20, 16265], [30, 16615], [32, 16965], [42, 17505], [53, 18609], [62, 19328], [65, 19488], [69, 19628], [78, 20208], [81, 20368], [84, 20548], [92, 20888], [100, 21528], [105, 21968], [108, 22068]]}, {"verse": 3, "start": 22970, "end": 30164, "text": "Porque así dice Jehová: De balde fuisteis vendidos; por tanto, sin dinero seréis rescatados.", "words": [[0, 22970], [7, 23174], [11, 23474], [16, 23834], [24, 24728], [27, 24983], [33, 25273], [42, 25813], [52, 27148], [56, 27254], [63, 27954], [67, 28194], [74, 28614], [81, 29134]]}, {"verse": 4, "start": 30773, "end": 40839, "text": "Porque así dijo el Señor Jehová: Mi pueblo descendió a Egipto en tiempo pasado, para vivir allá; y el Assur lo cautivó sin razón.", "words": [[0, 30917], [7, 31097], [11, 31417], [16, 31817], [19, 31957], [25, 32257], [33, 33297], [36, 33417], [43, 33697], [53, 34337], [55, 34457], [62, 34977], [65, 35077], [72, 35397], [80, 36277], [85, 36557], [91, 36777], [97, 37900], [99, 37999], [102, 38219], [108, 38439], [111, 38579], [119, 39139], [123, 39279]]}, {"verse": 5, "start": 41573, "end": 54989, "text": "Y ahora ¿qué a mí aquí, dice Jehová, ya que mi pueblo sea llevado sin por qué? Y los que lo dominan lo hacen aullar de dolor, dice Jehová, y continuamente es blasfemado mi nombre todo el día.", "words": [[0, 41573], [2, 41691], [8, 42011], [13, 42511], [15, 42671], [18, 42811], [24, 43411], [29, 43691], [37, 44671], [40, 44771], [44, 44931], [47, 45071], [54, 45391], [58, 45731], [66, 46231], [70, 46451], [74, 46731], [79, 47637], [81, 47739], [85, 47859], [89, 48059], [92, 48179], [100, 48719], [103, 49159], [109, 49479], [116, 49919], [119, 50019], [126, 50619], [131, 50879], [139, 51839], [141, 51899], [155, 52759], [158, 52959], [169, 53619], [172, 53779], [179, 54079], [184, 54339], [187, 54579]]}, {"verse": 6, "start": 55673, "end": 63753, "text": "Por tanto, mi pueblo sabrá mi nombre por esta causa en aquel día: porque yo mismo que hablo, he aquí estaré presente.", "words": [[0, 55673], [4, 55776], [11, 56516], [14, 56676], [21, 56976], [27, 57436], [30, 57556], [37, 57876], [41, 58176], [46, 58396], [52, 58776], [55, 58936], [61, 59236], [66, 60154], [73, 60393], [76, 60633], [82, 60933], [86, 61193], [93, 62093], [96, 62233], [101, 62653], [108, 63033]]}, {"verse": 7, "start": 64330, "end": 79440, "text": "¡Cuán hermosos son sobre los montes los pies del que trae alegres nuevas, del que publica la paz, del que trae nuevas del bien, del que publica salvación, del que dice a Sion: Tu Dios reina!", "words": [[0, 64330], [6, 64598], [15, 65278], [19, 65608], [25, 65938], [29, 66118], [36, 67298], [40, 67398], [45, 67798], [49, 68098], [53, 68278], [58, 68678], [66, 69098], [74, 69878], [78, 70118], [82, 70298], [90, 70878], [93, 70998], [98, 71698], [102, 71918], [106, 72078], [111, 72538], [118, 72958], [122, 73278], [128, 74098], [132, 74358], [136, 74518], [144, 75078], [155, 76500], [159, 76820], [163, 77000], [168, 77384], [170, 77768], [176, 78468], [179, 78582], [184, 78695]]}, {"verse": 8, "start": 79890, "end": 89773, "text": "¡Voz de tus atalayas! alzarán la voz, juntamente darán voces de júbilo; porque ojo a ojo verán que Jehová vuelve a traer a Sion.", "words": [[0, 79890], [5, 80235], [8, 80535], [12, 81084], [22, 81886], [30, 82546], [33, 82666], [38, 83006], [49, 83506], [55, 83986], [61, 84386], [64, 84566], [72, 85551], [79, 85995], [83, 86695], [85, 86815], [89, 87095], [95, 87435], [99, 87595], [106, 88135], [113, 88575], [115, 88675], [121, 89055], [123, 89434]]}, {"verse": 9, "start": 90223, "end": 100491, "text": "Cantad alabanzas, alegraos juntamente, soledades de Jerusalén: porque Jehová ha consolado su pueblo, a Jerusalén ha redimido.", "words": [[0, 90223], [7, 90888], [18, 91868], [27, 92658], [39, 93448], [49, 94088], [52, 94228], [63, 95378], [70, 95622], [77, 96262], [80, 96422], [90, 97222], [93, 97442], [101, 98402], [103, 98662], [113, 99442], [116, 99998]]}, {"verse": 10, "start": 100941, "end": 112156, "text": "Jehová desnudó el brazo de su santidad ante los ojos de todas las naciones; y todos los confines de la tierra verán la salvación del Dios nuestro.", "words": [[0, 100941], [7, 101604], [15, 102384], [18, 102624], [24, 103124], [27, 103264], [30, 103444], [39, 104224], [44, 104844], [48, 105084], [53, 105424], [56, 105624], [62, 105924], [66, 106264], [76, 107455], [78, 107580], [84, 107940], [88, 108460], [97, 109120], [100, 109260], [103, 109380], [110, 109780], [116, 110260], [119, 110440], [129, 111080], [133, 111260], [138, 111500]]}, {"verse": 11, "start": 112606, "end": 123237, "text": "Apartaos, apartaos, salid de ahí, no toquéis cosa inmunda; salid de en medio de ella; limpiaos los que lleváis los vasos de Jehová.", "words": [[0, 112606], [10, 113578], [20, 114578], [26, 114938], [29, 115078], [34, 115818], [37, 116118], [45, 116638], [50, 116858], [59, 118121], [65, 118587], [68, 118887], [71, 119027], [77, 119307], [80, 119587], [86, 120366], [95, 121252], [99, 121492], [103, 121632], [111, 122092], [115, 122292], [121, 122692], [124, 122965]]}, {"verse": 12, "start": 123687, "end": 132794, "text": "Porque no saldréis apresurados, ni iréis huyendo; porque Jehová irá delante de vosotros, y os congregará el Dios de Israel.", "words": [[0, 123687], [7, 123894], [10, 124114], [19, 124674], [32, 125514], [35, 126154], [41, 126614], [50, 127719], [57, 127943], [64, 128503], [68, 128763], [76, 129223], [79, 129403], [89, 130043], [91, 130503], [94, 130623], [105, 131403], [108, 131623], [113, 131863], [116, 132103]]}, {"verse": 13, "start": 133094, "end": 139051, "text": "He aquí que mi siervo será prosperado, será engrandecido y exaltado, y será muy sublimado.", "words": [[0, 133094], [3, 133231], [8, 133511], [12, 133671], [15, 133811], [22, 134271], [27, 134511], [39, 135631], [44, 135831], [57, 136651], [59, 136771], [69, 137811], [71, 137891], [76, 138111], [80, 138311]]}, {"verse": 14, "start": 139747, "end": 148401, "text": "Como se pasmaron de ti muchos, en tanta manera fue desfigurado de los hombres su parecer; y su hermosura más que la de los hijos de los hombres.", "words": [[0, 139747], [5, 140115], [8, 140275], [17, 140795], [20, 140895], [23, 141035], [31, 141835], [34, 141995], [40, 142175], [47, 142595], [51, 142835], [63, 143495], [66, 143615], [70, 143775], [78, 144095], [81, 144275], [90, 145371], [92, 145471], [95, 145611], [105, 146231], [109, 146471], [113, 146711], [116, 146831], [119, 146971], [123, 147111], [129, 147391], [132, 147571], [136, 147691]]}, {"verse": 15, "start": 149082, "end": 160489, "text": "Pero él asombrará a muchas naciones: los reyes cerrarán sobre él sus bocas; porque verán lo que nunca les fue contado, y entenderán lo que jamás habían oído.", "words": [[0, 149082], [5, 149221], [8, 149441], [18, 150061], [20, 150221], [27, 150461], [37, 151936], [41, 152236], [47, 152676], [56, 153156], [62, 153396], [65, 153636], [69, 153816], [76, 155042], [83, 155299], [89, 155759], [92, 156019], [96, 156159], [102, 156379], [106, 156699], [110, 156859], [119, 157539],