{"book": "LUK", "chapter": 5, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 342854, "verses": [{"verse": 1, "start": 300, "end": 8297, "text": "Y aconteció, que estando él junto al lago de Genezaret, el gentío se agolpaba sobre él para oír la palabra de Dios.", "words": [[0, 300], [2, 426], [13, 1126], [17, 1386], [25, 1806], [28, 1966], [34, 2186], [37, 2446], [42, 2746], [45, 3436], [56, 4126], [59, 4226], [66, 4846], [69, 5046], [78, 5786], [84, 6086], [87, 6426], [92, 6626], [96, 7026], [99, 7166], [107, 7606], [110, 7746]]}, {"verse": 2, "start": 8647, "end": 17200, "text": "Y vio dos barcos que estaban cerca de la orilla del lago: y los pescadores, habiendo descendido de ellos, lavaban sus redes.", "words": [[0, 8647], [2, 8775], [6, 8975], [10, 9155], [17, 9595], [21, 9755], [29, 10035], [35, 10455], [38, 10715], [41, 10855], [48, 11255], [52, 11415], [58, 12130], [60, 12233], [64, 12393], [76, 13173], [85, 13693], [96, 14513], [99, 14693], [106, 15593], [114, 16253], [118, 16473]]}, {"verse": 3, "start": 17550, "end": 28197, "text": "Y entrado en uno de estos barcos, el cual era de Simón, le rogó que lo desviase de tierra un poco; y sentándose, enseñaba desde el barco a la multitud.", "words": [[0, 17550], [2, 17825], [10, 18345], [13, 18485], [17, 18665], [20, 18805], [26, 18985], [34, 19525], [37, 19785], [42, 19985], [46, 20365], [49, 20545], [56, 21065], [59, 21685], [64, 22185], [68, 22305], [71, 22465], [80, 23025], [83, 23205], [90, 23565], [93, 23805], [99, 24572], [101, 24698], [113, 25538], [122, 26438], [128, 26618], [131, 26858], [137, 27258], [139, 27358], [142, 27438]]}, {"verse": 4, "start": 28547, "end": 35622, "text": "Y como cesó de hablar, dijo a Simón: Ve a aguas profundas, y echad vuestras redes para pescar.", "words": [[0, 28547], [2, 28802], [7, 29022], [12, 29462], [15, 29562], [23, 30402], [28, 30794], [30, 31186], [37, 31734], [40, 31800], [42, 31900], [48, 32220], [59, 33260], [61, 33480], [67, 33900], [76, 34300], [82, 34620], [87, 34980]]}, {"verse": 5, "start": 35972, "end": 43880, "text": "Y respondiendo Simón, le dijo: Maestro, habiendo trabajado toda la noche, nada hemos tomado; pero en tu palabra echaré la red.", "words": [[0, 35972], [2, 36251], [15, 37091], [22, 37471], [25, 37631], [31, 38362], [40, 38919], [49, 39139], [59, 39719], [64, 39899], [67, 40079], [74, 40819], [79, 40999], [85, 41279], [93, 42126], [98, 42290], [101, 42410], [104, 42510], [112, 42850], [119, 43370], [122, 43510]]}, {"verse": 6, "start": 44160, "end": 49969, "text": "Y habiéndolo hecho, encerraron gran multitud de pescado, que su red se rompía.", "words": [[0, 44160], [2, 44324], [13, 44844], [20, 45164], [31, 46044], [36, 46264], [45, 47044], [48, 47284], [57, 48024], [61, 48219], [64, 48439], [68, 48779], [71, 49139]]}, {"verse": 7, "start": 50319, "end": 61482, "text": "E hicieron señas a los compañeros que estaban en el otro barco, que viniesen a ayudarles; y vinieron, y llenaron ambos barcos, de tal manera que se hundían.", "words": [[0, 50319], [2, 50636], [11, 51136], [17, 51876], [19, 51956], [23, 52076], [34, 52776], [38, 52896], [46, 53196], [49, 53456], [52, 53616], [57, 53796], [64, 54576], [68, 54916], [77, 55256], [79, 55536], [90, 56714], [92, 56856], [102, 57356], [104, 57656], [113, 58216], [119, 58616], [127, 59236], [130, 59636], [134, 59956], [141, 60316], [145, 60556], [148, 60716]]}, {"verse": 8, "start": 61832, "end": 69714, "text": "Lo cual viendo Simón Pedro, se derribó de rodillas a Jesús, diciendo: Apártate de mí, Señor, porque soy hombre pecador.", "words": [[0, 61832], [3, 61958], [8, 62138], [15, 62478], [21, 62938], [28, 63398], [31, 63938], [39, 64518], [42, 64638], [51, 65138], [53, 65318], [60, 65658], [70, 66868], [79, 67426], [82, 67586], [86, 67686], [93, 68366], [100, 68566], [104, 68786], [111, 69086]]}, {"verse": 9, "start": 69994, "end": 77065, "text": "Porque temor le había rodeado, y a todos los que estaban con él, de la captura de los peces que habían tomado;", "words": [[0, 69994], [7, 70238], [13, 70758], [16, 70878], [22, 71178], [31, 71898], [33, 72103], [35, 72203], [41, 72503], [45, 72783], [49, 72963], [57, 73303], [61, 73623], [65, 73863], [68, 74523], [71, 74643], [79, 75123], [82, 75263], [86, 75383], [92, 75923], [96, 76143], [103, 76403]]}, {"verse": 10, "start": 77415, "end": 89740, "text": "Y asimismo a Jacobo y a Juan, hijos de Zebedeo, que eran compañeros de Simón. Y Jesús dijo a Simón: No temas: desde ahora pescarás hombres.", "words": [[0, 77415], [2, 77812], [11, 78242], [13, 78542], [20, 79262], [22, 79422], [24, 79502], [30, 80482], [36, 80742], [39, 81522], [48, 82302], [52, 82362], [57, 82622], [68, 83482], [71, 83642], [78, 84590], [80, 84717], [86, 85077], [91, 85597], [93, 85837], [100, 86616], [103, 86763], [110, 87622], [116, 87848], [122, 88388], [131, 88928]]}, {"verse": 11, "start": 90090, "end": 94991, "text": "Y cuando llegaron a tierra los barcos, dejándolo todo, le siguieron.", "words": [[0, 90090], [2, 90178], [9, 90378], [18, 90958], [20, 91078], [27, 91378], [31, 91638], [39, 92598], [49, 93258], [55, 94118], [58, 94218]]}, {"verse": 12, "start": 95341, "end": 108486, "text": "Y aconteció que estando en una ciudad, he aquí un hombre lleno de lepra, el cual viendo a Jesús, postrándose sobre el rostro, le rogó, diciendo: Señor, si quieres, puedes limpiarme.", "words": [[0, 95341], [2, 95462], [12, 96142], [16, 96322], [24, 96682], [27, 96802], [31, 96962], [39, 97722], [42, 98002], [47, 98262], [50, 98442], [57, 98782], [63, 99302], [66, 99422], [73, 99855], [76, 100289], [81, 100722], [88, 101082], [90, 101242], [97, 102002], [109, 102742], [115, 103142], [118, 103342], [126, 104107], [129, 104247], [135, 104827], [145, 105970], [152, 106555], [155, 106555], [164, 107255], [171, 107655]]}, {"verse": 13, "start": 108766, "end": 115856, "text": "Entonces, extendiendo la mano, le tocó diciendo: Quiero: sé limpio. Y luego la lepra se fue de él.", "words": [[0, 108766], [10, 109650], [22, 110390], [25, 110550], [31, 110950], [34, 111010], [39, 111370], [49, 112270], [57, 112930], [60, 113098], [68, 113964], [70, 114072], [76, 114292], [79, 114532], [85, 114932], [88, 115032], [92, 115301], [95, 115441]]}, {"verse": 14, "start": 116206, "end": 127771, "text": "Y él le mandó que no lo dijese a nadie: Pero ve, le dijo, muéstrate al sacerdote, y ofrece por tu limpieza, como mandó Moisés, para testimonio a ellos.", "words": [[0, 116206], [2, 116373], [5, 116513], [8, 116653], [14, 117013], [18, 117153], [21, 117313], [24, 117433], [31, 117893], [33, 118053], [40, 118778], [45, 119134], [49, 119667], [52, 119881], [58, 120628], [68, 121114], [71, 121374], [82, 122134], [84, 122494], [91, 122874], [95, 123154], [98, 123294], [108, 124034], [113, 124614], [119, 125114], [127, 125574], [132, 126049], [143, 126989], [145, 127149]]}, {"verse": 15, "start": 128121, "end": 135430, "text": "Pero tanto más se extendía su fama: y se reunía mucha gente para oír y ser sanadas de sus enfermedades.", "words": [[0, 128121], [5, 128435], [11, 128695], [15, 129055], [18, 129235], [27, 129835], [30, 130015], [36, 130833], [38, 130954], [41, 131074], [48, 131574], [54, 131814], [60, 132214], [65, 132534], [69, 132934], [71, 133134], [75, 133374], [83, 133954], [86, 134114], [90, 134254]]}, {"verse": 16, "start": 135780, "end": 138805, "text": "Pero él se apartaba a los desiertos, y oraba.", "words": [[0, 135780], [5, 135944], [8, 136124], [11, 136264], [20, 136904], [22, 137004], [26, 137124], [37, 137964], [39, 138164]]}, {"verse": 17, "start": 139155, "end": 155708, "text": "Y aconteció un día, que él estaba enseñando, y los fariseos y maestros de la ley estaban sentados, los cuales habían venido de todas las aldeas de Galilea, y de Judea y Jerusalén: y el poder del Señor estaba allí para sanarlos.", "words": [[0, 139155], [2, 139332], [12, 140032], [15, 140212], [20, 140552], [24, 140787], [27, 141147], [34, 141447], [45, 142347], [47, 142987], [51, 143127], [60, 143827], [62, 143947], [71, 144567], [74, 144687], [77, 144827], [81, 145067], [89, 145447], [99, 146747], [103, 146947], [110, 147167], [117, 147607], [124, 148067], [127, 148207], [133, 148467], [137, 148767], [144, 149247], [147, 149347], [156, 150393], [158, 150633], [161, 150673], [167, 151313], [169, 151473], [180, 152630], [182, 152790], [185, 152950], [191, 153290], [195, 153530], [201, 153870], [208, 154290], [213, 154570], [218, 154810]]}, {"verse": 18, "start": 156058, "end": 164713, "text": "Y he aquí unos hombres, que traían sobre un lecho un hombre que estaba paralítico; y buscaban meterle, y ponerle delante de él.", "words": [[0, 156058], [2, 156194], [5, 156364], [10, 156604], [15, 156804], [24, 157284], [28, 157669], [35, 158149], [41, 158429], [44, 158609], [50, 159009], [53, 159309], [60, 159629], [64, 159849], [71, 160129], [83, 161468], [85, 161594], [94, 162074], [103, 162734], [105, 163114], [113, 163694], [121, 164174], [124, 164314]]}, {"verse": 19, "start": 165063, "end": 175608, "text": "Y no hallando por donde meterle a causa de la multitud, subieron encima de la casa, y por el tejado le bajaron con el lecho en medio, delante de Jesús;", "words": [[0, 165063], [2, 165186], [5, 165306], [14, 165726], [18, 165966], [24, 166206], [32, 166906], [34, 167026], [40, 167346], [43, 167546], [46, 167666], [56, 168746], [65, 169326], [72, 169766], [75, 169946], [78, 170086], [84, 170966], [86, 171166], [90, 171326], [93, 171446], [100, 172006], [103, 172126], [111, 172626], [115, 172806], [118, 172986], [124, 173346], [127, 173486], [134, 173906], [142, 174746], [145, 174906]]}, {"verse": 20, "start": 175958, "end": 181685, "text": "El cual, viendo la fe de ellos, le dice: Hombre, tus pecados te son perdonados.", "words": [[0, 175958], [3, 176121], [9, 176761], [16, 177101], [19, 177341], [22, 177521], [25, 177681], [32, 177961], [35, 178321], [41, 179110], [49, 179779], [53, 179939], [61, 180419], [64, 180559], [68, 180739]]}, {"verse": 21, "start": 182035, "end": 191791, "text": "Entonces los escribas y los fariseos comenzaron a pensar, diciendo: ¿Quién es este que habla blasfemias? ¿Quién puede perdonar pecados sino sólo Dios?", "words": [[0, 182035], [9, 182535], [13, 182995], [22, 183675], [24, 183835], [28, 183975], [37, 184615], [48, 185255], [50, 185375], [58, 185875], [68, 187204], [75, 187398], [78, 187538], [83, 187758], [87, 187978], [93, 188198], [105, 189259], [112, 189497], [118, 189697], [127, 190237], [135, 190757], [140, 190977], [145, 191237]]}, {"verse": 22, "start": 192071, "end": 199734, "text": "Jesús entonces, conociendo los pensamientos de ellos, respondiendo les dijo: ¿Qué pensáis en vuestros corazones?", "words": [[0, 192071], [6, 192497], [16, 193677], [27, 194317], [31, 194517], [44, 195197], [47, 195437], [54, 195970], [67, 196504], [71, 197037], [77, 197820], [82, 197923], [90, 198363], [93, 198563], [102, 198903]]}, {"verse": 23, "start": 200084, "end": 206984, "text": "¿Qué es más fácil, decir: Tus pecados te son perdonados, o decir: Levántate y anda?", "words": [[0, 200084], [5, 200206], [8, 200366], [12, 200586], [19, 201026], [26, 202277], [30, 202893], [38, 203453], [41, 203613], [45, 203853], [57, 204613], [59, 205012], [66, 205631], [76, 206269], [78, 206569]]}, {"verse": 24, "start": 207334, "end": 218266, "text": "Pues para que sepáis que el Hijo del hombre tiene potestad en la tierra de perdonar pecados, (dice al paralítico): A ti digo, levántate, toma tu lecho, y vete a tu casa.", "words": [[0, 207334], [5, 207638], [10, 208023], [14, 208183], [21, 208723], [25, 208963], [28, 209123], [33, 209363], [37, 209523], [44, 209823], [50, 210123], [59, 210803], [62, 210923], [65, 211063], [72, 211383], [75, 211603], [84, 212163], [93, 213057], [99, 213445], [102, 213665], [115, 214767], [117, 214972], [120, 215052], [126, 215452], [137, 216232], [142, 216412], [145, 216642], [152, 216872], [154, 217132], [159, 217452], [161, 217592], [164, 217672]]}, {"verse": 25, "start": 218616, "end": 226994, "text": "Y luego, levantándose en presencia de ellos, y tomando aquel en que estaba echado, se fue a su casa, glorificando a Dios.", "words": [[0, 218616], [2, 218761], [9, 219021], [22, 220081], [25, 220281], [35, 220901], [38, 221121], [45, 221941], [47, 222241], [55, 222621], [61, 222981], [64, 223101], [68, 223221], [75, 223521], [83, 224441], [86, 224541], [90, 224721], [92, 224821], [95, 224901], [101, 225661], [114, 226401], [116, 226501]]}, {"verse": 26, "start": 227344, "end": 235424, "text": "Y tomó espanto a todos, y glorificaban a Dios; y fueron llenos de temor, diciendo: Hemos visto maravillas hoy.", "words": [[0, 227344], [2, 227468], [7, 227788], [15, 228408], [17, 228568], [24, 228948], [26, 229508], [39, 230308], [41, 230428], [47, 231124], [49, 231263], [56, 231503], [63, 231943], [66, 232043], [73, 232543], [83, 233791], [89, 233974], [95, 234314], [106, 234934]]}, {"verse": 27, "start": 235704, "end": 246015, "text": "Y después de estas cosas salió, y vio a un recaudador de impuestos llamado Leví, sentado a la mesa de cobro de impuestos, y le dijo: Sígueme.", "words": [[0, 235704], [2, 235826], [10, 236126], [13, 236326], [19, 236526], [25, 236966], [32, 238006], [34, 238266], [38, 238526], [40, 238746], [43, 238926], [54, 239666], [57, 239866], [67, 240446], [75, 240766], [81, 241166], [89, 242366], [91, 242486], [94, 242586], [99, 242826], [102, 243026], [108, 243406], [111, 243566], [122, 244226], [124, 244406], [127, 244506], [133, 245636]]}, {"verse": 28, "start": 246365, "end": 250105, "text": "Y dejadas todas las cosas, levantándose, le siguió.", "words": [[0, 246365], [2, 246480], [10, 246860], [16, 247120], [20, 247400], [27, 247820], [41, 249200], [44, 249500]]}, {"verse": 29, "start": 250455, "end": 260128, "text": "E hizo Leví gran banquete en su casa; y había muchos recaudadores de impuestos y otras personas, los cuales estaban a la mesa con ellos.", "words": [[0, 250455], [2, 250619], [7, 250959], [12, 251299], [17, 251539], [26, 252199], [29, 252379], [32, 252519], [38, 253385], [40, 253511], [46, 253691], [53, 254091], [66, 255011], [69, 255251], [79, 255951], [81, 256491], [87, 256691], [97, 257771], [101, 257871], [108, 258111], [116, 258651], [118, 258851], [121, 258951], [126, 259191], [130, 259451]]}, {"verse": 30, "start": 260478, "end": 269825, "text": "Y los escribas y los fariseos murmuraban contra sus discípulos, diciendo: ¿Por qué coméis y bebéis con los recaudadores de impuestos y pecadores?", "words": [[0, 260478], [2, 260604], [6, 260764], [15, 261424], [17, 261584], [21, 261744], [30, 262464], [41, 263304], [48, 263684], [52, 263984], [64, 264964], [74, 266113], [79, 266240], [83, 266400], [90, 266820], [92, 266960], [99, 267280], [103, 267460], [107, 267580], [120, 268240], [123, 268420], [133, 268880], [135, 269040]]}, {"verse": 31, "start": 270105, "end": 277448, "text": "Y respondiendo Jesús, les dijo: Los que están sanos no necesitan médico, sino los que están enfermos.", "words": [[0, 270105], [2, 270227], [15, 270967], [22, 271367], [26, 271927], [32, 272746], [36, 273019], [40, 273179], [46, 273439], [52, 273919], [55, 274119], [65, 274739], [73, 275739], [78, 276039], [82, 276259], [86, 276379], [92, 276599]]}, {"verse": 32, "start": 277798, "end": 281857, "text": "No he venido a llamar justos, sino pecadores a arrepentimiento.", "words": [[0, 277798], [3, 277968], [6, 278048], [13, 278368], [15, 278448], [22, 278758], [30, 279068], [35, 279468], [45, 280288], [47, 280548]]}, {"verse": 33, "start": 282207, "end": 292595, "text": "Entonces ellos le dijeron: ¿Por qué los discípulos de Juan ayunan muchas veces y hacen oraciones, y asimismo los de los fariseos, y tus discípulos comen y beben?", "words": [[0, 282207], [9, 282646], [15, 283186], [18, 283426], [27, 284251], [32, 284317], [36, 284384], [40, 284604], [51, 285244], [54, 285404], [59, 285744], [66, 286164], [73, 286404], [79, 286844], [81, 287264], [87, 287504], [98, 288524], [100, 288814], [109, 289104], [113, 289324], [116, 289484], [120, 289604], [130, 290464], [132, 290724], [136, 290864], [147, 291604], [153, 291964], [155, 292144]]}, {"verse": 34, "start": 292875, "end": 299978, "text": "Y él les dijo: ¿Podéis hacer que los que están de bodas ayunen, entre tanto que el esposo está con ellos?", "words": [[0, 292875], [2, 293103], [5, 293283], [9, 293483], [15, 294237], [23, 294621], [29, 295101], [33, 295541], [37, 295701], [41, 295861], [47, 296101], [50, 296241], [56, 296601], [64, 297134], [70, 297668], [76, 298201], [80, 298421], [83, 298601], [90, 299021], [95, 299221], [99, 299481]]}, {"verse": 35, "start": 300328, "end": 306716, "text": "Pero vendrán días cuando el esposo les será quitado: entonces ayunarán en aquellos días.", "words": [[0, 300328], [5, 300495], [13, 300995], [18, 301335], [25, 301795], [28, 302035], [35, 302475], [39, 302695], [44, 302935], [53, 303875], [62, 304439], [71, 305459], [74, 305619], [83, 305879]]}, {"verse": 36, "start": 307066, "end": 318445, "text": "Y les decía también una parábola: Nadie mete remiendo de paño nuevo en vestido viejo; de otra manera el nuevo rompe, y al viejo no conviene remiendo nuevo.", "words": [[0, 307066], [2, 307189], [6, 307329], [12, 307749], [20, 308129], [24, 308509], [34, 309484], [40, 310084], [45, 310364], [54, 311064], [57, 311314], [62, 311564], [68, 311864], [71, 312044], [79, 312524], [86, 313321], [89, 313467], [94, 313627], [101, 314027], [104, 314227], [110, 314387], [117, 315087], [119, 315507], [122, 315667], [128, 316207], [131, 316647], [140, 317207], [149, 317827]]}, {"verse": 37, "start": 318795, "end": 329227, "text": "Y nadie echa vino nuevo en odres viejos; de otra manera el vino nuevo romperá los odres, y el vino se derramará, y los odres se perderán.", "words": [[0, 318795], [2, 318942], [8, 319242], [13, 319802], [18, 320202], [24, 320602], [27, 320802], [33, 321182], [41, 322273], [44, 322399], [49, 322559], [56, 322959], [59, 323159], [64, 323339], [70, 323659], [78, 324319], [82, 324479], [89, 325039], [91, 325304], [94, 325424], [99, 325664], [102, 325904], [113, 326604], [115, 327284], [119, 327444], [125, 328064], [128, 328404]]}, {"verse": 38, "start": 329577, "end": 335677, "text": "Pero el vino nuevo en odres nuevos se ha de echar; y lo uno y lo otro se conserva.", "words": [[0, 329577], [5, 329742], [8, 329922], [13, 330162], [19, 330542], [22, 330802], [28, 331222], [35, 331682], [38, 332162], [41, 332322], [44, 332462], [51, 333285], [53, 333408], [56, 333548], [60, 333848], [62, 334308], [65, 334448], [70, 334688], [73, 334888]]}, {"verse": 39, "start": 336027, "end": 342454, "text": "Y ninguno que bebe del añejo, quiere enseguida el nuevo; porque dice: El añejo es mejor.", "words": [[0, 336027], [2, 336144], [10, 336604], [14, 336804], [19, 337144], [23, 337324], [30, 337884], [37, 338544], [47, 339204], [50, 339344], [57, 340091], [64, 340314], [70, 341111], [73, 341276], [79, 341756], [82, 341896]]}]}