{"book": "PSA", "chapter": 9, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 127380, "verses": [{"verse": 1, "start": 300, "end": 5861, "text": "I will praise you, O LORD, with my whole heart; I will show forth all your marvellous works.", "words": [[0, 300], [2, 450], [7, 610], [14, 930], [19, 1290], [21, 1430], [27, 1890], [32, 2010], [35, 2230], [41, 2450], [48, 3277], [50, 3395], [55, 3555], [60, 3835], [66, 4155], [70, 4515], [75, 4825], [86, 5135]]}, {"verse": 2, "start": 6311, "end": 12099, "text": "I will be glad and rejoice in you: I will sing praise to your name, O you most High.", "words": [[0, 6311], [2, 6729], [7, 6889], [10, 7029], [15, 7409], [19, 7669], [27, 8029], [30, 8369], [35, 8985], [37, 9129], [42, 9289], [47, 9569], [54, 9929], [57, 10229], [62, 10369], [68, 10969], [70, 11069], [74, 11289], [79, 11509]]}, {"verse": 3, "start": 12549, "end": 16965, "text": "When my enemies are turned back, they shall fall and perish at your presence.", "words": [[0, 12549], [5, 12678], [8, 12898], [16, 13258], [20, 13518], [27, 13818], [33, 14658], [38, 14738], [44, 14938], [49, 15278], [53, 15518], [60, 15938], [63, 16158], [68, 16298]]}, {"verse": 4, "start": 17415, "end": 22199, "text": "For you have maintained my right and my cause; you sat in the throne judging right.", "words": [[0, 17415], [4, 17521], [8, 17661], [13, 17861], [24, 18341], [27, 18641], [33, 18961], [37, 19181], [40, 19361], [47, 20267], [51, 20373], [55, 20653], [58, 20873], [62, 20973], [69, 21313], [77, 21653]]}, {"verse": 5, "start": 22649, "end": 28165, "text": "You have rebuked the heathen, you have destroyed the wicked, you have put out their name for ever and ever.", "words": [[0, 22649], [4, 22773], [9, 22953], [17, 23493], [21, 23613], [30, 24313], [34, 24413], [39, 24533], [49, 24933], [53, 25253], [61, 25833], [65, 25973], [70, 26133], [74, 26293], [78, 26473], [84, 26673], [89, 26933], [93, 27153], [98, 27433], [102, 27693]]}, {"verse": 6, "start": 28615, "end": 36778, "text": "O you enemy, destructions are come to a perpetual end: and you have destroyed cities; their memorial is perished with them.", "words": [[0, 28759], [2, 28939], [6, 29119], [13, 29499], [26, 30519], [30, 30639], [35, 30919], [38, 31119], [40, 31279], [50, 31679], [55, 32780], [59, 32898], [63, 33038], [68, 33198], [78, 33598], [86, 34761], [92, 34863], [101, 35303], [104, 35663], [113, 36163], [118, 36423]]}, {"verse": 7, "start": 37228, "end": 41790, "text": "But the LORD shall endure for ever: he has prepared his throne for judgment.", "words": [[0, 37228], [4, 37357], [8, 37517], [13, 37757], [19, 38037], [26, 38479], [30, 38921], [36, 39620], [39, 39723], [43, 39903], [52, 40343], [56, 40563], [63, 40883], [67, 41123]]}, {"verse": 8, "start": 42240, "end": 47600, "text": "And he shall judge the world in righteousness, he shall minister judgment to the people in uprightness.", "words": [[0, 42240], [4, 42377], [7, 42477], [13, 42677], [19, 42977], [23, 43197], [29, 43497], [32, 43717], [47, 44697], [50, 44857], [56, 45077], [65, 45397], [74, 45957], [77, 46217], [81, 46317], [88, 46597], [91, 46817]]}, {"verse": 9, "start": 48050, "end": 52828, "text": "The LORD also will be a refuge for the oppressed, a refuge in times of trouble.", "words": [[0, 48050], [4, 48150], [9, 48370], [14, 48810], [19, 49010], [22, 49210], [24, 49310], [31, 49670], [35, 50050], [39, 50170], [50, 51150], [52, 51290], [59, 51650], [62, 51890], [68, 52110], [71, 52310]]}, {"verse": 10, "start": 53278, "end": 59415, "text": "And they that know your name will put their trust in you: for you, LORD, have not forsaken them that seek you.", "words": [[0, 53278], [4, 53428], [9, 53628], [14, 53868], [19, 54088], [24, 54268], [29, 54488], [34, 54688], [38, 54908], [44, 55068], [50, 55428], [53, 55648], [58, 56210], [62, 56338], [67, 56698], [73, 57418], [78, 57558], [82, 57758], [91, 58338], [96, 58558], [101, 58778], [106, 58998]]}, {"verse": 11, "start": 59865, "end": 65568, "text": "Sing praises to the LORD, which dwells in Zion: declare among the people his doings.", "words": [[0, 59865], [5, 60123], [13, 60683], [16, 60903], [20, 61043], [26, 61463], [32, 61603], [39, 62163], [42, 62283], [48, 63223], [56, 63723], [62, 64043], [66, 64263], [73, 64543], [77, 64823]]}, {"verse": 12, "start": 66018, "end": 71099, "text": "When he makes inquisition for blood, he remembers them: he forgets not the cry of the humble.", "words": [[0, 66018], [5, 66135], [8, 66255], [14, 66495], [26, 67215], [30, 67415], [37, 67895], [40, 67975], [50, 68355], [56, 69176], [59, 69265], [67, 69725], [71, 69865], [75, 70045], [79, 70305], [82, 70505], [86, 70625]]}, {"verse": 13, "start": 71549, "end": 79909, "text": "Have mercy upon me, O LORD; consider my trouble which I suffer of them that hate me, you that lift me up from the gates of death:", "words": [[0, 71549], [5, 71714], [11, 72074], [16, 72374], [20, 72714], [22, 72794], [28, 74132], [37, 74472], [40, 74752], [48, 75132], [54, 75432], [56, 75592], [63, 75932], [66, 76192], [71, 76372], [76, 76572], [81, 76812], [85, 77652], [89, 77912], [94, 78152], [99, 78332], [102, 78552], [105, 78732], [110, 78932], [114, 79092], [120, 79332], [123, 79512]]}, {"verse": 14, "start": 80359, "end": 86929, "text": "That I may show forth all your praise in the gates of the daughter of Zion: I will rejoice in your salvation.", "words": [[0, 80359], [5, 80519], [7, 80679], [11, 80859], [16, 81159], [22, 81479], [26, 81819], [31, 82019], [38, 82379], [41, 82639], [45, 82739], [51, 83059], [54, 83259], [58, 83379], [67, 83699], [70, 83899], [76, 84838], [78, 84981], [83, 85161], [91, 85641], [94, 85981], [99, 86081]]}, {"verse": 15, "start": 87379, "end": 93224, "text": "The heathen are sunk down in the pit that they made: in the net which they hid is their own foot taken.", "words": [[0, 87379], [4, 87483], [12, 87923], [16, 88063], [21, 88343], [26, 88663], [29, 88883], [33, 88983], [37, 89203], [42, 89383], [47, 89543], [53, 90356], [56, 90528], [60, 90668], [64, 90888], [70, 91128], [75, 91368], [79, 91648], [82, 91948], [88, 92168], [92, 92388], [97, 92688]]}, {"verse": 16, "start": 93674, "end": 102054, "text": "The LORD is known by the judgment which he executes: the wicked is snared in the work of his own hands. Higgaion. Selah.", "words": [[0, 93674], [4, 94009], [9, 94229], [12, 94429], [18, 94689], [21, 94949], [25, 95089], [34, 95429], [40, 95789], [43, 95969], [53, 97230], [57, 97450], [64, 97750], [67, 98140], [74, 98530], [77, 98670], [81, 98750], [86, 98970], [89, 99130], [93, 99290], [97, 99470], [104, 100792], [114, 101770]]}, {"verse": 17, "start": 102504, "end": 107362, "text": "The wicked shall be turned into hell, and all the nations that forget God.", "words": [[0, 102504], [4, 102592], [11, 102912], [17, 103272], [20, 103452], [27, 103752], [32, 104072], [38, 104472], [42, 105112], [46, 105432], [50, 105612], [58, 105972], [63, 106312], [70, 106692]]}, {"verse": 18, "start": 107812, "end": 114545, "text": "For the needy shall not always be forgotten: the expectation of the poor shall not perish for ever.", "words": [[0, 107812], [4, 108105], [8, 108265], [14, 108745], [20, 108945], [24, 109145], [31, 109525], [34, 109745], [45, 110789], [49, 111088], [61, 111708], [64, 112128], [68, 112268], [73, 112588], [79, 112848], [83, 113048], [90, 113547], [94, 114046]]}, {"verse": 19, "start": 114995, "end": 120669, "text": "Arise, O LORD; let not man prevail: let the heathen be judged in your sight.", "words": [[0, 114995], [7, 115519], [9, 115599], [15, 116500], [19, 116668], [23, 116928], [27, 117268], [36, 118417], [40, 118697], [44, 118877], [52, 119277], [55, 119417], [62, 119717], [65, 119997], [70, 120117]]}, {"verse": 20, "start": 121119, "end": 126980, "text": "Put them in fear, O LORD: that the nations may know themselves to be but men. Selah.", "words": [[0, 121119], [4, 121261], [9, 121481], [12, 121621], [18, 121941], [20, 122201], [2