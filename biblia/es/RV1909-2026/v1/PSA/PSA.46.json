{"book": "PSA", "chapter": 46, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 83539, "verses": [{"verse": 1, "start": 300, "end": 11645, "text": "Al Músico principal: de los hijos de Coré: Salmo sobre Alamoth. DIOS es nuestro amparo y fortaleza, nuestro pronto auxilio en las tribulaciones.", "words": [[0, 300], [3, 464], [10, 944], [21, 1996], [24, 2141], [28, 2281], [34, 2541], [37, 2880], [43, 3375], [49, 3955], [55, 4490], [64, 5245], [69, 5695], [72, 6155], [80, 6375], [87, 7255], [89, 7315], [100, 8355], [108, 8795], [115, 9255], [123, 10175], [126, 10375], [130, 10575]]}, {"verse": 2, "start": 11995, "end": 19291, "text": "Por tanto no temeremos aunque la tierra sea removida; aunque se traspasen los montes al corazón del mar.", "words": [[0, 11995], [4, 12239], [10, 12799], [13, 13099], [23, 13619], [30, 13939], [33, 14239], [40, 14539], [44, 15138], [54, 15922], [61, 16129], [64, 16349], [74, 17129], [78, 17269], [85, 17889], [88, 18029], [96, 18509], [100, 18789]]}, {"verse": 3, "start": 19641, "end": 25827, "text": "Bramarán, se turbarán sus aguas; temblarán los montes a causa de su braveza. (Selah.)", "words": [[0, 19906], [10, 20206], [13, 20506], [22, 21066], [26, 21266], [33, 22170], [43, 22733], [47, 22873], [54, 23473], [56, 23593], [62, 23933], [65, 24173], [68, 24629], [77, 25562]]}, {"verse": 4, "start": 26177, "end": 32728, "text": "Del río sus conductos alegrarán la ciudad de Dios, el santuario de las tiendas del Altísimo.", "words": [[0, 26177], [4, 26425], [8, 27365], [12, 27445], [22, 28125], [32, 28785], [35, 28905], [42, 29205], [45, 29445], [51, 30185], [54, 30265], [64, 30905], [67, 31065], [71, 31185], [79, 31685], [83, 31845]]}, {"verse": 5, "start": 33078, "end": 39963, "text": "Dios está en medio de ella; no será conmovida: Dios la ayudará al clarear la mañana.", "words": [[0, 33078], [5, 33458], [10, 33838], [13, 33998], [19, 34258], [22, 34558], [28, 35284], [31, 35413], [36, 35613], [47, 36768]