{"book": "MAT", "chapter": 2, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 222588, "verses": [{"verse": 1, "start": 300, "end": 9098, "text": "Y como nació Jesús en Belén de Judea en días del rey Herodes, he aquí unos magos vinieron del oriente a Jerusalén,", "words": [[0, 300], [2, 402], [7, 642], [13, 1042], [19, 1502], [22, 1882], [28, 2282], [31, 2382], [37, 3022], [40, 3302], [45, 3662], [49, 4062], [53, 4502], [62, 5072], [65, 5642], [70, 6102], [75, 6362], [81, 6862], [90, 7342], [94, 7582], [102, 8062], [104, 8222]]}, {"verse": 2, "start": 9548, "end": 17627, "text": "Diciendo: ¿Dónde está el Rey de los judíos, que ha nacido? porque su estrella hemos visto en el oriente, y venimos a adorarle.", "words": [[0, 9548], [10, 10752], [17, 11088], [22, 11348], [25, 11548], [29, 11808], [32, 11848], [36, 11988], [44, 12488], [48, 12628], [51, 12768], [59, 13589], [66, 13790], [69, 13950], [78, 14410], [84, 14590], [90, 14910], [93, 15090], [96, 15170], [105, 15630], [107, 16130], [115, 16550], [117, 16710]]}, {"verse": 3, "start": 17977, "end": 23177, "text": "Y oyendo esto el rey Herodes, se turbó, y toda Jerusalén con él.", "words": [[0, 17977], [2, 18118], [9, 18498], [14, 18778], [17, 18958], [21, 19298], [30, 19838], [33, 20478], [40, 21338], [42, 21578], [47, 21818], [57, 22598], [61, 22798]]}, {"verse": 4, "start": 23627, "end": 31372, "text": "Y convocados todos los príncipes de los sacerdotes, y los escribas del pueblo, les preguntó dónde había de nacer el Cristo.", "words": [[0, 23627], [2, 23713], [13, 24333], [19, 24613], [23, 24873], [33, 25593], [36, 25713], [40, 25833], [52, 26593], [54, 26753], [58, 27073], [67, 27393], [71, 27533], [79, 28433], [83, 28533], [92, 29133], [98, 29413], [104, 29813], [107, 29993], [113, 30413], [116, 30653]]}, {"verse": 5, "start": 31822, "end": 37015, "text": "Y ellos le dijeron: En Belén de Judea; porque así está escrito por el profeta:", "words": [[0, 31822], [2, 32006], [8, 32226], [11, 32466], [20, 33410], [23, 33572], [29, 33912], [32, 33972], [39, 34853], [46, 35062], [50, 35282], [55, 35562], [63, 35942], [67, 36242], [70, 36342]]}, {"verse": 6, "start": 37465, "end": 46421, "text": "Y tú, Belén, de tierra de Judá, no eres muy pequeña entre los príncipes de Judá; porque de ti saldrá un gobernante, que apacentará a mi pueblo Israel.", "words": [[0, 37465], [2, 37591], [6, 38151], [13, 38651], [16, 38911], [23, 39211], [26, 39371], [32, 40051], [35, 40151], [40, 40331], [44, 40491], [52, 40871], [58, 41191], [62, 41351], [72, 41911], [75, 42031], [81, 42793], [88, 42973], [91, 43133], [94, 43293], [101, 43733], [104, 43753], [116, 44433], [120, 44753], [131, 45373], [133, 45473], [136, 45553], [143, 45793]]}, {"verse": 7, "start": 46771, "end": 55512, "text": "Entonces Herodes, llamando en secreto a los magos, averiguó de ellos cuidadosamente cuándo había aparecido la estrella;", "words": [[0, 46771], [9, 47434], [18, 48554], [27, 48994], [30, 49094], [38, 49634], [40, 49714], [44, 49834], [51, 50834], [60, 51654], [63, 51754], [69, 52014], [84, 52894], [91, 53394], [97, 53954], [107, 54634], [110, 54794]]}, {"verse": 8, "start": 55962, "end": 66775, "text": "Y enviándolos a Belén, dijo: Andad allá, y preguntad con diligencia por el niño; y después que le halléis, hacédmelo saber, para que yo también vaya y le adore.", "words": [[0, 55962], [2, 56129], [14, 56969], [16, 57089], [23, 57889], [29, 59069], [35, 59289], [41, 59509], [43, 59669], [53, 60209], [57, 60349], [68, 61009], [72, 61229], [75, 61369], [81, 62112], [83, 62234], [91, 62514], [95, 62754], [98, 62874], [107, 63354], [117, 64194], [124, 64554], [129, 65074], [133, 65234], [136, 65374], [144, 65634], [149, 66034], [151, 66234], [154, 66314]]}, {"verse": 9, "start": 67125, "end": 78370, "text": "Y ellos, habiendo oído al rey, se fueron: y he aquí la estrella que habían visto en el oriente, iba delante de ellos, hasta que llegando, se puso sobre donde estaba el niño.", "words": [[0, 67125], [2, 67266], [9, 67526], [18, 68006], [23, 68306], [26, 68486], [31, 68826], [34, 68926], [42, 69838], [44, 70013], [47, 70223], [52, 70523], [55, 70723], [64, 71283], [68, 71443], [75, 71743], [81, 72063], [84, 72263], [87, 72383], [96, 73303], [100, 73823], [108, 74263], [111, 74463], [118, 74763], [124, 75343], [128, 75503], [138, 76043], [141, 76403], [146, 76803], [152, 77063], [158, 77323], [165, 77643], [168, 77843]]}, {"verse": 10, "start": 78820, "end": 83107, "text": "Y vista la estrella, se regocijaron con muy grande gozo.", "words": [[0, 78820], [2, 78944], [8, 79244], [11, 79464], [21, 80444], [24, 81054], [36, 81664], [40, 81844], [44, 82164], [51, 82424]]}, {"verse": 11, "start": 83557, "end": 96124, "text": "Y entrando en la casa, vieron al niño con su madre María, y postrándose, le adoraron; y abriendo sus tesoros, le ofrecieron dones, oro e incienso y mirra.", "words": [[0, 83557], [2, 83683], [11, 84163], [14, 84303], [17, 84423], [23, 85103], [30, 85583], [33, 85783], [38, 86123], [42, 86423], [45, 86583], [51, 86863], [58, 87343], [60, 87923], [73, 88763], [76, 89223], [86, 90402], [88, 90523], [97, 90963], [101, 91183], [110, 92223], [113, 92603], [124, 93243], [131, 94043], [135, 94323], [137, 94563], [146, 95363], [148, 95777]]}, {"verse": 12, "start": 96574, "end": 103666, "text": "Y siendo avisados por revelación en sueños que no volviesen a Herodes, se volvieron a su tierra por otro camino.", "words": [[0, 96574], [2, 96722], [9, 97042], [18, 97762], [22, 98022], [33, 98682], [36, 98902], [43, 99402], [47, 99582], [50, 99782], [60, 100322], [62, 100522], [71, 101242], [74, 101402], [84, 101862], [86, 102022], [89, 102142], [96, 102502], [100, 102802], [105, 103002]]}, {"verse": 13, "start": 104116, "end": 120904, "text": "Y después que ellos partieron, he aquí el ángel del Señor aparece en sueños a José, diciendo: Levántate, y toma al niño y a su madre, y huye a Egipto, y permanece allá hasta que yo te lo diga; porque ha de acontecer, que Herodes buscará al niño para matarlo.", "words": [[0, 104116], [2, 104234], [10, 104494], [14, 104714], [20, 104954], [31, 106194], [34, 106434], [39, 106674], [42, 106874], [48, 107334], [52, 107474], [58, 107794], [66, 108294], [69, 108634], [76, 109074], [78, 109234], [84, 109554], [94, 110916], [105, 111537], [107, 111797], [112, 111997], [115, 112157], [120, 112397], [122, 112577], [124, 112617], [127, 112737], [134, 113577], [136, 113657], [141, 113917], [143, 113997], [151, 114537], [153, 114837], [163, 115457], [168, 115717], [174, 116057], [178, 116237], [181, 116377], [184, 116497], [187, 116617], [193, 117360], [200, 117543], [203, 117763], [206, 117843], [217, 118383], [221, 118783], [229, 119083], [237, 119683], [240, 119803], [245, 120043], [250, 120303]]}, {"verse": 14, "start": 121254, "end": 127422, "text": "Y él despertando, tomó al niño y a su madre de noche, y se fue a Egipto;", "words": [[0, 121254], [2, 121438], [5, 121618], [18, 122478], [23, 122918], [26, 123058], [31, 123478], [33, 124158], [35, 124238], [38, 124398], [44, 124758], [47, 124978], [54, 125378], [56, 126158], [59, 126298], [63, 126538], [65, 126658]]}, {"verse": 15, "start": 127872, "end": 138131, "text": "Y estuvo allá hasta la muerte de Herodes: para que se cumpliese lo que fue dicho por el Señor, por el profeta que dijo: De Egipto llamé a mi Hijo.", "words": [[0, 127872], [2, 127970], [9, 128310], [14, 128670], [20, 128990], [23, 129170], [30, 129470], [33, 129830], [42, 130923], [47, 131087], [51, 131227], [54, 131617], [64, 132007], [67, 132187], [71, 132307], [75, 132487], [81, 132807], [85, 133127], [88, 133267], [95, 134447], [99, 134647], [102, 134767], [110, 135307], [114, 135447], [120, 136325], [123, 136415], [130, 136895], [136, 137375], [138, 137495], [141, 137615]]}, {"verse": 16, "start": 138581, "end": 157577, "text": "Herodes entonces, como se vio burlado de los magos, se enojó mucho, y envió, y mató a todos los niños que había en Belén y en todos sus alrededores, de edad de dos años abajo, conforme al tiempo que había entendido de los magos.", "words": [[0, 138581], [8, 139007], [18, 140167], [23, 140307], [26, 140527], [30, 140767], [38, 141367], [41, 141547], [45, 141687], [52, 142707], [55, 142887], [61, 143407], [68, 143847], [70, 144647], [77, 145207], [79, 145787], [84, 146187], [86, 146387], [92, 146667], [96, 147007], [102, 147547], [106, 147927], [112, 148267], [115, 148587], [121, 149107], [123, 149567], [126, 149727], [132, 150067], [136, 150487], [149, 152208], [152, 152416], [157, 152896], [160, 153016], [164, 153216], [169, 153576], [176, 154076], [185, 154816], [188, 154936], [195, 155276], [199, 155576], [205, 155816], [215, 156616], [218, 156736], [222, 156876]]}, {"verse": 17, "start": 158027, "end": 163076, "text": "Entonces fue cumplido lo que se había dicho por el profeta Jeremías, que dijo:", "words": [[0, 158027], [9, 158643], [13, 159083], [22, 159763], [25, 159903], [29, 160043], [32, 160203], [38, 160423], [44, 160763], [48, 161043], [51, 161183], [59, 161683], [69, 162323], [73, 162563]]}, {"verse": 18, "start": 163526, "end": 174346, "text": "Voz fue oída en Ramá, grande lamentación, lloro y gemido: Raquel que llora sus hijos; y no quiso ser consolada, porque perecieron.", "words": [[0, 163526], [4, 163833], [8, 164193], [13, 164713], [16, 164913], [22, 165673], [29, 166073], [42, 167573], [48, 167873], [50, 168013], [58, 169273], [65, 169563], [69, 169643], [75, 170043], [79, 170143], [86, 171173], [88, 171281], [91, 171401], [97, 171741], [101, 171981], [112, 172761], [119, 173381]]}, {"verse": 19, "start": 174796, "end": 181723, "text": "Pero muerto Herodes, he aquí el ángel del Señor aparece en sueños a José en Egipto,", "words": [[0, 174796], [5, 174981], [12, 175561], [21, 176351], [24, 177141], [29, 177461], [32, 177861], [38, 178341], [42, 178461], [48, 178881], [56, 179461], [59, 179801], [66, 180261], [68, 180421], [73, 180701], [76, 181001]]}, {"verse": 20, "start": 181973, "end": 191691, "text": "Diciendo: Levántate, y toma al niño y a su madre, y vete a tierra de Israel; que muertos son los que procuraban la muerte del niño.", "words": [[0, 181973], [10, 183100], [21, 183763], [23, 184043], [28, 184343], [31, 184523], [36, 184763], [38, 184923], [40, 184983], [43, 185103], [50, 185423], [52, 186003], [57, 186283], [59, 186383], [66, 186643], [69, 186823], [77, 187727], [81, 187811], [89, 188191], [93, 188411], [97, 188551], [101, 188691], [112, 189251], [115, 189391], [122, 189671], [126, 189891]]}, {"verse": 21, "start": 192041, "end": 198612, "text": "Entonces él se levantó, y tomó al niño y a su madre, y se vino a tierra de Israel.", "words": [[0, 192041], [9, 192507], [12, 193187], [15, 193387], [24, 194087], [26, 194587], [31, 194947], [34, 195087], [39, 195447], [41, 195687], [43, 195767], [46, 195887], [53, 196267], [55, 196727], [58, 196847], [63, 197067], [65, 197247], [72, 197507], [75, 197847]]}, {"verse": 22, "start": 199062, "end": 211123, "text": "Y oyendo que Archelao reinaba en Judea en lugar de Herodes su padre, temió ir allá: pero advertido por revelación en sueños, se fue a las partes de Galilea.", "words": [[0, 199062], [2, 199210], [9, 199610], [13, 200220], [22, 200830], [30, 201350], [33, 201490], [39, 202050], [42, 202250], [48, 202510], [51, 202830], [59, 203350], [62, 203670], [69, 204550], [75, 204970], [78, 205270], [84, 206071], [89, 206291], [99, 207111], [103, 207391], [114, 208231], [117, 208411], [125, 209371], [128, 209471], [132, 209651], [134, 209751], [138, 209851], [145, 210191], [148, 210371]]}, {"verse": 23, "start": 211573, "end": 222188, "text": "Y vino, y habitó en la ciudad que se llama Nazaret: para que se cumpliese lo que fue dicho por los profetas, que había de ser llamado nazareno.", "words": [[0, 211573], [2, 211777], [8, 212137], [10, 212837], [17, 213237], [20, 213337], [23, 213457], [30, 213837], [34, 214217], [37, 214377], [43, 214697], [52, 215992], [57, 216311], [61, 216451], [64, 216871], [74, 217291], [77, 217431], [81, 217551], [85, 217751], [91, 218091], [95, 218391], [99, 218571], [109, 219831], [113, 220071], [119, 220271], [122, 220451], [126, 220691], [134, 221051]]}]}