{"book": "ISA", "chapter": 19, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 263093, "verses": [{"verse": 1, "start": 300, "end": 15309, "text": "Carga de Egipto. He aquí que Jehová monta sobre una ligera nube, y entrará en Egipto; y los ídolos de Egipto se moverán delante de él, y se derretirá el corazón de los egipcios en medio de ellos.", "words": [[0, 300], [6, 527], [9, 787], [17, 1892], [20, 1972], [25, 2192], [29, 2412], [36, 2872], [42, 3232], [48, 3512], [52, 3812], [59, 4492], [65, 4992], [67, 5632], [75, 6292], [78, 6452], [86, 7593], [88, 7699], [92, 7839], [99, 8479], [102, 8599], [109, 9179], [112, 9339], [120, 9859], [128, 10339], [131, 10539], [135, 11199], [137, 11459], [140, 11909], [150, 12359], [153, 12459], [161, 12879], [164, 13139], [168, 13279], [177, 13939], [180, 14199], [186, 14539], [189, 14779]]}, {"verse": 2, "start": 15609, "end": 25608, "text": "Y revolveré egipcios contra egipcios, y cada uno peleará contra su hermano, cada uno contra su prójimo: ciudad contra ciudad, y reino contra reino.", "words": [[0, 15609], [2, 15730], [12, 16390], [21, 17010], [28, 17350], [38, 18070], [40, 18430], [45, 18690], [49, 19010], [57, 19530], [64, 19750], [67, 19970], [76, 20670], [81, 20950], [85, 21250], [92, 21510], [95, 21710], [104, 22933], [111, 23258], [118, 23598], [126, 24018], [128, 24458], [134, 24798], [141, 25078]]}, {"verse": 3, "start": 26332, "end": 36787, "text": "Y el espíritu de Egipto se desvanecerá en medio de él, y destruiré su consejo; y preguntarán a sus imágenes, a sus mágicos, a sus pythones y a sus adivinos.", "words": [[0, 26332], [2, 26434], [5, 26554], [14, 27134], [17, 27234], [24, 27754], [27, 28034], [39, 28794], [42, 28894], [48, 29114], [51, 29354], [55, 29514], [57, 29974], [67, 30574], [70, 30714], [79, 31984], [81, 32067], [93, 32727], [95, 32807], [99, 32947], [109, 33867], [111, 33887], [115, 34047], [124, 34887], [126, 34907], [130, 35247], [139, 35587], [141, 35867], [143, 35927], [147, 36087]]}, {"verse": 4, "start": 37511, "end": 46354, "text": "Y entregaré a Egipto en manos de señor duro; y un rey violento los gobernará, dice el Señor Jehová de los ejércitos.", "words": [[0, 37511], [2, 37631], [12, 38251], [14, 38331], [21, 38851], [24, 38971], [30, 39231], [33, 39511], [39, 39771], [45, 40930], [47, 41074], [50, 41174], [54, 41494], [63, 42034], [67, 42174], [78, 43573], [83, 43980], [86, 44200], [92, 44520], [99, 45100], [102, 45200], [106, 45320]]}, {"verse": 5, "start": 46804, "end": 51360, "text": "Y las aguas del mar faltarán, y el río se agotará y secará.", "words": [[0, 46804], [2, 47019], [6, 47179], [12, 47639], [16, 47799], [20, 48079], [30, 48899], [32, 49319], [35, 49499], [39, 49819], [42, 49979], [50, 50539], [52, 50719]]}, {"verse": 6, "start": 51810, "end": 60172, "text": "Y se alejarán los ríos, se agotarán y secarán las corrientes de los fosos: la caña y el carrizo serán cortados.", "words": [[0, 51810], [2, 51936], [5, 52056], [14, 52556], [18, 52716], [24, 53476], [27, 53576], [36, 54356], [38, 54696], [46, 55256], [50, 55396], [61, 56036], [64, 56216], [68, 56296], [75, 57320], [78, 57446], [83, 57906], [85, 58126], [88, 58306], [96, 58846], [102, 59206]]}, {"verse": 7, "start": 60622, "end": 69498, "text": "Las verduras de junto al río, de junto a la ribera del río, y toda sementera del río, se secarán, se perderán, y no serán.", "words": [[0, 60781], [4, 60976], [13, 61171], [16, 61366], [22, 61586], [25, 61906], [30, 62306], [33, 62706], [39, 62906], [41, 63106], [44, 63366], [51, 63626], [55, 63826], [60, 64246], [62, 64566], [67, 65146], [77, 65726], [81, 65886], [86, 66366], [89, 66546], [98, 67546], [101, 67746], [111, 68546], [113, 68786], [116, 68926]]}, {"verse": 8, "start": 69948, "end": 81911, "text": "Los pescadores también se entristecerán; y harán duelo todos los que echan anzuelo en el río, y desfallecerán los que extienden red sobre las aguas.", "words": [[0, 69948], [4, 70054], [15, 70754], [23, 71254], [26, 71674], [41, 73547], [43, 73684], [49, 73984], [55, 74404], [61, 74804], [65, 75304], [69, 75504], [75, 75804], [83, 76424], [86, 76524], [89, 76684], [94, 77504], [96, 77584], [110, 78764], [114, 79184], [118, 79344], [128, 80124], [132, 80484], [138, 80924], [142, 81204]]}, {"verse": 9, "start": 82361, "end": 87899, "text": "Los que labran lino fino, y los que tejen redes, serán confundidos;", "words": [[0, 82361], [4, 82510], [8, 82670], [15, 83130], [20, 83690], [26, 84150], [28, 84890], [32, 85050], [36, 85190], [42, 85610], [49, 85970], [55, 86770]]}, {"verse": 10, "start": 88349, "end": 95341, "text": "Porque todas sus redes serán rotas: y se entristecerán todos los que hacen viveros para peces.", "words": [[0, 88349], [7, 88533], [13, 88873], [17, 89193], [23, 89513], [29, 90053], [36, 91146], [38, 91291], [41, 91431], [55, 92491], [61, 92871], [65, 93371], [69, 93591], [75, 93871], [83, 94491], [88, 94731]]}, {"verse": 11, "start": 95791, "end": 111673, "text": "Ciertamente son necios los príncipes de Zoán; el consejo de los prudentes consejeros de Faraón, se ha desvanecido. ¿Cómo diréis a Faraón: Yo soy hijo de los sabios, e hijo de los reyes antiguos?", "words": [[0, 95791], [12, 96775], [16, 97075], [23, 98255], [27, 98335], [37, 99175], [40, 99610], [46, 100310], [49, 100682], [57, 101422], [60, 101562], [64, 101702], [74, 102402], [85, 103102], [88, 103492], [96, 103882], [99, 104322], [102, 104522], [115, 106236], [121, 106438], [128, 106998], [130, 107482], [138, 108170], [141, 108348], [145, 108588], [150, 108888], [153, 109028], [157, 109128], [165, 109748], [167, 109988], [172, 110248], [175, 110408], [179, 110508], [185, 110868]]}, {"verse": 12, "start": 112023, "end": 122026, "text": "¿Dónde están ahora aquellos tus prudentes? Que te digan ahora, o que te hagan saber qué es lo que Jehová de los ejércitos ha determinado sobre Egipto.", "words": [[0, 112023], [7, 112427], [13, 112727], [19, 113047], [28, 113618], [32, 114188], [43, 114998], [47, 115102], [50, 115222], [56, 115562], [63, 116322], [65, 116402], [69, 116542], [72, 116702], [78, 117042], [84, 117342], [88, 117662], [91, 118022], [94, 118202], [98, 118342], [105, 118822], [108, 118902], [112, 119042], [122, 119822], [125, 120102], [137, 120862], [143, 121162]]}, {"verse": 13, "start": 122476, "end": 133146, "text": "Se han desvanecido los príncipes de Zoán, se han engañado los príncipes de Menfis: engañaron a Egipto las esquinas de sus familias.", "words": [[0, 122476], [3, 122675], [7, 122875], [19, 123875], [23, 124095], [33, 125055], [36, 125575], [42, 126095], [45, 126195], [49, 126335], [58, 126975], [62, 127135], [72, 128015], [75, 128555], [83, 129340], [93, 130281], [95, 130521], [102, 131141], [106, 131321], [115, 131981], [118, 132121], [122, 132261]]}, {"verse": 14, "start": 133596, "end": 144034, "text": "Jehová mezcló espíritu de vahido en medio de él; e hicieron errar a Egipto en toda su obra, como desatina el borracho en su vómito.", "words": [[0, 133596], [7, 134023], [14, 134703], [23, 135543], [26, 135683], [33, 136143], [36, 136303], [42, 136623], [45, 136903], [49, 137573], [51, 137739], [60, 138399], [66, 139059], [68, 139259], [75, 139919], [78, 140079], [83, 140319], [86, 140659], [92, 141459], [97, 141959], [106, 142459], [109, 142579], [118, 143059], [121, 143199], [124, 143339]]}, {"verse": 15, "start": 144484, "end": 151113, "text": "Y no aprovechará a Egipto cosa que haga la cabeza o la cola, el ramo o el junco.", "words": [[0, 144484], [2, 144610], [5, 144830], [17, 145690], [19, 145850], [26, 146490], [31, 146950], [35, 147270], [40, 147530], [43, 147710], [50, 148170], [52, 148410], [55, 148530], [61, 149350], [64, 149490], [69, 149763], [71, 150037], [74, 150310]]}, {"verse": 16, "start": 151563, "end": 164095, "text": "En aquel día serán los egipcios como mujeres; porque se asombrarán y temerán, en la presencia de la mano alta de Jehová de los ejércitos, que él ha de levantar sobre ellos.", "words": [[0, 151563], [3, 151713], [9, 152073], [13, 152253], [19, 152733], [23, 152893], [32, 153513], [37, 153793], [46, 154969], [53, 155171], [56, 155371], [67, 156271], [69, 156471], [78, 157171], [81, 157711], [84, 157871], [94, 158611], [97, 158771], [100, 158911], [105, 159171], [110, 159511], [113, 159711], [120, 160171], [123, 160231], [127, 160391], [138, 161191], [142, 161791], [145, 162131], [148, 162411], [151, 162551], [160, 163151], [166, 163391]]}, {"verse": 17, "start": 164545, "end": 175864, "text": "Y la tierra de Judá será de espanto a Egipto; todo hombre que de ella se acuerda se asombrará, por causa del consejo que Jehová de los ejércitos acordó sobre aquel.", "words": [[0, 164545], [2, 164670], [5, 164790], [12, 165170], [15, 165410], [20, 165850], [25, 166090], [28, 166350], [36, 166990], [38, 167110], [46, 168034], [51, 168354], [58, 168754], [62, 168974], [65, 169134], [70, 169334], [73, 169554], [81, 170074], [84, 170234], [95, 171314], [99, 171514], [105, 171874], [109, 172194], [117, 172894], [121, 173054], [128, 173534], [131, 173634], [135, 173794], [145, 174514], [152, 175094], [158, 175374]]}, {"verse": 18, "start": 176314, "end": 188025, "text": "En aquel tiempo habrá cinco ciudades en la tierra de Egipto que hablen la lengua de Canaán, y que juren por Jehová de los ejércitos: una será llamada la ciudad Herez.", "words": [[0, 176314], [3, 176440], [9, 176760], [16, 177040], [22, 177480], [28, 177940], [37, 178820], [40, 178980], [43, 179140], [50, 179560], [53, 179740], [60, 180340], [64, 180500], [71, 180880], [74, 181060], [81, 181460], [84, 181770], [92, 182080], [94, 182720], [98, 182880], [104, 183300], [108, 183640], [115, 184200], [118, 184300], [122, 184460], [133, 185718], [137, 185983], [142, 186263], [150, 186743], [153, 186883], [160, 187473]]}, {"verse": 19, "start": 188475, "end": 196658, "text": "En aquel tiempo habrá altar para Jehová en medio de la tierra de Egipto, y el trofeo de Jehová junto a su término.", "words": [[0, 188475], [3, 188617], [9, 188917], [16, 189257], [22, 189777], [28, 190257], [33, 190557], [40, 191097], [43, 191337], [49, 191657], [52, 191877], [55, 191997], [62, 192357], [65, 192637], [73, 193337], [75, 193777], [78, 193937], [85, 194517], [88, 194637], [95, 195197], [101, 195417], [103, 195797], [106, 195917]]}, {"verse": 20, "start": 197108, "end": 210361, "text": "Y será por señal y por testimonio a Jehová de los ejércitos en la tierra de Egipto: porque a Jehová clamarán a causa de sus opresores, y él les enviará salvador y príncipe que los libre.", "words": [[0, 197108], [2, 197232], [7, 197492], [11, 197732], [17, 198332], [19, 198452], [23, 198632], [34, 199072], [36, 199512], [43, 200032], [46, 200112], [50, 200252], [60, 201032], [63, 201232], [66, 201352], [73, 201652], [76, 201892], [84, 202811], [91, 203076], [93, 203236], [100, 203636], [109, 204176], [111, 204276], [117, 204616], [120, 204836], [124, 204996], [135, 205776], [137, 206316], [140, 206616], [144, 207016], [152, 207656], [161, 208196], [163, 208516], [172, 209296], [176, 209516], [180, 209696]]}, {"verse": 21, "start": 210811, "end": 221477, "text": "Y Jehová será conocido de Egipto, y los de Egipto conocerán a Jehová en aquel día; y harán sacrificio y oblación; y harán votos a Jehová, y los cumplirán.", "words": [[0, 210811], [2, 210973], [9, 211413], [14, 211613], [23, 212273], [26, 212433], [34, 212973], [36, 213353], [40, 213533], [43, 213693], [50, 214173], [60, 214793], [62, 214853], [69, 215213], [72, 215293], [78, 215613], [83, 216401], [85, 216529], [91, 216729], [102, 217509], [104, 217629], [114, 218694], [116, 218822], [122, 219042], [128, 219522], [130, 219622], [138, 220162], [140, 220482], [144, 220622]]}, {"verse": 22, "start": 221927, "end": 230561, "text": "Y herirá Jehová a Egipto, herirá y sanará; y se convertirán a Jehová, y les será clemente, y los sanará.", "words": [[0, 221927], [2, 222071], [9, 222691], [16, 223271], [18, 223471], [26, 224591], [33, 225291], [35, 225611], [43, 226646], [45, 226753], [48, 226853], [60, 227553], [62, 227613], [70, 228133], [72, 228243], [76, 228353], [81, 228763], [91, 229173], [93, 229713], [97, 229853]]}, {"verse": 23, "start": 231011, "end": 243429, "text": "En aquel tiempo habrá una calzada de Egipto a Asiria, y asirios entrarán en Egipto, y egipcios en Asiria; y los egipcios servirán con los asirios a Jehová.", "words": [[0, 231011], [3, 231150], [9, 231450], [16, 231770], [22, 232290], [26, 232450], [34, 233130], [37, 233310], [44, 233930], [46, 234380], [54, 234830], [56, 235470], [64, 236110], [73, 236910], [76, 237110], [84, 237870], [86, 238190], [95, 238850], [98, 239417], [106, 240230], [108, 240317], [112, 240457], [121, 241097], [130, 241897], [134, 242057], [138, 242407], [146, 242757], [148, 242897]]}, {"verse": 24, "start": 243879, "end": 251436, "text": "En aquel tiempo, Israel será tercero con Egipto y con Asiria; será bendición en medio de la tierra;", "words": [[0, 243879], [3, 244024], [9, 244324], [17, 244644], [24, 245364], [29, 245724], [37, 246404], [41, 246564], [48, 247124], [50, 247244], [54, 247384], [62, 248437], [67, 248761], [77, 249641], [80, 249981], [86, 250361], [89, 250561], [92, 250681]]}, {"verse": 25, "start": 251886, "end": 262409, "text": "Porque Jehová de los ejércitos los bendecirá, diciendo: Bendito el pueblo mío Egipto, y el asirio obra de mis manos, e Israel mi heredad.", "words": [[0, 251886], [7, 252146], [14, 252686], [17, 252766], [21, 252926], [31, 253746], [35, 254086], [46, 255146], [56, 256273], [64, 256839], [67, 256999], [74, 257239], [78, 257699], [86, 258459], [88, 258679], [91, 258799], [98, 259399], [103, 259699], [106, 259879], [110, 259979], [117, 260839], [119, 260999], [126, 261439], [129, 261879]]}]}