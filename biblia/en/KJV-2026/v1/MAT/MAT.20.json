{"book": "MAT", "chapter": 20, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 245923, "verses": [{"verse": 1, "start": 300, "end": 6954, "text": "For the kingdom of heaven is like to a man that is a householder, which went out early in the morning to hire labourers into his vineyard.", "words": [[0, 300], [4, 386], [8, 506], [16, 786], [19, 1026], [26, 1306], [29, 1526], [34, 1746], [37, 1906], [39, 2026], [43, 2246], [48, 2426], [51, 2586], [53, 2666], [66, 3446], [72, 3766], [77, 3966], [81, 4226], [87, 4546], [90, 4726], [94, 4806], [102, 5066], [105, 5266], [110, 5676], [120, 6086], [125, 6266], [129, 6446]]}, {"verse": 2, "start": 7404, "end": 12873, "text": "And when he had agreed with the labourers for a denarius a day, he sent them into his vineyard.", "words": [[0, 7404], [4, 7541], [9, 7721], [12, 7961], [16, 8161], [23, 8561], [28, 8801], [32, 9161], [42, 9521], [46, 9681], [48, 9781], [57, 10221], [59, 10441], [64, 11141], [67, 11301], [72, 11541], [77, 11801], [82, 12101], [86, 12321]]}, {"verse": 3, "start": 13323, "end": 17796, "text": "And he went out about the third hour, and saw others standing idle in the marketplace,", "words": [[0, 13323], [4, 13460], [7, 13560], [12, 13720], [16, 13900], [22, 14080], [26, 14260], [32, 14480], [38, 14780], [42, 15340], [46, 15560], [53, 15880], [62, 16340], [67, 16700], [70, 16920], [74, 17000]]}, {"verse": 4, "start": 18146, "end": 25014, "text": "And said to them; Go also into the vineyard, and whatever is right I will give you. And they went their way.", "words": [[0, 18146], [4, 18289], [9, 18569], [12, 18789], [18, 19486], [21, 19606], [26, 19986], [31, 20266], [35, 20426], [45, 21106], [49, 21426], [58, 21686], [61, 22006], [67, 22246], [69, 22666], [74, 22806], [79, 23006], [84, 23682], [88, 23821], [93, 23941], [98, 24201], [104, 24481]]}, {"verse": 5, "start": 25314, "end": 29500, "text": "Again he went out about the sixth and ninth hour, and did likewise.", "words": [[0, 25314], [6, 25818], [9, 25898], [14, 26098], [18, 26298], [24, 26518], [28, 26698], [34, 27078], [38, 27358], [44, 27678], [50, 28018], [54, 28478], [58, 28658]]}, {"verse": 6, "start": 29950, "end": 36777, "text": "And about the eleventh hour he went out, and found others standing idle, and says to them, Why do you stand here all the day idle?", "words": [[0, 29950], [4, 30128], [10, 30308], [14, 30508], [23, 30868], [28, 31148], [31, 31348], [36, 31528], [41, 31788], [45, 32288], [51, 32508], [58, 32828], [67, 33208], [73, 33588], [77, 34008], [82, 34228], [85, 34428], [91, 34888], [95, 35088], [98, 35208], [102, 35328], [108, 35568], [113, 35848], [117, 36068], [121, 36208], [125, 36368]]}, {"verse": 7, "start": 37227, "end": 46055, "text": "They say to him, Because no man has hired us. He says to them, Go also into the vineyard; and whatever is right, that shall you receive.", "words": [[0, 37227], [5, 37376], [9, 37636], [12, 37816], [17, 38296], [25, 38716], [28, 39016], [32, 39316], [36, 39556], [42, 39836], [46, 40559], [49, 40639], [54, 40859], [57, 41059], [63, 41599], [66, 41879], [71, 42319], [76, 42639], [80, 42799], [90, 43583], [94, 43708], [103, 43928], [106, 44228], [113, 44888], [118, 45108], [124, 45348], [128, 45508]]}, {"verse": 8, "start": 46405, "end": 54823, "text": "So when even was come, the lord of the vineyard says to his steward, Call the labourers, and give them their hire, beginning from the last to the first.", "words": [[0, 46405], [3, 46605], [8, 46825], [13, 47125], [17, 47445], [23, 48205], [27, 48345], [32, 48565], [35, 48725], [39, 48805], [48, 49205], [53, 49465], [56, 49725], [60, 49925], [69, 50770], [74, 50933], [78, 51293], [89, 51653], [93, 51793], [98, 51953], [103, 52133], [109, 52293], [115, 52933], [125, 53273], [130, 53573], [134, 53713], [139, 54013], [142, 54173], [146, 54273]]}, {"verse": 9, "start": 55273, "end": 60129, "text": "And when they came that were hired about the eleventh hour, they received every man a denarius.", "words": [[0, 55273], [4, 55410], [9, 55530], [14, 55690], [19, 55950], [24, 56170], [29, 56290], [35, 56530], [41, 56770], [45, 57070], [54, 57370], [60, 57950], [65, 58070], [74, 58470], [80, 58770], [84, 59150], [86, 59370]]}, {"verse": 10, "start": 60579, "end": 67128, "text": "But when the first came, they supposed that they should have received more; and they likewise received every man a denarius.", "words": [[0, 60579], [4, 60684], [9, 60824], [13, 60964], [19, 61204], [25, 61924], [30, 62104], [39, 62484], [44, 62804], [49, 62944], [56, 63124], [61, 63244], [70, 63564], [76, 64323], [80, 64447], [85, 64547], [94, 64907], [103, 65407], [109, 65807], [113, 66147], [115, 66327]]}, {"verse": 11, "start": 67578, "end": 71634, "text": "And when they had received it, they murmured against the goodman of the house,", "words": [[0, 67578], [4, 67722], [9, 67882], [14, 68082], [18, 68242], [27, 68602], [31, 69282], [36, 69462], [45, 69922], [53, 70182], [57, 70522], [65, 70862], [68, 71042], [72, 71162]]}, {"verse": 12, "start": 72084, "end": 78559, "text": "Saying, These last have wrought but one hour, and you have made them equal to us, which have borne the burden and heat of the day.", "words": [[0, 72084], [8, 72386], [14, 72626], [19, 73006], [24, 73226], [32, 73566], [36, 73706], [40, 73986], [46, 74626], [50, 74846], [54, 75006], [59, 75126], [64, 75306], [69, 75506], [75, 75806], [78, 76046], [82, 76446], [88, 76606], [93, 76766], [99, 77086], [103, 77186], [110, 77466], [114, 77666], [119, 77866], [122, 78026], [126, 78126]]}, {"verse": 13, "start": 79009, "end": 84883, "text": "But he answered one of them, and said, Friend, I do you no wrong: did you not agree with me for a denarius?", "words": [[0, 79009], [4, 79111], [7, 79231], [16, 79571], [20, 79831], [23, 79951], [29, 80131], [33, 80271], [39, 80771], [47, 81591], [49, 81691], [52, 81831], [56, 81971], [59, 82111], [66, 82921], [70, 83017], [74, 83137], [78, 83297], [84, 83577], [89, 83777], [92, 83917], [96, 84097], [98, 84197]]}, {"verse": 14, "start": 85333, "end": 90488, "text": "Take that yours is, and go your way: I will give to this last, even as to you.", "words": [[0, 85333], [5, 85475], [10, 85695], [16, 85915], [20, 86215], [24, 86535], [27, 86735], [32, 86895], [37, 87609], [39, 87766], [44, 87886], [49, 88146], [52, 88326], [57, 88506], [63, 89366], [68, 89606], [71, 89866], [74, 90026]]}, {"verse": 15, "start": 90938, "end": 96479, "text": "Is it not lawful for me to do what I will with mine own? Is your eye evil, because I am good?", "words": [[0, 90938], [3, 91061], [6, 91181], [10, 91341], [17, 91821], [21, 92001], [24, 92141], [27, 92301], [30, 92481], [35, 92681], [37, 92801], [42, 93041], [47, 93241], [52, 93441], [57, 94235], [60, 94527], [65, 94687], [69, 94947], [75, 95327], [83, 95647], [85, 95887], [88, 95987]]}, {"verse": 16, "start": 96929, "end": 102468, "text": "So the last shall be first, and the first last: for many be called, but few chosen.", "words": [[0, 96929], [3, 97106], [7, 97266], [12, 97586], [18, 97826], [21, 97986], [28, 98666], [32, 98966], [36, 99086], [42, 99306], [48, 100251], [52, 100355], [57, 100615], [60, 100795], [68, 101515], [72, 101615], [76, 101875]]}, {"verse": 17, "start": 102818, "end": 108789, "text": "¶ And Jesus going up to Jerusalem took the twelve disciples apart in the way, and said to them,", "words": [[2, 102818], [6, 102960], [12, 103480], [18, 103660], [21, 103880], [24, 104020], [34, 104800], [39, 104900], [43, 105100], [50, 105380], [60, 105960], [66, 106280], [69, 106500], [73, 106580], [78, 106860], [82, 107360], [87, 107600], [90, 107800]]}, {"verse": 18, "start": 109039, "end": 116772, "text": "Behold, we go up to Jerusalem; and the Son of man shall be betrayed to the chief priests and to the scribes, and they shall condemn him to death,", "words": [[0, 109039], [8, 109543], [11, 109623], [14, 109783], [17, 110003], [20, 110143], [31, 111143], [35, 111266], [39, 111366], 