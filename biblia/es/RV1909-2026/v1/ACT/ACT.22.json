{"book": "ACT", "chapter": 22, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 255770, "verses": [{"verse": 1, "start": 300, "end": 4386, "text": "Varones hermanos y padres, oíd la defensa que ahora os presento.", "words": [[0, 493], [8, 723], [17, 1303], [19, 1383], [27, 2043], [31, 2463], [34, 2603], [42, 3103], [46, 3263], [52, 3483], [55, 3663]]}, {"verse": 2, "start": 4736, "end": 10810, "text": "(Y cuando oyeron que les hablaba en lengua hebrea, guardaron más silencio.) Y dijo:", "words": [[0, 4736], [3, 4839], [10, 5099], [17, 5639], [21, 5759], [25, 5919], [33, 6519], [36, 6659], [43, 7099], [51, 7999], [61, 8719], [65, 8959], [76, 10219], [78, 10299]]}, {"verse": 3, "start": 11060, "end": 25031, "text": "Yo de cierto soy judío, nacido en Tarso de Cilicia, pero criado en esta ciudad a los pies de Gamaliel, enseñado conforme a la verdad de la ley de la patria, celoso de Dios, como todos vosotros sois hoy.", "words": [[0, 11060], [3, 11323], [6, 11383], [13, 12003], [17, 12163], [24, 13063], [31, 13583], [34, 13763], [40, 14103], [43, 14633], [52, 15163], [57, 15383], [64, 15803], [67, 15943], [72, 16163], [79, 16503], [81, 16743], [85, 16863], [90, 17083], [93, 17243], [103, 18182], [112, 18846], [121, 19446], [123, 19526], [126, 19586], [133, 19966], [136, 20226], [139, 20346], [143, 20546], [146, 20666], [149, 20806], [157, 21806], [164, 22186], [167, 22406], [173, 23206], [178, 23366], [184, 23686], [193, 24286], [198, 24686]]}, {"verse": 4, "start": 25481, "end": 30923, "text": "Que he perseguido este camino hasta la muerte, prendiendo y entregando en cárceles hombres y mujeres:", "words": [[0, 25481], [4, 25581], [7, 25661], [18, 26301], [23, 26501], [30, 26921], [36, 27161], [39, 27321], [47, 27981], [58, 28561], [60, 28681], [71, 29181], [74, 29281], [83, 29821], [91, 30101], [93, 30321]]}, {"verse": 5, "start": 31373, "end": 44702, "text": "Como también el sumo sacerdote me es testigo, y todos los ancianos; de los cuales también tomando cartas a los hermanos, iba a Damasco para traer presos a Jerusalén aun a los que estuviesen allí, para que fuesen castigados.", "words": [[0, 31373], [5, 31537], [13, 31937], [16, 32117], [21, 32437], [31, 32690], [34, 32944], [37, 33197], [46, 33817], [48, 34057], [54, 34237], [58, 34457], [68, 35459], [71, 35577], [75, 35697], [82, 35957], [90, 36357], [98, 36937], [105, 37417], [107, 37517], [111, 37597], [121, 38497], [125, 38797], [127, 39017], [135, 39397], [140, 39617], [146, 39977], [153, 40437], [155, 40537], [165, 41317], [169, 41537], [171, 41697], [175, 41837], [179, 41997], [190, 42497], [196, 43197], [201, 43337], [205, 43477], [212, 43817]]}, {"verse": 6, "start": 45152, "end": 52431, "text": "Pero aconteció que yendo yo, y llegando cerca de Damasco, como a medio día, de repente me rodeó mucha luz del cielo:", "words": [[0, 45152], [5, 45311], [15, 45951], [19, 46111], [25, 46451], [29, 47271], [31, 47311], [40, 47711], [46, 48011], [49, 48251], [58, 48831], [63, 49071], [65, 49211], [71, 49411], [76, 50131], [79, 50211], [87, 50591], [90, 50871], [96, 51271], [102, 51511], [106, 51731], [110, 51931]]}, {"verse": 7, "start": 52881, "end": 59068, "text": "Y caí en el suelo, y oí una voz que me decía: Saulo, Saulo, ¿por qué me persigues?", "words": [[0, 52881], [2, 52983], [6, 53283], [9, 53403], [12, 53503], [19, 53883], [21, 54223], [24, 54423], [28, 54583], [32, 54823], [36, 54983], [39, 55103], [46, 56348], [53, 56688], [60, 57648], [65, 57748], [69, 57908], [72, 58048]]}, {"verse": 8, "start": 59368, "end": 67376, "text": "Yo entonces respondí: ¿Quién eres, Señor? Y me dijo: Yo soy Jesús de Nazaret, a quien tú persigues.", "words": [[0, 59368], [3, 59585], [12, 59925], [22, 61045], [29, 61305], [35, 61625], [42, 62375], [44, 62480], [47, 62580], [53, 63377], [56, 63583], [60, 63883], [66, 64323], [69, 64623], [78, 65623], [80, 65883], [86, 66063], [89, 66363]]}, {"verse": 9, "start": 67676, "end": 74471, "text": "Y los que estaban conmigo vieron a la verdad la luz, y se espantaron; pero no oyeron la voz del que hablaba conmigo.", "words": [[0, 67676], [2, 67781], [6, 67901], [10, 68061], [18, 68361], [26, 68961], [33, 69281], [35, 69441], [38, 69521], [45, 69801], [48, 70041], [53, 70361], [55, 70801], [58, 70901], [70, 71965], [75, 72105], [78, 72325], [85, 72745], [88, 72865], [92, 73085], [96, 73285], [100, 73465], [108, 73845]]}, {"verse": 10, "start": 74921, "end": 84653, "text": "Y dije: ¿Qué haré, Señor? Y el Señor me dijo: Levántate, y ve a Damasco, y allí te será dicho todo lo que te está señalado hacer.", "words": [[0, 74921], [2, 75064], [8, 75815], [13, 75936], [19, 76196], [26, 76995], [28, 77095], [31, 77195], [37, 77435], [40, 77655], [46, 78458], [57, 79176], [59, 79436], [62, 79596], [64, 79716], [73, 80396], [75, 80786], [80, 81176], [83, 81416], [88, 81736], [94, 82036], [99, 82536], [102, 82836], [106, 82976], [109, 83136], [114, 83416], [123, 84276]]}, {"verse": 11, "start": 84953, "end": 91364, "text": "Y como yo no viese por causa de la claridad de la luz, llevado de la mano por los que estaban conmigo, vine a Damasco.", "words": [[0, 84953], [2, 85042], [7, 85222], [10, 85402], [13, 85542], [19, 85842], [23, 86042], [29, 86302], [32, 86522], [35, 86622], [44, 87042], [47, 87162], [50, 87282], [55, 87882], [63, 88322], [66, 88442], [69, 88542], [74, 88782], [78, 88982], [82, 89122], [86, 89242], [94, 89482], [103, 90442], [108, 90622], [110, 90782]]}, {"verse": 12, "start": 91814, "end": 98594, "text": "Entonces un Ananías, hombre piadoso conforme a la ley, que tenía buen testimonio de todos los judíos que allí moraban,", "words": [[0, 91814], [9, 92135], [12, 92595], [21, 93055], [28, 93395], [36, 93955], [45, 94435], [47, 94495], [50, 94555], [55, 94795], [59, 95055], [65, 95315], [70, 95515], [81, 96175], [84, 96275], [90, 96455], [94, 96695], [101, 97095], [105, 97215], [110, 97375]]}, {"verse": 13, "start": 99044, "end": 104210, "text": "Viniendo a mí, y acercándose, me dijo: Hermano Saulo, recibe la vista. Y yo en aquella hora le miré.", "words": [[0, 99044], [9, 99044], [11, 99044], [15, 99044], [17, 99146], [30, 99746], [33, 99886], [39, 100593], [47, 100914], [54, 101434], [61, 101854], [64, 101954], [71, 102701], [73, 102822], [76, 102982], [79, 103102], [87, 103402], [92, 103622], [95, 103782]]}, {"verse": 14, "start": 104660, "end": 113187, "text": "Y él dijo: El Dios de nuestros padres te ha predestinado para que conocieses su voluntad, y vieses a aquel Justo, y oyeses la voz de su boca.", "words": [[0, 104660], [2, 104784], [5, 104904], [11, 105654], [14, 105775], [19, 105975], [22, 106135], [31, 106295], [38, 106815], [41, 107095], [44, 107215], [57, 107875], [62, 108095], [66, 108235], [77, 108875], [80, 108995], [90, 109815], [92, 110035], [99, 110395], [101, 110535], [107, 110775], [114, 111535], [116, 111635], [123, 112075], [126, 112215], [130, 112435], [133, 112575], [136, 112715]]}, {"verse": 15, "start": 113637, "end": 118000, "text": "Porque has de ser testigo suyo a todos los hombres, de lo que has visto y oído.", "words": [[0, 113637], [7, 113823], [11, 114023], [14, 114143], [18, 114303], [26, 114823], [31, 115223], [33, 115323], [39, 115503], [43, 115703], [52, 116083], [55, 116643], [58, 116763], [62, 116903], [66, 117043], [72, 117303], [74, 117543]]}, {"verse": 16, "start": 118450, "end": 125019, "text": "Ahora pues, ¿por qué te detienes? Levántate, y bautízate, y lava tus pecados, invocando su nombre.", "words": [[0, 118450], [6, 118691], [12, 119491], [17, 119591], [21, 119731], [24, 119851], [34, 120845], [45, 121429], [47, 121589], [58, 122189], [60, 122449], [65, 122589], [69, 122829], [78, 123549], [88, 124029], [91, 124209]]}, {"verse": 17, "start": 125469, "end": 130538, "text": "Y me aconteció, vuelto a Jerusalén, que orando en el templo, entré en éxtasis.", "words": [[0, 125469], [2, 125570], [5, 125650], [16, 126290], [23, 126650], [25, 126730], [36, 127710], [40, 127970], [47, 128230], [50, 128390], [53, 128510], [61, 129310], [67, 129670], [70, 129770]]}, {"verse": 18, "start": 130988, "end": 139108, "text": "Y le vi que me decía: Date prisa, y sal rápidamente fuera de Jerusalén; porque no recibirán tu testimonio de mí.", "words": [[0, 130988], [2, 131071], [5, 131191], [8, 131311], [12, 131431], [15, 131572], [22, 132506], [27, 132753], [34, 133313], [36, 133393], [40, 133653], [52, 134473], [58, 134793], [61, 135390], [72, 136240], [79, 136639], [82, 136879], [92, 137659], [95, 137859], [106, 138639], [109, 138739]]}, {"verse": 19, "start": 139408, "end": 145712, "text": "Y yo dije: Señor, ellos saben que yo encerraba en cárcel, y hería por las sinagogas a los que creían en ti;", "words": [[0, 139408], [2, 139518], [5, 139638], [11, 140402], [18, 141187], [24, 141367], [30, 141647], [34, 141827], [37, 141987], [47, 142467], [50, 142567], [58, 143047], [60, 143387], [66, 143647], [70, 143787], [74, 143947], [84, 144527], [86, 144647], [90, 144747], [94, 144847], [101, 145227], [104, 145387]]}, {"verse": 20, "start": 146162, "end": 155430, "text": "Y cuando se derramaba la sangre de Esteban tu testigo, yo también estaba presente, y consentía a su muerte, y guardaba las ropas de los que le mataban.", "words": [[0, 146162], [2, 146268], [9, 146488], [12, 146748], [22, 147268], [25, 147408], [32, 147788], [35, 147988], [43, 148488], [46, 148668], [55, 149728], [58, 149868], [66, 150148], [73, 150488], [83, 151508], [85, 151548], [95, 152188], [97, 152308], [100, 152408], [108, 153248], [110, 153288], [119, 153708], [123, 153888], [129, 154248], [132, 154408], [136, 154528], [140, 154708], [143, 154808]]}, {"verse": 21, "start": 155880, "end": 159876, "text": "Y me dijo: Ve, porque yo te tengo que enviar lejos a los Gentiles.", "words": [[0, 155880], [2, 155988], [5, 156068], [11, 156873], [15, 157022], [22, 157262], [25, 157462], [28, 157602], [34, 157882], [38, 158062], [45, 158462], [51, 158842], [53, 159002], [57, 159122]]}, {"verse": 22, "start": 160326, "end": 169145, "text": "Y le oyeron hasta esta palabra: entonces alzaron la voz, diciendo: Quita de la tierra a un tal hombre, porque no conviene que viva.", "words": [[0, 160326], [2, 160450], [5, 160570], [12, 161130], [18, 161430], [23, 161650], [32, 162602], [41, 163109], [49, 163989], [52, 164189], [57, 164549], [67, 165733], [73, 165989], [76, 166129], [79, 166229], [86, 166549], [88, 166809], [91, 166949], [95, 167089], [103, 167649], [110, 167969], [113, 168149], [122, 168569], [126, 168729]]}, {"verse": 23, "start": 169495, "end": 174585, "text": "Y dando ellos voces, y arrojando sus ropas y echando polvo al aire,", "words": [[0, 169495], [2, 169639], [8, 169859], [14, 170119], [21, 170779], [23, 171119], [33, 171699], [37, 171899], [43, 172499], [45, 172939], [53, 173359], [59, 173919], [62, 174079]]}, {"verse": 24, "start": 175035, "end": 184841, "text": "Mandó el comandante que le llevasen a la fortaleza, y ordenó que fuese interrogado con azotes, para saber por qué causa clamaban así contra él.", "words": [[0, 175035], [6, 175322], [9, 175402], [20, 176002], [24, 176202], [27, 176402], [36, 176602], [38, 176802], [41, 176942], [52, 177742], [54, 178602], [61, 179082], [65, 179222], [71, 179562], [83, 180302], [87, 180522], [95, 181022], [100, 181782], [106, 182122], [110, 182422], [114, 182622], [120, 183182], [129, 183742], [133, 183982], [140, 184342]]}, {"verse": 25, "start": 185291, "end": 194390, "text": "Y como le ataron con correas, Pablo dijo al centurión que estaba presente: ¿Os es lícito azotar a un hombre Romano sin ser condenado?", "words": [[0, 185291], [2, 185417], [7, 185657], [10, 185877], [17, 186337], [21, 186577], [30, 187877], [36, 188357], [41, 188697], [44, 188937], [54, 189557], [58, 189697], [65, 189937], [75, 190975], [79, 191141], [82, 191301], [89, 191681], [96, 192181], [98, 192241], [101, 192401], [108, 192661], [115, 193141], [119, 193361], [123, 193621]]}, {"verse": 26, "start": 194740, "end": 205436, "text": "Y como el centurión oyó esto, fue y dio aviso al comandante, diciendo: ¿Qué vas a hacer? porque este hombre es Romano.", "words": [[0, 194740], [2, 194866], [7, 195126], [10, 195286], [20, 196006], [24, 196426], [30, 197286], [34, 197726], [36, 198046], [40, 198406], [46, 198766], [49, 198966], [61, 200246], [71, 201376], [76, 201480], [80, 201640], [82, 201780], [89, 202653], [96, 202793], [101, 202953], [108, 203153], [111, 203313]]}, {"verse": 27, "start": 205786, "end": 214957, "text": "Y viniendo el comandante, le dijo: Dime, ¿eres tú Romano? Y él dijo: Sí.", "words": [[0, 205786], [2, 205893], [11, 206393], [14, 206493], [26, 207453], [29, 207713], [35, 208501], [41, 209106], [47, 209286], [50, 209506], [58, 212616], [60, 212804], [63, 212964], [69, 214327]]}, {"verse": 28, "start": 215307, "end": 225900, "text": "Y respondió el comandante: Yo con grande suma alcancé esta ciudadanía. Entonces Pablo dijo: Pero yo lo soy de nacimiento.", "words": [[0, 215307], [2, 215432], [12, 216072], [15, 216152], [27, 217370], [30, 217511], [34, 217671], [41, 217951], [46, 218431], [54, 218911], [59, 219131], [71, 222281], [80, 222726], [86, 223346], [92, 224235], [97, 224376], [100, 224596], [103, 224716], [107, 224956], [110, 225076]]}, {"verse": 29, "start": 226250, "end": 237648, "text": "Así que, luego se apartaron de él los que le habían de atormentar: y aun el comandante también tuvo temor, entendido que era Romano, por haberle atado.", "words": [[0, 226250], [4, 226530], [9, 226710], [15, 226990], [18, 227250], [28, 227890], [31, 228130], [34, 228350], [38, 228790], [42, 228950], [45, 229130], [52, 229390], [55, 229610], [67, 230817], [69, 230980], [73, 231180], [76, 231360], [87, 232180], [95, 232600], [100, 233020], [107, 233820], [117, 234720], [121, 234940], [125, 235120], [133, 236320], [137, 236480], [145, 236980]]}, {"verse": 30, "start": 238098, "end": 255370, "text": "Y al día siguiente, queriendo saber de cierto la causa por qué era acusado de los judíos, le soltó de las ataduras, y mandó venir a los principales sacerdotes, y a todo su Consejo: y sacando a Pablo, le presentó delante de ellos.", "words": [[0, 238098], [2, 238221], [5, 238341], [9, 238481], [20, 239541], [30, 239941], [36, 240261], [39, 240501], [46, 240881], [49, 241441], [55, 241821], [59, 242221], [63, 242421], [67, 242801], [75, 243541], [78, 243701], [82, 243841], [90, 244781], [93, 244861], [99, 245401], [102, 245541], [106, 245721], [116, 246401], [118, 246941], [124, 247321], [130, 247641], [132, 247801], [136, 247921], [148, 248621], [160, 249903], [162, 250028], [164, 250128], [169, 250348], [172, 250608], [181, 251786], [183, 251912], [191, 252392], [193, 252512], [200, 252952], [203, 253592], [212, 254192], [220, 254612], [223, 254792]]}]}