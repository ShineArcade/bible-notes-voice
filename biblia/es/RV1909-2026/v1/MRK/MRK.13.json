{"book": "MRK", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 307580, "verses": [{"verse": 1, "start": 300, "end": 7804, "text": "Y saliendo del templo, le dice uno de sus discípulos: Maestro, mira qué piedras, y qué edificios.", "words": [[0, 300], [2, 443], [11, 903], [15, 1143], [23, 2163], [26, 2323], [31, 2623], [35, 3103], [38, 3283], [42, 3483], [54, 4932], [63, 5530], [68, 5650], [72, 5850], [81, 6390], [83, 6750], [87, 6910]]}, {"verse": 2, "start": 8154, "end": 17088, "text": "Y Jesús respondiendo, le dijo: ¿Ves estos grandes edificios? no quedará piedra sobre piedra que no sea derribada.", "words": [[0, 8154], [2, 8262], [8, 8869], [22, 9475], [25, 10082], [31, 10947], [36, 11395], [42, 11835], [50, 12315], [61, 13734], [64, 13904], [72, 14324], [79, 14864], [85, 15144], [92, 15704], [96, 15824], [99, 16004], [103, 16224]]}, {"verse": 3, "start": 17538, "end": 26347, "text": "Y sentándose en el monte de los Olivos delante del templo, le preguntaron aparte Pedro y Jacobo y Juan y Andrés:", "words": [[0, 17538], [2, 17675], [13, 18475], [16, 18675], [19, 18815], [25, 19135], [28, 19355], [32, 19475], [39, 19935], [47, 20415], [51, 20655], [59, 21755], [62, 21895], [74, 22395], [81, 22895], [87, 23435], [89, 23735], [96, 24335], [98, 24495], [103, 24795], [105, 25035]]}, {"verse": 4, "start": 26597, "end": 32112, "text": "Dinos, ¿cuándo serán estas cosas? ¿y qué señal habrá cuando todas estas cosas han de cumplirse?", "words": [[0, 26597], [7, 26832], [15, 27312], [21, 27632], [27, 27812], [34, 28818], [37, 28925], [41, 29065], [47, 29525], [53, 29805], [60, 29965], [66, 30305], [72, 30645], [78, 31045], [82, 31325], [85, 31445]]}, {"verse": 5, "start": 32462, "end": 38279, "text": "Y Jesús respondiéndoles, comenzó a decir: Mirad, que nadie os engañe;", "words": [[0, 32462], [2, 32585], [8, 32985], [25, 34585], [33, 35485], [35, 35585], [42, 36385], [49, 36845], [53, 37205], [59, 37445], [62, 37705]]}, {"verse": 6, "start": 38729, "end": 44907, "text": "Porque vendrán muchos en mi nombre, diciendo: Yo soy el Cristo; y engañarán a muchos.", "words": [[0, 38729], [7, 38913], [15, 39453], [22, 39913], [25, 40213], [28, 40353], [36, 40653], [46, 41753], [49, 41849], [53, 42009], [56, 42229], [64, 43210], [66, 43430], [76, 44150], [78, 44210]]}, {"verse": 7, "start": 45357, "end": 55450, "text": "Pero cuando oigáis de guerras y de rumores de guerras no os turbéis, porque conviene hacerse así; pero aún no será el fin.", "words": [[0, 45357], [5, 45499], [12, 45859], [19, 46599], [22, 46819], [30, 47319], [32, 47559], [35, 47679], [43, 48279], [46, 48439], [54, 49359], [57, 49759], [60, 49939], [69, 50519], [76, 51119], [85, 51859], [93, 52639], [98, 53446], [103, 53588], [107, 53988], [110, 54488], [115, 54728], [118, 54908]]}, {"verse": 8, "start": 55900, "end": 68705, "text": "Porque se levantará nación contra nación, y reino contra reino; y habrá terremotos en muchos lugares, y habrá hambres y alborotos; estos serán el principio de los dolores de parto.", "words": [[0, 55900], [7, 56084], [10, 56304], [20, 56924], [27, 57344], [34, 57784], [42, 58404], [44, 58934], [50, 59464], [57, 59824], [64, 60884], [66, 60988], [72, 61288], [83, 62028], [86, 62208], [93, 62508], [102, 63068], [104, 63608], [110, 63978], [118, 64348], [120, 64548], [131, 65714], [137, 66161], [143, 66601], [146, 66721], [156, 67261], [159, 67521], [163, 67641], [171, 68041], [174, 68141]]}, {"verse": 9, "start": 69155, "end": 83776, "text": "Pero mirad por vosotros mismos: porque os entregarán en los tribunales, y en sinagogas seréis azotados: y delante de gobernadores y de reyes compareceréis por causa de mí, en testimonio a ellos.", "words": [[0, 69155], [5, 69322], [11, 69722], [15, 69882], [24, 70342], [32, 71315], [39, 71557], [42, 71737], [53, 72497], [56, 72597], [60, 72757], [72, 73497], [74, 74077], [77, 74237], [87, 75137], [94, 75797], [104, 77149], [106, 77412], [114, 77892], [117, 78052], [130, 78872], [132, 79252], [135, 79632], [141, 80012], [155, 80832], [159, 81072], [165, 81412], [168, 81692], [172, 81912], [175, 82372], [186, 83112], [188, 83252]]}, {"verse": 10, "start": 84226, "end": 88465, "text": "Y a todas las naciones conviene que el evangelio sea predicado antes.", "words": [[0, 84226], [2, 84387], [4, 84467], [10, 84707], [14, 84967], [23, 85407], [32, 85927], [36, 86107], [39, 86227], [49, 86887], [53, 87347], [63, 87807]]}, {"verse": 11, "start": 88915, "end": 104227, "text": "Y cuando os traigan para entregaros, no premeditéis qué habéis de decir, ni lo penséis: sino lo que os sea dado en aquella hora, eso hablad; porque no sois vosotros los que habláis, sino el Espíritu Santo.", "words": [[0, 88915], [2, 89178], [9, 89288], [12, 89398], [20, 90078], [25, 90338], [37, 91458], [40, 91558], [52, 92358], [56, 92498], [63, 92918], [66, 93098], [73, 93838], [76, 93998], [79, 94138], [88, 95243], [93, 95545], [96, 95785], [100, 95905], [103, 96085], [107, 96285], [112, 96605], [115, 96745], [123, 97085], [129, 97690], [133, 98295], [141, 99125], [148, 99332], [151, 99572], [156, 100052], [165, 100772], [169, 101072], [173, 101272], [182, 101752], [187, 102332], [190, 102892], [199, 103612]]}, {"verse": 12, "start": 104677, "end": 113768, "text": "Y entregará a la muerte el hermano al hermano, y el padre al hijo: y se levantarán los hijos contra los padres, y los matarán.", "words": [[0, 104677], [2, 104805], [12, 105585], [14, 105725], [17, 105825], [24, 106225], [27, 106525], [35, 107105], [38, 107225], [47, 108285], [49, 108585], [52, 108725], [58, 109185], [61, 109365], [67, 110115], [69, 110223], [72, 110323], [83, 110963], [87, 111103], [93, 111363], [100, 111703], [104, 111883], [112, 112283], [114, 112843], [118, 112983]]}, {"verse": 13, "start": 114218, "end": 121231, "text": "Y seréis aborrecidos de todos por mi nombre: pero el que persevere hasta el fin, este será salvo.", "words": [[0, 114218], [2, 114327], [9, 114787], [21, 115627], [24, 115807], [30, 116107], [34, 116407], [37, 116587], [45, 117456], [50, 117599], [53, 117779], [57, 117899], [67, 118659], [73, 118859], [76, 119039], [81, 120079], [86, 120279], [91, 120599]]}, {"verse": 14, "start": 121681, "end": 135024, "text": "Pero cuando veáis la abominación desoladora de que habló el profeta Daniel, puesta donde no debe estar (el que lee, entienda), entonces los que estén en Judea huyan a los montes;", "words": [[0, 121681], [5, 121825], [12, 122125], [18, 122585], [21, 122805], [33, 123705], [44, 124605], [47, 124825], [51, 124985], [57, 125285], [60, 125385], [68, 125865], [76, 126545], [83, 127225], [89, 127545], [92, 127905], [97, 128165], [103, 128605], [107, 129125], [111, 129285], [116, 130125], [127, 131126], [136, 131629], [140, 132229], [144, 132409], [150, 132829], [153, 133009], [159, 133609], [165, 134029], [167, 134129], [171, 134269]]}, {"verse": 15, "start": 135474, "end": 142252, "text": "Y el que esté sobre la azotea, no descienda a la casa, ni entre para tomar algo de su casa;", "words": [[0, 135474], [2, 135602], [5, 135702], [9, 135862], [14, 136102], [20, 136502], [23, 136742], [31, 137982], [34, 138262], [44, 138822], [46, 138962], [49, 139042], [55, 139402], [58, 140082], [64, 140402], [69, 140642], [75, 141002], [80, 141382], [83, 141562], [86, 141682]]}, {"verse": 16, "start": 142702, "end": 146899, "text": "Y el que esté en el campo, no vuelva atrás a tomar su capa.", "words": [[0, 142702], [2, 142841], [5, 142961], [9, 143101], [14, 143341], [17, 143521], [20, 143601], [27, 144681], [30, 144991], [37, 145301], [43, 145581], [45, 145821], [51, 146081], [54, 146341]]}, {"verse": 17, "start": 147349, "end": 153175, "text": "Pero ¡ay de las embarazadas y de las que estén amamantando en aquellos días!", "words": [[0, 147349], [5, 147724], [9, 148134], [12, 148494], [16, 148654], [28, 149674], [30, 150154], [33, 150274], [37, 150434], [41, 150574], [47, 150934], [59, 152014], [62, 152134], [71, 152374]]}, {"verse": 18, "start": 153625, "end": 157474, "text": "Orad pues, que no acontezca vuestra huida en invierno.", "words": [[0, 153803], [5, 154013], [11, 154273], [15, 154593], [18, 155143], [28, 155693], [36, 156133], [42, 156573], [45, 156713]]}, {"verse": 19, "start": 157924, "end": 166634, "text": "Porque aquellos días serán de aflicción, cual nunca fue desde el principio de la creación que Dios creó, hasta este tiempo, ni será.", "words": [[0, 157924], [7, 158204], [16, 158524], [21, 158864], [27, 159264], [30, 159384], [41, 160004], [46, 160564], [52, 160884], [56, 161264], [62, 161544], [65, 161724], [75, 162344], [78, 162644], [81, 162784], [90, 163364], [94, 163564], [99, 163804], [105, 164384], [111, 164944], [116, 165164], [124, 165964], [127, 166144]]}, {"verse": 20, "start": 167084, "end": 176749, "text": "Y si el Señor no hubiese abreviado aquellos días, nadie sobreviviría; pero por causa de los escogidos a quienes eligió, acortó aquellos días.", "words": [[0, 167084], [2, 167207], [5, 167367], [8, 167507], [14, 167787], [17, 168067], [25, 168407], [35, 169027], [44, 169247], [50, 170167], [56, 170467], [70, 172039], [75, 172421], [79, 172581], [85, 172881], [88, 173121], [92, 173241], [102, 173821], [104, 173981], [112, 174121], [120, 175261], [127, 175801], [136, 176041]]}, {"verse": 21, "start": 177199, "end": 185874, "text": "Y entonces si alguno os dice: Mirad, aquí está el Cristo» o «Mirad, allí está», no lo creáis.", "words": [[0, 177199], [2, 177340], [11, 177740], [14, 178320], [21, 178580], [24, 178840], [30, 179731], [37, 180137], [42, 180477], [47, 180797], [50, 180937], [58, 182237], [60, 182357], [68, 183057], [73, 183737], [80, 184617], [83, 184857], [86, 185017]]}, {"verse": 22, "start": 186324, "end": 196417, "text": "Porque se levantarán falsos Cristos y falsos profetas, y darán señales y prodigios, para engañar, si se pudiese hacer, aun a los escogidos.", "words": [[0, 186324], [7, 186529], [10, 186689], [21, 187329], [28, 187849], [36, 188349], [38, 188449], [45, 188849], [55, 189349], [57, 189869], [63, 190269], [71, 190909], [73, 191029], [84, 191869], [89, 192369], [98, 193169], [101, 193669], [104, 193829], [112, 194309], [119, 194769], [123, 195129], [125, 195389], [129, 195529]]}, {"verse": 23, "start": 196867, "end": 200448, "text": "Pero vosotros mirad; os lo he dicho antes todo.", "words": [[0, 196867], [5, 197127], [14, 197767], [21, 198493], [24, 198703], [27, 198983], [30, 199103], [36, 199363], [42, 199823]]}, {"verse": 24, "start": 200898, "end": 210228, "text": "Pero en aquellos días, después de aquella aflicción, el sol se oscurecerá, y la luna no dará su resplandor;", "words": [[0, 200898], [5, 201064], [8, 201244], [17, 201484], [23, 202664], [31, 203104], [34, 203344], [42, 203704], [53, 205044], [56, 205324], [60, 205624], [63, 205864], [75, 206804], [77, 207244], [80, 207384], [85, 207704], [88, 208404], [93, 208844], [96, 209566]]}, {"verse": 25, "start": 210678, "end": 216203, "text": "Y las estrellas caerán del cielo, y los poderes que están en los cielos serán conmovidos;", "words": [[0, 210678], [2, 210775], [6, 210915], [16, 211535], [23, 212015], [27, 212195], [34, 212635], [36, 213055], [40, 213195], [48, 213715], [52, 213795], [58, 214075], [61, 214215], [65, 214375], [72, 214915], [78, 215275]]}, {"verse": 26, "start": 216653, "end": 223556, "text": "Y entonces verán al Hijo del hombre, que vendrá en las nubes con gran poder y gloria.", "words": [[0, 216653], [2, 216910], [11, 217410], [17, 218310], [20, 218470], [25, 218730], [29, 218970], [37, 219730], [41, 220270], [48, 220810], [51, 221070], [55, 221210], [61, 221770], [65, 221970], [70, 222250], [76, 222670], [78, 222910]]}, {"verse": 27, "start": 224006, "end": 233698, "text": "Y entonces enviará sus ángeles, y reunirá a sus escogidos de los cuatro vientos, desde el extremo de la tierra hasta el extremo del cielo.", "words": [[0, 224006], [2, 224171], [11, 224591], [19, 225531], [23, 225671], [32, 226311], [34, 226951], [42, 227751], [44, 227791], [48, 227931], [58, 228631], [61, 228771], [65, 228871], [72, 229111], [81, 229771], [87, 230271], [90, 230491], [98, 231051], [101, 231111], [104, 231231], [111, 231611], [117, 232191], [120, 232351], [128, 232931], [132, 233031]]}, {"verse": 28, "start": 234148, "end": 243720, "text": "De la higuera aprended la semejanza: Cuando su rama ya se pone tierna, y brota hojas, conocéis que el verano está cerca:", "words": [[0, 234148], [3, 234254], [6, 234414], [14, 235184], [23, 235954], [26, 236414], [37, 237704], [44, 237920], [47, 238160], [52, 238520], [55, 238680], [58, 238820], [63, 239080], [71, 239800], [73, 240180], [79, 240540], [86, 241300], [95, 242000], [99, 242260], [102, 242420], [109, 242780], [114, 242980]]}, {"verse": 29, "start": 244170, "end": 251290, "text": "Así también vosotros, cuando veáis que suceden estas cosas, conoced que está cerca, a las puertas.", "words": [[0, 244170], [4, 244430], [12, 244790], [22, 245850], [29, 246050], [35, 246570], [39, 246750], [47, 247390], [53, 247570], [60, 248280], [68, 248990], [72, 249190], [77, 249430], [84, 249870], [86, 250410], [90, 250530]]}, {"verse": 30, "start": 251740, "end": 257698, "text": "De cierto os digo que no pasará esta generación hasta que todas estas cosas sean hechas.", "words": [[0, 251740], [3, 251903], [10, 252183], [13, 252523], [18, 252803], [22, 253023], [25, 253243], [32, 253723], [37, 254003], [48, 254863], [54, 255423], [58, 255623], [64, 255863], [70, 256243], [76, 256643], [81, 257023]]}, {"verse": 31, "start": 258148, "end": 262702, "text": "El cielo y la tierra pasarán, pero mis palabras no pasarán.", "words": [[0, 258148], [3, 258276], [9, 258816], [11, 259216], [14, 259356], [21, 259656], [30, 260656], [35, 260916], [39, 261076], [48, 261476], [51, 261836]]}, {"verse": 32, "start": 263152, "end": 271110, "text": "Pero de aquel día y de la hora, nadie sabe; ni aun los ángeles que están en el cielo, ni el Hijo, sino el Padre.", "words": [[0, 263152], [5, 263294], [8, 263514], [14, 263834], [18, 264074], [20, 264234], [23, 264334], [26, 264494], [32, 264754], [38, 265554], [44, 266638], [47, 266787], [51, 267027], [55, 267307], [63, 267867], [67, 268047], [73, 268287], [76, 268487], [79, 268627], [86, 268967], [89, 269287], [92, 269447], [98, 270087], [103, 270287], [106, 270507]]}, {"verse": 33, "start": 271560, "end": 276074, "text": "Mirad, velad y orad: porque no sabéis cuándo será el tiempo.", "words": [[0, 271560], [7, 271967], [13, 272427], [15, 272727], [21, 273540], [28, 273742], [31, 273962], [38, 274442], [45, 275002], [50, 275242], [53, 275442]]}, {"verse": 34, "start": 276524, "end": 286901, "text": "Como un hombre que se fue lejos, dejó su casa, y dio autoridad a sus siervos, y a cada uno su obra, y al portero mandó que velase:", "words": [[0, 276524], [5, 276688], [8, 276908], [15, 277248], [19, 277428], [22, 277568], [26, 277788], [33, 278368], [38, 279288], [41, 279468], [47, 279888], [49, 280688], [53, 280968], [63, 281688], [65, 281848], [69, 282028], [78, 282668], [80, 283068], [82, 283148], [87, 283348], [91, 283648], [94, 283868], [100, 284308], [102, 284868], [105, 284988], [113, 285608], [119, 286048], [123, 286506]]}, {"verse": 35, "start": 287351, "end": 297915, "text": "Velad pues, porque no sabéis cuándo el señor de la casa vendrá; si a la tarde, o a la media noche, o al canto del gallo, o a la mañana;", "words": [[0, 287596], [6, 287876], [12, 288436], [19, 288996], [22, 289116], [29, 289536], [36, 289816], [39, 290096], [45, 290436], [48, 290656], [51, 290796], [56, 291096], [64, 292196], [67, 292532], [69, 292632], [72, 292732], [79, 293792], [81, 293832], [83, 293932], [86, 294359], [92, 294785], [99, 295212], [101, 295252], [104, 295392], [110, 295792], [114, 296342], [121, 296892], [123, 296952], [125, 297092], [128, 297192]]}, {"verse": 36, "start": 298365, "end": 302478, "text": "Porque cuando venga de repente, no os halle durmiendo.", "words": [[0, 298365], [7, 298587], [14, 298887], [20, 299367], [23, 299507], [32, 300587], [35, 300847], [38, 301277], [44, 301707]]}, {"verse": 37, "start": 302928, "end": 307180, "text": "Y las cosas que a vosotros digo, a todos las digo: Velad.", "words": [[0, 302928], [2, 303036], [6, 303176], [12, 303496], [16, 303736], [18, 303836], [27, 304236], [33, 305116], [35, 305196], [41, 305536], [45, 305776], [51, 306889]]}]}