{"book": "MAT", "chapter": 20, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 278101, "verses": [{"verse": 1, "start": 300, "end": 8476, "text": "Porque el reino de los cielos es semejante a un propietario, que salió por la mañana a contratar trabajadores para su viña.", "words": [[0, 300], [7, 522], [10, 702], [16, 1082], [19, 1202], [23, 1362], [30, 1882], [33, 2082], [43, 2862], [45, 2982], [48, 3122], [61, 4082], [65, 4307], [71, 4727], [75, 4947], [78, 5147], [85, 5547], [87, 5887], [97, 6607], [110, 7387], [115, 7687], [118, 7867]]}, {"verse": 2, "start": 8826, "end": 14747, "text": "Y habiendo acordado con los obreros en un denario al día, los envió a su viña.", "words": [[0, 8826], [2, 8968], [11, 9348], [20, 10028], [24, 10228], [28, 10648], [36, 11068], [39, 11288], [42, 11428], [50, 11948], [53, 12168], [58, 13088], [62, 13348], [68, 13828], [70, 13968], [73, 14088]]}, {"verse": 3, "start": 15097, "end": 21657, "text": "Y saliendo cerca de la tercera hora del día, vio otros que estaban en la plaza ociosos;", "words": [[0, 15097], [2, 15521], [11, 16001], [17, 16341], [20, 16621], [23, 16741], [31, 17321], [36, 17601], [40, 17841], [45, 18701], [49, 19061], [55, 19521], [59, 19921], [67, 20281], [70, 20481], [73, 20601], [79, 20901]]}, {"verse": 4, "start": 22007, "end": 27990, "text": "Y les dijo: Id también vosotros a mi viña, y os daré lo que sea justo. Y ellos fueron.", "words": [[0, 22007], [2, 22276], [6, 22580], [12, 23086], [15, 23166], [23, 23466], [32, 24106], [34, 24306], [37, 24426], [43, 24846], [45, 25246], [48, 25386], [53, 25646], [56, 25726], [60, 25866], [64, 26026], [71, 26921], [73, 27087], [79, 27247]]}, {"verse": 5, "start": 28340, "end": 33027, "text": "Salió otra vez cerca de las horas sexta y novena, e hizo lo mismo.", "words": [[0, 28340], [6, 28762], [11, 29082], [15, 29342], [21, 29762], [24, 30002], [28, 30162], [34, 30362], [40, 31002], [42, 31102], [50, 31662], [52, 31942], [57, 32302], [60, 32502]]}, {"verse": 6, "start": 33377, "end": 42153, "text": "Y saliendo cerca de la hora undécima, halló otros que estaban ociosos; y les dice: ¿Por qué estáis aquí todo el día ociosos?", "words": [[0, 33377], [2, 33506], [11, 34006], [17, 34346], [20, 34606], [23, 34746], [28, 35257], [38, 35768], [44, 36121], [50, 36541], [54, 36821], [62, 37201], [71, 38542], [73, 38668], [77, 38788], [83, 39589], [88, 39711], [92, 40031], [99, 40351], [104, 40671], [109, 40771], [112, 41031], [116, 41191]]}, {"verse": 7, "start": 42503, "end": 50864, "text": "Le dicen: Porque nadie nos ha contratado. Les dice: Id también vosotros a la viña, y recibiréis lo que sea justo.", "words": [[0, 42503], [3, 42668], [10, 43536], [17, 43796], [23, 44156], [27, 44416], [30, 44556], [42, 45751], [46, 45841], [52, 46720], [55, 46820], [63, 47080], [72, 47740], [74, 47940], [77, 48020], [83, 48540], [85, 48980], [96, 49760], [99, 49920], [103, 50040], [107, 50220]]}, {"verse": 8, "start": 51214, "end": 62053, "text": "Y cuando fue la tarde del día, el señor de la viña dijo a su encargado: Llama a los obreros y págales el salario, comenzando desde los últimos hasta los primeros.", "words": [[0, 51214], [2, 51504], [9, 51664], [13, 51884], [16, 52024], [22, 52344], [26, 52664], [31, 53384], [34, 53504], [40, 53824], [43, 54004], [46, 54124], [51, 54584], [56, 55184], [58, 55404], [61, 55524], [72, 56603], [78, 56909], [80, 57129], [84, 57459], [92, 57789], [94, 57949], [102, 58529], [105, 58689], [114, 59409], [125, 60129], [131, 60309], [135, 60529], [143, 60889], [149, 61189], [153, 61369]]}, {"verse": 9, "start": 62403, "end": 68578, "text": "Y viniendo los que habían ido cerca de la hora undécima, recibieron cada uno un denario.", "words": [[0, 62403], [2, 62501], [11, 62981], [15, 63181], [19, 63341], [26, 63641], [30, 63881], [36, 64321], [39, 64601], [42, 64741], [47, 65401], [57, 66060], [68, 66761], [73, 67041], [77, 67420], [80, 67741]]}, {"verse": 10, "start": 68928, "end": 77645, "text": "Y viniendo también los primeros, pensaron que habían de recibir más; pero también ellos recibieron cada uno un denario.", "words": [[0, 68928], [2, 69175], [11, 69455], [19, 69815], [23, 70055], [33, 71015], [42, 71855], [46, 72095], [53, 72415], [56, 72635], [64, 73055], [69, 74042], [74, 74282], [82, 74702], [88, 75062], [99, 76082], [104, 76342], [108, 76642], [111, 76842]]}, {"verse": 11, "start": 77995, "end": 81662, "text": "Y tomándolo, murmuraban contra el padre de la familia,", "words": [[0, 77995], [2, 78073], [13, 78673], [24, 79493], [31, 79893], [34, 80113], [40, 80453], [43, 80713], [46, 80833]]}, {"verse": 12, "start": 82012, "end": 91458, "text": "Diciendo: Estos últimos sólo han trabajado una hora, y los has hecho iguales a nosotros, que hemos llevado la carga y el calor del día.", "words": [[0, 82012], [10, 83216], [16, 83638], [24, 84018], [29, 84418], [33, 84638], [43, 85298], [47, 85578], [53, 85918], [55, 86133], [59, 86293], [63, 86513], [69, 86973], [77, 87713], [79, 87833], [89, 88253], [93, 88793], [99, 88953], [107, 89393], [110, 89573], [116, 89953], [118, 90173], [121, 90293], [127, 90613], [131, 90893]]}, {"verse": 13, "start": 91458, "end": 99269, "text": "Y él respondiendo, dijo a uno de ellos: Amigo, no cometo injusticia contigo; ¿no te concertaste conmigo por un denario?", "words": [[0, 91458], [2, 91718], [5, 91858], [19, 92618], [24, 92898], [26, 93118], [30, 93298], [33, 93458], [40, 94242], [47, 94652], [50, 94752], [57, 95272], [68, 95932], [77, 96940], [81, 97026], [84, 97146], [96, 97766], [104, 98206], [108, 98446], [111, 98586]]}, {"verse": 14, "start": 99619, "end": 103808, "text": "Toma lo que es tuyo, y vete; pero quiero dar a este último, como a ti.", "words": [[0, 99619], [5, 99824], [8, 99964], [12, 100084], [15, 100244], [21, 100584], [23, 100784], [29, 101474], [34, 101598], [41, 101878], [45, 102158], [47, 102318], [52, 102718], [60, 103118], [65, 103318], [67, 103498]]}, {"verse": 15, "start": 104158, "end": 110791, "text": "¿No me es lícito a mí hacer lo que quiero con lo mío? o ¿es malo tu ojo, porque yo soy bueno?", "words": [[0, 104158], [4, 104323], [7, 104503], [10, 104683], [17, 105243], [19, 105443], [22, 105563], [28, 105863], [31, 106103], [35, 106243], [42, 106523], [46, 106723], [49, 106883], [54, 107597], [56, 107851], [60, 107971], [65, 108451], [68, 108611], [73, 109411], [80, 109751], [83, 109971], [87, 110171]]}, {"verse": 16, "start": 111141, "end": 119429, "text": "Así los primeros serán últimos, y los últimos primeros: porque muchos son llamados, pero pocos escogidos.", "words": [[0, 111141], [4, 111340], [8, 111540], [17, 112240], [23, 112860], [32, 113420], [34, 114060], [38, 114240], [46, 114660], [56, 115817], [63, 116060], [70, 116520], [74, 117000], [84, 117720], [89, 117980], [95, 118455]]}, {"verse": 17, "start": 119779, "end": 125710, "text": "Y subiendo Jesús a Jerusalén, tomó sus doce discípulos aparte en el camino, y les dijo:", "words": [[0, 119779], [2, 119884], [11, 120344], [17, 120704], [19, 120964], [30, 122044], [35, 122324], [39, 122524], [44, 123024], [55, 123744], [62, 124344], [65, 124444], [68, 124564], [76, 124924], [78, 125084], [82, 125204]]}, {"verse": 18, "start": 126060, "end": 136084, "text": "He aquí subimos a Jerusalén, y el Hijo del hombre será entregado a los príncipes de los sacerdotes y a los escribas, y le condenarán a muerte;", "words": [[0, 126111], [3, 126201], [8, 126421], [16, 126981], [18, 127121], [29, 128121], [31, 128401], [34, 128521], [39, 128801], [43, 128941], [50, 129381], [55, 129621], [65, 130361], [67, 130441], [71, 130561], [81, 131341], [84, 131461], [88, 131601], [99, 132441], [101, 132821], [103, 132881], [107, 133001], [117, 134281], [119, 134381], [122, 134501], [133, 135301], [135, 135441]]}, {"verse": 19, "start": 136434, "end": 145807, "text": "Y le entregarán a los Gentiles para que se burlen de él, lo azoten y lo crucifiquen; pero al tercer día resucitará.", "words": [[0, 136434], [2, 136558], [5, 136678], [16, 137378], [18, 137458], [22, 137578], [31, 138198], [36, 138738], [40, 138898], [43, 139078], [50, 139538], [53, 139738], [57, 140578], [60, 140928], [67, 141278], [69, 141978], [72, 142518], [85, 143278], [90, 143578], [93, 143778], [100, 144078], [104, 144518]]}, {"verse": 20, "start": 146157, "end": 153750, "text": "Entonces se llegó a él la madre de los hijos de Zebedeo con sus hijos, adorándole, y pidiéndole algo.", "words": [[0, 146157], [9, 146599], [12, 146919], [18, 147239], [20, 147519], [23, 147999], [26, 148079], [32, 148439], [35, 148639], [39, 148779], [45, 149099], [48, 149579], [56, 150059], [60, 150159], [64, 150399], [71, 151199], [83, 152019], [85, 152459], [96, 153159]]}, {"verse": 21, "start": 154100, "end": 164140, "text": "Y él le dijo: ¿Qué quieres? Ella le dijo: Di que se sienten estos dos hijos míos, el uno a tu mano derecha, y el otro a tu izquierda, en tu reino.", "words": [[0, 154100], [2, 154269], [5, 154389], [8, 154529], [14, 155184], [19, 155308], [28, 156107], [33, 156331], [36, 156531], [42, 157906], [45, 157956], [49, 158056], [52, 158196], [60, 158716], [66, 158976], [70, 159256], [76, 159496], [82, 160276], [85, 160416], [89, 160636], [91, 160776], [94, 160856], [99, 161056], [108, 161716], [110, 162036], [113, 162156], [118, 162356], [120, 162496], [123, 162596], [134, 163416], [137, 163496], [140, 163636]]}, {"verse": 22, "start": 164420, "end": 177328, "text": "Entonces Jesús respondiendo, dijo: No sabéis lo que pedís: ¿podéis beber la copa que yo he de beber, y ser bautizados del bautismo de que yo soy bautizado? Y ellos le dicen: Podemos.", "words": [[0, 164420], [9, 164929], [15, 166029], [29, 166849], [35, 167494], [38, 167683], [45, 168203], [48, 168383], [52, 168523], [59, 169356], [67, 169660], [73, 169940], [76, 170200], [81, 170580], [85, 170680], [88, 170880], [91, 171000], [94, 171120], [101, 171400], [103, 171800], [107, 172000], [118, 172740], [122, 172940], [131, 173540], [134, 173700], [138, 173820], [141, 173980], [145, 174180], [156, 175315], [158, 175425], [164, 175625], [167, 175845], [174, 176663]]}, {"verse": 23, "start": 177608, "end": 194756, "text": "Y él les dice: A la verdad mi copa beberéis, y del bautismo de que yo soy bautizado, seréis bautizados; pero el sentaros a mi mano derecha y a mi izquierda, no es mío darlo, sino a aquellos para quienes está preparado por mi Padre.", "words": [[0, 177608], [2, 177813], [5, 177993], [9, 178293], [15, 179155], [17, 179259], [20, 179339], [27, 179862], [30, 179994], [35, 180334], [45, 180914], [47, 181434], [51, 181594], [60, 182214], [63, 182394], [67, 182514], [70, 182694], [74, 182914], [85, 184014], [92, 184434], [104, 185869], [109, 186035], [112, 186195], [121, 186775], [123, 186955], [126, 187075], [131, 187295], [139, 187875], [141, 188055], [143, 188115], [146, 188235], [157, 188995], [160, 189615], [163, 189735], [167, 190015], [174, 190935], [179, 191255], [181, 191615], [190, 191995], [195, 192415], [203, 192695], [208, 193095], [218, 193735], [222, 193935], [225, 194115]]}, {"verse": 24, "start": 195106, "end": 199766, "text": "Y como los diez oyeron esto, se enojaron de los dos hermanos.", "words": [[0, 195106], [2, 195207], [7, 195407], [11, 195587], [16, 195847], [23, 196627], [29, 197347], [32, 197647], [41, 198327], [44, 198467], [48, 198627], [52, 198827]]}, {"verse": 25, "start": 200116, "end": 210411, "text": "Entonces Jesús llamándolos, dijo: Sabéis que los príncipes de los Gentiles los dominan, y los que son grandes ejercen autoridad sobre ellos.", "words": [[0, 200116], [9, 200657], [15, 201737], [28, 202397], [34, 203186], [41, 203696], [45, 203876], [49, 204036], [59, 204756], [62, 204916], [66, 205016], [75, 205556], [79, 205776], [88, 206436], [90, 206796], [94, 206936], [98, 207056], [102, 207256], [110, 207696], [118, 208536], [128, 209356], [134, 209816]]}, {"verse": 26, "start": 210761, "end": 218630, "text": "Pero entre vosotros no será así; sino que el que quiera hacerse grande entre vosotros será vuestro servidor;", "words": [[0, 210761], [5, 210925], [11, 211185], [20, 211905], [23, 212525], [28, 212805], [33, 213558], [38, 213798], [42, 214098], [45, 214358], [49, 214538], [56, 214858], [64, 215338], [71, 215758], [77, 216058], [86, 216738], [91, 217258], [99, 217778]]}, {"verse": 27, "start": 218980, "end": 223242, "text": "Y el que quiera ser el primero entre vosotros, será vuestro siervo:", "words": [[0, 218980], [2, 219104], [5, 219204], [9, 219324], [16, 219624], [20, 219924], [23, 220064], [31, 220444], [37, 220684], [47, 221344], [52, 221944], [60, 222604]]}, {"verse": 28, "start": 223592, "end": 231344, "text": "Como el Hijo del hombre no vino para ser servido, sino para servir, y para dar su vida en rescate por muchos.", "words": [[0, 223592], [5, 223756], [8, 223916], [13, 224176], [17, 224336], [24, 224896], [27, 225176], [32, 225416], [37, 225696], [41, 225976], [50, 226896], [55, 227176], [60, 227496], [68, 227976], [70, 228536], [75, 228776], [79, 229016], [82, 229296], [87, 229616], [90, 229776], [98, 230356], [102, 230576]]}, {"verse": 29, "start": 231694, "end": 237149, "text": "Entonces saliendo ellos de Jericó, le seguía una gran multitud.", "words": [[0, 231694], [9, 232757], [18, 233397], [24, 233697], [27, 233997], [35, 234937], [38, 235017], [45, 235557], [49, 235817], [54, 236117]]}, {"verse": 30, "start": 237499, "end": 249076, "text": "Y he aquí dos ciegos sentados junto al camino, cuando oyeron que Jesús pasaba, clamaron, diciendo: Señor, Hijo de David, ten misericordia de nosotros.", "words": [[0, 237499], [2, 237685], [5, 237825], [10, 238105], [14, 238325], [21, 238905], [30, 239685], [36, 240005], [39, 240285], [47, 241385], [54, 241705], [61, 242245], [65, 242405], [71, 242665], [79, 243865], [89, 244525], [99, 245934], [106, 246189], [111, 246509], [114, 246609], [121, 247389], [125, 247509], [138, 248289], [141, 248389]]}, {"verse": 31, "start": 249356, "end": 258271, "text": "Y la gente les reñía para que callasen; pero ellos clamaban más, diciendo: Señor, Hijo de David, ten misericordia de nosotros.", "words": [[0, 249356], [2, 249459], [5, 249579], [11, 249919], [15, 250279], [21, 251139], [26, 251339], [30, 251869], [40, 252620], [45, 252764], [51, 252964], [60, 253604], [65, 254004], [75, 255129], [82, 255384], [87, 255704], [90, 255804], [97, 256584], [101, 256704], [114, 257484], [117, 257584]]}, {"verse": 32, "start": 258551, "end": 264016, "text": "Y parándose Jesús, los llamó, y dijo: ¿Qué queréis que haga por vosotros?", "words": [[0, 258551], [2, 258673], [12, 259373], [19, 259833], [23, 260373], [30, 260933], [32, 261313], [38, 262001], [43, 262125], [51, 262505], [55, 262665], [60, 262885], [64, 263145]]}, {"verse": 33, "start": 264366, "end": 267956, "text": "Ellos le dicen: Señor, que sean abiertos nuestros ojos.", "words": [[0, 264366], [6, 264770], [9, 264890], [16, 265696], [23, 266195], [27, 266275], [32, 266475], [41, 267055], [50, 267235]]}, {"verse": 34, "start": 268236, "end": 277701, "text": "Entonces Jesús, teniendo misericordia de ellos, les tocó los ojos, y luego sus ojos recibieron la vista; y le siguieron.", "words": [[0, 268236], [9, 269018], [16, 269744], [25, 270470], [38, 271370], [41, 271510], [48, 272230], [52, 272370], [57, 272930], [61, 273170], [67, 273510], [69, 274210], [75, 274410], [79, 274670], [84, 274990], [95, 275710], [98, 275910], [105, 276717], [107, 276840], [110, 276920]]}]}