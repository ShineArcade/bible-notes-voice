{"book": "PSA", "chapter": 137, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 67465, "verses": [{"verse": 1, "start": 300, "end": 7221, "text": "Junto a los ríos de Babilonia, allí nos sentábamos, y aun llorábamos, acordándonos de Sion.", "words": [[0, 300], [6, 544], [8, 784], [12, 884], [17, 1244], [20, 1344], [31, 2044], [36, 2544], [40, 2744], [52, 3584], [54, 3984], [58, 4244], [70, 5344], [83, 6344], [86, 6544]]}, {"verse": 2, "start": 7671, "end": 11925, "text": "Sobre los sauces en medio de ella colgamos nuestras arpas.", "words": [[0, 7671], [6, 7994], [10, 8254], [17, 8914], [20, 9254], [26, 9574], [29, 9834], [34, 10054], [43, 10734], [52, 10974]]}, {"verse": 3, "start": 12375, "end": 21570, "text": "Y los que allí nos habían llevado cautivos nos pedían que cantásemos, y los que nos habían desolado nos pedían alegría, diciendo:", "words": [[0, 12375], [2, 12499], [6, 12659], [10, 12859], [15, 13079], [19, 13299], [26, 13639], [34, 14119], [43, 14879], [47, 15479], [54, 15939], [58, 16649], [70, 17359], [72, 17699], [76, 17839], [80, 17959], [84, 18079], [91, 18419], [100, 19079], [104, 19239], [111, 19719], [120, 20499]]}, {"verse": 4, "start": 21820, "end": 28225, "text": "Cantadnos algunos de los himnos de Sion. ¿Cómo cantaremos canción de Jehová en tierra de extraños?", "words": [[0, 21820], [10, 22365], [18, 22745], [21, 22965], [25, 23085], [32, 23525], [35, 23665], [41, 24509], [47, 24674], [58, 25334], [66, 25794], [69, 26154], [76, 26614], [79, 26754], [86, 27034], [89, 27334]]}, {"verse": 5, "start": 28675, "end": 33896, "text": "Si me olvido de ti, oh Jerusalén, mi diestra pierda su destreza.", "words": [[0, 28675], [3, 28833], [6, 28973], [13, 29393], [16, 29533], [20, 30113], [23, 30493], [34, 31793], [37, 31913], [45, 32313], [52, 32873], [55, 33073]]}, {"verse": 6, "start": 34346, "end": 44248, "text": "Mi lengua se pegue a mi paladar, si de ti no me acuerdo; si no ensalzo a Jerusalén como preferente asunto de mi alegría.", "words": [[0, 34346], [3, 34493], [10, 34973], [13, 35153], [19, 35573], [21, 35673], [24, 36173], [33, 36673], [36, 36933], [39, 37133], [42, 37413], [45, 37773], [48, 37913], [57, 38978], [60, 39112], [63, 39245], [71, 40245], [73, 40465], [83, 41525], [88, 41905], [99, 42645], [106, 43165], [109, 43405], [112, 43525]]}, {"verse": 7, "start": 44698, "end": 54239, "text": "Acuérdate, oh Jehová, de los hijos de Edom en el día de Jerusalén; quienes decían: Arrasadla, arrasadla hasta los cimientos.", "words": [[0, 44698], [11, 45380], [14, 46074], [22, 46767], [25, 46907], [29, 47027], [35, 47367], [38, 47667], [43, 48247], [46, 48527], [49, 48687], [53, 48947], [56, 49127], [67, 50379], [75, 50603], [83, 51713], [94, 52497], [104, 53097], [110, 53377], [114, 53517]]}, {"verse": 8, "start": 54589, "end": 61412, "text": "Hija de Babilonia destruida, bienaventurado el que te dé el pago de lo que tú nos hiciste.", "words": [[0, 54589], [5, 54953], [8, 55033], [18, 55593], [29, 56763], [44, 57933], [47, 58073], [51, 58213], [54, 58393], [57, 58593], [60, 58793], [65, 59393], [68, 59813], [71, 59953], [75, 60073], [78, 60273], [82, 60413]]}, {"verse": 9, "start": 61862, "end": 67065, "text": "Bienaventurado el que tomará y estrellará tus niños contra las piedras.", "words": [[0, 61862], [15, 62904], [18, 63064], [22, 63224], [29, 63764], [31, 64184], [42, 64944], [46, 65144], [52, 65624], [59, 66044], [63, 66264]]}]}