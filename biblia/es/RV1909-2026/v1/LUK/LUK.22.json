{"book": "LUK", "chapter": 22, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 504506, "verses": [{"verse": 1, "start": 300, "end": 5579, "text": "Y estaba cerca el día de la fiesta de los panes sin levadura, que se llama la Pascua.", "words": [[0, 300], [2, 385], [9, 665], [15, 1025], [18, 1305], [22, 1465], [25, 1625], [28, 1745], [35, 2125], [38, 2265], [42, 2385], [48, 2825], [52, 3185], [62, 4265], [66, 4385], [69, 4505], [75, 4765], [78, 4925]]}, {"verse": 2, "start": 5929, "end": 12924, "text": "Y los principales sacerdotes y los escribas buscaban cómo le matarían; pero tenían miedo del pueblo.", "words": [[0, 5929], [2, 5994], [6, 6134], [18, 6794], [29, 7594], [31, 7774], [35, 7894], [44, 8514], [53, 9334], [58, 9654], [61, 9794], [71, 10828], [76, 11192], [83, 11532], [89, 11972], [93, 12192]]}, {"verse": 3, "start": 13274, "end": 20502, "text": "Y entró Satanás en Judas, por sobrenombre Iscariote, el cual era uno del número de los doce;", "words": [[0, 13274], [2, 13436], [8, 13856], [16, 14416], [19, 14556], [26, 15616], [30, 15736], [42, 16696], [53, 18016], [56, 18116], [61, 18336], [65, 18596], [69, 18856], [73, 19056], [80, 19456], [83, 19676], [87, 19836]]}, {"verse": 4, "start": 20852, "end": 27441, "text": "Y fue, y habló con los principales sacerdotes, y con los jefes de la guardia, de cómo se lo entregaría.", "words": [[0, 20852], [2, 21016], [7, 21196], [9, 21476], [15, 21836], [19, 21956], [23, 22076], [35, 22876], [47, 23816], [49, 24021], [53, 24181], [57, 24321], [63, 24721], [66, 24801], [69, 24901], [78, 25801], [81, 25881], [86, 26121], [89, 26381], [92, 26501]]}, {"verse": 5, "start": 27792, "end": 31311, "text": "Los cuales se alegraron, y acordaron darle dinero.", "words": [[0, 27792], [4, 27900], [11, 28160], [14, 28460], [25, 29180], [27, 29680], [37, 30280], [43, 30520]]}, {"verse": 6, "start": 31661, "end": 38791, "text": "Y prometió, y buscaba oportunidad para entregarle a ellos sin la multitud presente.", "words": [[0, 31661], [2, 31825], [12, 32945], [14, 33165], [22, 33645], [34, 34525], [39, 35025], [50, 35885], [52, 36005], [58, 36365], [62, 36945], [65, 37225], [74, 37785]]}, {"verse": 7, "start": 39141, "end": 45761, "text": "Y vino el día de los panes sin levadura, en el cual era necesario sacrificar el cordero de la Pascua.", "words": [[0, 39141], [2, 39246], [7, 39466], [10, 39646], [14, 39826], [17, 39966], [21, 40106], [27, 40546], [31, 40786], [41, 41806], [44, 41966], [47, 42086], [52, 42306], [56, 42686], [66, 43326], [77, 44166], [80, 44286], [88, 44826], [91, 44966], [94, 45066]]}, {"verse": 8, "start": 46111, "end": 51219, "text": "Y envió a Pedro y a Juan, diciendo: Id, preparadnos la pascua para que comamos.", "words": [[0, 46111], [2, 46238], [8, 46558], [10, 46658], [16, 46978], [18, 47218], [20, 47298], [26, 47658], [36, 48329], [40, 48459], [52, 49479], [55, 49619], [62, 50139], [67, 50319], [71, 50479]]}, {"verse": 9, "start": 51569, "end": 54839, "text": "Y ellos le dijeron: ¿Dónde quieres que preparemos?", "words": [[0, 51569], [2, 51717], [8, 52017], [11, 52357], [20, 53258], [27, 53544], [35, 53844], [39, 54024]]}, {"verse": 10, "start": 55119, "end": 64467, "text": "Y él les dijo: He aquí cuando entréis en la ciudad, os encontrará un hombre que lleva un cántaro de agua: seguidle hasta la casa donde entre,", "words": [[0, 55119], [2, 55315], [5, 55455], [9, 55655], [15, 56475], [18, 56555], [23, 56775], [30, 57055], [38, 57655], [41, 57815], [44, 57955], [52, 58315], [55, 58695], [66, 59415], [69, 59595], [76, 59835], [80, 60015], [86, 60275], [89, 60495], [97, 61055], [100, 61255], [106, 61952], [115, 62591], [121, 62931], [124, 63131], [129, 63371], [135, 63691]]}, {"verse": 11, "start": 64817, "end": 72998, "text": "Y decid al dueño de la casa: El Maestro te dice: ¿Dónde está el aposento donde tengo de comer la pascua con mis discípulos?", "words": [[0, 64817], [2, 64938], [8, 65258], [11, 65678], [17, 66078], [20, 66178], [23, 66298], [29, 67173], [32, 67324], [40, 67864], [43, 68044], [49, 68794], [56, 69182], [61, 69382], [64, 69542], [73, 70022], [79, 70262], [85, 70642], [88, 70802], [94, 71062], [97, 71392], [104, 71722], [108, 71862], [112, 72062]]}, {"verse": 12, "start": 73348, "end": 79471, "text": "Entonces él os mostrará una gran sala amueblada en el piso de arriba; preparad allí.", "words": [[0, 73348], [9, 74034], [12, 74434], [15, 74679], [24, 75299], [28, 75459], [33, 75679], [38, 76199], [48, 76719], [51, 76879], [54, 77019], [59, 77519], [62, 77659], [70, 78506], [79, 78993]]}, {"verse": 13, "start": 79821, "end": 84369, "text": "Fueron pues, y hallaron como les había dicho; y prepararon la pascua.", "words": [[0, 79821], [7, 80107], [13, 80547], [15, 80872], [24, 81292], [29, 81652], [33, 81872], [39, 82212], [46, 83082], [48, 83192], [59, 83872], [62, 84121]]}, {"verse": 14, "start": 84719, "end": 89201, "text": "Y como fue hora, se sentó a la mesa, y con él los apóstoles.", "words": [[0, 84719], [2, 85043], [7, 85263], [11, 85673], [17, 86083], [20, 86183], [26, 86603], [28, 86683], [31, 86763], [37, 87043], [39, 87483], [43, 87723], [46, 87923], [50, 88183]]}, {"verse": 15, "start": 89551, "end": 95847, "text": "Y les dijo: En gran manera he deseado comer con vosotros esta pascua antes que padezca;", "words": [[0, 89551], [2, 89675], [6, 89815], [12, 90546], [15, 90713], [20, 90953], [27, 91433], [30, 91633], [38, 92173], [44, 92513], [48, 92773], [57, 93473], [62, 93853], [69, 94373], [75, 94813], [79, 95073]]}, {"verse": 16, "start": 96197, "end": 101786, "text": "Porque os digo que no comeré más de ella, hasta que se cumpla en el reino de Dios.", "words": [[0, 96197], [7, 96590], [10, 96750], [15, 96970], [19, 97150], [22, 97310], [29, 97750], [33, 98010], [36, 98230], [42, 98550], [48, 99030], [52, 99210], [55, 99350], [62, 99990], [65, 100470], [68, 100630], [74, 101030], [77, 101190]]}, {"verse": 17, "start": 102136, "end": 108542, "text": "Y tomando la copa, habiendo dado gracias, dijo: Tomad esto, y repartidlo entre vosotros;", "words": [[0, 102136], [2, 102282], [10, 102762], [13, 102942], [19, 103542], [28, 103882], [33, 104142], [42, 104982], [48, 105783], [54, 106167], [60, 106547], [62, 107019], [73, 107492], [79, 107912]]}, {"verse": 18, "start": 108892, "end": 114401, "text": "Porque os digo, que no beberé más del fruto de la vid, hasta que el reino de Dios venga.", "words": [[0, 108892], [7, 109113], [10, 109253], [16, 109473], [20, 109853], [23, 110053], [30, 110533], [34, 110753], [38, 111143], [44, 111533], [47, 111653], [50, 111813], [55, 111973], [61, 112493], [65, 112673], [68, 112813], [74, 113193], [77, 113353], [82, 113593]]}, {"verse": 19, "start": 114751, "end": 125563, "text": "Y tomando el pan, habiendo dado gracias, partió, y les dio, diciendo: Esto es mi cuerpo, que por vosotros es dado: haced esto en memoria de mí.", "words": [[0, 114751], [2, 114869], [10, 115289], [13, 115449], [18, 115989], [27, 116529], [32, 116789], [41, 117829], [49, 118509], [51, 118989], [55, 119169], [60, 119631], [70, 120672], [75, 120865], [78, 121005], [81, 121105], [89, 121465], [93, 121725], [97, 121945], [106, 122505], [109, 122705], [115, 123613], [121, 123813], [126, 124373], [129, 124553], [137, 125033], [140, 125213]]}, {"verse": 20, "start": 125913, "end": 136505, "text": "Asimismo también la copa, después que hubo cenado, diciendo: Esta copa es el nuevo pacto en mi sangre, que por vosotros se derrama.", "words": [[0, 126173], [9, 126463], [17, 127462], [20, 127627], [26, 128067], [34, 128347], [38, 128547], [43, 128947], [51, 129347], [61, 130849], [66, 131111], [71, 131651], [74, 131791], [77, 131971], [83, 132311], [89, 133011], [92, 133111], [95, 133271], [103, 133691], [107, 134171], [111, 134931], [120, 135471], [123, 135731]]}, {"verse": 21, "start": 136855, "end": 141017, "text": "Con todo eso, he aquí la mano del que me entrega, conmigo en la mesa.", "words": [[0, 136855], [4, 136997], [9, 137277], [14, 137617], [17, 137937], [22, 138217], [25, 138377], [30, 138557], [34, 138737], [38, 138917], [41, 139097], [50, 139777], [58, 140237], [61, 140337], [64, 140457]]}, {"verse": 22, "start": 141367, "end": 149202, "text": "Y a la verdad el Hijo del hombre va, según lo que está determinado; pero ¡ay de aquel hombre por el cual es entregado!", "words": [[0, 141367], [2, 141464], [4, 141504], [7, 141624], [14, 142064], [17, 142604], [22, 142904], [26, 143064], [33, 143444], [37, 143644], [43, 144104], [46, 144404], [50, 144544], [55, 144764], [68, 145974], [73, 146262], [77, 146582], [80, 146802], [86, 147082], [93, 147322], [97, 147622], [100, 147762], [105, 148002], [108, 148262]]}, {"verse": 23, "start": 149552, "end": 156222, "text": "Ellos entonces comenzaron a preguntar entre sí, cuál de ellos sería el que había de hacer esto.", "words": [[0, 149552], [6, 149983], [15, 150643], [26, 151603], [28, 151683], [38, 152303], [44, 152563], [48, 152923], [53, 153683], [56, 153943], [62, 154183], [68, 154493], [71, 154803], [75, 154923], [81, 155143], [84, 155363], [90, 155603]]}, {"verse": 24, "start": 156572, "end": 160827, "text": "Y hubo entre ellos una disputa, quién de ellos parecía ser el mayor.", "words": [[0, 156572], [2, 156732], [7, 157072], [13, 157292], [19, 157612], [23, 157852], [32, 158612], [38, 158872], [41, 158972], [47, 159252], [55, 159832], [59, 160112], [62, 160232]]}, {"verse": 25, "start": 161177, "end": 171454, "text": "Entonces él les dijo: Los reyes de las naciones dominan sobre ellas; y los que sobre ellas tienen autoridad, son llamados bienhechores:", "words": [[0, 161177], [9, 162002], [12, 162142], [16, 162362], [22, 163100], [26, 163246], [32, 163646], [35, 163766], [39, 163926], [48, 164446], [56, 165306], [62, 165606], [69, 166594], [71, 166722], [75, 166862], [79, 167042], [85, 167362], [91, 167622], [98, 168122], [109, 169062], [113, 169622], [122, 170202]]}, {"verse": 26, "start": 171804, "end": 180675, "text": "Pero vosotros, no así: antes el que es mayor entre vosotros, sea como el más joven; y el que dirige, como el que sirve.", "words": [[0, 171804], [5, 171970], [15, 173010], [18, 173090], [23, 173795], [29, 174295], [32, 174675], [36, 174835], [39, 174995], [45, 175355], [51, 175655], [61, 176295], [65, 176995], [70, 177295], [73, 177435], [77, 177575], [84, 178394], [86, 178519], [89, 178669], [93, 178829], [101, 179409], [106, 179699], [109, 179989], [113, 180069]]}, {"verse": 27, "start": 181025, "end": 190981, "text": "Porque, ¿cuál es mayor, el que se sienta a la mesa, o el que sirve? ¿No es el que se sienta a la mesa? Y yo soy entre vosotros como el que sirve.", "words": [[0, 181187], [8, 181387], [14, 182007], [17, 182167], [24, 182587], [27, 182907], [31, 183087], [34, 183247], [41, 183807], [43, 183887], [46, 184007], [52, 184347], [54, 184692], [57, 184812], [61, 184932], [68, 185838], [72, 186027], [75, 186347], [78, 186627], [82, 186767], [85, 186907], [92, 187427], [94, 187527], [97, 187607], [103, 188390], [105, 188518], [108, 188698], [112, 188998], [118, 189258], [127, 189878], [132, 190138], [135, 190318], [139, 190418]]}, {"verse": 28, "start": 191331, "end": 196619, "text": "Pero vosotros sois los que habéis permanecido conmigo en mis tentaciones:", "words": [[0, 191331], [5, 191495], [14, 192055], [19, 193135], [23, 193635], [27, 193795], [34, 194035], [46, 194775], [54, 195255], [57, 195395], [61, 195535]]}, {"verse": 29, "start": 196969, "end": 202390, "text": "Yo pues os concedo un reino, como mi Padre me lo concedió a mí,", "words": [[0, 196969], [3, 197410], [8, 197730], [11, 198170], [19, 198710], [22, 198810], [29, 199550], [34, 200070], [37, 200270], [43, 200690], [46, 201110], [49, 201230], [58, 201890], [60, 202010]]}, {"verse": 30, "start": 202740, "end": 211473, "text": "Para que comáis y bebáis en mi mesa en mi reino, y os sentéis sobre tronos juzgando a las doce tribus de Israel.", "words": [[0, 202740], [5, 202902], [9, 203082], [16, 203822], [18, 204182], [25, 204622], [28, 204842], [31, 205002], [36, 205282], [39, 205482], [42, 205622], [49, 206011], [51, 206399], [54, 206788], [62, 207177], [68, 207517], [75, 208337], [84, 209057], [86, 209217], [90, 209357], [95, 209777], [102, 210417], [105, 210557]]}, {"verse": 31, "start": 211823, "end": 219212, "text": "Dijo también el Señor: Simón, Simón, he aquí Satanás os ha pedido para zarandaros como a trigo;", "words": [[0, 211823], [5, 212310], [13, 212630], [16, 212910], [23, 213667], [30, 214070], [37, 214720], [40, 215370], [45, 215750], [53, 216690], [56, 216790], [59, 216910], [66, 217310], [71, 217550], [82, 218330], [87, 218644], [89, 218958]]}, {"verse": 32, "start": 219562, "end": 226423, "text": "Pero yo he rogado por ti que tu fe no falte: y tú, una vez vuelto, fortalece a tus hermanos.", "words": [[0, 219562], [5, 219903], [8, 220103], [11, 220383], [18, 220663], [22, 220923], [25, 221203], [29, 221343], [32, 221523], [35, 221783], [38, 221883], [45, 222836], [47, 222974], [51, 223214], [55, 223614], [59, 223954], [67, 224514], [77, 225314], [79, 225394], [83, 225534]]}, {"verse": 33, "start": 226773, "end": 231570, "text": "Y él le dijo: Señor, estoy dispuesto a ir contigo aun a cárcel y a muerte.", "words": [[0, 226773], [2, 226979], [5, 227119], [8, 227239], [14, 227958], [21, 228653], [27, 228853], [37, 229353], [39, 229513], [42, 229593], [50, 229853], [54, 230113], [56, 230373], [63, 230853], [65, 231013], [67, 231033]]}, {"verse": 34, "start": 231850, "end": 238562, "text": "Y él dijo: Pedro, te digo que el gallo no cantará hoy antes que tú niegues tres veces que me conoces.", "words": [[0, 231850], [2, 231995], [5, 232115], [11, 232776], [18, 233621], [21, 233801], [26, 234061], [30, 234241], [33, 234341], [39, 234621], [42, 234761], [50, 235301], [54, 235581], [60, 235941], [64, 236161], [67, 236361], [75, 236801], [80, 237021], [86, 237401], [90, 237601], [93, 237741]]}, {"verse": 35, "start": 238912, "end": 247531, "text": "Y a ellos dijo: Cuando os envié sin bolsa, y sin bolsa de viaje, y sin zapatos, ¿os faltó algo? Y ellos dijeron: Nada.", "words": [[0, 238912], [2, 239059], [4, 239139], [10, 239299], [16, 240119], [23, 240425], [26, 240765], [32, 241105], [36, 241245], [43, 241765], [45, 241885], [49, 242065], [55, 242505], [58, 242605], [65, 242905], [67, 243185], [71, 243345], [80, 244385], [84, 244545], [90, 245005], [96, 245759], [98, 245901], [104, 246081], [113, 247082]]}, {"verse": 36, "start": 247811, "end": 256596, "text": "Y les dijo: Pues ahora, el que tiene bolsa, tómela, y también la bolsa de viaje, y el que no tiene, venda su capa y compre espada.", "words": [[0, 247811], [2, 247934], [6, 248074], [12, 248805], [17, 248950], [24, 249350], [27, 249910], [31, 250050], [37, 250270], [44, 250995], [52, 251375], [54, 251755], [62, 252035], [65, 252215], [71, 252535], [74, 252655], [81, 252995], [83, 253475], [86, 253575], [90, 253695], [93, 253855], [100, 254575], [106, 254835], [109, 255015], [114, 255435], [116, 255515], [123, 255915]]}, {"verse": 37, "start": 256946, "end": 266324, "text": "Porque os digo, que es necesario que se cumpla todavía en mí aquello que está escrito: Y con los malos fue contado: porque lo que está escrito de mí, cumplimiento tiene.", "words": [[0, 256946], [7, 257168], [10, 257328], [16, 257528], [20, 257768], [23, 257948], [33, 258668], [37, 258868], [40, 259008], [47, 259468], [55, 259788], [58, 260088], [61, 260228], [69, 260848], [73, 260968], [78, 261108], [87, 261891], [89, 261969], [93, 262129], [97, 262289], [103, 262609], [107, 262769], [116, 263655], [123, 263839], [126, 264019], [130, 264139], [135, 264279], [143, 264599], [146, 264859], [150, 265019], [163, 265679]]}, {"verse": 38, "start": 266674, "end": 272528, "text": "Entonces ellos dijeron: Señor, he aquí dos espadas. Y él les dijo: Basta.", "words": [[0, 266674], [9, 267191], [15, 267591], [24, 268605], [31, 269122], [34, 269202], [39, 269442], [43, 269622], [52, 270666], [54, 270862], [57, 271002], [61, 271202], [67, 271978]]}, {"verse": 39, "start": 272878, "end": 278838, "text": "Y saliendo, se fue, como solía, al monte de los Olivos; y sus discípulos también le siguieron.", "words": [[0, 272878], [2, 273068], [12, 273608], [15, 273808], [20, 274088], [25, 274408], [32, 274908], [35, 275168], [41, 275448], [44, 275708], [48, 275848], [56, 276770], [58, 276877], [62, 277017], [73, 277637], [81, 277917], [84, 278137]]}, {"verse": 40, "start": 279188, "end": 284554, "text": "Y cuando llegó a aquel lugar, les dijo: Orad que no entréis en tentación.", "words": [[0, 279188], [2, 279320], [9, 279620], [15, 280020], [17, 280360], [23, 280700], [30, 281340], [34, 281520], [40, 282267], [45, 282671], [49, 282846], [52, 283026], [60, 283506], [63, 283686]]}, {"verse": 41, "start": 284904, "end": 289777, "text": "Y él se apartó de ellos como un tiro de piedra; y puesto de rodillas oró,", "words": [[0, 284904], [2, 285054], [5, 285194], [8, 285354], [15, 285894], [18, 286034], [24, 286314], [29, 286634], [32, 286854], [37, 287134], [40, 287334], [48, 288175], [50, 288410], [57, 288670], [60, 288930], [69, 289430]]}, {"verse": 42, "start": 289777, "end": 297292, "text": "Diciendo: Padre, si quieres, aparta esta copa de mí; pero no se haga mi voluntad, sino la tuya.", "words": [[0, 289850], [10, 291283], [17, 291861], [20, 292081], [29, 292791], [36, 293501], [41, 293681], [46, 294101], [49, 294221], [53, 294709], [58, 294875], [61, 295055], [64, 295235], [69, 295415], [72, 295595], [82, 296215], [87, 296515], [90, 296755]]}, {"verse": 43, "start": 297642, "end": 300934, "text": "Y le apareció un ángel del cielo confortándole.", "words": [[0, 297642], [2, 297766], [5, 297866], [14, 298466], [17, 298746], [23, 299186], [27, 299346], [33, 299746]]}, {"verse": 44, "start": 301284, "end": 310057, "text": "Y estando en agonía, oraba más intensamente: y fue su sudor como grandes gotas de sangre que caían hasta la tierra.", "words": [[0, 301284], [2, 301464], [10, 301904], [13, 302064], [21, 303124], [27, 303684], [31, 303984], [45, 305387], [47, 305508], [51, 305688], [54, 305908], [60, 306348], [65, 306588], [73, 307068], [79, 307688], [82, 307828], [89, 308268], [93, 308488], [99, 308948], [105, 309228], [108, 309408]]}, {"verse": 45, "start": 310407, "end": 316414, "text": "Y como se levantó de la oración, y vino a sus discípulos, los halló durmiendo de tristeza;", "words": [[0, 310407], [2, 310645], [7, 310845], [10, 311025], [18, 311505], [21, 311758], [24, 312012], [33, 312265], [35, 312665], [40, 312905], [42, 313065], [46, 313245], [58, 314265], [62, 314425], [68, 314845], [78, 315405], [81, 315565]]}, {"verse": 46, "start": 316764, "end": 322239, "text": "Y les dijo: ¿Por qué dormís? Levantaos, y orad que no entréis en tentación.", "words": [[0, 316764], [2, 316888], [6, 317028], [12, 317759], [17, 317883], [21, 318083], [29, 319072], [40, 319843], [42, 320063], [47, 320383], [51, 320583], [54, 320763], [62, 321303], [65, 321443]]}, {"verse": 47, "start": 322589, "end": 333293, "text": "Estando él aún hablando, he aquí una turba; y el que se llamaba Judas, uno de los doce, iba delante de ellos; y se acercó hasta Jesús para besarlo.", "words": [[0, 322589], [8, 323036], [11, 323336], [15, 323636], [25, 323936], [28, 324236], [33, 324436], [37, 324676], [44, 325555], [46, 325777], [49, 325897], [53, 326017], [56, 326177], [64, 326557], [71, 327397], [75, 327797], [78, 327957], [82, 328097], [88, 328897], [92, 329177], [100, 329637], [103, 329817], [110, 330638], [112, 330761], [115, 330901], [122, 331501], [128, 331741], [134, 332121], [139, 332735]]}, {"verse": 48, "start": 333643, "end": 339135, "text": "Entonces Jesús le dijo: Judas, ¿con beso entregas al Hijo del hombre?", "words": [[0, 333643], [9, 334050], [15, 334590], [18, 334930], [24, 335680], [31, 336620], [36, 337040], [41, 337460], [50, 338020], [53, 338180], [58, 338420], [62, 338620]]}, {"verse": 49, "start": 339485, "end": 345781, "text": "Y viendo los que estaban con él lo que había de ser, le dijeron: Señor, ¿heriremos con la espada?", "words": [[0, 339485], [2, 339632], [9, 339972], [13, 340172], [17, 340312], [25, 340632], [29, 340932], [32, 341172], [35, 341492], [39, 341632], [45, 341852], [48, 342052], [53, 342632], [56, 342792], [65, 343772], [72, 344490], [83, 344990], [87, 345150], [90, 345250]]}, {"verse": 50, "start": 346061, "end": 352162, "text": "Y uno de ellos hirió a un siervo del sumo sacerdote, y le quitó la oreja derecha.", "words": [[0, 346061], [2, 346241], [6, 346481], [9, 346641], [15, 346981], [21, 347521], [23, 347741], [26, 347901], [33, 348441], [37, 348561], [42, 349081], [53, 349821], [55, 350241], [58, 350381], [64, 350901], [67, 351101], [73, 351501]]}, {"verse": 51, "start": 352512, "end": 359029, "text": "Entonces respondiendo Jesús, dijo: Dejad hasta aquí. Y tocando su oreja, le sanó.", "words": [[0, 352512], [9, 353224], [22, 354044], [29, 354224], [35, 355123], [41, 355619], [47, 355939], [53, 356795], [55, 356901], [63, 357321], [66, 357581], [73, 358461], [76, 358561]]}, {"verse": 52, "start": 359379, "end": 372318, "text": "Y Jesús dijo a los que habían venido a él, los principales sacerdotes, y los jefes de la guardia del templo, y los ancianos: ¿Como a ladrón habéis salido con espadas y con palos?", "words": [[0, 359379], [2, 359506], [8, 359906], [13, 360406], [15, 360726], [19, 360866], [23, 361026], [30, 361346], [37, 361826], [39, 361986], [43, 362766], [47, 362926], [59, 363626], [71, 364426], [73, 364926], [77, 365066], [83, 365446], [86, 365526], [89, 365626], [97, 365966], [101, 366126], [109, 366686], [111, 367166], [115, 367306], [125, 368421], [131, 368588], [133, 368788], [140, 369288], [147, 369948], [154, 370588], [158, 370808], [166, 371288], [168, 371488], [172, 371668]]}, {"verse": 53, "start": 372668, "end": 382749, "text": "Habiendo estado con vosotros cada día en el templo, no extendisteis las manos contra mí; pero esta es vuestra hora, y la potestad de las tinieblas.", "words": [[0, 372668], [9, 372994], [16, 373294], [20, 373634], [29, 374134], [34, 374354], [38, 374674], [41, 374834], [44, 374974], [52, 375994], [55, 376134], [68, 377514], [72, 377834], [78, 378214], [85, 378554], [89, 379135], [94, 379281], [99, 379541], [102, 379681], [110, 380061], [116, 380381], [118, 380616], [121, 380756], [130, 381356], [133, 381476], [137, 381616]]}, {"verse": 54, "start": 383099, "end": 390459, "text": "Y prendiéndole le trajeron, y le metieron en casa del sumo sacerdote. Y Pedro le seguía de lejos.", "words": [[0, 383099], [2, 383223], [15, 384243], [18, 384543], [28, 385383], [30, 385568], [33, 385668], [42, 386128], [45, 386328], [50, 386628], [54, 386868], [59, 387348], [70, 388454], [72, 388723], [78, 389043], [81, 389263], [88, 389663], [91, 389763]]}, {"verse": 55, "start": 390809, "end": 399123, "text": "Y habiendo encendido fuego en medio del patio, y sentándose todos alrededor, se sentó también Pedro entre ellos.", "words": [[0, 390809], [2, 390913], [11, 391313], [21, 391993], [27, 392353], [30, 392733], [36, 393013], [40, 393233], [47, 394253], [49, 394333], [60, 395133], [66, 395513], [77, 396893], [80, 397033], [86, 397453], [94, 397733], [100, 398213], [106, 398533]]}, {"verse": 56, "start": 399473, "end": 407095, "text": "Y como una criada le vio que estaba sentado al fuego, se fijó en él, y dijo: Y este con él estaba.", "words": [[0, 399473], [2, 399598], [7, 399838], [11, 400078], [18, 400638], [21, 400818], [25, 401078], [29, 401198], [36, 401648], [44, 402098], [47, 402238], [54, 403198], [57, 403438], [62, 403878], [65, 404058], [69, 404338], [71, 404633], [77, 405406], [79, 405553], [84, 405853], [88, 406133], [91, 406333]]}, {"verse": 57, "start": 407375, "end": 411820, "text": "Entonces él lo negó, diciendo: Mujer, no le conozco.", "words": [[0, 407375], [9, 407820], [12, 408320], [15, 408620], [21, 409080], [31, 410455], [38, 410796], [41, 411096], [44, 411216]]}, {"verse": 58, "start": 412100, "end": 419045, "text": "Y un poco después, viéndole otro, dijo: Y tú de ellos eras. Y Pedro dijo: Hombre, no soy.", "words": [[0, 412100], [2, 412202], [5, 412322], [10, 412542], [19, 413442], [28, 413862], [34, 414582], [40, 415223], [42, 415345], [45, 415565], [48, 415765], [54, 415985], [60, 416866], [62, 416990], [68, 417330], [74, 418233], [82, 418434], [85, 418634]]}, {"verse": 59, "start": 419325, "end": 426788, "text": "Y como una hora pasada otro afirmaba, diciendo: Verdaderamente también este estaba con él, porque es galileo.", "words": [[0, 419325], [2, 419454], [7, 419714], [11, 419954], [16, 420354], [23, 420754], [28, 420974], [38, 422234], [48, 423292], [63, 424028], [71, 424288], [76, 424648], [83, 424948], [87, 425228], [91, 425848], [98, 426088], [101, 426208]]}, {"verse": 60, "start": 427068, "end": 433854, "text": "Y Pedro dijo: Hombre, no sé qué dices. Y enseguida, estando él aún hablando, el gallo cantó.", "words": [[0, 427068], [2, 427192], [8, 427532], [14, 428435], [22, 428817], [25, 428877], [28, 429057], [32, 429157], [39, 430074], [41, 430200], [52, 430760], [60, 431200], [63, 431400], [67, 431580], [77, 432700], [80, 432840], [86, 433260]]}, {"verse": 61, "start": 434204, "end": 445246, "text": "Entonces, vuelto el Señor, miró a Pedro: y Pedro se acordó de la palabra del Señor como le había dicho: Antes que el gallo cante, me negarás tres veces.", "words": [[0, 434204], [10, 434805], [17, 435585], [20, 435745], [27, 436865], [32, 437205], [34, 437285], [41, 437585], [43, 437805], [49, 438165], [52, 438565], [59, 439045], [62, 439145], [65, 439245], [73, 439545], [77, 439805], [83, 440105], [88, 440725], [91, 440885], [97, 441105], [104, 441903], [110, 442246], [114, 442446], [117, 442586], [123, 443016], [130, 443446], [133, 443786], [141, 444126], [146, 444386]]}, {"verse": 62, "start": 445596, "end": 448852, "text": "Y saliendo fuera Pedro, lloró amargamente.", "words": [[0, 445596], [2, 445701], [11, 446161], [17, 446401], [24, 447361], [30, 447741]]}, {"verse": 63, "start": 449202, "end": 453601, "text": "Y los hombres que tenían a Jesús, se burlaban de él hiriéndole;", "words": [[0, 449202], [2, 449307], [6, 449467], [14, 449807], [18, 449987], [25, 450327], [27, 450547], [34, 450927], [37, 451487], [46, 452087], [49, 452347], [52, 453002]]}, {"verse": 64, "start": 453951, "end": 461265, "text": "Y cubriéndole, herían su rostro, y le preguntaban, diciendo: Profetiza quién es el que te hirió.", "words": [[0, 453951], [2, 454115], [15, 454835], [22, 455555], [25, 455715], [33, 456755], [35, 456835], [38, 456955], [51, 457715], [61, 459334], [71, 459917], [77, 460157], [80, 460377], [83, 460477], [87, 460617], [90, 460962]]}, {"verse": 65, "start": 461545, "end": 464446, "text": "Y decían otras muchas cosas injuriándole.", "words": [[0, 461545], [2, 461655], [9, 462135], [15, 462415], [22, 462795], [28, 463648]]}, {"verse": 66, "start": 464796, "end": 472999, "text": "Al amanecer, se juntaron los ancianos del pueblo, y los principales sacerdotes, y los escribas, y le trajeron a su Consejo,", "words": [[0, 464796], [3, 464996], [13, 465616], [16, 465816], [25, 466376], [29, 466556], [38, 467076], [42, 467216], [50, 467716], [52, 468176], [56, 468316], [68, 469016], [80, 469896], [82, 470116], [86, 470236], [96, 470936], [98, 471276], [101, 471396], [110, 471976], [112, 472056], [115, 472196]]}, {"verse": 67, "start": 473349, "end": 480246, "text": "Y le preguntaron: ¿Eres tú el Cristo? dínoslo. Y les dijo: Si os lo digo, no creeréis;", "words": [[0, 473349], [2, 473448], [5, 473568], [18, 474750], [24, 474930], [27, 475230], [30, 475370], [38, 476190], [47, 477058], [49, 477182], [53, 477322], [59, 478053], [62, 478403], [65, 478563], [68, 478723], [74, 479083], [77, 479223]]}, {"verse": 68, "start": 480596, "end": 485307, "text": "Y también si os pregunto, no me responderíais ni me soltaríais.", "words": [[0, 480596], [2, 480703], [10, 480983], [13, 481243], [16, 481323], [26, 482103], [29, 482403], [32, 482583], [46, 483643], [49, 484083], [52, 484720]]}, {"verse": 69, "start": 485657, "end": 490519, "text": "Pero desde ahora el Hijo del hombre se sentará a la diestra del poder de Dios.", "words": [[0, 485657], [5, 485802], [11, 486082], [17, 486462], [20, 486682], [25, 486962], [29, 487102], [36, 487502], [39, 487622], [47, 488202], [49, 488442], [52, 488522], [60, 489022], [64, 489262], [70, 489622], [73, 489862]]}, {"verse": 70, "start": 490869, "end": 497818, "text": "Y dijeron todos: ¿Entonces tú eres Hijo de Dios? Y él les dijo: Vosotros decís que yo soy.", "words": [[0, 490869], [2, 491036], [10, 491556], [17, 492596], [27, 493118], [30, 493378], [35, 493538], [40, 493818], [43, 493978], [49, 494790], [51, 494987], [54, 495127], [58, 495327], [64, 496102], [73, 496568], [79, 497048], [83, 497148], [86, 497328]]}, {"verse": 71, "start": 498168, "end": 504106, "text": "Entonces ellos dijeron: ¿Qué más testimonio deseamos? porque nosotros lo hemos oído de su boca.", "words": [[0, 498168], [9, 498685], [15, 499085], [24, 500099], [29, 500203], [33, 500383], [44, 500983], [54, 501985], [61, 502149], [70, 502489], [73, 502809], [79, 502949], [84, 503329], [87, 503489], [90, 503629]]}]}