{"book": "LUK", "chapter": 19, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 365670, "verses": [{"verse": 1, "start": 300, "end": 3625, "text": "Y habiendo entrado Jesús, iba pasando por Jericó;", "words": [[0, 300], [2, 429], [11, 749], [19, 1189], [26, 1929], [30, 2269], [38, 2669], [42, 2969]]}, {"verse": 2, "start": 4075, "end": 11620, "text": "Y he aquí un varón llamado Zaqueo, el cual era el jefe de los recaudadores de impuestos, y era rico;", "words": [[0, 4075], [2, 4335], [5, 4555], [10, 4835], [13, 5075], [19, 5535], [27, 6245], [35, 6955], [38, 6995], [43, 7235], [47, 7895], [50, 8195], [55, 8675], [58, 8815], [62, 8955], [75, 9875], [78, 10075], [89, 10635], [91, 10855], [95, 11015]]}, {"verse": 3, "start": 12070, "end": 19590, "text": "Y procuraba ver a Jesús quién fuese; pero no podía a causa de la multitud, porque era pequeño de estatura.", "words": [[0, 12070], [2, 12179], [12, 12799], [16, 13019], [18, 13119], [24, 13419], [30, 13819], [37, 14854], [42, 15149], [45, 15309], [51, 15749], [53, 16029], [59, 16309], [62, 16589], [65, 16669], [75, 17529], [82, 18069], [86, 18289], [94, 18649], [97, 18909]]}, {"verse": 4, "start": 20040, "end": 27343, "text": "Y corriendo delante, se subió a un árbol sicómoro para verle; porque había de pasar por allí.", "words": [[0, 20040], [2, 20163], [12, 20683], [21, 21223], [24, 21643], [30, 22143], [32, 22343], [35, 22523], [41, 23363], [50, 24203], [55, 24503], [62, 25534], [69, 25758], [75, 26038], [78, 26218], [84, 26538], [88, 26858]]}, {"verse": 5, "start": 27793, "end": 39600, "text": "Y cuando vino a aquel lugar Jesús, mirando, le vio, y le dijo: Zaqueo, date prisa, desciende, porque hoy es necesario que me hospede en tu casa.", "words": [[0, 27793], [2, 28027], [9, 28234], [14, 28440], [16, 28647], [22, 29127], [28, 29367], [35, 30307], [44, 31107], [47, 31307], [52, 31627], [54, 32147], [57, 32287], [63, 33542], [71, 34022], [76, 34182], [83, 35042], [94, 35942], [101, 36182], [105, 36502], [108, 36802], [118, 37562], [122, 38062], [125, 38222], [133, 38682], [136, 38882], [139, 39002]]}, {"verse": 6, "start": 40050, "end": 44959, "text": "Entonces él descendió aprisa, y le recibió gozoso.", "words": [[0, 40050], [9, 40992], [12, 41492], [22, 42282], [30, 43072], [32, 43412], [35, 43572], [43, 44212]]}, {"verse": 7, "start": 45409, "end": 51496, "text": "Y viendo esto, todos murmuraban, diciendo que había entrado a hospedarse con un hombre pecador.", "words": [[0, 45409], [2, 45671], [9, 45931], [15, 46271], [21, 46511], [33, 47751], [42, 48211], [46, 48511], [52, 48691], [60, 49271], [62, 49391], [73, 50031], [77, 50291], [80, 50431], [87, 50711]]}, {"verse": 8, "start": 51946, "end": 63921, "text": "Entonces Zaqueo, puesto en pie, dijo al Señor: He aquí, Señor, la mitad de mis bienes doy a los pobres; y si en algo he defraudado a alguno, lo devuelvo cuadruplicado.", "words": [[0, 51946], [9, 52820], [17, 53730], [24, 54050], [27, 54410], [32, 55190], [37, 55550], [40, 55810], [47, 56624], [50, 56754], [56, 57054], [63, 57834], [66, 58014], [72, 58234], [75, 58474], [79, 58594], [86, 59014], [90, 59254], [92, 59294], [96, 59394], [104, 60349], [106, 60469], [109, 60609], [112, 60729], [117, 60949], [120, 61109], [131, 61379], [133, 61649], [141, 62329], [144, 62569], [153, 63049]]}, {"verse": 9, "start": 64271, "end": 72022, "text": "Y Jesús le dijo: Hoy ha venido la salvación a esta casa; por cuanto él también es hijo de Abraham.", "words": [[0, 64271], [2, 64397], [8, 64777], [11, 65197], [17, 66007], [21, 66275], [24, 66535], [31, 66935], [34, 67075], [44, 67735], [46, 67875], [51, 68035], [57, 68982], [61, 69126], [68, 69486], [71, 69866], [79, 70306], [82, 70706], [87, 71086], [90, 71306]]}, {"verse": 10, "start": 72472, "end": 77311, "text": "Porque el Hijo del hombre vino a buscar y a salvar lo que se había perdido.", "words": [[0, 72472], [7, 72717], [10, 73037], [15, 73317], [19, 73477], [26, 73777], [31, 74057], [33, 74217], [40, 74557], [42, 74817], [44, 74877], [51, 75317], [54, 75917], [58, 76057], [61, 76217], [67, 76457]]}, {"verse": 11, "start": 77761, "end": 90774, "text": "Y oyendo ellos estas cosas, prosiguió Jesús y dijo una parábola, por cuanto estaba cerca de Jerusalén, y porque pensaban que enseguida había de ser manifestado el reino de Dios.", "words": [[0, 77761], [2, 77903], [9, 78283], [15, 78623], [21, 78983], [28, 79863], [38, 80483], [44, 80863], [46, 81583], [51, 81863], [55, 82063], [65, 82683], [69, 83423], [76, 83743], [83, 84163], [89, 84503], [92, 84763], [103, 85563], [105, 85863], [112, 86123], [121, 86823], [125, 87283], [135, 88023], [141, 88343], [144, 88543], [148, 88743], [160, 89543], [163, 89683], [169, 90083], [172, 90223]]}, {"verse": 12, "start": 91224, "end": 98902, "text": "Dijo pues: Un hombre noble partió a una provincia lejos, para tomar para sí un reino, y volver.", "words": [[0, 91224], [5, 91612], [11, 92538], [14, 92705], [21, 92965], [27, 93365], [34, 94065], [36, 94285], [40, 94425], [50, 95065], [57, 95505], [62, 96145], [68, 96485], [73, 96745], [76, 97005], [79, 97205], [86, 97765], [88, 98325]]}, {"verse": 13, "start": 99352, "end": 106759, "text": "Pero llamados diez siervos suyos, les dio diez minas, y les dijo: Haced negocios entre tanto que vengo.", "words": [[0, 99352], [5, 99621], [14, 100101], [19, 100561], [27, 101521], [34, 102341], [38, 102521], [42, 102721], [47, 103041], [54, 103601], [56, 103701], [60, 103841], [66, 104770], [72, 104950], [81, 105470], [87, 105730], [93, 106070], [97, 106270]]}, {"verse": 14, "start": 107109, "end": 116119, "text": "Pero sus ciudadanos le aborrecían, y enviaron tras de él una delegación, diciendo: No queremos que este reine sobre nosotros.", "words": [[0, 107109], [5, 107273], [9, 107453], [20, 108233], [23, 108373], [35, 109133], [37, 110033], [46, 110533], [51, 110793], [54, 111073], [57, 111233], [61, 111533], [73, 112353], [83, 113721], [86, 113845], [95, 114125], [99, 114445], [104, 114755], [110, 115065], [116, 115305]]}, {"verse": 15, "start": 116469, "end": 128568, "text": "Y aconteció, que vuelto él, habiendo tomado el reino, mandó llamar a sí a aquellos siervos a los cuales había dado el dinero, para saber lo que había negociado cada uno.", "words": [[0, 116469], [2, 116592], [13, 117292], [17, 117592], [24, 118032], [28, 118672], [37, 119072], [44, 119612], [47, 119752], [54, 120892], [60, 121352], [67, 121579], [69, 121805], [72, 122032], [74, 122312], [83, 122632], [91, 123412], [93, 123752], [97, 123872], [104, 124092], [110, 124432], [115, 124712], [118, 124872], [126, 125791], [131, 126031], [137, 126451], [140, 126831], [144, 126971], [150, 127111], [160, 127731], [165, 127971]]}, {"verse": 16, "start": 129018, "end": 133902, "text": "Y vino el primero, diciendo: Señor, tu mina ha ganado diez minas.", "words": [[0, 129018], [2, 129158], [7, 129378], [10, 129538], [19, 130038], [29, 131637], [36, 131902], [39, 132202], [44, 132502], [47, 132682], [54, 132952], [59, 133222]]}, {"verse": 17, "start": 134252, "end": 141169, "text": "Y él le dice: Está bien, buen siervo; pues que en lo poco has sido fiel, tendrás autoridad sobre diez ciudades.", "words": [[0, 134252], [2, 134478], [5, 134658], [8, 134838], [14, 135666], [19, 135907], [25, 136087], [30, 136327], [38, 137205], [43, 137329], [47, 137509], [50, 137609], [53, 137729], [58, 137949], [62, 138169], [67, 138309], [73, 138969], [81, 139349], [91, 139849], [97, 140139], [102, 140429]]}, {"verse": 18, "start": 141519, "end": 145842, "text": "Y vino otro, diciendo: Señor, tu mina ha hecho cinco minas.", "words": [[0, 141519], [2, 141644], [7, 141904], [13, 142364], [23, 143523], [30, 143794], [33, 144100], [38, 144407], [41, 144607], [47, 144827], [53, 145127]]}, {"verse": 19, "start": 146192, "end": 150533, "text": "Y también a este dijo: Tú también gobierna sobre cinco ciudades.", "words": [[0, 146192], [2, 146296], [10, 146616], [12, 146856], [17, 147076], [23, 147953], [26, 148058], [34, 148588], [43, 149118], [49, 149358], [55, 149738]]}, {"verse": 20, "start": 150883, "end": 156936, "text": "Y vino otro, diciendo: Señor, he aquí tu mina, la cual he tenido guardada en un pañuelo:", "words": [[0, 150883], [2, 151007], [7, 151267], [13, 151727], [23, 152887], [30, 153231], [33, 153615], [38, 153999], [41, 154383], [47, 154767], [50, 154907], [55, 155087], [58, 155287], [65, 155527], [74, 156087], [77, 156207], [80, 156307]]}, {"verse": 21, "start": 157386, "end": 163437, "text": "Porque tuve miedo de ti, que eres hombre severo; tomas lo que no pusiste, y siegas lo que no sembraste.", "words": [[0, 157386], [7, 157561], [12, 157861], [18, 158121], [21, 158281], [25, 158541], [29, 158881], [34, 159041], [41, 159321], [49, 160242], [55, 160742], [58, 160842], [62, 160942], [65, 161062], [74, 161602], [76, 161972], [83, 162342], [86, 162502], [90, 162582], [93, 162702]]}, {"verse": 22, "start": 163787, "end": 172657, "text": "Entonces él le dijo: Mal siervo, de tu boca te juzgo. Sabías que yo era hombre severo, que tomo lo que no puse, y que siego lo que no sembré;", "words": [[0, 163787], [9, 164347], [12, 165167], [15, 165387], [21, 166183], [25, 166358], [33, 166738], [36, 166858], [39, 166978], [44, 167238], [47, 167418], [54, 168234], [61, 168571], [65, 168731], [68, 168871], [72, 169031], [79, 169291], [87, 169791], [91, 169891], [96, 170191], [99, 170231], [103, 170371], [106, 170491], [112, 170911], [114, 171271], [118, 171501], [124, 171731], [127, 171871], [131, 171991], [134, 172131]]}, {"verse": 23, "start": 173107, "end": 178462, "text": "¿Por qué, pues, no diste mi dinero al banco, y yo viniendo lo reclamara con los intereses?", "words": [[0, 173107], [5, 173230], [10, 173510], [16, 174090], [19, 174150], [25, 174510], [28, 174590], [35, 174890], [38, 175090], [45, 175870], [47, 175970], [50, 176090], [59, 176590], [62, 176730], [72, 177310], [76, 177470], [80, 177650]]}, {"verse": 24, "start": 178812, "end": 184225, "text": "Y dijo a los que estaban presentes: Quitadle la mina, y dadla al que tiene las diez minas.", "words": [[0, 178812], [2, 178917], [7, 179217], [9, 179357], [13, 179457], [17, 179597], [25, 179897], [36, 181380], [45, 181630], [48, 181770], [54, 182050], [56, 182340], [62, 182630], [65, 182870], [69, 182990], [75, 183230], [79, 183430], [84, 183630]]}, {"verse": 25, "start": 184575, "end": 187819, "text": "Y ellos le dijeron: Señor, tiene diez minas.", "words": [[0, 184575], [2, 184758], [8, 184978], [11, 185158], [20, 186107], [27, 186468], [33, 186868], [38, 187128]]}, {"verse": 26, "start": 188169, "end": 194823, "text": "Pues yo os digo que a todo el que tiene, se le dará; pero al que no tiene, aun lo que tiene se le quitará.", "words": [[0, 188169], [5, 188291], [8, 188511], [11, 188651], [16, 188871], [20, 189091], [22, 189211], [27, 189391], [30, 189591], [34, 189691], [41, 190051], [44, 190531], [47, 190671], [53, 191441], [58, 191585], [61, 191705], [65, 191845], [68, 192005], [75, 192905], [79, 193065], [82, 193305], [86, 193425], [92, 193745], [95, 193965], [98, 194105]]}, {"verse": 27, "start": 195123, "end": 201791, "text": "Y también a aquellos mis enemigos que no querían que yo reinase sobre ellos, traedlos acá, y degolladlos delante de mí.", "words": [[0, 195123], [2, 195209], [10, 195509], [12, 195689], [21, 195929], [25, 196209], [34, 196749], [38, 196949], [41, 197069], [49, 197449], [53, 197589], [56, 197709], [64, 198169], [70, 198449], [77, 199019], [86, 199589], [91, 199909], [93, 200399], [105, 200889], [113, 201349], [116, 201509]]}, {"verse": 28, "start": 202141, "end": 205237, "text": "Y dicho esto, iba delante subiendo a Jerusalén.", "words": [[0, 202141], [2, 202243], [8, 202523], [14, 202863], [18, 203293], [26, 203723], [35, 204323], [37, 204423]]}, {"verse": 29, "start": 205687, "end": 214625, "text": "Y aconteció, que llegando cerca de Betfagé, y de Betania, al monte que se llama de los Olivos, envió dos de sus discípulos,", "words": [[0, 205687], [2, 205794], [13, 206594], [17, 207014], [26, 207494], [32, 207874], [35, 208384], [44, 208894], [46, 209094], [49, 209214], [58, 210054], [61, 210154], [67, 210434], [71, 210634], [74, 210774], [80, 211054], [83, 211214], [87, 211314], [95, 212074], [101, 212454], [105, 212954], [108, 213394], [112, 213594]]}, {"verse": 30, "start": 215075, "end": 228004, "text": "Diciendo: Id a la aldea de enfrente; y al entrar en ella, hallaréis un burro joven atado, en el que ningún hombre se ha sentado jamás; desatadlo, y traedlo.", "words": [[0, 215075], [10, 216214], [13, 216334], [15, 216454], [18, 216614], [24, 217114], [27, 217294], [37, 218438], [39, 218575], [42, 218675], [49, 219095], [52, 219335], [58, 220115], [68, 220795], [71, 220955], [77, 221355], [83, 221775], [90, 222275], [93, 222735], [96, 222855], [100, 222995], [107, 223415], [114, 223895], [117, 224155], [120, 224295], [128, 224815], [135, 225827], [146, 226792], [148, 227112]]}, {"verse": 31, "start": 228454, "end": 235398, "text": "Y si alguien os pregunta, ¿por qué lo desatáis? le responderéis así: Porque el Señor lo necesita.", "words": [[0, 228454], [2, 228579], [5, 228659], [13, 228909], [16, 229159], [26, 229979], [31, 230379], [35, 230599], [38, 231097], [48, 231870], [51, 232293], [64, 232753], [69, 233506], [76, 233732], [79, 233892], [85, 234232], [88, 234552]]}, {"verse": 32, "start": 235848, "end": 239649, "text": "Y fueron los que habían sido enviados, y hallaron como les dijo.", "words": [[0, 235848], [2, 235954], [9, 236194], [13, 236394], [17, 236554], [24, 236814], [29, 237094], [39, 237734], [41, 238154], [50, 238634], [55, 238874], [59, 239074]]}, {"verse": 33, "start": 239949, "end": 245965, "text": "Y desatando ellos el burro joven, sus dueños les dijeron: ¿Por qué desatáis el burro joven?", "words": [[0, 239949], [2, 240051], [12, 240711], [18, 240991], [21, 241211], [27, 241551], [34, 242431], [38, 242551], [45, 243071], [49, 243211], [58, 244121], [63, 244260], [67, 244460], [76, 245060], [79, 245200], [85, 245500]]}, {"verse": 34, "start": 246315, "end": 252052, "text": "Y ellos dijeron: Porque el Señor lo necesita.", "words": [[0, 246315], [2, 246481], [8, 246661], [17, 247704], [24, 247964], [27, 248144], [33, 248404], [36, 248664]]}, {"verse": 35, "start": 252402, "end": 259781, "text": "Y lo trajeron a Jesús; y habiendo echado sus vestidos sobre el burro joven, pusieron a Jesús encima.", "words": [[0, 252402], [2, 252526], [5, 252626], [14, 253246], [16, 253326], [23, 254268], [25, 254521], [34, 254881], [41, 255361], [45, 255561], [54, 256161], [60, 256481], [63, 256681], [69, 257101], [76, 257801], [85, 258361], [87, 258501], [93, 258781]]}, {"verse": 36, "start": 260231, "end": 263146, "text": "Y yendo él tendían sus capas por el camino.", "words": [[0, 260231], [2, 260356], [8, 260696], [11, 260916], [19, 261456], [23, 261696], [29, 262196], [33, 262376], [36, 262516]]}, {"verse": 37, "start": 263596, "end": 277176, "text": "Y como llegasen ya cerca de la bajada del monte de los Olivos, toda la multitud de los discípulos, gozándose, comenzaron a alabar a Dios a gran voz por todas las maravillas que habían visto,", "words": [[0, 263596], [2, 263681], [7, 263921], [16, 264481], [19, 264661], [25, 264961], [28, 265201], [31, 265301], [38, 265701], [42, 265881], [48, 266201], [51, 266421], [55, 266541], [63, 267501], [68, 267861], [71, 268331], [80, 268801], [83, 269041], [87, 269181], [99, 270701], [110, 271890], [121, 272474], [123, 272794], [130, 273214], [132, 273294], [137, 273474], [139, 273714], [144, 273894], [148, 274214], [152, 274794], [158, 275134], [162, 275514], [173, 276114], [177, 276294], [184, 276474]]}, {"verse": 38, "start": 277626, "end": 284282, "text": "Diciendo: ¡Bendito el rey que viene en el nombre del Señor: paz en el cielo, y gloria en lo altísimo!", "words": [[0, 277626], [10, 278631], [19, 278954], [22, 279314], [26, 279554], [30, 279654], [36, 279914], [39, 280134], [42, 280254], [49, 280514], [53, 280714], [60, 281693], [64, 281823], [67, 281943], [70, 282043], [77, 282403], [79, 282903], [86, 283343], [89, 283463], [92, 283563]]}, {"verse": 39, "start": 284632, "end": 290929, "text": "Entonces algunos de los fariseos de la multitud, le dijeron: Maestro, reprende a tus discípulos.", "words": [[0, 284632], [9, 285098], [17, 285598], [20, 285838], [24, 285938], [33, 286658], [36, 286758], [39, 286858], [49, 287458], [52, 287958], [61, 288856], [70, 289317], [79, 289937], [81, 289977], [85, 290097]]}, {"verse": 40, "start": 291279, "end": 296991, "text": "Y él respondiendo, les dijo: Os digo que si estos callan, las piedras clamarán.", "words": [[0, 291279], [2, 291444], [5, 291604], [19, 292344], [23, 292484], [29, 293270], [32, 293540], [37, 293880], [41, 294120], [44, 294340], [50, 294640], [58, 295600], [62, 295780], [70, 296200]]}, {"verse": 41, "start": 297441, "end": 301300, "text": "Y cuando llegó cerca, viendo la ciudad, lloró sobre ella,", "words": [[0, 297441], [2, 297547], [9, 297707], [15, 298067], [22, 298687], [29, 298847], [32, 299107], [40, 299887], [46, 300407], [52, 300707]]}, {"verse": 42, "start": 301750, "end": 311020, "text": "Diciendo: ¡Oh si también tú conocieses, a lo menos en este tu día, lo que toca a tu paz! pero ahora está encubierto de tus ojos.", "words": [[0, 301750], [10, 302872], [14, 302972], [17, 303132], [25, 303492], [28, 303772], [40, 304272], [42, 304772], [45, 305272], [51, 305532], [54, 305792], [59, 305972], [62, 306172], [67, 306972], [70, 307072], [74, 307192], [79, 307472], [81, 307672], [84, 307772], [89, 308534], [94, 308695], [100, 308915], [105, 309255], [116, 310035], [119, 310175], [123, 310335]]}, {"verse": 43, "start": 311470, "end": 321297, "text": "Porque vendrán días sobre ti, que tus enemigos te rodearán con una barrera de asedio, y te pondrán cerco, y de todas partes te pondrán en estrecho,", "words": [[0, 311470], [7, 311693], [15, 312233], [20, 312473], [26, 312873], [30, 313413], [34, 313713], [38, 313833], [47, 314333], [50, 314493], [59, 315193], [63, 315373], [67, 315593], [75, 316013], [78, 316383], [86, 316753], [88, 317113], [91, 317233], [99, 317713], [106, 318333], [108, 318773], [111, 318933], [117, 319113], [124, 319773], [127, 319953], [135, 320413], [138, 320553]]}, {"verse": 44, "start": 321747, "end": 333661, "text": "Y te derribarán a tierra, y a tus hijos dentro de ti; y no dejarán sobre ti piedra sobre piedra; por cuanto no conociste el tiempo de tu visitación.", "words": [[0, 321747], [2, 321916], [5, 322056], [16, 322896], [18, 322996], [26, 323436], [28, 324296], [30, 324396], [34, 324556], [40, 324956], [47, 325836], [50, 326256], [54, 326924], [56, 327286], [59, 327446], [67, 327946], [73, 328186], [76, 328426], [83, 328946], [89, 329186], [97, 330218], [101, 330339], [108, 330559], [111, 330879], [121, 331559], [124, 331759], [131, 332099], [134, 332359], [137, 332539]]}, {"verse": 45, "start": 334111, "end": 340417, "text": "Y entrando en el templo, comenzó a echar fuera a todos los que vendían y compraban en él.", "words": [[0, 334111], [2, 334269], [11, 334789], [14, 334969], [17, 335109], [25, 336029], [33, 336609], [35, 336689], [41, 336929], [47, 337229], [49, 337629], [55, 337869], [59, 338149], [63, 338369], [71, 338969], [73, 339189], [83, 339909], [86, 340069]]}, {"verse": 46, "start": 340867, "end": 350066, "text": "Diciéndoles: Escrito está: Mi casa, casa de oración es; pero vosotros la habéis hecho cueva de ladrones.", "words": [[0, 340867], [13, 342398], [21, 343040], [27, 343836], [30, 344003], [36, 344843], [41, 345203], [44, 345463], [52, 346243], [56, 346865], [61, 347027], [70, 347587], [73, 347927], [80, 348307], [86, 348667], [92, 349107], [95, 349227]]}, {"verse": 47, "start": 350516, "end": 359463, "text": "Y enseñaba cada día en el templo; pero los principales sacerdotes, y los escribas, y los principales del pueblo procuraban matarle.", "words": [[0, 350516], [2, 350639], [11, 351259], [16, 351479], [20, 351819], [23, 351999], [26, 352139], [34, 353229], [39, 353371], [43, 353531], [55, 354271], [67, 355011], [69, 355191], [73, 355311], [83, 356251], [85, 356591], [89, 356731], [101, 357411], [105, 357571], [112, 357971], [123, 358691]]}, {"verse": 48, "start": 359913, "end": 365271, "text": "Y no hallaban qué hacerle, porque todo el pueblo estaba muy atento oyéndole.", "words": [[0, 359913], [2, 360039], [5, 360159], [14, 360579], [18, 360779], [27, 361679], [34, 361999], [39, 362279], [42, 362539], [49, 362839], [56, 363219], [60, 363619], [67, 364239]]}]}