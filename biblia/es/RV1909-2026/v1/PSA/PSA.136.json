{"book": "PSA", "chapter": 136, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 153973, "verses": [{"verse": 1, "start": 300, "end": 5827, "text": "Alabad a Jehová, porque es bueno; porque para siempre es su misericordia.", "words": [[0, 594], [7, 924], [9, 1144], [17, 1564], [24, 1824], [27, 2064], [34, 2862], [41, 3104], [46, 3324], [54, 3904], [57, 4379], [60, 4699]]}, {"verse": 2, "start": 6177, "end": 11299, "text": "Alabad al Dios de los dioses, porque para siempre es su misericordia.", "words": [[0, 6508], [7, 6868], [10, 7128], [15, 7528], [18, 7688], [22, 7848], [30, 8388], [37, 8888], [42, 9168], [50, 9588], [53, 9968], [56, 10208]]}, {"verse": 3, "start": 11649, "end": 17387, "text": "Alabad al Señor de los señores, porque para siempre es su misericordia.", "words": [[0, 11649], [7, 12315], [10, 12555], [16, 12915], [19, 13175], [23, 13315], [32, 14255], [39, 14775], [44, 15055], [52, 15495], [55, 15835], [58, 16035]]}, {"verse": 4, "start": 17737, "end": 22752, "text": "Al solo que hace grandes maravillas, porque para siempre es su misericordia.", "words": [[0, 17737], [3, 17932], [8, 18172], [12, 18392], [17, 18632], [25, 19012], [37, 20132], [44, 20552], [49, 20812], [57, 21132], [60, 21412], [63, 21792]]}, {"verse": 5, "start": 23102, "end": 28611, "text": "Al que hizo los cielos con entendimiento, porque para siempre es su misericordia.", "words": [[0, 23102], [3, 23263], [7, 23403], [12, 23663], [16, 23883], [23, 24563], [27, 24763], [42, 25963], [49, 26203], [54, 26483], [62, 26983], [65, 27343], [68, 27483]]}, {"verse": 6, "start": 28961, "end": 35153, "text": "Al que tendió la tierra sobre las aguas, porque para siempre es su misericordia;", "words": [[0, 29065], [3, 29175], [7, 29315], [14, 29735], [17, 29875], [24, 30365], [30, 30855], [34, 31075], [41, 31795], [48, 32015], [53, 32275], [61, 32675], [64, 32995], [67, 33135]]}, {"verse": 7, "start": 35503, "end": 41019, "text": "Al que hizo las grandes luminarias, porque para siempre es su misericordia;", "words": [[0, 35503], [3, 35727], [7, 35907], [12, 36407], [16, 36827], [24, 37227], [36, 37967], [43, 38607], [48, 38927], [56, 39407], [59, 39827], [62, 39967]]}, {"verse": 8, "start": 41369, "end": 46338, "text": "El sol para que dominase en el día, porque para siempre es su misericordia;", "words": [[0, 41369], [3, 41553], [7, 41913], [12, 42253], [16, 42633], [25, 43013], [28, 43193], [31, 43333], [36, 43953], [43, 44293], [48, 44513], [56, 44973], [59, 45233], [62, 45353]]}, {"verse": 9, "start": 46688, "end": 53154, "text": "La luna y las estrellas para que dominasen en la noche, porque para siempre es su misericordia.", "words": [[0, 46688], [3, 46894], [8, 47294], [10, 47394], [14, 47554], [24, 48194], [29, 48394], [33, 48804], [43, 49214], [46, 49334], [49, 49494], [56, 49854], [63, 50454], [68, 50774], [76, 51334], [79, 51814], [82, 52074]]}, {"verse": 10, "start": 53504, "end": 59330, "text": "Al que hirió a Egipto en sus primogénitos, porque para siempre es su misericordia.", "words": [[0, 53504], [3, 53803], [7, 54103], [13, 54403], [15, 54523], [22, 55083], [25, 55223], [29, 55403], [43, 56703], [50, 57303], [55, 57563], [63, 57983], [66, 58283], [69, 58383]]}, {"verse": 11, "start": 59680, "end": 65571, "text": "Al que sacó a Israel de en medio de ellos, porque para siempre es su misericordia;", "words": [[0, 59736], [3, 59826], [7, 59946], [12, 60506], [14, 60686], [21, 61286], [24, 61606], [27, 61766], [33, 62006], [36, 62266], [43, 62766], [50, 63126], [55, 63406], [63, 63886], [66, 64386], [69, 64546]]}, {"verse": 12, "start": 65921, "end": 71152, "text": "Con mano fuerte, y brazo extendido, porque para siempre es su misericordia.", "words": [[0, 65921], [4, 66028], [9, 66308], [17, 66828], [19, 67128], [25, 67508], [36, 68448], [43, 68768], [48, 68988], [56, 69448], [59, 69868], [62, 70028]]}, {"verse": 13, "start": 71502, "end": 77632, "text": "Al que dividió el mar Rojo en partes, porque para si