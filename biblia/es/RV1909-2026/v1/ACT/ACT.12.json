{"book": "ACT", "chapter": 12, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 248584, "verses": [{"verse": 1, "start": 300, "end": 6158, "text": "Y en el mismo tiempo el rey Herodes echó mano a maltratar algunos de la iglesia.", "words": [[0, 300], [2, 452], [5, 592], [8, 712], [14, 1012], [21, 1552], [24, 1932], [28, 2392], [36, 2912], [41, 3632], [46, 3892], [48, 4052], [58, 4952], [66, 5252], [69, 5472], [72, 5572]]}, {"verse": 2, "start": 6608, "end": 9939, "text": "Y mató con espada a Jacobo, hermano de Juan.", "words": [[0, 6608], [2, 6721], [7, 7081], [11, 7241], [18, 7701], [20, 7921], [28, 8841], [36, 9281], [39, 9361]]}, {"verse": 3, "start": 10389, "end": 20573, "text": "Y viendo que había agradado a los judíos, pasó adelante para prender también a Pedro. Eran entonces los días de los panes sin levadura.", "words": [[0, 10389], [2, 10513], [9, 10813], [13, 11033], [19, 11543], [28, 12053], [30, 12173], [34, 12293], [42, 13193], [47, 13693], [56, 14313], [61, 14713], [69, 15113], [77, 15613], [79, 15833], [86, 16830], [91, 17055], [100, 17955], [104, 18395], [109, 18715], [112, 18875], [116, 18995], [122, 19595], [126, 19755]]}, {"verse": 4, "start": 21023, "end": 31122, "text": "Y habiéndole preso, le puso en la cárcel, entregándole a cuatro grupos de cuatro soldados que le guardasen; queriendo sacarle al pueblo después de la Pascua.", "words": [[0, 21023], [2, 21165], [13, 21645], [20, 22405], [23, 22485], [28, 22865], [31, 23025], [34, 23165], [42, 24205], [55, 25225], [57, 25345], [64, 25665], [71, 26185], [74, 26385], [81, 26605], [90, 27285], [94, 27425], [97, 27952], [108, 28732], [118, 29074], [126, 29634], [129, 29774], [136, 30154], [144, 30474], [147, 30690], [150, 30906]]}, {"verse": 5, "start": 31572, "end": 38974, "text": "Así que, Pedro era guardado en la cárcel; y la iglesia hacía sin cesar oración a Dios por él.", "words": [[0, 31572], [4, 32175], [9, 32375], [15, 32695], [19, 32955], [28, 33535], [31, 33635], [34, 33755], [42, 34767], [44, 34913], [47, 35033], [55, 35573], [61, 36153], [65, 36733], [71, 37273], [79, 37793], [81, 38053], [86, 38273], [90, 38613]]}, {"verse": 6, "start": 39424, "end": 52051, "text": "Y cuando Herodes le había de sacar, aquella misma noche estaba Pedro durmiendo entre dos soldados, preso con dos cadenas, y los guardas delante de la puerta, que guardaban la cárcel.", "words": [[0, 39424], [2, 39526], [9, 39826], [17, 40526], [20, 40946], [26, 41246], [29, 41446], [36, 41846], [44, 42446], [50, 42686], [56, 43006], [63, 43366], [69, 43786], [79, 44546], [85, 44846], [89, 45106], [99, 45846], [105, 46546], [109, 46726], [113, 46906], [122, 47486], [124, 47926], [128, 48086], [136, 48686], [144, 49406], [147, 49586], [150, 49686], [158, 50607], [162, 50689], [172, 51169], [175, 51349]]}, {"verse": 7, "start": 52501, "end": 67949, "text": "Y he aquí, el ángel del Señor sobrevino, y una luz resplandeció en la cárcel; y golpeando a Pedro en el costado, le despertó, diciendo: Levántate rápidamente. Y las cadenas se le cayeron de las manos.", "words": [[0, 52501], [2, 52701], [5, 52881], [11, 53201], [14, 53441], [20, 53901], [24, 54061], [30, 54421], [41, 55701], [43, 56041], [47, 56321], [51, 56921], [64, 58461], [67, 58601], [70, 58741], [78, 59677], [80, 59960], [90, 60580], [92, 60740], [98, 61020], [101, 61220], [104, 61320], [113, 61860], [116, 62000], [126, 62600], [136, 63566], [146, 64106], [159, 65408], [161, 65530], [165, 65670], [173, 66310], [176, 66590], [179, 66730], [187, 67210], [190, 67310], [194, 67430]]}, {"verse": 8, "start": 68399, "end": 78161, "text": "Y le dijo el ángel: Cíñete, y átate tus sandalias. Y lo hizo así. Y le dijo: Envuélvete en tu manto, y sígueme.", "words": [[0, 68399], [2, 68525], [5, 68605], [10, 68865], [13, 69025], [20, 70140], [28, 70480], [30, 70700], [36, 71040], [40, 71200], [51, 72347], [53, 72514], [56, 72654], [61, 72874], [66, 73720], [68, 73887], [71, 73967], [77, 74766], [88, 75431], [91, 75532], [94, 75651], [101, 76111], [103, 76691]]}, {"verse": 9, "start": 78511, "end": 85426, "text": "Y saliendo, le seguía; y no sabía que era verdad lo que hacía el ángel, pero pensaba que veía visión.", "words": [[0, 78511], [2, 78616], [12, 79116], [15, 79296], [23, 80274], [25, 80401], [28, 80541], [34, 80941], [38, 81121], [42, 81301], [49, 81601], [52, 81981], [56, 82141], [62, 82401], [65, 82621], [72, 83361], [77, 83681], [85, 84181], [89, 84341], [94, 84721]]}, {"verse": 10, "start": 85876, "end": 101308, "text": "Y como pasaron la primera y la segunda guardia, vinieron a la puerta de hierro que va a la ciudad, la cual se les abrió por sí sola: y salidos, pasaron una calle; y de inmediato el ángel se apartó de él.", "words": [[0, 85876], [2, 85991], [7, 86231], [15, 86791], [18, 86971], [26, 87311], [28, 87611], [31, 87731], [39, 88111], [48, 89151], [57, 89751], [59, 89951], [62, 90011], [69, 90351], [72, 90821], [79, 91291], [83, 91451], [86, 91671], [88, 91751], [91, 91851], [99, 92871], [102, 92971], [107, 93211], [110, 93411], [114, 93551], [120, 94011], [124, 94231], [127, 94471], [133, 95401], [135, 95727], [144, 96347], [152, 97347], [156, 97567], [163, 98454], [165, 98581], [168, 98681], [178, 99461], [181, 99601], [187, 100041], [190, 100201], [197, 100741], [200, 100901]]}, {"verse": 11, "start": 101758, "end": 113563, "text": "Entonces Pedro, volviendo en sí, dijo: Ahora entiendo verdaderamente que el Señor ha enviado su ángel, y me ha librado de la mano de Herodes, y de todo lo que el pueblo de los judíos esperaba.", "words": [[0, 101758], [9, 102695], [16, 103295], [26, 103775], [29, 103975], [33, 104535], [39, 105233], [45, 105491], [54, 105991], [69, 106751], [73, 107011], [76, 107111], [82, 107371], [85, 107611], [93, 107991], [96, 108211], [103, 108651], [105, 108991], [108, 109111], [111, 109191], [119, 109611], [122, 109731], [125, 109831], [130, 110071], [133, 110231], [142, 110611], [144, 111171], [147, 111291], [152, 111471], [155, 111671], [159, 111791], [162, 111911], [169, 112151], [172, 112311], [176, 112431], [183, 112891]]}, {"verse": 12, "start": 113913, "end": 124637, "text": "Y habiendo considerado esto, llegó a casa de María la madre de Juan, el que tenía por sobrenombre Marcos, donde muchos estaban juntos orando.", "words": [[0, 113913], [2, 114038], [11, 114378], [23, 115278], [29, 116218], [35, 116558], [37, 116798], [42, 117038], [45, 117278], [51, 117538], [54, 117778], [60, 118078], [63, 118278], [69, 119178], [72, 119258], [76, 119398], [82, 119738], [86, 120058], [98, 120958], [106, 121998], [112, 122158], [119, 122678], [127, 123198], [134, 123738]]}, {"verse": 13, "start": 125087, "end": 132069, "text": "Y tocando Pedro a la puerta del patio, salió una muchacha, para escuchar, llamada Rode:", "words": [[0, 125087], [2, 125210], [10, 125610], [16, 126090], [18, 126450], [21, 126530], [28, 126790], [32, 127070], [39, 127930], [45, 128390], [49, 128590], [59, 129250], [64, 129870], [74, 130790], [82, 131461]]}, {"verse": 14, "start": 132519, "end": 142025, "text": "La cual como conoció la voz de Pedro, de gozo no abrió la puerta, sino corriendo adentro, dio la noticia de que Pedro estaba a la puerta.", "words": [[0, 132519], [3, 132647], [8, 133167], [13, 133467], [21, 134007], [24, 134147], [28, 134347], [31, 134467], [38, 135347], [41, 135387], [46, 135687], [49, 135907], [55, 136227], [58, 136367], [66, 137187], [71, 137307], [81, 137867], [90, 138987], [94, 139307], [97, 139467], [105, 140067], [108, 140267], [112, 140407], [118, 140867], [125, 141207], [127, 141387], [130, 141427]]}, {"verse": 15, "start": 142475, "end": 151953, "text": "Y ellos le dijeron: Estás loca. Pero ella afirmaba que así era. Entonces ellos decían: Su ángel es.", "words": [[0, 142475], [2, 142735], [8, 143015], [11, 143275], [20, 144308], [26, 144608], [32, 145485], [37, 145651], [42, 145971], [51, 147111], [55, 147331], [59, 147551], [64, 148488], [73, 149112], [79, 149752], [87, 151039], [90, 151341], [96, 151677]]}, {"verse": 16, "start": 152303, "end": 159464, "text": "Pero Pedro perseveraba en llamar: y cuando abrieron, le vieron, y se espantaron.", "words": [[0, 152303], [5, 152487], [11, 153027], [23, 154267], [26, 154547], [34, 155474], [36, 155579], [43, 155779], [53, 156779], [56, 156879], [64, 157319], [66, 158059], [69, 158259]]}, {"verse": 17, "start": 159914, "end": 174744, "text": "Pero él haciéndoles con la mano señal de que callasen, les contó cómo el Señor le había sacado de la cárcel. Y dijo: Haced saber esto a Jacobo y a los hermanos. Y salió, y partió a otro lugar.", "words": [[0, 159914], [5, 160076], [8, 160556], [20, 161296], [24, 161556], [27, 161716], [32, 161956], [38, 162516], [41, 162636], [45, 163266], [55, 163896], [59, 163996], [65, 164516], [70, 164776], [73, 164916], [79, 165256], [82, 165776], [88, 165976], [95, 166496], [98, 166636], [101, 166776], [109, 167818], [111, 167947], [117, 168839], [123, 168999], [129, 169319], [134, 169579], [136, 169719], [143, 170179], [145, 170259], [147, 170319], [151, 170419], [161, 171466], [163, 171650], [170, 172090], [172, 172730], [179, 173330], [181, 173610], [186, 173930]]}, {"verse": 18, "start": 175194, "end": 181655, "text": "Luego que fue de día, hubo no poco alboroto entre los soldados sobre qué se había hecho de Pedro.", "words": [[0, 175194], [6, 175555], [10, 175835], [14, 176055], [17, 176235], [22, 177135], [27, 177515], [30, 177635], [35, 177915], [44, 178595], [50, 178875], [54, 179095], [63, 179695], [69, 179955], [73, 180155], [76, 180355], [82, 180575], [88, 180875], [91, 181075]]}, {"verse": 19, "start": 182105, "end": 194146, "text": "Pero Herodes, como le buscó y no le halló, tras interrogar a los guardias, mandó que los llevaran a ejecutar. Después descendiendo de Judea a Cesarea, se quedó allí.", "words": [[0, 182105], [5, 182311], [14, 182751], [19, 183151], [22, 183311], [28, 183911], [30, 184131], [33, 184291], [36, 184451], [43, 185271], [48, 185631], [59, 186291], [61, 186371], [65, 186511], [75, 187371], [81, 187811], [85, 187931], [89, 188071], [98, 188651], [100, 188791], [110, 189937], [118, 190702], [131, 191442], [134, 191602], [140, 192169], [142, 192735], [151, 193302], [154, 193382], [160, 193702]]}, {"verse": 20, "start": 194596, "end": 210910, "text": "Y Herodes estaba enojado contra los de Tiro y los de Sidón: pero ellos vinieron concordes a él, y sobornado Blasto, que era el encargado de la cámara del rey, pedían paz; porque las tierras de ellos eran abastecidas por las del rey.", "words": [[0, 194596], [2, 194776], [10, 195156], [17, 195556], [25, 196116], [32, 196476], [36, 196696], [39, 196896], [44, 197316], [46, 197496], [50, 197656], [53, 197876], [60, 198698], [65, 198862], [71, 199102], [80, 199742], [90, 200382], [92, 200522], [96, 200722], [98, 200982], [108, 201782], [116, 202742], [120, 202822], [124, 203062], [127, 203302], [137, 203982], [140, 204142], [143, 204262], [150, 204662], [154, 204822], [159, 205502], [166, 205922], [171, 206766], [178, 206988], [182, 207188], [190, 207808], [193, 208028], [199, 208348], [204, 208668], [216, 209648], [220, 209948], [224, 210168], [228, 210428]]}, {"verse": 21, "start": 211360, "end": 217896, "text": "Y un día señalado, Herodes vestido de ropa real, se sentó en el tribunal, y les arengó.", "words": [[0, 211360], [2, 211624], [5, 211744], [9, 212004], [19, 212554], [27, 213104], [35, 213744], [38, 213884], [43, 214294], [49, 214704], [52, 215084], [58, 215524], [61, 215604], [64, 215724], [74, 216324], [76, 217084], [80, 217516]]}, {"verse": 22, "start": 218346, "end": 225523, "text": "Y el pueblo aclamaba: Voz de Dios, y no de hombre.", "words": [[0, 218346], [2, 218494], [5, 218614], [12, 219074], [22, 220189], [26, 220433], [29, 220613], [35, 220873], [37, 221273], [40, 221393], [43, 221533]]}, {"verse": 23, "start": 225873, "end": 233972, "text": "Y luego el ángel del Señor le hirió, por cuanto no dio la gloria a Dios; y murió comido de gusanos.", "words": [[0, 225873], [2, 226014], [8, 226314], [11, 226714], [17, 227174], [21, 227314], [27, 227754], [30, 228054], [37, 228514], [41, 229414], [48, 229714], [51, 230114], [55, 230334], [58, 230554], [65, 231054], [67, 231274], [73, 232177], [75, 232280], [81, 232600], [88, 233000], [91, 233140]]}, {"verse": 24, "start": 234422, "end": 237916, "text": "Pero la palabra del Señor crecía y era multiplicada.", "words": [[0, 234422], [5, 234711], [8, 234891], [16, 235231], [20, 235431], [26, 235771], [33, 236371], [35, 236631], [39, 236851]]}, {"verse": 25, "start": 238366, "end": 248184, "text": "Y Bernabé y Saulo volvieron de Jerusalén cumplido su servicio, tomando también consigo a Juan, el que tenía por sobrenombre Marcos.", "words": [[0, 238366], [2, 238505], [10, 239125], [12, 239285], [18, 239745], [28, 240305], [31, 240505], [41, 241145], [50, 241705], [53, 241865], [63, 242825], [71, 243425], [79, 243825], [87, 244345], [89, 244585], [95, 245425], [98, 245665], [102, 245785], [108, 246105], [112, 246365], [124, 247285]]}]}