{"book": "ROM", "chapter": 1, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 228808, "verses": [{"verse": 1, "start": 300, "end": 5292, "text": "Paul, a servant of Jesus Christ, called to be an apostle, separated to the gospel of God,", "words": [[0, 300], [6, 704], [8, 784], [16, 1044], [19, 1264], [25, 1504], [33, 2204], [40, 2304], [43, 2484], [46, 2604], [49, 2704], [58, 3504], [68, 3984], [71, 4264], [75, 4384], [82, 4664], [85, 4864]]}, {"verse": 2, "start": 5742, "end": 8716, "text": "(Which he had promised before by his prophets in the holy scriptures,)", "words": [[0, 5742], [7, 5900], [10, 6020], [14, 6100], [23, 6380], [30, 6760], [33, 7000], [37, 7180], [46, 7540], [49, 7760], [53, 7860], [58, 8020]]}, {"verse": 3, "start": 9166, "end": 14558, "text": "Concerning his Son Jesus Christ our Lord, which was made of the seed of David according to the flesh;", "words": [[0, 9166], [11, 9580], [15, 9820], [19, 10120], [25, 10380], [32, 10860], [36, 11120], [42, 11920], [48, 12040], [52, 12200], [57, 12480], [60, 12640], [64, 12720], [69, 12940], [72, 13040], [78, 13340], [88, 13660], [91, 13900], [95, 14020]]}, {"verse": 4, "start": 15008, "end": 21433, "text": "And declared to be the Son of God with power, according to the spirit of holiness, by the resurrection from the dead:", "words": [[0, 15008], [4, 15125], [13, 15465], [16, 15705], [19, 15825], [23, 15925], [27, 16105], [30, 16225], [34, 16465], [39, 16685], [46, 17065], [56, 17745], [59, 18005], [63, 18145], [70, 18505], [73, 18765], [83, 19225], [86, 19845], [90, 19985], [103, 20445], [108, 20905], [112, 21045]]}, {"verse": 5, "start": 21883, "end": 27759, "text": "By whom we have received grace and apostleship, for obedience to the faith among all nations, for his name:", "words": [[0, 21883], [3, 22058], [8, 22298], [11, 22498], [16, 22638], [25, 23058], [31, 23458], [35, 23718], [48, 24658], [52, 24798], [62, 25178], [65, 25478], [69, 25598], [75, 25838], [81, 26118], [85, 26458], [94, 27118], [98, 27218], [102, 27378]]}, {"verse": 6, "start": 28209, "end": 30898, "text": "Among whom are you also the called of Jesus Christ:", "words": [[0, 28209], [6, 28410], [11, 28770], [15, 29030], [19, 29190], [24, 29470], [28, 29630], [35, 29870], [38, 30010], [44, 30230]]}, {"verse": 7, "start": 31348, "end": 38153, "text": "To all that be in Rome, beloved of God, called to be saints: Grace to you and peace from God our Father, and the Lord Jesus Christ.", "words": [[0, 31348], [3, 31444], [7, 31624], [12, 31784], [15, 32004], [18, 32144], [24, 32565], [32, 32924], [35, 33044], [40, 33314], [47, 33584], [50, 33724], [53, 33844], [61, 34691], [67, 34935], [70, 35195], [74, 35335], [78, 35495], [84, 35675], [89, 35895], [93, 36095], [97, 36275], [105, 36615], [109, 36915], [113, 37015], [118, 37175], [124, 37455]]}, {"verse": 8, "start": 38603, "end": 44497, "text": "First, I thank my God through Jesus Christ for you all, that your faith is spoken of throughout the whole world.", "words": [[0, 38603], [7, 38786], [9, 39026], [15, 39286], [18, 39486], [22, 39746], [30, 39986], [36, 40346], [43, 40766], [47, 41046], [51, 41246], [56, 41886], [61, 42126], [66, 42266], [72, 42526], [75, 42726], [82, 43006], [85, 43206], [96, 43446], [100, 43746], [106, 43966]]}, {"verse": 9, "start": 44947, "end": 52927, "text": "For God is my witness, whom I serve with my spirit in the gospel of his Son, that without ceasing I make mention of you always in my prayers;", "words": [[0, 44947], [4, 45069], [8, 45369], [11, 45529], [14, 45729], [23, 46469], [28, 46709], [30, 46869], [36, 47129], [41, 47309], [44, 47449], [51, 47769], [54, 47969], [58, 48069], [65, 48389], [68, 48589], [72, 48729], [77, 49389], [82, 49529], [90, 49789], [98, 50369], [100, 50509], [105, 50709], [113, 51069], [116, 51269], [120, 51449], [127, 51929], [130, 52189], [133, 52329]]}, {"verse": 10, "start": 53377, "end": 59280, "text": "Making request, if by any means now at length I might have a prosperous journey by the will of God to come to you.", "words": [[0, 53377], [7, 53612], [16, 54092], [19, 54472], [22, 54692], [26, 54932], [32, 55192], [36, 55512], [39, 55652], [46, 55932], [48, 56292], [54, 56472], [59, 56672], [61, 56772], [72, 57152], [80, 57632], [83, 57812], [87, 57932], [92, 58112], [95, 58232], [99, 58472], [102, 58692], [107, 58892], [110, 59072]]}, {"verse": 11, "start": 59730, "end": 65532, "text": "For I long to see you, that I may impart to you some spiritual gift, to the end you may be established;", "words": [[0, 59730], [4, 59852], [6, 60052], [11, 60272], [14, 60472], [18, 60692], [23, 61112], [28, 61372], [30, 61492], [34, 61652], [41, 61952], [44, 62192], [48, 62412], [53, 62692], [63, 63112], [69, 63772], [72, 64012], [76, 64152], [80, 64372], [84, 64492], [88, 64632], [91, 64752]]}, {"verse": 12, "start": 65982, "end": 70394, "text": "That is, that I may be comforted together with you by the mutual faith both of you and me.", "words": [[0, 65982], [5, 66196], [9, 66356], [14, 66556], [16, 66776], [20, 66956], [23, 67076], [33, 67556], [42, 67796], [47, 68056], [51, 68236], [54, 68416], [58, 68536], [65, 68796], [71, 69116], [76, 69416], [79, 69576], [83, 69776], [87, 70036]]}, {"verse": 13, "start": 70844, "end": 80852, "text": "Now I would not have you ignorant, brethren, that often I purposed to come to you, (but was hindered until now,) that I might have some fruit among you also, even as among other Gentiles.", "words": [[0, 70844], [4, 71080], [6, 71280], [12, 71420], [16, 71660], [21, 71920], [25, 72040], [35, 72400], [45, 73360], [50, 73440], [56, 73720], [58, 73880], [67, 74320], [70, 74440], [75, 74600], [78, 74780], [83, 75180], [88, 75300], [92, 75480], [101, 75900], [107, 76160], [113, 76860], [118, 77020], [120, 77120], [126, 77260], [131, 77440], [136, 77600], [142, 77840], [148, 78080], [152, 78300], [158, 79091], [163, 79354], [166, 79594], [172, 79814], [178, 80364]]}, {"verse": 14, "start": 81302, "end": 86625, "text": "I am debtor both to the Greeks, and to the Barbarians; both to the wise, and to the unwise.", "words": [[0, 81302], [2, 81464], [5, 81564], [12, 81944], [17, 82164], [20, 82364], [24, 82484], [32, 82744], [36, 83264], [39, 83404], [43, 83504], [55, 84601], [60, 84780], [63, 84960], [67, 85080], [73, 85340], [77, 85760], [80, 85900], [84, 86020]]}, {"verse": 15, "start": 87075, "end": 92118, "text": "So, as much as in me is, I am ready to preach the gospel to you that are at Rome also.", "words": [[0, 87075], [4, 87188], [7, 87368], [12, 87608], [15, 87748], [18, 87908], [21, 88128], [25, 88588], [27, 88708], [30, 88828], [36, 89028], [39, 89208], [46, 89488], [50, 89708], [57, 90008], [60, 90308], [64, 90568], [69, 90928], [73, 91108], [76, 91248], [81, 91488]]}, {"verse": 16, "start": 92568, "end": 100767, "text": "For I am not ashamed of the gospel of Christ: for it is the power of God to salvation to every one that believes; to the Jew first, and also to the Greek.", "words": [[0, 92568], [4, 92674], [6, 92874], [9, 92994], [13, 93134], [21, 93434], [24, 93654], [28, 93734], [35, 93994], [38, 94214], [46, 95104], [50, 95232], [53, 95352], [56, 95472], [60, 95612], [66, 95872], [69, 96032], [73, 96212], [76, 96372], [86, 96852], [89, 97032], [95, 97212], [99, 97392], [104, 97692], [114, 98570], [117, 98656], [121, 98776], [125, 98936], [132, 99236], [136, 99796], [141, 100056], [144, 100236], [148, 100376]]}, {"verse": 17, "start": 101217, "end": 106883, "text": "For in it is the righteousness of God revealed from faith to faith: as it is written, The just shall live by faith.", "words": [[0, 101217], [4, 101360], [7, 101500], [10, 101620], [13, 101720], [17, 101840], [31, 102200], [34, 102500], [38, 102780], [47, 103220], [52, 103500], [58, 103780], [61, 103960], [68, 104572], [71, 104733], [74, 104873], [77, 104993], [86, 105493], [90, 105613], [95, 105833], [101, 106093], [106, 106313], [109, 106513]]}, {"verse": 18, "start": 107333, "end": 114710, "text": "For the wrath of God is revealed from heaven against all ungodliness and unrighteousness of men, who hold the truth in unrighteousness;", "words": [[0, 107333], [4, 107421], [8, 107541], [14, 107761], [17, 107941], [21, 108201], [24, 108441], [33, 108801], [38, 109001], [45, 109321], [53, 109701], [57, 110121], [69, 110841], [73, 111141], [89, 111921], [92, 112141], [97, 112381], [101, 112841], [106, 113081], [110, 113241], [116, 113541], [119, 113801]]}, {"verse": 19, "start": 115160, "end": 120182, "text": "Because that which may be known of God is manifest in them; for God has showed it to them.", "words": [[0, 115160], [8, 115346], [13, 115626], [19, 115886], [23, 116126], [26, 116246], [32, 116446], [35, 116626], [39, 116906], [42, 117286], [51, 117686], [54, 118106], [60, 118670], [64, 118795], [68, 119075], [72, 119335], [79, 119635], [82, 119795], [85, 119935]]}, {"verse": 20, "start": 120632, "end": 130916, "text": "For the invisible things of him from the creation of the world are clearly seen, being understood by the things that are made, even his eternal power and Godhead; so that they are without excuse:", "words": [[0, 120632], [4, 120757], [8, 120917], [18, 121257], [25, 121617], [28, 121877], [32, 122077], [37, 122277], [41, 122477], [50, 122857], [53, 123057], [57, 123197], [63, 123497], [67, 123797], [75, 124117], [81, 125117], [87, 125257], [98, 125697], [101, 126037], [105, 126177], [112, 126417], [117, 126597], [121, 126717], [127, 127177], [132, 127337], [136, 127557], [144, 127897], [150, 128397], [154, 128597], [163, 129465], [166, 129562], [171, 129702], [176, 129842], [180, 129942], [188, 130182]]}, {"verse": 21, "start": 131366, "end": 140332, "text": "Because that, when they knew God, they glorified him not as God, neither were thankful; but became vain in their imaginations, and their foolish heart was darkened.", "words": [[0, 131366], [8, 131551], [14, 132191], [19, 132371], [24, 132531], [29, 132711], [34, 133311], [39, 133411], [49, 134051], [53, 134251], [57, 134491], [60, 134671], [65, 135191], [73, 135351], [78, 135611], [88, 136478], [92, 136597], [99, 136917], [104, 137297], [107, 137457], [113, 137617], [127, 138357], [131, 138657], [137, 138777], [145, 139117], [151, 139517], [155, 139737]]}, {"verse": 22, "start": 140782, "end": 143759, "text": "Professing themselves to be wise, they became fools,", "words": [[0, 140782], [11, 141283], [22, 141663], [25, 141883], [28, 141983], [34, 142743], [39, 142843], [46, 143143]]}, {"verse": 23, "start": 144209, "end": 152366, "text": "And changed the glory of the uncorruptible God into an image made like to corruptible man, and to birds, and fourfooted beasts, and creeping things.", "words": [[0, 144209], [4, 144351], [12, 144691], [16, 144911], [22, 145171], [25, 145371], [29, 145491], [43, 146251], [47, 146511], [52, 146811], [55, 146991], [61, 147311], [66, 147671], [71, 147931], [74, 148071], [86, 148611], [91, 148891], [95, 149371], [98, 149491], [105, 149871], [109, 150311], [120, 150751], [128, 151091], [132, 151491], [141, 151791]]}, {"verse": 24, "start": 152816, "end": 159725, "text": "Therefore God also gave them up to uncleanness through the lusts of their own hearts, to dishonour their own bodies between themselves:", "words": [[0, 152816], [10, 153343], [14, 153603], [19, 153943], [24, 154203], [29, 154423], [32, 154623], [35, 154763], [47, 155483], [55, 155683], [59, 155823], [65, 156183], [68, 156183], [74, 156343], [78, 156543], [86, 156903], [89, 157373], [99, 157843], [105, 157983], [109, 158163], [116, 158543], [124, 158863]]}, {"verse": 25, "start": 160175, "end": 167439, "text": "Who changed the truth of God into a lie, and worshipped and served the creature more than the Creator, who is blessed for ever. Amen.", "words": [[0, 160175], [4, 160260], [12, 160580], [16, 160800], [22, 161020], [25, 161240], [29, 161500], [34, 161820], [36, 161980], [41, 162240], [45, 162690], [56, 163140], [60, 163260], [67, 163540], [71, 163680], [80, 163940], [85, 164220], [90, 164400], [94, 164520], [103, 165280], [107, 165360], [110, 165480], [118, 165867], [122, 166253], [128, 166905]]}, {"verse": 26, "start": 167889, "end": 175334, "text": "For this cause God gave them up to vile affections: for even their women did change the natural use into that which is against nature:", "words": [[0, 167889], [4, 167970], [9, 168170], [15, 168470], [19, 168790], [24, 169130], [29, 169350], [32, 169550], [35, 169690], [40, 170110], [52, 171072], [56, 171180], [61, 171500], [67, 171760], [73, 172060], [77, 172360], [84, 172700], [88, 172900], [96, 173220], [100, 173560], [105, 173920], [110, 174160], [116, 174400], [119, 174540], [127, 174780]]}, {"verse": 27, "start": 175784, "end": 188007, "text": "And likewise also the men, leaving the natural use of the woman, burned in their lust one toward another; men with men working that which is unseemly, and receiving in themselves that recompence of their error which was meet.", "words": [[0, 175784], [4, 175967], [13, 176387], [18, 176887], [22, 177087], [27, 177367], [35, 177887], [39, 178107], [47, 178487], [51, 178847], [54, 179007], [58, 179107], [65, 179367], [72, 179947], [75, 180127], [81, 180347], [86, 180567], [90, 180827], [97, 181087], [106, 181899], [110, 182098], [115, 182258], [119, 182478], [127, 182818], [132, 183078], [138, 183318], [141, 183458], [151, 184038], [155, 184478], [165, 184858], [168, 185058], [179, 185478], [184, 185978], [195, 186478], [198, 186618], [204, 186778], [210, 187098], [216, 187398], [220, 187728]]}, {"verse": 28, "start": 188457, "end": 195964, "text": "And even as they did not like to retain God in their knowledge, God gave them over to a reprobate mind, to do those things which are not convenient;", "words": [[0, 188457], [4, 188581], [9, 188741], [12, 188921], [17, 189061], [21, 189281], [25, 189421], [30, 189641], [33, 189781], [40, 190101], [44, 190361], [47, 190521], [53, 190661], [64, 191401], [68, 191701], [73, 191941], [78, 192161], [83, 192341], [86, 192521], [88, 192661], [98, 193141], [104, 193741], [107, 193861], [110, 194041], [116, 194241], [123, 194581], [129, 194821], [133, 194981], [137, 195161]]}, {"verse": 29, "start": 196414, "end": 206512, "text": "Being filled with all unrighteousness, fornication, wickedness, covetousness, maliciousness; full of envy, murder, debate, deceit, malice; whisperers,", "words": [[0, 196414], [6, 196689], [13, 197069], [18, 197269], [22, 197429], [39, 198269], [52, 198969], [64, 199689], [78, 200629], [93, 201748], [98, 201882], [101, 201982], [107, 202682], [115, 203422], [123, 204222], [131, 204862], [139, 206117]]}, {"verse": 30, "start": 206962, "end": 213909, "text": "Backbiters, haters of God, despiteful, proud, boasters, inventors of evil things, disobedient to parents,", "words": [[0, 206962], [12, 207866], [19, 208106], [22, 208346], [27, 208906], [39, 209666], [46, 210306], [56, 211026], [66, 211506], [69, 211626], [74, 211886], [82, 212626], [94, 213306], [97, 213406]]}, {"verse": 31, "start": 214359, "end": 219680, "text": "Without understanding, covenantbreakers, without natural affection, implacable, unmerciful:", "words": [[0, 214359], [8, 214633], [23, 215583], [41, 216533], [49, 216833], [57, 217293], [68, 218193], [80, 219033]]}, {"verse": 32, "start": 220130, "end": 228408, "text": "Who knowing the judgment of God, that they which commit such things are worthy of death, not only do the same, but have pleasure in them that do them.", "words": [[0, 220130], [4, 220257], [12, 220557], [16, 220717], [25, 221057], [28, 221357], [33, 221677], [38, 222197], [43, 222437], [49, 222657], [56, 222937], [61, 223197], [68, 223557], [72, 223777], [79, 224117], [82, 224317], [89, 224597], [93, 225137], [98, 225397], [101, 225557], [105, 225697], [111, 226017], [115, 226517], [120, 226697], [129, 227057], [132, 227297], [137, 227557], [142, 227857], [145, 228097]]}]}