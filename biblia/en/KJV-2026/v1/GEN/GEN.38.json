{"book": "GEN", "chapter": 38, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 249295, "verses": [{"verse": 1, "start": 300, "end": 7544, "text": "And it came to pass at that time, that Judah went down from his brethren, and turned in to a certain Adullamite, whose name was Hirah.", "words": [[0, 300], [4, 428], [7, 508], [12, 728], [15, 888], [20, 1188], [23, 1368], [28, 1548], [34, 1928], [39, 2188], [45, 2468], [50, 2728], [55, 2988], [60, 3208], [64, 3368], [74, 3828], [78, 4308], [85, 4495], [88, 4681], [91, 4868], [93, 5128], [101, 5738], [113, 6348], [119, 6548], [124, 6828], [128, 7216]]}, {"verse": 2, "start": 7894, "end": 13735, "text": "And Judah saw there a daughter of a certain Canaanite, whose name was Shuah; and he took her, and went in to her.", "words": [[0, 7894], [4, 8021], [10, 8221], [14, 8601], [20, 8821], [22, 8981], [31, 9261], [34, 9521], [36, 9641], [44, 9861], [55, 10601], [61, 10841], [66, 11141], [70, 11505], [77, 12028], [81, 12154], [84, 12234], [89, 12474], [94, 12673], [98, 12933], [103, 13100], [106, 13266], [109, 13433]]}, {"verse": 3, "start": 14085, "end": 18303, "text": "And she conceived, and bore a son; and he called his name Er.", "words": [[0, 14085], [4, 14405], [8, 14545], [19, 15145], [23, 15405], [28, 15645], [30, 15765], [35, 16470], [39, 16600], [42, 16740], [49, 17060], [53, 17320], [58, 17833]]}, {"verse": 4, "start": 18653, "end": 23657, "text": "And she conceived again, and bore a son; and she called his name Onan.", "words": [[0, 18653], [4, 18780], [8, 18960], [18, 19420], [25, 19840], [29, 20280], [34, 20580], [36, 20720], [41, 21508], [45, 21828], [49, 21968], [56, 22248], [60, 22468], [65, 22768]]}, {"verse": 5, "start": 24007, "end": 31257, "text": "And she yet again conceived, and bore a son; and called his name Shelah: and he was at Chezib, when she bore him.", "words": [[0, 24007], [4, 24287], [8, 24467], [12, 24647], [18, 24927], [29, 25527], [33, 25967], [38, 26287], [40, 26387], [45, 27118], [49, 27439], [56, 27699], [60, 27919], [65, 28432], [73, 29119], [77, 29262], [80, 29402], [84, 29582], [87, 29862], [95, 30142], [100, 30402], [104, 30602], [109, 30862]]}, {"verse": 6, "start": 31607, "end": 35845, "text": "And Judah took a wife for Er his firstborn, whose name was Tamar.", "words": [[0, 31607], [4, 31732], [10, 31992], [15, 32292], [17, 32452], [22, 32772], [26, 33062], [29, 33352], [33, 33452], [44, 34572], [50, 34732], [55, 35012], [59, 35212]]}, {"verse": 7, "start": 36195, "end": 41142, "text": "And Er, Judah’s firstborn, was wicked in the sight of the LORD; and the LORD killed him.", "words": [[0, 36195], [4, 36306], [8, 36456], [16, 36916], [27, 37556], [31, 38076], [38, 38416], [41, 38636], [45, 38736], [51, 38956], [54, 39076], [58, 39216], [64, 39922], [68, 40044], [72, 40184], [77, 40404], [84, 40724]]}, {"verse": 8, "start": 41492, "end": 47029, "text": "And Judah said to Onan, Go in to your brother’s wife, and marry her, and raise up seed to your brother.", "words": [[0, 41492], [4, 41681], [10, 41901], [15, 42201], [18, 42381], [24, 43151], [27, 43268], [30, 43422], [33, 43575], [38, 43755], [48, 44155], [54, 44375], [58, 44795], [64, 45075], [69, 45315], [73, 45755], [79, 45975], [82, 46165], [87, 46355], [90, 46535], [95, 46655]]}, {"verse": 9, "start": 47309, "end": 57748, "text": "And Onan knew that the seed should not be his; and it came to pass, when he went in to his brother’s wife, that he spilled it on the ground, lest that he should give seed to his brother.", "words": [[0, 47309], [4, 47452], [9, 47832], [14, 48032], [19, 48192], [23, 48332], [28, 48572], [35, 48772], [39, 48972], [42, 49232], [47, 49925], [51, 50062], [54, 50162], [59, 50402], [62, 50602], [68, 51342], [73, 51662], [76, 51802], [81, 51969], [84, 52135], [87, 52302], [91, 52502], [101, 52922], [107, 53662], [112, 53862], [115, 53982], [123, 54242], [126, 54482], [129, 54602], [133, 54702], [141, 55422], [146, 55782], [151, 55942], [154, 56082], [161, 56242], [166, 56442], [171, 56802], [174, 57042], [178, 57202]]}, {"verse": 10, "start": 58098, "end": 62922, "text": "And the thing which he did displeased the LORD: therefore he killed him also.", "words": [[0, 58098], [4, 58267], [8, 58407], [14, 58647], [20, 58887], [23, 59067], [27, 59367], [38, 60087], [42, 60247], [48, 61037], [58, 61622], [61, 61722], [68, 62042], [72, 62242]]}, {"verse": 11, "start": 63272, "end": 78074, "text": "Then said Judah to Tamar his daughter in law, Remain a widow at your father’s house, till Shelah my son be grown: for he said, Lest perhaps he die also, as his brethren did. And Tamar went and dwelt in her father’s house.", "words": [[0, 63272], [5, 63712], [10, 64012], [16, 64372], [19, 64652], [25, 65092], [29, 65312], [38, 65652], [41, 65892], [46, 66595], [53, 66953], [55, 67133], [61, 67333], [64, 67673], [69, 67773], [78, 68293], [85, 68813], [90, 69153], [97, 69493], [100, 69633], [104, 69913], [107, 70073], [114, 70827], [118, 70986], [121, 71146], [127, 71892], [132, 72190], [140, 72570], [143, 72810], [147, 73010], [153, 73850], [156, 74050], [160, 74170], [169, 74530], [174, 75310], [178, 75465], [184, 75885], [189, 76145], [193, 76405], [199, 76765], [202, 76925], [206, 77065], [215, 77525]]}, {"verse": 12, "start": 78424, "end": 88845, "text": "¶ And in process of time the daughter of Shuah Judah’s wife died; and Judah was comforted, and went up to his sheepshearers to Timnath, he and his friend Hirah the Adullamite.", "words": [[2, 78424], [6, 78564], [9, 78684], [17, 79084], [20, 79404], [25, 79964], [29, 80024], [38, 80344], [41, 80644], [47, 80944], [55, 81484], [60, 81744], [66, 82716], [70, 82889], [76, 83109], [80, 83389], [91, 84209], [95, 84389], [100, 84589], [103, 84769], [106, 84949], [110, 85359], [124, 85769], [127, 85989], [136, 86869], [139, 86969], [143, 87149], [147, 87289], [154, 87629], [160, 87969], [164, 88442]]}, {"verse": 13, "start": 89195, "end": 94996, "text": "And it was told Tamar, saying, Behold your father in law goes up to Timnath to shear his sheep.", "words": [[0, 89195], [4, 89343], [7, 89443], [11, 89563], [16, 90043], [23, 90523], [31, 91268], [38, 91782], [43, 91862], [50, 92162], [53, 92422], [57, 92642], [62, 92902], [65, 93122], [68, 93282], [76, 93782], [79, 94122], [85, 94362], [89, 94602]]}, {"verse": 14, "start": 95346, "end": 108232, "text": "And she put her widow’s garments off from her, and covered her with a veil, and wrapped herself, and sat in an open place, which is by the way to Timnath; for she saw that Shelah was grown, and she was not given to him to wife.", "words": [[0, 95346], [4, 95474], [8, 95594], [12, 95794], [16, 95934], [24, 96334], [33, 96594], [37, 96954], [42, 97174], [47, 97394], [51, 97934], [59, 98214], [63, 98394], [68, 98574], [70, 98694], [76, 98994], [80, 99269], [88, 99529], [97, 99889], [101, 100609], [105, 100909], [108, 101129], [111, 101249], [116, 101429], [123, 102367], [129, 102493], [132, 102633], [135, 102813], [139, 102933], [143, 103073], [146, 103173], [155, 103947], [159, 104084], [163, 104284], [167, 104604], [172, 104824], [179, 105044], [183, 105364], [190, 105704], [194, 106264], [198, 106404], [202, 106564], [206, 106764], [212, 107064], [215, 107324], [219, 107484], [222, 107664]]}, {"verse": 15, "start": 108582, "end": 113393, "text": "When Judah saw her, he thought her to be a harlot; because she had covered her face.", "words": [[0, 108582], [5, 108786], [11, 109026], [15, 109446], [20, 110066], [23, 110146], [31, 110386], [35, 110546], [38, 110666], [41, 110846], [43, 110946], [51, 111720], [59, 111925], [63, 112145], [67, 112305], [75, 112605], [79, 112805]]}, {"verse": 16, "start": 113743, "end": 124454, "text": "And he turned to her by the way, and said, Go to, please, let me come in to you; (for he knew not that she was his daughter in law.) And she said, What will you give me, that you may come in to me?", "words": [[0, 113743], [4, 113869], [7, 113949], [14, 114209], [17, 114369], [21, 114549], [24, 114689], [28, 114809], [33, 115209], [37, 115309], [43, 115861], [46, 116063], [50, 116223], [58, 116843], [62, 116943], [65, 117063], [70, 117196], [73, 117330], [76, 117463], [81, 117926], [86, 118045], [89, 118205], [94, 118405], [98, 118665], [103, 118925], [107, 119145], [111, 119345], [115, 119505], [124, 119845], [127, 120065], [133, 120665], [137, 120825], [141, 121025], [147, 121756], [152, 121914], [157, 122154], [161, 122334], [166, 122574], [170, 122854], [175, 123214], [179, 123394], [183, 123554], [188, 123727], [191, 123901], [194, 124074]]}, {"verse": 17, "start": 124734, "end": 131617, "text": "And he said, I will send you a kid from the flock. And she said, Will you give me a pledge, till you send it?", "words": [[0, 124734], [4, 124869], [7, 125009], [13, 126418], [15, 126543], [20, 126663], [25, 126923], [29, 127043], [31, 127143], [35, 127343], [40, 127563], [44, 127683], [51, 128501], [55, 128605], [59, 128765], [65, 129395], [70, 129535], [74, 129675], [79, 129875], [82, 130035], [84, 130115], [92, 130415], [97, 130755], [101, 130915], [106, 131175]]}, {"verse": 18, "start": 131897, "end": 144311, "text": "And he said, What pledge shall I give you? And she said, Your signet, and your bracelets, and your staff that is in your hand. And he gave it her, and came in to her, and she conceived by him.", "words": [[0, 131897], [4, 132032], [7, 132172], [13, 133580], [18, 133722], [25, 134062], [31, 134322], [33, 134462], [38, 134642], [43, 135202], [47, 135306], [51, 135466], [57, 136240], [62, 136394], [70, 136547], [74, 136767], [79, 136887], [90, 137367], [94, 137907], [99, 138107], [105, 138527], [110, 138887], [113, 139007], [116, 139227], [121, 139367], [127, 140182], [131, 140321], [134, 140421], [139, 140681], [142, 140821], [147, 141061], [151, 141501], [156, 141694], [159, 141888], [162, 142081], [167, 142361], [171, 142901], [175, 143081], [185, 143561], [188, 143901]]}, {"verse": 19, "start": 144661, "end": 150520, "text": "And she arose, and went away, and laid by her veil from her, and put on the garments of her widowhood.", "words": [[0, 144661], [4, 144805], [8, 144965], [15, 145345], [19, 145645], [24, 145865], [30, 146285], [34, 146590], [39, 146830], [42, 147090], [46, 147270], [51, 147550], [56, 147850], [61, 148110], [65, 148550], [69, 148770], [72, 148910], [76, 149050], [85, 149390], [88, 149710], [92, 149850]]}, {"verse": 20, "start": 150870, "end": 158083, "text": "And Judah sent the kid by the hand of his friend the Adullamite, to receive his pledge from the woman’s hand: but he found her not.", "words": [[0, 150870], [4, 151066], [10, 151296], [15, 151636], [19, 151796], [23, 152056], [26, 152296], [30, 152436], [35, 152716], [38, 152836], [42, 152976], [49, 153276], [53, 153696], [65, 154116], [68, 154536], [76, 154936], [80, 155136], [87, 155456], [92, 155736], [96, 155876], [104, 156316], [110, 156951], [114, 157069], [117, 157169], [123, 157449], [127, 157669]]}, {"verse": 21, "start": 158433, "end": 167581, "text": "Then he asked the men of that place, saying, Where is the harlot, that was openly by the way side? And they said, There was no harlot in this place.", "words": [[0, 158433], [5, 158755], [8, 159015], [14, 159335], [18, 159635], [22, 159875], [25, 160015], [30, 160235], [37, 160895], [45, 161762], [51, 161935], [54, 162115], [58, 162255], [66, 162675], [71, 162915], [75, 163075], [82, 163475], [85, 163735], [89, 164008], [93, 164282], [99, 164827], [103, 164977], [108, 165097], [114, 165786], [120, 165901], [124, 166061], [127, 166221], [134, 166721], [137, 166881], [142, 167041]]}, {"verse": 22, "start": 167861, "end": 175343, "text": "And he returned to Judah, and said, I cannot find her; and also the men of the place said, that there was no harlot in this place.", "words": [[0, 167861], [4, 168001], [7, 168101], [16, 168501], [19, 168681], [26, 169001], [30, 169501], [36, 170190], [38, 170290], [45, 170530], [50, 170890], [55, 171415], [59, 171537], [64, 171897], [68, 172097], [72, 172277], [75, 172357], [79, 172457], [85, 172657], [91, 172977], [96, 173297], [102, 173437], [106, 173617], [109, 173917], [116, 174437], [119, 174637], [124, 174857]]}, {"verse": 23, "start": 175623, "end": 181967, "text": "And Judah said, Let her take it to her, lest we be shamed: behold, I sent this kid, and you have not found her.", "words": [[0, 175623], [4, 175780], [10, 175940], [16, 176627], [20, 176790], [24, 176930], [29, 177150], [32, 177270], [35, 177430], [40, 177930], [45, 178130], [48, 178290], [51, 178410], [59, 179117], [67, 179753], [69, 179813], [74, 180113], [79, 180333], [84, 180573], [88, 180933], [92, 181053], [97, 181173], [101, 181373], [107, 181693]]}, {"verse": 24, "start": 182247, "end": 194750, "text": "¶ And it came to pass about three months after, that it was told Judah, saying, Tamar your daughter in law has played the harlot; and also, behold, she is with child by whoredom. And Judah said, Bring her forth, and let her be burnt.", "words": [[2, 182247], [6, 182379], [9, 182479], [14, 182659], [17, 182839], [22, 183119], [28, 183359], [34, 183679], [41, 183899], [48, 184359], [53, 184644], [56, 184724], [60, 184844], [65, 185064], [72, 185804], [80, 186584], [86, 187064], [91, 187124], [100, 187404], [103, 187644], [107, 187864], [111, 188044], [118, 188304], [122, 188444], [130, 189154], [134, 189281], [140, 189881], [148, 190361], [152, 190481], [155, 190601], [160, 190761], [166, 191081], [169, 191552], [179, 192174], [183, 192316], [189, 192516], [195, 192876], [201, 193056], [205, 193236], [212, 193576], [216, 193821], [220, 194001], [224, 194121], [227, 194281]]}, {"verse": 25, "start": 195100, "end": 206212, "text": "When she was brought forth, she sent to her father in law, saying, By the man, whose these are, am I with child: and she said, Discern, please, whose are these, the signet, and bracelets, and staff.", "words": [[0, 195100], [5, 195219], [9, 195419], [13, 195579], [21, 195799], [28, 196299], [32, 196419], [37, 196679], [40, 196859], [44, 196999], [51, 197319], [54, 197539], [59, 197759], [67, 198566], [70, 198666], [74, 198786], [79, 199006], [85, 199206], [91, 199486], [96, 200026], [99, 200346], [101, 200646], [106, 200846], [113, 201679], [117, 201782], [121, 201942], [127, 202462], [136, 202902], [144, 203382], [150, 203862], [154, 203942], [161, 204382], [165, 204462], [173, 204942], [177, 205082], [188, 205462], [192, 205762]]}, {"verse": 26, "start": 206492, "end": 215474, "text": "And Judah acknowledged them, and said, She has been more righteous than I; because that I gave her not to Shelah my son. And he knew her again no more.", "words": [[0, 206492], [4, 206671], [10, 206911], [23, 207431], [29, 207811], [33, 208351], [39, 209016], [43, 209151], [47, 209331], [52, 209511], [57, 209791], [67, 210211], [72, 210551], [75, 211099], [83, 211376], [88, 211596], [90, 211716], [95, 211936], [99, 212096], [103, 212276], [106, 212536], [113, 212796], [116, 212936], [121, 213671], [125, 213793], [128, 213933], [133, 214193], [137, 214373], [143, 214673], [146, 214953]]}, {"verse": 27, "start": 215824, "end": 220758, "text": "¶ And it came to pass in the time of her travail, that, behold, twins were in her womb.", "words": [[2, 215824], [6, 215951], [9, 216051], [14, 216231], [17, 216391], [22, 216671], [25, 216851], [29, 216951], [34, 217231], [37, 217391], [41, 217531], [50, 217871], [56, 218351], [64, 219191], [70, 219471], [75, 219851], [78, 219991], [82, 220171]]}, {"verse": 28, "start": 221108, "end": 230431, "text": "And it came to pass, when she travailed, that the one put out his hand: and the midwife took and bound upon his hand a scarlet thread, saying, This came out first.", "words": [[0, 221108], [4, 221235], [7, 221335], [12, 221495], [15, 221635], [21, 221995], [26, 222255], [30, 222675], [41, 223095], [46, 223495], [50, 223675], [54, 223895], [58, 224095], [62, 224275], [66, 224455], [72, 225167], [76, 225286], [80, 225366], [88, 225806], [93, 226066], [97, 226246], [103, 226506], [108, 226726], [112, 227006], [117, 227266], [119, 227426], [127, 227886], [135, 228486], [143, 229184], [148, 229373], [153, 229633], [157, 229813]]}, {"verse": 29, "start": 230711, "end": 242397, "text": "And it came to pass, as he drew back his hand, that, behold, his brother came out: and she said, How have you broken forth? this breach be upon you: therefore his name was called Pharez.", "words": [[0, 230711], [4, 230846], [7, 230946], [12, 231126], [15, 231306], [21, 231646], [24, 231986], [27, 232106], [32, 232306], [37, 232546], [41, 232766], [47, 233546], [53, 233806], [61, 234586], [65, 234726], [73, 234986], [78, 235266], [83, 235979], [87, 236104], [91, 236264], [97, 236784], [101, 237004], [106, 237144], [110, 237244], [117, 237564], [124, 238417], [129, 238566], [136, 238886], [139, 239146], [144, 239446], [149, 240117], [159, 240662], [163, 240762], [168, 241042], [172, 241202], [179, 241837]]}, {"verse": 30, "start": 242747, "end": 248895, "text": "And afterward came out his brother, that had the scarlet thread upon his hand: and his name was called Zarah.", "words": [[0, 242747], [4, 242876], [14, 243296], [19, 243636], [23, 243856], [27, 244016], [36, 244376], [41, 244936], [45, 245096], [49, 245256], [57, 245756], [64, 245996], [69, 246276], [73, 246516], [79, 247257], [83, 247385], [87, 247525], [92, 247785], [96, 247985], [103, 248440]]}]}