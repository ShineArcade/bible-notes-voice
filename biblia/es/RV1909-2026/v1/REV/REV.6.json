{"book": "REV", "chapter": 6, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 168803, "verses": [{"verse": 1, "start": 300, "end": 8448, "text": "Y miré cuando el Cordero abrió uno de los sellos, y oí a uno de los cuatro seres vivientes diciendo como con una voz de trueno: Ven y ve.", "words": [[0, 300], [2, 400], [7, 680], [14, 900], [17, 1120], [25, 1540], [31, 1860], [35, 2020], [38, 2140], [42, 2280], [50, 3040], [52, 3320], [55, 3560], [57, 3660], [61, 3840], [64, 3980], [68, 4120], [75, 4340], [81, 4700], [91, 5240], [100, 5660], [105, 6080], [109, 6320], [113, 6460], [117, 6680], [120, 6820], [128, 7722], [132, 7902], [134, 8162]]}, {"verse": 2, "start": 8898, "end": 19707, "text": "Y miré, y he aquí un caballo blanco: y el que estaba sentado encima de él, tenía un arco; y le fue dada una corona, y salió victorioso, para que también venciese.", "words": [[0, 8898], [2, 9027], [8, 9407], [10, 9547], [13, 9687], [18, 9907], [21, 10047], [29, 10427], [37, 11281], [39, 11364], [42, 11444], [46, 11544], [53, 11784], [61, 12304], [68, 12684], [71, 12904], [75, 13144], [81, 13504], [84, 13724], [90, 14505], [92, 14604], [95, 14704], [99, 14844], [104, 15124], [108, 15304], [116, 15744], [118, 16144], [124, 16404], [136, 17104], [141, 17524], [145, 17664], [153, 18004]]}, {"verse": 3, "start": 20157, "end": 25794, "text": "Y cuando él abrió el segundo sello, oí al segundo ser viviente, que decía: Ven y ve.", "words": [[0, 20157], [2, 20236], [9, 20476], [12, 20736], [18, 21096], [21, 21236], [29, 21556], [36, 22096], [39, 22516], [42, 22656], [50, 23016], [54, 23356], [64, 23916], [68, 24136], [75, 25065], [79, 25325], [81, 25445]]}, {"verse": 4, "start": 26244, "end": 36632, "text": "Y salió otro caballo rojo: y al que estaba sentado sobre él, fue dado poder de quitar la paz de la tierra, y que se maten unos a otros: y le fue dada una grande espada.", "words": [[0, 26244], [2, 26488], [8, 26828], [13, 27048], [21, 27488], [27, 28307], [29, 28405], [32, 28525], [36, 28665], [43, 28925], [51, 29425], [57, 29665], [61, 30245], [65, 30565], [70, 30785], [76, 31065], [79, 31285], [86, 31605], [89, 31765], [93, 31965], [96, 32085], [99, 32485], [107, 32885], [109, 33045], [113, 33145], [116, 33285], [122, 33665], [127, 33805], [129, 34065], [136, 34880], [138, 34986], [141, 35106], [145, 35266], [150, 35546], [154, 35706], [161, 36006]]}, {"verse": 5, "start": 37082, "end": 49696, "text": "Y cuando él abrió el tercer sello, oí al tercer ser viviente, que decía: Ven y ve. Y miré, y he aquí un caballo negro: y el que estaba sentado encima de él, tenía una balanza en su mano.", "words": [[0, 37082], [2, 37185], [9, 37425], [12, 37665], [18, 38005], [21, 38145], [28, 38445], [35, 39165], [38, 39785], [41, 39925], [48, 40185], [52, 40565], [62, 41085], [66, 41325], [73, 42240], [77, 42457], [79, 42697], [83, 43290], [85, 43411], [91, 44151], [93, 44281], [96, 44411], [101, 44631], [104, 44711], [112, 45071], [119, 45894], [121, 45993], [124, 46073], [128, 46173], [135, 46433], [143, 46973], [150, 47353], [153, 47573], [157, 47793], [163, 48293], [167, 48573], [175, 49033], [178, 49153], [181, 49273]]}, {"verse": 6, "start": 50146, "end": 60831, "text": "Y oí una voz en medio de los cuatro seres vivientes, que decía: Dos libras de trigo por un denario, y seis libras de cebada por un denario: y no hagas daño al vino ni al aceite.", "words": [[0, 50146], [2, 50306], [5, 50466], [9, 50626], [13, 50906], [16, 51146], [22, 51386], [25, 51546], [29, 51666], [36, 52006], [42, 52346], [53, 52926], [57, 53366], [64, 54302], [68, 54422], [75, 54842], [78, 54922], [84, 55262], [88, 55462], [91, 55582], [100, 56022], [102, 56322], [107, 56622], [114, 57062], [117, 57182], [124, 57542], [128, 57742], [131, 57882], [140, 58727], [142, 58830], [145, 58970], [151, 59250], [156, 59530], [159, 59690], [164, 59930], [167, 60110], [170, 60230]]}, {"verse": 7, "start": 61281, "end": 66657, "text": "Y cuando él abrió el cuarto sello, oí la voz del cuarto ser viviente, que decía: Ven y ve.", "words": [[0, 61281], [2, 61370], [9, 61650], [12, 61870], [18, 62170], [21, 62290], [28, 62610], [35, 63270], [38, 63730], [41, 63850], [45, 64070], [49, 64210], [56, 64590], [60, 64890], [70, 65147], [74, 65403], [81, 66068], [85, 66273], [87, 66478]]}, {"verse": 8, "start": 67107, "end": 84316, "text": "Y miré, y he aquí un caballo amarillo: y el que estaba sentado sobre él tenía por nombre Muerte; y el infierno le seguía: y le fue dada autoridad sobre la cuarta parte de la tierra, para matar con espada, con hambre, con mortandad, y con las bestias de la tierra.", "words": [[0, 67688], [2, 68248], [8, 68528], [10, 68798], [13, 69068], [18, 69288], [21, 69468], [29, 69868], [39, 70712], [41, 70811], [44, 70911], [48, 71011], [55, 71271], [63, 71771], [69, 72031], [72, 72271], [78, 72591], [82, 72831], [89, 73071], [97, 74021], [99, 74161], [102, 74221], [111, 74601], [114, 74841], [122, 75683], [124, 75808], [127, 75908], [131, 76168], [136, 76588], [146, 77188], [152, 77508], [155, 77708], [162, 78088], [168, 78368], [171, 78588], [174, 78708], [182, 79508], [187, 79768], [193, 80008], [197, 80288], [205, 81108], [209, 81168], [217, 81768], [221, 81828], [232, 82488], [234, 82808], [238, 82968], [242, 83148], [250, 83568], [253, 83708], [256, 83808]]}, {"verse": 9, "start": 84766, "end": 93675, "text": "Y cuando él abrió el quinto sello, vi debajo del altar las almas de los que habían sido muertos por la palabra de Dios y por el testimonio que ellos tenían.", "words": [[0, 84766], [2, 84858], [9, 85078], [12, 85338], [18, 85698], [21, 85838], [28, 86218], [35, 86998], [38, 87198], [45, 87558], [49, 87738], [55, 88078], [59, 88338], [65, 88698], [68, 88878], [72, 88998], [76, 89158], [83, 89358], [88, 89658], [96, 90078], [100, 90318], [103, 90458], [111, 90778], [114, 90978], [119, 91238], [121, 91840], [125, 92000], [128, 92080], [139, 92700], [143, 92840], [149, 93020]]}, {"verse": 10, "start": 94125, "end": 103293, "text": "Y clamaban en alta voz diciendo: ¿Hasta cuándo, Señor, santo y verdadero, no juzgas y vengas nuestra sangre de los que moran en la tierra?", "words": [[0, 94125], [2, 94232], [11, 94712], [14, 94892], [19, 95072], [23, 95332], [33, 96351], [40, 96573], [48, 97053], [55, 97273], [61, 97913], [63, 98013], [74, 98873], [77, 99093], [84, 99533], [86, 99693], [93, 100053], [101, 100193], [108, 100713], [111, 100893], [115, 101013], [119, 101153], [125, 101473], [128, 101573], [131, 101653]]}, {"verse": 11, "start": 103743, "end": 117093, "text": "Y a cada uno le fue dada una vestidura blanca, y les fue dicho que reposasen todavía un poco de tiempo, hasta que se completara el número de sus consiervos y sus hermanos, que también habían de ser muertos como ellos.", "words": [[0, 103743], [2, 103865], [4, 103985], [9, 104145], [13, 104405], [16, 104565], [20, 104725], [25, 104985], [29, 105125], [39, 105685], [47, 106165], [49, 106725], [53, 106865], [57, 107025], [63, 107265], [67, 107445], [77, 108025], [85, 108385], [88, 108605], [93, 108765], [96, 108945], [104, 109780], [110, 109977], [114, 110137], [117, 110257], [128, 110837], [131, 110957], [138, 111177], [141, 111397], [145, 111557], [156, 112217], [158, 112357], [162, 112517], [172, 113337], [176, 113477], [184, 113857], [191, 114077], [194, 114297], [198, 114437], [206, 114857], [211, 115137]]}, {"verse": 12, "start": 117543, "end": 128380, "text": "Y miré cuando él abrió el sexto sello, y he aquí fue hecho un gran terremoto; y el sol se puso negro como un saco de tela áspera de pelo, y la luna se puso toda como sangre;", "words": [[0, 117543], [2, 117648], [7, 117868], [14, 118108], [17, 118368], [23, 118708], [26, 118868], [32, 119288], [39, 119688], [41, 119948], [44, 120208], [49, 120428], [53, 120808], [59, 121068], [62, 121465], [67, 121861], [78, 122509], [80, 122624], [83, 122744], [87, 123024], [90, 123304], [95, 123624], [101, 123964], [106, 124264], [109, 124424], [114, 124824], [117, 124884], [122, 125144], [129, 125644], [132, 125724], [138, 126064], [140, 126364], [143, 126484], [148, 126764], [151, 126904], [156, 127244], [161, 127464], [166, 127744]]}, {"verse": 13, "start": 128830, "end": 135553, "text": "Y las estrellas del cielo cayeron sobre la tierra, como la higuera echa sus higos cuando es movida de gran viento.", "words": [[0, 128830], [2, 128937], [6, 129077], [16, 129637], [20, 129777], [26, 130117], [34, 130697], [40, 130937], [43, 131137], [51, 131997], [56, 132297], [59, 132477], [67, 132807], [72, 133137], [76, 133337], [82, 133717], [89, 133997], [92, 134217], [99, 134617], [102, 134777], [107, 134937]]}, {"verse": 14, "start": 136003, "end": 142417, "text": "Y el cielo se apartó como un rollo que se enrolla; y todo monte y las islas fueron movidas de sus lugares.", "words": [[0, 136003], [2, 136107], [5, 136187], [11, 136507], [14, 136727], [21, 137247], [26, 137427], [29, 137607], [35, 137887], [39, 138027], [42, 138187], [51, 139110], [53, 139233], [58, 139413], [64, 139753], [66, 139993], [70, 140133], [76, 140493], [83, 140793], [91, 141313], [94, 141493], [98, 141653]]}, {"verse": 15, "start": 142867, "end": 154457, "text": "Y los reyes de la tierra, y los príncipes, y los ricos, y los capitanes, y los fuertes, y todo siervo y todo libre, se escondieron en las cuevas y entre las peñas de los montes;", "words": [[0, 142867], [2, 142967], [6, 143127], [12, 143527], [15, 143647], [18, 143727], [26, 144707], [28, 144787], [32, 144927], [43, 146087], [45, 146147], [49, 146617], [56, 147087], [58, 147127], [62, 147267], [73, 148227], [75, 148267], [79, 148407], [88, 149227], [90, 149247], [95, 149427], [102, 149947], [104, 150047], [109, 150247], [116, 151117], [119, 151167], [131, 151767], [134, 151927], [138, 152067], [145, 152567], [147, 152787], [153, 152967], [157, 153147], [163, 153527], [166, 153667], [170, 153787]]}, {"verse": 16, "start": 154907, "end": 164013, "text": "Y decían a los montes y a las peñas: Caed sobre nosotros, y escondednos de la cara de aquel que está sentado sobre el trono, y de la ira del Cordero:", "words": [[0, 154907], [2, 155009], [9, 155469], [11, 155549], [15, 155689], [22, 156209], [24, 156349], [26, 156409], [30, 156509], [37, 157484], [42, 157819], [48, 158079], [58, 158559], [60, 158839], [72, 159519], [75, 159699], [78, 159839], [83, 160119], [86, 160299], [92, 160659], [96, 160759], [101, 160979], [109, 161539], [115, 161779], [118, 161919], [125, 162319], [127, 162819], [130, 162919], [133, 163039], [137, 163299], [141, 163399]]}, {"verse": 17, "start": 164463, "end": 168403, "text": "Porque el gran día de su ira ha llegado; ¿y quién podrá estar firme?", "words": [[0, 164463], [7, 164659], [10, 164819], [15, 165019], [19, 165259], [22, 165399], [25, 165599], [29, 165899], [32, 166059], [41, 166907], [44, 167045], [50, 167225], [56, 167625], [62, 167805]]}]}