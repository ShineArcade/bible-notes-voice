{"book": "MAT", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 499066, "verses": [{"verse": 1, "start": 300, "end": 4596, "text": "Y aquel día, saliendo Jesús de casa, se sentó junto al mar.", "words": [[0, 300], [2, 445], [8, 765], [13, 1025], [22, 1645], [28, 2005], [31, 2285], [37, 3065], [40, 3245], [46, 3645], [52, 3825], [55, 4105]]}, {"verse": 2, "start": 5046, "end": 12506, "text": "Y se le juntó mucha gente; y entrando él en el barco, se sentó, y toda la gente estaba a la ribera.", "words": [[0, 5046], [2, 5154], [5, 5274], [8, 5394], [14, 5614], [20, 6054], [27, 7117], [29, 7262], [38, 7821], [41, 8162], [44, 8402], [47, 8561], [54, 9002], [57, 9162], [64, 9842], [66, 10362], [71, 10582], [74, 10802], [80, 11102], [87, 11522], [89, 11741], [92, 11801]]}, {"verse": 3, "start": 12956, "end": 19488, "text": "Y les habló muchas cosas por parábolas, diciendo: He aquí el que sembraba salió a sembrar.", "words": [[0, 12956], [2, 13081], [6, 13221], [12, 13601], [19, 13861], [25, 14401], [29, 14681], [40, 15381], [50, 16941], [53, 17021], [58, 17301], [61, 17641], [65, 17781], [74, 18301], [80, 18681], [82, 18781]]}, {"verse": 4, "start": 19938, "end": 27495, "text": "Y sembrando, parte de la semilla cayó junto al camino; y vinieron las aves, y la comieron.", "words": [[0, 19938], [2, 20275], [13, 20995], [19, 21435], [22, 21715], [25, 21855], [33, 22415], [38, 22915], [44, 23215], [47, 23475], [55, 24623], [57, 24843], [66, 25323], [70, 25583], [76, 26163], [78, 26443], [81, 26583]]}, {"verse": 5, "start": 27945, "end": 36567, "text": "Y parte cayó en pedregales, donde no tenía mucha tierra; y nació luego, porque no tenía profundidad de tierra:", "words": [[0, 27945], [2, 28041], [8, 28381], [13, 28941], [16, 29121], [28, 30401], [34, 30761], [37, 31061], [43, 31421], [49, 31721], [57, 32763], [59, 32906], [65, 33286], [72, 33686], [79, 34006], [82, 34296], [88, 34586], [100, 35606], [103, 36094]]}, {"verse": 6, "start": 37017, "end": 42002, "text": "Pero al salir el sol, se quemó; y se secó, porque no tenía raíz.", "words": [[0, 37017], [5, 37161], [8, 37321], [14, 37621], [17, 37841], [22, 38161], [25, 38401], [32, 40241], [34, 40241], [37, 40241], [43, 40241], [50, 40468], [53, 40708], [59, 41088]]}, {"verse": 7, "start": 42452, "end": 47444, "text": "Y parte cayó en espinas; y las espinas crecieron, y la ahogaron.", "words": [[0, 42452], [2, 42596], [8, 42896], [13, 43576], [16, 43796], [25, 44824], [27, 44947], [31, 45067], [39, 45487], [50, 46207], [52, 46447], [55, 46587]]}, {"verse": 8, "start": 47894, "end": 53187, "text": "Y parte cayó en buena tierra, y dio fruto, cuál a ciento, cuál a sesenta, y cuál a treinta.", "words": [[0, 47894], [2, 47995], [8, 48195], [13, 48595], [16, 48675], [22, 48835], [30, 49155], [32, 49425], [36, 49695], [43, 50115], [48, 50442], [50, 50768], [58, 51095], [63, 51388], [65, 51682], [74, 51975], [76, 52215], [81, 52551], [83, 52888]]}, {"verse": 9, "start": 53637, "end": 56015, "text": "Quien tiene oídos para oír, oiga.", "words": [[0, 53637], [6, 53783], [12, 54123], [18, 54583], [23, 54783], [28, 55603]]}, {"verse": 10, "start": 56465, "end": 62207, "text": "Entonces, acercándose los discípulos, le dijeron: ¿Por qué les hablas por parábolas?", "words": [[0, 56465], [10, 57473], [22, 58233], [26, 58433], [38, 59113], [41, 59453], [50, 60397], [55, 60541], [59, 60741], [63, 60881], [70, 61261], [74, 61461]]}, {"verse": 11, "start": 62557, "end": 71995, "text": "Y él respondiendo, les dijo: Porque a vosotros es concedido saber los misterios del reino de los cielos; pero a ellos no es concedido.", "words": [[0, 62557], [2, 62742], [5, 62942], [19, 64022], [23, 64202], [29, 65039], [36, 65471], [38, 65611], [47, 66051], [50, 66231], [60, 66971], [66, 67231], [70, 67511], [80, 68151], [84, 68331], [90, 68711], [93, 68831], [97, 68971], [105, 69968], [110, 70111], [112, 70291], [118, 70531], [121, 70991], [124, 71171]]}, {"verse": 12, "start": 72445, "end": 80155, "text": "Porque a cualquiera que tiene, se le dará, y tendrá más; pero al que no tiene, aun lo que tiene le será quitado.", "words": [[0, 72445], [7, 72731], [9, 72851], [20, 73371], [24, 73511], [31, 73931], [34, 74471], [37, 74651], [43, 75331], [45, 75571], [52, 75951], [57, 76701], [62, 76845], [65, 76985], [69, 77145], [72, 77285], [79, 77985], [83, 78205], [86, 78465], [90, 78605], [96, 78945], [99, 79145], [104, 79385]]}, {"verse": 13, "start": 80605, "end": 88527, "text": "Por eso les hablo por parábolas; porque viendo no ven, y oyendo no oyen, ni entienden.", "words": [[0, 80605], [4, 80750], [8, 81030], [12, 81690], [18, 82250], [22, 82470], [33, 83751], [40, 83973], [47, 84353], [50, 84633], [55, 84953], [57, 85653], [64, 86093], [67, 86373], [73, 86993], [76, 87613]]}, {"verse": 14, "start": 88977, "end": 99098, "text": "De manera que se cumple en ellos la profecía de Isaías, que dice: De oído oiréis, y no entenderéis; y viendo veréis, y no miraréis.", "words": [[0, 88977], [3, 89102], [10, 89342], [14, 89622], [17, 89782], [24, 90342], [27, 90542], [33, 90782], [36, 91002], [45, 91642], [48, 91782], [56, 92402], [60, 92602], [66, 93489], [69, 93789], [74, 94189], [82, 94849], [84, 95109], [87, 95289], [100, 96609], [102, 96733], [109, 97053], [117, 97633], [119, 98193], [122, 98333]]}, {"verse": 15, "start": 99548, "end": 113904, "text": "Porque el corazón de este pueblo se ha vuelto insensible, y oyen con dificultad, y han cerrado sus ojos: para que no vean con los ojos, ni oigan con los oídos, ni entiendan con el corazón, y se conviertan, y yo los sane.", "words": [[0, 99548], [7, 99749], [10, 99889], [18, 100269], [21, 100529], [26, 100669], [33, 100949], [36, 101209], [39, 101329], [46, 101689], [58, 102589], [60, 102869], [65, 103209], [69, 103349], [81, 104209], [83, 104409], [87, 104819], [95, 105229], [99, 105429], [105, 106377], [110, 106521], [114, 106681], [117, 106841], [122, 107121], [126, 107261], [130, 107441], [136, 108021], [139, 108601], [145, 109181], [149, 109441], [153, 109641], [160, 110111], [163, 110581], [173, 111241], [177, 111361], [180, 111521], [189, 111941], [191, 112121], [194, 112201], [206, 112901], [208, 113061], [211, 113191], [215, 113321]]}, {"verse": 16, "start": 114354, "end": 119353, "text": "Pero bienaventurados vuestros ojos, porque ven; y vuestros oídos, porque oyen.", "words": [[0, 114354], [5, 114829], [21, 115339], [30, 115759], [36, 116439], [43, 116759], [48, 117502], [50, 117609], [59, 117969], [66, 118429], [73, 118749]]}, {"verse": 17, "start": 119803, "end": 129844, "text": "Porque de cierto os digo, que muchos profetas y justos desearon ver lo que veis, y no lo vieron: y oír lo que oís, y no lo oyeron.", "words": [[0, 119803], [7, 120029], [10, 120209], [17, 120569], [20, 120929], [26, 121569], [30, 121889], [37, 122149], [46, 122789], [48, 122969], [55, 123689], [64, 124449], [68, 124649], [71, 124889], [75, 125049], [81, 125549], [83, 125829], [86, 126009], [89, 126149], [97, 127126], [99, 127311], [103, 127591], [106, 127811], [110, 127971], [115, 128411], [117, 128731], [120, 128931], [123, 129111]]}, {"verse": 18, "start": 130294, "end": 134198, "text": "Oíd, pues, vosotros la parábola del que siembra:", "words": [[0, 130461], [5, 130640], [11, 130941], [20, 132241], [23, 132640], [32, 133181], [36, 133380], [40, 133540]]}, {"verse": 19, "start": 134648, "end": 146779, "text": "Oyendo cualquiera la palabra del reino, y no entendiéndola, viene el malo, y arrebata lo que fue sembrado en su corazón: este es el que fue sembrado junto al camino.", "words": [[0, 134802], [7, 134992], [18, 135592], [21, 135772], [29, 136132], [33, 136412], [40, 137332], [42, 137572], [45, 137712], [60, 139112], [66, 139452], [69, 139752], [75, 140432], [77, 140892], [86, 141352], [89, 141452], [93, 141552], [97, 141712], [106, 142312], [109, 142432], [112, 142592], [121, 143715], [126, 144041], [129, 144381], [132, 144661], [136, 144801], [140, 145001], [149, 145621], [155, 145841], [158, 146101]]}, {"verse": 20, "start": 147229, "end": 155043, "text": "Y el que fue sembrado en pedregales, este es el que oye la palabra, y luego la recibe con gozo.", "words": [[0, 147229], [2, 147569], [5, 147669], [9, 147789], [13, 147969], [22, 148569], [25, 148729], [37, 150389], [42, 150689], [45, 150849], [48, 151009], [52, 151169], [56, 151489], [59, 151629], [68, 152769], [70, 153109], [76, 153329], [79, 153609], [86, 154109], [90, 154349]]}, {"verse": 21, "start": 155493, "end": 164628, "text": "Pero no tiene raíz en sí, sino que dura poco: que venida la aflicción o la persecución por la palabra, enseguida tropieza.", "words": [[0, 155493], [5, 155635], [8, 155795], [14, 156035], [19, 156575], [22, 156775], [26, 157435], [31, 157755], [35, 157955], [40, 158155], [46, 159185], [50, 159289], [57, 159669], [60, 159829], [70, 160689], [72, 160949], [75, 161069], [87, 161869], [91, 162069], [94, 162269], [103, 163189], [113, 163749]]}, {"verse": 22, "start": 165078, "end": 177037, "text": "Y el que fue sembrado en espinas, este es el que oye la palabra; pero el afán de este siglo y el engaño de las riquezas, ahogan la palabra, y se hace infructuosa.", "words": [[0, 165078], [2, 165227], [5, 165307], [9, 165427], [13, 165607], [22, 166207], [25, 166307], [34, 167587], [39, 168027], [42, 168267], [45, 168427], [49, 168607], [53, 168887], [56, 169027], [65, 169998], [70, 170162], [73, 170322], [78, 170682], [81, 170782], [86, 170942], [92, 171422], [94, 171602], [97, 171722], [104, 172222], [107, 172342], [111, 172502], [121, 173262], [128, 174062], [131, 174282], [140, 174742], [142, 175502], [145, 175642], [150, 175902]]}, {"verse": 23, "start": 177487, "end": 189503, "text": "Pero el que fue sembrado en buena tierra, este es el que oye y entiende la palabra, y el que lleva fruto: y lleva uno a ciento, y otro a sesenta, y otro a treinta.", "words": [[0, 177487], [5, 177650], [8, 177790], [12, 177930], [16, 178130], [25, 178790], [28, 178910], [34, 179130], [42, 180130], [47, 180430], [50, 180710], [53, 180870], [57, 181050], [61, 181470], [63, 181650], [72, 182190], [75, 182370], [84, 183150], [86, 183430], [89, 183560], [93, 183690], [99, 183990], [106, 185012], [108, 185139], [114, 185399], [118, 185659], [120, 185879], [128, 186239], [130, 186919], [135, 187199], [137, 187439], [146, 188119], [148, 188339], [153, 188579], [155, 188779]]}, {"verse": 24, "start": 189953, "end": 197918, "text": "Otra parábola les refirió, diciendo: El reino de los cielos es semejante al hombre que siembra buena semilla en su campo:", "words": [[0, 189953], [5, 190300], [14, 190800], [18, 191240], [27, 191680], [37, 192773], [40, 193021], [46, 193401], [49, 193501], [53, 193641], [60, 194101], [63, 194571], [73, 195041], [76, 195201], [83, 195421], [87, 195621], [95, 196121], [101, 196301], [109, 196901], [112, 197081], [115, 197241]]}, {"verse": 25, "start": 198368, "end": 203459, "text": "Pero durmiendo los hombres, vino su enemigo, y sembró cizaña entre el trigo, y se fue.", "words": [[0, 198368], [5, 198512], [15, 199012], [19, 199192], [28, 199972], [33, 200292], [36, 200512], [45, 200972], [47, 201072], [54, 201492], [61, 202032], [67, 202292], [70, 202472], [77, 202852], [79, 202972], [82, 203072]]}, {"verse": 26, "start": 203909, "end": 209615, "text": "Y como la hierba salió e hizo fruto, entonces apareció también la cizaña.", "words": [[0, 203909], [2, 204213], [7, 204433], [10, 204593], [17, 205053], [23, 205593], [25, 205973], [30, 206213], [37, 207093], [46, 207433], [55, 208273], [63, 208633], [66, 209150]]}, {"verse": 27, "start": 210065, "end": 219956, "text": "Y llegándose los siervos del padre de la familia, le dijeron: Señor, ¿no sembraste buena semilla en tu campo? ¿de dónde, pues, tiene cizaña?", "words": [[0, 210065], [2, 210169], [13, 210769], [17, 210949], [25, 211429], [29, 211629], [35, 212009], [38, 212229], [41, 212369], [50, 213269], [53, 213509], [62, 214530], [69, 215253], [73, 215373], [83, 215786], [89, 216200], [97, 216613], [100, 216693], [103, 216813], [110, 217746], [114, 217891], [121, 218331], [127, 218884], [133, 219437]]}, {"verse": 28, "start": 220406, "end": 229513, "text": "Y él les dijo: Un hombre enemigo ha hecho esto. Y los siervos le dijeron: ¿Quieres, pues, que vayamos y la arranquemos?", "words": [[0, 220406], [2, 220592], [5, 220792], [9, 221152], [15, 222024], [18, 222167], [25, 222487], [33, 223147], [36, 223387], [42, 223627], [48, 224500], [50, 224621], [54, 224761], [62, 225261], [65, 225601], [74, 226718], [84, 226884], [90, 227051], [94, 227911], [102, 228351], [104, 228531], [107, 229022]]}, {"verse": 29, "start": 229963, "end": 236114, "text": "Y él dijo: No; porque cogiendo la cizaña, no arranquéis también con ella el trigo.", "words": [[0, 229963], [2, 230118], [5, 230238], [11, 230995], [15, 231629], [22, 231853], [31, 232373], [34, 232763], [42, 233153], [45, 233653], [56, 234453], [64, 234753], [68, 235113], [73, 235333], [76, 235553]]}, {"verse": 30, "start": 236564, "end": 252361, "text": "Dejad crecer juntamente lo uno y lo otro hasta la siega; y al tiempo de la siega yo diré a los segadores: Recoged primero la cizaña, y atadla en manojos para quemarla; pero recoged el trigo en mi granero.", "words": [[0, 236564], [6, 236969], [13, 237469], [24, 238309], [27, 238509], [31, 238809], [33, 239029], [36, 239169], [41, 239509], [47, 239709], [50, 240126], [57, 240772], [59, 240878], [62, 241018], [69, 241338], [72, 241578], [75, 241808], [81, 242038], [84, 242218], [89, 242578], [91, 242678], [95, 243253], [106, 244332], [114, 244632], [122, 245032], [125, 245482], [133, 245932], [135, 246372], [142, 246992], [145, 247252], [153, 247952], [158, 248492], [168, 249569], [173, 249756], [181, 250456], [184, 250696], [190, 251156], [193, 251575], [196, 251995]]}, {"verse": 31, "start": 252811, "end": 262855, "text": "Otra parábola les refirió, diciendo: El reino de los cielos es semejante al grano de mostaza, que tomándolo alguno lo sembró en su campo:", "words": [[0, 252811], [5, 253158], [14, 253658], [18, 254098], [27, 254538], [37, 255631], [40, 255778], [46, 256258], [49, 256378], [53, 256518], [60, 257058], [63, 257558], [73, 258058], [76, 258238], [82, 258638], [85, 258778], [94, 259778], [98, 259938], [108, 260658], [115, 261318], [118, 261438], [125, 261938], [128, 262018], [131, 262178]]}, {"verse": 32, "start": 263305, "end": 277389, "text": "El cual a la verdad es la más pequeña de todas las semillas; pero cuando ha crecido, es la mayor de las hortalizas, y se hace árbol, que vienen las aves del cielo y hacen nidos en sus ramas.", "words": [[0, 263305], [3, 263472], [8, 263712], [10, 264032], [13, 264132], [20, 264372], [23, 264812], [26, 265132], [30, 265432], [38, 265932], [41, 266332], [47, 266632], [51, 266952], [61, 268069], [66, 268197], [73, 268437], [76, 268637], [85, 269117], [88, 269237], [91, 269357], [97, 269617], [100, 269797], [104, 269937], [116, 270797], [118, 271477], [121, 271637], [126, 271897], [133, 272577], [137, 273017], [144, 273457], [148, 273597], [153, 273937], [157, 274097], [163, 274577], [165, 275117], [171, 275377], [177, 276057], [180, 276377], [184, 276577]]}, {"verse": 33, "start": 277839, "end": 289711, "text": "Otra parábola les dijo: El reino de los cielos es semejante a la levadura que tomó una mujer, y escondió en tres medidas de harina, hasta que todo quedó fermentado.", "words": [[0, 277839], [5, 278226], [14, 278786], [18, 279026], [24, 279856], [27, 280034], [33, 280454], [36, 280594], [40, 280734], [47, 281394], [50, 281614], [60, 282454], [62, 282594], [65, 282714], [74, 283254], [78, 283434], [83, 283814], [87, 283974], [94, 284354], [96, 284854], [105, 285554], [108, 285874], [113, 286194], [121, 286874], [124, 287094], [132, 287914], [138, 288094], [142, 288274], [147, 288474], [153, 288834]]}, {"verse": 34, "start": 290161, "end": 295919, "text": "Todo esto habló Jesús por parábolas a la gente, y sin parábolas no les hablaba:", "words": [[0, 290161], [5, 290323], [10, 290623], [16, 291003], [22, 291263], [26, 291643], [36, 292323], [38, 292543], [41, 292603], [48, 293063], [50, 293603], [54, 293803], [64, 294643], [67, 295043], [71, 295263]]}, {"verse": 35, "start": 296369, "end": 306285, "text": "Para que se cumpliese lo que fue dicho por el profeta, que dijo: Abriré en parábolas mi boca; declararé cosas escondidas desde la fundación del mundo.", "words": [[0, 296369], [5, 296807], [9, 296947], [12, 297087], [22, 297647], [25, 297847], [29, 297947], [33, 298107], [39, 298367], [43, 298627], [46, 298747], [55, 299267], [59, 299427], [65, 300239], [72, 300839], [75, 301169], [85, 301499], [88, 301699], [94, 302520], [104, 303164], [110, 303444], [121, 304344], [127, 304784], [130, 305004], [140, 305484], [144, 305704]]}, {"verse": 36, "start": 306735, "end": 318378, "text": "Entonces, despedida la gente, Jesús entró en la casa; y acercándose a él sus discípulos, le dijeron: Decláranos la parábola de la cizaña del campo.", "words": [[0, 306735], [10, 307598], [20, 308358], [23, 308478], [30, 309498], [36, 309918], [42, 310638], [45, 310718], [48, 310858], [54, 311771], [56, 311879], [68, 312759], [70, 313039], [73, 313419], [77, 313559], [89, 314339], [92, 314639], [101, 315960], [112, 316280], [115, 316440], [124, 316960], [127, 317120], [130, 317410], [137, 317700], [141, 317820]]}, {"verse": 37, "start": 318728, "end": 324970, "text": "Y respondiendo él, les dijo: El que siembra la buena semilla es el Hijo del hombre;", "words": [[0, 318728], [2, 318852], [15, 319692], [19, 320112], [23, 320592], [29, 321497], [32, 321623], [36, 321723], [44, 322203], [47, 322303], [53, 322523], [61, 323123], [64, 323543], [67, 323723], [72, 324103], [76, 324363]]}, {"verse": 38, "start": 325420, "end": 332877, "text": "Y el campo es el mundo; y la buena semilla son los hijos del reino, y la cizaña son los hijos del malo;", "words": [[0, 325420], [2, 325559], [5, 325699], [11, 326059], [14, 326259], [17, 326399], [24, 327372], [26, 327481], [29, 327601], [35, 327801], [43, 328341], [47, 328581], [51, 328781], [57, 329041], [61, 329301], [68, 330021], [70, 330461], [73, 330901], [80, 331341], [84, 331621], [88, 331821], [94, 332081], [98, 332321]]}, {"verse": 39, "start": 333327, "end": 341714, "text": "Y el enemigo que la sembró, es el diablo; y la siega es el fin del mundo, y los segadores son los ángeles.", "words": [[0, 333327], [2, 333453], [5, 333593], [13, 334133], [17, 334293], [20, 334413], [28, 335173], [31, 335533], [34, 335713], [42, 336677], [44, 336779], [47, 337119], [53, 337459], [56, 338019], [59, 338179], [63, 338379], [67, 338539], [74, 338979], [76, 339539], [80, 339959], [90, 340379], [94, 340719], [98, 340879]]}, {"verse": 40, "start": 342164, "end": 348978, "text": "De manera que como es cogida la cizaña, y quemada al fuego, así será en el fin de este siglo.", "words": [[0, 342164], [3, 342268], [10, 342468], [14, 342708], [19, 342948], [22, 343168], [29, 343648], [32, 344038], [40, 344428], [42, 344848], [50, 345248], [53, 345448], [60, 346248], [64, 346448], [69, 346888], [72, 347388], [75, 347548], [79, 347828], [82, 348068], [87, 348288]]}, {"verse": 41, "start": 349428, "end": 359408, "text": "Enviará el Hijo del hombre sus ángeles, y recogerán de su reino todas las causas de tropiezo, y los que hacen iniquidad,", "words": [[0, 349428], [8, 350093], [11, 350333], [16, 350673], [20, 350893], [27, 351213], [31, 351433], [40, 352113], [42, 352653], [52, 353453], [55, 353593], [58, 353773], [64, 354273], [70, 354613], [74, 354953], [81, 355533], [84, 355633], [94, 356393], [96, 357033], [100, 357193], [104, 357373], [110, 357773]]}, {"verse": 42, "start": 359858, "end": 365746, "text": "Y los echarán en el horno de fuego: allí será el llanto y el crujir de dientes.", "words": [[0, 359858], [2, 359975], [6, 360115], [14, 360775], [17, 361015], [20, 361175], [26, 361575], [29, 361715], [36, 362666], [41, 363118], [46, 363318], [49, 363458], [56, 363898], [58, 364078], [61, 364418], [68, 364758], [71, 364918]]}, {"verse": 43, "start": 366196, "end": 374541, "text": "Entonces los justos resplandecerán como el sol en el reino de su Padre: el que tiene oídos para oír, oiga.", "words": [[0, 366196], [9, 366925], [13, 367585], [20, 368325], [35, 369505], [40, 369765], [43, 369985], [47, 370245], [50, 370585], [53, 370745], [59, 371145], [62, 371285], [65, 371445], [72, 372336], [75, 372443], [79, 372563], [85, 372843], [91, 373303], [96, 373523], [101, 374033]]}, {"verse": 44, "start": 374991, "end": 390369, "text": "Además, el reino de los cielos es semejante al tesoro escondido en el campo; el cual hallado, el hombre lo encubre, y de gozo de ello va, y vende todo lo que tiene, y compra aquel campo.", "words": [[0, 374991], [8, 375954], [11, 376314], [17, 376754], [20, 376874], [24, 377034], [31, 377654], [34, 377874], [44, 378834], [47, 379194], [54, 379834], [64, 380634], [67, 380754], [70, 380914], [77, 381955], [80, 382120], [85, 382400], [94, 383060], [97, 383200], [104, 383460], [107, 384220], [116, 384980], [118, 385060], [121, 385240], [126, 385580], [129, 385800], [134, 386020], [138, 386860], [140, 386920], [146, 387320], [151, 387580], [154, 387820], [158, 387940], [165, 388800], [167, 388880], [174, 389280], [180, 389660]]}, {"verse": 45, "start": 390819, "end": 397186, "text": "También el reino de los cielos es semejante a un comerciante, que busca buenas perlas;", "words": [[0, 390819], [8, 391145], [11, 391465], [17, 391885], [20, 392005], [24, 392145], [31, 392765], [34, 393045], [44, 393885], [46, 394005], [49, 394125], [62, 394965], [66, 395425], [72, 395725], [79, 396405]]}, {"verse": 46, "start": 397636, "end": 402632, "text": "Que hallando una preciosa perla, fue y vendió todo lo que tenía, y la compró.", "words": [[0, 397636], [4, 397819], [13, 398099], [17, 398279], [26, 398799], [33, 399419], [37, 399519], [39, 399839], [46, 400279], [51, 400679], [54, 400939], [58, 401059], [65, 401419], [67, 401919], [70, 402039]]}, {"verse": 47, "start": 403082, "end": 411207, "text": "Asimismo el reino de los cielos es semejante a la red, que echada en el mar, recoge de toda clase de peces:", "words": [[0, 403082], [9, 403749], [12, 403849], [18, 404229], [21, 404349], [25, 404509], [32, 405169], [35, 405659], [45, 406149], [47, 406309], [50, 406409], [55, 406689], [59, 407229], [66, 407649], [69, 407789], [72, 407929], [77, 408209], [84, 409449], [87, 409589], [92, 409849], [98, 410209], [101, 410549]]}, {"verse": 48, "start": 411657, "end": 420586, "text": "La cual estando llena, la sacaron a la orilla; y sentados, cogieron lo bueno en cestas, y lo malo echaron fuera.", "words": [[0, 411657], [3, 411785], [8, 412218], [16, 412652], [23, 413085], [26, 413625], [34, 414165], [36, 414265], [39, 414405], [47, 415287], [49, 415431], [59, 416131], [68, 416891], [71, 417111], [77, 417371], [80, 417591], [88, 418351], [90, 418951], [93, 419091], [98, 419411], [106, 419831]]}, {"verse": 49, "start": 421036, "end": 428633, "text": "Así será al fin del siglo: saldrán los ángeles, y apartarán a los malos de entre los justos,", "words": [[0, 421036], [4, 421241], [9, 421641], [12, 421961], [16, 422201], [20, 422717], [27, 423480], [35, 424266], [39, 424446], [48, 425106], [50, 425506], [60, 426306], [62, 426466], [66, 426606], [72, 427166], [75, 427386], [81, 427686], [85, 427906]]}, {"verse": 50, "start": 429083, "end": 434792, "text": "Y los echarán en el horno del fuego: allí será el llanto y el crujir de dientes.", "words": [[0, 429083], [2, 429207], [6, 429347], [14, 429967], [17, 430207], [20, 430367], [26, 430667], [30, 430827], [37, 431711], [42, 432164], [47, 432364], [50, 432504], [57, 432944], [59, 433124], [62, 433464], [69, 433804], [72, 433964]]}, {"verse": 51, "start": 435242, "end": 442975, "text": "Les dice Jesús: ¿Habéis entendido todas estas cosas? Ellos responden: Sí, Señor.", "words": [[0, 435242], [4, 435466], [9, 435826], [16, 436880], [24, 437327], [34, 438007], [40, 438207], [46, 438567], [53, 439896], [59, 440066], [70, 441179], [74, 441606]]}, {"verse": 52, "start": 443325, "end": 454036, "text": "Y él les dijo: Por eso todo escriba instruido en el reino de los cielos, es semejante a un padre de familia, que saca de su tesoro cosas nuevas y cosas viejas.", "words": [[0, 443325], [2, 443511], [5, 443711], [9, 444071], [15, 444943], [19, 445050], [23, 445270], [28, 445550], [36, 446150], [46, 446750], [49, 446890], [52, 447050], [58, 447430], [61, 447550], [65, 447690], [73, 448550], [76, 448830], [86, 449390], [88, 449490], [91, 449590], [97, 449850], [100, 450070], [109, 450610], [113, 450830], [118, 451190], [121, 451270], [124, 451410], [131, 451890], [137, 452410], [144, 452790], [146, 453050], [152, 453210]]}, {"verse": 53, "start": 454486, "end": 459036, "text": "Y aconteció que acabando Jesús estas parábolas, pasó de allí.", "words": [[0, 454486], [2, 454645], [12, 455385], [16, 455605], [25, 456065], [31, 456465], [37, 456945], [48, 457865], [53, 458285], [56, 458545]]}, {"verse": 54, "start": 459486, "end": 471023, "text": "Y venido a su tierra, les enseñaba en la sinagoga de ellos, de tal manera que ellos estaban atónitos, y decían: ¿De dónde tiene este esta sabiduría, y estas maravillas?", "words": [[0, 459486], [2, 459594], [9, 459974], [11, 460094], [14, 460214], [22, 460694], [26, 461214], [35, 461974], [38, 462094], [41, 462194], [50, 462814], [53, 463034], [60, 463634], [63, 463854], [67, 464114], [74, 464474], [78, 464754], [84, 464994], [92, 465434], [102, 466454], [104, 466774], [112, 467770], [116, 467913], [122, 468033], [128, 468253], [133, 468473], [138, 468773], [149, 469773], [151, 469953], [157, 470153]]}, {"verse": 55, "start": 471473, "end": 478402, "text": "¿No es este el hijo del carpintero? ¿no se llama su madre María, y sus hermanos Jacobo y José, y Simón, y Judas?", "words": [[0, 471473], [4, 471619], [7, 471839], [12, 472159], [15, 472319], [20, 472499], [24, 472639], [36, 473762], [40, 473886], [43, 474006], [49, 474226], [52, 474406], [58, 474646], [65, 475066], [67, 475486], [71, 475606], [80, 476086], [87, 476546], [89, 476606], [95, 476866], [97, 477206], [104, 477646], [106, 477826]]}, {"verse": 56, "start": 478852, "end": 484017, "text": "¿Y no están todas sus hermanas con nosotros? ¿De dónde, pues, tiene este todas estas cosas?", "words": [[0, 478852], [3, 478948], [6, 479068], [12, 479268], [18, 479548], [22, 479828], [31, 480188], [35, 480408], [45, 481392], [49, 481537], [56, 481837], [62, 482184], [68, 482530], [73, 482877], [79, 483077], [85, 483337]]}, {"verse": 57, "start": 484367, "end": 492536, "text": "Y se escandalizaban en él. Pero Jesús les dijo: No hay profeta sin honra sino en su tierra y en su casa.", "words": [[0, 484367], [2, 484513], [5, 484713], [20, 485773], [23, 485953], [27, 486604], [32, 486748], [38, 487168], [42, 487668], [48, 488503], [51, 488630], [55, 488790], [63, 489350], [67, 489590], [73, 490330], [78, 490530], [81, 490770], [84, 490870], [91, 491330], [93, 491590], [96, 491730], [99, 491890]]}, {"verse": 58, "start": 492986, "end": 498666, "text": "Y no hizo allí muchas maravillas, a causa de la incredulidad de ellos.", "words": [[0, 492986], [2, 493110], [5, 493310], [10, 493590], [15, 493870], [22, 494210], [34, 495570], [36, 495670], [42, 496070], [45, 496370], [48, 496490], [61, 497650], [64, 497950]]}]}