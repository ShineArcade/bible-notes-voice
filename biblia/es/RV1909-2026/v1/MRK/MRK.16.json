{"book": "MRK", "chapter": 16, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 162583, "verses": [{"verse": 1, "start": 300, "end": 12004, "text": "Y como pasó el sábado, María Magdalena, y María madre de Jacobo, y Salomé, compraron especias aromáticas, para venir a ungirle.", "words": [[0, 300], [2, 444], [7, 724], [12, 1084], [15, 1324], [23, 1924], [29, 2844], [40, 3864], [42, 4564], [48, 4884], [54, 5424], [57, 5584], [65, 6504], [67, 6684], [75, 7424], [85, 8344], [94, 8944], [106, 9744], [111, 10484], [117, 10804], [119, 11415]]}, {"verse": 2, "start": 12354, "end": 18446, "text": "Y muy de mañana, el primer día de la semana, vienen al sepulcro, ya salido el sol.", "words": [[0, 12354], [2, 12478], [6, 12638], [9, 12798], [17, 13338], [20, 13438], [27, 13758], [31, 14078], [34, 14218], [37, 14358], [45, 15218], [52, 15738], [55, 16038], [65, 17098], [68, 17398], [75, 17758], [78, 17918]]}, {"verse": 3, "start": 18796, "end": 24046, "text": "Y decían entre sí: ¿Quién nos hará rodar la piedra de la puerta del sepulcro?", "words": [[0, 18796], [2, 18905], [9, 19425], [15, 19705], [19, 20387], [26, 20707], [30, 20847], [35, 21167], [41, 21647], [44, 21787], [51, 22287], [54, 22407], [57, 22527], [64, 22867], [68, 23147]]}, {"verse": 4, "start": 24326, "end": 28691, "text": "Y al mirar, vieron que la piedra había sido removida, aunque era muy grande.", "words": [[0, 24326], [2, 24455], [5, 24555], [12, 24955], [19, 25295], [23, 25455], [26, 25595], [33, 26035], [39, 26235], [44, 26615], [54, 27535], [61, 27695], [65, 27955], [69, 28115]]}, {"verse": 5, "start": 29041, "end": 38829, "text": "Y entradas en el sepulcro, vieron un joven sentado al lado derecho, cubierto de una larga túnica blanca; y se espantaron.", "words": [[0, 29041], [2, 29225], [11, 29785], [14, 30045], [17, 30205], [27, 30945], [34, 31785], [37, 31965], [43, 32425], [51, 33105], [54, 33285], [59, 33565], [68, 34065], [77, 35105], [80, 35425], [84, 35605], [90, 36025], [97, 36505], [105, 37436], [107, 37600], [110, 37720]]}, {"verse": 6, "start": 39179, "end": 49482, "text": "Pero él les dice: No os asustéis: buscáis a Jesús nazareno, el que fue crucificado; ha resucitado, no está aquí; he aquí el lugar en donde le pusieron.", "words": [[0, 39179], [5, 39344], [8, 39574], [12, 39804], [18, 40563], [21, 40765], [24, 40945], [34, 41948], [42, 42428], [44, 42588], [50, 42808], [60, 43528], [63, 43768], [67, 43888], [71, 44068], [84, 45459], [87, 45753], [99, 46046], [102, 46346], [107, 46566], [113, 47293], [116, 47373], [121, 47633], [124, 47913], [130, 48233], [133, 48513], [139, 48653], [142, 48833]]}, {"verse": 7, "start": 49832, "end": 56454, "text": "Pero id, decid a sus discípulos y a Pedro, que él va antes que vosotros a Galilea: allí le veréis, como os dijo.", "words": [[0, 49832], [5, 49991], [9, 50231], [15, 50471], [17, 50711], [21, 50871], [32, 51531], [34, 51671], [36, 51751], [43, 52311], [47, 52498], [50, 52684], [53, 52871], [59, 53131], [63, 53331], [72, 53771], [74, 54011], [83, 54853], [88, 55115], [91, 55235], [99, 55615], [104, 55915], [107, 56055]]}, {"verse": 8, "start": 56734, "end": 66025, "text": "Y ellas se fueron huyendo del sepulcro; porque las había tomado temblor y espanto; ni decían nada a nadie, porque tenían miedo.", "words": [[0, 56734], [2, 56918], [8, 57278], [11, 57738], [18, 58018], [26, 58658], [30, 58898], [40, 60092], [47, 60276], [51, 60476], [57, 60796], [64, 61276], [72, 61876], [74, 62036], [83, 63144], [86, 63291], [93, 63831], [98, 64191], [100, 64432], [107, 64712], [114, 64991], [121, 65372]]}, {"verse": 9, "start": 66375, "end": 76696, "text": "Pero como Jesús resucitó por la mañana, el primer día de la semana, apareció primeramente a María Magdalena, de la cual había echado siete demonios.", "words": [[0, 66375], [5, 66657], [10, 66837], [16, 67657], [25, 68477], [29, 68637], [32, 68777], [40, 69177], [43, 69397], [50, 69697], [54, 70017], [57, 70157], [60, 70297], [68, 70957], [77, 71517], [90, 72297], [92, 72397], [98, 72597], [109, 73872], [112, 73972], [115, 74072], [120, 74332], [126, 74812], [133, 75312], [139, 75672]]}, {"verse": 10, "start": 77046, "end": 82890, "text": "Yendo ella, lo hizo saber a los que habían estado con él, que estaban tristes y llorando.", "words": [[0, 77046], [6, 77433], [12, 77693], [15, 77913], [20, 78133], [26, 78533], [28, 78673], [32, 78813], [36, 78973], [43, 79253], [50, 79533], [54, 79913], [58, 80333], [62, 80693], [70, 81013], [78, 81773], [80, 82133]]}, {"verse": 11, "start": 83240, "end": 88503, "text": "Y ellos como oyeron que vivía, y que había sido visto de ella, no lo creyeron.", "words": [[0, 83240], [2, 83409], [8, 83729], [13, 84049], [20, 84369], [24, 84509], [31, 84989], [33, 85129], [37, 85269], [43, 85469], [48, 85749], [54, 86009], [57, 86289], [63, 86789], [66, 86909], [69, 87049]]}, {"verse": 12, "start": 88853, "end": 94907, "text": "Pero después apareció en otra forma a dos de ellos que iban caminando, yendo al campo.", "words": [[0, 88853], [5, 88996], [13, 89356], [22, 90156], [25, 90416], [30, 90596], [36, 91096], [38, 91356], [42, 91576], [45, 91796], [51, 92116], [55, 92396], [60, 92676], [71, 93396], [77, 94116], [80, 94256]]}, {"verse": 13, "start": 95257, "end": 101052, "text": "Y ellos fueron, y se lo comunicaron a los otros; y ni aun a ellos creyeron.", "words": [[0, 95257], [2, 95423], [8, 95583], [16, 96063], [18, 96583], [21, 96743], [24, 96883], [36, 97643], [38, 97803], [42, 97963], [49, 98872], [51, 99132], [54, 99272], [58, 99512], [60, 99692], [66, 100032]]}, {"verse": 14, "start": 101402, "end": 115491, "text": "Finalmente se apareció a los once mismos, estando sentados a la mesa, y los reprendió por su incredulidad y dureza de corazón, que no hubiesen creído a los que le habían visto resucitado.", "words": [[0, 101402], [11, 102109], [14, 102289], [23, 102929], [25, 103069], [29, 103229], [34, 103729], [42, 104849], [50, 105209], [59, 105849], [61, 106009], [64, 106109], [70, 106369], [72, 106909], [76, 107109], [86, 107989], [90, 108229], [93, 109209], [106, 109729], [108, 109949], [115, 110349], [118, 110509], [127, 111454], [131, 111535], [134, 111755], [143, 112215], [150, 112855], [152, 113115], [156, 113275], [160, 113415], [163, 113555], [170, 113915], [176, 114295]]}, {"verse": 15, "start": 115841, "end": 121808, "text": "Y les dijo: Id por todo el mundo; predicad el evangelio a toda criatura.", "words": [[0, 115841], [2, 115984], [6, 116124], [12, 116944], [15, 117054], [19, 117514], [24, 117854], [27, 118134], [34, 118899], [43, 119570], [46, 119810], [56, 120490], [58, 120610], [63, 120810]]}, {"verse": 16, "start": 122158, "end": 127705, "text": "El que crea y sea bautizado, será salvo; pero el que no crea, será condenado.", "words": [[0, 122158], [3, 122295], [7, 122435], [12, 122855], [14, 122955], [18, 123155], [29, 123875], [34, 124215], [41, 125123], [46, 125323], [49, 125463], [53, 125623], [56, 125803], [62, 126383], [67, 126803]]}, {"verse": 17, "start": 128055, "end": 135653, "text": "Y estas señales seguirán a los que creen: En mi nombre echarán fuera demonios; hablarán nuevas lenguas;", "words": [[0, 128055], [2, 128201], [8, 128481], [16, 129341], [25, 130021], [27, 130181], [31, 130321], [35, 130481], [42, 131444], [45, 131589], [48, 131749], [55, 132089], [63, 132649], [69, 132909], [79, 133979], [88, 134522], [95, 134782]]}, {"verse": 18, "start": 136003, "end": 145051, "text": "Tomarán serpientes en sus manos, y si beben algo mortal, no les dañará; sobre los enfermos pondrán sus manos, y sanarán.", "words": [[0, 136003], [8, 136447], [19, 137087], [22, 137327], [26, 137507], [33, 137927], [35, 138407], [38, 138567], [44, 138927], [49, 139147], [57, 140067], [60, 140267], [64, 140447], [72, 141299], [78, 141680], [82, 141920], [91, 142560], [99, 143020], [103, 143200], [110, 143640], [112, 144020]]}, {"verse": 19, "start": 145401, "end": 152233, "text": "Y el Señor, después que les habló, fue recibido arriba en el cielo, y se sentó a la derecha de Dios.", "words": [[0, 145401], [2, 145689], [5, 145809], [12, 146109], [20, 146569], [24, 146789], [28, 146929], [35, 147629], [39, 147849], [48, 148509], [55, 148849], [58, 149129], [61, 149269], [68, 149749], [70, 150144], [73, 150264], [79, 150804], [81, 150944], [84, 151024], [92, 151504], [95, 151664]]}, {"verse": 20, "start": 152583, "end": 162183, "text": "Y ellos, saliendo, predicaron en todas partes, obrando con ellos el Señor, y confirmando la palabra con las señales que se seguían. Amén.", "words": [[0, 152583], [2, 152728], [9, 153008], [19, 153588], [30, 154428], [33, 154588], [39, 154768], [47, 155908], [55, 156388], [59, 156668], [65, 156928], [68, 157148], [75, 157548], [77, 158108], [89, 158828], [92, 159008], [100, 159388], [104, 159688], [108, 159888], [116, 160548], [120, 160668], [123, 160808], [132, 161740]]}]}