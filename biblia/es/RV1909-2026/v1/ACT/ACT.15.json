{"book": "ACT", "chapter": 15, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 350165, "verses": [{"verse": 1, "start": 300, "end": 9926, "text": "Entonces algunos que venían de Judea enseñaban a los hermanos: Que si no os circuncidáis conforme al rito de Moisés, no podéis ser salvos.", "words": [[0, 300], [9, 1027], [17, 1427], [21, 1667], [28, 2047], [31, 2187], [37, 2727], [47, 3627], [49, 3747], [53, 3847], [63, 4838], [67, 5421], [70, 5593], [73, 5663], [76, 5733], [89, 6673], [98, 7233], [101, 7313], [106, 7573], [109, 7673], [117, 8513], [120, 8713], [127, 9033], [131, 9273]]}, {"verse": 2, "start": 10276, "end": 26130, "text": "Así que, al surgir una fuerte discusión y controversia entre ellos y Pablo y Bernabé, determinaron que subiesen Pablo y Bernabé a Jerusalén, y algunos otros de ellos, a los apóstoles y a los ancianos, sobre esta cuestión.", "words": [[0, 10276], [4, 10509], [9, 10729], [12, 10989], [19, 11469], [23, 11649], [30, 11909], [40, 12669], [42, 12749], [55, 13449], [61, 13729], [67, 14069], [69, 14269], [75, 14629], [77, 14789], [86, 15569], [99, 16529], [103, 16709], [112, 17209], [118, 17729], [120, 17929], [128, 18489], [130, 18629], [141, 19369], [143, 20069], [151, 20389], [157, 20809], [160, 21049], [167, 21928], [169, 22051], [173, 22191], [183, 22911], [185, 23531], [187, 23611], [191, 23771], [201, 24531], [207, 25091], [212, 25371]]}, {"verse": 3, "start": 26580, "end": 38441, "text": "Ellos, pues, habiendo sido acompañados de la iglesia, pasaron por la Fenicia y Samaria, contando la conversión de los Gentiles; y daban gran gozo a todos los hermanos.", "words": [[0, 26580], [7, 26986], [13, 27846], [22, 28166], [27, 28446], [39, 29246], [42, 29406], [45, 29506], [54, 30446], [62, 30866], [66, 31086], [69, 31266], [77, 31786], [79, 31906], [88, 32446], [97, 33306], [100, 33426], [111, 34006], [114, 34126], [118, 34246], [128, 35395], [130, 35519], [136, 35879], [141, 36179], [146, 36779], [148, 37039], [154, 37339], [158, 37619]]}, {"verse": 4, "start": 38891, "end": 48407, "text": "Y llegados a Jerusalén, fueron recibidos de la iglesia y de los apóstoles y de los ancianos: y refirieron todas las cosas que Dios había hecho con ellos.", "words": [[0, 38891], [2, 38994], [11, 39474], [13, 39654], [24, 40354], [31, 40834], [41, 41654], [44, 41794], [47, 41894], [55, 42374], [57, 42494], [60, 42574], [64, 42694], [74, 43314], [76, 43514], [79, 43574], [83, 43714], [93, 44772], [95, 45140], [106, 45540], [112, 45840], [116, 46140], [122, 46480], [126, 46740], [131, 46960], [137, 47320], [143, 47640], [147, 47880]]}, {"verse": 5, "start": 48857, "end": 59355, "text": "Pero algunos de la secta de los fariseos, que habían creído, se levantaron, diciendo: Que es necesario circuncidarlos, y mandarles que guarden la ley de Moisés.", "words": [[0, 48857], [5, 49021], [13, 49461], [16, 49681], [19, 49801], [25, 50281], [28, 50361], [32, 50501], [42, 51181], [46, 51501], [53, 51741], [61, 52281], [64, 52641], [76, 53441], [86, 54763], [90, 54877], [93, 54957], [103, 55537], [119, 56577], [121, 57137], [131, 57677], [135, 57857], [143, 58237], [146, 58357], [150, 58537], [153, 58657]]}, {"verse": 6, "start": 59705, "end": 64063, "text": "Y se juntaron los apóstoles y los ancianos para conocer de este asunto.", "words": [[0, 59705], [2, 59855], [5, 59975], [14, 60575], [18, 60735], [28, 61435], [30, 61595], [34, 61755], [43, 62275], [48, 62475], [56, 62935], [59, 63135], [64, 63375]]}, {"verse": 7, "start": 64513, "end": 77701, "text": "Y habiendo habido grande contienda, levantándose Pedro, les dijo: Varones hermanos, vosotros sabéis cómo ya hace algún tiempo que Dios escogió que los Gentiles oyesen por mi boca la palabra del evangelio, y creyesen.", "words": [[0, 64513], [2, 64638], [11, 65018], [18, 65318], [25, 65618], [36, 66398], [49, 67298], [56, 68238], [60, 68338], [66, 69277], [74, 69477], [84, 69997], [93, 70477], [100, 70977], [105, 71257], [108, 71577], [113, 71837], [119, 72097], [126, 72437], [130, 72697], [135, 72917], [143, 73497], [147, 73637], [151, 73757], [160, 74317], [167, 74817], [171, 74957], [174, 75117], [179, 75357], [182, 75537], [190, 75857], [194, 76057], [205, 76737], [207, 76917]]}, {"verse": 8, "start": 78151, "end": 84783, "text": "Y Dios, que conoce los corazones, les dio testimonio, dándoles el Espíritu Santo también como a nosotros;", "words": [[0, 78151], [2, 78274], [8, 78494], [12, 78694], [19, 79154], [23, 79294], [34, 80394], [38, 80554], [42, 80794], [54, 81734], [63, 82114], [66, 82314], [75, 82874], [81, 83154], [89, 83634], [94, 83934], [96, 84074]]}, {"verse": 9, "start": 85233, "end": 90951, "text": "Y ninguna diferencia hizo entre nosotros y ellos, purificando con la fe sus corazones.", "words": [[0, 85233], [2, 85333], [10, 85653], [21, 86313], [26, 86793], [32, 87073], [41, 87593], [43, 87913], [50, 88573], [62, 89313], [66, 89513], [69, 89673], [72, 89853], [76, 90053]]}, {"verse": 10, "start": 91401, "end": 99707, "text": "Ahora pues, ¿por qué tentáis a Dios, poniendo sobre el cuello de los discípulos yugo, que ni nuestros padres ni nosotros hemos podido llevar?", "words": [[0, 91401], [6, 91658], [12, 92298], [17, 92378], [21, 92558], [29, 93018], [31, 93158], [37, 93838], [46, 94238], [52, 94518], [55, 94698], [62, 94998], [65, 95078], [69, 95238], [80, 95818], [86, 96498], [90, 96758], [93, 96878], [102, 97178], [109, 97718], [112, 97958], [121, 98338], [127, 98698], [134, 99178]]}, {"verse": 11, "start": 100157, "end": 104897, "text": "Más bien, por la gracia del Señor Jesús creemos que seremos salvos, como también ellos.", "words": [[0, 100157], [4, 100337], [10, 100477], [14, 100677], [17, 100817], [24, 101217], [28, 101317], [34, 101577], [40, 102257], [48, 102597], [52, 102797], [60, 103157], [68, 103717], [73, 103997], [81, 104397]]}, {"verse": 12, "start": 105247, "end": 117423, "text": "Entonces toda la multitud calló, y oyeron a Bernabé y a Pablo, que contaban cuán grandes maravillas y señales Dios había hecho por ellos entre los Gentiles.", "words": [[0, 105247], [9, 105831], [14, 106531], [17, 106791], [26, 107641], [33, 108491], [35, 108551], [42, 109031], [44, 109131], [52, 109771], [54, 109951], [56, 110071], [63, 110551], [67, 111051], [76, 111611], [81, 111951], [89, 112351], [100, 112991], [102, 113211], [110, 113891], [115, 114351], [121, 114891], [127, 115311], [131, 115551], [137, 115791], [143, 116151], [147, 116371]]}, {"verse": 13, "start": 117873, "end": 124107, "text": "Y después que hubieron callado, Jacobo respondió, diciendo: Varones hermanos, oídme:", "words": [[0, 117873], [2, 117993], [10, 118273], [14, 118473], [23, 118793], [32, 119913], [39, 120573], [50, 121293], [60, 122812], [68, 123012], [78, 123572]]}, {"verse": 14, "start": 124557, "end": 130424, "text": "Simón ha contado cómo Dios primero visitó a los Gentiles, para tomar de ellos pueblo para su nombre;", "words": [[0, 124557], [6, 125003], [9, 125103], [17, 125563], [22, 125863], [27, 126103], [35, 126503], [42, 127063], [44, 127143], [48, 127243], [58, 127803], [63, 128363], [69, 128643], [72, 128883], [78, 129083], [85, 129463], [90, 129763], [93, 129943]]}, {"verse": 15, "start": 130874, "end": 135868, "text": "Y con esto concuerdan las palabras de los profetas, como está escrito:", "words": [[0, 130874], [2, 130978], [6, 131158], [11, 131398], [22, 132038], [26, 132178], [35, 132578], [38, 132778], [42, 132898], [52, 133518], [57, 133818], [62, 134038]]}, {"verse": 16, "start": 136318, "end": 144321, "text": "Después de esto volveré y restauraré la habitación de David, que estaba caída; y repararé sus ruinas, y la volveré a levantar;", "words": [[0, 136318], [8, 136656], [11, 136896], [16, 137156], [24, 137796], [26, 137916], [37, 138536], [40, 138676], [51, 139236], [54, 139376], [61, 139656], [65, 140116], [72, 140436], [79, 141397], [81, 141486], [90, 141986], [94, 142166], [102, 142846], [104, 143166], [107, 143266], [115, 143666], [117, 143686]]}, {"verse": 17, "start": 144771, "end": 153486, "text": "Para que el resto de los hombres busque al Señor, y todos los Gentiles, sobre los cuales es llamado mi nombre, dice el Señor, que hace todas estas cosas.", "words": [[0, 144771], [5, 144900], [9, 145100], [12, 145220], [18, 145460], [21, 145620], [25, 145740], [33, 146060], [40, 146480], [43, 146600], [50, 146880], [52, 147260], [58, 147460], [62, 147700], [72, 148580], [78, 148800], [82, 148980], [89, 149240], [92, 149500], [100, 149820], [103, 150020], [111, 150780], [116, 151000], [119, 151180], [126, 151880], [130, 151980], [135, 152200], [141, 152480], [147, 152800]]}, {"verse": 18, "start": 153936, "end": 157551, "text": "Conocidas son a Dios desde el principio del mundo todas sus obras.", "words": [[0, 153936], [10, 154413], [14, 154633], [16, 154753], [21, 154933], [27, 155193], [30, 155393], [40, 155793], [44, 156033], [50, 156313], [56, 156633], [60, 156893]]}, {"verse": 19, "start": 158001, "end": 163402, "text": "Por lo cual yo juzgo, que los que de los Gentiles se convierten a Dios, no han de ser inquietados;", "words": [[0, 158001], [4, 158127], [7, 158247], [12, 158547], [15, 158727], [22, 159207], [26, 159407], [30, 159547], [34, 159707], [37, 159827], [41, 159947], [50, 160447], [53, 160607], [64, 161087], [66, 161247], [72, 161487], [75, 162027], [79, 162187], [82, 162307], [86, 162487]]}, {"verse": 20, "start": 163852, "end": 171719, "text": "Sino escribirles que se aparten de las contaminaciones de los ídolos, y de inmoralidad sexual, y de animales estrangulados, y de sangre.", "words": [[0, 163852], [5, 164034], [17, 164674], [21, 164834], [24, 164974], [32, 165474], [35, 165554], [39, 165674], [55, 166474], [58, 166654], [62, 166774], [70, 167354], [72, 167674], [75, 167774], [87, 168374], [95, 168834], [97, 169414], [100, 169534], [109, 169854], [124, 170814], [126, 171054], [129, 171154]]}, {"verse": 21, "start": 172169, "end": 180144, "text": "Porque Moisés desde los tiempos antiguos tiene en cada ciudad quien le predique en las sinagogas, donde es leído cada sábado.", "words": [[0, 172169], [7, 172368], [14, 172768], [20, 173028], [24, 173308], [32, 173808], [41, 174115], [47, 174421], [50, 174728], [55, 175068], [62, 175468], [68, 175768], [71, 176098], [80, 176428], [83, 176568], [87, 176708], [98, 177848], [104, 178008], [107, 178268], [113, 178648], [118, 178948]]}, {"verse": 22, "start": 180494, "end": 199125, "text": "Entonces pareció bien a los apóstoles y a los ancianos, con toda la iglesia, elegir varones de ellos, y enviarlos a Antioquía con Pablo y Bernabé: a Judas que tenía por sobrenombre Barsabas, y a Silas, varones principales entre los hermanos;", "words": [[0, 180494], [9, 181057], [17, 181897], [22, 182177], [24, 182417], [28, 182557], [38, 183277], [40, 183597], [42, 183677], [46, 183817], [56, 184457], [60, 184897], [65, 185137], [68, 185357], [77, 185797], [84, 186437], [92, 186837], [95, 187057], [102, 187377], [104, 187937], [114, 188657], [116, 189037], [126, 189877], [130, 190137], [136, 190697], [138, 190877], [147, 191876], [149, 192040], [155, 192220], [159, 192550], [165, 192880], [169, 193140], [181, 194030], [191, 194920], [193, 195327], [195, 195733], [202, 196140], [210, 196920], [222, 197880], [228, 198200], [232, 198400]]}, {"verse": 23, "start": 199575, "end": 210479, "text": "Y escribir por mano de ellos: Los apóstoles y los ancianos y los hermanos, a los hermanos de los Gentiles que están en Antioquía, y en Siria, y en Cilicia, saludos:", "words": [[0, 199575], [2, 199986], [11, 200546], [15, 200766], [20, 201166], [23, 201426], [30, 202240], [34, 202345], [44, 202985], [46, 203145], [50, 203245], [59, 203845], [61, 203985], [65, 204125], [75, 205105], [77, 205185], [81, 205305], [90, 205805], [93, 205885], [97, 206005], [106, 206565], [110, 206805], [116, 207065], [119, 207245], [130, 207965], [132, 208125], [135, 208225], [142, 208725], [144, 208885], [147, 209365], [156, 209845]]}, {"verse": 24, "start": 210929, "end": 223665, "text": "Por cuanto hemos oído que algunos que han salido de nosotros, os han inquietado con palabras, trastornando vuestras almas, mandando circuncidaros y guardar la ley, a los cuales no mandamos;", "words": [[0, 210929], [4, 211076], [11, 211376], [17, 211716], [22, 212176], [26, 212396], [34, 212736], [38, 213036], [42, 213156], [49, 213576], [52, 213696], [62, 214216], [65, 214856], [69, 215076], [80, 215656], [84, 215836], [94, 216716], [107, 217436], [116, 217796], [123, 218616], [132, 219156], [146, 220096], [148, 220196], [156, 220616], [159, 220756], [164, 221036], [166, 221556], [170, 221696], [177, 221976], [180, 222236]]}, {"verse": 25, "start": 224115, "end": 231342, "text": "Nos ha parecido, congregados en uno, elegir varones, y enviarlos a vosotros con nuestros amados Bernabé y Pablo,", "words": [[0, 224115], [4, 224223], [7, 224403], [17, 224863], [29, 225523], [32, 225703], [37, 226523], [44, 226883], [53, 227383], [55, 227843], [65, 228323], [67, 228523], [76, 228983], [80, 229223], [89, 229483], [96, 230023], [104, 230683], [106, 230843]]}, {"verse": 26, "start": 231792, "end": 235575, "text": "Hombres que han expuesto sus vidas por el nombre de nuestro Señor Jesucristo.", "words": [[0, 231792], [8, 232034], [12, 232254], [16, 232334], [25, 232754], [29, 232954], [35, 233414], [39, 233614], [42, 233714], [49, 233954], [52, 234134], [60, 234294], [66, 234714]]}, {"verse": 27, "start": 236025, "end": 241884, "text": "Así que, enviamos a Judas y a Silas, los cuales también de viva voz os harán saber lo mismo.", "words": [[0, 236025], [4, 236266], [9, 236446], [18, 236946], [20, 237226], [26, 237486], [28, 237866], [30, 237986], [37, 238826], [41, 238906], [48, 239206], [56, 239606], [59, 239866], [64, 240126], [68, 240546], [71, 240686], [77, 240986], [83, 241226], [86, 241426]]}, {"verse": 28, "start": 242334, "end": 250164, "text": "Que ha parecido bien al Espíritu Santo, y a nosotros, no imponeros ninguna carga más que estas cosas necesarias:", "words": [[0, 242334], [4, 242424], [7, 242744], [16, 243064], [21, 243304], [24, 243504], [33, 244064], [40, 244404], [42, 244944], [44, 245024], [54, 245384], [57, 245744], [67, 246284], [75, 246624], [81, 247044], [85, 247344], [89, 247584], [95, 247804], [101, 248184]]}, {"verse": 29, "start": 250614, "end": 261711, "text": "Que os abstengáis de cosas sacrificadas a ídolos, y de sangre, y de animales estrangulados, y de inmoralidad sexual; de las cuales cosas si os guardáis, bien haréis. Pasadlo bien.", "words": [[0, 250614], [4, 250691], [7, 250771], [18, 251351], [21, 251511], [27, 251751], [40, 252611], [42, 252791], [50, 253291], [52, 253671], [55, 253791], [63, 254151], [65, 254431], [68, 254531], [77, 254811], [92, 255771], [94, 256031], [97, 256111], [109, 256691], [117, 257696], [120, 257968], [124, 258108], [131, 258308], [137, 258728], [140, 259008], [143, 259108], [153, 259608], [158, 259968], [166, 260836], [174, 261300]]}, {"verse": 30, "start": 262061, "end": 269140, "text": "Ellos entonces enviados, descendieron a Antioquía; y juntando la multitud, dieron la carta.", "words": [[0, 262061], [6, 262349], [15, 262869], [25, 263769], [38, 264949], [40, 265169], [51, 266398], [53, 266503], [62, 267103], [65, 267283], [75, 267823], [82, 268263], [85, 268483]]}, {"verse": 31, "start": 269590, "end": 273934, "text": "La cual, como leyeron, fueron gozosos de la consolación.", "words": [[0, 269590], [3, 269736], [9, 270056], [14, 270646], [23, 271236], [30, 271476], [38, 272456], [41, 272736], [44, 272876]]}, {"verse": 32, "start": 274384, "end": 283833, "text": "Judas también y Silas, como ellos también eran profetas, animaron y fortalecieron a los hermanos con abundancia de palabra.", "words": [[0, 274384], [6, 274693], [14, 275893], [16, 275973], [23, 276953], [28, 277133], [34, 277353], [42, 277753], [47, 278073], [57, 279333], [66, 279993], [68, 280333], [82, 281273], [84, 281393], [88, 281533], [97, 282133], [101, 282293], [112, 282993], [115, 283113]]}, {"verse": 33, "start": 284283, "end": 290495, "text": "Y pasando allí algún tiempo, fueron enviados de los hermanos a los apóstoles en paz.", "words": [[0, 284283], [2, 284543], [10, 284943], [15, 285243], [21, 285583], [29, 286103], [36, 286963], [45, 287643], [48, 287803], [52, 287963], [61, 288703], [63, 288843], [67, 288963], [77, 289623], [80, 289923]]}, {"verse": 34, "start": 290945, "end": 293899, "text": "Pero a Silas pareció bien el quedarse allí.", "words": [[0, 290945], [5, 291236], [7, 291562], [13, 291889], [21, 292469], [26, 292709], [29, 292869], [38, 293329]]}, {"verse": 35, "start": 294349, "end": 303368, "text": "Y Pablo y Bernabé se estaban en Antioquía, enseñando la palabra del Señor y anunciando el evangelio con otros muchos.", "words": [[0, 294349], [2, 294495], [8, 294895], [10, 295135], [18, 295675], [21, 295895], [29, 296375], [32, 296695], [43, 297675], [53, 298675], [56, 298835], [64, 299175], [68, 299475], [74, 299855], [76, 300415], [87, 301235], [90, 301375], [100, 302115], [104, 302335], [110, 302575]]}, {"verse": 36, "start": 303818, "end": 313985, "text": "Y después de algunos días, Pablo dijo a Bernabé: Volvamos a visitar a los hermanos por todas las ciudades en las cuales hemos anunciado la palabra del Señor, cómo están.", "words": [[0, 303818], [2, 303922], [10, 304222], [13, 304402], [21, 304642], [27, 304982], [33, 305762], [38, 306102], [40, 306495], [49, 307077], [58, 307516], [60, 307656], [68, 308116], [70, 308156], [74, 308276], [83, 308796], [87, 308956], [93, 309156], [97, 309396], [106, 310316], [109, 310476], [113, 310596], [120, 310836], [126, 311156], [136, 311836], [139, 311956], [147, 312236], [151, 312476], [158, 313256], [163, 313436]]}, {"verse": 37, "start": 314335, "end": 320154, "text": "Y Bernabé quería que tomasen consigo a Juan, el que tenía por sobrenombre Marcos;", "words": [[0, 314335], [2, 314480], [10, 315080], [17, 315380], [21, 315680], [29, 316200], [37, 316580], [39, 316780], [45, 317480], [48, 317700], [52, 317840], [58, 318180], [62, 318460], [74, 319320]]}, {"verse": 38, "start": 320604, "end": 329700, "text": "Pero a Pablo no le parecía bien llevar consigo al que se había apartado de ellos desde Panfilia, y no había ido con ellos a la obra.", "words": [[0, 320604], [5, 320769], [7, 320909], [13, 321269], [16, 322009], [19, 322169], [27, 322689], [32, 322929], [39, 323269], [47, 323809], [50, 324109], [54, 324249], [57, 324429], [63, 324689], [72, 325449], [75, 325649], [81, 325929], [87, 326489], [97, 327049], [99, 327489], [102, 327669], [108, 328029], [112, 328389], [116, 328649], [122, 328849], [124, 329069], [127, 329169]]}, {"verse": 39, "start": 330150, "end": 338297, "text": "Y hubo tal desacuerdo entre ellos, que se apartaron el uno del otro; y Bernabé tomando a Marcos, navegó a Chipre.", "words": [[0, 330150], [2, 330344], [7, 330684], [11, 330884], [22, 331564], [28, 331864], [35, 332324], [39, 332824], [42, 332964], [52, 333624], [55, 333844], [59, 334044], [63, 334264], [69, 335037], [71, 335164], [79, 335684], [87, 336084], [89, 336204], [97, 336744], [104, 337584], [106, 337684]]}, {"verse": 40, "start": 338747, "end": 345091, "text": "Y Pablo escogiendo a Silas, salió encomendado de los hermanos a la gracia del Señor.", "words": [[0, 338747], [2, 338875], [8, 339755], [19, 340395], [21, 341035], [28, 341675], [34, 342075], [46, 342875], [49, 343015], [53, 343135], [62, 343715], [64, 343835], [67, 343935], [74, 344395], [78, 344535]]}, {"verse": 41, "start": 345541, "end": 349765, "text": "Y anduvo la Siria y la Cilicia, fortaleciendo a las iglesias.", "words": [[0, 345541], [2, 345684], [9, 346024], [12, 346394], [18, 346764], [20, 346904], [23, 347004], [32, 347644], [46, 348644], [48, 348804], [52, 348964]]}]}