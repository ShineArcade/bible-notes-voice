{"book": "PSA", "chapter": 33, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 129689, "verses": [{"verse": 1, "start": 300, "end": 5435, "text": "Alegraos, justos, en Jehová: a los rectos es hermosa la alabanza.", "words": [[0, 542], [10, 822], [18, 1642], [21, 1862], [29, 2779], [31, 3019], [35, 3159], [42, 3572], [45, 3986], [53, 4399], [56, 4559]]}, {"verse": 2, "start": 5785, "end": 10560, "text": "Celebrad a Jehová con arpa: cantadle con salterio y decacordio.", "words": [[0, 5950], [9, 6156], [11, 6363], [18, 6843], [22, 6983], [28, 8166], [37, 8546], [41, 8826], [50, 9526], [52, 10043]]}, {"verse": 3, "start": 10910, "end": 15427, "text": "Cantadle canción nueva: hacedlo bien tañendo con júbilo.", "words": [[0, 11194], [9, 11514], [17, 11934], [24, 13145], [32, 13505], [37, 13985], [45, 14465], [49, 14665]]}, {"verse": 4, "start": 15777, "end": 20995, "text": "Porque recta es la palabra de Jehová, y toda su obra con verdad hecha.", "words": [[0, 15777], [7, 16059], [13, 16679], [16, 16899], [19, 17059], [27, 17479], [30, 17679], [38, 18419], [40, 18599], [45, 18859], [48, 19199], [53, 19499], [57, 19759], [64, 20199]]}, {"verse": 5, "start": 21345, "end": 26525, "text": "Él ama justicia y juicio: de la misericordia de Jehová está llena la tierra.", "words": [[0, 21577], [3, 21842], [7, 22107], [16, 22372], [18, 22492], [26, 23374], [29, 23540], [32, 23660], [45, 24540], [48, 24640], [55, 25120], [60, 25360], [66, 25720], [69, 25860]]}, {"verse": 6, "start": 26875, "end": 33864, "text": "Por la palabra de Jehová fueron hechos los cielos, y todo el ejército de ellos por el espíritu de su boca.", "words": [[0, 26875], [4, 27018], [7, 27138], [15, 27458], [18, 27678], [25, 28138], [32, 28378], [39, 28758], [43, 28958], [51, 29898], [53, 30078], [58, 30398], [61, 30598], [70, 31258], [73, 31478], [79, 31738], [83, 32018], [86, 32158], [95, 32878], [98, 33018], [101, 33198]]}, {"verse": 7, "start": 34214, "end": 40007, "text":