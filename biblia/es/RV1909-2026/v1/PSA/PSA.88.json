{"book": "PSA", "chapter": 88, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 122107, "verses": [{"verse": 1, "start": 300, "end": 14846, "text": "Canción: Salmo para los hijos de Coré: al Músico principal: para cantar sobre Mahalat: Masquil de Hemán ezraíta. OH Jehová, Dios de mi salvación, día y noche clamo delante de ti.", "words": [[0, 300], [9, 1410], [15, 1988], [20, 2288], [24, 2468], [30, 2748], [33, 3112], [39, 3776], [42, 3938], [49, 4398], [60, 5608], [65, 5775], [72, 6335], [78, 6635], [87, 8180], [95, 8540], [98, 9056], [104, 9573], [113, 10354], [116, 10543], [124, 11223], [129, 11403], [132, 11583], [135, 11683], [146, 12683], [150, 12963], [152, 13203], [158, 13443], [164, 13963], [172, 14323], [175, 14503]]}, {"verse": 2, "start": 15296, "end": 20230, "text": "Entre mi oración en tu presencia: inclina tu oído a mi clamor.", "words": [[0, 15296], [6, 15593], [9, 15853], [17, 16313], [20, 16533], [23, 16653], [34, 18303], [42, 18683], [45, 18923], [50, 19343], [52, 19523], [55, 19643]]}, {"verse": 3, "start": 20680, "end": 25746, "text": "Porque mi alma está harta de males, y mi vida cercana al sepulcro.", "words": [[0, 20680], [7, 20844], [10, 21084], [15, 21384], [20, 21704], [26, 22184], [29, 22384], [36, 22804], [38, 23544], [41, 23704], [46, 23984], [54, 24604], [57, 24804]]}, {"verse": 4, "start": 26196, "end": 31329, "text": "Soy contado con los que descienden al hoyo, soy como hombre sin fuerza:", "words": [[0, 26196], [4, 26441], [12, 27161], [16, 27401], [20, 27561], [24, 27701], [35, 28281], [38, 28521], [44, 29321], [48, 29721], [53, 30041], [60, 30381], [64, 30621]]}, {"verse": 5, "start": 31779, "end": 40853, "text": "Libre entre los muertos, como los matados que yacen en el sepulcro, que no te acuerdas más de ellos, y que son cortados de tu mano.", "words": [[0, 31779], [6, 32223], [12, 32603], [16, 32803], [25, 33783], [30, 34103], [34, 34263], [42, 34843], [46, 35043], [52, 35543], [55, 35683], [58, 35823], [68, 36923], [72, 37023], [75, 37163], [78, 37283], [87, 37703], [91, 37863], [94, 38063], [101, 38363], [103, 38983], [107, 39103], [111, 39283], [120, 40003], [123, 40163], [126, 40303]]}, {"verse": 6, "start": 41303, "end": 45718, "text": "Me has puesto en el hoyo profundo, en tinieblas, en honduras.", "words": [[0, 41303], [3, 41450], [7, 41590], [14, 41850], [17, 42130], [20, 42300], [25, 42470], [35, 43510], [38, 43730], [49, 44810], [52, 45297]]}, {"verse": 7, "start": 46168, "end": 51698, "text": "Sobre mí se ha acostado tu ira, y me has afligido con todas tus ondas. (Selah.)", "words": [[0, 46168], [6, 46390], [9, 46630], [12, 46810], [15, 46930], [24, 47390], [27, 47590], [32, 48190], [34, 48390], [37, 48510], [41, 48670], [50, 49290], [54, 49530], [60, 49850], [64, 50110], [71, 51461]]}, {"verse": 8, "start": 52148, "end": 60130, "text": "Has alejado de mí mis conocidos: me has puesto por abominación a ellos: encerrado estoy, y no puedo salir.", "words": [[0, 52445], [4, 52779], [12, 53112], [15, 53272], [18, 53432], [22, 53632], [33, 54801], [36, 54949], [40, 55149], [47, 55429], [51, 55929], [63, 56749], [65, 56949], [72, 57799], [82, 58571], [89, 58811], [91, 59131], [94, 59251], [100, 59511]]}, {"verse": 9, "start": 60580, "end": 68556, "text": "Mis ojos enfermaron a causa de mi aflicción: te he llamado, oh Jehová, cada día; he extendido a ti mis manos.", "words": [[0, 60580], [4, 60820], [9, 61140], [20, 62080], [22, 62180], [28, 62540], [31, 62800], [34, 62920], [45, 64175], [48, 64296], [51, 64376], [60, 64696], [63, 65016], [71, 65456], [76, 65676], [81, 66543], [84, 66825], [94, 67545], [96, 67665], [99, 67765], [103, 67905]]}, {"verse": 10, "start": 69006, "end": 74997, "text": "¿Harás tú milagro a los muertos? ¿se levantarán los muertos para alabarte? (Selah.)", "words": [[0, 69006], [7, 69354], [10, 69554], [18, 70274], [20, 70334], [24, 70434], [33, 71544], [37, 71634], [48, 72314], [52, 72414], [60, 72834], [65, 73154], [75, 74669]]}, {"verse": 11, "start": 75447, "end": 80556, "text": "¿Será contada en el sepulcro tu misericordia, o tu verdad en la perdición?", "words": [[0, 75447], [6, 75844], [14, 76524], [17, 76664], [20, 76824], [29, 77504], [32, 77564], [46, 78464], [48, 78684], [51, 78764], [58, 79064], [61, 79484], [64, 79624]]}, {"verse": 12, "start": 81006, "end": 86553, "text": "¿Será conocida en las tinieblas tu maravilla, ni tu justicia en la tierra del olvido?", "words": [[0, 81006], [6, 81328], [15, 81908], [18, 82028], [22, 82188], [32, 82828], [35, 82948], [46, 83788], [49, 84108], [52, 84268], [61, 84968], [64, 85128], [67, 85248], [74, 85628], [78, 85888]]}, {"verse": 13, "start": 87003, "end": 92501, "text": "Mas yo a ti he clamado, oh Jehová; y de mañana mi oración llegó antes a ti.", "words": [[0, 87163], [4, 87343], [7, 87523], [9, 87763], [12, 87923], [15, 88369], [24, 88815], [27, 89261], [35, 89943], [37, 90060], [40, 90180], [47, 90500], [50, 90780], [58, 91200], [64, 91520], [70, 91860], [72, 92160]]}, {"verse": 14, "start": 92951, "end": 97840, "text": "¿Por qué, oh Jehová, desechas mi alma? ¿por qué escondes de mí tu rostro?", "words": [[0, 92951], [5, 93076], [10, 93396], [13, 93716], [21, 94036], [30, 94816], [33, 94996], [39, 95911], [44, 96052], [48, 96212], [57, 96732], [60, 96872], [63, 97012], [66, 97152]]}, {"verse": 15, "start": 98290, "end": 105194, "text": "Yo soy afligido y necesitado: desde la juventud he llevado tus terrores, he estado temeroso.", "words": [[0, 98290], [3, 98477], [7, 98717], [16, 99417], [18, 99517], [30, 100798], [36, 101198], [39, 101418], [48, 102118], [51, 102358], [59, 102818], [63, 102998], [73, 103858], [76, 103918], [83, 104238]]}, {"verse": 16, "start": 105644, "end": 109942, "text": "Sobre mí han pasado tus iras; tus espantos me han cortado.", "words": [[0, 105644], [6, 105911], [9, 106191], [13, 106391], [20, 106811], [24, 107348], [30, 108157], [34, 108284], [43, 109244], [46, 109484], [50, 109644]]}, {"verse": 17, "start": 110392, "end": 115342, "text": "Me han rodeado como aguas de continuo; me han cercado a una.", "words": [[0, 110392], [3, 111236], [7, 111396], [15, 111936], [20, 112196], [26, 112556], [29, 112656], [39, 113784], [42, 114004], [46, 114104], [54, 114664], [56, 114824]]}, {"verse": 18, "start": 115792, "end": 121707, "text": "Has alejado de mí el amigo y el compañero; y mis conocidos se esconden en la tiniebla.", "words": [[0, 115942], [4, 116092], [12, 116532], [15, 116692], [18, 116892], [21, 117152], [27, 117472], [29, 117672], [32, 117812], [43, 118929], [45, 119026], [49, 119166], [59, 119886], [62, 120106], [71, 120666], [74, 120866], [77, 121309]]}]}