{"book": "PSA", "chapter": 71, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 154780, "verses": [{"verse": 1, "start": 300, "end": 5490, "text": "In you, O LORD, do I put my trust: let me never be put to confusion.", "words": [[0, 300], [3, 487], [8, 967], [10, 967], [16, 1747], [19, 1887], [21, 2027], [25, 2287], [28, 2527], [35, 3452], [39, 3609], [42, 3789], [48, 4089], [51, 4309], [55, 4529], [58, 4689]]}, {"verse": 2, "start": 5840, "end": 11945, "text": "Deliver me in your righteousness, and cause me to escape: incline your ear to me, and save me.", "words": [[0, 5840], [8, 6062], [11, 6382], [14, 6562], [19, 6702], [34, 7262], [38, 7782], [44, 8102], [47, 8302], [50, 8462], [58, 9361], [66, 9924], [71, 10144], [75, 10404], [78, 10644], [82, 10864], [86, 11184], [91, 11524]]}, {"verse": 3, "start": 12295, "end": 20792, "text": "Be my strong habitation, to which I may continually resort: you have given commandment to save me; for you are my rock and my fortress.", "words": [[0, 12295], [3, 12406], [6, 12606], [13, 12966], [25, 14126], [28, 14326], [34, 14546], [36, 14706], [40, 14846], [52, 15466], [60, 16400], [64, 16528], [69, 16688], [75, 16888], [87, 17508], [90, 17648], [95, 17888], [99, 18497], [103, 18601], [107, 18841], [111, 19061], [114, 19241], [119, 19621], [123, 19941], [126, 20121]]}, {"verse": 4, "start": 21142, "end": 28701, "text": "Deliver me, O my God, out of the hand of the wicked, out of the hand of the unrighteous and cruel man.", "words": [[0, 21142], [8, 21460], [12, 21820], [14, 22000], [17, 22300], [22, 23360], [26, 23600], [29, 23760], [33, 23920], [38, 24220], [41, 24400], [45, 24520], [53, 25200], [57, 25600], [60, 25760], [64, 25920], [69, 26180], [72, 26400], [76, 26520], [88, 27340], [92, 27540], [98, 27960]]}, {"verse": 5, "start": 29051, "end": 33464, "text": "For you are my hope, O Lord GOD: you are my trust from my youth.", "words": [[0, 29051], [4, 29160], [8, 29400], [12, 29580], [15, 29760], [21, 30260], [23, 30360], [28, 30640], [33, 31569], [37, 31784], [41, 32044], [44, 32244], [50, 32574], [55, 32904], [58, 33144]]}, {"verse": 6, "start": 33814, "end": 42265, "text": "By you have I been held up from the womb: you are he that took me out of my mother’s bowels: my praise shall be continually of you.", "words": [[0, 33814], [3, 33956], [7, 34256], [12, 34496], [14, 34636], [19, 34816], [24, 35036], [27, 35296], [32, 35516], [36, 35656], [42, 36378], [46, 36526], [50, 36766], [53, 37086], [58, 37506], [63, 37686], [66, 37886], [70, 38086], [73, 38186], [76, 38346], [85, 38746], [93, 39617], [96, 39783], [103, 40203], [109, 40623], [112, 40803], [124, 41463], [127, 41803]]}, {"verse": 7, "start": 42615, "end": 46648, "text": "I am as a wonder to many; but you are my strong refuge.", "words": [[0, 42615], [2, 42839], [5, 42999], [8, 43159], [10, 43299], [17, 43599], [20, 43839], [26, 44600], [30, 44707], [34, 44987], [38, 45227], [41, 45407], [48, 45807]]}, {"verse": 8, "start": 46998, "end": 51093, "text": "Let my mouth be filled with your praise and with your honour all the day.", "words": [[0, 46998], [4, 47167], [7, 47407], [13, 47707], [16, 47947], [23, 48247], [28, 48487], [33, 48627], [40, 49027], [44, 49387], [49, 49567], [54, 49817], [61, 50067], [65, 50427], [69, 50587]]}, {"verse": 9, "start": 51443, "end": 56528, "text": "Cast me not off in the time of old age; forsake me not when my strength fails.", "words": [[0, 51443], [5, 51707], [8, 51967], [12, 52187], [16, 52507], [19, 52647], [23, 52747], [28, 53007], [31, 53167], [35, 53327], [40, 54153], [48, 54616], [51, 54776], [55, 54996], [60, 55236], [63, 55396], [72, 55736]]}, {"verse": 10, "start": 56878, "end": 62582, "text": "For my enemies speak against me; and they that lay wait for my soul take counsel together,", "words": [[0, 56878], [4, 56998], [7, 57198], [15, 57638], [21, 58038], [29, 58398], [33, 59074], [37, 59218], [42, 59378], [47, 59618], [51, 59818], [56, 60098], [60, 60298], [63, 60478], [68, 60778], [73, 61038], [81, 61438]]}, {"verse": 11, "start": 62932, "end": 68315, "text": "Saying, God has forsaken him: persecute and take him; for there is none to deliver him.", "words": [[0, 63267], [8, 63748], [12, 64008], [16, 64268], [25, 64788], [30, 65348], [40, 65874], [44, 66034], [49, 66274], [54, 66800], [58, 66908], [64, 67088], [67, 67208], [72, 67448], [75, 67668], [83, 67968]]}, {"verse": 12, "start": 68595, "end": 72468, "text": "O God, be not far from me: O my God, make haste for my help.", "words": [[0, 68650], [2, 68720], [7, 69080], [10, 69140], [14, 69320], [18, 69620], [23, 69840], [27, 70437], [29, 70537], [32, 70737], [37, 71297], [42, 71417], [48, 71857], [52, 71957], [55, 72137]]}, {"verse": 13, "start": 72818, "end": 80319, "text": "Let them be confounded and consumed that are adversaries to my soul; let them be covered with reproach and dishonour that seek my hurt.", "words": [[0, 72818], [4, 72985], [9, 73185], [12, 73345], [23, 73985], [27, 74245], [36, 74785], [41, 75105], [45, 75205], [57, 75865], [60, 76045], [63, 76225], [69, 76970], [73, 77087], [78, 77307], [81, 77467], [89, 77787], [94, 78007], [103, 78627], [107, 78977], [117, 79327], [122, 79467], [127, 79687], [130, 79907]]}, {"verse": 14, "start": 80669, "end": 84383, "text": "But I will hope continually, and will yet praise you more and more.", "words": [[0, 80669], [4, 80774], [6, 80874], [11, 81074], [16, 81314], [29, 81954], [33, 82354], [38, 82534], [42, 82754], [49, 83034], [53, 83414], [58, 83734], [62, 83894]]}, {"verse": 15, "start": 84733, "end": 90590, "text": "My mouth shall show forth your righteousness and your salvation all the day; for I know not the numbers of it.", "words": [[0, 84733], [3, 84880], [9, 85160], [15, 85400], [20, 85620], [26, 85940], [31, 86120], [45, 86640], [49, 87020], [54, 87140], [64, 87700], [68, 88020], [72, 88160], [77, 88853], [81, 88976], [83, 89136], [88, 89336], [92, 89536], [96, 89716], [104, 90036], [107, 90296]]}, {"verse": 16, "start": 90940, "end": 97213, "text": "I will go in the strength of the Lord GOD: I will make mention of your righteousness, even of your only.", "words": [[0, 90940], [2, 91084], [7, 91244], [10, 91444], [13, 91624], [17, 91724], [26, 92064], [29, 92284], [33, 92424], [38, 92664], [43, 93533], [45, 93687], [50, 93867], [55, 94127], [63, 94547], [66, 94807], [71, 94947], [86, 95987], [91, 96287], [94, 96527], [99, 96707]]}, {"verse": 17, "start": 97563, "end": 103268, "text": "O God, you have taught me from my youth: and until now have I declared your wondrous works.", "words": [[0, 97647], [2, 97767], [7, 98307], [11, 98387], [16, 98547], [23, 98807], [26, 99027], [31, 99267], [34, 99547], [41, 100047], [45, 100211], [51, 100531], [55, 100991], [60, 101151], [62, 101311], [71, 101731], [76, 102011], [85, 102611]]}, {"verse": 18, "start": 103618, "end": 113872, "text": "Now also when I am old and grayheaded, O God, forsake me not; until I have showed your strength to this generation, and your power to every one that is to come.", "words": [[0, 103618], [4, 103878], [9, 104478], [14, 104658], [16, 104838], [19, 104978], [23, 105358], [27, 105858], [39, 106358], [41, 106458], [46, 106998], [54, 107498], [57, 107678], [62, 108362], [68, 108638], [70, 108898], [75, 109078], [82, 109358], [87, 109598], [96, 109998], [99, 110238], [104, 110418], [116, 111038], [120, 111558], [125, 111698], [131, 112058], [134, 112251], [140, 112445], [144, 112638], [149, 113098], [152, 113258], [155, 113398]]}, {"verse": 19, "start": 114222, "end": 120798, "text": "Your righteousness also, O God, is very high, who have done great things: O God, who is like to you!", "words": [[0, 114222], [5, 114342], [19, 114862], [25, 115562], [27, 115782], [32, 116322], [35, 116442], [40, 116762], [46, 117182], [50, 117502], [55, 117642], [60, 117862], [66, 118142], [74, 119149], [76, 119259], [81, 119759], [85, 119859], [88, 120019], [93, 120239], [96, 120459]]}, {"verse": 20, "start": 121148, "end": 127874, "text": "You, which have showed me great and severe troubles, shall revive me again, and shall bring me up again from the depths of the earth.", "words": [[0, 121148], [5, 121300], [11, 121520], [16, 121680], [23, 121940], [26, 122120], [32, 122440], [36, 122600], [43, 122860], [53, 123760], [59, 124020], [66, 124400], [69, 124740], [76, 125380], [80, 125460], [86, 125660], [92, 125880], [95, 126080], [98, 126260], [104, 126520], [109, 126720], [113, 126880], [120, 127140], [123, 127360], [127, 127520]]}, {"verse": 21, "start": 128224, "end": 131958, "text": "You shall increase my greatness, and comfort me on every side.", "words": [[0, 128224], [4, 128358], [10, 128578], [19, 129098], [22, 129378], [33, 129878], [37, 130203], [45, 130543], [48, 130843], [51, 131023], [57, 131263]]}, {"verse": 22, "start": 132308, "end": 140689, "text": "I will also praise you with the psaltery, even your truth, O my God: to you will I sing with the harp, O you Holy One of Israel.", "words": [[0, 132308], [2, 132436], [7, 132596], [12, 132936], [19, 133316], [23, 133616], [28, 133776], [32, 134186], [42, 134596], [47, 134796], [52, 135016], [59, 135336], [61, 135656], [64, 135836], [69, 136631], [72, 136731], [76, 136971], [81, 137271], [83, 137451], [88, 137751], [93, 137971], [97, 138151], [103, 139011], [105, 139111], [109, 139351], [114, 139651], [118, 139951], [121, 140071]]}, {"verse": 23, "start": 141039, "end": 146373, "text": "My lips shall greatly rejoice when I sing to you; and my soul, which you have redeemed.", "words": [[0, 141039], [3, 141221], [8, 141561], [14, 141881], [22, 142241], [30, 142741], [35, 143061], [37, 143221], [42, 143501], [45, 143701], [50, 144305], [54, 144449], [57, 144649], [63, 145069], [69, 145324], [73, 145544], [78, 145744]]}, {"verse": 24, "start": 146723, "end": 154380, "text": "My tongue also shall talk of your righteousness all the day long: for they are confounded, for they are brought to shame, that seek my hurt.", "words": [[0, 146723], [3, 146871], [10, 147131], [15, 147551], [21, 147871], [26, 148151], [29, 148351], [34, 148451], [48, 148931], [52, 149391], [56, 149551], [60, 149711], [66, 150432], [70, 150539], [75, 150699], [79, 150779], [91, 151719], [95, 151959], [100, 152099], [104, 152199], [112, 152399], [115, 152599], [122, 152959], [127, 153399], [132, 153679], [135, 153939]]}]}