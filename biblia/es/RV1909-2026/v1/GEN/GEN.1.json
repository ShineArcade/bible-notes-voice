{"book": "GEN", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 277196, "verses": [{"verse": 1, "start": 300, "end": 4091, "text": "En el principio creó Dios los cielos y la tierra.", "words": [[0, 300], [3, 466], [6, 586], [16, 1086], [21, 1846], [26, 2106], [30, 2486], [37, 3166], [39, 3366], [42, 3486]]}, {"verse": 2, "start": 4441, "end": 16524, "text": "Y la tierra estaba desordenada y vacía, y las tinieblas estaban sobre la superficie del abismo, y el Espíritu de Dios se movía sobre la superficie de las aguas.", "words": [[0, 4441], [2, 4544], [5, 4664], [12, 5004], [19, 5504], [31, 6444], [33, 6584], [40, 7624], [42, 7844], [46, 8024], [56, 8664], [64, 9044], [70, 9504], [73, 9704], [84, 10584], [88, 10744], [96, 11644], [98, 11944], [101, 12064], [110, 12744], [113, 12864], [118, 13184], [121, 13524], [127, 14064], [133, 14344], [136, 14564], [147, 15564], [150, 15684], [154, 15844]]}, {"verse": 3, "start": 16874, "end": 20483, "text": "Y dijo Dios: Sea la luz: y fue la luz.", "words": [[0, 16874], [2, 17018], [7, 17318], [13, 18146], [17, 18410], [20, 18610], [25, 19414], [27, 19521], [31, 19721], [34, 19881]]}, {"verse": 4, "start": 20833, "end": 26078, "text": "Y vio Dios que la luz era buena: y apartó Dios la luz de las tinieblas.", "words": [[0, 20833], [2, 20958], [6, 21198], [11, 21478], [15, 21778], [18, 21938], [22, 22158], [26, 22418], [33, 23180], [35, 23329], [42, 23889], [47, 24089], [50, 24469], [54, 24709], [57, 24909], [61, 25049]]}, {"verse": 5, "start": 26428, "end": 33947, "text": "Y llamó Dios a la luz Día, y a las tinieblas llamó Noche: y fue la tarde y la mañana un día.", "words": [[0, 26428], [2, 26555], [8, 26875], [13, 27155], [15, 27435], [18, 27515], [22, 27755], [27, 28155], [29, 29115], [31, 29195], [35, 29315], [45, 30075], [51, 30555], [58, 31375], [60, 31494], [64, 31654], [67, 31814], [73, 32234], [75, 32654], [78, 32774], [85, 33174], [88, 33394]]}, {"verse": 6, "start": 34297, "end": 40384, "text": "Y dijo Dios: Haya expansión en medio de las aguas, y separe las aguas de las aguas.", "words": [[0, 34297], [2, 34458], [7, 34718], [13, 35546], [18, 35750], [28, 36490], [31, 36650], [37, 36890], [40, 37070], [44, 37250], [51, 37810], [53, 38290], [60, 38770], [64, 38970], [70, 39370], [73, 39470], [77, 39630]]}, {"verse": 7, "start": 40664, "end": 50434, "text": "E hizo Dios la expansión, y apartó las aguas que estaban debajo de la expansión, de las aguas que estaban sobre la expansión: y fue así.", "words": [[0, 40664], [2, 40785], [7, 41045], [12, 41345], [15, 41845], [26, 42705], [28, 43225], [35, 43745], [39, 43925], [45, 44325], [49, 44465], [57, 44785], [64, 45245], [67, 45405], [70, 45525], [81, 46565], [84, 46825], [88, 46965], [94, 47385], [98, 47505], [106, 47865], [112, 48205], [115, 48405], [126, 49597], [128, 49704], [132, 49864]]}, {"verse": 8, "start": 50784, "end": 56547, "text": "Y llamó Dios a la expansión Cielos: y fue la tarde y la mañana el día segundo.", "words": [[0, 50784], [2, 50907], [8, 51247], [13, 51507], [15, 51767], [18, 51847], [28, 52467], [36, 53557], [38, 53681], [42, 53861], [45, 54041], [51, 54441], [53, 54801], [56, 54921], [63, 55321], [66, 55641], [70, 55821]]}, {"verse": 9, "start": 56897, "end": 64550, "text": "Y dijo Dios: Júntense las aguas que están debajo de los cielos en un lugar, y descúbrase la seca: y fue así.", "words": [[0, 56897], [2, 57063], [7, 57283], [13, 58113], [22, 58651], [26, 58891], [32, 59371], [36, 59491], [42, 59771], [49, 60251], [52, 60431], [56, 60531], [63, 61011], [66, 61151], [69, 61251], [76, 61571], [78, 61776], [89, 62456], [92, 62616], [98, 63713], [100, 63820], [104, 64020]]}, {"verse": 10, "start": 64900, "end": 71881, "text": "Y llamó Dios a la seca Tierra, y a la reunión de las aguas llamó Mares: y vio Dios que era bueno.", "words": [[0, 64900], [2, 65184], [8, 65524], [13, 65664], [15, 65884], [18, 65964], [23, 66264], [31, 66744], [33, 67324], [35, 67404], [38, 67484], [46, 68024], [49, 68204], [53, 68364], [59, 68744], [65, 69064], [72, 70070], [74, 70359], [78, 70579], [83, 70839], [87, 71079], [91, 71259]]}, {"verse": 11, "start": 72231, "end": 84908, "text": "Y dijo Dios: Produzca la tierra hierba verde, hierba que dé semilla; árbol de fruto que dé fruto según su género, cuya semilla esté en él, sobre la tierra: y fue así.", "words": [[0, 72231], [2, 72390], [7, 72630], [13, 73556], [22, 74136], [25, 74276], [32, 74576], [39, 75116], [46, 75936], [53, 76516], [57, 76656], [60, 76816], [69, 77979], [75, 78379], [78, 78519], [84, 78919], [88, 79059], [91, 79219], [97, 79679], [103, 79879], [106, 80099], [114, 80859], [119, 81239], [127, 81699], [132, 81959], [135, 82199], [139, 82399], [145, 82759], [148, 82959], [156, 84059], [158, 84166], [162, 84366]]}, {"verse": 12, "start": 85258, "end": 96193, "text": "Y produjo la tierra hierba verde que da semilla según su naturaleza, y árbol que da fruto, cuya semilla está en él, según su género: y vio Dios que era bueno.", "words": [[0, 85258], [2, 85382], [10, 85982], [13, 86162], [20, 86542], [27, 87042], [33, 87402], [37, 87662], [40, 87842], [48, 88382], [54, 88662], [57, 88922], [69, 89782], [71, 90142], [77, 90542], [81, 90722], [84, 90862], [91, 91462], [96, 91862], [104, 92282], [109, 92482], [112, 92682], [116, 93022], [122, 93362], [125, 93622], [133, 94418], [135, 94564], [139, 94724], [144, 95024], [148, 95484], [152, 95664]]}, {"verse": 13, "start": 96543, "end": 99754, "text": "Y fue la tarde y la mañana el día tercero.", "words": [[0, 96543], [2, 96647], [6, 96847], [9, 97047], [15, 97467], [17, 97747], [20, 97867], [27, 98307], [30, 98647], [34, 98887]]}, {"verse": 14, "start": 100104, "end": 110301, "text": "Y dijo Dios: Haya luminarias en la expansión de los cielos para separar el día de la noche; y sirvan de señales para las estaciones, para días y años;", "words": [[0, 100104], [2, 100269], [7, 100569], [13, 101645], [18, 101979], [29, 102312], [32, 102452], [35, 102532], [45, 103112], [48, 103252], [52, 103332], [59, 103812], [64, 104012], [72, 104532], [75, 104612], [79, 104812], [82, 104932], [85, 105032], [92, 106040], [94, 106137], [101, 106577], [104, 106697], [112, 107257], [117, 107497], [121, 107697], [133, 108357], [138, 108957], [143, 109317], [145, 109757]]}, {"verse": 15, "start": 110651, "end": 116726, "text": "Y sean por lumbreras en la expansión de los cielos para alumbrar sobre la tierra: y fue así.", "words": [[0, 110651], [2, 110752], [7, 111012], [11, 111232], [21, 111792], [24, 112032], [27, 112132], [37, 112772], [40, 112932], [44, 113052], [51, 113592], [56, 113932], [65, 114492], [71, 114772], [74, 114952], [82, 115846], [84, 115954], [88, 116134]]}, {"verse": 16, "start": 117076, "end": 129529, "text": "E hizo Dios las dos grandes luminarias; la luminaria mayor para que señorease en el día, y la luminaria menor para que señorease en la noche: hizo también las estrellas.", "words": [[0, 117076], [2, 117276], [7, 117676], [12, 118056], [16, 118596], [20, 118796], [28, 119517], [40, 120407], [43, 120534], [53, 121094], [59, 121594], [64, 122154], [68, 122314], [78, 123174], [81, 123414], [84, 123594], [89, 123854], [91, 124014], [94, 124154], [104, 124754], [110, 125174], [115, 125534], [119, 125714], [129, 126534], [132, 126794], [135, 126934], [142, 127836], [147, 127966], [155, 128326], [159, 128566]]}, {"verse": 17, "start": 129879, "end": 135012, "text": "Y las puso Dios en la expansión de los cielos, para alumbrar sobre la tierra,", "words": [[0, 129879], [2, 129986], [6, 130126], [11, 130426], [16, 130706], [19, 130926], [22, 131046], [32, 131646], [35, 131786], [39, 131906], [47, 132546], [52, 133066], [61, 133806], [67, 134066], [70, 134286]]}, {"verse": 18, "start": 135362, "end": 143206, "text": "Y para señorear en el día y en la noche, y para apartar la luz y las tinieblas: y vio Dios que era bueno.", "words": [[0, 135362], [2, 135467], [7, 135687], [16, 136427], [19, 136587], [22, 136727], [26, 136987], [28, 137147], [31, 137267], [34, 137387], [41, 138047], [43, 138267], [48, 138487], [56, 139207], [59, 139387], [63, 139767], [65, 140167], [69, 140287], [80, 141459], [82, 141568], [86, 141808], [91, 142068], [95, 142408], [99, 142668]]}, {"verse": 19, "start": 143556, "end": 146238, "text": "Y fue la tarde y la mañana el día cuarto.", "words": [[0, 143556], [2, 143684], [6, 143844], [9, 144004], [15, 144344], [17, 144624], [20, 144744], [27, 145084], [30, 145364], [34, 145524]]}, {"verse": 20, "start": 146588, "end": 154609, "text": "Y dijo Dios: Produzcan las aguas seres vivientes, y aves que vuelen sobre la tierra, en la abierta expansión de los cielos.", "words": [[0, 146588], [2, 146716], [7, 146996], [13, 147976], [23, 148236], [27, 148416], [33, 148896], [39, 149116], [50, 149776], [52, 150376], [57, 150636], [61, 150836], [68, 151196], [74, 151376], [77, 151556], [85, 151936], [88, 152456], [91, 152556], [99, 152976], [109, 153576], [112, 153736], [116, 153856]]}, {"verse": 21, "start": 154889, "end": 167095, "text": "Y creó Dios los grandes animales marinos, y todo ser viviente que se mueve, que las aguas produjeron según su género, y toda ave alada según su especie: y vio Dios que era bueno.", "words": [[0, 154889], [2, 155017], [7, 155417], [12, 155617], [16, 155897], [24, 156197], [33, 156697], [42, 157377], [44, 157617], [49, 157877], [53, 158217], [62, 158777], [66, 158957], [69, 159117], [76, 159597], [80, 159657], [84, 159797], [90, 160117], [101, 160877], [107, 161317], [110, 161637], [118, 162417], [120, 162597], [125, 162857], [129, 163357], [135, 163857], [141, 164157], [144, 164477], [153, 165384], [155, 165530], [159, 165750], [164, 166030], [168, 166370], [172, 166550]]}, {"verse": 22, "start": 167445, "end": 177040, "text": "Y Dios los bendijo diciendo: Fructificad y multiplicaos, y llenad las aguas en los mares, y las aves se multipliquen en la tierra.", "words": [[0, 167445], [2, 167568], [7, 167958], [11, 168348], [19, 168848], [29, 169813], [41, 170789], [43, 170929], [57, 171969], [59, 172319], [66, 172669], [70, 172789], [76, 173309], [79, 173429], [83, 173549], [90, 174049], [92, 174509], [96, 174689], [101, 175149], [104, 175389], [117, 176089], [120, 176149], [123, 176249]]}, {"verse": 23, "start": 177320, "end": 180013, "text": "Y fue la tarde y la mañana el día quinto.", "words": [[0, 177320], [2, 177445], [6, 177605], [9, 177765], [15, 178105], [17, 178405], [20, 178545], [27, 178845], [30, 179125], [34, 179285]]}, {"verse": 24, "start": 180363, "end": 190401, "text": "Y dijo Dios: Produzca la tierra seres vivientes según su género, bestias y serpientes y animales de la tierra según su especie: y fue así.", "words": [[0, 180363], [2, 180510], [7, 180770], [13, 181530], [22, 182016], [25, 182116], [32, 182416], [38, 182756], [48, 183416], [54, 183736], [57, 183976], [65, 184776], [73, 185476], [75, 185656], [86, 186256], [88, 186516], [97, 186876], [100, 187136], [103, 187236], [110, 187616], [116, 188076], [119, 188316], [128, 189503], [130, 189610], [134, 189830]]}, {"verse": 25, "start": 190751, "end": 203409, "text": "E hizo Dios animales de la tierra según su género, y ganado según su género, y todo animal que anda arrastrando sobre la tierra según su especie: y vio Dios que era bueno.", "words": [[0, 190751], [2, 190914], [7, 191294], [12, 191614], [21, 192294], [24, 192554], [27, 192694], [34, 193094], [40, 193594], [43, 193894], [51, 194734], [53, 194914], [60, 195414], [66, 195694], [69, 195974], [77, 196934], [79, 196974], [84, 197214], [91, 197694], [95, 198014], [100, 198354], [112, 199254], [118, 199534], [121, 199774], [128, 200194], [134, 200534], [137, 200834], [146, 201812], [148, 201956], [152, 202156], [157, 202396], [161, 202656], [165, 202836]]}, {"verse": 26, "start": 203759, "end": 218812, "text": "Y dijo Dios: Hagamos al hombre a nuestra imagen, conforme a nuestra semejanza; y domine sobre los peces del mar, sobre las aves de los cielos, sobre las bestias, sobre toda la tierra y sobre todo animal que se arrastra sobre la tierra.", "words": [[0, 203759], [2, 203886], [7, 204146], [13, 205021], [21, 205466], [24, 205706], [31, 205946], [33, 206086], [41, 206246], [49, 206846], [58, 207746], [60, 207766], [68, 207926], [79, 209415], [81, 209554], [88, 209994], [94, 210254], [98, 210434], [104, 210834], [108, 210994], [113, 211734], [119, 211934], [123, 212134], [128, 212474], [131, 212594], [135, 212694], [143, 213474], [149, 213634], [153, 213854], [162, 214654], [168, 214834], [173, 215114], [176, 215294], [183, 215634], [185, 215829], [191, 216069], [196, 216349], [203, 216709], [207, 217009], [210, 217149], [219, 217629], [225, 217829], [228, 218049]]}, {"verse": 27, "start": 219092, "end": 226175, "text": "Y creó Dios al hombre a su imagen, a imagen de Dios lo creó; varón y hembra los creó.", "words": [[0, 219092], [2, 219239], [7, 219679], [12, 219839], [15, 220299], [22, 220599], [24, 220799], [27, 220919], [35, 221859], [37, 221959], [44, 222319], [47, 222679], [52, 222959], [55, 223239], [61, 224287], [67, 224577], [69, 225057], [76, 225451], [80, 225844]]}, {"verse": 28, "start": 226525, "end": 242863, "text": "Y los bendijo Dios; y les dijo Dios: Fructificad y multiplicaos, y llenad la tierra, y sojuzgadla, y dominad sobre los peces del mar, y sobre las aves de los cielos, y sobre todas las bestias que se mueven sobre la tierra.", "words": [[0, 226525], [2, 226630], [6, 226770], [14, 227270], [20, 228203], [22, 228323], [26, 228443], [31, 228703], [37, 229504], [49, 230473], [51, 230653], [65, 231833], [67, 232113], [74, 232513], [77, 232653], [85, 233613], [87, 233713], [99, 234953], [101, 235033], [109, 235613], [115, 235833], [119, 236033], [125, 236393], [129, 236593], [134, 236873], [136, 237313], [142, 237513], [146, 237733], [151, 238093], [154, 238213], [158, 238333], [166, 239461], [168, 239565], [174, 239745], [180, 240085], [184, 240385], [192, 240905], [196, 241085], [199, 241205], [206, 241645], [212, 241865], [215, 242025]]}, {"verse": 29, "start": 243143, "end": 255748, "text": "Y dijo Dios: He aquí que os he dado toda hierba que da semilla, que está sobre la superficie de toda la tierra; y todo árbol en que hay fruto de árbol que da semilla, os será para comer.", "words": [[0, 243143], [2, 243478], [7, 243850], [13, 244359], [16, 244497], [21, 244909], [25, 244982], [28, 245142], [31, 245362], [36, 245602], [41, 245862], [48, 246362], [52, 246502], [55, 246622], [64, 247282], [68, 247642], [73, 247882], [79, 248222], [82, 248362], [93, 249122], [96, 249242], [101, 249422], [104, 249622], [112, 250640], [114, 250786], [119, 251026], [125, 251566], [128, 251726], [132, 251866], [136, 252046], [142, 252446], [145, 252606], [151, 252814], [155, 253023], [158, 253231], [167, 253781], [170, 254331], [175, 254611], [180, 254911]]}, {"verse": 30, "start": 256098, "end": 268642, "text": "Y a toda bestia de la tierra, y a todas las aves de los cielos, y a todo lo que se mueve sobre la tierra, en que hay vida, toda hierba verde les será para comer: y fue así.", "words": [[0, 256098], [2, 256256], [4, 256356], [9, 256576], [16, 257296], [19, 257396], [22, 257516], [30, 258556], [32, 258616], [34, 258736], [40, 259036], [44, 259296], [49, 259756], [52, 259896], [56, 260016], [64, 261036], [66, 261096], [68, 261196], [73, 261496], [76, 261756], [80, 261896], [83, 262036], [89, 262456], [95, 262716], [98, 262916], [106, 263416], [109, 263676], [113, 263876], [117, 264036], [123, 265042], [128, 265282], [135, 265662], [141, 265962], [145, 266242], [150, 266502], [155, 266702], [162, 267791], [164, 267898], [168, 268098]]}, {"verse": 31, "start": 268992, "end": 276796, "text": "Y vio Dios todo lo que había hecho, y he aquí que era bueno en gran manera. Y fue la tarde y la mañana el día sexto.", "words": [[0, 268992], [2, 269292], [6, 269512], [11, 269752], [16, 270172], [19, 270472], [23, 270632], [29, 270872], [36, 271752], [38, 271852], [41, 271972], [46,