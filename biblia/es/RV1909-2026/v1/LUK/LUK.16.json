{"book": "LUK", "chapter": 16, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 267297, "verses": [{"verse": 1, "start": 300, "end": 11653, "text": "Y dijo también a sus discípulos: Había un hombre rico, el cual tenía un mayordomo, y este fue acusado delante de él como derrochador de sus bienes.", "words": [[0, 300], [2, 407], [7, 687], [15, 1167], [17, 1527], [21, 1707], [33, 2974], [39, 3278], [42, 3418], [49, 3738], [55, 4938], [58, 5018], [63, 5198], [69, 5558], [72, 6238], [83, 6918], [85, 6998], [90, 7218], [94, 7478], [102, 8238], [110, 8758], [113, 8978], [116, 9178], [121, 9518], [133, 10498], [136, 10738], [140, 10938]]}, {"verse": 2, "start": 12003, "end": 19530, "text": "Y le llamó, y le dijo: ¿Qué es esto que oigo de ti? Da cuenta de tu mayordomía, porque ya no podrás más ser mayordomo.", "words": [[0, 12003], [2, 12214], [5, 12444], [12, 12904], [14, 13104], [17, 13224], [23, 14002], [28, 14141], [31, 14321], [36, 14521], [40, 14741], [45, 14941], [48, 15101], [52, 15644], [55, 15744], [62, 15984], [65, 16224], [68, 16344], [80, 17244], [87, 17584], [90, 17804], [93, 17924], [100, 18344], [104, 18484], [108, 18804]]}, {"verse": 3, "start": 19810, "end": 29349, "text": "Entonces el mayordomo dijo dentro de sí: ¿Qué haré? que mi señor me quita la mayordomía. Cavar, no puedo; mendigar, tengo vergüenza.", "words": [[0, 19810], [9, 20395], [12, 21023], [22, 21650], [27, 21910], [34, 22530], [37, 22870], [41, 23407], [46, 23524], [52, 24184], [56, 24264], [59, 24384], [65, 24704], [68, 24904], [74, 25184], [77, 25669], [89, 26469], [96, 26659], [99, 26799], [106, 27543], [116, 28141], [122, 28541]]}, {"verse": 4, "start": 29699, "end": 34580, "text": "Yo sé lo que haré para que cuando sea quitado de la mayordomía, me reciban en sus casas.", "words": [[0, 29699], [3, 29920], [6, 30120], [9, 30240], [13, 30380], [18, 30640], [23, 30820], [27, 30980], [34, 31220], [38, 31520], [46, 32000], [49, 32120], [52, 32240], [64, 32980], [67, 33200], [75, 33660], [78, 33780], [82, 33900]]}, {"verse": 5, "start": 34860, "end": 40836, "text": "Y llamando a cada uno de los deudores de su señor, dijo al primero: ¿Cuánto debes a mi señor?", "words": [[0, 34860], [2, 34964], [11, 35464], [13, 35584], [18, 35744], [22, 36064], [25, 36204], [29, 36344], [38, 36864], [41, 37024], [44, 37164], [51, 38024], [56, 38344], [59, 38544], [68, 39399], [76, 39722], [82, 40082], [84, 40222], [87, 40282]]}, {"verse": 6, "start": 41116, "end": 49251, "text": "Y él dijo: Cien barriles de aceite. Y le dijo: Toma tu documento de deuda, y siéntate pronto, y escribe cincuenta.", "words": [[0, 41116], [2, 41304], [5, 41464], [11, 42263], [16, 42383], [25, 42923], [28, 43063], [36, 43967], [38, 44088], [41, 44188], [47, 44903], [52, 45162], [55, 45262], [65, 45882], [68, 45942], [75, 46342], [77, 46762], [86, 47242], [94, 47682], [96, 48082], [104, 48702]]}, {"verse": 7, "start": 49531, "end": 59204, "text": "Después dijo a otro: ¿Y tú, cuánto debes? Y él dijo: Cien coros de trigo. Y él le dijo: Toma tu documento de deuda, y escribe ochenta.", "words": [[0, 49531], [8, 49755], [13, 50035], [15, 50175], [21, 50854], [24, 50994], [28, 51174], [35, 51674], [42, 52433], [44, 52621], [47, 52781], [53, 53589], [58, 53719], [64, 54239], [67, 54339], [74, 55166], [76, 55333], [79, 55473], [82, 55633], [88, 56358], [93, 56618], [96, 56718], [106, 57338], [109, 57418], [116, 57778], [118, 58078], [126, 58668]]}, {"verse": 8, "start": 59484, "end": 70106, "text": "Y alabó el señor al mayordomo malo por haber actuado con astucia; porque los hijos de este siglo son en su generación más sagaces que los hijos de luz.", "words": [[0, 59484], [2, 59608], [8, 59878], [11, 60148], [17, 60588], [20, 61158], [30, 61728], [35, 62228], [39, 62373], [45, 62553], [53, 63053], [57, 63273], [66, 64210], [73, 64414], [77, 64634], [83, 64894], [86, 65114], [91, 65294], [97, 65774], [101, 66374], [104, 66634], [107, 66854], [118, 67494], [122, 68024], [130, 68554], [134, 69014], [138, 69174], [144, 69514], [147, 69674]]}, {"verse": 9, "start": 70456, "end": 79580, "text": "Y yo os digo: Haceos amigos por medio de las riquezas injustas, para que cuando estas falten, os reciban en las moradas eternas.", "words": [[0, 70456], [2, 70615], [5, 70755], [8, 70895], [14, 71584], [21, 72131], [28, 72451], [32, 72791], [38, 73151], [41, 73351], [45, 73511], [54, 73991], [64, 75171], [69, 75411], [73, 75591], [80, 75851], [86, 76211], [94, 76971], [97, 77246], [105, 77886], [108, 78046], [112, 78186], [120, 78686]]}, {"verse": 10, "start": 79930, "end": 89423, "text": "El que es fiel en lo muy poco, también en lo más es fiel: y el que en lo muy poco es injusto, también en lo más es injusto.", "words": [[0, 79930], [3, 80062], [7, 80242], [10, 80599], [15, 80959], [18, 81199], [21, 81319], [25, 81579], [31, 82299], [39, 82719], [42, 83059], [45, 83259], [49, 83429], [52, 83599], [58, 84572], [60, 84754], [63, 84934], [67, 85174], [70, 85534], [73, 85694], [77, 85914], [82, 86254], [85, 86474], [94, 87434], [102, 87814], [105, 88114], [108, 88254], [112, 88494], [115, 88594]]}, {"verse": 11, "start": 89423, "end": 94514, "text": "Pues si en las malas riquezas no fuisteis fieles, ¿quién os confiará lo verdadero?", "words": [[0, 89423], [5, 89583], [8, 89903], [11, 90043], [15, 90203], [21, 90603], [30, 91063], [33, 91283], [42, 91783], [50, 92603], [57, 92843], [60, 93003], [69, 93643], [72, 93763]]}, {"verse": 12, "start": 94864, "end": 99509, "text": "Y si en lo ajeno no fuisteis fieles, ¿quién os dará lo que es vuestro?", "words": [[0, 94864], [2, 94988], [5, 95148], [8, 95288], [11, 95448], [17, 95848], [20, 96028], [29, 96608], [37, 97468], [44, 97758], [47, 98048], [52, 98388], [55, 98528], [59, 98688], [62, 98848]]}, {"verse": 13, "start": 99859, "end": 114159, "text": "Ningún siervo puede servir a dos señores; porque o aborrecerá al uno y amará al otro, o se allegará al uno y menospreciará al otro. No podéis servir a Dios y a las riquezas.", "words": [[0, 99859], [7, 100269], [14, 100749], [20, 100979], [27, 101209], [29, 101439], [33, 101669], [42, 102842], [49, 103225], [51, 103725], [62, 104665], [65, 104905], [69, 105185], [71, 105485], [77, 105825], [80, 106105], [86, 106905], [88, 107178], [91, 107452], [100, 107725], [103, 108065], [107, 108425], [109, 109225], [123, 110025], [126, 110365], [132, 111161], [135, 111351], [142, 111831], [149, 112311], [151, 112551], [156, 112751], [158, 112991], [160, 113071], [164, 113171]]}, {"verse": 14, "start": 114509, "end": 120981, "text": "Y oían también todas estas cosas los fariseos, los cuales eran avaros, y se burlaban de él.", "words": [[0, 114509], [2, 114668], [7, 114968], [15, 115328], [21, 115628], [27, 115988], [33, 116928], [37, 117008], [47, 117988], [51, 118108], [58, 118308], [63, 118628], [71, 119148], [73, 119568], [76, 119708], [85, 120228], [88, 120528]]}, {"verse": 15, "start": 121331, "end": 134361, "text": "Y les dijo: Vosotros sois los que os justificáis a vosotros mismos delante de los hombres; pero Dios conoce vuestros corazones; porque lo que los hombres tienen por sublime, delante de Dios es abominación.", "words": [[0, 121331], [2, 121456], [6, 121576], [12, 122308], [21, 122774], [26, 123274], [30, 123654], [34, 123754], [37, 123854], [49, 124734], [51, 124854], [60, 125274], [67, 125574], [75, 126134], [78, 126274], [82, 126414], [91, 127273], [96, 127418], [101, 127618], [108, 128138], [117, 128518], [128, 129654], [135, 129818], [138, 129998], [142, 130118], [146, 130278], [154, 130578], [161, 130918], [165, 131388], [174, 131858], [182, 132458], [185, 132638], [190, 132878], [193, 133218]]}, {"verse": 16, "start": 134711, "end": 144636, "text": "La ley y los profetas hasta Juan: desde entonces el reino de Dios es anunciado, y todos se esfuerzan a entrar en él.", "words": [[0, 134711], [3, 134908], [7, 135415], [9, 135555], [13, 135655], [22, 136235], [28, 136715], [34, 137498], [40, 137666], [49, 138226], [52, 138586], [58, 139006], [61, 139146], [66, 139546], [69, 140066], [80, 140826], [82, 141566], [88, 141926], [91, 142586], [101, 143366], [103, 143626], [110, 144066], [113, 144406]]}, {"verse": 17, "start": 144986, "end": 151680, "text": "Pero más fácil cosa es pasar el cielo y la tierra, que caer un solo trazo de una letra de la ley.", "words": [[0, 144986], [5, 145130], [9, 145330], [15, 145770], [20, 146170], [23, 146450], [29, 146850], [32, 147090], [38, 147430], [40, 147630], [43, 147730], [51, 148690], [55, 148690], [60, 149110], [63, 149270], [68, 149550], [74, 150110], [77, 150270], [81, 150430], [87, 150930], [90, 151050], [93, 151190]]}, {"verse": 18, "start": 152030, "end": 162547, "text": "Cualquiera que se divorcia de su mujer, y se casa con otra, comete adulterio: y el que se casa con una mujer divorciada de su marido, comete adulterio.", "words": [[0, 152030], [11, 152493], [15, 152673], [18, 152833], [27, 153413], [30, 153553], [33, 153713], [40, 154113], [42, 154373], [45, 154513], [50, 154813], [54, 155133], [60, 155973], [67, 156273], [78, 157401], [80, 157676], [83, 157776], [87, 157916], [90, 158076], [95, 158396], [99, 158696], [103, 158876], [109, 159236], [120, 160036], [123, 160216], [126, 160336], [134, 160936], [141, 161436]]}, {"verse": 19, "start": 162897, "end": 170098, "text": "Había un hombre rico, que se vestía de púrpura y de lino fino, y hacía cada día banquete con esplendidez.", "words": [[0, 162897], [6, 163141], [9, 163381], [16, 163681], [22, 164321], [26, 164596], [29, 164756], [36, 165176], [39, 165316], [47, 165916], [49, 166016], [52, 166156], [57, 166456], [63, 166776], [65, 167376], [71, 167696], [76, 167996], [80, 168296], [89, 168856], [93, 169506]]}, {"verse": 20, "start": 170448, "end": 177182, "text": "Había también un mendigo llamado Lázaro, el cual estaba echado a la puerta de él, lleno de llagas,", "words": [[0, 170448], [6, 170766], [14, 171086], [17, 171326], [25, 171926], [33, 172206], [41, 173526], [44, 173606], [49, 173766], [56, 174106], [63, 174546], [65, 174626], [68, 174686], [75, 174986], [78, 175266], [82, 175966], [88, 176326], [91, 176446]]}, {"verse": 21, "start": 177532, "end": 185900, "text": "Y deseando hartarse de las migajas que caían de la mesa del rico; y aun los perros venían y le lamían las llagas.", "words": [[0, 177532], [2, 177658], [11, 178258], [20, 179138], [23, 179638], [27, 180028], [35, 180418], [39, 180558], [45, 181018], [48, 181158], [51, 181258], [56, 181498], [60, 181758], [66, 182584], [68, 182749], [72, 182909], [76, 183149], [83, 183629], [90, 184189], [92, 184449], [95, 184549], [102, 184969], [106, 185464]]}, {"verse": 22, "start": 186250, "end": 195154, "text": "Y aconteció que murió el mendigo, y fue llevado por los ángeles al seno de Abraham: y murió también el rico, y fue sepultado.", "words": [[0, 186250], [2, 186350], [12, 187010], [16, 187170], [22, 187590], [25, 187730], [34, 188330], [36, 188810], [40, 188990], [48, 189490], [52, 189670], [56, 189870], [64, 190430], [67, 190670], [72, 191130], [75, 191250], [84, 192090], [86, 192220], [92, 192540], [100, 192840], [103, 193140], [109, 193500], [111, 193960], [115, 194120]]}, {"verse": 23, "start": 195504, "end": 203511, "text": "Y en el infierno alzó sus ojos, estando en los tormentos, y vio a Abraham de lejos, y a Lázaro en su seno.", "words": [[0, 195504], [2, 195648], [5, 195768], [8, 195908], [17, 196548], [22, 197108], [26, 197288], [32, 198008], [40, 198548], [43, 198668], [47, 198788], [58, 199728], [60, 199928], [64, 200228], [66, 200488], [74, 201008], [77, 201268], [84, 201628], [86, 201981], [88, 202335], [95, 202688], [98, 202848], [101, 202968]]}, {"verse": 24, "start": 203861, "end": 215388, "text": "Entonces él, dando voces, dijo: Padre Abraham, ten misericordia de mí, y envía a Lázaro que moje la punta de su dedo en agua, y refresque mi lengua; porque soy atormentado en esta llama.", "words": [[0, 203861], [9, 204818], [13, 204958], [19, 205218], [26, 205758], [32, 206607], [38, 206877], [47, 207417], [51, 207517], [64, 208277], [67, 208437], [71, 208617], [73, 208977], [79, 209277], [81, 209577], [88, 209877], [92, 210037], [97, 210357], [100, 210477], [106, 210837], [109, 210957], [112, 211117], [117, 211417], [120, 211517], [126, 211777], [128, 211962], [138, 212582], [141, 212722], [149, 213428], [156, 213625], [160, 213865], [172, 214605], [175, 214745], [180, 214925]]}, {"verse": 25, "start": 215668, "end": 225317, "text": "Y le dijo Abraham: Hijo, acuérdate que recibiste tus bienes en tu vida, y Lázaro también males; pero ahora este es consolado aquí, y tú atormentado.", "words": [[0, 215668], [2, 215813], [5, 215913], [10, 216213], [19, 217281], [25, 217665], [35, 218025], [39, 218225], [49, 218785], [53, 218985], [60, 219385], [63, 219505], [66, 219625], [72, 219905], [74, 220232], [81, 220560], [89, 220900], [96, 221877], [101, 222021], [107, 222341], [112, 222681], [115, 222861], [125, 223441], [131, 223701], [133, 224161], [136, 224321]]}, {"verse": 26, "start": 225667, "end": 235489, "text": "Y además de todo esto, un gran abismo está establecido entre nosotros y vosotros, que los que quieran pasar de aquí a vosotros, no pueden, ni de allá pasar acá.", "words": [[0, 225667], [2, 225792], [9, 226092], [12, 226272], [17, 226472], [23, 227512], [26, 227672], [31, 227852], [38, 228292], [43, 228532], [55, 229212], [61, 229452], [70, 229912], [72, 230192], [82, 230692], [86, 231172], [90, 231312], [94, 231452], [102, 231752], [108, 231992], [111, 232212], [116, 232392], [118, 232492], [128, 233032], [131, 233532], [139, 233972], [142, 234432], [145, 234552], [150, 234692], [156, 234992]]}, {"verse": 27, "start": 235769, "end": 240194, "text": "Y dijo: Te ruego pues, padre, que le envíes a la casa de mi padre;", "words": [[0, 235769], [2, 235898], [8, 236620], [11, 236744], [17, 237124], [23, 237264], [30, 238204], [34, 238284], [37, 238424], [44, 238904], [46, 239024], [49, 239104], [54, 239364], [57, 239584], [60, 239684]]}, {"verse": 28, "start": 240544, "end": 246712, "text": "Porque tengo cinco hermanos; para que les testifique, porque no vengan ellos también a este lugar de tormento.", "words": [[0, 240544], [7, 240724], [13, 241004], [19, 241344], [29, 242310], [34, 242455], [38, 242575], [42, 242715], [54, 243735], [61, 243955], [64, 244155], [71, 244495], [77, 244655], [85, 245055], [87, 245275], [92, 245495], [98, 245775], [101, 245995]]}, {"verse": 29, "start": 246992, "end": 252049, "text": "Y Abraham le dice: A Moisés y a los profetas tienen: óiganlos.", "words": [[0, 246992], [2, 247135], [10, 247475], [13, 247855], [19, 248681], [21, 248802], [28, 249202], [30, 249662], [32, 249742], [36, 249882], [45, 250422], [53, 251256]]}, {"verse": 30, "start": 252329, "end": 258963, "text": "Él entonces dijo: No, padre Abraham: pero si alguno va a ellos de los muertos, se arrepentirán.", "words": [[0, 252329], [3, 252751], [12, 253203], [18, 254179], [22, 254535], [28, 254935], [37, 255500], [42, 255641], [45, 255841], [52, 256281], [55, 256421], [57, 256581], [63, 256741], [66, 256901], [70, 257041], [79, 257801], [82, 258021]]}, {"verse": 31, "start": 259243, "end": 266897, "text": "Pero Abraham le dijo: Si no oyen a Moisés y a los profetas, tampoco se persuadirán, si alguno resucita de los muertos.", "words": [[0, 259243], [5, 259407], [13, 259967], [16, 260607], [22, 261343], [25, 261497], [28, 261657], [33, 261957], [35, 261997], [42, 262417], [44, 262657], [46, 262677], [50, 262817], [60, 263697], [68, 263957], [71, 264257], [84, 264977], [87, 265297], [94, 265677], [103, 266177], [106, 266297], [110, 266397]]}]}