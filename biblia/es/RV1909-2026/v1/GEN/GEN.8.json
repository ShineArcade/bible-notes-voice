{"book": "GEN", "chapter": 8, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 210977, "verses": [{"verse": 1, "start": 300, "end": 13171, "text": "Y Dios se acordó de Noé, y de todos los animales, y de todas las bestias que estaban con él en el arca; e hizo pasar Dios un viento sobre la tierra, y disminuyeron las aguas.", "words": [[0, 300], [2, 442], [7, 682], [10, 1062], [17, 1602], [20, 1722], [25, 2362], [27, 2642], [30, 2762], [36, 3022], [40, 3302], [50, 3782], [52, 4402], [55, 4542], [61, 4762], [65, 5042], [73, 5482], [77, 5642], [85, 5982], [89, 6322], [92, 6502], [95, 6802], [98, 6942], [104, 7749], [106, 7873], [111, 8293], [117, 8673], [122, 9053], [125, 9433], [132, 9933], [138, 10253], [141, 10493], [149, 10933], [151, 11258], [164, 12218], [168, 12398]]}, {"verse": 2, "start": 13521, "end": 21130, "text": "Y se cerraron las fuentes del abismo, y las cataratas de los cielos; y la lluvia de los cielos fue detenida.", "words": [[0, 13521], [2, 13645], [5, 13745], [14, 14485], [18, 14645], [26, 15185], [30, 15385], [38, 15905], [40, 16525], [44, 16685], [54, 17425], [57, 17525], [61, 17645], [69, 18653], [71, 18957], [74, 19077], [81, 19497], [84, 19577], [88, 19717], [95, 20137], [99, 20317]]}, {"verse": 3, "start": 21480, "end": 30522, "text": "Y las aguas se retiraron de sobre la tierra, yendo y volviendo: y decrecieron las aguas al cabo de ciento cincuenta días.", "words": [[0, 21480], [2, 21586], [6, 21746], [12, 22366], [15, 22466], [25, 23206], [28, 23366], [34, 23626], [37, 23826], [45, 24786], [51, 25246], [53, 25506], [64, 26594], [66, 26703], [78, 27383], [82, 27563], [88, 28043], [91, 28183], [96, 28483], [99, 28803], [106, 29123], [116, 29443]]}, {"verse": 4, "start": 30872, "end": 37961, "text": "Y reposó el arca en el mes séptimo, a diecisiete días del mes, sobre los montes de Ararat.", "words": [[0, 30872], [2, 30993], [9, 31593], [12, 31713], [17, 32053], [20, 32173], [23, 32313], [27, 32473], [36, 33213], [38, 33893], [49, 34573], [54, 35093], [58, 35373], [63, 35653], [69, 36233], [73, 36453], [80, 36993], [83, 37153]]}, {"verse": 5, "start": 38311, "end": 47020, "text": "Y las aguas fueron decreciendo hasta el mes décimo: en el décimo, al primero del mes, se descubrieron las cimas de los montes.", "words": [[0, 38311], [2, 38439], [6, 38599], [12, 39099], [19, 39399], [31, 40359], [37, 40699], [40, 40879], [44, 41099], [52, 42185], [55, 42350], [58, 42510], [66, 43090], [69, 43230], [77, 43550], [81, 43850], [86, 44390], [89, 44530], [102, 45250], [106, 45430], [112, 45930], [115, 46110], [119, 46230]]}, {"verse": 6, "start": 47370, "end": 53385, "text": "Y sucedió que, al cabo de cuarenta días, abrió Noé la ventana del arca que había hecho,", "words": [[0, 47370], [2, 47479], [10, 48099], [15, 48324], [18, 48384], [23, 48624], [26, 48894], [35, 49164], [41, 50064], [47, 50464], [51, 51044], [54, 51284], [62, 51651], [66, 52017], [71, 52384], [75, 52544], [81, 52804]]}, {"verse": 7, "start": 53735, "end": 61379, "text": "Y envió al cuervo, el cual salió, y estuvo yendo y volviendo hasta que las aguas se secaron de sobre la tierra.", "words": [[0, 53735], [2, 53877], [8, 54317], [11, 54477], [19, 54997], [22, 55137], [27, 55277], [34, 55837], [36, 56477], [43, 56837], [49, 57297], [51, 57417], [61, 57897], [67, 58077], [71, 58257], [75, 58457], [81, 59017], [84, 59437], [92, 59937], [95, 60097], [101, 60357], [104, 60597]]}, {"verse": 8, "start": 61729, "end": 69004, "text": "Envió también de sí a la paloma, para ver si las aguas se habían retirado de sobre la faz de la tierra;", "words": [[0, 61729], [6, 62191], [14, 62631], [17, 62851], [20, 63131], [22, 63371], [25, 63471], [33, 64111], [38, 64911], [42, 65151], [45, 65331], [49, 65551], [55, 65991], [58, 66111], [65, 66351], [74, 67131], [77, 67291], [83, 67571], [86, 67791], [90, 68031], [93, 68211], [96, 68331]]}, {"verse": 9, "start": 69354, "end": 85783, "text": "Y no halló la paloma donde sentar la planta de su pie, y se volvió a él al arca, porque las aguas estaban aún sobre la faz de toda la tierra: entonces él extendió su mano, y tomándola, la hizo entrar consigo en el arca.", "words": [[0, 69354], [2, 69478], [5, 69678], [11, 69978], [14, 70118], [21, 70598], [27, 70858], [34, 71538], [37, 71678], [44, 72118], [47, 72238], [50, 72378], [55, 72983], [57, 73103], [60, 73243], [67, 73763], [69, 74003], [72, 74263], [75, 74563], [81, 75388], [88, 75573], [92, 75813], [98, 76233], [106, 76613], [110, 77113], [116, 77573], [119, 77773], [123, 78193], [126, 78593], [131, 78813], [134, 79053], [142, 79889], [151, 80410], [154, 80990], [163, 81770], [166, 81950], [172, 82250], [174, 82430], [185, 83410], [188, 83610], [193, 83870], [200, 84290], [208, 84890], [211, 85130], [214, 85250]]}, {"verse": 10, "start": 86133, "end": 91285, "text": "Y esperó aún otros siete días, y volvió a enviar la paloma fuera del arca.", "words": [[0, 86133], [2, 86222], [9, 86582], [13, 86782], [19, 87262], [25, 87702], [31, 88242], [33, 88667], [40, 89087], [42, 89147], [49, 89527], [52, 89687], [59, 90087], [65, 90387], [69, 90707]]}, {"verse": 11, "start": 91635, "end": 103567, "text": "Y la paloma volvió a él a la hora de la tarde; y he aquí que traía una hoja de olivo en su pico: y entendió Noé que las aguas se habían retirado de sobre la tierra.", "words": [[0, 91635], [2, 91758], [5, 91878], [12, 92298], [19, 92838], [21, 92958], [24, 93198], [26, 93458], [29, 93578], [34, 93818], [37, 93978], [40, 94118], [47, 94947], [49, 95380], [52, 95520], [57, 95920], [61, 96160], [67, 96580], [71, 96820], [76, 97200], [79, 97340], [85, 97680], [88, 97820], [91, 98230], [97, 98796], [99, 98921], [108, 99501], [112, 99901], [116, 100101], [120, 100361], [126, 100881], [129, 101081], [136, 101421], [145, 102221], [148, 102381], [154, 102721], [157, 102941]]}, {"verse": 12, "start": 103917, "end": 110047, "text": "Y esperó aún otros siete días, y envió la paloma, la cual no volvió ya más a él.", "words": [[0, 103917], [2, 104197], [9, 104797], [13, 105197], [19, 105597], [25, 105957], [31, 106397], [33, 106677], [39, 107097], [42, 107237], [50, 108117], [53, 108217], [58, 108457], [61, 108737], [68, 109137], [71, 109317], [75, 109577], [77, 109757]]}, {"verse": 13, "start": 110397, "end": 127187, "text": "Y sucedió que en el año seiscientos uno de Noé, en el mes primero, al primero del mes, las aguas se secaron de sobre la tierra; y quitó Noé la cubierta del arca, y miró, y he aquí que la superficie de la tierra estaba seca.", "words": [[0, 110397], [2, 110558], [10, 111178], [14, 111398], [17, 111758], [20, 111898], [24, 112391], [36, 112885], [40, 113378], [43, 113598], [48, 114458], [51, 114578], [54, 114718], [58, 114898], [67, 115838], [70, 115958], [78, 116358], [82, 116598], [87, 117418], [91, 117618], [97, 118458], [100, 118778], [108, 119358], [111, 119498], [117, 119758], [120, 119978], [128, 120924], [130, 121050], [136, 121290], [140, 121530], [143, 121770], [152, 122197], [156, 122623], [162, 123050], [164, 123310], [170, 124150], [172, 124190], [175, 124290], [180, 124550], [184, 124690], [187, 124830], [198, 125610], [201, 125690], [204, 125830], [211, 126070], [218, 126470]]}, {"verse": 14, "start": 127537, "end": 132755, "text": "Y en el mes segundo, a los veintisiete días del mes, se secó la tierra.", "words": [[0, 127537], [2, 127657], [5, 127797], [8, 127917], [12, 128097], [21, 129257], [23, 129517], [27, 129847], [39, 130177], [44, 130577], [48, 130757], [53, 131417], [56, 131577], [61, 131937], [64, 132057]]}, {"verse": 15, "start": 133105, "end": 135474, "text": "Y habló Dios a Noé diciendo:", "words": [[0, 133105], [2, 133249], [8, 133629], [13, 133869], [15, 134289], [19, 134669]]}, {"verse": 16, "start": 135674, "end": 141015, "text": "Sal del arca tú, y tu mujer, y tus hijos, y las mujeres de tus hijos contigo.", "words": [[0, 135674], [4, 135935], [8, 136135], [13, 136495], [17, 136775], [19, 137235], [22, 137375], [29, 137775], [31, 138175], [35, 138315], [42, 138675], [44, 139175], [48, 139335], [56, 139695], [59, 139915], [63, 140075], [69, 140335]]}, {"verse": 17, "start": 141606, "end": 156902, "text": "Todos los animales que están contigo de toda carne, de aves y de bestias y de todo reptil que anda arrastrando sobre la tierra, sacarás contigo; y vayan por la tierra, y fructifiquen, y multiplíquense sobre la tierra.", "words": [[0, 141606], [6, 141810], [10, 142070], [19, 142550], [23, 142910], [29, 143110], [37, 143710], [40, 143850], [45, 143990], [52, 145090], [55, 145150], [60, 145550], [62, 145730], [65, 145850], [73, 146430], [75, 146850], [78, 146990], [83, 147170], [90, 147830], [94, 148030], [99, 148290], [111, 148990], [117, 149230], [120, 149430], [128, 150230], [136, 150790], [145, 151924], [147, 152062], [153, 152402], [157, 152622], [160, 152762], [168, 153182], [170, 153622], [184, 154542], [186, 154902], [201, 155782], [207, 156142], [210, 156342]]}, {"verse": 18, "start": 157420, "end": 163793, "text": "Entonces salió Noé, y sus hijos, y su mujer, y las mujeres de sus hijos con él.", "words": [[0, 157420], [9, 157926], [15, 158726], [20, 159326], [22, 159506], [26, 159666], [33, 160606], [35, 160686], [38, 160786], [45, 161906], [47, 161986], [51, 162126], [59, 162446], [62, 162646], [66, 162826], [72, 163086], [76, 163326]]}, {"verse": 19, "start": 164143, "end": 173481, "text": "Todos los animales, y todo reptil y toda ave, todo lo que se mueve sobre la tierra según sus especies, salieron del arca.", "words": [[0, 164143], [6, 164446], [10, 164986], [20, 165466], [22, 165766], [27, 165926], [34, 166786], [36, 166966], [41, 167126], [46, 167926], [51, 168146], [54, 168366], [58, 168506], [61, 168646], [67, 169086], [73, 169346], [76, 169586], [83, 170426], [89, 170666], [93, 171006], [103, 172046], [112, 172540], [116, 173035]]}, {"verse": 20, "start": 173831, "end": 182703, "text": "Y edificó Noé un altar a Jehová, y tomó de todo animal limpio y de toda ave limpia, y ofreció holocausto en el altar.", "words": [[0, 173831], [2, 174000], [10, 174600], [14, 174960], [17, 175220], [23, 175620], [25, 175800], [33, 176240], [35, 176340], [40, 176660], [43, 176740], [48, 177000], [55, 177420], [62, 178100], [64, 178180], [67, 178300], [72, 178520], [76, 178920], [84, 179820], [86, 180240], [94, 180960], [105, 181720], [108, 181880], [111, 182020]]}, {"verse": 21, "start": 182703, "end": 199989, "text": "Y percibió Jehová olor de suavidad; y dijo Jehová en su corazón: No volveré más a maldecir la tierra por causa del hombre; porque el intento del corazón del hombre es malo desde su juventud: ni volveré más a destruir todo viviente, como he hecho.", "words": [[0, 182703], [2, 182923], [11, 183583], [18, 184043], [23, 184363], [26, 184812], [36, 185469], [38, 185574], [43, 185854], [50, 186354], [53, 186454], [56, 186614], [65, 187572], [68, 187754], [76, 188334], [80, 188494], [82, 188654], [91, 189234], [94, 189474], [101, 189894], [105, 190214], [111, 190514], [115, 190814], [123, 191731], [130, 191951], [133, 192091], [141, 192631], [145, 192751], [153, 193151], [157, 193411], [164, 193731], [167, 194291], [172, 194771], [178, 194931], [181, 195231], [191, 196436], [194, 196579], [202, 197079], [206, 197319], [208, 197559], [217, 198159], [222, 198339], [232, 198979], [237, 199359], [240, 199539]]}, {"verse": 22, "start": 200589, "end": 210327, "text": "Todavía serán todos los tiempos de la tierra; la sementera y la siega, y el frío y calor, verano e invierno, y día y noche, no cesarán.", "words": [[0, 200589], [8, 200951], [14, 201571], [20, 201811], [24, 202131], [32, 202711], [35, 202791], [38, 202891], [46, 203735], [49, 204137], [59, 204577], [61, 204777], [64, 205137], [71, 205497], [73, 205657], [76, 205757], [81, 206157], [83, 206257], [90, 206877], [97, 207537], [99, 207737], [109, 208477], [111, 208617], [115, 208837], [117, 208957], [124, 209277], [127, 209677]]}]}