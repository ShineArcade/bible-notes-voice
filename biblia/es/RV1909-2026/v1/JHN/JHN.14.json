{"book": "JHN", "chapter": 14, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 237543, "verses": [{"verse": 1, "start": 300, "end": 5485, "text": "No se turbe vuestro corazón: creéis en Dios, creed también en mí.", "words": [[0, 300], [3, 487], [6, 667], [12, 1147], [20, 1547], [29, 2589], [36, 3229], [39, 3429], [45, 3891], [51, 4353], [59, 4733], [62, 5113]]}, {"verse": 2, "start": 5835, "end": 14198, "text": "En la casa de mi Padre muchas moradas hay: de otra manera os lo hubiera dicho: voy, pues, a preparar lugar para vosotros.", "words": [[0, 5876], [3, 5996], [6, 6136], [11, 6396], [14, 6636], [17, 6776], [23, 7276], [30, 7576], [38, 8106], [43, 8810], [46, 8958], [51, 9138], [58, 9518], [61, 9718], [64, 9898], [72, 10258], [79, 11034], [84, 11219], [90, 11499], [92, 11999], [101, 12659], [107, 12939], [112, 13259]]}, {"verse": 3, "start": 14548, "end": 21751, "text": "Y si me voy, y os preparo lugar, vendré otra vez y los llevaré conmigo. Así ustedes estarán donde yo esté.", "words": [[0, 14548], [2, 14655], [5, 14775], [8, 14935], [13, 15195], [15, 15455], [18, 15555], [26, 16015], [33, 16335], [40, 17135], [45, 17395], [49, 17775], [51, 18045], [55, 18315], [63, 18775], [72, 19713], [76, 20013], [84, 20313], [92, 20913], [98, 21093], [101, 21333]]}, {"verse": 4, "start": 22101, "end": 25464, "text": "Y sabéis a dónde yo voy; y sabéis el camino.", "words": [[0, 22101], [2, 22381], [9, 22688], [11, 22994], [17, 23301], [20, 23501], [25, 24103], [27, 24225], [34, 24665], [37, 24825]]}, {"verse": 5, "start": 25815, "end": 31528, "text": "Le dice Tomás: Señor, no sabemos a dónde vas: ¿cómo, pues, podemos saber el camino?", "words": [[0, 25815], [3, 25967], [8, 26227], [15, 27125], [22, 27767], [25, 27867], [33, 28227], [35, 28507], [41, 28667], [46, 29466], [53, 29662], [59, 30242], [67, 30482], [73, 30802], [76, 30962]]}, {"verse": 6, "start": 31808, "end": 38806, "text": "Jesús le dice: Yo soy el camino, y la verdad, y la vida: nadie viene al Padre, sino por mí.", "words": [[0, 31808], [6, 32141], [9, 32501], [15, 33214], [18, 33423], [22, 33663], [25, 33903], [33, 34423], [35, 34678], [38, 34818], [46, 35178], [48, 35618], [51, 35758], [57, 36486], [63, 36911], [69, 37171], [72, 37391], [79, 37751], [84, 38111], [88, 38411]]}, {"verse": 7, "start": 39156, "end": 46409, "text": "Si me conocieseis, también a mi Padre conocierais: y desde ahora le conocéis, y le habéis visto.", "words": [[0, 39156], [3, 39536], [6, 39966], [19, 40396], [27, 40876], [29, 41176], [32, 41316], [38, 42115], [51, 43108], [53, 43254], [59, 43434], [65, 43814], [68, 44014], [78, 44734], [80, 45294], [83, 45434], [90, 45734]]}, {"verse": 8, "start": 46759, "end": 50582, "text": "Le dice Felipe: Señor, muéstranos el Padre, y nos basta.", "words": [[0, 46759], [3, 46904], [8, 47204], [16, 48299], [23, 48541], [34, 49081], [37, 49241], [44, 49801], [46, 49941], [50, 50041]]}, {"verse": 9, "start": 50862, "end": 62030, "text": "Jesús le dice: ¿Tanto tiempo ha que estoy con vosotros, y no me has conocido, Felipe? El que me ha visto, ha visto al Padre; ¿cómo, pues, dices tú: Muéstranos el Padre?", "words": [[0, 50862], [6, 51196], [9, 51556], [15, 52268], [22, 52530], [29, 52840], [32, 53150], [36, 53250], [42, 53470], [46, 53770], [56, 54310], [58, 54550], [61, 54710], [64, 54870], [68, 55010], [78, 55690], [86, 56519], [89, 56609], [93, 56729], [96, 56869], [99, 56969], [106, 57609], [109, 57789], [115, 58049], [118, 58229], [125, 59053], [132, 59215], [138, 59895], [144, 60235], [148, 60816], [159, 61385], [162, 61485]]}, {"verse": 10, "start": 62380, "end": 72947, "text": "¿No crees que yo soy en el Padre, y el Padre en mí? Las palabras que yo os hablo, no las hablo de mí mismo: pero el Padre que está en mí, él hace las obras.", "words": [[0, 62380], [4, 62488], [10, 62828], [14, 63028], [17, 63228], [21, 63528], [24, 63728], [27, 63848], [34, 64288], [36, 64523], [39, 64663], [45, 65003], [48, 65383], [52, 65988], [56, 66117], [65, 66457], [69, 66777], [72, 67057], [75, 67237], [82, 67897], [85, 67997], [89, 68197], [95, 68597], [98, 68717], [101, 68877], [108, 69745], [113, 69887], [116, 70027], [122, 70447], [126, 70687], [131, 70907], [134, 71107], [138, 71747], [141, 71887], [146, 72287], [150, 72507]]}, {"verse": 11, "start": 73297, "end": 80169, "text": "Creedme que yo soy en el Padre, y el Padre en mí: de otra manera, creedme por las mismas obras.", "words": [[0, 73547], [8, 73797], [12, 73937], [15, 74097], [19, 74337], [22, 74517], [25, 74637], [32, 75077], [34, 75557], [37, 75697], [43, 76017], [46, 76297], [50, 76888], [53, 76978], [58, 77158], [66, 78078], [74, 78578], [78, 78858], [82, 79038], [89, 79438]]}, {"verse": 12, "start": 80519, "end": 90293, "text": "De cierto, de cierto os digo: El que en mí cree, las obras que yo hago también él las hará; y mayores que estas hará; porque yo voy al Padre.", "words": [[0, 80747], [3, 81007], [11, 81267], [14, 81527], [21, 81787], [24, 81987], [30, 82687], [33, 82869], [37, 83069], [40, 83309], [43, 83409], [49, 83789], [53, 84184], [59, 84724], [63, 84984], [66, 85204], [71, 85384], [79, 85804], [82, 86164], [86, 86484], [92, 87148], [94, 87393], [102, 87833], [106, 88033], [112, 88293], [118, 88902], [125, 89107], [128, 89347], [132, 89507], [135, 89687]]}, {"verse": 13, "start": 90643, "end": 97901, "text": "Y todo lo que pidáis al Padre en mi nombre, lo haré, para que el Padre sea glorificado en el Hijo.", "words": [[0, 90643], [2, 90761], [7, 91061], [10, 91361], [14, 91521], [21, 91981], [24, 92201], [30, 92761], [33, 92981], [36, 93181], [44, 93961], [47, 94181], [53, 94681], [58, 95241], [62, 95441], [65, 95601], [71, 96021], [75, 96221], [87, 97161], [90, 97281], [93, 97421]]}, {"verse": 14, "start": 98251, "end": 101262, "text": "Si algo pidáis en mi nombre, yo lo haré.", "words": [[0, 98251], [3, 98451], [8, 98781], [15, 99111], [18, 99351], [21, 99551], [29, 100371], [32, 100611], [35, 100831]]}, {"verse": 15, "start": 101612, "end": 104897, "text": "Si me amáis, guardad mis mandamientos;", "words": [[0, 101697], [3, 101817], [6, 101937], [13, 102957], [21, 103557], [25, 103717]]}, {"verse": 16, "start": 105247, "end": 111231, "text": "Y yo rogaré al Padre, y os dará otro Consolador, para que esté con vosotros para siempre:", "words": [[0, 105247], [2, 105247], [5, 105554], [12, 106194], [15, 106314], [22, 106874], [24, 107294], [27, 107474], [32, 107794], [37, 108134], [49, 108954], [54, 109214], [58, 109394], [63, 109554], [67, 109834], [76, 110294], [81, 110514]]}, {"verse": 17, "start": 111581, "end": 122157, "text": "Al Espíritu de verdad, al cual el mundo no puede recibir, porque no le ve, ni le conoce: pero vosotros le conocéis; porque está con vosotros, y será en vosotros.", "words": [[0, 111581], [3, 111745], [12, 112365], [15, 112465], [23, 112845], [26, 113210], [31, 113450], [34, 113770], [40, 114070], [43, 114370], [49, 114650], [58, 115270], [65, 115850], [68, 116110], [71, 116250], [75, 116470], [78, 116950], [81, 117130], [89, 118066], [94, 118350], [103, 118790], [106, 118990], [116, 120013], [123, 120177], [128, 120377], [132, 120597], [142, 121057], [144, 121217], [149, 121437], [152, 121597]]}, {"verse": 18, "start": 122507, "end": 125113, "text": "No os dejaré huérfanos: vendré a vosotros.", "words": [[0, 122507], [3, 122768], [6, 122888], [13, 123308], [24, 124148], [31, 124593], [33, 124693]]}, {"verse": 19, "start": 125113, "end": 133569, "text": "Aun un poquito, y el mundo no me verá más; pero vosotros me veréis; porque yo vivo, y vosotros también viviréis.", "words": [[0, 125513], [4, 125773], [7, 126153], [16, 126573], [18, 126993], [21, 127133], [27, 127433], [30, 127713], [33, 127873], [38, 128173], [43, 128866], [48, 129007], [57, 129467], [60, 129667], [68, 130439], [75, 130663], [78, 130903], [84, 131203], [86, 131448], [95, 131948], [103, 132388]]}, {"verse": 20, "start": 133919, "end": 140401, "text": "En aquel día vosotros conoceréis que yo estoy en mi Padre, y vosotros en mí, y yo en vosotros.", "words": [[0, 133919], [3, 134068], [9, 134388], [13, 134608], [22, 135168], [33, 135928], [37, 136088], [40, 136268], [46, 136508], [49, 136768], [52, 136928], [59, 137348], [61, 137928], [70, 138408], [73, 138648], [77, 138888], [79, 139268], [82, 139468], [85, 139588]]}, {"verse": 21, "start": 140751, "end": 151860, "text": "El que tiene mis mandamientos, y los guarda, aquel es el que me ama; y el que me ama, será amado de mi Padre, y yo le amaré, y me manifestaré a él.", "words": [[0, 140751], [3, 140879], [7, 141019], [13, 141339], [17, 141559], [31, 142439], [33, 142899], [37, 143039], [45, 143779], [51, 144099], [54, 144319], [57, 144699], [61, 144839], [64, 144999], [69, 145688], [71, 145831], [74, 145931], [78, 146071], [81, 146271], [86, 146511], [91, 147111], [97, 147811], [100, 147971], [103, 148111], [110, 148971], [112, 149071], [115, 149271], [118, 149451], [125, 150311], [127, 150351], [130, 150491], [142, 151291], [144, 151431]]}, {"verse": 22, "start": 152210, "end": 158850, "text": "Le dice Judas, no el Iscariote: Señor, ¿por qué te has de manifestar a nosotros, y no al mundo?", "words": [[0, 152210], [3, 152335], [8, 152595], [15, 153375], [18, 153775], [21, 154215], [32, 155347], [39, 155962], [44, 156062], [48, 156182], [51, 156362], [55, 156482], [58, 156582], [69, 157182], [71, 157262], [81, 157602], [83, 158102], [86, 158242], [89, 158362]]}, {"verse": 23, "start": 159130, "end": 168784, "text": "Respondió Jesús, y le dijo: El que me ama, mi palabra guardará; y mi Padre le amará, y vendremos a él, y haremos con él morada.", "words": [[0, 159130], [10, 159685], [17, 160005], [19, 160265], [22, 160385], [28, 161106], [31, 161250], [35, 161390], [38, 161590], [43, 162210], [46, 162330], [54, 162710], [64, 163836], [66, 163960], [69, 164080], [75, 164560], [78, 164700], [85, 165140], [87, 165580], [97, 166100], [99, 166340], [103, 166620], [105, 167140], [113, 167540], [117, 167860], [120, 168020]]}, {"verse": 24, "start": 169134, "end": 177294, "text": "El que no me ama, no guarda mis palabras: y la palabra que habéis oído, no es mía, sino del Padre que me envió.", "words": [[0, 169134], [3, 169265], [7, 169405], [10, 169585], [13, 169765], [18, 170505], [21, 170745], [28, 171205], [32, 171345], [42, 172470], [44, 172573], [47, 172693], [55, 173033], [59, 173313], [66, 173633], [72, 174013], [75, 174253], [78, 174413], [83, 175093], [88, 175453], [92, 175733], [98, 176393], [102, 176533], [105, 176713]]}, {"verse": 25, "start": 177644, "end": 180944, "text": "Estas cosas os he hablado estando con vosotros.", "words": [[0, 177644], [6, 178024], [12, 178384], [15, 178764], [18, 179044], [26, 179624], [34, 180064], [38, 180304]]}, {"verse": 26, "start": 181294, "end": 193394, "text": "Pero el Consolador, el Espíritu Santo, al cual el Padre enviará en mi nombre, él os enseñará todas las cosas, y os recordará todas las cosas que os he dicho.", "words": [[0, 181294], [5, 181478], [8, 181618], [20, 182618], [23, 182738], [32, 183358], [39, 184318], [42, 184458], [47, 184638], [50, 184818], [56, 185458], [64, 186138], [67, 186318], [70, 186478], [78, 187518], [81, 187778], [84, 188098], [93, 188878], [99, 189158], [103, 189458], [110, 189878], [112, 190518], [115, 190638], [125, 191378], [131, 191698], [135, 191978], [141, 192338], [145, 192578], [148, 192758], [151, 192878]]}, {"verse": 27, "start": 193744, "end": 202563, "text": "La paz os dejo, mi paz os doy: no como el mundo la da, yo os la doy. No se turbe vuestro corazón, ni tenga miedo.", "words": [[0, 193744], [3, 193868], [7, 194088], [10, 194248], [16, 195128], [19, 195388], [23, 195688], [26, 195828], [31, 196521], [34, 196707], [39, 196947], [42, 197127], [48, 197407], [51, 197627], [55, 198247], [58, 198547], [61, 198707], [64, 198867], [69, 199517], [72, 199664], [75, 199804], [81, 200264], [89, 200644], [98, 201144], [101, 201624], [107, 201944]]}, {"verse": 28, "start": 202913, "end": 215025, "text": "Habéis oído cómo yo os he dicho: Voy, y vengo a vosotros. Si me amaseis, ciertamente os gozaríais, porque he dicho que voy al Padre: porque el Padre mayor es que yo.", "words": [[0, 202913], [7, 203238], [12, 203578], [17, 203878], [20, 204091], [23, 204305], [26, 204518], [33, 205610], [38, 205995], [40, 206220], [46, 206500], [48, 206600], [58, 207555], [61, 207740], [64, 207960], [73, 208660], [85, 209300], [88, 209520], [99, 210660], [106, 210920], [109, 211180], [115, 211500], [119, 211700], [123, 211880], [126, 212060], [133, 212985], [140, 213325], [143, 213485], [149, 213905], [155, 214197], [158, 214490], [162, 214782]]}, {"verse": 29, "start": 215375, "end": 221151, "text": "Y ahora os lo he dicho antes que se haga; para que cuando se haga, creáis.", "words": [[0, 215375], [2, 215605], [8, 215865], [11, 216165], [14, 216325], [17, 216425], [23, 216705], [29, 217105], [33, 217305], [36, 217485], [42, 218218], [47, 218383], [51, 218523], [58, 218783], [61, 219123], [67, 219883]]}, {"verse": 30, "start": 221501, "end": 228261, "text": "Ya no hablaré mucho con vosotros: porque viene el príncipe de este mundo; pero no tiene nada en mí.", "words": [[0, 221501], [3, 221644], [6, 221824], [14, 222204], [20, 222504], [24, 222784], [34, 223837], [41, 224021], [47, 224341], [50, 224621], [59, 225341], [62, 225541], [67, 225741], [74, 226647], [79, 226791], [82, 226991], [88, 227231], [93, 227551], [96, 227811]]}, {"verse": 31, "start": 228611, "end": 237143, "text": "Pero para que conozca el mundo que amo al Padre, y como el Padre me dio el mandamiento, así hago. Levantaos, vamos de aquí.", "words": [[0, 228611], [5, 228795], [10, 229315], [14, 229495], [22, 230035], [25, 230155], [31, 230435], [35, 230715], [39, 231015], [42, 231195], [49, 231795], [51, 231975], [56, 232215], [59, 232375], [65, 232915], [68, 233055], [72, 233275], [75, 233435], [88, 234115], [92, 234475], [98, 235304], [109, 236252], [115, 236512], [118, 236672]]}]}