{"book": "ISA", "chapter": 35, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 109587, "verses": [{"verse": 1, "start": 300, "end": 7362, "text": "SE ALEGRARÁN el desierto y la soledad: el yermo se gozará, y florecerá como la rosa.", "words": [[0, 300], [3, 485], [13, 1185], [16, 1405], [25, 2065], [27, 2345], [30, 2485], [39, 3491], [42, 3788], [48, 4118], [51, 4258], [59, 4818], [61, 5318], [71, 6218], [76, 6458], [79, 6658]]}, {"verse": 2, "start": 7812, "end": 22864, "text": "Florecerá profusamente, y también se alegrará y cantará con júbilo: la gloria del Líbano le será dada, la hermosura de Carmelo y de Sarón. Ellos verán la gloria de Jehová, la hermosura del Dios nuestro.", "words": [[0, 7812], [10, 8435], [24, 9235], [26, 9495], [34, 9715], [37, 10035], [46, 10555], [48, 10715], [56, 11215], [60, 11702], [68, 12446], [71, 12571], [78, 12971], [82, 13151], [89, 13651], [92, 13871], [97, 14071], [103, 14591], [106, 15171], [116, 15851], [119, 16251], [127, 16651], [129, 16731], [132, 16851], [139, 17803], [145, 18146], [151, 18586], [154, 19106], [161, 19586], [164, 19706], [172, 20826], [175, 20946], [185, 21526], [189, 21706], [194, 21986]]}, {"verse": 3, "start": 23314, "end": 28516, "text": "Confortad a las manos cansadas, fortaleced las vacilantes rodillas.", "words": [[0, 23314], [10, 24054], [12, 24214], [16, 24294], [22, 24554], [32, 25594], [43, 26554], [47, 27014], [58, 27654]]}, {"verse": 4, "start": 28966, "end": 40115, "text": "Decid a los de corazón apocado: Confortaos, no temáis: he aquí que vuestro Dios viene con venganza, con pago; el mismo Dios vendrá, y os salvará.", "words": [[0, 28966], [6, 29531], [8, 29711], [12, 29851], [15, 30031], [23, 30511], [32, 31754], [44, 32939], [47, 33019], [55, 34036], [58, 34116], [63, 34376], [67, 34576], [75, 34956], [80, 35176], [86, 35596], [90, 35816], [100, 36596], [104, 36696], [110, 37612], [113, 37738], [119, 38038], [124, 38278], [132, 38818], [134, 39158], [137, 39278]]}, {"verse": 5, "start": 40565, "end": 46689, "text": "Entonces los ojos de los ciegos serán abiertos, y los oídos de los sordos se abrirán.", "words": [[0, 40565], [9, 41149], [13, 41989], [18, 42309], [21, 42509], [25, 42629], [32, 43069], [38, 43429], [48, 44229], [50, 44469], [54, 44629], [60, 45089], [63, 45169], [67, 45309], [74, 45789], [77, 46241]]}, {"verse": 6, "start": 47139, "end": 58480, "text": "Entonces el cojo saltará como un ciervo, y cantará la lengua del mudo; porque aguas serán cavadas en el desierto, y torrentes en la soledad.", "words": [[0, 47139], [9, 47728], [12, 48028], [17, 48528], [25, 49128], [30, 49328], [33, 49708], [41, 50088], [43, 50588], [51, 51268], [54, 51708], [61, 52148], [65, 52268], [71, 53079], [78, 53344], [84, 54064], [90, 54574], [98, 55084], [101, 55284], [104, 55444], [114, 56124], [116, 56604], [126, 57384], [129, 57544], [132, 57684]]}, {"verse": 7, "start": 58930, "end": 71097, "text": "El lugar seco será tornado en estanque, y el sequedal en manaderos de aguas; en la habitación de chacales, en su cama, será lugar de cañas y de juncos.", "words": [[0, 58930], [3, 59072], [9, 59452], [14, 60072], [19, 60312], [27, 60932], [30, 61072], [40, 61792], [42, 62332], [45, 62712], [54, 63092], [57, 63392], [67, 64072], [70, 64172], [77, 65162], [80, 65346], [83, 65506], [94, 66226], [97, 66406], [107, 67426], [110, 67526], [113, 67686], [119, 68506], [124, 68726], [130, 69026], [133, 69266], [139, 69806], [141, 70166], [144, 70266]]}, {"verse": 8, "start": 71547, "end": 85923, "text": "Y habrá allí calzada y camino, y será llamado Camino de Santidad; no pasará por él inmundo; y habrá para ellos en él quien los acompañe, de tal manera que los insensatos no yerren.", "words": [[0, 71547], [2, 71672], [8, 72012], [13, 72232], [21, 72952], [23, 73072], [31, 73592], [33, 74092], [38, 74352], [46, 74752], [53, 75212], [56, 75512], [66, 76748], [69, 77428], [76, 77888], [80, 78128], [83, 78308], [92, 79468], [94, 79588], [