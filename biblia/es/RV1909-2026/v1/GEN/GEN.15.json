{"book": "GEN", "chapter": 15, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 171154, "verses": [{"verse": 1, "start": 300, "end": 11048, "text": "Después de estas cosas fue la palabra de Jehová a Abram en visión, diciendo: No temas, Abram; yo soy tu escudo, y tu galardón sobremanera grande.", "words": [[0, 300], [8, 519], [11, 679], [17, 839], [23, 1179], [27, 1459], [30, 1579], [38, 1879], [41, 2099], [48, 2599], [50, 2839], [56, 3079], [59, 3419], [67, 4299], [77, 5283], [80, 5482], [87, 5997], [94, 7060], [97, 7238], [101, 7518], [104, 7758], [112, 8318], [114, 8758], [117, 8898], [126, 9478], [138, 10198]]}, {"verse": 2, "start": 11398, "end": 21357, "text": "Y respondió Abram: Señor Jehová ¿qué me has de dar, siendo así que sigo sin hijos, y el mayordomo de mi casa es ese damasceno Eliezer?", "words": [[0, 11398], [2, 11523], [12, 12237], [19, 13167], [25, 13423], [32, 14483], [37, 14703], [40, 14863], [44, 15023], [47, 15183], [52, 15763], [59, 16043], [63, 16463], [67, 16663], [72, 17063], [76, 17243], [83, 18003], [85, 18143], [88, 18503], [98, 18863], [101, 18963], [104, 19063], [109, 19383], [112, 19663], [116, 20246], [126, 20830]]}, {"verse": 3, "start": 21707, "end": 28395, "text": "Dijo más Abram: Mira que no me has dado descendencia, y he aquí que mi heredero será un esclavo nacido en mi casa.", "words": [[0, 21707], [5, 22010], [9, 22598], [16, 23402], [21, 23605], [25, 23765], [28, 23885], [31, 24005], [35, 24105], [40, 24305], [54, 25345], [56, 25425], [59, 25545], [64, 25765], [68, 25925], [71, 26065], [80, 26485], [85, 26705], [88, 27015], [96, 27325], [103, 27705], [106, 27805], [109, 27925]]}, {"verse": 4, "start": 28745, "end": 38560, "text": "Y luego la palabra de Jehová fue a él diciendo: No te heredará este, sino el que saldrá de tus entrañas será el que te herede.", "words": [[0, 28745], [2, 28868], [8, 29088], [11, 29368], [19, 29748], [22, 29948], [29, 30508], [33, 30608], [35, 30808], [38, 30988],