{"book": "MAT", "chapter": 19, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 256464, "verses": [{"verse": 1, "start": 300, "end": 8854, "text": "Y aconteció que acabando Jesús estas palabras, se pasó de Galilea, y vino a los términos de Judea, pasado el Jordán.", "words": [[0, 300], [2, 410], [12, 1150], [16, 1430], [25, 1910], [31, 2270], [37, 2710], [47, 3690], [50, 3790], [55, 4090], [58, 4230], [67, 4930], [69, 5310], [74, 5630], [76, 5770], [80, 5890], [89, 6490], [92, 6570], [99, 7470], [106, 7800], [109, 8130]]}, {"verse": 2, "start": 9204, "end": 12449, "text": "Y le siguieron grandes multitudes, y los sanó allí.", "words": [[0, 9204], [2, 9328], [5, 9448], [15, 9948], [23, 10268], [35, 11048], [37, 11423], [41, 11603], [46, 11963]]}, {"verse": 3, "start": 12799, "end": 21709, "text": "Entonces se llegaron a él los fariseos, tentándole, y diciéndole: ¿Es lícito al hombre divorciarse de su mujer por cualquiera causa?", "words": [[0, 12799], [9, 13276], [12, 13556], [21, 14056], [23, 14196], [26, 14436], [30, 14556], [40, 15616], [52, 16496], [54, 16956], [66, 18071], [70, 18216], [77, 18676], [80, 18876], [87, 19076], [99, 19796], [102, 19976], [105, 20136], [111, 20436], [115, 20636], [126, 21116]]}, {"verse": 4, "start": 21989, "end": 29102, "text": "Y él respondiendo, les dijo: ¿No habéis leído que el que los hizo al principio, hombre y mujer los hizo,", "words": [[0, 21989], [2, 22172], [5, 22372], [19, 23332], [23, 23532], [29, 24348], [33, 24516], [40, 24836], [46, 25316], [50, 25576], [53, 25676], [57, 25856], [61, 26076], [66, 26336], [69, 26536], [80, 27516], [87, 27776], [89, 27956], [95, 28376], [99, 28556]]}, {"verse": 5, "start": 29452, "end": 37210, "text": "Y dijo: Por tanto, el hombre dejará padre y madre, y se unirá a su mujer, y serán dos en una carne?", "words": [[0, 29452], [2, 29772], [8, 30488], [12, 30590], [19, 31050], [22, 31190], [29, 31450], [36, 32050], [42, 32530], [44, 32850], [51, 33230], [53, 33570], [56, 33710], [62, 34210], [64, 34390], [67, 34510], [74, 34890], [76, 35390], [82, 35810], [86, 36010], [89, 36350], [93, 36530]]}, {"verse": 6, "start": 37560, "end": 44320, "text": "Así que, no son ya más dos, sino una carne: por tanto, lo que Dios juntó, no lo aparte el hombre.", "words": [[0, 37560], [4, 37775], [9, 37995], [12, 38315], [16, 38645], [19, 38975], [23, 39305], [28, 39635], [33, 39915], [37, 40415], [44, 41272], [48, 41399], [55, 41719], [58, 41979], [62, 42149], [67, 42319], [74, 42659], [77, 43199], [80, 43319], [87, 43739], [90, 43859]]}, {"verse": 7, "start": 44670, "end": 50007, "text": "Le dicen: ¿Por qué, pues, Moisés mandó dar carta de divorcio, y divorciarse de ella?", "words": [[0, 44936], [3, 45231], [10, 45726], [15, 45850], [20, 46030], [26, 46530], [33, 46870], [39, 47390], [43, 47530], [49, 47810], [52, 48030], [62, 48590], [64, 48790], [76, 49370], [79, 49590]]}, {"verse": 8, "start": 50287, "end": 59278, "text": "Les dice: Por la dureza de vuestro corazón Moisés os permitió divorciaros de vuestras mujeres: pero al principio no fue así.", "words": [[0, 50353], [4, 50433], [10, 51418], [14, 51542], [17, 51722], [24, 52202], [27, 52362], [35, 52702], [43, 53129], [50, 53555], [53, 53982], [62, 54602], [74, 55322], [77, 55482], [86, 55822], [95, 56856], [100, 57239], [103, 57719], [113, 58299], [116, 58639], [120, 58839]]}, {"verse": 9, "start": 59628, "end": 71827, "text": "Y yo os digo que cualquiera que se divorcie de su mujer, si no es por causa de fornicación, y se case con otra, adultera: y el que se casa con la divorciada, adultera.", "words": [[0, 59628], [2, 59752], [5, 59992], [8, 60092], [13, 60372], [17, 60612], [28, 61232], [32, 61392], [35, 61532], [44, 62112], [47, 62252], [50, 62432], [57, 62932], [60, 63612], [63, 63752], [66, 63892], [70, 64052], [76, 64372], [79, 64612], [92, 65452], [94, 65992], [97, 66112], [102, 66332], [106, 66652], [112, 67012], [122, 68341], [124, 68643], [127, 68803], [131, 68963], [134, 69103], [139, 69463], [143, 69783], [146, 69943], [158, 70883]]}, {"verse": 10, "start": 72177, "end": 78672, "text": "Le dicen sus discípulos: Si así es la condición del hombre con su mujer, no conviene casarse.", "words": [[0, 72177], [3, 72285], [9, 72625], [13, 72945], [25, 74308], [28, 74480], [32, 74780], [35, 75060], [38, 75180], [48, 75740], [52, 75940], [59, 76220], [63, 76420], [66, 76560], [73, 77200], [76, 77520], [85, 77940]]}, {"verse": 11, "start": 78952, "end": 86013, "text": "Entonces él les dijo: No todos reciben esta palabra, sino aquellos a quienes es dado.", "words": [[0, 78952], [9, 79453], [12, 80053], [16, 80333], [22, 81136], [25, 81345], [31, 81845], [39, 82625], [44, 82865], [53, 83665], [58, 83885], [67, 84405], [69, 84845], [77, 85065], [80, 85385]]}, {"verse": 12, "start": 86363, "end": 104314, "text": "Porque hay eunucos que nacieron así del vientre de su madre; y hay eunucos, que son hechos eunucos por los hombres; y hay eunucos que se hicieron a sí mismos eunucos por causa del reino de los cielos; el que pueda ser capaz de eso, séalo.", "words": [[0, 86363], [7, 86545], [11, 86785], [19, 87665], [23, 87785], [32, 88305], [36, 88585], [40, 88785], [48, 89345], [51, 89445], [54, 89625], [61, 90445], [63, 90592], [67, 90752], [76, 92032], [80, 92212], [84, 92452], [91, 92912], [99, 93672], [103, 93832], [107, 94012], [116, 94944], [118, 95088], [122, 95248], [130, 96188], [134, 96528], [137, 96688], [146, 97228], [148, 97368], [151, 97508], [158, 97868], [166, 98628], [170, 98968], [176, 99288], [180, 99628], [186, 100088], [189, 100228], [193, 100388], [201, 101395], [204, 101485], [208, 101625], [214, 101905], [218, 102245], [224, 102585], [227, 102865], [232, 103485]]}, {"verse": 13, "start": 104664, "end": 113645, "text": "Entonces le fueron presentados unos niños, para que pusiese las manos sobre ellos, y orase; y los discípulos los reprendieron.", "words": [[0, 104664], [9, 105304], [12, 105664], [19, 105964], [31, 106804], [36, 107044], [43, 107564], [48, 108029], [52, 108189], [60, 108689], [64, 108909], [70, 109229], [76, 109629], [83, 109949], [85, 110189], [92, 111089], [94, 111329], [98, 111469], [109, 112249], [113, 112569]]}, {"verse": 14, "start": 113995, "end": 122254, "text": "Y Jesús dijo: Dejad a los niños, y no les impidáis de venir a mí; porque de los tales es el reino de los cielos.", "words": [[0, 113995], [2, 114157], [8, 114517], [14, 115790], [20, 116070], [22, 116130], [26, 116250], [33, 116710], [35, 117105], [38, 117245], [42, 117445], [51, 118045], [54, 118225], [60, 118465], [62, 118625], [66, 119133], [73, 119358], [76, 119498], [80, 119658], [86, 119958], [89, 120618], [92, 120818], [98, 121278], [101, 121398], [105, 121538]]}, {"verse": 15, "start": 122604, "end": 126611, "text": "Y habiendo puesto sobre ellos las manos, se fue de allí.", "words": [[0, 122604], [2, 122906], [11, 123246], [18, 123666], [24, 124086], [30, 124426], [34, 124806], [41, 125626], [44, 125826], [48, 126026], [51, 126206]]}, {"verse": 16, "start": 126961, "end": 133155, "text": "Y he aquí, uno llegándose le dijo: Maestro bueno, ¿qué bien haré para tener la vida eterna?", "words": [[0, 126961], [2, 127142], [5, 127242], [11, 127562], [15, 127862], [26, 128942], [29, 129042], [35, 129746], [43, 130283], [50, 130963], [55, 131063], [60, 131323], [65, 131623], [70, 131783], [76, 132083], [79, 132323], [84, 132543]]}, {"verse": 17, "start": 133435, "end": 143026, "text": "Y él le dijo: ¿Por qué me llamas bueno? Ninguno es bueno sino uno, es decir, Dios: y si quieres entrar en la vida, guarda los mandamientos.", "words": [[0, 133435], [2, 133617], [5, 133737], [8, 133877], [14, 134587], [19, 134692], [23, 134832], [26, 134932], [33, 135292], [40, 136007], [48, 136475], [51, 136535], [57, 136775], [62, 137075], [67, 137835], [70, 137835], [77, 138535], [83, 139401], [85, 139507], [88, 139627], [96, 139947], [103, 140327], [106, 140527], [109, 140647], [115, 141207], [122, 141807], [126, 141947]]}, {"verse": 18, "start": 143376, "end": 153410, "text": "Le dice: ¿Cuáles? Y Jesús dijo: No matarás: No adulterarás: No hurtarás: No dirás falso testimonio:", "words": [[0, 143634], [3, 143891], [9, 144325], [18, 145327], [20, 145488], [26, 145848], [32, 146876], [35, 147062], [44, 148177], [47, 148402], [60, 149957], [63, 150545], [73, 151384], [76, 151575], [82, 151995], [88, 152475]]}, {"verse": 19, "start": 153760, "end": 158914, "text": "Honra a tu padre y a tu madre: y, Amarás a tu prójimo como a ti mismo.", "words": [[0, 153760], [6, 154244], [8, 154424], [11, 154524], [17, 154904], [19, 155244], [21, 155344], [24, 155424], [31, 156243], [34, 156616], [41, 157026], [43, 157126], [46, 157246], [54, 157826], [59, 158066], [61, 158266], [64, 158346]]}, {"verse": 20, "start": 159264, "end": 163738, "text": "Le dice el joven: Todo esto guardé desde mi juventud: ¿qué más me falta?", "words": [[0, 159264], [3, 159410], [8, 159690], [11, 159870], [18, 160623], [23, 160786], [28, 161086], [35, 161566], [41, 161706], [44, 161906], [54, 162772], [59, 162889], [63, 163069], [66, 163229]]}, {"verse": 21, "start": 164018, "end": 174472, "text": "Le dice Jesús: Si quieres ser perfecto, anda, vende lo que tienes, y dalo a los pobres, y tendrás tesoro en el cielo; y ven, sígueme.", "words": [[0, 164018], [3, 164359], [8, 164734], [15, 165290], [18, 165439], [26, 165759], [30, 166079], [40, 166959], [46, 167659], [52, 168359], [55, 168479], [59, 168599], [67, 169039], [69, 169399], [74, 169739], [76, 169859], [80, 169939], [88, 170439], [90, 170839], [98, 171279], [105, 171819], [108, 171979], [111, 172099], [118, 172739], [120, 173259], [125, 173879]]}, {"verse": 22, "start": 174822, "end": 180319, "text": "Y oyendo el joven esta palabra, se fue triste, porque tenía muchas posesiones.", "words": [[0, 174822], [2, 174986], [9, 175326], [12, 175486], [18, 175846], [23, 176026], [32, 176806], [35, 177086], [39, 177266], [47, 177686], [54, 178046], [60, 178366], [67, 178686]]}, {"verse": 23, "start": 180669, "end": 188726, "text": "Entonces Jesús dijo a sus discípulos: De cierto os digo, que un rico difícilmente entrará en el reino de los cielos.", "words": [[0, 180669], [9, 180983], [15, 181543], [20, 182083], [22, 182303], [26, 182443], [38, 183611], [41, 183776], [48, 184036], [51, 184476], [57, 184876], [61, 185111], [64, 185271], [69, 185571], [82, 186491], [90, 187211], [93, 187351], [96, 187511], [102, 187911], [105, 188011], [109, 188151]]}, {"verse": 24, "start": 189076, "end": 196612, "text": "Pero os digo, que es más fácil pasar un camello por el ojo de una aguja, que entrar un rico en el reino de Dios.", "words": [[0, 189076], [5, 189218], [8, 189358], [14, 189538], [18, 189738], [21, 189878], [25, 189978], [31, 190298], [37, 190778], [40, 190958], [48, 191458], [52, 191678], [55, 191838], [59, 192138], [62, 192278], [66, 192498], [73, 193478], [77, 193738], [84, 194118], [87, 194358], [92, 194778], [95, 195198], [98, 195378], [104, 195798], [107, 195978]]}, {"verse": 25, "start": 196962, "end": 204775, "text": "Pero sus discípulos, oyendo estas cosas, se espantaron en gran manera, diciendo: ¿Quién pues podrá ser salvo?", "words": [[0, 196962], [5, 197126], [9, 197346], [21, 198386], [28, 198906], [34, 199086], [41, 200126], [44, 200626], [55, 201126], [58, 201486], [63, 201726], [71, 202186], [81, 203181], [88, 203465], [93, 203665], [99, 204085], [103, 204245]]}, {"verse": 26, "start": 205055, "end": 212860, "text": "Y mirándolos Jesús, les dijo: Para con los hombres imposible es esto; pero para con Dios todo es posible.", "words": [[0, 205055], [2, 205179], [13, 205919], [20, 206379], [24, 206939], [30, 207684], [35, 207870], [39, 208090], [43, 208290], [51, 208710], [61, 209670], [64, 209910], [70, 210626], [75, 210770], [80, 211030], [84, 211270], [89, 211570], [94, 211950], [97, 212110]]}, {"verse": 27, "start": 213210, "end": 221119, "text": "Entonces respondiendo Pedro, le dijo: He aquí, nosotros hemos dejado todo, y te hemos seguido: ¿qué pues tendremos?", "words": [[0, 213210], [9, 214357], [22, 215277], [29, 215557], [32, 215797], [38, 216552], [41, 216693], [47, 216893], [56, 217133], [62, 217653], [69, 218173], [75, 218433], [77, 218833], [80, 218973], [86, 219153], [95, 219992], [100, 220110], [105, 220330]]}, {"verse": 28, "start": 221399, "end": 239055, "text": "Y Jesús les dijo: De cierto os digo, que vosotros que me habéis seguido, en la regeneración, cuando se sentará el Hijo del hombre en el trono de su gloria, vosotros también os sentaréis sobre doce tronos, para juzgar a las doce tribus de Israel.", "words": [[0, 221399], [2, 221524], [8, 221944], [12, 222284], [18, 223107], [21, 223254], [28, 223574], [31, 223914], [37, 224194], [41, 224414], [50, 224894], [54, 225074], [57, 225234], [64, 225514], [73, 226074], [76, 226194], [79, 226334], [93, 227234], [100, 227954], [103, 228414], [111, 229054], [114, 229314], [119, 229594], [123, 229794], [130, 230134], [133, 230474], [136, 230634], [142, 231074], [145, 231194], [148, 231621], [156, 232219], [165, 232765], [173, 233145], [176, 233425], [186, 234145], [192, 234585], [197, 235125], [205, 235645], [210, 236150], [217, 236750], [219, 236970], [223, 237130], [228, 237570], [235, 238130], [238, 238250]]}, {"verse": 29, "start": 239405, "end": 251861, "text": "Y cualquiera que deje casas, o hermanos, o hermanas, o padre, o madre, o mujer, o hijos, o tierras, por mi nombre, recibirá cien veces tanto, y heredará la vida eterna.", "words": [[0, 239405], [2, 239521], [13, 240081], [17, 240241], [22, 240541], [29, 241061], [31, 241241], [41, 241861], [43, 242041], [53, 242541], [55, 242801], [62, 243161], [64, 243441], [71, 243761], [73, 243981], [80, 244301], [82, 244581], [89, 244841], [91, 245341], [100, 245841], [104, 246121], [107, 246281], [115, 247081], [124, 247841], [129, 248101], [135, 248341], [142, 249430], [144, 249670], [153, 250330], [156, 250610], [161, 250890]]}, {"verse": 30, "start": 252211, "end": 256064, "text": "Pero muchos primeros serán últimos, y últimos primeros.", "words": [[0, 252211], [5, 252355], [12, 252735], [21, 253375], [27, 253775], [36, 254295], [38, 254855], [46, 255235]]}]}