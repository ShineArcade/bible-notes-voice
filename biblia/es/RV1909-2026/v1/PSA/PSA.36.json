{"book": "PSA", "chapter": 36, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 87526, "verses": [{"verse": 1, "start": 300, "end": 11619, "text": "Al Músico principal: Salmo de David, siervo del Señor. LA iniquidad del impío me dice al corazón: No hay temor de Dios delante de sus ojos.", "words": [[0, 300], [3, 489], [10, 949], [21, 2127], [27, 2572], [30, 2732], [37, 3512], [44, 3972], [48, 4152], [55, 5166], [58, 5265], [68, 5945], [72, 6145], [78, 6805], [81, 6965], [86, 7285], [89, 7465], [98, 8629], [101, 8934], [105, 9074], [111, 9414], [114, 9554], [119, 9894], [127, 10554], [130, 10714], [134, 10874]]}, {"verse": 2, "start": 12069, "end": 19660, "text": "Se lisonjea, por tanto, en sus propios ojos, hasta que su iniquidad sea hallada aborrecible.", "words": [[0, 12069], [3, 12543], [13, 13053], [17, 13193], [24, 13653], [27, 13953], [31, 14153], [39, 14753], [45, 15673], [51, 15953], [55, 16133], [58, 16703], [68, 17273], [72, 17933], [80, 18493]]}, {"verse": 3, "start": 20110, "end": 26157, "text": "Las palabras de su boca son iniquidad y fraude; no quiso entender para bien hacer.", "words": [[0, 20110], [4, 20219], [13, 20579], [16, 20819], [19, 20979], [24, 21279], [28, 21539], [38, 22359], [40, 22559], [48, 23573], [51, 23703], [57, 24083], [66, 24763], [71, 25163], [76, 25423]]}, {"verse": 4, "start": 26607, "end": 32755, "text": "Iniquidad piensa sobre su cama; está en camino no bueno, el mal no aborrece.", "words": [[0, 26607], [10, 27293], [17, 27833], [23, 28133], [26, 28353], [32, 29216], [37, 29404], [40, 29544], [47, 29884], [50, 30144], [57, 30924], [60, 31064], [64, 31324], [67, 32068]]}, {"verse": 5, "start": 33205, "end": 38145, "text": "Jehová, hasta los cielos es tu misericordia; tu verdad hasta las nubes.", "words": [[0, 33205], [8, 33705], [14, 33945], [18, 34145], [25, 34745], [28, 35025], [31, 35105], [45, 36477], [48, 36562], [55, 36882], [61, 37322], [65, 37502]]}, {"verse": 6, "start": 38595, "end": 46511, "text": "Tu justicia como los montes de Dios, tus juicios abismo grande: oh Jehová, al hombre y al animal conservas.", "words": [[0, 38595], [3, 38679], [12, 39359], [17, 39599], [21, 39779], [28, 40219], [31, 40339], [37, 40814], [41, 41289], [49, 41764], [56, 42239], [64, 43473], [67, 43693], [75, 43913], [78, 44313], [85, 44633], [87, 45093], [90, 45213], [97, 45493]]}, {"verse": 7, "start": 46961, "end": 55292, "text": "¡Cuán preciosa, oh Dios, es tu misericordia! Por eso los hijos de los hombres se amparan bajo la sombra de tus alas.", "words": [[0, 46961], [6, 47265], [16, 47745], [19, 48225], [25, 48465], [28, 48845], [31, 48925], [45, 50348], [49, 50472], [53, 50692], [57, 50932], [63, 51232], [66, 51412], [70, 51512], [78, 51912], [81, 52412], [89, 53152], [94, 53352], [97, 53572], [104, 54112], [107, 54272], [111, 54512]]}, {"verse": 8, "start": 55742, "end": 62653, "text": "Se embriagarán de la grasa de tu casa; y tú los abrevarás del torrente de tus delicias.", "words": [[0, 56053], [3, 56399], [15, 56746], [18, 56866], [21, 57006], [27, 57366], [30, 57526], [33, 57666], [39, 59282], [41, 59282], [44, 59282], [48, 59463], [58, 60283], [62, 60503], [71, 61163], [74, 61403], [78, 61663]]}, {"verse": 9, "start": 63103, "end": 68071, "text": "Porque contigo está el manantial de la vida: en tu luz veremos la luz.", "words": [[0, 63103], [7, 63326], [15, 63946], [20, 64186], [23, 64306], [33, 64926], [36, 65086], [39, 65226], [45, 66025], [48, 66172], [51, 66312], [55, 66612], [63, 67372], [66, 67532]]}, {"verse": 10, "start": 68521, "end": 74663, "text": "Extiende tu misericordia a los que te conocen, y tu justicia a los rectos de corazón.", "words": [[0, 68521], [9, 69160], [12, 69340], [25, 70300], [27, 70440], [31, 70580], [35, 70720], [38, 70840], [47, 71540], [49, 71880], [52, 72040], [61, 72680], [63, 72980], [67, 73160], [74, 73800], [77, 73920]]}, {"verse": 11, "start": 75113, "end": 80201, "text": "No venga contra mí pie de soberbia; y mano