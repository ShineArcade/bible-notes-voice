{"book": "PSA", "chapter": 140, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 92982, "verses": [{"verse": 1, "start": 300, "end": 8433, "text": "Al Músico principal: Salmo de David. LÍBRAME, oh Jehová, de hombre malo: guárdame de hombre violento;", "words": [[0, 300], [3, 470], [10, 950], [21, 2093], [27, 2635], [30, 2795], [37, 3891], [46, 4331], [49, 4771], [57, 5211], [60, 5311], [67, 5631], [73, 6478], [82, 7059], [85, 7219], [92, 7479]]}, {"verse": 2, "start": 8783, "end": 13744, "text": "Los cuales maquinan males en el corazón, cada día urden contiendas.", "words": [[0, 8783], [4, 8927], [11, 9127], [20, 9807], [26, 10227], [29, 10507], [32, 10627], [41, 11167], [46, 11687], [50, 12047], [56, 12895]]}, {"verse": 3, "start": 14094, "end": 21063, "text": "Aguzaron su lengua como la serpiente; veneno de áspid hay debajo de sus labios. (Selah.)", "words": [[0, 14454], [9, 14814], [12, 15054], [19, 15534], [24, 15774], [27, 15914], [38, 17088], [45, 17593], [48, 17753], [54, 18293], [58, 18513], [65, 18933], [68, 19093], [72, 19233], [80, 20640]]}, {"verse": 4, "start": 21413, "end": 28772, "text": "Guárdame, oh Jehová, de manos del impío, presérvame del hombre injurioso; que han pensado trastornar mis pasos.", "words": [[0, 21413], [10, 21790], [13, 22204], [21, 22618], [24, 22737], [30, 23230], [34, 23724], [41, 24217], [52, 24717], [56, 24958], [63, 25178], [74, 26405], [78, 26486], [82, 26586], [90, 27126], [101, 27886], [105, 28046]]}, {"verse": 5, "start": 29122, "end": 37310, "text": "Me han escondido lazo y cuerdas los soberbios; han tendido red junto a la senda; me han puesto lazos. (Selah.)", "words": [[0, 29122], [3, 29362], [7, 29422], [17, 29922], [22, 30422], [24, 30802], [32, 31262], [36, 31382], [47, 32389], [51, 32590], [59, 33150], [63, 33490], [69, 33850], [71, 34090], [74, 34170], [81, 35012], [84, 35128], [88, 35208], [95, 35408], [102, 36887]]}, {"verse": 6, "start": 37660, "end": 43806, "text": "He dich