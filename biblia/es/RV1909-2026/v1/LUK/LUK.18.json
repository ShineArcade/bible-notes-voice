{"book": "LUK", "chapter": 18, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 314413, "verses": [{"verse": 1, "start": 300, "end": 7660, "text": "Y LES PROPUSO también una parábola sobre que es necesario orar siempre, y no desanimarse,", "words": [[0, 300], [2, 442], [6, 562], [14, 1202], [22, 1582], [26, 2022], [35, 2641], [41, 3002], [45, 3282], [48, 3462], [58, 4361], [63, 4982], [72, 5442], [74, 5922], [77, 6082]]}, {"verse": 2, "start": 8010, "end": 13863, "text": "Diciendo: Había un juez en una ciudad, el cual ni temía a Dios, ni respetaba a hombre.", "words": [[0, 8010], [10, 9078], [16, 9143], [19, 9208], [24, 9273], [27, 9573], [31, 9733], [39, 10133], [42, 10493], [47, 10713], [50, 11033], [56, 11473], [58, 11693], [64, 11913], [67, 12473], [77, 13133], [79, 13333]]}, {"verse": 3, "start": 14213, "end": 22476, "text": "Había también en aquella ciudad una viuda, la cual venía a él diciendo: Hazme justicia de mi adversario.", "words": [[0, 14213], [6, 14522], [14, 14962], [17, 15402], [25, 15822], [32, 16202], [36, 16582], [43, 17522], [46, 17742], [51, 17962], [57, 18502], [59, 18722], [62, 18962], [72, 20020], [78, 20436], [87, 21176], [90, 21356], [93, 21456]]}, {"verse": 4, "start": 22756, "end": 31131, "text": "Y él no quiso por algún tiempo; pero después de esto dijo dentro de sí: Aunque ni temo a Dios, ni tengo respeto a hombre,", "words": [[0, 22756], [2, 22916], [5, 23056], [8, 23216], [14, 23576], [18, 23796], [24, 24056], [32, 24979], [37, 25354], [45, 25694], [48, 25894], [53, 26134], [58, 26454], [65, 27014], [68, 27314], [72, 27911], [79, 28111], [82, 28311], [87, 28631], [89, 28711], [95, 29411], [98, 29571], [104, 29871], [112, 30451], [114, 30591]]}, {"verse": 5, "start": 31131, "end": 37515, "text": "Sin embargo, porque esta viuda me es molesta, le haré justicia, para que al fin no venga y me muela.", "words": [[0, 31191], [4, 31251], [13, 31991], [20, 32171], [25, 32451], [31, 32811], [34, 33011], [37, 33151], [46, 34031], [49, 34131], [54, 34371], [64, 35391], [69, 35691], [73, 35871], [76, 35991], [80, 36191], [83, 36411], [89, 36771], [91, 36911], [94, 37011]]}, {"verse": 6, "start": 37795, "end": 41622, "text": "Y dijo el Señor: Oíd lo que dice el juez injusto.", "words": [[0, 37795], [2, 37920], [7, 38220], [10, 38360], [17, 39271], [21, 39683], [24, 39963], [28, 40103], [33, 40383], [36, 40583], [41, 40863]]}, {"verse": 7, "start": 41972, "end": 48010, "text": "¿Y Dios no hará justicia a sus escogidos, que claman a él día y noche, aunque sea paciente con ellos?", "words": [[0, 41972], [3, 42100], [8, 42420], [11, 42835], [16, 43015], [25, 43555], [27, 43735], [31, 43855], [42, 44495], [46, 44635], [53, 44865], [55, 45095], [58, 45275], [62, 45515], [64, 45695], [71, 46315], [78, 46495], [82, 46795], [91, 47295], [95, 47535]]}, {"verse": 8, "start": 48360, "end": 54945, "text": "Os digo que los defenderá pronto. Pero cuando venga el Hijo del hombre, ¿hallará fe en la tierra?", "words": [[0, 48360], [3, 48484], [8, 48784], [12, 48944], [16, 49104], [26, 49684], [34, 50611], [39, 50755], [46, 51015], [52, 51455], [55, 51575], [60, 51795], [64, 51955], [72, 52695], [81, 53335], [84, 53635], [87, 53955], [90, 54115]]}, {"verse": 9, "start": 55295, "end": 61823, "text": "Y dijo también a unos que confiaban de sí como justos, y menospreciaban a los otros, esta parábola:", "words": [[0, 55295], [2, 55407], [7, 55647], [15, 55987], [17, 56247], [22, 56427], [26, 56607], [36, 57207], [39, 57467], [42, 57587], [47, 57867], [55, 58507], [57, 58627], [72, 59567], [74, 59747], [78, 59927], [85, 60767], [90, 61087]]}, {"verse": 10, "start": 62173, "end": 68865, "text": "Dos hombres subieron al templo a orar: el uno fariseo, el otro recaudador de impuestos.", "words": [[0, 62173], [4, 62379], [12, 62869], [21, 63359], [24, 63519], [31, 64099], [33, 64259], [39, 64967], [42, 65248], [46, 65408], [55, 66548], [58, 66648], [63, 66848], [74, 67688], [77, 67888]]}, {"verse": 11, "start": 69215, "end": 81802, "text": "El fariseo, en pie, oraba consigo de esta manera: Dios, te doy gracias, que no soy como los otros hombres, ladrones, injustos, adúlteros, ni aun como este recaudador de impuestos;", "words": [[0, 69215], [3, 69379], [12, 70139], [15, 70279], [20, 70639], [26, 71699], [34, 72179], [37, 72499], [42, 72719], [50, 73587], [56, 73752], [59, 73932], [63, 74152], [72, 74912], [76, 74972], [79, 75152], [83, 75392], [88, 75612], [92, 75812], [98, 76052], [107, 76952], [117, 77792], [127, 78652], [138, 79592], [141, 79792], [145, 79992], [150, 80312], [155, 80532], [166, 81172], [169, 81332]]}, {"verse": 12, "start": 82152, "end": 86411, "text": "Ayuno dos veces a la semana, doy diezmos de todo lo que poseo.", "words": [[0, 82594], [6, 83054], [10, 83234], [16, 83494], [18, 83714], [21, 83774], [29, 84614], [33, 84814], [41, 85194], [44, 85374], [49, 85534], [52, 85714], [56, 85834]]}, {"verse": 13, "start": 86691, "end": 99261, "text": "Pero el recaudador de impuestos estando lejos no quería ni aun alzar los ojos al cielo, sino que se golpeaba el pecho, diciendo: Dios, ten misericordia de mí, pecador.", "words": [[0, 86691], [5, 86913], [8, 87113], [19, 87793], [22, 88033], [32, 88613], [40, 89113], [46, 89813], [49, 90253], [56, 90653], [59, 91053], [63, 91353], [69, 92033], [73, 92393], [78, 92793], [81, 93073], [88, 93613], [93, 94153], [97, 94353], [100, 94493], [109, 95093], [112, 95293], [119, 96033], [129, 97004], [135, 97250], [139, 97470], [152, 98230], [155, 98350], [159, 98690]]}, {"verse": 14, "start": 99541, "end": 110955, "text": "Os digo que este descendió a su casa justificado, a diferencia del otro; porque cualquiera que se enaltece, será humillado; y el que se humilla, será enaltecido.", "words": [[0, 99541], [3, 99664], [8, 99984], [12, 100244], [17, 100464], [27, 101184], [29, 101324], [32, 101444], [37, 101784], [50, 103124], [52, 103344], [63, 103684], [67, 104244], [73, 104962], [80, 105186], [91, 105846], [95, 106026], [98, 106186], [108, 106946], [113, 107266], [124, 108489], [126, 108650], [129, 108750], [133, 108890], [136, 109070], [145, 109490], [150, 109830]]}, {"verse": 15, "start": 111305, "end": 117507, "text": "Y traían a él los niños para que los tocase; lo cual viendo los discípulos les reprendían.", "words": [[0, 111305], [2, 111409], [9, 111949], [11, 112129], [14, 112329], [18, 112509], [24, 112949], [29, 113329], [33, 113509], [37, 113629], [45, 114669], [48, 114775], [53, 114935], [60, 115255], [64, 115475], [75, 116235], [79, 116615]]}, {"verse": 16, "start": 117857, "end": 126061, "text": "Pero Jesús llamándolos, dijo: Dejad los niños venir a mí, y no los impidáis; porque de tales es el reino de Dios.", "words": [[0, 117857], [5, 118002], [11, 118642], [24, 119282], [30, 119786], [36, 120366], [40, 120526], [46, 120906], [52, 121286], [54, 121466], [58, 121646], [60, 122066], [63, 122226], [67, 122814], [77, 123591], [84, 123815], [87, 124035], [93, 124335], [96, 124675], [99, 124875], [105, 125295], [108, 125455]]}, {"verse": 17, "start": 126411, "end": 133341, "text": "De cierto os digo, que cualquiera que no reciba el reino de Dios como un niño, no entrará en él.", "words": [[0, 126411], [3, 126597], [10, 126917], [13, 127297], [19, 127577], [23, 128137], [34, 128757], [38, 128897], [41, 129077], [48, 129637], [51, 129777], [57, 130137], [60, 130297], [65, 130537], [70, 130857], [73, 131097], [79, 131477], [82, 132097], [90, 132757], [93, 132937]]}, {"verse": 18, "start": 133691, "end": 139417, "text": "Y le preguntó un dirigente, diciendo: Maestro bueno, ¿qué haré para poseer la vida eterna?", "words": [[0, 133691], [2, 133798], [5, 133898], [14, 134418], [17, 134498], [28, 135178], [38, 136348], [46, 136829], [53, 137549], [58, 137669], [63, 137929], [68, 138089], [75, 138549], [78, 138649], [83, 138829]]}, {"verse": 19, "start": 139697, "end": 144986, "text": "Y Jesús le dijo: ¿Por qué me llamas bueno? ninguno hay bueno sino sólo Dios.", "words": [[0, 139697], [2, 139807], [8, 140207], [11, 140527], [17, 141334], [22, 141456], [26, 141636], [29, 141776], [36, 142116], [43, 142806], [51, 143273], [55, 143433], [61, 143753], [66, 144013], [71, 144333]]}, {"verse": 20, "start": 145336, "end": 156322, "text": "Los mandamientos sabes: No matarás: No adulterarás: No hurtarás: No dirás falso testimonio: Honra a tu padre y a tu madre.", "words": [[0, 145336], [4, 145461], [17, 146081], [24, 147005], [27, 147285], [36, 148351], [39, 148711], [52, 150069], [55, 150674], [65, 151532], [68, 151792], [74, 152152], [80, 152572], [92, 153731], [98, 154234], [100, 154434], [103, 154554], [109, 154994], [111, 155454], [113, 155554], [116, 155694]]}, {"verse": 21, "start": 156671, "end": 160744, "text": "Y él dijo: Todas estas cosas he guardado desde mi juventud.", "words": [[0, 156671], [2, 156989], [5, 157149], [11, 157905], [17, 158042], [23, 158382], [29, 158822], [32, 159162], [41, 159642], [47, 159862], [50, 160082]]}, {"verse": 22, "start": 161024, "end": 172118, "text": "Y Jesús, oído esto, le dijo: Aún te falta una cosa: vende todo lo que tienes, y da a los pobres, y tendrás tesoro en el cielo; y ven, sígueme.", "words": [[0, 161024], [2, 161146], [9, 161546], [14, 162226], [20, 162926], [23, 163066], [29, 163892], [33, 164115], [36, 164315], [42, 164615], [46, 164855], [52, 165579], [58, 165965], [63, 166265], [66, 166485], [70, 166585], [78, 166965], [80, 167465], [83, 167685], [85, 167805], [89, 167905], [97, 168525], [99, 168905], [107, 169365], [114, 169845], [117, 169965], [120, 170085], [127, 170850], [129, 171033], [134, 171493]]}, {"verse": 23, "start": 172468, "end": 178268, "text": "Entonces él, oídas estas cosas, se puso muy triste, porque era muy rico.", "words": [[0, 172468], [9, 173026], [13, 173446], [19, 174006], [25, 174246], [32, 174986], [35, 175246], [40, 175566], [44, 175926], [52, 176486], [59, 177106], [63, 177366], [67, 177646]]}, {"verse": 24, "start": 178618, "end": 188338, "text": "Y viendo Jesús que se había entristecido mucho, dijo: ¡Con cuánta dificultad entrarán en el reino de Dios los que tienen riquezas!", "words": [[0, 178618], [2, 178741], [9, 179001], [15, 179481], [19, 180001], [22, 180161], [28, 180821], [41, 181481], [48, 182121], [54, 182902], [59, 183050], [66, 183630], [77, 184530], [86, 185290], [89, 185510], [92, 185690], [98, 186090], [101, 186230], [106, 186510], [110, 186950], [114, 187090], [121, 187750]]}, {"verse": 25, "start": 188688, "end": 195691, "text": "Porque más fácil cosa es entrar un camello por el ojo de una aguja, que un rico entrar en el reino de Dios.", "words": [[0, 188688], [7, 188913], [11, 189093], [17, 189493], [22, 189933], [25, 190213], [32, 190653], [35, 190913], [43, 191393], [47, 191633], [50, 191753], [54, 192053], [57, 192173], [61, 192353], [68, 192973], [72, 193158], [75, 193318], [80, 193578], [87, 194098], [90, 194458], [93, 194618], [99, 194978], [102, 195098]]}, {"verse": 26, "start": 196041, "end": 199216, "text": "Y los que lo oían, dijeron: ¿Y quién podrá ser salvo?", "words": [[0, 196041], [2, 196147], [6, 196287], [10, 196447], [13, 196647], [19, 197127], [28, 197880], [31, 198005], [37, 198205], [43, 198605], [47, 198705]]}, {"verse": 27, "start": 199496, "end": 205414, "text": "Y él les dijo: Lo que es imposible para con los hombres, posible es para Dios.", "words": [[0, 199496], [2, 199678], [5, 199878], [9, 200238], [15, 201081], [18, 201223], [22, 201383], [25, 201543], [35, 202383], [40, 202623], [44, 202843], [48, 203023], [57, 203663], [65, 204383], [68, 204623], [73, 204823]]}, {"verse": 28, "start": 205764, "end": 211908, "text": "Entonces Pedro dijo: He aquí, nosotros hemos dejado las posesiones nuestras, y te hemos seguido.", "words": [[0, 205764], [9, 206305], [15, 206865], [21, 207789], [24, 207879], [30, 208119], [39, 208419], [45, 208899], [52, 209399], [56, 209539], [67, 210099], [77, 210579], [79, 210999], [82, 211159], [88, 211319]]}, {"verse": 29, "start": 212188, "end": 221628, "text": "Y él les dijo: De cierto os digo, que nadie hay que haya dejado casa, padres, o hermanos, o mujer, o hijos, por el reino de Dios,", "words": [[0, 212188], [2, 212351], [5, 212501], [9, 212651], [15, 213431], [18, 213638], [25, 213938], [28, 214358], [34, 214638], [38, 215238], [44, 215638], [48, 216118], [52, 216338], [57, 216498], [64, 217018], [70, 217386], [78, 217754], [80, 218122], [90, 218490], [92, 218858], [99, 219318], [101, 219518], [108, 219878], [112, 220458], [115, 220618], [121, 221018], [124, 221178]]}, {"verse": 30, "start": 221978, "end": 227244, "text": "Que no haya de recibir mucho más en este tiempo, y en la era venidera la vida eterna.", "words": [[0, 221978], [4, 222063], [7, 222243], [12, 222463], [15, 222643], [23, 223043], [29, 223423], [33, 223683], [36, 223863], [41, 224063], [49, 224523], [51, 224808], [54, 224988], [57, 225188], [61, 225448], [70, 226068], [73, 226148], [78, 226368]]}, {"verse": 31, "start": 227594, "end": 238535, "text": "Y Jesús, tomando a los doce, les dijo: He aquí subimos a Jerusalén, y serán cumplidas todas las cosas que fueron escritas por los profetas, del Hijo del hombre.", "words": [[0, 227594], [2, 227872], [9, 228592], [17, 229052], [19, 229152], [23, 229272], [29, 230072], [33, 230132], [39, 230907], [42, 230987], [47, 231207], [55, 231787], [57, 231947], [68, 232667], [70, 233167], [76, 233547], [86, 234247], [92, 234527], [96, 234827], [102, 235107], [106, 235327], [113, 235587], [122, 236207], [126, 236427], [130, 236587], [140, 237247], [144, 237572], [149, 237872], [153, 238052]]}, {"verse": 32, "start": 238885, "end": 245869, "text": "Porque será entregado a los gentiles, y será objeto de burlas, e injuriado, y escupido.", "words": [[0, 238885], [7, 239088], [12, 239468], [22, 240448], [24, 240528], [28, 240628], [38, 241348], [40, 241868], [45, 242148], [52, 242768], [55, 243008], [63, 243568], [65, 243868], [76, 244788], [78, 245008]]}, {"verse": 33, "start": 246219, "end": 251636, "text": "Y después que le hayan azotado, le matarán: pero al tercer día resucitará.", "words": [[0, 246219], [2, 246389], [10, 246629], [14, 246809], [17, 246929], [23, 247359], [32, 247789], [35, 247929], [44, 248850], [49, 249274], [52, 249514], [59, 249814], [63, 250274]]}, {"verse": 34, "start": 251986, "end": 260565, "text": "Pero ellos nada de estas cosas entendían, y esta palabra les era encubierta, y no entendían lo que se decía.", "words": [[0, 251986], [5, 252148], [11, 252868], [16, 253208], [19, 253428], [25, 253648], [31, 254088], [42, 255388], [44, 255628], [49, 255848], [57, 256228], [61, 256768], [65, 257008], [77, 257848], [79, 258448], [82, 258628], [92, 259308], [95, 259508], [99, 259648], [102, 259788]]}, {"verse": 35, "start": 260915, "end": 267379, "text": "Y aconteció que acercándose él a Jericó, un ciego estaba sentado junto al camino mendigando;", "words": [[0, 260915], [2, 261038], [12, 261758], [16, 262138], [28, 262898], [31, 263258], [33, 263458], [41, 264438], [44, 264708], [50, 264978], [57, 265198], [65, 265738], [71, 265918], [74, 266138], [81, 266478]]}, {"verse": 36, "start": 267729, "end": 271690, "text": "El cual cuando oyó la gente que pasaba, preguntó qué era aquello.", "words": [[0, 267729], [3, 267918], [8, 268138], [15, 268378], [19, 268838], [22, 268958], [28, 269218], [32, 269398], [40, 270118], [49, 270658], [53, 270838], [57, 271038]]}, {"verse": 37, "start": 272040, "end": 274656, "text": "Y le dijeron que pasaba Jesús nazareno.", "words": [[0, 272040], [2, 272148], [5, 272248], [13, 272748], [17, 272868], [24, 273308], [30, 273648]]}, {"verse": 38, "start": 275006, "end": 280646, "text": "Entonces dio voces, diciendo: Jesús, Hijo de David, ten misericordia de mí.", "words": [[0, 275006], [9, 275625], [13, 276205], [20, 276685], [30, 277631], [37, 278179], [42, 278399], [45, 278519], [52, 278979], [56, 279439], [69, 280219], [72, 280359]]}, {"verse": 39, "start": 280926, "end": 289578, "text": "Y los que iban delante, le reprendían para que callase; pero él clamaba mucho más: Hijo de David, ten misericordia de mí.", "words": [[0, 280926], [2, 281048], [6, 281208], [10, 281408], [15, 281668], [24, 282118], [27, 282568], [38, 283308], [43, 283608], [47, 283828], [56, 284942], [61, 285088], [64, 285348], [72, 285908], [78, 286248], [83, 287130], [88, 287387], [91, 287527], [98, 288087], [102, 288207], [115, 289007], [118, 289147]]}, {"verse": 40, "start": 289858, "end": 296135, "text": "Jesús entonces parándose, mandó traerle a sí: y como él llegó, le preguntó,", "words": [[0, 289858], [6, 290646], [15, 291446], [26, 292266], [32, 292586], [40, 292963], [42, 293340], [46, 293869], [48, 294133], [53, 294373], [56, 294593], [63, 294893], [66, 295413]]}, {"verse": 41, "start": 296485, "end": 300984, "text": "Diciendo: ¿Qué quieres que te haga? Y él dijo: Señor, que vea.", "words": [[0, 296485], [10, 297544], [15, 297648], [23, 297988], [27, 298168], [30, 298328], [36, 299053], [38, 299241], [41, 299576], [47, 300057], [54, 300362], [58, 300562]]}, {"verse": 42, "start": 301264, "end": 306242, "text": "Y Jesús le dijo: Recobra la vista, tu fe te ha hecho salvo.", "words": [[0, 301264], [2, 301387], [8, 301787], [11, 302107], [17, 303135], [25, 303465], [28, 303605], [35, 304445], [38, 304665], [41, 304945], [44, 305185], [47, 305325], [53, 305545]]}, {"verse": 43, "start": 306592, "end": 314013, "text": "Y enseguida vio, y le seguía, glorificando a Dios: y todo el pueblo como lo vio, dio a Dios alabanza.", "words": [[0, 306592], [2, 306726], [12, 307206], [17, 307546], [19, 307926], [22, 308046], [30, 308446], [43, 309306], [45, 309406], [51, 310117], [53, 310245], [58, 310485], [61, 310785], [68, 311185], [73, 311405], [76, 311605], [81, 312245], [85, 312505], [87, 312765], [92, 313423]]}]}