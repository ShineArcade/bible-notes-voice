{"book": "PSA", "chapter": 83, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 108924, "verses": [{"verse": 1, "start": 300, "end": 7358, "text": "Canción: Salmo de Asaf. OH Dios, no tengas silencio: no calles, oh Dios, ni te estés quieto.", "words": [[0, 300], [9, 1377], [15, 1819], [18, 1999], [24, 2697], [27, 2777], [33, 3017], [36, 3327], [43, 3637], [53, 4773], [56, 5053], [64, 5363], [67, 5673], [73, 6273], [76, 6413], [79, 6553], [85, 6853]]}, {"verse": 2, "start": 7708, "end": 13159, "text": "Porque he aquí que rugen tus enemigos; y tus aborrecedores han alzado cabeza.", "words": [[0, 7764], [7, 7924], [10, 8204], [15, 8544], [19, 8854], [25, 9164], [29, 9404], [39, 10424], [41, 10624], [45, 11134], [59, 11644], [63, 11904], [70, 12404]]}, {"verse": 3, "start": 13509, "end": 20734, "text": "Sobre tu pueblo han consultado astuta y secretamente, y han entrado en consejo contra tus escondidos.", "words": [[0, 13509], [6, 13810], [9, 14030], [16, 14470], [20, 14730], [31, 15510], [38, 16010], [40, 16130], [54, 16890], [56, 17490], [60, 17650], [68, 18290], [71, 18450], [79, 19150], [86, 19530], [90, 19790]]}, {"verse": 4, "start": 21084, "end": 26893, "text": "Han dicho: Venid, y cortémoslos de ser pueblo, y no haya más memoria del nombre de Israel.", "words": [[0, 21341], [4, 21597], [11, 22027], [18, 22391], [20, 22841], [32, 23291], [35, 23491], [39, 23671], [47, 24471], [49, 24631], [52, 24751], [57, 24971], [61, 25211], [69, 25711], [73, 25891], [80, 26191], [83, 26371]]}, {"verse": 5, "start": 27173, "end": 32331, "text": "Por esto han conspirado de corazón a una, contra ti han hecho liga;", "words": [[0, 27173], [4, 27315], [9, 27615], [13, 28095], [24, 28915], [27, 29075], [35, 29515], [37, 29895], [42, 30475], [49, 31015], [52, 31175], [56, 31435], [62, 31655]]}, {"verse": 6, "start": 32681, "end": 38309, "text": "Las tiendas de los edomitas y de los ismaelitas, Moab y los agarenos;", "words": [[0, 32681], [4, 32806], [12, 33266], [15, 33366], [19, 33506], [28, 34106], [30, 34306], [33, 34406], [37, 34566], [49, 35666], [54, 36326], [56, 36491], [60, 37426]]}, {"verse": 7, "start": 38659, "end": 43179, "text": "Gebal, y Amón, y Amalec; los filisteos con los habitantes de Tiro.", "words": [[0, 38934], [7, 39244], [9, 39517], [15, 39790], [17, 40064], [25, 40497], [29, 40637], [39, 41476], [43, 41756], [47, 41877], [58, 42517], [61, 42657]]}, {"verse": 8, "start": 43529, "end": 51509, "text": "También el Assur se ha juntado con ellos: son por brazo a los hijos de Lot. (Selah.)", "words": [[0, 43529], [8, 43873], [11, 44333], [17, 44793], [20, 45253], [23, 45353], [31, 45913], [35, 46153], [42, 46905], [46, 47289], [50, 47529], [56, 48109], [58, 48329], [62, 48469], [68, 48769], [71, 49009], [76, 49776]]}, {"verse": 9, "start": 51859, "end": 57425, "text": "Hazles como a Madián; como a Sísara, como a Jabín en el arroyo de Cisón;", "words": [[0, 51859], [7, 51859], [12, 52081], [14, 52921], [22, 53942], [27, 54129], [29, 54439], [37, 54749], [42, 55069], [44, 55399], [50, 55729], [53, 56009], [56, 56319], [63, 56629], [66, 56809]]}, {"verse": 10, "start": 57775, "end": 62322, "text": "Que perecieron en Endor, fueron hechos estiércol para la tierra.", "words": [[0, 57775], [4, 58209], [15, 58679], [18, 58979], [25, 59419], [32, 59939], [39, 60399], [49, 61159], [54, 61459], [57, 61619]]}, {"verse": 11, "start": 62672, "end": 71680, "text": "Pon a ellos y a sus capitanes como a Oreb y como a Zeeb; y como a Zeba y como a Zalmuna, a todos sus príncipes;", "words": [[0, 62757], [4, 62877], [6, 63017], [12, 63377], [14, 63677], [16, 63817], [20, 63977], [30, 64817], [35, 65037], [37, 65317], [42, 65717], [44, 66177], [49, 66477], [51, 66943], [57, 67573], [59, 67679], [64, 67939], [66, 68239], [71, 68539], [73, 68679], [78, 68899], [80, 69399], [89, 69899], [91, 70019], [97, 70299], [101, 70699]]}, {"verse": 12, "start": 72030, "end": 75599, "text": "Que han dicho: Heredemos para nosotros las moradas de Dios.", "words": [[0, 72030], [4, 72153], [8, 72273], [15, 72945], [25, 73427], [30, 73667], [39, 74127], [43, 74387], [51, 74867], [54, 75067]]}, {"verse": 13, "start": 75879, "end": 81331, "text": "Dios mío, ponlos como a torbellinos; como a hojarascas delante del viento.", "words": [[0, 75879], [5, 76088], [10, 76568], [17, 77048], [22, 77634], [24, 78220], [37, 78967], [42, 79172], [44, 79602], [55, 80032], [63, 80472], [67, 80712]]}, {"verse": 14, "start": 81681, "end": 85926, "text": "Como fuego que quema el monte, como llama que abrasa las breñas.", "words": [[0, 81681], [5, 81847], [11, 82167], [15, 82447], [21, 82707], [24, 82847], [31, 83807], [36, 83967], [42, 84247], [46, 84597], [53, 84947], [57, 85087]]}, {"verse": 15, "start": 86276, "end": 91003, "text": "Persíguelos así con tu tempestad, y asómbralos con tu torbellino.", "words": [[0, 86276], [12, 87301], [16, 87601], [20, 87841], [23, 88271], [34, 88701], [36, 89121], [47, 89881], [51, 90061], [54, 90546]]}, {"verse": 16, "start": 91353, "end": 96293, "text": "Llena sus rostros de vergüenza; y busquen tu nombre, oh Jehová.", "words": [[0, 91353], [6, 91779], [10, 91979], [18, 92659], [21, 92839], [32, 94003], [34, 94127], [42, 94627], [45, 94807], [53, 95207], [56, 95607]]}, {"verse": 17, "start": 96643, "end": 102412, "text": "Sean afrentados y turbados para siempre; y sean deshonrados, y perezcan.", "words": [[0, 96643], [5, 97003], [16, 97863], [18, 98063], [27, 98603], [32, 98863], [41, 99965], [43, 100091], [48, 100351], [61, 101291], [63, 101511]]}, {"verse": 18, "start": 102762, "end": 108524, "text": "Y conozcan que tu nombre es JEHOVÁ; tú solo Altísimo sobre toda la tierra.", "words": [[0, 102762], [2, 103013], [11, 103613], [15, 103793], [18, 103953], [25, 104273], [28, 104673], [36, 105778], [39, 105883], [44, 106183], [53, 106903], [59, 107263], [64, 107563], [67, 107823]]}]}