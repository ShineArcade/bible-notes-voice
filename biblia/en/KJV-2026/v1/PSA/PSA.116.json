{"book": "PSA", "chapter": 116, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 94156, "verses": [{"verse": 1, "start": 300, "end": 4790, "text": "I love the LORD, because he has heard my voice and my supplications.", "words": [[0, 300], [2, 505], [7, 845], [11, 1145], [17, 1425], [25, 1845], [28, 2145], [32, 2345], [38, 2605], [41, 2865], [47, 3265], [51, 3545], [54, 3705]]}, {"verse": 2, "start": 5240, "end": 10928, "text": "Because he has inclined his ear to me, therefore will I call upon him as long as I live.", "words": [[0, 5240], [8, 5484], [11, 5744], [15, 5944], [24, 6384], [28, 6704], [32, 6984], [35, 7164], [39, 7684], [49, 8144], [54, 8484], [56, 8684], [61, 8944], [66, 9184], [70, 9544], [73, 9764], [78, 10024], [81, 10204], [83, 10364]]}, {"verse": 3, "start": 11378, "end": 17285, "text": "The sorrows of death compassed me, and the pains of hell got hold upon me: I found trouble and sorrow.", "words": [[0, 11378], [4, 11452], [12, 11972], [15, 12072], [21, 12362], [31, 12652], [35, 13372], [39, 13472], [43, 13612], [49, 13892], [52, 14112], [57, 14332], [61, 14552], [66, 14772], [71, 15092], [75, 15739], [77, 15845], [83, 16045], [91, 16425], [95, 16705]]}, {"verse": 4, "start": 17735, "end": 22694, "text": "Then called I upon the name of the LORD; O LORD, I beg you, deliver my soul.", "words": [[0, 17735], [5, 17988], [12, 18242], [14, 18495], [19, 18755], [23, 18955], [28, 19195], [31, 19335], [35, 19455], [41, 20361], [43, 20461], [49, 20901], [51, 20921], [55, 21141], [60, 21541], [68, 21781], [71, 22081]]}, {"verse": 5, "start": 23144, "end": 27302, "text": "Gracious is the LORD, and righteous; yes, our God is merciful.", "words": [[0, 23144], [9, 23647], [12, 23787], [16, 23947], [22, 24247], [26, 24607], [37, 25628], [42, 26077], [46, 26177], [50, 26437], [53, 26617]]}, {"verse": 6, "start": 27752, "end": 31500, "text": "The LORD preserves the simple: I was brought low, and he helped me.", "words": [[0, 27752],