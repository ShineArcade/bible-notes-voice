{"book": "JHN", "chapter": 15, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 213277, "verses": [{"verse": 1, "start": 300, "end": 3950, "text": "Yo soy la vid verdadera, y mi Padre es el labrador.", "words": [[0, 300], [3, 486], [7, 726], [10, 926], [14, 1126], [25, 1846], [27, 2166], [30, 2306], [36, 2646], [39, 3006], [42, 3186]]}, {"verse": 2, "start": 4300, "end": 14191, "text": "Toda rama que en mí no lleva fruto, la quitará: y toda aquella que lleva fruto, la limpiará mediante la poda, para que lleve más fruto.", "words": [[0, 4300], [5, 4565], [10, 4965], [14, 5160], [17, 5355], [20, 5550], [23, 5745], [29, 5945], [36, 6525], [39, 7105], [48, 8094], [50, 8258], [55, 8458], [63, 8958], [67, 9078], [73, 9358], [80, 10258], [83, 10598], [92, 11218], [101, 11658], [104, 11838], [110, 12298], [115, 12558], [119, 12718], [125, 13098], [129, 13338]]}, {"verse": 3, "start": 14541, "end": 18430, "text": "Ya vosotros sois limpios por la palabra que os he hablado.", "words": [[0, 14541], [3, 14861], [12, 15421], [17, 15881], [25, 16601], [29, 16821], [32, 16981], [40, 17361], [44, 17601], [47, 17761], [50, 17901]]}, {"verse": 4, "start": 18780, "end": 29339, "text": "Estad en mí, y yo en vosotros. Como la rama no puede llevar fruto de sí misma, si no está en la vid; así ni vosotros, si no permanecéis en mí.", "words": [[0, 18780], [6, 19163], [9, 19343], [13, 19583], [15, 19983], [18, 20223], [21, 20523], [31, 21583], [36, 21729], [39, 21909], [44, 22289], [47, 22489], [53, 22749], [60, 23109], [66, 23629], [69, 23789], [72, 23969], [79, 24409], [82, 24989], [85, 25129], [90, 25349], [93, 25489], [96, 25816], [101, 26292], [105, 26477], [108, 26657], [118, 27557], [121, 27717], [124, 27837], [136, 28717], [139, 28837]]}, {"verse": 5, "start": 29689, "end": 38939, "text": "Yo soy la vid, vosotros las ramas: el que está en mí, y yo en él, este lleva mucho fruto; porque sin mí nada podéis hacer.", "words": [[0, 29689], [3, 29857], [7, 30177], [10, 30497], [15, 30817], [24, 31397], [28, 31497], [35, 32432], [38, 32577], [42, 32717], [47, 32937], [50, 33157], [54, 33817], [56, 34037], [59, 34217], [62, 34357], [66, 34917], [71, 35177], [77, 35477], [83, 35817], [90, 36703], [97, 36928], [101, 37188], [104, 37488], [109, 37828], [116, 38248]]}, {"verse": 6, "start": 39289, "end": 47320, "text": "El que en mí no esté, será echado fuera como rama mala, y se secará; y las recogen, y las echan en el fuego, y arden.", "words": [[0, 39289], [3, 39629], [7, 39809], [10, 39949], [13, 40089], [16, 40229], [22, 40469], [27, 40909], [34, 41349], [40, 41649], [45, 41969], [50, 42349], [56, 42669], [58, 43009], [61, 43129], [69, 44071], [71, 44215], [75, 44375], [84, 45015], [86, 45315], [90, 45495], [96, 45835], [99, 46035], [102, 46175], [109, 46515], [111, 46918]]}, {"verse": 7, "start": 47670, "end": 54766, "text": "Si estáis en mí, y mis palabras están en vosotros, pedid todo lo que queráis, y os será hecho.", "words": [[0, 47670], [3, 47815], [10, 48275], [13, 48475], [17, 48715], [19, 49135], [23, 49295], [32, 49755], [38, 50135], [41, 50355], [51, 51215], [57, 51775], [62, 52235], [65, 52515], [69, 52675], [78, 53215], [80, 53615], [83, 53755], [88, 54155]]}, {"verse": 8, "start": 55116, "end": 62543, "text": "En esto es glorificado mi Padre, en que llevéis mucho fruto, y seáis así mis discípulos.", "words": [[0, 55116], [3, 55279], [8, 55539], [11, 55839], [23, 56659], [26, 56819], [33, 57599], [36, 57779], [40, 57919], [48, 58459], [54, 59099], [61, 59739], [63, 60199], [69, 60699], [73, 61079], [77, 61459]]}, {"verse": 9, "start": 62893, "end": 67670, "text": "Como el Padre me amó, también yo os he amado: estad en mi amor.", "words": [[0, 62893], [5, 63075], [8, 63215], [14, 63715], [17, 63875], [22, 64435], [30, 64635], [33, 65055], [36, 65355], [39, 65635], [46, 66554], [52, 66961], [55, 67101], [58, 67241]]}, {"verse": 10, "start": 68020, "end": 77912, "text": "Si guardáis mis mandamientos, estaréis en mi amor; como yo también he guardado los mandamientos de mi Padre, y estoy en su amor.", "words": [[0, 68020], [3, 68184], [12, 68804], [16, 69144], [30, 70044], [39, 70869], [42, 71169], [45, 71369], [51, 72074], [56, 72365], [59, 72545], [67, 72885], [70, 73245], [79, 73785], [83, 73925], [96, 74665], [99, 74845], [102, 74985], [109, 75345], [111, 75865], [117, 76305], [120, 76905], [123, 77165]]}, {"verse": 11, "start": 78262, "end": 84262, "text": "Estas cosas os he hablado, para que mi gozo esté en vosotros, y vuestro gozo sea cumplido.", "words": [[0, 78262], [6, 78597], [12, 78877], [15, 79117], [18, 79297], [27, 79777], [32, 79977], [36, 80117], [39, 80317], [44, 80617], [49, 80837], [52, 81017], [62, 81657], [64, 82082], [72, 82442], [77, 82812], [81, 83182]]}, {"verse": 12, "start": 84612, "end": 90840, "text": "Este es mi mandamiento: Que os améis los unos a los otros, como yo os he amado.", "words": [[0, 84676], [5, 84776], [8, 85036], [11, 85356], [24, 86505], [28, 86589], [31, 86749], [37, 87129], [41, 87529], [46, 88029], [48, 88349], [52, 88509], [59, 89229], [64, 89429], [67, 89709], [70, 90009], [73, 90169]]}, {"verse": 13, "start": 91190, "end": 95685, "text": "Nadie tiene mayor amor que este, que ponga alguno su vida por sus amigos.", "words": [[0, 91190], [6, 91576], [12, 91876], [18, 92216], [23, 92556], [27, 92796], [33, 93076], [37, 93256], [43, 93716], [50, 94136], [53, 94256], [58, 94496], [62, 94736], [66, 94956]]}, {"verse": 14, "start": 96035, "end": 100757, "text": "Vosotros sois mis amigos, si hacéis lo que yo os mando.", "words": [[0, 96035], [9, 96556], [14, 97181], [18, 97401], [26, 98301], [29, 98561], [36, 99221], [39, 99501], [43, 99641], [46, 99881], [49, 100161]]}, {"verse": 15, "start": 101107, "end": 113237, "text": "Ya no os llamaré siervos, porque el siervo no sabe lo que hace su señor: pero os he llamado amigos, porque todas las cosas que oí de mi Padre, os he dado a conocer.", "words": [[0, 101107], [3, 101326], [6, 101586], [9, 101786], [17, 102206], [26, 103126], [33, 103506], [36, 103706], [43, 104306], [46, 104746], [51, 105206], [54, 105626], [58, 105806], [63, 106086], [66, 106326], [73, 107118], [78, 107280], [81, 107540], [84, 107660], [92, 107980], [100, 108520], [107, 109240], [113, 109500], [117, 109780], [123, 110080], [127, 110380], [130, 110620], [133, 110720], [136, 110860], [143, 111220], [146, 111900], [149, 112180], [154, 112440], [156, 112600]]}, {"verse": 16, "start": 113587, "end": 128282, "text": "No me elegisteis vosotros a mí, sino que yo os elegí a vosotros; y os he puesto para que vayáis y llevéis fruto, y vuestro fruto permanezca: para que todo lo que pidáis del Padre en mi nombre, él os lo dé.", "words": [[0, 113587], [3, 113753], [6, 113913], [17, 114873], [26, 115473], [28, 115653], [32, 116213], [37, 116573], [41, 116793], [44, 117073], [47, 117333], [53, 117933], [55, 118033], [65, 119135], [67, 119220], [70, 119305], [73, 119390], [80, 119770], [85, 120170], [89, 120350], [96, 120950], [98, 121270], [106, 121650], [113, 122670], [115, 122750], [123, 123090], [129, 123430], [141, 124547], [146, 124687], [150, 124827], [155, 125107], [158, 125307], [162, 125447], [169, 125847], [173, 126007], [179, 126467], [182, 126567], [185, 126727], [193, 127127], [196, 127607], [199, 127767], [202, 127947]]}, {"verse": 17, "start": 128632, "end": 132273, "text": "Esto os mando: Que os améis los unos a los otros.", "words": [[0, 128852], [5, 129106], [8, 129360], [15, 129767], [19, 130037], [22, 130197], [28, 130597], [32, 130817], [37, 131137], [39, 131437], [43, 131577]]}, {"verse": 18, "start": 132623, "end": 138624, "text": "Si el mundo os aborrece, sabed que a mí me aborreció antes que a vosotros.", "words": [[0, 132623], [3, 132825], [6, 133005], [12, 133385], [15, 133745], [25, 134985], [31, 135505], [35, 135705], [37, 135865], [40, 136045], [43, 136245], [53, 137025], [59, 137445], [63, 137705], [65, 137845]]}, {"verse": 19, "start": 138974, "end": 150212, "text": "Si fuerais del mundo, el mundo amaría lo suyo; pero porque no sois del mundo, antes yo os elegí del mundo, por eso os aborrece el mundo.", "words": [[0, 138974], [3, 139112], [11, 139532], [15, 139712], [22, 140572], [25, 140712], [31, 141052], [38, 141512], [41, 141692], [47, 142535], [52, 142699], [59, 143059], [62, 143259], [67, 143659], [71, 143819], [78, 144659], [84, 145199], [87, 145679], [90, 146019], [96, 146659], [100, 146779], [107, 147879], [111, 148099], [115, 148319], [118, 148679], [127, 149379], [130, 149619]]}, {"verse": 20, "start": 150562, "end": 162987, "text": "Acordaos de la palabra que yo os he dicho: No es el siervo mayor que su señor. Si a mí me han perseguido, también a vosotros perseguirán: si han guardado mi palabra, también guardarán la vuestra.", "words": [[0, 150562], [9, 151253], [12, 151393], [15, 151513], [23, 151913], [27, 152153], [30, 152433], [33, 152613], [36, 152713], [43, 153501], [46, 153667], [49, 153847], [52, 153987], [59, 154447], [65, 154727], [69, 154987], [72, 155147], [79, 156034], [82, 156210], [84, 156350], [87, 156510], [90, 156670], [94, 156850], [106, 157610], [114, 157910], [116, 158190], [125, 158670], [138, 159935], [141, 160081], [145, 160201], [154, 160681], [157, 160841], [166, 161421], [174, 161601], [184, 162281], [187, 162401]]}, {"verse": 21, "start": 163337, "end": 169367, "text": "Mas todo esto os harán por causa de mi nombre, porque no conocen al que me ha enviado.", "words": [[0, 163337], [4, 163562], [9, 163782], [14, 164202], [17, 164582], [23, 164982], [27, 165182], [33, 165522], [36, 165802], [39, 165902], [47, 166522], [54, 166962], [57, 167222], [65, 167882], [68, 168082], [72, 168282], [75, 168462], [78, 168582]]}, {"verse": 22, "start": 169717, "end": 176831, "text": "Si no hubiera venido, ni les hubiera hablado, no tendrían pecado, pero ahora no tienen excusa de su pecado.", "words": [[0, 169717], [3, 169881], [6, 170041], [14, 170401], [22, 170921], [25, 171241], [29, 171501], [37, 171921], [46, 172921], [49, 173101], [58, 173581], [66, 174261], [71, 174421], [77, 174821], [80, 175081], [87, 175341], [94, 176061], [97, 176181], [100, 176321]]}, {"verse": 23, "start": 177181, "end": 180537, "text": "El que me aborrece, también a mi Padre aborrece.", "words": [[0, 177181], [3, 177512], [7, 177652], [10, 177792], [20, 178892], [28, 179052], [30, 179272], [33, 179352], [39, 179752]]}, {"verse": 24, "start": 180887, "end": 192403, "text": "Si no hubiese hecho entre ellos obras cuales ningún otro ha hecho, no tendrían pecado; pero ahora, y las han visto, y me aborrecen a mí y a mi Padre.", "words": [[0, 180887], [3, 181210], [6, 181370], [14, 181710], [20, 182030], [26, 182270], [32, 182610], [38, 183050], [45, 183370], [52, 184130], [57, 184710], [60, 185070], [67, 186030], [70, 186250], [79, 186770], [87, 187728], [92, 188152], [99, 188852], [101, 188972], [105, 189092], [109, 189272], [116, 190132], [118, 190212], [121, 190332], [131, 190972], [133, 191132], [136, 191272], [138, 191652], [140, 191732], [143, 191832]]}, {"verse": 25, "start": 192753, "end": 198581, "text": "Pero para que se cumpla la palabra que está escrita en su ley: Que sin causa me aborrecieron.", "words": [[0, 192753], [5, 192918], [10, 193198], [14, 193338], [17, 193478], [24, 194038], [27, 194198], [35, 194638], [39, 194858], [44, 195078], [52, 195618], [55, 195738], [58, 195898], [63, 196687], [67, 196771], [71, 196971], [77, 197451], [80, 197731]]}, {"verse": 26, "start": 198931, "end": 207869, "text": "Pero cuando venga el Consolador, el cual yo os enviaré del Padre, el Espíritu de verdad, el cual procede del Padre, él dará testimonio de mí.", "words": [[0, 198931], [5, 199073], [12, 199333], [18, 199713], [21, 199833], [33, 200973], [36, 201093], [41, 201273], [44, 201553], [47, 201733], [55, 202233], [59, 202333], [66, 203213], [69, 203273], [78, 203793], [81, 203913], [89, 204673], [92, 204813], [97, 205013], [105, 205633], [109, 205773], [116, 206513], [119, 206533], [124, 206853], [135, 207453], [138, 207573]]}, {"verse": 27, "start": 208219, "end": 212877, "text": "Y vosotros daréis testimonio, porque estáis conmigo desde el principio.", "words": [[0, 208219], [2, 208340], [11, 208940], [18, 209300], [30, 210160], [37, 210380], [44, 210840], [52, 211400], [58, 211640], [61, 211880]]}]}