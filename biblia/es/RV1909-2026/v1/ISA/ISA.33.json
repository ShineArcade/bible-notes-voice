{"book": "ISA", "chapter": 33, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 235991, "verses": [{"verse": 1, "start": 300, "end": 16226, "text": "¡Ay de ti, el que saqueas, y nunca fuiste saqueado; el que haces deslealtad, bien que nadie contra ti la hizo! Cuando acabes de saquear, serás tú saqueado; y cuando acabes de hacer deslealtad, se hará contra ti.", "words": [[0, 417], [4, 567], [7, 767], [11, 1047], [14, 1307], [18, 1467], [27, 2247], [29, 2807], [35, 3027], [42, 3507], [52, 4681], [55, 4841], [59, 5001], [65, 5321], [77, 6341], [82, 6641], [86, 6861], [92, 7261], [99, 7721], [102, 8001], [105, 8181], [111, 9048], [118, 9322], [125, 9632], [128, 9752], [137, 10252], [143, 10752], [146, 11012], [156, 12099], [158, 12189], [165, 12389], [172, 12949], [175, 13069], [181, 13349], [193, 14649], [196, 14949], [201, 15209], [208, 15649]]}, {"verse": 2, "start": 16676, "end": 27326, "text": "Oh Jehová, ten misericordia de nosotros, a ti hemos esperado: tú, brazo de ellos en la mañana, sé también nuestra salvación en tiempo de la tribulación.", "words": [[0, 16971], [3, 17297], [11, 17624], [15, 17844], [28, 18924], [31, 19044], [41, 19764], [43, 19864], [46, 20064], [52, 20384], [62, 21554], [66, 21657], [72, 22077], [75, 22257], [81, 22497], [84, 22757], [87, 22877], [95, 23377], [98, 23857], [106, 24217], [114, 24517], [124, 25297], [127, 25497], [134, 25957], [137, 26157], [140, 26297]]}, {"verse": 3, "start": 27776, "end": 34153, "text": "Los pueblos huyeron a la voz del estruendo; las naciones fueron esparcidas por tus levantamientos.", "words": [[0, 27776], [4, 27882], [12, 28502], [20, 29342], [22, 29422], [25, 29502], [29, 29742], [33, 29922], [44, 30984], [48, 31248], [57, 31628], [64, 31908], [75, 32568], [79, 32768], [83, 32968]]}, {"verse": 4, "start": 34603, "end": 44451, "text": "Mas vuestra presa será cogida como cuando cogen las orugas: correrá sobre ellos como de una a otra parte corren las langostas.", "words": [[0, 34603], [4, 34891], [12, 35611], [18, 36231], [23, 36651], [30, 37251], [35, 37511], [42, 37871], [48, 38331], [52, 38847], [60, 39604], [68, 40133], [74, 40433], [80, 40813], [85, 41193], [88, 41413], [92, 41693], [94, 41913], [99, 42173], [105, 42553], [112, 43213], [116, 43433]]}, {"verse": 5, "start": 44901, "end": 51903, "text": "Será exaltado Jehová, el cual mora en las alturas: llenó a Sion de juicio y de justicia.", "words": [[0, 44901], [5, 45301], [14, 46221], [22, 46781], [25, 46941], [30, 47181], [35, 47701], [38, 47821], [42, 47961], [51, 49164], [57, 49428], [59, 49728], [64, 50028], [67, 50168], [74, 50688], [76, 50928], [79, 51048]]}, {"verse": 6, "start": 52353, "end": 61104, "text": "Y reinarán en tus tiempos la sabiduría y la ciencia, y la fuerza de la salvación: el temor de Jehová será su tesoro.", "words": [[0, 52353], [2, 52482], [11, 53262], [14, 53402], [18, 53582], [26, 54302], [29, 54582], [39, 55442], [41, 55622], [44, 55742], [53, 56422], [55, 56802], [58, 56922], [65, 57242], [68, 57502], [71, 57622], [82, 58781], [85, 59021], [91, 59361], [94, 59561], [101, 59981], [106, 60181], [109, 60461]]}, {"verse": 7, "start": 61554, "end": 67890, "text": "He aquí que sus embajadores darán voces afuera; los mensajeros de paz llorarán amargamente.", "words": [[0, 61612], [3, 61702], [8, 61942], [12, 62142], [16, 62302], [28, 63002], [34, 63422], [40, 63782], [48, 64676], [52, 64784], [63, 65424], [66, 65564], [70, 65844], [79, 66824]]}, {"verse": 8, "start": 68340, "end": 77475, "text": "Las calzadas están deshechas, cesaron los caminantes: ha anulado la alianza, aborreció las ciudades, tuvo en nada los hombres.", "words": [[0, 68340], [4, 68475], [13, 69035], [19, 69555], [30, 70075], [38, 70535], [42, 70735], [54, 71973], [57, 72257], [65, 72857], [68, 73017], [77, 74157], [87, 74757], [91, 74877], [101, 75937], [106, 76097], [109, 76337], [114, 76597], [118, 76817]]}, {"verse": 9, "start": 77925, "end": 89048, "text": "Se enlutó, enfermó la tierra: el Líbano se avergonzó, y fue cortado: se ha vuelto Sarón como desierto; y Basán y Carmelo fueron sacudidos.", "words": [[0, 77925], [3, 78147], [11, 78967], [19, 79567], [22, 79687], [30, 80639], [33, 80823], [40, 81323], [43, 81463], [54, 82343], [56, 82503], [60, 82683], [69, 83878], [72, 84003], [75, 84123], [82, 84423], [88, 84863], [93, 85083], [103, 86281], [105, 86581], [111, 87041], [113, 87221], [121, 87781], [128, 88041]]}, {"verse": 10, "start": 89348, "end": 96345, "text": "Ahora me levantaré, dice Jehová; ahora seré exaltado, ahora seré engrandecido.", "words": [[0, 89348], [6, 89624], [9, 89824], [20, 91907], [25, 92233], [33, 93226], [39, 93485], [44, 93865], [54, 94865], [60, 95085], [65, 95485]]}, {"verse": 11, "start": 97033, "end": 102678, "text": "Concebisteis hojarascas, aristas pariréis: el soplo de vuestro fuego os consumirá.", "words": [[0, 97521], [13, 98047], [25, 98574], [33, 99154], [43, 100385], [46, 100508], [52, 100888], [55, 101028], [63, 101328], [69, 101588], [72, 101888]]}, {"verse": 12, "start": 103369, "end": 108904, "text": "Y los pueblos serán como cal quemada: como espinas cortadas serán quemados con fuego.", "words": [[0, 103369], [2, 103452], [6, 103572], [14, 104052], [20, 104332], [25, 104452], [29, 104692], [38, 105914], [43, 106234], [51, 106654], [60, 107294], [66, 107734], [75, 108134], [79, 108314]]}, {"verse": 13, "start": 109628, "end": 115413, "text": "Oíd, los que estáis lejos, lo que he hecho; y vosotros los cercanos, conoced mi poder.", "words": [[0, 109628], [5, 109907], [9, 110047], [13, 110227], [20, 110567], [27, 111347], [30, 111507], [34, 111687], [37, 111847], [44, 112896], [46, 112993], [55, 113323], [59, 113653], [69, 114233], [77, 114813], [80, 114933]]}, {"verse": 14, "start": 116047, "end": 128417, "text": "Los pecadores se asombraron en Sion, espanto sobrecogió a los hipócritas. ¿Quién de nosotros morará con el fuego consumidor? ¿quién de nosotros habitará con las llamas eternas?", "words": [[0, 116047], [4, 116173], [14, 116733], [17, 116973], [28, 117713], [31, 118033], [37, 118933], [45, 119893], [56, 120853], [58, 121093], [62, 121213], [74, 122648], [81, 122949], [84, 123029], [93, 123389], [100, 123969], [104, 124169], [107, 124289], [113, 124549], [125, 125718], [132, 125996], [135, 126056], [144, 126396], [153, 127116], [157, 127276], [161, 127416], [168, 127736]]}, {"verse": 15, "start": 128767, "end": 145564, "text": "El que camina en justicia, y habla lo recto; el que aborrece la ganancia de violencias, el que sacude sus manos por no recibir cohecho, el que tapa su oreja por no oír sangres, el que cierra sus ojos por no ver cosa mala:", "words": [[0, 128767], [3, 128911], [7, 129071], [14, 129611], [17, 129731], [27, 130451], [29, 131131], [35, 131411], [38, 131671], [45, 132631], [48, 132819], [52, 132979], [61, 133799], [64, 133999], [73, 134519], [76, 134699], [88, 135799], [91, 135839], [95, 135959], [102, 136459], [106, 136639], [112, 136999], [116, 137299], [119, 137559], [127, 137979], [136, 139139], [139, 139239], [143, 139379], [148, 139639], [151, 139939], [157, 140379], [161, 140699], [164, 141039], [168, 141626], [177, 142463], [180, 142594], [184, 142734], [191, 143194], [195, 143454], [200, 143854], [204, 144214], [207, 144454], [211, 144654], [216, 144934]]}, {"verse": 16, "start": 146014, "end": 155331, "text": "Este habitará en las alturas: fortalezas de rocas serán su lugar de acogimiento; se le dará su pan, y sus aguas serán ciertas.", "words": [[0, 146014], [5, 146302], [14, 146922], [17, 147002], [21, 147142], [30, 148375], [41, 149045], [44, 149315], [50, 149585], [56, 149965], [59, 150165], [65, 150525], [68, 150685], [81, 152006], [84, 152186], [87, 152286], [92, 152606], [95, 152836], [100, 153066], [102, 153606], [106, 153766], [112, 154226], [118, 154586]]}, {"verse": 17, "start": 155781, "end": 161035, "text": "Tus ojos verán al Rey en su hermosura; verán la tierra que está lejos.", "words": [[0, 155781], [4, 155887], [9, 156207], [15, 156727], [18, 156987], [22, 157407], [25, 157587], [28, 157807], [39, 159149], [45, 159475], [48, 159615], [55, 159915], [59, 160215], [64, 160355]]}, {"verse": 18, "start": 161485, "end": 170771, "text": "Tu corazón imaginará el espanto, y dirá: ¿Qué es del escriba? ¿qué del pesador? ¿qué del que pone en lista las casas más insignes?", "words": [[0, 161485], [3, 161569], [11, 162029], [21, 163169], [24, 163249], [33, 163849], [35, 164369], [41, 165170], [46, 165274], [49, 165414], [53, 165554], [62, 166651], [67, 166733], [71, 167249], [80, 168013], [85, 168125], [89, 168275], [93, 168435], [98, 168675], [101, 168855], [107, 169115], [111, 169355], [117, 169775], [121, 170309]]}, {"verse": 19, "start": 171221, "end": 178421, "text": "No verás a aquel pueblo espantable, pueblo de lengua oscura de entender, de lengua tartamuda que no comprendas.", "words": [[0, 171221], [3, 171327], [9, 171497], [11, 171667], [17, 172007], [24, 172267], [36, 173547], [43, 173947], [46, 174147], [53, 174547], [60, 174987], [63, 175147], [73, 176107], [76, 176167], [83, 176507], [93, 177167], [97, 177307], [100, 177427]]}, {"verse": 20, "start": 178871, "end": 194331, "text": "Mira a Sion, ciudad de nuestras solemnidades: tus ojos verán a Jerusalén, morada de quietud, tienda que no será desarmada, ni serán arrancadas sus estacas, ni ninguna de sus cuerdas será rota.", "words": [[0, 178871], [5, 179176], [7, 179436], [13, 179656], [20, 180156], [23, 180536], [32, 180756], [46, 182636], [50, 182740], [55, 183140], [61, 183840], [63, 184020], [74, 185100], [81, 185480], [84, 185640], [93, 186350], [100, 187060], [104, 187280], [107, 187440], [112, 187700], [123, 188280], [126, 188860], [132, 189440], [143, 190180], [147, 190440], [156, 191580], [159, 191800], [167, 192260], [170, 192440], [174, 192620], [182, 193260], [187, 193803]]}, {"verse": 21, "start": 194781, "end": 206170, "text": "Porque ciertamente allí será Jehová para con nosotros fuerte, lugar de ríos, de arroyos muy anchos, por el cual no andará galera, ni por él pasará grande nave.", "words": [[0, 194781], [7, 195025], [19, 195985], [24, 196338], [29, 196692], [36, 197045], [41, 197265], [45, 197485], [54, 198225], [62, 198965], [68, 199305], [71, 199565], [77, 200445], [80, 200665], [88, 201145], [92, 201405], [100, 202165], [104, 202345], [107, 202445], [112, 202665], [115, 202905], [122, 203265], [130, 203985], [133, 204125], [137, 204385], [140, 204505], [147, 205005], [154, 205525]]}, {"verse": 22, "start": 206620, "end": 213949, "text": "Porque Jehová es nuestro juez, Jehová es nuestro legislador, Jehová es nuestro Rey, él mismo nos salvará.", "words": [[0, 206620], [7, 206866], [14, 207366], [17, 207506], [25, 207666], [31, 208926], [38, 209246], [41, 209306], [49, 209566], [61, 210666], [68, 211106], [71, 211226], [79, 211426], [84, 212266], [87, 212406], [93, 212806], [97, 213026]]}, {"verse": 23, "start": 214399, "end": 228274, "text": "Tus cuerdas se aflojaron; no afirmaron su mástil, ni entesaron la vela: se repartirá entonces presa de muchos despojos: los cojos arrebatarán presa.", "words": [[0, 214399], [4, 214485], [12, 215065], [15, 215205], [26, 216440], [29, 216626], [39, 217266], [42, 217526], [50, 218586], [53, 219026], [63, 219466], [66, 219666], [72, 221094], [75, 221295], [85, 222235], [94, 222875], [100, 223875], [103, 224015], [110, 224703], [120, 225879], [124, 225979], [130, 226499], [142, 227539]]}, {"verse": 24, "start": 228724, "end": 235591, "text": "No dirá el habitante: Estoy enfermo: el pueblo que more en ella será absuelto de pecado.", "words": [[0, 228724], [3, 228913], [8, 229293], [11, 229413], [22, 230575], [28, 230875], [37, 232021], [40, 232164], [47, 232584], [51, 232864], [56, 233164], [59, 233364], [64, 233524], [69, 233824], [78, 234744], [81, 234904]]}]}