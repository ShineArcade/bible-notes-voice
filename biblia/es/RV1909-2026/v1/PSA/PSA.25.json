{"book": "PSA", "chapter": 25, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 131896, "verses": [{"verse": 1, "start": 300, "end": 4455, "text": "Salmo de David. A TI, oh Jehová, levantaré mi alma.", "words": [[0, 300], [6, 776], [9, 917], [16, 1647], [18, 1788], [22, 1948], [25, 2108], [33, 3028], [43, 3608], [46, 3868]]}, {"verse": 2, "start": 4805, "end": 10566, "text": "Dios mío, en ti confío; no sea yo avergonzado, no se alegren de mí mis enemigos.", "words": [[0, 4805], [5, 4990], [10, 5510], [13, 5690], [16, 5870], [24, 6860], [27, 7123], [31, 7393], [34, 7653], [47, 8553], [50, 8773], [53, 8993], [61, 9213], [64, 9393], [67, 9613], [71, 9773]]}, {"verse": 3, "start": 10916, "end": 18594, "text": "Ciertamente ninguno de cuantos en ti esperan será confundido: serán avergonzados los que se rebelan sin causa.", "words": [[0, 10916], [12, 11639], [20, 12219], [23, 12299], [31, 12592], [34, 12886], [37, 13179], [45, 13619], [50, 13779], [62, 15123], [68, 15623], [81, 16583], [85, 16823], [89, 16983], [92, 17163], [100, 17743], [104, 17883]]}, {"verse": 4, "start": 18944, "end": 23309, "text": "Muéstrame, oh Jehová, tus caminos; enséñame tus sendas.", "words": [[0, 19293], [11, 19673], [14, 20053], [22, 20433], [26, 20633], [35, 21657], [44, 22337], [48, 22537]]}, {"verse": 5, "start": 23659, "end": 31922, "text": "Encamíname en tu verdad, y enséñame; porque tú eres el Dios de mi salvación: en ti he esperado todo el día.", "words": [[0, 23659], [11, 24283], [14, 24603], [17, 24743], [25, 25083], [27, 25643], [37, 26774], [44, 26981], [47, 27301], [52, 27541], [55, 27841], [60, 28101], [63, 28321], [66, 28461], [77, 29637], [80, 29805], [83, 30085], [86, 30345], [95, 30905], [100, 31185], [103, 31465]]}, {"verse": 6, "start": 32272, "end": 38063, "text": "Acuérdate, oh Jehová, de tus compasiones y de tus misericordias, que son perpetuas.", "words": [[0, 32272], [11, 32801], [14, 33361], [22, 33921], [25, 34101], [29, 34241], [4