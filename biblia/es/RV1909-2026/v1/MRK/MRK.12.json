{"book": "MRK", "chapter": 12, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 386550, "verses": [{"verse": 1, "start": 300, "end": 18027, "text": "Y comenzó a hablarles por parábolas: Plantó un hombre una viña, y la rodeó con una cerca, y cavó un depósito para recoger el vino, y edificó una torre, y la arrendó a agricultores arrendatarios, y se fue lejos.", "words": [[0, 300], [2, 417], [10, 1097], [12, 1297], [22, 1857], [26, 2077], [37, 3240], [44, 3804], [47, 3984], [54, 4284], [58, 4544], [64, 5104], [66, 5744], [69, 5904], [75, 6464], [79, 6644], [83, 6804], [90, 7264], [92, 7632], [97, 7999], [100, 8099], [109, 8739], [114, 8999], [122, 9559], [125, 9719], [131, 10099], [133, 10839], [141, 11519], [145, 11719], [152, 12699], [154, 13019], [157, 13139], [165, 13939], [167, 14159], [180, 15219], [195, 16771], [197, 16898], [200, 17038], [204, 17238]]}, {"verse": 2, "start": 18377, "end": 25042, "text": "Y envió un siervo a los labradores, al tiempo, para que tomase de los labradores del fruto de la viña.", "words": [[0, 18377], [2, 18498], [8, 18858], [11, 19018], [18, 19478], [20, 19578], [24, 19718], [36, 20558], [39, 20978], [47, 21498], [52, 22053], [56, 22193], [63, 22693], [66, 22833], [70, 22993], [81, 23653], [85, 23833], [91, 24253], [94, 24353], [97, 24473]]}, {"verse": 3, "start": 25392, "end": 30288, "text": "Pero ellos, tomándole, lo golpearon, y le enviaron vacío.", "words": [[0, 25392], [5, 25757], [12, 25976], [23, 27257], [26, 27377], [37, 28136], [39, 28796], [42, 28937], [51, 29457]]}, {"verse": 4, "start": 30638, "end": 38336, "text": "Y volvió a enviarles otro siervo; pero apedreándole, le hirieron en la cabeza, y lo despidieron humillado.", "words": [[0, 30638], [2, 30785], [9, 31165], [11, 31245], [21, 31725], [26, 31965], [34, 32787], [39, 32972], [53, 34352], [56, 34792], [65, 35232], [68, 35412], [71, 35552], [79, 36012], [81, 36552], [84, 36692], [96, 37372]]}, {"verse": 5, "start": 38686, "end": 46481, "text": "Y volvió a enviar otro, y a aquel mataron; y a otros muchos, hiriendo a unos y matando a otros.", "words": [[0, 38686], [2, 38815], [9, 39295], [11, 39415], [18, 39855], [24, 40184], [26, 40512], [28, 40841], [34, 41170], [43, 42237], [45, 42379], [47, 42459], [53, 42719], [61, 43539], [70, 44359], [72, 44559], [77, 44819], [79, 45179], [87, 45699], [89, 45839]]}, {"verse": 6, "start": 46831, "end": 55350, "text": "Teniendo pues aún un hijo suyo amado, lo envió también a ellos por último, diciendo: Respetarán a mi hijo.", "words": [[0, 46831], [9, 47316], [14, 47596], [18, 47876], [21, 48096], [26, 48336], [31, 48776], [38, 49516], [41, 49916], [47, 50236], [55, 50536], [57, 50836], [63, 51056], [67, 51316], [75, 52136], [85, 53439], [96, 53739], [98, 53999], [101, 54119]]}, {"verse": 7, "start": 55700, "end": 63556, "text": "Pero aquellos labradores dijeron entre sí: Este es el heredero; venid, matémosle, y la herencia será nuestra.", "words": [[0, 55700], [5, 55841], [14, 56181], [25, 57101], [33, 57641], [39, 57881], [43, 58758], [48, 58758], [51, 59012], [54, 59252], [64, 60146], [71, 60657], [82, 61457], [84, 61817], [87, 61957], [96, 62477], [101, 62797]]}, {"verse": 8, "start": 63906, "end": 68029, "text": "Y prendiéndole, le mataron, y echaron fuera de la viña.", "words": [[0, 63906], [2, 64033], [16, 64893], [19, 65153], [28, 65753], [30, 66333], [38, 66753], [44, 67033], [47, 67293], [50, 67413]]}, {"verse": 9, "start": 68379, "end": 75986, "text": "¿Qué, pues, hará el señor de la viña? Vendrá, y destruirá a estos labradores, y dará su viña a otros.", "words": [[0, 68379], [6, 68481], [12, 68801], [17, 69361], [20, 69481], [26, 69781], [29, 70021], [32, 70141], [38, 70958], [46, 71545], [48, 71725], [58, 72425], [60, 72625], [66, 72905], [78, 73725], [80, 74065], [85, 74385], [88, 74585], [93, 75025], [95, 75265]]}, {"verse": 10, "start": 76336, "end": 84548, "text": "¿Ni aun esta Escritura habéis leído: La piedra que desecharon los que edificaban, esta se ha convertido en la piedra angular;", "words": [[0, 76452], [4, 76607], [8, 76762], [13, 76917], [23, 77477], [30, 77797], [37, 78610], [40, 78715], [47, 79215], [51, 79375], [62, 80095], [66, 80295], [70, 80475], [82, 81335], [87, 81655], [90, 82095], [93, 82195], [104, 82935], [107, 83135], [110, 83275], [117, 83735]]}, {"verse": 11, "start": 84898, "end": 89137, "text": "Por el Señor es hecho esto, y es cosa maravillosa en nuestros ojos?", "words": [[0, 84898], [4, 85040], [7, 85180], [13, 85460], [16, 85680], [22, 85920], [28, 86320], [30, 86820], [33, 86980], [38, 87180], [50, 88080], [53, 88260], [62, 88500]]}, {"verse": 12, "start": 89487, "end": 99314, "text": "Y procuraban prenderle, porque entendían que decía a ellos aquella parábola; pero temían a la multitud; y dejándole, se fueron.", "words": [[0, 89487], [2, 89609], [13, 90309], [24, 91149], [31, 91869], [41, 92749], [45, 92949], [51, 93389], [53, 93689], [59, 93929], [67, 94429], [77, 95389], [82, 95675], [89, 96235], [91, 96395], [94, 96475], [104, 97465], [106, 97568], [117, 98228], [120, 98688]]}, {"verse": 13, "start": 99664, "end": 106351, "text": "Y envían a él algunos de los fariseos y de los Herodianos, para atraparlo en sus propias palabras.", "words": [[0, 99664], [2, 99807], [9, 100227], [11, 100347], [14, 100567], [22, 101027], [25, 101247], [29, 101347], [38, 101987], [40, 102107], [43, 102187], [47, 102307], [59, 103227], [64, 103647], [74, 104647], [77, 104787], [81, 104967], [89, 105487]]}, {"verse": 14, "start": 106701, "end": 122651, "text": "Y viniendo ellos, le dicen: Maestro, sabemos que eres hombre de verdad, y que no te dejas influir por nadie; porque no miras a la apariencia de hombres, antes con verdad enseñas el camino de Dios: ¿Es lícito dar tributo a César, o no? ¿Daremos, o no daremos?", "words": [[0, 106701], [2, 106881], [11, 107381], [18, 107641], [21, 107901], [28, 108706], [37, 109290], [45, 109530], [49, 109830], [54, 109990], [61, 110290], [64, 110490], [72, 110830], [74, 111045], [78, 111165], [81, 111305], [84, 111445], [90, 111705], [98, 112225], [102, 112385], [109, 113119], [116, 113303], [119, 113503], [125, 113883], [127, 113983], [130, 114083], [141, 114583], [144, 114803], [153, 115483], [159, 116003], [163, 116103], [170, 116763], [178, 117303], [181, 117403], [188, 117643], [191, 117923], [197, 118628], [201, 118773], [208, 119173], [212, 119373], [220, 119893], [222, 119953], [229, 120353], [231, 120573], [235, 121136], [245, 121681], [247, 121881], [250, 122041]]}, {"verse": 15, "start": 122931, "end": 132710, "text": "Entonces él, como entendía la hipocresía de ellos, les dijo: ¿Por qué intentáis ponerme a prueba? Traedme la moneda para que la vea.", "words": [[0, 122931], [9, 123377], [13, 123937], [18, 124117], [27, 124757], [30, 124917], [41, 125777], [44, 125957], [51, 126617], [55, 126717], [61, 127441], [66, 127566], [70, 127846], [80, 128726], [88, 129366], [90, 129506], [98, 130430], [106, 131015], [109, 131175], [116, 131595], [121, 131835], [125, 132015], [128, 132175]]}, {"verse": 16, "start": 133060, "end": 141707, "text": "Y ellos se la trajeron y les dice: ¿De quién es esta imagen y esta inscripción? Y ellos le dijeron: De César.", "words": [[0, 133060], [2, 133224], [8, 133504], [11, 133724], [14, 133824], [23, 134584], [25, 134764], [29, 134904], [35, 135783], [39, 135966], [45, 136186], [48, 136666], [53, 136966], [60, 137446], [62, 137706], [67, 137946], [80, 139217], [82, 139421], [88, 139741], [91, 140061], [100, 140965], [103, 141108]]}, {"verse": 17, "start": 141987, "end": 150743, "text": "Y respondiendo Jesús, les dijo: Dad lo que es de César a César; y lo que es de Dios, a Dios. Y se maravillaron de ello.", "words": [[0, 141987], [2, 142111], [15, 142851], [22, 143651], [26, 143751], [32, 144490], [36, 144836], [39, 145171], [43, 145331], [46, 145431], [49, 145551], [55, 146011], [57, 146231], [64, 146931], [66, 147036], [69, 147156], [73, 147316], [76, 147416], [79, 147516], [85, 147944], [87, 148373], [93, 148970], [95, 149153], [98, 149273], [111, 149973], [114, 150193]]}, {"verse": 18, "start": 151093, "end": 158654, "text": "Entonces vienen a él los saduceos, que dicen que no hay resurrección, y le preguntaron, diciendo:", "words": [[0, 151093], [9, 151491], [16, 152011], [18, 152351], [21, 152611], [25, 152931], [35, 154171], [39, 154371], [45, 154651], [49, 154891], [52, 155151], [56, 155331], [70, 156791], [72, 156891], [75, 156971], [88, 157711]]}, {"verse": 19, "start": 158854, "end": 168695, "text": "Maestro, Moisés nos escribió, que si el hermano de alguno muriese, y dejase mujer, y no dejase hijos, que su hermano tome su mujer, y dé descendencia a su hermano.", "words": [[0, 158854], [9, 159254], [16, 159614], [20, 159814], [30, 160554], [34, 161054], [37, 161234], [40, 161354], [48, 161774], [51, 161854], [58, 162254], [67, 162734], [69, 162994], [76, 163414], [83, 163754], [85, 164314], [88, 164434], [95, 164874], [102, 165574], [106, 165654], [109, 165794], [117, 166174], [122, 166414], [125, 166554], [132, 166894], [134, 167174], [137, 167294], [150, 167994], [152, 168134], [155, 168194]]}, {"verse": 20, "start": 169045, "end": 174293, "text": "Fueron siete hermanos: y el primero tomó mujer, y muriendo, no dejó descendencia;", "words": [[0, 169045], [7, 169253], [13, 169553], [23, 170507], [25, 170608], [28, 170708], [36, 171028], [41, 171408], [48, 171768], [50, 172068], [60, 172888], [63, 173068], [68, 173708]]}, {"verse": 21, "start": 174643, "end": 180781, "text": "Y la tomó el segundo, y murió, y ni aquel tampoco dejó descendencia; y el tercero, de la misma manera.", "words": [[0, 174643], [2, 174745], [5, 174805], [10, 175085], [13, 175165], [22, 175565], [24, 175905], [31, 176345], [33, 176705], [36, 176805], [42, 177105], [50, 177405], [55, 178100], [69, 178960], [71, 179021], [74, 179121], [83, 179681], [86, 179821], [89, 179941], [95, 180161]]}, {"verse": 22, "start": 181131, "end": 186747, "text": "Y la tomaron los siete, y tampoco dejaron descendencia: después de todos murió también la mujer.", "words": [[0, 181131], [2, 181248], [5, 181348], [13, 181768], [17, 181948], [24, 182308], [26, 182573], [34, 182873], [42, 183433], [56, 184560], [64, 184907], [67, 185107], [73, 185367], [79, 185847], [87, 186067], [90, 186287]]}, {"verse": 23, "start": 187097, "end": 193578, "text": "En la resurrección, pues, cuando resuciten, ¿de cuál de ellos será mujer? porque los siete la tuvieron por mujer.", "words": [[0, 187097], [3, 187239], [6, 187319], [20, 188159], [26, 188539], [33, 188779], [44, 189439], [48, 189904], [53, 190164], [56, 190364], [62, 190584], [67, 190824], [74, 191607], [81, 191808], [85, 191988], [91, 192268], [94, 192488], [103, 192868], [107, 193028]]}, {"verse": 24, "start": 193858, "end": 201762, "text": "Entonces respondiendo Jesús, les dice: ¿No erráis por eso, porque no sabéis las Escrituras, ni el poder de Dios?", "words": [[0, 193858], [9, 194650], [22, 195342], [29, 195692], [33, 196042], [39, 196806], [43, 197113], [50, 197453], [54, 197673], [59, 198293], [66, 198593], [69, 198773], [76, 199193], [80, 199353], [92, 199963], [95, 200573], [98, 200693], [104, 201073], [107, 201213]]}, {"verse": 25, "start": 202112, "end": 211546, "text": "Porque cuando resuciten de los muertos, ni se casarán, ni serán dados en casamiento, sino que son como los ángeles que están en los cielos.", "words": [[0, 202112], [7, 202336], [14, 202676], [24, 203476], [27, 203656], [31, 203776], [40, 204676], [43, 204916], [46, 205076], [55, 206036], [58, 206256], [64, 206656], [70, 206996], [73, 207296], [85, 208356], [90, 208636], [94, 208836], [98, 209076], [103, 209376], [107, 209556], [115, 210156], [119, 210316], [125, 210556], [128, 210736], [132, 210856]]}, {"verse": 26, "start": 211896, "end": 225179, "text": "Y de que los muertos hayan de resucitar, ¿no habéis leído en el libro de Moisés cómo le habló Dios en la zarza, diciendo: Yo soy el Dios de Abraham, y el Dios de Isaac, y el Dios de Jacob?", "words": [[0, 211896], [2, 212020], [5, 212140], [9, 212280], [13, 212460], [21, 213020], [27, 213580], [30, 213700], [41, 214860], [45, 215020], [52, 215480], [58, 215920], [61, 216060], [64, 216200], [70, 216460], [73, 216660], [80, 217060], [85, 217520], [88, 217720], [94, 218020], [99, 218180], [102, 218440], [105, 218980], [112, 219520], [122, 220491], [125, 220700], [129, 221020], [132, 221260], [137, 221480], [140, 221700], [149, 222160], [151, 222485], [154, 222645], [159, 222945], [162, 223205], [169, 223785], [171, 224150], [174, 224270], [179, 224470], [182, 224630]]}, {"verse": 27, "start": 225529, "end": 230555, "text": "No es Dios de muertos, sino Dios de vivos; así que vosotros mucho erráis.", "words": [[0, 225529], [3, 225695], [6, 225835], [11, 226055], [14, 226255], [23, 226935], [28, 227235], [33, 227515], [36, 227675], [43, 228351], [47, 228711], [51, 228891], [60, 229391], [66, 229791]]}, {"verse": 28, "start": 230905, "end": 241418, "text": "Y llegándose uno de los escribas, que los había oído debatir, y sabía que les había respondido bien, le preguntó: ¿Cuál es el primer mandamiento de todos?", "words": [[0, 230905], [2, 231009], [13, 231689], [17, 232049], [20, 232209], [24, 232369], [34, 233469], [38, 233549], [42, 233709], [48, 234029], [53, 234389], [62, 235089], [64, 235429], [70, 235869], [74, 235969], [78, 236129], [84, 236449], [95, 237149], [101, 237989], [104, 238149], [114, 239195], [120, 239418], [123, 239538], [126, 239658], [133, 239918], [145, 240578], [148, 240798]]}, {"verse": 29, "start": 241698, "end": 251481, "text": "Y Jesús le respondió: El primer mandamiento de todos es: Oye, Israel, el Señor nuestro Dios, el Señor uno es.", "words": [[0, 241698], [2, 241820], [8, 242220], [11, 242640], [22, 243683], [25, 243869], [32, 244189], [44, 245029], [47, 245189], [53, 245469], [57, 246374], [62, 246934], [70, 247934], [73, 248034], [79, 248394], [87, 248874], [93, 250034], [96, 250194], [102, 250534], [106, 250954]]}, {"verse": 30, "start": 251831, "end": 262559, "text": "Amarás pues al Señor tu Dios de todo tu corazón, y de toda tu alma, y de toda tu mente, y de todas tus fuerzas; este es el principal mandamiento.", "words": [[0, 251831], [7, 252373], [12, 252593], [15, 252893], [21, 253253], [24, 253613], [29, 253913], [32, 254173], [37, 254453], [40, 254693], [49, 255133], [51, 255733], [54, 255853], [59, 256053], [62, 256313], [68, 256633], [70, 256908], [73, 257028], [78, 257288], [81, 257548], [88, 257928], [90, 258448], [93, 258568], [99, 258848], [103, 259108], [112, 260128], [117, 260391], [120, 260651], [123, 260811], [133, 261391]]}, {"verse": 31, "start": 262909, "end": 270802, "text": "Y el segundo es semejante a él: Amarás a tu prójimo como a ti mismo. No hay otro mandamiento mayor que estos.", "words": [[0, 262909], [2, 263055], [5, 263175], [13, 263595], [16, 263935], [26, 264635], [28, 264835], [32, 265479], [39, 265964], [41, 266064], [44, 266204], [52, 266824], [57, 267104], [59, 267264], [62, 267384], [69, 268187], [72, 268394], [76, 268614], [81, 268874], [93, 269554], [99, 269934], [103, 270194]]}, {"verse": 32, "start": 271152, "end": 277831, "text": "Entonces el escriba le dijo: Bien, Maestro, verdad has dicho, que uno es Dios, y no hay otro fuera de él;", "words": [[0, 271152], [9, 271676], [12, 272056], [20, 272556], [23, 272676], [29, 273381], [35, 273637], [44, 274277], [51, 274617], [55, 274717], [62, 274997], [66, 275277], [70, 275477], [73, 275717], [79, 275957], [81, 276537], [84, 276677], [88, 276837], [93, 277057], [99, 277337], [102, 277577]]}, {"verse": 33, "start": 278181, "end": 289012, "text": "Y que amarle de todo corazón, y de todo entendimiento, y de toda el alma, y de todas las fuerzas, y amar al prójimo como a sí mismo, más es que todos los holocaustos y sacrificios.", "words": [[0, 278181], [2, 278286], [6, 278386], [13, 278786], [16, 278906], [21, 279086], [30, 279626], [32, 280106], [35, 280206], [40, 280406], [55, 281326], [57, 281626], [60, 281746], [65, 281906], [68, 282126], [74, 282386], [76, 282746], [79, 282866], [85, 283046], [89, 283286], [98, 283693], [100, 284099], [105, 284506], [108, 284606], [116, 285126], [121, 285346], [123, 285506], [126, 285566], [133, 286333], [137, 286570], [140, 286710], [144, 286830], [150, 287050], [154, 287310], [166, 288010], [168, 288110]]}, {"verse": 34, "start": 289292, "end": 300412, "text": "Jesús entonces, viendo que había respondido sabiamente, le dice: No estás lejos del reino de Dios. Y ya ninguno se atrevía a preguntarle.", "words": [[0, 289292], [6, 289635], [16, 291075], [23, 291515], [27, 291775], [33, 292075], [44, 292895], [56, 294055], [59, 294135], [65, 294920], [68, 295105], [74, 295345], [80, 295885], [84, 296145], [90, 296605], [93, 296805], [99, 297624], [101, 297910], [104, 298050], [112, 298590], [115, 298790], [123, 299270], [125, 299410]]}, {"verse": 35, "start": 300762, "end": 307990, "text": "Y respondiendo Jesús decía, enseñando en el templo: ¿Cómo dicen los escribas que el Cristo es hijo de David?", "words": [[0, 300762], [2, 300887], [15, 301647], [21, 301987], [28, 302887], [38, 303627], [41, 303767], [44, 303907], [52, 304894], [58, 305081], [64, 305421], [68, 305661], [77, 306281], [81, 306421], [84, 306561], [91, 306941], [94, 307141], [99, 307381], [102, 307561]]}, {"verse": 36, "start": 308340, "end": 318188, "text": "Porque el mismo David dijo por el Espíritu Santo: Dijo el Señor a mi Señor: Siéntate a mi derecha, hasta que ponga tus enemigos por estrado de tus pies.", "words": [[0, 308340], [7, 308545], [10, 308705], [16, 308985], [22, 309445], [27, 309965], [31, 310325], [34, 310465], [43, 310985], [50, 311866], [55, 312256], [58, 312456], [64, 312736], [66, 312996], [69, 313076], [76, 313907], [85, 314408], [87, 314508], [90, 314568], [99, 314988], [105, 315148], [109, 315308], [115, 315748], [119, 315888], [128, 316428], [132, 316648], [140, 317188], [143, 317348], [147, 317508]]}, {"verse": 37, "start": 318538, "end": 326223, "text": "Luego llamándole el mismo David Señor, ¿cómo, pues, es su hijo? Y la gente común lo oía con agrado.", "words": [[0, 318587], [6, 319163], [17, 319943], [20, 320283], [26, 320603], [32, 320903], [39, 321778], [46, 322058], [52, 322478], [55, 322898], [58, 323098], [64, 323814], [66, 323902], [69, 324002], [75, 324262], [81, 324602], [84, 324902], [88, 325382], [92, 325602]]}, {"verse": 38, "start": 326573, "end": 336236, "text": "Y les decía en su enseñanza: Guardaos de los escribas, que quieren andar con ropas largas, y aman los saludos en las plazas,", "words": [[0, 326573], [2, 326697], [6, 326837], [12, 327297], [15, 327477], [18, 327617], [29, 328998], [38, 329268], [41, 329448], [45, 329548], [55, 330228], [59, 330788], [67, 331148], [73, 331508], [77, 331768], [83, 332188], [91, 332888], [93, 333708], [98, 333948], [102, 334588], [110, 335208], [113, 335348], [117, 335508]]}, {"verse": 39, "start": 336586, "end": 342606, "text": "Y los asientos principales en las sinagogas, y los lugares de honor en los banquetes;", "words": [[0, 336586], [2, 336731], [6, 336851], [15, 337311], [27, 338271], [30, 338491], [34, 338651], [45, 339491], [47, 340071], [51, 340231], [59, 340611], [62, 340851], [68, 341131], [71, 341591], [75, 341731]]}, {"verse": 40, "start": 342956, "end": 351092, "text": "Que devoran las casas de las viudas, y para aparentar hacen largas oraciones. Estos recibirán mayor juicio.", "words": [[0, 342956], [4, 343039], [12, 343519], [16, 343699], [22, 344139], [25, 344239], [29, 344359], [37, 344919], [39, 345279], [44, 345519], [54, 346479], [60, 346779], [67, 347359], [78, 348544], [84, 349204], [94, 350064], [100, 350344]]}, {"verse": 41, "start": 351442, "end": 360865, "text": "Y estando sentado Jesús delante del tesoro del templo, miraba cómo el pueblo echaba dinero en el tesoro: y muchos ricos echaban mucho.", "words": [[0, 351442], [2, 351563], [10, 352123], [18, 352743], [24, 353063], [32, 353723], [36, 353963], [43, 354443], [47, 354583], [55, 355503], [62, 355923], [67, 356243], [70, 356463], [77, 356703], [84, 357223], [91, 357603], [94, 357823], [97, 357943], [105, 358888], [107, 359009], [114, 359399], [120, 359789], [128, 360229]]}, {"verse": 42, "start": 361215, "end": 368831, "text": "Y cuando vino una viuda pobre, echó dos monedas pequeñas de cobre, que equivalen a un cuadrante romano.", "words": [[0, 361215], [2, 361320], [9, 361540], [14, 361880], [18, 362120], [24, 362480], [31, 363160], [36, 363820], [40, 364180], [48, 364760], [57, 365380], [60, 365480], [67, 365980], [71, 366440], [81, 367220], [83, 367380], [86, 367500], [96, 368080]]}, {"verse": 43, "start": 369181, "end": 377976, "text": "Entonces llamando a sus discípulos, les dice: De cierto os digo que esta viuda pobre echó más que todos los que han echado en el arca:", "words": [[0, 369181], [9, 370101], [18, 370501], [20, 370581], [24, 370761], [36, 371441], [40, 371581], [46, 372526], [49, 372740], [56, 372953], [59, 373153], [64, 373493], [68, 373753], [73, 374053], [79, 374473], [85, 374853], [90, 375233], [94, 375493], [98, 375713], [104, 376033], [108, 376333], [112, 376513], [116, 376693], [123, 377113], [126, 377253], [129, 377413]]}, {"verse": 44, "start": 378326, "end": 386150, "text": "Porque todos han echado de lo que les sobra; pero esta, aun en su pobreza, echó todo lo que tenía para vivir.", "words": [[0, 378326], [7, 378570], [13, 378930], [17, 379310], [24, 379870], [27, 380330], [30, 380470], [34, 380590], [38, 380730], [45, 381659], [50, 381804], [56, 382144], [60, 382504], [63, 382704], [66, 382864], [75, 383524], [80, 384264], [85, 384604], [88, 384844], [92, 384964], [98, 385304], [103, 385524]]}]}