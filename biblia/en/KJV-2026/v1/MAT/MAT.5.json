{"book": "MAT", "chapter": 5, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 336246, "verses": [{"verse": 1, "start": 300, "end": 5606, "text": "And seeing the multitudes, he went up into a mountain: and when he was set, his disciples came to him:", "words": [[0, 300], [4, 421], [11, 661], [15, 841], [27, 1501], [30, 1661], [35, 1841], [38, 2001], [43, 2221], [45, 2381], [55, 3238], [59, 3354], [64, 3494], [67, 3634], [71, 3774], [76, 4034], [80, 4254], [90, 4714], [95, 5074], [98, 5294]]}, {"verse": 2, "start": 6056, "end": 9423, "text": "And he opened his mouth, and taught them, saying,", "words": [[0, 6056], [4, 6416], [7, 6516], [14, 6796], [18, 7056], [25, 7336], [29, 7776], [36, 8036], [42, 8396]]}, {"verse": 3, "start": 9673, "end": 13718, "text": "Blessed are the poor in spirit: for theirs is the kingdom of heaven.", "words": [[0, 9673], [8, 9857], [12, 10217], [16, 10337], [21, 10657], [24, 10957], [32, 11825], [36, 11937], [43, 12217], [46, 12477], [50, 12617], [58, 12957], [61, 13237]]}, {"verse": 4, "start": 14168, "end": 17283, "text": "Blessed are they that mourn: for they shall be comforted.", "words": [[0, 14168], [8, 14431], [12, 14771], [17, 14931], [22, 15131], [29, 15982], [33, 16081], [38, 16241], [44, 16461], [47, 16621]]}, {"verse": 5, "start": 17733, "end": 20623, "text": "Blessed are the meek: for they shall inherit the earth.", "words": [[0, 17733], [8, 17993], [12, 18273], [16, 18413], [22, 18953], [26, 19243], [31, 19383], [37, 19623], [45, 20023], [49, 20263]]}, {"verse": 6, "start": 21073, "end": 25939, "text": "Blessed are they which do hunger and thirst after righteousness: for they shall be filled.", "words": [[0, 21073], [8, 21319], [12, 21679], [17, 21879], [23, 22119], [26, 22319], [33, 22659], [37, 22939], [44, 23239], [50, 23679], [65, 24859], [69, 24946], [74, 25086], [80, 25266], [83, 25426]]}, {"verse": 7, "start": 26389, "end": 29384, "text": "Blessed are the merciful: for they shall obtain mercy.", "words": [[0, 26389], [8, 26611], [12, 26911], [16, 27031], [26, 27946], [30, 28023], [35, 28163], [41, 28363], [48, 28763]]}, {"verse": 8, "start": 29834, "end": 33251, "text": "Blessed are the pure in heart: for they shall see God.", "words": [[0, 29834], [8, 30054], [12, 30354], [16, 30454], [21, 30754], [24, 31034], [31, 31796], [35, 31922], [40, 32082], [46, 32342], [50, 32662]]}, {"verse": 9, "start": 33701, "end": 37941, "text": "Blessed are the peacemakers: for they shall be called the children of God.", "words": [[0, 33701], [8, 33984], [12, 34344], [16, 34484], [29, 35681], [33, 35763], [38, 35903], [44, 36103], [47, 36263], [54, 36543], [58, 36743], [67, 37163], [70, 37423]]}, {"verse": 10, "start": 38391, "end": 43637, "text": "Blessed are they which are persecuted for righteousness’ sake: for theirs is the kingdom of heaven.", "words": [[0, 38391], [8, 38629], [12, 38969], [17, 39149], [23, 39389], [27, 39509], [38, 40029], [42, 40389], [57, 41089], [63, 41780], [67, 41883], [74, 42143], [77, 42463], [81, 42583], [89, 42903], [92, 43143]]}, {"verse": 11, "start": 44087, "end": 51530, "text": "Blessed are you, when men shall revile you, and persecute you, and shall say all manner of evil against you falsely, for my sake.", "words": [[0, 44087], [8, 44269], [12, 44589], [17, 44869], [22, 45149], [26, 45389], [32, 45649], [39, 46169], [44, 46729], [48, 46829], [58, 47509], [63, 48129], [67, 48209], [73, 48369], [77, 48569], [81, 48809], [88, 49069], [91, 49289], [96, 49589], [104, 49929], [108, 50169], [117, 50709], [121, 50889], [124, 51049]]}, {"verse": 12, "start": 51980, "end": 59409, "text": "Rejoice, and be exceeding glad: for great is your reward in heaven: for so persecuted they the prophets which were before you.", "words": [[0, 51980], [9, 52722], [13, 52882], [16, 53042], [26, 53542], [32, 54383], [36, 54491], [42, 54751], [45, 54971], [50, 55111], [57, 55491], [60, 55691], [68, 56423], [72, 56509], [75, 56729], [86, 57209], [91, 57669], [95, 57889], [104, 58229], [110, 58569], [115, 58749], [122, 59049]]}, {"verse": 13, "start": 59859, "end": 70580, "text": "¶ You are the salt of the earth: but if the salt have lost his savour, with what shall it be salted? it is from then on good for nothing, but to be cast out, and to be trodden under foot of men.", "words": [[2, 59859], [6, 60062], [10, 60282], [14, 60422], [19, 60702], [22, 60902], [26, 61002], [33, 61652], [37, 61773], [40, 61873], [44, 62033], [49, 62313], [54, 62533], [59, 62853], [63, 63253], [71, 63653], [76, 63853], [81, 64073], [87, 64293], [90, 64433], [93, 64573], [101, 65459], [104, 65555], [107, 65695], [112, 65875], [117, 66095], [120, 66375], [125, 66595], [129, 66775], [138, 67335], [142, 67675], [145, 67795], [148, 67895], [153, 68195], [158, 68555], [162, 68875], [165, 68975], [168, 69075], [176, 69555], [182, 69775], [187, 70015], [190, 70135]]}, {"verse": 14, "start": 71030, "end": 75572, "text": "You are the light of the world. A city that is set on a hill cannot be hid.", "words": [[0, 71030], [4, 71274], [8, 71534], [12, 71654], [18, 71934], [21, 72154], [25, 72274], [32, 73121], [34, 73205], [39, 73465], [44, 73665], [47, 73825], [51, 74005], [54, 74165], [56, 74265], [61, 74525], [68, 74885], [71, 75185]]}, {"verse": 15, "start": 76022, "end": 82607, "text": "Neither do men light a lamp, and put it under a basket, but on a lampstand; and it gives light to all that are in the house.", "words": [[0, 76022], [8, 76266], [11, 76466], [15, 76706], [21, 76966], [23, 77086], [29, 77386], [33, 77766], [37, 77966], [40, 78086], [46, 78246], [48, 78406], [56, 78946], [60, 79206], [63, 79346], [65, 79786], [76, 80468], [80, 80572], [83, 80672], [89, 80872], [95, 81172], [98, 81352], [102, 81572], [107, 81732], [111, 81812], [114, 81952], [118, 82052]]}, {"verse": 16, "start": 83057, "end": 88971, "text": "Let your light so shine before men, that they may see your good works, and glorify your Father which is in heaven.", "words": [[0, 83057], [4, 83195], [9, 83425], [15, 83655], [18, 83875], [24, 84235], [31, 84495], [36, 84935], [41, 85355], [46, 85495], [50, 85635], [54, 85855], [59, 86015], [64, 86215], [71, 86835], [75, 86995], [83, 87495], [88, 87695], [95, 87975], [101, 88275], [104, 88415], [107, 88535]]}, {"verse": 17, "start": 89421, "end": 95455, "text": "¶ Think not that I am come to destroy the law, or the prophets: I am not come to destroy, but to fulfil.", "words": [[2, 89421], [8, 89569], [12, 89849], [17, 90069], [19, 90229], [22, 90309], [27, 90509], [30, 90689], [38, 91049], [42, 91249], [47, 91569], [50, 91869], [54, 92009], [64, 92998], [66, 93119], [69, 93219], [73, 93399], [78, 93659], [81, 93819], [90, 94479], [94, 94719], [97, 95094]]}, {"verse": 18, "start": 95905, "end": 105169, "text": "For indeed I say to you, Till heaven and earth pass, one jot or one tittle shall by no means pass from the law, till all be fulfilled.", "words": [[0, 95905], [4, 96099], [11, 96399], [13, 96699], [17, 96919], [20, 97139], [25, 97759], [30, 97939], [37, 98319], [41, 98679], [47, 98939], [53, 99919], [57, 100139], [61, 100439], [64, 100699], [68, 100939], [75, 101319], [81, 101559], [84, 101779], [87, 102019], [93, 102319], [98, 102699], [103, 102999], [107, 103119], [112, 103719], [117, 103899], [121, 104199], [124, 104419]]}, {"verse": 19, "start": 105619, "end": 117907, "text": "Whoever therefore shall break one of these least commandments, and shall teach men so, he shall be called the least in the kingdom of heaven: but whoever shall do and teach them, the same shall be called great in the kingdom of heaven.", "words": [[0, 105619], [8, 105834], [18, 106334], [24, 106634], [30, 106874], [34, 107114], [37, 107254], [43, 107394], [49, 107674], [63, 108714], [67, 108834], [73, 109014], [79, 109234], [83, 109474], [87, 110174], [90, 110294], [96, 110454], [99, 110574], [106, 110814], [110, 111014], [116, 111294], [119, 111534], [123, 111634], [131, 111874], [134, 112094], [142, 112842], [146, 112969], [154, 113189], [160, 113469], [163, 113749], [167, 113969], [173, 114309], [179, 115049], [183, 115149], [188, 115469], [194, 115669], [197, 115809], [204, 116109], [210, 116509], [213, 116849], [217, 116969], [225, 117209], [228, 117449]]}, {"verse": 20, "start": 118357, "end": 127466, "text": "For I say to you, That unless your righteousness shall exceed the righteousness of the scribes and Pharisees, you shall in no case enter into the kingdom of heaven.", "words": [[0, 118357], [4, 118501], [6, 118641], [10, 118881], [13, 119081], [18, 119281], [23, 119701], [30, 120001], [35, 120241], [49, 120761], [55, 121141], [62, 121621], [66, 121841], [80, 122301], [83, 122641], [87, 122781], [95, 123381], [99, 123481], [110, 124601], [114, 124681], [120, 124921], [123, 125081], [126, 125301], [131, 125621], [137, 126021], [142, 126301], [146, 126461], [154, 126761], [157, 127001]]}, {"verse": 21, "start": 127916, "end": 135143, "text": "¶ You have heard that it was said by them of old time, You shall not kill; and whoever shall kill shall be in danger of the judgment:", "words": [[2, 127916], [6, 128057], [11, 128257], [17, 128497], [22, 128697], [25, 128777], [29, 128937], [34, 129177], [37, 129417], [42, 129637], [45, 129817], [49, 130017], [55, 130757], [59, 130957], [65, 131157], [69, 131397], [75, 132276], [79, 132397], [87, 132637], [93, 132997], [98, 133337], [104, 133617], [107, 133817], [110, 133977], [117, 134277], [120, 134477], [124, 134557]]}, {"verse": 22, "start": 135593, "end": 149718, "text": "But I say to you, That whoever is angry with his brother without a cause shall be in danger of the judgment: and whoever shall say to his brother, Raca, shall be in danger of the council: but whoever shall say, You fool, shall be in danger of hell fire.", "words": [[0, 135593], [4, 135696], [6, 135836], [10, 136056], [13, 136256], [18, 136716], [23, 136996], [31, 137236], [34, 137576], [40, 137916], [45, 138136], [49, 138276], [57, 138596], [65, 138896], [67, 139036], [73, 139436], [79, 139736], [82, 139896], [85, 140056], [92, 140356], [95, 140536], [99, 140656], [109, 141551], [113, 141672], [121, 141932], [127, 142272], [131, 142512], [134, 142652], [138, 142792], [147, 143332], [153, 143872], [159, 144132], [162, 144272], [165, 144432], [172, 144732], [175, 144912], [179, 145012], [188, 145856], [192, 145960], [200, 146180], [206, 146480], [211, 147020], [215, 147300], [221, 147940], [227, 148140], [230, 148300], [233, 148420], [240, 148780], [243, 149107], [248, 149433]]}, {"verse": 23, "start": 150168, "end": 155023, "text": "Therefore if you bring your gift to the altar, and there remember that your brother has something against you;", "words": [[0, 150168], [10, 150572], [13, 150852], [17, 150972], [23, 151152], [28, 151292], [33, 151512], [36, 151692], [40, 151792], [47, 152112], [51, 152632], [57, 152772], [66, 153092], [71, 153372], [76, 153492], [84, 153732], [88, 153952], [98, 154252], [106, 154612]]}, {"verse": 24, "start": 155473, "end": 162131, "text": "Leave there your gift before the altar, and go your way; first be reconciled to your brother, and then come and offer your gift.", "words": [[0, 155473], [6, 155634], [12, 155894], [17, 156034], [22, 156274], [29, 156594], [33, 156834], [40, 157114], [44, 157454], [47, 157594], [52, 157774], [57, 158463], [63, 158614], [66, 158854], [77, 159554], [80, 159634], [85, 159754], [94, 160034], [98, 160554], [103, 160714], [108, 160994], [112, 161174], [118, 161434], [123, 161634]]}, {"verse": 25, "start": 162581, "end": 173373, "text": "Agree with your adversary quickly, while you are in the way with him; lest at any time the adversary deliver you to the judge, and the judge deliver you to the officer, and you be cast into prison.", "words": [[0, 162581], [6, 162921], [11, 163081], [16, 163201], [26, 163721], [35, 164201], [41, 164761], [45, 164901], [49, 165001], [52, 165101], [56, 165181], [60, 165341], [65, 165541], [70, 166104], [75, 166430], [78, 166610], [82, 166890], [87, 167290], [91, 167510], [101, 168110], [109, 168450], [113, 168750], [116, 168890], [120, 169010], [127, 169690], [131, 169850], [135, 169950], [141, 170210], [149, 170530], [153, 170790], [156, 170950], [160, 171070], [169, 171830], [173, 171970], [177, 172130], [180, 172230], [185, 172490], [190, 172810]]}, {"verse": 26, "start": 173823, "end": 179797, "text": "Assuredly I say to you, You shall by no means come out from there, till you have paid the uttermost farthing.", "words": [[0, 173823], [10, 174391], [12, 174511], [16, 174731], [19, 174911], [24, 175491], [28, 175671], [34, 175911], [37, 176171], [40, 176371], [46, 176691], [51, 176951], [55, 177131], [60, 177331], [67, 177871], [72, 178151], [76, 178331], [81, 178431], [86, 178631], [90, 178811], [100, 179231]]}, {"verse": 27, "start": 180247, "end": 185055, "text": "¶ You have heard that it was said by them of old time, You shall not commit adultery:", "words": [[2, 180247], [6, 180383], [11, 180583], [17, 180843], [22, 181063], [25, 181163], [29, 181303], [34, 181583], [37, 181803], [42, 182043], [45, 182263], [49, 182503], [55, 183223], [59, 183443], [65, 183663], [69, 183923], [76, 184283]]}, {"verse": 28, "start": 185505, "end": 192386, "text": "But I say to you, That whoever looks on a woman to lust after her has committed adultery with her already in his heart.", "words": [[0, 185505], [4, 185649], [6, 185829], [10, 186089], [13, 186229], [18, 186909], [23, 187229], [31, 187509], [37, 187889], [40, 188089], [42, 188189], [48, 188449], [51, 188649], [56, 188929], [62, 189269], [66, 189489], [70, 189689], [80, 190029], [89, 190569], [94, 190809], [98, 190989], [106, 191409], [109, 191689], [113, 191889]]}, {"verse": 29, "start": 192836, "end": 203490, "text": "And if your right eye offend you, pluck it out, and cast it from you: for it is profitable for you that one of your members should perish, and not that your whole body should be cast into hell.", "words": [[0, 192836], [4, 192982], [7, 193102], [12, 193242], [18, 193462], [22, 193742], [29, 194102], [34, 194702], [40, 194842], [43, 195002], [48, 195182], [52, 195542], [57, 195882], [60, 196042], [65, 196242], [70, 196880], [74, 197028], [77, 197188], [80, 197308], [91, 197768], [95, 198188], [99, 198388], [104, 198608], [108, 198848], [111, 198968], [116, 199088], [124, 199428], [131, 199708], [139, 200688], [143, 200888], [147, 201088], [152, 201288], [157, 201428], [163, 201668], [168, 202048], [175, 202288], [178, 202468], [183, 202708], [188, 203008]]}, {"verse": 30, "start": 203940, "end": 214635, "text": "And if your right hand offend you, cut it off, and cast it from you: for it is profitable for you that one of your members should perish, and not that your whole body should be cast into hell.", "words": [[0, 203940], [4, 204064], [7, 204204], [12, 204324], [18, 204544], [23, 204844], [30, 205144], [35, 205724], [39, 205864], [42, 206004], [47, 206244], [51, 206704], [56, 207004], [59, 207184], [64, 207384], [69, 208025], [73, 208173], [76, 208333], [79, 208453], [90, 208913], [94, 209333], [98, 209533], [103, 209753], [107, 209993], [110, 210113], [115, 210233], [123, 210573], [130, 210853], [138, 211833], [142, 212033], [146, 212233], [151, 212433], [156, 212573], [162, 212813], [167, 213193], [174, 213433], [177, 213613], [182, 213853], [187, 214153]]}, {"verse": 31, "start": 215085, "end": 220495, "text": "It has been said, Whoever shall put away his wife, let him give her a writing of divorcement:", "words": [[0, 215085], [3, 215201], [7, 215341], [12, 215541], [18, 216221], [26, 216581], [32, 216941], [36, 217161], [41, 217381], [45, 217601], [51, 218381], [55, 218521], [59, 218681], [64, 218881], [68, 219061], [70, 219201], [78, 219501], [81, 219701]]}, {"verse": 32, "start": 220945, "end": 231402, "text": "But I say to you, That whoever shall put away his wife, saving for the cause of fornication, causes her to commit adultery: and whoever shall marry her that is divorced commits adultery.", "words": [[0, 220945], [4, 221045], [6, 221185], [10, 221405], [13, 221605], [18, 221845], [23, 222225], [31, 222525], [37, 222825], [41, 223005], [46, 223225], [50, 223445], [56, 224225], [63, 224525], [67, 224765], [71, 224845], [77, 225145], [80, 225305], [93, 226225], [100, 226665], [104, 226885], [107, 226965], [114, 227185], [124, 228245], [128, 228352], [136, 228592], [142, 228952], [148, 229232], [152, 229432], [157, 229572], [160, 229692], [169, 230092], [177, 230572]]}, {"verse": 33, "start": 231852, "end": 239551, "text": "¶ Again, you have heard that it has been said by them of old time, You shall not forswear yourself, but shall perform to the Lord your oaths:", "words": [[2, 231852], [9, 232165], [13, 232385], [18, 232505], [24, 232765], [29, 232965], [32, 233065], [36, 233265], [41, 233465], [46, 233745], [49, 234005], [54, 234245], [57, 234425], [61, 234685], [67, 235425], [71, 235645], [77, 235865], [81, 236105], [90, 236645], [100, 237425], [104, 237545], [110, 237745], [118, 238165], [121, 238345], [125, 238485], [130, 238725], [135, 238925]]}, {"verse": 34, "start": 240001, "end": 245826, "text": "But I say to you, Swear not at all; neither by heaven; for it is God’s throne:", "words": [[0, 240001], [4, 240107], [6, 240267], [10, 240487], [13, 240667], [18, 241467], [24, 241827], [28, 242167], [31, 242367], [36, 243047], [44, 243307], [47, 243587], [55, 244420], [59, 244569], [62, 244709], [65, 244829], [71, 245249]]}, {"verse": 35, "start": 246276, "end": 253028, "text": "Nor by the earth; for it is his footstool: neither by Jerusalem; for it is the city of the great King.", "words": [[0, 246276], [4, 246462], [7, 246722], [11, 246842], [18, 247562], [22, 247900], [25, 248020], [28, 248140], [32, 248300], [43, 249412], [51, 249764], [54, 250024], [65, 251077], [69, 251227], [72, 251387], [75, 251507], [79, 251647], [84, 251947], [87, 252127], [91, 252247], [97, 252447]]}, {"verse": 36, "start": 253478, "end": 258135, "text": "Neither shall you swear by your head, because you can not make one hair white or black.", "words": [[0, 253478], [8, 253725], [14, 254065], [18, 254225], [24, 254465], [27, 254705], [32, 254885], [38, 255325], [46, 255745], [50, 255892], [54, 256038], [58, 256185], [63, 256485], [67, 256765], [72, 256965], [78, 257285], [81, 257525]]}, {"verse": 37, "start": 258585, "end": 264876, "text": "But let your communication be, Yes, yes; No, no: for whatever is more than these comes of evil.", "words": [[0, 258585], [4, 258690], [8, 258830], [13, 258990], [27, 259490], [31, 260250], [36, 260570], [41, 261329], [45, 261722], [49, 262398], [53, 262510], [62, 262810], [65, 263130], [70, 263350], [75, 263550], [81, 263890], [87, 264210], [90, 264430]]}, {"verse": 38, "start": 265326, "end": 270277, "text": "¶ You have heard that it has been said, An eye for an eye, and a tooth for a tooth:", "words": [[2, 265326], [6, 265443], [11, 265603], [17, 265823], [22, 265983], [25, 266103], [29, 266283], [34, 266503], [40, 267243], [43, 267403], [47, 267643], [51, 267863], [54, 267983], [59, 268383], [63, 268663], [65, 268763], [71, 269533], [75, 269733], [77, 269833]]}, {"verse": 39, "start": 270527, "end": 277297, "text": "But I say to you, That you resist not evil: but whoever shall strike you on your right cheek, turn to him the other also.", "words": [[0, 270527], [4, 270631], [6, 270771], [10, 270991], [13, 271191], [18, 271631], [23, 271771], [27, 271931], [34, 272311], [38, 272611], [44, 273440], [48, 273538], [56, 273798], [62, 274118], [69, 274478], [73, 274658], [76, 274778], [81, 274898], [87, 275098], [94, 275698], [99, 276018], [102, 276198], [106, 276298], [110, 276478], [116, 276658]]}, {"verse": 40, "start": 277746, "end": 283093, "text": "And if any man will sue you at the law, and take away your coat, let him have your cloak also.", "words": [[0, 277746], [4, 277888], [7, 278008], [11, 278208], [15, 278508], [20, 278708], [24, 278968], [28, 279128], [31, 279288], [35, 279368], [40, 279968], [44, 280248], [49, 280468], [54, 280668], [59, 280848], [65, 281548], [69, 281708], [73, 281828], [78, 282008], [83, 282148], [89, 282428]]}, {"verse": 41, "start": 283542, "end": 286501, "text": "And whoever shall compel you to go a mile, go with him two.", "words": [[0, 283542], [4, 283642], [12, 283882], [18, 284162], [25, 284582], [29, 284682], [32, 284782], [35, 284922], [37, 285042], [43, 285682], [46, 285762], [51, 285962], [55, 286247]]}, {"verse": 42, "start": 286951, "end": 292175, "text": "Give to him that asks you, and from him that would borrow of you turn not you away.", "words": [[0, 286951], [5, 287118], [8, 287338], [12, 287558], [17, 287778], [22, 288158], [27, 288718], [31, 289018], [36, 289198], [40, 289478], [45, 289778], [51, 289918], [58, 290278], [61, 290518], [65, 290898], [70, 291058], [74, 291338], [78, 291598]]}, {"verse": 43, "start": 292625, "end": 297002, "text": "¶ You have heard that it has been said, You shall love your neighbour, and hate your enemy.", "words": [[2, 292625], [6, 292769], [11, 292969], [17, 293189], [22, 293389], [25, 293529], [29, 293689], [34, 293869], [40, 294609], [44, 294789], [50, 295009], [55, 295289], [60, 295529], [71, 295769], [75, 296189], [80, 296369], [85, 296569]]}, {"verse": 44, "start": 297452, "end": 307549, "text": "But I say to you, Love your enemies, bless them that curse you, do good to them that hate you, and pray for them which despitefully use you, and persecute you;", "words": [[0, 297452], [4, 297554], [6, 297694], [10, 297934], [13, 298114], [18, 298674], [23, 298914], [28, 299174], [37, 300034], [43, 300334], [48, 300694], [53, 300954], [59, 301254], [64, 301974], [67, 302134], [72, 302394], [75, 302554], [80, 302794], [85, 302974], [90, 303214], [95, 303834], [99, 303934], [104, 304174], [108, 304354], [113, 304574], [119, 304794], [132, 305514], [136, 305814], [141, 306469], [145, 306574], [155, 307274]]}, {"verse": 45, "start": 307999, "end": 318722, "text": "That you may be the children of your Father which is in heaven: for he makes his sun to rise on the evil and on the good, and sends rain on the just and on the unjust.", "words": [[0, 307999], [5, 308150], [9, 308330], [13, 308530], [16, 308730], [20, 308870], [29, 309230], [32, 309430], [37, 309570], [44, 309930], [50, 310230], [53, 310390], [56, 310530], [64, 312130], [68, 312242], [71, 312382], [77, 312622], [81, 312922], [85, 313222], [88, 313402], [93, 313762], [96, 313982], [100, 314102], [105, 314442], [109, 314902], [112, 315042], [116, 315182], [122, 315722], [126, 316122], [132, 316382], [137, 316782], [140, 316982], [144, 317102], [149, 317382], [153, 317822], [156, 318042], [160, 318142]]}, {"verse": 46, "start": 319172, "end": 324984, "text": "For if you love them which love you, what reward have you? do not even the tax collectors the same?", "words": [[0, 319172], [4, 319345], [7, 319545], [11, 319705], [16, 319985], [21, 320205], [27, 320465], [32, 320745], [37, 321345], [42, 321445], [49, 321825], [54, 322145], [59, 322807], [62, 322891], [66, 323071], [71, 323271], [75, 323451], [79, 323751], [90, 324231], [94, 324471]]}, {"verse": 47, "start": 325434, "end": 331172, "text": "And if you salute your brethren only, what do you more than others? do not even the tax collectors so?", "words": [[0, 325434], [4, 325636], [7, 325776], [11, 325896], [18, 326196], [23, 326396], [32, 326696], [38, 327516], [43, 327656], [46, 327816], [50, 327916], [55, 328176], [60, 328336], [68, 329290], [71, 329389], [75, 329549], [80, 329769], [84, 329949], [88, 330319], [99, 330689]]}, {"verse": 48, "start": 331622, "end": 335846, "text": "Be therefore perfect, even as your Father which is in heaven is perfect.", "words": [[0, 331622], [3, 331783], [13, 332103], [22, 332903], [27, 333263], [30, 333483], [35, 333603], [42, 334123], [48, 334243], [51, 334403], [54, 334523], [61, 335063], [64, 335163]]}]}