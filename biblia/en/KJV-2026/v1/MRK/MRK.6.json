{"book": "MRK", "chapter": 6, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 422283, "verses": [{"verse": 1, "start": 300, "end": 5167, "text": "And he went out from there, and came into his own country; and his disciples follow him.", "words": [[0, 300], [4, 424], [7, 504], [12, 664], [16, 844], [21, 1084], [28, 1364], [32, 1724], [37, 1964], [42, 2244], [46, 2484], [50, 2644], [59, 3550], [63, 3710], [67, 3830], [77, 4330], [84, 4770]]}, {"verse": 2, "start": 5617, "end": 19710, "text": "And when the sabbath day was come, he began to teach in the synagogue: and many hearing him were astonished, saying, From from where has this man these things? and what wisdom is this which is given to him, that even such mighty works are wrought by his hands?", "words": [[0, 5617], [4, 5737], [9, 5877], [13, 5997], [21, 6317], [25, 6637], [29, 6837], [35, 7417], [38, 7517], [44, 7857], [47, 8037], [53, 8297], [56, 8477], [60, 8577], [71, 9581], [75, 9727], [80, 9967], [88, 10287], [92, 10527], [97, 10727], [109, 11467], [117, 12805], [122, 12805], [127, 12973], [133, 13493], [137, 13693], [142, 13853], [146, 14033], [152, 14253], [160, 15083], [164, 15206], [169, 15346], [176, 15646], [179, 15886], [184, 16046], [190, 16246], [193, 16386], [199, 16566], [202, 16786], [207, 16986], [212, 17366], [217, 17526], [222, 17746], [229, 18086], [235, 18366], [239, 18586], [247, 18846], [250, 19006], [254, 19186]]}, {"verse": 3, "start": 20160, "end": 29916, "text": "Is not this the carpenter, the son of Mary, the brother of James, and Joses, and of Juda, and Simon? and are not his sisters here with us? And they were offended at him.", "words": [[0, 20160], [3, 20287], [7, 20467], [12, 20747], [16, 20907], [27, 21707], [31, 21767], [35, 22007], [38, 22087], [44, 22687], [48, 22727], [56, 22967], [59, 23147], [66, 23467], [70, 23767], [77, 24067], [81, 24447], [84, 24657], [90, 24867], [94, 25227], [101, 26086], [105, 26207], [109, 26327], [113, 26547], [117, 26767], [125, 27127], [130, 27387], [135, 27587], [139, 28264], [143, 28463], [148, 28623], [153, 28862], [162, 29263], [165, 29543]]}, {"verse": 4, "start": 30366, "end": 39083, "text": "But Jesus said to them, A prophet is not without honour, but in his own country, and among his own kin, and in his own house.", "words": [[0, 30366], [4, 30646], [10, 30966], [15, 31366], [18, 31566], [24, 32823], [26, 32924], [34, 33264], [37, 33484], [41, 33684], [49, 34224], [57, 34764], [61, 35064], [64, 35204], [68, 35364], [72, 35544], [81, 36384], [85, 36584], [91, 36804], [95, 37084], [99, 37284], [104, 37904], [108, 38024], [111, 38164], [115, 38364], [119, 38524]]}, {"verse": 5, "start": 39433, "end": 45522, "text": "And he could there do no mighty work, save that he laid his hands upon a few sick folk, and healed them.", "words": [[0, 39433], [4, 39569], [7, 39689], [13, 39949], [19, 40169], [22, 40389], [25, 40609], [32, 40929], [38, 41669], [43, 41969], [48, 42209], [51, 42329], [56, 42529], [60, 42729], [66, 43049], [71, 43349], [73, 43569], [77, 43729], [82, 43989], [88, 44749], [92, 44809], [99, 45089]]}, {"verse": 6, "start": 45972, "end": 50815, "text": "And he marvelled because of their unbelief. And he went round about the villages, teaching.", "words": [[0, 45972], [4, 46117], [7, 46507], [17, 46897], [25, 47117], [28, 47337], [34, 47477], [44, 48563], [48, 48685], [51, 48765], [56, 48945], [62, 49205], [68, 49445], [72, 49645], [82, 50345]]}, {"verse": 7, "start": 51265, "end": 58620, "text": "¶ And he called to him the twelve, and began to send them forth by two and two; and gave them power over unclean spirits;", "words": [[2, 51265], [6, 51374], [9, 51474], [16, 51674], [19, 51874], [23, 51994], [27, 52134], [35, 52414], [39, 53154], [45, 53414], [48, 53614], [53, 53834], [58, 54014], [64, 54334], [67, 54654], [71, 54914], [75, 55094], [80, 55800], [84, 56080], [89, 56280], [94, 56480], [100, 56860], [105, 57160], [113, 57840]]}, {"verse": 8, "start": 59070, "end": 67024, "text": "And commanded them that they should take nothing for their journey, save a staff only; no bag, no bread, no money in their purse:", "words": [[0, 59070], [4, 59192], [14, 59652], [19, 59952], [24, 60152], [29, 60332], [36, 60472], [41, 60732], [49, 61112], [53, 61432], [59, 61592], [68, 62312], [73, 62612], [75, 62752], [81, 63092], [87, 64063], [90, 64267], [95, 64967], [98, 65087], [105, 65687], [108, 65827], [114, 66107], [117, 66307], [123, 66447]]}, {"verse": 9, "start": 67474, "end": 71134, "text": "But be shod with sandals; and not put on two coats.", "words": [[0, 67474], [4, 67591], [7, 67771], [12, 68131], [17, 68311], [26, 69416], [30, 69563], [34, 69783], [38, 70043], [41, 70203], [45, 70443]]}, {"verse": 10, "start": 71584, "end": 77922, "text": "And he said to them, In what place soever you enter into a house, there abide till you depart from that place.", "words": [[0, 71584], [4, 71721], [7, 71801], [12, 72001], [15, 72221], [21, 72891], [24, 73022], [29, 73202], [35, 73522], [42, 74002], [46, 74202], [52, 74542], [57, 74842], [59, 75002], [66, 75622], [72, 75742], [78, 76142], [83, 76402], [87, 76542], [94, 76882], [99, 77142], [104, 77362]]}, {"verse": 11, "start": 78372, "end": 92491, "text": "And whoever shall not receive you, nor hear you, when you depart from there, shake off the dust under your feet for a testimony against them. Assuredly I say to you, It shall be more tolerable for Sodom and Gomorrha in the day of judgment, than for that city.", "words": [[0, 78372], [4, 78514], [12, 78774], [18, 79114], [22, 79294], [30, 79674], [35, 80234], [39, 80514], [44, 80814], [49, 81074], [54, 81294], [58, 81414], [65, 81694], [70, 81934], [77, 82614], [83, 82834], [87, 83014], [91, 83174], [96, 83434], [102, 83634], [107, 83814], [112, 84054], [116, 84274], [118, 84394], [128, 84734], [136, 85154], [142, 85856], [152, 86459], [154, 86580], [158, 86780], [161, 87000], [166, 87599], [169, 87800], [175, 88020], [178, 88179], [183, 88400], [193, 89040], [197, 89220], [203, 89700], [207, 90010], [216, 90319], [219, 90459], [223, 90560], [227, 90760], [230, 90860], [240, 91239], [245, 91679], [249, 91840], [254, 92040]]}, {"verse": 12, "start": 92841, "end": 95979, "text": "And they went out, and preached that men should repent.", "words": [[0, 92841], [4, 92987], [9, 93087], [14, 93327], [19, 93607], [23, 94087], [32, 94407], [37, 94747], [41, 95027], [48, 95307]]}, {"verse": 13, "start": 96429, "end": 101642, "text": "And they cast out many demons, and anointed with oil many that were sick, and healed them.", "words": [[0, 96429], [4, 96553], [9, 96633], [14, 96953], [18, 97153], [23, 97433], [31, 97953], [35, 98353], [44, 98733], [49, 98973], [53, 99333], [58, 99693], [63, 99933], [68, 100053], [74, 100393], [78, 100913], [85, 101193]]}, {"verse": 14, "start": 102092, "end": 113072, "text": "And king Herod heard of him; (for his name was spread abroad:) and he said, That John the Baptist was risen from the dead, and therefore mighty works do show forth themselves in him.", "words": [[0, 102092], [4, 102530], [9, 102790], [15, 103250], [21, 103470], [24, 103650], [29, 104320], [34, 104448], [38, 104628], [43, 104948], [47, 105128], [54, 105448], [63, 106368], [67, 106628], [70, 106788], [76, 107542], [81, 107660], [86, 107900], [90, 108040], [98, 108380], [102, 108700], [108, 109020], [113, 109260], [117, 109400], [123, 109660], [127, 110120], [137, 110520], [144, 110920], [150, 111300], [153, 111600], [158, 111860], [164, 112140], [175, 112520], [178, 112800]]}, {"verse": 15, "start": 113422, "end": 121174, "text": "Others said, That it is Elias. And others said, That it is a prophet, or as one of the prophets.", "words": [[0, 113422], [7, 113651], [13, 114449], [18, 114589], [21, 114709], [24, 114889], [31, 116139], [35, 116297], [42, 116537], [48, 118490], [53, 118649], [56, 118789], [59, 118949], [61, 119069], [70, 119489], [73, 119829], [76, 120049], [80, 120249], [83, 120349], [87, 120469]]}, {"verse": 16, "start": 121524, "end": 127127, "text": "But when Herod heard of it, he said, It is John, whom I beheaded: he is risen from the dead.", "words": [[0, 121524], [4, 121625], [9, 121805], [15, 122165], [21, 122365], [24, 122525], [28, 122725], [31, 122825], [37, 124225], [40, 124321], [43, 124441], [49, 124661], [54, 124881], [56, 125021], [66, 125829], [69, 125943], [72, 126083], [78, 126383], [83, 126583], [87, 126763]]}, {"verse": 17, "start": 127477, "end": 137185, "text": "For Herod himself had sent forth and laid hold upon John, and bound him in prison for Herodias’ sake, his brother Philip’s wife: for he had married her.", "words": [[0, 127477], [4, 127605], [10, 128045], [18, 128345], [22, 128785], [27, 129025], [33, 129385], [37, 129705], [42, 129945], [47, 130225], [52, 130565], [58, 131025], [62, 131405], [68, 131745], [72, 131985], [75, 132105], [82, 132445], [86, 132725], [96, 133465], [102, 134225], [106, 134345], [114, 134605], [123, 135165], [129, 135956], [133, 136085], [136, 136285], [140, 136445], [148, 136765]]}, {"verse": 18, "start": 137635, "end": 142306, "text": "For John had said to Herod, It is not lawful for you to have your brother’s wife.", "words": [[0, 137635], [4, 137747], [9, 138087], [13, 138327], [18, 138547], [21, 138727], [28, 139572], [31, 139694], [34, 139854], [38, 140094], [45, 140614], [49, 140794], [53, 140974], [56, 141094], [61, 141294], [66, 141434], [76, 141914]]}, {"verse": 19, "start": 142656, "end": 147784, "text": "Therefore Herodias had a quarrel against him, and would have killed him; but she could not:", "words": [[0, 142656], [10, 143134], [19, 143714], [23, 143894], [25, 143994], [33, 144494], [41, 144774], [46, 145054], [50, 145494], [56, 145674], [61, 145794], [68, 146094], [73, 146823], [77, 146947], [81, 147107], [87, 147267]]}, {"verse": 20, "start": 148234, "end": 157480, "text": "For Herod feared John, knowing that he was a just man and a holy, and observed him; and when he heard him, he did many things, and heard him gladly.", "words": [[0, 148234], [4, 148361], [10, 148761], [17, 149021], [23, 149481], [31, 149901], [36, 150141], [39, 150261], [43, 150401], [45, 150541], [50, 150741], [54, 151141], [58, 151361], [60, 151461], [66, 151761], [70, 152181], [79, 152541], [84, 153373], [88, 153539], [93, 153699], [96, 153879], [102, 154119], [107, 154559], [110, 154659], [114, 154879], [119, 155219], [127, 155739], [131, 156199], [137, 156659], [141, 156839]]}, {"verse": 21, "start": 157930, "end": 166088, "text": "And when a convenient day was come, that Herod on his birthday made a supper to his lords, high captains, and chief estates of Galilee;", "words": [[0, 157930], [4, 158053], [9, 158193], [11, 158293], [22, 158713], [26, 159053], [30, 159273], [36, 160113], [41, 160293], [47, 160713], [50, 160853], [54, 161013], [63, 161413], [68, 161733], [70, 161873], [77, 162133], [80, 162373], [84, 162553], [91, 163373], [96, 163533], [106, 164473], [110, 164533], [116, 164773], [124, 165273], [127, 165393]]}, {"verse": 22, "start": 166538, "end": 176911, "text": "And when the daughter of the said Herodias came in, and danced, and pleased Herod and them that sat with him, the king said to the girl, Ask of me whatever you will, and I will give it you.", "words": [[0, 166538], [4, 166656], [9, 166796], [13, 166916], [22, 167196], [25, 167396], [29, 167496], [34, 167696], [43, 168296], [48, 168576], [52, 168876], [56, 169076], [64, 169496], [68, 169716], [76, 170016], [82, 170516], [86, 170656], [91, 170836], [96, 171056], [100, 171276], [105, 171536], [110, 172196], [114, 172276], [119, 172496], [124, 172776], [127, 172956], [131, 173056], [137, 174472], [141, 174698], [144, 174838], [147, 174998], [156, 175278], [160, 175598], [166, 175838], [170, 176098], [172, 176258], [177, 176378], [182, 176538], [185, 176658]]}, {"verse": 23, "start": 177261, "end": 182518, "text": "And he swore to her, Whatever you shall ask of me, I will give it you, to the half of my kingdom.", "words": [[0, 177261], [4, 177387], [7, 177527], [13, 177907], [16, 178047], [21, 178594], [30, 178872], [34, 179092], [40, 179272], [44, 179532], [47, 179672], [51, 180172], [53, 180312], [58, 180472], [63, 180672], [66, 180792], [71, 181052], [74, 181392], [78, 181552], [83, 181712], [86, 181872], [89, 182032]]}, {"verse": 24, "start": 182868, "end": 191074, "text": "And she went forth, and said to her mother, What shall I ask? And she said, The head of John the Baptist.", "words": [[0, 182868], [4, 183001], [8, 183141], [13, 183341], [20, 183701], [24, 184081], [29, 184281], [32, 184441], [36, 184561], [44, 185255], [49, 185428], [55, 185628], [57, 185848], [62, 187044], [66, 187147], [70, 187307], [76, 188887], [80, 188993], [85, 189233], [88, 189393], [93, 189693], [97, 189853]]}, {"verse": 25, "start": 191424, "end": 200530, "text": "And she came in immediately with haste to the king, and asked, saying, I will that you give me immediately in a platter the head of John the Baptist.", "words": [[0, 191424], [4, 191557], [8, 191697], [13, 191917], [16, 192117], [28, 192537], [33, 192897], [39, 193477], [42, 193617], [46, 193737], [52, 194017], [56, 194637], [63, 195117], [71, 196441], [73, 196561], [78, 196761], [83, 197001], [87, 197101], [92, 197341], [95, 197521], [107, 198061], [110, 198341], [112, 198421], [120, 198781], [124, 199001], [129, 199221], [132, 199321], [137, 199581], [141, 199761]]}, {"verse": 26, "start": 200880, "end": 207975, "text": "And the king was exceeding sorry; yet for his oath’s sake, and for their sakes which sat with him, he would not reject her.", "words": [[0, 200880], [4, 201014], [8, 201134], [13, 201374], [17, 201654], [27, 202234], [34, 203120], [38, 203228], [42, 203468], [46, 203648], [53, 204128], [59, 204648], [63, 204728], [67, 204888], [73, 205048], [79, 205468], [85, 205688], [89, 205988], [94, 206248], [99, 206768], [102, 206848], [108, 206988], [112, 207148], [119, 207528]]}, {"verse": 27, "start": 208425, "end": 215938, "text": "And immediately the king sent an executioner, and commanded his head to be brought: and he went and beheaded him in the prison,", "words": [[0, 208425], [4, 208571], [16, 208931], [20, 209351], [25, 209611], [30, 209991], [33, 210151], [46, 211011], [50, 211411], [60, 211911], [64, 212191], [69, 212491], [72, 212651], [75, 212811], [84, 213659], [88, 213999], [91, 214139], [96, 214359], [100, 214539], [109, 214919], [113, 215159], [116, 215279], [120, 215379]]}, {"verse": 28, "start": 216388, "end": 221705, "text": "And brought his head in a platter, and gave it to the girl: and the girl gave it to her mother.", "words": [[0, 216388], [4, 216510], [12, 216730], [16, 216970], [21, 217270], [24, 217410], [26, 217510], [35, 217970], [39, 218430], [44, 218690], [47, 218830], [50, 218990], [54, 219110], [60, 219912], [64, 220021], [68, 220141], [73, 220441], [78, 220701], [81, 220881], [84, 221021], [88, 221181]]}, {"verse": 29, "start": 222155, "end": 227545, "text": "And when his disciples heard of it, they came and took up his corpse, and laid it in a tomb.", "words": [[0, 222155], [4, 222277], [9, 222437], [13, 222617], [23, 223117], [29, 223437], [32, 223597], [36, 224157], [41, 224297], [46, 224597], [50, 224837], [55, 225017], [58, 225197], [62, 225357], [70, 225797], [74, 226297], [79, 226517], [82, 226677], [85, 226877], [87, 226997]]}, {"verse": 30, "start": 227995, "end": 235599, "text": "And the apostles gathered themselves together to Jesus, and told him all things, both what they had done, and what they had taught.", "words": [[0, 227995], [4, 228120], [8, 228220], [17, 228640], [26, 229160], [37, 229660], [46, 230180], [49, 230400], [56, 230800], [60, 231360], [65, 231620], [69, 231800], [73, 232020], [81, 232880], [86, 233120], [91, 233380], [96, 233600], [100, 233780], [106, 234060], [110, 234600], [115, 234780], [120, 234980], [124, 235140]]}, {"verse": 31, "start": 236049, "end": 245798, "text": "And he said to them, Come yourselves apart into a desert place, and rest a while: for there were many coming and going, and they had no leisure so much as to eat.", "words": [[0, 236049], [4, 236196], [7, 236296], [12, 236556], [15, 236756], [21, 237436], [26, 237594], [37, 238014], [43, 238494], [48, 238894], [50, 239094], [57, 239334], [64, 239694], [68, 240394], [73, 240667], [75, 240941], [82, 241529], [86, 241627], [92, 241787], [97, 241947], [102, 242247], [109, 242547], [113, 242807], [120, 243447], [124, 243707], [129, 243827], [133, 243987], [136, 244187], [144, 244547], [147, 244847], [152, 245107], [155, 245267], [158, 245427]]}, {"verse": 32, "start": 246248, "end": 249355, "text": "And they departed into a desert place by ship privately.", "words": [[0, 246248], [4, 246371], [9, 246491], [18, 246871], [23, 247211], [25, 247411], [32, 247671], [38, 248051], [41, 248291], [46, 248571]]}, {"verse": 33, "start": 249805, "end": 257931, "text": "And the people saw them departing, and many knew him, and ran afoot there out of all cities, and outwent them, and came together to him.", "words": [[0, 249805], [4, 249951], [8, 250031], [15, 250271], [19, 250611], [24, 250811], [35, 251731], [39, 251971], [44, 252211], [49, 252451], [54, 253071], [58, 253331], [62, 253621], [68, 253911], [74, 254171], [78, 254391], [81, 254511], [85, 254671], [93, 255411], [97, 255651], [105, 255891], [111, 256411], [115, 256591], [120, 256851], [129, 257311], [132, 257551]]}, {"verse": 34, "start": 258381, "end": 268413, "text": "And Jesus, when he came out, saw much people, and was moved with compassion toward them, because they were as sheep not having a shepherd: and he began to teach them many things.", "words": [[0, 258381], [4, 258530], [11, 258890], [16, 259170], [19, 259290], [24, 259490], [29, 259810], [33, 260410], [38, 260710], [46, 261090], [50, 261630], [54, 261810], [60, 262150], [65, 262390], [76, 262930], [83, 263270], [89, 263650], [97, 264070], [102, 264290], [107, 264450], [110, 264610], [116, 264870], [120, 265170], [127, 265530], [129, 265670], [139, 266472], [143, 266595], [146, 266655], [152, 266915], [155, 267095], [161, 267295], [166, 267515], [171, 267735]]}, {"verse": 35, "start": 268863, "end": 276577, "text": "And when the day was now far spent, his disciples came to him, and said, This is a desert place, and now the time is far passed:", "words": [[0, 268863], [4, 268992], [9, 269132], [13, 269292], [17, 269512], [21, 269752], [25, 269952], [29, 270292], [36, 271052], [40, 271152], [50, 271632], [55, 271972], [58, 272192], [63, 272352], [67, 272552], [73, 273243], [78, 273455], [81, 273615], [83, 273755], [90, 274115], [97, 274935], [101, 275055], [105, 275175], [109, 275315], [114, 275575], [117, 275735], [121, 276175]]}, {"verse": 36, "start": 277027, "end": 283874, "text": "Send them away, that they may go into the country round about, and into the villages, and buy themselves bread: for they have nothing to eat.", "words": [[0, 277027], [5, 277225], [10, 277385], [16, 277645], [21, 278125], [26, 278265], [30, 278365], [33, 278605], [38, 278785], [42, 278925], [50, 279205], [56, 279485], [63, 279765], [67, 280225], [72, 280405], [76, 280525], [86, 280865], [90, 281325], [94, 281545], [105, 281825], [112, 282750], [116, 282872], [121, 283032], [126, 283212], [134, 283452], [137, 283652]]}, {"verse": 37, "start": 284224, "end": 292547, "text": "He answered and said to them, You give them something to eat. And they say to him, Shall we go and buy two hundred denarii worth of bread, and give them to eat?", "words": [[0, 284224], [3, 284316], [12, 284696], [16, 284936], [21, 285176], [24, 285376], [30, 285964], [34, 286063], [39, 286243], [44, 286423], [54, 286763], [57, 286983], [62, 287763], [66, 287900], [71, 288020], [75, 288240], [78, 288420], [83, 289035], [89, 289151], [92, 289271], [95, 289451], [99, 289551], [103, 289811], [107, 290071], [115, 290331], [123, 290591], [129, 290831], [132, 290991], [139, 291231], [143, 291671], [148, 291851], [153, 292011], [156, 292171]]}, {"verse": 38, "start": 292897, "end": 301145, "text": "He says to them, How many loaves have you? go and see. And when they knew, they say, Five, and two fishes.", "words": [[0, 292897], [3, 292987], [8, 293187], [11, 293407], [17, 294058], [21, 294220], [26, 294460], [33, 295020], [38, 295240], [43, 295965], [46, 296109], [50, 296289], [55, 297178], [59, 297311], [64, 297451], [69, 297631], [75, 298331], [80, 298511], [85, 299292], [91, 299513], [95, 299692], [99, 299852]]}, {"verse": 39, "start": 301495, "end": 306139, "text": "And he commanded them to make all sit down by companies upon the green grass.", "words": [[0, 301495], [4, 301633], [7, 301733], [17, 302233], [22, 302533], [25, 302693], [30, 302893], [34, 303253], [38, 303553], [43, 303873], [46, 304113], [56, 304573], [61, 304913], [65, 305173], [71, 305373]]}, {"verse": 40, "start": 306589, "end": 310190, "text": "And they sat down in ranks, by hundreds, and by fifties.", "words": [[0, 306589], [4, 306829], [9, 306969], [13, 307249], [18, 307549], [21, 307729], [28, 308089], [31, 308489], [41, 308889], [45, 309309], [48, 309509]]}, {"verse": 41, "start": 310640, "end": 323437, "text": "And when he had taken the five loaves and the two fishes, he looked up to heaven, and blessed, and broke the loaves, and gave them to his disciples to set before them; and the two fishes divided he among them all.", "words": [[0, 310640], [4, 310766], [9, 310926], [12, 311166], [16, 311326], [22, 311626], [26, 311846], [31, 312126], [38, 312646], [42, 312746], [46, 312886], [50, 313066], [58, 313906], [61, 314066], [68, 314286], [71, 314506], [74, 314686], [82, 314986], [86, 315386], [95, 315746], [99, 316266], [105, 316546], [109, 316766], [117, 317648], [121, 317774], [126, 318014], [131, 318234], [134, 318434], [138, 318634], [148, 319194], [151, 319494], [155, 319734], [162, 320074], [168, 320857], [172, 320987], [176, 321107], [180, 321327], [187, 321667], [195, 322247], [198, 322527], [204, 322827], [209, 323067]]}, {"verse": 42, "start": 323887, "end": 326160, "text": "And they did all eat, and were filled.", "words": [[0, 323887], [4, 324031], [9, 324151], [13, 324351], [17, 324611], [22, 324911], [26, 325411], [31, 325551]]}, {"verse": 43, "start": 326610, "end": 330576, "text": "And they took up twelve baskets full of the fragments, and of the fishes.", "words": [[0, 326610], [4, 326737], [9, 326857], [14, 327037], [17, 327287], [24, 327537], [32, 328137], [37, 328477], [40, 328597], [44, 328737], [55, 329157], [59, 329677], [62, 329777], [66, 329917]]}, {"verse": 44, "start": 331026, "end": 334767, "text": "And they that did eat of the loaves were about five thousand men.", "words": [[0, 331026], [4, 331165], [9, 331305], [14, 331525], [18, 331765], [22, 332065], [25, 332225], [29, 332365], [36, 332825], [41, 333045], [47, 333438], [52, 333832], [61, 334225]]}, {"verse": 45, "start": 335217, "end": 343701, "text": "And immediately he constrained his disciples to get into the ship, and to go to the other side before to Bethsaida, while he sent away the people.", "words": [[0, 335217], [4, 335354], [16, 335754], [19, 336194], [31, 336654], [35, 336914], [45, 337454], [48, 337654], [52, 337834], [57, 338014], [61, 338194], [67, 338494], [71, 339014], [74, 339154], [77, 339294], [80, 339454], [84, 339614], [90, 339774], [95, 340114], [102, 340394], [105, 340654], [116, 341754], [122, 342434], [125, 342594], [130, 342814], [135, 343054], [139, 343214]]}, {"verse": 46, "start": 344151, "end": 348124, "text": "And when he had sent them away, he departed into a mountain to pray.", "words": [[0, 344151], [4, 344281], [9, 344441], [12, 344641], [16, 344821], [21, 345061], [26, 345281], [32, 346081], [35, 346201], [44, 346581], [49, 346921], [51, 347121], [60, 347421], [63, 347682]]}, {"verse": 47, "start": 348574, "end": 353823, "text": "And when even was come, the ship was in the midst of the sea, and he alone on the land.", "words": [[0, 348574], [4, 348914], [9, 349074], [14, 349414], [18, 349714], [24, 350454], [28, 350574], [33, 350794], [37, 351034], [40, 351194], [44, 351294], [50, 351534], [53, 351734], [57, 351854], [62, 352274], [66, 352394], [69, 352574], [75, 352954], [78, 353194], [82, 353334]]}, {"verse": 48, "start": 354273, "end": 363756, "text": "And he saw them toiling in rowing; for the wind was contrary to them: and about the fourth watch of the night he comes to them, walking upon the sea, and would have passed by them.", "words": [[0, 354273], [4, 354378], [7, 354498], [11, 354738], [16, 354938], [24, 355288], [27, 355638], [35, 356526], [39, 356631], [43, 356751], [48, 356991], [52, 357171], [61, 357691], [64, 358031], [70, 358730], [74, 358846], [80, 359046], [84, 359206], [91, 359466], [97, 359806], [100, 359966], [104, 360066], [110, 360266], [113, 360406], [119, 360666], [122, 360886], [128, 361206], [136, 361406], [141, 361666], [145, 361926], [150, 362406], [154, 362506], [160, 362666], [165, 362766], [172, 363086], [175, 363366]]}, {"verse": 49, "start": 364206, "end": 369548, "text": "But when they saw him walking upon the sea, they supposed it had been a spirit, and cried out:", "words": [[0, 364206], [4, 364352], [9, 364512], [14, 364672], [18, 364932], [22, 365112], [30, 365432], [35, 365752], [39, 366012], [44, 366732], [49, 366892], [58, 367292], [61, 367532], [65, 367672], [70, 367852], [72, 367972], [80, 368632], [84, 368752], [90, 369052]]}, {"verse": 50, "start": 369998, "end": 379430, "text": "For they all saw him, and were troubled. And immediately he talked with them, and says to them, Be of good cheer: it is I; be not afraid.", "words": [[0, 369998], [4, 370082], [9, 370222], [13, 370402], [17, 370662], [22, 370942], [26, 371262], [31, 371402], [41, 372241], [45, 372363], [57, 372723], [60, 373123], [67, 373403], [72, 373623], [78, 373863], [82, 374223], [87, 374483], [90, 374703], [96, 375873], [99, 376009], [102, 376149], [107, 376349], [114, 377254], [117, 377376], [120, 377596], [123, 378522], [126, 378600], [130, 378780]]}, {"verse": 51, "start": 379780, "end": 387450, "text": "And he went up to them into the ship; and the wind ceased: and they were greatly amazed in themselves beyond measure, and wondered.", "words": [[0, 379780], [4, 379908], [7, 380008], [12, 380188], [15, 380348], [18, 380508], [23, 380708], [28, 380908], [32, 381068], [38, 381775], [42, 381923], [46, 382043], [51, 382303], [59, 383356], [63, 383481], [68, 383621], [73, 383781], [81, 384141], [88, 384681], [91, 384961], [102, 385421], [109, 385961], [118, 386541], [122, 386821]]}, {"verse": 52, "start": 387900, "end": 392240, "text": "For they considered not the miracle of the loaves: for their heart was hardened.", "words": [[0, 387900], [4, 388011], [9, 388151], [20, 388611], [24, 388911], [28, 389111], [36, 389471], [39, 389711], [43, 389831], [51, 390796], [55, 390905], [61, 391065], [67, 391365], [71, 391605]]}, {"verse": 53, "start": 392690, "end": 397534, "text": "And when they had passed over, they came into the land of Gennesaret, and drew to the shore.", "words": [[0, 392690], [4, 392835], [9, 392975], [14, 393175], [18, 393295], [25, 393595], [31, 394415], [36, 394515], [41, 394755], [46, 395015], [50, 395175], [55, 395455], [58, 395875], [70, 396295], [74, 396515], [79, 396715], [82, 396875], [86, 397015]]}, {"verse": 54, "start": 397984, "end": 402151, "text": "And when they were come out of the ship, immediately they knew him,", "words": [[0, 397984], [4, 398110], [9, 398250], [14, 398430], [19, 398550], [24, 398730], [28, 398930], [31, 399050], [35, 399190], [41, 399750], [53, 400270], [58, 400690], [63, 400910]]}, {"verse": 55, "start": 402601, "end": 409081, "text": "And ran through that whole region round about, and began to carry about in beds those that were sick, where they heard he was.", "words": [[0, 402601], [4, 402721], [8, 402961], [16, 403201], [21, 403401], [27, 403621], [34, 403981], [40, 404261], [47, 404621], [51, 405121], [57, 405381], [60, 405561], [66, 405821], [72, 406081], [75, 406261], [80, 406521], [86, 406861], [91, 407101], [96, 407241], [102, 407581], [108, 408001], [113, 408181], [119, 408421], [122, 408601]]}, {"verse": 56, "start": 409531, "end": 421883, "text": "And wherever he entered, into villages, or cities, or country, they laid the sick in the streets, and besought him that they might touch if it were but the border of his garment: and as many as touched him were made whole.", "words": [[0, 409531], [4, 409653], [13, 409953], [16, 410253], [25, 410633], [30, 410973], [40, 411433], [43, 411733], [51, 412073], [54, 412433], [63, 413473], [68, 413593], [73, 413833], [77, 414033], [82, 414273], [85, 414453], [89, 414553], [98, 415461], [102, 415590], [111, 416010], [115, 416210], [120, 416390], [125, 416550], [131, 416750], [137, 417230], [140, 417370], [143, 417510], [148, 417830], [152, 417910], [156, 418050], [163, 418330], [166, 418550], [170, 418670], [179, 419613], [183, 419747], [186, 419867], [191, 420107], [194, 420307], [202, 420607], [206, 420867], [211, 421087], [216, 421347]]}]}