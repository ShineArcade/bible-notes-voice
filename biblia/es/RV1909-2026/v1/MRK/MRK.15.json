{"book": "MRK", "chapter": 15, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 340977, "verses": [{"verse": 1, "start": 300, "end": 13349, "text": "Y luego por la mañana, habiendo tenido consejo los principales sacerdotes con los ancianos, y con los escribas, y con todo el concilio, llevaron a Jesús atado, y le entregaron a Pilato.", "words": [[0, 300], [2, 444], [8, 664], [12, 924], [15, 1044], [23, 2144], [32, 2644], [39, 2984], [47, 3624], [51, 3744], [63, 4464], [74, 5364], [78, 5584], [82, 5744], [92, 6404], [94, 6544], [98, 6724], [102, 6864], [112, 7664], [114, 8024], [118, 8264], [123, 8524], [126, 8684], [136, 9749], [145, 10249], [147, 10349], [153, 10609], [160, 11753], [162, 11862], [165, 11982], [176, 12662], [178, 12742]]}, {"verse": 2, "start": 13699, "end": 20441, "text": "Y Pilato le preguntó: ¿Eres tú el Rey de los judíos? Y respondiendo él, le dijo: Tú lo dices.", "words": [[0, 13699], [2, 13823], [9, 14283], [12, 14443], [22, 15384], [28, 15571], [31, 15871], [34, 16051], [38, 16271], [41, 16331], [45, 16471], [53, 17459], [55, 17585], [68, 18365], [72, 18605], [75, 18745], [81, 19466], [84, 19593], [87, 19733]]}, {"verse": 3, "start": 20791, "end": 23722, "text": "Y los principales sacerdotes le acusaban mucho.", "words": [[0, 20791], [2, 20867], [6, 20987], [18, 21787], [29, 22547], [32, 22707], [41, 23207]]}, {"verse": 4, "start": 24072, "end": 29944, "text": "Y le preguntó otra vez Pilato, diciendo: ¿No respondes algo? Mira de cuántas cosas te acusan.", "words": [[0, 24072], [2, 24159], [5, 24279], [14, 24839], [19, 25019], [23, 25259], [31, 25739], [41, 26660], [45, 26866], [55, 27426], [61, 28113], [66, 28296], [69, 28496], [77, 29236], [83, 29236], [86, 29376]]}, {"verse": 5, "start": 30224, "end": 35050, "text": "Pero Jesús ni aun con eso respondió; de modo que Pilato se maravillaba.", "words": [[0, 30224], [5, 30390], [11, 31002], [14, 31135], [18, 31375], [22, 31675], [26, 32015], [37, 32870], [40, 33015], [45, 33175], [49, 33395], [56, 33875], [59, 34075]]}, {"verse": 6, "start": 35400, "end": 39677, "text": "Pero en el día de la fiesta les soltaba un preso, el que pidiesen.", "words": [[0, 35400], [5, 35645], [8, 35785], [11, 35905], [15, 36125], [18, 36285], [21, 36425], [28, 36675], [32, 36925], [40, 37465], [43, 37645], [50, 38115], [53, 38585], [57, 39156]]}, {"verse": 7, "start": 40027, "end": 49137, "text": "Y había uno, que se llamaba Barrabás, preso con sus compañeros de motín que habían cometido asesinato durante una revuelta.", "words": [[0, 40027], [2, 40170], [8, 40330], [13, 40790], [17, 40970], [20, 41130], [28, 41670], [38, 42970], [44, 43530], [48, 43710], [52, 43910], [63, 44710], [66, 44810], [72, 45310], [76, 45770], [83, 46050], [92, 46750], [102, 47630], [110, 47950], [114, 48290]]}, {"verse": 8, "start": 49487, "end": 54824, "text": "Y viniendo la multitud, comenzó a pedir hiciese como siempre les había hecho.", "words": [[0, 49487], [2, 49633], [11, 50113], [14, 50253], [24, 50893], [32, 51793], [34, 51853], [40, 52153], [48, 52813], [53, 53073], [61, 53733], [65, 53873], [71, 54273]]}, {"verse": 9, "start": 55174, "end": 59965, "text": "Y Pilato les respondió, diciendo: ¿Queréis que os suelte al Rey de los judíos?", "words": [[0, 55174], [2, 55321], [9, 55821], [13, 56061], [24, 56741], [34, 57715], [43, 58036], [47, 58196], [50, 58336], [57, 58676], [60, 58836], [64, 59056], [67, 59116], [71, 59236]]}, {"verse": 10, "start": 60245, "end": 65371, "text": "Porque conocía que por envidia le habían entregado los principales sacerdotes.", "words": [[0, 60245], [7, 60469], [15, 61129], [19, 61269], [23, 61529], [31, 62149], [34, 62269], [41, 62609], [51, 63309], [55, 63449], [67, 64309]]}, {"verse": 11, "start": 65721, "end": 72394, "text": "Pero los principales sacerdotes incitaron a la multitud, que les soltase antes a Barrabás.", "words": [[0, 65721], [5, 66041], [9, 66221], [21, 67001], [32, 67941], [42, 68981], [44, 69081], [47, 69161], [57, 69821], [61, 70281], [65, 70461], [73, 71041], [79, 71401], [81, 71939]]}, {"verse": 12, "start": 72744, "end": 78254, "text": "Y respondiendo Pilato, les dice otra vez: ¿Qué pues queréis que haga del que llamáis Rey de los judíos?", "words": [[0, 72744], [2, 73180], [15, 73650], [23, 74110], [27, 74290], [32, 74510], [37, 74750], [42, 75470], [47, 75592], [52, 75772], [60, 76192], [64, 76352], [69, 76532], [73, 76692], [77, 76852], [85, 77232], [89, 77412], [92, 77552], [96, 77672]]}, {"verse": 13, "start": 78534, "end": 81480, "text": "Y ellos volvieron a gritar: Crucifícale.", "words": [[0, 78534], [2, 78715], [8, 79055], [18, 79695], [20, 79795], [28, 80658]]}, {"verse": 14, "start": 81760, "end": 87748, "text": "Pero Pilato les decía: ¿Pues qué mal ha hecho? Y ellos daban más voces: Crucifícale.", "words": [[0, 81760], [5, 81964], [12, 82504], [16, 82744], [23, 83757], [29, 83898], [33, 84028], [37, 84158], [40, 84453], [47, 84969], [49, 85132], [55, 85462], [61, 85792], [65, 86294], [72, 86926]]}, {"verse": 15, "start": 88028, "end": 97890, "text": "Y Pilato, queriendo satisfacer al pueblo, les soltó a Barrabás, y entregó a Jesús, después de azotarle, para que fuese crucificado.", "words": [[0, 88028], [2, 88154], [10, 88734], [20, 89234], [31, 89974], [34, 90154], [42, 91154], [46, 91294], [52, 91954], [54, 92174], [64, 92854], [66, 93354], [74, 93834], [76, 93934], [83, 94294], [91, 95034], [94, 95454], [104, 95874], [109, 96354], [113, 96494], [119, 96834]]}, {"verse": 16, "start": 98240, "end": 105700, "text": "Entonces los soldados le llevaron dentro de la sala, es decir, al Pretorio; y reunieron a toda la compañía.", "words": [[0, 98240], [9, 99256], [13, 99436], [22, 99806], [25, 100176], [34, 100576], [41, 100916], [44, 101176], [47, 101296], [53, 101676], [56, 101816], [63, 102256], [66, 102336], [76, 103280], [78, 103406], [88, 104046], [90, 104226], [95, 104466], [98, 104686]]}, {"verse": 17, "start": 106050, "end": 111099, "text": "Y le visten de púrpura; y poniéndole una corona tejida de espinas,", "words": [[0, 106050], [2, 106159], [5, 106259], [12, 106679], [15, 106899], [24, 108019], [26, 108123], [37, 108963], [41, 109163], [48, 109583], [55, 110123], [58, 110263]]}, {"verse": 18, "start": 111449, "end": 115393, "text": "Comenzaron luego a saludarle: ¡Salve, Rey de los judíos!", "words": [[0, 111449], [11, 112013], [17, 112293], [19, 112553], [30, 113666], [38, 114091], [42, 114391], [45, 114491], [49, 114611]]}, {"verse": 19, "start": 115673, "end": 122630, "text": "Y le herían en la cabeza con una caña, y escupían en él, y se arrodillaban ante él en burla.", "words": [[0, 115673], [2, 115835], [5, 115975], [12, 116455], [15, 116635], [18, 116775], [25, 117255], [29, 117535], [33, 117735], [39, 118255], [41, 118715], [50, 119335], [53, 119515], [57, 119855], [59, 120475], [62, 120635], [75, 121415], [80, 121735], [83, 121935], [86, 122035]]}, {"verse": 20, "start": 122980, "end": 132087, "text": "Y cuando se hubieron burlado de él, le quitaron el manto púrpura, y le vistieron sus propios vestidos, y le sacaron para crucificarle.", "words": [[0, 122980], [2, 123086], [9, 123306], [12, 123546], [21, 123826], [29, 124366], [32, 124586], [36, 125266], [39, 125426], [48, 125926], [51, 126066], [57, 126446], [66, 127206], [68, 127646], [71, 127746], [81, 128246], [85, 128526], [93, 129061], [103, 129641], [105, 130021], [108, 130121], [116, 130601], [121, 130861]]}, {"verse": 21, "start": 132437, "end": 141911, "text": "Y cargaron a uno que pasaba, Simón cireneo, padre de Alejandro y de Rufo, que venía del campo, para que llevase su cruz.", "words": [[0, 132437], [2, 132832], [11, 133261], [13, 133481], [17, 133662], [21, 133842], [29, 134402], [35, 135261], [44, 136122], [50, 136421], [53, 136682], [63, 137342], [65, 137562], [68, 137662], [74, 138701], [78, 138842], [84, 139316], [88, 139791], [95, 140266], [100, 140426], [104, 140706], [112, 140986], [115, 141266]]}, {"verse": 22, "start": 142261, "end": 148518, "text": "Y le llevan al lugar de Gólgota, que traducido significa: Lugar de la Calavera.", "words": [[0, 142261], [2, 142498], [5, 142758], [12, 143138], [15, 143338], [21, 143678], [24, 144238], [33, 144798], [37, 145038], [47, 145778], [58, 147053], [64, 147356], [67, 147636], [70, 147756]]}, {"verse": 23, "start": 148868, "end": 153379, "text": "Y le dieron a beber vino mezclado con mirra; pero él no lo tomó.", "words": [[0, 148868], [2, 148973], [5, 149073], [12, 149433], [14, 149573], [20, 149793], [25, 150073], [34, 150693], [38, 151164], [45, 151809], [50, 151972], [53, 152392], [56, 152732], [59, 152892]]}, {"verse": 24, "start": 153729, "end": 161289, "text": "Y cuando le hubieron crucificado, repartieron sus vestidos, echando suertes sobre ellos, qué llevaría cada uno.", "words": [[0, 153729], [2, 153837], [9, 154097], [12, 154417], [21, 154797], [34, 156117], [46, 156817], [50, 157057], [60, 158017], [68, 158427], [76, 158837], [82, 159197], [89, 159937], [93, 160037], [102, 160537], [107, 160737]]}, {"verse": 25, "start": 161639, "end": 165475, "text": "Y era la tercera hora del día cuando le crucificaron.", "words": [[0, 161639], [2, 161824], [6, 162024], [9, 162164], [17, 162804], [22, 163184], [26, 163464], [30, 163724], [37, 164024], [40, 164264]]}, {"verse": 26, "start": 165825, "end": 170629, "text": "Y el título escrito de su causa era: EL REY DE LOS JUDÍOS.", "words": [[0, 165825], [2, 165971], [5, 166111], [12, 166711], [20, 167151], [23, 167471], [26, 167631], [32, 167971], [37, 168823], [40, 169011], [44, 169411], [47, 169611], [51, 169751]]}, {"verse": 27, "start": 170979, "end": 177129, "text": "Y crucificaron con él dos ladrones, uno a su derecha, y el otro a su izquierda.", "words": [[0, 170979], [2, 171127], [15, 172047], [19, 172247], [22, 172447], [26, 172787], [36, 173947], [40, 174227], [42, 174387], [45, 174507], [54, 175207], [56, 175487], [59, 175627], [64, 175887], [66, 176107], [69, 176287]]}, {"verse": 28, "start": 177479, "end": 182358, "text": "Y se cumplió la Escritura, que dice: Y con los inicuos fue contado.", "words": [[0, 177479], [2, 177585], [5, 177705], [13, 178205], [16, 178345], [27, 178905], [31, 179085], [37, 179924], [39, 180164], [43, 180344], [47, 180744], [55, 181144], [59, 181544]]}, {"verse": 29, "start": 182708, "end": 191790, "text": "Y los que pasaban lo insultaban, meneando sus cabezas, y diciendo: ¡Ah! tú que derribas el templo de Dios, y en tres días lo edificas,", "words": [[0, 182708], [2, 182825], [6, 182965], [10, 183125], [18, 183725], [21, 183905], [33, 185145], [42, 185845], [46, 186045], [55, 186965], [57, 187145], [67, 188049], [72, 188645], [75, 188726], [79, 188826], [88, 189226], [91, 189346], [98, 189706], [101, 189766], [107, 190046], [109, 190386], [112, 190486], [117, 190646], [122, 190866], [125, 191066]]}, {"verse": 30, "start": 192140, "end": 194419, "text": "Sálvate a ti mismo, y desciende de la cruz.", "words": [[0, 192140], [8, 192509], [10, 192669], [13, 192709], [20, 193049], [22, 193449], [32, 193869], [35, 193989], [38, 194089]]}, {"verse": 31, "start": 194699, "end": 205859, "text": "Y de esta manera también los principales sacerdotes burlándose de él, decían unos a otros, con los escribas: A otros salvó, a sí mismo no se puede salvar.", "words": [[0, 194699], [2, 194866], [5, 194966], [10, 195206], [17, 195546], [25, 195986], [29, 196186], [41, 196906], [52, 197706], [63, 198601], [66, 198801], [70, 199461], [77, 200121], [82, 200426], [84, 200826], [91, 201226], [95, 201786], [99, 202006], [109, 203162], [111, 203346], [117, 203566], [124, 204026], [126, 204206], [129, 204286], [135, 204686], [138, 204846], [141, 205026], [147, 205226]]}, {"verse": 32, "start": 206209, "end": 214788, "text": "El Cristo, Rey de Israel, descienda ahora de la cruz, para que veamos y creamos. También los que estaban crucificados con él lo insultaban.", "words": [[0, 206209], [3, 206328], [11, 206668], [15, 206968], [18, 207068], [26, 207488], [36, 208348], [42, 208568], [45, 208708], [48, 208828], [54, 209368], [59, 209668], [63, 209828], [70, 210248], [72, 210548], [81, 211348], [89, 211613], [93, 211813], [97, 211953], [105, 212213], [118, 213113], [122, 213353], [125, 213553], [128, 213813]]}, {"verse": 33, "start": 215138, "end": 221860, "text": "Y cuando vino la sexta hora del día, fueron hechas tinieblas sobre toda la tierra hasta la novena hora.", "words": [[0, 215138], [2, 215222], [9, 215402], [14, 215722], [17, 215922], [23, 216342], [28, 216522], [32, 216722], [37, 217082], [44, 217602], [51, 218122], [61, 218782], [67, 219222], [72, 219562], [75, 219782], [82, 220162], [88, 220822], [91, 221022], [98, 221462]]}, {"verse": 34, "start": 222210, "end": 233301, "text": "Y a la novena hora, exclamó Jesús a gran voz, diciendo: Eloi, Eloi, ¿lama sabachthani? que declarado, quiere decir: Dios mío, Dios mío, ¿por qué me has desamparado?", "words": [[0, 222210], [2, 222373], [4, 222453], [7, 222553], [14, 223053], [20, 223353], [28, 224193], [34, 224413], [36, 224693], [41, 224853], [46, 225113], [56, 226084], [62, 226586], [68, 227089], [74, 227591], [87, 228257], [91, 228589], [102, 228959], [109, 229219], [116, 230210], [121, 230487], [126, 231007], [131, 231107], [136, 231627], [141, 231747], [145, 231927], [148, 232087], [152, 232267]]}, {"verse": 35, "start": 233651, "end": 239407, "text": "Y oyéndole unos de los que estaban allí, decían: He aquí, llama a Elías.", "words": [[0, 233651], [2, 233834], [11, 234314], [16, 234794], [19, 235014], [23, 235174], [27, 235334], [35, 235674], [41, 236534], [49, 237698], [52, 237788], [58, 238028], [64, 238428], [66, 238728]]}, {"verse": 36, "start": 239687, "end": 249879, "text": "Y corrió uno, y empapando una esponja en vinagre, y poniéndola en una caña, le dio a beber, diciendo: Dejad, veamos si vendrá Elías a quitarle.", "words": [[0, 239687], [2, 239831], [9, 240271], [14, 240671], [16, 240871], [26, 241491], [30, 241691], [38, 242371], [41, 242491], [50, 243351], [52, 243671], [63, 244351], [66, 244551], [70, 244711], [76, 245551], [79, 245711], [83, 245931], [85, 246231], [92, 246531], [102, 247683], [109, 248041], [116, 248441], [119, 248621], [126, 248901], [132, 249261], [134, 249341]]}, {"verse": 37, "start": 250159, "end": 255044, "text": "Pero Jesús, dando una grande voz, exhaló su último aliento.", "words": [[0, 250159], [5, 250303], [12, 251183], [18, 251483], [22, 251763], [29, 252103], [34, 253023], [41, 253603], [44, 253763], [51, 254203]]}, {"verse": 38, "start": 255394, "end": 260547, "text": "Entonces el velo del templo se rasgó en dos, de alto a bajo.", "words": [[0, 255394], [9, 256121], [12, 256501], [17, 256841], [21, 257001], [28, 257761], [31, 257901], [37, 258421], [40, 258601], [45, 259301], [48, 259541], [53, 259897], [55, 260253]]}, {"verse": 39, "start": 260897, "end": 271165, "text": "Y el centurión que estaba delante de él, viendo que había exhalado su último aliento dando aquel grito, dijo: Verdaderamente este hombre era el Hijo de Dios.", "words": [[0, 260897], [2, 261018], [5, 261158], [15, 261758], [19, 261918], [26, 262218], [34, 262698], [37, 262878], [41, 263238], [48, 264138], [52, 264358], [58, 264638], [67, 265378], [70, 265578], [77, 265998], [85, 266478], [91, 266818], [97, 267178], [104, 267558], [110, 268240], [125, 269119], [130, 269499], [137, 269819], [141, 270159], [144, 270339], [149, 270539], [152, 270679]]}, {"verse": 40, "start": 271445, "end": 282245, "text": "Y también estaban algunas mujeres mirando de lejos; entre las cuales estaban María Magdalena, y María la madre de Jacobo el menor y de José, y Salomé;", "words": [[0, 271445], [2, 271574], [10, 271854], [18, 272354], [26, 272654], [34, 273174], [42, 273714], [45, 273894], [52, 274770], [58, 275037], [62, 275217], [69, 275597], [77, 276357], [83, 276857], [94, 277757], [96, 278177], [102, 278517], [105, 278697], [111, 278977], [114, 279397], [121, 279817], [124, 279937], [130, 280337], [132, 280617], [135, 280717], [141, 281097], [143, 281617]]}, {"verse": 41, "start": 282595, "end": 292451, "text": "Las cuales, estando aún él en Galilea, le habían seguido, y le servían; y otras muchas que juntamente con él habían subido a Jerusalén.", "words": [[0, 282595], [4, 282740], [12, 283400], [20, 283980], [24, 284160], [27, 284560], [30, 284820], [39, 286180], [42, 286280], [49, 286500], [58, 287160], [60, 287400], [63, 287520], [72, 288528], [74, 288608], [80, 288808], [87, 289208], [91, 289428], [102, 290068], [106, 290328], [109, 290568], [116, 290968], [123, 291528], [125, 291608]]}, {"verse": 42, "start": 292801, "end": 299180, "text": "Y cuando fue la tarde, porque era la preparación, es decir, la víspera del sábado,", "words": [[0, 292801], [2, 292906], [9, 293106], [13, 293346], [16, 293486], [23, 294146], [30, 294646], [34, 294966], [37, 295126], [50, 296286], [53, 296506], [60, 297666], [63, 297806], [71, 298366], [75, 298526]]}, {"verse": 43, "start": 299530, "end": 311673, "text": "José de Arimatea, miembro respetado del Consejo, que también esperaba el reino de Dios, vino, y se presentó con valentía ante Pilato, y pidió el cuerpo de Jesús.", "words": [[0, 299530], [5, 299841], [8, 300121], [18, 301061], [26, 301521], [36, 302221], [40, 302401], [49, 303541], [53, 303641], [61, 303961], [70, 304521], [73, 304661], [79, 305041], [82, 305201], [88, 305461], [94, 306621], [96, 306861], [99, 307001], [108, 307581], [112, 307781], [121, 308661], [126, 309001], [134, 309641], [136, 310041], [142, 310381], [145, 310501], [152, 310761], [155, 311021]]}, {"verse": 44, "start": 312023, "end": 319063, "text": "Y Pilato se maravilló que ya fuese muerto; y haciendo venir al centurión, le preguntó si era ya muerto.", "words": [[0, 312023], [2, 312167], [9, 312647], [12, 312867], [22, 313447], [26, 313567], [29, 313707], [35, 314007], [43, 314832], [45, 314978], [54, 315438], [60, 315758], [63, 315978], [74, 317118], [77, 317318], [86, 317878], [89, 318058], [93, 318238], [96, 318398]]}, {"verse": 45, "start": 319413, "end": 323032, "text": "Y enterado del centurión, dio el cuerpo a José:", "words": [[0, 319413], [2, 319580], [11, 320220], [15, 320670], [26, 321120], [30, 321570], [33, 322020], [40, 322380], [42, 322580]]}, {"verse": 46, "start": 323382, "end": 335427, "text": "El cual compró una sábana, y quitándole, le envolvió en la sábana: y le puso en un sepulcro excavado en una roca; y hizo rodar una piedra a la puerta del sepulcro.", "words": [[0, 323382], [3, 323546], [8, 323726], [15, 324266], [19, 324446], [27, 324986], [29, 325146], [41, 325886], [44, 326386], [53, 327186], [56, 327346], [59, 327486], [67, 328295], [69, 328384], [72, 328484], [77, 328864], [80, 329024], [83, 329144], [92, 329864], [101, 330584], [104, 330704], [108, 330864], [114, 331767], [116, 331932], [121, 332312], [127, 333032], [131, 333172], [138, 333752], [140, 333912], [143, 334012], [150, 334312], [154, 334612]]}, {"verse": 47, "start": 335777, "end": 340577, "text": "Y María Magdalena, y María madre de José, miraban donde era puesto.", "words": [[0, 335777], [2, 335913], [8, 336493], [19, 337073], [21, 337193], [27, 337453], [33, 337853], [36, 337973], [42, 338313], [50, 339213], [56, 339533], [60, 339873]]}]}