{"book": "MAT", "chapter": 24, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 380565, "verses": [{"verse": 1, "start": 300, "end": 8007, "text": "Y salido Jesús, se iba del templo; y se llegaron sus discípulos, para mostrarle los edificios del templo.", "words": [[0, 300], [2, 422], [9, 842], [16, 1162], [19, 1582], [23, 1802], [27, 2022], [35, 2982], [37, 3108], [40, 3188], [49, 3648], [53, 3908], [65, 4828], [70, 5348], [80, 6188], [84, 6368], [94, 7148], [98, 7328]]}, {"verse": 2, "start": 8357, "end": 19323, "text": "Y respondiendo él, les dijo: ¿Veis todo esto? de cierto os digo, que no será dejada aquí piedra sobre piedra, que no sea destruida.", "words": [[0, 8357], [2, 8565], [15, 9305], [19, 9745], [23, 10185], [29, 11160], [35, 11510], [40, 11710], [46, 12673], [49, 12926], [56, 13212], [59, 13498], [65, 14359], [69, 14599], [72, 14759], [77, 15018], [84, 15638], [89, 15918], [96, 16438], [102, 16698], [110, 17778], [114, 17838], [117, 18018], [121, 18278]]}, {"verse": 3, "start": 19673, "end": 32123, "text": "Y sentándose él en el monte de los Olivos, se llegaron a él los discípulos aparte, diciendo: Dinos, ¿cuándo serán estas cosas, y qué señal habrá de tu venida, y del fin del mundo?", "words": [[0, 19673], [2, 19797], [13, 20777], [16, 21217], [19, 21497], [22, 21817], [28, 22137], [31, 22297], [35, 22477], [43, 23317], [46, 23617], [55, 24137], [57, 24257], [60, 24457], [64, 24637], [75, 25277], [83, 26317], [93, 27417], [100, 27713], [108, 28133], [114, 28473], [120, 28633], [127, 29093], [129, 29573], [133, 29713], [139, 30093], [145, 30333], [148, 30393], [151, 30513], [159, 30953], [161, 31153], [165, 31313], [169, 31473], [173, 31633]]}, {"verse": 4, "start": 32403, "end": 36874, "text": "Y respondiendo Jesús, les dijo: Mirad que nadie os engañe.", "words": [[0, 32403], [2, 32524], [15, 33324], [22, 33684], [26, 34044], [32, 34854], [38, 35301], [42, 35501], [48, 35861], [51, 36141]]}, {"verse": 5, "start": 37224, "end": 43710, "text": "Porque vendrán muchos en mi nombre, diciendo: Yo soy el Cristo; y a muchos engañarán.", "words": [[0, 37224], [7, 37426], [15, 37966], [22, 38306], [25, 38606], [28, 38766], [36, 39126], [46, 40294], [49, 40650], [53, 40870], [56, 41090], [64, 42130], [66, 42255], [68, 42335], [75, 42835]]}, {"verse": 6, "start": 44060, "end": 53922, "text": "Y oiréis guerras, y rumores de guerras: mirad que no os turbéis; porque es necesario que todo esto acontezca; pero aún no es el fin.", "words": [[0, 44060], [2, 44224], [9, 44664], [18, 45184], [20, 45584], [28, 46144], [31, 46324], [40, 47264], [46, 47709], [50, 47929], [53, 48169], [56, 48329], [65, 49462], [72, 49612], [75, 49692], [85, 50272], [89, 50492], [94, 50692], [99, 51136], [110, 51799], [115, 52066], [119, 52466], [122, 52826], [125, 53085], [128, 53246]]}, {"verse": 7, "start": 54272, "end": 62603, "text": "Porque se levantará nación contra nación, y reino contra reino; y habrá pestes, y hambres, y terremotos por los lugares.", "words": [[0, 54272], [7, 54455], [10, 54615], [20, 55195], [27, 55615], [34, 56015], [42, 56495], [44, 56935], [50, 57475], [57, 57855], [64, 58897], [66, 59021], [72, 59391], [80, 59761], [82, 60071], [91, 60381], [93, 60821], [104, 61501], [108, 61681], [112, 61841]]}, {"verse": 8, "start": 62953, "end": 66329, "text": "Y todas estas cosas, principio de dolores.", "words": [[0, 62953], [2, 63054], [8, 63234], [14, 63614], [21, 64474], [31, 65154], [34, 65494]]}, {"verse": 9, "start": 66679, "end": 75895, "text": "Entonces os entregarán para ser afligidos, y os matarán; y seréis aborrecidos de todas las gentes por causa de mi nombre.", "words": [[0, 66679], [9, 67585], [12, 67705], [23, 68545], [28, 68725], [32, 68965], [43, 69685], [45, 69865], [48, 69985], [57, 70942], [59, 71045], [66, 71695], [78, 72345], [81, 72505], [87, 72965], [91, 73425], [98, 73945], [102, 74405], [108, 74765], [111, 75065], [114, 75185]]}, {"verse": 10, "start": 76245, "end": 85224, "text": "Y muchos entonces serán escandalizados; y se entregarán unos a otros, y unos a otros se aborrecerán.", "words": [[0, 76245], [2, 76373], [9, 76713], [18, 77473], [24, 78333], [40, 79819], [42, 80165], [45, 80285], [56, 81085], [61, 81365], [63, 81725], [70, 82545], [72, 82925], [77, 83165], [79, 83385], [85, 83705], [88, 84225]]}, {"verse": 11, "start": 85574, "end": 90218, "text": "Y muchos falsos profetas se levantarán y engañarán a muchos.", "words": [[0, 85574], [2, 85696], [9, 85916], [16, 86516], [25, 87036], [28, 87236], [39, 87956], [41, 88316], [51, 89176], [53, 89356]]}, {"verse": 12, "start": 90568, "end": 95083, "text": "Y por haberse multiplicado la maldad, el amor de muchos se enfriará.", "words": [[0, 90568], [2, 90821], [6, 91001], [14, 91381], [27, 92201], [30, 92361], [38, 93141], [41, 93221], [46, 93481], [49, 93661], [56, 93941], [59, 94321]]}, {"verse": 13, "start": 95433, "end": 99082, "text": "Pero el que persevere hasta el fin, este será salvo.", "words": [[0, 95433], [5, 95578], [8, 95758], [12, 95858], [22, 96638], [28, 96898], [31, 97078], [36, 97918], [41, 98118], [46, 98438]]}, {"verse": 14, "start": 99432, "end": 108252, "text": "Y será predicado este evangelio del reino en todo el mundo, por testimonio a todos los Gentiles; y entonces vendrá el fin.", "words": [[0, 99432], [2, 99553], [7, 99813], [17, 100653], [22, 100873], [32, 101633], [36, 101773], [42, 102273], [45, 102413], [50, 102613], [53, 102813], [60, 103573], [64, 103813], [75, 104673], [77, 104773], [83, 104953], [87, 105253], [97, 106313], [99, 106442], [108, 106922], [115, 107782], [118, 108017]]}, {"verse": 15, "start": 108602, "end": 116653, "text": "Por tanto, cuando veáis en el lugar santo la abominación desoladora de que habló el profeta Daniel (el que lee, entienda),", "words": [[0, 108602], [4, 108727], [11, 109187], [18, 109387], [24, 109867], [27, 110047], [30, 110167], [36, 110467], [42, 111170], [45, 111302], [57, 112242], [68, 113022], [71, 113222], [75, 113362], [81, 113702], [84, 113802], [92, 114342], [99, 115047], [103, 115167], [107, 115327], [112, 116016]]}, {"verse": 16, "start": 117003, "end": 120944, "text": "Entonces los que están en Judea, huyan a los montes;", "words": [[0, 117003], [9, 117601], [13, 118181], [17, 118341], [23, 118541], [26, 118701], [33, 119301], [39, 119921], [41, 120121], [45, 120241]]}, {"verse": 17, "start": 121294, "end": 126524, "text": "Y el que sobre la azotea, no descienda a tomar algo de su casa;", "words": [[0, 121294], [2, 121455], [5, 121555], [9, 121735], [15, 122155], [18, 122395], [26, 123235], [29, 123815], [39, 124475], [41, 124675], [47, 124975], [52, 125555], [55, 125775], [58, 125915]]}, {"verse": 18, "start": 126874, "end": 131587, "text": "Y el que en el campo, no vuelva atrás a tomar sus vestidos.", "words": [[0, 126874], [2, 127080], [5, 127280], [9, 127500], [12, 127800], [15, 127960], [22, 128520], [25, 128995], [32, 129475], [38, 129795], [40, 130035], [46, 130355], [50, 130615]]}, {"verse": 19, "start": 131937, "end": 136660, "text": "Pero ¡ay de las embarazadas, y de las que crían en aquellos días!", "words": [[0, 131937], [5, 132222], [9, 132542], [12, 132722], [16, 132862], [29, 133802], [31, 134027], [34, 134127], [38, 134267], [42, 134407], [48, 134867], [51, 135007], [60, 135247]]}, {"verse": 20, "start": 137010, "end": 141368, "text": "Orad, pues, que vuestra huida no sea en invierno ni en sábado;", "words": [[0, 137010], [6, 137010], [12, 137257], [16, 137612], [24, 137992], [30, 138372], [33, 138592], [37, 138972], [40, 139312], [49, 140012], [52, 140432], [55, 140612]]}, {"verse": 21, "start": 141718, "end": 148889, "text": "Porque habrá entonces grande aflicción, cual no fue desde el principio del mundo hasta ahora, ni será.", "words": [[0, 141718], [7, 141923], [13, 142243], [22, 142663], [29, 143383], [40, 144643], [45, 145103], [48, 145263], [52, 145523], [58, 145823], [61, 146003], [71, 146563], [75, 146883], [81, 147203], [87, 147463], [94, 148103], [97, 148303]]}, {"verse": 22, "start": 149239, "end": 157651, "text": "Y si aquellos días no fuesen acortados, nadie sobreviviría; pero por causa de los escogidos, aquellos días serán acortados.", "words": [[0, 149239], [2, 149379], [5, 149479], [14, 149719], [19, 150029], [22, 150339], [29, 150779], [40, 151899], [46, 152439], [60, 154075], [65, 154239], [69, 154499], [75, 154779], [78, 155059], [82, 155159], [93, 155839], [102, 156119], [107, 156439], [113, 156839]]}, {"verse": 23, "start": 158001, "end": 165525, "text": "Entonces, si alguno os dice: Mirad, aquí está el Cristo» o «Mirad, allí está», no lo creáis.", "words": [[0, 158001], [10, 158941], [13, 159181], [20, 159471], [23, 159761], [29, 160341], [36, 161061], [41, 161541], [46, 161761], [49, 161901], [57, 162321], [59, 162921], [67, 163641], [72, 163941], [79, 164281], [82, 164621], [85, 164761]]}, {"verse": 24, "start": 165875, "end": 177641, "text": "Porque se levantarán falsos Cristos, y falsos profetas, y darán señales grandes y prodigios; de tal manera que engañarán, si es posible, aun a los escogidos.", "words": [[0, 165875], [7, 166058], [10, 166238], [21, 166838], [28, 167378], [37, 168078], [39, 168198], [46, 168618], [56, 169218], [58, 169858], [64, 170218], [72, 170678], [80, 171138], [82, 171558], [93, 172754], [96, 172881], [100, 173061], [107, 173401], [111, 173641], [122, 174541], [125, 174901], [128, 175101], [137, 175681], [141, 176301], [143, 176641], [147, 176821]]}, {"verse": 25, "start": 177991, "end": 180203, "text": "He aquí os lo he dicho antes.", "words": [[0, 178091], [3, 178191], [8, 178471], [11, 178811], [14, 179031], [17, 179151], [23, 179391]]}, {"verse": 26, "start": 180553, "end": 188565, "text": "Así que, si os dicen: He aquí en el desierto está; no salgáis: He aquí en lugares ocultos; no creáis.", "words": [[0, 180553], [4, 180861], [9, 181061], [12, 181231], [15, 181401], [22, 182276], [25, 182366], [30, 182626], [33, 182866], [36, 182986], [45, 183506], [51, 184261], [54, 184803], [63, 185594], [66, 185674], [71, 185894], [74, 186114], [82, 186454], [91, 187672], [94, 187850]]}, {"verse": 27, "start": 188915, "end": 196622, "text": "Porque como el relámpago que sale del oriente y se muestra hasta el occidente, así será también la venida del Hijo del hombre.", "words": [[0, 188915], [7, 189177], [12, 189497], [15, 189717], [25, 190457], [29, 190637], [34, 191017], [38, 191237], [46, 191717], [48, 191897], [51, 191997], [59, 192417], [65, 192617], [68, 192757], [79, 193377], [83, 194017], [88, 194357], [96, 194797], [99, 195127], [106, 195457], [110, 195657], [115, 195877], [119, 196097]]}, {"verse": 28, "start": 196972, "end": 201979, "text": "Porque donde quiera que esté el cuerpo muerto, allí se juntarán las águilas.", "words": [[0, 196972], [7, 197196], [13, 197456], [20, 197996], [24, 198156], [29, 198356], [32, 198476], [39, 198756], [47, 199836], [52, 200256], [55, 200456], [64, 200996], [68, 201506]]}, {"verse": 29, "start": 202329, "end": 216120, "text": "Y luego después de la aflicción de aquellos días, el sol se oscurecerá, y la luna no dará su resplandor, y las estrellas caerán del cielo, y las potencias de los cielos serán conmovidas.", "words": [[0, 202329], [2, 202451], [8, 202791], [16, 203071], [19, 203331], [22, 203451], [32, 204191], [35, 204371], [44, 204631], [50, 205101], [53, 205571], [57, 205951], [60, 206411], [72, 207311], [74, 207751], [77, 207891], [82, 208271], [85, 208771], [90, 209131], [93, 209311], [105, 210071], [107, 210751], [111, 210931], [121, 211491], [128, 211951], [132, 212131], [139, 213100], [141, 213340], [145, 213480], [155, 214140], [158, 214280], [162, 214420], [169, 214900], [175, 215220]]}, {"verse": 30, "start": 216470, "end": 231666, "text": "Y entonces se mostrará la señal del Hijo del hombre en el cielo; y entonces lamentarán todas las tribus de la tierra, y verán al Hijo del hombre que vendrá sobre las nubes del cielo, con grande poder y gloria.", "words": [[0, 216470], [2, 216623], [11, 217063], [14, 217623], [23, 218223], [26, 218323], [32, 218823], [36, 218983], [41, 219283], [45, 219443], [52, 219883], [55, 220083], [58, 220223], [65, 221067], [67, 221210], [76, 221710], [87, 222790], [93, 223150], [97, 223690], [104, 224230], [107, 224330], [110, 224450], [118, 224890], [120, 225550], [126, 225930], [129, 226150], [134, 226370], [138, 226610], [145, 226970], [149, 227190], [156, 227630], [162, 227930], [166, 228170], [172, 228650], [176, 228810], [183, 229250], [187, 229950], [194, 230390], [200, 230810], [202, 231010]]}, {"verse": 31, "start": 232016, "end": 242358, "text": "Y enviará sus ángeles con gran voz de trompeta, y juntarán sus escogidos de los cuatro vientos, de un extremo del cielo hasta el otro.", "words": [[0, 232016], [2, 232135], [10, 232735], [14, 232935], [22, 233655], [26, 234095], [31, 234375], [35, 234695], [38, 234875], [48, 235795], [50, 236255], [59, 236975], [63, 237175], [73, 237995], [76, 238175], [80, 238315], [87, 238575], [96, 239195], [99, 239655], [102, 239835], [110, 240575], [114, 240715], [120, 241235], [126, 241655], [129, 241855]]}, {"verse": 32, "start": 242708, "end": 251150, "text": "De la higuera aprended la parábola: Cuando ya su rama se pone tierna, y las hojas brotan, sabéis que el verano está cerca.", "words": [[0, 242708], [3, 242874], [6, 243281], [14, 243687], [23, 244094], [26, 244374], [36, 245391], [43, 245575], [46, 245855], [49, 246135], [54, 246415], [57, 246595], [62, 246775], [70, 247415], [72, 247835], [76, 248015], [82, 248315], [90, 249155], [97, 249595], [101, 249775], [104, 249895], [111, 250255], [116, 250455]]}, {"verse": 33, "start": 251500, "end": 258111, "text": "Así también vosotros, cuando veáis todas estas cosas, conoced que está cerca, a las puertas.", "words": [[0, 251500], [4, 251841], [12, 252181], [22, 253221], [29, 253421], [35, 253941], [41, 254201], [47, 254601], [54, 255161], [62, 255721], [66, 256011], [71, 256301], [78, 256781], [80, 257281], [84, 257381]]}, {"verse": 34, "start": 258461, "end": 264887, "text": "De cierto os digo, que no pasará esta generación, que todas estas cosas no acontezcan.", "words": [[0, 258461], [3, 258649], [10, 258949], [13, 259369], [19, 260249], [23, 260429], [26, 260549], [33, 260989], [38, 261309], [50, 262449], [54, 262749], [60, 262969], [66, 263249], [72, 263649], [75, 263949]]}, {"verse": 35, "start": 265237, "end": 269612, "text": "El cielo y la tierra pasarán, pero mis palabras no pasarán.", "words": [[0, 265237], [3, 265380], [9, 265780], [11, 266080], [14, 266220], [21, 266480], [30, 267400], [35, 267760], [39, 267980], [48, 268420], [51, 268940]]}, {"verse": 36, "start": 269962, "end": 276501, "text": "Pero del día y hora nadie sabe, ni aun los ángeles de los cielos, sino mi Padre solo.", "words": [[0, 269962], [5, 270124], [9, 270384], [13, 270704], [15, 270924], [20, 271124], [26, 271484], [32, 272604], [35, 272884], [39, 273164], [43, 273424], [51, 273964], [54, 274104], [58, 274244], [66, 274984], [71, 275224], [74, 275464], [80, 275724]]}, {"verse": 37, "start": 276851, "end": 281113, "text": "Pero como los días de Noé, así será la venida del Hijo del hombre.", "words": [[0, 276851], [5, 276995], [10, 277255], [14, 277475], [19, 277815], [22, 278035], [27, 278395], [31, 278755], [36, 279135], [39, 279455], [46, 279775], [50, 280015], [55, 280335], [59, 280515]]}, {"verse": 38, "start": 281463, "end": 291122, "text": "Porque como en los días antes del diluvio estaban comiendo y bebiendo, casándose y dando en casamiento, hasta el día que Noé entró en el arca,", "words": [[0, 281463], [7, 281724], [12, 282004], [15, 282164], [19, 282284], [24, 282524], [30, 282984], [34, 283224], [42, 283764], [50, 284044], [59, 284784], [61, 284884], [71, 285844], [81, 286524], [83, 286824], [89, 287104], [92, 287304], [104, 288324], [110, 288604], [113, 288804], [117, 289044], [121, 289344], [125, 289644], [131, 290284], [134, 290444], [137, 290584]]}, {"verse": 39, "start": 291472, "end": 298183, "text": "Y no conocieron hasta que vino el diluvio y llevó a todos, así será también la venida del Hijo del hombre.", "words": [[0, 291472], [2, 291601], [5, 291721], [16, 292341], [22, 292601], [26, 292801], [31, 293021], [34, 293221], [42, 293761], [44, 293921], [50, 294241], [52, 294301], [59, 295381], [63, 295601], [68, 295921], [76, 296341], [79, 296541], [86, 296981], [90, 297201], [95, 297441], [99, 297661]]}, {"verse": 40, "start": 298533, "end": 305200, "text": "Entonces estarán dos en el campo; el uno será tomado, y el otro será dejado:", "words": [[0, 299046], [9, 299582], [17, 300142], [21, 300462], [24, 300902], [27, 301042], [34, 301889], [37, 302057], [41, 302317], [46, 302557], [54, 303297], [56, 303582], [59, 303742], [64, 304002], [69, 304362]]}, {"verse": 41, "start": 305550, "end": 311936, "text": "Dos mujeres moliendo en un molino; la una será tomada, y la otra será dejada.", "words": [[0, 305550], [4, 306212], [12, 306752], [21, 307592], [24, 307792], [27, 307932], [35, 308945], [38, 309089], [42, 309309], [47, 309589], [55, 310229], [57, 310349], [60, 310489], [65, 310769], [70, 311069]]}, {"verse": 42, "start": 312286, "end": 316572, "text": "Velad pues, porque no sabéis a qué hora ha de venir vuestro Señor.", "words": [[0, 312286], [6, 312674], [12, 313066], [19, 313459], [22, 313599], [29, 314159], [31, 314399], [35, 314539], [40, 314839], [43, 315099], [46, 315259], [52, 315519], [60, 315919]]}, {"verse": 43, "start": 316922, "end": 325705, "text": "Pero sabed esto, que si el padre de la familia supiese a qué hora vendría el ladrón, velaría, y no dejaría entrar a robar en su casa.", "words": [[0, 316922], [5, 317206], [11, 317526], [17, 317766], [21, 317946], [24, 318126], [27, 318286], [33, 318606], [36, 318806], [39, 318926], [47, 319306], [55, 319866], [57, 320026], [61, 320186], [66, 320406], [74, 320926], [77, 321186], [85, 322206], [94, 322706], [96, 323001], [99, 323141], [107, 323621], [114, 324061], [116, 324341], [122, 324781], [125, 324901], [128, 325081]]}, {"verse": 44, "start": 326055, "end": 333327, "text": "Por tanto, también vosotros estad preparados; porque el Hijo del hombre ha de venir a la hora que no pensáis.", "words": [[0, 326055], [4, 326178], [11, 326638], [19, 326918], [28, 327348], [34, 327778], [46, 329302], [53, 329564], [56, 329884], [61, 330144], [65, 330324], [72, 330644], [75, 330944], [78, 331084], [84, 331404], [86, 331664], [89, 331804], [94, 332024], [98, 332204], [101, 332344]]}, {"verse": 45, "start": 333677, "end": 342042, "text": "¿Quién pues es el siervo fiel y prudente, al cual puso su señor sobre su familia para que les dé alimento a tiempo?", "words": [[0, 333677], [7, 334034], [12, 334424], [15, 334624], [18, 334744], [25, 335224], [30, 335544], [32, 335904], [42, 336264], [45, 336744], [50, 336904], [55, 337484], [58, 337664], [64, 338064], [70, 338444], [73, 338684], [81, 339284], [86, 339824], [90, 340004], [94, 340144], [97, 340424], [106, 341084], [108, 341244]]}, {"verse": 46, "start": 342392, "end": 348635, "text": "Bienaventurado aquel siervo, al cual, cuando su señor venga, le halle haciendo así.", "words": [[0, 342392], [15, 343480], [21, 343880], [29, 344440], [32, 344640], [38, 345360], [45, 345700], [48, 345900], [54, 346200], [61, 347100], [64, 347260], [70, 347580], [79, 347920]]}, {"verse": 47, "start": 348985, "end": 352619, "text": "De cierto os digo, que sobre todos sus bienes le pondrá.", "words": [[0, 348985], [3, 349130], [10, 349410], [13, 349830], [19, 350130], [23, 350330], [29, 350660], [35, 350990], [39, 351290], [46, 351810], [49, 351910]]}, {"verse": 48, "start": 352969, "end": 358487, "text": "Y si aquel siervo malo dice en su corazón: Mi señor se tarda en venir:", "words": [[0, 352969], [2, 353095], [5, 353215], [11, 353555], [18, 354015], [23, 354575], [28, 355010], [31, 355390], [34, 355550], [43, 356521], [46, 356646], [52, 357186], [55, 357206], [61, 357666], [64, 357846]]}, {"verse": 49, "start": 358837, "end": 365949, "text": "Y comienza a herir a sus compañeros de servicio, y aun a comer y a beber con los borrachos;", "words": [[0, 358837], [2, 358946], [11, 359586], [13, 359906], [19, 360326], [21, 360426], [25, 360606], [36, 361466], [39, 361586], [49, 362246], [51, 362946], [55, 363186], [57, 363506], [63, 363826], [65, 364226], [67, 364346], [73, 364546], [77, 364926], [81, 365086]]}, {"verse": 50, "start": 366299, "end": 371433, "text": "Vendrá el señor de aquel siervo en el día que no espera, y a la hora que no sabe,", "words": [[0, 366299], [7, 366756], [10, 366896], [16, 367196], [19, 367456], [25, 367756], [32, 368276], [35, 368396], [38, 368536], [42, 368776], [46, 368956], [49, 369116], [57, 369796], [59, 370156], [61, 370276], [64, 370356], [69, 370616], [73, 370796], [76, 370936]]}, {"verse": 51, "start": 371783, "end": 380165, "text": "Y le cortará por medio, y pondrá su parte con los hipócritas: allí será el llanto y el crujir de dientes.", "words": [[0, 371783], [2, 371908], [5, 372028], [13, 372628], [17, 372888], [24, 373448], [26, 373968], [33, 374388], [36, 374568], [42, 375068], [46, 375388], [50, 375528], [62, 376850], [67, 377253], [72, 377513], [75, 377713], [82, 378353], [84, 378498], [87, 378858], [94, 379218], [97, 379378]]}]}