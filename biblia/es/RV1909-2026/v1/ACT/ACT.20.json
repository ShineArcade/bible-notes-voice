{"book": "ACT", "chapter": 20, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 322627, "verses": [{"verse": 1, "start": 300, "end": 10055, "text": "Y después que cesó el alboroto, llamando Pablo a los discípulos habiéndoles exhortado y abrazado, se despidió, y salió para ir a Macedonia.", "words": [[0, 300], [2, 404], [10, 704], [14, 904], [19, 1284], [22, 1384], [32, 2404], [41, 2924], [47, 3404], [49, 3604], [53, 3724], [64, 4564], [76, 5104], [86, 6124], [88, 6224], [98, 6964], [101, 7064], [111, 7664], [113, 8224], [119, 8644], [124, 8904], [127, 9164], [129, 9244]]}, {"verse": 2, "start": 10505, "end": 17578, "text": "Y andado que hubo aquellas partes, y habiéndolos animado con muchas palabras, vino a Grecia.", "words": [[0, 10505], [2, 10800], [9, 11130], [13, 11390], [18, 11750], [27, 12130], [35, 13450], [37, 13510], [49, 14190], [57, 14790], [61, 15030], [68, 15410], [78, 16470], [83, 16810], [85, 17211]]}, {"verse": 3, "start": 18028, "end": 30302, "text": "Y después de haber estado allí tres meses, y habiendo de navegar a Siria, le fueron puestas emboscadas por los judíos; y así decidió regresar por Macedonia.", "words": [[0, 18028], [2, 18132], [10, 18432], [13, 18612], [19, 18792], [26, 19172], [31, 19432], [36, 19772], [43, 20272], [45, 21132], [54, 21532], [57, 21712], [65, 22252], [67, 22592], [74, 22932], [77, 23472], [84, 23732], [92, 24252], [103, 24992], [107, 25212], [111, 25372], [119, 26447], [121, 26797], [125, 27057], [133, 27977], [142, 29057], [146, 29277]]}, {"verse": 4, "start": 30752, "end": 43830, "text": "Y le acompañaron hasta Asia Sopater Bereense, y los Tesalonicenses, Aristarco y Segundo; y Gayo de Derbe, y Timoteo; y de Asia, Tíquico y Trófimo.", "words": [[0, 30752], [2, 30896], [5, 30976], [17, 31896], [23, 32336], [28, 32816], [36, 33546], [46, 34276], [48, 34876], [52, 35036], [68, 36376], [78, 37596], [80, 37696], [89, 38753], [91, 39042], [96, 39362], [99, 39462], [106, 39882], [108, 40082], [117, 41162], [119, 41311], [122, 41411], [128, 41751], [136, 42811], [138, 43051]]}, {"verse": 5, "start": 44280, "end": 47255, "text": "Estos yendo delante, nos esperaron en Troas.", "words": [[0, 44280], [6, 44687], [12, 45067], [21, 45567], [25, 45747], [35, 46367], [38, 46547]]}, {"verse": 6, "start": 47705, "end": 58237, "text": "Y nosotros, pasados los días de los panes sin levadura, navegamos de Filipos y vinimos a ellos a Troas en cinco días, donde estuvimos siete días.", "words": [[0, 47705], [2, 47829], [12, 48109], [20, 48829], [24, 49049], [29, 49349], [32, 49509], [36, 49609], [42, 50069], [46, 50389], [56, 51349], [66, 51989], [69, 52169], [77, 52789], [79, 53169], [87, 53629], [89, 53849], [95, 54129], [97, 54449], [103, 54929], [106, 55109], [112, 55549], [118, 56329], [124, 56629], [134, 57209], [140, 57549]]}, {"verse": 7, "start": 58687, "end": 71972, "text": "Y el día primero de la semana, juntos los discípulos a partir el pan, Pablo les enseñaba, habiendo de partir al día siguiente: y alargó el discurso hasta la media noche.", "words": [[0, 58687], [2, 58832], [5, 58992], [9, 59192], [17, 59572], [20, 59792], [23, 59912], [31, 60932], [38, 61472], [42, 61772], [53, 62392], [55, 62572], [62, 62822], [65, 63072], [70, 63652], [76, 64192], [80, 64572], [90, 65612], [99, 65992], [102, 66172], [109, 66492], [112, 66852], [116, 67032], [127, 68177], [129, 68497], [136, 69097], [139, 69297], [148, 70017], [154, 70317], [157, 70889], [163, 71461]]}, {"verse": 8, "start": 72422, "end": 76638, "text": "Y había muchas lámparas en el aposento alto donde estaban juntos.", "words": [[0, 72422], [2, 72527], [8, 72687], [15, 72986], [24, 73807], [27, 73947], [30, 74087], [39, 74587], [44, 75047], [50, 75346], [58, 75747]]}, {"verse": 9, "start": 77088, "end": 91171, "text": "Y un joven llamado Eutico que estaba sentado en la ventana, tomado de un sueño profundo, mientras Pablo hablaba largamente, vencido por el sueño cayó del tercer piso abajo, y fue levantado muerto.", "words": [[0, 77088], [2, 77214], [5, 77334], [11, 77714], [19, 78254], [26, 78794], [30, 78994], [37, 79234], [45, 79894], [48, 79994], [51, 80134], [60, 80954], [67, 81454], [70, 81594], [73, 81694], [79, 82094], [89, 83014], [98, 83234], [104, 83674], [112, 84174], [124, 85274], [132, 85774], [136, 86014], [139, 86174], [145, 86594], [150, 87034], [154, 87214], [161, 87614], [166, 88254], [173, 89312], [175, 89552], [179, 89732], [189, 90412]]}, {"verse": 10, "start": 91621, "end": 99668, "text": "Entonces descendió Pablo, y se echó sobre él, y abrazándole, dijo: No os alborotéis, que su alma está en él.", "words": [[0, 91621], [9, 92138], [19, 93218], [26, 93638], [28, 93898], [31, 94018], [36, 94318], [42, 94618], [46, 94918], [48, 95478], [61, 96678], [67, 97494], [70, 97732], [73, 97892], [85, 98532], [89, 98652], [92, 98812], [97, 99032], [102, 99272], [105, 99452]]}, {"verse": 11, "start": 100018, "end": 107114, "text": "Después subiendo, y partiendo el pan, y comiendo, habló largamente hasta el alba, y así salió.", "words": [[0, 100018], [8, 100925], [18, 101425], [20, 101565], [30, 102105], [33, 102245], [38, 102505], [40, 103205], [50, 104205], [56, 104565], [67, 105225], [73, 105505], [76, 105705], [82, 106065], [84, 106245], [88, 106445]]}, {"verse": 12, "start": 107564, "end": 112060, "text": "Y llevaron al joven vivo, y fueron consolados no poco.", "words": [[0, 107564], [2, 107664], [11, 107964], [14, 108264], [20, 108764], [26, 109164], [28, 109744], [35, 110024], [46, 111024], [49, 111324]]}, {"verse": 13, "start": 112510, "end": 122792, "text": "Y nosotros subiendo en el navío, navegamos a Asón, para recibir de allí a Pablo; pues así había determinado que debía él ir por tierra.", "words": [[0, 112510], [2, 112636], [11, 113576], [20, 114056], [23, 114256], [26, 114416], [33, 115416], [43, 115916], [45, 116266], [51, 116616], [56, 117116], [64, 117576], [67, 117876], [72, 118156], [74, 118436], [81, 119260], [86, 119524], [90, 119844], [96, 120144], [108, 120964], [112, 121124], [118, 121504], [121, 121724], [124, 121924], [128, 122144]]}, {"verse": 14, "start": 123242, "end": 128492, "text": "Y como se juntó con nosotros en Asón, tomándole vinimos a Mitilene.", "words": [[0, 123242], [2, 123367], [7, 123607], [10, 123787], [16, 124227], [20, 124407], [29, 124847], [32, 125367], [38, 125887], [48, 126627], [56, 127487], [58, 127647]]}, {"verse": 15, "start": 128942, "end": 140964, "text": "Y navegando de allí, al día siguiente llegamos delante de Quío, y al otro día tomamos puerto en Samos: y habiendo reposado en Trogilio, al día siguiente llegamos a Mileto.", "words": [[0, 128942], [2, 129064], [12, 129624], [15, 129824], [21, 130484], [24, 130604], [28, 130744], [38, 131224], [47, 131854], [55, 132484], [58, 132584], [64, 132984], [66, 133364], [69, 133484], [74, 133684], [78, 133984], [86, 134464], [93, 134784], [96, 135004], [103, 136001], [105, 136128], [114, 136528], [123, 137248], [126, 137968], [136, 138688], [139, 138828], [143, 139048], [153, 139448], [162, 140168], [164, 140348]]}, {"verse": 16, "start": 141414, "end": 155423, "text": "Porque Pablo se había propuesto pasar adelante de Éfeso; por no detenerse en Asia: porque se apresuraba por pasar el día de Pentecostés, si le fuese posible, en Jerusalén.", "words": [[0, 141414], [7, 141837], [13, 142537], [16, 142957], [22, 143237], [32, 143977], [38, 144457], [47, 145197], [50, 145497], [57, 146416], [61, 147034], [64, 147254], [74, 147914], [77, 148054], [83, 148832], [90, 149056], [93, 149256], [104, 150016], [108, 150256], [114, 150716], [117, 151016], [121, 151256], [124, 151866], [137, 152476], [140, 152976], [143, 153116], [149, 153376], [158, 153956], [161, 154516]]}, {"verse": 17, "start": 155873, "end": 161362, "text": "Y enviando desde Mileto a Éfeso, hizo llamar a los ancianos de la iglesia.", "words": [[0, 155873], [2, 156029], [11, 156709], [17, 157009], [24, 157749], [26, 157969], [33, 158949], [38, 159189], [45, 159689], [47, 159769], [51, 159929], [60, 160489], [63, 160569], [66, 160689]]}, {"verse": 18, "start": 161812, "end": 170624, "text": "Y cuando vinieron a él, les dijo: Vosotros sabéis cómo, desde el primer día que entré en Asia, he estado con vosotros por todo el tiempo,", "words": [[0, 161812], [2, 161940], [9, 162160], [18, 162740], [20, 162940], [24, 163160], [28, 163420], [34, 164230], [43, 164665], [50, 165165], [56, 165545], [62, 165885], [65, 166105], [72, 166385], [76, 166685], [80, 166905], [86, 167205], [89, 167305], [95, 167625], [98, 168265], [105, 168585], [109, 168925], [118, 169405], [122, 169705], [127, 169905], [130, 170105]]}, {"verse": 19, "start": 171074, "end": 178041, "text": "Sirviendo al Señor con toda humildad, y con muchas lágrimas, y pruebas que me han sobrevenido por las tramas de los judíos:", "words": [[0, 171074], [10, 171510], [13, 171650], [19, 171910], [23, 172170], [28, 172390], [38, 173090], [40, 173410], [44, 173590], [51, 173850], [61, 174490], [63, 174950], [71, 175390], [75, 175550], [78, 175710], [82, 175810], [94, 176450], [98, 176630], [102, 176790], [109, 177170], [112, 177290], [116, 177410]]}, {"verse": 20, "start": 178491, "end": 184677, "text": "Cómo nada que fuese útil he rehuido de anunciaros y enseñaros, públicamente y por las casas,", "words": [[0, 178491], [5, 178684], [10, 178964], [14, 179184], [20, 179524], [25, 180084], [28, 180344], [36, 180604], [39, 180744], [50, 181404], [52, 181544], [63, 182384], [76, 183104], [78, 183324], [82, 183464], [86, 183644]]}, {"verse": 21, "start": 185127, "end": 191908, "text": "Testificando a los judíos y a los Gentiles arrepentimiento para con Dios, y la fe en nuestro Señor Jesucristo.", "words": [[0, 185127], [13, 185899], [15, 185999], [19, 186119], [26, 186679], [28, 186799], [30, 186839], [34, 186979], [43, 187499], [59, 188419], [64, 188639], [68, 188879], [74, 189119], [76, 189879], [79, 190019], [82, 190259], [85, 190379], [93, 190559], [99, 190959]]}, {"verse": 22, "start": 192358, "end": 198320, "text": "Y ahora, he aquí, ligado yo en espíritu, voy a Jerusalén, sin saber lo que allá me ha de acontecer:", "words": [[0, 192358], [2, 192471], [9, 192731], [12, 192891], [18, 193611], [25, 193951], [28, 194131], [31, 194271], [41, 195391], [45, 195551], [47, 195691], [58, 196431], [62, 196551], [68, 196851], [71, 197011], [75, 197151], [80, 197291], [83, 197471], [86, 197571], [89, 197631]]}, {"verse": 23, "start": 198770, "end": 205164, "text": "Pero que el Espíritu Santo por todas las ciudades me da testimonio, diciendo que prisiones y tribulaciones me esperan.", "words": [[0, 198770], [5, 198908], [9, 199048], [12, 199168], [21, 199608], [27, 199888], [31, 200188], [37, 200388], [41, 200688], [50, 201188], [53, 201348], [56, 201508], [68, 202528], [77, 202868], [81, 203168], [91, 203728], [93, 203808], [107, 204428], [110, 204628]]}, {"verse": 24, "start": 205614, "end": 218601, "text": "Pero de ninguna cosa hago caso, ni estimo mi vida preciosa para mí mismo; solamente que acabe mi carrera con gozo, y el ministerio que recibí del Señor Jesús, para dar testimonio del evangelio de la gracia de Dios.", "words": [[0, 205614], [5, 205754], [8, 205874], [16, 206114], [21, 206554], [26, 206794], [32, 207194], [35, 207654], [42, 208034], [45, 208174], [50, 208394], [59, 208994], [64, 209194], [67, 209354], [74, 210101], [84, 210436], [88, 210756], [94, 211096], [97, 211256], [105, 211656], [109, 211856], [115, 212556], [117, 212716], [120, 212836], [131, 213496], [135, 213616], [142, 214116], [146, 214196], [152, 214476], [159, 214976], [164, 215636], [168, 215856], [179, 216536], [183, 216696], [193, 217276], [196, 217376], [199, 217496], [206, 217936], [209, 218056]]}, {"verse": 25, "start": 219051, "end": 226942, "text": "Y ahora, he aquí, yo sé que ninguno de todos vosotros, por quien he pasado predicando el reino de Dios, verá más mi rostro.", "words": [[0, 219051], [2, 219174], [9, 219454], [12, 219694], [18, 220574], [21, 220734], [24, 220914], [28, 221054], [36, 221534], [39, 221654], [45, 221874], [55, 222774], [59, 223094], [65, 223274], [68, 223394], [75, 223714], [86, 224434], [89, 224574], [95, 224854], [98, 225014], [104, 225714], [109, 225974], [113, 226154], [116, 226334]]}, {"verse": 26, "start": 227392, "end": 232785, "text": "Por tanto, yo os declaro solemnemente el día de hoy, que yo soy limpio de la sangre de todos:", "words": [[0, 227392], [4, 227498], [11, 227978], [14, 228158], [17, 228278], [25, 228738], [38, 229538], [41, 229678], [45, 229858], [48, 230018], [53, 230238], [57, 230738], [60, 230898], [64, 231078], [71, 231498], [74, 231598], [77, 231698], [84, 232018], [87, 232178]]}, {"verse": 27, "start": 233235, "end": 236544, "text": "Porque no he rehuido de anunciaros todo el consejo de Dios.", "words": [[0, 233235], [7, 233419], [10, 233639], [13, 233779], [21, 234299], [24, 234419], [35, 235019], [40, 235219], [43, 235399], [51, 235879], [54, 236019]]}, {"verse": 28, "start": 236994, "end": 247265, "text": "Por tanto mirad por vosotros, y por todo el rebaño en que el Espíritu Santo os ha puesto por obispos, para apacentar la iglesia del Señor, la cual ganó por su sangre.", "words": [[0, 236994], [4, 237142], [10, 237642], [16, 237982], [20, 238162], [30, 238762], [32, 239322], [36, 239502], [41, 239702], [44, 239922], [51, 240342], [54, 240482], [58, 240622], [61, 240782], [70, 241262], [76, 241562], [79, 241842], [82, 241942], [89, 242182], [93, 242462], [102, 243142], [107, 243522], [117, 244162], [120, 244342], [128, 244702], [132, 244902], [139, 245757], [142, 245878], [147, 246078], [152, 246458], [156, 246618], [159, 246758]]}, {"verse": 29, "start": 247715, "end": 254270, "text": "Porque yo sé que después de mi partida entrarán en medio de vosotros lobos rapaces, que no perdonarán al rebaño;", "words": [[0, 247715], [7, 247895], [10, 248115], [13, 248335], [17, 248475], [25, 248835], [28, 249035], [31, 249135], [39, 249675], [48, 250215], [51, 250335], [57, 250555], [60, 250755], [69, 251215], [75, 251615], [84, 252175], [88, 252715], [91, 252915], [102, 253575], [105, 253675]]}, {"verse": 30, "start": 254720, "end": 260264, "text": "Y de vosotros mismos se levantarán hombres que hablen cosas perversas, para llevar discípulos tras sí.", "words": [[0, 254720], [2, 254805], [5, 254905], [14, 255305], [21, 255665], [24, 255905], [35, 256445], [43, 256685], [47, 256905], [54, 257165], [60, 257405], [71, 258185], [76, 258725], [83, 258985], [94, 259685], [99, 259905]]}, {"verse": 31, "start": 260714, "end": 268276, "text": "Por tanto, velad, acordándoos que por tres años de noche y de día, no he cesado de amonestar con lágrimas a cada uno.", "words": [[0, 260714], [4, 260900], [11, 261400], [18, 261900], [30, 262740], [34, 262860], [38, 263060], [43, 263340], [48, 263620], [51, 263820], [57, 264100], [59, 264260], [62, 264380], [67, 265120], [70, 265300], [73, 265460], [80, 265880], [83, 266000], [93, 266480], [97, 266700], [106, 267240], [108, 267400], [113, 267580]]}, {"verse": 32, "start": 268726, "end": 277797, "text": "Y ahora, hermanos, os encomiendo a Dios, y a la palabra de su gracia: el cual es poderoso para edificaros y daros herencia con todos los santificados.", "words": [[0, 268726], [2, 268865], [9, 269045], [19, 270005], [22, 270105], [33, 270745], [35, 270905], [41, 271105], [43, 271505], [45, 271565], [48, 271645], [56, 272005], [59, 272185], [62, 272325], [70, 273167], [73, 273311], [78, 273491], [81, 273691], [90, 274251], [95, 274731], [106, 275211], [108, 275524], [114, 275838], [123, 276151], [127, 276411], [133, 276631], [137, 276811]]}, {"verse": 33, "start": 278247, "end": 281938, "text": "La plata, o el oro, o el vestido de nadie he codiciado.", "words": [[0, 278247], [3, 278372], [10, 278732], [12, 278912], [15, 279032], [20, 279632], [22, 279872], [25, 279952], [33, 280372], [36, 280512], [42, 281005], [45, 281499]]}, {"verse": 34, "start": 282388, "end": 289054, "text": "Antes vosotros sabéis que para lo que me ha sido necesario, y a los que están conmigo, estas manos me han servido.", "words": [[0, 282388], [6, 282711], [15, 283251], [22, 283751], [26, 283931], [31, 284151], [34, 284311], [38, 284431], [41, 284571], [44, 284671], [49, 284871], [60, 285591], [62, 286091], [64, 286171], [68, 286291], [72, 286411], [78, 286691], [87, 287611], [93, 287731], [99, 288111], [102, 288351], [106, 288471]]}, {"verse": 35, "start": 289504, "end": 301486, "text": "En todo os he enseñado que, trabajando así, es necesario ayudar a los débiles, y tener presentes las palabras del Señor Jesús, el cual dijo: Más bienaventurada cosa es dar que recibir.", "words": [[0, 289504], [3, 289623], [8, 289843], [11, 290143], [14, 290243], [23, 290803], [28, 291283], [39, 291623], [44, 292383], [47, 292503], [57, 293103], [64, 293503], [66, 293643], [70, 293803], [79, 294263], [81, 294723], [87, 294963], [97, 295503], [101, 295643], [110, 296023], [114, 296263], [120, 296503], [127, 297283], [130, 297443], [135, 297623], [141, 298483], [145, 298926], [160, 299406], [165, 299706], [168, 299966], [172, 300146], [176, 300326]]}, {"verse": 36, "start": 301836, "end": 307173, "text": "Y cuando hubo dicho estas cosas, se puso de rodillas, y oró con todos ellos.", "words": [[0, 301836], [2, 301942], [9, 302162], [14, 302622], [20, 302842], [26, 303042], [33, 303522], [36, 304022], [41, 304342], [44, 304502], [54, 305122], [56, 305702], [60, 306002], [64, 306202], [70, 306502]]}, {"verse": 37, "start": 307623, "end": 314185, "text": "Entonces hubo un gran llanto de todos: y echándose en el cuello de Pablo, le besaban,", "words": [[0, 307623], [9, 308050], [14, 308810], [17, 309030], [22, 309290], [29, 309810], [32, 309970], [39, 310908], [41, 311028], [51, 311628], [54, 311828], [57, 311968], [64, 312308], [67, 312448], [74, 312888], [77, 313388]]}, {"verse": 38, "start": 314635, "end": 322227, "text": "Doliéndose en gran manera por la palabra que dijo, que no habían de ver más su rostro. Y le acompañaron al barco.", "words": [[0, 314635], [11, 315438], [14, 315838], [19, 316038], [26, 316538], [30, 316758], [33, 316918], [41, 317218], [45, 317418], [51, 317698], [55, 318158], [58, 318338], [65, 318578], [68, 318818], [72, 318998], [76, 319178], [79, 319538], [87, 320545], [89, 320661], [92, 320741], [104, 321441], [107, 321621]]}]}