{"book": "PSA", "chapter": 39, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 91706, "verses": [{"verse": 1, "start": 300, "end": 8417, "text": "I said, I will take heed to my ways, that I sin not with my tongue: I will keep my mouth with a bridle, while the wicked is before me.", "words": [[0, 300], [2, 447], [8, 667], [10, 807], [15, 947], [20, 1167], [25, 1487], [28, 1687], [31, 1847], [37, 2307], [42, 2947], [44, 3067], [48, 3307], [52, 3587], [57, 3807], [60, 4007], [68, 4833], [70, 4939], [75, 5059], [80, 5259], [83, 5459], [89, 5739], [94, 5919], [96, 6039], [104, 6579], [110, 6999], [114, 7159], [121, 7419], [124, 7659], [131, 7939]]}, {"verse": 2, "start": 8867, "end": 14660, "text": "I was dumb with silence, I held my peace, even from good; and my sorrow was stirred.", "words": [[0, 8867], [2, 9011], [6, 9171], [11, 9451], [16, 9671], [25, 10591], [27, 10711], [32, 10951], [35, 11171], [42, 11871], [47, 12071], [52, 12351], [58, 13155], [62, 13299], [65, 13439], [72, 13819], [76, 14079]]}, {"verse": 3, "start": 15110, "end": 21207, "text": "My heart was hot within me, while I was musing the fire burned: then spoke I with my tongue,", "words": [[0, 15110], [3, 15236], [9, 15456], [13, 15636], [17, 15916], [24, 16236], [28, 16496], [34, 16916], [36, 17096], [40, 17216], [47, 17636], [51, 17756], [56, 18056], [64, 18977], [69, 19183], [75, 19523], [77, 19863], [82, 20083], [85, 20263]]}, {"verse": 4, "start": 21657, "end": 28787, "text": "LORD, make me to know my end, and the measure of my days, what it is; that I may know how frail I am.", "words": [[0, 21657], [6, 21657], [11, 21864], [14, 22104], [17, 22284], [22, 22484], [25, 22704], [30, 23344], [34, 23624], [38, 23764], [46, 24104], [49, 24404], [52, 24624], [58, 25364], [63, 25564], [66, 25724], [70, 26523], [75, 26649], [77, 26829], [81, 27009], [86, 27369], [90, 27649], [96, 28189], [98, 28369]]}, {"verse": 5, "start": 29237, "end": 39090, "text": "Behold, you have made my days as a handbreadth; and my age is as nothing before you: indeed every man at his best state is altogether vanity. Selah.", "words": [[0, 29237], [8, 29783], [12, 29863], [17, 30043], [22, 30303], [25, 30543], [30, 30883], [33, 31183], [35, 31588], [48, 32271], [52, 32398], [55, 32558], [59, 32938], [62, 33118], [65, 33278], [73, 33618], [80, 34058], [85, 34813], [92, 35375], [98, 35595], [102, 35915], [105, 36095], [109, 36255], [114, 36535], [120, 36875], [123, 37075], [134, 37515], [142, 38816]]}, {"verse": 6, "start": 39540, "end": 47720, "text": "Surely every man walks in a vain show: surely they are disquieted in vain: he heaps up riches, and knows not who shall gather them.", "words": [[0, 39540], [7, 39800], [13, 40200], [17, 40520], [23, 40840], [26, 41100], [28, 41200], [33, 41420], [39, 42296], [46, 42597], [51, 42857], [55, 42957], [66, 43737], [69, 43857], [75, 44727], [78, 44838], [84, 45138], [87, 45318], [95, 45678], [99, 45978], [105, 46238], [109, 46498], [113, 46718], [119, 46938], [126, 47258]]}, {"verse": 7, "start": 48170, "end": 51936, "text": "And now, Lord, what wait I for? my hope is in you.", "words": [[0, 48170], [4, 48290], [9, 48610], [15, 49290], [20, 49430], [25, 49630], [27, 49850], [32, 50657], [35, 50804], [40, 51024], [43, 51264], [46, 51464]]}, {"verse": 8, "start": 52386, "end": 57091, "text": "Deliver me from all my transgressions: make me not the reproach of the foolish.", "words": [[0, 52386], [8, 52628], [11, 52928], [16, 53148], [20, 53468], [23, 53688], [39, 55075], [44, 55243], [47, 55423], [51, 55623], [55, 55823], [64, 56283], [67, 56383], [71, 56503]]}, {"verse": 9, "start": 57541, "end": 61011, "text": "I was dumb, I opened not my mouth; because you did it.", "words": [[0, 57541], [2, 57664], [6, 57844], [12, 58304], [14, 58384], [21, 58724], [25, 59024], [28, 59264], [35, 60066], [43, 60272], [47, 60512], [51, 60712]]}, {"verse": 10, "start": 61461, "end": 65750, "text": "Remove your stroke away from me: I am consumed by the blow of your hand.", "words": [[0, 61461], [7, 61688], [12, 61968], [19, 62288], [24, 62608], [29, 62828], [33, 63460], [35, 63626], [38, 63746], [47, 64206], [50, 64546], [54, 64686], [59, 64926], [62, 65106], [67, 65226]]}, {"verse": 11, "start": 66200, "end": 75156, "text": "When you with rebukes do correct man for iniquity, you make his beauty to consume away like a moth: surely every man is vanity. Selah.", "words": [[0, 66200], [5, 66369], [9, 66589], [14, 66809], [22, 67369], [25, 67529], [33, 67869], [37, 68169], [41, 68429], [51, 69329], [55, 69509], [60, 69729], [64, 69889], [71, 70249], [74, 70449], [82, 70869], [87, 71129], [92, 71449], [94, 71549], [100, 72250], [107, 72530], [113, 72970], [117, 73310], [120, 73550], [128, 74824]]}, {"verse": 12, "start": 75606, "end": 86053, "text": "Hear my prayer, O LORD, and give ear to my cry; hold not your peace at my tears: for I am a stranger with you, and a sojourner, as all my fathers were.", "words": [[0, 75606], [5, 75753], [8, 75953], [16, 76433], [18, 76533], [24, 77053], [28, 77153], [33, 77353], [37, 77553], [40, 77733], [43, 77913], [48, 78956], [53, 79109], [57, 79389], [62, 79589], [68, 79909], [71, 80069], [74, 80249], [81, 81255], [85, 81385], [87, 81705], [90, 81985], [92, 82125], [101, 82525], [106, 82905], [111, 83385], [115, 83485], [117, 83605], [128, 84285], [131, 84745], [135, 84925], [138, 85105], [146, 85425]]}, {"verse": 13, "start": 86503, "end": 91306, "text": "O spare me, that I may recover strength, before I go from here, and be no more.", "words": [[0, 86668], [2, 86868], [8, 86928], [12, 87168], [17, 87368], [19, 87468], [23, 87628], [31, 88088], [41, 88588], [48, 89068], [50, 89328], [53, 89528], [58, 89768], [64, 90068], [68, 90468], [71, 90628], [74, 90828]]}]}