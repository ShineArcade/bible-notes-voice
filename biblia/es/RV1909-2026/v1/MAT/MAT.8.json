{"book": "MAT", "chapter": 8, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 268187, "verses": [{"verse": 1, "start": 300, "end": 3639, "text": "Y como descendió del monte, le seguía mucha gente.", "words": [[0, 300], [2, 422], [7, 702], [17, 1442], [21, 1562], [28, 2002], [31, 2222], [38, 2682], [44, 2922]]}, {"verse": 2, "start": 3989, "end": 10870, "text": "Y he aquí un leproso vino, y le adoraba, diciendo: Señor, si quieres, puedes limpiarme.", "words": [[0, 3989], [2, 4210], [5, 4450], [10, 4690], [13, 4890], [21, 5410], [27, 5790], [29, 6310], [32, 6450], [41, 7130], [51, 8354], [58, 8940], [61, 8940], [70, 9640], [77, 10040]]}, {"verse": 3, "start": 11150, "end": 19194, "text": "Y extendiendo Jesús su mano, le tocó, diciendo: Quiero; sé limpio. Y luego su lepra fue limpiada.", "words": [[0, 11150], [2, 11292], [14, 12032], [20, 12312], [23, 12632], [29, 13372], [32, 13592], [38, 14092], [48, 15258], [56, 15945], [59, 16110], [67, 17009], [69, 17126], [75, 17386], [78, 17686], [84, 18106], [88, 18326]]}, {"verse": 4, "start": 19544, "end": 31019, "text": "Entonces Jesús le dijo: Mira, no lo digas a nadie; pero ve, muéstrate al sacerdote, y ofrece la ofrenda que mandó Moisés, para testimonio a ellos.", "words": [[0, 19544], [9, 20206], [15, 20666], [18, 20966], [24, 21599], [30, 22179], [33, 22299], [36, 22439], [42, 22799], [44, 22899], [51, 23627], [56, 23814], [60, 24534], [70, 25234], [73, 25414], [84, 26334], [86, 26794], [93, 27214], [96, 27414], [104, 27954], [108, 28074], [114, 28454], [122, 28974], [127, 29574], [138, 30374], [140, 30474]]}, {"verse": 5, "start": 31369, "end": 36122, "text": "Y entrando Jesús en Capernaum, vino a él un centurión, rogándole,", "words": [[0, 31369], [2, 31478], [11, 31858], [17, 32198], [20, 32738], [31, 33278], [36, 33778], [38, 33998], [41, 34118], [44, 34258], [55, 35216]]}, {"verse": 6, "start": 36472, "end": 41817, "text": "Y diciendo: Señor, mi criado yace en casa paralítico, gravemente atormentado.", "words": [[0, 36472], [2, 36617], [12, 37570], [19, 37860], [22, 38155], [29, 38450], [34, 38745], [37, 38885], [42, 39105], [54, 40345], [65, 40965]]}, {"verse": 7, "start": 42097, "end": 45511, "text": "Y Jesús le dijo: Yo iré y le sanaré.", "words": [[0, 42097], [2, 42216], [8, 42576], [11, 42856], [17, 43573], [20, 43898], [24, 44478], [26, 44738], [29, 44838]]}, {"verse": 8, "start": 45861, "end": 54233, "text": "Y respondió el centurión, y dijo: Señor, no soy digno de que entres bajo mi techo; pero solamente di la palabra, y mi criado sanará.", "words": [[0, 45861], [2, 45987], [12, 46647], [15, 46807], [26, 47527], [28, 47947], [34, 48688], [41, 49193], [44, 49273], [48, 49473], [54, 49933], [57, 50033], [61, 50173], [68, 50493], [73, 50713], [76, 50913], [83, 51628], [88, 51765], [98, 52125], [101, 52445], [104, 52585], [113, 52945], [115, 53205], [118, 53285], [125, 53665]]}, {"verse": 9, "start": 54583, "end": 65425, "text": "Porque también yo soy hombre bajo autoridad, y tengo soldados bajo mi mando: y digo a este: Ve, y va; y al otro: Ven, y viene; y a mi siervo: Haz esto, y lo hace.", "words": [[0, 54583], [7, 54747], [15, 55127], [18, 55287], [22, 55467], [29, 55707], [34, 55907], [45, 56547], [47, 56747], [53, 56987], [62, 57527], [67, 57747], [70, 57967], [77, 58635], [79, 58780], [84, 58980], [86, 59120], [92, 59806], [96, 60063], [98, 60357], [102, 60819], [104, 60960], [107, 61040], [113, 61700], [118, 61959], [120, 62219], [127, 62869], [129, 63032], [131, 63072], [134, 63152], [142, 64101], [146, 64321], [152, 64621], [154, 64841], [157, 64981]]}, {"verse": 10, "start": 65705, "end": 74369, "text": "Y oyendo Jesús, se maravilló, y dijo a los que le seguían: De cierto os digo, que ni aun en Israel he hallado tanta fe.", "words": [[0, 65705], [2, 65863], [9, 66203], [16, 66563], [19, 66903], [30, 67603], [32, 68223], [37, 68523], [39, 68643], [43, 68743], [47, 68863], [50, 68983], [59, 69925], [62, 70089], [69, 70349], [72, 70709], [78, 70949], [82, 71379], [85, 71809], [89, 72109], [92, 72369], [99, 72889], [102, 73229], [110, 73649], [116, 73849]]}, {"verse": 11, "start": 74719, "end": 84503, "text": "Y os digo que vendrán muchos del oriente y del occidente, y se sentarán con Abraham, e Isaac, y Jacob, en el reino de los cielos:", "words": [[0, 74719], [2, 74861], [5, 74961], [10, 75181], [14, 75401], [22, 75881], [29, 76181], [33, 76461], [41, 76981], [43, 77121], [47, 77301], [58, 78701], [60, 78901], [63, 79021], [72, 79681], [76, 79801], [85, 81121], [87, 81181], [94, 81601], [96, 82001], [103, 82421], [106, 82961], [109, 83121], [115, 83481], [118, 83581], [122, 83721]]}, {"verse": 12, "start": 84853, "end": 93487, "text": "Pero los hijos del reino serán echados a las tinieblas de afuera: allí será el llanto y el crujir de dientes.", "words": [[0, 84853], [5, 84998], [9, 85198], [15, 85478], [19, 85738], [25, 86218], [31, 86698], [39, 87318], [41, 87518], [45, 87658], [55, 88298], [58, 88398], [66, 89232], [71, 89523], [76, 90339], [79, 90539], [86, 91179], [88, 91659], [91, 92059], [98, 92459], [101, 92599]]}, {"verse": 13, "start": 93837, "end": 102230, "text": "Entonces Jesús dijo al centurión: Ve, y como creíste te sea hecho. Y su criado fue sano en el mismo momento.", "words": [[0, 93837], [9, 94582], [15, 94882], [20, 95342], [23, 95542], [34, 96766], [38, 97056], [40, 97156], [45, 97396], [53, 97769], [56, 98143], [60, 98516], [67, 99198], [69, 99324], [72, 99464], [79, 100044], [83, 100264], [88, 100764], [91, 100984], [94, 101124], [100, 101424]]}, {"verse": 14, "start": 102580, "end": 108340, "text": "Y vino Jesús a casa de Pedro, y vio a su suegra echada en cama, y con fiebre.", "words": [[0, 102580], [2, 102689], [7, 102909], [13, 103289], [15, 103569], [20, 103789], [23, 104009], [30, 104389], [32, 104949], [36, 105249], [38, 105409], [41, 105569], [48, 106049], [55, 106429], [58, 106629], [64, 107009], [66, 107449], [70, 107629]]}, {"verse": 15, "start": 108690, "end": 114327, "text": "Y tocó su mano, y la fiebre la dejó: y ella se levantó, y les servía.", "words": [[0, 108690], [2, 108899], [7, 109219], [10, 109379], [16, 109759], [18, 110014], [21, 110174], [28, 110634], [31, 110914], [37, 111713], [39, 111877], [44, 112117], [47, 112317], [56, 113137], [58, 113477], [62, 113617]]}, {"verse": 16, "start": 114677, "end": 123715, "text": "Y como fue ya tarde, trajeron a él muchos endemoniados; y echó los demonios con la palabra, y sanó a todos los enfermos;", "words": [[0, 114677], [2, 114955], [7, 115175], [11, 115415], [14, 115595], [21, 116135], [30, 116755], [32, 116855], [35, 117035], [42, 117415], [56, 118926], [58, 119082], [63, 119462], [67, 119642], [76, 120182], [80, 120362], [83, 120502], [92, 120982], [94, 121562], [99, 122002], [101, 122202], [107, 122502], [111, 122762]]}, {"verse": 17, "start": 124065, "end": 133681, "text": "Para que se cumpliese lo que fue dicho por el profeta Isaías, que dijo: Él mismo tomó nuestras enfermedades, y llevó nuestras dolencias.", "words": [[0, 124065], [5, 124211], [9, 124351], [12, 124471], [22, 125131], [25, 125591], [29, 125711], [33, 125871], [39, 126171], [43, 126471], [46, 126591], [54, 127111], [62, 128111], [66, 128251], [72, 128971], [75, 129133], [81, 129453], [86, 129873], [95, 130113], [109, 131233], [111, 131673], [117, 132053], [126, 132393]]}, {"verse": 18, "start": 134031, "end": 139796, "text": "Y viendo Jesús mucha gente alrededor de sí, mandó pasar al otro lado del lago.", "words": [[0, 134031], [2, 134156], [9, 134416], [15, 135156], [21, 135336], [27, 135716], [37, 136096], [40, 136556], [44, 137256], [50, 137856], [56, 138156], [59, 138396], [64, 138596], [69, 138896], [73, 139176]]}, {"verse": 19, "start": 140146, "end": 146076, "text": "Y acercándose un escriba, le dijo: Maestro, te seguiré adondequiera que vayas.", "words": [[0, 140146], [2, 140312], [14, 140892], [17, 141472], [26, 142552], [29, 142672], [35, 143400], [44, 143881], [47, 144081], [55, 144671], [68, 145261], [72, 145401]]}, {"verse": 20, "start": 146356, "end": 155374, "text": "Y Jesús le dijo: Las zorras tienen guaridas, y las aves del cielo nidos; pero el Hijo del hombre no tiene donde recueste su cabeza.", "words": [[0, 146356], [2, 146475], [8, 146835], [11, 147115], [17, 147833], [21, 147958], [28, 148478], [35, 148858], [45, 149558], [47, 149833], [51, 149953], [56, 150353], [60, 150533], [66, 150873], [73, 151868], [78, 152218], [81, 152398], [86, 152638], [90, 152818], [97, 153098], [100, 153318], [106, 153618], [112, 153878], [121, 154498], [124, 154658]]}, {"verse": 21, "start": 155724, "end": 161998, "text": "Y otro de sus discípulos le dijo: Señor, permíteme ir primero y enterrar a mi padre.", "words": [[0, 155724], [2, 155911], [7, 156171], [10, 156451], [14, 156651], [25, 157571], [28, 157951], [34, 158720], [41, 159495], [51, 160015], [54, 160235], [62, 160675], [64, 160895], [73, 161315], [75, 161415], [78, 161515]]}, {"verse": 22, "start": 162278, "end": 167482, "text": "Y Jesús le dijo: Sígueme; deja que los muertos entierren a sus muertos.", "words": [[0, 162278], [2, 162397], [8, 162757], [11, 163037], [17, 163755], [26, 164705], [31, 164990], [35, 165190], [39, 165330], [47, 166040], [57, 166750], [59, 166870], [63, 166990]]}, {"verse": 23, "start": 167832, "end": 172041, "text": "Y entrando él en el barco, sus discípulos le siguieron.", "words": [[0, 167832], [2, 168400], [11, 168980], [14, 169360], [17, 169500], [20, 169660], [27, 170100], [31, 170540], [42, 171140], [45, 171300]]}, {"verse": 24, "start": 172391, "end": 179895, "text": "Y he aquí, se levantó en el mar una gran tormenta, que el barco se cubría de las olas; pero él dormía.", "words": [[0, 172391], [2, 172467], [5, 172577], [11, 172917], [14, 173197], [22, 173757], [25, 173877], [28, 173997], [32, 174237], [36, 174537], [41, 174837], [51, 175757], [55, 176297], [58, 176497], [64, 176937], [67, 177097], [74, 177557], [77, 177697], [81, 177897], [87, 178786], [92, 178950], [95, 179130]]}, {"verse": 25, "start": 180245, "end": 186581, "text": "Y acercándose sus discípulos, le despertaron, diciendo: Señor, sálvanos, que perecemos.", "words": [[0, 180245], [2, 180373], [14, 181273], [18, 181453], [30, 182153], [33, 182593], [46, 183733], [56, 184769], [63, 185010], [73, 185610], [77, 185770]]}, {"verse": 26, "start": 186861, "end": 197477, "text": "Y él les dijo: ¿Por qué tenéis miedo, hombres de poca fe? Entonces, levantándose, reprendió a los vientos y al mar; y fue grande calma.", "words": [[0, 186861], [2, 187028], [5, 187168], [9, 187348], [15, 188070], [20, 188215], [24, 188375], [31, 188835], [38, 189495], [46, 189795], [49, 190035], [54, 190355], [58, 190954], [68, 191897], [82, 193277], [92, 193917], [94, 194077], [98, 194217], [106, 194777], [108, 195017], [111, 195197], [116, 195812], [118, 195997], [122, 196157], [129, 196437]]}, {"verse": 27, "start": 197827, "end": 204387, "text": "Y los hombres se maravillaron, diciendo: ¿Qué hombre es este, que aun los vientos y el mar le obedecen?", "words": [[0, 197827], [2, 197932], [6, 198052], [14, 198452], [17, 198752], [31, 199632], [41, 200702], [46, 200802], [53, 201082], [56, 201342], [62, 202002], [66, 202242], [70, 202442], [74, 202642], [82, 203082], [84, 203262], [87, 203382], [91, 203542], [94, 203702]]}, {"verse": 28, "start": 204667, "end": 218809, "text": "Y como él hubo llegado en la otra ribera al país de los gergesenos, le vinieron al encuentro dos endemoniados que salían de los sepulcros, feroces en gran manera, que nadie podía pasar por aquel camino.", "words": [[0, 204667], [2, 204792], [7, 205052], [10, 205292], [15, 205712], [23, 206132], [26, 206252], [29, 206412], [34, 206672], [41, 207312], [44, 207552], [49, 207932], [52, 208172], [56, 208872], [68, 209572], [71, 209712], [80, 210172], [83, 210352], [93, 210932], [97, 211212], [110, 212232], [114, 212412], [121, 212852], [124, 212972], [128, 213112], [139, 213912], [147, 214852], [150, 215092], [155, 215292], [163, 216132], [167, 216236], [173, 216576], [179, 217036], [185, 217536], [189, 217836], [195, 218176]]}, {"verse": 29, "start": 219159, "end": 227134, "text": "Y he aquí clamaron, diciendo: ¿Qué tenemos contigo, Jesús, Hijo de Dios? ¿has venido acá a atormentarnos antes de tiempo?", "words": [[0, 219159], [2, 219349], [5, 219539], [10, 219759], [20, 220799], [30, 221722], [35, 221824], [43, 222124], [52, 222584], [59, 223304], [64, 223424], [67, 223584], [73, 224263], [78, 224446], [85, 224786], [89, 225026], [91, 225266], [105, 226046], [111, 226406], [114, 226626]]}, {"verse": 30, "start": 227414, "end": 231413, "text": "Y estaba lejos de ellos una manada de muchos cerdos paciendo.", "words": [[0, 227414], [2, 227540], [9, 227780], [15, 228200], [18, 228360], [24, 228640], [28, 228920], [35, 229400], [38, 229560], [45, 229860], [52, 230665]]}, {"verse": 31, "start": 231763, "end": 238029, "text": "Y los demonios le rogaron, diciendo: Si nos echas, permítenos ir a aquella manada de cerdos.", "words": [[0, 231763], [2, 232030], [6, 232150], [15, 232630], [18, 232790], [27, 233850], [37, 234900], [40, 235048], [44, 235248], [51, 235448], [62, 236068], [65, 236388], [67, 236528], [75, 236868], [82, 237248], [85, 237368]]}, {"verse": 32, "start": 238309, "end": 251142, "text": "Y les dijo: Id. Y ellos salieron, y se fueron a aquella manada de cerdos: y he aquí, toda la manada de los cerdos se precipitó de un despeñadero en el mar, y murieron en las aguas.", "words": [[0, 238309], [2, 238439], [6, 238559], [12, 239474], [16, 239880], [18, 240038], [24, 240258], [34, 240858], [36, 241238], [39, 241378], [46, 241638], [48, 242038], [56, 242378], [63, 242798], [66, 242958], [74, 243911], [76, 244075], [79, 244235], [85, 244535], [90, 244815], [93, 245055], [100, 245475], [103, 245635], [107, 245775], [114, 246535], [117, 246875], [127, 247695], [130, 247795], [133, 247915], [145, 248615], [148, 248735], [151, 248875], [156, 249075], [158, 249575], [167, 250075], [170, 250235], [174, 250435]]}, {"verse": 33, "start": 251492, "end": 260275, "text": "Y los cuidadores de los cerdos huyeron, y viniendo a la ciudad, contaron todas las cosas, y lo que había pasado con los endemoniados.", "words": [[0, 251492], [2, 251595], [6, 251735], [17, 252415], [20, 252515], [24, 252655], [31, 253255], [40, 254275], [42, 254595], [51, 255095], [53, 255175], [56, 255255], [64, 255555], [73, 256275], [79, 256575], [83, 256855], [90, 257755], [92, 258015], [95, 258135], [99, 258275], [105, 258475], [112, 258855], [116, 259115], [120, 259295]]}, {"verse": 34, "start": 260625, "end": 267787, "text": "Y he aquí, toda la ciudad salió a encontrar a Jesús: y cuando le vieron, le rogaban que saliese de su región.", "words": [[0, 260625], [2, 260691], [5, 260791], [11, 261111], [16, 261431], [19, 261651], [26, 261991], [32, 262551], [34, 262611], [44, 263031], [46, 263151], [53, 264011], [55, 264096], [62, 264296], [65, 264536], [73, 264976], [76, 265416], [84, 265996], [88, 266176], [96, 266656], [99, 266896], [102, 267056]]}]}