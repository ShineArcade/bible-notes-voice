{"book": "MAT", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 338446, "verses": [{"verse": 1, "start": 300, "end": 12325, "text": "Entonces llamando a sus doce discípulos, les dio autoridad contra los espíritus inmundos, para que los echasen fuera, y sanasen toda enfermedad y toda dolencia.", "words": [[0, 300], [9, 1109], [18, 1669], [20, 1729], [24, 1909], [29, 2309], [41, 3329], [45, 3589], [49, 4049], [59, 4889], [66, 5289], [70, 5549], [80, 6209], [90, 6769], [95, 7389], [99, 7529], [103, 7709], [111, 8309], [118, 8689], [120, 9169], [128, 9649], [133, 9969], [144, 11049], [146, 11209], [151, 11389]]}, {"verse": 2, "start": 12675, "end": 24740, "text": "Y los nombres de los doce apóstoles son estos: el primero, Simón, que es llamado Pedro, y Andrés su hermano; Jacobo, hijo de Zebedeo, y Juan su hermano;", "words": [[0, 12675], [2, 12997], [6, 13137], [14, 13557], [17, 13717], [21, 13947], [26, 14177], [36, 14897], [40, 15217], [47, 15957], [50, 16141], [59, 16521], [66, 17181], [70, 17361], [73, 17541], [81, 17881], [88, 18481], [90, 18901], [97, 19361], [100, 19761], [109, 20682], [117, 21853], [122, 22033], [125, 22543], [134, 23053], [136, 23473], [141, 23773], [144, 24073]]}, {"verse": 3, "start": 25090, "end": 33682, "text": "Felipe, y Bartolomé; Tomás, y Mateo el publicano; Jacobo hijo de Alfeo, y Lebeo, por sobrenombre Tadeo;", "words": [[0, 25090], [8, 25520], [10, 25900], [21, 26951], [28, 27453], [30, 27773], [36, 28233], [39, 28353], [50, 29436], [57, 30242], [62, 30402], [65, 30602], [72, 31122], [74, 31632], [81, 32142], [85, 32242], [97, 33082]]}, {"verse": 4, "start": 34032, "end": 37943, "text": "Simón el cananista y Judas Iscariote, que también le entregó.", "words": [[0, 34032], [6, 34659], [9, 34719], [19, 35399], [21, 35759], [27, 36119], [38, 36479], [42, 36659], [50, 37039], [53, 37279]]}, {"verse": 5, "start": 38293, "end": 50382, "text": "A estos doce envió Jesús, a los cuales dio mandamiento, diciendo: Por el camino de los Gentiles no iréis, y en ciudad de samaritanos no entréis;", "words": [[0, 38293], [2, 38659], [8, 38899], [13, 39719], [19, 40239], [26, 41299], [28, 41499], [32, 41619], [39, 41879], [43, 42419], [56, 43619], [66, 44595], [70, 44717], [73, 44877], [80, 45277], [83, 45417], [87, 45537], [96, 46057], [99, 46357], [106, 47417], [108, 47697], [111, 47837], [118, 48397], [121, 48877], [133, 49357], [136, 49577]]}, {"verse": 6, "start": 50732, "end": 54360, "text": "Pero id antes a las ovejas perdidas de la casa de Israel.", "words": [[0, 50732], [5, 50898], [8, 51198], [14, 51638], [16, 51898], [20, 51998], [27, 52418], [36, 53058], [39, 53238], [42, 53318], [47, 53558], [50, 53778]]}, {"verse": 7, "start": 54710, "end": 60112, "text": "Y yendo, predicad, diciendo: El reino de los cielos se ha acercado.", "words": [[0, 54710], [2, 54874], [9, 55174], [19, 55894], [29, 56992], [32, 57154], [38, 57654], [41, 57754], [45, 57894], [52, 58534], [55, 58754], [58, 58954]]}, {"verse": 8, "start": 60462, "end": 71282, "text": "Sanad enfermos, limpiad leprosos, resucitad muertos, echad fuera demonios: gratis recibisteis, dad gratis.", "words": [[0, 60462], [6, 61027], [16, 62247], [24, 63087], [34, 64087], [44, 65087], [53, 66187], [59, 66587], [65, 67027], [75, 68153], [82, 68882], [95, 70222], [99, 70422]]}, {"verse": 9, "start": 71282, "end": 74820, "text": "No llevéis oro, ni plata, ni cobre en vuestras bolsas;", "words": [[0, 71522], [3, 71602], [11, 72062], [16, 72342], [19, 72582], [26, 72922], [29, 73262], [35, 73602], [38, 73742], [47, 74102]]}, {"verse": 10, "start": 75170, "end": 83547, "text": "Ni bolsa para el camino, ni dos ropas de vestir, ni zapatos, ni bastón; porque el obrero digno es de su alimento.", "words": [[0, 75170], [3, 75313], [9, 75753], [14, 75973], [17, 76133], [25, 76973], [28, 77193], [32, 77433], [38, 77953], [41, 78113], [49, 78813], [52, 78913], [61, 79773], [64, 79853], [72, 80685], [79, 80926], [82, 81146], [89, 81506], [95, 82246], [98, 82446], [101, 82586], [104, 82726]]}, {"verse": 11, "start": 83897, "end": 92960, "text": "Pero en cualquier ciudad o aldea donde entréis, investigad quién sea en ella digno, y reposad allí hasta que salgáis.", "words": [[0, 83897], [5, 84041], [8, 84181], [18, 84521], [25, 85101], [27, 85601], [33, 86141], [39, 86361], [48, 87461], [59, 88321], [65, 88561], [69, 89021], [72, 89301], [77, 89481], [84, 90281], [86, 90441], [94, 91141], [99, 91441], [105, 91981], [109, 92181]]}, {"verse": 12, "start": 93310, "end": 96415, "text": "Y entrando en la casa, saludadla.", "words": [[0, 93310], [2, 93664], [11, 94244], [14, 94444], [17, 94584], [23, 95424]]}, {"verse": 13, "start": 96765, "end": 105049, "text": "Y si la casa es digna, vuestra paz vendrá sobre ella; pero si no es digna, vuestra paz se volverá a vosotros.", "words": [[0, 96765], [2, 96887], [5, 97007], [8, 97167], [13, 97367], [16, 97587], [23, 98487], [31, 98987], [35, 99267], [42, 100007], [48, 100287], [54, 101101], [59, 101249], [62, 101449], [65, 101649], [68, 101789], [75, 102589], [83, 103009], [87, 103309], [90, 103769], [98, 104289], [100, 104369]]}, {"verse": 14, "start": 105399, "end": 114850, "text": "Y cualquiera que no os reciba, ni oiga vuestras palabras, salid de aquella casa o ciudad, y sacudid el polvo de vuestros pies.", "words": [[0, 105399], [2, 105497], [13, 106137], [17, 106317], [20, 106577], [23, 106737], [31, 107297], [34, 107537], [39, 107937], [48, 108377], [58, 109357], [64, 109937], [67, 110197], [75, 110517], [80, 110897], [82, 111157], [90, 111597], [92, 112237], [100, 113037], [103, 113237], [109, 113797], [112, 113917], [121, 114257]]}, {"verse": 15, "start": 115200, "end": 124674, "text": "De cierto os digo, que el castigo será más tolerable a la tierra de los de Sodoma y de los de Gomorra en el día del juicio, que a aquella ciudad.", "words": [[0, 115200], [3, 115428], [10, 115688], [13, 115948], [19, 116168], [23, 116413], [26, 116573], [34, 117273], [39, 117573], [43, 117853], [53, 118653], [55, 118773], [58, 118853], [65, 119233], [68, 119423], [72, 119613], [75, 119793], [82, 120393], [84, 120538], [87, 120658], [91, 120798], [94, 120958], [102, 121578], [105, 121858], [108, 122018], [112, 122298], [116, 122478], [124, 123441], [128, 123524], [130, 123624], [138, 123904]]}, {"verse": 16, "start": 125024, "end": 135088, "text": "He aquí, yo os envío como a ovejas en medio de lobos: sed pues prudentes como serpientes, y sencillos como palomas.", "words": [[0, 125073], [3, 125153], [9, 126033], [12, 126313], [15, 126633], [21, 127213], [26, 127513], [28, 127733], [35, 128253], [38, 128473], [44, 128753], [47, 128973], [54, 129825], [58, 130326], [63, 130646], [73, 131546], [78, 131826], [90, 132586], [92, 133106], [102, 133946], [107, 134206]]}, {"verse": 17, "start": 135438, "end": 142302, "text": "Y guardaos de los hombres: porque os entregarán en tribunales, y en sus sinagogas os azotarán;", "words": [[0, 135438], [2, 135607], [11, 136267], [14, 136467], [18, 136627], [27, 137487], [34, 137749], [37, 137929], [48, 138709], [51, 138849], [63, 139529], [65, 139789], [68, 139949], [72, 140109], [82, 140949], [85, 141189]]}, {"verse": 18, "start": 142652, "end": 150672, "text": "Y aun a príncipes y a reyes seréis llevados por causa de mí, por testimonio a ellos y a los Gentiles.", "words": [[0, 142652], [2, 142687], [6, 142757], [8, 143184], [18, 143610], [20, 144037], [22, 144137], [28, 144577], [35, 145317], [44, 145857], [48, 146097], [54, 146437], [57, 146737], [61, 147357], [65, 147677], [76, 148577], [78, 148757], [84, 149097], [86, 149477], [88, 149597], [92, 149697]]}, {"verse": 19, "start": 151022, "end": 159704, "text": "Pero cuando os entreguen, no os preocupéis por cómo o qué hablaréis; porque en aquella hora os será dado qué habéis de hablar.", "words": [[0, 151022], [5, 151170], [12, 151430], [15, 151710], [26, 152610], [29, 152870], [32, 153010], [43, 153910], [47, 154150], [52, 154590], [54, 154910], [58, 155170], [69, 156371], [76, 156731], [79, 156971], [87, 157211], [92, 157451], [95, 157651], [100, 157991], [105, 158351], [109, 158711], [116, 159091], [119, 159271]]}, {"verse": 20, "start": 160054, "end": 166287, "text": "Porque no sois vosotros los que habláis, sino el Espíritu de vuestro Padre que habla en vosotros.", "words": [[0, 160054], [7, 160275], [10, 160515], [15, 160915], [24, 161475], [28, 161735], [32, 161935], [41, 162575], [46, 163015], [49, 163235], [58, 163895], [61, 163995], [69, 164395], [75, 164875], [79, 165035], [85, 165335], [88, 165495]]}, {"verse": 21, "start": 166637, "end": 175504, "text": "Y el hermano entregará al hermano a la muerte, y el padre al hijo; y los hijos se levantarán contra los padres, y los harán morir.", "words": [[0, 166637], [2, 166786], [5, 166966], [13, 167506], [23, 168186], [26, 168386], [34, 168826], [36, 168886], [39, 168926], [47, 169366], [49, 169846], [52, 169966], [58, 170386], [61, 170806], [67, 171465], [69, 171566], [73, 171726], [79, 172006], [82, 172346], [93, 173026], [100, 173366], [104, 173586], [112, 174046], [114, 174411], [118, 174571], [124, 174931]]}, {"verse": 22, "start": 175854, "end": 181696, "text": "Y seréis aborrecidos de todos por mi nombre; pero el que soporte hasta el fin, este será salvo.", "words": [[0, 175854], [2, 175961], [9, 176341], [21, 177121], [24, 177281], [30, 177501], [34, 177781], [37, 177941], [45, 178878], [50, 179038], [53, 179198], [57, 179298], [65, 179778], [71, 179998], [74, 180158], [79, 180638], [84, 180758], [89, 181078]]}, {"verse": 23, "start": 182046, "end": 194968, "text": "Pero cuando os persigan en esta ciudad, huid a la otra: porque de cierto os digo, que no acabaréis de recorrer todas las ciudades de Israel antes de que venga el Hijo del hombre.", "words": [[0, 182046], [5, 182189], [12, 182529], [15, 182849], [24, 183629], [27, 183969], [32, 184249], [40, 184729], [45, 185829], [47, 186029], [50, 186169], [56, 186978], [63, 187202], [66, 187342], [73, 187602], [76, 188002], [82, 188302], [86, 188702], [89, 188882], [99, 189442], [102, 189602], [111, 190282], [117, 190782], [121, 191322], [130, 191982], [133, 192162], [140, 192622], [146, 193022], [149, 193242], [153, 193342], [159, 193702], [162, 193982], [167, 194282], [171, 194462]]}, {"verse": 24, "start": 195318, "end": 199918, "text": "El discípulo no es más que su maestro, ni el siervo más que su señor.", "words": [[0, 195318], [3, 195466], [13, 196086], [16, 196326], [19, 196466], [23, 196626], [27, 196786], [30, 196966], [39, 197746], [42, 198106], [45, 198246], [52, 198746], [56, 198926], [60, 199086], [63, 199246]]}, {"verse": 25, "start": 200268, "end": 210504, "text": "Le basta al discípulo ser como su maestro, y al siervo como su señor. Si al padre de la familia llamaron Beelzebú, ¿cuánto más a los de su casa?", "words": [[0, 200268], [3, 200417], [9, 200717], [12, 201117], [22, 201637], [26, 201917], [31, 202157], [34, 202357], [43, 202957], [45, 203317], [48, 203457], [55, 203937], [60, 204157], [63, 204357], [70, 205159], [73, 205335], [76, 205515], [82, 205955], [85, 206155], [88, 206295], [96, 206815], [105, 207762], [115, 208710], [123, 209050], [127, 209290], [129, 209430], [133, 209570], [136, 209710], [139, 209850]]}, {"verse": 26, "start": 210854, "end": 219484, "text": "Así que, no los temáis; porque nada hay encubierto, que no haya de ser manifestado; ni oculto, que no haya de saberse.", "words": [[0, 210854], [4, 211172], [9, 211332], [12, 211472], [16, 211612], [24, 212579], [31, 212796], [36, 213236], [40, 213576], [52, 214376], [56, 214896], [59, 215116], [64, 215296], [67, 215536], [71, 215716], [84, 216982], [87, 217220], [95, 217880], [99, 218020], [102, 218240], [107, 218480], [110, 218680]]}, {"verse": 27, "start": 219834, "end": 227859, "text": "Lo que os digo en tinieblas, decidlo en la luz; y lo que oís al oído predicadlo desde las azoteas.", "words": [[0, 219834], [3, 219962], [7, 220102], [10, 220242], [15, 220442], [18, 220642], [29, 221662], [37, 222462], [40, 222722], [43, 222862], [48, 223606], [50, 223841], [53, 223981], [57, 224121], [61, 224501], [64, 224761], [69, 225451], [80, 226141], [86, 226461], [90, 226821]]}, {"verse": 28, "start": 228209, "end": 238876, "text": "Y no temáis a los que matan el cuerpo, pero al alma no pueden matar: temed antes a aquel que puede destruir el alma y el cuerpo en el infierno.", "words": [[0, 228209], [2, 228333], [5, 228453], [12, 229013], [14, 229473], [18, 229593], [22, 229713], [28, 230113], [31, 230253], [39, 231193], [44, 231473], [47, 231613], [52, 231893], [55, 232213], [62, 232553], [69, 233443], [75, 233765], [81, 234285], [83, 234805], [89, 235105], [93, 235225], [99, 235505], [108, 236405], [111, 236585], [116, 236925], [118, 237125], [121, 237285], [128, 237725], [131, 237945], [134, 238045]]}, {"verse": 29, "start": 239226, "end": 246191, "text": "¿No se venden dos pajarillos por una moneda pequeña? Con todo, ni uno de ellos cae a tierra sin vuestro Padre.", "words": [[0, 239226], [4, 239354], [7, 239494], [14, 239794], [18, 240034], [29, 240674], [33, 240954], [37, 241134], [44, 241574], [53, 242613], [57, 242737], [63, 242957], [66, 243217], [70, 243477], [73, 243637], [79, 243997], [83, 244597], [85, 244657], [92, 244937], [96, 245217], [104, 245597]]}, {"verse": 30, "start": 246541, "end": 249462, "text": "Pues aun vuestros cabellos están todos contados.", "words": [[0, 246541], [5, 246665], [9, 246885], [18, 247325], [27, 247885], [33, 248165], [39, 248565]]}, {"verse": 31, "start": 249462, "end": 253910, "text": "Así que, no temáis: más valéis vosotros que muchos pajarillos.", "words": [[0, 249462], [4, 249742], [9, 249902], [12, 250042], [20, 250937], [24, 251262], [31, 251902], [40, 252442], [44, 252642], [51, 252882]]}, {"verse": 32, "start": 253910, "end": 261587, "text": "Cualquiera, pues, que me confiese delante de los hombres, le confesaré yo también delante de mi Padre que está en los cielos.", "words": [[0, 253910], [12, 254530], [18, 255430], [22, 255570], [25, 255690], [34, 256290], [42, 256790], [45, 256930], [49, 257050], [58, 257770], [61, 257830], [71, 258570], [74, 258710], [82, 259030], [90, 259650], [93, 259830], [96, 259970], [102, 260390], [106, 260490], [111, 260670], [114, 260810], [118, 260930]]}, {"verse": 33, "start": 261937, "end": 269138, "text": "Y cualquiera que me niegue delante de los hombres, le negaré yo también delante de mi Padre que está en los cielos.", "words": [[0, 261937], [2, 262042], [13, 262542], [17, 262702], [20, 262862], [27, 263282], [35, 263782], [38, 263942], [42, 264062], [51, 265222], [54, 265482], [61, 265882], [64, 266102], [72, 266402], [80, 267002], [83, 267162], [86, 267302], [92, 267702], [96, 267822], [101, 268022], [104, 268162], [108, 268322]]}, {"verse": 34, "start": 269488, "end": 276182, "text": "No penséis que he venido para traer paz en la tierra: no he venido para traer paz, sino espada.", "words": [[0, 269488], [3, 269613], [11, 270093], [15, 270313], [18, 270413], [25, 270773], [30, 270973], [36, 271393], [40, 271753], [43, 272173], [46, 272333], [54, 273236], [57, 273442], [60, 273542], [67, 273922], [72, 274122], [78, 274542], [83, 275282], [88, 275482]]}, {"verse": 35, "start": 276532, "end": 283180, "text": "Porque he venido para poner al hombre contra su padre, a la hija contra su madre y a la nuera contra su suegra.", "words": [[0, 276644], [7, 276794], [10, 276894], [17, 277174], [22, 277394], [28, 277674], [31, 277894], [38, 278154], [45, 278494], [48, 278734], [55, 279574], [57, 279674], [60, 279774], [65, 280134], [72, 280374], [75, 280614], [81, 280974], [83, 281374], [85, 281454], [88, 281554], [94, 281894], [101, 282214], [104, 282474]]}, {"verse": 36, "start": 283530, "end": 286915, "text": "Y los enemigos del hombre serán los de su casa.", "words": [[0, 283530], [2, 283655], [6, 283775], [15, 284375], [19, 284575], [26, 284895], [32, 285495], [36, 285895], [39, 286055], [42, 286215]]}, {"verse": 37, "start": 287265, "end": 295875, "text": "El que ama padre o madre más que a mí, no es digno de mí; y el que ama hijo o hija más que a mí, no es digno de mí.", "words": [[0, 287265], [3, 287431], [7, 287571], [11, 287811], [17, 288291], [19, 288591], [25, 288931], [29, 289231], [33, 289391], [35, 289511], [39, 289611], [42, 290291], [45, 290451], [51, 290891], [54, 290991], [58, 291478], [60, 291636], [63, 291756], [67, 291936], [71, 292336], [76, 292656], [78, 292996], [83, 293336], [87, 293576], [91, 293816], [93, 293936], [97, 294116], [100, 294776], [103, 294936], [109, 295436], [112, 295536]]}, {"verse": 38, "start": 296225, "end": 300998, "text": "Y el que no toma su cruz, y sigue en pos de mí, no es digno de mí.", "words": [[0, 296225], [2, 296445], [5, 296565], [9, 296685], [12, 296905], [17, 297225], [20, 297445], [26, 297945], [28, 298125], [34, 298485], [37, 298825], [41, 299045], [44, 299245], [48, 299765], [51, 299885], [54, 300065], [60, 300525], [63, 300665]]}, {"verse": 39, "start": 301348, "end": 307795, "text": "El que halla su vida, la perderá; y el que pierde su vida por causa de mí, la hallará.", "words": [[0, 301394], [3, 301474], [7, 301674], [13, 301874], [16, 302174], [22, 302954], [25, 303214], [34, 304267], [36, 304392], [39, 304512], [43, 304652], [50, 305092], [53, 305252], [58, 305532], [62, 305752], [68, 306112], [71, 306392], [75, 306572], [78, 307072]]}, {"verse": 40, "start": 308145, "end": 314889, "text": "El que os recibe a vosotros, a mí recibe; y el que a mí recibe, recibe al que me envió.", "words": [[0, 308145], [3, 308424], [7, 308564], [10, 308704], [17, 309224], [19, 309304], [29, 309824], [31, 310124], [34, 310623], [42, 311301], [44, 311480], [47, 311580], [51, 311840], [53, 312000], [56, 312300], [64, 313265], [71, 313665], [74, 313805], [78, 314005], [81, 314205]]}, {"verse": 41, "start": 315239, "end": 327535, "text": "El que recibe profeta en nombre de profeta, recompensa de profeta recibirá; y el que recibe justo en nombre de justo, recompensa de justo recibirá.", "words": [[0, 315239], [3, 315509], [7, 315649], [14, 316169], [22, 316789], [25, 316949], [32, 317369], [35, 317569], [44, 318689], [55, 319769], [58, 319969], [66, 320609], [76, 321703], [78, 321868], [81, 321988], [85, 322188], [92, 322808], [98, 323098], [101, 323388], [108, 323748], [111, 323988], [118, 324928], [129, 326008], [132, 326208], [138, 326528]]}, {"verse": 42, "start": 327885, "end": 338046, "text": "Y cualquiera que dé a uno de estos pequeñitos un vaso de agua fría solamente, por ser discípulo, de cierto os digo, que no perderá su recompensa.", "words": [[0, 327885], [2, 328026], [13, 328646], [17, 328846], [20, 329046], [22, 329286], [26, 329546], [29, 329746], [35, 329966], [46, 330726], [49, 330966], [54, 331366], [57, 331486], [62, 331686], [67, 332126], [78, 332526], [82, 332946], [86, 333186], [97, 334326], [100, 334446], [107, 334866], [110, 335306], [116, 335666], [120, 335901], [123, 336081], [131, 336641], [134, 336821]]}]}