{"book": "LUK", "chapter": 18, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 315838, "verses": [{"verse": 1, "start": 300, "end": 7660, "text": "Y LES PROPUSO también una parábola sobre que es necesario orar siempre, y no desanimarse,", "words": [[0, 300], [2, 442], [6, 562], [14, 1202], [22, 1582], [26, 2022], [35, 2641], [41, 3002], [45, 3282], [48, 3462], [58, 4361], [63, 4982], [72, 5442], [74, 5922], [77, 6082]]}, {"verse": 2, "start": 8010, "end": 13863, "text": "Diciendo: Había un juez en una ciudad, el cual ni temía a Dios, ni respetaba a hombre.", "words": [[0, 8010], [10, 9078], [16, 9143], [19, 9208], [24, 9273], [27, 9573], [31, 9733], [39, 10133], [42, 10493], [47, 10713], [50, 11033], [56, 11473], [58, 11693], [64, 11913], [67, 12473], [77, 13133], [79, 13333]]}, {"verse": 3, "start": 14213, "end": 22476, "text": "Había también en aquella ciudad una viuda, la cual venía a él diciendo: Hazme justicia de mi adversario.", "words": [[0, 14213], [6, 14522], [14, 14962], [17, 15402], [25, 15822], [32, 16202], [36, 16582], [43, 17522], [46, 17742], [51, 17962], [57, 18502], [59, 18722], [62, 18962], [72, 20020], [78, 20436], [87, 21176], [90, 21356], [93, 21456]]}, {"verse": 4, "start": 22756, "end": 31121, "text": "Y él no quiso por algún tiempo; pero después de esto dijo dentro de sí: Aunque ni temo a Dios, ni tengo respeto a hombre,", "words": [[0, 22756], [2, 22916], [5, 23056], [8, 23216], [14, 23576], [18, 23796], [24, 24056], [32, 24979], [37, 25354], [45, 25694], [48, 25894], [53, 26134], [58, 26454], [65, 27014], [68, 27314], [72, 27911], [79, 28111], [82, 28311], [87, 28631], [89, 28711], [95, 29391], [98, 29571], [104, 29871], [112, 30451], [114, 30786]]}, {"verse": 5, "start": 31471, "end": 38720, "text": "Sin embargo, porque esta viuda me es molesta, le haré justicia, para que al fin no venga y me muela.", "words": [[0, 31536], [4, 31601], [13, 32341], [20, 32521], [25, 32801], [31, 33161], [34, 33361], [37, 33501], [46, 34381], [49, 34481], [54, 34721], [64, 35721], [69, 36041], [73, 36221], [76, 36341], [80, 36541], [83, 36761], [89, 37121], [91, 37261], [94, 37361]]}, {"verse": 6, "start": 39000, "end": 42826, "text": "Y dijo el Señor: Oíd lo que dice el juez injusto.", "words": [[0, 39000], [2, 39124], [7, 39424], [10, 39564], [17, 40475], [21, 40887], [24, 41167], [28, 41307], [33, 41587], [36, 41787], [41, 42067]]}, {"verse": 7, "start": 43176, "end": 49215, "text": "¿Y Dios no hará justicia a sus escogidos, que claman a él día y noche, aunque sea paciente con ellos?", "words": [[0, 43176], [3, 43304], [8, 43624], [11, 44039], [16, 44219], [25, 44759], [27, 44939], [31, 45059], [42, 45699], [46, 45839], [53, 46069], [55, 46299], [58, 46479], [62, 46719], [64, 46899], [71, 47519], [78, 47699], [82, 47999], [91, 48499], [95, 48739]]}, {"verse": 8, "start": 49565, "end": 56150, "text": "Os digo que los defenderá pronto. Pero cuando venga el Hijo del hombre, ¿hallará fe en la tierra?", "words": [[0, 49565], [3, 49688], [8, 49988], [12, 50148], [16, 50308], [26, 50888], [34, 51815], [39, 51959], [46, 52219], [52, 52659], [55, 52779], [60, 52999], [64, 53159], [72, 53899], [81, 54539], [84, 54839], [87, 55159], [90, 55319]]}, {"verse": 9, "start": 56500, "end": 63027, "text": "Y dijo también a unos que confiaban de sí como justos, y menospreciaban a los otros, esta parábola:", "words": [[0, 56500], [2, 56611], [7, 56851], [15, 57191], [17, 57451], [22, 57631], [26, 57811], [36, 58411], [39, 58671], [42, 58791], [47, 59071], [55, 59711], [57, 59831], [72, 60771], [74, 60951], [78, 61131], [85, 61971], [90, 62291]]}, {"verse": 10, "start": 63377, "end": 70069, "text": "Dos hombres subieron al templo a orar: el uno fariseo, el otro recaudador de impuestos.", "words": [[0, 63377], [4, 63583], [12, 64073], [21, 64563], [24, 64723], [31, 65303], [33, 65463], [39, 66171], [42, 66452], [46, 66612], [55, 67752], [58, 67852], [63, 68052], [74, 68892], [77, 69092]]}, {"verse": 11, "start": 70419, "end": 83006, "text": "El fariseo, en pie, oraba consigo de esta manera: Dios, te doy gracias, que no soy como los otros hombres, ladrones, injustos, adúlteros, ni aun como este recaudador de impuestos;", "words": [[0, 70419], [3, 70583], [12, 71343], [15, 71483], [20, 71843], [26, 72903], [34, 73383], [37, 73703], [42, 73923], [50, 74791], [56, 74956], [59, 75137], [63, 75357], [72, 76116], [76, 76176], [79, 76357], [83, 76596], [88, 76816], [92, 77017], [98, 77256], [107, 78157], [117, 78997], [127, 79857], [138, 80797], [141, 80997], [145, 81196], [150, 81517], [155, 81736], [166, 82376], [169, 82536]]}, {"verse": 12, "start": 83356, "end": 87615, "text": "Ayuno dos veces a la semana, doy diezmos de todo lo que poseo.", "words": [[0, 83798], [6, 84258], [10, 84438], [16, 84698], [18, 84918], [21, 84978], [29, 85818], [33, 86018], [41, 86398], [44, 86578], [49, 86738], [52, 86918], [56, 87038]]}, {"verse": 13, "start": 87895, "end": 100465, "text": "Pero el recaudador de impuestos estando lejos no quería ni aun alzar los ojos al cielo, sino que se golpeaba el pecho, diciendo: Dios, ten misericordia de mí, pecador.", "words": [[0, 87895], [5, 88117], [8, 88317], [19, 88997], [22, 89237], [32, 89817], [40, 90317], [46, 91017], [49, 91457], [56, 91857], [59, 92257], [63, 92557], [69, 93237], [73, 93597], [78, 93997], [81, 94277], [88, 94817], [93, 95357], [97, 95557], [100, 95697], [109, 96297], [112, 96497], [119, 97237], [129, 98208], [135, 98454], [139, 98674], [152, 99434], [155, 99554], [159, 99894]]}, {"verse": 14, "start": 100745, "end": 112159, "text": "Os digo que este descendió a su casa justificado, a diferencia del otro; porque cualquiera que se enaltece, será humillado; y el que se humilla, será enaltecido.", "words": [[0, 100745], [3, 100868], [8, 101188], [12, 101448], [17, 101668], [27, 102388], [29, 102528], [32, 102648], [37, 102988], [50, 104328], [52, 104548], [63, 104888], [67, 105448], [73, 106166], [80, 106390], [91, 107050], [95, 107230], [98, 107390], [108, 108150], [113, 108470], [124, 109693], [126, 109854], [129, 109954], [133, 110094], [136, 110274], [145, 110694], [150, 111034]]}, {"verse": 15, "start": 112509, "end": 118711, "text": "Y traían a él los niños para que los tocase; lo cual viendo los discípulos les reprendían.", "words": [[0, 112509], [2, 112613], [9, 113153], [11, 113333], [14, 113533], [18, 113713], [24, 114153], [29, 114533], [33, 114713], [37, 114833], [45, 115873], [48, 115980], [53, 116140], [60, 116460], [64, 116680], [75, 117440], [79, 117820]]}, {"verse": 16, "start": 119061, "end": 127486, "text": "Pero Jesús llamándolos, dijo: Dejad los niños venir a mí, y no los impidáis; porque de tales es el reino de Dios.", "words": [[0, 119061], [5, 119207], [11, 119847], [24, 120487], [30, 121211], [36, 121791], [40, 121951], [46, 122331], [52, 122711], [54, 122891], [58, 123071], [60, 123491], [63, 123651], [67, 124239], [77, 125016], [84, 125240], [87, 125460], [93, 125760], [96, 126100], [99, 126300], [105, 126720], [108, 126880]]}, {"verse": 17, "start": 127836, "end": 134765, "text": "De cierto os digo, que cualquiera que no reciba el reino de Dios como un niño, no entrará en él.", "words": [[0, 127836], [3, 128022], [10, 128342], [13, 128722], [19, 129002], [23, 129562], [34, 130182], [38, 130322], [41, 130502], [48, 131062], [51, 131202], [57, 131562], [60, 131722], [65, 131962], [70, 132282], [73, 132522], [79, 132902], [82, 133522], [90, 134182], [93, 134362]]}, {"verse": 18, "start": 135115, "end": 140841, "text": "Y le preguntó un dirigente, diciendo: Maestro bueno, ¿qué haré para poseer la vida eterna?", "words": [[0, 135115], [2, 135223], [5, 135323], [14, 135843], [17, 135923], [28, 136603], [38, 137773], [46, 138254], [53, 138974], [58, 139094], [63, 139354], [68, 139514], [75, 139974], [78, 140074], [83, 140254]]}, {"verse": 19, "start": 141121, "end": 146411, "text": "Y Jesús le dijo: ¿Por qué me llamas bueno? ninguno hay bueno sino sólo Dios.", "words": [[0, 141121], [2, 141232], [8, 141632], [11, 141952], [17, 142759], [22, 142881], [26, 143061], [29, 143201], [36, 143541], [43, 144231], [51, 144698], [55, 144858], [61, 145178], [66, 145438], [71, 145758]]}, {"verse": 20, "start": 146761, "end": 157746, "text": "Los mandamientos sabes: No matarás: No adulterarás: No hurtarás: No dirás falso testimonio: Honra a tu padre y a tu madre.", "words": [[0, 146761], [4, 146886], [17, 147506], [24, 148430], [27, 148710], [36, 149776], [39, 150136], [52, 151494], [55, 152098], [65, 152957], [68, 153217], [74, 153577], [80, 153997], [92, 155156], [98, 155659], [100, 155859], [103, 155979], [109, 156419], [111, 156879], [113, 156979], [116, 157119]]}, {"verse": 21, "start": 158096, "end": 162169, "text": "Y él dijo: Todas estas cosas he guardado desde mi juventud.", "words": [[0, 158096], [2, 158414], [5, 158574], [11, 159329], [17, 159467], [23, 159807], [29, 160247], [32, 160587], [41, 161067], [47, 161287], [50, 161507]]}, {"verse": 22, "start": 162449, "end": 173543, "text": "Y Jesús, oído esto, le dijo: Aún te falta una cosa: vende todo lo que tienes, y da a los pobres, y tendrás tesoro en el cielo; y ven, sígueme.", "words": [[0, 162449], [2, 162571], [9, 162971], [14, 163651], [20, 164351], [23, 164491], [29, 165317], [33, 165540], [36, 165740], [42, 166040], [46, 166280], [52, 167004], [58, 167390], [63, 167690], [66, 167910], [70, 168010], [78, 168390], [80, 168890], [83, 169110], [85, 169230], [89, 169330], [97, 169950], [99, 170330], [107, 170790], [114, 171270], [117, 171390], [120, 171510], [127, 172275], [129, 172458], [134, 172918]]}, {"verse": 23, "start": 173893, "end": 179693, "text": "Entonces él, oídas estas cosas, se puso muy triste, porque era muy rico.", "words": [[0, 173893], [9, 174451], [13, 174871], [19, 175431], [25, 175671], [32, 176411], [35, 176671], [40, 176991], [44, 177351], [52, 177911], [59, 178531], [63, 178791], [67, 179071]]}, {"verse": 24, "start": 180043, "end": 189763, "text": "Y viendo Jesús que se había entristecido mucho, dijo: ¡Con cuánta dificultad entrarán en el reino de Dios los que tienen riquezas!", "words": [[0, 180043], [2, 180166], [9, 180426], [15, 180906], [19, 181426], [22, 181586], [28, 182246], [41, 182906], [48, 183546], [54, 184327], [59, 184475], [66, 185055], [77, 185955], [86, 186715], [89, 186935], [92, 187115], [98, 187515], [101, 187655], [106, 187935], [110, 188375], [114, 188515], [121, 189175]]}, {"verse": 25, "start": 190113, "end": 197116, "text": "Porque más fácil cosa es entrar un camello por el ojo de una aguja, que un rico entrar en el reino de Dios.", "words": [[0, 190113], [7, 190338], [11, 190518], [17, 190918], [22, 191358], [25, 191638], [32, 192078], [35, 192338], [43, 192818], [47, 193058], [50, 193178], [54, 193478], [57, 193598], [61, 193778], [68, 194398], [72, 194583], [75, 194743], [80, 195003], [87, 195523], [90, 195883], [93, 196043], [99, 196403], [102, 196523]]}, {"verse": 26, "start": 197466, "end": 200641, "text": "Y los que lo oían, dijeron: ¿Y quién podrá ser salvo?", "words": [[0, 197466], [2, 197572], [6, 197712], [10, 197872], [13, 198072], [19, 198552], [28, 199305], [31, 199430], [37, 199630], [43, 200030], [47, 200130]]}, {"verse": 27, "start": 200921, "end": 206839, "text": "Y él les dijo: Lo que es imposible para con los hombres, posible es para Dios.", "words": [[0, 200921], [2, 201103], [5, 201303], [9, 201663], [15, 202506], [18, 202648], [22, 202808], [25, 202968], [35, 203808], [40, 204048], [44, 204268], [48, 204448], [57, 205088], [65, 205808], [68, 206048], [73, 206248]]}, {"verse": 28, "start": 207189, "end": 213332, "text": "Entonces Pedro dijo: He aquí, nosotros hemos dejado las posesiones nuestras, y te hemos seguido.", "words": [[0, 207189], [9, 207730], [15, 208290], [21, 209214], [24, 209304], [30, 209544], [39, 209844], [45, 210324], [52, 210824], [56, 210964], [67, 211524], [77, 212004], [79, 212424], [82, 212584], [88, 212744]]}, {"verse": 29, "start": 213612, "end": 223053, "text": "Y él les dijo: De cierto os digo, que nadie hay que haya dejado casa, padres, o hermanos, o mujer, o hijos, por el reino de Dios,", "words": [[0, 213612], [2, 213776], [5, 213926], [9, 214076], [15, 214856], [18, 215063], [25, 215363], [28, 215783], [34, 216063], [38, 216663], [44, 217063], [48, 217543], [52, 217763], [57, 217923], [64, 218443], [70, 218811], [78, 219179], [80, 219547], [90, 219915], [92, 220283], [99, 220743], [101, 220943], [108, 221303], [112, 221883], [115, 222043], [121, 222443], [124, 222603]]}, {"verse": 30, "start": 223403, "end": 228669, "text": "Que no haya de recibir mucho más en este tiempo, y en la era venidera la vida eterna.", "words": [[0, 223403], [4, 223488], [7, 223668], [12, 223888], [15, 224068], [23, 224468], [29, 224848], [33, 225108], [36, 225288], [41, 225488], [49, 225948], [51, 226233], [54, 226413], [57, 226613], [61, 226873], [70, 227493], [73, 227573], [78, 227793]]}, {"verse": 31, "start": 229019, "end": 239959, "text": "Y Jesús, tomando a los doce, les dijo: He aquí subimos a Jerusalén, y serán cumplidas todas las cosas que fueron escritas por los profetas, del Hijo del hombre.", "words": [[0, 229019], [2, 229297], [9, 230017], [17, 230477], [19, 230577], [23, 230697], [29, 231497], [33, 231557], [39, 232332], [42, 232412], [47, 232632], [55, 233212], [57, 233372], [68, 234092], [70, 234592], [76, 234972], [86, 235672], [92, 235952], [96, 236252], [102, 236532], [106, 236752], [113, 237012], [122, 237632], [126, 237852], [130, 238012], [140, 238672], [144, 238997], [149, 239297], [153, 239477]]}, {"verse": 32, "start": 240309, "end": 247294, "text": "Porque será entregado a los gentiles, y será objeto de burlas, e injuriado, y escupido.", "words": [[0, 240309], [7, 240513], [12, 240893], [22, 241873], [24, 241953], [28, 242053], [38, 242773], [40, 243293], [45, 243573], [52, 244193], [55, 244433], [63, 244993], [65, 245293], [76, 246213], [78, 246433]]}, {"verse": 33, "start": 247644, "end": 253061, "text": "Y después que le hayan azotado, le matarán: pero al tercer día resucitará.", "words": [[0, 247644], [2, 247814], [10, 248054], [14, 248234], [17, 248354], [23, 248784], [32, 249214], [35, 249354], [44, 250275], [49, 250699], [52, 250939], [59, 251239], [63, 251699]]}, {"verse": 34, "start": 253411, "end": 261990, "text": "Pero ellos nada de estas cosas entendían, y esta palabra les era encubierta, y no entendían lo que se decía.", "words": [[0, 253411], [5, 253573], [11, 254293], [16, 254633], [19, 254853], [25, 255073], [31, 255513], [42, 256813], [44, 257053], [49, 257273], [57, 257653], [61, 258193], [65, 258433], [77, 259273], [79, 259873], [82, 260053], [92, 260733], [95, 260933], [99, 261073], [102, 261213]]}, {"verse": 35, "start": 262340, "end": 268803, "text": "Y aconteció que acercándose él a Jericó, un ciego estaba sentado junto al camino mendigando;", "words": [[0, 262340], [2, 262463], [12, 263183], [16, 263563], [28, 264323], [31, 264683], [33, 264883], [41, 265863], [44, 266133], [50, 266403], [57, 266623], [65, 267163], [71, 267343], [74, 267563], [81, 267903]]}, {"verse": 36, "start": 269153, "end": 273114, "text": "El cual cuando oyó la gente que pasaba, preguntó qué era aquello.", "words": [[0, 269153], [3, 269343], [8, 269563], [15, 269803], [19, 270263], [22, 270383], [28, 270643], [32, 270823], [40, 271543], [49, 272083], [53, 272263], [57, 272463]]}, {"verse": 37, "start": 273464, "end": 276081, "text": "Y le dijeron que pasaba Jesús nazareno.", "words": [[0, 273464], [2, 273572], [5, 273672], [13, 274172], [17, 274292], [24, 274732], [30, 275072]]}, {"verse": 38, "start": 276431, "end": 282071, "text": "Entonces dio voces, diciendo: Jesús, Hijo de David, ten misericordia de mí.", "words": [[0, 276431], [9, 277049], [13, 277629], [20, 278109], [30, 279056], [37, 279604], [42, 279824], [45, 279944], [52, 280404], [56, 280864], [69, 281644], [72, 281784]]}, {"verse": 39, "start": 282351, "end": 291003, "text": "Y los que iban delante, le reprendían para que callase; pero él clamaba mucho más: Hijo de David, ten misericordia de mí.", "words": [[0, 282351], [2, 282473], [6, 282633], [10, 282833], [15, 283093], [24, 283543], [27, 283993], [38, 284733], [43, 285033], [47, 285253], [56, 286367], [61, 286513], [64, 286773], [72, 287333], [78, 287673], [83, 288555], [88, 288812], [91, 288952], [98, 289512], [102, 289632], [115, 290432], [118, 290572]]}, {"verse": 40, "start": 291283, "end": 297560, "text": "Jesús entonces parándose, mandó traerle a sí: y como él llegó, le preguntó,", "words": [[0, 291283], [6, 292071], [15, 292871], [26, 293691], [32, 294011], [40, 294388], [42, 294765], [46, 295294], [48, 295558], [53, 295798], [56, 296018], [63, 296318], [66, 296838]]}, {"verse": 41, "start": 297910, "end": 302408, "text": "Diciendo: ¿Qué quieres que te haga? Y él dijo: Señor, que vea.", "words": [[0, 297910], [10, 298969], [15, 299073], [23, 299413], [27, 299593], [30, 299753], [36, 300478], [38, 300666], [41, 301001], [47, 301482], [54, 301787], [58, 301987]]}, {"verse": 42, "start": 302688, "end": 307667, "text": "Y Jesús le dijo: Recobra la vista, tu fe te ha hecho salvo.", "words": [[0, 302688], [2, 302811], [8, 303211], [11, 303531], [17, 304560], [25, 304890], [28, 305030], [35, 305870], [38, 306090], [41, 306370], [44, 306610], [47, 306750], [53, 306970]]}, {"verse": 43, "start": 308017, "end": 315438, "text": "Y enseguida vio, y le seguía, glorificando a Dios: y todo el pueblo como lo vio, dio a Dios alabanza.", "words": [[0, 308017], [2, 308151], [12, 308631], [17, 308971], [19, 309351], [22, 309471], [30, 309871], [43, 310731], [45, 310831], [51, 311542], [53, 311670], [58, 311910], [61, 312210], [68, 312610], [73, 312830], [76, 313030], [81, 313670], [85, 313930], [87, 314190], [92, 314848]]}]}