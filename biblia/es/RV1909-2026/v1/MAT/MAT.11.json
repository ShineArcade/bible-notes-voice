{"book": "MAT", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 256966, "verses": [{"verse": 1, "start": 300, "end": 9529, "text": "Y fue, que acabando Jesús de dar instrucciones a sus doce discípulos, se fue de allí a enseñar y a predicar en las ciudades de ellos.", "words": [[0, 300], [2, 405], [7, 565], [11, 925], [20, 1425], [26, 1765], [29, 2065], [33, 2265], [47, 3285], [49, 3545], [53, 3705], [58, 4185], [70, 5505], [73, 5745], [77, 5925], [80, 6105], [85, 6305], [87, 6425], [95, 7105], [97, 7245], [99, 7325], [108, 7845], [111, 8045], [115, 8205], [124, 8745], [127, 8905]]}, {"verse": 2, "start": 9979, "end": 16011, "text": "Y oyendo Juan en la prisión los hechos de Cristo, le envió dos de sus discípulos,", "words": [[0, 9979], [2, 10142], [9, 10522], [14, 10862], [17, 11162], [20, 11462], [28, 11762], [32, 11982], [39, 12302], [42, 12462], [50, 13382], [53, 13682], [59, 14122], [63, 14462], [66, 14642], [70, 14842]]}, {"verse": 3, "start": 16461, "end": 21177, "text": "Diciendo: ¿Eres tú aquel que había de venir, o esperaremos a otro?", "words": [[0, 16461], [10, 17598], [16, 17839], [19, 18099], [25, 18479], [29, 18599], [35, 18779], [38, 18979], [45, 19279], [47, 19839], [59, 20459], [61, 20719]]}, {"verse": 4, "start": 21527, "end": 28492, "text": "Y respondiendo Jesús, les dijo: Id, y haced saber a Juan las cosas que oís y veis:", "words": [[0, 21527], [2, 21649], [15, 22369], [22, 22819], [26, 23269], [32, 24203], [36, 24353], [38, 24833], [44, 25313], [50, 25733], [52, 25873], [57, 26173], [61, 26653], [67, 26953], [71, 27233], [75, 27693], [77, 27953]]}, {"verse": 5, "start": 28942, "end": 41248, "text": "Los ciegos ven, y los cojos andan; los leprosos son limpiados, y los sordos oyen; los muertos son resucitados, y a los pobres es anunciado el evangelio.", "words": [[0, 28942], [4, 29049], [11, 29569], [16, 29989], [18, 30569], [22, 30709], [28, 31209], [35, 32291], [39, 32410], [48, 33070], [52, 33350], [63, 34150], [65, 34410], [69, 34590], [76, 35190], [82, 36187], [86, 36311], [94, 36731], [98, 37011], [111, 37951], [113, 38491], [115, 38591], [119, 38691], [126, 39131], [129, 39331], [139, 40131], [142, 40311]]}, {"verse": 6, "start": 41698, "end": 45059, "text": "Y bienaventurado es el que no tropiece por causa de mí.", "words": [[0, 41698], [2, 41964], [17, 42924], [20, 43084], [23, 43204], [27, 43344], [30, 43484], [39, 43964], [43, 44204], [49, 44464], [52, 44744]]}, {"verse": 7, "start": 45509, "end": 55530, "text": "Y al irse ellos, comenzó Jesús a decir de Juan a la gente: ¿Qué salisteis a ver al desierto? ¿una caña que es sacudida por el viento?", "words": [[0, 45509], [2, 45664], [5, 45804], [10, 46144], [17, 46604], [25, 47524], [31, 47804], [33, 48144], [39, 48464], [42, 48704], [47, 48984], [49, 49264], [52, 49324], [59, 50244], [64, 50493], [74, 51173], [76, 51333], [80, 51453], [83, 51613], [93, 52478], [98, 53122], [103, 53582], [107, 53782], [110, 54022], [119, 54602], [123, 54802], [126, 54942]]}, {"verse": 8, "start": 55980, "end": 65695, "text": "Pero ¿qué salisteis a ver? ¿un hombre cubierto de delicados vestidos? He aquí, los que traen vestidos delicados, en las casas de los reyes están.", "words": [[0, 55980], [5, 55980], [10, 56285], [20, 56905], [22, 57025], [27, 57693], [31, 57837], [38, 58137], [47, 58817], [50, 58997], [60, 59617], [70, 60782], [73, 60862], [79, 61122], [83, 61342], [87, 61482], [93, 61822], [102, 62262], [113, 62962], [116, 63302], [120, 63442], [126, 63822], [129, 63922], [133, 64162], [139, 64402]]}, {"verse": 9, "start": 66145, "end": 71264, "text": "Pero ¿qué salisteis a ver? ¿un profeta? También os digo, y más que profeta.", "words": [[0, 66145], [5, 66145], [10, 66451], [20, 67071], [22, 67191], [27, 67858], [31, 68098], [40, 69190], [48, 69460], [51, 69730], [57, 70010], [59, 70290], [63, 70430], [67, 70570]]}, {"verse": 10, "start": 71714, "end": 79709, "text": "Porque este es de quien está escrito: He aquí, yo envío mi mensajero delante de ti, que preparará tu camino delante de ti.", "words": [[0, 71714], [7, 71956], [12, 72256], [15, 72596], [18, 72756], [24, 72936], [29, 73236], [38, 74265], [41, 74345], [47, 74605], [50, 75245], [56, 75665], [59, 75825], [69, 76505], [77, 76905], [80, 77085], [84, 77285], [88, 77465], [98, 78045], [101, 78245], [108, 78565], [116, 79145], [119, 79345]]}, {"verse": 11, "start": 80159, "end": 91389, "text": "De cierto os digo, que no se levantó entre los que nacen de mujeres otro mayor que Juan el Bautista; pero el más pequeño en el reino de los cielos, mayor es que él.", "words": [[0, 80347], [3, 80572], [10, 80797], [13, 81022], [19, 81562], [23, 81642], [26, 81802], [29, 81962], [37, 82622], [43, 83042], [47, 83282], [51, 83462], [57, 83882], [60, 84022], [68, 84482], [73, 84902], [79, 85302], [83, 85522], [88, 85822], [91, 86363], [101, 87152], [106, 87318], [109, 87478], [113, 87658], [121, 88118], [124, 88378], [127, 88498], [133, 88878], [136, 88998], [140, 89158], [148, 89918], [154, 90318], [157, 90678], [161, 90838]]}, {"verse": 12, "start": 91839, "end": 100216, "text": "Desde los días de Juan el Bautista hasta ahora, al reino de los cielos se hace fuerza, y los valientes lo arrebatan.", "words": [[0, 91839], [6, 92004], [10, 92224], [15, 92464], [18, 92644], [23, 93144], [26, 93244], [35, 94084], [41, 94184], [48, 95164], [51, 95304], [57, 95684], [60, 95804], [64, 95944], [71, 96484], [74, 96644], [79, 96844], [87, 97344], [89, 97884], [93, 98024], [103, 98544], [106, 99104]]}, {"verse": 13, "start": 100666, "end": 104595, "text": "Porque todos los profetas y la ley hasta Juan profetizaron.", "words": [[0, 100666], [7, 100848], [13, 101248], [17, 101648], [26, 102148], [28, 102328], [31, 102448], [35, 102728], [41, 103088], [46, 103448]]}, {"verse": 14, "start": 105045, "end": 109251, "text": "Y si queréis recibir, él es aquel Elías que había de venir.", "words": [[0, 105045], [2, 105211], [5, 105291], [13, 105771], [22, 107031], [25, 107291], [28, 107451], [34, 107771], [40, 108251], [44, 108391], [50, 108611], [53, 108811]]}, {"verse": 15, "start": 109701, "end": 112516, "text": "El que tiene oídos para oír, oiga.", "words": [[0, 109701], [3, 109827], [7, 109967], [13, 110327], [19, 110987], [24, 111247], [29, 112027]]}, {"verse": 16, "start": 112966, "end": 122259, "text": "Pero ¿a quién compararé esta generación? Es semejante a los muchachos que se sientan en las plazas, y dan voces a sus compañeros,", "words": [[0, 112966], [5, 113148], [8, 113548], [14, 113788], [24, 114588], [29, 114908], [41, 116199], [44, 116426], [54, 117146], [56, 117226], [60, 117326], [70, 117886], [74, 117966], [77, 118126], [85, 118626], [88, 118746], [92, 118886], [100, 119766], [102, 119886], [106, 120026], [112, 120466], [114, 120566], [118, 120726]]}, {"verse": 17, "start": 122709, "end": 130367, "text": "Y dicen: Tocamos la flauta para vosotros, y no bailasteis; cantamos canciones de duelo para vosotros, y no lamentasteis.", "words": [[0, 122890], [2, 123107], [9, 123625], [17, 123625], [20, 123625], [27, 124005], [32, 124205], [42, 124745], [44, 125005], [47, 125145], [59, 126458], [68, 127102], [78, 127622], [81, 127862], [87, 128202], [92, 128422], [102, 128942], [104, 129222], [107, 129382]]}, {"verse": 18, "start": 130817, "end": 135778, "text": "Porque vino Juan, que ni comía ni bebía, y dicen: Demonio tiene.", "words": [[0, 130817], [7, 130998], [12, 131278], [18, 131698], [22, 132238], [25, 132418], [31, 132838], [34, 132998], [41, 133518], [43, 133718], [50, 134912], [58, 135212]]}, {"verse": 19, "start": 136228, "end": 149176, "text": "Vino el Hijo del hombre, que come y bebe, y dicen: He aquí un hombre comilón, y bebedor de vino, amigo de publicanos y de pecadores. Pero la sabiduría es justificada por sus hijos.", "words": [[0, 136228], [5, 136513], [8, 136713], [13, 137013], [17, 137173], [25, 137773], [29, 138093], [34, 138433], [36, 138693], [42, 139073], [44, 139273], [51, 140180], [54, 140325], [59, 140605], [62, 140785], [69, 141045], [78, 141865], [80, 142305], [88, 142745], [91, 142905], [97, 143765], [103, 143965], [106, 144165], [117, 144845], [119, 145125], [122, 145225], [133, 146423], [138, 146547], [141, 146967], [151, 147387], [154, 147447], [166, 148147], [170, 148327], [174, 148547]]}, {"verse": 20, "start": 149626, "end": 159076, "text": "Entonces comenzó a reprender a las ciudades en las cuales habían sido hechas muchas de sus maravillas, porque no se habían arrepentido, diciendo:", "words": [[0, 149626], [9, 150105], [17, 150805], [19, 150885], [29, 151385], [31, 151525], [35, 151645], [44, 152165], [47, 152325], [51, 152485], [58, 152685], [65, 153105], [70, 153485], [77, 153765], [84, 154085], [87, 154345], [91, 154485], [103, 155105], [110, 155725], [113, 156305], [116, 156485], [123, 156785], [136, 158045]]}, {"verse": 21, "start": 159526, "end": 174468, "text": "¡Ay de ti, Corazín! ¡Ay de ti, Betsaida! porque si en Tiro y en Sidón fueran hechas las maravillas que han sido hechas en vosotras, en otro tiempo se hubieran arrepentido con ropa de luto y ceniza.", "words": [[0, 159526], [4, 160050], [7, 160090], [11, 160700], [20, 161610], [24, 162110], [27, 162568], [31, 163026], [41, 163734], [48, 163958], [51, 164238], [54, 164698], [59, 164998], [61, 165218], [64, 165568], [70, 165918], [77, 166638], [84, 167018], [88, 167218], [99, 167838], [103, 168018], [107, 168158], [112, 168478], [119, 168858], [122, 169078], [132, 170118], [135, 170238], [140, 170458], [147, 170838], [150, 171078], [159, 171458], [171, 172438], [175, 172598], [180, 173118], [183, 173258], [188, 173618], [190, 173758]]}, {"verse": 22, "start": 174918, "end": 181798, "text": "Por tanto os digo, que a Tiro y a Sidón será más tolerable el castigo en el día del juicio, que a vosotras.", "words": [[0, 174918], [4, 175042], [10, 175522], [13, 175622], [19, 175802], [23, 176102], [25, 176402], [30, 176702], [32, 176955], [34, 177209], [40, 177462], [45, 177682], [49, 177942], [59, 178582], [62, 178722], [70, 179242], [73, 179362], [76, 179462], [80, 179702], [84, 179862], [92, 180442], [96, 180882], [98, 181002]]}, {"verse": 23, "start": 182248, "end": 198232, "text": "Y tú, Capernaum, que eres levantada hasta el cielo, hasta los infiernos serás abatida; porque si en los de Sodoma fueran hechas las maravillas que han sido hechas en ti, hubieran quedado hasta el día de hoy.", "words": [[0, 182248], [2, 182389], [6, 182589], [17, 183929], [21, 184189], [26, 184429], [36, 185249], [42, 185449], [45, 185609], [52, 186109], [58, 186869], [62, 187089], [72, 187836], [78, 188584], [87, 189585], [94, 189867], [97, 190247], [100, 190467], [104, 190840], [107, 191214], [114, 191587], [121, 192087], [128, 192567], [132, 192927], [143, 193707], [147, 193967], [151, 194187], [156, 194487], [163, 194887], [166, 195107], [170, 195707], [179, 196447], [187, 197007], [193, 197267], [196, 197467], [200, 197687], [203, 197867]]}, {"verse": 24, "start": 198682, "end": 207426, "text": "Por tanto os digo, que a la tierra de los de Sodoma será más tolerable el castigo en el día del juicio, que a ti.", "words": [[0, 198682], [4, 198826], [10, 199326], [13, 199586], [19, 199986], [23, 200626], [25, 200746], [28, 200826], [35, 201246], [38, 201506], [42, 201781], [45, 202056], [52, 202331], [57, 202606], [61, 202906], [71, 204086], [74, 204366], [82, 205126], [85, 205266], [88, 205406], [92, 205586], [96, 205766], [104, 206526], [108, 206946], [110, 207086]]}, {"verse": 25, "start": 207876, "end": 221711, "text": "En aquel tiempo, respondiendo Jesús, dijo: Te alabo, Padre, Señor del cielo y de la tierra, que hayas escondido estas cosas de los sabios y de los entendidos, y las hayas revelado a los niños.", "words": [[0, 207876], [3, 207982], [9, 208262], [17, 209102], [30, 209962], [37, 210742], [43, 211596], [46, 211682], [53, 212002], [60, 212822], [66, 213262], [70, 213562], [76, 214002], [78, 214222], [81, 214302], [84, 214422], [92, 215262], [96, 215462], [102, 215802], [112, 216502], [118, 216642], [124, 217122], [127, 217362], [131, 217482], [138, 218002], [140, 218162], [143, 218242], [147, 218382], [159, 219142], [161, 219622], [165, 219782], [171, 220122], [180, 220722], [182, 220822], [186, 220942]]}, {"verse": 26, "start": 222161, "end": 224643, "text": "Así, Padre, pues que así te agradó.", "words": [[0, 222161], [5, 222583], [12, 223383], [17, 223503], [21, 223683], [25, 223863], [28, 224043]]}, {"verse": 27, "start": 225093, "end": 237360, "text": "Todas las cosas me son entregadas de mi Padre: y nadie conoció al Hijo, sino el Padre; ni al Padre conoció alguno, sino el Hijo, y aquel a quien el Hijo lo quiera revelar.", "words": [[0, 225093], [6, 225337], [10, 225457], [16, 225737], [19, 225977], [23, 226157], [34, 226737], [37, 226897], [40, 227017], [47, 227881], [49, 228248], [55, 228528], [63, 229148], [66, 229368], [72, 229908], [77, 230128], [80, 230348], [87, 231447], [90, 231657], [93, 231867], [99, 232077], [107, 232697], [115, 233317], [120, 233517], [123, 233877], [129, 234957], [131, 235057], [137, 235377], [139, 235497], [145, 235657], [148, 235917], [153, 236137], [156, 236297], [163, 236617]]}, {"verse": 28, "start": 237810, "end": 242980, "text": "Venid a mí todos los que estáis cansados y cargados, que yo os haré descansar.", "words": [[0, 237810], [6, 238148], [8, 238248], [11, 238368], [17, 238708], [21, 238968], [25, 239381], [32, 239795], [41, 240208], [43, 240388], [53, 241168], [57, 241488], [60, 241728], [63, 241908], [68, 242148]]}, {"verse": 29, "start": 243430, "end": 252981, "text": "Llevad mi yugo sobre vosotros, y aprended de mí, que soy manso y humilde de corazón; y hallaréis descanso para vuestras almas.", "words": [[0, 243430], [7, 243738], [10, 244078], [15, 244418], [21, 244618], [31, 245278], [33, 245538], [42, 246158], [45, 246378], [49, 247018], [53, 247278], [57, 247498], [63, 248258], [65, 248538], [73, 248998], [76, 249178], [85, 250287], [87, 250434], [97, 250914], [106, 251694], [111, 251914], [120, 252354]]}, {"verse": 30, "start": 253431, "end": 256566, "text": "Porque mi yugo es fácil, y ligera mi carga.", "words": [[0, 253431], [7, 253613], [10, 253903], [15, 254193], [18, 254373], [25, 254793], [27, 255353], [34, 255813], [37, 255973]]}]}