{"book": "JHN", "chapter": 9, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 276046, "verses": [{"verse": 1, "start": 300, "end": 4982, "text": "And as Jesus passed by, he saw a man which was blind from his birth.", "words": [[0, 300], [4, 446], [7, 626], [13, 906], [20, 1326], [24, 2286], [27, 2346], [31, 2626], [33, 2846], [37, 3126], [43, 3426], [47, 3626], [53, 4026], [58, 4306], [62, 4486]]}, {"verse": 2, "start": 5332, "end": 11939, "text": "And his disciples asked him, saying, Master, who did sin, this man, or his parents, that he was born blind?", "words": [[0, 5332], [4, 5470], [8, 5610], [18, 6150], [24, 6610], [29, 6890], [37, 7639], [45, 7959], [49, 8159], [53, 8359], [58, 8979], [63, 9119], [68, 9659], [71, 9879], [75, 10039], [84, 10739], [89, 10879], [92, 10999], [96, 11139], [101, 11379]]}, {"verse": 3, "start": 12219, "end": 20005, "text": "Jesus answered, Neither has this man sinned, nor his parents: but that the works of God should be made manifest in him.", "words": [[0, 12219], [6, 12497], [16, 13468], [24, 13812], [28, 14192], [33, 14412], [37, 14712], [45, 15452], [49, 15772], [53, 16032], [62, 16953], [66, 17037], [71, 17197], [75, 17337], [81, 17577], [84, 17777], [88, 18117], [95, 18397], [98, 18577], [103, 18837], [112, 19337], [115, 19677]]}, {"verse": 4, "start": 20355, "end": 25972, "text": "I must work the works of him that sent me, while it is day: the night comes, when no man can work.", "words": [[0, 20355], [2, 20595], [7, 20775], [12, 21055], [16, 21235], [22, 21455], [25, 21675], [29, 21855], [34, 22075], [39, 22355], [43, 22575], [49, 22975], [52, 23155], [55, 23275], [60, 23941], [64, 24025], [70, 24205], [77, 24565], [82, 24805], [85, 25005], [89, 25245], [93, 25485]]}, {"verse": 5, "start": 26322, "end": 29546, "text": "As long as I am in the world, I am the light of the world.", "words": [[0, 26322], [3, 26462], [8, 26682], [11, 26902], [13, 27062], [16, 27142], [19, 27262], [23, 27362], [30, 28062], [32, 28242], [35, 28362], [39, 28502], [45, 28762], [48, 28902], [52, 29022]]}, {"verse": 6, "start": 29826, "end": 38189, "text": "When he had thus spoken, he spat on the ground, and made clay of the spittle, and he anointed the eyes of the blind man with the clay,", "words": [[0, 29826], [5, 29995], [8, 30175], [12, 30355], [17, 30535], [25, 31515], [28, 31595], [33, 31895], [36, 32155], [40, 32275], [48, 32615], [52, 33215], [57, 33435], [62, 33815], [65, 34015], [69, 34195], [78, 34975], [82, 35175], [85, 35315], [94, 35695], [98, 35935], [103, 36275], [106, 36475], [110, 36595], [116, 36895], [120, 37275], [125, 37475], [129, 37635]]}, {"verse": 7, "start": 38539, "end": 48232, "text": "And said to him, Go, wash in the pool of Siloam, (which is by interpretation, Sent.) He went his way therefore, and washed, and came seeing.", "words": [[0, 38539], [4, 38819], [9, 39019], [12, 39239], [17, 40242], [21, 40414], [26, 40854], [29, 41074], [33, 41194], [38, 41494], [41, 41674], [49, 42551], [56, 42754], [59, 42914], [62, 43094], [78, 43734], [85, 44754], [88, 44914], [93, 45134], [97, 45314], [101, 45534], [112, 46034], [116, 46494], [124, 47274], [128, 47334], [133, 47554]]}, {"verse": 8, "start": 48582, "end": 54965, "text": "¶ The neighbours therefore, and they which before had seen him that he was blind, said, Is not this he that sat and begged?", "words": [[2, 48582], [6, 48757], [17, 48967], [28, 49707], [32, 49827], [37, 50027], [43, 50267], [50, 50627], [54, 50867], [59, 51107], [63, 51427], [68, 51507], [71, 51607], [75, 51767], [82, 52367], [88, 53045], [91, 53180], [95, 53360], [100, 53660], [103, 53893], [108, 54127], [112, 54360], [116, 54500]]}, {"verse": 9, "start": 55245, "end": 60835, "text": "Some said, This is he: others said, He is like him: but he said, I am he.", "words": [[0, 55245], [5, 55419], [11, 56109], [16, 56275], [19, 56415], [23, 57075], [30, 57304], [36, 58052], [39, 58213], [42, 58333], [47, 58513], [52, 59233], [56, 59378], [59, 59498], [65, 60146], [67, 60286], [70, 60406]]}, {"verse": 10, "start": 61115, "end": 64417, "text": "Therefore said they to him, How were your eyes opened?", "words": [[0, 61115], [10, 61422], [15, 61762], [20, 61982], [23, 62182], [28, 62708], [32, 62944], [37, 63144], [42, 63344], [47, 63724]]}, {"verse": 11, "start": 64697, "end": 75146, "text": "He answered and said, A man that is called Jesus made clay, and anointed my eyes, and said to me, Go to the pool of Siloam, and wash: and I went and washed, and I received sight.", "words": [[0, 64697], [3, 64811], [12, 65111], [16, 65331], [22, 65987], [24, 66112], [28, 66292], [33, 66432], [36, 66572], [43, 66752], [49, 67132], [54, 67492], [60, 67872], [64, 68372], [73, 68732], [76, 68972], [82, 69272], [86, 69492], [91, 69712], [94, 69892], [98, 70192], [101, 70552], [104, 70752], [108, 70872], [113, 71132], [116, 71272], [124, 71752], [128, 71972], [134, 72761], [138, 72880], [140, 73000], [145, 73200], [149, 73420], [157, 73720], [161, 74020], [163, 74120], [172, 74520]]}, {"verse": 12, "start": 75426, "end": 79629, "text": "Then said they to him, Where is he? He said, I know not.", "words": [[0, 75426], [5, 75667], [10, 75987], [15, 76207], [18, 76407], [23, 76957], [29, 77156], [32, 77396], [36, 77904], [39, 77986], [45, 78675], [47, 78872], [52, 79072]]}, {"verse": 13, "start": 79909, "end": 83208, "text": "¶ They brought to the Pharisees him that before was blind.", "words": [[2, 79909], [7, 80035], [15, 80275], [18, 80495], [22, 80635], [32, 81315], [36, 81555], [41, 81855], [48, 82215], [52, 82555]]}, {"verse": 14, "start": 83558, "end": 87924, "text": "And it was the sabbath day when Jesus made the clay, and opened his eyes.", "words": [[0, 83558], [4, 83679], [7, 83759], [11, 83899], [15, 84039], [23, 84379], [27, 84819], [32, 85079], [38, 85359], [43, 85739], [47, 85919], [53, 86219], [57, 86759], [64, 87039], [68, 87299]]}, {"verse": 15, "start": 88274, "end": 97267, "text": "Then again the Pharisees also asked him how he had received his sight. He said to them, He put clay upon my eyes, and I washed, and do see.", "words": [[0, 88274], [5, 88496], [11, 88996], [15, 89056], [25, 89776], [30, 90076], [36, 90536], [40, 90716], [44, 90976], [47, 91196], [51, 91376], [60, 91796], [64, 92056], [71, 92800], [74, 92930], [79, 93190], [82, 93390], [88, 94048], [91, 94162], [95, 94275], [100, 94555], [105, 94735], [108, 94995], [114, 95315], [118, 95675], [120, 95795], [128, 96215], [132, 96675], [135, 96855]]}, {"verse": 16, "start": 97547, "end": 109208, "text": "Therefore said some of the Pharisees, This man is not of God, because he keeps not the sabbath day. Others said, How can a man that is a sinner do such miracles? And there was a division among them.", "words": [[0, 97547], [10, 97901], [15, 98261], [20, 98521], [23, 98701], [27, 98801], [38, 99891], [43, 100028], [47, 100248], [50, 100368], [54, 100528], [57, 100668], [62, 100908], [70, 101368], [73, 101608], [79, 101828], [83, 102128], [87, 102348], [95, 102608], [100, 103368], [107, 103597], [113, 104345], [117, 104525], [121, 104745], [123, 104845], [127, 105025], [132, 105205], [135, 105325], [137, 105405], [144, 105705], [147, 106045], [152, 106325], [162, 107367], [166, 107512], [172, 107672], [176, 107892], [178, 108052], [187, 108432], [193, 108732]]}, {"verse": 17, "start": 109558, "end": 116623, "text": "They say to the blind man again, What do you say of him, that he has opened your eyes? He said, He is a prophet.", "words": [[0, 109558], [5, 109681], [9, 109881], [12, 110061], [16, 110181], [22, 110501], [26, 110801], [33, 111697], [38, 111857], [41, 111977], [45, 112097], [49, 112297], [52, 112457], [57, 112717], [62, 113157], [65, 113317], [69, 113517], [76, 113837], [81, 114037], [87, 114791], [90, 114873], [96, 115562], [99, 115754], [102, 115934], [104, 116034]]}, {"verse": 18, "start": 116903, "end": 125328, "text": "But the Jews did not believe concerning him, that he had been blind, and received his sight, until they called the parents of him that had received his sight.", "words": [[0, 116903], [4, 117063], [8, 117183], [13, 117463], [17, 117763], [21, 117923], [29, 118303], [40, 118843], [45, 119243], [50, 119743], [53, 119903], [57, 120043], [62, 120223], [69, 120603], [73, 120863], [82, 121243], [86, 121463], [93, 121783], [99, 122383], [104, 122643], [111, 122883], [115, 123103], [123, 123443], [126, 123683], [130, 123863], [135, 124063], [139, 124223], [148, 124603], [152, 124863]]}, {"verse": 19, "start": 125678, "end": 131763, "text": "And they asked them, saying, Is this your son, who you say was born blind? how then does he now see?", "words": [[0, 125678], [4, 125795], [9, 125955], [15, 126255], [21, 126495], [29, 127285], [32, 127445], [37, 127625], [42, 127845], [47, 128225], [51, 128705], [55, 128865], [59, 129125], [63, 129325], [68, 129605], [75, 130445], [79, 130591], [84, 130811], [89, 131011], [92, 131171], [96, 131331]]}, {"verse": 20, "start": 132043, "end": 136853, "text": "His parents answered them and said, We know that this is our son, and that he was born blind:", "words": [[0, 132043], [4, 132152], [12, 132512], [21, 132972], [26, 133212], [30, 133412], [36, 134014], [39, 134118], [44, 134258], [49, 134398], [54, 134578], [57, 134698], [61, 134858], [66, 135198], [70, 135578], [75, 135718], [78, 135838], [82, 135998], [87, 136258]]}, {"verse": 21, "start": 137203, "end": 145334, "text": "But by what means he now sees, we know not; or who has opened his eyes, we know not: he is of age; ask him: he shall speak for himself.", "words": [[0, 137203], [4, 137302], [7, 137442], [12, 137622], [18, 137882], [21, 138042], [25, 138222], [31, 138862], [34, 139042], [39, 139222], [44, 139895], [47, 140016], [51, 140176], [55, 140376], [62, 140676], [66, 140916], [72, 141316], [75, 141376], [80, 141576], [85, 142214], [88, 142436], [91, 142556], [94, 142696], [99, 143309], [103, 143531], [108, 144006], [111, 144114], [117, 144294], [123, 144554], [127, 144774]]}, {"verse": 22, "start": 145614, "end": 155714, "text": "These words spoke his parents, because they feared the Jews: for the Jews had agreed already, that if any man did confess that he was Christ, he should be put out of the synagogue.", "words": [[0, 145614], [6, 145767], [12, 146107], [18, 146397], [22, 146687], [31, 147147], [39, 147492], [44, 147752], [51, 148072], [55, 148272], [61, 149180], [65, 149273], [69, 149413], [74, 149673], [78, 149893], [85, 150213], [94, 150733], [99, 151253], [102, 151393], [106, 151573], [110, 151853], [114, 152073], [122, 152533], [127, 152793], [130, 152933], [134, 153093], [142, 153993], [145, 154033], [152, 154193], [155, 154333], [159, 154533], [163, 154713], [166, 154833], [170, 154933]]}, {"verse": 23, "start": 156064, "end": 159371, "text": "Therefore said his parents, He is of age; ask him.", "words": [[0, 156064], [10, 156409], [15, 156729], [19, 156909], [28, 157751], [31, 157914], [34, 158114], [37, 158274], [42, 158913], [46, 159098]]}, {"verse": 24, "start": 159651, "end": 166970, "text": "Then again called they the man that was blind, and said to him, Give God the praise: we know that this man is a sinner.", "words": [[0, 159651], [5, 159830], [11, 160110], [18, 160652], [23, 161135], [27, 161255], [31, 161495], [36, 161695], [40, 161875], [47, 162675], [51, 162835], [56, 163075], [59, 163295], [64, 163841], [69, 164026], [73, 164306], [77, 164486], [85, 165272], [88, 165373], [93, 165573], [98, 165733], [103, 165893], [107, 166213], [110, 166413], [112, 166513]]}, {"verse": 25, "start": 167250, "end": 174433, "text": "He answered and said, Whether he be a sinner or no, I know not: one thing I know, that, whereas I was blind, now I see.", "words": [[0, 167250], [3, 167364], [12, 167664], [16, 167884], [22, 168540], [30, 168722], [33, 168922], [36, 169042], [38, 169182], [45, 169422], [48, 169662], [52, 170102], [54, 170202], [59, 170362], [64, 170982], [68, 171144], [74, 171344], [76, 171504], [82, 171744], [88, 172164], [96, 172764], [98, 173004], [102, 173104], [109, 173464], [113, 173904], [115, 174064]]}, {"verse": 26, "start": 174713, "end": 179333, "text": "Then said they to him again, What did he to you? how opened he your eyes?", "words": [[0, 174713], [5, 174935], [10, 175255], [15, 175475], [18, 175635], [22, 175855], [29, 176698], [34, 176818], [38, 176978], [41, 177358], [44, 177358], [49, 177915], [53, 178060], [60, 178420], [63, 178620], [68, 178840]]}, {"verse": 27, "start": 179613, "end": 187058, "text": "He answered them, I have told you already, and you did not hear: why would you hear it again? will you also be his disciples?", "words": [[0, 179613], [3, 179723], [12, 180023], [18, 180659], [20, 180819], [25, 180959], [30, 181199], [34, 181419], [43, 181799], [47, 182319], [51, 182439], [55, 182599], [59, 182819], [65, 183542], [69, 183822], [75, 184062], [79, 184182], [84, 184422], [87, 184542], [94, 185270], [99, 185360], [103, 185480], [108, 185840], [111, 186080], [115, 186240]]}, {"verse": 28, "start": 187338, "end": 192606, "text": "Then they reviled him, and said, You are his disciple; but we are Moses’ disciples.", "words": [[0, 187338], [5, 187604], [10, 187804], [18, 188344], [23, 188504], [27, 188724], [33, 189330], [37, 189508], [41, 189688], [45, 189828], [55, 190690], [59, 190816], [62, 191016], [66, 191276], [73, 191936]]}, {"verse": 29, "start": 192956, "end": 198014, "text": "We know that God spoke to Moses: as for this fellow, we know not from where he is.", "words": [[0, 192956], [3, 193099], [8, 193379], [13, 193599], [17, 193839], [23, 194139], [26, 194339], [33, 195119], [36, 195293], [40, 195473], [45, 195693], [53, 196353], [56, 196453], [61, 196633], [65, 196913], [70, 197133], [76, 197353], [79, 197553]]}, {"verse": 30, "start": 198294, "end": 205829, "text": "The man answered and said to them, Why herein is a marvellous thing, that you know not from where he is, and yet he has opened my eyes.", "words": [[0, 198294], [4, 198391], [8, 198631], [17, 199091], [21, 199311], [26, 199491], [29, 199691], [35, 200218], [39, 200515], [46, 200845], [49, 200985], [51, 201185], [62, 201385], [69, 202065], [74, 202245], [78, 202385], [83, 202545], [87, 202785], [92, 203005], [98, 203225], [101, 203385], [105, 203865], [109, 204045], [113, 204225], [116, 204405], [120, 204605], [127, 204985], [130, 205245]]}, {"verse": 31, "start": 206179, "end": 212992, "text": "Now we know that God hears not sinners: but if any man be a worshipper of God, and does his will, him he hears.", "words": [[0, 206179], [4, 206363], [7, 206583], [12, 206763], [17, 206963], [21, 207203], [27, 207783], [31, 207863], [40, 208772], [44, 208891], [47, 209011], [51, 209271], [55, 209531], [58, 209731], [60, 209811], [71, 210191], [74, 210351], [79, 210631], [83, 211071], [88, 211271], [92, 211431], [98, 212051], [102, 212191], [105, 212431]]}, {"verse": 32, "start": 213342, "end": 218813, "text": "Since the world began was it not heard that any man opened the eyes of one that was born blind.", "words": [[0, 213342], [6, 213545], [10, 213765], [16, 214045], [22, 214825], [26, 214945], [29, 215085], [33, 215265], [39, 215625], [44, 215825], [48, 216105], [52, 216385], [59, 216725], [63, 216945], [68, 217225], [71, 217385], [75, 217605], [80, 217785], [84, 217965], [89, 218205]]}, {"verse": 33, "start": 219163, "end": 221521, "text": "If this man were not of God, he could do nothing.", "words": [[0, 219163], [3, 219285], [8, 219485], [12, 219725], [17, 219885], [21, 220025], [24, 220165], [29, 220685], [32, 220785], [38, 220925], [41, 221065]]}, {"verse": 34, "start": 221801, "end": 227860, "text": "They answered and said to him, You were altogether born in sins, and do you teach us? And they cast him out.", "words": [[0, 221801], [5, 221910], [14, 222310], [18, 222530], [23, 222730], [26, 222910], [31, 223362], [35, 223507], [40, 223877], [51, 224247], [56, 224647], [59, 224807], [65, 225067], [69, 225507], [72, 225647], [76, 225727], [82, 225947], [86, 226658], [90, 226810], [95, 226930], [100, 227250], [104, 227470]]}, {"verse": 35, "start": 228210, "end": 235408, "text": "Jesus heard that they had cast him out; and when he had found him, he said to him, Do you believe on the Son of God?", "words": [[0, 228210], [6, 228535], [12, 229015], [17, 229255], [22, 229415], [26, 229555], [31, 229875], [35, 230095], [40, 230733], [44, 230858], [49, 231038], [52, 231238], [56, 231358], [62, 231658], [67, 232218], [70, 232358], [75, 232618], [78, 232798], [83, 233386], [86, 233483], [90, 233743], [98, 234103], [101, 234343], [105, 234463], [109, 234723], [112, 234863]]}, {"verse": 36, "start": 235688, "end": 239732, "text": "He answered and said, Who is he, Lord, that I might believe on him?", "words": [[0, 235688], [3, 235802], [12, 236102], [16, 236322], [22, 236978], [26, 237121], [29, 237501], [33, 237861], [39, 238461], [44, 238621], [46, 238741], [52, 238941], [60, 239221], [63, 239401]]}, {"verse": 37, "start": 240012, "end": 245163, "text": "And Jesus said to him, You have both seen him, and it is he that talks with you.", "words": [[0, 240012], [4, 240163], [10, 240463], [15, 240863], [18, 241063], [23, 241565], [27, 241700], [32, 241900], [37, 242180], [42, 242520], [47, 243180], [51, 243320], [54, 243440], [57, 243620], [60, 243880], [65, 244160], [71, 244480], [76, 244800]]}, {"verse": 38, "start": 245443, "end": 249937, "text": "And he said, Lord, I believe. And he worshipped him.", "words": [[0, 245443], [4, 245578], [7, 245718], [13, 247127], [19, 247651], [21, 247751], [30, 248731], [34, 248902], [37, 249062], [48, 249622]]}, {"verse": 39, "start": 250287, "end": 259143, "text": "¶ And Jesus said, For judgment I am come into this world, that they which see not might see; and that they which see might be made blind.", "words": [[2, 250287], [6, 250452], [12, 250732], [18, 251562], [22, 251692], [31, 252092], [33, 252472], [36, 252612], [41, 252872], [46, 253132], [51, 253392], [58, 253812], [63, 254352], [68, 254632], [74, 254832], [78, 255152], [82, 255492], [88, 255892], [93, 256688], [97, 256828], [102, 257008], [107, 257228], [113, 257448], [117, 257728], [123, 257968], [126, 258188], [131, 258468]]}, {"verse": 40, "start": 259423, "end": 265737, "text": "And some of the Pharisees which were with him heard these words, and said to him, Are we blind also?", "words": [[0, 259423], [4, 259538], [9, 259758], [12, 259898], [16, 260018], [26, 260718], [32, 260858], [37, 261038], [42, 261258], [46, 261418], [52, 261698], [58, 261938], [65, 262338], [69, 262693], [74, 262953], [77, 263153], [82, 264496], [86, 264619], [89, 264759], [95, 265039]]}, {"verse": 41, "start": 266017, "end": 275646, "text": "Jesus said to them, If you were blind, you should have no sin: but now you say, We see; therefore your sin remains.", "words": [[0, 266017], [6, 266275], [11, 266615], [14, 266795], [20, 269022], [23, 269210], [27, 269410], [32, 269530], [39, 270390], [43, 270510], [50, 270690], [55, 270950], [58, 271170], [63, 271850], [67, 271951], [71, 272131], [75, 272331], [80, 272871], [83, 273171], [88, 273943], [98, 274486], [103, 274566], [107, 274846]]}]}