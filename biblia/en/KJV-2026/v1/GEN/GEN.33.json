{"book": "GEN", "chapter": 33, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 158636, "verses": [{"verse": 1, "start": 300, "end": 11480, "text": "And Jacob lifted up his eyes, and looked, and, behold, Esau came, and with him four hundred men. And he divided the children to Leah, and to Rachel, and to the two handmaids.", "words": [[0, 300], [4, 421], [10, 701], [17, 1081], [20, 1381], [24, 1541], [30, 1821], [34, 2061], [42, 2881], [47, 3061], [55, 3661], [60, 4061], [66, 4881], [70, 5001], [75, 5201], [79, 5361], [84, 5681], [92, 6001], [97, 6705], [101, 6830], [104, 6950], [112, 7330], [116, 7570], [125, 7950], [128, 8190], [134, 8510], [138, 8990], [141, 9110], [149, 9530], [153, 10130], [156, 10290], [160, 10410], [164, 10630]]}, {"verse": 2, "start": 11830, "end": 18678, "text": "And he put the handmaids and their children foremost, and Leah and her children after, and Rachel and Joseph hindermost.", "words": [[0, 11830], [4, 11955], [7, 12015], [11, 12175], [15, 12355], [25, 12735], [29, 13115], [35, 13235], [44, 13615], [54, 14795], [58, 14975], [63, 15155], [67, 15315], [71, 15475], [80, 15815], [87, 16635], [91, 16835], [98, 17175], [102, 17395], [109, 17715]]}, {"verse": 3, "start": 19028, "end": 25163, "text": "And he passed over before them, and bowed himself to the ground seven times, until he came near to his brother.", "words": [[0, 19028], [4, 19163], [7, 19243], [14, 19543], [19, 19823], [26, 20163], [32, 20503], [36, 21043], [42, 21403], [50, 21743], [53, 21983], [57, 22083], [64, 22383], [70, 22763], [77, 23343], [83, 23703], [86, 23883], [91, 24123], [96, 24343], [99, 24503], [103, 24643]]}, {"verse": 4, "start": 25513, "end": 32577, "text": "And Esau ran to meet him, and embraced him, and fell on his neck, and kissed him: and they wept.", "words": [[0, 25513], [4, 25681], [9, 26241], [13, 26501], [16, 26701], [21, 26901], [26, 27661], [30, 27741], [39, 28141], [44, 29061], [48, 29181], [53, 29421], [56, 29641], [60, 29841], [66, 30181], [70, 30641], [77, 30921], [82, 31613], [86, 31796], [91, 31956]]}, {"verse": 5, "start": 32927, "end": 44511, "text": "And he lifted up his eyes, and saw the women and the children; and said, Who are those with you? And he said, The children which God has graciously given your servant.", "words": [[0, 32927], [4, 33217], [7, 33357], [14, 33677], [17, 33937], [21, 34117], [27, 34497], [31, 35157], [35, 35457], [39, 35637], [45, 35957], [49, 36477], [53, 36617], [63, 37494], [67, 37646], [73, 38337], [77, 38464], [81, 38604], [87, 38824], [92, 39084], [97, 39653], [101, 39787], [104, 39927], [110, 41336], [114, 41479], [123, 41819], [129, 42119], [133, 42379], [137, 42639], [148, 43279], [154, 43639], [159, 43879]]}, {"verse": 6, "start": 44791, "end": 49490, "text": "Then the handmaidens came near, they and their children, and they bowed themselves.", "words": [[0, 44791], [5, 45071], [9, 45251], [21, 45951], [26, 46171], [32, 47131], [37, 47311], [41, 47491], [47, 47631], [57, 48191], [61, 48271], [66, 48391], [72, 48751]]}, {"verse": 7, "start": 49840, "end": 57770, "text": "And Leah also with her children came near, and bowed themselves: and after came Joseph near and Rachel, and they bowed themselves.", "words": [[0, 49840], [4, 50180], [9, 50400], [14, 50820], [19, 51100], [23, 51240], [32, 51620], [37, 51900], [43, 52180], [47, 52660], [53, 53000], [65, 53961], [69, 54096], [75, 54356], [80, 54616], [87, 55016], [92, 55376], [96, 55716], [104, 56256], [108, 56376], [113, 56516], [119, 56916]]}, {"verse": 8, "start": 58120, "end": 65426, "text": "And he said, What do you mean by all this drove which I met? And he said, These are to find grace in the sight of my lord.", "words": [[0, 58120], [4, 58238], [7, 58318], [13, 58913], [18, 59025], [21, 59125], [25, 59185], [30, 59405], [33, 59585], [37, 59772], [42, 59958], [48, 60145], [54, 60445], [56, 60565], [61, 61109], [65, 61244], [68, 61384], [74, 62792], [80, 62983], [84, 63183], [8