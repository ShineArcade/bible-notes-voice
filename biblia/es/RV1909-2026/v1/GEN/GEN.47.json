{"book": "GEN", "chapter": 47, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 333958, "verses": [{"verse": 1, "start": 300, "end": 14194, "text": "Y José vino, e hizo saber a Faraón, y dijo: Mi padre y mis hermanos, y sus ovejas y sus vacas, con todo lo que tienen, han venido de la tierra de Canaán, y he aquí, están en la tierra de Gosén.", "words": [[0, 300], [2, 422], [7, 682], [13, 1222], [15, 1522], [20, 1802], [26, 2262], [28, 2402], [36, 3622], [38, 3922], [44, 4692], [47, 4793], [53, 5133], [55, 5313], [59, 5453], [69, 6473], [71, 6593], [75, 6753], [82, 7273], [84, 7413], [88, 7593], [95, 8093], [99, 8273], [104, 8473], [107, 8673], [111, 8793], [119, 9133], [123, 9693], [130, 10093], [133, 10213], [136, 10313], [143, 10613], [146, 10793], [154, 11333], [156, 11553], [159, 11773], [165, 12597], [171, 12896], [174, 13076], [177, 13176], [184, 13476], [187, 13861]]}, {"verse": 2, "start": 14474, "end": 20232, "text": "Y de los últimos de sus hermanos tomó cinco varones, y los presentó delante de Faraón.", "words": [[0, 14474], [2, 14578], [5, 14658], [9, 14838], [17, 15278], [20, 15538], [24, 15678], [33, 16358], [38, 16688], [44, 17018], [53, 17678], [55, 18138], [59, 18258], [68, 18918], [76, 19378], [79, 19805]]}, {"verse": 3, "start": 20582, "end": 31101, "text": "Y Faraón dijo a sus hermanos: ¿Cuál es vuestro oficio? Y ellos respondieron a Faraón: Pastores de ovejas son tus siervos, así nosotros como nuestros padres.", "words": [[0, 20582], [2, 20894], [9, 21224], [14, 21484], [16, 21664], [20, 21784], [30, 22883], [36, 23067], [39, 23167], [47, 23467], [55, 24300], [57, 24443], [63, 24703], [76, 25463], [78, 25957], [86, 26615], [95, 27062], [98, 27242], [105, 27662], [109, 27922], [113, 28122], [122, 28862], [126, 29042], [135, 29442], [140, 29962], [149, 30262]]}, {"verse": 4, "start": 31451, "end": 47455, "text": "Dijeron además a Faraón: Por morar en esta tierra hemos venido; porque no hay pasto para las ovejas de tus siervos, pues el hambre es grave en la tierra de Canaán: por tanto, te rogamos ahora que habiten tus siervos en la tierra de Gosén.", "words": [[0, 31451], [8, 32057], [15, 32437], [17, 32932], [25, 33598], [29, 33764], [35, 34224], [38, 34404], [43, 34624], [50, 35044], [56, 35444], [64, 36363], [71, 36607], [74, 36807], [78, 36907], [84, 37487], [89, 37707], [93, 37927], [100, 38387], [103, 38587], [107, 38787], [116, 39727], [121, 39827], [124, 40027], [131, 40587], [134, 40947], [140, 41467], [143, 41787], [146, 41947], [153, 42267], [156, 42777], [164, 43453], [168, 43558], [175, 43978], [178, 44118], [186, 44558], [192, 44838], [196, 45058], [204, 45418], [208, 45598], [216, 46058], [219, 46238], [222, 46358], [229, 46698], [232, 47104]]}, {"verse": 5, "start": 47805, "end": 53772, "text": "Entonces Faraón habló a José, diciendo: Tu padre y tus hermanos han venido a ti;", "words": [[0, 47805], [9, 48578], [16, 49388], [22, 49808], [24, 49888], [30, 50228], [40, 51593], [43, 51674], [49, 51994], [51, 52174], [55, 52314], [64, 52854], [68, 52994], [75, 53334], [77, 53494]]}, {"verse": 6, "start": 54122, "end": 67615, "text": "La tierra de Egipto delante de ti está; en lo mejor de la tierra haz habitar a tu padre y a tus hermanos; habiten en la tierra de Gosén; y si entiendes que hay entre ellos hombres eficaces, ponlos por encargados de mi ganado.", "words": [[0, 54122], [3, 54229], [10, 54549], [13, 54749], [20, 55249], [28, 55649], [31, 55809], [34, 56029], [40, 56754], [43, 56858], [46, 56978], [52, 57278], [55, 57438], [58, 57538], [65, 57858], [69, 58178], [77, 58578], [79, 58658], [82, 58798], [88, 59118], [90, 59338], [92, 59378], [96, 59498], [106, 60419], [114, 60882], [117, 60982], [120, 61102], [127, 61442], [130, 61867], [137, 62461], [139, 62566], [142, 62706], [152, 63226], [156, 63366], [160, 63546], [166, 63786], [172, 64066], [180, 64466], [190, 65546], [197, 65966], [201, 66226], [212, 66846], [215, 67026], [218, 67086]]}, {"verse": 7, "start": 67895, "end": 75004, "text": "Y José introdujo a su padre, y lo presentó delante de Faraón; y Jacob bendijo a Faraón.", "words": [[0, 67895], [2, 68074], [7, 68294], [17, 69274], [19, 69414], [22, 69534], [29, 69954], [31, 70209], [34, 70329], [43, 70989], [51, 71489], [54, 71629], [62, 72615], [64, 72760], [70, 73080], [78, 74040], [80, 74160]]}, {"verse": 8, "start": 75004, "end": 79391, "text": "Y dijo Faraón a Jacob: ¿Cuántos son los días de los años de tu vida?", "words": [[0, 75004], [2, 75284], [7, 75571], [14, 75857], [16, 76144], [23, 77061], [32, 77486], [36, 77646], [40, 77806], [45, 78046], [48, 78266], [52, 78386], [57, 78646], [60, 78826], [63, 78946]]}, {"verse": 9, "start": 79671, "end": 94711, "text": "Y Jacob respondió a Faraón: Los días de los años de mi peregrinación son ciento treinta años; pocos y malos han sido los días de los años de mi vida, y no han llegado a los días de los años de la vida de mis padres en los días de su peregrinación.", "words": [[0, 79671], [2, 79837], [8, 80117], [18, 81052], [20, 81362], [28, 81872], [32, 82014], [37, 82294], [40, 82514], [44, 82614], [49, 82894], [52, 83094], [55, 83234], [69, 84034], [73, 84461], [80, 84887], [88, 85314], [94, 86184], [100, 86530], [102, 86650], [108, 86990], [112, 87110], [117, 87370], [121, 87570], [126, 87810], [129, 88050], [133, 88190], [138, 88510], [141, 88750], [144, 88870], [150, 89170], [152, 89345], [155, 89485], [159, 89605], [167, 89965], [169, 90085], [173, 90245], [178, 90465], [181, 90705], [185, 90825], [190, 91105], [193, 91325], [196, 91824], [201, 92044], [204, 92224], [208, 92344], [215, 92744], [218, 92984], [222, 93104], [227, 93364], [230, 93564], [233, 93724]]}, {"verse": 10, "start": 94991, "end": 99451, "text": "Y Jacob bendijo a Faraón, y se salió de delante de Faraón.", "words": [[0, 94991], [2, 95137], [8, 95437], [16, 96297], [18, 96647], [26, 96997], [28, 97197], [31, 97317], [37, 97817], [40, 98077], [48, 98537], [51, 99028]]}, {"verse": 11, "start": 99801, "end": 111682, "text": "Así José hizo habitar a su padre y a sus hermanos, y les dio posesión en la tierra de Egipto, en lo mejor de la tierra, en la tierra de Ramesés como mandó Faraón.", "words": [[0, 99801], [4, 100102], [9, 100462], [14, 100982], [22, 101422], [24, 101542], [27, 101682], [33, 102062], [35, 102362], [37, 102442], [41, 102602], [51, 103442], [53, 103622], [57, 103822], [61, 104102], [70, 104922], [73, 105182], [76, 105322], [83, 105642], [86, 105882], [94, 106802], [97, 106882], [100, 107002], [106, 107322], [109, 107482], [112, 107602], [120, 108406], [123, 108533], [126, 108673], [133, 109013], [136, 109313], [144, 110033], [149, 110453], [155, 111089]]}, {"verse": 12, "start": 112032, "end": 121348, "text": "Y alimentaba José a su padre y a sus hermanos, y a toda la casa de su padre, con alimento, según el número de sus hijos.", "words": [[0, 112032], [2, 112157], [13, 112837], [18, 113217], [20, 113417], [23, 113537], [29, 113997], [31, 114537], [33, 114617], [37, 114757], [47, 115577], [49, 115897], [51, 115997], [56, 116237], [59, 116457], [64, 116697], [67, 116877], [70, 117037], [77, 117457], [81, 118017], [91, 118737], [97, 119477], [100, 119877], [107, 120217], [110, 120457], [114, 120657]]}, {"verse": 13, "start": 121698, "end": 130493, "text": "Y no había pan en toda la tierra, y el hambre era muy grave; por lo que desfalleció de hambre la tierra de Egipto y la tierra de Canaán.", "words": [[0, 121698], [2, 121840], [5, 121980], [11, 122280], [15, 122660], [18, 122980], [23, 123240], [26, 123460], [34, 123920], [36, 124165], [39, 124325], [46, 124685], [50, 124965], [54, 125225], [61, 126116], [65, 126196], [68, 126356], [72, 126536], [84, 127376], [87, 127536], [94, 127896], [97, 128056], [104, 128316], [107, 128556], [114, 129036], [116, 129136], [119, 129256], [126, 129556], [129, 130059]]}, {"verse": 14, "start": 130843, "end": 142675, "text": "Y recogió José todo el dinero que se halló en la tierra de Egipto y en la tierra de Canaán, por los alimentos que de él compraban; y metió José el dinero en casa de Faraón.", "words": [[0, 131052], [2, 131298], [10, 131545], [15, 131885], [20, 132245], [23, 132485], [30, 132785], [34, 133005], [37, 133165], [43, 133445], [46, 133545], [49, 133665], [56, 134005], [59, 134205], [66, 134825], [68, 135205], [71, 135325], [74, 135425], [81, 135845], [84, 136195], [92, 136545], [96, 137065], [100, 137265], [110, 137665], [114, 138045], [117, 138155], [120, 138265], [131, 139517], [133, 139640], [139, 140000], [144, 140440], [147, 140760], [154, 141140], [157, 141400], [162, 141660], [165, 142168]]}, {"verse": 15, "start": 143025, "end": 154497, "text": "Y acabado el dinero de la tierra de Egipto y de la tierra de Canaán, vino todo Egipto a José diciendo: Danos pan: ¿por qué moriremos delante de ti, por haberse acabado el dinero?", "words": [[0, 143025], [2, 143151], [10, 143631], [13, 143771], [20, 144091], [23, 144291], [26, 144411], [33, 144651], [36, 144911], [43, 145391], [45, 145471], [48, 145571], [51, 145671], [58, 145951], [61, 146441], [69, 146931], [74, 147291], [79, 147571], [86, 148131], [88, 148211], [93, 148531], [103, 149726], [109, 150065], [114, 150769], [119, 150897], [123, 151057], [133, 151697], [141, 152137], [144, 152297], [148, 152517], [152, 152977], [160, 153357], [168, 153817], [171, 153937]]}, {"verse": 16, "start": 154777, "end": 161049, "text": "Y José dijo: Dad vuestros ganados, y yo os daré por vuestros ganados, si se ha acabado el dinero.", "words": [[0, 154777], [2, 154942], [7, 155242], [13, 156445], [17, 156642], [26, 157022], [35, 157502], [37, 157762], [40, 158002], [43, 158122], [48, 158442], [52, 158582], [61, 158902], [70, 159422], [73, 159842], [76, 160002], [79, 160142], [87, 160502], [90, 160602]]}, {"verse": 17, "start": 161329, "end": 173791, "text": "Y ellos trajeron sus ganados a José; y José les dio alimentos a cambio de caballos, ovejas, vacas y asnos: y los alimentó durante aquel año a cambio de todo su ganado.", "words": [[0, 161329], [2, 161517], [8, 161857], [17, 162537], [21, 162717], [29, 163337], [31, 163517], [37, 164171], [39, 164474], [44, 164724], [48, 164974], [52, 165194], [62, 165834], [64, 166034], [71, 166374], [74, 166574], [84, 167414], [92, 168114], [98, 168554], [100, 168694], [107, 169665], [109, 169746], [113, 169886], [122, 170646], [130, 170966], [136, 171446], [140, 171746], [142, 172126], [149, 172466], [152, 172666], [157, 172906], [160, 173146]]}, {"verse": 18, "start": 174141, "end": 189050, "text": "Y acabado aquel año, vinieron a él el segundo año, y le dijeron: No encubriremos a nuestro señor que el dinero ciertamente se ha acabado; también el ganado es ya de nuestro señor; nada ha quedado delante de nuestro señor sino nuestros cuerpos y nuestra tierra.", "words": [[0, 174141], [2, 174290], [10, 174790], [16, 175110], [21, 175370], [30, 175890], [32, 176090], [35, 176270], [38, 176510], [46, 176930], [51, 177410], [53, 177625], [56, 177745], [65, 178698], [68, 178884], [81, 179524], [83, 179704], [91, 179824], [97, 180244], [101, 180444], [104, 180524], [111, 180824], [123, 181144], [126, 181464], [129, 181784], [138, 182646], [146, 182890], [149, 183090], [156, 183490], [159, 183630], [162, 183730], [165, 183850], [173, 183990], [180, 184854], [185, 185092], [188, 185292], [196, 185632], [204, 186012], [207, 186132], [215, 186272], [221, 187012], [226, 187252], [235, 187532], [243, 188112], [245, 188252], [253, 188512]]}, {"verse": 19, "start": 189400, "end": 204135, "text": "¿Por qué moriremos delante de tus ojos, así nosotros como nuestra tierra? Cómpranos a nosotros y a nuestra tierra por pan, y seremos nosotros y nuestra tierra siervos de Faraón: y danos semilla para que vivamos y no muramos, y no sea asolada la tierra.", "words": [[0, 189400], [5, 189522], [9, 189682], [19, 190222], [27, 190622], [30, 190782], [34, 190942], [40, 191602], [44, 191802], [53, 192182], [58, 192542], [66, 192842], [74, 193685], [84, 194093], [86, 194273], [95, 194613], [97, 194913], [99, 194953], [107, 195093], [114, 195473], [118, 195773], [123, 196093], [125, 196393], [133, 196733], [142, 197193], [144, 197513], [152, 197773], [159, 198093], [167, 198653], [170, 198773], [178, 199606], [180, 199730], [186, 200030], [194, 200550], [199, 200790], [203, 200950], [211, 201470], [213, 201750], [216, 201850], [225, 202390], [227, 202605], [230, 202745], [234, 202985], [242, 203445], [245, 203565]]}, {"verse": 20, "start": 204415, "end": 217452, "text": "Entonces compró José toda la tierra de Egipto para Faraón; pues los egipcios vendieron cada uno sus tierras, porque se agravó el hambre sobre ellos: y la tierra vino a ser de Faraón.", "words": [[0, 204415], [9, 204919], [16, 205459], [21, 205999], [26, 206299], [29, 206539], [36, 206879], [39, 207159], [46, 207719], [51, 207899], [59, 208821], [64, 209025], [68, 209365], [77, 210025], [87, 210685], [92, 210925], [96, 211205], [100, 211405], [109, 212025], [116, 212465], [119, 212745], [126, 213245], [129, 213385], [136, 213685], [142, 213945], [149, 214834], [151, 214940], [154, 215040], [161, 215440], [166, 216080], [168, 216340], [172, 216500], [175, 216660]]}, {"verse": 21, "start": 217802, "end": 224825, "text": "Y al pueblo lo hizo pasar a las ciudades desde un extremo del término de Egipto hasta el otro extremo.", "words": [[0, 217802], [2, 217925], [5, 218065], [12, 218405], [15, 218665], [20, 218885], [26, 219225], [28, 219405], [32, 219525], [41, 220445], [47, 220745], [50, 221065], [58, 221725], [62, 221865], [70, 222505], [73, 222605], [80, 223185], [86, 223545], [89, 223805], [94, 224005]]}, {"verse": 22, "start": 225175, "end": 238574, "text": "Solamente la tierra de los sacerdotes no compró, por cuanto los sacerdotes tenían ración de Faraón, y ellos comían su ración que Faraón les daba: por eso no vendieron su tierra.", "words": [[0, 225175], [10, 225802], [13, 225982], [20, 226402], [23, 226602], [27, 226762], [38, 227642], [41, 228102], [49, 228742], [53, 229482], [60, 229802], [64, 230062], [75, 230902], [82, 231302], [89, 231922], [92, 232062], [100, 232602], [102, 233222], [108, 233482], [115, 233942], [118, 234222], [125, 234762], [129, 234942], [136, 235462], [140, 235622], [146, 236436], [150, 236716], [154, 236916], [157, 237136], [167, 237656], [170, 237856]]}, {"verse": 23, "start": 238924, "end": 246738, "text": "Y José dijo al pueblo: Hoy os he comprado a vosotros y a vuestra tierra para Faraón. Aquí tenéis semilla; sembrad la tierra.", "words": [[0, 238924], [2, 239063], [7, 239263], [12, 239643], [15, 239803], [23, 240562], [27, 240750], [30, 240890], [33, 240970], [42, 241430], [44, 241570], [53, 242090], [55, 242330], [57, 242390], [65, 242710], [72, 243050], [77, 243525], [85, 244206], [90, 244413], [97, 244813], [106, 245810], [114, 246040], [117, 246200]]}, {"verse": 24, "start": 247088, "end": 259204, "text": "Y será que de los frutos daréis el quinto a Faraón, y las cuatro partes serán vuestras para sembrar las tierras, y para vuestro mantenimiento, y de los que están en vuestras casas, y para que coman vuestros niños.", "words": [[0, 247088], [2, 247205], [7, 247365], [11, 247565], [14, 247685], [18, 247805], [25, 248265], [32, 248685], [35, 248825], [42, 249185], [44, 249305], [52, 249765], [54, 250085], [58, 250245], [65, 250485], [72, 250965], [78, 251385], [87, 251805], [92, 252065], [100, 252505], [104, 252685], [113, 253265], [115, 253625], [120, 253825], [128, 254165], [143, 255319], [145, 255419], [148, 255519], [152, 255659], [156, 255819], [162, 256099], [165, 256279], [174, 256619], [181, 257219], [183, 257359], [188, 257579], [192, 257739], [198, 258159], [207, 258539]]}, {"verse": 25, "start": 259484, "end": 267780, "text": "Y ellos respondieron: La vida nos has dado: hallemos gracia ante los ojos de mi señor, y seamos siervos de Faraón.", "words": [[0, 259484], [2, 259668], [8, 260008], [22, 261624], [25, 261744], [30, 261964], [34, 262184], [38, 262404], [44, 263344], [53, 263544], [60, 264024], [65, 264184], [69, 264364], [74, 264624], [77, 264804], [80, 264884], [87, 265284], [89, 265724], [96, 266104], [104, 266564], [107, 266704]]}, {"verse": 26, "start": 268060, "end": 280460, "text": "Entonces José lo puso por ley hasta hoy sobre la tierra de Egipto, señalando para Faraón el quinto; excepto sólo la tierra de los sacerdotes, que no fue de Faraón.", "words": [[0, 268060], [9, 268617], [14, 268977], [17, 269337], [22, 269697], [26, 269997], [30, 270357], [36, 270837], [40, 271197], [46, 271497], [49, 271717], [56, 272057], [59, 272297], [67, 273117], [77, 273957], [82, 274417], [89, 274877], [92, 275157], [100, 276113], [108, 276840], [113, 277180], [116, 277380], [123, 277760], [126, 278000], [130, 278120], [142, 279300], [146, 279380], [149, 279540], [153, 279740], [156, 279880]]}, {"verse": 27, "start": 280810, "end": 291886, "text": "Así habitó Israel en la tierra de Egipto, en la tierra de Gosén; y tomaron posesión de ella, y se aumentaron, y multiplicaron en gran manera.", "words": [[0, 280810], [4, 281146], [11, 281626], [18, 282206], [21, 282526], [24, 282666], [31, 283046], [34, 283326], [42, 284346], [45, 284406], [48, 284526], [55, 284846], [58, 285304], [65, 285942], [67, 286040], [75, 286440], [84, 287200], [87, 287420], [93, 287760], [95, 287985], [98, 288125], [110, 288965], [112, 289525], [126, 290705], [129, 290905], [134, 291125]]}, {"verse": 28, "start": 292236, "end": 300551, "text": "Y vivió Jacob en la tierra de Egipto diecisiete años: y fueron los días de Jacob, los años de su vida, ciento cuarenta y siete años.", "words": [[0, 292236], [2, 292360], [8, 292660], [14, 292920], [17, 293200], [20, 293280], [27, 293580], [30, 293780], [37, 294220], [48, 294660], [54, 295911], [56, 296020], [63, 296240], [67, 296500], [72, 296700], [75, 296880], [82, 297120], [86, 297440], [91, 297680], [94, 297880], [97, 298020], [103, 298384], [110, 298748], [119, 299112], [121, 299476], [127, 299840]]}, {"verse": 29, "start": 300901, "end": 316997, "text": "Y se acercaron los días de Israel para morir, y llamó a José su hijo, y le dijo: Si he hallado ahora gracia en tus ojos, te ruego que pongas tu mano debajo de mi muslo, y harás conmigo misericordia y verdad; te ruego que no me entierres en Egipto;", "words": [[0, 300901], [2, 301045], [5, 301165], [15, 301925], [19, 302105], [24, 302425], [27, 302645], [34, 303005], [39, 303245], [46, 304165], [48, 304425], [54, 304785], [56, 304865], [61, 305105], [64, 305405], [70, 306045], [72, 306205], [75, 306325], [81, 307084], [84, 307240], [87, 307440], [95, 307860], [101, 308160], [108, 308720], [111, 308820], [115, 308960], [121, 309800], [124, 309860], [130, 310160], [134, 310320], [141, 310740], [144, 310880], [149, 311120], [156, 311540], [159, 311680], [162, 311780], [169, 312220], [171, 312640], [177, 312960], [185, 313380], [198, 314200], [200, 314300], [208, 314987], [211, 315086], [217, 315366], [221, 315566], [224, 315706], [227, 315846], [237, 316306], [240, 316446]]}, {"verse": 30, "start": 317347, "end": 325831, "text": "Mas cuando duerma con mis padres, me llevarás de Egipto, y me sepultarás en el sepulcro de ellos. Y él respondió: Yo haré como tú dices.", "words": [[0, 317347], [4, 317491], [11, 317691], [18, 318071], [22, 318271], [26, 318431], [34, 319191], [37, 319251], [46, 319651], [49, 319751], [57, 320231], [59, 320551], [62, 320671], [73, 321371], [76, 321491], [79, 321631], [88, 322111], [91, 322291], [98, 323091], [100, 323273], [103, 323413], [114, 324408], [117, 324587], [122, 324867], [127, 325027], [130, 325207]]}, {"verse": 31, "start": 326111, "end": 333558, "text": "Y él dijo: Júramelo. Y él le juró. Entonces Israel se inclinó sobre la cabecera de la cama.", "words": [[0, 326111], [2, 326300], [5, 326460], [11, 327178], [21, 328254], [23, 328438], [26, 328578], [29, 328698], [35, 329452], [44, 329978], [51, 330738], [54, 331058], [62, 331658], [68, 331918], [71, 332118], [80, 332738], [83, 332838], [86, 332978]]}]}