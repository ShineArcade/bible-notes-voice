{"book": "GEN", "chapter": 37, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 338769, "verses": [{"verse": 1, "start": 300, "end": 5555, "text": "Y habitó Jacob en la tierra donde vivió su padre, en la tierra de Canaán.", "words": [[0, 300], [2, 477], [9, 897], [15, 1217], [18, 1537], [21, 1677], [28, 2057], [34, 2397], [40, 2937], [43, 3097], [50, 3997], [53, 4137], [56, 4237], [63, 4617], [66, 5114]]}, {"verse": 2, "start": 6005, "end": 26269, "text": "Estas fueron las generaciones de Jacob. José, siendo de edad de diecisiete años apacentaba las ovejas con sus hermanos; y el joven estaba con los hijos de Bilha, y con los hijos de Zilpa, mujeres de su padre: y José informaba a su padre de la mala fama de ellos.", "words": [[0, 6005], [6, 6305], [13, 6525], [17, 6785], [30, 7505], [33, 7665], [40, 8566], [46, 9006], [53, 9606], [56, 9966], [61, 10406], [64, 10866], [75, 11326], [80, 12206], [91, 13086], [95, 13266], [102, 13746], [106, 13986], [110, 14166], [120, 15242], [122, 15371], [125, 15471], [131, 15871], [138, 16151], [142, 16391], [146, 16551], [152, 16831], [155, 17241], [162, 17651], [164, 18071], [168, 18271], [172, 18491], [178, 18771], [181, 19481], [188, 20191], [196, 20571], [199, 20811], [202, 20971], [209, 21957], [211, 22227], [216, 22547], [226, 23527], [228, 23727], [231, 23867], [237, 24287], [240, 24547], [243, 24687], [248, 24987], [253, 25527], [256, 25647]]}, {"verse": 3, "start": 26719, "end": 34806, "text": "Y amaba Israel a José más que a todos sus hijos, porque le había tenido en su vejez: y le hizo una ropa de diversos colores.", "words": [[0, 26719], [2, 26840], [8, 27220], [15, 27640], [17, 27820], [22, 28060], [26, 28340], [30, 28520], [32, 28620], [38, 28860], [42, 29160], [49, 29460], [56, 30080], [59, 30260], [65, 30460], [72, 30780], [75, 31112], [78, 31443], [85, 32005], [87, 32317], [90, 32477], [95, 32757], [99, 32977], [104, 33397], [107, 33517], [116, 34057]]}, {"verse": 4, "start": 35256, "end": 43488, "text": "Y viendo sus hermanos que su padre lo amaba más que a todos sus hermanos, le aborrecían, y no le podían hablar pacíficamente.", "words": [[0, 35256], [2, 35372], [9, 35612], [13, 35832], [22, 36392], [26, 36492], [29, 36652], [35, 37052], [38, 37372], [44, 37772], [48, 37972], [52, 38132], [54, 38252], [60, 38432], [64, 38672], [74, 39372], [77, 39772], [89, 40612], [91, 41092], [94, 41252], [97, 41372], [104, 41812], [111, 42092]]}, {"verse": 5, "start": 43938, "end": 51370, "text": "Y soñó José un sueño, y lo contó a sus hermanos; y ellos vinieron a aborrecerle más todavía.", "words": [[0, 43938], [2, 44208], [7, 44478], [12, 45038], [15, 45118], [22, 45738], [24, 46158], [27, 46298], [33, 46678], [35, 46798], [39, 46918], [49, 48072], [51, 48221], [57, 48541], [66, 49221], [68, 49481], [80, 50361], [84, 50521]]}, {"verse": 6, "start": 51820, "end": 56418, "text": "Y él les dijo: Oíd ahora este sueño que he soñado:", "words": [[0, 51820], [2, 52026], [5, 52266], [9, 52706], [15, 53563], [19, 53969], [25, 54409], [30, 54849], [36, 55389], [40, 55569], [43, 55669]]}, {"verse": 7, "start": 56868, "end": 69907, "text": "He aquí que atábamos manojos en medio del campo, y he aquí que mi manojo se levantaba, y estaba derecho, y que vuestros manojos estaban alrededor, y se inclinaban al mío.", "words": [[0, 56868], [3, 57028], [8, 57308], [12, 57528], [21, 58208], [29, 58748], [32, 58968], [38, 59228], [42, 59448], [49, 59928], [51, 60608], [54, 60788], [59, 61208], [63, 61448], [66, 61588], [73, 62108], [76, 62328], [87, 63208], [89, 63628], [96, 63908], [105, 64488], [107, 65228], [111, 65368], [120, 65668], [128, 66208], [136, 66588], [147, 68035], [149, 68181], [152, 68651], [163, 69121], [166, 69341]]}, {"verse": 8, "start": 70357, "end": 82129, "text": "Y le respondieron sus hermanos: ¿Has de reinar tú sobre nosotros, o nos vas a gobernar? Y le aborrecieron aún más a causa de sus sueños y de sus palabras.", "words": [[0, 70357], [2, 70479], [5, 70619], [18, 71339], [22, 71539], [32, 72821], [37, 73011], [40, 73331], [47, 73791], [50, 74111], [56, 74451], [66, 75111], [68, 75691], [72, 75831], [76, 76051], [78, 76191], [88, 77281], [90, 77422], [93, 77542], [106, 78442], [110, 78642], [114, 79042], [116, 79322], [122, 79662], [125, 79922], [129, 80122], [136, 80782], [138, 80962], [141, 81102], [145, 81282]]}, {"verse": 9, "start": 82579, "end": 95744, "text": "Y soñó aún otro sueño, y lo contó a sus hermanos, diciendo: He aquí que he soñado otro sueño, y he aquí que el sol y la luna y once estrellas se inclinaban a mí.", "words": [[0, 82579], [2, 82702], [7, 83182], [11, 83662], [16, 83982], [23, 84782], [25, 85282], [28, 85422], [34, 85802], [36, 85882], [40, 86022], [50, 86742], [60, 87938], [63, 88084], [68, 88324], [72, 88524], [75, 88624], [82, 89124], [87, 89384], [94, 90324], [96, 90504], [99, 90684], [104, 90924], [108, 91144], [111, 91384], [115, 91704], [117, 92164], [120, 92304], [125, 92724], [127, 93074], [132, 93424], [142, 94204], [145, 94524], [156, 95324], [158, 95464]]}, {"verse": 10, "start": 96194, "end": 109306, "text": "Y lo contó a su padre y a sus hermanos: y su padre le reprendió, y le dijo: ¿Qué sueño es este que soñaste? ¿Hemos de venir yo y tu madre, y tus hermanos, a inclinarnos a ti a tierra?", "words": [[0, 96194], [2, 96304], [5, 96424], [11, 96904], [13, 97004], [16, 97124], [22, 97564], [24, 97844], [26, 97944], [30, 98084], [40, 99228], [42, 99349], [45, 99450], [51, 99890], [54, 100250], [65, 101090], [67, 101750], [70, 101870], [76, 102690], [81, 102791], [87, 103171], [90, 103331], [95, 103571], [99, 103711], [108, 104756], [115, 104995], [118, 105215], [124, 105495], [127, 105855], [129, 105995], [132, 106115], [139, 106435], [141, 106795], [145, 106955], [155, 107615], [157, 107755], [169, 108375], [171, 108555], [174, 108675], [176, 108775]]}, {"verse": 11, "start": 109656, "end": 114672, "text": "Y sus hermanos le tenían envidia, mas su padre meditaba en esto.", "words": [[0, 109656], [2, 109783], [6, 109923], [15, 110483], [18, 110603], [25, 110943], [34, 112183], [38, 112483], [41, 112683], [47, 113043], [56, 113983], [59, 114163]]}, {"verse": 12, "start": 115122, "end": 119378, "text": "Y fueron sus hermanos a apacentar las ovejas de su padre en Siquem.", "words": [[0, 115122], [2, 115230], [9, 115470], [13, 115730], [22, 116330], [24, 116470], [34, 117110], [38, 117350], [45, 117810], [48, 117950], [51, 118110], [57, 118430], [60, 118917]]}, {"verse": 13, "start": 119828, "end": 128729, "text": "Y dijo Israel a José: Tus hermanos apacientan las ovejas en Siquem: ven, y te enviaré a ellos. Y él respondió: Aquí estoy.", "words": [[0, 119828], [2, 119977], [7, 120177], [14, 120657], [16, 120857], [22, 121580], [26, 121664], [35, 122284], [46, 122904], [50, 123044], [57, 123404], [60, 123799], [68, 124442], [73, 124664], [75, 125044], [78, 125164], [86, 125604], [88, 125664], [95, 126527], [97, 126677], [100, 126817], [111, 127860], [116, 128085]]}, {"verse": 14, "start": 129179, "end": 139895, "text": "Y él le dijo: Ve ahora, mira cómo están tus hermanos y cómo están las ovejas, y tráeme la respuesta. Y lo envió del valle de Hebrón, y llegó a Siquem.", "words": [[0, 129179], [2, 129336], [5, 129496], [8, 129676], [14, 130481], [17, 130658], [24, 130938], [29, 131218], [34, 131538], [40, 131798], [44, 132018], [53, 132618], [55, 132738], [60, 132938], [66, 133198], [70, 133358], [78, 133858], [80, 134278], [87, 134638], [90, 134798], [101, 135948], [103, 136071], [106, 136191], [112, 136611], [116, 136811], [122, 137231], [125, 137411], [133, 138011], [135, 138631], [141, 138911], [143, 139439]]}, {"verse": 15, "start": 140345, "end": 148880, "text": "Y lo halló un hombre, andando él perdido por el campo, y le preguntó aquel hombre, diciendo: ¿Qué buscas?", "words": [[0, 140345], [2, 140445], [5, 140585], [11, 140845], [14, 141025], [22, 141445], [30, 141925], [33, 142405], [41, 142985], [45, 143205], [48, 143325], [55, 144525], [57, 144745], [60, 144845], [69, 145505], [75, 145705], [83, 145965], [93, 147412], [98, 147510]]}, {"verse": 16, "start": 149230, "end": 154432, "text": "Y él respondió: Busco a mis hermanos: te ruego que me muestres dónde pastan.", "words": [[0, 149230], [2, 149380], [5, 149520], [16, 150562], [22, 151011], [24, 151131], [28, 151251], [38, 152436], [41, 152546], [47, 152866], [51, 153026], [54, 153276], [63, 153526], [69, 153985]]}, {"verse": 17, "start": 154882, "end": 165777, "text": "Y aquel hombre respondió: Ya se han ido de aquí; y yo les oí decir: Vamos a Dotán. Entonces José fue tras de sus hermanos, y los halló en Dotán.", "words": [[0, 154882], [2, 155056], [8, 155266], [15, 155526], [26, 156755], [29, 156897], [32, 157017], [36, 157157], [40, 157277], [43, 157477], [49, 158209], [51, 158349], [54, 158449], [58, 158569], [61, 158810], [68, 159595], [74, 159835], [76, 160225], [83, 160905], [92, 161549], [97, 162289], [101, 162609], [106, 162869], [109, 163029], [113, 163169], [123, 164269], [125, 164429], [129, 164609], [135, 164969], [138, 165109]]}, {"verse": 18, "start": 166227, "end": 172977, "text": "Y como ellos lo vieron de lejos, antes que cerca de ellos llegara, tramaron contra él para matarle.", "words": [[0, 166227], [2, 166352], [7, 166592], [13, 166812], [16, 167052], [23, 167332], [26, 167492], [33, 168292], [39, 168712], [43, 168992], [49, 169332], [52, 169592], [58, 169812], [67, 170672], [76, 171152], [83, 171572], [86, 171852], [91, 172132]]}, {"verse": 19, "start": 173427, "end": 177107, "text": "Y dijeron el uno al otro: He aquí viene el soñador;", "words": [[0, 173427], [2, 173550], [10, 174070], [13, 174210], [17, 174430], [20, 174650], [26, 175523], [29, 175603], [34, 175803], [40, 176203], [43, 176403]]}, {"verse": 20, "start": 177557, "end": 187619, "text": "Ahora pues, venid, y matémoslo y echémosle en una cisterna, y diremos: Alguna mala bestia le devoró: y veremos qué serán sus sueños.", "words": [[0, 177557], [6, 177844], [12, 178484], [19, 178904], [21, 179264], [31, 179904], [33, 180024], [43, 180684], [46, 180824], [50, 180964], [60, 181784], [62, 181944], [71, 182889], [78, 183431], [83, 183651], [90, 184291], [93, 184651], [101, 185557], [103, 185681], [111, 186081], [115, 186261], [121, 186661], [125, 186841]]}, {"verse": 21, "start": 188069, "end": 193459, "text": "Y como Rubén oyó esto, lo libró de sus manos, y dijo: No lo matemos.", "words": [[0, 188069], [2, 188177], [7, 188417], [13, 188957], [17, 189397], [23, 190277], [26, 190377], [32, 190797], [35, 190877], [39, 191037], [46, 191417], [48, 191637], [54, 192390], [57, 192549], [60, 192669]]}, {"verse": 22, "start": 193809, "end": 205940, "text": "Y les dijo Rubén: No derraméis sangre; echadlo en esta cisterna que está en el desierto, y no pongáis mano en él; por librarlo así de sus manos, para hacerlo volver a su padre.", "words": [[0, 193809], [2, 193958], [6, 194078], [11, 194358], [18, 195347], [21, 195513], [31, 196073], [39, 196935], [47, 197373], [50, 197453], [55, 197653], [64, 198253], [68, 198353], [73, 198573], [76, 198733], [79, 198833], [89, 199393], [91, 199833], [94, 199953], [102, 200373], [107, 200673], [110, 200873], [114, 201519], [118, 201640], [127, 202120], [131, 202360], [134, 202500], [138, 202640], [145, 202980], [150, 203360], [158, 203660], [165, 204000], [167, 204140], [170, 204240]]}, {"verse": 23, "start": 206290, "end": 215421, "text": "Y sucedió que, cuando llegó José a sus hermanos, ellos hicieron desnudar a José su ropa, la ropa de colores que tenía sobre sí;", "words": [[0, 206290], [2, 206456], [10, 207156], [15, 207336], [22, 207656], [28, 207976], [33, 208416], [35, 208616], [39, 208756], [49, 209596], [55, 209876], [64, 210496], [73, 211276], [75, 211356], [80, 211656], [83, 211936], [89, 212896], [92, 212956], [97, 213376], [100, 213516], [108, 213976], [112, 214176], [118, 214536], [124, 214896]]}, {"verse": 24, "start": 215871, "end": 223198, "text": "Y lo tomaron, y le echaron en la cisterna; pero la cisterna estaba vacía, no había en ella agua.", "words": [[0, 215871], [2, 216020], [5, 216140], [14, 216820], [16, 217500], [19, 217620], [27, 218140], [30, 218320], [33, 218480], [43, 219659], [48, 219802], [51, 220192], [60, 220582], [67, 220882], [74, 221582], [77, 221722], [83, 221982], [86, 222322], [91, 222522]]}, {"verse": 25, "start": 223648, "end": 238332, "text": "Y se sentaron a comer pan: y alzando los ojos miraron, y he aquí una compañía de ismaelitas que venía de Galaad, y sus camellos traían aromas y bálsamo y mirra, e iban a llevarlo a Egipto.", "words": [[0, 223648], [2, 223755], [5, 223875], [14, 224515], [16, 224655], [22, 224935], [27, 226033], [29, 226150], [37, 226650], [41, 226890], [46, 227130], [55, 228470], [57, 228570], [60, 228710], [65, 228970], [69, 229190], [78, 229950], [81, 230440], [92, 230930], [96, 231130], [102, 231510], [105, 232010], [113, 232510], [115, 232830], [119, 232970], [128, 233550], [135, 233970], [142, 234470], [144, 234670], [152, 235290], [154, 235820], [161, 236603], [163, 236707], [168, 236967], [170, 237047], [179, 237547], [181, 237687]]}, {"verse": 26, "start": 238782, "end": 246081, "text": "Entonces Judá dijo a sus hermanos: ¿Qué provecho hay en que matemos a nuestro hermano y encubramos su muerte?", "words": [[0, 238782], [9, 239387], [14, 240427], [19, 241027], [21, 241287], [25, 241427], [35, 242490], [40, 242588], [49, 243148], [53, 243368], [56, 243488], [60, 243588], [68, 244008], [70, 244168], [78, 244268], [86, 244828], [88, 244928], [99, 245368], [102, 245588]]}, {"verse": 27, "start": 246531, "end": 254776, "text": "Venid, y vendámosle a los ismaelitas, y no sea nuestra mano sobre él; que nuestro hermano es nuestra carne. Y sus hermanos acordaron con él.", "words": [[0, 246531], [7, 246950], [9, 247110], [20, 247750], [22, 247830], [26, 248220], [38, 248610], [40, 248910], [43, 249030], [47, 249210], [55, 249450], [60, 249730], [66, 250030], [70, 250656], [74, 250736], [82, 250956], [90, 251396], [93, 251476], [101, 251756], [108, 252623], [110, 252747], [114, 252887], [123, 253467], [133, 254107], [137, 254347]]}, {"verse": 28, "start": 255226, "end": 269421, "text": "Y como pasaban los madianitas mercaderes, sacaron ellos a José de la cisterna, y le trajeron arriba, y le vendieron a los ismaelitas por veinte piezas de plata. Y llevaron a José a Egipto.", "words": [[0, 255226], [2, 255473], [7, 255693], [15, 256253], [19, 256433], [30, 257133], [42, 258373], [50, 258953], [56, 259173], [58, 259393], [63, 259733], [66, 259893], [69, 260013], [79, 260993], [81, 261153], [84, 261253], [93, 261833], [101, 262793], [103, 263113], [106, 263213], [116, 263753], [118, 263913], [122, 264053], [133, 265153], [137, 265473], [144, 265913], [151, 266493], [154, 266613], [161, 267508], [163, 267613], [172, 268053], [174, 268193], [179, 268453], [181, 268673]]}, {"verse": 29, "start": 269871, "end": 276197, "text": "Y Rubén volvió a la cisterna, y no halló a José dentro, y rasgó sus vestidos.", "words": [[0, 269871], [2, 269958], [8, 270418], [15, 270938], [17, 271038], [20, 271138], [30, 271938], [32, 272238], [35, 272498], [41, 272878], [43, 272998], [48, 273178], [56, 273718], [58, 274378], [64, 275078], [68, 275278]]}, {"verse": 30, "start": 276647, "end": 281738, "text": "Y volvió a sus hermanos, y dijo: El joven no aparece; y yo, ¿adónde iré yo?", "words": [[0, 276647], [2, 276771], [9, 277171], [11, 277171], [15, 277331], [25, 277951], [27, 278071], [33, 278868], [36, 278956], [42, 279236], [45, 279396], [54, 280312], [56, 280452], [60, 280772], [68, 281092], [72, 281452]]}, {"verse": 31, "start": 282088, "end": 290642, "text": "Entonces tomaron ellos la ropa de José, y degollaron un cabrito de las cabras, y tiñeron la ropa con la sangre;", "words": [[0, 282088], [9, 282713], [17, 283453], [23, 283693], [26, 283913], [31, 284273], [34, 284393], [40, 284773], [42, 285393], [53, 286113], [56, 286393], [64, 286973], [67, 287133], [71, 287293], [79, 287933], [81, 288493], [89, 289013], [92, 289193], [97, 289633], [101, 289813], [104, 289973]]}, {"verse": 32, "start": 291092, "end": 300872, "text": "Y enviaron la ropa de colores y la trajeron a su padre, y dijeron: Esta hemos hallado, reconoce ahora si es o no la ropa de tu hijo.", "words": [[0, 291092], [2, 291238], [11, 291758], [14, 291978], [19, 292338], [22, 292458], [30, 292958], [32, 293198], [35, 293338], [44, 293918], [46, 293998], [49, 294118], [56, 294498], [58, 295118], [67, 296249], [72, 296369], [78, 296569], [87, 297469], [96, 298049], [102, 298309], [105, 298569], [108, 298809], [110, 299009], [113, 299469], [116, 299779], [121, 300089], [124, 300229], [127, 300409]]}, {"verse": 33, "start": 301322, "end": 308637, "text": "Y él la conoció, y dijo: La ropa de mi hijo es; alguna mala bestia le devoró; José ha sido despedazado.", "words": [[0, 301322], [2, 301506], [5, 301666], [8, 301786], [17, 302326], [19, 302546], [25, 303261], [28, 303402], [33, 303722], [36, 303862], [39, 303982], [44, 304162], [48, 304937], [55, 305218], [60, 305498], [67, 305998], [70, 306098], [78, 306877], [83, 307232], [86, 307512], [91, 307732]]}, {"verse": 34, "start": 308987, "end": 316483, "text": "Entonces Jacob rasgó sus vestidos, y puso saco sobre sus lomos, y se enlutó por su hijo muchos días.", "words": [[0, 308987], [9, 309552], [15, 310052], [21, 310872], [25, 311072], [35, 311712], [37, 312232], [42, 312552], [47, 312992], [53, 313232], [57, 313542], [64, 313852], [66, 314292], [69, 314412], [76, 314992], [80, 315152], [83, 315372], [88, 315532], [95, 315872]]}, {"verse": 35, "start": 316933, "end": 330445, "text": "Y se levantaron todos sus hijos y todas sus hijas para consolarlo; mas él no quiso recibir consuelo, y dijo: Porque yo he de descender a mi hijo enlutado hasta la sepultura. Y lo lloró su padre.", "words": [[0, 316933], [2, 317033], [5, 317113], [16, 317733], [22, 318053], [26, 318433], [32, 318773], [34, 319213], [40, 319433], [44, 319753], [50, 320093], [55, 320273], [67, 321569], [71, 321726], [74, 321866], [77, 322026], [83, 322366], [91, 322826], [101, 324086], [103, 324266], [109, 325067], [116, 325300], [119, 325580], [122, 325700], [125, 325780], [135, 326320], [137, 326460], [140, 326620], [145, 326900], [154, 327500], [160, 327720], [163, 327880], [174, 328995], [176, 329157], [179, 329277], [185, 329677], [188, 329737]]}, {"verse": 36, "start": 330895, "end": 338369, "text": "Y los madianitas lo vendieron en Egipto a Potifar, oficial de Faraón, capitán de los de la guardia.", "words": [[0, 330895], [2, 331113], [6, 331233], [17, 332033], [20, 332513], [30, 333013], [33, 333213], [40, 333833], [42, 334073], [51, 335013], [59, 335473], [62, 335693], [70, 336573], [78, 337073], [81, 337213], [85, 337373], [88, 337613], [91, 337733]]}]}