{"book": "ISA", "chapter": 21, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 156894, "verses": [{"verse": 1, "start": 300, "end": 9294, "text": "Carga del desierto del mar. Como los torbellinos que pasan por el desierto en la región del sur, así vienen de la tierra horrenda.", "words": [[0, 300], [6, 668], [10, 948], [19, 1568], [23, 1788], [28, 2625], [33, 2770], [37, 3210], [49, 3650], [53, 3810], [59, 4250], [63, 4450], [66, 4610], [75, 5170], [78, 5350], [81, 5510], [88, 5870], [92, 6190], [97, 6970], [101, 7170], [108, 7570], [111, 7770], [114, 7910], [121, 8636]]}, {"verse": 2, "start": 9744, "end": 21656, "text": "Visión dura me ha sido mostrada. El traidor traiciona, y el destructor destruye. Sube, Persa; cerca, Medo. Todo su gemido hice cesar.", "words": [[0, 9744], [7, 10528], [12, 10888], [15, 11408], [18, 11528], [23, 11748], [33, 12986], [36, 13147], [44, 13647], [55, 14827], [57, 15027], [60, 15187], [71, 15887], [81, 17430], [87, 17800], [94, 18664], [101, 18954], [107, 19810], [112, 19994], [115, 20274], [122, 20584], [127, 20894]]}, {"verse": 3, "start": 22106, "end": 33859, "text": "Por tanto mis lomos se han llenado de dolor; angustias se apoderaron de mí, como angustias de mujer de parto: me agobié al oír, y al ver me he espantado.", "words": [[0, 22106], [4, 22210], [10, 22950], [14, 23070], [20, 23470], [23, 23710], [27, 23850], [35, 24390], [38, 24570], [45, 25428], [55, 26173], [58, 26593], [69, 27253], [72, 27513], [76, 27753], [81, 28293], [91, 28913], [94, 29053], [100, 29313], [103, 29593], [110, 30586], [113, 30822], [120, 31092], [123, 31432], [128, 31832], [130, 32192], [133, 32307], [137, 32422], [140, 32537], [143, 32652]]}, {"verse": 4, "start": 34309, "end": 41102, "text": "Se pasmó mi corazón, el horror me ha intimidado; la noche de mi deseo se me volvió en espanto.", "words": [[0, 34309], [3, 34474], [9, 34954], [12, 35054], [21, 36094], [24, 36214], [31, 36634], [34, 36934], [37, 37074], [49, 38408], [52, 38525], [58, 38805], [61, 39020], [64, 39235], [70, 39450], [73, 39665], [76, 39845], [83, 40325], [86, 40385]]}, {"verse": 5, "start": 41552, "end": 48282, "text": "Pon la mesa, mira del atalaya, come, bebe: levantaos, príncipes, ungid el escudo.", "words": [[0, 41552], [4, 41717], [7, 41897], [13, 42317], [18, 42677], [22, 43037], [31, 43397], [37, 44057], [43, 44840], [54, 45923], [65, 46713], [71, 47503], [74, 47623]]}, {"verse": 6, "start": 48732, "end": 55615, "text": "Porque el Señor me dijo así: Ve, pon centinela que haga saber lo que vea.", "words": [[0, 48732], [7, 48974], [10, 49134], [16, 49434], [19, 49694], [24, 49934], [29, 50755], [33, 50865], [37, 51305], [47, 51745], [51, 51985], [56, 52185], [62, 52485], [65, 52685], [69, 52805]]}, {"verse": 7, "start": 56249, "end": 64692, "text": "Y vio un carro de un par de caballeros, un carro de asno, y un carro de camello. Luego miró mucho más atentamente.", "words": [[0, 56249], [2, 56373], [6, 56613], [9, 56813], [15, 57293], [18, 57573], [21, 57713], [25, 57993], [28, 58173], [40, 59133], [43, 59253], [49, 59593], [52, 59813], [58, 60293], [60, 60753], [63, 60913], [69, 61253], [72, 61433], [81, 62441], [87, 62667], [92, 63087], [98, 63347], [102, 63567]]}, {"verse": 8, "start": 65142, "end": 73838, "text": "Y gritó como un león: Señor, sobre la atalaya estoy yo continuamente de día, y las noches enteras sobre mi guarda:", "words": [[0, 65142], [2, 65328], [8, 65688], [13, 65968], [16, 66208], [22, 67139], [29, 67634], [35, 67694], [38, 67894], [46, 68354], [52, 68654], [55, 68934], [69, 69654], [72, 69854], [77, 70154], [79, 70614], [83, 70774], [90, 71094], [98, 71574], [104, 71774], [107, 71954]]}, {"verse": 9, "start": 74188, "end": 85762, "text": "Y he aquí este carro de hombres viene, un par de caballeros. Después habló, y dijo: Cayó, cayó Babilonia; y todos los ídolos de sus dioses quebrantó en tierra.", "words": [[0, 74188], [2, 74350], [5, 74610], [10, 74930], [15, 75230], [21, 75610], [24, 75830], [32, 76110], [39, 77070], [42, 77250], [46, 77570], [49, 77790], [61, 79026], [69, 79313], [76, 79933], [78, 80093], [84, 81343], [90, 81768], [95, 82193], [106, 82881], [108, 82983], [114, 83163], [118, 83423], [125, 83843], [128, 83923], [132, 84083], [139, 84603], [149, 85123], [152, 85243]]}, {"verse": 10, "start": 86112, "end": 93778, "text": "Trilla mía, y paja de mi era: os he dicho lo que oí de Jehová de los ejércitos, Dios de Israel.", "words": [[0, 86112], [7, 86436], [12, 87356], [14, 87496], [19, 87916], [22, 88223], [25, 88529], [30, 89100], [33, 89230], [36, 89510], [42, 89850], [45, 90070], [49, 90230], [52, 90550], [55, 90690], [62, 91150], [65, 91230], [69, 91350], [80, 92490], [85, 92770], [88, 93070]]}, {"verse": 11, "start": 94228, "end": 101714, "text": "Carga de Duma. Danme voces de Seir: Guarda, ¿qué de la noche? Guarda, ¿qué de la noche?", "words": [[0, 94228], [6, 94435], [9, 94675], [15, 95864], [21, 96264], [27, 96684], [30, 97086], [36, 97738], [44, 98138], [49, 98238], [52, 98358], [55, 98478], [62, 99229], [70, 99734], [75, 99814], [78, 99934], [81, 100054]]}, {"verse": 12, "start": 102064, "end": 109349, "text": "El guarda respondió: La mañana viene, y después la noche: si preguntáis, preguntad; volved, venid.", "words": [[0, 102064], [3, 102194], [10, 102654], [21, 103835], [24, 103934], [31, 104214], [38, 104614], [40, 104814], [48, 105154], [51, 105494], [58, 106291], [61, 106430], [73, 107430], [84, 108364], [92, 108941]]}, {"verse": 13, "start": 109699, "end": 116377, "text": "Carga sobre Arabia. En el monte tendréis la noche en Arabia, oh caminantes de Dedanim.", "words": [[0, 109699], [6, 110026], [12, 110486], [20, 111523], [23, 111669], [26, 111809], [32, 112149], [41, 112829], [44, 112989], [50, 113269], [53, 113489], [61, 113939], [64, 114389], [75, 115149], [78, 115779]]}, {"verse": 14, "start": 116827, "end": 125076, "text": "Salid a encontrar al sediento; llevadle aguas, habitantes de tierra de Tema, socorred con su pan al que huye.", "words": [[0, 117035], [6, 117285], [8, 117365], [18, 117825], [21, 118245], [31, 119618], [40, 119938], [47, 120818], [58, 121358], [61, 121538], [68, 121858], [71, 122058], [77, 122678], [86, 123298], [90, 123558], [93, 123798], [97, 124098], [100, 124358], [104, 124518]]}, {"verse": 15, "start": 125526, "end": 137505, "text": "Porque de la presencia de las espadas huyen, de la presencia de la espada desnuda, de la presencia del arco tensado, de la presencia del peso de la batalla.", "words": [[0, 125526], [7, 125770], [10, 125970], [13, 126090], [23, 126730], [26, 126950], [30, 127130], [38, 127710], [45, 129110], [48, 129130], [51, 129270], [61, 130730], [64, 130930], [67, 131030], [74, 131530], [83, 132550], [86, 132790], [89, 132910], [99, 133450], [103, 133670], [108, 133990], [117, 134930], [120, 135110], [123, 135210], [133, 135790], [137, 135970], [142, 136430], [145, 136650], [148, 136770]]}, {"verse": 16, "start": 137955, "end": 146801, "text": "Porque así me ha dicho Jehová: De aquí a un año, semejante a años de mozo de soldada, toda la gloria de Cedar será deshecha;", "words": [[0, 137955], [7, 138220], [11, 138500], [14, 138700], [17, 138780], [23, 139000], [31, 139950], [34, 140111], [39, 140391], [41, 140651], [44, 140851], [49, 141391], [59, 142211], [61, 142451], [66, 142731], [69, 142931], [74, 143291], [77, 143431], [86, 144371], [91, 144791], [94, 144891], [101, 145271], [104, 145541], [110, 145811], [115, 146111]]}, {"verse": 17, "start": 147506, "end": 156494, "text": "Y los sobrevivientes del número de los valientes flecheros, hijos de Cedar, serán reducidos: porque Jehová Dios de Israel lo ha dicho.", "words": [[0, 147506], [2, 147889], [6, 147989], [21, 148769], [25, 148989], [32, 149289], [35, 149489], [39, 149609], [49, 149989], [60, 151049], [66, 151229], [69, 151729], [76, 152229], [82, 152549], [93, 154004], [100, 154266], [107, 154846], [112, 155066], [115, 155306], [122, 155626], [125, 155886], [128, 155986]]}]}