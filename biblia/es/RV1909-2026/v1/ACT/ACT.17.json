{"book": "ACT", "chapter": 17, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 322650, "verses": [{"verse": 1, "start": 300, "end": 7935, "text": "Y pasando por Anfípolis y Apolonia, llegaron a Tesalónica, donde estaba la sinagoga de los judíos.", "words": [[0, 300], [2, 403], [10, 723], [14, 1393], [24, 2063], [26, 2343], [36, 3403], [45, 3943], [47, 4263], [59, 5503], [65, 5663], [72, 6023], [75, 6223], [84, 6923], [87, 7103], [91, 7223]]}, {"verse": 2, "start": 8385, "end": 15872, "text": "Y Pablo, como acostumbraba, entró a ellos, y por tres sábados razonó con ellos sobre las Escrituras,", "words": [[0, 8385], [2, 8507], [9, 9067], [14, 9347], [28, 10507], [34, 11127], [36, 11227], [43, 11567], [45, 12067], [49, 12227], [54, 12507], [62, 13407], [69, 13967], [73, 14167], [79, 14387], [85, 14707], [89, 14967]]}, {"verse": 3, "start": 16322, "end": 28590, "text": "Explicando y demostrando que era necesario que el Cristo padeciese, y resucitase de los muertos; y que Jesús, el cual yo os anuncio, decía él, este era el Cristo.", "words": [[0, 16322], [11, 17109], [13, 17209], [25, 17849], [29, 18089], [33, 18249], [43, 18889], [47, 19169], [50, 19329], [57, 19689], [68, 20629], [70, 20889], [81, 22049], [84, 22209], [88, 22349], [97, 23410], [99, 23516], [103, 23636], [110, 24536], [113, 24616], [118, 24816], [121, 25096], [124, 25316], [133, 26276], [139, 26776], [143, 27436], [148, 27616], [152, 27766], [155, 27916]]}, {"verse": 4, "start": 29040, "end": 39055, "text": "Y algunos de ellos creyeron, y se juntaron con Pablo y con Silas; y de los griegos religiosos grande multitud, y mujeres nobles no pocas.", "words": [[0, 29040], [2, 29138], [10, 29418], [13, 29638], [19, 29838], [29, 30618], [31, 31138], [34, 31278], [43, 31818], [47, 32018], [53, 32538], [55, 32698], [59, 32958], [66, 33920], [68, 34027], [71, 34107], [75, 34267], [83, 34607], [94, 35367], [101, 35727], [111, 36567], [113, 37067], [121, 37447], [128, 37967], [131, 38387]]}, {"verse": 5, "start": 39505, "end": 55286, "text": "Entonces los judíos que eran incrédulos, teniendo celos, tomaron consigo a algunos ociosos, malos hombres, y formando una turba, alborotaron la ciudad; y asaltando la casa de Jasón, procuraban sacarlos al pueblo.", "words": [[0, 39505], [9, 40128], [13, 40708], [20, 41308], [24, 41448], [29, 41648], [41, 42768], [50, 43268], [57, 44068], [65, 44428], [73, 44668], [75, 44908], [83, 45688], [92, 46468], [98, 46888], [107, 47768], [109, 47808], [118, 48308], [122, 48468], [129, 49288], [141, 50068], [144, 50228], [152, 51180], [154, 51269], [164, 51869], [167, 52029], [172, 52269], [175, 52719], [182, 53169], [193, 53889], [202, 54489], [205, 54669]]}, {"verse": 6, "start": 55736, "end": 66447, "text": "Pero no hallándolos, trajeron a Jasón y a algunos hermanos a los gobernadores de la ciudad, dando voces: Estos que alborotan el mundo, también han venido acá;", "words": [[0, 55736], [5, 55921], [8, 56181], [21, 57341], [30, 58081], [32, 58401], [38, 58721], [40, 58981], [42, 59101], [50, 59461], [59, 60221], [61, 60341], [65, 60441], [78, 61161], [81, 61361], [84, 61481], [92, 62341], [98, 62581], [105, 63626], [111, 63968], [115, 64088], [125, 64668], [128, 64788], [135, 65068], [143, 65448], [147, 65728], [154, 66068]]}, {"verse": 7, "start": 66797, "end": 75067, "text": "A los cuales Jasón ha recibido; y todos estos hacen contra los decretos de César, diciendo que hay otro rey, Jesús.", "words": [[0, 66797], [2, 66925], [6, 67045], [13, 67525], [19, 68005], [22, 68245], [32, 69509], [34, 69617], [40, 69837], [46, 70157], [52, 70577], [59, 70977], [63, 71177], [72, 71777], [75, 71877], [82, 72697], [91, 73077], [95, 73397], [99, 73557], [104, 73877], [109, 74457]]}, {"verse": 8, "start": 75517, "end": 80382, "text": "Y alborotaron al pueblo y a los gobernadores de la ciudad, oyendo estas cosas.", "words": [[0, 75517], [2, 75640], [14, 76400], [17, 76560], [24, 76920], [26, 77280], [28, 77360], [32, 77460], [45, 78120], [48, 78280], [51, 78400], [59, 78700], [66, 79360], [72, 79580]]}, {"verse": 9, "start": 80832, "end": 85647, "text": "Pero recibida una garantía de Jasón y de los demás, los soltaron.", "words": [[0, 80832], [5, 80996], [14, 81736], [18, 81936], [27, 82596], [30, 82926], [36, 83256], [38, 83416], [41, 83516], [45, 83656], [52, 84176], [56, 84696]]}, {"verse": 10, "start": 86097, "end": 96654, "text": "Entonces los hermanos, luego de noche, enviaron a Pablo y a Silas a Berea; los cuales habiendo llegado, entraron en la sinagoga de los judíos.", "words": [[0, 86097], [9, 86661], [13, 87201], [23, 87591], [29, 87981], [32, 88201], [39, 88661], [48, 89461], [50, 89581], [56, 90021], [58, 90361], [60, 90541], [66, 91001], [68, 91241], [75, 92166], [79, 92291], [86, 92731], [95, 93051], [104, 93951], [113, 94551], [116, 94851], [119, 94991], [128, 95591], [131, 95791], [135, 95911]]}, {"verse": 11, "start": 97104, "end": 109893, "text": "Y fueron estos más nobles que los que estaban en Tesalónica, pues recibieron la palabra con toda disposición, escudriñando cada día las Escrituras, si estas cosas eran así.", "words": [[0, 97104], [2, 97209], [9, 97489], [15, 97809], [19, 98109], [26, 98689], [30, 99309], [34, 99449], [38, 99609], [46, 100029], [49, 100839], [61, 101649], [66, 101809], [77, 102769], [80, 102969], [88, 103389], [92, 103709], [97, 104009], [110, 105429], [123, 106349], [128, 106589], [132, 106909], [136, 107109], [148, 108129], [151, 108309], [157, 108569], [163, 108969], [168, 109349]]}, {"verse": 12, "start": 110343, "end": 116974, "text": "Así que creyeron muchos de ellos; y mujeres Griegas de distinción, y no pocos hombres.", "words": [[0, 110343], [4, 110683], [8, 111053], [17, 111423], [24, 111783], [27, 112063], [34, 112966], [36, 113088], [44, 113468], [52, 114088], [55, 114228], [67, 115128], [69, 115748], [72, 115908], [78, 116328]]}, {"verse": 13, "start": 117424, "end": 128184, "text": "Pero como entendieron los judíos de Tesalónica que también en Berea era anunciada la palabra de Dios por Pablo, fueron, y también allí alborotaron al pueblo.", "words": [[0, 117424], [5, 117568], [10, 117888], [22, 118648], [26, 118868], [33, 119408], [36, 119588], [47, 120348], [51, 120528], [59, 120868], [62, 121128], [68, 121648], [72, 121908], [82, 122828], [85, 122988], [93, 123328], [96, 123568], [101, 123828], [105, 124128], [112, 125088], [120, 125448], [122, 126048], [130, 126308], [135, 126668], [147, 127408], [150, 127588]]}, {"verse": 14, "start": 128634, "end": 135898, "text": "Pero luego los hermanos enviaron a Pablo que fuese como al mar; y Silas y Timoteo se quedaron allí.", "words": [[0, 128634], [5, 128796], [11, 129096], [15, 129296], [24, 130016], [33, 130656], [35, 130816], [41, 131116], [45, 131336], [51, 131756], [56, 132016], [59, 132324], [64, 132911], [66, 133355], [72, 133830], [74, 134305], [82, 134780], [85, 134900], [94, 135380]]}, {"verse": 15, "start": 136348, "end": 146816, "text": "Y los que habían tomado a cargo a Pablo, le llevaron hasta Atenas; y tomando encargo para Silas y Timoteo, que viniesen a él lo más pronto que pudiesen, salieron.", "words": [[0, 136348], [2, 136451], [6, 136531], [10, 136691], [17, 136871], [24, 137351], [26, 137511], [32, 137691], [34, 137911], [41, 138141], [44, 138371], [53, 138829], [59, 139287], [67, 139980], [69, 140102], [77, 140562], [85, 141142], [90, 141557], [96, 141972], [98, 142387], [107, 142802], [111, 143212], [120, 143622], [122, 143782], [125, 143922], [128, 144082], [132, 144242], [139, 144582], [143, 144802], [153, 145842]]}, {"verse": 16, "start": 147266, "end": 154790, "text": "Y esperándolos Pablo en Atenas, su espíritu se deshacía en él viendo la ciudad dada a idolatría.", "words": [[0, 147266], [2, 147611], [15, 147991], [21, 148391], [24, 148531], [32, 149451], [35, 149791], [44, 150671], [47, 150811], [56, 151571], [59, 151751], [62, 151891], [69, 152251], [72, 152531], [79, 153041], [84, 153551], [86, 154203]]}, {"verse": 17, "start": 155240, "end": 163610, "text": "Así que, razonaba en la sinagoga con los judíos y religiosos; y en la plaza cada día con los que se encontraba.", "words": [[0, 155240], [4, 155466], [9, 155686], [18, 156406], [21, 156566], [24, 156706], [33, 157406], [37, 157646], [41, 157826], [48, 158406], [50, 158526], [62, 159900], [64, 160240], [67, 160400], [70, 160560], [76, 161340], [81, 161520], [85, 162000], [89, 162140], [93, 162320], [97, 162480], [100, 162640]]}, {"verse": 18, "start": 164060, "end": 181147, "text": "Y algunos filósofos de los epicúreos y de los estoicos, disputaban con él; y unos decían: ¿Qué quiere decir este palabrero? Y otros: Parece que es predicador de nuevos dioses: porque les predicaba a Jesús y la resurrección.", "words": [[0, 164060], [2, 164177], [10, 164457], [20, 165357], [23, 165457], [27, 166027], [37, 166597], [39, 166797], [42, 166897], [46, 167037], [56, 167677], [67, 168837], [71, 169077], [75, 169811], [77, 169999], [82, 170199], [90, 171375], [95, 171497], [102, 171797], [108, 172157], [113, 172417], [124, 173473], [126, 173610], [133, 174507], [140, 174789], [144, 175029], [147, 175169], [158, 175849], [161, 176009], [168, 176209], [176, 177373], [183, 177637], [187, 177837], [197, 178557], [199, 178697], [205, 179117], [207, 179797], [210, 179937]]}, {"verse": 19, "start": 181597, "end": 187961, "text": "Y tomándole, le trajeron al Areópago, diciendo: ¿Podremos saber qué sea esta nueva doctrina que dices?", "words": [[0, 181597], [2, 181723], [13, 182210], [16, 182696], [25, 183183], [28, 183323], [38, 184083], [48, 185106], [58, 185409], [64, 185709], [68, 185929], [72, 186229], [77, 186449], [83, 186689], [92, 187189], [96, 187369]]}, {"verse": 20, "start": 188411, "end": 193540, "text": "Porque pones en nuestros oídos unas nuevas cosas: queremos pues saber qué significa esto.", "words": [[0, 188411], [7, 188570], [13, 188950], [16, 189090], [25, 189290], [31, 189950], [36, 190090], [43, 190350], [50, 191443], [59, 191723], [64, 191943], [70, 192243], [74, 192443], [84, 192943]]}, {"verse": 21, "start": 193890, "end": 203170, "text": "(Entonces todos los atenienses y los huéspedes extranjeros, no se ocupaban de otra cosa que de decir o de oír alguna cosa nueva.)", "words": [[0, 193890], [10, 194656], [16, 194896], [20, 195406], [31, 195916], [33, 196076], [37, 196216], [47, 196796], [60, 197816], [63, 198256], [66, 198456], [75, 199156], [78, 199316], [83, 199476], [88, 199916], [92, 200516], [95, 200696], [101, 201156], [103, 201436], [106, 201576], [110, 201896], [117, 202196], [122, 202556]]}, {"verse": 22, "start": 203620, "end": 211305, "text": "Estando pues Pablo en medio del Areópago, dijo: Varones atenienses, en todo observo que sois muy religiosos;", "words": [[0, 203620], [8, 204147], [13, 204367], [19, 204887], [22, 205207], [28, 205587], [32, 205807], [42, 206927], [48, 207871], [56, 208363], [68, 208893], [71, 209093], [76, 209293], [84, 209853], [88, 209953], [93, 210293], [97, 210433]]}, {"verse": 23, "start": 211755, "end": 224098, "text": "Porque pasando y mirando vuestros santuarios, hallé también un altar en el cual estaba esta inscripción: AL DIOS NO CONOCIDO. Aquel pues, que vosotros honráis sin conocerle, a este os anuncio yo.", "words": [[0, 211755], [7, 211959], [15, 212419], [17, 212599], [25, 212979], [34, 213339], [46, 213979], [52, 214619], [60, 214939], [63, 215179], [69, 215519], [72, 215699], [75, 215759], [80, 215999], [87, 216419], [92, 216759], [105, 217937], [108, 218120], [113, 218340], [116, 218600], [126, 219585], [132, 219950], [138, 220170], [142, 220370], [151, 220790], [159, 221430], [163, 221570], [174, 222570], [176, 222830], [181, 223110], [184, 223270], [192, 223710]]}, {"verse": 24, "start": 224548, "end": 232896, "text": "El Dios que hizo el mundo y todas las cosas que en él hay, este, siendo Señor del cielo y de la tierra, no habita en templos hechos de manos,", "words": [[0, 224548], [3, 224677], [8, 224937], [12, 225177], [17, 225397], [20, 225557], [26, 225857], [28, 226017], [34, 226177], [38, 226477], [44, 226777], [48, 227077], [51, 227217], [54, 227337], [59, 227637], [65, 228257], [72, 228517], [78, 228877], [82, 229117], [88, 229457], [90, 229637], [93, 229737], [96, 229837], [104, 230757], [107, 230877], [114, 231257], [117, 231397], [125, 231897], [132, 232217], [135, 232377]]}, {"verse": 25, "start": 233346, "end": 240451, "text": "Ni es servido por manos humanas, como si necesitara algo; pues él da a todos vida, y aliento, y todas las cosas;", "words": [[0, 233346], [3, 233532], [6, 233712], [14, 234092], [18, 234252], [24, 234492], [33, 235132], [38, 235412], [41, 235592], [52, 236252], [58, 237010], [63, 237156], [66, 237356], [69, 237516], [71, 237636], [77, 237816], [83, 238236], [85, 238576], [94, 239016], [96, 239376], [102, 239556], [106, 239836]]}, {"verse": 26, "start": 240901, "end": 251426, "text": "Y de una sangre ha hecho todo el linaje de los hombres, para que habitasen sobre toda la faz de la tierra; y les ha prefijado el orden de los tiempos, y los límites de donde habitarían;", "words": [[0, 240901], [2, 241008], [5, 241108], [9, 241268], [16, 241688], [19, 241988], [25, 242228], [30, 242528], [33, 242728], [40, 243128], [43, 243268], [47, 243408], [56, 243788], [61, 244488], [65, 244838], [75, 245188], [81, 245388], [86, 245648], [89, 245848], [93, 246128], [96, 246288], [99, 246388], [107, 247196], [109, 247298], [113, 247418], [116, 247578], [126, 248138], [129, 248258], [135, 248458], [138, 248638], [142, 248778], [151, 249338], [153, 249658], [157, 249798], [165, 250278], [168, 250458], [174, 250638]]}, {"verse": 27, "start": 251876, "end": 258821, "text": "Para que buscasen a Dios, si en alguna manera, palpando, le hallen; aunque cierto no está lejos de cada uno de nosotros:", "words": [[0, 251876], [5, 252018], [9, 252368], [18, 252718], [20, 252798], [26, 253038], [29, 253438], [32, 253538], [39, 253798], [47, 254258], [57, 254978], [60, 255378], [68, 256023], [75, 256200], [82, 256440], [85, 256720], [90, 256940], [96, 257280], [99, 257440], [104, 257620], [108, 257880], [111, 258040]]}, {"verse": 28, "start": 259271, "end": 266767, "text": "Porque en él vivimos, y nos movemos, y somos; como también algunos de vuestros poetas dijeron: Porque linaje de este somos también.", "words": [[0, 259271], [7, 259499], [10, 259659], [13, 259759], [22, 260239], [24, 260479], [28, 260639], [37, 261219], [39, 261379], [46, 262256], [51, 262419], [59, 262759], [67, 263119], [70, 263299], [79, 263599], [86, 264099], [95, 264936], [102, 265220], [109, 265540], [112, 265700], [117, 265880], [123, 266120]]}, {"verse": 29, "start": 267217, "end": 277223, "text": "Siendo pues linaje de Dios, no hemos de estimar la Divinidad ser semejante a oro, o a plata, o a piedra, escultura del arte o de la imaginación humana.", "words": [[0, 267401], [7, 267591], [12, 267791], [19, 268451], [22, 268591], [28, 269491], [31, 269751], [37, 270031], [40, 270211], [48, 270671], [51, 270751], [61, 271331], [65, 271591], [75, 272231], [77, 272431], [82, 272671], [84, 272971], [86, 273051], [93, 273431], [95, 273771], [97, 273851], [105, 274511], [115, 275031], [119, 275251], [124, 275551], [126, 275871], [129, 275971], [132, 276071], [144, 276711]]}, {"verse": 30, "start": 277673, "end": 285966, "text": "Pero Dios, habiendo pasado por alto los tiempos de esta ignorancia, ahora manda a todos los hombres en todos los lugares que se arrepientan:", "words": [[0, 277673], [5, 277813], [11, 278193], [20, 278513], [27, 278873], [31, 279133], [36, 279373], [40, 279593], [48, 280133], [51, 280253], [56, 280473], [68, 281653], [74, 281753], [80, 282213], [82, 282313], [88, 282493], [92, 282773], [100, 283133], [103, 283453], [109, 283633], [113, 283913], [121, 284293], [125, 284553], [128, 284693]]}, {"verse": 31, "start": 286416, "end": 298436, "text": "Por cuanto ha establecido un día, en el cual ha de juzgar al mundo con justicia, por aquel varón al cual determinó; dando garantía a todos con haberle levantado de los muertos.", "words": [[0, 286416], [4, 286562], [11, 286802], [14, 287162], [26, 287902], [29, 288082], [34, 288402], [37, 288922], [40, 289062], [45, 289322], [48, 289622], [51, 289742], [58, 290142], [61, 290322], [67, 290562], [71, 290842], [81, 291542], [85, 292022], [91, 292322], [97, 292682], [100, 292862], [105, 293082], [116, 294164], [122, 294460], [131, 295140], [133, 295260], [139, 295500], [143, 295820], [151, 296240], [161, 296800], [164, 296920], [168, 297040]]}, {"verse": 32, "start": 298786, "end": 308257, "text": "Y así como oyeron de la resurrección de los muertos, unos se burlaban, y otros decían: Te oiremos acerca de esto otra vez.", "words": [[0, 298786], [2, 298915], [6, 299135], [11, 299475], [18, 299995], [21, 300075], [24, 300255], [37, 301155], [40, 301295], [44, 301435], [53, 302735], [58, 302895], [61, 303215], [71, 303895], [73, 304515], [79, 304775], [87, 305925], [90, 306007], [98, 306527], [105, 306847], [108, 307127], [113, 307407], [118, 307767]]}, {"verse": 33, "start": 308607, "end": 311465, "text": "Y así Pablo se salió de en medio de ellos.", "words": [[0, 308607], [2, 308737], [6, 308957], [12, 309417], [15, 309637], [21, 310097], [24, 310217], [27, 310377], [33, 310597], [36, 310837]]}, {"verse": 34, "start": 311915, "end": 322250, "text": "Pero algunos creyeron, juntándose con él; entre los cuales también fue Dionisio el del Areópago, y una mujer llamada Dámaris, y otros con ellos.", "words": [[0, 311915], [5, 312040], [13, 312360], [23, 313000], [34, 313720], [38, 313980], [42, 314661], [48, 314904], [52, 315084], [59, 315384], [67, 315744], [71, 316064], [80, 317084], [83, 317304], [87, 317484], [97, 318584], [99, 318844], [103, 318964], [109, 319204], [117, 319904], [126, 320564], [128, 321084], [134, 321324], [138, 321664]]}]}