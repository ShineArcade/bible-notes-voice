{"book": "GEN", "chapter": 18, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 288148, "verses": [{"verse": 1, "start": 300, "end": 7903, "text": "Y le apareció Jehová en el valle de Mamre, estando él sentado a la puerta de su tienda en el calor del día.", "words": [[0, 300], [2, 464], [5, 584], [14, 1204], [21, 1724], [24, 1864], [27, 2004], [33, 2264], [36, 2864], [43, 3464], [51, 4004], [54, 4224], [62, 4844], [64, 4944], [67, 5044], [74, 5344], [77, 5624], [80, 5824], [87, 6324], [90, 6484], [93, 6624], [99, 7004], [103, 7284]]}, {"verse": 2, "start": 8253, "end": 20364, "text": "Y alzó sus ojos y miró, y he aquí tres varones que estaban junto a él: y cuando los vio, salió corriendo de la puerta de su tienda a recibirlos, y se inclinó hacia la tierra,", "words": [[0, 8253], [2, 8358], [7, 8698], [11, 8878], [16, 9158], [18, 9398], [24, 10198], [26, 10428], [29, 10658], [34, 10918], [39, 11318], [47, 12018], [51, 12218], [59, 12498], [65, 12878], [67, 13058], [71, 13619], [73, 13722], [80, 13922], [84, 14162], [89, 14442], [95, 14842], [105, 15422], [108, 15582], [111, 15682], [118, 15982], [121, 16242], [124, 16382], [131, 16782], [133, 16922], [145, 17782], [147, 18202], [150, 18362], [158, 19142], [164, 19382], [167, 19642]]}, {"verse": 3, "start": 20714, "end": 26690, "text": "Y dijo: Señor, si ahora he hallado gracia en tus ojos, te ruego que no pases de tu siervo.", "words": [[0, 20714], [2, 20843], [8, 21565], [15, 22512], [18, 22612], [24, 22872], [27, 23032], [35, 23372], [42, 23792], [45, 23852], [49, 23992], [55, 24812], [58, 24892], [64, 25172], [68, 25352], [71, 25512], [77, 25892], [80, 26012], [83, 26132]]}, {"verse": 4, "start": 27040, "end": 32265, "text": "Que se traiga ahora un poco de agua, y lavad vuestros pies; y recostaos debajo de un árbol,", "words": [[0, 27040], [4, 27119], [7, 27239], [14, 27599], [20, 27799], [23, 27939], [28, 28119], [31, 28319], [37, 28599], [39, 28919], [45, 29239], [54, 29659], [60, 30366], [62, 30712], [72, 31092], [79, 31492], [82, 31652], [85, 31732]]}, {"verse": 5, "start": 32615, "end": 42387, "text": "Y traeré un bocado de pan, y recobrad fuerzas; después pasaréis: porque por eso habéis pasado cerca de vuestro siervo. Y ellos dijeron: Haz así como has dicho.", "words": [[0, 32615], [2, 32721], [9, 33121], [12, 33221], [19, 33601], [22, 33741], [27, 34041], [29, 34398], [38, 34756], [47, 35715], [55, 35956], [65, 37001], [72, 37165], [76, 37385], [80, 37545], [87, 37845], [94, 38205], [100, 38465], [103, 38705], [111, 38985], [119, 39806], [121, 39972], [127, 40152], [136, 41145], [140, 41327], [144, 41547], [149, 41747], [153, 41927]]}, {"verse": 6, "start": 42667, "end": 52945, "text": "Entonces Abraham fue de prisa a la tienda a Sara, y le dijo: Toma pronto tres medidas de harina fina, amasa y haz panes cocidos debajo del rescoldo.", "words": [[0, 42667], [9, 43152], [17, 43832], [21, 44232], [24, 44372], [30, 44912], [32, 45132], [35, 45212], [42, 45572], [44, 45932], [50, 46292], [52, 46497], [55, 46637], [61, 47376], [66, 47634], [73, 47894], [78, 48274], [86, 48694], [89, 48894], [96, 49174], [102, 49874], [108, 50294], [110, 50581], [114, 50867], [120, 51154], [128, 51694], [135, 52094], [139, 52274]]}, {"verse": 7, "start": 53225, "end": 61799, "text": "Y corrió Abraham a las vacas, y tomó un becerro tierno y bueno, y lo dio al mozo, y se dio este prisa a prepararlo.", "words": [[0, 53225], [2, 53345], [9, 53825], [17, 54505], [19, 54745], [23, 54905], [30, 55665], [32, 55845], [37, 56225], [40, 56365], [48, 56945], [55, 57545], [57, 57645], [64, 58005], [66, 58240], [69, 58400], [73, 58560], [76, 58740], [82, 59200], [84, 59900], [87, 60060], [91, 60280], [96, 60460], [102, 60880], [104, 61020]]}, {"verse": 8, "start": 62149, "end": 72703, "text": "Tomó también mantequilla y leche, y el becerro que había preparado, y lo puso delante de ellos; y él estaba junto a ellos debajo del árbol; y comieron.", "words": [[0, 62149], [5, 62453], [13, 62713], [25, 63593], [27, 63713], [34, 64093], [36, 64693], [39, 64853], [47, 65413], [51, 65553], [57, 65813], [68, 66573], [70, 66973], [73, 67113], [78, 67493], [86, 67973], [89, 68173], [96, 69016], [98, 69328], [101, 69488], [108, 69768], [114, 70128], [116, 70368], [122, 70548], [129, 71008], [133, 71228], [140, 71888], [142, 72013]]}, {"verse": 9, "start": 73053, "end": 79283, "text": "Y le dijeron: ¿Dónde está Sara tu mujer? Y él respondió: Aquí en la tienda.", "words": [[0, 73053], [2, 73173], [5, 73253], [14, 74319], [21, 74632], [26, 74978], [31, 75325], [34, 75525], [41, 76395], [43, 76587], [46, 76707], [57, 77788], [62, 78268], [65, 78468], [68, 78608]]}, {"verse": 10, "start": 79633, "end": 91589, "text": "Entonces dijo: De cierto volveré a ti según el tiempo de la vida, y he aquí, tendrá un hijo Sara tu mujer. Y Sara escuchaba a la puerta de la tienda, que estaba detrás de él.", "words": [[0, 79633], [9, 80217], [15, 81350], [18, 81556], [25, 81763], [33, 82403], [35, 82503], [38, 82663], [44, 82963], [47, 83223], [54, 83563], [57, 83743], [60, 83863], [66, 84503], [68, 84563], [71, 84703], [77, 85483], [84, 86083], [87, 86263], [92, 86603], [97, 86883], [100, 87023], [107, 87750], [109, 87860], [114, 88100], [124, 88820], [126, 88960], [129, 89060], [136, 89320], [139, 89600], [142, 89720], [150, 90120], [154, 90320], [161, 90620], [168, 91080], [171, 91240]]}, {"verse": 11, "start": 91939, "end": 99086, "text": "Y Abraham y Sara eran ancianos, de edad avanzada: Sara ya había dejado de menstruar.", "words": [[0, 91939], [2, 92239], [10, 92539], [12, 92919], [17, 93299], [22, 93699], [32, 94959], [35, 95099], [40, 95419], [50, 96587], [55, 96893], [58, 97173], [64, 97533], [71, 98113], [74, 98273]]}, {"verse": 12, "start": 99436, "end": 107756, "text": "Se rio, pues, Sara entre sí, diciendo: ¿Después que he envejecido tendré deleite, siendo también mi señor ya viejo?", "words": [[0, 99605], [3, 99805], [8, 100005], [14, 100625], [19, 100965], [25, 101225], [29, 102025], [39, 102936], [48, 103336], [52, 103676], [55, 103856], [66, 104576], [73, 105117], [82, 105659], [89, 105941], [97, 106381], [100, 106601], [106, 106941], [109, 107201]]}, {"verse": 13, "start": 108036, "end": 116273, "text": "Entonces Jehová dijo a Abraham: ¿Por qué se ha reído Sara diciendo: Será cierto que he de parir siendo ya vieja?", "words": [[0, 108036], [9, 109021], [16, 109621], [21, 109801], [23, 109981], [32, 111045], [37, 111149], [41, 111369], [44, 111569], [47, 111709], [53, 112029], [58, 112309], [68, 113597], [73, 113946], [80, 114206], [84, 114506], [87, 114666], [90, 114746], [96, 115126], [103, 115426], [106, 115686]]}, {"verse": 14, "start": 116493, "end": 124034, "text": "¿Hay para Dios alguna cosa difícil? Al tiempo señalado volveré a ti, según el tiempo de la vida, y Sara tendrá un hijo.", "words": [[0, 116493], [5, 116697], [10, 116897], [15, 117117], [22, 117477], [27, 117797], [36, 119021], [39, 119154], [46, 119454], [55, 120114], [63, 120634], [65, 120694], [69, 121094], [75, 121314], [78, 121494], [85, 121754], [88, 121914], [91, 122014], [97, 122514], [99, 122734], [104, 123014], [111, 123514], [114, 123634]]}, {"verse": 15, "start": 124557, "end": 133044, "text": "Entonces Sara negó diciendo: No me reí; porque tuvo miedo. Y él dijo: No es así, sino que te has reído.", "words": [[0, 124557], [9, 125211], [14, 125901], [19, 126361], [29, 127226], [32, 127453], [35, 127533], [40, 128277], [47, 128478], [52, 128738], [59, 129756], [61, 129944], [64, 130104], [70, 130823], [73, 131004], [76, 131264], [81, 131584], [86, 131844], [90, 132044], [93, 132224], [97, 132424]]}, {"verse": 16, "start": 133570, "end": 141091, "text": "Y los varones se levantaron de allí, y miraron hacia Sodoma: y Abraham iba con ellos acompañándolos.", "words": [[0, 133570], [2, 133732], [6, 133852], [14, 134272], [17, 134452], [28, 135012], [31, 135212], [37, 135472], [39, 135972], [47, 136532], [53, 136912], [61, 137942], [63, 138090], [71, 138510], [75, 139070], [79, 139350], [85, 139550]]}, {"verse": 17, "start": 141441, "end": 145288, "text": "Y Jehová dijo: ¿Encubriré yo a Abraham lo que voy a hacer,", "words": [[0, 141441], [2, 141786], [9, 142165], [15, 142676], [26, 143298], [29, 143498], [31, 143758], [39, 144058], [42, 144258], [46, 144378], [50, 144558], [52, 144758]]}, {"verse": 18, "start": 145868, "end": 152744, "text": "Habiendo de ser Abraham una nación grande y fuerte, y habiendo de ser benditas en él todas las naciones de la tierra?", "words": [[0, 145868], [9, 146214], [12, 146374], [16, 146594], [24, 146954], [28, 147314], [35, 147694], [42, 148114], [44, 148234], [52, 148994], [54, 149214], [63, 149514], [66, 149694], [70, 149854], [79, 150454], [82, 150654], [85, 150774], [91, 151054], [95, 151374], [104, 151814], [107, 152014], [110, 152114]]}, {"verse": 19, "start": 153322, "end": 166855, "text": "Porque yo lo he conocido, sé que mandará a sus hijos y a su casa después de sí, que guarden el camino de Jehová, haciendo justicia y juicio, para que haga venir Jehová sobre Abraham lo que ha hablado acerca de él.", "words": [[0, 153322], [7, 153488], [10, 153708], [13, 153848], [16, 153948], [26, 155028], [29, 155248], [33, 155388], [41, 155808], [43, 155948], [47, 156108], [53, 156448], [55, 156628], [57, 156668], [60, 156788], [65, 157108], [73, 157488], [76, 157688], [80, 157968], [84, 158408], [92, 158908], [95, 159008], [102, 159328], [105, 159548], [113, 160288], [122, 160668], [131, 161528], [133, 161628], [141, 162700], [146, 162860], [150, 163040], [155, 163220], [161, 163480], [168, 164060], [174, 164300], [182, 164972], [185, 165115], [189, 165295], [192, 165455], [200, 165855], [207, 166175], [210, 166515]]}, {"verse": 20, "start": 167373, "end": 176534, "text": "Entonces Jehová le dijo: Por cuanto el clamor de Sodoma y Gomorra se aumenta más y más, y el pecado de ellos se ha agravado en extremo,", "words": [[0, 167373], [9, 168020], [16, 169000], [19, 169060], [25, 169805], [29, 169949], [36, 170249], [39, 170389], [46, 170829], [49, 170969], [56, 171429], [58, 171509], [66, 172049], [69, 172469], [77, 172969], [81, 173269], [83, 173389], [88, 173649], [90, 173864], [93, 173984], [100, 174404], [103, 174604], [109, 174864], [112, 175344], [115, 175484], [124, 175964], [127, 176084]]}, {"verse": 21, "start": 177167, "end": 184497, "text": "Descenderé ahora, y veré si han consumado su obra según el clamor que ha venido hasta mí; y si no, lo sabré.", "words": [[0, 177167], [11, 177864], [18, 178204], [20, 178544], [25, 178884], [28, 179144], [32, 179304], [42, 179984], [45, 180164], [50, 180444], [56, 180784], [59, 181004], [66, 181464], [70, 181604], [73, 181724], [80, 182084], [86, 182324], [90, 183116], [92, 183257], [95, 183417], [99, 183797], [102, 183997]]}, {"verse": 22, "start": 185024, "end": 192019, "text": "Y se apartaron de allí los varones, y fueron hacia Sodoma: pero Abraham estaba aún delante de Jehová.", "words": [[0, 185024], [2, 185151], [5, 185251], [15, 185831], [18, 186011], [23, 186231], [27, 186431], [36, 186951], [38, 187411], [45, 187691], [51, 187991], [59, 189010], [64, 189175], [72, 189815], [79, 190370], [83, 190810], [91, 191250], [94, 191450]]}, {"verse": 23, "start": 192369, "end": 197022, "text": "Y se acercó Abraham y dijo: ¿Destruirás también al justo con el impío?", "words": [[0, 192369], [2, 192687], [5, 192767], [12, 193347], [20, 193927], [22, 194127], [28, 194856], [40, 195394], [48, 195614], [51, 195834], [57, 196054], [61, 196314], [64, 196414]]}, {"verse": 24, "start": 197372, "end": 204727, "text": "Quizá hay cincuenta justos dentro de la ciudad: ¿destruirás también y no perdonarás al lugar por cincuenta justos que estén dentro de él?", "words": [[0, 197372], [6, 197676], [10, 197856], [20, 198036], [27, 198676], [34, 198876], [37, 199116], [40, 199216], [48, 200007], [60, 200589], [68, 200969], [70, 201269], [73, 201389], [84, 201989], [87, 202089], [93, 202309], [97, 202569], [107, 202829], [114, 203529], [118, 203629], [124, 203929], [131, 204209], [134, 204429]]}, {"verse": 25, "start": 205077, "end": 216326, "text": "Lejos de ti el hacer tal, que hagas morir al justo con el impío, y que sea el justo tratado como el impío; nunca tal hagas. El juez de toda la tierra, ¿no ha de hacer lo que es justo?", "words": [[0, 205077], [6, 205398], [9, 205598], [12, 205818], [15, 206078], [21, 206378], [26, 207138], [30, 207318], [36, 207598], [42, 207898], [45, 207998], [51, 208258], [55, 208498], [58, 208618], [65, 209058], [67, 209213], [71, 209313], [75, 209493], [78, 209673], [84, 209893], [92, 210393], [97, 210573], [100, 210673], [107, 211463], [113, 211808], [117, 211988], [124, 212736], [127, 212826], [132, 213146], [135, 213266], [140, 213446], [143, 213626], [151, 214426], [155, 214746], [158, 214906], [161, 214986], [167, 215326], [170, 215506], [174, 215626], [177, 215786]]}, {"verse": 26, "start": 216606, "end": 225857, "text": "Entonces respondió Jehová: Si hallo en Sodoma cincuenta justos dentro de la ciudad, perdonaré a todo este lugar por amor de ellos.", "words": [[0, 216606], [9, 217234], [19, 218239], [27, 219083], [30, 219327], [36, 219577], [39, 219697], [46, 220057], [56, 220417], [63, 221257], [70, 221497], [73, 221777], [76, 221877], [84, 222737], [94, 223417], [96, 223677], [101, 223917], [106, 224257], [112, 224597], [116, 224897], [121, 225137], [124, 225357]]}, {"verse": 27, "start": 226379, "end": 233091, "text": "Y Abraham replicó y dijo: He aquí ahora que he comenzado a hablar a mi Señor, aunque soy polvo y ceniza:", "words": [[0, 226379], [2, 226542], [10, 226982], [18, 227962], [20, 228082], [26, 228819], [29, 228956], [34, 229136], [40, 229376], [44, 229656], [47, 229756], [57, 230396], [59, 230476], [66, 230676], [68, 230816], [71, 230916], [78, 231696], [85, 231836], [89, 232076], [95, 232476], [97, 232556]]}, {"verse": 28, "start": 233441, "end": 242170, "text": "Quizá faltarán de cincuenta justos cinco: ¿destruirás por aquellos cinco toda la ciudad? Y dijo: No la destruiré, si hallo allí cuarenta y cinco.", "words": [[0, 233441], [6, 233725], [15, 234205], [18, 234415], [28, 234625], [35, 235240], [42, 236024], [54, 236569], [58, 236729], [67, 237009], [73, 237389], [78, 237669], [81, 237829], [89, 238564], [91, 238693], [97, 239415], [100, 239600], [103, 239700], [114, 240320], [117, 240580], [123, 240840], [128, 241172], [137, 241505], [139, 241838]]}, {"verse": 29, "start": 242706, "end": 250953, "text": "Y volvió a hablarle, y dijo: Quizá se hallarán allí cuarenta. Y respondió: No lo haré por amor de los cuarenta.", "words": [[0, 242706], [2, 242851], [9, 243271], [11, 243391], [21, 244191], [23, 244611], [29, 245356], [35, 245796], [38, 246016], [47, 246509], [52, 247003], [62, 247741], [64, 247888], [75, 248896], [78, 249123], [81, 249283], [86, 249563], [90, 249703], [95, 249903], [98, 250083], [102, 250203]]}, {"verse": 30, "start": 251459, "end": 259724, "text": "Y dijo: No se enoje ahora mi Señor, si hablo: quizá se hallarán allí treinta. Y respondió: No lo haré si hallo allí treinta.", "words": [[0, 251459], [2, 251588], [8, 252310], [11, 252527], [14, 252727], [20, 253107], [26, 253307], [29, 253467], [36, 254007], [39, 254107], [46, 254917], [52, 255147], [55, 255267], [64, 255627], [69, 256022], [78, 256650], [80, 256797], [91, 257805], [94, 257944], [97, 258084], [102, 258464], [105, 258604], [111, 258884], [116, 259304]]}, {"verse": 31, "start": 260252, "end": 270172, "text": "Y dijo: He aquí ahora que he emprendido el hablar a mi Señor: quizá se hallarán allí veinte. No la destruiré, respondió, por amor de los veinte.", "words": [[0, 260252], [2, 260381], [8, 261157], [11, 261237], [16, 261457], [22, 261717], [26, 261997], [29, 262077], [40, 262577], [43, 262677], [50, 262917], [52, 263037], [55, 263137], [62, 264151], [68, 264401], [71, 264521], [80, 264901], [85, 265101], [93, 265912], [96, 266133], [99, 266273], [110, 267635], [121, 268695], [125, 268872], [130, 269092], [133, 269352], [137, 269492]]}, {"verse": 32, "start": 270670, "end": 281069, "text": "Y volvió a decir: No se enoje ahora mi Señor, si hablo solamente una vez: quizá se hallarán allí diez. No la destruiré, respondió, por amor de los diez.", "words": [[0, 270670], [2, 270775], [9, 271195], [11, 271275], [18, 272012], [21, 272134], [24, 272294], [30, 272574], [36, 272854], [39, 272934], [46, 273654], [49, 273754], [55, 274034], [65, 274294], [69, 274714], [74, 275536], [80, 275726], [83, 275826], [92, 276166], [97, 276561], [103, 277129], [106, 277351], [109, 277491], [120, 278852], [131, 279913], [135, 280079], [140, 280319], [143, 280579], [147, 280719]]}, {"verse": 33, "start": 281633, "end": 287748, "text": "Y Jehová se fue, luego que acabó de hablar a Abraham: y Abraham se volvió a su lugar.", "words": [[0, 281750], [2, 281900], [9, 282050], [12, 282200], [17, 283100], [23, 283340], [27, 283580], [33, 284000], [36, 284100], [43, 284380], [45, 284700], [54, 285636], [56, 285755], [64, 286095], [67, 286435], [74, 286935], [76, 287035], [79, 287175]]}]}