{"book": "ROM", "chapter": 14, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 161666, "verses": [{"verse": 1, "start": 300, "end": 4666, "text": "Recibid al débil en la fe, pero no para contiendas de disputas.", "words": [[0, 616], [8, 966], [11, 1106], [17, 1466], [20, 1626], [23, 1746], [27, 2186], [32, 2626], [35, 2826], [40, 3046], [51, 3726], [54, 3826]]}, {"verse": 2, "start": 5016, "end": 10588, "text": "Porque uno cree que se ha de comer de todas cosas: otro que es débil, come verduras.", "words": [[0, 5016], [7, 5217], [11, 5477], [16, 5777], [20, 5977], [23, 6177], [26, 6297], [29, 6357], [35, 6637], [38, 6877], [44, 7057], [51, 7897], [56, 8136], [60, 8356], [63, 8536], [70, 9356], [75, 9756]]}, {"verse": 3, "start": 10938, "end": 18145, "text": "El que come, no menosprecie al que no come: y el que no come, no juzgue al que come; porque Dios lo ha recibido.", "words": [[0, 10938], [3, 11083], [7, 11223], [13, 11523], [16, 11743], [28, 12603], [31, 12763], [35, 12923], [38, 13083], [44, 13854], [46, 13960], [49, 14040], [53, 14160], [56, 14320], [62, 14960], [65, 15160], [72, 15580], [75, 15700], [79, 15820], [85, 16563], [92, 16739], [97, 17039], [100, 17299], [103, 17419]]}, {"verse": 4, "start": 18495, "end": 27120, "text": "¿Tú quién eres que juzgas al siervo ajeno? para su señor está en pie, o cae: pero se afirmará; que poderoso es el Señor para afirmarle.", "words": [[0, 18495], [4, 18633], [10, 18853], [15, 19113], [19, 19293], [26, 19673], [29, 19923], [36, 20173], [43, 20937], [48, 21097], [51, 21277], [57, 21617], [62, 21977], [65, 22177], [70, 22437], [72, 22757], [77, 23482], [82, 23624], [85, 23764], [95, 24734], [99, 24817], [108, 25417], [111, 25577], [114, 25697], [120, 25997], [125, 26357]]}, {"verse": 5, "start": 27470, "end": 34876, "text": "Uno hace diferencia entre día y día; otro juzga iguales todos los días. Cada uno esté asegurado en su ánimo.", "words": [[0, 27470], [4, 27810], [9, 28070], [20, 28570], [26, 29030], [30, 29370], [32, 29510], [37, 30141], [42, 30400], [48, 30880], [56, 31380], [62, 31540], [66, 31860], [72, 32663], [77, 32823], [81, 33143], [86, 33443], [96, 34103], [99, 34243], [102, 34423]]}, {"verse": 6, "start": 35226, "end": 48185, "text": "El que hace caso del día, lo hace para el Señor: y el que no hace caso del día, no lo hace para el Señor. El que come, come para el Señor, porque da gracias a Dios; y el que no come, no come para el Señor, y da gracias a Dios.", "words": [[0, 35226], [3, 35368], [7, 35488], [12, 35728], [17, 36048], [21, 36288], [26, 36568], [29, 36814], [34, 37034], [39, 37274], [42, 37393], [49, 38111], [51, 38194], [54, 38294], [58, 38414], [61, 38634], [66, 38854], [71, 39194], [75, 39434], [80, 39694], [83, 40234], [86, 40374], [91, 40614], [96, 40894], [99, 40994], [106, 41702], [109, 41822], [113, 41942], [119, 42242], [124, 42402], [129, 42662], [132, 42782], [139, 43382], [146, 43542], [149, 43702], [157, 44002], [159, 44242], [165, 44876], [167, 44978], [170, 45058], [174, 45138], [177, 45278], [183, 45798], [186, 45938], [191, 46138], [196, 46378], [199, 46498], [206, 46738], [208, 47078], [211, 47198], [219, 47498], [221, 47758]]}, {"verse": 7, "start": 48535, "end": 52043, "text": "Porque ninguno de nosotros vive para sí, y ninguno muere para sí.", "words": [[0, 48535], [7, 48719], [15, 49199], [18, 49299], [27, 49639], [32, 50019], [37, 50339], [41, 50599], [43, 50734], [51, 51154], [57, 51434], [62, 51654]]}, {"verse": 8, "start": 52393, "end": 60310, "text": "Que si vivimos, para el Señor vivimos; y si morimos, para el Señor morimos. Así que, o que vivamos, o que muramos, del Señor somos.", "words": [[0, 52393], [4, 52475], [7, 52615], [16, 53035], [21, 53275], [24, 53395], [30, 53595], [39, 54574], [41, 54716], [44, 54756], [53, 55476], [58, 55776], [61, 55876], [67, 56116], [76, 56896], [80, 57133], [85, 57373], [87, 57433], [91, 57553], [100, 58313], [102, 58393], [106, 58513], [115, 59013], [119, 59313], [125, 59633]]}, {"verse": 9, "start": 60660, "end": 67533, "text": "Porque Cristo para esto murió, y resucitó, y volvió a vivir, para ser Señor así de los muertos como de los que viven.", "words": [[0, 60660], [7, 60837], [14, 61237], [19, 61497], [24, 61777], [31, 62277], [33, 62457], [43, 63157], [45, 63537], [52, 63937], [54, 63977], [61, 64237], [66, 64617], [70, 64817], [76, 65257], [80, 65537], [83, 65717], [87, 65837], [95, 66277], [100, 66577], [103, 66717], [107, 66817], [111, 66977]]}, {"verse": 10, "start": 67883, "end": 75571, "text": "Pero tú ¿por qué juzgas a tu hermano? o tú también, ¿por qué menosprecias a tu hermano? porque todos hemos de estar ante el tribunal de Cristo.", "words": [[0, 67883], [5, 68021], [8, 68681], [13, 68761], [17, 68901], [24, 69261], [26, 69421], [29, 69481], [38, 70236], [40, 70377], [43, 70457], [52, 71297], [57, 71377], [61, 71767], [74, 72157], [76, 72317], [79, 72397], [88, 73121], [95, 73281], [101, 73541], [107, 73841], [110, 74021], [116, 74241], [121, 74441], [124, 74521], [133, 74921], [136, 75041]]}, {"verse": 11, "start": 75921, "end": 83716, "text": "Porque escrito está: Vivo yo, dice el Señor, que a mí se doblará toda rodilla, y toda lengua confesará a Dios.", "words": [[0, 75921], [7, 76108], [15, 76488], [21, 77243], [26, 77543], [30, 77903], [35, 78023], [38, 78203], [45, 79123], [49, 79223], [51, 79343], [54, 79523], [57, 79703], [65, 80223], [70, 80463], [79, 81063], [81, 81543], [86, 81783], [93, 82243], [103, 82963], [105, 83103]]}, {"verse": 12, "start": 83936, "end": 87051, "text": "De manera que, cada uno de nosotros dará a Dios razón de sí.", "words": [[0, 83936], [3, 84035], [10, 84235], [15, 84495], [20, 84675], [24, 84995], [27, 85115], [36, 85475], [41, 85975], [43, 85995], [48, 86155], [54, 86475], [57, 86715]]}, {"verse": 13, "start": 87401, "end": 94074, "text": "Así que, no juzguemos más los unos de los otros: antes bien decidid no poner tropiezo o escándalo al hermano.", "words": [[0, 87401], [4, 87626], [9, 87786], [12, 87926], [22, 88506], [26, 88706], [30, 88946], [35, 89146], [38, 89326], [42, 89466], [49, 90285], [55, 90547], [60, 91187], [68, 91667], [71, 91827], [77, 92087], [86, 92727], [88, 92887], [98, 93467], [101, 93587]]}, {"verse": 14, "start": 94424, "end": 102599, "text": "Yo sé, y confío en el Señor Jesús, que nada es inmundo por sí mismo: pero a aquel que piensa alguna cosa ser inmunda, para él es inmunda.", "words": [[0, 94424], [3, 94587], [7, 94827], [9, 95067], [16, 95627], [19, 95747], [22, 95847], [28, 96067], [35, 96947], [39, 97027], [44, 97227], [47, 97427], [55, 97867], [59, 98067], [62, 98207], [69, 98889], [74, 98940], [76, 99030], [82, 99390], [86, 99490], [93, 99870], [100, 100110], [105, 100430], [109, 100690], [118, 101410], [123, 101650], [126, 101870], [129, 101990]]}, {"verse": 15, "start": 102949, "end": 111844, "text": "Pero si por causa de la comida tu hermano es entristecido, ya no andas conforme al amor. No arruines con tu comida a aquel por el cual Cristo murió.", "words": [[0, 102949], [5, 103088], [8, 103268], [12, 103468], [18, 103748], [21, 103988], [24, 104108], [31, 104508], [34, 104708], [42, 105168], [45, 105288], [59, 106428], [62, 106728], [65, 106908], [71, 107268], [80, 107808], [83, 107908], [89, 108574], [92, 108735], [101, 109175], [105, 109415], [108, 109555], [115, 109745], [117, 109935], [123, 110355], [127, 110515], [130, 110635], [135, 110835], [142, 111215]]}, {"verse": 16, "start": 112194, "end": 114654, "text": "No sea pues blasfemado vuestro bien:", "words": [[0, 112194], [3, 112394], [7, 112674], [12, 112954], [23, 113774], [31, 114174]]}, {"verse": 17, "start": 115004, "end": 121515, "text": "Que el reino de Dios no es comida ni bebida, sino justicia y paz y gozo por el Espíritu Santo.", "words": [[0, 115004], [4, 115106], [7, 115226], [13, 115566], [16, 115706], [21, 115966], [24, 116326], [27, 116506], [34, 116906], [37, 117146], [45, 117966], [50, 118186], [59, 118966], [61, 119106], [65, 119386], [67, 119706], [72, 120066], [76, 120286], [79, 120406], [88, 120926]]}, {"verse": 18, "start": 121865, "end": 126266, "text": "Porque el que en esto sirve a Cristo, agrada a Dios, y es acepto a los hombres.", "words": [[0, 121865], [7, 122085], [10, 122305], [14, 122465], [17, 122585], [22, 122765], [28, 123165], [30, 123285], [38, 123885], [45, 124245], [47, 124365], [53, 124565], [55, 124925], [58, 125045], [65, 125485], [67, 125545], [71, 125685]]}, {"verse": 19, "start": 126616, "end": 131041, "text": "Así que, sigamos lo que hace a la paz, y a la edificación de los unos a los otros.", "words": [[0, 126616], [4, 126815], [9, 126975], [17, 127395], [20, 127575], [24, 127735], [29, 127935], [31, 128075], [34, 128135], [39, 128475], [41, 128815], [43, 128875], [46, 128955], [58, 129495], [61, 129735], [65, 129895], [70, 130115], [72, 130335], [76, 130475]]}, {"verse": 20, "start": 131391, "end": 140253, "text": "No destruyas la obra de Dios por causa de la comida. Todas las cosas a la verdad son limpias: pero es malo que el hombre coma causando tropiezo.", "words": [[0, 131391], [3, 131512], [13, 132172], [16, 132332], [21, 132512], [24, 132692], [29, 132932], [33, 133232], [39, 133512], [42, 133732], [45, 133832], [53, 134602], [59, 134925], [63, 135085], [69, 135545], [71, 135685], [74, 135765], [81, 136265], [85, 136405], [94, 137347], [99, 137511], [102, 137731], [107, 138151], [111, 138291], [114, 138451], [121, 138651], [126, 138951], [135, 139511]]}, {"verse": 21, "start": 140603, "end": 147363, "text": "Bueno es no comer carne, ni beber vino, ni nada en que tu hermano tropiece, o se ofenda, o sea debilitado.", "words": [[0, 140603], [6, 140860], [9, 141060], [12, 141220], [18, 141500], [25, 141960], [28, 142300], [34, 142540], [40, 143100], [43, 143420], [48, 143700], [51, 143860], [55, 143960], [58, 144120], [66, 144540], [76, 145040], [78, 145325], [81, 145485], [89, 146005], [91, 146345], [95, 146525]]}, {"verse": 22, "start": 147713, "end": 154336, "text": "¿Tienes tú fe? Tenla para contigo delante de Dios. Bienaventurado el que no se condena a sí mismo con lo que aprueba.", "words": [[0, 147713], [8, 148051], [11, 148171], [15, 148798], [21, 149058], [26, 149238], [34, 149698], [42, 150058], [45, 150198], [51, 151460], [66, 151740], [69, 151840], [73, 151940], [76, 152080], [79, 152220], [87, 152660], [89, 152740], [92, 152860], [98, 153280], [102, 153500], [105, 153600], [109, 153720]]}, {"verse": 23, "start": 154686, "end": 161266, "text": "Pero el que duda sobre lo que come, es condenado, porque no lo hace con fe: y todo lo que no es de fe, es pecado.", "words": [[0, 154686], [5, 154825], [8, 154945], [12, 155045], [17, 155305], [23, 155585], [26, 155765], [30, 155885], [36, 156205], [39, 156565], [50, 157305], [57, 157525], [60, 157705], [63, 157845], [68, 158065], [72, 158265], [76, 158907], [78, 159009], [83, 159189], [86, 159389], [90, 159509], [93, 159689], [96, 159829], [99, 159929], [103, 160189], [106, 160609]]}]}