{"book": "ISA", "chapter": 2, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 212979, "verses": [{"verse": 1, "start": 300, "end": 5742, "text": "Lo que vio Isaías, hijo de Amoz, tocante a Judá y a Jerusalén.", "words": [[0, 300], [3, 440], [7, 580], [11, 860], [19, 1940], [24, 2120], [27, 2640], [33, 3160], [41, 3680], [43, 3840], [48, 4520], [50, 4680], [52, 4760]]}, {"verse": 2, "start": 6192, "end": 21104, "text": "Y acontecerá en lo último de los tiempos, que será confirmado el monte de la casa de Jehová por cabeza de los montes, y será exaltado sobre los collados, y correrán a él todas las naciones.", "words": [[0, 6192], [2, 6356], [13, 7336], [16, 7636], [19, 7816], [26, 8376], [29, 8576], [33, 8736], [42, 9796], [46, 10036], [51, 10276], [62, 11076], [65, 11216], [71, 11556], [74, 11896], [77, 12016], [82, 12316], [85, 12536], [92, 13036], [96, 13216], [103, 13656], [106, 13836], [110, 13976], [118, 14676], [120, 15176], [125, 15436], [134, 16576], [140, 16876], [144, 17076], [154, 18345], [156, 18442], [165, 19102], [167, 19322], [170, 19542], [176, 19982], [180, 20322]]}, {"verse": 3, "start": 21554, "end": 37779, "text": "Y vendrán muchos pueblos, y dirán: Venid, y subamos al monte de Jehová, a la casa del Dios de Jacob; y nos enseñará en sus caminos, y caminaremos por sus sendas. Porque de Sion saldrá la ley, y de Jerusalén la palabra de Jehová.", "words": [[0, 21554], [2, 21660], [10, 22080], [17, 22340], [26, 23140], [28, 23340], [35, 24340], [42, 24550], [44, 24730], [52, 25170], [55, 25310], [61, 25590], [64, 25770], [72, 26510], [74, 26570], [77, 26630], [82, 26910], [86, 27130], [91, 27350], [94, 27530], [101, 28284], [103, 28364], [107, 28464], [116, 29064], [119, 29164], [123, 29304], [132, 29884], [134, 30084], [146, 30624], [150, 30864], [154, 31064], [162, 32050], [169, 32294], [172, 32474], [177, 32954], [184, 33734], [187, 33974], [192, 34854], [194, 35134], [197, 35254], [207, 36094], [210, 36454], [218, 36874], [221, 37094]]}, {"verse": 4, "start": 38229, "end": 54286, "text": "Y juzgará entre las naciones, y reprenderá a muchos pueblos; y volverán sus espadas en rejas de arado, y sus lanzas en hoces: no alzará espada nación contra nación, ni se adiestrarán más para la guerra.", "words": [[0, 38229], [2, 38356], [10, 39056], [16, 39416], [20, 39656], [30, 40276], [32, 40536], [43, 41336], [45, 41476], [52, 41696], [61, 42867], [63, 42969], [72, 43489], [76, 43709], [84, 44249], [87, 44529], [93, 44909], [96, 45089], [103, 45609], [105, 46169], [109, 46349], [116, 46989], [119, 47442], [126, 48155], [129, 48383], [136, 48983], [143, 49443], [150, 49903], [157, 50323], [165, 51203], [168, 51523], [171, 51703], [183, 52683], [187, 53043], [192, 53483], [195, 53663]]}, {"verse": 5, "start": 54736, "end": 58591, "text": "Venid, oh casa de Jacob, y caminemos a la luz de Jehová.", "words": [[0, 54736], [7, 55106], [10, 55506], [15, 55845], [18, 56066], [25, 56466], [27, 56786], [37, 57406], [39, 57585], [42, 57686], [46, 57906], [49, 58066]]}, {"verse": 6, "start": 59041, "end": 70298, "text": "Ciertamente tú has dejado tu pueblo, la casa de Jacob, porque están llenos de oriente, y de agoreros, como los filisteos; y en hijos ajenos descansan.", "words": [[0, 59041], [12, 59908], [15, 60228], [19, 60488], [26, 60988], [29, 61148], [37, 62108], [40, 62208], [45, 62488], [48, 62978], [55, 63468], [62, 63748], [68, 64008], [75, 64468], [78, 64608], [87, 65168], [89, 65688], [92, 65808], [102, 66488], [107, 66748], [111, 67315], [122, 68116], [124, 68283], [127, 68403], [133, 68663], [140, 69283]]}, {"verse": 7, "start": 70748, "end": 80704, "text": "Su tierra está llena de plata y oro, sus tesoros no tienen fin. También está su tierra llena de caballos; ni sus carros tienen número.", "words": [[0, 70748], [3, 70948], [10, 71368], [15, 71628], [21, 72008], [24, 72128], [30, 72428], [32, 72708], [37, 73388], [41, 73568], [49, 74248], [52, 74568], [59, 74868], [64, 75786], [72, 76050], [77, 76330], [80, 76530], [87, 76950], [93, 77550], [96, 77650], [106, 78768], [109, 78914], [113, 79074], [120, 79614], [127, 79914]]}, {"verse": 8, "start": 81154, "end": 89795, "text": "Además está su tierra llena de ídolos, y a la obra de sus manos se han arrodillado, a lo que fabricaron sus dedos.", "words": [[0, 81154], [7, 81497], [12, 81897], [15, 82117], [22, 82457], [28, 82937], [31, 83077], [39, 83877], [41, 84457], [43, 84537], [46, 84637], [51, 84917], [54, 85097], [58, 85277], [64, 85697], [67, 86157], [71, 86377], [84, 87337], [86, 87837], [89, 87957], [93, 88077], [104, 88757], [108, 88957]]}, {"verse": 9, "start": 90245, "end": 97097, "text": "Y se ha inclinado el hombre, y el varón se ha humillado: por tanto no los perdonarás.", "words": [[0, 90245], [2, 90409], [5, 90549], [8, 90709], [18, 91309], [21, 91469], [29, 91789], [31, 92609], [34, 92789], [40, 93169], [43, 93349], [46, 93469], [57, 94834], [61, 94938], [67, 95698], [70, 95958], [74, 96118]]}, {"verse": 10, "start": 97547, "end": 106668, "text": "Métete en la piedra, escóndete en el polvo, de la presencia espantosa de Jehová y del resplandor de su majestad.", "words": [[0, 97547], [7, 98011], [10, 98251], [13, 98391], [21, 99411], [31, 100111], [34, 100431], [37, 100571], [44, 101311], [47, 101671], [50, 101791], [60, 102471], [70, 103451], [73, 103901], [80, 104351], [82, 104631], [86, 104831], [97, 105611], [100, 105731], [103, 106217]]}, {"verse": 11, "start": 107118, "end": 116621, "text": "La altivez de los ojos del hombre será abatida, y la soberbia de los hombres será humillada; y Jehová solo será exaltado en aquel día.", "words": [[0, 107118], [3, 107467], [11, 107857], [14, 108217], [18, 108357], [23, 108697], [27, 108897], [34, 109177], [39, 109497], [48, 110217], [50, 110677], [53, 110797], [62, 111357], [65, 111497], [69, 111637], [77, 112017], [82, 112377], [93, 113740], [95, 113863], [102, 114343], [107, 114563], [112, 114903], [121, 115703], [124, 115823], [130, 116163]]}, {"verse": 12, "start": 117071, "end": 127119, "text": "Porque día de Jehová de los ejércitos vendrá sobre todo soberbio y altivo, y sobre todo enaltecido; y será abatido:", "words": [[0, 117224], [7, 117415], [11, 117855], [14, 118055], [21, 118474], [24, 118555], [28, 118715], [38, 119474], [45, 120254], [51, 120515], [56, 120974], [65, 121835], [67, 121974], [75, 122695], [77, 123215], [83, 123474], [88, 123955], [100, 125719], [102, 125842], [107, 126102]]}, {"verse": 13, "start": 127569, "end": 135699, "text": "Y sobre todos los cedros del Líbano altos y sublimes, y sobre todos los alcornoques de Basán;", "words": [[0, 127569], [2, 127732], [8, 127952], [14, 128412], [18, 128752], [25, 129352], [29, 129652], [36, 130412], [42, 131192], [44, 131352], [54, 131912], [56, 132572], [62, 132812], [68, 133472], [72, 133972], [84, 134852], [87, 134992]]}, {"verse": 14, "start": 136149, "end": 142950, "text": "Y sobre todos los montes altos, y sobre todos los collados levantados;", "words": [[0, 136149], [2, 136448], [8, 136648], [14, 137168], [18, 137548], [25, 138108], [32, 138928], [34, 139148], [40, 139388], [46, 139928], [50, 140368], [59, 140948]]}, {"verse": 15, "start": 143400, "end": 147638, "text": "Y sobre toda torre alta, y sobre todo muro fuerte;", "words": [[0, 143400], [2, 143517], [8, 143737], [13, 144197], [19, 144797], [25, 145917], [27, 145917], [33, 146177], [38, 146497], [43, 146857]]}, {"verse": 16, "start": 148088, "end": 153292, "text": "Y sobre todas las naves de Tarsis, y sobre todas pinturas preciadas.", "words": [[0, 148088], [2, 148214], [8, 148434], [14, 148854], [18, 149274], [24, 149774], [27, 149974], [35, 150654], [37, 151054], [43, 151294], [49, 151614], [58, 152274]]}, {"verse": 17, "start": 153742, "end": 163714, "text": "Y la altivez del hombre será abatida, y la soberbia de los hombres será humillada; y solo Jehová será exaltado en aquel día.", "words": [[0, 153742], [2, 153869], [5, 154229], [13, 154589], [17, 154809], [24, 155129], [29, 155529], [38, 156989], [40, 157249], [43, 157369], [52, 158009], [55, 158129], [59, 158269], [67, 158629], [72, 159209], [83, 160554], [85, 160843], [90, 161083], [97, 161703], [102, 161903], [111, 162763], [114, 162883], [120, 163203]]}, {"verse": 18, "start": 164164, "end": 166323, "text": "Y quitará totalmente los ídolos.", "words": [[0, 164164], [2, 164271], [10, 164771], [21, 165211], [25, 165531]]}, {"verse": 19, "start": 166773, "end": 181445, "text": "Y se meterán en las cavernas de las peñas, y en las aberturas de la tierra, por la presencia espantosa de Jehová, y por el resplandor de su majestad, cuando él se levante para castigar la tierra.", "words": [[0, 166773], [2, 166903], [5, 167043], [13, 167663], [16, 167883], [20, 168043], [29, 168663], [32, 168763], [36, 168883], [43, 169523], [45, 170243], [48, 170343], [52, 170463], [62, 171103], [65, 171223], [68, 171343], [76, 171803], [80, 172403], [83, 172563], [93, 173163], [103, 173883], [106, 174063], [114, 175143], [116, 175363], [120, 175943], [123, 176243], [134, 177003], [137, 177143], [140, 177303], [150, 178434], [157, 178679], [160, 178919], [163, 179099], [171, 179599], [176, 179839], [185, 180579], [188, 180699]]}, {"verse": 20, "start": 181895, "end": 191672, "text": "Aquel día arrojará el hombre, a los topos y murciélagos, sus ídolos de plata y sus ídolos de oro, que le hicieron para que adorase;", "words": [[0, 181895], [6, 182260], [10, 182440], [19, 183200], [22, 183340], [30, 183640], [32, 183920], [36, 184060], [42, 184800], [44, 185000], [57, 186200], [61, 186480], [68, 187040], [71, 187140], [77, 187560], [79, 188080], [83, 188220], [90, 188800], [93, 188960], [98, 189240], [102, 189680], [105, 189820], [114, 190440], [119, 190760], [123, 190960]]}, {"verse": 21, "start": 192122, "end": 205491, "text": "Y se meterá en las hendiduras de las rocas y en las cavernas de las peñas, por la presencia formidable de Jehová, y por el resplandor de su majestad, cuando se levante para castigar la tierra.", "words": [[0, 192122], [2, 192266], [5, 192386], [12, 192926], [15, 193066], [19, 193226], [30, 194006], [33, 194186], [37, 194346], [43, 194906], [45, 195186], [48, 195306], [52, 195466], [61, 196046], [64, 196146], [68, 196286], [75, 197066], [79, 197326], [82, 197466], [92, 198086], [103, 198746], [106, 199086], [114, 199886], [116, 200046], [120, 200286], [123, 200466], [134, 201346], [137, 201506], [140, 201666], [150, 202738], [157, 202944], [160, 203184], [168, 203704], [173, 203964], [182, 204664], [185, 204764]]}, {"verse": 22, "start": 205941, "end": 212579, "text": "Dejaos del hombre, cuyo aliento está en su nariz; porque ¿de qué es él estimado?", "words": [[0, 206251], [7, 206591], [11, 206851], [19, 207171], [24, 207611], [32, 208011], [37, 208391], [40, 208731], [43, 208931], [50, 210282], [57, 210702], [61, 211142], [65, 211322], [68, 211582], [71, 211742]]}]}