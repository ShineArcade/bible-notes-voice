{"book": "ISA", "chapter": 22, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 234822, "verses": [{"verse": 1, "start": 300, "end": 6431, "text": "Carga del valle de la visión. ¿Qué tienes ahora, que toda tú te has subido sobre los terrados?", "words": [[0, 300], [6, 591], [10, 917], [16, 1244], [19, 1384], [22, 1524], [30, 2450], [35, 2554], [42, 2934], [49, 3314], [53, 3514], [58, 3794], [61, 4134], [64, 4334], [68, 4474], [75, 4994], [81, 5274], [85, 5886]]}, {"verse": 2, "start": 6881, "end": 16590, "text": "Tú, llena de alborotos, ciudad turbulenta, ciudad alegre; tus muertos no son muertos a espada, ni muertos en guerra.", "words": [[0, 6881], [4, 6983], [10, 7323], [13, 7443], [24, 8443], [31, 8803], [43, 10283], [50, 10523], [58, 11678], [62, 11784], [70, 12424], [73, 12924], [77, 13204], [85, 13724], [87, 13904], [95, 14744], [98, 15104], [106, 15624], [109, 16129]]}, {"verse": 3, "start": 17040, "end": 28324, "text": "Todos tus príncipes juntos huyeron del arco, fueron atados: todos los que en ti se hallaron, fueron atados juntamente, aunque lejos se habían huido.", "words": [[0, 17040], [6, 17320], [10, 17680], [20, 18600], [27, 19160], [35, 20000], [39, 20180], [45, 20600], [52, 21160], [60, 22396], [66, 22664], [70, 23224], [74, 23444], [77, 23604], [80, 23764], [83, 23964], [93, 24424], [100, 24644], [107, 25284], [119, 26244], [126, 26444], [132, 26944], [135, 27144], [142, 27484]]}, {"verse": 4, "start": 28774, "end": 37601, "text": "Por esto dije: Dejadme, lloraré amargamente; no os afanéis por consolarme de la destrucción de la hija de mi pueblo.", "words": [[0, 28774], [4, 28898], [9, 29098], [15, 30060], [24, 30705], [32, 31365], [45, 32653], [48, 32956], [51, 33196], [59, 33776], [63, 34076], [74, 35036], [77, 35156], [80, 35296], [92, 36036], [95, 36236], [98, 36356], [103, 36716], [106, 36816], [109, 36956]]}, {"verse": 5, "start": 38051, "end": 50968, "text": "Porque día es de alboroto, y de pisoteo, y de fatiga por el Señor Jehová de los ejércitos en el valle de la visión, para derribar el muro, y dar gritos al monte.", "words": [[0, 38051], [7, 38575], [11, 39135], [14, 39555], [17, 39755], [27, 40535], [29, 41035], [32, 41155], [41, 42035], [43, 42395], [46, 42535], [53, 43115], [57, 43375], [60, 43535], [66, 43815], [73, 44475], [76, 44555], [80, 44735], [90, 45495], [93, 45695], [96, 45835], [102, 46135], [105, 46315], [108, 46455], [116, 47055], [121, 47495], [130, 48155], [133, 48275], [139, 49153], [141, 49281], [145, 49441], [152, 50081], [155, 50281]]}, {"verse": 6, "start": 51418, "end": 57739, "text": "Y Elam tomó bolsa de flechas en carro de hombres y de caballeros; y Quir descubrió escudo.", "words": [[0, 51418], [2, 51539], [7, 51699], [12, 52239], [18, 52679], [21, 52819], [29, 53299], [32, 53559], [38, 53899], [41, 54099], [49, 54459], [51, 54679], [54, 54799], [66, 55903], [68, 56066], [73, 56266], [83, 57066]]}, {"verse": 7, "start": 58189, "end": 65583, "text": "Y acaeció que tus hermosos valles fueron llenos de carros, y los de a caballo acamparon a la puerta.", "words": [[0, 58189], [2, 58327], [10, 59047], [14, 59247], [18, 59507], [27, 60347], [34, 60787], [41, 61287], [48, 61887], [51, 62007], [59, 62587], [61, 63027], [65, 63187], [68, 63347], [70, 63487], [78, 63967], [88, 64747], [90, 64867], [93, 64927]]}, {"verse": 8, "start": 66033, "end": 72505, "text": "Y desnudó la cobertura de Judá; y miraste en aquel día hacia la casa de armas del bosque.", "words": [[0, 66033], [2, 66198], [10, 67038], [13, 67158], [23, 67858], [26, 68038], [32, 68903], [34, 69025], [42, 69465], [45, 69625], [51, 69905], [55, 70145], [61, 70585], [64, 70765], [69, 71025], [72, 71265], [78, 71565], [82, 71865]]}, {"verse": 9, "start": 72955, "end": 80921, "text": "Y visteis las roturas de la ciudad de David, que se multiplicaron; y recogisteis las aguas del estanque de abajo.", "words": [[0, 72955], [2, 73083], [10, 73743], [14, 73983], [22, 74543], [25, 74703], [28, 74823], [35, 75103], [38, 75343], [45, 75663], [49, 76163], [52, 76323], [67, 77855], [69, 77976], [81, 78936], [85, 79156], [91, 79676], [95, 79776], [104, 80256], [107, 80376]]}, {"verse": 10, "start": 81371, "end": 87059, "text": "Y contasteis las casas de Jerusalén, y derribasteis casas para fortificar el muro.", "words": [[0, 81371], [2, 81500], [13, 81947], [17, 82393], [23, 82840], [26, 83080], [37, 83980], [39, 84447], [52, 84913], [58, 85380], [63, 85700], [74, 86360], [77, 86580]]}, {"verse": 11, "start": 87509, "end": 99327, "text": "Y hicisteis foso entre los dos muros con las aguas del estanque viejo: y no tuvisteis respeto al que la hizo, ni mirasteis de lejos al que la labró.", "words": [[0, 87509], [2, 87850], [12, 88690], [17, 89470], [23, 90030], [27, 90310], [31, 90550], [37, 91090], [41, 91250], [45, 91450], [51, 91850], [55, 91970], [64, 92470], [71, 93352], [73, 93479], [76, 93619], [86, 94459], [94, 95219], [97, 95339], [101, 95499], [104, 95639], [110, 96519], [113, 96659], [123, 97439], [126, 97599], [132, 98099], [135, 98419], [139, 98599], [142, 98759]]}, {"verse": 12, "start": 99777, "end": 109252, "text": "Por tanto el Señor Jehová de los ejércitos llamó en este día a llanto y a endechas, a arrancarse el cabello y a vestir saco.", "words": [[0, 99777], [4, 99879], [10, 100459], [13, 100539], [19, 101019], [26, 101499], [29, 101619], [33, 101799], [43, 102619], [49, 103439], [52, 103559], [57, 103779], [61, 104119], [63, 104399], [70, 104919], [72, 105119], [74, 105199], [84, 106399], [86, 106539], [97, 107459], [100, 107559], [108, 108059], [110, 108239], [112, 108299], [119, 108679]]}, {"verse": 13, "start": 109702, "end": 120508, "text": "Y he aquí gozo y alegría, matando vacas y degollando ovejas, comer carne y beber vino, diciendo: Comamos y bebamos, que mañana moriremos.", "words": [[0, 109702], [2, 109883], [5, 110003], [10, 110243], [15, 110663], [17, 110803], [26, 111843], [34, 112303], [40, 113183], [42, 113363], [53, 114023], [61, 114963], [67, 115223], [73, 115683], [75, 115863], [81, 116083], [87, 116963], [97, 118068], [105, 118472], [107, 118732], [116, 119132], [120, 119332], [127, 119612]]}, {"verse": 14, "start": 120858, "end": 133627, "text": "Esto fue revelado a mis oídos de parte de Jehová de los ejércitos: Que este pecado no os será perdonado hasta que muráis, dice el Señor Jehová de los ejércitos.", "words": [[0, 120858], [5, 121146], [9, 121426], [18, 122066], [20, 122206], [24, 122346], [30, 122866], [33, 122986], [39, 123326], [42, 123566], [49, 124106], [52, 124166], [56, 124326], [67, 125688], [71, 125828], [76, 126148], [83, 126788], [86, 127098], [89, 127408], [94, 127808], [104, 128768], [110, 129328], [114, 129508], [122, 130785], [127, 131150], [130, 131450], [136, 131750], [143, 132330], [146, 132430], [150, 132590]]}, {"verse": 15, "start": 134077, "end": 141490, "text": "Jehová de los ejércitos dice así: Ve, entra a este tesorero, a Sebna el mayordomo, y dile:", "words": [[0, 134077], [7, 134717], [10, 134797], [14, 134957], [24, 135697], [29, 135917], [34, 136656], [38, 136860], [44, 137240], [46, 137580], [51, 137840], [61, 138420], [63, 139000], [69, 139580], [72, 140180], [83, 140780], [85, 141020]]}, {"verse": 16, "start": 142190, "end": 152781, "text": "¿Qué tienes tú aquí, o a quién tienes tú aquí, que labraste aquí sepulcro para ti, como el que en lugar alto labra su sepultura, o el que esculpe para sí morada en una peña?", "words": [[0, 142190], [5, 142310], [12, 142650], [15, 142890], [21, 143550], [23, 143570], [25, 143670], [31, 143770], [38, 144110], [41, 144350], [47, 144870], [51, 144930], [60, 145450], [65, 145630], [74, 146270], [79, 146490], [83, 146990], [88, 147170], [91, 147310], [95, 147450], [98, 147570], [104, 147770], [109, 148090], [115, 148510], [118, 148630], [129, 149969], [131, 150131], [134, 150271], [138, 150411], [146, 150931], [151, 151131], [154, 151391], [161, 151871], [164, 152031], [168, 152191]]}, {"verse": 17, "start": 153463, "end": 158851, "text": "He aquí que Jehová te transportará en duro cautiverio, y de cierto te cubrirá el rostro.", "words": [[0, 153463], [3, 153631], [8, 153871], [12, 154011], [19, 154471], [22, 154551], [35, 155271], [38, 155451], [43, 155711], [55, 156471], [57, 157051], [60, 157091], [67, 157651], [70, 157671], [78, 158171], [81, 158271]]}, {"verse": 18, "start": 159537, "end": 170175, "text": "Te echará a rodar con ímpetu, como a bola por tierra larga de términos: allá morirás, y allá estarán los carros de tu gloria, oh vergüenza de la casa de tu señor.", "words": [[0, 159537], [3, 159659], [10, 160039], [12, 160099], [18, 160519], [22, 160679], [30, 161539], [35, 161739], [37, 161939], [42, 162139], [46, 162339], [53, 162619], [59, 163039], [62, 163159], [72, 164511], [77, 164865], [86, 165255], [88, 165835], [93, 165995], [101, 166455], [105, 166575], [112, 166995], [115, 167115], [118, 167235], [126, 167705], [129, 168175], [139, 168755], [142, 168915], [145, 169015], [150, 169275], [153, 169455], [156, 169575]]}, {"verse": 19, "start": 170855, "end": 174236, "text": "Y te arrojaré de tu lugar, y de tu puesto te empujaré.", "words": [[0, 170855], [2, 170966], [5, 171066], [14, 171586], [17, 171666], [20, 171806], [27, 172146], [29, 172626], [32, 172746], [35, 172906], [42, 173266], [45, 173506]]}, {"verse": 20, "start": 174925, "end": 179748, "text": "Y será que, en aquel día, llamaré a mi siervo Eliaquim, hijo de Hilcías;", "words": [[0, 174925], [2, 175048], [7, 175248], [12, 175488], [15, 175588], [21, 175888], [26, 176168], [34, 176988], [36, 177068], [39, 177208], [46, 177948], [56, 178688], [61, 178848], [64, 179298]]}, {"verse": 21, "start": 180433, "end": 192379, "text": "Y lo vestiré de tus vestiduras, y le fortaleceré con tu cinturón, y entregaré en sus manos tu potestad; y será padre al habitante de Jerusalén, y a la casa de Judá.", "words": [[0, 180433], [2, 180538], [5, 180618], [13, 181118], [16, 181238], [20, 181358], [32, 182038], [34, 182638], [37, 182778], [49, 183658], [53, 183778], [56, 183938], [66, 184838], [68, 185098], [78, 185678], [81, 185758], [85, 185898], [91, 186258], [94, 186748], [104, 187790], [106, 187909], [111, 188129], [117, 188669], [120, 188849], [130, 189329], [133, 189449], [144, 190429], [146, 190629], [148, 190669], [151, 190749], [156, 191049], [159, 191229]]}, {"verse": 22, "start": 193112, "end": 201696, "text": "Y pondré la llave de la casa de David sobre su hombro; y abrirá, y nadie cerrará; cerrará, y nadie abrirá.", "words": [[0, 193112], [2, 193217], [9, 193617], [12, 193737], [18, 194057], [21, 194177], [24, 194277], [29, 194577], [32, 194757], [38, 195117], [44, 195637], [47, 195877], [55, 196938], [57, 197061], [65, 197601], [67, 198061], [73, 198581], [82, 199866], [91, 200146], [93, 200766], [99, 201026]]}, {"verse": 23, "start": 202369, "end": 208557, "text": "Y lo clavaré como clavo en lugar firme; y será por asiento de honra a la casa de su padre.", "words": [[0, 202369], [2, 202465], [5, 202565], [13, 203005], [18, 203225], [24, 203725], [27, 203885], [33, 204085], [40, 205330], [42, 205457], [47, 205677], [51, 205917], [59, 206417], [62, 206617], [68, 207097], [70, 207297], [73, 207377], [78, 207637], [81, 207857], [84, 207997]]}, {"verse": 24, "start": 209259, "end": 220193, "text": "Y colgarán de él toda la honra de la casa de su padre, los hijos y los nietos, todos los vasos menores, desde los vasos de beber hasta todos los instrumentos de música.", "words": [[0, 209259], [2, 209341], [11, 209901], [14, 210021], [17, 210181], [22, 210421], [25, 210681], [31, 211061], [34, 211181], [37, 211301], [42, 211561], [45, 211761], [48, 211881], [55, 212621], [59, 212841], [65, 213221], [67, 213501], [71, 213641], [79, 214561], [85, 214861], [89, 215161], [95, 215621], [104, 216859], [110, 217003], [114, 217183], [120, 217563], [123, 217683], [129, 217963], [135, 218283], [141, 218623], [145, 218823], [158, 219503], [161, 219583]]}, {"verse": 25, "start": 220885, "end": 234422, "text": "En aquel día, dice Jehová de los ejércitos, el clavo clavado en lugar firme será quitado, y será quebrado y caerá; y la carga que sobre él se puso, se echará a perder; porque Jehová habló.", "words": [[0, 220885], [3, 220987], [9, 221327], [14, 221567], [19, 221987], [26, 222427], [29, 222487], [33, 223117], [44, 223747], [47, 223887], [53, 224247], [61, 224747], [64, 224867], [70, 225047], [76, 225547], [81, 225767], [90, 226367], [92, 226667], [97, 226907], [106, 227487], [108, 227687], [115, 228743], [117, 228859], [120, 228979], [126, 229319], [130, 229539], [136, 229799], [139, 230039], [142, 230179], [148, 231039], [151, 231299], [158, 231759], [160, 232084], [168, 233002], [175, 233355], [182, 233745]]}]}