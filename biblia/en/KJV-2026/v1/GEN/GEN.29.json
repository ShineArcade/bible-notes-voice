{"book": "GEN", "chapter": 29, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 260058, "verses": [{"verse": 1, "start": 300, "end": 4709, "text": "Then Jacob went on his journey, and came into the land of the people of the east.", "words": [[0, 300], [5, 593], [11, 993], [16, 1313], [19, 1513], [23, 1673], [32, 2073], [36, 2328], [41, 2588], [46, 2788], [50, 2968], [55, 3228], [58, 3408], [62, 3528], [69, 3828], [72, 4028], [76, 4168]]}, {"verse": 2, "start": 5059, "end": 15654, "text": "And he looked, and behold a well in the field, and, lo, there were three flocks of sheep lying by it; for out of that well they watered the flocks: and a great stone was upon the well’s mouth.", "words": [[0, 5059], [4, 5183], [7, 5303], [15, 5703], [19, 5763], [26, 6283], [28, 6343], [33, 6523], [36, 6703], [40, 6803], [47, 7323], [52, 7463], [56, 8143], [62, 8263], [67, 8423], [73, 8703], [80, 9143], [83, 9263], [89, 9483], [95, 9843], [98, 10163], [102, 10618], [106, 10741], [110, 10901], [113, 11001], [118, 11181], [123, 11561], [128, 11661], [136, 12121], [140, 12221], [148, 13057], [152, 13184], [154, 13324], [160, 13544], [166, 14064], [170, 14364], [175, 14644], [179, 14864], [186, 15224]]}, {"verse": 3, "start": 16004, "end": 24987, "text": "And there were all the flocks gathered: and they rolled the stone from the well’s mouth, and watered the sheep, and put the stone again upon the well’s mouth in his place.", "words": [[0, 16004], [4, 16151], [10, 16291], [15, 16431], [19, 16671], [23, 16831], [30, 17251], [40, 18112], [44, 18266], [49, 18366], [56, 18646], [60, 18886], [66, 19246], [71, 19526], [75, 19726], [82, 20066], [89, 20386], [93, 20710], [101, 21150], [105, 21271], [112, 21590], [116, 21796], [120, 21976], [124, 22156], [130, 22436], [136, 22756], [141, 23076], [145, 23336], [152, 23656], [158, 23956], [161, 24196], [165, 24356]]}, {"verse": 4, "start": 25337, "end": 31198, "text": "And Jacob said to them, My brethren, from where be you? And they said, Of Haran are we.", "words": [[0, 25337], [4, 25501], [10, 25821], [15, 26121], [18, 26321], [24, 26897], [27, 26996], [37, 27616], [42, 27676], [48, 27976], [51, 28276], [56, 28952], [60, 29101], [65, 29221], [71, 29910], [74, 30070], [80, 30590], [84, 30870]]}, {"verse": 5, "start": 31478, "end": 36574, "text": "And he said to them, Do you know Laban the son of Nahor? And they said, We know him.", "words": [[0, 31478], [4, 31608], [7, 31728], [12, 31968], [15, 32168], [21, 32714], [24, 32892], [28, 33052], [33, 33132], [39, 33552], [43, 33632], [47, 33852], [50, 33972], [57, 34773], [61, 34922], [66, 35042], [72, 35731], [75, 35894], [80, 36154]]}, {"verse": 6, "start": 36854, "end": 44140, "text": "And he said to them, Is he well? And they said, He is well: and, behold, Rachel his daughter comes with the sheep.", "words": [[0, 36854], [4, 36984], [7, 37104], [12, 37344], [15, 37544], [21, 38090], [24, 38272], [27, 38392], [33, 39187], [37, 39336], [42, 39456], [48, 40145], [51, 40316], [54, 40716], [60, 41581], [65, 41820], [73, 42400], [80, 42620], [84, 42820], [93, 43060], [99, 43380], [104, 43600], [108, 43700]]}, {"verse": 7, "start": 44420, "end": 52743, "text": "And he said, Lo, it is yet high day, neither is it time that the cattle should be gathered together: water the sheep, and go and feed them.", "words": [[0, 44420], [4, 44555], [7, 44695], [13, 46104], [17, 46267], [20, 46387], [23, 46547], [27, 46707], [32, 46947], [37, 47687], [45, 47927], [48, 48207], [51, 48347], [56, 48627], [61, 48847], [65, 48987], [72, 49207], [79, 49407], [82, 49527], [91, 49747], [101, 50529], [107, 50788], [111, 50968], [118, 51168], [122, 51368], [125, 51508], [129, 51628], [134, 51848]]}, {"verse": 8, "start": 53023, "end": 60539, "text": "And they said, We cannot, until all the flocks be gathered together, and till they roll the stone from the well’s mouth; then we water the sheep.", "words": [[0, 53023], [4, 53172], [9, 53292], [15, 53981], [18, 54118], [26, 54398], [32, 54798], [36, 55098], [40, 55238], [47, 55638], [50, 55778], [59, 56058], [69, 56391], [73, 56725], [78, 57058], [83, 57298], [88, 57478], [92, 57638], [98, 57918], [103, 58098], [107, 58238], [114, 58518], [121, 59076], [126, 59337], [129, 59657], [135, 59937], [139, 60117]]}, {"verse": 9, "start": 60819, "end": 65483, "text": "¶ And while he yet spoke with them, Rachel came with her father’s sheep: for she kept them.", "words": [[2, 60819], [6, 60950], [12, 61190], [15, 61370], [19, 61530], [25, 61850], [30, 62110], [36, 62550], [43, 62790], [48, 63130], [53, 63310], [57, 63410], [66, 63890], [73, 64554], [77, 64663], [81, 64843], [86, 65123]]}, {"verse": 10, "start": 65833, "end": 81117, "text": "And it came to pass, when Jacob saw Rachel the daughter of Laban his mother’s brother, and the sheep of Laban his mother’s brother, that Jacob went near, and rolled the stone from the well’s mouth, and watered the flock of Laban his mother’s brother.", "words": [[0, 65833], [4, 65967], [7, 66067], [12, 66307], [15, 66527], [21, 66907], [26, 67527], [32, 67887], [36, 68207], [43, 68767], [47, 68847], [56, 69127], [59, 69407], [65, 70167], [69, 70267], [78, 70747], [87, 71487], [91, 71747], [95, 71887], [101, 72127], [104, 72347], [110, 72967], [114, 73067], [123, 73547], [132, 74367], [137, 74467], [143, 74807], [148, 75087], [154, 75916], [158, 76075], [165, 76355], [169, 76575], [175, 76915], [180, 77135], [184, 77295], [191, 77655], [198, 77955], [202, 78475], [210, 78955], [214, 79035], [220, 79275], [223, 79535], [229, 80075], [233, 80155], [242, 80595]]}, {"verse": 11, "start": 81467, "end": 85274, "text": "And Jacob kissed Rachel, and lifted up his voice, and wept.", "words": [[0, 81467], [4, 81611], [10, 81971], [17, 82371], [25, 82831], [29, 83311], [36, 83611], [39, 83851], [43, 83991], [50, 84411], [54, 84771]]}, {"verse": 12, "start": 85624, "end": 92103, "text": "And Jacob told Rachel that he was her father’s brother, and that he was Rebekah’s son: and she ran and told her father.", "words": [[0, 85624], [4, 85766], [10, 86026], [15, 86326], [22, 86746], [27, 86986], [30, 87126], [34, 87266], [38, 87406], [47, 87866], [56, 88146], [60, 88746], [65, 88906], [68, 89026], [72, 89406], [82, 89786], [87, 90422], [91, 90550], [95, 90690], [99, 90990], [103, 91190], [108, 91350], [112, 91550]]}, {"verse": 13, "start": 92453, "end": 104550, "text": "And it came to pass, when Laban heard the tidings of Jacob his sister’s son, that he ran to meet him, and embraced him, and kissed him, and brought him to his house. And he told Laban all these things.", "words": [[0, 92453], [4, 92606], [7, 92686], [12, 92926], [15, 93146], [21, 93606], [26, 93871], [32, 94391], [38, 94611], [42, 94771], [50, 95231], [53, 95371], [59, 95651], [63, 95911], [72, 96411], [77, 96931], [82, 97191], [85, 97311], [89, 97591], [92, 97791], [97, 97991], [102, 98231], [106, 98651], [115, 98991], [120, 99351], [124, 99731], [131, 100011], [136, 100609], [140, 100748], [148, 100928], [152, 101128], [155, 101288], [159, 101448], [166, 102237], [170, 102361], [173, 102501], [178, 102761], [184, 103301], [188, 103641], [194, 103901]]}, {"verse": 14, "start": 104900, "end": 111125, "text": "And Laban said to him, Surely you are my bone and my flesh. And he stayed with him the space of a month.", "words": [[0, 104900], [4, 105048], [10, 105448], [15, 105708], [18, 105928], [23, 106474], [30, 106830], [34, 107110], [38, 107210], [41, 107330], [46, 107770], [50, 108010], [53, 108150], [60, 109028], [64, 109154], [67, 109274], [74, 109514], [79, 109814], [83, 109974], [87, 110114], [93, 110414], [96, 110634], [98, 110734]]}, {"verse": 15, "start": 111475, "end": 118479, "text": "¶ And Laban said to Jacob, Because you are my brother, should you therefore serve me for nothing? tell me, what shall your wages be?", "words": [[2, 111475], [6, 111597], [12, 112037], [17, 112277], [20, 112477], [27, 113228], [35, 113502], [39, 113722], [43, 113822], [46, 113962], [55, 114562], [62, 114922], [66, 115062], [76, 115322], [82, 115702], [85, 115862], [89, 116042], [98, 116820], [103, 116977], [107, 117157], [112, 117337], [118, 117497], [123, 117677], [129, 117957]]}, {"verse": 16, "start": 118759, "end": 124667, "text": "And Laban had two daughters: the name of the elder was Leah, and the name of the younger was Rachel.", "words": [[0, 118759], [4, 118906], [10, 119346], [14, 119586], [18, 119846], [29, 120774], [33, 120861], [38, 121061], [41, 121241], [45, 121361], [51, 121641], [55, 121981], [61, 122881], [65, 122941], [69, 123061], [74, 123201], [77, 123381], [81, 123521], [89, 123761], [93, 124081]]}, {"verse": 17, "start": 125017, "end": 129153, "text": "Leah was tender eyed; but Rachel was beautiful and well favoured.", "words": [[0, 125017], [5, 125295], [9, 125595], [16, 125915], [22, 126760], [26, 127000], [33, 127320], [37, 127560], [47, 128020], [51, 128280], [56, 128717]]}, {"verse": 18, "start": 129503, "end": 135168, "text": "And Jacob loved Rachel; and said, I will serve you seven years for Rachel your younger daughter.", "words": [[0, 129503], [4, 129638], [10, 129958], [16, 130378], [24, 131348], [28, 131691], [34, 132203], [36, 132373], [41, 132533], [47, 132813], [51, 132973], [57, 133273], [63, 133613], [67, 133913], [74, 134333], [79, 134433], [87, 134673]]}, {"verse": 19, "start": 135448, "end": 141762, "text": "And Laban said, It is better that I give her to you, than that I should give her to another man: abide with me.", "words": [[0, 135448], [4, 135820], [10, 136220], [16, 136822], [19, 136941], [22, 137081], [29, 137321], [34, 137541], [36, 137661], [41, 137861], [45, 137981], [48, 138161], [53, 138421], [58, 138921], [63, 139081], [65, 139181], [72, 139381], [77, 139601], [81, 139761], [84, 139901], [92, 140181], [97, 140930], [103, 141297], [108, 141477]]}, {"verse": 20, "start": 142042, "end": 148268, "text": "And Jacob served seven years for Rachel; and they seemed to him but a few days, for the love he had to her.", "words": [[0, 142042], [4, 142167], [10, 142467], [17, 142807], [23, 143287], [29, 143647], [33, 143927], [41, 144742], [45, 144884], [50, 145024], [57, 145324], [60, 145524], [64, 145664], [68, 145864], [70, 145984], [74, 146164], [80, 146484], [84, 146964], [88, 147104], [93, 147344], [96, 147544], [100, 147764], [103, 147964]]}, {"verse": 21, "start": 148618, "end": 153821, "text": "¶ And Jacob said to Laban, Give me my wife, for my days are fulfilled, that I may go in to her.", "words": [[2, 148618], [6, 148743], [12, 149083], [17, 149363], [20, 149583], [27, 150301], [32, 150425], [35, 150565], [38, 150745], [44, 151185], [48, 151285], [51, 151465], [56, 151745], [60, 151925], [71, 152705], [76, 152785], [78, 152925], [82, 153025], [85, 153185], [88, 153345], [91, 153505]]}, {"verse": 22, "start": 154101, "end": 158349, "text": "And Laban gathered together all the men of the place, and made a feast.", "words": [[0, 154101], [4, 154248], [10, 154688], [19, 155008], [28, 155428], [32, 155848], [36, 156028], [40, 156248], [43, 156368], [47, 156488], [54, 157228], [58, 157428], [63, 157628], [65, 157768]]}, {"verse": 23, "start": 158699, "end": 164784, "text": "And it came to pass in the evening, that he took Leah his daughter, and brought her to him; and he went in to her.", "words": [[0, 158699], [4, 158804], [7, 158904], [12, 159124], [15, 159304], [20, 159564], [23, 159764], [27, 159884], [36, 160244], [41, 160724], [44, 160844], [49, 161064], [54, 161284], [58, 161484], [68, 161804], [72, 162384], [80, 162684], [84, 162864], [87, 163064], [92, 163680], [96, 163804], [99, 163924], [104, 164124], [107, 164324], [110, 164524]]}, {"verse": 24, "start": 165134, "end": 169311, "text": "And Laban gave to his daughter Leah Zilpah his maid for a handmaid.", "words": [[0, 165134], [4, 165299], [10, 165739], [15, 166019], [18, 166259], [22, 166459], [31, 166872], [36, 167286], [43, 167699], [47, 167959], [52, 168219], [56, 168459], [58, 168619]]}, {"verse": 25, "start": 169661, "end": 181166, "text": "And it came to pass, that in the morning, behold, it was Leah: and he said to Laban, What is this you have done to me? did not I serve with you for Rachel? why then have you beguiled me?", "words": [[0, 169661], [4, 169985], [7, 170105], [12, 170325], [15, 170525], [21, 170885], [26, 171185], [29, 171345], [33, 171445], [42, 172105], [50, 173065], [53, 173185], [57, 173365], [63, 174180], [67, 174313], [70, 174413], [75, 174653], [78, 175154], [85, 175778], [90, 175918], [93, 176078], [98, 176298], [102, 176438], [107, 176538], [112, 176718], [115, 176878], [119, 177395], [123, 177536], [127, 177776], [129, 178016], [135, 178316], [140, 178556], [144, 178696], [148, 178876], [156, 179611], [160, 179794], [165, 179994], [170, 180194], [174, 180294], [183, 180794]]}, {"verse": 26, "start": 181446, "end": 186634, "text": "And Laban said, It must not be so done in our country, to give the younger before the firstborn.", "words": [[0, 181446], [4, 181818], [10, 182218], [16, 182821], [19, 182938], [24, 183098], [28, 183338], [31, 183518], [34, 183698], [39, 183898], [42, 184018], [46, 184178], [55, 184558], [58, 184898], [63, 185078], [67, 185218], [75, 185498], [82, 185838], [86, 186038]]}, {"verse": 27, "start": 186984, "end": 192355, "text": "Fulfil her week, and we will give you this also for the service which you shall serve with me yet seven other years.", "words": [[0, 187140], [7, 187310], [11, 187550], [17, 188230], [21, 188350], [24, 188510], [29, 188650], [34, 188890], [38, 189030], [43, 189190], [48, 189410], [52, 189590], [56, 189770], [64, 190030], [70, 190270], [74, 190390], [80, 190570], [86, 190770], [91, 190970], [94, 191110], [98, 191330], [104, 191630], [110, 191850]]}, {"verse": 28, "start": 192635, "end": 198006, "text": "And Jacob did so, and fulfilled her week: and he gave him Rachel his daughter to wife also.", "words": [[0, 192635], [4, 192751], [10, 193051], [14, 193331], [18, 193651], [22, 194011], [32, 194391], [36, 194671], [42, 195378], [46, 195507], [49, 195607], [54, 195787], [58, 195927], [65, 196287], [69, 196547], [78, 196887], [81, 197087], [86, 197347]]}, {"verse": 29, "start": 198356, "end": 202743, "text": "And Laban gave to Rachel his daughter Bilhah his handmaid to be her maid.", "words": [[0, 198356], [4, 198726], [10, 199096], [15, 199396], [18, 199596], [25, 199896], [29, 200156], [38, 200456], [45, 201056], [49, 201276], [58, 201856], [61, 201996], [64, 202096], [68, 202236]]}, {"verse": 30, "start": 203093, "end": 210676, "text": "And he went in also to Rachel, and he loved also Rachel more than Leah, and served with him yet seven other years.", "words": [[0, 203093], [4, 203240], [7, 203340], [12, 203560], [15, 203760], [20, 204120], [23, 204380], [31, 205360], [35, 205460], [38, 205580], [44, 205860], [49, 206260], [56, 206700], [61, 207000], [66, 207220], [72, 208200], [76, 208260], [83, 208580], [88, 208880], [92, 209040], [96, 209280], [102, 209660], [108, 209980]]}, {"verse": 31, "start": 211026, "end": 216132, "text": "¶ And when the LORD saw that Leah was hated, he opened her womb: but Rachel was barren.", "words": [[2, 211026], [6, 211150], [11, 211290], [15, 211430], [20, 211690], [24, 212030], [29, 212230], [34, 212450], [38, 212650], [45, 213290], [48, 213370], [55, 213690], [59, 213930], [65, 214612], [69, 214938], [76, 215318], [80, 215558]]}, {"verse": 32, "start": 216482, "end": 226763, "text": "And Leah conceived, and bore a son, and she called his name Reuben: for she said, Surely the LORD has looked upon my affliction; now therefore my husband will love me.", "words": [[0, 216482], [4, 216625], [9, 216845], [20, 217405], [24, 217685], [29, 217945], [31, 218065], [36, 218785], [40, 218885], [44, 219025], [51, 219305], [55, 219525], [60, 220016], [68, 220683], [72, 220905], [76, 221005], [82, 221660], [89, 221959], [93, 222219], [98, 222479], [102, 222679], [109, 222899], [114, 223179], [117, 223499], [129, 224467], [133, 224799], [143, 225459], [146, 225579], [154, 225859], [159, 226179], [164, 226379]]}, {"verse": 33, "start": 227043, "end": 237792, "text": "And she conceived again, and bore a son; and said, Because the LORD has heard that I was hated, he has therefore given me this son also: and she called his name Simeon.", "words": [[0, 227043], [4, 227162], [8, 227302], [18, 227762], [25, 228402], [29, 228502], [34, 228742], [36, 228882], [41, 229600], [45, 229757], [51, 230377], [59, 230566], [63, 230766], [68, 231026], [72, 231286], [78, 231546], [83, 231746], [85, 231986], [89, 232166], [96, 233006], [99, 233166], [103, 233346], [113, 233726], [119, 234086], [122, 234306], [127, 234606], [131, 234906], [137, 235858], [141, 235965], [145, 236125], [152, 236445], [156, 236665], [161, 236965]]}, {"verse": 34, "start": 238142, "end": 250080, "text": "And she conceived again, and bore a son; and said, Now this time will my husband be joined to me, because I have born him three sons: therefore was his name called Levi.", "words": [[0, 238142], [4, 238270], [8, 238410], [18, 238890], [25, 239290], [29, 239670], [34, 239930], [36, 240050], [41, 240822], [45, 240969], [51, 241644], [55, 241864], [60, 242204], [65, 242564], [70, 242784], [73, 242964], [81, 243344], [84, 243664], [91, 244024], [94, 244344], [98, 244744], [106, 245184], [108, 245424], [113, 245684], [118, 245944], [122, 246064], [128, 246424], [134, 247504], [144, 248154], [148, 248374], [152, 248534], [157, 248814], [164, 249214]]}, {"verse": 35, "start": 250430, "end": 259658, "text": "And she conceived again, and bore a son: and she said, Now will I praise the LORD: therefore she called his name Judah; and left bearing.", "words": [[0, 250430], [4, 250551], [8, 250731], [18, 251231], [25, 251631], [29, 252051], [34, 252311], [36, 252471], [41, 253203], [45, 253328], [49, 253488], [55, 254199], [59, 254457], [64, 254697], [66, 254837], [73, 255297], [77, 255637], [83, 256435], [93, 256876], [97, 257016], [104, 257256], [108, 257496], [113, 257756], [120, 258699], [124, 258836], [129, 259036]]}]}