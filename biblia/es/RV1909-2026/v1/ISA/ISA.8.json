{"book": "ISA", "chapter": 8, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 202541, "verses": [{"verse": 1, "start": 300, "end": 7655, "text": "Y Me dijo Jehová: Tómate un gran volumen, y escribe en él en estilo de hombre tocante a Maher-salal-hasbaz.", "words": [[0, 300], [2, 426], [5, 546], [10, 846], [18, 1814], [25, 2135], [28, 2295], [33, 2475], [42, 3035], [44, 3435], [52, 3855], [55, 4075], [58, 4215], [61, 4435], [68, 4795], [71, 5035], [78, 5295], [86, 5915], [88, 6785]]}, {"verse": 2, "start": 8246, "end": 15004, "text": "Y junté conmigo por testigos fieles a Urías sacerdote, y a Zacarías hijo de Jeberechîas.", "words": [[0, 8246], [2, 8387], [8, 8787], [16, 9287], [20, 9507], [29, 10047], [36, 10440], [38, 10834], [44, 11227], [55, 11887], [57, 12347], [59, 12807], [68, 13267], [73, 13547], [76, 14304]]}, {"verse": 3, "start": 15454, "end": 24638, "text": "Y me uní con la profetisa, la cual concibió, y parió un hijo. Y me dijo Jehová: Ponle por nombre Maher-salal-hasbaz.", "words": [[0, 15454], [2, 15580], [5, 15700], [9, 16040], [13, 16140], [16, 16580], [27, 17020], [30, 17140], [35, 17300], [45, 18140], [47, 18680], [53, 19140], [56, 19500], [62, 20268], [64, 20550], [67, 20670], [72, 20930], [80, 21934], [86, 22278], [90, 22478], [97, 23558]]}, {"verse": 4, "start": 25354, "end": 34931, "text": "Porque antes que el niño sepa decir, Padre mío, y Madre mía, será quitada la fuerza de Damasco y los despojos de Samaria, en la presencia del rey de Asiria.", "words": [[0, 25354], [7, 25541], [13, 25861], [17, 26081], [20, 26181], [25, 26401], [30, 26801], [37, 27441], [43, 27741], [48, 28141], [50, 28361], [56, 28681], [61, 29341], [66, 29501], [74, 29961], [77, 30081], [84, 30421], [87, 30621], [95, 31201], [97, 31541], [101, 31681], [110, 32221], [113, 32341], [122, 33201], [125, 33301], [128, 33401], [138, 33941], [142, 34141], [146, 34341], [149, 34636]]}, {"verse": 5, "start": 35552, "end": 39022, "text": "Otra vez volvió Jehová a hablarme, diciendo:", "words": [[0, 35552], [5, 35770], [9, 36110], [16, 36610], [23, 37090], [25, 37270], [35, 37930]]}, {"verse": 6, "start": 39272, "end": 48101, "text": "Por cuanto desechó este pueblo las aguas de Siloé, que corren mansamente, y se alegró con Rezín y con el hijo de Remalías;", "words": [[0, 39272], [4, 39411], [11, 39751], [19, 40411], [24, 40651], [31, 41151], [35, 41791], [41, 42331], [44, 42451], [51, 43331], [55, 43531], [62, 44011], [74, 44771], [76, 45111], [79, 45271], [86, 45711], [90, 46081], [96, 46451], [98, 46651], [102, 46811], [105, 46951], [110, 47211], [113, 47351]]}, {"verse": 7, "start": 48834, "end": 63289, "text": "He aquí por tanto que el Señor hace subir sobre ellos aguas de ríos, impetuosas y muchas, a saber, al rey de Asiria con todo su poder; el cual subirá sobre todos sus ríos, y pasará sobre todas sus riberas:", "words": [[0, 48834], [3, 48971], [8, 49231], [12, 49451], [18, 49791], [22, 50031], [25, 50191], [31, 50471], [36, 50911], [42, 51231], [48, 51591], [54, 51891], [60, 52491], [63, 52611], [69, 53431], [80, 54291], [82, 54491], [90, 54791], [92, 55151], [99, 55531], [102, 56051], [106, 56371], [109, 56431], [116, 56931], [120, 57191], [125, 57431], [128, 57631], [135, 58646], [138, 58789], [143, 59029], [150, 59629], [156, 59889], [162, 60149], [166, 60429], [172, 60909], [174, 61309], [181, 61789], [187, 62029], [193, 62309], [197, 62589]]}, {"verse": 8, "start": 63974, "end": 74363, "text": "Y pasando hasta Judá, inundará, y desbordará, y llegará hasta la garganta; y extendiendo sus alas, llenará la anchura de tu tierra, oh Emanuel.", "words": [[0, 63974], [2, 64074], [10, 64454], [16, 64714], [22, 65514], [32, 65994], [34, 66454], [46, 67094], [48, 67514], [56, 67874], [62, 68094], [65, 68234], [75, 69413], [77, 69533], [89, 70273], [93, 70743], [99, 71213], [107, 71893], [110, 72033], [118, 72473], [121, 72593], [124, 72733], [132, 73183], [135, 73633]]}, {"verse": 9, "start": 74956, "end": 87406, "text": "Juntaos, pueblos, y seréis quebrantados; oíd todos los que sois de lejanas tierras: poneos a punto, y seréis quebrantados; preparaos, y seréis quebrantados.", "words": [[0, 75201], [9, 75481], [18, 76301], [20, 76801], [27, 77201], [41, 78672], [45, 78792], [51, 79192], [55, 79452], [59, 79652], [64, 80032], [67, 80192], [75, 80848], [84, 81744], [91, 82174], [93, 82274], [100, 82714], [102, 83174], [109, 83574], [123, 84950], [134, 85647], [136, 85827], [143, 86267]]}, {"verse": 10, "start": 87856, "end": 94825, "text": "Tomad consejo, y será deshecho; proferid palabra, y no será firme: porque Dios con nosotros.", "words": [[0, 87856], [6, 88178], [15, 88818], [17, 88938], [22, 89454], [32, 90408], [41, 90648], [50, 91068], [52, 91648], [55, 91788], [60, 92008], [67, 92946], [74, 93190], [79, 93570], [83, 93950]]}, {"verse": 11, "start": 95275, "end": 103772, "text": "Porque Jehová me dijo de esta manera con mano fuerte, y me enseñó que no caminase por el camino de este pueblo, diciendo:", "words": [[0, 95275], [7, 95541], [14, 96101], [17, 96241], [22, 96541], [25, 96741], [30, 96961], [37, 97321], [41, 97581], [46, 97861], [54, 98341], [56, 99021], [59, 99181], [66, 99801], [70, 99961], [73, 100141], [82, 100861], [86, 101161], [89, 101281], [96, 101601], [99, 101901], [104, 102081], [112, 102921]]}, {"verse": 12, "start": 104022, "end": 111680, "text": "No llaméis conspiración a todo lo que este pueblo llama conspiración; ni temáis lo que temen, ni tengáis miedo.", "words": [[0, 104022], [3, 104243], [11, 104663], [24, 105563], [26, 105883], [31, 106143], [34, 106363], [38, 106503], [43, 106703], [50, 107043], [56, 107403], [70, 108958], [73, 109100], [80, 109580], [83, 109780], [87, 109880], [94, 110540], [97, 110700], [105, 111120]]}, {"verse": 13, "start": 112355, "end": 119023, "text": "A Jehová de los ejércitos, a él santificad: sea él vuestro temor, y él sea vuestro miedo.", "words": [[0, 112355], [2, 112497], [9, 112937], [12, 113017], [