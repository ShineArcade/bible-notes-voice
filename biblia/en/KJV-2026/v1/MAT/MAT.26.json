{"book": "MAT", "chapter": 26, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 541019, "verses": [{"verse": 1, "start": 300, "end": 6047, "text": "And it came to pass, when Jesus had finished all these sayings, he said to his disciples,", "words": [[0, 300], [4, 460], [7, 580], [12, 780], [15, 1000], [21, 1800], [26, 2000], [32, 2300], [36, 2580], [45, 2860], [49, 3300], [55, 3520], [64, 4420], [67, 4560], [72, 4840], [75, 5020], [79, 5220]]}, {"verse": 2, "start": 6297, "end": 11791, "text": "You know that after two days is the feast of the passover, and the Son of man is betrayed to be crucified.", "words": [[0, 6297], [4, 6439], [9, 6659], [14, 6859], [20, 7119], [24, 7359], [29, 7659], [32, 7879], [36, 8019], [42, 8259], [45, 8439], [49, 8519], [59, 8959], [63, 9479], [67, 9579], [71, 9779], [74, 9899], [78, 10179], [81, 10339], [90, 10679], [93, 10899], [96, 11019]]}, {"verse": 3, "start": 12141, "end": 20879, "text": "Then assembled together the chief priests, and the scribes, and the elders of the people, to the palace of the high priest, who was called Caiaphas,", "words": [[0, 12141], [5, 12300], [15, 12660], [24, 13080], [28, 13300], [34, 13540], [43, 14020], [47, 14660], [51, 14800], [60, 15540], [64, 15880], [68, 16020], [75, 16319], [78, 16600], [82, 16700], [90, 17020], [93, 17440], [97, 17600], [104, 17960], [107, 18180], [111, 18300], [116, 18520], [124, 18860], [128, 19080], [132, 19240], [139, 20060]]}, {"verse": 4, "start": 21329, "end": 25551, "text": "And consulted that they might take Jesus by craftiness, and kill him.", "words": [[0, 21329], [4, 21459], [14, 21939], [19, 22339], [24, 22519], [30, 22739], [35, 23039], [41, 23439], [44, 23799], [56, 24459], [60, 24759], [65, 25099]]}, {"verse": 5, "start": 26001, "end": 30413, "text": "But they said, Not on the feast day, lest there be an uproar among the people.", "words": [[0, 26001], [4, 26118], [9, 26318], [15, 27063], [19, 27201], [22, 27361], [26, 27461], [32, 27641], [37, 28441], [42, 28621], [48, 28781], [51, 28981], [54, 29101], [61, 29641], [67, 29781], [71, 29981]]}, {"verse": 6, "start": 30763, "end": 35350, "text": "¶ Now when Jesus was in Bethany, in the house of Simon the leper,", "words": [[2, 30763], [6, 30963], [11, 31183], [17, 31463], [21, 31803], [24, 31983], [33, 32443], [36, 33023], [40, 33143], [46, 33343], [49, 33543], [55, 33883], [59, 34083]]}, {"verse": 7, "start": 35800, "end": 43352, "text": "There came to him a woman having an alabaster box of very precious ointment, and poured it on his head, as he sat at the table.", "words": [[0, 35800], [6, 35908], [11, 36168], [14, 36388], [18, 36548], [20, 36668], [26, 36928], [33, 37248], [36, 37448], [46, 38188], [50, 38468], [53, 38768], [58, 39048], [67, 39488], [77, 40168], [81, 40648], [88, 40948], [91, 41148], [94, 41308], [98, 41488], [104, 41808], [107, 42208], [110, 42348], [114, 42588], [117, 42748], [121, 42848]]}, {"verse": 8, "start": 43802, "end": 50244, "text": "But when his disciples saw it, they had indignation, saying, To what purpose is this waste?", "words": [[0, 43802], [4, 43911], [9, 44151], [13, 44311], [23, 44871], [27, 45271], [31, 45671], [36, 45751], [40, 45971], [53, 46951], [61, 48636], [64, 48733], [69, 48873], [77, 49253], [80, 49493], [85, 49673]]}, {"verse": 9, "start": 50694, "end": 54222, "text": "For this ointment might have been sold for much, and given to the poor.", "words": [[0, 50694], [4, 50779], [9, 50999], [18, 51439], [24, 51659], [29, 51839], [34, 51979], [39, 52279], [43, 52519], [49, 52859], [53, 53279], [59, 53499], [62, 53679], [66, 53799]]}, {"verse": 10, "start": 54572, "end": 61282, "text": "When Jesus understood it, he said to them, Why do you trouble the woman? for she has wrought a good work upon me.", "words": [[0, 54572], [5, 54698], [11, 54958], [22, 55498], [26, 55958], [29, 56038], [34, 56258], [37, 56438], [43, 57610], [47, 57835], [50, 58035], [54, 58135], [62, 58455], [66, 58655], [73, 59387], [77, 59494], [81, 59694], [85, 59854], [93, 60114], [95, 60194], [100, 60354], [105, 60614], [110, 60874]]}, {"verse": 11, "start": 61732, "end": 65551, "text": "For you have the poor always with you; but me you have not always.", "words": [[0, 61732], [4, 61844], [8, 62024], [13, 62184], [17, 62324], [22, 62644], [29, 63084], [34, 63404], [39, 64055], [43, 64159], [46, 64539], [50, 64619], [55, 64759], [59, 64899]]}, {"verse": 12, "start": 66001, "end": 70523, "text": "For in that she has poured this ointment on my body, she did it for my burial.", "words": [[0, 66001], [4, 66129], [7, 66309], [12, 66489], [16, 66729], [20, 66909], [27, 67229], [32, 67489], [41, 67969], [44, 68149], [47, 68349], [53, 69049], [57, 69249], [61, 69429], [64, 69549], [68, 69729], [71, 69909]]}, {"verse": 13, "start": 70973, "end": 79908, "text": "Assuredly I say to you, Wherever this gospel shall be preached in the whole world, there shall also this, that this woman has done, be told for a memorial of her.", "words": [[0, 70973], [10, 71575], [12, 71715], [16, 71955], [19, 72135], [24, 72415], [33, 72675], [38, 73015], [45, 73415], [51, 73655], [54, 73815], [63, 74115], [66, 74315], [70, 74415], [76, 74575], [83, 75395], [89, 75495], [95, 75675], [100, 76015], [106, 76375], [111, 76695], [116, 76915], [122, 77175], [126, 77415], [132, 78195], [135, 78322], [140, 78602], [144, 78882], [146, 78962], [155, 79302], [158, 79622]]}, {"verse": 14, "start": 80258, "end": 84574, "text": "¶ Then one of the twelve, called Judas Iscariot, went to the chief priests,", "words": [[2, 80258], [7, 80459], [11, 80639], [14, 80759], [18, 81019], [26, 81279], [33, 81979], [39, 82559], [49, 83479], [54, 83959], [57, 84159], [61, 84259], [67, 84417]]}, {"verse": 15, "start": 85024, "end": 92573, "text": "And said to them, What will you give me, and I will deliver him to you? And they covenanted with him for thirty pieces of silver.", "words": [[0, 85381], [4, 85781], [9, 86041], [12, 86221], [18, 86812], [23, 86951], [28, 87091], [32, 87191], [37, 87391], [41, 87811], [45, 87891], [47, 88031], [52, 88171], [60, 88471], [64, 88671], [67, 88851], [72, 89475], [76, 89629], [81, 89749], [92, 90309], [97, 90609], [101, 90789], [105, 91079], [112, 91369], [119, 91729], [122, 91969]]}, {"verse": 16, "start": 93023, "end": 96109, "text": "And from that time he sought opportunity to betray him.", "words": [[0, 93023], [4, 93142], [9, 93302], [14, 93562], [19, 93942], [22, 94122], [29, 94382], [41, 94982], [44, 95322], [51, 95622]]}, {"verse": 17, "start": 96559, "end": 105536, "text": "¶ Now the first day of the feast of unleavened bread the disciples came to Jesus, saying to him, Where will you that we prepare for you to eat the passover?", "words": [[2, 96559], [6, 96740], [10, 96940], [16, 97200], [20, 97460], [23, 97580], [27, 97720], [33, 98000], [36, 98240], [47, 98880], [53, 99680], [57, 99760], [67, 100220], [72, 100600], [75, 100820], [82, 101600], [89, 101860], [92, 102080], [97, 102710], [103, 102882], [108, 103082], [112, 103262], [117, 103442], [120, 103602], [128, 103922], [132, 104142], [136, 104402], [139, 104582], [143, 104762], [147, 104862]]}, {"verse": 18, "start": 105886, "end": 116985, "text": "And he said, Go into the city to such a man, and say to him, The Master says, My time is at hand; I will keep the passover at your house with my disciples.", "words": [[0, 105886], [4, 106021], [7, 106161], [13, 107619], [16, 107879], [21, 108099], [25, 108279], [30, 108559], [33, 108799], [38, 109039], [40, 109159], [45, 109439], [49, 109799], [53, 110039], [56, 110219], [61, 110879], [65, 110999], [72, 111339], [78, 112239], [81, 112479], [86, 112779], [89, 113019], [92, 113159], [98, 114004], [100, 114145], [105, 114285], [110, 114485], [114, 114645], [123, 115045], [126, 115385], [131, 115505], [137, 115785], [142, 116005], [145, 116185]]}, {"verse": 19, "start": 117335, "end": 122210, "text": "And the disciples did as Jesus had appointed them; and they made ready the passover.", "words": [[0, 117335], [4, 117458], [8, 117578], [18, 118078], [22, 118458], [25, 118658], [31, 118998], [35, 119258], [45, 119598], [51, 120376], [55, 120518], [60, 120678], [65, 120918], [71, 121198], [75, 121378]]}, {"verse": 20, "start": 122660, "end": 126177, "text": "Now when the even was come, he sat down with the twelve.", "words": [[0, 122660], [4, 122905], [9, 123185], [13, 123325], [18, 123625], [22, 123925], [28, 124465], [31, 124545], [35, 124825], [40, 125185], [45, 125385], [49, 125525]]}, {"verse": 21, "start": 126627, "end": 132838, "text": "And as they did eat, he said, Assuredly I say to you, that one of you shall betray me.", "words": [[0, 126627], [4, 126806], [7, 127106], [12, 127346], [16, 127646], [21, 128286], [24, 128426], [30, 129212], [40, 129855], [42, 129995], [46, 130235], [49, 130435], [54, 130695], [59, 131195], [63, 131455], [66, 131575], [70, 131755], [76, 131995], [83, 132335]]}, {"verse": 22, "start": 133188, "end": 140089, "text": "And they were exceeding sorrowful, and began every one of them to say to him, Lord, is it I?", "words": [[0, 133188], [4, 133336], [9, 133436], [14, 133616], [24, 134156], [35, 135156], [39, 135436], [45, 135776], [51, 136056], [55, 136296], [58, 136415], [63, 136616], [66, 136796], [70, 137016], [73, 137216], [78, 138981], [84, 139485], [87, 139605], [90, 139725]]}, {"verse": 23, "start": 140439, "end": 147106, "text": "And he answered and said, He that dips his hand with me in the dish, the same shall betray me.", "words": [[0, 140439], [4, 140565], [7, 140685], [16, 141045], [20, 141265], [26, 142992], [29, 143237], [34, 143497], [39, 143777], [43, 144017], [48, 144297], [53, 144497], [56, 144697], [59, 144817], [63, 144897], [69, 145657], [73, 145877], [78, 146137], [84, 146357], [91, 146657]]}, {"verse": 24, "start": 147556, "end": 156921, "text": "The Son of man goes as it is written of him: but woe to that man by whom the Son of man is betrayed! it had been good for that man if he had not been born.", "words": [[0, 147556], [4, 147622], [8, 147862], [11, 147962], [15, 148242], [20, 148562], [23, 148902], [26, 149022], [29, 149142], [37, 149382], [40, 149582], [45, 150237], [49, 150364], [53, 150784], [56, 150904], [61, 151124], [65, 151424], [68, 151684], [73, 151924], [77, 152144], [81, 152424], [84, 152544], [88, 152784], [91, 152964], [101, 153988], [104, 154110], [108, 154250], [113, 154450], [118, 154690], [122, 154910], [127, 155090], [131, 155370], [134, 155570], [137, 155690], [141, 155870], [145, 156070], [150, 156330]]}, {"verse": 25, "start": 157271, "end": 164750, "text": "Then Judas, which betrayed him, answered and said, Master, is it I? He said to him, You have said.", "words": [[0, 157271], [5, 157562], [12, 158302], [18, 158462], [27, 158862], [32, 159442], [41, 159882], [45, 160242], [51, 161045], [59, 161418], [62, 161798], [65, 161918], [68, 162575], [71, 162658], [76, 162858], [79, 163118], [84, 163699], [88, 163924], [93, 164124]]}, {"verse": 26, "start": 165100, "end": 174145, "text": "¶ And as they were eating, Jesus took bread, and blessed it, and broke it, and gave it to the disciples, and said, Take, eat; this is my body.", "words": [[2, 165100], [6, 165221], [9, 165401], [14, 165581], [19, 165721], [27, 166501], [33, 166761], [38, 167101], [45, 167441], [49, 167841], [57, 168141], [61, 168461], [65, 168761], [71, 169041], [75, 169321], [79, 169861], [84, 170061], [87, 170221], [90, 170321], [94, 170441], [105, 170921], [109, 171361], [115, 172115], [121, 172303], [126, 173184], [131, 173325], [134, 173465], [137, 173645]]}, {"verse": 27, "start": 174495, "end": 179616, "text": "And he took the cup, and gave thanks, and gave it to them, saying, Drink all of it;", "words": [[0, 174495], [4, 174618], [7, 174718], [12, 174918], [16, 175098], [21, 175378], [25, 175818], [30, 176058], [38, 176458], [42, 177018], [47, 177218], [50, 177338], [53, 177498], [59, 177898], [67, 178638], [73, 178823], [77, 179183], [80, 179343]]}, {"verse": 28, "start": 180066, "end": 184967, "text": "For this is my blood of the new testament, which is shed for many for the remission of sins.", "words": [[0, 180066], [4, 180151], [9, 180391], [12, 180551], [15, 180751], [21, 181091], [24, 181271], [28, 181411], [32, 181611], [43, 182391], [49, 182591], [52, 182711], [57, 182991], [61, 183231], [66, 183491], [70, 183731], [74, 183811], [84, 184211], [87, 184371]]}, {"verse": 29, "start": 185417, "end": 193344, "text": "But I say to you, I will not drink from now on of this fruit of the vine, until that day when I drink it new with you in my Father’s kingdom.", "words": [[0, 185417], [4, 185521], [6, 185661], [10, 185901], [13, 186101], [18, 186521], [20, 186841], [25, 186981], [29, 187201], [35, 187441], [40, 187681], [44, 187961], [47, 188341], [50, 188481], [55, 188661], [61, 188921], [64, 189041], [68, 189141], [74, 189931], [80, 190168], [85, 190408], [89, 190688], [94, 190848], [96, 190968], [102, 191208], [105, 191368], [109, 191588], [114, 191868], [118, 192048], [121, 192228], [124, 192388], [133, 192848]]}, {"verse": 30, "start": 193694, "end": 197472, "text": "And when they had sung a hymn, they went out into the mount of Olives.", "words": [[0, 193694], [4, 193820], [9, 193980], [14, 194160], [18, 194280], [23, 194580], [25, 194740], [31, 195460], [36, 195640], [41, 195880], [45, 196020], [50, 196260], [54, 196420], [60, 196680], [63, 197107]]}, {"verse": 31, "start": 197922, "end": 207736, "text": "Then says Jesus to them, All you shall be offended because of me this night: for it is written, I will strike the shepherd, and the sheep of the flock shall be scattered abroad.", "words": [[0, 197922], [5, 198131], [10, 198451], [16, 198871], [19, 199251], [25, 200548], [29, 200732], [33, 200892], [39, 201052], [42, 201192], [51, 201572], [59, 201892], [62, 202092], [65, 202252], [70, 202432], [77, 203152], [81, 203275], [84, 203375], [87, 203475], [96, 204015], [98, 204155], [103, 204295], [110, 204575], [114, 204735], [124, 205395], [128, 205575], [132, 205695], [138, 205895], [141, 206055], [145, 206135], [151, 206395], [157, 206635], [160, 206775], [170, 207115]]}, {"verse": 32, "start": 208186, "end": 212170, "text": "But after I am risen again, I will go before you into Galilee.", "words": [[0, 208186], [4, 208290], [10, 208630], [12, 208890], [15, 209010], [21, 209250], [28, 210110], [30, 210210], [35, 210350], [38, 210530], [45, 210930], [49, 211210], [54, 211490]]}, {"verse": 33, "start": 212520, "end": 218417, "text": "Peter answered and said to him, Though all men shall be offended because of you, yet will I never be offended.", "words": [[0, 212520], [6, 212700], [15, 213140], [19, 213360], [24, 213620], [27, 213820], [32, 214447], [39, 214605], [43, 214785], [47, 215025], [53, 215305], [56, 215485], [65, 215845], [73, 216145], [76, 216425], [81, 216925], [85, 217105], [90, 217305], [92, 217445], [98, 217665], [101, 217885]]}, {"verse": 34, "start": 218767, "end": 229092, "text": "Jesus said to him, Assuredly I say to you, That this night, before the rooster crow, you shall deny me three times.", "words": [[0, 218767], [6, 219107], [11, 219427], [14, 219627], [19, 222608], [29, 223251], [31, 223391], [35, 223591], [38, 223771], [43, 224431], [48, 224731], [53, 224971], [60, 225551], [67, 225831], [71, 226071], [79, 226371], [85, 227191], [89, 227331], [95, 227531], [100, 227931], [103, 228131], [109, 228391]]}, {"verse": 35, "start": 229442, "end": 235999, "text": "Peter said to him, Though I should die with you, yet will I not deny you. Likewise also said all the disciples.", "words": [[0, 229442], [6, 229622], [11, 229902], [14, 230122], [19, 230670], [26, 230823], [28, 231003], [35, 231183], [39, 231463], [44, 231683], [49, 232163], [53, 232303], [58, 232503], [60, 232663], [64, 232903], [69, 233183], [74, 233900], [83, 234235], [88, 234635], [93, 234915], [97, 235075], [101, 235215]]}, {"verse": 36, "start": 236449, "end": 243938, "text": "¶ Then comes Jesus with them to a place called Gethsemane, and says to the disciples, Sit here, while I go and pray yonder.", "words": [[2, 236449], [7, 236652], [13, 236952], [19, 237252], [24, 237612], [29, 237812], [32, 237992], [34, 238092], [40, 238332], [47, 238652], [59, 239652], [63, 240032], [68, 240252], [71, 240492], [75, 240592], [86, 241655], [90, 241859], [96, 242159], [102, 242379], [104, 242539], [107, 242739], [111, 242919], [116, 243239]]}, {"verse": 37, "start": 244288, "end": 249516, "text": "And he took with him Peter and the two sons of Zebedee, and began to be sorrowful and very heavy.", "words": [[0, 244288], [4, 244419], [7, 244519], [12, 244719], [17, 244979], [21, 245139], [27, 245499], [31, 245739], [35, 245839], [39, 246019], [44, 246339], [47, 246499], [56, 247079], [60, 247499], [66, 247759], [69, 247939], [72, 248019], [82, 248659], [86, 248779], [91, 249019]]}, {"verse": 38, "start": 249966, "end": 256350, "text": "Then says he to them, My soul is exceeding sorrowful, even to death: stay here, and watch with me.", "words": [[0, 249966], [5, 250155], [10, 250395], [13, 250655], [16, 250815], [22, 251468], [25, 251632], [30, 251992], [33, 252232], [43, 252752], [54, 253512], [59, 253692], [62, 253932], [69, 254604], [74, 254807], [80, 255167], [84, 255547], [90, 255807], [95, 256087]]}, {"verse": 39, "start": 256700, "end": 267691, "text": "And he went a little further, and fell on his face, and prayed, saying, O my Father, if it be possible, let this cup pass from me: nevertheless not as I will, but as you will.", "words": [[0, 256700], [4, 256832], [7, 256932], [12, 257132], [14, 257252], [21, 257432], [30, 257852], [34, 258432], [39, 258652], [42, 258852], [46, 259012], [52, 259332], [56, 259712], [64, 260272], [72, 261104], [74, 261234], [77, 261354], [85, 261834], [88, 261994], [91, 262094], [94, 262214], [104, 263094], [108, 263354], [113, 263594], [117, 263894], [122, 264254], [127, 264534], [131, 265113], [144, 265694], [148, 265894], [151, 266054], [153, 266194], [159, 266774], [163, 266854], [166, 267074], [170, 267254]]}, {"verse": 40, "start": 268041, "end": 274797, "text": "And he comes to the disciples, and finds them asleep, and says to Peter, What, could you not watch with me one hour?", "words": [[0, 268041], [4, 268173], [7, 268253], [13, 268513], [16, 268773], [20, 268873], [31, 269393], [35, 270013], [41, 270353], [46, 270593], [54, 270993], [58, 271493], [63, 271693], [66, 271913], [73, 272654], [79, 272871], [85, 273091], [89, 273251], [93, 273431], [99, 273751], [104, 273951], [107, 274111], [111, 274331]]}, {"verse": 41, "start": 275247, "end": 281208, "text": "Watch and pray, that you enter not into temptation: the spirit indeed is willing, but the flesh is weak.", "words": [[0, 275247], [6, 275506], [10, 275766], [16, 276086], [21, 276346], [25, 276466], [31, 276746], [35, 277046], [40, 277286], [52, 278454], [56, 278531], [63, 278891], [70, 279191], [73, 279451], [82, 280051], [86, 280151], [90, 280271], [96, 280571], [99, 280731]]}, {"verse": 42, "start": 281558, "end": 291682, "text": "He went away again the second time, and prayed, saying, O my Father, if this cup may not pass away from me, unless I drink it, your will be done.", "words": [[0, 281558], [3, 281644], [8, 281804], [13, 282004], [19, 282304], [23, 282484], [30, 282744], [36, 283084], [40, 283404], [48, 284104], [56, 285858], [58, 286028], [61, 286168], [69, 286828], [72, 286928], [77, 287168], [81, 287448], [85, 287648], [89, 287828], [94, 288108], [99, 288448], [104, 288688], [108, 289228], [115, 289488], [117, 289748], [123, 289988], [127, 290508], [132, 290668], [137, 290968], [140, 291188]]}, {"verse": 43, "start": 292032, "end": 295481, "text": "And he came and found them asleep again: for their eyes were heavy.", "words": [[0, 292032], [4, 292167], [7, 292267], [12, 292547], [16, 292747], [22, 292987], [27, 293207], [34, 293527], [41, 294386], [45, 294490], [51, 294610], [56, 294890], [61, 295110]]}, {"verse": 44, "start": 295931, "end": 300542, "text": "And he left them, and went away again, and prayed the third time, saying the same words.", "words": [[0, 295931], [4, 296056], [7, 296136], [12, 296376], [18, 296616], [22, 296876], [27, 297056], [32, 297296], [39, 297636], [43, 297776], [50, 298036], [54, 298236], [60, 298476], [66, 298796], [73, 299116], [77, 299336], [82, 299596]]}, {"verse": 45, "start": 300992, "end": 313586, "text": "Then comes he to his disciples, and says to them, Sleep on now, and take your rest: behold, the hour is at hand, and the Son of man is betrayed into the hands of sinners.", "words": [[0, 300992], [5, 301184], [11, 301544], [14, 301724], [17, 301904], [21, 302084], [32, 302624], [36, 303324], [41, 303564], [44, 303804], [50, 306001], [56, 306249], [59, 306509], [64, 306809], [68, 307069], [73, 307289], [78, 307449], [84, 308301], [92, 309105], [96, 309245], [101, 309585], [104, 309805], [107, 309925], [113, 310665], [117, 310765], [121, 310885], [125, 311085], [128, 311185], [132, 311445], [135, 311625], [144, 312025], [149, 312345], [153, 312505], [159, 312805], [162, 312965]]}, {"verse": 46, "start": 314036, "end": 318288, "text": "Rise, let us be going: behold, he is at hand that does betray me.", "words": [[0, 314036], [6, 314573], [10, 314633], [13, 314753], [16, 314913], [23, 315740], [31, 316275], [34, 316375], [37, 316535], [40, 316675], [45, 317015], [50, 317275], [55, 317555], [62, 317895]]}, {"verse": 47, "start": 318638, "end": 328563, "text": "¶ And while he yet spoke, lo, Judas, one of the twelve, came, and with him a great multitude with swords and staves, from the chief priests and elders of the people.", "words": [[2, 318638], [6, 318760], [12, 319000], [15, 319180], [19, 319340], [26, 320080], [30, 320480], [37, 321140], [41, 321400], [44, 321500], [48, 321600], [56, 322240], [62, 322800], [66, 322940], [71, 323100], [75, 323280], [77, 323360], [83, 323600], [93, 324160], [98, 324520], [105, 324860], [109, 325100], [117, 326164], [122, 326404], [126, 326524], [132, 326764], [140, 327124], [144, 327424], [151, 327724], [154, 327964], [158, 328064]]}, {"verse": 48, "start": 329013, "end": 336952, "text": "Now he that betrayed him gave them a sign, saying, Whomsoever I shall kiss, that same is he: hold him fast.", "words": [[0, 329013], [4, 329617], [7, 329717], [12, 329877], [21, 330237], [25, 330517], [30, 330737], [35, 330957], [37, 331117], [43, 331757], [51, 333284], [62, 333705], [64, 333945], [70, 334105], [76, 334805], [81, 334925], [86, 335165], [89, 335405], [93, 336038], [98, 336222], [102, 336402]]}, {"verse": 49, "start": 337302, "end": 342323, "text": "And forthwith he came to Jesus, and said, Hail, master; and kissed him.", "words": [[0, 337302], [4, 337454], [14, 338114], [17, 338314], [22, 338574], [25, 338754], [32, 339134], [36, 339594], [42, 340347], [48, 340529], [56, 341404], [60, 341563], [67, 341863]]}, {"verse": 50, "start": 342773, "end": 353575, "text": "And Jesus said to him, Friend, why are you come? Then came they, and laid hands on Jesus, and took him.", "words": [[0, 342773], [4, 342936], [10, 343256], [15, 343636], [18, 343836], [23, 344463], [31, 345209], [35, 345609], [39, 345729], [43, 345849], [47, 347897], [49, 349438], [54, 349624], [59, 349944], [65, 350284], [69, 350644], [74, 350844], [80, 351244], [83, 351464], [90, 351844], [94, 352324], [99, 352544]]}, {"verse": 51, "start": 354025, "end": 363336, "text": "And, behold, one of them which were with Jesus stretched out his hand, and drew his sword, and struck a servant of the high priest’s, and struck off his ear.", "words": [[0, 354025], [5, 354161], [13, 354941], [17, 355221], [20, 355381], [25, 355581], [31, 355841], [36, 356021], [41, 356221], [47, 356581], [57, 357021], [61, 357301], [65, 357481], [71, 357801], [75, 358101], [80, 358341], [84, 358561], [91, 358961], [95, 359481], [102, 359761], [104, 359981], [112, 360241], [115, 360501], [119, 360621], [124, 360781], [134, 361141], [138, 361721], [145, 361981], [149, 362221], [153, 362441]]}, {"verse": 52, "start": 363786, "end": 371453, "text": "Then said Jesus to him, Put up again your sword into his place: for all they that take the sword shall perish with the sword.", "words": [[0, 363786], [5, 363988], [10, 364228], [16, 364568], [19, 364908], [24, 365962], [28, 366079], [31, 366239], [37, 366539], [42, 366739], [48, 367099], [53, 367359], [57, 367579], [64, 368489], [68, 368586], [72, 368826], [77, 369026], [82, 369206], [87, 369426], [91, 369586], [97, 369926], [103, 370166], [110, 370566], [115, 370806], [119, 370966]]}, {"verse": 53, "start": 371903, "end": 377962, "text": "Do you think that I can not now pray to my Father and he shall at once give me more than twelve legions of angels", "words": [[0, 371903], [3, 372016], [7, 372116], [13, 372336], [18, 372516], [20, 372669], [24, 372823], [28, 372976], [32, 373316], [37, 373616], [40, 373796], [43, 373976], [50, 374696], [54, 374856], [57, 375016], [63, 375236], [66, 375396], [71, 375656], [76, 375916], [79, 376076], [84, 376276], [89, 376436], [96, 376736], [104, 377256], [107, 377396]]}, {"verse": 54, "start": 378412, "end": 382311, "text": "But how then shall the scriptures be fulfilled, that thus it must be?", "words": [[0, 378412], [4, 378531], [8, 378811], [13, 379111], [19, 379371], [23, 379531], [34, 379871], [37, 380171], [48, 381111], [53, 381231], [58, 381471], [61, 381631], [66, 381791]]}, {"verse": 55, "start": 382661, "end": 393107, "text": "In that same hour said Jesus to the multitudes, Are you come out as against a thief with swords and staves to take me? I sat daily with you teaching in the temple, and you laid no hold on me.", "words": [[0, 382661], [3, 382802], [8, 382982], [13, 383282], [18, 383722], [23, 384062], [29, 384502], [32, 384782], [36, 384902], [48, 386049], [52, 386134], [56, 386274], [61, 386474], [65, 386674], [68, 386814], [76, 387014], [78, 387214], [84, 387474], [89, 387694], [96, 388074], [100, 388254], [107, 388674], [110, 388794], [115, 388994], [119, 389628], [121, 389745], [125, 389985], [131, 390345], [136, 390565], [140, 390665], [149, 390945], [152, 391125], [156, 391205], [164, 391745], [168, 391945], [172, 392045], [177, 392245], [180, 392445], [185, 392645], [188, 392825]]}, {"verse": 56, "start": 393557, "end": 400458, "text": "But all this was done, that the scriptures of the prophets might be fulfilled. Then all the disciples forsook him, and fled.", "words": [[0, 393557], [4, 393701], [8, 393901], [13, 394101], [17, 394301], [23, 394601], [28, 395061], [32, 395221], [43, 395561], [46, 395821], [50, 395921], [59, 396261], [65, 396541], [68, 396741], [79, 397747], [84, 397901], [88, 398201], [92, 398381], [102, 398861], [110, 399501], [115, 399641], [119, 399881]]}, {"verse": 57, "start": 400908, "end": 408299, "text": "¶ And they that had laid hold on Jesus led him away to Caiaphas the high priest, where the scribes and the elders were assembled.", "words": [[2, 400908], [6, 401049], [11, 401229], [16, 401449], [20, 401589], [25, 401789], [30, 402089], [33, 402349], [39, 402709], [43, 403129], [47, 403309], [52, 403629], [55, 403869], [64, 404649], [68, 404949], [73, 405169], [81, 405909], [87, 406089], [91, 406269], [99, 406829], [103, 406929], [107, 407049], [114, 407269], [119, 407589]]}, {"verse": 58, "start": 408749, "end": 415812, "text": "But Peter followed him afar off to the high priest’s palace, and went in, and sat with the servants, to see the end.", "words": [[0, 408749], [4, 408873], [10, 409113], [19, 409553], [23, 409813], [28, 410153], [32, 410513], [35, 410673], [39, 410793], [44, 410993], [53, 411493], [61, 411813], [65, 412553], [70, 412773], [74, 413093], [78, 413513], [82, 413793], [87, 414013], [91, 414153], [101, 414513], [104, 414973], [108, 415193], [112, 415353]]}, {"verse": 59, "start": 416262, "end": 423312, "text": "Now the chief priests, and elders, and all the council, sought false witness against Jesus, to put him to death;", "words": [[0, 416262], [4, 416600], [8, 416860], [14, 417120], [23, 417560], [27, 417960], [35, 418380], [39, 418740], [43, 419000], [47, 419120], [56, 419560], [63, 420260], [69, 420660], [77, 421060], [85, 421400], [92, 421900], [95, 422380], [99, 422560], [103, 422680], [106, 422800]]}, {"verse": 60, "start": 423762, "end": 431215, "text": "But found none: yes, though many false witnesses came, yet found they none. At the last came two false witnesses,", "words": [[0, 423762], [4, 423866], [10, 424146], [16, 425084], [21, 425554], [28, 425654], [33, 425854], [39, 426214], [49, 426634], [55, 427414], [59, 427574], [65, 427934], [70, 428174], [76, 428965], [79, 429065], [83, 429185], [88, 429465], [93, 429725], [97, 430025], [103, 430425]]}, {"verse": 61, "start": 431665, "end": 436923, "text": "And said, This fellow said, I am able to destroy the temple of God, and to build it in three days.", "words": [[0, 431665], [4, 431769], [10, 432535], [15, 432675], [22, 432895], [28, 433175], [30, 433335], [33, 433455], [38, 433595], [41, 433795], [49, 434135], [53, 434315], [60, 434575], [63, 434735], [68, 435035], [72, 435555], [75, 435715], [81, 435915], [84, 436055], [87, 436175], [93, 436375]]}, {"verse": 62, "start": 437273, "end": 443742, "text": "And the high priest arose, and said to him, Do you answer nothing? what is it which these witness against you?", "words": [[0, 437273], [4, 437416], [8, 437556], [13, 437836], [20, 438176], [27, 438656], [31, 439036], [36, 439316], [39, 439536], [44, 440103], [47, 440202], [51, 440322], [58, 440662], [67, 441618], [72, 441799], [75, 441999], [78, 442139], [84, 442359], [90, 442619], [98, 442979], [106, 443379]]}, {"verse": 63, "start": 444092, "end": 452379, "text": "But Jesus kept silent. And the high priest answered and said to him, I adjure you by the living God, that you tell us whether you be the Christ, the Son of God.", "words": [[0, 444092], [4, 444286], [10, 444626], [15, 444986], [23, 445987], [27, 446113], [31, 446213], [36, 446353], [43, 446613], [52, 447093], [56, 447353], [61, 447533], [64, 447713], [69, 448291], [71, 448411], [78, 448771], [82, 448891], [85, 449051], [89, 449191], [96, 449371], [101, 449671], [106, 449911], [110, 450051], [115, 450271], [118, 450411], [126, 450591], [130, 450751], [133, 450871], [137, 450971], [145, 451611], [149, 451711], [153, 451931], [156, 452031]]}, {"verse": 64, "start": 452679, "end": 462973, "text": "Jesus says to him, You have said: nevertheless I say to you, Hereafter shall you see the Son of man sitting on the right hand of power, and coming in the clouds of heaven.", "words": [[0, 452679], [6, 452934], [11, 453274], [14, 453494], [19, 454074], [23, 454394], [28, 454634], [34, 455466], [47, 456051], [49, 456191], [53, 456411], [56, 456611], [61, 457211], [71, 457731], [77, 458051], [81, 458231], [85, 458411], [89, 458571], [93, 458831], [96, 458951], [100, 459251], [108, 459631], [111, 459851], [115, 459971], [121, 460171], [126, 460391], [129, 460551], [136, 460911], [140, 461431], [147, 461691], [150, 461891], [154, 461991], [161, 462371], [164, 462531]]}, {"verse": 65, "start": 463323, "end": 472954, "text": "Then the high priest tore his clothes, saying, He has spoken blasphemy; what further need have we of witnesses? behold, now you have heard his blasphemy.", "words": [[0, 463323], [5, 463633], [9, 463913], [14, 464113], [21, 464433], [26, 464873], [30, 465073], [39, 465753], [47, 467138], [50, 467275], [54, 467355], [61, 467655], [72, 468729], [77, 468850], [85, 469110], [90, 469410], [95, 469670], [98, 469850], [101, 470070], [112, 471042], [120, 471507], [124, 471627], [128, 471827], [133, 471947], [139, 472147], [143, 472287]]}, {"verse": 66, "start": 473404, "end": 477515, "text": "What do you think? They answered and said, He is guilty of death.", "words": [[0, 473404], [5, 473520], [8, 473620], [12, 473700], [19, 474580], [24, 474716], [33, 475156], [37, 475376], [43, 476166], [46, 476329], [49, 476629], [56, 476949], [59, 477259]]}, {"verse": 67, "start": 477865, "end": 483675, "text": "Then did they spit in his face, and buffeted him; and others struck him with the palms of their hands,", "words": [[0, 477865], [5, 478173], [9, 478413], [14, 478593], [19, 478913], [22, 479113], [26, 479253], [32, 479573], [36, 479833], [45, 480253], [50, 480983], [54, 481112], [61, 481392], [68, 481832], [72, 482052], [77, 482212], [81, 482352], [87, 482672], [90, 482892], [96, 483052]]}, {"verse": 68, "start": 484125, "end": 488146, "text": "Saying, Prophesy to us, you Christ, Who is he that struck you?", "words": [[0, 484437], [8, 485125], [17, 485285], [20, 485545], [24, 486025], [28, 486125], [36, 486845], [40, 487005], [43, 487145], [46, 487365], [51, 487545], [58, 487805]]}, {"verse": 69, "start": 488496, "end": 495561, "text": "¶ Now Peter sat without in the palace: and a girl came to him, saying, You also were with Jesus of Galilee.", "words": [[2, 488496], [6, 488680], [12, 489000], [16, 489380], [24, 489720], [27, 490020], [31, 490140], [39, 491067], [43, 491173], [45, 491293], [50, 491533], [55, 491833], [58, 492033], [63, 492253], [71, 493058], [75, 493202], [80, 493582], [85, 493842], [90, 494022], [96, 494422], [99, 494762]]}, {"verse": 70, "start": 495911, "end": 499625, "text": "But he denied before them all, saying, I know not what you say.", "words": [[0, 495911], [4, 496013], [7, 496153], [14, 496513], [21, 496893], [26, 497153], [31, 497573], [39, 498314], [41, 498434], [46, 498634], [50, 498894], [55, 499134], [59, 499294]]}, {"verse": 71, "start": 499975, "end": 508371, "text": "And when he was gone out into the porch, another maid saw him, and said to them that were there, This fellow was also with Jesus of Nazareth.", "words": [[0, 499975], [4, 500100], [9, 500260], [12, 500420], [16, 500580], [21, 500820], [25, 501040], [30, 501280], [34, 501440], [41, 502340], [49, 502580], [54, 502960], [58, 503280], [63, 503940], [67, 504100], [72, 504320], [75, 504520], [80, 504720], [85, 504900], [90, 505040], [97, 505827], [102, 506050], [109, 506330], [113, 506630], [118, 507010], [123, 507230], [129, 507530], [132, 507790]]}, {"verse": 72, "start": 508721, "end": 513312, "text": "And again he denied with an oath, I do not know the man.", "words": [[0, 508721], [4, 508870], [10, 509190], [13, 509430], [20, 509810], [25, 510110], [28, 510230], [34, 511881], [36, 512008], [39, 512168], [43, 512368], [48, 512648], [52, 512828]]}, {"verse": 73, "start": 513662, "end": 521582, "text": "And after a while came to him they that stood by, and said to Peter, Surely you also are one of them; for your speech betrays you.", "words": [[0, 513662], [4, 513835], [10, 514115], [12, 514315], [18, 514535], [23, 514875], [26, 515135], [30, 515495], [35, 515595], [40, 515835], [46, 516055], [50, 516435], [54, 516835], [59, 517055], [62, 517215], [69, 517961], [76, 518217], [80, 518517], [85, 518957], [89, 519197], [93, 519357], [96, 519517], [102, 520109], [106, 520213], [111, 520373], [118, 520693], [126, 521333]]}, {"verse": 74, "start": 521932, "end": 529807, "text": "Then began he to curse and to swear, saying, I know not the man. And immediately the rooster crew.", "words": [[0, 521932], [5, 522158], [11, 522558], [14, 522778], [17, 522898], [23, 523258], [27, 523538], [30, 523678], [37, 524438], [45, 525852], [47, 526026], [52, 526306], [56, 526806], [60, 527146], [65, 527924], [69, 528113], [81, 528513], [85, 528973], [93, 529273]]}, {"verse": 75, "start": 530257, "end": 540619, "text": "And Peter remembered the word of Jesus, which said to him, Before the rooster crow, you shall deny me three times. And he went out, and wept bitterly.", "words": [[0, 530257], [4, 530415], [10, 530675], [21, 531115], [25, 531375], [30, 531615], [33, 531735], [40, 532555], [46, 532775], [51, 533055], [54, 533235], [59, 533879], [66, 534118], [70, 534318], [78, 534658], [84, 535578], [88, 535718], [94, 535898], [99, 536258], [102, 536498], [108, 536798], [115, 537882], [119, 538009], [122, 538129], [127, 538329], [132, 538609], [136, 539089], [141, 539409]]}]}