{"book": "MRK", "chapter": 5, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 334922, "verses": [{"verse": 1, "start": 300, "end": 6125, "text": "Y vinieron de la otra parte del mar a la provincia de los gadarenos.", "words": [[0, 300], [2, 428], [11, 808], [14, 988], [17, 1108], [22, 1268], [28, 1628], [32, 1868], [36, 2108], [38, 2348], [41, 2448], [51, 3048], [54, 3168], [58, 3288]]}, {"verse": 2, "start": 6575, "end": 12409, "text": "Y salido él del barco, luego le salió al encuentro, de los sepulcros, un hombre con un espíritu inmundo,", "words": [[0, 6575], [2, 6575], [9, 6575], [12, 6575], [16, 6575], [23, 6575], [29, 6802], [32, 7062], [38, 7482], [41, 7622], [52, 8562], [55, 8782], [59, 8942], [70, 10202], [73, 10342], [80, 10682], [84, 10942], [87, 11082], [96, 11622]]}, {"verse": 3, "start": 12859, "end": 18471, "text": "Que vivía entre los sepulcros, y ni aun con cadenas le podía alguien atar;", "words": [[0, 12859], [4, 12963], [10, 13463], [16, 13743], [20, 13963], [31, 14823], [33, 15343], [36, 15543], [40, 15823], [44, 16123], [52, 16783], [55, 16983], [61, 17494], [69, 18006]]}, {"verse": 4, "start": 18921, "end": 30358, "text": "Porque muchas veces había sido atado con grilletes y cadenas, pero las cadenas habían sido hechas pedazos por él, y los grilletes rotos; y nadie le podía domar.", "words": [[0, 18921], [7, 19168], [14, 19488], [20, 19928], [26, 20268], [31, 20668], [37, 21128], [41, 21548], [51, 21968], [53, 22168], [62, 23048], [67, 23148], [71, 23328], [79, 23808], [86, 24148], [91, 24648], [98, 24988], [106, 25528], [110, 25748], [114, 25928], [116, 26528], [120, 26888], [130, 27248], [137, 28396], [139, 28527], [145, 28887], [148, 29427], [154, 29787]]}, {"verse": 5, "start": 30808, "end": 38488, "text": "Y siempre, de día y de noche, andaba dando voces en los montes y en los sepulcros, e hiriéndose con las piedras.", "words": [[0, 30808], [2, 30930], [11, 31290], [14, 31550], [18, 31830], [20, 31950], [23, 32070], [30, 32390], [37, 33210], [43, 33510], [49, 33950], [52, 34130], [56, 34250], [63, 34890], [65, 35070], [68, 35190], [72, 35350], [83, 36170], [85, 36730], [96, 37410], [100, 37590], [104, 37750]]}, {"verse": 6, "start": 38938, "end": 42525, "text": "Y cuando vio a Jesús de lejos, corrió, y le adoró.", "words": [[0, 38938], [2, 39026], [9, 39186], [13, 39526], [15, 39626], [21, 39886], [24, 40086], [31, 40486], [39, 41166], [41, 41826], [44, 41966]]}, {"verse": 7, "start": 42975, "end": 51468, "text": "Y clamando a gran voz, dijo: ¿Qué tienes conmigo, Jesús, Hijo del Dios Altísimo? Te suplico en nombre de Dios que no me atormentes.", "words": [[0, 42975], [2, 43117], [11, 43697], [13, 43817], [18, 43977], [23, 44757], [29, 45565], [34, 45646], [41, 45926], [50, 46386], [57, 47086], [62, 47246], [66, 47446], [71, 47646], [81, 48717], [84, 48795], [92, 49295], [95, 49415], [102, 49695], [105, 49895], [110, 50135], [114, 50335], [117, 50455], [120, 50575]]}, {"verse": 8, "start": 51818, "end": 56240, "text": "Porque le decía: Sal de este hombre, espíritu inmundo.", "words": [[0, 51818], [7, 52042], [10, 52222], [17, 53327], [21, 53501], [24, 53674], [29, 53934], [37, 54354], [46, 55323]]}, {"verse": 9, "start": 56690, "end": 63585, "text": "Y le preguntó: ¿Cómo te llamas? Y respondió diciendo: Legión me llamo; porque somos muchos.", "words": [[0, 56690], [2, 56791], [5, 56891], [15, 57893], [21, 58177], [24, 58337], [32, 59347], [34, 59453], [44, 59993], [54, 61018], [61, 61445], [64, 61665], [71, 62367], [78, 62567], [84, 62847]]}, {"verse": 10, "start": 63935, "end": 67917, "text": "Y le rogaba mucho que no le enviase fuera de aquella provincia.", "words": [[0, 64022], [2, 64142], [5, 64262], [12, 64782], [18, 65102], [22, 65302], [25, 65482], [28, 65602], [36, 66082], [42, 66422], [45, 66662], [53, 66922]]}, {"verse": 11, "start": 68367, "end": 73044, "text": "Y estaba allí cerca del monte una grande manada de cerdos paciendo.", "words": [[0, 68367], [2, 68654], [9, 68974], [14, 69274], [20, 69614], [24, 69914], [30, 70294], [34, 70554], [41, 70954], [48, 71534], [51, 71714], [58, 72410]]}, {"verse": 12, "start": 73494, "end": 79690, "text": "Y le rogaron todos los demonios, diciendo: Envíanos a los cerdos para que entremos en ellos.", "words": [[0, 73494], [2, 73600], [5, 73740], [13, 74300], [19, 74660], [23, 75040], [33, 75740], [43, 76902], [52, 77525], [54, 77645], [58, 77745], [65, 78225], [70, 78445], [74, 78585], [83, 79025], [86, 79165]]}, {"verse": 13, "start": 80040, "end": 93991, "text": "Y luego Jesús se lo permitió. Y saliendo aquellos espíritus inmundos, entraron en los cerdos, y la manada cayó por un despeñadero en el mar; los cuales eran como dos mil; y en el mar se ahogaron.", "words": [[0, 80040], [2, 80181], [8, 80321], [14, 80741], [17, 81081], [20, 81181], [30, 82213], [32, 82317], [41, 82877], [50, 83037], [60, 83777], [70, 84557], [79, 85337], [82, 85457], [86, 85597], [94, 86357], [96, 86797], [99, 86957], [106, 87297], [111, 87757], [115, 87997], [118, 88137], [130, 88897], [133, 89037], [136, 89157], [141, 89862], [145, 89986], [152, 90146], [157, 90526], [162, 90952], [166, 91378], [171, 92072], [173, 92227], [176, 92367], [179, 92487], [183, 92727], [186, 92967]]}, {"verse": 14, "start": 94441, "end": 104380, "text": "Y los que apacentaban los cerdos huyeron, y dieron aviso en la ciudad y en los campos. Y salieron para ver qué era aquello que había acontecido.", "words": [[0, 94441], [2, 94563], [6, 94683], [10, 95153], [22, 95623], [26, 95783], [33, 96383], [42, 97143], [44, 97623], [51, 97903], [57, 98303], [60, 98463], [63, 98583], [70, 98903], [72, 99163], [75, 99263], [79, 99383], [87, 100567], [89, 100828], [98, 101308], [103, 101568], [107, 101788], [111, 101988], [115, 102348], [123, 102868], [127, 103008], [133, 103308]]}, {"verse": 15, "start": 104830, "end": 116469, "text": "Y vienen a Jesús, y ven al que había sido atormentado del demonio, y que había tenido la legión, sentado y vestido, y en su juicio cabal; y tuvieron miedo.", "words": [[0, 104830], [2, 104931], [9, 105191], [11, 105371], [18, 106431], [20, 106691], [24, 106891], [27, 107151], [31, 107351], [37, 107551], [42, 107911], [54, 108791], [58, 109011], [67, 110011], [69, 110171], [73, 110311], [79, 110511], [86, 110831], [89, 111071], [97, 111891], [105, 112451], [107, 112551], [116, 113211], [118, 113571], [121, 113711], [124, 113871], [131, 114271], [138, 115270], [140, 115474], [149, 115834]]}, {"verse": 16, "start": 116919, "end": 124596, "text": "Y les contaron los que lo habían visto, cómo había acontecido al que había tenido el demonio, y lo de los cerdos.", "words": [[0, 116919], [2, 117043], [6, 117163], [15, 117863], [19, 118083], [23, 118243], [26, 118403], [33, 118663], [40, 119663], [45, 119923], [51, 120343], [62, 121323], [65, 121443], [69, 121583], [75, 121823], [82, 122123], [85, 122363], [94, 123223], [96, 123383], [99, 123543], [102, 123643], [106, 123783]]}, {"verse": 17, "start": 125046, "end": 128228, "text": "Y comenzaron a rogarle que se fuese de su región.", "words": [[0, 125046], [2, 125133], [13, 125833], [15, 126222], [23, 126612], [27, 126773], [30, 126913], [36, 127232], [39, 127372], [42, 127532]]}, {"verse": 18, "start": 128678, "end": 135717, "text": "Y entrando él en el barco, le rogaba el que había estado poseído por el demonio, para estar con él.", "words": [[0, 128678], [2, 128822], [11, 129322], [14, 129662], [17, 129962], [20, 130122], [27, 131102], [30, 131602], [37, 132102], [40, 132342], [44, 132502], [50, 132702], [57, 133042], [65, 133742], [69, 133982], [72, 134122], [81, 134662], [86, 134862], [92, 135122], [96, 135422]]}, {"verse": 19, "start": 136167, "end": 147627, "text": "Pero Jesús no le permitió, sino le dijo: Vete a tu casa, a los tuyos, y cuéntales cuán grandes cosas el Señor ha hecho contigo, y cómo ha tenido misericordia de ti.", "words": [[0, 136167], [5, 136311], [11, 136711], [14, 137211], [17, 137371], [27, 137901], [32, 138431], [35, 138571], [41, 139458], [46, 139764], [48, 139884], [51, 139964], [57, 140344], [59, 140744], [63, 140844], [70, 141384], [72, 141544], [82, 141964], [87, 142264], [95, 142604], [101, 143004], [104, 143264], [110, 143604], [113, 143944], [119, 144204], [128, 144824], [130, 145204], [135, 145544], [138, 145724], [145, 146044], [158, 147104], [161, 147224]]}, {"verse": 20, "start": 148076, "end": 157123, "text": "Y se fue, y comenzó a publicar en Decápolis cuán grandes cosas Jesús había hecho con él: y todos se maravillaban.", "words": [[0, 148076], [2, 148243], [5, 148323], [10, 149143], [12, 149243], [20, 149823], [22, 149923], [31, 150463], [34, 150563], [44, 151203], [49, 151763], [57, 152183], [63, 152543], [69, 153063], [75, 153623], [81, 153983], [85, 154243], [89, 154929], [91, 155231], [97, 155611], [100, 156071]]}, {"verse": 21, "start": 157573, "end": 165417, "text": "Y pasando otra vez Jesús en un barco a la otra parte, se juntó a él una gran multitud; y estaba junto al mar.", "words": [[0, 157573], [2, 157676], [10, 158076], [15, 158416], [19, 158736], [25, 159136], [28, 159516], [31, 159656], [37, 160036], [39, 160136], [42, 160196], [47, 160356], [54, 161216], [57, 161516], [63, 162016], [65, 162136], [68, 162256], [72, 162436], [77, 162716], [87, 164011], [89, 164119], [96, 164419], [102, 164739], [105, 164979]]}, {"verse": 22, "start": 165867, "end": 173340, "text": "Y vino uno de los dirigentes de la sinagoga, llamado Jairo; y luego que le vio, se postró a sus pies,", "words": [[0, 165867], [2, 165991], [7, 166271], [11, 166691], [14, 166911], [18, 167031], [29, 167731], [32, 167891], [35, 168011], [45, 168731], [53, 169131], [60, 170373], [62, 170521], [68, 170701], [72, 170981], [75, 171121], [80, 171441], [83, 171981], [90, 172481], [92, 172601], [96, 172701]]}, {"verse": 23, "start": 173790, "end": 181876, "text": "Y le rogaba mucho, diciendo: Mi hija está a punto de morir: ven y pondrás las manos sobre ella para que sane, y vivirá.", "words": [[0, 173790], [2, 173914], [5, 174264], [12, 174614], [19, 175474], [29, 176477], [32, 176614], [37, 176934], [42, 177154], [44, 177294], [50, 177494], [53, 177734], [60, 178525], [64, 178751], [66, 178931], [74, 179311], [78, 179451], [84, 179691], [90, 180051], [95, 180291], [100, 180551], [104, 180711], [110, 181011], [112, 181331]]}, {"verse": 24, "start": 182226, "end": 186908, "text": "Y fue con él, y le seguía gran multitud, y le apretaban.", "words": [[0, 182226], [2, 182367], [6, 182527], [10, 182807], [14, 183067], [16, 183607], [19, 183747], [26, 184187], [31, 184487], [41, 185267], [43, 185807], [46, 185927]]}, {"verse": 25, "start": 187358, "end": 191985, "text": "Y una mujer que padecía hemorragias desde hacía doce años,", "words": [[0, 187358], [2, 187615], [6, 187775], [12, 188095], [16, 188295], [24, 188915], [36, 189935], [42, 190275], [48, 190735], [53, 191195]]}, {"verse": 26, "start": 192435, "end": 202431, "text": "Y había sufrido mucho de muchos médicos, y había gastado todo lo que tenía, y no había mejorado, antes le iba peor,", "words": [[0, 192435], [2, 192579], [8, 192799], [16, 193459], [22, 193979], [25, 194239], [32, 194479], [41, 195339], [43, 196099], [49, 196339], [57, 196999], [62, 197399], [65, 197659], [69, 197799], [76, 198259], [78, 199079], [81, 199219], [87, 199479], [97, 200539], [103, 201039], [106, 201579], [110, 201819]]}, {"verse": 27, "start": 202881, "end": 209211, "text": "Cuando oyó hablar de Jesús, llegó por detrás entre la multitud, y tocó su vestido.", "words": [[0, 202881], [7, 203083], [11, 203543], [18, 203823], [21, 204063], [28, 205003], [34, 205443], [38, 205803], [45, 206363], [51, 206643], [54, 206843], [64, 207483], [66, 208003], [71, 208363], [74, 208503]]}, {"verse": 28, "start": 209661, "end": 213980, "text": "Porque decía: Si toco tan solamente su vestido, seré salva.", "words": [[0, 209661], [7, 209883], [14, 210800], [17, 210980], [22, 211340], [26, 211560], [36, 211980], [39, 212320], [48, 213160], [53, 213480]]}, {"verse": 29, "start": 214330, "end": 220931, "text": "Y luego se detuvo la hemorragia; y sintió en el cuerpo que estaba sana de aquella enfermedad.", "words": [[0, 214330], [2, 214456], [8, 214716], [11, 214956], [18, 215436], [21, 215636], [33, 216966], [35, 217215], [42, 217775], [45, 217995], [48, 218135], [55, 218515], [59, 218735], [66, 218995], [71, 219415], [74, 219635], [82, 220015]]}, {"verse": 30, "start": 221380, "end": 231162, "text": "Y luego Jesús, conociendo en sí mismo el poder que había salido de él, volviéndose a la multitud, dijo: ¿Quién ha tocado mis vestidos?", "words": [[0, 221380], [2, 221507], [8, 221727], [15, 222807], [26, 223387], [29, 223607], [32, 223747], [38, 224147], [41, 224267], [47, 224527], [51, 224787], [57, 224987], [64, 225487], [67, 225707], [71, 226687], [83, 227427], [85, 227527], [88, 227627], [98, 228647], [104, 229391], [111, 229655], [114, 229755], [121, 230195], [125, 230355]]}, {"verse": 31, "start": 231612, "end": 237113, "text": "Y le dijeron sus discípulos: Ves que la multitud te aprieta, y dices: ¿Quién me ha tocado?", "words": [[0, 231612], [2, 231757], [5, 231817], [13, 232277], [17, 232437], [29, 233558], [33, 233740], [37, 233940], [40, 234040], [49, 234540], [52, 234680], [61, 235140], [63, 235320], [70, 236180], [77, 236398], [80, 236479], [83, 236579]]}, {"verse": 32, "start": 237463, "end": 241362, "text": "Y él miraba alrededor para ver a la que había hecho esto.", "words": [[0, 237463], [2, 237647], [5, 237767], [12, 238247], [22, 238747], [27, 239307], [31, 239627], [33, 239847], [36, 239947], [40, 240127], [46, 240447], [52, 240747]]}, {"verse": 33, "start": 241812, "end": 252512, "text": "Entonces la mujer, temiendo y temblando, sabiendo lo que en sí había sido hecho, vino y se postró delante de él, y le dijo toda la verdad.", "words": [[0, 241812], [9, 242870], [12, 243270], [19, 243550], [28, 244210], [30, 244330], [41, 244990], [50, 245710], [53, 245910], [57, 246070], [60, 246390], [63, 246690], [69, 247050], [74, 247510], [81, 248270], [86, 248670], [88, 249170], [91, 249310], [98, 249750], [106, 250130], [109, 250310], [113, 250530], [115, 250990], [118, 251090], [123, 251410], [128, 251670], [131, 251890]]}, {"verse": 34, "start": 252962, "end": 259252, "text": "Y él le dijo: Hija, tu fe te ha hecho salva: ve en paz, y queda sana de tu enfermedad.", "words": [[0, 252962], [2, 253107], [5, 253247], [8, 253407], [14, 254243], [20, 254568], [23, 254708], [26, 254948], [29, 255168], [32, 255268], [38, 255448], [45, 256457], [48, 256551], [51, 256644], [56, 257004], [58, 257604], [64, 257824], [69, 258144], [72, 258344], [75, 258484]]}, {"verse": 35, "start": 259702, "end": 268429, "text": "Hablando aún él, vinieron de casa del dirigente de la sinagoga, diciendo: Tu hija ha muerto; ¿para qué molestas más al Maestro?", "words": [[0, 259702], [9, 260111], [13, 260511], [17, 260571], [26, 261071], [29, 261271], [34, 261511], [38, 261711], [48, 262351], [51, 262471], [54, 262571], [64, 263151], [74, 264180], [77, 264284], [82, 264584], [85, 264584], [93, 265445], [99, 265589], [103, 265729], [112, 266269], [116, 266469], [119, 266669]]}, {"verse": 36, "start": 268779, "end": 277133, "text": "Pero luego Jesús, oyendo esta razón que se decía, dijo al dirigente de la sinagoga: No temas, cree solamente.", "words": [[0, 268779], [5, 268943], [11, 269243], [18, 269943], [25, 270363], [30, 270623], [36, 271063], [40, 271283], [43, 271443], [50, 272503], [55, 272803], [58, 273023], [68, 273643], [71, 273803], [74, 273943], [84, 275054], [87, 275182], [94, 275962], [99, 276162]]}, {"verse": 37, "start": 277583, "end": 284409, "text": "Y no permitió que alguno viniese tras él sino Pedro, y Jacobo, y Juan hermano de Jacobo.", "words": [[0, 277583], [2, 277709], [5, 277829], [14, 278429], [18, 278589], [25, 279029], [33, 279469], [38, 279749], [41, 280209], [46, 280289], [53, 280829], [55, 281409], [63, 282469], [65, 282589], [70, 283109], [78, 283589], [81, 283669]]}, {"verse": 38, "start": 284859, "end": 290997, "text": "Y vino a casa del dirigente de la sinagoga, y vio la conmoción, los que lloraban y gemían mucho.", "words": [[0, 284859], [2, 284985], [7, 285225], [9, 285425], [14, 285685], [18, 285985], [28, 286605], [31, 286725], [34, 286845], [44, 287505], [46, 287645], [50, 287845], [53, 287945], [64, 288725], [68, 289185], [72, 289365], [81, 289885], [83, 290045], [90, 290425]]}, {"verse": 39, "start": 291447, "end": 299046, "text": "Y entrando, les dice: ¿Por qué alborotáis y lloráis? La muchacha no es muerta, sino que duerme.", "words": [[0, 291447], [2, 291719], [12, 292219], [16, 292459], [22, 293406], [27, 293512], [31, 293792], [42, 294812], [44, 295112], [53, 296177], [56, 296313], [65, 296773], [68, 296973], [71, 297073], [79, 297793], [84, 298153], [88, 298393]]}, {"verse": 40, "start": 299496, "end": 312094, "text": "Y se burlaban de él: pero él, después de hacer salir a todos, toma al padre y a la madre de la muchacha, y a los que estaban con él, y entra donde la muchacha estaba.", "words": [[0, 299496], [2, 299662], [5, 299802], [14, 300362], [17, 300642], [21, 301335], [26, 301523], [30, 302383], [38, 302823], [41, 303023], [47, 303363], [53, 303763], [55, 303943], [62, 305003], [67, 305383], [70, 305623], [76, 306063], [78, 306423], [80, 306503], [83, 306623], [89, 306983], [92, 307183], [95, 307303], [105, 307903], [107, 308383], [109, 308483], [113, 308603], [117, 308763], [125, 309063], [129, 309403], [133, 310084], [135, 310246], [141, 310546], [147, 310786], [150, 311006], [159, 311446]]}, {"verse": 41, "start": 312544, "end": 320856, "text": "Y tomando la mano de la muchacha, le dice: Talitha cumi; que traducido significa: Muchacha, a ti digo, levántate.", "words": [[0, 312544], [2, 312685], [10, 313165], [13, 313345], [18, 313625], [21, 313785], [24, 313905], [34, 314525], [37, 314625], [43, 315828], [51, 316153], [57, 316778], [61, 316881], [71, 317601], [82, 318860], [92, 319585], [94, 319585], [97, 319705], [103, 320125]]}, {"verse": 42, "start": 321306, "end": 328622, "text": "Y luego la muchacha se levantó, y andaba; porque tenía doce años. Y quedaron sumamente asombrados.", "words": [[0, 321306], [2, 321410], [8, 321610], [11, 321810], [20, 322290], [23, 322450], [32, 323170], [34, 323410], [42, 324364], [49, 324548], [55, 324879], [60, 325208], [66, 326289], [68, 326413], [77, 326913], [87, 327573]]}, {"verse": 43, "start": 329072, "end": 334522, "text": "Pero él les mandó mucho que nadie lo supiese, y dijo que le diesen de comer.", "words": [[0, 329072], [5, 329237], [8, 329637], [12, 329957], [18, 330437], [24, 330777], [28, 330997], [34, 331297], [37, 331517], [46, 332137], [48, 332737], [53, 333077], [57, 333237], [60, 333397], [67, 333757], [70, 333977]]}]}