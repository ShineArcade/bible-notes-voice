{"book": "PSA", "chapter": 74, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 144277, "verses": [{"verse": 1, "start": 300, "end": 6378, "text": "O God, why have you cast us off for ever? why does your anger smoke against the sheep of your pasture?", "words": [[0, 387], [2, 507], [7, 1067], [11, 1207], [16, 1387], [20, 1527], [25, 1827], [28, 2107], [32, 2429], [36, 2752], [42, 3315], [46, 3457], [51, 3637], [56, 3797], [62, 4097], [68, 4517], [76, 4877], [80, 5117], [86, 5397], [89, 5577], [94, 5697]]}, {"verse": 2, "start": 6828, "end": 15749, "text": "Remember your congregation, which you have purchased of old; the rod of your inheritance, which you have redeemed; this mount Zion, in which you have dwelt.", "words": [[0, 6828], [9, 7117], [14, 7357], [28, 7977], [34, 8377], [38, 8537], [43, 8677], [53, 9037], [56, 9277], [61, 10005], [65, 10111], [69, 10471], [72, 10671], [77, 10811], [90, 11391], [96, 11991], [100, 12211], [105, 12371], [115, 13348], [120, 13555], [126, 13835], [132, 14295], [135, 14715], [141, 14895], [145, 15055], [150, 15195]]}, {"verse": 3, "start": 16199, "end": 22688, "text": "Lift up your feet to the perpetual desolations; even all that the enemy has done wickedly in the sanctuary.", "words": [[0, 16199], [5, 16386], [8, 16666], [13, 16826], [18, 17126], [21, 17346], [25, 17446], [35, 17886], [48, 19343], [53, 19555], [57, 19815], [62, 20015], [66, 20175], [72, 20475], [76, 20755], [81, 20995], [90, 21595], [93, 21735], [97, 21835]]}, {"verse": 4, "start": 23138, "end": 28931, "text": "Your enemies roar in the midst of your congregations; they set up their ensigns for signs.", "words": [[0, 23138], [5, 23263], [13, 23643], [18, 24183], [21, 24483], [25, 24583], [31, 24783], [34, 24983], [39, 25103], [54, 26579], [59, 26664], [63, 26924], [66, 27064], [72, 27464], [80, 27864], [84, 28124]]}, {"verse": 5, "start": 29381, "end": 33772, "text": "A man was famous according as he had lifted up axes upon the thick trees.", "words": [[0, 29381], [2, 29479], [6, 29719], [10, 29959], [17, 30359], [27, 30779], [30, 31139], [33, 31299], [37, 31419], [44, 31699], [47, 31919], [52, 32319], [57, 32639], [61, 32859], [67, 33039]]}, {"verse": 6, "start": 34222, "end": 38249, "text": "But now they break down the carved work of it at once with axes and hammers.", "words": [[0, 34222], [4, 34330], [8, 34510], [13, 34690], [19, 34970], [24, 35230], [28, 35430], [35, 35750], [40, 36050], [43, 36230], [46, 36330], [49, 36410], [54, 36730], [59, 36970], [64, 37350], [68, 37610]]}, {"verse": 7, "start": 38699, "end": 45828, "text": "They have cast fire into your sanctuary, they have defiled by casting down the dwelling place of your name to the ground.", "words": [[0, 38699], [5, 38900], [10, 39080], [15, 39440], [20, 39820], [25, 40120], [30, 40320], [41, 41440], [46, 41660], [51, 41800], [59, 42340], [62, 42560], [70, 43040], [75, 43380], [79, 43560], [88, 43880], [94, 44220], [97, 44440], [102, 44580], [107, 44900], [110, 45080], [114, 45220]]}, {"verse": 8, "start": 46278, "end": 53263, "text": "They said in their hearts, Let us destroy them together: they have burned up all the synagogues of God in the land.", "words": [[0, 46278], [5, 46658], [10, 46938], [13, 47138], [19, 47258], [27, 48156], [31, 48320], [34, 48460], [42, 48880], [47, 49100], [57, 50006], [62, 50123], [67, 50243], [74, 50563], [77, 50823], [81, 51163], [85, 51363], [96, 52043], [99, 52143], [103, 52443], [106, 52643], [110, 52763]]}, {"verse": 9, "start": 53713, "end": 60672, "text": "We see not our signs: there is no more any prophet: neither is there among us any that knows how long.", "words": [[0, 53713], [3, 53861], [7, 54121], [11, 54361], [15, 54561], [22, 55571], [28, 55695], [31, 55875], [34, 56075], [39, 56355], [43, 56858], [52, 57586], [60, 57873], [63, 58173], [69, 58373], [75, 58653], [78, 58933], [82, 59273], [87, 59533], [93, 59813], [97, 60093]]}, {"verse": 10, "start": 61122, "end": 66851, "text": "O God, how long shall the adversary reproach? shall the enemy blaspheme your name for ever?", "words": [[0, 61188], [2, 61268], [7, 62028], [11, 62168], [16, 62428], [22, 62628], [26, 62768], [36, 63368], [46, 64483], [52, 64643], [56, 64783], [62, 65043], [72, 65803], [77, 65923], [82, 66254], [86, 66584]]}, {"verse": 11, "start": 67301, "end": 71358, "text": "Why do you withdraw your hand, even your right hand? pluck it out of your bosom.", "words": [[0, 67301], [4, 67489], [7, 67629], [11, 67729], [20, 68089], [25, 68349], [31, 68849], [36, 68989], [41, 69209], [47, 69409], [53, 70172], [59, 70396], [62, 70496], [66, 70616], [69, 70756], [74, 70856]]}, {"verse": 12, "start": 71808, "end": 75832, "text": "For God is my King of old, working salvation in the midst of the earth.", "words": [[0, 71808], [4, 71908], [8, 72188], [11, 72428], [14, 72628], [19, 72908], [22, 73108], [27, 73508], [35, 73888], [45, 74508], [48, 74828], [52, 74908], [58, 75128], [61, 75348], [65, 75468]]}, {"verse": 13, "start": 76282, "end": 81165, "text": "You did divide the sea by your strength: you broke the heads of the dragons in the waters.", "words": [[0, 76282], [4, 76423], [8, 76663], [15, 77023], [19, 77283], [23, 77543], [26, 77783], [31, 77923], [41, 78772], [45, 78877], [51, 79117], [55, 79357], [61, 79577], [64, 79757], [68, 79857], [76, 80237], [79, 80477], [83, 80557]]}, {"verse": 14, "start": 81615, "end": 87263, "text": "You broke the heads of leviathan in pieces, and gave him to be food to the people inhabiting the wilderness.", "words": [[0, 81650], [4, 81700], [10, 81960], [14, 82160], [20, 82440], [23, 82640], [33, 83240], [36, 83400], [44, 83740], [48, 84280], [53, 84500], [57, 84660], [60, 84800], [63, 84940], [68, 85200], [71, 85400], [75, 85520], [82, 85760], [93, 86360], [97, 86520]]}, {"verse": 15, "start": 87713, "end": 91672, "text": "You did cleave the fountain and the flood: you dried up mighty rivers.", "words": [[0, 87713], [4, 87819], [8, 88039], [15, 88479], [19, 88599], [28, 88939], [32, 89179], [36, 89279], [43, 90082], [47, 90188], [53, 90448], [56, 90688], [63, 90948]]}, {"verse": 16, "start": 92122, "end": 98034, "text": "The day is yours, the night also is yours: you have prepared the light and the sun.", "words": [[0, 92122], [4, 92202], [8, 92422], [11, 92622], [18, 93542], [22, 93642], [28, 93882], [33, 94302], [36, 94602], [43, 95281], [47, 95941], [52, 96101], [61, 96461], [65, 96701], [71, 96961], [75, 97321], [79, 97481]]}, {"verse": 17, "start": 98484, "end": 103474, "text": "You have set all the borders of the earth: you have made summer and winter.", "words": [[0, 98484], [4, 98608], [9, 98768], [13, 99028], [17, 99308], [21, 99468], [29, 99808], [32, 100048], [36, 100188], [43, 100884], [47, 101009], [52, 101169], [57, 101369], [64, 101769], [68, 102089]]}, {"verse": 18, "start": 103924, "end": 109991, "text": "Remember this, that the enemy has reproached, O LORD, and that the foolish people have blasphemed your name.", "words": [[0, 103924], [9, 104201], [15, 104581], [20, 104841], [24, 104961], [30, 105221], [34, 105461], [46, 106121], [48, 106261], [54, 107001], [58, 107141], [63, 107301], [67, 107441], [75, 107721], [82, 108181], [87, 108421], [98, 109221], [103, 109421]]}, {"verse": 19, "start": 110441, "end": 117681, "text": "O deliver not the soul of your turtledove to the multitude of the wicked: forget not the congregation of your poor for ever.", "words": [[0, 110441], [2, 110585], [10, 110945], [14, 111205], [18, 111425], [23, 111705], [26, 111885], [31, 112005], [42, 112625], [45, 112805], [49, 112925], [59, 113345], [62, 113585], [66, 113705], [74, 114748], [81, 115028], [85, 115368], [89, 115588], [102, 116208], [105, 116508], [110, 116648], [115, 117012], [119, 117375]]}, {"verse": 20, "start": 118131, "end": 124584, "text": "Have respect to the covenant: for the dark places of the earth are full of the habitations of cruelty.", "words": [[0, 118131], [5, 118298], [13, 118698], [16, 119018], [20, 119138], [30, 120017], [34, 120104], [38, 120224], [43, 120504], [50, 120884], [53, 121144], [57, 121264], [63, 121484], [67, 121684], [72, 121924], [75, 122084], [79, 122184], [91, 122844], [94, 123004]]}, {"verse": 21, "start": 125034, "end": 130763, "text": "O let not the oppressed return ashamed: let the poor and needy praise your name.", "words": [[0, 125223], [2, 125453], [6, 125553], [10, 125853], [14, 126133], [24, 126513], [31, 127053], [40, 128167], [44, 128313], [48, 128513], [53, 128933], [57, 129153], [63, 129553], [70, 129893], [75, 130213]]}, {"verse": 22, "start": 131213, "end": 137257, "text": "Arise, O God, plead your own cause: remember how the foolish man reproaches you daily.", "words": [[0, 131213], [7, 131860], [9, 131940], [14, 132560], [20, 132740], [25, 133040], [29, 133220], [36, 134233], [45, 134479], [49, 134799], [53, 134959], [61, 135319], [65, 135739], [76, 136439], [80, 136699]]}, {"verse": 23, "start": 137707, "end": 143877, "text": "Forget not the voice of your enemies: the tumult of those that rise up against you increases continually.", "words": [[0, 137707], [7, 137956], [11, 138216], [15, 138396], [21, 138676], [24, 138876], [29, 138976], [38, 139974], [42, 140056], [49, 140556], [52, 140716], [58, 140936], [63, 141116], [68, 141396], [71, 141616], [79, 141956], [83, 142196], [93, 142796]]}]}