{"book": "LUK", "chapter": 3, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 325544, "verses": [{"verse": 1, "start": 300, "end": 16334, "text": "Y en el año quince del imperio de Tiberio César, siendo gobernador de Judea Poncio Pilato, y Herodes tetrarca de Galilea, y su hermano Felipe tetrarca de Iturea y de la provincia de Traconite, y Lisanias tetrarca de Abilinia,", "words": [[0, 300], [2, 445], [5, 545], [8, 645], [12, 925], [19, 1205], [23, 1585], [31, 2105], [34, 2245], [42, 2665], [49, 3605], [56, 3945], [67, 4925], [70, 5085], [76, 5565], [83, 5945], [91, 6505], [93, 7025], [101, 7545], [110, 8065], [113, 8205], [122, 9282], [124, 9403], [127, 9543], [135, 10003], [142, 10363], [151, 11123], [154, 11553], [161, 11983], [163, 12143], [166, 12223], [169, 12363], [179, 12983], [182, 13123], [193, 13843], [195, 14353], [204, 14863], [213, 15423], [216, 15563]]}, {"verse": 2, "start": 16784, "end": 25801, "text": "Siendo sumos sacerdotes Anás y Caifás, vino palabra del Señor sobre Juan, hijo de Zacarías, en el desierto.", "words": [[0, 16784], [7, 17328], [13, 17908], [24, 18488], [29, 19068], [31, 19588], [39, 20108], [44, 20568], [52, 21028], [56, 21388], [62, 21808], [68, 22208], [74, 23308], [79, 23548], [82, 24018], [92, 24488], [95, 24848], [98, 24988]]}, {"verse": 3, "start": 26251, "end": 34920, "text": "Y él vino por toda la tierra alrededor del Jordán predicando el bautismo del arrepentimiento para la remisión de pecados;", "words": [[0, 26251], [2, 26417], [5, 26577], [10, 26817], [14, 27097], [19, 27397], [22, 27637], [29, 28077], [39, 28657], [43, 29287], [50, 29917], [61, 30617], [64, 30737], [73, 31377], [77, 31577], [93, 32757], [98, 33057], [101, 33237], [110, 33857], [113, 34057]]}, {"verse": 4, "start": 35370, "end": 47229, "text": "Como está escrito en el libro de las palabras del profeta Isaías que dice: Voz del que clama en el desierto: Preparad el camino del Señor, haced derechas sus sendas.", "words": [[0, 35370], [5, 35514], [10, 35714], [18, 36094], [21, 36314], [24, 36474], [30, 36754], [33, 36974], [37, 37094], [46, 37474], [50, 37714], [58, 38194], [65, 38714], [69, 38874], [75, 39719], [79, 40126], [83, 40546], [87, 40786], [93, 41026], [96, 41266], [99, 41486], [109, 42979], [118, 43549], [121, 43749], [128, 44109], [132, 44369], [139, 45369], [145, 45739], [154, 46109], [158, 46349]]}, {"verse": 5, "start": 47679, "end": 58246, "text": "Todo valle se llenará, y se bajará todo monte y collado; y los caminos torcidos serán enderezados, y los caminos ásperos allanados;", "words": [[0, 47679], [5, 47943], [11, 48243], [14, 48403], [23, 48923], [25, 49323], [28, 49443], [35, 49883], [40, 50143], [46, 50603], [48, 51130], [57, 51885], [59, 51989], [63, 52129], [71, 52589], [80, 53209], [86, 54049], [99, 55049], [101, 55849], [105, 56009], [113, 56549], [121, 57424]]}, {"verse": 6, "start": 58696, "end": 61404, "text": "Y verá toda carne la salvación de Dios.", "words": [[0, 58696], [2, 58822], [7, 59122], [12, 59262], [18, 59942], [21, 60022], [31, 60662], [34, 60842]]}, {"verse": 7, "start": 61854, "end": 70940, "text": "Y decía a las multitudes que salían para ser bautizadas por él: ¡Oh generación de víboras, quién os enseñó a huir de la ira que vendrá?", "words": [[0, 61854], [2, 61981], [8, 62481], [10, 62921], [14, 63021], [25, 63741], [29, 64021], [36, 64521], [41, 64721], [45, 64981], [56, 66041], [60, 66301], [64, 66964], [68, 67044], [79, 67644], [82, 67804], [91, 68644], [97, 68814], [100, 68984], [107, 69424], [109, 69524], [114, 69784], [117, 69904], [120, 70024], [124, 70264], [128, 70364]]}, {"verse": 8, "start": 71390, "end": 83005, "text": "Haced, pues, frutos dignos de arrepentimiento, y no comencéis a decir en vosotros mismos: Tenemos a Abraham por padre: porque os digo que puede Dios, aun de estas piedras, levantar hijos a Abraham.", "words": [[0, 71390], [7, 71731], [13, 72201], [20, 72671], [27, 73091], [30, 73191], [47, 74071], [49, 74531], [52, 74851], [62, 75171], [64, 75311], [70, 75591], [73, 75751], [82, 76111], [90, 77065], [98, 77322], [100, 77562], [108, 77882], [112, 78142], [119, 78944], [126, 79144], [129, 79284], [134, 79464], [138, 79624], [144, 79864], [150, 80224], [154, 80604], [157, 80804], [163, 80984], [172, 81544], [181, 82064], [187, 82224], [189, 82464]]}, {"verse": 9, "start": 83455, "end": 93339, "text": "Y ya también el hacha está puesta a la raíz de los árboles: todo árbol pues que no hace buen fruto, es cortado, y echado en el fuego.", "words": [[0, 83455], [2, 83577], [5, 83717], [13, 84017], [16, 84217], [22, 84437], [27, 84596], [34, 85017], [36, 85116], [39, 85176], [44, 85496], [47, 85616], [51, 85717], [60, 86658], [65, 86878], [71, 87258], [76, 87498], [80, 87738], [83, 87938], [88, 88178], [93, 88419], [100, 88919], [103, 89279], [112, 89978], [114, 90298], [121, 90699], [124, 90818], [127, 90938]]}, {"verse": 10, "start": 93688, "end": 99661, "text": "Y la gente le preguntaba, diciendo: ¿Pues qué haremos?", "words": [[0, 93688], [2, 93795], [5, 93895], [11, 94215], [14, 94455], [26, 95155], [36, 96752], [42, 96891], [46, 97031]]}, {"verse": 11, "start": 100011, "end": 107170, "text": "Y respondiendo, les dijo: El que tiene dos túnicas, dé al que no tiene; y el que tiene qué comer, haga lo mismo.", "words": [[0, 100011], [2, 100116], [16, 101016], [20, 101096], [26, 101917], [29, 102034], [33, 102154], [39, 102414], [43, 102654], [52, 103194], [55, 103714], [58, 103874], [62, 104014], [65, 104154], [72, 104898], [74, 104994], [77, 105094], [81, 105194], [87, 105474], [91, 105654], [98, 106454], [103, 106574], [106, 106714]]}, {"verse": 12, "start": 107520, "end": 115223, "text": "Y vinieron también recaudadores de impuestos para ser bautizados, y le dijeron: Maestro, ¿qué haremos?", "words": [[0, 107520], [2, 107621], [11, 108061], [19, 108461], [32, 109521], [35, 109721], [45, 110241], [50, 110481], [54, 111131], [66, 111781], [68, 111881], [71, 112001], [80, 113033], [89, 113710], [94, 113810]]}, {"verse": 13, "start": 115573, "end": 119616, "text": "Y él les dijo: No exijáis más de lo que os está ordenado.", "words": [[0, 115573], [2, 115779], [5, 115959], [9, 116259], [15, 117105], [18, 117289], [26, 117869], [30, 118069], [33, 118289], [36, 118409], [40, 118569], [43, 118709], [48, 118969]]}, {"verse": 14, "start": 119966, "end": 131589, "text": "Y le preguntaron también los soldados, diciendo: Y nosotros, ¿qué haremos? Y les dice: No hagáis extorsión a nadie, ni calumniéis; y contentaos con vuestras pagas.", "words": [[0, 119966], [2, 120090], [5, 120190], [17, 120890], [25, 121210], [29, 121470], [39, 122470], [49, 123451], [51, 123551], [61, 124351], [66, 124451], [75, 125440], [77, 125584], [81, 125942], [87, 126507], [90, 126685], [97, 127005], [107, 127665], [109, 127745], [116, 128065], [119, 128505], [131, 129696], [133, 130022], [144, 130382], [148, 130622], [157, 130962]]}, {"verse": 15, "start": 131939, "end": 139765, "text": "Y estando el pueblo esperando, y pensando todos de Juan en sus corazones, si él fuese el Cristo,", "words": [[0, 131939], [2, 132063], [10, 132403], [13, 132743], [20, 133103], [31, 133703], [33, 134463], [42, 134923], [48, 135483], [51, 135763], [56, 136103], [59, 136283], [63, 136483], [74, 137843], [77, 138203], [80, 138423], [86, 138803], [89, 138983]]}, {"verse": 16, "start": 140215, "end": 153744, "text": "Respondió Juan, diciendo a todos: Yo, a la verdad, os bautizo en agua; pero viene quien es más poderoso que yo, de quien no soy digno de desatar la correa de sus zapatos: él os bautizará en Espíritu Santo y fuego;", "words": [[0, 140478], [10, 140778], [16, 141198], [25, 141818], [27, 142198], [34, 143117], [38, 143316], [40, 143456], [43, 143536], [51, 143856], [54, 144136], [62, 144596], [65, 144776], [71, 145457], [76, 145602], [82, 145882], [88, 146062], [91, 146262], [95, 146402], [104, 146982], [108, 147162], [112, 147602], [115, 147862], [121, 148042], [124, 148262], [128, 148462], [134, 148882], [137, 148922], [145, 149322], [148, 149522], [155, 149882], [158, 150002], [162, 150142], [171, 151149], [174, 151293], [177, 151393], [187, 152073], [190, 152133], [199, 152693], [205, 152993], [207, 153233]]}, {"verse": 17, "start": 154194, "end": 163824, "text": "Cuya horquilla para aventar está en su mano, y limpiará su lugar de trilla, y juntará el trigo en su granero, y la paja quemará en fuego que nunca se apagará.", "words": [[0, 154194], [5, 154423], [15, 154843], [20, 155083], [28, 155603], [33, 155823], [36, 155983], [39, 156123], [45, 156423], [47, 156983], [56, 157483], [59, 157603], [65, 157903], [68, 158063], [76, 158463], [78, 158963], [86, 159383], [89, 159523], [95, 159843], [98, 159943], [101, 160063], [110, 160882], [112, 160984], [115, 161104], [120, 161464], [128, 161924], [131, 162084], [137, 162364], [141, 162684], [147, 162944], [150, 163244]]}, {"verse": 18, "start": 164174, "end": 168844, "text": "Y amonestando, otras muchas cosas también anunciaba al pueblo.", "words": [[0, 164174], [2, 164320], [15, 165140], [21, 165520], [28, 165920], [34, 166420], [42, 166880], [52, 167800], [55, 168100]]}, {"verse": 19, "start": 169294, "end": 180986, "text": "Entonces Herodes el tetrarca, siendo reprendido por él a causa de Herodías, mujer de Felipe su hermano, y de todas las maldades que había hecho Herodes,", "words": [[0, 169294], [9, 170096], [17, 171016], [20, 171686], [30, 172356], [37, 172736], [48, 173536], [52, 173776], [55, 173976], [57, 174196], [63, 174536], [66, 174856], [76, 175996], [82, 176296], [85, 176536], [92, 176876], [95, 177156], [104, 177956], [106, 178116], [109, 178256], [115, 178536], [119, 178836], [128, 179436], [132, 179636], [138, 179916], [144, 180196]]}, {"verse": 20, "start": 181436, "end": 185649, "text": "Añadió también esto sobre todo, que encerró a Juan en la cárcel.", "words": [[0, 181436], [7, 181922], [15, 182242], [20, 182742], [26, 183062], [32, 183402], [36, 183662], [44, 184222], [46, 184382], [51, 184642], [54, 184922], [57, 185062]]}, {"verse": 21, "start": 186099, "end": 194954, "text": "Y aconteció que, como todo el pueblo se bautizaba, también Jesús fue bautizado; y orando, el cielo se abrió,", "words": [[0, 186099], [2, 186390], [12, 187070], [17, 187250], [22, 187510], [27, 187810], [30, 188050], [37, 188390], [40, 188630], [51, 189410], [59, 189710], [65, 190210], [69, 190870], [80, 192753], [82, 193207], [90, 193660], [93, 193780], [99, 194140], [102, 194380]]}, {"verse": 22, "start": 195404, "end": 207292, "text": "Y descendió el Espíritu Santo sobre él en forma corporal, como paloma, y fue hecha una voz del cielo que decía: Tú eres mi Hijo amado, en ti me he complacido.", "words": [[0, 195404], [2, 195528], [12, 196068], [15, 196188], [24, 196668], [30, 197008], [36, 197448], [39, 197708], [42, 197828], [48, 198068], [58, 198928], [63, 199428], [71, 199988], [73, 200668], [77, 200888], [83, 201348], [87, 201488], [91, 201708], [95, 201868], [101, 202288], [105, 202528], [112, 203449], [115, 203612], [120, 203992], [123, 204352], [128, 204572], [135, 205432], [138, 205572], [141, 205832], [144, 206132], [147, 206252]]}, {"verse": 23, "start": 207642, "end": 215737, "text": "Y el mismo Jesús comenzaba a ser como de treinta años, hijo de José, como se creía; que fue hijo de Elí,", "words": [[0, 207642], [2, 207762], [5, 207882], [11, 208202], [17, 208642], [27, 209602], [29, 209822], [33, 210122], [38, 210382], [41, 210702], [49, 211022], [55, 211822], [60, 212042], [63, 212202], [69, 213002], [74, 213142], [77, 213342], [84, 214320], [88, 214404], [92, 214644], [97, 215084], [100, 215304]]}, {"verse": 24, "start": 216187, "end": 222248, "text": "Que fue de Matat, que fue de Leví, que fue de Melqui, que fue de Jana, que fue de José,", "words": [[0, 216187], [4, 216291], [8, 216511], [11, 216671], [18, 217671], [22, 217731], [26, 217931], [29, 218071], [35, 218891], [39, 218951], [43, 219131], [46, 219271], [54, 220211], [58, 220211], [62, 220391], [65, 220861], [71, 221331], [75, 221351], [79, 221551], [82, 221691]]}, {"verse": 25, "start": 222698, "end": 228576, "text": "Que fue de Matatías, que fue de Amós, que fue de Nahum, que fue de Esli,", "words": [[0, 222698], [4, 222782], [8, 222982], [11, 223142], [21, 224582], [25, 224602], [29, 224822], [32, 224982], [38, 225982], [42, 225982], [46, 226162], [49, 226752], [56, 227342], [60, 227382], [64, 227602], [67, 227782]]}, {"verse": 26, "start": 229026, "end": 237091, "text": "Que fue de Nagai, que fue de Maat, que fue de Matatías, que fue de Simei, que fue de José, que fue de Judá,", "words": [[0, 229026], [4, 229129], [8, 229349], [11, 229969], [18, 230589], [22, 230609], [26, 230829], [29, 231349], [35, 231869], [39, 231969], [43, 232149], [46, 232269], [56, 233509], [60, 233529], [64, 233729], [67, 233849], [74, 234929], [78, 234949], [82, 235129], [85, 235269], [91, 236089], [95, 236169], [99, 236369], [102, 236509]]}, {"verse": 27, "start": 237541, "end": 243808, "text": "Que fue de Joana, que fue de Resa, que fue de Zorobabel, que fue de Salatiel,", "words": [[0, 237541], [4, 237645], [8, 237845], [11, 238005], [18, 238725], [22, 238725], [26, 238905], [29, 239545], [35, 240185], [39, 240185], [43, 240365], [46, 241095], [57, 241825], [61, 241845], [65, 242045], [68, 242185]]}, {"verse": 28, "start": 244258, "end": 253063, "text": "Que fue de Neri, que fue de Melqui, que fue de Abdi, que fue de Cosam, que fue de Elmodam, que fue de Er,", "words": [[0, 244258], [4, 244362], [8, 244602], [11, 244762], [17, 245822], [21, 245842], [25, 246102], [28, 246242], [36, 247282], [40, 247342], [44, 247582], [47, 248102], [53, 248622], [57, 248722], [61, 248902], [64, 249552], [71, 250202], [75, 250242], [79, 250442], [82, 250602], [91, 252102], [95, 252142], [99, 252362], [102, 252602]]}, {"verse": 29, "start": 253513, "end": 258782, "text": "Que fue de Josué, que fue de Eliezer, que fue de Jorim, que fue de Matat,", "words": [[0, 253513], [4, 253618], [8, 253798], [11, 253938], [18, 254858], [22, 254858], [26, 255058], [29, 255198], [38, 256358], [42, 256418], [46, 256598], [49, 257208], [56, 257818], [60, 257838], [64, 257998], [67, 258138]]}, {"verse": 30, "start": 259232, "end": 266960, "text": "Que fue de Leví, que fue de Simeón, que fue de Judá, que fue de José, que fue de Jonán, que fue de Eliaquim,", "words": [[0, 259232], [4, 259335], [8, 259555], [11, 259715], [17, 260635], [21, 260655], [25, 260855], [28, 260995], [36, 262055], [40, 262115], [44, 262295], [47, 262415], [53, 263235], [57, 263235], [61, 263415], [64, 263515], [70, 264155], [74, 264175], [78, 264355], [81, 264925], [88, 265495], [92, 265515], [96, 265695], [99, 266328]]}, {"verse": 31, "start": 267410, "end": 272982, "text": "Que fue de Melea, que fue de Mainán, que fue de Matata, que fue de Natán,", "words": [[0, 267410], [4, 267512], [8, 267712], [11, 267872], [18, 268932], [22, 268932], [26, 269132], [29, 269252], [37, 269892], [41, 269912], [45, 270072], [48, 270212], [56, 271112], [60, 271112], [64, 271312], [67, 271432]]}, {"verse": 32, "start": 273432, "end": 282405, "text": "Que fue de David, que fue de Isaí, que fue de Obed, que fue de Booz, que fue de Salmón, que fue de Naassón,", "words": [[0, 273432], [4, 273517], [8, 273717], [11, 273897], [18, 274917], [22, 274937], [26, 275137], [29, 275277], [35, 276517], [39, 276537], [43, 276717], [46, 276877], [52, 277797], [56, 278017], [60, 278197], [63, 278817], [69, 279437], [73, 279537], [77, 279737], [80, 279877], [88, 281097], [92, 281117], [96, 281317], [99, 281891]]}, {"verse": 33, "start": 282855, "end": 288852, "text": "Que fue de Aminadab, que fue de Aram, que fue de Esrom, que fue de Fares,", "words": [[0, 282855], [4, 282939], [8, 283199], [11, 283379], [21, 284719], [25, 284779], [29, 285039], [32, 285199], [38, 286199], [42, 286239], [46, 286439], [49, 286599], [56, 287719], [60, 287759], [64, 287959], [67, 288099]]}, {"verse": 34, "start": 289302, "end": 297440, "text": "Que fue de Judá, que fue de Jacob, que fue de Isaac, que fue de Abraham, que fue de Taré, que fue de Nacor,", "words": [[0, 289302], [4, 289385], [8, 289585], [11, 289725], [17, 290605], [21, 290605], [25, 290805], [28, 290925], [35, 292085], [39, 292145], [43, 292345], [46, 292485], [53, 293505], [57, 293525], [61, 293725], [64, 293905], [73, 295205], [77, 295225], [81, 295385], [84, 295525], [90, 296345], [94, 296485], [98, 296645], [101, 297069]]}, {"verse": 35, "start": 297890, "end": 302546, "text": "Que fue de Serug, que fue de Ragau, que fue de Peleg, que fue de Heber,", "words": [[0, 297890], [4, 297976], [8, 298176], [11, 299256], [18, 300336], [22, 300356], [26, 300536], [29, 300876], [36, 301216], [40, 301556], [44, 301776], [47, 301908], [54, 302041], [58, 302173], [62, 302306], [65, 302438]]}, {"verse": 36, "start": 302996, "end": 310985, "text": "Que fue de Sala, que fue de Cainán, que fue de Arfaxad, que fue de Sem, que fue de Noé, que fue de Lamec,", "words": [[0, 302996], [4, 303078], [8, 303258], [11, 303398], [17, 304478], [21, 304498], [25, 304698], [28, 305338], [36, 305978], [40, 305978], [44, 306178], [47, 306858], [56, 307538], [60, 307618], [64, 307778], [67, 307918], [72, 308778], [76, 308878], [80, 309058], [83, 309198], [88, 310018], [92, 310078], [96, 310278], [99, 310378]]}, {"verse": 37, "start": 311435, "end": 317960, "text": "Que fue de Matusalén, que fue de Enoc, que fue de Jared, que fue de Mahalaleel,", "words": [[0, 311435], [4, 311539], [8, 311719], [11, 311879], [22, 313299], [26, 313299], [30, 313559], [33, 314209], [39, 314859], [43, 314859], [47, 315059], [50, 315199], [57, 316019], [61, 316119], [65, 316339], [68, 317149]]}, {"verse": 38, "start": 318410, "end": 325144, "text": "Que fue de Cainán, que fue de Enós, que fue de Set, que fue de Adam, que fue de Dios.", "words": [[0, 318410], [4, 318492], [8, 318712], [11, 318892], [19, 320032], [23, 320032], [27, 320272], [30, 320432], [36, 321472], [40, 321492], [44, 321712], [47, 321872], [52, 322812], [56, 322912], [60, 323072], [63, 323232], [69, 324132], [73, 324172], [77, 324352], [80, 324512]]}]}