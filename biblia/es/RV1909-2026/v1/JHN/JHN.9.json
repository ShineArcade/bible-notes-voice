{"book": "JHN", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 320286, "verses": [{"verse": 1, "start": 300, "end": 5202, "text": "Y pasando Jesús, vio un hombre ciego desde su nacimiento.", "words": [[0, 300], [2, 404], [10, 764], [17, 2044], [21, 2504], [24, 2684], [31, 2924], [37, 3504], [43, 3764], [46, 4104]]}, {"verse": 2, "start": 5652, "end": 12700, "text": "Y le preguntaron sus discípulos, diciendo: Rabí, ¿quién pecó, este o sus padres, para que naciese ciego?", "words": [[0, 5652], [2, 5777], [5, 5917], [17, 6817], [21, 7097], [33, 8177], [43, 9238], [49, 9540], [56, 9740], [62, 10120], [67, 10400], [69, 10520], [73, 10680], [81, 11320], [86, 11540], [90, 11840], [98, 12140]]}, {"verse": 3, "start": 13050, "end": 20339, "text": "Respondió Jesús: Ni este pecó, ni sus padres: pero para que las obras de Dios se manifiesten en él.", "words": [[0, 13050], [10, 13554], [17, 14576], [20, 14876], [25, 15266], [31, 15656], [34, 15827], [38, 15998], [46, 17433], [51, 17733], [56, 17953], [60, 18093], [64, 18253], [70, 18553], [73, 18733], [78, 18973], [81, 19173], [93, 19833], [96, 19973]]}, {"verse": 4, "start": 20789, "end": 28151, "text": "Debo realizar las obras del que me envió, entre tanto que el día dura: la noche viene, cuando nadie puede obrar.", "words": [[0, 20789], [5, 21093], [14, 21573], [18, 21873], [24, 22153], [28, 22353], [32, 22513], [35, 22673], [42, 23433], [48, 23833], [54, 24213], [58, 24433], [61, 24633], [65, 24813], [71, 25673], [74, 25790], [80, 26010], [87, 26370], [94, 26610], [100, 27090], [106, 27410]]}, {"verse": 5, "start": 28601, "end": 31892, "text": "Entre tanto que estoy en el mundo, luz soy del mundo.", "words": [[0, 28601], [6, 28822], [12, 29202], [16, 29422], [22, 29702], [25, 29942], [28, 30062], [35, 30352], [39, 30642], [43, 30982], [47, 31202]]}, {"verse": 6, "start": 32342, "end": 40631, "text": "Esto dicho, escupió en tierra, e hizo lodo con la saliva, y untó con el lodo sobre los ojos del ciego,", "words": [[0, 32342], [5, 32730], [12, 33270], [20, 33770], [23, 33950], [31, 34330], [33, 34990], [38, 35330], [43, 35730], [47, 35990], [50, 36150], [58, 36610], [60, 37230], [65, 37570], [69, 37770], [72, 37930], [77, 38350], [83, 38630], [87, 38870], [92, 39190], [96, 39470]]}, {"verse": 7, "start": 41081, "end": 50005, "text": "Y le dijo: Ve, lávate en el estanque de Siloé (que traducido significa Enviado). Y fue entonces, y se lavó, y volvió viendo.", "words": [[0, 41144], [2, 41244], [5, 41343], [11, 41672], [15, 41672], [22, 42198], [25, 42438], [28, 42558], [37, 43078], [40, 43238], [46, 44144], [51, 44229], [61, 44909], [71, 45449], [81, 46589], [83, 46716], [87, 46876], [97, 47536], [99, 48096], [102, 48236], [108, 48896], [110, 49056], [117, 49776]]}, {"verse": 8, "start": 50455, "end": 57974, "text": "Entonces los vecinos, y los que antes le habían visto que era ciego, decían: ¿No es este el que se sentaba y mendigaba?", "words": [[0, 50455], [9, 50903], [13, 51183], [22, 51703], [24, 51863], [28, 51983], [32, 52143], [38, 52383], [41, 52623], [48, 52863], [54, 53143], [58, 53363], [62, 53503], [69, 53983], [77, 55319], [81, 55477], [84, 55657], [89, 56037], [92, 56177], [96, 56297], [99, 56417], [107, 56957], [109, 57237]]}, {"verse": 9, "start": 58324, "end": 64999, "text": "Unos decían: Este es; y otros: A él se parece. Él decía: Yo soy.", "words": [[0, 58410], [5, 58530], [13, 59839], [18, 60115], [22, 60742], [24, 60879], [31, 61777], [33, 61941], [36, 62141], [39, 62341], [47, 63321], [50, 63492], [57, 64348], [60, 64569]]}, {"verse": 10, "start": 65349, "end": 68539, "text": "Y le dijeron: ¿Cómo te fueron abiertos los ojos?", "words": [[0, 65349], [2, 65497], [5, 65577], [14, 66590], [20, 66746], [23, 66926], [30, 67206], [39, 67786], [43, 67926]]}, {"verse": 11, "start": 68889, "end": 80735, "text": "Respondió él y dijo: El hombre que se llama Jesús, hizo lodo, y me untó los ojos, y me dijo: Ve al Siloé, y lávate: y fui, y me lavé, y recibí la vista.", "words": [[0, 68889], [10, 69573], [13, 69893], [15, 70133], [21, 70972], [24, 71112], [31, 71392], [35, 71592], [38, 71752], [44, 72012], [51, 72552], [56, 73092], [62, 73632], [64, 73912], [67, 74012], [72, 74272], [76, 74472], [82, 74712], [84, 74932], [87, 75052], [93, 75806], [96, 75964], [99, 76164], [106, 76584], [108, 76824], [116, 77683], [118, 77805], [123, 78025], [125, 78305], [128, 78405], [134, 78725], [136, 78925], [143, 79345], [146, 79425]]}, {"verse": 12, "start": 81085, "end": 86170, "text": "Entonces le dijeron: ¿Dónde está aquel? Él dijo: No sé.", "words": [[0, 81085], [9, 81533], [12, 81793], [21, 82746], [28, 83008], [33, 83268], [40, 84698], [43, 84908], [49, 85659], [52, 85817]]}, {"verse": 13, "start": 86520, "end": 90275, "text": "Llevaron a los fariseos al que antes había sido ciego.", "words": [[0, 86520], [9, 87067], [11, 87367], [15, 87527], [24, 87977], [27, 88427], [31, 88607], [37, 88847], [43, 89187], [48, 89527]]}, {"verse": 14, "start": 90725, "end": 96161, "text": "Y era sábado cuando Jesús había hecho el lodo, y le había abierto los ojos.", "words": [[0, 90725], [2, 91023], [6, 91203], [13, 91743], [20, 92003], [26, 92403], [32, 92923], [38, 93303], [41, 93503], [47, 93943], [49, 94403], [52, 94503], [58, 94763], [66, 95203], [70, 95443]]}, {"verse": 15, "start": 96611, "end": 107737, "text": "Y le volvieron a preguntar también los fariseos de qué manera había recibido la vista. Y él les dijo: Me puso lodo sobre los ojos, y me lavé, y veo.", "words": [[0, 96611], [2, 96752], [5, 96852], [15, 97412], [17, 97512], [27, 98192], [35, 98552], [39, 99092], [48, 99912], [51, 100092], [55, 100352], [62, 100732], [68, 101292], [77, 101992], [80, 102132], [87, 103052], [89, 103402], [92, 103562], [96, 103782], [102, 104676], [105, 104793], [110, 105133], [115, 105433], [121, 105713], [125, 105913], [131, 106273], [133, 106573], [136, 106693], [142, 107053], [144, 107333]]}, {"verse": 16, "start": 108087, "end": 121440, "text": "Entonces unos de los fariseos decían: Este hombre no es de Dios, que no guarda el sábado. Otros decían: ¿Cómo puede un hombre pecador hacer estas señales? Y había división entre ellos.", "words": [[0, 108087], [9, 108811], [14, 109571], [17, 109711], [21, 109831], [30, 110451], [38, 111526], [43, 111768], [50, 112068], [53, 112308], [56, 112448], [59, 112568], [65, 113208], [69, 113288], [72, 113448], [79, 113888], [82, 113928], [90, 114818], [96, 115189], [104, 116467], [110, 116646], [116, 117006], [119, 117166], [126, 117386], [134, 117906], [140, 118166], [146, 118406], [155, 119487], [157, 119651], [163, 119851], [172, 120451], [178, 120691]]}, {"verse": 17, "start": 121890, "end": 129306, "text": "Vuelven a decir al ciego: ¿Tú, qué dices del que te abrió los ojos? Y él dijo: Que es profeta.", "words": [[0, 121890], [8, 122357], [10, 122457], [16, 122737], [19, 122957], [26, 123837], [31, 123957], [35, 124057], [41, 124377], [45, 124537], [49, 124697], [52, 124817], [58, 125077], [62, 125237], [68, 126147], [70, 126336], [73, 126496], [79, 127264], [83, 127386], [86, 127546]]}, {"verse": 18, "start": 129656, "end": 139568, "text": "Pero los judíos no creían de él, que había sido ciego, y hubiese recibido la vista, hasta que llamaron a los padres del que había recibido la vista;", "words": [[0, 129656], [5, 129800], [9, 130000], [16, 130560], [19, 130960], [26, 131520], [29, 131760], [33, 132440], [37, 132680], [43, 132860], [48, 133200], [55, 133740], [57, 134120], [65, 134400], [74, 135040], [77, 135160], [84, 135800], [90, 136120], [94, 136260], [103, 136700], [105, 136840], [109, 136960], [116, 137420], [120, 137840], [124, 138020], [130, 138240], [139, 138860], [142, 138980]]}, {"verse": 19, "start": 140018, "end": 147795, "text": "Y les preguntaron, diciendo: ¿Es este vuestro hijo, el que vosotros decís que nació ciego? ¿Cómo, pues, ve ahora?", "words": [[0, 140018], [2, 140249], [6, 140349], [19, 141129], [29, 142588], [33, 142765], [38, 143025], [46, 143405], [52, 144085], [55, 144165], [59, 144285], [68, 144705], [74, 145245], [78, 145405], [84, 145725], [91, 146645], [98, 146804], [104, 147284], [107, 147344]]}, {"verse": 20, "start": 148145, "end": 154060, "text": "Les respondieron sus padres y dijeron: Sabemos que este es nuestro hijo, y que nació ciego:", "words": [[0, 148145], [4, 148444], [17, 149384], [21, 149564], [28, 149964], [30, 150244], [39, 151218], [47, 151623], [51, 151863], [56, 152063], [59, 152203], [67, 152343], [73, 152843], [75, 153143], [79, 153243], [85, 153543]]}, {"verse": 21, "start": 154510, "end": 167613, "text": "Pero cómo vea ahora, no sabemos; o quién le haya abierto los ojos, nosotros no lo sabemos; él ya es adulto, preguntadle a él; él hablará de sí.", "words": [[0, 154510], [5, 154636], [10, 154896], [14, 155236], [21, 155556], [24, 155636], [33, 156591], [35, 156690], [41, 156890], [44, 157090], [49, 157250], [57, 157650], [61, 157830], [67, 158470], [76, 158870], [79, 159070], [82, 159170], [91, 160108], [94, 160270], [97, 160450], [100, 160590], [108, 161110], [120, 161630], [122, 161770], [126, 162305], [129, 162463], [137, 162823], [140, 162943]]}, {"verse": 22, "start": 167963, "end": 180776, "text": "Esto dijeron sus padres, porque tenían miedo de los judíos: porque ya los judíos habían resuelto que si alguno confesase ser él el Mesías, fuese expulsado de la sinagoga.", "words": [[0, 167963], [5, 168288], [13, 168908], [17, 169048], [25, 170088], [32, 170468], [39, 170908], [45, 171548], [48, 171768], [52, 171928], [60, 173088], [67, 173270], [70, 173530], [74, 173690], [81, 174270], [88, 174510], [97, 175190], [101, 175330], [104, 175470], [111, 175950], [121, 176670], [125, 177030], [128, 177370], [131, 177570], [139, 178150], [145, 178900], [155, 179650], [158, 179830], [161, 179930]]}, {"verse": 23, "start": 181226, "end": 187740, "text": "Por eso dijeron sus padres: Ya es adulto, preguntadle a él.", "words": [[0, 181226], [4, 181332], [8, 181512], [16, 182052], [20, 182192], [28, 183247], [31, 183410], [34, 183570], [42, 184080], [54, 184590], [56, 184710]]}, {"verse": 24, "start": 188090, "end": 199540, "text": "Así que, volvieron a llamar al hombre que había sido ciego, y le dijeron: Da gloria a Dios: nosotros sabemos que este hombre es pecador.", "words": [[0, 188090], [4, 188330], [9, 188570], [19, 189170], [21, 189310], [28, 189690], [31, 189810], [38, 190070], [42, 190270], [48, 190510], [53, 190830], [60, 191430], [62, 191990], [65, 192130], [74, 193155], [77, 193351], [84, 193771], [86, 193931], [92, 194745], [101, 195150], [109, 195450], [113, 195770], [118, 195990], [125, 196250], [128, 196470]]}, {"verse": 25, "start": 199890, "end": 208697, "text": "Entonces él respondió, y dijo: Si es pecador, no lo sé: una cosa sé, que habiendo yo sido ciego, ahora veo.", "words": [[0, 199890], [9, 200854], [12, 201274], [23, 202294], [25, 202554], [31, 203373], [34, 203548], [37, 203788], [46, 204268], [49, 204388], [52, 204508], [56, 205194], [60, 205381], [65, 205681], [69, 206441], [73, 206521], [82, 206881], [85, 207081], [90, 207301], [97, 208081], [103, 208221]]}, {"verse": 26, "start": 209047, "end": 212942, "text": "Y le volvieron a decir: ¿Qué te hizo? ¿Cómo te abrió los ojos?", "words": [[0, 209047], [2, 209174], [5, 209274], [15, 209814], [17, 209934], [24, 210736], [29, 210836], [32, 210976], [38, 211699], [44, 211841], [47, 212001], [53, 212221], [57, 212361]]}, {"verse": 27, "start": 213292, "end": 221431, "text": "Les respondió: Ya os lo he dicho, y no habéis atendido: ¿por qué lo queréis otra vez oír? ¿queréis también vosotros haceros sus discípulos?", "words": [[0, 213292], [4, 213445], [15, 214539], [18, 214756], [21, 214896], [24, 215036], [27, 215136], [34, 215396], [36, 215756], [39, 215896], [46, 216136], [56, 217015], [61, 217132], [65, 217292], [68, 217432], [76, 217732], [81, 217952], [85, 218212], [90, 218942], [99, 219264], [107, 219484], [116, 220044], [124, 220504], [128, 220624]]}, {"verse": 28, "start": 221781, "end": 228811, "text": "Y le ultrajaron, y dijeron: Tú eres su discípulo; pero nosotros discípulos de Moisés somos.", "words": [[0, 221781], [2, 221963], [5, 222533], [17, 223103], [19, 223823], [28, 224806], [31, 224934], [36, 225114], [39, 225354], [50, 226428], [55, 226570], [64, 226910], [75, 227630], [78, 227790], [85, 228150]]}, {"verse": 29, "start": 229261, "end": 233985, "text": "Nosotros sabemos que a Moisés habló Dios: pero este no sabemos de dónde es.", "words": [[0, 229261], [9, 229707], [17, 230067], [21, 230347], [23, 230447], [30, 230767], [36, 231247], [42, 232000], [47, 232141], [52, 232421], [55, 232621], [63, 232961], [66, 233261], [72, 233441]]}, {"verse": 30, "start": 234335, "end": 243170, "text": "Respondió aquel hombre, y les dijo: Por cierto, maravillosa cosa es esta, que vosotros no sabéis de dónde sea, y a mí me abrió los ojos.", "words": [[0, 234335], [10, 235059], [16, 235259], [24, 235519], [26, 235819], [30, 235979], [36, 236818], [40, 236925], [48, 237445], [60, 238005], [65, 238205], [68, 238565], [74, 239305], [78, 239385], [87, 239805], [90, 240005], [97, 240385], [100, 240525], [106, 240685], [111, 241625], [113, 241725], [115, 241785], [118, 241905], [121, 242045], [127, 242385], [131, 242545]]}, {"verse": 31, "start": 243620, "end": 250462, "text": "Y sabemos que Dios no oye a los pecadores: pero si alguno es temeroso de Dios, y hace su voluntad, a este oye.", "words": [[0, 243620], [2, 243704], [10, 243964], [14, 244264], [19, 244524], [22, 244904], [26, 245164], [28, 245244], [32, 245344], [43, 246523], [48, 246689], [51, 246869], [58, 247329], [61, 247509], [70, 247949], [73, 248129], [79, 248369], [81, 248689], [86, 248889], [89, 249069], [99, 249649], [101, 249749], [106, 249989]]}, {"verse": 32, "start": 250912, "end": 256145, "text": "Desde el principio del mundo no fue oído, que abriese alguno los ojos de uno que nació ciego.", "words": [[0, 250912], [6, 251097], [9, 251297], [19, 251737], [23, 251957], [29, 252217], [32, 252417], [36, 252657], [42, 253317], [46, 253517], [54, 253867], [61, 254217], [65, 254397], [70, 254677], [73, 254917], [77, 255117], [81, 255277], [87, 255617]]}, {"verse": 33, "start": 256595, "end": 259797, "text": "Si este no fuera de Dios, no pudiera hacer nada.", "words": [[0, 256595], [3, 256728], [8, 257048], [11, 257248], [17, 257488], [20, 257668], [26, 258368], [29, 258648], [37, 259048], [43, 259308]]}, {"verse": 34, "start": 260147, "end": 267414, "text": "Respondieron, y le dijeron: Tú naciste enteramente en pecado, ¿y tú nos enseñas? Y le echaron fuera.", "words": [[0, 260147], [14, 260951], [16, 261371], [19, 261491], [28, 262422], [31, 262524], [39, 262984], [51, 263564], [54, 263744], [62, 264184], [65, 264564], [68, 264704], [72, 264864], [81, 265980], [83, 266128], [86, 266268], [94, 266748]]}, {"verse": 35, "start": 267864, "end": 274942, "text": "Oyó Jesús que le habían echado fuera; y hallándole, le dijo: ¿Crees tú en el Hijo de Dios?", "words": [[0, 268023], [4, 268213], [10, 269213], [14, 269293], [17, 269433], [24, 269713], [31, 270113], [38, 271122], [40, 271240], [52, 271780], [55, 271900], [61, 272989], [68, 273274], [71, 273574], [74, 273874], [77, 273994], [82, 274214], [85, 274414]]}, {"verse": 36, "start": 275392, "end": 279427, "text": "Respondió él, y dijo: ¿Quién es, Señor, para que crea en él?", "words": [[0, 275392], [10, 276016], [14, 276396], [16, 276676], [22, 277515], [29, 277651], [33, 277771], [40, 278131], [45, 278551], [49, 278691], [54, 279031], [57, 279171]]}, {"verse": 37, "start": 279777, "end": 285450, "text": "Y le dijo Jesús: Y le has visto, y el que habla contigo, él es.", "words": [[0, 279777], [2, 279904], [5, 280004], [10, 280284], [17, 281474], [19, 281614], [22, 281694], [26, 281874], [33, 282274], [35, 282974], [38, 283114], [42, 283294], [48, 283574], [57, 284514], [60, 284874]]}, {"verse": 38, "start": 285900, "end": 292148, "text": "Y él dice: Creo, Señor; y le adoró.", "words": [[0, 285900], [2, 286096], [5, 286256], [11, 287000], [17, 287297], [24, 291187], [26, 291369], [29, 291489]]}, {"verse": 39, "start": 292598, "end": 301262, "text": "Y dijo Jesús: Yo, para juicio he venido a este mundo: para que los que no ven, vean; y los que ven, sean cegados.", "words": [[0, 292598], [2, 292857], [7, 293077], [14, 294035], [18, 294242], [23, 294502], [30, 295062], [33, 295302], [40, 295702], [42, 295802], [47, 295982], [54, 296871], [59, 297037], [63, 297177], [67, 297317], [71, 297457], [74, 297617], [79, 297857], [85, 299118], [87, 299197], [91, 299317], [95, 299497], [100, 299737], [105, 300277]]}, {"verse": 40, "start": 301712, "end": 310158, "text": "Y ciertos de los fariseos que estaban con él oyeron esto, y le dijeron: ¿Somos nosotros también ciegos?", "words": [[0, 301712], [2, 301875], [10, 302435], [13, 302535], [17, 302655], [26, 303475], [30, 303635], [38, 303935], [42, 304255], [45, 304455], [52, 305175], [58, 305635], [60, 305975], [63, 306115], [72, 307043], [79, 307448], [88, 307788], [96, 308128]]}, {"verse": 41, "start": 310508, "end": 319886, "text": "Jesús les respondió: Si fuerais ciegos, no tuvierais pecado: pero ahora porque decís, Vemos, por tanto vuestro pecado permanece.", "words": [[0, 310508], [6, 310816], [10, 311136], [21, 312292], [24, 312433], [32, 312873], [40, 313753], [43, 313953], [53, 314473], [61, 315463], [66, 315607], [72, 315907], [79, 316227], [86, 317067], [93, 317347], [97, 317827], [103, 318107], [111, 318547], [118, 318987]]}]}