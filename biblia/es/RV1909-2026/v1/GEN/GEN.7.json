{"book": "GEN", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 225860, "verses": [{"verse": 1, "start": 300, "end": 9306, "text": "Y Jehová dijo a Noé: Entra tú y toda tu casa en el arca; porque a ti he visto justo delante de mí en esta generación.", "words": [[0, 454], [2, 648], [9, 841], [14, 1061], [16, 1281], [21, 2645], [27, 3005], [30, 3305], [32, 3585], [37, 3805], [40, 4025], [45, 4265], [48, 4465], [51, 4565], [57, 5605], [64, 5809], [66, 5969], [69, 6129], [72, 6249], [78, 6529], [84, 6869], [92, 7449], [95, 7589], [98, 7789], [101, 8049], [106, 8269]]}, {"verse": 2, "start": 9756, "end": 18941, "text": "De todo animal limpio te tomarás siete parejas, macho y hembra; mas de los animales que no son limpios, una pareja, macho y hembra.", "words": [[0, 9756], [3, 9895], [8, 10055], [15, 10335], [22, 10915], [25, 11155], [33, 11395], [39, 11655], [48, 12535], [54, 12915], [56, 13055], [64, 14058], [68, 14302], [71, 14482], [75, 14602], [84, 15082], [88, 15382], [91, 15542], [95, 15742], [104, 16582], [108, 16742], [116, 17562], [122, 18042], [124, 18202]]}, {"verse": 3, "start": 19391, "end": 27666, "text": "También de las aves de los cielos de siete en siete, macho y hembra; para guardar en vida la casta sobre la faz de toda la tierra.", "words": [[0, 19391], [8, 19691], [11, 19871], [15, 19991], [20, 20351], [23, 20491], [27, 20631], [34, 21091], [37, 21311], [43, 21531], [46, 21971], [53, 22411], [59, 22851], [61, 22991], [69, 24010], [74, 24179], [82, 24639], [85, 24739], [90, 24939], [93, 25119], [99, 25659], [105, 25899], [108, 26079], [112, 26299], [115, 26499], [120, 26659], [123, 26879]]}, {"verse": 4, "start": 28116, "end": 39000, "text": "Porque pasados aún siete días, yo haré llover sobre la tierra cuarenta días y cuarenta noches; y borraré toda sustancia que hice de sobre la faz de la tierra.", "words": [[0, 28116], [7, 28279], [15, 28779], [19, 29039], [25, 29319], [31, 30039], [34, 30399], [39, 30659], [46, 30979], [52, 31179], [55, 31359], [62, 31679], [71, 32239], [76, 32519], [78, 32759], [87, 33239], [95, 34954], [97, 35057], [105, 35517], [110, 35677], [120, 36457], [124, 36677], [129, 36937], [132, 37117], [138, 37377], [141, 37557], [145, 37857], [148, 38077], [151, 38177]]}, {"verse": 5, "start": 39350, "end": 42614, "text": "E hizo Noé conforme a todo lo que le mandó Jehová.", "words": [[0, 39350], [2, 39631], [7, 39945], [11, 40258], [20, 40938], [22, 41018], [27, 41218], [30, 41458], [34, 41558], [37, 41658], [43, 42078]]}, {"verse": 6, "start": 43064, "end": 48685, "text": "Y siendo Noé de seiscientos años, el diluvio de las aguas fue sobre la tierra.", "words": [[0, 43064], [2, 43388], [9, 43698], [13, 44008], [16, 44338], [28, 44668], [34, 45888], [37, 46088], [45, 46588], [48, 46708], [52, 46888], [58, 47308], [62, 47468], [68, 47848], [71, 48068]]}, {"verse": 7, "start": 49135, "end": 57049, "text": "Y vino Noé, y sus hijos, y su mujer, y las mujeres de sus hijos con él al arca, por las aguas del diluvio.", "words": [[0, 49135], [2, 49253], [7, 49533], [12, 50073], [14, 50313], [18, 50513], [25, 51513], [27, 51613], [30, 51753], [37, 52173], [39, 52613], [43, 52773], [51, 53133], [54, 53373], [58, 53553], [64, 53893], [68, 54193], [71, 54486], [74, 54780], [80, 55073], [84, 55593], [88, 55813], [94, 56193], [98, 56333]]}, {"verse": 8, "start": 57499, "end": 66552, "text": "De los animales limpios, y de los animales que no eran limpios, y de las aves, y de todo lo que anda arrastrando sobre la tierra,", "words": [[0, 57499], [3, 57625], [7, 57745], [16, 58165], [25, 59085], [27, 59705], [30, 59825], [34, 59945], [43, 60425], [47, 60685], [50, 60885], [55, 61125], [64, 61845], [66, 61965], [69, 62085], [73, 62265], [79, 62705], [81, 63145], [84, 63305], [89, 63605], [92, 63885], [96, 64045], [101, 64325], [113, 65385], [119, 65665], [122, 65885]]}, {"verse": 9, "start": 67002, "end": 73568, "text": "De dos en dos entraron a Noé en el arca: macho y hembra, como mandó Dios a Noé.", "words": [[0, 67002], [3, 67139], [7, 67339], [10, 67519], [14, 67719], [23, 68399], [25, 68519], [29, 68839], [32, 69059], [35, 69219], [41, 70118], [47, 70765], [49, 70945], [57, 71905], [62, 72105], [68, 72565], [73, 72725], [75, 73105]]}, {"verse": 10, "start": 74018, "end": 79429, "text": "Y sucedió que al séptimo día las aguas del diluvio fueron sobre la tierra.", "words": [[0, 74018], [2, 74138], [10, 74718], [14, 74938], [17, 75118], [25, 75738], [29, 76078], [33, 76598], [39, 77138], [43, 77318], [51, 77838], [58, 78138], [64, 78518], [67, 78738]]}, {"verse": 11, "start": 79879, "end": 93619, "text": "El año seiscientos de la vida de Noé, en el mes segundo, a diecisiete días del mes, aquel día fueron rotas todas las fuentes del grande abismo, y las cataratas de los cielos fueron abiertas;", "words": [[0, 79879], [3, 80027], [7, 80377], [19, 80727], [22, 81207], [25, 81307], [30, 81547], [33, 81747], [38, 82407], [41, 82807], [44, 82927], [48, 83087], [57, 84267], [59, 84637], [70, 85007], [75, 85407], [79, 85647], [84, 86487], [90, 86807], [94, 86987], [101, 87327], [107, 87987], [113, 88487], [117, 88907], [125, 89327], [129, 89547], [136, 89847], [144, 90811], [146, 90918], [150, 91038], [160, 91778], [163, 91858], [167, 92208], [174, 92558], [181, 92758]]}, {"verse": 12, "start": 94069, "end": 97889, "text": "Y hubo lluvia sobre la tierra cuarenta días y cuarenta noches.", "words": [[0, 94069], [2, 94338], [7, 94658], [14, 94978], [20, 95178], [23, 95398], [30, 95658], [39, 96338], [44, 96558], [46, 96778], [55, 97278]]}, {"verse": 13, "start": 98339, "end": 109545, "text": "En este mismo día entraron Noé, y Sem y Cam y Jafet, hijos de Noé, la mujer de Noé, y las tres mujeres de sus hijos con él en el arca;", "words": [[0, 98339], [3, 98506], [8, 98706], [14, 99006], [18, 99306], [27, 100106], [32, 100613], [34, 101119], [38, 101626], [40, 101846], [44, 102726], [46, 102826], [53, 103746], [59, 103986], [62, 104206], [67, 104315], [70, 104425], [76, 104534], [79, 104643], [84, 106238], [86, 106498], [90, 106678], [95, 106898], [103, 107398], [106, 107598], [110, 107778], [116, 108118], [120, 108438], [123, 108638], [126, 108798], [129, 108938]]}, {"verse": 14, "start": 109995, "end": 129890, "text": "Ellos, y todos los animales silvestres según sus especies, y todos los animales mansos según sus especies, y todo reptil que anda arrastrando sobre la tierra según su especie, y toda ave según su especie, todo pájaro, toda especie de volátil.", "words": [[0, 109995], [7, 110384], [9, 110684], [15, 111064], [19, 111484], [28, 111924], [39, 113084], [45, 113344], [49, 113684], [59, 114704], [61, 114784], [67, 115124], [71, 115364], [80, 115764], [87, 116744], [93, 117064], [97, 117464], [107, 118764], [109, 118844], [114, 119124], [121, 120164], [125, 120624], [130, 120924], [142, 121844], [148, 122124], [151, 122344], [158, 122684], [164, 123044], [167, 123324], [176, 124288], [178, 124425], [183, 124665], [187, 125165], [193, 125525], [196, 125805], [205, 126965], [210, 127125], [218, 128285], [223, 128465], [231, 128905], [234, 129125]]}, {"verse": 15, "start": 130340, "end": 136998, "text": "Y vinieron a Noé al arca, de dos en dos de toda carne en que había espíritu de vida.", "words": [[0, 130340], [2, 130448], [11, 130948], [13, 131268], [17, 131795], [20, 132321], [26, 132848], [29, 132948], [33, 133248], [36, 133568], [40, 133908], [43, 134328], [48, 134548], [54, 134768], [57, 134988], [61, 135248], [67, 135508], [76, 136388], [79, 136508]]}, {"verse": 16, "start": 137448, "end": 146816, "text": "Y los que vinieron, macho y hembra de toda carne vinieron, como le había mandado Dios: y Jehová le cerró la puerta.", "words": [[0, 137448], [2, 137575], [6, 137715], [10, 137855], [20, 138475], [26, 139695], [28, 139995], [35, 140615], [38, 140775], [43, 140995], [49, 141595], [59, 142255], [64, 142935], [67, 143135], [73, 143415], [81, 143895], [87, 144806], [89, 144971], [96, 145551], [99, 145851], [105, 146311], [108, 146451]]}, {"verse": 17, "start": 147266, "end": 156417, "text": "Y fue el diluvio cuarenta días sobre la tierra; y las aguas crecieron, y alzaron el arca, y se elevó sobre la tierra.", "words": [[0, 147266], [2, 147833], [6, 148013], [9, 148153], [17, 148543], [26, 148933], [31, 149513], [37, 149913], [40, 150112], [48, 151074], [50, 151195], [54, 151355], [60, 151915], [71, 152735], [73, 153055], [81, 153595], [84, 153775], [90, 154175], [92, 154635], [95, 154775], [101, 155255], [107, 155555], [110, 155775]]}, {"verse": 18, "start": 156867, "end": 165799, "text": "Y prevalecieron las aguas, y crecieron en gran manera sobre la tierra; y andaba el arca sobre la faz de las aguas.", "words": [[0, 156867], [2, 156974], [16, 157754], [20, 157934], [27, 158534], [29, 159194], [39, 159914], [42, 160354], [47, 160594], [54, 161114], [60, 161474], [63, 161694], [71, 162658], [73, 162798], [80, 163258], [83, 163478], [88, 163858], [94, 164178], [97, 164378], [101, 164738], [104, 164998], [108, 165158]]}, {"verse": 19, "start": 166248, "end": 176374, "text": "Y las aguas prevalecieron mucho en extremo sobre la tierra; y todos los montes altos que había debajo de todos los cielos, fueron cubiertos.", "words": [[0, 166248], [2, 166354], [6, 166494], [12, 166934], [26, 167714], [32, 168174], [35, 168374], [43, 169034], [49, 169274], [52, 169454], [60, 170384], [62, 170491], [68, 170831], [72, 171271], [79, 171931], [85, 172591], [89, 172751], [95, 172971], [102, 173431], [105, 173611], [111, 173851], [115, 174291], [123, 175011], [130, 175371]]}, {"verse": 20, "start": 176824, "end": 182522, "text": "Quince codos en alto prevalecieron las aguas; y fueron cubiertos los montes.", "words": [[0, 177006], [7, 177226], [13, 177866], [16, 178026], [21, 178346], [35, 179346], [39, 179546], [46, 180565], [48, 180655], [55, 180895], [65, 181595], [69, 181715]]}, {"verse": 21, "start": 182972, "end": 195273, "text": "Y murió toda carne que se mueve sobre la tierra, así de aves como de ganados, y de bestias, y de todo reptil que anda arrastrando sobre la tierra, y todo hombre:", "words": [[0, 182972], [2, 183098], [8, 183478], [13, 183658], [19, 184118], [23, 184298], [26, 184478], [32, 184918], [38, 185158], [41, 185378], [49, 186278], [53, 186598], [56, 186798], [61, 187158], [66, 187438], [69, 187598], [78, 188698], [80, 188738], [83, 188878], [92, 189858], [94, 189898], [97, 190038], [102, 190238], [109, 191358], [113, 191538], [118, 191798], [130, 192738], [136, 192998], [139, 193198], [147, 194222], [149, 194222], [154, 194432]]}, {"verse": 22, "start": 195723, "end": 203137, "text": "Todo lo que tenía aliento de espíritu de vida en sus narices, de todo lo que había en la tierra, murió.", "words": [[0, 195723], [5, 195987], [8, 196347], [12, 196487], [18, 196867], [26, 197587], [29, 197867], [38, 198587], [41, 198707], [46, 198927], [49, 199087], [53, 199267], [62, 200387], [65, 200467], [70, 200707], [73, 200947], [77, 201107], [83, 201307], [86, 201487], [89, 201607], [97, 202527]]}, {"verse": 23, "start": 203587, "end": 220252, "text": "Así fue destruida toda sustancia que vivía sobre la faz de la tierra, desde el hombre hasta la bestia, y los reptiles, y las aves del cielo; y fueron borrados de la tierra; y quedó solamente Noé, y lo que con él estaba en el arca.", "words": [[0, 203587], [4, 203892], [8, 204152], [18, 204932], [23, 205232], [33, 206132], [37, 206352], [43, 206772], [49, 207032], [52, 207252], [56, 207512], [59, 207692], [62, 207792], [70, 208692], [76, 208972], [79, 209272], [86, 209552], [92, 209832], [95, 210012], [103, 210592], [105, 211012], [109, 211172], [119, 211912], [121, 212412], [125, 212592], [130, 212892], [134, 213072], [141, 214059], [143, 214168], [150, 214428], [159, 215048], [162, 215268], [165, 215388], [173, 216357], [175, 216539], [181, 216759], [191, 217499], [196, 218239], [198, 218439], [201, 218639], [205, 218759], [209, 218959], [212, 219079], [219, 219379], [222, 219579], [225, 219699]]}, {"verse": 24, "start": 220702, "end": 225460, "text": "Y prevalecieron las aguas sobre la tierra ciento cincuenta días.", "words": [[0, 220702], [2, 220964], [16, 221784], [20, 221964], [26, 222484], [32, 222764], [35, 222984], [42, 223371], [49, 223757], [59, 224144]]}]}