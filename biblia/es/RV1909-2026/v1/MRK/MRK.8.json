{"book": "MRK", "chapter": 8, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 295644, "verses": [{"verse": 1, "start": 300, "end": 8248, "text": "En aquellos días, cuando hubo gran multitud, y no tenían qué comer, Jesús llamó a sus discípulos, y les dijo:", "words": [[0, 300], [3, 407], [12, 647], [18, 1667], [25, 1827], [30, 2247], [35, 2487], [45, 3247], [47, 3472], [50, 3732], [57, 3992], [61, 4212], [68, 4987], [74, 5367], [80, 6187], [82, 6267], [86, 6447], [98, 7307], [100, 7527], [104, 7687]]}, {"verse": 2, "start": 8598, "end": 15002, "text": "Tengo compasión de la multitud, porque ya hace tres días que están conmigo, y no tienen qué comer:", "words": [[0, 8598], [6, 8840], [16, 9500], [19, 9640], [22, 9740], [32, 10380], [39, 10960], [42, 11300], [47, 11680], [52, 11960], [57, 12320], [61, 12520], [67, 12720], [76, 13580], [78, 13780], [81, 13970], [88, 14160], [92, 14400]]}, {"verse": 3, "start": 15352, "end": 22903, "text": "Y si los envío en ayunas a sus casas, desmayarán en el camino; porque algunos de ellos han venido de lejos.", "words": [[0, 15352], [2, 15631], [5, 15751], [9, 15911], [15, 16411], [18, 16511], [25, 16991], [27, 17111], [31, 17251], [38, 17871], [49, 19011], [52, 19271], [55, 19411], [63, 20236], [70, 20440], [78, 20860], [81, 21080], [87, 21340], [91, 21580], [98, 22040], [101, 22180]]}, {"verse": 4, "start": 23253, "end": 29646, "text": "Y sus discípulos le respondieron: ¿De dónde podrá alguien hartar a estos de pan aquí en el desierto?", "words": [[0, 23253], [2, 23360], [6, 23540], [17, 24340], [20, 24560], [34, 25941], [38, 26117], [44, 26317], [50, 26797], [58, 27037], [65, 27497], [67, 27577], [73, 27777], [76, 27997], [80, 28257], [85, 28557], [88, 28857], [91, 28957]]}, {"verse": 5, "start": 29926, "end": 34803, "text": "Y les preguntó: ¿Cuántos panes tenéis? Y ellos dijeron: Siete.", "words": [[0, 29926], [2, 30069], [6, 30149], [16, 31159], [25, 31544], [31, 31964], [39, 32903], [41, 33071], [47, 33271], [56, 34511]]}, {"verse": 6, "start": 35083, "end": 49208, "text": "Entonces mandó a la multitud que se recostase en tierra; y tomando los siete panes, habiendo dado gracias, partió, y dio a sus discípulos que los pusiesen delante: y los pusieron delante a la multitud.", "words": [[0, 35083], [9, 35664], [15, 36524], [17, 36604], [20, 36704], [29, 37264], [33, 37444], [36, 37584], [46, 38224], [49, 38444], [57, 39345], [59, 39453], [67, 39873], [71, 40033], [77, 40333], [84, 41213], [93, 41553], [98, 41793], [107, 42713], [115, 43213], [117, 43853], [121, 44093], [123, 44333], [127, 44533], [138, 45433], [142, 45613], [146, 45973], [155, 46333], [164, 47190], [166, 47293], [170, 47393], [179, 47833], [187, 48333], [189, 48453], [192, 48513]]}, {"verse": 7, "start": 49558, "end": 55505, "text": "Tenían también unos pocos pececillos: y los bendijo, y mandó que también los pusiesen delante.", "words": [[0, 49558], [7, 49822], [15, 50202], [20, 50442], [26, 51152], [38, 52030], [40, 52116], [44, 52236], [53, 53276], [55, 53356], [61, 53676], [65, 53776], [73, 54096], [77, 54236], [86, 54696]]}, {"verse": 8, "start": 55855, "end": 62303, "text": "Y comieron, y se saciaron: y levantaron de los pedazos que habían sobrado, siete canastas.", "words": [[0, 55855], [2, 55962], [12, 56362], [14, 56562], [17, 56662], [27, 57715], [29, 57841], [40, 58501], [43, 58701], [47, 58841], [55, 59861], [59, 60081], [66, 60321], [75, 60921], [81, 61241]]}, {"verse": 9, "start": 62653, "end": 66626, "text": "Y eran los que comieron, como cuatro mil: y los despidió.", "words": [[0, 62653], [2, 62949], [7, 63149], [11, 63349], [15, 63509], [25, 63949], [30, 64432], [37, 64916], [42, 65565], [44, 65706], [48, 65826]]}, {"verse": 10, "start": 66976, "end": 72669, "text": "Y luego entrando en el barco con sus discípulos, vino a las partes de Dalmanutha.", "words": [[0, 66976], [2, 67117], [8, 67297], [17, 67937], [20, 68097], [23, 68237], [29, 68697], [33, 68917], [37, 69117], [49, 70317], [54, 70797], [56, 71017], [60, 71137], [67, 71557], [70, 72133]]}, {"verse": 11, "start": 73019, "end": 80625, "text": "Y vinieron los fariseos, y comenzaron a discutir con él, pidiéndole señal del cielo, poniéndolo a prueba.", "words": [[0, 73019], [2, 73140], [11, 73580], [15, 73780], [25, 74640], [27, 75040], [38, 75800], [40, 75920], [49, 76500], [53, 76680], [57, 77380], [68, 77940], [74, 78400], [78, 78520], [85, 79300], [96, 79920], [98, 80040]]}, {"verse": 12, "start": 80975, "end": 90261, "text": "Y gimiendo en su espíritu, dice: ¿Por qué pide señal esta generación? De cierto os digo que no se dará señal a esta generación.", "words": [[0, 80975], [2, 81318], [11, 81678], [14, 81798], [17, 81978], [27, 82778], [33, 83566], [38, 83690], [42, 83870], [47, 84210], [53, 84710], [58, 84910], [70, 86180], [73, 86345], [80, 86905], [83, 87005], [88, 87285], [92, 87525], [95, 87705], [98, 87885], [103, 88225], [109, 88745], [111, 88905], [116, 89225]]}, {"verse": 13, "start": 90611, "end": 95358, "text": "Y dejándolos, volvió a entrar en el barco, y se fue de la otra parte.", "words": [[0, 90611], [2, 90732], [14, 91532], [21, 92152], [23, 92212], [30, 92572], [33, 92832], [36, 92952], [43, 93492], [45, 93912], [48, 94052], [52, 94252], [55, 94372], [58, 94492], [63, 94672]]}, {"verse": 14, "start": 95708, "end": 101169, "text": "Y se habían olvidado de tomar pan, y no tenían sino un pan consigo en el barco.", "words": [[0, 95708], [2, 95826], [5, 95926], [12, 96126], [21, 96786], [24, 96966], [30, 97246], [35, 97586], [37, 98066], [40, 98206], [47, 98606], [52, 99026], [55, 99386], [59, 99686], [67, 100246], [70, 100486], [73, 100626]]}, {"verse": 15, "start": 101519, "end": 108723, "text": "Y les advirtió, diciendo: Mirad, guardaos de la levadura de los fariseos, y de la levadura de Herodes.", "words": [[0, 101519], [2, 101663], [6, 101863], [16, 102603], [26, 103533], [33, 104359], [42, 104999], [45, 105179], [48, 105319], [57, 105819], [60, 105979], [64, 106099], [74, 106879], [76, 107099], [79, 107219], [82, 107359], [91, 107859], [94, 108039]]}, {"verse": 16, "start": 109073, "end": 111821, "text": "Y discutían entre sí porque no tenían pan.", "words": [[0, 109073], [2, 109501], [12, 110083], [18, 110323], [21, 110583], [28, 110823], [31, 111023], [38, 111303]]}, {"verse": 17, "start": 112101, "end": 122087, "text": "Y como Jesús lo entendió, les dice: ¿Por qué discutís, porque no tenéis pan? ¿no consideráis ni entendéis? ¿aún tenéis endurecido vuestro corazón?", "words": [[0, 112101], [2, 112223], [7, 112483], [13, 112843], [16, 113143], [26, 114143], [30, 114363], [36, 115149], [41, 115253], [45, 115433], [55, 115993], [62, 116213], [65, 116433], [72, 116793], [77, 117484], [81, 117593], [93, 118353], [96, 118493], [107, 119683], [112, 119867], [119, 120287], [130, 120927], [138, 121267]]}, {"verse": 18, "start": 122437, "end": 127743, "text": "¿Teniendo ojos no veis, y teniendo oídos no oís? ¿y no os acordáis?", "words": [[0, 122437], [10, 122840], [15, 123140], [18, 123400], [24, 123800], [26, 123980], [35, 124480], [41, 125220], [44, 125540], [49, 126410], [52, 126539], [55, 126679], [58, 126819]]}, {"verse": 19, "start": 128093, "end": 137158, "text": "Cuando partí los cinco panes entre cinco mil, ¿cuántas cestas llenas de los pedazos recogisteis? Y ellos dijeron: Doce.", "words": [[0, 128093], [7, 128276], [13, 128776], [17, 128896], [23, 129216], [29, 129756], [35, 129956], [41, 130436], [46, 131096], [55, 131826], [62, 132446], [69, 132866], [72, 133006], [76, 133126], [84, 133826], [97, 135302], [99, 135470], [105, 135670], [114, 136886]]}, {"verse": 20, "start": 137438, "end": 145372, "text": "Y cuando los siete panes entre cuatro mil, ¿cuántas canastas llenas de los pedazos recogisteis? Y ellos dijeron: Siete.", "words": [[0, 137438], [2, 137541], [9, 137741], [13, 138001], [19, 138361], [25, 138941], [31, 139181], [38, 139481], [43, 139941], [52, 140536], [61, 141196], [68, 141516], [71, 141616], [75, 141736], [83, 142196], [96, 143472], [98, 143639], [104, 143839], [113, 145080]]}, {"verse": 21, "start": 145652, "end": 148511, "text": "Y les dijo: ¿Cómo aún no entendéis?", "words": [[0, 145652], [2, 145799], [6, 145939], [12, 146675], [18, 147062], [22, 147302], [25, 147542]]}, {"verse": 22, "start": 148861, "end": 153691, "text": "Y vino a Betsaida; y le traen un ciego, y le ruegan que le tocase.", "words": [[0, 148861], [2, 148987], [7, 149247], [9, 149696], [19, 150326], [21, 150429], [24, 150509], [30, 150949], [33, 151089], [40, 151629], [42, 152109], [45, 152229], [52, 152649], [56, 152809], [59, 152909]]}, {"verse": 23, "start": 153691, "end": 164177, "text": "Entonces, tomando la mano del ciego, le sacó fuera de la aldea; y escupiendo en sus ojos, y poniéndole las manos encima, le preguntó si veía algo.", "words": [[0, 153691], [10, 154211], [18, 154831], [21, 154951], [26, 155171], [30, 155371], [37, 155871], [40, 156331], [45, 156711], [51, 156991], [54, 157171], [57, 157331], [64, 158323], [66, 158466], [77, 159186], [80, 159346], [84, 159506], [90, 159946], [92, 160221], [103, 160594], [107, 160968], [113, 161341], [121, 161901], [124, 162441], [133, 163021], [136, 163181], [141, 163581]]}, {"verse": 24, "start": 164527, "end": 169892, "text": "Y él mirando, dijo: Veo a los hombres; parecen árboles que caminan.", "words": [[0, 164527], [2, 164714], [5, 164934], [14, 165674], [20, 166442], [24, 166819], [26, 166919], [30, 167059], [39, 167985], [47, 168429], [55, 169009], [59, 169189]]}, {"verse": 25, "start": 170172, "end": 179738, "text": "Luego le puso otra vez las manos sobre sus ojos, y le hizo que mirase; y fue restablecido, y vio a todos de lejos y con claridad.", "words": [[0, 170172], [6, 170395], [9, 170675], [14, 171135], [19, 171395], [23, 171755], [27, 172035], [33, 172515], [39, 172915], [43, 173155], [49, 173555], [51, 174255], [54, 174395], [59, 174655], [63, 175113], [71, 175732], [73, 175835], [77, 175995], [91, 176975], [93, 177355], [97, 177595], [99, 177695], [105, 177935], [108, 178155], [114, 178575], [116, 178795], [120, 178975]]}, {"verse": 26, "start": 180088, "end": 186901, "text": "Y le envió a su casa, diciendo: No entres en la aldea, ni lo digas a nadie en la aldea.", "words": [[0, 180088], [2, 180208], [5, 180308], [11, 180588], [13, 180708], [16, 180808], [22, 181148], [32, 182105], [35, 182349], [42, 183169], [45, 183549], [48, 183769], [55, 184349], [58, 184809], [61, 185009], [67, 185369], [69, 185489], [75, 185809], [78, 186049], [81, 186249]]}, {"verse": 27, "start": 187251, "end": 198839, "text": "Y salió Jesús y sus discípulos por las aldeas de Cesarea de Filipo. Y en el camino preguntó a sus discípulos, diciéndoles: ¿Quién dicen los hombres que soy yo?", "words": [[0, 187251], [2, 187376], [8, 187716], [14, 188256], [16, 188796], [20, 189016], [31, 189796], [35, 189996], [39, 190196], [46, 190636], [49, 191006], [57, 191376], [60, 191781], [68, 192352], [70, 192513], [73, 192643], [76, 192773], [83, 193273], [92, 193873], [94, 193973], [98, 194133], [110, 195353], [123, 196722], [130, 197026], [136, 197366], [140, 197586], [148, 197966], [152, 198166], [156, 198366]]}, {"verse": 28, "start": 199189, "end": 205634, "text": "Y ellos respondieron: Juan Bautista; y otros, Elías; y otros, Alguno de los profetas.", "words": [[0, 199189], [2, 199474], [8, 199674], [22, 200874], [27, 201137], [37, 202237], [39, 202398], [46, 202678], [53, 203737], [55, 203861], [62, 204221], [69, 204581], [72, 204761], [76, 204861]]}, {"verse": 29, "start": 205914, "end": 215172, "text": "Entonces él les dice: Y vosotros, ¿quién decís que soy yo? Y respondiendo Pedro, le dice: Tú eres el Cristo.", "words": [[0, 205914], [9, 206901], [12, 207144], [16, 207464], [22, 208377], [24, 208485], [34, 209305], [41, 209585], [47, 210005], [51, 210125], [55, 210365], [59, 211055], [61, 211164], [74, 212264], [81, 212604], [84, 213204], [90, 214006], [93, 214150], [98, 214390], [101, 214590]]}, {"verse": 30, "start": 215452, "end": 218082, "text": "Y les mandó que no hablasen de él a ninguno.", "words": [[0, 215452], [2, 215573], [6, 215693], [12, 216113], [16, 216253], [19, 216583], [28, 216913], [31, 217073], [34, 217293], [36, 217373]]}, {"verse": 31, "start": 218432, "end": 232571, "text": "Y comenzó a enseñarles, que convenía que el Hijo del hombre padeciese mucho, fuese rechazado por los ancianos, los principales sacerdotes y los escribas, fuera muerto y resucitara después de tres días.", "words": [[0, 218432], [2, 218557], [10, 219057], [12, 219137], [24, 219917], [28, 220377], [37, 220997], [41, 221157], [44, 221417], [49, 221677], [53, 221817], [60, 222307], [70, 222797], [77, 223697], [83, 224137], [93, 225277], [97, 225477], [101, 225677], [111, 226777], [115, 226877], [127, 227637], [138, 228337], [140, 228497], [144, 228617], [154, 229657], [160, 229919], [167, 230459], [169, 230539], [180, 231279], [188, 231579], [191, 231799], [196, 231999]]}, {"verse": 32, "start": 232921, "end": 239480, "text": "Y claramente decía esta palabra. Entonces Pedro le tomó, y le comenzó a reprender.", "words": [[0, 232921], [2, 233047], [13, 233707], [19, 234227], [24, 234567], [33, 235511], [42, 236052], [48, 236497], [51, 236777], [57, 237277], [59, 237597], [62, 237737], [70, 238397], [72, 238597]]}, {"verse": 33, "start": 239830, "end": 252797, "text": "Y él, volviéndose y mirando a sus discípulos, reprendió a Pedro, diciendo: Apártate de mí, Satanás; porque no pones la mira en las cosas de Dios, sino en las que son de los hombres.", "words": [[0, 239830], [2, 239977], [6, 240117], [18, 240997], [20, 241217], [28, 241637], [30, 241757], [34, 241977], [46, 243097], [56, 243797], [58, 243897], [65, 244237], [75, 245526], [84, 246267], [87, 246427], [91, 246587], [100, 247764], [107, 247968], [110, 248188], [116, 248568], [119, 248748], [124, 249028], [127, 249248], [131, 249408], [137, 249708], [140, 249948], [146, 250528], [151, 250848], [154, 251048], [158, 251208], [162, 251388], [166, 251668], [169, 251848], [173, 252008]]}, {"verse": 34, "start": 253147, "end": 263181, "text": "Y llamando a la gente con sus discípulos, les dijo: Si alguno quiere venir en pos de mí, niéguese a sí mismo, y tome su cruz, y sígame.", "words": [[0, 253147], [2, 253254], [11, 253774], [13, 253874], [16, 253934], [22, 254274], [26, 254534], [30, 254774], [42, 255794], [46, 255914], [52, 256703], [55, 256849], [62, 257269], [69, 257489], [75, 257869], [78, 258069], [82, 258289], [85, 258469], [89, 259209], [98, 259969], [100, 260149], [103, 260249], [110, 260689], [112, 260954], [117, 261314], [120, 261454], [126, 262374], [128, 262494]]}, {"verse": 35, "start": 263531, "end": 272493, "text": "Porque todo el que quiera salvar su vida, la perderá; y todo el que pierda su vida por causa de mí y del evangelio, la salvará.", "words": [[0, 263531], [7, 263775], [12, 264175], [15, 264415], [19, 264575], [26, 264895], [33, 265275], [36, 265555], [42, 265915], [45, 266575], [54, 267665], [56, 267788], [61, 268108], [64, 268368], [68, 268508], [75, 268988], [78, 269168], [83, 269488], [87, 269708], [93, 270028], [96, 270328], [99, 270508], [101, 270748], [105, 270888], [116, 271588], [119, 271788]]}, {"verse": 36, "start": 272843, "end": 277688, "text": "Porque ¿qué aprovechará al hombre, si gana todo el mundo, y pierde su alma?", "words": [[0, 272977], [7, 273147], [12, 273367], [24, 274187], [27, 274327], [35, 274627], [38, 274927], [43, 275227], [48, 275427], [51, 275627], [58, 275967], [60, 276407], [67, 276887], [70, 277087]]}, {"verse": 37, "start": 278038, "end": 281290, "text": "¿O qué dará el hombre a cambio de su alma?", "words": [[0, 278038], [3, 278179], [7, 278379], [12, 278819], [15, 279039], [22, 279399], [24, 279659], [31, 280079], [34, 280339], [37, 280559]]}, {"verse": 38, "start": 281640, "end": 295244, "text": "Porque el que se avergüence de mí y de mis palabras en esta generación adúltera y pecadora, el Hijo del hombre se avergonzará también de él, cuando venga en la gloria de su Padre con los santos ángeles.", "words": [[0, 281640], [7, 281902], [10, 282182], [14, 282342], [17, 282762], [28, 283182], [31, 283402], [34, 283682], [36, 283902], [39, 284042], [43, 284162], [52, 284642], [55, 284962], [60, 285222], [71, 285902], [80, 286582], [82, 286742], [92, 287962], [95, 288102], [100, 288382], [104, 288562], [111, 288982], [114, 289342], [126, 290122], [134, 290422], [137, 290742], [141, 291358], [148, 291541], [154, 292021], [157, 292141], [160, 292281], [167, 292661], [170, 292821], [173, 292981], [179, 293561], [183, 293721], [187, 293921], [194, 294421]]}]}