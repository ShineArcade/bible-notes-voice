{"book": "MRK", "chapter": 11, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 253161, "verses": [{"verse": 1, "start": 300, "end": 7352, "text": "And when they came near to Jerusalem, to Bethphage and Bethany, at the mount of Olives, he sends forth two of his disciples,", "words": [[0, 300], [4, 437], [9, 577], [14, 737], [19, 997], [24, 1237], [27, 1397], [38, 2057], [41, 2297], [51, 2957], [55, 3077], [64, 3537], [67, 3737], [71, 3837], [77, 4077], [80, 4217], [88, 5097], [91, 5237], [97, 5517], [103, 5837], [107, 6197], [110, 6357], [114, 6497]]}, {"verse": 2, "start": 7802, "end": 18716, "text": "And says to them, Go your way into the village over against you: and as soon as you be entered into it, you shall find a colt tied, on which never man sat; loose him, and bring him.", "words": [[0, 7802], [4, 7950], [9, 8190], [12, 8430], [18, 9525], [21, 9727], [26, 9907], [30, 10127], [35, 10287], [39, 10427], [47, 10707], [52, 10987], [60, 11347], [65, 12024], [69, 12127], [72, 12267], [77, 12487], [80, 12607], [84, 12687], [87, 12807], [95, 13107], [100, 13427], [104, 13807], [108, 13947], [114, 14087], [119, 14387], [121, 14640], [126, 14894], [132, 15147], [135, 15607], [141, 15807], [147, 16107], [151, 16387], [156, 17269], [162, 17595], [167, 17735], [171, 18055], [177, 18295]]}, {"verse": 3, "start": 19166, "end": 25745, "text": "And if any man say to you, Why do you this? say you that the Lord has need of him; and immediately he will send him here.", "words": [[0, 19166], [4, 19288], [7, 19388], [11, 19528], [15, 19748], [19, 20048], [22, 20188], [27, 20568], [31, 20768], [34, 20928], [38, 21008], [44, 21804], [48, 22008], [52, 22208], [57, 22388], [61, 22508], [66, 22708], [70, 22948], [75, 23148], [78, 23348], [83, 23960], [87, 24066], [99, 24386], [102, 24786], [107, 24926], [112, 25166], [116, 25326]]}, {"verse": 4, "start": 26095, "end": 33028, "text": "And they went their way, and found the colt tied by the door without in a place where two ways met; and they loose him.", "words": [[0, 26095], [4, 26242], [9, 26362], [14, 26582], [20, 26802], [25, 27522], [29, 27642], [35, 27902], [39, 28152], [44, 28402], [49, 28822], [52, 29102], [56, 29242], [61, 29522], [69, 29922], [72, 30242], [74, 30342], [80, 30602], [86, 30822], [90, 31062], [95, 31342], [100, 32136], [104, 32282], [109, 32472], [115, 32662]]}, {"verse": 5, "start": 33478, "end": 38644, "text": "And certain of them that stood there said to them, What do you, loosing the colt?", "words": [[0, 33478], [4, 33620], [12, 33920], [15, 34160], [20, 34320], [25, 34540], [31, 34800], [37, 35080], [42, 35280], [45, 35500], [51, 37593], [56, 37718], [59, 37838], [64, 37978], [72, 38118], [76, 38408]]}, {"verse": 6, "start": 38994, "end": 43284, "text": "And they said to them even as Jesus had commanded: and they let them go.", "words": [[0, 38994], [4, 39124], [9, 39264], [14, 39564], [17, 39744], [22, 40044], [27, 40264], [30, 40504], [36, 40904], [40, 41204], [51, 42231], [55, 42352], [60, 42472], [64, 42652], [69, 42832]]}, {"verse": 7, "start": 43734, "end": 48467, "text": "And they brought the colt to Jesus, and cast their garments on him; and he sat upon him.", "words": [[0, 43734], [4, 43857], [9, 43937], [17, 44177], [21, 44397], [26, 44617], [29, 44837], [36, 45157], [40, 45477], [45, 45777], [51, 45977], [60, 46297], [63, 46597], [68, 47245], [72, 47370], [75, 47490], [79, 47790], [84, 48090]]}, {"verse": 8, "start": 48917, "end": 55521, "text": "And many spread their garments in the way: and others cut down branches off the trees, and scattered them in the way.", "words": [[0, 48917], [4, 49063], [9, 49283], [16, 49683], [22, 49943], [31, 50303], [34, 50583], [38, 50683], [43, 51376], [47, 51744], [54, 52004], [58, 52384], [63, 52644], [72, 53124], [76, 53444], [80, 53624], [87, 53944], [91, 54204], [101, 54584], [106, 54884], [109, 55004], [113, 55104]]}, {"verse": 9, "start": 55971, "end": 63365, "text": "And they that went before, and they that followed, cried, saying, Hosanna; Blessed is he that comes in the name of the Lord:", "words": [[0, 55971], [4, 56370], [9, 56550], [14, 56730], [19, 56910], [27, 57750], [31, 57830], [36, 57970], [41, 58170], [51, 58570], [58, 59530], [66, 60386], [75, 61281], [83, 61483], [86, 61743], [89, 61903], [94, 62063], [100, 62303], [103, 62483], [107, 62563], [112, 62763], [115, 62863], [119, 62983]]}, {"verse": 10, "start": 63815, "end": 68929, "text": "Blessed be the kingdom of our father David, that comes in the name of the Lord: Hosanna in the highest.", "words": [[0, 63928], [8, 64078], [11, 64177], [15, 64298], [23, 64498], [26, 64738], [30, 64858], [37, 65118], [44, 65558], [49, 65918], [55, 66158], [58, 66318], [62, 66398], [67, 66558], [70, 66658], [74, 66778], [80, 67441], [88, 67957], [91, 68237], [95, 68377]]}, {"verse": 11, "start": 69279, "end": 79790, "text": "And Jesus entered into Jerusalem, and into the temple: and when he had looked round about upon all things, and now the eventide was come, he went out to Bethany with the twelve.", "words": [[0, 69279], [4, 69419], [10, 69759], [18, 70219], [23, 70519], [34, 71119], [38, 71719], [43, 71979], [47, 72139], [55, 72950], [59, 73078], [64, 73218], [67, 73398], [71, 73578], [78, 73778], [84, 74098], [90, 74358], [95, 74758], [99, 75078], [107, 75778], [111, 75898], [115, 76118], [119, 76278], [128, 76858], [132, 77058], [138, 77838], [141, 77938], [146, 78118], [150, 78338], [153, 78518], [161, 78938], [166, 79138], [170, 79278]]}, {"verse": 12, "start": 80240, "end": 83894, "text": "¶ And on the next day, when they were come from Bethany, he was hungry:", "words": [[2, 80240], [6, 80366], [9, 80466], [13, 80586], [18, 80806], [23, 81446], [28, 81466], [33, 81626], [38, 81746], [43, 81966], [48, 82186], [57, 83046], [60, 83126], [64, 83306]]}, {"verse": 13, "start": 84344, "end": 95510, "text": "And seeing a fig tree afar off having leaves, he came, if perhaps he might find any thing on it: and when he came to it, he found nothing but leaves; for the time of figs was not yet.", "words": [[0, 84344], [4, 84487], [11, 84747], [13, 84947], [17, 85187], [22, 85487], [27, 85847], [31, 86167], [38, 86387], [46, 87207], [49, 87307], [55, 88107], [58, 88247], [66, 88567], [69, 88807], [75, 88967], [80, 89227], [84, 89487], [90, 89747], [93, 90107], [97, 90630], [101, 90763], [106, 90903], [109, 91023], [114, 91263], [117, 91483], [121, 91763], [124, 91883], [130, 92143], [138, 92503], [142, 92723], [150, 93681], [154, 93773], [158, 93873], [163, 94173], [166, 94333], [171, 94693], [175, 94813], [179, 95033]]}, {"verse": 14, "start": 95960, "end": 102898, "text": "And Jesus answered and said to it, No man eat fruit of you hereafter for ever. And his disciples heard it.", "words": [[0, 95960], [4, 96102], [10, 96382], [19, 96862], [23, 97082], [28, 97302], [31, 97502], [35, 98430], [38, 98648], [42, 98968], [46, 99208], [52, 99468], [55, 99648], [59, 99788], [69, 100258], [73, 100728], [79, 101503], [83, 101626], [87, 101726], [97, 102246], [103, 102606]]}, {"verse": 15, "start": 103348, "end": 115395, "text": "¶ And they come to Jerusalem: and Jesus went into the temple, and began to cast out them that sold and bought in the temple, and overthrew the tables of the moneychangers, and the seats of them that sold doves;", "words": [[2, 103348], [6, 103494], [11, 103594], [16, 103894], [19, 104074], [30, 105172], [34, 105317], [40, 105637], [45, 105997], [50, 106257], [54, 106397], [62, 106737], [66, 107297], [72, 107597], [75, 107777], [80, 108037], [84, 108297], [89, 108537], [94, 108717], [99, 109077], [103, 109337], [110, 109597], [113, 109737], [117, 109857], [125, 110177], [129, 110697], [139, 111257], [143, 111377], [150, 111737], [153, 111937], [157, 112483], [172, 113282], [176, 113411], [180, 113511], [186, 113731], [189, 113951], [194, 114111], [199, 114291], [204, 114571]]}, {"verse": 16, "start": 115845, "end": 119326, "text": "And would not allow anyone to carry any vessel through the temple.", "words": [[0, 115845], [4, 115962], [10, 116122], [14, 116342], [20, 116682], [27, 117162], [30, 117362], [36, 117662], [40, 117962], [47, 118342], [55, 118642], [59, 118802]]}, {"verse": 17, "start": 119776, "end": 128848, "text": "And he taught, saying to them, Is it not written, My house shall be called of all nations the house of prayer? but you have made it a den of thieves.", "words": [[0, 119776], [4, 119923], [7, 120043], [15, 120283], [22, 120663], [25, 120943], [31, 121614], [34, 121800], [37, 121900], [41, 122100], [50, 122900], [53, 123220], [59, 123540], [65, 123740], [68, 123880], [75, 124160], [78, 124340], [82, 124520], [90, 124900], [94, 125180], [100, 125400], [103, 125560], [111, 126374], [115, 126710], [119, 126870], [124, 127030], [129, 127210], [132, 127370], [134, 127530], [138, 127770], [141, 128070]]}, {"verse": 18, "start": 129198, "end": 137727, "text": "And the scribes and chief priests heard it, and sought how they might destroy him: for they feared him, because all the people was astonished at his doctrine.", "words": [[0, 129198], [4, 129358], [8, 129498], [16, 130118], [20, 130238], [26, 130498], [34, 130958], [40, 131298], [44, 131458], [48, 131958], [55, 132318], [59, 132558], [64, 132718], [70, 132938], [78, 133378], [83, 134122], [87, 134226], [92, 134406], [99, 134726], [104, 134946], [112, 135206], [116, 135526], [120, 135686], [127, 135946], [131, 136186], [142, 136846], [145, 136986], [149, 137086]]}, {"verse": 19, "start": 138177, "end": 140819, "text": "And when even was come, he went out of the city.", "words": [[0, 138177], [4, 138314], [9, 138474], [14, 138834], [18, 139114], [24, 139674], [27, 139754], [32, 139934], [36, 140114], [39, 140214], [43, 140334]]}, {"verse": 20, "start": 141269, "end": 146363, "text": "¶ And in the morning, as they passed by, they saw the fig tree dried up from the roots.", "words": [[2, 141269], [6, 141412], [9, 141552], [13, 141652], [22, 142012], [25, 142292], [30, 142432], [37, 142792], [41, 143612], [46, 143772], [50, 144032], [54, 144192], [58, 144492], [63, 144812], [69, 145152], [72, 145412], [77, 145672], [81, 145812]]}, {"verse": 21, "start": 146813, "end": 152930, "text": "And Peter calling to remembrance says to him, Master, behold, the fig tree which you cursed is withered away.", "words": [[0, 146813], [4, 146965], [10, 147265], [18, 147645], [21, 148035], [33, 148425], [38, 148705], [41, 148945], [46, 149557], [54, 150117], [62, 150597], [66, 150657], [70, 150877], [75, 151157], [81, 151397], [85, 151537], [92, 151837], [95, 152157], [104, 152537]]}, {"verse": 22, "start": 153280, "end": 158392, "text": "And Jesus answering says to them, Have faith in God.", "words": [[0, 153280], [4, 153423], [10, 153783], [20, 154383], [25, 154683], [28, 154943], [34, 156894], [39, 157088], [45, 157488], [48, 157828]]}, {"verse": 23, "start": 158842, "end": 172791, "text": "For indeed I say to you, That whoever shall say to this mountain, Be removed, and be cast into the sea; and shall not doubt in his heart, but shall believe that those things which he says shall come to pass; he shall have whatever he says.", "words": [[0, 158842], [4, 158988], [11, 159308], [13, 159668], [17, 159908], [20, 160148], [25, 160368], [30, 160908], [38, 161188], [44, 161548], [48, 161848], [51, 162028], [56, 162188], [66, 162588], [69, 163128], [78, 163628], [82, 164048], [85, 164228], [90, 164548], [95, 164868], [99, 165048], [104, 165745], [108, 165866], [114, 166106], [118, 166306], [124, 166566], [127, 166786], [131, 166906], [138, 167666], [142, 167826], [148, 168026], [156, 168366], [161, 168566], [167, 168766], [174, 169106], [180, 169346], [183, 169546], [188, 169826], [194, 170046], [199, 170266], [202, 170406], [208, 171240], [211, 171331], [217, 171491], [222, 171751], [231, 172011], [234, 172251]]}, {"verse": 24, "start": 173241, "end": 180555, "text": "Therefore I say to you, What things soever you desire, when you pray, believe that you receive them, and you shall have them.", "words": [[0, 173241], [10, 173644], [12, 174004], [16, 174284], [19, 174484], [24, 174684], [29, 174944], [36, 175244], [43, 175704], [47, 175884], [55, 176324], [60, 176624], [64, 176764], [70, 177484], [78, 177904], [83, 178164], [87, 178304], [95, 178704], [101, 179404], [105, 179504], [109, 179644], [115, 179844], [120, 180184]]}, {"verse": 25, "start": 181005, "end": 189685, "text": "And when you stand praying, forgive, if you have anything against anyone: that your Father also which is in heaven may forgive you your trespasses.", "words": [[0, 181005], [4, 181143], [9, 181283], [13, 181443], [19, 181743], [28, 182623], [37, 182983], [40, 183563], [44, 183723], [49, 183903], [58, 184283], [66, 184623], [74, 185640], [79, 185757], [84, 185897], [91, 186217], [96, 186897], [102, 187037], [105, 187177], [108, 187317], [115, 187797], [119, 187937], [127, 188277], [131, 188577], [136, 188757]]}, {"verse": 26, "start": 190135, "end": 195282, "text": "But if you do not forgive, neither will your Father which is in heaven forgive your trespasses.", "words": [[0, 190135], [4, 190239], [7, 190359], [11, 190479], [14, 190619], [18, 190799], [27, 191779], [35, 192019], [40, 192319], [45, 192499], [52, 192859], [58, 193179], [61, 193319], [64, 193459], [71, 193719], [79, 194119], [84, 194399]]}, {"verse": 27, "start": 195632, "end": 204142, "text": "¶ And they come again to Jerusalem: and as he was walking in the temple, there come to him the chief priests, and the scribes, and the elders,", "words": [[2, 195632], [6, 195756], [11, 195876], [16, 196116], [22, 196436], [25, 196636], [36, 197808], [40, 197954], [43, 198214], [46, 198354], [50, 198534], [58, 198934], [61, 199174], [65, 199274], [73, 200094], [79, 200194], [84, 200454], [87, 200654], [91, 200774], [95, 200914], [101, 201174], [110, 201674], [114, 202174], [118, 202314], [127, 203014], [131, 203334], [135, 203454]]}, {"verse": 28, "start": 204592, "end": 210229, "text": "And say to him, By what authority are you doing these things? and who gave you this authority to do these things?", "words": [[0, 204592], [4, 204750], [8, 204990], [11, 205190], [16, 205811], [19, 205928], [24, 206228], [34, 206548], [38, 206768], [42, 206868], [48, 207088], [54, 207288], [62, 208068], [66, 208197], [70, 208337], [75, 208537], [79, 208697], [84, 208877], [94, 209217], [97, 209437], [100, 209617], [106, 209817]]}, {"verse": 29, "start": 210579, "end": 220785, "text": "And Jesus answered and said to them, I will also ask of you one question, and answer me, and I will tell you by what authority I do these things.", "words": [[0, 210579], [4, 210720], [10, 211060], [19, 211640], [23, 211840], [28, 212060], [31, 212220], [37, 214321], [39, 214447], [44, 214587], [49, 214907], [53, 215227], [56, 215407], [60, 215547], [64, 215807], [74, 216247], [78, 216787], [85, 217147], [89, 217707], [93, 217847], [95, 217987], [100, 218107], [105, 218347], [109, 218587], [112, 218787], [117, 219007], [127, 219387], [129, 219687], [132, 219927], [138, 220187]]}, {"verse": 30, "start": 221235, "end": 225598, "text": "The baptism of John, was it from heaven, or of men? answer me.", "words": [[0, 221235], [4, 221316], [12, 221676], [15, 221956], [21, 222716], [25, 222796], [28, 222956], [33, 223136], [41, 223376], [44, 223876], [47, 224016], [52, 224821], [59, 225187]]}, {"verse": 31, "start": 225948, "end": 232931, "text": "And they reasoned with themselves, saying, If we shall say, From heaven; he will say, Why then did you not believe him?", "words": [[0, 225948], [4, 226053], [9, 226173], [18, 226653], [23, 226753], [35, 227633], [43, 228442], [46, 228583], [49, 228723], [55, 228923], [60, 229263], [65, 229543], [73, 230457], [76, 230542], [81, 230682], [86, 231302], [90, 231622], [95, 231842], [99, 232002], [103, 232142], [107, 232262], [115, 232542]]}, {"verse": 32, "start": 233381, "end": 241456, "text": "But if we shall say, Of men; they feared the people: for all men counted John, that he was a prophet indeed.", "words": [[0, 233381], [4, 233485], [7, 233605], [10, 233745], [16, 233945], [21, 234345], [24, 234485], [29, 235985], [34, 236182], [41, 236602], [45, 236802], [53, 237636], [57, 237760], [61, 238000], [65, 238240], [73, 238680], [79, 239220], [84, 239820], [87, 239960], [91, 240120], [93, 240220], [101, 240560]]}, {"verse": 33, "start": 241906, "end": 252761, "text": "And they answered and said to Jesus, We cannot tell. And Jesus answering says to them, Neither do I tell you by what authority I do these things.", "words": [[0, 241906], [4, 242071], [9, 242211], [18, 242691], [22, 242971], [27, 243231], [30, 243411], [37, 244389], [40, 244509], [47, 244809], [53, 245645], [57, 245787], [63, 246147], [73, 246747], [78, 247047], [81, 247307], [87, 249258], [95, 249591], [98, 249911], [100, 250051], [105, 250331], [109, 250571], [112, 250811], [117, 251051], [127, 251431], [129, 251691], [132, 251911], [138, 252131]]}]}