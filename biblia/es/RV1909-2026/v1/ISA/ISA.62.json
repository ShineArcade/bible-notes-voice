{"book": "ISA", "chapter": 62, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 124214, "verses": [{"verse": 1, "start": 300, "end": 11908, "text": "Por amor de Sion no callaré, y por amor de Jerusalén no he de parar, hasta que salga como resplandor su justicia, y su salvación se encienda como una antorcha.", "words": [[0, 300], [4, 467], [9, 687], [12, 907], [17, 1287], [20, 1487], [29, 2327], [31, 2707], [35, 2927], [40, 3227], [43, 3427], [53, 4247], [56, 4727], [59, 4887], [62, 5027], [69, 5327], [75, 5907], [79, 6087], [85, 6507], [90, 7047], [101, 7587], [104, 7807], [114, 8747], [116, 8987], [119, 9127], [129, 9807], [132, 10027], [141, 10587], [146, 10847], [150, 11402]]}, {"verse": 2, "start": 12358, "end": 22010, "text": "Entonces verán las gentes tu justicia, y todos los reyes tu gloria; y te será puesto un nombre nuevo, que la boca de Jehová nombrará.", "words": [[0, 12358], [9, 12942], [15, 13435], [19, 13929], [26, 14422], [29, 14502], [39, 15202], [41, 15602], [47, 15962], [51, 16422], [57, 17002], [60, 17022], [68, 17850], [70, 17949], [73, 18069], [78, 18309], [85, 18569], [88, 18829], [95, 19149], [102, 19669], [106, 20209], [109, 20329], [114, 20569], [117, 20769], [124, 21249]]}, {"verse": 3, "start": 22460, "end": 28217, "text": "Y serás corona de gloria en la mano de Jehová, y diadema de reino en la mano del Dios tuyo.", "words": [[0, 22460], [2, 22577], [8, 22897], [15, 23257], [18, 23497], [25, 23857], [28, 23997], [31, 24097], [36, 24317], [39, 24497], [47, 24957], [49, 25077], [57, 25657], [60, 25817], [66, 26317], [69, 26797], [72, 26937], [77, 27197], [81, 27417], [86, 27617]]}, {"verse": 4, "start": 28667, "end": 43344, "text": "Nunca más te llamarán Desamparada, ni tu tierra se dirá más Asolamiento; sino que serás llamada Hefzi-bá, y tu tierra, Beula; porque el amor de Jehová será en ti, y tu tierra será casada.", "words": [[0, 28667], [6, 29211], [10, 29371], [13, 29491], [22, 29971], [35, 31171], [38, 31491], [41, 31671], [48, 32031], [51, 32291], [56, 32651], [60, 32891], [73, 34528], [78, 34773], [82, 34993], [88, 35393], [96, 36133], [106, 36873], [108, 37313], [111, 37453], [119, 38254], [126, 39296], [133, 39520], [136, 39720], [141, 39980], [144, 40180], [151, 40560], [156, 40780], [159, 41080], [163, 41360], [165, 41800], [168, 41940], [175, 42240], [180, 42600]]}, {"verse": 5, "start": 43794, "end": 53281, "text": "Pues como el joven se casa con la virgen, se casarán contigo tus hijos; y como el gozo del esposo con la esposa, así se gozará contigo el Dios tuyo.", "words": [[0, 43794], [5, 43936], [10, 44156], [13, 44296], [19, 44696], [22, 44816], [27, 45076], [31, 45336], [34, 45496], [42, 46196], [45, 46376], [53, 46856], [61, 47336], [65, 47516], [72, 48511], [74, 48596], [79, 48836], [82, 48976], [87, 49336], [91, 49536], [98, 49956], [102, 50136], [105, 50276], [113, 50816], [117, 51196], [120, 51396], [127, 51836], [135, 52396], [138, 52496], [143, 52676]]}, {"verse": 6, "start": 53731, "end": 64263, "text": "Sobre tus muros, oh Jerusalén, he puesto guardas; todo el día y toda la noche no callarán jamás. Los que os acordáis de Jehová, no ceséis,", "words": [[0, 53731], [6, 54076], [10, 54316], [17, 54686], [20, 55056], [31, 55856], [34, 55996], [41, 56256], [50, 57540], [55, 57684], [58, 57944], [62, 58244], [64, 58424], [69, 58624], [72, 58824], [78, 59204], [81, 59864], [90, 60404], [97, 61356], [101, 61651], [105, 61811], [108, 61951], [117, 62531], [120, 62711], [128, 63351], [131, 63807]]}, {"verse": 7, "start": 64713, "end": 71575, "text": "Ni le deis tregua, hasta que confirme, y hasta que ponga a Jerusalén en alabanza en la tierra.", "words": [[0, 64713], [3, 64839], [6, 64999], [11, 65279], [19, 65879], [25, 66299], [29, 66479], [39, 67239], [41, 67599], [47, 67759], [51, 67919], [57, 68379], [59, 68559], [69, 69339], [72, 69539], [81, 70279], [84, 70759], [87, 70899]]}, {"verse": 8, "start": 72025, "end": 83123, "text": "Juró Jehová por su mano derecha, y por el brazo de su fortaleza: Que jamás daré tu trigo por comida a tus enemigos, ni beberán los extraños el vino que tú trabajaste:", "words": [[0, 72025], [5, 72412], [12, 72852], [16, 73012], [19, 73192], [24, 73432], [33, 74152], [35, 74452], [39, 74672], [42, 74812], [48, 75232], [51, 75372], [54, 75512], [65, 76739], [69, 76823], [75, 77323], [80, 77643], [83, 77723], [89, 78063], [93, 78283], [100, 78703], [102, 78863], [106, 78983], [116, 79863], [119, 80203], [127, 80663], [131, 80823], [140, 81443], [143, 81663], [148, 81903], [152, 82103], [155, 82263]]}, {"verse": 9, "start": 83827, "end": 91091, "text": "Mas los que lo juntaron lo comerán, y alabarán a Jehová; y los que lo cogieron, lo beberán en los atrios de mi santuario.", "words": [[0, 83827], [4, 83964], [8, 84144], [12, 84324], [15, 84424], [24, 84884], [27, 85044], [36, 85624], [38, 85864], [47, 86324], [49, 86404], [57, 87452], [59, 87531], [63, 87671], [67, 87811], [70, 87931], [80, 88471], [83, 88931], [91, 89411], [94, 89511], [98, 89611], [105, 90051], [108, 90171], [111, 90271]]}, {"verse": 10, "start": 91673, "end": 102831, "text": "Pasad, pasad por las puertas; barred el camino al pueblo; allanad, allanad la calzada, quitad las piedras, alzad pendón a los pueblos.", "words": [[0, 91673], [7, 92318], [13, 92958], [17, 93158], [21, 93318], [30, 94431], [37, 94918], [40, 95178], [47, 95558], [50, 95778], [58, 96810], [67, 97728], [75, 98308], [78, 98468], [87, 99108], [94, 99748], [98, 99928], [107, 100788], [113, 101298], [120, 101808], [122, 101968], [126, 102088]]}, {"verse": 11, "start": 103281, "end": 115363, "text": "He aquí que Jehová hizo oír hasta lo último de la tierra: Decid a la hija de Sion: He aquí viene tu Salvador; he aquí su recompensa con él, y delante de él su obra.", "words": [[0, 103337], [3, 103427], [8, 103647], [12, 103827], [19, 104367], [24, 104627], [28, 105207], [34, 105407], [37, 105587], [44, 105907], [47, 106127], [50, 106227], [58, 107149],