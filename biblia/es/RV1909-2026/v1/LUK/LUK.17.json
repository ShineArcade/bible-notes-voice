{"book": "LUK", "chapter": 17, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 278629, "verses": [{"verse": 1, "start": 300, "end": 8229, "text": "Y A SUS discípulos dice: Imposible es que no vengan escándalos; pero ¡ay de aquel por quien vienen!", "words": [[0, 300], [2, 443], [4, 543], [8, 683], [19, 1523], [25, 2822], [35, 3182], [38, 3362], [42, 3462], [45, 3642], [52, 4022], [64, 5308], [69, 5680], [73, 6090], [76, 6490], [82, 6930], [86, 7150], [92, 7410]]}, {"verse": 2, "start": 8679, "end": 18335, "text": "Mejor le fuera, si le pusiesen al cuello una piedra de molino, y le lanzasen en el mar, que escandalizar a uno de estos pequeñitos.", "words": [[0, 8679], [6, 9064], [9, 9244], [16, 9644], [19, 10184], [22, 10324], [31, 10824], [34, 11104], [41, 11504], [45, 11724], [52, 12204], [55, 12324], [63, 13064], [65, 13364], [68, 13484], [77, 14304], [80, 14444], [83, 14604], [88, 14884], [92, 15344], [105, 16384], [107, 16644], [111, 16844], [114, 17024], [120, 17264]]}, {"verse": 3, "start": 18785, "end": 25909, "text": "Mirad por vosotros: si peca contra ti tu hermano, repréndele; y si se arrepiente, perdónale.", "words": [[0, 18785], [6, 19233], [10, 19573], [20, 20696], [23, 20841], [28, 21261], [35, 21581], [38, 21921], [41, 22021], [50, 22521], [62, 23782], [64, 23867], [67, 23987], [70, 24187], [82, 24867]]}, {"verse": 4, "start": 26359, "end": 34024, "text": "Y si siete veces al día peca contra ti, y siete veces al día se vuelve a ti, diciendo, me arrepiento, perdónalo.", "words": [[0, 26359], [2, 26466], [5, 26586], [11, 26926], [17, 27206], [20, 27566], [24, 27786], [29, 28326], [36, 28646], [40, 28906], [42, 29286], [48, 29546], [54, 29846], [57, 30086], [61, 30286], [64, 30466], [71, 30826], [73, 30946], [77, 31086], [87, 31686], [90, 32206], [102, 32946]]}, {"verse": 5, "start": 34474, "end": 38065, "text": "Y dijeron los apóstoles al Señor: Auméntanos la fe.", "words": [[0, 34474], [2, 34597], [10, 35057], [14, 35197], [24, 35857], [27, 36077], [34, 36889], [45, 37537], [48, 37717]]}, {"verse": 6, "start": 38415, "end": 50740, "text": "Entonces el Señor dijo: Si tuvieseis fe como un grano de mostaza, diréis a este sicómoro: Desarráigate, y plántate en el mar; y os obedecerá.", "words": [[0, 38415], [9, 38889], [12, 39249], [18, 39549], [24, 40470], [27, 40931], [37, 41411], [40, 41731], [45, 42051], [48, 42231], [54, 42591], [57, 42691], [66, 43791], [73, 44431], [75, 44631], [80, 45276], [90, 46707], [104, 47277], [106, 47717], [115, 48437], [118, 48617], [121, 48737], [126, 49501], [128, 49587], [131, 49674]]}, {"verse": 7, "start": 51190, "end": 59091, "text": "¿Y quién de vosotros tiene un siervo que ara o apacienta, que vuelto del campo le diga enseguida: Pasa, siéntate a la mesa?", "words": [[0, 51190], [3, 51332], [9, 51532], [12, 51692], [21, 52172], [27, 52472], [30, 52672], [37, 53172], [41, 53332], [45, 53692], [47, 53972], [58, 54812], [62, 54872], [69, 55312], [73, 55452], [79, 56092], [82, 56272], [87, 56452], [98, 57563], [104, 58047], [113, 58467], [115, 58587], [118, 58687]]}, {"verse": 8, "start": 59541, "end": 69042, "text": "¿No le dice antes: Prepárame la cena, y arremángate, y sírveme hasta que haya comido y bebido; y después de esto, come tú y bebe?", "words": [[0, 59541], [4, 59840], [7, 59960], [12, 60200], [19, 61159], [29, 61743], [32, 61883], [38, 62183], [40, 62383], [53, 63183], [55, 63583], [63, 64163], [69, 64623], [73, 64803], [78, 64983], [85, 65523], [87, 65643], [95, 66481], [97, 66588], [105, 66848], [108, 67048], [114, 67788], [119, 68008], [122, 68308], [124, 68608]]}, {"verse": 9, "start": 69492, "end": 74691, "text": "¿Da gracias al siervo porque hizo lo que le había sido mandado? Pienso que no.", "words": [[0, 69492], [4, 69714], [12, 70114], [15, 70434], [22, 70874], [29, 71174], [34, 71594], [37, 71874], [41, 72014], [44, 72154], [50, 72354], [55, 72714], [64, 73795], [71, 74160], [75, 74320]]}, {"verse": 10, "start": 75141, "end": 85152, "text": "Así también vosotros, cuando hayáis hecho todo lo que os es mandado, decid: Siervos inútiles somos, porque lo que debíamos hacer, hicimos.", "words": [[0, 75141], [4, 75370], [12, 75710], [22, 76370], [29, 76670], [36, 77230], [42, 77450], [47, 77790], [50, 78050], [54, 78210], [57, 78390], [60, 78570], [69, 79670], [76, 80858], [84, 81138], [93, 81798], [100, 82678], [107, 83018], [110, 83198], [114, 83338], [123, 83798], [130, 84258]]}, {"verse": 11, "start": 85602, "end": 91643, "text": "Y aconteció que yendo él a Jerusalén, pasaba por medio de Samaria y de Galilea.", "words": [[0, 85602], [2, 85747], [12, 86487], [16, 86727], [22, 87027], [25, 87367], [27, 87607], [38, 88887], [45, 89367], [49, 89607], [55, 89887], [58, 90107], [66, 90627], [68, 90807], [71, 90907]]}, {"verse": 12, "start": 92093, "end": 99705, "text": "Y entrando en una aldea, le vinieron al encuentro diez hombres leprosos, los cuales se pararon de lejos,", "words": [[0, 92093], [2, 92219], [11, 92699], [14, 92899], [18, 93139], [25, 94199], [28, 94419], [37, 94879], [40, 95059], [50, 95659], [55, 95839], [63, 96379], [73, 97419], [77, 97539], [84, 97939], [87, 98439], [95, 98959], [98, 99099]]}, {"verse": 13, "start": 100155, "end": 105800, "text": "Y alzaron la voz, diciendo: Jesús, Maestro, ten misericordia de nosotros.", "words": [[0, 100155], [2, 100280], [10, 100780], [13, 100940], [18, 101300], [28, 102593], [35, 103237], [44, 104077], [48, 104157], [61, 104937], [64, 105037]]}, {"verse": 14, "start": 106150, "end": 114094, "text": "Y como él los vio, les dijo: Id, mostraos a los sacerdotes. Y aconteció, que yendo ellos, fueron limpios.", "words": [[0, 106150], [2, 106272], [7, 106512], [10, 106772], [14, 106912], [19, 107172], [23, 107292], [29, 108260], [33, 108380], [42, 109520], [44, 109640], [48, 109780], [60, 111243], [62, 111342], [73, 112002], [77, 112212], [83, 112422], [90, 112742], [97, 113142]]}, {"verse": 15, "start": 114544, "end": 121362, "text": "Entonces uno de ellos, como se vio que estaba limpio, volvió, glorificando a Dios a gran voz;", "words": [[0, 114544], [9, 115068], [13, 115608], [16, 115808], [23, 116188], [28, 116488], [31, 116688], [35, 116908], [39, 117028], [46, 117248], [54, 118348], [62, 119668], [75, 120148], [77, 120288], [82, 120428], [84, 120668], [89, 120828]]}, {"verse": 16, "start": 121812, "end": 127630, "text": "Y se postró sobre el rostro a sus pies, dándole gracias: y este era samaritano.", "words": [[0, 121812], [2, 121919], [5, 122059], [12, 122519], [18, 122819], [21, 123039], [28, 123499], [30, 123599], [34, 123759], [40, 124479], [48, 124859], [57, 125982], [59, 126121], [64, 126361], [68, 126601]]}, {"verse": 17, "start": 128080, "end": 134275, "text": "Y respondiendo Jesús, dijo: ¿No son diez los que fueron limpios? ¿Y los nueve dónde están?", "words": [[0, 128080], [2, 128204], [15, 128944], [22, 129664], [28, 130448], [32, 130598], [36, 130848], [41, 131098], [45, 131398], [49, 131558], [56, 131838], [65, 132930], [68, 133039], [72, 133159], [78, 133479], [84, 133619]]}, {"verse": 18, "start": 134725, "end": 139168, "text": "¿No hubo quien volviese y diese gloria a Dios sino este extranjero?", "words": [[0, 134725], [4, 134912], [9, 135232], [15, 135412], [24, 136052], [26, 136312], [32, 136572], [39, 137092], [41, 137272], [46, 137572], [51, 138232], [56, 138292]]}, {"verse": 19, "start": 139618, "end": 143583, "text": "Y le dijo: Levántate, vete; tu fe te ha salvado.", "words": [[0, 139618], [2, 139760], [5, 139880], [11, 140754], [22, 141521], [28, 142283], [31, 142385], [34, 142585], [37, 142745], [40, 142825]]}, {"verse": 20, "start": 144033, "end": 154260, "text": "Y preguntado por los fariseos, cuándo había de venir el reino de Dios, les respondió y dijo: El reino de Dios no vendrá con advertencia;", "words": [[0, 144033], [2, 144138], [13, 144798], [17, 145038], [21, 145198], [31, 146138], [38, 146678], [44, 147138], [47, 147318], [53, 147618], [56, 147878], [62, 148238], [65, 148398], [71, 149238], [75, 149418], [85, 150378], [87, 150478], [93, 151234], [96, 151379], [102, 151759], [105, 151919], [110, 152159], [113, 152459], [120, 152939], [124, 153139]]}, {"verse": 21, "start": 154710, "end": 161784, "text": "Ni dirán: Está aquí, o está allí: porque he aquí el reino de Dios entre vosotros está.", "words": [[0, 155033], [3, 155391], [10, 156031], [15, 156396], [21, 156716], [23, 157236], [28, 157496], [34, 158282], [41, 158503], [44, 158783], [49, 159103], [52, 159263], [58, 159663], [61, 159803], [66, 160103], [72, 160563], [81, 161403]]}, {"verse": 22, "start": 162234, "end": 169724, "text": "Y dijo a sus discípulos: Tiempo vendrá, cuando desearéis ver uno de los días del Hijo del hombre, y no lo veréis.", "words": [[0, 162234], [2, 162594], [7, 162834], [9, 162994], [13, 163114], [25, 164361], [32, 164726], [40, 165146], [47, 165386], [57, 166286], [61, 166546], [65, 166906], [68, 167066], [72, 167206], [77, 167466], [81, 167726], [86, 167986], [90, 168146], [98, 168586], [100, 168746], [103, 168886], [106, 169006]]}, {"verse": 23, "start": 170174, "end": 174878, "text": "Y os dirán: Está aquí, o está allí. No vayáis, ni sigáis.", "words": [[0, 170174], [2, 170322], [5, 170422], [12, 171297], [17, 171602], [23, 171882], [25, 172282], [30, 172542], [36, 173300], [39, 173429], [47, 173889], [50, 174149]]}, {"verse": 24, "start": 175328, "end": 187307, "text": "Porque como el relámpago, relampagueando desde una parte de debajo del cielo, resplandece hasta la otra debajo del cielo, así también será el Hijo del hombre en su día.", "words": [[0, 175328], [7, 175573], [12, 175953], [15, 176173], [26, 177533], [41, 178673], [47, 178933], [51, 179173], [57, 179553], [60, 179753], [67, 180153], [71, 180393], [78, 181773], [90, 182413], [96, 182633], [99, 182813], [104, 183013], [111, 183453], [115, 183653], [122, 184253], [126, 184433], [134, 184853], [139, 185213], [142, 185533], [147, 185793], [151, 185993], [158, 186313], [161, 186653], [164, 186813]]}, {"verse": 25, "start": 187757, "end": 194167, "text": "Pero primero es necesario que padezca mucho, y sea rechazado por esta generación.", "words": [[0, 187757], [5, 187920], [13, 188320], [16, 188540], [26, 189200], [30, 189520], [38, 190100], [45, 190460], [47, 191300], [51, 191660], [61, 192740], [65, 193000], [70, 193180]]}, {"verse": 26, "start": 194617, "end": 200115, "text": "Y como fue en los días de Noé, así también será en los días del Hijo del hombre.", "words": [[0, 194617], [2, 194874], [7, 195114], [11, 195414], [14, 195654], [18, 195794], [23, 196034], [26, 196214], [31, 196934], [35, 197134], [43, 197654], [48, 198094], [51, 198494], [55, 198654], [60, 198894], [64, 199154], [69, 199374], [73, 199574]]}, {"verse": 27, "start": 200565, "end": 211305, "text": "Comían, bebían, se casaban y se daban en casamiento, hasta el día que entró Noé en el arca; y vino el diluvio, y destruyó a todos.", "words": [[0, 200565], [8, 201129], [16, 201989], [19, 202089], [27, 202789], [29, 203309], [32, 203429], [38, 203729], [41, 203869], [53, 205049], [59, 205429], [62, 205589], [66, 205769], [70, 205949], [76, 206429], [80, 206909], [83, 207149], [86, 207289], [92, 208191], [94, 208297], [99, 208517], [102, 208677], [111, 209357], [113, 209737], [122, 210457], [124, 210657]]}, {"verse": 28, "start": 211755, "end": 219775, "text": "Asimismo también como fue en los días de Lot; comían, bebían, compraban, vendían, plantaban, edificaban;", "words": [[0, 211755], [9, 212439], [17, 212799], [22, 213239], [26, 213579], [29, 213759], [33, 213899], [38, 214218], [41, 214537], [46, 215110], [54, 215754], [62, 216374], [73, 217214], [82, 217874], [93, 218854]]}, {"verse": 29, "start": 220225, "end": 226678, "text": "Pero el día que Lot salió de Sodoma, llovió del cielo fuego y azufre, y destruyó a todos:", "words": [[0, 220225], [5, 220369], [8, 220529], [12, 220729], [16, 220929], [20, 221149], [26, 221709], [29, 221849], [37, 222949], [44, 223329], [48, 223469], [54, 223789], [60, 224249], [62, 224629], [70, 225009], [72, 225389], [81, 225989], [83, 226109]]}, {"verse": 30, "start": 227128, "end": 230781, "text": "Como esto será el día en que el Hijo del hombre se manifestará.", "words": [[0, 227128], [5, 227311], [10, 227571], [15, 227951], [18, 228191], [22, 228431], [25, 228651], [29, 228791], [32, 228951], [37, 229211], [41, 229371], [48, 229631], [51, 229831]]}, {"verse": 31, "start": 231231, "end": 241788, "text": "En aquel día, el que esté en la azotea, y sus bienes en casa, no descienda a tomarlos: y el que en el campo, asimismo no vuelva atrás.", "words": [[0, 231231], [3, 231370], [9, 231730], [14, 231970], [17, 232290], [21, 232490], [26, 232810], [29, 233170], [32, 233350], [40, 234130], [42, 234270], [46, 234450], [53, 234810], [56, 234950], [62, 235270], [65, 235890], [75, 236490], [77, 236690], [87, 237837], [89, 238001], [92, 238181], [96, 238361], [99, 238661], [102, 238821], [109, 239401], [118, 240641], [121, 240781], [128, 241161]]}, {"verse": 32, "start": 242238, "end": 244543, "text": "Acordaos de la mujer de Lot.", "words": [[0, 242638], [9, 243038], [12, 243258], [15, 243358], [21, 243688], [24, 244018]]}, {"verse": 33, "start": 244993, "end": 250547, "text": "Todo el que procure salvar su vida, la perderá; y todo el que la pierda, la salvará.", "words": [[0, 244993], [5, 245167], [8, 245377], [12, 245477], [20, 245897], [27, 246337], [30, 246657], [36, 246937], [39, 247097], [48, 248139], [50, 248281], [55, 248481], [58, 248701], [62, 248841], [65, 248981], [73, 249581], [76, 249881]]}, {"verse": 34, "start": 250997, "end": 257138, "text": "Os digo que en aquella noche estarán dos en una cama; el uno será tomado, y el otro será dejado.", "words": [[0, 250997], [3, 251104], [8, 251364], [12, 251624], [15, 251784], [23, 252144], [29, 252324], [37, 252864], [41, 253024], [44, 253244], [48, 253444], [54, 254248], [57, 254393], [61, 254613], [66, 254833], [74, 255473], [76, 255733], [79, 255893], [84, 256133], [89, 256433]]}, {"verse": 35, "start": 257588, "end": 263294, "text": "Dos mujeres estarán moliendo juntas: la una será tomada, y la otra dejada.", "words": [[0, 257588], [4, 257778], [12, 258218], [20, 258938], [29, 259438], [37, 260590], [40, 260740], [44, 260940], [49, 261180], [57, 261760], [59, 262200], [62, 262340], [67, 262847]]}, {"verse": 36, "start": 263744, "end": 268925, "text": "Dos estarán en el campo; el uno será tomado, y el otro dejado.", "words": [[0, 263744], [4, 264049], [12, 264769], [15, 264969], [18, 265089], [25, 266065], [28, 266213], [32, 266433], [37, 266653], [45, 267373], [47, 267773], [50, 267913], [55, 268133]]}, {"verse": 37, "start": 269375, "end": 278229, "text": "Y respondiendo, le dicen: ¿Dónde, Señor? Y él les dijo: Donde esté el cuerpo, allá se juntarán también las águilas.", "words": [[0, 269375], [2, 269711], [16, 270077], [19, 270444], [26, 271440], [34, 271779], [41, 272624], [43, 272806], [46, 272946], [50, 273086], [56, 273959], [62, 274206], [67, 274546], [70, 274826], [78, 275746], [83, 275966], [86, 276206], [95, 276866], [103, 277166], [107, 277446]]}]}