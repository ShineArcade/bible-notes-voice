{"book": "GEN", "chapter": 24, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 575347, "verses": [{"verse": 1, "start": 300, "end": 6962, "text": "Y Abraham era viejo, y bien entrado en días; y Jehová había bendecido a Abraham en todo.", "words": [[0, 300], [2, 444], [10, 784], [14, 1164], [21, 1744], [23, 2284], [28, 2544], [36, 3104], [39, 3224], [45, 4044], [47, 4169], [54, 4629], [60, 4909], [70, 5689], [72, 5849], [80, 6189], [83, 6469]]}, {"verse": 2, "start": 7312, "end": 17084, "text": "Y dijo Abraham a un criado suyo, el más viejo de su casa, que era el que gobernaba en todo lo que tenía: Pon ahora tu mano debajo de mi muslo,", "words": [[0, 7312], [2, 7419], [7, 7719], [15, 8139], [17, 8399], [20, 8519], [27, 9019], [33, 9979], [36, 10159], [40, 10359], [46, 10879], [49, 10999], [52, 11159], [58, 11999], [62, 12139], [66, 12339], [69, 12499], [73, 12639], [83, 13339], [86, 13559], [91, 13799], [94, 14019], [98, 14139], [105, 14939], [109, 15083], [115, 15343], [118, 15563], [123, 15803], [130, 16263], [133, 16403], [136, 16523]]}, {"verse": 3, "start": 17434, "end": 27350, "text": "Y te juramentaré por Jehová, Dios de los cielos y Dios de la tierra, que no has de tomar mujer para mi hijo de las hijas de los cananeos, entre los cuales yo habito;", "words": [[0, 17434], [2, 17538], [5, 17658], [17, 18358], [21, 18558], [29, 19478], [34, 19798], [37, 19998], [41, 20138], [48, 20598], [50, 20718], [55, 20918], [58, 21038], [61, 21138], [69, 21858], [73, 21978], [76, 22158], [80, 22278], [83, 22378], [89, 22638], [95, 22938], [100, 23238], [103, 23458], [108, 23658], [111, 23798], [115, 23958], [121, 24278], [124, 24378], [128, 24498], [138, 25518], [144, 25742], [148, 25902], [155, 26162], [158, 26442]]}, {"verse": 4, "start": 27700, "end": 32576, "text": "Sino que irás a mi tierra y a mi parentela, y tomarás mujer para mi hijo Isaac.", "words": [[0, 27700], [5, 27895], [9, 28115], [14, 28435], [16, 28555], [19, 28675], [26, 28995], [28, 29195], [30, 29255], [33, 29335], [44, 30015], [46, 30455], [54, 30895], [60, 31155], [65, 31515], [68, 31715], [73, 31955]]}, {"verse": 5, "start": 32856, "end": 41091, "text": "Y el criado le respondió: Quizá la mujer no querrá venir en pos de mí a esta tierra: ¿volveré, pues, tu hijo a la tierra de donde saliste?", "words": [[0, 32856], [2, 32978], [5, 33078], [12, 33598], [15, 33758], [26, 34824], [32, 35188], [35, 35288], [41, 35528], [44, 35768], [51, 36108], [57, 36368], [60, 36588], [64, 36728], [67, 36928], [70, 37148], [72, 37268], [77, 37488], [85, 38333], [95, 38874], [101, 39274], [104, 39334], [109, 39514], [111, 39654], [114, 39714], [121, 39974], [124, 40174], [130, 40334]]}, {"verse": 6, "start": 41371, "end": 45561, "text": "Y Abraham le dijo: Guárdate que no lleves otra vez a mi hijo allá.", "words": [[0, 41371], [2, 41539], [10, 41919], [13, 42239], [19, 42958], [28, 43394], [32, 43594], [35, 43734], [42, 44014], [47, 44234], [51, 44534], [53, 44774], [56, 44934], [61, 45174]]}, {"verse": 7, "start": 45911, "end": 60505, "text": "Jehová, Dios de los cielos, que me tomó de la casa de mi padre y de la tierra de mi parentela, y me habló y me juró, diciendo: A tu descendencia daré esta tierra; él enviará su ángel delante de ti, y tú tomarás de allá mujer para mi hijo.", "words": [[0, 45911], [8, 46484], [13, 46744], [16, 46984], [20, 47124], [28, 47824], [32, 47884], [35, 47984], [40, 48304], [43, 48384], [46, 48504], [51, 48784], [54, 48984], [57, 49084], [63, 49544], [65, 49624], [68, 49704], [71, 49804], [78, 50084], [81, 50304], [84, 50404], [95, 51564], [97, 51604], [100, 51724], [106, 52124], [108, 52204], [111, 52324], [117, 52704], [127, 53674], [129, 53775], [132, 53895], [145, 54635], [150, 54935], [155, 55095], [163, 55835], [166, 55980], [174, 56420], [177, 56600], [183, 56960], [191, 57380], [194, 57520], [198, 57800], [200, 58280], [203, 58400], [211, 58900], [214, 59040], [219, 59200], [225, 59540], [230, 59880], [233, 60060]]}, {"verse": 8, "start": 60855, "end": 68373, "text": "Y si la mujer no quiere venir en pos de ti, serás libre de este mi juramento; solamente que no lleves otra vez allá a mi hijo.", "words": [[0, 60855], [2, 60936], [5, 61056], [8, 61176], [14, 61396], [17, 61636], [24, 61836], [30, 62156], [33, 62336], [37, 62516], [40, 62716], [44, 63136], [50, 63496], [56, 63776], [59, 64016], [64, 64216], [67, 64396], [78, 65423], [88, 65806], [92, 66146], [95, 66306], [102, 66706], [107, 66926], [111, 67286], [116, 67586], [118, 67826], [121, 67926]]}, {"verse": 9, "start": 68653, "end": 76578, "text": "Entonces el criado puso su mano debajo del muslo de Abraham su señor, y le juró sobre este negocio.", "words": [[0, 68653], [9, 69196], [12, 69556], [19, 70056], [24, 70476], [27, 70676], [32, 70976], [39, 71416], [43, 71656], [49, 72156], [52, 72316], [60, 73356], [63, 73556], [70, 74636], [72, 74716], [75, 74856], [80, 75256], [86, 75476], [91, 75756]]}, {"verse": 10, "start": 76928, "end": 90963, "text": "Y el criado tomó diez camellos de los camellos de su señor, y se fue, pues tenía a su disposición todos los bienes de su señor: y puesto en camino, llegó a Mesopotamia, a la ciudad de Nacor.", "words": [[0, 76928], [2, 77228], [5, 77328], [12, 77808], [17, 78248], [22, 78588], [31, 79348], [34, 79468], [38, 79568], [47, 80068], [50, 80148], [53, 80288], [60, 80688], [62, 80933], [65, 81073], [70, 81733], [75, 82063], [81, 82393], [83, 82573], [86, 82733], [98, 83553], [104, 84073], [108, 84373], [115, 84853], [118, 85033], [121, 85213], [128, 86073], [130, 86193], [137, 86433], [140, 86613], [148, 87573], [154, 87973], [156, 88153], [169, 89373], [171, 89573], [174, 89653], [181, 89993], [184, 90496]]}, {"verse": 11, "start": 91313, "end": 101216, "text": "E hizo arrodillar los camellos fuera de la ciudad, junto a un pozo de agua, a la hora de la tarde, a la hora en que salen las doncellas por agua.", "words": [[0, 91313], [2, 91755], [7, 92015], [18, 92715], [22, 93105], [31, 93495], [37, 93835], [40, 94055], [43, 94175], [51, 94555], [57, 95115], [59, 95355], [62, 95455], [67, 95795], [70, 95975], [76, 96335], [78, 96630], [81, 96770], [86, 97050], [89, 97210], [92, 97350], [99, 98189], [101, 98373], [104, 98493], [109, 98813], [112, 99013], [116, 99133], [122, 99613], [126, 99813], [136, 100553], [140, 100733]]}, {"verse": 12, "start": 101566, "end": 108866, "text": "Y dijo: Jehová, Dios de mi señor Abraham, te ruego que hoy me vaya bien y muestres misericordia a mi señor Abraham.", "words": [[0, 101566], [2, 101713], [8, 102431], [16, 102922], [21, 103062], [24, 103262], [27, 103649], [33, 104035], [42, 104422], [45, 104662], [51, 104942], [55, 105142], [59, 105322], [62, 105482], [67, 105702], [72, 106042], [74, 106322], [83, 106982], [96, 107642], [98, 107842], [101, 108202], [107, 108562]]}, {"verse": 13, "start": 109216, "end": 114161, "text": "He aquí yo estoy junto a la fuente de agua, y las hijas de los varones de esta ciudad salen por agua:", "words": [[0, 109266], [3, 109356], [8, 109596], [11, 109756], [17, 109956], [23, 110156], [25, 110356], [28, 110396], [35, 110696], [38, 110856], [44, 111116], [46, 111281], [50, 111441], [56, 111761], [59, 111861], [63, 111961], [71, 112381], [74, 112541], [79, 112721], [86, 113081], [92, 113681], [96, 113841]]}, {"verse": 14, "start": 114511, "end": 130985, "text": "Sea, pues, que la doncella a quien yo diga: Baja tu cántaro, te ruego, para que yo beba; y ella responda: Bebe, y también daré de beber a tus camellos: que sea esta la que tú has destinado para tu siervo Isaac; y en esto conoceré que habrás hecho misericordia con mi señor.", "words": [[0, 114600], [5, 114660], [11, 114940], [15, 115280], [18, 115400], [27, 115880], [29, 116020], [35, 116100], [38, 116280], [44, 116876], [49, 117243], [52, 117403], [61, 117750], [64, 118096], [71, 118443], [76, 118743], [80, 118903], [83, 119043], [89, 119752], [91, 119892], [96, 120012], [106, 121264], [112, 121534], [114, 121674], [122, 121934], [127, 122374], [130, 122454], [136, 122694], [138, 122854], [142, 122994], [152, 123989], [156, 124089], [160, 124309], [165, 124649], [168, 124809], [172, 124969], [175, 125129], [179, 125309], [189, 125889], [194, 126089], [197, 126369], [204, 126649], [211, 127833], [213, 127949], [216, 128029], [221, 128249], [230, 128809], [234, 128929], [241, 129249], [247, 129449], [260, 130189], [264, 130369], [267, 130489]]}, {"verse": 15, "start": 131265, "end": 144656, "text": "Y aconteció que antes que él acabase de hablar, he aquí Rebeca, que había nacido a Betuel, hijo de Milca, mujer de Nacor hermano de Abraham, la cual salía con su cántaro sobre su hombro.", "words": [[0, 131265], [2, 131408], [12, 132108], [16, 132508], [22, 132908], [26, 133228], [29, 133548], [37, 134248], [40, 134428], [48, 135248], [51, 135368], [56, 136048], [64, 136728], [68, 136808], [74, 136988], [81, 137448], [83, 137588], [91, 138408], [96, 138568], [99, 138958], [106, 139348], [112, 139528], [115, 139828], [121, 140128], [129, 140528], [132, 140648], [141, 141451], [144, 141596], [149, 141816], [155, 142316], [159, 142536], [162, 142776], [170, 143376], [176, 143736], [179, 143976]]}, {"verse": 16, "start": 145006, "end": 156087, "text": "Y la doncella era de muy hermoso aspecto, virgen, a la que varón no había conocido; la cual descendió a la fuente, y llenó su cántaro, y se volvía.", "words": [[0, 145006], [2, 145255], [5, 145625], [14, 145995], [18, 146175], [21, 146355], [25, 146555], [33, 147135], [42, 147815], [50, 148915], [52, 148995], [55, 149095], [59, 149405], [65, 149715], [68, 150095], [74, 150495], [84, 151696], [87, 151822], [92, 152062], [102, 152702], [104, 152822], [107, 152902], [115, 153402], [117, 153942], [123, 154302], [126, 154442], [135, 155082], [137, 155222], [140, 155362]]}, {"verse": 17, "start": 156437, "end": 163060, "text": "Entonces el criado corrió hacia ella, y dijo: Te ruego que me des a beber un poco de agua de tu cántaro.", "words": [[0, 156437], [9, 157357], [12, 157557], [19, 157977], [26, 158437], [32, 158677], [38, 159077], [40, 159297], [46, 160027], [49, 160146], [55, 160446], [59, 160606], [62, 160746], [66, 160946], [68, 161086], [74, 161286], [77, 161526], [82, 161766], [85, 161986], [90, 162206], [93, 162366], [96, 162486]]}, {"verse": 18, "start": 163340, "end": 170618, "text": "Y ella respondió: Bebe, señor mío: y se dio prisa a bajar su cántaro sobre su mano, y le dio a beber.", "words": [[0, 163340], [2, 163502], [7, 163742], [18, 164920], [24, 165090], [30, 165390], [35, 166249], [37, 166350], [40, 166490], [44, 166690], [50, 167150], [52, 167310], [58, 167690], [61, 167850], [69, 168430], [75, 168770], [78, 169010], [84, 169390], [86, 169625], [89, 169745], [93, 170005], [95, 170165]]}, {"verse": 19, "start": 170968, "end": 177936, "text": "Y cuando acabó de darle a beber, dijo: También para tus camellos sacaré agua, hasta que acaben de beber.", "words": [[0, 170968], [2, 171075], [9, 171275], [15, 171855], [18, 171955], [24, 172255], [26, 172475], [33, 173135], [39, 173997], [47, 174317], [52, 174577], [56, 174757], [65, 175357], [72, 175737], [78, 176117], [84, 176717], [88, 176917], [95, 177337], [98, 177437]]}, {"verse": 20, "start": 178216, "end": 187440, "text": "Y se dio prisa, y vació su cántaro en la pila, y corrió otra vez al pozo para sacar agua, y sacó para todos sus camellos.", "words": [[0, 178216], [2, 178360], [5, 178460], [9, 178660], [16, 179580], [18, 179660], [24, 180020], [27, 180180], [35, 180740], [38, 180900], [41, 181040], [47, 181900], [49, 182080], [56, 182520], [61, 182840], [65, 183120], [68, 183400], [73, 183940], [78, 184360], [84, 184580], [90, 185000], [92, 185440], [97, 185840], [102, 186040], [108, 186320], [112, 186660]]}, {"verse": 21, "start": 187790, "end": 195741, "text": "Y el hombre estaba maravillado de ella, callando, para saber si Jehová había prosperado o no su viaje.", "words": [[0, 187790], [2, 187920], [5, 188040], [12, 188300], [19, 188660], [31, 189480], [34, 189680], [40, 190480], [50, 191240], [55, 191980], [61, 192360], [64, 192600], [71, 193180], [77, 193520], [88, 194540], [90, 194740], [93, 194880], [96, 195080]]}, {"verse": 22, "start": 196091, "end": 206489, "text": "Y aconteció que como los camellos acabaron de beber, le presentó el hombre un pendiente de oro que pesaba medio siclo, y dos brazaletes que pesaban diez:", "words": [[0, 196091], [2, 196267], [12, 197087], [16, 197347], [21, 197607], [25, 197787], [34, 198407], [43, 198907], [46, 199087], [53, 199787], [56, 199927], [65, 200487], [68, 200607], [75, 200847], [78, 201067], [88, 201667], [91, 201927], [95, 202147], [99, 202327], [106, 202787], [112, 203317], [119, 203847], [121, 204347], [125, 204527], [136, 205207], [140, 205387], [148, 205887]]}, {"verse": 23, "start": 206839, "end": 213078, "text": "Y dijo: ¿De quién eres hija? Te ruego me digas, ¿hay lugar en casa de tu padre donde podamos hospedarnos?", "words": [[0, 206839], [2, 206985], [8, 207703], [12, 207862], [18, 208022], [23, 208282], [29, 209014], [32, 209113], [38, 209453], [41, 209513], [48, 210193], [53, 210313], [59, 210513], [62, 210713], [67, 210893], [70, 211073], [73, 211193], [79, 211473], [85, 211713], [93, 212193]]}, {"verse": 24, "start": 213358, "end": 219576, "text": "Y ella respondió: Soy hija de Betuel, hijo de Milca, el cual parió ella a Nacor.", "words": [[0, 213358], [2, 213520], [7, 213760], [18, 214768], [22, 215048], [27, 215628], [30, 215708], [38, 216568], [43, 216808], [46, 217338], [53, 217868], [56, 217968], [61, 218188], [67, 218648], [72, 218980], [74, 219313]]}, {"verse": 25, "start": 219856, "end": 225491, "text": "Y añadió: También hay en nuestra casa paja y mucho forraje, y lugar para posar.", "words": [[0, 219856], [2, 219978], [10, 220843], [18, 221106], [22, 221346], [25, 221466], [33, 221626], [38, 221986], [43, 222586], [45, 222846], [51, 223166], [60, 223846], [62, 224286], [68, 224566], [73, 224886]]}, {"verse": 26, "start": 225771, "end": 230110, "text": "El hombre entonces se inclinó, y adoró a Jehová.", "words": [[0, 225771], [3, 225900], [10, 226240], [19, 226840], [22, 227360], [31, 228440], [33, 228700], [39, 229320], [41, 229480]]}, {"verse": 27, "start": 230460, "end": 240688, "text": "Y dijo: Bendito sea Jehová, Dios de mi amo Abraham, que no apartó su misericordia y su verdad de mi amo, guiándome Jehová en el camino a casa de los hermanos de mi amo.", "words": [[0, 230460], [2, 230607], [8, 231325], [16, 231824], [20, 232044], [28, 232544], [33, 232764], [36, 233024], [39, 233184], [43, 233384], [52, 234244], [56, 234444], [59, 234624], [66, 235064], [69, 235184], [82, 236024], [84, 236204], [87, 236364], [94, 236624], [97, 236824], [100, 236984], [105, 237546], [115, 238053], [122, 238453], [125, 238513], [128, 238633], [135, 238933], [137, 239133], [142, 239293], [145, 239513], [149, 239613], [158, 240113], [161, 240213], [164, 240333]]}, {"verse": 28, "start": 240968, "end": 245799, "text": "Y la doncella corrió, e hizo saber en casa de su madre estas cosas.", "words": [[0, 240968], [2, 241094], [5, 241214], [14, 241754], [22, 242314], [24, 242829], [29, 243109], [35, 243469], [38, 243689], [43, 243969], [46, 244209], [49, 244369], [55, 244669], [61, 244969]]}, {"verse": 29, "start": 246149, "end": 252826, "text": "Y Rebeca tenía un hermano que se llamaba Labán, el cual corrió afuera al hombre, a la fuente;", "words": [[0, 246149], [2, 246531], [9, 246951], [15, 247371], [18, 247531], [26, 248031], [30, 248111], [33, 248251], [41, 248691], [48, 249551], [51, 249631], [56, 249891], [63, 250451], [70, 251071], [73, 251331], [81, 252031], [83, 252131], [86, 252231]]}, {"verse": 30, "start": 253176, "end": 266147, "text": "Y aconteció que como vio el pendiente y los brazaletes en las manos de su hermana, que decía, Así me habló aquel hombre; vino a él: y he aquí que estaba junto a los camellos a la fuente.", "words": [[0, 253176], [2, 253299], [12, 254019], [16, 254339], [21, 254519], [25, 254839], [28, 254979], [38, 255799], [40, 255939], [44, 256079], [55, 256799], [58, 257039], [62, 257199], [68, 257519], [71, 257719], [74, 257859], [83, 258679], [87, 258759], [94, 259659], [98, 259859], [101, 260099], [107, 260439], [113, 260739], [121, 261660], [126, 261870], [128, 261990], [132, 262611], [134, 262818], [137, 262938], [142, 263258], [146, 263438], [153, 263758], [159, 264078], [161, 264318], [165, 264418], [174, 265078], [176, 265238], [179, 265338]]}, {"verse": 31, "start": 266497, "end": 273763, "text": "Y le dijo: Ven, bendito de Jehová; ¿por qué estás fuera? yo he limpiado la casa, y el lugar para los camellos.", "words": [[0, 266497], [2, 266618], [5, 266738], [11, 267642], [16, 267886], [24, 268426], [27, 268776], [35, 269331], [40, 269447], [44, 269587], [50, 269747], [57, 270556], [60, 270733], [63, 270853], [72, 271293], [75, 271413], [81, 271733], [83, 272213], [86, 272353], [92, 272593], [97, 272873], [101, 273053]]}, {"verse": 32, "start": 274043, "end": 285775, "text": "Entonces el hombre vino a casa, y Labán desató los camellos; y les dio paja y forraje, y agua para lavar los pies de él, y los pies de los hombres que con él venían.", "words": [[0, 274043], [9, 274547], [12, 275022], [19, 275282], [24, 275602], [26, 275782], [32, 276102], [34, 276430], [40, 276757], [47, 277477], [51, 277657], [61, 278670], [63, 278831], [67, 278971], [71, 279231], [76, 279791], [78, 280171], [87, 280551], [89, 281051], [94, 281371], [99, 281651], [105, 282111], [109, 282511], [114, 282731], [117, 282971], [121, 283231], [123, 283651], [127, 283791], [132, 283971], [135, 284091], [139, 284191], [147, 284531], [151, 284751], [155, 284951], [158, 285071]]}, {"verse": 33, "start": 286125, "end": 293510, "text": "Y le pusieron comida delante; mas él dijo: No comeré hasta que haya dicho mi mensaje. Y él le dijo: Habla.", "words": [[0, 286125], [2, 286214], [5, 286314], [14, 286734], [21, 287370], [30, 288163], [34, 288329], [37, 288723], [43, 289296], [46, 289441], [53, 289841], [59, 290161], [63, 290361], [68, 290521], [74, 290781], [77, 290941], [86, 291880], [88, 292047], [91, 292187], [94, 292347], [100, 293302]]}, {"verse": 34, "start": 293790, "end": 296599, "text": "Entonces dijo: Yo soy criado de Abraham;", "words": [[0, 293790], [9, 294234], [15, 295144], [18, 295270], [22, 295430], [29, 295850], [32, 295990]]}, {"verse": 35, "start": 296949, "end": 305401, "text": "Y Jehová ha bendecido mucho a mi amo, y él se ha engrandecido: y le ha dado ovejas y vacas, plata y oro, siervos y siervas, camellos y asnos.", "words": [[0, 296949], [2, 297053], [9, 297473], [12, 297533], [22, 297993], [28, 298233], [30, 298413], [33, 298553], [38, 298773], [40, 299113], [43, 299253], [46, 299413], [49, 299513], [63, 300507], [65, 300613], [68, 300713], [71, 300833], [76, 301013], [83, 301413], [85, 301573], [92, 302173], [98, 302473], [100, 302693], [105, 303053], [113, 303453], [115, 303593], [124, 304233], [133, 304713], [135, 304833]]}, {"verse": 36, "start": 305751, "end": 311170, "text": "Y Sara, mujer de mi amo, parió en su vejez un hijo a mi señor, quien le ha dado todo cuanto tiene.", "words": [[0, 305751], [2, 305850], [8, 306230], [14, 306410], [17, 306650], [20, 306750], [25, 307150], [31, 307450], [34, 307550], [37, 307780], [43, 308010], [46, 308240], [51, 308470], [53, 308570], [56, 308650], [63, 309330], [69, 309570], [72, 309770], [75, 309850], [80, 310050], [85, 310310], [92, 310590]]}, {"verse": 37, "start": 311520, "end": 318586, "text": "Y mi amo me hizo jurar, diciendo: No tomarás mujer para mi hijo de las hijas de los cananeos, en cuya tierra habito;", "words": [[0, 311520], [2, 311643], [5, 311763], [9, 311923], [12, 312123], [17, 312303], [24, 312743], [34, 313651], [37, 313794], [45, 314294], [51, 314594], [56, 314894], [59, 315094], [64, 315334], [67, 315474], [71, 315634], [77, 315974], [80, 316074], [84, 316194], [94, 317274], [97, 317374], [102, 317654], [109, 317874]]}, {"verse": 38, "start": 318936, "end": 323950, "text": "Sino que irás a la casa de mi padre, y a mi parentela, y tomarás mujer para mi hijo.", "words": [[0, 318936], [5, 319135], [9, 319335], [14, 319675], [16, 319775], [19, 319855], [24, 320095], [27, 320295], [30, 320415], [37, 320735], [39, 321075], [41, 321135], [44, 321235], [55, 321875], [57, 322355], [65, 322795], [71, 323035], [76, 323355], [79, 323555]]}, {"verse": 39, "start": 324300, "end": 327118, "text": "Y yo dije: Quizás la mujer no querrá seguirme.", "words": [[0, 324300], [2, 324426], [5, 324526], [11, 325211], [18, 325598], [21, 325758], [27, 325978], [30, 326218], [37, 326538]]}, {"verse": 40, "start": 327468, "end": 338457, "text": "Entonces él me respondió: Jehová, en cuya presencia he andado, enviará su ángel contigo, y prosperará tu camino; y tomarás mujer para mi hijo de mi linaje y de la casa de mi padre:", "words": [[0, 327468], [9, 327992], [12, 328232], [15, 328352], [26, 329225], [34, 329654], [37, 329754], [42, 329994], [52, 330554], [55, 330794], [63, 331554], [71, 332014], [74, 332194], [80, 332534], [89, 333074], [91, 333334], [102, 333954], [105, 334094], [113, 334848], [115, 334946], [123, 335366], [129, 335606], [134, 335946], [137, 336146], [142, 336346], [145, 336506], [148, 336606], [155, 337106], [157, 337186], [160, 337266], [163, 337366], [168, 337606], [171, 337806], [174, 337906]]}, {"verse": 41, "start": 338807, "end": 345388, "text": "Entonces serás libre de mi juramento, cuando hayas llegado a mi familia; y si no te la dan, serás libre de mi juramento.", "words": [[0, 338807], [9, 339193], [15, 339713], [21, 339993], [24, 340193], [27, 340273], [38, 340793], [45, 341073], [51, 341473], [59, 341793], [61, 341853], [64, 341913], [73, 342803], [75, 342905], [78, 343045], [81, 343165], [84, 343305], [87, 343425], [92, 343885], [98, 344205], [104, 344445], [107, 344605], [110, 344705]]}, {"verse": 42, "start": 345738, "end": 352431, "text": "Llegué, pues, hoy a la fuente, y dije: Jehová, Dios de mi señor Abraham, si tú prosperas ahora mi camino por el cual ando;", "words": [[0, 345738], [8, 346025], [14, 346305], [18, 346565], [20, 346685], [23, 346745], [31, 347125], [33, 347305], [39, 347945], [47, 348314], [52, 348514], [55, 348714], [58, 348904], [64, 349094], [73, 349954], [76, 350054], [79, 350194], [89, 350754], [95, 350954], [98, 351154], [105, 351514], [109, 351714], [112, 351814], [117, 351974]]}, {"verse": 43, "start": 352781, "end": 362609, "text": "He aquí yo estoy junto a la fuente de agua; sea, pues, que la joven que salga por agua, a la cual diga: Dame a beber, te ruego, un poco de agua de tu cántaro;", "words": [[0, 352810], [3, 352880], [8, 353120], [11, 353340], [17, 353580], [23, 353820], [25, 354020], [28, 354060], [35, 354380], [38, 354540], [44, 355162], [49, 355316], [55, 355596], [59, 355876], [62, 356016], [68, 356436], [72, 356556], [78, 356956], [82, 357156], [88, 357776], [90, 358016], [93, 358076], [98, 358316], [104, 359171], [109, 359411], [111, 359571], [118, 360151], [121, 360251], [128, 360971], [131, 361111], [136, 361311], [139, 361511], [144, 361711], [147, 361891], [150, 362011]]}, {"verse": 44, "start": 362959, "end": 371794, "text": "Y ella me responda, Bebe tú, y también para tus camellos sacaré agua: esta sea la mujer que destinó Jehová para el hijo de mi señor.", "words": [[0, 362959], [2, 363102], [7, 363282], [10, 363442], [20, 364522], [25, 364822], [29, 365102], [31, 365542], [39, 365902], [44, 366142], [48, 366362], [57, 366922], [64, 367342], [70, 368074], [75, 368300], [79, 368540], [82, 368720], [88, 369020], [92, 369387], [100, 369753], [107, 370120], [112, 370360], [115, 370520], [120, 370740], [123, 370860], [126, 370980]]}, {"verse": 45, "start": 372144, "end": 383036, "text": "Y antes que acabase de hablar en mi corazón, he aquí Rebeca, que salía con su cántaro sobre su hombro; y descendió a la fuente, y sacó agua; y le dije: Te ruego que me des a beber.", "words": [[0, 372144], [2, 372306], [8, 372546], [12, 372746], [20, 373206], [23, 373346], [30, 373566], [33, 373766], [36, 373886], [45, 374356], [48, 374826], [53, 375296], [61, 375766], [65, 376026], [71, 376386], [75, 376566], [78, 376706], [86, 377146], [92, 377406], [95, 377626], [103, 378316], [105, 378419], [115, 378919], [117, 379019], [120, 379079], [128, 379499], [130, 379759], [135, 380099], [141, 380763], [143, 380882], [146, 380962], [152, 381630], [155, 381803], [161, 382013], [165, 382133], [168, 382273], [172, 382453], [174, 382573]]}, {"verse": 46, "start": 383386, "end": 391882, "text": "Y rápidamente bajó su cántaro de encima de sí, y dijo: Bebe, y también a tus camellos daré a beber. Y bebí, y dio también de beber a mis camellos.", "words": [[0, 383386], [2, 383487], [14, 384087], [19, 384467], [22, 384587], [30, 385007], [33, 385147], [40, 385487], [43, 385667], [47, 386107], [49, 386167], [55, 386804], [61, 387441], [63, 387521], [71, 387741], [73, 387901], [77, 388061], [86, 388521], [91, 388781], [93, 389046], [100, 389502], [102, 389619], [108, 389939], [110, 390039], [114, 390159], [122, 390519], [125, 390679], [131, 390899], [133, 391019], [137, 391159]]}, {"verse": 47, "start": 392232, "end": 404796, "text": "Entonces le pregunté, y dije: ¿De quién eres hija? Y ella respondió: Hija de Betuel, hijo de Nacor, que le parió Milca. Entonces le puse un pendiente sobre su nariz, y brazaletes sobre sus manos:", "words": [[0, 392232], [9, 392631], [12, 392871], [22, 393531], [24, 393631], [30, 394357], [34, 394517], [40, 394677], [45, 394937], [51, 395669], [53, 395831], [58, 396011], [69, 396987], [74, 397272], [77, 397332], [85, 398032], [90, 398192], [93, 398332], [100, 399072], [104, 399152], [107, 399272], [113, 399532], [120, 400330], [129, 400674], [132, 400954], [137, 401274], [140, 401374], [150, 401874], [156, 402134], [159, 402354], [166, 402814], [168, 403174], [179, 403774], [185, 404054], [189, 404234]]}, {"verse": 48, "start": 405146, "end": 415184, "text": "Y me incliné, y adoré a Jehová, y bendije a Jehová, Dios de mi señor Abraham, que me había guiado por camino de verdad para tomar la hija del hermano de mi señor para su hijo.", "words": [[0, 405146], [2, 405289], [5, 405649], [14, 406009], [16, 406189], [22, 406529], [24, 406629], [32, 407209], [34, 407449], [42, 407869], [44, 408009], [52, 408609], [57, 408829], [60, 409009], [63, 409342], [69, 409676], [78, 410176], [82, 410257], [85, 410377], [91, 410597], [98, 411057], [102, 411237], [109, 411517], [112, 411797], [119, 412157], [124, 412417], [130, 412677], [133, 412917], [138, 413197], [142, 413317], [150, 413737], [153, 413817], [156, 413937], [162, 414297], [167, 414537], [170, 414757]]}, {"verse": 49, "start": 415534, "end": 423919, "text": "Ahora pues, si vosotros hacéis misericordia y verdad con mi señor, declarádmelo; y si no, declarádmelo; y iré a la derecha o a la izquierda.", "words": [[0, 415534], [6, 415818], [12, 416278], [15, 416338], [24, 416798], [31, 417258], [44, 417998], [46, 418078], [53, 418318], [57, 418658], [60, 418818], [67, 419658], [81, 420679], [83, 420782], [86, 420922], [90, 421042], [104, 422112], [106, 422253], [110, 422473], [112, 422533], [115, 422573], [123, 422973], [125, 423173], [127, 423253], [130, 423293]]}, {"verse": 50, "start": 424199, "end": 432759, "text": "Entonces Labán y Betuel respondieron y dijeron: De Jehová ha salido esto; no podemos hablarte malo ni bueno.", "words": [[0, 424199], [9, 424756], [15, 425656], [17, 425796], [24, 426196], [37, 427256], [39, 427536], [48, 428351], [51, 428577], [58, 429057], [61, 429177], [68, 429657], [74, 430134], [77, 430600], [85, 430980], [94, 431580], [99, 432000], [102, 432120]]}, {"verse": 51, "start": 433109, "end": 440260, "text": "He ahí Rebeca delante de ti; tómala y vete, y sea mujer del hijo de tu señor, como lo ha dicho Jehová.", "words": [[0, 433175], [3, 433275], [7, 433895], [14, 434515], [22, 434855], [25, 435035], [29, 435553], [36, 436065], [38, 436308], [44, 436588], [46, 436688], [50, 436848], [56, 437148], [60, 437448], [65, 437708], [68, 437868], [71, 438028], [78, 438928], [83, 439088], [86, 439268], [89, 439348], [95, 439568]]}, {"verse": 52, "start": 440610, "end": 447389, "text": "Y fue, que como el criado de Abraham oyó sus palabras, se inclinó en tierra ante Jehová.", "words": [[0, 440610], [2, 440712], [7, 440872], [11, 441052], [16, 441292], [19, 441432], [26, 441972], [29, 442132], [37, 442572], [41, 443212], [45, 443352], [55, 444492], [58, 445072], [66, 445732], [69, 445872], [76, 446332], [81, 446712]]}, {"verse": 53, "start": 447739, "end": 457744, "text": "Y sacó el criado vasos de plata, y vasos de oro y vestidos, y dio a Rebeca: también dio cosas preciosas a su hermano y a su madre.", "words": [[0, 447739], [2, 447860], [7, 448190], [10, 448520], [17, 449100], [23, 449600], [26, 449720], [33, 450100], [35, 450280], [41, 450720], [44, 450840], [48, 451100], [50, 451280], [60, 452300], [62, 452560], [66, 452800], [68, 452960], [76, 453858], [84, 454161], [88, 454481], [94, 454881], [104, 455661], [106, 455781], [109, 455941], [117, 456721], [119, 456901], [121, 456961], [124, 457121]]}, {"verse": 54, "start": 458094, "end": 467798, "text": "Y comieron y bebieron él y los varones que venían con él, y durmieron; y levantándose de mañana, dijo: Enviadme a mi señor.", "words": [[0, 458094], [2, 458215], [11, 458735], [13, 459095], [22, 459595], [25, 460055], [27, 460295], [31, 460435], [39, 460875], [43, 461075], [50, 461495], [54, 461735], [58, 461955], [60, 462495], [71, 463568], [73, 463819], [86, 464559], [89, 464719], [97, 465519], [103, 466461], [112, 467065], [114, 467145], [117, 467225]]}, {"verse": 55, "start": 468078, "end": 475624, "text": "Entonces respondió su hermano y su madre: Espere la doncella con nosotros a lo menos diez días, y después irá.", "words": [[0, 468078], [9, 469176], [19, 469876], [22, 470036], [30, 470536], [32, 470596], [35, 470736], [42, 471494], [49, 471910], [52, 472260], [61, 472610], [65, 472770], [74, 473310], [76, 473590], [79, 473650], [85, 473870], [90, 474090], [96, 474450], [98, 474805], [106, 475065]]}, {"verse": 56, "start": 475974, "end": 482664, "text": "Y él les dijo: No me detengáis, pues que Jehová ha prosperado mi camino; despachadme para que me vaya a mi señor.", "words": [[0, 475974], [2, 476142], [5, 476262], [9, 476422], [15, 477124], [18, 477249], [21, 477369], [32, 477989], [37, 478269], [41, 478549], [48, 479009], [51, 479069], [62, 479569], [65, 479689], [73, 480484], [85, 481201], [90, 481401], [94, 481561], [97, 481681], [102, 481901], [104, 482041], [107, 482121]]}, {"verse": 57, "start": 482944, "end": 487716, "text": "Ellos respondieron entonces: Llamemos la doncella y preguntémosle.", "words": [[0, 482944], [6, 483365], [19, 484225], [29, 485436], [38, 485863], [41, 486213], [50, 486563], [52, 486683]]}, {"verse": 58, "start": 488066, "end": 495068, "text": "Y llamaron a Rebeca, y le dijeron: ¿Irás tú con este varón? Y ella respondió: Sí, iré.", "words": [[0, 488066], [2, 488178], [11, 488551], [13, 488925], [21, 489298], [23, 489418], [26, 489498], [35, 490238], [41, 490549], [44, 490789], [48, 491109], [53, 491309], [60, 492125], [62, 492286], [67, 492526], [78, 494036], [82, 494576]]}, {"verse": 59, "start": 495348, "end": 502124, "text": "Entonces dejaron ir a Rebeca su hermana, y a su nodriza, y al criado de Abraham y a sus hombres.", "words": [[0, 495348], [9, 495854], [17, 496674], [20, 496854], [22, 496974], [29, 497414], [32, 497614], [41, 498074], [43, 498214], [45, 498274], [48, 498674], [57, 499074], [59, 499554], [62, 499694], [69, 500234], [72, 500394], [80, 500794], [82, 501174], [84, 501254], [88, 501434]]}, {"verse": 60, "start": 502474, "end": 513574, "text": "Y bendijeron a Rebeca, y le dijeron: Nuestra hermana eres; seas en millares de millares, y tu generación posea la puerta de sus enemigos.", "words": [[0, 502745], [2, 503059], [13, 503372], [15, 503492], [23, 503972], [25, 504072], [28, 504172], [37, 505114], [45, 505422], [53, 506074], [59, 506927], [64, 507339], [67, 507759], [76, 508439], [79, 508659], [89, 509739], [91, 509959], [94, 510119], [105, 511019], [111, 511719], [114, 511839], [121, 512179], [124, 512459], [128, 512639]]}, {"verse": 61, "start": 513924, "end": 524351, "text": "Se levantó entonces Rebeca y sus doncellas, y subieron sobre los camellos, y siguieron al hombre; y el criado tomó a Rebeca, y se fue.", "words": [[0, 513924], [3, 514042], [11, 514522], [20, 515042], [27, 515982], [29, 516402], [33, 516582], [44, 517362], [46, 517682], [55, 518142], [61, 518402], [65, 518622], [75, 519342], [77, 519662], [87, 520202], [90, 520362], [98, 521147], [100, 521288], [103, 521428], [110, 522008], [115, 522428], [117, 522548], [125, 523108], [127, 523728], [130, 523888]]}, {"verse": 62, "start": 524701, "end": 530954, "text": "Y venía Isaac del pozo del Viviente que me ve; porque él habitaba en la tierra del Neguev;", "words": [[0, 524701], [2, 524995], [8, 525435], [14, 525895], [18, 526295], [23, 526735], [27, 526915], [36, 527435], [40, 527615], [43, 527755], [47, 528349], [54, 528733], [57, 529013], [66, 529473], [69, 529573], [72, 529693], [79, 529993], [83, 530293]]}, {"verse": 63, "start": 531304, "end": 540579, "text": "Y había salido Isaac a meditar al campo, a la hora de la tarde; y alzando sus ojos miró, y he aquí los camellos que venían.", "words": [[0, 531304], [2, 531411], [8, 531591], [15, 532111], [21, 532411], [23, 532831], [31, 533298], [34, 533764], [41, 534231], [43, 534631], [46, 534731], [51, 534971], [54, 535151], [57, 535271], [64, 536087], [66, 536370], [74, 537050], [78, 537230], [83, 537550], [89, 538130], [91, 538400], [94, 538670], [99, 538910], [103, 539110], [112, 539710], [116, 539830]]}, {"verse": 64, "start": 540929, "end": 546643, "text": "Rebeca también alzó sus ojos, y vio a Isaac, y descendió del camello;", "words": [[0, 540929], [7, 541453], [15, 541853], [20, 542493], [24, 542653], [30, 543013], [32, 543378], [36, 543718], [38, 543958], [45, 544358], [47, 545083], [57, 545703], [61, 545903]]}, {"verse": 65, "start": 546993, "end": 559156, "text": "Porque había preguntado al criado: ¿Quién es este varón que viene por el campo hacia nosotros? Y el siervo había respondido: Este es mi señor. Ella entonces tomó el velo, y se cubrió.", "words": [[0, 546993], [7, 547156], [13, 547436], [24, 548116], [27, 548236], [35, 549157], [42, 549317], [45, 549437], [50, 549697], [56, 550057], [60, 550197], [66, 550477], [70, 550697], [73, 550837], [79, 551157], [85, 551397], [95, 552633], [97, 552749], [100, 552889], [107, 553389], [113, 553709], [125, 554931], [130, 555178], [133, 555398], [136, 555518], [143, 556381], [148, 556471], [157, 556951], [162, 557731], [165, 557871], [171, 558211], [173, 558371], [176, 558471]]}, {"verse": 66, "start": 559506, "end": 563944, "text": "Entonces el criado contó a Isaac todo lo que había hecho.", "words": [[0, 559506], [9, 560003], [12, 560303], [19, 560883], [25, 561523], [27, 561643], [33, 561923], [38, 562663], [41, 562943], [45, 563083], [51, 563343]]}, {"verse": 67, "start": 564294, "end": 574947, "text": "E la introdujo Isaac a la tienda de su madre Sara, y tomó a Rebeca por mujer; y la amó: y se consoló Isaac después de la muerte de su madre.", "words": [[0, 564363], [2, 564469], [5, 564576], [15, 565316], [21, 565676], [23, 566136], [26, 566216], [33, 566676], [36, 566816], [39, 566996], [45, 567256], [51, 567696], [53, 568296], [58, 568716], [60, 568916], [67, 569116], [71, 569516], [78, 570265], [80, 570432], [83, 570767], [88, 571255], [90, 571355], [93, 571495], [101, 572135], [107, 572455], [115, 573295], [118, 573535], [121, 573655], [128, 573995], [131, 574215], [134, 574375]]}]}