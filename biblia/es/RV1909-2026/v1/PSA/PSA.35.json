{"book": "PSA", "chapter": 35, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 192402, "verses": [{"verse": 1, "start": 300, "end": 7242, "text": "Salmo de David. DISPUTA, oh Jehová, con los que contra mí contienden; pelea con los que me combaten.", "words": [[0, 300], [6, 784], [9, 944], [16, 1649], [25, 2104], [28, 2590], [36, 3077], [40, 3577], [44, 3737], [48, 3897], [55, 4237], [58, 4457], [70, 5628], [76, 6032], [80, 6192], [84, 6352], [88, 6472], [91, 6612]]}, {"verse": 2, "start": 7592, "end": 12198, "text": "Echa mano al escudo y al escudo grande, y levántate en mi ayuda.", "words": [[0, 7592], [5, 7856], [10, 8116], [13, 8276], [20, 8736], [22, 8896], [25, 9016], [32, 9356], [40, 9816], [42, 10262], [52, 11081], [55, 11381], [58, 11561]]}, {"verse": 3, "start": 12548, "end": 19284, "text": "Y saca la lanza, cierra contra mis perseguidores; di a mi alma: Yo soy tu salvación.", "words": [[0, 12548], [2, 12670], [7, 13030], [10, 13150], [17, 13990], [24, 14370], [31, 14750], [35, 15010], [50, 16335], [53, 16599], [55, 16739], [58, 16859], [64, 17632], [67, 17820], [71, 18040], [74, 18280]]}, {"verse": 4, "start": 19634, "end": 28214, "text": "Avergüéncense y confúndanse los que buscan mi alma: vuelvan atrás, y sean avergonzados los que mi mal intentan.", "words": [[0, 19634], [14, 20576], [16, 20716], [28, 21496], [32, 21696], [36, 21856], [43, 22256], [46, 22496], [52, 23282], [60, 23808], [67, 24188], [69, 24788], [74, 25148], [87, 26188], [91, 26688], [95, 26868], [98, 27028], [102, 27288]]}, {"verse": 5, "start": 28564, "end": 33601, "text": "Sean como el tamo delante del viento; y el ángel de Jehová los acose.", "words": [[0, 28564], [5, 28826], [10, 29186], [13, 29366], [18, 29786], [26, 30266], [30, 30526], [38, 31535], [40, 31655], [43, 31775], [49, 32195], [52, 32335], [59, 32795], [63, 32915]]}, {"verse": 6, "start": 33951, "end": 39761, "text": "Sea su camino oscuridad y resbaladeros; y el ángel de Jehová los persiga.", "words": [[0, 33951], [4, 34237], [7, 34517], [14, 34897], [24, 35797], [26, 36532], [40, 37419], [42, 37585], [45, 37725], [51, 38145], [54, 38565], [61, 38986], [65, 39406]]}, {"verse": 7, "start": 40111, "end": 47030, "text": "Porque sin causa escondieron para mí su red en un hoyo; sin causa hicieron hoyo para mi alma.", "words": [[0, 40111], [7, 40335], [11, 40575], [17, 41055], [29, 41775], [34, 42015], [37, 42235], [40, 42435], [44, 42775], [47, 43075], [50, 43235], [56, 43978], [60, 44236], [66, 44856], [75, 45466], [80, 46076], [85, 46316], [88, 46516]]}, {"verse": 8, "start": 47380, "end": 55290, "text": "Véngale el quebrantamiento que no sepa, y su red que escondió lo prenda: con quebrantamiento en ella caiga.", "words": [[0, 47380], [8, 47885], [11, 48245], [27, 49105], [31, 49366], [34, 49626], [40, 49887], [42, 50080], [45, 50260], [49, 50600], [53, 51240], [62, 51700], [65, 51820], [73, 52671], [77, 52854], [93, 54074], [96, 54274], [101, 54494]]}, {"verse": 9, "start": 55640, "end": 60188, "text": "Y gócese mi alma en Jehová; y alégrese en su salvación.", "words": [[0, 55640], [2, 56034], [9, 56464], [12, 56624], [17, 56844], [20, 57064], [28, 57864], [30, 58142], [39, 58802], [42, 59102], [45, 59262]]}, {"verse": 10, "start": 60538, "end": 69688, "text": "Todos mis huesos dirán: Jehová, ¿quién como tú, que libras al afligido del más fuerte que él, y al pobre y necesitado del que le despoja?", "words": [[0, 60538], [6, 60720], [10, 61020], [17, 61460], [24, 62627], [32, 62967], [39, 63327], [44, 63547], [48, 63807], [52, 63967], [59, 64487], [62, 64627], [71, 65227], [75, 65367], [79, 65587], [86, 65947], [90, 66227], [94, 66487], [96, 67047], [99, 67187], [105, 67567], [107, 67847], [118, 68567], [122, 68747], [126, 68907], [129, 69027]]}, {"verse": 11, "start": 70038, "end": 74241, "text": "Se levantan testigos falsos; de lo que no sé me preguntan;", "words": [[0, 70038], [3, 70216], [12, 70796], [21, 71376], [29, 72536], [32, 72796], [35, 72916], [39, 73036], [42, 73156], [45, 73336], [48, 73456]]}, {"verse": 12, "start": 74591, "end": 78017, "text": "Me devolvieron mal por bien, para abatir a mi alma.", "words": [[0, 74591], [3, 74741], [15, 75361], [19, 75661], [23, 75921], [29, 76241], [34, 76616], [41, 77216], [43, 77296], [46, 77416]]}, {"verse": 13, "start": 78367, "end": 87490, "text": "Pero yo, cuando ellos enfermaron, me vestí de saco; afligí con ayuno mi alma, y mi oración se revolvía en mi seno.", "words": [[0, 78367], [5, 78511], [9, 79151], [16, 79511], [22, 79991], [34, 81211], [37, 81431], [43, 81831], [46, 81891], [52, 82740], [59, 83472], [63, 83652], [69, 84012], [72, 84252], [78, 84572], [80, 85132], [83, 85272], [91, 85772], [94, 86012], [103, 86672], [106, 86792], [109, 86952]]}, {"verse": 14, "start": 87840, "end": 95342, "text": "Como por mi compañero, como por mi hermano andaba; como el que trae luto por madre, enlutado me humillaba.", "words": [[0, 87840], [5, 88002], [9, 88262], [12, 88402], [23, 89242], [28, 89382], [32, 89662], [35, 89802], [43, 90242], [51, 91007], [56, 91367], [59, 91467], [63, 91607], [68, 91947], [73, 92307], [77, 92587], [84, 93427], [93, 94267], [96, 94507]]}, {"verse": 15, "start": 95692, "end": 107062, "text": "Pero ellos se alegraron en mi adversidad, y se juntaron; se juntaron contra mí gentes despreciables, y yo no lo entendía: me despedazaban, y no cesaban;", "words": [[0, 95692], [5, 95856], [11, 96136], [14, 96576], [24, 97276], [27, 97456], [30, 97636], [42, 98356], [44, 98636], [47, 98776], [57, 99696], [60, 99835], [69, 100435], [76, 100762], [79, 101088], [86, 101415], [101, 102335], [103, 102595], [106, 102855], [109, 103100], [112, 103260], [122, 104366], [125, 104640], [139, 105600], [141, 106160], [144, 106300]]}, {"verse": 16, "start": 107412, "end": 112540, "text": "Con los lisonjeros burladores bufones, crujiendo sobre mí sus dientes.", "words": [[0, 107412], [4, 107556], [8, 107796], [19, 108656], [30, 109266], [39, 109876], [49, 111016], [55, 111296], [58, 111576], [62, 111796]]}, {"verse": 17, "start": 112890, "end": 120066, "text": "Señor, ¿hasta cuándo verás esto? Recobra mi alma de sus quebrantamientos, mi única de los leones.", "words": [[0, 112890], [7, 113720], [14, 113860], [21, 114240], [27, 114500], [33, 115224], [41, 115768], [44, 115988], [49, 116288], [52, 116528], [56, 116748], [74, 118268], [77, 118548], [83, 118888], [86, 119088], [90, 119248]]}, {"verse": 18, "start": 120416, "end": 125528, "text": "Te confesaré en grande congregación; te alabaré entre numeroso pueblo.", "words": [[0, 120416], [3, 120500], [13, 121240], [16, 121480], [23, 121880], [37, 123223], [40, 123488], [48, 123788], [54, 124148], [63, 124868]]}, {"verse": 19, "start": 125878, "end": 132093, "text": "No se alegren de mí mis enemigos injustos: ni los que me aborrecen sin causa guiñen el ojo.", "words": [[0, 125878], [3, 126046], [6, 126206], [14, 126686], [17, 126846], [20, 127046], [24, 127226], [33, 127746], [43, 128974], [46, 129148], [50, 129321], [54, 129421], [57, 129581], [67, 130161], [71, 130341], [77, 130941], [84, 131541], [87, 131661]]}, {"verse": 20, "start": 132443, "end": 137799, "text": "Porque no hablan paz; y contra los mansos de la tierra piensan palabras engañosas.", "words": [[0, 132547], [7, 132687], [10, 132847], [17, 133127], [22, 133974], [24, 134070], [31, 134330], [35, 134530], [42, 135010], [45, 135130], [48, 135250], [55, 135550], [63, 136130], [72, 136490]]}, {"verse": 21, "start": 138149, "end": 144134, "text": "Y ensancharon sobre mí su boca; dijeron: ¡Ea, ea, nuestros ojos lo han visto!", "words": [[0, 138149], [2, 138389], [14, 139169], [20, 139509], [23, 139749], [26, 139909], [32, 140727], [41, 141646], [46, 142024], [50, 142464], [59, 142924], [64, 143184], [67, 143424], [71, 143564]]}, {"verse": 22, "start": 144414, "end": 149201, "text": "Tú lo has visto, oh Jehová; no calles: Señor, de mí no te alejes.", "words": [[0, 144414], [3, 144519], [6, 144639], [10, 144759], [17, 144969], [20, 145179], [28, 145953], [31, 146092], [39, 146895], [46, 147521], [49, 147721], [52, 147921], [55, 148381], [58, 148561]]}, {"verse": 23, "start": 149551, "end": 154804, "text": "Muévete y despierta para mi juicio, para mi causa, Dios mío y Señor mío.", "words": [[0, 149551], [8, 150074], [10, 150314], [20, 151074], [25, 151274], [28, 151434], [36, 152154], [41, 152194], [44, 152374], [51, 153194], [56, 153294], [60, 153934], [62, 154074], [68, 154374]]}, {"verse": 24, "start": 155154, "end": 160953, "text": "Júzgame conforme a tu justicia, Jehová Dios mío; y no se alegren de mí.", "words": [[0, 155154], [8, 155725], [17, 156445], [19, 156505], [22, 156605], [32, 157705], [39, 158425], [44, 158705], [49, 159598], [51, 159706], [54, 159846], [57, 160026], [65, 160506], [68, 160666]]}, {"verse": 25, "start": 161303, "end": 166666, "text": "No digan en su corazón: ¡Ea, alma nuestra! No digan: ¡Lo hemos devorado!", "words": [[0, 161303], [3, 161471], [9, 161871], [12, 161991], [15, 162151], [24, 163335], [29, 163582], [34, 163829], [43, 164295], [46, 164747], [53, 165620], [57, 165768], [63, 165908]]}, {"verse": 26, "start": 167016, "end": 177587, "text": "Avergüéncense, y sean confundidos a una los que de mi mal se alegran: vístanse de vergüenza y de confusión los que se engrandecen contra mí.", "words": [[0, 167016], [15, 167962], [17, 168382], [22, 168682], [34, 169562], [36, 170062], [40, 170302], [44, 170802], [48, 171022], [51, 171182], [54, 171342], [58, 171642], [61, 172002], [70, 172872], [79, 173539], [82, 173679], [92, 174299], [94, 174439], [97, 174539], [107, 175259], [111, 175719], [115, 175899], [118, 176419], [130, 176939], [137, 177239]]}, {"verse": 27, "start": 177937, "end": 187377, "text": "Canten y alégrense los que están a favor de mi justa causa, y digan siempre: Sea exaltado Jehová, que ama la paz de su siervo.", "words": [[0, 177937], [7, 178521], [9, 178706], [19, 179386], [23, 179546], [27, 179686], [33, 179886], [35, 180006], [41, 180286], [44, 180486], [47, 180606], [53, 180986], [60, 181406], [62, 182006], [68, 182366], [77, 183312], [81, 183674], [90, 184594], [98, 185234], [102, 185614], [106, 185894], [109, 186094], [113, 186334], [116, 186514], [119, 186654]]}, {"verse": 28, "start": 187727, "end": 192002, "text": "Y mi lengua hablará de tu justicia, y de tu alabanza todo el día.", "words": [[0, 187727], [2, 187848], [5, 187948], [12, 188388], [20, 188928], [23, 189048], [26, 189208], [36, 189908], [38, 190328], [41, 190448], [44, 190588], [53, 191148], [58, 191348], [61, 191568]]}]}