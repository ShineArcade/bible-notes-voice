{"book": "REV", "chapter": 5, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 139215, "verses": [{"verse": 1, "start": 300, "end": 7029, "text": "Y vi en la mano derecha del que estaba sentado sobre el trono un libro escrito de dentro y de fuera, sellado con siete sellos.", "words": [[0, 300], [2, 420], [5, 600], [8, 780], [11, 880], [16, 1080], [24, 1560], [28, 1660], [32, 1800], [39, 2060], [47, 2580], [53, 2820], [56, 3000], [62, 3240], [65, 3380], [71, 3600], [79, 3980], [82, 4240], [89, 4560], [91, 4680], [94, 4760], [101, 5420], [109, 5860], [113, 6060], [119, 6320]]}, {"verse": 2, "start": 7479, "end": 14477, "text": "Y vi un fuerte ángel proclamando en alta voz: ¿Quién es digno de abrir el libro, y de desatar sus sellos?", "words": [[0, 7479], [2, 7605], [5, 7725], [8, 7885], [15, 8145], [21, 8625], [33, 9245], [36, 9365], [41, 9565], [46, 10409], [53, 10631], [56, 10771], [62, 11271], [65, 11351], [71, 11651], [74, 11911], [81, 12271], [83, 12831], [86, 12951], [94, 13431], [98, 13731]]}, {"verse": 3, "start": 14927, "end": 22170, "text": "Y ninguno podía, ni en el cielo, ni en la tierra, ni debajo de la tierra, abrir el libro, ni mirarlo.", "words": [[0, 14927], [2, 15032], [10, 15512], [17, 15972], [20, 16192], [23, 16392], [26, 16512], [33, 17412], [36, 17512], [39, 17632], [42, 17772], [50, 18692], [53, 18752], [60, 19172], [63, 19332], [66, 19452], [74, 19832], [80, 20432], [83, 20732], [90, 21412], [93, 21512]]}, {"verse": 4, "start": 22620, "end": 29758, "text": "Y yo lloraba mucho, porque no había sido hallado ninguno digno de abrir el libro, ni de leerlo, ni de mirarlo.", "words": [[0, 22620], [2, 22721], [5, 22861], [13, 23241], [20, 23961], [27, 24301], [30, 24521], [36, 24681], [41, 25061], [49, 25501], [57, 25981], [63, 26421], [66, 26501], [72, 26761], [75, 26981], [82, 27681], [85, 27901], [88, 28021], [96, 28881], [99, 28981], [102, 29101]]}, {"verse": 5, "start": 30208, "end": 40591, "text": "Y uno de los ancianos me dice: No llores: he aquí el león de la tribu de Judá, la raíz de David, que ha vencido para abrir el libro, y desatar sus siete sellos.", "words": [[0, 30208], [2, 30353], [6, 30493], [9, 30613], [13, 30753], [22, 31293], [25, 31493], [31, 32228], [34, 32413], [42, 33550], [45, 33690], [50, 33970], [53, 34130], [58, 34470], [61, 34570], [64, 34690], [70, 35030], [73, 35130], [79, 35770], [82, 35850], [87, 36150], [90, 36270], [97, 36890], [101, 37050], [104, 37190], [112, 37550], [117, 37810], [123, 38070], [126, 38290], [133, 38530], [135, 38930], [143, 39370], [147, 39630], [153, 39950]]}, {"verse": 6, "start": 41041, "end": 55767, "text": "Y miré; y he aquí en medio del trono y de los cuatro seres vivientes, y en medio de los ancianos, estaba un Cordero como inmolado, que tenía siete cuernos, y siete ojos, que son los siete Espíritus de Dios enviados en toda la tierra.", "words": [[0, 41041], [2, 41168], [8, 41854], [10, 41992], [13, 42092], [18, 42352], [21, 42532], [27, 42772], [31, 42992], [37, 43392], [39, 43472], [42, 43552], [46, 43672], [53, 43952], [59, 44292], [70, 45252], [72, 45312], [75, 45432], [81, 45672], [84, 45832], [88, 45932], [98, 46912], [105, 47272], [108, 47492], [116, 47932], [121, 48192], [131, 49152], [135, 49212], [141, 49492], [147, 49812], [156, 50910], [158, 51038], [164, 51438], [170, 51778], [174, 52078], [178, 52298], [182, 52478], [188, 52798], [198, 53458], [201, 53558], [206, 53798], [215, 54558], [218, 54838], [223, 55018], [226, 55218]]}, {"verse": 7, "start": 56217, "end": 60699, "text": "Y él vino, y tomó el libro de la mano derecha de aquel que estaba sentado en el trono.", "words": [[0, 56217], [2, 56382], [5, 56542], [11, 56762], [13, 56962], [18, 57282], [21, 57402], [27, 57642], [30, 57822], [33, 57922], [38, 58142], [46, 58602], [49, 58742], [55, 59062], [59, 59162], [66, 59442], [74, 59982], [77, 60102], [80, 60222]]}, {"verse": 8, "start": 61149, "end": 74210, "text": "Y cuando hubo tomado el libro, los cuatro seres vivientes y los veinticuatro ancianos se postraron delante del Cordero, teniendo cada uno arpas, y copas de oro llenas de incienso, que son las oraciones de los santos:", "words": [[0, 61149], [2, 61256], [9, 61516], [14, 61896], [21, 62296], [24, 62456], [31, 63196], [35, 63316], [42, 63636], [48, 63916], [58, 64536], [60, 64796], [64, 64916], [77, 65556], [86, 66116], [89, 66316], [99, 66876], [107, 67256], [111, 67396], [120, 68296], [129, 68836], [134, 69036], [138, 69426], [145, 69816], [147, 70076], [153, 70496], [156, 70616], [160, 70796], [167, 71176], [170, 71296], [180, 72251], [184, 72336], [188, 72516], [192, 72696], [202, 73156], [205, 73376], [209, 73476]]}, {"verse": 9, "start": 74660, "end": 87524, "text": "Y cantaban un nuevo cántico, diciendo: Digno eres de tomar el libro, y de abrir sus sellos; porque tú fuiste inmolado, y nos has redimido para Dios con tu sangre, de todo linaje y lengua y pueblo y nación;", "words": [[0, 74660], [2, 74756], [11, 75176], [14, 75316], [20, 75476], [29, 76136], [39, 77273], [45, 77697], [50, 77837], [53, 78017], [59, 78257], [62, 78497], [69, 78757], [71, 79057], [74, 79177], [80, 79357], [84, 79577], [92, 80514], [99, 80720], [102, 80940], [109, 81280], [119, 81940], [121, 82360], [125, 82500], [129, 82740], [138, 83300], [143, 83500], [148, 83740], [152, 84040], [155, 84180], [163, 84580], [166, 84920], [171, 85140], [178, 85720], [180, 85880], [187, 86360], [189, 86480], [196, 86780], [198, 86980]]}, {"verse": 10, "start": 87974, "end": 92752, "text": "Y nos has hecho para nuestro Dios reyes y sacerdotes, y reinaremos sobre la tierra.", "words": [[0, 87974], [2, 88075], [6, 88215], [10, 88355], [16, 88595], [21, 88855], [29, 89055], [34, 89475], [40, 89975], [42, 90095], [54, 90795], [56, 91255], [67, 91795], [73, 92035], [76, 92195]]}, {"verse": 11, "start": 93202, "end": 102558, "text": "Y miré, y oí voz de muchos ángeles alrededor del trono, y de los seres vivientes, y de los ancianos; y la multitud de ellos era millones de millones,", "words": [[0, 93202], [2, 93326], [8, 93746], [10, 93926], [13, 94166], [17, 94366], [20, 94526], [27, 94726], [35, 95346], [45, 95666], [49, 96126], [56, 96606], [58, 97066], [61, 97186], [65, 97326], [71, 97566], [82, 98206], [84, 98606], [87, 98706], [91, 98846], [101, 99970], [103, 100077], [106, 100176], [115, 100657], [118, 100797], [124, 101017], [128, 101277], [137, 101637], [140, 101896]]}, {"verse": 12, "start": 103008, "end": 112754, "text": "Que decían en alta voz: El Cordero que fue inmolado es digno de tomar el poder y riquezas y sabiduría, y fortaleza y honra y gloria y alabanza.", "words": [[0, 103008], [4, 103092], [11, 103572], [14, 103712], [19, 103932], [24, 105392], [27, 105493], [35, 105933], [39, 106073], [43, 106293], [52, 106873], [55, 107053], [61, 107493], [64, 107553], [70, 107813], [73, 108013], [79, 108253], [81, 108473], [90, 108973], [92, 109133], [103, 109813], [105, 110273], [115, 110993], [117, 111173], [123, 111473], [125, 111553], [132, 111933], [134, 112093]]}, {"verse": 13, "start": 113204, "end": 130028, "text": "Y oí a toda criatura que está en el cielo, y sobre la tierra, y debajo de la tierra, y que está en el mar, y todas las cosas que en ellos están, diciendo: Al que está sentado en el trono, y al Cordero, sea la bendición, y la honra, y la gloria, y el poder, para siempre.", "words": [[0, 113204], [2, 113322], [5, 113542], [7, 113622], [12, 113782], [21, 114382], [25, 114582], [30, 114842], [33, 115042], [36, 115142], [43, 115602], [45, 115802], [51, 116042], [54, 116222], [62, 116662], [64, 116882], [71, 117262], [74, 117402], [77, 117522], [85, 117922], [87, 118122], [91, 118222], [96, 118442], [99, 118622], [102, 118762], [107, 119468], [109, 119571], [115, 119751], [119, 120011], [125, 120331], [129, 120591], [132, 120731], [138, 120891], [145, 121371], [155, 122569], [158, 122732], [162, 122872], [167, 123092], [175, 123572], [178, 123672], [181, 123772], [188, 124252], [19