{"book": "PSA", "chapter": 83, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 96883, "verses": [{"verse": 1, "start": 300, "end": 5506, "text": "Keep not you silence, O God: hold not your peace, and be not still, O God.", "words": [[0, 300], [5, 460], [9, 700], [13, 1170], [22, 1640], [24, 1700], [29, 2498], [34, 2680], [38, 2940], [43, 3140], [50, 3900], [54, 3980], [57, 4120], [61, 4340], [68, 4920], [70, 5000]]}, {"verse": 2, "start": 5956, "end": 10615, "text": "For, lo, your enemies make a tumult: and they that hate you have lifted up the head.", "words": [[0, 5956], [5, 6254], [9, 6584], [14, 6664], [22, 7004], [27, 7324], [29, 7444], [37, 8317], [41, 8457], [46, 8657], [51, 8897], [56, 9177], [60, 9377], [65, 9557], [72, 9857], [75, 10057], [79, 10217]]}, {"verse": 3, "start": 11065, "end": 16113, "text": "They have taken crafty counsel against your people, and consulted against your hidden ones.", "words": [[0, 11065], [5, 11213], [10, 11353], [16, 11653], [23, 12253], [31, 12633], [39, 12953], [44, 13213], [52, 13553], [56, 14133], [66, 14613], [74, 14993], [79, 15253], [86, 15473]]}, {"verse": 4, "start": 16563, "end": 22633, "text": "They have said, Come, and let us cut them off from being a nation; that the name of Israel may be no more in remembrance.", "words": [[0, 16563], [5, 16713], [10, 16893], [16, 17618], [22, 17790], [26, 17890], [30, 18070], [33, 18210], [37, 18450], [42, 18630], [46, 18810], [51, 18950], [57, 19130], [59, 19270], [67, 20066], [72, 20188], [76, 20308], [81, 20488], [84, 20628], [91, 20948], [95, 21168], [98, 21268], [101, 21468], [106, 21708], [109, 21828]]}, {"verse": 5, "start": 22983, "end": 27603, "text": "For they have consulted together with one consent: they are confederate against you:", "words": [[0, 22983], [4, 23085], [9, 23245], [14, 23345], [24, 23805], [33, 24325], [38, 24605], [42, 24885], [51, 25982], [56, 26105], [60, 26205], [72, 26725], [80, 27165]]}, {"verse": 6, "start": 