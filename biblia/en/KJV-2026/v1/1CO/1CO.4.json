{"book": "1CO", "chapter": 4, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 147065, "verses": [{"verse": 1, "start": 300, "end": 5609, "text": "Let a man so account of us, as of the ministers of Christ, and stewards of the mysteries of God.", "words": [[0, 300], [4, 465], [6, 585], [10, 805], [13, 1045], [21, 1385], [24, 1605], [28, 1825], [31, 2165], [34, 2265], [38, 2385], [48, 2685], [51, 2965], [59, 3285], [63, 3705], [72, 4065], [75, 4425], [79, 4545], [89, 4905], [92, 5165]]}, {"verse": 2, "start": 5959, "end": 9459, "text": "Moreover it is required in stewards, that a man be found faithful.", "words": [[0, 5959], [9, 6424], [12, 6524], [15, 6644], [24, 7064], [27, 7284], [37, 7684], [42, 8144], [44, 8244], [48, 8424], [51, 8564], [57, 8864]]}, {"verse": 3, "start": 9809, "end": 16751, "text": "But with me it is a very small thing that I should be judged of you, or of man’s judgment: yes, I judge not my own self.", "words": [[0, 9809], [4, 9964], [9, 10144], [12, 10364], [15, 10524], [18, 10664], [20, 10764], [25, 10944], [31, 11264], [37, 11624], [42, 11804], [44, 11924], [51, 12084], [54, 12244], [61, 12524], [64, 12764], [69, 12964], [72, 13424], [75, 13564], [81, 13924], [91, 14746], [96, 15251], [98, 15331], [104, 15591], [108, 15831], [111, 16111], [115, 16271]]}, {"verse": 4, "start": 17101, "end": 23237, "text": "For I know nothing by myself; yet am I not hereby justified: but he that judges me is the Lord.", "words": [[0, 17101], [4, 17183], [6, 17343], [11, 17503], [19, 17863], [22, 18103], [30, 18923], [34, 19114], [37, 19374], [39, 19574], [43, 19774], [50, 20314], [61, 21344], [65, 21466], [68, 21646], [73, 21806], [80, 22066], [83, 22386], [86, 22646], [90, 22786]]}, {"verse": 5, "start": 23587, "end": 35644, "text": "Therefore judge nothing before the time, until the Lord come, who both will bring to light the hidden things of darkness, and will make manifest the counsels of the hearts: and then shall every man have praise of God.", "words": [[0, 23587], [10, 23912], [16, 24272], [24, 24632], [31, 24992], [35, 25192], [41, 25792], [47, 26112], [51, 26372], [56, 26572], [62, 27232], [66, 27352], [71, 27632], [76, 27852], [82, 28092], [85, 28252], [91, 28472], [95, 28652], [102, 28872], [109, 29152], [112, 29312], [122, 30012], [126, 30212], [131, 30392], [136, 30612], [145, 31232], [149, 31652], [158, 32212], [161, 32292], [165, 32392], [173, 33076], [177, 33199], [182, 33339], [188, 33579], [194, 33979], [198, 34319], [203, 34559], [210, 34919], [213, 35199]]}, {"verse": 6, "start": 35994, "end": 48065, "text": "And these things, brethren, I have in a figure transferred to myself and to Apollos for your sakes; that you might learn in us not to think of men above that which is written, that no one of you be puffed up for one against another.", "words": [[0, 35994], [4, 36096], [10, 36316], [18, 36556], [28, 37056], [30, 37556], [35, 37736], [38, 37836], [40, 37916], [47, 38136], [59, 38596], [62, 38856], [69, 39276], [73, 39616], [76, 39736], [84, 40216], [88, 40336], [93, 40476], [100, 41161], [105, 41301], [109, 41381], [115, 41561], [121, 41841], [124, 41961], [127, 42401], [131, 42521], [134, 42701], [140, 42921], [143, 43041], [147, 43241], [153, 43501], [158, 44161], [164, 44301], [167, 44461], [176, 45181], [181, 45341], [184, 45561], [188, 45781], [191, 45901], [195, 46021], [198, 46161], [205, 46581], [208, 46641], [212, 46841], [216, 47101], [224, 47461]]}, {"verse": 7, "start": 48415, "end": 57024, "text": "For who makes you to differ from another? and what have you that you did not receive? now if you did receive it, why do you glory, as if you had not received it?", "words": [[0, 48415], [4, 48543], [8, 48723], [14, 48963], [18, 49163], [21, 49303], [28, 49583], [33, 49883], [42, 50572], [46, 50716], [51, 50896], [56, 51076], [60, 51236], [65, 51416], [69, 51536], [73, 51716], [77, 51896], [86, 52706], [90, 53090], [93, 53190], [97, 53310], [101, 53490], [109, 53810], [113, 54410], [117, 54710], [120, 54870], [124, 54950], [131, 55310], [134, 55690], [137, 55850], [141, 56010], [145, 56150], [149, 56310], [158, 56650]]}, {"verse": 8, "start": 57375, "end": 64747, "text": "Now you are full, now you are rich, you have reigned as kings without us: and I would to God you did reign, that we also might reign with you.", "words": [[0, 57375], [4, 57514], [8, 57714], [12, 57814], [18, 58614], [22, 58734], [26, 58934], [30, 59034], [36, 59794], [40, 59874], [45, 60014], [53, 60334], [56, 60474], [62, 60714], [70, 61054], [74, 61701], [78, 61824], [80, 61944], [86, 62124], [89, 62284], [93, 62544], [97, 62724], [101, 62864], [108, 63184], [113, 63364], [116, 63524], [121, 63764], [127, 63984], [133, 64224], [138, 64424]]}, {"verse": 9, "start": 65097, "end": 73894, "text": "For I think that God has set forth us the apostles last, as it were appointed to death: for we are made a spectacle to the world, and to angels, and to men.", "words": [[0, 65097], [4, 65218], [6, 65318], [12, 65518], [17, 65718], [21, 65978], [25, 66298], [29, 66538], [35, 66858], [38, 67218], [42, 67398], [51, 67758], [57, 68558], [60, 68718], [63, 68858], [68, 69038], [78, 69458], [81, 69698], [88, 70211], [92, 70338], [95, 70478], [99, 70578], [104, 70778], [106, 70898], [116, 71278], [119, 71558], [123, 71698], [130, 71998], [134, 72418], [137, 72598], [145, 73058], [149, 73418], [152, 73578]]}, {"verse": 10, "start": 74244, "end": 81680, "text": "We are fools for Christ’s sake, but you are wise in Christ; we are weak, but you are strong; you are honourable, but we are despised.", "words": [[0, 74244], [3, 74367], [7, 74507], [13, 74747], [17, 75007], [26, 75547], [32, 75987], [36, 76107], [40, 76207], [44, 76327], [49, 76607], [52, 76787], [60, 77533], [63, 77656], [67, 77776], [73, 78436], [77, 78536], [81, 78656], [85, 78756], [93, 79537], [97, 79644], [101, 80084], [113, 80524], [117, 80604], [120, 80764], [124, 80864]]}, {"verse": 11, "start": 82030, "end": 90027, "text": "Even to this present hour we both hunger, and thirst, and are naked, and are buffeted, and have no certain dwellingplace;", "words": [[0, 82030], [5, 82235], [8, 82435], [13, 82655], [21, 82975], [26, 83295], [29, 83535], [34, 83735], [42, 84095], [46, 84555], [54, 84875], [58, 85435], [62, 85555], [69, 85915], [73, 86375], [77, 86515], [87, 86995], [91, 87415], [96, 87595], [99, 87815], [107, 88950]]}, {"verse": 12, "start": 90377, "end": 96109, "text": "And labour, working with our own hands: being reviled, we bless; being persecuted, we endure it:", "words": [[0, 90377], [4, 90546], [12, 90756], [20, 91216], [25, 91496], [29, 91636], [33, 91816], [40, 92605], [46, 92825], [55, 93585], [58, 93685], [65, 94445], [71, 94599], [83, 95359], [86, 95459], [93, 95759]]}, {"verse": 13, "start": 96459, "end": 101882, "text": "Being defamed, we entreat: we are made as the filth of the world, and are the offscouring of all things to this day.", "words": [[0, 96459], [6, 96582], [15, 97162], [18, 97362], [27, 98142], [30, 98247], [34, 98327], [39, 98507], [42, 98687], [46, 98807], [52, 99127], [55, 99207], [59, 99307], [66, 99547], [70, 99807], [74, 99927], [78, 100277], [90, 100627], [93, 100827], [97, 100947], [104, 101187], [107, 101407], [112, 101547]]}, {"verse": 14, "start": 102232, "end": 106501, "text": "I write not these things to shame you, but as my beloved sons I warn you.", "words": [[0, 102232], [2, 102388], [8, 102628], [12, 102908], [18, 103248], [25, 103508], [28, 103668], [34, 103988], [39, 104328], [43, 104548], [46, 104688], [49, 104828], [57, 105168], [62, 105568], [64, 105948], [69, 106228]]}, {"verse": 15, "start": 106851, "end": 114097, "text": "For though you have ten thousand instructors in Christ, yet have you not many fathers: for in Christ Jesus I have begotten you through the gospel.", "words": [[0, 106895], [4, 106961], [11, 107028], [15, 107248], [20, 107528], [24, 107808], [33, 108088], [45, 108528], [48, 108768], [56, 109368], [60, 109488], [65, 109688], [69, 109828], [73, 110028], [78, 110328], [87, 111186], [91, 111309], [94, 111509], [101, 111729], [107, 112209], [109, 112529], [114, 112689], [123, 113189], [127, 113309], [135, 113469], [139, 113609]]}, {"verse": 16, "start": 114447, "end": 116942, "text": "Therefore I beg you, be followers of me.", "words": [[0, 114447], [10, 115068], [12, 115308], [16, 115508], [21, 115968], [24, 116048], [34, 116388], [37, 116728]]}, {"verse": 17, "start": 117292, "end": 128547, "text": "For this cause have I sent to you Timotheus, who is my beloved son, and faithful in the Lord, who shall bring you into remembrance of my ways which be in Christ, as I teach every where in every church.", "words": [[0, 117292], [4, 117413], [9, 117673], [15, 117993], [20, 118273], [22, 118413], [27, 118693], [30, 118873], [34, 119433], [45, 119993], [49, 120113], [52, 120213], [55, 120373], [63, 120773], [68, 121213], [72, 121713], [81, 122113], [84, 122353], [88, 122453], [94, 123047], [98, 123168], [104, 123348], [110, 123608], [114, 123768], [119, 123948], [131, 124368], [134, 124728], [137, 124888], [142, 125168], [148, 125328], [151, 125548], [154, 125668], [162, 126008], [165, 126273], [167, 126413], [173, 126686], [179, 126960], [185, 127233], [188, 127633], [194, 127933]]}, {"verse": 18, "start": 128897, "end": 131799, "text": "Now some are puffed up, as though I would not come to you.", "words": [[0, 128897], [4, 129097], [9, 129397], [13, 129557], [20, 129957], [24, 130077], [27, 130477], [34, 130657], [36, 130797], [42, 130957], [46, 131137], [51, 131397], [54, 131597]]}, {"verse": 19, "start": 132149, "end": 138763, "text": "But I will come to you shortly, if the Lord will, and will know, not the speech of them which are puffed up, but the power.", "words": [[0, 132149], [4, 132248], [6, 132348], [11, 132488], [16, 132708], [19, 132888], [23, 133028], [32, 133648], [35, 133748], [39, 133888], [44, 134088], [50, 134428], [54, 134748], [59, 134968], [65, 135568], [69, 135868], [73, 136068], [80, 136328], [83, 136488], [88, 136688], [94, 136888], [98, 137028], [105, 137428], [109, 137888], [113, 138108], [117, 138248]]}, {"verse": 20, "start": 139113, "end": 141782, "text": "For the kingdom of God is not in word, but in power.", "words": [[0, 139113], [4, 139192], [8, 139292], [16, 139532], [19, 139772], [23, 139972], [26, 140132], [30, 140292], [33, 140452], [39, 140992], [43, 141172], [46, 141332]]}, {"verse": 21, "start": 142132, "end": 146665, "text": "What will you? shall I come to you with a rod, or in love, and in the spirit of meekness?", "words": [[0, 142132], [5, 142257], [10, 142457], [15, 142969], [21, 143128], [23, 143268], [28, 143488], [31, 143648], [35, 143748], [40, 143908], [42, 144008], [47, 144268], [50, 144588], [53, 144728], [59, 144968], [63, 145348], [66, 145448], [70, 145548], [77, 145828], [80, 146028]]}]}