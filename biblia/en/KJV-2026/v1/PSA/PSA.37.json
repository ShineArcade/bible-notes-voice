{"book": "PSA", "chapter": 37, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 232147, "verses": [{"verse": 1, "start": 300, "end": 5240, "text": "Fret not yourself because of evildoers, neither be envious against the workers of iniquity.", "words": [[0, 300], [5, 443], [9, 663], [18, 1063], [26, 1383], [29, 1583], [40, 2703], [48, 2903], [51, 3143], [59, 3543], [67, 3843], [71, 4083], [79, 4383], [82, 4623]]}, {"verse": 2, "start": 5690, "end": 9596, "text": "For they shall soon be cut down like the grass, and wither as the green herb.", "words": [[0, 5690], [4, 5768], [9, 5908], [15, 6088], [20, 6348], [23, 6508], [27, 6748], [32, 6988], [37, 7188], [41, 7348], [48, 7688], [52, 8248], [59, 8628], [62, 8748], [66, 8908], [72, 9088]]}, {"verse": 3, "start": 10046, "end": 16805, "text": "Trust in the LORD, and do good; so shall you dwell in the land, and indeed you shall be fed.", "words": [[0, 10046], [6, 10284], [9, 10584], [13, 10704], [19, 10984], [23, 11584], [26, 11884], [32, 12738], [35, 12942], [41, 13242], [45, 13482], [51, 13762], [54, 14062], [58, 14202], [64, 14902], [68, 15022], [75, 15422], [79, 15702], [85, 15982], [88, 16202]]}, {"verse": 4, "start": 17255, "end": 21893, "text": "Delight yourself also in the LORD; and he shall give you the desires of your heart.", "words": [[0, 17255], [8, 17600], [17, 18020], [22, 18540], [25, 18820], [29, 18940], [35, 19675], [39, 19773], [42, 19893], [48, 20093], [53, 20293], [57, 20453], [61, 20593], [69, 21013], [72, 21313], [77, 21453]]}, {"verse": 5, "start": 22343, "end": 27131, "text": "Commit your way to the LORD; trust also in him; and he shall bring it to pass.", "words": [[0, 22343], [7, 22646], [12, 22766], [16, 23006], [19, 23146], [23, 23286], [29, 24019], [35, 24262], [40, 24662], [43, 24922], [48, 25587], [52, 25705], [55, 25825], [61, 26005], [67, 26265], [70, 26385], [73, 26525]]}, {"verse": 6, "start": 27581, "end": 32167, "text": "And he shall bring forth your righteousness as the light, and your judgment as the noonday.", "words": [[0, 27581], [4, 27706], [7, 27826], [13, 28006], [19, 28226], [25, 28486], [30, 28686], [44, 29186], [47, 29566], [51, 29726], [58, 29986], [62, 30506], [67, 30646], [76, 31026], [79, 31386], [83, 31526]]}, {"verse": 7, "start": 32617, "end": 42451, "text": "Rest in the LORD, and wait patiently for him: fret not yourself because of him who prospers in his way, because of the man who brings wicked devices to pass.", "words": [[0, 32617], [5, 32842], [8, 33042], [12, 33162], [18, 33442], [22, 33882], [27, 34082], [37, 34522], [41, 34922], [46, 35686], [51, 35786], [55, 36006], [64, 36526], [72, 36886], [75, 37166], [79, 37346], [83, 37566], [92, 38186], [95, 38326], [99, 38506], [104, 39246], [112, 39506], [115, 39766], [119, 39906], [123, 40166], [127, 40386], [134, 40646], [141, 41006], [149, 41506], [152, 41766]]}, {"verse": 8, "start": 42901, "end": 47925, "text": "Cease from anger, and forsake wrath: fret not yourself in any wise to do evil.", "words": [[0, 42901], [6, 43124], [11, 43364], [18, 43784], [22, 43984], [30, 44564], [37, 45471], [42, 45561], [46, 45781], [55, 46221], [58, 46441], [62, 46621], [67, 46941], [70, 47161], [73, 47341]]}, {"verse": 9, "start": 48375, "end": 54023, "text": "For evildoers shall be cut off: but those that wait upon the LORD, they shall inherit the earth.", "words": [[0, 48375], [4, 48482], [14, 49202], [20, 49422], [23, 49582], [27, 49842], [32, 50642], [36, 50725], [42, 50965], [47, 51165], [52, 51345], [57, 51645], [61, 51885], [67, 52585], [72, 52725], [78, 52925], [86, 53325], [90, 53565]]}, {"verse": 10, "start": 54473, "end": 61612, "text": "For yet a little while, and the wicked shall not be: yes, you shall diligently consider his place, and it shall not be.", "words": [[0, 54473], [4, 54582], [8, 54742], [10, 54882], [17, 55022], [24, 55842], [28, 55962], [32, 56082], [39, 56302], [45, 56662], [49, 56882], [53, 57698], [58, 58243], [62, 58323], [68, 58523], [79, 59023], [88, 59603], [92, 59843], [99, 60383], [103, 60503], [106, 60623], [112, 60883], [116, 61123]]}, {"verse": 11, "start": 62062, "end": 66939, "text": "But the meek shall inherit the earth; and shall delight themselves in the abundance of peace.", "words": [[0, 62062], [4, 62163], [8, 62303], [13, 62603], [19, 62803], [27, 63203], [31, 63423], [38, 64086], [42, 64195], [48, 64415], [56, 64755], [67, 65235], [70, 65555], [74, 65655], [84, 65995], [87, 66315]]}, {"verse": 12, "start": 67389, "end": 71723, "text": "The wicked plots against the just, and gnashes upon him with his teeth.", "words": [[0, 67389], [4, 67493], [11, 67753], [17, 68253], [25, 68573], [29, 68813], [35, 69113], [39, 69733], [47, 70133], [52, 70493], [56, 70813], [61, 71053], [65, 71213]]}, {"verse": 13, "start": 72173, "end": 76833, "text": "The Lord shall laugh at him: for he sees that his day is coming.", "words": [[0, 72173], [4, 72455], [9, 72735], [15, 72995], [21, 73315], [24, 73495], [29, 74208], [33, 74326], [36, 74486], [41, 74786], [46, 75066], [50, 75206], [54, 75486], [57, 75646]]}, {"verse": 14, "start": 77283, "end": 85042, "text": "The wicked have drawn out the sword, and have bent their bow, to cast down the poor and needy, and to slay such as be of upright conduct.", "words": [[0, 77283], [4, 77391], [11, 77631], [16, 77851], [22, 78131], [26, 78331], [30, 78491], [37, 78851], [41, 79111], [46, 79271], [51, 79531], [57, 79751], [62, 80051], [65, 80511], [70, 80811], [75, 81111], [79, 81271], [84, 81611], [88, 81851], [95, 82311], [99, 82691], [102, 82851], [107, 83191], [112, 83411], [115, 83571], [118, 83771], [121, 83931], [129, 84251]]}, {"verse": 15, "start": 85492, "end": 89874, "text": "Their sword shall enter into their own heart, and their bows shall be broken.", "words": [[0, 85492], [6, 85606], [12, 86026], [18, 86326], [24, 86666], [29, 86926], [35, 87146], [39, 87346], [46, 87966], [50, 88246], [56, 88386], [61, 88726], [67, 89066], [70, 89226]]}, {"verse": 16, "start": 90324, "end": 94180, "text": "A little that a righteous man has is better than the riches of many wicked.", "words": [[0, 90324], [2, 90429], [9, 90629], [14, 90869], [16, 90969], [26, 91269], [30, 91589], [34, 91989], [37, 92189], [44, 92469], [49, 92709], [53, 92829], [60, 93089], [63, 93349], [68, 93629]]}, {"verse": 17, "start": 94630, "end": 99404, "text": "For the arms of the wicked shall be broken: but the LORD upholds the righteous.", "words": [[0, 94630], [4, 94719], [8, 94819], [13, 95239], [16, 95439], [20, 95559], [27, 95879], [33, 96239], [36, 96419], [44, 97397], [48, 97501], [52, 97641], [57, 97921], [65, 98621], [69, 98741]]}, {"verse": 18, "start": 99854, "end": 104697, "text": "The LORD knows the days of the upright: and their inheritance shall be for ever.", "words": [[0, 99854], [4, 99958], [9, 100218], [15, 100538], [19, 100818], [24, 101138], [27, 101318], [31, 101458], [40, 102441], [44, 102587], [50, 102767], [62, 103327], [68, 103747], [71, 104066], [75, 104386]]}, {"verse": 19, "start": 105147, "end": 110617, "text": "They shall not be ashamed in the evil time: and in the days of famine they shall be satisfied.", "words": [[0, 105147], [5, 105291], [11, 105511], [15, 105751], [18, 105991], [26, 106431], [29, 106731], [33, 106831], [38, 107091], [44, 108028], [48, 108157], [51, 108257], [55, 108357], [60, 108677], [63, 108817], [70, 109337], [75, 109437], [81, 109617], [84, 109757]]}, {"verse": 20, "start": 111067, "end": 120056, "text": "But the wicked shall perish, and the enemies of the LORD shall be as the fat of lambs: they shall consume; into smoke shall they consume away.", "words": [[0, 111067], [4, 111196], [8, 111356], [15, 111616], [21, 111976], [29, 112776], [33, 113136], [37, 113256], [45, 113576], [48, 113856], [52, 113976], [57, 114276], [63, 114596], [66, 114816], [69, 115016], [73, 115156], [77, 115416], [80, 115596], [87, 116564], [92, 116683], [98, 116863], [107, 118015], [112, 118200], [118, 118620], [124, 118900], [129, 119080], [137, 119460]]}, {"verse": 21, "start": 120506, "end": 125786, "text": "The wicked borrows, and pays not again: but the righteous shows mercy, and gives.", "words": [[0, 120506], [4, 120590], [11, 120830], [20, 121470], [24, 121590], [29, 121910], [33, 122230], [40, 123146], [44, 123276], [48, 123416], [58, 123736], [64, 124156], [71, 124736], [75, 125136]]}, {"verse": 22, "start": 126236, "end": 132001, "text": "For such as be blessed of him shall inherit the earth; and they that be cursed of him shall be cut off.", "words": [[0, 126236], [4, 126323], [9, 126583], [12, 126743], [15, 126903], [23, 127223], [26, 127463], [30, 127643], [36, 127943], [44, 128323], [48, 128603], [55, 129360], [59, 129502], [64, 129722], [69, 129902], [72, 130082], [79, 130382], [82, 130622], [86, 130782], [92, 131062], [95, 131222], [99, 131482]]}, {"verse": 23, "start": 132451, "end": 137075, "text": "The steps of a good man are ordered by the LORD: and he delights in his way.", "words": [[0, 132451], [4, 132531], [10, 132831], [13, 133091], [15, 133191], [20, 133371], [24, 133691], [28, 133991], [36, 134311], [39, 134591], [43, 134731], [49, 135542], [53, 135661], [56, 135781], [65, 136241], [68, 136421], [72, 136581]]}, {"verse": 24, "start": 137525, "end": 142806, "text": "Though he fall, he shall not be utterly cast down: for the LORD upholds him with his hand.", "words": [[0, 137525], [7, 137628], [10, 137808], [16, 138488], [19, 138608], [25, 138808], [29, 139048], [32, 139208], [40, 139508], [45, 139928], [51, 140882], [55, 140952], [59, 141092], [64, 141312], [72, 141872], [76, 141972], [81, 142152], [85, 142292]]}, {"verse": 25, "start": 143256, "end": 150106, "text": "I have been young, and now am old; yet have I not seen the righteous forsaken, nor his seed begging bread.", "words": [[0, 143256], [2, 143422], [7, 143602], [12, 143842], [19, 144162], [23, 144582], [27, 144822], [30, 145062], [35, 145792], [39, 146192], [44, 146412], [46, 146552], [50, 146732], [55, 147052], [59, 147232], [69, 147512], [79, 148512], [83, 148652], [87, 148852], [92, 149172], [100, 149492]]}, {"verse": 26, "start": 150556, "end": 154563, "text": "He is ever merciful, and lends; and his seed is blessed.", "words": [[0, 150556], [3, 150674], [6, 150834], [11, 151034], [21, 151534], [25, 152114], [32, 153085], [36, 153229], [40, 153369], [45, 153769], [48, 153969]]}, {"verse": 27, "start": 155013, "end": 158742, "text": "Depart from evil, and do good; and dwell for evermore.", "words": [[0, 155013], [7, 155355], [12, 155535], [18, 155915], [22, 156175], [25, 156355], [31, 157209], [35, 157365], [41, 157841], [45, 158318]]}, {"verse": 28, "start": 159192, "end": 167035, "text": "For the LORD loves judgment, and forsakes not his saints; they are preserved for ever: but the seed of the wicked shall be cut off.", "words": [[0, 159192], [4, 159294], [8, 159414], [13, 159654], [19, 159994], [29, 160494], [33, 160854], [42, 161414], [46, 161714], [50, 161954], [58, 162933], [63, 163080], [67, 163200], [77, 163655], [81, 164110], [87, 164806], [91, 164894], [95, 165034], [100, 165274], [103, 165414], [107, 165534], [114, 165814], [120, 166114], [123, 166274], [127, 166514]]}, {"verse": 29, "start": 167485, "end": 170761, "text": "The righteous shall inherit the land, and dwell in it for ever.", "words": [[0, 167485], [4, 167575], [14, 167895], [20, 168215], [28, 168535], [32, 168815], [38, 169175], [42, 169475], [48, 169735], [51, 169955], [54, 170244], [58, 170534]]}, {"verse": 30, "start": 171211, "end": 175174, "text": "The mouth of the righteous speaks wisdom, and his tongue talks of judgment.", "words": [[0, 171211], [4, 171328], [10, 171628], [13, 171828], [17, 171968], [27, 172248], [34, 172628], [42, 173328], [46, 173468], [50, 173608], [57, 173948], [63, 174348], [66, 174548]]}, {"verse": 31, "start": 175624, "end": 179684, "text": "The law of his God is in his heart; none of his steps shall slide.", "words": [[0, 175624], [4, 175703], [8, 176003], [11, 176163], [15, 176283], [19, 176623], [22, 176883], [25, 177003], [29, 177163], [36, 177913], [41, 178077], [44, 178237], [48, 178357], [54, 178697], [60, 179017]]}, {"verse": 32, "start": 180134, "end": 183380, "text": "The wicked watches the righteous, and seeks to slay him.", "words": [[0, 180134], [4, 180250], [11, 180550], [19, 180990], [23, 181270], [34, 181650], [38, 182130], [44, 182430], [47, 182670], [52, 183070]]}, {"verse": 33, "start": 183830, "end": 187925, "text": "The LORD will not leave him in his hand, nor condemn him when he is judged.", "words": [[0, 183830], [4, 183977], [9, 184217], [14, 184417], [18, 184617], [24, 184857], [28, 185037], [31, 185177], [35, 185317], [41, 185977], [45, 186157], [53, 186497], [57, 186857], [62, 187057], [65, 187217], [68, 187317]]}, {"verse": 34, "start": 188375, "end": 196325, "text": "Wait on the LORD, and keep his way, and he shall exalt you to inherit the land: when the wicked are cut off, you shall see it.", "words": [[0, 188375], [5, 188543], [8, 188723], [12, 188863], [18, 189523], [22, 189683], [27, 189903], [31, 190123], [36, 190783], [40, 190943], [43, 191083], [49, 191283], [55, 191783], [59, 191983], [62, 192163], [70, 192543], [74, 192763], [80, 193557], [85, 193686], [89, 193806], [96, 194046], [100, 194226], [104, 194426], [109, 194886], [113, 195006], [119, 195246], [123, 195526]]}, {"verse": 35, "start": 196775, "end": 201466, "text": "I have seen the wicked in great power, and spreading himself like a green bay tree.", "words": [[0, 196775], [2, 196944], [7, 197084], [12, 197364], [16, 197564], [23, 197844], [26, 198064], [32, 198324], [39, 198764], [43, 199204], [53, 199524], [61, 200004], [66, 200304], [68, 200424], [74, 200664], [78, 200924]]}, {"verse": 36, "start": 201916, "end": 207552, "text": "Yet he passed away, and, lo, he was not: yes, I sought him, but he could not be found.", "words": [[0, 201916], [4, 202042], [7, 202182], [14, 202522], [20, 203282], [25, 203382], [29, 204042], [32, 204142], [36, 204342], [41, 205116], [46, 205395], [48, 205475], [55, 205735], [60, 206295], [64, 206415], [67, 206535], [73, 206675], [77, 206835], [80, 207015]]}, {"verse": 37, "start": 208002, "end": 212553, "text": "Mark the perfect man, and behold the upright: for the end of that man is peace.", "words": [[0, 208002], [5, 208170], [9, 208350], [17, 208630], [22, 208970], [26, 209250], [33, 209490], [37, 209750], [46, 210560], [50, 210629], [54, 210769], [58, 211029], [61, 211149], [66, 211329], [70, 211609], [73, 211849]]}, {"verse": 38, "start": 213003, "end": 217977, "text": "But the transgressors shall be destroyed together: the end of the wicked shall be cut off.", "words": [[0, 213003], [4, 213110], [8, 213250], [22, 213950], [28, 214170], [31, 214330], [41, 214790], [51, 215839], [55, 215941], [59, 216281], [62, 216421], [66, 216541], [73, 216801], [79, 217121], [82, 217281], [86, 217501]]}, {"verse": 39, "start": 218427, "end": 224183, "text": "But the salvation of the righteous is of the LORD: he is their strength in the time of trouble.", "words": [[0, 218427], [4, 218759], [8, 218899], [18, 219459], [21, 219859], [25, 219979], [35, 220319], [38, 220719], [41, 220879], [45, 221039], [51, 221896], [54, 222039], [57, 222259], [63, 222439], [72, 222879], [75, 223159], [79, 223259], [84, 223519], [87, 223679]]}, {"verse": 40, "start": 224633, "end": 231747, "text": "And the LORD shall help them, and deliver them: he shall deliver them from the wicked, and save them, because they trust in him.", "words": [[0, 224633], [4, 224754], [8, 224874], [13, 225114], [19, 225394], [24, 225694], [30, 225974], [34, 226434], [42, 226734], [48, 227492], [51, 227572], [57, 227792], [65, 228172], [70, 228432], [75, 228652], [79, 228832], [87, 229112], [91, 229512], [96, 229832], [102, 230292], [110, 230672], [115, 230912], [121, 231192], [124, 231432]]}]}