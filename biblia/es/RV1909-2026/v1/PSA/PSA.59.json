{"book": "PSA", "chapter": 59, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 137092, "verses": [{"verse": 1, "start": 300, "end": 15916, "text": "Al Músico principal: sobre No destruyas: Michtam de David, cuando envió Saúl, y guardaron la casa para matarlo. LÍBRAME de mis enemigos, oh Dios mío: ponme en salvo de los que contra mí se levantan.", "words": [[0, 300], [3, 489], [10, 989], [21, 2173], [27, 2537], [30, 2977], [41, 4685], [49, 4945], [52, 5165], [59, 6005], [66, 6345], [72, 6745], [78, 7385], [80, 7685], [90, 8245], [93, 8405], [98, 8725], [103, 9005], [112, 10091], [120, 10556], [123, 10716], [127, 10856], [137, 11326], [140, 11796], [145, 11956], [150, 12739], [156, 13123], [159, 13283], [165, 13843], [168, 14123], [172, 14263], [176, 14443], [183, 14803], [186, 15003], [189, 15163]]}, {"verse": 2, "start": 16366, "end": 21929, "text": "Líbrame de los que obran iniquidad, y sálvame de hombres sanguinarios.", "words": [[0, 16366], [8, 17194], [11, 17434], [15, 17574], [19, 17854], [25, 18134], [36, 19034], [38, 19534], [46, 20074], [49, 20294], [57, 20614]]}, {"verse": 3, "start": 22379, "end": 31087, "text": "Porque he aquí están acechando mi vida: se han juntado contra mí fuertes, no por falta mía, ni pecado mío, oh Jehová.", "words": [[0, 22683], [7, 23023], [10, 23063], [15, 23563], [21, 23823], [31, 24423], [34, 24623], [40, 25474], [43, 25633], [47, 25793], [55, 26353], [62, 26633], [65, 26913], [74, 27833], [77, 27973], [81, 28193], [87, 28513], [92, 28933], [95, 29353], [102, 29773], [107, 30228], [110, 30683]]}, {"verse": 4, "start": 31537, "end": 37395, "text": "Sin delito mío corren y se preparan: despierta para venir a mi encuentro, y mira.", "words": [[0, 31537], [4, 31744], [11, 32164], [15, 32564], [22, 33084], [24, 33324], [27, 33504], [37, 35090], [47, 35490], [52, 35690], [58, 35970], [60, 36130], [63, 36230], [74, 36850], [76, 36990]]}, {"verse": 5, "start": 37845, "end": 50532, "text": "Y tú, Jehová Dios de los ejércitos, Dios de Israel, despierta para castigar a todas las naciones: no hayas misericordia de todos los que se rebelan con iniquidad. (Selah.)", "words": [[0, 37845], [2, 37988], [6, 38568], [13, 39068], [18, 39268], [21, 39488], [25, 39628], [36, 40848], [41, 41088], [44, 41348], [52, 42188], [62, 43208], [67, 43578], [76, 43948], [78, 44088], [84, 44308], [88, 44608], [98, 45765], [101, 45911], [107, 46331], [120, 47171], [123, 47331], [129, 47551], [133, 47831], [137, 47991], [140, 48381], [148, 48771], [152, 48911], [163, 50308]]}, {"verse": 6, "start": 50982, "end": 56288, "text": "Se volverán a la tarde, ladrarán como perros, y rodearán la ciudad.", "words": [[0, 50982], [3, 51125], [12, 51665], [14, 51745], [17, 51845], [24, 52585], [33, 53125], [38, 53345], [46, 54165], [48, 54725], [57, 55425], [60, 55565]]}, {"verse": 7, "start": 56738, "end": 62573, "text": "He aquí proferirán con su boca; cuchillos están en sus labios, porque dicen: ¿Quién oye?", "words": [[0, 56871], [3, 57041], [8, 57541], [19, 58041], [23, 58201], [26, 58421], [32, 59161], [42, 59621], [48, 59941], [51, 60141], [55, 60281], [63, 60661], [70, 61041], [77, 61941], [84, 62161]]}, {"verse": 8, "start": 62923, "end": 68573, "text": "Mas tú, Jehová, te reirás de ellos, te burlarás de todas las naciones.", "words": [[0, 62923], [4, 63089], [8, 63669], [16, 64569], [19, 64769], [26, 65209], [29, 65389], [36, 66229], [39, 66449], [48, 67109], [51, 67249], [57, 67469], [61, 67709]]}, {"verse": 9, "start": 69023, "end": 73173, "text": "De su fuerza esperaré yo en ti: porque Dios es mi defensa.", "words": [[0, 69023], [3, 69191], [6, 69331], [13, 70051], [22, 70531], [25, 70751], [28, 70931], [32, 71549], [39, 71735], [44, 72055], [47, 72255], [50, 72395]]}, {"verse": 10, "start": 73623, "end": 79811, "text": "El Dios de mi misericordia saldrá a mi encuentro: Dios me hará ver en mis enemigos mi deseo.", "words": [[0, 73623], [3, 73998], [8, 74198], [11, 74378], [14, 74498], [27, 75338], [34, 75918], [36, 76058], [39, 76198], [50, 77249], [55, 77516], [58, 77876], [63, 78136], [67, 78256], [70, 78396], [74, 78596], [83, 79076], [86, 79216]]}, {"verse": 11, "start": 80261, "end": 89512, "text": "No los matarás, porque mi pueblo no se olvide: hazlos vagar con tu fortaleza; y abátelos, oh Jehová, escudo nuestro,", "words": [[0, 80261], [3, 80484], [7, 80664], [16, 81344], [23, 81824], [26, 82044], [33, 82404], [36, 82664], [39, 82804], [47, 83778], [54, 84258], [60, 84678], [64, 84858], [67, 85018], [78, 86290], [80, 86795], [90, 87300], [93, 87805], [101, 88310], [108, 88850]]}, {"verse": 12, "start": 89962, "end": 98893, "text": "Por el pecado de su boca, por la palabra de sus labios; y sean presos por su soberbia y por las maldiciones y mentiras que profieren.", "words": [[0, 89962], [4, 90107], [7, 90247], [14, 90707], [17, 90887], [20, 91027], [26, 91507], [30, 91687], [33, 91827], [41, 92127], [44, 92367], [48, 92507], [56, 93509], [58, 93638], [63, 93878], [70, 94578], [74, 94898], [77, 95118], [86, 95778], [88, 96158], [92, 96318], [96, 96458], [108, 97058], [110, 97338], [119, 97878], [123, 98018]]}, {"verse": 13, "start": 99343, "end": 107538, "text": "Acábalos con furor, acábalos, y no sean: y sepan que Dios domina en Jacob hasta los fines de la tierra. (Selah.)", "words": [[0, 99343], [9, 99903], [13, 100123], [20, 101043], [30, 101643], [32, 101943], [35, 102103], [41, 103081], [43, 103188], [49, 103588], [53, 103768], [58, 104008], [65, 104508], [68, 104628], [74, 105008], [80, 105388], [84, 105568], [90, 105848], [93, 106028], [96, 106128], [104, 107286]]}, {"verse": 14, "start": 107988, "end": 112467, "text": "Vuelvan pues a la tarde, y ladren como perros, y rodeen la ciudad.", "words": [[0, 107988], [8, 108436], [13, 108596], [15, 108796], [18, 108896], [25, 109196], [27, 109616], [34, 110016], [39, 110276], [47, 110916], [49, 111096], [56, 111616], [59, 111776]]}, {"verse": 15, "start": 112917, "end": 118864, "text": "Anden