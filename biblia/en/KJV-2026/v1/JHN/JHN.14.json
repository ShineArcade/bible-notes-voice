{"book": "JHN", "chapter": 14, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 211884, "verses": [{"verse": 1, "start": 300, "end": 4381, "text": "Let not your heart be troubled: you believe in God, believe also in me.", "words": [[0, 300], [4, 478], [8, 698], [13, 879], [19, 1118], [22, 1258], [32, 1988], [36, 2129], [44, 2349], [47, 2569], [52, 3389], [60, 3449], [65, 3829], [68, 4049]]}, {"verse": 2, "start": 4731, "end": 10884, "text": "In my Father’s house are many mansions: if it were not so, I would have told you. I go to prepare a place for you.", "words": [[0, 4731], [3, 4834], [6, 4954], [15, 5394], [21, 5594], [25, 5794], [30, 6014], [40, 6956], [43, 7098], [46, 7198], [51, 7278], [55, 7458], [59, 7978], [61, 8078], [67, 8198], [72, 8278], [77, 8478], [82, 9067], [84, 9232], [87, 9452], [90, 9612], [98, 9892], [100, 10092], [106, 10332], [110, 10612]]}, {"verse": 3, "start": 11234, "end": 18734, "text": "And if I go and prepare a place for you, I will come again, and receive you to myself; that where I am, there you may be also.", "words": [[0, 11234], [4, 11311], [7, 11451], [9, 11611], [12, 11851], [16, 12071], [24, 12351], [26, 12491], [32, 12731], [36, 12991], [41, 13511], [43, 13731], [48, 13871], [53, 14071], [60, 14391], [64, 14731], [72, 15051], [76, 15271], [79, 15411], [87, 16148], [92, 16279], [98, 16499], [100, 16779], [104, 17379], [110, 17639], [114, 17819], [118, 17999], [121, 18159]]}, {"verse": 4, "start": 19084, "end": 21627, "text": "And where I go you know, and the way you know.", "words": [[0, 19084], [4, 19186], [10, 19366], [12, 19586], [15, 19786], [19, 20006], [25, 20626], [29, 20746], [33, 20866], [37, 21006], [41, 21206]]}, {"verse": 5, "start": 21907, "end": 26296, "text": "Thomas says to him, Lord, we know not where you go; and how can we know the way?", "words": [[0, 22027], [7, 22147], [12, 22427], [15, 22687], [20, 23215], [26, 23599], [29, 23659], [34, 23839], [38, 24039], [44, 24299], [48, 24459], [52, 25089], [56, 25188], [60, 25368], [64, 25568], [67, 25668], [72, 25828], [76, 25968]]}, {"verse": 6, "start": 26576, "end": 33932, "text": "Jesus says to him, I am the way, the truth, and the life: no man comes to the Father, but by me.", "words": [[0, 26576], [6, 26831], [11, 27171], [14, 27411], [19, 28707], [21, 28929], [24, 29069], [28, 29209], [33, 29829], [37, 29909], [44, 30649], [48, 30809], [52, 30949], [58, 31529], [61, 31713], [65, 31953], [71, 32293], [74, 32533], [78, 32653], [86, 32953], [90, 33273], [93, 33513]]}, {"verse": 7, "start": 34282, "end": 40697, "text": "If you had known me, you should have known my Father also: and from now on you know him, and have seen him.", "words": [[0, 34282], [3, 34419], [7, 34599], [11, 34759], [17, 34959], [21, 35519], [25, 35659], [32, 35819], [37, 35959], [43, 36179], [46, 36399], [53, 36699], [59, 37662], [63, 37786], [68, 37966], [72, 38226], [75, 38586], [79, 38746], [84, 38946], [89, 39206], [93, 39786], [98, 40026], [103, 40266]]}, {"verse": 8, "start": 40977, "end": 44876, "text": "Philip says to him, Lord, show us the Father, and it suffices us.", "words": [[0, 40977], [7, 41217], [12, 41497], [15, 41737], [20, 42259], [26, 42502], [31, 42822], [34, 43022], [38, 43142], [46, 43422], [50, 43782], [53, 43902], [62, 44422]]}, {"verse": 9, "start": 45156, "end": 56595, "text": "Jesus says to him, Have I been so long time with you, and yet have you not known me, Philip? he that has seen me has seen the Father; and how do you say then, Show us the Father?", "words": [[0, 45156], [6, 45411], [11, 45751], [14, 45991], [19, 47286], [24, 47410], [26, 47510], [31, 47710], [34, 47990], [39, 48230], [44, 48530], [49, 48790], [54, 49510], [58, 49630], [62, 49830], [67, 50070], [71, 50210], [75, 50430], [81, 50710], [85, 50950], [93, 51661], [96, 51853], [101, 52113], [105, 52273], [110, 52553], [113, 52793], [117, 53013], [122, 53253], [126, 53373], [134, 54102], [138, 54241], [142, 54401], [145, 54521], [149, 54621], [153, 54821], [159, 55361], [164, 55741], [167, 55921], [171, 56061]]}, {"verse": 10, "start": 56945, "end": 66600, "text": "Do you not believe that I am in the Father, and the Father in me? the words that I speak to you I speak not of myself: but the Father that dwells in me, he does the works.", "words": [[0, 56945], [3, 57029], [7, 57149], [11, 57289], [19, 57689], [24, 57909], [26, 58089], [29, 58209], [32, 58329], [36, 58429], [44, 58769], [48, 59349], [52, 59509], [59, 59729], [62, 59969], [66, 60582], [70, 60665], [76, 60945], [81, 61185], [83, 61325], [89, 61585], [92, 61825], [96, 62165], [98, 62265], [104, 62524], [108, 62785], [111, 62945], [119, 63757], [123, 63859], [127, 63979], [134, 64279], [139, 64519], [146, 64959], [149, 65059], [153, 65539], [156, 65619], [161, 65839], [165, 66019]]}, {"verse": 11, "start": 66950, "end": 72537, "text": "Believe me that I am in the Father, and the Father in me: or else believe me for the very works’ sake.", "words": [[0, 66950], [8, 67234], [11, 67534], [16, 67754], [18, 67894], [21, 67994], [24, 68114], [28, 68214], [36, 68974], [40, 69074], [44, 69214], [51, 69494], [54, 69734], [58, 70298], [61, 70419], [66, 70579], [74, 70899], [77, 71199], [81, 71359], [85, 71479], [90, 71699], [97, 72099]]}, {"verse": 12, "start": 72887, "end": 82494, "text": "Most assuredly, I say to you, He that believes on me, the works that I do shall he do also; and greater works than these shall he do; because I go to my Father.", "words": [[0, 72887], [5, 73071], [16, 73691], [18, 73811], [22, 74051], [25, 74251], [30, 74751], [33, 75011], [38, 75271], [47, 75591], [50, 75871], [54, 76371], [58, 76471], [64, 76711], [69, 76931], [71, 77051], [74, 77251], [80, 77471], [83, 77671], [86, 77871], [92, 78810], [96, 78934], [104, 79174], [110, 79474], [115, 79694], [121, 79954], [127, 80194], [130, 80354], [134, 80984], [142, 81324], [144, 81484], [147, 81644], [150, 81784], [153, 81944]]}, {"verse": 13, "start": 82844, "end": 87961, "text": "And whatever you shall ask in my name, that will I do, that the Father may be glorified in the Son.", "words": [[0, 82844], [4, 82950], [13, 83230], [17, 83450], [23, 83630], [27, 83930], [30, 84070], [33, 84270], [39, 84810], [44, 85030], [49, 85190], [51, 85370], [55, 85830], [60, 86030], [64, 86150], [71, 86410], [75, 86630], [78, 86730], [88, 87270], [91, 87430], [95, 87530]]}, {"verse": 14, "start": 88311, "end": 90959, "text": "If you shall ask any thing in my name, I will do it.", "words": [[0, 88311], [3, 88433], [7, 88553], [13, 88713], [17, 88900], [21, 89086], [27, 89273], [30, 89533], [33, 89693], [39, 90233], [41, 90353], [46, 90493], [49, 90673]]}, {"verse": 15, "start": 91309, "end": 93479, "text": "¶ If you love me, keep my commandments.", "words": [[2, 91309], [5, 91450], [9, 91570], [14, 91810], [18, 92270], [23, 92430], [26, 92630]]}, {"verse": 16, "start": 93829, "end": 98784, "text": "And I will pray the Father, and he shall give you another Comforter, that he may abide with you for ever;", "words": [[0, 93829], [4, 93910], [6, 94050], [11, 94170], [16, 94390], [20, 94530], [28, 95270], [32, 95350], [35, 95490], [41, 95650], [46, 95850], [50, 95950], [58, 96210], [69, 96970], [74, 97110], [77, 97270], [81, 97410], [87, 97770], [92, 97990], [96, 98150], [100, 98330]]}, {"verse": 17, "start": 99134, "end": 109856, "text": "Even the Spirit of truth; whom the world cannot receive, because it sees him not, neither knows him: but you know him; for he dwells with you, and shall be in you.", "words": [[0, 99134], [5, 99516], [9, 99696], [16, 99976], [19, 100136], [26, 101166], [31, 101346], [35, 101526], [41, 101846], [48, 102166], [57, 103026], [65, 103526], [68, 103706], [73, 103946], [77, 104166], [82, 104786], [90, 105006], [96, 105406], [101, 106088], [105, 106194], [109, 106394], [114, 106634], [119, 107342], [123, 107447], [126, 107607], [133, 108047], [138, 108207], [143, 108407], [147, 108727], [153, 109007], [156, 109247], [159, 109467]]}, {"verse": 18, "start": 110206, "end": 113320, "text": "I will not leave you comfortless: I will come to you.", "words": [[0, 110206], [2, 110356], [7, 110476], [11, 110656], [17, 110936], [21, 111156], [34, 112274], [36, 112459], [41, 112599], [46, 112819], [49, 113019]]}, {"verse": 19, "start": 113670, "end": 120069, "text": "Yet a little while, and the world sees me no more; but you see me: because I live, you shall live also.", "words": [[0, 113670], [4, 113790], [6, 113910], [13, 114090], [20, 114430], [24, 114950], [28, 115070], [34, 115330], [39, 115650], [42, 115850], [45, 116070], [51, 116802], [55, 116887], [59, 117027], [63, 117307], [67, 117907], [75, 118091], [77, 118311], [83, 118931], [87, 119071], [93, 119231], [98, 119451]]}, {"verse": 20, "start": 120419, "end": 124779, "text": "At that day you shall know that I am in my Father, and you in me, and I in you.", "words": [[0, 120419], [3, 120528], [8, 120728], [12, 120968], [16, 121148], [22, 121308], [27, 121508], [32, 121688], [34, 121808], [37, 121928], [40, 122008], [43, 122168], [51, 122948], [55, 123028], [59, 123208], [62, 123368], [66, 123928], [70, 124028], [72, 124228], [75, 124428]]}, {"verse": 21, "start": 125129, "end": 136132, "text": "He that has my commandments, and keeps them, he it is that loves me: and he that loves me shall be loved of my Father, and I will love him, and will manifest myself to him.", "words": [[0, 125129], [3, 125237], [8, 125397], [12, 125617], [15, 125777], [29, 126237], [33, 126777], [39, 127057], [45, 127657], [48, 127837], [51, 128157], [54, 128437], [59, 128657], [65, 128877], [69, 129488], [73, 129629], [76, 129849], [81, 130069], [87, 130349], [90, 130629], [96, 130969], [99, 131129], [105, 131429], [108, 131609], [111, 131789], [119, 132549], [123, 132809], [125, 132989], [130, 133149], [135, 133409], [140, 134189], [144, 134289], [149, 134449], [158, 134909], [165, 135489], [168, 135729]]}, {"verse": 22, "start": 136412, "end": 143058, "text": "Judas says to him, not Iscariot, Lord, how is it that you will manifest yourself to us, and not to the world?", "words": [[0, 136412], [6, 136610], [11, 136970], [14, 137190], [19, 137690], [23, 137930], [33, 138969], [39, 139418], [43, 139558], [46, 139798], [49, 139958], [54, 140138], [58, 140318], [63, 140458], [72, 140898], [81, 141378], [84, 141658], [88, 141898], [92, 142098], [96, 142318], [99, 142518], [103, 142618]]}, {"verse": 23, "start": 143338, "end": 151891, "text": "Jesus answered and said to him, If a man love me, he will keep my words: and my Father will love him, and we will come to him, and make our abode with him.", "words": [[0, 143338], [6, 143568], [15, 144128], [19, 144328], [24, 144548], [27, 144748], [32, 145236], [35, 145366], [37, 145466], [41, 145726], [46, 145966], [50, 146546], [53, 146646], [58, 146766], [63, 146966], [66, 147186], [73, 147993], [77, 148093], [80, 148213], [87, 148493], [92, 148713], [97, 148993], [102, 149333], [106, 149493], [109, 149613], [114, 149753], [119, 149973], [122, 150173], [127, 150393], [131, 150653], [136, 150853], [140, 151013], [146, 151353], [151, 151573]]}, {"verse": 24, "start": 152241, "end": 158750, "text": "He that loves me not keeps not my sayings: and the word which you hear is not mine, but the Father’s which sent me.", "words": [[0, 152241], [3, 152356], [8, 152536], [14, 152776], [17, 152996], [21, 153236], [27, 154056], [31, 154236], [34, 154416], [43, 155337], [47, 155454], [51, 155554], [56, 155754], [62, 155934], [66, 156114], [71, 156354], [74, 156494], [78, 156674], [84, 157254], [88, 157494], [92, 157614], [101, 157934], [107, 158194], [112, 158434]]}, {"verse": 25, "start": 159100, "end": 162666, "text": "These things have I spoken to you, being yet present with you.", "words": [[0, 159100], [6, 159256], [13, 159596], [18, 159816], [20, 159956], [27, 160276], [30, 160576], [35, 161116], [41, 161356], [45, 161636], [53, 162016], [58, 162296]]}, {"verse": 26, "start": 163016, "end": 172661, "text": "But the Comforter, which is the Holy Spirit, whom the Father will send in my name, he shall teach you all things, and bring all things to your remembrance, whatever I have said to you.", "words": [[0, 163016], [4, 163123], [8, 163243], [19, 163703], [25, 163883], [28, 164003], [32, 164123], [37, 164403], [45, 165183], [50, 165403], [54, 165543], [61, 165803], [66, 166003], [71, 166263], [74, 166403], [77, 166563], [83, 167323], [86, 167403], [92, 167583], [98, 167843], [102, 168023], [106, 168283], [114, 169003], [118, 169183], [124, 169323], [128, 169623], [135, 169963], [138, 170183], [143, 170343], [156, 171375], [165, 171620], [167, 171860], [172, 171960], [177, 172160], [180, 172340]]}, {"verse": 27, "start": 173011, "end": 181216, "text": "Peace I leave with you, my peace I give to you: not as the world gives, give I to you. Let not your heart be troubled, neither let it be afraid.", "words": [[0, 173011], [6, 173212], [8, 173432], [14, 173632], [19, 173872], [24, 174272], [27, 174412], [33, 174712], [35, 174932], [40, 175112], [43, 175292], [48, 175872], [52, 176011], [55, 176171], [59, 176291], [65, 176511], [72, 177031], [77, 177271], [79, 177431], [82, 177631], [87, 178284], [91, 178446], [95, 178646], [100, 178826], [106, 179046], [109, 179206], [119, 179966], [127, 180126], [131, 180386], [134, 180486], [137, 180626]]}, {"verse": 28, "start": 181566, "end": 191441, "text": "You have heard how I said to you, I go away, and come again to you. If you loved me, you would rejoice, because I said, I go to the Father: for my Father is greater than I.", "words": [[0, 181566], [4, 181673], [9, 181793], [15, 181993], [19, 182133], [21, 182273], [26, 182493], [29, 182653], [34, 183133], [36, 183273], [39, 183473], [45, 183793], [49, 184113], [54, 184333], [60, 184553], [63, 184793], [68, 185261], [71, 185393], [75, 185513], [81, 185793], [85, 186353], [89, 186473], [95, 186593], [104, 186973], [112, 187513], [114, 187753], [120, 188373], [122, 188573], [125, 188753], [128, 188853], [132, 188973], [140, 189745], [144, 189851], [147, 189991], [154, 190311], [157, 190551], [165, 190811], [170, 191091]]}, {"verse": 29, "start": 191791, "end": 197395, "text": "And now I have told you before it come to pass, that, when it is come to pass, you might believe.", "words": [[0, 191791], [4, 191935], [8, 192215], [10, 192455], [15, 192575], [20, 192855], [24, 193095], [31, 193395], [34, 193575], [39, 193755], [42, 193875], [48, 194575], [54, 194935], [59, 195435], [62, 195565], [65, 195695], [70, 195895], [73, 196015], [79, 196575], [83, 196675], [89, 196855]]}, {"verse": 30, "start": 197745, "end": 203480, "text": "Hereafter I will not talk much with you: for the prince of this world comes, and has nothing in me.", "words": [[0, 197745], [10, 198630], [12, 198730], [17, 198870], [21, 199050], [26, 199330], [31, 199550], [36, 199790], [41, 200370], [45, 200479], [49, 200579], [56, 200879], [59, 201079], [64, 201279], [70, 201559], [77, 201999], [81, 202439], [85, 202639], [93, 202959], [96, 203179]]}, {"verse": 31, "start": 203830, "end": 211484, "text": "But that the world may know that I love the Father; and as the Father gave me commandment, even so I do. Arise, let us go from here.", "words": [[0, 203830], [4, 203912], [9, 204032], [13, 204172], [19, 204432], [23, 204632], [28, 204892], [33, 205112], [35, 205232], [40, 205512], [44, 205732], [52, 206470], [56, 206571], [59, 206691], [63, 206831], [70, 207091], [75, 207351], [78, 207551], [91, 208311], [96, 208491], [99, 208771], [101, 208951], [105, 209571], [112, 210166], [116, 210366], [119, 210526], [122, 210766], [127, 211006]]}]}