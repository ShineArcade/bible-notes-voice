{"book": "MAT", "chapter": 2, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 215223, "verses": [{"verse": 1, "start": 300, "end": 8753, "text": "Y como nació Jesús en Belén de Judea en días del rey Herodes, he aquí unos magos vinieron del oriente a Jerusalén,", "words": [[0, 300], [2, 402], [7, 642], [13, 1042], [19, 1502], [22, 1882], [28, 2282], [31, 2382], [37, 3022], [40, 3302], [45, 3662], [49, 4062], [53, 4502], [62, 4900], [65, 5297], [70, 5757], [75, 6017], [81, 6517], [90, 6997], [94, 7237], [102, 7717], [104, 7877]]}, {"verse": 2, "start": 9103, "end": 17052, "text": "Diciendo: ¿Dónde está el Rey de los judíos, que ha nacido? porque su estrella hemos visto en el oriente, y venimos a adorarle.", "words": [[0, 9103], [10, 10257], [17, 10593], [22, 10853], [25, 11053], [29, 11313], [32, 11353], [36, 11493], [44, 11993], [48, 12133], [51, 12273], [59, 13014], [66, 13215], [69, 13375], [78, 13835], [84, 14015], [90, 14335], [93, 14515], [96, 14595], [105, 15055], [107, 15555], [115, 15975], [117, 16135]]}, {"verse": 3, "start": 17332, "end": 22433, "text": "Y oyendo esto el rey Herodes, se turbó, y toda Jerusalén con él.", "words": [[0, 17332], [2, 17473], [9, 17853], [14, 18133], [17, 18313], [21, 18653], [30, 19193], [33, 19833], [40, 20693], [42, 20933], [47, 21173], [57, 21953], [61, 22153]]}, {"verse": 4, "start": 22783, "end": 30528, "text": "Y convocados todos los príncipes de los sacerdotes, y los escribas del pueblo, les preguntó dónde había de nacer el Cristo.", "words": [[0, 22783], [2, 22869], [13, 23489], [19, 23769], [23, 24029], [33, 24749], [36, 24869], [40, 24989], [52, 25749], [54, 25909], [58, 26229], [67, 26549], [71, 26689], [79, 27589], [83, 27689], [92, 28289], [98, 28569], [104, 28969], [107, 29149], [113, 29569], [116, 29809]]}, {"verse": 5, "start": 30878, "end": 35941, "text": "Y ellos le dijeron: En Belén de Judea; porque así está escrito por el profeta:", "words": [[0, 30878], [2, 31062], [8, 31282], [11, 31522], [20, 32415], [23, 32578], [29, 32918], [32, 32978], [39, 33779], [46, 33988], [50, 34208], [55, 34488], [63, 34868], [67, 35168], [70, 35268]]}, {"verse": 6, "start": 36291, "end": 45167, "text": "Y tú, Belén, de tierra de Judá, no eres muy pequeña entre los príncipes de Judá; porque de ti saldrá un gobernante, que apacentará a mi pueblo Israel.", "words": [[0, 36291], [2, 36416], [6, 36976], [13, 37476], [16, 37736], [23, 38036], [26, 38196], [32, 38876], [35, 38976], [40, 39156], [44, 39316], [52, 39696], [58, 40016], [62, 40176], [72, 40736], [75, 40856], [81, 41539], [88, 41719], [91, 41879], [94, 42039], [101, 42479], [104, 42499], [116, 43179], [120, 43499], [131, 44119], [133, 44219], [136, 44299], [143, 44539]]}, {"verse": 7, "start": 45447, "end": 54188, "text": "Entonces Herodes, llamando en secreto a los magos, averiguó de ellos cuidadosamente cuándo había aparecido la estrella;", "words": [[0, 45447], [9, 46110], [18, 47230], [27, 47670], [30, 47770], [38, 48310], [40, 48390], [44, 48510], [51, 49510], [60, 50330], [63, 50430], [69, 50690], [84, 51570], [91, 52070], [97, 52630], [107, 53310], [110, 53470]]}, {"verse": 8, "start": 54538, "end": 65221, "text": "Y enviándolos a Belén, dijo: Andad allá, y preguntad con diligencia por el niño; y después que le halléis, hacédmelo saber, para que yo también vaya y le adore.", "words": [[0, 54538], [2, 54705], [14, 55545], [16, 55665], [23, 56465], [29, 57595], [35, 57815], [41, 58035], [43, 58195], [53, 58735], [57, 58875], [68, 59535], [72, 59755], [75, 59895], [81, 60558], [83, 60680], [91, 60960], [95, 61200], [98, 61320], [107, 61800], [117, 62640], [124, 63000], [129, 63520], [133, 63680], [136, 63820], [144, 64080], [149, 64480], [151, 64680], [154, 64760]]}, {"verse": 9, "start": 65501, "end": 76666, "text": "Y ellos, habiendo oído al rey, se fueron: y he aquí la estrella que habían visto en el oriente, iba delante de ellos, hasta que llegando, se puso sobre donde estaba el niño.", "words": [[0, 65501], [2, 65642], [9, 65902], [18, 66382], [23, 66682], [26, 66862], [31, 67202], [34, 67302], [42, 68134], [44, 68309], [47, 68519], [52, 68819], [55, 69019], [64, 69579], [68, 69739], [75, 70039], [81, 70359], [84, 70559], [87, 70679], [96, 71599], [100, 72119], [108, 72559], [111, 72759], [118, 73059], [124, 73639], [128, 73799], [138, 74339], [141, 74699], [146, 75099], [152, 75359], [158, 75619], [165, 75939], [168, 76139]]}, {"verse": 10, "start": 77016, "end": 81303, "text": "Y vista la estrella, se regocijaron con muy grande gozo.", "words": [[0, 77016], [2, 77140], [8, 77440], [11, 77660], [21, 78640], [24, 79250], [36, 79860], [40, 80040], [44, 80360], [51, 80620]]}, {"verse": 11, "start": 81653, "end": 93865, "text": "Y entrando en la casa, vieron al niño con su madre María, y postrándose, le adoraron; y abriendo sus tesoros, le ofrecieron dones, oro e incienso y mirra.", "words": [[0, 81653], [2, 81778], [11, 82258], [14, 82398], [17, 82518], [23, 83198], [30, 83678], [33, 83878], [38, 84218], [42, 84518], [45, 84678], [51, 84958], [58, 85438], [60, 85743], [73, 86583], [76, 87043], [86, 88143], [88, 88264], [97, 88704], [101, 88924], [110, 89964], [113, 90344], [124, 90984], [131, 91784], [135, 92064], [137, 92304], [146, 93104], [148, 93518]]}, {"verse": 12, "start": 94215, "end": 101307, "text": "Y siendo avisados por revelación en sueños que no volviesen a Herodes, se volvieron a su tierra por otro camino.", "words": [[0, 94215], [2, 94363], [9, 94683], [18, 95403], [22, 95663], [33, 96323], [36, 96543], [43, 97043], [47, 97223], [50, 97423], [60, 97963], [62, 98163], [71, 98883], [74, 99043], [84, 99503], [86, 99663], [89, 99783], [96, 100143], [100, 100443], [105, 100643]]}, {"verse": 13, "start": 101657, "end": 118315, "text": "Y después que ellos partieron, he aquí el ángel del Señor aparece en sueños a José, diciendo: Levántate, y toma al niño y a su madre, y huye a Egipto, y permanece allá hasta que yo te lo diga; porque ha de acontecer, que Herodes buscará al niño para matarlo.", "words": [[0, 101657], [2, 101775], [10, 102035], [14, 102255], [20, 102495], [31, 103735], [34, 103975], [39, 104215], [42, 104415], [48, 104875], [52, 105015], [58, 105335], [66, 105835], [69, 106175], [76, 106615], [78, 106775], [84, 107095], [94, 108407], [105, 109028], [107, 109288], [112, 109488], [115, 109648], [120, 109888], [122, 110068], [124, 110108], [127, 110228], [134, 111068], [136, 111148], [141, 111408], [143, 111488], [151, 112028], [153, 112328], [163, 112948], [168, 113208], [174, 113548], [178, 113728], [181, 113868], [184, 113988], [187, 114108], [193, 114771], [200, 114954], [203, 115174], [206, 115254], [217, 115794], [221, 116194], [229, 116494], [237, 117094], [240, 117214], [245, 117454], [250, 117714]]}, {"verse": 14, "start": 118595, "end": 124328, "text": "Y él despertando, tomó al niño y a su madre de noche, y se fue a Egipto;", "words": [[0, 118595], [2, 118779], [5, 118959], [18, 119819], [23, 120259], [26, 120399], [31, 120819], [33, 121499], [35, 121579], [38, 121739], [44, 122099], [47, 122319], [54, 122719], [56, 123064], [59, 123204], [63, 123444], [65, 123564]]}, {"verse": 15, "start": 124678, "end": 134777, "text": "Y estuvo allá hasta la muerte de Herodes: para que se cumpliese lo que fue dicho por el Señor, por el profeta que dijo: De Egipto llamé a mi Hijo.", "words": [[0, 124678], [2, 124776], [9, 125116], [14, 125476], [20, 125796], [23, 125976], [30, 126276], [33, 126636], [42, 127649], [47, 127812], [51, 127952], [54, 128342], [64, 128732], [67, 128912], [71, 129032], [75, 129212], [81, 129532], [85, 129852], [88, 129992], [95, 131172], [99, 131372], [102, 131492], [110, 132032], [114, 132172], [120, 132970], [123, 133060], [130, 133540], [136, 134020], [138, 134140], [141, 134260]]}, {"verse": 16, "start": 135127, "end": 153607, "text": "Herodes entonces, como se vio burlado de los magos, se enojó mucho, y envió, y mató a todos los niños que había en Belén y en todos sus alrededores, de edad de dos años abajo, conforme al tiempo que había entendido de los magos.", "words": [[0, 135127], [8, 135553], [18, 136713], [23, 136853], [26, 137073], [30, 137313], [38, 137913], [41, 138093], [45, 138233], [52, 139253], [55, 139433], [61, 139953], [68, 140393], [70, 140758], [77, 141318], [79, 141898], [84, 142298], [86, 142498], [92, 142778], [96, 143118], [102, 143658], [106, 144038], [112, 144378], [115, 144698], [121, 145218], [123, 145678], [126, 145838], [132, 146178], [136, 146598], [149, 148238], [152, 148446], [157, 148926], [160, 149046], [164, 149246], [169, 149606], [176, 150106], [185, 150846], [188, 150966], [195, 151306], [199, 151606], [205, 151846], [215, 152646], [218, 152766], [222, 152906]]}, {"verse": 17, "start": 153957, "end": 158821, "text": "Entonces fue cumplido lo que se había dicho por el profeta Jeremías, que dijo:", "words": [[0, 153957], [9, 154389], [13, 154829], [22, 155509], [25, 155649], [29, 155789], [32, 155949], [38, 156169], [44, 156509], [48, 156789], [51, 156929], [59, 157429], [69, 158069], [73, 158309]]}, {"verse": 18, "start": 159171, "end": 169832, "text": "Voz fue oída en Ramá, grande lamentación, lloro y gemido: Raquel que llora sus hijos; y no quiso ser consolada, porque perecieron.", "words": [[0, 159171], [4, 159479], [8, 159839], [13, 160359], [16, 160559], [22, 161319], [29, 161719], [42, 163219], [48, 163519], [50, 163659], [58, 164839], [65, 165129], [69, 165209], [75, 165609], [79, 165709], [86, 166658], [88, 166767], [91, 166887], [97, 167227], [101, 167467], [112, 168247], [119, 168867]]}, {"verse": 19, "start": 170182, "end": 177109, "text": "Pero muerto Herodes, he aquí el ángel del Señor aparece en sueños a José en Egipto,", "words": [[0, 170182], [5, 170367], [12, 170947], [21, 171737], [24, 172527], [29, 172847], [32, 173247], [38, 173727], [42, 173847], [48, 174267], [56, 174847], [59, 175187], [66, 175647], [68, 175807], [73, 176087], [76, 176387]]}, {"verse": 20, "start": 177309, "end": 185190, "text": "Diciendo: Levántate, y toma al niño y a su madre, y vete a tierra de Israel; que muertos son los que procuraban la muerte del niño.", "words": [[0, 177309], [10, 178356], [21, 179019], [23, 179299], [28, 179599], [31, 179779], [36, 180019], [38, 180179], [40, 180239], [43, 180359], [50, 180679], [52, 180914], [57, 181194], [59, 181294], [66, 181554], [69, 181734], [77, 182557], [81, 182641], [89, 183021], [93, 183241], [97, 183381], [101, 183521], [112, 184081], [115, 184221], [122, 184501], [126, 184721]]}, {"verse": 21, "start": 185470, "end": 192041, "text": "Entonces él se levantó, y tomó al niño y a su madre, y se vino a tierra de Israel.", "words": [[0, 185470], [9, 185936], [12, 186616], [15, 186816], [24, 187516], [26, 188016], [31, 188376], [34, 188516], [39, 188876], [41, 189116], [43, 189196], [46, 189316], [53, 189696], [55, 190156], [58, 190276], [63, 190496], [65, 190676], [72, 190936], [75, 191276]]}, {"verse": 22, "start": 192391, "end": 204372, "text": "Y oyendo que Archelao reinaba en Judea en lugar de Herodes su padre, temió ir allá: pero advertido por revelación en sueños, se fue a las partes de Galilea.", "words": [[0, 192391], [2, 192540], [9, 192940], [13, 193550], [22, 194160], [30, 194680], [33, 194820], [39, 195380], [42, 195580], [48, 195840], [51, 196160], [59, 196680], [62, 197000], [69, 197880], [75, 198300], [78, 198600], [84, 199321], [89, 199541], [99, 200361], [103, 200641], [114, 201481], [117, 201661], [125, 202621], [128, 202721], [132, 202901], [134, 203001], [138, 203101], [145, 203441], [148, 203621]]}, {"verse": 23, "start": 204722, "end": 214823, "text": "Y vino, y habitó en la ciudad que se llama Nazaret: para que se cumpliese lo que fue dicho por los profetas, que había de ser llamado nazareno.", "words": [[0, 204722], [2, 204926], [8, 205286], [10, 205551], [17, 205951], [20, 206051], [23, 206171], [30, 206551], [34, 206931], [37, 207091], [43, 207411], [52, 208627], [57, 208946], [61, 209086], [64, 209506], [74, 209926], [77, 210066], [81, 210186], [85, 210386], [91, 210726], [95, 211026], [99, 211206], [109, 212466], [113, 212706], [119, 212906], [122, 213086], [126, 213326], [134, 213686]]}]}