{"book": "PSA", "chapter": 44, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 179342, "verses": [{"verse": 1, "start": 300, "end": 14748, "text": "Al Músico principal: de los hijos de Coré: Masquil. OH Dios, con nuestros oídos hemos oído, nuestros padres nos han contado, la obra que hiciste en sus días, en los tiempos antiguos.", "words": [[0, 300], [3, 470], [10, 950], [21, 2084], [24, 2210], [28, 2350], [34, 2610], [37, 2955], [43, 3557], [52, 4780], [55, 4949], [61, 5549], [65, 5669], [74, 6029], [80, 6829], [86, 7089], [92, 8249], [101, 8589], [108, 8909], [112, 9389], [116, 9609], [125, 10229], [128, 10629], [133, 11009], [137, 11289], [145, 11929], [148, 12089], [152, 12269], [158, 13189], [161, 13349], [165, 13469], [173, 13969]]}, {"verse": 2, "start": 15198, "end": 22264, "text": "Tú con tu mano echaste las naciones, y los plantaste a ellos; afligiste los pueblos, y los arrojaste.", "words": [[0, 15198], [3, 15384], [7, 15684], [10, 15824], [15, 16044], [23, 16464], [27, 16664], [37, 17344], [39, 18064], [43, 18204], [53, 18764], [55, 18884], [62, 19789], [72, 20331], [76, 20491], [85, 21051], [87, 21201], [91, 21351]]}, {"verse": 3, "start": 22714, "end": 34555, "text": "Porque no se apoderaron de la tierra por su espada, ni su brazo los libró; sino tu diestra, y tu brazo, y la luz de tu rostro, porque te complaciste en ellos.", "words": [[0, 22714], [7, 22895], [10, 23075], [13, 23255], [24, 24015], [27, 24195], [30, 24335], [37, 24695], [41, 24975], [44, 25155], [52, 25675], [55, 26195], [58, 26715], [64, 27235], [68, 27435], [75, 28354], [80, 28579], [83, 28779], [92, 29259], [94, 29379], [97, 29499], [104, 30399], [106, 30779], [109, 30899], [113, 31239], [116, 31559], [119, 31699], [127, 32439], [134, 32899], [137, 33099], [149, 33819], [152, 34019]]}, {"verse": 4, "start": 35005, "end": 38939, "text": "Tú, oh Dios, eres mi rey: manda salvación a Jacob.", "words": [[0, 35005], [4, 35337], [7, 35703], [13, 36070], [18, 36230], [21, 36610], [26, 37239], [32, 37508], [42, 38168], [44, 38428]]}, {"verse": 5, "start": 39389, "end": 47422, "text": "Por medio de ti sacudiremos a nuestros enemigos: en tu nombre atropellaremos a nuestros adversarios.", "words": [[0, 39389], [4, 39535], [10, 39915], [13, 40195], [16, 40955], [28, 42035], [30, 42175], [39, 42375], [49, 43738], [52, 43922], [55, 44142], [62, 44502], [77, 45602], [79, 45862], [88, 46082]]}, {"verse": 6, "start": 47872, "end": 52809, "text": "Porque no confiaré en mi arco, ni mi espada me salvará.", "words": [[0, 47872], [7, 48216], [10, 48836], [19, 49756], [22, 49996], [25, 50236], [31, 51096], [34, 51216], [37, 51356], [44, 51876], [47, 52056]]}, {"verse": 7, "start": 53259, "end": 58770, "text": "Pues tú nos has guardado de nuestros enemigos, y has avergonzado a los que nos aborrecían.", "words": [[0, 53259], [5, 53403], [8, 53543], [12, 53663], [16, 53823], [25, 54363], [28, 54523], [37, 54683], [47, 55503], [49, 56183], [53, 56343], [65, 57263], [67, 57383], [71, 57483], [75, 57603], [79, 57763]]}, {"verse": 8, "start": 59220, "end": 65234, "text": "En Dios nos gloriaremos todo tiempo, y para siempre alabaremos tu nombre. (Selah.)", "words": [[0, 59220], [3, 59579], [8, 59859], [12, 60379], [24, 60979], [29, 61239], [37, 61679], [39, 61899], [44, 62099], [52, 62539], [63, 63579], [66, 63779], [74, 64971]]}, {"verse": 9, "start": 65684, "end": 72688, "text": "Pero nos has desechado, y nos has hecho avergonzar; y no sales en nuestros ejércitos.", "words": [[0, 65684], [5, 65872], [9, 66092], [13, 66372], [24, 67512], [26, 68112], [30, 68252], [34, 68492], [40, 68892], [52, 70396], [54, 70726], [57, 70866], [63, 71126], [66, 71386], [75, 71586]]}, {"verse": 10, "start": 73138, "end": 79128, "text": "Nos hiciste retroceder del enemigo, y nos saquearon para sí los que nos aborrecían.", "words": [[0, 73138], [4, 73303], [12, 74003], [23, 75023], [27, 75223], [36, 75923], [38, 76323], [42, 76483], [52, 77283], [57, 77523], [60, 77783], [64, 77943], [68, 78083], [72, 78243]]}, {"verse": 11, "start": 79578, "end": 85371, "text": "Nos pusiste como a ovejas para comida, y nos esparciste entre las naciones.", "words": [[0, 79578], [4, 79704], [12, 80304], [17, 80624], [19, 80784], [26, 81324], [31, 81604], [39, 82144], [41, 82614], [45, 83084], [56, 84024], [62, 84344], [66, 84564]]}, {"verse": 12, "start": 85821, "end": 90271, "text": "Has vendido tu pueblo de balde, y no exigiste ningún precio.", "words": [[0, 85821], [4, 86047], [12, 86707], [15, 86847], [22, 87207], [25, 87567], [32, 87927], [34, 88387], [37, 88547], [46, 89247], [53, 89507]]}, {"verse": 13, "start": 90721, "end": 96410, "text": "Nos pusiste por vergüenza a nuestros vecinos, por burla y por burla a los que nos rodean.", "words": [[0, 90721], [4, 90867], [12, 91407], [16, 91687], [26, 92307], [28, 92447], [37, 92607], [46, 93487], [50, 93767], [56, 94207], [58, 94387], [62, 94587], [68, 95047], [70, 95187], [74, 95307], [78, 95447], [82, 95607]]}, {"verse": 14, "start": 96860, "end": 103647, "text": "Nos pusiste en objeto de burla entre las naciones; todos al vernos menean la cabeza.", "words": [[0, 96860], [4, 97005], [12, 97605], [15, 97825], [22, 98205], [25, 98485], [31, 98925], [37, 99185], [41, 99405], [51, 100493], [57, 100951], [60, 101251], [67, 101651], [74, 102191], [77, 102311]]}, {"verse": 15, "start": 104097, "end": 109832, "text": "Cada día mi vergüenza está delante de mí, y me cubre la confusión de mi rostro,", "words": [[0, 104097], [5, 104259], [9, 104699], [12, 104779], [22, 105399], [27, 105679], [35, 106159], [38, 106339], [42, 106559], [44, 107299], [47, 107439], [53, 107899], [56, 108039], [66, 108759], [69, 108939], [72, 109079]]}, {"verse": 16, "start": 110282, "end": 116281, "text": "Por la voz del que me vitupera y deshonra, por razón del enemigo y del que se venga.", "words": [[0, 110282], [4, 110425], [7, 110585], [11, 110985], [15, 111325], [19, 111505], [22, 111665], [31, 112325], [33, 112425], [43, 113585], [47, 113945], [53, 114325], [57, 114585], [65, 115145], [67, 115245], [71, 115405], [75, 115565], [78, 115725]]}, {"verse": 17, "start": 116731, "end": 123048, "text": "Todo esto nos ha venido, y no nos hemos olvidado de ti; y no hemos faltado a tu pacto.", "words": [[0, 116731], [5, 116873], [10, 117233], [14, 117453], [17, 117673], [25, 118233], [27, 118713], [30, 118873], [34, 119073], [40, 119273], [49, 119973], [52, 120133], [56, 120803], [58, 120950], [61, 121150], [67, 121510], [75, 122230], [77, 122330], [80, 122430]]}, {"verse": 18, "start": 123498, "end": 129266, "text": "No se ha vuelto atrás nuestro corazón, ni tampoco se han apartado nuestros pasos de tus caminos.", "words": [[0, 123498], [3, 123684], [6, 123884], [9, 123964], [16, 124304], [22, 124504], [30, 124784], [39, 125464], [42, 126144], [50, 126404], [53, 126764], [57, 126864], [66, 127444], [75, 127644], [81, 128224], [84, 128344], [88, 128464]]}, {"verse": 19, "start": 129716, "end": 136158, "text": "Cuando nos quebrantaste en el lugar de los dragones, y nos cubriste con sombra de muerte,", "words": [[0, 129716], [7, 130095], [11, 130395], [24, 131495], [27, 132015], [30, 132154], [36, 132495], [39, 132715], [43, 132855], [53, 133555], [55, 133915], [59, 134055], [68, 134654], [72, 134855], [79, 135335], [82, 135474]]}, {"verse": 20, "start": 136608, "end": 142356, "text": "Si nos hubiésemos olvidado del nombre de nuestro Dios, o alzado nuestras manos a dios ajeno,", "words": [[0, 136608], [3, 136771], [7, 136911], [18, 137531], [27, 138131], [31, 138351], [38, 138711], [41, 138891], [49, 139071], [55, 139551], [57, 139991], [64, 140571], [73, 140771], [79, 141311], [81, 141551], [86, 141711]]}, {"verse": 21, "start": 142806, "end": 147754, "text": "¿No pediría cuentas Dios de esto? porque él conoce los secretos del corazón.", "words": [[0, 142806], [4, 142911], [12, 143421], [20, 143931], [25, 144051], [28, 144291], [34, 145026], [41, 145524], [44, 145704], [51, 146124], [55, 146264], [64, 146844], [68, 146984]]}, {"verse": 22, "start": 148204, "end": 154168, "text": "Pero por tu causa nos matan cada día; somos tenidos como ovejas para el matadero.", "words": [[0, 148204], [5, 148370], [9, 148630], [12, 148830], [18, 149180], [22, 149530], [28, 150030], [33, 150230], [38, 151107], [44, 151304], [52, 151824], [57, 152084], [64, 152864], [69, 153164], [72, 153304]]}, {"verse": 23, "start": 154618, "end": 159709, "text": "Despierta; ¿por qué duermes, Señor? Despierta, no te alejes para siempre.", "words": [[0, 154618], [11, 155789], [16, 156048], [20, 156318], [29, 156588], [36, 157682], [47, 157917], [50, 158152], [53, 158387], [60, 158707], [65, 158947]]}, {"verse": 24, "start": 160159, "end": 167017, "text": "¿Por qué escondes tu rostro, y te olvidas de nuestra aflicción, y de la opresión nuestra?", "words": [[0, 160159], [5, 160301], [9, 160581], [18, 161361], [21, 161481], [29, 162601], [31, 162821], [34, 162961], [42, 163481], [45, 163601], [53, 163781], [64, 164681], [66, 165361], [69, 165461], [72, 165601], [81, 166201]]}, {"verse": 25, "start": 167467, "end": 173559, "text": "Porque nuestra alma está agobiada hasta el polvo: nuestro vientre está pegado con la tierra.", "words": [[0, 167467], [7, 167671], [15, 167971], [20, 168371], [25, 168671], [34, 169411], [40, 169731], [43, 170230], [50, 170970], [58, 171199], [66, 171819], [71, 172159], [78, 172619], [82, 172779], [85, 172939]]}, {"verse": 26, "start": 174009, "end": 178942, "text": "Levántate para ayudarnos, y redímenos por tu misericordia.", "words": [[0, 174009], [10, 174713], [15, 175033], [26, 176053], [28, 176713], [38, 177433], [42, 177633], [45, 177833]]}]}