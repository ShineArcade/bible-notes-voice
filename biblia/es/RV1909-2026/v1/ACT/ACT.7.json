{"book": "ACT", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 455036, "verses": [{"verse": 1, "start": 300, "end": 4501, "text": "EL sumo sacerdote dijo entonces: ¿Es esto así?", "words": [[0, 300], [3, 446], [8, 946], [18, 2026], [23, 2386], [33, 3637], [37, 3820], [42, 4060]]}, {"verse": 2, "start": 4781, "end": 14832, "text": "Y él dijo: Varones hermanos y padres, oíd: El Dios de la gloria apareció a nuestro padre Abraham, estando en Mesopotamia, antes que morase en Harán,", "words": [[0, 4781], [2, 4969], [5, 5129], [11, 5848], [19, 6412], [28, 6852], [30, 6952], [38, 7692], [43, 8288], [46, 8413], [51, 8633], [54, 8813], [57, 8933], [64, 9353], [73, 9913], [75, 10013], [83, 10133], [89, 10693], [98, 11653], [106, 12093], [109, 12213], [122, 13373], [128, 13593], [132, 13813], [139, 14213], [142, 14523]]}, {"verse": 3, "start": 15182, "end": 20031, "text": "Y le dijo: Sal de tu tierra y de tus parientes, y ven a la tierra que te mostraré.", "words": [[0, 15182], [2, 15341], [5, 15401], [11, 16076], [15, 16310], [18, 16490], [21, 16630], [28, 16970], [30, 17110], [33, 17210], [37, 17330], [48, 17930], [50, 18370], [54, 18510], [56, 18670], [59, 18730], [66, 19010], [70, 19270], [73, 19370]]}, {"verse": 4, "start": 20381, "end": 29642, "text": "Entonces salió de la tierra de los caldeos, y habitó en Harán: y de allí, muerto su padre, lo trasladó a esta tierra, en la cual vosotros habitáis ahora;", "words": [[0, 20381], [9, 20726], [15, 21266], [18, 21366], [21, 21466], [28, 21706], [31, 21906], [35, 22006], [44, 22646], [46, 22886], [53, 23266], [56, 23806], [63, 24510], [65, 24635], [68, 24735], [74, 24895], [81, 25315], [84, 25475], [91, 25815], [94, 26275], [103, 26815], [105, 26915], [110, 27095], [118, 27515], [121, 27975], [124, 28055], [129, 28215], [138, 28675], [147, 29215]]}, {"verse": 5, "start": 29992, "end": 38649, "text": "Y no le dio herencia en ella, ni aun para asentar un pie: pero le prometió que se la daría en posesión, y a su descendencia después de él, no teniendo hijo.", "words": [[0, 29992], [2, 30098], [5, 30218], [8, 30338], [12, 30518], [21, 30898], [24, 31078], [30, 31338], [33, 31718], [37, 31978], [42, 32368], [50, 32758], [53, 32858], [58, 33421], [63, 33563], [66, 33723], [75, 34183], [79, 34303], [82, 34423], [85, 34543], [91, 34843], [94, 34923], [104, 35543], [106, 35843], [108, 35943], [111, 36063], [124, 36783], [132, 37003], [135, 37323], [139, 37523], [142, 37803], [151, 38243]]}, {"verse": 6, "start": 38999, "end": 48223, "text": "Y le dijo Dios así: Que su descendencia sería extranjera en tierra ajena, y que los someterían a esclavitud y maltratarían, por cuatrocientos años.", "words": [[0, 38999], [2, 39143], [5, 39223], [10, 39483], [15, 39723], [20, 40432], [24, 40516], [27, 40676], [40, 41476], [46, 41716], [57, 42596], [60, 42736], [67, 42996], [74, 43576], [76, 44036], [80, 44146], [84, 44256], [95, 44936], [97, 44996], [108, 45576], [110, 45736], [124, 46476], [128, 46896], [142, 47316]]}, {"verse": 7, "start": 48573, "end": 55808, "text": "Pero yo juzgaré, dijo Dios, la nación a la cual serán siervos: y después de esto saldrán y me servirán en este lugar.", "words": [[0, 48573], [5, 48697], [8, 48897], [17, 49457], [22, 49657], [28, 50437], [31, 50517], [38, 50937], [40, 51237], [43, 51277], [48, 51517], [54, 51937], [63, 52881], [65, 52988], [73, 53308], [76, 53528], [81, 53748], [89, 54328], [91, 54388], [94, 54488], [103, 54988], [106, 55108], [111, 55308]]}, {"verse": 8, "start": 56158, "end": 66161, "text": "Y le dio el pacto de la circuncisión: y así Abraham engendró a Isaac, y le circuncidó al octavo día; e Isaac a Jacob, y Jacob a los doce patriarcas.", "words": [[0, 56158], [2, 56284], [5, 56404], [9, 56604], [12, 56784], [18, 57164], [21, 57244], [24, 57344], [38, 58528], [40, 58670], [44, 58930], [52, 59450], [61, 60070], [63, 60190], [70, 60490], [72, 61010], [75, 61130], [86, 61970], [89, 62110], [96, 62410], [101, 63048], [103, 63221], [109, 63427], [111, 63634], [118, 64094], [120, 64239], [126, 64579], [128, 64799], [132, 64969], [137, 65139]]}, {"verse": 9, "start": 66511, "end": 71757, "text": "Y los patriarcas, movidos de envidia, vendieron a José para Egipto; pero Dios era con él,", "words": [[0, 66511], [2, 66581], [6, 66921], [18, 67261], [26, 67721], [29, 67921], [38, 68421], [48, 68901], [50, 69061], [55, 69301], [60, 69601], [68, 70441], [73, 70658], [78, 70898], [82, 71178], [86, 71398]]}, {"verse": 10, "start": 72107, "end": 83130, "text": "Y le libró de todas sus tribulaciones, y le dio gracia y sabiduría en la presencia de Faraón, rey de Egipto, el cual le puso por gobernador sobre Egipto, y sobre toda su casa.", "words": [[0, 72107], [2, 72235], [5, 72335], [11, 72735], [14, 72835], [20, 73015], [24, 73315], [39, 74115], [41, 74615], [44, 74695], [48, 74855], [55, 75335], [57, 75415], [67, 76115], [70, 76375], [73, 76455], [83, 77015], [86, 77175], [94, 77995], [98, 78255], [101, 78335], [109, 79195], [112, 79275], [117, 79455], [120, 79655], [125, 79975], [129, 80155], [140, 80735], [146, 80995], [154, 81877], [156, 81974], [162, 82254], [167, 82534], [170, 82614]]}, {"verse": 11, "start": 83480, "end": 91076, "text": "Vino entonces hambre en toda la tierra de Egipto y de Canaán, y grande tribulación; y nuestros padres no hallaban alimentos.", "words": [[0, 83480], [5, 83701], [14, 84161], [21, 84741], [24, 84901], [29, 85061], [32, 85261], [39, 85541], [42, 85721], [49, 86201], [51, 86281], [54, 86571], [62, 86861], [64, 87321], [71, 87601], [84, 88766], [86, 88869], [95, 89109], [102, 89609], [105, 89889], [114, 90269]]}, {"verse": 12, "start": 91426, "end": 96379, "text": "Y como oyese Jacob que había trigo en Egipto, envió a nuestros padres la primera vez.", "words": [[0, 91426], [2, 91513], [7, 91733], [13, 91953], [19, 92373], [23, 92653], [29, 92813], [35, 93233], [38, 93373], [46, 93993], [52, 94593], [54, 94673], [63, 94853], [70, 95373], [73, 95593], [81, 95853]]}, {"verse": 13, "start": 96729, "end": 102906, "text": "Y en la segunda, José fue conocido de sus hermanos, y fue sabido de Faraón el linaje de José.", "words": [[0, 96729], [2, 96849], [5, 96949], [8, 97029], [17, 97869], [22, 98189], [26, 98489], [35, 99069], [38, 99209], [42, 99349], [52, 100049], [54, 100409], [58, 100569], [65, 100949], [68, 101109], [75, 101629], [78, 101909], [85, 102329], [88, 102429]]}, {"verse": 14, "start": 103256, "end": 109231, "text": "Y enviando José, hizo venir a su padre Jacob, y a todos sus parientes, en número de setenta y cinco personas.", "words": [[0, 103256], [2, 103364], [11, 103824], [17, 104144], [22, 104464], [28, 104664], [30, 104844], [33, 104964], [39, 105224], [46, 105604], [48, 105849], [50, 105949], [56, 106129], [60, 106369], [71, 106889], [74, 107249], [81, 107489], [84, 107644], [92, 107799], [94, 107954], [100, 108109]]}, {"verse": 15, "start": 109581, "end": 114166, "text": "Así descendió Jacob a Egipto, donde murió él y nuestros padres;", "words": [[0, 109581], [4, 109826], [14, 110326], [20, 110626], [22, 110846], [30, 111506], [36, 111626], [42, 112026], [45, 112266], [47, 112486], [56, 112666]]}, {"verse": 16, "start": 114516, "end": 121976, "text": "Los cuales fueron trasladados a Siquem, y puestos en el sepulcro que compró Abraham a precio de dinero de los hijos de Hamor de Siquem.", "words": [[0, 114516], [4, 114655], [11, 114935], [18, 115335], [30, 116035], [32, 116335], [40, 116635], [42, 117115], [50, 117595], [53, 117735], [56, 117855], [65, 118355], [69, 118495], [76, 118895], [84, 119275], [86, 119475], [93, 119715], [96, 119915], [103, 120175], [106, 120395], [110, 120515], [116, 120775], [119, 120995], [125, 121215], [128, 121625]]}, {"verse": 17, "start": 122326, "end": 129260, "text": "Pero como se acercaba el tiempo de la promesa, la cual Dios había jurado a Abraham, el pueblo creció y se multiplicó en Egipto,", "words": [[0, 122326], [5, 122463], [10, 122663], [13, 122803], [22, 123263], [25, 123383], [32, 123663], [35, 123843], [38, 123963], [47, 124463], [50, 124563], [55, 124763], [60, 125043], [66, 125363], [73, 125823], [75, 126213], [84, 126603], [87, 126703], [94, 126983], [101, 127603], [103, 127843], [106, 127943], [117, 128563], [120, 128683]]}, {"verse": 18, "start": 129610, "end": 133145, "text": "Hasta que se levantó otro rey en Egipto que no conocía a José.", "words": [[0, 129610], [6, 129817], [10, 129977], [13, 130097], [21, 130597], [26, 130837], [30, 131157], [33, 131237], [40, 131697], [44, 131837], [47, 132017], [55, 132557], [57, 132717]]}, {"verse": 19, "start": 133495, "end": 143321, "text": "Este, usando de astucia con nuestro linaje, maltrató a nuestros padres, a fin de que pusiesen a peligro de muerte sus niños, para que cesase la generación.", "words": [[0, 133495], [6, 133995], [13, 134355], [16, 134575], [24, 135115], [28, 135335], [36, 135535], [44, 136655], [53, 137195], [55, 137275], [64, 137475], [72, 138015], [74, 138515], [78, 138675], [81, 138815], [85, 138935], [94, 139395], [96, 139555], [104, 139995], [107, 140095], [114, 140355], [118, 140635], [125, 140995], [130, 141655], [134, 141985], [141, 142315], [144, 142475]]}, {"verse": 20, "start": 143671, "end": 150027, "text": "En aquel mismo tiempo nació Moisés, y fue agradable a Dios: y fue criado tres meses en casa de su padre.", "words": [[0, 143671], [3, 143789], [9, 144029], [15, 144209], [22, 144549], [28, 145009], [36, 145449], [38, 145784], [42, 145944], [52, 146484], [54, 146604], [60, 147312], [62, 147512], [66, 147672], [73, 148112], [78, 148332], [84, 148652], [87, 148932], [92, 149172], [95, 149392], [98, 149512]]}, {"verse": 21, "start": 150377, "end": 156391, "text": "Pero cuando estaba en peligro de morir, la hija de Faraón lo recogió y le crio como a hijo suyo.", "words": [[0, 150377], [5, 150515], [12, 150775], [19, 151155], [22, 151335], [30, 151795], [33, 151895], [40, 152755], [43, 152855], [48, 153195], [51, 153495], [58, 153795], [61, 153935], [69, 154575], [71, 154795], [74, 154895], [79, 155255], [84, 155495], [86, 155635], [91, 155795]]}, {"verse": 22, "start": 156741, "end": 163131, "text": "Y fue enseñado Moisés en toda la sabiduría de los egipcios; y era poderoso en sus dichos y hechos.", "words": [[0, 156741], [2, 156840], [6, 157000], [15, 157600], [22, 158060], [25, 158440], [30, 158660], [33, 158880], [43, 159540], [46, 159640], [50, 159780], [60, 160807], [62, 160957], [66, 161077], [75, 161677], [78, 161837], [82, 162017], [89, 162437], [91, 162577]]}, {"verse": 23, "start": 163481, "end": 169763, "text": "Y cuando hubo cumplido la edad de cuarenta años, le vino voluntad de visitar a sus hermanos los hijos de Israel.", "words": [[0, 163481], [2, 163563], [9, 163783], [14, 164143], [23, 164663], [26, 164803], [31, 165083], [34, 165293], [43, 165503], [49, 166383], [52, 166463], [57, 166643], [66, 167263], [69, 167383], [77, 167843], [79, 167883], [83, 168043], [92, 168563], [96, 168703], [102, 168963], [105, 169163]]}, {"verse": 24, "start": 170113, "end": 175832, "text": "Y cuando vio a uno que era maltratado, lo defendió, e hiriendo al egipcio, vengó al oprimido.", "words": [[0, 170113], [2, 170199], [9, 170439], [13, 170739], [15, 170839], [19, 171019], [23, 171219], [27, 171839], [39, 172459], [42, 172579], [52, 173679], [54, 173779], [63, 174179], [66, 174339], [75, 174819], [81, 175176], [84, 175532]]}, {"verse": 25, "start": 176182, "end": 182957, "text": "Pero él pensaba que sus hermanos entendían que Dios les había de dar libertad por su mano; pero ellos no lo habían entendido.", "words": [[0, 176182], [5, 176322], [8, 176482], [16, 176982], [20, 177142], [24, 177302], [33, 177802], [43, 178402], [47, 178562], [52, 178802], [56, 179062], [62, 179342], [65, 179502], [69, 179642], [78, 180182], [82, 180322], [85, 180482], [91, 181067], [96, 181226], [102, 181506], [105, 181806], [108, 181926], [115, 182166]]}, {"verse": 26, "start": 183307, "end": 193066, "text": "Y al día siguiente, riñendo ellos, se les mostró, y los ponía en paz, diciendo: Varones, hermanos sois, ¿por qué os maltratáis los unos a los otros?", "words": [[0, 183307], [2, 183592], [5, 183732], [9, 183892], [20, 184812], [28, 185312], [35, 185952], [38, 186052], [42, 186172], [50, 186752], [52, 187112], [56, 187252], [62, 187692], [65, 187792], [70, 188372], [80, 189506], [89, 189816], [98, 190366], [104, 190916], [109, 190996], [113, 191156], [116, 191276], [127, 191856], [131, 191996], [136, 192256], [138, 192476], [142, 192616]]}, {"verse": 27, "start": 193416, "end": 200679, "text": "Entonces el que maltrataba a su prójimo, lo empujó, diciendo: ¿Quién te ha puesto por príncipe y juez sobre nosotros?", "words": [[0, 193416], [9, 193920], [12, 194240], [16, 194380], [27, 195020], [29, 195120], [32, 195220], [41, 195840], [44, 196280], [52, 196900], [62, 197987], [69, 198205], [72, 198265], [75, 198405], [82, 198585], [86, 198865], [95, 199325], [97, 199465], [102, 199705], [108, 199845]]}, {"verse": 28, "start": 201029, "end": 203619, "text": "¿Quieres tú matarme, como mataste ayer al egipcio?", "words": [[0, 201029], [9, 201349], [12, 201429], [21, 201849], [26, 202049], [34, 202529], [39, 202769], [42, 202929]]}, {"verse": 29, "start": 203969, "end": 209560, "text": "A esta palabra Moisés huyó, y se hizo extranjero en tierra de Madián, donde engendró dos hijos.", "words": [[0, 203969], [2, 204085], [7, 204285], [15, 204585], [22, 205085], [28, 205585], [30, 205800], [33, 205980], [38, 206220], [49, 206880], [52, 207020], [59, 207280], [62, 207730], [70, 208180], [76, 208300], [85, 208840], [89, 209040]]}, {"verse": 30, "start": 209910, "end": 217119, "text": "Y cumplidos cuarenta años, un ángel le apareció en el desierto del monte Sinaí, en fuego de llama de una zarza.", "words": [[0, 209910], [2, 210008], [12, 210548], [21, 211188], [27, 212028], [30, 212148], [36, 212508], [39, 212608], [48, 213128], [51, 213248], [54, 213348], [63, 213828], [67, 214028], [73, 214328], [80, 215248], [83, 215448], [89, 215668], [92, 215908], [98, 216148], [101, 216368], [105, 216768]]}, {"verse": 31, "start": 217469, "end": 224209, "text": "Entonces Moisés mirando, se maravilló de la visión: y acercándose para observar, le llegó la voz del Señor:", "words": [[0, 217469], [9, 217872], [16, 218332], [25, 218792], [28, 219132], [38, 219652], [41, 219712], [44, 219812], [52, 220623], [54, 220742], [66, 221422], [71, 221642], [81, 222502], [84, 222802], [90, 223062], [93, 223262], [97, 223462], [101, 223622]]}, {"verse": 32, "start": 224559, "end": 232827, "text": "Yo soy el Dios de tus padres, el Dios de Abraham, y el Dios de Isaac, y el Dios de Jacob. Pero Moisés, temeroso, no se atrevía a mirar.", "words": [[0, 224559], [3, 224683], [7, 224923], [10, 225123], [15, 225323], [18, 225523], [22, 225663], [30, 226403], [33, 226483], [38, 226683], [41, 226863], [50, 227223], [52, 227763], [55, 227883], [60, 228063], [63, 228223], [70, 228523], [72, 228863], [75, 228983], [80, 229143], [83, 229303], [90, 229995], [95, 230154], [103, 230474], [113, 231154], [116, 231674], [119, 231814], [127, 232274], [129, 232374]]}, {"verse": 33, "start": 233177, "end": 240002, "text": "Y le dijo el Señor: Quita los zapatos de tus pies, porque el lugar en que estás es tierra santa.", "words": [[0, 233177], [2, 233278], [5, 233378], [10, 233598], [13, 233718], [20, 234467], [26, 234784], [30, 234944], [38, 235504], [41, 235664], [45, 235844], [51, 236784], [58, 237044], [61, 237224], [67, 237444], [70, 237664], [74, 237784], [80, 238124], [83, 238584], [90, 239004]]}, {"verse": 34, "start": 240222, "end": 250132, "text": "He visto, he visto la aflicción de mi pueblo que está en Egipto, y he oído el gemido de ellos, y he descendido para librarlos. Ahora pues, ven, te enviaré a Egipto.", "words": [[0, 240222], [3, 240365], [10, 241005], [13, 241165], [19, 241365], [22, 241565], [32, 242105], [35, 242265], [38, 242365], [45, 242645], [49, 242885], [54, 243105], [57, 243265], [65, 243805], [67, 244205], [70, 244325], [75, 244605], [78, 244745], [85, 245145], [88, 245325], [95, 245585], [97, 246085], [100, 246145], [111, 246705], [116, 246905], [127, 247907], [133, 248155], [139, 248375], [144, 248895], [147, 248975], [155, 249475], [157, 249555]]}, {"verse": 35, "start": 250482, "end": 261549, "text": "A este Moisés, al cual habían rechazado, diciendo: ¿Quién te ha puesto por príncipe y juez? a este envió Dios por príncipe y redentor con la mano del ángel que le apareció en la zarza.", "words": [[0, 250482], [2, 250623], [7, 250823], [15, 251243], [18, 251603], [23, 251783], [30, 252423], [41, 253063], [51, 253922], [58, 254142], [61, 254222], [64, 254362], [71, 254542], [75, 254842], [84, 255302], [86, 255462], [92, 256102], [94, 256246], [99, 256486], [105, 256906], [110, 257126], [114, 257426], [123, 258046], [125, 258266], [134, 258826], [138, 259006], [141, 259146], [146, 259346], [150, 259526], [156, 259926], [160, 260066], [163, 260186], [172, 260746], [175, 260866], [178, 260966]]}, {"verse": 36, "start": 261899, "end": 269391, "text": "Este los sacó, habiendo hecho prodigios y milagros en la tierra de Egipto, y en el Mar Rojo, y en el desierto por cuarenta años.", "words": [[0, 262028], [5, 262174], [9, 262321], [15, 262701], [24, 263021], [30, 263281], [40, 263941], [42, 264041], [51, 264501], [54, 264681], [57, 264761], [64, 265061], [67, 265221], [75, 265941], [77, 266201], [80, 266301], [83, 266401], [87, 266581], [93, 267021], [95, 267461], [98, 267561], [101, 267661], [110, 268101], [114, 268431], [123, 268761]]}, {"verse": 37, "start": 269741, "end": 278015, "text": "Este es el Moisés, el cual dijo a los hijos de Israel: Profeta os levantará el Señor Dios vuestro de vuestros hermanos, como yo; a él oiréis.", "words": [[0, 269741], [5, 270042], [8, 270282], [11, 270422], [19, 271162], [22, 271242], [27, 271382], [32, 271682], [34, 271822], [38, 271922], [44, 272142], [47, 272342], [55, 273213], [63, 273359], [66, 273506], [76, 274046], [79, 274166], [85, 274406], [90, 274706], [98, 275246], [101, 275346], [110, 275666], [120, 276266], [125, 276386], [129, 276992], [131, 277150], [134, 277610]]}, {"verse": 38, "start": 278365, "end": 288581, "text": "Este es aquel que estuvo en la congregación en el desierto con el ángel que le hablaba en el monte Sinaí, y con nuestros padres; y recibió las palabras de vida para dárnoslas:", "words": [[0, 278365], [5, 278626], [8, 278906], [14, 279266], [18, 279386], [25, 279766], [28, 279906], [31, 279966], [44, 280706], [47, 280886], [50, 281006], [59, 281566], [63, 281846], [66, 281966], [72, 282366], [76, 282486], [79, 282626], [87, 283066], [90, 283206], [93, 283286], [99, 283566], [106, 284146], [108, 284566], [112, 284746], [121, 284946], [129, 285981], [131, 286070], [139, 286550], [143, 286710], [152, 287070], [155, 287330], [160, 287530], [165, 288080]]}, {"verse": 39, "start": 288931, "end": 295614, "text": "Al cual nuestros padres no quisieron obedecer; sino que lo rechazaron, y se apartaron de corazón a Egipto,", "words": [[0, 288931], [3, 289094], [8, 289334], [17, 289574], [24, 290154], [27, 290434], [37, 290934], [47, 291870], [52, 292107], [56, 292247], [59, 292367], [71, 293087], [73, 293627], [76, 293747], [86, 294327], [89, 294487], [97, 294867], [99, 295087]]}, {"verse": 40, "start": 295964, "end": 305612, "text": "Diciendo a Aarón: Haznos dioses que vayan delante de nosotros; porque a este Moisés, que nos sacó de tierra de Egipto, no sabemos qué le ha acontecido.", "words": [[0, 295964], [9, 296446], [11, 296851], [18, 297416], [25, 297801], [32, 298281], [36, 298521], [42, 298861], [50, 299261], [53, 299381], [63, 300171], [70, 300370], [72, 300510], [77, 300670], [85, 301650], [89, 301730], [93, 301870], [98, 302310], [101, 302450], [108, 302730], [111, 302910], [119, 303830], [122, 303930], [130, 304310], [134, 304610], [137, 304750], [140, 304870]]}, {"verse": 41, "start": 305962, "end": 312464, "text": "Y entonces hicieron un becerro, y ofrecieron sacrificio al ídolo, y en las obras de sus manos se regocijaron.", "words": [[0, 305962], [2, 306063], [11, 306363], [20, 307083], [23, 307243], [32, 307863], [34, 308063], [45, 308603], [56, 309363], [59, 309503], [66, 309843], [68, 310058], [71, 310178], [75, 310298], [81, 310598], [84, 310778], [88, 310918], [94, 311258], [97, 311518]]}, {"verse": 42, "start": 312814, "end": 324818, "text": "Y Dios se apartó, y los entregó que sirviesen al ejército del cielo; como está escrito en el libro de los profetas: ¿Me ofrecisteis víctimas y sacrificios en el desierto por cuarenta años, casa de Israel?", "words": [[0, 312814], [2, 312938], [7, 313138], [10, 313318], [18, 313838], [20, 314218], [24, 314358], [32, 314838], [36, 314938], [46, 315458], [49, 315638], [58, 316138], [62, 316338], [69, 317032], [74, 317192], [79, 317472], [87, 317852], [90, 318072], [93, 318212], [99, 318432], [102, 318612], [106, 318732], [116, 319791], [120, 319897], [132, 320597], [141, 321137], [143, 321277], [155, 321997], [158, 322137], [161, 322237], [170, 322737], [174, 323047], [183, 323357], [189, 323877], [194, 323997], [197, 324237]]}, {"verse": 43, "start": 325168, "end": 335405, "text": "Antes, trajisteis el tabernáculo de Moloc, y la estrella de vuestro dios Renfán: figuras que os hicisteis para adorarlas: os transportaré pues, más allá de Babilonia.", "words": [[0, 325168], [7, 325470], [18, 326250], [21, 326370], [33, 326990], [36, 327280], [43, 327570], [45, 328110], [48, 328230], [57, 328690], [60, 328790], [68, 329110], [73, 329410], [81, 330316], [89, 330682], [93, 330882], [96, 331022], [106, 331602], [111, 331782], [122, 332736], [125, 332874], [138, 333554], [144, 333834], [148, 334334], [153, 334574], [156, 334714]]}, {"verse": 44, "start": 335755, "end": 344816, "text": "Tuvieron nuestros padres el tabernáculo del testimonio en el desierto, como había ordenado Dios, hablando a Moisés que lo hiciese según la forma que había visto.", "words": [[0, 335755], [9, 336091], [18, 336371], [25, 336811], [28, 337171], [40, 337851], [44, 338051], [55, 338711], [58, 338811], [61, 338911], [71, 339831], [76, 340031], [82, 340231], [91, 340651], [97, 341451], [106, 341711], [108, 341911], [115, 342311], [119, 342591], [122, 342711], [130, 343191], [136, 343451], [139, 343651], [145, 343931], [149, 344131], [155, 344331]]}, {"verse": 45, "start": 345166, "end": 354278, "text": "El cual recibido, metieron también nuestros padres con Josué en la posesión de los Gentiles, que Dios echó de la presencia de nuestros padres, hasta los días de David;", "words": [[0, 345166], [3, 345287], [8, 345567], [18, 346467], [27, 346907], [35, 347207], [44, 347547], [51, 348027], [55, 348307], [61, 348787], [64, 348927], [67, 349047], [76, 349567], [79, 349707], [83, 349807], [93, 350667], [97, 350767], [102, 351027], [107, 351427], [110, 351527], [113, 351627], [123, 352087], [126, 352207], [135, 352387], [143, 353127], [149, 353347], [153, 353527], [158, 353727], [161, 353907]]}, {"verse": 46, "start": 354628, "end": 359247, "text": "El cual halló gracia delante de Dios, y pidió hallar tabernáculo para el Dios de Jacob.", "words": [[0, 354628], [3, 354766], [8, 354926], [14, 355246], [21, 355646], [29, 356046], [32, 356166], [38, 356426], [40, 356711], [46, 357111], [53, 357431], [65, 358031], [70, 358291], [73, 358431], [78, 358571], [81, 358711]]}, {"verse": 47, "start": 359597, "end": 361265, "text": "Pero Salomón le edificó casa.", "words": [[0, 359597], [5, 359736], [13, 360236], [16, 360356], [24, 360796]]}, {"verse": 48, "start": 361615, "end": 365972, "text": "Si bien el Altísimo no habita en templos hechos de mano; como el profeta dice:", "words": [[0, 361615], [3, 361780], [8, 362020], [11, 362120], [20, 362580], [23, 362800], [30, 363140], [33, 363260], [41, 363700], [48, 363960], [51, 364100], [57, 364745], [62, 364905], [65, 365065], [73, 365485]]}, {"verse": 49, "start": 366322, "end": 374716, "text": "El cielo es mi trono, y la tierra es el estrado de mis pies. ¿Qué casa me edificaréis? dice el Señor; ¿o cuál es el lugar de mi reposo?", "words": [[0, 366322], [3, 366462], [9, 366802], [12, 367022], [15, 367142], [22, 367522], [24, 367962], [27, 368102], [34, 368382], [37, 368582], [40, 368682], [48, 369102], [51, 369242], [55, 369342], [61, 370104], [66, 370225], [71, 370505], [74, 370725], [87, 371797], [92, 372040], [95, 372180], [102, 372930], [105, 373030], [110, 373210], [113, 373430], [116, 373550], [122, 373770], [125, 373970], [128, 374090]]}, {"verse": 50, "start": 375066, "end": 377377, "text": "¿No hizo mi mano todas estas cosas?", "words": [[0, 375066], [4, 375210], [9, 375490], [12, 375730], [17, 376010], [23, 376270], [29, 376650]]}, {"verse": 51, "start": 377727, "end": 386937, "text": "Duros de cerviz, e incircuncisos de corazón y de oídos, vosotros resistís siempre al Espíritu Santo: como vuestros padres, así también vosotros.", "words": [[0, 377727], [6, 378208], [9, 378488], [17, 378768], [19, 379398], [33, 380028], [36, 380168], [44, 380568], [46, 380768], [49, 380888], [56, 381708], [65, 382068], [74, 382668], [82, 383008], [85, 383208], [94, 383688], [101, 384389], [106, 384533], [115, 384953], [123, 385633], [127, 385813], [135, 386173]]}, {"verse": 52, "start": 387287, "end": 397151, "text": "¿A cuál de los profetas no persiguieron vuestros padres? y mataron a los que antes anunciaron la venida del Justo, del cual vosotros ahora habéis sido traidores y asesinos;", "words": [[0, 387287], [3, 387409], [8, 387589], [11, 387769], [15, 387909], [24, 388429], [27, 388629], [40, 389249], [49, 389589], [57, 390489], [59, 390592], [67, 391052], [69, 391192], [73, 391312], [77, 391472], [83, 391712], [94, 392392], [97, 392532], [104, 392872], [108, 393052], [115, 393792], [119, 393932], [124, 394152], [133, 394672], [139, 394992], [146, 395512], [151, 395732], [161, 396192], [163, 396432]]}, {"verse": 53, "start": 397501, "end": 401661, "text": "Que recibisteis la ley por disposición de ángeles, y no la guardasteis.", "words": [[0, 397501], [4, 397580], [16, 398380], [19, 398520], [23, 398720], [27, 398900], [39, 399560], [42, 399720], [51, 400220], [53, 400480], [56, 400640], [59, 400780]]}, {"verse": 54, "start": 401941, "end": 408191, "text": "Y oyendo estas cosas, se enfurecían en sus corazones, y crujían los dientes contra él.", "words": [[0, 401941], [2, 402083], [9, 402403], [15, 402623], [22, 403143], [25, 403668], [36, 404428], [39, 404648], [43, 404848], [54, 405908], [56, 406068], [64, 406748], [68, 406908], [76, 407308], [83, 407728]]}, {"verse": 55, "start": 408541, "end": 417925, "text": "Pero él, estando lleno de Espíritu Santo, puestos los ojos en el cielo, vio la gloria de Dios, y a Jesús que estaba a la diestra de Dios,", "words": [[0, 408541], [5, 408723], [9, 409023], [17, 409503], [23, 409903], [26, 410023], [35, 410583], [42, 411523], [50, 412023], [54, 412183], [59, 412523], [62, 412783], [65, 412923], [72, 413603], [76, 413903], [79, 414043], [86, 414443], [89, 414603], [95, 414903], [97, 415423], [99, 415543], [105, 416143], [109, 416283], [116, 416583], [118, 416783], [121, 416823], [129, 417303], [132, 417503]]}, {"verse": 56, "start": 418275, "end": 423820, "text": "Y dijo: He aquí, veo los cielos abiertos, y al Hijo del hombre que está a la diestra de Dios.", "words": [[0, 418275], [2, 418425], [8, 419123], [11, 419264], [17, 419544], [21, 419804], [25, 419984], [32, 420404], [42, 421264], [44, 421424], [47, 421544], [52, 421764], [56, 421964], [63, 422324], [67, 422424], [72, 422684], [74, 422784], [77, 422844], [85, 423224], [88, 423384]]}, {"verse": 57, "start": 424100, "end": 431419, "text": "Entonces dando grandes voces, se taparon sus oídos, y arremetieron unánimes contra él;", "words": [[0, 424100], [9, 425291], [15, 425631], [23, 426031], [30, 426951], [33, 427071], [41, 427531], [45, 427711], [52, 428651], [54, 428871], [67, 429751], [76, 430571], [83, 430931]]}, {"verse": 58, "start": 431769, "end": 439792, "text": "Y echándolo fuera de la ciudad, le apedreaban: y los testigos pusieron sus vestidos a los pies de un joven que se llamaba Saulo.", "words": [[0, 431769], [2, 431880], [12, 432420], [18, 432680], [21, 432880], [24, 433020], [32, 433880], [35, 434020], [47, 435458], [49, 435564], [53, 435704], [62, 436244], [71, 436664], [75, 436884], [84, 437404], [86, 437584], [90, 437704], [95, 437884], [98, 438044], [101, 438164], [107, 438524], [111, 438644], [114, 438764], [122, 439164]]}, {"verse": 59, "start": 440142, "end": 446400, "text": "Y apedrearon a Esteban, invocando él y diciendo: Señor Jesús, recibe mi espíritu.", "words": [[0, 440142], [2, 440271], [13, 440971], [15, 441111], [24, 441711], [34, 442671], [37, 442931], [39, 443151], [49, 444138], [55, 444380], [62, 445160], [69, 445620], [72, 445760]]}, {"verse": 60, "start": 446680, "end": 454636, "text": "Y puesto de rodillas, clamó a gran voz: Señor, no les imputes este pecado. Y habiendo dicho esto, durmió.", "words": [[0, 446680], [2, 446802], [9, 447142], [12, 447442], [22, 448542], [28, 448982], [30, 449082], [35, 449222], [40, 450043], [47, 450529], [50, 450589], [54, 450769], [62, 451229], [67, 451489], [75, 452417], [77, 452577], [86, 452977], [92, 453317], [98, 453977]]}]}