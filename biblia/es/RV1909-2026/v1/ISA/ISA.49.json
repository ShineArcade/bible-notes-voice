{"book": "ISA", "chapter": 49, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 289111, "verses": [{"verse": 1, "start": 300, "end": 10128, "text": "Oidme, islas, y escuchad, pueblos lejanos: Jehová me llamó desde el vientre; desde las entrañas de mi madre tuvo mi nombre en memoria.", "words": [[0, 300], [7, 823], [14, 1283], [16, 2053], [26, 2823], [34, 3363], [43, 4635], [50, 4855], [53, 4955], [59, 5335], [65, 5495], [68, 5675], [77, 6619], [83, 6784], [87, 7024], [96, 7604], [99, 7784], [102, 7904], [108, 8244], [113, 8764], [116, 9004], [123, 9264], [126, 9424]]}, {"verse": 2, "start": 10428, "end": 17981, "text": "Y puso mi boca como espada aguda, me cubrió con la sombra de su mano; y me puso por flecha limpia, me guardó en su bolsa de flechas;", "words": [[0, 10428], [2, 10530], [7, 10790], [10, 10910], [15, 11210], [20, 11470], [27, 11890], [34, 12510], [37, 12730], [44, 13050], [48, 13210], [51, 13330], [58, 13650], [61, 13770], [64, 13910], [70, 14629], [72, 14718], [75, 14818], [80, 15138], [84, 15278], [91, 15618], [99, 16318], [102, 16458], [109, 16778], [112, 16858], [115, 16958], [121, 17298], [124, 17398]]}, {"verse": 3, "start": 18331, "end": 22272, "text": "Y me dijo: Mi siervo eres, oh Israel, que en ti me gloriaré.", "words": [[0, 18331], [2, 18441], [5, 18541], [11, 19323], [14, 19462], [21, 19882], [27, 20082], [30, 20282], [38, 20722], [42, 21062], [45, 21182], [48, 21402], [51, 21602]]}, {"verse": 4, "start": 22874, "end": 32833, "text": "Pero yo dije: Por demás he trabajado, en vano y sin provecho he consumido mi fortaleza; mas mi juicio está delante de Jehová, y mi recompensa con mi Dios.", "words": [[0, 22874], [5, 23019], [8, 23219], [14, 23989], [18, 24088], [24, 24388], [27, 24608], [38, 25328], [41, 25708], [46, 26208], [48, 26348], [52, 26548], [61, 27068], [64, 27188], [74, 27728], [77, 27848], [88, 28981], [92, 29140], [95, 29280], [102, 29680], [107, 29960], [115, 30380], [118, 30520], [126, 31160], [128, 31280], [131, 31400], [142, 32040], [146, 32200], [149, 32360]]}, {"verse": 5, "start": 33183, "end": 48549, "text": "Ahora pues, dice Jehová, el que me formó desde el vientre por su siervo, para que convierta a él a Jacob. Bien que Israel no se juntará, con todo, estimado seré en los ojos de Jehová, y el Dios mío será mi fortaleza.", "words": [[0, 33183], [6, 33776], [12, 34216], [17, 34496], [25, 35676], [28, 35736], [32, 35896], [35, 36056], [41, 36536], [47, 36716], [50, 36956], [58, 37416], [62, 37636], [65, 37836], [73, 38516], [78, 38916], [82, 39116], [92, 39816], [94, 40036], [97, 40256], [99, 40476], [106, 41381], [111, 41579], [115, 41799], [122, 42199], [125, 42479], [128, 42619], [137, 43139], [141, 43499], [147, 44159], [156, 44759], [161, 45119], [164, 45219], [168, 45339], [173, 45619], [176, 45819], [184, 46539], [186, 46699], [189, 46839], [194, 46979], [198, 47399], [203, 47599], [206, 47759]]}, {"verse": 6, "start": 48899, "end": 63442, "text": "Y dijo: Poco es que tú me seas siervo para levantar las tribus de Jacob, y para que restaures los asolamientos de Israel: también te di por luz de las naciones, para que seas mi salvación hasta lo postrero de la tierra.", "words": [[0, 48899], [2, 49027], [8, 49800], [13, 49999], [16, 50279], [20, 50439], [23, 50639], [26, 50819], [31, 51119], [38, 51679], [43, 51939], [52, 52539], [56, 52699], [63, 53159], [66, 53259], [73, 53599], [75, 54219], [80, 54439], [84, 54819], [94, 55199], [98, 55439], [111, 56139], [114, 56399], [122, 57532], [130, 57872], [133, 58092], [136, 58272], [140, 58472], [144, 58712], [147, 58872], [151, 59032], [161, 59952], [166, 60292], [170, 60472], [175, 60732], [178, 60952], [188, 61572], [194, 61932], [197, 62072], [206, 62652], [209, 62752], [212, 62852]]}, {"verse": 7, "start": 64029, "end": 82925, "text": "Así ha dicho Jehová, Redentor de Israel, el Santo suyo, al menospreciado de alma, al abominado de las naciones, al siervo de los tiranos: Verán reyes, y se levantarán príncipes, y adorarán por Jehová; porque fiel es el Santo de Israel, el cual te escogió.", "words": [[0, 64029], [4, 64295], [7, 64415], [13, 64635], [21, 66075], [30, 66755], [33, 66895], [41, 67655], [44, 67755], [50, 68075], [56, 68675], [59, 69195], [73, 69715], [76, 69915], [82, 70695], [85, 70835], [95, 71475], [98, 71655], [102, 71815], [112, 72855], [115, 72915], [122, 73515], [125, 73635], [129, 73775], [138, 74812], [144, 75136], [151, 75636], [153, 75856], [156, 75996], [167, 76576], [178, 77296], [180, 77676], [189, 78176], [193, 78336], [201, 79433], [208, 79615], [213, 80055], [216, 80355], [219, 80495], [225, 80895], [228, 81015], [236, 81835], [239, 81915], [244, 82115], [247, 82295]]}, {"verse": 8, "start": 83527, "end": 96463, "text": "Así dijo Jehová: En hora de contentamiento te oí, y en el día de salvación te ayudé: y te guardaré, y te daré por pacto del pueblo, para que levantes la tierra, para que heredes asoladas heredades;", "words": [[0, 83527], [4, 83750], [9, 84110], [17, 84978], [20, 85122], [25, 85282], [28, 85442], [43, 86322], [46, 86542], [50, 86842], [52, 87342], [55, 87442], [58, 87562], [62, 87702], [65, 87842], [75, 88422], [78, 88602], [85, 89668], [87, 89793], [90, 89893], [100, 90413], [102, 90933], [105, 91053], [110, 91333], [114, 91473], [120, 91953], [124, 92073], [132, 92713], [137, 92993], [141, 93133], [150, 93613], [153, 93733], [161, 94593], [166, 94613], [170, 94773], [178, 95153], [187, 95673]]}, {"verse": 9, "start": 97163, "end": 108569, "text": "Para que digas a los presos: Salid; y a los que están en tinieblas: Manifestaos. En los caminos serán apacentados, y en todas las cumbres serán sus pastos.", "words": [[0, 97163], [5, 97329], [9, 97489], [15, 97869], [17, 97969], [21, 98069], [29, 99402], [36, 100496], [38, 100620], [40, 100660], [44, 100780], [48, 100920], [54, 101120], [57, 101280], [68, 102584], [81, 104282], [84, 104409], [88, 104509], [96, 105009], [102, 105329], [115, 106069], [117, 106329], [120, 106449], [126, 106629], [130, 106889], [138, 107329], [144, 107669], [148, 107789]]}, {"verse": 10, "start": 109259, "end": 120506, "text": "No tendrán hambre ni sed, ni el calor ni el sol los afligirá; porque el que tiene de ellos misericordia los guiará, y los conducirá a manantiales de aguas.", "words": [[0, 109259], [3, 109405], [11, 109885], [18, 110205], [21, 110365], [26, 110705], [29, 111225], [32, 111325], [38, 111665], [41, 111905], [44, 112045], [48, 112365], [52, 112865], [62, 114166], [69, 114386], [72, 114546], [76, 114606], [82, 114866], [85, 115066], [91, 115286], [104, 116166], [108, 116326], [116, 116886], [118, 117246], [122, 117386], [132, 118166], [134, 118326], [146, 119046], [149, 119186]]}, {"verse": 11, "start": 121239, "end": 126139, "text": "Y convertiré en camino todos mis montes, y mis calzadas serán levantadas.", "words": [[0, 121239], [2, 121339], [13, 122019], [16, 122079], [23, 122479], [29, 122859], [33, 123139], [41, 124019], [43, 124179], [47, 124319], [56, 124959], [62, 125299]]}, {"verse": 12, "start": 126831, "end": 135604, "text": "He aquí estos vendrán de lejos; y he aquí estos otros del norte y del occidente, y estos otros de la tierra de los Sineos.", "words": [[0, 126968], [3, 127148], [8, 127348], [14, 127748], [22, 128268], [25, 128388], [32, 129486], [34, 129664], [37, 129744], [42, 130064], [48, 130444], [54, 130944], [58, 131204], [64, 131604], [66, 131784], [70, 131884], [81, 132524], [83, 133084], [89, 133344], [95, 133784], [98, 134004], [101, 134104], [108, 134424], [111, 134644], [115, 135124]]}, {"verse": 13, "start": 136182, "end": 148541, "text": "Cantad alabanzas, oh cielos, y alégrate, tierra; y prorrumpid en alabanzas, oh montes: porque Jehová ha consolado su pueblo, y de sus pobres tendrá misericordia.", "words": [[0, 136534], [7, 136924], [18, 137314], [21, 137704], [29, 138344], [31, 138754], [41, 139164], [49, 140106], [51, 140655], [62, 141235], [65, 141495], [76, 141965], [79, 142435], [87, 143493], [94, 143853], [101, 144453], [104, 144613], [114, 145313], [117, 145493], [125, 145893], [127, 146353], [130, 146473], [134, 146633], [141, 147093], [148, 147533]]}, {"verse": 14, "start": 148991, "end": 154789, "text": "Pero Sion dijo: Me dejó Jehová, y el Señor se olvidó de mí.", "words": [[0, 148991], [5, 149151], [10, 149711], [16, 150902], [19, 151038], [24, 151418], [32, 151998], [34, 152178], [37, 152318], [43, 152658], [46, 152938], [53, 153418], [56, 153578]]}, {"verse": 15, "start": 155089, "end": 163952, "text": "¿Se olvidará la mujer de lo que parió, para dejar de compadecerse del hijo de su vientre? Aunque se olviden ellas, yo no me olvidaré de ti.", "words": [[0, 155089], [4, 155210], [13, 155650], [16, 155790], [22, 156110], [25, 156270], [28, 156390], [32, 156510], [39, 156930], [44, 157530], [50, 157850], [53, 158010], [66, 158870], [70, 159030], [75, 159230], [78, 159370], [81, 159530], [90, 160696], [97, 161092], [100, 161292], [108, 161672], [115, 162492], [118, 162572], [121, 162712], [124, 162812], [133, 163232], [136, 163392]]}, {"verse": 16, "start": 164686, "end": 170182, "text": "He aquí que en las palmas te tengo esculpida: delante de mí están siempre tus muros.", "words": [[0, 164686], [3, 164808], [8, 165108], [12, 165268], [15, 165348], [19, 165468], [26, 165908], [29, 166088], [35, 166348], [46, 167678], [54, 168122], [57, 168282], [60, 168482], [66, 168842], [74, 169322], [78, 169502]]}, {"verse": 17, "start": 170859, "end": 176114, "text": "Tus edificadores vendrán aprisa; tus destruidores y tus asoladores saldrán de ti.", "words": [[0, 170859], [4, 170983], [17, 171703], [25, 172243], [33, 173346], [37, 173444], [50, 174204], [52, 174424], [56, 174564], [67, 175184], [75, 175684], [78, 175784]]}, {"verse": 18, "start": 176822, "end": 192566, "text": "Alza tus ojos alrededor, y mira: todos estos se han reunido, han venido a ti. Vivo yo, dice Jehová, que de todos, como de vestidura de honra, serás vestida; y de ellos serás ceñida como novia.", "words": [[0, 176822], [5, 177102], [9, 177302], [14, 177562], [25, 177942], [27, 178702], [33, 179719], [39, 180019], [45, 180499], [48, 180799], [52, 180919], [61, 181719], [65, 181859], [72, 182259], [74, 182419], [78, 183326], [83, 183722], [87, 184102], [92, 184402], [100, 185242], [104, 185342], [107, 185502], [114, 186342], [119, 186502], [122, 186662], [132, 187202], [135, 187362], [142, 187942], [148, 188242], [157, 189508], [159, 189626], [162, 189746], [168, 190193], [174, 190639], [181, 191086], [186, 191266]]}, {"verse": 19, "start": 193300, "end": 203814, "text": "Porque tus asolamientos, y tus ruinas, y tu tierra desierta, ahora será estrecha por la multitud de los habitantes; y tus destruidores serán apartados lejos.", "words": [[0, 193300], [7, 193498], [11, 193718], [25, 194478], [27, 194738], [31, 194898], [39, 195578], [41, 196038], [44, 196138], [51, 196658], [61, 197178], [67, 197898], [72, 198178], [81, 198758], [85, 198958], [88, 199078], [97, 199578], [100, 199718], [104, 199818], [116, 201236], [118, 201334], [122, 201474], [135, 202214], [141, 202634], [151, 203174]]}, {"verse": 20, "start": 204530, "end": 212834, "text": "Aun los hijos de tu orfandad dirán a tus oídos: Angosto es para mí este lugar; apártate por amor de mí, para que yo more.", "words": [[0, 204530], [4, 204749], [8, 204929], [14, 205209], [17, 205429], [20, 205589], [29, 206089], [35, 206409], [37, 206489], [41, 206649], [48, 207841], [56, 208305], [59, 208485], [64, 208665], [67, 208885], [72, 209105], [79, 210191], [88, 210734], [92, 210954], [97, 211154], [100, 211374], [104, 211554], [109, 212034], [113, 212194], [116, 212354]]}, {"verse": 21, "start": 213527, "end": 228402, "text": "Y dirás en tu corazón: ¿Quién me engendró a estos hijos? porque yo sin hijos estaba y sola, peregrina y desterrada; ¿quién, pues, crio a estos? Mira, me habían dejado sola; ¿dónde estaban estos?", "words": [[0, 213527], [2, 213648], [8, 213968], [11, 214088], [14, 214208], [23, 215380], [30, 215644], [33, 215784], [42, 216264], [44, 216384], [50, 216564], [57, 217783], [64, 217987], [67, 218307], [71, 218567], [77, 218907], [84, 219467], [86, 219787], [92, 220107], [102, 221147], [104, 221327], [116, 222607], [124, 222851], [130, 223511], [135, 223791], [137, 223951], [144, 225035], [150, 225413], [153, 225473], [160, 225753], [167, 226213], [173, 227264], [180, 227582], [188, 227882]]}, {"verse": 22, "start": 229035, "end": 240698, "text": "Así dijo el Señor Jehová: He aquí, yo alzaré mi mano a las naciones, y a los pueblos levantaré mi bandera; y traerán en brazos tus hijos, y tus hijas serán traídas en hombros.", "words": [[0, 229035], [4, 229301], [9, 229641], [12, 229801], [18, 230336], [26, 231045], [29, 231190], [35, 231870], [38, 231990], [45, 232370], [48, 232510], [53, 232810], [55, 232950], [59, 233070], [69, 233930], [71, 234170], [73, 234230], [77, 234350], [85, 234870], [95, 235470], [98, 235610], [107, 236727], [109, 236828], [117, 237228], [120, 237348], [127, 237708], [131, 237908], [138, 238288], [140, 238788], [144, 238948], [150, 239308], [156, 239548], [164, 239968], [167, 240128]]}, {"verse": 23, "start": 241378, "end": 256619, "text": "Y reyes serán tus ayos, y sus reinas tus amas de leche; el rostro inclinado a tierra te adorarán, y lamerán el polvo de tus pies: y conocerás que yo soy Jehová, que no se avergonzarán los que me esperan.", "words": [[0, 241378], [2, 241679], [8, 242019], [14, 242419], [18, 242559], [24, 243259], [26, 243539], [30, 243719], [37, 244299], [41, 244479], [46, 244999], [49, 245119], [56, 246232], [59, 246398], [66, 246918], [76, 247538], [78, 247678], [85, 248018], [88, 248318], [98, 248938], [100, 249278], [108, 249778], [111, 249998], [117, 250438], [120, 250558], [124, 250698], [130, 251868], [132, 251969], [142, 252649], [146, 252869], [149, 253069], [153, 253309], [161, 254129], [165, 254409], [168, 254589], [171, 254769], [184, 255589], [188, 255729], [192, 255929], [195, 256049]]}, {"verse": 24, "start": 257223, "end": 263019, "text": "¿Será quitada la presa al valiente? o ¿se librará la cautividad legítima?", "words": [[0, 257223], [6, 257567], [14, 257987], [17, 258147], [23, 258527], [26, 258627], [36, 259699], [38, 259904], [42, 260324], [50, 260964], [53, 261124], [64, 261944]]}, {"verse": 25, "start": 263469, "end": 273908, "text": "Pero así dice Jehová: Cierto, la cautividad será quitada al valiente, y la presa del robusto será librada; y tu pleito yo lo defenderé, y yo salvaré a tus hijos.", "words": [[0, 263469], [5, 263613], [9, 263893], [14, 264253], [22, 265248], [30, 265572], [33, 265812], [44, 266372], [49, 266692], [57, 267132], [60, 267252], [70, 267732], [72, 268232], [75, 268352], [81, 268712], [85, 268832], [93, 269352], [98, 269532], [107, 270694], [109, 270798], [112, 270898], [119, 271298], [122, 271438], [125, 271558], [136, 272338], [138, 272558], [141, 272658], [149, 273138], [151, 273198], [155, 273338]]}, {"verse": 26, "start": 274604, "end": 288482, "text": "Y a los que te despojaron haré comer sus carnes, y con su sangre serán embriagados como con mosto; y conocerá toda carne que yo Jehová soy Salvador tuyo, y Redentor tuyo, el Fuerte de Jacob.", "words": [[0, 274604], [2, 274722], [4, 274842], [8, 274982], [12, 275162], [15, 275282], [26, 276102], [31, 276602], [37, 276842], [41, 277102], [49, 278102], [51, 278182], [55, 278342], [58, 278502], [65, 278902], [71, 279342], [83, 280002], [88, 280342], [92, 280542], [99, 281703], [101, 281782], [110, 282442], [115, 282602], [121, 283162], [125, 283402], [128, 283722], [135, 284182], [139, 284282], [148, 284702], [154, 285422], [156, 285862], [165, 286462], [171, 287242], [174, 287322], [181, 287622], [184, 287842]]}]}