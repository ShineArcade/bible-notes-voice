{"book": "PSA", "chapter": 44, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 146310, "verses": [{"verse": 1, "start": 300, "end": 7567, "text": "We have heard with our ears, O God, our fathers have told us, what work you did in their days, in the times of old.", "words": [[0, 300], [3, 410], [8, 550], [14, 830], [19, 1030], [23, 1190], [29, 2090], [31, 2290], [36, 3130], [40, 3230], [48, 3550], [53, 3810], [58, 4050], [62, 4350], [67, 4730], [72, 5070], [76, 5210], [80, 5410], [83, 5590], [89, 5730], [95, 6130], [98, 6510], [102, 6610], [108, 6910], [111, 7130]]}, {"verse": 2, "start": 8017, "end": 15162, "text": "How you did drive out the heathen with your hand, and planted them; how you did afflict the people, and cast them out.", "words": [[0, 8017], [4, 8156], [8, 8316], [12, 8596], [18, 8916], [22, 9196], [26, 9336], [34, 9776], [39, 9936], [44, 10076], [50, 10456], [54, 10756], [62, 11156], [68, 11918], [72, 12057], [76, 12237], [80, 12437], [88, 12777], [92, 13057], [100, 13417], [104, 13757], [109, 14097], [114, 14377]]}, {"verse": 3, "start": 15612, "end": 27548, "text": "For they got not the land in possession by their own sword, neither did their own arm save them: but your right hand, and your arm, and the light of your countenance, because you had a favour to them.", "words": [[0, 15612], [4, 15703], [9, 15823], [13, 16043], [17, 16363], [21, 16603], [26, 16883], [29, 17083], [40, 17463], [43, 17883], [49, 18123], [53, 18303], [60, 19243], [68, 19463], [72, 19723], [78, 20003], [82, 20183], [86, 20503], [91, 20903], [97, 21680], [101, 21804], [106, 21944], [112, 22224], [118, 22664], [122, 23084], [127, 23224], [132, 23704], [136, 23984], [140, 24124], [146, 24404], [149, 24564], [154, 24704], [167, 25364], [175, 25984], [179, 26284], [183, 26484], [185, 26664], [192, 26844], [195, 27104]]}, {"verse": 4, "start": 27998, "end": 32099, "text": "You are my King, O God: command deliverances for Jacob.", "words": [[0, 27998], [4, 28188], [8, 28388], [11, 28588], [17, 29228], [19, 29268], [24, 30118], [32, 30399], [45, 31199], [49, 31499]]}, {"verse": 5, "start": 32549, "end": 38623, "text": "Through you will we push down our enemies: through your name will we tread them under that rise up against us.", "words": [[0, 32549], [8, 32709], [12, 32969], [17, 33209], [20, 33389], [25, 33629], [30, 33869], [34, 34089], [43, 35026], [51, 35366], [56, 35566], [61, 35846], [66, 36066], [69, 36246], [75, 36526], [80, 36766], [86, 36986], [91, 37226], [96, 37506], [99, 37766], [107, 38086]]}, {"verse": 6, "start": 39073, "end": 42918, "text": "For I will not trust in my bow, neither shall my sword save me.", "words": [[0, 39073], [4, 39186], [6, 39366], [11, 39506], [15, 39666], [21, 39986], [24, 40206], [27, 40386], [32, 41226], [40, 41406], [46, 41766], [49, 41966], [55, 42266], [60, 42566]]}, {"verse": 7, "start": 43368, "end": 47514, "text": "But you have saved us from our enemies, and have put them to shame that hated us.", "words": [[0, 43368], [4, 43469], [8, 43649], [13, 43829], [19, 44149], [22, 44349], [27, 44509], [31, 44669], [40, 45069], [44, 45509], [49, 45669], [53, 45869], [58, 46069], [61, 46229], [67, 46529], [72, 46769], [78, 47009]]}, {"verse": 8, "start": 47964, "end": 52796, "text": "In God we boast all the day long, and praise your name for ever. Selah.", "words": [[0, 47964], [3, 48128], [7, 48428], [10, 48648], [16, 49008], [20, 49448], [24, 49628], [28, 49828], [34, 50168], [38, 50408], [45, 50728], [50, 50948], [55, 51284], [59, 51619], [65, 52505]]}, {"verse": 9, "start": 53246, "end": 57892, "text": "But you have cast off, and put us to shame; and go not forth with our armies.", "words": [[0, 53246], [4, 53344], [8, 53484], [13, 53584], [18, 53944], [23, 54344], [27, 54684], [31, 54884], [34, 55044], [37, 55164], [44, 56042], [48, 56186], [51, 56366], [55, 56566], [61, 56866], [66, 57106], [70, 57246]]}, {"verse": 10, "start": 58342, "end": 63436, "text": "You make us to turn back from the enemy: and they which hate us spoil for themselves.", "words": [[0, 58342], [4, 58509], [9, 58749], [12, 58949], [15, 59129], [20, 59369], [25, 59629], [30, 59849], [34, 59989], [41, 60763], [45, 60950], [50, 61230], [56, 61510], [61, 61790], [64, 61950], [70, 62350], [74, 62590]]}, {"verse": 11, "start": 63886, "end": 68541, "text": "You have given us like sheep appointed for food; and have scattered us among the heathen.", "words": [[0, 63886], [4, 64031], [9, 64131], [15, 64371], [18, 64571], [23, 64771], [29, 65091], [39, 65531], [43, 65791], [49, 66653], [53, 66773], [58, 66893], [68, 67253], [71, 67533], [77, 67793], [81, 67993]]}, {"verse": 12, "start": 68991, "end": 73255, "text": "You sell your people for nothing, and do not increase your wealth by their price.", "words": [[0, 68991], [4, 69099], [9, 69339], [14, 69499], [21, 69819], [25, 70039], [34, 70359], [38, 70859], [41, 71019], [45, 71219], [54, 71659], [59, 71899], [66, 72159], [69, 72399], [75, 72579]]}, {"verse": 13, "start": 73705, "end": 79094, "text": "You make us a reproach to our neighbours, a scorn and a derision to them that are round about us.", "words": [[0, 73705], [4, 73795], [9, 73955], [12, 74155], [14, 74255], [23, 74775], [26, 74935], [30, 75495], [42, 76055], [44, 76135], [50, 76595], [54, 76755], [56, 76855], [65, 77235], [68, 77435], [73, 77695], [78, 77915], [82, 78035], [88, 78275], [94, 78575]]}, {"verse": 14, "start": 79544, "end": 84097, "text": "You make us a byword among the heathen, a shaking of the head among the people.", "words": [[0, 79544], [4, 79640], [9, 79820], [12, 80000], [14, 80140], [21, 80660], [27, 80900], [31, 81180], [40, 82080], [42, 82160], [50, 82520], [53, 82780], [57, 82900], [62, 83120], [68, 83380], [72, 83620]]}, {"verse": 15, "start": 84547, "end": 89198, "text": "My confusion is continually before me, and the shame of my face has covered me,", "words": [[0, 84547], [3, 84716], [13, 85256], [16, 85516], [28, 86016], [35, 86456], [39, 87036], [43, 87296], [47, 87416], [53, 87636], [56, 87816], [59, 87996], [64, 88336], [68, 88536], [76, 88836]]}, {"verse": 16, "start": 89648, "end": 95122, "text": "For the voice of him that reproaches and blasphemes; by reason of the enemy and avenger.", "words": [[0, 89648], [4, 89737], [8, 89837], [14, 90137], [17, 90317], [21, 90517], [26, 90717], [37, 91357], [41, 91597], [53, 93014], [56, 93118], [63, 93478], [66, 93698], [70, 93838], [76, 94158], [80, 94438]]}, {"verse": 17, "start": 95572, "end": 101936, "text": "All this is come upon us; yet have we not forgotten you, neither have we dealt falsely in your covenant.", "words": [[0, 95572], [4, 95755], [9, 96055], [12, 96375], [17, 96575], [22, 96855], [26, 97702], [30, 97772], [35, 97952], [38, 98092], [42, 98272], [52, 98732], [57, 99512], [65, 99712], [70, 100012], [73, 100132], [79, 100372], [87, 101032], [90, 101232], [95, 101352]]}, {"verse": 18, "start": 102386, "end": 106662, "text": "Our heart is not turned back, neither have our steps declined from your way;", "words": [[0, 102386], [4, 102547], [10, 102827], [13, 102967], [17, 103187], [24, 103547], [30, 104267], [38, 104447], [43, 104727], [47, 104907], [53, 105227], [62, 105727], [67, 106027], [72, 106207]]}, {"verse": 19, "start": 107112, "end": 112744, "text": "Though you have severely broken us in the place of dragons, and covered us with the shadow of death.", "words": [[0, 107112], [7, 107257], [11, 107417], [16, 107577], [25, 108017], [32, 108537], [35, 108797], [38, 108937], [42, 109017], [48, 109317], [51, 109457], [60, 109957], [64, 110637], [72, 110977], [75, 111277], [80, 111477], [84, 111617], [91, 111937], [94, 112177]]}, {"verse": 20, "start": 113194, "end": 118976, "text": "If we have forgotten the name of our God, or stretched out our hands to a strange god;", "words": [[0, 113194], [3, 113347], [6, 113547], [11, 113707], [21, 114147], [25, 114407], [30, 114707], [33, 114867], [37, 115027], [42, 116087], [45, 116167], [55, 116567], [59, 116887], [63, 117087], [69, 117507], [72, 117747], [74, 117907], [82, 118367]]}, {"verse": 21, "start": 119426, "end": 123926, "text": "Shall not God search this out? for he knows the secrets of the heart.", "words": [[0, 119426], [6, 119672], [10, 119952], [14, 120332], [21, 120692], [26, 121072], [31, 121870], [35, 121993], [38, 122173], [44, 122473], [48, 122733], [56, 123093], [59, 123373], [63, 123493]]}, {"verse": 22, "start": 124376, "end": 129417, "text": "Yes, for your sake are we killed all the day long; we are counted as sheep for the slaughter.", "words": [[0, 124376], [5, 124806], [9, 124826], [14, 124966], [19, 125346], [23, 125446], [26, 125646], [33, 125906], [37, 126186], [41, 126326], [45, 126546], [51, 127381], [54, 127509], [58, 127609], [66, 127929], [69, 128189], [75, 128449], [79, 128689], [83, 128829]]}, {"verse": 23, "start": 129867, "end": 133973, "text": "Awake, why do you sleep, O Lord? arise, cast us not off for ever.", "words": [[0, 129867], [7, 130208], [11, 130368], [14, 130508], [18, 130608], [25, 131048], [27, 131148], [33, 131921], [40, 132421], [45, 132581], [48, 132821], [52, 133041], [56, 133370], [60, 133699]]}, {"verse": 24, "start": 134423, "end": 137848, "text": "Why do you hide your face, and forget our affliction and our oppression?", "words": [[0, 134423], [4, 134592], [7, 134732], [11, 134832], [16, 135072], [21, 135252], [27, 135572], [31, 135832], [38, 136112], [42, 136332], [53, 136832], [57, 137032], [61, 137192]]}, {"verse": 25, "start": 138298, "end": 142166, "text": "For our soul is bowed down to the dust: our belly clings to the earth.", "words": [[0, 138298], [4, 138444], [8, 138584], [13, 138844], [16, 139044], [22, 139424], [27, 139604], [30, 139784], [34, 139884], [40, 140756], [44, 140861], [50, 141141], [57, 141581], [60, 141721], [64, 141841]]}, {"verse": 26, "start": 142616, "end": 145910, "text": "Arise for our help, and redeem us for your mercies’ sake.", "words": [[0, 142616], [6, 143122], [10, 143322], [14, 143502], [20, 143782], [24, 144022], [31, 144342], [34, 144582], [38, 144782], [43, 145122], [52, 145462]]}]}