{"book": "1CO", "chapter": 14, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 262557, "verses": [{"verse": 1, "start": 300, "end": 4765, "text": "Follow after love, and desire spiritual gifts, but rather that you may prophesy.", "words": [[0, 300], [7, 526], [13, 766], [19, 1086], [23, 1346], [30, 1726], [40, 2326], [47, 3206], [51, 3426], [58, 3686], [63, 3906], [67, 4026], [71, 4426]]}, {"verse": 2, "start": 5115, "end": 14003, "text": "For he that speaks in an unknown tongue speaks not to men, but to God: for no man understands him; however in the spirit he speaks mysteries.", "words": [[0, 5115], [4, 5222], [7, 5482], [12, 5642], [19, 5902], [22, 6162], [25, 6262], [33, 6702], [40, 7122], [47, 7402], [51, 7702], [54, 7902], [59, 8442], [63, 8562], [66, 8722], [71, 9278], [75, 9418], [78, 9598], [82, 9818], [94, 10318], [99, 11542], [107, 12155], [110, 12255], [114, 12375], [121, 12655], [124, 12915], [131, 13235]]}, {"verse": 3, "start": 14353, "end": 18998, "text": "But he that prophesies speaks to men to edification, and exhortation, and comfort.", "words": [[0, 14353], [4, 14496], [7, 14736], [12, 14916], [23, 15536], [30, 15796], [33, 16056], [37, 16276], [40, 16476], [53, 17176], [57, 17536], [70, 18216], [74, 18436]]}, {"verse": 4, "start": 19348, "end": 24833, "text": "He that speaks in an unknown tongue edifies himself; but he that prophesies edifies the church.", "words": [[0, 19348], [3, 19460], [8, 19640], [15, 19920], [18, 20160], [21, 20280], [29, 20660], [36, 21020], [44, 21480], [53, 22389], [57, 22529], [60, 22689], [65, 23109], [76, 23529], [84, 24069], [88, 24349]]}, {"verse": 5, "start": 25183, "end": 35663, "text": "I would that you all spoke with tongues, but rather that you prophesied: for greater is he that prophesies than he that speaks with tongues, unless he interpret, that the church may receive edifying.", "words": [[0, 25183], [2, 25307], [8, 25467], [13, 25647], [17, 25807], [21, 25927], [27, 26187], [32, 26427], [41, 27127], [45, 27247], [52, 27547], [57, 27747], [61, 27867], [73, 28830], [77, 28934], [85, 29374], [88, 29754], [91, 29934], [96, 30154], [107, 30854], [112, 31014], [115, 31194], [120, 31374], [127, 31614], [132, 31874], [141, 32694], [148, 32934], [151, 33174], [162, 33514], [167, 33839], [171, 33999], [178, 34219], [182, 34479], [190, 34939]]}, {"verse": 6, "start": 36013, "end": 45858, "text": "Now, brethren, if I come to you speaking with tongues, what shall I profit you, unless I shall speak to you either by revelation, or by knowledge, or by prophesying, or by doctrine?", "words": [[0, 36013], [5, 36229], [15, 37068], [18, 37208], [20, 37308], [25, 37528], [28, 37689], [32, 37749], [41, 38009], [46, 38249], [55, 38929], [60, 39068], [66, 39268], [68, 39408], [75, 39729], [80, 40268], [87, 40448], [89, 40668], [95, 40829], [101, 41068], [104, 41268], [108, 41388], [115, 41588], [118, 41789], [130, 42749], [133, 42829], [136, 42988], [147, 43729], [150, 43789], [153, 43948], [166, 45031], [169, 45113], [172, 45253]]}, {"verse": 7, "start": 46208, "end": 54232, "text": "And even things without life giving sound, whether pipe or harp, unless they give a distinction in the sounds, how shall it be known what is piped or harped?", "words": [[0, 46208], [4, 46354], [9, 46494], [16, 46795], [24, 47075], [29, 47435], [36, 47735], [43, 48454], [51, 48555], [56, 48895], [59, 49115], [65, 49774], [72, 49975], [77, 50214], [82, 50395], [84, 50475], [96, 50854], [99, 51115], [103, 51214], [111, 51895], [115, 52055], [121, 52214], [124, 52335], [127, 52454], [133, 52714], [138, 52954], [141, 53055], [147, 53594], [150, 53714]]}, {"verse": 8, "start": 54582, "end": 59083, "text": "For if the trumpet give an uncertain sound, who shall prepare himself to the battle?", "words": [[0, 54582], [4, 54730], [7, 54890], [11, 55070], [19, 55470], [24, 55790], [27, 55970], [37, 56470], [44, 57270], [48, 57410], [54, 57590], [62, 57950], [70, 58210], [73, 58570], [77, 58670]]}, {"verse": 9, "start": 59433, "end": 67002, "text": "So likewise you, unless you utter by the tongue words easy to be understood, how shall it be known what is spoken? for you shall speak into the air.", "words": [[0, 59433], [3, 59575], [12, 59935], [17, 60495], [24, 60695], [28, 60955], [34, 61235], [37, 61455], [41, 61575], [48, 61795], [54, 62055], [59, 62395], [62, 62575], [65, 62695], [77, 63615], [81, 63795], [87, 63995], [90, 64115], [93, 64235], [99, 64455], [104, 64635], [107, 64755], [115, 65550], [119, 65664], [123, 65804], [129, 65964], [135, 66264], [140, 66484], [144, 66644]]}, {"verse": 10, "start": 67352, "end": 72828, "text": "There are, it may be, so many kinds of voices in the world, and none of them is without meaning.", "words": [[0, 67352], [6, 67492], [11, 67892], [14, 68012], [18, 68232], [22, 68612], [25, 68996], [30, 69217], [36, 69517], [39, 69717], [46, 70056], [49, 70297], [53, 70416], [60, 70756], [64, 71256], [69, 71476], [72, 71596], [77, 71797], [80, 71956], [88, 72236]]}, {"verse": 11, "start": 73178, "end": 80275, "text": "Therefore if I know not the meaning of the voice, I shall be to him that speaks a barbarian, and he that speaks shall be a barbarian to me.", "words": [[0, 73178], [10, 73711], [13, 73851], [15, 73971], [20, 74191], [24, 74391], [28, 74531], [36, 74771], [39, 74951], [43, 75031], [50, 75691], [52, 75851], [58, 76091], [61, 76251], [64, 76411], [68, 76671], [73, 76931], [80, 77191], [82, 77371], [93, 78171], [97, 78311], [100, 78491], [105, 78671], [112, 78911], [118, 79171], [121, 79311], [123, 79411], [133, 79911], [136, 80051]]}, {"verse": 12, "start": 80625, "end": 86541, "text": "Even so you, since you are zealous of spiritual gifts, seek that you may excel to the edifying of the church.", "words": [[0, 80625], [5, 80806], [8, 81226], [13, 81366], [19, 81506], [23, 81786], [27, 81906], [35, 82446], [38, 82646], [48, 83046], [55, 83846], [60, 84146], [65, 84406], [69, 84546], [73, 84706], [79, 85026], [82, 85206], [86, 85346], [95, 85726], [98, 85986], [102, 86106]]}, {"verse": 13, "start": 86891, "end": 91177, "text": "Therefore let him that speaks in an unknown tongue pray that he may interpret.", "words": [[0, 86891], [10, 87360], [14, 87500], [18, 87680], [23, 87900], [30, 88200], [33, 88480], [36, 88600], [44, 89020], [51, 89340], [56, 89740], [61, 90200], [64, 90420], [68, 90560]]}, {"verse": 14, "start": 91527, "end": 96569, "text": "For if I pray in an unknown tongue, my spirit prays, but my understanding is unfruitful.", "words": [[0, 91527], [4, 91624], [7, 91764], [9, 91904], [14, 92144], [17, 92344], [20, 92464], [28, 92784], [36, 93424], [39, 93544], [46, 93884], [53, 94644], [57, 94784], [60, 95024], [74, 95624], [77, 95884]]}, {"verse": 15, "start": 96919, "end": 105301, "text": "What is it then? I will pray with the spirit, and I will pray with the understanding also: I will sing with the spirit, and I will sing with the understanding also.", "words": [[0, 96919], [5, 97084], [8, 97244], [11, 97404], [17, 98013], [19, 98153], [24, 98313], [29, 98553], [34, 98713], [38, 98893], [46, 99193], [50, 99713], [52, 99853], [57, 99993], [62, 100213], [67, 100373], [71, 100473], [85, 100953], [91, 101779], [93, 101915], [98, 102035], [103, 102315], [108, 102515], [112, 102655], [120, 102995], [124, 103435], [126, 103575], [131, 103715], [136, 103955], [141, 104115], [145, 104215], [159, 104675]]}, {"verse": 16, "start": 105651, "end": 114739, "text": "Else when you shall bless with the spirit, how shall he that occupies the room of the unlearned say Amen at your giving of thanks, seeing he understands not what you say?", "words": [[0, 105651], [5, 105887], [10, 106127], [14, 106267], [20, 106487], [26, 106767], [31, 106987], [35, 107127], [43, 107827], [47, 107987], [53, 108207], [56, 108387], [61, 108567], [70, 109187], [74, 109307], [79, 109507], [82, 109687], [86, 109807], [96, 110387], [100, 110747], [105, 111267], [108, 111347], [113, 111487], [120, 111727], [123, 111967], [131, 112775], [138, 113020], [141, 113260], [153, 113700], [157, 114060], [162, 114260], [166, 114380]]}, {"verse": 17, "start": 115089, "end": 118427, "text": "For you indeed give thanks well, but the other is not edified.", "words": [[0, 115089], [4, 115215], [8, 115335], [15, 115655], [20, 115915], [27, 116215], [33, 116895], [37, 117135], [41, 117295], [47, 117475], [50, 117675], [54, 117835]]}, {"verse": 18, "start": 118777, "end": 121537, "text": "I thank my God, I speak with tongues more than you all:", "words": [[0, 118777], [2, 118899], [8, 119119], [11, 119339], [16, 119879], [18, 119979], [24, 120199], [29, 120419], [37, 120639], [42, 120899], [47, 121079], [51, 121219]]}, {"verse": 19, "start": 121887, "end": 129910, "text": "Yet in the church I had rather speak five words with my understanding, that by my voice I might teach others also, than ten thousand words in an unknown tongue.", "words": [[0, 121887], [4, 122003], [7, 122083], [11, 122203], [18, 122403], [20, 122703], [24, 122883], [31, 123123], [37, 123403], [42, 123763], [48, 124123], [53, 124343], [56, 124503], [71, 125103], [76, 125338], [79, 125538], [82, 125698], [88, 126038], [90, 126238], [96, 126398], [102, 126658], [109, 126978], [115, 127458], [120, 127791], [124, 128125], [133, 128458], [139, 128738], [142, 128998], [145, 129098], [153, 129458]]}, {"verse": 20, "start": 130260, "end": 136154, "text": "Brethren, be not children in understanding: however in malice be children, but in understanding be men.", "words": [[0, 130260], [10, 130736], [13, 130816], [17, 131056], [26, 131456], [29, 131696], [44, 132732], [52, 133199], [55, 133239], [62, 133599], [65, 133739], [75, 134399], [79, 134679], [82, 134799], [96, 135279], [99, 135679]]}, {"verse": 21, "start": 136504, "end": 145613, "text": "In the law it is written, With men of other tongues and other lips will I speak to this people; and yet for all that will they not hear me, says the Lord.", "words": [[0, 136504], [3, 136642], [7, 136742], [11, 137002], [14, 137222], [17, 137362], [26, 138079], [31, 138244], [35, 138484], [38, 138644], [44, 138824], [52, 139184], [56, 139424], [62, 139604], [67, 139864], [72, 140084], [74, 140204], [80, 140424], [83, 140644], [88, 140804], [96, 141831], [100, 141955], [104, 142275], [108, 142395], [112, 142595], [117, 142795], [122, 143455], [127, 143575], [131, 143775], [136, 144035], [140, 144905], [145, 145062], [149, 145242]]}, {"verse": 22, "start": 145963, "end": 154817, "text": "Therefore tongues are for a sign, not to them that believe, but to them that believe not: but prophesying serves not for them that believe not, but for them which believe.", "words": [[0, 145963], [10, 146301], [18, 146661], [22, 146861], [26, 147041], [28, 147181], [34, 147701], [38, 147841], [41, 148061], [46, 148201], [51, 148381], [60, 149021], [64, 149161], [67, 149341], [72, 149561], [77, 149721], [85, 150021], [90, 150722], [94, 150861], [106, 151501], [113, 151781], [117, 152061], [121, 152321], [126, 152541], [131, 152741], [139, 153001], [144, 153541], [148, 153681], [152, 153861], [157, 154101], [163, 154301]]}, {"verse": 23, "start": 155167, "end": 164509, "text": "If therefore the whole church be come together into one place, and all speak with tongues, and there come in those that are unlearned, or unbelievers, will they not say that you are mad?", "words": [[0, 155167], [3, 155290], [13, 155670], [17, 155870], [23, 156130], [30, 156350], [33, 156570], [38, 156790], [47, 157250], [52, 157450], [56, 157670], [63, 158070], [67, 158490], [71, 158650], [77, 158930], [82, 159150], [91, 159470], [95, 159740], [101, 160010], [106, 160230], [109, 160390], [115, 160610], [120, 160790], [124, 160930], [135, 161610], [138, 161790], [151, 162887], [156, 163024], [161, 163184], [165, 163324], [169, 163604], [174, 163784], [178, 163964], [182, 164084]]}, {"verse": 24, "start": 164859, "end": 171330, "text": "But if all prophesy, and there come in one that believes not, or one unlearned, he is convinced of all, he is judged of all:", "words": [[0, 164859], [4, 164976], [7, 165076], [11, 165596], [21, 166116], [25, 166216], [31, 166356], [36, 166576], [39, 166696], [43, 166876], [48, 167056], [57, 167316], [62, 167636], [65, 168016], [69, 168256], [80, 168976], [83, 169116], [86, 169236], [96, 169576], [99, 169856], [104, 170296], [107, 170356], [110, 170476], [117, 170796], [120, 171016]]}, {"verse": 25, "start": 171680, "end": 180055, "text": "And thus are the secrets of his heart made manifest; and so falling down on his face he will worship God, and report that God is in you of a truth.", "words": [[0, 171680], [4, 171803], [9, 172003], [13, 172163], [17, 172323], [25, 172663], [28, 172923], [32, 173023], [38, 173323], [43, 173523], [53, 174479], [57, 174575], [60, 174695], [68, 174975], [73, 175255], [76, 175395], [80, 175515], [85, 175875], [88, 175955], [93, 176115], [101, 176375], [106, 176775], [110, 177155], [117, 177475], [122, 177715], [126, 177975], [129, 178155], [132, 178275], [136, 178535], [139, 178735], [141, 178835]]}, {"verse": 26, "start": 180405, "end": 189825, "text": "How is it then, brethren? when you come together, every one of you has a psalm, has a doctrine, has a tongue, has a revelation, has an interpretation. Let all things be done to edifying.", "words": [[0, 180405], [4, 180562], [7, 180782], [10, 180922], [16, 181282], [26, 182007], [31, 182147], [35, 182267], [40, 182447], [50, 183087], [56, 183307], [60, 183507], [63, 183627], [67, 183727], [71, 183907], [73, 184047], [80, 184567], [84, 184647], [86, 184767], [96, 185247], [100, 185307], [102, 185407], [110, 185867], [114, 185927], [116, 186007], [128, 186707], [132, 186887], [135, 187027], [151, 188099], [155, 188282], [159, 188442], [166, 188702], [169, 188902], [174, 189082], [177, 189262]]}, {"verse": 27, "start": 190175, "end": 196775, "text": "If any man speak in an unknown tongue, let it be by two, or at the most by three, and that by course; and let one interpret.", "words": [[0, 190175], [3, 190377], [7, 190537], [11, 190737], [17, 191037], [20, 191237], [23, 191337], [31, 191597], [39, 192297], [43, 192397], [46, 192517], [49, 192637], [52, 192857], [57, 193077], [60, 193517], [63, 193657], [67, 193717], [72, 193877], [75, 194117], [82, 194357], [86, 194777], [91, 194877], [94, 195037], [102, 195745], [106, 195865], [110, 195965], [114, 196185]]}, {"verse": 28, "start": 197125, "end": 202901, "text": "But if there be no interpreter, let him keep silence in the church; and let him speak to himself, and to God.", "words": [[0, 197125], [4, 197281], [7, 197401], [13, 197541], [16, 197661], [19, 197901], [32, 198901], [36, 199081], [40, 199201], [45, 199401], [53, 199821], [56, 200121], [60, 200221], [68, 200919], [72, 201005], [76, 201125], [80, 201225], [86, 201465], [89, 201645], [98, 201985], [102, 202385], [105, 202505]]}, {"verse": 29, "start": 203251, "end": 206309, "text": "Let the prophets speak two or three, and let the other judge.", "words": [[0, 203251], [4, 203388], [8, 203508], [17, 203828], [23, 204228], [27, 204508], [30, 204648], [37, 204928], [41, 205288], [45, 205428], [49, 205568], [55, 205728]]}, {"verse": 30, "start": 206659, "end": 210756, "text": "If any thing be revealed to another that sits by, let the first keep silent.", "words": [[0, 206659], [3, 206749], [7, 206883], [13, 207016], [16, 207296], [25, 207676], [28, 207856], [36, 208116], [41, 208376], [46, 208536], [50, 209296], [54, 209436], [58, 209616], [64, 209876], [69, 210116]]}, {"verse": 31, "start": 211106, "end": 215721, "text": "For you may all prophesy one by one, that all may learn, and all may be comforted.", "words": [[0, 211106], [4, 211219], [8, 211379], [12, 211539], [16, 211889], [25, 212239], [29, 212599], [32, 212799], [37, 213139], [42, 213519], [46, 213779], [50, 213979], [57, 214319], [61, 214639], [65, 214859], [69, 215059], [72, 215159]]}, {"verse": 32, "start": 216071, "end": 219013, "text": "And the spirits of the prophets are subject to the prophets.", "words": [[0, 216071], [4, 216209], [8, 216329], [16, 216689], [19, 216929], [23, 217049], [32, 217409], [36, 217689], [44, 218049], [47, 218289], [51, 218389]]}, {"verse": 33, "start": 219363, "end": 224104, "text": "For God is not the author of confusion, but of peace, as in all churches of the saints.", "words": [[0, 219363], [4, 219448], [8, 219688], [11, 219868], [15, 220048], [19, 220228], [26, 220488], [29, 220668], [40, 221328], [44, 221608], [47, 221708], [54, 222348], [57, 222548], [60, 222668], [64, 222908], [73, 223208], [76, 223468], [80, 223588]]}, {"verse": 34, "start": 224454, "end": 232711, "text": "Let your women keep silence in the churches: for it is not permitted to them to speak; but they are commanded to be under obedience, as also says the law.", "words": [[0, 224454], [4, 224644], [9, 224784], [15, 225044], [20, 225324], [28, 225684], [31, 225964], [35, 226064], [45, 226893], [49, 226995], [52, 227115], [55, 227235], [59, 227415], [69, 227855], [72, 228075], [77, 228235], [80, 228375], [87, 229019], [91, 229122], [96, 229262], [100, 229362], [110, 229762], [113, 230002], [116, 230182], [122, 230442], [133, 231342], [136, 231442], [141, 231722], [146, 232042], [150, 232362]]}, {"verse": 35, "start": 233061, "end": 239430, "text": "And if they will learn any thing, let them ask their husbands at home: for it is a shame for women to speak in the church.", "words": [[0, 233061], [4, 233203], [7, 233323], [12, 233463], [17, 233643], [23, 234010], [27, 234376], [34, 234743], [38, 234963], [43, 235163], [47, 235463], [53, 235663], [62, 236043], [65, 236343], [71, 236994], [75, 237106], [78, 237226], [81, 237366], [83, 237466], [89, 237706], [93, 237926], [99, 238166], [102, 238366], [108, 238626], [111, 238786], [115, 238886]]}, {"verse": 36, "start": 239780, "end": 243830, "text": "What? came the word of God out from you? or came it to you only?", "words": [[0, 239780], [6, 240347], [11, 240519], [15, 240699], [20, 240939], [23, 241079], [27, 241319], [31, 241579], [36, 241799], [41, 242418], [44, 242537], [49, 242817], [52, 242977], [55, 243137], [59, 243297]]}, {"verse": 37, "start": 244180, "end": 251313, "text": "If any man think himself to be a prophet, or spiritual, let him acknowledge that the things that I write to you are the commandments of the Lord.", "words": [[0, 244180], [3, 244347], [7, 244507], [11, 244707], [17, 244927], [25, 245327], [28, 245547], [31, 245667], [33, 245747], [42, 246107], [45, 246322], [56, 247422], [60, 247602], [64, 247822], [76, 248322], [81, 248742], [85, 248862], [92, 249082], [97, 249262], [99, 249362], [105, 249562], [108, 249762], [112, 249902], [116, 250082], [120, 250202], [133, 250602], [136, 250922], [140, 251022]]}, {"verse": 38, "start": 251663, "end": 254462, "text": "But if any man be ignorant, let him be ignorant.", "words": [[0, 251663], [4, 251770], [7, 251910], [11, 252130], [15, 252350], [18, 252530], [28, 253330], [32, 253430], [36, 253610], [39, 253810]]}, {"verse": 39, "start": 254812, "end": 259330, "text": "Therefore, brethren, covet to prophesy, and forbid not to speak with tongues.", "words": [[0, 254812], [11, 255335], [21, 256055], [27, 256375], [30, 256725], [40, 257075], [44, 257555], [51, 257895], [55, 258175], [58, 258335], [64, 258575], [69, 258775]]}, {"verse": 40, "start": 259680, "end": 262157, "text": "Let all things be done decently and in order.", "words": [[0, 259680], [4, 259819], [8, 260079], [15, 260319], [18, 260559], [23, 260759], [32, 261319], [36, 261659], [39, 261759]]}]}