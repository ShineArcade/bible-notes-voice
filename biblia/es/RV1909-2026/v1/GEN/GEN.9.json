{"book": "GEN", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 236257, "verses": [{"verse": 1, "start": 300, "end": 7926, "text": "Y bendijo Dios a Noé y a sus hijos, y les dijo: Fructificad, y multiplicaos, y llenad la tierra:", "words": [[0, 300], [2, 442], [10, 942], [15, 1242], [17, 1482], [21, 1882], [23, 2202], [25, 2262], [29, 2442], [36, 3302], [38, 3382], [42, 3542], [48, 4711], [61, 5191], [63, 5331], [77, 6311], [79, 6651], [86, 6991], [89, 7111]]}, {"verse": 2, "start": 8376, "end": 22319, "text": "Y vuestro temor y vuestro pavor será sobre todo animal de la tierra, y sobre toda ave de los cielos, en todo lo que se moverá en la tierra, y en todos los peces del mar: en vuestra mano son entregados.", "words": [[0, 8376], [2, 8496], [10, 8836], [16, 9316], [18, 9416], [26, 9736], [32, 10176], [37, 10496], [43, 10816], [48, 11176], [55, 11596], [58, 11856], [61, 11956], [69, 12336], [71, 12936], [77, 13176], [82, 13556], [86, 13956], [89, 14096], [93, 14236], [101, 14836], [104, 15196], [109, 15496], [112, 15716], [116, 15836], [119, 15976], [126, 16376], [129, 16456], [132, 16556], [140, 17666], [142, 17809], [145, 17929], [151, 18109], [155, 18389], [161, 18809], [165, 19009], [170, 19965], [173, 20107], [181, 20467], [186, 20767], [190, 21127]]}, {"verse": 3, "start": 22769, "end": 30669, "text": "Todo lo que se mueve y vive, os será para mantenimiento: así como las legumbres y hierbas, os lo he dado todo.", "words": [[0, 22769], [5, 22971], [8, 23191], [12, 23311], [15, 23451], [21, 23931], [23, 24091], [29, 24521], [32, 24951], [37, 25211], [42, 25491], [57, 27010], [61, 27275], [66, 27535], [70, 27715], [80, 28275], [82, 28455], [91, 28955], [94, 29335], [97, 29555], [100, 29655], [105, 29875]]}, {"verse": 4, "start": 31119, "end": 34995, "text": "Pero carne con su vida, que es su sangre, no comeréis.", "words": [[0, 31119], [5, 31281], [11, 31701], [15, 31961], [18, 32101], [24, 32781], [28, 32861], [31, 33061], [34, 33161], [42, 33901], [45, 34001]]}, {"verse": 5, "start": 35445, "end": 46798, "text": "Porque ciertamente demandaré la sangre de vuestras vidas; de mano de todo animal la demandaré, y de mano del hombre; de mano del varón su hermano demandaré la vida del hombre.", "words": [[0, 35445], [7, 35649], [19, 36409], [29, 37009], [32, 37129], [39, 37509], [42, 37689], [51, 38069], [58, 39170], [61, 39329], [66, 39589], [69, 39789], [74, 39989], [81, 40429], [84, 40649], [95, 41289], [97, 41809], [100, 41929], [105, 42209], [109, 42449], [117, 43473], [120, 43566], [125, 43786], [129, 44006], [135, 44366], [138, 44526], [146, 45006], [156, 45506], [159, 45646], [164, 45866], [168, 46066]]}, {"verse": 6, "start": 47248, "end": 55304, "text": "El que derrame sangre del hombre, por el hombre su sangre será derramada; porque a imagen de Dios es hecho el hombre.", "words": [[0, 47248], [3, 47391], [7, 47511], [15, 47931], [22, 48331], [26, 48551], [34, 49131], [38, 49311], [41, 49431], [48, 49691], [51, 49891], [58, 50251], [63, 50511], [74, 51790], [81, 51961], [83, 52151], [90, 52511], [93, 52751], [98, 53031], [101, 53451], [107, 53711], [110, 53871]]}, {"verse": 7, "start": 55754, "end": 63461, "text": "Mas vosotros fructificad, y multiplicaos; procread abundantemente en la tierra, y multiplicaos en ella.", "words": [[0, 55754], [4, 55950], [13, 56450], [26, 57430], [28, 57610], [42, 59196], [51, 59793], [66, 60733], [69, 60853], [72, 60953], [80, 61293], [82, 61773], [95, 62653], [98, 62793]]}, {"verse": 8, "start": 63811, "end": 68067, "text": "Y habló Dios a Noé y a sus hijos con él, diciendo:", "words": [[0, 63811], [2, 63936], [8, 64336], [13, 64596], [15, 64896], [19, 65516], [21, 65736], [23, 65816], [27, 65996], [33, 66296], [37, 66656], [41, 66896]]}, {"verse": 9, "start": 68317, "end": 74093, "text": "Yo, he aquí que yo establezco mi pacto con vosotros, y con vuestra simiente después de vosotros;", "words": [[0, 68317], [4, 68490], [7, 68610], [12, 68890], [16, 69090], [19, 69270], [30, 69910], [33, 70050], [39, 70490], [43, 70590], [53, 71150], [55, 71410], [59, 71590], [67, 71930], [76, 72530], [84, 72870], [87, 73170]]}, {"verse": 10, "start": 74543, "end": 86572, "text": "Y con toda alma viviente que está con vosotros, de aves, de animales, y de toda bestia de la tierra que está con vosotros; desde todos los que salieron del arca hasta todo animal de la tierra.", "words": [[0, 74543], [2, 74646], [6, 74826], [11, 75066], [16, 75366], [25, 75946], [29, 76126], [34, 76346], [38, 76566], [48, 77606], [51, 77686], [57, 78346], [60, 78406], [70, 78826], [72, 79246], [75, 79366], [80, 79546], [87, 80086], [90, 80186], [93, 80286], [100, 80606], [104, 80806], [109, 81006], [113, 81246], [123, 82472], [129, 82691], [135, 83051], [139, 83331], [143, 83511], [152, 83951], [156, 84131], [161, 84531], [167, 84831], [172, 85171], [179, 85451], [182, 85691], [185, 85771]]}, {"verse": 11, "start": 87022, "end": 96504, "text": "Estableceré mi pacto con vosotros, y no fenecerá ya más toda carne con aguas de diluvio; ni habrá más diluvio para destruir la tierra.", "words": [[0, 87022], [12, 87784], [15, 87844], [21, 88304], [25, 88444], [35, 89004], [37, 89524], [40, 89684], [49, 90051], [52, 90417], [56, 90784], [61, 90924], [67, 91384], [71, 91664], [77, 92024], [80, 92124], [89, 93266], [92, 93443], [98, 93803], [102, 93983], [110, 94663], [115, 94943], [124, 95583], [127, 95683]]}, {"verse": 12, "start": 96854, "end": 107963, "text": "Y dijo Dios: Esta será la señal del pacto que yo establezco entre mí y vosotros y toda alma viviente que está con vosotros, por siglos perpetuos:", "words": [[0, 96854], [2, 97198], [7, 97574], [13, 98132], [18, 98490], [23, 98810], [26, 98950], [32, 99410], [36, 99530], [42, 100070], [46, 100170], [49, 100330], [60, 101010], [66, 101230], [69, 101530], [71, 102050], [80, 102710], [82, 103290], [87, 103490], [92, 103870], [101, 104470], [105, 104690], [110, 104930], [114, 105230], [124, 106190], [128, 106390], [135, 106810]]}, {"verse": 13, "start": 108413, "end": 114806, "text": "Mi arco pondré en las nubes, el cual será por señal de convenio entre mí y la tierra.", "words": [[0, 108413], [3, 108615], [8, 108935], [15, 109455], [18, 109655], [22, 109795], [29, 110655], [32, 110955], [37, 111195], [42, 111515], [46, 111755], [52, 112235], [55, 112335], [64, 112955], [70, 113275], [73, 113615], [75, 113855], [78, 113995]]}, {"verse": 14, "start": 115256, "end": 121777, "text": "Y será que cuando haga venir nubes sobre la tierra, se dejará ver entonces mi arco en las nubes.", "words": [[0, 115256], [2, 115378], [7, 115618], [11, 115878], [18, 116158], [23, 116458], [29, 116758], [35, 117318], [41, 117558], [44, 117718], [52, 118138], [55, 118698], [62, 119138], [66, 119338], [75, 119838], [78, 120358], [83, 120638], [86, 120758], [90, 120878]]}, {"verse": 15, "start": 122227, "end": 133824, "text": "Y me acordaré del pacto mío, que hay entre mí y vosotros y toda alma viviente de toda carne; y no serán más las aguas por diluvio para destruir toda carne.", "words": [[0, 122227], [2, 122345], [5, 122445], [14, 123045], [18, 123225], [24, 123765], [29, 124445], [33, 124725], [37, 124925], [43, 125165], [46, 125445], [48, 125705], [57, 126345], [59, 126905], [64, 127125], [69, 127485], [78, 128085], [81, 128245], [86, 128445], [93, 129679], [95, 129779], [98, 129919], [104, 130319], [108, 130539], [112, 130719], [118, 131159], [122, 131319], [130, 131819], [135, 132059], [144, 132699], [149, 132879]]}, {"verse": 16, "start": 134274, "end": 144431, "text": "Y estará el arco en las nubes, y lo veré para acordarme del pacto perpetuo entre Dios y toda alma viviente, con toda carne que hay sobre la tierra.", "words": [[0, 134274], [2, 134414], [9, 134914], [12, 135054], [17, 135414], [20, 135554], [24, 135714], [31, 136674], [33, 136754], [36, 136894], [41, 137174], [46, 137354], [56, 137974], [60, 138174], [66, 138674], [75, 139354], [81, 139674], [86, 140074], [88, 140474], [93, 140674], [98, 140994], [108, 142074], [112, 142174], [117, 142394], [123, 142794], [127, 143014], [131, 143194], [137, 143454], [140, 143654]]}, {"verse": 17, "start": 144781, "end": 153669, "text": "Dijo, pues, Dios a Noé: Esta será la señal del pacto que he establecido entre mí y toda carne que está sobre la tierra.", "words": [[0, 144781], [6, 145306], [12, 146106], [17, 146486], [19, 146909], [24, 147516], [29, 147820], [34, 148100], [37, 148240], [43, 148659], [47, 148800], [53, 149380], [57, 149499], [60, 149640], [72, 150279], [78, 150560], [81, 150820], [83, 151260], [88, 151460], [94, 151920], [98, 152140], [103, 152380], [109, 152680], [112, 152860]]}, {"verse": 18, "start": 154019, "end": 161393, "text": "Y los hijos de Noé que salieron del arca fueron Sem, Cam y Jafet: y Cam es el padre de Canaán.", "words": [[0, 154019], [2, 154126], [6, 154246], [12, 154566], [15, 154725], [19, 155066], [23, 155145], [32, 155626], [36, 155846], [41, 156225], [48, 156485], [53, 157765], [57, 158105], [59, 158545], [66, 159416], [68, 159510], [72, 159636], [75, 159763], [78, 160063], [84, 160523], [87, 160979]]}, {"verse": 19, "start": 161843, "end": 167205, "text": "Estos tres son los hijos de Noé; y de ellos fue llena toda la tierra.", "words": [[0, 161843], [6, 162466], [11, 162786], [15, 163266], [19, 163486], [25, 163786], [28, 164066], [33, 164915], [35, 165062], [38, 165162], [44, 165362], [48, 165662], [54, 166042], [59, 166242], [62, 166502]]}, {"verse": 20, "start": 167655, "end": 171968, "text": "Y comenzó Noé a labrar la tierra, y plantó una viña:", "words": [[0, 167655], [2, 167777], [10, 168377], [14, 168697], [16, 168797], [23, 169217], [26, 169357], [34, 169777], [36, 170557], [43, 171097], [47, 171237]]}, {"verse": 21, "start": 172418, "end": 178121, "text": "Y bebió del vino, y se embriagó, y estaba descubierto en medio de su tienda.", "words": [[0, 172418], [2, 172545], [8, 172885], [12, 173025], [18, 173445], [20, 173925], [23, 174045], [33, 174845], [35, 175285], [42, 175605], [54, 176485], [57, 176665], [63, 177025], [66, 177245], [69, 177405]]}, {"verse": 22, "start": 178571, "end": 186057, "text": "Y Cam, padre de Canaán, vio la desnudez de su padre, y lo dijo a sus dos hermanos a la parte de afuera.", "words": [[0, 178571], [2, 178876], [7, 179216], [13, 179556], [16, 179676], [24, 180216], [28, 180756], [31, 181296], [40, 181996], [43, 182076], [46, 182216], [53, 182576], [55, 183116], [58, 183236], [63, 183496], [65, 183716], [69, 183836], [73, 184136], [82, 184856], [84, 184956], [87, 185036], [93, 185316], [96, 185516]]}, {"verse": 23, "start": 186507, "end": 203004, "text": "Entonces Sem y Jafet tomaron la ropa, y la pusieron sobre sus propios hombros, y andando hacia atrás, cubrieron la desnudez de su padre, teniendo vueltos sus rostros, y así no vieron la desnudez de su padre.", "words": [[0, 186507], [9, 187045], [13, 187545], [15, 187825], [21, 188365], [29, 189085], [32, 189285], [38, 189785], [40, 190225], [43, 190325], [52, 190865], [58, 191185], [62, 191485], [70, 192005], [79, 192645], [81, 193125], [89, 193705], [95, 193905], [102, 194815], [112, 195725], [115, 196105], [124, 196485], [127, 196725], [130, 196925], [137, 197695], [146, 198465], [154, 199085], [158, 199660], [167, 200475], [169, 200601], [173, 200821], [176, 201081], [183, 201414], [186, 201748], [195, 202081], [198, 202281], [201, 202401]]}, {"verse": 24, "start": 203454, "end": 209414, "text": "Y despertó Noé de su vino, y supo lo que había hecho con él su hijo el más joven;", "words": [[0, 203454], [2, 203713], [11, 204433], [15, 204833], [18, 204953], [21, 205133], [27, 205493], [29, 206013], [34, 206513], [37, 206653], [41, 206813], [47, 207053], [53, 207333], [57, 207573], [60, 207753], [63, 208013], [68, 208313], [71, 208493], [75, 208673]]}, {"verse": 25, "start": 209864, "end": 214796, "text": "Y dijo: Maldito sea Canaán; siervo de siervos será a sus hermanos.", "words": [[0, 209864], [2, 210222], [8, 210845], [16, 211364], [20, 211864], [28, 212799], [35, 213019], [38, 213289], [46, 213559], [51, 213799], [53, 213939], [57, 214079]]}, {"verse": 26, "start": 215146, "end": 220251, "text": "Dijo más: Bendito Jehová el Dios de Sem, y que le sea Canaán siervo.", "words": [[0, 215146], [5, 215495], [10, 216327], [18, 216809], [25, 217269], [28, 217409], [33, 217589], [36, 217789], [41, 218149], [43, 218649], [47, 218769], [50, 218889], [54, 219259], [61, 219629]]}, {"verse": 27, "start": 220701, "end": 226592, "text": "Engrandezca Dios a Jafet, y habite en las tiendas de Sem, y que le sea Canaán siervo.", "words": [[0, 220701], [12, 221538], [17, 221798], [19, 221998], [26, 222518], [28, 222918], [35, 223298], [38, 223378], [42, 223498], [50, 223998], [53, 224298], [58, 224598], [60, 224898], [64, 225018], [67, 225138], [71, 225418], [78, 225898]]}, {"verse": 28, "start": 226942, "end": 230686, "text": "Y vivió Noé después del diluvio trescientos cincuenta años.", "words": [[0, 226942], [2, 227064], [8, 227424], [12, 227784], [20, 228084], [24, 228344], [32, 228697], [44, 229051], [54, 229404]]}, {"verse": 29, "start": 231136, "end": 235857, "text": "Y fueron todos los días de Noé novecientos cincuenta años; y murió.", "words": [[0, 231136], [2, 231401], [9, 231661], [15, 232121], [19, 232461], [24, 232701], [27, 233006], [31, 233311], [43, 233616], [53, 233921], [59, 235248], [61, 235357]]}]}