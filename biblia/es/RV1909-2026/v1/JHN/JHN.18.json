{"book": "JHN", "chapter": 18, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 370397, "verses": [{"verse": 1, "start": 300, "end": 11546, "text": "Como Jesús hubo dicho estas cosas, se salió con sus discípulos tras el arroyo de Cedrón, donde estaba un huerto, en el cual entró Jesús y sus discípulos.", "words": [[0, 300], [5, 485], [11, 785], [16, 1365], [22, 1605], [28, 1825], [35, 2625], [38, 2845], [44, 3225], [48, 3405], [52, 3645], [63, 4325], [68, 4545], [71, 4905], [78, 5265], [81, 5385], [89, 6205], [95, 6445], [102, 6785], [105, 7065], [113, 7545], [116, 8145], [119, 8305], [124, 8625], [130, 9505], [136, 9885], [138, 10385], [142, 10565]]}, {"verse": 2, "start": 11996, "end": 21170, "text": "Y también Judas, el que le entregaba, sabía aquel lugar; porque muchas veces Jesús se juntaba allí con sus discípulos.", "words": [[0, 11996], [2, 12137], [10, 12517], [17, 13017], [20, 13337], [24, 13517], [27, 13677], [38, 14717], [44, 15297], [50, 15897], [57, 16804], [64, 17005], [71, 17305], [77, 17805], [83, 18325], [86, 18825], [94, 19345], [99, 19645], [103, 19885], [107, 20125]]}, {"verse": 3, "start": 21620, "end": 31659, "text": "Judas pues tomando una tropa, y guardias de los principales sacerdotes y de los fariseos, vino allí con linternas y antorchas, y con armas.", "words": [[0, 21877], [6, 22172], [11, 22467], [19, 22762], [23, 22902], [30, 23742], [32, 23902], [41, 24422], [44, 24562], [48, 24682], [60, 25382], [71, 26122], [73, 26322], [76, 26422], [80, 26562], [90, 27722], [95, 28102], [100, 28362], [104, 28602], [114, 29382], [116, 29542], [127, 30242], [129, 30802], [133, 30982]]}, {"verse": 4, "start": 32109, "end": 39912, "text": "Pero Jesús, sabiendo todas las cosas que habían de venir sobre él, salió delante, y les dijo: ¿A quién buscáis?", "words": [[0, 32109], [5, 32256], [12, 33216], [21, 33736], [27, 34056], [31, 34376], [37, 34716], [41, 34976], [48, 35196], [51, 35396], [57, 35636], [63, 35976], [67, 36596], [73, 36896], [82, 37436], [84, 37676], [88, 37836], [94, 38686], [97, 38810], [103, 38950]]}, {"verse": 5, "start": 40362, "end": 50226, "text": "Le respondieron: A Jesús nazareno. Les dice Jesús: Yo soy. (Y estaba también con ellos Judas, el que le entregaba.)", "words": [[0, 40362], [3, 40542], [17, 41791], [19, 41937], [25, 42177], [35, 44807], [39, 44897], [44, 45197], [51, 46206], [54, 46393], [59, 47055], [62, 47276], [69, 47516], [77, 47896], [81, 48096], [87, 48276], [94, 48936], [97, 49196], [101, 49316], [104, 49456]]}, {"verse": 6, "start": 50676, "end": 55289, "text": "Y como les dijo, Yo soy, volvieron atrás, y cayeron en tierra.", "words": [[0, 50676], [2, 50856], [7, 51056], [11, 51216], [17, 51896], [20, 52016], [25, 52656], [35, 53096], [42, 53416], [44, 53976], [52, 54496], [55, 54616]]}, {"verse": 7, "start": 55739, "end": 63304, "text": "Les volvió, pues, a preguntar: ¿A quién buscáis? Y ellos dijeron: A Jesús nazareno.", "words": [[0, 55739], [4, 55846], [12, 56306], [18, 56626], [20, 56986], [31, 58004], [34, 58129], [40, 58269], [49, 59531], [51, 59680], [57, 59840], [66, 60728], [68, 60874], [74, 61114]]}, {"verse": 8, "start": 63654, "end": 69640, "text": "Respondió Jesús: Os he dicho que yo soy: pues si a mí buscáis, dejad ir a estos.", "words": [[0, 63774], [10, 64234], [17, 65291], [20, 65425], [23, 65558], [29, 65778], [33, 65998], [36, 66158], [41, 67004], [46, 67149], [49, 67389], [51, 67469], [54, 67629], [63, 68789], [69, 69149], [72, 69269], [74, 69454]]}, {"verse": 9, "start": 70090, "end": 76750, "text": "Para que se cumpliese la palabra que había dicho: De los que me diste, ninguno de ellos perdí.", "words": [[0, 70090], [5, 71053], [9, 71213], [12, 71373], [22, 72073], [25, 72273], [33, 72673], [37, 72913], [43, 73173], [50, 74134], [53, 74256], [57, 74376], [61, 74516], [64, 74676], [71, 75336], [79, 75816], [82, 75976], [88, 76176]]}, {"verse": 10, "start": 77200, "end": 89168, "text": "Entonces Simón Pedro, que tenía espada, la sacó, e hirió al siervo del sumo sacerdote, y le cortó la oreja derecha. Y el siervo se llamaba Malco.", "words": [[0, 77200], [9, 78202], [15, 78702], [22, 79182], [26, 79222], [32, 79542], [40, 80442], [43, 80562], [49, 81102], [51, 81552], [57, 82002], [60, 82442], [67, 82882], [71, 83042], [76, 83542], [87, 84242], [89, 84642], [92, 84762], [98, 85282], [101, 85642], [107, 86042], [116, 87006], [118, 87171], [121, 87351], [128, 87831], [131, 87991], [139, 88451]]}, {"verse": 11, "start": 89618, "end": 98294, "text": "Jesús entonces dijo a Pedro: Mete tu espada en la vaina: la copa que el Padre me ha dado, ¿no la he de beber?", "words": [[0, 89618], [6, 90401], [15, 91061], [20, 91221], [22, 91361], [29, 92151], [34, 92439], [37, 92699], [44, 93279], [47, 93419], [50, 93559], [57, 94478], [60, 94626], [65, 95086], [69, 95186], [72, 95346], [78, 95666], [81, 95966], [84, 96066], [90, 96386], [94, 97006], [97, 97386], [100, 97626], [103, 97806]]}, {"verse": 12, "start": 98744, "end": 105255, "text": "Entonces la tropa y su comandante, y los guardias de los judíos, prendieron a Jesús y le ataron,", "words": [[0, 98744], [9, 99249], [12, 99689], [18, 100229], [20, 100309], [23, 100429], [35, 101229], [37, 101389], [41, 101529], [50, 101989], [53, 102089], [57, 102209], [65, 102899], [76, 103589], [78, 103749], [84, 104049], [86, 104449], [89, 104549]]}, {"verse": 13, "start": 105705, "end": 114068, "text": "Y le llevaron primeramente a Anás; porque era suegro de Caifás, el cual era sumo sacerdote de aquel año.", "words": [[0, 105705], [2, 105822], [5, 105972], [14, 106452], [27, 107652], [29, 107912], [35, 108907], [42, 109169], [46, 109469], [53, 109929], [56, 110049], [64, 111029], [67, 111129], [72, 111409], [76, 111829], [81, 112409], [91, 113109], [94, 113309], [100, 113609]]}, {"verse": 14, "start": 114518, "end": 121743, "text": "Y era Caifás el que había dado el consejo a los judíos, que era necesario que un hombre muriese por el pueblo.", "words": [[0, 114518], [2, 114644], [6, 114804], [13, 115984], [16, 116064], [20, 116204], [26, 116424], [31, 116724], [34, 116844], [42, 117424], [44, 117504], [48, 117584], [56, 118224], [60, 118584], [64, 118764], [74, 119464], [78, 119724], [81, 119884], [88, 120124], [96, 120664], [100, 120944], [103, 121084]]}, {"verse": 15, "start": 122193, "end": 133986, "text": "Y seguía a Jesús Simón Pedro, y otro discípulo. Y aquel discípulo era conocido del sumo sacerdote, y entró con Jesús al patio del sumo sacerdote;", "words": [[0, 122193], [2, 122444], [9, 122884], [11, 123084], [17, 123344], [23, 123964], [30, 124424], [32, 124944], [37, 125204], [48, 126626], [50, 126728], [56, 127228], [66, 127728], [70, 127908], [79, 128568], [83, 128748], [88, 129128], [99, 130268], [101, 130588], [107, 131008], [111, 131148], [117, 131548], [120, 132108], [126, 132508], [130, 132728], [135, 133128]]}, {"verse": 16, "start": 134436, "end": 144783, "text": "Pero Pedro estaba fuera a la puerta. Y salió aquel discípulo que era conocido del sumo sacerdote, y habló a la portera, y metió dentro a Pedro.", "words": [[0, 134436], [5, 134957], [11, 135257], [18, 135557], [24, 135937], [26, 136137], [29, 136237], [37, 137260], [39, 137378], [45, 137838], [51, 138338], [61, 138998], [65, 139238], [69, 139398], [78, 140058], [82, 140258], [87, 140778], [98, 141498], [100, 141898], [106, 142238], [108, 142318], [111, 142418], [120, 143098], [122, 143318], [128, 143678], [135, 143978], [137, 144258]]}, {"verse": 17, "start": 145233, "end": 153693, "text": "Entonces la criada portera dijo a Pedro: ¿No eres tú también de los discípulos de este hombre? Dice él: No soy.", "words": [[0, 145233], [9, 146039], [12, 146219], [19, 146612], [27, 147006], [32, 147399], [34, 147539], [41, 148332], [45, 148540], [50, 148800], [53, 149060], [61, 149480], [64, 149720], [68, 149880], [79, 150500], [82, 150700], [87, 150960], [95, 151894], [100, 152362], [104, 153061], [107, 153226]]}, {"verse": 18, "start": 154043, "end": 165732, "text": "Y estaban en pie los siervos y los guardias que habían preparado un fuego de brasas; porque hacía frío, y se calentaban: y estaba también con ellos Pedro en pie, calentándose.", "words": [[0, 154043], [2, 154170], [10, 154550], [13, 154810], [17, 155070], [21, 155290], [29, 155890], [31, 156050], [35, 156190], [44, 156710], [48, 156870], [55, 157150], [65, 157790], [68, 157910], [74, 158190], [77, 158410], [85, 159447], [92, 159649], [98, 159969], [104, 160549], [106, 160969], [109, 161089], [121, 162439], [123, 162523], [130, 162823], [138, 163283], [142, 163503], [148, 163743], [154, 164203], [157, 164403], [162, 164623]]}, {"verse": 19, "start": 166182, "end": 172626, "text": "Y el sumo sacerdote preguntó a Jesús acerca de sus discípulos y de su doctrina.", "words": [[0, 166182], [2, 166328], [5, 166488], [10, 166988], [20, 167588], [29, 168228], [31, 168348], [37, 168688], [44, 169548], [47, 169888], [51, 170088], [62, 171008], [64, 171448], [67, 171568], [70, 171748]]}, {"verse": 20, "start": 173076, "end": 187414, "text": "Jesús le respondió: Yo manifiestamente he hablado al mundo: yo siempre he enseñado en la sinagoga y en el templo, donde se juntan todos los judíos, y nada he hablado en oculto.", "words": [[0, 173076], [6, 173437], [9, 173857], [20, 174952], [23, 175179], [39, 176119], [42, 176419], [50, 176839], [53, 176959], [60, 177836], [63, 178002], [71, 178462], [74, 179262], [83, 179982], [86, 180142], [89, 180302], [98, 181042], [100, 181262], [103, 181402], [106, 181562], [114, 182342], [120, 182642], [123, 182922], [130, 183522], [136, 183822], [140, 184122], [148, 184782], [150, 185362], [155, 185662], [158, 186222], [166, 186682], [169, 186802]]}, {"verse": 21, "start": 187864, "end": 195110, "text": "¿Qué me preguntas a mí? Pregunta a los que han oído, qué les haya yo hablado: he aquí, esos saben lo que yo he dicho.", "words": [[0, 187864], [5, 187948], [8, 188088], [18, 188468], [20, 188748], [24, 189379], [33, 189861], [35, 189981], [39, 190081], [43, 190261], [47, 190401], [53, 190721], [57, 190941], [61, 191141], [66, 191401], [69, 191641], [78, 192574], [81, 192654], [87, 193084], [92, 193514], [98, 193994], [101, 194214], [105, 194314], [108, 194494], [111, 194594]]}, {"verse": 22, "start": 195560, "end": 204882, "text": "Y como él hubo dicho esto, uno de los guardias que estaba allí, dio una bofetada a Jesús, diciendo: ¿Así respondes al sumo sacerdote?", "words": [[0, 195560], [2, 195662], [7, 195882], [10, 196122], [15, 196422], [21, 196642], [27, 197522], [31, 197642], [34, 197782], [38, 197922], [47, 198422], [51, 198542], [58, 198842], [64, 199162], [68, 199702], [72, 199942], [81, 200622], [83, 200782], [90, 201122], [100, 202643], [105, 202900], [115, 203600], [118, 203740], [123, 204120]]}, {"verse": 23, "start": 205231, "end": 213085, "text": "Le respondió Jesús: Si he hablado mal, da testimonio del mal: y si bien, ¿por qué me golpeas?", "words": [[0, 205231], [3, 205380], [13, 206040], [20, 207114], [23, 207318], [26, 207598], [34, 208138], [39, 208710], [42, 209284], [53, 209858], [57, 209978], [62, 210896], [64, 211020], [67, 211140], [73, 211880], [78, 212020], [82, 212140], [85, 212280]]}, {"verse": 24, "start": 213535, "end": 217908, "text": "Y Anás le había enviado atado a Caifás, el sumo sacerdote.", "words": [[0, 213688], [2, 213874], [7, 214061], [10, 214341], [16, 214541], [24, 215011], [30, 215481], [32, 215621], [40, 216521], [43, 216621], [48, 217041]]}, {"verse": 25, "start": 218358, "end": 228076, "text": "Estaba pues Pedro en pie calentándose. Y le dijeron: ¿No eres tú de sus discípulos? Él negó, y dijo: No soy.", "words": [[0, 218358], [7, 218807], [12, 219067], [18, 219587], [21, 219827], [25, 220087], [39, 221761], [41, 221926], [44, 222026], [53, 223032], [57, 223229], [62, 223429], [65, 223749], [68, 223909], [72, 224089], [84, 225291], [87, 225499], [93, 225939], [95, 226619], [101, 227444], [104, 227609]]}, {"verse": 26, "start": 228426, "end": 238453, "text": "Uno de los siervos del sumo sacerdote, pariente de aquel a quien Pedro había cortado la oreja, le dice: ¿No te vi yo en el huerto con él?", "words": [[0, 228426], [4, 228652], [7, 228812], [11, 228972], [19, 229552], [23, 229752], [28, 230252], [39, 231192], [48, 231872], [51, 232072], [57, 232432], [59, 232532], [65, 232712], [71, 233232], [77, 233552], [85, 234252], [88, 234392], [95, 235292], [98, 235372], [104, 236295], [108, 236471], [111, 236631], [114, 236811], [117, 236971], [120, 237091], [123, 237191], [130, 237431], [134, 237651]]}, {"verse": 27, "start": 238803, "end": 243155, "text": "Y negó Pedro otra vez: y de inmediato el gallo cantó.", "words": [[0, 238803], [2, 238924], [7, 239184], [13, 239644], [18, 240044], [23, 240990], [25, 241178], [28, 241258], [38, 241958], [41, 242138], [47, 242518]]}, {"verse": 28, "start": 243605, "end": 254438, "text": "Y llevaron a Jesús de Caifás al pretorio: y era por la mañana: y ellos no entraron en el pretorio por no ser contaminados, sino que comiesen la pascua.", "words": [[0, 243605], [2, 243710], [11, 244150], [13, 244250], [19, 244510], [22, 244730], [29, 245270], [32, 245430], [42, 246592], [44, 246872], [48, 247032], [52, 247232], [55, 247372], [63, 248336], [65, 248483], [71, 248703], [74, 248943], [83, 249583], [86, 249703], [89, 249843], [98, 250563], [102, 250983], [105, 251143], [109, 251363], [123, 252523], [128, 252763], [132, 253163], [141, 253563], [144, 253743]]}, {"verse": 29, "start": 254888, "end": 261308, "text": "Entonces salió Pilato a ellos fuera, y dijo: ¿Qué acusación traéis contra este hombre?", "words": [[0, 254888], [9, 255769], [15, 256209], [22, 256669], [24, 256829], [30, 257029], [37, 257489], [39, 258209], [45, 259068], [50, 259188], [60, 259828], [67, 260228], [74, 260508], [79, 260788]]}, {"verse": 30, "start": 261658, "end": 267287, "text": "Respondieron y le dijeron: Si este no fuera malhechor, no te le habríamos entregado.", "words": [[0, 261658], [13, 262462], [15, 262882], [18, 263002], [27, 263933], [30, 264087], [35, 264367], [38, 264567], [44, 265187], [55, 265807], [58, 265907], [61, 266067], [64, 266297], [74, 266527]]}, {"verse": 31, "start": 267637, "end": 280249, "text": "Les dice entonces Pilato: Tomadle vosotros, y juzgadle según vuestra ley. Y los judíos le dijeron: A nosotros no es lícito matar a nadie:", "words": [[0, 267637], [4, 267778], [9, 268058], [18, 268598], [26, 269820], [34, 270302], [44, 270802], [46, 271062], [55, 271642], [61, 271882], [69, 272342], [74, 276192], [76, 276320], [80, 276440], [87, 276940], [90, 277040], [99, 277965], [101, 278069], [110, 278349], [113, 278749], [116, 278929], [123, 279309], [129, 279609], [131, 279769]]}, {"verse": 32, "start": 280599, "end": 287566, "text": "Para que se cumpliese el dicho de Jesús, que había dicho, dando a entender de qué muerte había de morir.", "words": [[0, 280599], [5, 280785], [9, 280965], [12, 281125], [22, 281825], [25, 282125], [31, 282445], [34, 282625], [41, 283605], [45, 283685], [51, 283885], [58, 284825], [64, 285065], [66, 285338], [75, 285612], [78, 285885], [82, 286065], [89, 286485], [95, 286805], [98, 287045]]}, {"verse": 33, "start": 288016, "end": 296029, "text": "Así que, Pilato volvió a entrar en el pretorio, y llamó a Jesús, y le dijo: ¿Eres tú el Rey de los judíos?", "words": [[0, 288016], [4, 288235], [9, 288415], [16, 288935], [23, 289435], [25, 289535], [32, 289895], [35, 290235], [38, 290735], [48, 291235], [50, 291795], [56, 292175], [58, 292275], [65, 292695], [67, 293295], [70, 293435], [76, 294233], [82, 294421], [85, 294721], [88, 294901], [92, 295121], [95, 295181], [99, 295321]]}, {"verse": 34, "start": 296379, "end": 302171, "text": "Le respondió Jesús: ¿Dices tú esto de ti mismo, o te lo han dicho otros de mí?", "words": [[0, 296379], [3, 296527], [13, 297187], [20, 298261], [27, 298730], [30, 299070], [35, 299390], [38, 299650], [41, 299790], [48, 300090], [50, 300390], [53, 300590], [56, 300710], [60, 300850], [66, 301210], [72, 301650], [75, 301870]]}, {"verse": 35, "start": 302621, "end": 309666, "text": "Pilato respondió: ¿Soy yo judío? Tu nación, y los principales sacerdotes, te han entregado a mí: ¿qué has hecho?", "words": [[0, 302621], [7, 303047], [18, 304122], [23, 304366], [26, 304566], [33, 305425], [36, 305486], [44, 305946], [46, 306066], [50, 306206], [62, 306846], [74, 307526], [77, 307686], [81, 307766], [91, 308306], [93, 308426], [97, 308995], [102, 309209], [106, 309459]]}, {"verse": 36, "start": 310016, "end": 326139, "text": "Respondió Jesús: Mi reino no es de este mundo: si de este mundo fuera mi reino, mis servidores pelearían para que yo no fuera entregado a los judíos: ahora, pues, mi reino no es de aquí.", "words": [[0, 310136], [10, 310596], [17, 311553], [20, 311793], [26, 312373], [29, 312973], [32, 313233], [35, 313453], [40, 313713], [47, 314706], [50, 314890], [53, 315070], [58, 315370], [64, 315690], [70, 316090], [73, 316270], [80, 317250], [84, 317350], [95, 318110], [105, 319190], [110, 319530], [114, 319730], [117, 319930], [120, 320070], [126, 320370], [136, 321070], [138, 321150], [142, 321270], [150, 322992], [157, 323392], [163, 324252], [166, 324332], [172, 324852], [175, 325212], [178, 325452], [181, 325632]]}, {"verse": 37, "start": 326589, "end": 343347, "text": "Le dijo entonces Pilato: ¿Luego rey eres tú? Respondió Jesús: Tú dices que yo soy rey. Yo para esto he nacido, y para esto he venido al mundo, para dar testimonio a la verdad. Todo aquel que es de la verdad, oye mi voz.", "words": [[0, 326589], [3, 326718], [8, 326998], [17, 327458], [25, 328599], [32, 328865], [36, 329175], [41, 329515], [45, 330474], [55, 330934], [62, 331891], [65, 331995], [71, 332295], [75, 332475], [78, 332655], [82, 332995], [87, 333763], [90, 333947], [95, 334207], [100, 334547], [103, 334707], [111, 335427], [113, 335767], [118, 336007], [123, 336347], [126, 336487], [133, 336867], [136, 337027], [143, 337387], [148, 337927], [152, 338187], [163, 339027], [165, 339127], [168, 339187], [176, 340216], [181, 340437], [187, 340917], [191, 341017], [194, 341237], [197, 341357], [200, 341477], [208, 342357], [212, 342657], [215, 342797]]}, {"verse": 38, "start": 343797, "end": 353709, "text": "Le dice Pilato: ¿Qué cosa es verdad? Y cuando hubo dicho esto, salió otra vez a los judíos, y les dice: Yo no hallo en él ningún crimen.", "words": [[0, 343797], [3, 343998], [8, 344218], [16, 345234], [21, 345336], [26, 345616], [29, 345776], [37, 346689], [39, 346791], [46, 346991], [51, 347431], [57, 347651], [63, 348691], [69, 349271], [74, 349511], [78, 349791], [80, 349911], [84, 350051], [92, 350671], [94, 350841], [98, 351011], [104, 351830], [107, 351990], [110, 352240], [116, 352490], [119, 352630], [122, 352750], [129, 353050]]}, {"verse": 39, "start": 354159, "end": 360308, "text": "Pero vosotros tenéis costumbre, que os suelte uno en la Pascua: ¿queréis, pues, que os suelte al Rey de los judíos?", "words": [[0, 354159], [5, 354303], [14, 354743], [21, 355143], [32, 355763], [36, 355923], [39, 356063], [46, 356403], [50, 356603], [53, 356743], [56, 356843], [64, 357765], [74, 358047], [80, 358307], [84, 358627], [87, 358767], [94, 359127], [97, 359247], [101, 359487], [104, 359527], [108, 359667]]}, {"verse": 40, "start": 360658, "end": 369997, "text": "Entonces todos dieron voces otra vez, diciendo: No a este, sino a Barrabás. Y Barrabás era ladrón.", "words": [[0, 360658], [9, 361664], [15, 362144], [22, 362764], [28, 363224], [33, 363444], [38, 363884], [48, 365015], [51, 365104], [53, 365234], [59, 365634], [64, 365914], [66, 366114], [76, 367556], [78, 367891], [87, 368261], [91, 368561]]}]}