{"book": "MAT", "chapter": 24, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 379839, "verses": [{"verse": 1, "start": 300, "end": 8007, "text": "Y salido Jesús, se iba del templo; y se llegaron sus discípulos, para mostrarle los edificios del templo.", "words": [[0, 300], [2, 422], [9, 842], [16, 1162], [19, 1582], [23, 1802], [27, 2022], [35, 2982], [37, 3108], [40, 3188], [49, 3648], [53, 3908], [65, 4828], [70, 5348], [80, 6188], [84, 6368], [94, 7148], [98, 7328]]}, {"verse": 2, "start": 8357, "end": 19129, "text": "Y respondiendo él, les dijo: ¿Veis todo esto? de cierto os digo, que no será dejada aquí piedra sobre piedra, que no sea destruida.", "words": [[0, 8357], [2, 8561], [15, 9301], [19, 9741], [23, 10181], [29, 10936], [35, 11316], [40, 11516], [46, 12479], [49, 12732], [56, 13018], [59, 13305], [65, 14165], [69, 14405], [72, 14565], [77, 14825], [84, 15445], [89, 15725], [96, 16245], [102, 16505], [110, 17585], [114, 17645], [117, 17825], [121, 18085]]}, {"verse": 3, "start": 19479, "end": 31929, "text": "Y sentándose él en el monte de los Olivos, se llegaron a él los discípulos aparte, diciendo: Dinos, ¿cuándo serán estas cosas, y qué señal habrá de tu venida, y del fin del mundo?", "words": [[0, 19479], [2, 19604], [13, 20584], [16, 21024], [19, 21304], [22, 21624], [28, 21944], [31, 22104], [35, 22284], [43, 23124], [46, 23424], [55, 23944], [57, 24064], [60, 24264], [64, 24444], [75, 25084], [83, 26124], [93, 27223], [100, 27519], [108, 27939], [114, 28279], [120, 28439], [127, 28899], [129, 29379], [133, 29519], [139, 29899], [145, 30139], [148, 30199], [151, 30319], [159, 30759], [161, 30959], [165, 31119], [169, 31279], [173, 31439]]}, {"verse": 4, "start": 32209, "end": 36680, "text": "Y respondiendo Jesús, les dijo: Mirad que nadie os engañe.", "words": [[0, 32209], [2, 32330], [15, 33130], [22, 33490], [26, 33850], [32, 34660], [38, 35107], [42, 35307], [48, 35667], [51, 35947]]}, {"verse": 5, "start": 37030, "end": 43516, "text": "Porque vendrán muchos en mi nombre, diciendo: Yo soy el Cristo; y a muchos engañarán.", "words": [[0, 37030], [7, 37232], [15, 37772], [22, 38112], [25, 38412], [28, 38572], [36, 38932], [46, 40100], [49, 40457], [53, 40677], [56, 40897], [64, 41937], [66, 42061], [68, 42141], [75, 42641]]}, {"verse": 6, "start": 43866, "end": 53729, "text": "Y oiréis guerras, y rumores de guerras: mirad que no os turbéis; porque es necesario que todo esto acontezca; pero aún no es el fin.", "words": [[0, 43866], [2, 44030], [9, 44470], [18, 44990], [20, 45390], [28, 45950], [31, 46130], [40, 47070], [46, 47515], [50, 47735], [53, 47975], [56, 48135], [65, 49268], [72, 49418], [75, 49498], [85, 50078], [89, 50298], [94, 50498], [99, 50942], [110, 51605], [115, 51872], [119, 52272], [122, 52632], [125, 52892], [128, 53052]]}, {"verse": 7, "start": 53729, "end": 62097, "text": "Porque se levantará nación contra nación, y reino contra reino; y habrá pestes, y hambres, y terremotos por los lugares.", "words": [[0, 53729], [7, 53949], [10, 54109], [20, 54689], [27, 55109], [34, 55509], [42, 55989], [44, 56429], [50, 56969], [57, 57349], [64, 58391], [66, 58515], [72, 58885], [80, 59255], [82, 59565], [91, 59875], [93, 60315], [104, 60995], [108, 61175], [112, 61335]]}, {"verse": 8, "start": 62447, "end": 65823, "text": "Y todas estas cosas, principio de dolores.", "words": [[0, 62447], [2, 62548], [8, 62728], [14, 63108], [21, 63968], [31, 64648], [34, 64988]]}, {"verse": 9, "start": 66173, "end": 75389, "text": "Entonces os entregarán para ser afligidos, y os matarán; y seréis aborrecidos de todas las gentes por causa de mi nombre.", "words": [[0, 66173], [9, 67079], [12, 67199], [23, 68039], [28, 68219], [32, 68459], [43, 69179], [45, 69359], [48, 69479], [57, 70436], [59, 70539], [66, 71189], [78, 71839], [81, 71999], [87, 72459], [91, 72919], [98, 73439], [102, 73899], [108, 74259], [111, 74559], [114, 74679]]}, {"verse": 10, "start": 75739, "end": 84718, "text": "Y muchos entonces serán escandalizados; y se entregarán unos a otros, y unos a otros se aborrecerán.", "words": [[0, 75739], [2, 75867], [9, 76207], [18, 76967], [24, 77827], [40, 79313], [42, 79659], [45, 79779], [56, 80579], [61, 80859], [63, 81219], [70, 82039], [72, 82419], [77, 82659], [79, 82879], [85, 83199], [88, 83719]]}, {"verse": 11, "start": 85068, "end": 89712, "text": "Y muchos falsos profetas se levantarán y engañarán a muchos.", "words": [[0, 85068], [2, 85190], [9, 85410], [16, 86010], [25, 86530], [28, 86730], [39, 87450], [41, 87810], [51, 88670], [53, 88850]]}, {"verse": 12, "start": 90062, "end": 94577, "text": "Y por haberse multiplicado la maldad, el amor de muchos se enfriará.", "words": [[0, 90062], [2, 90315], [6, 90495], [14, 90875], [27, 91695], [30, 91855], [38, 92635], [41, 92715], [46, 92975], [49, 93155], [56, 93435], [59, 93815]]}, {"verse": 13, "start": 94927, "end": 98576, "text": "Pero el que persevere hasta el fin, este será salvo.", "words": [[0, 94927], [5, 95072], [8, 95252], [12, 95352], [22, 96132], [28, 96392], [31, 96572], [36, 97412], [41, 97612], [46, 97932]]}, {"verse": 14, "start": 98926, "end": 107746, "text": "Y será predicado este evangelio del reino en todo el mundo, por testimonio a todos los Gentiles; y entonces vendrá el fin.", "words": [[0, 98926], [2, 99047], [7, 99307], [17, 100147], [22, 100367], [32, 101127], [36, 101267], [42, 101767], [45, 101907], [50, 102107], [53, 102307], [60, 103067], [64, 103307], [75, 104167], [77, 104267], [83, 104447], [87, 104747], [97, 105807], [99, 105936], [108, 106416], [115, 107276], [118, 107511]]}, {"verse": 15, "start": 108096, "end": 116147, "text": "Por tanto, cuando veáis en el lugar santo la abominación desoladora de que habló el profeta Daniel (el que lee, entienda),", "words": [[0, 108096], [4, 108221], [11, 108681], [18, 108881], [24, 109361], [27, 109541], [30, 109661], [36, 109961], [42, 110664], [45, 110796], [57, 111736], [68, 112516], [71, 112716], [75, 112856], [81, 113196], [84, 113296], [92, 113836], [99, 114541], [103, 114661], [107, 114821], [112, 115510]]}, {"verse": 16, "start": 116497, "end": 120437, "text": "Entonces los que están en Judea, huyan a los montes;", "words": [[0, 116497], [9, 117095], [13, 117675], [17, 117835], [23, 118035], [26, 118195], [33, 118795], [39, 119415], [41, 119615], [45, 119735]]}, {"verse": 17, "start": 120787, "end": 126018, "text": "Y el que sobre la azotea, no descienda a tomar algo de su casa;", "words": [[0, 120787], [2, 120949], [5, 121049], [9, 121229], [15, 121649], [18, 121889], [26, 122729], [29, 123309], [39, 123969], [41, 124169], [47, 124469], [52, 125049], [55, 125269], [58, 125409]]}, {"verse": 18, "start": 126368, "end": 131081, "text": "Y el que en el campo, no vuelva atrás a tomar sus vestidos.", "words": [[0, 126368], [2, 126574], [5, 126774], [9, 126994], [12, 127294], [15, 127454], [22, 128014], [25, 128489], [32, 128969], [38, 129289], [40, 129529], [46, 129849], [50, 130109]]}, {"verse": 19, "start": 131431, "end": 136154, "text": "Pero ¡ay de las embarazadas, y de las que crían en aquellos días!", "words": [[0, 131431], [5, 131716], [9, 132036], [12, 132216], [16, 132356], [29, 133296], [31, 133521], [34, 133621], [38, 133761], [42, 133901], [48, 134361], [51, 134501], [60, 134741]]}, {"verse": 20, "start": 136504, "end": 140862, "text": "Orad, pues, que vuestra huida no sea en invierno ni en sábado;", "words": [[0, 136504], [6, 136504], [12, 136751], [16, 137106], [24, 137486], [30, 137866], [33, 138086], [37, 138466], [40, 138806], [49, 139506], [52, 139926], [55, 140106]]}, {"verse": 21, "start": 141212, "end": 148383, "text": "Porque habrá entonces grande aflicción, cual no fue desde el principio del mundo hasta ahora, ni será.", "words": [[0, 141212], [7, 141417], [13, 141737], [22, 142157], [29, 142877], [40, 144137], [45, 144597], [48, 144757], [52, 145017], [58, 145317], [61, 145497], [71, 146057], [75, 146377], [81, 146697], [87, 146957], [94, 147597], [97, 147797]]}, {"verse": 22, "start": 148733, "end": 157145, "text": "Y si aquellos días no fuesen acortados, nadie sobreviviría; pero por causa de los escogidos, aquellos días serán acortados.", "words": [[0, 148733], [2, 148873], [5, 148973], [14, 149213], [19, 149523], [22, 149833], [29, 150273], [40, 151393], [46, 151933], [60, 153569], [65, 153733], [69, 153993], [75, 154273], [78, 154553], [82, 154653], [93, 155333], [102, 155613], [107, 155933], [113, 156333]]}, {"verse": 23, "start": 157495, "end": 164799, "text": "Entonces, si alguno os dice: Mirad, aquí está el Cristo» o «Mirad, allí está», no lo creáis.", "words": [[0, 157495], [10, 158435], [13, 158675], [20, 158965], [23, 159255], [29, 160025], [36, 160335], [41, 160815], [46, 161035], [49, 161175], [57, 161595], [59, 162195], [67, 162915], [72, 163215], [79, 163555], [82, 163895], [85, 164035]]}, {"verse": 24, "start": 165149, "end": 176915, "text": "Porque se levantarán falsos Cristos, y falsos profetas, y darán señales grandes y prodigios; de tal manera que engañarán, si es posible, aun a los escogidos.", "words": [[0, 165149], [7, 165332], [10, 165512], [21, 166112], [28, 166652], [37, 167352], [39, 167472], [46, 167892], [56, 168492], [58, 169132], [64, 169492], [72, 169952], [80, 170412], [82, 170832], [93, 172028], [96, 172155], [100, 172335], [107, 172675], [111, 172915], [122, 173815], [125, 174175], [128, 174375], [137, 174955], [141, 175575], [143, 175915], [147, 176095]]}, {"verse": 25, "start": 177265, "end": 179477, "text": "He aquí os lo he dicho antes.", "words": [[0, 177365], [3, 177465], [8, 177745], [11, 178085], [14, 178305], [17, 178425], [23, 178665]]}, {"verse": 26, "start": 179827, "end": 187839, "text": "Así que, si os dicen: He aquí en el desierto está; no salgáis: He aquí en lugares ocultos; no creáis.", "words": [[0, 179827], [4, 180135], [9, 180335], [12, 180505], [15, 180675], [22, 181550], [25, 181640], [30, 181900], [33, 182140], [36, 182260], [45, 182780], [51, 183535], [54, 184077], [63, 184868], [66, 184948], [71, 185168], [74, 185388], [82, 185728], [91, 186946], [94, 187124]]}, {"verse": 27, "start": 188189, "end": 195896, "text": "Porque como el relámpago que sale del oriente y se muestra hasta el occidente, así será también la venida del Hijo del hombre.", "words": [[0, 188189], [7, 188451], [12, 188771], [15, 188991], [25, 189731], [29, 189911], [34, 190291], [38, 190511], [46, 190991], [48, 191171], [51, 191271], [59, 191691], [65, 191891], [68, 192031], [79, 192651], [83, 193291], [88, 193631], [96, 194071], [99, 194401], [106, 194731], [110, 194931], [115, 195151], [119, 195371]]}, {"verse": 28, "start": 196246, "end": 201252, "text": "Porque donde quiera que esté el cuerpo muerto, allí se juntarán las águilas.", "words": [[0, 196246], [7, 196470], [13, 196730], [20, 197270], [24, 197430], [29, 197630], [32, 197750], [39, 198030], [47, 199110], [52, 199530], [55, 199730], [64, 200270], [68, 200780]]}, {"verse": 29, "start": 201602, "end": 215394, "text": "Y luego después de la aflicción de aquellos días, el sol se oscurecerá, y la luna no dará su resplandor, y las estrellas caerán del cielo, y las potencias de los cielos serán conmovidas.", "words": [[0, 201602], [2, 201725], [8, 202065], [16, 202345], [19, 202605], [22, 202725], [32, 203465], [35, 203645], [44, 203905], [50, 204375], [53, 204845], [57, 205225], [60, 205685], [72, 206585], [74, 207025], [77, 207165], [82, 207545], [85, 208045], [90, 208405], [93, 208585], [105, 209345], [107, 210025], [111, 210205], [121, 210765], [128, 211225], [132, 211405], [139, 212374], [141, 212614], [145, 212754], [155, 213414], [158, 213554], [162, 213694], [169, 214174], [175, 214494]]}, {"verse": 30, "start": 215744, "end": 230940, "text": "Y entonces se mostrará la señal del Hijo del hombre en el cielo; y entonces lamentarán todas las tribus de la tierra, y verán al Hijo del hombre que vendrá sobre las nubes del cielo, con grande poder y gloria.", "words": [[0, 215744], [2, 215897], [11, 216337], [14, 216897], [23, 217497], [26, 217597], [32, 218097], [36, 218257], [41, 218557], [45, 218717], [52, 219157], [55, 219357], [58, 219497], [65, 220341], [67, 220484], [76, 220984], [87, 222064], [93, 222424], [97, 222964], [104, 223504], [107, 223604], [110, 223724], [118, 224164], [120, 224824], [126, 225204], [129, 225424], [134, 225644], [138, 225884], [145, 226244], [149, 226464], [156, 226904], [162, 227204], [166, 227444], [172, 227924], [176, 228084], [183, 228524], [187, 229224], [194, 229664], [200, 230084], [202, 230284]]}, {"verse": 31, "start": 231290, "end": 241632, "text": "Y enviará sus ángeles con gran voz de trompeta, y juntarán sus escogidos de los cuatro vientos, de un extremo del cielo hasta el otro.", "words": [[0, 231290], [2, 231409], [10, 232009], [14, 232209], [22, 232929], [26, 233369], [31, 233649], [35, 233969], [38, 234149], [48, 235069], [50, 235529], [59, 236249], [63, 236449], [73, 237269], [76, 237449], [80, 237589], [87, 237849], [96, 238469], [99, 238929], [102, 239109], [110, 239849], [114, 239989], [120, 240509], [126, 240929], [129, 241129]]}, {"verse": 32, "start": 241982, "end": 250424, "text": "De la higuera aprended la parábola: Cuando ya su rama se pone tierna, y las hojas brotan, sabéis que el verano está cerca.", "words": [[0, 241982], [3, 242148], [6, 242555], [14, 242961], [23, 243368], [26, 243648], [36, 244665], [43, 244849], [46, 245129], [49, 245409], [54, 245689], [57, 245869], [62, 246049], [70, 246689], [72, 247109], [76, 247289], [82, 247589], [90, 248429], [97, 248869], [101, 249049], [104, 249169], [111, 249529], [116, 249729]]}, {"verse": 33, "start": 250774, "end": 257385, "text": "Así también vosotros, cuando veáis todas estas cosas, conoced que está cerca, a las puertas.", "words": [[0, 250774], [4, 251115], [12, 251455], [22, 252495], [29, 252695], [35, 253215], [41, 253475], [47, 253875], [54, 254435], [62, 254995], [66, 255285], [71, 255575], [78, 256055], [80, 256555], [84, 256655]]}, {"verse": 34, "start": 257735, "end": 264161, "text": "De cierto os digo, que no pasará esta generación, que todas estas cosas no acontezcan.", "words": [[0, 257735], [3, 257923], [10, 258223], [13, 258643], [19, 259523], [23, 259703], [26, 259823], [33, 260263], [38, 260583], [50, 261723], [54, 262023], [60, 262243], [66, 262523], [72, 262923], [75, 263223]]}, {"verse": 35, "start": 264511, "end": 268886, "text": "El cielo y la tierra pasarán, pero mis palabras no pasarán.", "words": [[0, 264511], [3, 264654], [9, 265054], [11, 265354], [14, 265494], [21, 265754], [30, 266674], [35, 267034], [39, 267254], [48, 267694], [51, 268214]]}, {"verse": 36, "start": 269236, "end": 275775, "text": "Pero del día y hora nadie sabe, ni aun los ángeles de los cielos, sino mi Padre solo.", "words": [[0, 269236], [5, 269398], [9, 269658], [13, 269978], [15, 270198], [20, 270398], [26, 270758], [32, 271878], [35, 272158], [39, 272438], [43, 272698], [51, 273238], [54, 273378], [58, 273518], [66, 274258], [71, 274498], [74, 274738], [80, 274998]]}, {"verse": 37, "start": 276125, "end": 280387, "text": "Pero como los días de Noé, así será la venida del Hijo del hombre.", "words": [[0, 276125], [5, 276269], [10, 276529], [14, 276749], [19, 277089], [22, 277309], [27, 277669], [31, 278029], [36, 278409], [39, 278729], [46, 279049], [50, 279289], [55, 279609], [59, 279789]]}, {"verse": 38, "start": 280737, "end": 290396, "text": "Porque como en los días antes del diluvio estaban comiendo y bebiendo, casándose y dando en casamiento, hasta el día que Noé entró en el arca,", "words": [[0, 280737], [7, 280998], [12, 281278], [15, 281438], [19, 281558], [24, 281798], [30, 282258], [34, 282498], [42, 283038], [50, 283318], [59, 284058], [61, 284158], [71, 285118], [81, 285798], [83, 286098], [89, 286378], [92, 286578], [104, 287598], [110, 287878], [113, 288078], [117, 288318], [121, 288618], [125, 288918], [131, 289558], [134, 289718], [137, 289858]]}, {"verse": 39, "start": 290746, "end": 297457, "text": "Y no conocieron hasta que vino el diluvio y llevó a todos, así será también la venida del Hijo del hombre.", "words": [[0, 290746], [2, 290875], [5, 290995], [16, 291615], [22, 291875], [26, 292075], [31, 292295], [34, 292495], [42, 293035], [44, 293195], [50, 293515], [52, 293575], [59, 294655], [63, 294875], [68, 295195], [76, 295615], [79, 295815], [86, 296255], [90, 296475], [95, 296715], [99, 296935]]}, {"verse": 40, "start": 297807, "end": 304474, "text": "Entonces estarán dos en el campo; el uno será tomado, y el otro será dejado:", "words": [[0, 298320], [9, 298856], [17, 299416], [21, 299736], [24, 300176], [27, 300316], [34, 301163], [37, 301331], [41, 301591], [46, 301831], [54, 302571], [56, 302856], [59, 303016], [64, 303276], [69, 303636]]}, {"verse": 41, "start": 304824, "end": 311210, "text": "Dos mujeres moliendo en un molino; la una será tomada, y la otra será dejada.", "words": [[0, 304824], [4, 305486], [12, 306026], [21, 306866], [24, 307066], [27, 307206], [35, 308219], [38, 308363], [42, 308583], [47, 308863], [55, 309503], [57, 309623], [60, 309763], [65, 310043], [70, 310343]]}, {"verse": 42, "start": 311560, "end": 315846, "text": "Velad pues, porque no sabéis a qué hora ha de venir vuestro Señor.", "words": [[0, 311560], [6, 311948], [12, 312340], [19, 312733], [22, 312873], [29, 313433], [31, 313673], [35, 313813], [40, 314113], [43, 314373], [46, 314533], [52, 314793], [60, 315193]]}, {"verse": 43, "start": 316196, "end": 324979, "text": "Pero sabed esto, que si el padre de la familia supiese a qué hora vendría el ladrón, velaría, y no dejaría entrar a robar en su casa.", "words": [[0, 316196], [5, 316480], [11, 316800], [17, 317040], [21, 317220], [24, 317400], [27, 317560], [33, 317880], [36, 318080], [39, 318200], [47, 318580], [55, 319140], [57, 319300], [61, 319460], [66, 319680], [74, 320200], [77, 320460], [85, 321480], [94, 321980], [96, 322275], [99, 322415], [107, 322895], [114, 323335], [116, 323615], [122, 324055], [125, 324175], [128, 324355]]}, {"verse": 44, "start": 325329, "end": 332601, "text": "Por tanto, también vosotros estad preparados; porque el Hijo del hombre ha de venir a la hora que no pensáis.", "words": [[0, 325329], [4, 325452], [11, 325912], [19, 326192], [28, 326622], [34, 327052], [46, 328576], [53, 328838], [56, 329158], [61, 329418], [65, 329598], [72, 329918], [75, 330218], [78, 330358], [84, 330678], [86, 330938], [89, 331078], [94, 331298], [98, 331478], [101, 331618]]}, {"verse": 45, "start": 332951, "end": 341316, "text": "¿Quién pues es el siervo fiel y prudente, al cual puso su señor sobre su familia para que les dé alimento a tiempo?", "words": [[0, 332951], [7, 333308], [12, 333698], [15, 333898], [18, 334018], [25, 334498], [30, 334818], [32, 335178], [42, 335538], [45, 336018], [50, 336178], [55, 336758], [58, 336938], [64, 337338], [70, 337718], [73, 337958], [81, 338558], [86, 339098], [90, 339278], [94, 339418], [97, 339698], [106, 340358], [108, 340518]]}, {"verse": 46, "start": 341666, "end": 347908, "text": "Bienaventurado aquel siervo, al cual, cuando su señor venga, le halle haciendo así.", "words": [[0, 341666], [15, 342753], [21, 343153], [29, 343713], [32, 343913], [38, 344633], [45, 344973], [48, 345173], [54, 345473], [61, 346373], [64, 346533], [70, 346853], [79, 347193]]}, {"verse": 47, "start": 348258, "end": 351893, "text": "De cierto os digo, que sobre todos sus bienes le pondrá.", "words": [[0, 348258], [3, 348404], [10, 348684], [13, 349104], [19, 349404], [23, 349604], [29, 349934], [35, 350264], [39, 350564], [46, 351084], [49, 351184]]}, {"verse": 48, "start": 352243, "end": 357761, "text": "Y si aquel siervo malo dice en su corazón: Mi señor se tarda en venir:", "words": [[0, 352243], [2, 352369], [5, 352489], [11, 352829], [18, 353289], [23, 353849], [28, 354284], [31, 354664], [34, 354824], [43, 355795], [46, 355919], [52, 356459], [55, 356479], [61, 356939], [64, 357119]]}, {"verse": 49, "start": 358111, "end": 365223, "text": "Y comienza a herir a sus compañeros de servicio, y aun a comer y a beber con los borrachos;", "words": [[0, 358111], [2, 358219], [11, 358859], [13, 359179], [19, 359599], [21, 359699], [25, 359879], [36, 360739], [39, 360859], [49, 361519], [51, 362219], [55, 362459], [57, 362779], [63, 363099], [65, 363499], [67, 363619], [73, 363819], [77, 364199], [81, 364359]]}, {"verse": 50, "start": 365573, "end": 370707, "text": "Vendrá el señor de aquel siervo en el día que no espera, y a la hora que no sabe,", "words": [[0, 365573], [7, 366030], [10, 366170], [16, 366470], [19, 366730], [25, 367030], [32, 367550], [35, 367670], [38, 367810], [42, 368050], [46, 368230], [49, 368390], [57, 369070], [59, 369430], [61, 369550], [64, 369630], [69, 369890], [73, 370070], [76, 370210]]}, {"verse": 51, "start": 371057, "end": 379439, "text": "Y le cortará por medio, y pondrá su parte con los hipócritas: allí será el llanto y el crujir de dientes.", "words": [[0, 371057], [2, 371182], [5, 371302], [13, 371902], [17, 372162], [24, 372722], [26, 373242], [33, 373662], [36, 373842], [42, 374342], [46, 374662], [50, 374802], [62, 376124], [67, 376527], [72, 376787], [75, 376987], [82, 377627], [84, 377772], [87, 378132], [94, 378492], [97, 378652]]}]}