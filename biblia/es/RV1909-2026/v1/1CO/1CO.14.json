{"book": "1CO", "chapter": 14, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 283372, "verses": [{"verse": 1, "start": 300, "end": 6194, "text": "SEGUID el amor; y procurad los dones espirituales, pero sobre todo que profeticéis.", "words": [[0, 464], [7, 630], [10, 797], [16, 1557], [18, 1867], [27, 2217], [31, 2397], [37, 2797], [51, 3977], [56, 4297], [62, 4597], [67, 4937], [71, 5157]]}, {"verse": 2, "start": 6644, "end": 14169, "text": "Porque el que habla en lenguas, no habla a los hombres, sino a Dios; porque nadie le entiende, aunque en espíritu hable misterios.", "words": [[0, 6644], [7, 6846], [10, 7026], [14, 7166], [20, 7426], [23, 7586], [32, 8086], [35, 8366], [41, 8626], [43, 8766], [47, 8866], [56, 9546], [61, 9686], [63, 9846], [69, 10595], [76, 10775], [82, 11035], [85, 11275], [95, 12075], [102, 12255], [105, 12415], [114, 13075], [120, 13375]]}, {"verse": 3, "start": 14619, "end": 19977, "text": "Pero el que profetiza, habla a los hombres para edificación, y exhortación, y consolación.", "words": [[0, 14619], [5, 14738], [8, 14898], [12, 14998], [23, 15718], [29, 16318], [31, 16498], [35, 16598], [43, 16918], [48, 17198], [61, 17818], [63, 18258], [76, 18938], [78, 19158]]}, {"verse": 4, "start": 20427, "end": 27110, "text": "El que habla lengua extraña, a sí mismo se edifica; pero el que profetiza, edifica a la iglesia.", "words": [[0, 20427], [3, 20708], [7, 20828], [13, 21048], [20, 21448], [29, 21788], [31, 22128], [34, 22468], [40, 22808], [43, 22948], [52, 24609], [57, 24748], [60, 24868], [64, 24968], [75, 25668], [83, 25998], [85, 26328], [88, 26528]]}, {"verse": 5, "start": 27560, "end": 39295, "text": "Así que, quisiera que todos vosotros hablaseis lenguas, pero más que profetizaseis: porque mayor es el que profetiza que el que habla lenguas, si también no interpreta, para que la iglesia tome edificación.", "words": [[0, 27560], [4, 27725], [9, 27865], [18, 28245], [22, 28405], [28, 28645], [37, 29165], [47, 29725], [56, 30305], [61, 30485], [65, 30785], [69, 30965], [84, 32310], [91, 32510], [97, 32890], [100, 33150], [103, 33270], [107, 33390], [117, 34110], [121, 34270], [124, 34390], [128, 34510], [134, 34730], [143, 35450], [146, 35690], [154, 36030], [157, 36230], [169, 36930], [174, 37350], [178, 37530], [181, 37650], [189, 38010], [194, 38430]]}, {"verse": 6, "start": 39745, "end": 49444, "text": "Ahora pues, hermanos, si yo voy a vosotros hablando en lenguas, ¿qué os aprovecharé, si no os hablo, o con revelación, o con conocimiento, o con profecía, o con doctrina?", "words": [[0, 39745], [6, 40001], [12, 40241], [22, 41241], [25, 41361], [28, 41501], [32, 41621], [34, 41741], [43, 42141], [52, 42501], [55, 42741], [64, 43621], [69, 43681], [72, 43841], [85, 44461], [88, 44601], [91, 44781], [94, 44961], [101, 45341], [103, 45501], [107, 45661], [119, 46301], [121, 46601], [125, 46741], [139, 47481], [141, 47681], [145, 47821], [155, 48441], [157, 48621], [161, 48781]]}, {"verse": 7, "start": 49894, "end": 59472, "text": "Ciertamente las cosas inanimadas que hacen sonidos, como la flauta o el arpa, si no dan distinción de voces, ¿cómo se sabrá lo que se toca con la flauta o con el arpa?", "words": [[0, 49894], [12, 50468], [16, 50648], [22, 50988], [33, 51708], [37, 51928], [43, 52168], [52, 52968], [57, 53128], [60, 53268], [67, 53708], [69, 53848], [72, 53968], [78, 54288], [81, 54608], [84, 54928], [88, 55148], [99, 55688], [102, 55848], [109, 56674], [115, 56856], [118, 56996], [124, 57316], [127, 57436], [131, 57556], [134, 57676], [139, 57916], [143, 58156], [146, 58276], [153, 58656], [155, 58776], [159, 58936], [162, 59056]]}, {"verse": 8, "start": 59922, "end": 64417, "text": "Y si la trompeta da sonido incierto, ¿quién se preparará para la batalla?", "words": [[0, 59922], [2, 60020], [5, 60120], [8, 60240], [17, 60780], [20, 60880], [27, 61280], [37, 62300], [44, 62580], [47, 62820], [57, 63420], [62, 63600], [65, 63740]]}, {"verse": 9, "start": 64867, "end": 72292, "text": "Así también vosotros, si por la lengua no dais palabra comprensible, ¿cómo se entenderá lo que se dice? porque hablaréis al aire.", "words": [[0, 64867], [4, 65066], [12, 65426], [22, 66086], [25, 66206], [29, 66406], [32, 66506], [39, 66886], [42, 67046], [47, 67306], [55, 67586], [69, 68966], [75, 69166], [78, 69326], [88, 69826], [91, 69926], [95, 70026], [98, 70146], [104, 70963], [111, 71179], [121, 71659], [124, 71839]]}, {"verse": 10, "start": 72742, "end": 79450, "text": "Tantos géneros de voces, por ejemplo, hay en el mundo, y ninguna de esas voces carece de significado;", "words": [[0, 72742], [7, 73106], [15, 73546], [18, 73646], [25, 74206], [29, 74306], [38, 74986], [42, 75126], [45, 75286], [48, 75386], [55, 76106], [57, 76206], [65, 76526], [68, 76746], [73, 76946], [79, 77386], [86, 77806], [89, 77926]]}, {"verse": 11, "start": 79900, "end": 85636, "text": "Pero si yo ignoro el valor de la voz, seré extranjero para el que habla, y el que habla será extranjero para mí.", "words": [[0, 79900], [5, 80035], [8, 80215], [11, 80395], [18, 80755], [21, 80855], [27, 81055], [30, 81235], [33, 81335], [38, 81915], [43, 82295], [54, 82835], [59, 83015], [62, 83135], [66, 83235], [73, 83555], [75, 83895], [78, 83995], [82, 84095], [88, 84345], [93, 84595], [104, 85175], [109, 85335]]}, {"verse": 12, "start": 86086, "end": 93120, "text": "Así también vosotros; pues que anheláis espirituales dones, procurad ser excelentes para la edificación de la iglesia.", "words": [[0, 86086], [4, 86272], [12, 86552], [22, 87580], [27, 87720], [31, 87880], [40, 88360], [53, 89160], [60, 89640], [69, 90320], [73, 90520], [84, 91260], [89, 91540], [92, 91680], [104, 92200], [107, 92440], [110, 92520]]}, {"verse": 13, "start": 93570, "end": 98107, "text": "Por lo cual, el que habla lengua extraña, pida que la interprete.", "words": [[0, 93570], [4, 93757], [7, 93877], [13, 94157], [16, 94357], [20, 94497], [26, 94697], [33, 95057], [42, 95597], [47, 96137], [51, 96337], [54, 96437]]}, {"verse": 14, "start": 98557, "end": 104331, "text": "Porque si yo orare en lengua desconocida, mi espíritu ora; pero mi entendimiento queda sin fruto.", "words": [[0, 98557], [7, 98764], [10, 98984], [13, 99224], [19, 99584], [22, 99724], [29, 100084], [42, 100884], [45, 101004], [54, 101584], [59, 102274], [64, 102400], [67, 102520], [81, 103080], [87, 103640], [91, 103800]]}, {"verse": 15, "start": 104782, "end": 113260, "text": "¿Qué pues? Oraré con el espíritu, pero oraré también con entendimiento; cantaré con el espíritu, pero cantaré también con entendimiento.", "words": [[0, 104782], [5, 104899], [11, 105670], [17, 105971], [21, 106151], [24, 106271], [34, 107171], [39, 107311], [45, 107651], [53, 107911], [57, 108191], [72, 109493], [80, 109893], [84, 110053], [87, 110173], [97, 110973], [102, 111233], [110, 111713], [118, 111973], [122, 112253]]}, {"verse": 16, "start": 113710, "end": 122011, "text": "Porque si bendices con el espíritu, ¿cómo dirá «Amén» a tu acción de gracias quien no está instruido? Pues no sabe lo que has dicho.", "words": [[0, 113710], [7, 113916], [10, 114116], [19, 114616], [23, 114836], [26, 114956], [36, 115916], [42, 116056], [47, 116456], [54, 116716], [56, 117076], [59, 117176], [66, 117576], [69, 117716], [77, 118036], [83, 118396], [86, 118616], [91, 118796], [102, 119906], [107, 120010], [110, 120170], [115, 120490], [118, 120650], [122, 120790], [126, 120910]]}, {"verse": 17, "start": 122461, "end": 126639, "text": "Porque tú, a la verdad, das gracias bien; pero el otro no es edificado.", "words": [[0, 122461], [7, 122670], [11, 122930], [13, 123050], [16, 123130], [24, 123430], [28, 123710], [36, 124090], [42, 124960], [47, 125101], [50, 125261], [55, 125481], [58, 125701], [61, 125881]]}, {"verse": 18, "start": 127089, "end": 130275, "text": "Doy gracias a Dios que hablo lenguas más que todos vosotros:", "words": [[0, 127089], [4, 127307], [12, 127587], [14, 127827], [19, 127987], [23, 128247], [29, 128507], [37, 128907], [41, 129087], [45, 129287], [51, 129507]]}, {"verse": 19, "start": 130725, "end": 139196, "text": "Pero en la iglesia más quiero hablar cinco palabras con mi entendimiento, para que enseñe también a los otros, que diez mil palabras en lengua desconocida.", "words": [[0, 130725], [5, 130862], [8, 130982], [11, 131062], [19, 131502], [23, 131782], [30, 132042], [37, 132402], [43, 132722], [52, 133202], [56, 133462], [59, 133602], [74, 134342], [79, 134882], [83, 135042], [90, 135462], [98, 135702], [100, 135922], [104, 136082], [111, 136422], [115, 136762], [120, 137102], [124, 137342], [133, 137802], [136, 138062], [143, 138362]]}, {"verse": 20, "start": 139646, "end": 145815, "text": "Hermanos, no seáis niños en el entendimiento, sino sed niños en la malicia: pero maduros en el entendimiento.", "words": [[0, 139646], [10, 140224], [13, 140284], [19, 140624], [25, 140884], [28, 141104], [31, 141204], [46, 142064], [51, 142204], [55, 142504], [61, 142784], [64, 143004], [67, 143104], [76, 144024], [81, 144165], [89, 144585], [92, 144805], [95, 144905]]}, {"verse": 21, "start": 146265, "end": 155475, "text": "En la ley está escrito: En otras lenguas y en otros labios hablaré a este pueblo; y ni aun así me oirán, dice el Señor.", "words": [[0, 146265], [3, 146383], [6, 146483], [10, 146703], [15, 146923], [24, 147893], [27, 148058], [33, 148318], [41, 149018], [43, 149198], [46, 149318], [52, 149558], [59, 150098], [67, 150818], [69, 150998], [74, 151238], [82, 152366], [84, 152532], [87, 152632], [91, 152872], [95, 153252], [98, 153432], [105, 154605], [110, 154827], [113, 154967]]}, {"verse": 22, "start": 155925, "end": 165963, "text": "Así que, las lenguas por señal son, no a los creyentes, sino a los no creyentes: pero la profecía, no a los no creyentes, sino a los creyentes.", "words": [[0, 155925], [4, 156116], [9, 156296], [13, 156436], [21, 156876], [25, 157056], [31, 157516], [36, 157756], [39, 158336], [41, 158496], [45, 158596], [56, 159196], [61, 159536], [63, 159736], [67, 159916], [70, 160076], [81, 161247], [86, 161523], [89, 161683], [99, 162303], [102, 162663], [104, 162863], [108, 163023], [111, 163163], [122, 163943], [127, 164063], [129, 164183], [133, 164323]]}, {"verse": 23, "start": 166413, "end": 176798, "text": "De manera que, si toda la iglesia se reúne en un solo lugar, y todos hablan en lenguas, y entran personas no instruidas o no creyentes, ¿no dirán que estáis locos?", "words": [[0, 166413], [3, 166538], [10, 166758], [15, 167038], [18, 167198], [23, 167418], [26, 167638], [34, 168018], [37, 168218], [43, 168698], [46, 168798], [49, 168918], [54, 169198], [61, 169638], [63, 170038], [69, 170278], [76, 170878], [79, 171018], [88, 171518], [90, 171958], [97, 172278], [106, 172798], [109, 173038], [120, 173678], [122, 173918], [125, 173998], [136, 175170], [140, 175309], [146, 175629], [150, 175789], [157, 176189]]}, {"verse": 24, "start": 177248, "end": 184731, "text": "Pero si todos profetizan, y entra algún no creyente o alguien no instruido, por todos es convencido, por todos es juzgado;", "words": [[0, 177248], [5, 177386], [8, 177546], [14, 177806], [26, 178726], [28, 178926], [34, 179186], [40, 179486], [43, 179666], [52, 180206], [54, 180386], [62, 180646], [65, 180906], [76, 181766], [80, 181926], [86, 182206], [89, 182446], [101, 183506], [105, 183626], [111, 183886], [114, 184086]]}, {"verse": 25, "start": 185181, "end": 194578, "text": "Lo oculto de su corazón se hace manifiesto: y así, postrándose sobre el rostro, adorará a Dios, declarando que verdaderamente Dios está en vosotros.", "words": [[0, 185181], [3, 185346], [10, 185766], [13, 185826], [16, 185946], [24, 186386], [27, 186646], [32, 186826], [44, 187946], [46, 188066], [51, 188246], [63, 189046], [69, 189346], [72, 189506], [80, 190286], [88, 190906], [90, 191026], [96, 191626], [107, 192086], [111, 192226], [126, 192966], [131, 193326], [136, 193706], [139, 193866]]}, {"verse": 26, "start": 195028, "end": 208177, "text": "¿Qué hay pues, hermanos? Cuando os juntáis, cada uno de vosotros tiene salmo, tiene doctrina, tiene lengua, tiene revelación, tiene interpretación: hágase todo para edificación.", "words": [[0, 195028], [5, 195128], [9, 195368], [15, 195628], [25, 196981], [32, 197172], [35, 197332], [44, 197732], [49, 197972], [53, 198232], [56, 198352], [65, 198792], [71, 199092], [78, 200112], [84, 200332], [94, 201492], [100, 201592], [108, 202592], [114, 202672], [126, 203972], [132, 204092], [148, 205455], [155, 205777], [160, 206037], [165, 206297]]}, {"verse": 27, "start": 208627, "end": 215199, "text": "Si habla alguno en lengua extraña, sea esto por dos, o a lo más tres, y por turno; pero uno interprete.", "words": [[0, 208627], [3, 208741], [9, 208981], [16, 209541], [19, 209621], [26, 209961], [35, 210521], [39, 210861], [44, 211181], [48, 211431], [53, 211681], [55, 212021], [57, 212101], [60, 212201], [64, 212431], [70, 212661], [72, 213001], [76, 213161], [83, 214016], [88, 214176], [92, 214396]]}, {"verse": 28, "start": 215649, "end": 220868, "text": "Y si no hay intérprete, calle en la iglesia, y hable para sí mismo y para Dios.", "words": [[0, 215649], [2, 215778], [5, 215878], [8, 216038], [12, 216198], [24, 217278], [30, 217718], [33, 217798], [36, 217938], [45, 218438], [47, 218958], [53, 219258], [58, 219458], [61, 219658], [67, 220018], [69, 220098], [74, 220318]]}, {"verse": 29, "start": 221318, "end": 224896, "text": "Asimismo, los profetas hablen dos o tres, y los demás juzguen.", "words": [[0, 221318], [10, 221895], [14, 222015], [23, 222555], [30, 222935], [34, 223115], [36, 223255], [42, 223515], [44, 223835], [48, 223955], [54, 224175]]}, {"verse": 30, "start": 225346, "end": 229081, "text": "Y si a otro que está sentado, es revelado, el primero debe callar.", "words": [[0, 225346], [2, 225475], [5, 225615], [7, 225715], [12, 225935], [16, 226155], [21, 226395], [30, 226995], [33, 227195], [43, 227755], [46, 227915], [54, 228235], [59, 228495]]}, {"verse": 31, "start": 229531, "end": 235122, "text": "Porque podéis todos profetizar uno por uno, para que todos aprendan, y todos sean exhortados.", "words": [[0, 229531], [7, 229734], [14, 230154], [20, 230374], [31, 231174], [35, 231454], [39, 231674], [44, 231914], [49, 232414], [53, 232594], [59, 232814], [69, 233534], [71, 233714], [77, 233894], [82, 234254]]}, {"verse": 32, "start": 235572, "end": 239418, "text": "Y los espíritus de los que profetizan, sujétense a los profetas;", "words": [[0, 235572], [2, 235656], [6, 235776], [16, 236456], [19, 236556], [23, 236656], [27, 236816], [39, 237856], [49, 238376], [51, 238536], [55, 238656]]}, {"verse": 33, "start": 239868, "end": 245402, "text": "Porque Dios no es Dios de desorden, sino de paz; como en todas las iglesias de los santos.", "words": [[0, 239868], [7, 240051], [12, 240351], [15, 240671], [18, 240831], [23, 241091], [26, 241271], [36, 242011], [41, 242231], [44, 242411], [49, 243219], [54, 243401], [57, 243581], [63, 243721], [67, 244041], [76, 244501], [79, 244601], [83, 244721]]}, {"verse": 34, "start": 245852, "end": 252917, "text": "Vuestras mujeres callen en las congregaciones; porque no les es permitido hablar, sino que estén sujetas, como también la ley dice.", "words": [[0, 245852], [9, 246176], [17, 246476], [24, 247016], [27, 247096], [31, 247216], [47, 248554], [54, 248719], [57, 248899], [61, 249059], [64, 249179], [74, 249719], [82, 250339], [87, 250499], [91, 250679], [97, 250959], [106, 251559], [111, 251779], [119, 252139], [122, 252279], [126, 252459]]}, {"verse": 35, "start": 253367, "end": 260879, "text": "Y si quieren aprender alguna cosa, pregunten en casa a sus maridos; porque cosa vergonzosa es hablar una mujer en la congregación.", "words": [[0, 253367], [2, 253470], [5, 253570], [13, 253830], [22, 254210], [29, 254530], [35, 255270], [45, 255710], [48, 255870], [53, 256090], [55, 256290], [59, 256370], [68, 257312], [75, 257540], [80, 257860], [91, 258560], [94, 258740], [101, 259020], [105, 259240], [111, 259600], [114, 259780], [117, 259880]]}, {"verse": 36, "start": 261329, "end": 265796, "text": "Qué, ¿ha salido de vosotros la palabra de Dios? ¿o a vosotros solos ha llegado?", "words": [[0, 261329], [5, 261451], [9, 261591], [16, 261991], [19, 262111], [28, 262571], [31, 262751], [39, 263051], [42, 263231], [48, 264040], [51, 264176], [53, 264276], [62, 264696], [68, 265136], [71, 265236]]}, {"verse": 37, "start": 266246, "end": 273500, "text": "Si alguno a su parecer, es profeta, o espiritual, reconozca lo que os escribo, porque son mandamientos del Señor.", "words": [[0, 266246], [3, 266381], [10, 266901], [12, 266981], [15, 267121], [24, 267581], [27, 267921], [36, 268521], [38, 268641], [50, 269761], [60, 270401], [63, 270541], [67, 270681], [70, 270801], [79, 271661], [86, 271881], [90, 272121], [103, 272761], [107, 273001]]}, {"verse": 38, "start": 273950, "end": 275430, "text": "Pero el que ignora, ignore.", "words": [[0, 273950], [5, 274069], [8, 274229], [12, 274329], [20, 274969]]}, {"verse": 39, "start": 275880, "end": 280236, "text": "Así que, hermanos, procurad profetizar; y no impidáis el hablar lenguas.", "words": [[0, 275880], [4, 276067], [9, 276247], [19, 276867], [28, 277467], [40, 278584], [42, 278686], [45, 278786], [54, 279266], [57, 279386], [64, 279586]]}, {"verse": 40, "start": 280686, "end": 282972, "text": "Pero hágase todo decentemente y con orden.", "words": [[0, 280686], [5, 280830], [12, 281210], [17, 281489], [30, 282249], [32, 282390], [36, 282530]]}]}