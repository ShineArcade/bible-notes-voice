{"book": "GEN", "chapter": 4, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 221524, "verses": [{"verse": 1, "start": 300, "end": 8133, "text": "Y conoció Adam a su mujer Eva, la cual concibió y parió a Caín, y dijo: He adquirido varón por Jehová.", "words": [[0, 300], [2, 401], [10, 1221], [15, 1681], [17, 1721], [20, 1881], [26, 2221], [31, 3121], [34, 3241], [39, 3441], [48, 4241], [50, 4361], [56, 4721], [58, 4841], [64, 5481], [66, 5561], [72, 6291], [75, 6431], [85, 7011], [91, 7411], [95, 7800]]}, {"verse": 2, "start": 8413, "end": 15874, "text": "Y después parió a su hermano Abel. Y fue Abel pastor de ovejas, y Caín fue labrador de la tierra.", "words": [[0, 8413], [2, 8556], [10, 8836], [16, 9276], [18, 9376], [21, 9456], [29, 9896], [35, 10589], [37, 10694], [41, 10874], [46, 11214], [53, 11574], [56, 11834], [64, 12794], [66, 13154], [71, 13694], [75, 14254], [84, 14994], [87, 15134], [90, 15254]]}, {"verse": 3, "start": 16224, "end": 22432, "text": "Y aconteció andando el tiempo, que Caín trajo del fruto de la tierra una ofrenda a Jehová.", "words": [[0, 16224], [2, 16350], [12, 17150], [20, 17830], [23, 17970], [31, 18337], [35, 18705], [40, 19065], [46, 19565], [50, 19785], [56, 20225], [59, 20345], [62, 20485], [69, 20825], [73, 21125], [81, 21725], [83, 21905]]}, {"verse": 4, "start": 22782, "end": 31000, "text": "Y Abel trajo también de los primogénitos de sus ovejas, y de su grasa. Y miró Jehová con agrado a Abel y a su ofrenda;", "words": [[0, 22782], [2, 23061], [7, 23341], [13, 23761], [21, 24121], [24, 24381], [28, 24521], [41, 25381], [44, 25521], [48, 25661], [56, 26201], [58, 26401], [61, 26521], [64, 26701], [71, 27571], [73, 27877], [78, 28221], [85, 28565], [89, 28909], [96, 29253], [98, 29433], [103, 29793], [105, 29993], [107, 30113], [110, 30273]]}, {"verse": 5, "start": 31350, "end": 39388, "text": "Pero no miró con agrado a Caín y a la ofrenda suya. Y se ensañó Caín en gran manera, y decayó su semblante.", "words": [[0, 31350], [5, 31495], [8, 31715], [13, 32035], [17, 32195], [24, 32675], [26, 32855], [31, 33315], [33, 33555], [35, 33635], [38, 33735], [46, 34255], [52, 35050], [54, 35168], [57, 35498], [64, 35828], [69, 36328], [72, 36588], [77, 36868], [85, 37428], [87, 37843], [94, 38383], [97, 38523]]}, {"verse": 6, "start": 39738, "end": 46108, "text": "Entonces Jehová dijo a Caín: ¿Por qué te has enfurecido, y por qué ha decaído tu semblante?", "words": [[0, 39738], [9, 40316], [16, 41316], [21, 41556], [23, 41756], [29, 42594], [34, 42723], [38, 42903], [41, 43063], [45, 43243], [57, 43943], [59, 44228], [63, 44428], [67, 44628], [70, 44748], [78, 45168], [81, 45328]]}, {"verse": 7, "start": 46694, "end": 56779, "text": "Si haces bien, ¿no serás enaltecido? y si no haces bien, el pecado está a la puerta: con todo esto, a ti será su deseo, y tú lo dominarás.", "words": [[0, 46694], [3, 46856], [9, 47176], [15, 47856], [19, 47996], [25, 48396], [37, 49773], [39, 49890], [42, 50030], [45, 50210], [51, 50450], [57, 51090], [60, 51190], [67, 51610], [72, 51890], [74, 52050], [77, 52090], [85, 53188], [89, 53309], [94, 53529], [100, 53989], [102, 54229], [105, 54369], [110, 54689], [113, 54909], [120, 55509], [122, 55949], [125, 56089], [128, 56229]]}, {"verse": 8, "start": 57343, "end": 65987, "text": "Y habló Caín a su hermano Abel: y aconteció que estando ellos en el campo, Caín se levantó contra su hermano Abel, y le mató.", "words": [[0, 57343], [2, 57486], [8, 57726], [13, 58246], [15, 58466], [18, 58606], [26, 59006], [32, 59779], [34, 59880], [44, 60500], [48, 60740], [56, 61100], [62, 61340], [65, 61640], [68, 61740], [75, 62720], [80, 63080], [83, 63260], [91, 63840], [98, 64120], [101, 64340], [109, 64760], [115, 65060], [117, 65300], [120, 65420]]}, {"verse": 9, "start": 66337, "end": 73913, "text": "Y Jehová dijo a Caín: ¿Dónde está Abel tu hermano? Y él respondió: No sé; ¿soy yo guarda de mi hermano?", "words": [[0, 66337], [2, 66626], [9, 66946], [14, 67246], [16, 67386], [22, 68207], [29, 68473], [34, 68779], [39, 69086], [42, 69186], [51, 70282], [53, 70464], [56, 70604], [67, 71599], [70, 71744], [74, 72288], [79, 72525], [82, 72665], [89, 72985], [92, 73105], [95, 73205]]}, {"verse": 10, "start": 74193, "end": 79839, "text": "Y él le dijo: ¿Qué has hecho? La voz de la sangre de tu hermano clama a mí desde la tierra.", "words": [[0, 74193], [2, 74360], [5, 74500], [8, 74660], [14, 75385], [19, 75513], [23, 75733], [30, 76658], [33, 76799], [37, 76999], [40, 77179], [43, 77279], [50, 77639], [53, 77799], [56, 77939], [64, 78439], [70, 78819], [72, 78939], [75, 79099], [81, 79299], [84, 79499]]}, {"verse": 11, "start": 80473, "end": 87237, "text": "Ahora pues, maldito seas tú de la tierra que abrió su boca para recibir la sangre de tu hermano de tu mano:", "words": [[0, 80473], [6, 80777], [12, 81477], [20, 82177], [25, 82457], [28, 82777], [31, 82937], [34, 83037], [41, 83417], [45, 83637], [51, 83937], [54, 84097], [59, 84437], [64, 84737], [72, 85137], [75, 85417], [82, 85777], [85, 85957], [88, 86077], [96, 86597], [99, 86637], [102, 86757]]}, {"verse": 12, "start": 87831, "end": 94502, "text": "Cuando labres la tierra, no te volverá a dar su fuerza: errante y extranjero serás en la tierra.", "words": [[0, 87831], [7, 88007], [14, 88487], [17, 88607], [25, 89407], [28, 89507], [31, 89647], [39, 90127], [41, 90167], [45, 90287], [48, 90447], [56, 91535], [64, 92067], [66, 92367], [77, 93219], [83, 93662], [86, 93842], [89, 93962]]}, {"verse": 13, "start": 95015, "end": 99609, "text": "Y dijo Caín a Jehová: Grande es mi iniquidad para ser perdonada.", "words": [[0, 95015], [2, 95142], [7, 95402], [12, 95922], [14, 96142], [22, 96889], [29, 97269], [32, 97509], [35, 97689], [45, 98269], [50, 98549], [54, 98769]]}, {"verse": 14, "start": 99959, "end": 110125, "text": "He aquí me echas hoy de la faz de la tierra, y de tu presencia me esconderé; y seré errante y extranjero en la tierra; y sucederá que cualquiera que me halle, me matará.", "words": [[0, 100000], [3, 100080], [8, 100300], [11, 100500], [17, 100840], [21, 101080], [24, 101220], [27, 101360], [31, 101600], [34, 101780], [37, 101880], [45, 102220], [47, 102760], [50, 102880], [53, 103000], [63, 103580], [66, 103760], [77, 104670], [79, 104773], [84, 105093], [92, 105513], [94, 105673], [105, 106333], [108, 106433], [111, 106533], [119, 107279], [121, 107405], [130, 108045], [134, 108165], [145, 108725], [149, 108865], [152, 109045], [159, 109405], [162, 109605]]}, {"verse": 15, "start": 110405, "end": 123267, "text": "Y le respondió Jehová: Cierto que cualquiera que mate a Caín, siete veces será castigado. Entonces Jehová puso señal en Caín, para que no lo hiriese cualquiera que le hallara.", "words": [[0, 110405], [2, 110550], [5, 110670], [15, 111350], [23, 112239], [30, 112643], [34, 112823], [45, 113363], [49, 113523], [54, 113843], [56, 114333], [62, 114823], [68, 115143], [74, 115623], [79, 116003], [90, 117365], [99, 117828], [106, 118528], [111, 118788], [117, 119328], [120, 119468], [126, 120028], [131, 120688], [135, 120848], [138, 121068], [141, 121398], [149, 121728], [160, 122348], [164, 122488], [167, 122628]]}, {"verse": 16, "start": 123617, "end": 129802, "text": "Y salió Caín de delante de Jehová, y habitó en tierra de Nod, al oriente de Edén.", "words": [[0, 123617], [2, 123718], [8, 124078], [13, 124518], [16, 124658], [24, 125098], [27, 125238], [35, 125758], [37, 125898], [44, 126318], [47, 126498], [54, 126758], [57, 127058], [62, 127758], [65, 127998], [73, 128498], [76, 128938]]}, {"verse": 17, "start": 130152, "end": 141187, "text": "Y conoció Caín a su mujer, la cual concibió y parió a Enoc: y edificó una ciudad, y llamó el nombre de la ciudad del nombre de su hijo, Enoc.", "words": [[0, 130152], [2, 130315], [10, 130845], [15, 131375], [17, 131575], [20, 131735], [27, 132735], [30, 132855], [35, 133035], [44, 133875], [46, 134115], [52, 134555], [54, 134895], [60, 135525], [62, 135815], [70, 136435], [74, 136615], [82, 137035], [84, 137475], [90, 137875], [93, 138075], [100, 138435], [103, 138615], [106, 138735], [113, 139015], [117, 139335], [124, 139615], [127, 139815], [130, 139975], [136, 140583]]}, {"verse": 18, "start": 141537, "end": 151460, "text": "Y a Enoc nació Irad, e Irad engendró a Mehujael, y Mehujael engendró a Metusael, y Metusael engendró a Lamec.", "words": [[0, 141537], [2, 141696], [4, 141896], [9, 142096], [15, 142636], [21, 143401], [23, 143521], [28, 144081], [37, 144641], [39, 145278], [49, 145916], [51, 146463], [60, 147009], [69, 147556], [71, 148236], [81, 148916], [83, 149383], [92, 149849], [101, 150316], [103, 150496]]}, {"verse": 19, "start": 151810, "end": 158562, "text": "Y tomó para sí Lamec dos mujeres; el nombre de la una fue Ada, y el nombre de la otra Zila.", "words": [[0, 151810], [2, 151918], [7, 152198], [12, 152338], [15, 152658], [21, 152978], [25, 153238], [34, 154434], [37, 154602], [44, 155022], [47, 155242], [50, 155402], [54, 155622], [58, 155942], [63, 156482], [65, 156797], [68, 156937], [75, 157297], [78, 157477], [81, 157597], [86, 158098]]}, {"verse": 20, "start": 158912, "end": 165073, "text": "Y Ada parió a Jabal, el cual fue padre de los que habitan en tiendas, y crían ganados.", "words": [[0, 158912], [2, 159057], [6, 159197], [12, 159657], [14, 159777], [21, 160677], [24, 160757], [29, 160997], [33, 161297], [39, 161777], [42, 162017], [46, 162137], [50, 162297], [58, 162717], [61, 162857], [70, 163537], [72, 163817], [78, 164217]]}, {"verse": 21, "start": 165423, "end": 172900, "text": "Y el nombre de su hermano fue Jubal, el cual fue padre de todos los que manejan arpa y órgano.", "words": [[0, 165423], [2, 165585], [5, 165745], [12, 166165], [15, 166365], [18, 166545], [26, 167045], [30, 167185], [37, 168265], [40, 168385], [45, 168585], [49, 168865], [55, 169345], [58, 169765], [64, 170145], [68, 170705], [72, 170865], [80, 171425], [85, 172025], [87, 172245]]}, {"verse": 22, "start": 173250, "end": 181965, "text": "Y Zila también parió a Tubal-caín, artífice de toda obra de bronce y de hierro: y la hermana de Tubal-caín fue Naama.", "words": [[0, 173389], [2, 173563], [7, 173736], [15, 174196], [21, 174656], [23, 174776], [35, 176016], [44, 176816], [47, 177016], [52, 177236], [57, 177536], [60, 177736], [67, 178196], [69, 178296], [72, 178356], [80, 179338], [82, 179508], [85, 179628], [93, 180028], [96, 180448], [107, 180868], [111, 181442]]}, {"verse": 23, "start": 182315, "end": 192121, "text": "Y dijo Lamec a sus mujeres: Ada y Zila, oíd mi voz; mujeres de Lamec, escuchad mi dicho: que varón mataré por mi herida, y joven por mi golpe:", "words": [[0, 182315], [2, 182444], [7, 183014], [13, 183584], [15, 183744], [19, 183884], [28, 185027], [32, 185167], [34, 185417], [40, 185667], [44, 185927], [47, 186047], [52, 186751], [60, 187130], [63, 187550], [70, 187970], [79, 188450], [82, 188570], [89, 189235], [93, 189332], [99, 189612], [106, 189972], [110, 190152], [113, 190312], [121, 190672], [123, 190972], [129, 191312], [133, 191492], [136, 191592]]}, {"verse": 24, "start": 192471, "end": 197528, "text": "Si siete veces será vengado Caín, Lamec en verdad setenta veces siete lo será.", "words": [[0, 192572], [3, 192678], [9, 192785], [15, 193185], [20, 193525], [28, 194025], [34, 194615], [40, 195205], [43, 195285], [50, 195725], [58, 196165], [64, 196515], [70, 196865], [73, 197105]]}, {"verse": 25, "start": 197808, "end": 211720, "text": "Y conoció de nuevo Adam a su mujer, la cual parió un hijo, y llamó su nombre Set: Porque Dios ( dijo ella ) me ha sustituido otra simiente en lugar de Abel, a quien mató Caín.", "words": [[0, 197808], [2, 197930], [10, 198550], [13, 198690], [19, 198790], [24, 198890], [26, 199450], [29, 199630], [36, 200570], [39, 200810], [44, 201010], [50, 201430], [53, 201670], [59, 201990], [61, 202245], [67, 202605], [70, 202785], [77, 203290], [82, 204127], [89, 204307], [94, 205411], [96, 205623], [101, 205836], [106, 206048], [108, 206426], [111, 206586], [114, 206726], [125, 207686], [130, 207986], [139, 208726], [142, 208986], [148, 209226], [151, 209506], [157, 210326], [159, 210426], [165, 210566], [170, 210966]]}, {"verse": 26, "start": 212000, "end": 221124, "text": "Y a Set también le nació un hijo, y llamó su nombre Enós. Entonces los hombres comenzaron a invocar el nombre de Jehová.", "words": [[0, 212000], [2, 212169], [4, 212375], [8, 212582], [16, 213182], [19, 213402], [25, 213802], [28, 214042], [34, 214322], [36, 214557], [42, 214897], [45, 215057], [52, 215457], [58, 216509], [67, 217513], [71, 217693], [79, 218073], [90, 218853], [92, 219133], [100, 219733], [103, 219913], [110, 220313], [113, 220513]]}]}