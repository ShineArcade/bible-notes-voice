{"book": "GEN", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 240631, "verses": [{"verse": 1, "start": 300, "end": 4740, "text": "Era entonces toda la tierra de una lengua y unas mismas palabras.", "words": [[0, 300], [4, 637], [13, 1257], [18, 1677], [21, 1897], [28, 2277], [31, 2477], [35, 2597], [42, 3077], [44, 3177], [49, 3357], [56, 3877]]}, {"verse": 2, "start": 5090, "end": 12034, "text": "Y aconteció que, cuando salieron de oriente, hallaron una llanura en la tierra de Sinar, y se establecieron allí.", "words": [[0, 5090], [2, 5215], [12, 5835], [17, 6035], [24, 6255], [33, 6815], [36, 6995], [45, 7495], [54, 8215], [58, 8495], [66, 8975], [69, 9095], [72, 9255], [79, 9535], [82, 9775], [89, 10135], [91, 10555], [94, 10695], [108, 11575]]}, {"verse": 3, "start": 12384, "end": 22636, "text": "Y dijeron los unos a los otros: Vaya, hagamos ladrillo y cozámoslo con fuego. Y les fue el ladrillo en lugar de piedra, y el asfalto en lugar de mezcla.", "words": [[0, 12384], [2, 12488], [10, 13008], [14, 13208], [19, 13528], [21, 13788], [25, 13968], [32, 14917], [38, 15235], [46, 15635], [55, 16135], [57, 16495], [67, 16855], [71, 17035], [78, 17826], [80, 17972], [84, 18112], [88, 18352], [91, 18632], [100, 19192], [103, 19352], [109, 19572], [112, 19812], [120, 20352], [122, 20532], [125, 20712], [133, 21272], [136, 21392], [142, 21652], [145, 21912]]}, {"verse": 4, "start": 22986, "end": 33505, "text": "Y dijeron: Vamos, edifiquémonos una ciudad y una torre, cuya cúspide llegue al cielo; y hagámonos un nombre, no sea que seamos esparcidos sobre la faz de toda la tierra.", "words": [[0, 22986], [2, 23113], [11, 23996], [18, 24293], [32, 25253], [36, 25413], [43, 25793], [45, 26053], [49, 26193], [56, 26733], [61, 27333], [69, 27813], [76, 28173], [79, 28253], [86, 28956], [88, 29056], [98, 29556], [101, 29696], [109, 30156], [112, 30256], [116, 30476], [120, 30636], [127, 31036], [138, 31736], [144, 32016], [147, 32176], [151, 32416], [154, 32616], [159, 32796], [162, 32976]]}, {"verse": 5, "start": 33785, "end": 39622, "text": "Y descendió Jehová para ver la ciudad y la torre que edificaban los hijos de los hombres.", "words": [[0, 33785], [2, 33891], [12, 34531], [19, 35051], [24, 35291], [28, 35531], [31, 35711], [38, 36071], [40, 36351], [43, 36451], [49, 36971], [53, 37211], [64, 37991], [68, 38231], [74, 38571], [77, 38771], [81, 38911]]}, {"verse": 6, "start": 39972, "end": 50586, "text": "Y dijo Jehová: He aquí el pueblo es uno, y todos estos tienen un lenguaje: y han comenzado a obrar, y nada los hará desistir ahora de lo que han pensado hacer.", "words": [[0, 39972], [2, 40326], [7, 40712], [15, 41316], [18, 41396], [23, 41616], [26, 41796], [33, 42116], [36, 42356], [41, 42636], [43, 43056], [49, 43336], [55, 43796], [62, 44236], [65, 44436], [75, 45562], [77, 45684], [81, 45804], [91, 46404], [93, 46464], [100, 47164], [102, 47244], [107, 47444], [111, 47664], [116, 47984], [125, 48524], [131, 48804], [134, 49024], [137, 49164], [141, 49304], [145, 49424], [153, 49924]]}, {"verse": 7, "start": 50936, "end": 58391, "text": "Ahora pues, descendamos, y confundamos allí sus lenguas, para que ninguno entienda el habla de su compañero.", "words": [[0, 50936], [6, 51260], [12, 51580], [25, 52700], [27, 53080], [39, 53820], [44, 54020], [48, 54240], [57, 54800], [62, 55340], [66, 55480], [74, 56060], [83, 56720], [86, 56920], [92, 57120], [95, 57300], [98, 57420]]}, {"verse": 8, "start": 58671, "end": 65392, "text": "Así los esparció Jehová desde allí sobre la faz de toda la tierra, y dejaron de edificar la ciudad.", "words": [[0, 58671], [4, 59269], [8, 59714], [17, 60158], [24, 60602], [30, 60762], [35, 61102], [41, 61402], [44, 61662], [48, 61922], [51, 62202], [56, 62382], [59, 62602], [67, 63022], [69, 63542], [77, 64002], [80, 64162], [89, 64602], [92, 64842]]}, {"verse": 9, "start": 65742, "end": 76355, "text": "Por esto fue llamado el nombre de ella Babel, porque allí confundió Jehová el lenguaje de toda la tierra, y desde allí los esparció sobre la faz de toda la tierra.", "words": [[0, 65742], [4, 65866], [9, 66086], [13, 66366], [21, 66686], [24, 66926], [31, 67266], [34, 67732], [39, 68199], [46, 68666], [53, 68986], [58, 69306], [68, 69856], [75, 70406], [78, 70606], [87, 71226], [90, 71386], [95, 71626], [98, 71866], [106, 72815], [108, 72945], [114, 73165], [119, 73525], [123, 73765], [132, 74425], [138, 74725], [141, 74945], [145, 75185], [148, 75385], [153, 75585], [156, 75805]]}, {"verse": 10, "start": 76705, "end": 85700, "text": "Estas son las generaciones de Sem: Sem, de edad de cien años, engendró a Arfaxad, dos años después del diluvio.", "words": [[0, 76705], [6, 77171], [10, 77391], [14, 77611], [27, 78391], [30, 78591], [35, 79300], [40, 79680], [43, 80160], [48, 80500], [51, 80680], [56, 80860], [62, 81520], [71, 82300], [73, 82520], [82, 83320], [86, 83860], [91, 84320], [99, 84680], [103, 84960]]}, {"verse": 11, "start": 86050, "end": 93131, "text": "Y vivió Sem, después que engendró a Arfaxad, quinientos años, y engendró hijos e hijas.", "words": [[0, 86050], [2, 86194], [8, 86554], [13, 86894], [21, 87674], [25, 88054], [34, 88394], [36, 88734], [45, 89307], [56, 89880], [62, 90599], [64, 91080], [73, 91779], [79, 92160], [81, 92520]]}, {"verse": 12, "start": 93481, "end": 98133, "text": "Y Arfaxad vivió treinta y cinco años, y engendró a Sala.", "words": [[0, 93749], [2, 94055], [10, 94362], [16, 94677], [24, 94992], [26, 95307], [32, 95622], [38, 96342], [40, 96922], [49, 97502], [51, 97622]]}, {"verse": 13, "start": 98483, "end": 106162, "text": "Y vivió Arfaxad, después que engendró a Sala, cuatrocientos tres años, y engendró hijos e hijas.", "words": [[0, 98483], [2, 98607], [8, 99207], [17, 99807], [25, 100227], [29, 100447], [38, 101087], [40, 101187], [46, 101767], [60, 102347], [65, 102927], [71, 103367], [73, 103867], [82, 104567], [88, 104987], [90, 105407]]}, {"verse": 14, "start": 106512, "end": 110295, "text": "Y vivió Sala treinta años, y engendró a Heber.", "words": [[0, 106512], [2, 106655], [8, 107022], [13, 107388], [21, 107755], [27, 108335], [29, 108935], [38, 109615], [40, 109981]]}, {"verse": 15, "start": 110645, "end": 117773, "text": "Y vivió Sala, después que engendró a Heber, cuatrocientos tres años, y engendró hijos e hijas.", "words": [[0, 110645], [2, 110790], [8, 111130], [14, 111510], [22, 111890], [26, 112170], [35, 112710], [37, 113230], [44, 113750], [58, 114270], [63, 114790], [69, 115770], [71, 115810], [80, 116350], [86, 116690], [88, 117090]]}, {"verse": 16, "start": 118123, "end": 122286, "text": "Y vivió Heber treinta y cuatro años, y engendró a Peleg.", "words": [[0, 118123], [2, 118408], [8, 118676], [14, 118944], [22, 119212], [24, 119480], [31, 119748], [37, 120588], [39, 120908], [48, 121508], [50, 121917]]}, {"verse": 17, "start": 122636, "end": 129843, "text": "Y vivió Heber, después que engendró a Peleg, cuatrocientos treinta años, y engendró hijos e hijas.", "words": [[0, 122636], [2, 122757], [8, 123127], [15, 123497], [23, 123917], [27, 124177], [36, 124737], [38, 124837], [45, 125349], [59, 125860], [67, 126372], [73, 127072], [75, 127592], [84, 128312], [90, 128732], [92, 129112]]}, {"verse": 18, "start": 130193, "end": 134041, "text": "Y vivió Peleg treinta años, y engendró a Reu.", "words": [[0, 130193], [2, 130323], [8, 130730], [14, 131136], [22, 131543], [28, 132163], [30, 132643], [39, 133303], [41, 133523]]}, {"verse": 19, "start": 134391, "end": 141497, "text": "Y vivió Peleg, después que engendró a Reu, doscientos nueve años, y engendró hijos e hijas.", "words": [[0, 134391], [2, 134532], [8, 134892], [15, 135372], [23, 135817], [27, 136097], [36, 136717], [38, 136877], [43, 137470], [54, 138064], [60, 138657], [66, 139197], [68, 139557], [77, 140217], [83, 140557], [85, 140897]]}, {"verse": 20, "start": 141847, "end": 145803, "text": "Y Reu vivió treinta y dos años, y engendró a Serug.", "words": [[0, 141881], [2, 141956], [6, 142396], [12, 142636], [20, 142876], [22, 143116], [26, 143356], [32, 143996], [34, 144336], [43, 145016], [45, 145436]]}, {"verse": 21, "start": 146153, "end": 153269, "text": "Y vivió Reu, después que engendró a Serug, doscientos siete años, y engendró hijos e hijas.", "words": [[0, 146153], [2, 146282], [8, 146662], [13, 147182], [21, 147762], [25, 148002], [34, 148622], [36, 148998], [43, 149374], [54, 149751], [60, 150127], [66, 151167], [68, 151247], [77, 151847], [83, 152247], [85, 152627]]}, {"verse": 22, "start": 153619, "end": 157496, "text": "Y vivió Serug treinta años, y engendró a Nacor.", "words": [[0, 153619], [2, 153745], [8, 154085], [14, 154495], [22, 154905], [28, 155665], [30, 156130], [39, 156600], [41, 157069]]}, {"verse": 23, "start": 157846, "end": 165773, "text": "Y vivió Serug, después que engendró a Nacor, doscientos años, y engendró hijos e hijas.", "words": [[0, 157846], [2, 157972], [8, 158402], [15, 158832], [23, 159652], [27, 160052], [36, 160527], [38, 161002], [45, 161477], [56, 161952], [62, 162792], [64, 163432], [73, 164152], [79, 164552], [81, 165032]]}, {"verse": 24, "start": 166123, "end": 169769, "text": "Y vivió Nacor veintinueve años, y engendró a Taré.", "words": [[0, 166123], [2, 166248], [8, 166695], [14, 167141], [26, 167588], [32, 168208], [34, 168688], [43, 169248], [45, 169368]]}, {"verse": 25, "start": 170119, "end": 176746, "text": "Y vivió Nacor, después que engendró a Taré, ciento diecinueve años, y engendró hijos e hijas.", "words": [[0, 170119], [2, 170264], [8, 170644], [15, 171024], [23, 171404], [27, 171564], [36, 172064], [38, 172184], [44, 172784], [51, 173384], [62, 173984], [68, 174544], [70, 174829], [79, 175429], [85, 175749], [87, 176089]]}, {"verse": 26, "start": 177096, "end": 182169, "text": "Y vivió Taré setenta años, y engendró a Abram, y a Nacor, y a Harán.", "words": [[0, 177224], [2, 177384], [8, 177544], [13, 177904], [21, 178264], [27, 178764], [29, 179137], [38, 179511], [40, 179884], [47, 180504], [49, 180798], [51, 181092], [58, 181386], [60, 181647], [62, 181908]]}, {"verse": 27, "start": 182519, "end": 191005, "text": "Estas son las generaciones de Taré: Taré engendró a Abram, y a Nacor, y a Harán; y Harán engendró a Lot.", "words": [[0, 182519], [6, 182884], [10, 183064], [14, 183224], [27, 183944], [30, 184144], [36, 184775], [41, 184997], [50, 185897], [52, 186077], [59, 187697], [61, 188157], [63, 188319], [70, 188482], [72, 188644], [74, 188807], [81, 189135], [83, 189405], [89, 189675], [98, 190375], [100, 190535]]}, {"verse": 28, "start": 191355, "end": 198361, "text": "Y murió Harán antes que su padre Taré en la tierra donde nació, en Ur de los caldeos.", "words": [[0, 191355], [2, 191502], [8, 191982], [14, 192462], [20, 193022], [24, 193462], [27, 193622], [33, 193982], [38, 194502], [41, 194662], [44, 194782], [51, 195082], [57, 195542], [64, 196762], [67, 197002], [70, 197182], [73, 197342], [77, 197462]]}, {"verse": 29, "start": 198711, "end": 211655, "text": "Y tomaron Abram y Nacor para sí mujeres: el nombre de la mujer de Abram fue Sarai, y el nombre de la mujer de Nacor, Milca, hija de Harán, padre de Milca y de Isca.", "words": [[0, 198711], [2, 198808], [10, 199198], [16, 199588], [18, 199978], [24, 200368], [29, 200588], [32, 200768], [41, 201754], [44, 201902], [51, 202242], [54, 202462], [57, 202582], [63, 202982], [66, 203292], [72, 203602], [76, 203942], [83, 205002], [85, 205342], [88, 205482], [95, 205842], [98, 206062], [101, 206162], [107, 206422], [110, 206662], [117, 207522], [124, 208382], [129, 208682], [132, 209202], [139, 209722], [145, 209982], [148, 210342], [154, 210702], [156, 210922], [159, 211313]]}, {"verse": 30, "start": 212005, "end": 215710, "text": "Mas Sarai fue estéril, y no tenía hijo.", "words": [[0, 212005], [4, 212349], [10, 213109], [14, 213369], [23, 214109], [25, 214589], [28, 214729], [34, 215069]]}, {"verse": 31, "start": 216060, "end": 233928, "text": "Y tomó