{"book": "JHN", "chapter": 6, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 518043, "verses": [{"verse": 1, "start": 300, "end": 6799, "text": "Pasadas estas cosas, Jesús fue al otro lado del mar de Galilea, que es de Tiberias.", "words": [[0, 300], [8, 788], [14, 1088], [21, 2128], [27, 2588], [31, 2993], [34, 3293], [39, 3533], [44, 3873], [48, 4153], [52, 4606], [55, 5060], [64, 5513], [68, 5553], [71, 5793], [74, 5933]]}, {"verse": 2, "start": 7149, "end": 12250, "text": "Y le seguía grande multitud, porque veían sus señales que hacía en los enfermos.", "words": [[0, 7149], [2, 7234], [5, 7354], [12, 7834], [19, 8394], [29, 8954], [36, 9534], [42, 10054], [46, 10254], [54, 10834], [58, 11001], [64, 11167], [67, 11334], [71, 11494]]}, {"verse": 3, "start": 12600, "end": 17516, "text": "Y subió Jesús a un monte, y se sentó allí con sus discípulos.", "words": [[0, 12600], [2, 12723], [8, 13123], [14, 13443], [16, 13743], [19, 13843], [26, 14303], [28, 15103], [31, 15223], [37, 15723], [42, 15943], [46, 16203], [50, 16463]]}, {"verse": 4, "start": 17866, "end": 21434, "text": "Y estaba cerca la Pascua, la fiesta de los judíos.", "words": [[0, 17866], [2, 18129], [9, 18409], [15, 18789], [18, 19049], [26, 19989], [29, 20069], [36, 20449], [39, 20589], [43, 20709]]}, {"verse": 5, "start": 21784, "end": 31411, "text": "Y como alzó Jesús los ojos, y vio que había venido a él grande multitud, dice a Felipe: ¿De dónde compraremos pan para que coman estos?", "words": [[0, 21784], [2, 21930], [7, 22230], [12, 22830], [18, 23130], [22, 23670], [28, 24490], [30, 24750], [34, 24950], [38, 25090], [44, 25290], [51, 25750], [53, 25850], [56, 25990], [63, 26330], [73, 27410], [78, 27730], [80, 27910], [88, 28661], [92, 28925], [98, 29125], [110, 29805], [114, 30165], [119, 30405], [123, 30565], [129, 30905]]}, {"verse": 6, "start": 31761, "end": 36327, "text": "Pero esto decía para probarle; porque él sabía lo que había de hacer.", "words": [[0, 31761], [5, 31941], [10, 32201], [16, 32861], [21, 33161], [31, 33971], [38, 34234], [41, 34534], [47, 34994], [50, 35154], [54, 35334], [60, 35574], [63, 35754]]}, {"verse": 7, "start": 36677, "end": 43534, "text": "Le respondió Felipe: Doscientos denarios de pan no les bastarán, para que cada uno de ellos tome un poco.", "words": [[0, 36677], [3, 36822], [13, 37562], [21, 38679], [32, 38869], [41, 39509], [44, 39689], [48, 39989], [51, 40229], [55, 40389], [65, 41029], [70, 41529], [74, 41689], [79, 41929], [83, 42209], [86, 42369], [92, 42629], [97, 42949], [100, 43049]]}, {"verse": 8, "start": 43814, "end": 48163, "text": "Le dice uno de sus discípulos, Andrés, hermano de Simón Pedro:", "words": [[0, 43814], [3, 43938], [8, 44218], [12, 44578], [15, 44738], [19, 44918], [31, 45818], [39, 46438], [47, 46918], [50, 47038], [56, 47418]]}, {"verse": 9, "start": 48363, "end": 54200, "text": "Un muchacho está aquí que tiene cinco panes de cebada y dos pececillos; ¿pero qué es esto entre tantos?", "words": [[0, 48363], [3, 48492], [12, 48932], [17, 49192], [22, 49432], [26, 49592], [32, 49832], [38, 50212], [44, 50692], [47, 50812], [54, 51292], [56, 51392], [60, 51937], [72, 52648], [78, 52774], [82, 52974], [85, 53114], [90, 53374], [96, 53534]]}, {"verse": 10, "start": 54480, "end": 64790, "text": "Entonces Jesús dijo: Haced recostar la gente. Y había mucha hierba en aquel lugar: y se recostaron como número de cinco mil varones.", "words": [[0, 54480], [9, 54996], [15, 55576], [21, 56571], [27, 56995], [36, 57735], [39, 57875], [46, 58744], [48, 58841], [54, 59001], [60, 59401], [67, 59981], [70, 60121], [76, 60421], [83, 61034], [85, 61254], [88, 61374], [99, 62154], [104, 62434], [111, 62934], [114, 63264], [120, 63594], [124, 64227]]}, {"verse": 11, "start": 65140, "end": 76614, "text": "Y tomó Jesús aquellos panes, y habiendo dado gracias, repartió a los discípulos, y los discípulos a los que estaban recostados: asimismo de los peces, cuanto querían.", "words": [[0, 65140], [2, 65264], [7, 65544], [13, 65844], [22, 66204], [29, 66904], [31, 67424], [40, 67724], [45, 67964], [54, 69224], [63, 69744], [65, 69824], [69, 69924], [81, 70644], [83, 71084], [87, 71224], [98, 71864], [100, 72244], [104, 72344], [108, 72444], [116, 72804], [128, 74424], [137, 74714], [140, 74834], [144, 74954], [151, 75404], [158, 75854]]}, {"verse": 12, "start": 76964, "end": 84593, "text": "Y como fueron saciados, dijo a sus discípulos: Recoged los pedazos que han quedado, porque no se pierda nada.", "words": [[0, 76964], [2, 77070], [7, 77270], [14, 77570], [24, 78650], [29, 79030], [31, 79250], [35, 79410], [47, 80519], [55, 81243], [59, 81443], [67, 82103], [71, 82203], [75, 82323], [84, 82863], [91, 83283], [94, 83523], [97, 83663], [104, 84063]]}, {"verse": 13, "start": 84943, "end": 93411, "text": "Recogieron pues, y llenaron doce cestas de pedazos de los cinco panes de cebada, que sobraron a los que habían comido.", "words": [[0, 84943], [11, 85568], [17, 85828], [19, 86208], [28, 86648], [33, 87128], [40, 87708], [43, 87808], [51, 88448], [54, 88568], [58, 88768], [64, 89268], [70, 89928], [73, 90048], [81, 90608], [85, 91148], [94, 91828], [96, 92068], [100, 92188], [104, 92328], [111, 92668]]}, {"verse": 14, "start": 93761, "end": 102235, "text": "Aquellos hombres entonces, cuando vieron la señal que Jesús había hecho, decían: Este verdaderamente es el profeta que había de venir al mundo.", "words": [[0, 93761], [9, 94180], [17, 94460], [27, 95380], [34, 95480], [41, 95900], [44, 96040], [50, 96460], [54, 96580], [60, 96860], [66, 97220], [73, 97860], [81, 98866], [86, 99106], [101, 99926], [104, 100226], [107, 100366], [115, 100806], [119, 100986], [125, 101186], [128, 101366], [134, 101566], [137, 101726]]}, {"verse": 15, "start": 102515, "end": 110813, "text": "Y entendiendo Jesús que habían de venir para arrebatarle, y hacerle rey, volvió a retirarse al monte, él solo.", "words": [[0, 102515], [2, 102658], [14, 103338], [20, 103738], [24, 104113], [31, 104353], [34, 104573], [40, 104833], [45, 105113], [58, 106193], [60, 106633], [68, 107153], [73, 107893], [80, 108373], [82, 108453], [92, 109073], [95, 109233], [102, 109723], [105, 110213]]}, {"verse": 16, "start": 111163, "end": 114986, "text": "Y como se hizo tarde, descendieron sus discípulos al mar;", "words": [[0, 111163], [2, 111249], [7, 111469], [10, 111669], [15, 111929], [22, 112769], [35, 113489], [39, 113709], [50, 114329], [53, 114549]]}, {"verse": 17, "start": 115336, "end": 124335, "text": "Y entrando en un barco, venían de la otra parte del mar hacia Capernaum. Y era ya oscuro, y Jesús no había venido a ellos.", "words": [[0, 115336], [2, 115520], [11, 116040], [14, 116200], [17, 116320], [24, 116840], [31, 117520], [34, 117660], [37, 117780], [42, 117920], [48, 118280], [52, 118560], [56, 118820], [62, 119260], [73, 120340], [75, 120608], [79, 120778], [82, 120948], [90, 121928], [92, 122028], [98, 122368], [101, 122928], [107, 123168], [114, 123648], [116, 123788]]}, {"verse": 18, "start": 124685, "end": 128385, "text": "Y levantábase el mar con un gran viento que soplaba.", "words": [[0, 124685], [2, 124815], [14, 125695], [17, 125915], [21, 126195], [25, 126495], [28, 126675], [33, 126875], [40, 127455], [44, 127615]]}, {"verse": 19, "start": 128735, "end": 138990, "text": "Y cuando hubieron navegado como veinticinco o treinta estadios, ven a Jesús que andaba sobre el mar, y se acercaba al barco: y tuvieron miedo.", "words": [[0, 128735], [2, 128977], [9, 129237], [18, 129697], [27, 130257], [32, 130727], [44, 131197], [46, 131597], [54, 131997], [64, 133137], [68, 133477], [70, 133777], [76, 134097], [80, 134437], [87, 134857], [93, 135177], [96, 135397], [101, 135657], [103, 136137], [106, 136277], [115, 136937], [118, 137117], [125, 137878], [127, 137998], [136, 138398]]}, {"verse": 20, "start": 139340, "end": 142973, "text": "Pero él les dijo: Yo soy; no tengáis miedo.", "words": [[0, 139340], [5, 139503], [8, 139923], [12, 140128], [18, 140857], [21, 141104], [26, 141736], [29, 141919], [37, 142359]]}, {"verse": 21, "start": 143323, "end": 150322, "text": "Ellos entonces quisieron recibirle en el barco: y de inmediato el barco llegó a la tierra donde iban.", "words": [[0, 143323], [6, 143721], [15, 144061], [25, 144801], [35, 145601], [38, 145821], [41, 145981], [48, 146868], [50, 147016], [53, 147096], [63, 147856], [66, 147996], [72, 148376], [78, 148616], [80, 148836], [83, 148936], [90, 149216], [96, 149596]]}, {"verse": 22, "start": 150672, "end": 165354, "text": "El día siguiente, la gente que estaba de la otra parte del mar, cuando vio que no había allí otra navecilla sino una, y que Jesús no había entrado con sus discípulos en ella, sino que sus discípulos se habían ido solos;", "words": [[0, 150672], [3, 150818], [7, 151018], [18, 151698], [21, 151798], [27, 152138], [31, 152358], [38, 152718], [41, 152918], [44, 153038], [49, 153238], [55, 153598], [59, 153878], [64, 154158], [71, 155018], [75, 155378], [79, 155538], [82, 155718], [88, 155958], [93, 156258], [98, 156558], [108, 157158], [113, 157418], [118, 158200], [120, 158324], [124, 158444], [130, 158864], [133, 159279], [139, 159519], [147, 160139], [151, 160319], [155, 160559], [166, 161299], [169, 161539], [175, 162239], [180, 162519], [184, 162739], [188, 162939], [199, 163859], [202, 164179], [209, 164459], [213, 164699]]}, {"verse": 23, "start": 165704, "end": 174019, "text": "Y que otras barcas habían arribado de Tiberias junto al lugar donde habían comido el pan después de haber el Señor dado gracias;", "words": [[0, 165704], [2, 165826], [6, 165946], [12, 166186], [19, 166826], [26, 167426], [35, 168086], [38, 168246], [47, 168846], [53, 169166], [56, 169466], [62, 169766], [68, 170086], [75, 170506], [82, 170946], [85, 171066], [89, 171306], [97, 171926], [100, 172146], [106, 172306], [109, 172506], [115, 172746], [120, 173126]]}, {"verse": 24, "start": 174369, "end": 183864, "text": "Cuando vio pues la gente que Jesús no estaba allí, ni sus discípulos, entraron ellos en las barcas, y vinieron a Capernaum buscando a Jesús.", "words": [[0, 174369], [7, 174570], [11, 174910], [16, 175110], [19, 175310], [25, 175610], [29, 175810], [35, 176150], [38, 176690], [45, 177070], [51, 177490], [54, 177910], [58, 178130], [70, 179310], [79, 179950], [85, 180270], [88, 180530], [92, 180650], [100, 181110], [102, 181490], [111, 181930], [113, 182130], [123, 182630], [132, 182950], [134, 183230]]}, {"verse": 25, "start": 184214, "end": 189206, "text": "Y hallándole de la otra parte del mar, le dijeron: Rabí, ¿cuándo llegaste acá?", "words": [[0, 184214], [2, 184547], [13, 184917], [16, 185097], [19, 185237], [24, 185437], [30, 185877], [34, 186117], [39, 186717], [42, 186917], [51, 187971], [57, 188121], [65, 188321], [74, 188781]]}, {"verse": 26, "start": 189486, "end": 200156, "text": "Les respondió Jesús, y dijo: De cierto, de cierto os digo, que me buscáis, no porque habéis visto las señales, sino porque comisteis el pan y os hartasteis.", "words": [[0, 189545], [4, 189635], [14, 190255], [21, 190555], [23, 190835], [29, 191878], [32, 192210], [40, 192542], [43, 192874], [50, 193206], [53, 193426], [59, 193686], [63, 193906], [66, 194046], [75, 194846], [78, 194926], [85, 195246], [92, 195506], [98, 195766], [102, 195966], [111, 196906], [116, 197126], [123, 197486], [133, 198106], [136, 198246], [140, 198546], [142, 198946], [145, 199106]]}, {"verse": 27, "start": 200506, "end": 211504, "text": "Trabajad no por la comida que perece, sino por la comida que a vida eterna permanece, la cual el Hijo del hombre os dará: porque a este señaló el Padre, que es Dios.", "words": [[0, 200684], [9, 200904], [12, 201384], [16, 201624], [19, 201764], [26, 202104], [30, 202324], [38, 203064], [43, 203364], [47, 203724], [50, 203884], [57, 204324], [61, 204564], [63, 204724], [68, 204884], [75, 205404], [86, 206564], [89, 206664], [94, 206864], [97, 207084], [102, 207384], [106, 207604], [113, 207924], [116, 208144], [122, 208870], [129, 209111], [131, 209271], [136, 209511], [143, 210111], [146, 210191], [153, 210631], [157, 210771], [160, 210911]]}, {"verse": 28, "start": 211854, "end": 215601, "text": "Y le dijeron: ¿Qué haremos para que obremos las obras de Dios?", "words": [[0, 211854], [2, 211978], [5, 212078], [14, 212995], [19, 213099], [27, 213539], [32, 213859], [36, 214039], [44, 214399], [48, 214599], [54, 214859], [57, 215099]]}, {"verse": 29, "start": 215881, "end": 223260, "text": "Respondió Jesús, y les dijo: Esta es la obra de Dios, que creáis en el que él ha enviado.", "words": [[0, 216258], [10, 216668], [17, 217008], [19, 217308], [23, 217468], [29, 218230], [34, 218613], [37, 218953], [40, 219433], [45, 219773], [48, 220013], [54, 220333], [58, 220953], [65, 221533], [68, 221773], [71, 221933], [75, 222113], [78, 222313], [81, 222453]]}, {"verse": 30, "start": 223610, "end": 229782, "text": "Le dijeron entonces: ¿Qué señal pues haces tú, para que veamos, y te creamos? ¿Qué obras?", "words": [[0, 223610], [3, 223755], [11, 224295], [21, 225372], [26, 225470], [32, 225990], [37, 226310], [43, 226610], [47, 226910], [52, 227190], [56, 227370], [64, 227790], [66, 228070], [69, 228210], [78, 229112], [83, 229232]]}, {"verse": 31, "start": 230132, "end": 236433, "text": "Nuestros padres comieron el maná en el desierto, como está escrito: Pan del cielo les dio a comer.", "words": [[0, 230132], [9, 230515], [16, 230815], [25, 231375], [28, 231575], [33, 231935], [36, 232055], [39, 232155], [49, 232855], [54, 233015], [59, 233215], [68, 234090], [72, 234273], [76, 234433], [82, 234813], [86, 235013], [90, 235233], [92, 235333]]}, {"verse": 32, "start": 236713, "end": 247901, "text": "Y Jesús les dijo: De cierto, de cierto os digo: No os dio Moisés pan del cielo; sino que mi Padre os da el verdadero pan del cielo.", "words": [[0, 236713], [2, 236837], [8, 237217], [12, 237537], [18, 238533], [21, 238850], [29, 239167], [32, 239484], [39, 239801], [42, 240101], [48, 240904], [51, 241010], [54, 241117], [58, 241417], [65, 241937], [69, 242202], [73, 242482], [80, 244688], [85, 244848], [89, 245048], [92, 245228], [98, 245548], [101, 245768], [104, 245908], [107, 246028], [117, 246648], [121, 246988], [125, 247228]]}, {"verse": 33, "start": 248251, "end": 253298, "text": "Porque el pan de Dios es aquel que descendió del cielo y da vida al mundo.", "words": [[0, 248251], [7, 248535], [10, 248735], [14, 249075], [17, 249315], [22, 249655], [25, 250015], [31, 250435], [35, 250535], [45, 251195], [49, 251355], [55, 251915], [57, 252118], [60, 252320], [65, 252500], [68, 252760]]}, {"verse": 34, "start": 253648, "end": 256871, "text": "Y le dijeron: Señor, danos siempre este pan.", "words": [[0, 253648], [2, 253772], [5, 253872], [14, 254789], [21, 255293], [27, 255553], [35, 255933], [40, 256413]]}, {"verse": 35, "start": 257151, "end": 267839, "text": "Y Jesús les dijo: Yo soy el pan de vida: el que a mí viene, nunca tendrá hambre; y el que en mí cree, no tendrá sed jamás.", "words": [[0, 257151], [2, 257275], [8, 257655], [12, 257975], [18, 258696], [21, 258940], [25, 259220], [28, 259540], [32, 259880], [35, 260160], [41, 260933], [44, 261097], [48, 261277], [50, 261397], [53, 261517], [60, 262297], [66, 262657], [73, 263277], [81, 264735], [83, 265055], [86, 265375], [90, 265535], [93, 265675], [96, 265835], [102, 266115], [105, 266555], [112, 266996], [116, 267436]]}, {"verse": 36, "start": 268189, "end": 271575, "text": "Pero os he dicho, que aunque me habéis visto, no creéis.", "words": [[0, 268189], [5, 268394], [8, 268634], [11, 268714], [18, 269114], [22, 269329], [29, 269489], [32, 269789], [39, 270069], [46, 270629], [49, 270749]]}, {"verse": 37, "start": 271925, "end": 276539, "text": "Todo lo que el Padre me da, vendrá a mí; y al que a mí viene, no le echo fuera.", "words": [[0, 271925], [5, 272049], [8, 272269], [12, 272369], [15, 272489], [21, 272849], [24, 272969], [28, 273149], [35, 273729], [37, 273829], [41, 274354], [43, 274501], [46, 274641], [50, 274801], [52, 274881], [55, 275001], [62, 275381], [65, 275641], [68, 275831], [73, 276021]]}, {"verse": 38, "start": 276889, "end": 284142, "text": "Porque he descendido del cielo, no para hacer mi voluntad, sino la voluntad del que me envió.", "words": [[0, 276889], [7, 277173], [10, 277553], [21, 278233], [25, 278433], [32, 278893], [35, 279713], [40, 279993], [46, 280373], [49, 280553], [59, 281293], [64, 281853], [67, 282193], [76, 282703], [80, 283213], [84, 283333], [87, 283513]]}, {"verse": 39, "start": 284492, "end": 293203, "text": "Y esta es la voluntad del que me envió, del Padre: Que todo lo que me da, no pierda de ello, sino que lo resucite en el día postrero.", "words": [[0, 284492], [2, 284849], [7, 285169], [10, 285409], [13, 285569], [22, 286189], [26, 286349], [30, 286529], [33, 286709], [40, 287229], [44, 287349], [51, 288201], [55, 288282], [60, 288562], [63, 288802], [67, 288942], [70, 289102], [74, 289302], [77, 289442], [84, 289862], [87, 290102], [93, 290342], [98, 290662], [102, 290842], [105, 291002], [114, 291682], [117, 291822], [120, 291962], [124, 292162]]}, {"verse": 40, "start": 293553, "end": 303442, "text": "Y esta es la voluntad del que me ha enviado: Que todo aquel que ve al Hijo, y cree en él, tenga vida eterna: y yo le resucitaré en el día postrero.", "words": [[0, 293553], [2, 293721], [7, 294161], [10, 294741], [13, 294881], [22, 295561], [26, 295761], [30, 295941], [33, 296101], [36, 296201], [45, 297154], [49, 297256], [54, 297496], [60, 297936], [64, 298036], [67, 298216], [70, 298356], [76, 298576], [78, 298756], [83, 298976], [86, 299196], [90, 299446], [96, 299696], [101, 299836], [109, 300795], [111, 300912], [114, 301092], [117, 301232], [128, 302172], [131, 302292], [134, 302452], [138, 302652]]}, {"verse": 41, "start": 303792, "end": 310386, "text": "Murmuraban entonces de él los judíos, porque había dicho: Yo soy el pan que descendí del cielo.", "words": [[0, 303792], [11, 304518], [20, 304998], [23, 305378], [26, 305578], [30, 305698], [38, 306338], [45, 306678], [51, 306958], [58, 307761], [61, 307946], [65, 308166], [68, 308406], [72, 308686], [76, 308926], [85, 309606], [89, 309746]]}, {"verse": 42, "start": 310736, "end": 319494, "text": "Y decían: ¿No es este Jesús, el hijo de José, cuyo padre y madre nosotros conocemos? ¿cómo, pues, dice este: Del cielo he descendido?", "words": [[0, 310736], [2, 311213], [10, 311921], [14, 312085], [17, 312285], [22, 312505], [29, 313265], [32, 313345], [37, 313565], [40, 313665], [46, 314245], [51, 314465], [57, 314825], [59, 314905], [65, 315185], [74, 315405], [85, 316641], [92, 316805], [98, 317125], [103, 317385], [109, 318145], [113, 318308], [119, 318628], [122, 318808]]}, {"verse": 43, "start": 319774, "end": 324357, "text": "Y Jesús respondió, y les dijo: No murmuréis entre vosotros.", "words": [[0, 319774], [2, 319897], [8, 320237], [19, 321197], [21, 321437], [25, 321557], [31, 322355], [34, 322541], [44, 323181], [50, 323481]]}, {"verse": 44, "start": 324707, "end": 331747, "text": "Ninguno puede venir a mí, si el Padre que me envió no le trae; y yo le resucitaré en el día postrero.", "words": [[0, 324707], [8, 325255], [14, 325475], [20, 325875], [22, 326015], [26, 326375], [29, 326655], [32, 326815], [38, 327115], [42, 327355], [45, 327515], [51, 327875], [54, 328195], [57, 328335], [63, 329100], [65, 329218], [68, 329398], [71, 329538], [82, 330478], [85, 330598], [88, 330758], [92, 330958]]}, {"verse": 45, "start": 332097, "end": 340552, "text": "Escrito está en los profetas: Y serán todos enseñados de Dios. Así que, todo aquel que oyó del Padre, y aprendió, viene a mí.", "words": [[0, 332097], [8, 332536], [13, 332816], [16, 332956], [20, 333056], [30, 334093], [32, 334220], [38, 334600], [44, 335040], [54, 335860], [57, 336020], [63, 336764], [67, 336929], [72, 337109], [77, 337329], [83, 337749], [87, 337959], [91, 338169], [95, 338289], [102, 338669], [104, 338969], [114, 339549], [120, 340009], [122, 340269]]}, {"verse": 46, "start": 340902, "end": 347334, "text": "No que alguno haya visto al Padre, sino aquel que vino de Dios, este ha visto al Padre.", "words": [[0, 340902], [3, 341071], [7, 341231], [14, 341691], [19, 341811], [25, 342131], [28, 342311], [35, 343211], [40, 343481], [46, 343751], [50, 343871], [55, 344091], [58, 344291], [64, 345111], [69, 345391], [72, 345531], [78, 345731], [81, 345911]]}, {"verse": 47, "start": 347684, "end": 353070, "text": "De cierto, de cierto os digo: El que cree en mí, tiene vida eterna.", "words": [[0, 347959], [3, 348276], [11, 348593], [14, 348910], [21, 349227], [24, 349527], [30, 350257], [33, 350510], [37, 350796], [42, 351083], [45, 351263], [49, 351483], [55, 352003], [60, 352323]]}, {"verse": 48, "start": 353420, "end": 355019, "text": "Yo soy el pan de vida.", "words": [[0, 353420], [3, 353607], [7, 353847], [10, 354087], [14, 354327], [17, 354527]]}, {"verse": 49, "start": 355369, "end": 359182, "text": "Vuestros padres comieron el maná en el desierto, y han muerto.", "words": [[0, 355369], [9, 355751], [16, 356131], [25, 356671], [28, 356911], [33, 357311], [36, 357411], [39, 357531], [49, 358111], [51, 358331], [55, 358491]]}, {"verse": 50, "start": 359532, "end": 365237, "text": "Este es el pan que desciende del cielo, para que el que de él come, no muera.", "words": [[0, 359532], [5, 359858], [8, 360078], [11, 360238], [15, 360618], [19, 360858], [29, 361378], [33, 361598], [40, 362198], [45, 362738], [49, 362958], [52, 363278], [56, 363458], [59, 363678], [62, 363818], [68, 364238], [71, 364698]]}, {"verse": 51, "start": 365587, "end": 377288, "text": "Yo soy el pan vivo que he descendido del cielo: si alguno come de este pan, vivirá para siempre; y el pan que yo daré es mi carne, la cual yo daré por la vida del mundo.", "words": [[0, 365587], [3, 365772], [7, 365992], [10, 366252], [14, 366532], [19, 366932], [23, 367212], [26, 367372], [37, 368072], [41, 368252], [48, 369125], [51, 369262], [58, 369742], [63, 370002], [66, 370202], [71, 370382], [76, 370882], [83, 371482], [88, 371642], [97, 372517], [99, 372637], [102, 372777], [106, 373057], [110, 373277], [113, 373457], [118, 373857], [121, 374117], [124, 374297], [131, 375077], [134, 375317], [139, 375497], [142, 375697], [147, 375997], [151, 376137], [154, 376297], [159, 376497], [163, 376737]]}, {"verse": 52, "start": 377638, "end": 384334, "text": "Entonces los judíos contendían entre sí, diciendo: ¿Cómo puede este darnos su carne a comer?", "words": [[0, 377638], [9, 378278], [13, 378878], [20, 379438], [31, 380278], [37, 380578], [41, 381318], [51, 382232], [57, 382452], [63, 382712], [68, 382972], [75, 383312], [78, 383512], [84, 383812], [86, 383952]]}, {"verse": 53, "start": 384614, "end": 395295, "text": "Y Jesús les dijo: De cierto, de cierto os digo: Si no coméis la carne del Hijo del hombre, y bebéis su sangre, no tendréis vida en vosotros.", "words": [[0, 384614], [2, 384738], [8, 385118], [12, 385438], [18, 386435], [21, 386752], [29, 387069], [32, 387386], [39, 387703], [42, 388003], [48, 388733], [51, 388913], [54, 389093], [61, 389553], [64, 389753], [70, 390053], [74, 390353], [79, 390653], [83, 390813], [91, 391433], [93, 391693], [100, 392133], [103, 392293], [111, 393213], [114, 393313], [123, 393933], [128, 394233], [131, 394413]]}, {"verse": 54, "start": 395645, "end": 403177, "text": "El que come mi carne y bebe mi sangre, tiene vida eterna: y yo le resucitaré en el día postrero.", "words": [[0, 395645], [3, 395814], [7, 395974], [12, 396314], [15, 396534], [21, 397054], [23, 397394], [28, 397734], [31, 397894], [39, 398394], [45, 399054], [50, 399414], [58, 400530], [60, 400648], [63, 400828], [66, 400968], [77, 401908], [80, 402028], [83, 402188], [87, 402388]]}, {"verse": 55, "start": 403527, "end": 408165, "text": "Porque mi carne es verdadera comida, y mi sangre es verdadera bebida.", "words": [[0, 403527], [7, 403690], [10, 403910], [16, 404230], [19, 404490], [29, 405130], [37, 405450], [39, 405770], [42, 405890], [49, 406310], [52, 406610], [62, 407490]]}, {"verse": 56, "start": 408515, "end": 414051, "text": "El que come mi carne y bebe mi sangre, en mí permanece, y yo en él.", "words": [[0, 408515], [3, 408676], [7, 408816], [12, 409136], [15, 409356], [21, 409816], [23, 410256], [28, 410556], [31, 410696], [39, 411776], [42, 411896], [45, 412096], [56, 412476], [58, 412856], [61, 413376], [64, 413736]]}, {"verse": 57, "start": 414401, "end": 421632, "text": "Como me envió el Padre viviente, y yo vivo por el Padre, asimismo el que me come, él también vivirá por mí.", "words": [[0, 414401], [5, 414567], [8, 414767], [14, 415087], [17, 415207], [23, 415467], [33, 416427], [35, 416547], [38, 416687], [43, 416927], [47, 417267], [50, 417387], [57, 418177], [66, 418967], [69, 419127], [73, 419247], [76, 419387], [82, 420147], [85, 420287], [93, 420647], [100, 421147], [104, 421307]]}, {"verse": 58, "start": 421982, "end": 432770, "text": "Este es el pan que descendió del cielo: no como vuestros padres comieron el maná, y han muerto: el que come de este pan, vivirá eternamente.", "words": [[0, 421982], [5, 422225], [8, 422385], [11, 422505], [15, 422785], [19, 423005], [29, 423625], [33, 423765], [40, 424650], [43, 424857], [48, 425137], [57, 425577], [64, 425997], [73, 426577], [76, 426797], [82, 427277], [84, 427957], [88, 428137], [96, 429122], [99, 429466], [103, 429626], [108, 429966], [111, 430206], [116, 430406], [121, 430806], [128, 431646]]}, {"verse": 59, "start": 433120, "end": 437483, "text": "Estas cosas dijo en la sinagoga, enseñando en Capernaum.", "words": [[0, 433120], [6, 433302], [12, 434014], [17, 434347], [20, 434527], [23, 434647], [33, 435727], [43, 436507], [46, 437016]]}, {"verse": 60, "start": 437833, "end": 443694, "text": "Y muchos de sus discípulos oyéndolo, dijeron: Dura es esta palabra: ¿quién la puede oír?", "words": [[0, 437833], [2, 437942], [9, 438222], [12, 438462], [16, 438642], [27, 439262], [37, 439942], [46, 441042], [51, 441365], [54, 441605], [59, 441885], [68, 442685], [75, 442890], [78, 442970], [84, 443190]]}, {"verse": 61, "start": 443974, "end": 451156, "text": "Y sabiendo Jesús en sí mismo que sus discípulos murmuraban de esto, les dijo: ¿Esto os escandaliza?", "words": [[0, 443974], [2, 444097], [11, 444577], [17, 444937], [20, 445277], [23, 445477], [29, 445897], [33, 446097], [37, 446317], [48, 447057], [59, 447777], [62, 448037], [68, 448737], [72, 448877], [78, 449591], [84, 449916], [87, 450141]]}, {"verse": 62, "start": 451506, "end": 455470, "text": "¿Pues qué, si veis al Hijo del hombre que sube donde estaba primero?", "words": [[0, 451506], [6, 451778], [11, 451898], [14, 452038], [19, 452398], [22, 452538], [27, 452738], [31, 452958], [38, 453258], [42, 453458], [47, 454038], [53, 454418], [60, 454798]]}, {"verse": 63, "start": 455820, "end": 463670, "text": "El espíritu es el que da vida; la carne nada aprovecha: las palabras que yo os he hablado, son espíritu, y son vida.", "words": [[0, 455820], [3, 455946], [12, 456486], [15, 456586], [18, 456706], [22, 456846], [25, 456966], [31, 457699], [34, 457804], [40, 458184], [45, 458564], [56, 459777], [60, 459957], [69, 460337], [73, 460637], [76, 460897], [79, 461117], [82, 461237], [91, 461757], [95, 461997], [105, 462677], [107, 462797], [111, 462937]]}, {"verse": 64, "start": 464020, "end": 473411, "text": "Pero hay algunos de vosotros que no creen. Porque Jesús desde el principio sabía quiénes eran los que no creían, y quién le había de entregar.", "words": [[0, 464020], [5, 464360], [9, 464580], [17, 464920], [20, 465100], [29, 465480], [33, 465660], [36, 465800], [43, 466705], [50, 466910], [56, 467390], [62, 467890], [65, 468170], [75, 468770], [81, 469350], [89, 469890], [94, 470130], [98, 470370], [102, 470550], [105, 470730], [113, 471330], [115, 471810], [121, 472050], [124, 472270], [130, 472490], [133, 472710]]}, {"verse": 65, "start": 473761, "end": 479929, "text": "Y dijo: Por eso os he dicho que ninguno puede venir a mí, si no le es dado del Padre.", "words": [[0, 473761], [2, 473909], [8, 474602], [12, 474766], [16, 475006], [19, 475566], [22, 475806], [28, 476086], [32, 476226], [40, 476666], [46, 476946], [52, 477286], [54, 477426], [58, 477606], [61, 478146], [64, 478306], [67, 478486], [70, 478686], [75, 479006], [79, 479246]]}, {"verse": 66, "start": 480279, "end": 484936, "text": "Desde esto, muchos de sus discípulos volvieron atrás, y ya no andaban con él.", "words": [[0, 480279], [6, 480505], [12, 481005], [19, 481365], [22, 481585], [26, 481765], [37, 482345], [47, 482845], [54, 483165], [56, 483685], [59, 483865], [62, 484005], [70, 484425], [74, 484605]]}, {"verse": 67, "start": 485286, "end": 489749, "text": "Dijo entonces Jesús a los doce: ¿Queréis vosotros iros también?", "words": [[0, 485286], [5, 485594], [14, 486054], [20, 486474], [22, 486754], [26, 486894], [32, 487666], [41, 488073], [50, 488633], [55, 489053]]}, {"verse": 68, "start": 490099, "end": 496017, "text": "Y le respondió Simón Pedro: Señor, ¿a quién iremos? tú tienes palabras de vida eterna.", "words": [[0, 490099], [2, 490219], [5, 490339], [15, 490959], [21, 491359], [28, 492190], [35, 493005], [38, 493065], [44, 493205], [52, 494093], [55, 494190], [62, 494430], [71, 494850], [74, 495150], [79, 495310]]}, {"verse": 69, "start": 496367, "end": 501582, "text": "Y nosotros creemos y conocemos que tú eres el Cristo, el Hijo de Dios viviente.", "words": [[0, 496367], [2, 496472], [11, 496752], [19, 497392], [21, 497552], [31, 498052], [35, 498272], [38, 498472], [43, 498672], [46, 498812], [54, 499672], [57, 499752], [62, 499972], [65, 500072], [70, 500312]]}, {"verse": 70, "start": 501862, "end": 508547, "text": "Jesús le respondió: ¿No he escogido yo a vosotros doce, y uno de vosotros es diablo?", "words": [[0, 501862], [6, 502151], [9, 502631], [20, 503494], [24, 503660], [27, 503900], [36, 504540], [39, 504740], [41, 504960], [50, 505440], [56, 506640], [58, 506760], [62, 506920], [65, 507040], [74, 507500], [77, 507820]]}, {"verse": 71, "start": 508897, "end": 517643, "text": "Y hablaba de Judas Iscariote, hijo de Simón, porque este era el que le había de entregar, el cual era uno de los doce.", "words": [[0, 508897], [2, 509043], [10, 509443], [13, 509583], [19, 509903], [30, 511403], [35, 511703], [38, 511883], [45, 512723], [52, 513123], [57, 513583], [61, 513903], [64, 514103], [68, 514263], [71, 514423], [77, 514683], [80, 514883], [90, 515763], [93, 515923], [98, 516143], [102, 516463], [106, 516743], [109, 516903], [113, 517063]]}]}