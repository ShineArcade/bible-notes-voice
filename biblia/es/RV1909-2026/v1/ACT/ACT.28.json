{"book": "ACT", "chapter": 28, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 302390, "verses": [{"verse": 1, "start": 300, "end": 5289, "text": "Y cuando escapamos, entonces supimos que la isla se llamaba Malta.", "words": [[0, 300], [2, 401], [9, 581], [20, 1221], [29, 1801], [37, 2841], [41, 3041], [44, 3201], [49, 3621], [52, 4021], [60, 4481]]}, {"verse": 2, "start": 5739, "end": 17919, "text": "Y los habitantes de la isla nos mostraron no poca humanidad; porque, encendido un fuego, nos recibieron a todos, a causa de la lluvia que venía, y del frío.", "words": [[0, 5739], [2, 5845], [6, 5965], [17, 6665], [20, 6825], [23, 6965], [28, 7385], [32, 7805], [42, 8565], [45, 8945], [50, 9405], [61, 10595], [69, 10840], [79, 11820], [82, 12020], [89, 12500], [93, 13140], [104, 13880], [106, 14020], [113, 14440], [115, 15000], [121, 15320], [124, 15540], [127, 15660], [134, 16040], [138, 16160], [145, 16680], [147, 17140], [151, 17300]]}, {"verse": 3, "start": 18369, "end": 28785, "text": "Entonces habiendo Pablo recogido algunas ramas, y habiéndolas puesto en el fuego, una víbora, huyendo del calor, le acometió a la mano.", "words": [[0, 18369], [9, 18971], [18, 19331], [24, 19751], [33, 20531], [41, 20831], [48, 21891], [50, 22251], [62, 22731], [69, 23231], [72, 23551], [75, 23671], [82, 24491], [86, 24651], [94, 25511], [102, 25951], [106, 26191], [113, 27011], [116, 27151], [125, 27911], [127, 28111], [130, 28191]]}, {"verse": 4, "start": 29235, "end": 43233, "text": "Y como los habitantes de la isla vieron la víbora colgando de su mano, decían los unos a los otros: Ciertamente este hombre es homicida, a quien, escapado del mar, la justicia no deja vivir.", "words": [[0, 29235], [2, 29359], [7, 29599], [11, 29759], [22, 30399], [25, 30559], [28, 30699], [33, 31059], [40, 31379], [43, 31579], [50, 32119], [59, 32659], [62, 32879], [65, 33059], [71, 34039], [78, 34639], [82, 34859], [87, 35199], [89, 35559], [93, 35759], [100, 36708], [112, 37442], [117, 37822], [124, 38202], [127, 38562], [137, 39562], [139, 39642], [146, 40182], [155, 40702], [159, 40902], [164, 41562], [167, 41642], [176, 42202], [179, 42422], [184, 42682]]}, {"verse": 5, "start": 43583, "end": 47822, "text": "Pero él, sacudiendo la víbora en el fuego, ningún mal padeció.", "words": [[0, 43583], [5, 43750], [9, 44370], [20, 45010], [23, 45190], [30, 45610], [33, 45750], [36, 45890], [43, 46450], [50, 46750], [54, 47110]]}, {"verse": 6, "start": 48272, "end": 60984, "text": "Pero ellos estaban esperando cuándo se había de hinchar, o caer muerto de repente; pero habiendo esperado mucho, y viendo que ningún mal le venía, cambiando de parecer, decían que era un dios.", "words": [[0, 48272], [5, 48419], [11, 48819], [19, 49539], [29, 49999], [36, 50339], [39, 50579], [45, 50779], [48, 50939], [57, 51459], [59, 51939], [64, 52279], [71, 52759], [74, 52919], [83, 53956], [88, 54098], [97, 54478], [106, 54918], [113, 55218], [115, 55358], [122, 55598], [126, 55758], [133, 56098], [137, 56538], [140, 56738], [147, 57718], [157, 58318], [160, 58478], [169, 59378], [176, 59938], [180, 60138], [184, 60278], [187, 60438]]}, {"verse": 7, "start": 61434, "end": 71420, "text": "En aquellos lugares había propiedades del principal de la isla, llamado Publio, el cual nos recibió y hospedó tres días con amabilidad.", "words": [[0, 61434], [3, 61558], [12, 61798], [20, 62338], [26, 62678], [38, 63418], [42, 63638], [52, 64158], [55, 64458], [58, 64598], [64, 65258], [72, 65658], [80, 66798], [83, 66898], [88, 67118], [92, 67358], [100, 68278], [102, 68558], [110, 69018], [115, 69338], [120, 69778], [124, 70138]]}, {"verse": 8, "start": 71870, "end": 84130, "text": "Y aconteció que el padre de Publio estaba en cama, enfermo de fiebres y de disentería: al cual Pablo entró, y después de haber orado, le puso las manos encima, y le sanó:", "words": [[0, 71870], [2, 71974], [12, 72674], [16, 72854], [19, 72994], [25, 73294], [28, 73574], [35, 73854], [42, 74114], [45, 74334], [51, 75194], [59, 75734], [62, 75854], [70, 76334], [72, 76514], [75, 76634], [87, 77919], [90, 78207], [95, 78367], [101, 78847], [108, 79547], [110, 79827], [118, 80127], [121, 80327], [127, 80507], [134, 80987], [137, 81407], [142, 81727], [146, 81887], [152, 82167], [160, 82827], [162, 83270], [165, 83713]]}, {"verse": 9, "start": 84580, "end": 90900, "text": "Y esto hecho, también los otros que en la isla tenían enfermedades, llegaban, y eran sanados:", "words": [[0, 84580], [2, 84716], [7, 84996], [14, 85416], [22, 85736], [26, 85996], [32, 86316], [36, 86556], [39, 86696], [42, 86836], [47, 87156], [54, 87496], [68, 88496], [78, 89376], [80, 89916], [85, 90116]]}, {"verse": 10, "start": 91350, "end": 98598, "text": "Los cuales también nos honraron con muchos obsequios; y cuando partimos, nos cargaron de las cosas necesarias.", "words": [[0, 91350], [4, 91455], [11, 91635], [19, 91995], [23, 92535], [32, 93075], [36, 93235], [43, 93595], [54, 94789], [56, 95009], [63, 95209], [73, 96189], [77, 96369], [86, 96929], [89, 97049], [93, 97189], [99, 97489]]}, {"verse": 11, "start": 99048, "end": 109712, "text": "Así que, pasados tres meses, navegamos en una nave alejandrina que había invernado en la isla, la cual tenía como emblema a Cástor y Pólux.", "words": [[0, 99048], [4, 99309], [9, 99589], [17, 100069], [22, 100349], [29, 101269], [39, 101849], [42, 102069], [46, 102249], [51, 102589], [63, 103589], [67, 103789], [73, 104109], [83, 105029], [86, 105149], [89, 105309], [95, 106149], [98, 106289], [103, 106489], [109, 106929], [114, 107209], [122, 107909], [124, 108069], [131, 108729], [133, 109258]]}, {"verse": 12, "start": 110162, "end": 114353, "text": "Y llegados a Siracusa, estuvimos allí tres días.", "words": [[0, 110162], [2, 110466], [11, 110966], [13, 111166], [23, 112406], [33, 113126], [38, 113346], [43, 113646]]}, {"verse": 13, "start": 114803, "end": 124197, "text": "De allí, costeando alrededor, vinimos a Regio; y otro día después, soplando el sur, vinimos al segundo día a Puteoli:", "words": [[0, 114803], [3, 114947], [9, 115407], [19, 116007], [30, 116907], [38, 117217], [40, 117527], [47, 118498], [49, 118642], [54, 118822], [58, 119142], [67, 120002], [76, 120582], [79, 120742], [84, 121402], [92, 122062], [95, 122282], [103, 122622], [107, 123062], [109, 123661]]}, {"verse": 14, "start": 124647, "end": 132397, "text": "Donde habiendo hallado hermanos, nos rogaron que quedásemos con ellos siete días; y luego vinimos a Roma;", "words": [[0, 124647], [6, 124892], [15, 125592], [23, 126052], [33, 126672], [37, 127192], [45, 127992], [49, 128152], [60, 128812], [64, 129032], [70, 129232], [76, 129632], [82, 130740], [84, 130865], [90, 131085], [98, 131665], [100, 131805]]}, {"verse": 15, "start": 132847, "end": 145625, "text": "De donde, oyendo de nosotros los hermanos, nos salieron a recibir hasta la plaza de Apio, y Las Tres Tabernas: a los cuales como Pablo vio, dio gracias a Dios, y tomó aliento.", "words": [[0, 132847], [3, 133010], [10, 133710], [17, 134330], [20, 134510], [29, 134990], [33, 135250], [43, 136130], [47, 136210], [56, 136710], [58, 136850], [66, 137270], [72, 137550], [75, 137670], [81, 137970], [84, 138130], [90, 138470], [92, 138830], [96, 138970], [101, 139170], [111, 140359], [113, 140451], [117, 140571], [124, 141071], [129, 141191], [135, 141591], [140, 142631], [144, 142911], [152, 143351], [154, 143691], [160, 143951], [162, 144471], [167, 144851]]}, {"verse": 16, "start": 146075, "end": 157920, "text": "Y como llegamos a Roma, el centurión entregó los presos al prefecto de los ejércitos, pero a Pablo fue permitido estar por sí, con un soldado que le guardase.", "words": [[0, 146075], [2, 146201], [7, 146421], [16, 146941], [18, 147121], [24, 148361], [27, 148501], [37, 149201], [45, 149881], [49, 150021], [56, 150621], [59, 150861], [68, 151581], [71, 151681], [75, 151821], [86, 152861], [91, 153101], [93, 153261], [99, 153641], [103, 154201], [113, 154841], [119, 155061], [123, 155421], [127, 155741], [131, 156261], [134, 156401], [142, 156921], [146, 157041], [149, 157161]]}, {"verse": 17, "start": 158370, "end": 177331, "text": "Y aconteció que tres días después, Pablo convocó a los principales de los judíos; a los cuales, luego que estuvieron juntos, les dijo: Yo, varones hermanos, no habiendo hecho nada contra el pueblo, ni contra los ritos de la patria, he sido entregado preso desde Jerusalén en manos de los Romanos;", "words": [[0, 158370], [2, 158475], [12, 159195], [16, 159355], [21, 159615], [26, 159935], [35, 160375], [41, 161275], [49, 162035], [51, 162155], [55, 162255], [67, 162955], [70, 163075], [74, 163195], [82, 164201], [84, 164441], [88, 164541], [96, 164901], [102, 165661], [106, 165961], [117, 166441], [125, 167061], [129, 167241], [135, 167977], [139, 168160], [147, 168580], [157, 169420], [160, 169520], [169, 169880], [175, 170140], [180, 170420], [187, 170780], [190, 170940], [198, 171640], [201, 171800], [208, 172120], [212, 172300], [218, 172700], [221, 172800], [224, 172900], [232, 173720], [235, 173800], [240, 174000], [250, 174540], [256, 175000], [262, 175140], [272, 175920], [275, 176100], [281, 176320], [284, 176520], [288, 176600]]}, {"verse": 18, "start": 177781, "end": 183879, "text": "Los cuales, habiéndome examinado, me querían soltar, por no haber en mí ninguna causa de muerte.", "words": [[0, 177781], [4, 177886], [12, 178486], [23, 179006], [34, 180066], [37, 180146], [45, 180616], [53, 181086], [57, 181366], [60, 181546], [66, 181806], [69, 181986], [72, 182166], [80, 182686], [86, 183146], [89, 183366]]}, {"verse": 19, "start": 184329, "end": 190058, "text": "Pero contradiciendo los judíos, fui forzado a apelar a César; no que tenga de qué acusar a mi nación.", "words": [[0, 184329], [5, 184469], [20, 185209], [24, 185389], [32, 186109], [36, 186309], [44, 186849], [46, 186969], [53, 187289], [55, 187369], [62, 188096], [65, 188234], [69, 188374], [75, 188614], [78, 188754], [82, 188914], [89, 189334], [91, 189414], [94, 189474]]}, {"verse": 20, "start": 190508, "end": 197317, "text": "Así que, por esta causa, os he llamado para veros y hablaros; porque por la esperanza de Israel estoy rodeado de esta cadena.", "words": [[0, 190508], [4, 190690], [9, 190830], [13, 191010], [18, 191170], [25, 191590], [28, 191910], [31, 192130], [39, 192390], [44, 192690], [50, 193050], [52, 193170], [62, 194071], [69, 194254], [73, 194454], [76, 194554], [86, 194974], [89, 195094], [96, 195474], [102, 195774], [110, 196314], [113, 196514], [118, 196714]]}, {"verse": 21, "start": 197667, "end": 207930, "text": "Entonces ellos le dijeron: Nosotros ni hemos recibido cartas tocante a ti de Judea, ni ha venido alguno de los hermanos que haya denunciado o hablado algún mal de ti.", "words": [[0, 197667], [9, 198145], [15, 198925], [18, 199385], [27, 200383], [36, 200787], [39, 200987], [45, 201147], [54, 201787], [61, 202207], [69, 202607], [71, 202747], [74, 202827], [77, 202947], [84, 203547], [87, 203947], [90, 204047], [97, 204347], [104, 204727], [107, 204787], [111, 204907], [120, 205427], [124, 205547], [129, 205747], [140, 206467], [142, 206607], [150, 207007], [156, 207267], [160, 207487], [163, 207647]]}, {"verse": 22, "start": 208380, "end": 214398, "text": "Pero querríamos oír de ti lo que piensas; porque sabemos que en todas partes se habla contra esta secta.", "words": [[0, 208380], [5, 208746], [16, 209226], [20, 209586], [23, 209686], [26, 209866], [29, 209986], [33, 210106], [42, 211107], [49, 211317], [57, 211737], [61, 212057], [64, 212177], [70, 212337], [77, 212857], [80, 213097], [86, 213277], [93, 213597], [98, 213857]]}, {"verse": 23, "start": 214748, "end": 232626, "text": "Y habiéndole señalado un día, vinieron a él muchos a la posada, a los cuales declaraba y testificaba el reino de Dios, persuadiéndoles lo concerniente a Jesús, por la ley de Moisés y por los profetas, desde la mañana hasta la tarde.", "words": [[0, 214748], [2, 214867], [13, 215387], [22, 216027], [25, 216187], [30, 217027], [39, 217607], [41, 217767], [44, 217907], [51, 218247], [53, 218507], [56, 218587], [64, 219147], [66, 219367], [70, 219467], [77, 219767], [87, 220967], [89, 221107], [101, 221887], [104, 222047], [110, 222427], [113, 222567], [119, 223247], [135, 224367], [138, 225017], [151, 225667], [153, 225827], [160, 226748], [164, 226892], [167, 227052], [171, 227332], [174, 227472], [181, 227992], [183, 228552], [187, 228752], [191, 228912], [201, 230092], [207, 230652], [210, 230972], [217, 231372], [223, 231792], [226, 231992]]}, {"verse": 24, "start": 233076, "end": 238415, "text": "Y algunos asentían a lo que se decía, pero algunos no creían.", "words": [[0, 233076], [2, 233408], [10, 233728], [19, 234628], [21, 234868], [24, 234968], [28, 235088], [31, 235228], [38, 236188], [43, 236428], [51, 236928], [54, 237568]]}, {"verse": 25, "start": 238865, "end": 249293, "text": "Y como fueron entre sí discordes, se fueron, diciendo Pablo esta palabra: Bien ha hablado el Espíritu Santo por el profeta Isaías a nuestros padres,", "words": [[0, 238865], [2, 238989], [7, 239249], [14, 239649], [20, 240029], [23, 240349], [34, 241349], [37, 241789], [45, 242729], [54, 243189], [60, 243809], [65, 244089], [74, 245043], [79, 245259], [82, 245439], [90, 245819], [93, 245939], [102, 246459], [108, 246739], [112, 247019], [115, 247139], [123, 247579], [130, 248099], [132, 248279], [141, 248399]]}, {"verse": 26, "start": 249743, "end": 259457, "text": "Diciendo: Ve a este pueblo, y diles: De oído oiréis, y no entenderéis; y viendo veréis, y no percibiréis:", "words": [[0, 249743], [10, 250702], [13, 250882], [15, 251062], [20, 251342], [28, 251722], [30, 252222], [37, 253442], [40, 253604], [45, 254164], [53, 254724], [55, 255104], [58, 255284], [71, 256838], [73, 256956], [80, 257296], [88, 257776], [90, 258076], [93, 258236]]}, {"verse": 27, "start": 259757, "end": 273711, "text": "Porque el corazón de este pueblo se ha vuelto insensible, y de los oídos oyeron pesadamente, y sus ojos taparon; porque no vean con los ojos, y oigan con los oídos, y entiendan de corazón, y se conviertan, y yo los sane.", "words": [[0, 259757], [7, 259937], [10, 260057], [18, 260437], [21, 260637], [26, 260777], [33, 261157], [36, 261397], [39, 261477], [46, 261777], [58, 262457], [60, 263017], [63, 263117], [67, 263237], [73, 263697], [80, 264057], [93, 265037], [95, 265297], [99, 265437], [104, 265697], [113, 266693], [120, 266880], [123, 267100], [128, 267360], [132, 267500], [136, 267640], [142, 268000], [144, 268560], [150, 268840], [154, 269060], [158, 269220], [165, 270000], [167, 270160], [177, 270680], [180, 270800], [189, 271240], [191, 271760], [194, 271900], [206, 272640], [208, 272940], [211, 273080], [215, 273220]]}, {"verse": 28, "start": 274161, "end": 279942, "text": "Os sea pues notorio que a los Gentiles es enviada esta salvación de Dios: y ellos oirán.", "words": [[0, 274195], [3, 274265], [7, 274485], [12, 274685], [20, 275225], [24, 275385], [26, 275485], [30, 275565], [39, 276125], [42, 276425], [50, 276965], [55, 277265], [65, 277865], [68, 278005], [74, 278811], [76, 278952], [82, 279172]]}, {"verse": 29, "start": 280292, "end": 286591, "text": "Y habiendo dicho esto, los judíos salieron, teniendo entre sí gran contienda.", "words": [[0, 280292], [2, 280415], [11, 280835], [17, 281155], [23, 282135], [27, 282275], [34, 282855], [44, 284215], [53, 284735], [59, 285015], [62, 285295], [67, 285595]]}, {"verse": 30, "start": 287041, "end": 293152, "text": "Pablo quedó dos años enteros en su casa de alquiler, y recibía a todos los que a él venían,", "words": [[0, 287041], [6, 287453], [12, 287853], [16, 288113], [21, 288373], [29, 289033], [32, 289193], [35, 289333], [40, 289593], [43, 289813], [53, 290293], [55, 290673], [63, 291313], [65, 291513], [71, 291773], [75, 292033], [79, 292233], [81, 292313], [84, 292433]]}, {"verse": 31, "start": 293602, "end": 301990, "text": "Predicando el reino de Dios y enseñando lo que es del Señor Jesucristo con toda libertad, sin impedimento.", "words": [[0, 293602], [11, 294266], [14, 294406], [20, 294786], [23, 294926], [28, 295306], [30, 295826], [40, 296526], [43, 296706], [47, 296886], [50, 297066], [54, 297206], [60, 297506], [71, 298426], [75, 298666], [80, 298926], [90, 300086], [94, 300506]]}]}