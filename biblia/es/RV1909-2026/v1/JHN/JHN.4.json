{"book": "JHN", "chapter": 4, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 402761, "verses": [{"verse": 1, "start": 300, "end": 8098, "text": "De manera que como Jesús entendió que los fariseos habían oído que Jesús hacía y bautizaba más discípulos que Juan,", "words": [[0, 300], [3, 407], [10, 627], [14, 1027], [19, 1167], [25, 1487], [34, 2247], [38, 2367], [42, 2527], [51, 3187], [58, 3447], [63, 3907], [67, 4087], [73, 4427], [79, 5067], [81, 5247], [91, 5947], [95, 6207], [106, 7347], [110, 7487]]}, {"verse": 2, "start": 8448, "end": 12462, "text": "(Aunque Jesús no bautizaba, sino sus discípulos),", "words": [[0, 8448], [8, 8705], [14, 9105], [17, 9525], [28, 10625], [33, 10905], [37, 11525]]}, {"verse": 3, "start": 12812, "end": 15889, "text": "Salió de Judea y se fue otra vez a Galilea.", "words": [[0, 12812], [6, 13218], [9, 13338], [15, 13858], [17, 13958], [20, 14058], [24, 14298], [29, 14538], [33, 14898], [35, 15158]]}, {"verse": 4, "start": 16239, "end": 19008, "text": "Y era necesario que pasase por Samaria.", "words": [[0, 16239], [2, 16405], [6, 16565], [16, 17245], [20, 17445], [27, 17965], [31, 18205]]}, {"verse": 5, "start": 19358, "end": 27368, "text": "Vino, pues, a una ciudad de Samaria que se llamaba Sicar, junto a la parcela que Jacob dio a José su hijo.", "words": [[0, 19358], [6, 19624], [12, 20484], [14, 20724], [18, 20884], [25, 21184], [28, 21464], [36, 21964], [40, 22224], [43, 22384], [51, 23074], [58, 23764], [64, 24144], [66, 24364], [69, 24444], [77, 25004], [81, 25184], [87, 25564], [91, 26024], [93, 26164], [98, 26444], [101, 26744]]}, {"verse": 6, "start": 27718, "end": 35770, "text": "Y estaba allí la fuente de Jacob. Pues Jesús, cansado del camino, así se sentó a la fuente. Era como la hora de sexta.", "words": [[0, 27718], [2, 27823], [9, 28083], [14, 28403], [17, 28563], [24, 28963], [27, 29103], [34, 29937], [39, 30121], [46, 30841], [54, 31171], [58, 31501], [66, 32521], [70, 32701], [73, 32861], [79, 33281], [81, 33361], [84, 33421], [92, 34230], [96, 34415], [101, 34675], [104, 34855], [109, 35035], [112, 35195]]}, {"verse": 7, "start": 36120, "end": 41572, "text": "Vino una mujer de Samaria a sacar agua: y Jesús le dice: Dame de beber.", "words": [[0, 36120], [5, 36383], [9, 36663], [15, 36963], [18, 37163], [26, 37643], [28, 37883], [34, 38103], [40, 39038], [42, 39259], [48, 39579], [51, 39919], [57, 40613], [62, 40880], [65, 41244]]}, {"verse": 8, "start": 41922, "end": 45843, "text": "(Porque sus discípulos habían ido a la ciudad a comprar de comer.)", "words": [[0, 41922], [8, 42109], [12, 42349], [23, 43089], [30, 43369], [34, 43729], [36, 43869], [39, 43929], [46, 44269], [48, 44509], [56, 44989], [59, 45249]]}, {"verse": 9, "start": 46193, "end": 57131, "text": "Y la mujer samaritana le dice: ¿Cómo tú, siendo judío, me pides a mí de beber, que soy mujer samaritana? porque los judíos no se tratan con los samaritanos.", "words": [[0, 46193], [2, 46488], [5, 46588], [11, 46888], [22, 47748], [25, 47908], [31, 48671], [37, 48885], [41, 49125], [48, 49485], [55, 50425], [58, 50565], [64, 50905], [66, 51065], [69, 51225], [72, 51365], [79, 51665], [83, 52145], [87, 52385], [93, 52705], [105, 53967], [112, 54191], [116, 54391], [123, 54891], [126, 55051], [129, 55211], [136, 55711], [140, 55871], [144, 56071]]}, {"verse": 10, "start": 57481, "end": 69062, "text": "Respondió Jesús y le dijo: Si conocieses el don de Dios, y quién es el que te dice: Dame de beber: tú pedirías de él, y él te daría agua viva.", "words": [[0, 57481], [10, 58021], [16, 58441], [18, 58861], [21, 59001], [27, 59728], [30, 59893], [41, 60893], [44, 61053], [48, 61313], [51, 61533], [57, 61833], [59, 62193], [65, 62453], [68, 62793], [71, 63053], [75, 63213], [78, 63353], [84, 63922], [89, 64362], [92, 64740], [99, 65302], [102, 65406], [111, 66046], [114, 66306], [118, 66606], [120, 67426], [123, 67586], [126, 67726], [132, 68166], [137, 68486]]}, {"verse": 11, "start": 69412, "end": 77802, "text": "La mujer le dice: Señor, no tienes con qué sacarla, y el pozo es hondo: ¿de dónde, pues, tienes el agua viva?", "words": [[0, 69412], [3, 69501], [9, 69861], [12, 70361], [18, 71073], [25, 71854], [28, 71954], [35, 72394], [39, 72694], [43, 72854], [52, 73574], [54, 73749], [57, 73909], [62, 74229], [65, 74389], [72, 75224], [76, 75412], [83, 75692], [89, 76452], [96, 76712], [99, 76952], [104, 77152]]}, {"verse": 12, "start": 78152, "end": 85964, "text": "¿Eres tú mayor que nuestro padre Jacob, que nos dio este pozo, del cual él bebió, y sus hijos, y sus ganados?", "words": [[0, 78152], [6, 78372], [9, 78612], [15, 78952], [19, 79232], [27, 79432], [33, 79852], [40, 80772], [44, 80812], [48, 81012], [52, 81212], [57, 81472], [63, 82132], [67, 82732], [72, 83032], [75, 83252], [82, 84012], [84, 84292], [88, 84492], [95, 84832], [97, 85092], [101, 85232]]}, {"verse": 13, "start": 86244, "end": 92602, "text": "Respondió Jesús y le dijo: Cualquiera que bebe de esta agua, volverá a tener sed;", "words": [[0, 86244], [10, 86784], [16, 87204], [18, 87624], [21, 87764], [27, 88491], [38, 89221], [42, 89401], [47, 89741], [50, 89881], [55, 90141], [61, 90561], [69, 91581], [71, 91721], [77, 92001]]}, {"verse": 14, "start": 92952, "end": 103853, "text": "Pero el que beba del agua que yo le daré, no tendrá sed jamás; sino que el agua que yo le daré, será en él una fuente de agua que salte para vida eterna.", "words": [[0, 92952], [5, 93117], [8, 93277], [12, 93417], [17, 93717], [21, 93937], [26, 94197], [30, 94377], [33, 94557], [36, 94697], [42, 95157], [45, 95457], [52, 95857], [56, 96157], [63, 97308], [68, 97668], [72, 97908], [75, 98248], [80, 98528], [84, 98748], [87, 98968], [90, 99108], [96, 99548], [101, 99908], [104, 100228], [107, 100388], [111, 100708], [118, 101188], [121, 101368], [126, 101688], [130, 101908], [136, 102468], [141, 102728], [146, 103008]]}, {"verse": 15, "start": 104203, "end": 110428, "text": "La mujer le dice: Señor, dame esta agua, para que no tenga sed, ni venga acá a sacarla.", "words": [[0, 104203], [3, 104291], [9, 104651], [12, 105151], [18, 105864], [25, 106404], [30, 106664], [35, 106964], [41, 107364], [46, 107639], [50, 107779], [53, 107939], [59, 108179], [64, 108519], [67, 108959], [73, 109279], [77, 109559], [79, 109699]]}, {"verse": 16, "start": 110708, "end": 115071, "text": "Jesús le dice: Ve, llama a tu marido, y ven acá.", "words": [[0, 110708], [6, 111082], [9, 111562], [15, 112668], [19, 112968], [25, 113448], [27, 113668], [30, 113788], [38, 114268], [40, 114408], [44, 114508]]}, {"verse": 17, "start": 115421, "end": 122965, "text": "Respondió la mujer, y dijo: No tengo marido. Le dice Jesús: Bien has dicho, No tengo marido;", "words": [[0, 115421], [10, 116265], [13, 116425], [20, 116745], [22, 116945], [28, 117696], [31, 117863], [37, 118143], [45, 119107], [48, 119256], [53, 119476], [60, 120442], [65, 120849], [69, 120969], [76, 121829], [79, 121949], [85, 122249]]}, {"verse": 18, "start": 123315, "end": 130155, "text": "Porque cinco maridos has tenido: y el que ahora tienes no es tu marido; esto has dicho con verdad.", "words": [[0, 123315], [7, 123518], [13, 123858], [21, 124498], [25, 124798], [33, 125725], [35, 125882], [38, 126042], [42, 126242], [48, 126542], [55, 127002], [58, 127382], [61, 127602], [64, 127742], [72, 128452], [77, 128852], [81, 129032], [87, 129292], [91, 129572]]}, {"verse": 19, "start": 130505, "end": 134584, "text": "Le dice la mujer: Señor, me parece que tú eres profeta.", "words": [[0, 130505], [3, 130785], [8, 131045], [11, 131225], [18, 131994], [25, 132730], [28, 132810], [35, 133210], [39, 133410], [42, 133610], [47, 133810]]}, {"verse": 20, "start": 134934, "end": 141233, "text": "Nuestros padres adoraron en este monte, y vosotros decís que en Jerusalén es el lugar donde es necesario adorar.", "words": [[0, 134934], [9, 135342], [16, 135642], [25, 136242], [28, 136382], [33, 136562], [40, 136902], [42, 137382], [51, 137802], [57, 138342], [61, 138482], [64, 138562], [74, 139202], [77, 139422], [80, 139562], [86, 139782], [92, 140042], [95, 140242], [105, 140762]]}, {"verse": 21, "start": 141513, "end": 149739, "text": "Le dice Jesús: Mujer, créeme, que la hora viene, cuando ni en este monte, ni en Jerusalén adoraréis al Padre.", "words": [[0, 141513], [3, 141662], [8, 141882], [15, 142848], [22, 143653], [30, 144133], [34, 144613], [37, 144773], [42, 144973], [49, 145393], [56, 145853], [59, 146133], [62, 146233], [67, 146453], [74, 146773], [77, 147073], [80, 147173], [90, 147913], [100, 148653], [103, 148953]]}, {"verse": 22, "start": 150089, "end": 157851, "text": "Vosotros adoráis lo que no sabéis; nosotros adoramos lo que sabemos: porque la salvación viene de los judíos.", "words": [[0, 150089], [9, 150556], [17, 151316], [20, 151716], [24, 151856], [27, 151996], [35, 152976], [44, 153442], [53, 154082], [56, 154362], [60, 154482], [69, 155355], [76, 155559], [79, 155759], [89, 156379], [95, 156719], [98, 156939], [102, 157059]]}, {"verse": 23, "start": 158201, "end": 171320, "text": "Pero la hora viene, y ahora es, cuando los verdaderos adoradores adorarán al Padre en espíritu y en verdad; porque también el Padre tales adoradores busca que le adoren.", "words": [[0, 158201], [5, 158345], [8, 158545], [13, 158725], [20, 159185], [22, 159745], [28, 160005], [32, 160445], [39, 160965], [43, 161265], [54, 162045], [65, 162745], [74, 163585], [77, 163725], [83, 164345], [86, 164545], [95, 165465], [97, 165625], [100, 165725], [108, 166591], [115, 166793], [123, 167273], [126, 167593], [132, 168273], [138, 168513], [149, 169713], [155, 170173], [159, 170453], [162, 170613]]}, {"verse": 24, "start": 171670, "end": 178861, "text": "Dios es Espíritu; y los que le adoran, en espíritu y en verdad es necesario que adoren.", "words": [[0, 171670], [5, 172033], [8, 172473], [18, 173792], [20, 173896], [24, 174036], [28, 174216], [31, 174356], [39, 175056], [42, 175436], [51, 176216], [53, 176316], [56, 176456], [63, 176776], [66, 177156], [76, 177896], [80, 178136]]}, {"verse": 25, "start": 179211, "end": 187542, "text": "Le dice la mujer: Sé que el Mesías ha de venir, llamado el Cristo: cuando él venga nos declarará todas las cosas.", "words": [[0, 179211], [3, 179491], [8, 179751], [11, 179931], [18, 180700], [21, 181008], [25, 181228], [28, 181448], [35, 181968], [38, 182268], [41, 182388], [48, 183048], [56, 183568], [59, 183848], [67, 184653], [74, 184876], [77, 185096], [83, 185676], [87, 185776], [97, 186376], [103, 186616], [107, 186876]]}, {"verse": 26, "start": 187822, "end": 190973, "text": "Le dice Jesús: Yo soy, que hablo contigo.", "words": [[0, 187822], [3, 187970], [8, 188190], [15, 189157], [18, 189347], [23, 189627], [27, 189907], [33, 190247]]}, {"verse": 27, "start": 191323, "end": 200415, "text": "Y en esto vinieron sus discípulos, y se maravillaron de que hablaba con mujer; pero ninguno dijo: ¿Qué preguntas? o, ¿Qué hablas con ella?", "words": [[0, 191323], [2, 191467], [5, 191567], [10, 191807], [19, 192327], [23, 192587], [35, 193407], [37, 193867], [40, 194027], [53, 194767], [56, 194967], [60, 195087], [68, 195487], [72, 195667], [79, 196414], [84, 196558], [92, 197078], [98, 197883], [103, 198158], [114, 198689], [117, 199109], [122, 199359], [129, 199609], [133, 199909]]}, {"verse": 28, "start": 200765, "end": 206421, "text": "Entonces la mujer dejó su cántaro, y fue a la ciudad, y dijo a aquellos hombres:", "words": [[0, 200765], [9, 201572], [12, 201674], [18, 201954], [23, 202394], [26, 202514], [35, 203134], [37, 203614], [41, 203834], [43, 204034], [46, 204054], [54, 204414], [56, 204779], [61, 205099], [63, 205239], [72, 205479]]}, {"verse": 29, "start": 206621, "end": 211422, "text": "Venid, ved un hombre que me ha dicho todo lo que he hecho: ¿No será este el Cristo?", "words": [[0, 206621], [7, 207104], [11, 207624], [14, 207784], [21, 207984], [25, 208124], [28, 208264], [31, 208364], [37, 208584], [42, 208824], [45, 209044], [49, 209204], [52, 209364], [59, 210099], [63, 210226], [68, 210426], [73, 210706], [76, 210846]]}, {"verse": 30, "start": 211702, "end": 214896, "text": "Entonces salieron de la ciudad, y vinieron a él.", "words": [[0, 211702], [9, 212161], [18, 213061], [21, 213201], [24, 213321], [32, 213641], [34, 214006], [43, 214486], [45, 214686]]}, {"verse": 31, "start": 215246, "end": 220345, "text": "Entre tanto los discípulos le rogaban, diciendo: Rabí, come.", "words": [[0, 215246], [6, 215488], [12, 215888], [16, 216128], [27, 216888], [30, 217288], [39, 218288], [49, 219455], [55, 219655]]}, {"verse": 32, "start": 220625, "end": 225915, "text": "Y él les dijo: Yo tengo una comida que comer, que vosotros no sabéis.", "words": [[0, 220625], [2, 220812], [5, 220932], [9, 221112], [15, 221804], [18, 221991], [24, 222411], [28, 222811], [35, 223251], [39, 223451], [46, 223851], [50, 224136], [59, 224676], [62, 225056]]}, {"verse": 33, "start": 226265, "end": 231993, "text": "Entonces los discípulos decían el uno al otro: ¿Le habrá traído alguien de comer?", "words": [[0, 226265], [9, 226813], [13, 227433], [24, 228213], [31, 228953], [34, 229213], [38, 229473], [41, 229773], [47, 230520], [51, 230640], [57, 230860], [64, 231140], [72, 231400], [75, 231580]]}, {"verse": 34, "start": 232273, "end": 237942, "text": "Les dice Jesús: Mi comida es que haga la voluntad del que me envió, y que acabe su obra.", "words": [[0, 232273], [4, 232461], [9, 232761], [16, 233541], [19, 233646], [26, 234026], [29, 234266], [33, 234446], [38, 234686], [41, 234866], [50, 235182], [54, 235498], [58, 235814], [61, 236130], [68, 236446], [70, 236706], [74, 236846], [80, 237206], [83, 237426]]}, {"verse": 35, "start": 238292, "end": 249632, "text": "¿No decís vosotros: Aun hay cuatro meses hasta que llegue la siega? He aquí os digo: Alzad vuestros ojos, y mirad los campos, porque ya están blancos para la siega.", "words": [[0, 238292], [4, 238520], [10, 238790], [20, 239950], [24, 240250], [28, 240390], [35, 240670], [41, 241130], [47, 241710], [51, 241910], [58, 242210], [61, 242585], [68, 243181], [71, 243271], [76, 243511], [79, 243731], [85, 244439], [91, 244874], [100, 245234], [106, 245574], [108, 246134], [114, 246454], [118, 246594], [126, 247274], [133, 247694], [136, 247954], [142, 248214], [150, 248714], [155, 248914], [158, 249301]]}, {"verse": 36, "start": 249982, "end": 258820, "text": "Y el que siega, recibe salario, y recoge fruto para vida eterna; para que el que siembra también goce, y el que siega.", "words": [[0, 249982], [2, 250265], [5, 250365], [9, 250695], [16, 251025], [23, 251665], [32, 252305], [34, 252872], [41, 253438], [47, 254005], [52, 254285], [57, 254525], [65, 255444], [70, 255605], [74, 255825], [77, 255945], [81, 256105], [89, 256645], [97, 256925], [103, 257625], [105, 257945], [108, 258045], [112, 258460]]}, {"verse": 37, "start": 259170, "end": 264387, "text": "Porque en esto es el dicho verdadero: Que uno es el que siembra, y otro es el que siega.", "words": [[0, 259170], [7, 259414], [10, 259634], [15, 259834], [18, 260014], [21, 260154], [27, 260394], [38, 261421], [42, 261465], [46, 261665], [49, 261845], [52, 261965], [56, 262085], [65, 262897], [67, 263097], [72, 263337], [75, 263537], [78, 263677], [82, 264057]]}, {"verse": 38, "start": 264737, "end": 274045, "text": "Yo os he enviado a segar lo que vosotros no labrasteis: otros labraron, y vosotros habéis entrado en sus labores.", "words": [[0, 264737], [3, 265026], [6, 265306], [9, 265546], [17, 266226], [19, 266506], [25, 266786], [28, 266906], [32, 267046], [41, 267666], [44, 268286], [56, 269802], [62, 270150], [72, 270990], [74, 271430], [83, 271890], [90, 272370], [98, 272930], [101, 273050], [105, 273210]]}, {"verse": 39, "start": 274395, "end": 284782, "text": "Y muchos de los samaritanos de aquella ciudad creyeron en él por la palabra de la mujer, que daba testimonio, diciendo: Que me dijo todo lo que he hecho.", "words": [[0, 274395], [2, 274516], [9, 274956], [12, 275176], [16, 275626], [28, 276076], [31, 276136], [39, 276476], [46, 276916], [55, 277996], [58, 278136], [61, 278276], [65, 278516], [68, 278716], [76, 279096], [79, 279256], [82, 279396], [89, 280156], [93, 280196], [98, 280496], [110, 281616], [120, 282740], [124, 282846], [127, 282986], [132, 283286], [137, 283666], [140, 283946], [144, 284126], [147, 284306]]}, {"verse": 40, "start": 285062, "end": 291499, "text": "Viniendo pues los samaritanos a él, le rogaron que se quedase allí: y se quedó allí dos días.", "words": [[0, 285062], [9, 285525], [14, 285825], [18, 286345], [30, 286865], [32, 287025], [36, 287385], [39, 287805], [47, 288305], [51, 288425], [54, 288565], [62, 289005], [68, 289776], [70, 289883], [73, 290003], [79, 290323], [84, 290503], [88, 290743]]}, {"verse": 41, "start": 291850, "end": 295141, "text": "Y creyeron muchos más por la palabra de él.", "words": [[0, 291850], [2, 291959], [11, 292579], [18, 293039], [22, 293539], [26, 293979], [29, 294139], [37, 294479], [40, 294719]]}, {"verse": 42, "start": 295491, "end": 304811, "text": "Y decían a la mujer: Ya no creemos por tu dicho; porque nosotros mismos hemos oído, y sabemos que verdaderamente este es el Salvador del mundo, el Cristo.", "words": [[0, 295491], [2, 295618], [9, 296158], [11, 296358], [14, 296438], [21, 297185], [24, 297349], [27, 297489], [35, 297889], [39, 298129], [42, 298269], [49, 298869], [56, 299070], [65, 299310], [72, 299750], [78, 300050], [84, 300490], [86, 300970], [94, 301290], [98, 301510], [113, 302290], [118, 302570], [121, 302790], [124, 302870], [133, 303210], [137, 303510], [144, 304130], [147, 304330]]}, {"verse": 43, "start": 305091, "end": 309711, "text": "Y dos días después, salió de allí, y se fue a Galilea.", "words": [[0, 305091], [2, 305212], [6, 305412], [11, 305732], [20, 307012], [26, 307532], [29, 307652], [35, 307972], [37, 308492], [40, 308592], [44, 308792], [46, 308912]]}, {"verse": 44, "start": 310061, "end": 315925, "text": "Porque el mismo Jesús dio testimonio de que el profeta en su tierra no tiene honra.", "words": [[0, 310061], [7, 310442], [10, 310622], [16, 310962], [22, 311522], [26, 312202], [37, 313022], [40, 313142], [44, 313282], [47, 313442], [55, 313982], [58, 314082], [61, 314242], [68, 314582], [71, 314882], [77, 315182]]}, {"verse": 45, "start": 316275, "end": 327617, "text": "Y cuando vino a Galilea, los galileos le recibieron, vistas todas las cosas que había hecho en Jerusalén en el día de la fiesta: porque también ellos habían ido a la fiesta.", "words": [[0, 316275], [2, 316377], [9, 316577], [14, 316877], [16, 317037], [25, 317917], [29, 318177], [38, 318797], [41, 318937], [53, 319697], [60, 320477], [66, 320757], [70, 321057], [76, 321377], [80, 321617], [86, 321857], [92, 322157], [95, 322277], [105, 322997], [108, 323437], [111, 323577], [115, 323777], [118, 323917], [121, 324017], [129, 324813], [136, 325019], [144, 325439], [150, 325939], [157, 326374], [161, 326754], [163, 326894], [166, 326954]]}, {"verse": 46, "start": 327967, "end": 339719, "text": "Vino pues Jesús otra vez a Caná de Galilea, donde había hecho el vino del agua. Y había en Capernaum un funcionario del rey, cuyo hijo estaba enfermo.", "words": [[0, 327967], [5, 328213], [10, 328513], [16, 329033], [21, 329733], [25, 330113], [27, 330393], [32, 330733], [35, 330833], [44, 331873], [50, 332233], [56, 332633], [62, 332913], [65, 333093], [70, 333313], [74, 333533], [80, 334365], [82, 334494], [88, 334754], [91, 335374], [101, 335994], [104, 336274], [116, 337074], [120, 337314], [125, 338054], [130, 338474], [135, 338654], [142, 338954]]}, {"verse": 47, "start": 340069, "end": 351183, "text": "Este, cuando oyó que Jesús venía de Judea a Galilea, fue a él, y le rogaba que descendiese, y sanase a su hijo, porque se comenzaba a morir.", "words": [[0, 340069], [6, 340448], [13, 340768], [17, 341308], [21, 341428], [27, 341808], [33, 342468], [36, 342608], [42, 343208], [44, 343408], [53, 344588], [57, 344668], [59, 344988], [63, 345288], [65, 345768], [68, 345928], [75, 346468], [79, 346648], [92, 348268], [94, 348328], [101, 348788], [103, 348908], [106, 349088], [112, 349328], [119, 349708], [122, 349868], [132, 350528], [134, 350648]]}, {"verse": 48, "start": 351533, "end": 357625, "text": "Entonces Jesús le dijo: Si no veis señales y milagros no creeréis.", "words": [[0, 351533], [9, 352014], [15, 352754], [18, 353214], [24, 353965], [27, 354131], [30, 354291], [35, 354731], [43, 355511], [45, 355691], [54, 356371], [57, 356551]]}, {"verse": 49, "start": 357975, "end": 364208, "text": "El funcionario del rey le dijo: Señor, desciende antes que mi hijo muera.", "words": [[0, 357975], [3, 358141], [15, 358881], [19, 359081], [23, 359581], [26, 359721], [32, 360507], [39, 360833], [49, 361533], [55, 361953], [59, 362213], [62, 362413], [67, 362613]]}, {"verse": 50, "start": 364488, "end": 371422, "text": "Le dice Jesús: Ve, tu hijo vive. Y el hombre creyó a la palabra que Jesús le dijo, y se fue.", "words": [[0, 364488], [3, 364637], [8, 364857], [15, 366070], [19, 366350], [22, 366550], [27, 366790], [33, 367591], [35, 367689], [38, 367789], [45, 368049], [51, 368589], [53, 368709], [56, 368789], [64, 369169], [68, 369389], [74, 369689], [77, 370109], [83, 370409], [85, 370869], [88, 371009]]}, {"verse": 51, "start": 371772, "end": 379474, "text": "Y cuando ya él descendía, los siervos le salieron a recibir, y le dieron nuevas, diciendo: Tu hijo vive.", "words": [[0, 371772], [2, 371877], [9, 372157], [12, 372417], [15, 372617], [26, 374017], [30, 374137], [38, 374737], [41, 375097], [50, 375577], [52, 375737], [61, 376137], [63, 376657], [66, 376777], [73, 377077], [81, 377437], [91, 378650], [94, 378754], [99, 378974]]}, {"verse": 52, "start": 379754, "end": 387235, "text": "Entonces él les preguntó a qué hora comenzó a estar mejor. Y le dijeron: Ayer a las siete le dejó la fiebre.", "words": [[0, 379754], [9, 380379], [12, 380679], [16, 380919], [25, 381639], [27, 381819], [31, 381999], [36, 382379], [44, 383019], [46, 383099], [52, 383279], [59, 384134], [61, 384280], [64, 384340], [73, 385344], [78, 385633], [80, 385753], [84, 385933], [90, 386113], [93, 386333], [98, 386613], [101, 386713]]}, {"verse": 53, "start": 387515, "end": 396634, "text": "El padre entonces entendió, que aquella hora era cuando Jesús le dijo: Tu hijo vive; y creyó él y toda su casa.", "words": [[0, 387515], [3, 387657], [9, 388237], [18, 388697], [28, 389657], [32, 389877], [40, 390277], [45, 390617], [49, 390957], [56, 391217], [62, 391857], [65, 392297], [71, 393042], [74, 393164], [79, 393384], [85, 394165], [87, 394308], [93, 394788], [96, 395208], [98, 395588], [103, 395768], [106, 396028]]}, {"verse": 54, "start": 396984, "end": 402361, "text": "Esta segunda señal volvió Jesús a hacer, cuando vino de Judea a Galilea.", "words": [[0, 396984], [5, 397293], [13, 397733], [19, 398313], [26, 398653], [32, 398953], [34, 399253], [41, 399713], [48, 400213], [53, 400613], [56, 400833], [62, 401393], [64, 401593]]}]}