{"book": "ACT", "chapter": 5, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 372298, "verses": [{"verse": 1, "start": 300, "end": 5461, "text": "Pero un hombre llamado Ananías, con Safira su mujer, vendió una posesión,", "words": [[0, 300], [5, 442], [8, 602], [15, 842], [23, 1102], [32, 2502], [36, 2822], [43, 3142], [46, 3222], [53, 4002], [60, 4422], [64, 4582]]}, {"verse": 2, "start": 5911, "end": 15598, "text": "Y retuvo fraudulentamente parte del precio, sabiéndolo también su mujer; y trayendo una parte, la puso a los pies de los apóstoles.", "words": [[0, 5911], [2, 6034], [9, 6594], [26, 8074], [32, 8534], [36, 8894], [44, 9474], [55, 10574], [63, 10914], [66, 11214], [73, 12104], [75, 12311], [84, 12691], [88, 12871], [95, 13611], [98, 13691], [103, 14031], [105, 14111], [109, 14231], [114, 14431], [117, 14591], [121, 14711]]}, {"verse": 3, "start": 16048, "end": 26310, "text": "Y dijo Pedro: Ananías, ¿por qué ha llenado Satanás tu corazón a que mintieses al Espíritu Santo, y retuvieses fraudulentamente parte del precio del terreno?", "words": [[0, 16048], [2, 16195], [7, 16435], [14, 17287], [23, 18332], [28, 18432], [32, 18632], [35, 18752], [43, 19092], [51, 19672], [54, 19772], [62, 20232], [64, 20432], [68, 20552], [78, 21212], [81, 21392], [90, 21892], [97, 22252], [99, 22812], [110, 23492], [127, 24472], [133, 24812], [137, 25132], [144, 25452], [148, 25632]]}, {"verse": 4, "start": 26760, "end": 36230, "text": "Reteniéndola, ¿no se te quedaba a ti? y vendida, ¿no estaba en tu potestad? ¿Por qué pusiste esto en tu corazón? No has mentido a los hombres, sino a Dios.", "words": [[0, 27147], [14, 27987], [18, 28167], [21, 28307], [24, 28427], [32, 28787], [34, 28927], [38, 29520], [40, 29630], [49, 30110], [53, 30430], [60, 30710], [63, 30870], [66, 30970], [76, 31910], [81, 32037], [85, 32177], [93, 32637], [98, 32897], [101, 33057], [104, 33157], [113, 34130], [116, 34271], [120, 34411], [128, 34811], [130, 34891], [134, 35011], [143, 35531], [148, 35651], [150, 35811]]}, {"verse": 5, "start": 36580, "end": 44768, "text": "Entonces Ananías, oyendo estas palabras, cayó y murió. Y vino un gran temor sobre todos los que lo oyeron.", "words": [[0, 36580], [9, 37122], [18, 38382], [25, 38802], [31, 39022], [41, 40022], [46, 40462], [48, 40602], [55, 41445], [57, 41550], [62, 41770], [65, 41990], [70, 42190], [76, 42690], [82, 42970], [88, 43470], [92, 43770], [96, 43910], [99, 44090]]}, {"verse": 6, "start": 45218, "end": 50817, "text": "Y levantándose los jóvenes, le tomaron, y sacándolo, lo sepultaron.", "words": [[0, 45218], [2, 45306], [15, 46126], [19, 46266], [28, 47266], [31, 47366], [40, 48306], [42, 48546], [53, 49746], [56, 50304]]}, {"verse": 7, "start": 51267, "end": 57799, "text": "Y pasado espacio como de tres horas, sucedió que entró su mujer, no sabiendo lo que había acontecido.", "words": [[0, 51267], [2, 51389], [9, 51789], [17, 52349], [22, 52689], [25, 52889], [30, 53169], [37, 53489], [45, 54289], [49, 54469], [55, 54789], [58, 54929], [65, 55349], [68, 55709], [77, 56169], [80, 56349], [84, 56489], [90, 56809]]}, {"verse": 8, "start": 58249, "end": 66479, "text": "Entonces Pedro le dijo: Dime: ¿vendisteis el terreno por esa cantidad? Y ella dijo: Sí, por esa cantidad.", "words": [[0, 58249], [9, 58891], [15, 59431], [18, 59691], [24, 60448], [30, 61188], [42, 61890], [45, 62010], [53, 62390], [57, 62590], [61, 62730], [71, 63697], [73, 63859], [78, 64059], [84, 64899], [88, 65279], [92, 65399], [96, 65579]]}, {"verse": 9, "start": 66829, "end": 76366, "text": "Y Pedro le dijo: ¿Por qué os concertasteis para tentar al Espíritu del Señor? He aquí a la puerta los pies de los que han sepultado a tu marido, y te sacarán.", "words": [[0, 66829], [2, 66938], [8, 67278], [11, 67518], [17, 68327], [22, 68467], [26, 68627], [29, 68747], [43, 69627], [48, 69877], [55, 70127], [58, 70287], [67, 70787], [71, 70867], [78, 71736], [81, 71806], [86, 71966], [88, 72086], [91, 72166], [98, 72406], [102, 72666], [107, 72906], [110, 73046], [114, 73166], [118, 73326], [122, 73446], [132, 73966], [134, 74066], [137, 74126], [145, 74566], [147, 74726], [150, 74826]]}, {"verse": 10, "start": 76716, "end": 87536, "text": "Y de inmediato cayó a los pies de él y murió: y entrados los jóvenes, la hallaron muerta; y la sacaron, y la sepultaron junto a su marido.", "words": [[0, 76716], [2, 76863], [5, 76963], [15, 77643], [20, 78063], [22, 78163], [26, 78263], [31, 78483], [34, 78723], [37, 78903], [39, 79103], [46, 79916], [48, 80046], [57, 80626], [61, 80786], [70, 81286], [73, 82026], [82, 82466], [90, 83504], [92, 83627], [95, 83747], [104, 84407], [106, 85187], [109, 85307], [120, 86147], [126, 86507], [128, 86787], [131, 86907]]}, {"verse": 11, "start": 87986, "end": 93223, "text": "Y vino un gran temor en toda la iglesia, y en todos los que oyeron estas cosas.", "words": [[0, 87986], [2, 88144], [7, 88384], [10, 88584], [15, 88784], [21, 89284], [24, 89484], [29, 89664], [32, 89924], [41, 90524], [43, 90744], [46, 90944], [52, 91264], [56, 91644], [60, 91864], [67, 92344], [73, 92524]]}, {"verse": 12, "start": 93673, "end": 102946, "text": "Y por las manos de los apóstoles eran hechos muchos milagros y prodigios en el pueblo; y estaban todos unánimes en el pórtico de Salomón.", "words": [[0, 93673], [2, 93782], [6, 93942], [10, 94122], [16, 94442], [19, 94602], [23, 94702], [33, 95302], [38, 95642], [45, 96322], [52, 96582], [61, 97342], [63, 97462], [73, 98102], [76, 98282], [79, 98402], [87, 99336], [89, 99454], [97, 99754], [103, 100194], [112, 101094], [115, 101294], [118, 101434], [126, 102034], [129, 102194]]}, {"verse": 13, "start": 103396, "end": 110191, "text": "Y de los otros, ninguno se atrevía a juntarse con ellos; pero el pueblo los alababa grandemente.", "words": [[0, 103396], [2, 103503], [5, 103603], [9, 103783], [16, 104583], [24, 105263], [27, 105403], [35, 105923], [37, 106083], [46, 106683], [50, 106903], [57, 107674], [62, 107818], [65, 107998], [72, 108258], [76, 108598], [84, 109178]]}, {"verse": 14, "start": 110641, "end": 116657, "text": "Y aumentaba el número de quienes creían en el Señor, tanto hombres como mujeres;", "words": [[0, 110641], [2, 110764], [12, 111564], [15, 111764], [22, 112084], [25, 112344], [33, 112664], [40, 113364], [43, 113524], [46, 113684], [53, 114604], [59, 114844], [67, 115404], [72, 115824]]}, {"verse": 15, "start": 117107, "end": 128492, "text": "Tanto que sacaban los enfermos por las calles, y los ponían en camas y en lechos, para que viniendo Pedro, a lo menos su sombra tocase a alguno de ellos.", "words": [[0, 117107], [6, 117291], [10, 117511], [18, 118051], [22, 118191], [31, 118851], [35, 119051], [39, 119251], [47, 119891], [49, 120311], [53, 120431], [60, 120871], [63, 121191], [69, 121831], [71, 122031], [74, 122171], [82, 122631], [87, 123311], [91, 123471], [100, 124031], [107, 125331], [109, 125391], [112, 125531], [118, 125751], [121, 126171], [128, 126791], [135, 126981], [137, 127171], [144, 127771], [147, 127891]]}, {"verse": 16, "start": 128942, "end": 141044, "text": "Y aun de las ciudades vecinas concurría multitud a Jerusalén, trayendo enfermos y atormentados de espíritus inmundos; los cuales todos eran curados.", "words": [[0, 128942], [2, 129102], [6, 129322], [9, 129582], [13, 129702], [22, 130242], [30, 131082], [40, 131922], [49, 132542], [51, 132682], [62, 133642], [71, 134242], [80, 134962], [82, 135142], [95, 136182], [98, 136692], [108, 137202], [118, 138372], [122, 138648], [129, 139008], [135, 139648], [140, 140068]]}, {"verse": 17, "start": 141494, "end": 150913, "text": "Entonces levantándose el sumo sacerdote, y todos los que estaban con él, que es la secta de los saduceos, se llenaron de celos;", "words": [[0, 141494], [9, 142737], [22, 143617], [25, 143737], [30, 144197], [41, 144877], [43, 145217], [49, 145497], [53, 145757], [57, 145917], [65, 146217], [69, 146537], [73, 146977], [77, 147237], [80, 147457], [83, 147837], [89, 148357], [92, 148457], [96, 149037], [106, 149617], [109, 149717], [118, 150157], [121, 150317]]}, {"verse": 18, "start": 151363, "end": 155963, "text": "Y echaron mano a los apóstoles, y los pusieron en la cárcel pública.", "words": [[0, 151363], [2, 151507], [10, 151927], [15, 152347], [17, 152607], [21, 152727], [32, 153487], [34, 153847], [38, 153967], [47, 154447], [50, 154607], [53, 154747], [60, 155167]]}, {"verse": 19, "start": 156413, "end": 162308, "text": "Pero el ángel del Señor, abriendo de noche las puertas de la cárcel, y sacándolos, dijo:", "words": [[0, 156413], [5, 156673], [8, 156853], [14, 157193], [18, 157333], [25, 158133], [34, 158613], [37, 158753], [43, 158933], [47, 159213], [55, 159633], [58, 159773], [61, 159873], [69, 160353], [71, 160573], [83, 161713]]}, {"verse": 20, "start": 162558, "end": 166948, "text": "Id, y estando en el templo, hablad al pueblo todas las palabras de esta vida.", "words": [[0, 162558], [4, 162558], [6, 162761], [14, 163361], [17, 163481], [20, 163581], [28, 164028], [35, 164474], [38, 164921], [45, 165141], [51, 165481], [55, 165781], [64, 166121], [67, 166381], [72, 166521]]}, {"verse": 21, "start": 167298, "end": 187092, "text": "Y oído que hubieron esto, entraron de mañana en el templo, y enseñaban. Entre tanto, viniendo el sumo sacerdote, y los que eran con él, convocaron el Consejo, y a todos los ancianos de los hijos de Israel, y enviaron a la cárcel para que fuesen traídos.", "words": [[0, 167298], [2, 167486], [7, 167746], [11, 167996], [20, 168246], [26, 168666], [35, 169746], [38, 169886], [45, 170226], [48, 170466], [51, 170626], [59, 171406], [61, 171566], [72, 172956], [78, 173258], [85, 174058], [94, 174798], [97, 174978], [102, 175498], [113, 176298], [115, 176898], [119, 177078], [123, 177238], [128, 177478], [132, 177718], [136, 178478], [147, 179118], [150, 179298], [159, 180278], [161, 180638], [163, 180718], [169, 180938], [173, 181198], [182, 181798], [185, 181938], [189, 182038], [195, 182358], [198, 182538], [206, 183606], [208, 183887], [217, 184467], [219, 184627], [222, 184727], [229, 185247], [234, 185647], [238, 185807], [245, 186207]]}, {"verse": 22, "start": 187542, "end": 193817, "text": "Pero cuando llegaron los guardias, y no los hallaron en la cárcel, volvieron, y dieron aviso,", "words": [[0, 187542], [5, 187704], [12, 187984], [21, 188584], [25, 188784], [35, 189444], [37, 190244], [40, 190384], [44, 190584], [53, 191084], [56, 191244], [59, 191384], [67, 192044], [78, 192564], [80, 192884], [87, 193204]]}, {"verse": 23, "start": 194267, "end": 204261, "text": "Diciendo: Por cierto, la cárcel hemos hallado cerrada con toda seguridad, y los guardas que estaban delante de las puertas; pero cuando abrimos, a nadie hallamos dentro.", "words": [[0, 194267], [10, 195337], [14, 195445], [22, 195945], [25, 196005], [32, 196405], [38, 196605], [46, 197085], [54, 197545], [58, 197765], [63, 197985], [74, 198485], [76, 199125], [80, 199265], [88, 199665], [92, 199825], [100, 200085], [108, 200505], [111, 200625], [115, 200745], [124, 201705], [129, 201826], [136, 202066], [145, 202886], [147, 203026], [153, 203376], [162, 203726]]}, {"verse": 24, "start": 204611, "end": 215193, "text": "Y cuando oyeron estas palabras el sumo sacerdote y el jefe de la guardia del templo y los principales sacerdotes, dudaban en qué vendría a parar aquello.", "words": [[0, 204611], [2, 204736], [9, 205036], [16, 205736], [22, 205956], [31, 206496], [34, 207036], [39, 207536], [49, 208276], [51, 208416], [54, 208536], [59, 208956], [62, 209056], [65, 209176], [73, 209616], [77, 209816], [84, 210656], [86, 210816], [90, 210956], [102, 211596], [114, 212416], [122, 213416], [125, 213576], [129, 213756], [137, 214216], [139, 214296], [145, 214516]]}, {"verse": 25, "start": 215643, "end": 223821, "text": "Pero viniendo uno, les dio esta noticia: He aquí, los varones que echasteis en la cárcel, están en el templo, y enseñan al pueblo.", "words": [[0, 215643], [5, 216120], [14, 216660], [19, 217100], [23, 217560], [27, 217760], [32, 217960], [41, 219037], [44, 219145], [50, 219405], [54, 219545], [62, 219945], [66, 220165], [76, 220725], [79, 220805], [82, 220905], [90, 221505], [96, 221745], [99, 221905], [102, 222025], [110, 222585], [112, 222725], [120, 223185], [123, 223305]]}, {"verse": 26, "start": 224171, "end": 232462, "text": "Entonces fue el jefe de la guardia con los guardias, y los trajo sin violencia; porque temían del pueblo ser apedreados.", "words": [[0, 224171], [9, 224719], [13, 225179], [16, 225449], [21, 225719], [24, 225879], [27, 225999], [35, 226459], [39, 226659], [43, 226819], [53, 227359], [55, 227839], [59, 228099], [65, 228359], [69, 228559], [80, 229665], [87, 229867], [94, 230367], [98, 230587], [105, 230907], [109, 231267]]}, {"verse": 27, "start": 232912, "end": 239533, "text": "Y como los trajeron, los presentaron en el Consejo: y el sumo sacerdote les preguntó,", "words": [[0, 232912], [2, 233192], [7, 233452], [11, 233632], [21, 234692], [25, 234792], [37, 235572], [40, 235752], [43, 235892], [52, 236993], [54, 237156], [57, 237316], [62, 237796], [72, 238476], [76, 238636]]}, {"verse": 28, "start": 239983, "end": 251421, "text": "Diciendo: ¿No os ordenamos estrictamente que no enseñaseis en este nombre? y he aquí, habéis llenado a Jerusalén de vuestra doctrina, y queréis echar sobre nosotros la sangre de este hombre.", "words": [[0, 239983], [10, 241049], [14, 241252], [17, 241412], [27, 241932], [41, 242812], [45, 242992], [48, 243172], [59, 243832], [62, 243992], [67, 244192], [75, 245063], [77, 245116], [80, 245206], [86, 245506], [93, 245966], [101, 246386], [103, 246486], [113, 247046], [116, 247166], [124, 247446], [134, 247966], [136, 248546], [144, 248886], [150, 249206], [156, 249466], [165, 249886], [168, 250166], [175, 250486], [178, 250686], [183, 250846]]}, {"verse": 29, "start": 251771, "end": 258957, "text": "Y respondiendo Pedro y los apóstoles, dijeron: Es necesario obedecer a Dios antes que a los hombres.", "words": [[0, 251771], [2, 251898], [15, 252658], [21, 253118], [23, 253318], [27, 253478], [38, 254438], [47, 255411], [50, 255557], [60, 256277], [69, 256977], [71, 257117], [76, 257357], [82, 257857], [86, 258137], [88, 258217], [92, 258337]]}, {"verse": 30, "start": 259407, "end": 265211, "text": "El Dios de nuestros padres levantó a Jesús, al cual vosotros matasteis colgándole en un madero.", "words": [[0, 259407], [3, 259551], [8, 259791], [11, 259971], [20, 260131], [27, 260691], [35, 261231], [37, 261351], [44, 262211], [47, 262291], [52, 262471], [61, 262971], [71, 263791], [82, 264411], [85, 264571], [88, 264671]]}, {"verse": 31, "start": 265661, "end": 272232, "text": "A este Dios ha exaltado con su diestra por Príncipe y Salvador, para dar a Israel arrepentimiento y perdón de pecados.", "words": [[0, 265661], [2, 265759], [7, 265979], [12, 266359], [15, 266459], [24, 266999], [28, 267159], [31, 267319], [39, 267679], [43, 267879], [52, 268439], [54, 268539], [64, 269059], [69, 269559], [73, 269759], [75, 269859], [82, 270179], [98, 271059], [100, 271179], [107, 271499], [110, 271579]]}, {"verse": 32, "start": 272682, "end": 280121, "text": "Y nosotros somos testigos suyos de estas cosas, y también el Espíritu Santo, el cual ha dado Dios a los que le obedecen.", "words": [[0, 272682], [2, 272787], [11, 273027], [17, 273467], [26, 274027], [32, 274467], [35, 274587], [41, 274787], [48, 275687], [50, 275907], [58, 276187], [61, 276347], [70, 276867], [77, 277807], [80, 277907], [85, 278087], [88, 278267], [93, 278447], [98, 278727], [100, 279047], [104, 279167], [108, 279287], [111, 279387]]}, {"verse": 33, "start": 280471, "end": 285663, "text": "Ellos, oyendo esto, se enfurecían y planeaban matarlos.", "words": [[0, 280471], [7, 280978], [14, 281398], [20, 282318], [23, 282538], [34, 283558], [36, 283878], [46, 284518]]}, {"verse": 34, "start": 286113, "end": 298037, "text": "Entonces levantándose en el Consejo un fariseo llamado Gamaliel, maestro de la ley, venerable a todo el pueblo, mandó que sacasen fuera por un momento a los apóstoles.", "words": [[0, 286113], [9, 287353], [22, 288253], [25, 288433], [28, 288573], [36, 289173], [39, 289373], [47, 290013], [55, 290253], [65, 291433], [73, 291913], [76, 292093], [79, 292213], [84, 292853], [94, 293433], [96, 293593], [101, 293793], [104, 293993], [112, 294873], [118, 295233], [122, 295553], [130, 295873], [136, 296173], [140, 296453], [143, 296593], [151, 296933], [153, 297073], [157, 297173]]}, {"verse": 35, "start": 298487, "end": 304629, "text": "Y les dijo: Varones israelitas, mirad por vosotros acerca de estos hombres en lo que habéis de hacer.", "words": [[0, 298487], [2, 298656], [6, 298736], [12, 299639], [20, 299849], [32, 300989], [38, 301329], [42, 301449], [51, 301949], [58, 302329], [61, 302609], [67, 302789], [75, 303209], [78, 303509], [81, 303609], [85, 303749], [92, 304029], [95, 304169]]}, {"verse": 36, "start": 305079, "end": 318097, "text": "Porque antes de estos días se levantó Teudas, diciendo que era alguien; al que se agregó un número de hombres como cuatrocientos: el cual fue matado; y todos los que le creyeron fueron dispersos, y reducidos a nada.", "words": [[0, 305079], [7, 305263], [13, 305563], [16, 305783], [22, 305963], [27, 306343], [30, 306703], [38, 307203], [46, 307723], [55, 308123], [59, 308503], [63, 308723], [72, 309601], [75, 309739], [79, 309879], [82, 310019], [89, 310459], [92, 310579], [99, 310859], [102, 311059], [110, 311339], [115, 312039], [130, 312976], [133, 313095], [138, 313255], [142, 313495], [150, 314407], [152, 314524], [158, 314724], [162, 315004], [166, 315184], [169, 315284], [178, 315784], [185, 315984], [196, 316784], [198, 316944], [208, 317464], [210, 317684]]}, {"verse": 37, "start": 318547, "end": 328954, "text": "Después de este, se levantó Judas el galileo en los días del censo, y llevó mucho pueblo tras sí. Pereció también aquel; y todos los que consintieron con él, fueron dispersados.", "words": [[0, 318547], [8, 318853], [11, 319073], [17, 319353], [20, 319513], [28, 319973], [34, 320273], [37, 320493], [45, 320993], [48, 321113], [52, 321233], [57, 321433], [61, 321653], [68, 322173], [70, 322653], [76, 322933], [82, 323173], [89, 323533], [94, 323793], [98, 324467], [106, 324826], [114, 325086], [121, 325975], [123, 326077], [129, 326277], [133, 326537], [137, 326927], [150, 327317], [154, 327517], [158, 327717], [165, 327977]]}, {"verse": 38, "start": 329404, "end": 338289, "text": "Y ahora os digo: Apartaos de estos hombres y dejadlos en paz; porque si este consejo o esta obra es de los hombres, se desvanecerá:", "words": [[0, 329404], [2, 329522], [8, 329662], [11, 329882], [17, 330876], [26, 331186], [29, 331406], [35, 331646], [43, 332166], [45, 332516], [54, 332866], [57, 333126], [62, 333868], [69, 334049], [72, 334269], [77, 334549], [85, 335249], [87, 335409], [92, 335649], [97, 335989], [100, 336229], [103, 336349], [107, 336529], [116, 337309], [119, 337409]]}, {"verse": 39, "start": 338739, "end": 344519, "text": "Pero si es de Dios, no la podréis deshacer; no seáis tal vez hallados resistiendo a Dios.", "words": [[0, 338739], [5, 338885], [8, 339105], [11, 339285], [14, 339425], [20, 340025], [23, 340145], [26, 340265], [34, 340785], [44, 341739], [47, 341925], [53, 342345], [57, 342525], [61, 342765], [70, 343245], [82, 343965], [84, 344085]]}, {"verse": 40, "start": 344869, "end": 355605, "text": "Y convinieron con él: y llamando a los apóstoles, después de azotados, les ordenaron que no hablasen en el nombre de Jesús, y los soltaron.", "words": [[0, 344869], [2, 344990], [14, 345710], [18, 345930], [22, 346654], [24, 346814], [33, 347294], [35, 347394], [39, 347534], [50, 348654], [58, 348854], [61, 349474], [71, 350094], [75, 350234], [85, 351094], [89, 351334], [92, 351554], [101, 352194], [104, 352354], [107, 352514], [114, 352914], [117, 353114], [124, 353494], [126, 354254], [130, 354414]]}, {"verse": 41, "start": 356055, "end": 364694, "text": "Y ellos salieron de delante del Consejo, gozosos de que fuesen tenidos por dignos de padecer deshonra por el Nombre.", "words": [[0, 356055], [2, 356190], [8, 356450], [17, 357170], [20, 357370], [28, 357830], [32, 358010], [41, 359090], [49, 359870], [52, 360290], [56, 360430], [63, 360880], [71, 361330], [75, 361570], [82, 362110], [85, 362210], [93, 362770], [102, 363730], [106, 363930], [109, 364090]]}, {"verse": 42, "start": 365144, "end": 371898, "text": "Y todos los días, en el templo y por las casas, no cesaban de enseñar y predicar a Jesucristo.", "words": [[0, 365144], [2, 365248], [8, 365468], [12, 365748], [18, 366108], [21, 366888], [24, 367048], [31, 367568], [33, 367648], [37, 367848], [41, 368008], [48, 368628], [51, 369008], [59, 369528], [62, 369728], [70, 370268], [72, 370328], [81, 370828], [83, 371370]]}]}