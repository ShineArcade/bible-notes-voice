{"book": "GEN", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 164407, "verses": [{"verse": 1, "start": 300, "end": 8106, "text": "Subió, pues, Abram de Egipto hacia el sur, él, y su mujer, con todo lo que tenía, y con él Lot.", "words": [[0, 300], [7, 678], [13, 1108], [19, 1538], [22, 1898], [29, 2438], [35, 2598], [38, 2938], [43, 3638], [47, 4098], [49, 4678], [52, 4818], [59, 5538], [63, 5698], [68, 5878], [71, 6058], [75, 6158], [82, 7018], [84, 7118], [88, 7298], [91, 7458]]}, {"verse": 2, "start": 8556, "end": 12306, "text": "Y Abram era riquísimo en ganado, en plata y oro.", "words": [[0, 8556], [2, 8745], [8, 8971], [12, 9198], [22, 9771], [25, 10345], [33, 10918], [36, 11178], [42, 11558], [44, 11898]]}, {"verse": 3, "start": 12756, "end": 21315, "text": "Y volvió por sus jornadas desde el Neguev hacia Bet-el, hasta el lugar donde había estado antes su tienda entre Bet-el y Hai;", "words": [[0, 12756], [2, 12902], [9, 13302], [13, 13482], [17, 13682], [26, 14322], [32, 14962], [35, 15512], [42, 16062], [48, 16502], [56, 17402], [62, 17722], [65, 17942], [71, 18222], [77, 18482], [83, 18742], [90, 19022], [96, 19342], [99, 19602], [106, 19982], [112, 20202], [119, 20722], [121, 21044]]}, {"verse": 4, "start": 21765, "end": 28428, "text": "Al lugar del altar que había hecho allí antes: e invocó allí Abram el nombre de Jehová.", "words": [[0, 21765], [3, 21930], [9, 22230], [13, 22490], [19, 22910], [23, 23130], [29, 23390], [35, 23700], [40, 24010], [47, 25118], [49, 25262], [56, 26082], [61, 26422], [67, 26762], [70, 27142], [77, 27542], [80, 27762]]}, {"verse": 5, "start": 28878, "end": 35111, "text": "Y asimismo Lot, que andaba con Abram, tenía ovejas, y vacas, y tiendas.", "words": [[0, 28878], [2, 29365], [11, 29895], [16, 30555], [20, 30815], [27, 31215], [31, 31455], [38, 32005], [44, 32555], [52, 33195], [54, 33555], [61, 34095], [63, 34275]]}, {"verse": 6, "start": 35561, "end": 44578, "text": "