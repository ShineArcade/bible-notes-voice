{"book": "GEN", "chapter": 4, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 202571, "verses": [{"verse": 1, "start": 300, "end": 7132, "text": "And Adam knew Eve his wife; and she conceived, and bore Cain, and said, I have gotten a man from the LORD.", "words": [[0, 300], [4, 458], [9, 778], [14, 1038], [18, 1278], [22, 1478], [28, 2048], [32, 2173], [36, 2313], [47, 2973], [51, 3273], [56, 3493], [62, 3913], [66, 4213], [72, 4954], [74, 5254], [79, 5474], [86, 5754], [88, 5874], [92, 6114], [97, 6334], [101, 6514]]}, {"verse": 2, "start": 7412, "end": 14261, "text": "And she again bore his brother Abel. And Abel was a keeper of sheep, but Cain was a tiller of the ground.", "words": [[0, 7412], [4, 7532], [8, 7732], [14, 8112], [19, 8492], [23, 8712], [31, 9032], [37, 9879], [41, 10045], [46, 10404], [50, 10584], [52, 10724], [59, 11024], [62, 11264], [69, 12104], [73, 12184], [78, 12625], [82, 12844], [84, 13004], [91, 13364], [94, 13484], [98, 13584]]}, {"verse": 3, "start": 14611, "end": 20612, "text": "And in process of time it came to pass, that Cain brought of the fruit of the ground an offering to the LORD.", "words": [[0, 14611], [4, 14747], [7, 14847], [15, 15187], [18, 15447], [23, 15807], [26, 15987], [31, 16227], [34, 16407], [40, 17227], [45, 17367], [50, 17807], [58, 18027], [61, 18187], [65, 18327], [71, 18507], [74, 18667], [78, 18767], [85, 19037], [88, 19307], [97, 19707], [100, 19987], [104, 20127]]}, {"verse": 4, "start": 20962, "end": 28194, "text": "And Abel, he also brought of the firstlings of his flock and of the fat of it. And the LORD had respect to Abel and to his offering:", "words": [[0, 20962], [4, 21135], [10, 21595], [13, 21695], [18, 21995], [26, 22315], [29, 22475], [33, 22575], [44, 23055], [47, 23275], [51, 23435], [57, 23775], [61, 24135], [64, 24275], [68, 24415], [72, 24715], [75, 24875], [79, 25350], [83, 25495], [87, 25595], [92, 25815], [96, 26015], [104, 26395], [107, 26655], [112, 27055], [116, 27255], [119, 27415], [123, 27555]]}, {"verse": 5, "start": 28544, "end": 35285, "text": "But to Cain and to his offering he had not respect. And Cain was very angry, and his countenance fell.", "words": [[0, 28544], [4, 28734], [7, 28914], [12, 29314], [16, 29494], [19, 29634], [23, 29774], [32, 30234], [35, 30534], [39, 30694], [43, 30894], [52, 31896], [56, 32236], [61, 32616], [65, 32816], [70, 33136], [77, 33596], [81, 34036], [85, 34176], [97, 34796]]}, {"verse": 6, "start": 35635, "end": 41191, "text": "And the LORD said to Cain, Why are you angry? and why is your countenance fallen?", "words": [[0, 35635], [4, 35741], [8, 35841], [13, 36061], [18, 36321], [21, 36521], [27, 37280], [31, 37548], [35, 37708], [39, 37868], [46, 39080], [50, 39204], [54, 39444], [57, 39624], [62, 39744], [74, 40264]]}, {"verse": 7, "start": 41541, "end": 51420, "text": "If you do well, shall you not be accepted? and if you do not well, sin lies at the door. And to you shall be his desire, and you shall rule over him.", "words": [[0, 41541], [3, 41678], [7, 41818], [10, 41938], [16, 42618], [22, 42818], [26, 42978], [30, 43138], [33, 43318], [43, 44529], [47, 44663], [50, 44763], [54, 44863], [57, 44963], [61, 45143], [67, 45943], [71, 46123], [76, 46423], [79, 46603], [83, 46703], [89, 47724], [93, 47841], [96, 47981], [100, 48201], [106, 48421], [109, 48621], [113, 48801], [121, 49841], [125, 49941], [129, 50061], [135, 50221], [140, 50501], [145, 50761]]}, {"verse": 8, "start": 51700, "end": 59666, "text": "And Cain talked with Abel his brother: and it came to pass, when they were in the field, that Cain rose up against Abel his brother, and killed him.", "words": [[0, 51700], [4, 51831], [9, 52191], [16, 52451], [21, 52711], [26, 53151], [30, 53251], [39, 54054], [43, 54159], [46, 54279], [51, 54459], [54, 54639], [60, 54959], [65, 55219], [70, 55359], [75, 55499], [78, 55619], [82, 55719], [89, 56139], [94, 56639], [99, 57019], [104, 57239], [107, 57499], [115, 57779], [120, 58199], [124, 58339], [133, 58659], [137, 59019], [144, 59319]]}, {"verse": 9, "start": 60016, "end": 67948, "text": "¶ And the LORD said to Cain, Where is Abel your brother? And he said, I know not: Am I my brother’s keeper?", "words": [[2, 60016], [6, 60167], [10, 60287], [15, 60507], [20, 60767], [23, 60987], [29, 61781], [35, 61992], [38, 62212], [43, 62692], [48, 62752], [57, 63861], [61, 63996], [64, 64136], [70, 65544], [72, 65709], [77, 65909], [82, 66563], [85, 66703], [87, 66823], [90, 66983], [100, 67423]]}, {"verse": 10, "start": 68228, "end": 74527, "text": "And he said, What have you done? the voice of your brother’s blood cries to me from the ground.", "words": [[0, 68228], [4, 68363], [7, 68503], [13, 69912], [18, 70092], [23, 70232], [27, 70332], [33, 71371], [37, 71454], [43, 71714], [46, 71914], [51, 72014], [61, 72434], [67, 72654], [73, 72974], [76, 73234], [79, 73374], [84, 73554], [88, 73694]]}, {"verse": 11, "start": 74877, "end": 80425, "text": "And now are you cursed from the earth, which has opened her mouth to receive your brother’s blood from your hand;", "words": [[0, 74877], [4, 75021], [8, 75301], [12, 75541], [16, 75661], [23, 75941], [28, 76161], [32, 76321], [39, 76821], [45, 77121], [49, 77261], [56, 77561], [60, 77741], [66, 78021], [69, 78221], [77, 78501], [82, 78681], [92, 79021], [98, 79301], [103, 79521], [108, 79661]]}, {"verse": 12, "start": 80775, "end": 88115, "text": "When you till the ground, it shall not from now on yield to you her strength; a fugitive and a vagabond shall you be in the earth.", "words": [[0, 80775], [5, 80888], [9, 81068], [14, 81268], [18, 81408], [26, 81968], [29, 82048], [35, 82228], [39, 82468], [44, 82668], [48, 82908], [51, 83188], [57, 83428], [60, 83688], [64, 83848], [68, 84028], [78, 85048], [80, 85136], [89, 85636], [93, 85936], [95, 85996], [104, 86656], [110, 86956], [114, 87156], [117, 87316], [120, 87456], [124, 87576]]}, {"verse": 13, "start": 88395, "end": 92106, "text": "And Cain said to the LORD, My punishment is greater than I can bear.", "words": [[0, 88395], [4, 88527], [9, 88907], [14, 89087], [17, 89267], [21, 89387], [27, 90032], [30, 90192], [41, 90612], [44, 90952], [52, 91212], [57, 91432], [59, 91552], [63, 91692]]}, {"verse": 14, "start": 92456, "end": 104030, "text": "Behold, you have driven me out this day from the face of the earth; and from your face shall I be hid; and I shall be a fugitive and a vagabond in the earth; and it shall come to pass, that every one that finds me shall slay me.", "words": [[0, 92456], [8, 92883], [12, 92963], [17, 93103], [24, 93323], [27, 93503], [31, 93663], [36, 93863], [40, 94083], [45, 94263], [49, 94383], [54, 94623], [57, 94763], [61, 94883], [68, 95453], [72, 95569], [77, 95729], [82, 95889], [87, 96129], [93, 96389], [95, 96549], [98, 96649], [103, 97347], [107, 97461], [109, 97574], [115, 97774], [118, 97934], [120, 98054], [129, 98654], [133, 98954], [135, 99054], [144, 99674], [147, 99934], [151, 100054], [158, 100612], [162, 100721], [165, 100801], [171, 100941], [176, 101181], [179, 101341], [185, 101641], [190, 101894], [196, 102148], [200, 102401], [205, 102701], [211, 102961], [214, 103161], [220, 103321], [225, 103801]]}, {"verse": 15, "start": 104310, "end": 115724, "text": "And the LORD said to him, Therefore whoever slays Cain, vengeance shall be taken on him sevenfold. And the LORD set a mark upon Cain, lest any finding him should kill him.", "words": [[0, 104310], [4, 104431], [8, 104551], [13, 104751], [18, 105051], [21, 105251], [26, 105860], [36, 106143], [44, 106623], [50, 107163], [56, 107783], [66, 108403], [72, 108783], [75, 108903], [81, 109223], [84, 109443], [88, 109643], [99, 111087], [103, 111213], [107, 111353], [112, 111633], [116, 111913], [118, 112053], [123, 112333], [128, 112593], [134, 113693], [139, 113913], [143, 114133], [151, 114573], [155, 114853], [162, 115073], [167, 115413]]}, {"verse": 16, "start": 116074, "end": 121848, "text": "¶ And Cain went out from the presence of the LORD, and dwelt in the land of Nod, on the east of Eden.", "words": [[2, 116074], [6, 116203], [11, 116603], [16, 116763], [20, 116963], [25, 117143], [29, 117303], [38, 117643], [41, 117903], [45, 118043], [51, 118363], [55, 118923], [61, 119263], [64, 119423], [68, 119543], [73, 119783], [76, 119963], [81, 120483], [84, 120763], [88, 120903], [93, 121143], [96, 121343]]}, {"verse": 17, "start": 122198, "end": 131597, "text": "And Cain knew his wife; and she conceived, and bore Enoch: and he built a city, and called the name of the city, after the name of his son, Enoch.", "words": [[0, 122198], [4, 122392], [9, 122622], [14, 122942], [18, 123122], [24, 123901], [28, 124047], [32, 124207], [43, 124907], [47, 125467], [52, 125747], [59, 126759], [63, 126884], [66, 126984], [72, 127224], [74, 127384], [80, 127664], [84, 127964], [91, 128244], [95, 128444], [100, 128724], [103, 128864], [107, 129004], [113, 129284], [119, 129684], [123, 129844], [128, 130084], [131, 130224], [135, 130384], [140, 130944]]}, {"verse": 18, "start": 131947, "end": 140606, "text": "And to Enoch was born Irad: and Irad begot Mehujael: and Mehujael begot Methusael: and Methusael begot Lamech.", "words": [[0, 131947], [4, 132092], [7, 132212], [13, 132592], [17, 132852], [22, 133454], [28, 134236], [32, 134542], [37, 134882], [43, 135533], [53, 136364], [57, 136790], [66, 137250], [72, 137884], [83, 138688], [87, 139089], [97, 139529], [103, 140094]]}, {"verse": 19, "start": 140956, "end": 147030, "text": "¶ And Lamech took to him two wives: the name of the one was Adah, and the name of the other Zillah.", "words": [[2, 140956], [6, 141232], [13, 141542], [18, 141742], [21, 141962], [25, 142102], [29, 142342], [36, 143303], [40, 143413], [45, 143673], [48, 143833], [52, 143933], [56, 144153], [60, 144463], [66, 144773], [70, 145413], [74, 145533], [79, 145753], [82, 145913], [86, 146053], [92, 146560]]}, {"verse": 20, "start": 147380, "end": 153385, "text": "And Adah bore Jabal: he was the father of such as dwell in tents, and of such as have cattle.", "words": [[0, 147380], [4, 147641], [9, 147941], [14, 148241], [21, 149187], [24, 149276], [28, 149436], [32, 149556], [39, 149916], [42, 150176], [47, 150416], [50, 150716], [56, 151097], [59, 151478], [66, 151859], [70, 151981], [73, 152101], [78, 152381], [81, 152621], [86, 152821]]}, {"verse": 21, "start": 153735, "end": 159544, "text": "And his brother’s name was Jubal: he was the father of all such as handle the harp and organ.", "words": [[0, 153735], [4, 153879], [8, 153999], [18, 154479], [23, 154759], [27, 154979], [34, 155850], [37, 155937], [41, 156097], [45, 156237], [52, 156577], [55, 156857], [59, 157037], [64, 157317], [67, 157597], [74, 158077], [78, 158337], [83, 158637], [87, 158897]]}, {"verse": 22, "start": 159894, "end": 168793, "text": "And Zillah, she also bore Tubal-cain, an instructor of every artificer in brass and iron: and the sister of Tubal-cain was Naamah.", "words": [[0, 159894], [4, 160344], [12, 160794], [16, 160914], [21, 161254], [26, 162054], [38, 162854], [41, 163034], [52, 163414], [55, 163834], [61, 164174], [71, 164914], [74, 165054], [80, 165454], [84, 165854], [90, 166642], [94, 166771], [98, 166891], [105, 167191], [108, 167571], [119, 167951], [123, 168399]]}, {"verse": 23, "start": 169143, "end": 179816, "text": "And Lamech said to his wives, Adah and Zillah, Hear my voice; you wives of Lamech, hearken to my speech: for I have slain a man to my wounding, and a young man to my hurt.", "words": [[0, 169143], [4, 169287], [11, 169707], [16, 169927], [19, 170127], [23, 170287], [30, 171786], [35, 171906], [39, 172196], [47, 172486], [52, 172726], [55, 172926], [62, 173702], [66, 173847], [72, 174187], [75, 174607], [83, 175027], [91, 175447], [94, 175607], [97, 175767], [105, 176497], [109, 176598], [111, 176778], [116, 176898], [122, 177258], [124, 177338], [128, 177458], [131, 177658], [134, 177798], [144, 178318], [148, 178518], [150, 178678], [156, 178858], [160, 179058], [163, 179258], [166, 179398]]}, {"verse": 24, "start": 180166, "end": 184235, "text": "If Cain shall be avenged sevenfold, truly Lamech seventy and sevenfold.", "words": [[0, 180166], [3, 180355], [8, 180555], [14, 180815], [17, 180995], [25, 181625], [36, 182255], [42, 182628], [49, 183002], [57, 183375], [61, 183835]]}, {"verse": 25, "start": 184515, "end": 193839, "text": "¶ And Adam knew his wife again; and she bore a son, and called his name Seth: For God, said she, has appointed me another seed instead of Abel, whom Cain killed.", "words": [[2, 184515], [6, 184665], [11, 184985], [16, 185225], [20, 185385], [25, 185645], [32, 186385], [36, 186485], [40, 186605], [45, 186865], [47, 187025], [52, 187285], [56, 187485], [63, 187745], [67, 187965], [72, 188205], [78, 188855], [82, 188958], [87, 189378], [92, 189498], [97, 190398], [101, 190498], [111, 190838], [114, 191098], [122, 191358], [127, 191738], [135, 192078], [138, 192278], [144, 192758], [149, 192878], [154, 193278]]}, {"verse": 26, "start": 194119, "end": 202171, "text": "And to Seth, to him also there was born a son; and he called his name Enos: then began men to call upon the name of the LORD.", "words": [[0, 194119], [4, 194260], [7, 194400], [13, 194620], [16, 194900], [20, 195080], [25, 195663], [31, 195755], [35, 195935], [40, 196255], [42, 196395], [47, 197140], [51, 197264], [54, 197364], [61, 197624], [65, 197844], [70, 198124], [76, 199136], [81, 199461], [87, 199801], [91, 200121], [94, 200341], [99, 200621], [104, 200841], [108, 201101], [113, 201321], [116, 201481], [120, 201621]]}]}