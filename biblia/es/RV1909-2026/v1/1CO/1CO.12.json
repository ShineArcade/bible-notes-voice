{"book": "1CO", "chapter": 12, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 203194, "verses": [{"verse": 1, "start": 300, "end": 4880, "text": "Y acerca de los dones espirituales, no quiero, hermanos, que ignoréis.", "words": [[0, 300], [2, 424], [9, 744], [12, 1024], [16, 1144], [22, 1544], [36, 2504], [39, 2824], [47, 3224], [57, 3924], [61, 4124]]}, {"verse": 2, "start": 5230, "end": 10649, "text": "Sabéis que cuando erais paganos, ibais, como erais llevados, a los ídolos mudos.", "words": [[0, 5230], [7, 5668], [11, 5848], [18, 6128], [24, 6488], [33, 7388], [40, 8168], [45, 8368], [51, 8628], [61, 9168], [63, 9428], [67, 9588], [74, 10068]]}, {"verse": 3, "start": 10999, "end": 20276, "text": "Por tanto os hago saber, que nadie que hable por Espíritu de Dios, llama maldito a Jesús; y nadie puede llamar a Jesús Señor, sino por Espíritu Santo.", "words": [[0, 10999], [4, 11106], [10, 11586], [13, 11806], [18, 11966], [25, 12346], [29, 12686], [35, 13006], [39, 13306], [45, 13626], [49, 13806], [58, 14386], [61, 14466], [67, 14746], [73, 15306], [81, 15926], [83, 16026], [90, 16790], [92, 16911], [98, 17131], [104, 17391], [111, 17831], [113, 17891], [119, 18091], [126, 18871], [131, 19051], [135, 19271], [144, 19771]]}, {"verse": 4, "start": 20626, "end": 24231, "text": "Ahora bien, hay diversidad de dones; pero el Espíritu es el mismo.", "words": [[0, 20626], [6, 20844], [12, 21084], [16, 21244], [27, 21804], [30, 21944], [37, 22713], [42, 22855], [45, 22975], [54, 23475], [57, 23595], [60, 23715]]}, {"verse": 5, "start": 24581, "end": 28189, "text": "Y hay diversidad de ministerios; pero el Señor es el mismo.", "words": [[0, 24581], [2, 24723], [6, 24823], [17, 25403], [20, 25563], [33, 26701], [38, 26845], [41, 26985], [47, 27265], [50, 27545], [53, 27665]]}, {"verse": 6, "start": 28539, "end": 34226, "text": "Y hay diversidad de actividades; pero el mismo Dios es el que obra todas las cosas en todos.", "words": [[0, 28539], [2, 28680], [6, 28780], [17, 29340], [20, 29500], [33, 30630], [38, 30782], [41, 30922], [47, 31222], [52, 31582], [55, 31862], [58, 31982], [62, 32142], [67, 32402], [73, 32702], [77, 33002], [83, 33322], [86, 33602]]}, {"verse": 7, "start": 34576, "end": 38476, "text": "Pero a cada uno le es dada manifestación del Espíritu para provecho.", "words": [[0, 34576], [5, 34720], [7, 34880], [12, 35020], [16, 35340], [19, 35540], [22, 35700], [27, 35940], [41, 36760], [45, 36960], [54, 37580], [59, 37740]]}, {"verse": 8, "start": 38826, "end": 46514, "text": "Porque a la verdad, a este es dada por el Espíritu palabra de sabiduría; a otro, palabra de conocimiento según el mismo Espíritu;", "words": [[0, 38826], [7, 39074], [9, 39154], [12, 39194], [20, 39954], [22, 40234], [27, 40534], [30, 40734], [35, 41014], [39, 41194], [42, 41314], [51, 41794], [59, 42274], [62, 42374], [73, 43334], [75, 43453], [81, 43733], [89, 44213], [92, 44453], [105, 45173], [111, 45473], [114, 45653], [120, 45853]]}, {"verse": 9, "start": 46864, "end": 52215, "text": "A otro, fe por el mismo Espíritu; y a otro, dones de sanidades por el mismo Espíritu;", "words": [[0, 46864], [2, 47009], [8, 47269], [11, 47849], [15, 48089], [18, 48209], [24, 48429], [34, 49322], [36, 49447], [38, 49527], [44, 49787], [50, 50187], [53, 50307], [63, 50847], [67, 51107], [70, 51227], [76, 51447]]}, {"verse": 10, "start": 52565, "end": 63175, "text": "A otro, operaciones de milagros; y a otro, profecía; y a otro, discernimiento de espíritus; y a otro, géneros de lenguas; y a otro, interpretación de lenguas.", "words": [[0, 52565], [2, 52761], [8, 52991], [20, 53891], [23, 54111], [33, 55008], [35, 55133], [37, 55213], [43, 55433], [53, 56495], [55, 56618], [57, 56718], [63, 56998], [78, 57958], [81, 58118], [92, 59074], [94, 59220], [96, 59300], [102, 59940], [110, 60320], [113, 60420], [122, 61229], [124, 61351], [126, 61501], [132, 61651], [147, 62411], [150, 62551]]}, {"verse": 11, "start": 63525, "end": 69865, "text": "Pero todas estas cosas obra uno y el mismo Espíritu, repartiendo individualmente a cada uno como quiere.", "words": [[0, 63525], [5, 63643], [11, 63903], [17, 64203], [23, 64563], [28, 65023], [32, 65383], [34, 65643], [37, 65743], [43, 66023], [53, 67043], [65, 67643], [81, 68503], [83, 68663], [88, 68803], [92, 69103], [97, 69363]]}, {"verse": 12, "start": 70215, "end": 79339, "text": "Porque de la manera que el cuerpo es uno, y tiene muchos miembros, pero todos los miembros del cuerpo, siendo muchos, son un cuerpo, así también Cristo.", "words": [[0, 70215], [7, 70446], [10, 70606], [13, 70726], [20, 71006], [24, 71226], [27, 71366], [34, 71606], [37, 71906], [42, 72206], [44, 72606], [50, 72866], [57, 73166], [67, 74226], [72, 74426], [78, 74666], [82, 74866], [91, 75326], [95, 75466], [103, 76126], [110, 76406], [118, 77226], [122, 77366], [125, 77526], [133, 78126], [137, 78346], [145, 78646]]}, {"verse": 13, "start": 79689, "end": 89404, "text": "Porque por un Espíritu somos todos bautizados en un cuerpo, sean judíos o griegos, sean siervos o libres; y todos hemos bebido de un mismo Espíritu.", "words": [[0, 79689], [7, 79902], [11, 80162], [14, 80282], [23, 80882], [29, 81162], [35, 81522], [46, 82342], [49, 82582], [52, 82702], [60, 83522], [65, 83722], [72, 84402], [74, 84562], [83, 85322], [88, 85712], [96, 86102], [98, 86282], [106, 87099], [108, 87219], [114, 87399], [120, 87699], [127, 88239], [130, 88359], [133, 88459], [139, 88699]]}, {"verse": 14, "start": 89754, "end": 92814, "text": "Pues ni tampoco el cuerpo es un miembro, sino muchos.", "words": [[0, 89754], [5, 89944], [8, 90224], [16, 90564], [19, 90824], [26, 91024], [29, 91304], [32, 91444], [41, 91924], [46, 92164]]}, {"verse": 15, "start": 93164, "end": 98880, "text": "Si dice el pie: Como no soy mano, no soy parte del cuerpo», ¿por eso no sería parte del cuerpo?", "words": [[0, 93164], [3, 93347], [8, 93587], [11, 93727], [16, 94353], [21, 94515], [24, 94675], [28, 94895], [34, 95455], [37, 95555], [41, 95735], [47, 96015], [51, 96255], [60, 97035], [65, 97215], [69, 97395], [72, 97515], [78, 97735], [84, 98055], [88, 98315]]}, {"verse": 16, "start": 99230, "end": 104486, "text": "Y si dice la oreja: Como no soy ojo, no soy parte del cuerpo», ¿por eso no sería parte del cuerpo?", "words": [[0, 99230], [2, 99358], [5, 99478], [10, 99738], [13, 99918], [20, 100648], [25, 100810], [28, 100970], [32, 101170], [37, 101630], [40, 101710], [44, 101890], [50, 102130], [54, 102370], [63, 102870], [68, 102990], [72, 103150], [75, 103270], [81, 103470], [87, 103770], [91, 104010]]}, {"verse": 17, "start": 104836, "end": 111430, "text": "Si todo el cuerpo fuese ojo, ¿dónde estaría el oído? Si todo fuese oído, ¿dónde estaría el olfato?", "words": [[0, 104836], [3, 104985], [8, 105185], [11, 105345], [18, 105585], [24, 105945], [29, 106465], [36, 106665], [44, 107005], [47, 107105], [53, 108465], [56, 108648], [61, 108888], [67, 109268], [73, 110148], [80, 110428], [88, 110768], [91, 110868]]}, {"verse": 18, "start": 111780, "end": 115949, "text": "Pero ahora Dios ha colocado los miembros cada uno de ellos en el cuerpo, como quiso.", "words": [[0, 111780], [5, 111920], [11, 112200], [16, 112480], [19, 112680], [28, 113160], [32, 113300], [41, 113720], [46, 113920], [50, 114140], [53, 114300], [59, 114500], [62, 114660], [65, 114780], [73, 115320], [78, 115460]]}, {"verse": 19, "start": 116299, "end": 118936, "text": "Que si todos fueran un miembro, ¿dónde estuviera el cuerpo?", "words": [[0, 116299], [4, 116379], [7, 116499], [13, 116719], [20, 117119], [23, 117199], [32, 117819], [39, 117999], [49, 118359], [52, 118459]]}, {"verse": 20, "start": 119286, "end": 122446, "text": "Pero ahora son muchos los miembros, pero el cuerpo es uno solo.", "words": [[0, 119286], [5, 119423], [11, 119643], [15, 119923], [22, 120243], [26, 120443], [36, 121023], [41, 121143], [44, 121263], [51, 121503], [54, 121763], [58, 121923]]}, {"verse": 21, "start": 122796, "end": 130145, "text": "Ni el ojo puede decir a la mano: No te necesito: ni asimismo la cabeza a los pies: No tengo necesidad de vosotros.", "words": [[0, 122796], [3, 122922], [6, 123062], [10, 123302], [16, 123522], [22, 123882], [24, 124042], [27, 124122], [33, 124770], [36, 124928], [39, 125028], [49, 125991], [52, 126118], [61, 126638], [64, 126758], [71, 127118], [73, 127338], [77, 127458], [83, 128234], [86, 128411], [92, 128711], [102, 129311], [105, 129431]]}, {"verse": 22, "start": 130495, "end": 135155, "text": "Antes, mucho más los miembros del cuerpo que parecen más débiles, son necesarios;", "words": [[0, 130495], [7, 130901], [13, 131221], [17, 131461], [21, 131641], [30, 132081], [34, 132201], [41, 132521], [45, 132721], [53, 133101], [57, 133341], [66, 133761], [70, 134201]]}, {"verse": 23, "start": 135505, "end": 145446, "text": "Y a aquellos del cuerpo que consideramos menos honrosos, a estos vestimos más dignamente; y a los que en nosotros son menos presentables, los tratamos con mayor decoro.", "words": [[0, 135505], [2, 135546], [4, 135626], [13, 135926], [17, 136146], [24, 136386], [28, 136566], [41, 137206], [47, 137706], [57, 138206], [59, 138626], [65, 138866], [74, 139386], [78, 139626], [90, 140888], [92, 141008], [94, 141068], [98, 141228], [102, 141318], [105, 141408], [114, 141728], [118, 142188], [124, 142428], [138, 143708], [142, 143888], [151, 144348], [155, 144568], [161, 144828]]}, {"verse": 24, "start": 145796, "end": 154325, "text": "Porque los que en nosotros son más presentables, no tienen necesidad: pero Dios ordenó el cuerpo, dando más abundante honor al que le faltaba;", "words": [[0, 145796], [7, 145976], [11, 146176], [15, 146266], [18, 146356], [27, 146716], [31, 147116], [35, 147296], [49, 148056], [52, 148496], [59, 148756], [70, 149816], [75, 149953], [80, 150193], [87, 150753], [90, 150893], [98, 151713], [104, 151973], [108, 152293], [118, 152933], [124, 153193], [127, 153413], [131, 153553], [134, 153653]]}, {"verse": 25, "start": 154675, "end": 160624, "text": "Para que no haya desavenencia en el cuerpo, sino que los miembros todos se interesen los unos por los otros.", "words": [[0, 154675], [5, 154839], [9, 154999], [12, 155179], [17, 155379], [30, 156179], [33, 156299], [36, 156399], [44, 157039], [49, 157339], [53, 157519], [57, 157659], [66, 158139], [72, 158399], [75, 158739], [85, 159239], [89, 159379], [94, 159639], [98, 159899], [102, 160059]]}, {"verse": 26, "start": 160974, "end": 168902, "text": "Por manera que si un miembro padece, todos los miembros a una se duelen; y si un miembro es honrado, todos los miembros a una se gozan.", "words": [[0, 160974], [4, 161067], [11, 161287], [15, 161507], [18, 161667], [21, 161827], [29, 162167], [37, 163067], [43, 163187], [47, 163467], [56, 163720], [58, 163974], [62, 164227], [65, 164447], [73, 165244], [75, 165362], [78, 165462], [81, 165602], [89, 165942], [92, 166062], [101, 166962], [107, 167122], [111, 167382], [120, 167609], [122, 167835], [126, 168062], [129, 168302]]}, {"verse": 27, "start": 169252, "end": 174318, "text": "Pues vosotros sois el cuerpo de Cristo, y cada uno de vosotros es miembro de él.", "words": [[0, 169252], [5, 169461], [14, 170101], [19, 170461], [22, 170561], [29, 170861], [32, 171081], [40, 171901], [42, 171941], [47, 172181], [51, 172441], [54, 172581], [63, 173061], [66, 173381], [74, 173861], [77, 174001]]}, {"verse": 28, "start": 174668, "end": 187386, "text": "Y a unos puso Dios en la iglesia, primeramente apóstoles, luego profetas, lo tercero maestros; luego los que hacen milagros; luego dones de sanidades, ayudas, capacidades de dirección, géneros de lenguas.", "words": [[0, 174668], [2, 174786], [4, 174866], [9, 175066], [14, 175506], [19, 175846], [22, 175986], [25, 176086], [34, 176906], [47, 177526], [58, 178366], [64, 178586], [74, 179526], [77, 179626], [85, 180086], [95, 181046], [101, 181235], [105, 181455], [109, 181595], [115, 181775], [125, 182695], [131, 182836], [137, 183236], [140, 183336], [151, 184216], [159, 184756], [171, 185316], [174, 185476], [185, 186336], [193, 186736], [196, 186836]]}, {"verse": 29, "start": 187736, "end": 193314, "text": "¿Son todos apóstoles? ¿son todos profetas? ¿todos maestros? ¿hacen todos milagros?", "words": [[0, 187736], [5, 187902], [11, 188182], [22, 189222], [27, 189394], [33, 189654], [43, 190674], [50, 190813], [60, 191943], [67, 192184], [73, 192444]]}, {"verse": 30, "start": 193664, "end": 198069, "text": "¿Tienen todos dones de sanidad? ¿hablan todos lenguas? ¿interpretan todos?", "words": [[0, 193664], [8, 193850], [14, 194110], [20, 194630], [23, 194730], [32, 195467], [40, 195769], [46, 195989], [55, 196937], [68, 197556]]}, {"verse": 31, "start": 198419, "end": 202794, "text": "Pero procurad los mejores dones: pero aun yo os muestro un camino más excelente.", "words": [[0, 198419], [5, 198718], [14, 199058], [18, 199198], [26, 199538], [33, 200375], [38, 200518], [42, 200748], [45, 200978], [48, 201208], [56, 201438], [59, 201538], [66, 201838], [70, 202038]]}]}