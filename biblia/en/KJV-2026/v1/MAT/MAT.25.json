{"book": "MAT", "chapter": 25, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 307587, "verses": [{"verse": 1, "start": 300, "end": 6789, "text": "Then shall the kingdom of heaven be likened to ten virgins, which took their lamps, and went forth to meet the bridegroom.", "words": [[0, 300], [5, 528], [11, 808], [15, 968], [23, 1228], [26, 1448], [33, 1708], [36, 1968], [44, 2408], [47, 2488], [51, 2688], [60, 3528], [66, 3688], [71, 3908], [77, 4128], [84, 4928], [88, 5068], [93, 5248], [99, 5568], [102, 5828], [107, 5968], [111, 6128]]}, {"verse": 2, "start": 7139, "end": 9968, "text": "And five of them were wise, and five were foolish.", "words": [[0, 7139], [4, 7265], [9, 7505], [12, 7665], [17, 7845], [22, 7965], [28, 8345], [32, 8845], [37, 9125], [42, 9345]]}, {"verse": 3, "start": 10317, "end": 13557, "text": "They that were foolish took their lamps, and took no oil with them:", "words": [[0, 10317], [5, 10421], [10, 10561], [15, 10701], [23, 11021], [28, 11301], [34, 11501], [41, 11861], [45, 12321], [50, 12521], [53, 12721], [57, 13001], [62, 13261]]}, {"verse": 4, "start": 13907, "end": 16544, "text": "But the wise took oil in their vessels with their lamps.", "words": [[0, 13907], [4, 14007], [8, 14127], [13, 14407], [18, 14707], [22, 15027], [25, 15247], [31, 15347], [39, 15627], [44, 15907], [50, 16007]]}, {"verse": 5, "start": 16894, "end": 19891, "text": "While the bridegroom was delayed, they all slumbered and slept.", "words": [[0, 16894], [6, 16999], [10, 17119], [21, 17579], [25, 17739], [34, 18519], [39, 18639], [43, 18759], [53, 19299], [57, 19379]]}, {"verse": 6, "start": 20241, "end": 25228, "text": "And at mid night there was a cry made Behold the bridegroom comes go you out to meet him", "words": [[0, 20241], [4, 20363], [7, 20550], [11, 20736], [17, 20923], [23, 21263], [27, 21423], [29, 21543], [33, 21903], [38, 22183], [45, 22828], [49, 22888], [60, 23488], [66, 23888], [69, 24088], [73, 24248], [77, 24468], [80, 24668], [85, 24848]]}, {"verse": 7, "start": 25578, "end": 28832, "text": "Then all those virgins arose, and trimmed their lamps.", "words": [[0, 25578], [5, 25717], [9, 25937], [15, 26157], [23, 26617], [30, 27077], [34, 27637], [42, 27937], [48, 28177]]}, {"verse": 8, "start": 29182, "end": 33570, "text": "And the foolish said to the wise, Give us of your oil; for our lamps are gone out.", "words": [[0, 29182], [4, 29300], [8, 29400], [16, 29680], [21, 30000], [24, 30160], [28, 30260], [34, 30960], [39, 31100], [42, 31260], [45, 31380], [50, 31500], [55, 32150], [59, 32274], [63, 32414], [69, 32714], [73, 32894], [78, 33074]]}, {"verse": 9, "start": 33920, "end": 41820, "text": "But the wise answered, saying, Not so; lest there be not enough for us and you: but go rather to them that sell, and buy for yourselves.", "words": [[0, 33920], [4, 34000], [8, 34120], [13, 34340], [23, 34780], [31, 35360], [35, 35580], [39, 36288], [44, 36471], [50, 36631], [53, 36731], [57, 36931], [64, 37171], [68, 37391], [71, 37551], [75, 37691], [80, 38256], [84, 38376], [87, 38596], [94, 38876], [97, 39116], [102, 39356], [107, 39576], [113, 39996], [117, 40496], [121, 40836], [125, 41056]]}, {"verse": 10, "start": 42170, "end": 48810, "text": "And while they went to buy, the bridegroom came; and they that were ready went in with him to the marriage: and the door was shut.", "words": [[0, 42170], [4, 42275], [10, 42475], [15, 42655], [20, 42815], [23, 42955], [28, 43575], [32, 43675], [43, 44175], [49, 44765], [53, 44945], [58, 45105], [63, 45305], [68, 45425], [74, 45705], [79, 45985], [82, 46205], [87, 46385], [91, 46545], [94, 46665], [98, 46785], [108, 47617], [112, 47736], [116, 47836], [121, 48116], [125, 48316]]}, {"verse": 11, "start": 49160, "end": 53217, "text": "Afterward came also the other virgins, saying, Lord, Lord, open to us.", "words": [[0, 49160], [10, 49538], [15, 49818], [20, 50118], [24, 50318], [30, 50498], [39, 50958], [47, 51538], [53, 52098], [59, 52418], [64, 52638], [67, 52898]]}, {"verse": 12, "start": 53567, "end": 57218, "text": "But he answered and said, Assuredly I say to you, I know you not.", "words": [[0, 53567], [4, 53673], [7, 53773], [16, 54113], [20, 54353], [26, 54813], [36, 55453], [38, 55533], [42, 55713], [45, 55873], [50, 56293], [52, 56413], [57, 56613], [61, 56773]]}, {"verse": 13, "start": 57568, "end": 62375, "text": "Watch therefore, for you know neither the day nor the hour in which the Son of man comes.", "words": [[0, 57568], [6, 57861], [17, 58361], [21, 58661], [25, 58801], [30, 59001], [38, 59221], [42, 59461], [46, 59741], [50, 59981], [54, 60141], [59, 60461], [62, 60701], [68, 60861], [72, 61061], [76, 61301], [79, 61401], [83, 61681]]}, {"verse": 14, "start": 62725, "end": 69508, "text": "¶ For the kingdom of heaven is as a man travelling into a far country, who called his own servants, and delivered to them his goods.", "words": [[2, 62725], [6, 62835], [10, 62935], [18, 63235], [21, 63475], [28, 63735], [31, 63995], [34, 64155], [36, 64275], [40, 64655], [51, 65035], [56, 65355], [58, 65535], [62, 65775], [71, 66215], [75, 66430], [82, 66710], [86, 66930], [90, 67110], [100, 67510], [104, 68050], [114, 68370], [117, 68590], [122, 68790], [126, 68950]]}, {"verse": 15, "start": 69858, "end": 78542, "text": "And to one he gave five talents, to another two, and to another one; to every man according to his several ability; and immediately took his journey.", "words": [[0, 69858], [4, 70039], [7, 70199], [11, 70519], [14, 70759], [19, 70939], [24, 71279], [33, 72139], [36, 72239], [44, 72519], [49, 73159], [53, 73299], [56, 73499], [64, 73739], [69, 74383], [72, 74503], [78, 74763], [82, 75083], [92, 75423], [95, 75683], [99, 75823], [107, 76083], [116, 76937], [120, 77082], [132, 77422], [137, 77882], [141, 78082]]}, {"verse": 16, "start": 78892, "end": 84698, "text": "Then he that had received the five talents went and traded with the same, and made them other five talents.", "words": [[0, 78892], [5, 79036], [8, 79336], [13, 79676], [17, 79816], [26, 80196], [30, 80436], [35, 80676], [43, 81076], [48, 81376], [52, 81636], [59, 81916], [64, 82136], [68, 82316], [74, 82636], [78, 83116], [83, 83316], [88, 83536], [94, 83756], [99, 84076]]}, {"verse": 17, "start": 85048, "end": 88753, "text": "And likewise he that had received two, he also gained other two.", "words": [[0, 85048], [4, 85173], [13, 85793], [16, 85893], [21, 86053], [25, 86213], [34, 86493], [39, 87293], [42, 87413], [47, 87673], [54, 88013], [60, 88293]]}, {"verse": 18, "start": 89103, "end": 93630, "text": "But he that had received one went and dug in the earth, and hid his lord’s money.", "words": [[0, 89103], [4, 89205], [7, 89405], [12, 89605], [16, 89745], [25, 90105], [29, 90505], [34, 90925], [38, 91165], [42, 91425], [45, 91585], [49, 91705], [56, 92005], [60, 92365], [64, 92625], [68, 92825], [75, 93265]]}, {"verse": 19, "start": 93980, "end": 98047, "text": "After a long time the lord of those servants comes, and reckons with them.", "words": [[0, 93980], [6, 94222], [8, 94402], [13, 94582], [18, 95262], [22, 95342], [27, 95602], [30, 95722], [36, 95882], [45, 96242], [52, 96622], [56, 97082], [64, 97522], [69, 97722]]}, {"verse": 20, "start": 98397, "end": 109262, "text": "And so he that had received five talents came and brought other five talents, saying, Lord, you delivered to me five talents: behold, I have gained beside them five talents more.", "words": [[0, 98397], [4, 98517], [7, 98817], [10, 99137], [15, 99437], [19, 99617], [28, 100017], [33, 100457], [41, 100877], [46, 101217], [50, 101437], [58, 101637], [64, 101917], [69, 102197], [78, 102737], [86, 103417], [92, 104017], [96, 104077], [106, 104417], [109, 104657], [112, 104797], [117, 105097], [126, 105994], [134, 106775], [136, 106955], [141, 107095], [148, 107375], [155, 107655], [160, 108035], [165, 108335], [173, 108715]]}, {"verse": 21, "start": 109612, "end": 120539, "text": "His lord said to him, Well done, you good and faithful servant: you have been faithful over a few things, I will make you ruler over many things: enter into the joy of your lord.", "words": [[0, 109662], [4, 109752], [9, 109972], [14, 110252], [17, 110452], [22, 110952], [27, 111292], [33, 112052], [37, 112192], [42, 112532], [46, 112772], [55, 113152], [64, 113995], [68, 114136], [73, 114316], [78, 114516], [87, 114936], [92, 115236], [94, 115416], [98, 115576], [106, 116236], [108, 116416], [113, 116576], [118, 116776], [122, 116956], [128, 117276], [133, 117596], [138, 117896], [146, 118729], [152, 118989], [157, 119329], [161, 119489], [165, 119789], [168, 119969], [173, 120069]]}, {"verse": 22, "start": 120889, "end": 130327, "text": "He also that had received two talents came and said, Lord, you delivered to me two talents: behold, I have gained two other talents beside them.", "words": [[0, 120889], [3, 120988], [8, 121328], [13, 121608], [17, 121748], [26, 122088], [30, 122388], [38, 122788], [43, 123168], [47, 123408], [53, 124028], [59, 124848], [63, 124948], [73, 125308], [76, 125548], [79, 125728], [83, 125968], [92, 126883], [100, 127685], [102, 127945], [107, 128105], [114, 128425], [118, 128725], [124, 129005], [132, 129425], [139, 129825]]}, {"verse": 23, "start": 130677, "end": 142056, "text": "His lord said to him, Well done, good and faithful servant; you have been faithful over a few things, I will make you ruler over many things: enter into the joy of your lord.", "words": [[0, 130740], [4, 130830], [9, 131070], [14, 131350], [17, 131550], [22, 132070], [27, 132430], [33, 133230], [38, 133770], [42, 133837], [51, 133903], [60, 135424], [64, 135624], [69, 135804], [74, 135964], [83, 136364], [88, 136664], [90, 136864], [94, 136984], [102, 137764], [104, 138024], [109, 138164], [114, 138364], [118, 138524], [124, 138864], [129, 139184], [134, 139464], [142, 140371], [148, 140636], [153, 140876], [157, 141036], [161, 141296], [164, 141476], [169, 141576]]}, {"verse": 24, "start": 142336, "end": 153465, "text": "Then he which had received the one talent came and said, Lord, I knew you that you are a hard man, reaping where you have not sown, and gathering where you have not scattered:", "words": [[0, 142336], [5, 142600], [8, 143100], [14, 143280], [18, 143480], [27, 143860], [31, 144180], [35, 144420], [42, 144980], [47, 145200], [51, 145540], [57, 146176], [63, 146663], [65, 146863], [70, 147163], [74, 147643], [79, 147803], [83, 148003], [87, 148203], [89, 148303], [94, 148563], [99, 149403], [107, 149863], [113, 150023], [117, 150183], [122, 150323], [126, 150523], [132, 151423], [136, 151543], [146, 151903], [152, 152243], [156, 152423], [161, 152563], [165, 152763]]}, {"verse": 25, "start": 153815, "end": 159594, "text": "And I was afraid, and went and hid your talent in the earth: lo, there you have that is yours.", "words": [[0, 153815], [4, 153974], [6, 154134], [10, 154294], [18, 154994], [22, 155354], [27, 155594], [31, 155874], [35, 156054], [40, 156234], [47, 156594], [50, 156814], [54, 156954], [61, 157683], [65, 158033], [71, 158133], [75, 158313], [80, 158753], [85, 158833], [88, 158993]]}, {"verse": 26, "start": 159944, "end": 168166, "text": "His lord answered and said to him, You wicked and slothful servant, you knew that I reap where I sowed not, and gather where I have not scattered:", "words": [[0, 159944], [4, 160104], [9, 160344], [18, 160804], [22, 161044], [27, 161244], [30, 161404], [35, 162084], [39, 162344], [46, 162704], [50, 162924], [59, 163424], [68, 164304], [72, 164384], [77, 164584], [82, 164784], [84, 164924], [89, 165144], [95, 165384], [97, 165544], [103, 165904], [108, 166444], [112, 166584], [119, 166864], [125, 167104], [127, 167264], [132, 167404], [136, 167564]]}, {"verse": 27, "start": 168516, "end": 175887, "text": "You ought therefore to have put my money to the exchangers, and then at my coming I should have received my own with usury.", "words": [[0, 168516], [4, 168694], [10, 168894], [20, 169354], [23, 169574], [28, 169734], [32, 169954], [35, 170174], [41, 170494], [44, 170654], [48, 170794], [60, 172014], [64, 172214], [69, 172414], [72, 172574], [75, 172734], [82, 173094], [84, 173554], [91, 173734], [96, 173854], [105, 174214], [108, 174574], [112, 174934], [117, 175194]]}, {"verse": 28, "start": 176237, "end": 180798, "text": "Take therefore the talent from him, and give it to him which has ten talents.", "words": [[0, 176237], [5, 176433], [15, 176873], [19, 177133], [26, 177473], [31, 177753], [36, 178393], [40, 178593], [45, 178773], [48, 178913], [51, 179093], [55, 179333], [61, 179553], [65, 179793], [69, 180093]]}, {"verse": 29, "start": 181148, "end": 189217, "text": "For to every one that has shall be given, and he shall have abundance: but from him that has not shall be taken away even that which he has.", "words": [[0, 181148], [4, 181257], [7, 181404], [13, 181550], [17, 181697], [22, 182137], [26, 182357], [32, 182637], [35, 182837], [42, 183397], [46, 183657], [49, 183817], [55, 184037], [60, 184237], [71, 185219], [75, 185316], [80, 185516], [84, 185736], [89, 185936], [93, 186076], [97, 186396], [103, 186856], [106, 187016], [112, 187276], [117, 187616], [122, 188016], [127, 188316], [133, 188516], [136, 188676]]}, {"verse": 30, "start": 189567, "end": 194862, "text": "And cast the unprofitable servant into outer darkness: there shall be weeping and gnashing of teeth.", "words": [[0, 189567], [4, 189670], [9, 189970], [13, 190170], [26, 190890], [34, 191290], [39, 191650], [45, 191930], [55, 192908], [61, 192992], [67, 193152], [70, 193312], [78, 193732], [82, 193932], [91, 194352], [94, 194512]]}, {"verse": 31, "start": 195212, "end": 203215, "text": "¶ When the Son of man shall come in his glory, and all the holy angels with him, then shall he sit upon the throne of his glory:", "words": [[2, 195212], [7, 195382], [11, 195502], [15, 195782], [18, 195902], [22, 196242], [28, 196542], [33, 196802], [36, 196942], [40, 197082], [47, 197942], [51, 198102], [55, 198462], [59, 198622], [64, 198882], [71, 199342], [76, 199682], [81, 200262], [86, 200602], [92, 200922], [95, 201102], [99, 201382], [104, 201722], [108, 202002], [115, 202322], [118, 202542], [122, 202662]]}, {"verse": 32, "start": 203565, "end": 210975, "text": "And before him shall be gathered all nations: and he shall separate them one from another, as a shepherd divides his sheep from the goats:", "words": [[0, 203565], [4, 203686], [11, 203986], [15, 204226], [21, 204446], [24, 204586], [33, 204906], [37, 205266], [46, 206185], [50, 206290], [53, 206410], [59, 206590], [68, 207030], [73, 207330], [77, 207570], [82, 207790], [91, 208410], [94, 208750], [96, 208850], [105, 209130], [113, 209530], [117, 209850], [123, 210110], [128, 210350], [132, 210510]]}, {"verse": 33, "start": 211325, "end": 215255, "text": "And he shall set the sheep on his right hand, but the goats on the left.", "words": [[0, 211325], [4, 211450], [7, 211610], [13, 211810], [17, 212070], [21, 212250], [27, 212490], [30, 212710], [34, 212890], [40, 213110], [46, 213810], [50, 214050], [54, 214190], [60, 214410], [63, 214670], [67, 214790]]}, {"verse": 34, "start": 215605, "end": 224429, "text": "Then shall the King say to them on his right hand, Come, you blessed of my Father, inherit the kingdom prepared for you from the foundation of the world:", "words": [[0, 215605], [5, 215841], [11, 216121], [15, 216301], [20, 216501], [24, 216801], [27, 216981], [32, 217181], [35, 217341], [39, 217541], [45, 217741], [51, 218541], [57, 219301], [61, 219401], [69, 219701], [72, 219921], [75, 220101], [83, 220941], [91, 221221], [95, 221521], [103, 221801], [112, 222201], [116, 222541], [120, 222701], [125, 222901], [129, 223041], [140, 223541], [143, 223781], [147, 223901]]}, {"verse": 35, "start": 224779, "end": 231857, "text": "For I was hungry, and you gave me food: I was thirsty, and you gave me drink: I was a stranger, and you took me in:", "words": [[0, 224779], [4, 224917], [6, 225117], [10, 225277], [18, 225857], [22, 226197], [26, 226317], [31, 226477], [34, 226637], [40, 227411], [42, 227532], [46, 227692], [55, 228112], [59, 228512], [63, 228612], [68, 228772], [71, 228932], [78, 229772], [80, 229952], [84, 230092], [86, 230192], [96, 230632], [100, 231012], [104, 231132], [109, 231272], [112, 231472]]}, {"verse": 36, "start": 232207, "end": 237691, "text": "Naked, and you clothed me: I was sick, and you visited me: I was in prison, and you came to me.", "words": [[0, 232207], [7, 232587], [11, 232947], [15, 233187], [23, 233427], [27, 233938], [29, 234082], [33, 234262], [39, 234542], [43, 234742], [47, 234862], [55, 235142], [59, 235811], [61, 235955], [65, 236095], [68, 236255], [76, 236535], [80, 236815], [84, 236955], [89, 237195], [92, 237395]]}, {"verse": 37, "start": 238041, "end": 244686, "text": "Then shall the righteous answer him, saying, Lord, when saw we you hungry, and fed you? or thirsty, and gave you drink?", "words": [[0, 238041], [5, 238224], [11, 238484], [15, 238644], [25, 238924], [32, 239364], [37, 239684], [45, 240124], [51, 240884], [56, 241024], [60, 241284], [63, 241484], [67, 241604], [75, 241964], [79, 242184], [83, 242424], [88, 243060], [91, 243180], [100, 243560], [104, 243880], [109, 244080], [113, 244220]]}, {"verse": 38, "start": 245036, "end": 249335, "text": "When saw we you a stranger, and took you in? or naked, and clothed you?", "words": [[0, 245036], [5, 245176], [9, 245456], [12, 245696], [16, 245876], [18, 245996], [28, 246436], [32, 246856], [37, 247056], [41, 247216], [45, 247845], [48, 247969], [55, 248329], [59, 248529], [67, 249069]]}, {"verse": 39, "start": 249685, "end": 252946, "text": "Or when saw we you sick, or in prison, and came to you?", "words": [[0, 249685], [3, 249808], [8, 250008], [12, 250268], [15, 250488], [19, 250648], [25, 250988], [28, 251388], [31, 251528], [39, 251828], [43, 252208], [48, 252448], [51, 252628]]}, {"verse": 40, "start": 253296, "end": 262293, "text": "And the King shall answer and say to them, Assuredly I say to you, Inasmuch as you have done it to one of the least of these my brethren, you have done it to me.", "words": [[0, 253296], [4, 253438], [8, 253558], [13, 253798], [19, 254058], [26, 254458], [30, 254658], [34, 254898], [37, 255058], [43, 255618], [53, 256258], [55, 256458], [59, 256678], [62, 256878], [67, 257698], [76, 258098], [79, 258258], [83, 258398], [88, 258498], [93, 258718], [96, 258818], [99, 258958], [103, 259098], [106, 259218], [110, 259318], [116, 259598], [119, 259778], [125, 260138], [128, 260218], [138, 261051], [142, 261233], [147, 261433], [152, 261673], [155, 261813], [158, 261973]]}, {"verse": 41, "start": 262643, "end": 270624, "text": "Then shall he say also to them on the left hand, Depart from me, you cursed, into everlasting fire, prepared for the devil and his angels:", "words": [[0, 262643], [5, 262848], [11, 263108], [14, 263268], [18, 263468], [23, 263808], [26, 264008], [31, 264188], [34, 264368], [38, 264488], [43, 264688], [49, 265368], [56, 265628], [61, 265948], [65, 266268], [69, 266388], [77, 267128], [82, 267268], [94, 267728], [100, 268748], [109, 269048], [113, 269268], [117, 269388], [123, 269668], [127, 269868], [131, 270028]]}, {"verse": 42, "start": 270974, "end": 275885, "text": "For I was hungry, and you gave me no food: I was thirsty, and you gave me no drink:", "words": [[0, 270974], [4, 271174], [6, 271434], [10, 271574], [18, 271954], [22, 272374], [26, 272474], [31, 272634], [34, 272794], [37, 272954], [43, 273731], [45, 273840], [49, 273980], [58, 274380], [62, 274780], [66, 274900], [71, 275040], [74, 275200], [77, 275360]]}, {"verse": 43, "start": 276235, "end": 283554, "text": "I was a stranger, and you took me not in: naked, and you clothed me not: sick, and in prison, and you visited me not.", "words": [[0, 276235], [2, 276341], [6, 276441], [8, 276541], [18, 276941], [22, 277501], [26, 277621], [31, 277761], [34, 277921], [38, 278101], [42, 278821], [49, 279251], [53, 279551], [57, 279671], [65, 280271], [68, 280391], [73, 281159], [79, 281482], [83, 281682], [86, 281822], [94, 282122], [98, 282382], [102, 282502], [110, 282822], [113, 283102]]}, {"verse": 44, "start": 283904, "end": 293593, "text": "Then shall they also answer him, saying, Lord, when saw we you hungry, or thirsty, or a stranger, or naked, or sick, or in prison, and did not minister to you?", "words": [[0, 283904], [5, 284138], [11, 284378], [16, 284558], [21, 284858], [28, 285278], [33, 285698], [41, 286198], [47, 286938], [52, 287098], [56, 287398], [59, 287598], [63, 287758], [71, 288358], [74, 288418], [83, 289158], [86, 289178], [88, 289198], [98, 290038], [101, 290078], [108, 290638], [111, 290698], [117, 291198], [120, 291238], [123, 291358], [131, 292158], [135, 292266], [139, 292406], [143, 292586], [152, 293006], [155, 293266]]}, {"verse": 45, "start": 293943, "end": 301428, "text": "Then shall he answer them, saying, Assuredly I say to you, Inasmuch as you did it not to one of the least of these, you did it not to me.", "words": [[0, 293943], [5, 294115], [11, 294415], [14, 294575], [21, 294875], [27, 295215], [35, 295855], [45, 296435], [47, 296575], [51, 296815], [54, 296975], [59, 297515], [68, 298035], [71, 298195], [75, 298315], [79, 298495], [82, 298595], [86, 298795], [89, 298995], [93, 299135], [96, 299235], [100, 299335], [106, 299535], [109, 299695], [116, 300275], [120, 300395], [124, 300555], [127, 300675], [131, 300875], [134, 301075]]}, {"verse": 46, "start": 301778, "end": 307187, "text": "And these shall go away into everlasting punishment: but the righteous into life eternal.", "words": [[0, 301778], [4, 301919], [10, 302139], [16, 302439], [19, 302639], [24, 303039], [29, 303399], [41, 303899], [53, 305127], [57, 305213], [61, 305353], [71, 305773], [76, 306133], [81, 306473]]}]}