{"book": "GEN", "chapter": 43, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 333866, "verses": [{"verse": 1, "start": 300, "end": 2464, "text": "Y el hambre era grande en la tierra.", "words": [[0, 300], [2, 422], [5, 542], [12, 882], [16, 1102], [23, 1522], [26, 1662], [29, 1802]]}, {"verse": 2, "start": 2814, "end": 12050, "text": "Y aconteció que como acabaron de comer el trigo que trajeron de Egipto, les dijo su padre: Volved, y comprad para nosotros un poco de alimento.", "words": [[0, 2814], [2, 3004], [12, 3604], [16, 3784], [21, 4064], [30, 4624], [33, 4804], [39, 5064], [42, 5304], [48, 5724], [52, 5864], [61, 6424], [64, 6584], [72, 7544], [76, 7724], [81, 8024], [84, 8204], [91, 9224], [99, 9464], [101, 9644], [109, 9824], [114, 10124], [123, 10604], [126, 11044], [131, 11264], [134, 11444]]}, {"verse": 3, "start": 12330, "end": 20768, "text": "Y respondió Judá, diciendo: Aquel varón nos advirtió solemnemente, diciendo: No veréis mi rostro sin vuestro hermano con vosotros.", "words": [[0, 12330], [2, 12434], [12, 13094], [18, 13554], [28, 14482], [34, 14812], [40, 15152], [44, 15292], [53, 15792], [67, 16612], [77, 17622], [80, 17784], [87, 18164], [90, 18324], [97, 18804], [101, 19004], [109, 19404], [117, 19844], [121, 19984]]}, {"verse": 4, "start": 21118, "end": 25451, "text": "Si envías a nuestro hermano con nosotros, descenderemos y te compraremos alimento:", "words": [[0, 21118], [3, 21282], [10, 21642], [12, 21742], [20, 21922], [28, 22422], [32, 22542], [42, 23262], [56, 23802], [58, 24002], [61, 24102], [73, 24682]]}, {"verse": 5, "start": 25801, "end": 33094, "text": "Pero si no le envías, no descenderemos: porque aquel varón nos dijo: No veréis mi rostro sin vuestro hermano con vosotros.", "words": [[0, 25801], [5, 25941], [8, 26121], [11, 26261], [14, 26401], [22, 26981], [25, 27081], [40, 28061], [47, 28277], [53, 28697], [59, 29017], [63, 29177], [69, 29948], [72, 30110], [79, 30490], [82, 30650], [89, 31130], [93, 31330], [101, 31730], [109, 32170], [113, 32310]]}, {"verse": 6, "start": 33374, "end": 39044, "text": "Y dijo Israel: ¿Por qué me hicisteis tanto mal, diciendo al varón que teníais más hermano?", "words": [[0, 33374], [2, 33576], [7, 33816], [15, 34716], [20, 34840], [24, 35020], [27, 35160], [37, 35760], [43, 35940], [48, 36680], [57, 37200], [60, 37340], [66, 37660], [70, 37920], [78, 38180], [82, 38440]]}, {"verse": 7, "start": 39324, "end": 57091, "text": "Y ellos respondieron: Aquel varón nos preguntó expresamente por nosotros, y por nuestra familia, diciendo: ¿Vive aún vuestro padre? ¿tenéis otro hermano? y le respondimos conforme a estas palabras. ¿Podíamos nosotros saber que había de decir: Haced venir a vuestro hermano?", "words": [[0, 39324], [2, 39484], [8, 39764], [22, 41102], [28, 41421], [34, 41760], [38, 41900], [47, 42460], [60, 43080], [64, 43340], [74, 43820], [76, 44080], [80, 44280], [88, 44480], [97, 45101], [107, 46122], [113, 46376], [117, 46666], [125, 47006], [132, 47853], [140, 48218], [145, 48478], [154, 49513], [156, 49637], [159, 49737], [171, 50477], [180, 50847], [182, 51217], [188, 51397], [198, 52430], [208, 52794], [217, 53234], [223, 53674], [227, 53874], [233, 54074], [236, 54294], [243, 55311], [249, 55511], [255, 55931], [257, 56151], [265, 56491]]}, {"verse": 8, "start": 57441, "end": 69430, "text": "Entonces Judá dijo a Israel su padre: Envía al joven conmigo, y nos levantaremos e iremos, a fin de que vivamos y no muramos nosotros, y tú, y nuestros niños.", "words": [[0, 57441], [9, 58368], [14, 59168], [19, 59278], [21, 59388], [28, 60088], [31, 60168], [38, 60932], [44, 61350], [47, 61510], [53, 61830], [62, 62390], [64, 62870], [68, 62990], [81, 63730], [83, 63990], [91, 64530], [93, 64990], [97, 65190], [100, 65350], [104, 65470], [112, 65910], [114, 66150], [117, 66270], [125, 66650], [135, 67150], [137, 67750], [141, 67990], [143, 68450], [152, 68670]]}, {"verse": 9, "start": 69780, "end": 78704, "text": "Yo respondo por él; a mí me pedirás cuenta de él: si yo no te lo devuelvo y lo pongo delante de ti, seré para ti el culpable todos los días:", "words": [[0, 69780], [3, 69946], [12, 70486], [16, 70686], [20, 71182], [22, 71286], [25, 71426], [28, 71566], [36, 72026], [43, 72306], [46, 72566], [50, 73136], [53, 73232], [56, 73392], [59, 73492], [62, 73652], [65, 73792], [74, 74312], [76, 74372], [79, 74492], [85, 74832], [93, 75252], [96, 75412], [100, 75992], [105, 76412], [110, 76532], [113, 76812], [116, 76932], [125, 77512], [131, 77772], [135, 78092]]}, {"verse": 10, "start": 79054, "end": 83596, "text": "Que si no nos hubiéramos detenido, cierto ahora hubiéramos ya vuelto dos veces.", "words": [[0, 79054], [4, 79162], [7, 79282], [10, 79442], [14, 79602], [25, 80082], [35, 81102], [42, 81282], [48, 81662], [59, 82242], [62, 82402], [69, 82762], [73, 82902]]}, {"verse": 11, "start": 83876, "end": 99905, "text": "Entonces Israel su padre les respondió: Pues que así es, hacedlo; tomad de lo mejor de la tierra en vuestros vasos, y llevad a aquel varón un presente, un poco de bálsamo, y un poco de miel, aromas y mirra, nueces y almendras.", "words": [[0, 83876], [9, 84483], [16, 85558], [19, 85678], [25, 86498], [29, 86618], [40, 87889], [45, 88022], [49, 88202], [53, 88422], [57, 89142], [66, 90029], [72, 90314], [75, 90434], [78, 90534], [84, 90814], [87, 90974], [90, 91074], [97, 91334], [100, 91514], [109, 91854], [116, 92394], [118, 92694], [125, 93034], [127, 93134], [133, 93434], [139, 93794], [142, 93954], [152, 94814], [155, 94914], [160, 95154], [163, 95314], [172, 95814], [174, 96034], [177, 96134], [182, 96314], [185, 96514], [191, 97034], [198, 97354], [200, 97554], [207, 98267], [214, 98834], [216, 99094]]}, {"verse": 12, "start": 100255, "end": 108568, "text": "Y tomad en vuestras manos el doble de dinero, y llevad en vuestra mano el dinero vuelto en las bocas de vuestros costales; quizá fue un error.", "words": [[0, 100255], [2, 100377], [8, 100737], [11, 100837], [20, 101217], [26, 101517], [29, 101897], [35, 102217], [38, 102337], [46, 102717], [48, 103197], [55, 103537], [58, 103637], [66, 103977], [71, 104237], [74, 104457], [81, 104757], [88, 105197], [91, 105297], [95, 105437], [101, 105837], [104, 105997], [113, 106357], [123, 107358], [129, 107702], [133, 107882], [136, 108042]]}, {"verse": 13, "start": 108918, "end": 113241, "text": "Tomad también a vuestro hermano, y levantaos, y volved a aquel varón.", "words": [[0, 108918], [6, 109242], [14, 109542], [16, 109722], [24, 110002], [33, 110662], [35, 110822], [46, 111602], [48, 111895], [55, 112189], [57, 112482], [63, 112782]]}, {"verse": 14, "start": 113591, "end": 123549, "text": "Y el Dios Omnipotente os dé misericordias delante de aquel varón, y os suelte al otro vuestro hermano, y a este Benjamín. Y si he de ser privado de mis hijos, que así sea.", "words": [[0, 113591], [2, 113851], [5, 113951], [10, 114131], [22, 114951], [25, 115111], [28, 115251], [42, 116051], [50, 116471], [53, 116611], [59, 116851], [66, 117391], [68, 117711], [71, 117811], [78, 118191], [81, 118311], [86, 118491], [94, 118851], [103, 119451], [105, 119611], [107, 119651], [112, 119831], [122, 120699], [124, 120806], [127, 120986], [130, 121106], [133, 121146], [137, 121406], [145, 121946], [148, 122086], [152, 122226], [159, 122806], [163, 122866], [167, 123046]]}, {"verse": 15, "start": 123829, "end": 136700, "text": "Entonces tomaron aquellos varones el presente, y tomaron en su mano el doble de dinero, y a Benjamín; y se levantaron, y descendieron a Egipto, y se presentaron delante de José.", "words": [[0, 123829], [9, 124287], [17, 124927], [26, 125247], [34, 125847], [37, 126047], [47, 126467], [49, 127247], [57, 127687], [60, 127807], [63, 127967], [68, 128227], [71, 128387], [77, 128787], [80, 128967], [88, 129487], [90, 130003], [92, 130520], [102, 131195], [104, 131321], [107, 131401], [119, 132361], [121, 132821], [134, 133481], [136, 133641], [144, 134321], [146, 134681], [149, 134781], [161, 135521], [169, 135981], [172, 136141]]}, {"verse": 16, "start": 137050, "end": 149415, "text": "Y vio José a Benjamín con ellos, y dijo al mayordomo de su casa: Mete en casa a esos hombres, y degüella un animal, y prepáralo; porque estos hombres comerán conmigo al medio día.", "words": [[0, 137050], [2, 137210], [6, 137410], [11, 137810], [13, 138050], [22, 138610], [26, 138850], [33, 139670], [35, 140010], [40, 140370], [43, 140890], [53, 141410], [56, 141530], [59, 141650], [65, 142480], [70, 142824], [73, 142984], [78, 143304], [80, 143544], [85, 143724], [94, 144164], [96, 144567], [105, 144969], [108, 145109], [116, 145509], [118, 145774], [129, 146752], [136, 146953], [142, 147233], [150, 147633], [158, 148133], [166, 148573], [169, 148866], [175, 149160]]}, {"verse": 17, "start": 149695, "end": 155308, "text": "E hizo el hombre como José dijo; y metió aquel hombre a los hombres en casa de José.", "words": [[0, 149695], [2, 149818], [7, 150078], [10, 150278], [17, 150518], [22, 150798], [27, 151058], [33, 151917], [35, 152038], [41, 152358], [47, 152678], [54, 152978], [56, 153258], [60, 153438], [68, 153858], [71, 154198], [76, 154558], [79, 154798]]}, {"verse": 18, "start": 155658, "end": 173851, "text": "Y aquellos hombres tuvieron temor, cuando fueron metidos en casa de José, y decían: Por el dinero que fue vuelto en nuestros costales la primera vez nos han metido aquí, para revolver contra nosotros, y dar sobre nosotros, y tomarnos por siervos a nosotros, y a nuestros asnos.", "words": [[0, 155658], [2, 155951], [11, 156211], [19, 156771], [28, 157331], [35, 157831], [42, 158271], [49, 158631], [57, 159131], [60, 159371], [65, 159611], [68, 159831], [74, 160151], [76, 160431], [84, 161424], [88, 161546], [91, 161686], [98, 161966], [102, 162206], [106, 162406], [113, 162806], [116, 162906], [125, 163066], [134, 163971], [137, 164211], [145, 164491], [149, 164851], [153, 165151], [157, 165331], [164, 165771], [170, 166031], [175, 166611], [184, 167271], [191, 167571], [201, 167991], [203, 168591], [207, 168751], [213, 169111], [223, 169571], [225, 170031], [234, 170511], [238, 170731], [246, 171251], [248, 171411], [258, 172441], [260, 172570], [262, 172630], [271, 172890]]}, {"verse": 19, "start": 174201, "end": 179422, "text": "Y se llegaron al mayordomo de la casa de José, y le hablaron a la entrada de la casa.", "words": [[0, 174201], [2, 174323], [5, 174443], [14, 174963], [17, 175463], [27, 175963], [30, 176063], [33, 176183], [38, 176423], [41, 176603], [47, 176923], [49, 177228], [52, 177368], [61, 177908], [63, 178028], [66, 178108], [74, 178508], [77, 178788], [80, 178908]]}, {"verse": 20, "start": 179772, "end": 187571, "text": "Y dijeron: Ay, señor mío, nosotros en realidad de verdad descendimos al principio a comprar alimentos:", "words": [[0, 179772], [2, 179901], [11, 180813], [15, 181317], [21, 181517], [26, 182262], [35, 182582], [38, 183022], [47, 183502], [50, 183842], [57, 184182], [69, 185142], [72, 185382], [82, 185922], [84, 186222], [92, 186642]]}, {"verse": 21, "start": 187921, "end": 200910, "text": "Y aconteció que como vinimos al posada y abrimos nuestros costales, he aquí el dinero de cada uno estaba en la boca de su costal, nuestro dinero en su justo peso; y lo hemos devuelto en nuestras manos.", "words": [[0, 187921], [2, 188051], [12, 188791], [16, 189011], [21, 189291], [29, 189771], [32, 189991], [39, 190571], [41, 190711], [49, 191191], [58, 191371], [68, 192811], [71, 192911], [76, 193231], [79, 193411], [86, 193731], [89, 193931], [94, 194111], [98, 194411], [105, 194671], [108, 194871], [111, 194991], [116, 195211], [119, 195391], [122, 195531], [130, 196393], [138, 196619], [145, 197079], [148, 197279], [151, 197439], [157, 197759], [163, 198664], [165, 198792], [168, 198932], [174, 199132], [183, 199712], [186, 199812], [195, 199972]]}, {"verse": 22, "start": 201260, "end": 210506, "text": "Hemos también traído en nuestras manos otro dinero para comprar alimentos: nosotros no sabemos quién haya puesto nuestro dinero en nuestros costales.", "words": [[0, 201260], [6, 201500], [14, 201800], [21, 202360], [24, 202460], [33, 202640], [39, 203200], [44, 203680], [51, 204120], [56, 204400], [64, 204880], [75, 205980], [84, 206408], [87, 206588], [95, 206908], [101, 207288], [106, 207548], [113, 207928], [121, 208268], [128, 208888], [131, 209148], [140, 209388]]}, {"verse": 23, "start": 210856, "end": 222455, "text": "Y él respondió: Paz a vosotros, no temáis; vuestro Dios y el Dios de vuestro padre os dio el tesoro en vuestros costales: yo recibí vuestro dinero. Y les entregó a Simeón.", "words": [[0, 210856], [2, 211042], [5, 211222], [16, 212326], [20, 212456], [22, 212556], [32, 212976], [35, 213461], [43, 214114], [51, 214512], [56, 214712], [58, 214992], [61, 215112], [66, 215312], [69, 215512], [77, 215852], [83, 216292], [86, 216392], [90, 216572], [93, 216752], [100, 217192], [103, 217312], [112, 217632], [122, 218667], [125, 218870], [132, 219410], [140, 219710], [148, 220562], [150, 220725], [154, 220905], [162, 221645], [164, 221825]]}, {"verse": 24, "start": 222805, "end": 231702, "text": "Y metió aquel varón a aquellos hombres en casa de José: y les dio agua, y lavaron sus pies: y dio de comer a sus asnos.", "words": [[0, 222805], [2, 222933], [8, 223293], [14, 223653], [20, 224053], [22, 224233], [31, 224533], [39, 225073], [42, 225353], [47, 225673], [50, 225913], [56, 226819], [58, 226975], [62, 227095], [66, 227355], [72, 227895], [74, 228355], [82, 228755], [86, 228915], [92, 229735], [94, 230065], [98, 230225], [101, 230365], [107, 230605], [109, 230765], [113, 230885]]}, {"verse": 25, "start": 232052, "end": 239810, "text": "Y ellos prepararon el presente entretanto que venía José al medio día, porque habían oído que allí habían de comer pan.", "words": [[0, 232052], [2, 232196], [8, 232476], [19, 233316], [22, 233456], [31, 234264], [42, 235071], [46, 235291], [52, 235631], [57, 235991], [60, 236352], [66, 236713], [71, 237074], [78, 237256], [85, 237596], [90, 238056], [94, 238276], [99, 238496], [106, 238816], [109, 238996], [115, 239216]]}, {"verse": 26, "start": 240160, "end": 249282, "text": "Y vino José a casa, y ellos le trajeron el presente que tenían en su mano dentro de casa, y se inclinaron a él hasta tierra.", "words": [[0, 240160], [2, 240305], [7, 240525], [12, 240865], [14, 241105], [20, 242065], [22, 242145], [28, 242425], [31, 242605], [40, 243265], [43, 243385], [52, 243825], [56, 244165], [63, 244465], [66, 244765], [69, 244945], [74, 245245], [81, 245565], [84, 245845], [90, 246185], [92, 246785], [95, 246965], [106, 247765], [108, 247985], [111, 248165], [117, 248505]]}, {"verse": 27, "start": 249632, "end": 257980, "text": "Entonces les preguntó él cómo estaban, y dijo: ¿Vuestro padre, el anciano que dijisteis, lo pasa bien? ¿vive todavía?", "words": [[0, 249632], [9, 250212], [13, 250732], [22, 251412], [25, 251512], [30, 251792], [39, 252332], [41, 252852], [47, 253590], [56, 254017], [63, 254337], [66, 254537], [74, 254937], [78, 255077], [89, 255857], [92, 256117], [97, 256377], [103, 257039], [109, 257300]]}, {"verse": 28, "start": 258260, "end": 266462, "text": "Y ellos respondieron: Bien va a tu siervo nuestro padre; aún vive. Y se inclinaron, e hicieron reverencia.", "words": [[0, 258260], [2, 258421], [8, 258701], [22, 260039], [27, 260372], [30, 260632], [32, 260732], [35, 260852], [42, 261312], [50, 261492], [57, 262591], [61, 262879], [67, 263319], [69, 263516], [72, 263576], [84, 264396], [86, 264636], [95, 265376]]}, {"verse": 29, "start": 266812, "end": 280021, "text": "Y alzando él sus ojos vio a Benjamín su hermano, hijo de su madre, y dijo: ¿Es este vuestro hermano menor, de quien me hablasteis? Y dijo: Dios tenga misericordia de ti, hijo mío.", "words": [[0, 266812], [2, 267120], [10, 267420], [13, 267720], [17, 267880], [22, 268700], [26, 268900], [28, 269000], [37, 269360], [40, 269700], [49, 270580], [54, 270680], [57, 270860], [60, 271000], [67, 271740], [69, 271780], [75, 272425], [79, 272606], [84, 272866], [92, 273186], [100, 273526], [107, 273846], [110, 274051], [116, 274231], [119, 274371], [131, 275408], [133, 275537], [139, 276259], [144, 276497], [150, 276857], [163, 277697], [166, 277837], [170, 278337], [175, 278497]]}, {"verse": 30, "start": 280301, "end": 291402, "text": "Entonces José se apresuró, porque se conmovieron sus entrañas a causa de su hermano, y buscó donde llorar: y entró en su cámara, y lloró allí.", "words": [[0, 280301], [9, 280882], [14, 281642], [17, 282102], [27, 282842], [34, 283322], [37, 283522], [49, 284182], [53, 284362], [62, 285062], [64, 285242], [70, 285482], [73, 285802], [76, 285902], [85, 286742], [87, 286862], [93, 287362], [99, 287582], [107, 288609], [109, 288748], [115, 289168], [118, 289268], [121, 289448], [129, 289928], [131, 290508], [137, 290908]]}, {"verse": 31, "start": 291752, "end": 297519, "text": "Y lavó su rostro, y salió fuera, y se contuvo, y dijo: Servid la comida.", "words": [[0, 291752], [2, 291897], [7, 292297], [10, 292397], [18, 293537], [20, 293617], [26, 293957], [33, 294417], [35, 294662], [38, 294802], [47, 295402], [49, 295782], [55, 296719], [62, 296919], [65, 297019]]}, {"verse": 32, "start": 297799, "end": 312627, "text": "Y pusieron para él aparte, y separadamente para ellos, y aparte para los egipcios que con él comían: porque los egipcios no pueden comer pan con los hebreos, lo cual es abominación a los egipcios.", "words": [[0, 297799], [2, 297913], [11, 298333], [16, 298633], [19, 298873], [27, 299933], [29, 300033], [43, 300793], [48, 301173], [55, 301593], [57, 302133], [64, 302673], [69, 302893], [73, 303133], [82, 303833], [86, 304058], [90, 304338], [93, 304458], [101, 305455], [108, 305679], [112, 305879], [121, 306479], [124, 306699], [131, 307039], [137, 307419], [141, 307919], [145, 308199], [149, 308379], [158, 309419], [161, 309559], [166, 309919], [169, 310419], [181, 311339], [183, 311619], [187, 311739]]}, {"verse": 33, "start": 312977, "end": 322286, "text": "Y se sentaron delante de él, el mayor conforme a su edad, y el menor conforme a su edad; y estaban aquellos hombres atónitos mirándose el uno al otro.", "words": [[0, 312977], [2, 313138], [5, 313258], [14, 313778], [22, 314218], [25, 314378], [29, 314618], [32, 314858], [38, 315198], [47, 315898], [49, 315938], [52, 316058], [58, 316378], [60, 316518], [63, 316658], [69, 316978], [78, 317658], [80, 317718], [83, 317818], [89, 318439], [91, 318519], [99, 318859], [108, 319179], [116, 319599], [125, 320339], [135, 321119], [138, 321399], [142, 321599], [145, 321779]]}, {"verse": 34, "start": 322636, "end": 333466, "text": "Y él tomó comida de delante de sí para ellos; mas la porción de Benjamín era cinco veces como cualquiera de las de ellos. Y bebieron, y se alegraron con él.", "words": [[0, 322636], [2, 322801], [5, 322921], [10, 323321], [17, 323821], [20, 324021], [28, 324501], [31, 324681], [34, 324901], [39, 325181], [46, 325971], [50, 326211], [53, 326411], [61, 326871], [64, 327031], [73, 327511], [77, 327911], [83, 328331], [89, 328951], [94, 329451], [105, 330051], [108, 330231], [112, 330351], [115, 330531], [122, 331121], [124, 331239], [134, 331759], [136, 332079], [139, 332239], [149, 332839], [153, 333039]]}]}