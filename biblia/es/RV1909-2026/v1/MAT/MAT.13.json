{"book": "MAT", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 480850, "verses": [{"verse": 1, "start": 300, "end": 4596, "text": "Y aquel día, saliendo Jesús de casa, se sentó junto al mar.", "words": [[0, 300], [2, 445], [8, 765], [13, 1025], [22, 1645], [28, 2005], [31, 2285], [37, 3065], [40, 3245], [46, 3645], [52, 3825], [55, 4105]]}, {"verse": 2, "start": 4946, "end": 12326, "text": "Y se le juntó mucha gente; y entrando él en el barco, se sentó, y toda la gente estaba a la ribera.", "words": [[0, 4946], [2, 5054], [5, 5174], [8, 5294], [14, 5514], [20, 5954], [27, 6937], [29, 7082], [38, 7642], [41, 7982], [44, 8222], [47, 8381], [54, 8822], [57, 8982], [64, 9662], [66, 10182], [71, 10402], [74, 10622], [80, 10922], [87, 11342], [89, 11561], [92, 11622]]}, {"verse": 3, "start": 12676, "end": 19128, "text": "Y les habló muchas cosas por parábolas, diciendo: He aquí el que sembraba salió a sembrar.", "words": [[0, 12676], [2, 12801], [6, 12941], [12, 13321], [19, 13581], [25, 14121], [29, 14401], [40, 15101], [50, 16581], [53, 16661], [58, 16941], [61, 17281], [65, 17421], [74, 17941], [80, 18321], [82, 18421]]}, {"verse": 4, "start": 19478, "end": 26722, "text": "Y sembrando, parte de la semilla cayó junto al camino; y vinieron las aves, y la comieron.", "words": [[0, 19478], [2, 19815], [13, 20535], [19, 20975], [22, 21255], [25, 21395], [33, 21955], [38, 22455], [44, 22755], [47, 23015], [55, 23863], [57, 24083], [66, 24563], [70, 24823], [76, 25403], [78, 25683], [81, 25823]]}, {"verse": 5, "start": 27072, "end": 35615, "text": "Y parte cayó en pedregales, donde no tenía mucha tierra; y nació luego, porque no tenía profundidad de tierra:", "words": [[0, 27072], [2, 27169], [8, 27509], [13, 28069], [16, 28249], [28, 29529], [34, 29889], [37, 30189], [43, 30549], [49, 30849], [57, 31810], [59, 31953], [65, 32333], [72, 32733], [79, 33053], [82, 33343], [88, 33633], [100, 34653], [103, 35141]]}, {"verse": 6, "start": 35965, "end": 40759, "text": "Pero al salir el sol, se quemó; y se secó, porque no tenía raíz.", "words": [[0, 35965], [5, 36108], [8, 36268], [14, 36588], [17, 36788], [22, 37108], [25, 37348], [32, 38152], [34, 38232], [37, 38352], [43, 38852], [50, 39272], [53, 39492], [59, 39892]]}, {"verse": 7, "start": 41109, "end": 46021, "text": "Y parte cayó en espinas; y las espinas crecieron, y la ahogaron.", "words": [[0, 41109], [2, 41253], [8, 41553], [13, 42233], [16, 42453], [25, 43401], [27, 43524], [31, 43644], [39, 44064], [50, 44784], [52, 45024], [55, 45164]]}, {"verse": 8, "start": 46371, "end": 51664, "text": "Y parte cayó en buena tierra, y dio fruto, cuál a ciento, cuál a sesenta, y cuál a treinta.", "words": [[0, 46371], [2, 46472], [8, 46672], [13, 47072], [16, 47152], [22, 47312], [30, 47632], [32, 47902], [36, 48172], [43, 48592], [48, 48919], [50, 49245], [58, 49572], [63, 49865], [65, 50159], [74, 50452], [76, 50692], [81, 51028], [83, 51365]]}, {"verse": 9, "start": 52014, "end": 54392, "text": "Quien tiene oídos para oír, oiga.", "words": [[0, 52014], [6, 52160], [12, 52500], [18, 52960], [23, 53160], [28, 53980]]}, {"verse": 10, "start": 54742, "end": 60434, "text": "Entonces, acercándose los discípulos, le dijeron: ¿Por qué les hablas por parábolas?", "words": [[0, 54742], [10, 55750], [22, 56510], [26, 56710], [38, 57390], [41, 57730], [50, 58624], [55, 58768], [59, 58968], [63, 59108], [70, 59488], [74, 59688]]}, {"verse": 11, "start": 60714, "end": 69992, "text": "Y él respondiendo, les dijo: Porque a vosotros es concedido saber los misterios del reino de los cielos; pero a ellos no es concedido.", "words": [[0, 60714], [2, 60899], [5, 61099], [19, 62179], [23, 62359], [29, 63116], [36, 63548], [38, 63688], [47, 64128], [50, 64308], [60, 65048], [66, 65308], [70, 65588], [80, 66228], [84, 66408], [90, 66788], [93, 66908], [97, 67048], [105, 67965], [110, 68108], [112, 68288], [118, 68528], [121, 68988], [124, 69168]]}, {"verse": 12, "start": 70342, "end": 77972, "text": "Porque a cualquiera que tiene, se le dará, y tendrá más; pero al que no tiene, aun lo que tiene le será quitado.", "words": [[0, 70342], [7, 70628], [9, 70748], [20, 71268], [24, 71408], [31, 71828], [34, 72368], [37, 72548], [43, 73228], [45, 73468], [52, 73848], [57, 74518], [62, 74662], [65, 74802], [69, 74962], [72, 75102], [79, 75802], [83, 76022], [86, 76282], [90, 76422], [96, 76762], [99, 76962], [104, 77202]]}, {"verse": 13, "start": 78322, "end": 85755, "text": "Por eso les hablo por parábolas; porque viendo no ven, y oyendo no oyen, ni entienden.", "words": [[0, 78322], [4, 78467], [8, 78747], [12, 79072], [18, 79632], [22, 79852], [33, 81053], [40, 81275], [47, 81655], [50, 81935], [55, 82255], [57, 82955], [64, 83395], [67, 83675], [73, 84295], [76, 84915]]}, {"verse": 14, "start": 86105, "end": 95554, "text": "De manera que se cumple en ellos la profecía de Isaías, que dice: De oído oiréis, y no entenderéis; y viendo veréis, y no miraréis.", "words": [[0, 86105], [3, 86230], [10, 86470], [14, 86750], [17, 86910], [24, 87470], [27, 87670], [33, 87910], [36, 88130], [45, 88770], [48, 88910], [56, 89530], [60, 89730], [66, 90317], [69, 90617], [74, 91017], [82, 91677], [84, 91937], [87, 92117], [100, 93350], [102, 93474], [109, 93794], [117, 94374], [119, 94649], [122, 94789]]}, {"verse": 15, "start": 95904, "end": 109736, "text": "Porque el corazón de este pueblo se ha vuelto insensible, y oyen con dificultad, y han cerrado sus ojos: para que no vean con los ojos, ni oigan con los oídos, ni entiendan con el corazón, y se conviertan, y yo los sane.", "words": [[0, 95904], [7, 96105], [10, 96245], [18, 96625], [21, 96885], [26, 97025], [33, 97305], [36, 97565], [39, 97685], [46, 98045], [58, 98945], [60, 99225], [65, 99565], [69, 99705], [81, 100565], [83, 100765], [87, 101175], [95, 101585], [99, 101785], [105, 102653], [110, 102797], [114, 102957], [117, 103117], [122, 103397], [126, 103537], [130, 103717], [136, 104149], [139, 104580], [145, 105012], [149, 105272], [153, 105472], [160, 105942], [163, 106412], [173, 107072], [177, 107192], [180, 107352], [189, 107772], [191, 107952], [194, 108032], [206, 108732], [208, 108892], [211, 109022], [215, 109152]]}, {"verse": 16, "start": 110086, "end": 115004, "text": "Pero bienaventurados vuestros ojos, porque ven; y vuestros oídos, porque oyen.", "words": [[0, 110086], [5, 110560], [21, 111070], [30, 111490], [36, 112170], [43, 112490], [48, 113153], [50, 113261], [59, 113621], [66, 114081], [73, 114401]]}, {"verse": 17, "start": 115354, "end": 125315, "text": "Porque de cierto os digo, que muchos profetas y justos desearon ver lo que veis, y no lo vieron: y oír lo que oís, y no lo oyeron.", "words": [[0, 115354], [7, 115581], [10, 115761], [17, 116121], [20, 116481], [26, 117121], [30, 117441], [37, 117701], [46, 118341], [48, 118521], [55, 119241], [64, 120001], [68, 120201], [71, 120441], [75, 120601], [81, 121101], [83, 121381], [86, 121561], [89, 121701], [97, 122597], [99, 122783], [103, 123063], [106, 123283], [110, 123443], [115, 123883], [117, 124203], [120, 124403], [123, 124583]]}, {"verse": 18, "start": 125665, "end": 129114, "text": "Oíd, pues, vosotros la parábola del que siembra:", "words": [[0, 125832], [5, 126012], [11, 126312], [20, 127157], [23, 127557], [32, 128097], [36, 128297], [40, 128457]]}, {"verse": 19, "start": 129464, "end": 141515, "text": "Oyendo cualquiera la palabra del reino, y no entendiéndola, viene el malo, y arrebata lo que fue sembrado en su corazón: este es el que fue sembrado junto al camino.", "words": [[0, 129618], [7, 129808], [18, 130408], [21, 130588], [29, 130948], [33, 131228], [40, 132148], [42, 132388], [45, 132528], [60, 133928], [66, 134268], [69, 134568], [75, 135248], [77, 135708], [86, 136168], [89, 136268], [93, 136368], [97, 136528], [106, 137128], [109, 137248], [112, 137408], [121, 138451], [126, 138777], [129, 139117], [132, 139397], [136, 139537], [140, 139737], [149, 140357], [155, 140577], [158, 140837]]}, {"verse": 20, "start": 141865, "end": 149539, "text": "Y el que fue sembrado en pedregales, este es el que oye la palabra, y luego la recibe con gozo.", "words": [[0, 141865], [2, 142065], [5, 142165], [9, 142285], [13, 142465], [22, 143065], [25, 143225], [37, 144885], [42, 145185], [45, 145345], [48, 145505], [52, 145665], [56, 145985], [59, 146125], [68, 147265], [70, 147605], [76, 147825], [79, 148105], [86, 148605], [90, 148845]]}, {"verse": 21, "start": 149889, "end": 158944, "text": "Pero no tiene raíz en sí, sino que dura poco: que venida la aflicción o la persecución por la palabra, enseguida tropieza.", "words": [[0, 149889], [5, 150032], [8, 150192], [14, 150432], [19, 150972], [22, 151172], [26, 151832], [31, 152152], [35, 152352], [40, 152552], [46, 153501], [50, 153605], [57, 153985], [60, 154145], [70, 155005], [72, 155265], [75, 155385], [87, 156185], [91, 156385], [94, 156585], [103, 157505], [113, 158065]]}, {"verse": 22, "start": 159294, "end": 170878, "text": "Y el que fue sembrado en espinas, este es el que oye la palabra; pero el afán de este siglo y el engaño de las riquezas, ahogan la palabra, y se hace infructuosa.", "words": [[0, 159294], [2, 159443], [5, 159523], [9, 159643], [13, 159823], [22, 160423], [25, 160523], [34, 161803], [39, 162243], [42, 162483], [45, 162643], [49, 162823], [53, 163103], [56, 163243], [65, 164134], [70, 164298], [73, 164458], [78, 164818], [81, 164918], [86, 165078], [92, 165558], [94, 165738], [97, 165858], [104, 166358], [107, 166478], [111, 166638], [121, 167398], [128, 168198], [131, 168418], [140, 168878], [142, 169343], [145, 169483], [150, 169743]]}, {"verse": 23, "start": 171228, "end": 183164, "text": "Pero el que fue sembrado en buena tierra, este es el que oye y entiende la palabra, y el que lleva fruto: y lleva uno a ciento, y otro a sesenta, y otro a treinta.", "words": [[0, 171228], [5, 171391], [8, 171531], [12, 171671], [16, 171871], [25, 172531], [28, 172651], [34, 172871], [42, 173871], [47, 174171], [50, 174451], [53, 174611], [57, 174791], [61, 175211], [63, 175391], [72, 175931], [75, 176111], [84, 176891], [86, 177171], [89, 177301], [93, 177431], [99, 177731], [106, 178673], [108, 178800], [114, 179060], [118, 179320], [120, 179540], [128, 179900], [130, 180580], [135, 180860], [137, 181100], [146, 181780], [148, 182000], [153, 182240], [155, 182440]]}, {"verse": 24, "start": 183514, "end": 191399, "text": "Otra parábola les refirió, diciendo: El reino de los cielos es semejante al hombre que siembra buena semilla en su campo:", "words": [[0, 183514], [5, 183861], [14, 184361], [18, 184801], [27, 185241], [37, 186254], [40, 186502], [46, 186882], [49, 186982], [53, 187122], [60, 187582], [63, 188052], [73, 188522], [76, 188682], [83, 188902], [87, 189102], [95, 189602], [101, 189782], [109, 190382], [112, 190562], [115, 190722]]}, {"verse": 25, "start": 191749, "end": 196840, "text": "Pero durmiendo los hombres, vino su enemigo, y sembró cizaña entre el trigo, y se fue.", "words": [[0, 191749], [5, 191894], [15, 192394], [19, 192574], [28, 193354], [33, 193674], [36, 193894], [45, 194354], [47, 194454], [54, 194874], [61, 195414], [67, 195674], [70, 195854], [77, 196234], [79, 196354], [82, 196454]]}, {"verse": 26, "start": 197190, "end": 202897, "text": "Y como la hierba salió e hizo fruto, entonces apareció también la cizaña.", "words": [[0, 197190], [2, 197494], [7, 197714], [10, 197874], [17, 198334], [23, 198874], [25, 199254], [30, 199494], [37, 200374], [46, 200714], [55, 201554], [63, 201914], [66, 202431]]}, {"verse": 27, "start": 203247, "end": 212978, "text": "Y llegándose los siervos del padre de la familia, le dijeron: Señor, ¿no sembraste buena semilla en tu campo? ¿de dónde, pues, tiene cizaña?", "words": [[0, 203247], [2, 203350], [13, 203950], [17, 204130], [25, 204610], [29, 204810], [35, 205190], [38, 205410], [41, 205550], [50, 206450], [53, 206690], [62, 207632], [69, 208354], [73, 208474], [83, 208887], [89, 209301], [97, 209714], [100, 209794], [103, 209914], [110, 210767], [114, 210913], [121, 211353], [127, 211906], [133, 212459]]}, {"verse": 28, "start": 213328, "end": 221729, "text": "Y él les dijo: Un hombre enemigo ha hecho esto. Y los siervos le dijeron: ¿Quieres, pues, que vayamos y la arranquemos?", "words": [[0, 213328], [2, 213513], [5, 213713], [9, 214073], [15, 214866], [18, 215009], [25, 215329], [33, 215989], [36, 216229], [42, 216469], [48, 217261], [50, 217382], [54, 217522], [62, 218022], [65, 218362], [74, 219400], [84, 219566], [90, 219733], [94, 220128], [102, 220568], [104, 220748], [107, 221239]]}, {"verse": 29, "start": 222079, "end": 228070, "text": "Y él dijo: No; porque cogiendo la cizaña, no arranquéis también con ella el trigo.", "words": [[0, 222079], [2, 222234], [5, 222354], [11, 223031], [15, 223586], [22, 223809], [31, 224329], [34, 224719], [42, 225109], [45, 225609], [56, 226409], [64, 226709], [68, 227069], [73, 227289], [76, 227509]]}, {"verse": 30, "start": 228420, "end": 243632, "text": "Dejad crecer juntamente lo uno y lo otro hasta la siega; y al tiempo de la siega yo diré a los segadores: Recoged primero la cizaña, y atadla en manojos para quemarla; pero recoged el trigo en mi granero.", "words": [[0, 228420], [6, 228825], [13, 229325], [24, 230165], [27, 230365], [31, 230665], [33, 230885], [36, 231025], [41, 231365], [47, 231565], [50, 231982], [57, 232548], [59, 232654], [62, 232794], [69, 233114], [72, 233354], [75, 233584], [81, 233814], [84, 233994], [89, 234354], [91, 234454], [95, 235029], [106, 236028], [114, 236328], [122, 236728], [125, 237178], [133, 237628], [135, 238068], [142, 238688], [145, 238948], [153, 239648], [158, 239843], [168, 240840], [173, 241027], [181, 241727], [184, 241967], [190, 242427], [193, 242846], [196, 243266]]}, {"verse": 31, "start": 243982, "end": 253946, "text": "Otra parábola les refirió, diciendo: El reino de los cielos es semejante al grano de mostaza, que tomándolo alguno lo sembró en su campo:", "words": [[0, 243982], [5, 244329], [14, 244829], [18, 245269], [27, 245709], [37, 246722], [40, 246869], [46, 247349], [49, 247469], [53, 247609], [60, 248149], [63, 248649], [73, 249149], [76, 249329], [82, 249729], [85, 249869], [94, 250869], [98, 251029], [108, 251749], [115, 252409], [118, 252529], [125, 253029], [128, 253109], [131, 253269]]}, {"verse": 32, "start": 254296, "end": 268105, "text": "El cual a la verdad es la más pequeña de todas las semillas; pero cuando ha crecido, es la mayor de las hortalizas, y se hace árbol, que vienen las aves del cielo y hacen nidos en sus ramas.", "words": [[0, 254296], [3, 254463], [8, 254703], [10, 255023], [13, 255123], [20, 255363], [23, 255803], [26, 256123], [30, 256423], [38, 256923], [41, 257323], [47, 257623], [51, 257943], [61, 258980], [66, 259109], [73, 259349], [76, 259549], [85, 260029], [88, 260149], [91, 260269], [97, 260529], [100, 260709], [104, 260849], [116, 261709], [118, 262389], [121, 262549], [126, 262809], [133, 263489], [137, 263929], [144, 264369], [148, 264509], [153, 264849], [157, 265009], [163, 265489], [165, 265834], [171, 266094], [177, 266774], [180, 267094], [184, 267294]]}, {"verse": 33, "start": 268455, "end": 280247, "text": "Otra parábola les dijo: El reino de los cielos es semejante a la levadura que tomó una mujer, y escondió en tres medidas de harina, hasta que todo quedó fermentado.", "words": [[0, 268455], [5, 268842], [14, 269402], [18, 269642], [24, 270392], [27, 270571], [33, 270991], [36, 271131], [40, 271271], [47, 271931], [50, 272151], [60, 272991], [62, 273131], [65, 273251], [74, 273791], [78, 273971], [83, 274351], [87, 274511], [94, 274891], [96, 275391], [105, 276091], [108, 276411], [113, 276731], [121, 277411], [124, 277631], [132, 278451], [138, 278631], [142, 278811], [147, 279011], [153, 279371]]}, {"verse": 34, "start": 280597, "end": 286070, "text": "Todo esto habló Jesús por parábolas a la gente, y sin parábolas no les hablaba:", "words": [[0, 280597], [5, 280759], [10, 281059], [16, 281439], [22, 281699], [26, 282079], [36, 282759], [38, 282979], [41, 283039], [48, 283499], [50, 283754], [54, 283954], [64, 284794], [67, 285194], [71, 285414]]}, {"verse": 35, "start": 286420, "end": 296176, "text": "Para que se cumpliese lo que fue dicho por el profeta, que dijo: Abriré en parábolas mi boca; declararé cosas escondidas desde la fundación del mundo.", "words": [[0, 286420], [5, 286858], [9, 286998], [12, 287138], [22, 287698], [25, 287898], [29, 287998], [33, 288158], [39, 288418], [43, 288678], [46, 288798], [55, 289318], [59, 289478], [65, 290210], [72, 290810], [75, 291140], [85, 291470], [88, 291670], [94, 292411], [104, 293055], [110, 293335], [121, 294235], [127, 294675], [130, 294895], [140, 295375], [144, 295595]]}, {"verse": 36, "start": 296526, "end": 307905, "text": "Entonces, despedida la gente, Jesús entró en la casa; y acercándose a él sus discípulos, le dijeron: Decláranos la parábola de la cizaña del campo.", "words": [[0, 296526], [10, 297389], [20, 298149], [23, 298269], [30, 299289], [36, 299709], [42, 300429], [45, 300509], [48, 300649], [54, 301482], [56, 301591], [68, 302471], [70, 302751], [73, 303131], [77, 303271], [89, 304051], [92, 304351], [101, 305487], [112, 305807], [115, 305967], [124, 306487], [127, 306647], [130, 306937], [137, 307227], [141, 307347]]}, {"verse": 37, "start": 308185, "end": 314346, "text": "Y respondiendo él, les dijo: El que siembra la buena semilla es el Hijo del hombre;", "words": [[0, 308185], [2, 308309], [15, 309149], [19, 309569], [23, 310049], [29, 310873], [32, 310999], [36, 311099], [44, 311579], [47, 311679], [53, 311899], [61, 312499], [64, 312919], [67, 313099], [72, 313479], [76, 313739]]}, {"verse": 38, "start": 314696, "end": 322073, "text": "Y el campo es el mundo; y la buena semilla son los hijos del reino, y la cizaña son los hijos del malo;", "words": [[0, 314696], [2, 314835], [5, 314975], [11, 315335], [14, 315535], [17, 315675], [24, 316568], [26, 316677], [29, 316797], [35, 316997], [43, 317537], [47, 317777], [51, 317977], [57, 318237], [61, 318497], [68, 319217], [70, 319657], [73, 320097], [80, 320537], [84, 320817], [88, 321017], [94, 321277], [98, 321517]]}, {"verse": 39, "start": 322423, "end": 330170, "text": "Y el enemigo que la sembró, es el diablo; y la siega es el fin del mundo, y los segadores son los ángeles.", "words": [[0, 322423], [2, 322550], [5, 322690], [13, 323230], [17, 323390], [20, 323510], [28, 324270], [31, 324630], [34, 324810], [42, 325694], [44, 325795], [47, 326135], [53, 326475], [56, 326680], [59, 326840], [63, 327040], [67, 327200], [74, 327640], [76, 328200], [80, 328620], [90, 329040], [94, 329380], [98, 329540]]}, {"verse": 40, "start": 330520, "end": 337335, "text": "De manera que como es cogida la cizaña, y quemada al fuego, así será en el fin de este siglo.", "words": [[0, 330520], [3, 330625], [10, 330825], [14, 331065], [19, 331305], [22, 331525], [29, 332005], [32, 332395], [40, 332785], [42, 333205], [50, 333605], [53, 333805], [60, 334605], [64, 334805], [69, 335245], [72, 335745], [75, 335905], [79, 336185], [82, 336425], [87, 336645]]}, {"verse": 41, "start": 337685, "end": 345870, "text": "Enviará el Hijo del hombre sus ángeles, y recogerán de su reino todas las causas de tropiezo, y los que hacen iniquidad,", "words": [[0, 337685], [8, 338350], [11, 338590], [16, 338990], [20, 339150], [27, 339610], [31, 339710], [40, 340710], [42, 340930], [52, 341710], [55, 341850], [58, 342030], [64, 342530], [70, 342870], [74, 343210], [81, 343790], [84, 343890], [94, 345090], [96, 345290], [100, 345450], [104, 345610], [110, 345740]]}, {"verse": 42, "start": 345870, "end": 352071, "text": "Y los echarán en el horno de fuego: allí será el llanto y el crujir de dientes.", "words": [[0, 345950], [2, 346430], [6, 346590], [14, 347230], [17, 347490], [20, 347650], [26, 348050], [29, 348190], [36, 348990], [41, 349442], [46, 349642], [49, 349782], [56, 350222], [58, 350402], [61, 350742], [68, 351082], [71, 351242]]}, {"verse": 43, "start": 352421, "end": 360685, "text": "Entonces los justos resplandecerán como el sol en el reino de su Padre: el que tiene oídos para oír, oiga.", "words": [[0, 352421], [9, 353149], [13, 353809], [20, 354549], [35, 355729], [40, 355989], [43, 356209], [47, 356469], [50, 356809], [53, 356969], [59, 357369], [62, 357509], [65, 357669], [72, 358481], [75, 358588], [79, 358708], [85, 358988], [91, 359448], [96, 359668], [101, 360178]]}, {"verse": 44, "start": 361035, "end": 376059, "text": "Además, el reino de los cielos es semejante al tesoro escondido en el campo; el cual hallado, el hombre lo encubre, y de gozo de ello va, y vende todo lo que tiene, y compra aquel campo.", "words": [[0, 361035], [8, 361998], [11, 362358], [17, 362798], [20, 362918], [24, 363078], [31, 363698], [34, 363918], [44, 364878], [47, 365238], [54, 365878], [64, 366678], [67, 366798], [70, 366958], [77, 367920], [80, 368084], [85, 368364], [94, 369024], [97, 369164], [104, 369424], [107, 370047], [116, 370669], [118, 370749], [121, 370929], [126, 371269], [129, 371489], [134, 371709], [138, 372549], [140, 372609], [146, 373009], [151, 373269], [154, 373509], [158, 373629], [165, 374489], [167, 374569], [174, 374969], [180, 375349]]}, {"verse": 45, "start": 376409, "end": 382594, "text": "También el reino de los cielos es semejante a un comerciante, que busca buenas perlas;", "words": [[0, 376409], [8, 376734], [11, 377054], [17, 377474], [20, 377594], [24, 377734], [31, 378354], [34, 378634], [44, 379474], [46, 379594], [49, 379714], [62, 380554], [66, 381014], [72, 381314], [79, 381994]]}, {"verse": 46, "start": 382944, "end": 387940, "text": "Que hallando una preciosa perla, fue y vendió todo lo que tenía, y la compró.", "words": [[0, 382944], [4, 383128], [13, 383408], [17, 383588], [26, 384108], [33, 384728], [37, 384828], [39, 385148], [46, 385588], [51, 385988], [54, 386248], [58, 386368], [65, 386728], [67, 387228], [70, 387348]]}, {"verse": 47, "start": 388290, "end": 396416, "text": "Asimismo el reino de los cielos es semejante a la red, que echada en el mar, recoge de toda clase de peces:", "words": [[0, 388290], [9, 388958], [12, 389058], [18, 389438], [21, 389558], [25, 389718], [32, 390378], [35, 390868], [45, 391358], [47, 391518], [50, 391618], [55, 391898], [59, 392438], [66, 392858], [69, 392998], [72, 393138], [77, 393418], [84, 394658], [87, 394798], [92, 395058], [98, 395418], [101, 395758]]}, {"verse": 48, "start": 396766, "end": 405615, "text": "La cual estando llena, la sacaron a la orilla; y sentados, cogieron lo bueno en cestas, y lo malo echaron fuera.", "words": [[0, 396766], [3, 396894], [8, 397327], [16, 397761], [23, 398194], [26, 398734], [34, 399274], [36, 399374], [39, 399514], [47, 400315], [49, 400459], [59, 401159], [68, 401919], [71, 402139], [77, 402399], [80, 402619], [88, 403379], [90, 403979], [93, 404119], [98, 404439], [106, 404859]]}, {"verse": 49, "start": 405965, "end": 413325, "text": "Así será al fin del siglo: saldrán los ángeles, y apartarán a los malos de entre los justos,", "words": [[0, 405965], [4, 406169], [9, 406569], [12, 406889], [16, 407129], [20, 407645], [27, 408329], [35, 409115], [39, 409295], [48, 409955], [50, 410355], [60, 411155], [62, 411315], [66, 411455], [72, 412015], [75, 412235], [81, 412535], [85, 412755]]}, {"verse": 50, "start": 413675, "end": 419304, "text": "Y los echarán en el horno del fuego: allí será el llanto y el crujir de dientes.", "words": [[0, 413675], [2, 413799], [6, 413939], [14, 414559], [17, 414799], [20, 414959], [26, 415259], [30, 415419], [37, 416223], [42, 416676], [47, 416876], [50, 417016], [57, 417456], [59, 417636], [62, 417976], [69, 418316], [72, 418476]]}, {"verse": 51, "start": 419654, "end": 426360, "text": "Les dice Jesús: ¿Habéis entendido todas estas cosas? Ellos responden: Sí, Señor.", "words": [[0, 419654], [4, 419878], [9, 420238], [16, 421212], [24, 421659], [34, 422339], [40, 422539], [46, 422899], [53, 424148], [59, 424318], [70, 425381], [74, 425808]]}, {"verse": 52, "start": 426640, "end": 437045, "text": "Y él les dijo: Por eso todo escriba instruido en el reino de los cielos, es semejante a un padre de familia, que saca de su tesoro cosas nuevas y cosas viejas.", "words": [[0, 426640], [2, 426825], [5, 427025], [9, 427385], [15, 428177], [19, 428284], [23, 428504], [28, 428784], [36, 429384], [46, 429984], [49, 430124], [52, 430284], [58, 430664], [61, 430784], [65, 430924], [73, 431784], [76, 432064], [86, 432624], [88, 432724], [91, 432824], [97, 433084], [100, 433304], [109, 433844], [113, 434064], [118, 434424], [121, 434504], [124, 434644], [131, 435124], [137, 435419], [144, 435799], [146, 436059], [152, 436219]]}, {"verse": 53, "start": 437395, "end": 441945, "text": "Y aconteció que acabando Jesús estas parábolas, pasó de allí.", "words": [[0, 437395], [2, 437554], [12, 438294], [16, 438514], [25, 438974], [31, 439374], [37, 439854], [48, 440774], [53, 441194], [56, 441454]]}, {"verse": 54, "start": 442295, "end": 453782, "text": "Y venido a su tierra, les enseñaba en la sinagoga de ellos, de tal manera que ellos estaban atónitos, y decían: ¿De dónde tiene este esta sabiduría, y estas maravillas?", "words": [[0, 442295], [2, 442403], [9, 442783], [11, 442903], [14, 443023], [22, 443503], [26, 444023], [35, 444783], [38, 444903], [41, 445003], [50, 445623], [53, 445843], [60, 446443], [63, 446663], [67, 446923], [74, 447283], [78, 447563], [84, 447803], [92, 448243], [102, 449263], [104, 449583], [112, 450529], [116, 450672], [122, 450792], [128, 451012], [133, 451232], [138, 451532], [149, 452532], [151, 452712], [157, 452912]]}, {"verse": 55, "start": 454132, "end": 460981, "text": "¿No es este el hijo del carpintero? ¿no se llama su madre María, y sus hermanos Jacobo y José, y Simón, y Judas?", "words": [[0, 454132], [4, 454278], [7, 454498], [12, 454818], [15, 454978], [20, 455158], [24, 455298], [36, 456341], [40, 456465], [43, 456585], [49, 456805], [52, 456985], [58, 457225], [65, 457645], [67, 458065], [71, 458185], [80, 458665], [87, 459125], [89, 459185], [95, 459445], [97, 459785], [104, 460225], [106, 460405]]}, {"verse": 56, "start": 461331, "end": 466131, "text": "¿Y no están todas sus hermanas con nosotros? ¿De dónde, pues, tiene este todas estas cosas?", "words": [[0, 461331], [3, 461427], [6, 461547], [12, 461747], [18, 462027], [22, 462307], [31, 462667], [35, 462887], [45, 463791], [49, 463936], [56, 464236], [62, 464488], [68, 464739], [73, 464991], [79, 465191], [85, 465451]]}, {"verse": 57, "start": 466411, "end": 474420, "text": "Y se escandalizaban en él. Pero Jesús les dijo: No hay profeta sin honra sino en su tierra y en su casa.", "words": [[0, 466411], [2, 466557], [5, 466757], [20, 467817], [23, 467997], [27, 468568], [32, 468712], [38, 469132], [42, 469632], [48, 470387], [51, 470514], [55, 470674], [63, 471234], [67, 471474], [73, 472214], [78, 472414], [81, 472654], [84, 472754], [91, 473214], [93, 473474], [96, 473614], [99, 473774]]}, {"verse": 58, "start": 474770, "end": 480450, "text": "Y no hizo allí muchas maravillas, a causa de la incredulidad de ellos.", "words": [[0, 474770], [2, 474894], [5, 475094], [10, 475374], [15, 475654], [22, 475994], [34, 477354], [36, 477454], [42, 477854], [45, 478154], [48, 478274], [61, 479434], [64, 479734]]}]}