{"book": "PSA", "chapter": 5, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 94783, "verses": [{"verse": 1, "start": 300, "end": 10022, "text": "Al Músico principal: sobre Nehilot: Salmo de David. ESCUCHA, oh Jehová, mis palabras; considera la meditación mía.", "words": [[0, 300], [3, 489], [10, 969], [21, 2067], [27, 2655], [36, 4365], [42, 4905], [45, 5045], [52, 5734], [61, 6067], [64, 6400], [72, 6733], [76, 7066], [86, 8101], [96, 8704], [99, 8804], [110, 9444]]}, {"verse": 2, "start": 10372, "end": 15487, "text": "Está atento a la voz de mi clamor, Rey mío y Dios mío, porque a ti oraré.", "words": [[0, 10372], [5, 10578], [12, 11018], [14, 11158], [17, 11218], [21, 11438], [24, 11558], [27, 11698], [35, 12188], [39, 12678], [43, 13058], [45, 13198], [50, 13438], [55, 14218], [62, 14478], [64, 14598], [67, 14738]]}, {"verse": 3, "start": 15837, "end": 20841, "text": "Oh Jehová, de mañana oirás mi voz; de mañana me presentaré a ti, y esperaré.", "words": [[0, 15974], [3, 16148], [11, 16321], [14, 16441], [21, 16921], [27, 17401], [30, 17561], [35, 18282], [38, 18409], [45, 18689], [48, 18929], [59, 19549], [61, 19689], [65, 19849], [67, 20169]]}, {"verse": 4, "start": 21191, "end": 26273, "text": "Porque tú no eres un Dios que ame la maldad: el malo no habitará junto a ti.", "words": [[0, 21191], [7, 21377], [10, 21657], [13, 21997], [18, 22257], [21, 22457], [26, 22737], [30, 23237], [34, 23497], [37, 23597], [45, 24419], [48, 24564], [53, 24964], [56, 25104], [65, 25564], [71, 25724], [73, 25984]]}, {"verse": 5, "start": 26623, "end": 33739, "text": "No estarán los insensatos delante de tus ojos: aborreces a todos los que hacen iniquidad.", "words": [[0, 26623], [3, 26808], [11, 27368], [15, 27548], [26, 28508], [34, 29048], [37, 29208], [41, 29388], [47, 30294], [57, 31174], [59, 31534], [65, 31814], [69, 32134], [73, 32334], [79, 32634]]}, {"verse": 6, "start": 34089, "end": 41178, "text": "Destruirás a los que hablan m