{"book": "MAT", "chapter": 25, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 366696, "verses": [{"verse": 1, "start": 300, "end": 8095, "text": "Entonces el reino de los cielos será semejante a diez vírgenes, que tomando sus lámparas, salieron a recibir al esposo.", "words": [[0, 300], [9, 862], [12, 1302], [18, 1682], [21, 1802], [25, 1962], [32, 2482], [37, 2702], [47, 3442], [49, 3562], [54, 3722], [64, 4342], [68, 4687], [76, 4987], [80, 5187], [90, 6107], [99, 6607], [101, 6827], [109, 7147], [112, 7467]]}, {"verse": 2, "start": 8445, "end": 12570, "text": "Y las cinco de ellas eran prudentes, y las cinco insensatas.", "words": [[0, 8445], [2, 8555], [6, 8695], [12, 9055], [15, 9315], [21, 9475], [26, 9775], [37, 10635], [39, 10930], [43, 11070], [49, 11450]]}, {"verse": 3, "start": 12920, "end": 17658, "text": "Las que eran insensatas, tomando sus lámparas, no tomaron consigo aceite;", "words": [[0, 12920], [4, 13078], [8, 13278], [13, 13498], [25, 14518], [33, 14898], [37, 15078], [47, 15918], [50, 16098], [58, 16478], [66, 16858]]}, {"verse": 4, "start": 18008, "end": 22868, "text": "Pero las prudentes tomaron aceite en sus vasos, juntamente con sus lámparas.", "words": [[0, 18008], [5, 18268], [9, 18428], [19, 18908], [27, 19388], [34, 19828], [37, 20108], [41, 20268], [48, 20868], [59, 21548], [63, 21768], [67, 22350]]}, {"verse": 5, "start": 23218, "end": 27078, "text": "Y tardándose el esposo, cabecearon todas, y se durmieron.", "words": [[0, 23218], [2, 23363], [13, 24023], [16, 24163], [24, 24833], [35, 25503], [42, 25883], [44, 26268], [47, 26408]]}, {"verse": 6, "start": 27428, "end": 33456, "text": "Y a la media noche fue oído un clamor: He aquí, el esposo viene; salid a recibirle.", "words": [[0, 27428], [2, 27571], [4, 27671], [7, 27904], [13, 28138], [19, 28371], [23, 28571], [28, 28871], [31, 29031], [39, 29854], [42, 29934], [48, 30614], [51, 30774], [58, 31174], [65, 31954], [71, 32304], [73, 32654]]}, {"verse": 7, "start": 33806, "end": 38553, "text": "Entonces todas aquellas vírgenes se levantaron, y prepararon sus lámparas.", "words": [[0, 33806], [9, 34527], [15, 34807], [24, 35307], [33, 35727], [36, 35907], [48, 36507], [50, 36847], [61, 37487], [65, 37687]]}, {"verse": 8, "start": 38903, "end": 46379, "text": "Y las insensatas dijeron a las prudentes: Dadnos de vuestro aceite; porque nuestras lámparas se apagan.", "words": [[0, 38903], [2, 39006], [6, 39186], [17, 40346], [25, 41146], [27, 41266], [31, 41346], [42, 42397], [49, 42879], [52, 43079], [60, 43439], [68, 44353], [75, 44559], [84, 44859], [93, 45659], [96, 45819]]}, {"verse": 9, "start": 46729, "end": 56502, "text": "Pero las prudentes respondieron, diciendo: No sea que nos falte a nosotras y a vosotras, id antes a los que venden, y comprad para vosotras.", "words": [[0, 46729], [5, 46989], [9, 47209], [19, 47809], [33, 48589], [43, 49189], [46, 49729], [50, 49949], [54, 50129], [58, 50269], [64, 50689], [66, 50789], [75, 51369], [77, 51489], [79, 51589], [89, 52109], [92, 52629], [98, 53149], [100, 53389], [104, 53509], [108, 53649], [116, 54109], [118, 54609], [126, 55109], [131, 55589]]}, {"verse": 10, "start": 56852, "end": 66685, "text": "Y mientras que ellas iban a comprar, vino el esposo; y las que estaban preparadas, entraron con él a las bodas; y se cerró la puerta.", "words": [[0, 56852], [2, 56996], [11, 57416], [15, 57696], [21, 57936], [26, 58336], [28, 58436], [37, 58956], [42, 59576], [45, 59816], [53, 60739], [55, 61039], [59, 61159], [63, 61299], [71, 61619], [83, 62559], [92, 63659], [96, 63859], [99, 64059], [101, 64158], [105, 64279], [112, 65136], [114, 65299], [117, 65399], [123, 65859], [126, 65999]]}, {"verse": 11, "start": 67035, "end": 73147, "text": "Y después vinieron también las otras vírgenes, diciendo: Señor, Señor, ábrenos.", "words": [[0, 67035], [2, 67275], [10, 67575], [19, 68395], [27, 68775], [31, 69075], [37, 69355], [47, 69955], [57, 71209], [64, 71795], [71, 72375]]}, {"verse": 12, "start": 73497, "end": 77995, "text": "Pero respondiendo él, dijo: De cierto os digo, que no os conozco.", "words": [[0, 73497], [5, 73641], [18, 74441], [22, 74581], [28, 75615], [31, 75840], [38, 76065], [41, 76290], [47, 76610], [51, 76910], [54, 77270], [57, 77510]]}, {"verse": 13, "start": 78345, "end": 84399, "text": "Velad, pues, porque no sabéis el día ni la hora en que el Hijo del hombre ha de venir.", "words": [[0, 78345], [7, 79151], [13, 79371], [20, 80111], [23, 80311], [30, 80791], [33, 80991], [37, 81231], [40, 81591], [43, 81791], [48, 82091], [51, 82331], [55, 82491], [58, 82651], [63, 82931], [67, 83091], [74, 83451], [77, 83731], [80, 83891]]}, {"verse": 14, "start": 84749, "end": 92354, "text": "Porque el reino de los cielos es como un hombre que partiéndose lejos llamó a sus siervos, y les entregó sus bienes.", "words": [[0, 84749], [7, 84993], [10, 85213], [16, 85613], [19, 85733], [23, 85893], [30, 86333], [33, 86513], [38, 86733], [41, 86933], [48, 87193], [52, 87533], [64, 88293], [70, 88753], [76, 89053], [78, 89133], [82, 89293], [91, 89833], [93, 90433], [97, 90653], [105, 91413], [109, 91613]]}, {"verse": 15, "start": 92704, "end": 101057, "text": "Y a este dio cinco talentos, y al otro dos, y al otro uno: a cada uno conforme a su capacidad; y luego se fue lejos.", "words": [[0, 92704], [2, 92841], [4, 92941], [9, 93231], [13, 93521], [19, 93941], [29, 94841], [31, 95021], [34, 95161], [39, 95381], [44, 95641], [46, 95901], [49, 96041], [54, 96241], [59, 97030], [61, 97177], [66, 97377], [70, 97697], [79, 98057], [81, 98417], [84, 98517], [95, 99617], [97, 99737], [103, 99997], [106, 100277], [110, 100437]]}, {"verse": 16, "start": 101407, "end": 108885, "text": "Y el que había recibido cinco talentos se fue, y negoció con ellos, e hizo otros cinco talentos.", "words": [[0, 101407], [2, 101554], [5, 101674], [9, 101854], [15, 102094], [24, 102774], [30, 103054], [39, 103854], [42, 103974], [47, 104234], [49, 104734], [57, 105174], [61, 105454], [68, 105754], [70, 106454], [75, 106814], [81, 107334], [87, 107914]]}, {"verse": 17, "start": 109235, "end": 114095, "text": "Asimismo el que había recibido dos, ganó también él otros dos.", "words": [[0, 109560], [9, 109910], [12, 110050], [16, 110210], [22, 110450], [31, 111130], [36, 111850], [41, 112170], [49, 112450], [52, 112990], [58, 113470]]}, {"verse": 18, "start": 114445, "end": 121023, "text": "Pero el que había recibido uno, fue y cavó en la tierra, y escondió el dinero de su señor.", "words": [[0, 114445], [5, 114649], [8, 114809], [12, 114989], [18, 115229], [27, 115989], [32, 116329], [36, 116794], [38, 117204], [43, 117614], [46, 117774], [49, 117914], [57, 118374], [59, 118729], [68, 119389], [71, 119569], [78, 119909], [81, 120149], [84, 120309]]}, {"verse": 19, "start": 121373, "end": 127106, "text": "Y después de mucho tiempo, vino el señor de aquellos siervos, e hizo cuentas con ellos.", "words": [[0, 121373], [2, 121495], [10, 121795], [13, 121995], [19, 122215], [27, 122775], [32, 123300], [35, 123600], [41, 123920], [44, 124220], [53, 124480], [62, 125140], [64, 125580], [69, 125820], [77, 126360], [81, 126580]]}, {"verse": 20, "start": 127456, "end": 140808, "text": "Y llegando el que había recibido cinco talentos, trajo otros cinco talentos, diciendo: Señor, cinco talentos me entregaste; he aquí otros cinco talentos he ganado sobre ellos.", "words": [[0, 127456], [2, 127728], [11, 128058], [14, 128388], [18, 128508], [24, 128728], [33, 129388], [39, 129628], [49, 130808], [55, 131248], [61, 131568], [67, 132188], [77, 133208], [87, 134428], [94, 135067], [100, 135287], [109, 135927], [112, 136047], [124, 137219], [127, 137299], [132, 137579], [138, 137859], [144, 138339], [153, 139199], [156, 139319], [163, 139739], [169, 140099]]}, {"verse": 21, "start": 141158, "end": 151006, "text": "Y su señor le dijo: Bien, buen siervo y fiel; sobre poco has sido fiel, sobre mucho te pondré: entra en el gozo de tu señor.", "words": [[0, 141158], [2, 141264], [5, 141384], [11, 141784], [14, 141984], [20, 142681], [26, 143406], [31, 143606], [38, 144186], [40, 144306], [46, 144969], [52, 145213], [57, 145523], [61, 145833], [66, 145993], [72, 146853], [78, 147113], [84, 147593], [87, 147853], [95, 148794], [101, 149378], [104, 149558], [107, 149678], [112, 150078], [115, 150218], [118, 150378]]}, {"verse": 22, "start": 151356, "end": 161451, "text": "Y llegando también el que había recibido dos talentos, dijo: Señor, dos talentos me entregaste; he aquí otros dos talentos he ganado sobre ellos.", "words": [[0, 151356], [2, 151667], [11, 152147], [19, 152547], [22, 152907], [26, 153067], [32, 153287], [41, 154027], [45, 154227], [55, 154927], [61, 155718], [68, 156336], [72, 156656], [81, 157256], [84, 157589], [96, 158412], [99, 158692], [104, 158932], [110, 159212], [114, 159472], [123, 160052], [126, 160152], [133, 160492], [139, 160772]]}, {"verse": 23, "start": 161801, "end": 171670, "text": "Su señor le dijo: Bien, buen siervo y fiel; sobre poco has sido fiel, sobre mucho te pondré: entra en el gozo de tu señor.", "words": [[0, 161801], [3, 161947], [9, 162327], [12, 162607], [18, 163344], [24, 164070], [29, 164270], [36, 164850], [38, 164970], [44, 165633], [50, 165877], [55, 166187], [59, 166497], [64, 166657], [70, 167517], [76, 167777], [82, 168257], [85, 168517], [93, 169458], [99, 170042], [102, 170222], [105, 170342], [110, 170742], [113, 170882], [116, 171042]]}, {"verse": 24, "start": 172020, "end": 182500, "text": "Y llegando también el que había recibido un talento, dijo: Señor, te conocía que eres hombre duro, que siegas donde no sembraste, y recoges donde no esparciste;", "words": [[0, 172020], [2, 172124], [11, 172524], [19, 172884], [22, 173124], [26, 173284], [32, 173504], [41, 174164], [44, 174284], [53, 174844], [59, 175491], [66, 176071], [69, 176401], [77, 176731], [81, 176831], [86, 176971], [93, 177271], [99, 177971], [103, 178311], [110, 178651], [116, 178831], [119, 179091], [130, 179771], [132, 180251], [140, 180731], [146, 181191], [149, 181511]]}, {"verse": 25, "start": 182850, "end": 188277, "text": "Y tuve miedo, y fui, y escondí tu talento en la tierra: he aquí tienes lo que es tuyo.", "words": [[0, 182850], [2, 182991], [7, 183251], [14, 183651], [16, 183851], [21, 184111], [23, 184366], [31, 184966], [34, 185046], [42, 185606], [45, 185686], [48, 185786], [56, 186688], [59, 186788], [64, 187008], [71, 187348], [74, 187568], [78, 187688], [81, 187808]]}, {"verse": 26, "start": 188627, "end": 198801, "text": "Y respondiendo su señor, le dijo: Malo y negligente siervo, sabías que siego donde no sembré y que recojo donde no esparcí;", "words": [[0, 188627], [2, 188752], [15, 189532], [18, 189732], [25, 190632], [28, 190732], [34, 191535], [39, 191960], [41, 192419], [52, 192877], [60, 193897], [67, 194577], [71, 194927], [77, 195277], [83, 195497], [86, 195797], [93, 196637], [95, 196797], [99, 196937], [106, 197557], [112, 197777], [115, 198057]]}, {"verse": 27, "start": 199151, "end": 206960, "text": "Por tanto te convenía dar mi dinero a los banqueros, y viniendo yo, hubiera recibido lo que es mío con intereses.", "words": [[0, 199151], [4, 199275], [10, 199775], [13, 199895], [22, 200515], [26, 200695], [29, 200895], [36, 201255], [38, 201415], [42, 201515], [53, 202295], [55, 202695], [64, 203135], [68, 203715], [76, 204055], [85, 204795], [88, 204935], [92, 205095], [95, 205295], [99, 205695], [103, 205855]]}, {"verse": 28, "start": 207310, "end": 212398, "text": "Quitadle pues el talento, y dadlo al que tiene diez talentos.", "words": [[0, 207678], [9, 208068], [14, 208308], [17, 208728], [26, 209528], [28, 209768], [34, 210208], [37, 210428], [41, 210588], [47, 210958], [52, 211328]]}, {"verse": 29, "start": 212748, "end": 220644, "text": "Porque a cualquiera que tiene, le será dado, y tendrá más; y al que no tiene, aun lo que tiene le será quitado.", "words": [[0, 212748], [7, 213030], [9, 213190], [20, 213730], [24, 213890], [31, 214310], [34, 214670], [39, 214950], [45, 215390], [47, 215670], [54, 216070], [59, 216844], [61, 216991], [64, 217151], [68, 217311], [71, 217471], [78, 217891], [82, 218331], [85, 218631], [89, 218771], [95, 219431], [98, 219591], [103, 219891]]}, {"verse": 30, "start": 220994, "end": 228386, "text": "Y al siervo inútil echadle en las tinieblas de afuera: allí será el llanto y el crujir de dientes.", "words": [[0, 220994], [2, 221098], [5, 221218], [12, 221678], [19, 222358], [27, 223038], [30, 223278], [34, 223438], [44, 224158], [47, 224238], [55, 225071], [60, 225474], [65, 225734], [68, 225934], [75, 226574], [77, 226719], [80, 227079], [87, 227439], [90, 227599]]}, {"verse": 31, "start": 228736, "end": 238882, "text": "Y cuando el Hijo del hombre venga en su gloria, y todos los santos ángeles con él, entonces se sentará sobre el trono de su gloria.", "words": [[0, 228736], [2, 228843], [9, 229083], [12, 229343], [17, 229623], [21, 229803], [28, 230243], [34, 230603], [37, 230743], [40, 230903], [48, 232123], [50, 232363], [56, 232643], [60, 232943], [67, 233483], [75, 233983], [79, 234283], [83, 234888], [92, 235488], [95, 236088], [103, 236728], [109, 237028], [112, 237268], [118, 237728], [121, 237868], [124, 238048]]}, {"verse": 32, "start": 239232, "end": 249075, "text": "Y serán reunidas delante de él todas las naciones: y los apartará los unos de los otros, como aparta el pastor las ovejas de los cabritos.", "words": [[0, 239232], [2, 239358], [8, 239758], [17, 240418], [25, 240978], [28, 241198], [31, 241358], [37, 241738], [41, 242118], [51, 243158], [53, 243259], [57, 243379], [66, 244019], [70, 244279], [75, 244619], [78, 244939], [82, 245119], [89, 245459], [94, 245859], [101, 246499], [104, 246619], [111, 247119], [115, 247479], [122, 248019], [125, 248179], [129, 248299]]}, {"verse": 33, "start": 249425, "end": 254017, "text": "Y pondrá las ovejas a su derecha, y los cabritos a la izquierda.", "words": [[0, 249425], [2, 249547], [9, 250027], [13, 250227], [20, 250787], [22, 250947], [25, 251087], [34, 251707], [36, 252127], [40, 252267], [49, 252867], [51, 253107], [54, 253207]]}, {"verse": 34, "start": 254367, "end": 266667, "text": "Entonces el Rey dirá a los que estarán a su derecha: Venid, benditos de mi Padre, heredad el reino preparado para vosotros desde la fundación del mundo:", "words": [[0, 254367], [9, 255107], [12, 255587], [16, 256142], [21, 256562], [23, 256722], [27, 256862], [31, 257002], [39, 257442], [41, 257522], [44, 257662], [53, 258689], [60, 259134], [69, 259834], [72, 259994], [75, 260114], [82, 261334], [90, 261874], [93, 262194], [99, 262634], [109, 263354], [114, 263614], [123, 264394], [129, 264819], [132, 265199], [142, 265859], [146, 266079]]}, {"verse": 35, "start": 267017, "end": 274933, "text": "Porque tuve hambre, y me disteis de comer; tuve sed, y me disteis de beber; fui forastero, y me hospedasteis;", "words": [[0, 267017], [7, 267361], [12, 267701], [20, 268281], [22, 268721], [25, 268841], [33, 269361], [36, 269481], [43, 270497], [48, 270731], [53, 270964], [55, 271284], [58, 271384], [66, 271884], [69, 272024], [76, 272806], [80, 273040], [91, 273760], [93, 273820], [96, 273940]]}, {"verse": 36, "start": 275283, "end": 281844, "text": "Desnudo, y me cubristeis; enfermo, y me visitasteis; estuve en la cárcel, y vinisteis a mí.", "words": [[0, 275313], [9, 276037], [11, 276217], [14, 276745], [26, 277793], [35, 278073], [37, 278213], [40, 278333], [53, 279612], [60, 279979], [63, 280079], [66, 280179], [74, 280659], [76, 280879], [86, 281459], [88, 281579]]}, {"verse": 37, "start": 282194, "end": 291293, "text": "Entonces los justos le responderán, diciendo: Señor, ¿cuándo te vimos hambriento, y te sustentamos? ¿o sediento, y te dimos de beber?", "words": [[0, 282194], [9, 282794], [13, 283314], [20, 283874], [23, 284074], [36, 284794], [46, 285763], [53, 286566], [61, 286746], [64, 286986], [70, 287206], [82, 287886], [84, 288006], [87, 288126], [100, 289460], [103, 289585], [113, 290085], [115, 290245], [118, 290385], [124, 290685], [127, 290805]]}, {"verse": 38, "start": 291643, "end": 296181, "text": "¿Y cuándo te vimos forastero, y te hospedamos? ¿o desnudo, y te cubrimos?", "words": [[0, 291643], [3, 291749], [10, 291949], [13, 292189], [19, 292389], [30, 293189], [32, 293249], [35, 293369], [47, 294378], [50, 294618], [59, 295158], [61, 295278], [64, 295378]]}, {"verse": 39, "start": 296531, "end": 300610, "text": "¿O cuándo te vimos enfermo, o en la cárcel, y vinimos a ti?", "words": [[0, 296531], [3, 296679], [10, 296979], [13, 297219], [19, 297479], [28, 298239], [30, 298659], [33, 298799], [36, 298939], [44, 299459], [46, 299694], [54, 300134], [56, 300314]]}, {"verse": 40, "start": 300960, "end": 311497, "text": "Y respondiendo el Rey, les dirá: De cierto os digo que en cuanto lo hicisteis a uno de estos mis hermanos pequeñitos, a mí lo hicisteis.", "words": [[0, 300960], [2, 301166], [15, 301906], [18, 302086], [23, 302666], [27, 303008], [33, 303513], [36, 303718], [43, 303938], [46, 304358], [51, 304698], [55, 304958], [58, 305338], [65, 305658], [68, 305998], [78, 306978], [80, 307238], [84, 307418], [87, 307598], [93, 307878], [97, 308098], [106, 308718], [118, 310078], [120, 310258], [123, 310438], [126, 310598]]}, {"verse": 41, "start": 311847, "end": 322122, "text": "Entonces dirá también a los que estarán a la izquierda: Apartaos de mí, malditos, al fuego eterno preparado para el diablo y para sus ángeles:", "words": [[0, 311847], [9, 312521], [14, 313231], [22, 313631], [24, 313991], [28, 314131], [32, 314291], [40, 314751], [42, 314891], [45, 314991], [56, 316392], [65, 316752], [68, 316952], [72, 317072], [82, 318312], [85, 318632], [91, 318892], [98, 319492], [108, 320072], [113, 320252], [116, 320412], [123, 320772], [125, 320892], [130, 321092], [134, 321272]]}, {"verse": 42, "start": 322472, "end": 328331, "text": "Porque tuve hambre, y no me disteis de comer; tuve sed, y no me disteis de beber;", "words": [[0, 322472], [7, 322737], [12, 323037], [20, 323477], [22, 323777], [25, 323917], [28, 324057], [36, 324637], [39, 324777], [46, 325561], [51, 325823], [56, 326163], [58, 326563], [61, 326723], [64, 326843], [72, 327523], [75, 327927]]}, {"verse": 43, "start": 328681, "end": 337284, "text": "fui forastero, y no me hospedasteis; desnudo, y no me cubristeis; enfermo, y en la cárcel, y no me visitasteis.", "words": [[0, 328681], [4, 328916], [15, 329696], [17, 329716], [20, 329876], [23, 330016], [37, 331250], [46, 331855], [48, 332235], [51, 332355], [54, 332495], [66, 333734], [75, 334480], [77, 334800], [80, 334900], [83, 335040], [91, 335640], [93, 335980], [96, 336100], [99, 336240]]}, {"verse": 44, "start": 337634, "end": 350172, "text": "Entonces también ellos le responderán, diciendo: Señor, ¿cuándo te vimos hambriento, o sediento, o forastero, o desnudo, o enfermo, o en la cárcel, y no te servimos?", "words": [[0, 337634], [9, 338214], [17, 338514], [23, 338764], [26, 339014], [39, 339814], [49, 341069], [56, 342055], [64, 342455], [67, 342755], [73, 343015], [85, 343875], [87, 344055], [97, 344655], [99, 344815], [110, 345555], [112, 345875], [121, 346555], [123, 346815], [132, 347555], [134, 347735], [137, 347855], [140, 347995], [148, 348595], [150, 349035], [153, 349175], [156, 349315]]}, {"verse": 45, "start": 350522, "end": 360971, "text": "Entonces les responderá, diciendo: De cierto os digo que en cuanto no lo hicisteis a uno de estos pequeñitos, ni a mí lo hicisteis.", "words": [[0, 350522], [9, 351089], [13, 351749], [25, 352709], [35, 353749], [38, 353954], [45, 354214], [48, 354614], [53, 354914], [57, 355194], [60, 355594], [67, 355954], [70, 356494], [73, 356714], [83, 357594], [85, 357854], [89, 358054], [92, 358234], [98, 358454], [110, 359114], [113, 359774], [115, 359914], [118, 359994], [121, 360134]]}, {"verse": 46, "start": 361321, "end": 366296, "text": "E irán estos al castigo eterno, y los justos a la vida eterna.", "words": [[0, 361321], [2, 361437], [7, 361757], [13, 362077], [16, 362517], [24, 363077], [32, 364137], [34, 364297], [38, 364437], [45, 365017], [47, 365137], [50, 365237], [55, 365477]]}]}