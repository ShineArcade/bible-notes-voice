{"book": "PSA", "chapter": 56, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 89494, "verses": [{"verse": 1, "start": 300, "end": 17145, "text": "Al Músico principal: sobre La paloma silenciosa en paraje muy distante. Michtam de David, cuando los filisteos le prendieron en Gat. TEN misericordia de mí, oh Dios, porque me devoraría el hombre: me oprime combatiéndome cada día.", "words": [[0, 300], [3, 504], [10, 984], [21, 2092], [27, 2311], [30, 2531], [37, 2971], [48, 3691], [51, 3871], [58, 4311], [62, 4531], [72, 6008], [80, 6288], [83, 6428], [90, 7088], [97, 7388], [101, 7998], [111, 8608], [114, 8828], [125, 9468], [128, 9840], [133, 10483], [137, 10573], [150, 11413], [153, 11533], [157, 11873], [160, 12033], [166, 12613], [173, 12773], [176, 12993], [186, 13613], [189, 13833], [197, 14611], [200, 14935], [207, 15295], [221, 16395], [226, 16615]]}, {"verse": 2, "start": 17495, "end": 24412, "text": "Me acosan mis enemigos cada día; porque muchos son los que pelean contra mí, oh Altísimo.", "words": [[0, 17495], [3, 17801], [10, 18321], [14, 18561], [23, 19201], [28, 19441], [33, 20331], [40, 20535], [47, 20935], [51, 21355], [55, 21515], [59, 21695], [66, 22195], [73, 22535], [77, 22935], [80, 23335]]}, {"verse": 3, "start": 24762, "end": 27527, "text": "En el día que temo, yo en ti confío.", "words": [[0, 24762], [3, 24984], [6, 25124], [10, 25304], [14, 25544], [20, 25784], [23, 26084], [26, 26404], [29, 26644]]}, {"verse": 4, "start": 27877, "end": 34686, "text": "En Dios alabaré su palabra: en Dios he confiado, no temeré. ¿Qué puede hacerme el hombre?", "words": [[0, 27877], [3, 28043], [8, 28303], [16, 28963], [19, 29083], [28, 30091], [31, 30260], [36, 30540], [39, 30880], [49, 32020], [52, 32180], [60, 33082], [65, 33166], [71, 33446], [79, 33946], [82, 34146]]}, {"verse": 5, "start": 35036, "end": 41308, "text": "Todos los días me contristan mis negocios; contra mí son todos sus pensamientos para mal.", "words": [