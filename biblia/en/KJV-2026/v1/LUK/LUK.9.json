{"book": "LUK", "chapter": 9, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 454313, "verses": [{"verse": 1, "start": 300, "end": 7919, "text": "Then he called his twelve disciples together, and gave them power and authority over all demons, and to cure diseases.", "words": [[0, 300], [5, 566], [8, 766], [15, 1146], [19, 1386], [26, 1746], [36, 2286], [46, 2706], [50, 3406], [55, 3626], [60, 3866], [66, 4266], [70, 4526], [80, 5026], [85, 5366], [89, 5646], [97, 6066], [101, 6666], [104, 6806], [109, 7066]]}, {"verse": 2, "start": 8269, "end": 11542, "text": "And he sent them to preach the kingdom of God, and to heal the sick.", "words": [[0, 8269], [4, 8403], [7, 8503], [12, 8723], [17, 8963], [20, 9083], [27, 9343], [31, 9563], [39, 9843], [42, 10083], [47, 10403], [51, 10623], [54, 10743], [59, 10903], [63, 11083]]}, {"verse": 3, "start": 11892, "end": 21273, "text": "And he said to them, Take nothing for your journey, neither staves, nor bag, neither bread, neither money; neither have two coats apiece.", "words": [[0, 11892], [4, 12017], [7, 12117], [12, 12317], [15, 12497], [21, 13068], [26, 13225], [34, 13605], [38, 13945], [43, 14105], [52, 14765], [60, 14945], [68, 15825], [72, 16005], [77, 16745], [85, 16925], [92, 17665], [100, 17825], [107, 19433], [115, 19673], [120, 19933], [124, 20173], [130, 20723]]}, {"verse": 4, "start": 21623, "end": 25536, "text": "And whatever house you enter into, there abide, and from there depart.", "words": [[0, 21623], [4, 21742], [13, 22022], [19, 22362], [23, 22582], [29, 22842], [35, 23562], [41, 23682], [48, 24062], [52, 24442], [57, 24622], [63, 24882]]}, {"verse": 5, "start": 25886, "end": 32691, "text": "And whoever will not receive you, when you go out of that city, shake off the very dust from your feet for a testimony against them.", "words": [[0, 25886], [4, 26025], [12, 26305], [17, 26585], [21, 26785], [29, 27185], [34, 27765], [39, 27925], [43, 28065], [46, 28205], [50, 28385], [53, 28465], [58, 28645], [64, 29285], [70, 29565], [74, 29805], [78, 30005], [83, 30245], [88, 30545], [93, 30805], [98, 30945], [103, 31225], [107, 31425], [109, 31545], [119, 31885], [127, 32305]]}, {"verse": 6, "start": 32971, "end": 38237, "text": "And they departed, and went through the towns, preaching the gospel, and healing every where.", "words": [[0, 32971], [4, 33119], [9, 33239], [19, 33739], [23, 34119], [28, 34339], [36, 34559], [40, 34719], [47, 35499], [57, 35959], [61, 36159], [69, 36619], [73, 36924], [81, 37378], [87, 37832]]}, {"verse": 7, "start": 38587, "end": 47442, "text": "¶ Now Herod the tetrarch heard of all that was done by him: and he was perplexed, because that it was said of some, that John was risen from the dead;", "words": [[2, 38587], [6, 39094], [12, 39414], [16, 39574], [25, 40174], [31, 40394], [34, 40614], [38, 40814], [43, 40994], [47, 41154], [52, 41394], [55, 41654], [60, 42318], [64, 42472], [67, 42592], [71, 42772], [82, 43552], [90, 43812], [95, 44152], [98, 44252], [102, 44372], [107, 44632], [110, 44752], [116, 45112], [121, 45477], [126, 45817], [130, 46097], [136, 46437], [141, 46717], [145, 46897]]}, {"verse": 8, "start": 47792, "end": 53808, "text": "And of some, that Elias had appeared; and of others, that one of the old prophets was risen again.", "words": [[0, 47792], [4, 47935], [7, 48055], [13, 48415], [18, 48885], [24, 49355], [28, 49575], [38, 50295], [42, 50459], [45, 50599], [53, 50999], [58, 51359], [62, 51559], [65, 51679], [69, 51819], [73, 52019], [82, 52539], [86, 52879], [92, 53219]]}, {"verse": 9, "start": 54158, "end": 61168, "text": "And Herod said, John have I beheaded: but who is this, of whom I hear such things? And he desired to see him.", "words": [[0, 54158], [4, 54345], [10, 54725], [16, 55505], [21, 55803], [26, 55903], [28, 56023], [38, 56798], [42, 56896], [46, 57076], [49, 57216], [55, 57476], [58, 57936], [63, 58136], [65, 58336], [70, 58556], [75, 58756], [83, 59674], [87, 59800], [90, 59900], [98, 60320], [101, 60560], [105, 60760]]}, {"verse": 10, "start": 61518, "end": 71553, "text": "¶ And the apostles, when they were returned, told him all that they had done. And he took them, and went aside privately into a desert place belonging to the city called Bethsaida.", "words": [[2, 61518], [6, 61645], [10, 61745], [20, 62165], [25, 62465], [30, 62625], [35, 62745], [45, 63245], [50, 63825], [54, 64105], [58, 64385], [63, 64565], [68, 64725], [72, 64865], [78, 65574], [82, 65701], [85, 65801], [90, 66041], [96, 66321], [100, 66841], [105, 67021], [111, 67321], [121, 67821], [126, 68161], [128, 68341], [135, 68541], [141, 68921], [151, 69301], [154, 69621], [158, 69721], [163, 69961], [170, 70796]]}, {"verse": 11, "start": 71903, "end": 79617, "text": "And the people, when they knew it, followed him: and he received them, and spoke to them of the kingdom of God, and healed them that had need of healing.", "words": [[0, 71903], [4, 72028], [8, 72148], [16, 72368], [21, 72588], [26, 72748], [31, 72968], [35, 73128], [44, 73528], [49, 74228], [53, 74366], [56, 74466], [65, 74946], [71, 75206], [75, 75446], [81, 75726], [84, 75986], [89, 76186], [92, 76406], [96, 76526], [104, 76786], [107, 77026], [112, 77326], [116, 77606], [123, 77906], [128, 78226], [133, 78426], [137, 78606], [142, 78846], [145, 79026]]}, {"verse": 12, "start": 79967, "end": 92191, "text": "And when the day began to wear away, then came the twelve, and said to him, Send the multitude away, that they may go into the towns and country round about, and lodge, and get provisions: for we are here in a desert place.", "words": [[0, 79967], [4, 80092], [9, 80252], [13, 80392], [17, 80612], [23, 80972], [26, 81152], [31, 81412], [37, 81792], [42, 82052], [47, 82332], [51, 82492], [59, 82832], [63, 83137], [68, 83358], [71, 83557], [76, 84184], [81, 84264], [85, 84364], [95, 84764], [101, 85164], [106, 85409], [111, 85569], [115, 85689], [118, 85929], [123, 86149], [127, 86309], [133, 86709], [137, 86949], [145, 87276], [151, 87602], [158, 87929], [162, 88379], [169, 88829], [173, 89129], [177, 89349], [189, 90350], [193, 90448], [196, 90648], [200, 90768], [205, 91028], [208, 91228], [210, 91328], [217, 91588]]}, {"verse": 13, "start": 92471, "end": 101642, "text": "But he said to them, You give them something to eat. And they said, We have no more but five loaves and two fishes; unless we should go and buy food for all this people.", "words": [[0, 92471], [4, 92599], [7, 92679], [12, 92879], [15, 93079], [21, 93597], [25, 93695], [30, 93875], [35, 94055], [45, 94395], [48, 94615], [53, 95325], [57, 95475], [62, 95595], [68, 96284], [71, 96384], [76, 96604], [79, 96804], [84, 97084], [88, 97264], [93, 97604], [100, 98044], [104, 98184], [108, 98404], [116, 99260], [123, 99442], [126, 99642], [133, 99762], [136, 99982], [140, 100102], [144, 100262], [149, 100542], [153, 100762], [157, 100972], [162, 101182]]}, {"verse": 14, "start": 101922, "end": 108523, "text": "For they were about five thousand men. And he said to his disciples, Make them sit down by fifties in a company.", "words": [[0, 101922], [4, 102041], [9, 102201], [14, 102381], [20, 102761], [25, 103141], [34, 103521], [39, 104270], [43, 104393], [46, 104493], [51, 104713], [54, 104893], [58, 105033], [69, 106081], [74, 106221], [79, 106441], [83, 106701], [88, 107021], [91, 107451], [99, 107881], [102, 107961], [104, 108081]]}, {"verse": 15, "start": 108803, "end": 111653, "text": "And they did so, and made them all sit down.", "words": [[0, 108803], [4, 108952], [9, 109052], [13, 109292], [17, 109992], [21, 110112], [26, 110292], [31, 110492], [35, 110712], [39, 110992]]}, {"verse": 16, "start": 112003, "end": 122251, "text": "Then he took the five loaves and the two fishes, and looking up to heaven, he blessed them, and broke, and gave to the disciples to set before the multitude.", "words": [[0, 112003], [5, 112258], [8, 112498], [13, 112758], [17, 112978], [22, 113298], [29, 113918], [33, 114078], [37, 114218], [41, 114418], [49, 115358], [53, 115558], [61, 115818], [64, 116078], [67, 116278], [75, 116938], [78, 117118], [86, 117458], [92, 117798], [96, 118218], [103, 119098], [107, 119198], [112, 119498], [115, 119698], [119, 119838], [129, 120318], [132, 120658], [136, 120918], [143, 121238], [147, 121458]]}, {"verse": 17, "start": 122601, "end": 128232, "text": "And they did eat, and were all filled: and there was taken up of fragments that remained to them twelve baskets.", "words": [[0, 122601], [4, 122742], [9, 122882], [13, 123102], [18, 123282], [22, 123702], [27, 123902], [31, 124062], [39, 124787], [43, 124914], [49, 124994], [53, 125154], [59, 125394], [62, 125614], [65, 125734], [75, 126114], [80, 126434], [89, 126734], [92, 126954], [97, 127154], [104, 127354]]}, {"verse": 18, "start": 128582, "end": 136387, "text": "¶ And it came to pass, as he was alone praying, his disciples were with him: and he asked them, saying, Whom say the people that I am?", "words": [[2, 128582], [6, 128723], [9, 128823], [14, 129043], [17, 129243], [23, 129563], [26, 129883], [29, 130023], [33, 130183], [39, 130483], [48, 131303], [52, 131443], [62, 131943], [67, 132263], [72, 132483], [77, 132983], [81, 133147], [84, 133307], [90, 133587], [96, 133967], [104, 134838], [109, 135112], [113, 135312], [117, 135452], [124, 135672], [129, 135872], [131, 136032]]}, {"verse": 19, "start": 136667, "end": 143753, "text": "They answering said, John the Baptist; but some say, Elias; and others say, that one of the old prophets is risen again.", "words": [[0, 136733], [5, 136813], [15, 137213], [21, 138106], [26, 138206], [30, 138346], [39, 139211], [43, 139315], [48, 139555], [53, 139815], [60, 140699], [64, 140821], [71, 141061], [76, 141441], [81, 141861], [85, 142061], [88, 142181], [92, 142281], [96, 142401], [105, 142781], [108, 143021], [114, 143261]]}, {"verse": 20, "start": 144033, "end": 150410, "text": "He said to them, But whom say you that I am? Peter answering said, The Christ of God.", "words": [[0, 144033], [3, 144125], [8, 144325], [11, 144505], [17, 145050], [21, 145154], [26, 145434], [30, 145654], [34, 145854], [39, 146034], [41, 146194], [43, 147189], [45, 147737], [51, 147977], [61, 148477], [67, 149279], [71, 149420], [78, 149780], [81, 149980]]}, {"verse": 21, "start": 150690, "end": 155165, "text": "And he sternly charged them, and commanded them to tell no man that thing;", "words": [[0, 150690], [4, 150816], [7, 150976], [15, 151596], [23, 152016], [29, 152356], [33, 152636], [43, 153136], [48, 153456], [51, 153636], [56, 153896], [59, 154156], [63, 154416], [68, 154696]]}, {"verse": 22, "start": 155515, "end": 164524, "text": "Saying, The Son of man must suffer many things, and be rejected of the elders and chief priests and scribes, and be slain, and be raised the third day.", "words": [[0, 155515], [8, 156300], [12, 156382], [16, 156642], [19, 156742], [23, 157042], [28, 157282], [35, 157582], [40, 157902], [48, 158622], [52, 158862], [55, 158982], [64, 159402], [67, 159642], [71, 159762], [78, 160022], [82, 160382], [88, 160642], [96, 161022], [100, 161342], [109, 162062], [113, 162082], [116, 162222], [123, 163082], [127, 163122], [130, 163262], [137, 163582], [141, 163822], [147, 164042]]}, {"verse": 23, "start": 164804, "end": 172001, "text": "¶ And he said to them all, If any man will come after me, let him deny himself, and take up his cross daily, and follow me.", "words": [[2, 164804], [6, 164926], [9, 165046], [14, 165266], [17, 165446], [22, 165606], [27, 166288], [30, 166431], [34, 166611], [38, 166871], [43, 167051], [48, 167251], [54, 167551], [58, 168251], [62, 168411], [66, 168551], [71, 168871], [80, 169271], [84, 169551], [89, 169771], [92, 169951], [96, 170071], [102, 170351], [109, 170771], [113, 171311], [120, 171631]]}, {"verse": 24, "start": 172351, "end": 178764, "text": "For whoever will save his life shall lose it: but whoever will lose his life for my sake, the same shall save it.", "words": [[0, 172351], [4, 172432], [12, 172692], [17, 172952], [22, 173192], [26, 173372], [31, 173652], [37, 173872], [42, 174132], [46, 174648], [50, 174770], [58, 175110], [63, 175470], [68, 175810], [72, 176010], [77, 176390], [81, 176570], [84, 176790], [90, 177490], [94, 177650], [99, 177930], [105, 178190], [110, 178490]]}, {"verse": 25, "start": 179114, "end": 184387, "text": "For what is a man advantaged, if he gain the whole world, and lose himself, or be cast away?", "words": [[0, 179114], [4, 179218], [9, 179398], [12, 179558], [14, 179638], [18, 179878], [30, 180598], [33, 180998], [36, 181118], [41, 181338], [45, 181538], [51, 181738], [58, 182158], [62, 182418], [67, 182638], [76, 183158], [79, 183398], [82, 183578], [87, 183818]]}, {"verse": 26, "start": 184737, "end": 195727, "text": "For whoever shall be ashamed of me and of my words, of him shall the Son of man be ashamed, when he shall come in his own glory, and in his Father’s, and of the holy angels.", "words": [[0, 184737], [4, 184868], [12, 185208], [18, 185528], [21, 185728], [29, 186088], [32, 186368], [35, 186588], [39, 186868], [42, 187028], [45, 187208], [52, 188228], [55, 188388], [59, 188568], [65, 188828], [69, 188988], [73, 189228], [76, 189348], [80, 189608], [83, 189848], [92, 190628], [97, 190868], [100, 191008], [106, 191188], [111, 191508], [114, 191708], [118, 191868], [122, 192068], [129, 192856], [133, 193100], [136, 193240], [140, 193400], [150, 194280], [154, 194520], [157, 194680], [161, 194800], [166, 195000]]}, {"verse": 27, "start": 196077, "end": 202145, "text": "But I tell you of a truth, there are some standing here, which shall not taste of death, till they see the kingdom of God.", "words": [[0, 196077], [4, 196213], [6, 196333], [11, 196533], [15, 196693], [18, 196833], [20, 196913], [27, 197493], [33, 197653], [37, 197813], [42, 198033], [51, 198393], [57, 198753], [63, 199173], [69, 199393], [73, 199593], [79, 199893], [82, 200073], [89, 200333], [94, 200693], [99, 200853], [103, 201033], [107, 201173], [115, 201453], [118, 201673]]}, {"verse": 28, "start": 202425, "end": 210052, "text": "¶ And it came to pass about an eight days after these sayings, he took Peter and John and James, and went up into a mountain to pray.", "words": [[2, 202425], [6, 202555], [9, 202675], [14, 202835], [17, 203015], [22, 203335], [28, 203555], [31, 203775], [37, 203995], [42, 204335], [48, 204675], [54, 205205], [63, 205735], [66, 205895], [71, 206075], [77, 206415], [81, 206675], [86, 206995], [90, 207235], [97, 207655], [101, 208215], [106, 208395], [109, 208615], [114, 208815], [116, 208975], [125, 209255], [128, 209495]]}, {"verse": 29, "start": 210402, "end": 216705, "text": "And as he prayed, the fashion of his countenance was altered, and his clothing was white and glistering.", "words": [[0, 210402], [4, 210547], [7, 210747], [10, 210867], [18, 211667], [22, 211907], [30, 212307], [33, 212507], [37, 212647], [49, 213267], [53, 213407], [62, 214207], [66, 214407], [70, 214567], [79, 214987], [83, 215347], [89, 215727], [93, 215947]]}, {"verse": 30, "start": 217055, "end": 222068, "text": "And, behold, there talked with him two men, which were Moses and Elias:", "words": [[0, 217055], [5, 217325], [13, 218165], [19, 218305], [26, 218605], [31, 218905], [35, 219045], [39, 219325], [44, 220065], [50, 220325], [55, 220525], [61, 220945], [65, 221405]]}, {"verse": 31, "start": 222418, "end": 227636, "text": "Who appeared in glory, and spoke of his decease which he should accomplish at Jerusalem.", "words": [[0, 222418], [4, 222535], [13, 222835], [16, 223015], [23, 223955], [27, 224235], [33, 224535], [36, 224795], [40, 224935], [48, 225535], [54, 225755], [57, 225895], [64, 226075], [75, 226535], [78, 226795]]}, {"verse": 32, "start": 227986, "end": 235878, "text": "But Peter and they that were with him were heavy with sleep: and when they were awake, they saw his glory, and the two men that stood with him.", "words": [[0, 227986], [4, 228106], [10, 228406], [14, 228646], [19, 228846], [24, 229046], [29, 229206], [34, 229486], [38, 229686], [43, 229866], [49, 230146], [54, 230366], [61, 231156], [65, 231299], [70, 231459], [75, 231659], [80, 231859], [87, 232579], [92, 232719], [96, 233039], [100, 233259], [107, 233739], [111, 234179], [115, 234319], [119, 234539], [123, 234839], [128, 235039], [134, 235279], [139, 235599]]}, {"verse": 33, "start": 236228, "end": 249375, "text": "And it came to pass, as they departed from him, Peter said to Jesus, Master, it is good for us to be here: and let us make three tabernacles; one for you, and one for Moses, and one for Elias: not knowing what he said.", "words": [[0, 236228], [4, 236351], [7, 236451], [12, 236711], [15, 236911], [21, 237211], [24, 237471], [29, 237611], [38, 238031], [43, 238351], [48, 238931], [54, 239191], [59, 239491], [62, 239671], [69, 240480], [77, 240947], [80, 240987], [83, 241127], [88, 241327], [92, 241547], [95, 241707], [98, 241827], [101, 241967], [107, 242571], [111, 242691], [115, 242831], [118, 242951], [123, 243131], [129, 243701], [142, 244444], [146, 244647], [150, 244867], [155, 245087], [159, 245547], [163, 245727], [167, 245947], [174, 246247], [178, 246827], [182, 247047], [186, 247267], [193, 248140], [197, 248294], [205, 248554], [210, 248794], [213, 248894]]}, {"verse": 34, "start": 249725, "end": 256188, "text": "While he thus spoke, there came a cloud, and overshadowed them: and they feared as they entered into the cloud.", "words": [[0, 249725], [6, 249895], [9, 250055], [14, 250215], [21, 250975], [27, 251115], [32, 251315], [34, 251455], [41, 251895], [45, 252415], [58, 253275], [64, 253775], [68, 253900], [73, 254040], [80, 254380], [83, 254620], [88, 254760], [96, 255100], [101, 255380], [105, 255520]]}, {"verse": 35, "start": 256538, "end": 262056, "text": "And there came a voice out of the cloud, saying, This is my beloved Son: hear him.", "words": [[0, 256538], [4, 256664], [10, 256784], [15, 257004], [17, 257184], [23, 257564], [27, 257844], [30, 257964], [34, 258084], [41, 258504], [49, 259468], [54, 259613], [57, 259733], [60, 259913], [68, 260253], [73, 261416], [78, 261636]]}, {"verse": 36, "start": 262563, "end": 271666, "text": "And when the voice was past, Jesus was found alone. And they kept it close, and told no man in those days any of those things which they had seen.", "words": [[0, 262563], [4, 262700], [9, 262840], [13, 262980], [19, 263240], [23, 263810], [29, 264380], [35, 264800], [39, 265140], [45, 265440], [52, 266334], [56, 266479], [61, 266579], [66, 266819], [69, 266959], [76, 267299], [80, 267939], [85, 268199], [88, 268459], [92, 268779], [95, 268959], [101, 269159], [106, 269399], [110, 269779], [113, 269959], [119, 270139], [126, 270479], [132, 270719], [137, 270939], [141, 271099]]}, {"verse": 37, "start": 272016, "end": 277287, "text": "¶ And it came to pass, that on the next day, when they were come down from the hill, much people met him.", "words": [[2, 272016], [6, 272142], [9, 272242], [14, 272442], [17, 272602], [23, 272962], [28, 273262], [31, 273422], [35, 273522], [40, 273742], [45, 274082], [50, 274322], [55, 274442], [60, 274582], [65, 274782], [70, 275042], [75, 275282], [79, 275462], [85, 276102], [90, 276282], [97, 276602], [101, 276882]]}, {"verse": 38, "start": 277637, "end": 284707, "text": "And, behold, a man of the company cried out, saying, Master, I beg you, look upon my son: for he is my only child.", "words": [[0, 277637], [5, 277799], [13, 278479], [15, 278679], [19, 278879], [22, 278979], [26, 279119], [34, 279419], [40, 279719], [45, 280139], [53, 280859], [61, 281342], [63, 281422], [67, 281602], [72, 282222], [77, 282322], [82, 282482], [85, 282702], [90, 283384], [94, 283503], [97, 283663], [100, 283803], [103, 283943], [108, 284163]]}, {"verse": 39, "start": 285057, "end": 292470, "text": "And, lo, a spirit takes him, and he suddenly cries out; and it tears him that he foams again, and bruising him hardly departs from him.", "words": [[0, 285057], [5, 285175], [9, 285615], [11, 285715], [18, 285955], [24, 286275], [29, 286535], [33, 286875], [36, 286995], [45, 287215], [51, 287555], [56, 288252], [60, 288418], [63, 288518], [69, 288818], [73, 289098], [78, 289258], [81, 289358], [87, 289838], [94, 290158], [98, 290558], [107, 290978], [111, 291158], [118, 291478], [126, 292058], [131, 292178]]}, {"verse": 40, "start": 292820, "end": 296449, "text": "And I besought your disciples to cast him out; and they could not.", "words": [[0, 292820], [4, 292943], [6, 293063], [15, 293583], [20, 293763], [30, 294283], [33, 294523], [38, 294783], [42, 294983], [47, 295503], [51, 295628], [56, 295748], [62, 295948]]}, {"verse": 41, "start": 296729, "end": 304992, "text": "And Jesus answering said, O faithless and perverse generation, how long shall I be with you, and bear with you? Bring your son here.", "words": [[0, 296729], [4, 296873], [10, 297253], [20, 297793], [26, 298536], [28, 298699], [38, 299379], [42, 299519], [51, 299939], [63, 301019], [67, 301179], [72, 301479], [78, 301719], [80, 301879], [83, 302019], [88, 302259], [93, 302479], [97, 302799], [102, 303059], [107, 303319], [112, 303897], [118, 304042], [123, 304222], [127, 304522]]}, {"verse": 42, "start": 305272, "end": 315108, "text": "And as he was yet a coming, the demon threw him down, and convulsed him. And Jesus rebuked the unclean spirit, and healed the child, and delivered him again to his father.", "words": [[0, 305272], [4, 305382], [7, 305602], [10, 305742], [14, 305902], [18, 306062], [20, 306202], [28, 306922], [32, 307002], [38, 307262], [44, 307522], [48, 307722], [54, 308042], [58, 308422], [68, 309022], [73, 309513], [77, 309658], [83, 309938], [91, 310678], [95, 310838], [103, 311338], [111, 311718], [115, 311998], [122, 312298], [126, 312478], [133, 312818], [137, 313318], [147, 313618], [151, 313858], [157, 314178], [160, 314418], [164, 314578]]}, {"verse": 43, "start": 315458, "end": 324938, "text": "¶ And they were all amazed at the mighty power of God. But while they wondered every one at all things which Jesus did, he said to his disciples,", "words": [[2, 315458], [6, 315606], [11, 315726], [16, 315926], [20, 316266], [27, 316786], [30, 317086], [34, 317206], [41, 317586], [47, 318066], [50, 318286], [55, 319095], [59, 319225], [65, 319465], [70, 319705], [79, 320005], [85, 320305], [89, 320605], [92, 320945], [96, 321145], [103, 321505], [109, 321905], [115, 322345], [120, 323345], [123, 323465], [128, 323705], [131, 323905], [135, 324045]]}, {"verse": 44, "start": 325138, "end": 331603, "text": "Let these sayings sink down into your ears: for the Son of man shall be delivered into the hands of men.", "words": [[0, 325138], [4, 325335], [10, 325635], [18, 326195], [23, 326455], [28, 326835], [33, 327175], [38, 327415], [44, 328242], [48, 328353], [52, 328473], [56, 328713], [59, 328853], [63, 329233], [69, 329593], [72, 329733], [82, 330113], [87, 330533], [91, 330693], [97, 331013], [100, 331233]]}, {"verse": 45, "start": 331883, "end": 339343, "text": "But they understood not this saying, and it was hid from them, that they perceived it not: and they feared to ask him of that saying.", "words": [[0, 331883], [4, 331988], [9, 332128], [20, 332688], [24, 333008], [29, 333308], [37, 334028], [41, 334308], [44, 334408], [48, 334588], [52, 334788], [57, 335068], [63, 335308], [68, 335768], [73, 335928], [83, 336408], [86, 336608], [91, 337315], [95, 337417], [100, 337537], [107, 337797], [110, 338017], [114, 338257], [118, 338437], [121, 338577], [126, 338757]]}, {"verse": 46, "start": 339693, "end": 343796, "text": "¶ Then there arose a reasoning among them, which of them should be greatest.", "words": [[2, 339693], [7, 340048], [13, 340308], [19, 340648], [21, 340808], [31, 341148], [37, 341508], [43, 342028], [49, 342248], [52, 342408], [57, 342608], [64, 342848], [67, 343028]]}, {"verse": 47, "start": 344146, "end": 348703, "text": "And Jesus, perceiving the thought of their heart, took a child, and set him by him,", "words": [[0, 344146], [4, 344269], [11, 344769], [22, 345329], [26, 345509], [34, 345769], [37, 345889], [43, 346069], [50, 346609], [55, 346749], [57, 346909], [64, 347309], [68, 347619], [72, 347929], [76, 348089], [79, 348369]]}, {"verse": 48, "start": 349053, "end": 359405, "text": "And said to them, Whoever shall receive this child in my name receives me: and whoever shall receive me receives him that sent me: for he that is least among you all, the same shall be great.", "words": [[0, 349053], [4, 349211], [9, 349411], [12, 349631], [18, 350215], [26, 350473], [32, 350793], [40, 351193], [45, 351433], [51, 351793], [54, 351973], [57, 352153], [62, 352433], [71, 352713], [75, 353414], [79, 353518], [87, 353738], [93, 354078], [101, 354458], [104, 354678], [113, 354978], [117, 355338], [122, 355518], [127, 355738], [131, 356275], [135, 356381], [138, 356601], [143, 356801], [146, 356941], [152, 357141], [158, 357401], [162, 357661], [167, 358241], [171, 358321], [176, 358581], [182, 358801], [185, 358941]]}, {"verse": 49, "start": 359685, "end": 366864, "text": "¶ And John answered and said, Master, we saw one casting out demons in your name; and we forbade him, because he follows not with us.", "words": [[2, 359685], [6, 359825], [11, 360085], [20, 360525], [24, 360765], [30, 361346], [38, 361807], [41, 361867], [45, 362047], [49, 362287], [57, 362667], [61, 362847], [68, 363187], [71, 363447], [76, 363567], [82, 364234], [86, 364362], [89, 364502], [97, 364982], [102, 365342], [110, 365562], [113, 365742], [121, 365942], [125, 366222], [130, 366442]]}, {"verse": 50, "start": 367144, "end": 372639, "text": "And Jesus said to him, Forbid him not: for he that is not against us is for us.", "words": [[0, 367144], [4, 367295], [10, 367595], [15, 367995], [18, 368195], [23, 368696], [30, 369247], [34, 369387], [39, 370113], [43, 370219], [46, 370459], [51, 370699], [54, 370879], [58, 371079], [66, 371339], [69, 371739], [72, 371999], [76, 372239]]}, {"verse": 51, "start": 372919, "end": 380345, "text": "¶ And it came to pass, when the time was come that he should be received up, he steadfastly set his face to go to Jerusalem,", "words": [[2, 372919], [6, 373051], [9, 373151], [14, 373391], [17, 373591], [23, 374531], [28, 374711], [32, 374851], [37, 375131], [41, 375331], [46, 375571], [51, 375791], [54, 375951], [61, 376131], [64, 376291], [73, 376711], [77, 377451], [80, 377551], [92, 378411], [96, 378611], [100, 378811], [105, 379071], [108, 379291], [111, 379451], [114, 379571]]}, {"verse": 52, "start": 380695, "end": 387049, "text": "And sent messengers before his face: and they went, and entered into a village of the Samaritans, to make ready for him.", "words": [[0, 380695], [4, 380839], [9, 381079], [20, 381639], [27, 381999], [31, 382259], [37, 383030], [41, 383182], [46, 383282], [52, 383502], [56, 383762], [64, 384082], [69, 384382], [71, 384542], [79, 384782], [82, 385022], [86, 385142], [98, 385842], [101, 386062], [106, 386242], [112, 386462], [116, 386722]]}, {"verse": 53, "start": 387399, "end": 391476, "text": "And they did not receive him, because his face was as though he would go to Jerusalem.", "words": [[0, 387399], [4, 387526], [9, 387626], [13, 387806], [17, 387966], [25, 388366], [30, 388766], [38, 389126], [42, 389346], [47, 389626], [51, 389866], [54, 390026], [61, 390226], [64, 390366], [70, 390506], [73, 390666], [76, 390806]]}, {"verse": 54, "start": 391826, "end": 400735, "text": "And when his disciples James and John saw this, they said, Lord, will you that we command fire to come down from heaven, and consume them, even as Elias did?", "words": [[0, 391826], [4, 391955], [9, 392115], [13, 392295], [23, 392995], [29, 393275], [33, 393515], [38, 393915], [42, 394175], [48, 394615], [53, 394735], [59, 395416], [65, 395701], [70, 395961], [74, 396061], [79, 396241], [82, 396361], [90, 396621], [95, 397021], [98, 397241], [103, 397481], [108, 397701], [113, 397921], [121, 398221], [125, 398681], [133, 399141], [139, 399421], [144, 399841], [147, 400111], [153, 400381]]}, {"verse": 55, "start": 401015, "end": 405978, "text": "But he turned, and rebuked them, and said, You know not what manner of spirit you are of.", "words": [[0, 401015], [4, 401159], [7, 401299], [15, 401639], [19, 401859], [27, 402359], [33, 402539], [37, 402779], [43, 403396], [47, 403580], [52, 403840], [56, 404100], [61, 404320], [68, 404620], [71, 404800], [78, 405120], [82, 405380], [86, 405580]]}, {"verse": 56, "start": 406328, "end": 412210, "text": "For the Son of man is not come to destroy men’s lives, but to save them. And they went to another village.", "words": [[0, 406328], [4, 406406], [8, 406546], [12, 406786], [15, 406886], [19, 407186], [22, 407366], [26, 407546], [31, 407806], [34, 407966], [42, 408306], [48, 408806], [55, 409306], [59, 409566], [62, 409706], [67, 410006], [73, 410656], [77, 410799], [82, 410899], [87, 411059], [90, 411239], [98, 411519]]}, {"verse": 57, "start": 412560, "end": 419742, "text": "¶ And it came to pass, that, as they went in the way, a certain man said to him, Lord, I will follow you wherever you go.", "words": [[2, 412560], [6, 412684], [9, 412804], [14, 413004], [17, 413204], [23, 413564], [29, 414244], [32, 414484], [37, 414624], [42, 414824], [45, 415004], [49, 415104], [54, 415704], [56, 415844], [64, 416064], [68, 416404], [73, 416704], [76, 416924], [81, 417457], [87, 417698], [89, 418038], [94, 418298], [101, 418598], [105, 418798], [114, 419098], [118, 419358]]}, {"verse": 58, "start": 420022, "end": 427241, "text": "And Jesus said to him, Foxes have holes, and birds of the air have nests; but the Son of man has not where to lay his head.", "words": [[0, 420022], [4, 420173], [10, 420473], [15, 420873], [18, 421073], [23, 421575], [29, 422028], [34, 422188], [41, 422528], [45, 422828], [51, 423128], [54, 423308], [58, 423468], [62, 423668], [67, 423868], [74, 424792], [78, 424891], [82, 425011], [86, 425251], [89, 425351], [93, 425631], [97, 425851], [101, 426051], [107, 426271], [110, 426431], [114, 426631], [118, 426811]]}, {"verse": 59, "start": 427521, "end": 433236, "text": "And he said to another, Follow me. But he said, Lord, let me first go and bury my father.", "words": [[0, 427521], [4, 427658], [7, 427778], [12, 427978], [15, 428178], [24, 428935], [31, 429186], [35, 429777], [39, 429921], [42, 430041], [48, 430690], [54, 431162], [58, 431262], [61, 431462], [67, 431782], [70, 432062], [74, 432282], [79, 432582], [82, 432802]]}, {"verse": 60, "start": 433516, "end": 439791, "text": "Jesus said to him, Let the dead bury their dead: but go and preach the kingdom of God.", "words": [[0, 433516], [6, 433856], [11, 434176], [14, 434376], [19, 435491], [23, 435698], [27, 435898], [32, 436178], [37, 436558], [43, 436798], [49, 437499], [53, 437661], [56, 437941], [60, 438221], [67, 438501], [71, 438761], [79, 439081], [82, 439321]]}, {"verse": 61, "start": 440071, "end": 446614, "text": "And another also said, Lord, I will follow you; but let me first go bid them farewell, which are at home at my house.", "words": [[0, 440071], [4, 440196], [12, 440456], [17, 440916], [23, 441691], [29, 441972], [31, 442232], [36, 442432], [43, 442712], [48, 443265], [52, 443369], [56, 443509], [59, 443649], [65, 443829], [68, 444069], [72, 444269], [77, 444469], [87, 445109], [93, 445249], [97, 445369], [100, 445489], [105, 445689], [108, 445849], [111, 446009]]}, {"verse": 62, "start": 446894, "end": 453913, "text": "And Jesus said to him, No man, having put his hand to the plough, and looking back, is fit for the kingdom of God.", "words": [[0, 446894], [4, 447045], [10, 447345], [15, 447745], [18, 447945], [23, 448447], [26, 448672], [31, 449052], [38, 449372], [42, 449632], [46, 449792], [51, 450072], [54, 450212], [58, 450612], [66, 451012], [70, 451272], [78, 451512], [84, 451912], [87, 452272], [91, 452532], [95, 452732], [99, 452852], [107, 453112], [110, 453352]]}]}