{"book": "GEN", "chapter": 40, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 170595, "verses": [{"verse": 1, "start": 300, "end": 8151, "text": "And it came to pass after these things, that the butler of the king of Egypt and his baker had offended their lord the king of Egypt.", "words": [[0, 300], [4, 436], [7, 536], [12, 776], [15, 996], [20, 1596], [26, 1896], [32, 2156], [40, 2836], [45, 3096], [49, 3236], [56, 3636], [59, 3796], [63, 3896], [68, 4136], [71, 4276], [77, 4696], [81, 5116], [85, 5256], [91, 5596], [95, 5876], [104, 6276], [110, 6596], [115, 6956], [119, 7236], [124, 7476], [127, 7616]]}, {"verse": 2, "start": 8501, "end": 15056, "text": "And Pharaoh was angry against two of his officers, against the chief of the butlers, and against the chief of the bakers.", "words": [[0, 8501], [4, 8652], [12, 9032], [16, 9312], [22, 9712], [30, 10112], [34, 10412], [37, 10532], [41, 10632], [51, 11612], [59, 11952], [63, 12232], [69, 12392], [72, 12572], [76, 12672], [85, 13092], [89, 13532], [97, 13792], [101, 13972], [107, 14192], [110, 14372], [114, 14432]]}, {"verse": 3, "start": 15406, "end": 21496, "text": "And he put them in ward in the house of the captain of the guard, into the prison, the place where Joseph was bound.", "words": [[0, 15406], [4, 15538], [7, 15618], [11, 15778], [16, 15998], [19, 16098], [24, 16418], [27, 16638], [31, 16718], [37, 16938], [40, 17098], [44, 17238], [52, 17518], [55, 17718], [59, 17818], [66, 18178], [71, 18758], [75, 18918], [83, 19698], [87, 19818], [93, 20058], [99, 20278], [106, 20598], [110, 20898]]}, {"verse": 4, "start": 21846, "end": 28504, "text": "And the captain of the guard charged Joseph with them, and he served them: and they continued a season in ward.", "words": [[0, 21846], [4, 21998], [8, 22098], [16, 22458], [19, 22638], [23, 22758], [29, 23098], [37, 23598], [44, 24058], [49, 24398], [55, 25098], [59, 25198], [62, 25378], [69, 25758], [75, 26386], [79, 26510], [84, 26783], [94, 27057], [96, 27330], [103, 27610], [106, 27890]]}, {"verse": 5, "start": 28854, "end": 40230, "text": "¶ And they dreamed a dream both of them, each man his dream in one night, each man according to the interpretation of his dream, the butler and the baker of the king of Egypt, which were bound in the prison.", "words": [[2, 28854], [6, 28999], [11, 29119], [19, 29359], [21, 29599], [27, 29859], [32, 30119], [35, 30339], [41, 30879], [46, 31079], [50, 31359], [54, 31579], [60, 31879], [63, 32039], [67, 32259], [74, 32979], [79, 33199], [83, 33459], [93, 33799], [96, 34159], [100, 34319], [115, 34939], [118, 35199], [122, 35319], [129, 36017], [133, 36112], [140, 36552], [144, 36752], [148, 36872], [154, 37192], [157, 37492], [161, 37612], [166, 37852], [169, 37992], [176, 38732], [182, 38952], [187, 39132], [193, 39452], [196, 39652], [200, 39712]]}, {"verse": 6, "start": 40580, "end": 45507, "text": "And Joseph came in to them in the morning, and looked upon them, and, behold, they were sad.", "words": [[0, 40580], [4, 40727], [11, 41107], [16, 41327], [19, 41547], [22, 41767], [27, 41967], [30, 42087], [34, 42167], [43, 42487], [47, 42927], [54, 43127], [59, 43367], [65, 43887], [70, 44007], [78, 44707], [83, 44807], [88, 44947]]}, {"verse": 7, "start": 45857, "end": 52646, "text": "And he asked Pharaoh’s officers that were with him in the ward of his lord’s house, saying, Why do you look so sadly today?", "words": [[0, 45857], [4, 45985], [7, 46105], [13, 46405], [23, 46925], [32, 47345], [37, 47625], [42, 47765], [47, 48045], [51, 48165], [54, 48305], [58, 48385], [63, 48645], [66, 48785], [70, 48905], [77, 49345], [84, 49965], [92, 50786], [96, 50974], [99, 51154], [103, 51254], [108, 51454], [111, 51634], [117, 52014]]}, {"verse": 8, "start": 52926, "end": 63608, "text": "And they said to him, We have dreamed a dream, and there is no interpreter of it. And Joseph said to them, Do not interpretations belong to God? tell me them, please.", "words": [[0, 52926], [4, 53075], [9, 53195], [14, 53435], [17, 53635], [22, 54235], [25, 54495], [30, 54675], [38, 55115], [40, 55315], [47, 55835], [51, 55955], [57, 56135], [60, 56335], [63, 56535], [75, 57015], [78, 57355], [82, 57856], [86, 58022], [93, 58342], [98, 58702], [101, 58882], [107, 59282], [110, 59542], [114, 59802], [130, 60682], [137, 61202], [140, 61542], [145, 62269], [150, 62625], [153, 62785], [159, 62965]]}, {"verse": 9, "start": 63958, "end": 70372, "text": "And the chief butler told his dream to Joseph, and said to him, In my dream, behold, a vine was before me;", "words": [[0, 63958], [4, 64110], [8, 64190], [14, 64390], [21, 64810], [26, 65050], [30, 65290], [36, 65610], [39, 65770], [47, 66150], [51, 66590], [56, 66830], [59, 66990], [64, 67519], [67, 67641], [70, 67801], [77, 68281], [85, 69021], [87, 69141], [92, 69461], [96, 69641], [103, 69961]]}, {"verse": 10, "start": 70722, "end": 77931, "text": "And in the vine were three branches: and it was as though it budded, and her blossoms shot forth; and the clusters of it brought forth ripe grapes:", "words": [[0, 70722], [4, 70838], [7, 70938], [11, 71058], [16, 71298], [21, 71478], [27, 71758], [37, 72728], [41, 72849], [44, 72909], [48, 73049], [51, 73209], [58, 73409], [61, 73529], [69, 73909], [73, 74149], [77, 74269], [86, 74629], [91, 74949], [98, 75580], [102, 75700], [106, 75800], [115, 76160], [118, 76440], [121, 76540], [129, 76720], [135, 77020], [140, 77340]]}, {"verse": 11, "start": 78281, "end": 85164, "text": "And Pharaoh’s cup was in my hand: and I took the grapes, and pressed them into Pharaoh’s cup, and I gave the cup into Pharaoh’s hand.", "words": [[0, 78281], [4, 78537], [14, 78837], [18, 79017], [22, 79257], [25, 79377], [28, 79517], [34, 80183], [38, 80314], [40, 80414], [45, 80554], [49, 80754], [57, 81014], [61, 81534], [69, 81814], [74, 81994], [79, 82154], [89, 82614], [94, 82814], [98, 83274], [100, 83394], [105, 83574], [109, 83734], [113, 83974], [118, 84234], [128, 84734]]}, {"verse": 12, "start": 85444, "end": 90855, "text": "And Joseph said to him, This is the interpretation of it: The three branches are three days:", "words": [[0, 85444], [4, 85613], [11, 85933], [16, 86293], [19, 86473], [24, 87025], [29, 87259], [32, 87479], [36, 87619], [51, 88219], [54, 88599], [58, 89102], [62, 89222], [68, 89442], [77, 89802], [81, 90102], [87, 90322]]}, {"verse": 13, "start": 91205, "end": 101336, "text": "Yet within three days shall Pharaoh lift up your head, and restore you to your place: and you shall deliver Pharaoh’s cup into his hand, after the former manner when you were his butler.", "words": [[0, 91205], [4, 91353], [11, 91613], [17, 91953], [22, 92613], [28, 92773], [36, 93093], [41, 93373], [44, 93573], [49, 93713], [55, 94033], [59, 94373], [67, 94733], [71, 94933], [74, 95093], [79, 95253], [86, 96057], [90, 96337], [94, 96677], [100, 96837], [108, 97217], [118, 97757], [122, 97937], [127, 98237], [131, 98437], [137, 98757], [143, 99237], [147, 99417], [154, 99767], [161, 100117], [166, 100377], [170, 100517], [175, 100637], [179, 100777]]}, {"verse": 14, "start": 101686, "end": 108611, "text": "But think on me when it shall be well with you, and show kindness, please, to me, and make mention of me to Pharaoh, and bring me out of this house:", "words": [[0, 101686], [4, 101859], [10, 102079], [13, 102239], [16, 102399], [21, 102559], [24, 102679], [30, 102859], [33, 103019], [38, 103239], [43, 103459], [48, 103819], [52, 103879], [57, 104059], [67, 104619], [75, 104959], [78, 105059], [82, 105519], [86, 105639], [91, 105799], [99, 106159], [102, 106299], [105, 106569], [108, 106839], [117, 107276], [121, 107400], [127, 107600], [130, 107760], [134, 107880], [137, 107960], [142, 108160]]}, {"verse": 15, "start": 108961, "end": 115699, "text": "For indeed I was stolen away out of the land of the Hebrews: and here also have I done nothing that they should put me into the dungeon.", "words": [[0, 109004], [4, 109064], [11, 109684], [13, 109824], [17, 110024], [24, 110304], [29, 110644], [33, 110984], [36, 111124], [40, 111224], [45, 111424], [48, 111564], [52, 111664], [61, 112455], [65, 112598], [70, 112838], [75, 113198], [80, 113438], [82, 113518], [87, 113718], [95, 114018], [100, 114238], [105, 114358], [112, 114478], [116, 114698], [119, 114878], [124, 115058], [128, 115198]]}, {"verse": 16, "start": 115979, "end": 124618, "text": "When the chief baker saw that the interpretation was good, he said to Joseph, I also was in my dream, and, behold, I had three white baskets on my head:", "words": [[0, 115979], [5, 116102], [9, 116222], [15, 116422], [21, 116742], [25, 117082], [30, 117302], [34, 117442], [49, 117962], [53, 118442], [59, 119062], [62, 119162], [67, 119382], [70, 119582], [78, 120262], [80, 120407], [85, 120747], [89, 120987], [92, 121107], [95, 121247], [102, 121527], [107, 122087], [115, 122447], [117, 122907], [121, 123067], [127, 123307], [133, 123547], [141, 123847], [144, 124147], [147, 124307]]}, {"verse": 17, "start": 124968, "end": 131595, "text": "And in the uppermost basket there was of all manner of baked goods for Pharaoh; and the birds did eat them out of the basket upon my head.", "words": [[0, 124968], [4, 125092], [7, 125192], [11, 125312], [21, 125832], [28, 126392], [34, 126492], [38, 126672], [41, 126832], [45, 127072], [52, 127372], [55, 127572], [61, 127792], [67, 128012], [71, 128352], [80, 128858], [84, 128976], [88, 129076], [94, 129316], [98, 129556], [102, 129676], [107, 129896], [111, 130116], [114, 130216], [118, 130336], [125, 130696], [130, 130956], [133, 131216]]}, {"verse": 18, "start": 131875, "end": 137512, "text": "And Joseph answered and said, This is the interpretation of it: The three baskets are three days:", "words": [[0, 131875], [4, 132018], [11, 132358], [20, 132838], [24, 133138], [30, 133722], [35, 133955], [38, 134075], [42, 134215], [57, 134815], [60, 135155], [64, 135607], [68, 135725], [74, 135965], [82, 136365], [86, 136725], [92, 137005]]}, {"verse": 19, "start": 137862, "end": 144948, "text": "Yet within three days shall Pharaoh lift up your head from off you, and shall hang you on a tree; and the birds shall eat your flesh from off you.", "words": [[0, 137862], [4, 138006], [11, 138266], [17, 138606], [22, 139146], [28, 139386], [36, 139746], [41, 139986], [44, 140186], [49, 140306], [54, 140506], [59, 140666], [63, 140906], [68, 141406], [72, 141466], [78, 141646], [83, 141846], [87, 142066], [90, 142286], [92, 142366], [98, 142933], [102, 143039], [106, 143159], [112, 143279], [118, 143499], [122, 143719], [127, 143879], [133, 144119], [138, 144359], [142, 144599]]}, {"verse": 20, "start": 145228, "end": 155971, "text": "¶ And it came to pass the third day, which was Pharaoh’s birthday, that he made a feast to all his servants: and he lifted up the head of the chief butler and of the chief baker among his servants.", "words": [[2, 145228], [6, 145363], [9, 145463], [14, 145703], [17, 145903], [22, 146163], [26, 146403], [32, 146723], [37, 147243], [43, 147363], [47, 147583], [57, 148143], [67, 149063], [72, 149223], [75, 149343], [80, 149543], [82, 149663], [88, 149943], [91, 150303], [95, 150523], [99, 150723], [109, 151683], [113, 151802], [116, 151902], [123, 152162], [126, 152402], [130, 152522], [135, 152662], [138, 152762], [142, 152882], [148, 153102], [155, 153622], [159, 153882], [162, 153982], [166, 154102], [172, 154362], [178, 154762], [184, 155082], [188, 155302]]}, {"verse": 21, "start": 156321, "end": 162033, "text": "And he restored the chief butler to his butlership again; and he gave the cup into Pharaoh’s hand:", "words": [[0, 156321], [4, 156465], [7, 156605], [16, 157085], [20, 157305], [26, 157545], [33, 158025], [36, 158185], [40, 158365], [51, 158925], [58, 159696], [62, 159832], [65, 159992], [70, 160212], [74, 160432], [78, 160712], [83, 161122], [93, 161532]]}, {"verse": 22, "start": 162383, "end": 166144, "text": "But he hanged the chief baker: as Joseph had interpreted to them.", "words": [[0, 162383], [4, 162494], [7, 162594], [14, 162974], [18, 163034], [24, 163274], [31, 164186], [34, 164352], [41, 164732], [45, 164992], [57, 165432], [60, 165772]]}, {"verse": 23, "start": 166494, "end": 170195, "text": "Yet did not the chief butler remember Joseph, but forgot him.", "words": [[0, 166494], [4, 166642], [8, 166882], [12, 167102], [16, 167302], [22, 167522], [29, 168042], [38, 168382], [46, 169322], [50, 169422], [57, 169702]]}]}