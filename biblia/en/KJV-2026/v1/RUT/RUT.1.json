{"book": "RUT", "chapter": 1, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 215990, "verses": [{"verse": 1, "start": 300, "end": 12765, "text": "Now it came to pass in the days when the judges ruled, that there was a famine in the land. And a certain man of Beth-lehem-judah went to sojourn in the country of Moab, he, and his wife, and his two sons.", "words": [[0, 300], [4, 522], [7, 662], [12, 882], [15, 1082], [20, 1382], [23, 1602], [27, 1722], [32, 2042], [37, 2282], [41, 2402], [48, 2722], [55, 3182], [60, 3782], [66, 3922], [70, 4102], [72, 4222], [79, 4582], [82, 4802], [86, 4902], [92, 5653], [96, 5796], [98, 5956], [106, 6196], [110, 6596], [113, 7186], [130, 7776], [135, 8116], [138, 8356], [146, 8896], [149, 8976], [153, 9056], [161, 9376], [164, 9616], [170, 10276], [174, 10476], [178, 10816], [182, 10976], [188, 11256], [192, 11816], [196, 11956], [200, 12156]]}, {"verse": 2, "start": 13215, "end": 27040, "text": "And the name of the man was Elimelech, and the name of his wife Naomi, and the name of his two sons Mahlon and Chilion, Ephrathites of Beth-lehem-judah. And they came into the country of Moab, and continued there.", "words": [[0, 13215], [4, 13369], [8, 13469], [13, 13689], [16, 13869], [20, 13969], [24, 14309], [28, 14609], [39, 15569], [43, 15889], [47, 15989], [52, 16189], [55, 16329], [59, 16449], [64, 16689], [71, 17729], [75, 17949], [79, 18069], [84, 18229], [87, 18409], [91, 18529], [95, 18729], [100, 19309], [107, 19889], [111, 20536], [120, 21182], [132, 21829], [135, 22556], [153, 23529], [157, 23677], [162, 23777], [167, 23997], [172, 24217], [176, 24357], [184, 24697], [187, 24877], [193, 25397], [197, 25957], [207, 26457]]}, {"verse": 3, "start": 27490, "end": 32521, "text": "And Elimelech Naomi’s husband died; and she was left, and her two sons.", "words": [[0, 27490], [4, 27865], [14, 28275], [22, 28895], [30, 29155], [36, 30170], [40, 30293], [44, 30453], [48, 30633], [54, 31033], [58, 31453], [62, 31613], [66, 31773]]}, {"verse": 4, "start": 32971, "end": 42623, "text": "And they took them wives of the women of Moab; the name of the one was Orpah, and the name of the other Ruth: and they dwelled there about ten years.", "words": [[0, 32971], [4, 33395], [9, 33535], [14, 33735], [19, 33955], [25, 34315], [28, 34595], [32, 34715], [38, 34975], [41, 35195], [47, 36219], [51, 36308], [56, 36628], [59, 36788], [63, 36908], [67, 37168], [71, 37858], [78, 38548], [82, 38908], [86, 39048], [91, 39248], [94, 39388], [98, 39528], [104, 39748], [110, 40654], [114, 40762], [119, 40862], [127, 41282], [133, 41462], [139, 41722], [143, 42022]]}, {"verse": 5, "start": 43073, "end": 49397, "text": "And Mahlon and Chilion died also both of them; and the woman was left of her two sons and her husband.", "words": [[0, 43073], [4, 43414], [11, 43784], [15, 44114], [23, 44444], [28, 44644], [33, 45184], [38, 45324], [41, 45544], [47, 46178], [51, 46312], [55, 46432], [61, 46692], [65, 46992], [70, 47292], [73, 47552], [77, 47692], [81, 47952], [86, 48372], [90, 48632], [94, 48772]]}, {"verse": 6, "start": 49847, "end": 61163, "text": "¶ Then she arose with her daughters in law, that she might return from the country of Moab: for she had heard in the country of Moab how that the LORD had visited his people in giving them bread.", "words": [[2, 49847], [7, 50072], [11, 50272], [17, 50632], [22, 50972], [26, 51112], [36, 51472], [39, 51732], [44, 51992], [49, 52532], [53, 52732], [59, 52932], [66, 53372], [71, 53592], [75, 53752], [83, 54112], [86, 54332], [92, 55310], [96, 55424], [100, 55624], [104, 55824], [110, 56084], [113, 56264], [117, 56364], [125, 56684], [128, 56884], [133, 57444], [137, 58004], [142, 58224], [146, 58364], [151, 58604], [155, 58804], [163, 59184], [167, 59484], [174, 59884], [177, 60124], [184, 60344], [189, 60624]]}, {"verse": 7, "start": 61613, "end": 69941, "text": "Therefore she went forth out of the place where she was, and her two daughters in law with her; and they went on the way to return to the land of Judah.", "words": [[0, 61613], [10, 61909], [14, 62229], [19, 62449], [25, 62789], [29, 63069], [32, 63209], [36, 63329], [42, 63589], [48, 63849], [52, 64069], [57, 64809], [61, 65089], [65, 65229], [69, 65429], [79, 65789], [82, 66069], [86, 66309], [91, 66549], [96, 67112], [100, 67272], [105, 67372], [110, 67572], [113, 67752], [117, 67892], [121, 68072], [124, 68232], [131, 68692], [134, 68872], [138, 69012], [143, 69272], [146, 69412]]}, {"verse": 8, "start": 70391, "end": 81008, "text": "And Naomi said to her two daughters in law, Go, return each to her mother’s house: the LORD deal kindly with you, as you have dealt with the dead, and with me.", "words": [[0, 70391], [4, 70548], [10, 70868], [15, 71288], [18, 71488], [22, 71628], [26, 71848], [36, 72228], [39, 72468], [44, 74057], [48, 74257], [55, 74697], [60, 75037], [63, 75297], [67, 75437], [76, 75897], [83, 76718], [87, 76804], [92, 77044], [97, 77284], [104, 77684], [109, 78024], [114, 78704], [117, 78904], [121, 79044], [126, 79164], [132, 79344], [137, 79524], [141, 79664], [147, 79924], [151, 80404], [156, 80584]]}, {"verse": 9, "start": 81458, "end": 90775, "text": "The LORD grant you that you may find rest, each of you in the house of her husband. Then she kissed them; and they lifted up their voice, and wept.", "words": [[0, 81458], [4, 81598], [9, 81918], [15, 82278], [19, 82578], [24, 82818], [28, 83018], [32, 83238], [37, 83598], [43, 84498], [48, 84738], [51, 84898], [55, 85058], [58, 85258], [62, 85378], [68, 85598], [71, 85778], [75, 85898], [84, 86873], [89, 87136], [93, 87416], [100, 87796], [106, 88418], [110, 88537], [115, 88677], [122, 89017], [125, 89237], [131, 89417], [138, 89817], [142, 90197]]}, {"verse": 10, "start": 91225, "end": 95796, "text": "And they said to her, Surely we will return with you to your people.", "words": [[0, 91225], [4, 91348], [9, 91488], [14, 91708], [17, 91948], [22, 92502], [29, 92802], [32, 93082], [37, 93242], [44, 93602], [49, 93842], [53, 94062], [56, 94282], [61, 94502]]}, {"verse": 11, "start": 96146, "end": 104977, "text": "And Naomi said, Turn again, my daughters: why will you go with me? are there yet any more sons in my womb, that they may be your husbands?", "words": [[0, 96146], [4, 96326], [10, 96726], [16, 97607], [21, 97787], [28, 98107], [31, 98447], [42, 99452], [46, 99698], [51, 99878], [55, 100018], [58, 100198], [63, 100458], [67, 101147], [71, 101257], [77, 101417], [81, 101637], [85, 101837], [90, 102217], [95, 102597], [98, 102697], [101, 102857], [107, 103217], [112, 103497], [117, 103677], [121, 103837], [124, 104017], [129, 104157]]}, {"verse": 12, "start": 105427, "end": 116547, "text": "Turn again, my daughters, go your way; for I am too old to have a husband. If I should say, I have hope, if I should have a husband also tonight, and should also bear sons;", "words": [[0, 105427], [5, 105591], [12, 105851], [15, 106091], [26, 106651], [29, 106771], [34, 106991], [39, 107758], [43, 107846], [45, 108106], [48, 108226], [52, 108446], [56, 108846], [59, 109046], [64, 109226], [66, 109326], [75, 110279], [78, 110422], [80, 110602], [87, 110802], [92, 111262], [94, 111442], [99, 111642], [105, 112342], [108, 112522], [110, 112782], [117, 112962], [122, 113142], [124, 113242], [132, 113502], [137, 113922], [146, 114582], [150, 114942], [157, 115122], [162, 115502], [167, 115822]]}, {"verse": 13, "start": 116997, "end": 127640, "text": "Would you wait for them till they were grown? would you stay for them from having husbands? no, my daughters; for it grieves me much for your sakes that the hand of the LORD is gone out against me.", "words": [[0, 116997], [6, 117102], [10, 117242], [15, 117442], [19, 117642], [24, 117802], [29, 118002], [34, 118182], [39, 118302], [46, 119226], [52, 119334], [56, 119474], [61, 119694], [65, 119914], [70, 120054], [75, 120234], [82, 120454], [92, 121692], [96, 121822], [99, 122062], [110, 123049], [114, 123185], [117, 123325], [125, 123725], [128, 123885], [133, 124145], [137, 124365], [142, 124505], [148, 124965], [153, 125165], [157, 125285], [162, 125565], [165, 125685], [169, 125825], [174, 126125], [177, 126345], [182, 126565], [186, 126825], [194, 127125]]}, {"verse": 14, "start": 127990, "end": 134850, "text": "And they lifted up their voice, and wept again: and Orpah kissed her mother in law; but Ruth clung to her.", "words": [[0, 127990], [4, 128124], [9, 128264], [16, 128604], [19, 128824], [25, 129004], [32, 129364], [36, 129844], [41, 130204], [48, 131043], [52, 131358], [58, 131708], [65, 132068], [69, 132268], [76, 132508], [79, 132708], [84, 133466], [88, 133594], [93, 133874], [99, 134314], [102, 134494]]}, {"verse": 15, "start": 135300, "end": 143484, "text": "And she said, Behold, your sister in law is gone back to her people, and to her gods: return after your sister in law.", "words": [[0, 135300], [4, 135443], [8, 135603], [14, 136689], [22, 136859], [27, 137059], [34, 137439], [37, 137659], [41, 137879], [44, 138079], [49, 138359], [54, 138659], [57, 138839], [61, 138939], [69, 139279], [73, 139759], [76, 139999], [80, 140159], [86, 141124], [93, 141391], [99, 141771], [104, 141971], [111, 142311], [114, 142511]]}, {"verse": 16, "start": 143834, "end": 158017, "text": "And Ruth said, Entreat me not to leave you, or to return from following after you: for where you go, I will go; and where you lodge, I will lodge: your people shall be my people, and your God my God:", "words": [[0, 143834], [4, 143977], [9, 144197], [15, 145095], [23, 145285], [26, 145525], [30, 145805], [33, 146025], [39, 146285], [44, 146885], [47, 147085], [50, 147245], [57, 147625], [62, 147865], [72, 148285], [78, 148725], [83, 149515], [87, 149620], [93, 149800], [97, 150000], [101, 150680], [103, 150840], [108, 151000], [112, 151787], [116, 151907], [122, 152087], [126, 152267], [133, 153007], [135, 153167], [140, 153307], [147, 154180], [152, 154345], [159, 154745], [165, 155105], [168, 155385], [171, 155645], [179, 156265], [183, 156565], [188, 156745], [192, 157085], [195, 157445]]}, {"verse": 17, "start": 158467, "end": 167177, "text": "Where you die, will I die, and there will I be buried: the LORD do so to me, and more also, if anything but death part you and me.", "words": [[0, 158467], [6, 158613], [10, 158913], [15, 159393], [20, 159513], [22, 159833], [27, 160413], [31, 160513], [37, 160693], [42, 160873], [44, 161173], [47, 161353], [55, 162288], [59, 162396], [64, 162636], [67, 162956], [70, 163176], [73, 163356], [77, 164036], [81, 164156], [86, 164376], [92, 164776], [95, 165116], [104, 165496], [108, 165756], [114, 166096], [119, 166396], [123, 166696], [127, 166836]]}, {"verse": 18, "start": 167527, "end": 172333, "text": "When she saw that she was steadfastly minded to go with her, then she left speaking to her.", "words": [[0, 167527], [5, 167654], [9, 167814], [13, 168074], [18, 168254], [22, 168414], [26, 168614], [38, 169294], [45, 169614], [48, 169834], [51, 169954], [56, 170194], [61, 170794], [66, 170994], [70, 171174], [75, 171394], [84, 171774], [87, 172074]]}, {"verse": 19, "start": 172783, "end": 184459, "text": "¶ So they two went until they came to Beth-lehem. And it came to pass, when they were come to Beth-lehem, that all the city was moved about them, and they said, Is this Naomi?", "words": [[2, 172783], [5, 172929], [10, 173089], [14, 173249], [19, 173469], [25, 173749], [30, 173929], [35, 174149], [38, 174309], [50, 175360], [54, 175496], [57, 175596], [62, 175836], [65, 176056], [71, 176576], [76, 176756], [81, 176936], [86, 177076], [91, 177316], [94, 177496], [106, 178696], [111, 178836], [115, 179056], [119, 179216], [124, 179476], [128, 179716], [134, 179976], [140, 180276], [146, 180676], [150, 180796], [155, 180936], [161, 181630], [164, 181854], [169, 182114]]}, {"verse": 20, "start": 184809, "end": 191631, "text": "And she said to them, Call me not Naomi, call me Mara: for the Almighty has dealt very bitterly with me.", "words": [[0, 184809], [4, 184926], [8, 185086], [13, 185326], [16, 185506], [22, 186162], [27, 186367], [30, 186587], [34, 186827], [41, 187747], [46, 188007], [49, 188167], [55, 189067], [59, 189160], [63, 189280], [72, 189720], [76, 190000], [82, 190220], [87, 190580], [96, 191100], [101, 191300]]}, {"verse": 21, "start": 192081, "end": 204163, "text": "I went out full, and the LORD has brought me home again empty: why then do you call me Naomi, seeing the LORD has testified against me, and the Almighty has afflicted me?", "words": [[0, 192081], [2, 192227], [7, 192427], [11, 192627], [17, 192947], [21, 193467], [25, 193607], [30, 193847], [34, 194027], [42, 194247], [45, 194427], [50, 194687], [56, 194947], [63, 197260], [67, 197493], [72, 197733], [75, 197953], [79, 198073], [84, 198353], [87, 198513], [94, 199393], [101, 199633], [105, 199853], [110, 200113], [114, 200313], [124, 200773], [132, 201253], [136, 201993], [140, 202213], [144, 202353], [153, 202813], [157, 203253], [167, 203793]]}, {"verse": 22, "start": 204513, "end": 215590, "text": "So Naomi returned, and Ruth the Moabitess, her daughter in law, with her, which returned out of the country of Moab: and they came to Beth-lehem in the beginning of barley harvest.", "words": [[0, 204513], [3, 205153], [9, 205533], [19, 206253], [23, 206473], [28, 206753], [32, 207313], [43, 207873], [47, 208013], [56, 208313], [59, 208533], [64, 208793], [69, 209033], [74, 209733], [80, 209913], [89, 210313], [93, 210533], [96, 210673], [100, 210773], [108, 211113], [111, 211293], [117, 212261], [121, 212610], [126, 212730], [131, 212970], [134, 213340], [145, 213710], [148, 213990], [152, 214090], [162, 214350], [165, 214550], [172, 214870]]}]}