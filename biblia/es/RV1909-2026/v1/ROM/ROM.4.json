{"book": "ROM", "chapter": 4, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 183772, "verses": [{"verse": 1, "start": 300, "end": 4282, "text": "¿Qué, pues, diremos que halló Abraham nuestro padre según la carne?", "words": [[0, 300], [6, 400], [12, 1040], [20, 1500], [24, 1767], [30, 2033], [38, 2300], [46, 2620], [52, 3280], [58, 3540], [61, 3760]]}, {"verse": 2, "start": 4732, "end": 10180, "text": "Que si Abraham fue justificado por las obras, tiene de qué gloriarse; pero no para con Dios.", "words": [[0, 4732], [4, 4830], [7, 5100], [15, 5370], [19, 5530], [31, 6290], [35, 6450], [39, 6650], [46, 6970], [52, 7470], [55, 7690], [59, 7830], [70, 8927], [75, 9071], [78, 9211], [83, 9451], [87, 9651]]}, {"verse": 3, "start": 10630, "end": 15999, "text": "Porque ¿qué dice la Escritura? Y creyó Abraham a Dios, y le fue atribuído a justicia.", "words": [[0, 10732], [7, 10872], [12, 11052], [17, 11252], [20, 11432], [31, 12370], [33, 12489], [39, 12762], [47, 13036], [49, 13308], [55, 13568], [57, 14208], [60, 14329], [64, 14489], [74, 15109], [76, 15228]]}, {"verse": 4, "start": 16449, "end": 21603, "text": "Pero al que obra, no se le cuenta el salario por gracia, sino por deuda.", "words": [[0, 16449], [5, 16613], [8, 16813], [12, 16973], [18, 17253], [21, 17733], [24, 17873], [27, 17993], [34, 18293], [37, 18453], [45, 18873], [49, 19093], [57, 19673], [62, 19913], [66, 20153]]}, {"verse": 5, "start": 22053, "end": 28052, "text": "Pero al que no obra, sino que cree en aquel que justifica al impío, la fe le es contada por justicia.", "words": [[0, 22053], [5, 22187], [8, 22347], [12, 22507], [15, 22667], [21, 23267], [26, 23427], [30, 23647], [35, 23887], [38, 24067], [44, 24367], [48, 24467], [58, 25087], [61, 25247], [68, 26007], [71, 26167], [74, 26327], [77, 26487], [80, 26627], [88, 27127], [92, 27367]]}, {"verse": 6, "start": 28502, "end": 34095, "text": "Como también David dice ser bienaventurado el hombre al cual Dios atribuye justicia sin obras,", "words": [[0, 28502], [5, 28662], [13, 29022], [19, 29402], [24, 29742], [28, 30082], [43, 30882], [46, 31042], [53, 31342], [56, 31562], [61, 31802], [66, 32122], [75, 32622], [84, 33122], [88, 33622]]}, {"verse": 7, "start": 34545, "end": 41012, "text": "Diciendo: Bienaventurados aquellos cuyas iniquidades son perdonadas, y cuyos pecados son cubiertos.", "words": [[0, 34545], [10, 35572], [26, 36389], [35, 36769], [41, 37309], [53, 37909], [57, 38149], [69, 38849], [71, 39229], [77, 39549], [85, 40049], [89, 40229]]}, {"verse": 8, "start": 41462, "end": 44546, "text": "Bienaventurado el varón al cual el Señor no imputó pecado.", "words": [[0, 41462], [15, 42244], [18, 42364], [24, 42664], [27, 42804], [32, 42984], [35, 43184], [41, 43484], [44, 43744], [51, 44144]]}, {"verse": 9, "start": 44996, "end": 53494, "text": "¿Es pues esta bienaventuranza solamente en la circuncisión, o también en la incircuncisión? porque decimos que a Abraham fue contada la fe por justicia.", "words": [[0, 44996], [4, 45182], [9, 45322], [14, 45622], [30, 46462], [40, 46722], [43, 47102], [46, 47182], [60, 48042], [62, 48422], [70, 48702], [73, 48902], [76, 48982], [92, 50232], [99, 50429], [107, 50969], [111, 51059], [113, 51149], [121, 51529], [125, 51849], [133, 52309], [136, 52469], [139, 52629], [143, 52809]]}, {"verse": 10, "start": 53944, "end": 61149, "text": "¿Cómo pues le fue contada? ¿en la circuncisión, o en la incircuncisión? No en la circuncisión, sino en la incircuncisión.", "words": [[0, 53944], [6, 54104], [11, 54364], [14, 54524], [18, 54664], [27, 55617], [31, 55775], [34, 55875], [48, 56735], [50, 56915], [53, 57015], [56, 57115], [72, 58384], [75, 58547], [78, 58687], [81, 58747], [95, 59687], [100, 59867], [103, 60087], [106, 60187]]}, {"verse": 11, "start": 61599, "end": 74774, "text": "Y recibió la circuncisión por señal, por sello de la justicia de la fe que tuvo en la incircuncisión: para que fuese padre de todos los creyentes no circuncidados, para que también a ellos les sea contado por justicia;", "words": [[0, 61599], [2, 61706], [10, 62186], [13, 62286], [26, 63026], [30, 63166], [37, 63846], [41, 63966], [47, 64326], [50, 64426], [53, 64526], [62, 65066], [65, 65186], [68, 65306], [71, 65566], [75, 66026], [80, 66146], [83, 66266], [86, 66446], [102, 67733], [107, 67873], [111, 68013], [117, 68353], [123, 68773], [126, 69053], [132, 69233], [136, 69473], [146, 70053], [149, 70333], [164, 71593], [169, 71953], [173, 72093], [181, 72453], [183, 72633], [189, 72893], [193, 73113], [197, 73313], [205, 73833], [209, 73973]]}, {"verse": 12, "start": 75224, "end": 87208, "text": "Y padre de la circuncisión, no solamente a los que son de la circuncisión, sino también a los que siguen las pisadas de la fe que fue en nuestro padre Abraham antes de ser circuncidado.", "words": [[0, 75224], [2, 75346], [8, 75646], [11, 75806], [14, 75906], [28, 77126], [31, 77306], [41, 77686], [43, 77946], [47, 78046], [51, 78166], [55, 78406], [58, 78526], [61, 78646], [75, 80490], [80, 80665], [88, 81025], [90, 81365], [94, 81525], [98, 81665], [105, 82045], [109, 82205], [117, 82685], [120, 82865], [123, 82985], [126, 83205], [130, 83365], [134, 83495], [137, 83625], [145, 83885], [151, 84415], [159, 84945], [165, 85765], [168, 85965], [172, 86205]]}, {"verse": 13, "start": 87658, "end": 95626, "text": "Porque no por la ley fue dada la promesa a Abraham o a su descendencia, que sería heredero del mundo, sino por la justicia de la fe.", "words": [[0, 87658], [7, 87863], [10, 88083], [14, 88263], [17, 88423], [21, 88663], [25, 88903], [30, 89243], [33, 89383], [41, 89963], [43, 90163], [51, 90503], [53, 90763], [55, 90863], [58, 90983], [72, 92143], [76, 92223], [82, 92543], [91, 93043], [95, 93203], [102, 93863], [107, 94123], [111, 94383], [114, 94483], [123, 95043], [126, 95163], [129, 95303]]}, {"verse": 14, "start": 96076, "end": 101531, "text": "Porque si los que son de la ley son los herederos, vana es la fe, y anulada es la promesa.", "words": [[0, 96076], [7, 96288], [10, 96488], [14, 96648], [18, 96828], [22, 97088], [25, 97228], [28, 97368], [32, 97548], [36, 97808], [40, 97988], [51, 98318], [56, 98648], [59, 98978], [62, 99308], [66, 99888], [68, 100068], [76, 100568], [79, 100728], [82, 100848]]}, {"verse": 15, "start": 101981, "end": 106638, "text": "Porque la ley produce ira; porque donde no hay ley, tampoco hay transgresión.", "words": [[0, 101981], [7, 102201], [10, 102361], [14, 102541], [22, 103001], [27, 103784], [34, 103971], [40, 104211], [43, 104511], [47, 104651], [52, 104951], [60, 105431], [64, 106056]]}, {"verse": 16, "start": 107088, "end": 119976, "text": "Por tanto es por la fe, para que sea por gracia; para que la promesa sea firme para toda su descendencia, no solamente al que es de la ley, sino también al que es de la fe de Abraham, el cual es padre de todos nosotros,", "words": [[0, 107088], [4, 107189], [10, 107509], [13, 107589], [17, 107729], [20, 107869], [24, 108049], [29, 108409], [33, 108549], [37, 108729], [41, 108929], [49, 109799], [54, 109949], [58, 110069], [61, 110189], [69, 110542], [73, 110896], [79, 111249], [84, 111489], [89, 111769], [92, 112029], [106, 113269], [109, 113389], [119, 113749], [122, 114109], [126, 114229], [129, 114369], [132, 114469], [135, 114589], [140, 115149], [145, 115389], [153, 115809], [156, 116049], [160, 116169], [163, 116349], [166, 116449], [169, 116569], [172, 116729], [175, 116869], [184, 117771], [187, 117936], [192, 118136], [195, 118336], [201, 118736], [204, 118856], [210, 119096]]}, {"verse": 17, "start": 120426, "end": 133178, "text": "(Como está escrito: Que por padre de muchas naciones te he puesto) delante de Dios, al cual creyó; el cual da vida a los muertos, y llama las cosas que no son, como las que son.", "words": [[0, 120426], [6, 120582], [11, 120822], [20, 121699], [24, 121783], [28, 122003], [34, 122443], [37, 122623], [44, 122863], [53, 123523], [56, 123763], [59, 123883], [65, 124951], [67, 124951], [75, 125395], [78, 125535], [84, 126295], [87, 126515], [92, 126735], [99, 127785], [102, 127928], [107, 128188], [110, 128428], [115, 128608], [117, 128808], [121, 128908], [130, 129428], [132, 129768], [138, 130008], [142, 130208], [148, 130468], [152, 130728], [155, 130888], [160, 131228], [165, 131528], [169, 131708], [173, 131868]]}, {"verse": 18, "start": 133628, "end": 142911, "text": "Él creyó en esperanza contra esperanza, para venir a ser padre de muchas naciones, conforme a lo que le había sido dicho: Así será tu descendencia.", "words": [[0, 133628], [3, 133770], [9, 134170], [12, 134250], [22, 134790], [29, 135050], [40, 135770], [45, 136210], [51, 136450], [53, 136590], [57, 136770], [63, 137090], [66, 137270], [73, 137510], [83, 138550], [92, 139090], [94, 139170], [97, 139250], [101, 139350], [104, 139470], [110, 139670], [115, 139950], [122, 140803], [126, 141104], [131, 141484], [134, 141664]]}, {"verse": 19, "start": 143211, "end": 151248, "text": "Y no se debilitó en la fe, ni consideró su cuerpo ya muerto (siendo ya de casi cien años), ni la matriz muerta de Sara;", "words": [[0, 143211], [2, 143313], [5, 143453], [8, 143633], [17, 144213], [20, 144313], [23, 144433], [27, 145073], [30, 145273], [40, 145893], [43, 146033], [50, 146413], [53, 146633], [60, 147453], [68, 147773], [71, 148073], [74, 148233], [79, 148393], [84, 148773], [91, 149473], [94, 149573], [97, 149693], [104, 150193], [111, 150633], [114, 150773]]}, {"verse": 20, "start": 151698, "end": 158539, "text": "Tampoco en la promesa de Dios dudó con desconfianza: antes fue fortalecido en la fe, dando gloria a Dios,", "words": [[0, 151698], [8, 152158], [11, 152418], [14, 152498], [22, 152938], [25, 153078], [30, 153318], [35, 153798], [39, 153958], [53, 155469], [59, 155713], [63, 155933], [75, 156573], [78, 156693], [81, 156793], [85, 157333], [91, 157593], [98, 158033], [100, 158113]]}, {"verse": 21, "start": 158989, "end": 163630, "text": "Plenamente convencido de que todo lo que había prometido, era también poderoso para hacerlo.", "words": [[0, 158989], [11, 159470], [22, 160030], [25, 160170], [29, 160250], [34, 160470], [37, 160650], [41, 160750], [47, 160930], [58, 161610], [62, 162050], [70, 162310], [79, 162870], [84, 163070]]}, {"verse": 22, "start": 164080, "end": 166352, "text": "Por lo cual también le fue atribuído a justicia.", "words": [[0, 164080], [4, 164179], [7, 164299], [12, 164459], [20, 164759], [23, 164979], [27, 165119], [37, 165639], [39, 165719]]}, {"verse": 23, "start": 166802, "end": 169893, "text": "Y no solamente por él fue escrito que le haya sido imputado;", "words": [[0, 166802], [2, 166905], [5, 167005], [15, 167365], [19, 167665], [22, 167785], [26, 167965], [34, 168305], [38, 168565], [41, 168705], [46, 168865], [51, 169185]]}, {"verse": 24, "start": 170343, "end": 178093, "text": "Sino también por nosotros, a quienes será imputado, esto es, a los que creemos en el que levantó de los muertos a Jesús Señor nuestro,", "words": [[0, 170343], [5, 170529], [13, 170889], [17, 171109], [27, 171529], [29, 171949], [37, 172129], [42, 172449], [52, 173469], [57, 173769], [61, 174049], [63, 174389], [67, 174509], [71, 174669], [79, 175109], [82, 175309], [85, 175409], [89, 175529], [97, 175989], [100, 176049], [104, 176169], [112, 176609], [114, 176789], [120, 177269], [126, 177469]]}, {"verse": 25, "start": 178543, "end": 183372, "text": "El cual fue entregado por nuestros delitos, y resucitado para nuestra justificación.", "words": [[0, 178543], [3, 178668], [8, 178848], [12, 179068], [22, 179568], [26, 179768], [35, 180048], [44, 180688], [46, 181008], [57, 181728], [62, 181968], [70, 182168]]}]}