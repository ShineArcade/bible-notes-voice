{"book": "MAT", "chapter": 6, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 308570, "verses": [{"verse": 1, "start": 300, "end": 12330, "text": "Mirad que no hagáis vuestra justicia delante de los hombres, para ser vistos de ellos: de otra manera no tendréis recompensa de vuestro Padre que está en los cielos.", "words": [[0, 300], [6, 784], [10, 1224], [13, 1444], [20, 1984], [28, 2484], [37, 3164], [45, 3604], [48, 3744], [52, 3884], [61, 4304], [66, 4884], [70, 5084], [77, 5524], [80, 5704], [87, 6559], [90, 6878], [95, 7078], [102, 7798], [105, 7878], [114, 8478], [125, 9658], [128, 9858], [136, 10258], [142, 10758], [146, 10918], [151, 11158], [154, 11358], [158, 11478]]}, {"verse": 2, "start": 12780, "end": 27759, "text": "Cuando pues haces limosna, no toques trompeta delante de ti, como hacen los hipócritas en las sinagogas y en las plazas, para ser elogiados por los hombres: de cierto os digo, que ya tienen su recompensa.", "words": [[0, 12780], [7, 13023], [12, 13383], [18, 13923], [27, 15143], [30, 15423], [37, 15863], [46, 16623], [54, 17063], [57, 17243], [61, 17863], [66, 18123], [72, 18483], [76, 18663], [87, 19643], [90, 19883], [94, 20043], [104, 20803], [106, 20943], [109, 21063], [113, 21163], [121, 21803], [126, 22203], [130, 22503], [140, 23243], [144, 23483], [148, 23643], [157, 24559], [160, 24765], [167, 25125], [170, 25485], [176, 25885], [180, 26385], [183, 26585], [190, 26945], [193, 27225]]}, {"verse": 3, "start": 28209, "end": 31603, "text": "Pero cuando tú haces limosna, no sepa tu izquierda lo que hace tu derecha;", "words": [[0, 28698], [5, 28838], [12, 29198], [15, 29458], [21, 29778], [30, 30358], [33, 30938], [38, 31298], [41, 31342], [51, 31385], [54, 31429], [58, 31472], [63, 31516], [66, 31559]]}, {"verse": 4, "start": 32053, "end": 40788, "text": "Para que sea tu limosna en secreto: y tu Padre que ve en secreto, él te recompensará en público.", "words": [[0, 33720], [5, 33900], [9, 34040], [13, 34220], [16, 34420], [24, 34880], [27, 34960], [36, 35923], [38, 36048], [41, 36148], [47, 36948], [51, 37101], [54, 37255], [57, 37408], [66, 38548], [69, 38981], [72, 39415], [85, 39848], [88, 39968]]}, {"verse": 5, "start": 41238, "end": 56399, "text": "Y cuando ores, no seas como los hipócritas; porque ellos aman el orar en las sinagogas, y en las esquinas de las calles en pie, para ser vistos de los hombres: de cierto os digo, que ya tienen su pago.", "words": [[0, 41238], [2, 41348], [9, 41608], [15, 42368], [18, 42608], [23, 43008], [28, 43308], [32, 43972], [44, 44887], [51, 45129], [57, 45429], [62, 45849], [65, 46169], [70, 46509], [73, 46669], [77, 46849], [88, 47749], [90, 48269], [93, 48429], [97, 48609], [106, 49289], [109, 49449], [113, 49589], [120, 50009], [123, 50189], [128, 50509], [133, 51089], [137, 51329], [144, 51909], [147, 52029], [151, 52169], [160, 53234], [163, 53377], [170, 53717], [173, 54197], [179, 54537], [183, 55037], [186, 55217], [193, 55497], [196, 55737]]}, {"verse": 6, "start": 56849, "end": 68757, "text": "Pero tú, cuando ores, entra en tu habitación, y cerrada tu puerta, ora a tu Padre que está en secreto; y tu Padre que ve en secreto, te recompensará en público.", "words": [[0, 56849], [5, 56994], [9, 57234], [16, 57474], [22, 58074], [28, 58594], [31, 58834], [34, 58974], [46, 59614], [48, 60154], [56, 60634], [59, 60854], [67, 61614], [71, 61994], [73, 62314], [76, 62434], [82, 62874], [86, 63294], [91, 63474], [94, 63654], [103, 64600], [105, 64725], [108, 64825], [114, 65345], [118, 65465], [121, 65665], [124, 65785], [133, 66885], [136, 67105], [149, 67965], [152, 68085]]}, {"verse": 7, "start": 69207, "end": 77448, "text": "Y orando, no uséis repeticiones sin sentido, como los Gentiles; que piensan que por su palabrería serán oídos.", "words": [[0, 69207], [2, 69367], [10, 69747], [13, 70087], [19, 70667], [32, 71667], [36, 71987], [45, 72527], [50, 72847], [54, 73007], [64, 74150], [68, 74459], [76, 75079], [80, 75239], [84, 75492], [87, 75746], [98, 75999], [104, 76819]]}, {"verse": 8, "start": 77898, "end": 87144, "text": "No os hagáis, pues, semejantes a ellos; porque vuestro Padre sabe de qué cosas tenéis necesidad, antes que vosotros le pidáis.", "words": [[0, 77898], [3, 78226], [6, 78586], [14, 79126], [20, 79466], [31, 80526], [33, 80726], [40, 81583], [47, 81788], [55, 82188], [61, 82488], [66, 82908], [69, 83128], [73, 83328], [79, 83708], [86, 84288], [97, 85128], [103, 85508], [107, 85728], [116, 86208], [119, 86408]]}, {"verse": 9, "start": 87594, "end": 94189, "text": "Vosotros pues, oraréis así: Padre nuestro que estás en los cielos, santificado sea tu nombre.", "words": [[0, 87594], [9, 88139], [15, 88419], [23, 89179], [28, 89981], [34, 90353], [42, 90573], [46, 90993], [52, 91193], [55, 91433], [59, 91593], [67, 92333], [79, 93073], [83, 93313], [86, 93513]]}, {"verse": 10, "start": 94639, "end": 100924, "text": "Venga tu reino. Sea hecha tu voluntad, como en el cielo, así también en la tierra.", "words": [[0, 94878], [6, 95148], [9, 95188], [16, 96157], [20, 96481], [26, 96941], [29, 97141], [39, 97841], [44, 98121], [47, 98321], [50, 98441], [57, 99241], [61, 99441], [69, 99901], [72, 100081], [75, 100221]]}, {"verse": 11, "start": 101374, "end": 104255, "text": "Danos hoy nuestro pan de cada día.", "words": [[0, 101374], [6, 101812], [10, 102252], [18, 102712], [22, 103172], [25, 103392], [30, 103612]]}, {"verse": 12, "start": 104705, "end": 110618, "text": "Y perdónanos nuestras deudas, como también nosotros perdonamos a nuestros deudores.", "words": [[0, 104705], [2, 104812], [13, 105512], [22, 106052], [30, 106992], [35, 107212], [43, 107672], [52, 108272], [63, 109212], [65, 109372], [74, 109532]]}, {"verse": 13, "start": 111068, "end": 121072, "text": "Y no nos metas en tentación, sino líbranos del mal: porque tuyo es el reino, y el poder, y la gloria, por todos los siglos. Amén.", "words": [[0, 111068], [2, 111194], [5, 111314], [9, 111474], [15, 111914], [18, 112074], [29, 112854], [34, 113074], [43, 113974], [47, 114234], [52, 115080], [59, 115287], [64, 115787], [67, 115907], [70, 116067], [77, 116647], [79, 117107], [82, 117247], [89, 117647], [91, 117947], [94, 118107], [102, 118587], [106, 118827], [112, 119147], [116, 119407], [124, 120540]]}, {"verse": 14, "start": 121522, "end": 127991, "text": "Porque si perdonáis a los hombres sus ofensas, os perdonará también a vosotros vuestro Padre celestial.", "words": [[0, 121522], [7, 121704], [10, 121884], [20, 122504], [22, 122624], [26, 122764], [34, 123144], [38, 123404], [47, 124384], [50, 124684], [60, 125404], [68, 125804], [70, 126024], [79, 126464], [87, 126844], [93, 127224]]}, {"verse": 15, "start": 128441, "end": 134610, "text": "Pero si no perdonáis a los hombres sus ofensas, tampoco vuestro Padre os perdonará vuestras ofensas.", "words": [[0, 128441], [5, 128585], [8, 128745], [11, 128905], [21, 129485], [23, 129605], [27, 129725], [35, 130085], [39, 130325], [48, 131245], [56, 131565], [64, 132105], [70, 132445], [73, 132665], [83, 133285], [92, 133705]]}, {"verse": 16, "start": 135060, "end": 148064, "text": "Y cuando ayunáis, no seáis como los hipócritas, sombríos; porque ellos desfiguran sus rostros para parecer a los hombres que ayunan: de cierto os digo, que ya tienen su pago.", "words": [[0, 135060], [2, 135205], [9, 135445], [18, 136405], [21, 136525], [27, 136985], [32, 137245], [36, 137425], [48, 138459], [58, 139733], [65, 139996], [71, 140416], [82, 141156], [86, 141396], [94, 142096], [99, 142616], [107, 143076], [109, 143256], [113, 143416], [121, 143716], [125, 143956], [133, 144898], [136, 145042], [143, 145382], [146, 145862], [152, 146202], [156, 146702], [159, 146882], [166, 147162], [169, 147402]]}, {"verse": 17, "start": 148514, "end": 152313, "text": "Pero tú, cuando ayunas, unge tu cabeza y lava tu rostro;", "words": [[0, 148514], [5, 148660], [9, 148900], [16, 149140], [24, 149640], [29, 150140], [32, 150280], [39, 150760], [41, 151300], [46, 151460], [49, 151700]]}, {"verse": 18, "start": 152763, "end": 162350, "text": "Para no parecer a los hombres que ayunas, sino a tu Padre que está en secreto: y tu Padre que ve en secreto, te recompensará en público.", "words": [[0, 152763], [5, 153043], [8, 153433], [16, 153823], [18, 153943], [22, 154103], [30, 154443], [34, 154703], [42, 155403], [47, 155783], [49, 156043], [52, 156163], [58, 156543], [62, 156763], [67, 156983], [70, 157143], [79, 158193], [81, 158318], [84, 158418], [90, 158938], [94, 159058], [97, 159258], [100, 159378], [109, 160478], [112, 160698], [125, 161558], [128, 161678]]}, {"verse": 19, "start": 162800, "end": 170456, "text": "No os hagáis tesoros en la tierra, donde la polilla y el óxido corrompen, y donde ladrones entran a robar;", "words": [[0, 162800], [3, 163005], [6, 163205], [13, 163545], [21, 164245], [24, 164365], [27, 164505], [35, 164925], [41, 165485], [44, 165745], [52, 166225], [54, 166385], [57, 166485], [63, 166905], [74, 167665], [76, 168105], [82, 168345], [91, 168985], [98, 169725], [100, 169885]]}, {"verse": 20, "start": 170906, "end": 179862, "text": "Pero haceos tesoros en el cielo, donde ni polilla ni óxido corrompen, y donde ladrones no entran a robar:", "words": [[0, 170906], [5, 171370], [12, 171870], [20, 172610], [23, 172790], [26, 172930], [33, 173990], [39, 174430], [42, 174810], [50, 175490], [53, 175710], [59, 176250], [70, 176970], [72, 177190], [78, 177490], [87, 178290], [90, 178730], [97, 179130], [99, 179270]]}, {"verse": 21, "start": 180312, "end": 184264, "text": "Porque donde esté vuestro tesoro, allí estará vuestro corazón.", "words": [[0, 180312], [7, 180496], [13, 180756], [18, 181076], [26, 181456], [34, 182296], [39, 182776], [46, 183256], [54, 183616]]}, {"verse": 22, "start": 184714, "end": 192276, "text": "La lámpara del cuerpo es el ojo: así que, si tu ojo es bueno, todo tu cuerpo estará lleno de luz:", "words": [[0, 184714], [3, 184868], [11, 185408], [15, 185608], [22, 186068], [25, 186488], [28, 186828], [33, 187640], [37, 187845], [42, 188325], [45, 188585], [48, 188785], [52, 189065], [55, 189205], [62, 190005], [67, 190185], [70, 190445], [77, 190785], [84, 191325], [90, 191645], [93, 191765]]}, {"verse": 23, "start": 192726, "end": 202799, "text": "Pero si tu ojo es maligno, todo tu cuerpo estará en tinieblas. Así que, si la luz que en ti hay es tinieblas, ¿cuántas serán las mismas tinieblas?", "words": [[0, 192726], [5, 192870], [8, 193090], [11, 193270], [15, 193550], [18, 193670], [27, 194670], [32, 194830], [35, 195090], [42, 195410], [49, 195910], [52, 196466], [63, 197258], [67, 197550], [72, 197750], [75, 197950], [78, 198110], [82, 198350], [86, 198590], [89, 198770], [92, 198950], [96, 199230], [99, 199570], [110, 200770], [119, 201310], [125, 201610], [129, 201750], [136, 202090]]}, {"verse": 24, "start": 203249, "end": 217030, "text": "Ninguno puede servir a dos señores; porque o aborrecerá al uno y amará al otro, o se llegará al uno y menospreciará al otro: no podéis servir a Dios y a las riquezas.", "words": [[0, 203249], [8, 203697], [14, 203917], [21, 204317], [23, 204517], [27, 204677], [36, 205735], [43, 206137], [45, 206617], [56, 207557], [59, 207797], [63, 208077], [65, 208337], [71, 208677], [74, 208997], [80, 209757], [82, 210057], [85, 210197], [93, 210637], [96, 210957], [100, 211277], [102, 212067], [116, 212857], [119, 213177], [125, 213990], [128, 214158], [135, 214638], [142, 215138], [144, 215438], [149, 215658], [151, 215998], [153, 216078], [157, 216198]]}, {"verse": 25, "start": 217480, "end": 231092, "text": "Por tanto os digo: No os preocupéis por vuestra vida, qué habéis de comer, o qué habéis de beber; ni por vuestro cuerpo, qué habéis de vestir: ¿no es la vida más que el alimento, y el cuerpo que el vestido?", "words": [[0, 217480], [4, 217674], [10, 217900], [13, 218127], [19, 218963], [22, 219191], [25, 219331], [36, 220111], [40, 220331], [48, 220731], [54, 221391], [58, 221511], [65, 221871], [68, 222011], [75, 222291], [77, 222611], [81, 222791], [88, 223171], [91, 223311], [98, 224218], [101, 224318], [105, 224558], [113, 224958], [121, 225398], [125, 225818], [132, 226238], [135, 226378], [143, 227330], [147, 227519], [150, 227639], [153, 227779], [158, 227979], [162, 228179], [166, 228379], [169, 228519], [179, 228979], [181, 229279], [184, 229459], [191, 229979], [195, 230259], [198, 230379]]}, {"verse": 26, "start": 231542, "end": 243485, "text": "Mirad las aves del cielo, que no siembran, ni siegan, ni recogen en graneros; y vuestro Padre celestial las alimenta. ¿No sois vosotros mucho mejores que ellas?", "words": [[0, 231542], [6, 231910], [10, 232050], [15, 232410], [19, 232590], [26, 232930], [30, 233170], [33, 233330], [43, 234170], [46, 234690], [54, 235210], [57, 235450], [65, 236210], [68, 236390], [78, 237508], [80, 237606], [88, 237946], [94, 238366], [104, 239006], [108, 239386], [118, 240599], [122, 240706], [127, 241146], [136, 241866], [142, 242166], [150, 242586], [154, 242826]]}, {"verse": 27, "start": 243935, "end": 249684, "text": "Pero ¿quién de vosotros podrá, preocupándose, añadir a su estatura un codo?", "words": [[0, 243935], [5, 244057], [12, 244537], [15, 244637], [24, 245037], [31, 245497], [46, 247057], [53, 247677], [55, 247777], [58, 247937], [67, 248417], [70, 248617]]}, {"verse": 28, "start": 250134, "end": 258896, "text": "Y por el vestido ¿por qué os preocupáis? Observad los lirios del campo, cómo crecen; no trabajan ni hilan;", "words": [[0, 250134], [2, 250134], [6, 250299], [9, 250439], [17, 251479], [22, 251739], [26, 252039], [29, 252219], [41, 253636], [50, 254217], [54, 254397], [61, 254687], [65, 254977], [72, 255737], [77, 255997], [85, 257035], [88, 257242], [97, 258002], [100, 258242]]}, {"verse": 29, "start": 259346, "end": 264676, "text": "Pero os digo, que ni aun Salomón con toda su gloria fue vestido así como uno de ellos.", "words": [[0, 259346], [5, 259490], [8, 259670], [14, 259930], [18, 260240], [21, 260550], [25, 260810], [33, 261550], [37, 261730], [42, 262010], [45, 262270], [52, 262650], [56, 262870], [64, 263310], [68, 263470], [73, 263750], [77, 263950], [80, 264130]]}, {"verse": 30, "start": 265126, "end": 275835, "text": "Y si la hierba del campo que hoy es, y mañana es echada en el horno, Dios la viste así, ¿no hará mucho más a vosotros, hombres de poca fe?", "words": [[0, 265126], [2, 265250], [5, 265370], [8, 265530], [15, 265990], [19, 266150], [25, 266630], [29, 266890], [33, 267110], [37, 267990], [39, 268070], [46, 268390], [49, 268650], [56, 269030], [59, 269170], [62, 269290], [69, 270070], [74, 270390], [77, 270710], [83, 271030], [88, 271850], [92, 272250], [97, 272530], [103, 272790], [107, 273150], [109, 273330], [119, 274190], [127, 274770], [130, 275090], [135, 275430]]}, {"verse": 31, "start": 276285, "end": 282554, "text": "No os preocupéis pues, diciendo: ¿Qué comeremos, o qué beberemos, o con qué nos vestiremos?", "words": [[0, 276285], [3, 276572], [6, 276832], [17, 277612], [23, 277912], [33, 279463], [38, 279703], [49, 280283], [51, 280643], [55, 280803], [66, 281363], [68, 281743], [72, 281983], [76, 282163], [80, 282358]]}, {"verse": 32, "start": 283004, "end": 291370, "text": "Porque los Gentiles buscan todas estas cosas: que vuestro Padre celestial sabe que necesitáis todas estas cosas.", "words": [[0, 283661], [7, 283941], [11, 284121], [20, 284621], [27, 285061], [33, 285341], [39, 285661], [46, 286735], [50, 286990], [58, 287350], [64, 287770], [74, 288330], [79, 288710], [83, 288950], [94, 289970], [100, 290270], [106, 290630]]}, {"verse": 33, "start": 291820, "end": 299453, "text": "Pero buscad primeramente el reino de Dios y su justicia, y todas estas cosas os serán añadidas.", "words": [[0, 291820], [5, 291987], [12, 292487], [25, 293267], [28, 293447], [34, 293847], [37, 293987], [42, 294287], [44, 294747], [47, 294907], [57, 295587], [59, 296327], [65, 296607], [71, 296907], [77, 297407], [80, 298067], [86, 298507]]}, {"verse": 34, "start": 299903, "end": 308170, "text": "Así que, no os preocupéis por el día de mañana; que el día de mañana traerá su fatiga: basta al día su afán.", "words": [[0, 299903], [4, 300309], [9, 300529], [12, 300749], [15, 300949], [26, 301629], [30, 301849], [33, 301989], [37, 302149], [40, 302289], [48, 303203], [52, 303327], [55, 303507], [59, 303747], [62, 303887], [69, 304367], [76, 305067], [79, 305227], [87, 306381], [93, 306827], [96, 307127], [100, 307487], [103, 307587]]}]}