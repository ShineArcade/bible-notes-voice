{"book": "MAT", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 322404, "verses": [{"verse": 1, "start": 300, "end": 5495, "text": "Entonces entrando en el barco, pasó a la otra parte, y vino a su ciudad.", "words": [[0, 300], [9, 824], [18, 1544], [21, 1704], [24, 1844], [31, 2724], [36, 3084], [38, 3224], [41, 3304], [46, 3484], [53, 3944], [55, 4284], [60, 4504], [62, 4664], [65, 4824]]}, {"verse": 2, "start": 5945, "end": 17448, "text": "Y he aquí le trajeron un paralítico, echado en una cama: y viendo Jesús la fe de ellos, dijo al paralítico: Confía, hijo; tus pecados te son perdonados.", "words": [[0, 5945], [2, 6274], [5, 6414], [10, 6674], [13, 6834], [22, 7414], [25, 7534], [37, 8494], [44, 9114], [47, 9274], [51, 9454], [57, 10332], [59, 10436], [66, 10676], [72, 11416], [75, 11496], [78, 11676], [81, 11856], [88, 12656], [93, 13056], [96, 13276], [108, 14445], [116, 14940], [122, 15719], [126, 15783], [134, 16263], [137, 16383], [141, 16543]]}, {"verse": 3, "start": 17898, "end": 23114, "text": "Y he aquí, algunos de los escribas decían dentro de sí: Este blasfema.", "words": [[0, 17898], [2, 18061], [5, 18261], [11, 18601], [19, 19121], [22, 19361], [26, 19481], [35, 20001], [42, 20481], [49, 20761], [52, 21061], [56, 21640], [61, 21901]]}, {"verse": 4, "start": 23464, "end": 28922, "text": "Y viendo Jesús sus pensamientos, dijo: ¿Por qué pensáis mal en vuestros corazones?", "words": [[0, 23464], [2, 23590], [9, 23830], [15, 24550], [19, 24650], [33, 25590], [39, 26437], [44, 26563], [48, 26723], [56, 27163], [60, 27443], [63, 27623], [72, 28043]]}, {"verse": 5, "start": 29372, "end": 35977, "text": "Porque, ¿qué es más fácil, decir: Los pecados te son perdonados; o decir: Levántate, y anda?", "words": [[0, 29442], [8, 29512], [13, 29652], [16, 29912], [20, 30072], [27, 30412], [34, 31614], [38, 31722], [46, 32042], [49, 32362], [53, 32542], [65, 33705], [67, 33821], [74, 34617], [85, 35258], [87, 35578]]}, {"verse": 6, "start": 36427, "end": 48197, "text": "Pues para que sepáis que el Hijo del hombre tiene autoridad en la tierra de perdonar pecados, (dice entonces al paralítico): Levántate, toma tu cama, y vete a tu casa.", "words": [[0, 36427], [5, 36791], [10, 37431], [14, 37591], [21, 38131], [25, 38371], [28, 38531], [33, 38791], [37, 38931], [44, 39231], [50, 39551], [60, 40331], [63, 40491], [66, 40631], [73, 40991], [76, 41211], [85, 41771], [94, 43060], [100, 43280], [109, 43680], [112, 44000], [125, 45259], [136, 45943], [141, 46103], [144, 46303], [150, 46643], [152, 47183], [157, 47463], [159, 47543], [162, 47643]]}, {"verse": 7, "start": 48647, "end": 52681, "text": "Entonces él se levantó y se fue a su casa.", "words": [[0, 48647], [9, 49717], [12, 50137], [15, 50337], [23, 50977], [25, 51457], [28, 51577], [32, 51797], [34, 51917], [37, 52077]]}, {"verse": 8, "start": 53131, "end": 59836, "text": "Y la gente, al verlo, se maravilló y glorificó a Dios, que había dado tal autoridad a los hombres.", "words": [[0, 53131], [2, 53380], [5, 53500], [12, 53820], [15, 54020], [22, 54480], [25, 54880], [35, 55500], [37, 55600], [47, 56320], [49, 56540], [55, 57260], [59, 57460], [65, 57680], [70, 57960], [74, 58220], [84, 58860], [86, 59000], [90, 59120]]}, {"verse": 9, "start": 60286, "end": 73928, "text": "Y pasando Jesús de allí, vio a un hombre que estaba sentado a la mesa de recaudación de impuestos, el cual se llamaba Mateo; y le dice: Sígueme. Y se levantó, y le siguió.", "words": [[0, 60286], [2, 60409], [10, 60809], [16, 61269], [19, 61569], [25, 62449], [29, 62809], [31, 63029], [34, 63249], [41, 63589], [45, 63749], [52, 64049], [60, 64729], [62, 64849], [65, 64949], [70, 65229], [73, 65449], [85, 66329], [88, 66569], [99, 67769], [102, 67849], [107, 68029], [110, 68209], [118, 68689], [125, 69782], [127, 69942], [130, 69982], [136, 70864], [145, 71944], [147, 72073], [150, 72173], [159, 72953], [161, 73233], [164, 73353]]}, {"verse": 10, "start": 74378, "end": 86005, "text": "Y aconteció que estando él sentado a la mesa en casa, he aquí que muchos publicanos y pecadores, que habían venido, se sentaron juntamente a la mesa con Jesús y sus discípulos.", "words": [[0, 74378], [2, 74486], [12, 75166], [16, 75386], [24, 76026], [27, 76326], [35, 76986], [37, 77126], [40, 77246], [45, 77526], [48, 77726], [54, 78326], [57, 78926], [62, 79166], [66, 79326], [73, 79546], [84, 80286], [86, 80596], [97, 80906], [101, 81106], [108, 81266], [116, 82255], [119, 82402], [128, 82882], [139, 83542], [141, 83662], [144, 83722], [149, 83922], [153, 84142], [159, 84522], [161, 85022], [165, 85182]]}, {"verse": 11, "start": 86455, "end": 94236, "text": "Y viendo esto los fariseos, dijeron a sus discípulos: ¿Por qué come vuestro Maestro con los publicanos y pecadores?", "words": [[0, 86455], [2, 86560], [9, 86880], [14, 87280], [18, 87580], [28, 88500], [36, 89360], [38, 89460], [42, 89620], [54, 90865], [59, 91011], [63, 91191], [68, 91451], [76, 91871], [84, 92351], [88, 92571], [92, 92671], [103, 93291], [105, 93451]]}, {"verse": 12, "start": 94586, "end": 102260, "text": "Y oyéndolo Jesús, les dijo: Los que están sanos no tienen necesidad de médico, sino los enfermos.", "words": [[0, 94586], [2, 94788], [11, 95388], [18, 95688], [22, 96068], [28, 96976], [32, 97104], [36, 97244], [42, 97524], [48, 98184], [51, 98424], [58, 98784], [68, 99944], [71, 100124], [79, 100684], [84, 101224], [88, 101464]]}, {"verse": 13, "start": 102710, "end": 113364, "text": "Andad pues, y aprended qué cosa es: Misericordia quiero, y no sacrificio: porque no he venido a llamar justos, sino pecadores a arrepentimiento.", "words": [[0, 102905], [6, 103125], [12, 103325], [14, 103645], [23, 103965], [27, 104285], [32, 104605], [36, 105418], [49, 106166], [57, 106566], [59, 107026], [62, 107146], [74, 108317], [81, 108583], [84, 108803], [87, 108883], [94, 109243], [96, 109343], [103, 109683], [111, 110623], [116, 110903], [126, 111583], [128, 111923]]}, {"verse": 14, "start": 113814, "end": 123446, "text": "Entonces los discípulos de Juan vienen a él, diciendo: ¿Por qué nosotros y los fariseos ayunamos muchas veces, y tus discípulos no ayunan?", "words": [[0, 113814], [9, 114260], [13, 114620], [24, 115260], [27, 115420], [32, 115700], [39, 116340], [41, 116580], [45, 116820], [55, 118295], [60, 118421], [64, 118581], [73, 119081], [75, 119321], [79, 119441], [88, 120141], [97, 120721], [104, 120961], [111, 121361], [113, 121761], [117, 121901], [128, 122561], [131, 122841]]}, {"verse": 15, "start": 123796, "end": 136103, "text": "Y Jesús les dijo: ¿Pueden los que son de bodas tener luto entre tanto que el esposo está con ellos? pero vendrán días cuando el esposo será quitado de ellos, y entonces ayunarán.", "words": [[0, 123796], [2, 123936], [8, 124316], [12, 124796], [18, 125660], [26, 125982], [30, 126102], [34, 126222], [38, 126455], [41, 126689], [47, 126922], [53, 127162], [58, 127662], [64, 127882], [70, 128282], [74, 128522], [77, 128642], [84, 129002], [89, 129182], [93, 129462], [100, 130286], [105, 130430], [113, 130910], [118, 131210], [125, 131910], [128, 132130], [135, 132490], [140, 132770], [148, 133330], [151, 133550], [158, 133870], [160, 134410], [169, 134890]]}, {"verse": 16, "start": 136553, "end": 146094, "text": "Y nadie echa remiendo de tela sin encoger en vestido viejo; porque el tal remiendo tira del vestido, y se hace peor la rotura.", "words": [[0, 136553], [2, 136691], [8, 136991], [13, 137561], [22, 138131], [25, 138331], [30, 138691], [34, 139051], [42, 139731], [45, 139951], [53, 140391], [60, 141291], [67, 141556], [70, 141816], [74, 142016], [83, 142736], [88, 143136], [92, 143336], [101, 143916], [103, 144356], [106, 144496], [111, 144736], [116, 145136], [119, 145316]]}, {"verse": 17, "start": 146544, "end": 161918, "text": "Ni echan vino nuevo en odres viejos: de otra manera los odres se rompen, y el vino se derrama, y se pierden los odres; sino que echan el vino nuevo en odres nuevos, y lo uno y lo otro se conserva juntamente.", "words": [[0, 146544], [3, 146740], [9, 147060], [14, 147520], [20, 147980], [23, 148180], [29, 148380], [37, 149623], [40, 149790], [45, 149970], [52, 150390], [56, 150650], [62, 151070], [65, 151190], [73, 151730], [75, 152230], [78, 152390], [83, 152590], [86, 152810], [95, 153350], [97, 153950], [100, 154070], [108, 154530], [112, 154690], [119, 155683], [124, 155929], [128, 156189], [134, 156669], [137, 156849], [142, 157069], [148, 157529], [151, 157909], [157, 158409], [165, 158849], [167, 159189], [170, 159349], [174, 159649], [176, 159809], [179, 159929], [184, 160169], [187, 160369], [196, 161009]]}, {"verse": 18, "start": 162368, "end": 172315, "text": "Hablando él estas cosas a ellos, he aquí vino un dirigente, y le adoraba, diciendo: Mi hija acaba de morir: pero ven y pon tu mano sobre ella, y vivirá.", "words": [[0, 162368], [9, 162736], [12, 162976], [18, 163176], [24, 163596], [26, 163856], [33, 164516], [36, 164596], [41, 164856], [46, 165196], [49, 165396], [60, 166116], [62, 166596], [65, 166736], [74, 167216], [84, 168305], [87, 168451], [92, 168751], [98, 168931], [101, 169151], [108, 169918], [113, 170062], [117, 170302], [119, 170422], [123, 170622], [126, 170742], [131, 170942], [137, 171262], [143, 171542], [145, 171742]]}, {"verse": 19, "start": 172665, "end": 176881, "text": "Y se levantó Jesús, y le siguió, y sus discípulos.", "words": [[0, 172665], [2, 172809], [5, 172909], [13, 173469], [20, 173889], [22, 174449], [25, 174589], [33, 175169], [35, 175569], [39, 175749]]}, {"verse": 20, "start": 177331, "end": 185300, "text": "Y he aquí una mujer enferma de hemorragia doce años había, llegándose por detrás, tocó la franja de su vestido:", "words": [[0, 177331], [2, 177713], [5, 177853], [10, 178073], [14, 178273], [20, 178553], [28, 179193], [31, 179333], [42, 179883], [47, 180433], [52, 180813], [59, 181273], [70, 182493], [74, 182673], [82, 183253], [87, 183813], [90, 183933], [97, 184373], [100, 184513], [103, 184673]]}, {"verse": 21, "start": 185750, "end": 191003, "text": "Porque decía entre sí: Si toco solamente su vestido, seré salva.", "words": [[0, 185750], [7, 185971], [13, 186451], [19, 186931], [23, 187617], [26, 187797], [31, 188157], [41, 188677], [44, 189097], [53, 190117], [58, 190437]]}, {"verse": 22, "start": 191353, "end": 200856, "text": "Pero Jesús volviéndose, y mirándola, dijo: Confía, hija, tu fe te ha salvado. Y la mujer fue salva desde aquella hora.", "words": [[0, 191353], [5, 191517], [11, 192337], [24, 193157], [26, 193417], [37, 194477], [43, 195404], [51, 196126], [57, 196846], [60, 196966], [63, 197146], [66, 197286], [69, 197366], [78, 198368], [80, 198454], [83, 198554], [89, 198754], [93, 199054], [99, 199514], [105, 199694], [113, 200114]]}, {"verse": 23, "start": 201306, "end": 207771, "text": "Y llegado Jesús a casa del principal, viendo los flautistas, y la gente que hacía bullicio,", "words": [[0, 201306], [2, 201410], [10, 201810], [16, 202110], [18, 202410], [23, 202710], [27, 202950], [38, 204110], [45, 204370], [49, 204630], [61, 205330], [63, 205810], [66, 205930], [72, 206190], [76, 206390], [82, 206730]]}, {"verse": 24, "start": 208221, "end": 214371, "text": "Les dice: Apartaos, que la muchacha no es muerta, sino que duerme. Y se burlaban de él.", "words": [[0, 208271], [4, 208351], [10, 209666], [20, 210186], [24, 210286], [27, 210386], [36, 210826], [39, 211026], [42, 211126], [50, 211746], [55, 211966], [59, 212166], [67, 213034], [69, 213138], [72, 213298], [81, 213838], [84, 214078]]}, {"verse": 25, "start": 214821, "end": 221681, "text": "Y como la gente fue echada fuera, entró, y la tomó de la mano, y se levantó la muchacha.", "words": [[0, 214821], [2, 214950], [7, 215170], [10, 215330], [16, 215670], [20, 215970], [27, 216680], [34, 217390], [41, 217910], [43, 218530], [46, 218650], [51, 219070], [54, 219130], [57, 219290], [63, 219690], [65, 220170], [68, 220310], [76, 220790], [79, 220910]]}, {"verse": 26, "start": 222131, "end": 225774, "text": "Y salió esta fama por toda aquella tierra.", "words": [[0, 222131], [2, 222451], [8, 222931], [13, 223311], [18, 223851], [22, 224031], [27, 224411], [35, 225011]]}, {"verse": 27, "start": 226224, "end": 235108, "text": "Y pasando Jesús de allí, le siguieron dos ciegos, dando voces y diciendo: Ten misericordia de nosotros, Hijo de David.", "words": [[0, 226224], [2, 226328], [10, 226768], [16, 227248], [19, 227548], [25, 228248], [28, 228348], [38, 228908], [42, 229148], [50, 230248], [56, 230508], [62, 231248], [64, 231488], [74, 232459], [78, 232580], [91, 233360], [94, 233480], [104, 234320], [109, 234480], [112, 234660]]}, {"verse": 28, "start": 235458, "end": 245957, "text": "Y llegado a la casa, vinieron a él los ciegos; y Jesús les dice: ¿Creéis que puedo hacer esto? Ellos dicen: Sí, Señor.", "words": [[0, 235458], [2, 235564], [10, 235984], [12, 236084], [15, 236164], [21, 236544], [30, 237444], [32, 237604], [35, 237804], [39, 237984], [47, 239029], [49, 239174], [55, 239534], [59, 239914], [65, 240771], [73, 241197], [77, 241317], [83, 241557], [89, 241857], [95, 242709], [101, 243252], [108, 244161], [112, 244588]]}, {"verse": 29, "start": 246307, "end": 252397, "text": "Entonces tocó los ojos de ellos, diciendo: Conforme a vuestra fe os sea hecho.", "words": [[0, 246307], [9, 246911], [14, 247491], [18, 247671], [23, 247971], [26, 248271], [33, 248591], [43, 249844], [52, 250428], [54, 250508], [62, 250788], [65, 251068], [68, 251348], [72, 251728]]}, {"verse": 30, "start": 252847, "end": 261461, "text": "Y los ojos de ellos fueron abiertos. Y Jesús les advirtió firmemente, diciendo: Mirad que nadie lo sepa.", "words": [[0, 252847], [2, 253108], [6, 253268], [11, 253548], [14, 253768], [20, 253988], [27, 254308], [37, 255578], [39, 255852], [45, 256272], [49, 256812], [58, 257512], [70, 258552], [80, 259604], [86, 260011], [90, 260471], [96, 260711], [99, 260931]]}, {"verse": 31, "start": 261911, "end": 266217, "text": "Pero ellos salidos, divulgaron su fama por toda aquella tierra.", "words": [[0, 261911], [5, 262055], [11, 262335], [20, 263035], [31, 264095], [34, 264255], [39, 264655], [43, 264835], [48, 265075], [56, 265515]]}, {"verse": 32, "start": 266667, "end": 271397, "text": "Y saliendo ellos, he aquí, le trajeron un hombre mudo, endemoniado.", "words": [[0, 266667], [2, 266918], [11, 267438], [18, 267698], [21, 267958], [27, 268638], [30, 268718], [39, 269338], [42, 269438], [49, 269678], [55, 270567]]}, {"verse": 33, "start": 271847, "end": 281066, "text": "Y echado fuera el demonio, el mudo habló; y la gente se maravillaba, diciendo: Nunca ha sido vista cosa semejante en Israel.", "words": [[0, 271847], [2, 272102], [9, 272502], [15, 272722], [18, 272982], [27, 273822], [30, 273942], [35, 274302], [42, 275210], [44, 275332], [47, 275452], [53, 275752], [56, 276032], [69, 276892], [79, 278184], [85, 278630], [88, 278750], [93, 278910], [99, 279190], [104, 279590], [114, 280310], [117, 280450]]}, {"verse": 34, "start": 281416, "end": 287264, "text": "Pero los fariseos decían: Por el príncipe de los demonios echa fuera los demonios.", "words": [[0, 281416], [5, 281580], [9, 281820], [18, 282620], [26, 283936], [30, 284080], [33, 284180], [42, 284760], [45, 284880], [49, 285000], [58, 285500], [63, 286000], [69, 286220], [73, 286460]]}, {"verse": 35, "start": 287614, "end": 300948, "text": "Y rodeaba Jesús por todas las ciudades y aldeas, enseñando en las sinagogas de ellos, y predicando el evangelio del reino, y sanando toda enfermedad y toda dolencia en el pueblo.", "words": [[0, 287614], [2, 287798], [10, 288498], [16, 288898], [20, 289298], [26, 289618], [30, 289878], [39, 290518], [41, 290658], [49, 291398], [59, 292278], [62, 292398], [66, 292518], [76, 293258], [79, 293418], [86, 293698], [88, 294158], [99, 294958], [102, 295118], [112, 295698], [116, 295898], [123, 296843], [125, 296947], [133, 297467], [138, 297787], [149, 298707], [151, 298847], [156, 299067], [165, 299967], [168, 300107], [171, 300247]]}, {"verse": 36, "start": 301398, "end": 309792, "text": "Y al ver las multitudes, tuvo compasión de ellas; porque estaban desamparadas y dispersas como ovejas que no tienen pastor.", "words": [[0, 301398], [2, 301521], [5, 301661], [9, 301861], [13, 302081], [25, 302721], [30, 303001], [40, 303741], [43, 303941], [50, 304784], [57, 305084], [65, 305424], [78, 306404], [80, 306564], [90, 307404], [95, 307864], [102, 308404], [106, 308664], [109, 308824], [116, 309084]]}, {"verse": 37, "start": 310242, "end": 316389, "text": "Entonces dice a sus discípulos: A la verdad la cosecha es mucha, pero los obreros pocos.", "words": [[0, 310242], [9, 310787], [14, 311427], [16, 311767], [20, 311947], [32, 313147], [34, 313257], [37, 313357], [44, 313817], [47, 314067], [55, 314317], [58, 314437], [65, 314837], [70, 315037], [74, 315217], [82, 315697]]}, {"verse": 38, "start": 316839, "end": 322004, "text": "Rogad, pues, al Señor de la cosecha, que envíe obreros a su cosecha.", "words": [[0, 317095], [7, 317385], [13, 317625], [16, 318325], [22, 318625], [25, 318805], [28, 318925], [37, 319525], [41, 319945], [47, 320425], [55, 321045], [57, 321165], [60, 321305]]}]}