{"book": "MAT", "chapter": 5, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 404222, "verses": [{"verse": 1, "start": 300, "end": 6971, "text": "Y viendo la multitud, subió al monte; y sentándose, se llegaron a él sus discípulos.", "words": [[0, 300], [2, 446], [9, 746], [12, 966], [22, 1606], [28, 2226], [31, 2386], [38, 3316], [40, 3443], [52, 4763], [55, 4983], [64, 5523], [66, 5603], [69, 5803], [73, 6003]]}, {"verse": 2, "start": 7421, "end": 9738, "text": "Y abriendo su boca, les enseñaba, diciendo:", "words": [[0, 7421], [2, 7707], [11, 8167], [14, 8347], [20, 8687], [24, 8927], [34, 9333]]}, {"verse": 3, "start": 10188, "end": 17184, "text": "Bienaventurados los pobres en espíritu: porque de ellos es el reino de los cielos.", "words": [[0, 10707], [16, 12187], [20, 12367], [27, 12847], [30, 13007], [40, 14005], [47, 14325], [50, 14585], [56, 14925], [59, 15345], [62, 15665], [68, 16185], [71, 16305], [75, 16425]]}, {"verse": 4, "start": 17634, "end": 22195, "text": "Bienaventurados los que lloran: porque ellos recibirán consolación.", "words": [[0, 18282], [16, 18642], [20, 18822], [24, 19002], [32, 19886], [39, 20123], [45, 20383], [55, 21143]]}, {"verse": 5, "start": 22645, "end": 27802, "text": "Bienaventurados los mansos: porque ellos heredarán la tierra.", "words": [[0, 23385], [16, 24225], [20, 24345], [28, 25478], [35, 25702], [41, 26102], [51, 26942], [54, 27082]]}, {"verse": 6, "start": 28252, "end": 34526, "text": "Bienaventurados los que tienen hambre y sed de justicia: porque ellos serán satisfechos.", "words": [[0, 28252], [16, 29239], [20, 29399], [24, 29579], [31, 29899], [38, 30439], [40, 30659], [44, 30999], [47, 31239], [57, 32367], [64, 32611], [70, 32891], [76, 33431]]}, {"verse": 7, "start": 34976, "end": 40434, "text": "Bienaventurados los misericordiosos: porque ellos alcanzarán misericordia.", "words": [[0, 34976], [16, 35921], [20, 36161], [37, 37919], [44, 38120], [50, 38360], [61, 39260]]}, {"verse": 8, "start": 40884, "end": 45519, "text": "Bienaventurados los de limpio corazón: porque ellos verán a Dios.", "words": [[0, 41392], [16, 41902], [20, 42175], [23, 42449], [30, 42722], [39, 43714], [46, 43939], [52, 44359], [58, 44899], [60, 44959]]}, {"verse": 9, "start": 45969, "end": 51480, "text": "Bienaventurados los pacificadores: porque ellos serán llamados hijos de Dios.", "words": [[0, 46454], [16, 46974], [20, 47274], [35, 48680], [42, 49000], [48, 49280], [54, 49740], [63, 50240], [69, 50580], [72, 50880]]}, {"verse": 10, "start": 51930, "end": 60558, "text": "Bienaventurados los que padecen persecución por causa de la justicia: porque de ellos es el reino de los cielos.", "words": [[0, 51930], [16, 53095], [20, 53635], [24, 53815], [32, 54415], [44, 55315], [48, 55595], [54, 55955], [57, 56215], [60, 56315], [70, 57379], [77, 57699], [80, 57959], [86, 58299], [89, 58719], [92, 59039], [98, 59559], [101, 59679], [105, 59799]]}, {"verse": 11, "start": 61008, "end": 68987, "text": "Bienaventurados sois cuando os insulten, os persigan y digan de vosotros todo mal por mi causa, mintiendo.", "words": [[0, 61008], [16, 62077], [21, 62497], [28, 62757], [31, 63097], [41, 64217], [44, 64357], [53, 65097], [55, 65357], [61, 65617], [64, 65757], [73, 66277], [78, 66497], [82, 66877], [86, 67117], [89, 67277], [96, 68137]]}, {"verse": 12, "start": 69437, "end": 79903, "text": "Gozaos y alegraos; porque vuestra recompensa es grande en los cielos: que así persiguieron a los profetas que fueron antes de vosotros.", "words": [[0, 69684], [7, 69964], [9, 70558], [19, 71451], [26, 71635], [34, 72285], [45, 72935], [48, 73095], [55, 73535], [58, 73795], [62, 73895], [70, 75063], [74, 75147], [78, 75387], [91, 76307], [93, 76407], [97, 76547], [106, 77027], [110, 77207], [117, 77487], [123, 77947], [126, 78127]]}, {"verse": 13, "start": 80353, "end": 92220, "text": "Vosotros sois la sal de la tierra: y si la sal pierde su sabor ¿con qué será salada? no vale más para nada, sino para ser echada fuera y pisoteada de los hombres.", "words": [[0, 80394], [9, 80474], [14, 80554], [17, 80794], [21, 81014], [24, 81214], [27, 81354], [35, 83253], [37, 83253], [40, 83253], [43, 83253], [47, 83253], [54, 83718], [57, 83938], [63, 84458], [68, 84951], [72, 85445], [77, 85938], [85, 87028], [88, 87156], [93, 87356], [97, 87536], [102, 87776], [108, 88036], [113, 88376], [118, 88656], [122, 88956], [129, 89506], [135, 90056], [137, 90256], [147, 91116], [150, 91296], [154, 91456]]}, {"verse": 14, "start": 92670, "end": 99723, "text": "Vosotros sois la luz del mundo: una ciudad asentada sobre un monte no se puede esconder.", "words": [[0, 92670], [9, 93276], [14, 94016], [17, 94276], [21, 94536], [25, 94836], [32, 95794], [36, 96014], [43, 96414], [52, 97454], [58, 97734], [61, 97934], [67, 98294], [70, 98514], [73, 98694], [79, 98994]]}, {"verse": 15, "start": 100173, "end": 108878, "text": "Ni se enciende una lámpara y se pone debajo de un recipiente, sino sobre el candelero, y alumbra a todos los que están en casa.", "words": [[0, 100173], [3, 100317], [6, 100477], [15, 100917], [19, 101077], [27, 101537], [29, 101657], [32, 101757], [37, 101997], [44, 102417], [47, 102597], [50, 102677], [62, 103657], [67, 103977], [73, 104317], [76, 104477], [87, 105137], [89, 105817], [97, 106457], [99, 106877], [105, 107217], [109, 107737], [113, 107877], [119, 108137], [122, 108317]]}, {"verse": 16, "start": 109328, "end": 118722, "text": "Así alumbre vuestra luz delante de los hombres, para que vean vuestras obras buenas, y glorifiquen a vuestro Padre que está en los cielos.", "words": [[0, 109328], [4, 109715], [12, 110415], [20, 110835], [24, 111175], [32, 112315], [35, 112475], [39, 112615], [48, 113075], [53, 113715], [57, 113895], [62, 114235], [71, 114655], [77, 114915], [85, 115295], [87, 115735], [99, 116535], [101, 116615], [109, 116935], [115, 117395], [119, 117495], [124, 117715], [127, 117895], [131, 118015]]}, {"verse": 17, "start": 119172, "end": 125689, "text": "No penséis que he venido para abolir la ley o los profetas: no he venido para abolir, sino a cumplir.", "words": [[0, 119172], [3, 119280], [11, 119760], [15, 119940], [18, 120020], [25, 120340], [30, 120560], [37, 121040], [40, 121160], [44, 121420], [46, 121600], [50, 121740], [60, 122802], [63, 122947], [66, 123047], [73, 123407], [78, 123647], [86, 124687], [91, 124827], [93, 125007]]}, {"verse": 18, "start": 126139, "end": 137013, "text": "Porque de cierto os digo, que hasta que pasen el cielo y la tierra, ni una jota ni un tilde perecerá de la ley, hasta que todas las cosas sean hechas.", "words": [[0, 126139], [7, 126504], [10, 126564], [17, 127324], [20, 127444], [26, 127904], [30, 128644], [36, 128864], [40, 129234], [46, 129604], [49, 129764], [55, 130144], [57, 130344], [60, 130484], [68, 130924], [71, 131504], [75, 131684], [80, 132124], [83, 132284], [86, 132634], [92, 132984], [101, 133584], [104, 133684], [107, 133824], [112, 134612], [118, 134952], [122, 135112], [128, 135392], [132, 135652], [138, 135992], [143, 136352]]}, {"verse": 19, "start": 137463, "end": 154816, "text": "De manera que cualquiera que infrinja uno de estos mandamientos muy pequeños, y así enseñe a los hombres, muy pequeño será llamado en el reino de los cielos: pero cualquiera que los haga y los enseñe, este será llamado grande en el reino de los cielos.", "words": [[0, 137463], [3, 137579], [10, 137779], [14, 138119], [25, 138719], [29, 139209], [38, 139699], [42, 140019], [45, 140239], [51, 140499], [64, 141259], [68, 141599], [78, 142419], [80, 142759], [84, 143239], [91, 143719], [93, 143799], [97, 143959], [106, 144339], [110, 145039], [118, 145739], [123, 145959], [131, 146359], [134, 146599], [137, 146759], [143, 147199], [146, 147339], [150, 147459], [158, 148514], [163, 148658], [174, 149258], [178, 149438], [182, 149618], [187, 150078], [189, 150238], [193, 150398], [201, 151358], [206, 151718], [211, 152018], [219, 152378], [226, 152858], [229, 153198], [232, 153378], [238, 153778], [241, 153918], [245, 154058]]}, {"verse": 20, "start": 155266, "end": 163587, "text": "Porque os digo, que si vuestra justicia no es mayor que la de los escribas y de los fariseos, no entraréis en el reino de los cielos.", "words": [[0, 155266], [7, 155488], [10, 155608], [16, 155848], [20, 156028], [23, 156188], [31, 156548], [40, 157148], [43, 157368], [46, 157468], [52, 157808], [56, 158048], [59, 158548], [62, 158688], [66, 158828], [75, 159448], [77, 159588], [80, 159728], [84, 159848], [94, 160808], [97, 161068], [107, 161808], [110, 162028], [113, 162208], [119, 162608], [122, 162748], [126, 162888]]}, {"verse": 21, "start": 164037, "end": 171638, "text": "Oísteis que fue dicho a los antiguos: No matarás; pero cualquiera que mate, será culpable de juicio.", "words": [[0, 164037], [8, 164763], [12, 164883], [16, 165103], [22, 165423], [24, 165583], [28, 165683], [38, 166933], [41, 167139], [50, 168276], [55, 168421], [66, 169021], [70, 169181], [76, 169541], [81, 170081], [90, 170761], [93, 170961]]}, {"verse": 22, "start": 172088, "end": 189517, "text": "Pero yo os digo que cualquiera que se enoje sin causa con su hermano, será culpable de juicio; y cualquiera que le diga a su hermano: Necio, será culpable ante el concilio; y cualquiera que le diga: Insensato, quedará expuesto al infierno de fuego.", "words": [[0, 172088], [5, 172232], [8, 172492], [11, 172592], [16, 172852], [20, 173032], [31, 173552], [35, 173692], [38, 173872], [44, 174312], [48, 174512], [54, 174972], [58, 175272], [61, 175472], [70, 175892], [75, 176092], [84, 176672], [87, 176832], [95, 177810], [97, 177933], [108, 178473], [112, 178633], [115, 178753], [120, 179133], [122, 179193], [125, 179333], [134, 181032], [141, 181032], [146, 181232], [155, 181932], [160, 182352], [163, 182552], [173, 183759], [175, 183845], [186, 184325], [190, 184465], [193, 184585], [199, 185399], [210, 186682], [218, 187082], [227, 187822], [230, 188002], [239, 188722], [242, 188922]]}, {"verse": 23, "start": 189967, "end": 195843, "text": "Por tanto, si traes tu ofrenda al altar y allí te acuerdas de que tu hermano tiene algo contra ti,", "words": [[0, 189967], [4, 190089], [11, 190589], [14, 190749], [20, 191109], [23, 191229], [31, 191769], [34, 191909], [40, 192329], [42, 192649], [47, 192969], [50, 193129], [59, 193649], [62, 193809], [66, 193909], [69, 194049], [77, 194429], [83, 194629], [88, 194969], [95, 195389]]}, {"verse": 24, "start": 196293, "end": 205843, "text": "Deja allí tu ofrenda delante del altar, y vete, reconcíliate primero con tu hermano, y entonces ven y ofrece tu ofrenda.", "words": [[0, 196293], [5, 196780], [10, 197060], [13, 197280], [21, 197920], [29, 198380], [33, 198620], [40, 198920], [42, 199340], [48, 200100], [61, 201060], [69, 201480], [73, 201800], [76, 201960], [85, 202700], [87, 202880], [96, 203280], [100, 203860], [102, 204440], [109, 204900], [112, 205140]]}, {"verse": 25, "start": 206293, "end": 220891, "text": "Concíliate con tu adversario pronto, entre tanto que estás con él en el camino; porque no acontezca que el adversario te entregue al juez, y el juez te entregue al guardia, y seas echado en prisión.", "words": [[0, 206654], [11, 207054], [15, 207334], [18, 207494], [29, 208214], [37, 209194], [43, 209454], [49, 209874], [53, 210074], [59, 210314], [63, 210614], [66, 210854], [69, 211074], [72, 211214], [80, 212153], [87, 212376], [90, 212636], [100, 213416], [104, 213596], [107, 213936], [118, 214716], [121, 215003], [130, 215289], [133, 215576], [139, 216136], [141, 216636], [144, 216776], [149, 217236], [152, 217509], [161, 217783], [164, 218056], [173, 218936], [175, 219256], [180, 219496], [187, 220036], [190, 220176]]}, {"verse": 26, "start": 221341, "end": 226385, "text": "De cierto te digo, que no saldrás de allí, hasta que pagues la última moneda.", "words": [[0, 221341], [3, 221506], [10, 221806], [13, 222146], [19, 222526], [23, 222786], [26, 222946], [34, 223506], [37, 223626], [43, 223946], [49, 224486], [53, 224686], [60, 225106], [63, 225266], [70, 225606]]}, {"verse": 27, "start": 226835, "end": 230313, "text": "Oísteis que fue dicho: No adulterarás:", "words": [[0, 226835], [8, 227623], [12, 227783], [16, 227983], [23, 228899], [26, 229084]]}, {"verse": 28, "start": 230763, "end": 238712, "text": "Pero yo os digo, que cualquiera que mira a una mujer para codiciarla, ya adulteró con ella en su corazón.", "words": [[0, 230763], [5, 230905], [8, 231165], [11, 231285], [17, 231565], [21, 232125], [32, 232825], [36, 233045], [41, 233325], [43, 233625], [47, 233785], [53, 234125], [58, 234705], [70, 235285], [73, 236165], [82, 237145], [86, 237365], [91, 237625], [94, 237825], [97, 237985]]}, {"verse": 29, "start": 239162, "end": 251150, "text": "Por tanto, si tu ojo derecho te es ocasión de caer, sácalo, y échalo de ti: que mejor te es que se pierda uno de tus miembros, que no que todo tu cuerpo sea echado al infierno.", "words": [[0, 239162], [4, 239287], [11, 239727], [14, 239887], [17, 240047], [21, 240347], [29, 240707], [32, 240957], [35, 241207], [43, 241727], [46, 241847], [52, 242647], [60, 243167], [62, 243547], [69, 243887], [72, 244087], [76, 244748], [80, 244830], [86, 245150], [89, 245370], [92, 245530], [96, 245610], [99, 245790], [106, 246250], [110, 246570], [113, 246770], [117, 246950], [127, 247830], [131, 248050], [134, 248210], [138, 248370], [143, 248610], [146, 248870], [153, 249210], [157, 249650], [164, 250250], [167, 250370]]}, {"verse": 30, "start": 251600, "end": 263501, "text": "Y si tu mano derecha te es ocasión de caer, córtala, y échala de ti: que mejor te es que se pierda uno de tus miembros, que no que todo tu cuerpo sea echado al infierno.", "words": [[0, 251600], [2, 251702], [5, 251822], [8, 251982], [13, 252282], [21, 252582], [24, 252882], [27, 253102], [35, 253602], [38, 253742], [44, 254462], [53, 255042], [55, 255722], [62, 256202], [65, 256462], [69, 257099], [73, 257181], [79, 257501], [82, 257721], [85, 257881], [89, 257961], [92, 258141], [99, 258601], [103, 258921], [106, 259121], [110, 259301], [120, 260181], [124, 260401], [127, 260561], [131, 260721], [136, 260961], [139, 261221], [146, 261561], [150, 262001], [157, 262601], [160, 262721]]}, {"verse": 31, "start": 263951, "end": 269867, "text": "También fue dicho: Cualquiera que se divorcie de su mujer, déle carta de divorcio:", "words": [[0, 263951], [8, 264374], [12, 264614], [19, 265455], [30, 265979], [34, 266119], [37, 266279], [46, 266859], [49, 267019], [52, 267159], [59, 267839], [64, 268259], [70, 268659], [73, 268979]]}, {"verse": 32, "start": 270317, "end": 282172, "text": "Pero yo os digo, que el que se divorcie de su mujer, a no ser por causa de fornicación, hace que ella adultere; y el que se casa con la divorciada, comete adulterio.", "words": [[0, 270317], [5, 270481], [8, 270721], [11, 270981], [17, 271301], [21, 272041], [24, 272221], [28, 272341], [31, 272521], [40, 273101], [43, 273241], [46, 273421], [53, 273841], [55, 274121], [58, 274261], [62, 274521], [66, 274741], [72, 275041], [75, 275301], [88, 276061], [93, 276421], [97, 276661], [102, 276881], [112, 278111], [114, 278257], [117, 278377], [121, 278537], [124, 278717], [129, 279077], [133, 279417], [136, 279597], [148, 280757], [155, 281491]]}, {"verse": 33, "start": 282622, "end": 291908, "text": "Además habéis oído que fue dicho a los antiguos: No jurarás falsamente; sino que cumplirás al Señor tus juramentos.", "words": [[0, 282622], [7, 283462], [14, 283902], [19, 284242], [23, 284422], [27, 284622], [33, 284942], [35, 285082], [39, 285182], [49, 286406], [52, 286651], [60, 287271], [72, 288684], [77, 288928], [81, 289128], [91, 289968], [94, 290368], [100, 290728], [104, 291008]]}, {"verse": 34, "start": 292358, "end": 299358, "text": "Pero yo os digo: No juréis en ninguna manera: ni por el cielo, porque es el trono de Dios;", "words": [[0, 292358], [5, 292500], [8, 292780], [11, 292980], [17, 293787], [20, 293975], [27, 294475], [30, 294595], [38, 294995], [46, 295967], [49, 296095], [53, 296335], [56, 296475], [63, 297275], [70, 297655], [73, 298035], [76, 298195], [82, 298615], [85, 298775]]}, {"verse": 35, "start": 299808, "end": 307653, "text": "Ni por la tierra, porque es el estrado de sus pies; ni por Jerusalén, porque es la ciudad del gran Rey.", "words": [[0, 299808], [3, 299935], [7, 300175], [10, 300355], [18, 301215], [25, 301575], [28, 301855], [31, 301995], [39, 302535], [42, 302715], [46, 302855], [52, 303987], [55, 304077], [59, 304277], [70, 305337], [77, 305597], [80, 305857], [83, 306037], [90, 306377], [94, 306777], [99, 307057]]}, {"verse": 36, "start": 308103, "end": 312799, "text": "Ni por tu cabeza jurarás, porque no puedes hacer un cabello blanco o negro.", "words": [[0, 308148], [3, 308228], [7, 308428], [10, 308568], [17, 308868], [26, 309588], [33, 310308], [36, 310428], [43, 310708], [49, 311028], [52, 311228], [60, 311588], [67, 312088], [69, 312208]]}, {"verse": 37, "start": 313249, "end": 321329, "text": "Pero sea vuestro hablar: Sí, sí; No, no; porque lo que es más de esto, de mal procede.", "words": [[0, 313249], [5, 313413], [9, 313753], [17, 314153], [25, 314933], [29, 315316], [33, 316191], [37, 316398], [41, 318478], [48, 318628], [51, 318788], [55, 318908], [58, 319028], [62, 319168], [65, 319328], [71, 319908], [74, 320228], [78, 320488]]}, {"verse": 38, "start": 321779, "end": 327022, "text": "Oísteis que fue dicho a los antiguos: Ojo por ojo, y diente por diente.", "words": [[0, 321779], [8, 322505], [12, 322625], [16, 322845], [22, 323165], [24, 323325], [28, 323425], [38, 324675], [42, 324961], [46, 325181], [51, 325721], [53, 325881], [60, 326161], [64, 326361]]}, {"verse": 39, "start": 327472, "end": 336160, "text": "Pero yo os digo: No resistáis al mal; antes a cualquiera que te hiera en tu mejilla derecha, vuélvele también la otra;", "words": [[0, 327472], [5, 327614], [8, 327894], [11, 328094], [17, 328901], [20, 329067], [30, 329707], [33, 329927], [38, 330732], [44, 331198], [46, 331378], [57, 331938], [61, 332098], [64, 332278], [70, 332578], [73, 332678], [76, 332798], [84, 333218], [93, 334038], [102, 334738], [110, 335058], [113, 335518]]}, {"verse": 40, "start": 336610, "end": 342071, "text": "Y al que quiera ponerte a pleito y quitarte la túnica, déjale también la capa;", "words": [[0, 336610], [2, 336735], [5, 336855], [9, 336995], [16, 337315], [24, 337875], [26, 338195], [33, 338515], [35, 338655], [44, 339135], [47, 339315], [55, 340535], [62, 340915], [70, 341235], [73, 341515]]}, {"verse": 41, "start": 342521, "end": 347384, "text": "Y a cualquiera que te obligue a llevar carga por una milla, ve con él dos.", "words": [[0, 342521], [2, 342677], [4, 342757], [15, 343127], [19, 343497], [22, 343617], [30, 344117], [32, 344177], [39, 344457], [45, 344937], [49, 345257], [53, 345437], [60, 346077], [63, 346177], [67, 346437], [70, 346936]]}, {"verse": 42, "start": 347834, "end": 353114, "text": "Al que te pida, dale; y al que quiera tomar de ti prestado, no se lo rehúses.", "words": [[0, 347834], [3, 348003], [7, 348143], [10, 348323], [16, 348683], [22, 349512], [24, 349638], [27, 349738], [31, 350018], [38, 350298], [44, 350578], [47, 350818], [50, 350978], [60, 351618], [63, 351838], [66, 352038], [69, 352612]]}, {"verse": 43, "start": 353564, "end": 359100, "text": "Oísteis que fue dicho: Amarás a tu prójimo, y odiarás a tu enemigo.", "words": [[0, 353564], [8, 354352], [12, 354512], [16, 354712], [23, 355628], [30, 356115], [32, 356215], [35, 356335], [44, 357475], [46, 357675], [54, 358195], [56, 358275], [59, 358415]]}, {"verse": 44, "start": 359550, "end": 371823, "text": "Pero yo os digo: Amad a vuestros enemigos, bendecid a los que os maldicen, haced bien a los que os aborrecen, y orad por los que os maltratan y os persiguen;", "words": [[0, 359550], [5, 359692], [8, 359972], [11, 360172], [17, 360979], [22, 361380], [24, 361560], [33, 361980], [43, 363540], [52, 364100], [54, 364500], [58, 364640], [62, 364780], [65, 364880], [75, 366020], [81, 366320], [86, 366600], [88, 366940], [92, 367060], [96, 367160], [99, 367320], [110, 368440], [112, 368500], [117, 368860], [121, 369380], [125, 369580], [129, 369780], [132, 369920], [142, 370680], [144, 370880], [147, 370980]]}, {"verse": 45, "start": 372273, "end": 382446, "text": "Para que seáis hijos de vuestro Padre que está en los cielos: que hace que su sol salga sobre malos y buenos, y llueve sobre justos e injustos.", "words": [[0, 372273], [5, 372439], [9, 372599], [15, 373039], [21, 373499], [24, 373779], [32, 374139], [38, 374479], [42, 374719], [47, 374939], [50, 375119], [54, 375239], [62, 376139], [66, 376262], [71, 376482], [75, 376682], [78, 376842], [82, 377142], [88, 377662], [94, 377942], [100, 378522], [102, 378662], [110, 379082], [112, 379862], [119, 380242], [125, 380502], [132, 381362], [134, 381502]]}, {"verse": 46, "start": 382896, "end": 390681, "text": "Porque si amáis a los que os aman, ¿qué recompensa tendréis? ¿No hacen también lo mismo los publicanos?", "words": [[0, 382896], [7, 383118], [10, 383378], [16, 383898], [18, 384298], [22, 384418], [26, 384598], [29, 384778], [35, 385638], [40, 385818], [51, 386918], [61, 388103], [65, 388251], [71, 388531], [79, 388931], [82, 389151], [88, 389451], [92, 389671]]}, {"verse": 47, "start": 391131, "end": 397894, "text": "Y si saludáis solamente a vuestros hermanos, ¿qué hacéis de más? ¿no hacen también así los Gentiles?", "words": [[0, 391131], [2, 391278], [5, 391378], [14, 392098], [24, 392478], [26, 392898], [35, 393258], [45, 393958], [50, 394238], [57, 394738], [60, 394838], [65, 395622], [69, 395789], [75, 396089], [83, 396569], [87, 396889], [91, 397069]]}, {"verse": 48, "start": 398344, "end": 403822, "text": "Sed, pues, vosotros perfectos, como vuestro Padre que está en los cielos es perfecto.", "words": [[0, 398459], [5, 398609], [11, 398949], [20, 399769], [31, 400649], [36, 401049], [44, 401489], [50, 401929], [54, 402049], [59, 402229], [62, 402349], [66, 402489], [73, 402889], [76, 403009]]}]}