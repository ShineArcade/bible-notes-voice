{"book": "MAT", "chapter": 4, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 207112, "verses": [{"verse": 1, "start": 300, "end": 6722, "text": "Entonces Jesús fue llevado del Espíritu al desierto, para ser tentado del diablo.", "words": [[0, 300], [9, 901], [15, 1621], [19, 2261], [27, 2701], [31, 2901], [40, 3501], [43, 3601], [53, 4221], [58, 4901], [62, 5161], [70, 5761], [74, 6001]]}, {"verse": 2, "start": 7172, "end": 12264, "text": "Y habiendo ayunado cuarenta días y cuarenta noches, después tuvo hambre.", "words": [[0, 7172], [2, 7452], [11, 7792], [19, 8312], [28, 8832], [33, 9312], [35, 9552], [44, 9792], [52, 10792], [60, 11132], [65, 11512]]}, {"verse": 3, "start": 12714, "end": 19377, "text": "Y acercándose a él el tentador, dijo: Si eres Hijo de Dios, di que estas piedras se hagan pan.", "words": [[0, 12714], [2, 13053], [14, 13993], [16, 14153], [19, 14353], [22, 14513], [32, 15053], [38, 15936], [41, 16139], [46, 16299], [51, 16559], [54, 16739], [60, 17159], [63, 17579], [67, 17719], [73, 17919], [81, 18459], [84, 18639], [90, 18879]]}, {"verse": 4, "start": 19727, "end": 28558, "text": "Pero él respondiendo, dijo: Escrito está: No con solo el pan vivirá el hombre, sino con toda palabra que sale de la boca de Dios.", "words": [[0, 19727], [5, 19878], [8, 20198], [22, 21078], [28, 21964], [36, 22469], [42, 23273], [45, 23399], [49, 23599], [54, 23939], [57, 24139], [61, 24379], [68, 24959], [71, 25099], [79, 25479], [84, 25719], [88, 26019], [93, 26179], [101, 26579], [105, 26859], [110, 27159], [113, 27339], [116, 27459], [121, 27679], [124, 27919]]}, {"verse": 5, "start": 29008, "end": 34373, "text": "Entonces el diablo lo llevó a la santa ciudad y lo puso en lo alto del templo,", "words": [[0, 29008], [9, 29549], [12, 29989], [19, 30489], [22, 30689], [28, 31109], [30, 31209], [33, 31289], [39, 31589], [46, 32229], [48, 32349], [51, 32489], [56, 32869], [59, 33049], [62, 33209], [67, 33469], [71, 33709]]}, {"