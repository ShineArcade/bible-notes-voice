{"book": "GEN", "chapter": 33, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 168472, "verses": [{"verse": 1, "start": 300, "end": 12786, "text": "Y alzando Jacob sus ojos miró, y he aquí venía Esaú, y los cuatrocientos hombres con él: entonces repartió él los niños entre Lea y Raquel y las dos siervas.", "words": [[0, 300], [2, 425], [10, 985], [16, 1345], [20, 1705], [25, 2005], [31, 3005], [33, 3145], [36, 3285], [41, 3485], [47, 3935], [53, 4385], [55, 4845], [59, 5185], [73, 5525], [81, 6165], [85, 6485], [89, 7081], [98, 7979], [107, 8699], [110, 8979], [114, 9159], [120, 9519], [126, 9999], [130, 10599], [132, 10779], [139, 11239], [141, 11699], [145, 11839], [149, 11999]]}, {"verse": 2, "start": 13136, "end": 21255, "text": "Y puso las siervas y sus niños delante; luego a Lea y a sus niños; y a Raquel y a José los últimos.", "words": [[0, 13136], [2, 13280], [7, 13680], [11, 13840], [19, 14380], [21, 14540], [25, 14720], [31, 15080], [40, 16079], [46, 16498], [48, 16952], [52, 17405], [54, 17665], [56, 17765], [60, 17885], [67, 18968], [69, 19257], [71, 19377], [78, 19737], [80, 19977], [82, 20057], [87, 20297], [91, 20811]]}, {"verse": 3, "start": 21605, "end": 28429, "text": "Y él pasó delante de ellos, y se inclinó a tierra siete veces, hasta que llegó a su hermano.", "words": [[0, 21605], [2, 21766], [5, 21906], [10, 22306], [18, 22966], [21, 23166], [28, 23486], [30, 23911], [33, 24341], [41, 24771], [43, 24911], [50, 25211], [56, 25651], [63, 26251], [69, 26931], [73, 27131], [79, 27431], [81, 27631], [84, 27811]]}, {"verse": 4, "start": 28779, "end": 35895, "text": "Y Esaú corrió a su encuentro, y le abrazó, y se echó sobre su cuello, y le besó; y lloraron.", "words": [[0, 28779], [2, 29030], [7, 29320], [14, 29740], [16, 29900], [19, 30020], [30, 31000], [32, 31140], [35, 31260], [43, 32000], [45, 32280], [48, 32440], [53, 32820], [59, 33100], [62, 33300], [70, 33800], [72, 34200], [75, 34320], [81, 34999], [83, 35130]]}, {"verse": 5, "start": 36245, "end": 45310, "text": "Y alzó sus ojos, y vio las mujeres y los niños, y dijo: ¿Quiénes son estos? Y él respondió: Son los niños que Dios ha dado a tu siervo.", "words": [[0, 36245], [2, 36489], [7, 36869], [11, 37029], [17, 37389], [19, 37849], [23, 38009], [27, 38149], [35, 38529], [37, 38749], [41, 38889], [48, 39469], [50, 39569], [56, 40519], [65, 40817], [69, 41114], [76, 41675], [78, 41857], [81, 41997], [92, 42992], [96, 43214], [100, 43394], [106, 43674], [110, 43934], [115, 44154], [118, 44354], [123, 44594], [125, 44674], [128, 44774]]}, {"verse": 6, "start": 45590, "end": 49776, "text": "Y se llegaron las siervas, ellas y sus niños, y se inclinaron.", "words": [[0, 45590], [2, 45697], [5, 45817], [14, 46297], [18, 46497], [27, 47017], [33, 47397], [35, 47657], [39, 47817], [46, 48257], [48, 48597], [51, 48737]]}, {"verse": 7, "start": 50126, "end": 58917, "text": "Y Lea se acercó con sus niños, y se inclinaron: y después llegó José y Raquel, y también se inclinaron.", "words": [[0, 50295], [2, 50495], [6, 50695], [9, 50935], [16, 51575], [20, 51735], [24, 51955], [31, 52375], [33, 52915], [36, 53055], [48, 54356], [50, 54494], [58, 54854], [64, 55494], [69, 55974], [71, 56464], [79, 56954], [81, 57234], [89, 57514], [92, 57894]]}, {"verse": 8, "start": 59267, "end": 67360, "text": "Y él dijo: ¿Qué te propones con todas estas cuadrillas que he encontrado? Y él respondió: El hallar gracia en los ojos de mi señor.", "words": [[0, 59267], [2, 59455], [5, 59615], [11, 60334], [16, 60415], [19, 60555], [28, 61075], [32, 61315], [38, 61595], [44, 61915], [55, 62535], [59, 62735], [62, 62795], [74, 63769], [76, 63951], [79, 64091], [90, 65086], [93, 65228], [100, 65508], [107, 65988], [110, 66088], [114, 66208], [119, 66468], [122, 66708], [125, 66788]]}, {"verse": 9, "start": 67640, "end": 72280, "text": "Y dijo Esaú: Bastante tengo yo, hermano mío: sea para ti lo que es tuyo.", "words": [[0, 67640], [2, 67802], [7, 68298], [13, 68924], [22, 69326], [28, 69586], [32, 69766], [40, 70146], [45, 70676], [49, 70875], [54, 71095], [57, 71335], [60, 71575], [64, 71715], [67, 71875]]}, {"verse": 10, "start": 72560, "end": 85162, "text": "Y dijo Jacob: No, yo te ruego, si he hallado ahora gracia en tus ojos, acepta el regalo que te ofrezco, pues que así he visto tu rostro, como si hubiera visto el rostro de Dios; y me has recibido con favor.", "words": [[0, 72560], [2, 72688], [7, 72928], [14, 73692], [18, 74059], [21, 74099], [24, 74239], [31, 74979], [34, 75159], [37, 75319], [45, 75719], [51, 76019], [58, 76499], [61, 76599], [65, 76739], [71, 77459], [78, 77899], [81, 77979], [88, 78319], [92, 78479], [95, 78599], [104, 79459], [109, 79559], [113, 79719], [117, 79939], [120, 80099], [126, 80339], [129, 80519], [137, 81311], [142, 81452], [145, 81612], [153, 81852], [159, 82112], [162, 82272], [169, 82652], [172, 82752], [178, 83443], [180, 83549], [183, 83649], [187, 83869], [196, 84409], [200, 84589]]}, {"verse": 11, "start": 85512, "end": 94440, "text": "Toma, te ruego, mi dádiva que te es traída; porque Dios me ha hecho merced, y todo lo que hay aquí es mío. Y insistió con él, y la tomó.", "words": [[0, 85656], [6, 85842], [9, 86029], [16, 86609], [19, 86769], [26, 87189], [30, 87369], [33, 87682], [36, 87996], [44, 88494], [51, 88677], [56, 88977], [59, 89257], [62, 89397], [68, 89597], [76, 90057], [78, 90277], [83, 90497], [86, 90717], [90, 90837], [94, 90957], [99, 91197], [102, 91377], [107, 92054], [109, 92215], [118, 92775], [122, 92995], [126, 93235], [128, 93575], [131, 93915]]}, {"verse": 12, "start": 94790, "end": 98361, "text": "Y dijo: Anda, y vamos; y yo iré delante de ti.", "words": [[0, 94790], [2, 94920], [8, 95662], [14, 96041], [16, 96221], [23, 96954], [25, 97077], [28, 97257], [32, 97497], [40, 97877], [43, 98017]]}, {"verse": 13, "start": 98641, "end": 107931, "text": "Y él le dijo: Mi señor sabe que los niños son tiernos, y que tengo ovejas y vacas paridas; y si las fatigan, en un día morirán todas las ovejas.", "words": [[0, 98641], [2, 98808], [5, 98948], [8, 99108], [14, 99833], [17, 99914], [23, 100194], [28, 100534], [32, 100694], [36, 100854], [42, 101094], [46, 101394], [55, 102034], [57, 102434], [61, 102534], [67, 102834], [74, 103314], [76, 103454], [82, 103834], [91, 104705], [93, 104791], [96, 104871], [100, 105011], [109, 105831], [112, 105931], [115, 106071], [119, 106311], [127, 106811], [133, 107011], [137, 107311]]}, {"verse": 14, "start": 108281, "end": 117909, "text": "Pase ahora mi señor delante de su siervo, y yo me iré poco a poco al paso del ganado que va delante de mí, y al paso de los niños, hasta que llegue a mi señor a Seir.", "words": [[0, 108281], [5, 108549], [11, 108789], [14, 108949], [20, 109229], [28, 109709], [31, 109829], [34, 109949], [42, 110629], [44, 110929], [47, 111109], [50, 111249], [54, 111529], [59, 111729], [61, 111889], [66, 112109], [69, 112309], [74, 112549], [78, 112789], [85, 113189], [89, 113329], [92, 113449], [100, 113849], [103, 114009], [107, 114169], [109, 114629], [112, 114749], [117, 114969], [120, 115129], [124, 115249], [131, 116113], [137, 116318], [141, 116478], [148, 116778], [150, 116818], [153, 116971], [159, 117125], [161, 117278]]}, {"verse": 15, "start": 118189, "end": 128976, "text": "Y Esaú dijo: Dejaré ahora contigo de la gente que viene conmigo. Y él dijo: ¿Para qué esto? halle yo gracia en los ojos de mi señor.", "words": [[0, 118189], [2, 118535], [7, 118924], [13, 119451], [20, 119854], [26, 120074], [34, 120574], [37, 120694], [40, 120794], [46, 121014], [50, 121214], [56, 121414], [65, 124741], [67, 124929], [70, 125089], [76, 125808], [82, 125992], [86, 126192], [92, 127006], [98, 127156], [101, 127316], [108, 127736], [111, 127816], [115, 127916], [120, 128176], [123, 128376], [126, 128456]]}, {"verse": 16, "start": 129256, "end": 133044, "text": "Así se volvió Esaú aquel día por su camino a Seir.", "words": [[0, 129256], [4, 129641], [7, 129