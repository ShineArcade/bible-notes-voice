{"book": "ISA", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 221113, "verses": [{"verse": 1, "start": 300, "end": 20379, "text": "Aunque no será esta oscuridad tal como la aflicción que le vino en el tiempo que levemente tocaron la primera vez a la tierra de Zabulón, y a la tierra de Neftalí; y después cuando agravaron por la vía del mar, de esa parte del Jordán, en Galilea de las gentes.", "words": [[0, 300], [7, 537], [10, 777], [15, 1057], [20, 1377], [30, 2197], [34, 2997], [39, 3357], [42, 3557], [52, 4437], [56, 4637], [59, 4817], [64, 5037], [67, 5217], [70, 5377], [77, 5837], [81, 6097], [91, 6697], [99, 7297], [102, 7457], [110, 7817], [114, 8137], [116, 8357], [119, 8457], [126, 8777], [129, 9294], [138, 10110], [140, 10370], [142, 10450], [145, 10530], [152, 10950], [155, 11470], [164, 12717], [166, 12822], [174, 13702], [181, 14022], [191, 14662], [195, 14862], [198, 15062], [202, 15362], [206, 15542], [211, 16222], [214, 16382], [218, 16582], [224, 17022], [228, 17302], [236, 18402], [239, 18602], [247, 19342], [250, 19462], [254, 19582]]}, {"verse": 2, "start": 20829, "end": 31087, "text": "El pueblo que andaba en tinieblas vio gran luz: los que moraban en tierra de sombra de muerte, luz resplandeció sobre ellos.", "words": [[0, 20829], [3, 21110], [10, 21470], [14, 21770], [21, 22210], [24, 22370], [34, 23130], [38, 23570], [43, 23850], [48, 24731], [52, 24875], [56, 25035], [64, 25595], [67, 25775], [74, 26155], [77, 26495], [84, 27055], [87, 27215], [95, 28315], [99, 28635], [112, 30015], [118, 30355]]}, {"verse": 3, "start": 31537, "end": 43233, "text": "Aumentando la gente, no aumentaste la alegría. Se alegrarán delante de ti como se alegran en la siega, como se gozan cuando reparten despojos.", "words": [[0, 31537], [11, 32302], [14, 32522], [21, 33402], [24, 33702], [35, 34422], [38, 34662], [47, 35814], [50, 35997], [60, 36717], [68, 37217], [71, 37397], [74, 37677], [79, 38037], [82, 38277], [90, 38977], [93, 39237], [96, 39697], [103, 40157], [108, 40557], [111, 40737], [117, 41157], [124, 41417], [133, 42177]]}, {"verse": 4, "start": 43683, "end": 52158, "text": "Porque tú quebraste su pesado yugo, y la vara de su hombro, y el cetro de su opresor, como en el día de Madián.", "words": [[0, 43683], [7, 43907], [10, 44167], [20, 44807], [23, 45047], [30, 45607], [36, 46507], [38, 46760], [41, 47014], [46, 47267], [49, 47407], [52, 47627], [60, 48267], [62, 48507], [65, 48667], [71, 49267], [74, 49387], [77, 49607], [86, 50267], [91, 50727], [94, 50887], [97, 51007], [101, 51227], [104, 51716]]}, {"verse": 5, "start": 52608, "end": 62950, "text": "Porque toda batalla de quien pelea es con estruendo, y con revolcamiento de vestidura en sangre: mas esto será para quema, y alimento del fuego.", "words": [[0, 52608], [7, 52832], [12, 53132], [20, 53692], [23, 53872], [29, 54072], [35, 54692], [38, 54892], [42, 55172], [53, 55972], [55, 56572], [59, 57162], [73, 57752], [76, 57992], [86, 58692], [89, 58812], [97, 59752], [101, 60012], [106, 60212], [111, 60572], [116, 60792], [123, 61272], [125, 61712], [134, 62172], [138, 62432]]}, {"verse": 6, "start": 63400, "end": 77043, "text": "Porque un niño nos es nacido, hijo nos es dado; y el principado sobre su hombro: y se llamará su nombre Admirable, Consejero, Dios fuerte, Padre eterno, Príncipe de paz.", "words": [[0, 63400], [7, 63604], [10, 63824], [15, 64144], [19, 64404], [22, 64644], [30, 65684], [35, 66084], [39, 66344], [42, 66584], [48, 67447], [50, 67552], [53, 67692], [64, 68472], [70, 68752], [73, 69012], [81, 69961], [83, 70067], [86, 70187], [94, 70627], [97, 70827], [104, 71227], [115, 72527], [126, 73187], [131, 73487], [139, 74307], [145, 74707], [153, 75767], [162, 76327], [165, 76527]]}, {"verse": 7, "start": 77493, "end": 93568, "text": "Lo dilatado de su imperio y la paz no tendrán límite, sobre el trono de David, y sobre su reino, disponiéndolo y confirmándolo en juicio y en justicia desde ahora para siempre. El celo de Jehová de los ejércitos hará esto.", "words": [[0, 77493], [3, 77644], [12, 78304], [15, 78464], [18, 78644], [26, 79344], [28, 79444], [31, 79584], [35, 79804], [38, 80264], [46, 80704], [54, 81284], [60, 81864], [63, 82084], [69, 82464], [72, 82604], [79, 82924], [81, 83264], [87, 83564], [90, 83804], [97, 84774], [111, 85702], [113, 85922], [127, 86802], [130, 86982], [137, 87482], [139, 87682], [142, 87842], [151, 88542], [157, 89102], [163, 89442], [168, 89682], [177, 90610], [180, 90795], [185, 91335], [188, 91435], [195, 91875], [198, 91955], [202, 92075], [212, 92735], [217, 93055]]}, {"verse": 8, "start": 94018, "end": 97958, "text": "El Señor envió palabra a Jacob, y cayó en Israel.", "words": [[0, 94018], [3, 94376], [9, 94716], [15, 95236], [23, 95386], [25, 95536], [32, 96096], [34, 96576], [39, 97036], [42, 97256]]}, {"verse": 9, "start": 98408, "end": 107823, "text": "Y la sabrá el pueblo, todo él, Efraín y los habitantes de Samaria, que con soberbia y con altivez de corazón dicen:", "words": [[0, 98408], [2, 98606], [5, 98840], [11, 99073], [14, 99173], [22, 100233], [27, 100593], [31, 101233], [38, 101953], [40, 102493], [44, 102653], [55, 103253], [58, 103413], [67, 104233], [71, 104433], [75, 104653], [84, 105373], [86, 105613], [90, 105983], [98, 106353], [101, 106553], [109, 106993]]}, {"verse": 10, "start": 108073, "end": 115131, "text": "Los ladrillos cayeron, pero edificaremos de piedra labrada; cortaron los cabrahigos, mas cedros pondremos en su lugar.", "words": [[0, 108073], [4, 108174], [14, 108694], [23, 109234], [28, 109554], [41, 110214], [44, 110454], [51, 110834], [60, 111706], [69, 112170], [73, 112690], [85, 113210], [89, 113390], [96, 113750], [106, 114290], [109, 114490], [112, 114630]]}, {"verse": 11, "start": 115481, "end": 121155, "text": "Pero Jehová levantará los enemigos de Rezín contra él, y juntará sus enemigos;", "words": [[0, 115481], [5, 115662], [12, 116202], [22, 116842], [26, 117062], [35, 117602], [38, 117912], [44, 118222], [51, 118542], [55, 118942], [57, 119542], [65, 120082], [69, 120302]]}, {"verse": 12, "start": 121605, "end": 133529, "text": "De oriente los sirios, y los filisteos de poniente; y con toda la boca se tragarán a Israel. Ni con todo eso ha cesado su furor, antes todavía su mano extendida.", "words": [[0, 121605], [3, 121769], [11, 122209], [15, 122389], [23, 123009], [25, 123229], [29, 123849], [39, 124469], [42, 124589], [52, 125741], [54, 126021], [58, 126201], [63, 126581], [66, 126821], [71, 127081], [74, 127321], [83, 127941], [85, 128021], [93, 129141], [96, 129270], [100, 129450], [105, 129710], [109, 129970], [112, 130150], [119, 130610], [122, 130810], [129, 131290], [135, 131590], [143, 132050], [146, 132330], [151, 132550]]}, {"verse": 13, "start": 133979, "end": 139986, "text": "Pero el pueblo no se convirtió al que lo hería, ni buscaron a Jehová de los ejércitos.", "words": [[0, 133979], [5, 134143], [8, 134323], [15, 134683], [18, 134923], [21, 135103], [31, 135883], [34, 136063], [38, 136203], [41, 136383], [48, 137203], [51, 137463], [60, 138123], [62, 138243], [69, 138683], [72, 138783], [76, 138943]]}, {"verse": 14, "start": 140436, "end": 145862, "text": "Y Jehová cortará de Israel cabeza y cola, ramo y caña en un mismo día.", "words": [[0, 140436], [2, 140583], [9, 141083], [17, 141663], [20, 141823], [27, 142263], [34, 142663], [36, 142963], [42, 143623], [47, 144283], [49, 144403], [54, 144843], [57, 144983], [60, 145083], [66, 145343]]}, {"verse": 15, "start": 146312, "end": 152701, "text": "El viejo y venerable de rostro es la cabeza: el profeta que enseña mentira, este es cola.", "words": [[0, 146312], [3, 146452], [9, 146872], [11, 146952], [21, 147352], [24, 147752], [31, 148152], [34, 148512], [37, 148812], [45, 149856], [48, 150113], [56, 150593], [60, 150773], [67, 151193], [76, 151793], [81, 152013], [84, 152213]]}, {"verse": 16, "start": 153151, "end": 159221, "text": "Porque los gobernadores de este pueblo son engañadores; y sus gobernados, perdidos.", "words": [[0, 153151], [7, 153375], [11, 153535], [24, 154235], [27, 154455], [32, 154655], [39, 154955], [43, 155375], [56, 157094], [58, 157375], [62, 157495], [74, 158235]]}, {"verse": 17, "start": 159671, "end": 176876, "text": "Por tanto, el Señor no se complacerá en sus jóvenes, ni de sus huérfanos y viudas tendrá misericordia: porque todos son falsos y malignos, y toda boca habla despropósitos. Con todo esto no ha cesado su furor, antes todavía su mano extendida.", "words": [[0, 159671], [4, 159775], [11, 160295], [14, 160415], [20, 160755], [23, 161275], [26, 161435], [37, 162255], [40, 162375], [44, 162515], [53, 162888], [56, 163262], [59, 163635], [63, 163855], [73, 164555], [75, 164875], [82, 165255], [89, 165675], [103, 167122], [110, 167347], [116, 167647], [120, 168007], [127, 168507], [129, 168647], [139, 169327], [141, 169687], [146, 169907], [151, 170287], [157, 171074], [172, 172087], [176, 172191], [181, 172451], [186, 172731], [189, 173031], [192, 173231], [199, 173731], [202, 173911], [209, 174591], [215, 174991], [223, 175511], [226, 175731], [231, 175931]]}, {"verse": 18, "start": 177326, "end": 187870, "text": "Porque la maldad se encendió como fuego, cardos y espinas devorará; y se encenderá en lo espeso de la breña, y serán alzados como humo.", "words": [[0, 177326], [7, 177510], [10, 177730], [17, 178170], [20, 178390], [29, 179010], [34, 179250], [41, 180310], [48, 180930], [50, 181050], [58, 181510], [68, 182611], [70, 182749], [73, 182869], [83, 183669], [86, 183849], [89, 184009], [96, 184649], [99, 184749], [102, 184869], [109, 185409], [111, 185849], [117, 186209], [125, 186889], [130, 187229]]}, {"verse": 19, "start": 188320, "end": 199080, "text": "Por la ira de Jehová de los ejércitos se oscureció la tierra, y será el pueblo como alimento del fuego: el hombre no tendrá piedad de su hermano.", "words": [[0, 188320], [4, 188444], [7, 188684], [11, 188984], [14, 189124], [21, 189644], [24, 189724], [28, 189904], [38, 190744], [41, 191184], [51, 191924], [54, 192084], [62, 192544], [64, 193304], [69, 193564], [72, 193804], [79, 194124], [84, 194504], [93, 195024], [97, 195304], [104, 196270], [107, 196450], [114, 196750], [117, 197190], [124, 197650], [131, 198150], [134, 198310], [137, 198430]]}, {"verse": 20, "start": 199530, "end": 210303, "text": "Cada uno hurtará a la mano derecha, y tendrá hambre; y comerá a la izquierda, y no se saciará: cada cual comerá la carne de su brazo:", "words": [[0, 199530], [5, 199870], [9, 200450], [17, 201030], [19, 201230], [22, 201330], [27, 201590], [36, 202430], [38, 202810], [45, 203270], [53, 204290], [55, 204398], [62, 204878], [64, 205058], [67, 205158], [78, 206178], [80, 206338], [83, 206478], [86, 206658], [95, 207742], [100, 207994], [105, 208314], [112, 208854], [115, 208934], [121, 209294], [124, 209514], [127, 209674]]}, {"verse": 21, "start": 210753, "end": 220713, "text": "Manasés a Efraín, y Efraín a Manasés, y ambos contra Judá. Ni con todo esto ha cesado su furor, antes todavía extendida su mano.", "words": [[0, 210753], [8, 211399], [10, 211679], [18, 212479], [20, 212739], [27, 213339], [29, 213399], [38, 214039], [40, 214279], [46, 214519], [53, 214919], [59, 215827], [62, 215975], [66, 216195], [71, 216515], [76, 216915], [79, 217235], [86, 217695], [89, 217895], [96, 218495], [102, 218655], [110, 219215], [120, 220175], [123, 220275]]}]}