{"book": "PSA", "chapter": 102, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 181479, "verses": [{"verse": 1, "start": 300, "end": 10253, "text": "Oración del pobre, cuando está angustiado, y delante de Jehová derrama su lamento. JEHOVÁ, oye mi oración, y venga mi clamor a ti.", "words": [[0, 300], [8, 808], [12, 1068], [19, 1508], [26, 2008], [31, 2508], [43, 3008], [45, 3588], [53, 4028], [56, 4168], [63, 4658], [71, 5148], [74, 5328], [83, 6747], [91, 7121], [95, 7494], [98, 7594], [107, 8154], [109, 8734], [115, 9114], [118, 9294], [125, 9754], [127, 9874]]}, {"verse": 2, "start": 10703, "end": 20326, "text": "No escondas de mí tu rostro: en el día de mi angustia inclina a mí tu oído; el día que te invoque, apresúrate a responderme.", "words": [[0, 10703], [3, 10894], [12, 11714], [15, 11854], [18, 11974], [21, 12134], [29, 13210], [32, 13355], [35, 13515], [39, 13735], [42, 13935], [45, 14055], [54, 14715], [62, 15555], [64, 15755], [67, 15875], [70, 16115], [76, 17061], [79, 17207], [83, 17427], [87, 17587], [90, 17727], [99, 18667], [110, 19247], [112, 19467]]}, {"verse": 3, "start": 20776, "end": 26302, "text": "Porque mis días se han consumido como humo; y mis huesos cual tizón están quemados.", "words": [[0, 20776], [7, 20981], [11, 21181], [16, 21501], [19, 21861], [23, 22001], [33, 22701], [38, 22961], [44, 23962], [46, 24068], [50, 24188], [57, 24568], [62, 24948], [68, 25328], [74, 25528]]}, {"verse": 4, "start": 26752, "end": 33023, "text": "Mi corazón fue herido, y se secó como la hierba; por lo cual me olvidé de comer mi pan.", "words": [[0, 26752], [3, 26895], [11, 27275], [15, 27635], [23, 28435], [25, 28675], [28, 28795], [33, 29255], [38, 29455], [41, 29635], [49, 30520], [53, 30644], [56, 30804], [61, 31024], [64, 31204], [71, 31724], [74, 31844], [80, 32124], [83, 32404]]}, {"verse": 5, "start": 33473, "end": 37366, "text": "Por la voz de mi gemido mis huesos se han pegado a mi carne.", "words": [[0, 33473], [4, 33615], [7, 33835], [11, 34075], [14, 34255], [17, 34375], [24, 34975], [28, 35055], [35, 35615], [38, 35835], [42, 35995], [49, 36535], [51, 36635], [54, 36735]]}, {"verse": 6, "start": 37816, "end": 42578, "text": "Soy semejante al pelícano del desierto; soy como el búho de las soledades.", "words": [[0, 37816], [4, 38011], [14, 38651], [17, 38791], [26, 39271], [30, 39491], [40, 40582], [44, 40746], [49, 41026], [52, 41206], [57, 41526], [60, 41626], [64, 41766]]}, {"verse": 7, "start": 43028, "end": 46508, "text": "Velo, y soy como el pájaro solitario sobre el tejado.", "words": [[0, 43028], [6, 43672], [8, 43892], [12, 44032], [17, 44292], [20, 44432], [27, 44852], [37, 45282], [43, 45713], [46, 46143]]}, {"verse": 8, "start": 46958, "end": 53886, "text": "Cada día me afrentan mis enemigos; los que se enfurecen contra mí, se han conjurado contra mí.", "words": [[0, 46958], [5, 47100], [9, 47420], [12, 47620], [21, 48200], [25, 48400], [35, 49557], [39, 49864], [43, 50124], [46, 50304], [56, 50944], [63, 51364], [67, 52024], [70, 52284], [74, 52464], [84, 53144], [91, 53504]]}, {"verse": 9, "start": 54336, "end": 59846, "text": "Por lo que como la ceniza a manera de pan, y mi bebida mezclo con lloro,", "words": [[0, 54336], [4, 54459], [7, 54659], [11, 54819], [16, 55119], [19, 55319], [26, 56399], [28, 56459], [35, 56719], [38, 56979], [43, 57639], [45, 57879], [48, 58039], [55, 58499], [62, 59119], [66, 59339]]}, {"verse": 10, "start": 60296, "end": 65923, "text": "A causa de tu enojo y de tu ira; pues me alzaste, y me has arrojado.", "words": [[0, 60296], [2, 60422], [8, 60822], [11, 61122], [14, 61282], [20, 61722], [22, 61822], [25, 61942], [28, 62162], [33, 62936], [38, 63141], [41, 63721], [50, 64421], [52, 64741], [55, 64861], [59, 65081]]}, {"verse": 11, "start": 66373, "end": 71073, "text": "Mis días son como la sombra que se va; y me he secado como la hierba.", "words": [[0, 66373], [4, 66543], [9, 66783], [13, 67083], [18, 67323], [21, 67483], [28, 67903], [32, 68023], [35, 68183], [39, 68928], [41, 69208], [44, 69348], [47, 69448], [54, 69948], [59, 70168], [62, 70348]]}, {"verse": 12, "start": 71523, "end": 78454, "text": "Mas tú, Jehová, permanecerás para siempre, y tu memoria para generación y generación.", "words": [[0, 71523], [4, 71966], [8, 72452], [16, 72939], [29, 73839], [34, 74099], [43, 74739], [45, 75359], [48, 75519], [56, 76019], [61, 76279], [72, 77139], [74, 77399]]}, {"verse": 13, "start": 78904, "end": 88754, "text": "Tú levantándote, tendrás misericordia de Sion; porque el tiempo de tener misericordia de ella, porque el plazo es llegado.", "words": [[0, 78904], [3, 79548], [17, 80928], [25, 81288], [38, 81903], [41, 82519], [47, 83387], [54, 83594], [57, 83754], [64, 83994], [67, 84194], [73, 84474], [86, 85414], [89, 85554], [95, 86214], [102, 86794], [105, 87134], [111, 87634], [114, 87854]]}, {"verse": 14, "start": 89204, "end": 94781, "text": "Porque tus siervos aman sus piedras, y del polvo de ella tienen compasión.", "words": [[0, 89204], [7, 89408], [11, 89668], [19, 90228], [24, 90588], [28, 90888], [37, 91608], [39, 92028], [43, 92208], [49, 92908], [52, 93068], [57, 93268], [64, 93668]]}, {"verse": 15, "start": 95231, "end": 101832, "text": "Entonces temerán las naciones el nombre de Jehová, y todos los reyes de la tierra tu gloria;", "words": [[0, 95231], [9, 95848], [17, 96568], [21, 96768], [30, 97328], [33, 97588], [40, 97928], [43, 98108], [51, 98788], [53, 98988], [59, 99288], [63, 99748], [69, 100208], [72, 100368], [75, 100508], [82, 101088], [85, 101148]]}, {"verse": 16, "start": 102282, "end": 107514, "text": "Por cuanto Jehová habrá edificado a Sion, y en su gloria será visto;", "words": [[0, 102282], [4, 102424], [11, 102724], [18, 103324], [24, 103684], [34, 104297], [36, 104911], [42, 105524], [44, 105784], [47, 105904], [50, 106194], [57, 106484], [62, 106824]]}, {"verse": 17, "start": 107964, "end": 113667, "text": "Habrá mirado a la oración de los solitarios, y no habrá desechado el ruego de ellos.", "words": [[0, 107964], [6, 108287], [13, 108707], [15, 108887], [18, 108987], [26, 109467], [29, 109667], [33, 109787], [45, 110707], [47, 111307], [50, 111467], [56, 111807], [66, 112427], [69, 112567], [75, 112887], [78, 113027]]}, {"verse": 18, "start": 114117, "end": 120234, "text": "Esto se escribirá para la generación venidera: y el pueblo que se criará, alabará a JAH.", "words": [[0, 114117], [5, 114474], [8, 114924], [18, 115374], [23, 115554], [26, 115734], [37, 116374], [47, 117501], [49, 117629], [52, 117769], [59, 118069], [63, 118309], [66, 118469], [74, 119009], [82, 119432], [84, 119854]]}, {"verse": 19, "start": 120684, "end": 125466, "text": "Porque miró de lo alto de su santuario; Jehová miró de los cielos a la tierra,", "words": [[0, 120684], [7, 120865], [12, 121265], [15, 121345], [18, 121485], [23, 121825], [26, 122025], [29, 122165], [40, 123339], [47, 123744], [52, 123984], [55, 124064], [59, 124204], [66, 124664], [68, 124784], [71, 124844]]}, {"verse": 20, "start": 125916, "end": 131974, "text": "Para oír el gemido de los presos, para soltar a los sentenciados a muerte;", "words": [[0, 125916], [5, 126105], [9, 126705], [12, 126945], [19, 127525], [22, 127665], [26, 127765], [34, 128825], [39, 129205], [46, 129865], [48, 130085], [52, 130205], [65, 131145], [67, 131345]]}, {"verse": 21, "start": 132424, "end": 137267, "text": "Porque cuenten en Sion el nombre de Jehová, y su alabanza en Jerusalén,", "words": [[0, 132424], [7, 132784], [15, 133144], [18, 133424], [23, 133704], [26, 134114], [33, 134524], [36, 134644], [44, 135244], [46, 135424], [49, 135604], [58, 136224], [61, 136364]]}, {"verse": 22, "start": 137717, "end": 142744, "text": "Cuando los pueblos y los reinos se congreguen en uno para servir a Jehová.", "words": [[0, 137717], [7, 137901], [11, 138121], [19, 138641], [21, 138761], [25, 138881], [32, 139441], [35, 139641], [46, 140421], [49, 140501], [53, 140761], [58, 141001], [65, 141381], [67, 141601]]}, {"verse": 23, "start": 143194, "end": 147103, "text": "El afligió mi fuerza en el camino; acortó mis días.", "words": [[0, 143194], [3, 143194], [11, 143757], [14, 143897], [21, 144217], [24, 144477], [27, 144597], [35, 146256], [42, 146326], [46, 146466]]}, {"verse": 24, "start": 147553, "end": 154704, "text": "Dije: Dios mío, no me cortes en el medio de mis días: por generación de generaciones son tus años.", "words": [[0, 147553], [6, 148517], [11, 148722], [16, 149102], [19, 149202], [22, 149362], [29, 149902], [32, 150062], [35, 150202], [41, 150502], [44, 150682], [48, 150842], [54, 151766], [58, 151928], [69, 152709], [72, 152868], [85, 153609], [89, 153848], [93, 154068]]}, {"verse": 25, "start": 155154, "end": 160532, "text": "Tú fundaste la tierra antiguamente, y los cielos son obra de tus manos.", "words": [[0, 155154], [3, 155238], [12, 155738], [15, 155918], [22, 156258], [36, 157458], [38, 157998], [42, 158138], [49, 158798], [53, 159158], [58, 159518], [61, 159718], [65, 159838]]}, {"verse": 26, "start": 160982, "end": 171071, "text": "Ellos perecerán, y tú permanecerás; y todos ellos como un vestido se envejecerán; como una ropa de vestir los mudarás, y serán mudados:", "words": [[0, 160982], [6, 161556], [17, 162166], [19, 162406], [22, 162586], [36, 164081], [38, 164200], [44, 164460], [50, 164860], [55, 165180], [58, 165380], [66, 165920], [69, 166140], [82, 167460], [87, 167643], [91, 167843], [96, 168223], [99, 168343], [106, 168803], [110, 168923], [119, 169563], [121, 169903], [127, 170263]]}, {"verse": 27, "start": 171521, "end": 174695, "text": "Pero tú eres el mismo, y tus años no se acabarán.", "words": [[0, 171521], [5, 171666], [8, 171866], [13, 172086], [16, 172286], [23, 172666], [25, 173046], [29, 173186], [34, 173506], [37, 173746], [40, 173886]]}, {"verse": 28, "start": 175145, "end": 181079, "text": "Los hijos de tus siervos habitarán, y su descendencia será afirmada delante de ti.", "words": [[0, 175145], [4, 175330], [10, 175630], [13, 175830], [17, 175990], [25, 176470], [36, 177250], [38, 177690], [41, 177930], [54, 178970], [59, 179310], [68, 180050], [76, 180550], [79, 180710]]}]}