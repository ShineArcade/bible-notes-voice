{"book": "LUK", "chapter": 5, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 354317, "verses": [{"verse": 1, "start": 300, "end": 8297, "text": "Y aconteció, que estando él junto al lago de Genezaret, el gentío se agolpaba sobre él para oír la palabra de Dios.", "words": [[0, 300], [2, 426], [13, 1126], [17, 1386], [25, 1806], [28, 1966], [34, 2186], [37, 2446], [42, 2746], [45, 3436], [56, 4126], [59, 4226], [66, 4846], [69, 5046], [78, 5786], [84, 6086], [87, 6426], [92, 6626], [96, 7026], [99, 7166], [107, 7606], [110, 7746]]}, {"verse": 2, "start": 8747, "end": 17380, "text": "Y vio dos barcos que estaban cerca de la orilla del lago: y los pescadores, habiendo descendido de ellos, lavaban sus redes.", "words": [[0, 8747], [2, 8875], [6, 9075], [10, 9255], [17, 9695], [21, 9855], [29, 10135], [35, 10555], [38, 10815], [41, 10955], [48, 11355], [52, 11515], [58, 12310], [60, 12413], [64, 12573], [76, 13353], [85, 13873], [96, 14693], [99, 14873], [106, 15773], [114, 16433], [118, 16653]]}, {"verse": 3, "start": 17830, "end": 28557, "text": "Y entrado en uno de estos barcos, el cual era de Simón, le rogó que lo desviase de tierra un poco; y sentándose, enseñaba desde el barco a la multitud.", "words": [[0, 17830], [2, 18105], [10, 18625], [13, 18765], [17, 18945], [20, 19085], [26, 19265], [34, 19805], [37, 20065], [42, 20265], [46, 20645], [49, 20825], [56, 21345], [59, 21965], [64, 22465], [68, 22585], [71, 22745], [80, 23305], [83, 23485], [90, 23845], [93, 24085], [99, 24932], [101, 25058], [113, 25898], [122, 26798], [128, 26978], [131, 27218], [137, 27618], [139, 27718], [142, 27798]]}, {"verse": 4, "start": 29007, "end": 36162, "text": "Y como cesó de hablar, dijo a Simón: Ve a aguas profundas, y echad vuestras redes para pescar.", "words": [[0, 29007], [2, 29262], [7, 29482], [12, 29922], [15, 30022], [23, 30862], [28, 31254], [30, 31646], [37, 32274], [40, 32340], [42, 32440], [48, 32760], [59, 33800], [61, 34020], [67, 34440], [76, 34840], [82, 35160], [87, 35520]]}, {"verse": 5, "start": 36612, "end": 44650, "text": "Y respondiendo Simón, le dijo: Maestro, habiendo trabajado toda la noche, nada hemos tomado; pero en tu palabra echaré la red.", "words": [[0, 36612], [2, 36891], [15, 37731], [22, 38111], [25, 38271], [31, 39052], [40, 39609], [49, 39829], [59, 40409], [64, 40589], [67, 40769], [74, 41509], [79, 41689], [85, 41969], [93, 42896], [98, 43060], [101, 43180], [104, 43280], [112, 43620], [119, 44140], [122, 44280]]}, {"verse": 6, "start": 45000, "end": 51274, "text": "Y habiéndolo hecho, encerraron gran multitud de pescado, que su red se rompía.", "words": [[0, 45000], [2, 45164], [13, 45684], [20, 46004], [31, 46884], [36, 47104], [45, 47884], [48, 48124], [57, 48864], [61, 49524], [64, 49744], [68, 50084], [71, 50444]]}, {"verse": 7, "start": 51724, "end": 62967, "text": "E hicieron señas a los compañeros que estaban en el otro barco, que viniesen a ayudarles; y vinieron, y llenaron ambos barcos, de tal manera que se hundían.", "words": [[0, 51724], [2, 52041], [11, 52541], [17, 53281], [19, 53361], [23, 53481], [34, 54181], [38, 54301], [46, 54601], [49, 54861], [52, 55021], [57, 55201], [64, 55981], [68, 56321], [77, 56661], [79, 56941], [90, 58199], [92, 58341], [102, 58841], [104, 59141], [113, 59701], [119, 60101], [127, 60721], [130, 61121], [134, 61441], [141, 61801], [145, 62041], [148, 62201]]}, {"verse": 8, "start": 63417, "end": 71349, "text": "Lo cual viendo Simón Pedro, se derribó de rodillas a Jesús, diciendo: Apártate de mí, Señor, porque soy hombre pecador.", "words": [[0, 63417], [3, 63543], [8, 63723], [15, 64063], [21, 64523], [28, 64983], [31, 65523], [39, 66103], [42, 66223], [51, 66723], [53, 66903], [60, 67243], [70, 68503], [79, 69061], [82, 69221], [86, 69321], [93, 70001], [100, 70201], [104, 70421], [111, 70721]]}, {"verse": 9, "start": 71699, "end": 79185, "text": "Porque temor le había rodeado, y a todos los que estaban con él, de la captura de los peces que habían tomado;", "words": [[0, 71699], [7, 71943], [13, 72463], [16, 72583], [22, 72883], [31, 73603], [33, 74223], [35, 74323], [41, 74623], [45, 74903], [49, 75083], [57, 75423], [61, 75743], [65, 75983], [68, 76643], [71, 76763], [79, 77243], [82, 77383], [86, 77503], [92, 78043], [96, 78263], [103, 78523]]}, {"verse": 10, "start": 79635, "end": 92200, "text": "Y asimismo a Jacobo y a Juan, hijos de Zebedeo, que eran compañeros de Simón. Y Jesús dijo a Simón: No temas: desde ahora pescarás hombres.", "words": [[0, 79635], [2, 80032], [11, 80462], [13, 80762], [20, 81482], [22, 81642], [24, 81722], [30, 82702], [36, 82962], [39, 83742], [48, 84522], [52, 84582], [57, 84842], [68, 85702], [71, 85862], [78, 86890], [80, 87017], [86, 87377], [91, 87897], [93, 88137], [100, 88996], [103, 89143], [110, 90082], [116, 90308], [122, 90848], [131, 91388]]}, {"verse": 11, "start": 92650, "end": 97551, "text": "Y cuando llegaron a tierra los barcos, dejándolo todo, le siguieron.", "words": [[0, 92650], [2, 92738], [9, 92938], [18, 93518], [20, 93638], [27, 93938], [31, 94198], [39, 95158], [49, 95818], [55, 96678], [58, 96778]]}, {"verse": 12, "start": 98001, "end": 112963, "text": "Y aconteció que estando en una ciudad, he aquí un hombre lleno de lepra, el cual viendo a Jesús, postrándose sobre el rostro, le rogó, diciendo: Señor, si quieres, puedes limpiarme.", "words": [[0, 98001], [2, 98122], [12, 98802], [16, 98982], [24, 99342], [27, 99462], [31, 99622], [39, 100382], [42, 100662], [47, 100922], [50, 101102], [57, 101442], [63, 101962], [66, 102082], [73, 102515], [76, 102949], [81, 103382], [88, 103742], [90, 103902], [97, 104662], [109, 105402], [115, 105802], [118, 106002], [126, 107042], [129, 107182], [135, 107762], [145, 108955], [152, 109540], [155, 109540], [164, 110240], [171, 110640]]}, {"verse": 13, "start": 113313, "end": 120728, "text": "Entonces, extendiendo la mano, le tocó diciendo: Quiero: sé limpio. Y luego la lepra se fue de él.", "words": [[0, 113313], [10, 114198], [22, 114938], [25, 115098], [31, 115498], [34, 115558], [39, 115918], [49, 117786], [57, 119440], [60, 119545], [68, 119949], [70, 119949], [76, 119949], [79, 119949], [85, 119949], [88, 119949], [92, 120109], [95, 120249]]}, {"verse": 14, "start": 121178, "end": 133328, "text": "Y él le mandó que no lo dijese a nadie: Pero ve, le dijo, muéstrate al sacerdote, y ofrece por tu limpieza, como mandó Moisés, para testimonio a ellos.", "words": [[0, 121178], [2, 121345], [5, 121485], [8, 121625], [14, 121985], [18, 122125], [21, 122285], [24, 122405], [31, 122865], [33, 123025], [40, 123830], [45, 124186], [49, 124799], [52, 125013], [58, 125840], [68, 126326], [71, 126586], [82, 127346], [84, 127706], [91, 128086], [95, 128366], [98, 128506], [108, 129246], [113, 129826], [119, 130326], [127, 130786], [132, 131606], [143, 132546], [145, 132706]]}, {"verse": 15, "start": 133778, "end": 141167, "text": "Pero tanto más se extendía su fama: y se reunía mucha gente para oír y ser sanadas de sus enfermedades.", "words": [[0, 133778], [5, 134092], [11, 134352], [15, 134712], [18, 134892], [27, 135492], [30, 135672], [36, 136570], [38, 136691], [41, 136811], [48, 137311], [54, 137551], [60, 137951], [65, 138271], [69, 138671], [71, 138871], [75, 139111], [83, 139691], [86, 139851], [90, 139991]]}, {"verse": 16, "start": 141617, "end": 144642, "text": "Pero él se apartaba a los desiertos, y oraba.", "words": [[0, 141617], [5, 141781], [8, 141961], [11, 142101], [20, 142741], [22, 142841], [26, 142961], [37, 143801], [39, 144001]]}, {"verse": 17, "start": 145092, "end": 162110, "text": "Y aconteció un día, que él estaba enseñando, y los fariseos y maestros de la ley estaban sentados, los cuales habían venido de todas las aldeas de Galilea, y de Judea y Jerusalén: y el poder del Señor estaba allí para sanarlos.", "words": [[0, 145092], [2, 145269], [12, 145969], [15, 146149], [20, 146489], [24, 147029], [27, 147389], [34, 147689], [45, 148589], [47, 149229], [51, 149369], [60, 150069], [62, 150189], [71, 150809], [74, 150929], [77, 151069], [81, 151309], [89, 151689], [99, 152989], [103, 153189], [110, 153409], [117, 153849], [124, 154309], [127, 154449], [133, 154709], [137, 155009], [144, 155489], [147, 155589], [156, 156715], [158, 156955], [161, 156995], [167, 157635], [169, 157795], [180, 159032], [182, 159192], [185, 159352], [191, 159692], [195, 159932], [201, 160272], [208, 160692], [213, 160972], [218, 161212]]}, {"verse": 18, "start": 162560, "end": 171670, "text": "Y he aquí unos hombres, que traían sobre un lecho un hombre que estaba paralítico; y buscaban meterle, y ponerle delante de él.", "words": [[0, 162560], [2, 162696], [5, 162866], [10, 163106], [15, 163306], [24, 163786], [28, 164546], [35, 165026], [41, 165306], [44, 165486], [50, 165886], [53, 166186], [60, 166506], [64, 166726], [71, 167006], [83, 168425], [85, 168551], [94, 169031], [103, 169691], [105, 170071], [113, 170651], [121, 171131], [124, 171271]]}, {"verse": 19, "start": 172120, "end": 182665, "text": "Y no hallando por donde meterle a causa de la multitud, subieron encima de la casa, y por el tejado le bajaron con el lecho en medio, delante de Jesús;", "words": [[0, 172120], [2, 172244], [5, 172364], [14, 172784], [18, 173024], [24, 173264], [32, 173964], [34, 174084], [40, 174404], [43, 174604], [46, 174724], [56, 175804], [65, 176384], [72, 176824], [75, 177004], [78, 177144], [84, 178024], [86, 178224], [90, 178384], [93, 178504], [100, 179064], [103, 179184], [111, 179684], [115, 179864], [118, 180044], [124, 180404], [127, 180544], [134, 180964], [142, 181804], [145, 181964]]}, {"verse": 20, "start": 183115, "end": 188922, "text": "El cual, viendo la fe de ellos, le dice: Hombre, tus pecados te son perdonados.", "words": [[0, 183115], [3, 183278], [9, 183918], [16, 184258], [19, 184498], [22, 184678], [25, 184838], [32, 185118], [35, 185478], [41, 186347], [49, 187017], [53, 187177], [61, 187657], [64, 187797], [68, 187977]]}, {"verse": 21, "start": 189372, "end": 199258, "text": "Entonces los escribas y los fariseos comenzaron a pensar, diciendo: ¿Quién es este que habla blasfemias? ¿Quién puede perdonar pecados sino sólo Dios?", "words": [[0, 189372], [9, 189872], [13, 190332], [22, 191012], [24, 191172], [28, 191312], [37, 191952], [48, 192592], [50, 192712], [58, 193212], [68, 194591], [75, 194785], [78, 194925], [83, 195145], [87, 195365], [93, 195585], [105, 196726], [112, 196964], [118, 197164], [127, 197704], [135, 198224], [140, 198444], [145, 198704]]}, {"verse": 22, "start": 199608, "end": 207351, "text": "Jesús entonces, conociendo los pensamientos de ellos, respondiendo les dijo: ¿Qué pensáis en vuestros corazones?", "words": [[0, 199608], [6, 200034], [16, 201214], [27, 201854], [31, 202054], [44, 202734], [47, 202974], [54, 203507], [67, 204041], [71, 204574], [77, 205437], [82, 205540], [90, 205980], [93, 206180], [102, 206520]]}, {"verse": 23, "start": 207801, "end": 214861, "text": "¿Qué es más fácil, decir: Tus pecados te son perdonados, o decir: Levántate y anda?", "words": [[0, 207801], [5, 207923], [8, 208083], [12, 208303], [19, 208743], [26, 210074], [30, 210690], [38, 211250], [41, 211410], [45, 211650], [57, 212410], [59, 212809], [66, 213508], [76, 214146], [78, 214446]]}, {"verse": 24, "start": 215311, "end": 226718, "text": "Pues para que sepáis que el Hijo del hombre tiene potestad en la tierra de perdonar pecados, (dice al paralítico): A ti digo, levántate, toma tu lecho, y vete a tu casa.", "words": [[0, 215311], [5, 215615], [10, 216315], [14, 216475], [21, 217015], [25, 217255], [28, 217415], [33, 217655], [37, 217815], [44, 218115], [50, 218415], [59, 219095], [62, 219215], [65, 219355], [72, 219675], [75, 219895], [84, 220455], [93, 221429], [99, 221817], [102, 222037], [115, 223219], [117, 223424], [120, 223504], [126, 223904], [137, 224684], [142, 224864], [145, 225094], [152, 225324], [154, 225584], [159, 225904], [161, 226044], [164, 226124]]}, {"verse": 25, "start": 227168, "end": 235546, "text": "Y luego, levantándose en presencia de ellos, y tomando aquel en que estaba echado, se fue a su casa, glorificando a Dios.", "words": [[0, 227168], [2, 227313], [9, 227573], [22, 228633], [25, 228833], [35, 229453], [38, 229673], [45, 230493], [47, 230793], [55, 231173], [61, 231533], [64, 231653], [68, 231773], [75, 232073], [83, 232993], [86, 233093], [90, 233273], [92, 233373], [95, 233453], [101, 234213], [114, 234953], [116, 235053]]}, {"verse": 26, "start": 235996, "end": 244206, "text": "Y tomó espanto a todos, y glorificaban a Dios; y fueron llenos de temor, diciendo: Hemos visto maravillas hoy.", "words": [[0, 235996], [2, 236120], [7, 236440], [15, 237060], [17, 237220], [24, 237600], [26, 238160], [39, 238960], [41, 239080], [47, 239856], [49, 239995], [56, 240235], [63, 240675], [66, 240775], [73, 241275], [83, 242573], [89, 242756], [95, 243096], [106, 243716]]}, {"verse": 27, "start": 244556, "end": 254947, "text": "Y después de estas cosas salió, y vio a un recaudador de impuestos llamado Leví, sentado a la mesa de cobro de impuestos, y le dijo: Sígueme.", "words": [[0, 244556], [2, 244678], [10, 244978], [13, 245178], [19, 245378], [25, 245818], [32, 246858], [34, 247118], [38, 247378], [40, 247598], [43, 247778], [54, 248518], [57, 248718], [67, 249298], [75, 249618], [81, 250018], [89, 251218], [91, 251338], [94, 251438], [99, 251678], [102, 251878], [108, 252258], [111, 252418], [122, 253078], [124, 253258], [127, 253358], [133, 254568]]}, {"verse": 28, "start": 255397, "end": 259137, "text": "Y dejadas todas las cosas, levantándose, le siguió.", "words": [[0, 255397], [2, 255512], [10, 255892], [16, 256152], [20, 256432], [27, 256852], [41, 258232], [44, 258532]]}, {"verse": 29, "start": 259587, "end": 269340, "text": "E hizo Leví gran banquete en su casa; y había muchos recaudadores de impuestos y otras personas, los cuales estaban a la mesa con ellos.", "words": [[0, 259587], [2, 259751], [7, 260091], [12, 260431], [17, 260671], [26, 261331], [29, 261511], [32, 261651], [38, 262597], [40, 262723], [46, 262903], [53, 263303], [66, 264223], [69, 264463], [79, 265163], [81, 265703], [87, 265903], [97, 266983], [101, 267083], [108, 267323], [116, 267863], [118, 268063], [121, 268163], [126, 268403], [130, 268663]]}, {"verse": 30, "start": 269790, "end": 279187, "text": "Y los escribas y los fariseos murmuraban contra sus discípulos, diciendo: ¿Por qué coméis y bebéis con los recaudadores de impuestos y pecadores?", "words": [[0, 269790], [2, 269916], [6, 270076], [15, 270736], [17, 270896], [21, 271056], [30, 271776], [41, 272616], [48, 272996], [52, 273296], [64, 274276], [74, 275475], [79, 275602], [83, 275762], [90, 276182], [92, 276322], [99, 276642], [103, 276822], [107, 276942], [120, 277602], [123, 277782], [133, 278242], [135, 278402]]}, {"verse": 31, "start": 279537, "end": 286960, "text": "Y respondiendo Jesús, les dijo: Los que están sanos no necesitan médico, sino los que están enfermos.", "words": [[0, 279537], [2, 279659], [15, 280399], [22, 280799], [26, 281359], [32, 282258], [36, 282531], [40, 282691], [46, 282951], [52, 283431], [55, 283631], [65, 284251], [73, 285251], [78, 285551], [82, 285771], [86, 285891], [92, 286111]]}, {"verse": 32, "start": 287410, "end": 291469, "text": "No he venido a llamar justos, sino pecadores a arrepentimiento.", "words": [[0, 287410], [3, 287580], [6, 287660], [13, 287980], [15, 288060], [22, 288370], [30, 288680], [35, 289080], [45, 289900], [47, 290160]]}, {"verse": 33, "start": 291919, "end": 302493, "text": "Entonces ellos le dijeron: ¿Por qué los discípulos de Juan ayunan muchas veces y hacen oraciones, y asimismo los de los fariseos, y tus discípulos comen y beben?", "words": [[0, 291919], [9, 292358], [15, 292898], [18, 293138], [27, 294149], [32, 294215], [36, 294282], [40, 294502], [51, 295142], [54, 295302], [59, 295642], [66, 296062], [73, 296302], [79, 296742], [81, 297162], [87, 297402], [98, 298422], [100, 298712], [109, 299002], [113, 299222], [116, 299382], [120, 299502], [130, 300362], [132, 300622], [136, 300762], [147, 301502], [153, 301862], [155, 302042]]}, {"verse": 34, "start": 302843, "end": 310026, "text": "Y él les dijo: ¿Podéis hacer que los que están de bodas ayunen, entre tanto que el esposo está con ellos?", "words": [[0, 302843], [2, 303070], [5, 303250], [9, 303450], [15, 304284], [23, 304668], [29, 305148], [33, 305588], [37, 305748], [41, 305908], [47, 306148], [50, 306288], [56, 306648], [64, 307181], [70, 307715], [76, 308248], [80, 308468], [83, 308648], [90, 309068], [95, 309268], [99, 309528]]}, {"verse": 35, "start": 310476, "end": 316943, "text": "Pero vendrán días cuando el esposo les será quitado: entonces ayunarán en aquellos días.", "words": [[0, 310476], [5, 310643], [13, 311143], [18, 311483], [25, 311943], [28, 312183], [35, 312623], [39, 312843], [44, 313083], [53, 314103], [62, 314667], [71, 315687], [74, 315847], [83, 316107]]}, {"verse": 36, "start": 317393, "end": 328933, "text": "Y les decía también una parábola: Nadie mete remiendo de paño nuevo en vestido viejo; de otra manera el nuevo rompe, y al viejo no conviene remiendo nuevo.", "words": [[0, 317393], [2, 317517], [6, 317657], [12, 318077], [20, 318457], [24, 318837], [34, 319892], [40, 320492], [45, 320772], [54, 321472], [57, 321722], [62, 321972], [68, 322272], [71, 322452], [79, 322932], [86, 323809], [89, 323955], [94, 324115], [101, 324515], [104, 324715], [110, 324875], [117, 325575], [119, 325995], [122, 326155], [128, 326695], [131, 327135], [140, 327695], [149, 328315]]}, {"verse": 37, "start": 329383, "end": 340250, "text": "Y nadie echa vino nuevo en odres viejos; de otra manera el vino nuevo romperá los odres, y el vino se derramará, y los odres se perderán.", "words": [[0, 329383], [2, 329530], [8, 329830], [13, 330390], [18, 330790], [24, 331190], [27, 331390], [33, 331770], [41, 332941], [44, 333066], [49, 333226], [56, 333626], [59, 333826], [64, 334006], [70, 334326], [78, 334986], [82, 335146], [89, 335706], [91, 336326], [94, 336446], [99, 336686], [102, 336926], [113, 337626], [115, 338306], [119, 338466], [125, 339086], [128, 339426]]}, {"verse": 38, "start": 340700, "end": 346879, "text": "Pero el vino nuevo en odres nuevos se ha de echar; y lo uno y lo otro se conserva.", "words": [[0, 340700], [5, 340864], [8, 341044], [13, 341284], [19, 341664], [22, 341924], [28, 342344], [35, 342804], [38, 343284], [41, 343444], [44, 343584], [51, 344487], [53, 344610], [56, 344750], [60, 345050], [62, 345510], [65, 345650], [70, 345890], [73, 346090]]}, {"verse": 39, "start": 347329, "end": 353917, "text": "Y ninguno que bebe del añejo, quiere enseguida el nuevo; porque dice: El añejo es mejor.", "words": [[0, 347329], [2, 347447], [10, 347907], [14, 348107], [19, 348447], [23, 348627], [30, 349187], [37, 349847], [47, 350507], [50, 350647], [57, 351474], [64, 351697], [70, 352574], [73, 352739], [79, 353219], [82, 353359]]}]}