{"book": "JHN", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 379390, "verses": [{"verse": 1, "start": 300, "end": 6275, "text": "En el principio era el Verbo, y el Verbo era con Dios, y el Verbo era Dios.", "words": [[0, 300], [3, 467], [6, 567], [16, 1167], [20, 1507], [23, 1667], [30, 2467], [32, 2707], [35, 2847], [41, 3267], [45, 3427], [49, 3647], [55, 4607], [57, 4707], [60, 4887], [66, 5367], [70, 5567]]}, {"verse": 2, "start": 6725, "end": 9371, "text": "Este era en el principio con Dios.", "words": [[0, 6725], [5, 7106], [9, 7386], [12, 7526], [15, 7686], [25, 8266], [29, 8706]]}, {"verse": 3, "start": 9821, "end": 15940, "text": "Todas las cosas por él fueron hechas; y sin él nada de lo que es hecho, fue hecho.", "words": [[0, 9821], [6, 10147], [10, 10327], [16, 10647], [20, 10987], [23, 11127], [30, 11447], [38, 12526], [40, 12649], [44, 12849], [47, 13069], [52, 13449], [55, 13709], [58, 13849], [62, 13989], [65, 14189], [72, 14669], [76, 15349]]}, {"verse": 4, "start": 16390, "end": 20997, "text": "En él estaba la vida, y la vida era la luz de los hombres.", "words": [[0, 16390], [3, 16588], [6, 16868], [13, 17488], [16, 17728], [22, 18368], [24, 18488], [27, 18628], [32, 18848], [36, 19128], [39, 19308], [43, 19688], [46, 20068], [50, 20208]]}, {"verse": 5, "start": 21447, "end": 27351, "text": "Y la luz en las tinieblas resplandece; pero las tinieblas no la comprendieron.", "words": [[0, 21447], [2, 21535], [5, 21675], [9, 21995], [12, 22415], [16, 22575], [26, 23536], [39, 24754], [44, 24900], [48, 25100], [58, 25860], [61, 26140], [64, 26280]]}, {"verse": 6, "start": 27801, "end": 32415, "text": "fue un hombre enviado de Dios, el cual se llamaba Juan.", "words": [[0, 27801], [4, 28131], [7, 28471], [14, 28811], [22, 29511], [25, 29711], [31, 30471], [34, 30691], [39, 30971], [42, 31311], [50, 31791]]}, {"verse": 7, "start": 32865, "end": 39649, "text": "Este vino por testimonio, para que diese testimonio de la luz, para que todos creyesen por él.", "words": [[0, 32865], [5, 33209], [10, 33609], [14, 33869], [26, 34949], [31, 35169], [35, 35449], [41, 35729], [52, 36469], [55, 36549], [58, 36709], [63, 37349], [68, 37749], [72, 37889], [78, 38229], [87, 39049], [91, 39269]]}, {"verse": 8, "start": 40099, "end": 44284, "text": "No era él la luz, sino para que diese testimonio de la luz.", "words": [[0, 40099], [3, 40325], [7, 40605], [10, 40865], [13, 41045], [18, 41665], [23, 41985], [28, 42225], [32, 42455], [38, 42685], [49, 43565], [52, 43665], [55, 43805]]}, {"verse": 9, "start": 44734, "end": 50624, "text": "Aquel era la luz verdadera, que alumbra a todo hombre que viene a este mundo.", "words": [[0, 44904], [6, 45074], [10, 45714], [13, 45894], [17, 46234], [28, 47134], [32, 47434], [40, 47974], [42, 48194], [47, 48414], [54, 49014], [58, 49274], [64, 49614], [66, 49794], [71, 50014]]}, {"verse": 10, "start": 51074, "end": 56808, "text": "En el mundo estaba, y el mundo fue hecho por él; y el mundo no le conoció.", "words": [[0, 51074], [3, 51221], [6, 51361], [12, 51661], [20, 52161], [22, 52701], [25, 52861], [31, 53161], [35, 53441], [41, 53721], [45, 54021], [49, 54710], [51, 54808], [54, 54948], [60, 55328], [63, 55768], [66, 55928]]}, {"verse": 11, "start": 57258, "end": 61466, "text": "A lo suyo vino, y los suyos no le recibieron.", "words": [[0, 57258], [2, 57457], [5, 57557], [10, 58017], [16, 58577], [18, 59097], [22, 59257], [28, 59837], [31, 60167], [34, 60497]]}, {"verse": 12, "start": 61916, "end": 69478, "text": "Pero a todos los que le recibieron, les dio potestad de ser hechos hijos de Dios, a los que creen en su nombre:", "words": [[0, 61916], [5, 62058], [7, 62198], [13, 62578], [17, 62838], [21, 63338], [24, 63838], [36, 64338], [40, 64598], [44, 64798], [53, 65498], [56, 65658], [60, 65878], [67, 66178], [73, 66478], [76, 66678], [82, 67318], [84, 67538], [88, 67678], [92, 67818], [98, 68358], [101, 68638], [104, 68798]]}, {"verse": 13, "start": 69928, "end": 77750, "text": "Los cuales no son engendrados de sangre, ni de voluntad de carne, ni de voluntad de varón, sino de Dios.", "words": [[0, 69928], [4, 70108], [11, 70428], [14, 70968], [18, 71228], [30, 71968], [33, 72148], [41, 73008], [44, 73268], [47, 73408], [56, 73948], [59, 74088], [66, 74868], [69, 75108], [72, 75228], [81, 75808], [84, 75928], [91, 76848], [96, 76948], [99, 77188]]}, {"verse": 14, "start": 78200, "end": 89384, "text": "Y aquel Verbo fue hecho carne, y habitó entre nosotros (y vimos su gloria, gloria como del unigénito del Padre), lleno de gracia y de verdad.", "words": [[0, 78200], [2, 78324], [8, 78644], [14, 79044], [18, 79284], [24, 79564], [31, 80124], [33, 80644], [40, 81064], [46, 81284], [55, 81824], [58, 82224], [64, 82524], [67, 83097], [75, 83671], [82, 84244], [87, 84484], [91, 84724], [101, 85624], [105, 85824], [113, 86804], [119, 87104], [122, 87204], [129, 87724], [131, 87844], [134, 87944]]}, {"verse": 15, "start": 89834, "end": 100875, "text": "Juan dio testimonio de él, y clamó diciendo: Este es del que yo decía: El que viene tras mí, es superior a mí: porque existía antes que yo.", "words": [[0, 89834], [5, 89834], [9, 90118], [20, 91098], [23, 91258], [27, 91558], [29, 91978], [35, 92438], [45, 93415], [50, 93698], [53, 93978], [57, 94138], [61, 94318], [64, 94478], [71, 95400], [74, 95526], [78, 95666], [84, 95866], [89, 96106], [93, 96406], [96, 96926], [105, 97266], [107, 97526], [111, 98067], [118, 98285], [126, 98885], [132, 99165], [136, 99405]]}, {"verse": 16, "start": 101225, "end": 105859, "text": "Porque de su plenitud tomamos todos, y gracia por gracia.", "words": [[0, 101225], [7, 101449], [10, 101609], [13, 101769], [22, 102329], [30, 102909], [37, 103349], [39, 104109], [46, 104849], [50, 105189]]}, {"verse": 17, "start": 106309, "end": 113324, "text": "Porque la ley por Moisés fue dada: pero la gracia y la verdad por Jesucristo fue hecha.", "words": [[0, 106309], [7, 106550], [10, 106730], [14, 106970], [18, 107190], [25, 107690], [29, 108030], [35, 108905], [40, 109049], [43, 109229], [50, 109729], [52, 109809], [55, 109949], [62, 110209], [66, 110729], [77, 111589], [81, 111829]]}, {"verse": 18, "start": 113774, "end": 120972, "text": "A Dios nadie le vio jamás: el unigénito Hijo, que está en el seno del Padre, él le dio a conocer.", "words": [[0, 113774], [2, 113774], [7, 113774], [13, 114354], [16, 114534], [20, 114774], [27, 115790], [30, 115938], [40, 116408], [46, 116878], [50, 117118], [55, 117298], [58, 117438], [61, 117578], [66, 117878], [70, 117978], [77, 119078], [80, 119478], [83, 119838], [87, 120098], [89, 120238]]}, {"verse": 19, "start": 121422, "end": 131460, "text": "Y este es el testimonio de Juan, cuando los judíos enviaron de Jerusalén sacerdotes y levitas, que le preguntasen: ¿Tú, quién eres?", "words": [[0, 121422], [2, 121567], [7, 121847], [10, 122047], [13, 122187], [24, 122867], [27, 122967], [33, 123327], [40, 123967], [44, 124187], [51, 124647], [60, 125147], [63, 125367], [73, 126047], [84, 126927], [86, 127147], [95, 127687], [99, 128147], [102, 128709], [115, 129454], [120, 129594], [126, 129834]]}, {"verse": 20, "start": 131810, "end": 136022, "text": "Y confesó, y no negó; pero declaró: No soy yo el Cristo.", "words": [[0, 131810], [2, 131934], [11, 132654], [13, 132894], [16, 133094], [22, 133846], [27, 134010], [36, 134961], [39, 135088], [43, 135268], [46, 135428], [49, 135528]]}, {"verse": 21, "start": 136372, "end": 146541, "text": "Y le preguntaron: ¿Qué pues? ¿Eres tú Elías? Dijo: No soy. ¿Eres tú el profeta? Y respondió: No.", "words": [[0, 136372], [2, 136496], [5, 136596], [18, 137907], [23, 138007], [29, 138817], [35, 139049], [38, 139409], [45, 140329], [51, 141193], [54, 141397], [59, 142182], [65, 142400], [68, 142660], [71, 142800], [80, 145000], [82, 145147], [93, 146205]]}, {"verse": 22, "start": 146891, "end": 153508, "text": "Le dijeron: ¿Pues quién eres? para que demos respuesta a los que nos enviaron. ¿Qué dices de ti mismo?", "words": [[0, 146891], [3, 146992], [12, 148017], [18, 148146], [24, 148366], [30, 149221], [35, 149384], [39, 149524], [45, 149804], [55, 150344], [57, 150804], [61, 150944], [65, 151084], [69, 151244], [79, 152258], [84, 152360], [90, 152680], [93, 152860], [96, 152980]]}, {"verse": 23, "start": 153858, "end": 160553, "text": "Dijo: Yo soy la voz del que clama en el desierto: Enderezad el camino del Señor, como dijo Isaías profeta.", "words": [[0, 153858], [6, 154722], [9, 154838], [13, 154998], [16, 155138], [20, 155298], [24, 155438], [28, 155578], [34, 155938], [37, 156038], [40, 156118], [50, 157328], [60, 157598], [63, 157758], [70, 158018], [74, 158238], [81, 159078], [86, 159198], [91, 159478], [98, 159918]]}, {"verse": 24, "start": 160903, "end": 164138, "text": "Y los que habían sido enviados eran de los fariseos.", "words": [[0, 160903], [2, 161030], [6, 161190], [10, 161370], [17, 161650], [22, 162010], [31, 162630], [36, 162990], [39, 163210], [43, 163350]]}, {"verse": 25, "start": 164588, "end": 172368, "text": "Y le preguntaron, y le dijeron: ¿Por qué pues bautizas, si tú no eres el Cristo, ni Elías, ni el profeta?", "words": [[0, 164588], [2, 164735], [5, 164795], [18, 165575], [20, 166215], [23, 166295], [32, 167329], [37, 167453], [41, 167773], [46, 168073], [56, 168773], [59, 169153], [62, 169373], [65, 169513], [70, 169753], [73, 169893], [81, 170533], [84, 171013], [91, 171493], [94, 171593], [97, 171693]]}, {"verse": 26, "start": 172718, "end": 181389, "text": "Y Juan les respondió, diciendo: Yo bautizo con agua; pero en medio de vosotros está uno a quien vosotros no conocéis.", "words": [[0, 172718], [2, 172867], [7, 173167], [11, 173727], [22, 174827], [32, 176259], [35, 176397], [43, 176837], [47, 177077], [53, 177811], [58, 177958], [61, 178098], [67, 178298], [70, 178458], [79, 178938], [84, 179258], [88, 179538], [90, 179718], [96, 179858], [105, 180378], [108, 180638]]}, {"verse": 27, "start": 181839, "end": 189133, "text": "Este es el que ha de venir tras mí, el cual es superior a mí: del cual yo no soy digno de desatar la correa del zapato.", "words": [[0, 181839], [5, 182140], [8, 182380], [11, 182540], [15, 182680], [18, 182800], [21, 182880], [27, 183140], [32, 183380], [36, 184000], [39, 184100], [44, 184280], [47, 184480], [56, 184780], [58, 185040], [62, 185565], [66, 185744], [71, 186064], [74, 186364], [77, 186504], [81, 186744], [87, 187244], [90, 187304], [98, 187784], [101, 188024], [108, 188424], [112, 188584]]}, {"verse": 28, "start": 189483, "end": 195507, "text": "Estas cosas acontecieron en Betábara, del otro lado del Jordán, donde Juan bautizaba.", "words": [[0, 189483], [6, 189792], [12, 190052], [25, 190992], [28, 191522], [38, 192052], [42, 192152], [47, 192392], [52, 192712], [56, 192932], [64, 193792], [70, 193972], [75, 194392]]}, {"verse": 29, "start": 195957, "end": 203821, "text": "El siguiente día ve Juan a Jesús que venía a él, y dice: He aquí el Cordero de Dios, que quita el pecado del mundo.", "words": [[0, 195957], [3, 196117], [13, 196417], [17, 196817], [20, 197017], [25, 197297], [27, 197537], [33, 197837], [37, 198237], [43, 198697], [45, 198937], [49, 199217], [51, 199537], [57, 200603], [60, 200747], [65, 201027], [68, 201147], [76, 201567], [79, 201687], [85, 202287], [89, 202347], [95, 202667], [98, 202767], [105, 203127], [109, 203307]]}, {"verse": 30, "start": 204271, "end": 211570, "text": "Este es del que dije: Tras mí viene un varón, el cual es superior a mí: porque existía antes que yo.", "words": [[0, 204271], [5, 204530], [8, 204690], [12, 204850], [16, 204970], [22, 205735], [27, 205997], [30, 206077], [36, 206337], [39, 206457], [46, 207157], [49, 207237], [54, 207437], [57, 207657], [66, 207937], [68, 208177], [72, 208762], [79, 208980], [87, 209580], [93, 209860], [97, 210100]]}, {"verse": 31, "start": 212020, "end": 217543, "text": "Y yo no le conocía; pero para que fuese manifestado a Israel, por eso vine yo bautizando con agua.", "words": [[0, 212020], [2, 212127], [5, 212267], [8, 212387], [11, 212487], [20, 213490], [25, 213610], [30, 213830], [34, 213990], [40, 214290], [52, 214950], [54, 215030], [62, 215630], [66, 215670], [70, 215870], [75, 216110], [78, 216310], [89, 216930], [93, 217130]]}, {"verse": 32, "start": 217893, "end": 225732, "text": "Y Juan dio testimonio, diciendo: Vi al Espíritu que descendía del cielo como paloma, y reposó sobre él.", "words": [[0, 217893], [2, 218014], [7, 218314], [11, 219054], [23, 220034], [33, 221206], [36, 221360], [39, 221513], [48, 222113], [52, 222213], [62, 222773], [66, 222933], [72, 223293], [77, 223573], [85, 224093], [87, 224653], [94, 225113], [100, 225353]]}, {"verse": 33, "start": 226182, "end": 239273, "text": "Y yo no le conocía; pero el que me envió a bautizar con agua, aquel me dijo: Sobre quien veas descender el Espíritu, y que reposa sobre él, este es el que bautiza con Espíritu Santo.", "words": [[0, 226182], [2, 226289], [5, 226429], [8, 226549], [11, 226649], [20, 227652], [25, 227780], [28, 227880], [32, 228000], [35, 228120], [41, 228420], [43, 228520], [52, 228960], [56, 229180], [62, 229780], [68, 230080], [71, 230180], [77, 231960], [83, 232243], [89, 232523], [94, 233003], [104, 233543], [107, 233683], [117, 234363], [119, 234743], [123, 234883], [130, 235363], [136, 235683], [140, 236283], [145, 236603], [148, 236923], [151, 237163], [155, 237303], [163, 237863], [167, 238083], [176, 238663]]}, {"verse": 34, "start": 239723, "end": 244471, "text": "Y yo le vi, y he dado testimonio que este es el Hijo de Dios.", "words": [[0, 239723], [2, 239841], [5, 240001], [8, 240141], [12, 240341], [14, 240901], [17, 241001], [22, 241201], [33, 241981], [37, 242121], [42, 242421], [45, 242661], [48, 242801], [53, 243021], [56, 243161]]}, {"verse": 35, "start": 244821, "end": 249910, "text": "El siguiente día otra vez estaba Juan, y dos de sus discípulos.", "words": [[0, 244821], [3, 245000], [13, 245380], [17, 245880], [22, 246180], [26, 246520], [33, 246760], [39, 247240], [41, 247940], [45, 248260], [48, 248680], [52, 248900]]}, {"verse": 36, "start": 250360, "end": 255874, "text": "Y mirando a Jesús que andaba por allí, dijo: He aquí el Cordero de Dios.", "words": [[0, 250360], [2, 250600], [10, 250980], [12, 251120], [18, 251380], [22, 251700], [29, 252040], [33, 252300], [39, 253220], [45, 254073], [48, 254214], [53, 254514], [56, 254774], [64, 255194], [67, 255314]]}, {"verse": 37, "start": 256224, "end": 260110, "text": "Y le oyeron los dos discípulos hablar, y siguieron a Jesús.", "words": [[0, 256224], [2, 256345], [5, 256465], [12, 256885], [16, 257065], [20, 257285], [31, 257965], [39, 258345], [41, 258805], [51, 259345], [53, 259465]]}, {"verse": 38, "start": 260560, "end": 271451, "text": "Y volviéndose Jesús, y viéndolos seguirle, les dice: ¿Qué buscáis? Y ellos le dijeron: Rabí (que traducido quiere decir Maestro) ¿dónde te hospedas?", "words": [[0, 260560], [2, 260648], [14, 261228], [21, 261948], [23, 262218], [33, 262488], [43, 262958], [47, 263428], [53, 264314], [58, 264415], [67, 265613], [69, 266069], [75, 266289], [78, 266509], [87, 267817], [92, 268127], [97, 268287], [107, 268867], [114, 269087], [120, 269427], [129, 270407], [136, 270647], [139, 270787]]}, {"verse": 39, "start": 271801, "end": 280723, "text": "Les dice: Venid y ved. Vinieron, y vieron donde moraba, y se quedaron con él aquel día: porque era como la hora de las diez.", "words": [[0, 271801], [4, 271989], [10, 272979], [16, 273486], [18, 273726], [23, 274485], [33, 275012], [35, 275272], [42, 275572], [48, 275792], [56, 276412], [58, 276612], [61, 276752], [70, 277192], [74, 277392], [77, 277552], [83, 277852], [88, 278588], [95, 278833], [99, 279053], [104, 279293], [107, 279513], [112, 279733], [115, 279893], [119, 280308]]}, {"verse": 40, "start": 281173, "end": 288406, "text": "Era Andrés, hermano de Simón Pedro, uno de los dos que habían oído de Juan, y le habían seguido.", "words": [[0, 281173], [4, 281437], [12, 282077], [20, 282757], [23, 282837], [29, 283377], [36, 284657], [40, 284997], [43, 285157], [47, 285337], [51, 285577], [55, 285797], [62, 286077], [67, 286417], [70, 286597], [76, 286877], [78, 287377], [81, 287497], [88, 287737]]}, {"verse": 41, "start": 288856, "end": 295409, "text": "Este halló primero a su hermano Simón, y le dijo: Hemos hallado al Mesías (que traducido es, el Cristo).", "words": [[0, 288856], [5, 289102], [11, 289362], [19, 289662], [21, 289862], [24, 289962], [32, 290402], [39, 290802], [41, 291002], [44, 291122], [50, 291949], [56, 292149], [64, 292549], [67, 292669], [74, 293716], [79, 293800], [89, 294460], [93, 294580], [96, 294740]]}, {"verse": 42, "start": 295859, "end": 306125, "text": "Y le trajo a Jesús. Y mirándole Jesús, dijo: Tú eres Simón, hijo de Jonás: tú serás llamado Cefas (que quiere decir, Piedra).", "words": [[0, 295859], [2, 296024], [5, 296224], [11, 296424], [13, 296504], [20, 297412], [22, 297529], [32, 298009], [39, 298409], [45, 299573], [48, 299717], [53, 299957], [60, 301057], [65, 301257], [68, 301437], [75, 302367], [78, 302449], [84, 302789], [92, 303155], [98, 303822], [103, 304242], [110, 304622], [117, 305062]]}, {"verse": 43, "start": 306575, "end": 313227, "text": "El siguiente día quiso Jesús ir a Galilea, y halla a Felipe, al cual dijo: Sígueme.", "words": [[0, 306624], [3, 306704], [13, 307064], [17, 307524], [23, 308064], [29, 308524], [32, 308944], [34, 309044], [43, 310004], [45, 310284], [51, 310564], [53, 310764], [61, 311424], [64, 311524], [69, 311704], [75, 312610]]}, {"verse": 44, "start": 313677, "end": 317572, "text": "Y era Felipe de Betsaida, la ciudad de Andrés y de Pedro.", "words": [[0, 313677], [2, 313774], [6, 313914], [13, 314254], [16, 314934], [26, 315614], [29, 315694], [36, 315974], [39, 316274], [46, 316694], [48, 316914], [51, 317014]]}, {"verse": 45, "start": 318022, "end": 327178, "text": "Felipe halló a Natanael, y le dice: Hemos hallado a aquel de quien escribió Moisés en la ley, y los profetas: a Jesús, el hijo de José, de Nazaret.", "words": [[0, 318022], [7, 318412], [13, 318834], [15, 319256], [25, 319678], [27, 320100], [30, 320522], [36, 321194], [42, 321362], [50, 321562], [52, 321762], [58, 322022], [61, 322122], [67, 322242], [76, 322702], [83, 323002], [86, 323182], [89, 323282], [94, 323502], [96, 323882], [100, 324002], [110, 325014], [112, 325113], [119, 325713], [122, 325793], [127, 325993], [130, 326073], [136, 326393], [139, 326573]]}, {"verse": 46, "start": 327528, "end": 334106, "text": "Y le dijo Natanael: ¿De Nazaret puede haber algo de bueno? Le dice Felipe: Ven y ve.", "words": [[0, 327528], [2, 327665], [5, 327765], [10, 328548], [20, 329582], [24, 329727], [32, 330287], [38, 330527], [44, 330747], [49, 331007], [52, 331167], [59, 332021], [62, 332169], [67, 332389], [75, 333541], [79, 333743], [81, 333946]]}, {"verse": 47, "start": 334456, "end": 342264, "text": "Jesús vio venir a sí a Natanael, y dijo de él: He aquí un verdadero israelita, en el cual no hay engaño.", "words": [[0, 334456], [6, 334784], [10, 335264], [16, 335944], [18, 336254], [21, 336564], [23, 336744], [33, 336924], [35, 337204], [40, 337484], [43, 337684], [47, 338308], [50, 338628], [55, 338908], [58, 339068], [68, 339608], [79, 340728], [82, 340848], [85, 340968], [90, 341148], [93, 341408], [97, 341588]]}, {"verse": 48, "start": 342714, "end": 352202, "text": "Le dice Natanael: ¿De dónde me conoces? Respondió Jesús, y le dijo: Antes que Felipe te llamara, cuando estabas debajo de la higuera te vi.", "words": [[0, 342714], [3, 343138], [8, 343593], [18, 344271], [22, 344431], [28, 344571], [31, 344811], [40, 346167], [50, 346457], [57, 346757], [59, 347017], [62, 347137], [68, 347945], [74, 348425], [78, 348585], [85, 348905], [88, 349185], [97, 349665], [104, 350165], [112, 350625], [119, 350985], [122, 351165], [125, 351285], [133, 351611], [136, 351938]]}, {"verse": 49, "start": 352652, "end": 358390, "text": "Respondió Natanael, y le dijo: Rabí, tú eres el Hijo de Dios; tú eres el Rey de Israel.", "words": [[0, 352652], [10, 353281], [20, 353941], [22, 354141], [25, 354221], [31, 355193], [37, 355413], [40, 355513], [45, 355733], [48, 355913], [53, 356093], [56, 356213], [62, 357033], [65, 357175], [70, 357355], [73, 357575], [77, 357735], [80, 357855]]}, {"verse": 50, "start": 358740, "end": 366592, "text": "Respondió Jesús y le dijo: ¿Porque te dije, te vi debajo de la higuera, crees? cosas mayores que estas verás.", "words": [[0, 358740], [10, 359244], [16, 359564], [18, 359824], [21, 359944], [27, 360658], [35, 360863], [38, 361083], [44, 361323], [47, 361563], [50, 361803], [57, 362243], [60, 362383], [63, 362503], [72, 363083], [79, 363988], [85, 364172], [93, 364752], [97, 364952], [103, 365172]]}, {"verse": 51, "start": 367042, "end": 378990, "text": "Y le dice: De cierto, de cierto os digo: De aquí en adelante veréis el cielo abierto, y los ángeles de Dios que suben y descienden sobre el Hijo del hombre.", "words": [[0, 367226], [2, 367409], [5, 367593], [11, 368253], [14, 368465], [22, 368677], [25, 368889], [32, 369101], [35, 369441], [41, 370357], [44, 370526], [49, 370846], [52, 371066], [61, 371486], [68, 372026], [71, 372226], [77, 372566], [86, 373286], [88, 373966], [92, 374146], [100, 374686], [103, 374906], [108, 375246], [112, 375746], [118, 376366], [120, 376586], [131, 377246], [137, 377666], [140, 377946], [145, 378206], [149, 378406]]}]}