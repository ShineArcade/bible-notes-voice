{"book": "PSA", "chapter": 89, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 295662, "verses": [{"verse": 1, "start": 300, "end": 7105, "text": "I will sing of the mercies of the LORD for ever: with my mouth will I make known your faithfulness to all generations.", "words": [[0, 300], [2, 460], [7, 620], [12, 920], [15, 1100], [19, 1220], [27, 1700], [30, 1840], [34, 1940], [39, 2302], [43, 2665], [49, 3263], [54, 3390], [57, 3590], [63, 3890], [68, 4110], [70, 4250], [75, 4470], [81, 4750], [86, 4970], [99, 5630], [102, 5790], [106, 6030]]}, {"verse": 2, "start": 7555, "end": 14119, "text": "For I have said, Mercy shall be built up for ever: your faithfulness shall you establish in the very heavens.", "words": [[0, 7555], [4, 7661], [6, 7861], [11, 8001], [17, 8301], [23, 8901], [29, 9261], [32, 9421], [38, 9681], [41, 10003], [45, 10325], [51, 10873], [56, 10996], [69, 11796], [75, 12176], [79, 12336], [89, 12796], [92, 13096], [96, 13216], [101, 13436]]}, {"verse": 3, "start": 14419, "end": 18805, "text": "I have made a covenant with my chosen, I have sworn to David my servant,", "words": [[0, 14419], [2, 14556], [7, 14676], [12, 14876], [14, 14976], [23, 15336], [28, 15656], [31, 15856], [39, 16616], [41, 16876], [46, 16996], [52, 17296], [55, 17496], [61, 17756], [64, 17976]]}, {"verse": 4, "start": 19255, "end": 25243, "text": "Your seed will I establish for ever, and build up your throne to all generations. Selah.", "words": [[0, 19255], [5, 19376], [10, 19716], [15, 19936], [17, 20076], [27, 20383], [31, 20689], [37, 20996], [41, 21576], [47, 21796], [50, 21956], [55, 22076], [62, 22396], [65, 22616], [69, 22856], [82, 24679]]}, {"verse": 5, "start": 25593, "end": 31550, "text": "And the heavens shall praise your wonders, O LORD: your faithfulness also in the congregation of the saints.", "words": [[0, 25593], [4, 25734], [8, 25834], [16, 26114], [22, 26494], [29, 26854], [34, 27114], [43, 27694], [45, 27774], [51, 28539], [56, 28646], [69, 29246], [74, 29626], [77, 29886], [81, 29986], [94, 30486], [97, 30806], [101, 30926]]}, {"verse": 6, "start": 32000, "end": 37732, "text": "For who in the heaven can be compared to the LORD? who among the sons of the mighty can be likened to the LORD?", "words": [[0, 32000], [4, 32121], [8, 32321], [11, 32481], [15, 32581], [22, 32801], [26, 33041], [29, 33181], [38, 33581], [41, 33741], [45, 33861], [51, 34716], [55, 34796], [61, 35016], [65, 35276], [70, 35556], [73, 35776], [77, 35876], [84, 36156], [88, 36416], [91, 36576], [99, 37016], [102, 37116], [106, 37236]]}, {"verse": 7, "start": 38182, "end": 45311, "text": "God is greatly to be feared in the assembly of the saints, and to be had in reverence of all them that are about him.", "words": [[0, 38182], [4, 38482], [7, 38702], [15, 39042], [18, 39282], [21, 39402], [28, 39702], [31, 39902], [35, 40022], [44, 40422], [47, 40642], [51, 40762], [59, 41462], [63, 41722], [66, 41862], [69, 41982], [73, 42222], [76, 42382], [86, 42902], [89, 43062], [93, 43242], [98, 43482], [103, 43762], [107, 43922], [113, 44182]]}, {"verse": 8, "start": 45761, "end": 52000, "text": "O LORD God of hosts, who is a strong LORD like to you? or to your faithfulness round about you?", "words": [[0, 45761], [2, 45928], [7, 46208], [11, 46508], [14, 46688], [21, 47528], [25, 47728], [28, 47868], [30, 47988], [37, 48368], [42, 48708], [47, 48928], [50, 49168], [55, 49906], [58, 50011], [61, 50191], [66, 50331], [79, 50951], [85, 51231], [91, 51531]]}, {"verse": 9, "start": 52450, "end": 57037, "text": "You rule the raging of the sea: when the waves of it arise, you still them.", "words": [[0, 52450], [4, 52638], [9, 52978], [13, 53158], [20, 53538], [23, 53738], [27, 53878], [32, 54601], [37, 54730], [41, 54870], [47, 55150], [50, 55390], [53, 55490], [60, 56170], [64, 56250], [70, 56550]]}, {"verse": 10, "start": 57487, "end": 63707, "text": "You have broken Rahab in pieces, as one that is slain; you have scattered your enemies with your strong arm.", "words": [[0, 57487], [4, 57614], [9, 57734], [16, 58034], [22, 58634], [25, 58754], [33, 59554], [36, 59774], [40, 59974], [45, 60134], [48, 60254], [55, 61124], [59, 61251], [64, 61351], [74, 61731], [79, 61971], [87, 62331], [92, 62631], [97, 62751], [104, 63091]]}, {"verse": 11, "start": 64157, "end": 70678, "text": "The heavens are yours, the earth also is yours: as for the world and the fulness of it, you have founded them.", "words": [[0, 64157], [4, 64263], [12, 64563], [16, 64803], [23, 65403], [27, 65483], [33, 65703], [38, 66083], [41, 66363], [48, 67268], [51, 67453], [55, 67653], [59, 67773], [65, 68173], [69, 68353], [73, 68573], [81, 68793], [84, 69153], [88, 69553], [92, 69653], [97, 69813], [105, 70213]]}, {"verse": 12, "start": 71128, "end": 76632, "text": "The north and the south you have created them: Tabor and Hermon shall rejoice in your name.", "words": [[0, 71128], [4, 71214], [10, 71474], [14, 71694], [18, 71814], [24, 72154], [28, 72394], [33, 72554], [41, 72974], [47, 73915], [53, 74085], [57, 74325], [64, 74825], [70, 75085], [78, 75545], [81, 75945], [86, 76085]]}, {"verse": 13, "start": 77082, "end": 81887, "text": "You have a mighty arm: strong is your hand, and high is your right hand.", "words": [[0, 77082], [4, 77210], [9, 77390], [11, 77510], [18, 77790], [23, 78696], [30, 79022], [33, 79282], [38, 79422], [44, 80222], [48, 80302], [53, 80642], [56, 80942], [61, 81102], [67, 81342]]}, {"verse": 14, "start": 82337, "end": 89041, "text": "Justice and judgment are the habitation of your throne: mercy and truth shall go before your face.", "words": [[0, 82337], [8, 82897], [12, 83157], [21, 83537], [25, 83857], [29, 83977], [40, 84577], [43, 84817], [48, 84937], [56, 86425], [62, 86763], [66, 87083], [72, 87343], [78, 87663], [81, 87863], [88, 88203], [93, 88423]]}, {"verse": 15, "start": 89491, "end": 95159, "text": "Blessed is the people that know the joyful sound: they shall walk, O LORD, in the light of your countenance.", "words": [[0, 89491], [8, 89695], [11, 89995], [15, 90135], [22, 90395], [27, 90635], [32, 90775], [36, 90915], [43, 91295], [50, 92273], [55, 92382], [61, 92582], [67, 93142], [69, 93242], [75, 93682], [78, 93782], [82, 93882], [88, 94122], [91, 94242], [96, 94382]]}, {"verse": 16, "start": 95609, "end": 101393, "text": "In your name shall they rejoice all the day: and in your righteousness shall they be exalted.", "words": [[0, 95609], [3, 95756], [8, 95976], [13, 96356], [19, 96756], [24, 96936], [32, 97356], [36, 97796], [40, 97956], [45, 98721], [49, 98844], [52, 98984], [57, 99124], [71, 99704], [77, 100264], [82, 100444], [85, 100624]]}, {"verse": 17, "start": 101843, "end": 107031, "text": "For you are the glory of their strength: and in your favour our horn shall be exalted.", "words": [[0, 101843], [4, 101951], [8, 102191], [12, 102331], [16, 102451], [22, 102871], [25, 103051], [31, 103191], [41, 104208], [45, 104332], [48, 104492], [53, 104892], [60, 105292], [64, 105472], [69, 105852], [75, 106132], [78, 106312]]}, {"verse": 18, "start": 107481, "end": 111351, "text": "For the LORD is our defence; and the Holy One of Israel is our king.", "words": [[0, 107481], [4, 107578], [8, 107698], [13, 107958], [16, 108138], [20, 108603], [29, 109293], [33, 109439], [37, 109519], [42, 109759], [46, 109999], [49, 110119], [56, 110499], [59, 110719], [63, 110879]]}, {"verse": 19, "start": 111801, "end": 120810, "text": "Then you spoke in vision to your holy one, and said, I have laid help upon one that is mighty; I have exalted one chosen out of the people.", "words": [[0, 111801], [5, 112005], [9, 112185], [15, 112485], [18, 112725], [25, 113005], [28, 113225], [33, 113385], [38, 113625], [43, 113985], [47, 114265], [53, 115039], [55, 115201], [60, 115361], [65, 115581], [70, 115861], [75, 116201], [79, 116561], [84, 116841], [87, 116961], [95, 118108], [97, 118253], [102, 118373], [110, 118833], [114, 119173], [121, 119533], [125, 119833], [128, 119913], [132, 119993]]}, {"verse": 20, "start": 121260, "end": 126166, "text": "I have found David my servant; with my holy oil have I anointed him:", "words": [[0, 121260], [2, 121408], [7, 121548], [13, 121828], [19, 122148], [22, 122388], [31, 123579], [36, 123699], [39, 123879], [44, 124179], [48, 124579], [53, 124879], [55, 125039], [64, 125379]]}, {"verse": 21, "start": 126616, "end": 131420, "text": "With whom my hand shall be established: my arm also shall strengthen him.", "words": [[0, 126616], [5, 126787], [10, 127007], [13, 127247], [18, 127507], [24, 127707], [27, 127867], [40, 129227], [43, 129352], [47, 129692], [52, 130012], [58, 130292], [69, 130692]]}, {"verse": 22, "start": 131870, "end": 136518, "text": "The enemy shall not exact upon him; nor the son of wickedness afflict him.", "words": [[0, 131870], [4, 131974], [10, 132214], [16, 132514], [20, 132694], [26, 133034], [31, 133374], [36, 134373], [40, 134497], [44, 134677], [48, 134897], [51, 134997], [62, 135477], [70, 135697]]}, {"verse": 23, "start": 136968, "end": 141494, "text": "And I will beat down his foes before his face, and plague them that hate him.", "words": [[0, 136968], [4, 137090], [6, 137230], [11, 137370], [16, 137610], [21, 137910], [25, 138150], [30, 138570], [37, 138830], [41, 139090], [47, 139430], [51, 139890], [58, 140210], [63, 140450], [68, 140630], [73, 140850]]}, {"verse": 24, "start": 141944, "end": 147850, "text": "But my faithfulness and my mercy shall be with him: and in my name shall his horn be exalted.", "words": [[0, 141944], [4, 142048], [7, 142208], [20, 142888], [24, 143048], [27, 143188], [33, 143508], [39, 143768], [42, 143908], [47, 144148], [52, 145034], [56, 145184], [59, 145305], [62, 145525], [67, 145824], [73, 146124], [77, 146305], [82, 146604], [85, 146824]]}, {"verse": 25, "start": 148300, "end": 152161, "text": "I will set his hand also in the sea, and his right hand in the rivers.", "words": [[0, 148300], [2, 148419], [7, 148539], [11, 148739], [15, 148899], [20, 149159], [25, 149519], [28, 149759], [32, 149859], [37, 150159], [41, 150459], [45, 150599], [51, 150799], [56, 151059], [59, 151259], [63, 151359]]}, {"verse": 26, "start": 152611, "end": 158078, "text": "He shall cry to me, You are my father, my God, and the rock of my salvation.", "words": [[0, 152611], [3, 152694], [9, 152834], [13, 153134], [16, 153354], [20, 154183], [24, 154368], [28, 154528], [31, 154748], [39, 155488], [42, 155588], [47, 156308], [51, 156468], [55, 156568], [60, 156908], [63, 157208], [66, 157388]]}, {"verse": 27, "start": 158378, "end": 162312, "text": "Also I will make him my firstborn, higher than the kings of the earth.", "words": [[0, 158378], [5, 158937], [7, 159037], [12, 159157], [17, 159417], [21, 159597], [24, 159797], [35, 160517], [42, 160777], [47, 161017], [51, 161137], [57, 161377], [60, 161597], [64, 161717]]}, {"verse": 28, "start": 162762, "end": 167819, "text": "My mercy will I keep for him for evermore, and my covenant shall stand fast with him.", "words": [[0, 162762], [3, 162907], [9, 163287], [14, 163567], [16, 163707], [21, 163907], [25, 164127], [29, 164527], [33, 164927], [43, 165327], [47, 165507], [50, 165667], [59, 166007], [65, 166307], [71, 166607], [76, 166927], [81, 167207]]}, {"verse": 29, "start": 168269, "end": 172986, "text": "His seed also will I make to endure for ever, and his throne as the days of heaven.", "words": [[0, 168269], [4, 168377], [9, 168657], [14, 168977], [19, 169217], [21, 169317], [26, 169497], [29, 169657], [36, 170030], [40, 170404], [46, 170777], [50, 171137], [54, 171277], [61, 171527], [64, 171777], [68, 171917], [73, 172137], [76, 172277]]}, {"verse": 30, "start": 173436, "end": 177335, "text": "If his children forsake my law, and walk not in my judgments;", "words": [[0, 173436], [3, 173572], [7, 173692], [16, 174032], [24, 174512], [27, 174692], [32, 175012], [36, 175532], [41, 175792], [45, 176052], [48, 176232], [51, 176372]]}, {"verse": 31, "start": 177785, "end": 181174, "text": "If they break my statutes, and keep not my commandments;", "words": [[0, 177785], [3, 177909], [8, 178049], [14, 178229], [17, 178429], [27, 179069], [31, 179549], [36, 179749], [40, 179989], [43, 180169]]}, {"verse": 32, "start": 181624, "end": 185654, "text": "Then will I visit their transgression with the rod, and their iniquity with stripes.", "words": [[0, 181624], [5, 181782], [10, 181942], [12, 182062], [18, 182302], [24, 182502], [38, 183082], [43, 183342], [47, 183462], [52, 183702], [56, 184022], [62, 184142], [71, 184602], [76, 184782]]}, {"verse": 33, "start": 186104, "end": 191649, "text": "Nevertheless my lovingkindness will I not utterly take from him, nor allow my faithfulness to fail.", "words": [[0, 186104], [13, 186715], [16, 187185], [31, 187655], [36, 187835], [38, 187955], [42, 188135], [50, 188495], [55, 188815], [60, 189035], [65, 189615], [69, 189735], [75, 190035], [78, 190215], [91, 190755], [94, 190895]]}, {"verse": 34, "start": 192099, "end": 196134, "text": "My covenant will I not break, nor alter the thing that is gone out of my lips.", "words": [[0, 192099], [3, 192199], [12, 192539], [17, 192799], [19, 192899], [23, 193059], [30, 193679], [34, 193819], [40, 194119], [44, 194299], [50, 194519], [55, 194649], [58, 194779], [63, 194979], [67, 195179], [70, 195259], [73, 195379]]}, {"verse": 35, "start": 196584, "end": 200105, "text": "Once have I sworn by my holiness that I will not lie to David.", "words": [[0, 196584], [5, 196773], [10, 196953], [12, 197073], [18, 197353], [21, 197653], [24, 197813], [33, 198233], [38, 198513], [40, 198633], [45, 198753], [49, 198953], [53, 199173], [56, 199313]]}, {"verse": 36, "start": 200555, "end": 204666, "text": "His seed shall endure for ever, and his throne as the sun before me.", "words": [[0, 200555], [4, 200663], [9, 201003], [15, 201263], [22, 201643], [26, 202023], [32, 202403], [36, 202643], [40, 202803], [47, 203123], [50, 203363], [54, 203503], [58, 203703], [65, 203963]]}, {"verse": 37, "start": 205116, "end": 211117, "text": "It shall be established for ever as the moon, and as a faithful witness in heaven. Selah.", "words": [[0, 205116], [3, 205240], [9, 205420], [12, 205560], [24, 205887], [28, 206213], [33, 206540], [36, 206840], [40, 206980], [46, 207260], [50, 207800], [53, 207960], [55, 208060], [64, 208420], [72, 208820], [75, 209080], [83, 210482]]}, {"verse": 38, "start": 211467, "end": 215586, "text": "But you have cast off and abhorred, you have been angry with your anointed.", "words": [[0, 211467], [4, 211556], [8, 211696], [13, 211796], [18, 212116], [22, 212516], [26, 212756], [36, 213616], [40, 213776], [45, 213896], [50, 214036], [56, 214476], [61, 214756], [66, 214896]]}, {"verse": 39, "start": 216036, "end": 222357, "text": "You have made void the covenant of your servant: you have profaned his crown by casting it to the ground.", "words": [[0, 216036], [4, 216354], [9, 216494], [14, 216674], [19, 217094], [23, 217474], [32, 217814], [35, 218074], [40, 218194], [49, 219139], [53, 219419], [58, 219539], [67, 220159], [71, 220279], [77, 220619], [80, 220919], [88, 221339], [91, 221539], [94, 221659], [98, 221759]]}, {"verse": 40, "start": 222807, "end": 227616, "text": "You have broken down all his hedges; you have brought his strong holds to ruin.", "words": [[0, 222807], [4, 222933], [9, 223093], [16, 223413], [21, 223753], [25, 224093], [29, 224333], [37, 225287], [41, 225410], [46, 225550], [54, 225830], [58, 226203], [65, 226577], [71, 226950], [74, 227050]]}, {"verse": 41, "start": 228066, "end": 232789, "text": "All that pass by the way spoil him: he is a reproach to his neighbours.", "words": [[0, 228066], [4, 228413], [9, 228653], [14, 229013], [17, 229353], [21, 229493], [25, 229653], [31, 230073], [36, 230850], [39, 230976], [42, 231156], [44, 231256], [53, 231776], [56, 231956], [60, 232409]]}, {"verse": 42, "start": 233239, "end": 238713, "text": "You have set up the right hand of his adversaries; you have made all his enemies to rejoice.", "words": [[0, 233239], [4, 233412], [9, 233632], [13, 233872], [16, 234032], [20, 234172], [26, 234432], [31, 234772], [34, 234952], [38, 235092], [51, 236397], [55, 236520], [60, 236680], [65, 236860], [69, 237160], [73, 237360], [81, 237720], [84, 237980]]}, {"verse": 43, "start": 239163, "end": 243923, "text": "You have also turned the edge of his sword, and have not made him to stand in the battle.", "words": [[0, 239163], [4, 239308], [9, 239468], [14, 239768], [21, 240108], [25, 240308], [30, 240588], [33, 240708], [37, 240908], [44, 241348], [48, 241888], [53, 242048], [57, 242248], [62, 242548], [66, 242708], [69, 242848], [75, 243148], [78, 243348], [82, 243448]]}, {"verse": 44, "start": 244373, "end": 248326, "text": "You have made his glory to cease, and cast his throne down to the ground.", "words": [[0, 244373], [4, 244498], [9, 244658], [14, 244858], [18, 245078], [24, 245458], [27, 245678], [34, 245978], [38, 246358], [43, 246658], [47, 246898], [54, 247178], [59, 247498], [62, 247658], [66, 247758]]}, {"verse": 45, "start": 248776, "end": 253663, "text": "The days of his youth have you shortened: you have covered him with shame. Selah.", "words": [[0, 248776], [4, 248866], [9, 249166], [12, 249366], [16, 249546], [22, 249826], [27, 250066], [31, 250226], [42, 251153], [46, 251277], [51, 251417], [59, 251717], [63, 251957], [68, 252137], [75, 253332]]}, {"verse": 46, "start": 254113, "end": 259220, "text": "How long, LORD? will you hide yourself for ever? shall your wrath burn like fire?", "words": [[0, 254113], [4, 254296], [10, 254696], [16, 255407], [21, 255571], [25, 255731], [30, 255971], [39, 256323], [43, 256675], [49, 257322], [55, 257541], [60, 257741], [66, 258021], [71, 258381], [76, 258601]]}, {"verse": 47, "start": 259670, "end": 263970, "text": "Remember how short my time is: why have you made all men in vain?", "words": [[0, 259670], [9, 259959], [13, 260239], [19, 260599], [22, 260819], [27, 261159], [31, 262005], [35, 262213], [40, 262413], [44, 262533], [49, 262733], [53, 262933], [57, 263193], [60, 263393]]}, {"verse": 48, "start": 264420, "end": 270972, "text": "What man is he that lives, and shall not see death? shall he deliver his soul from the hand of the grave? Selah.", "words": [[0, 264420], [5, 264587], [9, 264847], [12, 265027], [15, 265187], [20, 265367], [27, 265707], [31, 265987], [37, 266187], [41, 266407], [45, 266647], [52, 267349], [58, 267489], [61, 267669], [69, 268029], [73, 268269], [78, 268629], [83, 268849], [87, 269029], [92, 269269], [95, 269369], [99, 269489], [106, 270669]]}, {"verse": 49, "start": 271422, "end": 276101, "text": "Lord, where are your former lovingkindnesses, which you swore to David in your truth?", "words": [[0, 271422], [6, 272086], [12, 272326], [16, 272546], [21, 272706], [28, 273426], [46, 274146], [52, 274346], [56, 274526], [62, 274866], [65, 274966], [71, 275266], [74, 275466], [79, 275586]]}, {"verse": 50, "start": 276551, "end": 283890, "text": "Remember, Lord, the reproach of your servants; how I do bear in my bosom the reproach of all the mighty people;", "words": [[0, 276551], [10, 277016], [16, 277516], [20, 277616], [29, 278136], [32, 278256], [37, 278356], [47, 279305], [51, 279485], [53, 279765], [56, 280025], [61, 280425], [64, 280745], [67, 280945], [73, 281505], [77, 281665], [86, 282365], [89, 282565], [93, 282845], [97, 283005], [104, 283285]]}, {"verse": 51, "start": 284340, "end": 290963, "text": "With which your enemies have reproached, O LORD; with which they have reproached the footsteps of your anointed.", "words": [[0, 284340], [5, 284499], [11, 284699], [16, 284899], [24, 285339], [29, 285659], [41, 286519], [43, 286639], [49, 287465], [54, 287634], [60, 287874], [65, 288094], [70, 288274], [81, 288914], [85, 289114], [95, 289514], [98, 289994], [103, 290174]]}, {"verse": 52, "start": 291413, "end": 295262, "text": "Blessed be the LORD for evermore. Amen, and Amen.", "words": [[0, 291413], [8, 291596], [11, 291976], [15, 292156], [20, 292641], [24, 293125], [34, 293849], [40, 294194], [44, 294614]]}]}