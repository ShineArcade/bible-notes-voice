{"book": "PSA", "chapter": 51, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 122467, "verses": [{"verse": 1, "start": 300, "end": 9127, "text": "Have mercy upon me, O God, according to your lovingkindness: according to the multitude of your tender mercies blot out my transgressions.", "words": [[0, 300], [5, 450], [11, 850], [16, 1250], [20, 1670], [22, 1850], [27, 2510], [37, 2730], [40, 2990], [45, 3635], [61, 4580], [71, 4869], [74, 5129], [78, 5249], [88, 5729], [91, 6049], [96, 6189], [103, 6529], [111, 7249], [116, 7609], [120, 7789], [123, 7989]]}, {"verse": 2, "start": 9577, "end": 14144, "text": "Wash me thoroughly from my iniquity, and cleanse me from my sin.", "words": [[0, 9577], [5, 10037], [8, 10317], [19, 10697], [24, 11077], [27, 11357], [37, 11997], [41, 12437], [49, 12737], [52, 13077], [57, 13297], [60, 13557]]}, {"verse": 3, "start": 14594, "end": 19299, "text": "For I acknowledge my transgressions: and my sin is ever before me.", "words": [[0, 14594], [4, 14699], [6, 14959], [18, 15399], [21, 15719], [37, 17122], [41, 17304], [44, 17524], [48, 17944], [51, 18304], [56, 18544], [63, 18904]]}, {"verse": 4, "start": 19749, "end": 28829, "text": "Against you, you only, have I sinned, and done this evil in your sight: that you might be justified when you speak, and be clear when you judge.", "words": [[0, 19749], [8, 20005], [13, 20365], [17, 20485], [23, 21345], [28, 21485], [30, 21645], [38, 22225], [42, 22485], [47, 22765], [52, 23005], [57, 23325], [60, 23585], [65, 23725], [72, 24494], [77, 24671], [81, 24871], [87, 25091], [90, 25291], [100, 25791], [105, 26231], [109, 26391], [116, 26711], [120, 27331], [123, 27511], [129, 27851], [134, 28111], [138, 28271]]}, {"verse": 5, "start": 29279, "end": 34494, "text": "Behold, I was shapen in iniquity; and in sin did my mother conceive me.", "words": [[0, 29279], [8, 29786], [10, 29866], [14, 30136], [21, 30406], [24, 30686], [34, 31659], [38, 31824], [41, 31984], [45, 32324], [49, 32664], [52, 32864], [59, 33104], [68, 33544]]}, {"verse": 6, "start": 34945, "end": 40975, "text": "Behold, you desire truth in the inward parts: and in the hidden part you shall make me to know wisdom.", "words": [[0, 34945], [8, 35512], [12, 35552], [19, 35972], [25, 36432], [28, 36772], [32, 36892], [39, 37132], [46, 38158], [50, 38323], [53, 38483], [57, 38603], [64, 38823], [69, 39183], [73, 39423], [79, 39603], [84, 39823], [87, 40003], [90, 40143], [95, 40323]]}, {"verse": 7, "start": 41425, "end": 46953, "text": "Purge me with hyssop, and I shall be clean: wash me, and I shall be whiter than snow.", "words": [[0, 41425], [6, 41766], [9, 41906], [14, 42106], [22, 42726], [26, 42826], [28, 43006], [34, 43166], [37, 43326], [44, 44212], [49, 44442], [53, 44922], [57, 45042], [59, 45262], [65, 45502], [68, 45722], [75, 46182], [80, 46402]]}, {"verse": 8, "start": 47403, "end": 52789, "text": "Make me to hear joy and gladness; that the bones which you have broken may rejoice.", "words": [[0, 47403], [5, 47606], [8, 47826], [11, 47986], [16, 48146], [20, 48646], [24, 48926], [34, 50049], [39, 50169], [43, 50309], [49, 50689], [55, 50949], [59, 51129], [64, 51269], [71, 51649], [75, 51929]]}, {"verse": 9, "start": 53239, "end": 57095, "text": "Hide your face from my sins, and blot out all my iniquities.", "words": [[0, 53239], [5, 53439], [10, 53699], [15, 53979], [20, 54179], [23, 54399], [29, 55359], [33, 55379], [38, 55739], [42, 55879], [46, 56139], [49, 56319]]}, {"verse": 10, "start": 57545, "end": 62247, "text": "Create in me a clean heart, O God; and renew a right spirit within me.", "words": [[0, 57661], [7, 57815], [10, 57968], [13, 58248], [15, 58388], [21, 58668], [28, 59288], [30, 59368], [35, 60233], [39, 60375], [45, 60675], [47, 60855], [53, 61095], [60, 61495], [67, 61835]]}, {"verse": 11, "start": 62697, "end": 68638, "text": "Cast me not away from your presence; and take not your holy spirit from me.", "words": [[0, 62697], [5,