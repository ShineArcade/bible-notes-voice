{"book": "MRK", "chapter": 2, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 255441, "verses": [{"verse": 1, "start": 300, "end": 6008, "text": "Y entró otra vez en Capernaum después de algunos días, y se supo que estaba en casa.", "words": [[0, 300], [2, 468], [8, 908], [13, 1228], [17, 1528], [20, 2008], [30, 2488], [38, 2948], [41, 3168], [49, 3448], [55, 3888], [57, 4263], [60, 4383], [65, 4783], [69, 4943], [76, 5223], [79, 5423]]}, {"verse": 2, "start": 6358, "end": 13693, "text": "Y luego se juntaron a él muchos, que ya no cabían ni aun a la puerta; y les predicaba la palabra.", "words": [[0, 6358], [2, 6641], [8, 6901], [11, 7181], [20, 7861], [22, 8021], [25, 8161], [33, 8941], [37, 9161], [40, 9321], [43, 9441], [50, 9841], [53, 10241], [57, 10501], [59, 10741], [62, 10841], [70, 11743], [72, 11922], [76, 12122], [86, 12757], [89, 12917]]}, {"verse": 3, "start": 14043, "end": 19650, "text": "Entonces vinieron a él unos que traían a un paralítico entre cuatro personas.", "words": [[0, 14043], [9, 14705], [18, 15545], [20, 15725], [23, 15945], [28, 16265], [32, 16465], [39, 16945], [41, 17045], [44, 17185], [55, 17945], [61, 18225], [68, 18585]]}, {"verse": 4, "start": 20000, "end": 31671, "text": "Y como no podían llegar a él a causa de tanta gente, descubrieron el techo de donde estaba, y haciendo abertura, bajaron la camilla donde estaba acostado el paralítico.", "words": [[0, 20000], [2, 20121], [7, 20321], [10, 20501], [17, 20961], [24, 21261], [26, 21521], [29, 21721], [31, 21941], [37, 22241], [40, 22481], [46, 22661], [53, 23201], [66, 24461], [69, 24641], [75, 25061], [78, 25201], [84, 25361], [92, 25801], [94, 26261], [103, 26661], [113, 27741], [121, 28301], [124, 28501], [132, 29041], [138, 29581], [145, 30061], [154, 30661], [157, 30801]]}, {"verse": 5, "start": 32021, "end": 39039, "text": "Y viendo Jesús la fe de ellos, dice al paralítico: Hijo, tus pecados te son perdonados.", "words": [[0, 32021], [2, 32155], [9, 32495], [15, 32955], [18, 33515], [21, 33715], [24, 33915], [31, 34795], [36, 35155], [39, 35375], [51, 36487], [57, 37115], [61, 37235], [69, 37715], [72, 37875], [76, 38055]]}, {"verse": 6, "start": 39389, "end": 45482, "text": "Y estaban allí sentados algunos de los escribas, los cuales pensando en sus corazones,", "words": [[0, 39389], [2, 39649], [10, 39969], [15, 40269], [24, 40989], [32, 41429], [35, 41669], [39, 41789], [49, 42729], [53, 42829], [60, 43129], [69, 44029], [72, 44369], [76, 44569]]}, {"verse": 7, "start": 45832, "end": 52326, "text": "Decían: ¿Por qué habla este así? Blasfemias dice. ¿Quién puede perdonar pecados, sino solo Dios?", "words": [[0, 45832], [8, 47059], [13, 47201], [17, 47381], [23, 47601], [28, 47821], [33, 48793], [44, 49123], [50, 49836], [57, 50014], [63, 50194], [72, 50714], [81, 51214], [86, 51434], [91, 51714]]}, {"verse": 8, "start": 52606, "end": 61960, "text": "Y conociendo luego Jesús en su espíritu que pensaban así dentro de sí mismos, les dijo: ¿Por qué pensáis estas cosas en vuestros corazones?", "words": [[0, 52606], [2, 52715], [13, 53355], [19, 53635], [25, 54135], [28, 54595], [31, 54735], [40, 55395], [44, 55475], [53, 56095], [57, 56335], [64, 56715], [67, 56995], [70, 57155], [78, 57855], [82, 58035], [88, 58831], [93, 58936], [97, 59076], [105, 59656], [111, 59976], [117, 60396], [120, 60676], [129, 61036]]}, {"verse": 9, "start": 62310, "end": 71501, "text": "¿Qué es más fácil, decir al paralítico: Tus pecados te son perdonados, o decirle: Levántate, y toma tu lecho y anda?", "words": [[0, 62310], [5, 62412], [8, 62532], [12, 62672], [19, 63152], [25, 63932], [28, 64292], [40, 65707], [44, 65851], [52, 66491], [55, 66611], [59, 66811], [71, 67671], [73, 68051], [82, 69148], [93, 69833], [95, 70093], [100, 70313], [103, 70543], [109, 70773], [111, 71013]]}, {"verse": 10, "start": 71851, "end": 78841, "text": "Pues para que sepáis que el Hijo del hombre tiene autoridad en la tierra de perdonar los pecados, (dice al paralítico):", "words": [[0, 71851], [5, 71973], [10, 72153], [14, 72313], [21, 72753], [25, 72953], [28, 73113], [33, 73353], [37, 73493], [44, 73773], [50, 74173], [60, 74953], [63, 75133], [66, 75253], [73, 75573], [76, 75753], [85, 76373], [89, 76493], [98, 77453], [104, 77670], [107, 77920]]}, {"verse": 11, "start": 79191, "end": 83558, "text": "A ti te digo: Levántate, y toma tu lecho, y vete a tu casa.", "words": [[0, 79191], [2, 79331], [5, 79491], [8, 79611], [14, 80378], [25, 80974], [27, 81394], [32, 81594], [35, 82004], [42, 82414], [44, 82554], [49, 82794], [51, 82934], [54, 82994]]}, {"verse": 12, "start": 83908, "end": 96841, "text": "Entonces él se levantó luego, y tomando su lecho, se salió delante de todos, de manera que todos se asombraron, y glorificaron a Dios, diciendo: Nunca hemos visto tal cosa.", "words": [[0, 83908], [9, 84513], [12, 85073], [15, 85393], [23, 85873], [30, 86213], [32, 86438], [40, 86858], [43, 87038], [50, 87438], [53, 87938], [59, 88338], [67, 88738], [70, 88898], [77, 89878], [80, 90018], [87, 90258], [91, 90518], [97, 90818], [100, 91278], [112, 92198], [114, 92848], [127, 93498], [129, 93598], [135, 93838], [145, 95064], [151, 95480], [157, 95640], [163, 96020], [167, 96260]]}, {"verse": 13, "start": 97121, "end": 102287, "text": "Y volvió a salir al mar, y toda la gente venía a él, y los enseñaba.", "words": [[0, 97121], [2, 97244], [9, 97744], [11, 97924], [17, 98264], [20, 98504], [25, 98784], [27, 99004], [32, 99224], [35, 99424], [41, 99704], [47, 100244], [49, 100484], [53, 100724], [55, 100959], [59, 101159]]}, {"verse": 14, "start": 102637, "end": 114060, "text": "Y pasando, vio a Leví, hijo de Alfeo, sentado a la mesa de recaudación de impuestos, y le dice: Sígueme. Y levantándose le siguió.", "words": [[0, 102637], [2, 102761], [11, 103401], [15, 103693], [17, 103984], [23, 104276], [28, 104496], [31, 104696], [38, 105776], [46, 106376], [48, 106496], [51, 106576], [56, 106876], [59, 107076], [71, 107876], [74, 108116], [85, 109676], [87, 109896], [90, 110036], [96, 110764], [105, 111975], [107, 112133], [120, 112973], [123, 113353]]}, {"verse": 15, "start": 114410, "end": 129650, "text": "Y aconteció que estando Jesús a la mesa en casa de él, muchos recaudadores de impuestos y pecadores estaban también a la mesa juntamente con Jesús y con sus discípulos: porque había muchos, y le habían seguido.", "words": [[0, 114410], [2, 114519], [12, 115219], [16, 115419], [24, 115859], [30, 116259], [32, 116619], [35, 116719], [40, 117019], [43, 117239], [48, 117579], [51, 117839], [55, 118339], [62, 119099], [75, 119979], [78, 120199], [88, 120799], [90, 121059], [100, 121699], [108, 122379], [116, 122919], [118, 123219], [121, 123319], [126, 123599], [137, 124319], [141, 124579], [147, 124959], [149, 125499], [153, 125699], [157, 125939], [169, 127181], [176, 127405], [182, 127645], [190, 128025], [192, 128585], [195, 128725], [202, 128965]]}, {"verse": 16, "start": 130000, "end": 143794, "text": "Y los escribas y los fariseos, viéndole comer con los recaudadores de impuestos y con los pecadores, dijeron a sus discípulos: ¿Qué es esto, que él come y bebe con los recaudadores de impuestos y con los pecadores?", "words": [[0, 130000], [2, 130108], [6, 130228], [15, 130968], [17, 131308], [21, 131448], [31, 132188], [40, 132948], [46, 133268], [50, 133648], [54, 133868], [67, 134688], [70, 134908], [80, 135488], [82, 135688], [86, 135848], [90, 135988], [101, 136528], [109, 137488], [111, 137548], [115, 137768], [127, 139179], [132, 139320], [135, 139520], [141, 139780], [145, 140000], [148, 140160], [153, 140440], [155, 140620], [160, 140920], [164, 141080], [168, 141220], [181, 141880], [184, 142040], [194, 142520], [196, 142700], [200, 142860], [204, 143000]]}, {"verse": 17, "start": 144074, "end": 154573, "text": "Y oyéndolo Jesús, les dice: Los sanos no tienen necesidad de médico, sino los enfermos. No he venido a llamar a los justos, sino a los pecadores.", "words": [[0, 144074], [2, 144416], [11, 144796], [18, 145216], [22, 145636], [28, 146339], [32, 146465], [38, 147045], [41, 147425], [48, 147805], [58, 148785], [61, 148945], [69, 149705], [74, 149925], [78, 150185], [88, 151302], [91, 151552], [94, 151632], [101, 152012], [103, 152092], [110, 152432], [112, 152472], [116, 152612], [124, 153152], [129, 153432], [131, 153532], [135, 153652]]}, {"verse": 18, "start": 154923, "end": 166387, "text": "Y los discípulos de Juan, y de los fariseos ayunaban; y vienen, y le dicen: ¿Por qué los discípulos de Juan y los de los fariseos ayunan, y tus discípulos no ayunan?", "words": [[0, 154923], [2, 155027], [6, 155167], [17, 155767], [20, 155967], [26, 156387], [28, 156822], [31, 156942], [35, 157102], [44, 157962], [54, 159127], [56, 159250], [64, 159690], [66, 160110], [69, 160210], [76, 161097], [81, 161197], [85, 161317], [89, 161457], [100, 162017], [103, 162177], [108, 162517], [110, 162757], [114, 162877], [117, 162977], [121, 163097], [130, 163717], [138, 164217], [140, 164697], [144, 164837], [155, 165457], [158, 165757]]}, {"verse": 19, "start": 166667, "end": 176529, "text": "Y Jesús les dice: ¿Pueden ayunar los invitados a la boda, cuando el esposo está con ellos? Entre tanto que tienen consigo al esposo no pueden ayunar.", "words": [[0, 166667], [2, 166797], [8, 167197], [12, 167677], [18, 168601], [26, 168963], [33, 169583], [37, 169703], [47, 170383], [49, 170563], [52, 170623], [58, 170983], [65, 171223], [68, 171483], [75, 171843], [80, 172023], [84, 172263], [91, 172974], [97, 173221], [103, 173581], [107, 173781], [114, 174061], [122, 174541], [125, 174761], [132, 175141], [135, 175381], [142, 175801]]}, {"verse": 20, "start": 176879, "end": 183244, "text": "Pero vendrán días, cuando el esposo les será quitado, y entonces en aquellos días ayunarán.", "words": [[0, 176879], [5, 177043], [13, 177503], [19, 177863], [26, 178443], [29, 178683], [36, 179063], [40, 179263], [45, 179503], [54, 180103], [56, 180803], [65, 181283], [68, 181603], [77, 181823], [82, 182243]]}, {"verse": 21, "start": 183594, "end": 193313, "text": "Nadie echa remiendo de paño nuevo en vestido viejo; de otra manera el mismo remiendo nuevo tira del viejo, y la rotura se hace peor.", "words": [[0, 183594], [6, 184142], [11, 184542], [20, 185322], [23, 185462], [28, 185822], [34, 186142], [37, 186322], [45, 186782], [52, 187590], [55, 187716], [60, 187896], [67, 188436], [70, 188516], [76, 188836], [85, 189516], [91, 189776], [96, 190256], [100, 190436], [107, 191316], [109, 191496], [112, 191656], [119, 192196], [122, 192416], [127, 192696]]}, {"verse": 22, "start": 193663, "end": 207045, "text": "Ni nadie echa vino nuevo en odres viejos; de otra manera, el vino nuevo rompe los odres, y se derrama el vino, y los odres se pierden; pero el vino nuevo en odres nuevos se ha de echar.", "words": [[0, 193663], [3, 193808], [9, 194128], [14, 194468], [19, 194748], [25, 195168], [28, 195368], [34, 195568], [42, 196722], [45, 196859], [50, 197019], [58, 197419], [61, 197659], [66, 197879], [72, 198239], [78, 198859], [82, 199059], [89, 199799], [91, 200024], [94, 200204], [102, 200784], [105, 201084], [111, 201484], [113, 201729], [117, 201889], [123, 202409], [126, 202569], [135, 203489], [140, 203633], [143, 203813], [148, 204033], [154, 204453], [157, 204733], [163, 205153], [170, 205593], [173, 206133], [176, 206293], [179, 206453]]}, {"verse": 23, "start": 207395, "end": 215639, "text": "Y aconteció que pasando él por los sembrados en sábado, sus discípulos andando comenzaron a arrancar espigas.", "words": [[0, 207395], [2, 207580], [12, 208320], [16, 208580], [24, 209000], [27, 209300], [31, 209520], [35, 209720], [45, 210320], [48, 210580], [56, 211440], [60, 211580], [71, 212400], [79, 212940], [90, 213720], [92, 214020], [101, 214857]]}, {"verse": 24, "start": 215989, "end": 221656, "text": "Entonces los fariseos le dijeron: He aquí, ¿por qué hacen en sábado lo que no es lícito?", "words": [[0, 215989], [9, 216433], [13, 216813], [22, 217473], [25, 217613], [34, 218523], [37, 218603], [43, 219403], [48, 219523], [52, 219723], [58, 220043], [61, 220163], [68, 220603], [71, 220743], [75, 220863], [78, 221003], [81, 221123]]}, {"verse": 25, "start": 221936, "end": 229772, "text": "Y él les dijo: ¿Nunca leísteis qué hizo David cuando tuvo necesidad, y tuvo hambre, él y los que con él estaban:", "words": [[0, 221936], [2, 222103], [5, 222223], [9, 222403], [15, 223162], [22, 223472], [31, 224152], [35, 224292], [40, 224712], [46, 225032], [53, 225332], [58, 225692], [69, 226452], [71, 226832], [76, 227092], [84, 227632], [87, 228212], [89, 228632], [93, 228772], [97, 228892], [101, 229112], [104, 229232]]}, {"verse": 26, "start": 230122, "end": 243132, "text": "Cómo entró en la casa de Dios, siendo Abiatar sumo sacerdote, y comió los panes consagrados, de los cuales no es lícito comer sino a los sacerdotes, y aun dio a los que con él estaban?", "words": [[0, 230122], [5, 230307], [11, 230767], [14, 230847], [17, 230967], [22, 231227], [25, 231427], [31, 232387], [38, 232907], [46, 233427], [51, 233847], [62, 234607], [64, 235047], [70, 235487], [74, 235627], [80, 236007], [93, 236847], [96, 237367], [100, 237487], [107, 237707], [110, 238007], [113, 238127], [120, 238527], [126, 238927], [131, 239267], [133, 239447], [137, 239547], [149, 240791], [151, 240932], [155, 241192], [159, 241532], [161, 241772], [165, 241912], [169, 242052], [173, 242272], [176, 242432]]}, {"verse": 27, "start": 243482, "end": 250791, "text": "También les dijo: El sábado por causa del hombre es hecho; no el hombre por causa del sábado.", "words": [[0, 243482], [8, 243787], [12, 244027], [18, 244859], [21, 245008], [28, 245548], [32, 245768], [38, 246128], [42, 246428], [49, 246688], [52, 246948], [59, 247734], [62, 248194], [65, 248554], [72, 248914], [76, 249214], [82, 249634], [86, 250014]]}, {"verse": 28, "start": 251141, "end": 255041, "text": "Así que el Hijo del hombre es Señor aun del sábado.", "words": [[0, 251141], [4, 251403], [8, 251643], [11, 251903], [16, 252203], [20, 252363], [27, 252743], [30, 252963], [36, 253483], [40, 253943], [44, 254263]]}]}