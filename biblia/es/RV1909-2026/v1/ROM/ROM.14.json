{"book": "ROM", "chapter": 14, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 168625, "verses": [{"verse": 1, "start": 300, "end": 4666, "text": "Recibid al débil en la fe, pero no para contiendas de disputas.", "words": [[0, 616], [8, 966], [11, 1106], [17, 1466], [20, 1626], [23, 1746], [27, 2186], [32, 2626], [35, 2826], [40, 3046], [51, 3726], [54, 3826]]}, {"verse": 2, "start": 5116, "end": 10970, "text": "Porque uno cree que se ha de comer de todas cosas: otro que es débil, come verduras.", "words": [[0, 5116], [7, 5317], [11, 5577], [16, 5877], [20, 6077], [23, 6277], [26, 6397], [29, 6457], [35, 6737], [38, 6977], [44, 7157], [51, 8279], [56, 8518], [60, 8738], [63, 8918], [70, 9738], [75, 10138]]}, {"verse": 3, "start": 11420, "end": 18788, "text": "El que come, no menosprecie al que no come: y el que no come, no juzgue al que come; porque Dios lo ha recibido.", "words": [[0, 11420], [3, 11565], [7, 11705], [13, 12005], [16, 12225], [28, 13085], [31, 13245], [35, 13405], [38, 13565], [44, 14416], [46, 14522], [49, 14602], [53, 14722], [56, 14882], [62, 15522], [65, 15722], [72, 16142], [75, 16262], [79, 16382], [85, 17205], [92, 17381], [97, 17681], [100, 17941], [103, 18061]]}, {"verse": 4, "start": 19238, "end": 28102, "text": "¿Tú quién eres que juzgas al siervo ajeno? para su señor está en pie, o cae: pero se afirmará; que poderoso es el Señor para afirmarle.", "words": [[0, 19238], [4, 19375], [10, 19595], [15, 19855], [19, 20035], [26, 20415], [29, 20665], [36, 20915], [43, 21760], [48, 21919], [51, 22099], [57, 22439], [62, 22799], [65, 22999], [70, 23259], [72, 23579], [77, 24384], [82, 24526], [85, 24666], [95, 25717], [99, 25799], [108, 26399], [111, 26559], [114, 26679], [120, 26979], [125, 27339]]}, {"verse": 5, "start": 28552, "end": 36118, "text": "Uno hace diferencia entre día y día; otro juzga iguales todos los días. Cada uno esté asegurado en su ánimo.", "words": [[0, 28552], [4, 28892], [9, 29152], [20, 29652], [26, 30112], [30, 30452], [32, 30592], [37, 31303], [42, 31563], [48, 32043], [56, 32543], [62, 32703], [66, 33023], [72, 33906], [77, 34066], [81, 34386], [86, 34686], [96, 35346], [99, 35486], [102, 35666]]}, {"verse": 6, "start": 36568, "end": 50062, "text": "El que hace caso del día, lo hace para el Señor: y el que no hace caso del día, no lo hace para el Señor. El que come, come para el Señor, porque da gracias a Dios; y el que no come, no come para el Señor, y da gracias a Dios.", "words": [[0, 36568], [3, 36711], [7, 36831], [12, 37071], [17, 37391], [21, 37631], [26, 37911], [29, 38451], [34, 38671], [39, 38911], [42, 39031], [49, 39828], [51, 39911], [54, 40011], [58, 40131], [61, 40351], [66, 40571], [71, 40911], [75, 41151], [80, 41411], [83, 41951], [86, 42091], [91, 42331], [96, 42611], [99, 42711], [106, 43499], [109, 43619], [113, 43739], [119, 44039], [124, 44199], [129, 44459], [132, 44579], [139, 45179], [146, 45339], [149, 45499], [157, 45799], [159, 46039], [165, 46753], [167, 46855], [170, 46935], [174, 47015], [177, 47155], [183, 47675], [186, 47815], [191, 48015], [196, 48255], [199, 48375], [206, 48615], [208, 48955], [211, 49075], [219, 49375], [221, 49635]]}, {"verse": 7, "start": 50512, "end": 54386, "text": "Porque ninguno de nosotros vive para sí, y ninguno muere para sí.", "words": [[0, 50512], [7, 50696], [15, 51176], [18, 51276], [27, 51616], [32, 51996], [37, 52316], [41, 52576], [43, 53076], [51, 53496], [57, 53776], [62, 53996]]}, {"verse": 8, "start": 54836, "end": 63465, "text": "Que si vivimos, para el Señor vivimos; y si morimos, para el Señor morimos. Así que, o que vivamos, o que muramos, del Señor somos.", "words": [[0, 54836], [4, 54918], [7, 55058], [16, 55478], [21, 55718], [24, 55838], [30, 56038], [39, 57096], [41, 57238], [44, 57278], [53, 57998], [58, 58298], [61, 58398], [67, 58638], [76, 60051], [80, 60288], [85, 60528], [87, 60588], [91, 60708], [100, 61468], [102, 61548], [106, 61668], [115, 62168], [119, 62468], [125, 62788]]}, {"verse": 9, "start": 63915, "end": 70788, "text": "Porque Cristo para esto murió, y resucitó, y volvió a vivir, para ser Señor así de los muertos como de los que viven.", "words": [[0, 63915], [7, 64092], [14, 64492], [19, 64752], [24, 65032], [31, 65532], [33, 65712], [43, 66412], [45, 66792], [52, 67192], [54, 67232], [61, 67492], [66, 67872], [70, 68072], [76, 68512], [80, 68792], [83, 68972], [87, 69092], [95, 69532], [100, 69832], [103, 69972], [107, 70072], [111, 70232]]}, {"verse": 10, "start": 71238, "end": 79087, "text": "Pero tú ¿por qué juzgas a tu hermano? o tú también, ¿por qué menosprecias a tu hermano? porque todos hemos de estar ante el tribunal de Cristo.", "words": [[0, 71238], [5, 71376], [8, 72036], [13, 72116], [17, 72256], [24, 72616], [26, 72776], [29, 72836], [38, 73671], [40, 73812], [43, 73892], [52, 74732], [57, 74812], [61, 75202], [74, 75592], [76, 75752], [79, 75832], [88, 76637], [95, 76796], [101, 77056], [107, 77356], [110, 77536], [116, 77756], [121, 77956], [124, 78036], [133, 78436], [136, 78556]]}, {"verse": 11, "start": 79537, "end": 88581, "text": "Porque escrito está: Vivo yo, dice el Señor, que a mí se doblará toda rodilla, y toda lengua confesará a Dios.", "words": [[0, 79537], [7, 79723], [15, 80103], [21, 81963], [26, 82263], [30, 82623], [35, 82743], [38, 82923], [45, 83843], [49, 83943], [51, 84063], [54, 84243], [57, 84423], [65, 84943], [70, 85183], [79, 85783], [81, 86263], [86, 86503], [93, 86963], [103, 87683], [105, 87823]]}, {"verse": 12, "start": 88881, "end": 91996, "text": "De manera que, cada uno de nosotros dará a Dios razón de sí.", "words": [[0, 88881], [3, 88980], [10, 89180], [15, 89440], [20, 89620], [24, 89940], [27, 90060], [36, 90420], [41, 90920], [43, 90940], [48, 91100], [54, 91420], [57, 91660]]}, {"verse": 13, "start": 92446, "end": 99199, "text": "Así que, no juzguemos más los unos de los otros: antes bien decidid no poner tropiezo o escándalo al hermano.", "words": [[0, 92446], [4, 92671], [9, 92831], [12, 92971], [22, 93551], [26, 93751], [30, 93991], [35, 94191], [38, 94371], [42, 94511], [49, 95410], [55, 95671], [60, 96311], [68, 96791], [71, 96951], [77, 97211], [86, 97851], [88, 98011], [98, 98591], [101, 98711]]}, {"verse": 14, "start": 99649, "end": 107904, "text": "Yo sé, y confío en el Señor Jesús, que nada es inmundo por sí mismo: pero a aquel que piensa alguna cosa ser inmunda, para él es inmunda.", "words": [[0, 99649], [3, 99812], [7, 100052], [9, 100292], [16, 100852], [19, 100972], [22, 101072], [28, 101292], [35, 102172], [39, 102252], [44, 102452], [47, 102652], [55, 103092], [59, 103292], [62, 103432], [69, 104194], [74, 104245], [76, 104335], [82, 104695], [86, 104795], [93, 105175], [100, 105415], [105, 105735], [109, 105995], [118, 106715], [123, 106955], [126, 107175], [129, 107295]]}, {"verse": 15, "start": 108354, "end": 117329, "text": "Pero si por causa de la comida tu hermano es entristecido, ya no andas conforme al amor. No arruines con tu comida a aquel por el cual Cristo murió.", "words": [[0, 108354], [5, 108493], [8, 108673], [12, 108873], [18, 109153], [21, 109393], [24, 109513], [31, 109913], [34, 110113], [42, 110573], [45, 110693], [59, 111833], [62, 112133], [65, 112313], [71, 112673], [80, 113213], [83, 113313], [89, 114059], [92, 114220], [101, 114660], [105, 114900], [108, 115040], [115, 115230], [117, 115420], [123, 115840], [127, 116000], [130, 116120], [135, 116320], [142, 116700]]}, {"verse": 16, "start": 117779, "end": 120239, "text": "No sea pues blasfemado vuestro bien:", "words": [[0, 117779], [3, 117979], [7, 118259], [12, 118539], [23, 119359], [31, 119759]]}, {"verse": 17, "start": 120689, "end": 127200, "text": "Que el reino de Dios no es comida ni bebida, sino justicia y paz y gozo por el Espíritu Santo.", "words": [[0, 120689], [4, 120791], [7, 120911], [13, 121251], [16, 121391], [21, 121651], [24, 122011], [27, 122191], [34, 122591], [37, 122831], [45, 123651], [50, 123871], [59, 124651], [61, 124791], [65, 125071], [67, 125391], [72, 125751], [76, 125971], [79, 126091], [88, 126611]]}, {"verse": 18, "start": 127650, "end": 132051, "text": "Porque el que en esto sirve a Cristo, agrada a Dios, y es acepto a los hombres.", "words": [[0, 127650], [7, 127870], [10, 128090], [14, 128250], [17, 128370], [22, 128550], [28, 128950], [30, 129070], [38, 129670], [45, 130030], [47, 130150], [53, 130350], [55, 130710], [58, 130830], [65, 131270], [67, 131330], [71, 131470]]}, {"verse": 19, "start": 132501, "end": 136925, "text": "Así que, sigamos lo que hace a la paz, y a la edificación de los unos a los otros.", "words": [[0, 132501], [4, 132700], [9, 132860], [17, 133280], [20, 133460], [24, 133620], [29, 133820], [31, 133960], [34, 134020], [39, 134360], [41, 134700], [43, 134760], [46, 134840], [58, 135380], [61, 135620], [65, 135780], [70, 136000], [72, 136220], [76, 136360]]}, {"verse": 20, "start": 137375, "end": 146398, "text": "No destruyas la obra de Dios por causa de la comida. Todas las cosas a la verdad son limpias: pero es malo que el hombre coma causando tropiezo.", "words": [[0, 137375], [3, 137497], [13, 138157], [16, 138317], [21, 138497], [24, 138677], [29, 138917], [33, 139217], [39, 139497], [42, 139717], [45, 139817], [53, 140667], [59, 140989], [63, 141149], [69, 141609], [71, 141749], [74, 141829], [81, 142329], [85, 142469], [94, 143492], [99, 143656], [102, 143876], [107, 144296], [111, 144436], [114, 144596], [121, 144796], [126, 145096], [135, 145656]]}, {"verse": 21, "start": 146848, "end": 153883, "text": "Bueno es no comer carne, ni beber vino, ni nada en que tu hermano tropiece, o se ofenda, o sea debilitado.", "words": [[0, 146848], [6, 147105], [9, 147305], [12, 147465], [18, 147745], [25, 148205], [28, 148545], [34, 148785], [40, 149345], [43, 149665], [48, 149945], [51, 150105], [55, 150205], [58, 150365], [66, 150785], [76, 151285], [78, 151845], [81, 152005], [89, 152525], [91, 152865], [95, 153045]]}, {"verse": 22, "start": 154333, "end": 161116, "text": "¿Tienes tú fe? Tenla para contigo delante de Dios. Bienaventurado el que no se condena a sí mismo con lo que aprueba.", "words": [[0, 154333], [8, 154671], [11, 154791], [15, 155497], [21, 155757], [26, 155937], [34, 156397], [42, 156757], [45, 156897], [51, 158240], [66, 158520], [69, 158620], [73, 158720], [76, 158860], [79, 159000], [87, 159440], [89, 159520], [92, 159640], [98, 160060], [102, 160280], [105, 160380], [109, 160500]]}, {"verse": 23, "start": 161566, "end": 168225, "text": "Pero el que duda sobre lo que come, es condenado, porque no lo hace con fe: y todo lo que no es de fe, es pecado.", "words": [[0, 161566], [5, 161704], [8, 161824], [12, 161924], [17, 162184], [23, 162464], [26, 162644], [30, 162764], [36, 163084], [39, 163444], [50, 164184], [57, 164404], [60, 164584], [63, 164724], [68, 164944], [72, 165144], [76, 165867], [78, 165969], [83, 166149], [86, 166349], [90, 166469], [93, 166649], [96, 166789], [99, 166889], [103, 167149], [106, 167569]]}]}