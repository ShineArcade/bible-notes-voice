{"book": "JHN", "chapter": 15, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 219554, "verses": [{"verse": 1, "start": 300, "end": 3950, "text": "Yo soy la vid verdadera, y mi Padre es el labrador.", "words": [[0, 300], [3, 486], [7, 726], [10, 926], [14, 1126], [25, 1846], [27, 2166], [30, 2306], [36, 2646], [39, 3006], [42, 3186]]}, {"verse": 2, "start": 4400, "end": 14371, "text": "Toda rama que en mí no lleva fruto, la quitará: y toda aquella que lleva fruto, la limpiará mediante la poda, para que lleve más fruto.", "words": [[0, 4400], [5, 4665], [10, 5065], [14, 5260], [17, 5455], [20, 5650], [23, 5845], [29, 6045], [36, 6625], [39, 7205], [48, 8274], [50, 8438], [55, 8638], [63, 9138], [67, 9258], [73, 9538], [80, 10438], [83, 10778], [92, 11398], [101, 11838], [104, 12018], [110, 12478], [115, 12738], [119, 12898], [125, 13278], [129, 13518]]}, {"verse": 3, "start": 14821, "end": 18710, "text": "Ya vosotros sois limpios por la palabra que os he hablado.", "words": [[0, 14821], [3, 15141], [12, 15701], [17, 16161], [25, 16881], [29, 17101], [32, 17261], [40, 17641], [44, 17881], [47, 18041], [50, 18181]]}, {"verse": 4, "start": 19160, "end": 29879, "text": "Estad en mí, y yo en vosotros. Como la rama no puede llevar fruto de sí misma, si no está en la vid; así ni vosotros, si no permanecéis en mí.", "words": [[0, 19160], [6, 19543], [9, 19723], [13, 19963], [15, 20363], [18, 20603], [21, 20903], [31, 22043], [36, 22189], [39, 22369], [44, 22749], [47, 22949], [53, 23209], [60, 23569], [66, 24089], [69, 24249], [72, 24429], [79, 24869], [82, 25449], [85, 25589], [90, 25809], [93, 25949], [96, 26276], [101, 26832], [105, 27017], [108, 27197], [118, 28097], [121, 28257], [124, 28377], [136, 29257], [139, 29377]]}, {"verse": 5, "start": 30329, "end": 39739, "text": "Yo soy la vid, vosotros las ramas: el que está en mí, y yo en él, este lleva mucho fruto; porque sin mí nada podéis hacer.", "words": [[0, 30329], [3, 30497], [7, 30817], [10, 31137], [15, 31457], [24, 32037], [28, 32137], [35, 33152], [38, 33297], [42, 33437], [47, 33657], [50, 33877], [54, 34537], [56, 34757], [59, 34937], [62, 35077], [66, 35637], [71, 35897], [77, 36197], [83, 36537], [90, 37503], [97, 37728], [101, 37988], [104, 38288], [109, 38628], [116, 39048]]}, {"verse": 6, "start": 40189, "end": 48700, "text": "El que en mí no esté, será echado fuera como rama mala, y se secará; y las recogen, y las echan en el fuego, y arden.", "words": [[0, 40189], [3, 40529], [7, 40709], [10, 40849], [13, 40989], [16, 41129], [22, 41369], [27, 41809], [34, 42249], [40, 42549], [45, 42869], [50, 43249], [56, 43569], [58, 43909], [61, 44029], [69, 45051], [71, 45195], [75, 45355], [84, 45995], [86, 46295], [90, 46475], [96, 46815], [99, 47015], [102, 47155], [109, 47495], [111, 48115]]}, {"verse": 7, "start": 49150, "end": 56246, "text": "Si estáis en mí, y mis palabras están en vosotros, pedid todo lo que queráis, y os será hecho.", "words": [[0, 49150], [3, 49295], [10, 49755], [13, 49955], [17, 50195], [19, 50615], [23, 50775], [32, 51235], [38, 51615], [41, 51835], [51, 52695], [57, 53255], [62, 53715], [65, 53995], [69, 54155], [78, 54695], [80, 55095], [83, 55235], [88, 55635]]}, {"verse": 8, "start": 56696, "end": 64123, "text": "En esto es glorificado mi Padre, en que llevéis mucho fruto, y seáis así mis discípulos.", "words": [[0, 56696], [3, 56859], [8, 57119], [11, 57419], [23, 58239], [26, 58399], [33, 59179], [36, 59359], [40, 59499], [48, 60039], [54, 60679], [61, 61319], [63, 61779], [69, 62279], [73, 62659], [77, 63039]]}, {"verse": 9, "start": 64573, "end": 69430, "text": "Como el Padre me amó, también yo os he amado: estad en mi amor.", "words": [[0, 64573], [5, 64755], [8, 64895], [14, 65395], [17, 65555], [22, 66115], [30, 66315], [33, 66735], [36, 67035], [39, 67315], [46, 68314], [52, 68721], [55, 68861], [58, 69001]]}, {"verse": 10, "start": 69880, "end": 80247, "text": "Si guardáis mis mandamientos, estaréis en mi amor; como yo también he guardado los mandamientos de mi Padre, y estoy en su amor.", "words": [[0, 69880], [3, 70044], [12, 70664], [16, 71004], [30, 71904], [39, 73124], [42, 73424], [45, 73624], [51, 74409], [56, 74700], [59, 74880], [67, 75220], [70, 75580], [79, 76120], [83, 76260], [96, 77000], [99, 77180], [102, 77320], [109, 77680], [111, 78200], [117, 78640], [120, 79240], [123, 79500]]}, {"verse": 11, "start": 80697, "end": 87367, "text": "Estas cosas os he hablado, para que mi gozo esté en vosotros, y vuestro gozo sea cumplido.", "words": [[0, 80697], [6, 81031], [12, 81311], [15, 81551], [18, 81731], [27, 82211], [32, 82411], [36, 82551], [39, 82751], [44, 83051], [49, 83271], [52, 83451], [62, 84091], [64, 84911], [72, 85271], [77, 85641], [81, 86011]]}, {"verse": 12, "start": 87817, "end": 94125, "text": "Este es mi mandamiento: Que os améis los unos a los otros, como yo os he amado.", "words": [[0, 87881], [5, 87981], [8, 88241], [11, 88561], [24, 89790], [28, 89874], [31, 90034], [37, 90414], [41, 90814], [46, 91314], [48, 91634], [52, 91794], [59, 92514], [64, 92714], [67, 92994], [70, 93294], [73, 93454]]}, {"verse": 13, "start": 94575, "end": 100666, "text": "Nadie tiene mayor amor que este, que ponga alguno su vida por sus amigos.", "words": [[0, 94575], [6, 94961], [12, 95261], [18, 95601], [23, 95941], [27, 96181], [33, 96461], [37, 96641], [43, 97101], [50, 97521], [53, 97641], [58, 97881], [62, 98121], [66, 98341]]}, {"verse": 14, "start": 101116, "end": 104661, "text": "Vosotros sois mis amigos, si hacéis lo que yo os mando.", "words": [[0, 101116], [9, 101116], [14, 101116], [18, 101302], [26, 102202], [29, 102462], [36, 103122], [39, 103402], [43, 103542], [46, 103782], [49, 104062]]}, {"verse": 15, "start": 105111, "end": 117322, "text": "Ya no os llamaré siervos, porque el siervo no sabe lo que hace su señor: pero os he llamado amigos, porque todas las cosas que oí de mi Padre, os he dado a conocer.", "words": [[0, 105111], [3, 105331], [6, 105591], [9, 105791], [17, 106211], [26, 107131], [33, 107511], [36, 107711], [43, 108311], [46, 108751], [51, 109211], [54, 109631], [58, 109811], [63, 110091], [66, 110331], [73, 111202], [78, 111364], [81, 111624], [84, 111744], [92, 112064], [100, 112604], [107, 113324], [113, 113584], [117, 113864], [123, 114164], [127, 114464], [130, 114704], [133, 114804], [136, 114944], [143, 115304], [146, 115984], [149, 116264], [154, 116524], [156, 116684]]}, {"verse": 16, "start": 117772, "end": 132627, "text": "No me elegisteis vosotros a mí, sino que yo os elegí a vosotros; y os he puesto para que vayáis y llevéis fruto, y vuestro fruto permanezca: para que todo lo que pidáis del Padre en mi nombre, él os lo dé.", "words": [[0, 117772], [3, 117938], [6, 118098], [17, 119058], [26, 119658], [28, 119838], [32, 120398], [37, 120758], [41, 120978], [44, 121258], [47, 121518], [53, 122118], [55, 122218], [65, 123399], [67, 123484], [70, 123569], [73, 123654], [80, 124034], [85, 124434], [89, 124614], [96, 125214], [98, 125534], [106, 125914], [113, 126934], [115, 127014], [123, 127354], [129, 127694], [141, 128891], [146, 129031], [150, 129171], [155, 129451], [158, 129651], [162, 129791], [169, 130191], [173, 130351], [179, 130811], [182, 130911], [185, 131071], [193, 131471], [196, 131951], [199, 132111], [202, 132291]]}, {"verse": 17, "start": 133077, "end": 136797, "text": "Esto os mando: Que os améis los unos a los otros.", "words": [[0, 133296], [5, 133550], [8, 133804], [15, 134291], [19, 134561], [22, 134721], [28, 135121], [32, 135341], [37, 135661], [39, 135961], [43, 136101]]}, {"verse": 18, "start": 137247, "end": 143248, "text": "Si el mundo os aborrece, sabed que a mí me aborreció antes que a vosotros.", "words": [[0, 137247], [3, 137450], [6, 137630], [12, 138010], [15, 138370], [25, 139610], [31, 140130], [35, 140330], [37, 140490], [40, 140670], [43, 140870], [53, 141650], [59, 142070], [63, 142330], [65, 142470]]}, {"verse": 19, "start": 143698, "end": 155016, "text": "Si fuerais del mundo, el mundo amaría lo suyo; pero porque no sois del mundo, antes yo os elegí del mundo, por eso os aborrece el mundo.", "words": [[0, 143698], [3, 143836], [11, 144256], [15, 144436], [22, 145296], [25, 145436], [31, 145776], [38, 146236], [41, 146416], [47, 147339], [52, 147503], [59, 147863], [62, 148063], [67, 148463], [71, 148623], [78, 149463], [84, 150003], [87, 150483], [90, 150823], [96, 151463], [100, 151583], [107, 152683], [111, 152903], [115, 153123], [118, 153483], [127, 154183], [130, 154423]]}, {"verse": 20, "start": 155466, "end": 168132, "text": "Acordaos de la palabra que yo os he dicho: No es el siervo mayor que su señor. Si a mí me han perseguido, también a vosotros perseguirán: si han guardado mi palabra, también guardarán la vuestra.", "words": [[0, 155466], [9, 156157], [12, 156297], [15, 156417], [23, 156817], [27, 157057], [30, 157337], [33, 157517], [36, 157617], [43, 158485], [46, 158651], [49, 158831], [52, 158971], [59, 159431], [65, 159711], [69, 159971], [72, 160131], [79, 161098], [82, 161275], [84, 161415], [87, 161575], [90, 161735], [94, 161915], [106, 162675], [114, 162975], [116, 163255], [125, 163735], [138, 165079], [141, 165225], [145, 165345], [154, 165825], [157, 165985], [166, 166565], [174, 166745], [184, 167425], [187, 167545]]}, {"verse": 21, "start": 168582, "end": 174612, "text": "Mas todo esto os harán por causa de mi nombre, porque no conocen al que me ha enviado.", "words": [[0, 168582], [4, 168807], [9, 169027], [14, 169447], [17, 169827], [23, 170227], [27, 170427], [33, 170767], [36, 171047], [39, 171147], [47, 171767], [54, 172207], [57, 172467], [65, 173127], [68, 173327], [72, 173527], [75, 173707], [78, 173827]]}, {"verse": 22, "start": 175062, "end": 182322, "text": "Si no hubiera venido, ni les hubiera hablado, no tendrían pecado, pero ahora no tienen excusa de su pecado.", "words": [[0, 175062], [3, 175225], [6, 175385], [14, 175745], [22, 176265], [25, 176585], [29, 176845], [37, 177265], [46, 178265], [49, 178445], [58, 178925], [66, 179605], [71, 179765], [77, 180165], [80, 180425], [87, 180685], [94, 181405], [97, 181525], [100, 181665]]}, {"verse": 23, "start": 182772, "end": 186128, "text": "El que me aborrece, también a mi Padre aborrece.", "words": [[0, 182772], [3, 183102], [7, 183242], [10, 183382], [20, 184482], [28, 184642], [30, 184862], [33, 184942], [39, 185342]]}, {"verse": 24, "start": 186578, "end": 198174, "text": "Si no hubiese hecho entre ellos obras cuales ningún otro ha hecho, no tendrían pecado; pero ahora, y las han visto, y me aborrecen a mí y a mi Padre.", "words": [[0, 186578], [3, 186901], [6, 187061], [14, 187401], [20, 187721], [26, 187961], [32, 188301], [38, 188741], [45, 189061], [52, 189821], [57, 190401], [60, 190761], [67, 191721], [70, 191941], [79, 192461], [87, 193499], [92, 193923], [99, 194623], [101, 194743], [105, 194863], [109, 195043], [116, 195903], [118, 195983], [121, 196103], [131, 196743], [133, 196903], [136, 197043], [138, 197423], [140, 197503], [143, 197603]]}, {"verse": 25, "start": 198624, "end": 204657, "text": "Pero para que se cumpla la palabra que está escrita en su ley: Que sin causa me aborrecieron.", "words": [[0, 198624], [5, 198789], [10, 199069], [14, 199209], [17, 199349], [24, 199909], [27, 200069], [35, 200509], [39, 200729], [44, 200949], [52, 201489], [55, 201609], [58, 201769], [63, 202638], [67, 202722], [71, 202922], [77, 203402], [80, 203682]]}, {"verse": 26, "start": 205107, "end": 214045, "text": "Pero cuando venga el Consolador, el cual yo os enviaré del Padre, el Espíritu de verdad, el cual procede del Padre, él dará testimonio de mí.", "words": [[0, 205107], [5, 205250], [12, 205510], [18, 205890], [21, 206010], [33, 207150], [36, 207270], [41, 207450], [44, 207730], [47, 207910], [55, 208410], [59, 208510], [66, 209390], [69, 209450], [78, 209970], [81, 210090], [89, 210850], [92, 210990], [97, 211190], [105, 211810], [109, 211950], [116, 212690], [119, 212710], [124, 213030], [135, 213630], [138, 213750]]}, {"verse": 27, "start": 214495, "end": 219154, "text": "Y vosotros daréis testimonio, porque estáis conmigo desde el principio.", "words": [[0, 214495], [2, 214616], [11, 215216], [18, 215576], [30, 216436], [37, 216656], [44, 217116], [52, 217676], [58, 217916], [61, 218156]]}]}