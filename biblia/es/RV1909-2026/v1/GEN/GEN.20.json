{"book": "GEN", "chapter": 20, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 166781, "verses": [{"verse": 1, "start": 300, "end": 9079, "text": "De allí partió Abraham a la tierra del sur, y acampó entre Cades y Shur, y habitó como forastero en Gerar.", "words": [[0, 300], [3, 463], [8, 703], [15, 1283], [23, 1863], [25, 2203], [28, 2303], [35, 2643], [39, 2983], [44, 3923], [46, 4163], [53, 4763], [59, 5003], [65, 5703], [67, 6323], [73, 6943], [75, 7063], [82, 7463], [87, 7663], [97, 8383], [100, 8756]]}, {"verse": 2, "start": 9429, "end": 17657, "text": "Y dijo Abraham de Sara su mujer: Mi hermana es. Y Abimelec, rey de Gerar, envió y tomó a Sara.", "words": [[0, 9429], [2, 9716], [7, 10056], [15, 10596], [18, 10956], [23, 11436], [26, 11496], [33, 12306], [36, 12442], [44, 12762], [48, 13896], [50, 14310], [60, 14726], [64, 15140], [67, 15540], [74, 15940], [80, 16380], [82, 16560], [87, 16960], [89, 17080]]}, {"verse": 3, "start": 18007, "end": 27160, "text": "Pero Dios vino a Abimelec en sueños de noche, y le dijo: Vas a morir a causa de la mujer que has tomado, la cual es casada.", "words": [[0, 18007], [5, 18172], [10, 18472], [15, 18932], [17, 19502], [26, 20072], [29, 20332], [36, 20892], [39, 21012], [46, 21352], [48, 21672], [51, 21792], [57, 22554], [61, 22760], [63, 22920], [69, 23400], [71, 23580], [77, 23820], [80, 24020], [83, 24120], [89, 24400], [93, 24640], [97, 24780], [105, 25660], [108, 25740], [113, 25960], [116, 26300]]}, {"verse": 4, "start": 27440, "end": 33245, "text": "Mas Abimelec no había llegado a ella, y dijo: Señor, ¿matarás también la gente justa?", "words": [[0, 27440], [4, 27681], [13, 28501], [16, 28721], [22, 28941], [30, 29461], [32, 29621], [38, 29821], [40, 30041], [46, 30742], [53, 31505], [62, 32085], [70, 32405], [73, 32565], [79, 32825]]}, {"verse": 5, "start": 33595, "end": 44648, "text": "¿No me dijo él: Mi hermana es; y ella también dijo: Es mi hermano? Con sencillez de mi corazón, y con limpieza de mis manos he hecho esto.", "words": [[0, 33595], [4, 34130], [7, 34270], [12, 34530], [16, 35106], [19, 35229], [27, 35549], [31, 36187], [33, 36329], [38, 36489], [46, 36769], [52, 37552], [55, 37710], [58, 37890], [67, 38724], [71, 39038], [81, 39388], [84, 39488], [87, 39588], [96, 39968], [98, 40263], [102, 40403], [111, 40903], [114, 41003], [118, 41123], [124, 41463], [127, 41843], [133, 42083]]}, {"verse": 6, "start": 44928, "end": 56691, "text": "Y le dijo Dios en sueños: Yo también sé que con integridad de tu corazón has hecho esto; y yo también te detuve de pecar contra mí, y así no te permití que la tocases.", "words": [[0, 44928], [2, 45056], [5, 45176], [10, 45516], [15, 45876], [18, 46156], [26, 47290], [29, 47438], [37, 47698], [40, 48098], [44, 48218], [48, 48398], [59, 48978], [62, 49118], [65, 49258], [73, 49718], [77, 50198], [83, 50418], [89, 51428], [91, 51549], [94, 51669], [102, 51989], [105, 52229], [112, 52649], [115, 52809], [121, 53169], [128, 53469], [132, 53989], [134, 54069], [138, 54329], [141, 54749], [144, 54909], [152, 55489], [156, 55589], [159, 55689]]}, {"verse": 7, "start": 57041, "end": 68638, "text": "Ahora, pues, devuelve la mujer a su marido; porque es profeta, y orará por ti, y vivirás. Y si tú no la devuelves, sabe que de cierto morirás tú y todos los tuyos.", "words": [[0, 57041], [7, 57284], [13, 58064], [22, 58544], [25, 58644], [31, 58924], [33, 59104], [36, 59224], [44, 60200], [51, 60443], [54, 60603], [63, 61183], [65, 61643], [71, 61983], [75, 62203], [79, 62443], [81, 62783], [90, 63717], [92, 63834], [95, 63954], [98, 64174], [101, 64294], [104, 64414], [115, 65214], [120, 65594], [124, 65754], [127, 65894], [134, 66214], [142, 66834], [145, 67074], [147, 67314], [153, 67594], [157, 67834]]}, {"verse": 8, "start": 68918, "end": 80642, "text": "Entonces Abimelec se levantó de mañana, y llamó a todos sus siervos, y dijo todas estas palabras en los oídos de ellos; y temieron los hombres en gran manera.", "words": [[0, 68918], [9, 69578], [18, 70278], [21, 70698], [29, 71258], [32, 71338], [40, 71858], [42, 72438], [48, 72818], [50, 72918], [56, 73238], [60, 73558], [69, 74198], [71, 74878], [76, 75158], [82, 75478], [88, 75798], [97, 76258], [100, 76578], [104, 76698], [110, 77178], [113, 77338], [120, 78122], [122, 78386], [131, 78826], [135, 79086], [143, 79466], [146, 79706], [151, 79926]]}, {"verse": 9, "start": 80992, "end": 92723, "text": "Después llamó Abimelec a Abraham, y le dijo: ¿Qué nos has hecho? ¿y en qué pequé yo contra ti, que has atraído sobre mí y sobre mi reino tan gran pecado? lo que no debiste hacer has hecho conmigo.", "words": [[0, 80992], [8, 81256], [14, 81866], [23, 82476], [25, 82736], [34, 83216], [36, 83591], [39, 83711], [45, 84428], [50, 84508], [54, 84668], [58, 84848], [65, 85582], [68, 85687], [71, 85807], [75, 86071], [81, 86335], [84, 86599], [91, 86863], [95, 87127], [99, 87192], [103, 87352], [111, 87752], [117, 88012], [120, 88292], [122, 88472], [128, 88692], [131, 88892], [137, 89232], [141, 89432], [146, 89632], [154, 90493], [157, 90597], [161, 90717], [164, 90857], [172, 91237], [178, 91637], [182, 91917], [188, 92117]]}, {"verse": 10, "start": 93003, "end": 97758, "text": "Y dijo más Abimelec a Abraham: ¿Qué viste para que hicieses esto?", "words": [[0, 93003], [2, 93120], [7, 93400], [11, 93980], [20, 94560], [22, 94760], [31, 95777], [36, 95879], [42, 96239], [47, 96498], [51, 96718], [60, 97239]]}, {"verse": 11, "start": 98038, "end": 105705, "text": "Y Abraham respondió: Porque dije para mí: Cierto no hay temor de Dios en este lugar, y me matarán por causa de mi mujer.", "words": [[0, 98038], [2, 98195], [10, 98615], [21, 99963], [28, 100143], [33, 100363], [38, 100603], [42, 101120], [49, 101637], [52, 101757], [56, 101897], [62, 102257], [65, 102397], [70, 102617], [73, 102837], [78, 103017], [85, 103617], [87, 103817], [90, 103937], [98, 104437], [102, 104537], [108, 104837], [111, 105117], [114, 105217]]}, {"verse": 12, "start": 106055, "end": 112531, "text": "Y a la verdad también es mi hermana, hija de mi padre, mas no hija de mi madre, y la tomé por mujer.", "words": [[0, 106055], [2, 106177], [4, 106297], [7, 106377], [14, 106737], [22, 107197], [25, 107457], [28, 107617], [37, 108377], [42, 108617], [45, 108677], [48, 108797], [55, 109597], [59, 109817], [62, 110057], [67, 110377], [70, 110477], [73, 110597], [80, 111317], [82, 111417], [85, 111517], [90, 111837], [94, 111977]]}, {"verse": 13, "start": 112881, "end": 124308, "text": "Y aconteció que, cuando Dios me hizo salir errante de la casa de mi padre, yo le dije: Esta es la merced que tú me harás, que en todos los lugares adonde lleguemos, digas de mí: Mi hermano es.", "words": [[0, 112881], [2, 113011], [12, 113631], [17, 113871], [24, 114151], [29, 114451], [32, 114691], [37, 114891], [43, 115311], [51, 115731], [54, 115851], [57, 115951], [62, 116191], [65, 116371], [68, 116491], [75, 117331], [78, 117391], [81, 117511], [87, 118175], [92, 118416], [95, 118596], [98, 118716], [105, 119096], [109, 119276], [112, 119436], [115, 119616], [122, 120256], [126, 120456], [129, 120596], [135, 120776], [139, 121056], [147, 121406], [154, 121756], [165, 122356], [171, 122796], [174, 122896], [178, 123424], [181, 123550], [189, 123970]]}, {"verse": 14, "start": 124588, "end": 134115, "text": "Entonces Abimelec tomó ovejas y vacas, y siervos y siervas, y se los dio a Abraham, y le devolvió a Sara su mujer.", "words": [[0, 124588], [9, 125405], [18, 126255], [23, 126687], [30, 127120], [32, 127300], [39, 128140], [41, 128320], [49, 128940], [51, 129220], [60, 129740], [62, 130220], [65, 130340], [69, 130520], [73, 130740], [75, 131020], [84, 131580], [86, 132280], [89, 132400], [98, 132980], [100, 133100], [105, 133340], [108, 133560]]}, {"verse": 15, "start": 134465, "end": 139821, "text": "Y dijo Abimelec: He aquí mi tierra está delante de ti, habita donde bien te parezca.", "words": [[0, 134465], [2, 134822], [7, 135211], [17, 135758], [20, 135885], [25, 136065], [28, 136245], [35, 136525], [40, 136785], [48, 137225], [51, 137365], [55, 138065], [62, 138525], [68, 138718], [73, 138912], [76, 139105]]}, {"verse": 16, "start": 140101, "end": 150451, "text": "Y a Sara dijo: He aquí he dado mil monedas de plata a tu hermano; mira que él te es por velo de ojos para todos los que están contigo, y para con todos: así fue reprendida.", "words": [[0, 140101], [2, 140245], [4, 140385], [9, 140585], [15, 141456], [18, 141637], [23, 142097], [26, 142177], [31, 142377], [35, 142617], [43, 143137], [46, 143237], [52, 143557], [54, 143777], [57, 143857], [66, 144599], [71, 144802], [75, 145002], [78, 145182], [81, 145302], [84, 145402], [88, 145562], [93, 145802], [96, 145962], [101, 146202], [106, 146522], [112, 146762], [116, 146962], [120, 147102], [126, 147302], [135, 147922], [137, 148102], [142, 148282], [146, 148482], [153, 149251], [157, 149437], [161, 149637]]}, {"verse": 17, "start": 150731, "end": 158438, "text": "Entonces Abraham oró a Dios; y Dios sanó a Abimelec y a su mujer, y a sus siervas, y parieron.", "words": [[0, 150731], [9, 151400], [17, 152060], [21, 152180], [23, 152460], [29, 153200], [31, 153328], [36, 153568], [41, 154248], [43, 154758], [52, 155268], [54, 155468], [56, 155568], [59, 155708], [66, 156128], [68, 156548], [70, 156608], [74, 156768], [83, 157368], [85, 157748]]}, {"verse": 18, "start": 158788, "end": 166381, "text": "Porque había del todo cerrado Jehová toda matriz de la casa de Abimelec, a causa de Sara mujer de Abraham.", "words": [[0, 158788], [7, 158992], [13, 159352], [17, 159592], [22, 159952], [30, 160552], [37, 161072], [42, 161272], [49, 162052], [52, 162332], [55, 162452], [60, 162712], [63, 163292], [73, 163872], [75, 164092], [81, 164372], [84, 164652], [89, 165112], [95, 165352], [98, 165632]]}]}