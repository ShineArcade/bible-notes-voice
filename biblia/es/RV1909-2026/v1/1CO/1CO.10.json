{"book": "1CO", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 203682, "verses": [{"verse": 1, "start": 300, "end": 6966, "text": "Porque no quiero, hermanos, que ignoréis que nuestros padres todos estuvieron bajo la nube, y todos pasaron el mar;", "words": [[0, 300], [7, 506], [10, 686], [18, 946], [28, 1906], [32, 2046], [41, 2546], [45, 2726], [54, 2926], [61, 3426], [67, 3786], [78, 4506], [83, 4706], [86, 4906], [92, 5246], [94, 5646], [100, 5866], [108, 6426], [111, 6606]]}, {"verse": 2, "start": 7316, "end": 10754, "text": "Y todos en Moisés fueron bautizados en la nube y en el mar;", "words": [[0, 7316], [2, 7436], [8, 7616], [11, 7876], [18, 8216], [25, 8556], [36, 9276], [39, 9476], [42, 9596], [47, 9916], [49, 10176], [52, 10296], [55, 10416]]}, {"verse": 3, "start": 11104, "end": 13774, "text": "Y todos comieron el mismo alimento espiritual;", "words": [[0, 11104], [2, 11211], [8, 11431], [17, 11991], [20, 12211], [26, 12491], [35, 12931]]}, {"verse": 4, "start": 14124, "end": 21569, "text": "Y todos bebieron la misma bebida espiritual; porque bebían de la piedra espiritual que los seguía, y la piedra era Cristo:", "words": [[0, 14124], [2, 14241], [8, 14481], [17, 15101], [20, 15281], [26, 15521], [33, 15981], [45, 17024], [52, 17241], [59, 17721], [62, 17861], [65, 17961], [72, 18321], [83, 18921], [87, 19101], [91, 19281], [99, 19861], [101, 20221], [104, 20361], [111, 20801], [115, 20961]]}, {"verse": 5, "start": 21919, "end": 26414, "text": "Pero de muchos de ellos no se agradó Dios; por lo cual fueron postrados en el desierto.", "words": [[0, 21919], [5, 22062], [8, 22202], [15, 22422], [18, 22682], [24, 22902], [27, 23082], [30, 23342], [37, 23602], [43, 24212], [47, 24317], [50, 24437], [55, 24657], [62, 24877], [72, 25417], [75, 25637], [78, 25757]]}, {"verse": 6, "start": 26764, "end": 32321, "text": "Pero estas cosas fueron en figura de nosotros, para que no codiciemos cosas malas, como ellos codiciaron.", "words": [[0, 26764], [5, 26887], [11, 27087], [17, 27487], [24, 27807], [27, 28027], [34, 28267], [37, 28467], [47, 28967], [52, 29527], [56, 29647], [59, 29767], [70, 30347], [76, 30547], [83, 31107], [88, 31327], [94, 31527]]}, {"verse": 7, "start": 32671, "end": 41302, "text": "Ni seáis honradores de ídolos, como algunos de ellos; según está escrito: Se sentó el pueblo a comer y a beber, y se levantaron a jugar.", "words": [[0, 32671], [3, 32817], [9, 33237], [20, 33917], [23, 34057], [31, 34637], [36, 34957], [44, 35357], [47, 35537], [54, 36269], [60, 36549], [65, 36789], [74, 37613], [77, 37718], [83, 38098], [86, 38198], [93, 38538], [95, 38718], [101, 38978], [103, 39198], [105, 39278], [112, 39518], [114, 39998], [117, 40098], [128, 40678], [130, 40778]]}, {"verse": 8, "start": 41652, "end": 47790, "text": "Ni practiquemos inmoralidad sexual, como algunos de ellos la practicaron, y cayeron en un día veintitrés mil.", "words": [[0, 41652], [3, 41788], [16, 42468], [28, 43168], [36, 43928], [41, 44088], [49, 44428], [52, 44608], [58, 44828], [61, 44948], [74, 45588], [76, 45988], [84, 46488], [87, 46568], [90, 46688], [94, 47075], [105, 47461]]}, {"verse": 9, "start": 48140, "end": 53135, "text": "Ni tentemos a Cristo, como también algunos de ellos le tentaron, y perecieron por las serpientes.", "words": [[0, 48140], [3, 48283], [12, 48703], [14, 48883], [22, 49203], [27, 49583], [35, 49943], [43, 50283], [46, 50503], [52, 50663], [55, 50823], [65, 51323], [67, 51583], [78, 52123], [82, 52263], [86, 52383]]}, {"verse": 10, "start": 53485, "end": 58009, "text": "Ni murmuréis, como algunos de ellos murmuraron, y perecieron por el destructor.", "words": [[0, 53485], [3, 53630], [14, 54290], [19, 54510], [27, 54950], [30, 55170], [36, 55390], [48, 56130], [50, 56310], [61, 56910], [65, 57130], [68, 57270]]}, {"verse": 11, "start": 58359, "end": 65578, "text": "Y estas cosas les acontecieron en figura; y son escritas para nuestra advertencia, a quienes han llegado los fines de los siglos.", "words": [[0, 58359], [2, 58455], [8, 58675], [14, 59075], [18, 59295], [31, 60015], [34, 60135], [42, 60880], [44, 61003], [48, 61143], [57, 61723], [62, 61923], [70, 62123], [83, 63063], [85, 63423], [93, 63583], [97, 63863], [105, 64243], [109, 64403], [115, 64643], [118, 64843], [122, 64983]]}, {"verse": 12, "start": 65928, "end": 68632, "text": "Así que, el que piensa estar firme, mire no caiga.", "words": [[0, 65928], [4, 66151], [9, 66311], [12, 66371], [16, 66491], [23, 66851], [29, 67071], [36, 67424], [41, 67778], [44, 68131]]}, {"verse": 13, "start": 68982, "end": 80156, "text": "No os ha tomado tentación, sino humana: pero fiel es Dios, que no os dejará ser tentados más de lo que podéis llevar; antes dará también juntamente con la tentación la salida, para que podáis aguantar.", "words": [[0, 68982], [3, 69163], [6, 69363], [9, 69463], [16, 69823], [27, 70403], [32, 70743], [40, 71517], [45, 71660], [50, 71960], [53, 72100], [59, 72520], [63, 72580], [66, 72740], [69, 72840], [76, 73200], [80, 73360], [89, 73820], [93, 74040], [96, 74200], [99, 74300], [103, 74400], [110, 74720], [118, 75423], [124, 75733], [129, 76113], [137, 76373], [148, 76993], [152, 77213], [155, 77333], [165, 77813], [168, 77953], [176, 78413], [181, 78973], [185, 79113], [192, 79453]]}, {"verse": 14, "start": 80506, "end": 83256, "text": "Por tanto, amados míos, huid de la idolatría.", "words": [[0, 80506], [4, 80593], [11, 81013], [18, 81313], [24, 81973], [29, 82273], [32, 82393], [35, 82493]]}, {"verse": 15, "start": 83606, "end": 86687, "text": "Como a sabios hablo; juzgad vosotros lo que digo.", "words": [[0, 83606], [5, 83973], [7, 84133], [14, 84473], [21, 85157], [28, 85582], [37, 86022], [40, 86202], [44, 86322]]}, {"verse": 16, "start": 87037, "end": 95044, "text": "La copa de bendición que bendecimos, ¿no es la comunión de la sangre de Cristo? El pan que partimos, ¿no es la comunión del cuerpo de Cristo?", "words": [[0, 87037], [3, 87155], [8, 87515], [11, 87595], [21, 88075], [25, 88235], [37, 89175], [41, 89455], [44, 89595], [47, 89695], [56, 90135], [59, 90275], [62, 90375], [69, 90675], [72, 90815], [80, 91634], [83, 91772], [87, 91972], [91, 92152], [101, 92672], [105, 93212], [108, 93372], [111, 93472], [120, 93892], [124, 94032], [131, 94312], [134, 94512]]}, {"verse": 17, "start": 95394, "end": 102004, "text": "Porque hay un solo pan, nosotros, siendo muchos, somos un cuerpo; pues todos participamos de ese mismo pan.", "words": [[0, 95394], [7, 95627], [11, 95827], [14, 95967], [19, 96207], [24, 96467], [34, 97347], [41, 97547], [49, 98027], [55, 98587], [58, 98867], [66, 99611], [71, 99709], [77, 100029], [90, 100889], [93, 101109], [97, 101269], [103, 101569]]}, {"verse": 18, "start": 102354, "end": 108230, "text": "Mirad a Israel según la carne: los que comen de los sacrificios ¿no son partícipes con el altar?", "words": [[0, 102509], [6, 102699], [8, 102819], [15, 103179], [21, 103459], [24, 103699], [31, 104410], [35, 104546], [39, 104766], [45, 105026], [48, 105206], [52, 105326], [64, 106186], [68, 106446], [72, 106646], [83, 107366], [87, 107566], [90, 107686]]}, {"verse": 19, "start": 108580, "end": 113670, "text": "¿Qué pues digo? ¿Que el ídolo es algo? ¿o que sea algo lo que es sacrificado a los ídolos?", "words": [[0, 108580], [5, 108701], [10, 108921], [16, 109657], [21, 109774], [24, 109914], [30, 110174], [33, 110394], [39, 111079], [42, 111177], [46, 111277], [50, 111457], [55, 111717], [58, 111897], [62, 112017], [65, 112137], [77, 112797], [79, 112897], [83, 113017]]}, {"verse": 20, "start": 114020, "end": 123332, "text": "Antes digo que lo que los Gentiles sacrifican, a los demonios lo sacrifican, y no a Dios: y no querría que vosotros fueseis partícipes con los demonios.", "words": [[0, 114207], [6, 114397], [11, 114637], [15, 114837], [18, 114957], [22, 115097], [26, 115257], [35, 115757], [47, 116717], [49, 117177], [53, 117337], [62, 117857], [65, 117957], [77, 118737], [79, 118897], [82, 119077], [84, 119217], [90, 119938], [92, 120036], [95, 120216], [103, 120396], [107, 120636], [116, 121036], [124, 121576], [135, 122276], [139, 122456], [143, 122616]]}, {"verse": 21, "start": 123682, "end": 131760, "text": "No podéis beber la copa del Señor, y la copa de los demonios: no podéis ser partícipes de la mesa del Señor, y de la mesa de los demonios.", "words": [[0, 123682], [3, 123820], [10, 124140], [16, 124440], [19, 124680], [24, 125020], [28, 125140], [35, 125540], [37, 125805], [40, 125945], [45, 126285], [48, 126385], [52, 126505], [62, 127452], [65, 127555], [72, 127895], [76, 128135], [87, 128895], [90, 129055], [93, 129175], [98, 129435], [102, 129615], [109, 130015], [111, 130240], [114, 130360], [117, 130460], [122, 130740], [125, 130900], [129, 131020]]}, {"verse": 22, "start": 132110, "end": 135918, "text": "¿O provocaremos a celo al Señor? ¿Somos más fuertes que él?", "words": [[0, 132110], [3, 132231], [16, 132911], [18, 133151], [23, 133471], [26, 133571], [33, 134402], [40, 134741], [44, 134901], [52, 135481], [56, 135601]]}, {"verse": 23, "start": 136268, "end": 142634, "text": "Todo me es lícito, pero no todo conviene: todo me es lícito, pero no todo edifica.", "words": [[0, 136268], [5, 136523], [8, 136813], [11, 137103], [19, 137393], [24, 137493], [27, 137653], [32, 137873], [42, 138874], [47, 139199], [50, 139564], [53, 139929], [61, 140294], [66, 140314], [69, 140494], [74, 140714]]}, {"verse": 24, "start": 142984, "end": 145957, "text": "Ninguno busque su propio bien, sino el del otro.", "words": [[0, 142984], [8, 143448], [15, 143848], [18, 143988], [25, 144288], [31, 144948], [36, 145208], [39, 145368], [43, 145508]]}, {"verse": 25, "start": 146307, "end": 151593, "text": "De todo lo que se vende en la carnicería, comed, sin preguntar nada por causa de la conciencia;", "words": [[0, 146307], [3, 146424], [8, 146544], [11, 146744], [15, 146844], [18, 146984], [24, 147264], [27, 147364], [30, 147464], [42, 148444], [49, 149004], [53, 149204], [63, 149724], [68, 149944], [72, 150224], [78, 150484], [81, 150704], [84, 150784]]}, {"verse": 26, "start": 151943, "end": 154451, "text": "Porque del Señor es la tierra y todo lo que la llena.", "words": [[0, 151943], [7, 152123], [11, 152283], [17, 152523], [20, 152723], [23, 152843], [30, 153143], [32, 153463], [37, 153663], [40, 153843], [44, 153963], [47, 154063]]}, {"verse": 27, "start": 154801, "end": 163003, "text": "Y si algún no creyente os invita, y queréis ir, de todo lo que se os pone delante comed, sin preguntar nada por causa de la conciencia.", "words": [[0, 154801], [2, 154905], [5, 154985], [11, 155305], [14, 155545], [23, 156065], [26, 156225], [34, 157025], [36, 157265], [44, 157625], [48, 157925], [51, 158465], [56, 158645], [59, 158845], [63, 158965], [66, 159085], [69, 159165], [74, 159498], [82, 159832], [89, 160165], [93, 160645], [103, 161185], [108, 161405], [112, 161645], [118, 161905], [121, 162125], [124, 162205]]}, {"verse": 28, "start": 163353, "end": 173441, "text": "Pero si alguien os dice: «Esto fue sacrificado a los ídolos», no lo comáis, en atención a quien os avisó y por motivos de conciencia; porque del Señor es la tierra y todo lo que la llena.", "words": [[0, 163353], [5, 163470], [8, 163670], [16, 163880], [19, 164090], [25, 164778], [31, 165015], [35, 165235], [47, 165915], [49, 166015], [53, 166135], [62, 166895], [65, 166975], [68, 167095], [76, 167895], [79, 168015], [88, 168355], [90, 168635], [96, 168775], [99, 168915], [105, 169375], [107, 169475], [111, 169615], [119, 170095], [122, 170175], [134, 171153], [141, 171317], [145, 171477], [151, 171737], [154, 171937], [157, 172037], [164, 172337], [166, 172477], [171, 172657], [174, 172837], [178, 172937], [181, 173037]]}, {"verse": 29, "start": 173791, "end": 180278, "text": "La conciencia, digo, no tuya, sino del otro. Pues ¿por qué ha de ser juzgada mi libertad por otra conciencia?", "words": [[0, 173877], [3, 173977], [15, 174577], [21, 175097], [24, 175277], [30, 175897], [35, 176157], [39, 176397], [45, 177013], [50, 177142], [55, 177362], [59, 177582], [62, 177702], [65, 177802], [69, 177982], [77, 178462], [80, 178622], [89, 179162], [93, 179322], [98, 179482]]}, {"verse": 30, "start": 180628, "end": 185691, "text": "Y si yo con agradecimiento participo, ¿por qué se habla mal de mí por lo que doy gracias?", "words": [[0, 180628], [2, 180765], [5, 180919], [8, 181072], [12, 181212], [27, 181952], [38, 183152], [43, 183232], [47, 183392], [50, 183532], [56, 183772], [60, 183972], [63, 184152], [66, 184352], [70, 184552], [73, 184692], [77, 184812], [81, 185012]]}, {"verse": 31, "start": 186041, "end": 190802, "text": "Si pues coméis, o bebéis, o hacéis otra cosa, hacedlo todo a gloria de Dios.", "words": [[0, 186041], [3, 186191], [8, 186431], [16, 186851], [18, 187011], [26, 187411], [28, 187611], [35, 187991], [40, 188191], [46, 189011], [54, 189471], [59, 189691], [61, 189851], [68, 190171], [71, 190311]]}, {"verse": 32, "start": 191152, "end": 195546, "text": "No seáis motivo de tropiezo a judíos, ni a Gentiles, ni a la iglesia de Dios:", "words": [[0, 191152], [3, 191319], [9, 191529], [16, 191969], [19, 192229], [28, 192749], [30, 192869], [38, 193449], [41, 193529], [43, 193609], [53, 194289], [56, 194369], [58, 194449], [61, 194529], [69, 194909], [72, 195049]]}, {"verse": 33, "start": 195896, "end": 203282, "text": "Como también yo en todas las cosas complazco a todos, no procurando mi propio beneficio, sino el de muchos, para que sean salvos.", "words": [[0, 195896], [5, 196053], [13, 196393], [16, 196593], [19, 196713], [25, 196873], [29, 197193], [35, 197693], [45, 198193], [47, 198293], [54, 198953], [57, 199093], [68, 199653], [71, 199833], [78, 200053], [89, 200893], [94, 201193], [97, 201373], [100, 201493], [108, 201773], [113, 202273], [117, 202413], [122, 202613]]}]}