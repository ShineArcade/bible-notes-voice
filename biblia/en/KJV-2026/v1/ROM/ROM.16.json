{"book": "ROM", "chapter": 16, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 166151, "verses": [{"verse": 1, "start": 300, "end": 5012, "text": "I commend to you Phebe our sister, which is a servant of the church which is at Cenchrea:", "words": [[0, 300], [2, 440], [10, 680], [13, 920], [17, 1170], [23, 1420], [27, 1600], [35, 2320], [41, 2480], [44, 2620], [46, 2720], [54, 2960], [57, 3180], [61, 3300], [68, 3600], [74, 3980], [77, 4120], [80, 4585]]}, {"verse": 2, "start": 5362, "end": 14358, "text": "That you receive her in the Lord, as becomes saints, and that you assist her in whatever business she has need of you: for she has been a helper of many, and of myself also.", "words": [[0, 5362], [5, 5480], [9, 5580], [17, 5920], [21, 6120], [24, 6240], [28, 6360], [34, 6620], [37, 6900], [45, 7180], [53, 7660], [57, 8100], [62, 8220], [66, 8340], [73, 8640], [77, 8880], [80, 9000], [89, 9240], [98, 9660], [102, 9850], [106, 10040], [111, 10221], [114, 10380], [119, 10944], [123, 11047], [127, 11207], [131, 11387], [136, 11687], [138, 11967], [145, 12247], [148, 12427], [154, 12707], [158, 13167], [161, 13287], [168, 13707]]}, {"verse": 3, "start": 14708, "end": 17874, "text": "Greet Priscilla and Aquila my helpers in Christ Jesus:", "words": [[0, 14894], [6, 15114], [16, 15474], [20, 15714], [27, 16254], [30, 16334], [38, 16794], [41, 16954], [48, 17154]]}, {"verse": 4, "start": 18224, "end": 24888, "text": "Who have for my life laid down their own necks: to whom not only I give thanks, but also all the churches of the Gentiles.", "words": [[0, 18224], [4, 18326], [9, 18486], [13, 18626], [16, 18766], [21, 19086], [26, 19366], [31, 19626], [37, 19806], [41, 19946], [48, 20681], [51, 20777], [56, 20917], [60, 21117], [65, 21397], [67, 21557], [72, 21717], [80, 22417], [84, 22657], [89, 22977], [93, 23257], [97, 23417], [106, 23777], [109, 23997], [113, 24097]]}, {"verse": 5, "start": 25238, "end": 32176, "text": "Likewise greet the church that is in their house. Salute my wellbeloved Epaenetus, who is the firstfruits of Achaia to Christ.", "words": [[0, 25238], [9, 25820], [15, 26040], [19, 26240], [26, 26500], [31, 26780], [34, 26940], [37, 27040], [43, 27200], [50, 27925], [57, 28341], [60, 28863], [72, 29384], [83, 29906], [87, 30006], [90, 30126], [94, 30446], [106, 30766], [109, 31116], [116, 31466], [119, 31606]]}, {"verse": 6, "start": 32526, "end": 34799, "text": "Greet Mary, who bestowed much labour on us.", "words": [[0, 32654], [6, 32814], [12, 33054], [16, 33274], [25, 33694], [30, 33964], [37, 34234], [40, 34474]]}, {"verse": 7, "start": 35149, "end": 42193, "text": "Salute Andronicus and Junia, my kinsmen, and my fellowprisoners, who are of note among the apostles, who also were in Christ before me.", "words": [[0, 35149], [7, 35683], [18, 36223], [22, 36423], [29, 37063], [32, 37143], [41, 37643], [45, 37823], [48, 38304], [65, 38786], [69, 38898], [73, 38978], [76, 39078], [81, 39338], [87, 39578], [91, 39778], [101, 40118], [105, 40678], [110, 40898], [115, 41098], [118, 41218], [125, 41518], [132, 41838]]}, {"verse": 8, "start": 42543, "end": 44547, "text": "Greet Amplias my beloved in the Lord.", "words": [[0, 42543], [6, 42847], [14, 43347], [17, 43447], [25, 43787], [28, 44067], [32, 44167]]}, {"verse": 9, "start": 44897, "end": 48821, "text": "Salute Urbane, our helper in Christ, and Stachys my beloved.", "words": [[0, 44897], [7, 45361], [15, 45831], [19, 45971], [26, 46371], [29, 46571], [37, 47451], [41, 47751], [49, 48051], [52, 48231]]}, {"verse": 10, "start": 49171, "end": 54465, "text": "Salute Apelles approved in Christ. Salute them which are of Aristobulus’ household.", "words": [[0, 49171], [7, 49643], [15, 50153], [24, 50533], [27, 50893], [35, 51663], [42, 52095], [47, 52415], [53, 52555], [57, 52835], [60, 53315], [73, 53795]]}, {"verse": 11, "start": 54815, "end": 60597, "text": "Salute Herodion my kinsman. Greet them that be of the household of Narcissus, which are in the Lord.", "words": [[0, 54815], [7, 55273], [16, 55733], [19, 56193], [28, 56995], [34, 57261], [39, 57541], [44, 57721], [47, 57901], [50, 58001], [54, 58141], [64, 58481], [67, 58761], [78, 59701], [84, 59841], [88, 60001], [91, 60101], [95, 60221]]}, {"verse": 12, "start": 60947, "end": 67682, "text": "Salute Tryphena and Tryphosa, who labour in the Lord. Salute the beloved Persis, which laboured much in the Lord.", "words": [[0, 60947], [7, 61387], [16, 61867], [20, 62347], [30, 62827], [34, 63147], [41, 63467], [44, 63847], [48, 63987], [54, 64607], [61, 65052], [65, 65172], [73, 65562], [81, 65952], [87, 66382], [96, 66812], [101, 67112], [104, 67252], [108, 67372]]}, {"verse": 13, "start": 68032, "end": 71477, "text": "Salute Rufus chosen in the Lord, and his mother and mine.", "words": [[0, 68032], [7, 68368], [13, 68828], [20, 69168], [23, 69428], [27, 69568], [33, 69828], [37, 70208], [41, 70328], [48, 70628], [52, 70928]]}, {"verse": 14, "start": 71827, "end": 77253, "text": "Salute Asyncritus, Phlegon, Hermas, Patrobas, Hermes, and the brethren which are with them.", "words": [[0, 71827], [7, 72255], [19, 72945], [28, 73635], [36, 74315], [46, 75035], [54, 75735], [58, 75815], [62, 75955], [71, 76215], [77, 76555], [81, 76695], [86, 76895]]}, {"verse": 15, "start": 77603, "end": 83118, "text": "Salute Philologus, and Julia, Nereus, and his sister, and Olympas, and all the saints which are with them.", "words": [[0, 77876], [7, 78182], [19, 78489], [23, 78589], [30, 79269], [38, 79949], [42, 80029], [46, 80149], [54, 80869], [58, 81339], [67, 81809], [71, 81869], [75, 82009], [79, 82109], [86, 82309], [92, 82549], [96, 82689], [101, 82869]]}, {"verse": 16, "start": 83468, "end": 87045, "text": "Salute one another with a holy kiss. The churches of Christ salute you.", "words": [[0, 83468], [7, 83784], [11, 83984], [19, 84304], [24, 84624], [26, 84744], [31, 84924], [37, 85590], [41, 85710], [50, 86130], [53, 86230], [60, 86450], [67, 86710]]}, {"verse": 17, "start": 87395, "end": 93990, "text": "Now I beg you, brethren, mark them which cause divisions and offences contrary to the doctrine which you have learned; and avoid them.", "words": [[0, 87395], [4, 87606], [6, 87806], [10, 88046], [15, 88226], [25, 88826], [30, 89106], [35, 89346], [41, 89566], [47, 89846], [57, 90286], [61, 90596], [70, 90906], [79, 91486], [82, 91766], [86, 91886], [95, 92206], [101, 92446], [105, 92606], [110, 92746], [119, 93292], [123, 93414], [129, 93674]]}, {"verse": 18, "start": 94340, "end": 101607, "text": "For they that are such serve not our Lord Jesus Christ, but their own belly; and by good words and fair speeches deceive the hearts of the simple.", "words": [[0, 94340], [4, 94465], [9, 94665], [14, 94825], [18, 94965], [23, 95205], [29, 95545], [33, 95785], [37, 95985], [42, 96185], [48, 96425], [56, 97185], [60, 97305], [66, 97465], [70, 97625], [77, 98313], [81, 98451], [84, 98591], [89, 98871], [95, 99211], [99, 99371], [104, 99591], [113, 100051], [121, 100431], [125, 100651], [132, 100871], [135, 101032], [139, 101151]]}, {"verse": 19, "start": 101957, "end": 110079, "text": "For your obedience is come abroad to all men. I am glad therefore on your behalf: but yet I would have you wise to that which is good, and simple concerning evil.", "words": [[0, 101957], [4, 102060], [9, 102180], [19, 102530], [22, 102880], [27, 103060], [34, 103380], [37, 103620], [41, 103860], [46, 104510], [48, 104653], [51, 104733], [56, 105413], [66, 105513], [69, 105633], [74, 105733], [82, 106391], [86, 106527], [90, 106687], [92, 106867], [98, 107027], [103, 107207], [107, 107327], [112, 107567], [115, 107767], [120, 107987], [126, 108167], [129, 108327], [135, 108567], [139, 108867], [146, 109247], [157, 109587]]}, {"verse": 20, "start": 110429, "end": 116688, "text": "And the God of peace shall bruise Satan under your feet shortly. The grace of our Lord Jesus Christ be with you. Amen.", "words": [[0, 110429], [4, 110533], [8, 110633], [12, 110853], [15, 110953], [21, 111233], [27, 111543], [34, 111853], [40, 112313], [46, 112473], [51, 112653], [56, 112873], [65, 113674], [69, 113772], [75, 113992], [78, 114192], [82, 114332], [87, 114492], [93, 114772], [100, 115152], [103, 115472], [108, 115712], [113, 116190]]}, {"verse": 21, "start": 117038, "end": 122995, "text": "Timotheus my workfellow, and Lucius, and Jason, and Sosipater, my kinsmen, salute you.", "words": [[0, 117402], [10, 117772], [13, 118202], [25, 118632], [29, 118712], [37, 119572], [41, 119692], [48, 120092], [52, 120802], [63, 121512], [66, 121672], [75, 122332], [82, 122592]]}, {"verse": 22, "start": 123345, "end": 126451, "text": "I Tertius, who wrote this epistle, salute you in the Lord.", "words": [[0, 123345], [2, 123660], [11, 124010], [15, 124130], [21, 124310], [26, 124510], [35, 125310], [42, 125610], [46, 125770], [49, 125930], [53, 126030]]}, {"verse": 23, "start": 126801, "end": 133615, "text": "Gaius my host, and of the whole church, salutes you. Erastus the chamberlain of the city salutes you, and Quartus a brother.", "words": [[0, 126801], [6, 127147], [9, 127307], [15, 127847], [19, 127907], [22, 127987], [26, 128107], [32, 128247], [40, 128637], [48, 129027], [53, 129663], [61, 130144], [65, 130284], [77, 130824], [80, 130984], [84, 131124], [89, 131324], [97, 131884], [102, 132104], [106, 132564], [114, 133024], [116, 133164]]}, {"verse": 24, "start": 133965, "end": 137199, "text": "The grace of our Lord Jesus Christ be with you all. Amen.", "words": [[0, 133965], [4, 134028], [10, 134288], [13, 134488], [17, 134628], [22, 134868], [28, 135168], [35, 135568], [38, 135868], [43, 136068], [47, 136188], [52, 136757]]}, {"verse": 25, "start": 137549, "end": 146714, "text": "Now to him that is of power to establish you according to my gospel, and the preaching of Jesus Christ, according to the revelation of the mystery, which was kept secret since the world began,", "words": [[0, 137549], [4, 137786], [7, 137966], [11, 138146], [16, 138346], [19, 138486], [22, 138606], [28, 138966], [31, 139166], [41, 139526], [45, 139746], [55, 139966], [58, 140166], [61, 140326], [69, 140686], [73, 140961], [77, 141101], [87, 141421], [90, 141621], [96, 141841], [104, 142261], [114, 142821], [117, 143061], [121, 143181], [132, 143481], [135, 143801], [139, 143901], [148, 144663], [154, 144794], [158, 144954], [163, 145154], [170, 145534], [176, 145794], [180, 145954], [186, 146154]]}, {"verse": 26, "start": 147064, "end": 155857, "text": "But now is made manifest, and by the scriptures of the prophets, according to the commandment of the everlasting God, made known to all nations for the obedience of faith:", "words": [[0, 147064], [4, 147162], [8, 147422], [11, 147582], [16, 147782], [26, 148722], [30, 148782], [33, 148942], [37, 149102], [48, 149442], [51, 149702], [55, 149822], [65, 150602], [75, 150882], [78, 151122], [82, 151242], [94, 151742], [97, 151922], [101, 152042], [113, 152442], [118, 153282], [123, 153462], [129, 153702], [132, 153902], [136, 154162], [144, 154542], [148, 154802], [152, 154922], [162, 155222], [165, 155542]]}, {"verse": 27, "start": 156207, "end": 165751, "text": "To God only wise, be glory through Jesus Christ for ever. Amen. Written to the Romans from Corinthus, and sent by Phebe servant of the church at Cenchrea.", "words": [[0, 156207], [3, 156300], [7, 156520], [12, 156840], [18, 157640], [21, 157760], [27, 158080], [35, 158380], [41, 158720], [48, 159137], [52, 159553], [58, 160443], [64, 161579], [72, 161879], [75, 162019], [79, 162139], [86, 162399], [91, 162639], [102, 163259], [106, 163399], [111, 163579], [114, 163839], [120, 164099], [128, 164399], [131, 164619], [135, 164719], [142, 164959], [145, 165359]]}]}