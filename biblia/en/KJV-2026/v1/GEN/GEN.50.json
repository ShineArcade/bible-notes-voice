{"book": "GEN", "chapter": 50, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 217222, "verses": [{"verse": 1, "start": 300, "end": 4891, "text": "And Joseph fell upon his father’s face, and wept upon him, and kissed him.", "words": [[0, 300], [4, 451], [11, 751], [16, 1131], [21, 1411], [25, 1651], [34, 2171], [40, 2411], [44, 3011], [49, 3371], [54, 3551], [59, 3911], [63, 4171], [70, 4491]]}, {"verse": 2, "start": 5241, "end": 11314, "text": "And Joseph commanded his servants the physicians to embalm his father: and the physicians embalmed Israel.", "words": [[0, 5241], [4, 5368], [11, 5648], [21, 6168], [25, 6388], [34, 6768], [38, 7008], [49, 7468], [52, 7808], [59, 8288], [63, 8408], [71, 9214], [75, 9454], [79, 9554], [90, 9934], [99, 10714]]}, {"verse": 3, "start": 11664, "end": 20795, "text": "And forty days were fulfilled for him; for so are fulfilled the days of those which are embalmed: and the Egyptians mourned for him threescore and ten days.", "words": [[0, 11664], [4, 11859], [10, 12089], [15, 12449], [20, 12749], [30, 13149], [34, 13489], [39, 14022], [43, 14143], [46, 14403], [50, 14603], [60, 14963], [64, 15263], [69, 15563], [72, 15783], [78, 16063], [84, 16343], [88, 16503], [98, 17455], [102, 17582], [106, 17682], [116, 18022], [124, 18682], [128, 18822], [132, 19189], [143, 19555], [147, 19922], [151, 20142]]}, {"verse": 4, "start": 21145, "end": 31620, "text": "And when the days of his mourning were past, Joseph spoke to the house of Pharaoh, saying, If now I have found grace in your eyes, speak, please, in the ears of Pharaoh, saying,", "words": [[0, 21145], [4, 21273], [9, 21413], [13, 21553], [18, 21893], [21, 22073], [25, 22193], [34, 22573], [39, 23113], [45, 23653], [52, 24033], [58, 24553], [61, 24793], [65, 24933], [71, 25173], [74, 25353], [83, 25993], [91, 26712], [94, 26855], [98, 27035], [100, 27195], [105, 27335], [111, 27515], [117, 27775], [120, 27975], [125, 28115], [131, 28595], [138, 28875], [146, 29435], [149, 29735], [153, 29875], [158, 30215], [161, 30455], [170, 30835]]}, {"verse": 5, "start": 31970, "end": 43536, "text": "My father made me swear, saying, Lo, I die: in my grave which I have dug for me in the land of Canaan, there shall you bury me. Now therefore let me go up, please, and bury my father, and I will come again.", "words": [[0, 31970], [3, 32111], [10, 32411], [15, 32671], [18, 32791], [25, 33071], [33, 33531], [37, 33991], [39, 34111], [44, 34774], [47, 34901], [50, 35041], [56, 35441], [62, 35581], [64, 35741], [69, 35901], [73, 36101], [77, 36321], [80, 36521], [83, 36681], [87, 36781], [92, 37001], [95, 37121], [103, 38101], [109, 38261], [115, 38561], [119, 38741], [124, 39001], [128, 39526], [132, 39733], [142, 40153], [146, 40393], [149, 40553], [152, 40733], [156, 40933], [164, 41173], [168, 41433], [173, 41633], [176, 41833], [184, 42173], [188, 42633], [190, 42773], [195, 42893], [200, 43093]]}, {"verse": 6, "start": 43816, "end": 49542, "text": "And Pharaoh said, Go up, and bury your father, according as he made you swear.", "words": [[0, 43816], [4, 43970], [12, 44390], [18, 46035], [21, 46166], [25, 46406], [29, 46666], [34, 47006], [39, 47226], [47, 47926], [57, 48366], [60, 48666], [63, 48786], [68, 48986], [72, 49106]]}, {"verse": 7, "start": 49822, "end": 58263, "text": "¶ And Joseph went up to bury his father: and with him went up all the servants of Pharaoh, the elders of his house, and all the elders of the land of Egypt,", "words": [[2, 49822], [6, 49963], [13, 50283], [18, 50583], [21, 50783], [24, 50923], [29, 51163], [33, 51403], [41, 52242], [45, 52562], [50, 52762], [54, 52882], [59, 53082], [62, 53242], [66, 53502], [70, 53662], [79, 53962], [82, 54242], [91, 54822], [95, 54902], [102, 55142], [105, 55422], [109, 55562], [116, 56182], [120, 56362], [124, 56582], [128, 56722], [135, 56982], [138, 57262], [142, 57362], [147, 57582], [150, 57742]]}, {"verse": 8, "start": 58613, "end": 67931, "text": "And all the house of Joseph, and his brethren, and his father’s house: only their little ones, and their flocks, and their herds, they left in the land of Goshen.", "words": [[0, 58613], [4, 58747], [8, 58927], [12, 59087], [18, 59347], [21, 59527], [29, 59947], [33, 60507], [37, 60667], [47, 61107], [51, 61492], [55, 61652], [64, 62212], [71, 62877], [76, 63141], [82, 63361], [89, 63641], [95, 64021], [99, 64421], [105, 64581], [113, 65161], [117, 65621], [123, 65781], [130, 66281], [135, 66481], [140, 66741], [143, 66941], [147, 67021], [152, 67261], [155, 67361]]}, {"verse": 9, "start": 68281, "end": 72769, "text": "And there went up with him both chariots and horsemen: and it was a very great company.", "words": [[0, 68281], [4, 68428], [10, 68568], [15, 68788], [18, 68948], [23, 69168], [27, 69288], [32, 69488], [41, 70148], [45, 70388], [55, 71225], [59, 71332], [62, 71432], [66, 71572], [68, 71692], [73, 71932], [79, 72212]]}, {"verse": 10, "start": 73119, "end": 82396, "text": "And they came to the threshingfloor of Atad, which is beyond Jordan, and there they mourned with a great and very bitter lamentation: and he made a mourning for his father seven days.", "words": [[0, 73119], [4, 73271], [9, 73371], [14, 73591], [17, 73771], [21, 74141], [36, 74511], [39, 74711], [45, 75431], [51, 75591], [54, 75711], [61, 76031], [69, 76771], [73, 76991], [79, 77151], [84, 77311], [92, 77671], [97, 77791], [99, 77871], [105, 78151], [109, 78351], [114, 78611], [121, 78871], [134, 79965], [138, 80087], [141, 80167], [146, 80347], [148, 80527], [157, 80707], [161, 80947], [165, 81087], [172, 81387], [178, 81747]]}, {"verse": 11, "start": 82746, "end": 95989, "text": "And when the inhabitants of the land, the Canaanites, saw the mourning in the floor of Atad, they said, This is a grievous mourning to the Egyptians: therefore the name of it was called Abel-mizraim, which is beyond Jordan.", "words": [[0, 82746], [4, 82892], [9, 83032], [13, 83152], [25, 83652], [28, 83952], [32, 84072], [38, 84892], [42, 85012], [54, 86212], [58, 86452], [62, 86712], [71, 86972], [74, 87192], [78, 87272], [84, 87512], [87, 87712], [93, 88652], [98, 88792], [104, 89493], [109, 89651], [112, 89771], [114, 89911], [123, 90201], [132, 90491], [135, 90711], [139, 90851], [150, 91835], [160, 92112], [164, 92372], [169, 92632], [172, 92772], [175, 92892], [179, 93072], [186, 93872], [200, 94672], [206, 94832], [209, 94992], [216, 95392]]}, {"verse": 12, "start": 96339, "end": 99334, "text": "And his sons did to him according as he commanded them:", "words": [[0, 96339], [4, 96484], [8, 96624], [13, 96964], [17, 97224], [20, 97424], [24, 97724], [34, 98144], [37, 98464], [40, 98564], [50, 98984]]}, {"verse": 13, "start": 99684, "end": 113309, "text": "For his sons carried him into the land of Canaan, and buried him in the cave of the field of Machpelah, which Abraham bought with the field for a possession of a buryingplace of Ephron the Hittite, before Mamre.", "words": [[0, 99684], [4, 99811], [8, 99971], [13, 100371], [21, 100831], [25, 101131], [30, 101411], [34, 101591], [39, 101971], [42, 102211], [50, 103051], [54, 103331], [61, 103691], [65, 104011], [68, 104211], [72, 104331], [77, 104611], [80, 104891], [84, 105011], [90, 105391], [93, 106011], [104, 106779], [110, 106943], [118, 107383], [125, 107843], [130, 108083], [134, 108243], [140, 108623], [144, 108843], [146, 108963], [157, 109383], [160, 109643], [162, 110083], [175, 110523], [178, 110743], [185, 111223], [189, 111383], [198, 111863], [205, 112523]]}, {"verse": 14, "start": 113659, "end": 121163, "text": "¶ And Joseph returned into Egypt, he, and his brethren, and all that went up with him to bury his father, after he had buried his father.", "words": [[2, 113659], [6, 113797], [13, 114097], [22, 114457], [27, 114837], [34, 115197], [38, 115617], [42, 116137], [46, 116277], [56, 116657], [60, 117117], [64, 117297], [69, 117497], [74, 117677], [77, 117877], [82, 118057], [86, 118217], [89, 118357], [94, 118597], [98, 118837], [106, 119217], [112, 119837], [115, 120057], [119, 120157], [126, 120437], [130, 120637]]}, {"verse": 15, "start": 121513, "end": 130628, "text": "¶ And when Joseph’s brethren saw that their father was dead, they said, Joseph will perhaps hate us, and will certainly requite us all the evil which we did to him.", "words": [[2, 121513], [6, 121646], [11, 121766], [20, 122306], [29, 122646], [33, 123066], [38, 123246], [44, 123406], [51, 123706], [55, 123986], [61, 124746], [66, 124826], [72, 125426], [79, 125806], [84, 126106], [92, 126506], [97, 126846], [101, 127146], [105, 127586], [110, 127726], [120, 128076], [128, 128426], [131, 128726], [135, 128986], [139, 129166], [144, 129466], [150, 129746], [153, 129946], [157, 130146], [160, 130346]]}, {"verse": 16, "start": 130978, "end": 136094, "text": "And they sent a messenger to Joseph, saying, Your father did command before he died, saying,", "words": [[0, 130978], [4, 131124], [9, 131224], [14, 131464], [16, 131584], [26, 131904], [29, 132124], [37, 132484], [45, 133244], [50, 133484], [57, 133824], [61, 134104], [69, 134444], [76, 134844], [79, 135064], [85, 135484]]}, {"verse": 17, "start": 136444, "end": 152352, "text": "So shall you say to Joseph, Forgive, please now, the trespass of your brethren, and their sin; for they did to you evil: and now, we pray you, forgive the trespass of the servants of the God of your father. And Joseph wept when they spoke to him.", "words": [[0, 136444], [3, 136611], [9, 136851], [13, 137011], [17, 137211], [20, 137311], [28, 138051], [37, 138471], [44, 138711], [49, 139351], [53, 139431], [62, 139971], [65, 140211], [70, 140331], [80, 140711], [84, 141071], [90, 141231], [95, 141951], [99, 142079], [104, 142279], [108, 142559], [111, 142799], [115, 143099], [121, 144062], [125, 144241], [130, 144541], [133, 144841], [138, 145181], [143, 145861], [151, 146301], [155, 146621], [164, 147401], [167, 147661], [171, 147821], [180, 148201], [183, 148481], [187, 148621], [191, 148941], [194, 149101], [199, 149281], [207, 150161], [211, 150322], [218, 150662], [223, 151102], [228, 151302], [233, 151462], [239, 151722], [242, 151962]]}, {"verse": 18, "start": 152702, "end": 159375, "text": "And his brethren also went and fell down before his face; and they said, Behold, we are your servants.", "words": [[0, 152702], [4, 152851], [8, 152991], [17, 153411], [22, 153831], [27, 154131], [31, 154311], [36, 154531], [41, 154831], [48, 155131], [52, 155391], [58, 156195], [62, 156324], [67, 156504], [73, 156984], [81, 157804], [84, 157984], [88, 158324], [93, 158584]]}, {"verse": 19, "start": 159725, "end": 163937, "text": "And Joseph said to them, Fear not: for am I in the place of God?", "words": [[0, 159725], [4, 159850], [11, 160170], [16, 160490], [19, 160690], [25, 161271], [30, 161453], [35, 162225], [39, 162354], [42, 162634], [44, 162814], [47, 163014], [51, 163094], [57, 163334], [60, 163494]]}, {"verse": 20, "start": 164287, "end": 171908, "text": "But as for you, you thought evil against me; but God meant it to good, to bring to pass, as it is this day, to save much people alive.", "words": [[0, 164287], [4, 164392], [7, 164512], [11, 164672], [16, 165092], [20, 165192], [28, 165372], [33, 165692], [41, 166012], [45, 166623], [49, 166799], [53, 167019], [59, 167279], [62, 167439], [65, 167619], [71, 168099], [74, 168239], [80, 168479], [83, 168659], [89, 169259], [92, 169439], [95, 169599], [98, 169739], [103, 169899], [108, 170479], [111, 170579], [116, 170839], [121, 171099], [128, 171379]]}, {"verse": 21, "start": 172258, "end": 179862, "text": "Now therefore do not fear: I will nourish you, and your little ones. And he comforted them, and spoke kindly to them.", "words": [[0, 172258], [4, 172393], [14, 173053], [17, 173253], [21, 173433], [27, 174140], [29, 174297], [34, 174457], [42, 174857], [47, 174997], [51, 175337], [56, 175477], [63, 175717], [69, 176979], [73, 177109], [76, 177229], [86, 177789], [92, 177989], [96, 178329], [102, 178649], [109, 179109], [112, 179469]]}, {"verse": 22, "start": 180212, "end": 186397, "text": "¶ And Joseph dwelt in Egypt, he, and his father’s house: and Joseph lived a hundred and ten years.", "words": [[2, 180212], [6, 180354], [13, 180694], [19, 181174], [22, 181354], [29, 182034], [33, 182294], [37, 182534], [41, 182674], [50, 183174], [57, 183865], [61, 184008], [68, 184328], [74, 184548], [76, 184768], [84, 184988], [88, 185208], [92, 185428]]}, {"verse": 23, "start": 186747, "end": 195002, "text": "And Joseph saw Ephraim’s children of the third generation: the children also of Machir the son of Manasseh were brought up upon Joseph’s knees.", "words": [[0, 186747], [4, 186890], [11, 187210], [15, 187570], [25, 188170], [34, 188470], [37, 188690], [41, 188830], [47, 189050], [59, 190336], [63, 190419], [72, 190739], [77, 191099], [80, 191499], [87, 191899], [91, 191979], [95, 192219], [98, 192319], [107, 192899], [112, 192999], [120, 193279], [123, 193459], [128, 193759], [137, 194359]]}, {"verse": 24, "start": 195352, "end": 204135, "text": "And Joseph said to his brethren, I die: and God will surely visit you, and bring you out of this land to the land which he swore to Abraham, to Isaac, and to Jacob.", "words": [[0, 195352], [4, 195501], [11, 195821], [16, 196141], [19, 196341], [23, 196481], [33, 197358], [35, 197498], [40, 198153], [44, 198252], [48, 198492], [53, 198692], [60, 198992], [66, 199332], [71, 199592], [75, 199812], [81, 199992], [85, 200152], [89, 200312], [92, 200392], [97, 200572], [102, 200832], [105, 201012], [109, 201112], [114, 201352], [120, 201532], [123, 201632], [129, 201932], [132, 202092], [141, 202492], [144, 203012], [151, 203392], [155, 203712], [158, 203852]]}, {"verse": 25, "start": 204415, "end": 210829, "text": "And Joseph took an oath of the children of Israel, saying, God will surely visit you, and you shall carry up my bones from here.", "words": [[0, 204415], [4, 204563], [11, 204883], [16, 205163], [19, 205323], [24, 205523], [27, 205683], [31, 205783], [40, 206103], [43, 206283], [51, 206783], [59, 207483], [63, 207663], [68, 207883], [75, 208223], [81, 208483], [86, 208763], [90, 209163], [94, 209303], [100, 209463], [106, 209723], [109, 209903], [112, 210043], [118, 210283], [123, 210503]]}, {"verse": 26, "start": 211109, "end": 216822, "text": "So Joseph died, being a hundred and ten years old: and they embalmed him, and he was put in a coffin in Egypt.", "words": [[0, 211179], [3, 211249], [10, 211629], [16, 211929], [22, 212069], [24, 212209], [32, 212349], [36, 212489], [40, 212629], [46, 213069], [51, 213799], [55, 213940], [60, 214080], [69, 214640], [74, 215020], [78, 215160], [81, 215240], [85, 215360], [89, 215560], [92, 215680], [94, 215780], [101, 216100], [104, 216300]]}]}