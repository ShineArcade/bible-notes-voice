{"book": "JHN", "chapter": 16, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 243486, "verses": [{"verse": 1, "start": 300, "end": 3847, "text": "These things have I spoken to you, that you should not be offended.", "words": [[0, 300], [6, 454], [13, 834], [18, 1054], [20, 1194], [27, 1494], [30, 1794], [35, 2354], [40, 2574], [44, 2714], [51, 2854], [55, 3074], [58, 3274]]}, {"verse": 2, "start": 4297, "end": 11255, "text": "They shall put you out of the synagogues: yes, the time comes, that whoever kills you will think that he does God service.", "words": [[0, 4297], [5, 4381], [11, 4541], [15, 4761], [19, 4921], [23, 5141], [26, 5241], [30, 5381], [42, 6463], [47, 6887], [51, 6947], [56, 7187], [63, 7627], [68, 8287], [76, 8547], [82, 8947], [86, 9207], [91, 9387], [97, 9667], [102, 9867], [105, 10027], [110, 10357], [114, 10687]]}, {"verse": 3, "start": 11705, "end": 16095, "text": "And these things will they do to you, because they have not known the Father, nor me.", "words": [[0, 11705], [4, 11849], [10, 12089], [17, 12449], [22, 12669], [27, 12829], [30, 13029], [33, 13209], [38, 13629], [46, 13949], [51, 14229], [56, 14409], [60, 14609], [66, 14809], [70, 14989], [78, 15549], [82, 15709]]}, {"verse": 4, "start": 16545, "end": 26764, "text": "But these things have I told you, that when the time shall come, you may remember that I told you of them. And these things I said not to you at the beginning, because I was with you.", "words": [[0, 16545], [4, 16644], [10, 16864], [17, 17204], [22, 17404], [24, 17544], [29, 17784], [34, 18634], [39, 18844], [44, 19024], [48, 19164], [53, 19444], [59, 19644], [65, 20324], [69, 20504], [73, 20664], [82, 21044], [87, 21344], [89, 21464], [94, 21684], [98, 21904], [101, 22064], [107, 22732], [111, 22878], [117, 23118], [124, 23418], [126, 23598], [131, 23878], [135, 24098], [138, 24318], [142, 24518], [145, 24698], [149, 24798], [160, 25498], [168, 25818], [170, 26058], [174, 26198], [179, 26398]]}, {"verse": 5, "start": 27214, "end": 32654, "text": "But now I go my way to him that sent me; and none of you asks me, Where are you going?", "words": [[0, 27214], [4, 27354], [8, 27674], [10, 28034], [13, 28214], [16, 28394], [20, 28574], [23, 28734], [27, 28934], [32, 29134], [37, 29374], [41, 30011], [45, 30153], [50, 30373], [53, 30533], [57, 30673], [62, 30953], [66, 31573], [72, 31833], [76, 31993], [80, 32113]]}, {"verse": 6, "start": 33104, "end": 37276, "text": "But because I have said these things to you, sorrow has filled your heart.", "words": [[0, 33104], [4, 33304], [12, 33604], [14, 33884], [19, 34004], [24, 34224], [30, 34504], [37, 34864], [40, 35104], [45, 35644], [52, 36024], [56, 36344], [63, 36584], [68, 36824]]}, {"verse": 7, "start": 37726, "end": 47645, "text": "Nevertheless I tell you the truth; It is expedient for you that I go away: for if I go not away, the Comforter will not come to you; but if I depart, I will send him to you.", "words": [[0, 37726], [13, 38442], [15, 38622], [20, 38842], [24, 39002], [28, 39142], [35, 39862], [38, 39962], [41, 40102], [51, 40722], [55, 40922], [59, 41102], [64, 41302], [66, 41422], [69, 41622], [75, 42396], [79, 42503], [82, 42663], [84, 42763], [87, 42963], [91, 43123], [97, 43744], [101, 43843], [111, 44244], [116, 44383], [120, 44563], [125, 44784], [128, 44963], [133, 45515], [137, 45596], [140, 45716], [142, 45816], [150, 46536], [152, 46616], [157, 46736], [162, 47016], [166, 47216], [169, 47396]]}, {"verse": 8, "start": 48095, "end": 53954, "text": "And when he is come, he will reprove the world of sin, and of righteousness, and of judgment:", "words": [[0, 48095], [4, 48239], [9, 48419], [12, 48619], [15, 48759], [21, 49539], [24, 49639], [29, 49819], [37, 50439], [41, 50579], [47, 50859], [50, 51059], [55, 51419], [59, 52039], [62, 52159], [77, 52639], [81, 53159], [84, 53279]]}, {"verse": 9, "start": 54404, "end": 57092, "text": "Of sin, because they believe not on me;", "words": [[0, 54404], [3, 54562], [8, 54922], [16, 55382], [21, 55682], [29, 56082], [33, 56402], [36, 56642]]}, {"verse": 10, "start": 57542, "end": 60940, "text": "Of righteousness, because I go to my Father, and you see me no more;", "words": [[0, 57542], [3, 57689], [18, 58189], [26, 58509], [28, 58669], [31, 58849], [34, 58929], [37, 59089], [45, 59449], [49, 59929], [53, 60049], [57, 60209], [60, 60349], [63, 60529]]}, {"verse": 11, "start": 61390, "end": 64298, "text": "Of judgment, because the prince of this world is judged.", "words": [[0, 61390], [3, 61570], [13, 61950], [21, 62430], [25, 62610], [32, 62850], [35, 62990], [40, 63170], [46, 63490], [49, 63690]]}, {"verse": 12, "start": 64748, "end": 68404, "text": "I have yet many things to say to you, but you cannot bear them now.", "words": [[0, 64748], [2, 64906], [7, 65066], [11, 65206], [16, 65466], [23, 65846], [26, 66086], [30, 66286], [33, 66466], [38, 66866], [42, 67006], [46, 67146], [53, 67446], [58, 67746], [63, 67946]]}, {"verse": 13, "start": 68854, "end": 80325, "text": "However when he, the Spirit of truth, is come, he will guide you into all truth: for he shall not speak of himself; but whatever he shall hear, that shall he speak: and he will show you things to come.", "words": [[0, 68854], [8, 69321], [13, 69421], [17, 69561], [21, 69701], [28, 70041], [31, 70201], [38, 70521], [41, 70801], [47, 71501], [50, 71581], [55, 71721], [61, 71981], [65, 72201], [70, 72401], [74, 72681], [81, 73485], [85, 73627], [88, 73867], [94, 74067], [98, 74287], [104, 74587], [107, 74767], [116, 75717], [120, 75817], [129, 76117], [132, 76317], [138, 76537], [144, 77137], [149, 77397], [155, 77657], [158, 77817], [165, 78635], [169, 78756], [172, 78896], [177, 79036], [182, 79276], [186, 79436], [193, 79676], [196, 79896]]}, {"verse": 14, "start": 80775, "end": 85298, "text": "He shall glorify me: for he shall receive of mine, and shall show it to you.", "words": [[0, 80775], [3, 80887], [9, 81067], [17, 81587], [21, 82288], [25, 82399], [28, 82579], [34, 82799], [42, 83179], [45, 83379], [51, 83739], [55, 84179], [61, 84419], [66, 84679], [69, 84819], [72, 84979]]}, {"verse": 15, "start": 85748, "end": 92412, "text": "All things that the Father has are mine: therefore said I, that he shall take of mine, and shall show it to you.", "words": [[0, 85748], [4, 86148], [11, 86468], [16, 86708], [20, 86828], [27, 87068], [31, 87468], [35, 87788], [41, 88624], [51, 88947], [56, 89307], [59, 89567], [64, 89827], [67, 89967], [73, 90127], [78, 90367], [81, 90507], [87, 91027], [91, 91387], [97, 91567], [102, 91827], [105, 91947], [108, 92107]]}, {"verse": 16, "start": 92862, "end": 100320, "text": "A little while, and you shall not see me: and again, a little while, and you shall see me, because I go to the Father.", "words": [[0, 92862], [2, 92961], [9, 93121], [16, 93461], [20, 93901], [24, 94061], [30, 94261], [34, 94441], [38, 94681], [42, 95301], [46, 95464], [53, 95684], [55, 95904], [62, 96064], [69, 96884], [73, 97084], [77, 97244], [83, 97444], [87, 97724], [91, 98144], [99, 98444], [101, 98604], [104, 98784], [107, 98924], [111, 99064]]}, {"verse": 17, "start": 100670, "end": 114131, "text": "Then said some of his disciples among themselves, What is this that he says to us, A little while, and you shall not see me: and again, a little while, and you shall see me: and, Because I go to the Father?", "words": [[0, 100670], [5, 100880], [10, 101180], [15, 101400], [18, 101560], [22, 101680], [32, 102180], [38, 102480], [50, 105807], [55, 105945], [58, 106105], [63, 106405], [68, 106585], [71, 106705], [76, 106925], [79, 107145], [83, 107365], [85, 107565], [92, 107745], [99, 108085], [103, 108525], [107, 108625], [113, 108805], [117, 109025], [121, 109265], [125, 109834], [129, 109938], [136, 110418], [138, 110498], [145, 110698], [152, 111038], [156, 111478], [160, 111598], [166, 111758], [170, 111938], [174, 112478], [179, 112762], [187, 113162], [189, 113322], [192, 113442], [195, 113562], [199, 113662]]}, {"verse": 18, "start": 114481, "end": 119677, "text": "They said therefore, What is this that he says, A little while? we cannot tell what he says.", "words": [[0, 114481], [5, 114639], [10, 114939], [21, 116025], [26, 116142], [29, 116282], [34, 116482], [39, 116662], [42, 116762], [48, 116982], [50, 117222], [57, 117402], [64, 118268], [67, 118387], [74, 118607], [79, 118927], [84, 119127], [87, 119207]]}, {"verse": 19, "start": 120027, "end": 133422, "text": "Now Jesus knew that they were desirous to ask him, and said to them, Do you enquire among yourselves of that I said, A little while, and you shall not see me: and again, a little while, and you shall see me?", "words": [[0, 120027], [4, 120290], [10, 120610], [15, 121010], [20, 121210], [25, 121370], [30, 121530], [39, 122150], [42, 122290], [46, 122630], [51, 122850], [55, 123210], [60, 123450], [63, 123630], [69, 125110], [72, 125210], [76, 125600], [84, 125990], [90, 126170], [101, 126650], [104, 126950], [109, 127130], [111, 127310], [117, 127850], [119, 127990], [126, 128170], [133, 129010], [137, 129270], [141, 129430], [147, 129630], [151, 129870], [155, 130150], [159, 130780], [163, 130938], [170, 131518], [172, 131578], [179, 131738], [186, 132398], [190, 132498], [194, 132638], [200, 132838], [204, 133078]]}, {"verse": 20, "start": 133872, "end": 143425, "text": "Most assuredly, I say to you, That you shall weep and lament, but the world shall rejoice: and you shall be sorrowful, but your sorrow shall be turned into joy.", "words": [[0, 133872], [5, 134035], [16, 134755], [18, 134895], [22, 135115], [25, 135315], [30, 135775], [35, 136155], [39, 136315], [45, 136515], [50, 136975], [54, 137115], [62, 137855], [66, 138035], [70, 138175], [76, 138455], [82, 138735], [91, 139819], [95, 139944], [99, 140064], [105, 140224], [108, 140364], [119, 141224], [123, 141464], [128, 141584], [135, 141924], [141, 142184], [144, 142324], [151, 142584], [156, 142844]]}, {"verse": 21, "start": 143875, "end": 154925, "text": "A woman when she is in travail has sorrow, because her hour is come: but as soon as she is delivered of the child, she remembers no more the anguish, for joy that a man is born into the world.", "words": [[0, 143875], [2, 143981], [8, 144261], [13, 144561], [17, 144801], [20, 144961], [23, 145101], [31, 145421], [35, 145881], [43, 146341], [51, 146981], [55, 147221], [60, 147501], [63, 147781], [69, 148521], [73, 148617], [76, 148737], [81, 148977], [84, 149077], [88, 149237], [91, 149337], [101, 149677], [104, 149837], [108, 149937], [115, 150677], [119, 150837], [129, 151157], [132, 151437], [137, 151657], [141, 151797], [150, 152597], [154, 152777], [158, 153097], [163, 153317], [165, 153417], [169, 153597], [172, 153797], [177, 154077], [182, 154257], [186, 154417]]}, {"verse": 22, "start": 155375, "end": 162897, "text": "And you now therefore have sorrow: but I will see you again, and your heart shall rejoice, and your joy no man takes from you.", "words": [[0, 155375], [4, 155494], [8, 155594], [12, 155794], [22, 156234], [27, 156474], [35, 157414], [39, 157538], [41, 157698], [46, 157858], [50, 158078], [54, 158238], [61, 158978], [65, 159218], [70, 159338], [76, 159598], [82, 159838], [91, 160698], [95, 160938], [100, 161078], [104, 161378], [107, 161638], [111, 161958], [117, 162278], [122, 162538]]}, {"verse": 23, "start": 163347, "end": 170920, "text": "And in that day you shall ask me nothing. Most assuredly, I say to you, Whatever you shall ask the Father in my name, he will give it you.", "words": [[0, 163347], [4, 163487], [7, 163607], [12, 163807], [16, 164307], [20, 164507], [26, 164667], [30, 164927], [33, 165087], [42, 165945], [47, 166126], [58, 166706], [60, 166786], [64, 167006], [67, 167206], [72, 167726], [81, 168006], [85, 168246], [91, 168426], [95, 168666], [99, 168826], [106, 169086], [109, 169286], [112, 169466], [118, 170086], [121, 170166], [126, 170306], [131, 170486], [134, 170606]]}, {"verse": 24, "start": 171370, "end": 176788, "text": "Until now have you asked nothing in my name: ask, and you shall receive, that your joy may be full.", "words": [[0, 171370], [6, 171614], [10, 172074], [15, 172194], [19, 172354], [25, 172554], [33, 172954], [36, 173174], [39, 173354], [45, 174066], [50, 174370], [54, 174550], [58, 174670], [64, 174870], [73, 175310], [78, 175610], [83, 175750], [87, 176050], [91, 176230], [94, 176350]]}, {"verse": 25, "start": 177238, "end": 186163, "text": "These things have I spoken to you in proverbs: but the time comes, when I shall no more speak to you in proverbs, but I shall show you plainly of the Father.", "words": [[0, 177238], [6, 177421], [13, 177781], [18, 178001], [20, 178121], [27, 178441], [30, 178701], [34, 178841], [37, 178981], [47, 180041], [51, 180164], [55, 180264], [60, 180544], [67, 180964], [72, 181644], [74, 181784], [80, 181944], [83, 182144], [88, 182364], [94, 182624], [97, 182844], [101, 182984], [104, 183144], [114, 184004], [118, 184304], [120, 184444], [126, 184604], [131, 184844], [135, 185004], [143, 185464], [146, 185564], [150, 185664]]}, {"verse": 26, "start": 186613, "end": 192497, "text": "At that day you shall ask in my name: and I say not to you, that I will pray the Father for you:", "words": [[0, 186613], [3, 186755], [8, 186935], [12, 187215], [16, 187375], [22, 187535], [26, 187855], [29, 188015], [32, 188175], [38, 188970], [42, 189091], [44, 189251], [48, 189491], [52, 189751], [55, 189971], [60, 190431], [65, 190791], [67, 190931], [72, 191071], [77, 191351], [81, 191511], [88, 191811], [92, 192111]]}, {"verse": 27, "start": 192947, "end": 198737, "text": "For the Father himself loves you, because you have loved me, and have believed that I came out from God.", "words": [[0, 192947], [4, 193034], [8, 193174], [15, 193474], [23, 193754], [29, 194294], [34, 194614], [42, 195154], [46, 195414], [51, 195594], [57, 195834], [61, 196174], [65, 196674], [70, 196794], [79, 197174], [84, 197414], [86, 197514], [91, 197734], [95, 197954], [100, 198174]]}, {"verse": 28, "start": 199187, "end": 205252, "text": "I came forth from the Father, and am come into the world: again, I leave the world, and go to the Father.", "words": [[0, 199187], [2, 199354], [7, 199594], [13, 199874], [18, 200134], [22, 200254], [30, 200994], [34, 201094], [37, 201194], [42, 201454], [47, 201674], [51, 201814], [58, 202587], [65, 203210], [67, 203350], [73, 203610], [77, 203770], [84, 204050], [88, 204370], [91, 204550], [94, 204670], [98, 204770]]}, {"verse": 29, "start": 205602, "end": 210262, "text": "His disciples said to him, Lo, now do you speak plainly, and speak no proverb.", "words": [[0, 205602], [4, 205715], [14, 206215], [19, 206535], [22, 206715], [27, 207344], [31, 207414], [35, 207634], [38, 207854], [42, 207974], [48, 208174], [57, 208794], [61, 209074], [67, 209354], [70, 209634]]}, {"verse": 30, "start": 210712, "end": 218340, "text": "Now are we sure that you know all things, and need not that any man should ask you: by this we believe that you came forth from God.", "words": [[0, 210712], [4, 210952], [8, 211192], [11, 211352], [16, 211612], [21, 211812], [25, 211932], [30, 212112], [34, 212412], [42, 212772], [46, 213312], [51, 213592], [55, 213852], [60, 214092], [64, 214252], [68, 214532], [75, 214772], [79, 215052], [84, 215649], [87, 215770], [92, 216290], [95, 216390], [103, 216730], [108, 216930], [112, 217070], [117, 217270], [123, 217590], [128, 217850]]}, {"verse": 31, "start": 218690, "end": 221286, "text": "Jesus answered them, Do you now believe?", "words": [[0, 218690], [6, 218966], [15, 219406], [21, 220066], [24, 220166], [28, 220346], [32, 220566]]}, {"verse": 32, "start": 221736, "end": 232816, "text": "Behold, the hour comes, yes, is now come, that you shall be scattered, every man to his own, and shall leave me alone: and yet I am not alone, because the Father is with me.", "words": [[0, 221736], [8, 222180], [12, 222360], [17, 222600], [24, 223300], [29, 223960], [32, 224100], [36, 224360], [42, 225080], [47, 225180], [51, 225380], [57, 225580], [60, 225740], [71, 226120], [77, 226540], [81, 226820], [84, 227040], [88, 227200], [93, 227740], [97, 227840], [103, 228060], [109, 228320], [112, 228540], [119, 229397], [123, 229539], [127, 229739], [129, 229959], [132, 230099], [136, 230299], [143, 230979], [151, 231479], [155, 231699], [162, 231999], [165, 232239], [170, 232419]]}, {"verse": 33, "start": 233266, "end": 243086, "text": "These things I have spoken to you, that in me you might have peace. In the world you shall have tribulation: but be of good cheer; I have overcome the world.", "words": [[0, 233266], [6, 233490], [13, 233870], [15, 234110], [20, 234210], [27, 234550], [30, 234810], [35, 235490], [40, 235610], [43, 235770], [46, 236030], [50, 236250], [56, 236450], [61, 236650], [68, 237613], [71, 237909], [75, 238029], [81, 238369], [85, 238629], [91, 238829], [96, 239009], [109, 240119], [113, 240223], [116, 240443], [119, 240563], [124, 240763], [131, 241638], [133, 241790], [138, 241930], [147, 242270], [151, 242530]]}]}