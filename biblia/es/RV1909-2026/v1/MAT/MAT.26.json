{"book": "MAT", "chapter": 26, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 591250, "verses": [{"verse": 1, "start": 300, "end": 6872, "text": "Y aconteció que, cuando hubo acabado Jesús todas estas palabras, dijo a sus discípulos:", "words": [[0, 300], [2, 442], [12, 1242], [17, 1522], [24, 1782], [29, 2202], [37, 2762], [43, 3122], [49, 3862], [55, 4262], [65, 5482], [70, 5822], [72, 5982], [76, 6142]]}, {"verse": 2, "start": 7222, "end": 14240, "text": "Sabéis que dentro de dos días se hace la pascua, y el Hijo del hombre es entregado para ser crucificado.", "words": [[0, 7222], [7, 7823], [11, 7983], [18, 8243], [21, 8523], [25, 8723], [30, 9043], [33, 9363], [38, 9583], [41, 9783], [49, 10643], [51, 10823], [54, 10943], [59, 11223], [63, 11383], [70, 11803], [73, 12023], [83, 12743], [88, 12943], [92, 13183]]}, {"verse": 3, "start": 14590, "end": 24846, "text": "Entonces los príncipes de los sacerdotes, y los escribas, y los ancianos del pueblo se juntaron al patio del sumo sacerdote, el cual se llamaba Caifás;", "words": [[0, 14590], [9, 15074], [13, 15754], [23, 16374], [26, 16494], [30, 16614], [42, 17414], [44, 17554], [48, 17694], [58, 18374], [60, 18619], [64, 18779], [73, 19259], [77, 19379], [84, 19739], [87, 19939], [96, 20479], [99, 20679], [105, 21059], [109, 21279], [114, 21719], [125, 22779], [128, 22859], [133, 23059], [136, 23299], [144, 24104]]}, {"verse": 4, "start": 25196, "end": 29347, "text": "Y tuvieron consejo para prender por engaño a Jesús, y matarle.", "words": [[0, 25196], [2, 25293], [11, 25673], [19, 26353], [24, 26663], [32, 26973], [36, 27313], [43, 27833], [45, 27933], [52, 28273], [54, 28578]]}, {"verse": 5, "start": 29697, "end": 34646, "text": "Y decían: No en el día de la fiesta, porque no se haga alboroto en el pueblo.", "words": [[0, 29697], [2, 29821], [10, 30762], [13, 30967], [16, 31127], [19, 31227], [23, 31447], [26, 31567], [29, 31687], [37, 32427], [44, 32787], [47, 32967], [50, 33167], [55, 33367], [64, 33887], [67, 34007], [70, 34127]]}, {"verse": 6, "start": 34926, "end": 39722, "text": "Y estando Jesús en Betania, en casa de Simón el leproso,", "words": [[0, 34926], [2, 35090], [10, 35470], [16, 35850], [19, 36150], [28, 37310], [31, 37370], [36, 37670], [39, 37930], [45, 38690], [48, 38810]]}, {"verse": 7, "start": 40072, "end": 50551, "text": "Vino a él una mujer, teniendo un frasco de alabastro con perfume muy costoso, y lo derramó sobre la cabeza de él, estando sentado a la mesa.", "words": [[0, 40072], [5, 40378], [7, 40638], [10, 40818], [14, 41078], [21, 41998], [30, 42598], [33, 42758], [40, 43198], [43, 43338], [53, 43918], [57, 44118], [65, 44578], [69, 44998], [78, 45718], [80, 46198], [83, 46338], [91, 46958], [97, 47218], [100, 47418], [107, 47838], [110, 48058], [114, 48858], [122, 49318], [130, 49838], [132, 49918], [135, 49998]]}, {"verse": 8, "start": 50901, "end": 56896, "text": "Lo cual viendo sus discípulos, se enojaron, diciendo: ¿Por qué se pierde esto?", "words": [[0, 50901], [3, 51027], [8, 51287], [15, 51627], [19, 51927], [31, 53027], [34, 53327], [44, 54587], [54, 55661], [59, 55777], [63, 55917], [66, 56037], [73, 56457]]}, {"verse": 9, "start": 57246, "end": 60808, "text": "Porque esto se podía vender por gran precio, y darse a los pobres.", "words": [[0, 57246], [7, 57442], [12, 57762], [15, 57942], [21, 58222], [28, 58562], [32, 58802], [37, 59022], [45, 59422], [47, 59722], [53, 60042], [55, 60082], [59, 60202]]}, {"verse": 10, "start": 61088, "end": 67823, "text": "Y entendiéndolo Jesús, les dijo: ¿Por qué molestáis a esta mujer? pues ha hecho conmigo buena obra.", "words": [[0, 61088], [2, 61580], [16, 62110], [23, 62550], [27, 62990], [33, 63721], [38, 63846], [42, 64106], [52, 64786], [54, 64966], [59, 65106], [66, 65970], [71, 66094], [74, 66254], [80, 66454], [88, 66954], [94, 67214]]}, {"verse": 11, "start": 68173, "end": 72582, "text": "Porque siempre tendréis pobres con vosotros, pero a mí no siempre me tendréis.", "words": [[0, 68173], [7, 68357], [15, 68677], [24, 69277], [31, 69737], [35, 69977], [45, 70677], [50, 70817], [52, 70937], [55, 71077], [58, 71197], [66, 71557], [69, 71797]]}, {"verse": 12, "start": 72932, "end": 78257, "text": "Porque echando este perfume sobre mi cuerpo, para sepultarme lo ha hecho.", "words": [[0, 72932], [7, 73194], [15, 73774], [20, 73994], [28, 74534], [34, 74934], [37, 75174], [45, 75674], [50, 76494], [61, 77294], [64, 77554], [67, 77734]]}, {"verse": 13, "start": 78607, "end": 88692, "text": "De cierto os digo que dondequiera que se predique este evangelio en todo el mundo, también se contará, en memoria de esta mujer, lo que ella ha hecho.", "words": [[0, 78607], [3, 78851], [10, 79131], [13, 79411], [18, 79731], [22, 79991], [34, 80691], [38, 80911], [41, 81071], [50, 81631], [55, 82011], [65, 82771], [68, 82891], [73, 83091], [76, 83291], [83, 83631], [91, 84331], [94, 84651], [103, 85251], [106, 85831], [114, 86291], [117, 86471], [122, 86651], [129, 87091], [132, 87571], [136, 87731], [141, 88011], [144, 88271]]}, {"verse": 14, "start": 89042, "end": 95432, "text": "Entonces uno de los doce, que se llamaba Judas Iscariote, fue a los príncipes de los sacerdotes,", "words": [[0, 89042], [9, 89866], [13, 90068], [16, 90228], [20, 90388], [26, 90788], [30, 90928], [33, 91068], [41, 91468], [47, 91768], [58, 92668], [62, 93228], [64, 93388], [68, 93488], [78, 94088], [81, 94188], [85, 94328]]}, {"verse": 15, "start": 95782, "end": 102641, "text": "Y les dijo: ¿Qué me queréis dar, y yo os lo entregaré? Y ellos le señalaron treinta piezas de plata.", "words": [[0, 95782], [2, 95906], [6, 96026], [12, 96774], [17, 96874], [20, 96974], [28, 97274], [33, 97574], [35, 97954], [38, 98194], [41, 98294], [44, 98374], [55, 99287], [57, 99474], [63, 99804], [66, 100134], [76, 100734], [84, 101334], [91, 101994], [94, 102094]]}, {"verse": 16, "start": 102991, "end": 107214, "text": "Y desde entonces buscaba oportunidad para entregarle.", "words": [[0, 102991], [2, 103114], [8, 103294], [17, 103974], [25, 104894], [37, 105674], [42, 106134]]}, {"verse": 17, "start": 107564, "end": 117840, "text": "Y el primer día de la fiesta de los panes sin levadura, vinieron los discípulos a Jesús, diciéndole: ¿Dónde quieres que preparemos para ti para comer la pascua?", "words": [[0, 107564], [2, 107689], [5, 107809], [12, 108129], [16, 108449], [19, 108629], [22, 108749], [29, 109129], [32, 109269], [36, 109389], [42, 109829], [46, 110129], [56, 110769], [65, 111629], [69, 111849], [80, 112549], [82, 112729], [89, 113069], [101, 114606], [108, 114890], [116, 115190], [120, 115390], [131, 115930], [136, 116150], [139, 116410], [144, 116710], [150, 117030], [153, 117460]]}, {"verse": 18, "start": 118120, "end": 128610, "text": "Y él dijo: Id a la ciudad a cierto hombre, y decidle: El Maestro dice: Mi tiempo está cerca; en tu casa haré la pascua con mis discípulos.", "words": [[0, 118120], [2, 118310], [5, 118450], [11, 119256], [14, 119356], [16, 119436], [19, 119536], [26, 119856], [28, 120136], [35, 120416], [43, 121056], [45, 121615], [54, 122333], [57, 122543], [65, 123123], [71, 124045], [74, 124164], [81, 124424], [86, 124664], [93, 125619], [96, 125745], [99, 125905], [104, 126225], [109, 126645], [112, 126765], [119, 127245], [123, 127425], [127, 127625]]}, {"verse": 19, "start": 128960, "end": 134453, "text": "Y los discípulos hicieron como Jesús les mandó, y prepararon la pascua.", "words": [[0, 128960], [2, 129066], [6, 129206], [17, 129846], [26, 130566], [31, 130826], [37, 131206], [41, 131706], [48, 132346], [50, 132846], [61, 133586], [64, 133746]]}, {"verse": 20, "start": 134803, "end": 138983, "text": "Y como fue la tarde del día, se sentó a la mesa con los doce.", "words": [[0, 134803], [2, 135083], [7, 135343], [11, 135603], [14, 135763], [20, 136103], [24, 136403], [29, 137043], [32, 137163], [38, 137583], [40, 137643], [43, 137723], [48, 137963], [52, 138203], [56, 138383]]}, {"verse": 21, "start": 139333, "end": 144472, "text": "Y comiendo ellos, dijo: De cierto os digo, que uno de vosotros me ha de entregar.", "words": [[0, 139333], [2, 139457], [11, 139917], [18, 140217], [24, 141205], [27, 141372], [34, 141652], [37, 141932], [43, 142172], [47, 142412], [51, 142612], [54, 142792], [63, 143312], [66, 143552], [69, 143652], [72, 143752]]}, {"verse": 22, "start": 144822, "end": 151989, "text": "Y entristecidos ellos en gran manera, comenzó cada uno de ellos a decirle: ¿Soy yo, Señor?", "words": [[0, 144822], [2, 145493], [16, 146183], [22, 146483], [25, 146763], [30, 146983], [38, 147523], [46, 148443], [51, 148663], [55, 149103], [58, 149323], [64, 149623], [66, 149823], [75, 150851], [80, 151210], [84, 151430]]}, {"verse": 23, "start": 152269, "end": 159501, "text": "Entonces él respondiendo, dijo: El que mete la mano conmigo en el plato, ese me ha de entregar.", "words": [[0, 152269], [9, 152745], [12, 153325], [26, 154485], [32, 155282], [35, 155642], [39, 155822], [44, 156102], [47, 156342], [52, 156622], [60, 157242], [63, 157362], [66, 157482], [73, 158102], [77, 158322], [80, 158582], [83, 158702], [86, 158802]]}, {"verse": 24, "start": 159851, "end": 171950, "text": "A la verdad el Hijo del hombre va, como está escrito de él; pero ¡ay de aquel hombre por quien el Hijo del hombre es entregado! bueno le fuera al tal hombre no haber nacido.", "words": [[0, 159851], [2, 159943], [5, 160043], [12, 160423], [15, 160903], [20, 161203], [24, 161343], [31, 161763], [35, 162003], [40, 162503], [45, 162683], [53, 163003], [56, 163343], [60, 164188], [65, 164522], [69, 164892], [72, 165112], [78, 165472], [85, 165752], [89, 166032], [95, 166372], [98, 166732], [103, 167052], [107, 167212], [114, 167552], [117, 167952], [128, 169021], [134, 169407], [137, 169507], [143, 169727], [146, 170127], [150, 170307], [157, 170667], [160, 170947], [166, 171127]]}, {"verse": 25, "start": 172300, "end": 179563, "text": "Entonces respondiendo Judas, que le entregaba, dijo: ¿Soy yo, Maestro? Le dice: Tú lo has dicho.", "words": [[0, 172300], [9, 173362], [22, 174302], [29, 174702], [33, 175062], [36, 175222], [47, 175962], [53, 176591], [58, 176790], [62, 176930], [71, 177860], [74, 178026], [80, 178712], [83, 178838], [86, 178958], [90, 179078]]}, {"verse": 26, "start": 179913, "end": 188226, "text": "Y comiendo ellos, tomó Jesús el pan, y bendijo, y lo partió, y dio a sus discípulos, y dijo: Tomad, comed: esto es mi cuerpo.", "words": [[0, 179913], [2, 180011], [11, 180471], [18, 180731], [23, 181151], [29, 181391], [32, 181731], [37, 181971], [39, 182191], [48, 182891], [50, 182931], [53, 183051], [61, 183711], [63, 183771], [67, 183971], [69, 184131], [73, 184291], [85, 185311], [87, 185391], [93, 186029], [100, 186637], [107, 187459], [112, 187704], [115, 187784], [118, 188005]]}, {"verse": 27, "start": 188226, "end": 194672, "text": "Y tomando la copa, y hechas gracias, les dio, diciendo: Bebed de ella todos;", "words": [[0, 188371], [2, 188711], [10, 189116], [13, 189256], [19, 189716], [21, 189816], [28, 190096], [37, 191036], [41, 191216], [46, 191536], [56, 193065], [62, 193355], [65, 193645], [70, 193935]]}, {"verse": 28, "start": 195022, "end": 201628, "text": "Porque esto es mi sangre del nuevo pacto, la cual es derramada por muchos para perdón de los pecados.", "words": [[0, 195022], [7, 195270], [12, 195710], [15, 195890], [18, 196070], [25, 196490], [29, 196770], [35, 197030], [42, 197990], [45, 198050], [50, 198230], [53, 198410], [63, 199070], [67, 199310], [74, 199710], [79, 200010], [86, 200530], [89, 200670], [93, 200790]]}, {"verse": 29, "start": 201978, "end": 211527, "text": "Y os digo, que desde ahora no beberé más de este fruto de la vid, hasta aquel día, cuando lo beba nuevo con vosotros en el reino de mi Padre.", "words": [[0, 201978], [2, 202104], [5, 202224], [11, 202504], [15, 202744], [21, 203124], [27, 203584], [30, 203964], [37, 204444], [41, 204824], [44, 205204], [49, 205424], [55, 205884], [58, 206044], [61, 206414], [66, 206784], [72, 207064], [78, 207404], [83, 208004], [90, 208164], [93, 208384], [98, 208664], [104, 208924], [108, 209204], [117, 209844], [120, 210124], [123, 210264], [129, 210704], [132, 210844], [135, 210964]]}, {"verse": 30, "start": 211877, "end": 216428, "text": "Y habiendo cantado el himno, salieron al monte de los Olivos.", "words": [[0, 211877], [2, 212006], [11, 212326], [19, 212926], [22, 213086], [29, 213926], [38, 214706], [41, 214946], [47, 215246], [50, 215486], [54, 215626]]}, {"verse": 31, "start": 216778, "end": 227789, "text": "Entonces Jesús les dice: Todos vosotros me abandonaréis esta noche; porque escrito está: Heriré al Pastor, y las ovejas de la manada serán dispersas.", "words": [[0, 216778], [9, 217644], [15, 218184], [19, 218584], [25, 219371], [31, 219534], [40, 220154], [43, 220394], [56, 221234], [61, 221514], [68, 222273], [75, 222737], [83, 223237], [89, 223878], [96, 224354], [99, 224494], [107, 224934], [109, 225239], [113, 225399], [120, 225839], [123, 225959], [126, 226059], [133, 226439], [139, 226819]]}, {"verse": 32, "start": 228139, "end": 232822, "text": "Pero después que haya resucitado, iré delante de vosotros a Galilea.", "words": [[0, 228139], [5, 228281], [13, 228621], [17, 228801], [22, 229001], [34, 229981], [38, 230681], [46, 231101], [49, 231281], [58, 231801], [60, 232061]]}, {"verse": 33, "start": 233172, "end": 238634, "text": "Y respondiendo Pedro, le dijo: Aunque todos te abandonen, yo nunca te abandonaré.", "words": [[0, 233172], [2, 233453], [15, 234393], [22, 234693], [25, 234913], [31, 235679], [38, 235895], [44, 236215], [47, 236415], [58, 237215], [61, 237475], [67, 237735], [70, 237955]]}, {"verse": 34, "start": 238914, "end": 247195, "text": "Jesús le dice: De cierto te digo que esta noche, antes que el gallo cante, me negarás tres veces.", "words": [[0, 238914], [6, 239286], [9, 239806], [15, 240597], [18, 240764], [25, 241064], [28, 241464], [33, 241784], [37, 241984], [42, 242264], [49, 242984], [55, 243584], [59, 243804], [62, 244024], [68, 244384], [75, 245064], [78, 245264], [86, 245804], [91, 246184]]}, {"verse": 35, "start": 247545, "end": 254685, "text": "Le dice Pedro: Aunque me sea necesario morir contigo, no te negaré. Y todos los discípulos dijeron lo mismo.", "words": [[0, 247545], [3, 247650], [8, 247910], [15, 248701], [22, 248903], [25, 249103], [29, 249303], [39, 249843], [45, 250243], [54, 251023], [57, 251223], [60, 251383], [68, 252210], [70, 252334], [76, 252614], [80, 252894], [91, 253534], [99, 254114], [102, 254214]]}, {"verse": 36, "start": 255035, "end": 263904, "text": "Entonces llegó Jesús con ellos al lugar llamado Getsemaní, y dice a sus discípulos: Sentaos aquí, hasta que vaya allí y ore.", "words": [[0, 255035], [9, 255484], [15, 255904], [21, 256264], [25, 256544], [31, 256744], [34, 257004], [40, 257324], [48, 257784], [59, 259144], [61, 259444], [66, 259684], [68, 259844], [72, 259984], [84, 261236], [92, 261536], [98, 261896], [104, 262396], [108, 262596], [113, 262816], [118, 263216], [120, 263476]]}, {"verse": 37, "start": 264254, "end": 271528, "text": "Y tomando a Pedro, y a los dos hijos de Zebedeo, comenzó a entristecerse y a angustiarse en gran manera.", "words": [[0, 264254], [2, 264397], [10, 264777], [12, 264897], [19, 265317], [21, 265552], [23, 265612], [27, 265772], [31, 265932], [37, 266312], [40, 266732], [49, 267152], [57, 268072], [59, 268232], [73, 269352], [75, 269612], [77, 269732], [89, 270492], [92, 270612], [97, 270792]]}, {"verse": 38, "start": 271878, "end": 279004, "text": "Entonces Jesús les dice: Mi alma está muy triste hasta la muerte; quedaos aquí, y velad conmigo.", "words": [[0, 271878], [9, 272449], [15, 273049], [19, 273649], [25, 274479], [28, 274590], [33, 274810], [38, 275090], [42, 275290], [49, 275690], [55, 275910], [58, 276070], [66, 276912], [74, 277393], [80, 277693], [82, 277953], [88, 278273]]}, {"verse": 39, "start": 279354, "end": 291503, "text": "Y yéndose un poco más adelante, se postró sobre su rostro, orando, y diciendo: Padre mío, si es posible, pase de mí esta copa; pero no como yo quiero, sino como tú.", "words": [[0, 279521], [2, 279721], [10, 279921], [13, 280061], [18, 280281], [22, 280521], [32, 281061], [35, 281301], [42, 281861], [48, 282121], [51, 282341], [59, 282981], [67, 283781], [69, 284081], [79, 285047], [85, 285392], [90, 286092], [93, 286212], [96, 286352], [105, 287272], [110, 287752], [113, 287992], [116, 288212], [121, 288452], [127, 289272], [132, 289441], [135, 289661], [140, 289881], [143, 290061], [151, 290421], [156, 290721], [161, 291021]]}, {"verse": 40, "start": 291853, "end": 298984, "text": "Y vino a sus discípulos, y los halló durmiendo, y dijo a Pedro: ¿Así no habéis podido velar conmigo una hora?", "words": [[0, 291853], [2, 292176], [7, 292396], [9, 292556], [13, 292736], [25, 293416], [27, 293896], [31, 294036], [37, 294376], [48, 294956], [50, 295056], [55, 295256], [57, 295396], [64, 296054], [69, 296394], [72, 296614], [79, 296914], [86, 297314], [92, 297674], [100, 298254], [104, 298434]]}, {"verse": 41, "start": 299334, "end": 306224, "text": "Velad y orad, para que no entréis en tentación: el espíritu está dispuesto, pero la carne es débil.", "words": [[0, 299334], [6, 299799], [8, 300019], [14, 300339], [19, 300619], [23, 300779], [26, 300979], [34, 301439], [37, 301639], [48, 302510], [51, 302830], [60, 303410], [65, 303590], [76, 304480], [81, 304760], [84, 304940], [90, 305300], [93, 305560]]}, {"verse": 42, "start": 306574, "end": 316175, "text": "Otra vez fue, segunda vez, y oró diciendo: Padre mío, si no puede esta copa pasar de mí sin que yo la beba, hágase tu voluntad.", "words": [[0, 306574], [5, 306824], [9, 307164], [14, 307364], [22, 307784], [27, 308244], [29, 308704], [33, 309164], [43, 310378], [49, 310663], [54, 311103], [57, 311203], [60, 311423], [66, 311643], [71, 311923], [76, 312343], [82, 312643], [85, 312863], [88, 313023], [92, 313243], [96, 313463], [99, 313643], [102, 313803], [108, 314643], [115, 315063], [118, 315263]]}, {"verse": 43, "start": 316525, "end": 322024, "text": "Y vino, y los halló otra vez durmiendo; porque tenían los ojos pesados de sueño.", "words": [[0, 316525], [2, 316650], [8, 316990], [10, 317225], [14, 317405], [20, 317845], [25, 318105], [29, 318365], [40, 319451], [47, 319755], [54, 320095], [58, 320275], [63, 320595], [71, 321175], [74, 321375]]}, {"verse": 44, "start": 322374, "end": 328856, "text": "Y dejándolos se fue de nuevo y oró por tercera vez, diciendo las mismas palabras.", "words": [[0, 322374], [2, 322522], [13, 323582], [16, 323822], [20, 324022], [23, 324182], [29, 324502], [31, 324862], [35, 325182], [39, 325402], [47, 326022], [52, 326782], [61, 327162], [65, 327562], [72, 328042]]}, {"verse": 45, "start": 329206, "end": 341178, "text": "Entonces vino a sus discípulos y les dice: Dormid ya, y descansad: he aquí ha llegado la hora, y el Hijo del hombre es entregado en manos de pecadores.", "words": [[0, 329206], [9, 330088], [14, 330828], [16, 331048], [20, 331228], [31, 332028], [33, 332208], [37, 332328], [43, 333228], [50, 333398], [54, 333838], [56, 334493], [67, 335309], [70, 335476], [75, 335896], [78, 336136], [86, 336616], [89, 336796], [95, 337376], [97, 337776], [100, 337916], [105, 338196], [109, 338356], [116, 338776], [119, 338896], [129, 339576], [132, 339696], [138, 339976], [141, 340196]]}, {"verse": 46, "start": 341528, "end": 345905, "text": "Levantaos, vamos: he aquí ha llegado el que me ha entregado.", "words": [[0, 341528], [11, 342636], [18, 343519], [21, 343664], [26, 343884], [29, 344024], [37, 344464], [40, 344624], [44, 344804], [47, 344984], [50, 345084]]}, {"verse": 47, "start": 346255, "end": 359954, "text": "Y hablando aún él, he aquí Judas, uno de los doce, vino, y con él mucha gente con espadas y con palos, de parte de los príncipes de los sacerdotes, y de los ancianos del pueblo.", "words": [[0, 346255], [2, 346392], [11, 346652], [15, 347092], [19, 347592], [22, 348007], [27, 348247], [34, 349407], [38, 349727], [41, 349907], [45, 350047], [51, 351127], [57, 351447], [59, 352067], [63, 352307], [66, 352467], [72, 352707], [78, 353127], [82, 353367], [90, 353907], [92, 354107], [96, 354307], [103, 354967], [106, 355347], [112, 355607], [115, 355847], [119, 355987], [129, 356727], [132, 356847], [136, 356987], [148, 358194], [150, 358318], [153, 358418], [157, 358538], [166, 359138], [170, 359298]]}, {"verse": 48, "start": 360304, "end": 368004, "text": "Y el que le entregaba les había dado señal, diciendo: Al que yo bese, aquel es: prendedle.", "words": [[0, 360304], [2, 360446], [5, 360586], [9, 360766], [12, 360966], [22, 361746], [26, 362106], [32, 362526], [37, 362786], [44, 364006], [54, 365080], [57, 365264], [61, 365364], [64, 365744], [70, 366124], [76, 366644], [80, 367298]]}, {"verse": 49, "start": 368284, "end": 373130, "text": "Y luego que llegó a Jesús, dijo: Salve, Maestro. Y le besó.", "words": [[0, 368284], [2, 368428], [8, 368608], [12, 368888], [18, 369168], [20, 369328], [27, 370188], [33, 370998], [40, 371398], [49, 372292], [51, 372433], [54, 372553]]}, {"verse": 50, "start": 373480, "end": 381356, "text": "Y Jesús le dijo: Amigo, ¿a qué vienes? Entonces llegaron, y echaron mano a Jesús, y le prendieron.", "words": [[0, 373480], [2, 373627], [8, 374027], [11, 374367], [17, 375124], [24, 375710], [27, 375810], [31, 375910], [39, 376802], [48, 377290], [58, 378290], [60, 378610], [68, 379090], [73, 379430], [75, 379630], [82, 379970], [84, 380305], [87, 380425]]}, {"verse": 51, "start": 381706, "end": 391991, "text": "Y he aquí, uno de los que estaban con Jesús, extendiendo la mano, sacó su espada, e hiriendo a un siervo del sumo sacerdote, le quitó la oreja.", "words": [[0, 381706], [2, 381885], [5, 381985], [11, 382245], [15, 382545], [18, 382705], [22, 382825], [26, 382965], [34, 383265], [38, 383525], [45, 384405], [57, 385165], [60, 385325], [66, 386225], [71, 386565], [74, 386705], [82, 387245], [84, 387665], [93, 388225], [95, 388425], [98, 388545], [105, 389105], [109, 389265], [114, 389785], [125, 390825], [128, 390925], [134, 391285], [137, 391405]]}, {"verse": 52, "start": 392341, "end": 401476, "text": "Entonces Jesús le dice: Vuelve tu espada a su lugar; porque todos los que tomen espada, a espada perecerán.", "words": [[0, 392341], [9, 392930], [15, 393610], [18, 394110], [24, 394866], [31, 395252], [34, 395412], [41, 395972], [43, 396212], [46, 396392], [53, 397192], [60, 397374], [66, 397814], [70, 398114], [74, 398254], [80, 398634], [88, 399494], [90, 399734], [97, 400354]]}, {"verse": 53, "start": 401826, "end": 408380, "text": "¿Acaso piensas que no puedo ahora orar a mi Padre, y él me daría más de doce legiones de ángeles?", "words": [[0, 401826], [7, 402336], [15, 402756], [19, 402896], [22, 403076], [28, 403436], [34, 403826], [39, 404216], [41, 404296], [44, 404436], [51, 404856], [53, 405436], [56, 405656], [59, 405836], [65, 406236], [69, 406416], [72, 406743], [77, 407069], [86, 407396], [89, 407616]]}, {"verse": 54, "start": 408730, "end": 413285, "text": "¿Cómo, pues, se cumplirían las Escrituras, que así conviene que sea hecho?", "words": [[0, 408730], [7, 409144], [13, 409584], [16, 410104], [27, 410744], [31, 410924], [43, 411584], [47, 411744], [51, 411904], [60, 412364], [64, 412484], [68, 412724]]}, {"verse": 55, "start": 413635, "end": 425265, "text": "En aquella hora dijo Jesús a la gente: ¿Como a ladrón habéis salido con espadas y con palos a prenderme? Cada día me sentaba con vosotros enseñando en el templo, y no me prendisteis.", "words": [[0, 413635], [3, 413776], [11, 414156], [16, 414376], [21, 414676], [27, 415016], [29, 415296], [32, 415356], [39, 416111], [45, 416255], [47, 416435], [54, 416795], [61, 417095], [68, 417535], [72, 417735], [80, 418195], [82, 418375], [86, 418575], [92, 419055], [94, 419195], [105, 420098], [110, 420241], [114, 420541], [117, 420701], [125, 421161], [129, 421361], [138, 421901], [148, 422761], [151, 422861], [154, 423021], [162, 423781], [164, 423941], [167, 424061], [170, 424201]]}, {"verse": 56, "start": 425615, "end": 434770, "text": "Pero todo esto se hace, para que se cumplan las Escrituras de los profetas. Entonces todos los discípulos huyeron, dejándole.", "words": [[0, 425615], [5, 425758], [10, 426058], [15, 426378], [18, 426658], [24, 427038], [29, 427393], [33, 427573], [36, 427733], [44, 428353], [48, 428613], [59, 429313], [62, 429433], [66, 429553], [76, 430574], [85, 431178], [91, 431918], [95, 432198], [106, 432918], [115, 433818]]}, {"verse": 57, "start": 435120, "end": 443693, "text": "Y ellos, prendido Jesús, le llevaron al sumo sacerdote Caifás, donde los escribas y los ancianos estaban juntos.", "words": [[0, 435120], [2, 435300], [9, 435850], [18, 436400], [25, 436990], [28, 437580], [37, 438060], [40, 438200], [45, 438800], [55, 439540], [63, 440460], [69, 440700], [73, 440980], [82, 441600], [84, 441760], [88, 441920], [97, 442500], [105, 442840]]}, {"verse": 58, "start": 444043, "end": 453360, "text": "Pero Pedro le seguía de lejos hasta el patio del sumo sacerdote; y entrando dentro, se estaba sentado con los criados, para ver el fin.", "words": [[0, 444043], [5, 444283], [11, 444583], [14, 444803], [21, 445203], [24, 445303], [30, 445623], [36, 445883], [39, 446063], [45, 446423], [49, 446623], [54, 447143], [65, 448245], [67, 448389], [76, 448949], [84, 449289], [87, 449609], [94, 449949], [102, 450589], [106, 450769], [110, 450949], [119, 452069], [124, 452349], [128, 452549], [131, 452709]]}, {"verse": 59, "start": 453710, "end": 463551, "text": "Y los príncipes de los sacerdotes, y los ancianos, y todo el consejo, buscaban falso testimonio contra Jesús, para entregarle a la muerte;", "words": [[0, 453710], [2, 453837], [6, 453957], [16, 454797], [19, 454917], [23, 455077], [35, 455957], [37, 456357], [41, 456537], [51, 457257], [53, 457637], [58, 457877], [61, 458057], [70, 458777], [79, 459557], [85, 460057], [96, 460857], [103, 461217], [110, 461677], [115, 462042], [126, 462802], [128, 462882], [131, 462962]]}, {"verse": 60, "start": 463901, "end": 470566, "text": "Y no lo hallaron, aunque muchos testigos falsos se llegaban; pero al fin vinieron dos testigos falsos,", "words": [[0, 463901], [2, 464023], [5, 464183], [8, 464323], [18, 465063], [25, 465243], [32, 465603], [41, 466143], [48, 466683], [51, 466823], [61, 467813], [66, 467976], [69, 468096], [73, 468296], [82, 468816], [86, 469096], [95, 469696]]}, {"verse": 61, "start": 470916, "end": 476019, "text": "Que dijeron: Este dijo: Puedo derribar el templo de Dios, y en tres días reedificarlo.", "words": [[0, 470916], [4, 471020], [13, 471924], [18, 472144], [24, 472817], [30, 473006], [39, 473486], [42, 473586], [49, 473966], [52, 474006], [58, 474246], [60, 474526], [63, 474646], [68, 474846], [73, 475456]]}, {"verse": 62, "start": 476299, "end": 483127, "text": "Y levantándose el sumo sacerdote, le dijo: ¿No respondes nada? ¿qué testifican estos contra ti?", "words": [[0, 476299], [2, 476424], [15, 477384], [18, 477604], [23, 478084], [34, 479124], [37, 479304], [43, 479989], [47, 480135], [57, 480695], [63, 481398], [68, 481495], [79, 482135], [85, 482335], [92, 482735]]}, {"verse": 63, "start": 483407, "end": 492595, "text": "Pero Jesús callaba. Respondiendo el sumo sacerdote, le dijo: Te conjuro por el Dios viviente, que nos digas si eres tú el Cristo, Hijo de Dios.", "words": [[0, 483407], [5, 483574], [11, 483894], [20, 485386], [33, 485746], [36, 485886], [41, 486306], [52, 487106], [55, 487166], [61, 487923], [64, 488023], [72, 488523], [76, 488703], [79, 488823], [84, 489003], [94, 489523], [98, 489703], [102, 489973], [108, 490243], [111, 490423], [116, 490663], [119, 490903], [122, 491063], [130, 491743], [135, 491883], [138, 492043]]}, {"verse": 64, "start": 492875, "end": 505882, "text": "Jesús le dijo: Tú lo has dicho: y aun os digo, que desde ahora habéis de ver al Hijo del hombre sentado a la diestra del poder de Dios, y que viene en las nubes del cielo.", "words": [[0, 492875], [6, 493347], [9, 493787], [15, 494560], [18, 494684], [21, 494824], [25, 494964], [32, 495690], [34, 495811], [38, 496011], [41, 496231], [47, 497091], [51, 497311], [57, 497571], [63, 498011], [70, 498551], [73, 498731], [77, 498911], [80, 499071], [85, 499351], [89, 499551], [96, 499911], [104, 500591], [106, 500731], [109, 500811], [117, 501271], [121, 501511], [127, 501911], [130, 502211], [136, 502611], [138, 503106], [142, 503266], [148, 503626], [151, 503966], [155, 504146], [161, 504886], [165, 505166]]}, {"verse": 65, "start": 506232, "end": 517247, "text": "Entonces el sumo sacerdote rasgó sus vestidos, diciendo: Ha blasfemado: ¿qué más necesidad tenemos de testigos? He aquí, ahora habéis oído su blasfemia.", "words": [[0, 506232], [9, 507471], [12, 507591], [17, 507971], [27, 508651], [33, 509551], [37, 509751], [47, 510431], [57, 511889], [60, 512243], [72, 512768], [77, 512872], [81, 513052], [91, 513672], [99, 513992], [102, 514192], [112, 515162], [115, 515232], [121, 515452], [127, 515752], [134, 516092], [139, 516352], [142, 516512]]}, {"verse": 66, "start": 517597, "end": 522015, "text": "¿Qué os parece? Y respondiendo ellos, dijeron: Culpado es de muerte.", "words": [[0, 517597], [5, 517694], [8, 517794], [16, 518634], [18, 519029], [31, 519459], [38, 519999], [47, 520689], [55, 521172], [58, 521292], [61, 521432]]}, {"verse": 67, "start": 522295, "end": 529644, "text": "Entonces le escupieron en el rostro, y le dieron de bofetadas; y otros le herían con puñetazos,", "words": [[0, 522295], [9, 522836], [12, 523231], [23, 523911], [26, 524111], [29, 524271], [37, 524851], [39, 525231], [42, 525351], [49, 525861], [52, 526371], [63, 527043], [65, 527188], [71, 527488], [74, 527988], [81, 528328], [85, 528548]]}, {"verse": 68, "start": 529994, "end": 534021, "text": "Diciendo: Profetízanos tú, Cristo, quién es el que te ha herido.", "words": [[0, 529994], [10, 531557], [23, 531877], [27, 532037], [35, 532817], [41, 532977], [44, 533137], [47, 533257], [51, 533377], [54, 533517], [57, 533597]]}, {"verse": 69, "start": 534301, "end": 543196, "text": "Y Pedro estaba sentado fuera en el patio: y se llegó a él una criada, diciendo: Y tú con Jesús el galileo estabas.", "words": [[0, 534301], [2, 534427], [8, 534767], [15, 535167], [23, 535827], [29, 536107], [32, 536367], [35, 536507], [42, 537466], [44, 537720], [47, 537840], [53, 538180], [55, 538360], [58, 538520], [62, 538800], [70, 539460], [80, 540544], [82, 540694], [85, 540854], [89, 541094], [95, 541554], [98, 541974], [106, 542494]]}, {"verse": 70, "start": 543476, "end": 547953, "text": "Pero él negó delante de todos, diciendo: No sé lo que dices.", "words": [[0, 543476], [5, 543638], [8, 543878], [13, 544278], [21, 544698], [24, 544878], [31, 545778], [41, 546879], [44, 547063], [47, 547303], [50, 547443], [54, 547563]]}, {"verse": 71, "start": 548233, "end": 554923, "text": "Y saliendo él a la puerta, le vio otra, y dijo a los que estaban allí: También este estaba con Jesús nazareno.", "words": [[0, 548233], [2, 548338], [11, 548798], [14, 548998], [16, 549078], [19, 549198], [27, 549698], [30, 549993], [34, 550233], [40, 550693], [42, 550948], [47, 551248], [49, 551408], [53, 551528], [57, 551668], [65, 552008], [71, 552732], [79, 553032], [84, 553312], [91, 553612], [95, 553852], [101, 554132]]}, {"verse": 72, "start": 555203, "end": 561807, "text": "Y negó otra vez con juramento: No conozco al hombre.", "words": [[0, 555203], [2, 555328], [7, 555668], [12, 556148], [16, 556648], [20, 557068], [31, 558329], [34, 558484], [42, 558924], [45, 559044]]}, {"verse": 73, "start": 562087, "end": 571000, "text": "Y un poco después llegaron los que estaban por allí, y dijeron a Pedro: Verdaderamente también tú eres de ellos, porque aun tu habla te hace manifiesto.", "words": [[0, 562087], [2, 562206], [5, 562326], [10, 562546], [18, 563139], [27, 563641], [31, 563801], [35, 563921], [43, 564201], [47, 564481], [53, 564781], [55, 565341], [63, 565761], [65, 565841], [72, 566616], [87, 567300], [95, 567600], [98, 567940], [103, 568160], [106, 568320], [113, 568880], [120, 569280], [124, 569500], [127, 569700], [133, 569920], [136, 570160], [141, 570320]]}, {"verse": 74, "start": 571280, "end": 580447, "text": "Entonces comenzó a maldecir, y a jurar, diciendo: No conozco al hombre. Y el gallo cantó luego.", "words": [[0, 571280], [9, 571710], [17, 572450], [19, 572510], [29, 573050], [31, 573250], [33, 573370], [40, 573810], [50, 574987], [53, 575143], [61, 575583], [64, 575703], [72, 578745], [74, 578871], [77, 579081], [83, 579291], [89, 579851]]}, {"verse": 75, "start": 580797, "end": 590850, "text": "Y se acordó Pedro de las palabras de Jesús, que le dijo: Antes que cante el gallo, me negarás tres veces. Y saliendo fuera, lloró amargamente.", "words": [[0, 580797], [2, 580935], [5, 581055], [12, 581535], [18, 582035], [21, 582255], [25, 582395], [34, 582755], [37, 582975], [44, 583335], [48, 583635], [51, 583775], [57, 584471], [63, 584931], [67, 585131], [73, 585551], [76, 585611], [83, 586111], [86, 586431], [94, 586751], [99, 586991], [106, 587796], [108, 587903], [117, 588363], [124, 588743], [130, 589583]]}]}