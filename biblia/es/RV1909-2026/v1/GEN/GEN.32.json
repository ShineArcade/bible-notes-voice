{"book": "GEN", "chapter": 32, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 256147, "verses": [{"verse": 1, "start": 300, "end": 5465, "text": "Y Jacob se fue su camino, y le salieron al encuentro ángeles de Dios.", "words": [[0, 519], [2, 773], [8, 1026], [11, 1106], [15, 1326], [18, 1506], [26, 2006], [28, 2746], [31, 2866], [40, 3426], [43, 3606], [53, 4206], [61, 4686], [64, 4866]]}, {"verse": 2, "start": 5815, "end": 13476, "text": "Y dijo Jacob cuando los vio: El campo de Dios es este: y llamó el nombre de aquel lugar Mahanaim.", "words": [[0, 5815], [2, 5960], [7, 6240], [13, 6660], [20, 7100], [24, 7540], [29, 8142], [32, 8260], [38, 8580], [41, 8780], [46, 9060], [49, 9460], [55, 10379], [57, 10486], [63, 10846], [66, 10946], [73, 11306], [76, 11526], [82, 11906], [88, 12186]]}, {"verse": 3, "start": 13826, "end": 21088, "text": "Y envió Jacob mensajeros delante de sí a Esaú su hermano, a la tierra de Seir, campo de Edom.", "words": [[0, 13826], [2, 13970], [8, 14350], [14, 15050], [25, 15750], [33, 16250], [36, 16430], [39, 16870], [41, 17170], [46, 17470], [49, 17590], [58, 18390], [60, 18490], [63, 18570], [70, 18910], [73, 19380], [79, 19850], [85, 20250], [88, 20510]]}, {"verse": 4, "start": 21438, "end": 29593, "text": "Y les mandó diciendo: Así diréis a mi señor Esaú: Así dice tu siervo Jacob: Con Labán he morado, y me he detenido hasta ahora;", "words": [[0, 21438], [2, 21726], [6, 21866], [12, 22306], [22, 23310], [26, 23491], [33, 23891], [35, 24161], [38, 24431], [44, 24701], [50, 25139], [54, 25321], [59, 25601], [62, 25761], [69, 26226], [76, 26944], [80, 27074], [86, 27204], [89, 27334], [97, 27794], [99, 28134], [102, 28314], [105, 28394], [114, 28894], [120, 29134]]}, {"verse": 5, "start": 29943, "end": 37220, "text": "Y tengo vacas, y asnos, y ovejas, y siervos y siervas; y envío a decirlo a mi señor, por hallar gracia en tus ojos.", "words": [[0, 29943], [2, 30032], [8, 30252], [15, 30732], [17, 30872], [24, 31252], [26, 31472], [34, 31912], [36, 32112], [44, 32512], [46, 32692], [55, 33566], [57, 33668], [63, 34048], [65, 34148], [73, 34648], [75, 34748], [78, 34848], [85, 35568], [89, 35708], [96, 35988], [103, 36388], [106, 36468], [110, 36588]]}, {"verse": 6, "start": 37500, "end": 45403, "text": "Y los mensajeros volvieron a Jacob, diciendo: Vinimos a tu hermano Esaú, y él también viene a recibirte, y cuatrocientos hombres con él.", "words": [[0, 37500], [2, 37604], [6, 37704], [17, 38284], [27, 38824], [29, 39044], [36, 39444], [46, 39916], [54, 40335], [56, 40475], [59, 40575], [67, 40975], [73, 41395], [75, 41915], [78, 42055], [86, 42355], [92, 42695], [94, 42855], [105, 43495], [107, 43785], [121, 44075], [129, 44795], [133, 45135]]}, {"verse": 7, "start": 45683, "end": 55655, "text": "Entonces Jacob tuvo gran temor, y se angustió; y partió el pueblo que tenía consigo, y las ovejas y las vacas y los camellos, en dos cuadrillas;", "words": [[0, 45683], [9, 46587], [15, 46930], [20, 47350], [25, 47730], [32, 48150], [34, 48350], [37, 48490], [47, 49551], [49, 49661], [56, 50061], [59, 50201], [66, 50541], [70, 50841], [76, 51181], [85, 51801], [87, 52006], [91, 52146], [98, 52706], [100, 52966], [104, 53106], [110, 53526], [112, 53646], [116, 53786], [126, 54406], [129, 54586], [133, 54786]]}, {"verse": 8, "start": 56005, "end": 61433, "text": "Y dijo: Si viene Esaú contra un campamento y lo ataca, el otro campamento escapará.", "words": [[0, 56005], [2, 56149], [8, 56867], [11, 57103], [17, 57343], [22, 57583], [29, 57843], [32, 58043], [43, 58643], [45, 58763], [48, 58863], [55, 59703], [58, 59803], [63, 59983], [74, 60663]]}, {"verse": 9, "start": 61713, "end": 70658, "text": "Y dijo Jacob: Dios de mi padre Abraham, y Dios de mi padre Isaac, Jehová, que me dijiste: Vuélvete a tu tierra y a tu parentela, y yo te haré bien;", "words": [[0, 61713], [2, 61841], [7, 62081], [14, 62845], [19, 63067], [22, 63247], [25, 63347], [31, 63727], [40, 64107], [42, 64362], [47, 64562], [50, 64722], [53, 64822], [59, 65222], [66, 65862], [74, 66462], [78, 66522], [81, 66642], [90, 67481], [99, 67966], [101, 68066], [104, 68186], [111, 68486], [113, 68706], [115, 68786], [118, 68886], [129, 69486], [131, 69886], [134, 70006], [137, 70126], [142, 70346]]}, {"verse": 10, "start": 71008, "end": 80982, "text": "Menor soy que todas las misericordias, y que toda la verdad que has usado para con tu siervo; que con mi bastón pasé este Jordán, y ahora estoy sobre dos cuadrillas.", "words": [[0, 71008], [6, 71247], [10, 71527], [14, 71687], [20, 71907], [24, 72147], [39, 73087], [41, 73507], [45, 73627], [50, 73887], [53, 74067], [60, 74327], [64, 74647], [68, 74747], [74, 75127], [79, 75367], [83, 75607], [86, 75727], [94, 76496], [98, 76592], [102, 76772], [105, 76932], [112, 77352], [117, 77752], [122, 77932], [130, 78372], [132, 78912], [138, 79212], [144, 79552], [150, 79872], [154, 80132]]}, {"verse": 11, "start": 81332, "end": 88335, "text": "Líbrame ahora de la mano de mi hermano, de la mano de Esaú, porque le temo; no venga quizá, y me hiera la madre con los hijos.", "words": [[0, 81332], [8, 81756], [14, 81976], [17, 82156], [20, 82276], [25, 82496], [28, 82656], [31, 82776], [40, 83516], [43, 83596], [46, 83696], [51, 83896], [54, 84296], [60, 84696], [67, 84856], [70, 85036], [76, 85765], [79, 85865], [85, 86145], [92, 86795], [94, 86935], [97, 87055], [103, 87315], [106, 87415], [112, 87675], [116, 87875], [120, 88075]]}, {"verse": 12, "start": 88685, "end": 95333, "text": "Y tú has dicho: Yo te haré bien, y pondré tu simiente como la arena del mar, que no se puede contar por la multitud.", "words": [[0, 88745], [2, 89030], [5, 89190], [9, 89330], [16, 90064], [19, 90209], [22, 90369], [27, 90609], [33, 90829], [35, 91189], [42, 91589], [45, 91749], [54, 92269], [59, 92549], [62, 92729], [68, 92969], [72, 93169], [77, 93369], [81, 93589], [84, 93729], [87, 93889], [93, 94089], [100, 94429], [104, 94649], [107, 94789]]}, {"verse": 13, "start": 95613, "end": 101725, "text": "Y durmió allí aquella noche, y tomó de lo que le vino a la mano un presente para su hermano Esaú:", "words": [[0, 95613], [2, 95739], [9, 96239], [14, 96519], [22, 96979], [29, 97339], [31, 97979], [36, 98399], [39, 98479], [42, 98619], [46, 98759], [49, 98879], [54, 99139], [56, 99319], [59, 99399], [64, 99639], [67, 99799], [76, 100179], [81, 100639], [84, 100839], [92, 101309]]}, {"verse": 14, "start": 102075, "end": 107457, "text": "Doscientas cabras y veinte machos cabríos, doscientas ovejas y veinte carneros,", "words": [[0, 102075], [11, 102075], [18, 102617], [20, 103077], [27, 103457], [34, 104197], [43, 104937], [54, 105597], [61, 106117], [63, 106397], [70, 106717]]}, {"verse": 15, "start": 107807, "end": 114112, "text": "Treinta camellas paridas, con sus hijos, cuarenta vacas y diez novillos, veinte asnas y diez borricos.", "words": [[0, 108093], [8, 108413], [17, 108733], [26, 109153], [30, 109373], [34, 109593], [41, 110173], [50, 110753], [56, 111273], [58, 111433], [63, 111593], [73, 112153], [80, 112713], [86, 113373], [88, 113641], [93, 113908]]}, {"verse": 16, "start": 114462, "end": 124469, "text": "Y lo entregó en mano de sus siervos, cada manada de por sí; y dijo a sus siervos: Pasad delante de mí, y poned espacio entre manada y manada.", "words": [[0, 114929], [2, 115189], [5, 115289], [13, 115769], [16, 115869], [21, 116089], [24, 116249], [28, 116739], [37, 117229], [42, 117549], [49, 118049], [52, 118229], [56, 118429], [60, 119044], [62, 119220], [67, 119430], [69, 119590], [73, 119730], [82, 120867], [88, 121027], [96, 121487], [99, 121647], [103, 121807], [105, 122234], [111, 122660], [119, 123087], [125, 123307], [132, 123747], [134, 123947]]}, {"verse": 17, "start": 124749, "end": 135478, "text": "Y mandó al primero, diciendo: Si Esaú mi hermano te encuentra, y te pregunta, diciendo: ¿De quién eres? ¿y adónde vas? ¿y para quién es esto que llevas delante de ti?", "words": [[0, 124749], [2, 124890], [8, 125170], [11, 125450], [20, 125850], [30, 126969], [33, 127188], [38, 127442], [41, 127695], [49, 128075], [52, 128175], [63, 128635], [65, 128795], [68, 128915], [78, 129435], [88, 130728], [92, 130886], [98, 131086], [104, 131845], [107, 132023], [114, 132303], [119, 132996], [122, 133078], [127, 133258], [133, 133498], [136, 133718], [141, 134018], [145, 134158], [152, 134518], [160, 134938], [163, 135118]]}, {"verse": 18, "start": 135828, "end": 143135, "text": "Entonces dirás: Es un regalo de tu siervo Jacob, que envía a mi señor Esaú; y he aquí también él viene tras nosotros.", "words": [[0, 135828], [9, 136263], [16, 137204], [19, 137328], [22, 137448], [29, 137848], [32, 137968], [35, 138108], [42, 138528], [49, 138848], [53, 139188], [59, 139548], [61, 139628], [64, 139708], [70, 140028], [76, 140819], [78, 140870], [81, 140960], [86, 141180], [94, 141520], [97, 141880], [103, 142100], [108, 142380]]}, {"verse": 19, "start": 143415, "end": 154212, "text": "Y mandó también al segundo, y al tercero, y a todos los que iban tras aquellas manadas, diciendo: Conforme a esto hablaréis a Esaú, cuando lo encontréis.", "words": [[0, 143415], [2, 143578], [8, 143938], [16, 144358], [19, 144678], [28, 145278], [30, 145683], [33, 145863], [42, 146783], [44, 147063], [46, 147143], [52, 147463], [56, 147783], [60, 148003], [65, 148343], [70, 148543], [79, 149103], [88, 149623], [98, 151190], [107, 151551], [109, 151691], [114, 151931], [124, 152451], [126, 152591], [132, 152891], [139, 153251], [142, 153451]]}, {"verse": 20, "start": 154562, "end": 165933, "text": "Y diréis también: He aquí tu siervo Jacob viene tras nosotros. Porque dijo: Apaciguaré su ira con el regalo que va delante de mí, y después veré su rostro: quizá me reciba bien.", "words": [[0, 154562], [2, 154662], [9, 154982], [18, 155877], [21, 155957], [26, 156157], [29, 156357], [36, 156717], [42, 157017], [48, 157417], [53, 157697], [63, 158825], [70, 158995], [76, 160035], [87, 160355], [90, 160495], [94, 160775], [98, 160935], [101, 161075], [108, 161455], [112, 161595], [115, 161735], [123, 162155], [126, 162315], [130, 162515], [132, 162975], [140, 163275], [145, 163735], [148, 163815], [156, 164624], [162, 165008], [165, 165108], [172, 165568]]}, {"verse": 21, "start": 166213, "end": 172432, "text": "Y pasó el presente delante de él; y él durmió aquella noche en el campamento.", "words": [[0, 166213], [2, 166363], [7, 166783], [10, 167143], [19, 167703], [27, 168383], [30, 168583], [34, 169299], [36, 169721], [39, 169841], [46, 170301], [54, 170761], [60, 171221], [63, 171361], [66, 171481]]}, {"verse": 22, "start": 172782, "end": 181665, "text": "Y se levantó aquella noche, y tomó sus dos mujeres, y sus dos siervas, y sus once hijos, y pasó el vado de Jaboc.", "words": [[0, 172782], [2, 172906], [5, 173026], [13, 173606], [21, 173946], [28, 174926], [30, 175266], [35, 175606], [39, 175786], [43, 175966], [52, 176446], [54, 176786], [58, 176926], [62, 177146], [71, 177766], [73, 178146], [77, 178306], [82, 178766], [89, 179166], [91, 179826], [96, 180186], [99, 180586], [104, 180946], [107, 181338]]}, {"verse": 23, "start": 182015, "end": 187038, "text": "Los tomó pues, y los hizo pasar el arroyo, e hizo pasar lo que tenía.", "words": [[0, 182015], [4, 182163], [9, 182523], [15, 182943], [17, 183283], [21, 183463], [26, 183763], [32, 184143], [35, 184363], [43, 185283], [45, 185463], [50, 185703], [56, 185983], [59, 186243], [63, 186383]]}, {"verse": 24, "start": 187388, "end": 192506, "text": "Y se quedó Jacob solo, y luchó con él un varón hasta que rayaba el alba.", "words": [[0, 187388], [2, 187534], [5, 187614], [11, 187954], [17, 188234], [23, 188754], [25, 189334], [31, 189734], [35, 189914], [38, 190094], [41, 190314], [47, 190814], [53, 191074], [57, 191254], [64, 191754], [67, 191914]]}, {"verse": 25, "start": 192856, "end": 201724, "text": "Y cuando vio que no podía con él, tocó en la coyuntura de su cadera, y se dislocó la cadera de Jacob mientras con él luchaba.", "words": [[0, 192856], [2, 192982], [9, 193222], [13, 193602], [17, 193762], [20, 193922], [26, 194302], [30, 194582], [34, 195182], [39, 195522], [42, 195682], [45, 195822], [55, 196462], [58, 196622], [61, 196782], [69, 197262], [71, 197742], [74, 198222], [82, 198702], [85, 198842], [92, 199262], [95, 199382], [101, 199782], [110, 200382], [114, 200802], [117, 200942]]}, {"verse": 26, "start": 202074, "end": 207610, "text": "Y dijo: Déjame, que raya el alba. Y él dijo: No te dejaré, si no me bendices.", "words": [[0, 202074], [2, 202218], [8, 202962], [16, 203339], [20, 203519], [25, 203919], [28, 204039], [34, 204718], [36, 204906], [39, 205066], [45, 205785], [48, 205966], [51, 206126], [59, 206566], [62, 206686], [65, 206766], [68, 206886]]}, {"verse": 27, "start": 207890, "end": 212094, "text": "Y él le dijo: ¿Cuál es tu nombre? Y él respondió: Jacob.", "words": [[0, 207890], [2, 208058], [5, 208198], [8, 208358], [14, 209082], [20, 209283], [23, 209423], [26, 209543], [34, 210320], [36, 210502], [39, 210642], [50, 211873]]}, {"verse": 28, "start": 212374, "end": 219789, "text": "Y él dijo: No se dirá más tu nombre Jacob, sino Israel: porque has peleado con Dios y con los hombres, y has vencido.", "words": [[0, 212374], [2, 212562], [5, 212722], [11, 213441], [14, 213578], [17, 213698], [22, 213998], [26, 214118], [29, 214338], [36, 214698], [43, 215418], [48, 215578], [56, 216497], [63, 216675], [67, 216855], [75, 217335], [79, 217535], [84, 217775], [86, 218015], [90, 218155], [94, 218295], [103, 218675], [105, 218975], [109, 219135]]}, {"verse": 29, "start": 220069, "end": 228851, "text": "Entonces Jacob le preguntó, y dijo: Dime ahora tu nombre. Y él respondió: ¿Por qué preguntas por mi nombre? Y lo bendijo allí.", "words": [[0, 220069], [9, 220814], [15, 221074], [18, 221434], [28, 222074], [30, 222254], [36, 222915], [41, 223173], [47, 223393], [50, 223593], [58, 224380], [60, 224562], [63, 224702], [74, 225697], [79, 225857], [83, 225977], [93, 226417], [97, 226737], [100, 226877], [108, 227620], [110, 227730], [113, 227870], [121, 228370]]}, {"verse": 30, "start": 229201, "end": 236200, "text": "Y llamó Jacob el nombre de aquel lugar, Peniel: porque vi a Dios cara a cara, y fue librada mi alma.", "words": [[0, 229201], [2, 229309], [8, 229669], [14, 229889], [17, 230229], [24, 230569], [27, 230789], [33, 231149], [40, 231849], [48, 232751], [55, 233587], [58, 233783], [60, 233923], [65, 234143], [70, 234443], [72, 234603], [78, 234863], [80, 235048], [84, 235228], [92, 235628], [95, 235788]]}, {"verse": 31, "start": 236480, "end": 241454, "text": "Y le salió el sol después que hubo pasado Peniel; y cojeaba de su cadera.", "words": [[0, 236480], [2, 236606], [5, 236706], [11, 237106], [14, 237286], [18, 237506], [26, 237926], [30, 238166], [35, 238386], [42, 238726], [50, 239592], [52, 240049], [60, 240509], [63, 240669], [66, 240809]]}, {"verse": 32, "start": 241804, "end": 255747, "text": "Por esto no comen los hijos de Israel, hasta hoy día, del tendón que se contrajo, el cual está en el encaje del muslo: porque tocó a Jacob este sitio de su muslo en el tendón que se contrajo.", "words": [[0, 241804], [4, 241948], [9, 242168], [12, 242408], [18, 242728], [22, 242968], [28, 243308], [31, 243468], [39, 244028], [45, 244508], [49, 244868], [54, 245388], [58, 246028], [65, 246548], [69, 246668], [72, 246828], [82, 247568], [85, 248228], [90, 248468], [95, 248908], [98, 249168], [101, 249328], [108, 249968], [112, 250128], [119, 251046], [126, 251230], [131, 251750], [133, 251850], [139, 252190], [144, 252590], [150, 253030], [153, 253210], [156, 253370], [162, 253870], [165, 254110], [168, 254250], [175, 254670], [179, 254830], [182, 254950]]}]}