{"book": "GEN", "chapter": 43, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 288550, "verses": [{"verse": 1, "start": 300, "end": 2613, "text": "And the famine was severe in the land.", "words": [[0, 300], [4, 447], [8, 567], [15, 887], [19, 1207], [26, 1667], [29, 1947], [33, 2087]]}, {"verse": 2, "start": 3063, "end": 12486, "text": "And it came to pass, when they had eaten up the grain which they had brought out of Egypt, their father said to them, Go again, buy us a little food.", "words": [[0, 3063], [4, 3164], [7, 3264], [12, 3484], [15, 3644], [21, 3964], [26, 4264], [31, 4424], [35, 4544], [41, 4744], [44, 4964], [48, 5124], [54, 5424], [60, 5724], [65, 5924], [69, 6084], [77, 6304], [81, 6544], [84, 6684], [91, 7444], [97, 7564], [104, 7924], [109, 8264], [112, 8464], [118, 9140], [121, 9316], [128, 9696], [132, 9856], [135, 10036], [137, 10156], [144, 10276]]}, {"verse": 3, "start": 12836, "end": 20747, "text": "And Judah spoke to him, saying, The man did solemnly protest to us, saying, You shall not see my face, unless your brother be with you.", "words": [[0, 12836], [4, 13000], [10, 13160], [16, 13540], [19, 13820], [24, 14160], [32, 15062], [36, 15198], [40, 15438], [44, 15598], [53, 16118], [61, 16418], [64, 16738], [68, 17118], [76, 17658], [80, 17898], [86, 18078], [90, 18278], [94, 18478], [97, 18638], [103, 19018], [110, 19538], [115, 19758], [123, 19998], [126, 20198], [131, 20458]]}, {"verse": 4, "start": 21197, "end": 24616, "text": "If you will send our brother with us, we will go down and buy you food:", "words": [[0, 21197], [3, 21353], [7, 21493], [12, 21613], [17, 21853], [21, 21993], [29, 22253], [34, 22513], [38, 22973], [41, 23073], [46, 23213], [49, 23353], [54, 23653], [58, 23893], [62, 24073], [66, 24213]]}, {"verse": 5, "start": 25066, "end": 32486, "text": "But if you will not send him, we will not go down: for the man said to us, You shall not see my face, unless your brother be with you.", "words": [[0, 25066], [4, 25143], [7, 25283], [11, 25383], [16, 25483], [20, 25643], [25, 25923], [30, 26443], [33, 26563], [38, 26704], [42, 26864], [45, 27024], [51, 27731], [55, 27817], [59, 27957], [63, 28157], [68, 28437], [71, 28657], [75, 29177], [79, 29337], [85, 29577], [89, 29817], [93, 30057], [96, 30237], [102, 30617], [109, 31157], [114, 31437], [122, 31757], [125, 31977], [130, 32237]]}, {"verse": 6, "start": 32836, "end": 38048, "text": "And Israel said, Why did you deal so ill with me, as to tell the man whether you had yet a brother?", "words": [[0, 32836], [4, 32957], [11, 33337], [17, 34240], [21, 34376], [25, 34516], [29, 34656], [34, 34816], [37, 35016], [41, 35296], [46, 35516], [50, 35716], [53, 35996], [56, 36156], [61, 36356], [65, 36516], [69, 36716], [77, 36956], [81, 37156], [85, 37356], [89, 37536], [91, 37656]]}, {"verse": 7, "start": 38398, "end": 53621, "text": "And they said, The man asked us straitly of our state, and of our kindred, saying, Is your father yet alive? have you another brother? and we told him according to the tenor of these words: could we certainly know that he would say, Bring your brother down?", "words": [[0, 38398], [4, 38526], [9, 38666], [15, 38906], [19, 39086], [23, 39346], [29, 39726], [32, 40156], [41, 40586], [44, 40746], [48, 40926], [55, 41326], [59, 41926], [62, 42066], [66, 42206], [75, 42806], [83, 43346], [86, 43646], [91, 43806], [98, 44166], [102, 44466], [109, 45421], [114, 45572], [118, 45692], [126, 45952], [135, 46814], [139, 46932], [142, 47092], [147, 47352], [151, 47592], [161, 47952], [164, 48212], [168, 48332], [174, 48692], [177, 48832], [183, 48992], [190, 49942], [196, 50065], [199, 50225], [209, 50565], [214, 50985], [219, 51245], [222, 51405], [228, 51565], [233, 52105], [239, 52505], [244, 52705], [252, 52945]]}, {"verse": 8, "start": 54071, "end": 64020, "text": "And Judah said to Israel his father, Send the lad with me, and we will arise and go; that we may live, and not die, both we, and you, and also our little ones.", "words": [[0, 54071], [4, 54385], [10, 54625], [15, 54945], [18, 55145], [25, 55625], [29, 55745], [37, 56563], [42, 56758], [46, 56938], [50, 57098], [55, 57298], [59, 57578], [63, 57978], [66, 58138], [71, 58318], [77, 58678], [81, 58918], [85, 59656], [90, 59778], [93, 59958], [97, 60118], [103, 60458], [107, 60798], [111, 61018], [116, 61338], [121, 61618], [125, 61978], [129, 62198], [134, 62418], [138, 62778], [143, 63118], [147, 63298], [154, 63538]]}, {"verse": 9, "start": 64470, "end": 72742, "text": "I will be surety for him; of my hand shall you require him: if I bring him not to you, and set him before you, then let me bear the blame for ever:", "words": [[0, 64470], [2, 64630], [7, 64770], [10, 64930], [17, 65450], [21, 65650], [26, 66272], [29, 66407], [32, 66567], [37, 66867], [43, 67067], [47, 67247], [55, 67607], [60, 68350], [63, 68492], [65, 68592], [71, 68812], [75, 68972], [79, 69152], [82, 69332], [87, 69512], [91, 69732], [95, 69992], [99, 70132], [106, 70452], [111, 71052], [116, 71152], [120, 71292], [123, 71472], [128, 71712], [132, 71852], [138, 72162], [142, 72472]]}, {"verse": 10, "start": 73192, "end": 76864, "text": "For unless we had lingered, surely now we had returned this second time.", "words": [[0, 73192], [4, 73315], [11, 73515], [14, 73735], [18, 73875], [28, 74535], [35, 74775], [39, 75155], [42, 75375], [46, 75535], [55, 75835], [60, 76135], [67, 76415]]}, {"verse": 11, "start": 77214, "end": 91745, "text": "And their father Israel said to them, If it must be so now, do this; take of the best fruits in the land in your vessels, and carry down the man a present, a little balm, and a little honey, spices, and myrrh, nuts, and almonds:", "words": [[0, 77214], [4, 77346], [10, 77466], [17, 77846], [24, 78486], [29, 78646], [32, 78886], [38, 80153], [41, 80297], [44, 80417], [49, 80617], [52, 80837], [55, 81037], [60, 81617], [63, 81837], [69, 82597], [74, 82787], [77, 82907], [81, 83047], [86, 83327], [93, 83587], [96, 83807], [100, 83887], [105, 84147], [108, 84307], [113, 84467], [122, 84887], [126, 85367], [132, 85667], [137, 85927], [141, 86067], [145, 86287], [147, 86407], [156, 87127], [158, 87187], [165, 87467], [171, 87747], [175, 88127], [177, 88227], [184, 88367], [191, 88907], [199, 89307], [203, 89747], [210, 90187], [216, 90987], [220, 91101]]}, {"verse": 12, "start": 92195, "end": 100017, "text": "And take double money in your hand; and the money that was brought again in the mouth of your sacks, carry it again in your hand; perhaps it was an oversight:", "words": [[0, 92195], [4, 92292], [9, 92472], [16, 92752], [22, 93052], [25, 93212], [30, 93312], [36, 94068], [40, 94191], [44, 94291], [50, 94511], [55, 94691], [59, 94831], [67, 95071], [73, 95371], [76, 95551], [80, 95651], [86, 95871], [89, 96011], [94, 96111], [101, 96691], [107, 97071], [110, 97271], [116, 97511], [119, 97671], [124, 97791], [130, 98519], [138, 98823], [141, 99083], [145, 99223], [148, 99343]]}, {"verse": 13, "start": 100467, "end": 103723, "text": "Take also your brother, and arise, go again to the man:", "words": [[0, 100467], [5, 100618], [10, 100978], [15, 101198], [24, 101498], [28, 101898], [35, 102618], [38, 102758], [44, 103038], [47, 103218], [51, 103318]]}, {"verse": 14, "start": 104173, "end": 112126, "text": "And God Almighty give you mercy before the man, that he may send away your other brother, and Benjamin. If I be bereaved of my children, I am bereaved.", "words": [[0, 104173], [4, 104309], [8, 104529], [17, 104849], [22, 105149], [26, 105249], [32, 105529], [39, 105809], [43, 105989], [48, 106289], [53, 106569], [56, 106689], [60, 106809], [65, 107109], [70, 107349], [75, 107549], [81, 107769], [90, 108109], [94, 108409], [104, 109266], [107, 109415], [109, 109575], [112, 109715], [121, 110255], [124, 110375], [127, 110515], [137, 111335], [139, 111455], [142, 111535]]}, {"verse": 15, "start": 112476, "end": 121157, "text": "¶ And the men took that present, and they took double money in their hand, and Benjamin; and rose up, and went down to Egypt, and stood before Joseph.", "words": [[2, 112476], [6, 112635], [10, 112715], [14, 112895], [19, 113155], [24, 113375], [33, 114135], [37, 114295], [42, 114415], [47, 114635], [54, 114895], [60, 115215], [63, 115415], [69, 115575], [75, 115955], [79, 116215], [89, 117184], [93, 117500], [98, 117740], [102, 118100], [106, 118440], [111, 118640], [116, 118880], [119, 119060], [126, 119380], [130, 119780], [136, 120020], [143, 120340]]}, {"verse": 16, "start": 121607, "end": 130940, "text": "And when Joseph saw Benjamin with them, he said to the ruler of his house, Bring these men home, and slay, and make ready; for these men shall dine with me at noon.", "words": [[0, 121607], [4, 121760], [9, 121920], [16, 122300], [20, 122680], [29, 123120], [34, 123520], [40, 124120], [43, 124240], [48, 124520], [51, 124700], [55, 124840], [61, 125100], [64, 125340], [68, 125460], [75, 126254], [81, 126413], [87, 126653], [91, 126873], [97, 127193], [101, 127513], [107, 127893], [111, 128113], [116, 128313], [123, 129079], [127, 129182], [133, 129382], [137, 129622], [143, 129802], [148, 130102], [153, 130222], [156, 130402], [159, 130542]]}, {"verse": 17, "start": 131290, "end": 135625, "text": "And the man did as Joseph bade; and the man brought the men into Joseph’s house.", "words": [[0, 131290], [4, 131412], [8, 131512], [12, 131712], [16, 131932], [19, 132112], [26, 132452], [32, 133376], [36, 133482], [40, 133582], [44, 133782], [52, 133982], [56, 134162], [60, 134362], [65, 134562], [74, 135142]]}, {"verse": 18, "start": 136075, "end": 151425, "text": "And the men were afraid, because they were brought into Joseph’s house; and they said, Because of the money that was returned in our sacks at the first time are we brought in; that he may seek occasion against us, and fall upon us, and take us for bondmen, and our donkeys.", "words": [[0, 136075], [4, 136200], [8, 136281], [12, 136460], [17, 136660], [25, 137100], [33, 137740], [38, 137960], [43, 138080], [51, 138360], [56, 138580], [65, 139180], [72, 139944], [76, 140097], [81, 140237], [87, 140617], [95, 140817], [98, 141077], [102, 141197], [108, 141477], [113, 141697], [117, 141837], [126, 142237], [129, 142457], [133, 142577], [139, 142977], [142, 143137], [146, 143237], [152, 143457], [157, 143957], [161, 144057], [164, 144197], [172, 144457], [176, 145192], [181, 145301], [184, 145441], [188, 145601], [193, 145901], [202, 146401], [210, 146841], [214, 147161], [218, 147641], [223, 147961], [228, 148221], [232, 148541], [236, 148981], [241, 149221], [244, 149401], [248, 149581], [257, 150201], [261, 150521], [265, 150641]]}, {"verse": 19, "start": 151875, "end": 158206, "text": "And they came near to the steward of Joseph’s house, and they communed with him at the door of the house,", "words": [[0, 151875], [4, 152029], [9, 152149], [14, 152349], [19, 152609], [22, 152809], [26, 152949], [34, 153329], [37, 153429], [46, 153969], [53, 154529], [57, 154769], [62, 154889], [71, 155369], [76, 155509], [80, 155669], [83, 155789], [87, 155889], [92, 156109], [95, 156229], [99, 156349]]}, {"verse": 20, "start": 158656, "end": 163351, "text": "And said, O sir, we came indeed down at the first time to buy food:", "words": [[0, 158656], [4, 158806], [10, 159136], [12, 159466], [17, 160206], [20, 160406], [25, 160686], [32, 161086], [37, 161506], [40, 161666], [44, 161766], [50, 162006], [55, 162346], [58, 162526], [62, 162746]]}, {"verse": 21, "start": 163801, "end": 175368, "text": "And it came to pass, when we came to the inn, that we opened our sacks, and, behold, every man’s money was in the mouth of his sack, our money in full weight: and we have brought it again in our hand.", "words": [[0, 163801], [4, 163938], [7, 164038], [12, 164258], [15, 164438], [21, 165018], [26, 165218], [29, 165378], [34, 165618], [37, 165778], [41, 165898], [46, 166538], [51, 166618], [54, 166758], [61, 167058], [65, 167568], [72, 168078], [77, 168238], [85, 168978], [91, 169238], [97, 169638], [103, 169858], [107, 170058], [110, 170198], [114, 170298], [120, 170518], [123, 170678], [127, 171047], [133, 171695], [137, 171775], [143, 172055], [146, 172255], [151, 172475], [159, 173304], [163, 173438], [166, 173618], [171, 173758], [179, 174018], [182, 174198], [188, 174518], [191, 174718], [195, 174878]]}, {"verse": 22, "start": 175818, "end": 182609, "text": "And other money have we brought down in our hands to buy food: we cannot tell who put our money in our sacks.", "words": [[0, 175818], [4, 176158], [10, 176378], [16, 176738], [21, 176998], [24, 177158], [32, 177418], [37, 177758], [40, 177958], [44, 178098], [50, 178378], [53, 178598], [57, 178838], [63, 179719], [66, 180049], [73, 180309], [78, 180729], [82, 180969], [86, 181169], [90, 181289], [96, 181569], [99, 181769], [103, 182204]]}, {"verse": 23, "start": 183059, "end": 193766, "text": "And he said, Peace be to you, fear not: your God, and the God of your father, has given you treasure in your sacks: I had your money. And he brought Simeon out to them.", "words": [[0, 183059], [4, 183194], [7, 183334], [13, 184792], [19, 184974], [22, 185214], [25, 185374], [30, 185734], [35, 185854], [40, 186681], [45, 186803], [50, 187143], [54, 187383], [58, 187483], [62, 187723], [65, 187843], [70, 187943], [78, 188283], [82, 188563], [88, 188783], [92, 188943], [101, 189283], [104, 189563], [109, 189663], [116, 190581], [118, 190828], [122, 191008], [127, 191148], [134, 191881], [138, 192015], [141, 192115], [149, 192355], [156, 193035], [160, 193175], [163, 193375]]}, {"verse": 24, "start": 194216, "end": 201473, "text": "And the man brought the men into Joseph’s house, and gave them water, and they washed their feet; and he gave their donkeys provender.", "words": [[0, 194216], [4, 194359], [8, 194479], [12, 194739], [20, 195019], [24, 195239], [28, 195459], [33, 195679], [42, 196299], [49, 196479], [53, 196679], [58, 196899], [63, 197139], [70, 197779], [74, 198019], [79, 198159], [86, 198499], [92, 198739], [98, 199503], [102, 199627], [105, 199747], [110, 199967], [116, 200187], [124, 200867]]}, {"verse": 25, "start": 201923, "end": 207278, "text": "And they made ready the present against Joseph came at noon: for they heard that they should eat bread there.", "words": [[0, 201923], [4, 202058], [9, 202198], [14, 202438], [20, 202718], [24, 202878], [32, 203218], [40, 203538], [47, 204018], [52, 204358], [55, 204538], [61, 205359], [65, 205447], [70, 205627], [76, 205827], [81, 206007], [86, 206187], [93, 206327], [97, 206507], [103, 206767]]}, {"verse": 26, "start": 207728, "end": 214740, "text": "¶ And when Joseph came home, they brought him the present which was in their hand into the house, and bowed themselves to him to the earth.", "words": [[2, 207728], [6, 207862], [11, 208002], [18, 208302], [23, 208622], [29, 209342], [34, 209502], [42, 209742], [46, 209942], [50, 210082], [58, 210422], [64, 210682], [68, 210862], [71, 211022], [77, 211162], [82, 211462], [87, 211682], [91, 211862], [98, 212202], [102, 212782], [108, 213162], [119, 213462], [122, 213822], [126, 214002], [129, 214182], [133, 214302]]}, {"verse": 27, "start": 215190, "end": 221826, "text": "And he asked them of their welfare, and said, Is your father well, the old man of whom you spoke? Is he yet alive?", "words": [[0, 215190], [4, 215317], [7, 215437], [13, 215737], [18, 215957], [21, 216137], [27, 216277], [36, 216717], [40, 217277], [46, 218033], [49, 218152], [54, 218272], [61, 218532], [67, 219032], [71, 219112], [75, 219292], [79, 219532], [82, 219692], [87, 219812], [91, 219972], [98, 220772], [101, 220936], [104, 221116], [108, 221296]]}, {"verse": 28, "start": 222176, "end": 230247, "text": "And they answered, Your servant our father is in good health, he is yet alive. And they bowed down their heads, and made obeisance.", "words": [[0, 222176], [4, 222316], [9, 222456], [19, 222996], [24, 223096], [32, 223676], [36, 223796], [43, 224176], [46, 224496], [49, 224656], [54, 224896], [62, 225656], [65, 225776], [68, 225976], [72, 226196], [79, 227161], [83, 227306], [88, 227446], [94, 227906], [99, 228106], [105, 228346], [112, 228706], [116, 229206], [121, 229446]]}, {"verse": 29, "start": 230697, "end": 242323, "text": "And he lifted up his eyes, and saw his brother Benjamin, his mother’s son, and said, Is this your younger brother, of whom you spoke to me? And he said, God be gracious to you, my son.", "words": [[0, 230697], [4, 230819], [7, 230939], [14, 231239], [17, 231459], [21, 231619], [27, 232019], [31, 232659], [35, 232919], [39, 233099], [47, 233399], [57, 234399], [61, 234499], [70, 234999], [75, 235659], [79, 235699], [85, 236679], [88, 236899], [93, 237099], [98, 237319], [106, 237599], [115, 237959], [118, 238419], [123, 238579], [127, 238739], [133, 238979], [136, 239179], [140, 239758], [144, 239872], [147, 240012], [153, 240272], [157, 240552], [160, 240752], [169, 241192], [172, 241492], [177, 241732], [180, 241852]]}, {"verse": 30, "start": 242773, "end": 251855, "text": "And Joseph made haste; for his bowels did yearn upon his brother: and he sought where to weep; and he entered into his chamber, and wept there.", "words": [[0, 242773], [4, 242917], [11, 243257], [16, 243617], [23, 244517], [27, 244777], [31, 244937], [38, 245457], [42, 245637], [48, 245997], [53, 246157], [57, 246437], [66, 247286], [70, 247414], [73, 247514], [80, 247814], [86, 248154], [89, 248374], [95, 249061], [99, 249198], [102, 249318], [110, 249578], [115, 249898], [119, 250058], [128, 250458], [132, 251058], [137, 251418]]}, {"verse": 31, "start": 252305, "end": 257369, "text": "And he washed his face, and went out, and refrained himself, and said, Set on bread.", "words": [[0, 252305], [4, 252424], [7, 252544], [14, 252844], [18, 253084], [24, 253404], [28, 253904], [33, 254104], [38, 254384], [42, 254624], [52, 255064], [61, 255504], [65, 255984], [71, 256713], [75, 256850], [78, 256990]]}, {"verse": 32, "start": 257719, "end": 270739, "text": "And they set on for him by himself, and for them by themselves, and for the Egyptians, which did eat with him, by themselves: because the Egyptians might not eat bread with the Hebrews; for that is an abomination to the Egyptians.", "words": [[0, 257719], [4, 257851], [9, 257991], [13, 258271], [16, 258471], [20, 258691], [24, 258871], [27, 259151], [36, 259591], [40, 259991], [44, 260171], [49, 260351], [52, 260591], [64, 261091], [68, 261451], [72, 261611], [76, 261751], [87, 262571], [93, 262891], [97, 263191], [101, 263371], [106, 263611], [111, 263811], [114, 264051], [126, 265152], [134, 265338], [138, 265538], [148, 265918], [154, 266278], [158, 266478], [162, 266638], [168, 266938], [173, 267158], [177, 267278], [186, 268235], [190, 268355], [195, 268575], [198, 268815], [201, 268935], [213, 269495], [216, 269895], [220, 270035]]}, {"verse": 33, "start": 271189, "end": 278891, "text": "And they sat before him, the firstborn according to his birthright, and the youngest according to his youth: and the men marvelled one at another.", "words": [[0, 271189], [4, 271312], [9, 271432], [13, 271692], [20, 272052], [25, 272572], [29, 272912], [39, 273252], [49, 273632], [52, 273892], [56, 274032], [68, 274732], [72, 274932], [76, 275072], [85, 275332], [95, 275812], [98, 276092], [102, 276272], [109, 276961], [113, 277102], [117, 277202], [121, 277602], [131, 278002], [135, 278202], [138, 278382]]}, {"verse": 34, "start": 279341, "end": 288150, "text": "And he took and sent portions to them from before him: but Benjamin’s portion was five times so much as any of theirs. And they drank, and were merry with him.", "words": [[0, 279341], [4, 279473], [7, 279593], [12, 279873], [16, 280093], [21, 280373], [30, 280793], [33, 281133], [38, 281333], [43, 281573], [50, 281913], [55, 282601], [59, 282730], [70, 283290], [78, 283590], [82, 283870], [87, 284210], [93, 284570], [96, 284770], [101, 285010], [104, 285130], [108, 285350], [111, 285490], [119, 286380], [123, 286498], [128, 286598], [135, 286918], [139, 287138], [144, 287368], [150, 287598], [155, 287898]]}]}