{"book": "LUK", "chapter": 8, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 510974, "verses": [{"verse": 1, "start": 300, "end": 10669, "text": "Y aconteció después, que él caminaba por todas las ciudades y aldeas, predicando y anunciando el evangelio del reino de Dios, y los doce con él,", "words": [[0, 300], [2, 497], [12, 1497], [21, 2277], [25, 2537], [28, 2737], [37, 3317], [41, 3557], [47, 3857], [51, 4117], [60, 4717], [62, 4877], [70, 5437], [81, 6597], [83, 6757], [94, 7437], [97, 7557], [107, 8137], [111, 8317], [117, 8677], [120, 8817], [126, 9117], [128, 9517], [132, 9677], [137, 10077], [141, 10337]]}, {"verse": 2, "start": 11019, "end": 21645, "text": "Y algunas mujeres que habían sido curadas de malos espíritus y de enfermedades: María, que se llamaba Magdalena, de la cual habían salido siete demonios,", "words": [[0, 11019], [2, 11119], [10, 11359], [18, 11879], [22, 12119], [29, 12339], [34, 12659], [42, 13199], [45, 13379], [51, 13699], [61, 14699], [63, 14859], [66, 14979], [80, 16380], [87, 17006], [91, 17246], [94, 17366], [102, 17806], [113, 19026], [116, 19246], [119, 19366], [124, 19526], [131, 19826], [138, 20346], [144, 20666]]}, {"verse": 3, "start": 21995, "end": 29669, "text": "Y Juana, mujer de Chuza, administrador de Herodes, y Susana, y otras muchas que le servían con sus bienes.", "words": [[0, 21995], [2, 22155], [9, 22795], [15, 22895], [18, 23352], [25, 23810], [39, 24790], [42, 25010], [51, 25610], [53, 26030], [61, 26630], [63, 27090], [69, 27270], [76, 27630], [80, 27850], [83, 27970], [91, 28450], [95, 28670], [99, 28890]]}, {"verse": 4, "start": 30019, "end": 37150, "text": "Y como se juntó una gran multitud, y los que estaban en cada ciudad vinieron a él, dijo por una parábola:", "words": [[0, 30019], [2, 30165], [7, 30465], [10, 30645], [16, 31145], [20, 31325], [25, 31565], [35, 32285], [37, 32460], [41, 32620], [45, 32740], [53, 33060], [56, 33280], [61, 33520], [68, 33880], [77, 34560], [79, 34760], [83, 35380], [88, 35880], [92, 36180], [96, 36360]]}, {"verse": 5, "start": 37500, "end": 47213, "text": "Uno que sembraba, salió a sembrar su semilla; y sembrando, una parte cayó junto al camino, y fue pisoteada; y las aves del cielo la comieron.", "words": [[0, 37500], [4, 37670], [8, 37850], [18, 38510], [24, 39250], [26, 39390], [34, 39830], [37, 40050], [46, 40952], [48, 41074], [59, 41594], [63, 41774], [69, 42314], [74, 42554], [80, 42774], [83, 42994], [91, 43434], [93, 43649], [97, 43809], [108, 44976], [110, 45078], [114, 45218], [119, 45598], [123, 45798], [129, 46178], [132, 46418]]}, {"verse": 6, "start": 47563, "end": 53147, "text": "Y otra parte cayó sobre la piedra; y nacida, se secó, porque no tenía humedad.", "words": [[0, 47563], [2, 47863], [7, 48043], [13, 48343], [18, 48843], [24, 49083], [27, 49303], [35, 50167], [37, 50315], [45, 50815], [48, 50995], [54, 51495], [61, 51975], [64, 52155], [70, 52475]]}, {"verse": 7, "start": 53497, "end": 59664, "text": "Y otra parte cayó entre las espinas; y naciendo las espinas juntamente, la ahogaron.", "words": [[0, 53497], [2, 53616], [7, 53816], [13, 54256], [18, 54776], [24, 55056], [28, 55316], [37, 56360], [39, 56501], [48, 57021], [52, 57261], [60, 57661], [72, 58321], [75, 58661]]}, {"verse": 8, "start": 60014, "end": 71376, "text": "Y otra parte cayó en buena tierra, y cuando fue nacida, llevó fruto a ciento por uno. Diciendo estas cosas clamaba: El que tiene oídos para oír, oiga.", "words": [[0, 60014], [2, 60138], [7, 60298], [13, 60618], [18, 61058], [21, 61138], [27, 61318], [35, 62298], [37, 62478], [44, 62718], [48, 62998], [56, 63978], [62, 64338], [68, 64691], [70, 65045], [77, 65398], [81, 65758], [86, 66484], [95, 66868], [101, 67148], [107, 67786], [116, 68611], [119, 68916], [123, 69056], [129, 69396], [135, 69976], [140, 70196], [145, 70876]]}, {"verse": 9, "start": 71726, "end": 76446, "text": "Y sus discípulos le preguntaron, diciendo, qué era esta parábola.", "words": [[0, 71726], [2, 71813], [6, 71993], [17, 72633], [20, 72853], [33, 73513], [43, 73913], [47, 74933], [51, 75253], [56, 75573]]}, {"verse": 10, "start": 76796, "end": 87388, "text": "Y él dijo: A vosotros es dado conocer los misterios del reino de Dios; pero a los otros por parábolas, para que viendo no vean, y oyendo no entiendan.", "words": [[0, 76796], [2, 76960], [5, 77269], [11, 77744], [13, 77868], [22, 78388], [25, 78608], [30, 78908], [38, 79548], [42, 79788], [52, 80428], [56, 80728], [62, 81168], [65, 81328], [71, 82125], [76, 82268], [78, 82408], [82, 82548], [88, 82788], [92, 83108], [103, 83748], [108, 84268], [112, 84428], [119, 84728], [122, 84948], [128, 85448], [130, 85748], [137, 86148], [140, 86568]]}, {"verse": 11, "start": 87738, "end": 91671, "text": "Es pues esta la parábola: La semilla es la palabra de Dios.", "words": [[0, 87797], [3, 87887], [8, 88027], [13, 88647], [16, 88727], [26, 89775], [29, 89894], [37, 90354], [40, 90494], [43, 90574], [51, 90874], [54, 91114]]}, {"verse": 12, "start": 92021, "end": 101642, "text": "Y los de junto al camino, estos son los que oyen; y luego viene el diablo, y quita la palabra de su corazón, para que no crean y se salven.", "words": [[0, 92021], [2, 92129], [6, 92249], [9, 92409], [15, 92809], [18, 92909], [26, 93769], [32, 93949], [36, 94269], [40, 94429], [44, 94629], [50, 95416], [52, 95539], [58, 95739], [64, 96099], [67, 96339], [75, 96859], [77, 97579], [83, 97899], [86, 98039], [94, 98419], [97, 98639], [100, 98779], [109, 99339], [114, 99684], [118, 99824], [121, 100004], [127, 100564], [129, 100744], [132, 100864]]}, {"verse": 13, "start": 101992, "end": 114749, "text": "Y los de sobre la piedra, son los que habiendo oído, reciben la palabra con gozo; pero estos no tienen raíces; que creen por algún tiempo, y en el tiempo de la tentación se apartan.", "words": [[0, 101992], [2, 102117], [6, 102257], [9, 102417], [15, 102637], [18, 102857], [26, 103977], [30, 104377], [34, 104597], [38, 104877], [47, 105257], [53, 105997], [61, 106417], [64, 106597], [72, 107073], [76, 107549], [82, 108188], [87, 108334], [93, 108534], [96, 108774], [103, 109094], [111, 110304], [115, 110389], [121, 110869], [125, 111069], [131, 111349], [139, 111929], [141, 112154], [144, 112294], [147, 112414], [154, 112834], [157, 112974], [160, 113094], [170, 113674], [173, 113894]]}, {"verse": 14, "start": 115099, "end": 127638, "text": "Y la que cayó entre las espinas, estos son los que oyeron; pero yéndose, son ahogados de las preocupaciones y de las riquezas y de los placeres de la vida, y no llevan fruto.", "words": [[0, 115099], [2, 115403], [5, 115523], [9, 115683], [14, 116143], [20, 116403], [24, 116663], [33, 117923], [39, 118263], [43, 118743], [47, 119263], [51, 119443], [59, 120397], [64, 120562], [73, 121062], [77, 121402], [86, 122122], [89, 122282], [93, 122442], [108, 123402], [110, 123642], [113, 123762], [117, 123922], [126, 124562], [128, 124757], [131, 124857], [135, 125017], [144, 125517], [147, 125657], [150, 125757], [156, 125997], [158, 126497], [161, 126677], [168, 127057]]}, {"verse": 15, "start": 127988, "end": 137038, "text": "Pero la que en buena tierra, estos son los que con corazón bueno y recto retienen la palabra oída, y llevan fruto en paciencia.", "words": [[0, 127988], [5, 128175], [8, 128375], [12, 128535], [15, 128735], [21, 128915], [29, 129755], [35, 130435], [39, 131115], [43, 131355], [47, 131615], [51, 131955], [59, 132375], [65, 132795], [67, 133362], [73, 133928], [82, 134495], [85, 134615], [93, 134915], [99, 135315], [101, 135455], [108, 135755], [114, 136115], [117, 136235]]}, {"verse": 16, "start": 137388, "end": 147745, "text": "Ninguno que enciende la lámpara la cubre con vasija, o la pone debajo de la cama; pero la pone en un candelero, para que los que entran vean la luz.", "words": [[0, 137388], [8, 138011], [12, 138231], [21, 138851], [24, 139051], [32, 139531], [35, 139691], [41, 140131], [45, 140291], [53, 140911], [55, 141116], [58, 141216], [63, 141476], [70, 141896], [73, 142036], [76, 142156], [82, 142926], [87, 143089], [90, 143269], [95, 143589], [98, 143829], [101, 143949], [112, 144549], [117, 145049], [121, 145309], [125, 145729], [129, 145969], [136, 146469], [141, 147029], [144, 147249]]}, {"verse": 17, "start": 148095, "end": 156984, "text": "Porque no hay cosa oculta, que no haya de ser manifestada; ni cosa escondida, que no haya de ser entendida, y de venir a luz.", "words": [[0, 148095], [7, 148317], [10, 148557], [14, 148777], [19, 149057], [27, 150237], [31, 150477], [34, 150697], [39, 151057], [42, 151257], [46, 151497], [59, 152968], [62, 153058], [67, 153338], [78, 154118], [82, 154278], [85, 154458], [90, 154598], [93, 154798], [97, 154958], [108, 155718], [110, 155858], [113, 155998], [119, 156278], [121, 156418]]}, {"verse": 18, "start": 157334, "end": 166896, "text": "Mirad pues cómo oís; porque a todo el que tiene, se le dará; y a cualquiera que no tiene, aun lo que parece tener le será quitado.", "words": [[0, 157541], [6, 157791], [11, 158171], [16, 158779], [21, 159548], [28, 159830], [30, 160130], [35, 160490], [38, 160710], [42, 160810], [49, 161190], [52, 161410], [55, 161590], [61, 162337], [63, 162447], [65, 162507], [76, 163027], [80, 163187], [83, 163367], [90, 163847], [94, 164447], [97, 164647], [101, 164807], [108, 165147], [114, 165587], [117, 165927], [122, 166207]]}, {"verse": 19, "start": 167246, "end": 172812, "text": "Y vinieron a él su madre y hermanos; y no podían llegar a él por causa de la multitud.", "words": [[0, 167246], [2, 167373], [11, 167833], [13, 168053], [16, 168133], [19, 168333], [25, 168693], [27, 168993], [37, 169949], [39, 170078], [42, 170178], [49, 170578], [56, 170798], [58, 170998], [61, 171138], [65, 171338], [71, 171738], [74, 171978], [77, 172058]]}, {"verse": 20, "start": 173162, "end": 178998, "text": "Y le fue dado aviso, diciendo: Tu madre y tus hermanos están fuera, que quieren verte.", "words": [[0, 173162], [2, 173261], [5, 173361], [9, 173521], [14, 174111], [21, 174701], [31, 175859], [34, 175936], [40, 176296], [42, 176456], [46, 176596], [55, 177136], [61, 177376], [68, 178056], [72, 178156], [80, 178436]]}, {"verse": 21, "start": 179278, "end": 187135, "text": "Él entonces respondiendo, les dijo: Mi madre y mis hermanos son los que oyen la palabra de Dios, y la hacen.", "words": [[0, 179278], [3, 179765], [12, 180405], [26, 181045], [30, 181685], [36, 182270], [39, 182395], [45, 182715], [47, 182995], [51, 183155], [60, 183815], [64, 184135], [68, 184375], [72, 184595], [77, 184915], [80, 185055], [88, 185415], [91, 185635], [97, 185935], [99, 186555], [102, 186735]]}, {"verse": 22, "start": 187485, "end": 195626, "text": "Y aconteció un día que él entró en un barco con sus discípulos, y les dijo: Pasemos al otro lado del lago. Y partieron.", "words": [[0, 187485], [2, 187616], [12, 188276], [15, 188456], [19, 188696], [23, 188916], [26, 189156], [32, 189576], [35, 189676], [38, 189816], [44, 190236], [48, 190436], [52, 190636], [64, 191356], [66, 191576], [70, 191796], [76, 192533], [84, 192917], [87, 193137], [92, 193317], [97, 193577], [101, 193857], [107, 194660], [109, 195164]]}, {"verse": 23, "start": 195976, "end": 206369, "text": "Pero mientras ellos navegaban, él se durmió. Y sobrevino una tempestad de viento en el lago; y el barco se llenaba de agua, y peligraban.", "words": [[0, 195976], [5, 196100], [14, 196400], [20, 196760], [31, 197860], [34, 198160], [37, 198320], [45, 199220], [47, 199624], [57, 200064], [61, 200204], [71, 201084], [74, 201264], [81, 201724], [84, 201884], [87, 202044], [93, 202863], [95, 202992], [98, 203072], [104, 203552], [107, 203772], [115, 204212], [118, 204392], [124, 204792], [126, 205292]]}, {"verse": 24, "start": 206719, "end": 220077, "text": "Y llegándose a él, le despertaron, diciendo: ¡Maestro, Maestro, que perecemos! Y despertado él, reprendió al viento y a la tempestad del agua; y cesaron, y fue hecha bonanza.", "words": [[0, 206719], [2, 206988], [13, 207588], [15, 207768], [19, 208348], [22, 208448], [35, 209208], [45, 210350], [55, 210892], [64, 211412], [68, 211592], [79, 212700], [81, 212864], [92, 213944], [96, 214164], [106, 215284], [109, 215444], [116, 215844], [118, 216024], [120, 216104], [123, 216184], [133, 216844], [137, 217044], [143, 217777], [145, 217923], [154, 218523], [156, 218818], [160, 219038], [166, 219318]]}, {"verse": 25, "start": 220427, "end": 231626, "text": "Y les dijo: ¿Dónde está vuestra fe? Y atemorizados, se maravillaban, diciendo los unos a los otros: ¿Quién es este, que aun a los vientos y al agua manda, y le obedecen?", "words": [[0, 220427], [2, 220567], [6, 220707], [12, 221456], [19, 221799], [24, 222019], [32, 222399], [36, 222989], [38, 223132], [52, 223892], [55, 224152], [69, 224820], [78, 225489], [82, 226157], [87, 226337], [89, 226597], [93, 226737], [100, 227669], [107, 227909], [110, 228049], [116, 228389], [120, 228609], [124, 228829], [126, 228829], [130, 229109], [138, 229549], [140, 229729], [143, 229829], [148, 230029], [155, 230569], [157, 230849], [160, 230949]]}, {"verse": 26, "start": 231906, "end": 236583, "text": "Y navegaron a la tierra de los gadarenos, que está delante de Galilea.", "words": [[0, 231906], [2, 232027], [12, 232627], [14, 232727], [17, 232807], [24, 233167], [27, 233427], [31, 234037], [42, 234647], [46, 234947], [51, 235107], [59, 235567], [62, 235747]]}, {"verse": 27, "start": 236933, "end": 249181, "text": "Y saliendo él a tierra, le vino al encuentro de la ciudad un hombre que tenía demonios ya de mucho tiempo; y no vestía vestido, ni estaba en casa, sino por los sepulcros.", "words": [[0, 236933], [2, 237173], [11, 237753], [14, 237993], [16, 238113], [24, 238933], [27, 239173], [32, 239433], [35, 239613], [45, 240333], [48, 240433], [51, 240553], [58, 240893], [61, 241293], [68, 241613], [72, 241893], [78, 242173], [87, 242833], [90, 243093], [93, 243233], [99, 243433], [107, 244374], [109, 244516], [112, 244676], [119, 245136], [128, 245776], [131, 246436], [138, 246776], [141, 246976], [147, 247616], [152, 247856], [156, 248136], [160, 248296]]}, {"verse": 28, "start": 249531, "end": 261644, "text": "El cual, cuando vio a Jesús, exclamó y se postró delante de él, y dijo a gran voz: ¿Qué tengo yo contigo, Jesús, Hijo del Dios Altísimo? Te ruego que no me atormentes.", "words": [[0, 249531], [3, 249674], [9, 250034], [16, 250234], [20, 250654], [22, 250774], [29, 251654], [37, 252414], [39, 252554], [42, 252714], [49, 253174], [57, 253614], [60, 253834], [64, 254134], [66, 254359], [71, 254759], [73, 254999], [78, 255179], [83, 256026], [88, 256127], [94, 256447], [97, 256627], [106, 257187], [113, 258067], [118, 258287], [122, 258467], [127, 258667], [137, 259796], [140, 259898], [146, 260238], [150, 260418], [153, 260578], [156, 260718]]}, {"verse": 29, "start": 261924, "end": 278940, "text": "(Porque mandaba al espíritu inmundo que saliese del hombre: porque ya de mucho tiempo le arrebataba; y le guardaban preso con cadenas y grilletes; pero rompiendo las ataduras, era arrastrado por el demonio a los lugares desiertos.)", "words": [[0, 261924], [8, 262149], [16, 262849], [19, 263129], [28, 263829], [36, 264309], [40, 264509], [48, 264969], [52, 265229], [60, 265992], [67, 266355], [70, 266615], [73, 266755], [79, 266975], [86, 267375], [89, 267615], [101, 268845], [103, 268951], [106, 269071], [116, 269611], [122, 270211], [126, 270431], [134, 271051], [136, 271251], [147, 272386], [152, 272568], [162, 273328], [166, 273508], [176, 274228], [180, 274848], [191, 275908], [195, 276308], [198, 276508], [206, 277148], [208, 277308], [212, 277468], [220, 277928]]}, {"verse": 30, "start": 279290, "end": 287516, "text": "Y le preguntó Jesús, diciendo: ¿Qué nombre tienes? Y él dijo: Legión. Porque muchos demonios habían entrado en él.", "words": [[0, 279290], [2, 279405], [5, 279505], [14, 280045], [21, 280365], [31, 281585], [36, 281885], [43, 282145], [51, 283134], [53, 283297], [56, 283606], [62, 284062], [70, 284900], [77, 285105], [84, 285425], [93, 286065], [100, 286385], [108, 286965], [111, 287125]]}, {"verse": 31, "start": 287866, "end": 290896, "text": "Y le rogaban que no les mandase ir al abismo.", "words": [[0, 287866], [2, 287990], [5, 288110], [13, 288710], [17, 288930], [20, 289130], [24, 289310], [32, 289870], [35, 290110], [38, 290270]]}, {"verse": 32, "start": 291246, "end": 300073, "text": "Y había allí una manada de muchos cerdos que pacían en el monte; y le rogaron que los dejase entrar en ellos; y los dejó.", "words": [[0, 291246], [2, 291370], [8, 291630], [13, 291910], [17, 292130], [24, 292570], [27, 292770], [34, 293010], [41, 293750], [45, 294240], [52, 294730], [55, 295190], [58, 295330], [65, 296166], [67, 296290], [70, 296450], [78, 297050], [82, 297210], [86, 297370], [93, 297810], [100, 298210], [103, 298430], [110, 299264], [112, 299389], [116, 299549]]}, {"verse": 33, "start": 300423, "end": 309959, "text": "Y salidos los demonios del hombre, entraron en los cerdos; y la manada se arrojó de un despeñadero en el lago, y se ahogó.", "words": [[0, 300423], [2, 300693], [10, 301233], [14, 301433], [23, 302033], [27, 302153], [35, 302513], [44, 303633], [47, 303773], [51, 303973], [59, 305130], [61, 305253], [64, 305353], [71, 305753], [74, 305973], [81, 306573], [84, 306773], [87, 306933], [99, 307813], [102, 307933], [105, 308093], [111, 308493], [113, 309013], [116, 309193]]}, {"verse": 34, "start": 310309, "end": 318561, "text": "Y los pastores, cuando vieron lo que había acontecido, huyeron, y yendo dieron aviso en la ciudad y por los campos.", "words": [[0, 310309], [2, 310433], [6, 310553], [16, 311373], [23, 311673], [30, 312093], [33, 312253], [37, 312393], [43, 312673], [55, 313853], [64, 314913], [66, 315013], [72, 315576], [79, 315918], [85, 316318], [88, 316458], [91, 316578], [98, 316938], [100, 317378], [104, 317578], [108, 317718]]}, {"verse": 35, "start": 318911, "end": 332607, "text": "Y salieron a ver lo que había acontecido; y vinieron a Jesús, y hallaron sentado al hombre de quien habían salido los demonios, vestido, y en su juicio, a los pies de Jesús; y tuvieron miedo.", "words": [[0, 318911], [2, 319188], [11, 319688], [13, 319848], [17, 320028], [20, 320408], [24, 320528], [30, 320788], [42, 321954], [44, 322098], [53, 322538], [55, 322678], [62, 323038], [64, 323531], [73, 324023], [81, 324643], [84, 324803], [91, 325063], [94, 325323], [100, 325583], [107, 325923], [114, 326523], [118, 326703], [128, 327603], [137, 328263], [139, 328703], [142, 328823], [145, 328983], [153, 329543], [155, 330023], [159, 330143], [164, 330383], [167, 330543], [174, 331440], [176, 331637], [185, 331977]]}, {"verse": 36, "start": 332957, "end": 338707, "text": "Y les contaron los que lo habían visto, cómo había sido salvado aquel endemoniado.", "words": [[0, 332957], [2, 333102], [6, 333242], [15, 333962], [19, 334162], [23, 334342], [26, 334462], [33, 334702], [40, 335162], [45, 335862], [51, 336162], [56, 336522], [64, 337162], [70, 337662]]}, {"verse": 37, "start": 339057, "end": 350784, "text": "Entonces toda la multitud de la tierra de los gadarenos alrededor, le rogaron que se fuese de ellos; porque tenían gran temor. Y él, subiendo en el barco, se volvió.", "words": [[0, 339057], [9, 339855], [14, 340295], [17, 340555], [26, 341235], [29, 341455], [32, 341575], [39, 341915], [42, 342215], [46, 342395], [56, 343075], [67, 343685], [70, 344295], [78, 344835], [82, 344995], [85, 345135], [91, 345495], [94, 345655], [101, 346415], [108, 346748], [115, 347118], [120, 347398], [127, 348261], [129, 348425], [133, 348585], [142, 349165], [145, 349305], [148, 349425], [155, 349865], [158, 350145]]}, {"verse": 38, "start": 351134, "end": 359125, "text": "Y aquel hombre, de quien habían salido los demonios, le rogó para estar con él; pero Jesús le despidió, diciendo:", "words": [[0, 351134], [2, 351324], [8, 351584], [16, 351984], [19, 352224], [25, 352404], [32, 352744], [39, 353324], [43, 353484], [53, 354124], [56, 354524], [61, 354924], [66, 355144], [72, 355404], [76, 355704], [80, 356285], [85, 356548], [91, 356888], [94, 357348], [104, 358068]]}, {"verse": 39, "start": 359475, "end": 370411, "text": "Vuélvete a tu casa, y cuenta cuán grandes cosas ha hecho Dios contigo. Y él se fue, publicando por toda la ciudad cuán grandes cosas había hecho Jesús con él.", "words": [[0, 359475], [9, 359941], [11, 360041], [14, 360141], [20, 360481], [22, 360661], [29, 361021], [34, 361401], [42, 361821], [48, 362281], [51, 362701], [57, 362961], [62, 363181], [71, 364338], [73, 364476], [76, 364636], [79, 364736], [84, 365636], [95, 366396], [99, 366616], [104, 366856], [107, 367056], [114, 367396], [119, 367876], [127, 368336], [133, 368716], [139, 369096], [145, 369416], [151, 369736], [155, 370076]]}, {"verse": 40, "start": 370761, "end": 377177, "text": "Y aconteció que volviendo Jesús, le recibió la gente; porque todos le esperaban.", "words": [[0, 370761], [2, 370885], [12, 371545], [16, 371725], [26, 372265], [33, 373145], [36, 373385], [44, 374025], [47, 374145], [54, 375006], [61, 375192], [67, 375612], [70, 376132]]}, {"verse": 41, "start": 377527, "end": 388452, "text": "Y he aquí un varón, llamado Jairo, y que era dirigente de la sinagoga, vino, y cayendo a los pies de Jesús, le rogaba que entrase en su casa;", "words": [[0, 377527], [2, 377714], [5, 377894], [10, 378194], [13, 378394], [20, 379314], [28, 379754], [35, 380854], [37, 380894], [41, 381034], [45, 381194], [55, 381814], [58, 381974], [61, 382094], [71, 383154], [77, 383914], [79, 384074], [87, 384594], [89, 384694], [93, 384794], [98, 385054], [101, 385194], [108, 385614], [111, 386254], [118, 386774], [122, 386954], [130, 387514], [133, 387714], [136, 387874]]}, {"verse": 42, "start": 388802, "end": 396945, "text": "Porque tenía una hija única, como de doce años, y ella se estaba muriendo. Y yendo, la multitud lo apretaba.", "words": [[0, 388802], [7, 389007], [13, 389407], [17, 389787], [22, 390247], [29, 391147], [34, 391367], [37, 391587], [42, 391807], [48, 392767], [50, 392947], [55, 393167], [58, 393307], [65, 393587], [75, 394574], [77, 394739], [84, 395019], [87, 395199], [96, 395859], [99, 396139]]}, {"verse": 43, "start": 397295, "end": 407140, "text": "Y una mujer, que tenía flujo de sangre hacía ya doce años, la cual había gastado en médicos todos sus bienes, y por ninguno había podido ser curada,", "words": [[0, 397295], [2, 397437], [6, 397577], [13, 397937], [17, 398217], [23, 398497], [29, 398977], [32, 399057], [39, 399367], [45, 399677], [48, 399987], [53, 400297], [59, 401177], [62, 401257], [67, 401537], [73, 402057], [81, 402637], [84, 402757], [92, 403337], [98, 403677], [102, 404037], [110, 404637], [112, 404877], [116, 405077], [124, 405637], [130, 405797], [137, 406257], [141, 406437]]}, {"verse": 44, "start": 407490, "end": 414441, "text": "Llegándose por las espaldas, tocó el borde de su vestido; y luego se detuvo el flujo de su sangre.", "words": [[0, 407490], [11, 408162], [15, 408422], [19, 408622], [29, 409382], [34, 410002], [37, 410222], [43, 410602], [46, 410762], [49, 410942], [58, 411894], [60, 412002], [66, 412202], [69, 412462], [76, 412922], [79, 413122], [85, 413562], [88, 413662], [91, 413802]]}, {"verse": 45, "start": 414791, "end": 427411, "text": "Entonces Jesús dijo: ¿Quién es el que me ha tocado? Y negando todos, dijo Pedro y los que estaban con él: Maestro, la multitud te aprieta y oprime, y dices: ¿Quién es el que me ha tocado?", "words": [[0, 414791], [9, 415252], [15, 415732], [21, 416677], [28, 416922], [31, 417122], [34, 417242], [38, 417402], [41, 417582], [44, 417682], [52, 418809], [54, 419029], [62, 419249], [69, 420089], [74, 420509], [80, 421194], [82, 421274], [86, 421394], [90, 421534], [98, 421814], [102, 422114], [106, 422781], [115, 423282], [118, 423422], [127, 423922], [130, 424062], [138, 424542], [140, 424662], [148, 425102], [150, 425322], [157, 426163], [164, 426364], [167, 426464], [170, 426584], [174, 426684], [177, 426804], [180, 426904]]}, {"verse": 46, "start": 427691, "end": 433689, "text": "Y Jesús dijo: Me ha tocado alguien; porque yo he conocido que ha salido poder de mí.", "words": [[0, 427691], [2, 427818], [8, 428158], [14, 429106], [17, 429246], [20, 429346], [27, 429846], [36, 430871], [43, 431073], [46, 431313], [49, 431433], [58, 432073], [62, 432253], [65, 432373], [72, 432793], [78, 433073], [81, 433373]]}, {"verse": 47, "start": 434039, "end": 449034, "text": "Entonces, como la mujer vio que no se había ocultado, vino temblando, y postrándose delante de él le declaró delante de todo el pueblo la causa por qué le había tocado, y cómo luego había sido sana.", "words": [[0, 434039], [10, 435267], [15, 435507], [18, 435667], [24, 435927], [28, 436327], [32, 436527], [35, 436707], [38, 436907], [44, 437187], [54, 438467], [59, 438607], [70, 439987], [72, 440047], [84, 440847], [92, 441367], [95, 441567], [98, 441912], [101, 442012], [109, 442532], [117, 443092], [120, 443232], [125, 443472], [128, 443672], [135, 444052], [138, 444768], [144, 445094], [148, 445314], [152, 445534], [155, 445694], [161, 445934], [169, 446494], [171, 446859], [176, 447199], [182, 447619], [188, 447959], [193, 448339]]}, {"verse": 48, "start": 449384, "end": 453948, "text": "Y él le dijo: Hija, tu fe te ha salvado: ve en paz.", "words": [[0, 449384], [2, 449570], [5, 449730], [8, 449910], [14, 450701], [20, 451501], [23, 451621], [26, 451861], [29, 452041], [32, 452161], [41, 453221], [44, 453307], [47, 453394]]}, {"verse": 49, "start": 454298, "end": 463726, "text": "Estando aún él hablando, vino uno de la casa del dirigente de la sinagoga a decirle: Tu hija es muerta, no molestes al Maestro.", "words": [[0, 454298], [8, 454789], [12, 455029], [15, 455369], [25, 456449], [30, 456929], [34, 457329], [37, 457489], [40, 457629], [45, 457889], [49, 458209], [59, 458909], [62, 459069], [65, 459189], [74, 459849], [76, 460089], [85, 461086], [88, 461190], [93, 461450], [96, 461510], [104, 462290], [107, 462370], [116, 462890], [119, 463030]]}, {"verse": 50, "start": 464006, "end": 470075, "text": "Y oyéndolo Jesús, le respondió: No temas: cree solamente, y será salva.", "words": [[0, 464006], [2, 464375], [11, 464775], [18, 465195], [21, 465535], [32, 466890], [35, 467192], [42, 467659], [47, 468043], [58, 468383], [60, 469163], [65, 469423]]}, {"verse": 51, "start": 470425, "end": 480229, "text": "Y entrado en casa, no dejó entrar a nadie consigo, sino a Pedro, y a Jacobo, y a Juan, y al padre y a la madre de la muchacha.", "words": [[0, 470425], [2, 470587], [10, 471167], [13, 471307], [19, 472187], [22, 472547], [27, 472967], [34, 473367], [36, 473607], [42, 474027], [51, 474627], [56, 475147], [58, 475387], [65, 475727], [67, 476047], [69, 476127], [77, 476767], [79, 476947], [81, 477027], [87, 477307], [89, 477647], [92, 477767], [98, 478207], [100, 478747], [102, 478827], [105, 478927], [111, 479247], [114, 479407], [117, 479527]]}, {"verse": 52, "start": 480579, "end": 487598, "text": "Y lloraban todos, y se lamentaban por ella. Y él dijo: No lloréis; no es muerta, sino que duerme.", "words": [[0, 480579], [2, 480705], [11, 481105], [18, 481505], [20, 481785], [23, 481925], [34, 482565], [38, 482765], [44, 483439], [46, 483602], [49, 483911], [55, 484473], [58, 484593], [67, 485526], [70, 485633], [73, 485733], [81, 486533], [86, 486753], [90, 486953]]}, {"verse": 53, "start": 487948, "end": 491323, "text": "Y hacían burla de él, sabiendo que estaba muerta.", "words": [[0, 487948], [2, 488065], [9, 488485], [15, 489045], [18, 489225], [22, 489745], [31, 490165], [35, 490325], [42, 490545]]}, {"verse": 54, "start": 491673, "end": 496607, "text": "Pero él, tomándola de la mano, clamó, diciendo: Muchacha, levántate.", "words": [[0, 491673], [5, 491817], [9, 492597], [19, 493177], [22, 493297], [25, 493437], [31, 493937], [38, 494357], [48, 495762], [58, 495997]]}, {"verse": 55, "start": 496957, "end": 502846, "text": "Entonces su espíritu volvió, y se levantó luego: y él mandó que le diesen de comer.", "words": [[0, 496957], [9, 497743], [12, 497943], [21, 498503], [29, 498963], [31, 499083], [34, 499203], [42, 499723], [49, 500454], [51, 500636], [54, 500796], [60, 501256], [64, 501416], [67, 501736], [74, 502056], [77, 502276]]}, {"verse": 56, "start": 503196, "end": 510574, "text": "Y sus padres estaban atónitos; a los cuales él mandó, que a nadie dijesen lo que había sido hecho.", "words": [[0, 503196], [2, 503275], [6, 503435], [13, 503795], [21, 504455], [31, 505656], [33, 505783], [37, 505903], [44, 506143], [47, 506543], [54, 507023], [58, 507563], [60, 507703], [66, 508203], [74, 508703], [77, 509243], [81, 509403], [87, 509623], [92, 510003]]}]}