{"book": "ACT", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 401267, "verses": [{"verse": 1, "start": 300, "end": 7488, "text": "Y había un varón en Cesarea llamado Cornelio, centurión de la unidad militar llamada la Italiana,", "words": [[0, 300], [2, 421], [8, 601], [11, 821], [17, 1261], [20, 1421], [28, 1981], [36, 2381], [46, 3801], [56, 4621], [59, 4801], [62, 4921], [69, 5361], [77, 5921], [85, 6501], [88, 6661]]}, {"verse": 2, "start": 7938, "end": 16222, "text": "Piadoso y temeroso de Dios con toda su casa, y que hacía muchas limosnas al pueblo, y oraba a Dios siempre.", "words": [[0, 7938], [8, 8540], [10, 8640], [19, 9180], [22, 9400], [27, 9680], [31, 10000], [36, 10300], [39, 10560], [45, 10960], [47, 11540], [51, 11700], [57, 12160], [64, 12620], [73, 13080], [76, 13320], [84, 13800], [86, 14300], [92, 14680], [94, 14920], [99, 15160]]}, {"verse": 3, "start": 16672, "end": 25558, "text": "Este vio en visión manifiestamente, como a la novena hora del día, que un ángel de Dios entraba a él, y le decía: Cornelio.", "words": [[0, 16672], [5, 16982], [9, 17342], [12, 17562], [19, 18002], [36, 19022], [41, 19322], [43, 19502], [46, 19582], [53, 20042], [58, 20302], [62, 20562], [67, 20942], [71, 21602], [74, 21782], [80, 22142], [83, 22282], [88, 22502], [96, 23102], [98, 23242], [102, 23462], [104, 23922], [107, 24042], [114, 24933]]}, {"verse": 4, "start": 25908, "end": 36377, "text": "Y él, puestos en él los ojos, espantado, dijo: ¿Qué es, Señor? Y le dijo: Tus oraciones y tus limosnas han subido en memoria a la presencia de Dios.", "words": [[0, 25908], [2, 26053], [6, 26213], [14, 26693], [17, 26873], [20, 27013], [24, 27193], [30, 27593], [41, 28913], [47, 29863], [52, 30024], [56, 30204], [63, 31082], [65, 31203], [68, 31303], [74, 32068], [78, 32172], [88, 32672], [90, 32932], [94, 33072], [103, 33652], [107, 33832], [114, 34272], [117, 34352], [125, 34812], [127, 35052], [130, 35132], [140, 35692], [143, 35852]]}, {"verse": 5, "start": 36827, "end": 41813, "text": "Envía pues ahora hombres a Jope, y haz venir a un Simón, que tiene por sobrenombre Pedro.", "words": [[0, 36827], [6, 37086], [11, 37306], [17, 37646], [25, 37946], [27, 38186], [33, 38526], [35, 38806], [39, 38966], [45, 39186], [47, 39366], [50, 39446], [57, 39906], [61, 40226], [67, 40466], [71, 40686], [83, 41286]]}, {"verse": 6, "start": 42263, "end": 48728, "text": "Este se hospeda en casa de un Simón, curtidor, que tiene su casa junto al mar: él te dirá lo que te conviene hacer.", "words": [[0, 42263], [5, 42487], [8, 42667], [16, 43047], [19, 43147], [24, 43367], [27, 43587], [30, 43687], [37, 44267], [47, 45127], [51, 45207], [57, 45427], [60, 45607], [65, 45847], [71, 46127], [74, 46367], [79, 46995], [82, 47144], [85, 47304], [90, 47564], [93, 47644], [97, 47764], [100, 47884], [109, 48344]]}, {"verse": 7, "start": 49078, "end": 57392, "text": "E ido el ángel que hablaba con Cornelio, llamó dos de sus criados, y un devoto soldado de los que le asistían;", "words": [[0, 49192], [2, 49338], [6, 49485], [9, 49685], [15, 50105], [19, 50285], [27, 50765], [31, 50965], [41, 52165], [47, 52645], [51, 53185], [54, 53485], [58, 53665], [67, 54325], [69, 54565], [72, 54725], [79, 55125], [87, 55845], [90, 56025], [94, 56185], [98, 56365], [101, 56505]]}, {"verse": 8, "start": 57842, "end": 62488, "text": "A los cuales, después de habérselo contado todo, los envió a Jope.", "words": [[0, 57842], [2, 57928], [6, 58048], [14, 58748], [22, 59168], [25, 59528], [35, 59888], [43, 60388], [49, 61288], [53, 61448], [59, 61908], [61, 62226]]}, {"verse": 9, "start": 62938, "end": 73681, "text": "Y al día siguiente, yendo ellos su camino, y llegando cerca de la ciudad, Pedro subió a la azotea a orar, cerca de la hora de sexta;", "words": [[0, 62938], [2, 63063], [5, 63203], [9, 63363], [20, 64723], [26, 65023], [32, 65283], [35, 65523], [43, 66003], [45, 66563], [54, 67123], [60, 67383], [63, 67643], [66, 67763], [74, 68883], [80, 69343], [86, 70143], [88, 70343], [91, 70463], [98, 71163], [100, 71323], [106, 71783], [112, 72323], [115, 72603], [118, 72683], [123, 72883], [126, 73043]]}, {"verse": 10, "start": 74131, "end": 82278, "text": "Y aconteció que le vino una grande hambre, y quiso comer; pero mientras disponían, le sobrevino un éxtasis;", "words": [[0, 74131], [2, 74238], [12, 74918], [16, 75078], [19, 75218], [24, 75458], [28, 75658], [35, 76078], [43, 76638], [45, 77178], [51, 77518], [58, 78422], [63, 78722], [72, 79042], [83, 80282], [86, 80542], [96, 81222], [99, 81422]]}, {"verse": 11, "start": 82728, "end": 93453, "text": "Y vio el cielo abierto, y que descendía un objeto semejante a una gran tela, que, sujeto por sus cuatro extremos, era bajado a la tierra;", "words": [[0, 82728], [2, 82852], [6, 83092], [9, 83232], [15, 83512], [24, 84672], [26, 85032], [30, 85172], [40, 85872], [43, 86132], [50, 86532], [60, 87392], [62, 87532], [66, 87692], [71, 87932], [77, 89132], [82, 89252], [89, 89932], [93, 90092], [97, 90312], [104, 90732], [114, 91632], [118, 91892], [125, 92592], [127, 92712], [130, 92792]]}, {"verse": 12, "start": 93903, "end": 101563, "text": "En el cual había de todos los animales cuadrúpedos de la tierra, y reptiles, y aves del cielo.", "words": [[0, 93903], [3, 94071], [6, 94191], [11, 94511], [17, 95211], [20, 95431], [26, 95751], [30, 96251], [39, 96671], [51, 97571], [54, 97651], [57, 97771], [65, 98211], [67, 98871], [77, 99771], [79, 100231], [84, 100631], [88, 100911]]}, {"verse": 13, "start": 102013, "end": 106172, "text": "Y le vino una voz: Levántate, Pedro, mata y come.", "words": [[0, 102013], [2, 102139], [5, 102239], [10, 102479], [14, 102719], [19, 103542], [30, 104340], [37, 104860], [42, 105100], [44, 105420]]}, {"verse": 14, "start": 106522, "end": 113045, "text": "Entonces Pedro dijo: Señor, no; porque ninguna cosa común e inmunda he comido jamás.", "words": [[0, 106522], [9, 107381], [15, 107761], [21, 108624], [28, 108940], [32, 109706], [39, 109888], [47, 110188], [52, 110668], [58, 111048], [60, 111248], [68, 111708], [71, 111988], [78, 112328]]}, {"verse": 15, "start": 113395, "end": 119915, "text": "Y volvió la voz hacia él la segunda vez: Lo que Dios limpió, no lo llames tú común.", "words": [[0, 113395], [2, 113504], [9, 113904], [12, 114024], [16, 114304], [22, 114704], [25, 115124], [28, 115424], [36, 115784], [41, 116687], [44, 116802], [48, 116942], [53, 117222], [61, 118202], [64, 118382], [67, 118522], [74, 118962], [77, 119062]]}, {"verse": 16, "start": 120265, "end": 126566, "text": "Y esto fue hecho por tres veces; y el objeto volvió a ser recogido en el cielo.", "words": [[0, 120265], [2, 120453], [7, 120753], [11, 121053], [17, 121353], [21, 121613], [26, 121993], [33, 123193], [35, 123300], [38, 123400], [45, 123740], [52, 124380], [54, 124580], [58, 124780], [67, 125660], [70, 125820], [73, 125940]]}, {"verse": 17, "start": 127016, "end": 140966, "text": "Y estando Pedro dudando dentro de sí qué sería la visión que había visto, he aquí, los hombres que habían sido enviados por Cornelio, que, preguntando por la casa de Simón, llegaron a la puerta.", "words": [[0, 127016], [2, 127138], [10, 127558], [16, 127958], [24, 128538], [31, 128898], [34, 129238], [37, 129498], [41, 130018], [47, 130358], [50, 130558], [57, 130978], [61, 131118], [67, 131358], [74, 132198], [77, 132338], [83, 133178], [87, 133298], [95, 133718], [99, 133918], [106, 134118], [111, 134478], [120, 135038], [124, 135298], [134, 136278], [139, 137050], [151, 137813], [155, 138114], [158, 138273], [163, 138573], [166, 138773], [173, 139753], [182, 140114], [184, 140233], [187, 140334]]}, {"verse": 18, "start": 141416, "end": 147643, "text": "Y llamando, preguntaron si un Simón que tenía por sobrenombre Pedro, se hospedaba allí.", "words": [[0, 141416], [2, 141541], [12, 142001], [24, 142741], [27, 142981], [30, 143141], [36, 143621], [40, 143761], [46, 144101], [50, 144561], [62, 145581], [69, 146081], [72, 146641], [82, 147221]]}, {"verse": 19, "start": 148093, "end": 155189, "text": "Y estando Pedro pensando en la visión, le dijo el Espíritu: He aquí, tres hombres te buscan.", "words": [[0, 148093], [2, 148237], [10, 148697], [16, 149177], [25, 149817], [28, 150117], [31, 150257], [39, 151217], [42, 151437], [47, 151757], [50, 151917], [60, 153052], [63, 153132], [69, 153352], [74, 153672], [82, 154052], [85, 154292]]}, {"verse": 20, "start": 155639, "end": 161420, "text": "Levántate, pues, y desciende, y no dudes ir con ellos; porque yo los he enviado.", "words": [[0, 155639], [11, 156120], [17, 156440], [19, 156720], [30, 157240], [32, 157580], [35, 157720], [41, 158020], [44, 158340], [48, 158560], [55, 159644], [62, 159838], [65, 160058], [69, 160238], [72, 160438]]}, {"verse": 21, "start": 161770, "end": 171847, "text": "Entonces Pedro, descendiendo a los hombres que eran enviados por Cornelio, dijo: He aquí, yo soy el que buscáis: ¿cuál es la causa por la que habéis venido?", "words": [[0, 161770], [9, 162207], [16, 163307], [29, 164087], [31, 164187], [35, 164287], [43, 164647], [47, 164867], [52, 165047], [61, 165567], [65, 165827], [75, 167067], [81, 167928], [84, 167988], [90, 168428], [93, 168508], [97, 168688], [100, 168848], [104, 168948], [113, 169910], [119, 170093], [122, 170173], [125, 170293], [131, 170593], [135, 170893], [138, 170973], [142, 171113], [149, 171353]]}, {"verse": 22, "start": 172197, "end": 188250, "text": "Y ellos dijeron: Cornelio, el centurión, varón justo y temeroso de Dios, y que goza de buen testimonio entre toda la nación de los judíos, ha recibido respuesta por un santo ángel, de hacerte venir a su casa, y oír de ti palabras.", "words": [[0, 172197], [2, 172363], [8, 172543], [17, 173586], [27, 174043], [30, 174143], [41, 174803], [47, 175043], [53, 175383], [55, 175563], [64, 176043], [67, 176223], [73, 177003], [75, 177083], [79, 177183], [84, 177523], [87, 177643], [92, 177803], [103, 178463], [109, 178623], [114, 178883], [117, 179083], [124, 179423], [127, 179583], [131, 179703], [139, 180543], [142, 180723], [151, 181243], [161, 181523], [165, 182043], [168, 182183], [174, 182543], [181, 183837], [184, 183980], [192, 184360], [198, 184560], [200, 184720], [203, 184840], [209, 185200], [211, 185660], [215, 185920], [218, 186040], [221, 186220]]}, {"verse": 23, "start": 188600, "end": 199162, "text": "Entonces metiéndolos dentro, los hospedó. Y al día siguiente, levantándose, se fue con ellos; y le acompañaron algunos de los hermanos de Jope.", "words": [[0, 188600], [9, 189077], [21, 190057], [29, 190517], [33, 190991], [42, 191704], [44, 192044], [47, 192164], [51, 192304], [62, 193124], [76, 194444], [79, 194624], [83, 194804], [87, 195084], [94, 195879], [96, 196140], [99, 196240], [111, 197420], [119, 197700], [122, 197860], [126, 197980], [135, 198520], [138, 198866]]}, {"verse": 24, "start": 199612, "end": 209089, "text": "Y al otro día entraron en Cesarea. Y Cornelio los estaba esperando, habiendo llamado a sus parientes y sus amigos más íntimos.", "words": [[0, 199612], [2, 199802], [5, 199992], [10, 200192], [14, 200532], [23, 201352], [26, 201532], [35, 202591], [37, 202693], [46, 203273], [50, 203413], [57, 203773], [68, 204153], [77, 204673], [85, 204953], [87, 205213], [91, 205353], [101, 205873], [103, 206073], [107, 206253], [114, 206593], [118, 206853]]}, {"verse": 25, "start": 209539, "end": 214555, "text": "Y como Pedro entró, salió Cornelio a recibirle; y postrándose a sus pies, adoró.", "words": [[0, 209539], [2, 209539], [7, 209539], [13, 209539], [20, 209539], [26, 209918], [35, 210658], [37, 210858], [48, 212100], [50, 212515], [62, 212965], [64, 213085], [68, 213265], [74, 214025]]}, {"verse": 26, "start": 215005, "end": 220272, "text": "Pero Pedro le levantó, diciendo: Levántate; yo mismo también soy hombre.", "words": [[0, 215005], [5, 215150], [11, 215530], [14, 215830], [23, 216430], [33, 217452], [44, 218575], [47, 218717], [53, 218937], [61, 219317], [65, 219697]]}, {"verse": 27, "start": 220622, "end": 225580, "text": "Y hablando con él, entró, y halló a muchos que se habían reunido.", "words": [[0, 220622], [2, 220745], [11, 220985], [15, 221365], [19, 221965], [26, 222505], [28, 223025], [34, 223385], [36, 223505], [43, 223845], [47, 224145], [50, 224305], [57, 224625]]}, {"verse": 28, "start": 226030, "end": 236734, "text": "Y les dijo: Vosotros sabéis que le está prohibido a un varón judío juntarse o llegarse a extranjero; pero me ha mostrado Dios que a ningún hombre llame común o inmundo;", "words": [[0, 226030], [2, 226157], [6, 226277], [12, 227024], [21, 227463], [28, 227923], [32, 228083], [35, 228223], [40, 228463], [50, 229023], [52, 229123], [55, 229223], [61, 229463], [67, 229843], [76, 230503], [78, 230923], [87, 231383], [89, 231483], [101, 232464], [106, 232582], [109, 232742], [112, 232822], [121, 233242], [126, 233522], [130, 233842], [132, 233902], [139, 234142], [146, 234482], [152, 234802], [158, 235222], [160, 235462]]}, {"verse": 29, "start": 237184, "end": 242936, "text": "Por lo cual, llamado, he venido sin dudar. Así que pregunto: ¿por qué causa me habéis hecho venir?", "words": [[0, 237184], [4, 237296], [7, 237436], [13, 237676], [22, 238216], [25, 238496], [32, 238836], [36, 239016], [43, 239867], [47, 240053], [51, 240193], [61, 241171], [66, 241290], [70, 241430], [76, 241770], [79, 241970], [86, 242250], [92, 242450]]}, {"verse": 30, "start": 243286, "end": 255884, "text": "Entonces Cornelio dijo: Hace cuatro días que a esta hora yo estaba ayunando; y a la novena hora estando orando en mi casa, he aquí, un varón se puso delante de mí en vestido resplandeciente.", "words": [[0, 243286], [9, 244133], [18, 244653], [24, 245385], [29, 245631], [36, 245911], [41, 246311], [45, 246631], [47, 246731], [52, 246951], [57, 247211], [60, 247391], [67, 247896], [77, 248654], [79, 248780], [81, 248880], [84, 248960], [91, 249400], [96, 249580], [104, 250040], [111, 250400], [114, 250520], [117, 250640], [123, 251080], [126, 251520], [132, 252200], [135, 252360], [141, 252680], [144, 252820], [149, 253140], [157, 253540], [160, 253700], [163, 253880], [166, 254120], [174, 254540]]}, {"verse": 31, "start": 256234, "end": 262241, "text": "Y dijo: Cornelio, tu oración es oída, y tus limosnas han venido en memoria en la presencia de Dios.", "words": [[0, 256234], [2, 256363], [8, 257135], [18, 257708], [21, 257728], [29, 258168], [32, 258348], [38, 259028], [40, 259108], [44, 259248], [53, 259768], [57, 259968], [64, 260348], [67, 260448], [75, 260888], [78, 261008], [81, 261108], [91, 261628], [94, 261788]]}, {"verse": 32, "start": 262691, "end": 272137, "text": "Envía pues a Jope, y haz venir a un Simón, que tiene por sobrenombre Pedro; este se hospeda en casa de Simón, curtidor, junto al mar; el cual venido, te hablará.", "words": [[0, 262691], [6, 263037], [11, 263217], [13, 263547], [19, 263877], [21, 264064], [25, 264250], [31, 264437], [33, 264537], [36, 264597], [43, 265057], [47, 265257], [53, 265477], [57, 265697], [69, 266257], [76, 267084], [81, 267329], [84, 267509], [92, 267949], [95, 268069], [100, 268289], [103, 268509], [110, 269069], [120, 269569], [126, 269809], [129, 270069], [134, 270745], [137, 270871], [142, 271051], [150, 271491], [153, 271631]]}, {"verse": 33, "start": 272587, "end": 282706, "text": "Así que, de inmediato envié a buscarte; y tú has hecho bien en venir. Ahora pues, todos nosotros estamos aquí en la presencia de Dios, para oír todo lo que Dios te ha mandado.", "words": [[0, 272587], [4, 272806], [9, 272986], [12, 273126], [22, 273666], [28, 274086], [30, 274086], [40, 275069], [42, 275195], [45, 275355], [49, 275555], [55, 275775], [60, 275995], [63, 276155], [70, 276899], [76, 277183], [82, 277403], [88, 277723], [97, 278143], [105, 278623], [110, 278983], [113, 279183], [116, 279263], [126, 279703], [129, 279883], [135, 280103], [140, 280703], [144, 281083], [149, 281323], [152, 281563], [156, 281683], [161, 281883], [164, 282083], [167, 282163]]}, {"verse": 34, "start": 283056, "end": 289438, "text": "Entonces Pedro, abriendo su boca, dijo: Por verdad hallo que Dios no muestra favoritismo;", "words": [[0, 283056], [9, 283474], [16, 284194], [25, 284614], [28, 284794], [34, 285674], [40, 286512], [44, 286640], [51, 287070], [57, 287500], [61, 287620], [66, 287820], [69, 288040], [77, 288480]]}, {"verse": 35, "start": 289888, "end": 294227, "text": "Sino que se agrada de quien le teme y obra justicia, de cualquier nación que sea.", "words": [[0, 289888], [5, 290125], [9, 290345], [12, 290505], [19, 290865], [22, 291005], [28, 291165], [31, 291345], [36, 291665], [38, 291765], [43, 291945], [53, 292665], [56, 292905], [66, 293105], [73, 293645], [77, 293785]]}, {"verse": 36, "start": 294677, "end": 301608, "text": "Envió palabra Dios a los hijos de Israel, anunciando la paz por Jesucristo; este es el Señor de todos.", "words": [[0, 294677], [6, 295078], [14, 295378], [19, 295778], [21, 295998], [25, 296118], [31, 296318], [34, 296498], [42, 297198], [53, 297977], [56, 298157], [60, 298417], [64, 298657], [76, 299775], [81, 300079], [84, 300319], [87, 300459], [93, 300739], [96, 300999]]}, {"verse": 37, "start": 302058, "end": 310029, "text": "Vosotros sabéis lo que fue divulgado por toda Judea; comenzando desde Galilea después del bautismo que Juan predicó,", "words": [[0, 302058], [9, 302518], [16, 302978], [19, 303118], [23, 303238], [27, 303398], [37, 303978], [41, 304218], [46, 304438], [53, 306319], [64, 306959], [70, 307179], [78, 307899], [86, 308119], [90, 308379], [99, 308979], [103, 309159], [108, 309379]]}, {"verse": 38, "start": 310479, "end": 321485, "text": "Cuanto a Jesús de Nazaret; cómo le ungió Dios de Espíritu Santo y de poder; el cual anduvo haciendo el bien, y sanando a todos los oprimidos del diablo; porque Dios era con él.", "words": [[0, 310479], [7, 310704], [9, 310864], [15, 311104], [18, 311324], [27, 312214], [32, 312391], [35, 312551], [41, 312991], [46, 313211], [49, 313411], [58, 313951], [64, 314231], [66, 314471], [69, 314571], [76, 315381], [79, 315525], [84, 315745], [91, 316185], [100, 316545], [103, 316785], [109, 317065], [111, 317525], [119, 317985], [121, 318085], [127, 318245], [131, 318465], [141, 318965], [145, 319145], [153, 320018], [160, 320239], [165, 320539], [169, 320939], [173, 321179]]}, {"verse": 39, "start": 321935, "end": 328569, "text": "Y nosotros somos testigos de todas las cosas que hizo en la tierra de Judea, y en Jerusalén; al cual mataron colgándole en un madero.", "words": [[0, 321935], [2, 322036], [11, 322236], [17, 322596], [26, 323096], [29, 323236], [35, 323416], [39, 323616], [45, 323876], [49, 324096], [54, 324276], [57, 324396], [60, 324476], [67, 324736], [70, 324856], [77, 325376], [79, 325556], [82, 325616], [93, 326584], [96, 326722], [101, 326882], [109, 327282], [120, 327882], [123, 328002], [126, 328102]]}, {"verse": 40, "start": 329019, "end": 332971, "text": "A este levantó Dios al tercer día, e hizo que apareciese manifiesto,", "words": [[0, 329019], [2, 329139], [7, 329339], [15, 329819], [20, 329959], [23, 330179], [30, 330399], [35, 331139], [37, 331299], [42, 331499], [46, 331659], [57, 332139]]}, {"verse": 41, "start": 333421, "end": 342719, "text": "No a todo el pueblo, sino a los testigos que Dios antes había escogido, es decir, a nosotros que comimos y bebimos con él, después que resucitó de los muertos.", "words": [[0, 333421], [3, 333578], [5, 333738], [10, 333878], [13, 334058], [21, 334558], [26, 334738], [28, 334838], [32, 334998], [41, 335478], [45, 335658], [50, 335858], [56, 336298], [62, 336618], [72, 337258], [75, 337458], [82, 337898], [84, 338438], [93, 338658], [97, 339038], [105, 339538], [107, 339778], [115, 340158], [119, 340458], [123, 340618], [131, 340998], [135, 341258], [144, 341858], [147, 341938], [151, 342058]]}, {"verse": 42, "start": 343169, "end": 349966, "text": "Y nos mandó que predicásemos al pueblo, y testificásemos que él es el que Dios ha puesto por Juez de vivos y muertos.", "words": [[0, 343169], [2, 343271], [6, 343391], [12, 343731], [16, 343871], [29, 344631], [32, 344811], [40, 345151], [42, 345591], [57, 346551], [61, 346731], [64, 346951], [67, 347151], [70, 347271], [74, 347411], [79, 347651], [82, 347871], [89, 348111], [93, 348451], [98, 348791], [101, 348891], [107, 349231], [109, 349331]]}, {"verse": 43, "start": 350416, "end": 359453, "text": "A este dan testimonio todos los profetas, de que todos los que en él creen, recibirán perdón de pecados por su nombre.", "words": [[0, 350416], [2, 350553], [7, 350926], [11, 351300], [22, 351673], [28, 351873], [32, 352153], [42, 353233], [45, 353313], [49, 353413], [55, 353653], [59, 353913], [63, 354073], [66, 354213], [69, 354293], [76, 354773], [86, 355633], [93, 356053], [96, 356173], [104, 356633], [108, 356833], [111, 356973]]}, {"verse": 44, "start": 359803, "end": 366861, "text": "Estando aún hablando Pedro estas palabras, el Espíritu Santo cayó sobre todos los que oían el sermón.", "words": [[0, 359803], [8, 360268], [12, 360448], [21, 360888], [27, 361368], [33, 361608], [43, 362788], [46, 363128], [55, 363628], [61, 363868], [66, 364368], [72, 364608], [78, 365068], [82, 365508], [86, 365708], [91, 366028], [94, 366168]]}, {"verse": 45, "start": 367311, "end": 378548, "text": "Y se espantaron los fieles que eran de la circuncisión, que habían venido con Pedro, de que también sobre los Gentiles se derramase el don del Espíritu Santo.", "words": [[0, 367311], [2, 367457], [5, 367557], [16, 368417], [20, 368617], [27, 369177], [31, 369297], [36, 369577], [39, 369757], [42, 369877], [56, 370857], [60, 371277], [67, 371497], [74, 371957], [78, 372157], [85, 372617], [88, 373077], [92, 373197], [100, 373577], [106, 373897], [110, 374157], [119, 374917], [122, 375617], [132, 376457], [135, 376837], [139, 377097], [143, 377377], [152, 377957]]}, {"verse": 46, "start": 378998, "end": 383747, "text": "Porque los oían que hablaban en lenguas, y que magnificaban a Dios.", "words": [[0, 378998], [7, 379215], [11, 379435], [16, 379935], [20, 380135], [29, 380555], [32, 380675], [41, 381215], [43, 381575], [47, 381735], [60, 383035], [62, 383175]]}, {"verse": 47, "start": 384197, "end": 393141, "text": "Entonces respondió Pedro: ¿Puede alguno impedir el agua, para que no sean bautizados estos que han recibido el Espíritu Santo también como nosotros?", "words": [[0, 384197], [9, 384966], [19, 385506], [26, 386370], [33, 386564], [40, 386964], [48, 387364], [51, 387464], [57, 387764], [62, 388224], [66, 388364], [69, 388504], [74, 388744], [85, 389484], [91, 389864], [95, 390164], [99, 390324], [108, 390824], [111, 390924], [120, 391364], [126, 391644], [134, 392064], [139, 392364]]}, {"verse": 48, "start": 393491, "end": 400867, "text": "Y les mandó bautizar en el nombre del Señor Jesús. Entonces le rogaron que se quedase por algunos días.", "words": [[0, 393491], [2, 393589], [6, 393719], [12, 394179], [21, 394779], [24, 395059], [27, 395219], [34, 395539], [38, 395819], [44, 396139], [51, 397285], [60, 398086], [63, 398366], [71, 398906], [75, 399046], [78, 399186], [86, 399606], [90, 399846], [98, 400146]]}]}