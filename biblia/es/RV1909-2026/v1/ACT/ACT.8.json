{"book": "ACT", "chapter": 8, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 337149, "verses": [{"verse": 1, "start": 300, "end": 14809, "text": "Y Saulo consentía en su muerte. Y en aquel día se hizo una grande persecución en la iglesia que estaba en Jerusalén; y todos fueron esparcidos por las tierras de Judea y de Samaria, salvo los apóstoles.", "words": [[0, 300], [2, 424], [8, 924], [18, 2004], [21, 2164], [24, 2364], [32, 3385], [34, 3527], [37, 3627], [43, 4007], [47, 4207], [50, 4467], [55, 4847], [59, 5187], [66, 5627], [78, 6607], [81, 6767], [84, 6927], [92, 7407], [96, 7647], [103, 8007], [106, 8247], [117, 9486], [119, 9610], [125, 9890], [132, 10270], [143, 11050], [147, 11310], [151, 11490], [159, 11930], [162, 12050], [168, 12570], [170, 12650], [173, 12810], [182, 13330], [188, 13730], [192, 13870]]}, {"verse": 2, "start": 15259, "end": 21531, "text": "Y llevaron a enterrar a Esteban varones piadosos, e hicieron gran llanto sobre él.", "words": [[0, 15259], [2, 15383], [11, 15843], [13, 15963], [22, 16583], [24, 16763], [32, 17363], [40, 18023], [50, 19183], [52, 19283], [61, 19783], [66, 20163], [73, 20763], [79, 21083]]}, {"verse": 3, "start": 21981, "end": 30710, "text": "Entonces Saulo asolaba la iglesia, entrando por las casas: y arrastrando a hombres y mujeres, los entregaba en la cárcel.", "words": [[0, 21981], [9, 22546], [15, 23266], [23, 23926], [26, 24106], [35, 24626], [44, 25286], [48, 25506], [52, 25726], [59, 26646], [61, 26755], [73, 27495], [75, 27675], [83, 28015], [85, 28215], [94, 28735], [98, 29135], [108, 29775], [111, 29895], [114, 30035]]}, {"verse": 4, "start": 31159, "end": 35817, "text": "Pero los que fueron esparcidos, iban por todas partes anunciando la palabra.", "words": [[0, 31159], [5, 31286], [9, 31466], [13, 31606], [20, 31866], [32, 32566], [37, 33066], [41, 33286], [47, 33486], [54, 34006], [65, 34946], [68, 35106]]}, {"verse": 5, "start": 36267, "end": 42480, "text": "Entonces Felipe, descendiendo a la ciudad de Samaria, les predicaba a Cristo.", "words": [[0, 36267], [9, 37368], [17, 37768], [30, 38708], [32, 38808], [35, 38868], [42, 39188], [45, 39508], [54, 40068], [58, 40628], [68, 41508], [70, 41788]]}, {"verse": 6, "start": 42930, "end": 50754, "text": "Y la gente, unánime, escuchaba atentamente las cosas que decía Felipe, oyendo y viendo las señales que hacía.", "words": [[0, 42930], [2, 43016], [5, 43116], [12, 43416], [21, 44056], [31, 45216], [43, 45996], [47, 46196], [53, 46536], [57, 46756], [63, 47116], [71, 48116], [78, 48576], [80, 48836], [87, 49176], [91, 49416], [99, 49976], [103, 50136]]}, {"verse": 7, "start": 51204, "end": 59785, "text": "Porque de muchos que tenían espíritus inmundos, salían estos dando grandes voces; y muchos paralíticos y cojos eran sanados:", "words": [[0, 51204], [7, 51385], [10, 51585], [17, 51865], [21, 52145], [28, 52485], [38, 53125], [48, 53865], [55, 54292], [61, 54718], [67, 55145], [75, 55485], [82, 56554], [84, 56682], [91, 56942], [103, 57962], [105, 58252], [111, 58542], [116, 58782]]}, {"verse": 8, "start": 60235, "end": 62689, "text": "Así que había gran gozo en aquella ciudad.", "words": [[0, 60235], [4, 60430], [8, 60630], [14, 60810], [19, 61090], [24, 61490], [27, 61630], [35, 61990]]}, {"verse": 9, "start": 63139, "end": 74587, "text": "Y había un hombre llamado Simón, el cual había practicado antes la magia en aquella ciudad, y había engañado la gente de Samaria, diciéndose ser algún grande:", "words": [[0, 63139], [2, 63260], [8, 63460], [11, 63720], [18, 63980], [26, 64300], [33, 65420], [36, 65720], [41, 65980], [47, 66420], [58, 67240], [64, 67740], [67, 68160], [73, 68660], [76, 68780], [84, 69120], [92, 69480], [94, 70200], [100, 70360], [109, 70980], [112, 71100], [118, 71360], [121, 71600], [130, 72140], [141, 73260], [145, 73530], [151, 73800]]}, {"verse": 10, "start": 75037, "end": 83399, "text": "Al cual oían todos atentamente desde el más pequeño hasta el más grande, diciendo: Este es el gran poder de Dios.", "words": [[0, 75102], [3, 75202], [8, 75462], [13, 76002], [19, 76382], [31, 77402], [37, 77642], [40, 77862], [44, 78022], [52, 78602], [58, 79202], [61, 79362], [65, 79542], [73, 80479], [83, 81600], [88, 81866], [91, 82046], [94, 82186], [99, 82346], [105, 82666], [108, 82866]]}, {"verse": 11, "start": 83749, "end": 90059, "text": "Y le estaban atentos, porque con sus artes mágicas los había engañado mucho tiempo.", "words": [[0, 83749], [2, 83892], [5, 84012], [13, 84452], [22, 85812], [29, 86272], [33, 86572], [37, 86792], [43, 87332], [51, 87972], [55, 88112], [61, 88452], [70, 89032], [76, 89312]]}, {"verse": 12, "start": 90509, "end": 101086, "text": "Pero cuando creyeron a Felipe, que anunciaba el evangelio del reino de Dios y el nombre de Jesucristo, se bautizaban hombres y mujeres.", "words": [[0, 90509], [5, 90652], [12, 90992], [21, 91712], [23, 91792], [31, 92792], [35, 92852], [45, 93572], [48, 93732], [58, 94452], [62, 94632], [68, 95012], [71, 95172], [76, 95552], [78, 96112], [81, 96232], [88, 96652], [91, 97432], [103, 98212], [106, 98592], [117, 99372], [125, 99852], [127, 100252]]}, {"verse": 13, "start": 101536, "end": 112705, "text": "El mismo Simón creyó también entonces, y bautizándose, se llegó a Felipe: y viendo los milagros y grandes maravillas que se hacían, estaba atónito.", "words": [[0, 101536], [3, 101662], [9, 101982], [15, 102582], [21, 103022], [29, 103362], [39, 104162], [41, 104962], [55, 105742], [58, 106522], [64, 106802], [66, 106982], [74, 107850], [76, 107976], [83, 108256], [87, 108476], [96, 109056], [98, 109176], [106, 109496], [117, 110156], [121, 110336], [124, 110476], [132, 111316], [139, 111816]]}, {"verse": 14, "start": 113155, "end": 122691, "text": "Y los apóstoles que estaban en Jerusalén, habiendo oído que Samaria había recibido la palabra de Dios, les enviaron a Pedro y a Juan:", "words": [[0, 113155], [2, 113280], [6, 113400], [16, 114120], [20, 114380], [28, 114760], [31, 115000], [42, 116240], [51, 116780], [56, 117120], [60, 117340], [68, 117880], [74, 118200], [83, 118940], [86, 119080], [94, 119400], [97, 119640], [103, 120320], [107, 120460], [116, 121200], [118, 121340], [124, 121780], [126, 122020], [128, 122100]]}, {"verse": 15, "start": 123142, "end": 128220, "text": "Los cuales venidos, oraron por ellos, para que recibiesen el Espíritu Santo;", "words": [[0, 123142], [4, 123267], [11, 123507], [20, 124067], [27, 124647], [31, 124887], [38, 125167], [43, 125687], [47, 125867], [58, 126647], [61, 126947], [70, 127527]]}, {"verse": 16, "start": 128670, "end": 136397, "text": "(Porque aún no había descendido sobre ninguno de ellos, sino que solamente habían sido bautizados en el nombre de Jesús.)", "words": [[0, 128670], [8, 128874], [12, 129214], [15, 129474], [21, 129944], [32, 130414], [38, 130674], [46, 131214], [49, 131374], [56, 132074], [61, 132254], [65, 132434], [75, 132814], [82, 133234], [87, 133594], [98, 134754], [101, 134994], [104, 135154], [111, 135534], [114, 135734]]}, {"verse": 17, "start": 136847, "end": 142247, "text": "Entonces les impusieron las manos, y recibieron el Espíritu Santo.", "words": [[0, 136847], [9, 137391], [13, 137951], [24, 138631], [28, 138831], [35, 139271], [37, 140051], [48, 140771], [51, 140951], [60, 141551]]}, {"verse": 18, "start": 142697, "end": 150339, "text": "Y cuando vio Simón que por la imposición de las manos de los apóstoles se daba el Espíritu Santo, les ofreció dinero,", "words": [[0, 142697], [2, 142952], [9, 143192], [13, 143492], [19, 144152], [23, 144232], [27, 144432], [30, 144612], [41, 145392], [44, 145552], [48, 145672], [54, 145932], [57, 146092], [61, 146192], [71, 146685], [74, 147179], [79, 147672], [82, 147812], [91, 148332], [98, 149092], [102, 149172], [110, 149752]]}, {"verse": 19, "start": 150789, "end": 158802, "text": "Diciendo: Dadme también a mí esta potestad, que a cualquiera que ponga las manos encima, reciba el Espíritu Santo.", "words": [[0, 150789], [10, 152010], [16, 152428], [24, 152828], [26, 152988], [29, 153188], [34, 153568], [44, 154308], [48, 154688], [50, 154768], [61, 155268], [65, 155428], [71, 155768], [75, 155908], [81, 156168], [89, 156748], [96, 157648], [99, 157768], [108, 158288]]}, {"verse": 20, "start": 159152, "end": 165585, "text": "Entonces Pedro le dijo: Tu dinero perezca contigo, que piensas que el don de Dios se gane por dinero.", "words": [[0, 159152], [9, 159651], [15, 160351], [18, 160631], [24, 161391], [27, 161489], [34, 161789], [42, 162329], [51, 163129], [55, 163209], [63, 163669], [67, 163829], [70, 163929], [74, 164089], [77, 164229], [82, 164449], [85, 164649], [90, 164869], [94, 165029]]}, {"verse": 21, "start": 166035, "end": 171732, "text": "No tienes tú parte ni suerte en este asunto; porque tu corazón no es recto delante de Dios.", "words": [[0, 166035], [3, 166155], [10, 166455], [13, 166635], [19, 166955], [22, 167215], [29, 167635], [32, 167775], [37, 167955], [45, 168883], [52, 169083], [55, 169243], [63, 169663], [66, 170183], [69, 170363], [75, 170783], [83, 171123], [86, 171243]]}, {"verse": 22, "start": 172182, "end": 178985, "text": "Arrepiéntete pues de esta tu maldad, y ruega a Dios, si quizás te será perdonado el pensamiento de tu corazón.", "words": [[0, 172529], [13, 172879], [18, 173139], [21, 173359], [26, 173599], [29, 173819], [37, 174279], [39, 174579], [45, 174939], [47, 175059], [53, 175819], [56, 175899], [63, 176379], [66, 176499], [71, 176739], [81, 177359], [84, 177459], [96, 178019], [99, 178199], [102, 178319]]}, {"verse": 23, "start": 179435, "end": 182922, "text": "Porque en hiel de amargura y en prisión de maldad veo que estás.", "words": [[0, 179435], [7, 179668], [10, 179908], [15, 180108], [18, 180228], [27, 180748], [29, 180888], [32, 180988], [40, 181368], [43, 181468], [50, 181888], [54, 182148], [58, 182348]]}, {"verse": 24, "start": 183272, "end": 192063, "text": "Respondiendo entonces Simón, dijo: Rogad vosotros por mí al Señor, que ninguna cosa de estas que habéis dicho, venga sobre mí.", "words": [[0, 183272], [13, 183877], [22, 184317], [29, 185037], [35, 186220], [41, 186619], [50, 187099], [54, 187359], [57, 187559], [60, 187719], [67, 188419], [71, 188659], [79, 188959], [84, 189399], [87, 189619], [93, 189999], [97, 190099], [104, 190399], [111, 190779], [117, 191459], [123, 191699]]}, {"verse": 25, "start": 192413, "end": 202861, "text": "Y ellos, habiendo testificado y hablado la palabra de Dios, se volvieron a Jerusalén, y en muchas aldeas de los samaritanos anunciaron el evangelio.", "words": [[0, 192413], [2, 192602], [9, 193062], [18, 193442], [30, 194442], [32, 194582], [40, 195022], [43, 195182], [51, 195582], [54, 195842], [60, 196822], [63, 197082], [73, 197602], [75, 197782], [86, 198542], [88, 199082], [91, 199222], [98, 199482], [105, 200122], [108, 200222], [112, 200342], [124, 201102], [135, 201762], [138, 202022]]}, {"verse": 26, "start": 203311, "end": 213133, "text": "Pero el ángel del Señor habló a Felipe, diciendo: Levántate y ve hacia el sur, al camino que desciende de Jerusalén a Gaza, el cual es desierto.", "words": [[0, 203311], [5, 203475], [8, 203635], [14, 204015], [18, 204175], [24, 204535], [30, 205075], [32, 205175], [40, 205995], [50, 206975], [60, 207634], [62, 207914], [65, 208074], [71, 208314], [74, 208574], [79, 209214], [82, 209374], [89, 209694], [93, 209914], [103, 210414], [106, 210594], [116, 211174], [118, 211274], [124, 212014], [127, 212094], [132, 212294], [135, 212474]]}, {"verse": 27, "start": 213483, "end": 229771, "text": "Entonces él se levantó, y fue: y he aquí un etíope, eunuco, alto funcionario de Candace, reina de los etíopes, el cual estaba encargado de todos sus tesoros, y había venido a adorar a Jerusalén,", "words": [[0, 213483], [9, 213971], [12, 214611], [15, 214931], [24, 215791], [26, 216131], [31, 216841], [33, 217049], [36, 217189], [41, 217489], [44, 217729], [52, 218589], [60, 219509], [65, 219849], [77, 220749], [80, 220909], [89, 221769], [95, 222629], [98, 222769], [102, 222909], [111, 224089], [114, 224249], [119, 224449], [126, 224809], [136, 225529], [139, 225709], [145, 225969], [149, 226289], [158, 227189], [160, 227369], [166, 227549], [173, 228049], [175, 228289], [182, 228709], [184, 228869]]}, {"verse": 28, "start": 230221, "end": 234873, "text": "Se volvía sentado en su carro, y leyendo el profeta Isaías.", "words": [[0, 230221], [3, 230424], [10, 230904], [18, 231504], [21, 231644], [24, 231784], [31, 232184], [33, 232744], [41, 233344], [44, 233484], [52, 233984]]}, {"verse": 29, "start": 235323, "end": 240210, "text": "Y el Espíritu dijo a Felipe: Acércate y ve junto a este carro.", "words": [[0, 235323], [2, 235489], [5, 235589], [14, 236169], [19, 236389], [21, 236609], [29, 237442], [38, 238146], [40, 238506], [43, 238666], [49, 238906], [51, 239186], [56, 239366]]}, {"verse": 30, "start": 240560, "end": 247247, "text": "Y acudiendo Felipe, le oyó que leía el profeta Isaías, y dijo: Pero ¿entiendes lo que lees?", "words": [[0, 240560], [2, 240720], [12, 241360], [20, 241980], [23, 242600], [27, 242920], [31, 243080], [36, 243540], [39, 243720], [47, 244260], [55, 244880], [57, 245100], [63, 245864], [68, 246003], [79, 246563], [82, 246663], [86, 246983]]}, {"verse": 31, "start": 247597, "end": 255344, "text": "Y él dijo: ¿Y cómo podré, si alguno no me enseña? Y rogó a Felipe que subiese, y se sentase con él.", "words": [[0, 247597], [2, 247785], [5, 247945], [11, 248714], [14, 248837], [19, 249077], [26, 249557], [29, 249697], [36, 250137], [39, 250257], [42, 250377], [50, 251283], [52, 251404], [57, 251964], [59, 252104], [66, 252444], [70, 252684], [79, 253284], [81, 253944], [84, 254084], [92, 254644], [96, 254944]]}, {"verse": 32, "start": 255794, "end": 266690, "text": "Y el lugar de la Escritura que leía, era este: Como oveja a la muerte fue llevado; y como cordero mudo delante del que lo esquila, así no abrió su boca:", "words": [[0, 255794], [2, 255932], [5, 256032], [11, 256312], [14, 256572], [17, 256692], [27, 257192], [31, 257312], [37, 257772], [41, 258032], [47, 258979], [52, 259343], [58, 259743], [60, 260143], [63, 260243], [70, 260563], [74, 260843], [83, 261851], [85, 261954], [90, 262194], [98, 262754], [103, 263134], [111, 263574], [115, 263754], [119, 263914], [122, 264074], [131, 265014], [135, 265274], [138, 265574], [144, 265934], [147, 266114]]}, {"verse": 33, "start": 267140, "end": 275761, "text": "En su humillación su juicio fue quitado: pero su generación, ¿quién la contará? porque es quitada de la tierra su vida.", "words": [[0, 267140], [3, 267288], [6, 267528], [18, 268348], [21, 268408], [28, 268788], [32, 269028], [41, 270032], [46, 270155], [49, 270415], [61, 271655], [68, 271935], [71, 272095], [80, 273364], [87, 273554], [90, 273714], [98, 274234], [101, 274394], [104, 274514], [111, 274874], [114, 275194]]}, {"verse": 34, "start": 276211, "end": 284056, "text": "Y respondiendo el eunuco a Felipe, dijo: Te ruego ¿de quién el profeta dice esto? ¿de sí, o de otro alguno?", "words": [[0, 276211], [2, 276319], [15, 277179], [18, 277589], [25, 277999], [27, 278099], [35, 278919], [41, 279722], [44, 279860], [50, 280220], [54, 280420], [60, 280620], [63, 280820], [71, 281300], [76, 281560], [82, 282422], [86, 282563], [90, 282863], [92, 283103], [95, 283223], [100, 283443]]}, {"verse": 35, "start": 284406, "end": 292691, "text": "Entonces Felipe, abriendo su boca, y comenzando desde esta escritura, le anunció el evangelio de Jesús.", "words": [[0, 284406], [9, 285563], [17, 285963], [26, 286483], [29, 286683], [35, 287083], [37, 287663], [48, 288583], [54, 288803], [59, 289203], [70, 290163], [73, 290243], [81, 291043], [84, 291163], [94, 291883], [97, 292003]]}, {"verse": 36, "start": 293141, "end": 301943, "text": "Y yendo por el camino, llegaron a cierta agua; y dijo el eunuco: He aquí agua; ¿qué impide que yo sea bautizado?", "words": [[0, 293141], [2, 293439], [8, 293739], [12, 293979], [15, 294119], [23, 294639], [32, 295479], [34, 295659], [41, 296119], [47, 297107], [49, 297210], [54, 297530], [57, 298144], [65, 298996], [68, 299076], [73, 299276], [79, 300140], [84, 300238], [91, 300658], [95, 300818], [98, 300958], [102, 301138]]}, {"verse": 37, "start": 302293, "end": 311292, "text": "Y Felipe dijo: Si crees de todo corazón, bien puedes. Y respondiendo, dijo: Creo que Jesucristo es el Hijo de Dios.", "words": [[0, 302293], [2, 302421], [9, 302801], [15, 303698], [18, 303860], [24, 304220], [27, 304320], [32, 304540], [41, 305360], [46, 305520], [54, 306551], [56, 306678], [70, 307518], [76, 308708], [81, 308906], [85, 309126], [96, 309906], [99, 310206], [102, 310366], [107, 310586], [110, 310746]]}, {"verse": 38, "start": 311642, "end": 318840, "text": "Y mandó parar el carro: y descendieron ambos al agua, Felipe y el eunuco; y le bautizó.", "words": [[0, 311642], [2, 311786], [8, 312106], [14, 312346], [17, 312851], [24, 313602], [26, 313708], [39, 314328], [45, 314628], [48, 314908], [54, 315668], [61, 316128], [63, 316628], [66, 316788], [74, 317861], [76, 318005], [79, 318444]]}, {"verse": 39, "start": 319290, "end": 328098, "text": "Y como subieron del agua, el Espíritu del Señor arrebató a Felipe; y no le vio más el eunuco, y se fue por su camino gozoso.", "words": [[0, 319290], [2, 319376], [7, 319576], [16, 320036], [20, 320236], [26, 320916], [29, 321016], [38, 321556], [42, 321676], [48, 322016], [57, 322776], [59, 322876], [67, 323884], [69, 324012], [72, 324152], [75, 324292], [79, 324512], [83, 324732], [86, 325172], [94, 325612], [96, 326232], [99, 326372], [103, 326532], [107, 326752], [110, 326912], [117, 327232]]}, {"verse": 40, "start": 328548, "end": 336749, "text": "Pero Felipe se halló en Azoto: y pasando, anunciaba el evangelio en todas las ciudades, hasta que llegó a Cesarea.", "words": [[0, 328548], [5, 328692], [12, 329072], [15, 329342], [21, 329612], [24, 329978], [31, 330601], [33, 330758], [42, 331258], [52, 332558], [55, 332718], [65, 333338], [68, 333498], [74, 333758], [78, 334058], [88, 335058], [94, 335338], [98, 335518], [104, 335778], [106, 335978]]}]}