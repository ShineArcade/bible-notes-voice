, 108559], [64, 108660], [70, 108920], [72, 109459], [76, 109660], [86, 110539], [90, 110780], [93, 111759], [106, 112279], [108, 112500], [115, 112899], [118, 113059], [127, 114084], [131, 114166], [134, 114386], [143, 114846], [150, 115486], [152, 115746], [156, 115906], [160, 116046], [163, 116186], [170, 116546], [176, 116926]]}, {"verse": 15, "start": 118572, "end": 124699, "text": "Y les dijo: Id por todo el mundo; predicad el evangelio a toda criatura.", "words": [[0, 118572], [2, 118714], [6, 118854], [12, 119755], [15, 119865], [19, 120325], [24, 120665], [27, 120945], [34, 121790], [43, 122461], [46, 122701], [56, 123381], [58, 123501], [63, 123701]]}, {"verse": 16, "start": 125149, "end": 130776, "text": "El que crea y sea bautizado, será salvo; pero el que no crea, será condenado.", "words": [[0, 125149], [3, 125286], [7, 125426], [12, 125846], [14, 125946], [18, 126146], [29, 126866], [34, 127206], [41, 128193], [46, 128393], [49, 128533], [53, 128693], [56, 128873], [62, 129453], [67, 129873]]}, {"verse": 17, "start": 131225, "end": 139124, "text": "Y estas señales seguirán a los que creen: En mi nombre echarán fuera demonios; hablarán nuevas lenguas;", "words": [[0, 131225], [2, 131371], [8, 131651], [16, 132511], [25, 133191], [27, 133351], [31, 133491], [35, 133651], [42, 134695], [45, 134840], [48, 135000], [55, 135340], [63, 135900], [69, 136160], [79, 137450], [88, 137993], [95, 138253]]}, {"verse": 18, "start": 139574, "end": 148703, "text": "Tomarán serpientes en sus manos, y si beben algo mortal, no les dañará; sobre los enfermos pondrán sus manos, y sanarán.", "words": [[0, 139574], [8, 140019], [19, 140659], [22, 140899], [26, 141079], [33, 141499], [35, 141979], [38, 142139], [44, 142499], [49, 142719], [57, 143639], [60, 143839], [64, 144019], [72, 144950], [78, 145332], [82, 145572], [91, 146212], [99, 146672], [103, 146852], [110, 147292], [112, 147672]]}, {"verse": 19, "start": 149153, "end": 156309, "text": "Y el Señor, después que les