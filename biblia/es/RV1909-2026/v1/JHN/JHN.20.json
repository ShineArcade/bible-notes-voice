{"book": "JHN", "chapter": 20, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 266675, "verses": [{"verse": 1, "start": 300, "end": 10794, "text": "Y el primer día de la semana, María Magdalena vino de mañana, siendo aún oscuro, al sepulcro; y vio la piedra quitada del sepulcro.", "words": [[0, 300], [2, 441], [5, 601], [12, 1001], [16, 1401], [19, 1541], [22, 1681], [30, 2781], [36, 3221], [46, 4061], [51, 4281], [54, 4501], [62, 4961], [69, 5421], [73, 5801], [81, 6556], [84, 7056], [94, 8175], [96, 8297], [100, 8517], [103, 8657], [110, 9197], [118, 9697], [122, 9957]]}, {"verse": 2, "start": 11144, "end": 22727, "text": "Entonces corrió, y vino a Simón Pedro, y al otro discípulo, al cual amaba Jesús, y les dice: Han llevado al Señor del sepulcro, y no sabemos dónde le han puesto.", "words": [[0, 11144], [9, 12008], [17, 12668], [19, 12988], [24, 13268], [26, 13468], [32, 13808], [39, 14248], [41, 14523], [44, 14643], [49, 14883], [60, 15563], [63, 16243], [68, 16323], [74, 16723], [81, 17623], [83, 17683], [87, 17823], [93, 18561], [97, 18701], [105, 19121], [108, 19261], [114, 19541], [118, 19741], [128, 20421], [130, 20881], [133, 21021], [141, 21381], [147, 21701], [150, 21941], [154, 22061]]}, {"verse": 3, "start": 23007, "end": 27512, "text": "Y salió Pedro, y el otro discípulo, y vinieron al sepulcro.", "words": [[0, 23007], [2, 23151], [8, 23471], [15, 23871], [17, 24111], [20, 24231], [25, 24431], [36, 25191], [38, 25741], [47, 26291], [50, 26591]]}, {"verse": 4, "start": 27862, "end": 34678, "text": "Y corrían los dos juntos; pero el otro discípulo corrió más aprisa que Pedro, y llegó primero al sepulcro.", "words": [[0, 27862], [2, 27969], [10, 28429], [14, 28629], [18, 28789], [26, 29613], [31, 30037], [34, 30197], [39, 30357], [49, 30977], [56, 31377], [60, 31717], [67, 32057], [71, 32217], [78, 32597], [80, 33042], [86, 33282], [94, 33722], [97, 33942]]}, {"verse": 5, "start": 35028, "end": 40098, "text": "Y bajándose a mirar, vio las telas de lino allí puestas; pero no entró.", "words": [[0, 35028], [2, 35215], [12, 35795], [14, 35915], [21, 36695], [25, 36975], [29, 37155], [35, 37555], [38, 37675], [43, 37995], [48, 38155], [57, 39190], [62, 39354], [65, 39554]]}, {"verse": 6, "start": 40448, "end": 47827, "text": "Llegó luego Simón Pedro siguiéndole, y entró en el sepulcro, y vio las telas de lino allí puestas,", "words": [[0, 40448], [6, 40835], [12, 41095], [18, 41715], [24, 42115], [37, 42975], [39, 43415], [45, 43915], [48, 44055], [51, 44175], [61, 44895], [63, 45395], [67, 45575], [71, 45775], [77, 46215], [80, 46335], [85, 46655], [90, 46855]]}, {"verse": 7, "start": 48177, "end": 55931, "text": "Y el paño que había estado sobre su cabeza, no puesto con las telas de lino, sino enrollado en un lugar aparte.", "words": [[0, 48177], [2, 48303], [5, 48423], [10, 49003], [14, 49203], [20, 49423], [27, 49823], [33, 50263], [36, 50483], [44, 50943], [47, 51483], [54, 51843], [58, 52163], [62, 52323], [68, 52663], [71, 52763], [77, 53163], [82, 53603], [92, 54563], [95, 54723], [98, 54843], [104, 55183]]}, {"verse": 8, "start": 56281, "end": 62975, "text": "Y entonces entró también el otro discípulo, que había venido primero al sepulcro, y vio, y creyó.", "words": [[0, 56281], [2, 56403], [11, 56783], [17, 57403], [25, 57643], [28, 57903], [33, 58103], [44, 58763], [48, 58943], [54, 59143], [61, 59543], [69, 59923], [72, 60163], [82, 60883], [84, 61503], [89, 61803], [91, 62383]]}, {"verse": 9, "start": 63325, "end": 69980, "text": "Porque aún no sabían la Escritura, que era necesario que él resucitase de los muertos.", "words": [[0, 63325], [7, 63590], [11, 63930], [14, 64150], [21, 64570], [24, 64730], [35, 65610], [39, 65850], [43, 66030], [53, 66830], [57, 67430], [60, 67750], [71, 68850], [74, 69010], [78, 69150]]}, {"verse": 10, "start": 70330, "end": 72693, "text": "Y volvieron los discípulos a los suyos.", "words": [[0, 70330], [2, 70450], [12, 70910], [16, 71070], [27, 71690], [29, 71850], [33, 71990]]}, {"verse": 11, "start": 73043, "end": 79932, "text": "Pero María estaba fuera llorando junto al sepulcro: y estando llorando, se inclinó para mirar el sepulcro;", "words": [[0, 73043], [5, 73164], [11, 73424], [18, 73744], [24, 74064], [33, 74644], [39, 74924], [42, 75264], [52, 76281], [54, 76386], [62, 76746], [72, 77626], [75, 77866], [83, 78406], [88, 78606], [94, 79006], [97, 79146]]}, {"verse": 12, "start": 80282, "end": 90002, "text": "Y vio dos ángeles en ropas blancas que estaban sentados, el uno a la cabecera, y el otro a los pies, donde el cuerpo de Jesús había sido puesto.", "words": [[0, 80282], [2, 80418], [6, 80638], [10, 80838], [18, 81418], [21, 81658], [27, 82038], [35, 82578], [39, 82698], [47, 82998], [57, 84098], [60, 84238], [64, 84458], [66, 84598], [69, 84678], [79, 85298], [81, 85738], [84, 85858], [89, 86078], [91, 86218], [95, 86338], [101, 86918], [107, 87198], [110, 87518], [117, 87898], [120, 88138], [126, 88498], [132, 88918], [137, 89278]]}, {"verse": 13, "start": 90352, "end": 97526, "text": "Y le dijeron: Mujer, ¿por qué lloras? Les dice: Porque se han llevado a mi Señor, y no sé dónde le han puesto.", "words": [[0, 90352], [2, 90518], [5, 90598], [14, 91554], [21, 92119], [26, 92239], [30, 92419], [38, 93282], [42, 93382], [48, 94102], [55, 94296], [58, 94476], [62, 94616], [70, 95016], [72, 95036], [75, 95176], [82, 95616], [84, 96096], [87, 96236], [90, 96416], [96, 96596], [99, 96816], [103, 96916]]}, {"verse": 14, "start": 97806, "end": 105372, "text": "Y cuando hubo dicho esto, se volvió atrás, y vio a Jesús que estaba allí; pero no sabía que era Jesús.", "words": [[0, 97806], [2, 97911], [9, 98131], [14, 98691], [20, 98891], [26, 99171], [29, 99391], [36, 99891], [43, 100291], [45, 101071], [49, 101371], [51, 101551], [57, 101891], [61, 102311], [68, 102611], [74, 103306], [79, 103678], [82, 103858], [88, 104298], [92, 104478], [96, 104718]]}, {"verse": 15, "start": 105722, "end": 119568, "text": "Le dice Jesús: Mujer, ¿por qué lloras? ¿a quién buscas? Ella, pensando que era el jardinero, le dice: Señor, si tú lo has llevado, dime dónde lo has puesto, y yo lo llevaré.", "words": [[0, 105761], [3, 105841], [8, 106121], [15, 107070], [22, 107590], [27, 107770], [31, 107890], [39, 108741], [42, 108847], [48, 109007], [56, 109998], [62, 110223], [71, 110823], [75, 111163], [79, 111363], [82, 111983], [93, 112603], [96, 113103], [102, 113829], [109, 114547], [112, 114587], [115, 114767], [118, 114947], [122, 115107], [131, 116247], [136, 116427], [142, 116707], [145, 116947], [149, 117067], [157, 117467], [159, 117927], [162, 118107], [165, 118227]]}, {"verse": 16, "start": 119848, "end": 127952, "text": "Le dice Jesús: ¡María! Volviéndose ella, le dice: ¡Raboni! que quiere decir, Maestro.", "words": [[0, 119848], [3, 119977], [8, 120217], [15, 121151], [23, 122014], [35, 122721], [41, 123141], [44, 123601], [50, 125174], [59, 126205], [63, 126310], [70, 126630], [77, 126990]]}, {"verse": 17, "start": 128302, "end": 140298, "text": "Le dice Jesús: No me toques: porque aún no he subido a mi Padre: pero ve a mis hermanos, y diles: Subo a mi Padre y a vuestro Padre, a mi Dios y a vuestro Dios.", "words": [[0, 128302], [3, 128428], [8, 128688], [15, 129699], [18, 129827], [21, 129947], [29, 130805], [36, 131009], [40, 131269], [43, 131509], [46, 131609], [53, 132049], [55, 132149], [58, 132269], [65, 133085], [70, 133247], [73, 133427], [75, 133507], [79, 133647], [89, 134267], [91, 134467], [98, 135401], [103, 135903], [105, 136023], [108, 136103], [114, 136763], [116, 136923], [118, 137023], [126, 137303], [133, 138223], [135, 138303], [138, 138423], [143, 138723], [145, 139078], [147, 139198], [155, 139658]]}, {"verse": 18, "start": 140648, "end": 149446, "text": "fue María Magdalena dando la noticia a los discípulos de que había visto al Señor, y que él le había dicho estas cosas.", "words": [[0, 140648], [4, 140856], [10, 141196], [20, 141956], [26, 142276], [29, 142516], [37, 143216], [39, 143476], [43, 143636], [54, 144696], [57, 145216], [61, 145356], [67, 145596], [73, 145976], [76, 146176], [83, 146516], [85, 147056], [89, 147236], [92, 147476], [95, 147876], [101, 148116], [107, 148456], [113, 148696]]}, {"verse": 19, "start": 149796, "end": 165399, "text": "Y como fue tarde aquel día, el primero de la semana, y estando las puertas cerradas donde los discípulos estaban juntos por miedo de los judíos, vino Jesús, y se puso en medio, y les dijo: Paz a vosotros.", "words": [[0, 149796], [2, 149940], [7, 150220], [11, 150500], [17, 150940], [23, 151580], [28, 152440], [31, 152600], [39, 153020], [42, 153200], [45, 153320], [53, 153800], [55, 154060], [63, 154500], [67, 154640], [75, 155040], [84, 155780], [90, 156580], [94, 156840], [105, 157520], [113, 157880], [120, 158420], [124, 158780], [130, 159160], [133, 159380], [137, 159500], [145, 160140], [150, 160760], [157, 161825], [159, 161968], [162, 162068], [167, 162448], [170, 162588], [177, 162968], [179, 163268], [183, 163428], [189, 164334], [193, 164434], [195, 164534]]}, {"verse": 20, "start": 165749, "end": 172447, "text": "Y cuando hubo dicho esto, les mostró las manos y el costado. Y los discípulos se gozaron viendo al Señor.", "words": [[0, 165749], [2, 165851], [9, 166071], [14, 166511], [20, 166731], [26, 167111], [30, 167471], [37, 167951], [41, 168091], [47, 168491], [49, 168711], [52, 168831], [61, 169793], [63, 169898], [67, 170038], [78, 170698], [81, 170878], [89, 171318], [96, 171618], [99, 171858]]}, {"verse": 21, "start": 172797, "end": 180472, "text": "Entonces les dijo Jesús otra vez: Paz a vosotros; como me envió el Padre, así también yo os envío.", "words": [[0, 172797], [9, 173324], [13, 174084], [18, 174424], [24, 174724], [29, 175164], [34, 176136], [38, 176316], [40, 176476], [50, 177280], [55, 177449], [58, 177649], [64, 177909], [67, 178029], [74, 178729], [78, 178909], [86, 179329], [89, 179629], [92, 179809]]}, {"verse": 22, "start": 180822, "end": 185760, "text": "Y cuando hubo dicho esto, sopló, y les dijo: Recibid el Espíritu Santo:", "words": [[0, 180822], [2, 180927], [9, 181147], [14, 181527], [20, 181747], [26, 182147], [33, 182687], [35, 182987], [39, 183107], [45, 184037], [53, 184297], [56, 184637], [65, 185177]]}, {"verse": 23, "start": 186110, "end": 192697, "text": "A los que perdonáis los pecados, les son perdonados: a quienes los retenéis, serán retenidos.", "words": [[0, 186110], [2, 186231], [6, 186351], [10, 186451], [20, 187011], [24, 187171], [33, 188171], [37, 188431], [41, 188691], [53, 189892], [55, 190072], [63, 190212], [67, 190472], [77, 191032], [83, 191752]]}, {"verse": 24, "start": 193047, "end": 199018, "text": "Pero Tomás, uno de los doce, que se dice el Dídimo, no estaba con ellos cuando Jesús vino.", "words": [[0, 193047], [5, 193189], [12, 193609], [16, 193889], [19, 194049], [23, 194189], [29, 195029], [33, 195109], [36, 195269], [41, 195569], [44, 195769], [52, 196609], [55, 196729], [62, 197029], [66, 197309], [72, 197489], [79, 197809], [85, 198189]]}, {"verse": 25, "start": 199368, "end": 212719, "text": "Le dijeron pues los otros discípulos: Al Señor hemos visto. Y él les dijo: Si no veo en sus manos la señal de los clavos, y meto mi dedo en el lugar de los clavos, y meto mi mano en su costado, no creeré.", "words": [[0, 199368], [3, 199490], [11, 199969], [16, 200129], [20, 200310], [26, 200650], [38, 201818], [41, 201963], [47, 202243], [53, 202483], [60, 203367], [62, 203573], [65, 203753], [69, 204053], [75, 204850], [78, 204946], [81, 205086], [85, 205306], [88, 205486], [92, 205626], [98, 205966], [101, 206206], [107, 206626], [110, 206686], [114, 206826], [122, 207366], [124, 207766], [129, 208126], [132, 208286], [137, 208566], [140, 208646], [143, 208746], [149, 208986], [152, 209186], [156, 209306], [164, 209886], [166, 210306], [171, 210666], [174, 210806], [179, 211006], [182, 211166], [185, 211286], [194, 211786], [197, 212106]]}, {"verse": 26, "start": 212999, "end": 225297, "text": "Y ocho días después, estaban otra vez sus discípulos dentro, y con ellos Tomás. Vino Jesús, las puertas cerradas, y se puso en medio, y dijo: Paz a vosotros.", "words": [[0, 212999], [2, 213165], [7, 213505], [12, 213705], [21, 214785], [29, 215285], [34, 215645], [38, 216005], [42, 216425], [53, 217085], [61, 217465], [63, 217805], [67, 217985], [73, 218205], [80, 219235], [85, 219481], [92, 219861], [96, 220341], [104, 220741], [114, 221341], [116, 221841], [119, 221961], [124, 222301], [127, 222461], [134, 222821], [136, 223361], [142, 224236], [146, 224416], [148, 224516]]}, {"verse": 27, "start": 225647, "end": 235789, "text": "Luego dice a Tomás: Mete tu dedo aquí, y ve mis manos: y alarga acá tu mano, y métela en mi costado: y no seas incrédulo, sino creyente.", "words": [[0, 225647], [6, 225933], [11, 226113], [13, 226293], [20, 227212], [25, 227498], [28, 227758], [33, 228058], [39, 228238], [41, 228478], [44, 228598], [48, 228738], [55, 229559], [57, 229799], [64, 230259], [68, 230539], [71, 230699], [77, 231019], [79, 231419], [86, 231899], [89, 232059], [92, 232199], [101, 233163], [103, 233270], [106, 233370], [111, 233650], [122, 234770], [127, 234950]]}, {"verse": 28, "start": 236139, "end": 240878, "text": "Entonces Tomás respondió, y le dijo: ¡Señor mío, y Dios mío!", "words": [[0, 236139], [9, 236567], [15, 237107], [26, 238007], [28, 238567], [31, 238667], [37, 239351], [44, 239635], [49, 240095], [51, 240195], [56, 240375]]}, {"verse": 29, "start": 241158, "end": 248884, "text": "Le dice Jesús: Porque me has visto, Tomás, creíste: bienaventurados los que no vieron y creyeron.", "words": [[0, 241158], [3, 241304], [8, 241604], [15, 242735], [22, 242885], [25, 243025], [29, 243185], [36, 244105], [43, 244695], [52, 246207], [68, 246698], [72, 246958], [76, 247118], [79, 247318], [86, 247698], [88, 248312]]}, {"verse": 30, "start": 249234, "end": 256639, "text": "Y también hizo Jesús muchas otras señales en presencia de sus discípulos, que no están escritas en este libro.", "words": [[0, 249234], [2, 249342], [10, 249642], [15, 249922], [21, 250422], [28, 251042], [34, 251382], [42, 252042], [45, 252222], [55, 252862], [58, 253042], [62, 253242], [74, 254002], [78, 254622], [81, 254782], [87, 255022], [96, 255642], [99, 255802], [104, 256249]]}, {"verse": 31, "start": 256989, "end": 266275, "text": "Pero estas han sido escritas, para que creáis que Jesús es el Cristo, el Hijo de Dios; y para que creyendo, tengáis vida en su nombre.", "words": [[0, 256989], [5, 257153], [11, 257653], [15, 257813], [20, 258113], [30, 258913], [35, 259373], [39, 259553], [46, 260033], [50, 260233], [56, 260573], [59, 260893], [62, 261093], [70, 261713], [73, 261793], [78, 262053], [81, 262213], [87, 262943], [89, 263068], [94, 263248], [98, 263428], [108, 264088], [116, 264988], [121, 265308], [124, 265528], [127, 265688]]}]}