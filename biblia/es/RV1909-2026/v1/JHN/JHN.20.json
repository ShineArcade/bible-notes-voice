{"book": "JHN", "chapter": 20, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 281868, "verses": [{"verse": 1, "start": 300, "end": 11179, "text": "Y el primer día de la semana, María Magdalena vino de mañana, siendo aún oscuro, al sepulcro; y vio la piedra quitada del sepulcro.", "words": [[0, 300], [2, 441], [5, 601], [12, 1001], [16, 1401], [19, 1541], [22, 1681], [30, 2781], [36, 3221], [46, 4061], [51, 4281], [54, 4501], [62, 4961], [69, 5421], [73, 5801], [81, 6861], [84, 7361], [94, 8560], [96, 8682], [100, 8902], [103, 9042], [110, 9582], [118, 10082], [122, 10342]]}, {"verse": 2, "start": 11629, "end": 23667, "text": "Entonces corrió, y vino a Simón Pedro, y al otro discípulo, al cual amaba Jesús, y les dice: Han llevado al Señor del sepulcro, y no sabemos dónde le han puesto.", "words": [[0, 11629], [9, 12493], [17, 13153], [19, 13473], [24, 13753], [26, 13953], [32, 14293], [39, 14733], [41, 15413], [44, 15533], [49, 15773], [60, 16453], [63, 17133], [68, 17213], [74, 17613], [81, 18513], [83, 18573], [87, 18713], [93, 19501], [97, 19641], [105, 20061], [108, 20201], [114, 20481], [118, 20681], [128, 21361], [130, 21821], [133, 21961], [141, 22321], [147, 22641], [150, 22881], [154, 23001]]}, {"verse": 3, "start": 24017, "end": 28522, "text": "Y salió Pedro, y el otro discípulo, y vinieron al sepulcro.", "words": [[0, 24017], [2, 24161], [8, 24481], [15, 24881], [17, 25121], [20, 25241], [25, 25441], [36, 26201], [38, 26751], [47, 27301], [50, 27601]]}, {"verse": 4, "start": 28972, "end": 36023, "text": "Y corrían los dos juntos; pero el otro discípulo corrió más aprisa que Pedro, y llegó primero al sepulcro.", "words": [[0, 28972], [2, 29079], [10, 29539], [14, 29739], [18, 29899], [26, 30803], [31, 31227], [34, 31387], [39, 31547], [49, 32167], [56, 32567], [60, 32907], [67, 33247], [71, 33407], [78, 33787], [80, 34387], [86, 34627], [94, 35067], [97, 35287]]}, {"verse": 5, "start": 36473, "end": 41623, "text": "Y bajándose a mirar, vio las telas de lino allí puestas; pero no entró.", "words": [[0, 36473], [2, 36660], [12, 37240], [14, 37360], [21, 38140], [25, 38420], [29, 38600], [35, 39000], [38, 39120], [43, 39440], [48, 39600], [57, 40715], [62, 40879], [65, 41079]]}, {"verse": 6, "start": 42073, "end": 49452, "text": "Llegó luego Simón Pedro siguiéndole, y entró en el sepulcro, y vio las telas de lino allí puestas,", "words": [[0, 42073], [6, 42460], [12, 42720], [18, 43340], [24, 43740], [37, 44600], [39, 45040], [45, 45540], [48, 45680], [51, 45800], [61, 46520], [63, 47020], [67, 47200], [71, 47400], [77, 47840], [80, 47960], [85, 48280], [90, 48480]]}, {"verse": 7, "start": 49902, "end": 57656, "text": "Y el paño que había estado sobre su cabeza, no puesto con las telas de lino, sino enrollado en un lugar aparte.", "words": [[0, 49902], [2, 50028], [5, 50148], [10, 50728], [14, 50928], [20, 51148], [27, 51548], [33, 51988], [36, 52208], [44, 52668], [47, 53208], [54, 53568], [58, 53888], [62, 54048], [68, 54388], [71, 54488], [77, 54888], [82, 55328], [92, 56288], [95, 56448], [98, 56568], [104, 56908]]}, {"verse": 8, "start": 58106, "end": 64800, "text": "Y entonces entró también el otro discípulo, que había venido primero al sepulcro, y vio, y creyó.", "words": [[0, 58106], [2, 58228], [11, 58608], [17, 59228], [25, 59468], [28, 59728], [33, 59928], [44, 60588], [48, 60768], [54, 60968], [61, 61368], [69, 61748], [72, 61988], [82, 62708], [84, 63328], [89, 63628], [91, 64208]]}, {"verse": 9, "start": 65250, "end": 71905, "text": "Porque aún no sabían la Escritura, que era necesario que él resucitase de los muertos.", "words": [[0, 65250], [7, 65515], [11, 65855], [14, 66075], [21, 66495], [24, 66655], [35, 67535], [39, 67775], [43, 67955], [53, 68755], [57, 69355], [60, 69675], [71, 70775], [74, 70935], [78, 71075]]}, {"verse": 10, "start": 72355, "end": 74718, "text": "Y volvieron los discípulos a los suyos.", "words": [[0, 72355], [2, 72475], [12, 72935], [16, 73095], [27, 73715], [29, 73875], [33, 74015]]}, {"verse": 11, "start": 75168, "end": 82137, "text": "Pero María estaba fuera llorando junto al sepulcro: y estando llorando, se inclinó para mirar el sepulcro;", "words": [[0, 75168], [5, 75289], [11, 75549], [18, 75869], [24, 76189], [33, 76769], [39, 77049], [42, 77389], [52, 78486], [54, 78591], [62, 78951], [72, 79831], [75, 80071], [83, 80611], [88, 80811], [94, 81211], [97, 81351]]}, {"verse": 12, "start": 82587, "end": 92307, "text": "Y vio dos ángeles en ropas blancas que estaban sentados, el uno a la cabecera, y el otro a los pies, donde el cuerpo de Jesús había sido puesto.", "words": [[0, 82587], [2, 82723], [6, 82943], [10, 83143], [18, 83723], [21, 83963], [27, 84343], [35, 84883], [39, 85003], [47, 85303], [57, 86403], [60, 86543], [64, 86763], [66, 86903], [69, 86983], [79, 87603], [81, 88043], [84, 88163], [89, 88383], [91, 88523], [95, 88643], [101, 89223], [107, 89503], [110, 89823], [117, 90203], [120, 90443], [126, 90803], [132, 91223], [137, 91583]]}, {"verse": 13, "start": 92757, "end": 100101, "text": "Y le dijeron: Mujer, ¿por qué lloras? Les dice: Porque se han llevado a mi Señor, y no sé dónde le han puesto.", "words": [[0, 92757], [2, 92923], [5, 93003], [14, 94009], [21, 94574], [26, 94694], [30, 94874], [38, 95807], [42, 95907], [48, 96677], [55, 96871], [58, 97051], [62, 97191], [70, 97591], [72, 97611], [75, 97751], [82, 98191], [84, 98671], [87, 98811], [90, 98991], [96, 99171], [99, 99391], [103, 99491]]}, {"verse": 14, "start": 100451, "end": 108480, "text": "Y cuando hubo dicho esto, se volvió atrás, y vio a Jesús que estaba allí; pero no sabía que era Jesús.", "words": [[0, 100451], [2, 100555], [9, 100795], [14, 101215], [20, 101435], [26, 101835], [29, 102555], [36, 102995], [43, 103375], [45, 104155], [49, 104435], [51, 104555], [57, 104895], [61, 105415], [68, 105675], [74, 106499], [79, 107002], [82, 107162], [88, 107542], [92, 107682], [96, 107822]]}, {"verse": 15, "start": 108930, "end": 122071, "text": "Le dice Jesús: Mujer, ¿por qué lloras? ¿a quién buscas? Ella, pensando que era el jardinero, le dice: Señor, si tú lo has llevado, dime dónde lo has puesto, y yo lo llevaré.", "words": [[0, 108930], [3, 109052], [8, 109352], [15, 110425], [22, 110490], [27, 110555], [31, 110620], [39, 111631], [42, 111796], [48, 112283], [56, 113019], [62, 113223], [71, 113723], [75, 114023], [79, 114203], [82, 114323], [93, 115283], [96, 115543], [102, 116331], [109, 117050], [112, 117090], [115, 117270], [118, 117450], [122, 117610], [131, 118750], [136, 118930], [142, 119210], [145, 119450], [149, 119570], [157, 119970], [159, 120430], [162, 120610], [165, 120730]]}, {"verse": 16, "start": 122421, "end": 130802, "text": "Le dice Jesús: ¡María! Volviéndose ella, le dice: ¡Raboni! que quiere decir, Maestro.", "words": [[0, 122421], [3, 122543], [8, 122843], [15, 123888], [23, 124783], [35, 125775], [41, 126155], [44, 126395], [50, 128017], [59, 129119], [63, 129221], [70, 129541], [77, 129881]]}, {"verse": 17, "start": 131252, "end": 144910, "text": "Le dice Jesús: No me toques: porque aún no he subido a mi Padre: pero ve a mis hermanos, y diles: Subo a mi Padre y a vuestro Padre, a mi Dios y a vuestro Dios.", "words": [[0, 131252], [3, 131375], [8, 131675], [15, 132720], [18, 132862], [21, 132982], [29, 133912], [36, 134149], [40, 134549], [43, 134829], [46, 134929], [53, 135369], [55, 135469], [58, 135589], [65, 136477], [70, 136699], [73, 136879], [75, 136979], [79, 137119], [89, 137875], [91, 138632], [98, 139688], [103, 140190], [105, 140310], [108, 140390], [114, 141050], [116, 141210], [118, 141310], [126, 141590], [133, 142510], [135, 142590], [138, 142710], [143, 143010], [145, 143690], [147, 143810], [155, 144270]]}, {"verse": 18, "start": 145360, "end": 154158, "text": "fue María Magdalena dando la noticia a los discípulos de que había visto al Señor, y que él le había dicho estas cosas.", "words": [[0, 145360], [4, 145567], [10, 145907], [20, 146667], [26, 146987], [29, 147227], [37, 147927], [39, 148187], [43, 148347], [54, 149407], [57, 149927], [61, 150067], [67, 150307], [73, 150687], [76, 150887], [83, 151227], [85, 151767], [89, 151947], [92, 152187], [95, 152587], [101, 152827], [107, 153167], [113, 153407]]}, {"verse": 19, "start": 154608, "end": 170371, "text": "Y como fue tarde aquel día, el primero de la semana, y estando las puertas cerradas donde los discípulos estaban juntos por miedo de los judíos, vino Jesús, y se puso en medio, y les dijo: Paz a vosotros.", "words": [[0, 154608], [2, 154752], [7, 155032], [11, 155312], [17, 155752], [23, 156392], [28, 157252], [31, 157412], [39, 157832], [42, 158012], [45, 158132], [53, 158612], [55, 158872], [63, 159312], [67, 159452], [75, 159852], [84, 160592], [90, 161392], [94, 161652], [105, 162332], [113, 162692], [120, 163232], [124, 163592], [130, 163972], [133, 164192], [137, 164312], [145, 164952], [150, 165572], [157, 166717], [159, 166860], [162, 166960], [167, 167340], [170, 167480], [177, 167860], [179, 168160], [183, 168320], [189, 169306], [193, 169406], [195, 169506]]}, {"verse": 20, "start": 170821, "end": 177599, "text": "Y cuando hubo dicho esto, les mostró las manos y el costado. Y los discípulos se gozaron viendo al Señor.", "words": [[0, 170821], [2, 170923], [9, 171143], [14, 171583], [20, 171803], [26, 172183], [30, 172543], [37, 173023], [41, 173163], [47, 173563], [49, 173783], [52, 173903], [61, 174945], [63, 175050], [67, 175190], [78, 175850], [81, 176030], [89, 176470], [96, 176770], [99, 177010]]}, {"verse": 21, "start": 178049, "end": 185884, "text": "Entonces les dijo Jesús otra vez: Paz a vosotros; como me envió el Padre, así también yo os envío.", "words": [[0, 178049], [9, 178576], [13, 179336], [18, 179676], [24, 179976], [29, 180416], [34, 181468], [38, 181648], [40, 181808], [50, 182692], [55, 182861], [58, 183061], [64, 183321], [67, 183441], [74, 184141], [78, 184321], [86, 184741], [89, 185041], [92, 185221]]}, {"verse": 22, "start": 186334, "end": 191353, "text": "Y cuando hubo dicho esto, sopló, y les dijo: Recibid el Espíritu Santo:", "words": [[0, 186334], [2, 186439], [9, 186659], [14, 187039], [20, 187259], [26, 187659], [33, 188199], [35, 188499], [39, 188619], [45, 189629], [53, 189889], [56, 190229], [65, 190769]]}, {"verse": 23, "start": 191802, "end": 198469, "text": "A los que perdonáis los pecados, les son perdonados: a quienes los retenéis, serán retenidos.", "words": [[0, 191802], [2, 191923], [6, 192043], [10, 192143], [20, 192703], [24, 192863], [33, 193863], [37, 194123], [41, 194383], [53, 195664], [55, 195844], [63, 195984], [67, 196244], [77, 196804], [83, 197524]]}, {"verse": 24, "start": 198919, "end": 204890, "text": "Pero Tomás, uno de los doce, que se dice el Dídimo, no estaba con ellos cuando Jesús vino.", "words": [[0, 198919], [5, 199061], [12, 199481], [16, 199761], [19, 199921], [23, 200061], [29, 200901], [33, 200981], [36, 201141], [41, 201441], [44, 201641], [52, 202481], [55, 202601], [62, 202901], [66, 203181], [72, 203361], [79, 203681], [85, 204061]]}, {"verse": 25, "start": 205340, "end": 223921, "text": "Le dijeron pues los otros discípulos: Al Señor hemos visto. Y él les dijo: Si no veo en sus manos la señal de los clavos, y meto mi dedo en el lugar de los clavos, y meto mi mano en su costado, no creeré.", "words": [[0, 205340], [3, 205467], [11, 205987], [16, 206207], [20, 206647], [26, 206967], [38, 212899], [41, 213044], [47, 213324], [53, 213564], [60, 214519], [62, 214725], [65, 214905], [69, 215205], [75, 216051], [78, 216148], [81, 216288], [85, 216508], [88, 216688], [92, 216828], [98, 217168], [101, 217408], [107, 217828], [110, 217888], [114, 218028], [122, 218568], [124, 218968], [129, 219328], [132, 219488], [137, 219768], [140, 219848], [143, 219948], [149, 220188], [152, 220388], [156, 220508], [164, 221088], [166, 221508], [171, 221868], [174, 222008], [179, 222208], [182, 222368], [185, 222488], [194, 222988], [197, 223308]]}, {"verse": 26, "start": 224271, "end": 236459, "text": "Y ocho días después, estaban otra vez sus discípulos dentro, y con ellos Tomás. Vino Jesús, las puertas cerradas, y se puso en medio, y dijo: Paz a vosotros.", "words": [[0, 224271], [2, 224438], [7, 224778], [12, 224918], [21, 225918], [29, 226378], [34, 226598], [38, 226938], [42, 227338], [53, 228038], [61, 228378], [63, 228978], [67, 229198], [73, 229358], [80, 230362], [85, 230627], [92, 230967], [96, 231407], [104, 231807], [114, 232387], [116, 232907], [119, 233047], [124, 233407], [127, 233547], [134, 233967], [136, 234447], [142, 235394], [146, 235494], [148, 235594]]}, {"verse": 27, "start": 236909, "end": 247665, "text": "Luego dice a Tomás: Mete tu dedo aquí, y ve mis manos: y alarga acá tu mano, y métela en mi costado: y no seas incrédulo, sino creyente.", "words": [[0, 236909], [6, 237296], [11, 237836], [13, 238076], [20, 238929], [25, 239214], [28, 239474], [33, 239774], [39, 239954], [41, 240194], [44, 240314], [48, 240454], [55, 241356], [57, 241596], [64, 242056], [68, 242336], [71, 242496], [77, 242816], [79, 243216], [86, 243696], [89, 243856], [92, 243996], [101, 245039], [103, 245146], [106, 245246], [111, 245526], [122, 246646], [127, 246826]]}, {"verse": 28, "start": 248115, "end": 254682, "text": "Entonces Tomás respondió, y le dijo: ¡Señor mío, y Dios mío!", "words": [[0, 248115], [9, 248543], [15, 249083], [26, 249983], [28, 250543], [31, 250643], [37, 251377], [44, 251662], [49, 252122], [51, 252222], [56, 252402]]}, {"verse": 29, "start": 255032, "end": 262896, "text": "Le dice Jesús: Porque me has visto, Tomás, creíste: bienaventurados los que no vieron y creyeron.", "words": [[0, 255032], [3, 255154], [8, 255454], [15, 256499], [22, 256703], [25, 256853], [29, 257003], [36, 257763], [43, 258583], [52, 260134], [68, 260614], [72, 260834], [76, 261014], [79, 261214], [86, 261674], [88, 261934]]}, {"verse": 30, "start": 263346, "end": 271149, "text": "Y también hizo Jesús muchas otras señales en presencia de sus discípulos, que no están escritas en este libro.", "words": [[0, 263346], [2, 263472], [10, 263852], [15, 264312], [21, 264732], [28, 265252], [34, 265692], [42, 266392], [45, 266592], [55, 267312], [58, 267512], [62, 267772], [74, 268652], [78, 269132], [81, 269312], [87, 269552], [96, 270232], [99, 270392], [104, 270592]]}, {"verse": 31, "start": 271599, "end": 281468, "text": "Pero estas han sido escritas, para que creáis que Jesús es el Cristo, el Hijo de Dios; y para que creyendo, tengáis vida en su nombre.", "words": [[0, 271599], [5, 271764], [11, 272004], [15, 272264], [20, 272504], [30, 273284], [35, 273804], [39, 273984], [46, 274464], [50, 274604], [56, 274964], [59, 275344], [62, 275444], [70, 276504], [73, 276604], [78, 276864], [81, 277004], [87, 277925], [89, 278032], [94, 278212], [98, 278372], [108, 279092], [116, 280072], [121, 280432], [124, 280632], [127, 280812]]}]}