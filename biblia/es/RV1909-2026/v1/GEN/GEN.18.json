{"book": "GEN", "chapter": 18, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 309099, "verses": [{"verse": 1, "start": 300, "end": 7903, "text": "Y le apareció Jehová en el valle de Mamre, estando él sentado a la puerta de su tienda en el calor del día.", "words": [[0, 300], [2, 464], [5, 584], [14, 1204], [21, 1724], [24, 1864], [27, 2004], [33, 2264], [36, 2864], [43, 3464], [51, 4004], [54, 4224], [62, 4844], [64, 4944], [67, 5044], [74, 5344], [77, 5624], [80, 5824], [87, 6324], [90, 6484], [93, 6624], [99, 7004], [103, 7284]]}, {"verse": 2, "start": 8353, "end": 20544, "text": "Y alzó sus ojos y miró, y he aquí tres varones que estaban junto a él: y cuando los vio, salió corriendo de la puerta de su tienda a recibirlos, y se inclinó hacia la tierra,", "words": [[0, 8353], [2, 8458], [7, 8798], [11, 8978], [16, 9258], [18, 9498], [24, 10298], [26, 10528], [29, 10758], [34, 11018], [39, 11418], [47, 12118], [51, 12318], [59, 12598], [65, 12978], [67, 13158], [71, 13799], [73, 13902], [80, 14102], [84, 14342], [89, 14622], [95, 15022], [105, 15602], [108, 15762], [111, 15862], [118, 16162], [121, 16422], [124, 16562], [131, 16962], [133, 17102], [145, 17962], [147, 18382], [150, 18542], [158, 19322], [164, 19562], [167, 19822]]}, {"verse": 3, "start": 20994, "end": 27020, "text": "Y dijo: Señor, si ahora he hallado gracia en tus ojos, te ruego que no pases de tu siervo.", "words": [[0, 20994], [2, 21123], [8, 21895], [15, 22842], [18, 22942], [24, 23202], [27, 23362], [35, 23702], [42, 24122], [45, 24182], [49, 24322], [55, 25142], [58, 25222], [64, 25502], [68, 25682], [71, 25842], [77, 26222], [80, 26342], [83, 26462]]}, {"verse": 4, "start": 27470, "end": 32775, "text": "Que se traiga ahora un poco de agua, y lavad vuestros pies; y recostaos debajo de un árbol,", "words": [[0, 27470], [4, 27549], [7, 27669], [14, 28029], [20, 28229], [23, 28369], [28, 28549], [31, 28749], [37, 29029], [39, 29349], [45, 29669], [54, 30089], [60, 30876], [62, 31222], [72, 31601], [79, 32002], [82, 32161], [85, 32241]]}, {"verse": 5, "start": 33225, "end": 43582, "text": "Y traeré un bocado de pan, y recobrad fuerzas; después pasaréis: porque por eso habéis pasado cerca de vuestro siervo. Y ellos dijeron: Haz así como has dicho.", "words": [[0, 33225], [2, 33331], [9, 33731], [12, 33831], [19, 34211], [22, 34351], [27, 34651], [29, 35161], [38, 35671], [47, 36710], [55, 36951], [65, 38076], [72, 38240], [76, 38460], [80, 38620], [87, 38920], [94, 39280], [100, 39540], [103, 39780], [111, 40060], [119, 40951], [121, 41117], [127, 41297], [136, 42340], [140, 42522], [144, 42742], [149, 42942], [153, 43122]]}, {"verse": 6, "start": 43932, "end": 54775, "text": "Entonces Abraham fue de prisa a la tienda a Sara, y le dijo: Toma pronto tres medidas de harina fina, amasa y haz panes cocidos debajo del rescoldo.", "words": [[0, 43932], [9, 44417], [17, 45097], [21, 45497], [24, 45637], [30, 46177], [32, 46397], [35, 46477], [42, 46837], [44, 47197], [50, 47557], [52, 48277], [55, 48417], [61, 49206], [66, 49464], [73, 49724], [78, 50104], [86, 50524], [89, 50724], [96, 51004], [102, 51704], [108, 52124], [110, 52411], [114, 52697], [120, 52984], [128, 53524], [135, 53924], [139, 54104]]}, {"verse": 7, "start": 55125, "end": 64044, "text": "Y corrió Abraham a las vacas, y tomó un becerro tierno y bueno, y lo dio al mozo, y se dio este prisa a prepararlo.", "words": [[0, 55125], [2, 55245], [9, 55725], [17, 56405], [19, 56645], [23, 56805], [30, 57565], [32, 57745], [37, 58125], [40, 58265], [48, 58845], [55, 59445], [57, 59545], [64, 59905], [66, 60485], [69, 60645], [73, 60805], [76, 60985], [82, 61445], [84, 62145], [87, 62305], [91, 62525], [96, 62705], [102, 63125], [104, 63265]]}, {"verse": 8, "start": 64494, "end": 75529, "text": "Tomó también mantequilla y leche, y el becerro que había preparado, y lo puso delante de ellos; y él estaba junto a ellos debajo del árbol; y comieron.", "words": [[0, 64494], [5, 64798], [13, 65058], [25, 65938], [27, 66058], [34, 66438], [36, 67038], [39, 67198], [47, 67758], [51, 67898], [57, 68158], [68, 68918], [70, 69318], [73, 69458], [78, 69838], [86, 70318], [89, 70518], [96, 71441], [98, 71753], [101, 71913], [108, 72193], [114, 72553], [116, 72793], [122, 72973], [129, 73433], [133, 73653], [140, 74559], [142, 74684]]}, {"verse": 9, "start": 75979, "end": 82552, "text": "Y le dijeron: ¿Dónde está Sara tu mujer? Y él respondió: Aquí en la tienda.", "words": [[0, 75979], [2, 76099], [5, 76179], [14, 77325], [21, 77638], [26, 77984], [31, 78331], [34, 78531], [41, 79481], [43, 79673], [46, 79793], [57, 81058], [62, 81538], [65, 81738], [68, 81878]]}, {"verse": 10, "start": 83002, "end": 95118, "text": "Entonces dijo: De cierto volveré a ti según el tiempo de la vida, y he aquí, tendrá un hijo Sara tu mujer. Y Sara escuchaba a la puerta de la tienda, que estaba detrás de él.", "words": [[0, 83002], [9, 83587], [15, 84800], [18, 85006], [25, 85213], [33, 85853], [35, 85953], [38, 86113], [44, 86413], [47, 86673], [54, 87013], [57, 87193], [60, 87313], [66, 87953], [68, 88013], [71, 88153], [77, 88933], [84, 89533], [87, 89713], [92, 90053], [97, 90333], [100, 90473], [107, 91279], [109, 91390], [114, 91630], [124, 92350], [126, 92490], [129, 92590], [136, 92850], [139, 93130], [142, 93250], [150, 93650], [154, 93850], [161, 94150], [168, 94610], [171, 94770]]}, {"verse": 11, "start": 95568, "end": 102796, "text": "Y Abraham y Sara eran ancianos, de edad avanzada: Sara ya había dejado de menstruar.", "words": [[0, 95568], [2, 95869], [10, 96169], [12, 96549], [17, 96929], [22, 97329], [32, 98589], [35, 98729], [40, 99049], [50, 100297], [55, 100603], [58, 100883], [64, 101243], [71, 101823], [74, 101983]]}, {"verse": 12, "start": 103246, "end": 111970, "text": "Se rio, pues, Sara entre sí, diciendo: ¿Después que he envejecido tendré deleite, siendo también mi señor ya viejo?", "words": [[0, 103415], [3, 103615], [8, 103815], [14, 104435], [19, 104775], [25, 105035], [29, 105835], [39, 106795], [48, 107195], [52, 107535], [55, 107715], [66, 108435], [73, 109055], [82, 109675], [89, 110155], [97, 110595], [100, 110815], [106, 111155], [109, 111415]]}, {"verse": 13, "start": 112320, "end": 120688, "text": "Entonces Jehová dijo a Abraham: ¿Por qué se ha reído Sara diciendo: Será cierto que he de parir siendo ya vieja?", "words": [[0, 112320], [9, 113306], [16, 113906], [21, 114086], [23, 114266], [32, 115379], [37, 115483], [41, 115703], [44, 115903], [47, 116043], [53, 116363], [58, 116643], [68, 118012], [73, 118361], [80, 118621], [84, 118921], [87, 119081], [90, 119161], [96, 119541], [103, 119841], [106, 120101]]}, {"verse": 14, "start": 120988, "end": 128851, "text": "¿Hay para Dios alguna cosa difícil? Al tiempo señalado volveré a ti, según el tiempo de la vida, y Sara tendrá un hijo.", "words": [[0, 120988], [5, 121192], [10, 121392], [15, 121612], [22, 121972], [27, 122292], [36, 123596], [39, 123729], [46, 124029], [55, 124689], [63, 125209], [65, 125269], [69, 125669], [75, 125889], [78, 126069], [85, 126329], [88, 126489], [91, 126589], [97, 127089], [99, 127309], [104, 127589], [111, 128089], [114, 128209]]}, {"verse": 15, "start": 129201, "end": 140778, "text": "Entonces Sara negó diciendo: No me reí; porque tuvo miedo. Y él dijo: No es así, sino que te has reído.", "words": [[0, 129201], [9, 129856], [14, 130546], [19, 131006], [29, 131921], [32, 132148], [35, 132228], [40, 133051], [47, 133253], [52, 133513], [59, 137193], [61, 137382], [64, 137542], [70, 138310], [73, 138492], [76, 138752], [81, 139072], [86, 139332], [90, 139532], [93, 139712], [97, 139912]]}, {"verse": 16, "start": 141128, "end": 148729, "text": "Y los varones se levantaron de allí, y miraron hacia Sodoma: y Abraham iba con ellos acompañándolos.", "words": [[0, 141128], [2, 141290], [6, 141410], [14, 141830], [17, 142010], [28, 142570], [31, 142770], [37, 143030], [39, 143530], [47, 144090], [53, 144470], [61, 145580], [63, 145728], [71, 146148], [75, 146708], [79, 146988], [85, 147188]]}, {"verse": 17, "start": 149179, "end": 153306, "text": "Y Jehová dijo: ¿Encubriré yo a Abraham lo que voy a hacer,", "words": [[0, 149179], [2, 149524], [9, 149903], [15, 150463], [26, 151086], [29, 151286], [31, 151546], [39, 151846], [42, 152046], [46, 152166], [50, 152346], [52, 152546]]}, {"verse": 18, "start": 153756, "end": 160860, "text": "Habiendo de ser Abraham una nación grande y fuerte, y habiendo de ser benditas en él todas las naciones de la tierra?", "words": [[0, 153756], [9, 154101], [12, 154261], [16, 154481], [24, 154841], [28, 155201], [35, 155581], [42, 156001], [44, 156121], [52, 156881], [54, 157101], [63, 157401], [66, 157581], [70, 157741], [79, 158341], [82, 158541], [85, 158661], [91, 158941], [95, 159261], [104, 159701], [107, 159901], [110, 160001]]}, {"verse": 19, "start": 161310, "end": 175526, "text": "Porque yo lo he conocido, sé que mandará a sus hijos y a su casa después de sí, que guarden el camino de Jehová, haciendo justicia y juicio, para que haga venir Jehová sobre Abraham lo que ha hablado acerca de él.", "words": [[0, 161310], [7, 161475], [10, 161695], [13, 161835], [16, 161935], [26, 163015], [29, 163235], [33, 163375], [41, 163795], [43, 163935], [47, 164095], [53, 164435], [55, 164615], [57, 164655], [60, 164775], [65, 165095], [73, 165475], [76, 165675], [80, 165955], [84, 166395], [92, 166895], [95, 166995], [102, 167315], [105, 167535], [113, 168275], [122, 168655], [131, 169515], [133, 169615], [141, 170768], [146, 170928], [150, 171108], [155, 171288], [161, 171548], [168, 172128], [174, 172368], [182, 173148], [185, 173548], [189, 173728], [192, 173888], [200, 174288], [207, 174608], [210, 174948]]}, {"verse": 20, "start": 175876, "end": 185943, "text": "Entonces Jehová le dijo: Por cuanto el clamor de Sodoma y Gomorra se aumenta más y más, y el pecado de ellos se ha agravado en extremo,", "words": [[0, 175876], [9, 176523], [16, 177503], [19, 177563], [25, 178357], [29, 178501], [36, 178801], [39, 178941], [46, 179381], [49, 179521], [56, 179981], [58, 180061], [66, 180601], [69, 181021], [77, 181521], [81, 181821], [83, 181941], [88, 182201], [90, 182861], [93, 182981], [100, 183401], [103, 183601], [109, 183861], [112, 184341], [115, 184481], [124, 184961], [127, 185081]]}, {"verse": 21, "start": 186393, "end": 194049, "text": "Descenderé ahora, y veré si han consumado su obra según el clamor que ha venido hasta mí; y si no, lo sabré.", "words": [[0, 186393], [11, 187090], [18, 187430], [20, 187770], [25, 188110], [28, 188370], [32, 188530], [42, 189210], [45, 189390], [50, 189670], [56, 190010], [59, 190230], [66, 190690], [70, 190830], [73, 190950], [80, 191310], [86, 191550], [90, 192422], [92, 192562], [95, 192722], [99, 193102], [102, 193302]]}, {"verse": 22, "start": 194399, "end": 201759, "text": "Y se apartaron de allí los varones, y fueron hacia Sodoma: pero Abraham estaba aún delante de Jehová.", "words": [[0, 194399], [2, 194527], [5, 194627], [15, 195207], [18, 195387], [23, 195607], [27, 195807], [36, 196327], [38, 196787], [45, 197067], [51, 197367], [59, 198466], [64, 198630], [72, 199270], [79, 200110], [83, 200550], [91, 200990], [94, 201190]]}, {"verse": 23, "start": 202209, "end": 206912, "text": "Y se acercó Abraham y dijo: ¿Destruirás también al justo con el impío?", "words": [[0, 202209], [2, 202527], [5, 202607], [12, 203187], [20, 203767], [22, 203967], [28, 204746], [40, 205284], [48, 205504], [51, 205724], [57, 205944], [61, 206204], [64, 206304]]}, {"verse": 24, "start": 207362, "end": 214797, "text": "Quizá hay cincuenta justos dentro de la ciudad: ¿destruirás también y no perdonarás al lugar por cincuenta justos que estén dentro de él?", "words": [[0, 207362], [6, 207666], [10, 207846], [20, 208026], [27, 208666], [34, 208866], [37, 209106], [40, 209206], [48, 210077], [60, 210659], [68, 211039], [70, 211339], [73, 211459], [84, 212059], [87, 212159], [93, 212379], [97, 212639], [107, 212899], [114, 213599], [118, 213699], [124, 213999], [131, 214279], [134, 214499]]}, {"verse": 25, "start": 215247, "end": 227042, "text": "Lejos de ti el hacer tal, que hagas morir al justo con el impío, y que sea el justo tratado como el impío; nunca tal hagas. El juez de toda la tierra, ¿no ha de hacer lo que es justo?", "words": [[0, 215247], [6, 215568], [9, 215768], [12, 215988], [15, 216248], [21, 216548], [26, 217308], [30, 217488], [36, 217768], [42, 218068], [45, 218168], [51, 218428], [55, 218668], [58, 218788], [65, 219228], [67, 219768], [71, 219868], [75, 220048], [78, 220228], [84, 220448], [92, 220948], [97, 221128], [100, 221228], [107, 222098], [113, 222444], [117, 222624], [124, 223451], [127, 223541], [132, 223861], [135, 223981], [140, 224161], [143, 224341], [151, 225141], [155, 225461], [158, 225621], [161, 225701], [167, 226041], [170, 226221], [174, 226341], [177, 226501]]}, {"verse": 26, "start": 227392, "end": 237269, "text": "Entonces respondió Jehová: Si hallo en Sodoma cincuenta justos dentro de la ciudad, perdonaré a todo este lugar por amor de ellos.", "words": [[0, 227392], [9, 228019], [19, 229359], [27, 230253], [30, 230498], [36, 230748], [39, 230868], [46, 231228], [56, 231588], [63, 232428], [70, 232668], [73, 232948], [76, 233048], [84, 233908], [94, 234588], [96, 234848], [101, 235088], [106, 235428], [112, 235768], [116, 236068], [121, 236308], [124, 236528]]}, {"verse": 27, "start": 237619, "end": 244381, "text": "Y Abraham replicó y dijo: He aquí ahora que he comenzado a hablar a mi Señor, aunque soy polvo y ceniza:", "words": [[0, 237619], [2, 237783], [10, 238223], [18, 239203], [20, 239323], [26, 240109], [29, 240246], [34, 240426], [40, 240666], [44, 240946], [47, 241046], [57, 241686], [59, 241766], [66, 241966], [68, 242106], [71, 242206], [78, 242986], [85, 243126], [89, 243366], [95, 243766], [97, 243846]]}, {"verse": 28, "start": 244831, "end": 254016, "text": "Quizá faltarán de cincuenta justos cinco: ¿destruirás por aquellos cinco toda la ciudad? Y dijo: No la destruiré, si hallo allí cuarenta y cinco.", "words": [[0, 244831], [6, 245116], [15, 245596], [18, 245806], [28, 246016], [35, 246631], [42, 247494], [54, 248039], [58, 248199], [67, 248479], [73, 248859], [78, 249139], [81, 249299], [89, 250105], [91, 250234], [97, 251006], [100, 251191], [103, 251291], [114, 251911], [117, 252171], [123, 252431], [128, 252763], [137, 253096], [139, 253429]]}, {"verse": 29, "start": 254366, "end": 263010, "text": "Y volvió a hablarle, y dijo: Quizá se hallarán allí cuarenta. Y respondió: No lo haré por amor de los cuarenta.", "words": [[0, 254366], [2, 254511], [9, 254931], [11, 255051], [21, 255851], [23, 256271], [29, 257066], [35, 257506], [38, 257726], [47, 258219], [52, 258713], [62, 259521], [64, 259668], [75, 260726], [78, 260953], [81, 261113], [86, 261393], [90, 261533], [95, 261733], [98, 261913], [102, 262033]]}, {"verse": 30, "start": 263360, "end": 272122, "text": "Y dijo: No se enoje ahora mi Señor, si hablo: quizá se hallarán allí treinta. Y respondió: No lo haré si hallo allí treinta.", "words": [[0, 263360], [2, 263489], [8, 264261], [11, 264477], [14, 264677], [20, 265057], [26, 265257], [29, 265417], [36, 265957], [39, 266057], [46, 266947], [52, 267177], [55, 267297], [64, 267657], [69, 268052], [78, 268751], [80, 268898], [91, 269956], [94, 270094], [97, 270234], [102, 270614], [105, 270754], [111, 271034], [116, 271454]]}, {"verse": 31, "start": 272472, "end": 287588, "text": "Y dijo: He aquí ahora que he emprendido el hablar a mi Señor: quizá se hallarán allí veinte. No la destruiré, respondió, por amor de los veinte.", "words": [[0, 272472], [2, 272601], [8, 273427], [11, 273507], [16, 273727], [22, 273987], [26, 274267], [29, 274347], [40, 274847], [43, 274947], [50, 275187], [52, 275307], [55, 275407], [62, 276501], [68, 276751], [71, 276871], [80, 277251], [85, 277451], [93, 278342], [96, 278563], [99, 278703], [110, 283077], [121, 284188], [125, 284364], [130, 284584], [133, 284844], [137, 284984]]}, {"verse": 32, "start": 287938, "end": 302154, "text": "Y volvió a decir: No se enoje ahora mi Señor, si hablo solamente una vez: quizá se hallarán allí diez. No la destruiré, respondió, por amor de los diez.", "words": [[0, 287938], [2, 288043], [9, 288463], [11, 288543], [18, 289330], [21, 289453], [24, 289613], [30, 289893], [36, 290173], [39, 290253], [46, 290973], [49, 291073], [55, 291353], [65, 291613], [69, 292033], [74, 292934], [80, 293124], [83, 293224], [92, 293564], [97, 293959], [103, 294608], [106, 294829], [109, 294969], [120, 299343], [131, 300454], [135, 300620], [140, 300860], [143, 301120], [147, 301260]]}, {"verse": 33, "start": 302504, "end": 308699, "text": "Y Jehová se fue, luego que acabó de hablar a Abraham: y Abraham se volvió a su lugar.", "words": [[0, 302621], [2, 302771], [9, 302921], [12, 303071], [17, 303971], [23, 304211], [27, 304451], [33, 304871], [36, 304971], [43, 305251], [45, 305571], [54, 306587], [56, 306706], [64, 307046], [67, 307386], [74, 307886], [76, 307986], [79, 308126]]}]}