{"book": "1CO", "chapter": 7, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 283095, "verses": [{"verse": 1, "start": 300, "end": 5268, "text": "Now concerning the things of which you wrote to me: It is good for a man not to touch a woman.", "words": [[0, 300], [4, 526], [15, 1066], [19, 1326], [26, 1606], [29, 1786], [35, 1946], [39, 2066], [45, 2246], [48, 2406], [52, 3037], [55, 3141], [58, 3261], [63, 3421], [67, 3621], [69, 3781], [73, 3981], [77, 4421], [80, 4601], [86, 4821], [88, 4921]]}, {"verse": 2, "start": 5718, "end": 11485, "text": "Nevertheless, to avoid fornication, let every man have his own wife, and let every woman have her own husband.", "words": [[0, 5718], [14, 6408], [17, 6548], [23, 6828], [36, 7868], [40, 8008], [46, 8208], [50, 8468], [55, 8708], [59, 8868], [63, 9028], [69, 9688], [73, 9788], [77, 9928], [83, 10128], [89, 10388], [94, 10688], [98, 10808], [102, 10948]]}, {"verse": 3, "start": 11935, "end": 16822, "text": "Let the husband render to the wife due benevolence: and likewise also the wife to the husband.", "words": [[0, 11935], [4, 12075], [8, 12195], [16, 12435], [23, 12835], [26, 13015], [30, 13135], [35, 13568], [39, 14002], [52, 14687], [56, 14890], [65, 15290], [70, 15690], [74, 15890], [79, 16050], [82, 16250], [86, 16350]]}, {"verse": 4, "start": 17272, "end": 24785, "text": "The wife has not power of her own body, but the husband: and likewise also the husband has not power of his own body, but the wife.", "words": [[0, 17272], [4, 17418], [9, 17658], [13, 17838], [17, 18018], [23, 18358], [26, 18598], [30, 18738], [34, 18878], [40, 19438], [44, 19678], [48, 19878], [57, 20679], [61, 20785], [70, 21085], [75, 21565], [79, 21785], [87, 22085], [91, 22365], [95, 22565], [101, 22925], [104, 23085], [108, 23205], [112, 23365], [118, 24005], [122, 24245], [126, 24405]]}, {"verse": 5, "start": 25235, "end": 35051, "text": "Do not defraud one the other, unless it be with consent for a time, that you may give yourselves to fasting and prayer; and come together again, that Satan tempt you not for your incontinency.", "words": [[0, 25235], [3, 25330], [7, 25530], [15, 26070], [19, 26210], [23, 26430], [30, 26630], [37, 27070], [40, 27270], [43, 27370], [48, 27550], [56, 27870], [60, 28130], [62, 28230], [68, 28550], [73, 28930], [77, 29050], [81, 29170], [86, 29330], [97, 29710], [100, 29910], [108, 30270], [112, 30530], [120, 31223], [124, 31319], [129, 31519], [138, 31839], [145, 32499], [150, 32659], [156, 33099], [162, 33539], [166, 33599], [170, 33739], [174, 33939], [179, 34059]]}, {"verse": 6, "start": 35501, "end": 38232, "text": "But I speak this by permission, and not of commandment.", "words": [[0, 35501], [4, 35587], [6, 35687], [12, 35867], [17, 36167], [20, 36407], [32, 36867], [36, 37247], [40, 37447], [43, 37547]]}, {"verse": 7, "start": 38682, "end": 45899, "text": "For I would that all men were even as I myself. But every man has his proper gift of God, one after this manner, and another after that.", "words": [[0, 38682], [4, 38769], [6, 38889], [12, 39029], [17, 39209], [21, 39449], [25, 39729], [30, 39929], [35, 40129], [38, 40329], [40, 40469], [48, 41346], [52, 41444], [58, 41644], [62, 41884], [66, 42164], [70, 42304], [77, 42564], [82, 42864], [85, 43044], [90, 43584], [94, 43764], [100, 44004], [105, 44204], [113, 44464], [117, 44884], [125, 45164], [131, 45444]]}, {"verse": 8, "start": 46349, "end": 51068, "text": "I say therefore to the unmarried and widows, It is good for them if they abide even as I.", "words": [[0, 46349], [2, 46449], [6, 46649], [16, 47069], [19, 47309], [23, 47449], [33, 48009], [37, 48109], [45, 48829], [48, 48929], [51, 49069], [56, 49249], [60, 49449], [65, 49669], [68, 49849], [73, 50009], [79, 50249], [84, 50569], [87, 50789]]}, {"verse": 9, "start": 51518, "end": 55669, "text": "But if they cannot contain, let them marry: for it is better to marry than to burn.", "words": [[0, 51518], [4, 51599], [7, 51699], [12, 51819], [19, 52039], [28, 52799], [32, 52939], [37, 53139], [44, 53804], [48, 53930], [51, 54050], [54, 54170], [61, 54390], [64, 54590], [70, 54870], [75, 55090], [78, 55230]]}, {"verse": 10, "start": 56119, "end": 61278, "text": "And to the married I command, yet not I, but the Lord, Let not the wife depart from her husband:", "words": [[0, 56119], [4, 56224], [7, 56344], [11, 56464], [19, 56744], [21, 56904], [30, 57484], [34, 57604], [38, 57824], [41, 58444], [45, 58544], [49, 58684], [55, 59284], [59, 59404], [63, 59644], [67, 59804], [72, 59984], [79, 60264], [84, 60624], [88, 60784]]}, {"verse": 11, "start": 61728, "end": 68895, "text": "But and if she depart, let her remain unmarried, or be reconciled to her husband: and let not the husband put away his wife.", "words": [[0, 61728], [4, 61884], [8, 62124], [11, 62244], [15, 62384], [23, 63164], [27, 63264], [31, 63464], [38, 63764], [49, 64524], [52, 64804], [55, 64984], [66, 65664], [69, 65764], [73, 65904], [82, 66801], [86, 66925], [90, 67085], [94, 67285], [98, 67465], [106, 67725], [110, 68025], [115, 68265], [119, 68465]]}, {"verse": 12, "start": 69345, "end": 77342, "text": "But to the rest speak I, not the Lord: If any brother has a wife that believes not, and she be pleased to dwell with him, let him not put her away.", "words": [[0, 69345], [4, 69467], [7, 69587], [11, 69727], [16, 70047], [22, 70387], [25, 70987], [29, 71147], [33, 71387], [39, 72027], [42, 72171], [46, 72331], [54, 72591], [58, 72851], [60, 73011], [65, 73211], [70, 73391], [79, 73671], [84, 73991], [88, 74291], [92, 74431], [95, 74551], [103, 74911], [106, 75071], [112, 75331], [117, 75611], [122, 75831], [126, 76051], [130, 76271], [134, 76491], [138, 76691], [142, 76871]]}, {"verse": 13, "start": 77792, "end": 83803, "text": "And the woman which has a husband that believes not, and if he be pleased to dwell with her, let her not leave him.", "words": [[0, 77792], [4, 77916], [8, 78036], [14, 78296], [20, 78576], [24, 78796], [26, 78896], [34, 79196], [39, 79416], [48, 79756], [53, 80576], [57, 80736], [60, 80856], [63, 80956], [66, 81056], [74, 81376], [77, 81556], [83, 81816], [88, 82056], [93, 82576], [97, 82796], [101, 82956], [105, 83156], [111, 83456]]}, {"verse": 14, "start": 84253, "end": 93470, "text": "For the unbelieving husband is sanctified by the wife, and the unbelieving wife is sanctified by the husband: else were your children unclean; but now are they holy.", "words": [[0, 84253], [4, 84373], [8, 84553], [20, 85053], [28, 85433], [31, 85713], [42, 86253], [45, 86433], [49, 86553], [55, 86833], [59, 87373], [63, 87513], [75, 87973], [80, 88313], [83, 88553], [94, 89093], [97, 89273], [101, 89373], [110, 90280], [115, 90434], [120, 90587], [125, 90727], [134, 91147], [143, 92146], [147, 92303], [151, 92603], [155, 92863], [160, 93003]]}, {"verse": 15, "start": 93920, "end": 102571, "text": "But if the unbelieving depart, let him depart. A brother or a sister is not under bondage in such cases: but God has called us to peace.", "words": [[0, 93920], [4, 94076], [7, 94236], [11, 94396], [23, 94976], [31, 95756], [35, 95856], [39, 95996], [47, 96879], [49, 96998], [57, 97318], [60, 97618], [62, 97738], [69, 98098], [72, 98378], [76, 98598], [82, 98798], [90, 99378], [93, 99538], [98, 99758], [105, 100733], [109, 100857], [113, 101137], [117, 101417], [124, 101657], [127, 101897], [130, 102057]]}, {"verse": 16, "start": 103021, "end": 110322, "text": "For what do you know, O wife, whether you shall save your husband? or how do you know, O man, whether you shall save your wife?", "words": [[0, 103021], [4, 103144], [9, 103424], [12, 103604], [16, 103704], [22, 103964], [24, 104224], [30, 105044], [38, 105104], [42, 105344], [48, 105544], [53, 105904], [58, 106064], [67, 106925], [70, 107102], [74, 107362], [77, 107542], [81, 107642], [87, 107982], [89, 108122], [94, 108762], [102, 108902], [106, 109122], [112, 109322], [117, 109682], [122, 109882]]}, {"verse": 17, "start": 110772, "end": 117844, "text": "But as God has distributed to every man, as the Lord has called every one, so let him walk. And so ordain I in all churches.", "words": [[0, 110772], [4, 110897], [7, 111037], [11, 111297], [15, 111497], [27, 112017], [30, 112337], [36, 112617], [41, 113157], [44, 113457], [48, 113597], [53, 113777], [57, 113957], [64, 114310], [70, 114664], [75, 115017], [78, 115117], [82, 115277], [86, 115377], [92, 116087], [96, 116208], [99, 116368], [106, 116678], [108, 116988], [111, 117108], [115, 117248]]}, {"verse": 18, "start": 118294, "end": 126366, "text": "Is any man called being circumcised? let him not become uncircumcised. Is any called in uncircumcision? let him not be circumcised.", "words": [[0, 118294], [3, 118435], [7, 118675], [11, 118975], [18, 119255], [24, 119495], [37, 120688], [41, 120835], [45, 121015], [49, 121235], [56, 121535], [71, 122947], [74, 123087], [78, 123337], [85, 123587], [88, 123807], [104, 125043], [108, 125180], [112, 125340], [116, 125540], [119, 125700]]}, {"verse": 19, "start": 126816, "end": 131855, "text": "Circumcision is nothing, and uncircumcision is nothing, but the keeping of the commandments of God.", "words": [[0, 126816], [13, 127359], [16, 127559], [25, 127819], [29, 128119], [44, 128859], [47, 129099], [56, 129399], [60, 129839], [64, 129999], [72, 130339], [75, 130599], [79, 130719], [92, 131059], [95, 131419]]}, {"verse": 20, "start": 132305, "end": 135750, "text": "Let every man abide in the same calling in which he was called.", "words": [[0, 132305], [4, 132477], [10, 132877], [14, 133197], [20, 133557], [23, 133857], [27, 133977], [32, 134257], [40, 134637], [43, 134857], [49, 135017], [52, 135177], [56, 135297]]}, {"verse": 21, "start": 136200, "end": 141134, "text": "Are you called being a servant? care not for it: but if you may be made free, use it rather.", "words": [[0, 136200], [4, 136323], [8, 136443], [15, 136643], [21, 136843], [23, 137003], [32, 137808], [37, 137970], [41, 138150], [45, 138430], [49, 138970], [53, 139054], [56, 139174], [60, 139274], [64, 139454], [67, 139554], [72, 139734], [78, 140414], [82, 140574], [85, 140714]]}, {"verse": 22, "start": 141584, "end": 149513, "text": "For he that is called in the Lord, being a servant, is the Lord’s freeman: likewise also he that is called, being free, is Christ’s servant.", "words": [[0, 141584], [4, 141700], [7, 141900], [12, 142060], [15, 142200], [22, 142500], [25, 142800], [29, 142920], [35, 143400], [41, 143620], [43, 143820], [52, 144460], [55, 144640], [59, 144780], [66, 145080], [75, 145892], [84, 146177], [89, 146677], [92, 146917], [97, 147077], [100, 147197], [108, 147497], [114, 147897], [120, 148237], [123, 148657], [132, 149097]]}, {"verse": 23, "start": 149963, "end": 153160, "text": "You are bought with a price; be not you the servants of men.", "words": [[0, 149963], [4, 150122], [8, 150242], [15, 150462], [20, 150662], [22, 150762], [29, 151553], [32, 151653], [36, 151833], [40, 152113], [44, 152293], [53, 152593], [56, 152813]]}, {"verse": 24, "start": 153610, "end": 157774, "text": "Brethren, let every man, in whatever state he is called, remain in it with God.", "words": [[0, 153610], [10, 154135], [14, 154215], [20, 154515], [25, 154815], [28, 155035], [37, 155315], [43, 155695], [46, 155915], [49, 156055], [57, 156615], [64, 156855], [67, 157075], [70, 157195], [75, 157355]]}, {"verse": 25, "start": 158224, "end": 165898, "text": "Now concerning virgins I have no commandment of the Lord: yet I give my judgment, as one that has obtained mercy of the Lord to be faithful.", "words": [[0, 158224], [4, 158467], [15, 158967], [23, 159627], [25, 159727], [30, 159947], [33, 160147], [45, 160687], [48, 160847], [52, 160947], [58, 161593], [62, 161748], [64, 161848], [69, 162068], [72, 162288], [82, 162708], [85, 163308], [89, 163488], [94, 163628], [98, 163768], [107, 164028], [113, 164488], [116, 164688], [120, 164808], [125, 165008], [128, 165168], [131, 165308]]}, {"verse": 26, "start": 166348, "end": 171983, "text": "I suppose therefore that this is good for the present distress, I say, that it is good for a man so to be.", "words": [[0, 166348], [2, 166494], [10, 166794], [20, 167214], [25, 167514], [30, 167714], [33, 167894], [38, 168094], [42, 168254], [46, 168374], [54, 168674], [64, 169314], [66, 169414], [71, 169914], [76, 170274], [79, 170374], [82, 170514], [87, 170714], [91, 170934], [93, 171074], [97, 171274], [100, 171494], [103, 171614]]}, {"verse": 27, "start": 172433, "end": 178559, "text": "Are you bound to a wife? seek not to be loosed. Are you loosed from a wife? seek not a wife.", "words": [[0, 172433], [4, 172555], [8, 172655], [14, 172935], [17, 173155], [19, 173255], [25, 173995], [30, 174358], [34, 174538], [37, 174758], [40, 174858], [48, 176210], [52, 176311], [56, 176471], [63, 176631], [68, 176851], [70, 176971], [76, 177661], [81, 177965], [85, 178145], [87, 178265]]}, {"verse": 28, "start": 179009, "end": 186873, "text": "But and if you marry, you have not sinned; and if a virgin marry, she has not sinned. Nevertheless such shall have trouble in the flesh: but I spare you.", "words": [[0, 179009], [4, 179034], [8, 179094], [11, 179214], [15, 179434], [22, 180134], [26, 180214], [31, 180314], [35, 180434], [43, 181219], [47, 181322], [50, 181422], [52, 181502], [59, 181912], [66, 182322], [70, 182422], [74, 182522], [78, 182682], [86, 183413], [99, 184148], [104, 184288], [110, 184508], [115, 184688], [123, 185008], [126, 185188], [130, 185288], [137, 186026], [141, 186129], [143, 186249], [149, 186529]]}, {"verse": 29, "start": 187323, "end": 193328, "text": "But this I say, brethren, the time is short: it remains, that both they that have wives be as though they had none;", "words": [[0, 187323], [4, 187425], [9, 187645], [11, 187785], [16, 188365], [26, 189045], [30, 189105], [35, 189345], [38, 189485], [45, 190185], [48, 190289], [57, 190609], [62, 190829], [67, 191029], [72, 191249], [77, 191429], [82, 191669], [88, 191909], [91, 192169], [94, 192349], [101, 192549], [106, 192729], [110, 192929]]}, {"verse": 30, "start": 193778, "end": 201380, "text": "And they that weep, as though they wept not; and they that rejoice, as though they rejoiced not; and they that buy, as though they possessed not;", "words": [[0, 193778], [4, 193919], [9, 194039], [14, 194239], [20, 194639], [23, 194899], [30, 195079], [35, 195259], [40, 195439], [45, 196219], [49, 196363], [54, 196523], [59, 196703], [68, 197103], [71, 197503], [78, 197683], [83, 197933], [92, 198183], [97, 198999], [101, 199130], [106, 199300], [111, 199670], [116, 200040], [119, 200180], [126, 200360], [131, 200600], [141, 200840]]}, {"verse": 31, "start": 201830, "end": 206687, "text": "And they that use this world, as not abusing it: for the fashion of this world passes away.", "words": [[0, 201830], [4, 201977], [9, 202117], [14, 202317], [18, 202537], [23, 202837], [30, 203217], [33, 203637], [37, 203797], [45, 204177], [49, 204747], [53, 204840], [57, 204960], [65, 205300], [68, 205460], [73, 205660], [79, 205940], [86, 206280]]}, {"verse": 32, "start": 207137, "end": 213644, "text": "But I would have you without carefulness. He that is unmarried cares for the things that belong to the Lord, how he may please the Lord:", "words": [[0, 207137], [4, 207295], [6, 207415], [12, 207555], [17, 207735], [21, 207855], [29, 208075], [42, 209244], [45, 209373], [50, 209573], [53, 209713], [63, 210253], [69, 210513], [73, 210753], [77, 210873], [84, 211073], [89, 211253], [96, 211433], [99, 211653], [103, 211773], [109, 212313], [113, 212493], [116, 212693], [120, 212873], [127, 213193], [131, 213413]]}, {"verse": 33, "start": 214094, "end": 218223, "text": "But he that is married cares for the things that are of the world, how he may please his wife.", "words": [[0, 214094], [4, 214193], [7, 214353], [12, 214513], [15, 214633], [23, 214913], [29, 215313], [33, 215533], [37, 215633], [44, 215853], [49, 215993], [53, 216073], [56, 216153], [60, 216253], [67, 216833], [71, 216993], [74, 217153], [78, 217293], [85, 217613], [89, 217833]]}, {"verse": 34, "start": 218673, "end": 230990, "text": "There is difference also between a wife and a virgin. The unmarried woman cares for the things of the Lord, that she may be holy both in body and in spirit: but she that is married cares for the things of the world, how she may please her husband.", "words": [[0, 218673], [6, 218755], [9, 218855], [20, 219175], [25, 219535], [33, 219855], [35, 220015], [40, 220255], [44, 220555], [46, 220615], [54, 221360], [58, 221457], [68, 221937], [74, 222177], [80, 222537], [84, 222837], [88, 222957], [95, 223197], [98, 223357], [102, 223477], [108, 223737], [113, 224237], [117, 224437], [121, 224597], [124, 224737], [129, 225037], [134, 225357], [137, 225597], [142, 225857], [146, 226217], [149, 226317], [157, 227149], [161, 227324], [165, 227564], [170, 227744], [173, 227844], [181, 228144], [187, 228464], [191, 228684], [195, 228804], [202, 228984], [205, 229144], [209, 229224], [216, 229444], [220, 229704], [224, 229884], [228, 230024], [235, 230324], [239, 230504]]}, {"verse": 35, "start": 231440, "end": 239881, "text": "And this I speak for your own profit; not that I may cast a snare upon you, but for that which is comely, and that you may attend upon the Lord without distraction.", "words": [[0, 231440], [4, 231582], [9, 231802], [11, 231942], [17, 232142], [21, 232342], [26, 232482], [30, 232682], [38, 233542], [42, 233740], [47, 233919], [49, 234039], [53, 234159], [58, 234519], [60, 234680], [66, 234900], [71, 235180], [76, 235759], [80, 235960], [84, 236120], [89, 236299], [95, 236499], [98, 236639], [106, 237299], [110, 237479], [115, 237599], [119, 237719], [123, 237859], [130, 238180], [135, 238419], [139, 238639], [144, 238819], [152, 239099]]}, {"verse": 36, "start": 240331, "end": 250927, "text": "But if any man think that he behaves himself uncomely toward his virgin, if she pass the flower of her age, and need so require, let him do what he will, he sins not: let them marry.", "words": [[0, 240331], [4, 240483], [7, 240643], [11, 240923], [15, 241193], [21, 241463], [26, 241643], [29, 241763], [37, 242123], [45, 242483], [54, 243123], [61, 243343], [65, 243603], [73, 244323], [76, 244443], [80, 244653], [85, 244863], [89, 245023], [96, 245243], [99, 245463], [103, 245583], [108, 245943], [112, 246253], [117, 246563], [120, 246723], [129, 247709], [133, 247892], [137, 248052], [140, 248192], [145, 248372], [148, 248452], [154, 248992], [157, 249072], [162, 249292], [167, 250136], [171, 250296], [176, 250496]]}, {"verse": 37, "start": 251377, "end": 261492, "text": "Nevertheless he that stands steadfast in his heart, having no necessity, but has power over his own will, and has so decreed in his heart that he will keep his virgin, does well.", "words": [[0, 251377], [13, 252362], [16, 252462], [21, 252662], [28, 252982], [38, 253602], [41, 253842], [45, 254002], [52, 254562], [59, 254722], [62, 255002], [73, 255542], [77, 256022], [81, 256262], [87, 256602], [92, 256882], [96, 257102], [100, 257322], [106, 258072], [110, 258170], [114, 258310], [117, 258530], [125, 259070], [128, 259150], [132, 259270], [138, 259510], [143, 259690], [146, 259790], [151, 259930], [156, 260110], [160, 260250], [168, 260870], [173, 261030]]}, {"verse": 38, "start": 261942, "end": 266872, "text": "So then he that gives her in marriage does well; but he that gives her not in marriage does better.", "words": [[0, 261942], [3, 262065], [8, 262265], [11, 262385], [16, 262545], [22, 262725], [26, 262905], [29, 263065], [38, 263405], [43, 263765], [49, 264479], [53, 264654], [56, 264814], [61, 265014], [67, 265194], [71, 265374], [75, 265574], [78, 265734], [87, 266034], [92, 266394]]}, {"verse": 39, "start": 267322, "end": 276126, "text": "The wife is bound by the law as long as her husband lives; but if her husband be dead, she is at liberty to be married to whom she will; only in the Lord.", "words": [[0, 267322], [4, 267404], [9, 267604], [12, 267804], [18, 268024], [21, 268244], [25, 268384], [29, 268584], [32, 268804], [37, 269044], [40, 269224], [44, 269344], [52, 269644], [59, 270470], [63, 270655], [66, 270815], [70, 270995], [78, 271295], [81, 271535], [87, 272295], [91, 272435], [94, 272595], [97, 272735], [105, 273055], [108, 273375], [111, 273495], [119, 273775], [122, 273975], [127, 274175], [131, 274395], [137, 275103], [142, 275366], [145, 275546], [149, 275666]]}, {"verse": 40, "start": 276576, "end": 282695, "text": "But she is happier if she so abide, after my judgment: and I think also that I have the Spirit of God.", "words": [[0, 276576], [4, 276721], [8, 276901], [11, 277041], [19, 277381], [22, 277681], [26, 277841], [29, 278061], [36, 278481], [42, 278901], [45, 279121], [55, 279981], [59, 280099], [61, 280259], [67, 280439], [72, 280859], [77, 281119], [79, 281259], [84, 281459], [88, 281599], [95, 281979], [98, 282179]]}]}