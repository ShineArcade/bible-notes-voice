{"book": "LUK", "chapter": 15, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 252953, "verses": [{"verse": 1, "start": 300, "end": 6062, "text": "Y se llegaban a él todos los recaudadores de impuestos y pecadores a oírle.", "words": [[0, 300], [2, 446], [5, 566], [14, 1146], [16, 1266], [19, 1486], [25, 1946], [29, 2446], [42, 3486], [45, 3706], [55, 4366], [57, 4566], [67, 5166], [69, 5406]]}, {"verse": 2, "start": 6512, "end": 13867, "text": "Y murmuraban los fariseos y los escribas, diciendo: Este a los pecadores recibe, y con ellos come.", "words": [[0, 6512], [2, 6796], [13, 7556], [17, 7796], [26, 8576], [28, 8716], [32, 8856], [42, 9576], [52, 10708], [57, 10994], [59, 11134], [63, 11274], [73, 11734], [81, 12394], [83, 12914], [87, 13114], [93, 13314]]}, {"verse": 3, "start": 14217, "end": 17506, "text": "Y él les refirió esta parábola, diciendo:", "words": [[0, 14217], [2, 14380], [5, 14600], [9, 14900], [17, 15540], [22, 15760], [32, 16460]]}, {"verse": 4, "start": 17956, "end": 29317, "text": "¿Qué hombre de vosotros, teniendo cien ovejas, si pierde una de ellas, no deja las noventa y nueve en el desierto, y va a la que se perdió, hasta que la halle?", "words": [[0, 17956], [5, 18058], [12, 18298], [15, 18478], [25, 19178], [34, 19658], [39, 20078], [47, 20998], [50, 21118], [57, 21658], [61, 21858], [64, 22058], [71, 22758], [74, 22878], [79, 23138], [83, 23358], [91, 23938], [93, 24038], [99, 24478], [102, 24598], [105, 24718], [115, 25878], [117, 26138], [120, 26358], [122, 26798], [125, 26898], [129, 27038], [132, 27178], [140, 28174], [146, 28438], [150, 28750], [153, 29062]]}, {"verse": 5, "start": 29767, "end": 32623, "text": "Y hallada, la pone sobre sus hombros gozoso;", "words": [[0, 29767], [2, 30014], [11, 30304], [14, 30464], [19, 30864], [25, 31184], [29, 31444], [37, 31884]]}, {"verse": 6, "start": 33073, "end": 42859, "text": "Y viniendo a casa, junta a los amigos y a los vecinos, diciéndoles: Alegraos conmigo, porque he hallado mi oveja que se había perdido.", "words": [[0, 33073], [2, 33408], [11, 33888], [13, 34008], [19, 34848], [25, 35448], [27, 35588], [31, 35688], [38, 36148], [40, 36388], [42, 36428], [46, 36568], [55, 37108], [68, 38811], [77, 39349], [86, 40089], [93, 40429], [96, 40669], [104, 41049], [107, 41249], [113, 41669], [117, 41829], [120, 41969], [126, 42129]]}, {"verse": 7, "start": 43309, "end": 52517, "text": "Os digo, que así habrá más gozo en el cielo de un pecador que se arrepiente, que de noventa y nueve justos, que no necesitan arrepentimiento.", "words": [[0, 43309], [3, 43435], [9, 43755], [13, 43995], [17, 44235], [23, 44615], [27, 44795], [32, 45335], [35, 45595], [38, 45755], [44, 46075], [47, 46295], [50, 46395], [58, 46855], [62, 46995], [65, 47135], [77, 47775], [81, 48335], [84, 48455], [92, 48895], [94, 49065], [100, 49235], [108, 49935], [112, 50135], [115, 50295], [125, 50995]]}, {"verse": 8, "start": 52967, "end": 64568, "text": "¿O qué mujer que tiene diez dracmas, si pierde una dracma, no enciende la lámpara, y barre la casa, y busca con diligencia hasta encontrarla?", "words": [[0, 52967], [3, 53089], [7, 53269], [13, 53589], [17, 53889], [23, 54269], [28, 54769], [37, 56269], [40, 56509], [47, 57049], [51, 57289], [59, 58349], [62, 58589], [71, 59069], [74, 59249], [83, 59849], [85, 60309], [91, 60649], [94, 60769], [100, 61129], [102, 61709], [108, 61989], [112, 62309], [123, 63149], [129, 63409]]}, {"verse": 9, "start": 65018, "end": 75449, "text": "Y cuando la encuentra, reúne a sus amigas y vecinas, diciendo: Alegraos conmigo, porque he hallado la dracma que había perdido.", "words": [[0, 65018], [2, 65139], [9, 65359], [12, 65579], [23, 66639], [29, 67399], [31, 67499], [35, 67659], [42, 68219], [44, 68319], [53, 69059], [63, 71504], [72, 71764], [81, 72364], [88, 72744], [91, 72944], [99, 73284], [102, 73444], [109, 73824], [113, 73984], [119, 74184]]}, {"verse": 10, "start": 75798, "end": 81939, "text": "Así os digo que hay gozo delante de los ángeles de Dios por un pecador que se arrepiente.", "words": [[0, 75798], [4, 76084], [7, 76264], [12, 76504], [16, 76744], [20, 76884], [25, 77284], [33, 77844], [36, 77984], [40, 78124], [48, 78664], [51, 78844], [56, 79104], [60, 79664], [63, 79844], [71, 80524], [75, 80724], [78, 80904]]}, {"verse": 11, "start": 82389, "end": 85287, "text": "Y dijo: Un hombre tenía dos hijos;", "words": [[0, 82389], [2, 82530], [8, 83346], [11, 83532], [18, 83872], [24, 84272], [28, 84572]]}, {"verse": 12, "start": 85737, "end": 93164, "text": "Y el menor de ellos dijo a su padre: Padre, dame la parte de los bienes que me pertenece: y les repartió los bienes.", "words": [[0, 85737], [2, 85881], [5, 86001], [11, 86301], [14, 86541], [20, 86801], [25, 87281], [27, 87481], [30, 87601], [37, 88486], [44, 88866], [49, 89086], [52, 89226], [58, 89526], [61, 89726], [65, 89866], [72, 90266], [76, 90366], [79, 90466], [90, 91589], [92, 91711], [96, 91871], [105, 92391], [109, 92551]]}, {"verse": 13, "start": 93514, "end": 105554, "text": "Y no muchos días después, juntándolo todo el hijo menor, partió lejos a una provincia apartada; y allí desperdició sus bienes viviendo perdidamente.", "words": [[0, 93514], [2, 93662], [5, 93822], [12, 94122], [17, 94442], [26, 95422], [37, 96262], [42, 96582], [45, 96802], [50, 97042], [57, 98022], [64, 98702], [70, 99182], [72, 99402], [76, 99582], [86, 100462], [96, 101671], [98, 101795], [103, 102015], [115, 102855], [119, 103035], [126, 103735], [135, 104255]]}, {"verse": 14, "start": 106004, "end": 113667, "text": "Y cuando todo lo hubo malgastado, vino una gran hambruna en aquella provincia, y comenzó a pasar necesidad.", "words": [[0, 106004], [2, 106108], [9, 106328], [14, 106748], [17, 107008], [22, 107328], [34, 108068], [39, 108308], [43, 108668], [48, 108948], [57, 109728], [60, 109868], [68, 110188], [79, 110988], [81, 111628], [89, 112228], [91, 112308], [97, 112588]]}, {"verse": 15, "start": 114117, "end": 122172, "text": "Y fue y se llegó a uno de los ciudadanos de aquella tierra, el cual le envió a su hacienda para que apacentase los cerdos.", "words": [[0, 114117], [2, 114279], [6, 114439], [8, 114759], [11, 114919], [17, 115219], [19, 115499], [23, 115679], [26, 115819], [30, 115959], [41, 116919], [44, 117039], [52, 117359], [60, 118219], [63, 118339], [68, 118579], [71, 118939], [77, 119359], [79, 119479], [82, 119599], [91, 120119], [96, 120339], [100, 120519], [111, 121259], [115, 121459]]}, {"verse": 16, "start": 122622, "end": 128389, "text": "Y deseaba llenar su vientre de las algarrobas que comían los cerdos; pero nadie se las daba.", "words": [[0, 122622], [2, 122731], [10, 123131], [17, 123531], [20, 123711], [28, 124291], [31, 124658], [35, 125024], [46, 125391], [50, 125551], [57, 125931], [61, 126091], [69, 127023], [74, 127168], [80, 127468], [83, 127688], [87, 127828]]}, {"verse": 17, "start": 128839, "end": 136548, "text": "Y volviendo en sí, dijo: ¡Cuántos jornaleros en casa de mi padre tienen abundancia de pan, y yo aquí perezco de hambre!", "words": [[0, 128839], [2, 128964], [12, 129484], [15, 129704], [19, 130364], [25, 131199], [34, 131580], [45, 132120], [48, 132300], [53, 132500], [56, 132680], [59, 132800], [65, 133100], [72, 133460], [83, 134060], [86, 134220], [91, 135000], [93, 135080], [96, 135280], [101, 135640], [109, 136000], [112, 136140]]}, {"verse": 18, "start": 136998, "end": 142222, "text": "Me levantaré, e iré a mi padre, y le diré: Padre, he pecado contra el cielo, y contra ti;", "words": [[0, 136998], [3, 137085], [14, 137625], [16, 137805], [20, 138065], [22, 138105], [25, 138185], [32, 138485], [34, 138845], [37, 138925], [43, 139635], [50, 140015], [53, 140095], [60, 140515], [67, 140815], [70, 140975], [77, 141315], [79, 141495], [86, 141815]]}, {"verse": 19, "start": 142672, "end": 147838, "text": "Ya no soy digno de ser llamado tu hijo; hazme como a uno de tus jornaleros.", "words": [[0, 142672], [3, 142799], [6, 142959], [10, 143179], [16, 143619], [19, 143679], [23, 143839], [31, 144159], [34, 144439], [40, 145117], [46, 145435], [51, 145655], [53, 145795], [57, 145975], [60, 146135], [64, 146295]]}, {"verse": 20, "start": 148188, "end": 160685, "text": "Y levantándose, vino a su padre. Y como aun estuviese lejos, lo vio su padre, y fue movido a misericordia, y corrió, y se echó sobre su cuello, y le besó.", "words": [[0, 148188], [2, 148334], [16, 149254], [21, 149694], [23, 149874], [26, 149994], [33, 150955], [35, 151268], [40, 151528], [44, 151808], [54, 152368], [61, 153248], [64, 153408], [68, 153608], [71, 153748], [78, 154748], [80, 154848], [84, 155008], [91, 155488], [93, 155608], [107, 156568], [109, 157008], [117, 157548], [119, 158068], [122, 158208], [127, 158548], [133, 158848], [136, 159088], [144, 159568], [146, 159988], [149, 160108]]}, {"verse": 21, "start": 161135, "end": 167975, "text": "Y el hijo le dijo: Padre, he pecado contra el cielo, y contra ti, y ya no soy digno de ser llamado tu hijo.", "words": [[0, 161135], [2, 161321], [5, 161441], [10, 161721], [13, 161921], [19, 162776], [26, 163256], [29, 163336], [36, 163716], [43, 164016], [46, 164176], [53, 164496], [55, 164836], [62, 165136], [66, 165396], [68, 165916], [71, 166056], [74, 166156], [78, 166376], [84, 166776], [87, 166836], [91, 167016], [99, 167316], [102, 167576]]}, {"verse": 22, "start": 168325, "end": 176460, "text": "Pero el padre dijo a sus siervos: Sacad el mejor vestido, y vestidle; y poned un anillo en su mano, y zapatos en sus pies.", "words": [[0, 168325], [5, 168489], [8, 168649], [14, 169089], [19, 169429], [21, 169609], [25, 169709], [34, 170758], [40, 171113], [43, 171253], [49, 171553], [58, 172173], [60, 172333], [70, 173350], [72, 173509], [78, 173709], [81, 173949], [88, 174269], [91, 174389], [94, 174549], [100, 174809], [102, 175089], [110, 175609], [113, 175769], [117, 175909]]}, {"verse": 23, "start": 176910, "end": 181170, "text": "Y traed el becerro engordado, y matadlo, y comamos, y hagamos fiesta:", "words": [[0, 176910], [2, 177068], [8, 177262], [11, 177455], [19, 177975], [30, 178575], [32, 178755], [41, 179275], [43, 179475], [52, 179955], [54, 180235], [62, 180575]]}, {"verse": 24, "start": 181620, "end": 189335, "text": "Porque este mi hijo muerto era, y ha revivido; se había perdido, y es hallado. Y comenzaron a regocijarse.", "words": [[0, 181620], [7, 181819], [12, 182079], [15, 182299], [20, 182519], [27, 182919], [32, 183239], [34, 183639], [37, 183759], [47, 184712], [50, 184895], [56, 185095], [65, 185815], [67, 186035], [70, 186235], [79, 187118], [81, 187223], [92, 187903], [94, 188163]]}, {"verse": 25, "start": 189785, "end": 198394, "text": "Y su hijo el mayor estaba en el campo; el cual cuando vino, y llegó cerca de casa, oyó la música y las danzas;", "words": [[0, 189785], [2, 189913], [5, 190073], [10, 190413], [13, 190613], [19, 190993], [26, 191433], [29, 191673], [32, 191793], [39, 192766], [42, 192932], [47, 193212], [54, 193512], [60, 193972], [62, 194532], [68, 194792], [74, 195132], [77, 195392], [83, 196052], [87, 196512], [90, 196652], [97, 197152], [99, 197432], [103, 197612]]}, {"verse": 26, "start": 198844, "end": 203336, "text": "Y llamando a uno de los criados, le preguntó qué era aquello.", "words": [[0, 198844], [2, 198949], [11, 199529], [13, 199809], [17, 200029], [20, 200189], [24, 200329], [33, 201209], [36, 201509], [45, 202149], [49, 202409], [53, 202689]]}, {"verse": 27, "start": 203786, "end": 210601, "text": "Y él le dijo: Tu hermano ha venido; y tu padre ha matado el becerro engordado, por haberle recibido salvo.", "words": [[0, 203786], [2, 203975], [5, 204135], [8, 204295], [14, 205136], [17, 205213], [25, 205633], [28, 205733], [36, 206566], [38, 206668], [41, 206788], [47, 207048], [50, 207208], [57, 207588], [60, 207708], [68, 208128], [79, 208708], [83, 209168], [91, 209548], [100, 210048]]}, {"verse": 28, "start": 210951, "end": 218336, "text": "Entonces se enojó, y no quería entrar. Salió por tanto su padre, y le rogaba que entrase.", "words": [[0, 210951], [9, 211533], [12, 212133], [19, 212713], [21, 212853], [24, 212973], [31, 213273], [39, 214404], [45, 214785], [49, 214965], [55, 215245], [58, 215545], [65, 215965], [67, 216525], [70, 216935], [77, 217345], [81, 217565]]}, {"verse": 29, "start": 218786, "end": 230976, "text": "Pero él respondiendo, dijo al padre: He aquí tantos años te sirvo, no habiendo traspasado jamás tu mandamiento, y nunca me has dado un cabrito para gozarme con mis amigos:", "words": [[0, 218786], [5, 218950], [8, 219370], [22, 220410], [27, 220750], [30, 220990], [37, 222622], [40, 222782], [45, 223022], [52, 223522], [57, 223742], [60, 223962], [67, 224782], [70, 224962], [79, 225302], [90, 225962], [96, 226402], [99, 226522], [112, 227222], [114, 227782], [120, 228042], [123, 228302], [127, 228422], [132, 228602], [135, 228782], [143, 229202], [148, 229442], [156, 230002], [160, 230142], [164, 230342]]}, {"verse": 30, "start": 231426, "end": 237893, "text": "Pero cuando vino este tu hijo, que ha consumido tus bienes con rameras, has matado para él el becerro engordado.", "words": [[0, 231426], [5, 231563], [12, 231783], [17, 232103], [22, 232363], [25, 232583], [31, 233123], [35, 233323], [38, 233443], [48, 234003], [52, 234163], [59, 234583], [63, 234743], [72, 235583], [76, 235763], [83, 236203], [88, 236403], [91, 236623], [94, 236723], [102, 237223]]}, {"verse": 31, "start": 238243, "end": 244641, "text": "Él entonces le dijo: Hijo, tú siempre estás conmigo, y todas mis cosas son tuyas.", "words": [[0, 238243], [3, 238514], [12, 239114], [15, 239454], [21, 240281], [27, 241047], [30, 241167], [38, 241547], [44, 241847], [53, 242487], [55, 242887], [61, 243067], [65, 243327], [71, 243627], [75, 243947]]}, {"verse": 32, "start": 244941, "end": 252553, "text": "Pero era necesario celebrar y alegrarnos, porque este hermano tuyo estaba muerto y ha vuelto a vivir; estaba perdido y ha sido hallado.", "words": [[0, 244941], [5, 245081], [9, 245301], [19, 245821], [28, 246421], [30, 246501], [42, 247341], [49, 247681], [54, 247941], [62, 248341], [67, 248561], [74, 248781], [81, 249341], [83, 249481], [86, 249561], [93, 249841], [95, 249901], [102, 250604], [109, 250882], [117, 251462], [119, 251662], [122, 251782], [127, 251942]]}]}