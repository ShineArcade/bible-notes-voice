{"book": "PSA", "chapter": 22, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 216195, "verses": [{"verse": 1, "start": 300, "end": 12357, "text": "Al Músico principal, sobre Ajelet-sahar: Salmo de David. DIOS mío, Dios mío, ¿por qué me has dejado? ¿ por qué estás lejos de mi salvación, y de las palabras de mi clamor?", "words": [[0, 300], [3, 446], [10, 906], [21, 1546], [27, 2453], [41, 3631], [47, 4089], [50, 4249], [57, 5125], [62, 5414], [67, 5894], [72, 6034], [77, 6138], [82, 6242], [86, 6346], [89, 6450], [93, 6554], [101, 7512], [103, 8162], [107, 8402], [111, 8602], [117, 8842], [123, 9442], [126, 9602], [129, 9702], [140, 10422], [142, 10842], [145, 10942], [149, 11082], [158, 11422], [161, 11662], [164, 12010]]}, {"verse": 2, "start": 12807, "end": 18586, "text": "Dios mío, clamo de día, y no oyes; y de noche, y no hay para mí silencio.", "words": [[0, 12807], [5, 13032], [10, 13532], [16, 13892], [19, 14072], [24, 14392], [26, 14612], [29, 14792], [35, 16000], [37, 16141], [40, 16261], [47, 16601], [49, 16981], [52, 17161], [56, 17361], [61, 17601], [64, 17801]]}, {"verse": 3, "start": 19036, "end": 24277, "text": "Pero tú eres santo, tú que habitas entre las alabanzas de Israel.", "words": [[0, 19036], [5, 19198], [8, 19458], [13, 19678], [20, 21078], [23, 21398], [27, 21578], [35, 22178], [41, 22538], [45, 22818], [55, 23478], [58, 23578]]}, {"verse": 4, "start": 24727, "end": 29840, "text": "En ti esperaron nuestros padres: esperaron, y tú los libraste.", "words": [[0, 24727], [3, 24894], [6, 25234], [16, 26114], [25, 26354], [33, 27546], [44, 28190], [46, 28450], [49, 28710], [53, 29302]]}, {"verse": 5, "start": 30290, "end": 35725, "text": "Clamaron a ti, y fueron librados: confiaron en ti, y no se avergonzaron.", "words": [[0, 30290], [9, 30734], [11, 30874], [15, 31074], [17, 31254], [24, 31514], [34, 32802], [44, 33368], [47, 33558], [51, 33748], [53, 34008], [56, 34148], [59, 34328]]}, {"verse": 6, "start": 36175, "end": 41850, "text": "Mas yo soy gusano, y no hombre; deshonra de los hombres, y desecho del pueblo.", "words": [[0, 36175], [4, 36175], [7, 36400], [11, 36640], [19, 37300], [21, 37620], [24, 37800], [32, 38939], [41, 39289], [44, 39429], [48, 39569], [57, 40009], [59, 40529], [67, 41089], [71, 41209]]}, {"verse": 7, "start": 42300, "end": 49314, "text": "Todos los que me ven, escarnecen de mí; estiran los labios, menean la cabeza, diciendo:", "words": [[0, 42300], [6, 42544], [10, 42864], [14, 43064], [17, 43224], [22, 43914], [33, 44604], [36, 44804], [40, 45466], [48, 45876], [52, 46076], [60, 47116], [67, 47596], [70, 47736], [78, 48236]]}, {"verse": 8, "start": 49564, "end": 54431, "text": "Se encomienda a Jehová, líbrelo; sálvele, puesto que en él se complacía.", "words": [[0, 49564], [3, 49769], [14, 50059], [16, 50349], [24, 51089], [33, 52660], [42, 52660], [49, 52924], [53, 53164], [56, 53304], [59, 53424], [62, 53584]]}, {"verse": 9, "start": 54781, "end": 61480, "text": "Pero tú eres el que me sacó del vientre, el que me hizo estar confiado desde que estaba a los pechos de mi madre.", "words": [[0, 54781], [5, 54925], [8, 55145], [13, 55385], [16, 55565], [20, 55685], [23, 55825], [28, 56185], [32, 56325], [41, 57285], [44, 57545], [48, 57705], [51, 57845], [56, 58125], [62, 58385], [71, 59085], [77, 59305], [81, 59545], [88, 59845], [90, 60065], [94, 60185], [101, 60625], [104, 60765], [107, 60885]]}, {"verse": 10, "start": 61930, "end": 68519, "text": "Sobre ti fui echado desde la matriz: desde el vientre de mi madre, tú eres mi Dios.", "words": [[0, 61930], [6, 62173], [9, 62433], [13, 62633], [20, 63193], [26, 63713], [29, 63953], [37, 64974], [43, 65237], [46, 65477], [54, 65957], [57, 66057], [60, 66217], [67, 67197], [70, 67457], [75, 67677], [78, 67877]]}, {"verse": 11, "start": 68969, "end": 74594, "text": "No te alejes de mí, porque la angustia está cerca; porque no hay quien ayude.", "words": [[0, 68969], [3, 69249], [6, 69389], [13, 69809], [16, 69989], [20, 70489], [27, 70769], [30, 70949], [39, 71469], [44, 71629], [51, 72613], [58, 72998], [61, 73238], [65, 73418], [71, 73758]]}, {"verse": 12, "start": 75044, "end": 79862, "text": "Me han rodeado muchos toros; fuertes toros de Basán me han cercado.", "words": [[0, 75044], [3, 75171], [7, 75331], [15, 75951], [22, 76211], [29, 77315], [37, 77838], [43, 78278], [46, 78398], [52, 78798], [55, 78958], [59, 79058]]}, {"verse": 13, "start": 80312, "end": 84675, "text": "Abrieron sobre mí su boca, como león que arrebata y ruge.", "words": [[0, 80312], [9, 80837], [15, 81117], [18, 81357], [21, 81537], [27, 82397], [32, 82777], [37, 83217], [41, 83537], [50, 83857], [52, 84289]]}, {"verse": 14, "start": 85125, "end": 94942, "text": "Me he derramado como aguas, y todos mis huesos se descoyuntaron: mi corazón fue como cera, derritiéndose en medio de mis entrañas.", "words": [[0, 85125], [3, 85443], [6, 85583], [16, 86143], [21, 86383], [28, 87183], [30, 87463], [36, 87803], [40, 88363], [47, 88943], [50, 89163], [65, 90556], [68, 90702], [76, 91082], [80, 91382], [85, 91622], [91, 92442], [105, 93282], [108, 93422], [114, 93642], [117, 93842], [121, 93942]]}, {"verse": 15, "start": 95392, "end": 102618, "text": "Se secó como un tiesto mi vigor, y mi lengua se pegó a mi paladar; y me has puesto en el polvo de la muerte.", "words": [[0, 95392], [3, 95513], [8, 95953], [13, 96153], [16, 96293], [23, 96873], [26, 96993], [33, 97593], [35, 97833], [38, 97953], [45, 98433], [48, 98593], [53, 98993], [55, 99093], [58, 99544], [67, 100269], [69, 100394], [72, 100494], [76, 100634], [83, 100914], [86, 101174], [89, 101294], [95, 101774], [98, 101874], [101, 101994]]}, {"verse": 16, "start": 103068, "end": 109601, "text": "Porque perros me han rodeado, me ha cercado cuadrilla de malignos: horadaron mis manos y mis pies.", "words": [[0, 103068], [7, 103313], [14, 103993], [17, 104253], [21, 104373], [30, 105073], [33, 105133], [36, 105513], [44, 105893], [54, 106273], [57, 106413], [67, 107811], [77, 108141], [81, 108341], [87, 108701], [89, 108941], [93, 109101]]}, {"verse": 17, "start": 110051, "end": 114556, "text": "Contar puedo todos mis huesos; ellos miran, me observan.", "words": [[0, 110051], [7, 110492], [13, 111012], [19, 111492], [23, 111792], [31, 112759], [37, 113048], [44, 113508], [47, 113668]]}, {"verse": 18, "start": 115006, "end": 119328, "text": "Partieron entre sí mis vestidos, y sobre mi ropa echaron suertes.", "words": [[0, 115006], [10, 115706], [16, 116026], [19, 116326], [23, 116526], [33, 117126], [35, 117346], [41, 117586], [44, 117806], [49, 118186], [57, 118546]]}, {"verse": 19, "start": 119778, "end": 124378, "text": "Mas tú, Jehová, no te alejes; fortaleza mía, apresúrate para mi ayuda.", "words": [[0, 119778], [4, 120003], [8, 120228], [16, 120453], [19, 120678], [22, 120918], [30, 121910], [40, 122509], [45, 122949], [56, 123449], [61, 123689], [64, 123849]]}, {"verse": 20, "start": 124828, "end": 128867, "text": "Libra de la espada mi alma; del poder del perro mi única.", "words": [[0, 124828], [6, 125253], [9, 125354], [12, 125453], [19, 125934], [22, 126033], [28, 126878], [32, 127042], [38, 127342], [42, 127655], [48, 127969], [51, 128282]]}, {"verse": 21, "start": 129317, "end": 134390, "text": "Sálvame de la boca del león, y óyeme librándome de los cuernos de los búfalos.", "words": [[0, 129317], [8, 129784], [11, 129964], [14, 130064], [19, 130284], [23, 130524], [29, 131044], [31, 131584], [37, 131964], [48, 132644], [51, 132804], [55, 132944], [63, 133424], [66, 133524], [70, 133624]]}, {"verse": 22, "start": 134840, "end": 140073, "text": "Anunciaré tu nombre a mis hermanos: en medio de la congregación te alabaré.", "words": [[0, 134840], [10, 135478], [13, 135658], [20, 135958], [22, 136098], [26, 136198], [36, 137544], [39, 137925], [45, 138245], [48, 138425], [51, 138525], [64, 139305], [67, 139505]]}, {"verse": 23, "start": 140523, "end": 149709, "text": "Los que teméis a Jehová, alabadle; glorificadle, descendencia toda de Jacob; y temed de él, vosotros, descendencia toda de Israel.", "words": [[0, 140523], [4, 140653], [8, 140793], [15, 141133], [17, 141273], [25, 141941], [35, 143453], [49, 144083], [62, 144983], [67, 145223], [70, 145443], [77, 146334], [79, 146529], [85, 146759], [88, 146979], [92, 147099], [102, 147619], [115, 148499], [120, 148739], [123, 148999]]}, {"verse": 24, "start": 150159, "end": 160514, "text": "Porque no menospreció ni abominó la aflicción del pobre, ni de él escondió su rostro; sino que cuando clamó a él, le oyó.", "words": [[0, 150159], [7, 150381], [10, 150941], [22, 151501], [25, 151781], [33, 152681], [36, 153101], [46, 153821], [50, 154001], [57, 154461], [60, 155061], [63, 155261], [66, 155601], [75, 156241], [78, 156401], [86, 157367], [91, 157787], [95, 157987], [102, 158457], [108, 158927], [110, 159107], [114, 159603], [117, 160099]]}, {"verse": 25, "start": 160964, "end": 167749, "text": "De ti será mi alabanza en la grande congregación; mis votos pagaré delante de los que le temen.", "words": [[0, 160964], [3, 161131], [6, 161351], [11, 161631], [14, 161891], [23, 162691], [26, 163151], [29, 163311], [36, 163691], [50, 165269], [54, 165417], [60, 165757], [67, 166217], [75, 166637], [78, 166797], [82, 166937], [86, 167057], [89, 167177]]}, {"verse": 26, "start": 168199, "end": 175854, "text": "Comerán los pobres, y serán saciados: alabarán a Jehová los que le buscan: vivirá vuestro corazón para siempre.", "words": [[0, 168199], [8, 168563], [12, 168723], [20, 169243], [22, 169463], [28, 169803], [38, 170990], [47, 171642], [49, 171895], [56, 172148], [60, 172402], [64, 172502], [67, 172642], [75, 173606], [82, 174072], [90, 174372], [98, 174772], [103, 175112]]}, {"verse": 27, "start": 176304, "end": 185365, "text": "Se acordarán, y se volverán a Jehová todos los confines de la tierra; y se humillarán delante de ti todas las familias de las naciones.", "words": [[0, 176304], [3, 176466], [14, 177246], [16, 177446], [19, 177606], [28, 178146], [30, 178246], [37, 178666], [43, 178946], [47, 179286], [56, 179886], [59, 180046], [62, 180146], [70, 181187], [72, 181417], [75, 181557], [86, 182277], [94, 182697], [97, 182837], [100, 183057], [106, 183417], [110, 183737], [119, 184337], [122, 184437], [126, 184577]]}, {"verse": 28, "start": 185815, "end": 190697, "text": "Porque de Jehová es el reino; y él se enseñoreará de las naciones.", "words": [[0, 185815], [7, 186017], [10, 186197], [17, 186697], [20, 186917], [23, 187117], [30, 188091], [32, 188282], [35, 188422], [38, 188622], [50, 189502], [53, 189622], [57, 189782]]}, {"verse": 29, "start": 191147, "end": 203892, "text": "Comerán y adorarán todos los poderosos de la tierra: se postrarán delante de él todos los que descienden al polvo, si bien ninguno puede conservar la vida a su propia alma.", "words": [[0, 191147], [8, 191716], [10, 192156], [19, 192816], [25, 193116], [29, 193396], [39, 193956], [42, 194096], [45, 194196], [53, 195127], [56, 195271], [66, 196011], [74, 196491], [77, 196691], [80, 196891], [86, 197311], [90, 198011], [94, 198191], [105, 198751], [108, 198971], [115, 199791], [118, 199991], [123, 200291], [131, 201131], [137, 201371], [147, 202071], [150, 202231], [155, 202511], [157, 202771], [160, 202911], [167, 203291]]}, {"verse": 30, "start": 204342, "end": 209974, "text": "La posteridad le servirá; será ella contada por una generación de Jehová.", "words": [[0, 204342], [3, 204512], [14, 205432], [17, 205752], [26, 206798], [31, 207387], [36, 207527], [44, 208147], [48, 208387], [52, 208547], [63, 209207], [66, 209347]]}, {"verse": 31, "start": 210424, "end": 215795, "text": "Vendrán, y anunciarán al pueblo que nazca, su justicia que él hizo.", "words": [[0, 210424], [9, 211050], [11, 211610], [22, 212370], [25, 212490], [32, 212770], [36, 213090], [43, 213610], [46, 214070], [55, 214790], [59, 214990], [62, 215190]]}]}