{"book": "1CO", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 87771, "verses": [{"verse": 1, "start": 300, "end": 7656, "text": "Si yo hablase lenguas humanas y angélicas, y no tuviese amor, vengo a ser como metal que resuena, o címbalo que suena.", "words": [[0, 300], [3, 417], [6, 577], [14, 1017], [22, 1557], [30, 2077], [32, 2177], [43, 2957], [45, 3117], [48, 3257], [56, 3697], [62, 4457], [68, 4697], [70, 4837], [74, 4937], [79, 5177], [85, 5477], [89, 5717], [98, 6297], [100, 6607], [108, 6917], [112, 7097]]}, {"verse": 2, "start": 8006, "end": 19721, "text": "Y si tuviese profecía, y entendiese todos los misterios y todo conocimiento; y si tuviese toda la fe, de tal manera que traspasase los montes, y no tuviese amor, nada soy.", "words": [[0, 8006], [2, 8108], [5, 8228], [13, 8628], [23, 9448], [25, 9768], [36, 10288], [42, 10588], [46, 10808], [56, 11508], [58, 11688], [63, 11908], [77, 13122], [79, 13226], [82, 13366], [90, 13846], [95, 14106], [98, 14306], [102, 14586], [105, 14966], [109, 15166], [116, 15466], [120, 15686], [131, 16426], [135, 16566], [143, 17226], [145, 17646], [148, 17766], [156, 18186], [162, 18946], [167, 19206]]}, {"verse": 3, "start": 20071, "end": 27775, "text": "Y si repartiese todos mis bienes para dar de comer a pobres, y si entregase mi cuerpo para ser quemado, y no tuviese amor, de nada me sirve.", "words": [[0, 20071], [2, 20181], [5, 20550], [16, 20920], [22, 21120], [26, 21380], [33, 21800], [38, 21954], [42, 22108], [45, 22260], [51, 22540], [53, 22720], [61, 23120], [63, 23336], [66, 23456], [76, 23956], [79, 24096], [86, 24416], [91, 24676], [95, 24876], [104, 25376], [106, 25716], [109, 25836], [117, 26196], [123, 26536], [126, 26896], [131, 27076], [134, 27256]]}, {"verse": 4, "start": 28125, "end": 34616, "text": "El amor es paciente, es benigno; el amor no tiene envidia, el amor no se jacta, no se envanece;", "words": [[0, 28125], [3, 28226], [8, 28446], [11, 28606], [21, 29347], [24, 29466], [33, 30314], [36, 30410], [41, 30650], [44, 30830], [50, 31050], [59, 31910], [62, 32130], [67, 32350], [70, 32510], [73, 32690], [80, 33510], [83, 33650], [86, 33830]]}, {"verse": 5, "start": 34966, "end": 40291, "text": "No se comporta indebidamente, no busca lo suyo, no se irrita, no piensa el mal;", "words": [[0, 34966], [3, 35072], [6, 35212], [15, 35812], [30, 36952], [33, 37052], [39, 37372], [42, 37552], [48, 38272], [51, 38372], [54, 38552], [62, 39272], [65, 39372], [72, 39752], [75, 39912]]}, {"verse": 6, "start": 40641, "end": 44238, "text": "No se alegra de la injusticia, sino que se alegra de la verdad;", "words": [[0, 40641], [3, 40740], [6, 40900], [13, 41280], [16, 41360], [19, 41460], [31, 42460], [36, 42800], [40, 43000], [43, 43160], [50, 43540], [53, 43620], [56, 43720]]}, {"verse": 7, "start": 44588, "end": 48310, "text": "Todo lo sufre, todo lo cree, todo lo espera, todo lo soporta.", "words": [[0, 44588], [5, 44790], [8, 44990], [15, 45670], [20, 45790], [23, 45990], [29, 46530], [34, 46610], [37, 46770], [45, 47350], [50, 47470], [53, 47630]]}, {"verse": 8, "start": 48660, "end": 55332, "text": "El amor nunca deja de ser: pero las profecías se han de acabar, y cesarán las lenguas, y el conocimiento será quitado;", "words": [[0, 48660], [3, 48787], [8, 49027], [14, 49347], [19, 49647], [22, 49807], [27, 50403], [32, 50527], [36, 50687], [46, 51347], [49, 51547], [53, 51687], [56, 51807], [64, 52167], [66, 52372], [74, 52812], [78, 52952], [87, 53552], [89, 53772], [92, 53872], [105, 54532], [110, 54772]]}, {"verse": 9, "start": 55682, "end": 58362, "text": "Porque en parte conocemos, y en parte profetizamos;", "words": [[0, 55682], [7, 55847], [10, 55987], [16, 56187], [27, 56787], [29, 57067], [32, 57167], [38, 57427]]}, {"verse": 10, "start": 58712, "end": 63440, "text": "Pero cuando venga lo que es perfecto, entonces lo que es en parte será quitado.", "words": [[0, 58712], [5, 58846], [12, 59106], [18, 59566], [21, 59726], [25, 59866], [28, 60046], [38, 60986], [47, 61306], [50, 61706], [54, 61866], [57, 62066], [60, 62186], [66, 62486], [71, 62806]]}, {"verse": 11, "start": 63790, "end": 72131, "text": "Cuando yo era niño, hablaba como niño, pensaba como niño, juzgaba como niño; pero cuando ya fui hombre hecho, dejé lo que era de niño.", "words": [[0, 63790], [7, 63991], [10, 64251], [14, 64451], [20, 65131], [28, 65491], [33, 65711], [39, 66391], [47, 66771], [52, 67031], [58, 67611], [66, 67971], [71, 68211], [77, 68951], [82, 69088], [89, 69368], [92, 69608], [96, 69788], [103, 70088], [110, 70848], [115, 71128], [118, 71228], [122, 71388], [126, 71528], [129, 71668]]}, {"verse": 12, "start": 72481, "end": 80481, "text": "Ahora vemos por espejo, en obscuridad; pero entonces veremos cara a cara: ahora conozco en parte; pero entonces conoceré como soy conocido.", "words": [[0, 72481], [6, 72720], [12, 73020], [16, 73300], [24, 73760], [27, 73880], [39, 74736], [44, 74860], [53, 75220], [61, 75760], [66, 75980], [68, 76120], [74, 76704], [80, 76945], [88, 77425], [91, 77525], [98, 78224], [103, 78361], [112, 78701], [121, 79401], [126, 79581], [130, 79781]]}, {"verse": 13, "start": 80831, "end": 87371, "text": "Y ahora permanecen la fe, la esperanza, y el amor, estas tres: pero la mayor de ellas es el amor.", "words": [[0, 80831], [2, 80972], [8, 81212], [19, 82032], [22, 82172], [26, 82692], [29, 82752], [40, 83412], [42, 83672], [45, 83772], [51, 84412], [57, 84652], [63, 85443], [68, 85579], [71, 85719], [77, 85979], [80, 86179], [86, 86419], [89, 86799], [92, 86959]]}]}