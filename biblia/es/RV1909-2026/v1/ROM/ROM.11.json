{"book": "ROM", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 277524, "verses": [{"verse": 1, "start": 300, "end": 10238, "text": "Digo pues: ¿Ha desechado Dios a su pueblo? En ninguna manera. Porque también yo soy israelita, de la descendencia de Abraham, de la tribu de Benjamín.", "words": [[0, 300], [5, 576], [11, 1366], [15, 1508], [25, 2048], [30, 2308], [32, 2488], [35, 2608], [43, 3512], [46, 3656], [54, 3976], [62, 4911], [69, 5115], [77, 5495], [80, 5715], [84, 5915], [95, 6635], [98, 7035], [101, 7135], [114, 7975], [117, 8115], [126, 8975], [129, 8995], [132, 9115], [138, 9455], [141, 9555]]}, {"verse": 2, "start": 10688, "end": 19648, "text": "No ha desechado Dios a su pueblo, al cual antes conoció. ¿O no sabéis qué dice de Elías la Escritura? cómo hablando con Dios contra Israel dice:", "words": [[0, 10688], [3, 10831], [6, 10951], [16, 11491], [21, 11731], [23, 11911], [26, 12031], [34, 12751], [37, 12871], [42, 13031], [48, 13411], [57, 14379], [60, 14485], [63, 14565], [70, 15005], [74, 15165], [79, 15465], [82, 15625], [88, 16045], [91, 16165], [102, 17133], [107, 17513], [116, 17833], [120, 18113], [125, 18293], [132, 18633], [139, 19193]]}, {"verse": 3, "start": 20098, "end": 27219, "text": "Señor, han dado muerte a tus profetas, y tus altares han derribado; y yo he quedado solo, y procuran matarme.", "words": [[0, 20098], [7, 20441], [11, 20801], [16, 21021], [23, 21361], [25, 21561], [29, 21681], [39, 22261], [41, 22701], [45, 22861], [53, 23461], [57, 23681], [68, 24689], [70, 24811], [73, 24971], [76, 25111], [84, 25471], [90, 25791], [92, 26071], [101, 26551]]}, {"verse": 4, "start": 27669, "end": 36382, "text": "Pero ¿qué le dice la divina respuesta? He dejado para mí siete mil hombres, que no han doblado la rodilla delante de Baal.", "words": [[0, 27669], [5, 27832], [10, 28072], [13, 28212], [18, 28452], [21, 28612], [28, 28952], [39, 30821], [42, 30946], [49, 31466], [54, 31686], [57, 31946], [63, 32266], [67, 32606], [76, 33526], [80, 33626], [83, 33826], [87, 33986], [95, 34426], [98, 34546], [106, 35026], [114, 35526], [117, 35666]]}, {"verse": 5, "start": 36682, "end": 41172, "text": "Así también, aun en este tiempo ha quedado un remanente por la elección de gracia.", "words": [[0, 36682], [4, 36946], [13, 37546], [17, 37666], [20, 37846], [25, 38026], [32, 38566], [35, 38626], [43, 39046], [46, 39186], [56, 39706], [60, 39946], [63, 40066], [72, 40466], [75, 40606]]}, {"verse": 6, "start": 41622, "end": 51518, "text": "Y si por gracia, luego no por las obras; de otra manera la gracia ya no es gracia. Y si por las obras, ya no es gracia; de otra manera la obra ya no es obra.", "words": [[0, 41622], [2, 41728], [5, 41827], [9, 42027], [17, 42448], [23, 42628], [26, 42887], [30, 43088], [34, 43247], [41, 44130], [44, 44232], [49, 44392], [56, 44892], [59, 44972], [66, 45412], [69, 45552], [72, 45732], [75, 45892], [83, 46735], [85, 46834], [88, 46934], [92, 47154], [96, 47314], [103, 47914], [106, 48154], [109, 48294], [112, 48454], [120, 49369], [123, 49488], [128, 49648], [135, 50188], [138, 50268], [143, 50528], [146, 50748], [149, 50908], [152, 51088]]}, {"verse": 7, "start": 51968, "end": 59673, "text": "¿Qué pues? Lo que buscaba Israel aquello no ha alcanzado; pero la elección lo ha alcanzado: y los demás fueron endurecidos;", "words": [[0, 51968], [5, 52092], [11, 52930], [14, 53031], [18, 53131], [26, 53491], [33, 53891], [41, 54291], [44, 54411], [47, 54471], [58, 55449], [63, 55571], [66, 55731], [75, 56171], [78, 56331], [81, 56451], [92, 57610], [94, 57715], [98, 57855], [104, 58195], [111, 58940]]}, {"verse": 8, "start": 60123, "end": 68254, "text": "Como está escrito: Les dio Dios espíritu de aturdimiento, ojos con que no vean, y oídos con que no oigan, hasta el día de hoy.", "words": [[0, 60123], [5, 60301], [10, 60541], [19, 61477], [23, 61603], [27, 61863], [32, 62163], [41, 62783], [44, 62883], [58, 63963], [63, 64263], [67, 64523], [71, 64643], [74, 64803], [80, 65423], [82, 65723], [88, 66163], [92, 66343], [96, 66483], [99, 66663], [106, 67083], [112, 67403], [115, 67563], [119, 67743], [122, 67903]]}, {"verse": 9, "start": 68704, "end": 73928, "text": "Y David dice: Les sea vuelta su mesa en lazo, y en red, y en tropezadero, y en paga:", "words": [[0, 68704], [2, 68853], [8, 69093], [14, 70029], [18, 70099], [22, 70339], [29, 70619], [32, 70859], [37, 71099], [40, 71239], [46, 71659], [48, 71819], [51, 71969], [56, 72119], [58, 72439], [61, 72559], [74, 73199], [76, 73379], [79, 73499]]}, {"verse": 10, "start": 74378, "end": 79009, "text": "Sus ojos sean obscurecidos para que no vean, y agóbiales siempre el espinazo.", "words": [[0, 74378], [4, 74517], [9, 74797], [14, 75077], [27, 75837], [32, 76137], [36, 76297], [39, 76437], [45, 76897], [47, 77117], [57, 77777], [65, 78077], [68, 78297]]}, {"verse": 11, "start": 79459, "end": 89433, "text": "Digo pues: ¿Han tropezado para que cayesen? En ninguna manera; pero por el tropiezo de ellos vino la salvación a los Gentiles, para que fuesen provocados a celos.", "words": [[0, 79459], [5, 79717], [11, 80546], [16, 80704], [26, 81304], [31, 81524], [35, 81964], [44, 82660], [47, 82797], [55, 83077], [63, 83972], [68, 84093], [72, 84380], [75, 84666], [84, 84953], [87, 85093], [93, 85373], [98, 85653], [101, 85833], [111, 86353], [113, 86453], [117, 86553], [127, 87333], [132, 87633], [136, 87773], [143, 88113], [154, 88733], [156, 88893]]}, {"verse": 12, "start": 89883, "end": 97625, "text": "Y si la falta de ellos es la riqueza del mundo, y el menoscabo de ellos la riqueza de los Gentiles, ¿cuánto más la plenitud de ellos?", "words": [[0, 89883], [2, 89990], [5, 90070], [8, 90210], [14, 90470], [17, 90690], [23, 90890], [26, 91110], [29, 91270], [37, 91670], [41, 91850], [48, 92250], [50, 92930], [53, 93050], [63, 93590], [66, 93750], [72, 93970], [75, 94130], [83, 94550], [86, 94670], [90, 94790], [100, 95770], [108, 96170], [112, 96330], [115, 96510], [124, 96950], [127, 97150]]}, {"verse": 13, "start": 98075, "end": 104897, "text": "Porque a vosotros hablo, Gentiles. Por cuanto pues, yo soy apóstol de los Gentiles, mi ministerio honro,", "words": [[0, 98075], [7, 98258], [9, 98378], [18, 98758], [25, 99178], [35, 100396], [39, 100562], [46, 100902], [52, 101602], [55, 101702], [59, 101862], [67, 102502], [70, 102582], [74, 102702], [84, 103662], [87, 103762], [98, 104402]]}, {"verse": 14, "start": 105347, "end": 110333, "text": "Por si en alguna manera provocase a celos a mi carne, e hiciese salvos a algunos de ellos.", "words": [[0, 105347], [4, 105483], [7, 105643], [10, 105723], [17, 105923], [24, 106363], [34, 107023], [36, 107223], [42, 107523], [44, 107623], [47, 107703], [54, 108063], [56, 108463], [64, 108843], [71, 109323], [73, 109463], [81, 109723], [84, 109963]]}, {"verse": 15, "start": 110783, "end": 119139, "text": "Porque si el rechazo de ellos es la reconciliación del mundo, ¿qué será el recibimiento de ellos, sino vida de los muertos?", "words": [[0, 110783], [7, 110979], [10, 111179], [13, 111319], [21, 111819], [24, 111999], [30, 112239], [33, 112499], [36, 112659], [51, 113499], [55, 113699], [62, 114559], [67, 114679], [72, 114979], [75, 115139], [88, 115799], [91, 115999], [98, 116479], [103, 116739], [108, 117019], [111, 117179], [115, 117299]]}, {"verse": 16, "start": 119589, "end": 126387, "text": "Y si el primer fruto es santo, también lo es el todo, y si la raíz es santa, también lo son las ramas.", "words": [[0, 119589], [2, 119716], [5, 119836], [8, 119936], [15, 120196], [21, 120636], [24, 120836], [31, 121556], [39, 121876], [42, 122116], [45, 122296], [48, 122416], [54, 123176], [56, 123256], [59, 123376], [62, 123536], [67, 123896], [70, 124036], [77, 125136], [85, 125216], [88, 125396], [92, 125616], [96, 125756]]}, {"verse": 17, "start": 126837, "end": 137674, "text": "Que si algunas de las ramas fueron quebradas, y tú, siendo olivo silvestre, has sido injertado en lugar de ellas, y has sido hecho participante de la raíz y del rico alimento del olivo;", "words": [[0, 126837], [4, 126911], [7, 127051], [15, 127351], [18, 127571], [22, 127731], [28, 128151], [35, 128391], [46, 129051], [48, 129291], [52, 129971], [59, 130251], [65, 130731], [76, 131211], [80, 131691], [85, 131951], [95, 132591], [98, 132691], [104, 132871], [107, 133131], [114, 133871], [116, 133961], [120, 134091], [125, 134291], [131, 134551], [144, 135371], [147, 135531], [150, 135651], [155, 136091], [157, 136251], [161, 136391], [166, 136631], [175, 137031], [179, 137251]]}, {"verse": 18, "start": 138124, "end": 144674, "text": "No te jactes contra las ramas; y si te jactas, sabe que no sustentas tú a la raíz, sino la raíz a ti.", "words": [[0, 138124], [3, 138229], [6, 138369], [13, 138809], [20, 139029], [24, 139269], [31, 140129], [33, 140231], [36, 140351], [39, 140491], [47, 141311], [52, 141651], [56, 141811], [59, 141931], [69, 142511], [72, 142691], [74, 142811], [77, 142891], [83, 143321], [88, 143751], [91, 143871], [96, 144231], [98, 144391]]}, {"verse": 19, "start": 145124, "end": 148651, "text": "Pues las ramas, dirás, fueron quebradas para que yo fuese injertado.", "words": [[0, 145124], [5, 145212], [9, 145392], [16, 145892], [23, 146392], [30, 146552], [40, 147112], [45, 147392], [49, 147552], [52, 147692], [58, 147932]]}, {"verse": 20, "start": 149101, "end": 156019, "text": "Bien: por su incredulidad fueron quebradas, pero tú por la fe estás en pie. No te ensoberbezcas, antes teme,", "words": [[0, 149101], [6, 149786], [10, 149893], [13, 150053], [26, 150733], [33, 150993], [44, 151973], [49, 152193], [52, 152373], [56, 152613], [59, 152753], [62, 152933], [68, 153173], [71, 153393], [76, 154081], [79, 154407], [82, 154767], [97, 155127], [103, 155447]]}, {"verse": 21, "start": 156469, "end": 161782, "text": "Que si Dios no libró del corte a las ramas naturales, puede que tampoco te libre a ti.", "words": [[0, 156508], [4, 156568], [7, 156728], [12, 156987], [15, 157348], [21, 157767], [25, 157888], [31, 158388], [33, 158468], [37, 158608], [43, 158968], [54, 159987], [60, 160308], [64, 160528], [72, 160828], [75, 161088], [81, 161348], [83, 161568]]}, {"verse": 22, "start": 162232, "end": 174392, "text": "Mira, pues, la bondad y la severidad de Dios: la severidad ciertamente en los que cayeron; pero la bondad para contigo, si permaneces en esa bondad; pues de otra manera tú también serás cortado.", "words": [[0, 162232], [6, 162432], [12, 162712], [15, 163232], [22, 163832], [24, 163952], [27, 164052], [37, 164632], [40, 164772], [46, 165593], [49, 165699], [59, 166339], [71, 167079], [74, 167199], [78, 167299], [82, 167459], [91, 168307], [96, 168445], [99, 168585], [106, 168925], [111, 169085], [120, 169705], [123, 170105], [134, 170745], [137, 170925], [141, 171065], [149, 171958], [154, 172065], [157, 172245], [162, 172425], [169, 172945], [172, 173045], [180, 173305], [186, 173765]]}, {"verse": 23, "start": 174842, "end": 182266, "text": "Y aun ellos, si no permanecen en incredulidad, serán injertados; que poderoso es Dios para volverlos a injertar.", "words": [[0, 174842], [2, 174963], [6, 175103], [13, 175503], [16, 175663], [19, 175743], [30, 176363], [33, 176443], [47, 177423], [53, 177683], [65, 179562], [69, 179643], [78, 180223], [81, 180363], [86, 180623], [91, 180983], [101, 181503], [103, 181643]]}, {"verse": 24, "start": 182716, "end": 196646, "text": "Porque si tú fuiste cortado de un olivo silvestre, al que por naturaleza pertenecías, y contra lo natural fuiste injertado en el buen olivo, ¿cuánto más estos, que son las ramas naturales, serán injertados en su propio olivo?", "words": [[0, 182716], [7, 182944], [10, 183144], [13, 183304], [20, 183664], [28, 184224], [31, 184364], [34, 184524], [40, 184804], [51, 185904], [54, 186024], [58, 186164], [62, 186384], [73, 187064], [86, 187904], [88, 188184], [95, 188484], [98, 188644], [106, 189064], [113, 189484], [123, 190124], [126, 190244], [129, 190364], [134, 190544], [141, 191444], [149, 191824], [153, 191984], [160, 192915], [164, 192997], [168, 193157], [172, 193337], [178, 193677], [189, 194557], [195, 194997], [206, 195577], [209, 195717], [212, 195857], [219, 196117]]}, {"verse": 25, "start": 197096, "end": 209204, "text": "Porque no quiero, hermanos, que ignoréis este misterio, para que no seáis acerca de vosotros mismos arrogantes: que el endurecimiento en parte ha acontecido en Israel, hasta que haya entrado la plenitud de los Gentiles;", "words": [[0, 197096], [7, 197280], [10, 197420], [18, 197640], [28, 198260], [32, 198400], [41, 198880], [46, 199080], [56, 199740], [61, 200140], [65, 200300], [68, 200500], [74, 200700], [81, 201140], [84, 201360], [93, 201760], [100, 202020], [112, 203254], [116, 203356], [119, 203476], [134, 204256], [137, 204376], [143, 204736], [146, 205036], [157, 205716], [160, 205816], [168, 206236], [174, 206876], [178, 207076], [183, 207256], [191, 207656], [194, 207776], [203, 208196], [206, 208336], [210, 208436]]}, {"verse": 26, "start": 209654, "end": 216954, "text": "Y así todo Israel será salvo; como está escrito: Vendrá de Sion el Libertador, que quitará de Jacob la impiedad;", "words": [[0, 209654], [2, 209736], [6, 209916], [11, 210156], [18, 210556], [23, 210836], [30, 211691], [35, 211855], [40, 212075], [49, 212941], [56, 213191], [59, 213477], [64, 213764], [67, 213904], [79, 214564], [83, 214964], [91, 215404], [94, 215524], [100, 215804], [103, 216084]]}, {"verse": 27, "start": 217404, "end": 221463, "text": "Y este es mi pacto con ellos, cuando yo quite sus pecados.", "words": [[0, 217404], [2, 217565], [7, 217805], [10, 217985], [13, 218105], [19, 218585], [23, 218745], [30, 219485], [37, 219725], [40, 220005], [46, 220285], [50, 220465]]}, {"verse": 28, "start": 221763, "end": 229983, "text": "Así que, cuanto al evangelio, son enemigos por causa de vosotros: pero cuanto a la elección, son muy amados por causa de los padres.", "words": [[0, 221763], [4, 222005], [9, 222185], [16, 222485], [19, 222705], [30, 223445], [34, 223765], [43, 224425], [47, 224725], [53, 225025], [56, 225265], [66, 226220], [71, 226381], [78, 226621], [80, 226841], [83, 226901], [93, 227661], [97, 227901], [101, 228141], [108, 228541], [112, 228761], [118, 229041], [121, 229261], [125, 229381]]}, {"verse": 29, "start": 230433, "end": 233480, "text": "Porque irrevocables son los dones y el llamado de Dios.", "words": [[0, 230433], [7, 230653], [20, 231353], [24, 231573], [28, 231733], [34, 232193], [36, 232373], [39, 232473], [47, 232773], [50, 232993]]}, {"verse": 30, "start": 233930, "end": 242142, "text": "Porque como también vosotros en algún tiempo no creísteis a Dios, pero ahora habéis alcanzado misericordia por la incredulidad de ellos;", "words": [[0, 233930], [7, 234155], [12, 234415], [20, 234795], [29, 235355], [32, 235535], [38, 235755], [45, 236135], [48, 236415], [58, 237095], [60, 237195], [66, 237855], [71, 238175], [77, 238475], [84, 238835], [94, 239515], [107, 240355], [111, 240535], [114, 240655], [127, 241415], [130, 241615]]}, {"verse": 31, "start": 242592, "end": 249953, "text": "Así también estos ahora no han creído, para que, por la misericordia para con vosotros, ellos también alcancen misericordia.", "words": [[0, 242592], [4, 242812], [12, 243232], [18, 243532], [24, 243892], [27, 244112], [31, 244252], [39, 244732], [44, 245312], [49, 245472], [53, 245672], [56, 245792], [69, 246612], [74, 246812], [78, 247052], [88, 247612], [94, 248132], [102, 248472], [111, 249032]]}, {"verse": 32, "start": 250403, "end": 255130, "text": "Porque Dios encerró a todos en incredulidad, para tener misericordia de todos.", "words": [[0, 250403], [7, 250585], [12, 250885], [20, 251505], [22, 251605], [28, 251825], [31, 252085], [45, 252845], [50, 253405], [56, 253665], [69, 254465], [72, 254565]]}, {"verse": 33, "start": 255580, "end": 263675, "text": "¡Oh profundidad de las riquezas de la sabiduría y del conocimiento de Dios! ¡Cuán incomprensibles son sus juicios, e inescrutables sus caminos!", "words": [[0, 255617], [4, 255697], [16, 256337], [19, 256477], [23, 256597], [32, 257077], [35, 257237], [38, 257357], [48, 257997], [50, 258117], [54, 258237], [67, 258897], [70, 259077], [76, 259939], [82, 260122], [98, 260882], [102, 261122], [106, 261322], [115, 261862], [117, 262062], [131, 262802], [135, 263002]]}, {"verse": 34, "start": 264125, "end": 267853, "text": "Porque ¿quién entendió la mente del Señor? ¿o quién fue su consejero?", "words": [[0, 264125], [7, 264292], [14, 264512], [23, 265032], [26, 265152], [32, 265372], [36, 265572], [43, 266479], [46, 266564], [52, 266704], [56, 266924], [59, 267044]]}, {"verse": 35, "start": 268303, "end": 271046, "text": "¿O quién le dio a él primero, para que le sea pagado?", "words": [[0, 268303], [3, 268407], [9, 268607], [12, 268807], [16, 269007], [18, 269127], [21, 269247], [30, 269647], [35, 269967], [39, 270117], [42, 270267], [46, 270427]]}, {"verse": 36, "start": 271496, "end": 277124, "text": "Porque de él, y por él, y en él, son todas las cosas. A él sea gloria por siglos. Amén.", "words": [[0, 271496], [7, 271673], [10, 271913], [14, 272093], [16, 272213], [20, 272393], [24, 272593], [26, 272793], [29, 272953], [33, 273133], [37, 273393], [43, 273633], [47, 273873], [54, 274757], [56, 274885], [59, 275045], [63, 275245], [70, 275685], [74, 275845], [82, 276705]]}]}