{"book": "ACT", "chapter": 14, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 243416, "verses": [{"verse": 1, "start": 300, "end": 12506, "text": "Y aconteció en Iconio, que entrados juntamente en la sinagoga de los judíos, hablaron de tal manera, que creyó una grande multitud de judíos, y asimismo de griegos.", "words": [[0, 300], [2, 400], [12, 1100], [15, 1480], [23, 1860], [27, 2660], [36, 3300], [47, 4300], [50, 4460], [53, 4600], [62, 5240], [65, 5380], [69, 5540], [77, 6380], [86, 6960], [89, 7120], [93, 7340], [101, 7800], [105, 8125], [111, 8585], [115, 8765], [122, 9285], [131, 9805], [134, 10005], [142, 10665], [144, 11005], [153, 11705], [156, 11745]]}, {"verse": 2, "start": 12856, "end": 20246, "text": "Pero los judíos que fueron incrédulos, incitaron y corrompieron los ánimos de los Gentiles contra los hermanos.", "words": [[0, 12856], [5, 13022], [9, 13162], [16, 13702], [20, 13822], [27, 14062], [39, 14862], [49, 16322], [51, 16682], [64, 17502], [68, 17682], [75, 18162], [78, 18282], [82, 18362], [91, 18862], [98, 19202], [102, 19422]]}, {"verse": 3, "start": 20596, "end": 32660, "text": "Con todo eso permanecieron allí mucho tiempo, confiados en el Señor, el cual daba testimonio a la palabra de su gracia, dando que señales y milagros fuesen hechos por las manos de ellos.", "words": [[0, 20596], [4, 20759], [9, 20999], [13, 21339], [27, 21946], [32, 22554], [38, 22834], [46, 23274], [56, 23974], [59, 24214], [62, 24354], [69, 25214], [72, 25354], [77, 25514], [82, 25914], [93, 26794], [95, 26874], [98, 26954], [106, 27274], [109, 27474], [112, 27654], [120, 28577], [126, 28937], [130, 29137], [138, 29717], [140, 29857], [149, 30397], [156, 30837], [163, 31237], [167, 31450], [171, 31664], [177, 31877], [180, 32077]]}, {"verse": 4, "start": 33010, "end": 40122, "text": "Pero la población de la ciudad estaba dividida; y unos eran con los judíos, y otros con los apóstoles.", "words": [[0, 33010], [5, 33175], [8, 33335], [18, 33775], [21, 34055], [24, 34175], [31, 34475], [38, 35015], [48, 36164], [50, 36348], [55, 36508], [60, 36848], [64, 37068], [68, 37248], [76, 37908], [78, 38368], [84, 38668], [88, 39028], [92, 39188]]}, {"verse": 5, "start": 40472, "end": 47427, "text": "Y intentando los judíos y los Gentiles, junto con sus dirigentes, maltratarlos y apedrearlos.", "words": [[0, 40472], [2, 40472], [13, 41375], [17, 41555], [24, 42095], [26, 42235], [30, 42355], [40, 43035], [46, 43415], [50, 43755], [54, 43955], [66, 44975], [79, 46015], [81, 46375]]}, {"verse": 6, "start": 47777, "end": 56152, "text": "Al enterarse, los apóstoles huyeron a Listra y Derbe, ciudades de Licaonia, y por toda la tierra alrededor.", "words": [[0, 47777], [3, 47946], [14, 48566], [18, 48766], [28, 49506], [36, 50306], [38, 50406], [45, 50866], [47, 51006], [54, 51786], [63, 52446], [66, 52626], [76, 53326], [78, 53886], [82, 54086], [87, 54366], [90, 54606], [97, 55006]]}, {"verse": 7, "start": 56502, "end": 58787, "text": "Y allí predicaban el evangelio.", "words": [[0, 56502], [2, 56640], [7, 56880], [18, 57760], [21, 57940]]}, {"verse": 8, "start": 59137, "end": 67916, "text": "Y un hombre de Listra, sin fuerza en los pies, estaba sentado, cojo desde el vientre de su madre, que jamás había andado.", "words": [[0, 59137], [2, 59266], [5, 59386], [12, 59726], [15, 59946], [23, 60806], [27, 61026], [34, 61466], [37, 61726], [41, 61846], [47, 62566], [54, 62786], [63, 63574], [68, 64361], [74, 64501], [77, 64851], [85, 65201], [88, 65321], [91, 65521], [98, 66341], [102, 66571], [108, 66801], [114, 67141]]}, {"verse": 9, "start": 68266, "end": 75004, "text": "Este oyó hablar a Pablo; el cual, como puso los ojos en él, y vio que tenía fe para ser sano,", "words": [[0, 68520], [5, 68786], [9, 69053], [16, 69352], [18, 69512], [25, 70326], [28, 70506], [34, 70726], [39, 71086], [44, 71486], [48, 71646], [53, 71946], [56, 72266], [60, 72446], [62, 72926], [66, 73146], [70, 73266], [76, 73586], [79, 73886], [84, 74146], [88, 74366]]}, {"verse": 10, "start": 75354, "end": 81092, "text": "Dijo a gran voz: Levántate derecho sobre tus pies. Y saltó, y anduvo.", "words": [[0, 75354], [5, 75722], [7, 76082], [12, 76262], [17, 77095], [27, 77654], [35, 77994], [41, 78354], [45, 78594], [51, 79430], [53, 79556], [60, 80016], [62, 80496]]}, {"verse": 11, "start": 81442, "end": 91707, "text": "Entonces la gente, visto lo que Pablo había hecho, alzó la voz, diciendo en lengua licaónica: Dioses semejantes a hombres han descendido a nosotros.", "words": [[0, 81442], [9, 81902], [12, 82222], [19, 82622], [25, 82842], [28, 83062], [32, 83182], [38, 83582], [44, 83882], [51, 84335], [56, 84789], [59, 85242], [64, 85962], [73, 86422], [76, 86702], [83, 87524], [94, 88511], [101, 88958], [112, 89538], [114, 89738], [122, 89978], [126, 90338], [137, 90938], [139, 91018]]}, {"verse": 12, "start": 91987, "end": 98363, "text": "Y a Bernabé llamaban Júpiter, y a Pablo, Mercurio, porque era el que llevaba la palabra.", "words": [[0, 91987], [2, 92205], [4, 92459], [12, 92712], [21, 93172], [30, 93772], [32, 94012], [34, 94132], [41, 95212], [51, 96292], [58, 96472], [62, 96792], [65, 96972], [69, 97132], [77, 97532], [80, 97692]]}, {"verse": 13, "start": 98713, "end": 109802, "text": "Y el sacerdote de Júpiter, que estaba delante de la ciudad de ellos, trayendo toros y guirnaldas delante de las puertas, quería con el pueblo sacrificar.", "words": [[0, 98713], [2, 98850], [5, 99010], [15, 99750], [18, 99930], [27, 100890], [31, 101010], [38, 101290], [46, 101870], [49, 102070], [52, 102190], [59, 102530], [62, 102850], [69, 103630], [78, 104230], [84, 104850], [86, 105110], [97, 105930], [105, 106370], [108, 106530], [112, 106650], [121, 107550], [128, 107830], [132, 108190], [135, 108330], [142, 108790]]}, {"verse": 14, "start": 110152, "end": 119014, "text": "Y como lo oyeron los apóstoles Bernabé y Pablo, rotas sus ropas, se lanzaron hacia la multitud, dando voces,", "words": [[0, 110152], [2, 110273], [7, 110553], [10, 110773], [17, 111253], [21, 111393], [31, 112333], [39, 112873], [41, 113033], [48, 113763], [54, 114493], [58, 114673], [65, 115613], [68, 115753], [77, 116393], [83, 116713], [86, 116973], [96, 118013], [102, 118273]]}, {"verse": 15, "start": 119364, "end": 134979, "text": "Y diciendo: Varones, ¿por qué hacéis esto? Nosotros también somos hombres semejantes a vosotros, que os anunciamos que de estas vanidades os convirtáis al Dios vivo, que hizo el cielo y la tierra, y el mar, y todo lo que está en ellos:", "words": [[0, 119364], [2, 119488], [12, 120946], [21, 121396], [26, 121676], [30, 121956], [37, 122236], [43, 123122], [52, 123610], [60, 123950], [66, 124390], [74, 124910], [85, 125630], [87, 125830], [97, 126610], [101, 126870], [104, 127010], [115, 127610], [119, 127830], [122, 127990], [128, 128250], [138, 128830], [141, 129030], [152, 129710], [155, 129890], [160, 130090], [166, 130830], [170, 130930], [175, 131210], [178, 131410], [184, 131650], [186, 131850], [189, 131950], [197, 132270], [199, 132550], [202, 132670], [207, 133245], [209, 133373], [214, 133633], [217, 133873], [221, 133993], [226, 134213], [229, 134413]]}, {"verse": 16, "start": 135329, "end": 140092, "text": "El cual en las edades pasadas ha dejado a todas las gentes andar en sus caminos;", "words": [[0, 135329], [3, 135487], [8, 135727], [11, 135907], [15, 136067], [22, 136467], [30, 137067], [33, 137307], [40, 137727], [42, 137847], [48, 138047], [52, 138327], [59, 138767], [65, 139047], [68, 139247], [72, 139387]]}, {"verse": 17, "start": 140442, "end": 150053, "text": "Si bien no se dejó a sí mismo sin testimonio, haciendo bien, dándonos lluvias del cielo y tiempos fructíferos, llenando de alimento y de alegría nuestros corazones.", "words": [[0, 140442], [3, 140575], [8, 140795], [11, 140975], [14, 141116], [19, 141456], [21, 141575], [24, 141676], [30, 142035], [34, 142295], [46, 143336], [55, 143656], [61, 144456], [70, 144915], [78, 145295], [82, 145456], [88, 145776], [90, 145975], [98, 146355], [111, 147436], [120, 147795], [123, 147915], [132, 148295], [134, 148475], [137, 148535], [145, 148915], [154, 149075]]}, {"verse": 18, "start": 150333, "end": 156492, "text": "Y diciendo estas cosas, apenas apaciguaron el pueblo, para que no les ofreciesen sacrificio.", "words": [[0, 150333], [2, 150478], [11, 150918], [17, 151178], [24, 151718], [31, 152418], [43, 153438], [46, 153618], [54, 154078], [59, 154373], [63, 154533], [66, 154733], [70, 155123], [81, 155513]]}, {"verse": 19, "start": 156842, "end": 170102, "text": "Entonces sobrevinieron unos judíos de Antioquía y de Iconio, que persuadieron a la multitud, y habiendo apedreado a Pablo, le sacaron fuera de la ciudad, pensando que estaba muerto.", "words": [[0, 156842], [9, 157778], [23, 158710], [28, 159150], [35, 159750], [38, 159890], [48, 160650], [50, 160770], [53, 160890], [61, 162130], [65, 162190], [78, 162970], [80, 163130], [83, 163210], [93, 163890], [95, 164390], [104, 164650], [114, 165270], [116, 165410], [123, 166290], [126, 166370], [134, 166850], [140, 167170], [143, 167410], [146, 167550], [154, 168390], [163, 168830], [167, 169070], [174, 169330]]}, {"verse": 20, "start": 170452, "end": 178461, "text": "Pero rodeándole los discípulos, se levantó y entró en la ciudad; y un día después, salió con Bernabé a Derbe.", "words": [[0, 170452], [5, 170675], [16, 171675], [20, 171855], [32, 172835], [35, 173055], [43, 173755], [45, 173955], [51, 174375], [54, 174495], [57, 174615], [65, 175549], [67, 175657], [70, 175737], [74, 175917], [83, 176257], [89, 177017], [93, 177389], [101, 177761], [103, 178133]]}, {"verse": 21, "start": 178811, "end": 188315, "text": "Y cuando hubieron anunciado el evangelio a aquella ciudad, y enseñado a muchos, volvieron a Listra, y a Iconio, y a Antioquía,", "words": [[0, 178811], [2, 178932], [9, 179172], [18, 179572], [28, 180392], [31, 180552], [41, 181212], [43, 181352], [51, 181592], [59, 181972], [61, 182297], [70, 182957], [72, 183077], [80, 183977], [90, 184417], [92, 184857], [100, 185297], [102, 185797], [104, 185877], [112, 186797], [114, 187157], [116, 187237]]}, {"verse": 22, "start": 188665, "end": 200399, "text": "Fortaleciendo los ánimos de los discípulos, exhortándoles a que permaneciesen en la fe, y que es necesario que por muchas tribulaciones entremos en el reino de Dios.", "words": [[0, 188665], [14, 189452], [18, 189692], [25, 190152], [28, 190272], [32, 190412], [44, 192152], [58, 192672], [60, 192892], [64, 193032], [78, 193952], [81, 194172], [84, 194372], [88, 195072], [90, 195152], [94, 195292], [97, 195492], [107, 196352], [111, 196612], [115, 196832], [122, 197192], [136, 198032], [145, 198872], [148, 199052], [151, 199232], [157, 199672], [160, 199832]]}, {"verse": 23, "start": 200749, "end": 211760, "text": "Y habiéndoles constituido ancianos en cada una de las iglesias, y habiendo orado con ayunos, los encomendaron al Señor en el cual habían creído.", "words": [[0, 200749], [2, 200892], [14, 201512], [26, 202412], [35, 203132], [38, 203392], [43, 203672], [47, 204032], [50, 204192], [54, 204392], [64, 205192], [66, 205752], [75, 206172], [81, 206732], [85, 206972], [93, 208152], [97, 208252], [110, 209092], [113, 209292], [119, 209572], [122, 209932], [125, 210072], [130, 210332], [137, 210892]]}, {"verse": 24, "start": 212110, "end": 215080, "text": "Y pasando por Pisidia vinieron a Panfilia.", "words": [[0, 212110], [2, 212236], [10, 212576], [14, 212916], [22, 213596], [31, 214036], [33, 214571]]}, {"verse": 25, "start": 215430, "end": 219738, "text": "Y habiendo predicado la palabra en Perge, descendieron a Atalia;", "words": [[0, 215430], [2, 215550], [11, 215870], [21, 216590], [24, 216730], [32, 217154], [35, 217578], [42, 218002], [55, 218745], [57, 218945]]}, {"verse": 26, "start": 220088, "end": 227832, "text": "Y de allí navegaron a Antioquía, donde habían sido encomendados a la gracia de Dios para la obra que habían acabado.", "words": [[0, 220088], [2, 220235], [5, 220335], [10, 220655], [20, 221495], [22, 221595], [33, 222615], [39, 222875], [46, 223255], [51, 223595], [64, 224495], [66, 224675], [69, 224735], [76, 225235], [79, 225395], [84, 225635], [89, 225975], [92, 226175], [97, 226535], [101, 226795], [108, 227075]]}, {"verse": 27, "start": 228182, "end": 239406, "text": "Y habiendo llegado, y reunido la iglesia, relataron cuán grandes cosas había Dios hecho con ellos, y cómo había abierto a los Gentiles la puerta de la fe.", "words": [[0, 228182], [2, 228290], [11, 228650], [20, 229130], [22, 229230], [30, 229770], [33, 229910], [42, 231170], [52, 231850], [57, 232250], [65, 232710], [71, 233230], [77, 233810], [82, 234170], [88, 234450], [92, 234730], [99, 235490], [101, 235830], [106, 236090], [112, 236390], [120, 236950], [122, 237110], [126, 237230], [135, 237990], [138, 238450], [145, 238750], [148, 238970], [151, 239090]]}, {"verse": 28, "start": 239756, "end": 243016, "text": "Y se quedaron allí mucho tiempo con los discípulos.", "words": [[0, 239756], [2, 239883], [5, 240023], [14, 240563], [19, 240803], [25, 241203], [32, 241663], [36, 242003], [40, 242123]]}]}