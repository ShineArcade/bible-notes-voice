{"book": "MAT", "chapter": 1, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 184868, "verses": [{"verse": 1, "start": 300, "end": 5076, "text": "The book of the generation of Jesus Christ, the son of David, the son of Abraham.", "words": [[0, 300], [4, 388], [9, 568], [12, 728], [16, 828], [27, 1368], [30, 1628], [36, 1928], [44, 2808], [48, 2888], [52, 3148], [55, 3248], [62, 3908], [66, 4008], [70, 4228], [73, 4348]]}, {"verse": 2, "start": 5426, "end": 10957, "text": "Abraham begot Isaac; and Isaac begot Jacob; and Jacob begot Judas and his brethren;", "words": [[0, 5426], [8, 5888], [14, 6308], [21, 7093], [25, 7215], [31, 7515], [37, 7935], [44, 8722], [48, 8842], [54, 9142], [60, 9582], [66, 9922], [70, 10202], [74, 10342]]}, {"verse": 3, "start": 11307, "end": 18233, "text": "And Judas begot Phares and Zara of Thamar; and Phares begot Esrom; and Esrom begot Aram;", "words": [[0, 11307], [4, 11615], [10, 11955], [16, 12363], [23, 12770], [27, 13100], [32, 13430], [35, 13864], [43, 14457], [47, 14700], [54, 14981], [60, 15656], [67, 16475], [71, 16810], [77, 17180], [83, 17730]]}, {"verse": 4, "start": 18583, "end": 24671, "text": "And Aram begot Aminadab; and Aminadab begot Naasson; and Naasson begot Salmon;", "words": [[0, 18583], [4, 18900], [9, 19250], [15, 19985], [25, 20883], [29, 21228], [38, 21608], [44, 22205], [53, 22960], [57, 23284], [65, 23644], [71, 24044]]}, {"verse": 5, "start": 25021, "end": 31248, "text": "And Salmon begot Booz of Rachab; and Booz begot Obed of Ruth; and Obed begot Jesse;", "words": [[0, 25021], [4, 25168], [11, 25568], [17, 26128], [22, 26688], [25, 27164], [33, 27786], [37, 28046], [42, 28306], [48, 28706], [53, 29066], [56, 29226], [62, 29796], [66, 29933], [71, 30213], [77, 30653]]}, {"verse": 6, "start": 31598, "end": 37341, "text": "And Jesse begot David the king; and David the king begot Solomon of her that had been the wife of Urias;", "words": [[0, 31598], [4, 31727], [10, 31987], [16, 32447], [22, 32727], [26, 32927], [32, 33627], [36, 33753], [42, 34033], [46, 34193], [51, 34413], [57, 34793], [65, 35213], [68, 35493], [72, 35673], [77, 35853], [81, 35993], [86, 36153], [90, 36273], [95, 36473], [98, 36633]]}, {"verse": 7, "start": 37691, "end": 43619, "text": "And Solomon begot Roboam; and Roboam begot Abia; and Abia begot Asa;", "words": [[0, 37691], [4, 37837], [12, 38257], [18, 38812], [26, 39587], [30, 40033], [37, 40510], [43, 40988], [49, 41630], [53, 41774], [58, 42414], [64, 43053]]}, {"verse": 8, "start": 43969, "end": 50089, "text": "And Asa begot Josaphat; and Josaphat begot Joram; and Joram begot Ozias;", "words": [[0, 43969], [4, 44114], [8, 44494], [14, 45180], [24, 46020], [28, 46403], [37, 46823], [43, 47283], [50, 48156], [54, 48436], [60, 48876], [66, 49483]]}, {"verse": 9, "start": 50439, "end": 56623, "text": "And Ozias begot Joatham; and Joatham begot Achaz; and Achaz begot Ezekias;", "words": [[0, 50439], [4, 50743], [10, 51083], [16, 51641], [25, 52366], [29, 52759], [37, 53159], [43, 53754], [50, 54568], [54, 54729], [60, 55189], [66, 55943]]}, {"verse": 10, "start": 56973, "end": 64423, "text": "And Ezekias begot Manasses; and Manasses begot Amon; and Amon begot Josias;", "words": [[0, 56973], [4, 57115], [12, 57819], [18, 58522], [28, 59383], [32, 59779], [41, 60189], [47, 60996], [53, 61967], [57, 62464], [62, 63004], [68, 63745]]}, {"verse": 11, "start": 64773, "end": 70908, "text": "And Josias begot Jechonias and his brethren, about the time they were carried away to Babylon:", "words": [[0, 64773], [4, 64936], [11, 65516], [17, 66116], [27, 66716], [31, 66896], [35, 67056], [45, 67496], [51, 68036], [55, 68276], [60, 68556], [65, 68756], [70, 68896], [78, 69236], [83, 69536], [86, 69736]]}, {"verse": 12, "start": 71258, "end": 77880, "text": "And after they were brought to Babylon, Jechonias begot Salathiel; and Salathiel begot Zorobabel;", "words": [[0, 71258], [4, 71421], [10, 71721], [15, 71901], [20, 72061], [28, 72321], [31, 72501], [40, 73211], [50, 73921], [56, 74604], [67, 75436], [71, 75986], [81, 76566], [87, 77251]]}, {"verse": 13, "start": 78230, "end": 85062, "text": "And Zorobabel begot Abiud; and Abiud begot Eliakim; and Eliakim begot Azor;", "words": [[0, 78230], [4, 78673], [14, 79153], [20, 79766], [27, 80558], [31, 80907], [37, 81297], [43, 81941], [52, 82741], [56, 83362], [64, 84022], [70, 84482]]}, {"verse": 14, "start": 85412, "end": 91251, "text": "And Azor begot Sadoc; and Sadoc begot Achim; and Achim begot Eliud;", "words": [[0, 85412], [4, 85614], [9, 86094], [15, 86729], [22, 87542], [26, 87989], [32, 88490], [38, 88991], [45, 89635], [49, 89898], [55, 90198], [61, 90759]]}, {"verse": 15, "start": 91601, "end": 97235, "text": "And Eliud begot Eleazar; and Eleazar begot Matthan; and Matthan begot Jacob;", "words": [[0, 91601], [4, 91947], [10, 92327], [16, 92908], [25, 93662], [29, 93977], [37, 94327], [43, 94892], [52, 95616], [56, 95903], [64, 96233], [70, 96613]]}, {"verse": 16, "start": 97585, "end": 103822, "text": "And Jacob begot Joseph the husband of Mary, of whom was born Jesus, who is called Christ.", "words": [[0, 97585], [4, 97757], [10, 98137], [16, 98637], [23, 99037], [27, 99277], [35, 99577], [38, 99837], [44, 100577], [47, 100777], [52, 100977], [56, 101217], [61, 101557], [68, 102617], [72, 102697], [75, 102817], [82, 103137]]}, {"verse": 17, "start": 104172, "end": 118115, "text": "So all the generations from Abraham to David are fourteen generations; and from David until the carrying away into Babylon are fourteen generations; and from the carrying away into Babylon to Christ are fourteen generations.", "words": [[0, 104172], [3, 104312], [7, 104592], [11, 104752], [23, 105292], [28, 105632], [36, 106072], [39, 106392], [45, 106752], [49, 107132], [58, 107512], [71, 108857], [75, 108986], [80, 109146], [86, 109506], [92, 109806], [96, 110026], [105, 110366], [110, 110706], [115, 110966], [123, 111406], [127, 111836], [136, 112266], [149, 113582], [153, 113724], [158, 113884], [162, 114024], [171, 114404], [176, 114724], [181, 114984], [189, 115384], [192, 115784], [199, 116244], [203, 116594], [212, 116944]]}, {"verse": 18, "start": 118465, "end": 128304, "text": "¶ Now the birth of Jesus Christ was in this way: When as his mother Mary was espoused to Joseph, before they came together, she was found with child of the Holy Spirit.", "words": [[2, 118465], [6, 118689], [10, 118869], [16, 119089], [19, 119269], [25, 119549], [32, 119969], [36, 120349], [39, 120549], [44, 120789], [49, 121509], [54, 121696], [57, 121816], [61, 121956], [68, 122256], [73, 122636], [77, 122876], [86, 123436], [89, 123616], [97, 124016], [104, 124436], [109, 124696], [114, 124956], [124, 125876], [128, 125996], [132, 126156], [138, 126436], [143, 126676], [149, 127036], [152, 127276], [156, 127396], [161, 127616]]}, {"verse": 19, "start": 128654, "end": 135939, "text": "Then Joseph her husband, being a just man, and not willing to make her a public example, was minded to put her away privately.", "words": [[0, 128654], [5, 128884], [12, 129424], [16, 129464], [25, 130144], [31, 130344], [33, 130504], [38, 130644], [43, 131004], [47, 131524], [51, 131684], [59, 131924], [62, 132124], [67, 132324], [71, 132484], [73, 132564], [80, 132844], [89, 133744], [93, 134024], [100, 134344], [103, 134564], [107, 134744], [111, 134924], [116, 135184]]}, {"verse": 20, "start": 136289, "end": 148945, "text": "But while he thought on these things, behold, the angel of the Lord appeared to him in a dream, saying, Joseph, you son of David, fear not to take to you Mary your wife: for that which is conceived in her is of the Holy Spirit.", "words": [[0, 136289], [4, 136431], [10, 136671], [13, 136851], [21, 137131], [24, 137311], [30, 137511], [38, 138311], [46, 139211], [50, 139271], [56, 139651], [59, 139831], [63, 139951], [68, 140151], [77, 140531], [80, 140751], [84, 140931], [87, 141051], [89, 141151], [96, 141491], [104, 142456], [112, 142712], [116, 142972], [120, 143252], [123, 143372], [130, 143952], [135, 144132], [139, 144332], [142, 144512], [147, 144712], [150, 144872], [154, 145132], [159, 145392], [164, 145612], [170, 146282], [174, 146362], [179, 146522], [185, 146742], [188, 146882], [198, 147262], [201, 147502], [205, 147642], [208, 147862], [211, 147962], [215, 148062], [220, 148322]]}, {"verse": 21, "start": 149295, "end": 155608, "text": "And she shall bring forth a son, and you shall call his name JESUS: for he shall save his people from their sins.", "words": [[0, 149295], [4, 149433], [8, 149593], [14, 149813], [20, 150033], [26, 150293], [28, 150513], [33, 151173], [37, 151433], [41, 151573], [47, 151753], [52, 151973], [56, 152193], [61, 152473], [68, 153388], [72, 153495], [75, 153635], [81, 153815], [86, 154155], [90, 154335], [97, 154655], [102, 154875], [108, 155075]]}, {"verse": 22, "start": 155888, "end": 162144, "text": "Now all this was done, that it might be fulfilled which was spoken of the Lord by the prophet, saying,", "words": [[0, 155888], [4, 156091], [8, 156411], [13, 156631], [17, 156791], [23, 157631], [28, 157811], [31, 157931], [37, 158131], [40, 158371], [50, 159091], [56, 159231], [60, 159411], [67, 159791], [70, 159991], [74, 160131], [79, 160371], [82, 160631], [86, 160771], [95, 161431]]}, {"verse": 23, "start": 162494, "end": 172123, "text": "Behold, a virgin shall be with child, and shall bring forth a son, and they shall call his name Emmanuel, which being interpreted is, God with us.", "words": [[0, 162494], [8, 162990], [10, 163030], [17, 163350], [23, 163670], [26, 163870], [31, 164050], [38, 165110], [42, 165150], [48, 165370], [54, 165650], [60, 165930], [62, 166150], [67, 167010], [71, 167090], [76, 167190], [82, 167370], [87, 167610], [91, 167850], [96, 168130], [106, 169350], [112, 169530], [118, 169830], [130, 170450], [134, 170810], [138, 171390], [143, 171670]]}, {"verse": 24, "start": 172473, "end": 178636, "text": "Then Joseph being raised from sleep did as the angel of the Lord had bidden him, and took to him his wife:", "words": [[0, 172473], [5, 172681], [12, 173261], [18, 173461], [25, 173841], [30, 174121], [36, 174696], [40, 174836], [43, 175016], [47, 175196], [53, 175516], [56, 175736], [60, 175876], [65, 176116], [69, 176356], [76, 176716], [81, 176916], [85, 177416], [90, 177656], [93, 177856], [97, 178036], [101, 178216]]}, {"verse": 25, "start": 178986, "end": 184468, "text": "And knew her not till she had brought forth her firstborn son: and he called his name JESUS.", "words": [[0, 178986], [4, 179149], [9, 179389], [13, 179569], [17, 179849], [22, 180129], [26, 180329], [30, 180509], [38, 180729], [44, 181069], [48, 181269], [58, 181909], [63, 182787], [67, 182912], [70, 183012], [77, 183292], [81, 183492], [86, 183732]]}]}