{"book": "1CO", "chapter": 3, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 135814, "verses": [{"verse": 1, "start": 300, "end": 6354, "text": "And I, brethren, could not speak to you as to spiritual, but as to carnal, even as to babes in Christ.", "words": [[0, 300], [4, 463], [7, 803], [17, 1623], [23, 1723], [27, 1923], [33, 2183], [36, 2363], [40, 2543], [43, 2643], [46, 2763], [57, 3643], [61, 3763], [64, 3903], [67, 4023], [75, 4803], [80, 4963], [83, 5143], [86, 5243], [92, 5663], [95, 5783]]}, {"verse": 2, "start": 6704, "end": 12870, "text": "I have fed you with milk, and not with food: for until now you were not able to bear it, neither yet now are you able.", "words": [[0, 6704], [2, 6848], [7, 6988], [11, 7188], [15, 7348], [20, 7468], [26, 7728], [30, 8128], [34, 8328], [39, 8528], [45, 9200], [49, 9309], [55, 9569], [59, 9929], [63, 10149], [68, 10249], [72, 10429], [77, 10689], [80, 10829], [85, 11049], [89, 11389], [97, 11609], [101, 11869], [105, 12169], [109, 12309], [113, 12469]]}, {"verse": 3, "start": 13220, "end": 20040, "text": "For you are yet carnal: for whereas there is among you envying, and strife, and divisions, are you not carnal, and walk as men?", "words": [[0, 13220], [4, 13348], [8, 13528], [12, 13648], [16, 13828], [24, 14627], [28, 14734], [36, 15014], [42, 15234], [45, 15414], [51, 15782], [55, 16148], [64, 16514], [68, 16574], [76, 17234], [80, 17294], [91, 18094], [95, 18194], [99, 18334], [103, 18454], [111, 18974], [115, 19188], [120, 19402], [123, 19614]]}, {"verse": 4, "start": 20390, "end": 25943, "text": "For while one says, I am of Paul; and another, I am of Apollos; are you not carnal?", "words": [[0, 20390], [4, 20503], [10, 20653], [14, 20853], [20, 21550], [22, 21715], [25, 21835], [28, 21975], [34, 22700], [38, 22822], [47, 23480], [49, 23671], [52, 23791], [55, 23931], [64, 24894], [68, 25043], [72, 25163], [76, 25303]]}, {"verse": 5, "start": 26293, "end": 32155, "text": "Who then is Paul, and who is Apollos, but ministers by whom you believed, even as the Lord gave to every man?", "words": [[0, 26293], [4, 26394], [9, 26574], [12, 26734], [18, 27114], [22, 27514], [26, 27634], [29, 27734], [38, 28534], [42, 28674], [52, 28994], [55, 29314], [60, 29494], [64, 29654], [74, 30354], [79, 30574], [82, 30754], [86, 30894], [91, 31094], [96, 31334], [99, 31534], [105, 31714]]}, {"verse": 6, "start": 32505, "end": 35750, "text": "I have planted, Apollos watered; but God gave the increase.", "words": [[0, 32505], [2, 32667], [7, 32787], [16, 33107], [24, 33667], [33, 34369], [37, 34512], [41, 34752], [46, 35012], [50, 35172]]}, {"verse": 7, "start": 36100, "end": 41114, "text": "So then neither is he that plants any thing, neither he that waters; but God that gives the increase.", "words": [[0, 36100], [3, 36241], [8, 36401], [16, 36661], [19, 36901], [22, 37041], [27, 37201], [34, 37581], [38, 37961], [45, 38341], [53, 38601], [56, 38861], [61, 39041], [69, 39788], [73, 39889], [77, 40089], [82, 40249], [88, 40409], [92, 40569]]}, {"verse": 8, "start": 41464, "end": 47209, "text": "Now he that plants and he that waters are one: and every man shall receive his own reward according to his own labour.", "words": [[0, 41464], [4, 41630], [7, 41840], [12, 42000], [19, 42220], [23, 42400], [26, 42580], [31, 42720], [38, 42980], [42, 43180], [47, 43789], [51, 43909], [57, 44109], [61, 44409], [67, 44629], [75, 45009], [79, 45249], [83, 45449], [90, 45869], [100, 46189], [103, 46489], [107, 46609], [111, 46934]]}, {"verse": 9, "start": 47559, "end": 51699, "text": "For we are labourers together with God: you are God’s field, you are God’s building.", "words": [[0, 47559], [4, 47681], [7, 47841], [11, 48141], [21, 48441], [30, 48721], [35, 49021], [40, 49587], [44, 49687], [48, 49767], [54, 50127], [61, 50767], [65, 50767], [69, 50847], [75, 51207]]}, {"verse": 10, "start": 52049, "end": 62389, "text": "According to the grace of God which is given to me, as a wise masterbuilder, I have laid the foundation, and another builds on it. But let every man take heed how he builds thereupon.", "words": [[0, 52049], [10, 52346], [13, 52586], [17, 52706], [23, 52906], [26, 53086], [30, 53346], [36, 53606], [39, 53726], [45, 53906], [48, 54106], [52, 54326], [55, 54746], [57, 54866], [62, 55546], [77, 56226], [79, 56346], [84, 56546], [89, 56786], [93, 56946], [105, 57446], [109, 57946], [117, 58226], [124, 58526], [127, 58866], [131, 59346], [135, 59502], [139, 59722], [145, 60122], [149, 60381], [154, 60682], [159, 60982], [163, 61222], [166, 61402], [173, 61701]]}, {"verse": 11, "start": 62739, "end": 66882, "text": "For other foundation can no man lay than that is laid, which is Jesus Christ.", "words": [[0, 62739], [4, 62852], [10, 63112], [21, 63612], [25, 63872], [28, 64092], [32, 64292], [36, 64532], [41, 64712], [46, 64912], [49, 65032], [55, 65312], [61, 65792], [64, 65912], [70, 66232]]}, {"verse": 12, "start": 67232, "end": 72517, "text": "Now if any man build upon this foundation gold, silver, precious stones, wood, hay, stubble;", "words": [[0, 67232], [4, 67412], [7, 67672], [11, 67972], [15, 68192], [21, 68432], [26, 68652], [31, 68872], [42, 69252], [48, 69912], [56, 70352], [65, 70592], [73, 71212], [79, 71712], [84, 72032]]}, {"verse": 13, "start": 72867, "end": 83168, "text": "Every man’s work shall be made manifest: for the day shall declare it, because it shall be revealed by fire; and the fire shall try every man’s work of what sort it is.", "words": [[0, 73996], [6, 74176], [12, 74516], [17, 74696], [23, 74896], [26, 75036], [31, 75296], [41, 76217], [45, 76294], [49, 76414], [53, 76634], [59, 76894], [67, 77294], [71, 77854], [79, 78074], [82, 78294], [88, 78494], [91, 78634], [100, 79054], [103, 79314], [109, 80045], [113, 80170], [117, 80270], [122, 80550], [128, 80830], [132, 81090], [138, 81450], [144, 81830], [149, 82010], [152, 82210], [157, 82370], [162, 82610], [165, 82770]]}, {"verse": 14, "s