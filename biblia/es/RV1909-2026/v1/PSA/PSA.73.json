{"book": "PSA", "chapter": 73, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 170612, "verses": [{"verse": 1, "start": 300, "end": 6477, "text": "Salmo de Asaf. CIERTAMENTE bueno es Dios a Israel, a los limpios de corazón.", "words": [[0, 300], [6, 764], [9, 924], [15, 1807], [27, 2573], [33, 2873], [36, 3312], [41, 3713], [43, 4072], [51, 4913], [53, 4953], [57, 5113], [65, 5613], [68, 5732]]}, {"verse": 2, "start": 6927, "end": 13071, "text": "Mas yo, casi se deslizaron mis pies; por poco resbalaron mis pasos.", "words": [[0, 6927], [4, 7174], [8, 7634], [13, 7974], [16, 8274], [27, 9034], [31, 9314], [37, 10277], [41, 10611], [46, 11371], [57, 12090], [61, 12311]]}, {"verse": 3, "start": 13521, "end": 19237, "text": "Porque tuve envidia de los insensatos, viendo la prosperidad de los impíos.", "words": [[0, 13521], [7, 13740], [12, 14160], [20, 14920], [23, 15040], [27, 15180], [39, 16300], [46, 16660], [49, 16920], [61, 17900], [64, 18100], [68, 18694]]}, {"verse": 4, "start": 19687, "end": 24708, "text": "Porque no hay ataduras para su muerte; antes su fortaleza está entera.", "words": [[0, 19687], [7, 19891], [10, 20111], [14, 20251], [23, 20711], [28, 20951], [31, 21131], [39, 22170], [45, 22575], [48, 23075], [58, 23634], [63, 24193]]}, {"verse": 5, "start": 25158, "end": 30306, "text": "No están ellos en el trabajo humano; ni son azotados con los otros hombres.", "words": [[0, 25158], [3, 25478], [9, 25698], [15, 25978], [18, 26198], [21, 26338], [29, 26698], [37, 27921], [40, 28081], [44, 28241], [53, 28881], [57, 29081], [61, 29261], [67, 29541]]}, {"verse": 6, "start": 30756, "end": 35529, "text": "Por tanto soberbia los corona: se cubren de vestido de violencia.", "words": [[0, 30756], [4, 30882], [10, 31242], [19, 31962], [23, 32401], [31, 33086], [34, 33380], [41, 33710], [44, 33890], [52, 34430], [55, 34550]]}, {"verse": 7, "start": 35979, "end": 41509, "text": "Sus ojos están salidos de gordura: logran con creces los antojos del corazón.", "words": [[0, 35979], [4, 36102], [9, 36422], [15, 36762], [23, 37222], [26, 37382], [35, 38368], [42, 38992], [46, 39152], [53, 39772], [57, 39992], [65, 40573], [69, 40732]]}, {"verse": 8, "start": 41959, "end": 47970, "text": "Se soltaron, y hablan con maldad de hacer violencia; hablan con altanería.", "words": [[0, 41959], [3, 42117], [13, 42837], [15, 43117], [22, 43557], [26, 43737], [33, 44337], [36, 44617], [42, 44857], [53, 46269], [60, 46707], [64, 46907]]}, {"verse": 9, "start": 48420, "end": 52203, "text": "Ponen en el cielo su boca, y su lengua pasea la tierra.", "words": [[0, 48420], [6, 48787], [9, 49027], [12, 49187], [18, 49507], [21, 49807], [27, 50187], [29, 50387], [32, 50487], [39, 50927], [45, 51347], [48, 51467]]}, {"verse": 10, "start": 52653, "end": 58189, "text": "Por eso su pueblo vuelve aquí, y aguas de lleno les son exprimidas.", "words": [[0, 52653], [4, 52755], [8, 53055], [11, 53755], [18, 54115], [25, 54575], [31, 54815], [33, 55235], [39, 55655], [42, 55775], [48, 56195], [52, 56615], [56, 56955]]}, {"verse": 11, "start": 58639, "end": 62763, "text": "Y dicen: ¿Cómo sabe Dios? ¿y hay conocimiento en lo alto?", "words": [[0, 58639], [2, 58767], [9, 59686], [15, 59867], [20, 60167], [26, 60989], [29, 61110], [33, 61230], [46, 61990], [49, 62130], [52, 62250]]}, {"verse": 12, "start": 63113, "end": 68847, "text": "He aquí estos impíos, sin ser turbados del mundo, alcanzaron riquezas.", "words": [[0, 63158], [3, 63238], [8, 63478], [14, 63738], [22, 64678], [26, 64978], [30, 65258], [39, 65918], [43, 66138], [50, 67078], [61, 67858]]}, {"verse": 13, "start": 69297, "end": 74800, "text": "Verdaderamente en vano he limpiado mi corazón, y lavado mis manos en inocencia;", "words": [[0, 69297], [15, 70122], [18, 70342], [23, 70642], [26, 70722], [35, 71262], [38, 71402], [47, 71862], [49, 72522], [56, 72882], [60, 73042], [66, 73402], [69, 73702]]}, {"verse": 14, "start": 75250, "end": 80812, "text": "Pues he sido azotado todo el día, y empezaba mi castigo por las mañanas.", "words": [[0, 75250], [5, 75414], [8, 75574], [13, 75914], [21, 76654], [26, 76894], [29, 77174], [34, 77514], [36, 78094], [45, 78834], [48, 79014], [56, 79634], [60, 79834], [64, 79994]]}, {"verse": 15, "start": 81262, "end": 87475, "text": "Si dijera yo, Discurriré de esa suerte; he aquí habría negado la nación de tus hijos:", "words": [[0, 81262], [3, 81541], [10, 82041], [14, 82641], [25, 83301], [28, 83381], [32, 83561], [40, 84634], [43, 84714], [48, 84974], [55, 85514], [62, 85974], [65, 86094], [72, 86474], [75, 86654], [79, 86794]]}, {"verse": 16, "start": 87925, "end": 92616, "text": "Pensaré pues para saber esto: es a mis ojos duro trabajo,", "words": [[0, 87925], [8, 88308], [13, 89068], [18, 89288], [24, 89608], [30, 90444], [33, 90643], [35, 90723], [39, 90883], [44, 91123], [49, 91803]]}, {"verse": 17, "start": 93066, "end": 97612, "text": "Hasta que venido al santuario de Dios, entenderé el fin de ellos.", "words": [[0, 93066], [6, 93346], [10, 93486], [17, 93866], [20, 94006], [30, 94706], [33, 94906], [39, 95186], [49, 96306], [52, 96506], [56, 96786], [59, 97046]]}, {"verse": 18, "start": 98062, "end": 104233, "text": "Ciertamente los has puesto en deslizaderos; en asolamientos los harás caer.", "words": [[0, 98062], [12, 98803], [16, 99043], [20, 99243], [27, 99763], [30, 100243], [44, 101833], [47, 102118], [60, 102858], [64, 103238], [70, 103698]]}, {"verse": 19, "start": 104683, "end": 110820, "text": "¡Cómo han sido asolados! ¡cuán en un punto! Se acabaron, fenecieron con turbaciones.", "words": [[0, 104683], [6, 104892], [10, 105092], [15, 105432], [25, 106738], [31, 106838], [34, 107038], [37, 107178], [44, 108168], [47, 108313], [57, 108853], [68, 109531], [72, 110208]]}, {"verse": 20, "start": 111270, "end": 117993, "text": "Como sueño del que despierta, así, Señor, cuando despiertes, menospreciarás sus apariencias.", "words": [[0, 111270], [5, 111434], [11, 111814], [15, 112194], [19, 112294], [30, 113214], [35, 113754], [42, 114294], [49, 114434], [61, 116114], [76, 116634], [80, 116934]]}, {"verse": 21, "start": 118443, "end": 123582, "text": "Se amargó en verdad mi corazón, y en mis riñones sentía punzadas.", "words": [[0, 118443], [3, 118590], [10, 119030], [13, 119130], [20, 119510], [23, 119770], [32, 120290], [34, 120990], [37, 121150], [41, 121370], [49, 122150], [56, 122650]]}, {"verse": 22, "start": 124032, "end": 129148, "text": "Mas yo era ignorante, y no entendía: era como una bestia acerca de ti.", "words": [[0, 124091], [4, 124191], [7, 124371], [11, 124571], [22, 125451], [24, 125651], [27, 125811], [37, 126917], [41, 127087], [46, 127407], [50, 127647], [57, 128187], [64, 128487], [67, 128787]]}, {"verse": 23, "start": 129598, "end": 133927, "text": "Con todo, yo siempre estuve contigo: trabaste de mi mano derecha.", "words": [[0, 129598], [4, 129722], [10, 130002], [13, 130202], [21, 130582], [28, 130962], [37, 131987], [46, 132529], [49, 132709], [52, 132889], [57, 133149]]}, {"verse": 24, "start": 134377, "end": 138834, "text": "Me has guiado según tu consejo, y después me recibirás en gloria.", "words": [[0, 134377], [3, 134502], [7, 134662], [14, 135102], [20, 135382], [23, 135622], [32, 136342], [34, 136762], [42, 137042], [45, 137503], [55, 137964], [58, 138425]]}, {"verse": 25, "start": 139284, "end": 144396, "text": "¿A quién tengo yo en los cielos? Y fuera de ti nada deseo en la tierra.", "words": [[0, 139284], [3, 139383], [9, 139563], [15, 139963], [18, 140243], [21, 140563], [25, 140723], [33, 141802], [35, 141931], [41, 142171], [44, 142411], [47, 142591], [52, 143031], [58, 143471], [61, 143571], [64, 143711]]}, {"verse": 26, "start": 144846, "end": 152612, "text": "Mi carne y mi corazón desfallecen: mas la roca de mi corazón y mi porción es Dios para siempre.", "words": [[0, 144846], [3, 144990], [9, 145430], [11, 145990], [14, 146110], [22, 146590], [35, 148242], [39, 148450], [42, 148930], [47, 149290], [50, 149450], [53, 149550], [61, 149910], [63, 150210], [66, 150330], [74, 150810], [77, 151170], [82, 151550], [87, 151910]]}, {"verse": 27, "start": 153062, "end": 160602, "text": "Porque he aquí, los que se alejan de ti perecerán: tú cortarás a todo aquel que fornicando, de ti se aparta.", "words": [[0, 153062], [7, 153196], [10, 153366], [16, 153886], [20, 154146], [24, 154306], [27, 154446], [34, 154906], [37, 155086], [40, 155626], [51, 156416], [54, 156540], [63, 157180], [65, 157280], [70, 157560], [76, 158000], [80, 158450], [92, 158900], [95, 159560], [98, 159740], [101, 159920]]}, {"verse": 28, "start": 161052, "end": 170212, "text": "Y en cuanto a mí, el acercarme a Dios es el bien: he puesto en el Señor Jehová mi esperanza, para contar todas tus obras.", "words": [[0, 161052], [2, 161143], [5, 161263], [12, 161523], [14, 161743], [18, 162383], [21, 162523], [31, 163183], [33, 163303], [38, 163623], [41, 164143], [44, 164303], [50, 165137], [53, 165246], [60, 165546], [63, 165766], [66, 165926], [72, 166166], [79, 166746], [82, 166846], [93, 167606], [98, 168346], [105, 168726], [111, 169166], [115, 169446]]}]}