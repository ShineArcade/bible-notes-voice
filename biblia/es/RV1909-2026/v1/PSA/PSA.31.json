{"book": "PSA", "chapter": 31, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 189364, "verses": [{"verse": 1, "start": 300, "end": 10195, "text": "Al Músico principal: Salmo de David. EN ti, oh Jehová, he esperado; no sea yo confundido para siempre: líbrame en tu justicia.", "words": [[0, 300], [3, 480], [10, 960], [21, 2083], [27, 2561], [30, 2721], [37, 3485], [40, 3671], [44, 3991], [47, 4311], [55, 5071], [58, 5231], [68, 6202], [71, 6362], [75, 6556], [78, 6749], [89, 7429], [94, 7649], [103, 8767], [111, 8967], [114, 9167], [117, 9367]]}, {"verse": 2, "start": 10545, "end": 18027, "text": "Inclina a mí tu oído, líbrame pronto; sé para mí roca de fortaleza, por casa fuerte para salvarme.", "words": [[0, 11015], [8, 11485], [10, 11585], [13, 11725], [16, 11905], [22, 12585], [30, 13265], [38, 14293], [41, 14501], [46, 14701], [49, 14881], [54, 15281], [57, 15421], [68, 16161], [72, 16361], [77, 16541], [84, 16941], [89, 17221]]}, {"verse": 3, "start": 18377, "end": 25248, "text": "Porque tú eres mi roca y mi castillo; y por tu nombre me guiarás, y me encaminarás.", "words": [[0, 18377], [7, 18581], [10, 19107], [15, 19367], [18, 19787], [23, 20327], [25, 20567], [28, 20707], [38, 21715], [40, 21813], [44, 21973], [47, 22173], [54, 22533], [57, 23013], [66, 23753], [68, 24073], [71, 24213]]}, {"verse": 4, "start": 25598, "end": 30843, "text": "Me sacarás de la red que han escondido para mí; porque tú eres mi fortaleza.", "words": [[0, 25598], [3, 25727], [11, 26287], [14, 26387], [17, 26507], [21, 26727], [25, 27007], [29, 27127], [39, 27727], [44, 27947], [48, 28618], [55, 28825], [58, 29125], [63, 29485], [66, 29845]]}, {"verse": 5, "start": 31193, "end": 37034, "text": "En tu mano encomiendo mi espíritu: tú me has redimido, oh Jehová, Dios de verdad.", "words": [[0, 31193], [3, 31361], [6, 31481], [11, 31781], [22, 32441], [25, 32661], [35, 33630], [38, 33714], [41, 33874], [45, 34034], [55, 34734], [58, 34954], [66, 35734], [71, 35974], [74, 36334]]}, {"verse": 6, "start": 37384, "end": 43521, "text": "Aborrecí a los que esperan en vanidades ilusorias; mas yo en Jehová he esperado.", "words": [[0, 37724], [9, 38064], [11, 38324], [15, 38464], [19, 38624], [27, 39204], [30, 39464], [40, 39964], [51, 41402], [55, 41630], [58, 41970], [61, 42150], [68, 42470], [71, 42790]]}, {"verse": 7, "start": 43871, "end": 51325, "text": "Me gozaré y alegraré en tu misericordia; porque has visto mi aflicción; has conocido mi alma en las angustias.", "words": [[0, 43871], [3, 44071], [10, 44631], [12, 44771], [21, 45391], [24, 45531], [27, 45631], [41, 47029], [48, 47189], [52, 47349], [58, 47529], [61, 47749], [72, 48737], [76, 48878], [85, 49518], [88, 49718], [93, 49998], [96, 50158], [100, 50298]]}, {"verse": 8, "start": 51675, "end": 57361, "text": "Y no me encerraste en mano del enemigo; hiciste estar mis pies en anchura.", "words": [[0, 51675], [2, 51800], [5, 51960], [8, 52120], [19, 53040], [22, 53280], [27, 53620], [31, 53880], [40, 54967], [48, 55494], [54, 55794], [58, 56014], [63, 56314], [66, 56534]]}, {"verse": 9, "start": 57711, "end": 65924, "text": "Ten misericordia de mí, oh Jehová, que estoy en angustia: se han consumido de pesar mis ojos, mi alma, y mis entrañas.", "words": [[0, 57711], [4, 57874], [17, 58774], [20, 58934], [24, 59261], [27, 59587], [35, 59914], [39, 59974], [45, 60234], [48, 60434], [58, 61445], [61, 61612], [65, 61752], [75, 62532], [78, 62672], [84, 62952], [88, 63272], [94, 64152], [97, 64252], [103, 64552], [105, 64837], [109, 64977]]}, {"verse": 10, "start": 66274, "end": 76984, "text": "Porque mi vida se va gastando de dolor, y mis años de suspirar: se ha enflaquecido mi fuerza a causa de mi iniquidad, y mis huesos se han consumido.", "words": [[0, 66274], [7, 66462], [10, 66662], [15, 66942], [18, 67122], [21, 67262], [30, 67822], [33, 67982], [40, 68362], [42, 68842], [46, 69062], [51, 69342], [54, 69542], [64, 70489], [67, 70657], [70, 70817], [83, 71597], [86, 71777], [93, 72197], [95, 72577], [101, 72877], [104, 73157], [107, 73337], [118, 74137], [120, 74577], [124, 74797], [131, 75617], [134, 75917], [138, 76077]]}, {"verse": 11, "start": 77334, "end": 87299, "text": "De todos mis enemigos he sido deshonra, y de mis vecinos en gran manera, y horror a mis conocidos: los que me veían fuera, huían de mí.", "words": [[0, 77334], [3, 77478], [9, 77718], [13, 77998], [22, 78618], [25, 78798], [30, 79368], [40, 79938], [42, 80378], [45, 80518], [49, 80658], [57, 81218], [60, 81438], [65, 81678], [73, 82178], [75, 82818], [82, 83118], [84, 83398], [88, 83558], [99, 84822], [103, 84928], [107, 85088], [110, 85248], [116, 85708], [123, 86108], [129, 86793], [132, 87013]]}, {"verse": 12, "start": 87649, "end": 93575, "text": "He sido olvidado de su corazón como un muerto: he venido a ser como un vaso perdido.", "words": [[0, 87649], [3, 87771], [8, 88051], [17, 88831], [20, 89011], [23, 89171], [31, 89671], [36, 89821], [39, 89971], [47, 90946], [50, 91070], [57, 91510], [59, 91650], [63, 91890], [68, 92130], [71, 92350], [76, 92790]]}, {"verse": 13, "start": 93925, "end": 102897, "text": "Porque he oído afrenta de muchos; miedo por todas partes, cuando consultaban juntos contra mí, e ideaban quitarme la vida.", "words": [[0, 93925], [7, 94188], [10, 94468], [15, 94808], [23, 95428], [26, 95548], [34, 96591], [40, 96953], [44, 97193], [50, 97493], [58, 98473], [65, 98693], [77, 99513], [84, 99833], [91, 100293], [95, 100573], [97, 101193], [105, 101713], [114, 102313], [117, 102433]]}, {"verse": 14, "start": 103247, "end": 108229, "text": "Mas yo en ti confié, oh Jehová: yo dije: Dios mío eres tú.", "words": [[0, 103247], [4, 103247], [7, 103437], [10, 103617], [13, 103797], [21, 104367], [24, 104937], [32, 105953], [35, 106285], [41, 106838], [46, 107158], [50, 107578], [55, 107718]]}, {"verse": 15, "start": 108579, "end": 114556, "text": "En tu mano están mis tiempos: líbrame de la mano de mis enemigos, y de mis perseguidores.", "words": [[0, 108579], [3, 108763], [6, 108923], [11, 109183], [17, 109443], [21, 109683], [30, 110952], [38, 111252], [41, 111412], [44, 111552], [49, 111812], [52, 111992], [56, 112152], [66, 112812], [68, 112992], [71, 113132], [75, 113352]]}, {"verse": 16, "start": 114906, "end": 120580, "text": "Haz resplandecer tu rostro sobre tu siervo: sálvame por tu misericordia.", "words": [[0, 114906], [4, 115637], [17, 116403], [20, 116623], [27, 117223], [33, 117463], [36, 117683], [44, 118533], [52, 119055], [56, 119355], [59, 119495]]}, {"verse": 17, "start": 120930, "end": 129769, "text": "No sea yo avergonzado, oh Jehová, ya que te he invocado; sean avergonzados los impíos, estén mudos en el profundo.", "words": [[0, 120930], [3, 121056], [7, 121296], [10, 121556], [23, 122143], [26, 122729], [34, 123316], [37, 123556], [41, 123756], [44, 123936], [47, 124056], [57, 125036], [62, 125383], [75, 126423], [79, 126643], [87, 127663], [93, 128063], [99, 128603], [102, 128743], [105, 128863]]}, {"verse": 18, "start": 130119, "end": 137281, "text": "Enmudezcan los labios mentirosos, que hablan contra el justo cosas duras, con soberbia y menosprecio.", "words": [[0, 130492], [11, 130902], [15, 131102], [22, 131562], [34, 132402], [38, 132782], [45, 133182], [52, 133502], [55, 133682], [61, 133902], [67, 134322], [74, 135182], [78, 135502], [87, 136162], [89, 136402]]}, {"verse": 19, "start": 137631, "end": 147821, "text": "¡Cuán grande es tu bien, que has guardado para los que te temen, que has obrado para los que esperan en ti, delante de los hijos de los hombres!", "words": [[0, 137631], [6, 137973], [13, 138473], [16, 138733], [19, 138833], [25, 139613], [29, 139853], [33, 140033], [42, 140693], [47, 140933], [51, 141133], [55, 141293], [58, 141453], [65, 142213], [69, 142633], [73, 142833], [80, 143353], [85, 143693], [89, 143913], [93, 144073], [101, 144793], [104, 144953], [108, 145293], [116, 146153], [119, 146313], [123, 146453], [129, 146813], [132, 146953], [136, 147073]]}, {"verse": 20, "start": 148171, "end": 158317, "text": "Los esconderás en el secreto de tu rostro de las arrogancias del hombre: los pondrás en un tabernáculo a cubierto de contención de lenguas.", "words": [[0, 148171], [4, 148315], [15, 149335], [18, 149515], [21, 149655], [29, 150255], [32, 150375], [35, 150535], [42, 151175], [45, 151315], [49, 151825], [61, 152335], [65, 152575], [73, 153719], [77, 153879], [85, 154399], [88, 154599], [91, 154759], [103, 155319], [105, 155879], [114, 156439], [117, 156599], [128, 157279], [131, 157459]]}, {"verse": 21, "start": 158667, "end": 165212, "text": "Bendito Jehová, porque ha hecho maravillosa su misericordia para conmigo en ciudad fuerte.", "words": [[0, 158667], [8, 159254], [16, 160054], [23, 160414], [26, 160614], [32, 160874], [44, 162014], [47, 162214], [60, 163194], [65, 163374], [73, 163954], [76, 164074], [83, 164374]]}, {"verse": 22, "start": 165562, "end": 174165, "text": "Y decía yo en mi premura: Cortado soy de delante de tus ojos: pero tú oíste la voz de mis ruegos, cuando a ti clamaba.", "words": [[0, 165562], [2, 165856], [8, 166236], [11, 166556], [14, 166676], [17, 166856], [26, 168239], [34, 168613], [38, 168986], [41, 169046], [49, 169566], [52, 169726], [56, 169866], [62, 170566], [67, 170710], [70, 170970], [76, 171450], [79, 171590], [83, 171790], [86, 171930], [90, 172050], [98, 172670], [105, 173150], [107, 173370], [110, 173801]]}, {"verse": 23, "start": 174515, "end": 182581, "text": "Amad a Jehová todos vosotros sus santos: a los fieles guarda Jehová, y paga abundantemente al que obra con soberbia.", "words": [[0, 174669], [5, 174855], [7, 175042], [14, 175582], [20, 175742], [29, 176265], [33, 176789], [41, 177455], [43, 177674], [47, 177794], [54, 178214], [61, 178614], [69, 179234], [71, 179474], [76, 179914], [91, 180934], [94, 181114], [98, 181274], [103, 181554], [107, 181774]]}, {"verse": 24, "start": 182931, "end": 188964, "text": "Esforzaos todos vosotros los que esperáis en Jehová, y tome vuestro corazón aliento.", "words": [[0, 183303], [10, 183713], [16, 184073], [25, 184753], [29, 184973], [33, 185153], [42, 185633], [45, 185793], [53, 186633], [55, 186813], [60, 187253], [68, 187713], [76, 188113]]}]}