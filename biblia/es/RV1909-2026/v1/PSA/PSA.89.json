{"book": "PSA", "chapter": 89, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 315625, "verses": [{"verse": 1, "start": 300, "end": 10497, "text": "Masquil de Etán ezraíta. LAS misericordias de Jehová cantaré perpetuamente: en generación y generación haré notoria tu verdad con mi boca.", "words": [[0, 300], [8, 962], [11, 1202], [16, 1928], [25, 3100], [29, 3406], [43, 3713], [46, 3833], [53, 4253], [61, 4733], [76, 6300], [79, 6448], [90, 7208], [92, 7428], [103, 8168], [108, 8508], [116, 9028], [119, 9208], [126, 9408], [130, 9788], [133, 9968]]}, {"verse": 2, "start": 10497, "end": 17571, "text": "Porque dije: Para siempre será edificada misericordia; en los mismos cielos apoyarás tu verdad.", "words": [[0, 10497], [7, 10837], [13, 11577], [18, 11763], [26, 12303], [31, 12843], [41, 13723], [55, 15058], [58, 15201], [62, 15341], [69, 15621], [76, 16221], [85, 16861], [88, 16981]]}, {"verse": 3, "start": 17791, "end": 22343, "text": "Hice pacto con mi escogido; juré a David mi siervo, diciendo:", "words": [[0, 17936], [5, 18086], [11, 18606], [15, 18786], [18, 18906], [28, 20117], [33, 20463], [35, 20543], [41, 20903], [44, 21023], [52, 21603]]}, {"verse": 4, "start": 22915, "end": 29550, "text": "Para siempre confirmaré tu descendencia, y edificaré tu trono por todas las generaciones. (Selah.)", "words": [[0, 22915], [5, 23080], [13, 23480], [24, 24220], [27, 24360], [41, 25240], [43, 25700], [53, 26260], [56, 26420], [62, 26800], [66, 27020], [72, 27240], [76, 27520], [90, 29250]]}, {"verse": 5, "start": 30114, "end": 37328, "text": "Y celebrarán los cielos tu maravilla, oh Jehová; tu verdad también en la congregación de los santos.", "words": [[0, 30114], [2, 30221], [13, 31001], [17, 31141], [24, 31661], [27, 31801], [38, 32322], [41, 32844], [49, 33519], [52, 33624], [59, 33904], [67, 34604], [70, 35164], [73, 35304], [86, 36204], [89, 36404], [93, 36524]]}, {"verse": 6, "start": 37678, "end": 45104, "text": "Porque ¿quién en los cielos se igualará con Jehová? ¿quién será semejante a Jehová entre los hijos de los potentados?", "words": [[0, 37678], [7, 37940], [14, 38480], [17, 38680], [21, 38840], [28, 39380], [31, 39520], [40, 40020], [44, 40260], [52, 41130], [59, 41450], [64, 41670], [74, 42390], [76, 42530], [83, 42970], [89, 43170], [93, 43410], [99, 43730], [102, 43890], [106, 44010]]}, {"verse": 7, "start": 45454, "end": 52962, "text": "Dios temible en la grande congregación de los santos, y formidable sobre todos cuantos están alrededor suyo.", "words": [[0, 45454], [5, 45741], [13, 46501], [16, 46721], [19, 46861], [26, 47221], [39, 48081], [42, 48241], [46, 48381], [54, 49241], [56, 49731], [67, 50221], [73, 50461], [79, 50951], [87, 51441], [93, 51721], [103, 52061]]}, {"verse": 8, "start": 53312, "end": 60596, "text": "Oh Jehová, Dios de los ejércitos, ¿quién como tú? Poderoso eres, Jehová, y tu fidelidad te rodea.", "words": [[0, 53507], [3, 53733], [11, 53960], [16, 54200], [19, 54480], [23, 54640], [34, 55620], [41, 55920], [46, 56120], [50, 56888], [59, 57410], [65, 57670], [73, 58450], [75, 58710], [78, 58869], [88, 59630], [91, 59869]]}, {"verse": 9, "start": 60946, "end": 67134, "text": "Tú tienes dominio sobre la bravura del mar: cuando se levantan sus ondas, tú las sosiegas.", "words": [[0, 60946], [3, 61268], [10, 61568], [18, 62168], [24, 62408], [27, 62628], [35, 63068], [39, 63248], [44, 63840], [51, 64180], [54, 64400], [63, 64960], [67, 65160], [74, 65940], [77, 66100], [81, 66638]]}, {"verse": 10, "start": 67484, "end": 74645, "text": "Tú quebrantaste a Rahab como a un muerto: con el brazo de tu fortaleza esparciste a tus enemigos.", "words": [[0, 67484], [3, 67587], [16, 68407], [18, 68637], [24, 68867], [29, 69134], [31, 69400], [34, 69667], [42, 70709], [46, 71002], [49, 71162], [55, 71582], [58, 71702], [61, 71862], [71, 72602], [82, 73442], [84, 73582], [88, 73702]]}, {"verse": 11, "start": 74995, "end": 81530, "text": "Tuyos los cielos, tuya también la tierra: el mundo y su plenitud, tú lo fundaste.", "words": [[0, 75170], [6, 75380], [10, 75520], [18, 76080], [23, 76400], [31, 76760], [34, 77020], [42, 77993], [45, 78154], [51, 78534], [53, 78734], [56, 78894], [66, 80094], [69, 80534], [72, 80674]]}, {"verse": 12, "start": 81880, "end": 87866, "text": "Al norte y al sur tú los creaste: Tabor y Hermón cantarán en tu nombre.", "words": [[0, 81880], [3, 82090], [9, 82570], [11, 82930], [14, 83110], [18, 83713], [21, 83825], [25, 84025], [34, 85113], [40, 85438], [42, 85618], [49, 86288], [58, 86958], [61, 87118], [64, 87258]]}, {"verse": 13, "start": 88216, "end": 93818, "text": "Tuyo el brazo con valentía; fuerte es tu mano, exaltada tu diestra.", "words": [[0, 88216], [5, 88518], [8, 88658], [14, 89038], [18, 89258], [28, 90411], [35, 90848], [38, 91148], [41, 91248], [47, 92068], [56, 92828], [59, 93048]]}, {"verse": 14, "start": 94168, "end": 100384, "text": "Justicia y juicio son el asiento de tu trono: misericordia y verdad van delante de tu rostro.", "words": [[0, 94168], [9, 94727], [11, 94827], [18, 95327], [22, 95742], [25, 95942], [33, 96342], [36, 96542], [39, 96682], [46, 97537], [59, 98341], [61, 98421], [68, 98641], [72, 98961], [80, 99381], [83, 99541], [86, 99701]]}, {"verse": 15, "start": 100734, "end": 106936, "text": "Bienaventurado el pueblo que sabe aclamarte: andarán, oh Jehová, a la luz de tu rostro.", "words": [[0, 101291], [15, 101861], [18, 102001], [25, 102281], [29, 102501], [34, 103085], [45, 103829], [54, 104273], [57, 104753], [65, 105233], [67, 105433], [70, 105513], [74, 105833], [77, 106153], [80, 106293]]}, {"verse": 16, "start": 107286, "end": 112979, "text": "En tu nombre se alegrarán todo el día; y en tu justicia serán ensalzados.", "words": [[0, 107286], [3, 107450], [6, 107610], [13, 107970], [16, 108250], [26, 108970], [31, 109210], [34, 109550], [39, 110241], [41, 110481], [44, 110621], [47, 110781], [56, 111461], [62, 111861]]}, {"verse": 17, "start": 113329, "end": 119971, "text": "Porque tú eres la gloria de su fortaleza; y por tu buena voluntad acrecentarás nuestro poder.", "words": [[0, 113329], [7, 113533], [10, 113853], [15, 114233], [18, 114593], [25, 115053], [28, 115213], [31, 115393], [42, 116585], [44, 116812], [48, 116992], [51, 117152], [57, 117392], [66, 118182], [79, 118972], [87, 119132]]}, {"verse": 18, "start": 120321, "end": 125530, "text": "Porque Jehová es nuestro escudo; y nuestro rey es el Santo de Israel.", "words": [[0, 120321], [7, 120705], [14, 121125], [17, 121365], [25, 121785], [33, 123006], [35, 123092], [43, 123272], [47, 123732], [50, 124012], [53, 124152], [59, 124492], [62, 124772]]}, {"verse": 19, "start": 125880, "end": 134989, "text": "Entonces hablaste en visión a tu santo, y dijiste: Yo he puesto el socorro sobre valiente; he ensalzado un escogido de mi pueblo.", "words": [[0, 125880], [9, 126702], [18, 127642], [21, 127842], [28, 128222], [30, 128362], [33, 128442], [40, 128822], [42, 128962], [51, 129915], [54, 130047], [57, 130167], [64, 130387], [67, 130667], [75, 131107], [81, 131387], [91, 132628], [94, 132809], [104, 133469], [107, 133609], [116, 134169], [119, 134289], [122, 134409]]}, {"verse": 20, "start": 135582, "end": 139650, "text": "Hallé a David mi siervo; lo ungí con el aceite de mi santidad.", "words": [[0, 135683], [6, 135823], [8, 135963], [14, 136343], [17, 136463], [25, 137533], [28, 137790], [33, 138090], [37, 138210], [40, 138330], [47, 138630], [50, 138870], [53, 138970]]}, {"verse": 21, "start": 140235, "end": 144590, "text": "Mi mano será firme con él, mi brazo también lo fortificará.", "words": [[0, 140235], [3, 140360], [8, 140620], [13, 140900], [19, 141380], [23, 141580], [27, 142360], [30, 142540], [36, 142960], [44, 143320], [47, 143580]]}, {"verse": 22, "start": 145172, "end": 149492, "text": "No lo avasallará enemigo, ni hijo de iniquidad lo quebrantará.", "words": [[0, 145172], [3, 145372], [6, 145552], [17, 146292], [26, 147052], [29, 147452], [34, 147752], [37, 147912], [47, 148492], [50, 148652]]}, {"verse": 23, "start": 150082, "end": 155222, "text": "Mas yo quebrantaré delante de él a sus enemigos, y heriré a sus aborrecedores.", "words": [[0, 150082], [4, 150262], [7, 150502], [19, 151182], [27, 151622], [30, 151782], [33, 151942], [35, 152042], [39, 152162], [49, 152822], [51, 153382], [58, 153862], [60, 154022], [64, 154142]]}, {"verse": 24, "start": 155809, "end": 161270, "text": "Y mi verdad y mi misericordia serán con él; y en mi nombre será exaltado su cuerno.", "words": [[0, 155809], [2, 155906], [5, 155986], [12, 156366], [14, 156786], [17, 156886], [30, 157626], [36, 157946], [40, 158086], [44, 158891], [46, 159010], [49, 159110], [52, 159230], [59, 159570], [64, 159890], [73, 160570], [76, 160710]]}, {"verse": 25, "start": 161870, "end": 165680, "text": "Asimismo pondré su mano en el mar, y en los ríos su diestra.", "words": [[0, 161870], [9, 162430], [16, 162790], [19, 162930], [24, 163150], [27, 163290], [30, 163410], [35, 163630], [37, 164030], [40, 164130], [44, 164230], [49, 164730], [52, 165010]]}, {"verse": 26, "start": 166259, "end": 171980, "text": "Él me llamará: Mi padre eres tú, mi Dios, y la roca de mi salvación.", "words": [[0, 166259], [3, 166435], [6, 166555], [15, 167610], [18, 167728], [24, 168128], [29, 168368], [33, 169048], [36, 169128], [42, 169448], [44, 169713], [47, 169833], [52, 170153], [55, 170273], [58, 170373]]}, {"verse": 27, "start": 172200, "end": 176395, "text": "Yo también le pondré por primogénito, alto sobre los reyes de la tierra.", "words": [[0, 172200], [3, 172335], [11, 172575], [14, 172795], [21, 173155], [25, 173315], [38, 174415], [43, 174775], [49, 175115], [53, 175315], [59, 175655], [62, 175755], [65, 175835]]}, {"verse": 28, "start": 176975, "end": 181724, "text": "Para siempre le conservaré mi misericordia; y mi pacto será firme con él.", "words": [[0, 176975], [5, 177137], [13, 177537], [16, 177737], [27, 178337], [30, 178477], [44, 179902], [46, 179974], [49, 180084], [55, 180584], [60, 180764], [66, 181204], [70, 181364]]}, {"verse": 29, "start": 182314, "end": 187561, "text": "Y pondré su descendencia para siempre, y su trono como los días de los cielos.", "words": [[0, 182314], [2, 182421], [9, 182881], [12, 183081], [25, 183941], [30, 184161], [39, 184681], [41, 185161], [44, 185301], [50, 185781], [55, 186021], [59, 186201], [64, 186501], [67, 186721], [71, 186841]]}, {"verse": 30, "start": 188137, "end": 191672, "text": "Si dejan sus hijos mi ley, y no andan en mis juicios;", "words": [[0, 188137], [3, 188282], [9, 188662], [13, 188862], [19, 189182], [22, 189442], [27, 189722], [29, 190182], [32, 190382], [38, 190802], [41, 190922], [45, 191082]]}, {"verse": 31, "start": 192306, "end": 196075, "text": "Si profanan mis estatutos, y no guardan mis mandamientos;", "words": [[0, 192306], [3, 192455], [12, 192995], [16, 193215], [27, 193815], [29, 194395], [32, 194535], [40, 194975], [44, 195135]]}, {"verse": 32, "start": 196670, "end": 201190, "text": "Entonces visitaré con vara su rebelión, y con azotes sus iniquidades.", "words": [[0, 196670], [9, 197130], [18, 197910], [22, 198160], [27, 198410], [30, 198530], [40, 199050], [42, 199490], [46, 199770], [53, 200050], [57, 200270]]}, {"verse": 33, "start": 201768, "end": 205372, "text": "Mas no quitaré de él mi misericordia, ni falsearé mi verdad.", "words": [[0, 201768], [4, 201952], [7, 202092], [15, 202552], [18, 202652], [21, 202792], [24, 202872], [38, 203992], [41, 204342], [50, 204692], [53, 204832]]}, {"verse": 34, "start": 205989, "end": 210043, "text": "No olvidaré mi pacto, ni mudaré lo que ha salido de mis labios.", "words": [[0, 205989], [3, 206193], [12, 206673], [15, 206793], [22, 207753], [25, 207913], [32, 208313], [35, 208473], [39, 208593], [42, 208693], [49, 209073], [52, 209193], [56, 209313]]}, {"verse": 35, "start": 210629, "end": 213923, "text": "Una vez he jurado por mi santidad, que no mentiré a David.", "words": [[0, 210629], [4, 210813], [8, 211053], [11, 211233], [18, 211593], [22, 211773], [25, 211913], [35, 212753], [39, 212853], [42, 212993], [50, 213513], [52, 213553]]}, {"verse": 36, "start": 214557, "end": 219068, "text": "Su descendencia será para siempre, y su trono como el sol delante de mí.", "words": [[0, 214557], [3, 214718], [16, 215518], [21, 215738], [26, 216018], [35, 216478], [37, 216978], [40, 217118], [46, 217538], [51, 217758], [54, 217898], [58, 218098], [66, 218558], [69, 218718]]}, {"verse": 37, "start": 219649, "end": 225477, "text": "Como la luna será firme para siempre, y como un testigo fiel en el cielo. (Selah.)", "words": [[0, 219649], [5, 219813], [8, 219953], [13, 220293], [18, 220513], [24, 220973], [29, 221153], [38, 221593], [40, 222073], [45, 222293], [48, 222433], [56, 222913], [61, 223273], [64, 223413], [67, 223533], [74, 225177]]}, {"verse": 38, "start": 226040, "end": 230848, "text": "Mas tú desechaste y menospreciaste a tu ungido; y te has airado con él.", "words": [[0, 226040], [4, 226241], [7, 226441], [18, 227181], [20, 227701], [35, 228221], [37, 228381], [40, 228481], [48, 229416], [50, 229520], [53, 229760], [57, 230000], [64, 230240], [68, 230480]]}, {"verse": 39, "start": 231198, "end": 236701, "text": "Rompiste el pacto de tu siervo; has profanado su corona hasta la tierra.", "words": [[0, 231524], [9, 231884], [12, 232044], [18, 232624], [21, 232744], [24, 232904], [32, 233788], [36, 234014], [46, 234914], [49, 235134], [56, 235534], [62, 235834], [65, 236014]]}, {"verse": 40, "start": 237051, "end": 241757, "text": "Rompiste todos sus vallados; has quebrantado sus fortalezas.", "words": [[0, 237051], [9, 237631], [15, 237951], [19, 238538], [29, 239283], [33, 239538], [45, 240296], [49, 241054]]}, {"verse": 41, "start": 242107, "end": 247737, "text": "Lo saquearon todos los que pasaron por el camino: es deshonra a sus vecinos.", "words": [[0, 242107], [3, 242427], [13, 243067], [19, 243347], [23, 243587], [27, 243747], [35, 244227], [39, 244397], [42, 244567], [50, 245428], [53, 245632], [62, 246532], [64, 246732], [68, 246872]]}, {"verse": 42, "start": 248087, "end": 254406, "text": "Has exaltado la diestra de sus enemigos; has alegrado a todos sus adversarios.", "words": [[0, 248227], [4, 248367], [13, 249367], [16, 249507], [24, 249947], [27, 250147], [31, 250287], [41, 251220], [45, 251560], [54, 252360], [56, 252580], [62, 252860], [66, 253180]]}, {"verse": 43, "start": 254756, "end": 260367, "text": "Embotaste asimismo el filo de su espada, y no lo levantaste en la batalla.", "words": [[0, 254756], [10, 255532], [19, 256352], [22, 256672], [27, 257112], [30, 257212], [33, 257352], [41, 257872], [43, 258292], [46, 258452], [49, 258592], [60, 259432], [63, 259572], [66, 259712]]}, {"verse": 44, "start": 260717, "end": 265149, "text": "Hiciste cesar su brillo, y echaste su trono por tierra.", "words": [[0, 260717], [8, 261322], [14, 261822], [17, 261982], [25, 262942], [27, 263082], [35, 263522], [38, 263762], [44, 264162], [48, 264382]]}, {"verse": 45, "start": 265499, "end": 270841, "text": "Has acortado los días de su juventud; lo has cubierto de afrenta. (Selah.)", "words": [[0, 265785], [4, 266111], [13, 266438], [17, 266598], [22, 266878], [25, 267058], [28, 267238], [38, 268275], [41, 268400], [45, 268600], [54, 269180], [57, 269360], [66, 270527]]}, {"verse": 46, "start": 271191, "end": 276605, "text": "¿Hasta cuándo, oh Jehová? ¿te esconderás para siempre? ¿arderá tu ira como el fuego?", "words": [[0, 271191], [7, 271415], [15, 271755], [18, 272095], [26, 272827], [30, 272969], [41, 273609], [46, 273769], [55, 274631], [63, 275197], [66, 275357], [70, 275637], [75, 275837], [78, 275977]]}, {"verse": 47, "start": 276955, "end": 283347, "text": "Acuérdate de cuán corto sea mi tiempo: ¿por qué habrás creado en vano a todos los hijos del hombre?", "words": [[0, 276955], [10, 277519], [13, 277819], [18, 278179], [24, 278799], [28, 278999], [31, 279259], [39, 280086], [44, 280193], [48, 280453], [55, 280833], [62, 281253], [65, 281393], [70, 281753], [72, 281833], [78, 282033], [82, 282273], [88, 282553], [92, 282793]]}, {"verse": 48, "start": 283697, "end": 290112, "text": "¿Qué hombre vivirá y no verá muerte? ¿librarás su vida del poder del sepulcro? (Selah.)", "words": [[0, 283697], [5, 283825], [12, 284165], [19, 284745], [21, 284825], [24, 284985], [29, 285225], [37, 286341], [47, 286631], [50, 286911], [55, 287211], [59, 287431], [65, 287991], [69, 288291], [79, 289797]]}, {"verse": 49, "start": 290462, "end": 296036, "text": "Señor, ¿dónde están tus antiguas misericordias, que juraste a David por tu verdad?", "words": [[0, 290462], [7, 291325], [14, 291605], [20, 291845], [24, 292065], [33, 292705], [48, 294045], [52, 294125], [60, 294605], [62, 294785], [68, 295025], [72, 295285], [75, 295465]]}, {"verse": 50, "start": 296386, "end": 303145, "text": "Señor, acuérdate de la deshonra de tus siervos; deshonra que llevo yo en mi seno de muchos pueblos.", "words": [[0, 296386], [7, 297126], [17, 297666], [20, 297906], [23, 298286], [32, 298666], [35, 298826], [39, 299006], [48, 300329], [57, 300619], [61, 300779], [67, 301119], [70, 301319], [73, 301479], [76, 301659], [81, 302019], [84, 302119], [91, 302339]]}, {"verse": 51, "start": 303495, "end": 311179, "text": "Porque tus enemigos, oh Jehová, han deshonrado, porque tus enemigos han deshonrado los pasos de tu ungido.", "words": [[0, 303495], [7, 303737], [11, 303977], [21, 304464], [24, 304950], [32, 305437], [36, 305657], [48, 306817], [55, 307397], [59, 307657], [68, 308297], [72, 308597], [83, 309477], [87, 309657], [93, 310197], [96, 310544], [99, 310892]]}, {"verse": 52, "start": 311529, "end": 315225, "text": "Bendito Jehová para siempre. Amén, y Amén.", "words": [[0, 311529], [8, 312156], [15, 312656], [20, 312816], [29, 313892], [35, 314329], [37, 314609]]}]}