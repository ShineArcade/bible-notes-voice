{"book": "MAT", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 348526, "verses": [{"verse": 1, "start": 300, "end": 12325, "text": "Entonces llamando a sus doce discípulos, les dio autoridad contra los espíritus inmundos, para que los echasen fuera, y sanasen toda enfermedad y toda dolencia.", "words": [[0, 300], [9, 1109], [18, 1669], [20, 1729], [24, 1909], [29, 2309], [41, 3329], [45, 3589], [49, 4049], [59, 4889], [66, 5289], [70, 5549], [80, 6209], [90, 6769], [95, 7389], [99, 7529], [103, 7709], [111, 8309], [118, 8689], [120, 9169], [128, 9649], [133, 9969], [144, 11049], [146, 11209], [151, 11389]]}, {"verse": 2, "start": 12775, "end": 25119, "text": "Y los nombres de los doce apóstoles son estos: el primero, Simón, que es llamado Pedro, y Andrés su hermano; Jacobo, hijo de Zebedeo, y Juan su hermano;", "words": [[0, 12775], [2, 13097], [6, 13237], [14, 13657], [17, 13817], [21, 14047], [26, 14277], [36, 14997], [40, 15317], [47, 16256], [50, 16440], [59, 16820], [66, 17480], [70, 17660], [73, 17840], [81, 18180], [88, 18780], [90, 19200], [97, 19660], [100, 20060], [109, 21062], [117, 22232], [122, 22412], [125, 22922], [134, 23432], [136, 23852], [141, 24152], [144, 24452]]}, {"verse": 3, "start": 25569, "end": 34322, "text": "Felipe, y Bartolomé; Tomás, y Mateo el publicano; Jacobo hijo de Alfeo, y Lebeo, por sobrenombre Tadeo;", "words": [[0, 25569], [8, 25999], [10, 26379], [21, 27510], [28, 28012], [30, 28332], [36, 28792], [39, 28912], [50, 30075], [57, 30882], [62, 31042], [65, 31242], [72, 31762], [74, 32272], [81, 32782], [85, 32882], [97, 33722]]}, {"verse": 4, "start": 34772, "end": 38683, "text": "Simón el cananista y Judas Iscariote, que también le entregó.", "words": [[0, 34772], [6, 35399], [9, 35459], [19, 36139], [21, 36499], [27, 36859], [38, 37219], [42, 37399], [50, 37779], [53, 38019]]}, {"verse": 5, "start": 39133, "end": 51301, "text": "A estos doce envió Jesús, a los cuales dio mandamiento, diciendo: Por el camino de los Gentiles no iréis, y en ciudad de samaritanos no entréis;", "words": [[0, 39133], [2, 39498], [8, 39738], [13, 40558], [19, 41078], [26, 42138], [28, 42338], [32, 42458], [39, 42718], [43, 43258], [56, 44458], [66, 45515], [70, 45637], [73, 45797], [80, 46197], [83, 46337], [87, 46457], [96, 46977], [99, 47277], [106, 48337], [108, 48617], [111, 48757], [118, 49317], [121, 49797], [133, 50277], [136, 50497]]}, {"verse": 6, "start": 51751, "end": 55379, "text": "Pero id antes a las ovejas perdidas de la casa de Israel.", "words": [[0, 51751], [5, 51917], [8, 52217], [14, 52657], [16, 52917], [20, 53017], [27, 53437], [36, 54077], [39, 54257], [42, 54337], [47, 54577], [50, 54797]]}, {"verse": 7, "start": 55829, "end": 61311, "text": "Y yendo, predicad, diciendo: El reino de los cielos se ha acercado.", "words": [[0, 55829], [2, 55993], [9, 56293], [19, 57013], [29, 58192], [32, 58353], [38, 58853], [41, 58953], [45, 59093], [52, 59733], [55, 59953], [58, 60153]]}, {"verse": 8, "start": 61761, "end": 71458, "text": "Sanad enfermos, limpiad leprosos, resucitad muertos, echad fuera demonios: gratis recibisteis, dad gratis.", "words": [[0, 61761], [6, 62326], [16, 63546], [24, 64386], [34, 65386], [44, 66386], [53, 67486], [59, 67886], [65, 68326], [75, 69533], [82, 70301], [95, 70687], [99, 71072]]}, {"verse": 9, "start": 71908, "end": 76615, "text": "No llevéis oro, ni plata, ni cobre en vuestras bolsas;", "words": [[0, 73294], [3, 73394], [11, 73854], [16, 74134], [19, 74374], [26, 74714], [29, 75054], [35, 75394], [38, 75534], [47, 75894]]}, {"verse": 10, "start": 77065, "end": 85522, "text": "Ni bolsa para el camino, ni dos ropas de vestir, ni zapatos, ni bastón; porque el obrero digno es de su alimento.", "words": [[0, 77065], [3, 77209], [9, 77649], [14, 77869], [17, 78029], [25, 78869], [28, 79089], [32, 79329], [38, 79849], [41, 80009], [49, 80709], [52, 80809], [61, 81669], [64, 81749], [72, 82660], [79, 82902], [82, 83122], [89, 83482], [95, 84222], [98, 84422], [101, 84562], [104, 84702]]}, {"verse": 11, "start": 85972, "end": 95036, "text": "Pero en cualquier ciudad o aldea donde entréis, investigad quién sea en ella digno, y reposad allí hasta que salgáis.", "words": [[0, 85972], [5, 86116], [8, 86256], [18, 86596], [25, 87176], [27, 87676], [33, 88216], [39, 88436], [48, 89536], [59, 90396], [65, 90636], [69, 91096], [72, 91376], [77, 91556], [84, 92356], [86, 92516], [94, 93216], [99, 93516], [105, 94056], [109, 94256]]}, {"verse": 12, "start": 95486, "end": 98591, "text": "Y entrando en la casa, saludadla.", "words": [[0, 95486], [2, 95840], [11, 96420], [14, 96620], [17, 96760], [23, 97600]]}, {"verse": 13, "start": 99041, "end": 107497, "text": "Y si la casa es digna, vuestra paz vendrá sobre ella; pero si no es digna, vuestra paz se volverá a vosotros.", "words": [[0, 99041], [2, 99162], [5, 99282], [8, 99442], [13, 99642], [16, 99862], [23, 100762], [31, 101262], [35, 101542], [42, 102282], [48, 102562], [54, 103457], [59, 103604], [62, 103804], [65, 104004], [68, 104144], [75, 104944], [83, 105364], [87, 105664], [90, 106124], [98, 106644], [100, 106724]]}, {"verse": 14, "start": 107947, "end": 117398, "text": "Y cualquiera que no os reciba, ni oiga vuestras palabras, salid de aquella casa o ciudad, y sacudid el polvo de vuestros pies.", "words": [[0, 107947], [2, 108045], [13, 108685], [17, 108864], [20, 109125], [23, 109285], [31, 109845], [34, 110084], [39, 110485], [48, 110925], [58, 111905], [64, 112485], [67, 112745], [75, 113065], [80, 113444], [82, 113705], [90, 114145], [92, 114785], [100, 115584], [103, 115785], [109, 116345], [112, 116465], [121, 116805]]}, {"verse": 15, "start": 117848, "end": 128152, "text": "De cierto os digo, que el castigo será más tolerable a la tierra de los de Sodoma y de los de Gomorra en el día del juicio, que a aquella ciudad.", "words": [[0, 117848], [3, 118076], [10, 118336], [13, 118596], [19, 118816], [23, 119456], [26, 119616], [34, 120316], [39, 120616], [43, 120896], [53, 121696], [55, 121816], [58, 121896], [65, 122276], [68, 122466], [72, 122656], [75, 122836], [82, 123436], [84, 123936], [87, 124056], [91, 124196], [94, 124356], [102, 124976], [105, 125256], [108, 125416], [112, 125696], [116, 125876], [124, 126919], [128, 127002], [130, 127102], [138, 127382]]}, {"verse": 16, "start": 128602, "end": 138799, "text": "He aquí, yo os envío como a ovejas en medio de lobos: sed pues prudentes como serpientes, y sencillos como palomas.", "words": [[0, 128651], [3, 128731], [9, 129611], [12, 129891], [15, 130211], [21, 130791], [26, 131091], [28, 131311], [35, 131831], [38, 132051], [44, 132331], [47, 132551], [54, 134075], [58, 134075], [63, 134357], [73, 135257], [78, 135537], [90, 136297], [92, 136817], [102, 137657], [107, 137917]]}, {"verse": 17, "start": 139249, "end": 146324, "text": "Y guardaos de los hombres: porque os entregarán en tribunales, y en sus sinagogas os azotarán;", "words": [[0, 139249], [2, 139418], [11, 140078], [14, 140278], [18, 140438], [27, 141509], [34, 141771], [37, 141951], [48, 142731], [51, 142871], [63, 143551], [65, 143811], [68, 143971], [72, 144131], [82, 144971], [85, 145211]]}, {"verse": 18, "start": 146774, "end": 154794, "text": "Y aun a príncipes y a reyes seréis llevados por causa de mí, por testimonio a ellos y a los Gentiles.", "words": [[0, 146774], [2, 146809], [6, 146879], [8, 147306], [18, 147732], [20, 148159], [22, 148259], [28, 148699], [35, 149439], [44, 149979], [48, 150219], [54, 150559], [57, 150859], [61, 151479], [65, 151799], [76, 152699], [78, 152879], [84, 153219], [86, 153599], [88, 153719], [92, 153819]]}, {"verse": 19, "start": 155244, "end": 164006, "text": "Pero cuando os entreguen, no os preocupéis por cómo o qué hablaréis; porque en aquella hora os será dado qué habéis de hablar.", "words": [[0, 155244], [5, 155392], [12, 155652], [15, 155932], [26, 156832], [29, 157092], [32, 157232], [43, 158132], [47, 158372], [52, 158812], [54, 159132], [58, 159392], [69, 160673], [76, 161033], [79, 161273], [87, 161513], [92, 161753], [95, 161953], [100, 162293], [105, 162653], [109, 163013], [116, 163393], [119, 163573]]}, {"verse": 20, "start": 164456, "end": 170689, "text": "Porque no sois vosotros los que habláis, sino el Espíritu de vuestro Padre que habla en vosotros.", "words": [[0, 164456], [7, 164677], [10, 164917], [15, 165317], [24, 165877], [28, 166137], [32, 166337], [41, 166977], [46, 167417], [49, 167637], [58, 168297], [61, 168397], [69, 168797], [75, 169277], [79, 169437], [85, 169737], [88, 169897]]}, {"verse": 21, "start": 171139, "end": 180381, "text": "Y el hermano entregará al hermano a la muerte, y el padre al hijo; y los hijos se levantarán contra los padres, y los harán morir.", "words": [[0, 171139], [2, 171288], [5, 171468], [13, 172008], [23, 172688], [26, 172888], [34, 173328], [36, 173388], [39, 173428], [47, 173868], [49, 174348], [52, 174468], [58, 174888], [61, 175308], [67, 176047], [69, 176148], [73, 176308], [79, 176588], [82, 176928], [93, 177608], [100, 177948], [104, 178168], [112, 178628], [114, 179288], [118, 179448], [124, 179808]]}, {"verse": 22, "start": 180831, "end": 186753, "text": "Y seréis aborrecidos de todos por mi nombre; pero el que soporte hasta el fin, este será salvo.", "words": [[0, 180831], [2, 180938], [9, 181318], [21, 182098], [24, 182258], [30, 182478], [34, 182758], [37, 182918], [45, 183935], [50, 184095], [53, 184255], [57, 184355], [65, 184835], [71, 185055], [74, 185215], [79, 185695], [84, 185815], [89, 186135]]}, {"verse": 23, "start": 187203, "end": 200205, "text": "Pero cuando os persigan en esta ciudad, huid a la otra: porque de cierto os digo, que no acabaréis de recorrer todas las ciudades de Israel antes de que venga el Hijo del hombre.", "words": [[0, 187203], [5, 187346], [12, 187686], [15, 188006], [24, 188786], [27, 189126], [32, 189406], [40, 189886], [45, 190986], [47, 191186], [50, 191326], [56, 192215], [63, 192439], [66, 192579], [73, 192839], [76, 193239], [82, 193539], [86, 193939], [89, 194119], [99, 194679], [102, 194839], [111, 195519], [117, 196019], [121, 196559], [130, 197219], [133, 197399], [140, 197859], [146, 198259], [149, 198479], [153, 198579], [159, 198939], [162, 199219], [167, 199519], [171, 199699]]}, {"verse": 24, "start": 200655, "end": 205255, "text": "El discípulo no es más que su maestro, ni el siervo más que su señor.", "words": [[0, 200655], [3, 200803], [13, 201423], [16, 201663], [19, 201803], [23, 201963], [27, 202123], [30, 202303], [39, 203083], [42, 203443], [45, 203583], [52, 204083], [56, 204263], [60, 204423], [63, 204583]]}, {"verse": 25, "start": 205705, "end": 216306, "text": "Le basta al discípulo ser como su maestro, y al siervo como su señor. Si al padre de la familia llamaron Beelzebú, ¿cuánto más a los de su casa?", "words": [[0, 205705], [3, 205854], [9, 206154], [12, 206554], [22, 207074], [26, 207354], [31, 207594], [34, 207794], [43, 208394], [45, 208754], [48, 208894], [55, 209374], [60, 209594], [63, 209794], [70, 210676], [73, 210852], [76, 211032], [82, 211472], [85, 211672], [88, 211812], [96, 212332], [105, 213422], [115, 214512], [123, 214852], [127, 215092], [129, 215232], [133, 215372], [136, 215512], [139, 215652]]}, {"verse": 26, "start": 216756, "end": 225546, "text": "Así que, no los temáis; porque nada hay encubierto, que no haya de ser manifestado; ni oculto, que no haya de saberse.", "words": [[0, 216756], [4, 217074], [9, 217234], [12, 217374], [16, 217514], [24, 218561], [31, 218778], [36, 219218], [40, 219558], [52, 220358], [56, 220878], [59, 221098], [64, 221278], [67, 221518], [71, 221698], [84, 223044], [87, 223282], [95, 223942], [99, 224082], [102, 224302], [107, 224542], [110, 224742]]}, {"verse": 27, "start": 225996, "end": 234101, "text": "Lo que os digo en tinieblas, decidlo en la luz; y lo que oís al oído predicadlo desde las azoteas.", "words": [[0, 225996], [3, 226124], [7, 226264], [10, 226404], [15, 226604], [18, 226804], [29, 227824], [37, 228624], [40, 228884], [43, 229024], [48, 229848], [50, 230083], [53, 230223], [57, 230363], [61, 230743], [64, 231003], [69, 231693], [80, 232383], [86, 232703], [90, 233063]]}, {"verse": 28, "start": 234551, "end": 245298, "text": "Y no temáis a los que matan el cuerpo, pero al alma no pueden matar: temed antes a aquel que puede destruir el alma y el cuerpo en el infierno.", "words": [[0, 234551], [2, 234675], [5, 234795], [12, 235355], [14, 235815], [18, 235935], [22, 236055], [28, 236455], [31, 236595], [39, 237535], [44, 237815], [47, 237955], [52, 238235], [55, 238555], [62, 238895], [69, 239865], [75, 240187], [81, 240707], [83, 241227], [89, 241527], [93, 241647], [99, 241927], [108, 242827], [111, 243007], [116, 243347], [118, 243547], [121, 243707], [128, 244147], [131, 244367], [134, 244467]]}, {"verse": 29, "start": 245748, "end": 252793, "text": "¿No se venden dos pajarillos por una moneda pequeña? Con todo, ni uno de ellos cae a tierra sin vuestro Padre.", "words": [[0, 245748], [4, 245876], [7, 246016], [14, 246316], [18, 246556], [29, 247196], [33, 247476], [37, 247656], [44, 248096], [53, 249215], [57, 249339], [63, 249559], [66, 249819], [70, 250079], [73, 250239], [79, 250599], [83, 251199], [85, 251259], [92, 251539], [96, 251819], [104, 252199]]}, {"verse": 30, "start": 253243, "end": 256164, "text": "Pues aun vuestros cabellos están todos contados.", "words": [[0, 253243], [5, 253367], [9, 253587], [18, 254027], [27, 254587], [33, 254867], [39, 255267]]}, {"verse": 31, "start": 256614, "end": 261146, "text": "Así que, no temáis: más valéis vosotros que muchos pajarillos.", "words": [[0, 256614], [4, 256894], [9, 257054], [12, 257194], [20, 258172], [24, 258499], [31, 259139], [40, 259679], [44, 259879], [51, 260119]]}, {"verse": 32, "start": 261596, "end": 269274, "text": "Cualquiera, pues, que me confiese delante de los hombres, le confesaré yo también delante de mi Padre que está en los cielos.", "words": [[0, 261596], [12, 262216], [18, 263116], [22, 263256], [25, 263376], [34, 263976], [42, 264476], [45, 264616], [49, 264736], [58, 265456], [61, 265516], [71, 266256], [74, 266396], [82, 266716], [90, 267336], [93, 267516], [96, 267656], [102, 268076], [106, 268176], [111, 268356], [114, 268496], [118, 268616]]}, {"verse": 33, "start": 269724, "end": 276925, "text": "Y cualquiera que me niegue delante de los hombres, le negaré yo también delante de mi Padre que está en los cielos.", "words": [[0, 269724], [2, 269828], [13, 270328], [17, 270488], [20, 270648], [27, 271068], [35, 271568], [38, 271728], [42, 271848], [51, 273008], [54, 273268], [61, 273668], [64, 273888], [72, 274188], [80, 274788], [83, 274948], [86, 275088], [92, 275488], [96, 275608], [101, 275808], [104, 275948], [108, 276108]]}, {"verse": 34, "start": 277375, "end": 284148, "text": "No penséis que he venido para traer paz en la tierra: no he venido para traer paz, sino espada.", "words": [[0, 277375], [3, 277500], [11, 277980], [15, 278200], [18, 278300], [25, 278660], [30, 278860], [36, 279280], [40, 279640], [43, 280060], [46, 280220], [54, 281203], [57, 281408], [60, 281508], [67, 281888], [72, 282088], [78, 282508], [83, 283248], [88, 283448]]}, {"verse": 35, "start": 284598, "end": 291247, "text": "Porque he venido para poner al hombre contra su padre, a la hija contra su madre y a la nuera contra su suegra.", "words": [[0, 284710], [7, 284860], [10, 284960], [17, 285240], [22, 285460], [28, 285740], [31, 285960], [38, 286220], [45, 286560], [48, 286800], [55, 287640], [57, 287740], [60, 287840], [65, 288200], [72, 288440], [75, 288680], [81, 289040], [83, 289440], [85, 289520], [88, 289620], [94, 289960], [101, 290280], [104, 290540]]}, {"verse": 36, "start": 291697, "end": 295082, "text": "Y los enemigos del hombre serán los de su casa.", "words": [[0, 291697], [2, 291822], [6, 291942], [15, 292542], [19, 292742], [26, 293062], [32, 293662], [36, 294062], [39, 294222], [42, 294382]]}, {"verse": 37, "start": 295532, "end": 304221, "text": "El que ama padre o madre más que a mí, no es digno de mí; y el que ama hijo o hija más que a mí, no es digno de mí.", "words": [[0, 295532], [3, 295698], [7, 295838], [11, 296078], [17, 296558], [19, 296858], [25, 297198], [29, 297498], [33, 297658], [35, 297778], [39, 297878], [42, 298558], [45, 298718], [51, 299158], [54, 299258], [58, 299825], [60, 299983], [63, 300103], [67, 300283], [71, 300683], [76, 301003], [78, 301343], [83, 301683], [87, 301923], [91, 302163], [93, 302283], [97, 302463], [100, 303123], [103, 303283], [109, 303783], [112, 303883]]}, {"verse": 38, "start": 304671, "end": 309558, "text": "Y el que no toma su cruz, y sigue en pos de mí, no es digno de mí.", "words": [[0, 304671], [2, 305005], [5, 305125], [9, 305245], [12, 305465], [17, 305785], [20, 306005], [26, 306505], [28, 306685], [34, 307045], [37, 307385], [41, 307605], [44, 307805], [48, 308325], [51, 308445], [54, 308625], [60, 309085], [63, 309225]]}, {"verse": 39, "start": 310008, "end": 316535, "text": "El que halla su vida, la perderá; y el que pierde su vida por causa de mí, la hallará.", "words": [[0, 310054], [3, 310134], [7, 310334], [13, 310534], [16, 310834], [22, 311614], [25, 311874], [34, 313007], [36, 313132], [39, 313252], [43, 313392], [50, 313832], [53, 313992], [58, 314272], [62, 314492], [68, 314852], [71, 315132], [75, 315312], [78, 315812]]}, {"verse": 40, "start": 316985, "end": 324184, "text": "El que os recibe a vosotros, a mí recibe; y el que a mí recibe, recibe al que me envió.", "words": [[0, 316985], [3, 317264], [7, 317404], [10, 317544], [17, 318064], [19, 318144], [29, 318664], [31, 318964], [34, 319463], [42, 320221], [44, 320400], [47, 320500], [51, 320760], [53, 320920], [56, 321220], [64, 322560], [71, 322960], [74, 323100], [78, 323300], [81, 323500]]}, {"verse": 41, "start": 324634, "end": 337010, "text": "El que recibe profeta en nombre de profeta, recompensa de profeta recibirá; y el que recibe justo en nombre de justo, recompensa de justo recibirá.", "words": [[0, 324634], [3, 324904], [7, 325044], [14, 325564], [22, 326184], [25, 326344], [32, 326764], [35, 326964], [44, 328084], [55, 329164], [58, 329364], [66, 330004], [76, 331178], [78, 331343], [81, 331463], [85, 331663], [92, 332283], [98, 332573], [101, 332863], [108, 333223], [111, 333463], [118, 334403], [129, 335483], [132, 335683], [138, 336003]]}, {"verse": 42, "start": 337460, "end": 348126, "text": "Y cualquiera que dé a uno de estos pequeñitos un vaso de agua fría solamente, por ser discípulo, de cierto os digo, que no perderá su recompensa.", "words": [[0, 337460], [2, 337601], [13, 338221], [17, 338421], [20, 338621], [22, 338861], [26, 339121], [29, 339321], [35, 339541], [46, 340301], [49, 340541], [54, 340941], [57, 341061], [62, 341261], [67, 341701], [78, 342101], [82, 342521], [86, 342761], [97, 343901], [100, 344021], [107, 344441], [110, 344881], [116, 345241], [120, 345981], [123, 346161], [131, 346721], [134, 346901]]}]}