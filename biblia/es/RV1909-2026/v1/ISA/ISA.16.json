{"book": "ISA", "chapter": 16, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 155712, "verses": [{"verse": 1, "start": 300, "end": 7309, "text": "Enviad un cordero al gobernante de la tierra, desde la Piedra del desierto al monte de la hija de Sion.", "words": [[0, 566], [7, 866], [10, 1006], [18, 1506], [21, 1646], [32, 2326], [35, 2466], [38, 2606], [46, 2986], [52, 3666], [55, 3866], [62, 4426], [66, 4626], [75, 5266], [78, 5446], [84, 5806], [87, 6026], [90, 6296], [95, 6566], [98, 6666]]}, {"verse": 2, "start": 7759, "end": 14044, "text": "Y será que cual ave espantada que se huye de su nido, así serán las hijas de Moab en los vados de Arnón.", "words": [[0, 7759], [2, 7885], [7, 8105], [11, 8325], [16, 8545], [20, 8785], [30, 9445], [34, 9605], [37, 9785], [42, 10065], [45, 10185], [48, 10385], [54, 10685], [58, 10925], [64, 11385], [68, 11545], [74, 11985], [77, 12105], [82, 12545], [85, 12765], [89, 12885], [95, 13265], [98, 13385]]}, {"verse": 3, "start": 14494, "end": 25761, "text": "Reúne consejo, haz juicio; pon tu sombra en medio del día como la noche: esconde los desterrados, no entregues a los que andan errantes.", "words": [[0, 14710], [6, 14960], [15, 16180], [19, 16480], [27, 17548], [31, 17692], [34, 17852], [41, 18432], [44, 18752], [50, 19092], [54, 19412], [58, 19672], [63, 19972], [66, 20152], [73, 21087], [81, 21629], [85, 21809], [98, 23209], [101, 23349], [111, 24009], [113, 24149], [117, 24289], [121, 24489], [127, 25125]]}, {"verse": 4, "start": 26211, "end": 40977, "text": "Moren contigo mis desterrados, oh Moab; sé refugio para ellos de la presencia del destruidor: porque el atormentador fenecerá, el destruidor tendrá fin, el opresor será consumido de sobre la tierra.", "words": [[0, 26211], [6, 26711], [14, 27251], [18, 27411], [31, 28311], [34, 28391], [40, 29405], [43, 29555], [51, 30215], [56, 30455], [62, 30755], [65, 30955], [68, 31055], [78, 31695], [82, 31875], [94, 33149], [101, 33390], [104, 33730], [117, 34710], [127, 35870], [130, 35990], [141, 36750], [148, 37210], [153, 37950], [156, 38050], [164, 38610], [169, 38830], [179, 39650], [182, 39810], [188, 40090], [191, 40310]]}, {"verse": 5, "start": 41427, "end": 53231, "text": "Y se dispondrá trono en misericordia; y sobre él se sentará firmemente, en el tabernáculo de David, quien juzgue y busque el juicio, y apresure la justicia.", "words": [[0, 41427], [2, 41534], [5, 41634], [15, 42234], [21, 42734], [24, 42854], [38, 44209], [40, 44336], [46, 44616], [49, 44916], [52, 45096], [60, 45656], [72, 46576], [75, 46996], [78, 47156], [90, 48016], [93, 48256], [100, 48676], [106, 49276], [113, 49916], [115, 50116], [122, 50456], [125, 50596], [133, 51496], [135, 51756], [144, 52296], [147, 52436]]}, {"verse": 6, "start": 53681, "end": 63510, "text": "Hemos oído la soberbia de Moab, por extremo soberbio; su soberbia y su arrogancia, y su altivez; pero sus mentiras no serán firmes.", "words": [[0, 53681], [6, 54057], [11, 54397], [14, 54557], [23, 55077], [26, 55237], [32, 55817], [36, 56317], [44, 56997], [54, 58055], [57, 58179], [66, 58839], [68, 58979], [71, 59119], [83, 59959], [85, 60139], [88, 60608], [97, 61320], [102, 61465], [106, 61665], [115, 62305], [118, 62485], [124, 62865]]}, {"verse": 7, "start": 63960, "end": 72438, "text": "Por tanto aullará Moab, todo él aullará: gemiréis por los fundamentos de Kir-hareseth, en gran manera heridos.", "words": [[0, 63960], [4, 64160], [10, 64670], [18, 65180], [24, 65880], [29, 66200], [32, 66795], [41, 67624], [50, 68310], [54, 68530], [58, 68730], [70, 69510], [73, 70070], [87, 70630], [90, 71010], [95, 71230], [102, 71670]]}, {"verse": 8, "start": 72888, "end": 89970, "text": "Porque los campos de Hesbón fueron talados, y las vides de Sibma; señores de naciones pisotearon sus generosos sarmientos; habían llegado hasta Jazer, y se habían extendido por el desierto; se extendieron sus plantas, pasaron el mar.", "words": [[0, 72888], [7, 73092], [11, 73272], [18, 73812], [21, 74062], [28, 74312], [35, 74652], [44, 75392], [46, 75652], [50, 75852], [56, 76332], [59, 76632], [66, 77651], [74, 78136], [77, 78256], [86, 79056], [97, 79736], [101, 80016], [111, 80736], [123, 82174], [130, 82412], [138, 82872], [144, 83192], [151, 83512], [153, 83872], [156, 84012], [163, 84232], [173, 84992], [177, 85192], [180, 85312], [190, 86410], [193, 86633], [205, 87473], [209, 87713], [218, 88753], [226, 89393], [229, 89703]]}, {"verse": 9, "start": 90420, "end": 104035, "text": "Por lo cual lamentaré con lloro de Jazer la viña de Sibma; te empaparé de mis lágrimas, oh Hesbón y Eleale: porque sobre tus cosechas y sobre tu siega caerá la algazara.", "words": [[0, 90420], [4, 90718], [7, 90858], [12, 91118], [22, 92058], [26, 92318], [32, 92778], [35, 93078], [41, 93378], [44, 93678], [49, 94078], [52, 94533], [59, 95216], [62, 95358], [71, 95998], [74, 96158], [78, 96318], [88, 96998], [91, 97678], [98, 98358], [100, 98658], [108, 99734], [115, 99960], [121, 100300], [125, 100580], [134, 101340], [136, 101500], [142, 101700], [145, 102040], [151, 102380], [157, 102860], [160, 103476]]}, {"verse": 10, "start": 104485, "end": 117732, "text": "Quitado es el gozo y la alegría del campo fértil; en las viñas no cantarán, ni se regocijarán; no pisará vino en los lagares el pisador: he hecho cesar el clamor del lagarero.", "words": [[0, 104485], [8, 104949], [11, 105089], [14, 105209], [19, 105649], [21, 105749], [24, 105909], [32, 106429], [36, 106549], [42, 106949], [50, 108027], [53, 108280], [57, 108420], [63, 108860], [66, 109240], [76, 110180], [79, 110770], [82, 111361], [95, 112201], [98, 112386], [105, 112886], [110, 113206], [113, 113406], [117, 113526], [125, 114146], [128, 114206], [137, 115186], [140, 115369], [146, 115609], [152, 116109], [155, 116419], [162, 116729], [166, 116909]]}, {"verse": 11, "start": 118182, "end": 124617, "text": "Por tanto mis entrañas sonarán como arpa acerca de Moab, y mi interior por Kir-hareseth.", "words": [[0, 118182], [4, 118311], [10, 118711], [14, 118851], [23, 119571], [31, 120411], [36, 120631], [41, 121101], [48, 121571], [51, 121891], [57, 122271], [59, 122491], [62, 122631], [71, 123171], [75, 123927]]}, {"verse": 12, "start": 125067, "end": 135021, "text": "Y acaecerá, que cuando Moab parece que está cansado sobre los altos, entonces vendrá a su santuario a orar, y no le valdrá.", "words": [[0, 125067], [2, 125214], [12, 126074], [16, 126234], [23, 126514], [28, 127114], [35, 127534], [39, 127814], [44, 128014], [52, 128654], [58, 128954], [62, 129194], [69, 130274], [78, 130814], [85, 131994], [87, 132194], [90, 132374], [100, 133014], [102, 133234], [108, 133654], [110, 134014], [113, 134194], [116, 134374]]}, {"verse": 13, "start": 135471, "end": 140686, "text": "Esta es la palabra que pronunció Jehová sobre Moab desde aquel tiempo.", "words": [[0, 135471], [5, 135720], [8, 136060], [11, 136800], [19, 137180], [23, 137380], [33, 138120], [40, 138520], [46, 138760], [51, 139300], [57, 139640], [63, 140080]]}, {"verse": 14, "start": 141136, "end": 155048, "text": "Pero ahora Jehová ha hablado, diciendo: Dentro de tres años, como años de jornalero, será abatida la gloria de Moab, con toda su grande multitud: y los sobrevivientes serán pocos, pequeños, y no fuertes.", "words": [[0, 141136], [5, 141279], [11, 141579], [18, 142159], [21, 142379], [30, 142879], [40, 143899], [47, 144139], [50, 144339], [55, 144579], [61, 145359], [66, 145539], [71, 145839], [74, 146019], [85, 146979], [90, 147319], [98, 147919], [101, 148039], [108, 148419], [111, 148539], [117, 148979], [121, 149339], [126, 149619], [129, 149879], [136, 150179], [146, 151467], [148, 151568], [152, 151668], [167, 152218], [173, 152768], [180, 153528], [190, 154128], [192, 154308], [195, 154408]]}]}