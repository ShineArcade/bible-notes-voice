{"book": "ACT", "chapter": 17, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 313807, "verses": [{"verse": 1, "start": 300, "end": 7935, "text": "Y pasando por Anfípolis y Apolonia, llegaron a Tesalónica, donde estaba la sinagoga de los judíos.", "words": [[0, 300], [2, 403], [10, 723], [14, 1393], [24, 2063], [26, 2343], [36, 3403], [45, 3943], [47, 4263], [59, 5503], [65, 5663], [72, 6023], [75, 6223], [84, 6923], [87, 7103], [91, 7223]]}, {"verse": 2, "start": 8285, "end": 15772, "text": "Y Pablo, como acostumbraba, entró a ellos, y por tres sábados razonó con ellos sobre las Escrituras,", "words": [[0, 8285], [2, 8407], [9, 8967], [14, 9247], [28, 10407], [34, 11027], [36, 11127], [43, 11467], [45, 11967], [49, 12127], [54, 12407], [62, 13307], [69, 13867], [73, 14067], [79, 14287], [85, 14607], [89, 14867]]}, {"verse": 3, "start": 16122, "end": 28310, "text": "Explicando y demostrando que era necesario que el Cristo padeciese, y resucitase de los muertos; y que Jesús, el cual yo os anuncio, decía él, este era el Cristo.", "words": [[0, 16122], [11, 16909], [13, 17009], [25, 17649], [29, 17889], [33, 18049], [43, 18689], [47, 18969], [50, 19129], [57, 19489], [68, 20429], [70, 20689], [81, 21849], [84, 22009], [88, 22149], [97, 23130], [99, 23236], [103, 23356], [110, 24256], [113, 24336], [118, 24536], [121, 24816], [124, 25036], [133, 25996], [139, 26496], [143, 27156], [148, 27336], [152, 27486], [155, 27636]]}, {"verse": 4, "start": 28660, "end": 38595, "text": "Y algunos de ellos creyeron, y se juntaron con Pablo y con Silas; y de los griegos religiosos grande multitud, y mujeres nobles no pocas.", "words": [[0, 28660], [2, 28758], [10, 29038], [13, 29258], [19, 29458], [29, 30238], [31, 30758], [34, 30898], [43, 31438], [47, 31638], [53, 32158], [55, 32318], [59, 32578], [66, 33460], [68, 33567], [71, 33647], [75, 33807], [83, 34147], [94, 34907], [101, 35267], [111, 36107], [113, 36607], [121, 36987], [128, 37507], [131, 37927]]}, {"verse": 5, "start": 38945, "end": 54646, "text": "Entonces los judíos que eran incrédulos, teniendo celos, tomaron consigo a algunos ociosos, malos hombres, y formando una turba, alborotaron la ciudad; y asaltando la casa de Jasón, procuraban sacarlos al pueblo.", "words": [[0, 38945], [9, 39568], [13, 40148], [20, 40748], [24, 40888], [29, 41088], [41, 42208], [50, 42708], [57, 43508], [65, 43868], [73, 44108], [75, 44348], [83, 45128], [92, 45908], [98, 46328], [107, 47208], [109, 47248], [118, 47748], [122, 47908], [129, 48728], [141, 49508], [144, 49668], [152, 50540], [154, 50629], [164, 51229], [167, 51389], [172, 51629], [175, 52079], [182, 52529], [193, 53249], [202, 53849], [205, 54029]]}, {"verse": 6, "start": 54996, "end": 65657, "text": "Pero no hallándolos, trajeron a Jasón y a algunos hermanos a los gobernadores de la ciudad, dando voces: Estos que alborotan el mundo, también han venido acá;", "words": [[0, 54996], [5, 55181], [8, 55441], [21, 56601], [30, 57341], [32, 57661], [38, 57981], [40, 58241], [42, 58361], [50, 58721], [59, 59481], [61, 59601], [65, 59701], [78, 60421], [81, 60621], [84, 60741], [92, 61601], [98, 61841], [105, 62836], [111, 63178], [115, 63298], [125, 63878], [128, 63998], [135, 64278], [143, 64658], [147, 64938], [154, 65278]]}, {"verse": 7, "start": 65937, "end": 74127, "text": "A los cuales Jasón ha recibido; y todos estos hacen contra los decretos de César, diciendo que hay otro rey, Jesús.", "words": [[0, 65937], [2, 66065], [6, 66185], [13, 66665], [19, 67145], [22, 67385], [32, 68569], [34, 68677], [40, 68897], [46, 69217], [52, 69637], [59, 70037], [63, 70237], [72, 70837], [75, 70937], [82, 71757], [91, 72137], [95, 72457], [99, 72617], [104, 72937], [109, 73517]]}, {"verse": 8, "start": 74477, "end": 79342, "text": "Y alborotaron al pueblo y a los gobernadores de la ciudad, oyendo estas cosas.", "words": [[0, 74477], [2, 74600], [14, 75360], [17, 75520], [24, 75880], [26, 76240], [28, 76320], [32, 76420], [45, 77080], [48, 77240], [51, 77360], [59, 77660], [66, 78320], [72, 78540]]}, {"verse": 9, "start": 79692, "end": 84336, "text": "Pero recibida una garantía de Jasón y de los demás, los soltaron.", "words": [[0, 79692], [5, 79856], [14, 80596], [18, 80796], [27, 81456], [30, 81786], [36, 82116], [38, 82276], [41, 82376], [45, 82516], [52, 83036], [56, 83556]]}, {"verse": 10, "start": 84686, "end": 95164, "text": "Entonces los hermanos, luego de noche, enviaron a Pablo y a Silas a Berea; los cuales habiendo llegado, entraron en la sinagoga de los judíos.", "words": [[0, 84686], [9, 85250], [13, 85790], [23, 86180], [29, 86570], [32, 86790], [39, 87250], [48, 88050], [50, 88170], [56, 88610], [58, 88950], [60, 89130], [66, 89590], [68, 89830], [75, 90676], [79, 90800], [86, 91240], [95, 91560], [104, 92460], [113, 93060], [116, 93360], [119, 93500], [128, 94100], [131, 94300], [135, 94420]]}, {"verse": 11, "start": 95514, "end": 107938, "text": "Y fueron estos más nobles que los que estaban en Tesalónica, pues recibieron la palabra con toda disposición, escudriñando cada día las Escrituras, si estas cosas eran así.", "words": [[0, 95514], [2, 95618], [9, 95898], [15, 96218], [19, 96518], [26, 97098], [30, 97353], [34, 97493], [38, 97653], [46, 98073], [49, 98883], [61, 99693], [66, 99853], [77, 100813], [80, 101013], [88, 101433], [92, 101753], [97, 102053], [110, 103473], [123, 104393], [128, 104633], [132, 104953], [136, 105153], [148, 106173], [151, 106353], [157, 106613], [163, 107013], [168, 107393]]}, {"verse": 12, "start": 108288, "end": 114544, "text": "Así que creyeron muchos de ellos; y mujeres Griegas de distinción, y no pocos hombres.", "words": [[0, 108288], [4, 108628], [8, 108998], [17, 109368], [24, 109728], [27, 110008], [34, 110830], [36, 110952], [44, 111332], [52, 111952], [55, 112092], [67, 112992], [69, 113317], [72, 113477], [78, 113897]]}, {"verse": 13, "start": 114894, "end": 125653, "text": "Pero como entendieron los judíos de Tesalónica que también en Berea era anunciada la palabra de Dios por Pablo, fueron, y también allí alborotaron al pueblo.", "words": [[0, 114894], [5, 115037], [10, 115357], [22, 116117], [26, 116337], [33, 116877], [36, 117057], [47, 117817], [51, 117997], [59, 118337], [62, 118597], [68, 119117], [72, 119377], [82, 120297], [85, 120457], [93, 120797], [96, 121037], [101, 121297], [105, 121597], [112, 122557], [120, 122917], [122, 123517], [130, 123777], [135, 124137], [147, 124877], [150, 125057]]}, {"verse": 14, "start": 126003, "end": 133187, "text": "Pero luego los hermanos enviaron a Pablo que fuese como al mar; y Silas y Timoteo se quedaron allí.", "words": [[0, 126003], [5, 126165], [11, 126465], [15, 126665], [24, 127385], [33, 128025], [35, 128185], [41, 128485], [45, 128705], [51, 129125], [56, 129385], [59, 129693], [64, 130201], [66, 130645], [72, 131120], [74, 131595], [82, 132070], [85, 132190], [94, 132670]]}, {"verse": 15, "start": 133537, "end": 143926, "text": "Y los que habían tomado a cargo a Pablo, le llevaron hasta Atenas; y tomando encargo para Silas y Timoteo, que viniesen a él lo más pronto que pudiesen, salieron.", "words": [[0, 133537], [2, 133641], [6, 133721], [10, 133881], [17, 134061], [24, 134541], [26, 134701], [32, 134881], [34, 135101], [41, 135331], [44, 135561], [53, 136019], [59, 136477], [67, 137089], [69, 137211], [77, 137671], [85, 138251], [90, 138666], [96, 139081], [98, 139496], [107, 139911], [111, 140321], [120, 140731], [122, 140891], [125, 141031], [128, 141191], [132, 141351], [139, 141691], [143, 141911], [153, 142951]]}, {"verse": 16, "start": 144276, "end": 151799, "text": "Y esperándolos Pablo en Atenas, su espíritu se deshacía en él viendo la ciudad dada a idolatría.", "words": [[0, 144276], [2, 144621], [15, 145001], [21, 145401], [24, 145541], [32, 146461], [35, 146801], [44, 147681], [47, 147821], [56, 148581], [59, 148761], [62, 148901], [69, 149261], [72, 149541], [79, 150051], [84, 150561], [86, 151213]]}, {"verse": 17, "start": 152149, "end": 160439, "text": "Así que, razonaba en la sinagoga con los judíos y religiosos; y en la plaza cada día con los que se encontraba.", "words": [[0, 152149], [4, 152376], [9, 152596], [18, 153316], [21, 153476], [24, 153616], [33, 154316], [37, 154556], [41, 154736], [48, 155316], [50, 155436], [62, 156729], [64, 157070], [67, 157230], [70, 157390], [76, 158170], [81, 158350], [85, 158830], [89, 158970], [93, 159150], [97, 159310], [100, 159470]]}, {"verse": 18, "start": 160789, "end": 176821, "text": "Y algunos filósofos de los epicúreos y de los estoicos, disputaban con él; y unos decían: ¿Qué quiere decir este palabrero? Y otros: Parece que es predicador de nuevos dioses: porque les predicaba a Jesús y la resurrección.", "words": [[0, 160789], [2, 160907], [10, 161187], [20, 162087], [23, 162187], [27, 162757], [37, 163327], [39, 163527], [42, 163627], [46, 163767], [56, 164407], [67, 165567], [71, 165807], [75, 166267], [77, 166455], [82, 166655], [90, 167525], [95, 167646], [102, 167946], [108, 168306], [113, 168566], [124, 169552], [126, 169689], [133, 170537], [140, 170818], [144, 171058], [147, 171198], [158, 171878], [161, 172038], [168, 172238], [176, 173332], [183, 173596], [187, 173796], [197, 174516], [199, 174656], [205, 175076], [207, 175471], [210, 175611]]}, {"verse": 19, "start": 177171, "end": 183485, "text": "Y tomándole, le trajeron al Areópago, diciendo: ¿Podremos saber qué sea esta nueva doctrina que dices?", "words": [[0, 177171], [2, 177297], [13, 177784], [16, 178270], [25, 178757], [28, 178897], [38, 179657], [48, 180630], [58, 180933], [64, 181233], [68, 181453], [72, 181753], [77, 181973], [83, 182213], [92, 182713], [96, 182893]]}, {"verse": 20, "start": 183835, "end": 188884, "text": "Porque pones en nuestros oídos unas nuevas cosas: queremos pues saber qué significa esto.", "words": [[0, 183835], [7, 183994], [13, 184374], [16, 184514], [25, 184714], [31, 185374], [36, 185514], [43, 185774], [50, 186787], [59, 187067], [64, 187287], [70, 187587], [74, 187787], [84, 188287]]}, {"verse": 21, "start": 189164, "end": 198444, "text": "(Entonces todos los atenienses y los huéspedes extranjeros, no se ocupaban de otra cosa que de decir o de oír alguna cosa nueva.)", "words": [[0, 189164], [10, 189930], [16, 190170], [20, 190680], [31, 191190], [33, 191350], [37, 191490], [47, 192070], [60, 193090], [63, 193530], [66, 193730], [75, 194430], [78, 194590], [83, 194750], [88, 195190], [92, 195790], [95, 195970], [101, 196430], [103, 196710], [106, 196850], [110, 197170], [117, 197470], [122, 197830]]}, {"verse": 22, "start": 198794, "end": 206429, "text": "Estando pues Pablo en medio del Areópago, dijo: Varones atenienses, en todo observo que sois muy religiosos;", "words": [[0, 198794], [8, 199321], [13, 199541], [19, 200061], [22, 200381], [28, 200761], [32, 200981], [42, 202101], [48, 202995], [56, 203487], [68, 204017], [71, 204217], [76, 204417], [84, 204977], [88, 205077], [93, 205417], [97, 205557]]}, {"verse": 23, "start": 206779, "end": 218962, "text": "Porque pasando y mirando vuestros santuarios, hallé también un altar en el cual estaba esta inscripción: AL DIOS NO CONOCIDO. Aquel pues, que vosotros honráis sin conocerle, a este os anuncio yo.", "words": [[0, 206779], [7, 206983], [15, 207443], [17, 207623], [25, 208003], [34, 208363], [46, 209003], [52, 209643], [60, 209963], [63, 210203], [69, 210543], [72, 210723], [75, 210783], [80, 211023], [87, 211443], [92, 211783], [105, 212881], [108, 213064], [113, 213284], [116, 213544], [126, 214449], [132, 214814], [138, 215034], [142, 215234], [151, 215654], [159, 216294], [163, 216434], [174, 217434], [176, 217694], [181, 217974], [184, 218134], [192, 218574]]}, {"verse": 24, "start": 219312, "end": 227661, "text": "El Dios que hizo el mundo y todas las cosas que en él hay, este, siendo Señor del cielo y de la tierra, no habita en templos hechos de manos,", "words": [[0, 219312], [3, 219441], [8, 219701], [12, 219941], [17, 220161], [20, 220321], [26, 220621], [28, 220781], [34, 220941], [38, 221241], [44, 221541], [48, 221841], [51, 221981], [54, 222101], [59, 222401], [65, 223021], [72, 223281], [78, 223641], [82, 223881], [88, 224221], [90, 224401], [93, 224501], [96, 224601], [104, 225521], [107, 225641], [114, 226021], [117, 226161], [125, 226661], [132, 226981], [135, 227141]]}, {"verse": 25, "start": 228011, "end": 235036, "text": "Ni es servido por manos humanas, como si necesitara algo; pues él da a todos vida, y aliento, y todas las cosas;", "words": [[0, 228011], [3, 228196], [6, 228376], [14, 228756], [18, 228916], [24, 229156], [33, 229796], [38, 230076], [41, 230256], [52, 230916], [58, 231594], [63, 231740], [66, 231940], [69, 232100], [71, 232220], [77, 232400], [83, 232820], [85, 233160], [94, 233600], [96, 233960], [102, 234140], [106, 234420]]}, {"verse": 26, "start": 235386, "end": 245465, "text": "Y de una sangre ha hecho todo el linaje de los hombres, para que habitasen sobre toda la faz de la tierra; y les ha prefijado el orden de los tiempos, y los límites de donde habitarían;", "words": [[0, 235386], [2, 235492], [5, 235592], [9, 235752], [16, 236172], [19, 236472], [25, 236712], [30, 237012], [33, 237212], [40, 237612], [43, 237752], [47, 237892], [56, 238272], [61, 238607], [65, 238957], [75, 239307], [81, 239507], [86, 239767], [89, 239967], [93, 240247], [96, 240407], [99, 240507], [107, 241235], [109, 241337], [113, 241457], [116, 241617], [126, 242177], [129, 242297], [135, 242497], [138, 242677], [142, 242817], [151, 243377], [153, 243697], [157, 243837], [165, 244317], [168, 244497], [174, 244677]]}, {"verse": 27, "start": 245815, "end": 252680, "text": "Para que buscasen a Dios, si en alguna manera, palpando, le hallen; aunque cierto no está lejos de cada uno de nosotros:", "words": [[0, 245815], [5, 245957], [9, 246307], [18, 246657], [20, 246737], [26, 246977], [29, 247377], [32, 247477], [39, 247737], [47, 248197], [57, 248917], [60, 249317], [68, 249882], [75, 250059], [82, 250299], [85, 250579], [90, 250799], [96, 251139], [99, 251299], [104, 251479], [108, 251739], [111, 251899]]}, {"verse": 28, "start": 253030, "end": 260366, "text": "Porque en él vivimos, y nos movemos, y somos; como también algunos de vuestros poetas dijeron: Porque linaje de este somos también.", "words": [[0, 253030], [7, 253258], [10, 253418], [13, 253518], [22, 253998], [24, 254238], [28, 254398], [37, 254978], [39, 255138], [46, 255935], [51, 256099], [59, 256439], [67, 256799], [70, 256979], [79, 257279], [86, 257779], [95, 258535], [102, 258819], [109, 259139], [112, 259299], [117, 259479], [123, 259719]]}, {"verse": 29, "start": 260716, "end": 270723, "text": "Siendo pues linaje de Dios, no hemos de estimar la Divinidad ser semejante a oro, o a plata, o a piedra, escultura del arte o de la imaginación humana.", "words": [[0, 260901], [7, 261091], [12, 261291], [19, 261951], [22, 262091], [28, 262991], [31, 263251], [37, 263531], [40, 263711], [48, 264171], [51, 264251], [61, 264831], [65, 265091], [75, 265731], [77, 265931], [82, 266171], [84, 266471], [86, 266551], [93, 266931], [95, 267271], [97, 267351], [105, 268011], [115, 268531], [119, 268751], [124, 269051], [126, 269371], [129, 269471], [132, 269571], [144, 270211]]}, {"verse": 30, "start": 271073, "end": 279365, "text": "Pero Dios, habiendo pasado por alto los tiempos de esta ignorancia, ahora manda a todos los hombres en todos los lugares que se arrepientan:", "words": [[0, 271073], [5, 271212], [11, 271592], [20, 271912], [27, 272272], [31, 272532], [36, 272772], [40, 272992], [48, 273532], [51, 273652], [56, 273872], [68, 275052], [74, 275152], [80, 275612], [82, 275712], [88, 275892], [92, 276172], [100, 276532], [103, 276852], [109, 277032], [113, 277312], [121, 277692], [125, 277952], [128, 278092]]}, {"verse": 31, "start": 279715, "end": 290674, "text": "Por cuanto ha establecido un día, en el cual ha de juzgar al mundo con justicia, por aquel varón al cual determinó; dando garantía a todos con haberle levantado de los muertos.", "words": [[0, 279715], [4, 279861], [11, 280101], [14, 280461], [26, 281201], [29, 281381], [34, 281701], [37, 281926], [40, 282066], [45, 282326], [48, 282626], [51, 282746], [58, 283146], [61, 283326], [67, 283566], [71, 283846], [81, 284546], [85, 285026], [91, 285326], [97, 285686], [100, 285866], [105, 286086], [116, 287088], [122, 287384], [131, 288064], [133, 288184], [139, 288424], [143, 288744], [151, 289164], [161, 289724], [164, 289844], [168, 289964]]}, {"verse": 32, "start": 290954, "end": 299664, "text": "Y así como oyeron de la resurrección de los muertos, unos se burlaban, y otros decían: Te oiremos acerca de esto otra vez.", "words": [[0, 290954], [2, 291082], [6, 291302], [11, 291642], [18, 292162], [21, 292242], [24, 292422], [37, 293322], [40, 293462], [44, 293602], [53, 294607], [58, 294767], [61, 295087], [71, 295767], [73, 296112], [79, 296372], [87, 297332], [90, 297413], [98, 297933], [105, 298253], [108, 298533], [113, 298813], [118, 299173]]}, {"verse": 33, "start": 299944, "end": 302802, "text": "Y así Pablo se salió de en medio de ellos.", "words": [[0, 299944], [2, 300074], [6, 300294], [12, 300754], [15, 300974], [21, 301434], [24, 301554], [27, 301714], [33, 301934], [36, 302174]]}, {"verse": 34, "start": 303152, "end": 313407, "text": "Pero algunos creyeron, juntándose con él; entre los cuales también fue Dionisio el del Areópago, y una mujer llamada Dámaris, y otros con ellos.", "words": [[0, 303152], [5, 303276], [13, 303596], [23, 304236], [34, 304956], [38, 305216], [42, 305818], [48, 306061], [52, 306241], [59, 306541], [67, 306901], [71, 307221], [80, 308241], [83, 308461], [87, 308641], [97, 309741], [99, 310001], [103, 310121], [109, 310361], [117, 311061], [126, 311721], [128, 312241], [134, 312481], [138, 312821]]}]}