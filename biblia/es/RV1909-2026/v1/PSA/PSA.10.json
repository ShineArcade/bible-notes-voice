{"book": "PSA", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 129146, "verses": [{"verse": 1, "start": 300, "end": 5529, "text": "¿Por qué estás lejos, oh Jehová, y te escondes en el tiempo de la tribulación?", "words": [[0, 351], [5, 437], [9, 524], [15, 724], [22, 1364], [25, 2004], [33, 2644], [35, 2744], [38, 3174], [47, 3604], [50, 3744], [53, 3864], [60, 4204], [63, 4424], [66, 4544]]}, {"verse": 2, "start": 5879, "end": 12637, "text": "Con arrogancia el malo persigue al pobre: serán cogidos en los artificios que han ideado.", "words": [[0, 5879], [4, 6166], [15, 7006], [18, 7206], [23, 7586], [32, 8106], [35, 8286], [42, 9210], [48, 9726], [56, 10366], [59, 10567], [63, 10706], [74, 11567], [78, 11706], [82, 11907]]}, {"verse": 3, "start": 12987, "end": 20395, "text": "Por cuanto se alaba el malo del deseo de su alma, y bendice al codicioso, a quien Jehová aborrece.", "words": [[0, 12987], [4, 13130], [11, 13390], [14, 13710], [20, 14070], [23, 14210], [28, 14610], [32, 14750], [38, 15330], [41, 15410], [44, 15590], [50, 16470], [52, 16850], [60, 17210], [63, 17570], [74, 18370], [76, 18650], [82, 18810], [89, 19470]]}, {"verse": 4, "start": 20745, "end": 28270, "text": "El malo, por la altivez de su rostro, no busca a Dios: no hay Dios en todos sus pensamientos.", "words": [[0, 20745], [3, 21031], [9, 21451], [13, 21671], [16, 22061], [24, 22451], [27, 22671], [30, 22851], [38, 23531], [41, 24091], [47, 24471], [49, 24731], [55, 25488], [58, 25694], [62, 25934], [67, 26194], [70, 26514], [76, 26834], [80, 27194]]}, {"verse": 5, "start": 28620, "end": 36947, "text": "Sus caminos son viciosos en todo tiempo: tus juicios los tiene muy lejos de su vista: se burla de todos sus enemigos.", "words": [[0, 28620], [4, 28741], [12, 29261], [16, 29461], [25, 30101], [28, 30261], [33, 30461], [41, 31407], [45, 31491], [53, 31951], [57, 32261], [63, 32571], [67, 32831], [73, 33251], [76, 33411], [79, 33531], [86, 34348], [89, 34512], [95, 35012], [98, 35432], [104, 35752], [108, 36092]]}, {"verse": 6, "start": 37297, "end": 43403, "text": "Dice en su corazón: No seré movido en ningún tiempo, ni jamás me alcanzará el infortunio.", "words": [[0, 37297], [5, 37717], [8, 38037], [11, 38217], [20, 39210], [23, 39335], [28, 39635], [35, 40015], [38, 40155], [45, 40435], [53, 41215], [56, 41475], [62, 41855], [65, 41975], [75, 42515], [78, 42655]]}, {"verse": 7, "start": 43683, "end": 50892, "text": "Llena está su boca de maldición, y de engaños y fraude: debajo de su lengua, vejación y maldad.", "words": [[0, 43811], [6, 43971], [11, 44391], [14, 44511], [19, 44751], [22, 44931], [33, 45511], [35, 45846], [38, 45986], [46, 46786], [48, 47086], [56, 47946], [63, 48326], [66, 48506], [69, 48626], [77, 49406], [86, 50006], [88, 50266]]}, {"verse": 8, "start": 51242, "end": 60138, "text": "Está en las guaridas de las aldeas: en los escondrijos mata al inocente: sus ojos están acechando al pobre.", "words": [[0, 51242], [5, 51646], [8, 51926], [12, 52146], [21, 52806], [24, 52986], [28, 53126], [36, 54203], [39, 54503], [43, 54623], [55, 55583], [60, 56203], [63, 56603], [73, 57713], [77, 57839], [82, 58459], [88, 58659], [98, 59299], [101, 59459]]}, {"verse": 9, "start": 60488, "end": 69579, "text": "Acecha en oculto, como el león desde su cama: acecha para arrebatar al pobre: arrebata al pobre trayéndolo a su red.", "words": [[0, 60657], [7, 60857], [10, 61057], [18, 61817], [23, 62037], [26, 62237], [31, 62617], [37, 62797], [40, 63077], [46, 64113], [53, 64353], [58, 64633], [68, 65433], [71, 65573], [78, 66866], [87, 67286], [90, 67486], [96, 68106], [107, 68786], [109, 68926], [112, 69066]]}, {"verse": 10, "start": 69929, "end": 75254, "text": "Se encoge, se agacha, y caen en sus fuerzas muchos desdichados.", "words": [[0, 69929], [3, 70110], [11, 70750], [14, 70830], [22, 71290], [24, 71970], [29, 72430], [32, 72570], [36, 72690], [44, 73350], [51, 74316]]}, {"verse": 11, "start": 75604, "end": 81227, "text": "Dice en su corazón: Dios está olvidado, ha encubierto su rostro; nunca lo verá.", "words": [[0, 75604], [5, 76024], [8, 76344], [11, 76524], [20, 77518], [25, 77724], [30, 78084], [40, 78424], [43, 78764], [54, 79304], [57, 79504], [65, 80310], [71, 80709], [74, 80849]]}, {"verse": 12, "start": 81507, "end": 87048, "text": "Levántate, oh Jehová Dios, alza tu mano, no te olvides de los pobres.", "words": [[0, 81507], [11, 82066], [14, 82661], [21, 83256], [27, 83851], [32, 84351], [35, 84531], [41, 84871], [44, 85511], [47, 85651], [55, 86071], [58, 86233], [62, 86395]]}, {"verse": 13, "start": 87398, "end": 91618, "text": "¿Por qué irrita el malo a Dios? En su corazón ha dicho que no lo inquirirás.", "words": [[0, 87398], [5, 87512], [9, 87692], [16, 88092], [19, 88192], [24, 88472], [26, 88572], [32, 89205], [35, 89350], [38, 89470], [46, 89910], [49, 90090], [55, 90350], [59, 90510], [62, 90650], [65, 91170]]}, {"verse": 14, "start": 91968, "end": 102014, "text": "Tú lo tienes visto: porque tú miras el trabajo, y la vejación, para vengarle por tu mano: a ti se acoge el pobre, tú eres el amparo del huérfano.", "words": [[0, 91968], [3, 92092], [6, 92172], [13, 92372], [20, 93228], [27, 93454], [30, 93734], [36, 94194], [39, 94334], [48, 94834], [50, 95154], [53, 95274], [63, 95914], [68, 96259], [77, 96859], [81, 97099], [84, 97279], [90, 98023], [92, 98162], [95, 98322], [98, 98602], [104, 99002], [107, 99102], [114, 99802], [117, 100042], [122, 100262], [125, 100462], [132, 101062], [136, 101242]]}, {"verse": 15, "start": 102364, "end": 108450, "text": "Quebranta el brazo del malo: del maligno buscarás su maldad, hasta que ninguna halles.", "words": [[0, 102627], [10, 102927], [13, 103087], [19, 103447], [23, 103627], [29, 104671], [33, 105016], [41, 105361], [50, 105706], [53, 105886], [61, 106426], [67, 106966], [71, 107166], [79, 107566]]}, {"verse": 16, "start": 108800, "end": 114683, "text": "Jehová, Rey eterno y perpetuo; de su