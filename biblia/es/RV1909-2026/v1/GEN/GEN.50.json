{"book": "GEN", "chapter": 50, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 244093, "verses": [{"verse": 1, "start": 300, "end": 6558, "text": "Entonces se echó José sobre el rostro de su padre, y lloró sobre él, y lo besó.", "words": [[0, 300], [9, 1384], [12, 1724], [17, 2144], [22, 2484], [28, 2924], [31, 3144], [38, 3584], [41, 3704], [44, 3884], [51, 4284], [53, 4629], [59, 5009], [65, 5289], [69, 5531], [71, 5772], [74, 6014]]}, {"verse": 2, "start": 6908, "end": 15392, "text": "Y mandó José a sus siervos los médicos que embalsamasen a su padre: y los médicos embalsamaron a Israel.", "words": [[0, 6908], [2, 7178], [8, 7473], [13, 7768], [15, 8063], [19, 8303], [27, 8903], [31, 9303], [39, 10023], [43, 10683], [56, 11343], [58, 11423], [61, 11543], [68, 12420], [70, 12531], [74, 12651], [82, 13521], [95, 14391], [97, 14691]]}, {"verse": 3, "start": 15742, "end": 23519, "text": "Y le cumplieron cuarenta días, porque así cumplían los días de los embalsamados, y lo lloraron los egipcios setenta días.", "words": [[0, 15742], [2, 15832], [5, 15912], [16, 16362], [25, 16812], [31, 17372], [38, 17852], [42, 18092], [51, 18672], [55, 18852], [60, 19052], [63, 19232], [67, 19332], [81, 20212], [83, 20732], [86, 20872], [95, 21392], [99, 21572], [108, 22092], [116, 22612]]}, {"verse": 4, "start": 23869, "end": 35378, "text": "Y pasados los días de su luto, habló José a los de la casa de Faraón, diciendo: Si he hallado ahora gracia en vuestros ojos, os ruego que habléis en oídos de Faraón, diciendo:", "words": [[0, 23869], [2, 23974], [10, 24494], [14, 24694], [19, 24954], [22, 25114], [25, 25234], [31, 25864], [37, 26494], [42, 26834], [44, 27054], [48, 27174], [51, 27294], [54, 27394], [59, 27594], [62, 28004], [70, 28414], [80, 29828], [83, 30004], [86, 30184], [94, 30604], [100, 30904], [107, 31404], [110, 31504], [119, 31844], [125, 32644], [128, 32744], [134, 33064], [138, 33244], [146, 33644], [149, 33784], [155, 34144], [158, 34224], [166, 34784]]}, {"verse": 5, "start": 35728, "end": 47217, "text": "Mi padre me conjuró diciendo: He aquí yo muero; en mi sepulcro que yo cavé para mí en la tierra de Canaán, allí me sepultarás; ruego pues que vaya yo ahora, y sepultaré a mi padre, y volveré.", "words": [[0, 35728], [3, 35830], [9, 36070], [12, 36410], [20, 36750], [30, 37628], [33, 37708], [38, 37888], [41, 38088], [48, 38756], [51, 38895], [54, 39035], [63, 39535], [67, 39675], [70, 39895], [75, 40115], [80, 40275], [83, 40495], [86, 40655], [89, 40755], [96, 40995], [99, 41475], [107, 41955], [112, 42195], [115, 42295], [127, 43455], [133, 43585], [138, 43925], [142, 44105], [147, 44285], [150, 44525], [157, 44865], [159, 45185], [169, 45505], [171, 45825], [174, 45985], [181, 46305], [183, 46665]]}, {"verse": 6, "start": 47497, "end": 52066, "text": "Y Faraón dijo: Ve, y sepulta a tu padre, como él te conjuró.", "words": [[0, 47497], [2, 47797], [9, 48137], [15, 48903], [19, 49122], [21, 49422], [29, 50002], [31, 50082], [34, 50202], [41, 51002], [46, 51162], [49, 51382], [52, 51462]]}, {"verse": 7, "start": 52346, "end": 63192, "text": "Entonces José subió a sepultar a su padre; y subieron con él todos los siervos de Faraón, los ancianos de su casa, y todos los ancianos de la tierra de Egipto,", "words": [[0, 52346], [9, 52990], [14, 53515], [20, 54155], [22, 54315], [31, 54875], [33, 54935], [36, 55075], [43, 55881], [45, 55984], [54, 56404], [58, 56604], [61, 56764], [67, 57084], [71, 57364], [79, 57824], [82, 58404], [90, 58984], [94, 59044], [103, 59624], [106, 59764], [109, 59904], [115, 60184], [117, 60424], [123, 60684], [127, 61184], [136, 61784], [139, 61924], [142, 62024], [149, 62264], [152, 62504]]}, {"verse": 8, "start": 63542, "end": 73441, "text": "Y toda la casa de José, y sus hermanos, y la casa de su padre: solamente dejaron en la tierra de Gosén sus niños, y sus ovejas y sus vacas.", "words": [[0, 63542], [2, 63665], [7, 63945], [10, 64185], [15, 64465], [18, 64685], [24, 65025], [26, 65345], [30, 65525], [40, 66145], [42, 66265], [45, 66405], [50, 66625], [53, 66825], [56, 66945], [63, 67742], [73, 68167], [81, 68967], [84, 69127], [87, 69287], [94, 69667], [97, 70027], [103, 70387], [107, 70567], [114, 71047], [116, 71482], [120, 71642], [127, 72302], [129, 72582], [133, 72762]]}, {"verse": 9, "start": 73791, "end": 79967, "text": "Y subieron también con él carros y gente de a caballo, y se hizo un escuadrón muy grande.", "words": [[0, 73791], [2, 73915], [11, 74335], [19, 74715], [23, 74965], [26, 75215], [33, 75875], [35, 76215], [41, 76555], [44, 76835], [46, 77115], [55, 77395], [57, 77770], [60, 77890], [65, 78250], [68, 78490], [78, 79070], [82, 79270]]}, {"verse": 10, "start": 80317, "end": 92522, "text": "Y llegaron hasta la era de Atad, que está al otro lado del Jordán, y se lamentaron allí con grande y muy grave lamentación: y José hizo a su padre duelo por siete días.", "words": [[0, 80317], [2, 80440], [11, 80940], [17, 81440], [20, 81700], [24, 81920], [27, 82120], [33, 82900], [37, 82960], [42, 83200], [45, 83540], [50, 83740], [55, 84000], [59, 84280], [67, 84880], [69, 85300], [72, 85420], [83, 86140], [88, 86400], [92, 86680], [99, 87080], [101, 87200], [105, 87380], [111, 87680], [124, 89046], [126, 89286], [131, 89586], [136, 90086], [138, 90246], [141, 90386], [147, 90726], [153, 91226], [157, 91426], [163, 91706]]}, {"verse": 11, "start": 92872, "end": 107954, "text": "Y viendo los moradores de la tierra, los cananeos, el llanto en la era de Atad, dijeron: Llanto grande es este de los egipcios: por eso fue llamado su nombre Abel-mizraim, que está al otro lado del Jordán.", "words": [[0, 92872], [2, 92997], [9, 93277], [13, 93497], [23, 94057], [26, 94237], [29, 94337], [37, 95417], [41, 95517], [51, 96637], [54, 96717], [61, 97617], [64, 97717], [67, 97897], [71, 98077], [74, 98277], [80, 98997], [89, 99925], [96, 100322], [103, 100682], [106, 101122], [111, 101422], [114, 101582], [118, 101702], [128, 102732], [132, 102858], [136, 103078], [140, 103338], [148, 103658], [151, 103958], [158, 104834], [172, 105711], [176, 105883], [181, 106123], [184, 106323], [189, 106523], [194, 106803], [198, 107103]]}, {"verse": 12, "start": 108304, "end": 111973, "text": "Hicieron, pues, sus hijos con él, según les había mandado:", "words": [[0, 108304], [10, 108769], [16, 109009], [20, 109509], [26, 109809], [30, 110129], [34, 110289], [40, 110669], [44, 110929], [50, 111249]]}, {"verse": 13, "start": 112323, "end": 129699, "text": "Pues lo llevaron sus hijos a la tierra de Canaán, y le sepultaron en la cueva del campo de Macpela, la que había comprado Abraham con el mismo campo, para heredad de sepultura, de Efrón el heteo, delante de Mamre.", "words": [[0, 112323], [5, 112464], [8, 112644], [17, 113124], [21, 113364], [27, 113664], [29, 113924], [32, 114004], [39, 114324], [42, 114564], [50, 115264], [52, 115654], [55, 116044], [66, 116924], [69, 117244], [72, 117404], [78, 117784], [82, 117924], [88, 118404], [91, 118644], [100, 119904], [103, 120224], [107, 120364], [113, 120624], [122, 121284], [130, 121984], [134, 122584], [137, 122764], [143, 123084], [150, 124065], [155, 124253], [163, 124853], [166, 125033], [177, 125853], [180, 126208], [186, 126948], [189, 127488], [196, 128028], [204, 128888], [207, 129324]]}, {"verse": 14, "start": 130049, "end": 140187, "text": "Y José regresó a Egipto, él y sus hermanos, y todos los que subieron con él a sepultar a su padre, después que le hubo sepultado.", "words": [[0, 130049], [2, 130192], [7, 130532], [15, 131392], [17, 131532], [25, 132652], [28, 132952], [30, 133412], [34, 133592], [44, 134612], [46, 134712], [52, 135052], [56, 135352], [60, 135492], [69, 136012], [73, 136232], [76, 136472], [78, 136732], [87, 137292], [89, 137372], [92, 137532], [99, 137992], [107, 138592], [111, 138852], [114, 138972], [119, 139252]]}, {"verse": 15, "start": 140537, "end": 149586, "text": "Y viendo los hermanos de José que su padre era muerto, dijeron: Quizá nos aborrecerá José, y nos dará el pago de todo el mal que le hicimos.", "words": [[0, 140537], [2, 140644], [9, 140884], [13, 141064], [22, 141564], [25, 141664], [30, 141944], [34, 142164], [37, 142324], [43, 142604], [47, 142884], [55, 143604], [64, 144518], [70, 144842], [74, 144962], [85, 145702], [91, 146002], [93, 146382], [97, 146522], [102, 146862], [105, 147062], [110, 147562], [113, 147742], [118, 147962], [121, 148202], [125, 148462], [129, 148702], [132, 148822]]}, {"verse": 16, "start": 149936, "end": 155535, "text": "Y enviaron a decir a José: Tu padre mandó antes de su muerte, diciendo:", "words": [[0, 149936], [2, 150193], [11, 150713], [13, 150813], [19, 151093], [21, 151253], [27, 151901], [30, 151984], [36, 152304], [42, 152884], [48, 153264], [51, 153484], [54, 153644], [62, 154624]]}, {"verse": 17, "start": 155885, "end": 171747, "text": "Así diréis a José: Te ruego que perdones ahora la maldad de tus hermanos y su pecado, porque mal te trataron: por tanto ahora te rogamos que perdones la maldad de los siervos del Dios de tu padre. Y José lloró mientras hablaban.", "words": [[0, 155885], [4, 156126], [11, 156566], [13, 156746], [19, 157492], [22, 157754], [28, 158114], [32, 158314], [41, 158874], [47, 159114], [50, 159374], [57, 159814], [60, 159994], [64, 160154], [73, 160754], [75, 160854], [78, 160994], [86, 161474], [93, 161934], [97, 162314], [100, 162554], [110, 163578], [114, 163700], [120, 164620], [126, 164880], [129, 165100], [137, 165720], [141, 165920], [150, 166540], [153, 166760], [160, 167180], [163, 167380], [167, 167520], [175, 168040], [179, 168280], [184, 168520], [187, 168740], [190, 168860], [197, 169617], [199, 169887], [204, 170127], [210, 170687], [219, 171307]]}, {"verse": 18, "start": 172097, "end": 178687, "text": "Y vinieron también sus hermanos, y se postraron delante de él, y dijeron: Aquí nos tienes por tus siervos.", "words": [[0, 172097], [2, 172218], [11, 172658], [19, 172998], [23, 173258], [33, 174198], [35, 174338], [38, 174478], [48, 175098], [56, 175558], [59, 175778], [63, 175978], [65, 176138], [74, 177017], [79, 177214], [83, 177394], [90, 177634], [94, 177874], [98, 178014]]}, {"verse": 19, "start": 179037, "end": 183049, "text": "Y les respondió José: No temáis: ¿estoy yo en lugar de Dios?", "words": [[0, 179037], [2, 179165], [6, 179305], [16, 179845], [22, 180536], [25, 180934], [33, 181529], [40, 181866], [43, 182026], [46, 182146], [52, 182366], [55, 182586]]}, {"verse": 20, "start": 183399, "end": 190739, "text": "Vosotros pensasteis mal sobre mí, mas Dios lo encaminó a bien, para hacer lo que vemos hoy, para mantener en vida a mucho pueblo.", "words": [[0, 183399], [9, 183817], [20, 184537], [24, 184697], [30, 184977], [34, 185557], [38, 185777], [43, 185957], [46, 186137], [55, 186637], [57, 186697], [63, 186897], [68, 187257], [74, 187497], [77, 187637], [81, 187757], [87, 187977], [92, 188577], [97, 188837], [106, 189257], [109, 189477], [114, 189697], [116, 189857], [122, 189997]]}, {"verse": 21, "start": 191089, "end": 199591, "text": "Ahora, pues, no tengáis miedo; yo os sustentaré a vosotros y a vuestros hijos. Así los consoló, y les habló al corazón.", "words": [[0, 191089], [7, 191370], [13, 191650], [16, 192130], [24, 192590], [31, 193328], [34, 193405], [37, 193525], [48, 194225], [50, 194345], [59, 194845], [61, 195045], [63, 195145], [72, 195505], [79, 196303], [83, 196567], [87, 196747], [96, 197507], [98, 197927], [102, 198107], [108, 198627], [111, 198747]]}, {"verse": 22, "start": 199941, "end": 206804, "text": "Y estuvo José en Egipto, él y la casa de su padre: y vivió José ciento diez años.", "words": [[0, 199941], [2, 200050], [9, 200470], [14, 200890], [17, 201210], [25, 202090], [28, 202350], [30, 202590], [33, 202750], [38, 203010], [41, 203230], [44, 203370], [51, 204214], [53, 204458], [59, 204818], [64, 205151], [71, 205485], [76, 205818]]}, {"verse": 23, "start": 207154, "end": 217793, "text": "Y vio José los hijos de Efraín hasta la tercera generación: también los hijos de Maquir, hijo de Manasés, fueron criados sobre las rodillas de José.", "words": [[0, 207154], [2, 207278], [6, 207538], [11, 207878], [15, 208118], [21, 208398], [24, 208698], [31, 209338], [37, 209938], [40, 210158], [48, 210678], [60, 211822], [68, 212106], [72, 212346], [78, 212646], [81, 213156], [89, 213666], [94, 213826], [97, 214006], [106, 214846], [113, 215166], [121, 215866], [127, 216426], [131, 216666], [140, 217126], [143, 217306]]}, {"verse": 24, "start": 218143, "end": 228083, "text": "Y José dijo a sus hermanos: Yo me muero; mas Dios ciertamente os visitará, y os hará subir de esta tierra a la tierra que juró a Abraham, a Isaac, y a Jacob.", "words": [[0, 218143], [2, 218345], [7, 218645], [12, 219185], [14, 219305], [18, 219425], [28, 220456], [31, 220602], [34, 220682], [41, 221381], [45, 221544], [50, 221744], [62, 222364], [65, 222544], [75, 223084], [77, 223544], [80, 223664], [85, 223864], [91, 224084], [94, 224404], [99, 224604], [106, 224964], [108, 225144], [111, 225204], [118, 225524], [122, 225724], [127, 226084], [129, 226184], [138, 226524], [140, 226864], [147, 227184], [149, 227544], [151, 227604]]}, {"verse": 25, "start": 228363, "end": 235636, "text": "Y conjuró José a los hijos de Israel, diciendo: Dios ciertamente os visitará, y haréis llevar de aquí mis huesos.", "words": [[0, 228363], [2, 228486], [10, 229126], [15, 229486], [17, 229726], [21, 229866], [27, 230146], [30, 230366], [38, 230846], [48, 232027], [53, 232266], [65, 232926], [68, 233066], [78, 233626], [80, 234026], [87, 234286], [94, 234526], [97, 234666], [102, 234826], [106, 234986]]}, {"verse": 26, "start": 235916, "end": 243693, "text": "Y murió José de edad de ciento diez años; y lo embalsamaron, y fue puesto en un ataúd en Egipto.", "words": [[0, 235916], [2, 236041], [8, 236481], [13, 236841], [16, 237081], [21, 237461], [24, 237748], [31, 238034], [36, 238321], [42, 239556], [44, 239703], [47, 