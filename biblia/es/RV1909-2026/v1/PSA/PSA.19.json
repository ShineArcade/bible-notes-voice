{"book": "PSA", "chapter": 19, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 103715, "verses": [{"verse": 1, "start": 300, "end": 8533, "text": "Al Músico principal: Salmo de David. LOS cielos cuentan la gloria de Dios, y la expansión denuncia la obra de sus manos.", "words": [[0, 300], [3, 465], [10, 885], [21, 1868], [27, 2387], [30, 2527], [37, 3192], [41, 3319], [48, 3919], [56, 4399], [59, 4579], [66, 4979], [69, 5119], [75, 5399], [77, 5659], [80, 5799], [90, 6499], [99, 7139], [102, 7319], [107, 7579], [110, 7759], [114, 7899]]}, {"verse": 2, "start": 8883, "end": 15339, "text": "El un día emite palabra al otro día, y la una noche a la otra noche declara sabiduría.", "words": [[0, 8883], [3, 9032], [6, 9172], [10, 9412], [16, 9912], [24, 10392], [27, 10692], [32, 10912], [37, 11712], [39, 11992], [42, 12112], [46, 12272], [52, 12612], [54, 12912], [57, 13012], [62, 13212], [68, 13632], [76, 14372]]}, {"verse": 3, "start": 15689, "end": 19241, "text": "No hay dicho, ni palabras, ni es oída su voz.", "words": [[0, 15689], [3, 15835], [7, 15975], [14, 16255], [17, 16435], [27, 17415], [30, 17735], [33, 17935], [38, 18395], [41, 18635]]}, {"verse": 4, "start": 19591, "end": 27360, "text": "Por toda la tierra salió su hilo, y al cabo del mundo sus palabras. En ellos puso tabernáculo para el sol.", "words": [[0, 19591], [4, 19715], [9, 19975], [12, 20195], [19, 20495], [25, 21035], [28, 21255], [34, 21895], [36, 22055], [39, 22215], [44, 22455], [48, 22695], [54, 22935], [58, 23215], [68, 24367], [71, 24534], [77, 24854], [82, 25614], [94, 26394], [99, 26714], [102, 26894]]}, {"verse": 5, "start": 27710, "end": 34175, "text": "Y él, como un novio que sale de su habitación nupcial, se alegra cual gigante para correr el camino.", "words": [[0, 27710], [2, 27894], [6, 28194], [11, 28354], [14, 28574], [20, 29054], [24, 29174], [29, 29454], [32, 29654], [35, 29834], [46, 30414], [55, 31254], [58, 31434], [65, 31764], [70, 32094], [78, 32714], [83, 32934], [90, 33274], [93, 33554]]}, {"verse": 6, "start": 34525, "end": 43368, "text": "De un extremo de los cielos es su salida, y su giro hasta la extremidad de ellos: y no hay quien se esconda de su calor.", "words": [[0, 34525], [3, 34691], [6, 34891], [14, 35691], [17, 35771], [21, 35931], [28, 36471], [31, 36671], [34, 36891], [42, 37471], [44, 37891], [47, 38071], [52, 38551], [58, 38851], [61, 39091], [72, 39831], [75, 40051], [82, 40782], [84, 40918], [87, 41118], [91, 41418], [97, 41678], [100, 41898], [108, 42458], [111, 42598], [114, 42778]]}, {"verse": 7, "start": 43718, "end": 50381, "text": "La ley de Jehová es perfecta, que vuelve el alma: el testimonio de Jehová, fiel, que hace sabio al pequeño.", "words": [[0, 43718], [3, 43824], [7, 44024], [10, 44184], [17, 44564], [20, 44644], [30, 45444], [34, 45524], [41, 45884], [44, 46064], [50, 46783], [53, 46930], [64, 47530], [67, 47630], [75, 48190], [81, 48770], [85, 48850], [90, 49030], [96, 49550], [99, 49670]]}, {"verse": 8, "start": 50731, "end": 58312, "text": "Los mandamientos de Jehová son rectos, que alegran el corazón: el precepto de Jehová, puro, que alumbra los ojos.", "words": [[0, 50731], [4, 50832], [17, 51472], [20, 51652], [27, 52052], [31, 52172], [39, 52912], [43, 53192], [51, 53752], [54, 54052], [63, 55067], [66, 55209], [75, 55929], [78, 56009], [86, 56609], [92, 56869], [96, 57029], [104, 57469], [108, 57629]]}, {"verse": 9, "start": 58662, "end": 65043, "text": "El temor de Jehová, limpio, que permanece para siempre; los juicios de Jehová son verdad, todos justos.", "words": [[0, 58662], [3, 58809], [9, 59189], [12, 59329], [20, 59749], [28, 60329], [32, 60449], [42, 61009], [47, 61209], [56, 62131], [60, 62383], [68, 62743], [71, 62923], [78, 63343], [82, 63423], [90, 64143], [96, 64463]]}, {"verse": 10, "start": 65393, "end": 72939, "text": "Deseables son más que el oro, y más que mucho oro afinado; y dulces más que miel, y que la que destila del panal.", "words": [[0, 65393], [10, 66018], [14, 66318], [18, 66558], [22, 66778], [25, 66978], [30, 67198], [32, 67378], [36, 67558], [40, 67698], [46, 68038], [50, 68478], [59, 69547], [61, 69674], [68, 70034], [72, 70254], [76, 70434], [82, 70854], [84, 71149], [88, 71289], [91, 71429], [95, 71569], [103, 72069], [107, 72229]]}, {"verse": 11, "start": 73289, "end": 78675, "text": "Tu siervo es además amonestado con ellos: en guardarlos hay grande recompensa.", "words": [[0, 73289], [3, 73393], [10, 73873], [13, 74053], [20, 74373], [31, 75293], [35, 75553], [42, 76425], [45, 76767], [56, 77147], [60, 77327], [67, 77627]]}, {"verse": 12, "start": 79025, "end": 84138, "text": "Los errores, ¿quién los entenderá? Líbrame de los que me son ocultos.", "words": [[0, 79025], [4, 79151], [13, 80271], [20, 80611], [24, 80751], [35, 82310], [43, 82720], [46, 83020], [50, 83160], [54, 83300], [57, 83440], [61, 83620]]}, {"verse": 13, "start": 84488, "end": 94631, "text": "Detén asimismo a tu siervo de las soberbias; no permitas que me dominen: entonces seré íntegro, y estaré limpio de gran rebelión.", "words": [[0, 85290], [6, 85730], [15, 86170], [17, 86330], [20, 86430], [27, 86930], [30, 87070], [34, 87230], [45, 88373], [48, 88693], [57, 89393], [61, 89533], [64, 89673], [73, 90610], [82, 91071], [87, 91531], [96, 92451], [98, 92631], [105, 92991], [112, 93511], [115, 93611], [120, 93851]]}, {"verse": 14, "start": 94981, "end": 103315, "text": "Sean gratos los dichos de mi boca y la meditación de mi corazón delante de ti, oh Jehová, roca mía, y redentor mío.", "words": [[0, 94981], [5, 95618], [12, 96288], [16, 96388], [23, 96748], [26, 96828], [29, 96948], [34, 97268], [36, 97708], [39, 97848], [50, 98568], [53, 98768], [56, 98868], [64, 99308], [72, 99868], [75, 100048], [79, 100268], [82, 100488], [90, 100955], [95, 101421], [100, 101888], [102, 102382], [111, 102876]]}]}