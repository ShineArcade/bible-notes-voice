{"book": "LUK", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 515833, "verses": [{"verse": 1, "start": 300, "end": 8098, "text": "Habiendo muchos intentado poner en orden la historia de las cosas que entre nosotros han sido ciertísimas,", "words": [[0, 300], [9, 656], [16, 1016], [26, 1876], [32, 2216], [35, 2436], [41, 2756], [44, 3336], [53, 3836], [56, 4096], [60, 4236], [66, 4676], [70, 4976], [76, 5296], [85, 5796], [89, 6276], [94, 6656]]}, {"verse": 2, "start": 8448, "end": 14902, "text": "Como nos lo enseñaron los que desde el principio lo vieron por sus ojos, y fueron ministros de la palabra;", "words": [[0, 8448], [5, 8614], [9, 8814], [12, 8954], [22, 9754], [26, 9874], [30, 10074], [36, 10414], [39, 10654], [49, 11234], [52, 11474], [59, 11774], [63, 11974], [67, 12194], [73, 12574], [75, 13074], [82, 13294], [92, 13954], [95, 14094], [98, 14194]]}, {"verse": 3, "start": 15252, "end": 26078, "text": "Me ha parecido también a mí, después de haber entendido todas las cosas desde el principio con diligencia, escribírtelas por orden, oh muy buen Teófilo,", "words": [[0, 15252], [3, 15418], [6, 15558], [15, 16058], [23, 16418], [25, 16658], [29, 17038], [37, 17638], [40, 17818], [46, 17998], [56, 18658], [62, 18978], [66, 19298], [72, 19658], [78, 20078], [81, 20378], [91, 20978], [95, 21758], [107, 22538], [121, 23458], [125, 23698], [132, 24218], [135, 24738], [139, 25078], [144, 25378]]}, {"verse": 4, "start": 26428, "end": 31390, "text": "Para que conozcas la verdad de las cosas en las cuales has sido enseñado.", "words": [[0, 26428], [5, 26613], [9, 26773], [18, 27293], [21, 27453], [28, 27693], [31, 28013], [35, 28173], [41, 28573], [44, 29253], [48, 29353], [55, 29703], [59, 30053], [64, 30413]]}, {"verse": 5, "start": 31740, "end": 43665, "text": "HUBO en los días de Herodes, rey de Judea, un sacerdote llamado Zacarías, del grupo sacerdotal de Abías; y su mujer, de las hijas de Aarón, llamada Elisabet.", "words": [[0, 31740], [5, 32006], [8, 32066], [12, 32166], [17, 32426], [20, 32646], [29, 33186], [33, 33726], [36, 33946], [43, 34926], [46, 35026], [56, 35726], [64, 36046], [74, 37446], [78, 37526], [84, 37866], [95, 39106], [98, 39570], [105, 40206], [107, 40309], [110, 40429], [117, 40749], [120, 40909], [124, 41089], [130, 41429], [133, 41909], [140, 42389], [148, 43057]]}, {"verse": 6, "start": 44015, "end": 51642, "text": "Y eran ambos justos delante de Dios, andando sin reprensión en todos los mandamientos y estatutos del Señor.", "words": [[0, 44015], [2, 44158], [7, 44398], [13, 44998], [20, 45658], [28, 46118], [31, 46298], [37, 46898], [45, 47458], [49, 47948], [60, 48438], [63, 48778], [69, 49098], [73, 49318], [86, 50058], [88, 50278], [98, 50778], [102, 51038]]}, {"verse": 7, "start": 51992, "end": 58853, "text": "Y no tenían hijo, porque Elisabet era estéril, y ambos eran avanzados en días.", "words": [[0, 51992], [2, 52138], [5, 52438], [12, 52738], [18, 53598], [25, 54088], [34, 54578], [38, 55268], [47, 55958], [49, 56138], [55, 56518], [60, 57018], [70, 57938], [73, 58178]]}, {"verse": 8, "start": 59203, "end": 66495, "text": "Y aconteció que ejerciendo Zacarías el sacerdocio delante de Dios según el turno que le correspondía,", "words": [[0, 59203], [2, 59506], [12, 60166], [16, 60786], [27, 61406], [36, 62026], [39, 62226], [50, 63026], [58, 63486], [61, 63666], [66, 64306], [72, 64586], [75, 64826], [81, 65306], [85, 65386], [88, 65506]]}, {"verse": 9, "start": 66845, "end": 75072, "text": "Conforme a la costumbre del sacerdocio, salió en suerte a poner el incienso, entrando en el templo del Señor.", "words": [[0, 66845], [9, 67354], [11, 67554], [14, 67614], [24, 68194], [28, 68374], [40, 69714], [46, 70274], [49, 70534], [56, 71054], [58, 71214], [64, 71494], [67, 71694], [77, 72754], [86, 73354], [89, 73514], [92, 73654], [99, 74194], [103, 74334]]}, {"verse": 10, "start": 75422, "end": 80632, "text": "Y toda la multitud del pueblo estaba fuera orando a la hora del incienso.", "words": [[0, 75422], [2, 75560], [7, 75960], [10, 76220], [19, 76760], [23, 76960], [30, 77380], [37, 77680], [43, 78040], [50, 78780], [52, 79040], [55, 79160], [60, 79400], [64, 79620]]}, {"verse": 11, "start": 80982, "end": 86732, "text": "Y se le apareció el ángel del Señor puesto en pie a la derecha del altar del incienso.", "words": [[0, 80982], [2, 81129], [5, 81229], [8, 81389], [17, 82049], [20, 82349], [26, 82829], [30, 82949], [36, 83269], [43, 83669], [46, 84009], [50, 84249], [52, 84449], [55, 84549], [63, 84989], [67, 85209], [73, 85609], [77, 85889]]}, {"verse": 12, "start": 87082, "end": 90577, "text": "Y se turbó Zacarías viéndole, y cayó temor sobre él.", "words": [[0, 87082], [2, 87191], [5, 87311], [11, 87811], [20, 88311], [30, 88871], [32, 89071], [37, 89451], [43, 89831], [49, 90131]]}, {"verse": 13, "start": 90927, "end": 100038, "text": "Pero el ángel le dijo: Zacarías, no temas; porque tu oración ha sido oída, y tu mujer Elisabet te parirá un hijo, y llamarás su nombre Juan.", "words": [[0, 90927], [5, 91211], [8, 91371], [14, 91851], [17, 92131], [23, 93020], [33, 93310], [36, 93470], [43, 94284], [50, 94450], [53, 94670], [61, 95090], [64, 95290], [69, 95530], [75, 95970], [77, 96330], [80, 96450], [86, 96790], [95, 97130], [98, 97550], [105, 97930], [108, 98090], [114, 98350], [116, 98770], [125, 99170], [128, 99310], [135, 99530]]}, {"verse": 14, "start": 100388, "end": 103885, "text": "Y tendrás gozo y alegría, y muchos se gozarán de su nacimiento.", "words": [[0, 100388], [2, 100473], [10, 100793], [15, 101173], [17, 101293], [26, 101793], [28, 101973], [35, 102273], [38, 102473], [46, 102933], [49, 102993], [52, 103113]]}, {"verse": 15, "start": 104235, "end": 112458, "text": "Porque será grande delante de Dios, y no beberá vino ni bebida embriagante; y será lleno del Espíritu Santo, aun desde el seno de su madre.", "words": [[0, 104235], [7, 104465], [12, 104705], [19, 105105], [27, 105565], [30, 105745], [36, 106025], [38, 106300], [41, 106440], [48, 106860], [53, 107140], [56, 107360], [63, 107740], [76, 108838], [78, 108942], [83, 109122], [89, 109542], [93, 109662], [102, 110222], [109, 110582], [113, 110962], [119, 111242], [122, 111462], [127, 111782], [130, 111862], [133, 112002]]}, {"verse": 16, "start": 112808, "end": 116348, "text": "Y a muchos de los hijos de Israel convertirá al Señor Dios de ellos.", "words": [[0, 112808], [2, 112909], [4, 113009], [11, 113269], [14, 113449], [18, 113569], [24, 113789], [27, 113949], [34, 114269], [45, 114989], [48, 115089], [54, 115329], [59, 115629], [62, 115889]]}, {"verse": 17, "start": 116698, "end": 128621, "text": "Porque él irá delante de él con el espíritu y poder de Elías, para convertir los corazones de los padres a los hijos, y los rebeldes a la prudencia de los justos, para preparar al Señor un pueblo bien dispuesto.", "words": [[0, 116698], [7, 116917], [10, 117117], [14, 117357], [22, 117777], [25, 117917], [28, 118057], [32, 118257], [35, 118377], [44, 118957], [46, 119037], [52, 119277], [55, 119497], [62, 120117], [67, 120377], [77, 120957], [81, 121077], [91, 121677], [94, 121817], [98, 121957], [105, 122297], [107, 122537], [111, 122677], [118, 123475], [120, 123574], [124, 123674], [133, 124154], [135, 124274], [138, 124354], [148, 124794], [151, 124914], [155, 125054], [163, 125874], [168, 126174], [177, 126694], [180, 126774], [186, 127034], [189, 127274], [196, 127574], [201, 127854]]}, {"verse": 18, "start": 128901, "end": 135710, "text": "Y dijo Zacarías al ángel: ¿En qué conoceré esto? porque yo soy viejo, y mi mujer avanzada en días.", "words": [[0, 128901], [2, 129027], [7, 129645], [16, 130262], [19, 130482], [26, 131340], [30, 131477], [34, 131677], [43, 132217], [49, 132798], [56, 132978], [59, 133158], [63, 133338], [70, 133858], [72, 134178], [75, 134278], [81, 134518], [90, 135078], [93, 135198]]}, {"verse": 19, "start": 135990, "end": 145948, "text": "Y respondiendo el ángel le dijo: Yo soy Gabriel, que estoy delante de Dios; y soy enviado a hablarte, y a darte estas buenas nuevas.", "words": [[0, 135990], [2, 136197], [15, 137397], [18, 137597], [24, 138097], [27, 138217], [33, 139132], [36, 139282], [40, 139482], [49, 140102], [53, 140122], [59, 140402], [67, 140862], [70, 141022], [76, 141833], [78, 141958], [82, 142038], [90, 142618], [92, 142718], [102, 143318], [104, 143498], [106, 143638], [112, 143938], [118, 144158], [125, 144478]]}, {"verse": 20, "start": 146298, "end": 154377, "text": "Y he aquí estarás mudo y no podrás hablar, hasta el día que esto sea hecho, por cuanto no creíste a mis palabras, las cuales se cumplirán a su tiempo.", "words": [[0, 146298], [2, 146442], [5, 146562], [10, 146762], [18, 147242], [23, 147562], [25, 147642], [28, 147762], [35, 148142], [43, 148822], [49, 149082], [52, 149242], [56, 149422], [60, 149582], [65, 149782], [69, 150082], [76, 150562], [80, 150662], [87, 150842], [90, 151082], [98, 151362], [100, 151642], [104, 151762], [114, 152502], [118, 152622], [125, 152902], [128, 153162], [138, 153662], [140, 153722], [143, 153862]]}, {"verse": 21, "start": 154657, "end": 160507, "text": "Y el pueblo estaba esperando a Zacarías, y se maravillaban de que él se detuviese en el templo.", "words": [[0, 154657], [2, 154778], [5, 154918], [12, 155178], [19, 155518], [29, 156038], [31, 156218], [41, 156778], [43, 157243], [46, 157383], [59, 158063], [62, 158303], [66, 158443], [69, 158683], [72, 158863], [82, 159523], [85, 159703], [88, 159843]]}, {"verse": 22, "start": 160857, "end": 170318, "text": "Y saliendo, no les podía hablar: y entendieron que había visto visión en el templo: y él les hablaba por señas, y quedó mudo.", "words": [[0, 160857], [2, 160962], [12, 161422], [15, 161702], [19, 161902], [25, 162282], [33, 163161], [35, 163361], [47, 164061], [51, 164281], [57, 164481], [63, 164801], [70, 165341], [73, 165581], [76, 165741], [84, 166629], [86, 166849], [89, 167109], [93, 167489], [101, 168009], [105, 168229], [112, 169209], [114, 169449], [120, 169789]]}, {"verse": 23, "start": 170668, "end": 174666, "text": "Y fue, que cumplidos los días de su oficio, se vino a su casa.", "words": [[0, 170668], [2, 170775], [7, 170915], [11, 171055], [21, 171735], [25, 171915], [30, 172175], [33, 172355], [36, 172535], [44, 173355], [47, 173575], [52, 173775], [54, 173955], [57, 174055]]}, {"verse": 24, "start": 175016, "end": 181966, "text": "Y después de aquellos días concibió su mujer Elisabet, y se mantuvo oculta por cinco meses, diciendo:", "words": [[0, 175016], [2, 175125], [10, 175445], [13, 175605], [22, 175765], [27, 176145], [36, 176905], [39, 177045], [45, 177595], [55, 178145], [57, 178700], [60, 178820], [68, 179340], [75, 180000], [79, 180140], [85, 180440], [92, 181260]]}, {"verse": 25, "start": 182166, "end": 187456, "text": "Porque el Señor me ha hecho así en los días en que miró para quitar mi vergüenza entre los hombres.", "words": [[0, 182166], [7, 182366], [10, 182466], [16, 182726], [19, 182986], [22, 183066], [28, 183246], [32, 183566], [35, 183826], [39, 183986], [44, 184266], [47, 184506], [51, 184626], [56, 184966], [61, 185246], [68, 185626], [71, 185766], [81, 186326], [87, 186566], [91, 186746]]}, {"verse": 26, "start": 187736, "end": 195195, "text": "Y al sexto mes, el ángel Gabriel fue enviado de Dios a una ciudad de Galilea, llamada Nazaret,", "words": [[0, 187736], [2, 187893], [5, 188053], [11, 188513], [16, 189313], [19, 189613], [25, 190013], [33, 190413], [37, 190773], [45, 191333], [48, 191533], [53, 191773], [55, 191993], [59, 192153], [66, 192493], [69, 192773], [78, 193711], [86, 194291]]}, {"verse": 27, "start": 195545, "end": 203126, "text": "A una virgen desposada con un varón que se llamaba José, de la casa de David: y el nombre de la virgen era María.", "words": [[0, 195557], [2, 195657], [6, 195817], [13, 196237], [23, 196937], [27, 197177], [30, 197317], [36, 197657], [40, 197817], [43, 197937], [51, 198297], [57, 198757], [60, 199177], [63, 199277], [68, 199537], [71, 199777], [78, 200567], [80, 200728], [83, 200888], [90, 201288], [93, 201468], [96, 201608], [103, 202128], [107, 202468]]}, {"verse": 28, "start": 203476, "end": 211668, "text": "Y entrando el ángel a donde estaba, dijo, ¡Salve, muy favorecida! el Señor es contigo: bendita tú entre las mujeres.", "words": [[0, 203476], [2, 203623], [11, 204083], [14, 204303], [20, 204783], [22, 204883], [28, 205063], [36, 205503], [42, 206440], [50, 206841], [54, 207041], [66, 208119], [69, 208281], [75, 208561], [78, 208781], [87, 209746], [95, 210283], [98, 210503], [104, 210723], [108, 210943]]}, {"verse": 29, "start": 211948, "end": 218663, "text": "Pero ella, cuando le vio, se turbó de sus palabras, y pensaba qué clase de saludo era este.", "words": [[0, 211948], [5, 212113], [11, 212573], [18, 212673], [21, 212953], [26, 213713], [29, 213933], [35, 214393], [38, 214493], [42, 214653], [52, 215233], [54, 215688], [62, 216268], [66, 216508], [72, 217008], [75, 217228], [82, 217788], [86, 218048]]}, {"verse": 30, "start": 219013, "end": 224537, "text": "Entonces el ángel le dijo: María, no temas, porque has hallado gracia ante Dios.", "words": [[0, 219013], [9, 219873], [12, 220153], [18, 220573], [21, 220673], [27, 221402], [34, 221781], [37, 221841], [44, 222481], [51, 222701], [55, 222941], [63, 223281], [70, 223621], [75, 224081]]}, {"verse": 31, "start": 224887, "end": 229846, "text": "Y he aquí, concebirás en tu seno, y parirás un hijo, y llamarás su nombre JESÚS.", "words": [[0, 224887], [2, 225045], [5, 225145], [11, 225405], [22, 226125], [25, 226265], [28, 226405], [34, 227105], [36, 227145], [44, 227625], [47, 227785], [53, 228045], [55, 228365], [64, 228785], [67, 228925], [74, 229165]]}, {"verse": 32, "start": 230196, "end": 236473, "text": "Este será grande, y será llamado Hijo del Altísimo: y le dará el Señor Dios el trono de David su padre:", "words": [[0, 230196], [5, 230432], [10, 230692], [18, 231112], [20, 231372], [25, 231552], [33, 231952], [38, 232372], [42, 232532], [52, 233521], [54, 233645], [57, 233725], [62, 233985], [65, 234065], [71, 234345], [76, 234685], [79, 235005], [85, 235325], [88, 235425], [94, 235725], [97, 235985]]}, {"verse": 33, "start": 236753, "end": 241740, "text": "Y reinará en la casa de Jacob por siempre; y de su reino no habrá fin.", "words": [[0, 236753], [2, 236879], [10, 237539], [13, 237619], [16, 237739], [21, 238019], [24, 238239], [30, 238559], [34, 238899], [43, 239829], [45, 239935], [48, 240055], [51, 240195], [57, 240695], [60, 240875], [66, 241195]]}, {"verse": 34, "start": 242090, "end": 247263, "text": "Entonces María dijo al ángel: ¿Cómo será esto? porque no conozco varón.", "words": [[0, 242090], [9, 242455], [15, 243395], [20, 243735], [23, 243915], [30, 244636], [36, 244839], [41, 245099], [47, 245907], [54, 246071], [57, 246231], [65, 246671]]}, {"verse": 35, "start": 247543, "end": 259303, "text": "Y respondiendo el ángel le dijo: El Espíritu Santo vendrá sobre ti, y el poder del Altísimo te hará sombra; por lo cual también lo Santo que nacerá, será llamado Hijo de Dios.", "words": [[0, 247543], [2, 247750], [15, 248950], [18, 249150], [24, 249650], [27, 249770], [33, 250543], [36, 250661], [45, 251181], [51, 251461], [58, 251981], [64, 252201], [68, 252501], [70, 253081], [73, 253201], [79, 253441], [83, 253661], [92, 254221], [95, 254501], [100, 254721], [108, 255461], [112, 255566], [115, 255686], [120, 255886], [128, 256166], [131, 256446], [137, 256786], [141, 256946], [149, 257406], [154, 257886], [162, 258326], [167, 258646], [170, 258806]]}, {"verse": 36, "start": 259653, "end": 267034, "text": "Y he aquí, Elisabet tu parienta, también ella ha concebido hijo en su vejez; y este es el sexto mes a ella que es llamada la estéril:", "words": [[0, 259653], [2, 259794], [5, 259914], [11, 260214], [20, 260514], [23, 260754], [33, 261594], [41, 261854], [46, 262134], [49, 262294], [59, 262814], [64, 263054], [67, 263291], [70, 263527], [77, 263984], [79, 264151], [84, 264411], [87, 264591], [90, 264711], [96, 265091], [100, 265291], [102, 265431], [107, 265631], [111, 265831], [114, 265971], [122, 266331], [125, 266451]]}, {"verse": 37, "start": 267384, "end": 269896, "text": "Porque ninguna cosa es imposible para Dios.", "words": [[0, 267384], [7, 267569], [15, 267889], [20, 268309], [23, 268509], [33, 269109], [38, 269329]]}, {"verse": 38, "start": 270176, "end": 278389, "text": "Entonces María dijo: He aquí la sierva del Señor; hágase a mí conforme a tu palabra. Y el ángel partió de ella.", "words": [[0, 270176], [9, 270721], [15, 271261], [21, 272189], [24, 272249], [29, 272529], [32, 272729], [39, 273169], [43, 273309], [50, 274152], [57, 274578], [59, 274718], [62, 274838], [71, 275458], [73, 275498], [76, 275578], [85, 276525], [87, 276690], [90, 276830], [96, 277290], [103, 277750], [106, 277910]]}, {"verse": 39, "start": 278739, "end": 285125, "text": "En aquellos días levantándose María, fue a la montaña con prisa, a una ciudad de Judá;", "words": [[0, 278739], [3, 279029], [12, 279229], [17, 280109], [30, 280909], [37, 281249], [41, 281609], [43, 281749], [46, 281809], [54, 282349], [58, 282569], [65, 283149], [67, 283529], [71, 283689], [78, 284069], [81, 284329]]}, {"verse": 40, "start": 285475, "end": 289615, "text": "Y entró en casa de Zacarías, y saludó a Elisabet.", "words": [[0, 285475], [2, 285642], [8, 286062], [11, 286202], [16, 286482], [19, 286962], [29, 287442], [31, 288022], [38, 288702], [40, 289193]]}, {"verse": 41, "start": 289965, "end": 299237, "text": "Y aconteció, que como oyó Elisabet el saludo de María, la criatura saltó en su vientre; y Elisabet fue llena del Espíritu Santo,", "words": [[0, 289965], [2, 290070], [13, 290850], [17, 291170], [22, 291350], [26, 291780], [35, 292210], [38, 292550], [45, 292950], [48, 293110], [55, 293950], [58, 294050], [67, 294650], [73, 295210], [76, 295310], [79, 295470], [88, 296369], [90, 296516], [99, 297076], [103, 297516], [109, 297936], [113, 298076], [122, 298656]]}, {"verse": 42, "start": 299587, "end": 306178, "text": "Y exclamó a gran voz, y dijo: Bendita tú entre las mujeres, y bendito el fruto de tu vientre.", "words": [[0, 299587], [2, 299770], [10, 300470], [12, 300570], [17, 300730], [22, 301110], [24, 301410], [30, 302080], [38, 302710], [41, 302930], [47, 303190], [51, 303430], [60, 303870], [62, 304235], [70, 304795], [73, 304955], [79, 305275], [82, 305415], [85, 305555]]}, {"verse": 43, "start": 306528, "end": 310993, "text": "¿Y de dónde esto a mí, que la madre de mi Señor venga a mí?", "words": [[0, 306528], [3, 306635], [6, 306755], [12, 306975], [17, 307355], [19, 307555], [23, 308055], [27, 308155], [30, 308295], [36, 308635], [39, 308835], [42, 308955], [48, 309335], [54, 309855], [56, 310035]]}, {"verse": 44, "start": 311343, "end": 317637, "text": "Porque he aquí, cuando llegó la voz de tu saludo a mis oídos, la criatura saltó de alegría en mi vientre.", "words": [[0, 311343], [7, 311543], [10, 311823], [16, 312103], [23, 312323], [29, 312663], [32, 312903], [36, 313143], [39, 313283], [42, 313403], [49, 313863], [51, 313983], [55, 314123], [62, 314963], [65, 315103], [74, 315643], [80, 316143], [83, 316243], [91, 316763], [94, 316883], [97, 317003]]}, {"verse": 45, "start": 317987, "end": 323885, "text": "Y bienaventurada la que creyó, porque se cumplirán las cosas que le fueron dichas de parte del Señor.", "words": [[0, 317987], [2, 318067], [17, 318887], [20, 319027], [24, 319187], [31, 319887], [38, 320387], [41, 320547], [51, 321047], [55, 321227], [61, 321567], [65, 321807], [68, 321947], [75, 322207], [82, 322667], [85, 322787], [91, 323047], [95, 323327]]}, {"verse": 46, "start": 324165, "end": 328221, "text": "Entonces María dijo: engrandece mi alma al Señor;", "words": [[0, 324165], [9, 324710], [15, 325250], [21, 326118], [32, 326899], [35, 327099], [40, 327379], [43, 327699]]}, {"verse": 47, "start": 328571, "end": 331285, "text": "Y mi espíritu se alegró en Dios mi Salvador.", "words": [[0, 328571], [2, 328680], [5, 328780], [14, 329460], [17, 329560], [24, 330000], [27, 330140], [32, 330560], [35, 330640]]}, {"verse": 48, "start": 331635, "end": 339305, "text": "Porque ha mirado a la condición humilde de su sierva; porque he aquí, desde ahora me dirán bienaventurada todas las generaciones.", "words": [[0, 331635], [7, 331813], [10, 332013], [17, 332473], [19, 332573], [22, 332633], [32, 333233], [40, 333753], [43, 333893], [46, 334033], [54, 334895], [61, 335095], [64, 335375], [70, 335675], [76, 335895], [82, 336340], [85, 336785], [91, 337230], [106, 337675], [112, 337915], [116, 338215]]}, {"verse": 49, "start": 339655, "end": 343713, "text": "Porque me ha hecho grandes cosas el Poderoso; y santo es su nombre.", "words": [[0, 339655], [7, 339802], [10, 340002], [13, 340102], [19, 340282], [27, 340582], [33, 341002], [36, 341262], [46, 342264], [48, 342374], [54, 342774], [57, 343074], [60, 343194]]}, {"verse": 50, "start": 344063, "end": 348393, "text": "Y su misericordia de generación a generación a los que le temen.", "words": [[0, 344063], [2, 344152], [5, 344292], [18, 345132], [21, 345232], [32, 346252], [34, 346432], [45, 347152], [47, 347432], [51, 347572], [55, 347712], [58, 347852]]}, {"verse": 51, "start": 348743, "end": 353945, "text": "Mostró poder con su brazo: esparció los soberbios del pensamiento de su corazón.", "words": [[0, 348743], [7, 349148], [13, 349408], [17, 349668], [20, 349848], [27, 350638], [36, 351225], [40, 351425], [50, 352025], [54, 352185], [66, 352885], [69, 353045], [72, 353185]]}, {"verse": 52, "start": 354295, "end": 357900, "text": "Quitó los poderosos de los tronos, y levantó a los humildes.", "words": [[0, 354295], [6, 354576], [10, 354716], [20, 355296], [23, 355456], [27, 355576], [35, 356116], [37, 356456], [45, 356956], [47, 357036], [51, 357156]]}, {"verse": 53, "start": 358250, "end": 362170, "text": "A los hambrientos llenó de bienes; y a los ricos envió vacíos.", "words": [[0, 358250], [2, 358374], [6, 358754], [18, 359134], [24, 359394], [27, 359514], [35, 360323], [37, 360446], [39, 360506], [43, 360666], [49, 361046], [55, 361466]]}, {"verse": 54, "start": 362520, "end": 367695, "text": "Recibió a Israel su siervo, acordándose de la misericordia,", "words": [[0, 362520], [8, 363121], [10, 363201], [17, 363621], [20, 363821], [28, 364341], [40, 365341], [43, 365461], [46, 365561]]}, {"verse": 55, "start": 368045, "end": 372669, "text": "Como habló a nuestros padres a Abraham y a su descendencia para siempre.", "words": [[0, 368045], [5, 368205], [11, 368585], [13, 368665], [22, 368865], [29, 369485], [31, 369865], [39, 370325], [41, 370765], [43, 370845], [46, 370925], [59, 371745], [64, 371945]]}, {"verse": 56, "start": 372949, "end": 377324, "text": "Y se quedó María con ella como tres meses: después se volvió a su casa.", "words": [[0, 372949], [2, 373071], [5, 373151], [11, 373471], [17, 373731], [21, 374031], [26, 374211], [31, 374491], [36, 374791], [43, 375751], [51, 376014], [54, 376214], [61, 376594], [63, 376654], [66, 376754]]}, {"verse": 57, "start": 377674, "end": 382097, "text": "Y a Elisabet se le cumplió el tiempo de parir, y parió un hijo.", "words": [[0, 377674], [2, 377821], [4, 378121], [13, 378421], [16, 378881], [19, 379021], [27, 379441], [30, 379541], [37, 379821], [40, 380021], [47, 380461], [49, 380861], [55, 381301], [58, 381621]]}, {"verse": 58, "start": 382447, "end": 389657, "text": "Y oyeron los vecinos y los parientes que Dios había hecho con ella grande misericordia, y se alegraron con ella.", "words": [[0, 382447], [2, 382588], [9, 383008], [13, 383148], [21, 383668], [23, 383848], [27, 383948], [37, 384428], [41, 384708], [46, 384948], [52, 385348], [58, 385728], [62, 385988], [67, 386168], [74, 386548], [88, 387568], [90, 388188], [93, 388348], [103, 388908], [107, 389168]]}, {"verse": 59, "start": 390007, "end": 398552, "text": "Y aconteció, que al octavo día vinieron para circuncidar al niño; y le llamaban del nombre de su padre, Zacarías.", "words": [[0, 390007], [2, 390479], [13, 390979], [17, 391179], [20, 391359], [27, 391799], [31, 392099], [40, 392739], [45, 393099], [57, 394119], [60, 394359], [66, 395241], [68, 395359], [71, 395509], [80, 396009], [84, 396229], [91, 396549], [94, 396769], [97, 396909], [104, 397766]]}, {"verse": 60, "start": 398902, "end": 403741, "text": "Y respondiendo su madre, dijo: No; sino Juan será llamado.", "words": [[0, 398902], [2, 399045], [15, 399885], [18, 400105], [25, 400745], [31, 401506], [35, 402146], [40, 402408], [45, 402748], [50, 403048]]}, {"verse": 61, "start": 404021, "end": 408513, "text": "Y le dijeron: ¿Por qué? nadie hay en tu parentela que se llame de este nombre.", "words": [[0, 404021], [2, 404168], [5, 404248], [14, 405211], [19, 405352], [24, 405902], [30, 406306], [34, 406446], [37, 406566], [40, 406686], [50, 407166], [54, 407326], [57, 407496], [63, 407666], [66, 407866], [71, 408026]]}, {"verse": 62, "start": 408793, "end": 412192, "text": "Y hablaron por señas a su padre, cómo le quería llamar.", "words": [[0, 408793], [2, 408902], [11, 409322], [15, 409482], [21, 410002], [23, 410102], [26, 410222], [33, 410602], [38, 411007], [41, 411337], [48, 411667]]}, {"verse": 63, "start": 412542, "end": 419733, "text": "Y pidiendo la tablilla, escribió, diciendo: Juan es su nombre. Y todos se maravillaron.", "words": [[0, 412542], [2, 412847], [11, 413327], [14, 413687], [24, 414047], [34, 415167], [44, 416293], [49, 416579], [52, 416999], [55, 417159], [63, 417883], [65, 418005], [71, 418305], [74, 418745]]}, {"verse": 64, "start": 420083, "end": 425201, "text": "Y luego fue abierta su boca y su lengua, y habló bendiciendo a Dios.", "words": [[0, 420083], [2, 420224], [8, 420424], [12, 420784], [20, 421344], [23, 421524], [28, 421884], [30, 422024], [33, 422204], [41, 423184], [43, 423464], [49, 423784], [61, 424464], [63, 424624]]}, {"verse": 65, "start": 425551, "end": 433382, "text": "Y fue un temor sobre todos los vecinos de ellos; y en todas las montañas de Judea fueron divulgadas todas estas cosas.", "words": [[0, 425551], [2, 425711], [6, 425871], [9, 426031], [15, 426371], [21, 426631], [27, 426991], [31, 427271], [39, 427711], [42, 427871], [49, 428662], [51, 428808], [54, 428968], [60, 429228], [64, 429528], [73, 430208], [76, 430308], [82, 430848], [89, 431068], [100, 431888], [106, 432208], [112, 432608]]}, {"verse": 66, "start": 433732, "end": 442993, "text": "Y todos los que las oían, las conservaban en su corazón, diciendo: ¿Quién será este niño? Y la mano del Señor estaba con él.", "words": [[0, 433732], [2, 434011], [8, 434271], [12, 434471], [16, 434671], [20, 434851], [26, 435571], [30, 435971], [42, 436831], [45, 437011], [48, 437191], [57, 437731], [67, 439305], [74, 439563], [79, 439723], [84, 440003], [90, 440765], [92, 440883], [95, 441003], [100, 441243], [104, 441463], [110, 441783], [117, 442223], [121, 442563]]}, {"verse": 67, "start": 443343, "end": 449051, "text": "Y Zacarías su padre fue lleno de Espíritu Santo, y profetizó, diciendo:", "words": [[0, 443343], [2, 443695], [11, 444075], [14, 444315], [20, 444835], [24, 444975], [30, 445355], [33, 445455], [42, 446055], [49, 447095], [51, 447175], [62, 448015]]}, {"verse": 68, "start": 449251, "end": 453634, "text": "Bendito el Señor Dios de Israel, que ha visitado y hecho redención a su pueblo,", "words": [[0, 449251], [8, 449696], [11, 449856], [17, 450116], [22, 450456], [25, 450676], [33, 450996], [37, 451256], [40, 451356], [49, 451996], [51, 452156], [57, 452376], [67, 452856], [69, 452996], [72, 453096]]}, {"verse": 69, "start": 453984, "end": 458238, "text": "Y nos levantó un cuerno de salvación en la casa de David su siervo,", "words": [[0, 453984], [2, 454069], [6, 454149], [14, 454649], [17, 454749], [24, 455169], [27, 455249], [37, 455849], [40, 456009], [43, 456109], [48, 456369], [51, 456529], [57, 456949], [60, 457029]]}, {"verse": 70, "start": 458588, "end": 462437, "text": "Como habló por boca de sus santos profetas que fueron desde el principio:", "words": [[0, 458588], [5, 458798], [11, 459048], [15, 459228], [20, 459528], [23, 459688], [27, 459828], [34, 460288], [43, 460788], [47, 460988], [54, 461248], [60, 461528], [63, 461728]]}, {"verse": 71, "start": 462787, "end": 466852, "text": "Salvación de nuestros enemigos, y de mano de todos los que nos aborrecieron;", "words": [[0, 462787], [10, 463354], [13, 463514], [22, 463734], [32, 464494], [34, 464734], [37, 464854], [42, 465054], [45, 465234], [51, 465454], [55, 465714], [59, 465874], [63, 466014]]}, {"verse": 72, "start": 467202, "end": 471734, "text": "Para hacer misericordia con nuestros padres, y acordándose de su santo pacto;", "words": [[0, 467202], [5, 467382], [11, 467642], [24, 468522], [28, 468722], [37, 468922], [45, 469502], [47, 469817], [59, 470557], [62, 470677], [65, 470837], [71, 471137]]}, {"verse": 73, "start": 472084, "end": 476157, "text": "Del juramento que juró a Abraham nuestro padre, que nos había de dar,", "words": [[0, 472084], [4, 472227], [14, 472747], [18, 473057], [23, 473367], [25, 473487], [33, 473987], [41, 474207], [48, 474887], [52, 475067], [56, 475207], [62, 475527], [65, 475707]]}, {"verse": 74, "start": 476507, "end": 479861, "text": "Que sin temor librados de nuestros enemigos, le serviríamos", "words": [[0, 476507], [4, 476591], [8, 476771], [14, 477131], [23, 477571], [26, 477711], [35, 477891], [45, 478811], [48, 479051]]}, {"verse": 75, "start": 480211, "end": 484333, "text": "En santidad y en justicia delante de él, todos los días nuestros.", "words": [[0, 480211], [3, 480333], [12, 480933], [14, 481073], [17, 481173], [26, 481733], [34, 482133], [37, 482313], [41, 482533], [47, 482973], [51, 483273], [56, 483513]]}, {"verse": 76, "start": 484683, "end": 491150, "text": "Y tú, niño, profeta del Altísimo serás llamado; porque irás ante la faz del Señor, para preparar sus caminos;", "words": [[0, 484683], [2, 484808], [6, 484948], [12, 485568], [20, 486048], [24, 486208], [33, 486808], [39, 487048], [48, 487818], [55, 487976], [60, 488226], [65, 488476], [68, 488636], [72, 488856], [76, 489016], [83, 489396], [88, 489876], [97, 490336], [101, 490436]]}, {"verse": 77, "start": 491500, "end": 495636, "text": "Dando conocimiento de salvación a su pueblo, para perdón de sus pecados,", "words": [[0, 491627], [6, 491757], [19, 492477], [22, 492617], [32, 493157], [34, 493277], [37, 493377], [45, 493797], [50, 494137], [57, 494597], [60, 494717], [64, 494917]]}, {"verse": 78, "start": 495986, "end": 501217, "text": "Por la profunda misericordia de nuestro Dios, el Sol naciente nos visitó desde lo alto,", "words": [[0, 495986], [4, 496093], [7, 496233], [16, 496713], [29, 497473], [32, 497573], [40, 497733], [46, 498693], [49, 498753], [53, 498993], [62, 499533], [66, 499753], [73, 500333], [79, 500473], [82, 500733]]}, {"verse": 79, "start": 501567, "end": 507601, "text": "Para dar luz a los que habitan en tinieblas y en sombra de muerte; para encaminar nuestros pies por camino de paz.", "words": [[0, 501567], [5, 501727], [9, 501867], [13, 502067], [15, 502207], [19, 502327], [23, 502467], [31, 502847], [34, 502987], [44, 503587], [46, 503787], [49, 503927], [56, 504267], [59, 504347], [67, 505113], [72, 505271], [82, 505791], [91, 506011], [96, 506391], [100, 506711], [107, 506971], [110, 507171]]}, {"verse": 80, "start": 507881, "end": 515433, "text": "Y el niño crecía, y se fortalecía en espíritu: y estuvo en los desiertos hasta el día que se mostró a Israel.", "words": [[0, 507881], [2, 508040], [5, 508200], [10, 508520], [18, 509260], [20, 509515], [23, 509675], [34, 510495], [37, 510635], [47, 511553], [49, 511814], [56, 512154], [59, 512294], [63, 512394], [73, 513074], [79, 513314], [82, 513474], [86, 513694], [90, 513854], [93, 513994], [100, 514494], [102, 514614]]}]}