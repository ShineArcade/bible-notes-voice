{"book": "ACT", "chapter": 20, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 312023, "verses": [{"verse": 1, "start": 300, "end": 10055, "text": "Y después que cesó el alboroto, llamando Pablo a los discípulos habiéndoles exhortado y abrazado, se despidió, y salió para ir a Macedonia.", "words": [[0, 300], [2, 404], [10, 704], [14, 904], [19, 1284], [22, 1384], [32, 2404], [41, 2924], [47, 3404], [49, 3604], [53, 3724], [64, 4564], [76, 5104], [86, 6124], [88, 6224], [98, 6964], [101, 7064], [111, 7664], [113, 8224], [119, 8644], [124, 8904], [127, 9164], [129, 9244]]}, {"verse": 2, "start": 10405, "end": 17203, "text": "Y andado que hubo aquellas partes, y habiéndolos animado con muchas palabras, vino a Grecia.", "words": [[0, 10405], [2, 10700], [9, 11030], [13, 11290], [18, 11650], [27, 12030], [35, 13075], [37, 13135], [49, 13815], [57, 14415], [61, 14655], [68, 15035], [78, 16095], [83, 16435], [85, 16836]]}, {"verse": 3, "start": 17553, "end": 29432, "text": "Y después de haber estado allí tres meses, y habiendo de navegar a Siria, le fueron puestas emboscadas por los judíos; y así decidió regresar por Macedonia.", "words": [[0, 17553], [2, 17657], [10, 17957], [13, 18137], [19, 18317], [26, 18697], [31, 18957], [36, 19297], [43, 19797], [45, 20342], [54, 20742], [57, 20922], [65, 21462], [67, 21802], [74, 22142], [77, 22682], [84, 22942], [92, 23462], [103, 24202], [107, 24422], [111, 24582], [119, 25577], [121, 25927], [125, 26187], [133, 27107], [142, 28187], [146, 28407]]}, {"verse": 4, "start": 29782, "end": 42385, "text": "Y le acompañaron hasta Asia Sopater Bereense, y los Tesalonicenses, Aristarco y Segundo; y Gayo de Derbe, y Timoteo; y de Asia, Tíquico y Trófimo.", "words": [[0, 29782], [2, 29926], [5, 30006], [17, 30926], [23, 31366], [28, 31846], [36, 32576], [46, 33306], [48, 33906], [52, 34066], [68, 35406], [78, 36626], [80, 36726], [89, 37703], [91, 37992], [96, 38312], [99, 38412], [106, 38832], [108, 39032], [117, 40032], [119, 40181], [122, 40281], [128, 40621], [136, 41366], [138, 41606]]}, {"verse": 5, "start": 42735, "end": 45710, "text": "Estos yendo delante, nos esperaron en Troas.", "words": [[0, 42735], [6, 43142], [12, 43522], [21, 44022], [25, 44202], [35, 44822], [38, 45002]]}, {"verse": 6, "start": 46060, "end": 56592, "text": "Y nosotros, pasados los días de los panes sin levadura, navegamos de Filipos y vinimos a ellos a Troas en cinco días, donde estuvimos siete días.", "words": [[0, 46060], [2, 46184], [12, 46464], [20, 47184], [24, 47404], [29, 47704], [32, 47864], [36, 47964], [42, 48424], [46, 48744], [56, 49704], [66, 50344], [69, 50524], [77, 51144], [79, 51524], [87, 51984], [89, 52204], [95, 52484], [97, 52804], [103, 53284], [106, 53464], [112, 53904], [118, 54684], [124, 54984], [134, 55564], [140, 55904]]}, {"verse": 7, "start": 56942, "end": 69494, "text": "Y el día primero de la semana, juntos los discípulos a partir el pan, Pablo les enseñaba, habiendo de partir al día siguiente: y alargó el discurso hasta la media noche.", "words": [[0, 56942], [2, 57087], [5, 57247], [9, 57447], [17, 57827], [20, 58047], [23, 58167], [31, 59187], [38, 59727], [42, 60027], [53, 60647], [55, 60827], [62, 61077], [65, 61327], [70, 61907], [76, 62447], [80, 62827], [90, 63867], [99, 64247], [102, 64427], [109, 64747], [112, 65107], [116, 65287], [127, 66352], [129, 66672], [136, 67272], [139, 67472], [148, 68192], [154, 68492], [157, 68832], [163, 69172]]}, {"verse": 8, "start": 69844, "end": 74060, "text": "Y había muchas lámparas en el aposento alto donde estaban juntos.", "words": [[0, 69844], [2, 69948], [8, 70108], [15, 70408], [24, 71228], [27, 71368], [30, 71508], [39, 72008], [44, 72468], [50, 72768], [58, 73168]]}, {"verse": 9, "start": 74410, "end": 88413, "text": "Y un joven llamado Eutico que estaba sentado en la ventana, tomado de un sueño profundo, mientras Pablo hablaba largamente, vencido por el sueño cayó del tercer piso abajo, y fue levantado muerto.", "words": [[0, 74410], [2, 74535], [5, 74655], [11, 75035], [19, 75575], [26, 76115], [30, 76315], [37, 76555], [45, 77215], [48, 77315], [51, 77455], [60, 78275], [67, 78775], [70, 78915], [73, 79015], [79, 79415], [89, 80335], [98, 80555], [104, 80995], [112, 81495], [124, 82595], [132, 83095], [136, 83335], [139, 83495], [145, 83915], [150, 84355], [154, 84535], [161, 84935], [166, 85575], [173, 86553], [175, 86793], [179, 86973], [189, 87653]]}, {"verse": 10, "start": 88763, "end": 96760, "text": "Entonces descendió Pablo, y se echó sobre él, y abrazándole, dijo: No os alborotéis, que su alma está en él.", "words": [[0, 88763], [9, 89280], [19, 90360], [26, 90780], [28, 91040], [31, 91160], [36, 91460], [42, 91760], [46, 92060], [48, 92620], [61, 93820], [67, 94586], [70, 94824], [73, 94984], [85, 95624], [89, 95744], [92, 95904], [97, 96124], [102, 96364], [105, 96544]]}, {"verse": 11, "start": 97040, "end": 103741, "text": "Después subiendo, y partiendo el pan, y comiendo, habló largamente hasta el alba, y así salió.", "words": [[0, 97040], [8, 97947], [18, 98447], [20, 98587], [30, 99127], [33, 99267], [38, 99527], [40, 99832], [50, 100832], [56, 101192], [67, 101852], [73, 102132], [76, 102332], [82, 102692], [84, 102872], [88, 103072]]}, {"verse": 12, "start": 104091, "end": 108586, "text": "Y llevaron al joven vivo, y fueron consolados no poco.", "words": [[0, 104091], [2, 104190], [11, 104490], [14, 104790], [20, 105290], [26, 105690], [28, 106270], [35, 106550], [46, 107550], [49, 107850]]}, {"verse": 13, "start": 108936, "end": 119139, "text": "Y nosotros subiendo en el navío, navegamos a Asón, para recibir de allí a Pablo; pues así había determinado que debía él ir por tierra.", "words": [[0, 108936], [2, 109063], [11, 110003], [20, 110483], [23, 110683], [26, 110843], [33, 111843], [43, 112343], [45, 112693], [51, 113043], [56, 113543], [64, 114003], [67, 114303], [72, 114583], [74, 114863], [81, 115607], [86, 115871], [90, 116191], [96, 116491], [108, 117311], [112, 117471], [118, 117851], [121, 118071], [124, 118271], [128, 118491]]}, {"verse": 14, "start": 119489, "end": 124739, "text": "Y como se juntó con nosotros en Asón, tomándole vinimos a Mitilene.", "words": [[0, 119489], [2, 119614], [7, 119854], [10, 120034], [16, 120474], [20, 120654], [29, 121094], [32, 121614], [38, 122134], [48, 122874], [56, 123734], [58, 123894]]}, {"verse": 15, "start": 125089, "end": 137030, "text": "Y navegando de allí, al día siguiente llegamos delante de Quío, y al otro día tomamos puerto en Samos: y habiendo reposado en Trogilio, al día siguiente llegamos a Mileto.", "words": [[0, 125089], [2, 125211], [12, 125771], [15, 125971], [21, 126631], [24, 126751], [28, 126891], [38, 127371], [47, 128001], [55, 128631], [58, 128731], [64, 129131], [66, 129511], [69, 129631], [74, 129831], [78, 130131], [86, 130611], [93, 130931], [96, 131151], [103, 132068], [105, 132195], [114, 132595], [123, 133315], [126, 134035], [136, 134755], [139, 134895], [143, 135115], [153, 135515], [162, 136235], [164, 136415]]}, {"verse": 16, "start": 137380, "end": 151230, "text": "Porque Pablo se había propuesto pasar adelante de Éfeso; por no detenerse en Asia: porque se apresuraba por pasar el día de Pentecostés, si le fuese posible, en Jerusalén.", "words": [[0, 137380], [7, 137804], [13, 138504], [16, 138924], [22, 139204], [32, 139944], [38, 140424], [47, 141164], [50, 141464], [57, 142303], [61, 142921], [64, 143141], [74, 143801], [77, 143941], [83, 144639], [90, 144863], [93, 145063], [104, 145823], [108, 146063], [114, 146523], [117, 146823], [121, 147063], [124, 147673], [137, 148283], [140, 148783], [143, 148923], [149, 149183], [158, 149763], [161, 150323]]}, {"verse": 17, "start": 151580, "end": 157069, "text": "Y enviando desde Mileto a Éfeso, hizo llamar a los ancianos de la iglesia.", "words": [[0, 151580], [2, 151735], [11, 152415], [17, 152715], [24, 153455], [26, 153675], [33, 154655], [38, 154895], [45, 155395], [47, 155475], [51, 155635], [60, 156195], [63, 156275], [66, 156395]]}, {"verse": 18, "start": 157419, "end": 165866, "text": "Y cuando vinieron a él, les dijo: Vosotros sabéis cómo, desde el primer día que entré en Asia, he estado con vosotros por todo el tiempo,", "words": [[0, 157419], [2, 157547], [9, 157767], [18, 158347], [20, 158547], [24, 158767], [28, 159027], [34, 159786], [43, 160221], [50, 160721], [56, 161101], [62, 161441], [65, 161661], [72, 161941], [76, 162241], [80, 162461], [86, 162761], [89, 162861], [95, 163181], [98, 163506], [105, 163826], [109, 164166], [118, 164646], [122, 164946], [127, 165146], [130, 165346]]}, {"verse": 19, "start": 166216, "end": 173182, "text": "Sirviendo al Señor con toda humildad, y con muchas lágrimas, y pruebas que me han sobrevenido por las tramas de los judíos:", "words": [[0, 166216], [10, 166651], [13, 166791], [19, 167051], [23, 167311], [28, 167531], [38, 168231], [40, 168551], [44, 168731], [51, 168991], [61, 169631], [63, 170091], [71, 170531], [75, 170691], [78, 170851], [82, 170951], [94, 171591], [98, 171771], [102, 171931], [109, 172311], [112, 172431], [116, 172551]]}, {"verse": 20, "start": 173532, "end": 179313, "text": "Cómo nada que fuese útil he rehuido de anunciaros y enseñaros, públicamente y por las casas,", "words": [[0, 173532], [5, 173726], [10, 174006], [14, 174226], [20, 174566], [25, 175126], [28, 175386], [36, 175646], [39, 175786], [50, 176446], [52, 176586], [63, 177426], [76, 178146], [78, 178366], [82, 178506], [86, 178686]]}, {"verse": 21, "start": 179663, "end": 186020, "text": "Testificando a los judíos y a los Gentiles arrepentimiento para con Dios, y la fe en nuestro Señor Jesucristo.", "words": [[0, 179663], [13, 180435], [15, 180535], [19, 180655], [26, 181215], [28, 181335], [30, 181375], [34, 181515], [43, 182035], [59, 182955], [64, 183175], [68, 183415], [74, 183655], [76, 183990], [79, 184130], [82, 184370], [85, 184490], [93, 184670], [99, 185070]]}, {"verse": 22, "start": 186370, "end": 192047, "text": "Y ahora, he aquí, ligado yo en espíritu, voy a Jerusalén, sin saber lo que allá me ha de acontecer:", "words": [[0, 186370], [2, 186483], [9, 186743], [12, 186903], [18, 187623], [25, 187963], [28, 188143], [31, 188283], [41, 189118], [45, 189278], [47, 189418], [58, 190158], [62, 190278], [68, 190578], [71, 190738], [75, 190878], [80, 191018], [83, 191198], [86, 191298], [89, 191358]]}, {"verse": 23, "start": 192397, "end": 198791, "text": "Pero que el Espíritu Santo por todas las ciudades me da testimonio, diciendo que prisiones y tribulaciones me esperan.", "words": [[0, 192397], [5, 192535], [9, 192675], [12, 192795], [21, 193235], [27, 193515], [31, 193815], [37, 194015], [41, 194315], [50, 194815], [53, 194975], [56, 195135], [68, 196155], [77, 196495], [81, 196795], [91, 197355], [93, 197435], [107, 198055], [110, 198255]]}, {"verse": 24, "start": 199141, "end": 211488, "text": "Pero de ninguna cosa hago caso, ni estimo mi vida preciosa para mí mismo; solamente que acabe mi carrera con gozo, y el ministerio que recibí del Señor Jesús, para dar testimonio del evangelio de la gracia de Dios.", "words": [[0, 199141], [5, 199280], [8, 199400], [16, 199640], [21, 200080], [26, 200320], [32, 200720], [35, 201180], [42, 201560], [45, 201700], [50, 201920], [59, 202520], [64, 202720], [67, 202880], [74, 203547], [84, 203883], [88, 204203], [94, 204543], [97, 204703], [105, 205103], [109, 205303], [115, 206003], [117, 206163], [120, 206283], [131, 206943], [135, 207063], [142, 207563], [146, 207643], [152, 207923], [159, 208423], [164, 208728], [168, 208948], [179, 209628], [183, 209788], [193, 210368], [196, 210468], [199, 210588], [206, 211028], [209, 211148]]}, {"verse": 25, "start": 211838, "end": 219729, "text": "Y ahora, he aquí, yo sé que ninguno de todos vosotros, por quien he pasado predicando el reino de Dios, verá más mi rostro.", "words": [[0, 211838], [2, 211962], [9, 212242], [12, 212482], [18, 213362], [21, 213522], [24, 213702], [28, 213842], [36, 214322], [39, 214442], [45, 214662], [55, 215562], [59, 215882], [65, 216062], [68, 216182], [75, 216502], [86, 217222], [89, 217362], [95, 217642], [98, 217802], [104, 218502], [109, 218762], [113, 218942], [116, 219122]]}, {"verse": 26, "start": 220079, "end": 225127, "text": "Por tanto, yo os declaro solemnemente el día de hoy, que yo soy limpio de la sangre de todos:", "words": [[0, 220079], [4, 220185], [11, 220665], [14, 220845], [17, 220965], [25, 221425], [38, 222225], [41, 222365], [45, 222545], [48, 222705], [53, 222925], [57, 223080], [60, 223240], [64, 223420], [71, 223840], [74, 223940], [77, 224040], [84, 224360], [87, 224520]]}, {"verse": 27, "start": 225477, "end": 228787, "text": "Porque no he rehuido de anunciaros todo el consejo de Dios.", "words": [[0, 225477], [7, 225661], [10, 225881], [13, 226021], [21, 226541], [24, 226661], [35, 227261], [40, 227461], [43, 227641], [51, 228121], [54, 228261]]}, {"verse": 28, "start": 229137, "end": 239327, "text": "Por tanto mirad por vosotros, y por todo el rebaño en que el Espíritu Santo os ha puesto por obispos, para apacentar la iglesia del Señor, la cual ganó por su sangre.", "words": [[0, 229137], [4, 229284], [10, 229784], [16, 230124], [20, 230304], [30, 230904], [32, 231464], [36, 231644], [41, 231844], [44, 232064], [51, 232484], [54, 232624], [58, 232764], [61, 232924], [70, 233404], [76, 233704], [79, 233984], [82, 234084], [89, 234324], [93, 234604], [102, 235284], [107, 235664], [117, 236304], [120, 236484], [128, 236844], [132, 237044], [139, 237819], [142, 237940], [147, 238140], [152, 238520], [156, 238680], [159, 238820]]}, {"verse": 29, "start": 239677, "end": 245867, "text": "Porque yo sé que después de mi partida entrarán en medio de vosotros lobos rapaces, que no perdonarán al rebaño;", "words": [[0, 239677], [7, 239857], [10, 240077], [13, 240297], [17, 240437], [25, 240797], [28, 240997], [31, 241097], [39, 241637], [48, 242177], [51, 242297], [57, 242517], [60, 242717], [69, 243177], [75, 243577], [84, 244137], [88, 244312], [91, 244512], [102, 245172], [105, 245272]]}, {"verse": 30, "start": 246217, "end": 251761, "text": "Y de vosotros mismos se levantarán hombres que hablen cosas perversas, para llevar discípulos tras sí.", "words": [[0, 246217], [2, 246302], [5, 246402], [14, 246802], [21, 247162], [24, 247402], [35, 247942], [43, 248182], [47, 248402], [54, 248662], [60, 248902], [71, 249682], [76, 250222], [83, 250482], [94, 251182], [99, 251402]]}, {"verse": 31, "start": 252111, "end": 259673, "text": "Por tanto, velad, acordándoos que por tres años de noche y de día, no he cesado de amonestar con lágrimas a cada uno.", "words": [[0, 252111], [4, 252298], [11, 252798], [18, 253298], [30, 254138], [34, 254258], [38, 254458], [43, 254738], [48, 255018], [51, 255218], [57, 255498], [59, 255658], [62, 255778], [67, 256518], [70, 256698], [73, 256858], [80, 257278], [83, 257398], [93, 257878], [97, 258098], [106, 258638], [108, 258798], [113, 258978]]}, {"verse": 32, "start": 260023, "end": 269014, "text": "Y ahora, hermanos, os encomiendo a Dios, y a la palabra de su gracia: el cual es poderoso para edificaros y daros herencia con todos los santificados.", "words": [[0, 260023], [2, 260163], [9, 260343], [19, 261303], [22, 261403], [33, 262043], [35, 262203], [41, 262403], [43, 262803], [45, 262863], [48, 262943], [56, 263303], [59, 263483], [62, 263623], [70, 264384], [73, 264528], [78, 264708], [81, 264908], [90, 265468], [95, 265948], [106, 266428], [108, 266741], [114, 267055], [123, 267368], [127, 267628], [133, 267848], [137, 268028]]}, {"verse": 33, "start": 269364, "end": 273056, "text": "La plata, o el oro, o el vestido de nadie he codiciado.", "words": [[0, 269364], [3, 269489], [10, 269849], [12, 270029], [15, 270149], [20, 270749], [22, 270989], [25, 271069], [33, 271489], [36, 271629], [42, 272122], [45, 272616]]}, {"verse": 34, "start": 273406, "end": 280071, "text": "Antes vosotros sabéis que para lo que me ha sido necesario, y a los que están conmigo, estas manos me han servido.", "words": [[0, 273406], [6, 273728], [15, 274268], [22, 274768], [26, 274948], [31, 275168], [34, 275328], [38, 275448], [41, 275588], [44, 275688], [49, 275888], [60, 276608], [62, 277108], [64, 277188], [68, 277308], [72, 277428], [78, 277708], [87, 278628], [93, 278748], [99, 279128], [102, 279368], [106, 279488]]}, {"verse": 35, "start": 280421, "end": 291806, "text": "En todo os he enseñado que, trabajando así, es necesario ayudar a los débiles, y tener presentes las palabras del Señor Jesús, el cual dijo: Más bienaventurada cosa es dar que recibir.", "words": [[0, 280421], [3, 280540], [8, 280760], [11, 281060], [14, 281160], [23, 281720], [28, 282200], [39, 282540], [44, 283300], [47, 283420], [57, 284020], [64, 284420], [66, 284560], [70, 284720], [79, 285180], [81, 285640], [87, 285880], [97, 286420], [101, 286560], [110, 286940], [114, 287180], [120, 287420], [127, 288200], [130, 288360], [135, 288540], [141, 289320], [145, 289763], [160, 290243], [165, 290543], [168, 290803], [172, 290983], [176, 291163]]}, {"verse": 36, "start": 292086, "end": 297047, "text": "Y cuando hubo dicho estas cosas, se puso de rodillas, y oró con todos ellos.", "words": [[0, 292086], [2, 292192], [9, 292412], [14, 292872], [20, 293092], [26, 293292], [33, 293772], [36, 294272], [41, 294592], [44, 294752], [54, 295372], [56, 295667], [60, 295967], [64, 296167], [70, 296467]]}, {"verse": 37, "start": 297397, "end": 303761, "text": "Entonces hubo un gran llanto de todos: y echándose en el cuello de Pablo, le besaban,", "words": [[0, 297397], [9, 297824], [14, 298584], [17, 298804], [22, 299064], [29, 299584], [32, 299744], [39, 300484], [41, 300604], [51, 301204], [54, 301404], [57, 301544], [64, 301884], [67, 302024], [74, 302464], [77, 302964]]}, {"verse": 38, "start": 304111, "end": 311623, "text": "Doliéndose en gran manera por la palabra que dijo, que no habían de ver más su rostro. Y le acompañaron al barco.", "words": [[0, 304111], [11, 304914], [14, 305314], [19, 305514], [26, 306014], [30, 306234], [33, 306394], [41, 306694], [45, 306894], [51, 307174], [55, 307634], [58, 307814], [65, 308054], [68, 308294], [72, 308474], [76, 308654], [79, 309014], [87, 309941], [89, 310057], [92, 310137], [104, 310837], [107, 311017]]}]}