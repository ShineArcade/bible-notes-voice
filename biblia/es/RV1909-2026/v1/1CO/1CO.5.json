{"book": "1CO", "chapter": 5, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 105074, "verses": [{"verse": 1, "start": 300, "end": 11125, "text": "De cierto se oye que hay entre vosotros inmoralidad sexual, y tal inmoralidad sexual cual ni aun se nombra entre los Gentiles; tanto que alguno tenga la mujer de su padre.", "words": [[0, 300], [3, 474], [10, 734], [13, 1054], [17, 1334], [21, 1514], [25, 1774], [31, 2134], [40, 2754], [52, 3674], [60, 4154], [62, 4459], [66, 4639], [78, 5439], [85, 5959], [90, 6479], [93, 6739], [97, 6939], [100, 7159], [107, 7539], [113, 7719], [117, 7899], [127, 8885], [133, 9065], [137, 9245], [144, 9665], [150, 9865], [153, 10025], [159, 10305], [162, 10485], [165, 10605]]}, {"verse": 2, "start": 11475, "end": 19222, "text": "Y vosotros estáis engreídos, y no más bien tuvisteis duelo, para que fuese quitado de en medio de vosotros el que hizo tal obra.", "words": [[0, 11475], [2, 11578], [11, 12038], [18, 12558], [29, 13498], [31, 13758], [34, 13898], [38, 14078], [43, 14278], [53, 14858], [60, 15238], [65, 15818], [69, 15978], [75, 16258], [83, 16758], [86, 16918], [89, 17078], [95, 17318], [98, 17478], [107, 17978], [110, 18238], [114, 18378], [119, 18578], [123, 18798]]}, {"verse": 3, "start": 19572, "end": 27061, "text": "Y ciertamente, como ausente con el cuerpo, pero presente en espíritu, ya como presente he juzgado al que esto así ha cometido:", "words": [[0, 19572], [2, 19737], [15, 20337], [20, 20637], [28, 21097], [32, 21297], [35, 21397], [43, 22077], [48, 22237], [57, 22617], [60, 22837], [70, 23797], [73, 24017], [78, 24237], [87, 24637], [90, 24897], [98, 25297], [101, 25537], [105, 25677], [110, 25917], [114, 26237], [117, 26357]]}, {"verse": 4, "start": 27411, "end": 34620, "text": "En el nombre del Señor nuestro Jesucristo, reunidos vosotros y mi espíritu, con el poder de nuestro Señor Jesucristo,", "words": [[0, 27411], [3, 27569], [6, 27649], [13, 27969], [17, 28209], [23, 28509], [31, 29009], [43, 30129], [52, 30649], [61, 31169], [63, 31369], [66, 31469], [76, 32389], [80, 32569], [83, 32689], [89, 32929], [92, 33169], [100, 33509], [106, 33749]]}, {"verse": 5, "start": 34970, "end": 41472, "text": "El tal sea entregado a Satanás para muerte de la carne, porque el espíritu sea salvo en el día del Señor Jesús.", "words": [[0, 34970], [3, 35130], [7, 35290], [11, 35530], [21, 36130], [23, 36210], [31, 36750], [36, 36950], [43, 37290], [46, 37470], [49, 37590], [56, 38210], [63, 38570], [66, 38750], [75, 39290], [79, 39470], [85, 39930], [88, 40050], [91, 40150], [95, 40370], [99, 40550], [105, 40790]]}, {"verse": 6, "start": 41822, "end": 46868, "text": "No es buena vuestra jactancia. ¿No sabéis que un poco de levadura fermenta toda la masa?", "words": [[0, 41822], [3, 41962], [6, 42102], [12, 42322], [20, 42912], [31, 43667], [35, 43852], [42, 44292], [46, 44472], [49, 44612], [54, 44832], [57, 45012], [66, 45452], [75, 46012], [80, 46132], [83, 46312]]}, {"verse": 7, "start": 47218, "end": 55720, "text": "Limpiad pues la vieja levadura, para que seáis nueva masa, como sois sin levadura: porque nuestra pascua, que es Cristo, fue sacrificada por nosotros.", "words": [[0, 47218], [8, 47716], [13, 47856], [16, 48056], [22, 48356], [32, 48776], [37, 49016], [41, 49156], [47, 49476], [53, 49676], [59, 50156], [64, 50474], [69, 50791], [73, 51031], [83, 51897], [90, 52124], [98, 52324], [106, 52984], [110, 53144], [113, 53264], [121, 53644], [125, 54104], [137, 54804], [141, 55004]]}, {"verse": 8, "start": 56070, "end": 65034, "text": "Así que hagamos fiesta, no en la vieja levadura, ni en la levadura de malicia y de maldad, sino en panes sin levadura de sinceridad y de verdad.", "words": [[0, 56070], [4, 56274], [8, 56454], [16, 56754], [24, 57614], [27, 57754], [30, 57894], [33, 57994], [39, 58314], [49, 59234], [52, 59394], [55, 59534], [58, 59614], [67, 60014], [70, 60154], [78, 60614], [80, 60734], [83, 60834], [91, 61574], [96, 61874], [99, 62094], [105, 62514], [109, 62754], [118, 63254], [121, 63394], [132, 64174], [134, 64414], [137, 64514]]}, {"verse": 9, "start": 65384, "end": 70699, "text": "Os he escrito por carta, que no os asociéis con quienes practican inmoralidad sexual:", "words": [[0, 65384], [3, 65530], [6, 65750], [14, 66090], [18, 66330], [25, 67230], [29, 67430], [32, 67610], [35, 67770], [44, 68310], [48, 68510], [56, 68690], [66, 69410], [78, 70070]]}, {"verse": 10, "start": 71049, "end": 81278, "text": "No absolutamente con quienes practican inmoralidad sexual en este mundo, o con los avaros, o con los ladrones, o con los idólatras; pues en tal caso tendríais que salir del mundo.", "words": [[0, 71049], [3, 71215], [17, 71815], [21, 72255], [29, 72435], [39, 73175], [51, 73875], [58, 74295], [61, 74575], [66, 74795], [73, 75455], [75, 75675], [79, 75815], [83, 75955], [91, 76635], [93, 76655], [97, 76835], [101, 76955], [111, 77675], [113, 77735], [117, 77875], [121, 77995], [132, 78939], [137, 79042], [140, 79242], [144, 79362], [149, 79682], [159, 80222], [163, 80342], [169, 80562], [173, 80762]]}, {"verse": 11, "start": 81628, "end": 93970, "text": "Pero ahora os he escrito, que no os asociéis, es decir, que si alguno que se llama hermano es sexualmente inmoral, o avaro, o idólatra, o maldiciente, o borracho, o ladrón, con el tal ni aun comáis.", "words": [[0, 81628], [5, 81766], [11, 82046], [14, 82266], [17, 82386], [26, 82826], [30, 83246], [33, 83446], [36, 83606], [46, 84446], [49, 84506], [56, 85366], [60, 85426], [63, 85546], [70, 85986], [74, 86046], [77, 86186], [83, 86446], [91, 86946], [94, 87046], [106, 87726], [115, 88426], [117, 88506], [124, 89066], [126, 89106], [136, 89846], [138, 89866], [151, 90566], [153, 90806], [163, 91698], [165, 91821], [173, 92201], [177, 92381], [180, 92521], [184, 92761], [187, 93001], [191, 93221]]}, {"verse": 12, "start": 94320, "end": 99335, "text": "Porque ¿qué me va a mí en juzgar a los que están fuera? ¿No juzgáis vosotros a los que están dentro?", "words": [[0, 94431], [7, 94581], [12, 94741], [15, 94861], [18, 95041], [20, 95081], [23, 95221], [26, 95401], [33, 95861], [35, 95981], [39, 96101], [43, 96221], [49, 96401], [56, 97127], [60, 97246], [68, 97686], [77, 98206], [79, 98366], [83, 98466], [87, 98586], [93, 98786]]}, {"verse": 13, "start": 99685, "end": 104674, "text": "Porque a los que están fuera, Dios juzgará: quitad pues a ese malo de entre vosotros.", "words": [[0, 99685], [7, 99920], [9, 100040], [13, 100160], [17, 100300], [23, 100500], [30, 101280], [35, 101460], [44, 102331], [51, 102674], [56, 102914], [58, 103234], [62, 103374], [67, 103774], [70, 103874], [76, 104054]]}]}