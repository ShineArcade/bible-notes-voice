{"book": "PSA", "chapter": 95, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 66580, "verses": [{"verse": 1, "start": 300, "end": 6689, "text": "Venid, celebremos alegremente a Jehová: cantemos con júbilo a la roca de nuestra salvación.", "words": [[0, 300], [7, 845], [18, 1465], [30, 2265], [32, 2465], [40, 3199], [49, 3705], [53, 3945], [60, 4565], [62, 4805], [65, 4925], [70, 5345], [73, 5485], [81, 5645]]}, {"verse": 2, "start": 7039, "end": 11986, "text": "Lleguemos ante su presencia con alabanza; aclamémosle con cánticos.", "words": [[0, 7039], [10, 7559], [15, 7839], [18, 8079], [28, 8739], [32, 8979], [42, 10142], [54, 10966], [58, 11166]]}, {"verse": 3, "start": 12336, "end": 17130, "text": "Porque Jehová es Dios grande; y Rey grande sobre todos los dioses.", "words": [[0, 12336], [7, 12542], [14, 13102], [17, 13302], [22, 13502], [30, 14371], [32, 14535], [36, 14895], [43, 15255], [49, 15675], [55, 16075], [59, 16395]]}, {"verse": 4, "start": 17480, "end": 23881, "text": "Porque en su mano están las profundidades de la tierra, y las alturas de los montes son suyas.", "words": [[0, 17480], [7, 17706], [10, 17866], [13, 18046], [18, 18346], [24, 18666], [28, 18866], [42, 19806], [45, 19986], [48, 20086], [56, 20546], [58, 21026], [62, 21226], [70, 21786], [73, 21926], [77, 22066], [84, 22626], [88, 23106]]}, {"verse": 5, "start": 24231, "end": 29599, "text": "Suya también el mar, pues él la hizo; y sus manos formaron la tierra seca.", "words": [[0, 24231], [5, 24606], [13, 24946], [16, 25166], [21, 25766], [26, 25946], [29, 26166], [32, 26366], [38, 27032], [40, 27139], [44, 27279], [50, 27699], [59, 28359], [62, 28539], [69, 28779]]}, {"verse": 6, "start": 29949, "end": 36219, "text": "Venid, adoremos y postrémonos; arrodillémonos delante de Jehová nuestro hacedor.", "words": [[0, 29949], [7, 30854], [16, 31374], [18, 31594], [31, 33422], [46, 34002], [54, 34462], [57, 34862], [64, 35262], [72, 35442]]}, {"verse": 7, "start": 36569, "end": 44134, "text": "Porque él es nuestro Dios; nosotros el pueblo de su prado, y ovejas de su mano. Si hoy oís su voz,", "words": [[0, 36569], [7, 36816], [10, 37156], [13, 37316], [21, 37676], [27, 38547], [36, 39494], [39, 39574], [46, 39954], [49, 40174], [52, 40334], [59, 40794], [61, 41174], [68, 41594], [71, 41794], [74, 41954], [80, 42945], [83, 43197], [87, 43449], [91, 43702], [94, 43954]]}, {"verse": 8, "start": 44334, "end": 49775, "text": "No endurezcáis vuestro corazón como en Meriba, como el día de Masa en el desierto;", "words": [[0, 44334], [3, 44520], [15, 45340], [23, 45740], [31, 46180], [36, 46480], [39, 47020], [47, 47560], [52, 47680], [55, 47840], [59, 48040], [62, 48180], [67, 48500], [70, 48680], [73, 48780]]}, {"verse": 9, "start": 50125, "end": 54110, "text": "Donde me tentaron vuestros padres, me probaron, y vieron mi obra.", "words": [[0, 50125], [6, 50304], [9, 50484], [18, 50944], [27, 51284], [35, 51684], [38, 52044], [48, 52544], [50, 52984], [57, 53244], [60, 53424]]}, {"verse": 10, "start": 54460, "end": 62321, "text": "Cuarenta años estuve disgustado con la nación, y dije: Pueblo es que divaga de corazón, y no han conocido mis caminos.", "words": [[0, 54460], [9, 54977], [14, 55197], [21, 55637], [32, 56317], [36, 56477], [39, 56617], [47, 57077], [49, 57437], [55, 58424], [62, 58710], [65, 58870], [69, 59010], [76, 59390], [79, 59530], [88, 60010], [90, 60450], [93, 60590], [97, 60710], [106, 61210], [110, 61370]]}, {"verse": 11, "start": 62671, "end": 66180, "text": "Por tanto juré en mi furor que no entrarían en mi reposo.", "words": [[0, 62671], [4, 62773], [10, 63193], [15, 63553], [18, 63653], [21, 63773], [27, 64173], [31, 64333], [34, 64473], [44, 65013], [47, 65113], [50, 65253]]}]}