{"book": "REV", "chapter": 22, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 195194, "verses": [{"verse": 1, "start": 300, "end": 9048, "text": "Después me mostró un río limpio de agua de vida, resplandeciente como cristal, que salía del trono de Dios y del Cordero.", "words": [[0, 300], [8, 605], [11, 905], [18, 1325], [21, 1445], [25, 1685], [32, 2185], [35, 2305], [40, 2525], [43, 2725], [49, 3525], [65, 4385], [70, 4585], [79, 5485], [83, 5545], [89, 5925], [93, 6105], [99, 6445], [102, 6585], [107, 6865], [109, 7145], [113, 7265]]}, {"verse": 2, "start": 9498, "end": 22532, "text": "En el medio de la plaza de ella, y de la una y del otro lado del río, estaba el árbol de la vida, que produce doce frutos, dando cada mes su fruto: y las hojas del árbol eran para la sanidad de las naciones.", "words": [[0, 9498], [3, 9638], [6, 9758], [12, 10038], [15, 10198], [18, 10318], [24, 10698], [27, 10878], [33, 11198], [35, 11558], [38, 11658], [41, 11798], [45, 12058], [47, 12258], [51, 12418], [56, 12618], [61, 12878], [65, 13138], [70, 13758], [77, 14138], [80, 14378], [86, 14678], [89, 14838], [92, 14938], [98, 15198], [102, 15618], [110, 16118], [115, 16518], [123, 17498], [129, 17776], [134, 18056], [138, 18316], [141, 18536], [148, 19344], [150, 19468], [154, 19608], [160, 19988], [164, 20148], [170, 20448], [175, 20668], [180, 20928], [183, 21068], [191, 21548], [194, 21688], [198, 21808]]}, {"verse": 3, "start": 22982, "end": 29513, "text": "Y no habrá más maldición; sino que el trono de Dios y del Cordero estará en ella, y sus siervos le servirán.", "words": [[0, 22982], [2, 23089], [5, 23229], [11, 23609], [15, 23769], [26, 24900], [31, 25088], [35, 25288], [38, 25408], [44, 25748], [47, 25888], [52, 26148], [54, 26348], [58, 26468], [66, 26908], [73, 27268], [76, 27388], [82, 27628], [84, 28048], [88, 28188], [96, 28648], [99, 28848]]}, {"verse": 4, "start": 29963, "end": 32973, "text": "Y verán su cara; y su nombre estará en sus frentes.", "words": [[0, 29963], [2, 30064], [8, 30364], [11, 30504], [17, 31271], [19, 31370], [22, 31490], [29, 31790], [36, 32170], [39, 32170], [43, 32270]]}, {"verse": 5, "start": 33423, "end": 42654, "text": "Y allí no habrá más noche; y no tienen necesidad de luz de antorcha, ni de luz de sol: porque el Señor Dios los alumbrará: y reinarán para siempre.", "words": [[0, 33423], [2, 33550], [7, 33710], [10, 33930], [16, 34230], [20, 34350], [27, 35198], [29, 35283], [32, 35423], [39, 35683], [49, 36383], [52, 36503], [56, 36683], [59, 36863], [69, 37443], [72, 37903], [75, 38043], [79, 38203], [82, 38383], [87, 39107], [94, 39287], [97, 39407], [103, 39647], [108, 39967], [112, 40227], [123, 41294], [125, 41396], [134, 41856], [139, 42016]]}, {"verse": 6, "start": 43104, "end": 54608, "text": "Y me dijo: Estas palabras son fieles y verdaderas. Y el Señor Dios de los santos profetas ha enviado su ángel, para mostrar a sus siervos las cosas que es necesario que sean hechas pronto.", "words": [[0, 43104], [2, 43246], [5, 43326], [11, 44039], [17, 44338], [26, 44618], [30, 44918], [37, 45398], [39, 45458], [51, 46553], [53, 46693], [56, 46813], [62, 47093], [67, 47453], [70, 47613], [74, 47713], [81, 48153], [90, 48633], [93, 48953], [101, 49433], [104, 49633], [111, 50113], [116, 50633], [124, 50993], [126, 51153], [130, 51313], [138, 51713], [142, 51913], [148, 52233], [152, 52513], [155, 52653], [165, 53213], [169, 53453], [174, 53713], [181, 54013]]}, {"verse": 7, "start": 54958, "end": 61813, "text": "Y he aquí, vengo pronto. Bienaventurado el que guarda las palabras de la profecía de este libro.", "words": [[0, 54958], [2, 55242], [5, 55562], [11, 55662], [17, 56002], [25, 56889], [40, 58033], [43, 58773], [47, 58913], [54, 59333], [58, 59473], [67, 59813], [70, 60073], [73, 60173], [82, 60773], [85, 60913], [90, 61153]]}, {"verse": 8, "start": 62113, "end": 71222, "text": "Yo Juan soy el que ha oído y visto estas cosas. Y después que hube oído y visto, me postré para adorar delante de los pies del ángel que me mostraba estas cosas.", "words": [[0, 62113], [3, 62403], [8, 62823], [12, 62943], [15, 63123], [19, 63283], [22, 63403], [27, 63683], [29, 63803], [35, 64083], [41, 64263], [48, 65291], [50, 65398], [58, 65678], [62, 65918], [67, 66158], [72, 66398], [74, 66498], [81, 67258], [84, 67338], [91, 67698], [96, 67898], [103, 68178], [111, 68638], [114, 68758], [118, 68898], [123, 69118], [127, 69318], [133, 69658], [137, 69798], [140, 69918], [149, 70358], [155, 70498]]}, {"verse": 9, "start": 71672, "end": 81957, "text": "Y él me dijo: Mira que no lo hagas: porque yo soy siervo contigo, y con tus hermanos los profetas, y con los que guardan las palabras de este libro. Adora a Dios.", "words": [[0, 71672], [2, 71811], [5, 71951], [8, 72091], [14, 72905], [19, 73129], [23, 73329], [26, 73489], [29, 73629], [36, 74481], [43, 74662], [46, 74862], [50, 75042], [57, 75482], [66, 76102], [68, 76402], [72, 76582], [76, 76722], [85, 77242], [89, 77362], [99, 77922], [101, 78402], [105, 78562], [109, 78702], [113, 78842], [121, 79222], [125, 79342], [134, 79662], [137, 79962], [142, 80162], [149, 80992], [155, 81355], [157, 81475]]}, {"verse": 10, "start": 82407, "end": 88112, "text": "Y me dijo: No selles las palabras de la profecía de este libro; porque el tiempo está cerca.", "words": [[0, 82407], [2, 82492], [5, 82612], [11, 83326], [14, 83486], [21, 83986], [25, 84106], [34, 84526], [37, 84786], [40, 84866], [49, 85466], [52, 85606], [57, 85806], [64, 86605], [71, 86822], [74, 86982], [81, 87262], [86, 87522]]}, {"verse": 11, "start": 88562, "end": 101977, "text": "El que es injusto, sea injusto todavía: y el que es sucio, ensúciese todavía: y el que es justo, sea todavía justificado: y el santo sea santificado todavía.", "words": [[0, 88562], [3, 88685], [7, 88845], [10, 88985], [19, 89845], [23, 89985], [31, 90545], [40, 91457], [42, 91685], [45, 91785], [49, 91905], [52, 92065], [59, 92765], [69, 93325], [78, 94832], [80, 94954], [83, 95074], [87, 95214], [90, 95394], [97, 95774], [101, 96334], [109, 96754], [122, 98071], [124, 98177], [127, 98297], [133, 98597], [137, 98917], [149, 99657]]}, {"verse": 12, "start": 102327, "end": 109515, "text": "Y he aquí, yo vengo pronto, y mi recompensa conmigo, para recompensar a cada uno según sea su obra.", "words": [[0, 102327], [2, 102511], [5, 102611], [11, 102951], [14, 103051], [20, 103331], [28, 103751], [30, 104031], [33, 104311], [44, 105131], [53, 105731], [58, 106271], [70, 107431], [72, 107611], [77, 107811], [81, 108151], [87, 108471], [91, 108811], [94, 109071]]}, {"verse": 13, "start": 109965, "end": 114192, "text": "Yo soy Alfa y Omega, principio y fin, el primero y el último.", "words": [[0, 109965], [3, 110111], [7, 110291], [12, 110691], [14, 110851], [21, 111331], [31, 111651], [33, 112031], [38, 112731], [41, 112831], [49, 113151], [51, 113471], [54, 113591]]}, {"verse": 14, "start": 114642, "end": 123319, "text": "Bienaventurados los que guardan sus mandamientos, para que tengan derecho al árbol de la vida, y que entren por las puertas en la ciudad.", "words": [[0, 114642], [16, 115584], [20, 115744], [24, 115944], [32, 116384], [36, 116564], [50, 117304], [55, 118004], [59, 118164], [66, 118484], [74, 118964], [77, 119284], [83, 119624], [86, 119804], [89, 119904], [95, 120184], [97, 120744], [101, 120904], [108, 121364], [112, 121724], [116, 121904], [124, 122344], [127, 122564], [130, 122704]]}, {"verse": 15, "start": 123769, "end": 135690, "text": "Pero los perros estarán fuera, y los hechiceros, y los sexualmente inmorales, y los homicidas, y los idólatras, y cualquiera que ama y hace mentira.", "words": [[0, 123769], [5, 123975], [9, 124155], [16, 124735], [24, 125235], [31, 125675], [33, 126615], [37, 126815], [49, 127615], [51, 128315], [55, 128455], [67, 129275], [78, 129995], [80, 130295], [84, 130455], [95, 131235], [97, 131515], [101, 131655], [112, 132355], [114, 132715], [125, 133395], [129, 133635], [133, 134075], [135, 134555], [140, 134775]]}, {"verse": 16, "start": 136140, "end": 148809, "text": "Yo Jesús he enviado mi ángel para daros testimonio de estas cosas en las iglesias. Yo soy la raíz y el linaje de David, la estrella resplandeciente, y de la mañana.", "words": [[0, 136140], [3, 136445], [9, 137225], [12, 137325], [20, 137945], [23, 138105], [29, 138645], [34, 138985], [40, 139405], [51, 140125], [54, 140265], [60, 140505], [66, 140945], [69, 141225], [73, 141405], [83, 142526], [86, 142881], [90, 143141], [93, 143381], [98, 143981], [100, 144361], [103, 144541], [110, 145061], [113, 145201], [120, 146121], [123, 146221], [132, 146721], [149, 147781], [151, 147981], [154, 148081], [157, 148201]]}, {"verse": 17, "start": 149109, "end": 160002, "text": "Y el Espíritu y la Esposa dicen: Ven. Y el que oye, diga: Ven. Y el que tiene sed, venga: y el que quiere, tome del agua de la vida gratuitamente.", "words": [[0, 149109], [2, 149234], [5, 149314], [14, 149914], [16, 150034], [19, 150134], [26, 150554], [33, 151704], [38, 152195], [40, 152313], [43, 152413], [47, 152573], [52, 152833], [58, 153750], [63, 154243], [65, 154326], [68, 154386], [72, 154486], [78, 154746], [83, 155226], [90, 155950], [92, 156047], [95, 156127], [99, 156247], [107, 156687], [112, 156947], [116, 157127], [121, 157367], [124, 157527], [127, 157647], [132, 157847]]}, {"verse": 18, "start": 160452, "end": 171387, "text": "Porque yo declaro solemnemente a cualquiera que oye las palabras de la profecía de este libro: Si alguno añade a estas cosas, Dios pondrá sobre él las plagas que están escritas en este libro.", "words": [[0, 160452], [7, 160652], [10, 160832], [18, 161352], [31, 162152], [33, 162252], [44, 162712], [48, 162892], [52, 163092], [56, 163232], [65, 163672], [68, 163892], [71, 163992], [80, 164652], [83, 164792], [88, 165012], [95, 165837], [98, 165938], [105, 166338], [111, 166508], [113, 166678], [119, 166878], [126, 167838], [131, 167978], [138, 168498], [144, 168758], [147, 168958], [151, 169118], [158, 169558], [162, 169658], [168, 169918], [177, 170498], [180, 170618], [185, 170838]]}, {"verse": 19, "start": 171837, "end": 182179, "text": "Y si alguno quita de las palabras del libro de esta profecía, Dios quitará su parte del libro de la vida, y de la santa ciudad, y de las cosas que están escritas en este libro.", "words": [[0, 171837], [2, 171926], [5, 172026], [12, 172546], [18, 172886], [21, 172986], [25, 173126], [34, 173526], [38, 173846], [44, 174106], [47, 174286], [52, 174466], [62, 175626], [67, 175746], [75, 176206], [78, 176346], [84, 176646], [88, 176886], [94, 177146], [97, 177306], [100, 177426], [106, 177706], [108, 178186], [111, 178286], [114, 178406], [120, 178686], [128, 179610], [130, 179732], [133, 179812], [137, 179952], [143, 180332], [147, 180592], [153, 180812], [162, 181412], [165, 181532], [170, 181752]]}, {"verse": 20, "start": 182629, "end": 189887, "text": "El que da testimonio de estas cosas, dice: Ciertamente, vengo en breve. Amén, sea así. Ven, Señor Jesús.", "words": [[0, 182629], [3, 182750], [7, 182870], [10, 183010], [21, 183570], [24, 183690], [30, 183870], [37, 184630], [43, 185407], [56, 186113], [62, 186453], [65, 186633], [72, 187634], [78, 187834], [82, 188034], [87, 188785], [92, 188968], [98, 189228]]}, {"verse": 21, "start": 190337, "end": 194794, "text": "La gracia de nuestro Señor Jesucristo sea con todos vosotros. Amén.", "words": [[0, 190337], [3, 190437], [10, 190877], [13, 190977], [21, 191137], [27, 191577], [38, 192397], [42, 192817], [46, 193057], [52, 193297], [62, 194407]]}]}