rabajo: y perdona todos mis pecados.", "words": [[0, 107606], [5, 107766], [8, 107946], [18, 108566], [20, 108746], [23, 108866], [32, 109893], [34, 110001], [42, 110581], [48, 110821], [52, 111101]]}, {"verse": 19, "start": 112298, "end": 117229, "text": "Mira mis enemigos, que se han multiplicado, y con odio violento me aborrecen.", "words": [[0, 112298], [5, 112664], [9, 112764], [19, 113324], [23, 113484], [26, 113624], [30, 113744], [44, 114624], [46, 114984], [50, 115184], [55, 115684], [64, 116324], [67, 116777]]}, {"verse": 20, "start": 117579, "end": 122284, "text": "Guarda mi alma, y líbrame: no sea yo avergonzado, porque en ti confié.", "words": [[0, 117779], [7, 117979], [10, 118179], [16, 118499], [18, 118819], [27, 119733], [30, 119838], [34, 119998], [37, 120218], [50, 121058], [57, 121298], [60, 121458], [63, 121578]]}, {"verse": 21, "start": 122634, "end": 127158, "text": "Integridad y rectitud me guarden; porque en ti he esperado.", "words": [[0, 122634], [11, 123474], [13, 123714], [22, 124334], [25, 124574], [34, 125388], [41, 125633], [44, 125873], [47, 126053], [50, 126313]]}, {"verse": 22, "start": 127508, "end": 131496, "text": "Redime, oh Dios, a Israel de todas sus angustias.", "words": [[0, 127508], [8, 128035], [11, 128255], [17, 129115], [19, 129235], [26, 129715], [29, 129955], [35, 130215], [39, 130535]]}]}