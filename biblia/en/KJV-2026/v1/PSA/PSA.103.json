{"book": "PSA", "chapter": 103, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 121497, "verses": [{"verse": 1, "start": 300, "end": 5201, "text": "Bless the LORD, O my soul: and all that is within me, bless his holy name.", "words": [[0, 300], [6, 537], [10, 857], [16, 1197], [18, 1257], [21, 1437], [27, 2306], [31, 2415], [35, 2635], [40, 2835], [43, 2995], [50, 3275], [54, 3795], [60, 4035], [64, 4315], [69, 4595]]}, {"verse": 2, "start": 5651, "end": 8815, "text": "Bless the LORD, O my soul, and forget not all his benefits:", "words": [[0, 5651], [6, 5878], [10, 6138], [16, 6458], [18, 6498], [21, 6698], [27, 7318], [31, 7378], [38, 7718], [42, 7958], [46, 8158], [50, 8318]]}, {"verse": 3, "start": 9265, "end": 13530, "text": "Who forgives all your iniquities; who heals all your diseases;", "words": [[0, 9265], [4, 9756], [13, 10296], [17, 10516], [22, 10716], [34, 11776], [38, 11873], [44, 12133], [48, 12493], [53, 12653]]}, {"verse": 4, "start": 13980, "end": 19375, "text": "Who redeems your life from destruction; who crowns you with lovingkindness and tender mercies;", "words": [[0, 13980], [4, 14072], [12, 14572], [17, 14732], [22, 15052], [27, 15252], [40, 16389], [44, 16477], [51, 16957], [55, 17037], [60, 17527], [75, 18017], [79, 18277], [86, 18557]]}, {"verse": 5, "start": 19825, "end": 25176, "text": "Who satisfies your mouth with good things; so that your youth is renewed like the eagle’s.", "words": [[0, 19825], [4, 20025], [14, 20405], [19, 20905], [25, 21185], [30, 21405], [35, 21625], [43, 22674], [46, 22774], [51, 22934], [56, 23054], [62, 23414], [65, 23594], [73, 23994], [78, 24274], [82, 24454]]}, {"verse": 6, "start": 25626, "end": 29491, "text": "The LORD executes righteousness and judgment for all that are oppressed.", "words": [[0, 25626], [4, 25729], [9, 25969], [18, 26609], [32, 27089], [36, 27489], [45, 27869], [49, 28189], [53, 28429], [58, 28629], [62, 28769]]}, {"verse": 7, "start": 29941, "end": 34132, "text": "He made known his ways to Moses, his acts to the children of Israel.", "words": [[0, 29941], [3, 30089], [8, 30369], [14, 30709], [18, 30949], [23, 31229], [26, 31409], [33, 32329], [37, 32429], [42, 32729], [45, 32969], [49, 33069], [58, 33389], [61, 33569]]}, {"verse": 8, "start": 34582, "end": 39611, "text": "The LORD is merciful and gracious, slow to anger, and plenteous in mercy.", "words": [[0, 34582], [4, 34708], [9, 35028], [12, 35248], [21, 35748], [25, 36008], [35, 36888], [40, 37248], [43, 37428], [50, 38168], [54, 38248], [64, 38928], [67, 39068]]}, {"verse": 9, "start": 40061, "end": 44314, "text": "He will not always chide: neither will he keep his anger for ever.", "words": [[0, 40061], [3, 40171], [8, 40331], [12, 40531], [19, 40891], [26, 41914], [34, 42223], [39, 42543], [42, 42683], [47, 42922], [51, 43143], [57, 43552], [61, 43963]]}, {"verse": 10, "start": 44764, "end": 49803, "text": "He has not dealt with us after our sins; nor rewarded us according to our iniquities.", "words": [[0, 44764], [3, 44867], [7, 45027], [11, 45187], [17, 45407], [22, 45627], [25, 45787], [31, 46067], [35, 46267], [41, 47205], [45, 47431], [54, 47951], [57, 48191], [67, 48511], [70, 48831], [74, 49011]]}, {"verse": 11, "start": 50253, "end": 55647, "text": "For as the heaven is high above the earth, so great is his mercy toward them that fear him.", "words": [[0, 50253], [4, 50370], [7, 50530], [11, 50690], [18, 50950], [21, 51210], [26, 51470], [32, 51770], [36, 52010], [43, 52630], [46, 52930], [52, 53290], [55, 53490], [59, 53630], [65, 54030], [72, 54390], [77, 54690], [82, 54950], [87, 55190]]}, {"verse": 12, "start": 56097, "end": 61147, "text": "As far as the east is from the west, so far has he removed our transgressions from us.", "words": [[0, 56097], [3, 56230], [7, 56490], [10, 56630], [14, 56770], [19, 57030], [22, 57250], [27, 57470], [31, 57630], [37, 58310], [40, 58510], [44, 58790], [48, 59010], [51, 59130], [59, 59490], [63, 59710], [78, 60490], [83, 60730]]}, {"verse": 13, "start": 61597, "end": 65956, "text": "Like as a father pitieth his children, so the LORD pitieth them that fear him.", "words": [[0, 61597], [5, 61735], [8, 61915], [10, 62015], [17, 62475], [25, 62935], [29, 63075], [39, 63855], [42, 64015], [46, 64155], [51, 64535], [59, 64915], [64, 65115], [69, 65335], [74, 65555]]}, {"verse": 14, "start": 66406, "end": 69967, "text": "For he knows our frame; he remembers that we are dust.", "words": [[0, 66406], [4, 66526], [7, 66666], [13, 66886], [17, 67086], [24, 68053], [27, 68353], [37, 68773], [42, 69053], [45, 69233], [49, 69333]]}, {"verse": 15, "start": 70417, "end": 75626, "text": "As for man, his days are as grass: as a flower of the field, so he flourishes.", "words": [[0, 70417], [3, 70623], [7, 70803], [12, 71223], [16, 71303], [21, 71663], [25, 71903], [28, 72358], [35, 73033], [38, 73181], [40, 73281], [47, 73561], [50, 73881], [54, 73981], [61, 74401], [64, 74681], [67, 74801]]}, {"verse": 16, "start": 76076, "end": 81126, "text": "For the wind passes over it, and it is gone; and the place of it shall know it no more.", "words": [[0, 76076], [4, 76177], [8, 76297], [13, 76557], [20, 76937], [25, 77297], [29, 77537], [33, 77977], [36, 78097], [39, 78237], [45, 79066], [49, 79190], [53, 79290], [59, 79550], [62, 79730], [65, 79830], [71, 80050], [76, 80310], [79, 80430], [82, 80610]]}, {"verse": 17, "start": 81576, "end": 89379, "text": "But the mercy of the LORD is from everlasting to everlasting upon them that fear him, and his righteousness to children’s children;", "words": [[0, 81576], [4, 81681], [8, 81821], [14, 82121], [17, 82341], [21, 82481], [26, 82801], [29, 83081], [34, 83261], [46, 83941], [49, 84221], [61, 84581], [66, 85181], [71, 85561], [76, 85781], [81, 86081], [86, 86381], [90, 87041], [94, 87181], [108, 87721], [111, 88101], [122, 88681]]}, {"verse": 18, "start": 89829, "end": 94722, "text": "To such as keep his covenant, and to those that remember hi