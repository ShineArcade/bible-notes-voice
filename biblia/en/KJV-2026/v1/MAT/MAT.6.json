{"book": "MAT", "chapter": 6, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 251076, "verses": [{"verse": 1, "start": 300, "end": 7556, "text": "Take heed that you do not your alms before men, to be seen of them: otherwise you have no reward of your Father which is in heaven.", "words": [[0, 300], [5, 457], [10, 817], [15, 1037], [19, 1177], [22, 1297], [26, 1457], [31, 1657], [36, 2077], [43, 2377], [48, 2837], [51, 3197], [54, 3337], [59, 3597], [62, 3757], [68, 4392], [78, 4992], [82, 5092], [87, 5252], [90, 5432], [97, 5852], [100, 6032], [105, 6152], [112, 6492], [118, 6772], [121, 6912], [124, 7072]]}, {"verse": 2, "start": 8006, "end": 19330, "text": "Therefore when you do your alms, do not sound a trumpet before you, as the hypocrites do in the synagogues and in the streets, that they may have glory of men. Assuredly I say to you, They have their reward.", "words": [[0, 8006], [10, 8618], [15, 8798], [19, 8958], [22, 9078], [27, 9218], [33, 9978], [36, 10058], [40, 10218], [46, 10518], [48, 10678], [56, 10958], [63, 11318], [68, 11938], [71, 12138], [75, 12278], [86, 12718], [89, 12998], [92, 13178], [96, 13258], [107, 13858], [111, 13958], [114, 14058], [118, 14158], [127, 15002], [132, 15087], [137, 15247], [141, 15407], [146, 15607], [152, 15947], [155, 16167], [160, 17170], [170, 17450], [172, 17550], [176, 17770], [179, 17910], [184, 18150], [189, 18270], [194, 18490], [200, 18630]]}, {"verse": 3, "start": 19780, "end": 23444, "text": "But when you do alms, let not your left hand know what your right hand does:", "words": [[0, 19780], [4, 19882], [9, 20022], [13, 20142], [16, 20282], [22, 21022], [26, 21162], [30, 21322], [35, 21482], [40, 21702], [45, 21922], [50, 22162], [55, 22342], [60, 22442], [66, 22662], [71, 22902]]}, {"verse": 4, "start": 23894, "end": 29502, "text": "That your alms may be in secret: and your Father which sees in secret himself shall reward you openly.", "words": [[0, 23894], [5, 23996], [10, 24116], [15, 24496], [19, 24656], [22, 24796], [25, 24916], [33, 25786], [37, 25910], [42, 26030], [49, 26370], [55, 26650], [60, 26950], [63, 27150], [70, 27470], [78, 27970], [84, 28250], [91, 28630], [95, 28850]]}, {"verse": 5, "start": 29952, "end": 42546, "text": "¶ And when you pray, you shall not be as the hypocrites are: for they love to pray standing in the synagogues and in the corners of the streets, that they may be seen of men. Assuredly I say to you, They have their reward.", "words": [[2, 29952], [6, 30069], [11, 30229], [15, 30389], [21, 31009], [25, 31389], [31, 31569], [35, 31789], [38, 32029], [41, 32289], [45, 32429], [56, 32909], [61, 33609], [65, 33713], [70, 33873], [75, 34153], [78, 34373], [83, 34693], [92, 35133], [95, 35373], [99, 35473], [110, 36233], [114, 36353], [117, 36433], [121, 36553], [129, 36853], [132, 37093], [136, 37193], [145, 37553], [150, 38113], [155, 38273], [159, 38473], [162, 38633], [167, 38873], [170, 39033], [175, 39829], [185, 40446], [187, 40526], [191, 40746], [194, 40906], [199, 41406], [204, 41526], [209, 41746], [215, 41926]]}, {"verse": 6, "start": 42996, "end": 53523, "text": "But you, when you pray, enter into your closet, and when you have shut your door, pray to your Father which is in secret; and your Father which sees in secret shall reward you openly.", "words": [[0, 42996], [4, 43098], [9, 43298], [14, 43498], [18, 43598], [24, 44458], [30, 44778], [35, 44998], [40, 45138], [48, 46038], [52, 46218], [57, 46358], [61, 46518], [66, 46658], [71, 46918], [76, 47098], [82, 47858], [87, 48078], [90, 48258], [95, 48418], [102, 48758], [108, 49058], [111, 49198], [114, 49318], [122, 50241], [126, 50367], [131, 50487], [138, 50967], [144, 51107], [149, 51407], [152, 51607], [159, 52147], [165, 52287], [172, 52667], [176, 52887]]}, {"verse": 7, "start": 53973, "end": 61111, "text": "But when you pray, use not vain repetitions, as the heathen do: for they think that they shall be heard for their much speaking.", "words": [[0, 53973], [4, 54074], [9, 54194], [13, 54334], [19, 54934], [23, 55234], [27, 55474], [32, 55774], [45, 56534], [48, 56914], [52, 57074], [60, 57454], [64, 58174], [68, 58310], [73, 58490], [79, 58790], [84, 59010], [89, 59170], [95, 59370], [98, 59530], [104, 59870], [108, 60050], [114, 60210], [119, 60450]]}, {"verse": 8, "start": 61561, "end": 67386, "text": "Be not you therefore like to them: for your Father knows what things you have need of, before you ask him.", "words": [[0, 61561], [3, 61661], [7, 61901], [11, 62341], [21, 62821], [26, 62981], [29, 63161], [35, 63903], [39, 64005], [44, 64125], [51, 64425], [57, 64765], [62, 65005], [69, 65265], [73, 65445], [78, 65585], [83, 65765], [87, 66005], [94, 66345], [98, 66605], [102, 66905]]}, {"verse": 9, "start": 67836, "end": 72481, "text": "After this manner therefore pray: Our Father in heaven, Hallowed be your name.", "words": [[0, 67836], [6, 68106], [11, 68326], [18, 68626], [28, 69106], [34, 70003], [38, 70126], [45, 70446], [48, 70666], [56, 71226], [65, 71706], [68, 71826], [73, 71986]]}, {"verse": 10, "start": 72931, "end": 76653, "text": "Your kingdom come. Your will be done in earth, as it is in heaven.", "words": [[0, 72931], [5, 73032], [13, 73372], [19, 74322], [24, 74429], [29, 74609], [32, 74789], [37, 74969], [40, 75089], [47, 75409], [50, 75769], [53, 75909], [56, 76069], [59, 76169]]}, {"verse": 11, "start": 77103, "end": 78960, "text": "Give us this day our daily bread.", "words": [[0, 77103], [5, 77259], [8, 77419], [13, 77639], [17, 77899], [21, 78119], [27, 78399]]}, {"verse": 12, "start": 79410, "end": 82301, "text": "And forgive us our debts, as we forgive our debtors.", "words": [[0, 79410], [4, 79534], [12, 79834], [15, 80034], [19, 80174], [26, 80494], [29, 81094], [32, 81234], [40, 81594], [44, 81734]]}, {"verse": 13, "start": 82752, "end": 90716, "text": "And lead us not into temptation, but deliver us from evil: For yours is the kingdom, and the power, and the glory, for ever. Amen.", "words": [[0, 82752], [4, 82870], [9, 83070], [12, 83250], [16, 83490], [21, 83750], [33, 84650], [37, 84890], [45, 85190], [48, 85490], [53, 85670], [59, 86440], [63, 86524], [69, 86764], [72, 86984], [76, 87124], [85, 87444], [89, 87884], [93, 87984], [100, 88344], [104, 88644], [108, 88744], [115, 89101], [119, 89457], [125, 90085]]}, {"verse": 14, "start": 91166, "end": 95513, "text": "For if you forgive men their trespasses, your heavenly Father will also forgive you:", "words": [[0, 91166], [4, 91275], [7, 91435], [11, 91555], [19, 91875], [23, 92135], [29, 92315], [41, 93375], [46, 93515], [55, 93855], [62, 94235], [67, 94455], [72, 94755], [80, 95075]]}, {"verse": 15, "start": 95963, "end": 100820, "text": "But if you forgive not men their trespasses, neither will your Father forgive your trespasses.", "words": [[0, 95963], [4, 96040], [7, 96160], [11, 96280], [19, 96600], [23, 96900], [27, 97180], [33, 97340], [45, 98400], [53, 98580], [58, 98840], [63, 98980], [70, 99260], [78, 99700], [83, 99920]]}, {"verse": 16, "start": 101270, "end": 112496, "text": "¶ Moreover when you fast, be not, as the hypocrites, of a sad countenance: for they disfigure their faces, that they may appear to men to fast. Assuredly I say to you, They have their reward.", "words": [[2, 101270], [11, 101793], [16, 102033], [20, 102153], [26, 102933], [29, 103113], [34, 103393], [37, 103733], [41, 103873], [53, 104393], [56, 104633], [58, 104733], [62, 104993], [75, 105957], [79, 106038], [84, 106158], [94, 106658], [100, 106778], [107, 107178], [112, 107438], [117, 107598], [121, 107738], [128, 108038], [131, 108218], [135, 108478], [138, 108698], [144, 109528], [154, 110111], [156, 110211], [160, 110451], [163, 110611], [168, 110851], [173, 111371], [178, 111651], [184, 111851]]}, {"verse": 17, "start": 112946, "end": 116514, "text": "But you, when you fast, anoint your head, and wash your face;", "words": [[0, 112946], [4, 113054], [9, 113314], [14, 113514], [18, 113634], [24, 114334], [31, 114694], [36, 114874], [42, 115174], [46, 115534], [51, 115854], [56, 116034]]}, {"verse": 18, "start": 116964, "end": 125104, "text": "That you appear not to men to fast, but to your Father which is in secret: and your Father, which sees in secret, shall reward you openly.", "words": [[0, 116964], [5, 117066], [9, 117226], [16, 117586], [20, 117826], [23, 118046], [27, 118206], [30, 118386], [36, 119026], [40, 119266], [43, 119406], [48, 119526], [55, 119886], [61, 120186], [64, 120326], [67, 120466], [75, 121359], [79, 121485], [84, 121605], [92, 122245], [98, 122425], [103, 122745], [106, 122965], [114, 123645], [120, 123825], [127, 124205], [131, 124445]]}, {"verse": 19, "start": 125554, "end": 132936, "text": "¶ Lay not up for yourselves treasures upon earth, where moth and rust does corrupt, and where thieves break through and steal:", "words": [[2, 125554], [6, 125750], [10, 125990], [13, 126190], [17, 126370], [28, 126790], [38, 127210], [43, 127590], [50, 128310], [56, 128590], [61, 129050], [65, 129170], [70, 129490], [75, 129790], [84, 130550], [88, 130790], [94, 130970], [102, 131330], [108, 131750], [116, 132110], [120, 132330]]}, {"verse": 20, "start": 133386, "end": 140929, "text": "But lay up for yourselves treasures in heaven, where neither moth nor rust does corrupt, and where thieves do not break through nor steal:", "words": [[0, 133386], [4, 133528], [8, 133728], [11, 133928], [15, 134068], [26, 134488], [36, 134928], [39, 135188], [47, 135788], [53, 136048], [61, 136288], [66, 136828], [70, 137028], [75, 137428], [80, 137628], [89, 138408], [93, 138588], [99, 138748], [107, 139048], [110, 139348], [114, 139508], [120, 139768], [128, 140068], [132, 140328]]}, {"verse": 21, "start": 141379, "end": 144744, "text": "For where your treasure is, there will your heart be also.", "words": [[0, 141379], [4, 141505], [10, 141725], [15, 141885], [24, 142165], [28, 143025], [34, 143145], [39, 143365], [44, 143545], [50, 143825], [53, 144065]]}, {"verse": 22, "start": 145194, "end": 151127, "text": "The light of the body is the eye: if therefore your eye be single, your whole body shall be full of light.", "words": [[0, 145194], [4, 145275], [10, 145495], [13, 145615], [17, 145735], [22, 145995], [25, 146315], [29, 146495], [34, 147308], [37, 147448], [47, 147848], [52, 148048], [56, 148288], [59, 148428], [67, 149228], [72, 149328], [78, 149528], [83, 149848], [89, 150088], [92, 150248], [97, 150488], [100, 150608]]}, {"verse": 23, "start": 151577, "end": 159931, "text": "But if your eye be evil, your whole body shall be full of darkness. If therefore the light that is in you be darkness, how great is that darkness!", "words": [[0, 151577], [4, 151680], [7, 151800], [12, 151940], [16, 152220], [19, 152420], [25, 153180], [30, 153320], [36, 153560], [41, 153900], [47, 154120], [50, 154260], [55, 154520], [58, 154620], [68, 155673], [71, 155794], [81, 156194], [85, 156394], [91, 156654], [96, 156854], [99, 156994], [102, 157254], [106, 157374], [109, 157494], [119, 158274], [123, 158454], [129, 158794], [132, 159014], [137, 159194]]}, {"verse": 24, "start": 160381, "end": 171019, "text": "¶ No man can serve two masters: for either he will hate the one, and love the other; or else he will hold to the one, and despise the other. You cannot serve God and mammon.", "words": [[2, 160381], [5, 160607], [9, 160947], [13, 161207], [19, 161527], [23, 161807], [32, 162864], [36, 162943], [43, 163243], [46, 163463], [51, 163603], [56, 163823], [60, 164023], [65, 164303], [69, 164683], [74, 164923], [78, 165123], [85, 165827], [88, 165926], [93, 166146], [96, 166326], [101, 166446], [106, 166686], [109, 166866], [113, 166966], [118, 167246], [122, 167566], [130, 168126], [134, 168326], [141, 168999], [145, 169084], [152, 169384], [158, 169804], [162, 170164], [166, 170484]]}, {"verse": 25, "start": 171469, "end": 182986, "text": "Therefore I say to you, Take no thought for your life, what you shall eat, or what you shall drink; nor yet for your body, what you shall put on. Is not the life more than food, and the body than clothing?", "words": [[0, 171469], [10, 171733], [12, 171973], [16, 172173], [19, 172333], [24, 172793], [29, 172993], [32, 173193], [40, 173473], [44, 173653], [49, 173773], [55, 174213], [60, 174313], [64, 174433], [70, 174613], [75, 174893], [78, 175293], [83, 175453], [87, 175573], [93, 175733], [100, 176498], [104, 176779], [108, 177079], [112, 177339], [117, 177539], [123, 177939], [128, 178479], [132, 178699], [138, 178899], [142, 179099], [146, 179837], [149, 179996], [153, 180156], [157, 180336], [162, 180596], [167, 180856], [172, 181036], [178, 181396], [182, 181696], [186, 181816], [191, 182116], [196, 182336]]}, {"verse": 26, "start": 183436, "end": 193232, "text": "Behold the fowls of the air: for they sow not, neither do they reap, nor gather into barns; yet your heavenly Father feeds them. Are you not much better than they?", "words": [[0, 183436], [7, 183792], [11, 183972], [17, 184392], [20, 184492], [24, 184632], [29, 185400], [33, 185509], [38, 185719], [42, 185929], [47, 186549], [55, 186769], [58, 187049], [63, 187209], [69, 187549], [73, 187909], [80, 188289], [85, 188549], [92, 189542], [96, 189645], [101, 189825], [110, 190145], [117, 190545], [123, 190925], [129, 191754], [133, 191859], [137, 191979], [141, 192159], [146, 192359], [153, 192599], [158, 192819]]}, {"verse": 27, "start": 193682, "end": 197246, "text": "Which of you by taking thought can add one cubit to his stature?", "words": [[0, 193682], [6, 193872], [9, 194052], [13, 194172], [16, 194352], [23, 194672], [31, 195052], [35, 195312], [39, 195572], [43, 195922], [49, 196272], [52, 196472], [56, 196652]]}, {"verse": 28, "start": 197696, "end": 204991, "text": "And why do you take thought for clothing? Consider the lilies of the field, how they grow; they toil not, neither do they spin:", "words": [[0, 197696], [4, 197803], [8, 198043], [11, 198223], [15, 198323], [20, 198543], [28, 198823], [32, 199023], [42, 199907], [51, 200227], [55, 200467], [62, 200847], [65, 200967], [69, 201067], [76, 201687], [80, 201847], [85, 202007], [91, 202809], [96, 202913], [101, 203233], [106, 203553], [114, 203913], [117, 204193], [122, 204373]]}, {"verse": 29, "start": 205441, "end": 210548, "text": "And yet I say to you, That even Solomon in all his glory was not arrayed like one of these.", "words": [[0, 205441], [4, 205578], [8, 205738], [10, 205878], [14, 206098], [17, 206278], [22, 206518], [27, 207058], [32, 207258], [40, 207778], [43, 208058], [47, 208238], [51, 208418], [57, 208798], [61, 209018], [65, 209218], [73, 209638], [78, 209758], [82, 209958], [85, 210078]]}, {"verse": 30, "start": 210998, "end": 220293, "text": "Why, if God so clothe the grass of the field, which today is, and tomorrow is cast into the oven, shall he not much more clothe you, O you of little faith?", "words": [[0, 210998], [5, 211199], [8, 211399], [12, 211659], [15, 212009], [22, 212359], [26, 212419], [32, 212739], [35, 212899], [39, 213019], [46, 213739], [52, 213899], [58, 214239], [62, 214979], [66, 215139], [75, 215499], [78, 215779], [83, 215999], [88, 216319], [92, 216499], [98, 217099], [104, 217279], [107, 217439], [111, 217619], [116, 217879], [121, 218079], [128, 218519], [133, 219098], [135, 219263], [139, 219423], [142, 219603], [149, 219783]]}, {"verse": 31, "start": 220743, "end": 227906, "text": "Therefore take no thought, saying, What shall we eat? or, What shall we drink? or, Wherewithal shall we be clothed?", "words": [[0, 220743], [10, 221069], [15, 221389], [18, 221609], [27, 222229], [35, 222909], [40, 223249], [46, 223489], [49, 223669], [54, 224419], [58, 224563], [63, 224763], [69, 224963], [72, 225143], [79, 225949], [83, 226149], [95, 226769], [101, 226949], [104, 227109], [107, 227229]]}, {"verse": 32, "start": 228356, "end": 235576, "text": "(For after all these things do the Gentiles seek:) for your heavenly Father knows that you have need of all these things.", "words": [[0, 228356], [5, 228468], [11, 228768], [15, 229148], [21, 229388], [28, 229868], [31, 230128], [35, 230248], [44, 230828], [51, 231648], [55, 231908], [60, 232048], [69, 232408], [76, 232868], [82, 233308], [87, 233648], [91, 233808], [96, 233988], [101, 234308], [104, 234568], [108, 234708], [114, 234908]]}, {"verse": 33, "start": 236026, "end": 242378, "text": "But seek first the kingdom of God, and his righteousness; and all these things shall be added to you.", "words": [[0, 236026], [4, 236168], [9, 236428], [15, 236828], [19, 237208], [27, 237548], [30, 237788], [35, 238168], [39, 238668], [43, 238828], [58, 240010], [62, 240131], [66, 240391], [72, 240611], [79, 240971], [85, 241271], [88, 241431], [94, 241731], [97, 241971]]}, {"verse": 34, "start": 242828, "end": 250676, "text": "Take therefore no thought for the next day: for the next day shall take thought for the things of itself. Sufficient to the day is the evil of it.", "words": [[0, 242828], [5, 243010], [15, 243450], [18, 243750], [26, 244110], [30, 244330], [34, 244450], [39, 244670], [44, 245457], [48, 245534], [52, 245634], [57, 245854], [61, 246174], [67, 246374], [72, 246614], [80, 246914], [84, 247094], [88, 247194], [95, 247434], [98, 247614], [106, 248454], [117, 248832], [120, 249132], [124, 249252], [128, 249552], [131, 249772], [135, 249932], [140, 250212], [143, 250432]]}]}