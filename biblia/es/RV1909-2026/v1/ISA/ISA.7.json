{"book": "ISA", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 232678, "verses": [{"verse": 1, "start": 300, "end": 17214, "text": "Aconteció en los días de Acaz hijo de Jotam, hijo de Uzías, rey de Judá, que Rezín rey de Siria, y Peca hijo de Remalías, rey de Israel, subieron a Jerusalén para combatirla; pero no la pudieron tomar.", "words": [[0, 300], [10, 1083], [13, 1243], [17, 1343], [22, 1583], [25, 2033], [30, 2483], [35, 2643], [38, 2823], [45, 3743], [50, 4123], [53, 4853], [60, 5583], [64, 6043], [67, 6243], [73, 7183], [77, 7503], [83, 7823], [87, 8203], [90, 8383], [97, 9163], [99, 9503], [104, 9843], [109, 9963], [112, 10183], [122, 11143], [126, 11583], [129, 11683], [137, 12891], [146, 13313], [148, 13453], [158, 14113], [163, 14313], [175, 15628], [180, 15772], [183, 15972], [186, 16092], [195, 16592]]}, {"verse": 2, "start": 17664, "end": 32824, "text": "Y vino la nueva a la casa de David, diciendo: Siria se ha confederado con Efraín. Y se le estremeció el corazón, y el corazón de su pueblo, como se estremecen los árboles del monte a causa del viento.", "words": [[0, 17664], [2, 17991], [7, 18271], [10, 18491], [16, 18871], [18, 19131], [21, 19211], [26, 19531], [29, 19771], [36, 20131], [46, 21505], [52, 21960], [55, 22240], [58, 22360], [70, 23040], [74, 23240], [82, 24260], [84, 24447], [87, 24547], [90, 24727], [101, 25567], [104, 25727], [113, 26267], [115, 27007], [118, 27147], [126, 27587], [129, 27807], [132, 27947], [140, 28687], [145, 29027], [148, 29267], [159, 30027], [163, 30227], [171, 30747], [175, 31007], [181, 31347], [183, 31567], [189, 31847], [193, 32167]]}, {"verse": 3, "start": 33274, "end": 45528, "text": "Entonces dijo Jehová a Isaías: Sal ahora al encuentro de Acaz, tú, y Sear-jasub tu hijo, al extremo del conducto de la Estanque de arriba, en el camino de la heredad del Lavador,", "words": [[0, 33274], [9, 33761], [14, 34261], [21, 34841], [23, 35041], [31, 36418], [35, 36598], [41, 36858], [44, 37018], [54, 37558], [57, 37908], [63, 38258], [67, 38938], [69, 39318], [80, 39698], [83, 39918], [89, 40678], [92, 40778], [100, 41338], [104, 41458], [113, 41998], [116, 42078], [119, 42178], [128, 42598], [131, 42718], [139, 43458], [142, 43558], [145, 43678], [152, 43978], [155, 44238], [158, 44338], [166, 44718], [170, 44858]]}, {"verse": 4, "start": 46208, "end": 60387, "text": "Y dile: Guarda, y repósate; no temas, ni se enternezca tu corazón a causa de estos dos cabos de tizón que humean, por el furor de la ira de Rezín y del sirio, y del hijo de Remalías.", "words": [[0, 46416], [2, 46660], [8, 47438], [16, 47981], [18, 48241], [28, 49571], [31, 49769], [38, 50129], [41, 50509], [44, 50949], [55, 51389], [58, 51529], [66, 51989], [68, 52649], [74, 52949], [77, 53189], [83, 53409], [87, 53669], [93, 54149], [96, 54289], [102, 54709], [106, 54889], [114, 55369], [118, 55869], [121, 56029], [127, 56389], [130, 56509], [133, 56629], [137, 56909], [140, 57209], [146, 57509], [148, 57649], [152, 57789], [159, 58935], [161, 59077], [165, 59217], [170, 59457], [173, 59922]]}, {"verse": 5, "start": 61118, "end": 67852, "text": "Por haber acordado maligno consejo contra ti el sirio, con Efraín y con el hijo de Remalías, diciendo:", "words": [[0, 61118], [4, 61262], [10, 61422], [19, 62002], [27, 62562], [35, 63082], [42, 63382], [45, 63742], [48, 63802], [55, 64722], [59, 64842], [66, 65402], [68, 65802], [72, 65982], [75, 66082], [80, 66282], [83, 66402], [93, 67202]]}, {"verse": 6, "start": 68549, "end": 76333, "text": "Vamos contra Judá, y la despertaremos, y la partiremos entre nosotros, y pondremos en medio de ella por rey al hijo de Tabeel:", "words": [[0, 68549], [6, 68853], [13, 69153], [19, 69453], [21, 69853], [24, 69933], [39, 70673], [41, 71293], [44, 71413], [55, 72073], [61, 72273], [71, 72753], [73, 73393], [83, 73853], [86, 74073], [92, 74313], [95, 74513], [100, 74753], [104, 74973], [108, 75353], [111, 75513], [116, 75693], [119, 76013]]}, {"verse": 7, "start": 76936, "end": 80425, "text": "El Señor Jehová dice así: No subsistirá, ni será.", "words": [[0, 76936], [3, 77098], [9, 77378], [16, 77958], [21, 78138], [26, 78916], [29, 79248], [41, 79622], [44, 79995]]}, {"verse": 8, "start": 81106, "end": 91632, "text": "Porque la cabeza de Siria es Damasco, y la cabeza de Damasco, Rezín: y dentro de sesenta y cinco años Efraín será quebrantado hasta dejar de ser pueblo.", "words": [[0, 81106], [7, 81286], [10, 81426], [17, 81746], [20, 81946], [26, 82386], [29, 82566], [38, 83166], [40, 83646], [43, 83766], [50, 84106], [53, 84326], [62, 85091], [69, 86384], [71, 86522], [78, 86762], [81, 87012], [89, 87262], [91, 87512], [97, 87762], [102, 88282], [109, 88922], [114, 89122], [126, 89842], [132, 90362], [138, 90762], [141, 90902], [145, 91042]]}, {"verse": 9, "start": 92321, "end": 102430, "text": "Entretanto la cabeza de Efraín es Samaria, y la cabeza de Samaria el hijo de Remalías. Si vosotros no creéis, de cierto no permaneceréis.", "words": [[0, 92629], [11, 92979], [14, 93179], [21, 93599], [24, 93859], [31, 94419], [34, 94799], [43, 95319], [45, 95799], [48, 95899], [55, 96299], [58, 96459], [66, 97019], [69, 97319], [74, 97539], [77, 97659], [87, 99008], [90, 99150], [99, 99610], [102, 99850], [110, 100650], [113, 100730], [120, 101010], [123, 101350]]}, {"verse": 10, "start": 103025, "end": 105942, "text": "Y habló más Jehová a Acaz, diciendo:", "words": [[0, 103025], [2, 103149], [8, 103429], [12, 103779], [19, 104129], [21, 104709], [27, 105289]]}, {"verse": 11, "start": 106192, "end": 112688, "text": "Pide para ti señal de Jehová tu Dios, pidiéndola en lo profundo, o arriba en lo alto.", "words": [[0, 106192], [5, 106468], [10, 106728], [13, 107068], [19, 107668], [22, 107808], [29, 108228], [32, 108328], [38, 109068], [49, 109848], [52, 110088], [55, 110188], [65, 110768], [67, 111328], [74, 111668], [77, 112008], [80, 112148]]}, {"verse": 12, "start": 113276, "end": 117052, "text": "Y respondió Acaz: No pediré, y no tentaré a Jehová.", "words": [[0, 113276], [2, 113397], [12, 114103], [18, 115059], [21, 115201], [29, 115721], [31, 115901], [34, 116021], [42, 116481], [44, 116621]]}, {"verse": 13, "start": 117402, "end": 125808, "text": "Dijo entonces Isaías: Oíd ahora, casa de David. ¿Os es poco el ser molestos a los hombres, sino que también lo seáis a mi Dios?", "words": [[0, 117402], [5, 117698], [14, 118198], [22, 119555], [26, 119840], [33, 120080], [38, 120380], [41, 120600], [48, 121349], [52, 121488], [55, 121628], [60, 121908], [63, 122128], [67, 122288], [76, 122848], [78, 122948], [82, 123068], [91, 123768], [96, 124088], [100, 124248], [108, 124608], [111, 124808], [117, 125008], [119, 125288], [122, 125368]]}, {"verse": 14, "start": 126258, "end": 134165, "text": "Por tanto el mismo Señor os dará señal: He aquí que la virgen concebirá, y parirá hijo, y llamará su nombre Emanuel.", "words": [[0, 126258], [4, 126482], [10, 126922], [13, 127022], [19, 127242], [25, 127582], [28, 127842], [33, 128142], [40, 129084], [43, 129174], [48, 129414], [52, 129594], [55, 129734], [62, 130114], [73, 130874], [75, 131154], [82, 131614], [88, 131974], [90, 132414], [98, 132814], [101, 132994], [108, 133609]]}, {"verse": 15, "start": 134615, "end": 138981, "text": "Comerá mantequilla y miel, para que sepa desechar lo malo y escoger lo bueno.", "words": [[0, 134615], [7, 134957], [19, 135617], [21, 135717], [27, 135997], [32, 136577], [36, 136717], [41, 136977], [50, 137437], [53, 137537], [58, 137917], [60, 137997], [68, 138397], [71, 138537]]}, {"verse": 16, "start": 139331, "end": 150271, "text": "Porque antes que el niño sepa desechar lo malo y escoger lo bueno, la tierra que tú aborreces será dejada de sus dos reyes.", "words": [[0, 139331], [7, 139615], [13, 140315], [17, 140555], [20, 140715], [25, 141055], [30, 141595], [39, 142275], [42, 142715], [47, 143355], [49, 143535], [57, 144115], [60, 144295], [67, 145275], [70, 145415], [77, 145795], [81, 146035], [84, 146275], [94, 146995], [99, 147715], [106, 148615], [109, 148815], [113, 149035], [117, 149395]]}, {"verse": 17, "start": 150571, "end": 162069, "text": "Jehová hará venir sobre ti, y sobre tu pueblo, y sobre la casa de tu padre, días cuales nunca vinieron desde el día que Efraín se apartó de Judá, es decir, al rey de Asiria.", "words": [[0, 150571], [7, 151044], [12, 151324], [18, 151544], [24, 151864], [28, 152224], [30, 152624], [36, 152864], [39, 153084], [47, 153504], [49, 154064], [55, 154304], [58, 154484], [63, 154784], [66, 154964], [69, 155104], [76, 155904], [81, 156144], [88, 156424], [94, 156844], [103, 157424], [109, 157684], [112, 157944], [116, 158144], [120, 158344], [127, 158784], [130, 158944], [137, 159364], [140, 159464], [146, 160237], [149, 160377], [156, 160757], [159, 160977], [163, 161317], [166, 161377]]}, {"verse": 18, "start": 162519, "end": 170432, "text": "Y acontecerá que aquel día silbará Jehová a la mosca que está en el fin de los ríos de Egipto, y a la abeja que está en la tierra de Asiria.", "words": [[0, 162519], [2, 162623], [13, 163243], [17, 163363], [23, 163663], [27, 164036], [35, 164410], [42, 164783], [44, 164863], [47, 164943], [53, 165383], [57, 165523], [62, 165783], [65, 165983], [68, 166123], [72, 166283], [75, 166443], [79, 166583], [84, 166963], [87, 167103], [95, 167917], [97, 168057], [99, 168137], [102, 168237], [108, 168617], [112, 168777], [117, 169037], [120, 169197], [123, 169317], [130, 169617], [133, 169797]]}, {"verse": 19, "start": 170882, "end": 181398, "text": "Y vendrán, y se asentarán todos en los valles desiertos, y en las cavernas de las piedras, y en todos los zarzales, y en todas las matas.", "words": [[0, 170882], [2, 170988], [11, 171588], [13, 171808], [16, 171948], [26, 172628], [32, 172908], [35, 173228], [39, 173368], [46, 173748], [57, 174608], [59, 175008], [62, 175108], [66, 175268], [75, 175848], [78, 175948], [82, 176108], [91, 176688], [93, 177008], [96, 177168], [102, 177348], [106, 177768], [116, 178188], [118, 178648], [121, 178788], [127, 178948], [131, 179228]]}, {"verse": 20, "start": 181848, "end": 192971, "text": "En aquel día rapará el Señor con navaja alquilada, con los que habitan del otro lado del río, a saber, con el rey de Asiria, cabeza y pelos de los pies; y aun la barba también quitará.", "words": [[0, 181848], [3, 181948], [9, 182228], [13, 182428], [20, 182928], [23, 183068], [29, 183348], [33, 183608], [40, 184048], [51, 185008], [55, 185248], [59, 185368], [63, 185508], [71, 185888], [75, 186008], [80, 186188], [85, 186408], [89, 186648], [94, 187068], [96, 187268], [103, 187608], [107, 188088], [110, 188188], [114, 188428], [117, 188488], [125, 189372], [132, 189775], [134, 189915], [140, 190155], [143, 190315], [147, 190415], [153, 191202], [155, 191325], [159, 191485], [162, 191685], [168, 192025], [176, 192265]]}, {"verse": 21, "start": 193421, "end": 197884, "text": "Y acontecerá en aquel tiempo, que críe un hombre una vaca y dos ovejas;", "words": [[0, 193421], [2, 193544], [13, 194264], [16, 194364], [22, 194664], [30, 194984], [34, 195424], [39, 195764], [42, 195944], [49, 196184], [53, 196404], [58, 196904], [60, 196984], [64, 197164]]}, {"verse": 22, "start": 198334, "end": 207671, "text": "Y será que a causa de la abundancia de leche que darán, comerá mantequilla: cierto mantequilla y miel comerá el que quede en medio de la tierra.", "words": [[0, 198334], [2, 198633], [7, 198833], [11, 199053], [13, 199133], [19, 199353], [22, 199573], [25, 199673], [36, 200213], [39, 200333], [45, 200593], [49, 200773], [56, 201613], [63, 201873], [76, 204163], [83, 204503], [95, 205163], [97, 205263], [102, 205483], [109, 205983], [112, 206103], [116, 206223], [122, 206523], [125, 206643], [131, 206863], [134, 207043], [137, 207143]]}, {"verse": 23, "start": 208121, "end": 215942, "text": "Acontecerá también en aquel tiempo, que el lugar donde había mil vides que valían mil siclos de plata, será para los espinos y cardos.", "words": [[0, 208121], [11, 208780], [19, 209060], [22, 209280], [28, 209580], [36, 209940], [40, 210540], [43, 210680], [49, 210920], [55, 211200], [61, 211480], [65, 211760], [71, 212140], [75, 212320], [82, 212660], [86, 213000], [93, 213340], [96, 213460], [103, 213840], [108, 214400], [113, 214620], [117, 214800], [125, 215240], [127, 215420]]}, {"verse": 24, "start": 216392, "end": 221143, "text": "Con flechas y arco irán allá; porque toda la tierra será espinos y cardos.", "words": [[0, 216392], [4, 216532], [12, 216932], [14, 217132], [19, 217372], [24, 217672], [30, 218353], [37, 218562], [42, 218802], [45, 219022], [52, 219362], [57, 219662], [65, 220262], [67, 220442]]}, {"verse": 25, "start": 221593, "end": 232278, "text": "Y a todos los montes que se cavaban con azada, no llegará allá el temor de los espinos y de los cardos: mas serán para pasto de bueyes, y para ser pisoteados de los ganados.", "words": [[0, 221593], [2, 221695], [4, 221775], [10, 221995], [14, 222255], [21, 222775], [25, 222895], [28, 223035], [36, 223495], [40, 223995], [47, 224495], [50, 224695], [58, 225115], [63, 225375], [66, 225595], [72, 225935], [75, 226055], [79, 226175], [87, 226695], [89, 226855], [92, 226935], [96, 227075], [104, 228227], [108, 228445], [114, 228805], [119, 228985], [125, 229465], [128, 229545], [136, 230025], [138, 230285], [143, 230485], [147, 230705], [158, 231365], [161, 231525], [165, 231625]]}]}