{"book": "MAT", "chapter": 12, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 401853, "verses": [{"verse": 1, "start": 300, "end": 10014, "text": "En aquel tiempo iba Jesús por los sembrados en sábado; y sus discípulos tenían hambre, y comenzaron a arrancar espigas, y a comer.", "words": [[0, 300], [3, 455], [9, 755], [16, 1095], [20, 1455], [26, 1895], [30, 2435], [34, 2635], [44, 3375], [47, 3575], [55, 4469], [57, 4754], [61, 4914], [72, 5514], [79, 5894], [87, 6614], [89, 7134], [100, 7754], [102, 7954], [111, 8494], [120, 9194], [122, 9394], [124, 9534]]}, {"verse": 2, "start": 10364, "end": 16822, "text": "Y viéndolo los fariseos, le dijeron: He aquí tus discípulos hacen lo que no es lícito hacer en sábado.", "words": [[0, 10364], [2, 10564], [11, 11044], [15, 11244], [25, 11904], [28, 12044], [37, 13071], [40, 13161], [45, 13381], [49, 13661], [60, 14261], [66, 14681], [69, 14881], [73, 15021], [76, 15221], [79, 15361], [86, 15781], [92, 16081], [95, 16261]]}, {"verse": 3, "start": 17102, "end": 23468, "text": "Y él les dijo: ¿No habéis leído qué hizo David, teniendo él hambre y los que con él estaban:", "words": [[0, 17102], [2, 17270], [5, 17410], [9, 17610], [15, 18402], [19, 18589], [26, 18989], [32, 19369], [36, 19569], [41, 19849], [48, 20529], [57, 21069], [60, 21249], [67, 21829], [69, 22229], [73, 22349], [77, 22509], [81, 22689], [84, 22809]]}, {"verse": 4, "start": 23818, "end": 34333, "text": "Cómo entró en la casa de Dios, y comió los panes consagrados, que no le era lícito comer, ni a los que estaban con él, sino a solos los sacerdotes?", "words": [[0, 23818], [5, 24022], [11, 24442], [14, 24562], [17, 24682], [22, 24942], [25, 25182], [31, 25502], [33, 25782], [39, 26242], [43, 26422], [49, 26862], [62, 27982], [66, 28062], [69, 28282], [72, 28482], [76, 28682], [83, 29162], [90, 30102], [93, 30222], [95, 30302], [99, 30422], [103, 30562], [111, 30842], [115, 31202], [119, 31742], [124, 31982], [126, 32342], [132, 32942], [136, 33282]]}, {"verse": 5, "start": 34683, "end": 42291, "text": "O ¿no habéis leído en la ley, que los sábados en el templo los sacerdotes profanan el sábado, y son sin culpa?", "words": [[0, 34683], [2, 34789], [6, 34909], [13, 35249], [19, 35669], [22, 35809], [25, 35929], [30, 36209], [34, 36469], [38, 36649], [46, 37149], [49, 37349], [52, 37509], [59, 38049], [63, 38189], [74, 38989], [83, 39889], [86, 40109], [94, 40749], [96, 41109], [100, 41309], [104, 41549]]}, {"verse": 6, "start": 42641, "end": 45493, "text": "Pues os digo que uno mayor que el templo está aquí.", "words": [[0, 42641], [5, 42763], [8, 42903], [13, 43143], [17, 43363], [21, 43523], [27, 43943], [31, 44143], [34, 44283], [41, 44763], [46, 44923]]}, {"verse": 7, "start": 45843, "end": 52648, "text": "Pero si supieseis qué es: Misericordia quiero y no sacrificio, no condenaríais a los inocentes:", "words": [[0, 45843], [5, 45989], [8, 46189], [18, 46829], [22, 47089], [26, 48440], [39, 48770], [46, 49100], [48, 49200], [51, 49320], [63, 50300], [66, 50840], [79, 51380], [81, 51500], [85, 51660]]}, {"verse": 8, "start": 52998, "end": 56177, "text": "Porque Señor es del sábado el Hijo del hombre.", "words": [[0, 52998], [7, 53278], [13, 53678], [16, 54058], [20, 54258], [27, 54858], [30, 55118], [35, 55398], [39, 55578]]}, {"verse": 9, "start": 56527, "end": 60515, "text": "Y partiéndose de allí, vino a la sinagoga de ellos.", "words": [[0, 56527], [2, 56754], [14, 57434], [17, 57634], [23, 58394], [28, 58834], [30, 59094], [33, 59154], [42, 59734], [45, 59934]]}, {"verse": 10, "start": 60865, "end": 70259, "text": "Y he aquí había allí uno que tenía una mano atrofiada: y le preguntaron, diciendo: ¿Es lícito curar en sábado? por acusarle.", "words": [[0, 60865], [2, 60939], [5, 61049], [10, 61489], [16, 61929], [21, 62349], [25, 62749], [29, 62949], [35, 63269], [39, 63569], [44, 63889], [55, 65052], [57, 65140], [60, 65240], [73, 65980], [83, 67380], [87, 67548], [94, 67888], [100, 68288], [103, 68408], [111, 69252], [115, 69774]]}, {"verse": 11, "start": 70609, "end": 80096, "text": "Y él les dijo: ¿Qué hombre habrá de vosotros, que tenga una oveja, y si esta cae en una fosa en sábado, no le eche mano, y la levante?", "words": [[0, 70609], [2, 70778], [5, 70918], [9, 71118], [15, 71909], [20, 72033], [27, 72413], [33, 72773], [36, 72873], [46, 73473], [50, 73913], [56, 74233], [60, 74453], [67, 75293], [69, 75373], [72, 75473], [77, 75743], [81, 76013], [84, 76153], [88, 76313], [93, 76633], [96, 76813], [104, 77793], [107, 77893], [110, 78053], [115, 78333], [121, 78713], [123, 79043], [126, 79373]]}, {"verse": 12, "start": 80446, "end": 86043, "text": "Pues ¿cuánto más vale un hombre que una oveja? Así que, lícito es en los sábados hacer bien.", "words": [[0, 80446], [5, 80446], [13, 81008], [17, 81167], [22, 81447], [25, 81647], [32, 81887], [36, 82107], [40, 82287], [47, 83156], [51, 83480], [56, 83860], [63, 84240], [66, 84440], [69, 84600], [73, 84740], [81, 85240], [87, 85500]]}, {"verse": 13, "start": 86393, "end": 94564, "text": "Entonces dijo a aquel hombre: Extiende tu mano. Y él la extendió, y fue restaurada sana como la otra.", "words": [[0, 86393], [9, 86823], [14, 87023], [16, 87223], [22, 87583], [30, 88322], [39, 88847], [42, 89007], [48, 89783], [50, 89959], [53, 90179], [56, 90439], [66, 91519], [68, 92099], [72, 92299], [83, 93079], [88, 93459], [93, 93799], [96, 93999]]}, {"verse": 14, "start": 94914, "end": 99503, "text": "Y salidos los fariseos, consultaron contra él para destruirle.", "words": [[0, 94914], [2, 95181], [10, 95641], [14, 95841], [24, 96521], [36, 97321], [43, 97681], [46, 97941], [51, 98181]]}, {"verse": 15, "start": 99853, "end": 106304, "text": "Pero sabiéndolo Jesús, se apartó de allí: y le siguió mucha gente, y sanaba a todos.", "words": [[0, 99853], [5, 100195], [16, 100815], [23, 101235], [26, 101755], [33, 102355], [36, 102535], [42, 103325], [44, 103449], [47, 103589], [54, 104009], [60, 104229], [67, 104749], [69, 104964], [76, 105424], [78, 105624]]}, {"verse": 16, "start": 106654, "end": 110392, "text": "Y él les ordenaba estrictamente que no le descubriesen:", "words": [[0, 106654], [2, 106797], [5, 106937], [9, 107217], [18, 107917], [32, 108837], [36, 108997], [39, 109157], [42, 109297]]}, {"verse": 17, "start": 110742, "end": 115067, "text": "Para que se cumpliese lo que estaba dicho por el profeta Isaías, que dijo:", "words": [[0, 110742], [5, 110960], [9, 111080], [12, 111220], [22, 111880], [25, 112060], [29, 112180], [36, 112420], [42, 112760], [46, 113040], [49, 113160], [57, 113680], [65, 114260], [69, 114540]]}, {"verse": 18, "start": 115267, "end": 125040, "text": "He aquí mi siervo, al cual he escogido; mi Amado, en el cual se agrada mi alma: pondré mi Espíritu sobre él, y a los Gentiles anunciará juicio.", "words": [[0, 115313], [3, 115393], [8, 115633], [11, 115793], [19, 116593], [22, 116693], [27, 116873], [30, 117093], [40, 118254], [43, 118390], [50, 118830], [53, 119070], [56, 119130], [61, 119370], [64, 119590], [71, 119890], [74, 120070], [80, 120969], [87, 121288], [90, 121408], [99, 121928], [105, 122168], [109, 122428], [111, 122748], [113, 122828], [117, 122928], [126, 123468], [136, 124168]]}, {"verse": 19, "start": 125390, "end": 130495, "text": "No contenderá, ni voceará: ni nadie oirá en las calles su voz.", "words": [[0, 125390], [3, 125548], [15, 126268], [18, 126843], [27, 127901], [30, 128083], [36, 128483], [41, 128963], [44, 129083], [48, 129203], [55, 129663], [58, 129763]]}, {"verse": 20, "start": 130845, "end": 136841, "text": "La caña cascada no quebrará, y la mecha que humea no apagará, hasta que saque a victoria el juicio.", "words": [[0, 130845], [3, 130983], [8, 131303], [16, 131863], [19, 132043], [29, 132603], [31, 132758], [34, 132898], [40, 133158], [44, 133338], [50, 133718], [53, 133878], [62, 134458], [68, 134918], [72, 135098], [78, 135438], [80, 135518], [89, 135958], [92, 136058]]}, {"verse": 21, "start": 137191, "end": 139720, "text": "Y en su nombre esperarán los Gentiles.", "words": [[0, 137191], [2, 137316], [5, 137396], [8, 137576], [15, 138176], [25, 138796], [29, 138896]]}, {"verse": 22, "start": 140000, "end": 148825, "text": "Entonces fue traído a él un endemoniado, ciego y mudo, y le sanó; de tal manera, que el ciego y mudo hablaba y veía.", "words": [[0, 140000], [9, 140546], [13, 141061], [20, 141561], [22, 141701], [25, 141881], [28, 142201], [41, 143481], [47, 143881], [49, 144021], [55, 144421], [57, 144601], [60, 144721], [66, 145492], [69, 145638], [73, 145858], [81, 146318], [85, 146598], [88, 146738], [94, 147138], [96, 147278], [101, 147658], [109, 148098], [111, 148218]]}, {"verse": 23, "start": 149175, "end": 154265, "text": "Y toda la gente estaba atónita y decía: ¿Será este aquel Hijo de David?", "words": [[0, 149175], [2, 149284], [7, 149464], [10, 149704], [16, 150004], [23, 150424], [31, 151364], [33, 151664], [40, 152529], [46, 152888], [51, 153168], [57, 153508], [62, 153688], [65, 153848]]}, {"verse": 24, "start": 154545, "end": 162761, "text": "Pero los fariseos, al oírlo, decían: Este no echa fuera los demonios, sino por Beelzebú, príncipe de los demonios.", "words": [[0, 154545], [5, 154689], [9, 154909], [19, 155689], [22, 155869], [29, 156449], [37, 157669], [42, 157893], [45, 158113], [50, 158313], [56, 158513], [60, 158753], [70, 159593], [75, 159893], [79, 160463], [89, 161033], [98, 161673], [101, 161833], [105, 161973]]}, {"verse": 25, "start": 163041, "end": 175185, "text": "Y Jesús, como sabía los pensamientos de ellos, les dijo: Todo reino dividido contra sí mismo, es desolado; y toda ciudad o casa dividida contra sí misma, no permanecerá.", "words": [[0, 163041], [2, 163155], [9, 163735], [14, 163855], [20, 164255], [24, 164395], [37, 165035], [40, 165255], [47, 165655], [51, 165755], [57, 166474], [62, 166653], [68, 167313], [77, 167953], [84, 168253], [87, 168513], [94, 168833], [97, 169073], [107, 170203], [109, 170323], [114, 170483], [121, 170823], [123, 171123], [128, 171403], [137, 172083], [144, 172403], [147, 172643], [154, 173043], [157, 173563]]}, {"verse": 26, "start": 175535, "end": 183115, "text": "Y si Satanás echa fuera a Satanás, contra sí mismo está dividido; ¿cómo, pues, permanecerá su reino?", "words": [[0, 175535], [2, 175641], [5, 175761], [13, 176421], [18, 176761], [24, 177021], [26, 177261], [35, 178021], [42, 178821], [45, 179101], [51, 179441], [56, 179721], [66, 180681], [73, 180879], [79, 181415], [91, 182235], [94, 182475]]}, {"verse": 27, "start": 183465, "end": 192067, "text": "Y si yo por Beelzebú echo fuera los demonios, ¿vuestros hijos por quién los echan? Por tanto, ellos serán vuestros jueces.", "words": [[0, 183493], [2, 183613], [5, 183753], [8, 184062], [12, 184542], [21, 185022], [26, 185502], [32, 185842], [36, 186062], [46, 187002], [56, 187502], [62, 187782], [66, 188162], [72, 188482], [76, 188742], [83, 189712], [87, 189836], [94, 190176], [100, 190576], [106, 191076], [115, 191376]]}, {"verse": 28, "start": 192417, "end": 198906, "text": "Y si por espíritu de Dios yo echo fuera los demonios, ciertamente ha llegado a vosotros el reino de Dios.", "words": [[0, 192417], [2, 192547], [5, 192627], [9, 192867], [18, 193467], [21, 193567], [26, 194207], [29, 194387], [34, 194567], [40, 194867], [44, 195087], [54, 195907], [66, 196587], [69, 196727], [77, 197107], [79, 197207], [88, 197537], [91, 197867], [97, 198247], [100, 198387]]}, {"verse": 29, "start": 199256, "end": 209827, "text": "Porque, ¿cómo puede alguno entrar en la casa del hombre fuerte, y saquear sus bienes, si primero no ata al hombre fuerte? y entonces saqueará su casa.", "words": [[0, 199256], [8, 199498], [14, 199798], [20, 200118], [27, 200598], [34, 200918], [37, 201138], [40, 201278], [45, 201558], [49, 201758], [56, 202058], [64, 202558], [66, 202878], [74, 203458], [78, 203658], [86, 204318], [89, 204638], [97, 205118], [100, 205438], [104, 205778], [107, 206018], [114, 206298], [122, 207345], [124, 207490], [133, 207970], [142, 209050], [145, 209210]]}, {"verse": 30, "start": 210177, "end": 215423, "text": "El que no es conmigo, contra mí es; y el que conmigo no recoge, derrama.", "words": [[0, 210177], [3, 210316], [7, 210456], [10, 210616], [13, 210716], [22, 211356], [29, 211776], [32, 212096], [36, 212828], [38, 212933], [41, 213033], [45, 213153], [53, 213633], [56, 213793], [64, 214608]]}, {"verse": 31, "start": 215773, "end": 224735, "text": "Por tanto os digo: Todo pecado y blasfemia será perdonado a los hombres: pero la blasfemia contra el Espíritu no será perdonada a los hombres.", "words": [[0, 215773], [4, 215958], [10, 216178], [13, 216398], [19, 217090], [24, 217234], [31, 217774], [33, 217854], [43, 218474], [48, 218754], [58, 219394], [60, 219494], [64, 219614], [73, 220459], [78, 220584], [81, 220764], [91, 221424], [98, 221784], [101, 222044], [110, 222664], [113, 222764], [118, 223024], [128, 223724], [130, 223884], [134, 223984]]}, {"verse": 32, "start": 225085, "end": 237426, "text": "Y cualquiera que hable contra el Hijo del hombre, le será perdonado: pero cualquiera que hable contra el Espíritu Santo, no le será perdonado, ni en este siglo, ni en el venidero.", "words": [[0, 225085], [2, 225255], [13, 225835], [17, 226035], [23, 226355], [30, 226735], [33, 226995], [38, 227275], [42, 227455], [50, 227855], [53, 228180], [58, 228460], [69, 229539], [74, 229683], [85, 230203], [89, 230403], [95, 230783], [102, 231103], [105, 231303], [114, 231843], [121, 232203], [124, 232863], [127, 233003], [132, 233263], [143, 234503], [146, 234763], [149, 234943], [154, 235563], [161, 236183], [164, 236283], [167, 236463], [170, 236603]]}, {"verse": 33, "start": 237776, "end": 246564, "text": "O haced el árbol bueno, y su fruto bueno, o haced el árbol malo y su fruto malo; porque por el fruto es conocido el árbol.", "words": [[0, 237776], [2, 237916], [8, 238436], [11, 238736], [17, 239136], [24, 239536], [26, 239801], [29, 239981], [35, 240361], [42, 240741], [44, 241246], [50, 241726], [53, 241986], [59, 242346], [64, 242846], [66, 243006], [69, 243166], [75, 243486], [81, 244319], [88, 244503], [92, 244743], [95, 244883], [101, 245263], [104, 245343], [113, 245863], [116, 245983]]}, {"verse": 34, "start": 246914, "end": 254553, "text": "Generación de víboras, ¿cómo podéis hablar bien, siendo malos? porque de la abundancia del corazón habla la boca.", "words": [[0, 246914], [11, 247561], [14, 247761], [23, 248401], [29, 248821], [36, 249301], [43, 249641], [49, 249981], [56, 250361], [63, 251455], [70, 251720], [73, 251900], [76, 252060], [87, 252800], [91, 252980], [99, 253440], [105, 253860], [108, 254020]]}, {"verse": 35, "start": 254903, "end": 262598, "text": "El hombre bueno del buen tesoro del corazón saca buenas cosas: y el hombre malo del mal tesoro saca malas cosas.", "words": [[0, 254903], [3, 255046], [10, 255306], [16, 255666], [20, 255926], [25, 256166], [32, 256666], [36, 256806], [44, 257246], [49, 257746], [56, 257926], [63, 258995], [65, 259120], [68, 259280], [75, 259520], [80, 260000], [84, 260180], [88, 260480], [95, 261030], [100, 261580], [106, 261900]]}, {"verse": 36, "start": 262948, "end": 269797, "text": "Pero yo os digo, que toda palabra ociosa que hablen los hombres, de ella darán cuenta en el día del juicio.", "words": [[0, 262948], [5, 263128], [8, 263258], [11, 263388], [17, 263768], [21, 264123], [26, 264403], [34, 264843], [41, 265523], [45, 265723], [52, 266023], [56, 266203], [65, 266603], [68, 267243], [73, 267483], [79, 267963], [86, 268323], [89, 268523], [92, 268663], [96, 268863], [100, 269083]]}, {"verse": 37, "start": 270147, "end": 275727, "text": "Porque por tus palabras serás justificado, y por tus palabras serás condenado.", "words": [[0, 270147], [7, 270406], [11, 270666], [15, 270866], [24, 271396], [30, 271926], [43, 273086], [45, 273426], [49, 273626], [53, 273786], [62, 274216], [68, 274646]]}, {"verse": 38, "start": 276077, "end": 283916, "text": "Entonces respondieron algunos de los escribas y de los fariseos, diciendo: Maestro, deseamos ver de ti señal.", "words": [[0, 276077], [9, 276623], [22, 277923], [30, 278203], [33, 278383], [37, 278543], [46, 279183], [48, 279323], [51, 279443], [55, 279563], [65, 280363], [75, 281673], [84, 282293], [93, 282713], [97, 282993], [100, 283173], [103, 283333]]}, {"verse": 39, "start": 284196, "end": 294928, "text": "Y él respondió, y les dijo: La generación mala y adúltera demanda señal; pero señal no le será dada, sino la señal de Jonás profeta.", "words": [[0, 284196], [2, 284360], [5, 284480], [16, 285220], [18, 285680], [22, 285820], [28, 286639], [31, 286762], [42, 287422], [47, 287802], [49, 288062], [58, 288602], [66, 289202], [73, 290099], [78, 290390], [84, 291050], [87, 291550], [90, 291750], [95, 292050], [101, 292690], [106, 292890], [109, 293110], [115, 293610], [118, 293730], [124, 294030]]}, {"verse": 40, "start": 295278, "end": 306958, "text": "Porque como estuvo Jonás en el vientre del gran pez tres días y tres noches, así estará el Hijo del hombre en el corazón de la tierra tres días y tres noches.", "words": [[0, 295278], [7, 295560], [12, 295860], [19, 296240], [25, 296600], [28, 296880], [31, 297020], [39, 297460], [43, 297620], [48, 297920], [52, 298525], [57, 298765], [62, 299145], [64, 299385], [69, 299605], [77, 300570], [81, 300945], [88, 301485], [91, 301705], [96, 302005], [100, 302225], [107, 302565], [110, 302885], [113, 303025], [121, 303545], [124, 303805], [127, 303905], [134, 304245], [139, 305005], [144, 305565], [146, 305985], [151, 306225]]}, {"verse": 41, "start": 307308, "end": 320086, "text": "Los hombres de Nínive se levantarán en el juicio con esta generación, y la condenarán; porque ellos se arrepintieron a la predicación de Jonás; y aquí hay alguien más grande que Jonás.", "words": [[0, 307308], [4, 307432], [12, 307852], [15, 308262], [22, 308672], [25, 308772], [36, 309492], [39, 309592], [42, 309732], [49, 310112], [53, 310372], [58, 310592], [70, 311352], [72, 311872], [75, 311992], [87, 313280], [94, 313526], [100, 313886], [103, 314476], [117, 315066], [119, 315206], [122, 315286], [134, 316246], [137, 316386], [144, 317249], [146, 317459], [151, 317699], [155, 318079], [163, 318439], [167, 318719], [174, 319159], [178, 319399]]}, {"verse": 42, "start": 320436, "end": 334512, "text": "La reina del Sur se levantará en el juicio con esta generación, y la condenará; porque vino de los fines de la tierra para oír la sabiduría de Salomón: y aquí hay alguien más grande que Salomón.", "words": [[0, 320436], [3, 320557], [9, 320937], [13, 321117], [17, 321497], [20, 321797], [30, 322437], [33, 322597], [36, 322717], [43, 323117], [47, 323377], [52, 323597], [64, 324357], [66, 325037], [69, 325177], [80, 326304], [87, 326512], [92, 326812], [95, 326972], [99, 327112], [105, 327392], [108, 327552], [111, 327672], [118, 328052], [123, 328352], [127, 328912], [130, 329312], [140, 330072], [143, 330192], [152, 331260], [154, 331458], [159, 331758], [163, 332318], [171, 332818], [175, 333118], [182, 333538], [186, 333718]]}, {"verse": 43, "start": 334862, "end": 341996, "text": "Cuando el espíritu inmundo ha salido del hombre, anda por lugares secos, buscando reposo, y no lo halla.", "words": [[0, 334862], [7, 335063], [10, 335243], [19, 336003], [27, 336443], [30, 336583], [37, 337003], [41, 337203], [49, 337923], [54, 338383], [58, 338643], [66, 338983], [73, 339883], [82, 340303], [90, 341043], [92, 341203], [95, 341343], [98, 341698]]}, {"verse": 44, "start": 342346, "end": 350268, "text": "Entonces dice: Me volveré a mi casa de donde salí: y cuando viene, la halla desocupada, barrida y adornada.", "words": [[0, 342346], [9, 342810], [15, 343776], [18, 343921], [26, 344481], [28, 344561], [31, 344701], [36, 345061], [39, 345301], [45, 345541], [51, 346421], [53, 346528], [60, 346748], [67, 347528], [70, 347848], [76, 348088], [88, 348988], [96, 349408], [98, 349548]]}, {"verse": 45, "start": 350618, "end": 367211, "text": "Entonces va, y toma consigo otros siete espíritus peores que él, y entrados, moran allí; y son peores las cosas últimas del tal hombre que las primeras: así también acontecerá a esta generación mala.", "words": [[0, 350630], [9, 351522], [13, 351822], [15, 352242], [20, 352542], [28, 353082], [34, 353542], [40, 354042], [50, 354802], [57, 355342], [61, 355622], [65, 356442], [67, 356702], [77, 357382], [83, 357982], [89, 358647], [91, 358766], [95, 358946], [102, 359546], [106, 360126], [112, 360466], [120, 361266], [124, 361546], [128, 361806], [135, 362146], [139, 362366], [143, 362546], [153, 363545], [157, 363970], [165, 364450], [176, 365490], [178, 365670], [183, 365910], [194, 366630]]}, {"verse": 46, "start": 367561, "end": 374757, "text": "Y estando él aún hablando a la gente, he aquí su madre y sus hermanos estaban fuera, que le querían hablar.", "words": [[0, 367561], [2, 367687], [10, 368147], [13, 368487], [17, 368747], [26, 369107], [28, 369287], [31, 369347], [38, 369817], [41, 370287], [46, 370487], [49, 370707], [55, 371107], [57, 371367], [61, 371547], [70, 372147], [78, 372467], [85, 372907], [89, 373427], [92, 373567], [100, 374027]]}, {"verse": 47, "start": 375107, "end": 379688, "text": "Y le dijo uno: He aquí tu madre y tus hermanos están fuera, que te quieren hablar.", "words": [[0, 375107], [2, 375233], [5, 375333], [10, 375693], [15, 376468], [18, 376608], [23, 376768], [26, 376948], [32, 377228], [34, 377408], [38, 377528], [47, 377968], [53, 378188], [60, 378568], [64, 378808], [67, 378968], [75, 379208]]}, {"verse": 48, "start": 379968, "end": 386200, "text": "Y respondiendo él al que le decía esto, dijo: ¿Quién es mi madre y quiénes son mis hermanos?", "words": [[0, 379968], [2, 380077], [15, 380897], [18, 381177], [21, 381417], [25, 381557], [28, 381717], [34, 382097], [40, 382457], [46, 383205], [53, 383451], [56, 383531], [59, 383671], [65, 384071], [67, 384631], [75, 385031], [79, 385191], [83, 385371]]}, {"verse": 49, "start": 386550, "end": 392703, "text": "Y extendiendo su mano hacia sus discípulos, dijo: He aquí mi madre y mis hermanos.", "words": [[0, 386550], [2, 386750], [14, 387550], [17, 387710], [22, 388090], [28, 388530], [32, 388910], [44, 389770], [50, 390600], [53, 390680], [58, 390880], [61, 391100], [67, 391500], [69, 391780], [73, 391960]]}, {"verse": 50, "start": 393053, "end": 401453, "text": "Porque todo aquel que hace la voluntad de mi Padre que está en los cielos, ese es mi hermano, y hermana, y madre.", "words": [[0, 393053], [7, 393277], [12, 393577], [18, 394077], [22, 394217], [27, 394477], [30, 394677], [39, 395257], [42, 395397], [45, 395537], [51, 395877], [55, 396117], [60, 396297], [63, 396437], [67, 396557], [75, 397777], [79, 398077], [82, 398237], [85, 398397], [94, 399297], [96, 399477], [105, 400137], [107, 400702]]}]}