{"book": "MAT", "chapter": 12, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 401445, "verses": [{"verse": 1, "start": 300, "end": 10014, "text": "En aquel tiempo iba Jesús por los sembrados en sábado; y sus discípulos tenían hambre, y comenzaron a arrancar espigas, y a comer.", "words": [[0, 300], [3, 455], [9, 755], [16, 1095], [20, 1455], [26, 1895], [30, 2435], [34, 2635], [44, 3375], [47, 3575], [55, 4469], [57, 4754], [61, 4914], [72, 5514], [79, 5894], [87, 6614], [89, 7134], [100, 7754], [102, 7954], [111, 8494], [120, 9194], [122, 9394], [124, 9534]]}, {"verse": 2, "start": 10364, "end": 16822, "text": "Y viéndolo los fariseos, le dijeron: He aquí tus discípulos hacen lo que no es lícito hacer en sábado.", "words": [[0, 10364], [2, 10564], [11, 11044], [15, 11244], [25, 11904], [28, 12044], [37, 13071], [40, 13161], [45, 13381], [49, 13661], [60, 14261], [66, 14681], [69, 14881], [73, 15021], [76, 15221], [79, 15361], [86, 15781], [92, 16081], [95, 16261]]}, {"verse": 3, "start": 17102, "end": 23468, "text": "Y él les dijo: ¿No habéis leído qué hizo David, teniendo él hambre y los que con él estaban:", "words": [[0, 17102], [2, 17270], [5, 17410], [9, 17610], [15, 18402], [19, 18589], [26, 18989], [32, 19369], [36, 19569], [41, 19849], [48, 20529], [57, 21069], [60, 21249], [67, 21829], [69, 22229], [73, 22349], [77, 22509], [81, 22689], [84, 22809]]}, {"verse": 4, "start": 23818, "end": 34333, "text": "Cómo entró en la casa de Dios, y comió los panes consagrados, que no le era lícito comer, ni a los que estaban con él, sino a solos los sacerdotes?", "words": [[0, 23818], [5, 24022], [11, 24442], [14, 24562], [17, 24682], [22, 24942], [25, 25182], [31, 25502], [33, 25782], [39, 26242], [43, 26422], [49, 26862], [62, 27982], [66, 28062], [69, 28282], [72, 28482], [76, 28682], [83, 29162], [90, 30102], [93, 30222], [95, 30302], [99, 30422], [103, 30562], [111, 30842], [115, 31202], [119, 31742], [124, 31982], [126, 32342], [132, 32942], [136, 33282]]}, {"verse": 5, "start": 34683, "end": 42291, "text": "O ¿no habéis leído en la ley, que los sábados en el templo los sacerdotes profanan el sábado, y son sin culpa?", "words": [[0, 34683], [2, 34789], [6, 34909], [13, 35249], [19, 35669], [22, 35809], [25, 35929], [30, 36209], [34, 36469], [38, 36649], [46, 37149], [49, 37349], [52, 37509], [59, 38049], [63, 38189], [74, 38989], [83, 39889], [86, 40109], [94, 40749], [96, 41109], [100, 41309], [104, 41549]]}, {"verse": 6, "start": 42641, "end": 45493, "text": "Pues os digo que uno mayor que el templo está aquí.", "words": [[0, 42641], [5, 42763], [8, 42903], [13, 43143], [17, 43363], [21, 43523], [27, 43943], [31, 44143], [34, 44283], [41, 44763], [46, 44923]]}, {"verse": 7, "start": 45843, "end": 52648, "text": "Pero si supieseis qué es: Misericordia quiero y no sacrificio, no condenaríais a los inocentes:", "words": [[0, 45843], [5, 45989], [8, 46189], [18, 46829], [22, 47089], [26, 48440], [39, 48770], [46, 49100], [48, 49200], [51, 49320], [63, 50300], [66, 50840], [79, 51380], [81, 51500], [85, 51660]]}, {"verse": 8, "start": 52648, "end": 55769, "text": "Porque Señor es del sábado el Hijo del hombre.", "words": [[0, 52648], [7, 52928], [13, 53328], [16, 53708], [20, 53908], [27, 54508], [30, 54768], [35, 55048], [39, 55228]]}, {"verse": 9, "start": 56119, "end": 60107, "text": "Y partiéndose de allí, vino a la sinagoga de ellos.", "words": [[0, 56119], [2, 56346], [14, 57026], [17, 57226], [23, 57986], [28, 58426], [30, 58686], [33, 58746], [42, 59326], [45, 59526]]}, {"verse": 10, "start": 60457, "end": 69851, "text": "Y he aquí había allí uno que tenía una mano atrofiada: y le preguntaron, diciendo: ¿Es lícito curar en sábado? por acusarle.", "words": [[0, 60457], [2, 60531], [5, 60641], [10, 61081], [16, 61521], [21, 61941], [25, 62341], [29, 62541], [35, 62861], [39, 63161], [44, 63481], [55, 64644], [57, 64732], [60, 64832], [73, 65572], [83, 66972], [87, 67140], [94, 67480], [100, 67880], [103, 68000], [111, 68844], [115, 69366]]}, {"verse": 11, "start": 70201, "end": 79688, "text": "Y él les dijo: ¿Qué hombre habrá de vosotros, que tenga una oveja, y si esta cae en una fosa en sábado, no le eche mano, y la levante?", "words": [[0, 70201], [2, 70369], [5, 70509], [9, 70709], [15, 71501], [20, 71625], [27, 72005], [33, 72365], [36, 72465], [46, 73065], [50, 73505], [56, 73825], [60, 74045], [67, 74885], [69, 74965], [72, 75065], [77, 75335], [81, 75605], [84, 75745], [88, 75905], [93, 76225], [96, 76405], [104, 77385], [107, 77485], [110, 77645], [115, 77925], [121, 78305], [123, 78635], [126, 78965]]}, {"verse": 12, "start": 80038, "end": 85635, "text": "Pues ¿cuánto más vale un hombre que una oveja? Así que, lícito es en los sábados hacer bien.", "words": [[0, 80038], [5, 80038], [13, 80599], [17, 80759], [22, 81039], [25, 81239], [32, 81479], [36, 81699], [40, 81879], [47, 82748], [51, 83072], [56, 83452], [63, 83832], [66, 84032], [69, 84192], [73, 84332], [81, 84832], [87, 85092]]}, {"verse": 13, "start": 85985, "end": 94156, "text": "Entonces dijo a aquel hombre: Extiende tu mano. Y él la extendió, y fue restaurada sana como la otra.", "words": [[0, 85985], [9, 86415], [14, 86615], [16, 86815], [22, 87175], [30, 87914], [39, 88439], [42, 88599], [48, 89375], [50, 89551], [53, 89771], [56, 90031], [66, 91111], [68, 91691], [72, 91891], [83, 92671], [88, 93051], [93, 93391], [96, 93591]]}, {"verse": 14, "start": 94506, "end": 99095, "text": "Y salidos los fariseos, consultaron contra él para destruirle.", "words": [[0, 94506], [2, 94773], [10, 95233], [14, 95433], [24, 96113], [36, 96913], [43, 97273], [46, 97533], [51, 97773]]}, {"verse": 15, "start": 99445, "end": 105896, "text": "Pero sabiéndolo Jesús, se apartó de allí: y le siguió mucha gente, y sanaba a todos.", "words": [[0, 99445], [5, 99786], [16, 100406], [23, 100826], [26, 101346], [33, 101946], [36, 102126], [42, 102917], [44, 103041], [47, 103181], [54, 103601], [60, 103821], [67, 104341], [69, 104556], [76, 105016], [78, 105216]]}, {"verse": 16, "start": 106246, "end": 109984, "text": "Y él les ordenaba estrictamente que no le descubriesen:", "words": [[0, 106246], [2, 106389], [5, 106529], [9, 106809], [18, 107509], [32, 108429], [36, 108589], [39, 108749], [42, 108889]]}, {"verse": 17, "start": 110334, "end": 114659, "text": "Para que se cumpliese lo que estaba dicho por el profeta Isaías, que dijo:", "words": [[0, 110334], [5, 110552], [9, 110672], [12, 110812], [22, 111472], [25, 111652], [29, 111772], [36, 112012], [42, 112352], [46, 112632], [49, 112752], [57, 113272], [65, 113852], [69, 114132]]}, {"verse": 18, "start": 114859, "end": 124400, "text": "He aquí mi siervo, al cual he escogido; mi Amado, en el cual se agrada mi alma: pondré mi Espíritu sobre él, y a los Gentiles anunciará juicio.", "words": [[0, 114905], [3, 114985], [8, 115225], [11, 115385], [19, 116185], [22, 116285], [27, 116465], [30, 116685], [40, 117846], [43, 117982], [50, 118422], [53, 118662], [56, 118722], [61, 118962], [64, 119182], [71, 119482], [74, 119662], [80, 120561], [87, 120880], [90, 121000], [99, 121520], [105, 121760], [109, 122020], [111, 122340], [113, 122420], [117, 122520], [126, 123060], [136, 123760]]}, {"verse": 19, "start": 124982, "end": 129855, "text": "No contenderá, ni voceará: ni nadie oirá en las calles su voz.", "words": [[0, 124982], [3, 125140], [15, 125860], [18, 126435], [27, 127493], [30, 127675], [36, 128075], [41, 128555], [44, 128675], [48, 128795], [55, 129255], [58, 129355]]}, {"verse": 20, "start": 130437, "end": 136210, "text": "La caña cascada no quebrará, y la mecha que humea no apagará, hasta que saque a victoria el juicio.", "words": [[0, 130437], [3, 130575], [8, 130895], [16, 131455], [19, 131635], [29, 132195], [31, 132350], [34, 132490], [40, 132750], [44, 132930], [50, 133310], [53, 133470], [62, 134050], [68, 134510], [72, 134690], [78, 135030], [80, 135110], [89, 135550], [92, 135650]]}, {"verse": 21, "start": 136783, "end": 139028, "text": "Y en su nombre esperarán los Gentiles.", "words": [[0, 136783], [2, 136908], [5, 136988], [8, 137168], [15, 137768], [25, 138388], [29, 138488]]}, {"verse": 22, "start": 139592, "end": 148417, "text": "Entonces fue traído a él un endemoniado, ciego y mudo, y le sanó; de tal manera, que el ciego y mudo hablaba y veía.", "words": [[0, 139592], [9, 140138], [13, 140653], [20, 141153], [22, 141293], [25, 141473], [28, 141793], [41, 143073], [47, 143473], [49, 143613], [55, 144013], [57, 144193], [60, 144313], [66, 145084], [69, 145230], [73, 145450], [81, 145910], [85, 146190], [88, 146330], [94, 146730], [96, 146870], [101, 147250], [109, 147690], [111, 147810]]}, {"verse": 23, "start": 148767, "end": 153857, "text": "Y toda la gente estaba atónita y decía: ¿Será este aquel Hijo de David?", "words": [[0, 148767], [2, 148876], [7, 149056], [10, 149296], [16, 149596], [23, 150016], [31, 150956], [33, 151256], [40, 152121], [46, 152480], [51, 152760], [57, 153100], [62, 153280], [65, 153440]]}, {"verse": 24, "start": 154137, "end": 162353, "text": "Pero los fariseos, al oírlo, decían: Este no echa fuera los demonios, sino por Beelzebú, príncipe de los demonios.", "words": [[0, 154137], [5, 154281], [9, 154501], [19, 155281], [22, 155461], [29, 156041], [37, 157261], [42, 157485], [45, 157705], [50, 157905], [56, 158105], [60, 158345], [70, 159185], [75, 159485], [79, 160055], [89, 160625], [98, 161265], [101, 161425], [105, 161565]]}, {"verse": 25, "start": 162633, "end": 174776, "text": "Y Jesús, como sabía los pensamientos de ellos, les dijo: Todo reino dividido contra sí mismo, es desolado; y toda ciudad o casa dividida contra sí misma, no permanecerá.", "words": [[0, 162633], [2, 162746], [9, 163326], [14, 163446], [20, 163846], [24, 163986], [37, 164626], [40, 164846], [47, 165246], [51, 165346], [57, 166065], [62, 166245], [68, 166905], [77, 167545], [84, 167845], [87, 168105], [94, 168425], [97, 168665], [107, 169795], [109, 169915], [114, 170075], [121, 170415], [123, 170715], [128, 170995], [137, 171675], [144, 171995], [147, 172235], [154, 172635], [157, 173155]]}, {"verse": 26, "start": 175126, "end": 182707, "text": "Y si Satanás echa fuera a Satanás, contra sí mismo está dividido; ¿cómo, pues, permanecerá su reino?", "words": [[0, 175126], [2, 175233], [5, 175353], [13, 176013], [18, 176353], [24, 176613], [26, 176853], [35, 177613], [42, 178413], [45, 178693], [51, 179033], [56, 179313], [66, 180273], [73, 180471], [79, 181007], [91, 181827], [94, 182067]]}, {"verse": 27, "start": 183057, "end": 191659, "text": "Y si yo por Beelzebú echo fuera los demonios, ¿vuestros hijos por quién los echan? Por tanto, ellos serán vuestros jueces.", "words": [[0, 183085], [2, 183205], [5, 183345], [8, 183654], [12, 184134], [21, 184614], [26, 185094], [32, 185434], [36, 185654], [46, 186594], [56, 187094], [62, 187374], [66, 187754], [72, 188074], [76, 188334], [83, 189304], [87, 189428], [94, 189768], [100, 190168], [106, 190668], [115, 190968]]}, {"verse": 28, "start": 192009, "end": 198498, "text": "Y si por espíritu de Dios yo echo fuera los demonios, ciertamente ha llegado a vosotros el reino de Dios.", "words": [[0, 192009], [2, 192138], [5, 192218], [9, 192458], [18, 193058], [21, 193158], [26, 193798], [29, 193978], [34, 194158], [40, 194458], [44, 194678], [54, 195498], [66, 196178], [69, 196318], [77, 196698], [79, 196798], [88, 197128], [91, 197458], [97, 197838], [100, 197978]]}, {"verse": 29, "start": 198848, "end": 209419, "text": "Porque, ¿cómo puede alguno entrar en la casa del hombre fuerte, y saquear sus bienes, si primero no ata al hombre fuerte? y entonces saqueará su casa.", "words": [[0, 198848], [8, 199090], [14, 199390], [20, 199710], [27, 200190], [34, 200510], [37, 200730], [40, 200870], [45, 201150], [49, 201350], [56, 201650], [64, 202150], [66, 202470], [74, 203050], [78, 203250], [86, 203910], [89, 204230], [97, 204710], [100, 205030], [104, 205370], [107, 205610], [114, 205890], [122, 206937], [124, 207082], [133, 207562], [142, 208642], [145, 208802]]}, {"verse": 30, "start": 209769, "end": 215015, "text": "El que no es conmigo, contra mí es; y el que conmigo no recoge, derrama.", "words": [[0, 209769], [3, 209907], [7, 210047], [10, 210207], [13, 210307], [22, 210947], [29, 211367], [32, 211687], [36, 212420], [38, 212525], [41, 212625], [45, 212745], [53, 213225], [56, 213385], [64, 214200]]}, {"verse": 31, "start": 215365, "end": 224327, "text": "Por tanto os digo: Todo pecado y blasfemia será perdonado a los hombres: pero la blasfemia contra el Espíritu no será perdonada a los hombres.", "words": [[0, 215365], [4, 215550], [10, 215770], [13, 215990], [19, 216682], [24, 216826], [31, 217366], [33, 217446], [43, 218066], [48, 218346], [58, 218986], [60, 219086], [64, 219206], [73, 220051], [78, 220176], [81, 220356], [91, 221016], [98, 221376], [101, 221636], [110, 222256], [113, 222356], [118, 222616], [128, 223316], [130, 223476], [134, 223576]]}, {"verse": 32, "start": 224677, "end": 237018, "text": "Y cualquiera que hable contra el Hijo del hombre, le será perdonado: pero cualquiera que hable contra el Espíritu Santo, no le será perdonado, ni en este siglo, ni en el venidero.", "words": [[0, 224677], [2, 224847], [13, 225427], [17, 225627], [23, 225947], [30, 226327], [33, 226587], [38, 226867], [42, 227047], [50, 227447], [53, 227772], [58, 228052], [69, 229131], [74, 229275], [85, 229795], [89, 229995], [95, 230375], [102, 230695], [105, 230895], [114, 231435], [121, 231795], [124, 232455], [127, 232595], [132, 232855], [143, 234095], [146, 234355], [149, 234535], [154, 235155], [161, 235775], [164, 235875], [167, 236055], [170, 236195]]}, {"verse": 33, "start": 237368, "end": 246156, "text": "O haced el árbol bueno, y su fruto bueno, o haced el árbol malo y su fruto malo; porque por el fruto es conocido el árbol.", "words": [[0, 237368], [2, 237508], [8, 238028], [11, 238328], [17, 238728], [24, 239128], [26, 239393], [29, 239573], [35, 239953], [42, 240333], [44, 240838], [50, 241318], [53, 241578], [59, 241938], [64, 242438], [66, 242598], [69, 242758], [75, 243078], [81, 243911], [88, 244095], [92, 244335], [95, 244475], [101, 244855], [104, 244935], [113, 245455], [116, 245575]]}, {"verse": 34, "start": 246506, "end": 254145, "text": "Generación de víboras, ¿cómo podéis hablar bien, siendo malos? porque de la abundancia del corazón habla la boca.", "words": [[0, 246506], [11, 247153], [14, 247353], [23, 247993], [29, 248413], [36, 248893], [43, 249233], [49, 249573], [56, 249953], [63, 251047], [70, 251312], [73, 251492], [76, 251652], [87, 252392], [91, 252572], [99, 253032], [105, 253452], [108, 253612]]}, {"verse": 35, "start": 254495, "end": 262189, "text": "El hombre bueno del buen tesoro del corazón saca buenas cosas: y el hombre malo del mal tesoro saca malas cosas.", "words": [[0, 254495], [3, 254638], [10, 254898], [16, 255258], [20, 255518], [25, 255758], [32, 256258], [36, 256398], [44, 256838], [49, 257338], [56, 257518], [63, 258587], [65, 258712], [68, 258872], [75, 259112], [80, 259592], [84, 259772], [88, 260072], [95, 260622], [100, 261172], [106, 261492]]}, {"verse": 36, "start": 262539, "end": 269388, "text": "Pero yo os digo, que toda palabra ociosa que hablen los hombres, de ella darán cuenta en el día del juicio.", "words": [[0, 262539], [5, 262719], [8, 262849], [11, 262979], [17, 263359], [21, 263714], [26, 263994], [34, 264434], [41, 265114], [45, 265314], [52, 265614], [56, 265794], [65, 266194], [68, 266834], [73, 267074], [79, 267554], [86, 267914], [89, 268114], [92, 268254], [96, 268454], [100, 268674]]}, {"verse": 37, "start": 269738, "end": 275319, "text": "Porque por tus palabras serás justificado, y por tus palabras serás condenado.", "words": [[0, 269738], [7, 269998], [11, 270258], [15, 270458], [24, 270988], [30, 271518], [43, 272678], [45, 273018], [49, 273218], [53, 273378], [62, 273808], [68, 274238]]}, {"verse": 38, "start": 275669, "end": 283508, "text": "Entonces respondieron algunos de los escribas y de los fariseos, diciendo: Maestro, deseamos ver de ti señal.", "words": [[0, 275669], [9, 276215], [22, 277515], [30, 277795], [33, 277975], [37, 278135], [46, 278775], [48, 278915], [51, 279035], [55, 279155], [65, 279955], [75, 281265], [84, 281885], [93, 282305], [97, 282585], [100, 282765], [103, 282925]]}, {"verse": 39, "start": 283788, "end": 294519, "text": "Y él respondió, y les dijo: La generación mala y adúltera demanda señal; pero señal no le será dada, sino la señal de Jonás profeta.", "words": [[0, 283788], [2, 283951], [5, 284071], [16, 284811], [18, 285271], [22, 285411], [28, 286231], [31, 286354], [42, 287014], [47, 287394], [49, 287654], [58, 288194], [66, 288794], [73, 289691], [78, 289982], [84, 290642], [87, 291142], [90, 291342], [95, 291642], [101, 292282], [106, 292482], [109, 292702], [115, 293202], [118, 293322], [124, 293622]]}, {"verse": 40, "start": 294869, "end": 306549, "text": "Porque como estuvo Jonás en el vientre del gran pez tres días y tres noches, así estará el Hijo del hombre en el corazón de la tierra tres días y tres noches.", "words": [[0, 294869], [7, 295152], [12, 295452], [19, 295832], [25, 296192], [28, 296472], [31, 296612], [39, 297052], [43, 297212], [48, 297512], [52, 298117], [57, 298357], [62, 298737], [64, 298977], [69, 299197], [77, 300162], [81, 300537], [88, 301077], [91, 301297], [96, 301597], [100, 301817], [107, 302157], [110, 302477], [113, 302617], [121, 303137], [124, 303397], [127, 303497], [134, 303837], [139, 304597], [144, 305157], [146, 305577], [151, 305817]]}, {"verse": 41, "start": 306899, "end": 319678, "text": "Los hombres de Nínive se levantarán en el juicio con esta generación, y la condenarán; porque ellos se arrepintieron a la predicación de Jonás; y aquí hay alguien más grande que Jonás.", "words": [[0, 306899], [4, 307024], [12, 307444], [15, 307854], [22, 308264], [25, 308364], [36, 309084], [39, 309184], [42, 309324], [49, 309704], [53, 309964], [58, 310184], [70, 310944], [72, 311464], [75, 311584], [87, 312872], [94, 313118], [100, 313478], [103, 314068], [117, 314658], [119, 314798], [122, 314878], [134, 315838], [137, 315978], [144, 316841], [146, 317051], [151, 317291], [155, 317671], [163, 318031], [167, 318311], [174, 318751], [178, 318991]]}, {"verse": 42, "start": 320028, "end": 334104, "text": "La reina del Sur se levantará en el juicio con esta generación, y la condenará; porque vino de los fines de la tierra para oír la sabiduría de Salomón: y aquí hay alguien más grande que Salomón.", "words": [[0, 320028], [3, 320149], [9, 320529], [13, 320709], [17, 321089], [20, 321389], [30, 322029], [33, 322189], [36, 322309], [43, 322709], [47, 322969], [52, 323189], [64, 323949], [66, 324629], [69, 324769], [80, 325896], [87, 326104], [92, 326404], [95, 326564], [99, 326704], [105, 326984], [108, 327144], [111, 327264], [118, 327644], [123, 327944], [127, 328504], [130, 328904], [140, 329664], [143, 329784], [152, 330851], [154, 331050], [159, 331350], [163, 331910], [171, 332410], [175, 332710], [182, 333130], [186, 333310]]}, {"verse": 43, "start": 334454, "end": 341588, "text": "Cuando el espíritu inmundo ha salido del hombre, anda por lugares secos, buscando reposo, y no lo halla.", "words": [[0, 334454], [7, 334655], [10, 334835], [19, 335595], [27, 336035], [30, 336175], [37, 336595], [41, 336795], [49, 337515], [54, 337975], [58, 338235], [66, 338575], [73, 339475], [82, 339895], [90, 340635], [92, 340795], [95, 340935], [98, 341290]]}, {"verse": 44, "start": 341938, "end": 349860, "text": "Entonces dice: Me volveré a mi casa de donde salí: y cuando viene, la halla desocupada, barrida y adornada.", "words": [[0, 341938], [9, 342402], [15, 343367], [18, 343513], [26, 344073], [28, 344153], [31, 344293], [36, 344653], [39, 344893], [45, 345133], [51, 346013], [53, 346120], [60, 346340], [67, 347120], [70, 347440], [76, 347680], [88, 348580], [96, 349000], [98, 349140]]}, {"verse": 45, "start": 350210, "end": 366803, "text": "Entonces va, y toma consigo otros siete espíritus peores que él, y entrados, moran allí; y son peores las cosas últimas del tal hombre que las primeras: así también acontecerá a esta generación mala.", "words": [[0, 350222], [9, 351114], [13, 351414], [15, 351834], [20, 352134], [28, 352674], [34, 353134], [40, 353634], [50, 354394], [57, 354934], [61, 355214], [65, 356034], [67, 356294], [77, 356974], [83, 357574], [89, 358239], [91, 358358], [95, 358538], [102, 359138], [106, 359718], [112, 360058], [120, 360858], [124, 361138], [128, 361398], [135, 361738], [139, 361958], [143, 362138], [153, 363137], [157, 363562], [165, 364042], [176, 365082], [178, 365262], [183, 365502], [194, 366222]]}, {"verse": 46, "start": 367153, "end": 374349, "text": "Y estando él aún hablando a la gente, he aquí su madre y sus hermanos estaban fuera, que le querían hablar.", "words": [[0, 367153], [2, 367279], [10, 367739], [13, 368079], [17, 368339], [26, 368699], [28, 368879], [31, 368939], [38, 369409], [41, 369879], [46, 370079], [49, 370299], [55, 370699], [57, 370959], [61, 371139], [70, 371739], [78, 372059], [85, 372499], [89, 373019], [92, 373159], [100, 373619]]}, {"verse": 47, "start": 374699, "end": 379280, "text": "Y le dijo uno: He aquí tu madre y tus hermanos están fuera, que te quieren hablar.", "words": [[0, 374699], [2, 374825], [5, 374925], [10, 375285], [15, 376060], [18, 376200], [23, 376360], [26, 376540], [32, 376820], [34, 377000], [38, 377120], [47, 377560], [53, 377780], [60, 378160], [64, 378400], [67, 378560], [75, 378800]]}, {"verse": 48, "start": 379560, "end": 385792, "text": "Y respondiendo él al que le decía esto, dijo: ¿Quién es mi madre y quiénes son mis hermanos?", "words": [[0, 379560], [2, 379669], [15, 380489], [18, 380769], [21, 381009], [25, 381149], [28, 381309], [34, 381689], [40, 382049], [46, 382796], [53, 383043], [56, 383123], [59, 383263], [65, 383663], [67, 384223], [75, 384623], [79, 384783], [83, 384963]]}, {"verse": 49, "start": 386142, "end": 392295, "text": "Y extendiendo su mano hacia sus discípulos, dijo: He aquí mi madre y mis hermanos.", "words": [[0, 386142], [2, 386342], [14, 387142], [17, 387302], [22, 387682], [28, 388122], [32, 388502], [44, 389362], [50, 390192], [53, 390272], [58, 390472], [61, 390692], [67, 391092], [69, 391372], [73, 391552]]}, {"verse": 50, "start": 392645, "end": 401045, "text": "Porque todo aquel que hace la voluntad de mi Padre que está en los cielos, ese es mi hermano, y hermana, y madre.", "words": [[0, 392645], [7, 392869], [12, 393169], [18, 393669], [22, 393809], [27, 394069], [30, 394269], [39, 394849], [42, 394989], [45, 395129], [51, 395469], [55, 395709], [60, 395889], [63, 396029], [67, 396149], [75, 397369], [79, 397669], [82, 397829], [85, 397989], [94, 398889], [96, 399069], [105, 399729], [107, 400294]]}]}