{"book": "ACT", "chapter": 8, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 329556, "verses": [{"verse": 1, "start": 300, "end": 14649, "text": "Y Saulo consentía en su muerte. Y en aquel día se hizo una grande persecución en la iglesia que estaba en Jerusalén; y todos fueron esparcidos por las tierras de Judea y de Samaria, salvo los apóstoles.", "words": [[0, 300], [2, 424], [8, 924], [18, 2004], [21, 2164], [24, 2364], [32, 3305], [34, 3447], [37, 3547], [43, 3927], [47, 4127], [50, 4387], [55, 4767], [59, 5107], [66, 5547], [78, 6527], [81, 6687], [84, 6847], [92, 7327], [96, 7567], [103, 7927], [106, 8167], [117, 9326], [119, 9450], [125, 9730], [132, 10110], [143, 10890], [147, 11150], [151, 11330], [159, 11770], [162, 11890], [168, 12410], [170, 12490], [173, 12650], [182, 13170], [188, 13570], [192, 13710]]}, {"verse": 2, "start": 14999, "end": 21271, "text": "Y llevaron a enterrar a Esteban varones piadosos, e hicieron gran llanto sobre él.", "words": [[0, 14999], [2, 15123], [11, 15583], [13, 15703], [22, 16323], [24, 16503], [32, 17103], [40, 17763], [50, 18923], [52, 19023], [61, 19523], [66, 19903], [73, 20503], [79, 20823]]}, {"verse": 3, "start": 21621, "end": 30270, "text": "Entonces Saulo asolaba la iglesia, entrando por las casas: y arrastrando a hombres y mujeres, los entregaba en la cárcel.", "words": [[0, 21621], [9, 22186], [15, 22906], [23, 23566], [26, 23746], [35, 24266], [44, 24926], [48, 25146], [52, 25366], [59, 26206], [61, 26315], [73, 27055], [75, 27235], [83, 27575], [85, 27775], [94, 28295], [98, 28695], [108, 29335], [111, 29455], [114, 29595]]}, {"verse": 4, "start": 30620, "end": 35277, "text": "Pero los que fueron esparcidos, iban por todas partes anunciando la palabra.", "words": [[0, 30620], [5, 30746], [9, 30926], [13, 31066], [20, 31326], [32, 32026], [37, 32526], [41, 32746], [47, 32946], [54, 33466], [65, 34406], [68, 34566]]}, {"verse": 5, "start": 35627, "end": 41840, "text": "Entonces Felipe, descendiendo a la ciudad de Samaria, les predicaba a Cristo.", "words": [[0, 35627], [9, 36728], [17, 37128], [30, 38068], [32, 38168], [35, 38228], [42, 38548], [45, 38868], [54, 39428], [58, 39988], [68, 40868], [70, 41148]]}, {"verse": 6, "start": 42190, "end": 49886, "text": "Y la gente, unánime, escuchaba atentamente las cosas que decía Felipe, oyendo y viendo las señales que hacía.", "words": [[0, 42190], [2, 42276], [5, 42376], [12, 42676], [21, 43316], [31, 44476], [43, 45256], [47, 45456], [53, 45796], [57, 46016], [63, 46376], [71, 47376], [78, 47836], [80, 48096], [87, 48436], [91, 48676], [99, 49236], [103, 49396]]}, {"verse": 7, "start": 50236, "end": 58737, "text": "Porque de muchos que tenían espíritus inmundos, salían estos dando grandes voces; y muchos paralíticos y cojos eran sanados:", "words": [[0, 50236], [7, 50417], [10, 50617], [17, 50897], [21, 51177], [28, 51517], [38, 52157], [48, 52897], [55, 53324], [61, 53750], [67, 54177], [75, 54517], [82, 55506], [84, 55633], [91, 55893], [103, 56913], [105, 57203], [111, 57493], [116, 57733]]}, {"verse": 8, "start": 59087, "end": 61540, "text": "Así que había gran gozo en aquella ciudad.", "words": [[0, 59087], [4, 59282], [8, 59482], [14, 59662], [19, 59942], [24, 60342], [27, 60482], [35, 60842]]}, {"verse": 9, "start": 61890, "end": 73174, "text": "Y había un hombre llamado Simón, el cual había practicado antes la magia en aquella ciudad, y había engañado la gente de Samaria, diciéndose ser algún grande:", "words": [[0, 61890], [2, 62012], [8, 62212], [11, 62472], [18, 62732], [26, 63052], [33, 64172], [36, 64472], [41, 64732], [47, 65172], [58, 65992], [64, 66492], [67, 66912], [73, 67412], [76, 67532], [84, 67872], [92, 68232], [94, 68787], [100, 68947], [109, 69567], [112, 69687], [118, 69947], [121, 70187], [130, 70727], [141, 71847], [145, 72117], [151, 72387]]}, {"verse": 10, "start": 73524, "end": 81836, "text": "Al cual oían todos atentamente desde el más pequeño hasta el más grande, diciendo: Este es el gran poder de Dios.", "words": [[0, 73589], [3, 73689], [8, 73949], [13, 74489], [19, 74869], [31, 75889], [37, 76129], [40, 76349], [44, 76509], [52, 77089], [58, 77689], [61, 77849], [65, 78029], [73, 78966], [83, 80037], [88, 80303], [91, 80483], [94, 80623], [99, 80783], [105, 81103], [108, 81303]]}, {"verse": 11, "start": 82116, "end": 88426, "text": "Y le estaban atentos, porque con sus artes mágicas los había engañado mucho tiempo.", "words": [[0, 82116], [2, 82259], [5, 82379], [13, 82819], [22, 84179], [29, 84639], [33, 84939], [37, 85159], [43, 85699], [51, 86339], [55, 86479], [61, 86819], [70, 87399], [76, 87679]]}, {"verse": 12, "start": 88776, "end": 99353, "text": "Pero cuando creyeron a Felipe, que anunciaba el evangelio del reino de Dios y el nombre de Jesucristo, se bautizaban hombres y mujeres.", "words": [[0, 88776], [5, 88919], [12, 89259], [21, 89979], [23, 90059], [31, 91059], [35, 91119], [45, 91839], [48, 91999], [58, 92719], [62, 92899], [68, 93279], [71, 93439], [76, 93819], [78, 94379], [81, 94499], [88, 94919], [91, 95699], [103, 96479], [106, 96859], [117, 97639], [125, 98119], [127, 98519]]}, {"verse": 13, "start": 99703, "end": 110427, "text": "El mismo Simón creyó también entonces, y bautizándose, se llegó a Felipe: y viendo los milagros y grandes maravillas que se hacían, estaba atónito.", "words": [[0, 99703], [3, 99829], [9, 100149], [15, 100749], [21, 101189], [29, 101529], [39, 102329], [41, 102764], [55, 103544], [58, 104324], [64, 104604], [66, 104784], [74, 105572], [76, 105698], [83, 105978], [87, 106198], [96, 106778], [98, 106898], [106, 107218], [117, 107878], [121, 108058], [124, 108198], [132, 109038], [139, 109538]]}, {"verse": 14, "start": 110777, "end": 120313, "text": "Y los apóstoles que estaban en Jerusalén, habiendo oído que Samaria había recibido la palabra de Dios, les enviaron a Pedro y a Juan:", "words": [[0, 110777], [2, 110902], [6, 111022], [16, 111742], [20, 112002], [28, 112382], [31, 112622], [42, 113862], [51, 114402], [56, 114742], [60, 114962], [68, 115502], [74, 115822], [83, 116562], [86, 116702], [94, 117022], [97, 117262], [103, 117942], [107, 118082], [116, 118822], [118, 118962], [124, 119402], [126, 119642], [128, 119722]]}, {"verse": 15, "start": 120663, "end": 125742, "text": "Los cuales venidos, oraron por ellos, para que recibiesen el Espíritu Santo;", "words": [[0, 120663], [4, 120789], [11, 121029], [20, 121589], [27, 122169], [31, 122409], [38, 122689], [43, 123209], [47, 123389], [58, 124169], [61, 124469], [70, 125049]]}, {"verse": 16, "start": 126092, "end": 133819, "text": "(Porque aún no había descendido sobre ninguno de ellos, sino que solamente habían sido bautizados en el nombre de Jesús.)", "words": [[0, 126092], [8, 126295], [12, 126635], [15, 126895], [21, 127365], [32, 127835], [38, 128095], [46, 128635], [49, 128795], [56, 129495], [61, 129675], [65, 129855], [75, 130235], [82, 130655], [87, 131015], [98, 132175], [101, 132415], [104, 132575], [111, 132955], [114, 133155]]}, {"verse": 17, "start": 134169, "end": 139124, "text": "Entonces les impusieron las manos, y recibieron el Espíritu Santo.", "words": [[0, 134169], [9, 134713], [13, 135273], [24, 135953], [28, 136153], [35, 136593], [37, 136928], [48, 137648], [51, 137828], [60, 138428]]}, {"verse": 18, "start": 139474, "end": 147116, "text": "Y cuando vio Simón que por la imposición de las manos de los apóstoles se daba el Espíritu Santo, les ofreció dinero,", "words": [[0, 139474], [2, 139729], [9, 139969], [13, 140269], [19, 140929], [23, 141009], [27, 141209], [30, 141389], [41, 142169], [44, 142329], [48, 142449], [54, 142709], [57, 142869], [61, 142969], [71, 143462], [74, 143956], [79, 144449], [82, 144589], [91, 145109], [98, 145869], [102, 145949], [110, 146529]]}, {"verse": 19, "start": 147466, "end": 155429, "text": "Diciendo: Dadme también a mí esta potestad, que a cualquiera que ponga las manos encima, reciba el Espíritu Santo.", "words": [[0, 147466], [10, 148636], [16, 149055], [24, 149455], [26, 149615], [29, 149815], [34, 150195], [44, 150935], [48, 151315], [50, 151395], [61, 151895], [65, 152055], [71, 152395], [75, 152535], [81, 152795], [89, 153375], [96, 154275], [99, 154395], [108, 154915]]}, {"verse": 20, "start": 155709, "end": 162091, "text": "Entonces Pedro le dijo: Tu dinero perezca contigo, que piensas que el don de Dios se gane por dinero.", "words": [[0, 155709], [9, 156207], [15, 156907], [18, 157187], [24, 157898], [27, 157996], [34, 158296], [42, 158836], [51, 159636], [55, 159716], [63, 160176], [67, 160336], [70, 160436], [74, 160596], [77, 160736], [82, 160956], [85, 161156], [90, 161376], [94, 161536]]}, {"verse": 21, "start": 162441, "end": 168059, "text": "No tienes tú parte ni suerte en este asunto; porque tu corazón no es recto delante de Dios.", "words": [[0, 162441], [3, 162562], [10, 162862], [13, 163042], [19, 163362], [22, 163622], [29, 164042], [32, 164182], [37, 164362], [45, 165209], [52, 165410], [55, 165570], [63, 165990], [66, 166510], [69, 166690], [75, 167110], [83, 167450], [86, 167570]]}, {"verse": 22, "start": 168409, "end": 175212, "text": "Arrepiéntete pues de esta tu maldad, y ruega a Dios, si quizás te será perdonado el pensamiento de tu corazón.", "words": [[0, 168756], [13, 169106], [18, 169366], [21, 169586], [26, 169826], [29, 170046], [37, 170506], [39, 170806], [45, 171166], [47, 171286], [53, 172046], [56, 172126], [63, 172606], [66, 172726], [71, 172966], [81, 173586], [84, 173686], [96, 174246], [99, 174426], [102, 174546]]}, {"verse": 23, "start": 175562, "end": 179049, "text": "Porque en hiel de amargura y en prisión de maldad veo que estás.", "words": [[0, 175562], [7, 175795], [10, 176035], [15, 176235], [18, 176355], [27, 176875], [29, 177015], [32, 177115], [40, 177495], [43, 177595], [50, 178015], [54, 178275], [58, 178475]]}, {"verse": 24, "start": 179329, "end": 188070, "text": "Respondiendo entonces Simón, dijo: Rogad vosotros por mí al Señor, que ninguna cosa de estas que habéis dicho, venga sobre mí.", "words": [[0, 179329], [13, 179933], [22, 180373], [29, 181093], [35, 182227], [41, 182626], [50, 183106], [54, 183366], [57, 183566], [60, 183726], [67, 184426], [71, 184666], [79, 184966], [84, 185406], [87, 185626], [93, 186006], [97, 186106], [104, 186406], [111, 186786], [117, 187466], [123, 187706]]}, {"verse": 25, "start": 188350, "end": 198798, "text": "Y ellos, habiendo testificado y hablado la palabra de Dios, se volvieron a Jerusalén, y en muchas aldeas de los samaritanos anunciaron el evangelio.", "words": [[0, 188350], [2, 188539], [9, 188999], [18, 189379], [30, 190379], [32, 190519], [40, 190959], [43, 191119], [51, 191519], [54, 191779], [60, 192759], [63, 193019], [73, 193539], [75, 193719], [86, 194479], [88, 195019], [91, 195159], [98, 195419], [105, 196059], [108, 196159], [112, 196279], [124, 197039], [135, 197699], [138, 197959]]}, {"verse": 26, "start": 199148, "end": 208920, "text": "Pero el ángel del Señor habló a Felipe, diciendo: Levántate y ve hacia el sur, al camino que desciende de Jerusalén a Gaza, el cual es desierto.", "words": [[0, 199148], [5, 199312], [8, 199472], [14, 199852], [18, 200012], [24, 200372], [30, 200912], [32, 201012], [40, 201832], [50, 202762], [60, 203421], [62, 203701], [65, 203861], [71, 204101], [74, 204361], [79, 205001], [82, 205161], [89, 205481], [93, 205701], [103, 206201], [106, 206381], [116, 206961], [118, 207061], [124, 207801], [127, 207881], [132, 208081], [135, 208261]]}, {"verse": 27, "start": 209200, "end": 225408, "text": "Entonces él se levantó, y fue: y he aquí un etíope, eunuco, alto funcionario de Candace, reina de los etíopes, el cual estaba encargado de todos sus tesoros, y había venido a adorar a Jerusalén,", "words": [[0, 209200], [9, 209688], [12, 210328], [15, 210648], [24, 211508], [26, 211848], [31, 212477], [33, 212686], [36, 212826], [41, 213126], [44, 213366], [52, 214226], [60, 215146], [65, 215486], [77, 216386], [80, 216546], [89, 217406], [95, 218266], [98, 218406], [102, 218546], [111, 219726], [114, 219886], [119, 220086], [126, 220446], [136, 221166], [139, 221346], [145, 221606], [149, 221926], [158, 222826], [160, 223006], [166, 223186], [173, 223686], [175, 223926], [182, 224346], [184, 224506]]}, {"verse": 28, "start": 225758, "end": 230410, "text": "Se volvía sentado en su carro, y leyendo el profeta Isaías.", "words": [[0, 225758], [3, 225961], [10, 226441], [18, 227041], [21, 227181], [24, 227321], [31, 227721], [33, 228281], [41, 228881], [44, 229021], [52, 229521]]}, {"verse": 29, "start": 230760, "end": 235597, "text": "Y el Espíritu dijo a Felipe: Acércate y ve junto a este carro.", "words": [[0, 230760], [2, 230926], [5, 231026], [14, 231606], [19, 231826], [21, 232046], [29, 232829], [38, 233533], [40, 233893], [43, 234053], [49, 234293], [51, 234573], [56, 234753]]}, {"verse": 30, "start": 235877, "end": 242514, "text": "Y acudiendo Felipe, le oyó que leía el profeta Isaías, y dijo: Pero ¿entiendes lo que lees?", "words": [[0, 235877], [2, 236037], [12, 236677], [20, 237297], [23, 237917], [27, 238237], [31, 238397], [36, 238857], [39, 239037], [47, 239577], [55, 240197], [57, 240417], [63, 241131], [68, 241270], [79, 241830], [82, 241930], [86, 242250]]}, {"verse": 31, "start": 242794, "end": 250006, "text": "Y él dijo: ¿Y cómo podré, si alguno no me enseña? Y rogó a Felipe que subiese, y se sentase con él.", "words": [[0, 242794], [2, 242982], [5, 243142], [11, 243861], [14, 243984], [19, 244224], [26, 244704], [29, 244844], [36, 245284], [39, 245404], [42, 245524], [50, 246360], [52, 246481], [57, 247041], [59, 247181], [66, 247521], [70, 247761], [79, 248361], [81, 248606], [84, 248746], [92, 249306], [96, 249606]]}, {"verse": 32, "start": 250356, "end": 261092, "text": "Y el lugar de la Escritura que leía, era este: Como oveja a la muerte fue llevado; y como cordero mudo delante del que lo esquila, así no abrió su boca:", "words": [[0, 250356], [2, 250494], [5, 250594], [11, 250874], [14, 251134], [17, 251254], [27, 251754], [31, 251874], [37, 252334], [41, 252594], [47, 253461], [52, 253825], [58, 254225], [60, 254625], [63, 254725], [70, 255045], [74, 255325], [83, 256252], [85, 256356], [90, 256596], [98, 257156], [103, 257536], [111, 257976], [115, 258156], [119, 258316], [122, 258476], [131, 259416], [135, 259676], [138, 259976], [144, 260336], [147, 260516]]}, {"verse": 33, "start": 261442, "end": 269903, "text": "En su humillación su juicio fue quitado: pero su generación, ¿quién la contará? porque es quitada de la tierra su vida.", "words": [[0, 261442], [3, 261589], [6, 261829], [18, 262649], [21, 262709], [28, 263089], [32, 263329], [41, 264254], [46, 264377], [49, 264637], [61, 265877], [68, 266157], [71, 266317], [80, 267506], [87, 267696], [90, 267856], [98, 268376], [101, 268536], [104, 268656], [111, 269016], [114, 269336]]}, {"verse": 34, "start": 270253, "end": 277968, "text": "Y respondiendo el eunuco a Felipe, dijo: Te ruego ¿de quién el profeta dice esto? ¿de sí, o de otro alguno?", "words": [[0, 270253], [2, 270361], [15, 271221], [18, 271631], [25, 272041], [27, 272141], [35, 272961], [41, 273714], [44, 273852], [50, 274212], [54, 274412], [60, 274612], [63, 274812], [71, 275292], [76, 275552], [82, 276334], [86, 276475], [90, 276775], [92, 277015], [95, 277135], [100, 277355]]}, {"verse": 35, "start": 278248, "end": 286238, "text": "Entonces Felipe, abriendo su boca, y comenzando desde esta escritura, le anunció el evangelio de Jesús.", "words": [[0, 278248], [9, 279405], [17, 279805], [26, 280325], [29, 280525], [35, 280925], [37, 281210], [48, 282130], [54, 282350], [59, 282750], [70, 283710], [73, 283790], [81, 284590], [84, 284710], [94, 285430], [97, 285550]]}, {"verse": 36, "start": 286588, "end": 295180, "text": "Y yendo por el camino, llegaron a cierta agua; y dijo el eunuco: He aquí agua; ¿qué impide que yo sea bautizado?", "words": [[0, 286588], [2, 286886], [8, 287186], [12, 287426], [15, 287566], [23, 288086], [32, 288926], [34, 289106], [41, 289566], [47, 290474], [49, 290577], [54, 290897], [57, 291511], [65, 292313], [68, 292393], [73, 292593], [79, 293377], [84, 293475], [91, 293895], [95, 294055], [98, 294195], [102, 294375]]}, {"verse": 37, "start": 295460, "end": 304289, "text": "Y Felipe dijo: Si crees de todo corazón, bien puedes. Y respondiendo, dijo: Creo que Jesucristo es el Hijo de Dios.", "words": [[0, 295460], [2, 295587], [9, 295967], [15, 296815], [18, 296976], [24, 297336], [27, 297436], [32, 297656], [41, 298476], [46, 298636], [54, 299598], [56, 299725], [70, 300565], [76, 301705], [81, 301903], [85, 302123], [96, 302903], [99, 303203], [102, 303363], [107, 303583], [110, 303743]]}, {"verse": 38, "start": 304569, "end": 311606, "text": "Y mandó parar el carro: y descendieron ambos al agua, Felipe y el eunuco; y le bautizó.", "words": [[0, 304569], [2, 304713], [8, 305033], [14, 305273], [17, 305778], [24, 306449], [26, 306555], [39, 307175], [45, 307475], [48, 307755], [54, 308515], [61, 308975], [63, 309475], [66, 309635], [74, 310628], [76, 310772], [79, 311211]]}, {"verse": 39, "start": 311956, "end": 320684, "text": "Y como subieron del agua, el Espíritu del Señor arrebató a Felipe; y no le vio más el eunuco, y se fue por su camino gozoso.", "words": [[0, 311956], [2, 312043], [7, 312243], [16, 312703], [20, 312903], [26, 313583], [29, 313683], [38, 314223], [42, 314343], [48, 314683], [57, 315443], [59, 315543], [67, 316470], [69, 316599], [72, 316739], [75, 316879], [79, 317099], [83, 317319], [86, 317759], [94, 318199], [96, 318819], [99, 318959], [103, 319119], [107, 319339], [110, 319499], [117, 319819]]}, {"verse": 40, "start": 321034, "end": 329156, "text": "Pero Felipe se halló en Azoto: y pasando, anunciaba el evangelio en todas las ciudades, hasta que llegó a Cesarea.", "words": [[0, 321034], [5, 321179], [12, 321559], [15, 321829], [21, 322099], [24, 322465], [31, 323008], [33, 323164], [42, 323664], [52, 324964], [55, 325124], [65, 325744], [68, 325904], [74, 326164], [78, 326464], [88, 327464], [94, 327744], [98, 327924], [104, 328184], [106, 328384]]}]}