{"book": "ISA", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 187488, "verses": [{"verse": 1, "start": 300, "end": 6537, "text": "Y saldrá una vara del tronco de Isaí, y un vástago retoñará de sus raíces.", "words": [[0, 300], [2, 448], [9, 888], [13, 1048], [18, 1288], [22, 1488], [29, 2028], [32, 2168], [38, 3048], [40, 3348], [43, 3488], [51, 4338], [60, 5188], [63, 5328], [67, 5528]]}, {"verse": 2, "start": 6987, "end": 19192, "text": "Y reposará sobre él el espíritu de Jehová; espíritu de sabiduría y de inteligencia, espíritu de consejo y de fortaleza, espíritu de conocimiento y de temor de Jehová.", "words": [[0, 6987], [2, 7412], [11, 7872], [17, 8212], [20, 8612], [23, 8952], [32, 9592], [35, 9692], [43, 10584], [52, 11250], [55, 11350], [65, 12070], [67, 12170], [70, 12290], [84, 13930], [93, 14410], [96, 14490], [104, 15090], [106, 15170], [109, 15250], [120, 16610], [129, 17090], [132, 17170], [145, 17890], [147, 18030], [150, 18110], [156, 18450], [159, 18570]]}, {"verse": 3, "start": 19642, "end": 29041, "text": "Y le hará entender diligente en el temor de Jehová. No juzgará según las apariencias, ni argüirá por lo que oigan sus oídos;", "words": [[0, 19642], [2, 19886], [5, 20066], [10, 20306], [19, 20936], [29, 21566], [32, 21826], [35, 22086], [41, 22346], [44, 22526], [52, 23423], [55, 23649], [63, 24349], [69, 24589], [73, 24869], [86, 26049], [89, 26499], [97, 26949], [101, 27169], [104, 27329], [108, 27529], [114, 28029], [118, 28229]]}, {"verse": 4, "start": 29491, "end": 43011, "text": "Sino que juzgará con justicia a los pobres, y argüirá con equidad por los mansos de la tierra: y herirá la tierra con la vara de su boca, y con el espíritu de sus labios matará al impío.", "words": [[0, 29491], [5, 29733], [9, 29973], [17, 30633], [21, 30833], [30, 31633], [32, 31893], [36, 31993], [44, 32533], [46, 32953], [54, 33553], [58, 33753], [66, 34213], [70, 34613], [74, 34773], [81, 35373], [84, 35493], [87, 35613], [95, 36564], [97, 36726], [104, 37146], [107, 37286], [114, 37706], [118, 38046], [121, 38246], [126, 38466], [129, 38646], [132, 38806], [138, 39146], [140, 39626], [144, 39826], [147, 39966], [156, 40646], [159, 40746], [163, 40926], [170, 41366], [177, 41926], [180, 42146]]}, {"verse": 5, "start": 43461, "end": 49546, "text": "Y será la justicia cinto de sus lomos, y la fidelidad ceñidor de sus riñones.", "words": [[0, 43461], [2, 43583], [7, 43843], [10, 44023], [19, 44663], [25, 45143], [28, 45303], [32, 45463], [39, 46023], [41, 46723], [44, 46883], [54, 47623], [62, 48283], [65, 48463], [69, 49035]]}, {"verse": 6, "start": 49996, "end": 61912, "text": "Morará el lobo con el cordero, y el tigre con el cabrito se acostará: el becerro y el león y la bestia doméstica andarán juntos, y un niño los pastoreará.", "words": [[0, 49996], [7, 50629], [10, 50929], [15, 51349], [19, 51549], [22, 51649], [31, 52329], [33, 52769], [36, 52929], [42, 53369], [46, 53509], [49, 53649], [57, 54129], [60, 54329], [70, 55398], [73, 55519], [81, 56199], [83, 56379], [86, 56539], [91, 57079], [93, 57259], [96, 57399], [103, 57859], [113, 58539], [121, 59099], [129, 59519], [131, 60079], [134, 60239], [139, 60805], [143, 61370]]}, {"verse": 7, "start": 62362, "end": 69976, "text": "La vaca y la osa pastarán, sus crías se echarán juntas; y el león como el buey comerá paja.", "words": [[0, 62362], [3, 62639], [8, 63059], [10, 63159], [13, 63279], [17, 63679], [27, 64639], [31, 64759], [37, 65279], [40, 65479], [48, 65899], [56, 67048], [58, 67204], [61, 67364], [66, 68264], [71, 68444], [74, 68724], [79, 69004], [86, 69364]]}, {"verse": 8, "start": 70426, "end": 80428, "text": "Y el niño de teta se entretendrá sobre la cueva del áspid, y el recién destetado extenderá su mano sobre la caverna del basilisco.", "words": [[0, 70426], [2, 70551], [5, 70671], [10, 70971], [13, 71191], [18, 71651], [21, 72201], [33, 72751], [39, 72971], [42, 73191], [48, 73591], [52, 73731]