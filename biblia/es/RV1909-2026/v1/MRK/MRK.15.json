{"book": "MRK", "chapter": 15, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 340552, "verses": [{"verse": 1, "start": 300, "end": 13349, "text": "Y luego por la mañana, habiendo tenido consejo los principales sacerdotes con los ancianos, y con los escribas, y con todo el concilio, llevaron a Jesús atado, y le entregaron a Pilato.", "words": [[0, 300], [2, 444], [8, 664], [12, 924], [15, 1044], [23, 2144], [32, 2644], [39, 2984], [47, 3624], [51, 3744], [63, 4464], [74, 5364], [78, 5584], [82, 5744], [92, 6404], [94, 6544], [98, 6724], [102, 6864], [112, 7664], [114, 8024], [118, 8264], [123, 8524], [126, 8684], [136, 9749], [145, 10249], [147, 10349], [153, 10609], [160, 11753], [162, 11862], [165, 11982], [176, 12662], [178, 12742]]}, {"verse": 2, "start": 13699, "end": 20441, "text": "Y Pilato le preguntó: ¿Eres tú el Rey de los judíos? Y respondiendo él, le dijo: Tú lo dices.", "words": [[0, 13699], [2, 13823], [9, 14283], [12, 14443], [22, 15384], [28, 15571], [31, 15871], [34, 16051], [38, 16271], [41, 16331], [45, 16471], [53, 17459], [55, 17585], [68, 18365], [72, 18605], [75, 18745], [81, 19466], [84, 19593], [87, 19733]]}, {"verse": 3, "start": 20791, "end": 23722, "text": "Y los principales sacerdotes le acusaban mucho.", "words": [[0, 20791], [2, 20867], [6, 20987], [18, 21787], [29, 22547], [32, 22707], [41, 23207]]}, {"verse": 4, "start": 24072, "end": 29944, "text": "Y le preguntó otra vez Pilato, diciendo: ¿No respondes algo? Mira de cuántas cosas te acusan.", "words": [[0, 24072], [2, 24159], [5, 24279], [14, 24839], [19, 25019], [23, 25259], [31, 25739], [41, 26660], [45, 26866], [55, 27426], [61, 28113], [66, 28296], [69, 28496], [77, 29236], [83, 29236], [86, 29376]]}, {"verse": 5, "start": 30224, "end": 35050, "text": "Pero Jesús ni aun con eso respondió; de modo que Pilato se maravillaba.", "words": [[0, 30224], [5, 30390], [11, 31002], [14, 31135], [18, 31375], [22, 31675], [26, 32015], [37, 32870], [40, 33015], [45, 33175], [49, 33395], [56, 33875], [59, 34075]]}, {"verse": 6, "start": 35400, "end": 39677, "text": "Pero en el día de la fiesta les soltaba un preso, el que pidiesen.", "words": [[0, 35400], [5, 35645], [8, 35785], [11, 35905], [15, 36125], [18, 36285], [21, 36425], [28, 36675], [32, 36925], [40, 37465], [43, 37645], [50, 38115], [53, 38585], [57, 39156]]}, {"verse": 7, "start": 40027, "end": 49137, "text": "Y había uno, que se llamaba Barrabás, preso con sus compañeros de motín que habían cometido asesinato durante una revuelta.", "words": [[0, 40027], [2, 40170], [8, 40330], [13, 40790], [17, 40970], [20, 41130], [28, 41670], [38, 42970], [44, 43530], [48, 43710], [52, 43910], [63, 44710], [66, 44810], [72, 45310], [76, 45770], [83, 46050], [92, 46750], [102, 47630], [110, 47950], [114, 48290]]}, {"verse": 8, "start": 49487, "end": 54824, "text": "Y viniendo la multitud, comenzó a pedir hiciese como siempre les había hecho.", "words": [[0, 49487], [2, 49633], [11, 50113], [14, 50253], [24, 50893], [32, 51793], [34, 51853], [40, 52153], [48, 52813], [53, 53073], [61, 53733], [65, 53873], [71, 54273]]}, {"verse": 9, "start": 55174, "end": 59965, "text": "Y Pilato les respondió, diciendo: ¿Queréis que os suelte al Rey de los judíos?", "words": [[0, 55174], [2, 55321], [9, 55821], [13, 56061], [24, 56741], [34, 57715], [43, 58036], [47, 58196], [50, 58336], [57, 58676], [60, 58836], [64, 59056], [67, 59116], [71, 59236]]}, {"verse": 10, "start": 60245, "end": 65371, "text": "Porque conocía que por envidia le habían entregado los principales sacerdotes.", "words": [[0, 60245], [7, 60469], [15, 61129], [19, 61269], [23, 61529], [31, 62149], [34, 62269], [41, 62609], [51, 63309], [55, 63449], [67, 64309]]}, {"verse": 11, "start": 65721, "end": 72394, "text": "Pero los principales sacerdotes incitaron a la multitud, que les soltase antes a Barrabás.", "words": [[0, 65721], [5, 66041], [9, 66221], [21, 67001], [32, 67941], [42, 68981], [44, 69081], [47, 69161], [57, 69821], [61, 70281], [65, 70461], [73, 71041], [79, 71401], [81, 71939]]}, {"verse": 12, "start": 72744, "end": 78254, "text": "Y respondiendo Pilato, les dice otra vez: ¿Qué pues queréis que haga del que llamáis Rey de los judíos?", "words": [[0, 72744], [2, 73180], [15, 73650], [23, 74110], [27, 74290], [32, 74510], [37, 74750], [42, 75470], [47, 75592], [52, 75772], [60, 76192], [64, 76352], [69, 76532], [73, 76692], [77, 76852], [85, 77232], [89, 77412], [92, 77552], [96, 77672]]}, {"verse": 13, "start": 78534, "end": 81480, "text": "Y ellos volvieron a gritar: Crucifícale.", "words": [[0, 78534], [2, 78715], [8, 79055], [18, 79695], [20, 79795], [28, 80658]]}, {"verse": 14, "start": 81760, "end": 87748, "text": "Pero Pilato les decía: ¿Pues qué mal ha hecho? Y ellos daban más voces: Crucifícale.", "words": [[0, 81760], [5, 81964], [12, 82504], [16, 82744], [23, 83757], [29, 83898], [33, 84028], [37, 84158], [40, 84453], [47, 84969], [49, 85132], [55, 85462], [61, 85792], [65, 86294], [72, 86926]]}, {"verse": 15, "start": 88028, "end": 97890, "text": "Y Pilato, queriendo satisfacer al pueblo, les soltó a Barrabás, y entregó a Jesús, después de azotarle, para que fuese crucificado.", "words": [[0, 88028], [2, 88154], [10, 88734], [20, 89234], [31, 89974], [34, 90154], [42, 91154], [46, 91294], [52, 91954], [54, 92174], [64, 92854], [66, 93354], [74, 93834], [76, 93934], [83, 94294], [91, 95034], [94, 95454], [104, 95874], [109, 96354], [113, 96494], [119, 96834]]}, {"verse": 16, "start": 98240, "end": 105700, "text": "Entonces los soldados le llevaron dentro de la sala, es decir, al Pretorio; y reunieron a toda la compañía.", "words": [[0, 98240], [9, 99256], [13, 99436], [22, 99806], [25, 100176], [34, 100576], [41, 100916], [44, 101176], [47, 101296], [53, 101676], [56, 101816], [63, 102256], [66, 102336], [76, 103280], [78, 103406], [88, 104046], [90, 104226], [95, 104466], [98, 104686]]}, {"verse": 17, "start": 106050, "end": 111099, "text": "Y le visten de púrpura; y poniéndole una corona tejida de espinas,", "words": [[0, 106050], [2, 106159], [5, 106259], [12, 106679], [15, 106899], [24, 108019], [26, 108123], [37, 108963], [41, 109163], [48, 109583], [55, 110123], [58, 110263]]}, {"verse": 18, "start": 111449, "end": 115393, "text": "Comenzaron luego a saludarle: ¡Salve, Rey de los judíos!", "words": [[0, 111449], [11, 112013], [17, 112293], [19, 112553], [30, 113666], [38, 114091], [42, 114391], [45, 114491], [49, 114611]]}, {"verse": 19, "start": 115673, "end": 122630, "text": "Y le herían en la cabeza con una caña, y escupían en él, y se arrodillaban ante él en burla.", "words": [[0, 115673], [2, 115835], [5, 115975], [12, 116455], [15, 116635], [18, 116775], [25, 117255], [29, 117535], [33, 117735], [39, 118255], [41, 118715], [50, 119335], [53, 119515], [57, 119855], [59, 120475], [62, 120635], [75, 121415], [80, 121735], [83, 121935], [86, 122035]]}, {"verse": 20, "start": 122980, "end": 132087, "text": "Y cuando se hubieron burlado de él, le quitaron el manto púrpura, y le vistieron sus propios vestidos, y le sacaron para crucificarle.", "words": [[0, 122980], [2, 123086], [9, 123306], [12, 123546], [21, 123826], [29, 124366], [32, 124586], [36, 125266], [39, 125426], [48, 125926], [51, 126066], [57, 126446], [66, 127206], [68, 127646], [71, 127746], [81, 128246], [85, 128526], [93, 129061], [103, 129641], [105, 130021], [108, 130121], [116, 130601], [121, 130861]]}, {"verse": 21, "start": 132437, "end": 141911, "text": "Y cargaron a uno que pasaba, Simón cireneo, padre de Alejandro y de Rufo, que venía del campo, para que llevase su cruz.", "words": [[0, 132437], [2, 132832], [11, 133261], [13, 133481], [17, 133662], [21, 133842], [29, 134402], [35, 135261], [44, 136122], [50, 136421], [53, 136682], [63, 137342], [65, 137562], [68, 137662], [74, 138701], [78, 138842], [84, 139316], [88, 139791], [95, 140266], [100, 140426], [104, 140706], [112, 140986], [115, 141266]]}, {"verse": 22, "start": 142261, "end": 148518, "text": "Y le llevan al lugar de Gólgota, que traducido significa: Lugar de la Calavera.", "words": [[0, 142261], [2, 142498], [5, 142758], [12, 143138], [15, 143338], [21, 143678], [24, 144238], [33, 144798], [37, 145038], [47, 145778], [58, 147053], [64, 147356], [67, 147636], [70, 147756]]}, {"verse": 23, "start": 148868, "end": 153379, "text": "Y le dieron a beber vino mezclado con mirra; pero él no lo tomó.", "words": [[0, 148868], [2, 148973], [5, 149073], [12, 149433], [14, 149573], [20, 149793], [25, 150073], [34, 150693], [38, 151164], [45, 151809], [50, 151972], [53, 152392], [56, 152732], [59, 152892]]}, {"verse": 24, "start": 153729, "end": 161289, "text": "Y cuando le hubieron crucificado, repartieron sus vestidos, echando suertes sobre ellos, qué llevaría cada uno.", "words": [[0, 153729], [2, 153837], [9, 154097], [12, 154417], [21, 154797], [34, 156117], [46, 156817], [50, 157057], [60, 158017], [68, 158427], [76, 158837], [82, 159197], [89, 159937], [93, 160037], [102, 160537], [107, 160737]]}, {"verse": 25, "start": 161639, "end": 165475, "text": "Y era la tercera hora del día cuando le crucificaron.", "words": [[0, 161639], [2, 161824], [6, 162024], [9, 162164], [17, 162804], [22, 163184], [26, 163464], [30, 163724], [37, 164024], [40, 164264]]}, {"verse": 26, "start": 165825, "end": 170629, "text": "Y el título escrito de su causa era: EL REY DE LOS JUDÍOS.", "words": [[0, 165825], [2, 165971], [5, 166111], [12, 166711], [20, 167151], [23, 167471], [26, 167631], [32, 167971], [37, 168823], [40, 169011], [44, 169411], [47, 169611], [51, 169751]]}, {"verse": 27, "start": 170979, "end": 177129, "text": "Y crucificaron con él dos ladrones, uno a su derecha, y el otro a su izquierda.", "words": [[0, 170979], [2, 171127], [15, 172047], [19, 172247], [22, 172447], [26, 172787], [36, 173947], [40, 174227], [42, 174387], [45, 174507], [54, 175207], [56, 175487], [59, 175627], [64, 175887], [66, 176107], [69, 176287]]}, {"verse": 28, "start": 177479, "end": 182138, "text": "Y se cumplió la Escritura, que dice: Y con los inicuos fue contado.", "words": [[0, 177479], [2, 177585], [5, 177705], [13, 178205], [16, 178345], [27, 178905], [31, 179085], [37, 179704], [39, 179944], [43, 180124], [47, 180524], [55, 180924], [59, 181324]]}, {"verse": 29, "start": 182488, "end": 191570, "text": "Y los que pasaban lo insultaban, meneando sus cabezas, y diciendo: ¡Ah! tú que derribas el templo de Dios, y en tres días lo edificas,", "words": [[0, 182488], [2, 182605], [6, 182745], [10, 182905], [18, 183505], [21, 183685], [33, 184925], [42, 185625], [46, 185825], [55, 186745], [57, 186925], [67, 187829], [72, 188425], [75, 188506], [79, 188606], [88, 189006], [91, 189126], [98, 189486], [101, 189546], [107, 189826], [109, 190166], [112, 190266], [117, 190426], [122, 190646], [125, 190846]]}, {"verse": 30, "start": 191920, "end": 194199, "text": "Sálvate a ti mismo, y desciende de la cruz.", "words": [[0, 191920], [8, 192289], [10, 192449], [13, 192489], [20, 192829], [22, 193229], [32, 193649], [35, 193769], [38, 193869]]}, {"verse": 31, "start": 194479, "end": 205639, "text": "Y de esta manera también los principales sacerdotes burlándose de él, decían unos a otros, con los escribas: A otros salvó, a sí mismo no se puede salvar.", "words": [[0, 194479], [2, 194646], [5, 194746], [10, 194986], [17, 195326], [25, 195766], [29, 195966], [41, 196686], [52, 197486], [63, 198381], [66, 198581], [70, 199241], [77, 199901], [82, 200206], [84, 200606], [91, 201006], [95, 201566], [99, 201786], [109, 202942], [111, 203126], [117, 203346], [124, 203806], [126, 203986], [129, 204066], [135, 204466], [138, 204626], [141, 204806], [147, 205006]]}, {"verse": 32, "start": 205989, "end": 214568, "text": "El Cristo, Rey de Israel, descienda ahora de la cruz, para que veamos y creamos. También los que estaban crucificados con él lo insultaban.", "words": [[0, 205989], [3, 206108], [11, 206448], [15, 206748], [18, 206848], [26, 207268], [36, 208128], [42, 208348], [45, 208488], [48, 208608], [54, 209148], [59, 209448], [63, 209608], [70, 210028], [72, 210328], [81, 211128], [89, 211393], [93, 211593], [97, 211733], [105, 211993], [118, 212893], [122, 213133], [125, 213333], [128, 213593]]}, {"verse": 33, "start": 214918, "end": 221640, "text": "Y cuando vino la sexta hora del día, fueron hechas tinieblas sobre toda la tierra hasta la novena hora.", "words": [[0, 214918], [2, 215002], [9, 215182], [14, 215502], [17, 215702], [23, 216122], [28, 216302], [32, 216502], [37, 216862], [44, 217382], [51, 217902], [61, 218562], [67, 219002], [72, 219342], [75, 219562], [82, 219942], [88, 220602], [91, 220802], [98, 221242]]}, {"verse": 34, "start": 221990, "end": 233081, "text": "Y a la novena hora, exclamó Jesús a gran voz, diciendo: Eloi, Eloi, ¿lama sabachthani? que declarado, quiere decir: Dios mío, Dios mío, ¿por qué me has desamparado?", "words": [[0, 221990], [2, 222153], [4, 222233], [7, 222333], [14, 222833], [20, 223133], [28, 223973], [34, 224193], [36, 224473], [41, 224633], [46, 224893], [56, 225864], [62, 226365], [68, 226866], [74, 227368], [87, 228037], [91, 228369], [102, 228739], [109, 228999], [116, 229990], [121, 230267], [126, 230787], [131, 230887], [136, 231407], [141, 231527], [145, 231707], [148, 231867], [152, 232047]]}, {"verse": 35, "start": 233431, "end": 239187, "text": "Y oyéndole unos de los que estaban allí, decían: He aquí, llama a Elías.", "words": [[0, 233431], [2, 233614], [11, 234094], [16, 234574], [19, 234794], [23, 234954], [27, 235114], [35, 235454], [41, 236314], [49, 237478], [52, 237568], [58, 237808], [64, 238208], [66, 238508]]}, {"verse": 36, "start": 239467, "end": 249659, "text": "Y corrió uno, y empapando una esponja en vinagre, y poniéndola en una caña, le dio a beber, diciendo: Dejad, veamos si vendrá Elías a quitarle.", "words": [[0, 239467], [2, 239611], [9, 240051], [14, 240451], [16, 240651], [26, 241271], [30, 241471], [38, 242151], [41, 242271], [50, 243131], [52, 243451], [63, 244131], [66, 244331], [70, 244491], [76, 245331], [79, 245491], [83, 245711], [85, 246011], [92, 246311], [102, 247463], [109, 247821], [116, 248221], [119, 248401], [126, 248681], [132, 249041], [134, 249121]]}, {"verse": 37, "start": 249939, "end": 254824, "text": "Pero Jesús, dando una grande voz, exhaló su último aliento.", "words": [[0, 249939], [5, 250083], [12, 250963], [18, 251263], [22, 251543], [29, 251883], [34, 252803], [41, 253383], [44, 253543], [51, 253983]]}, {"verse": 38, "start": 255174, "end": 260327, "text": "Entonces el velo del templo se rasgó en dos, de alto a bajo.", "words": [[0, 255174], [9, 255901], [12, 256281], [17, 256621], [21, 256781], [28, 257541], [31, 257681], [37, 258201], [40, 258381], [45, 259081], [48, 259321], [53, 259677], [55, 260033]]}, {"verse": 39, "start": 260677, "end": 270945, "text": "Y el centurión que estaba delante de él, viendo que había exhalado su último aliento dando aquel grito, dijo: Verdaderamente este hombre era el Hijo de Dios.", "words": [[0, 260677], [2, 260798], [5, 260938], [15, 261538], [19, 261698], [26, 261998], [34, 262478], [37, 262658], [41, 263018], [48, 263918], [52, 264138], [58, 264418], [67, 265158], [70, 265358], [77, 265778], [85, 266258], [91, 266598], [97, 266958], [104, 267338], [110, 268020], [125, 268899], [130, 269279], [137, 269599], [141, 269939], [144, 270119], [149, 270319], [152, 270459]]}, {"verse": 40, "start": 271225, "end": 282025, "text": "Y también estaban algunas mujeres mirando de lejos; entre las cuales estaban María Magdalena, y María la madre de Jacobo el menor y de José, y Salomé;", "words": [[0, 271225], [2, 271354], [10, 271634], [18, 272134], [26, 272434], [34, 272954], [42, 273494], [45, 273674], [52, 274550], [58, 274817], [62, 274997], [69, 275377], [77, 276137], [83, 276637], [94, 277537], [96, 277957], [102, 278297], [105, 278477], [111, 278757], [114, 279177], [121, 279597], [124, 279717], [130, 280117], [132, 280397], [135, 280497], [141, 280877], [143, 281397]]}, {"verse": 41, "start": 282375, "end": 292025, "text": "Las cuales, estando aún él en Galilea, le habían seguido, y le servían; y otras muchas que juntamente con él habían subido a Jerusalén.", "words": [[0, 282375], [4, 282520], [12, 283180], [20, 283760], [24, 283940], [27, 284340], [30, 284600], [39, 285960], [42, 286060], [49, 286280], [58, 286940], [60, 287180], [63, 287300], [72, 288120], [74, 288200], [80, 288400], [87, 288800], [91, 289020], [102, 289660], [106, 289920], [109, 290160], [116, 290560], [123, 291120], [125, 291200]]}, {"verse": 42, "start": 292375, "end": 298755, "text": "Y cuando fue la tarde, porque era la preparación, es decir, la víspera del sábado,", "words": [[0, 292375], [2, 292480], [9, 292680], [13, 292920], [16, 293060], [23, 293720], [30, 294220], [34, 294540], [37, 294700], [50, 295860], [53, 296080], [60, 297240], [63, 297380], [71, 297940], [75, 298100]]}, {"verse": 43, "start": 299105, "end": 311248, "text": "José de Arimatea, miembro respetado del Consejo, que también esperaba el reino de Dios, vino, y se presentó con valentía ante Pilato, y pidió el cuerpo de Jesús.", "words": [[0, 299105], [5, 299415], [8, 299696], [18, 300636], [26, 301095], [36, 301795], [40, 301975], [49, 303115], [53, 303215], [61, 303535], [70, 304095], [73, 304235], [79, 304615], [82, 304775], [88, 305035], [94, 306196], [96, 306436], [99, 306576], [108, 307155], [112, 307355], [121, 308235], [126, 308576], [134, 309215], [136, 309615], [142, 309956], [145, 310076], [152, 310335], [155, 310595]]}, {"verse": 44, "start": 311598, "end": 318637, "text": "Y Pilato se maravilló que ya fuese muerto; y haciendo venir al centurión, le preguntó si era ya muerto.", "words": [[0, 311598], [2, 311742], [9, 312222], [12, 312442], [22, 313022], [26, 313142], [29, 313282], [35, 313582], [43, 314407], [45, 314552], [54, 315012], [60, 315332], [63, 315552], [74, 316692], [77, 316892], [86, 317452], [89, 317632], [93, 317812], [96, 317972]]}, {"verse": 45, "start": 318987, "end": 322607, "text": "Y enterado del centurión, dio el cuerpo a José:", "words": [[0, 318987], [2, 319155], [11, 319795], [15, 320245], [26, 320695], [30, 321145], [33, 321595], [40, 321955], [42, 322155]]}, {"verse": 46, "start": 322957, "end": 335001, "text": "El cual compró una sábana, y quitándole, le envolvió en la sábana: y le puso en un sepulcro excavado en una roca; y hizo rodar una piedra a la puerta del sepulcro.", "words": [[0, 322957], [3, 323121], [8, 323301], [15, 323841], [19, 324021], [27, 324561], [29, 324721], [41, 325461], [44, 325961], [53, 326761], [56, 326921], [59, 327061], [67, 327870], [69, 327958], [72, 328058], [77, 328438], [80, 328598], [83, 328718], [92, 329438], [101, 330158], [104, 330278], [108, 330438], [114, 331341], [116, 331506], [121, 331886], [127, 332606], [131, 332746], [138, 333326], [140, 333486], [143, 333586], [150, 333886], [154, 334186]]}, {"verse": 47, "start": 335351, "end": 340152, "text": "Y María Magdalena, y María madre de José, miraban donde era puesto.", "words": [[0, 335351], [2, 335488], [8, 336068], [19, 336648], [21, 336768], [27, 337028], [33, 337428], [36, 337548], [42, 337888], [50, 338788], [56, 339108], [60, 339448]]}]}