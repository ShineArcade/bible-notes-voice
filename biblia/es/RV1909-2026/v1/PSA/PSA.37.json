{"book": "PSA", "chapter": 37, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 257048, "verses": [{"verse": 1, "start": 300, "end": 7939, "text": "Salmo de David. NO te impacientes a causa de los malignos, ni tengas envidia de los que hacen iniquidad.", "words": [[0, 300], [6, 744], [9, 904], [16, 1868], [19, 2016], [22, 2196], [34, 2856], [36, 3116], [42, 3396], [45, 3616], [49, 3756], [59, 4836], [62, 5156], [69, 5596], [77, 6256], [80, 6376], [84, 6536], [88, 6696], [94, 6996]]}, {"verse": 2, "start": 8289, "end": 13201, "text": "Porque como hierba serán pronto cortados, y decaerán como verdor de renuevo.", "words": [[0, 8289], [7, 8513], [12, 8903], [19, 9293], [25, 9633], [32, 9973], [42, 10793], [44, 11113], [53, 11693], [58, 12063], [65, 12433], [68, 12553]]}, {"verse": 3, "start": 13551, "end": 19596, "text": "Espera en Jehová, y haz bien; vivirás en la tierra, y en verdad serás alimentado.", "words": [[0, 13551], [7, 14190], [10, 14310], [18, 14730], [20, 14910], [24, 15070], [30, 15878], [38, 16323], [41, 16503], [44, 16643], [52, 17083], [54, 17583], [57, 17703], [64, 18063], [70, 18623]]}, {"verse": 4, "start": 19946, "end": 25373, "text": "Pon asimismo tu delicia en Jehová, y él te dará las peticiones de tu corazón.", "words": [[0, 19946], [4, 20428], [13, 20938], [16, 21178], [24, 21778], [27, 21958], [35, 22638], [37, 22958], [40, 23158], [43, 23338], [48, 23638], [52, 23778], [63, 24398], [66, 24578], [69, 24718]]}, {"verse": 5, "start": 25723, "end": 30292, "text": "Encomienda a Jehová tu camino, y espera en él; y él hará.", "words": [[0, 25723], [11, 26407], [13, 26667], [20, 27127], [23, 27227], [31, 27707], [33, 27962], [40, 28402], [43, 28822], [47, 29410], [49, 29570], [52, 29730]]}, {"verse": 6, "start": 30642, "end": 35773, "text": "Y exhibirá tu justicia como la luz, y tus derechos como el medio día.", "words": [[0, 30642], [2, 30932], [11, 31512], [14, 31652], [23, 32332], [28, 32552], [31, 32712], [36, 33032], [38, 33692], [42, 33872], [51, 34292], [56, 34772], [59, 35121], [65, 35470]]}, {"verse": 7, "start": 36123, "end": 44663, "text": "Calla a Jehová, y espera en él: no te alteres con motivo del que prospera en su camino, por el hombre que hace maldades.", "words": [[0, 36123], [6, 36619], [8, 36759], [16, 37279], [18, 37439], [25, 37759], [28, 38139], [32, 38756], [35, 38905], [38, 39065], [46, 39585], [50, 39765], [57, 40145], [61, 40525], [65, 40645], [74, 41305], [77, 41385], [80, 41565], [88, 42525], [92, 42665], [95, 42825], [102, 43105], [106, 43345], [111, 43585]]}, {"verse": 8, "start": 45013, "end": 51325, "text": "Déjate de la ira, y depón el enojo: no te excites en manera alguna a hacer lo malo.", "words": [[0, 45013], [7, 45561], [10, 45701], [13, 45841], [18, 46401], [20, 46601], [26, 47021], [29, 47281], [36, 48165], [39, 48292], [42, 48492], [50, 49032], [53, 49252], [60, 49532], [67, 49992], [69, 50212], [75, 50432], [78, 50652]]}, {"verse": 9, "start": 51675, "end": 58207, "text": "Porque los malignos serán destruidos, pero los que esperan en Jehová, ellos heredarán la tierra.", "words": [[0, 51675], [7, 51881], [11, 52061], [20, 52681], [26, 52981], [38, 53961], [43, 54161], [47, 54361], [51, 54561], [59, 55041], [62, 55161], [70, 55921], [76, 56321], [86, 57321], [89, 57481]]}, {"verse": 10, "start": 58557, "end": 64549, "text": "Pues de aquí a poco no será el malo: y contemplarás sobre su lugar, y no aparecerá.", "words": [[0, 58557], [5, 58700], [8, 58820], [13, 59040], [15, 59260], [20, 59480], [23, 59720], [28, 59980], [31, 60180], [37, 60833], [39, 60955], [52, 62055], [58, 62495], [61, 62795], [68, 63195], [70, 63475], [73, 63635]]}, {"verse": 11, "start": 64899, "end": 71086, "text": "Pero los mansos heredarán la tierra, y se recrearán con abundancia de paz.", "words": [[0, 64899], [5, 65199], [9, 65359], [16, 66379], [26, 67219], [29, 67379], [37, 67899], [39, 68359], [42, 68519], [52, 69399], [56, 69559], [67, 70359], [70, 70499]]}, {"verse": 12, "start": 71436, "end": 76656, "text": "Maquina el impío contra el justo, y cruje sobre él sus dientes.", "words": [[0, 71436], [8, 72021], [11, 72341], [17, 73001], [24, 73401], [27, 73601], [34, 74021], [36, 74541], [42, 75021], [48, 75321], [51, 75601], [55, 75781]]}, {"verse": 13, "start": 77006, "end": 80579, "text": "El Señor se reirá de él; porque ve que viene su día.", "words": [[0, 77006], [3, 77149], [9, 77529], [12, 77909], [18, 78289], [21, 78449], [25, 79039], [32, 79255], [35, 79435], [39, 79575], [45, 79835], [48, 80075]]}, {"verse": 14, "start": 80929, "end": 92169, "text": "Los impíos desenvainaron espada, y tensaron su arco, para derribar al pobre y al necesitado, para matar a los de recto proceder.", "words": [[0, 80929], [4, 81037], [11, 81917], [25, 82797], [33, 83397], [35, 83837], [44, 84417], [47, 84677], [53, 85117], [58, 85637], [67, 86497], [70, 86657], [76, 87717], [78, 88057], [81, 88197], [93, 89097], [98, 89537], [104, 89837], [106, 90077], [110, 90350], [113, 90624], [119, 90897]]}, {"verse": 15, "start": 92519, "end": 97975, "text": "La espada de ellos entrará en su mismo corazón, y su arco será quebrado.", "words": [[0, 92519], [3, 92665], [10, 93245], [13, 93425], [19, 93805], [27, 94685], [30, 94905], [33, 95125], [39, 95485], [48, 96025], [50, 96390], [53, 96590], [58, 96930], [63, 97190]]}, {"verse": 16, "start": 98325, "end": 102315, "text": "Mejor es lo poco del justo, que las riquezas de muchos pecadores.", "words": [[0, 98325], [6, 98652], [9, 98772], [12, 98892], [17, 99292], [21, 99692], [28, 100092], [32, 100192], [36, 100332], [45, 100912], [48, 101112], [55, 101332]]}, {"verse": 17, "start": 102315, "end": 108419, "text": "Porque los brazos de los impíos serán quebrados: mas el que sostiene a los justos es Jehová.", "words": [[0, 102315], [7, 102715], [11, 103095], [18, 103575], [21, 103715], [25, 104075], [32, 104435], [38, 104775], [49, 105817], [53, 106004], [56, 106264], [60, 106424], [69, 107004], [71, 107298], [75, 107593], [82, 107887], [85, 108181]]}, {"verse": 18, "start": 108769, "end": 113992, "text": "Conoce Jehová los días de los perfectos: y la heredad de ellos será para siempre.", "words": [[0, 108769], [7, 109194], [14, 109654], [18, 109794], [23, 110074], [26, 110274], [30, 110394], [41, 111572], [43, 111691], [46, 111831], [54, 112351], [57, 112511], [63, 112731], [68, 113011], [73, 113251]]}, {"verse": 19, "start": 114342, "end": 119890, "text": "No serán avergonzados en el mal tiempo; y en los días de hambre serán hartos.", "words": [[0, 114342], [3, 114569], [9, 115009], [22, 115909], [25, 116129], [28, 116289], [32, 116429], [40, 117364], [42, 117494], [45, 117614], [49, 117754], [54, 117994], [57, 118194], [64, 118554], [70, 118994]]}, {"verse": 20, "start": 120240, "end": 129403, "text": "Mas los impíos perecerán, y los enemigos de Jehová como la grasa de los carneros serán consumidos: se disiparán como humo.", "words": [[0, 120240], [4, 120388], [8, 120548], [15, 121288], [26, 122208], [28, 122768], [32, 122888], [41, 123408], [44, 123568], [51, 124068], [56, 124228], [59, 124388], [65, 124768], [68, 124928], [72, 125358], [81, 125788], [87, 126388], [99, 127683], [102, 127825], [112, 128565], [117, 128765]]}, {"verse": 21, "start": 129753, "end": 135151, "text": "El impío toma prestado, y no paga; mas el justo tiene misericordia, y da.", "words": [[0, 129753], [3, 129893], [9, 130453], [14, 130753], [24, 131453], [26, 131573], [29, 131693], [35, 132518], [39, 132604], [42, 132691], [48, 133191], [54, 133611], [68, 134671], [70, 134811]]}, {"verse": 22, "start": 135501, "end": 141311, "text": "Porque los benditos de él heredarán la tierra; y los malditos de él serán destruidos.", "words": [[0, 135501], [7, 135663], [11, 135863], [20, 136423], [23, 136623], [26, 136843], [36, 137543], [39, 137663], [47, 138583], [49, 138689], [53, 138829], [62, 139509], [65, 139709], [68, 139909], [74, 140329]]}, {"verse": 23, "start": 141661, "end": 146371, "text": "Por Jehová son ordenados los pasos del hombre, y aprueba su camino.", "words": [[0, 141661], [4, 141825], [11, 142345], [15, 142545], [25, 143325], [29, 143525], [35, 143985], [39, 144145], [47, 144465], [49, 144985], [57, 145485], [60, 145685]]}, {"verse": 24, "start": 146721, "end": 152194, "text": "Cuando caiga el hombre, no quedará postrado; porque Jehová sostiene su mano.", "words": [[0, 146721], [7, 146904], [13, 147484], [16, 147664], [24, 147984], [27, 148544], [35, 148984], [45, 150045], [52, 150290], [59, 150850], [68, 151390], [71, 151590]]}, {"verse": 25, "start": 152544, "end": 159666, "text": "Joven fui, y he envejecido, y no he visto justo desamparado, ni su descendencia que mendigue pan.", "words": [[0, 152544], [6, 152886], [11, 153166], [13, 153846], [16, 154006], [28, 154766], [30, 155286], [33, 155446], [36, 155526], [42, 155786], [48, 156106], [61, 156766], [64, 157426], [67, 157606], [80, 158446], [84, 158746], [93, 159046]]}, {"verse": 26, "start": 160016, "end": 165747, "text": "En todo tiempo tiene misericordia, y presta; y su descendencia es para bendición.", "words": [[0, 160016], [3, 160185], [8, 160465], [15, 160865], [21, 161205], [35, 162085], [37, 162205], [45, 163166], [47, 163426], [50, 163546], [63, 164486], [66, 164646], [71, 164866]]}, {"verse": 27, "start": 166097, "end": 169858, "text": "Apártate del mal, y haz el bien, y vivirás para siempre.", "words": [[0, 166097], [9, 166784], [13, 167004], [18, 167284], [20, 167524], [24, 167764], [27, 167924], [33, 168184], [35, 168489], [43, 168969], [48, 169169]]}, {"verse": 28, "start": 170208, "end": 180747, "text": "Porque Jehová ama la rectitud, y no desampara sus santos: para siempre serán guardados; mas la descendencia de los impíos será extirpada.", "words": [[0, 170208], [7, 170489], [14, 171089], [18, 171329], [21, 171549], [31, 172249], [33, 172789], [36, 172969], [46, 173629], [50, 173809], [58, 174837], [63, 175002], [71, 175302], [77, 175942], [88, 176983], [92, 176983], [95, 177133], [108, 177993], [111, 178113], [115, 178233], [122, 179033], [127, 179453]]}, {"verse": 29, "start": 181097, "end": 185840, "text": "Los justos heredarán la tierra, y vivirán para siempre sobre ella.", "words": [[0, 181097], [4, 181293], [11, 181893], [21, 182613], [24, 182753], [32, 183213], [34, 183733], [42, 184213], [47, 184433], [55, 184753], [61, 185253]]}, {"verse": 30, "start": 186190, "end": 190826, "text": "La boca del justo hablará sabiduría; y su lengua proferirá juicio.", "words": [[0, 186190], [3, 186319], [8, 186519], [12, 186739], [18, 187079], [26, 187599], [37, 188761], [39, 188868], [42, 189008], [49, 189508], [59, 190008]]}, {"verse": 31, "start": 191176, "end": 196807, "text": "La ley de su Dios está en su corazón; por tanto sus pasos no vacilarán.", "words": [[0, 191176], [3, 191456], [7, 191756], [10, 191936], [13, 192096], [18, 192416], [23, 192776], [26, 192936], [29, 193096], [38, 194211], [42, 194356], [48, 194656], [52, 194956], [58, 195476], [61, 195776]]}, {"verse": 32, "start": 197157, "end": 200498, "text": "Acecha el impío al justo, y procura matarlo.", "words": [[0, 197456], [7, 197796], [10, 198146], [16, 198496], [19, 198636], [26, 198996], [28, 199236], [36, 199656]]}, {"verse": 33, "start": 200498, "end": 205848, "text": "Jehová no lo dejará en sus manos, ni lo condenará cuando le juzguen.", "words": [[0, 200498], [7, 201078], [10, 201518], [13, 201638], [20, 202138], [23, 202238], [27, 202378], [34, 203358], [37, 203638], [40, 203798], [50, 204458], [57, 204678], [60, 204978]]}, {"verse": 34, "start": 206198, "end": 214985, "text": "Espera en Jehová, y guarda su camino, y él te ensalzará para heredar la tierra: cuando serán talados los pecadores, lo verás.", "words": [[0, 206401], [7, 206631], [10, 206791], [18, 207191], [20, 207271], [27, 207631], [30, 207751], [38, 208471], [40, 208791], [43, 208951], [46, 209131], [56, 209951], [61, 210211], [69, 210731], [72, 210871], [80, 211802], [87, 211965], [93, 212385], [101, 212905], [105, 213535], [116, 214165], [119, 214405]]}, {"verse": 35, "start": 215335, "end": 221620, "text": "Vi yo al impío sumamente enaltecido, y que se extendía como un laurel verde.", "words": [[0, 215530], [3, 215758], [6, 215986], [9, 216214], [15, 216442], [25, 217282], [37, 218122], [39, 218702], [43, 218862], [46, 219062], [55, 220022], [60, 220302], [63, 220502], [70, 221088]]}, {"verse": 36, "start": 221970, "end": 227655, "text": "Pero se pasó, y he aquí no aparece; y lo busqué, y no fue hallado.", "words": [[0, 221970], [5, 222135], [8, 222275], [14, 222715], [16, 223075], [19, 223435], [24, 223715], [27, 224315], [36, 225397], [38, 225512], [41, 225632], [49, 226112], [51, 226632], [54, 226772], [58, 226992]]}, {"verse": 37, "start": 228005, "end": 233881, "text": "Considera al íntegro, y mira al justo: que el final de cada uno de ellos es paz.", "words": [[0, 228005], [10, 228788], [13, 229008], [22, 229708], [24, 230288], [29, 230568], [32, 230708], [39, 231572], [43, 231676], [46, 231756], [52, 232056], [55, 232276], [60, 232416], [64, 232716], [67, 232876], [73, 233136], [76, 233356]]}, {"verse": 38, "start": 234231, "end": 240566, "text": "Mas los transgresores fueron todos a una destruidos: el final de los impíos fue talado.", "words": [[0, 234231], [4, 234517], [8, 234897], [22, 235737], [29, 236097], [35, 236390], [37, 236684], [41, 236977], [53, 238316], [56, 238576], [62, 238916], [65, 239076], [69, 239416], [76, 239756], [80, 239916]]}, {"verse": 39, "start": 240916, "end": 246811, "text": "Pero la salvación de los justos es de Jehová, y él es su fortaleza en el tiempo de angustia.", "words": [[0, 240916], [5, 241062], [8, 241222], [18, 241842], [21, 242002], [25, 242102], [32, 242622], [35, 242762], [38, 242922], [46, 243622], [48, 243862], [51, 244042], [54, 244162], [57, 244322], [67, 245122], [70, 245262], [73, 245402], [80, 245762], [83, 246022]]}, {"verse": 40, "start": 247161, "end": 256648, "text": "Y Jehová los ayudará, y los librará: y los libertará de los impíos, y los salvará, por cuanto en él esperaron.", "words": [[0, 247161], [2, 247307], [9, 247787], [13, 247907], [22, 248527], [24, 248987], [28, 249187], [37, 250362], [39, 250486], [43, 250666], [53, 251506], [56, 251626], [60, 251746], [68, 252506], [70, 253086], [74, 253226], [83, 253986], [87, 254566], [94, 255006], [97, 255246], [100, 255446]]}]}