{"book": "LUK", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 424780, "verses": [{"verse": 1, "start": 300, "end": 5637, "text": "Y como acabó todas sus palabras oyéndole el pueblo, entró en Capernaum.", "words": [[0, 300], [2, 407], [7, 647], [13, 1067], [19, 1267], [23, 1547], [32, 1927], [41, 2687], [44, 2827], [52, 3807], [58, 4507], [61, 4727]]}, {"verse": 2, "start": 5987, "end": 13457, "text": "Y el siervo de un centurión, al cual tenía él en estima, estaba enfermo y a punto de morir.", "words": [[0, 5987], [2, 6427], [5, 6567], [12, 7047], [15, 7187], [18, 7307], [29, 7997], [32, 8687], [37, 8787], [43, 9227], [46, 9647], [49, 9887], [57, 10847], [64, 11127], [72, 11927], [74, 12152], [76, 12272], [82, 12572], [85, 12852]]}, {"verse": 3, "start": 13807, "end": 21968, "text": "Y cuando oyó hablar de Jesús, envió a él los ancianos de los judíos, rogándole que viniese y librase a su siervo.", "words": [[0, 13807], [2, 13885], [9, 14165], [13, 14505], [20, 14765], [23, 14945], [30, 16025], [36, 16545], [38, 16725], [41, 16885], [45, 17065], [54, 17645], [57, 17765], [61, 17865], [69, 18635], [79, 19405], [83, 19585], [91, 20165], [93, 20505], [101, 21045], [103, 21205], [106, 21345]]}, {"verse": 4, "start": 22318, "end": 29067, "text": "Y viniendo ellos a Jesús, le rogaron con diligencia, diciéndole: Porque es digno de concederle esto;", "words": [[0, 22318], [2, 22499], [11, 22999], [17, 23259], [19, 23479], [26, 23919], [29, 24359], [37, 24899], [41, 25059], [53, 26099], [65, 27210], [72, 27442], [75, 27562], [81, 27922], [84, 27982], [95, 28642]]}, {"verse": 5, "start": 29417, "end": 32540, "text": "Que ama nuestra nación, y él nos edificó una sinagoga.", "words": [[0, 29417], [4, 29534], [8, 29694], [16, 29914], [24, 30534], [26, 30894], [29, 31014], [33, 31154], [41, 31694], [45, 31814]]}, {"verse": 6, "start": 32820, "end": 46329, "text": "Y Jesús fue con ellos. Pero como ya no estuviesen lejos de su casa, envió el centurión amigos a él, diciéndole: Señor, no te incomodes, que no soy digno que entres debajo de mi techo;", "words": [[0, 32820], [2, 32941], [8, 33301], [12, 33661], [16, 33921], [23, 34788], [28, 34972], [33, 35232], [36, 35512], [39, 35712], [50, 36332], [56, 36852], [59, 37012], [62, 37172], [68, 38052], [74, 38492], [77, 38652], [87, 39652], [94, 39892], [96, 40172], [100, 40732], [112, 41968], [119, 42527], [122, 42627], [125, 42767], [136, 43707], [140, 43947], [143, 44087], [147, 44287], [153, 44747], [157, 44847], [164, 45187], [171, 45567], [174, 45727], [177, 45787]]}, {"verse": 7, "start": 46679, "end": 52838, "text": "Por lo cual ni aun me tuve por digno de venir a ti; pero di la palabra, y mi siervo será sano.", "words": [[0, 46679], [4, 46782], [7, 46922], [12, 47222], [15, 47502], [19, 47682], [22, 47902], [27, 48182], [31, 48342], [37, 48722], [40, 48802], [46, 49022], [48, 49222], [52, 49752], [57, 49911], [60, 50111], [63, 50251], [72, 51131], [74, 51411], [77, 51571], [84, 52011], [89, 52251]]}, {"verse": 8, "start": 53188, "end": 64969, "text": "Porque también yo soy hombre puesto bajo autoridad, que tengo debajo de mí soldados; y digo a este: Ve, y va; y al otro: Ven, y viene; y a mi siervo: Haz esto, y lo hace.", "words": [[0, 53188], [7, 53365], [15, 53765], [18, 53965], [22, 54145], [29, 54425], [36, 54805], [41, 55025], [52, 55685], [56, 56145], [62, 56465], [69, 56845], [72, 56985], [75, 57125], [85, 58060], [87, 58199], [92, 58399], [94, 58519], [100, 59315], [104, 59520], [106, 59725], [110, 60150], [112, 60316], [115, 60416], [121, 61041], [126, 61318], [128, 61658], [135, 62337], [137, 62497], [139, 62517], [142, 62597], [150, 63457], [154, 63669], [160, 64049], [162, 64429], [165, 64589]]}, {"verse": 9, "start": 65249, "end": 75530, "text": "Lo cual oyendo Jesús, se maravilló de él, y vuelto, dijo a la gente que le seguía: Os digo que ni aun en Israel he hallado tanta fe.", "words": [[0, 65249], [3, 65375], [8, 65695], [15, 66235], [22, 67175], [25, 67565], [35, 67955], [38, 68055], [42, 68335], [44, 68775], [52, 69655], [57, 69955], [59, 70115], [62, 70175], [68, 70435], [72, 70655], [75, 70775], [83, 71610], [86, 71850], [91, 72170], [95, 72450], [98, 72790], [102, 73130], [105, 73510], [112, 73990], [115, 74370], [123, 74810], [129, 75010]]}, {"verse": 10, "start": 75880, "end": 82479, "text": "Y vueltos a casa los que habían sido enviados, hallaron sano al siervo que había estado enfermo.", "words": [[0, 75880], [2, 76023], [10, 76583], [12, 76703], [17, 77023], [21, 77263], [25, 77423], [32, 77643], [37, 77983], [47, 78943], [56, 79543], [61, 80043], [64, 80343], [71, 80903], [75, 81083], [81, 81283], [88, 81663]]}, {"verse": 11, "start": 82829, "end": 91416, "text": "Y aconteció después, que él iba a la ciudad que se llama Naín, e iban con él muchos de sus discípulos, y una gran multitud.", "words": [[0, 82829], [2, 82973], [12, 83673], [21, 83953], [25, 84273], [28, 84453], [32, 84653], [34, 84793], [37, 84833], [44, 85133], [48, 85433], [51, 85573], [57, 86193], [63, 86813], [65, 86873], [70, 87173], [74, 87373], [77, 87573], [84, 87953], [87, 88153], [91, 88333], [103, 89573], [105, 89913], [109, 90093], [114, 90493]]}, {"verse": 12, "start": 91766, "end": 104552, "text": "Y cuando llegó cerca de la puerta de la ciudad, he aquí que sacaban fuera a un difunto, único hijo de su madre, la cual también era viuda: y había con ella una gran multitud de la ciudad.", "words": [[0, 91766], [2, 91873], [9, 92113], [15, 92453], [21, 92833], [24, 93073], [27, 93213], [34, 93473], [37, 93713], [40, 93833], [48, 94853], [51, 95193], [56, 95433], [60, 95913], [68, 96393], [74, 96573], [76, 96893], [79, 97013], [88, 97613], [94, 98073], [99, 98513], [102, 98733], [105, 98873], [112, 99593], [115, 99713], [120, 99913], [128, 100293], [132, 100673], [139, 101494], [141, 101637], [147, 101837], [151, 102117], [156, 102317], [160, 102537], [165, 102797], [174, 103577], [177, 103797], [180, 103917]]}, {"verse": 13, "start": 104902, "end": 109929, "text": "Y como el Señor la vio, se compadeció de ella, y le dice: No llores.", "words": [[0, 104902], [2, 104989], [7, 105189], [10, 105349], [16, 105589], [19, 105829], [24, 106429], [27, 106589], [38, 107409], [41, 107569], [47, 107849], [49, 108349], [52, 108489], [58, 109474], [61, 109738]]}, {"verse": 14, "start": 110279, "end": 118154, "text": "Y acercándose, tocó el féretro: y los que lo llevaban, pararon. Y dice: Joven, a ti digo, levántate.", "words": [[0, 110279], [2, 110380], [15, 111140], [20, 111680], [23, 111820], [32, 112676], [34, 112819], [38, 112999], [42, 113159], [45, 113319], [55, 113859], [64, 115054], [66, 115199], [72, 115951], [79, 116577], [81, 116677], [84, 116777], [90, 117077]]}, {"verse": 15, "start": 118504, "end": 124169, "text": "Entonces se incorporó el que había muerto, y comenzó a hablar. Y le dio a su madre.", "words": [[0, 118504], [9, 119108], [12, 119448], [22, 119898], [25, 120348], [29, 120488], [35, 120708], [43, 121288], [45, 121708], [53, 122268], [55, 122388], [63, 122883], [65, 122968], [68, 123088], [72, 123308], [74, 123488], [77, 123628]]}, {"verse": 16, "start": 124519, "end": 134066, "text": "Y todos tuvieron miedo, y glorificaban a Dios, diciendo: Que un gran profeta se ha levantado entre nosotros; y que Dios ha visitado a su pueblo.", "words": [[0, 124519], [2, 124643], [8, 124923], [17, 125523], [24, 125983], [26, 126248], [39, 127088], [41, 127228], [47, 127848], [57, 128770], [61, 129366], [64, 129492], [69, 129672], [77, 130172], [80, 130372], [83, 130452], [93, 130992], [99, 131172], [109, 132170], [111, 132275], [115, 132375], [120, 132635], [123, 132875], [132, 133355], [134, 133435], [137, 133535]]}, {"verse": 17, "start": 134346, "end": 139755, "text": "Y salió esta fama de él por toda Judea, y por toda la tierra de alrededor.", "words": [[0, 134346], [2, 134473], [8, 134893], [13, 135193], [18, 135593], [21, 135713], [24, 135873], [28, 136093], [33, 136333], [40, 137113], [42, 137493], [46, 137713], [51, 138113], [54, 138313], [61, 138693], [64, 138933]]}, {"verse": 18, "start": 140105, "end": 146516, "text": "Y sus discípulos informaron a Juan de todas estas cosas: y llamó Juan a dos de sus discípulos,", "words": [[0, 140105], [2, 140212], [6, 140352], [17, 141012], [28, 141772], [30, 141952], [35, 142212], [38, 142452], [44, 142712], [50, 143052], [57, 144016], [59, 144122], [65, 144402], [70, 144622], [72, 144922], [76, 145142], [79, 145302], [83, 145502]]}, {"verse": 19, "start": 146866, "end": 152640, "text": "Y envió a Jesús, diciendo: ¿Eres tú aquel que había de venir, o esperaremos a otro?", "words": [[0, 146866], [2, 147030], [8, 147450], [10, 147730], [17, 148170], [27, 149545], [33, 149762], [36, 150002], [42, 150362], [46, 150462], [52, 150662], [55, 150822], [62, 151102], [64, 151442], [76, 152022], [78, 152262]]}, {"verse": 20, "start": 152920, "end": 162793, "text": "Y como los hombres vinieron a él, dijeron: Juan el Bautista nos ha enviado a ti, diciendo: ¿Eres tú aquel que había de venir, o esperaremos a otro?", "words": [[0, 152920], [2, 153044], [7, 153284], [11, 153484], [19, 153904], [28, 154484], [30, 154684], [34, 155224], [43, 156179], [48, 156696], [51, 156736], [60, 157456], [64, 157576], [67, 157756], [75, 158216], [77, 158336], [81, 158496], [91, 159698], [97, 159916], [100, 160156], [106, 160516], [110, 160616], [116, 160816], [119, 160976], [126, 161256], [128, 161596], [140, 162176], [142, 162416]]}, {"verse": 21, "start": 163073, "end": 171306, "text": "Y en la misma hora sanó a muchos de enfermedades y plagas, y de espíritus malos; y a muchos ciegos dio la vista.", "words": [[0, 163073], [2, 163220], [5, 163320], [8, 163440], [14, 163700], [19, 164120], [24, 164640], [26, 164760], [33, 165040], [36, 165320], [49, 166180], [51, 166360], [59, 167200], [61, 167380], [64, 167520], [74, 168060], [81, 168947], [83, 169072], [85, 169112], [92, 169372], [99, 170172], [103, 170492], [106, 170652]]}, {"verse": 22, "start": 171656, "end": 190737, "text": "Y respondiendo Jesús, les dijo: Id, dad las nuevas a Juan de lo que habéis visto y oído: que los ciegos ven, los cojos andan, los leprosos son limpiados, los sordos oyen, los muertos resucitan, a los pobres es anunciado el evangelio:", "words": [[0, 171656], [2, 171764], [15, 172464], [22, 172904], [26, 173484], [32, 174317], [36, 174427], [40, 174807], [44, 175207], [51, 175607], [53, 175847], [58, 176147], [61, 176787], [64, 176907], [68, 177047], [75, 177387], [81, 177847], [83, 178267], [89, 179098], [93, 179180], [97, 179340], [104, 179840], [109, 180800], [113, 180920], [119, 181380], [126, 182420], [130, 182540], [139, 183120], [143, 183440], [154, 184520], [158, 184620], [165, 185260], [171, 186240], [175, 186360], [183, 186880], [194, 188080], [196, 188120], [200, 188260], [207, 188740], [210, 189020], [220, 189780], [223, 189900]]}, {"verse": 23, "start": 191087, "end": 193874, "text": "Y dichoso es el que no halle tropiezo en mí.", "words": [[0, 191087], [2, 191232], [10, 191752], [13, 191972], [16, 192092], [20, 192272], [23, 192492], [29, 192712], [38, 193392], [41, 193512]]}, {"verse": 24, "start": 194224, "end": 205349, "text": "Y como se fueron los mensajeros de Juan, comenzó a hablar de Juan a la gente: ¿Qué salisteis a ver al desierto? ¿una caña que es agitada por el viento?", "words": [[0, 194224], [2, 194365], [7, 194645], [10, 194865], [17, 195225], [21, 195465], [32, 196245], [35, 196405], [41, 197225], [49, 197925], [51, 198025], [58, 198225], [61, 198425], [66, 198685], [68, 198845], [71, 198905], [78, 199822], [83, 199926], [93, 200626], [95, 200786], [99, 200926], [102, 201066], [112, 202118], [117, 202498], [122, 203018], [126, 203478], [129, 203678], [137, 204338], [141, 204558], [144, 204698]]}, {"verse": 25, "start": 205699, "end": 216840, "text": "Pero ¿qué salisteis a ver? ¿un hombre cubierto de vestidos delicados? He aquí, los que están en vestido precioso, y viven en delicias, en los palacios de los reyes están.", "words": [[0, 205699], [5, 205882], [10, 206282], [20, 206862], [22, 207002], [27, 207600], [31, 207747], [38, 208027], [47, 208727], [50, 208887], [59, 209367], [70, 210438], [73, 210597], [79, 210897], [83, 211077], [87, 211217], [93, 211417], [96, 211597], [104, 211977], [114, 212677], [116, 213177], [122, 213577], [125, 213677], [135, 214237], [138, 214837], [142, 214957], [151, 215517], [154, 215637], [158, 215927], [164, 216217]]}, {"verse": 26, "start": 217190, "end": 222479, "text": "Pero ¿qué salisteis a ver? ¿un profeta? También os digo, y aun más que profeta.", "words": [[0, 217190], [5, 217373], [10, 217773], [20, 218353], [22, 218493], [27, 219092], [31, 219240], [40, 220181], [48, 220406], [51, 220646], [57, 220946], [59, 221346], [63, 221486], [67, 221726], [71, 221846]]}, {"verse": 27, "start": 222829, "end": 230809, "text": "Este es de quien está escrito: He aquí, envío mi mensajero delante de tu faz, el cual preparará tu camino delante de ti.", "words": [[0, 222829], [5, 223072], [8, 223328], [11, 223584], [17, 223839], [22, 224095], [31, 224511], [34, 224699], [40, 225019], [46, 225519], [49, 225679], [59, 226379], [67, 226819], [70, 226979], [73, 227119], [78, 228039], [81, 228139], [86, 228399], [96, 229239], [99, 229399], [106, 229759], [114, 230319], [117, 230479]]}, {"verse": 28, "start": 231159, "end": 240909, "text": "Porque os digo que entre los nacidos de mujeres, no hay mayor profeta que Juan el Bautista: pero el más pequeño en el reino de los cielos es mayor que él.", "words": [[0, 231159], [7, 231401], [10, 231621], [15, 231901], [19, 232121], [25, 232361], [29, 232581], [37, 233101], [40, 233261], [49, 233721], [52, 234321], [56, 234481], [62, 234861], [70, 235481], [74, 235621], [79, 235881], [82, 236061], [92, 237127], [97, 237295], [100, 237435], [104, 237555], [112, 237995], [115, 238215], [118, 238355], [124, 238715], [127, 238815], [131, 238975], [138, 239415], [141, 239595], [147, 240215], [151, 240555]]}, {"verse": 29, "start": 241259, "end": 250298, "text": "Y todo el pueblo oyéndole, y los recaudadores de impuestos, reconocieron la justicia de Dios, bautizándose con el bautismo de Juan.", "words": [[0, 241259], [2, 241403], [7, 241663], [10, 241883], [17, 242243], [27, 243123], [29, 243338], [33, 243498], [46, 244278], [49, 244458], [60, 245778], [73, 246398], [76, 246558], [85, 247078], [88, 247238], [94, 248098], [107, 248938], [111, 249178], [114, 249298], [123, 249778], [126, 249918]]}, {"verse": 30, "start": 250648, "end": 259046, "text": "Pero los fariseos y los sabios de la ley, desecharon el consejo de Dios contra sí mismos, no siendo bautizados de él.", "words": [[0, 250648], [5, 250793], [9, 250973], [18, 251753], [20, 251893], [24, 252053], [31, 252553], [34, 252633], [37, 252773], [42, 253093], [53, 254313], [56, 254493], [64, 255153], [67, 255273], [72, 255493], [79, 255893], [82, 256093], [90, 257013], [93, 257253], [100, 257553], [111, 258373], [114, 258653]]}, {"verse": 31, "start": 259396, "end": 266812, "text": "Y dice el Señor: ¿A quién, pues, compararé los hombres de esta generación, y a qué son semejantes?", "words": [[0, 259396], [2, 259521], [7, 259821], [10, 260001], [17, 260875], [20, 260999], [27, 261239], [33, 261939], [43, 262699], [47, 262859], [55, 263239], [58, 263539], [63, 263759], [75, 265119], [77, 265259], [79, 265379], [83, 265479], [87, 265719]]}, {"verse": 32, "start": 267162, "end": 281090, "text": "Semejantes son a los muchachos sentados en la plaza, y que dan voces los unos a los otros, y dicen: Tocamos flautas para vosotros, y no bailasteis: os cantamos lamentos, y no llorasteis.", "words": [[0, 267162], [11, 267846], [15, 268106], [17, 268226], [21, 268346], [31, 268946], [40, 269546], [43, 269766], [46, 269906], [53, 270406], [55, 270753], [59, 271099], [63, 271446], [69, 272006], [73, 272206], [78, 272586], [80, 272946], [84, 273126], [91, 273506], [93, 274026], [100, 274903], [108, 275286], [116, 275846], [121, 276026], [131, 276586], [133, 276906], [136, 277066], [148, 278414], [151, 278564], [160, 279124], [170, 279644], [172, 279944], [175, 280124]]}, {"verse": 33, "start": 281440, "end": 287396, "text": "Porque vino Juan el Bautista, que ni comía pan, ni bebía vino, y decís: Demonio tiene.", "words": [[0, 281440], [7, 281644], [12, 281904], [17, 282424], [20, 282524], [30, 283244], [34, 283324], [37, 283464], [43, 283784], [48, 284464], [51, 284744], [57, 285104], [63, 285384], [65, 285604], [72, 286395], [80, 286900]]}, {"verse": 34, "start": 287746, "end": 298589, "text": "Vino el Hijo del hombre, que come y bebe, y decís: He aquí un hombre comilón, y bebedor de vino, amigo de recaudadores de impuestos y de pecadores.", "words": [[0, 287746], [5, 288031], [8, 288191], [13, 288411], [17, 288591], [25, 288931], [29, 289431], [34, 289871], [36, 290131], [42, 290471], [44, 290631], [51, 291579], [54, 291854], [59, 292114], [62, 292274], [69, 292534], [78, 293274], [80, 293734], [88, 294214], [91, 294354], [97, 295034], [103, 295414], [106, 295634], [119, 296474], [122, 296694], [132, 297354], [134, 297554], [137, 297674]]}, {"verse": 35, "start": 298939, "end": 302159, "text": "Pero la sabiduría es justificada de todos sus hijos.", "words": [[0, 298939], [5, 299083], [8, 299263], [18, 299963], [21, 300063], [33, 300863], [36, 301043], [42, 301243], [46, 301583]]}, {"verse": 36, "start": 302509, "end": 310014, "text": "Y le rogó uno de los fariseos, que comiese con él. Y entrado en casa del fariseo, se sentó a la mesa.", "words": [[0, 302509], [2, 302634], [5, 302754], [10, 303194], [14, 303394], [17, 303534], [21, 303654], [31, 304494], [35, 304914], [43, 305354], [47, 305614], [51, 306173], [53, 306451], [61, 307091], [64, 307251], [69, 307551], [73, 307811], [82, 308651], [85, 308891], [91, 309331], [93, 309411], [96, 309511]]}, {"verse": 37, "start": 310364, "end": 321197, "text": "Y he aquí una mujer que había sido pecadora en la ciudad, como entendió que estaba a la mesa en casa de aquel fariseo, trajo un frasco de alabastro con ungüento,", "words": [[0, 310364], [2, 310541], [5, 310701], [10, 311061], [14, 311361], [20, 311781], [24, 312021], [30, 312261], [35, 312621], [44, 313281], [47, 313441], [50, 313561], [58, 314621], [63, 314941], [72, 315461], [76, 315601], [83, 315921], [85, 316141], [88, 316201], [93, 316481], [96, 316681], [101, 317041], [104, 317261], [110, 317541], [119, 318492], [125, 318816], [128, 318956], [135, 319476], [138, 319616], [148, 320216], [152, 320735]]}, {"verse": 38, "start": 321547, "end": 333184, "text": "Y estando detrás a sus pies, comenzó llorando a regar con lágrimas sus pies, y los limpiaba con los cabellos de su cabeza; y besaba sus pies, y los ungía con el perfume.", "words": [[0, 321547], [2, 321673], [10, 322233], [17, 322753], [19, 322893], [23, 323093], [29, 323373], [37, 324068], [46, 324568], [48, 324668], [54, 325068], [58, 325168], [67, 325808], [71, 326048], [77, 326328], [79, 326828], [83, 326968], [92, 327688], [96, 327928], [100, 328088], [109, 328608], [112, 328708], [115, 328848], [123, 329833], [125, 329940], [132, 330320], [136, 330520], [142, 330840], [144, 331175], [148, 331355], [154, 332075], [158, 332315], [161, 332435]]}, {"verse": 39, "start": 333534, "end": 345799, "text": "Y cuando vio esto el fariseo que le había invitado, habló entre sí, diciendo: Este, si fuera profeta, conocería quién y cuál es la mujer que le toca, que es pecadora.", "words": [[0, 333534], [2, 333636], [9, 333876], [13, 334296], [18, 334616], [21, 334776], [29, 335496], [33, 335636], [36, 335796], [42, 336016], [52, 336916], [58, 337696], [64, 338056], [68, 338956], [78, 339902], [84, 340223], [87, 340423], [93, 340703], [102, 341723], [112, 342363], [118, 342603], [120, 342783], [125, 343063], [128, 343343], [131, 343483], [137, 343803], [141, 344003], [144, 344123], [150, 344903], [154, 344963], [157, 345123]]}, {"verse": 40, "start": 346079, "end": 354060, "text": "Entonces respondiendo Jesús, le dijo: Simón, una cosa tengo que decirte. Y él dice: Di, Maestro.", "words": [[0, 346079], [9, 346962], [22, 347605], [29, 348505], [32, 348605], [38, 349361], [45, 350199], [49, 350379], [54, 350659], [60, 350999], [64, 351219], [73, 352234], [75, 352440], [78, 352580], [84, 353337], [88, 353427]]}, {"verse": 41, "start": 354340, "end": 360941, "text": "Un acreedor tenía dos deudores: el uno le debía quinientos denarios, y el otro cincuenta;", "words": [[0, 354574], [3, 354840], [12, 355107], [18, 355587], [22, 356007], [32, 357235], [35, 357412], [39, 357622], [42, 357782], [48, 358302], [59, 358822], [69, 359342], [71, 359642], [74, 359802], [79, 360400]]}, {"verse": 42, "start": 361291, "end": 368053, "text": "Y no teniendo ellos de qué pagar, perdonó a ambos. Di, pues, ¿cuál de estos le amará más?", "words": [[0, 361291], [2, 361591], [5, 361751], [14, 362291], [20, 362551], [23, 362811], [27, 362911], [34, 363711], [42, 364451], [44, 364591], [51, 365429], [55, 365869], [61, 366329], [67, 366729], [70, 366849], [76, 367069], [79, 367329], [85, 367569]]}, {"verse": 43, "start": 368403, "end": 375788, "text": "Y respondiendo Simón, dijo: Pienso que aquel al cual perdonó más. Y él le dijo: Rectamente has juzgado.", "words": [[0, 368403], [2, 368531], [15, 369271], [22, 369791], [28, 370650], [35, 370946], [39, 371086], [45, 371366], [48, 371506], [53, 371666], [61, 372166], [66, 372851], [68, 373056], [71, 373196], [74, 373356], [80, 374323], [91, 374597], [95, 374870]]}, {"verse": 44, "start": 376138, "end": 388072, "text": "Y vuelto a la mujer, dijo a Simón: ¿Ves esta mujer? Entré en tu casa, no diste agua para mis pies; pero esta ha regado mis pies con lágrimas, y los ha limpiado con los cabellos.", "words": [[0, 376138], [2, 376261], [9, 376601], [11, 376681], [14, 376741], [21, 377361], [26, 377661], [28, 377841], [35, 378669], [40, 378799], [45, 378939], [52, 379815], [58, 380258], [61, 380338], [64, 380458], [70, 380791], [73, 381125], [79, 381458], [84, 381778], [89, 382038], [93, 382198], [99, 383023], [104, 383171], [109, 383551], [112, 383691], [119, 384171], [123, 384351], [128, 384631], [132, 384911], [142, 385691], [144, 385893], [148, 386096], [151, 386256], [160, 386896], [164, 387116], [168, 387615]]}, {"verse": 45, "start": 388422, "end": 394863, "text": "No me diste beso, pero esta, desde que entré, no ha cesado de besar mis pies.", "words": [[0, 388422], [3, 388550], [6, 388690], [12, 389010], [18, 389710], [23, 389930], [29, 390810], [35, 391130], [39, 391450], [46, 392410], [49, 392610], [52, 392750], [59, 393250], [62, 393430], [68, 393870], [72, 394030]]}, {"verse": 46, "start": 395213, "end": 400598, "text": "No ungiste mi cabeza con aceite; pero esta ha ungido con perfume mis pies.", "words": [[0, 395213], [3, 395420], [11, 395880], [14, 396080], [21, 396440], [25, 396780], [33, 397570], [38, 397989], [43, 398309], [46, 398629], [53, 398949], [57, 399229], [65, 399729], [69, 399989]]}, {"verse": 47, "start": 400948, "end": 408974, "text": "Por lo cual te digo que sus muchos pecados son perdonados, porque amó mucho; pero al que se perdona poco, poco ama.", "words": [[0, 400948], [4, 401052], [7, 401172], [12, 401372], [15, 401572], [20, 401852], [24, 402012], [28, 402192], [35, 402552], [43, 403112], [47, 403332], [59, 404552], [66, 405012], [70, 405492], [77, 406236], [82, 406430], [85, 406660], [89, 406800], [92, 406980], [100, 407500], [106, 407840], [111, 408440]]}, {"verse": 48, "start": 409324, "end": 412646, "text": "Y a ella dijo: Los pecados te son perdonados.", "words": [[0, 409324], [2, 409491], [4, 409571], [9, 409771], [15, 410670], [19, 410776], [27, 411276], [30, 411416], [34, 411616]]}, {"verse": 49, "start": 412996, "end": 420412, "text": "Y los que estaban juntamente sentados a la mesa, comenzaron a decir entre sí: ¿Quién es este, que también perdona pecados?", "words": [[0, 412996], [2, 413086], [6, 413206], [10, 413346], [18, 413726], [29, 414586], [38, 415346], [40, 415506], [43, 415606], [49, 415846], [60, 416686], [62, 416806], [68, 417126], [74, 417446], [78, 418102], [85, 418324], [88, 418464], [94, 418684], [98, 418844], [106, 419204], [114, 419644]]}, {"verse": 50, "start": 420692, "end": 424380, "text": "Y dijo a la mujer: Tu fe te ha salvado, ve en paz.", "words": [[0, 420692], [2, 420839], [7, 421139], [9, 421259], [12, 421339], [19, 422114], [22, 422196], [25, 422396], [28, 422556], [31, 422656], [40, 423576], [43, 423736], [46, 423896]]}]}