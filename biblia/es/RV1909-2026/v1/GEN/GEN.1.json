{"book": "GEN", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 286436, "verses": [{"verse": 1, "start": 300, "end": 4091, "text": "En el principio creó Dios los cielos y la tierra.", "words": [[0, 300], [3, 466], [6, 586], [16, 1086], [21, 1846], [26, 2106], [30, 2486], [37, 3166], [39, 3366], [42, 3486]]}, {"verse": 2, "start": 4541, "end": 16624, "text": "Y la tierra estaba desordenada y vacía, y las tinieblas estaban sobre la superficie del abismo, y el Espíritu de Dios se movía sobre la superficie de las aguas.", "words": [[0, 4541], [2, 4644], [5, 4764], [12, 5104], [19, 5604], [31, 6544], [33, 6684], [40, 7724], [42, 7944], [46, 8124], [56, 8764], [64, 9144], [70, 9604], [73, 9804], [84, 10684], [88, 10844], [96, 11744], [98, 12044], [101, 12164], [110, 12844], [113, 12964], [118, 13284], [121, 13624], [127, 14164], [133, 14444], [136, 14664], [147, 15664], [150, 15784], [154, 15944]]}, {"verse": 3, "start": 17074, "end": 21003, "text": "Y dijo Dios: Sea la luz: y fue la luz.", "words": [[0, 17074], [2, 17218], [7, 17518], [13, 18396], [17, 18660], [20, 18860], [25, 19934], [27, 20041], [31, 20241], [34, 20401]]}, {"verse": 4, "start": 21453, "end": 26778, "text": "Y vio Dios que la luz era buena: y apartó Dios la luz de las tinieblas.", "words": [[0, 21453], [2, 21578], [6, 21818], [11, 22098], [15, 22398], [18, 22558], [22, 22778], [26, 23038], [33, 23880], [35, 24029], [42, 24589], [47, 24789], [50, 25169], [54, 25409], [57, 25609], [61, 25749]]}, {"verse": 5, "start": 27228, "end": 34827, "text": "Y llamó Dios a la luz Día, y a las tinieblas llamó Noche: y fue la tarde y la mañana un día.", "words": [[0, 27228], [2, 27355], [8, 27675], [13, 27955], [15, 28235], [18, 28315], [22, 28555], [27, 28955], [29, 29915], [31, 29995], [35, 30115], [45, 30875], [51, 31355], [58, 32255], [60, 32374], [64, 32534], [67, 32694], [73, 33114], [75, 33534], [78, 33654], [85, 34054], [88, 34274]]}, {"verse": 6, "start": 35277, "end": 41569, "text": "Y dijo Dios: Haya expansión en medio de las aguas, y separe las aguas de las aguas.", "words": [[0, 35277], [2, 35438], [7, 35698], [13, 36576], [18, 36780], [28, 37520], [31, 37680], [37, 37920], [40, 38100], [44, 38280], [51, 38840], [53, 39320], [60, 39800], [64, 40000], [70, 40400], [73, 40500], [77, 40660]]}, {"verse": 7, "start": 41919, "end": 51769, "text": "E hizo Dios la expansión, y apartó las aguas que estaban debajo de la expansión, de las aguas que estaban sobre la expansión: y fue así.", "words": [[0, 41919], [2, 42041], [7, 42301], [12, 42601], [15, 43101], [26, 43961], [28, 44481], [35, 45001], [39, 45181], [45, 45581], [49, 45721], [57, 46041], [64, 46501], [67, 46661], [70, 46781], [81, 47821], [84, 48081], [88, 48221], [94, 48641], [98, 48761], [106, 49121], [112, 49461], [115, 49661], [126, 50932], [128, 51040], [132, 51200]]}, {"verse": 8, "start": 52219, "end": 58062, "text": "Y llamó Dios a la expansión Cielos: y fue la tarde y la mañana el día segundo.", "words": [[0, 52219], [2, 52343], [8, 52683], [13, 52943], [15, 53203], [18, 53283], [28, 53903], [36, 55072], [38, 55197], [42, 55377], [45, 55557], [51, 55957], [53, 56317], [56, 56437], [63, 56837], [66, 57157], [70, 57337]]}, {"verse": 9, "start": 58512, "end": 67278, "text": "Y dijo Dios: Júntense las aguas que están debajo de los cielos en un lugar, y descúbrase la seca: y fue así.", "words": [[0, 58512], [2, 58678], [7, 58898], [13, 59779], [22, 60317], [26, 60557], [32, 61037], [36, 61157], [42, 61437], [49, 61917], [52, 62097], [56, 62197], [63, 62677], [66, 62817], [69, 62917], [76, 63237], [78, 63857], [89, 64537], [92, 64697], [98, 66440], [100, 66547], [104, 66747]]}, {"verse": 10, "start": 67728, "end": 74789, "text": "Y llamó Dios a la seca Tierra, y a la reunión de las aguas llamó Mares: y vio Dios que era bueno.", "words": [[0, 67728], [2, 68011], [8, 68351], [13, 68491], [15, 68711], [18, 68791], [23, 69091], [31, 69571], [33, 70151], [35, 70231], [38, 70311], [46, 70851], [49, 71031], [53, 71191], [59, 71571], [65, 71891], [72, 72977], [74, 73266], [78, 73486], [83, 73746], [87, 73986], [91, 74166]]}, {"verse": 11, "start": 75239, "end": 88115, "text": "Y dijo Dios: Produzca la tierra hierba verde, hierba que dé semilla; árbol de fruto que dé fruto según su género, cuya semilla esté en él, sobre la tierra: y fue así.", "words": [[0, 75239], [2, 75398], [7, 75638], [13, 76614], [22, 77193], [25, 77333], [32, 77633], [39, 78173], [46, 78993], [53, 79573], [57, 79713], [60, 79873], [69, 81116], [75, 81517], [78, 81657], [84, 82057], [88, 82197], [91, 82357], [97, 82817], [103, 83017], [106, 83237], [114, 83997], [119, 84377], [127, 84837], [132, 85097], [135, 85337], [139, 85537], [145, 85897], [148, 86097], [156, 87266], [158, 87373], [162, 87573]]}, {"verse": 12, "start": 88565, "end": 99580, "text": "Y produjo la tierra hierba verde que da semilla según su naturaleza, y árbol que da fruto, cuya semilla está en él, según su género: y vio Dios que era bueno.", "words": [[0, 88565], [2, 88690], [10, 89290], [13, 89470], [20, 89849], [27, 90349], [33, 90709], [37, 90970], [40, 91150], [48, 91690], [54, 91970], [57, 92230], [69, 93090], [71, 93450], [77, 93849], [81, 94030], [84, 94170], [91, 94770], [96, 95170], [104, 95590], [109, 95790], [112, 95989], [116, 96330], [122, 96670], [125, 96929], [133, 97805], [135, 97951], [139, 98111], [144, 98411], [148, 98871], [152, 99051]]}, {"verse": 13, "start": 100030, "end": 103242, "text": "Y fue la tarde y la mañana el día tercero.", "words": [[0, 100030], [2, 100135], [6, 100335], [9, 100535], [15, 100955], [17, 101235], [20, 101355], [27, 101795], [30, 102135], [34, 102375]]}, {"verse": 14, "start": 103692, "end": 114320, "text": "Y dijo Dios: Haya luminarias en la expansión de los cielos para separar el día de la noche; y sirvan de señales para las estaciones, para días y años;", "words": [[0, 103692], [2, 103856], [7, 104156], [13, 105283], [18, 105617], [29, 105950], [32, 106090], [35, 106170], [45, 106750], [48, 106890], [52, 106970], [59, 107450], [64, 107650], [72, 108170], [75, 108250], [79, 108450], [82, 108570], [85, 108670], [92, 109758], [94, 109854], [101, 110294], [104, 110414], [112, 110974], [117, 111214], [121, 111414], [133, 112074], [138, 112674], [143, 113034], [145, 113474]]}, {"verse": 15, "start": 114770, "end": 121065, "text": "Y sean por lumbreras en la expansión de los cielos para alumbrar sobre la tierra: y fue así.", "words": [[0, 114770], [2, 114872], [7, 115132], [11, 115352], [21, 115912], [24, 116152], [27, 116252], [37, 116892], [40, 117052], [44, 117172], [51, 117712], [56, 118052], [65, 118612], [71, 118892], [74, 119072], [82, 120184], [84, 120292], [88, 120472]]}, {"verse": 16, "start": 121515, "end": 134239, "text": "E hizo Dios las dos grandes luminarias; la luminaria mayor para que señorease en el día, y la luminaria menor para que señorease en la noche: hizo también las estrellas.", "words": [[0, 121515], [2, 121826], [7, 122226], [12, 122606], [16, 123146], [20, 123346], [28, 124067], [40, 125037], [43, 125163], [53, 125723], [59, 126223], [64, 126783], [68, 126943], [78, 127803], [81, 128043], [84, 128223], [89, 128483], [91, 128643], [94, 128783], [104, 129383], [110, 129803], [115, 130163], [119, 130343], [129, 131163], [132, 131423], [135, 131563], [142, 132546], [147, 132676], [155, 133036], [159, 133276]]}, {"verse": 17, "start": 134688, "end": 139822, "text": "Y las puso Dios en la expansión de los cielos, para alumbrar sobre la tierra,", "words": [[0, 134688], [2, 134796], [6, 134936], [11, 135236], [16, 135516], [19, 135736], [22, 135856], [32, 136456], [35, 136596], [39, 136716], [47, 137356], [52, 137876], [61, 138616], [67, 138876], [70, 139096]]}, {"verse": 18, "start": 140272, "end": 148196, "text": "Y para señorear en el día y en la noche, y para apartar la luz y las tinieblas: y vio Dios que era bueno.", "words": [[0, 140272], [2, 140377], [7, 140597], [16, 141337], [19,