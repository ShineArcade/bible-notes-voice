{"book": "LUK", "chapter": 13, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 269775, "verses": [{"verse": 1, "start": 300, "end": 7286, "text": "There were present at that season some that told him of the Galilæans, whose blood Pilate had mingled with their sacrifices.", "words": [[0, 300], [6, 460], [11, 640], [19, 1020], [22, 1280], [27, 1480], [34, 1920], [39, 2300], [44, 2520], [49, 2760], [53, 2960], [56, 3100], [60, 3650], [71, 4200], [77, 4440], [83, 4820], [90, 5200], [94, 5420], [102, 5900], [107, 6040], [113, 6200]]}, {"verse": 2, "start": 7636, "end": 15610, "text": "And Jesus answering said to them, Do you suppose that these Galilæans were sinners above all the Galilæans, because they suffered such things?", "words": [[0, 7636], [4, 7795], [10, 8135], [20, 8695], [25, 9015], [28, 9215], [34, 9842], [37, 9940], [41, 10060], [49, 10360], [54, 10660], [60, 11070], [70, 11480], [75, 11680], [83, 12000], [89, 12340], [93, 12700], [97, 13270], [108, 13840], [116, 14100], [121, 14380], [130, 14700], [135, 15000]]}, {"verse": 3, "start": 15960, "end": 19853, "text": "I tell you, No: but, unless you repent, you shall all likewise perish.", "words": [[0, 15960], [2, 16085], [7, 16245], [12, 16385], [16, 17039], [21, 17139], [28, 17339], [32, 17559], [40, 18219], [44, 18319], [50, 18499], [54, 18739], [63, 19079]]}, {"verse": 4, "start": 20203, "end": 27927, "text": "Or those eighteen, upon whom the tower in Siloam fell, and killed them, do you think that they were sinners above all men that dwelt in Jerusalem?", "words": [[0, 20203], [3, 20326], [9, 20506], [19, 21006], [24, 21306], [29, 21626], [33, 21806], [39, 22146], [42, 22446], [49, 22746], [55, 23086], [59, 23361], [66, 23661], [72, 24381], [75, 24581], [79, 24661], [85, 24841], [90, 24981], [95, 25101], [100, 25241], [108, 25581], [114, 25921], [118, 26161], [122, 26401], [127, 26641], [133, 27021], [136, 27141]]}, {"verse": 5, "start": 28277, "end": 33045, "text": "I tell you, No: but, unless you repent, you shall all likewise perish.", "words": [[0, 28277], [2, 28528], [7, 28748], [12, 28948], [16, 29648], [21, 29771], [28, 30011], [32, 30211], [40, 31191], [44, 31291], [50, 31471], [54, 31731], [63, 32151]]}, {"verse": 6, "start": 33325, "end": 41256, "text": "¶ He spoke also this parable; A certain man had a fig tree planted in his vineyard; and he came and sought fruit on it, and found none.", "words": [[2, 33325], [5, 33417], [11, 33637], [16, 34097], [21, 34437], [30, 35289], [32, 35410], [40, 35690], [44, 36110], [48, 36350], [50, 36450], [54, 36710], [59, 37050], [67, 37410], [70, 37670], [74, 37810], [84, 38579], [88, 38716], [91, 38796], [96, 39076], [100, 39316], [107, 39556], [113, 39856], [116, 40076], [120, 40276], [124, 40496], [130, 40776]]}, {"verse": 7, "start": 41606, "end": 52310, "text": "Then said he to the dresser of his vineyard, Behold, these three years I come seeking fruit on this fig tree, and find none: cut it down; why does it use up the ground?", "words": [[0, 41606], [5, 41839], [10, 42159], [13, 42379], [16, 42579], [20, 42679], [28, 43099], [31, 43219], [35, 43339], [45, 44059], [53, 44979], [59, 45239], [65, 45539], [71, 45879], [73, 46099], [78, 46319], [86, 46639], [92, 47059], [95, 47319], [100, 47499], [104, 47739], [110, 48419], [114, 48499], [119, 48819], [125, 49659], [129, 49796], [132, 49916], [138, 50689], [142, 50867], [147, 51087], [150, 51207], [154, 51407], [157, 51587], [161, 51727]]}, {"verse": 8, "start": 52660, "end": 58452, "text": "And he answering said to him, Lord, let it alone this year also, till I shall dig about it, and dung it:", "words": [[0, 52660], [4, 52785], [7, 52925], [17, 53305], [22, 53585], [25, 53765], [30, 54185], [36, 54805], [40, 54945], [43, 55065], [49, 55385], [54, 55645], [59, 55845], [65, 56525], [70, 56625], [72, 56785], [78, 56945], [82, 57145], [88, 57405], [92, 57825], [96, 57925], [101, 58205]]}, {"verse": 9, "start": 58802, "end": 63457, "text": "And if it bear fruit, well: and if not, then after that you shall cut it down.", "words": [[0, 58802], [4, 58904], [7, 59004], [10, 59144], [15, 59284], [22, 59964], [28, 60601], [32, 60757], [35, 60897], [40, 61097], [45, 61697], [51, 61717], [56, 62217], [60, 62377], [66, 62557], [70, 62777], [73, 62897]]}, {"verse": 10, "start": 63737, "end": 66542, "text": "And he was teaching in one of the synagogues on the sabbath.", "words": [[0, 63737], [4, 63862], [7, 63962], [11, 64142], [20, 64502], [23, 64782], [27, 64963], [30, 65082], [34, 65222], [45, 65882], [48, 66002], [52, 66122]]}, {"verse": 11, "start": 66892, "end": 75412, "text": "¶ And, behold, there was a woman which had a spirit of infirmity eighteen years, and was bowed together, and could by no means lift up herself.", "words": [[2, 66892], [7, 67011], [15, 67791], [21, 68031], [25, 68191], [27, 68331], [33, 68591], [39, 68871], [43, 69031], [45, 69151], [52, 69471], [55, 69671], [65, 70291], [74, 70651], [81, 71571], [85, 71751], [89, 71931], [95, 72371], [105, 72691], [109, 73331], [115, 73511], [118, 73691], [121, 73931], [127, 74211], [132, 74511], [135, 74731]]}, {"verse": 12, "start": 75762, "end": 81935, "text": "And when Jesus saw her, he called her to him, and said to her, Woman, you are loosed from your infirmity.", "words": [[0, 75762], [4, 75895], [9, 76055], [15, 76335], [19, 76775], [24, 77435], [27, 77515], [34, 77855], [38, 78035], [41, 78195], [46, 78415], [50, 78915], [55, 79155], [58, 79355], [63, 79889], [70, 80166], [74, 80406], [78, 80506], [85, 80906], [90, 81066], [95, 81226]]}, {"verse": 13, "start": 82215, "end": 87308, "text": "And he laid his hands on her: and immediately she was made straight, and glorified God.", "words": [[0, 82215], [4, 82354], [7, 82454], [12, 82694], [16, 82894], [22, 83194], [25, 83454], [30, 83992], [34, 84155], [46, 84475], [50, 84995], [54, 85155], [59, 85375], [69, 85815], [73, 86115], [83, 86755]]}, {"verse": 14, "start": 87658, "end": 101142, "text": "And the ruler of the synagogue answered with indignation, because that Jesus had healed on the sabbath day, and said to the people, There are six days in which men ought to work: in them therefore come and be healed, and not on the sabbath day.", "words": [[0, 87658], [4, 87801], [8, 87901], [14, 88181], [17, 88381], [21, 88501], [31, 88941], [40, 89554], [45, 90168], [58, 90781], [66, 91141], [71, 91481], [77, 91861], [81, 92161], [88, 92421], [91, 92641], [95, 92781], [103, 93081], [108, 93481], [112, 93901], [117, 94101], [120, 94281], [124, 94381], [132, 95095], [138, 95269], [142, 95409], [146, 95749], [151, 96089], [154, 96389], [160, 96569], [164, 96809], [170, 97029], [173, 97229], [179, 97893], [182, 98031], [187, 98631], [197, 98791], [202, 98931], [206, 99071], [209, 99231], [217, 99931], [221, 100011], [225, 100231], [228, 100371], [232, 100471], [240, 100711]]}, {"verse": 15, "start": 101422, "end": 110129, "text": "The Lord then answered him, and said, You hypocrite, does not each one of you on the sabbath loose his ox or his donkey from the stall, and lead him away to watering?", "words": [[0, 101422], [4, 101517], [9, 101717], [14, 101957], [23, 102297], [28, 102557], [32, 102797], [38, 103598], [42, 103832], [53, 104065], [58, 104205], [62, 104385], [67, 104665], [71, 104885], [74, 105005], [78, 105145], [81, 105305], [85, 105425], [93, 105745], [99, 106105], [103, 106325], [106, 106665], [109, 106965], [113, 107145], [120, 107485], [125, 107725], [129, 107885], [136, 108205], [140, 108725], [145, 108905], [149, 109105], [154, 109345], [157, 109525]]}, {"verse": 16, "start": 110479, "end": 118661, "text": "And ought not this woman, being a daughter of Abraham, whom Satan has bound, lo, these eighteen years, be loosed from this bond on the sabbath day?", "words": [[0, 110479], [4, 110602], [10, 110842], [14, 111002], [19, 111242], [26, 111862], [32, 112062], [34, 112222], [43, 112442], [46, 112642], [55, 113482], [60, 113582], [66, 113902], [70, 114162], [77, 114922], [81, 115462], [87, 115602], [96, 115942], [103, 116662], [106, 116762], [113, 117102], [118, 117202], [123, 117362], [128, 117662], [131, 117802], [135, 117922], [143, 118182]]}, {"verse": 17, "start": 118941, "end": 127935, "text": "And when he had said these things, all his adversaries were ashamed: and all the people rejoiced for all the glorious things that were done by him.", "words": [[0, 118941], [4, 119077], [9, 119237], [12, 119457], [16, 119657], [21, 119917], [27, 120197], [35, 121097], [39, 121417], [43, 121677], [55, 122377], [60, 122657], [69, 123587], [73, 123725], [77, 123925], [81, 124085], [88, 124325], [97, 125065], [101, 125265], [105, 125625], [109, 125825], [118, 126225], [125, 126685], [130, 126925], [135, 127065], [140, 127305], [143, 127565]]}, {"verse": 18, "start": 128285, "end": 133077, "text": "¶ Then said he, To what is the kingdom of God like? and to what shall I compare it?", "words": [[2, 128285], [7, 128534], [12, 128834], [16, 129541], [19, 129659], [24, 129839], [27, 129979], [31, 130139], [39, 130419], [42, 130659], [46, 130899], [52, 131589], [56, 131715], [59, 131855], [64, 132055], [70, 132275], [72, 132415], [80, 132735]]}, {"verse": 19, "start": 133427, "end": 143526, "text": "It is like a grain of mustard seed, which a man took, and cast into his garden; and it grew, and became a large tree; and the fowls of the air lodged in the branches of it.", "words": [[0, 133427], [3, 133545], [6, 133665], [11, 133845], [13, 133965], [19, 134265], [22, 134425], [30, 134745], [36, 135225], [42, 135605], [44, 135725], [48, 135925], [54, 136245], [58, 136565], [63, 136825], [68, 137125], [72, 137305], [80, 137985], [84, 138142], [87, 138242], [93, 138522], [97, 138902], [104, 139202], [106, 139382], [112, 139642], [118, 140491], [122, 140771], [126, 140891], [132, 141371], [135, 141471], [139, 141611], [143, 141891], [150, 142471], [153, 142591], [157, 142671], [166, 143011], [169, 143271]]}, {"verse": 20, "start": 143806, "end": 147376, "text": "And again he said, To what shall I liken the kingdom of God?", "words": [[0, 143806], [4, 143946], [10, 144366], [13, 144446], [19, 145106], [22, 145223], [27, 145403], [33, 145623], [35, 145783], [41, 146143], [45, 146343], [53, 146603], [56, 146823]]}, {"verse": 21, "start": 147726, "end": 153130, "text": "It is like leaven, which a woman took and hid in three measures of meal, till the whole was leavened.", "words": [[0, 147726], [3, 147828], [6, 147948], [11, 148168], [19, 148948], [25, 149128], [27, 149248], [33, 149448], [38, 149748], [42, 150008], [46, 150228], [49, 150388], [55, 150648], [64, 150968], [67, 151168], [73, 151828], [78, 152008], [82, 152148], [88, 152368], [92, 152588]]}, {"verse": 22, "start": 153410, "end": 157889, "text": "And he went through the cities and villages, teaching, and journeying toward Jerusalem.", "words": [[0, 153410], [4, 153549], [7, 153669], [12, 153869], [20, 154049], [24, 154209], [31, 154509], [35, 154729], [45, 155509], [55, 155849], [59, 156194], [70, 156754], [77, 156994]]}, {"verse": 23, "start": 158239, "end": 163056, "text": "Then said one to him, Lord, are there few that be saved? And he said to them,", "words": [[0, 158239], [5, 158464], [10, 158764], [14, 159004], [17, 159244], [22, 159822], [28, 160205], [32, 160265], [38, 160425], [42, 160745], [47, 160965], [50, 161145], [57, 162020], [61, 162151], [64, 162271], [69, 162511], [72, 162711]]}, {"verse": 24, "start": 163256, "end": 169991, "text": "¶ Strive to enter in at the narrow gate: for many, I say to you, will seek to enter in, and shall not be able.", "words": [[2, 163256], [9, 163598], [12, 163858], [18, 164118], [21, 164438], [24, 164578], [28, 164678], [35, 164938], [41, 165721], [45, 165823], [51, 166303], [53, 166523], [57, 166763], [60, 166923], [65, 167463], [70, 167583], [75, 167823], [78, 168043], [84, 168283], [88, 168663], [92, 168983], [98, 169183], [102, 169383], [105, 169603]]}, {"verse": 25, "start": 170341, "end": 183478, "text": "When once the master of the house is risen up, and has shut to the door, and you begin to stand without, and to knock at the door, saying, Lord, Lord, open to us; and he shall answer and say to you, I know you not from where you are:", "words": [[0, 170341], [5, 170513], [10, 170833], [14, 170993], [21, 171333], [24, 171513], [28, 171633], [34, 171893], [37, 172053], [43, 172353], [47, 172653], [51, 173153], [55, 173313], [60, 173573], [63, 173773], [67, 173873], [73, 174593], [77, 174713], [81, 174853], [87, 175113], [90, 175313], [96, 175613], [105, 176053], [109, 176513], [112, 176653], [118, 176933], [121, 177053], [125, 177153], [131, 177493], [139, 177753], [145, 178177], [151, 178456], [156, 178856], [159, 179096], [163, 179764], [167, 179888], [170, 179988], [176, 180168], [183, 180548], [187, 180728], [191, 180948], [194, 181108], [199, 181628], [201, 181828], [206, 182028], [210, 182188], [214, 182428], [219, 182668], [225, 182868], [229, 183088]]}, {"verse": 26, "start": 183828, "end": 189793, "text": "Then shall you begin to say, We have eaten and drunk in your presence, and you have taught in our streets.", "words": [[0, 183828], [5, 184081], [11, 184381], [15, 184541], [21, 184781], [24, 184981], [29, 185701], [32, 185921], [37, 186101], [43, 186361], [47, 186621], [53, 186941], [56, 187121], [61, 187221], [71, 188121], [75, 188201], [79, 188341], [84, 188441], [91, 188701], [94, 188981], [98, 189101]]}, {"verse": 27, "start": 190143, "end": 197232, "text": "But he shall say, I tell you, I know you not from where you are; depart from me, all you workers of iniquity.", "words": [[0, 190143], [4, 190268], [7, 190408], [13, 190628], [18, 191268], [20, 191508], [25, 191768], [30, 192328], [32, 192508], [37, 192728], [41, 192908], [45, 193128], [50, 193388], [56, 193588], [60, 193808], [65, 194490], [72, 194850], [77, 195070], [81, 195650], [85, 195830], [89, 196030], [97, 196350], [100, 196610]]}, {"verse": 28, "start": 197582, "end": 207416, "text": "There shall be weeping and gnashing of teeth, when you shall see Abraham, and Isaac, and Jacob, and all the prophets, in the kingdom of God, and you yourselves thrust out.", "words": [[0, 197582], [6, 197769], [12, 198009], [15, 198189], [23, 198669], [27, 198829], [36, 199249], [39, 199429], [46, 200229], [51, 200309], [55, 200449], [61, 200669], [65, 200909], [74, 201329], [78, 201809], [85, 202169], [89, 202469], [96, 202809], [100, 203089], [104, 203329], [108, 203489], [118, 203889], [121, 204409], [125, 204509], [133, 204789], [136, 205029], [141, 205738], [145, 205885], [149, 206025], [160, 206485], [167, 206865]]}, {"verse": 29, "start": 207766, "end": 215429, "text": "And they shall come from the east, and from the west, and from the north, and from the south, and shall sit down in the kingdom of God.", "words": [[0, 207766], [4, 207911], [9, 208051], [15, 208271], [20, 208551], [25, 208751], [29, 208931], [35, 209591], [39, 209811], [44, 209991], [48, 210131], [54, 210831], [58, 211011], [63, 211191], [67, 211331], [74, 212011], [78, 212151], [83, 212331], [87, 212491], [94, 213191], [98, 213351], [104, 213531], [108, 213731], [113, 214111], [116, 214271], [120, 214391], [128, 214651], [131, 214891]]}, {"verse": 30, "start": 215779, "end": 221302, "text": "And, behold, there are last which shall be first, and there are first which shall be last.", "words": [[0, 215779], [5, 215942], [13, 216742], [19, 217062], [23, 217202], [28, 217622], [34, 217882], [40, 218182], [43, 218342], [50, 219082], [54, 219402], [60, 219562], [64, 219682], [70, 220022], [76, 220382], [82, 220662], [85, 220802]]}, {"verse": 31, "start": 221582, "end": 228767, "text": "¶ The same day there came certain of the Pharisees, saying to him, Get out, and depart from here: for Herod will kill you.", "words": [[2, 221582], [6, 221696], [11, 221996], [15, 222256], [21, 222436], [26, 222656], [34, 223036], [37, 223216], [41, 223316], [52, 224076], [59, 224496], [62, 224736], [67, 225715], [71, 225844], [76, 226084], [80, 226304], [87, 226604], [92, 226904], [98, 227534], [102, 227664], [108, 228084], [113, 228244], [118, 228464]]}, {"verse": 32, "start": 229047, "end": 238943, "text": "And he said to them, Go, and tell that fox, Behold, I cast out demons, and I do cures today and tomorrow, and the third day I shall be perfected.", "words": [[0, 229047], [4, 229178], [7, 229298], [12, 229538], [15, 229738], [21, 230283], [25, 230579], [29, 230839], [34, 231079], [39, 231319], [44, 231979], [52, 232859], [54, 232999], [59, 233419], [63, 233599], [71, 234459], [75, 234559], [77, 234679], [80, 234839], [86, 235259], [92, 235659], [96, 235979], [106, 236799], [110, 236919], [114, 237059], [120, 237299], [124, 237619], [126, 237839], [132, 238059], [135, 238219]]}, {"verse": 33, "start": 239293, "end": 246420, "text": "Nevertheless I must walk today, and tomorrow, and the day following: for it cannot be that a prophet perish out of Jerusalem.", "words": [[0, 239293], [13, 240030], [15, 240210], [20, 240390], [25, 240690], [32, 241030], [36, 241570], [46, 241970], [50, 242450], [54, 242550], [58, 242730], [69, 243555], [73, 243696], [76, 243796], [83, 244036], [86, 244336], [91, 244516], [93, 244616], [101, 244976], [108, 245436], [112, 245636], [115, 245736]]}, {"verse": 34, "start": 246770, "end": 258681, "text": "O Jerusalem, Jerusalem, which kill the prophets, and stone them that are sent to you; how often would I have gathered your children together, as a hen does gather her brood under her wings, and you would not!", "words": [[0, 246770], [2, 246993], [13, 247913], [24, 248673], [30, 248773], [35, 249073], [39, 249233], [49, 249653], [53, 250153], [59, 250493], [64, 250713], [69, 250913], [73, 251013], [78, 251213], [81, 251433], [86, 251955], [90, 252119], [96, 252499], [102, 252759], [104, 252919], [109, 253039], [118, 253379], [123, 253579], [132, 253959], [142, 254839], [145, 254999], [147, 255119], [151, 255299], [156, 255599], [163, 256019], [167, 256239], [173, 256639], [179, 256799], [183, 256979], [190, 257659], [194, 257839], [198, 258039], [204, 258199]]}, {"verse": 35, "start": 259031, "end": 269375, "text": "Behold, your house is left to you desolate: and indeed I say to you, You shall not see me, until the time come when you shall say, Blessed is he that comes in the name of the Lord.", "words": [[0, 259031], [8, 259536], [13, 259616], [19, 259956], [22, 260196], [27, 260436], [30, 260696], [34, 260856], [44, 261803], [48, 261967], [55, 262287], [57, 262507], [61, 262747], [64, 262967], [69, 263487], [73, 263627], [79, 263827], [83, 264047], [87, 264327], [91, 264847], [97, 265087], [101, 265267], [106, 265547], [111, 265807], [116, 266027], [120, 266147], [126, 266307], [131, 266947], [139, 267227], [142, 267547], [145, 267707], [150, 267907], [156, 268147], [159, 268347], [163, 268427], [168, 268687], [171, 268827], [175, 268947]]}]}