{"book": "JHN", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 358256, "verses": [{"verse": 1, "start": 300, "end": 9322, "text": "Y pasadas estas cosas andaba Jesús en Galilea: que no quería andar en Judea, porque los judíos procuraban matarle.", "words": [[0, 300], [2, 407], [10, 967], [16, 1227], [22, 1727], [29, 2427], [35, 2807], [38, 3267], [47, 4303], [51, 4386], [54, 4546], [61, 4926], [67, 5386], [70, 5626], [77, 6346], [84, 6966], [88, 7226], [95, 7726], [106, 8426]]}, {"verse": 2, "start": 9672, "end": 13727, "text": "Y estaba cerca la fiesta de los judíos, la de los tabernáculos.", "words": [[0, 9672], [2, 9923], [9, 10203], [15, 10643], [18, 10923], [25, 11283], [28, 11403], [32, 11523], [40, 12323], [43, 12443], [46, 12543], [50, 13166]]}, {"verse": 3, "start": 14077, "end": 21433, "text": "Y le dijeron sus hermanos: Pásate de aquí, y vete a Judea, para que también tus discípulos vean las obras que haces.", "words": [[0, 14077], [2, 14201], [5, 14321], [13, 14821], [17, 14981], [27, 16023], [34, 16413], [37, 16593], [43, 16913], [45, 17213], [50, 17513], [52, 17633], [59, 18093], [64, 18713], [68, 18873], [76, 19213], [80, 19473], [91, 20053], [96, 20453], [100, 20573], [106, 20833], [110, 21053]]}, {"verse": 4, "start": 21783, "end": 28323, "text": "Que ninguno que busca ser conocido públicamente, hace algo en oculto. Si estas cosas haces, manifiéstate al mundo.", "words": [[0, 21783], [4, 21862], [12, 22302], [16, 22462], [22, 22722], [26, 22962], [35, 23482], [49, 24222], [54, 24602], [59, 24862], [62, 24982], [70, 25747], [73, 25886], [79, 26066], [85, 26346], [92, 27086], [105, 27706], [108, 27846]]}, {"verse": 5, "start": 28603, "end": 31516, "text": "Porque ni aun sus hermanos creían en él.", "words": [[0, 28603], [7, 28847], [10, 29147], [14, 29387], [18, 29707], [27, 30427], [34, 30907], [37, 31067]]}, {"verse": 6, "start": 31866, "end": 37786, "text": "Les dice entonces Jesús: Mi tiempo aún no ha venido; pero vuestro tiempo siempre es oportuno.", "words": [[0, 32000], [4, 32166], [9, 32333], [18, 32773], [25, 33751], [28, 33878], [35, 34258], [39, 34558], [42, 34838], [45, 34938], [53, 35691], [58, 35838], [66, 36198], [73, 36498], [81, 36838], [84, 37038]]}, {"verse": 7, "start": 38136, "end": 46821, "text": "No puede el mundo aborreceros a vosotros; pero a mí me aborrece, porque yo doy testimonio de él, que sus obras son malas.", "words": [[0, 38136], [3, 38263], [9, 38623], [12, 39063], [18, 39563], [30, 40583], [32, 40703], [42, 41716], [47, 41860], [49, 42000], [52, 42140], [55, 42670], [65, 43200], [72, 43560], [75, 43800], [79, 44040], [90, 44740], [93, 44900], [97, 45220], [101, 45300], [105, 45460], [111, 45820], [115, 46120]]}, {"verse": 8, "start": 47171, "end": 54626, "text": "Vosotros subid a esta fiesta; yo no subo aún a esta fiesta, porque mi tiempo aún no es cumplido.", "words": [[0, 47171], [9, 47691], [15, 48225], [17, 48758], [22, 48958], [30, 49871], [33, 50049], [36, 50209], [41, 50629], [45, 50809], [47, 51009], [52, 51169], [60, 51929], [67, 52409], [70, 52629], [77, 53029], [81, 53289], [84, 53609], [87, 53809]]}, {"verse": 9, "start": 54976, "end": 57689, "text": "Y habiéndoles dicho esto, se quedó en Galilea.", "words": [[0, 54976], [2, 55125], [14, 55625], [20, 55925], [26, 56245], [29, 56485], [35, 56825], [38, 56925]]}, {"verse": 10, "start": 58039, "end": 65580, "text": "Pero como sus hermanos hubieron subido, entonces él también subió a la fiesta, no abiertamente, sino como en secreto.", "words": [[0, 58039], [5, 58203], [10, 58463], [14, 58663], [23, 59223], [32, 59563], [40, 60523], [49, 60843], [52, 61283], [60, 61643], [66, 62223], [68, 62323], [71, 62403], [79, 63123], [82, 63303], [96, 64123], [101, 64423], [106, 64743], [109, 64903]]}, {"verse": 11, "start": 65930, "end": 71157, "text": "Y le buscaban los judíos en la fiesta, y decían: ¿Dónde está aquel?", "words": [[0, 65930], [2, 66054], [5, 66134], [14, 66654], [18, 66814], [25, 67334], [28, 67494], [31, 67614], [39, 68154], [41, 68734], [49, 69554], [56, 69837], [61, 70077]]}, {"verse": 12, "start": 71437, "end": 80994, "text": "Y había grande murmullo de él entre la gente: porque unos decían: Bueno es; y otros decían: No, antes engaña a la gente.", "words": [[0, 71437], [2, 71553], [8, 71733], [15, 72213], [24, 72893], [27, 73033], [30, 73273], [36, 73673], [39, 73853], [46, 74670], [53, 74954], [58, 75374], [66, 76885], [72, 77179], [76, 77699], [78, 77865], [84, 78045], [92, 79161], [96, 79406], [102, 79746], [109, 80286], [111, 80386], [114, 80426]]}, {"verse": 13, "start": 81274, "end": 85694, "text": "Pero ninguno hablaba abiertamente de él, por miedo de los judíos.", "words": [[0, 81274], [5, 81440], [13, 81920], [21, 82320], [34, 83060], [37, 83240], [41, 83660], [45, 84280], [51, 84640], [54, 84840], [58, 84960]]}, {"verse": 14, "start": 86044, "end": 89685, "text": "Y al medio de la fiesta subió Jesús al templo, y enseñaba.", "words": [[0, 86044], [2, 86141], [5, 86241], [11, 86481], [14, 86661], [17, 86761], [24, 87081], [30, 87481], [36, 87761], [39, 88081], [47, 88661], [49, 88761]]}, {"verse": 15, "start": 90035, "end": 95598, "text": "Y se maravillaban los judíos, diciendo: ¿Cómo tiene este conocimientos, sin haber estudiado?", "words": [[0, 90035], [2, 90142], [5, 90282], [18, 90982], [22, 91142], [30, 91722], [40, 92749], [46, 92909], [52, 93249], [57, 93729], [72, 94209], [76, 94629], [82, 94869]]}, {"verse": 16, "start": 95878, "end": 101463, "text": "Les respondió Jesús, y dijo: Mi doctrina no es mía, sino de aquel que me envió.", "words": [[0, 95878], [4, 96033], [14, 96593], [21, 97033], [23, 97452], [29, 98037], [32, 98164], [41, 98684], [44, 98944], [47, 99084], [52, 99744], [57, 99944], [60, 100184], [66, 100564], [70, 100724], [73, 100864]]}, {"verse": 17, "start": 101813, "end": 109454, "text": "El que quiera hacer la voluntad de Dios, conocerá si la doctrina es de Dios, o si yo hablo de mí mismo.", "words": [[0, 101813], [3, 101959], [7, 102119], [14, 102559], [20, 102959], [23, 103199], [32, 103859], [35, 104019], [41, 104839], [50, 105779], [53, 105879], [56, 106059], [65, 106559], [68, 106839], [71, 106979], [77, 107319], [79, 107839], [82, 107999], [85, 108239], [91, 108599], [94, 108739], [97, 108879]]}, {"verse": 18, "start": 109804, "end": 120747, "text": "El que habla de sí mismo, su propia gloria busca; pero el que busca la gloria del que le envió, este es verdadero, y no hay en él injusticia.", "words": [[0, 109804], [3, 109927], [7, 110067], [13, 110307], [16, 110507], [19, 110707], [26, 111087], [29, 111527], [36, 111987], [43, 112467], [50, 113309], [55, 113472], [58, 113612], [62, 113712], [68, 113992], [71, 114212], [78, 114612], [82, 114792], [86, 114992], [89, 115172], [96, 116112], [101, 116652], [104, 116912], [115, 117732], [117, 118152], [120, 118372], [124, 118732], [127, 119232], [130, 119452]]}, {"verse": 19, "start": 121097, "end": 127676, "text": "¿No os dio Moisés la ley, y ninguno de vosotros cumple la ley? ¿Por qué me procuráis matar?", "words": [[0, 121097], [4, 121326], [7, 121486], [11, 121746], [18, 122346], [21, 122686], [26, 123006], [28, 123446], [36, 123946], [39, 124046], [48, 124496], [55, 124946], [58, 125066], [63, 125990], [68, 126094], [72, 126294], [75, 126434], [85, 127074]]}, {"verse": 20, "start": 128026, "end": 132209, "text": "Respondió la gente, y dijo: Demonio tienes: ¿quién te procura matar?", "words": [[0, 128026], [10, 128571], [13, 128691], [20, 128991], [22, 129211], [28, 129902], [36, 130346], [44, 131090], [51, 131294], [54, 131354], [62, 131714]]}, {"verse": 21, "start": 132489, "end": 138239, "text": "Jesús respondió, y les dijo: Una obra hice, y todos os maravilláis.", "words": [[0, 132489], [6, 132842], [17, 133882], [19, 134142], [23, 134242], [29, 134984], [33, 135208], [38, 135568], [44, 136028], [46, 136588], [52, 136908], [55, 137188]]}, {"verse": 22, "start": 138589, "end": 147354, "text": "Cierto, Moisés os dio la circuncisión (no porque sea de Moisés, sino de los padres); y en sábado circuncidáis al hombre.", "words": [[0, 138589], [8, 139073], [15, 139633], [18, 139953], [22, 140233], [25, 140413], [38, 141833], [42, 141913], [49, 142233], [53, 142493], [56, 142653], [64, 143413], [69, 143693], [72, 143873], [76, 144013], [85, 144903], [87, 145052], [90, 145192], [97, 145772], [110, 146672], [113, 146872]]}, {"verse": 23, "start": 147704, "end": 160284, "text": "Si recibe el hombre la circuncisión en sábado, para que la ley de Moisés no sea quebrantada, ¿os enojáis conmigo porque en sábado hice sano todo un hombre?", "words": [[0, 147704], [3, 147855], [10, 148435], [13, 148595], [20, 148875], [23, 149335], [36, 150315], [39, 150475], [47, 151095], [52, 151875], [56, 152055], [59, 152195], [63, 152395], [66, 152535], [73, 152955], [76, 153575], [80, 153815], [93, 155135], [97, 155875], [105, 156635], [113, 157335], [120, 157675], [123, 157895], [130, 158495], [135, 158795], [140, 159175], [145, 159455], [148, 159715]]}, {"verse": 24, "start": 160634, "end": 165670, "text": "No juzguéis según lo que parece, sino juzgad con justicia.", "words": [[0, 160634], [3, 160802], [12, 161482], [18, 161942], [21, 162202], [25, 162322], [33, 163382], [38, 163722], [45, 164442], [49, 164742]]}, {"verse": 25, "start": 166020, "end": 172054, "text": "Decían entonces unos de los de Jerusalén: ¿No es este al que buscan para matarlo?", "words": [[0, 166020], [7, 166546], [16, 167106], [21, 167886], [24, 168286], [28, 168446], [31, 168766], [42, 169868], [46, 170068], [49, 170308], [54, 170588], [57, 170688], [61, 170828], [68, 171228], [73, 171408]]}, {"verse": 26, "start": 172404, "end": 179300, "text": "Y he aquí, habla públicamente, y no le dicen nada; ¿Habrán entendido verdaderamente los dirigentes, que este es el Cristo?", "words": [[0, 172404], [2, 172515], [5, 172665], [11, 172925], [17, 173185], [31, 173985], [33, 174265], [36, 174385], [39, 174485], [45, 174725], [51, 175505], [59, 175985], [69, 176485], [84, 177185], [88, 177405], [100, 178025], [104, 178285], [109, 178465], [112, 178605], [115, 178725]]}, {"verse": 27, "start": 179650, "end": 185179, "text": "Pero este, sabemos de dónde es; mas cuando venga el Cristo, nadie sabrá de dónde sea.", "words": [[0, 179650], [5, 179950], [11, 180170], [19, 180570], [22, 180770], [28, 180890], [32, 181668], [36, 181845], [43, 182045], [49, 182505], [52, 182625], [60, 183485], [66, 183785], [72, 184305], [75, 184465], [81, 184605]]}, {"verse": 28, "start": 185459, "end": 199784, "text": "Entonces clamaba Jesús en el templo, enseñando y diciendo: Y a mí me conocéis, y sabéis de dónde soy; y no he venido de mí mismo; pero el que me envió es verdadero, al cual vosotros no conocéis.", "words": [[0, 185459], [9, 186447], [17, 186967], [23, 187287], [26, 187627], [29, 187787], [37, 188587], [47, 189307], [49, 189427], [59, 190343], [61, 190491], [63, 190531], [66, 190671], [69, 190831], [79, 191531], [81, 191871], [88, 192291], [91, 192431], [97, 192631], [102, 193442], [104, 193570], [107, 193750], [110, 193890], [117, 194310], [120, 194450], [123, 194610], [130, 195469], [135, 195653], [138, 195813], [142, 195973], [145, 196173], [151, 196553], [154, 196693], [165, 197173], [168, 197653], [173, 197873], [182, 198493], [185, 198753]]}, {"verse": 29, "start": 200134, "end": 203576, "text": "Yo le conozco, porque de él soy, y él me envió.", "words": [[0, 200134], [3, 200320], [6, 200460], [15, 201020], [22, 201360], [25, 201560], [28, 201680], [33, 202120], [35, 202660], [38, 202860], [41, 203040]]}, {"verse": 30, "start": 203926, "end": 210426, "text": "Entonces procuraban prenderle; pero ninguno puso en él mano, porque aún no había venido su hora.", "words": [[0, 203926], [9, 204409], [20, 205289], [31, 206539], [36, 206701], [44, 207161], [49, 207541], [52, 207681], [55, 207801], [61, 208141], [68, 208521], [72, 208801], [75, 209001], [81, 209261], [88, 209701], [91, 209921]]}, {"verse": 31, "start": 210776, "end": 218924, "text": "Y muchos del pueblo creyeron en él, y decían: El Cristo, cuando venga, ¿hará más señales que las que este hace?", "words": [[0, 210776], [2, 211059], [9, 211359], [13, 211619], [20, 211999], [29, 212839], [32, 212979], [36, 213579], [38, 214019], [46, 215128], [49, 215255], [57, 215575], [64, 215835], [71, 216375], [77, 217075], [81, 217195], [89, 217675], [93, 217875], [97, 218015], [101, 218215], [106, 218455]]}, {"verse": 32, "start": 219204, "end": 229053, "text": "Los fariseos oyeron a la gente que murmuraba de él estas cosas; y los príncipes de los sacerdotes y los fariseos enviaron guardias que lo arrestaran.", "words": [[0, 219204], [4, 219581], [13, 219991], [20, 220491], [22, 220651], [25, 220731], [31, 221071], [35, 221331], [45, 222071], [48, 222291], [51, 222511], [57, 222711], [64, 223786], [66, 223873], [70, 223973], [80, 224573], [83, 224693], [87, 224813], [98, 225513], [100, 225693], [104, 225813], [113, 226573], [122, 227293], [131, 227953], [135, 228073], [138, 228233]]}, {"verse": 33, "start": 229403, "end": 234818, "text": "Y Jesús dijo: Aun un poco de tiempo estaré con vosotros, e iré al que me envió.", "words": [[0, 229403], [2, 229527], [8, 229847], [14, 230700], [18, 230938], [21, 231138], [26, 231378], [29, 231538], [36, 231778], [43, 232298], [47, 232438], [57, 233058], [59, 233478], [63, 233838], [66, 233978], [70, 234138], [73, 234298]]}, {"verse": 34, "start": 235168, "end": 240621, "text": "Me buscaréis, y no me hallaréis; y donde yo estaré, vosotros no podréis venir.", "words": [[0, 235168], [3, 235273], [14, 236033], [16, 236513], [19, 236673], [22, 237208], [33, 237902], [35, 238000], [41, 238180], [44, 238420], [52, 239140], [61, 239620], [64, 239800], [72, 240240]]}, {"verse": 35, "start": 240971, "end": 249772, "text": "Entonces los judíos dijeron entre sí: ¿A dónde se ha de ir este que no le hallemos? ¿Se ha de ir a los esparcidos entre los griegos, y a enseñar a los griegos?", "words": [[0, 240971], [9, 241591], [13, 242151], [20, 242611], [28, 243111], [34, 243351], [38, 243975], [41, 244100], [47, 244240], [50, 244380], [53, 244520], [56, 244680], [59, 244800], [64, 245020], [68, 245160], [71, 245280], [74, 245400], [84, 246197], [88, 246355], [91, 246455], [94, 246515], [97, 246615], [99, 246695], [103, 246835], [114, 247415], [120, 247675], [124, 247855], [133, 248335], [135, 248535], [137, 248595], [145, 248975], [147, 248995], [151, 249135]]}, {"verse": 36, "start": 250122, "end": 256672, "text": "¿Qué dicho es este que dijo: Me buscaréis, y no me hallaréis; y donde yo estaré, vosotros no podréis venir?", "words": [[0, 250122], [5, 250226], [11, 250446], [14, 250606], [19, 250846], [23, 250986], [29, 251889], [32, 251969], [43, 252529], [45, 252729], [48, 252849], [51, 252989], [62, 253775], [64, 253872], [70, 254032], [73, 254252], [81, 254892], [90, 255252], [93, 255432], [101, 255832]]}, {"verse": 37, "start": 256952, "end": 265999, "text": "Pero en el último día grande de la fiesta, Jesús se ponía en pie y clamaba, diciendo: Si alguno tiene sed, venga a mí y beba.", "words": [[0, 256952], [5, 257095], [8, 257255], [11, 257355], [18, 257615], [22, 258015], [29, 258375], [32, 258595], [35, 258715], [43, 259535], [49, 259975], [52, 260535], [58, 260975], [61, 261135], [65, 261415], [67, 261715], [76, 262275], [86, 263301], [89, 263594], [96, 264034], [102, 264214], [107, 264774], [113, 265054], [115, 265234], [118, 265374], [120, 265574]]}, {"verse": 38, "start": 266349, "end": 272235, "text": "El que cree en mí, como dice la Escritura, ríos de agua viva correrán de su vientre.", "words": [[0, 266349], [3, 266496], [7, 266636], [12, 266916], [15, 267136], [19, 267796], [24, 267956], [29, 268256], [32, 268456], [43, 269166], [48, 269876], [51, 270016], [56, 270276], [61, 270656], [70, 271256], [73, 271376], [76, 271536]]}, {"verse": 39, "start": 272585, "end": 282304, "text": "(Y esto dijo del Espíritu que habían de recibir los que creyesen en él: pues aún no había venido el Espíritu Santo; porque Jesús no estaba aún glorificado.)", "words": [[0, 272585], [3, 272923], [8, 273143], [13, 273423], [17, 273643], [26, 274183], [30, 274303], [37, 274543], [40, 274763], [48, 275143], [52, 275403], [56, 275543], [65, 276163], [68, 276263], [72, 276866], [77, 276987], [81, 277247], [84, 277487], [90, 277727], [97, 278187], [100, 278287], [109, 278787], [116, 279612], [123, 279798], [129, 280198], [132, 280678], [139, 280998], [143, 281318]]}, {"verse": 40, "start": 282654, "end": 289693, "text": "Entonces algunos de la multitud, oyendo este dicho, decían: Verdaderamente este es el profeta.", "words": [[0, 282654], [9, 283492], [17, 283952], [20, 284172], [23, 284272], [33, 285232], [40, 285592], [45, 285872], [52, 286792], [60, 287712], [75, 288434], [80, 288774], [83, 288954], [86, 289094]]}, {"verse": 41, "start": 289973, "end": 296683, "text": "Otros decían: Este es el Cristo. Pero algunos decían: ¿De Galilea ha de venir el Cristo?", "words": [[0, 289973], [6, 290344], [14, 291572], [19, 291878], [22, 292218], [25, 292358], [33, 293197], [38, 293361], [46, 293741], [54, 294819], [58, 294946], [66, 295201], [69, 295456], [72, 295711], [78, 295966], [81, 296066]]}, {"verse": 42, "start": 297033, "end": 303355, "text": "¿No dice la Escritura, que del linaje de David, y de la aldea de Belén, de donde era David, vendrá el Cristo?", "words": [[0, 297033], [4, 297136], [9, 297336], [12, 297496], [23, 297976], [27, 298216], [31, 298356], [38, 298816], [41, 298936], [48, 299256], [50, 299576], [53, 299676], [56, 299816], [62, 300116], [65, 300256], [72, 300676], [75, 301096], [81, 301336], [85, 301576], [92, 301976], [99, 302636], [102, 302756]]}, {"verse": 43, "start": 303635, "end": 306640, "text": "Así que había división entre la gente acerca de él.", "words": [[0, 303635], [4, 303870], [8, 304070], [14, 304290], [23, 304930], [29, 305170], [32, 305370], [38, 305650], [45, 306030], [48, 306390]]}, {"verse": 44, "start": 306990, "end": 312356, "text": "Y algunos de ellos querían prenderle; pero ninguno echó sobre él manos.", "words": [[0, 307095], [2, 307200], [10, 307760], [13, 308040], [19, 308280], [27, 308720], [38, 309874], [43, 310018], [51, 310698], [56, 311198], [62, 311518], [65, 311718]]}, {"verse": 45, "start": 312706, "end": 320545, "text": "Y los guardias vinieron a los principales sacerdotes y a los fariseos; y ellos les dijeron: ¿Por qué no le trajisteis?", "words": [[0, 312706], [2, 312876], [6, 313036], [15, 313496], [24, 314116], [26, 314296], [30, 314396], [42, 315116], [53, 315956], [55, 316196], [57, 316296], [61, 316416], [71, 317565], [73, 317749], [79, 318019], [83, 318289], [92, 319181], [97, 319303], [101, 319543], [104, 319643], [107, 319723]]}, {"verse": 46, "start": 320825, "end": 324967, "text": "Los guardias respondieron: Nunca ha hablado hombre así como este hombre.", "words": [[0, 320825], [4, 320951], [13, 321531], [27, 322947], [33, 323269], [36, 323369], [44, 323669], [51, 323889], [55, 324089], [60, 324329], [65, 324569]]}, {"verse": 47, "start": 325247, "end": 330852, "text": "Entonces los fariseos les respondieron: ¿Estáis también vosotros engañados?", "words": [[0, 325247], [9, 325832], [13, 326492], [22, 327292], [26, 327572], [40, 328788], [48, 329129], [56, 329449], [65, 329909]]}, {"verse": 48, "start": 331202, "end": 334444, "text": "¿Ha creído en él alguno de los dirigentes, o de los fariseos?", "words": [[0, 331202], [4, 331305], [11, 331665], [14, 331785], [17, 331885], [24, 332285], [27, 332365], [31, 332485], [43, 333145], [45, 333405], [48, 333505], [52, 333625]]}, {"verse": 49, "start": 334794, "end": 337456, "text": "Pero esta gente que no sabe la ley, maldita es.", "words": [[0, 334794], [5, 334915], [10, 335135], [16, 335455], [20, 335675], [23, 335795], [28, 336035], [31, 336195], [36, 336615], [44, 337035]]}, {"verse": 50, "start": 337735, "end": 342575, "text": "Les dice Nicodemo (el que vino a él de noche, el cual era uno de ellos):", "words": [[0, 337800], [4, 337900], [9, 338140], [18, 338922], [22, 339025], [26, 339165], [31, 339385], [33, 339565], [36, 339685], [39, 339825], [46, 340665], [49, 340825], [54, 341105], [58, 341565], [62, 341925], [65, 342145]]}, {"verse": 51, "start": 342775, "end": 347525, "text": "¿Juzga nuestra ley a hombre, si primero no oye de él, y entiende lo que ha hecho?", "words": [[0, 342775], [7, 343161], [15, 343361], [19, 343801], [21, 343941], [29, 344241], [32, 344661], [40, 345041], [43, 345281], [47, 345541], [50, 345701], [54, 345941], [56, 346261], [65, 346701], [68, 346861], [72, 347001], [75, 347121]]}, {"verse": 52, "start": 347805, "end": 355511, "text": "Respondieron y le dijeron: ¿Eres tú también galileo? Escudriña y ve que de Galilea nunca se levantó profeta.", "words": [[0, 347805], [13, 348610], [15, 349030], [18, 349150], [27, 350030], [33, 350254], [36, 350494], [44, 350854], [53, 351829], [63, 352611], [65, 352931], [68, 353071], [72, 353231], [75, 353371], [83, 353911], [89, 354191], [92, 354491], [100, 354991]]}, {"verse": 53, "start": 355791, "end": 357856, "text": "Y se fue cada uno a su casa.", "words": [[0, 355791], [2, 355917], [5, 356057], [9, 356277], [14, 356577], [18, 356917], [20, 357117], [23, 357217]]}]}