{"book": "RUT", "chapter": 1, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 206521, "verses": [{"verse": 1, "start": 300, "end": 12320, "text": "Now it came to pass in the days when the judges ruled, that there was a famine in the land. And a certain man of Beth-lehem-judah went to sojourn in the country of Moab, he, and his wife, and his two sons.", "words": [[0, 300], [4, 522], [7, 662], [12, 882], [15, 1082], [20, 1382], [23, 1602], [27, 1722], [32, 2042], [37, 2282], [41, 2402], [48, 2722], [55, 3182], [60, 3417], [66, 3557], [70, 3737], [72, 3857], [79, 4217], [82, 4437], [86, 4537], [92, 5208], [96, 5351], [98, 5511], [106, 5751], [110, 6151], [113, 6741], [130, 7331], [135, 7671], [138, 7911], [146, 8451], [149, 8531], [153, 8611], [161, 8931], [164, 9171], [170, 9831], [174, 10031], [178, 10371], [182, 10531], [188, 10811], [192, 11371], [196, 11511], [200, 11711]]}, {"verse": 2, "start": 12670, "end": 26415, "text": "And the name of the man was Elimelech, and the name of his wife Naomi, and the name of his two sons Mahlon and Chilion, Ephrathites of Beth-lehem-judah. And they came into the country of Moab, and continued there.", "words": [[0, 12670], [4, 12824], [8, 12924], [13, 13144], [16, 13324], [20, 13424], [24, 13764], [28, 14064], [39, 15024], [43, 15344], [47, 15444], [52, 15644], [55, 15784], [59, 15904], [64, 16144], [71, 17184], [75, 17404], [79, 17524], [84, 17684], [87, 17864], [91, 17984], [95, 18184], [100, 18764], [107, 19344], [111, 19991], [120, 20637], [132, 21284], [135, 22011], [153, 22904], [157, 23052], [162, 23152], [167, 23372], [172, 23592], [176, 23732], [184, 24072], [187, 24252], [193, 24772], [197, 25332], [207, 25832]]}, {"verse": 3, "start": 26765, "end": 31716, "text": "And Elimelech Naomi’s husband died; and she was left, and her two sons.", "words": [[0, 26765], [4, 27140], [14, 27550], [22, 28170], [30, 28430], [36, 29365], [40, 29488], [44, 29648], [48, 29828], [54, 30228], [58, 30648], [62, 30808], [66, 30968]]}, {"verse": 4, "start": 32066, "end": 40882, "text": "And they took them wives of the women of Moab; the name of the one was Orpah, and the name of the other Ruth: and they dwelled there about ten years.", "words": [[0, 32066], [4, 32326], [9, 32466], [14, 32666], [19, 32886], [25, 33246], [28, 33526], [32, 33646], [38, 33906], [41, 34126], [47, 35069], [51, 35159], [56, 35479], [59, 35639], [63, 35759], [67, 36019], [71, 36655], [78, 37291], [82, 37404], [86, 37544], [91, 37744], [94, 37884], [98, 38024], [104, 38244], [110, 38914], [114, 39021], [119, 39121], [127, 39541], [133, 39721], [139, 39981], [143, 40281]]}, {"verse": 5, "start": 41232, "end": 47477, "text": "And Mahlon and Chilion died also both of them; and the woman was left of her two sons and her husband.", "words": [[0, 41232], [4, 41574], [11, 41944], [15, 42274], [23, 42604], [28, 42804], [33, 43344], [38, 43484], [41, 43704], [47, 44257], [51, 44392], [55, 44512], [61, 44772], [65, 45072], [70, 45372], [73, 45632], [77, 45772], [81, 46032], [86, 46452], [90, 46712], [94, 46852]]}, {"verse": 6, "start": 47827, "end": 59062, "text": "¶ Then she arose with her daughters in law, that she might return from the country of Moab: for she had heard in the country of Moab how that the LORD had visited his people in giving them bread.", "words": [[2, 47827], [7, 48052], [11, 48252], [17, 48612], [22, 48952], [26, 49092], [36, 49452], [39, 49712], [44, 49972], [49, 50512], [53, 50712], [59, 50912], [66, 51352], [71, 51572], [75, 51732], [83, 52092], [86, 52312], [92, 53210], [96, 53324], [100, 53524], [104, 53724], [110, 53984], [113, 54164], [117, 54264], [125, 54584], [128, 54784], [133, 55344], [137, 55904], [142, 56124], [146, 56264], [151, 56504], [155, 56704], [163, 57084], [167, 57384], [174, 57784], [177, 58024], [184, 58244], [189, 58524]]}, {"verse": 7, "start": 59412, "end": 67661, "text": "Therefore she went forth out of the place where she was, and her two daughters in law with her; and they went on the way to return to the land of Judah.", "words": [[0, 59412], [10, 59709], [14, 60029], [19, 60249], [25, 60589], [29, 60869], [32, 61009], [36, 61129], [42, 61389], [48, 61649], [52, 61869], [57, 62609], [61, 62889], [65, 63029], [69, 63229], [79, 63589], [82, 63869], [86, 64109], [91, 64349], [96, 64831], [100, 64992], [105, 65092], [110, 65292], [113, 65472], [117, 65612], [121, 65792], [124, 65952], [131, 66412], [134, 66592], [138, 66732], [143, 66992], [146, 67132]]}, {"verse": 8, "start": 68011, "end": 78498, "text": "And Naomi said to her two daughters in law, Go, return each to her mother’s house: the LORD deal kindly with you, as you have dealt with the dead, and with me.", "words": [[0, 68011], [4, 68168], [10, 68488], [15, 68908], [18, 69108], [22, 69248], [26, 69468], [36, 69848], [39, 70088], [44, 71627], [48, 71827], [55, 72267], [60, 72607], [63, 72867], [67, 73007], [76, 73467], [83, 74207], [87, 74294], [92, 74534], [97, 74774], [104, 75174], [109, 75514], [114, 76194], [117, 76394], [121, 76534], [126, 76654], [132, 76834], [137, 77014], [141, 77154], [147, 77414], [151, 77894], [156, 78074]]}, {"verse": 9, "start": 78848, "end": 88015, "text": "The LORD grant you that you may find rest, each of you in the house of her husband. Then she kissed them; and they lifted up their voice, and wept.", "words": [[0, 78848], [4, 78988], [9, 79308], [15, 79668], [19, 79968], [24, 80208], [28, 80408], [32, 80628], [37, 80988], [43, 81888], [48, 82128], [51, 82288], [55, 82448], [58, 82648], [62, 82768], [68, 82988], [71, 83168], [75, 83288], [84, 84192], [89, 84455], [93, 84735], [100, 85115], [106, 85658], [110, 85777], [115, 85917], [122, 86257], [125, 86477], [131, 86657], [138, 87057], [142, 87437]]}, {"verse": 10, "start": 88365, "end": 92886, "text": "And they said to her, Surely we will return with you to your people.", "words": [[0, 88365], [4, 88487], [9, 88627], [14, 88847], [17, 89087], [22, 89592], [29, 89892], [32, 90172], [37, 90332], [44, 90692], [49, 90932], [53, 91152], [56, 91372], [61, 91592]]}, {"verse": 11, "start": 93166, "end": 101787, "text": "And Naomi said, Turn again, my daughters: why will you go with me? are there yet any more sons in my womb, that they may be your husbands?", "words": [[0, 93166], [4, 93346], [10, 93746], [16, 94577], [21, 94757], [28, 95077], [31, 95417], [42, 96341], [46, 96587], [51, 96767], [55, 96907], [58, 97087], [63, 97347], [67, 97956], [71, 98066], [77, 98226], [81, 98446], [85, 98646], [90, 99026], [95, 99406], [98, 99506], [101, 99666], [107, 100026], [112, 100306], [117, 100486], [121, 100646], [124, 100826], [129, 100966]]}, {"verse": 12, "start": 102137, "end": 113096, "text": "Turn again, my daughters, go your way; for I am too old to have a husband. If I should say, I have hope, if I should have a husband also tonight, and should also bear sons;", "words": [[0, 102137], [5, 102301], [12, 102561], [15, 102801], [26, 103361], [29, 103481], [34, 103701], [39, 104388], [43, 104476], [45, 104736], [48, 104856], [52, 105076], [56, 105476], [59, 105676], [64, 105856], [66, 105956], [75, 106828], [78, 106971], [80, 107151], [87, 107351], [92, 107811], [94, 107991], [99, 108191], [105, 108891], [108, 109071], [110, 109331], [117, 109511], [122, 109691], [124, 109791], [132, 110051], [137, 110471], [146, 111131], [150, 111491], [157, 111671], [162, 112051], [167, 112371]]}, {"verse": 13, "start": 113446, "end": 123849, "text": "Would you wait for them till they were grown? would you stay for them from having husbands? no, my daughters; for it grieves me much for your sakes that the hand of the LORD is gone out against me.", "words": [[0, 113446], [6, 113552], [10, 113692], [15, 113892], [19, 114092], [24, 114252], [29, 114452], [34, 114632], [39, 114752], [46, 115595], [52, 115703], [56, 115843], [61, 116063], [65, 116283], [70, 116423], [75, 116603], [82, 116823], [92, 117981], [96, 118111], [99, 118351], [110, 119259], [114, 119394], [117, 119534], [125, 119934], [128, 120094], [133, 120354], [137, 120574], [142, 120714], [148, 121174], [153, 121374], [157, 121494], [162, 121774], [165, 121894], [169, 122034], [174, 122334], [177, 122554], [182, 122774], [186, 123034], [194, 123334]]}, {"verse": 14, "start": 124129, "end": 130829, "text": "And they lifted up their voice, and wept again: and Orpah kissed her mother in law; but Ruth clung to her.", "words": [[0, 124129], [4, 124263], [9, 124403], [16, 124743], [19, 124963], [25, 125143], [32, 125503], [36, 125983], [41, 126343], [48, 127103], [52, 127417], [58, 127767], [65, 128127], [69, 128327], [76, 128567], [79, 128767], [84, 129445], [88, 129573], [93, 129853], [99, 130293], [102, 130473]]}, {"verse": 15, "start": 131179, "end": 138604, "text": "And she said, Behold, your sister in law is gone back to her people, and to her gods: return after your sister in law.", "words": [[0, 131179], [4, 131323], [8, 131483], [14, 132518], [22, 132688], [27, 132888], [34, 133268], [37, 133488], [41, 133708], [44, 133908], [49, 134188], [54, 134488], [57, 134668], [61, 134768], [69, 135108], [73, 135588], [76, 135828], [80, 135988], [86, 136873], [93, 137140], [99, 137520], [104, 137720], [111, 138060], [114, 138260]]}, {"verse": 16, "start": 138884, "end": 152777, "text": "And Ruth said, Entreat me not to leave you, or to return from following after you: for where you go, I will go; and where you lodge, I will lodge: your people shall be my people, and your God my God:", "words": [[0, 138884], [4, 139027], [9, 139247], [15, 140095], [23, 140285], [26, 140525], [30, 140805], [33, 141025], [39, 141285], [44, 141885], [47, 142085], [50, 142245], [57, 142625], [62, 142865], [72, 143285], [78, 143725], [83, 144435], [87, 144540], [93, 144720], [97, 144920], [101, 145600], [103, 145760], [108, 145920], [112, 146627], [116, 146747], [122, 146927], [126, 147107], [133, 147847], [135, 148007], [140, 148147], [147, 148940], [152, 149105], [159, 149505], [165, 149865], [168, 150145], [171, 150405], [179, 151025], [183, 151325], [188, 151505], [192, 151845], [195, 152205]]}, {"verse": 17, "start": 153127, "end": 161757, "text": "Where you die, will I die, and there will I be buried: the LORD do so to me, and more also, if anything but death part you and me.", "words": [[0, 153127], [6, 153273], [10, 153573], [15, 154053], [20, 154173], [22, 154493], [27, 155073], [31, 155173], [37, 155353], [42, 155533], [44, 155833], [47, 156013], [55, 156868], [59, 156976], [64, 157216], [67, 157536], [70, 157756], [73, 157936], [77, 158616], [81, 158736], [86, 158956], [92, 159356], [95, 159696], [104, 160076], [108, 160336], [114, 160676], [119, 160976], [123, 161276], [127, 161416]]}, {"verse": 18, "start": 162037, "end": 166843, "text": "When she saw that she was steadfastly minded to go with her, then she left speaking to her.", "words": [[0, 162037], [5, 162163], [9, 162323], [13, 162583], [18, 162763], [22, 162923], [26, 163123], [38, 163803], [45, 164123], [48, 164343], [51, 164463], [56, 164703], [61, 165303], [66, 165503], [70, 165683], [75, 165903], [84, 166283], [87, 166583]]}, {"verse": 19, "start": 167193, "end": 177170, "text": "¶ So they two went until they came to Beth-lehem. And it came to pass, when they were come to Beth-lehem, that all the city was moved about them, and they said, Is this Naomi?", "words": [[2, 167193], [5, 167339], [10, 167499], [14, 167659], [19, 167879], [25, 168159], [30, 168339], [35, 168559], [38, 168719], [50, 169690], [54, 169826], [57, 169926], [62, 170166], [65, 170386], [71, 170906], [76, 171086], [81, 171266], [86, 171406], [91, 171646], [94, 171826], [106, 173026], [111, 173166], [115, 173386], [119, 173546], [124, 173806], [128, 174046], [134, 174306], [140, 174606], [146, 175006], [150, 175126], [155, 175266], [161, 175910], [164, 176134], [169, 176394]]}, {"verse": 20, "start": 177450, "end": 184142, "text": "And she said to them, Call me not Naomi, call me Mara: for the Almighty has dealt very bitterly with me.", "words": [[0, 177450], [4, 177566], [8, 177726], [13, 177966], [16, 178146], [22, 178753], [27, 178957], [30, 179177], [34, 179417], [41, 180337], [46, 180597], [49, 180757], [55, 181578], [59, 181671], [63, 181791], [72, 182231], [76, 182511], [82, 182731], [87, 183091], [96, 183611], [101, 183811]]}, {"verse": 21, "start": 184492, "end": 195119, "text": "I went out full, and the LORD has brought me home again empty: why then do you call me Naomi, seeing the LORD has testified against me, and the Almighty has afflicted me?", "words": [[0, 184492], [2, 184638], [7, 184838], [11, 185038], [17, 185358], [21, 185878], [25, 186018], [30, 186258], [34, 186438], [42, 186658], [45, 186838], [50, 187098], [56, 187358], [63, 188216], [67, 188449], [72, 188689], [75, 188909], [79, 189029], [84, 189309], [87, 189469], [94, 190349], [101, 190589], [105, 190809], [110, 191069], [114, 191269], [124, 191729], [132, 192209], [136, 192949], [140, 193169], [144, 193309], [153, 193769], [157, 194209], [167, 194749]]}, {"verse": 22, "start": 195399, "end": 206121, "text": "So Naomi returned, and Ruth the Moabitess, her daughter in law, with her, which returned out of the country of Moab: and they came to Beth-lehem in the beginning of barley harvest.", "words": [[0, 195399], [3, 195782], [9, 196144], [19, 196864], [23, 197084], [28, 197364], [32, 197924], [43, 198484], [47, 198624], [56, 198924], [59, 199144], [64, 199404], [69, 199644], [74, 200344], [80, 200524], [89, 200924], [93, 201144], [96, 201284], [100, 201384], [108, 201724], [111, 201904], [117, 202792], [121, 203141], [126, 203261], [131, 203501], [134, 203871], [145, 204241], [148, 204521], [152, 204621], [162, 204881], [165, 205081], [172, 205401]]}]}