{"book": "1CO", "chapter": 9, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 192456, "verses": [{"verse": 1, "start": 300, "end": 7583, "text": "Am I not an apostle? am I not free? have I not seen Jesus Christ our Lord? are not you my work in the Lord?", "words": [[0, 300], [3, 462], [5, 582], [9, 802], [12, 1002], [21, 1983], [24, 2140], [26, 2280], [30, 2460], [36, 3321], [41, 3466], [43, 3566], [47, 3746], [52, 4006], [58, 4326], [65, 4766], [69, 5046], [75, 5810], [79, 5954], [83, 6094], [87, 6414], [90, 6614], [95, 6914], [98, 7054], [102, 7154]]}, {"verse": 2, "start": 8033, "end": 14511, "text": "If I be not an apostle to others, yet doubtless I am to you: for the seal of my apostleship are you in the Lord.", "words": [[0, 8033], [3, 8197], [5, 8317], [8, 8437], [12, 8657], [15, 8817], [23, 9137], [26, 9457], [34, 9997], [38, 10157], [48, 10697], [50, 10897], [53, 11037], [56, 11197], [61, 11830], [65, 11937], [69, 12077], [74, 12357], [77, 12497], [80, 12697], [92, 13377], [96, 13657], [100, 13827], [103, 13997], [107, 14137]]}, {"verse": 3, "start": 14961, "end": 17698, "text": "My answer to them that do examine me is this,", "words": [[0, 14961], [3, 15085], [10, 15345], [13, 15565], [18, 15765], [23, 15945], [26, 16185], [34, 16585], [37, 16905], [40, 17185]]}, {"verse": 4, "start": 18148, "end": 20414, "text": "Have we not power to eat and to drink?", "words": [[0, 18148], [5, 18288], [8, 18468], [12, 18608], [18, 18948], [21, 19168], [25, 19448], [29, 19688], [32, 19828]]}, {"verse": 5, "start": 20864, "end": 27980, "text": "Have we not power to lead about a sister, a wife, as well as other apostles, and as the brethren of the Lord, and Cephas?", "words": [[0, 20864], [5, 21000], [8, 21160], [12, 21440], [18, 21720], [21, 21920], [26, 22140], [32, 22360], [34, 22520], [42, 23340], [44, 23400], [50, 24100], [53, 24220], [58, 24400], [61, 24540], [67, 24780], [77, 25220], [81, 25800], [84, 25920], [88, 26040], [97, 26340], [100, 26600], [104, 26720], [110, 27000], [114, 27300]]}, {"verse": 6, "start": 28430, "end": 32032, "text": "Or I only and Barnabas, have not we power to forbear working?", "words": [[0, 28430], [3, 28609], [5, 28729], [10, 29056], [14, 29382], [24, 29709], [29, 30189], [33, 30379], [36, 30569], [42, 30889], [45, 31179], [53, 31469]]}, {"verse": 7, "start": 32482, "end": 41044, "text": "Who goes a warfare any time at his own charges? who plants a vineyard, and eats not of the fruit of it? or who feeds a flock, and eats not of the milk of the flock?", "words": [[0, 32482], [4, 32561], [9, 32741], [11, 32921], [19, 33161], [23, 33401], [28, 33641], [31, 33901], [35, 34041], [39, 34201], [48, 35143], [52, 35220], [59, 35500], [61, 35680], [71, 36100], [75, 36400], [80, 36580], [84, 36820], [87, 36960], [91, 37060], [97, 37260], [100, 37420], [104, 37987], [107, 38083], [111, 38223], [117, 38423], [119, 38583], [126, 38823], [130, 39283], [135, 39483], [139, 39823], [142, 40043], [146, 40143], [151, 40343], [154, 40503], [158, 40603]]}, {"verse": 8, "start": 41494, "end": 45032, "text": "Say I these things as a man? or says not the law the same also?", "words": [[0, 41494], [4, 41654], [6, 41994], [12, 42074], [19, 42314], [22, 42474], [24, 42594], [29, 43302], [32, 43405], [37, 43545], [41, 43785], [45, 43985], [49, 44145], [53, 44285], [58, 44505]]}, {"verse": 9, "start": 45482, "end": 53233, "text": "For it is written in the law of Moses, You shall not muzzle the mouth of the ox that treads out the grain. Does God take care for oxen?", "words": [[0, 45482], [4, 45581], [7, 45721], [10, 45861], [18, 46181], [21, 46381], [25, 46501], [29, 46721], [32, 46861], [39, 47681], [43, 47801], [49, 48001], [53, 48311], [60, 48621], [64, 48801], [70, 49061], [73, 49241], [77, 49441], [80, 49661], [85, 49941], [92, 50221], [96, 50441], [100, 50601], [107, 51381], [112, 51501], [116, 51761], [121, 52041], [126, 52321], [130, 52561]]}, {"verse": 10, "start": 53683, "end": 63587, "text": "Or says he it altogether for our sakes? For our sakes, no doubt, this is written: that he that plows should plow in hope; and that he that threshes in hope should be partaker of his hope.", "words": [[0, 53683], [3, 53941], [8, 54241], [11, 54554], [14, 54868], [25, 55181], [29, 55441], [33, 55581], [40, 56417], [44, 56530], [48, 56650], [55, 57110], [58, 57110], [65, 57510], [70, 57650], [73, 57770], [82, 58443], [87, 58584], [90, 58744], [95, 58964], [101, 59184], [108, 59364], [113, 59664], [116, 59744], [122, 60384], [126, 60488], [131, 60588], [134, 60788], [139, 60948], [148, 61468], [151, 61588], [156, 61808], [163, 62048], [166, 62208], [175, 62828], [178, 63068], [182, 63208]]}, {"verse": 11, "start": 64037, "end": 68929, "text": "If we have sown to you spiritual things, is it a great thing if we shall reap your carnal things?", "words": [[0, 64037], [3, 64180], [6, 64300], [11, 64460], [16, 64800], [19, 64940], [23, 65040], [33, 65420], [41, 66260], [44, 66460], [47, 66560], [49, 66640], [55, 66860], [61, 67100], [64, 67260], [67, 67380], [73, 67540], [78, 67800], [83, 68000], [90, 68360]]}, {"verse": 12, "start": 69379, "end": 79009, "text": "If others be partakers of this power over you, are not we rather? Nevertheless we have not used this power; but endure all things, lest we should hinder the gospel of Christ.", "words": [[0, 69379], [3, 69537], [10, 69777], [13, 69997], [23, 70497], [26, 70737], [31, 70897], [37, 71197], [42, 71417], [47, 71977], [51, 72137], [55, 72337], [58, 72597], [66, 73462], [79, 74102], [82, 74202], [87, 74302], [91, 74462], [96, 74782], [101, 74962], [108, 75725], [112, 75830], [119, 76130], [123, 76450], [131, 77030], [136, 77190], [139, 77330], [146, 77490], [153, 77850], [157, 78010], [164, 78310], [167, 78510]]}, {"verse": 13, "start": 79459, "end": 87025, "text": "Do you not know that they which minister about holy things live of the things of the temple? and they which wait at the altar are partakers with the altar?", "words": [[0, 79459], [3, 79558], [7, 79638], [11, 79818], [16, 80058], [21, 80258], [26, 80478], [32, 80718], [41, 81078], [47, 81378], [52, 81718], [59, 82078], [64, 82378], [67, 82578], [71, 82698], [78, 82938], [81, 83118], [85, 83238], [93, 84066], [97, 84221], [102, 84441], [108, 84661], [113, 84881], [116, 85001], [120, 85121], [126, 85401], [130, 85701], [140, 86241], [145, 86501], [149, 86621]]}, {"verse": 14, "start": 87475, "end": 91940, "text": "Even so has the Lord ordained that they which preach the gospel should live of the gospel.", "words": [[0, 87475], [5, 87670], [8, 87970], [12, 88190], [16, 88350], [21, 88550], [30, 89130], [35, 89290], [40, 89510], [46, 89730], [53, 89990], [57, 90230], [64, 90550], [71, 90830], [76, 91090], [79, 91290], [83, 91410]]}, {"verse": 15, "start": 92390, "end": 101652, "text": "But I have used none of these things: neither have I written these things, that it should be so done to me: for it were better for me to die, than that any man should make my glorying void.", "words": [[0, 92390], [4, 92497], [6, 92617], [11, 92777], [16, 92977], [21, 93217], [24, 93337], [30, 93497], [38, 94307], [46, 94500], [51, 94740], [53, 94840], [61, 95100], [67, 95340], [75, 95660], [80, 96040], [83, 96160], [90, 96300], [93, 96440], [96, 96660], [101, 96900], [104, 97080], [108, 97634], [112, 97743], [115, 97863], [120, 98003], [127, 98263], [131, 98483], [134, 98623], [137, 98783], [142, 99123], [147, 99503], [152, 99683], [156, 99903], [160, 100183], [167, 100423], [172, 100623], [175, 100783], [184, 101243]]}, {"verse": 16, "start": 102102, "end": 110950, "text": "For though I preach the gospel, I have nothing to glory of: for necessity is laid upon me; yes, woe is to me, if I preach not the gospel!", "words": [[0, 102102], [4, 102233], [11, 102453], [13, 102613], [20, 102833], [24, 103033], [32, 103693], [34, 103813], [39, 103973], [47, 104393], [50, 104593], [56, 104873], [60, 105481], [64, 105582], [74, 106122], [77, 106462], [82, 106702], [87, 106962], [91, 107572], [96, 108197], [100, 108457], [103, 108537], [106, 108697], [110, 108897], [113, 109237], [115, 109377], [122, 109637], [126, 109917], [130, 110097]]}, {"verse": 17, "start": 111400, "end": 118097, "text": "For if I do this thing willingly, I have a reward: but if against my will, a dispensation of the gospel is committed to me.", "words": [[0, 111400], [4, 111528], [7, 111788], [9, 111928], [12, 112108], [17, 112368], [23, 112588], [34, 113348], [36, 113528], [41, 113728], [43, 113808], [51, 114647], [55, 114768], [58, 114868], [66, 115088], [69, 115288], [75, 115848], [77, 115928], [90, 116508], [93, 116708], [97, 116788], [104, 117108], [107, 117348], [117, 117628], [120, 117868]]}, {"verse": 18, "start": 118547, "end": 126840, "text": "What is my reward then? Indeed that, when I preach the gospel, I may make the gospel of Christ without charge, that I abuse not my power in the gospel.", "words": [[0, 118547], [5, 118687], [8, 118787], [11, 118927], [18, 119247], [24, 119975], [31, 120492], [37, 120572], [42, 120732], [44, 120872], [51, 121072], [55, 121272], [63, 122012], [65, 122172], [69, 122352], [74, 122612], [78, 122752], [85, 123092], [88, 123312], [95, 123612], [103, 123992], [111, 124432], [116, 124912], [118, 125032], [124, 125352], [128, 125572], [131, 125772], [137, 126112], [140, 126272], [144, 126372]]}, {"verse": 19, "start": 127290, "end": 132671, "text": "For though I be free from all men, yet have I made myself servant to all, that I might gain the more.", "words": [[0, 127290], [4, 127413], [11, 127553], [13, 127693], [16, 127853], [21, 128133], [26, 128353], [30, 128513], [35, 128953], [39, 129273], [44, 129453], [46, 129573], [51, 129773], [58, 130153], [66, 130553], [69, 130773], [74, 131113], [79, 131533], [81, 131753], [87, 131873], [92, 132133], [96, 132293]]}, {"verse": 20, "start": 133121, "end": 141892, "text": "And to the Jews I became as a Jew, that I might gain the Jews; to them that are under the law, as under the law, that I might gain them that are under the law;", "words": [[0, 133121], [4, 133252], [7, 133392], [11, 133492], [16, 133712], [18, 133912], [25, 134172], [28, 134452], [30, 134552], [35, 134832], [40, 135392], [42, 135552], [48, 135752], [53, 135992], [57, 136172], [63, 137034], [66, 137131], [71, 137371], [76, 137571], [80, 137711], [86, 137931], [90, 138131], [95, 138591], [98, 138771], [104, 139091], [108, 139291], [113, 139591], [118, 139971], [120, 140071], [126, 140251], [131, 140611], [136, 140851], [141, 141071], [145, 141191], [151, 141371], [155, 141551]]}, {"verse": 21, "start": 142342, "end": 151130, "text": "To them that are without law, as without law, (being not without law to God, but under the law to Christ,) that I might gain them that are without law.", "words": [[0, 142342], [3, 142457], [8, 142697], [13, 142997], [17, 143097], [25, 143397], [30, 144137], [33, 144317], [41, 144617], [46, 145317], [53, 145577], [57, 145837], [65, 146097], [69, 146397], [72, 146577], [77, 147197], [81, 147357], [87, 147637], [91, 147777], [95, 147957], [98, 148157], [107, 149017], [112, 149157], [114, 149277], [120, 149517], [125, 149797], [130, 150017], [135, 150237], [139, 150357], [147, 150597]]}, {"verse": 22, "start": 151580, "end": 158978, "text": "To the weak became I as weak, that I might gain the weak: I am made all things to all men, that I might by all means save some.", "words": [[0, 151580], [3, 151697], [7, 151857], [12, 152017], [19, 152397], [21, 152737], [24, 152977], [30, 153257], [35, 153697], [37, 153837], [43, 154057], [48, 154317], [52, 154477], [58, 155149], [60, 155243], [63, 155373], [68, 155533], [72, 155793], [79, 156033], [82, 156253], [86, 156473], [91, 156933], [96, 157173], [98, 157273], [104, 157473], [107, 157653], [111, 157913], [117, 158133], [122, 158493]]}, {"verse": 23, "start": 159428, "end": 162933, "text": "And this I do for the gospel’s sake, that I might be partaker of it with you.", "words": [[0, 159428], [4, 159530], [9, 159710], [11, 159850], [14, 160030], [18, 160210], [22, 160330], [31, 160790], [37, 161250], [42, 161390], [44, 161490], [50, 161630], [53, 161750], [62, 162150], [65, 162310], [68, 162390], [73, 162590]]}, {"verse": 24, "start": 163383, "end": 169228, "text": "Do you not know that they which run in a race run all, but one receives the prize? So run, that you may obtain.", "words": [[0, 163383], [3, 163480], [7, 163580], [11, 163720], [16, 163920], [21, 164080], [26, 164280], [32, 164480], [36, 164740], [39, 164860], [41, 164980], [46, 165220], [50, 165460], [55, 165780], [59, 166040], [63, 166320], [72, 166660], [76, 166940], [83, 167809], [86, 168026], [91, 168226], [96, 168406], [100, 168526], [104, 168686]]}, {"verse": 25, "start": 169678, "end": 177959, "text": "And every man that strives for the mastery is temperate in all things. Now they do it to obtain a corruptible crown; but we an incorruptible.", "words": [[0, 169678], [4, 169798], [10, 169978], [14, 170238], [19, 170398], [27, 170858], [31, 170978], [35, 171098], [43, 171558], [46, 172038], [56, 172618], [59, 172838], [63, 172998], [71, 173847], [75, 173986], [80, 174146], [83, 174326], [86, 174426], [89, 174566], [96, 174906], [98, 175106], [110, 175606], [117, 176395], [121, 176519], [124, 177019], [127, 177159]]}, {"verse": 26, "start": 178409, "end": 183344, "text": "I therefore so run, not as uncertainly; so fight I, not as one that beats the air:", "words": [[0, 178409], [2, 178590], [12, 178910], [15, 179230], [20, 179830], [24, 179950], [27, 180110], [40, 181154], [43, 181289], [49, 181549], [52, 181949], [56, 182069], [59, 182249], [63, 182449], [68, 182629], [74, 182809], [78, 183049]]}, {"verse": 27, "start": 183794, "end": 192056, "text": "But I keep under my body, and bring it into subjection: lest that by any means, when I have preached to others, I myself should be a castaway.", "words": [[0, 183794], [4, 183932], [6, 184052], [11, 184252], [17, 184552], [20, 184712], [26, 185012], [30, 185472], [36, 185672], [39, 185812], [44, 185972], [56, 186992], [61, 187303], [66, 187483], [69, 187643], [73, 187963], [80, 188723], [85, 188843], [87, 188963], [92, 189063], [101, 189403], [104, 189583], [112, 190383], [114, 190483], [121, 190923], [128, 191223], [131, 191383], [133, 191503]]}]}