{"book": "GEN", "chapter": 39, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 208230, "verses": [{"verse": 1, "start": 300, "end": 11554, "text": "Y llevado José a Egipto, lo compró Potifar, eunuco de Faraón, capitán de los de la guardia, varón egipcio, de mano de los ismaelitas que lo habían llevado allá.", "words": [[0, 300], [2, 404], [10, 764], [15, 1044], [17, 1284], [25, 1844], [28, 2264], [35, 2824], [44, 3814], [51, 4804], [54, 4904], [62, 5824], [70, 6364], [73, 6484], [77, 6604], [80, 6724], [83, 6844], [92, 7224], [98, 7604], [107, 8704], [110, 8784], [115, 9024], [118, 9244], [122, 9344], [133, 10104], [137, 10264], [140, 10384], [147, 10604], [155, 11084]]}, {"verse": 2, "start": 11904, "end": 18143, "text": "Mas Jehová estaba con José, y fue un hombre próspero: y estaba en la casa de su señor el egipcio.", "words": [[0, 12064], [4, 12258], [11, 12451], [18, 12711], [22, 13011], [28, 13371], [30, 13716], [34, 13916], [37, 14116], [44, 14396], [54, 15416], [56, 15497], [63, 15817], [66, 16017], [69, 16137], [74, 16437], [77, 16657], [80, 16817], [86, 17007], [89, 17197]]}, {"verse": 3, "start": 18493, "end": 24929, "text": "Y vio su señor que Jehová era con él, y que todo lo que él hacía, Jehová lo hacía prosperar en su mano.", "words": [[0, 18493], [2, 18639], [6, 18859], [9, 19039], [15, 19719], [19, 19799], [26, 20279], [30, 20419], [34, 20699], [38, 21279], [40, 21419], [44, 21539], [49, 21819], [52, 22079], [56, 22219], [59, 22379], [66, 22799], [73, 23299], [76, 23379], [82, 23619], [92, 24199], [95, 24339], [98, 24479]]}, {"verse": 4, "start": 25279, "end": 33807, "text": "Así halló José gracia en sus ojos, y le servía; y él le hizo administrador de su casa, y entregó en su poder todo lo que tenía.", "words": [[0, 25472], [4, 25666], [10, 25859], [15, 26179], [22, 26659], [25, 26759], [29, 26899], [35, 27219], [37, 27559], [40, 27659], [48, 28570], [50, 28732], [53, 28932], [56, 29072], [61, 29432], [75, 30192], [78, 30372], [81, 30512], [87, 30892], [89, 31317], [97, 31857], [100, 31977], [103, 32137], [109, 32497], [114, 32837], [117, 33077], [121, 33217]]}, {"verse": 5, "start": 34157, "end": 49684, "text": "Y aconteció que, desde cuando le dio el encargo de su casa, y de todo lo que tenía, Jehová bendijo la casa del egipcio a causa de José; y la bendición de Jehová fue sobre todo lo que tenía, así en casa como en el campo.", "words": [[0, 34157], [2, 34300], [12, 34960], [17, 35180], [23, 35400], [30, 35820], [33, 36140], [37, 36440], [40, 36640], [48, 37280], [51, 37400], [54, 37580], [60, 37960], [62, 38540], [65, 38720], [70, 39020], [73, 39300], [77, 39440], [84, 40380], [91, 40900], [99, 41440], [102, 41620], [107, 41980], [111, 42220], [119, 42840], [121, 43040], [127, 43340], [130, 43620], [136, 44368], [138, 44493], [141, 44593], [151, 45153], [154, 45313], [161, 45793], [165, 45953], [171, 46273], [176, 46653], [179, 46913], [183, 47053], [190, 47613], [194, 47813], [197, 48093], [202, 48393], [207, 48753], [210, 48933], [213, 49033]]}, {"verse": 6, "start": 50034, "end": 60465, "text": "Y dejó todo lo que tenía en mano de José; no se preocupaba de nada más que del pan que comía. Y era José de hermoso semblante y bella presencia.", "words": [[0, 50034], [2, 50156], [7, 50516], [12, 50876], [15, 51176], [19, 51316], [25, 51656], [28, 51816], [33, 52056], [36, 52256], [42, 52979], [45, 53162], [48, 53302], [59, 54002], [62, 54122], [67, 54302], [71, 54602], [75, 54742], [79, 54962], [83, 55322], [87, 55602], [94, 56477], [96, 56772], [100, 56952], [105, 57432], [108, 57812], [116, 58352], [126, 58992], [128, 59152], [134, 59492]]}, {"verse": 7, "start": 60815, "end": 68322, "text": "Y aconteció después de esto, que la mujer de su señor puso sus ojos en José, y dijo: Duerme conmigo.", "words": [[0, 60815], [2, 60938], [12, 61598], [20, 61898], [23, 62138], [29, 62698], [33, 63118], [36, 63238], [42, 63578], [45, 63778], [48, 63958], [54, 64338], [59, 64838], [63, 64998], [68, 65358], [71, 65658], [77, 65998], [79, 66338], [85, 67065], [92, 67467]]}, {"verse": 8, "start": 68602, "end": 78143, "text": "Y él no quiso, y dijo a la mujer de su señor: He aquí que mi señor no se preocupa de lo que hay en casa estando yo aquí, y ha puesto en mi mano todo lo que tiene:", "words": [[0, 68602], [2, 68766], [5, 68906], [8, 69086], [15, 69886], [17, 70126], [22, 70366], [24, 70446], [27, 70486], [33, 70786], [36, 70966], [39, 71106], [46, 71907], [49, 72017], [54, 72237], [58, 72377], [61, 72517], [67, 72857], [70, 73077], [73, 73237], [82, 73797], [85, 73877], [88, 73977], [92, 74137], [96, 74297], [99, 74457], [104, 74777], [112, 75257], [115, 75457], [121, 75737], [123, 76277], [126, 76337], [133, 76577], [136, 76777], [139, 76917], [144, 77157], [149, 77417], [152, 77597], [156, 77737]]}, {"verse": 9, "start": 78493, "end": 88244, "text": "No hay otro mayor que yo en esta casa, y ninguna cosa me ha reservado sino a ti, por cuanto tú eres su mujer; ¿cómo, pues, haría yo este grande mal, y pecaría contra Dios?", "words": [[0, 78493], [3, 78650], [7, 78790], [12, 78970], [18, 79310], [22, 79490], [25, 79670], [28, 79770], [33, 79950], [39, 80510], [41, 80570], [49, 80850], [54, 81190], [57, 81410], [60, 81450], [70, 81990], [75, 82190], [77, 82410], [81, 82830], [85, 83090], [92, 83410], [95, 83610], [100, 83790], [103, 83990], [110, 84652], [117, 84812], [123, 85152], [129, 85652], [132, 85812], [137, 86012], [144, 86272], [149, 86612], [151, 86912], [159, 87372], [166, 87672]]}, {"verse": 10, "start": 88524, "end": 97254, "text": "Y aconteció que hablando ella a José cada día, y no escuchándola él para acostarse al lado de ella, para estar con ella,", "words": [[0, 88524], [2, 88641], [12, 89441], [16, 89596], [25, 89956], [30, 90376], [32, 90596], [37, 90836], [42, 91216], [47, 91616], [49, 91971], [52, 92231], [65, 93311], [68, 93611], [73, 93891], [83, 94651], [86, 94851], [91, 95111], [94, 95391], [100, 95691], [105, 96211], [111, 96471], [115, 96771]]}, {"verse": 11, "start": 97604, "end": 105069, "text": "Aconteció que entró él un día en casa para cumplir con sus responsabilidades, y no había nadie de la casa allí:", "words": [[0, 97604], [10, 98345], [14, 98545], [20, 98985], [23, 99165], [26, 99405], [30, 99645], [33, 99845], [38, 100185], [43, 100505], [51, 101085], [55, 101245], [59, 101525], [78, 102765], [80, 103325], [83, 103465], [89, 103665], [95, 104045], [98, 104245], [101, 104345], [106, 104625]]}, {"verse": 12, "start": 105419, "end": 115260, "text": "Y lo agarró ella por su ropa, diciendo: Duerme conmigo. Entonces él dejó su ropa en las manos de ella, y huyó, y se salió fuera.", "words": [[0, 105419], [2, 105545], [5, 105685], [12, 106245], [17, 106545], [21, 106825], [24, 107045], [30, 107585], [40, 108725], [47, 109127], [56, 110262], [65, 110720], [68, 111115], [73, 111515], [76, 111655], [81, 112075], [84, 112175], [88, 112295], [94, 112575], [97, 112795], [103, 113035], [105, 113315], [111, 113715], [113, 114175], [116, 114315], [122, 114695]]}, {"verse": 13, "start": 115610, "end": 122116, "text": "Y acaeció que cuando vio ella que le había dejado su ropa en sus manos, y había huido fuera,", "words": [[0, 115610], [2, 115792], [10, 116532], [14, 116792], [21, 117092], [25, 117532], [30, 117792], [34, 118012], [37, 118172], [43, 118432], [50, 118912], [53, 119132], [58, 119532], [61, 119652], [65, 119772], [72, 120212], [74, 120732], [80, 121052], [86, 121532]]}, {"verse": 14, "start": 122466, "end": 133667, "text": "Llamó a los de casa, y les habló diciendo: Mirad, nos ha traído un hebreo, para que hiciese burla de nosotros: vino él a mí para dormir conmigo, y yo di grandes voces;", "words": [[0, 122466], [6, 122928], [8, 123048], [12, 123148], [15, 123308], [21, 123628], [23, 123943], [27, 124123], [33, 124543], [43, 125535], [50, 125927], [54, 126047], [57, 126207], [64, 126547], [67, 126707], [75, 127207], [80, 127667], [84, 127827], [92, 128247], [98, 128687], [101, 128827], [111, 129829], [116, 130153], [119, 130333], [121, 130433], [124, 130573], [129, 130813], [136, 131113], [145, 131893], [147, 132293], [150, 132473], [153, 132593], [161, 132873]]}, {"verse": 15, "start": 134017, "end": 140022, "text": "Y viendo que yo alzaba la voz y gritaba, dejó junto a mí su ropa, y huyó, y se salió fuera.", "words": [[0, 134017], [2, 134117], [9, 134397], [13, 134577], [16, 134737], [23, 135177], [26, 135317], [30, 135617], [32, 135817], [41, 136757], [46, 136957], [52, 137137], [54, 137357], [57, 137457], [60, 137637], [66, 138037], [68, 138287], [74, 138537], [76, 138977], [79, 139117], [85, 139477]]}, {"verse": 16, "start": 140302, "end": 145165, "text": "Y ella puso junto a sí la ropa de él, hasta que vino su señor a su casa.", "words": [[0, 140302], [2, 140440], [7, 140680], [12, 141060], [18, 141253], [20, 141447], [23, 141640], [26, 141840], [31, 142200], [34, 142360], [38, 142840], [44, 143360], [48, 143560], [53, 143760], [56, 144060], [62, 144360], [64, 144520], [67, 144580]]}, {"verse": 17, "start": 145515, "end": 153945, "text": "Entonces le habló ella semejantes palabras, diciendo: El siervo hebreo que nos trajiste, vino a mí para deshonrarme;", "words": [[0, 145515], [9, 146217], [12, 146877], [18, 147147], [23, 147417], [34, 148097], [44, 148597], [54, 149848], [57, 150018], [64, 150458], [71, 150858], [75, 150958], [79, 151138], [89, 151778], [94, 152153], [96, 152413], [99, 152593], [104, 152833]]}, {"verse": 18, "start": 154295, "end": 159721, "text": "Y como yo alcé mi voz y grité, él dejó su ropa junto a mí, y huyó fuera.", "words": [[0, 154295], [2, 154400], [7, 154640], [10, 154880], [15, 155240], [18, 155400], [22, 155700], [24, 155880], [31, 156640], [34, 156780], [39, 157240], [42, 157400], [47, 157760], [53, 157980], [55, 158240], [59, 158440], [61, 158900], [66, 159140]]}, {"verse": 19, "start": 160001, "end": 169926, "text": "Y sucedió que como oyó su señor las palabras que su mujer le hablara, diciendo: Así me ha tratado tu siervo; se encendió su furor.", "words": [[0, 160001], [2, 160128], [10, 160748], [14, 160908], [19, 161308], [23, 161848], [26, 162008], [32, 162428], [36, 162708], [45, 163068], [49, 163348], [52, 163508], [58, 163888], [61, 164108], [70, 164608], [80, 166059], [84, 166462], [87, 166602], [90, 166722], [98, 167182], [101, 167322], [109, 168254], [112, 168462], [121, 169162], [124, 169322]]}, {"verse": 20, "start": 170276, "end": 178692, "text": "Y tomó su señor a José, y lo puso en la casa de la cárcel, donde estaban los presos del rey, y estuvo allí en la casa de la cárcel.", "words": [[0, 170276], [2, 170401], [7, 170721], [10, 170881], [16, 171041], [18, 171201], [24, 171661], [26, 172121], [29, 172241], [34, 172581], [37, 172681], [40, 172781], [45, 173041], [48, 173261], [51, 173381], [59, 173881], [65, 174361], [73, 174761], [77, 175001], [84, 175481], [88, 175701], [93, 176261], [95, 176381], [102, 176741], [107, 177081], [110, 177401], [113, 177521], [118, 177761], [121, 177961], [124, 178081]]}, {"verse": 21, "start": 179042, "end": 187972, "text": "Pero Jehová fue con José, y extendió a él su misericordia, y le dio gracia ante los ojos del jefe de la cárcel.", "words": [[0, 179042], [5, 179245], [12, 179805], [16, 179965], [20, 180245], [26, 180665], [28, 181200], [37, 182080], [39, 182300], [42, 182560], [45, 182840], [59, 184000], [61, 184660], [64, 184820], [68, 185020], [75, 185620], [80, 185840], [84, 186040], [89, 186360], [93, 186640], [98, 187080], [101, 187200], [104, 187340]]}, {"verse": 22, "start": 188322, "end": 197708, "text": "Y el principal de la casa de la cárcel entregó en mano de José todos los presos que había en aquella prisión; todo lo que hacían allí, él lo hacía.", "words": [[0, 188322], [2, 188445], [5, 188565], [15, 189225], [18, 189605], [21, 189725], [26, 190005], [29, 190185], [32, 190305], [39, 190725], [47, 191485], [50, 191605], [55, 191825], [58, 192025], [63, 192265], [69, 192605], [73, 192925], [80, 193325], [84, 193465], [90, 193685], [93, 193885], [101, 194225], [110, 195106], [115, 195308], [118, 195588], [122, 195935], [129, 196281], [135, 196628], [138, 196788], [141, 197048]]}, {"verse": 23, "start": 198058, "end": 207830, "text": "No veía el principal de la cárcel cosa alguna que en su mano estaba; porque Jehová era con él, y lo que él hacía, Jehová lo prosperaba.", "words": [[0, 198058], [3, 198327], [8, 198807], [11, 199027], [21, 199467], [24, 199747], [27, 199867], [34, 200287], [39, 200667], [46, 201147], [50, 201407], [53, 201607], [56, 201767], [61, 202047], [69, 203116], [76, 203454], [83, 203954], [87, 204114], [91, 204374], [95, 204654], [97, 204816], [100, 205149], [104, 205289], [107, 205529], [114, 206409], [121, 206849], [124, 206929]]}]}