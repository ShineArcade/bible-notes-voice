{"book": "ACT", "chapter": 20, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 311803, "verses": [{"verse": 1, "start": 300, "end": 10055, "text": "Y después que cesó el alboroto, llamando Pablo a los discípulos habiéndoles exhortado y abrazado, se despidió, y salió para ir a Macedonia.", "words": [[0, 300], [2, 404], [10, 704], [14, 904], [19, 1284], [22, 1384], [32, 2404], [41, 2924], [47, 3404], [49, 3604], [53, 3724], [64, 4564], [76, 5104], [86, 6124], [88, 6224], [98, 6964], [101, 7064], [111, 7664], [113, 8224], [119, 8644], [124, 8904], [127, 9164], [129, 9244]]}, {"verse": 2, "start": 10405, "end": 17203, "text": "Y andado que hubo aquellas partes, y habiéndolos animado con muchas palabras, vino a Grecia.", "words": [[0, 10405], [2, 10700], [9, 11030], [13, 11290], [18, 11650], [27, 12030], [35, 13075], [37, 13135], [49, 13815], [57, 14415], [61, 14655], [68, 15035], [78, 16095], [83, 16435], [85, 16836]]}, {"verse": 3, "start": 17553, "end": 29432, "text": "Y después de haber estado allí tres meses, y habiendo de navegar a Siria, le fueron puestas emboscadas por los judíos; y así decidió regresar por Macedonia.", "words": [[0, 17553], [2, 17657], [10, 17957], [13, 18137], [19, 18317], [26, 18697], [31, 18957], [36, 19297], [43, 19797], [45, 20342], [54, 20742], [57, 20922], [65, 21462], [67, 21802], [74, 22142], [77, 22682], [84, 22942], [92, 23462], [103, 24202], [107, 24422], [111, 24582], [119, 25577], [121, 25927], [125, 26187], [133, 27107], [142, 28187], [146, 28407]]}, {"verse": 4, "start": 29782, "end": 42385, "text": "Y le acompañaron hasta Asia Sopater Bereense, y los Tesalonicenses, Aristarco y Segundo; y Gayo de Derbe, y Timoteo; y de Asia, Tíquico y Trófimo.", "words": [[0, 29782], [2, 29926], [5, 30006], [17, 30926], [23, 31366], [28, 31846], [36, 32576], [46, 33306], [48, 33906], [52, 34066], [68, 35406], [78, 36626], [80, 36726], [89, 37703], [91, 37992], [96, 38312], [99, 38412], [106, 38832], [108, 39032], [117, 40032], [119, 40181], [122, 40281], [128, 40621], [136, 41366], [138, 41606]]}, {"verse": 5, "start": 42735, "end": 45710, "text": "Estos yendo delante, nos esperaron en Troas.", "words": [[0, 42735], [6, 43142], [12, 43522], [21, 44022], [25, 44202], [35, 44822], [38, 45002]]}, {"verse": 6, "start": 46060, "end": 56592, "text": "Y nosotros, pasados los días de los panes sin levadura, navegamos de Filipos y vinimos a ellos a Troas en cinco días, donde estuvimos siete días.", "words": [[0, 46060], [2, 46184], [12, 46464], [20, 47184], [24, 47404], [29, 47704], [32, 47864], [36, 47964], [42, 48424], [46, 48744], [56, 49704], [66, 50344], [69, 50524], [77, 51144], [79, 51524], [87, 51984], [89, 52204], [95, 52484], [97, 52804], [103, 53284], [106, 53464], [112, 53904], [118, 54684], [124, 54984], [134, 55564], [140, 55904]]}, {"verse": 7, "start": 56942, "end": 69494, "text": "Y el día primero de la semana, juntos los discípulos a partir el pan, Pablo les enseñaba, habiendo de partir al día siguiente: y alargó el discurso hasta la media noche.", "words": [[0, 56942], [2, 57087], [5, 57247], [9, 57447], [17, 57827], [20, 58047], [23, 58167], [31, 59187], [38, 59727], [42, 60027], [53, 60647], [55, 60827], [62, 61077], [65, 61327], [70, 61907], [76, 62447], [80, 62827], [90, 63867], [99, 64247], [102, 64427], [109, 64747], [112, 65107], [116, 65287], [127, 66352], [129, 66672], [136, 67272], [139, 67472], [148, 68192], [154, 68492], [157, 68832], [163, 69172]]}, {"verse": 8, "start": 69844, "end": 74060, "text": "Y había muchas lámparas en el aposento alto donde estaban juntos.", "words": [[0, 69844], [2, 69948], [8, 70108], [15, 70408], [24, 71228], [27, 71368], [30, 71508], [39, 72008], [44, 72468], [50, 72768], [58, 73168]]}, {"verse": 9, "start": 74410, "end": 88193, "text": "Y un joven llamado Eutico que estaba sentado en la ventana, tomado de un sueño profundo, mientras Pablo hablaba largamente, vencido por el sueño cayó del tercer piso abajo, y fue levantado muerto.", "words": [[0, 74410], [2, 74535], [5, 74655], [11, 75035], [19, 75575], [26, 76115], [30, 76315], [37, 76555], [45, 77215], [48, 77315], [51, 77455], [60, 78275], [67, 78775], [70, 78915], [73, 79015], [79, 79415], [89, 80335], [98, 80555], [104, 80995], [112, 81495], [124, 82595], [132, 83095], [136, 83335], [139, 83495], [145, 83915], [150, 84355], [154, 84535], [161, 84935], [166, 85575], [173, 86333], [175, 86573], [179, 86753], [189, 87433]]}, {"verse": 10, "start": 88543, "end": 96539, "text": "Entonces descendió Pablo, y se echó sobre él, y abrazándole, dijo: No os alborotéis, que su alma está en él.", "words": [[0, 88543], [9, 89060], [19, 90140], [26, 90560], [28, 90820], [31, 90940], [36, 91240], [42, 91540], [46, 91840], [48, 92400], [61, 93600], [67, 94365], [70, 94604], [73, 94764], [85, 95404], [89, 95524], [92, 95684], [97, 95904], [102, 96144], [105, 96324]]}, {"verse": 11, "start": 96819, "end": 103521, "text": "Después subiendo, y partiendo el pan, y comiendo, habló largamente hasta el alba, y así salió.", "words": [[0, 96819], [8, 97727], [18, 98227], [20, 98367], [30, 98907], [33, 99047], [38, 99307], [40, 99612], [50, 100612], [56, 100972], [67, 101632], [73, 101912], [76, 102112], [82, 102472], [84, 102652], [88, 102852]]}, {"verse": 12, "start": 103871, "end": 108366, "text": "Y llevaron al joven vivo, y fueron consolados no poco.", "words": [[0, 103871], [2, 103970], [11, 104270], [14, 104570], [20, 105070], [26, 105470], [28, 106050], [35, 106330], [46, 107330], [49, 107630]]}, {"verse": 13, "start": 108716, "end": 118919, "text": "Y nosotros subiendo en el navío, navegamos a Asón, para recibir de allí a Pablo; pues así había determinado que debía él ir por tierra.", "words": [[0, 108716], [2, 108842], [11, 109782], [20, 110262], [23, 110462], [26, 110622], [33, 111622], [43, 112122], [45, 112472], [51, 112822], [56, 113322], [64, 113782], [67, 114082], [72, 114362], [74, 114642], [81, 115386], [86, 115651], [90, 115971], [96, 116271], [108, 117091], [112, 117251], [118, 117631], [121, 117851], [124, 118051], [128, 118271]]}, {"verse": 14, "start": 119269, "end": 124518, "text": "Y como se juntó con nosotros en Asón, tomándole vinimos a Mitilene.", "words": [[0, 119269], [2, 119394], [7, 119634], [10, 119814], [16, 120254], [20, 120434], [29, 120874], [32, 121394], [38, 121914], [48, 122654], [56, 123514], [58, 123674]]}, {"verse": 15, "start": 124868, "end": 136810, "text": "Y navegando de allí, al día siguiente llegamos delante de Quío, y al otro día tomamos puerto en Samos: y habiendo reposado en Trogilio, al día siguiente llegamos a Mileto.", "words": [[0, 124868], [2, 124991], [12, 125551], [15, 125751], [21, 126411], [24, 126531], [28, 126671], [38, 127151], [47, 127781], [55, 128411], [58, 128511], [64, 128911], [66, 129291], [69, 129411], [74, 129611], [78, 129911], [86, 130391], [93, 130711], [96, 130931], [103, 131848], [105, 131975], [114, 132375], [123, 133095], [126, 133815], [136, 134535], [139, 134675], [143, 134895], [153, 135295], [162, 136015], [164, 136195]]}, {"verse": 16, "start": 137160, "end": 151009, "text": "Porque Pablo se había propuesto pasar adelante de Éfeso; por no detenerse en Asia: porque se apresuraba por pasar el día de Pentecostés, si le fuese posible, en Jerusalén.", "words": [[0, 137160], [7, 137583], [13, 138283], [16, 138703], [22, 138983], [32, 139723], [38, 140203], [47, 140943], [50, 141243], [57, 142083], [61, 142701], [64, 142921], [74, 143581], [77, 143721], [83, 144418], [90, 144642], [93, 144842], [104, 145602], [108, 145842], [114, 146302], [117, 146602], [121, 146842], [124, 147452], [137, 148062], [140, 148562], [143, 148702], [149, 148962], [158, 149542], [161, 150102]]}, {"verse": 17, "start": 151359, "end": 156849, "text": "Y enviando desde Mileto a Éfeso, hizo llamar a los ancianos de la iglesia.", "words": [[0, 151359], [2, 151515], [11, 152195], [17, 152495], [24, 153235], [26, 153455], [33, 154435], [38, 154675], [45, 155175], [47, 155255], [51, 155415], [60, 155975], [63, 156055], [66, 156175]]}, {"verse": 18, "start": 157199, "end": 165645, "text": "Y cuando vinieron a él, les dijo: Vosotros sabéis cómo, desde el primer día que entré en Asia, he estado con vosotros por todo el tiempo,", "words": [[0, 157199], [2, 157327], [9, 157547], [18, 158127], [20, 158327], [24, 158547], [28, 158807], [34, 159566], [43, 160001], [50, 160501], [56, 160881], [62, 161221], [65, 161441], [72, 161721], [76, 162021], [80, 162241], [86, 162541], [89, 162641], [95, 162961], [98, 163286], [105, 163606], [109, 163946], [118, 164426], [122, 164726], [127, 164926], [130, 165126]]}, {"verse": 19, "start": 165995, "end": 172962, "text": "Sirviendo al Señor con toda humildad, y con muchas lágrimas, y pruebas que me han sobrevenido por las tramas de los judíos:", "words": [[0, 165995], [10, 166431], [13, 166571], [19, 166831], [23, 167091], [28, 167311], [38, 168011], [40, 168331], [44, 168511], [51, 168771], [61, 169411], [63, 169871], [71, 170311], [75, 170471], [78, 170631], [82, 170731], [94, 171371], [98, 171551], [102, 171711], [109, 172091], [112, 172211], [116, 172331]]}, {"verse": 20, "start": 173312, "end": 179093, "text": "Cómo nada que fuese útil he rehuido de anunciaros y enseñaros, públicamente y por las casas,", "words": [[0, 173312], [5, 173506], [10, 173786], [14, 174006], [20, 174346], [25, 174906], [28, 175166], [36, 175426], [39, 175566], [50, 176226], [52, 176366], [63, 177206], [76, 177926], [78, 178146], [82, 178286], [86, 178466]]}, {"verse": 21, "start": 179443, "end": 185800, "text": "Testificando a los judíos y a los Gentiles arrepentimiento para con Dios, y la fe en nuestro Señor Jesucristo.", "words": [[0, 179443], [13, 180215], [15, 180315], [19, 180435], [26, 180995], [28, 181115], [30, 181155], [34, 181295], [43, 181815], [59, 182735], [64, 182955], [68, 183195], [74, 183435], [76, 183770], [79, 183910], [82, 184150], [85, 184270], [93, 184450], [99, 184850]]}, {"verse": 22, "start": 186150, "end": 191827, "text": "Y ahora, he aquí, ligado yo en espíritu, voy a Jerusalén, sin saber lo que allá me ha de acontecer:", "words": [[0, 186150], [2, 186263], [9, 186523], [12, 186683], [18, 187403], [25, 187743], [28, 187923], [31, 188063], [41, 188898], [45, 189058], [47, 189198], [58, 189938], [62, 190058], [68, 190358], [71, 190518], [75, 190658], [80, 190798], [83, 190978], [86, 191078], [89, 191138]]}, {"verse": 23, "start": 192177, "end": 198571, "text": "Pero que el Espíritu Santo por todas las ciudades me da testimonio, diciendo que prisiones y tribulaciones me esperan.", "words": [[0, 192177], [5, 192315], [9, 192455], [12, 192575], [21, 193015], [27, 193295], [31, 193595], [37, 193795], [41, 194095], [50, 194595], [53, 194755], [56, 194915], [68, 195935], [77, 196275], [81, 196575], [91, 197135], [93, 197215], [107, 197835], [110, 198035]]}, {"verse": 24, "start": 198921, "end": 211267, "text": "Pero de ninguna cosa hago caso, ni estimo mi vida preciosa para mí mismo; solamente que acabe mi carrera con gozo, y el ministerio que recibí del Señor Jesús, para dar testimonio del evangelio de la gracia de Dios.", "words": [[0, 198921], [5, 199060], [8, 199180], [16, 199420], [21, 199860], [26, 200100], [32, 200500], [35, 200960], [42, 201340], [45, 201480], [50, 201700], [59, 202300], [64, 202500], [67, 202660], [74, 203327], [84, 203662], [88, 203982], [94, 204322], [97, 204482], [105, 204882], [109, 205082], [115, 205782], [117, 205942], [120, 206062], [131, 206722], [135, 206842], [142, 207342], [146, 207422], [152, 207702], [159, 208202], [164, 208507], [168, 208727], [179, 209407], [183, 209567], [193, 210147], [196, 210247], [199, 210367], [206, 210807], [209, 210927]]}, {"verse": 25, "start": 211617, "end": 219509, "text": "Y ahora, he aquí, yo sé que ninguno de todos vosotros, por quien he pasado predicando el reino de Dios, verá más mi rostro.", "words": [[0, 211617], [2, 211741], [9, 212021], [12, 212261], [18, 213141], [21, 213301], [24, 213481], [28, 213621], [36, 214101], [39, 214221], [45, 214441], [55, 215341], [59, 215661], [65, 215841], [68, 215961], [75, 216281], [86, 217001], [89, 217141], [95, 217421], [98, 217581], [104, 218281], [109, 218541], [113, 218721], [116, 218901]]}, {"verse": 26, "start": 219859, "end": 224907, "text": "Por tanto, yo os declaro solemnemente el día de hoy, que yo soy limpio de la sangre de todos:", "words": [[0, 219859], [4, 219965], [11, 220445], [14, 220625], [17, 220745], [25, 221205], [38, 222005], [41, 222145], [45, 222325], [48, 222485], [53, 222705], [57, 222860], [60, 223020], [64, 223200], [71, 223620], [74, 223720], [77, 223820], [84, 224140], [87, 224300]]}, {"verse": 27, "start": 225257, "end": 228566, "text": "Porque no he rehuido de anunciaros todo el consejo de Dios.", "words": [[0, 225257], [7, 225441], [10, 225661], [13, 225801], [21, 226321], [24, 226441], [35, 227041], [40, 227241], [43, 227421], [51, 227901], [54, 228041]]}, {"verse": 28, "start": 228916, "end": 239107, "text": "Por tanto mirad por vosotros, y por todo el rebaño en que el Espíritu Santo os ha puesto por obispos, para apacentar la iglesia del Señor, la cual ganó por su sangre.", "words": [[0, 228916], [4, 229064], [10, 229564], [16, 229904], [20, 230084], [30, 230684], [32, 231244], [36, 231424], [41, 231624], [44, 231844], [51, 232264], [54, 232404], [58, 232544], [61, 232704], [70, 233184], [76, 233484], [79, 233764], [82, 233864], [89, 234104], [93, 234384], [102, 235064], [107, 235444], [117, 236084], [120, 236264], [128, 236624], [132, 236824], [139, 237599], [142, 237720], [147, 237920], [152, 238300], [156, 238460], [159, 238600]]}, {"verse": 29, "start": 239457, "end": 245647, "text": "Porque yo sé que después de mi partida entrarán en medio de vosotros lobos rapaces, que no perdonarán al rebaño;", "words": [[0, 239457], [7, 239637], [10, 239857], [13, 240077], [17, 240217], [25, 240577], [28, 240777], [31, 240877], [39, 241417], [48, 241957], [51, 242077], [57, 242297], [60, 242497], [69, 242957], [75, 243357], [84, 243917], [88, 244092], [91, 244292], [102, 244952], [105, 245052]]}, {"verse": 30, "start": 245997, "end": 251541, "text": "Y de vosotros mismos se levantarán hombres que hablen cosas perversas, para llevar discípulos tras sí.", "words": [[0, 245997], [2, 246082], [5, 246182], [14, 246582], [21, 246942], [24, 247182], [35, 247722], [43, 247962], [47, 248182], [54, 248442], [60, 248682], [71, 249462], [76, 250002], [83, 250262], [94, 250962], [99, 251182]]}, {"verse": 31, "start": 251891, "end": 259453, "text": "Por tanto, velad, acordándoos que por tres años de noche y de día, no he cesado de amonestar con lágrimas a cada uno.", "words": [[0, 251891], [4, 252077], [11, 252577], [18, 253077], [30, 253917], [34, 254037], [38, 254237], [43, 254517], [48, 254797], [51, 254997], [57, 255277], [59, 255437], [62, 255557], [67, 256297], [70, 256477], [73, 256637], [80, 257057], [83, 257177], [93, 257657], [97, 257877], [106, 258417], [108, 258577], [113, 258757]]}, {"verse": 32, "start": 259803, "end": 268794, "text": "Y ahora, hermanos, os encomiendo a Dios, y a la palabra de su gracia: el cual es poderoso para edificaros y daros herencia con todos los santificados.", "words": [[0, 259803], [2, 259942], [9, 260122], [19, 261082], [22, 261182], [33, 261822], [35, 261982], [41, 262182], [43, 262582], [45, 262642], [48, 262722], [56, 263082], [59, 263262], [62, 263402], [70, 264164], [73, 264308], [78, 264488], [81, 264688], [90, 265248], [95, 265728], [106, 266208], [108, 266521], [114, 266835], [123, 267148], [127, 267408], [133, 267628], [137, 267808]]}, {"verse": 33, "start": 269144, "end": 272835, "text": "La plata, o el oro, o el vestido de nadie he codiciado.", "words": [[0, 269144], [3, 269269], [10, 269629], [12, 269809], [15, 269929], [20, 270529], [22, 270769], [25, 270849], [33, 271269], [36, 271409], [42, 271902], [45, 272396]]}, {"verse": 34, "start": 273185, "end": 279850, "text": "Antes vosotros sabéis que para lo que me ha sido necesario, y a los que están conmigo, estas manos me han servido.", "words": [[0, 273185], [6, 273508], [15, 274048], [22, 274548], [26, 274728], [31, 274948], [34, 275108], [38, 275228], [41, 275368], [44, 275468], [49, 275668], [60, 276388], [62, 276888], [64, 276968], [68, 277088], [72, 277208], [78, 277488], [87, 278408], [93, 278528], [99, 278908], [102, 279148], [106, 279268]]}, {"verse": 35, "start": 280200, "end": 291586, "text": "En todo os he enseñado que, trabajando así, es necesario ayudar a los débiles, y tener presentes las palabras del Señor Jesús, el cual dijo: Más bienaventurada cosa es dar que recibir.", "words": [[0, 280200], [3, 280320], [8, 280540], [11, 280840], [14, 280940], [23, 281500], [28, 281980], [39, 282320], [44, 283080], [47, 283200], [57, 283800], [64, 284200], [66, 284340], [70, 284500], [79, 284960], [81, 285420], [87, 285660], [97, 286200], [101, 286340], [110, 286720], [114, 286960], [120, 287200], [127, 287980], [130, 288140], [135, 288320], [141, 289100], [145, 289543], [160, 290023], [165, 290323], [168, 290583], [172, 290763], [176, 290943]]}, {"verse": 36, "start": 291866, "end": 296827, "text": "Y cuando hubo dicho estas cosas, se puso de rodillas, y oró con todos ellos.", "words": [[0, 291866], [2, 291972], [9, 292192], [14, 292652], [20, 292872], [26, 293072], [33, 293552], [36, 294052], [41, 294372], [44, 294532], [54, 295152], [56, 295447], [60, 295747], [64, 295947], [70, 296247]]}, {"verse": 37, "start": 297177, "end": 303541, "text": "Entonces hubo un gran llanto de todos: y echándose en el cuello de Pablo, le besaban,", "words": [[0, 297177], [9, 297604], [14, 298364], [17, 298584], [22, 298844], [29, 299364], [32, 299524], [39, 300264], [41, 300384], [51, 300984], [54, 301184], [57, 301324], [64, 301664], [67, 301804], [74, 302244], [77, 302744]]}, {"verse": 38, "start": 303891, "end": 311403, "text": "Doliéndose en gran manera por la palabra que dijo, que no habían de ver más su rostro. Y le acompañaron al barco.", "words": [[0, 303891], [11, 304694], [14, 305094], [19, 305294], [26, 305794], [30, 306014], [33, 306174], [41, 306474], [45, 306674], [51, 306954], [55, 307414], [58, 307594], [65, 307834], [68, 308074], [72, 308254], [76, 308434], [79, 308794], [87, 309721], [89, 309837], [92, 309917], [104, 310617], [107, 310797]]}]}