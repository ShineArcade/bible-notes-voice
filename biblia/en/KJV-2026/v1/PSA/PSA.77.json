{"book": "PSA", "chapter": 77, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 119974, "verses": [{"verse": 1, "start": 300, "end": 5793, "text": "I cried to God with my voice, even to God with my voice; and he gave ear to me.", "words": [[0, 300], [2, 444], [8, 744], [11, 984], [15, 1224], [20, 1424], [23, 1624], [30, 2244], [35, 2684], [38, 2944], [42, 3204], [47, 3384], [50, 3604], [57, 4444], [61, 4603], [64, 4723], [69, 4963], [73, 5243], [76, 5463]]}, {"verse": 2, "start": 6243, "end": 14492, "text": "In the day of my trouble I sought the Lord: my sore ran in the night, and ceased not: my soul refused to be comforted.", "words": [[0, 6243], [3, 6369], [7, 6449], [11, 6689], [14, 6809], [17, 6969], [25, 7329], [27, 7629], [34, 7889], [38, 8109], [44, 8917], [47, 9063], [52, 9403], [56, 9803], [59, 9963], [63, 10063], [70, 10383], [74, 10843], [81, 11183], [86, 12144], [89, 12564], [94, 12884], [102, 13324], [105, 13684], [108, 13824]]}, {"verse": 3, "start": 14942, "end": 20885, "text": "I remembered God, and was troubled: I complained, and my spirit was overwhelmed. Selah.", "words": [[0, 14942], [2, 15066], [13, 15446], [18, 15886], [22, 16126], [26, 16306], [36, 17231], [38, 17335], [50, 17795], [54, 18215], [57, 18435], [64, 18835], [68, 19075], [81, 20583]]}, {"verse": 4, "start": 21335, "end": 25912, "text": "You hold my eyes waking: I am so troubled that I cannot speak.", "words": [[0, 21335], [4, 21639], [9, 21879], [12, 22099], [17, 22339], [25, 23308], [27, 23471], [30, 23611], [33, 23871], [42, 24371], [47, 24651], [49, 24831], [56, 25171]]}, {"verse": 5, "start": 26362, "end": 30408, "text": "I have considered the days of old, the years of ancient times.", "words": [[0, 26362], [2, 26484], [7, 26644], [18, 27084], [22, 27384], [27, 27704], [30, 27944], [35, 28604], [39, 28784], [45, 29084], [48, 29324], [56, 29644]]}, {"verse": 6, "start": 30858, "end": 38150, "text": "I call to remembrance my song in the night: I 