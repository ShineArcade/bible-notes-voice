{"book": "MAT", "chapter": 22, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 308541, "verses": [{"verse": 1, "start": 300, "end": 4951, "text": "Y respondiendo Jesús, les volvió a hablar en parábolas, diciendo:", "words": [[0, 300], [2, 446], [15, 1166], [22, 2186], [26, 2306], [33, 2706], [35, 2766], [42, 2946], [45, 3126], [56, 3806]]}, {"verse": 2, "start": 5401, "end": 10084, "text": "El reino de los cielos es semejante a un rey que celebró la boda de su hijo;", "words": [[0, 5401], [3, 5661], [9, 6081], [12, 6201], [16, 6341], [23, 6841], [26, 7021], [36, 7621], [38, 7741], [41, 7841], [45, 8261], [49, 8341], [57, 8861], [60, 8981], [65, 9241], [68, 9421], [71, 9601]]}, {"verse": 3, "start": 10534, "end": 16352, "text": "Y envió sus siervos para que llamasen los invitados a la boda; pero no quisieron venir.", "words": [[0, 10534], [2, 10673], [8, 11053], [12, 11253], [20, 11933], [25, 12473], [29, 12613], [38, 13133], [42, 13273], [52, 13933], [54, 14073], [57, 14153], [63, 14959], [68, 15104], [71, 15244], [81, 15704]]}, {"verse": 4, "start": 16802, "end": 30751, "text": "Volvió a enviar otros siervos, diciendo: Decid a los llamados: He aquí, he preparado mi comida; mis toros y animales engordados son muertos, y todo está listo: venid a las bodas.", "words": [[0, 16802], [7, 17169], [9, 17229], [16, 17509], [22, 17709], [31, 18349], [41, 19614], [47, 20183], [49, 20363], [53, 20503], [63, 21558], [66, 22010], [72, 22670], [75, 22750], [85, 23330], [88, 23470], [96, 24406], [100, 24570], [106, 25110], [108, 25270], [117, 25690], [128, 26510], [132, 26770], [141, 27450], [143, 28190], [148, 28390], [153, 28610], [160, 29528], [166, 29891], [168, 29971], [172, 30111]]}, {"verse": 5, "start": 31201, "end": 36633, "text": "Pero ellos no hicieron caso, y se fueron, uno a su labranza, y otro a sus negocios;", "words": [[0, 31201], [5, 31325], [11, 31545], [14, 31745], [23, 32125], [29, 32525], [31, 33005], [34, 33145], [42, 33485], [46, 34165], [48, 34385], [51, 34465], [61, 35105], [63, 35285], [68, 35465], [70, 35665], [74, 35745]]}, {"verse": 6, "start": 37083, "end": 42016, "text": "Y otros, tomando a sus siervos, los maltrataron y los mataron.", "words": [[0, 37083], [2, 37242], [9, 37562], [17, 38222], [19, 38342], [23, 38502], [32, 39702], [36, 39802], [48, 40702], [50, 41042], [54, 41182]]}, {"verse": 7, "start": 42466, "end": 52317, "text": "Y el rey, oyendo esto, se enojó; y enviando sus ejércitos, destruyó a aquellos asesinos, y puso fuego a su ciudad.", "words": [[0, 42466], [2, 42626], [5, 42766], [10, 43426], [17, 43906], [23, 44346], [26, 44826], [33, 45951], [35, 46057], [44, 46537], [48, 46777], [59, 47757], [68, 48837], [70, 49057], [79, 49397], [89, 50177], [91, 50617], [96, 50977], [102, 51337], [104, 51557], [107, 51697]]}, {"verse": 8, "start": 52767, "end": 61246, "text": "Entonces dice a sus siervos: Las bodas a la verdad están preparadas; pero los que eran llamados no eran dignos.", "words": [[0, 52767], [9, 53475], [14, 54355], [16, 54535], [20, 54655], [29, 55763], [33, 55910], [39, 56390], [41, 56550], [44, 56650], [51, 56910], [57, 57330], [69, 58882], [74, 59026], [78, 59186], [82, 59366], [87, 59566], [96, 60026], [99, 60226], [104, 60426]]}, {"verse": 9, "start": 61696, "end": 66302, "text": "Id pues a los cruces de los caminos, y llamad a las bodas a cuantos encontréis.", "words": [[0, 61820], [3, 61980], [8, 62140], [10, 62420], [14, 62540], [21, 62960], [24, 63080], [28, 63180], [37, 63720], [39, 63907], [46, 64093], [48, 64280], [52, 64460], [58, 64800], [60, 64920], [68, 65300]]}, {"verse": 10, "start": 66752, "end": 75714, "text": "Y saliendo los siervos por los caminos, juntaron a todos los que hallaron, juntamente malos y buenos: y las bodas fueron llenas de invitados.", "words": [[0, 66752], [2, 66859], [11, 67319], [15, 67499], [23, 67919], [27, 68119], [31, 68259], [40, 68779], [49, 69639], [51, 69779], [57, 70139], [61, 70539], [65, 70699], [75, 71199], [86, 72019], [92, 72519], [94, 72639], [102, 73540], [104, 73665], [108, 73805], [114, 74125], [121, 74345], [128, 74765], [131, 74865]]}, {"verse": 11, "start": 76164, "end": 80717, "text": "Y entró el rey para ver los invitados, y vio allí un hombre no vestido de boda.", "words": [[0, 76164], [2, 76307], [8, 76687], [11, 76827], [15, 77107], [20, 77267], [24, 77487], [28, 77627], [39, 78367], [41, 78607], [45, 78847], [50, 79027], [53, 79247], [60, 79507], [63, 79707], [71, 80127], [74, 80267]]}, {"verse": 12, "start": 81167, "end": 87743, "text": "Y le dijo: Amigo, ¿cómo entraste aquí no teniendo vestido de boda? Pero él se quedó sin palabras.", "words": [[0, 81167], [2, 81294], [5, 81374], [11, 82429], [18, 82769], [24, 82889], [33, 83469], [38, 83669], [41, 84042], [50, 84416], [58, 84789], [61, 84929], [67, 85773], [72, 85935], [75, 86235], [78, 86415], [84, 86715], [88, 86875]]}, {"verse": 13, "start": 88193, "end": 100464, "text": "Entonces el rey dijo a los que servían: Atado de pies y de manos tomadle, y echadle en las tinieblas de afuera: allí será el llanto y el crujir de dientes.", "words": [[0, 88193], [9, 88826], [12, 89286], [16, 89646], [21, 90026], [23, 90166], [27, 90266], [31, 90406], [40, 91535], [46, 92003], [49, 92163], [54, 92423], [56, 92603], [59, 92723], [65, 93153], [74, 93583], [76, 94243], [84, 94963], [87, 95223], [91, 95403], [101, 96063], [104, 96163], [112, 97076], [117, 97375], [122, 97575], [125, 97815], [132, 98375], [134, 98795], [137, 99145], [144, 99495], [147, 99635]]}, {"verse": 14, "start": 100914, "end": 104377, "text": "Porque muchos son llamados, y pocos escogidos.", "words": [[0, 100914], [7, 101099], [14, 101399], [18, 101839], [28, 102559], [30, 102959], [36, 103419]]}, {"verse": 15, "start": 104827, "end": 110728, "text": "Entonces, idos los fariseos, consultaron cómo le tomarían en alguna palabra.", "words": [[0, 104827], [10, 105284], [15, 106084], [19, 106344], [29, 107224], [41, 108264], [46, 108604], [49, 108784], [58, 109444], [61, 109704], [68, 109984]]}, {"verse": 16, "start": 111178, "end": 125474, "text": "Y envían a él los discípulos de ellos, con los Herodianos, diciendo: Maestro, sabemos que eres sincero, y que enseñas con verdad el camino de Dios, y que no te dejas influir por nadie, porque no muestras favoritismo.", "words": [[0, 111178], [2, 111465], [9, 111945], [11, 112085], [14, 112325], [18, 112645], [29, 113325], [32, 113505], [39, 113845], [43, 114365], [47, 114585], [59, 115445], [69, 116703], [78, 117267], [86, 117547], [90, 117887], [95, 118007], [104, 118947], [106, 119087], [110, 119187], [118, 119707], [122, 119847], [129, 120207], [132, 120427], [139, 120707], [142, 120947], [148, 121227], [150, 121727], [154, 121847], [157, 121987], [160, 122147], [166, 122447], [174, 122927], [178, 123087], [185, 123487], [192, 123947], [195, 124147], [204, 124607]]}, {"verse": 17, "start": 125924, "end": 130249, "text": "Dinos pues, ¿qué te parece? ¿es lícito dar tributo a César, o no?", "words": [[0, 125924], [6, 126250], [12, 126690], [17, 126770], [20, 126910], [28, 127809], [32, 127953], [39, 128353], [43, 128753], [51, 129153], [53, 129253], [60, 129693], [62, 129953]]}, {"verse": 18, "start": 130599, "end": 136058, "text": "Pero Jesús, entendida la malicia de ellos, les dice: ¿Por qué me tentáis, hipócritas?", "words": [[0, 130599], [5, 130745], [12, 131325], [22, 131965], [25, 132125], [33, 132565], [36, 132745], [43, 133285], [47, 133385], [53, 134175], [58, 134297], [62, 134544], [65, 134790], [74, 135037]]}, {"verse": 19, "start": 136508, "end": 141590, "text": "Mostradme la moneda del tributo. Y ellos le presentaron un denario.", "words": [[0, 136783], [10, 137093], [13, 137213], [20, 137573], [24, 137773], [33, 138886], [35, 139146], [41, 139506], [44, 139906], [56, 140586], [59, 140906]]}, {"verse": 20, "start": 142040, "end": 146727, "text": "Entonces les dice: ¿De quién son esta imagen y esta inscripción?", "words": [[0, 142040], [9, 142427], [13, 142727], [19, 143568], [23, 143715], [29, 143935], [33, 144275], [38, 144515], [45, 144995], [47, 145335], [52, 145575]]}, {"verse": 21, "start": 147177, "end": 155440, "text": "Le dicen: De César. Y les dice: Pagad pues a César lo que es de César, y a Dios lo que es de Dios.", "words": [[0, 147177], [3, 147322], [10, 148289], [13, 148433], [20, 149382], [22, 149475], [26, 149605], [32, 150435], [38, 150853], [43, 151013], [45, 151233], [51, 151713], [54, 152093], [58, 152253], [61, 152413], [64, 152533], [71, 153153], [73, 153373], [75, 153513], [80, 153733], [83, 154353], [87, 154513], [90, 154733], [93, 154853]]}, {"verse": 22, "start": 155890, "end": 160489, "text": "Y oyendo esto, se maravillaron; y dejándole se fueron.", "words": [[0, 155890], [2, 156213], [9, 156593], [15, 157373], [18, 157533], [32, 158896], [34, 159249], [44, 159639], [47, 159839]]}, {"verse": 23, "start": 160939, "end": 168095, "text": "Aquel día llegaron a él los saduceos, que dicen no haber resurrección, y le preguntaron,", "words": [[0, 160939], [6, 161280], [10, 161500], [19, 162060], [21, 162160], [24, 162360], [28, 162760], [38, 163940], [42, 164420], [48, 164720], [51, 165120], [57, 165400], [71, 166520], [73, 167080], [76, 167180]]}, {"verse": 24, "start": 168545, "end": 177203, "text": "Diciendo: Maestro, Moisés dijo: Si alguno muere sin hijos, su hermano se casará con su mujer, y levantará descendencia a su hermano.", "words": [[0, 168545], [10, 169571], [19, 170017], [26, 170457], [32, 171405], [35, 171546], [42, 171946], [48, 172226], [52, 172466], [59, 173206], [62, 173286], [70, 173726], [73, 173846], [80, 174246], [84, 174426], [87, 174586], [94, 174926], [96, 175346], [106, 175936], [119, 176526], [121, 176626], [124, 176706]]}, {"verse": 25, "start": 177653, "end": 185686, "text": "Hubo pues, entre nosotros siete hermanos: y el primero tomó mujer, y murió; y no teniendo descendencia, dejó su mujer a su hermano.", "words": [[0, 177653], [5, 178113], [11, 178293], [17, 178553], [26, 178873], [32, 179353], [42, 180394], [44, 180500], [47, 180600], [55, 180940], [60, 181300], [67, 181620], [69, 182060], [76, 182815], [78, 182921], [81, 183021], [90, 183461], [104, 184241], [109, 184581], [112, 184681], [118, 184981], [120, 185101], [123, 185181]]}, {"verse": 26, "start": 186136, "end": 189844, "text": "De la misma manera también el segundo, y el tercero, hasta los siete.", "words": [[0, 186136], [3, 186261], [6, 186361], [12, 186561], [19, 186981], [27, 187241], [30, 187501], [39, 187861], [41, 188201], [44, 188301], [53, 188881], [59, 189161], [63, 189341]]}, {"verse": 27, "start": 190294, "end": 192494, "text": "Y después de todos murió también la mujer.", "words": [[0, 190294], [2, 190404], [10, 190684], [13, 190904], [19, 191124], [25, 191584], [33, 191804], [36, 192024]]}, {"verse": 28, "start": 192944, "end": 198364, "text": "En la resurrección pues, ¿de cuál de los siete será ella mujer? porque todos la tuvieron.", "words": [[0, 192944], [3, 193069], [6, 193189], [19, 193829], [25, 194729], [29, 194809], [34, 195029], [37, 195189], [41, 195329], [47, 195569], [52, 195889], [57, 196129], [64, 197008], [71, 197175], [77, 197475], [80, 197755]]}, {"verse": 29, "start": 198714, "end": 206493, "text": "Entonces respondiendo Jesús, les dijo: Erráis ignorando las Escrituras, y el poder de Dios.", "words": [[0, 198714], [9, 200005], [22, 200785], [29, 201125], [33, 201545], [39, 202374], [46, 203009], [56, 203869], [60, 204089], [72, 204789], [74, 205089], [77, 205229], [83, 205589], [86, 205829]]}, {"verse": 30, "start": 206943, "end": 216353, "text": "Porque en la resurrección, ni se casarán ni se darán en casamiento; sino que son como los ángeles de Dios en el cielo.", "words": [[0, 206943], [7, 207328], [10, 207668], [13, 207808], [27, 208688], [30, 209568], [33, 209748], [41, 210358], [44, 210968], [47, 211108], [53, 211488], [56, 211648], [68, 213024], [73, 213261], [77, 213481], [81, 213721], [86, 214021], [90, 214201], [98, 214761], [101, 214961], [106, 215221], [109, 215581], [112, 215721]]}, {"verse": 31, "start": 216803, "end": 223665, "text": "Y de la resurrección de los muertos, ¿no habéis leído lo que os es dicho por Dios, que dice:", "words": [[0, 216803], [2, 217010], [5, 217150], [8, 217330], [21, 218290], [24, 218430], [28, 218570], [37, 220030], [41, 220330], [48, 220710], [54, 221250], [57, 221450], [61, 221630], [64, 221770], [67, 221910], [73, 222230], [77, 222510], [83, 222770], [87, 223190]]}, {"verse": 32, "start": 224115, "end": 233377, "text": "Yo soy el Dios de Abraham, y el Dios de Isaac, y el Dios de Jacob? Dios no es Dios de muertos, sino de vivos.", "words": [[0, 224115], [3, 224320], [7, 224640], [10, 224860], [15, 225100], [18, 225320], [27, 225760], [29, 226720], [32, 226880], [37, 227140], [40, 227360], [47, 227900], [49, 228740], [52, 228900], [57, 229140], [60, 229300], [67, 230173], [72, 230439], [75, 230879], [78, 231099], [83, 231319], [86, 231519], [95, 232239], [100, 232559], [103, 232759]]}, {"verse": 33, "start": 233827, "end": 237172, "text": "Y oyendo esto la gente se admiraba de su doctrina.", "words": [[0, 233827], [2, 233977], [9, 234337], [14, 234617], [17, 234817], [23, 235137], [26, 235437], [35, 236057], [38, 236217], [41, 236397]]}, {"verse": 34, "start": 237622, "end": 244790, "text": "Entonces los fariseos, oyendo que había hecho callar a los saduceos, se juntaron a una.", "words": [[0, 237622], [9, 238359], [13, 238859], [23, 240079], [30, 240439], [34, 240659], [40, 240879], [46, 241199], [53, 241639], [55, 241739], [59, 241919], [69, 243239], [72, 243479], [81, 244039], [83, 244279]]}, {"verse": 35, "start": 245240, "end": 250691, "text": "Y preguntó uno de ellos, experto en la ley, tentándole y diciendo:", "words": [[0, 245240], [2, 245344], [11, 246004], [15, 246344], [18, 246524], [25, 247144], [33, 247864], [36, 248004], [39, 248164], [44, 248804], [55, 249684], [57, 249964]]}, {"verse": 36, "start": 250941, "end": 253700, "text": "Maestro, ¿cuál es el mandamiento grande en la ley?", "words": [[0, 250941], [9, 251739], [15, 251979], [18, 252099], [21, 252219], [33, 252759], [40, 253059], [43, 253299], [46, 253399]]}, {"verse": 37, "start": 254050, "end": 261801, "text": "Y Jesús le dijo: Amarás al Señor tu Dios de todo tu corazón, y de toda tu alma, y de toda tu mente.", "words": [[0, 254050], [2, 254197], [8, 254537], [11, 254877], [17, 255699], [24, 256205], [27, 256385], [33, 256705], [36, 257025], [41, 257405], [44, 257925], [49, 258185], [52, 258425], [61, 258885], [63, 259405], [66, 259525], [71, 259725], [74, 260025], [80, 260345], [82, 260645], [85, 260745], [90, 260985], [93, 261205]]}, {"verse": 38, "start": 262251, "end": 265198, "text": "Este es el primero y el grande mandamiento.", "words": [[0, 262251], [5, 262575], [8, 262775], [11, 262895], [19, 263315], [21, 263735], [24, 264227], [31, 264720]]}, {"verse": 39, "start": 265648, "end": 270910, "text": "Y el segundo es semejante a este: Amarás a tu prójimo como a ti mismo.", "words": [[0, 265648], [2, 265788], [5, 265908], [13, 266328], [16, 266668], [26, 267348], [28, 267548], [34, 268384], [41, 268880], [43, 269020], [46, 269180], [54, 269800], [59, 270040], [61, 270220], [64, 270320]]}, {"verse": 40, "start": 271360, "end": 275499, "text": "De estos dos mandamientos depende toda la ley y los profetas.", "words": [[0, 271360], [3, 271527], [9, 271767], [13, 272007], [26, 272707], [34, 273067], [39, 273627], [42, 273947], [46, 274227], [48, 274407], [52, 274567]]}, {"verse": 41, "start": 275949, "end": 279241, "text": "Y estando juntos los fariseos, Jesús les preguntó,", "words": [[0, 275949], [2, 276046], [10, 276406], [17, 276746], [21, 277006], [31, 278026], [37, 278286], [41, 278546]]}, {"verse": 42, "start": 279691, "end": 285776, "text": "Diciendo: ¿Qué os parece del Cristo? ¿de quién es Hijo? Le dicen: De David.", "words": [[0, 279691], [10, 280767], [15, 280870], [18, 280990], [25, 281350], [29, 281590], [37, 282676], [41, 282820], [47, 283000], [50, 283240], [56, 284066], [59, 284211], [66, 285178], [69, 285361]]}, {"verse": 43, "start": 286126, "end": 290715, "text": "Él les dice: ¿Pues cómo David en Espíritu le llama Señor, diciendo:", "words": [[0, 286126], [3, 286330], [7, 286450], [13, 287366], [19, 287630], [24, 287930], [30, 288230], [33, 288410], [42, 288990], [45, 289090], [51, 289290], [58, 290110]]}, {"verse": 44, "start": 291165, "end": 298289, "text": "Dijo el Señor a mi Señor: Siéntate a mi derecha, entre tanto que pongo tus enemigos por estrado de tus pies?", "words": [[0, 291165], [5, 291432], [8, 291632], [14, 291892], [16, 292132], [19, 292252], [26, 293156], [35, 293662], [37, 293782], [40, 293922], [49, 294782], [55, 295022], [61, 295382], [65, 295622], [71, 295982], [75, 296182], [84, 296682], [88, 296982], [96, 297362], [99, 297542], [103, 297702]]}, {"verse": 45, "start": 298739, "end": 301686, "text": "Pues si David le llama Señor, ¿cómo es su Hijo?", "words": [[0, 298739], [5, 298880], [8, 299060], [14, 299280], [17, 299560], [23, 299860], [30, 300660], [36, 300820], [39, 301060], [42, 301220]]}, {"verse": 46, "start": 302136, "end": 308141, "text": "Y nadie le podía responder palabra; ni se atrevió alguno desde aquel día a preguntarle más.", "words": [[0, 302136], [2, 302264], [8, 302564], [11, 302804], [17, 303104], [27, 303644], [36, 304828], [39, 305008], [42, 305168], [50, 305668], [57, 306148], [63, 306288], [69, 306668], [73, 306868], [75, 307028], [87, 307568]]}]}