{"book": "PSA", "chapter": 109, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 187059, "verses": [{"verse": 1, "start": 300, "end": 5658, "text": "Al Músico principal: Salmo de David. OH Dios de mi alabanza, no calles;", "words": [[0, 300], [3, 479], [10, 979], [21, 2069], [27, 2616], [30, 2776], [37, 3514], [40, 3662], [45, 3977], [48, 4292], [51, 4607], [61, 4922], [64, 5022]]}, {"verse": 2, "start": 6008, "end": 13746, "text": "Porque boca de impío y boca de engañador se han abierto sobre mí: han hablado de mí con lengua mentirosa,", "words": [[0, 6008], [7, 6232], [12, 6552], [15, 6792], [21, 7432], [23, 7672], [28, 7912], [31, 8132], [41, 8872], [44, 9312], [48, 9472], [56, 10092], [62, 10412], [66, 11110], [70, 11370], [78, 11970], [81, 12110], [84, 12270], [88, 12430], [95, 12850]]}, {"verse": 3, "start": 14096, "end": 19491, "text": "Y con palabras de odio me rodearon; y pelearon contra mí sin causa.", "words": [[0, 14096], [2, 14222], [6, 14482], [15, 14902], [18, 15202], [23, 15582], [26, 15762], [36, 16952], [38, 17078], [47, 17698], [54, 18098], [57, 18398], [61, 18638]]}, {"verse": 4, "start": 19841, "end": 23702, "text": "En pago de mi amor me han sido adversarios: mas yo oraba.", "words": [[0, 19841], [3, 20025], [8, 20485], [11, 20625], [14, 20785], [19, 21045], [22, 21225], [26, 21345], [31, 21605], [44, 23006], [48, 23253], [51, 23499]]}, {"verse": 5, "start": 24053, "end": 27497, "text": "Y pusieron contra mí mal por bien, y odio por amor.", "words": [[0, 24053], [2, 24175], [11, 24635], [18, 25055], [21, 25335], [25, 25615], [29, 25835], [35, 26095], [37, 26395], [42, 26755], [46, 26955]]}, {"verse": 6, "start": 27847, "end": 32156, "text": "Pon sobre él al impío: y Satán esté a su diestra.", "words": [[0, 27847], [4, 28033], [10, 28333], [13, 28697], [16, 29060], [23, 29644], [25, 30004], [31, 30384], [36, 31024], [38, 31224], [41, 31344]]}, {"verse": 7, "start": 32506, "end": 37366, "text": "Cuando sea juzgado, salga culpable; y su oración sea para pecado.", "words": [[0, 32506], [7, 32806], [11, 33126], [20, 33646], [26, 34126], [36, 35241], [38, 35367], [41, 35547], [49, 36015], [53, 36482], [58, 36950]]}, {"verse": 8, "start": 37716, "end": 41083, "text": "Sean sus días pocos: tome otro su oficio.", "words": [[0, 37880], [5, 38080], [9, 38280], [14, 38480], [21, 39470], [26, 39715], [31, 39935], [34, 40195]]}, {"verse": 9, "start": 41433, "end": 44659, "text": "Sean sus hijos huérfanos, y su mujer viuda.", "words": [[0, 41433], [5, 41737], [9, 41957], [15, 42297], [26, 43177], [28, 43477], [31, 43637], [37, 43977]]}, {"verse": 10, "start": 45009, "end": 52401, "text": "Y anden sus hijos vagabundos, y mendiguen; y procuren su pan lejos de sus desolados hogares.", "words": [[0, 45009], [2, 45138], [8, 45458], [12, 45678], [18, 45998], [30, 46718], [32, 46938], [43, 48122], [45, 48468], [54, 48858], [57, 49018], [61, 49378], [67, 50158], [70, 50318], [74, 50478], [84, 51358]]}, {"verse": 11, "start": 52751, "end": 58349, "text": "Se apodere el acreedor de todo lo que tiene, y extraños saqueen su trabajo.", "words": [[0, 52751], [3, 52938], [11, 53538], [14, 53758], [23, 54398], [26, 54618], [31, 54898], [34, 55118], [38, 55218], [45, 55618], [47, 55898], [56, 56668], [64, 57438], [67, 57618]]}, {"verse": 12, "start": 58699, "end": 64989, "text": "No tenga quien le haga misericordia; ni haya quien tenga compasión de sus huérfanos.", "words": [[0, 58699], [3, 58846], [9, 59266], [15, 59546], [18, 59826], [23, 60026], [37, 61644], [40, 61904], [45, 62164], [51, 62264], [57, 62784], [67, 63544], [70, 63724], [74, 63904]]}, {"verse": 13, "start": 65339, "end": 71121, "text": "Su posteridad sea talada; en segunda generación sea borrado su nombre.", "words": [[0, 65339], [3, 65483], [14, 66170], [18, 66858], [26, 67729], [29, 67877], [37, 68277], [48, 69037], [52, 69397], [60, 70177], [63, 70417]]}, {"verse": 14, "start": 71471, "end": 78846, "text": "Venga en memoria cerca de Jehová la maldad de sus padres, y el pecado de su madre no sea borrado.", "words": [[0, 71471], [6, 71876], [9, 71996], [17, 72416], [23, 72736], [26, 73016], [33, 73456], [36, 73536], [43, 74016], [46, 74196], [50, 74336], [58, 75196], [60, 75536], [63, 75696], [70, 76396], [73, 76596], [76, 76776], [82, 77196], [85, 77770], [89, 78345]]}, {"verse": 15, "start": 79196, "end": 83844, "text": "Estén siempre delante de Jehová, y él corte de la tierra su memoria.", "words": [[0, 79196], [6, 79578], [14, 80058], [22, 80598], [25, 80758], [33, 81238], [35, 81398], [38, 81558], [44, 82198], [47, 82278], [50, 82438], [57, 82718], [60, 83058]]}, {"verse": 16, "start": 84194, "end": 94174, "text": "Por cuanto no se acordó de hacer misericordia, y persiguió al hombre afligido y necesitado y quebrantado de corazón, para matarlo.", "words": [[0, 84194], [4, 84339], [11, 84659], [14, 85099], [17, 85299], [24, 85859], [27, 85979], [33, 86689], [47, 87399], [49, 87839], [59, 88859], [62, 89099], [69, 89419], [78, 90279], [80, 90379], [91, 91199], [93, 91339], [105, 92219], [108, 92359], [117, 92859], [122, 93419]]}, {"verse": 17, "start": 94524, "end": 100184, "text": "Y amó la maldición, y le vino; y no quiso la bendición, y ella se alejó de él.", "words": [[0, 94629], [2, 94769], [6, 94909], [9, 95009], [20, 95629], [22, 95954], [25, 96094], [31, 96845], [33, 96952], [36, 97072], [42, 97412], [45, 97572], [56, 98212], [58, 98672], [63, 98972], [66, 99172], [72, 99652], [75, 99772]]}, {"verse": 18, "start": 100534, "end": 107694, "text": "Y se vistió de maldición como de su vestido, y entró como agua en sus entrañas, y como aceite en sus huesos.", "words": [[0, 100534], [2, 100659], [5, 100799], [12, 101239], [15, 101339], [25, 101939], [30, 102239], [33, 102419], [36, 102559], [45, 103199], [47, 103579], [53, 104039], [58, 104239], [63, 104599], [66, 104779], [70, 104919], [80, 105639], [82, 105954], [87, 106194], [94, 106614], [97, 106914], [101, 107114]]}, {"verse": 19, "start": 108044, "end": 114206, "text": "Le sea como vestido con que se cubra, y en lugar de cinto con que se ciña siempre.", "words": [[0, 108044], [3, 108171], [7, 108491], [12, 108791], [20, 109411], [24, 109651], [28, 109831], [31, 109991], [38, 110551], [40, 111271], [43, 111431], [49, 111751], [52, 112031], [58, 112471], [62, 112751], [66, 112911], [69, 113051], [74, 113451]]}, {"verse": 20, "start": 114556, "end": 120870, "text": "Este sea el pago de parte de Jehová de los que me calumnian, y de los que hablan mal contra mi alma.", "words": [[0, 114556], [5, 114848], [9, 115168], [12, 115328], [17, 115828], [20, 115968], [26, 116368], [29, 116608], [36, 117128], [39, 117208], [43, 117328], [47, 117488], [50, 117628], [61, 118348], [63, 118808], [66, 118928], [70, 119068], [74, 119228], [81, 119528], [85, 119788], [92, 120128], [95, 120388]]}, {"verse": 21, "start": 121220, "end": 128130, "text": "Y tú, Jehová Señor, haz conmigo por amor de tu nombre: líbrame, porque tu misericordia es buena.", "words": [[0, 121220], [2, 121524], [6, 121964], [13, 122284], [20, 123264], [24, 123444], [32, 124004], [36, 124284], [41, 124524], [44, 124764], [47, 124904], [55, 125778], [64, 126403], [71, 126623], [74, 126843], [87, 127643], [90, 127763]]}, {"verse": 22, "start": 128480, "end": 133007, "text": "Porque yo estoy afligido y necesitado; y mi corazón está herido dentro de mí.", "words": [[0, 128480], [7, 128644], [10, 128844], [16, 129024], [25, 129664], [27, 129764], [39, 130947], [41, 131055], [44, 131175], [52, 131555], [57, 131875], [64, 132215], [71, 132435], [74, 132735]]}, {"verse": 23, "start": 133357, "end": 137899, "text": "Me voy como la sombra cuando declina; soy sacudido como langosta.", "words": [[0, 133357], [3, 133482], [7, 133642], [12, 133882], [15, 134042], [22, 134622], [29, 135194], [38, 135985], [42, 136185], [51, 136885], [56, 137411]]}, {"verse": 24, "start": 138249, "end": 144848, "text": "Mis rodillas están debilitadas a causa del ayuno, y mi carne desfallecida por falta de grasa.", "words": [[0, 138249], [4, 138394], [13, 138914], [19, 139274], [31, 140054], [33, 140234], [39, 140514], [43, 140814], [50, 141254], [52, 141914], [55, 142074], [61, 142474], [74, 143434], [78, 143654], [84, 144014], [87, 144254]]}, {"verse": 25, "start": 145198, "end": 151371, "text": "Yo he sido para ellos objeto de deshonra; me miraban, y meneaban su cabeza.", "words": [[0, 145198], [3, 145462], [6, 145722], [11, 146002], [16, 146282], [22, 146562], [29, 147062], [32, 147637], [42, 148417], [45, 148543], [54, 149123], [56, 149733], [65, 150343], [68, 150563]]}, {"verse": 26, "start": 151721, "end": 156380, "text": "Ayúdame, Jehová Dios mío: sálvame conforme a tu misericordia.", "words": [[0, 152101], [9, 152507], [16, 152914], [21, 152994], [26, 153869], [34, 154465], [43, 155165], [45, 155225], [48, 155325]]}, {"verse": 27, "start": 156730, "end": 161198, "text": "Y entiendan que esta es tu mano; que tú, Jehová, has hecho esto.", "words": [[0, 156730], [2, 157060], [12, 157800], [16, 157990], [21, 158180], [24, 158340], [27, 158440], [33, 159404], [37, 159535], [41, 159667], [49, 160227], [53, 160367], [59, 160607]]}, {"verse": 28, "start": 161548, "end": 168816, "text": "Maldigan ellos, y bendice tú: levántense, mas sean avergonzados, y regocíjese tu siervo.", "words": [[0, 161548], [9, 162369], [16, 162689], [18, 162929], [26, 163349], [30, 163966], [42, 165034], [46, 165194], [51, 165654], [65, 166714], [67, 167364], [78, 168014], [81, 168214]]}, {"verse": 29, "start": 169166, "end": 175481, "text": "Sean vestidos de deshonra los que me calumnian; y sean cubiertos de su confusión como con manto.", "words": [[0, 169166], [5, 169449], [14, 169989], [17, 170369], [26, 170749], [30, 170869], [34, 171009], [37, 171540], [48, 172232], [50, 172508], [55, 172688], [65, 173368], [68, 173488], [71, 173628], [81, 174288], [86, 174508], [90, 174728]]}, {"verse": 30, "start": 175831, "end": 180965, "text": "Yo alabaré a Jehová en gran manera con mi boca, y le alabaré en medio de muchos.", "words": [[0, 175831], [3, 176009], [11, 176529], [13, 176649], [20, 177069], [23, 177229], [28, 177429], [35, 177869], [39, 178109], [42, 178289], [48, 178629], [50, 178884], [53, 179024], [61, 179584], [64, 179724], [70, 180004], [73, 180224]]}, {"verse": 31, "start": 181315, "end": 186659, "text": "Porque él se pondrá a la diestra del pobre, para librar su alma de los que le juzgan.", "words": [[0, 181315], [7, 181540], [10, 181780], [13, 181940], [20, 182440], [22, 182700], [25, 182780], [33, 183280], [37, 183500], [44, 183900], [49, 184225], [56, 184765], [59, 185025], [64, 185345], [67, 185605], [71, 185725], [75, 185885], [78, 185985]]}]}