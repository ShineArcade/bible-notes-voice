{"book": "PSA", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 137113, "verses": [{"verse": 1, "start": 300, "end": 10332, "text": "Al Músico principal: sobre Mut-laben: Salmo de David. TE alabaré, oh Jehová, con todo mi corazón; contaré todas tus maravillas.", "words": [[0, 300], [3, 484], [10, 984], [21, 2065], [27, 2788], [38, 3704], [44, 4250], [47, 4390], [54, 5236], [57, 5342], [66, 5732], [69, 6122], [77, 6582], [81, 6882], [86, 7202], [89, 7462], [98, 8426], [106, 8830], [112, 9130], [116, 9450]]}, {"verse": 2, "start": 10682, "end": 16439, "text": "Me alegraré y me regocijaré en ti: cantaré a tu nombre, oh Altísimo;", "words": [[0, 10682], [3, 11002], [12, 11622], [14, 11882], [17, 12042], [28, 12982], [31, 13202], [35, 14183], [43, 14389], [45, 14596], [48, 14796], [56, 15156], [59, 15516]]}, {"verse": 3, "start": 16789, "end": 21865, "text": "Por haber sido mis enemigos vueltos atrás: caerán y perecerán delante de ti.", "words": [[0, 16789], [4, 16933], [10, 17113], [15, 17453], [19, 17633], [28, 18133], [36, 18613], [43, 19472], [50, 20075], [52, 20255], [62, 20875], [70, 21335], [73, 21515]]}, {"verse": 4, "start": 22215, "end": 27861, "text": "Porque has hecho mi juicio y mi causa: te sentaste en silla juzgando justicia.", "words": [[0, 22215], [7, 22377], [11, 22617], [17, 22837], [20, 23037], [27, 23577], [29, 23877], [32, 23997], [39, 24881], [42, 24986], [51, 25586], [54, 25866], [60, 26266], [69, 26946]]}, {"verse": 5, "start": 28211, "end": 34885, "text": "Reprendiste a las naciones, destruiste al malo, borraste el nombre de ellos para siempre.", "words": [[0, 28588], [12, 28998], [14, 29138], [18, 29258], [28, 30538], [39, 31138], [42, 31318], [48, 32048], [57, 32778], [60, 32878], [67, 33258], [70, 33538], [76, 33798], [81, 34098]]}, {"verse": 6, "start": 35235, "end": 43152, "text": "Oh enemigo, acabados son para siempre los asolamientos; y las ciudades que derribaste, su memoria pereció con