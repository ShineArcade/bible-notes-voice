{"book": "LUK", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 534372, "verses": [{"verse": 1, "start": 300, "end": 8098, "text": "Habiendo muchos intentado poner en orden la historia de las cosas que entre nosotros han sido ciertísimas,", "words": [[0, 300], [9, 656], [16, 1016], [26, 1876], [32, 2216], [35, 2436], [41, 2756], [44, 3336], [53, 3836], [56, 4096], [60, 4236], [66, 4676], [70, 4976], [76, 5296], [85, 5796], [89, 6276], [94, 6656]]}, {"verse": 2, "start": 8548, "end": 15002, "text": "Como nos lo enseñaron los que desde el principio lo vieron por sus ojos, y fueron ministros de la palabra;", "words": [[0, 8548], [5, 8714], [9, 8914], [12, 9054], [22, 9854], [26, 9974], [30, 10174], [36, 10514], [39, 10754], [49, 11334], [52, 11574], [59, 11874], [63, 12074], [67, 12294], [73, 12674], [75, 13174], [82, 13394], [92, 14054], [95, 14194], [98, 14294]]}, {"verse": 3, "start": 15452, "end": 26277, "text": "Me ha parecido también a mí, después de haber entendido todas las cosas desde el principio con diligencia, escribírtelas por orden, oh muy buen Teófilo,", "words": [[0, 15452], [3, 15618], [6, 15758], [15, 16258], [23, 16618], [25, 16858], [29, 17238], [37, 17838], [40, 18018], [46, 18198], [56, 18858], [62, 19178], [66, 19498], [72, 19858], [78, 20278], [81, 20578], [91, 21178], [95, 21958], [107, 22738], [121, 23658], [125, 23898], [132, 24418], [135, 24938], [139, 25278], [144, 25578]]}, {"verse": 4, "start": 26727, "end": 31690, "text": "Para que conozcas la verdad de las cosas en las cuales has sido enseñado.", "words": [[0, 26727], [5, 26913], [9, 27073], [18, 27593], [21, 27753], [28, 27993], [31, 28313], [35, 28473], [41, 28873], [44, 29553], [48, 29653], [55, 30003], [59, 30353], [64, 30713]]}, {"verse": 5, "start": 32140, "end": 44145, "text": "HUBO en los días de Herodes, rey de Judea, un sacerdote llamado Zacarías, del grupo sacerdotal de Abías; y su mujer, de las hijas de Aarón, llamada Elisabet.", "words": [[0, 32140], [5, 32406], [8, 32466], [12, 32566], [17, 32826], [20, 33046], [29, 33586], [33, 34126], [36, 34346], [43, 35326], [46, 35426], [56, 36126], [64, 36446], [74, 37846], [78, 37926], [84, 38266], [95, 39506], [98, 39970], [105, 40685], [107, 40789], [110, 40909], [117, 41229], [120, 41389], [124, 41569], [130, 41909], [133, 42389], [140, 42869], [148, 43537]]}, {"verse": 6, "start": 44595, "end": 52222, "text": "Y eran ambos justos delante de Dios, andando sin reprensión en todos los mandamientos y estatutos del Señor.", "words": [[0, 44595], [2, 44738], [7, 44978], [13, 45578], [20, 46238], [28, 46698], [31, 46878], [37, 47478], [45, 48038], [49, 48528], [60, 49018], [63, 49358], [69, 49678], [73, 49898], [86, 50638], [88, 50858], [98, 51358], [102, 51618]]}, {"verse": 7, "start": 52672, "end": 60033, "text": "Y no tenían hijo, porque Elisabet era estéril, y ambos eran avanzados en días.", "words": [[0, 52672], [2, 52818], [5, 53118], [12, 53418], [18, 54278], [25, 54768], [34, 55258], [38, 55948], [47, 56638], [49, 57318], [55, 57698], [60, 58198], [70, 59118], [73, 59358]]}, {"verse": 8, "start": 60483, "end": 67775, "text": "Y aconteció que ejerciendo Zacarías el sacerdocio delante de Dios según el turno que le correspondía,", "words": [[0, 60483], [2, 60786], [12, 61446], [16, 62066], [27, 62686], [36, 63306], [39, 63506], [50, 64306], [58, 64766], [61, 64946], [66, 65586], [72, 65866], [75, 66106], [81, 66586], [85, 66666], [88, 66786]]}, {"verse": 9, "start": 68225, "end": 76452, "text": "Conforme a la costumbre del sacerdocio, salió en suerte a poner el incienso, entrando en el templo del Señor.", "words": [[0, 68225], [9, 68734], [11, 68934], [14, 68994], [24, 69574], [28, 69754], [40, 71094], [46, 71654], [49, 71914], [56, 72434], [58, 72594], [64, 72874], [67, 73074], [77, 74134], [86, 74734], [89, 74894], [92, 75034], [99, 75574], [103, 75714]]}, {"verse": 10, "start": 76902, "end": 82112, "text": "Y toda la multitud del pueblo estaba fuera orando a la hora del incienso.", "words": [[0, 76902], [2, 77040], [7, 77440], [10, 77700], [19, 78240], [23, 78440], [30, 78860], [37, 79160], [43, 79520], [50, 80260], [52, 80520], [55, 80640], [60, 80880], [64, 81100]]}, {"verse": 11, "start": 82562, "end": 88312, "text": "Y se le apareció el ángel del Señor puesto en pie a la derecha del altar del incienso.", "words": [[0, 82562], [2, 82709], [5, 82809], [8, 82969], [17, 83629], [20, 83929], [26, 84409], [30, 84529], [36, 84849], [43, 85249], [46, 85589], [50, 85829], [52, 86029], [55, 86129], [63, 86569], [67, 86789], [73, 87189], [77, 87469]]}, {"verse": 12, "start": 88762, "end": 92257, "text": "Y se turbó Zacarías viéndole, y cayó temor sobre él.", "words": [[0, 88762], [2, 88871], [5, 88991], [11, 89491], [20, 89991], [30, 90551], [32, 90751], [37, 91131], [43, 91511], [49, 91811]]}, {"verse": 13, "start": 92707, "end": 101948, "text": "Pero el ángel le dijo: Zacarías, no temas; porque tu oración ha sido oída, y tu mujer Elisabet te parirá un hijo, y llamarás su nombre Juan.", "words": [[0, 92707], [5, 92991], [8, 93151], [14, 93631], [17, 93911], [23, 94850], [33, 95140], [36, 95300], [43, 96194], [50, 96360], [53, 96580], [61, 97000], [64, 97200], [69, 97440], [75, 97880], [77, 98240], [80, 98360], [86, 98700], [95, 99040], [98, 99460], [105, 99840], [108, 100000], [114, 100260], [116, 100680], [125, 101080], [128, 101220], [135, 101440]]}, {"verse": 14, "start": 102398, "end": 105895, "text": "Y tendrás gozo y alegría, y muchos se gozarán de su nacimiento.", "words": [[0, 102398], [2, 102483], [10, 102803], [15, 103183], [17, 103303], [26, 103803], [28, 103983], [35, 104283], [38, 104483], [46, 104943], [49, 105003], [52, 105123]]}, {"verse": 15, "start": 106345, "end": 114953, "text": "Porque será grande delante de Dios, y no beberá vino ni bebida embriagante; y será lleno del Espíritu Santo, aun desde el seno de su madre.", "words": [[0, 106345], [7, 106575], [12, 106815], [19, 107215], [27, 107675], [30, 107855], [36, 108135], [38, 108715], [41, 108855], [48, 109275], [53, 109555], [56, 109775], [63, 110155], [76, 111333], [78, 111437], [83, 111617], [89, 112037], [93, 112157], [102, 112717], [109, 113077], [113, 113457], [119, 113737], [122, 113957], [127, 114277], [130, 114357], [133, 114497]]}, {"verse": 16, "start": 115403, "end": 118943, "text": "Y a muchos de los hijos de Israel convertirá al Señor Dios de ellos.", "words": [[0, 115403], [2, 115504], [4, 115604], [11, 115864], [14, 116044], [18, 116164], [24, 116384], [27, 116544], [34, 116864], [45, 117584], [48, 117684], [54, 117924], [59, 118224], [62, 118484]]}, {"verse": 17, "start": 119393, "end": 131396, "text": "Porque él irá delante de él con el espíritu y poder de Elías, para convertir los corazones de los padres a los hijos, y los rebeldes a la prudencia de los justos, para preparar al Señor un pueblo bien dispuesto.", "words": [[0, 119393], [7, 119612], [10, 119812], [14, 120052], [22, 120472], [25, 120612], [28, 120752], [32, 120952], [35, 121072], [44, 121652], [46, 121732], [52, 121972], [55, 122192], [62, 122812], [67, 123072], [77, 123652], [81, 123772], [91, 124372], [94, 124512], [98, 124652], [105, 124992], [107, 125232], [111, 125372], [118, 126250], [120, 126349], [124, 126449], [133, 126929], [135, 127049], [138, 127129], [148, 127569], [151, 127689], [155, 127829], [163, 128649], [168, 128949], [177, 129469], [180, 129549], [186, 129809], [189, 130049], [196, 130349], [201, 130629]]}, {"verse": 18, "start": 131746, "end": 139050, "text": "Y dijo Zacarías al ángel: ¿En qué conoceré esto? porque yo soy viejo, y mi mujer avanzada en días.", "words": [[0, 131746], [2, 131872], [7, 132672], [16, 133472], [19, 133692], [26, 134600], [30, 134737], [34, 134937], [43, 135477], [49, 136138], [56, 136318], [59, 136498], [63, 136678], [70, 137198], [72, 137518], [75, 137618], [81, 137858], [90, 138418], [93, 138538]]}, {"verse": 19, "start": 139400, "end": 149488, "text": "Y respondiendo el ángel le dijo: Yo soy Gabriel, que estoy delante de Dios; y soy enviado a hablarte, y a darte estas buenas nuevas.", "words": [[0, 139400], [2, 139607], [15, 140807], [18, 141007], [24, 141507], [27, 141627], [33, 142592], [36, 142742], [40, 142942], [49, 143562], [53, 143582], [59, 143862], [67, 144322], [70, 144482], [76, 145373], [78, 145498], [82, 145578], [90, 146158], [92, 146258], [102, 146858], [104, 147038], [106, 147178], [112, 147478], [118, 147698], [125, 148018]]}, {"verse": 20, "start": 149938, "end": 158017, "text": "Y he aquí estarás mudo y no podrás hablar, hasta el día que esto sea hecho, por cuanto no creíste a mis palabras, las cuales se cumplirán a su tiempo.", "words": [[0, 149938], [2, 150082], [5, 150202], [10, 150402], [18, 150882], [23, 151202], [25, 151282], [28, 151402], [35, 151782], [43, 152462], [49, 152722], [52, 152882], [56, 153062], [60, 153222], [65, 153422], [69, 153722], [76, 154202], [80, 154302], [87, 154482], [90, 154722], [98, 155002], [100, 155282], [104, 155402], [114, 156142], [118, 156262], [125, 156542], [128, 156802], [138, 157302], [140, 157362], [143, 157502]]}, {"verse": 21, "start": 158367, "end": 164552, "text": "Y el pueblo estaba esperando a Zacarías, y se maravillaban de que él se detuviese en el templo.", "words": [[0, 158367], [2, 158488], [5, 158628], [12, 158888], [19, 159228], [29, 159748], [31, 159928], [41, 160488], [43, 161288], [46, 161428], [59, 162108], [62, 162348], [66, 162488], [69, 162728], [72, 162908], [82, 163568], [85, 163748], [88, 163888]]}, {"verse": 22, "start": 165002, "end": 174737, "text": "Y saliendo, no les podía hablar: y entendieron que había visto visión en el templo: y él les hablaba por señas, y quedó mudo.", "words": [[0, 165002], [2, 165107], [12, 165567], [15, 165847], [19, 166047], [25, 166427], [33, 167386], [35, 167701], [47, 168401], [51, 168621], [57, 168821], [63, 169141], [70, 169681], [73, 169921], [76, 170081], [84, 171049], [86, 171269], [89, 171529], [93, 171909], [101, 172429], [105, 172649], [112, 173629], [114, 173869], [120, 174209]]}, {"verse": 23, "start": 175187, "end": 179185, "text": "Y fue, que cumplidos los días de su oficio, se vino a su casa.", "words": [[0, 175187], [2, 175295], [7, 175435], [11, 175575], [21, 176255], [25, 176435], [30, 176695], [33, 176875], [36, 177055], [44, 177875], [47, 178095], [52, 178295], [54, 178475], [57, 178575]]}, {"verse": 24, "start": 179635, "end": 186970, "text": "Y después de aquellos días concibió su mujer Elisabet, y se mantuvo oculta por cinco meses, diciendo:", "words": [[0, 179635], [2, 179745], [10, 180065], [13, 180225], [22, 180385], [27, 180765], [36, 181525], [39, 181665], [45, 182215], [55, 182765], [57, 183705], [60, 183825], [68, 184345], [75, 185005], [79, 185145], [85, 185445], [92, 186265]]}, {"verse": 25, "start": 187220, "end": 192511, "text": "Porque el Señor me ha hecho así en los días en que miró para quitar mi vergüenza entre los hombres.", "words": [[0, 187220], [7, 187420], [10, 187520], [16, 187780], [19, 188040], [22, 188120], [28, 188300], [32, 188620], [35, 188880], [39, 189040], [44, 189320], [47, 189560], [51, 189680], [56, 190020], [61, 190300], [68, 190680], [71, 190820], [81, 191380], [87, 191620], [91, 191800]]}, {"verse": 26, "start": 192861, "end": 198836, "text": "Y al sexto mes, el ángel Gabriel fue enviado de Dios a una ciudad de Galilea, llamada Nazaret,", "words": [[0, 192861], [2, 193018], [5, 193178], [11, 193638], [16, 194438], [19, 194738], [25, 195138], [33, 195538], [37, 195898], [45, 196458], [48, 196658], [53, 196898], [55, 197118], [59, 197278], [66, 197618], [69, 197898], [78, 198211], [86, 198523]]}, {"verse": 27, "start": 199286, "end": 208602, "text": "A una virgen desposada con un varón que se llamaba José, de la casa de David: y el nombre de la virgen era María.", "words": [[0, 200952], [2, 201052], [6, 201212], [13, 201632], [23, 202332], [27, 202572], [30, 202712], [36, 203052], [40, 203212], [43, 203332], [51, 203692], [57, 204152], [60, 204572], [63, 204672], [68, 204932], [71, 205172], [78, 206042], [80, 206204], [83, 206364], [90, 206764], [93, 206944], [96, 207084], [103, 207604], [107, 207944]]}, {"verse": 28, "start": 209052, "end": 217453, "text": "Y entrando el ángel a donde estaba, dijo, ¡Salve, muy favorecida! el Señor es contigo: bendita tú entre las mujeres.", "words": [[0, 209052], [2, 209198], [11, 209658], [14, 209878], [20, 210358], [22, 210458], [28, 210638], [36, 211078], [42, 212065], [50, 212466], [54, 212666], [66, 213824], [69, 213986], [75, 214266], [78, 214486], [87, 215531], [95, 216068], [98, 216288], [104, 216508], [108, 216728]]}, {"verse": 29, "start": 217803, "end": 224824, "text": "Pero ella, cuando le vio, se turbó de sus palabras, y pensaba qué clase de saludo era este.", "words": [[0, 217803], [5, 217968], [11, 218428], [18, 218528], [21, 218808], [26, 219568], [29, 219788], [35, 220248], [38, 220348], [42, 220508], [52, 221088], [54, 221848], [62, 222428], [66, 222668], [72, 223168], [75, 223388], [82, 223948], [86, 224208]]}, {"verse": 30, "start": 225274, "end": 230847, "text": "Entonces el ángel le dijo: María, no temas, porque has hallado gracia ante Dios.", "words": [[0, 225274], [9, 226134], [12, 226414], [18, 226834], [21, 226934], [27, 227713], [34, 228092], [37, 228152], [44, 228792], [51, 229012], [55, 229252], [63, 229592], [70, 229932], [75, 230392]]}, {"verse": 31, "start": 231297, "end": 236256, "text": "Y he aquí, concebirás en tu seno, y parirás un hijo, y llamarás su nombre JESÚS.", "words": [[0, 231297], [2, 231456], [5, 231556], [11, 231816], [22, 232536], [25, 232676], [28, 232816], [34, 233516], [36, 233556], [44, 234036], [47, 234196], [53, 234456], [55, 234776], [64, 235196], [67, 235336], [74, 235576]]}, {"verse": 32, "start": 236706, "end": 243064, "text": "Este será grande, y será llamado Hijo del Altísimo: y le dará el Señor Dios el trono de David su padre:", "words": [[0, 236706], [5, 236942], [10, 237202], [18, 237622], [20, 237882], [25, 238062], [33, 238462], [38, 238882], [42, 239042], [52, 240111], [54, 240236], [57, 240316], [62, 240576], [65, 240656], [71, 240936], [76, 241276], [79, 241596], [85, 241916], [88, 242016], [94, 242316], [97, 242576]]}, {"verse": 33, "start": 243414, "end": 248481, "text": "Y reinará en la casa de Jacob por siempre; y de su reino no habrá fin.", "words": [[0, 243414], [2, 243539], [10, 244199], [13, 244279], [16, 244399], [21, 244679], [24, 244899], [30, 245219], [34, 245559], [43, 246569], [45, 246675], [48, 246795], [51, 246935], [57, 247435], [60, 247615], [66, 247935]]}, {"verse": 34, "start": 248931, "end": 254234, "text": "Entonces María dijo al ángel: ¿Cómo será esto? porque no conozco varón.", "words": [[0, 248931], [9, 249295], [15, 250235], [20, 250575], [23, 250755], [30, 251526], [36, 251729], [41, 251989], [47, 252877], [54, 253041], [57, 253201], [65, 253641]]}, {"verse": 35, "start": 254584, "end": 266474, "text": "Y respondiendo el ángel le dijo: El Espíritu Santo vendrá sobre ti, y el poder del Altísimo te hará sombra; por lo cual también lo Santo que nacerá, será llamado Hijo de Dios.", "words": [[0, 254584], [2, 254791], [15, 255991], [18, 256191], [24, 256691], [27, 256811], [33, 257633], [36, 257752], [45, 258272], [51, 258552], [58, 259072], [64, 259292], [68, 259592], [70, 260172], [73, 260292], [79, 260532], [83, 260752], [92, 261312], [95, 261592], [100, 261812], [108, 262631], [112, 262736], [115, 262856], [120, 263056], [128, 263336], [131, 263616], [137, 263956], [141, 264116], [149, 264576], [154, 265056], [162, 265496], [167, 265816], [170, 265976]]}, {"verse": 36, "start": 266924, "end": 274542, "text": "Y he aquí, Elisabet tu parienta, también ella ha concebido hijo en su vejez; y este es el sexto mes a ella que es llamada la estéril:", "words": [[0, 266924], [2, 267065], [5, 267185], [11, 267485], [20, 267785], [23, 268025], [33, 268865], [41, 269125], [46, 269405], [49, 269565], [59, 270085], [64, 270325], [67, 270632], [70, 270938], [77, 271492], [79, 271658], [84, 271918], [87, 272098], [90, 272218], [96, 272598], [100, 272798], [102, 272938], [107, 273138], [111, 273338], [114, 273478], [122, 273838], [125, 273958]]}, {"verse": 37, "start": 274992, "end": 277503, "text": "Porque ninguna cosa es imposible para Dios.", "words": [[0, 274992], [7, 275176], [15, 275496], [20, 275916], [23, 276116], [33, 276716], [38, 276936]]}, {"verse": 38, "start": 277853, "end": 288669, "text": "Entonces María dijo: He aquí la sierva del Señor; hágase a mí conforme a tu palabra. Y el ángel partió de ella.", "words": [[0, 277853], [9, 278398], [15, 278938], [21, 279916], [24, 279976], [29, 280256], [32, 280456], [39, 280896], [43, 281036], [50, 281959], [57, 282385], [59, 282525], [62, 282645], [71, 283265], [73, 283305], [76, 283385], [85, 286804], [87, 286970], [90, 287110], [96, 287570], [103, 288030], [106, 288190]]}, {"verse": 39, "start": 289119, "end": 295505, "text": "En aquellos días levantándose María, fue a la montaña con prisa, a una ciudad de Judá;", "words": [[0, 289119], [3, 289409], [12, 289609], [17, 290489], [30, 291289], [37, 291629], [41, 291989], [43, 292129], [46, 292189], [54, 292729], [58, 292949], [65, 293529], [67, 293909], [71, 294069], [78, 294449], [81, 294709]]}, {"verse": 40, "start": 295955, "end": 300095, "text": "Y entró en casa de Zacarías, y saludó a Elisabet.", "words": [[0, 295955], [2, 296122], [8, 296542], [11, 296682], [16, 296962], [19, 297442], [29, 297922], [31, 298502], [38, 299182], [40, 299673]]}, {"verse": 41, "start": 300545, "end": 309897, "text": "Y aconteció, que como oyó Elisabet el saludo de María, la criatura saltó en su vientre; y Elisabet fue llena del Espíritu Santo,", "words": [[0, 300545], [2, 300650], [13, 301430], [17, 301750], [22, 301930], [26, 302360], [35, 302790], [38, 303130], [45, 303530], [48, 303690], [55, 304530], [58, 304630], [67, 305230], [73, 305790], [76, 305890], [79, 306050], [88, 307029], [90, 307176], [99, 307736], [103, 308176], [109, 308596], [113, 308736], [122, 309316]]}, {"verse": 42, "start": 310347, "end": 317342, "text": "Y exclamó a gran voz, y dijo: Bendita tú entre las mujeres, y bendito el fruto de tu vientre.", "words": [[0, 310347], [2, 310530], [10, 311230], [12, 311330], [17, 311490], [22, 311870], [24, 312170], [30, 312890], [38, 313520], [41, 313740], [47, 314000], [51, 314240], [60, 314680], [62, 315400], [70, 315960], [73, 316120], [79, 316440], [82, 316580], [85, 316720]]}, {"verse": 43, "start": 317792, "end": 322258, "text": "¿Y de dónde esto a mí, que la madre de mi Señor venga a mí?", "words": [[0, 317792], [3, 317900], [6, 318020], [12, 318240], [17, 318620], [19, 318820], [23, 319320], [27, 319420], [30, 319560], [36, 319900], [39, 320100], [42, 320220], [48, 320600], [54, 321120], [56, 321300]]}, {"verse": 44, "start": 322708, "end": 329002, "text": "Porque he aquí, cuando llegó la voz de tu saludo a mis oídos, la criatura saltó de alegría en mi vientre.", "words": [[0, 322708], [7, 322908], [10, 323188], [16, 323468], [23, 323688], [29, 324028], [32, 324268], [36, 324508], [39, 324648], [42, 324768], [49, 325228], [51, 325348], [55, 325488], [62, 326328], [65, 326468], [74, 327008], [80, 327508], [83, 327608], [91, 328128], [94, 328248], [97, 328368]]}, {"verse": 45, "start": 329452, "end": 335350, "text": "Y bienaventurada la que creyó, porque se cumplirán las cosas que le fueron dichas de parte del Señor.", "words": [[0, 329452], [2, 329532], [17, 330352], [20, 330492], [24, 330652], [31, 331352], [38, 331852], [41, 332012], [51, 332512], [55, 332692], [61, 333032], [65, 333272], [68, 333412], [75, 333672], [82, 334132], [85, 334252], [91, 334512], [95, 334792]]}, {"verse": 46, "start": 335700, "end": 339806, "text": "Entonces María dijo: engrandece mi alma al Señor;", "words": [[0, 335700], [9, 336245], [15, 336785], [21, 337703], [32, 338484], [35, 338684], [40, 338964], [43, 339284]]}, {"verse": 47, "start": 340256, "end": 342970, "text": "Y mi espíritu se alegró en Dios mi Salvador.", "words": [[0, 340256], [2, 340365], [5, 340465], [14, 341145], [17, 341245], [24, 341685], [27, 341825], [32, 342245], [35, 342325]]}, {"verse": 48, "start": 343420, "end": 351169, "text": "Porque ha mirado a la condición humilde de su sierva; porque he aquí, desde ahora me dirán bienaventurada todas las generaciones.", "words": [[0, 343420], [7, 343598], [10, 343798], [17, 344258], [19, 344358], [22, 344418], [32, 345018], [40, 345538], [43, 345678], [46, 345818], [54, 346760], [61, 346960], [64, 347240], [70, 347540], [76, 347760], [82, 348205], [85, 348650], [91, 349095], [106, 349540], [112, 349780], [116, 350080]]}, {"verse": 49, "start": 351619, "end": 356920, "text": "Porque me ha hecho grandes cosas el Poderoso; y santo es su nombre.", "words": [[0, 351619], [7, 351767], [10, 351967], [13, 352067], [19, 352247], [27, 352547], [33, 352967], [36, 353227], [46, 354309], [48, 354419], [54, 354819], [57, 355119], [60, 355239]]}, {"verse": 50, "start": 357370, "end": 361700, "text": "Y su misericordia de generación a generación a los que le temen.", "words": [[0, 357370], [2, 357459], [5, 357599], [18, 358439], [21, 358539], [32, 359559], [34, 359739], [45, 360459], [47, 360739], [51, 360879], [55, 361019], [58, 361159]]}, {"verse": 51, "start": 362150, "end": 367431, "text": "Mostró poder con su brazo: esparció los soberbios del pensamiento de su corazón.", "words": [[0, 362150], [7, 362554], [13, 362814], [17, 363074], [20, 363254], [27, 364124], [36, 364711], [40, 364911], [50, 365511], [54, 365671], [66, 366371], [69, 366531], [72, 366671]]}, {"verse": 52, "start": 367881, "end": 371486, "text": "Quitó los poderosos de los tronos, y levantó a los humildes.", "words": [[0, 367881], [6, 368163], [10, 368303], [20, 368883], [23, 369043], [27, 369163], [35, 369703], [37, 370043], [45, 370543], [47, 370623], [51, 370743]]}, {"verse": 53, "start": 371936, "end": 375936, "text": "A los hambrientos llenó de bienes; y a los ricos envió vacíos.", "words": [[0, 371936], [2, 372061], [6, 372441], [18, 372821], [24, 373081], [27, 373201], [35, 374089], [37, 374213], [39, 374273], [43, 374433], [49, 374813], [55, 375233]]}, {"verse": 54, "start": 376386, "end": 381561, "text": "Recibió a Israel su siervo, acordándose de la misericordia,", "words": [[0, 376386], [8, 376987], [10, 377067], [17, 377487], [20, 377687], [28, 378207], [40, 379207], [43, 379327], [46, 379427]]}, {"verse": 55, "start": 382011, "end": 386636, "text": "Como habló a nuestros padres a Abraham y a su descendencia para siempre.", "words": [[0, 382011], [5, 382171], [11, 382551], [13, 382631], [22, 382831], [29, 383451], [31, 383831], [39, 384291], [41, 384731], [43, 384811], [46, 384891], [59, 385711], [64, 385911]]}, {"verse": 56, "start": 386986, "end": 391440, "text": "Y se quedó María con ella como tres meses: después se volvió a su casa.", "words": [[0, 386986], [2, 387107], [5, 387187], [11, 387507], [17, 387767], [21, 388067], [26, 388247], [31, 388527], [36, 388827], [43, 389867], [51, 390131], [54, 390331], [61, 390711], [63, 390771], [66, 390871]]}, {"verse": 57, "start": 391890, "end": 396313, "text": "Y a Elisabet se le cumplió el tiempo de parir, y parió un hijo.", "words": [[0, 391890], [2, 392037], [4, 392337], [13, 392637], [16, 393097], [19, 393237], [27, 393657], [30, 393757], [37, 394037], [40, 394237], [47, 394677], [49, 395077], [55, 395517], [58, 395837]]}, {"verse": 58, "start": 396763, "end": 403973, "text": "Y oyeron los vecinos y los parientes que Dios había hecho con ella grande misericordia, y se alegraron con ella.", "words": [[0, 396763], [2, 396904], [9, 397324], [13, 397464], [21, 397984], [23, 398164], [27, 398264], [37, 398744], [41, 399024], [46, 399264], [52, 399664], [58, 400044], [62, 400304], [67, 400484], [74, 400864], [88, 401884], [90, 402504], [93, 402664], [103, 403224], [107, 403484]]}, {"verse": 59, "start": 404423, "end": 413048, "text": "Y aconteció, que al octavo día vinieron para circuncidar al niño; y le llamaban del nombre de su padre, Zacarías.", "words": [[0, 404423], [2, 404895], [13, 405395], [17, 405595], [20, 405775], [27, 406215], [31, 406515], [40, 407155], [45, 407515], [57, 408535], [60, 408775], [66, 409738], [68, 409855], [71, 410005], [80, 410505], [84, 410725], [91, 411045], [94, 411265], [97, 411405], [104, 412262]]}, {"verse": 60, "start": 413498, "end": 418468, "text": "Y respondiendo su madre, dijo: No; sino Juan será llamado.", "words": [[0, 413498], [2, 413642], [15, 414482], [18, 414702], [25, 415342], [31, 416152], [35, 416873], [40, 417135], [45, 417475], [50, 417775]]}, {"verse": 61, "start": 418818, "end": 423440, "text": "Y le dijeron: ¿Por qué? nadie hay en tu parentela que se llame de este nombre.", "words": [[0, 418818], [2, 418965], [5, 419045], [14, 420058], [19, 420199], [24, 420828], [30, 421233], [34, 421373], [37, 421493], [40, 421613], [50, 422093], [54, 422253], [57, 422423], [63, 422593], [66, 422793], [71, 422953]]}, {"verse": 62, "start": 423790, "end": 427564, "text": "Y hablaron por señas a su padre, cómo le quería llamar.", "words": [[0, 423790], [2, 423898], [11, 424318], [15, 424478], [21, 424998], [23, 425098], [26, 425218], [33, 425598], [38, 426378], [41, 426708], [48, 427038]]}, {"verse": 63, "start": 428014, "end": 435324, "text": "Y pidiendo la tablilla, escribió, diciendo: Juan es su nombre. Y todos se maravillaron.", "words": [[0, 428014], [2, 428319], [11, 428799], [14, 429159], [24, 429519], [34, 430639], [44, 431814], [49, 432100], [52, 432520], [55, 432680], [63, 433474], [65, 433596], [71, 433896], [74, 434336]]}, {"verse": 64, "start": 435774, "end": 440892, "text": "Y luego fue abierta su boca y su lengua, y habló bendiciendo a Dios.", "words": [[0, 435774], [2, 435916], [8, 436116], [12, 436476], [20, 437036], [23, 437216], [28, 437576], [30, 437716], [33, 437896], [41, 438876], [43, 439156], [49, 439476], [61, 440156], [63, 440316]]}, {"verse": 65, "start": 441342, "end": 449254, "text": "Y fue un temor sobre todos los vecinos de ellos; y en todas las montañas de Judea fueron divulgadas todas estas cosas.", "words": [[0, 441342], [2, 441502], [6, 441662], [9, 441822], [15, 442162], [21, 442422], [27, 442782], [31, 443062], [39, 443502], [42, 443662], [49, 444534], [51, 444679], [54, 444839], [60, 445099], [64, 445399], [73, 446079], [76, 446179], [82, 446719], [89, 446939], [100, 447759], [106, 448079], [112, 448479]]}, {"verse": 66, "start": 449704, "end": 459085, "text": "Y todos los que las oían, las conservaban en su corazón, diciendo: ¿Quién será este niño? Y la mano del Señor estaba con él.", "words": [[0, 449704], [2, 449982], [8, 450242], [12, 450442], [16, 450642], [20, 450822], [26, 451542], [30, 451942], [42, 452802], [45, 452982], [48, 453162], [57, 453702], [67, 455326], [74, 455584], [79, 455744], [84, 456024], [90, 456856], [92, 456975], [95, 457095], [100, 457335], [104, 457555], [110, 457875], [117, 458315], [121, 458655]]}, {"verse": 67, "start": 459535, "end": 465242, "text": "Y Zacarías su padre fue lleno de Espíritu Santo, y profetizó, diciendo:", "words": [[0, 459535], [2, 459887], [11, 460267], [14, 460507], [20, 461027], [24, 461167], [30, 461547], [33, 461647], [42, 462247], [49, 463287], [51, 463367], [62, 464207]]}, {"verse": 68, "start": 465492, "end": 469875, "text": "Bendito el Señor Dios de Israel, que ha visitado y hecho redención a su pueblo,", "words": [[0, 465492], [8, 465938], [11, 466098], [17, 466358], [22, 466698], [25, 466918], [33, 467238], [37, 467498], [40, 467598], [49, 468238], [51, 468398], [57, 468618], [67, 469098], [69, 469238], [72, 469338]]}, {"verse": 69, "start": 470325, "end": 474579, "text": "Y nos levantó un cuerno de salvación en la casa de David su siervo,", "words": [[0, 470325], [2, 470411], [6, 470491], [14, 470991], [17, 471091], [24, 471511], [27, 471591], [37, 472191], [40, 472351], [43, 472451], [48, 472711], [51, 472871], [57, 473291], [60, 473371]]}, {"verse": 70, "start": 475029, "end": 478878, "text": "Como habló por boca de sus santos profetas que fueron desde el principio:", "words": [[0, 475029], [5, 475239], [11, 475489], [15, 475669], [20, 475969], [23, 476129], [27, 476269], [34, 476729], [43, 477229], [47, 477429], [54, 477689], [60, 477969], [63, 478169]]}, {"verse": 71, "start": 479328, "end": 483394, "text": "Salvación de nuestros enemigos, y de mano de todos los que nos aborrecieron;", "words": [[0, 479328], [10, 479896], [13, 480056], [22, 480276], [32, 481036], [34, 481276], [37, 481396], [42, 481596], [45, 481776], [51, 481996], [55, 482256], [59, 482416], [63, 482556]]}, {"verse": 72, "start": 483844, "end": 488680, "text": "Para hacer misericordia con nuestros padres, y acordándose de su santo pacto;", "words": [[0, 483844], [5, 484023], [11, 484283], [24, 485163], [28, 485363], [37, 485563], [45, 486143], [47, 486763], [59, 487503], [62, 487623], [65, 487783], [71, 488083]]}, {"verse": 73, "start": 489130, "end": 493203, "text": "Del juramento que juró a Abraham nuestro padre, que nos había de dar,", "words": [[0, 489130], [4, 489273], [14, 489793], [18, 490103], [23, 490413], [25, 490533], [33, 491033], [41, 491253], [48, 491933], [52, 492113], [56, 492253], [62, 492573], [65, 492753]]}, {"verse": 74, "start": 493653, "end": 497205, "text": "Que sin temor librados de nuestros enemigos, le serviríamos", "words": [[0, 493653], [4, 493737], [8, 493917], [14, 494277], [23, 494717], [26, 494857], [35, 495037], [45, 495957], [48, 496197]]}, {"verse": 75, "start": 497655, "end": 501777, "text": "En santidad y en justicia delante de él, todos los días nuestros.", "words": [[0, 497655], [3, 497777], [12, 498377], [14, 498517], [17, 498617], [26, 499177], [34, 499577], [37, 499757], [41, 499977], [47, 500417], [51, 500717], [56, 500957]]}, {"verse": 76, "start": 502227, "end": 508774, "text": "Y tú, niño, profeta del Altísimo serás llamado; porque irás ante la faz del Señor, para preparar sus caminos;", "words": [[0, 502227], [2, 502352], [6, 502492], [12, 503112], [20, 503592], [24, 503752], [33, 504352], [39, 504592], [48, 505442], [55, 505601], [60, 505851], [65, 506101], [68, 506261], [72, 506481], [76, 506641], [83, 507021], [88, 507501], [97, 507961], [101, 508061]]}, {"verse": 77, "start": 509224, "end": 513360, "text": "Dando conocimiento de salvación a su pueblo, para perdón de sus pecados,", "words": [[0, 509351], [6, 509481], [19, 510201], [22, 510341], [32, 510881], [34, 511001], [37, 511101], [45, 511521], [50, 511861], [57, 512321], [60, 512441], [64, 512641]]}, {"verse": 78, "start": 513810, "end": 519041, "text": "Por la profunda misericordia de nuestro Dios, el Sol naciente nos visitó desde lo alto,", "words": [[0, 513810], [4, 513917], [7, 514057], [16, 514537], [29, 515297], [32, 515397], [40, 515557], [46, 516517], [49, 516577], [53, 516817], [62, 517357], [66, 517577], [73, 518157], [79, 518297], [82, 518557]]}, {"verse": 79, "start": 519491, "end": 525605, "text": "Para dar luz a los que habitan en tinieblas y en sombra de muerte; para encaminar nuestros pies por camino de paz.", "words": [[0, 519491], [5, 519651], [9, 519791], [13, 519991], [15, 520131], [19, 520251], [23, 520391], [31, 520771], [34, 520911], [44, 521511], [46, 521711], [49, 521851], [56, 522191], [59, 522271], [67, 523117], [72, 523275], [82, 523795], [91, 524015], [96, 524395], [100, 524715], [107, 524975], [110, 525175]]}, {"verse": 80, "start": 525955, "end": 533972, "text": "Y el niño crecía, y se fortalecía en espíritu: y estuvo en los desiertos hasta el día que se mostró a Israel.", "words": [[0, 525955], [2, 526114], [5, 526274], [10, 526594], [18, 527334], [20, 527974], [23, 528134], [34, 528954], [37, 529094], [47, 530092], [49, 530354], [56, 530694], [59, 530834], [63, 530934], [73, 531614], [79, 531854], [82, 532014], [86, 532234], [90, 532394], [93, 532534], [100, 533034], [102, 533154]]}]}