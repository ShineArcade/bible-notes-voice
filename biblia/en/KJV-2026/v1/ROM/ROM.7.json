{"book": "ROM", "chapter": 7, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 168162, "verses": [{"verse": 1, "start": 300, "end": 7320, "text": "Do you not know, brethren, (for I speak to them that know the law,) how that the law has dominion over a man as long as he lives?", "words": [[0, 300], [3, 396], [7, 516], [11, 716], [17, 1016], [27, 1756], [32, 1856], [34, 2016], [40, 2276], [43, 2516], [48, 2716], [53, 2976], [58, 3176], [62, 3316], [68, 3816], [72, 3956], [77, 4136], [81, 4276], [85, 4536], [89, 4776], [98, 5356], [103, 5576], [105, 5796], [109, 5976], [112, 6236], [117, 6456], [120, 6656], [123, 6796]]}, {"verse": 2, "start": 7770, "end": 15417, "text": "For the woman which has a husband is bound by the law to her husband so long as he lives; but if the husband be dead, she is loosed from the law of her husband.", "words": [[0, 7770], [4, 7878], [8, 7958], [14, 8178], [20, 8398], [24, 8598], [26, 8678], [34, 8918], [37, 9138], [43, 9378], [46, 9558], [50, 9678], [54, 9858], [57, 10018], [61, 10158], [69, 10458], [72, 10738], [77, 10898], [80, 11038], [83, 11373], [90, 11953], [94, 12091], [97, 12231], [101, 12351], [109, 12631], [112, 12871], [118, 13511], [122, 13631], [125, 13821], [132, 14011], [137, 14271], [141, 14391], [145, 14591], [148, 14731], [152, 14851]]}, {"verse": 3, "start": 15867, "end": 28188, "text": "So then if, while her husband lives, she be married to another man, she shall be called an adulteress: but if her husband be dead, she is free from that law; so that she is no adulteress, though she be married to another man.", "words": [[0, 15867], [3, 15990], [8, 16170], [12, 16350], [18, 16530], [22, 16730], [30, 17050], [37, 17650], [41, 17750], [44, 17890], [52, 18210], [55, 18410], [63, 18650], [68, 19270], [72, 19370], [78, 19550], [81, 19690], [88, 19990], [91, 20210], [103, 21350], [107, 21483], [110, 21603], [114, 21743], [122, 22023], [125, 22283], [131, 22903], [135, 23043], [138, 23183], [143, 23463], [148, 23743], [153, 23963], [158, 24605], [161, 24746], [166, 24926], [170, 25126], [173, 25266], [176, 25446], [188, 26406], [195, 26566], [199, 26726], [202, 26866], [210, 27226], [213, 27446], [221, 27706]]}, {"verse": 4, "start": 28638, "end": 39392, "text": "Therefore, my brethren, you also are become dead to the law by the body of Christ; that you should be married to another, even to him who is raised from the dead, that we should bring forth fruit to God.", "words": [[0, 28638], [11, 29118], [14, 29218], [24, 29998], [28, 30078], [33, 30438], [37, 30618], [44, 30858], [49, 31178], [52, 31398], [56, 31518], [60, 31718], [63, 31878], [67, 32018], [72, 32298], [75, 32438], [83, 33298], [88, 33462], [92, 33582], [99, 33742], [102, 33882], [110, 34182], [113, 34382], [122, 35062], [127, 35322], [130, 35562], [134, 35762], [138, 35942], [141, 36062], [148, 36322], [153, 36582], [157, 36722], [163, 37282], [168, 37462], [171, 37642], [178, 37802], [184, 38022], [190, 38382], [196, 38722], [199, 38962]]}, {"verse": 5, "start": 39842, "end": 46252, "text": "For when we were in the flesh, the motions of sins, which were by the law, did work in our members to bring forth fruit to death.", "words": [[0, 39842], [4, 39967], [9, 40167], [12, 40307], [17, 40467], [20, 40587], [24, 40687], [31, 41367], [35, 41447], [43, 41787], [46, 42027], [52, 42327], [58, 42727], [63, 42887], [66, 43067], [70, 43227], [75, 43487], [79, 43847], [84, 44147], [87, 44307], [91, 44427], [99, 44727], [102, 45007], [108, 45227], [114, 45487], [120, 45787], [123, 45967]]}, {"verse": 6, "start": 46702, "end": 54271, "text": "But now we are delivered from the law, that being dead in which we were held; that we should serve in newness of spirit, and not in the oldness of the letter.", "words": [[0, 46702], [4, 46805], [8, 47025], [11, 47205], [15, 47305], [25, 47645], [30, 47925], [34, 48085], [39, 48345], [44, 48765], [50, 48985], [55, 49285], [58, 49545], [64, 49685], [67, 49865], [72, 50005], [78, 50748], [83, 50875], [86, 51035], [93, 51195], [99, 51535], [102, 51655], [110, 52015], [113, 52155], [121, 52495], [125, 52735], [129, 52975], [132, 53175], [136, 53275], [144, 53695], [147, 53855], [151, 53955]]}, {"verse": 7, "start": 54721, "end": 65661, "text": "What shall we say then? Is the law sin? God forbid. No, I had not known sin, but by the law: for I had not known lust, except the law had said, You shall not covet.", "words": [[0, 54804], [5, 54918], [11, 55031], [14, 55131], [18, 55311], [24, 56074], [27, 56216], [31, 56406], [35, 56596], [40, 57366], [44, 57603], [52, 58520], [56, 58800], [58, 58880], [62, 59020], [66, 59200], [72, 59460], [77, 60100], [81, 60200], [84, 60380], [88, 60500], [93, 61222], [97, 61346], [99, 61486], [103, 61726], [107, 61906], [113, 62206], [119, 62866], [126, 63166], [130, 63426], [134, 63646], [138, 63846], [144, 64446], [148, 64666], [154, 64906], [158, 65126]]}, {"verse": 8, "start": 66111, "end": 73117, "text": "But sin, taking occasion by the commandment, wrought in me all manner of evil desire. For without the law sin was dead.", "words": [[0, 66111], [4, 66291], [9, 66591], [16, 66971], [25, 67451], [28, 67731], [32, 67851], [45, 68231], [53, 68611], [56, 68991], [59, 69291], [63, 69611], [70, 69891], [73, 70131], [78, 70411], [86, 71333], [90, 71480], [98, 71780], [102, 71980], [106, 72210], [110, 72440], [114, 72680]]}, {"verse": 9, "start": 73567, "end": 79103, "text": "For I was alive without the law once: but when the commandment came, sin revived, and I died.", "words": [[0, 73567], [4, 73689], [6, 73809], [10, 73989], [16, 74409], [24, 74729], [28, 74969], [32, 75149], [38, 76062], [42, 76185], [47, 76385], [51, 76505], [63, 76985], [69, 77315], [73, 77645], [82, 78105], [86, 78505], [88, 78665]]}, {"verse": 10, "start": 79553, "end": 83164, "text": "And the commandment, which was ordained to life, I found to be to death.", "words": [[0, 79553], [4, 79700], [8, 79800], [21, 80280], [27, 80480], [31, 80680], [40, 81120], [43, 81260], [49, 81900], [51, 82060], [57, 82340], [60, 82540], [63, 82660], [66, 82820]]}, {"verse": 11, "start": 83614, "end": 87723, "text": "For sin, taking occasion by the commandment, deceived me, and by it killed me.", "words": [[0, 83614], [4, 83722], [9, 84022], [16, 84302], [25, 84782], [28, 85062], [32, 85182], [45, 85612], [54, 86042], [58, 86362], [62, 86782], [65, 87002], [68, 87162], [75, 87382]]}, {"verse": 12, "start": 88173, "end": 92387, "text": "Therefore the law is holy, and the commandment holy, and just, and good.", "words": [[0, 88173], [10, 88507], [14, 88747], [18, 89007], [21, 89207], [27, 89567], [31, 90147], [35, 90267], [47, 90767], [53, 91107], [57, 91427], [63, 91707], [67, 92047]]}, {"verse": 13, "start": 92837, "end": 103006, "text": "Was then that which is good made death to me? God forbid. But sin, that it might appear sin, working death in me by that which is good; that sin by the commandment might become exceeding sinful.", "words": [[0, 92837], [4, 92962], [9, 93182], [14, 93382], [20, 93642], [23, 93762], [28, 93982], [33, 94182], [39, 94422], [42, 94582], [46, 95155], [50, 95393], [58, 96243], [62, 96342], [67, 96622], [72, 96802], [75, 96942], [81, 97102], [88, 97362], [93, 97962], [101, 98262], [107, 98622], [110, 98802], [113, 98922], [116, 99102], [121, 99282], [127, 99462], [130, 99602], [136, 100264], [141, 100388], [145, 100668], [148, 100848], [152, 100968], [164, 101448], [170, 101608], [177, 101908], [187, 102468]]}, {"verse": 14, "start": 103456, "end": 107164, "text": "For we know that the law is spiritual: but I am carnal, sold under sin.", "words": [[0, 103475], [4, 103535], [7, 103655], [12, 103855], [17, 104035], [21, 104155], [25, 104355], [28, 104555], [39, 105439], [43, 105517], [45, 105657], [48, 105757], [56, 106077], [61, 106397], [67, 106677]]}, {"verse": 15, "start": 107614, "end": 113117, "text": "For that which I do I allow not: for what I would, that do I not; but what I hate, that do I.", "words": [[0, 107614], [4, 107701], [9, 107901], [15, 108101], [17, 108241], [20, 108361], [22, 108521], [28, 108761], [33, 109540], [37, 109620], [42, 109760], [44, 109860], [51, 110540], [56, 110640], [59, 110860], [61, 111000], [66, 111710], [70, 111806], [75, 111906], [77, 112046], [83, 112446], [88, 112646], [91, 112846]]}, {"verse": 16, "start": 113567, "end": 117305, "text": "If then I do that which I would not, I consent to the law that it is good.", "words": [[0, 113567], [3, 113689], [8, 113889], [10, 114009], [13, 114169], [18, 114329], [24, 114509], [26, 114629], [32, 114749], [37, 115409], [39, 115549], [47, 115909], [50, 116129], [54, 116249], [58, 116489], [63, 116649], [66, 116769], [69, 116889]]}, {"verse": 17, "start": 117755, "end": 120930, "text": "Now then it is no more I that do it, but sin that dwells in me.", "words": [[0, 117755], [4, 117917], [9, 118137], [12, 118237], [15, 118377], [18, 118537], [23, 118717], [25, 118857], [30, 118997], [33, 119217], [37, 119637], [41, 119757], [45, 119997], [50, 120197], [57, 120537], [60, 120637]]}, {"verse": 18, "start": 121380, "end": 129914, "text": "For I know that in me (that is, in my flesh,) dwells no good thing: for to will is present with me; but how to perform that which is good I find not.", "words": [[0, 121380], [4, 121490], [6, 121570], [11, 121730], [16, 121910], [19, 122050], [22, 122490], [28, 122670], [32, 122850], [35, 122990], [38, 123130], [46, 123790], [53, 124250], [56, 124390], [61, 124590], [68, 125286], [72, 125394], [75, 125514], [80, 125714], [83, 125854], [91, 126154], [96, 126374], [100, 127045], [104, 127142], [108, 127302], [111, 127442], [119, 127782], [124, 128362], [130, 128542], [133, 128682], [138, 129142], [140, 129222], [145, 129462]]}, {"verse": 19, "start": 130364, "end": 134730, "text": "For the good that I would I do not: but the evil which I would not, that I do.", "words": [[0, 130364], [4, 130490], [8, 130650], [13, 130830], [18, 130990], [20, 131150], [26, 131330], [28, 131531], [31, 131770], [36, 132644], [40, 132784], [44, 132944], [49, 133224], [55, 133484], [57, 133624], [63, 133784], [68, 134024], [73, 134224], [75, 134344]]}, {"verse": 20, "start": 135180, "end": 140147, "text": "Now if I do that I would not, it is no more I that do it, but sin that dwells in me.", "words": [[0, 135180], [4, 135300], [7, 135460], [9, 135580], [12, 135760], [17, 135920], [19, 136040], [25, 136180], [30, 136760], [33, 136860], [36, 137020], [39, 137280], [44, 137500], [46, 137760], [51, 137920], [54, 138180], [58, 138580], [62, 138720], [66, 139080], [71, 139320], [78, 139760], [81, 139880]]}, {"verse": 21, "start": 140597, "end": 144691, "text": "I find then a law, that, when I would do good, evil is present with me.", "words": [[0, 140597], [2, 140742], [7, 140982], [12, 141222], [14, 141322], [19, 141602], [25, 142062], [30, 142242], [32, 142422], [38, 142562], [41, 142762], [47, 143242], [52, 143562], [55, 143802], [63, 144142], [68, 144362]]}, {"verse": 22, "start": 145141, "end": 147874, "text": "For I delight in the law of God after the inward man:", "words": [[0, 145141], [4, 145249], [6, 145369], [14, 145669], [17, 145889], [21, 145989], [25, 146169], [28, 146309], [32, 146569], [38, 146889], [42, 147069], [49, 147309]]}, {"verse": 23, "start": 148324, "end": 155812, "text": "But I see another law in my members, warring against the law of my mind, and bringing me into captivity to the law of sin which is in my members.", "words": [[0, 148324], [4, 148424], [6, 148544], [10, 148744], [18, 149044], [22, 149364], [25, 149504], [28, 149624], [37, 149964], [45, 150684], [53, 150944], [57, 151144], [61, 151304], [64, 151404], [67, 151524], [73, 151884], [77, 152324], [86, 152644], [89, 152884], [94, 153024], [104, 153444], [107, 153764], [111, 153884], [115, 154064], [118, 154184], [122, 154644], [128, 154764], [131, 154924], [134, 155044], [137, 155184]]}, {"verse": 24, "start": 156262, "end": 160137, "text": "O wretched man that I am! who shall deliver me from the body of this death?", "words": [[0, 156321], [2, 156411], [11, 156691], [15, 156951], [20, 157131], [22, 157311], [26, 157891], [30, 158017], [36, 158257], [44, 158597], [47, 158817], [52, 159017], [56, 159137], [61, 159417], [64, 159557], [69, 159737]]}, {"verse": 25, "start": 160587, "end": 167762, "text": "I thank God through Jesus Christ our Lord. So then with the mind I myself serve the law of God; but with the flesh the law of sin.", "words": [[0, 160587], [2, 160749], [8, 160929], [12, 161209], [20, 161449], [26, 161729], [33, 162089], [37, 162349], [43, 163055], [46, 163171], [51, 163371], [56, 163551], [60, 163651], [65, 163861], [67, 164071], [74, 164421], [80, 164771], [84, 164931], [88, 165171], [91, 165311], [96, 166024], [100, 166122], [105, 166262], [109, 166362], [115, 166862], [119, 166942], [123, 167162], [126, 167242]]}]}