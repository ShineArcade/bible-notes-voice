{"book": "JHN", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 410475, "verses": [{"verse": 1, "start": 300, "end": 7627, "text": "Estaba entonces enfermo uno llamado Lázaro, de Betania, la aldea de María y de Marta su hermana.", "words": [[0, 300], [7, 684], [16, 1184], [24, 1984], [28, 2304], [36, 2664], [44, 3344], [47, 3824], [56, 4789], [59, 4869], [65, 5389], [68, 5549], [74, 5849], [76, 6209], [79, 6329], [85, 6769], [88, 6969]]}, {"verse": 2, "start": 7977, "end": 16911, "text": "(Y María, cuyo hermano Lázaro estaba enfermo, era la que ungió al Señor con perfume, y limpió sus pies con sus cabellos.)", "words": [[0, 7977], [3, 8103], [10, 8503], [15, 8983], [23, 9423], [30, 9923], [37, 10223], [46, 11423], [50, 11843], [53, 12043], [57, 12423], [63, 12803], [66, 13083], [72, 13463], [76, 13823], [85, 14443], [87, 14723], [94, 15243], [98, 15443], [103, 15663], [107, 15943], [111, 16083]]}, {"verse": 3, "start": 17261, "end": 23652, "text": "Enviaron, pues, sus hermanas a él, diciendo: Señor, he aquí, el que amas está enfermo.", "words": [[0, 17261], [10, 17789], [16, 18429], [20, 18549], [29, 19049], [31, 19249], [35, 19449], [45, 20505], [52, 21365], [55, 21485], [61, 21865], [64, 22245], [68, 22425], [73, 22765], [78, 22985]]}, {"verse": 4, "start": 23932, "end": 34314, "text": "Y oyéndolo Jesús, dijo: Esta enfermedad no es para muerte, sino para la gloria de Dios, para que el Hijo de Dios sea glorificado por ella.", "words": [[0, 23932], [2, 24276], [11, 24656], [18, 24896], [24, 25856], [29, 26083], [40, 26803], [43, 26943], [46, 27063], [51, 27263], [59, 28343], [64, 28723], [69, 29043], [72, 29203], [79, 29623], [82, 29783], [88, 30723], [93, 31043], [97, 31263], [100, 31543], [105, 31843], [108, 32003], [113, 32303], [117, 32703], [129, 33563], [133, 33803]]}, {"verse": 5, "start": 34664, "end": 39050, "text": "Y amaba Jesús a Marta, y a su hermana, y a Lázaro.", "words": [[0, 34664], [2, 34771], [8, 35211], [14, 35431], [16, 35711], [23, 36551], [25, 36931], [27, 36991], [30, 37151], [39, 38171], [41, 38484], [43, 38796]]}, {"verse": 6, "start": 39400, "end": 44626, "text": "Cuando oyó pues que estaba enfermo, se quedó aún dos días en aquel lugar donde estaba.", "words": [[0, 39400], [7, 39693], [11, 40023], [16, 40283], [20, 40463], [27, 40703], [36, 41363], [39, 41523], [45, 41843], [49, 42163], [53, 42383], [58, 42703], [61, 42983], [67, 43323], [73, 43583], [79, 43883]]}, {"verse": 7, "start": 44976, "end": 49780, "text": "Luego, después de esto, dijo a los discípulos: Vamos a Judea otra vez.", "words": [[0, 44976], [7, 45431], [15, 45631], [18, 45911], [24, 46451], [29, 46751], [31, 46911], [35, 47011], [47, 48069], [53, 48315], [55, 48475], [61, 48955], [66, 49215]]}, {"verse": 8, "start": 50130, "end": 56014, "text": "Le dicen los discípulos: Rabí, ahora procuraban los judíos apedrearte, ¿y otra vez vas allá?", "words": [[0, 50130], [3, 50350], [9, 50670], [13, 50930], [25, 52156], [31, 52326], [37, 52506], [48, 53126], [52, 53306], [59, 53896], [71, 54486], [74, 54846], [79, 55026], [83, 55366], [87, 55566]]}, {"verse": 9, "start": 56294, "end": 63648, "text": "Respondió Jesús: ¿No tiene el día doce horas? El que anda de día, no tropieza, porque ve la luz de este mundo.", "words": [[0, 56294], [10, 56783], [17, 57680], [21, 57784], [27, 58024], [30, 58224], [34, 58424], [39, 58624], [46, 59527], [49, 59679], [53, 59819], [58, 59979], [61, 60179], [66, 60459], [69, 60839], [79, 61459], [86, 61959], [89, 62159], [92, 62299], [96, 62559], [99, 62779], [104, 62959]]}, {"verse": 10, "start": 63998, "end": 68839, "text": "Pero el que anda de noche, tropieza, porque no hay luz en él.", "words": [[0, 63998], [5, 64144], [8, 64324], [12, 64484], [17, 64724], [20, 64904], [27, 65404], [37, 66584], [44, 67004], [47, 67244], [51, 67564], [55, 67884], [58, 68424]]}, {"verse": 11, "start": 69189, "end": 75233, "text": "Dicho esto, les dice después: Lázaro nuestro amigo duerme; pero voy a despertarle del sueño.", "words": [[0, 69189], [6, 69428], [12, 69668], [16, 69868], [21, 70128], [30, 71078], [37, 71630], [45, 71850], [51, 72210], [59, 73086], [64, 73250], [68, 73470], [70, 73570], [82, 74410], [86, 74550]]}, {"verse": 12, "start": 75583, "end": 80050, "text": "Dijeron entonces sus discípulos: Señor, si duerme, se recuperará.", "words": [[0, 75583], [8, 76128], [17, 76628], [21, 76988], [33, 78181], [40, 78661], [43, 78701], [51, 79041], [54, 79241]]}, {"verse": 13, "start": 80330, "end": 86746, "text": "Pero esto decía Jesús de la muerte de él: y ellos pensaron que hablaba del reposar del sueño.", "words": [[0, 80330], [5, 80473], [10, 80753], [16, 81173], [22, 81633], [25, 82093], [28, 82213], [35, 82513], [38, 82911], [42, 83456], [44, 83756], [50, 83996], [59, 84696], [63, 84896], [71, 85276], [75, 85456], [83, 86036], [87, 86176]]}, {"verse": 14, "start": 87096, "end": 92321, "text": "Entonces, pues, Jesús les dijo claramente: Lázaro ha muerto;", "words": [[0, 87096], [10, 87972], [16, 88492], [22, 88892], [26, 89292], [31, 89632], [43, 90747], [50, 91294], [53, 91694]]}, {"verse": 15, "start": 92671, "end": 98700, "text": "Y me alegro por vosotros, que yo no haya estado allí, para que creáis: pero vamos a él.", "words": [[0, 92671], [2, 92813], [5, 92933], [12, 93373], [16, 93613], [26, 94273], [30, 94548], [33, 94708], [36, 94888], [41, 95148], [48, 95468], [54, 95888], [59, 96448], [63, 96648], [71, 97702], [76, 97828], [82, 98088], [84, 98328]]}, {"verse": 16, "start": 99050, "end": 108003, "text": "Dijo entonces Tomás, el que se dice el Dídimo, a sus condiscípulos: Vamos también nosotros, para que muramos con él.", "words": [[0, 99050], [5, 99386], [14, 99906], [21, 100786], [24, 101026], [28, 101186], [31, 101346], [36, 101706], [39, 102106], [47, 102766], [49, 103226], [53, 103931], [68, 104836], [74, 105054], [82, 105374], [92, 105754], [97, 106114], [101, 106254], [109, 106634], [113, 106874]]}, {"verse": 17, "start": 108283, "end": 113720, "text": "Vino pues Jesús, y halló que había ya cuatro días que estaba en el sepulcro.", "words": [[0, 108283], [5, 108549], [10, 108809], [17, 109809], [19, 110109], [25, 110509], [29, 110729], [35, 110949], [38, 111169], [45, 111549], [50, 112029], [54, 112229], [61, 112509], [64, 112689], [67, 112829]]}, {"verse": 18, "start": 114070, "end": 118469, "text": "Y Betania estaba cerca de Jerusalén, como quince estadios;", "words": [[0, 114070], [2, 114296], [10, 114836], [17, 115256], [23, 115636], [26, 115896], [37, 116616], [42, 117036], [49, 117456]]}, {"verse": 19, "start": 118819, "end": 124256, "text": "Y muchos de los judíos habían venido a Marta y a María, a consolarlas de su hermano.", "words": [[0, 118819], [2, 118940], [9, 119240], [12, 119420], [16, 119540], [23, 119980], [30, 120180], [37, 120680], [39, 120800], [45, 121280], [47, 121620], [49, 121700], [56, 122500], [58, 122580], [70, 123380], [73, 123520], [76, 123640]]}, {"verse": 20, "start": 124606, "end": 131967, "text": "Entonces Marta, cuando oyó que Jesús venía, salió a encontrarle; pero María se estuvo en casa.", "words": [[0, 124606], [9, 125489], [16, 126149], [23, 126459], [27, 126769], [31, 126929], [37, 127169], [44, 128069], [50, 128529], [52, 128749], [65, 130039], [70, 130320], [76, 130620], [79, 130860], [86, 131180], [89, 131340]]}, {"verse": 21, "start": 132317, "end": 138563, "text": "Y Marta dijo a Jesús: Señor, si hubieses estado aquí, mi hermano no habría muerto;", "words": [[0, 132317], [2, 132600], [8, 132920], [13, 133140], [15, 133340], [22, 134156], [29, 134981], [32, 135101], [41, 135501], [48, 135821], [54, 136661], [57, 136801], [65, 137341], [68, 137501], [75, 137881]]}, {"verse": 22, "start": 138913, "end": 143387, "text": "Pero también sé ahora, que todo lo que pidas a Dios, Dios te lo dará.", "words": [[0, 138913], [5, 139064], [13, 139414], [16, 139764], [23, 140164], [27, 140624], [32, 140844], [35, 141044], [39, 141184], [45, 141484], [47, 141644], [53, 142364], [58, 142544], [61, 142784], [64, 142904]]}, {"verse": 23, "start": 143667, "end": 146833, "text": "Le dice Jesús: Resucitará tu hermano.", "words": [[0, 143667], [3, 143784], [8, 144044], [15, 145058], [26, 146039], [29, 146179]]}, {"verse": 24, "start": 147183, "end": 153213, "text": "Marta le dice: Yo sé que resucitará en la resurrección en el día postrero.", "words": [[0, 147183], [6, 147728], [9, 147868], [15, 148610], [18, 148793], [21, 148973], [25, 149133], [36, 149993], [39, 150173], [42, 150273], [55, 151153], [58, 151413], [61, 151553], [65, 151793]]}, {"verse": 25, "start": 153493, "end": 160444, "text": "Le dice Jesús: Yo soy la resurrección y la vida: el que cree en mí, aunque esté muerto, vivirá.", "words": [[0, 153493], [3, 153610], [8, 153870], [15, 154884], [18, 155069], [22, 155369], [25, 155654], [38, 156574], [40, 156814], [43, 156934], [49, 157642], [52, 157790], [56, 157930], [61, 158270], [64, 158650], [68, 159270], [75, 159450], [80, 159710], [88, 160077]]}, {"verse": 26, "start": 160794, "end": 166589, "text": "Y todo aquel que vive y cree en mí, no morirá eternamente. ¿Crees esto?", "words": [[0, 161400], [2, 161555], [7, 161775], [13, 162215], [17, 162315], [22, 162615], [24, 162875], [29, 163155], [32, 163495], [36, 163735], [39, 164195], [46, 164655], [59, 165814], [66, 166039]]}, {"verse": 27, "start": 166939, "end": 172957, "text": "Le dice: Sí, Señor; yo he creído que tú eres el Cristo, el Hijo de Dios, que has venido al mundo.", "words": [[0, 166939], [3, 167085], [9, 167798], [13, 168123], [20, 168820], [23, 168968], [26, 169068], [33, 169368], [37, 169528], [40, 169708], [45, 169928], [48, 170088], [56, 170808], [59, 170888], [64, 171108], [67, 171228], [73, 171788], [77, 171848], [81, 172008], [88, 172328], [91, 172468]]}, {"verse": 28, "start": 173237, "end": 181824, "text": "Habiendo dicho esto, fue y llamó a María su hermana, diciéndole en secreto: El Maestro está aquí y te llama.", "words": [[0, 173237], [9, 173625], [15, 173945], [21, 174245], [25, 174717], [27, 174840], [33, 175200], [35, 175300], [41, 175560], [44, 175900], [53, 177060], [64, 177980], [67, 178380], [76, 179436], [79, 179566], [87, 180146], [92, 180446], [97, 180846], [99, 181126], [102, 181266]]}, {"verse": 29, "start": 182104, "end": 185676, "text": "Ella, como lo oyó, se levanta rápidamente y viene a él.", "words": [[0, 182104], [6, 182328], [11, 182608], [14, 182898], [19, 183188], [22, 183423], [30, 183923], [42, 184643], [44, 184843], [50, 185083], [52, 185283]]}, {"verse": 30, "start": 186026, "end": 192783, "text": "(Que aún no había llegado Jesús a la aldea, pero estaba en aquel lugar donde Marta le había encontrado.)", "words": [[0, 186026], [5, 186128], [9, 186348], [12, 186588], [18, 186808], [26, 187268], [32, 187588], [34, 187968], [37, 188128], [44, 188728], [49, 189188], [56, 189488], [59, 189688], [65, 189988], [71, 190288], [77, 190648], [83, 191248], [86, 191568], [92, 191808]]}, {"verse": 31, "start": 193133, "end": 206717, "text": "Entonces los judíos que estaban en casa con ella, y la consolaban, cuando vieron que María se había levantado rápidamente, y había salido, la siguieron, diciendo: Va al sepulcro a llorar allí.", "words": [[0, 193133], [9, 194146], [13, 194406], [20, 194946], [24, 195066], [32, 195346], [35, 195506], [40, 195746], [44, 196046], [50, 196326], [52, 196806], [55, 196946], [67, 198346], [74, 198426], [81, 198766], [85, 198946], [91, 199206], [94, 199486], [100, 199686], [110, 200246], [123, 201106], [125, 201566], [131, 201786], [139, 202666], [142, 202766], [153, 203366], [163, 204794], [166, 205057], [169, 205217], [178, 205817], [180, 205997], [187, 206297]]}, {"verse": 32, "start": 206997, "end": 217910, "text": "Pero María, cuando vino donde estaba Jesús, viéndole, se derribó a sus pies, diciéndole: Señor, si hubieras estado aquí, no habría muerto mi hermano.", "words": [[0, 206997], [5, 207141], [12, 207501], [19, 207881], [24, 208261], [30, 208501], [37, 208881], [44, 209901], [54, 210801], [57, 210941], [65, 211501], [67, 211601], [71, 211761], [77, 212281], [89, 213350], [96, 214492], [99, 214632], [108, 215112], [115, 215472], [121, 216312], [124, 216432], [131, 216812], [138, 217172], [141, 217332]]}, {"verse": 33, "start": 218190, "end": 227004, "text": "Jesús entonces, como la vio llorando, y a los judíos que habían venido juntamente con ella llorando, se conmovió en espíritu, y se turbó,", "words": [[0, 218190], [6, 218520], [16, 219220], [21, 219400], [24, 219540], [28, 219740], [38, 220300], [40, 220780], [42, 220880], [46, 220980], [53, 221520], [57, 221640], [64, 221880], [71, 222320], [82, 222900], [86, 223090], [91, 223280], [101, 224115], [104, 224195], [113, 224855], [116, 224935], [126, 225995], [128, 226215], [131, 226355]]}, {"verse": 34, "start": 227354, "end": 232485, "text": "Y dijo: ¿Dónde le pusisteis? Le dicen: Señor, ven, y ve.", "words": [[0, 227354], [2, 227455], [8, 228885], [15, 228885], [18, 228885], [29, 230472], [32, 230794], [39, 231306], [46, 231561], [51, 231851], [53, 232191]]}, {"verse": 35, "start": 232765, "end": 233781, "text": "Y lloró Jesús.", "words": [[0, 232765], [2, 232952], [8, 233172]]}, {"verse": 36, "start": 234131, "end": 237504, "text": "Dijeron entonces los judíos: Mirad cómo le amaba.", "words": [[0, 234131], [8, 234676], [17, 235136], [21, 235416], [29, 236401], [35, 236699], [40, 236919], [43, 237079]]}, {"verse": 37, "start": 237784, "end": 243979, "text": "Y algunos de ellos dijeron: ¿No podía este que abrió los ojos al ciego, hacer que este no muriera?", "words": [[0, 237784], [2, 237905], [10, 238225], [13, 238465], [19, 238785], [28, 240038], [32, 240163], [38, 240443], [43, 240843], [47, 240983], [53, 241263], [57, 241423], [62, 241683], [65, 241923], [72, 242563], [78, 242803], [82, 243023], [87, 243243], [90, 243383]]}, {"verse": 38, "start": 244259, "end": 252797, "text": "Y Jesús, conmoviéndose otra vez en sí mismo, vino al sepulcro. Era una cueva, la cual tenía una piedra encima.", "words": [[0, 244259], [2, 244388], [9, 245148], [23, 246088], [28, 246388], [32, 246668], [35, 246868], [38, 247048], [45, 248148], [50, 248388], [53, 248588], [63, 249621], [67, 249807], [71, 250007], [78, 250747], [81, 250847], [86, 251067], [92, 251447], [96, 251687], [103, 252107]]}, {"verse": 39, "start": 253147, "end": 262546, "text": "Dice Jesús: Quitad la piedra. Marta, la hermana del que se había muerto, le dice: Señor, ya huele mal, porque lleva cuatro días muerto.", "words": [[0, 253147], [5, 253669], [12, 254549], [19, 254911], [22, 255071], [30, 255859], [37, 256426], [40, 256546], [48, 256779], [52, 257013], [56, 257246], [59, 257466], [65, 257666], [73, 258246], [76, 258346], [82, 259100], [89, 259418], [92, 259718], [98, 260058], [103, 260358], [110, 260778], [116, 261058], [123, 261358], [128, 261738]]}, {"verse": 40, "start": 262826, "end": 268073, "text": "Jesús le dice: ¿No te he dicho que, si crees, verás la gloria de Dios?", "words": [[0, 262826], [6, 263161], [9, 263401], [15, 264235], [19, 264359], [22, 264539], [25, 264619], [31, 264879], [36, 265119], [39, 265679], [46, 266279], [52, 266819], [55, 266939], [62, 267339], [65, 267479]]}, {"verse": 41, "start": 268423, "end": 279375, "text": "Entonces quitaron la piedra de donde el muerto había sido puesto. Y Jesús, alzando los ojos arriba, dijo: Padre, gracias te doy que me has oído.", "words": [[0, 268423], [9, 269114], [18, 269914], [21, 270094], [28, 270614], [31, 270754], [37, 271014], [40, 271234], [47, 271694], [53, 271914], [58, 272254], [66, 273211], [68, 273320], [75, 274160], [83, 274640], [87, 274860], [92, 275200], [100, 276060], [106, 276786], [113, 277452], [121, 278095], [124, 278187], [128, 278407], [132, 278487], [135, 278627], [139, 278767]]}, {"verse": 42, "start": 279725, "end": 287949, "text": "Que yo sabía que siempre me oyes; pero por causa de la multitud que está alrededor, lo dije, para que crean que tú me has enviado.", "words": [[0, 279725], [4, 279809], [7, 279949], [13, 280329], [17, 280449], [25, 280809], [28, 281089], [34, 281895], [39, 282039], [43, 282279], [49, 282619], [52, 282879], [55, 283259], [64, 283639], [68, 283819], [73, 284039], [84, 284899], [87, 284999], [93, 285299], [98, 285819], [102, 286019], [108, 286419], [112, 286579], [115, 286759], [118, 286959], [122, 287159]]}, {"verse": 43, "start": 288299, "end": 293403, "text": "Y habiendo dicho estas cosas, clamó a gran voz: Lázaro, ven fuera.", "words": [[0, 288299], [2, 288443], [11, 288783], [17, 289123], [23, 289343], [30, 290223], [36, 290663], [38, 290763], [43, 290903], [48, 291685], [56, 292651], [60, 292791]]}, {"verse": 44, "start": 293753, "end": 307024, "text": "Y el que había estado muerto, salió, atadas las manos y los pies con vendas; y su rostro estaba envuelto en un paño funerario. Les dice Jesús: Desatadle, y dejadle ir.", "words": [[0, 293753], [2, 293850], [5, 293930], [9, 294070], [15, 294290], [22, 294550], [30, 295190], [37, 295990], [44, 296850], [48, 297050], [54, 297450], [56, 297710], [60, 297850], [65, 298070], [69, 298290], [77, 299252], [79, 299357], [82, 299497], [89, 300077], [96, 300397], [105, 301097], [108, 301217], [111, 301377], [116, 301937], [127, 303345], [131, 303539], [136, 303732], [143, 304679], [154, 305457], [156, 305917], [164, 306537]]}, {"verse": 45, "start": 307374, "end": 315602, "text": "Entonces muchos de los judíos que habían venido a María, y habían visto lo que había hecho Jesús, creyeron en él.", "words": [[0, 307374], [9, 308177], [16, 308617], [19, 308837], [23, 308937], [30, 309397], [34, 309557], [41, 309797], [48, 310237], [50, 310317], [57, 310617], [59, 311082], [66, 311362], [72, 311802], [75, 312402], [79, 312542], [85, 312822], [91, 313122], [98, 314052], [107, 314982], [110, 315302]]}, {"verse": 46, "start": 315952, "end": 321020, "text": "Pero algunos de ellos fueron a los fariseos, y les dijeron lo que Jesús había hecho.", "words": [[0, 315952], [5, 316097], [13, 316457], [16, 316677], [22, 316957], [29, 317277], [31, 317537], [35, 317637], [45, 318377], [47, 318737], [51, 318877], [59, 319357], [62, 319497], [66, 319637], [72, 319917], [78, 320357]]}, {"verse": 47, "start": 321370, "end": 330274, "text": "Entonces los principales sacerdotes y los fariseos reunieron el Consejo, y decían: ¿Qué hacemos? porque este hombre hace muchas señales.", "words": [[0, 321370], [9, 321875], [13, 322375], [25, 323055], [36, 323735], [38, 323875], [42, 324015], [51, 324775], [61, 325535], [64, 325715], [73, 326335], [75, 326515], [83, 327385], [88, 327485], [97, 328364], [104, 328547], [109, 328727], [116, 328987], [121, 329247], [128, 329527]]}, {"verse": 48, "start": 330624, "end": 336481, "text": "Si le dejamos así, todos creerán en él: y vendrán los Romanos, y quitarán nuestro lugar y la nación.", "words": [[0, 330624], [3, 330744], [6, 330864], [14, 331204], [19, 332004], [25, 332144], [33, 332704], [36, 332804], [40, 333319], [42, 333435], [50, 333775], [54, 333895], [63, 334455], [65, 334715], [74, 335135], [82, 335315], [88, 335715], [90, 335875], [93, 335975]]}, {"verse": 49, "start": 336761, "end": 343156, "text": "Y Caifás, uno de ellos, sumo sacerdote de aquel año, les dijo: Vosotros no sabéis nada;", "words": [[0, 336761], [2, 336907], [10, 337907], [14, 338067], [17, 338267], [24, 339007], [29, 339387], [39, 340027], [42, 340227], [48, 340507], [53, 340747], [57, 340987], [63, 341712], [72, 342136], [75, 342336], [82, 342696]]}, {"verse": 50, "start": 343506, "end": 348909, "text": "Ni pensáis que nos conviene que un hombre muera por el pueblo, y no que toda la nación se pierda.", "words": [[0, 343506], [3, 343630], [11, 344130], [15, 344310], [19, 344470], [28, 344970], [32, 345150], [35, 345310], [42, 345550], [48, 345950], [52, 346150], [55, 346290], [63, 346690], [65, 347150], [68, 347290], [72, 347450], [77, 347630], [80, 347850], [87, 348210], [90, 348370]]}, {"verse": 51, "start": 349189, "end": 358198, "text": "Pero esto no lo dijo de sí mismo; sino que, como era el sumo sacerdote de aquel año, profetizó que Jesús había de morir por la nación:", "words": [[0, 349189], [5, 349333], [10, 349553], [13, 349753], [16, 349873], [21, 350153], [24, 350353], [27, 350493], [34, 351205], [39, 351405], [44, 351857], [49, 352077], [53, 352297], [56, 352457], [61, 353017], [71, 353717], [74, 353917], [80, 354217], [85, 354882], [95, 355482], [99, 355662], [105, 356022], [111, 356522], [114, 356802], [120, 357202], [124, 357362], [127, 357542]]}, {"verse": 52, "start": 358548, "end": 365411, "text": "Y no solamente por aquella nación, sino también para que juntase en uno los hijos de Dios que estaban dispersos.", "words": [[0, 358548], [2, 358694], [5, 358814], [15, 359194], [19, 359614], [27, 359954], [35, 360794], [40, 361114], [48, 361554], [53, 361874], [57, 362174], [65, 362474], [68, 362774], [72, 362974], [76, 363214], [82, 363514], [85, 363774], [90, 363994], [94, 364154], [102, 364414]]}, {"verse": 53, "start": 365761, "end": 369395, "text": "Así que, desde aquel día planeaban juntos matarle.", "words": [[0, 365761], [4, 366158], [9, 366358], [15, 366678], [21, 367098], [25, 367338], [35, 368058], [42, 368418]]}, {"verse": 54, "start": 369745, "end": 383509, "text": "Por tanto, Jesús ya no andaba abiertamente entre los judíos; sino que se alejó de allí a la región contigua al desierto, a una ciudad llamada Efraín: y estábase allí con sus discípulos.", "words": [[0, 369745], [4, 369889], [11, 370189], [17, 370709], [20, 371369], [23, 371589], [30, 372129], [43, 373009], [49, 373349], [53, 373569], [61, 374659], [66, 374857], [70, 375037], [73, 375197], [79, 375597], [82, 375717], [87, 375997], [89, 376177], [92, 376277], [99, 376887], [108, 377497], [111, 377577], [121, 378537], [123, 378737], [127, 378877], [134, 379217], [142, 379897], [150, 381044], [152, 381370], [161, 381730], [166, 382050], [170, 382290], [174, 382510]]}, {"verse": 55, "start": 383859, "end": 392077, "text": "Y la Pascua de los judíos estaba cerca: y muchos subieron de aquella tierra a Jerusalén antes de la Pascua, para purificarse;", "words": [[0, 383859], [2, 383985], [5, 384335], [12, 384685], [15, 384745], [19, 384885], [26, 385385], [33, 385665], [40, 386629], [42, 386754], [49, 387034], [58, 387654], [61, 387834], [69, 388194], [76, 388534], [78, 388834], [88, 389474], [94, 389814], [97, 389994], [100, 390094], [108, 390614], [113, 391014]]}, {"verse": 56, "start": 392427, "end": 399298, "text": "Y buscaban a Jesús, y hablaban los unos con los otros estando en el templo: ¿Qué os parece, que no vendrá a la fiesta?", "words": [[0, 392427], [2, 392591], [11, 393091], [13, 393231], [20, 393511], [22, 393856], [31, 394316], [35, 394496], [40, 394816], [44, 395136], [48, 395336], [54, 395716], [62, 396316], [65, 396456], [68, 396576], [76, 397358], [81, 397459], [84, 397579], [92, 397939], [96, 398119], [99, 398279], [106, 398619], [108, 398699], [111, 398739]]}, {"verse": 57, "start": 399578, "end": 410075, "text": "Y los principales sacerdotes y los fariseos habían dado mandamiento, que si alguno supiese dónde estuviera, lo manifestase, para que le prendiesen.", "words": [[0, 399578], [2, 399685], [6, 399805], [18, 400505], [29, 401225], [31, 401385], [35, 401505], [44, 402245], [51, 402490], [56, 402890], [69, 403670], [73, 404110], [76, 404250], [83, 404690], [91, 405130], [97, 405410], [108, 406710], [111, 406810], [124, 408270], [129, 408930], [133, 409090], [136, 409210]]}]}