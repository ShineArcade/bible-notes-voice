{"book": "REV", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 166216, "verses": [{"verse": 1, "start": 300, "end": 13128, "text": "Y después de estas cosas vi cuatro ángeles que estaban sobre los cuatro ángulos de la tierra, deteniendo los cuatro vientos de la tierra, para que no soplase viento sobre la tierra, ni sobre el mar, ni sobre ningún árbol.", "words": [[0, 300], [2, 398], [10, 698], [13, 918], [19, 1118], [25, 1538], [28, 1818], [35, 2118], [43, 2618], [47, 2798], [55, 3138], [61, 3458], [65, 3658], [72, 3958], [80, 4418], [83, 4578], [86, 4698], [94, 5058], [105, 6118], [109, 6318], [116, 6638], [124, 7078], [127, 7278], [130, 7378], [138, 8198], [143, 8338], [147, 8458], [150, 8748], [158, 9038], [165, 9478], [171, 9738], [174, 9938], [182, 10638], [185, 10858], [191, 11098], [194, 11298], [199, 11838], [202, 11938], [208, 12198], [215, 12518]]}, {"verse": 2, "start": 13578, "end": 24652, "text": "Y vi otro ángel que subía de donde nace el sol, teniendo el sello del Dios vivo: y clamó con gran voz a los cuatro ángeles, a los cuales era dado hacer daño a la tierra y al mar,", "words": [[0, 13578], [2, 13715], [5, 13835], [10, 14075], [16, 14515], [20, 14635], [26, 15075], [29, 15195], [35, 15395], [40, 15815], [43, 15955], [48, 16695], [57, 17075], [60, 17195], [66, 17535], [70, 17675], [75, 17935], [81, 18746], [83, 18871], [89, 19252], [93, 19371], [98, 19632], [102, 19932], [104, 20191], [108, 20332], [115, 20652], [124, 21752], [126, 21812], [130, 21932], [137, 22212], [141, 22511], [146, 22912], [152, 23072], [157, 23412], [159, 23511], [162, 23592], [169, 23932], [171, 24152], [174, 24272]]}, {"verse": 3, "start": 25101, "end": 32948, "text": "Diciendo: No hagáis daño a la tierra, ni al mar, ni a los árboles, hasta que pongamos el sello a los siervos de nuestro Dios en sus frentes.", "words": [[0, 25101], [10, 26111], [13, 26253], [20, 26553], [25, 26873], [27, 26953], [30, 26993], [38, 27313], [41, 27533], [44, 27673], [49, 27913], [52, 28133], [54, 28213], [58, 28353], [67, 28833], [73, 29373], [77, 29573], [86, 30093], [89, 30273], [95, 30593], [97, 30673], [101, 30813], [109, 31193], [112, 31313], [120, 31493], [125, 31893], [128, 32073], [132, 32193]]}, {"verse": 4, "start": 33398, "end": 40122, "text": "Y oí el número de los sellados: ciento cuarenta y cuatro mil sellados de todas las tribus de los hijos de Israel.", "words": [[0, 33398], [2, 33557], [5, 33737], [8, 33837], [15, 34097], [18, 34317], [22, 34417], [32, 35578], [39, 35774], [48, 35970], [50, 36166], [57, 36362], [61, 36762], [70, 37402], [73, 37642], [79, 37842], [83, 38162], [90, 38682], [93, 38822], [97, 38942], [103, 39222], [106, 39442]]}, {"verse": 5, "start": 40572, "end": 49182, "text": "De la tribu de Judá, doce mil sellados. De la tribu de Rubén, doce mil sellados. De la tribu de Gad, doce mil sellados.", "words": [[0, 40572], [3, 40689], [6, 40789], [12, 41169], [15, 41289], [21, 42049], [26, 42349], [30, 42569], [40, 43835], [43, 43985], [46, 44135], [52, 44285], [55, 44365], [62, 45205], [67, 45485], [71, 45705], [81, 46850], [84, 46950], [87, 47070], [93, 47430], [96, 47550], [101, 47863], [106, 48177], [110, 48490]]}, {"verse": 6, "start": 49632, "end": 58037, "text": "De la tribu de Aser, doce mil sellados. De la tribu de Neftalí, doce mil sellados. De la tribu de Manasés, doce mil sellados.", "words": [[0, 49632], [3, 49732], [6, 49832], [12, 50192], [15, 50542], [21, 50892], [26, 51132], [30, 51292], [40, 52402], [43, 52500], [46, 52620], [52, 52920], [55, 53000], [64, 53800], [69, 54020], [73, 54200], [83, 55260], [86, 55440], [89, 55540], [95, 55900], [98, 56340], [107, 56780], [112, 57080], [116, 57280]]}, {"verse": 7, "start": 58487, "end": 67103, "text": "De la tribu de Simeón, doce mil sellados. De la tribu de Leví, doce mil sellados. De la tribu de Isacar, doce mil sellados.", "words": [[0, 58487], [3, 58604], [6, 58724], [12, 59104], [15, 59204], [23, 60024], [28, 60304], [32, 60504], [42, 61650], [45, 61732], [48, 61852], [54, 62172], [57, 62272], [63, 62912], [68, 63192], [72, 63372], [82, 64414], [85, 64533], [88, 64613], [94, 64973], [97, 65313], [105, 65653], [110, 65993], [114, 66333]]}, {"verse": 8, "start": 67553, "end": 76243, "text": "De la tribu de Zabulón, doce mil sellados. De la tribu de José, doce mil sellados. De la tribu de Benjamín, doce mil sellados.", "words": [[0, 67553], [3, 67678], [6, 67778], [12, 68138], [15, 68608], [24, 69078], [29, 69358], [33, 69558], [43, 70670], [46, 70794], [49, 70914], [55, 71294], [58, 71394], [64, 71747], [69, 72101], [73, 72454], [83, 73436], [86, 73581], [89, 73681], [95, 74041], [98, 74141], [108, 74614], [113, 75088], [117, 75561]]}, {"verse": 9, "start": 76693, "end": 92437, "text": "Después de estas cosas miré, y he aquí una gran multitud que nadie podía contar, de todas naciones y linajes y pueblos y lenguas, que estaban delante del trono y en la presencia del Cordero, vestidos de ropas blancas, y palmas en sus manos;", "words": [[0, 76693], [8, 76991], [11, 77251], [17, 77431], [23, 78011], [29, 78311], [31, 78771], [34, 78931], [39, 79171], [43, 79351], [48, 79611], [57, 80191], [61, 80391], [67, 80651], [73, 80971], [81, 81511], [84, 81971], [90, 82191], [99, 82791], [101, 83031], [109, 83511], [111, 83711], [119, 84171], [121, 84291], [130, 85911], [134, 85992], [142, 86312], [150, 86812], [154, 87012], [160, 87412], [162, 87532], [165, 87652], [168, 87732], [178, 88232], [182, 88392], [191, 89292], [200, 89772], [203, 89972], [209, 90272], [218, 90892], [220, 91212], [227, 91612], [230, 91772], [234, 91892]]}, {"verse": 10, "start": 92887, "end": 99627, "text": "Y clamaban en alta voz, diciendo: Salvación a nuestro Dios que está sentado sobre el trono, y al Cordero.", "words": [[0, 92887], [2, 92992], [11, 93492], [14, 93732], [19, 93972], [24, 94212], [34, 95787], [44, 96107], [46, 96227], [54, 96387], [59, 96747], [63, 97007], [68, 97207], [76, 97667], [82, 97887], [85, 98067], [92, 98467], [94, 98927], [97, 99067]]}, {"verse": 11, "start": 100077, "end": 110818, "text": "Y todos los ángeles estaban alrededor del trono, y de los ancianos y los cuatro seres vivientes; y se postraron sobre sus rostros delante del trono, y adoraron a Dios,", "words": [[0, 100077], [2, 100202], [8, 100362], [12, 100602], [20, 101062], [28, 101482], [38, 101842], [42, 102282], [49, 102702], [51, 103062], [54, 103142], [58, 103262], [67, 103882], [69, 104022], [73, 104162], [80, 104442], [86, 104722], [97, 105901], [99, 106029], [102, 106129], [112, 106749], [118, 106949], [122, 107149], [130, 107649], [138, 108089], [142, 108209], [149, 108669], [151, 109129], [160, 109649], [162, 109749]]}, {"verse": 12, "start": 111268, "end": 121354, "text": "Diciendo: Amén: La bendición y la gloria y la sabiduría, y la acción de gracias y la honra y el poder y la fortaleza, sean a nuestro Dios para siempre. Amén.", "words": [[0, 111514], [10, 112151], [16, 112596], [19, 112697], [29, 113297], [31, 113457], [34, 113557], [41, 113977], [43, 114077], [46, 114177], [57, 114877], [59, 115117], [62, 115237], [69, 115597], [72, 115737], [80, 116077], [82, 116417], [85, 116517], [91, 116917], [93, 117037], [96, 117157], [102, 117397], [104, 117597], [107, 117697], [118, 118437], [123, 119017], [125, 119157], [133, 119377], [138, 119737], [143, 120037], [152, 120948]]}, {"verse": 13, "start": 121804, "end": 129193, "text": "Y respondió uno de los ancianos, diciéndome: Estos que están vestidos de ropas blancas, ¿quiénes son, y de dónde han venido?", "words": [[0, 121804], [2, 121928], [12, 122528], [16, 122728], [19, 122848], [23, 122968], [33, 123588], [45, 124865], [51, 125086], [55, 125306], [61, 125526], [70, 126026], [73, 126186], [79, 126506], [88, 127266], [97, 127486], [102, 127826], [104, 128066], [107, 128186], [113, 128386], [117, 128666]]}, {"verse": 14, "start": 129643, "end": 140843, "text": "Y yo le dije: Señor, tú lo sabes. Y él me dijo: Estos son los que han venido de grande tribulación, y han lavado sus ropas, y las han blanqueado en la sangre del Cordero.", "words": [[0, 129643], [2, 129768], [5, 129908], [8, 130028], [14, 130795], [21, 130918], [24, 131075], [27, 131233], [34, 132468], [36, 132488], [39, 132608], [42, 132728], [48, 133461], [54, 133783], [58, 134003], [62, 134163], [66, 134323], [70, 134463], [77, 134823], [80, 134963], [87, 135183], [100, 135943], [102, 136463], [106, 136563], [113, 136903], [117, 137063], [124, 137503], [126, 137923], [130, 138043], [134, 138243], [145, 138743], [148, 138883], [151, 138983], [158, 139283], [162, 139483]]}, {"verse": 15, "start": 141293, "end": 150524, "text": "Por esto están delante del trono de Dios, y le sirven día y noche en su templo: y el que está sentado en el trono extenderá su tienda sobre ellos.", "words": [[0, 141293], [4, 141431], [9, 141711], [15, 142091], [23, 142611], [27, 142811], [33, 143171], [36, 143291], [42, 143571], [44, 143951], [47, 144331], [54, 144731], [58, 145031], [60, 145271], [66, 145531], [69, 145731], [72, 145831], [80, 146685], [82, 146789], [85, 146869], [89, 147009], [94, 147249], [102, 147809], [105, 147909], [108, 148029], [114, 148429], [124, 149109], [127, 149229], [134, 149629], [140, 149929]]}, {"verse": 16, "start": 150974, "end": 156299, "text": "No tendrán más hambre, ni sed, y el sol no caerá más sobre ellos, ni otro ningún calor.", "words": [[0, 150974], [3, 151099], [11, 151599], [15, 151779], [23, 152239], [26, 152399], [31, 152739], [33, 152979], [36, 153119], [40, 153319], [43, 153519], [49, 153899], [53, 154039], [59, 154319], [66, 154659], [69, 155179], [74, 155419], [81, 155719]]}, {"verse": 17, "start": 156749, "end": 165816, "text": "Porque el Cordero que está en medio del trono los pastoreará, y los guiará a fuentes vivas de aguas: y Dios limpiará toda lágrima de los ojos de ellos.", "words": [[0, 156749], [7, 156957], [10, 157097], [18, 157517], [22, 157677], [27, 157937], [30, 158097], [36, 15831