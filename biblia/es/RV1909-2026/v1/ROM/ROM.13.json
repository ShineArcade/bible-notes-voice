{"book": "ROM", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 113314, "verses": [{"verse": 1, "start": 300, "end": 8443, "text": "Toda alma se someta a las autoridades superiores; porque no hay autoridad sino de Dios; y las que son, de Dios son ordenadas.", "words": [[0, 300], [5, 564], [10, 764], [13, 944], [20, 1464], [22, 1544], [26, 1664], [38, 2284], [50, 3504], [57, 3707], [60, 3967], [64, 4167], [74, 4707], [79, 5027], [82, 5227], [88, 6028], [90, 6129], [94, 6249], [98, 6429], [103, 6709], [106, 7129], [111, 7349], [115, 7629]]}, {"verse": 2, "start": 8893, "end": 16477, "text": "Así que, el que se opone a la autoridad, a la ordenación de Dios resiste: y los que resisten, ellos mismos ganan condenación para sí.", "words": [[0, 8893], [4, 9117], [9, 9337], [12, 9457], [16, 9577], [19, 9717], [25, 10117], [27, 10237], [30, 10297], [41, 11077], [43, 11077], [46, 11137], [57, 11657], [60, 11837], [65, 12057], [74, 13122], [76, 13221], [80, 13321], [84, 13461], [94, 14341], [100, 14521], [107, 14841], [113, 15221], [125, 15821], [130, 16061]]}, {"verse": 3, "start": 16927, "end": 24917, "text": "Porque los magistrados no son para temor al que bien hace, sino al malo. ¿Quieres pues no temer la autoridad? haz lo bueno, y tendrás alabanza de ella;", "words": [[0, 16927], [7, 17111], [11, 17291], [23, 17951], [26, 18171], [30, 18411], [35, 18591], [41, 18991], [44, 19071], [48, 19211], [53, 19391], [59, 19911], [64, 20031], [67, 20211], [73, 20844], [82, 21161], [87, 21281], [90, 21521], [96, 21861], [99, 21981], [110, 22821], [114, 23006], [117, 23146], [124, 23446], [126, 23666], [134, 24056], [143, 24446], [146, 24586]]}, {"verse": 4, "start": 25367, "end": 35054, "text": "Porque es ministro de Dios para tu bien. Pero si haces lo malo, teme: porque no en vano lleva la espada; porque es ministro de Dios, vengador para castigo al que hace lo malo.", "words": [[0, 25367], [7, 25562], [10, 25702], [19, 26202], [22, 26302], [27, 26502], [32, 26762], [35, 26922], [41, 27620], [46, 27746], [49, 27946], [55, 28226], [58, 28386], [64, 28826], [70, 29526], [77, 29727], [80, 29947], [83, 30087], [88, 30327], [94, 30507], [97, 30667], [105, 31502], [112, 31706], [115, 31826], [124, 32286], [127, 32386], [133, 32986], [142, 33366], [147, 33566], [155, 34066], [158, 34186], [162, 34306], [167, 34486], [170, 34646]]}, {"verse": 5, "start": 35504, "end": 41022, "text": "Por lo cual es necesario que le estéis sujetos, no solamente por la ira, sino también por la conciencia.", "words": [[0, 35504], [4, 35624], [7, 35704], [12, 35864], [15, 36004], [25, 36484], [29, 36644], [32, 36744], [39, 37044], [48, 37944], [51, 38064], [61, 38344], [65, 38704], [68, 38844], [73, 39364], [78, 39584], [86, 39944], [90, 40144], [93, 40264]]}, {"verse": 6, "start": 41472, "end": 46756, "text": "Porque por esto pagáis también los tributos; porque son ministros de Dios que sirven a esto mismo.", "words": [[0, 41472], [7, 41672], [11, 41872], [16, 42052], [23, 42472], [31, 42772], [35, 42972], [45, 44022], [52, 44219], [56, 44479], [66, 45019], [69, 45139], [74, 45339], [78, 45539], [85, 45959], [87, 46039], [92, 46219]]}, {"verse": 7, "start": 47206, "end": 55774, "text": "Pagad a todos lo que debéis: al que tributo, tributo; al que impuesto, impuesto; al que temor, temor; al que honra, honra.", "words": [[0, 47378], [6, 47588], [8, 47688], [14, 47848], [17, 48108], [21, 48188], [29, 49029], [32, 49194], [36, 49314], [45, 50014], [54, 50964], [57, 51109], [61, 51229], [71, 51949], [81, 53029], [84, 53172], [88, 53529], [95, 53885], [102, 54542], [105, 54686], [109, 54806], [116, 55306]]}, {"verse": 8, "start": 56224, "end": 63153, "text": "No debáis a nadie nada, sino amaros unos a otros; porque el que ama al prójimo, cumplió la ley.", "words": [[0, 56224], [3, 56410], [10, 56830], [12, 56970], [18, 57230], [24, 57990], [29, 58130], [36, 58710], [41, 59010], [43, 59370], [50, 60199], [57, 60458], [60, 60698], [64, 60858], [68, 61078], [71, 61278], [80, 61858], [88, 62658], [91, 62778]]}, {"verse": 9, "start": 63603, "end": 77432, "text": "Porque: No adulterarás; no matarás; no hurtarás; no dirás falso testimonio; no codiciarás; y si hay algún otro mandamiento, en esta frase se resume: Amarás a tu prójimo como a ti mismo.", "words": [[0, 63603], [8, 64390], [11, 64582], [24, 65825], [27, 65989], [36, 67009], [39, 67490], [49, 68250], [52, 68370], [58, 68710], [64, 69070], [76, 70148], [79, 70295], [91, 71508], [93, 71620], [96, 71740], [100, 71880], [106, 72180], [111, 72400], [124, 73120], [127, 73440], [132, 73680], [138, 74080], [141, 74300], [149, 75224], [156, 75623], [158, 75703], [161, 75843], [169, 76363], [174, 76645], [176, 76928], [179, 77210]]}, {"verse": 10, "start": 77882, "end": 82444, "text": "El amor no hace mal al prójimo: así que, el cumplimiento de la ley es el amor.", "words": [[0, 77882], [3, 78005], [8, 78265], [11, 78545], [16, 78765], [20, 79085], [23, 79245], [32, 80199], [36, 80376], [41, 80556], [44, 80636], [57, 81256], [60, 81416], [63, 81536], [67, 81756], [70, 81916], [73, 82076]]}, {"verse": 11, "start": 82894, "end": 90789, "text": "Y esto, conociendo el tiempo, que es ya hora de levantarnos del sueño; porque ahora nos está más cerca nuestra salvación que cuando creímos.", "words": [[0, 82894], [2, 83035], [8, 83275], [19, 83915], [22, 84075], [30, 84455], [34, 84955], [37, 85155], [40, 85275], [45, 85455], [48, 85595], [60, 86175], [64, 86355], [71, 87183], [78, 87374], [84, 87634], [88, 87814], [93, 88154], [97, 88354], [103, 88714], [111, 88954], [121, 89674], [125, 89834], [132, 90074]]}, {"verse": 12, "start": 91239, "end": 98289, "text": "La noche ha pasado, y ha llegado el día: desechemos, pues, las obras de las tinieblas, y vistámonos las armas de luz.", "words": [[0, 91239], [3, 91358], [9, 91618], [12, 91858], [20, 92298], [22, 92598], [25, 92638], [33, 93058], [36, 93198], [41, 93879], [53, 94446], [59, 94766], [63, 95046], [69, 95366], [72, 95526], [76, 95646], [87, 96286], [89, 96586], [100, 97226], [104, 97346], [110, 97646], [113, 97846]]}, {"verse": 13, "start": 98739, "end": 108088, "text": "Andemos como de día, honestamente: no en glotonerías y borracheras, no en inmoralidad sexual ni desenfreno, no en peleas y envidia:", "words": [[0, 98739], [8, 99299], [13, 99579], [16, 99759], [21, 100139], [35, 101282], [38, 101507], [41, 101997], [53, 102487], [55, 102647], [68, 103847], [71, 104007], [74, 104147], [86, 104767], [93, 105227], [96, 105507], [108, 106647], [111, 106787], [114, 106907], [121, 107367], [123, 107487]]}, {"verse": 14, "start": 108538, "end": 112914, "text": "Pero vestíos del Señor Jesucristo, y no hagáis caso de la carne en sus deseos.", "words": [[0, 108538], [5, 108682], [13, 109162], [17, 109302], [23, 109522], [35, 110322], [37, 110682], [40, 110822], [47, 111102], [52, 111342], [55, 111542], [58, 111662], [64, 111962], [67, 112102], [71, 112222]]}]}