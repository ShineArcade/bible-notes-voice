{"book": "MAT", "chapter": 17, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 230842, "verses": [{"verse": 1, "start": 300, "end": 9599, "text": "Y después de seis días, Jesús toma a Pedro, y a Jacobo, y a Juan su hermano, y los lleva aparte a un monte alto:", "words": [[0, 300], [2, 424], [10, 684], [13, 904], [18, 1244], [24, 1684], [30, 2324], [35, 3104], [37, 3264], [44, 3644], [46, 4244], [48, 4304], [56, 5104], [58, 5404], [60, 5484], [65, 5764], [68, 6084], [77, 6784], [79, 6924], [83, 7084], [89, 7344], [96, 8144], [98, 8284], [101, 8464], [107, 8884]]}, {"verse": 2, "start": 9949, "end": 18410, "text": "Y se transfiguró delante de ellos; y resplandeció su rostro como el sol, y sus vestidos fueron blancos como la luz.", "words": [[0, 9949], [2, 10036], [5, 10176], [17, 10976], [25, 11356], [28, 11556], [35, 12381], [37, 12543], [50, 13563], [53, 13743], [60, 14323], [65, 14563], [68, 14763], [73, 15083], [75, 15468], [79, 15648], [88, 16248], [95, 16588], [103, 17348], [108, 17648], [111, 17868]]}, {"verse": 3, "start": 18760, "end": 23974, "text": "Y he aquí les aparecieron Moisés y Elías, hablando con él.", "words": [[0, 18760], [2, 19073], [5, 19373], [10, 19793], [14, 20213], [26, 21013], [33, 21553], [35, 21953], [42, 22793], [51, 23113], [55, 23533]]}, {"verse": 4, "start": 24324, "end": 35987, "text": "Y respondiendo Pedro, dijo a Jesús: Señor, bien es que nos quedemos aquí: si quieres, hagamos aquí tres refugios: para ti uno, y para Moisés otro, y otro para Elías.", "words": [[0, 24324], [2, 24447], [15, 25187], [22, 26027], [27, 26487], [29, 26687], [36, 27337], [43, 27618], [48, 28398], [51, 28518], [55, 28638], [59, 28778], [68, 29178], [74, 29856], [77, 30014], [86, 30334], [94, 30974], [99, 31194], [104, 31474], [114, 32516], [119, 32660], [122, 32880], [127, 33180], [129, 33540], [134, 33720], [141, 34060], [147, 34440], [149, 34860], [154, 35100], [159, 35360]]}, {"verse": 5, "start": 36267, "end": 48725, "text": "Y estando aún él hablando, he aquí una nube de luz que los cubrió; y he aquí una voz de la nube, que dijo: Este es mi Hijo amado, en el cual tengo mi agrado: a él oíd.", "words": [[0, 36267], [2, 36393], [10, 36893], [14, 37173], [17, 37393], [27, 38003], [30, 38613], [35, 38853], [39, 39053], [44, 39493], [47, 39653], [51, 39913], [55, 40108], [59, 40248], [67, 41149], [69, 41272], [72, 41422], [77, 41682], [81, 41922], [85, 42242], [88, 42442], [91, 42562], [97, 42922], [101, 43122], [107, 43892], [112, 44216], [115, 44456], [118, 44636], [123, 44876], [130, 45596], [133, 45696], [136, 45796], [141, 45996], [147, 46376], [150, 46596], [158, 47597], [160, 47772], [163, 48122]]}, {"verse": 6, "start": 49005, "end": 54952, "text": "Y oyendo esto los discípulos, cayeron sobre sus rostros, y temieron en gran manera.", "words": [[0, 49005], [2, 49167], [9, 49567], [14, 49867], [18, 50067], [30, 50847], [38, 51747], [44, 52007], [48, 52267], [57, 52967], [59, 53347], [68, 53847], [71, 54067], [76, 54267]]}, {"verse": 7, "start": 55302, "end": 60880, "text": "Entonces Jesús llegando, los tocó, y dijo: Levantaos, y no temáis.", "words": [[0, 55302], [9, 55832], [15, 56325], [25, 56819], [29, 57312], [35, 57972], [37, 58172], [43, 58901], [54, 59728], [56, 59948], [59, 60068]]}, {"verse": 8, "start": 61230, "end": 65797, "text": "Y alzando ellos sus ojos, a nadie vieron, sino a solo Jesús.", "words": [[0, 61230], [2, 61350], [10, 61870], [16, 62090], [20, 62390], [26, 62770], [28, 63210], [34, 63530], [42, 64470], [47, 64690], [49, 64890], [54, 65050]]}, {"verse": 9, "start": 66147, "end": 76474, "text": "Y como descendieron del monte, les mandó Jesús, diciendo: No digáis a nadie la visión, hasta que el Hijo del hombre resucite de los muertos.", "words": [[0, 66147], [2, 66257], [7, 66537], [20, 67277], [24, 67497], [31, 68517], [35, 68617], [41, 68977], [48, 69457], [58, 70618], [61, 70947], [68, 71307], [70, 71467], [76, 71767], [79, 71987], [87, 72747], [93, 73287], [97, 73507], [100, 73687], [105, 73947], [109, 74107], [116, 74547], [125, 75447], [128, 75587], [132, 75727]]}, {"verse": 10, "start": 76824, "end": 84861, "text": "Entonces sus discípulos le preguntaron, diciendo: ¿Por qué dicen pues los escribas que es necesario que Elías venga primero?", "words": [[0, 76824], [9, 77682], [13, 77902], [24, 78642], [27, 78942], [40, 79742], [50, 81015], [55, 81150], [59, 81310], [65, 81610], [70, 81830], [74, 82010], [83, 82570], [87, 82730], [90, 82850], [100, 83410], [104, 83650], [110, 84030], [116, 84290]]}, {"verse": 11, "start": 85141, "end": 92829, "text": "Y respondiendo Jesús, les dijo: A la verdad, Elías vendrá primero, y restaurará todas las cosas.", "words": [[0, 85141], [2, 85329], [15, 86389], [22, 86749], [26, 87209], [32, 88082], [34, 88325], [37, 88385], [45, 88885], [51, 89365], [58, 89685], [67, 90185], [69, 90685], [80, 91585], [86, 91845], [90, 92145]]}, {"verse": 12, "start": 93179, "end": 103337, "text": "Pero os digo, que ya vino Elías, y no le conocieron; antes hicieron en él todo lo que quisieron: así también el Hijo del hombre padecerá de ellos.", "words": [[0, 93179], [5, 93441], [8, 93581], [14, 93761], [18, 93961], [21, 94141], [26, 94321], [33, 94981], [35, 95421], [38, 95561], [41, 95681], [53, 96631], [59, 97058], [68, 97778], [71, 97958], [74, 98178], [79, 98658], [82, 98938], [86, 99058], [97, 100045], [101, 100346], [109, 100766], [112, 101066], [117, 101346], [121, 101486], [128, 101906], [137, 102586], [140, 102726]]}, {"verse": 13, "start": 103687, "end": 108081, "text": "Los discípulos entonces entendieron, que les habló de Juan el Bautista.", "words": [[0, 103687], [4, 103932], [15, 104592], [24, 105092], [37, 106012], [41, 106247], [45, 106387], [51, 106787], [54, 106867], [59, 107107], [62, 107307]]}, {"verse": 14, "start": 108431, "end": 114854, "text": "Y como ellos llegaron al gentío, vino a él un hombre arrodillándose ante él,", "words": [[0, 108431], [2, 108558], [7, 108818], [13, 109078], [22, 109598], [25, 109778], [33, 110938], [38, 111478], [40, 111718], [43, 112018], [46, 112318], [53, 113025], [68, 113731], [73, 114438]]}, {"verse": 15, "start": 115204, "end": 124292, "text": "Y diciendo: Señor, ten misericordia de mi hijo, que sufre convulsiones y padece mucho; porque muchas veces cae en el fuego, y muchas en el agua.", "words": [[0, 115204], [2, 115351], [12, 116282], [19, 116733], [23, 116833], [36, 117593], [39, 117713], [42, 117873], [48, 118413], [52, 118713], [58, 119073], [71, 119813], [73, 119993], [80, 120333], [87, 121109], [94, 121276], [101, 121576], [107, 121876], [111, 122176], [114, 122476], [117, 122596], [124, 122876], [126, 123236], [133, 123536], [136, 123756], [139, 123896]]}, {"verse": 16, "start": 124642, "end": 127989, "text": "Y le he presentado a tus discípulos, y no le han podido sanar.", "words": [[0, 124642], [2, 124786], [5, 124886], [8, 125006], [19, 125626], [21, 125746], [25, 125886], [37, 126526], [39, 126721], [42, 126901], [45, 127041], [49, 127161], [56, 127521]]}, {"verse": 17, "start": 128269, "end": 139690, "text": "Y respondiendo Jesús, dijo: ¡Oh generación incrédula y perversa! ¿hasta cuándo tengo de estar con vosotros? ¿hasta cuándo os tengo de sufrir? traédmele acá.", "words": [[0, 128269], [2, 128386], [15, 129126], [22, 129546], [28, 130896], [32, 130976], [43, 131656], [53, 132496], [55, 132636], [65, 133745], [72, 134065], [79, 134305], [85, 134745], [88, 134965], [94, 135205], [98, 135465], [108, 136578], [115, 136764], [122, 136904], [125, 137044], [131, 137484], [134, 137664], [142, 138573], [152, 139177]]}, {"verse": 18, "start": 140040, "end": 146857, "text": "Y Jesús le reprendió, y salió el demonio de él; y el muchacho fue sano desde aquella hora.", "words": [[0, 140040], [2, 140166], [8, 140506], [11, 140966], [22, 141726], [24, 142166], [30, 142626], [33, 142886], [41, 143426], [44, 143566], [48, 144210], [50, 144375], [53, 144575], [62, 145115], [66, 145335], [71, 145755], [77, 145995], [85, 146375]]}, {"verse": 19, "start": 147207, "end": 154710, "text": "Entonces, viniendo los discípulos a Jesús, aparte, dijeron: ¿Por qué nosotros no lo pudimos echar fuera?", "words": [[0, 147207], [10, 148328], [19, 148928], [23, 149088], [34, 149688], [36, 149848], [43, 150528], [51, 151388], [60, 152254], [65, 152398], [69, 152598], [78, 152978], [81, 153278], [84, 153398], [92, 153858], [98, 154158]]}, {"verse": 20, "start": 154990, "end": 168076, "text": "Y Jesús les dijo: Por vuestra poca fe; porque de cierto os digo, que si tenéis fe como un grano de mostaza, diréis a este monte: Pásate de aquí allá: y se pasará: y nada os será imposible.", "words": [[0, 154990], [2, 155113], [8, 155433], [12, 155693], [18, 156495], [22, 156657], [30, 156977], [35, 157337], [39, 157895], [46, 158079], [49, 158239], [56, 158479], [59, 158859], [65, 159099], [69, 159279], [72, 159419], [79, 159839], [82, 160099], [87, 160399], [90, 160559], [96, 160919], [99, 161059], [108, 161659], [115, 162399], [117, 162559], [122, 162779], [129, 163623], [136, 164012], [139, 164192], [144, 164600], [150, 165177], [152, 165284], [155, 165404], [163, 166350], [165, 166478], [170, 166728], [173, 166978], [178, 167158]]}, {"verse": 21, "start": 168426, "end": 171670, "text": "Pero esta clase no sale sino por oración y ayuno.", "words": [[0, 168426], [5, 168569], [10, 168809], [16, 169209], [19, 169429], [24, 169669], [29, 169949], [33, 170209], [41, 170709], [43, 171009]]}, {"verse": 22, "start": 172020, "end": 178489, "text": "Y estando ellos en Galilea, Jesús les dijo: El Hijo del hombre será entregado en manos de hombres,", "words": [[0, 172020], [2, 172163], [10, 172583], [16, 172843], [19, 173103], [28, 173983], [34, 174263], [38, 174643], [44, 175398], [47, 175558], [52, 175758], [56, 175938], [63, 176278], [68, 176578], [78, 177258], [81, 177378], [87, 177598], [90, 177818]]}, {"verse": 23, "start": 178839, "end": 184926, "text": "Y le matarán; pero al tercer día resucitará. Y ellos se entristecieron en gran manera.", "words": [[0, 178839], [2, 179156], [5, 179505], [14, 180018], [19, 180143], [22, 180303], [29, 180543], [33, 180963], [45, 182261], [47, 182427], [53, 182647], [56, 182907], [71, 183967], [74, 184087], [79, 184267]]}, {"verse": 24, "start": 185276, "end": 193748, "text": "Y cuando llegaron a Capernaum, vinieron a Pedro los que cobraban las dos dracmas, y dijeron: ¿Vuestro Maestro no paga las dos dracmas?", "words": [[0, 185276], [2, 185356], [9, 185516], [18, 186036], [20, 186176], [31, 186976], [40, 187736], [42, 187896], [48, 188196], [52, 188416], [56, 188556], [65, 189136], [69, 189316], [73, 189496], [82, 190016], [84, 190176], [93, 191184], [102, 191565], [110, 192085], [113, 192265], [118, 192665], [122, 192845], [126, 193065]]}, {"verse": 25, "start": 194028, "end": 208897, "text": "Él dice: Sí. Y entrando él en casa, Jesús le habló antes, diciendo: ¿Qué te parece, Simón? Los reyes de la tierra, ¿de quién cobran los tributos o el censo? ¿de sus hijos o de los extraños?", "words": [[0, 194028], [3, 194232], [9, 195102], [13, 195543], [15, 195702], [24, 196262], [27, 196602], [30, 196762], [36, 197682], [42, 198122], [45, 198522], [51, 198842], [58, 199242], [68, 200473], [73, 200578], [76, 200738], [84, 201198], [91, 201997], [95, 202122], [101, 202482], [104, 202642], [107, 202742], [115, 203422], [119, 203682], [125, 203882], [132, 204482], [136, 204622], [145, 205262], [147, 205382], [150, 205804], [157, 206445], [161, 206685], [165, 206885], [171, 207245], [173, 207705], [176, 207765], [180, 207905]]}, {"verse": 26, "start": 209247, "end": 215507, "text": "Pedro le dice: De los extraños. Jesús le dijo: Luego los hijos son exentos.", "words": [[0, 209247], [6, 209512], [9, 209732], [15, 210454], [18, 210594], [22, 210694], [32, 211836], [38, 212251], [41, 212751], [47, 213507], [53, 213735], [57, 214035], [63, 214315], [67, 214595]]}, {"verse": 27, "start": 215857, "end": 230442, "text": "Pero porque no los ofendamos, ve al mar, y echa el anzuelo, y el primer pez que saques, tómalo, y al abrirle la boca, hallarás una moneda de cuatro dracmas: tómala, y dásela por mí y por ti.", "words": [[0, 215857], [5, 216021], [12, 216341], [15, 216541], [19, 216741], [30, 217881], [33, 218161], [36, 218481], [41, 218801], [43, 219046], [48, 219426], [51, 219646], [60, 220406], [62, 220546], [65, 220706], [72, 221006], [76, 221386], [80, 221466], [88, 222366], [96, 223006], [98, 223266], [101, 223386], [109, 223926], [112, 224066], [118, 224746], [127, 225306], [131, 225506], [138, 225986], [141, 226146], [148, 226506], [157, 227663], [165, 228269], [167, 228729], [174, 229229], [178, 229409], [181, 229609], [183, 229869], [187, 230049]]}]}