{"book": "1CO", "chapter": 16, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 147495, "verses": [{"verse": 1, "start": 300, "end": 6984, "text": "Cuanto a la colecta para los santos, haced vosotros también de la manera que ordené en las iglesias de Galacia.", "words": [[0, 300], [7, 558], [9, 698], [12, 798], [20, 1358], [25, 1538], [29, 1718], [37, 2598], [43, 2898], [52, 3478], [60, 3878], [63, 4238], [66, 4358], [73, 4658], [77, 4918], [84, 5418], [87, 5478], [91, 5638], [100, 6198], [103, 6318]]}, {"verse": 2, "start": 7434, "end": 17124, "text": "Cada primer día de la semana cada uno de vosotros aparte en su casa, guardando lo que por la bondad de Dios pueda; para que cuando yo llegue, no se hagan entonces colectas.", "words": [[0, 7434], [5, 7588], [12, 7868], [16, 8148], [19, 8268], [22, 8388], [29, 8808], [34, 9068], [38, 9308], [41, 9448], [50, 9888], [57, 10408], [60, 10488], [63, 10608], [69, 11308], [79, 11868], [82, 12028], [86, 12168], [90, 12348], [93, 12488], [100, 12888], [103, 13008], [108, 13168], [115, 14029], [120, 14187], [124, 14327], [131, 14547], [134, 14787], [142, 15247], [145, 15427], [148, 15607], [154, 15907], [163, 16187]]}, {"verse": 3, "start": 17574, "end": 24343, "text": "Y cuando haya llegado, los que aprobéis por cartas, a estos enviaré que lleven vuestra ofrenda a Jerusalén.", "words": [[0, 17574], [2, 17683], [9, 17883], [14, 18263], [23, 18883], [27, 19223], [31, 19423], [40, 19943], [44, 20123], [52, 21303], [54, 21403], [60, 21603], [68, 22203], [72, 22343], [79, 22643], [87, 23003], [95, 23463], [97, 23583]]}, {"verse": 4, "start": 24793, "end": 29152, "text": "Y si es conveniente que yo también vaya, irán conmigo.", "words": [[0, 24793], [2, 24912], [5, 25052], [8, 25192], [20, 25732], [24, 25872], [27, 26012], [35, 26272], [41, 27372], [46, 27592]]}, {"verse": 5, "start": 29602, "end": 35069, "text": "Y a vosotros iré, cuando haya pasado por Macedonia, porque por Macedonia tengo que pasar:", "words": [[0, 29602], [2, 29723], [4, 29783], [13, 30223], [18, 30963], [25, 31203], [30, 31463], [37, 31863], [41, 32443], [52, 33023], [59, 33303], [63, 33703], [73, 34103], [79, 34343], [83, 34523]]}, {"verse": 6, "start": 35519, "end": 41515, "text": "Y podrá ser que me quede con vosotros, o invernaré también, para que vosotros me llevéis a donde haya de ir.", "words": [[0, 35519], [2, 35608], [8, 35948], [12, 36088], [16, 36268], [19, 36388], [25, 36648], [29, 36868], [39, 37428], [41, 37848], [51, 38408], [60, 38828], [65, 39348], [69, 39488], [78, 39928], [81, 40108], [89, 40468], [91, 40608], [97, 40768], [102, 41048], [105, 41268]]}, {"verse": 7, "start": 41965, "end": 48202, "text": "Porque no os quiero ahora ver de paso; porque espero estar con vosotros algún tiempo, si el Señor lo permite.", "words": [[0, 41965], [7, 42151], [10, 42371], [13, 42491], [20, 42751], [26, 43011], [30, 43231], [33, 43351], [39, 44125], [46, 44350], [53, 44730], [59, 44990], [63, 45270], [72, 45730], [78, 46050], [86, 46890], [89, 47050], [92, 47150], [98, 47390], [101, 47610]]}, {"verse": 8, "start": 48652, "end": 51076, "text": "Pero estaré en Éfeso hasta Pentecostés;", "words": [[0, 48652], [5, 48871], [12, 49311], [15, 49571], [21, 49831], [27, 50051]]}, {"verse": 9, "start": 51526, "end": 56055, "text": "Porque se me ha abierto puerta grande y eficaz, y muchos son los adversarios.", "words": [[0, 51526], [7, 51721], [10, 51921], [13, 52061], [16, 52181], [24, 52461], [31, 52741], [38, 53221], [40, 53401], [48, 54081], [50, 54321], [57, 54601], [61, 54881], [65, 55021]]}, {"verse": 10, "start": 56505, "end": 63250, "text": "Y si llega Timoteo, mirad que esté con vosotros sin temor; porque la obra del Señor hace también como yo.", "words": [[0, 56505], [2, 56612], [5, 56712], [11, 56992], [20, 58172], [26, 58532], [30, 58672], [35, 58892], [39, 59132], [48, 59572], [52, 59832], [59, 60603], [66, 60785], [69, 60985], [74, 61265], [78, 61445], [84, 61825], [89, 62245], [97, 62565], [102, 62865]]}, {"verse": 11, "start": 63700, "end": 70137, "text": "Por tanto, nadie le tenga en poco; antes, llevadlo en paz, para que venga a mí: porque lo espero con los hermanos.", "words": [[0, 63700], [4, 63823], [11, 64083], [17, 64423], [20, 64623], [26, 64843], [29, 65023], [35, 65748], [42, 66138], [51, 66568], [54, 66648], [59, 66928], [64, 67488], [68, 67628], [74, 67948], [76, 68028], [80, 68578], [87, 68744], [90, 68904], [97, 69144], [101, 69384], [105, 69504]]}, {"verse": 12, "start": 70587, "end": 80559, "text": "Acerca del hermano Apolos, mucho le he rogado que fuese a vosotros con los hermanos; pero en ninguna manera tuvo voluntad de ir por ahora; pero irá cuando tenga oportunidad.", "words": [[0, 70587], [7, 71009], [11, 71169], [19, 71569], [27, 72309], [33, 72509], [36, 72689], [39, 72809], [46, 73109], [50, 73289], [56, 73609], [58, 73709], [67, 74129], [71, 74349], [75, 74489], [85, 75409], [90, 75567], [93, 75707], [101, 76027], [108, 76507], [113, 76807], [122, 77487], [125, 77627], [128, 77787], [132, 78007], [139, 78760], [144, 78902], [148, 79162], [155, 79322], [161, 79702]]}, {"verse": 13, "start": 81009, "end": 85560, "text": "Velad, estad firmes en la fe; portaos varonilmente, y esforzaos.", "words": [[0, 81248], [7, 81528], [13, 81808], [20, 82208], [23, 82328], [26, 82468], [30, 83112], [38, 83733], [52, 84393], [54, 85008]]}, {"verse": 14, "start": 86010, "end": 88309, "text": "Todas vuestras cosas sean hechas con amor.", "words": [[0, 86010], [6, 86191], [15, 86711], [21, 87031], [26, 87351], [33, 87651], [37, 87871]]}, {"verse": 15, "start": 88759, "end": 96227, "text": "Y os ruego, hermanos, (ya sabéis que la casa de Estéfanas es las primicias de Acaya, y que se han dedicado al ministerio de los santos,)", "words": [[0, 88759], [2, 88881], [5, 89021], [12, 89321], [22, 90201], [26, 90261], [33, 90581], [37, 90701], [40, 90821], [45, 91061], [48, 91241], [58, 91881], [61, 92141], [65, 92281], [75, 92801], [78, 92981], [85, 93381], [87, 93861], [91, 93981], [94, 94121], [98, 94221], [107, 94721], [110, 94821], [121, 95401], [124, 95461], [128, 95621]]}, {"verse": 16, "start": 96677, "end": 100838, "text": "Que vosotros os sujetéis a los tales, y a todos los que ayudan y trabajan.", "words": [[0, 96677], [4, 96778], [13, 97258], [16, 97438], [25, 97998], [27, 98138], [31, 98258], [38, 98598], [40, 98998], [42, 99078], [48, 99278], [52, 99538], [56, 99738], [63, 100138], [65, 100198]]}, {"verse": 17, "start": 101288, "end": 108560, "text": "Me alegro de la llegada de Estéfanas y de Fortunato y de Acaico: porque estos suplieron lo que a vosotros faltaba.", "words": [[0, 101288], [3, 101414], [10, 101754], [13, 101874], [16, 101974], [24, 102354], [27, 102724], [37, 103094], [39, 103194], [42, 103294], [52, 103874], [54, 104014], [57, 104114], [65, 106104], [72, 106331], [78, 106591], [88, 107171], [91, 107291], [95, 107411], [97, 107491], [106, 107871]]}, {"verse": 18, "start": 109010, "end": 113410, "text": "Porque reconfortaron mi espíritu y el vuestro: reconoced pues a los tales.", "words": [[0, 109010], [7, 109192], [21, 110012], [24, 110192], [33, 110712], [35, 110792], [38, 110892], [47, 111990], [57, 112300], [62, 112520], [64, 112740], [68, 112840]]}, {"verse": 19, "start": 113860, "end": 120754, "text": "Las iglesias de Asia os saludan. Os saludan mucho en el Señor Aquila y Priscila, con la iglesia que está en su casa.", "words": [[0, 113860], [4, 113979], [13, 114499], [16, 114679], [21, 114919], [24, 115159], [33, 116003], [36, 116106], [44, 116606], [50, 116886], [53, 117046], [56, 117146], [62, 117386], [69, 117906], [71, 118006], [81, 118666], [85, 119106], [88, 119246], [96, 119606], [100, 119806], [105, 120006], [108, 120126], [111, 120226]]}, {"verse": 20, "start": 121204, "end": 125960, "text": "Os saludan todos los hermanos. Saludaos los unos a los otros con beso santo.", "words": [[0, 121227], [3, 121287], [11, 121767], [17, 121947], [21, 122187], [31, 123151], [40, 123749], [44, 123889], [49, 124149], [51, 124369], [55, 124509], [61, 124809], [65, 125129], [70, 125449]]}, {"verse": 21, "start": 126410, "end": 128469, "text": "El saludo de mí, Pablo, de mi mano.", "words": [[0, 126450], [3, 126530], [10, 126930], [13, 127110], [17, 127490], [24, 127870], [27, 127950], [30, 128050]]}, {"verse": 22, "start": 128919, "end": 133252, "text": "El que no ame al Señor Jesucristo, quede bajo maldición. Maranatha.", "words": [[0, 128919], [3, 129041], [7, 129161], [10, 129361], [14, 129641], [17, 129741], [23, 129961], [35, 130474], [41, 130988], [46, 131501], [57, 132909]]}, {"verse": 23, "start": 133702, "end": 136602, "text": "La gracia del Señor Jesucristo sea con vosotros.", "words": [[0, 133702], [3, 133960], [10, 134360], [14, 134480], [20, 134740], [31, 135500], [35, 135700], [39, 135920]]}, {"verse": 24, "start": 137052, "end": 147095, "text": "Mi amor en Cristo Jesús sea con todos vosotros. Amén. La primera a los Corintios fue enviada de Filipos con Estéfanas, y Fortunato, y Acaico, y Timoteo.", "words": [[0, 137052], [3, 137172], [8, 137372], [11, 137552], [18, 137912], [24, 138312], [28, 138692], [32, 138932], [38, 139192], [48, 140442], [54, 141219], [57, 141339], [65, 141659], [67, 141819], [71, 141919], [81, 142439], [85, 142639], [93, 143059], [96, 143239], [104, 143719], [108, 143899], [119, 144679], [121, 144839], [132, 145499], [134, 145739], [142, 146219], [144, 146419]]}]}