{"book": "PSA", "chapter": 48, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 95069, "verses": [{"verse": 1, "start": 300, "end": 11443, "text": "Canción: Salmo de los hijos de Coré. GRANDE es Jehová y digno de ser en gran manera alabado, en la ciudad de nuestro Dios, en el monte de su santuario.", "words": [[0, 300], [9, 1377], [15, 1858], [18, 1978], [22, 2098], [28, 2418], [31, 2825], [37, 3532], [44, 3758], [47, 4018], [54, 4678], [56, 4778], [62, 5298], [65, 5378], [69, 5678], [72, 5978], [77, 6218], [84, 6618], [93, 7498], [96, 7998], [99, 8158], [106, 8458], [109, 8778], [117, 8958], [123, 9458], [126, 9778], [129, 9898], [135, 10198], [138, 10418], [141, 10558]]}, {"verse": 2, "start": 11893, "end": 20042, "text": "Hermosa provincia, el gozo de toda la tierra es el monte de Sion, a los lados del norte, la ciudad del gran Rey.", "words": [[0, 11893], [8, 12341], [19, 12851], [22, 13361], [27, 13681], [30, 13841], [35, 14081], [38, 14321], [45, 14641], [48, 15021], [51, 15181], [57, 15481], [60, 16091], [66, 16701], [68, 16781], [72, 16921], [78, 17221], [82, 17481], [89, 18421], [92, 18521], [99, 18917], [103, 19313], [108, 19708]]}, {"verse": 3, "start": 20492, "end": 23746, "text": "Dios en sus palacios es conocido por refugio.", "words": [[0, 20492], [5, 20840], [8, 21200], [12, 21420], [21, 22060], [24, 22180], [33, 22780], [37, 23000]]}, {"verse": 4, "start": 24196, "end": 28562, "text": "Porque he aquí los reyes de la tierra se reunieron; pasaron todos.", "words": [[0, 24196], [7, 24303], [10, 24443], [15, 24683], [19, 25043], [25, 25383], [28, 25523], [31, 25623], [38, 25963], [41, 26143], [52, 27300], [60, 27702]]}, {"verse": 5, "start": 29012, "end": 34652, "text": "Y viéndola ellos así, se maravillaron, se turbaron, se dieron prisa a huir.", "words": [[0, 29012], [2, 29137], [11, 29617], [17, 29957], [22, 30757], [25, 30917], [39, 31977], [42, 32057], [52, 32857], [55, 32957], [62, 33277], [68, 33817], [70, 34235]]}, {"verse": 6, "start": 35102, "end": 38819, "text": "Los tomó allí temblor; dolor, como a mujer que pare.", "words": [[0, 35102], [4, 35462], [9, 35822], [14, 36182], [23, 36797], [30, 37141], [35, 37601], [37, 37761], [43, 38021], [47, 38261]]}, {"verse": 7, "start": 39269, "end": 43384, "text": "Con viento solano quiebras tú las naves de Tarsis.", "words": [[0, 39269], [4, 39394], [11, 39894], [18, 40444], [27, 40994], [30, 41294], [34, 41774], [40, 42334], [43, 42594]]}, {"verse": 8, "start": 43834, "end": 53804, "text": "Como lo oímos, así hemos visto en la ciudad de Jehová de los ejércitos, en la ciudad de nuestro Dios: la afirmará Dios para siempre. (Selah.)", "words": [[0, 43834], [5, 44018], [8, 44238], [15, 44798], [19, 45238], [25, 45398], [31, 45778], [34, 45938], [37, 46078], [44, 46358], [47, 46658], [54, 47098], [57, 47178], [61, 47318], [72, 48518], [75, 48658], [78, 48818], [85, 49158], [88, 49498], [96, 49658], [102, 50704], [105, 50894], [114, 51554], [119, 51814], [124, 52154], [133, 53542]]}, {"verse": 9, "start": 54254, "end": 58737, "text": "Esperamos tu misericordia, oh Dios, en medio de tu templo.", "words": [[0, 54254], [10, 54875], [13, 55095], [27, 55705], [30, 56315], [36, 56595], [39, 57235], [45, 57595], [48, 57835], [51, 57995]]}, {"verse": 10, "start": 59187, "end": 67512, "text": "Conforme a tu nombre, oh Dios, así es tu alabanza hasta los fines de la tierra: de justicia está llena tu diestra.", "words": [[0, 59187], [9, 59771], [11, 59811], [14, 59911], [22, 60871], [25, 61171], [31, 61891], [35, 62131], [38, 62311], [41, 62511], [50, 63231], [56, 63531], [60, 63731], [66, 64051], [69, 64251], [72, 64371], [80, 65338], [83, 65447], [92, 65987], [97, 66227], [103, 66607], [106, 66767]]}, {"verse": 11, "start": 67962, "end": 73483, "text": "Se alegrará el monte de Sion; se gozarán las hijas de Judá por tus juicios.", "words": [[0, 67962], [3, 68126], [12, 68726], [15, 68986], [21, 69326], [24, 69506], [30, 70462], [33, 70601], [41, 71121], [45, 71301], [51, 71741], [54, 71941], [59, 72361], [63, 72561], [67, 72761]]}, {"verse": 12, "start": 73933, "end": 78636, "text": "Andad alrededor de Sion, y rodeadla: contad sus torres.", "words": [[0, 73933], [6, 74389], [16, 74809], [19, 75329], [25, 75669], [27, 75909], [37, 77108], [44, 77615], [48, 78125]]}, {"verse": 13, "start": 79086, "end": 86261, "text": "Poned vuestro corazón a sus murallas, mirad sus palacios; para que lo contéis a la generación venidera.", "words": [[0, 79086], [6, 79410], [14, 79790], [22, 80210], [24, 80550], [28, 80750], [38, 81750], [44, 82110], [48, 82350], [58, 83661], [63, 83801], [67, 83921], [70, 84041], [78, 84581], [80, 84801], [83, 84901], [94, 85501]]}, {"verse": 14, "start": 86711, "end": 94669, "text": "Porque este Dios es Dios nuestro eternamente y para siempre: él nos capitaneará hasta la muerte.", "words": [[0, 86711], [7, 86913], [12, 87093], [17, 87393], [20, 87673], [25, 88153], [33, 89193], [45, 90433], [47, 90573], [52, 90793], [61, 91988], [64, 92333], [68, 92453], [80, 93433], [86, 93773], [89, 93953]]}]}