{"book": "PSA", "chapter": 90, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 115361, "verses": [{"verse": 1, "start": 300, "end": 7188, "text": "Oración de Moisés varón de Dios. SEÑOR, tú nos has sido refugio en generación y en generación.", "words": [[0, 300], [8, 742], [11, 962], [18, 1642], [24, 1922], [27, 2042], [33, 2870], [40, 3588], [43, 3708], [47, 3878], [51, 4048], [56, 4328], [64, 5028], [67, 5188], [78, 5948], [80, 6188], [83, 6368]]}, {"verse": 2, "start": 7538, "end": 15251, "text": "Antes que naciesen los montes, y formases la tierra y el mundo, y desde el siglo y hasta el siglo, tú eres Dios.", "words": [[0, 7538], [6, 7820], [10, 8000], [19, 8440], [23, 8680], [31, 9180], [33, 9520], [42, 9860], [45, 10120], [52, 10520], [54, 10820], [57, 10960], [64, 11300], [66, 11740], [72, 11980], [75, 12280], [81, 12780], [83, 13000], [89, 13180], [92, 13400], [99, 13780], [102, 14280], [107, 14640]]}, {"verse": 3, "start": 15601, "end": 21431, "text": "Vuelves al hombre hasta ser quebrantado, y dices: Convertíos, hijos de los hombres.", "words": [[0, 15601], [8, 16066], [11, 16246], [18, 16526], [24, 16726], [28, 17046], [41, 17846], [43, 17966], [50, 19149], [62, 19549], [68, 20149], [71, 20429], [75, 20549]]}, {"verse": 4, "start": 21711, "end": 29109, "text": "Porque mil años delante de tus ojos, son como el día de ayer, que pasó, y como una de las vigilias de la noche.", "words": [[0, 21711], [7, 21947], [11, 22228], [16, 22627], [24, 23147], [27, 23327], [31, 23487], [37, 23908], [41, 24567], [46, 24847], [49, 25047], [53, 25268], [56, 25428], [62, 25748], [66, 25947], [72, 26368], [74, 26827], [79, 27107], [83, 27447], [86, 27588], [90, 27728], [99, 28287], [102, 28387], [105, 28507]]}, {"verse": 5, "start": 29459, "end": 36310, "text": "Los haces pasar como avenida de aguas; son como sueño; como la hierba que crece en la mañana:", "words": [[0, 29459], [4, 29585], [10, 30005], [16, 30365], [21, 30745], [29, 31325], [32, 31485], [39, 32276], [43, 32502], [48, 32802], [55, 33741], [60, 34068], [63, 34228], [70, 34648], [74, 34808], [80, 35308], [83, 35468], [86, 35588]]}, {"verse": 6, "start": 36660, "end": 41544, "text": "En la mañana florece y crece; a la tarde es cortada, y se seca.", "words": [[0, 36660], [3, 36797], [6, 36877], [13, 37177], [21, 37917], [23, 38137], [30, 39054], [32, 39175], [35, 39255], [41, 39555], [44, 39835], [53, 40535], [55, 40735], [58, 40875]]}, {"verse": 7, "start": 41894, "end": 46443, "text": "Porque con tu furor somos consumidos, y con tu ira somos turbados.", "words": [[0, 41894], [7, 42118], [11, 42378], [14, 42518], [20, 42978], [26, 43258], [38, 44158], [40, 44538], [44, 44758], [47, 44978], [51, 45198], [57, 45498]]}, {"verse": 8, "start": 46793, "end": 52537, "text": "Pusiste nuestras maldades delante de ti, nuestros yerros a la luz de tu rostro.", "words": [[0, 46793], [8, 47275], [17, 47495], [26, 48275], [34, 48755], [37, 48915], [41, 49535], [50, 49795], [57, 50515], [59, 50835], [62, 50935], [66, 51235], [69, 51715], [72, 51875]]}, {"verse": 9, "start": 52887, "end": 58903, "text": "Porque todos nuestros días declinan a causa de tu ira; acabamos nuestros años como un pensamiento.", "words": [[0, 52887], [7, 53205], [13, 53545], [22, 53885], [27, 54325], [36, 54965], [38, 55065], [44, 55345], [47, 55585], [50, 55765], [55, 56414], [64, 56911], [73, 57191], [78, 57571], [83, 57851], [86, 57991]]}, {"verse": 10, "start": 59253, "end": 70185, "text": "Los días de nuestra edad son setenta años; que si en los más robustos son ochenta años, con todo su fortaleza es molestia y trabajo; porque es cortado pronto, y volamos.", "words": [[0, 59253], [4, 59378], [9, 59598], [12, 59778], [20, 59998], [25, 60358], [29, 60618], [37, 60878], [43, 61883], [47, 61965], [50, 62105], [53, 62205], [57, 62345], [61, 62525], [70, 63105], [74, 63325], [82, 63545], [88, 64385], [92, 64545], [97, 64825], [100, 65045], [110, 65825], [113, 66185], [122, 66785], [124, 66885], [133, 67734], [140, 67959], [143, 68139], [151, 68639], [159, 69099], [161, 69439]]}, {"verse": 11, "start": 70535, "end": 76169, "text": "¿Quién conoce la fortaleza de tu ira, y tu indignación según que debes ser temido?", "words": [[0, 70535], [7, 70716], [14, 71436], [17, 71556], [27, 72276], [30, 72436], [33, 72676], [38, 73076], [40, 73216], [43, 73396], [55, 74196], [61, 74596], [65, 74836], [71, 75076], [75, 75396]]}, {"verse": 12, "start": 76519, "end": 82105, "text": "Enséñanos de tal modo a contar nuestros días, que traigamos al corazón sabiduría.", "words": [[0, 76519], [10, 77445], [13, 77685], [17, 77905], [22, 78245], [24, 78425], [31, 78765], [40, 79065], [46, 79625], [50, 80105], [60, 80665], [63, 80845], [71, 81245]]}, {"verse": 13, "start": 82455, "end": 87654, "text": "Vuélvete, oh Jehová: ¿hasta cuándo? y compadécete de tus siervos.", "words": [[0, 82455], [10, 82979], [13, 83529], [21, 84432], [28, 84597], [36, 85436], [38, 85928], [50, 86458], [53, 86678], [57, 86838]]}, {"verse": 14, "start": 88004, "end": 94327, "text": "Sácianos pronto de tu misericordia: y cantaremos y nos alegraremos todos nuestros días.", "words": [[0, 88293], [9, 88623], [16, 89048], [19, 89348], [22, 89488], [36, 90812], [38, 90936], [49, 91636], [51, 92096], [55, 92236], [67, 92976], [73, 93196], [82, 93496]]}, {"verse": 15, "start": 94677, "end": 99807, "text": "Alégranos conforme a los días que nos afligiste, y los años que vimos mal.", "words": [[0, 94677], [10, 95559], [19, 96339], [21, 96419], [25, 96559], [30, 96819], [34, 96999], [38, 97139], [49, 97879], [51, 98259], [55, 98419], [60, 98699], [64, 98899], [70, 99139]]}, {"verse": 16, "start": 100157, "end": 104749, "text": "Aparezca en tus siervos tu obra, y tu gloria sobre sus hijos.", "words": [[0, 100157], [9, 100901], [12, 101101], [16, 101281], [24, 101881], [27, 102141], [33, 102561], [35, 102836], [38, 103176], [45, 103516], [51, 103796], [55, 104076]]}, {"verse": 17, "start": 105099, "end": 114961, "text": "Y sea la luz de Jehová nuestro Dios sobre nosotros: y ordena en nosotros la obra de nuestras manos, la obra de nuestras manos confirma.", "words": [[0, 105099], [2, 105410], [6, 105690], [9, 105910], [13, 106190], [16, 106450], [23, 106930], [31, 107050], [36, 107470], [42, 107830], [52, 108957], [54, 109118], [61, 109638], [64, 109718], [73, 110258], [76, 110878], [81, 111238], [84, 111418], [93, 111598], [100, 112498], [103, 112778], [108, 113118], [111, 113318], [120, 113518], [126, 113998]]}]}