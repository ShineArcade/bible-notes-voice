{"book": "MRK", "chapter": 15, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 310323, "verses": [{"verse": 1, "start": 300, "end": 11124, "text": "And immediately in the morning the chief priests held a consultation with the elders and scribes and the whole council, and bound Jesus, and carried him away, and delivered him to Pilate.", "words": [[0, 300], [4, 426], [16, 866], [19, 1226], [23, 1326], [31, 1846], [35, 1926], [41, 2166], [49, 2606], [54, 2826], [56, 3046], [69, 3706], [74, 4046], [78, 4206], [85, 4566], [89, 4866], [97, 5466], [101, 5566], [105, 5646], [111, 5846], [120, 6326], [124, 6906], [130, 7206], [137, 7380], [141, 7554], [149, 7728], [153, 7902], [159, 9315], [163, 9835], [173, 10155], [177, 10395], [180, 10794]]}, {"verse": 2, "start": 11574, "end": 18278, "text": "And Pilate asked him, Are you the King of the Jews? And he answering said to him, You say it.", "words": [[0, 11574], [4, 11848], [11, 12158], [17, 12598], [22, 13235], [26, 13370], [30, 13510], [34, 13650], [39, 13850], [42, 14010], [46, 14110], [52, 15029], [56, 15168], [59, 15268], [69, 15688], [74, 16048], [77, 16248], [82, 17481], [86, 17669], [90, 17949]]}, {"verse": 3, "start": 18628, "end": 23261, "text": "And the chief priests accused him of many things: but he answered nothing.", "words": [[0, 18628], [4, 18767], [8, 18867], [14, 19107], [22, 19547], [30, 20127], [34, 20507], [37, 20727], [42, 21007], [50, 22015], [54, 22139], [57, 22259], [66, 22619]]}, {"verse": 4, "start": 23711, "end": 29616, "text": "And Pilate asked him again, saying, Do you answer nothing? behold how many things they witness against you.", "words": [[0, 23711], [4, 24004], [11, 24334], [17, 24594], [21, 24794], [28, 25294], [36, 26136], [39, 26235], [43, 26435], [50, 26695], [59, 27587], [66, 27867], [70, 28087], [75, 28267], [82, 28547], [87, 28687], [95, 28927], [103, 29287]]}, {"verse": 5, "start": 29966, "end": 33564, "text": "But Jesus yet answered nothing; so that Pilate marvelled.", "words": [[0, 29966], [4, 30125], [10, 30485], [14, 30885], [23, 31305], [32, 32195], [35, 32345], [40, 32773], [47, 33202]]}, {"verse": 6, "start": 34014, "end": 38439, "text": "Now at that feast he released to them one prisoner, whomsoever they desired.", "words": [[0, 34014], [4, 34237], [7, 34457], [12, 34597], [18, 34917], [21, 35157], [30, 35517], [33, 35677], [38, 35817], [42, 36077], [52, 36817], [63, 37557], [68, 37757]]}, {"verse": 7, "start": 38889, "end": 47524, "text": "And there was one named Barabbas, which lay bound with them that had made insurrection with him, who had committed murder in the insurrection.", "words": [[0, 38889], [4, 39014], [10, 39134], [14, 39374], [18, 39774], [24, 40174], [34, 41354], [40, 41534], [44, 41834], [50, 42194], [55, 42494], [60, 42754], [65, 43054], [69, 43174], [74, 43394], [87, 44034], [92, 44474], [97, 44674], [101, 45174], [105, 45334], [115, 45714], [122, 46154], [125, 46494], [129, 46614]]}, {"verse": 8, "start": 47974, "end": 52912, "text": "And the multitude crying aloud began to desire him to do as he had ever done to them.", "words": [[0, 47974], [4, 48130], [8, 48210], [18, 48630], [25, 49110], [31, 49610], [37, 50030], [40, 50270], [47, 50610], [51, 50890], [54, 51030], [57, 51290], [60, 51570], [63, 51710], [67, 51830], [72, 52010], [77, 52290], [80, 52430]]}, {"verse": 9, "start": 53362, "end": 58567, "text": "But Pilate answered them, saying, Will you that I release to you the King of the Jews?", "words": [[0, 53362], [4, 53742], [11, 54122], [20, 54442], [26, 54842], [34, 56120], [39, 56240], [43, 56380], [48, 56540], [50, 56760], [58, 57080], [61, 57320], [65, 57460], [69, 57620], [74, 57840], [77, 57980], [81, 58080]]}, {"verse": 10, "start": 58917, "end": 62258, "text": "For he knew that the chief priests had delivered him for envy.", "words": [[0, 58917], [4, 59040], [7, 59260], [12, 59500], [17, 59720], [21, 59860], [27, 60080], [35, 60600], [39, 60840], [49, 61200], [53, 61460], [57, 61660]]}, {"verse": 11, "start": 62708, "end": 67568, "text": "But the chief priests moved the people, that he should rather release Barabbas to them.", "words": [[0, 62708], [4, 62807], [8, 62947], [14, 63167], [22, 63607], [28, 64027], [32, 64287], [40, 64607], [45, 65187], [48, 65327], [55, 65527], [62, 65847], [70, 66267], [79, 66947], [82, 67127]]}, {"verse": 12, "start": 68018, "end": 74602, "text": "And Pilate answered and said again to them, What will you then that I shall do to him whom you call the King of the Jews?", "words": [[0, 68018], [4, 68269], [11, 68539], [20, 69019], [24, 69279], [29, 69499], [35, 69779], [38, 70019], [44, 70641], [49, 70821], [54, 71041], [58, 71181], [63, 71481], [68, 71701], [70, 71841], [76, 72021], [79, 72261], [82, 72421], [86, 72621], [91, 72841], [95, 73001], [100, 73261], [104, 73421], [109, 73681], [112, 73841], [116, 73981]]}, {"verse": 13, "start": 74952, "end": 77977, "text": "And they cried out again, Crucify him.", "words": [[0, 74952], [4, 75078], [9, 75198], [15, 75418], [19, 75638], [26, 77077], [34, 77570]]}, {"verse": 14, "start": 78327, "end": 85564, "text": "Then Pilate said to them, Why, what evil has he done? And they cried out the more exceedingly, Crucify him.", "words": [[0, 78327], [5, 78673], [12, 79023], [17, 79203], [20, 79343], [26, 79945], [31, 80191], [36, 80451], [41, 80651], [45, 80891], [48, 81011], [54, 81698], [58, 81843], [63, 81963], [69, 82303], [73, 82643], [77, 82823], [82, 83083], [95, 84664], [103, 85157]]}, {"verse": 15, "start": 85914, "end": 93201, "text": "¶ And so Pilate, willing to content the people, released Barabbas to them, and delivered Jesus, when he had scourged him, to be crucified.", "words": [[2, 85914], [6, 86065], [9, 86225], [17, 86665], [25, 86845], [28, 87025], [36, 87345], [40, 87545], [48, 88105], [57, 88665], [66, 89305], [69, 89525], [75, 89745], [79, 90245], [89, 90565], [96, 91005], [101, 91345], [104, 91465], [108, 91585], [117, 92045], [122, 92165], [125, 92325], [128, 92465]]}, {"verse": 16, "start": 93651, "end": 99343, "text": "And the soldiers led him away into the hall, called Prætorium; and they call together the whole band.", "words": [[0, 93651], [4, 93967], [8, 94067], [17, 94367], [21, 94667], [25, 94827], [30, 95107], [35, 95307], [39, 95467], [45, 95747], [52, 96409], [63, 97307], [67, 97444], [72, 97564], [77, 97824], [86, 98224], [90, 98464], [96, 98704]]}, {"verse": 17, "start": 99793, "end": 105278, "text": "And they clothed him with purple, and platted a crown of thorns, and put it about his head,", "words": [[0, 99793], [4, 100094], [9, 100214], [17, 100714], [21, 100834], [26, 101014], [34, 101414], [38, 101934], [46, 102454], [48, 102534], [54, 102814], [57, 102994], [65, 103474], [69, 104034], [73, 104214], [76, 104374], [82, 104594], [86, 104814]]}, {"verse": 18, "start": 105728, "end": 108496, "text": "And began to salute him, Hail, King of the Jews!", "words": [[0, 105728], [4, 105853], [10, 106093], [13, 106313], [20, 106613], [25, 107337], [31, 107519], [36, 107759], [39, 107919], [43, 108019]]}, {"verse": 19, "start": 108846, "end": 114995, "text": "And they struck him on the head with a reed, and did spit upon him, and bowing their knees worshipped him.", "words": [[0, 108846], [4, 108998], [9, 109098], [16, 109398], [20, 109598], [23, 109738], [27, 109898], [32, 110138], [37, 110338], [39, 110458], [45, 111218], [49, 111478], [53, 111718], [58, 111978], [63, 112278], [68, 112958], [72, 113118], [79, 113538], [85, 113698], [91, 114018], [102, 114678]]}, {"verse": 20, "start": 115445, "end": 122876, "text": "And when they had mocked him, they took off the purple from him, and put his own clothes on him, and led him out to crucify him.", "words": [[0, 115445], [4, 115576], [9, 115736], [14, 115936], [18, 116076], [25, 116556], [30, 117036], [35, 117236], [40, 117456], [44, 117716], [48, 117896], [55, 118196], [60, 118496], [65, 118736], [69, 119116], [73, 119296], [77, 119476], [81, 119676], [89, 119976], [92, 120336], [97, 120576], [101, 121056], [105, 121276], [109, 121496], [113, 121696], [116, 121876], [124, 122436]]}, {"verse": 21, "start": 123326, "end": 132160, "text": "And they compel one Simon a Cyrenian, who passed by, coming out of the country, the father of Alexander and Rufus, to bear his cross.", "words": [[0, 123326], [4, 123446], [9, 123586], [16, 124146], [20, 124466], [26, 124946], [28, 125436], [38, 125926], [42, 126186], [49, 126566], [53, 126966], [60, 127306], [64, 127586], [67, 127686], [71, 127786], [80, 128706], [84, 128746], [91, 129086], [94, 129326], [104, 129866], [108, 130186], [115, 130726], [118, 131006], [123, 131266], [127, 131466]]}, {"verse": 22, "start": 132610, "end": 138016, "text": "And they bring him to the place Golgotha, which is, being interpreted, The place of a skull.", "words": [[0, 132610], [4, 132744], [9, 132844], [15, 133104], [19, 133284], [22, 133444], [26, 133564], [32, 133804], [42, 134764], [48, 134964], [52, 135464], [58, 135644], [71, 136784], [75, 136924], [81, 137184], [84, 137364], [86, 137464]]}, {"verse": 23, "start": 138466, "end": 143120, "text": "And they gave him to drink wine mingled with myrrh: but he received it not.", "words": [[0, 138466], [4, 138594], [9, 138714], [14, 138954], [18, 139114], [21, 139254], [27, 139534], [32, 139934], [40, 140454], [45, 140851], [52, 141479], [56, 141779], [59, 141899], [68, 142359], [71, 142539]]}, {"verse": 24, "start": 143570, "end": 150055, "text": "And when they had crucified him, they parted his garments, casting lots upon them, what every man should take.", "words": [[0, 143570], [4, 143701], [9, 143861], [14, 144061], [18, 144181], [28, 144601], [33, 145541], [38, 145701], [45, 146101], [49, 146241], [59, 146961], [67, 147321], [72, 147621], [77, 147941], [83, 148661], [88, 148801], [94, 149061], [98, 149301], [105, 149541]]}, {"verse": 25, "start": 150505, "end": 153306, "text": "And it was the third hour, and they crucified him.", "words": [[0, 150505], [4, 150649], [7, 150749], [11, 150909], [15, 151049], [21, 151309], [27, 152009], [31, 152149], [36, 152269], [46, 152649]]}, {"verse": 26, "start": 153756, "end": 158177, "text": "And the inscription of his accusation was written over, THE KING OF THE JEWS.", "words": [[0, 153756], [4, 153903], [8, 153983], [20, 154483], [23, 154723], [27, 154863], [38, 155563], [42, 155783], [50, 156043], [56, 156883], [60, 156983], [65, 157223], [68, 157403], [72, 157523]]}, {"verse": 27, "start": 158627, "end": 163998, "text": "And with him they crucify two thieves; the one on his right hand, and the other on his left.", "words": [[0, 158627], [4, 158752], [9, 158972], [13, 159152], [18, 159312], [26, 159932], [30, 160252], [39, 161263], [43, 161344], [47, 161544], [50, 161684], [54, 161824], [60, 162024], [66, 162424], [70, 162764], [74, 162904], [80, 163084], [83, 163304], [87, 163424]]}, {"verse": 28, "start": 164448, "end": 168829, "text": "And the scripture was fulfilled, which says, And he was numbered with the transgressors.", "words": [[0, 164448], [4, 164601], [8, 164681], [18, 164961], [22, 165241], [33, 165861], [39, 166001], [45, 166641], [49, 166901], [52, 167001], [56, 167141], [65, 167441], [70, 167701], [74, 167801]]}, {"verse": 29, "start": 169279, "end": 176461, "text": "And they that passed by railed on him, wagging their heads, and saying, Ah, you that destroy the temple, and build it in three days,", "words": [[0, 169279], [4, 169428], [9, 169588], [14, 169748], [21, 170148], [24, 170388], [31, 170868], [34, 170988], [39, 171508], [47, 171868], [53, 172048], [60, 172348], [64, 172548], [72, 173426], [76, 173666], [80, 173906], [85, 174106], [93, 174486], [97, 174646], [105, 175006], [109, 175266], [115, 175526], [118, 175686], [121, 175786], [127, 176006]]}, {"verse": 30, "start": 176911, "end": 179158, "text": "Save yourself, and come down from the cross.", "words": [[0, 176911], [5, 177114], [15, 177494], [19, 177914], [24, 178114], [29, 178354], [34, 178534], [38, 178674]]}, {"verse": 31, "start": 179508, "end": 186597, "text": "Likewise also the chief priests mocking said among themselves with the scribes, He saved others; himself he cannot save.", "words": [[0, 179508], [9, 179794], [14, 180234], [18, 180414], [24, 180614], [32, 181021], [40, 181427], [45, 181834], [51, 182074], [62, 182494], [67, 182774], [71, 182934], [80, 183860], [83, 183980], [89, 184260], [97, 185207], [105, 185555], [108, 185795], [115, 186095]]}, {"verse": 32, "start": 187047, "end": 194423, "text": "Let Christ the King of Israel descend now from the cross, that we may see and believe. And they that were crucified with him reviled him.", "words": [[0, 187047], [4, 187185], [11, 187465], [15, 187665], [20, 187845], [23, 187965], [30, 188345], [38, 188725], [42, 189065], [47, 189285], [51, 189405], [58, 189725], [63, 190145], [66, 190305], [70, 190465], [74, 190705], [78, 190945], [87, 191742], [91, 191895], [96, 192035], [101, 192215], [106, 192375], [116, 192875], [121, 193275], [125, 193415], [133, 194055]]}, {"verse": 33, "start": 194873, "end": 200061, "text": "And when the sixth hour was come, there was darkness over the whole land until the ninth hour.", "words": [[0, 194873], [4, 194992], [9, 195112], [13, 195272], [19, 195512], [24, 195812], [28, 196032], [34, 196812], [40, 196912], [44, 197072], [53, 197512], [58, 197872], [62, 198032], [68, 198252], [73, 198732], [79, 199072], [83, 199252], [89, 199512]]}, {"verse": 34, "start": 200511, "end": 214596, "text": "And at the ninth hour Jesus cried with a loud voice, saying, Eloi, Eloi, lama sabachthani? which is, being interpreted, My God, my God, why have you forsaken me?", "words": [[0, 200511], [4, 200646], [7, 200786], [11, 200886], [17, 201186], [22, 201546], [28, 201766], [34, 202286], [39, 202506], [41, 202626], [46, 202866], [53, 203226], [61, 204010], [67, 204419], [73, 205139], [78, 205754], [89, 207862], [91, 209404], [97, 209550], [101, 209690], [107, 209930], [120, 211019], [123, 211218], [128, 212198], [131, 212418], [136, 213138], [140, 213418], [145, 213638], [149, 213758], [158, 214258]]}, {"verse": 35, "start": 214946, "end": 219493, "text": "And some of them that stood by, when they heard it, said, Behold, he calls Elias.", "words": [[0, 214946], [4, 215052], [9, 215252], [12, 215412], [17, 215552], [22, 215732], [28, 215932], [32, 216292], [37, 216572], [42, 216732], [48, 216952], [52, 217072], [58, 217805], [66, 218360], [69, 218440], [75, 218760]]}, {"verse": 36, "start": 219843, "end": 229718, "text": "And one ran and filled a sponge full of vinegar, and put it on a reed, and gave him to drink, saying, Let alone; let us see whether Elias will come to take him down.", "words": [[0, 219843], [4, 219996], [8, 220276], [12, 220636], [16, 220916], [23, 221136], [25, 221316], [32, 221656], [37, 221976], [40, 222076], [49, 222456], [53, 222996], [57, 223196], [60, 223316], [63, 223456], [65, 223686], [71, 223916], [75, 224296], [80, 224516], [84, 224676], [87, 224776], [94, 225196], [102, 226459], [106, 226685], [113, 227366], [117, 227546], [120, 227686], [124, 227886], [132, 228126], [138, 228606], [143, 228726], [148, 228926], [151, 229066], [156, 229266], [160, 229386]]}, {"verse": 37, "start": 230068, "end": 234182, "text": "And Jesus cried with a loud voice, and breathed his last.", "words": [[0, 230068], [4, 230220], [10, 230540], [16, 231080], [21, 231340], [23, 231480], [28, 231760], [35, 232280], [39, 232800], [48, 233360], [52, 233480]]}, {"verse": 38, "start": 234632, "end": 238407, "text": "And the veil of the temple was torn in two from the top to the bottom.", "words": [[0, 234632], [4, 234759], [8, 234879], [13, 235179], [16, 235319], [20, 235459], [27, 235779], [31, 236039], [36, 236379], [39, 236579], [43, 236839], [48, 237099], [52, 237239], [56, 237539], [59, 237759], [63, 237879]]}, {"verse": 39, "start": 238857, "end": 248128, "text": "¶ And when the centurion, which stood over against him, saw that he so cried out, and breathed his last, he said, Truly this man was the Son of God.", "words": [[2, 238857], [6, 238986], [11, 239146], [15, 239326], [26, 240366], [32, 240646], [38, 240886], [43, 241166], [51, 241626], [56, 242146], [60, 242406], [65, 242586], [68, 242706], [71, 242926], [77, 243246], [82, 244046], [86, 244166], [95, 244606], [99, 244726], [105, 245326], [108, 245406], [114, 246121], [120, 246397], [125, 246717], [129, 246977], [133, 247197], [137, 247357], [141, 247557], [144, 247677]]}, {"verse": 40, "start": 248478, "end": 257932, "text": "There were also women looking on afar off: among whom was Mary Magdalene, and Mary the mother of James the less and of Joses, and Salome;", "words": [[0, 248478], [6, 248569], [11, 248749], [16, 249089], [22, 249449], [30, 249789], [33, 250119], [38, 250449], [43, 251263], [49, 251465], [54, 251845], [58, 252105], [63, 252385], [74, 253385], [78, 253485], [83, 253765], [87, 253925], [94, 254185], [97, 254405], [103, 255085], [107, 255185], [112, 255505], [116, 255765], [119, 255905], [126, 256505], [130, 257252]]}, {"verse": 41, "start": 258382, "end": 265971, "text": "(Who also, when he was in Galilee, followed him, and ministered to him;) and many other women which came up with him to Jerusalem.", "words": [[0, 258382], [5, 258518], [11, 258918], [16, 259138], [19, 259318], [23, 259518], [26, 259698], [35, 260558], [44, 260858], [49, 261178], [53, 261458], [64, 262078], [67, 262218], [73, 262598], [77, 263058], [82, 263298], [88, 263558], [94, 263918], [100, 264218], [105, 264458], [108, 264658], [113, 264838], [117, 264978], [120, 265158]]}, {"verse": 42, "start": 266421, "end": 272697, "text": "¶ And now when the even was come, because it was the preparation, that is, the day before the sabbath,", "words": [[2, 266421], [6, 266575], [10, 267015], [15, 267155], [19, 267335], [24, 267595], [28, 267875], [34, 268575], [42, 268875], [45, 269055], [49, 269175], [53, 269315], [66, 270415], [71, 270655], [75, 270975], [79, 271095], [83, 271295], [90, 271555], [94, 271755]]}, {"verse": 43, "start": 273147, "end": 283158, "text": "Joseph of Arimathaea, an honourable counsellor, which also waited for the kingdom of God, came, and went in boldly to Pilate, and craved the body of Jesus.", "words": [[0, 273147], [7, 273407], [10, 274057], [22, 274707], [25, 275074], [36, 275440], [48, 275807], [54, 276187], [59, 276587], [66, 276947], [70, 277227], [74, 277347], [82, 277627], [85, 277867], [90, 278647], [96, 278947], [100, 279607], [105, 279807], [108, 279967], [115, 280547], [118, 280787], [126, 281027], [130, 281467], [137, 281907], [141, 282047], [146, 282327], [149, 282487]]}, {"verse": 44, "start": 283608, "end": 291169, "text": "And Pilate marvelled if he were already dead: and calling to him the centurion, he asked him whether he had been any while dead.", "words": [[0, 283608], [4, 283995], [11, 284381], [21, 284768], [24, 284868], [27, 285008], [32, 285188], [40, 285528], [46, 286381], [50, 286504], [58, 286804], [61, 287044], [65, 287204], [69, 287384], [80, 288484], [83, 288604], [89, 288864], [93, 289064], [101, 289304], [104, 289544], [108, 289704], [113, 289904], [117, 290204], [123, 290564]]}, {"verse": 45, "start": 291619, "end": 295014, "text": "And when he knew it of the centurion, he gave the body to Joseph.", "words": [[0, 291619], [4, 291754], [9, 291894], [12, 292054], [17, 292254], [20, 292354], [23, 292454], [27, 292594], [38, 293374], [41, 293454], [46, 293654], [50, 293814], [55, 294094], [58, 294274]]}, {"verse": 46, "start": 295464, "end": 305057, "text": "And he bought fine linen, and took him down, and wrapped him in the linen, and laid him in a tomb which was hewn out of a rock, and rolled a stone to the door of the tomb.", "words": [[0, 295464], [4, 295587], [7, 295687], [14, 295927], [19, 296407], [26, 296707], [30, 297187], [35, 297387], [39, 297547], [45, 297887], [49, 298407], [57, 298667], [61, 298887], [64, 299027], [68, 299147], [75, 299407], [79, 300047], [84, 300287], [88, 300467], [91, 300587], [93, 300727], [98, 301027], [104, 301267], [108, 301467], [113, 301827], [117, 301967], [120, 302087], [122, 302187], [128, 302927], [132, 303052], [139, 303292], [141, 303472], [147, 303792], [150, 303972], [154, 304112], [159, 304332], [162, 304472], [166, 304572]]}, {"verse": 47, "start": 305507, "end": 309923, "text": "And Mary Magdalene and Mary the mother of Joses beheld where he was laid.", "words": [[0, 305507], [4, 305654], [9, 305894], [19, 306894], [23, 307014], [28, 307294], [32, 307454], [39, 307694], [42, 307964], [48, 308234], [55, 308874], [61, 309114], [64, 309274], [68, 309434]]}]}