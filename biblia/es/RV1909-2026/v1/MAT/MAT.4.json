{"book": "MAT", "chapter": 4, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 202251, "verses": [{"verse": 1, "start": 300, "end": 6722, "text": "Entonces Jesús fue llevado del Espíritu al desierto, para ser tentado del diablo.", "words": [[0, 300], [9, 901], [15, 1621], [19, 2261], [27, 2701], [31, 2901], [40, 3501], [43, 3601], [53, 4221], [58, 4901], [62, 5161], [70, 5761], [74, 6001]]}, {"verse": 2, "start": 7072, "end": 12164, "text": "Y habiendo ayunado cuarenta días y cuarenta noches, después tuvo hambre.", "words": [[0, 7072], [2, 7352], [11, 7692], [19, 8212], [28, 8732], [33, 9212], [35, 9452], [44, 9692], [52, 10692], [60, 11032], [65, 11412]]}, {"verse": 3, "start": 12514, "end": 19127, "text": "Y acercándose a él el tentador, dijo: Si eres Hijo de Dios, di que estas piedras se hagan pan.", "words": [[0, 12514], [2, 12853], [14, 13793], [16, 13953], [19, 14153], [22, 14313], [32, 14853], [38, 15686], [41, 15889], [46, 16049], [51, 16309], [54, 16489], [60, 16909], [63, 17329], [67, 17469], [73, 17669], [81, 18209], [84, 18389], [90, 18629]]}, {"verse": 4, "start": 19407, "end": 28078, "text": "Pero él respondiendo, dijo: Escrito está: No con solo el pan vivirá el hombre, sino con toda palabra que sale de la boca de Dios.", "words": [[0, 19407], [5, 19558], [8, 19878], [22, 20758], [28, 21564], [36, 22069], [42, 22793], [45, 22919], [49, 23119], [54, 23459], [57, 23659], [61, 23899], [68, 24479], [71, 24619], [79, 24999], [84, 25239], [88, 25539], [93, 25699], [101, 26099], [105, 26379], [110, 26679], [113, 26859], [116, 26979], [121, 27199], [124, 27439]]}, {"verse": 5, "start": 28428, "end": 33793, "text": "Entonces el diablo lo llevó a la santa ciudad y lo puso en lo alto del templo,", "words": [[0, 28428], [9, 28969], [12, 29409], [19, 29909], [22, 30109], [28, 30529], [30, 30629], [33, 30709], [39, 31009], [46, 31649], [48, 31769], [51, 31909], [56, 32289], [59, 32469], [62, 32629], [67, 32889], [71, 33129]]}, {"