{"book": "PSA", "chapter": 74, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 159137, "verses": [{"verse": 1, "start": 300, "end": 9395, "text": "Masquil de Asaf. ¿POR qué, oh Dios, nos has desechado para siempre? ¿por qué ha humeado tu furor contra las ovejas de tu prado?", "words": [[0, 300], [8, 832], [11, 972], [17, 1760], [22, 2042], [27, 2462], [30, 2562], [36, 3302], [40, 3472], [44, 3642], [54, 4262], [59, 4502], [68, 5510], [73, 5632], [77, 5912], [80, 6172], [88, 6712], [91, 6892], [97, 7412], [104, 7752], [108, 8132], [115, 8512], [118, 8652], [121, 8792]]}, {"verse": 2, "start": 9745, "end": 20096, "text": "Acuérdate de tu congregación, que adquiriste de antiguo, cuando redimiste la vara de tu herencia; este monte de Sion, donde has habitado.", "words": [[0, 9745], [10, 10334], [13, 10594], [16, 10774], [30, 11674], [34, 12374], [45, 13354], [48, 13574], [57, 14254], [64, 14474], [74, 15534], [77, 15714], [82, 15934], [85, 16114], [88, 16294], [98, 17249], [103, 17574], [109, 17899], [112, 18239], [118, 18579], [124, 19099], [128, 19299]]}, {"verse": 3, "start": 20446, "end": 27099, "text": "Levanta tus pies a los asolamientos eternos: a todo enemigo que ha hecho mal en el santuario.", "words": [[0, 20446], [8, 20997], [12, 21177], [17, 21437], [19, 21897], [23, 22017], [36, 22697], [45, 23805], [47, 23958], [52, 24178], [60, 24818], [64, 25018], [67, 25178], [73, 25398], [77, 25738], [80, 26018], [83, 26584]]}, {"verse": 4, "start": 27449, "end": 33852, "text": "Tus enemigos han bramado en medio de tus sinagogas: han puesto sus insignias por señas.", "words": [[0, 27449], [4, 27553], [13, 28133], [17, 28353], [25, 28873], [28, 29013], [34, 29393], [37, 29613], [41, 29773], [52, 31163], [56, 31423], [63, 31683], [67, 32063], [77, 32883], [81, 33063]]}, {"verse": 5, "start": 34202, "end": 39102, "text": "Cualquiera se hacía famoso según que había levantado el hacha sobre los gruesos maderos.", "words": [[0, 34202], [11, 34728], [14, 34928], [20, 35228], [27, 35628], [33, 36068], [37, 36308], [43, 36508], [53, 37128], [56, 37268], [62, 37508], [68, 37808], [72, 38028], [80, 38448]]}, {"verse": 6, "start": 39452, "end": 44107, "text": "Y ahora con hachas y martillos han quebrado todas sus entalladuras.", "words": [[0, 39452], [2, 39558], [8, 39818], [12, 40118], [19, 40558], [21, 40738], [31, 41278], [35, 41758], [44, 42298], [50, 42578], [54, 42918]]}, {"verse": 7, "start": 44457, "end": 50978, "text": "Han puesto a fuego tus santuarios, han profanado el tabernáculo de tu nombre echándolo a tierra.", "words": [[0, 44457], [4, 44640], [11, 44894], [13, 45148], [19, 45400], [23, 45580], [35, 46700], [39, 47101], [49, 47860], [52, 48330], [64, 48800], [67, 49020], [70, 49160], [77, 49520], [87, 50200], [89, 50340]]}, {"verse": 8, "start": 51328, "end": 58648, "text": "Dijeron en su corazón: Destruyámoslos de una vez; han quemado todas las sinagogas de Dios en la tierra.", "words": [[0, 51328], [8, 51831], [11, 51951], [14, 52071], [23, 53455], [38, 53915], [41, 54095], [45, 54235], [50, 54991], [54, 55195], [62, 55735], [68, 56055], [72, 56415], [82, 57175], [85, 57315], [90, 57595], [93, 57855], [96, 57995]]}, {"verse": 9, "start": 58998, "end": 65467, "text": "No vemos ya nuestras señales: no hay más profeta; ni con nosotros hay quien sepa hasta cuándo.", "words": [[0, 58998], [3, 59144], [9, 59384], [12, 59684], [21, 59924], [30, 61142], [33, 61346], [37, 61712], [41, 62079], [50, 62623], [53, 62771], [57, 62991], [66, 63530], [70, 63811], [76, 64050], [81, 64530], [87, 64750]]}, {"verse": 10, "start": 65817, "end": 73357, "text": "¿Hasta cuándo, oh Dios, el angustiador nos afrentará? ¿ha de blasfemar el enemigo perpetuamente tu nombre?", "words": [[0, 65817], [7, 66038], [15, 66718], [18, 66858], [24, 67678], [27, 67798], [39, 68438], [43, 68658], [54, 69816], [58, 70156], [61, 70256], [71, 71016], [74, 71176], [82, 71616], [96, 72556], [99, 72776]]}, {"verse": 11, "start": 73707, "end": 79837, "text": "¿Por qué retraes tu mano, y tu diestra? ¿ por qué la escondes dentro de tu seno?", "words": [[0, 73707], [5, 73829], [9, 74179], [17, 74529], [20, 74769], [26, 75049], [28, 75249], [31, 75349], [40, 76384], [42, 76387], [46, 76727], [50, 77062], [53, 77397], [62, 77733], [69, 78293], [72, 78533], [75, 78693]]}, {"verse": 12, "start": 80187, "end": 86076, "text": "Pero Dios es mi rey ya de antiguo; el que obra salvación en medio de la tierra.", "words": [[0, 80187], [5, 80311], [10, 80591], [13, 80871], [16, 81211], [20, 81591], [23, 81731], [26, 81871], [35, 82786], [38, 82911], [42, 83071], [47, 83331], [57, 84151], [60, 84691], [66, 85051], [69, 85251], [72, 85371]]}, {"verse": 13, "start": 86426, "end": 92583, "text": "Tú hendiste el mar con tu fortaleza: quebrantaste cabezas de ballenas en las aguas.", "words": [[0, 86426], [3, 86840], [12, 87291], [15, 87630], [19, 87970], [23, 88490], [26, 88670], [37, 90263], [50, 90683], [58, 91103], [61, 91203], [70, 91583], [73, 91783], [77, 91923]]}, {"verse": 14, "start": 92933, "end": 98770, "text": "Tú magullaste las cabezas del leviathán; lo diste por comida al pueblo de los desiertos.", "words": [[0, 92933], [3, 93317], [14, 93737], [18, 93957], [26, 94517], [30, 95053], [41, 95767], [44, 95910], [50, 96330], [54, 96530], [61, 96970], [64, 97190], [71, 97510], [74, 97750], [78, 97870]]}, {"verse": 15, "start": 99120, "end": 103525, "text": "Tú abriste fuente y río; tú secaste ríos impetuosos.", "words": [[0, 99120], [3, 99242], [11, 99642], [18, 100202], [20, 100502], [25, 101170], [28, 101274], [36, 102044], [41, 102815]]}, {"verse": 16, "start": 103875, "end": 109046, "text": "Tuyo es el día, tuya también es la noche: tú preparaste la luna y el sol.", "words": [[0, 103875], [5, 104255], [8, 104375], [11, 104515], [16, 105155], [21, 105435], [29, 105775], [32, 105975], [35, 106135], [42, 106930], [45, 107077], [56, 107737], [59, 107917], [64, 108257], [66, 108417], [69, 108537]]}, {"verse": 17, "start": 109396, "end": 115468, "text": "Tú estableciste todos los términos de la tierra: el verano y el invierno tú los formaste.", "words": [[0, 109396], [3, 109520], [16, 110300], [22, 110660], [26, 110960], [35, 111500], [38, 111580], [41, 111660], [49, 112555], [52, 112838], [59, 113158], [61, 113338], [64, 113458], [73, 113978], [76, 114338], [80, 114538]]}, {"verse": 18, "start": 115818, "end": 123832, "text": "Acuérdate de esto: que el enemigo ha dicho afrentas a Jehová, y que el pueblo insensato ha blasfemado tu nombre.", "words": [[0, 115818], [10, 116558], [13, 116838], [19, 117628], [23, 117753], [26, 117893], [34, 118393], [37, 118513], [43, 118913], [52, 119313], [54, 119413], [62, 120173], [64, 120353], [68, 120513], [71, 120653], [78, 120973], [88, 121633], [91, 122293], [102, 122953], [105, 123133]]}, {"verse": 19, "start": 124182, "end": 131028, "text": "No entregues a las bestias el alma de tu tórtola: y no olvides para siempre la congregación de tus afligidos.", "words": [[0, 124182], [3, 124388], [13, 125128], [15, 125228], [19, 125348], [27, 125828], [30, 126048], [35, 126308], [38, 126508], [41, 126628], [50, 127657], [52, 127798], [55, 127958], [63, 128438], [68, 128698], [76, 129038], [79, 129338], [92, 130018], [95, 130178], [99, 130318]]}, {"verse": 20, "start": 131378, "end": 136976, "text": "Mira al pacto: porque las tinieblas de la tierra llenas están de habitaciones de violencia.", "words": [[0, 131378], [5, 131666], [8, 132026], [15, 132912], [22, 133079], [26, 133299], [36, 133879], [39, 133959], [42, 134059], [49, 134339], [56, 134859], [62, 135179], [65, 135359], [78, 135939], [81, 136159]]}, {"verse": 21, "start": 137326, "end": 143582, "text": "No vuelva avergonzado el abatido: el afligido y el necesitado alabarán tu nombre.", "words": [[0, 137326], [3, 137514], [10, 138094], [22, 139054], [25, 139314], [34, 140225], [37, 140374], [46, 141014], [48, 141154], [51, 141254], [62, 142034], [71, 142694], [74, 142894]]}, {"verse": 22, "start": 143932, "end": 151087, "text": "Levántate, oh Dios, defiende tu causa: acuérdate de cómo el insensato te injuria cada día.", "words": [[0, 143932], [11, 144360], [14, 144820], [20, 145120], [29, 146120], [32, 146320], [39, 147180], [49, 147763], [52, 148043], [57, 148403], [60, 148953], [70, 149503], [73, 149723], [81, 150283], [86, 150503]]}, {"verse": 23, "start": 151437, "end": 158737, "text": "No olvides las voces de tus enemigos: el alboroto de los que se levantan contra ti sube continuamente.", "words": [[0, 151437], [3, 151623], [11, 152163], [15, 152403], [21, 152823], [24, 153003], [28, 153143], [38, 154310], [41, 154455], [50, 155055], [53, 155255], [57, 155375], [61, 155515], [64, 155655], [73, 156155], [80, 156515], [83, 156775], [88, 157495]]}]}