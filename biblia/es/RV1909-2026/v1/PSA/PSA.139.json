{"book": "PSA", "chapter": 139, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 156383, "verses": [{"verse": 1, "start": 300, "end": 6848, "text": "Al Músico principal: Salmo de David. OH Jehová, tú me has examinado y conocido.", "words": [[0, 300], [3, 461], [10, 941], [21, 2081], [27, 2644], [30, 2804], [37, 3950], [40, 4264], [48, 4579], [51, 4681], [54, 4881], [58, 5061], [68, 5841], [70, 5981]]}, {"verse": 2, "start": 7198, "end": 13686, "text": "Tú has conocido mi sentarme y mi levantarme, has entendido desde lejos mis pensamientos.", "words": [[0, 7198], [3, 7302], [7, 7502], [16, 8162], [19, 8322], [28, 9062], [30, 9302], [33, 9422], [45, 10562], [49, 10722], [59, 11482], [65, 11702], [71, 12262], [75, 12542]]}, {"verse": 3, "start": 14036, "end": 19042, "text": "Mi senda y mi acostarme has rodeado, y conoces todos mis caminos.", "words": [[0, 14036], [3, 14196], [9, 14696], [11, 14796], [14, 14896], [24, 15516], [28, 15756], [37, 16596], [39, 17356], [47, 17836], [53, 18056], [57, 18316]]}, {"verse": 4, "start": 19392, "end": 25364, "text": "Pues aún no está la palabra en mi lengua, y he aquí, oh Jehová, tú la sabes toda.", "words": [[0, 19392], [5, 19668], [9, 19928], [12, 20168], [17, 20368], [20, 20508], [28, 20888], [31, 21088], [34, 21248], [42, 21928], [44, 22168], [47, 22308], [53, 22855], [56, 23401], [64, 23948], [67, 24188], [70, 24348], [76, 24668]]}, {"verse": 5, "start": 25714, "end": 30454, "text": "Detrás y delante me rodeaste, y sobre mí pusiste tu mano.", "words": [[0, 25714], [7, 26398], [9, 26663], [17, 27103], [20, 27303], [30, 27983], [32, 28418], [38, 28678], [41, 28958], [49, 29558], [52, 29798]]}, {"verse": 6, "start": 30804, "end": 37474, "text": "Más maravilloso es el conocimiento que mi capacidad; alta es, no puedo comprenderla.", "words": [[0, 30804], [4, 31112], [16, 31992], [19, 32152], [22, 32292], [35, 33072], [39, 33232], [42, 33392], [53, 34624], [58, 35244], [62, 35724], [65, 35904], [71, 36204]]}, {"verse": 7, "start": 37824, "end": 42204, "text": "¿Adónde me iré de tu espíritu? ¿y adónde huiré de tu presencia?", "words": [[0, 37958], [8, 38128], [11, 38428], [15, 38728], [18, 38828], [21, 38968], [31, 39870], [34, 40209], [41, 40583], [47, 40956], [50, 41156], [53, 41316]]}, {"verse": 8, "start": 42554, "end": 49107, "text": "Si subo a los cielos, allí estás tú: y si en abismo hago mi estrado, he aquí allí tú estás.", "words": [[0, 42554], [3, 42754], [8, 43194], [10, 43274], [14, 43374], [22, 44214], [27, 44434], [33, 44694], [37, 45298], [39, 45422], [42, 45582], [45, 45702], [52, 46102], [57, 46342], [60, 46542], [69, 47362], [72, 47802], [77, 48052], [82, 48302], [85, 48522]]}, {"verse": 9, "start": 49457, "end": 53589, "text": "Si tomo las alas del alba, y habito en el extremo del mar,", "words": [[0, 49457], [3, 49621], [8, 50001], [12, 50141], [17, 50541], [21, 50721], [27, 51341], [29, 51741], [36, 52081], [39, 52221], [42, 52341], [50, 52961], [54, 53101]]}, {"verse": 10, "start": 53939, "end": 58234, "text": "Aun allí me guiará tu mano, y me asirá tu diestra.", "words": [[0, 53939], [4, 54286], [9, 54666], [12, 55126], [19, 55646], [22, 55786], [28, 56186], [30, 56646], [33, 56966], [39, 57286], [42, 57386]]}, {"verse": 11, "start": 58584, "end": 65656, "text": "Si digo: Ciertamente las tinieblas me encubrirán; aun la noche resplandecerá tocante a mí.", "words": [[0, 58584], [3, 58976], [9, 59625], [21, 60428], [25, 60588], [35, 61308], [38, 61488], [50, 62656], [54, 62858], [57, 63098], [63, 63418], [77, 64278], [85, 65138], [87, 65358]]}, {"verse": 12, "start": 66006, "end": 74051, "text": "Aun las tinieblas no encubren de ti, y la noche resplandece como el día: lo mismo te son las tinieblas que la luz.", "words": [[0, 66006], [4, 66331], [8, 66571], [18, 67291], [21, 67471], [30, 68011], [33, 68191], [37, 68471], [39, 68636], [42, 68776], [48, 69076], [60, 70076], [65, 70316], [68, 70516], [73, 71125], [76, 71253], [82, 71533], [85, 71773], [89, 72073], [93, 72633], [103, 73193], [107, 73393], [110, 73553]]}, {"verse": 13, "start": 74401, "end": 79973, "text": "Porque tú formaste mis riñones; me cubriste en el vientre de mi madre.", "words": [[0, 74401], [7, 74627], [10, 74907], [19, 75527], [23, 76306], [32, 77241], [35, 77715], [44, 78225], [47, 78445], [50, 78585], [58, 79105], [61, 79225], [64, 79365]]}, {"verse": 14, "start": 80323, "end": 88780, "text": "Te alabaré; porque formidables, maravillosas son tus obras: estoy maravillado, y mi alma lo conoce mucho.", "words": [[0, 80562], [3, 80838], [12, 81333], [19, 81753], [32, 82973], [45, 83713], [49, 83993], [53, 84193], [60, 85186], [66, 85426], [79, 86246], [81, 86646], [84, 86826], [89, 87226], [92, 87706], [99, 88186]]}, {"verse": 15, "start": 89130, "end": 97502, "text": "No fue encubierto de ti mi cuerpo, bien que en oculto fui formado, y entretejido en lo más bajo de la tierra.", "words": [[0, 89130], [3, 89316], [7, 89596], [18, 90376], [21, 90536], [24, 90796], [27, 90936], [35, 91936], [40, 92256], [44, 92516], [47, 92796], [54, 93396], [58, 93576], [67, 94256], [69, 94436], [81, 95356], [84, 95496], [87, 95616], [91, 95936], [96, 96416], [99, 96656], [102, 96776]]}, {"verse": 16, "start": 97852, "end": 106139, "text": "Mi embrión vieron tus ojos, y en tu libro estaban escritas todas aquellas cosas que fueron luego formadas, sin faltar una de ellas.", "words": [[0, 97852], [3, 98138], [11, 98458], [18, 98738], [22, 98938], [28, 99338], [30, 99678], [33, 99838], [36, 99978], [42, 100358], [50, 100918], [59, 101558], [65, 101798], [74, 102378], [80, 102578], [84, 102818], [91, 103058], [97, 103398], [107, 104098], [111, 104638], [118, 105158], [122, 105318], [125, 105518]]}, {"verse": 17, "start": 106489, "end": 113357, "text": "Así que ¡cuán preciosos me son, oh Dios, tus pensamientos! ¡cuán grande es la suma de ellos!", "words": [[0, 106489], [4, 106705], [8, 107150], [14, 107430], [24, 108070], [27, 108170], [32, 108470], [35, 108770], [41, 109330], [45, 109530], [59, 110886], [65, 111250], [72, 111690], [75, 112070], [78, 112250], [83, 112630], [86, 112790]]}, {"verse": 18, "start": 113707, "end": 120646, "text": "Si los cuento, se multiplican más que la arena: despierto, y aún estoy contigo.", "words": [[0, 113707], [3, 113884], [7, 114274], [15, 114664], [18, 114804], [30, 115684], [34, 115884], [38, 116084], [41, 116244], [48, 117071], [59, 117958], [61, 118138], [65, 118318], [71, 118718]]}, {"verse": 19, "start": 120996, "end": 127417, "text": "De cierto, oh Dios, matarás al impío; apartaos pues de mí, hombres sanguinarios.", "words": [[0, 121344], [3, 121717], [11, 122090], [14, 122462], [20, 122835], [28, 123208], [31, 123581], [38, 124337], [47, 124527], [52, 124747], [55, 124967], [59, 125447], [67, 125927]]}, {"verse": 20, "start": 127767, "end": 132896, "text": "Porque blasfemias dicen ellos contra ti: tus enemigos toman en vano tu nombre.", "words": [[0, 127767], [7, 128009], [18, 128869], [24, 129289], [30, 129709], [37, 130109], [41, 130760], [45, 130920], [54, 131440], [60, 131760], [63, 131880], [68, 132160], [71, 132260]]}, {"verse": 21, "start": 133246, "end": 138687, "text": "¿No tengo en odio, oh Jehová, a los que te aborrecen, y me conmuevo contra tus enemigos?", "words": [[0, 133246], [4, 133374], [10, 133599], [13, 133824], [19, 134049], [22, 134274], [30, 134994], [32, 135074], [36, 135194], [40, 135334], [43, 135494], [54, 136114], [56, 136534], [59, 136674], [68, 137354], [75, 137594], [79, 137854]]}, {"verse": 22, "start": 139037, "end": 143335, "text": "Los aborrezco con perfecto odio; los tengo por enemigos.", "words": [[0, 139037], [4, 139454], [14, 139904], [18, 140144], [27, 140964], [33, 141766], [37, 142026], [43, 142326], [47, 142566]]}, {"verse": 23, "start": 143685, "end": 149984, "text": "Examíname, oh Dios, y conoce mi corazón: pruébame y reconoce mis pensamientos:", "words": [[0, 143685], [11, 144491], [14, 144591], [20, 145471], [22, 145571], [29, 146051], [32, 146191], [41, 147240], [50, 147764], [52, 148244], [61, 148864], [65, 149044]]}, {"verse": 24, "start": 150334, "end": 155983, "text": "Y ve si hay en mí camino de perversidad, y guíame en el camino eterno.", "words": [[0, 150334], [2, 150496], [5, 150596], [8, 150836], [12, 151116], [15, 151316], [18, 151476], [25, 151796], [28, 152136], [41, 153116], [43, 153696], [50, 154156], [53, 154556], [56, 154676], [63, 155076]]}]}