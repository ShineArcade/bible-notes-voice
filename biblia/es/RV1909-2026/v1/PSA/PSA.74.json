{"book": "PSA", "chapter": 74, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 163696, "verses": [{"verse": 1, "start": 300, "end": 9555, "text": "Masquil de Asaf. ¿POR qué, oh Dios, nos has desechado para siempre? ¿por qué ha humeado tu furor contra las ovejas de tu prado?", "words": [[0, 300], [8, 832], [11, 972], [17, 1840], [22, 2122], [27, 2542], [30, 2642], [36, 3382], [40, 3552], [44, 3722], [54, 4342], [59, 4582], [68, 5670], [73, 5792], [77, 6072], [80, 6332], [88, 6872], [91, 7052], [97, 7572], [104, 7912], [108, 8292], [115, 8672], [118, 8812], [121, 8952]]}, {"verse": 2, "start": 10005, "end": 20559, "text": "Acuérdate de tu congregación, que adquiriste de antiguo, cuando redimiste la vara de tu herencia; este monte de Sion, donde has habitado.", "words": [[0, 10005], [10, 10594], [13, 10854], [16, 11034], [30, 11934], [34, 12634], [45, 13614], [48, 13834], [57, 14514], [64, 14734], [74, 15794], [77, 15974], [82, 16194], [85, 16374], [88, 16554], [98, 17589], [103, 17963], [109, 18363], [112, 18703], [118, 19043], [124, 19563], [128, 19763]]}, {"verse": 3, "start": 21009, "end": 27743, "text": "Levanta tus pies a los asolamientos eternos: a todo enemigo que ha hecho mal en el santuario.", "words": [[0, 21009], [8, 21560], [12, 21740], [17, 22000], [19, 22460], [23, 22580], [36, 23260], [45, 24448], [47, 24602], [52, 24822], [60, 25462], [64, 25662], [67, 25822], [73, 26042], [77, 26382], [80, 26662], [83, 27228]]}, {"verse": 4, "start": 28193, "end": 34676, "text": "Tus enemigos han bramado en medio de tus sinagogas: han puesto sus insignias por señas.", "words": [[0, 28193], [4, 28297], [13, 28877], [17, 29097], [25, 29617], [28, 29757], [34, 30137], [37, 30357], [41, 30517], [52, 31987], [56, 32247], [63, 32507], [67, 32887], [77, 33707], [81, 33887]]}, {"verse": 5, "start": 35126, "end": 40026, "text": "Cualquiera se hacía famoso según que había levantado el hacha sobre los gruesos maderos.", "words": [[0, 35126], [11, 35652], [14, 35852], [20, 36152], [27, 36552], [33, 36992], [37, 37232], [43, 37432], [53, 38052], [56, 38192], [62, 38432], [68, 38732], [72, 38952], [80, 39372]]}, {"verse": 6, "start": 40476, "end": 45131, "text": "Y ahora con hachas y martillos han quebrado todas sus entalladuras.", "words": [[0, 40476], [2, 40582], [8, 40842], [12, 41142], [19, 41582], [21, 41762], [31, 42302], [35, 42782], [44, 43322], [50, 43602], [54, 43942]]}, {"verse": 7, "start": 45581, "end": 52102, "text": "Han puesto a fuego tus santuarios, han profanado el tabernáculo de tu nombre echándolo a tierra.", "words": [[0, 45581], [4, 45764], [11, 46017], [13, 46271], [19, 46524], [23, 46704], [35, 47824], [39, 48224], [49, 48984], [52, 49454], [64, 49924], [67, 50144], [70, 50284], [77, 50644], [87, 51324], [89, 51464]]}, {"verse": 8, "start": 52552, "end": 59992, "text": "Dijeron en su corazón: Destruyámoslos de una vez; han quemado todas las sinagogas de Dios en la tierra.", "words": [[0, 52552], [8, 53055], [11, 53175], [14, 53295], [23, 54729], [38, 55189], [41, 55369], [45, 55509], [50, 56335], [54, 56538], [62, 57078], [68, 57398], [72, 57758], [82, 58518], [85, 58658], [90, 58938], [93, 59198], [96, 59338]]}, {"verse": 9, "start": 60442, "end": 67070, "text": "No vemos ya nuestras señales: no hay más profeta; ni con nosotros hay quien sepa hasta cuándo.", "words": [[0, 60442], [3, 60587], [9, 60827], [12, 61127], [21, 61367], [30, 62666], [33, 62870], [37, 63236], [41, 63603], [50, 64226], [53, 64374], [57, 64594], [66, 65134], [70, 65414], [76, 65654], [81, 66134], [87, 66354]]}, {"verse": 10, "start": 67520, "end": 75140, "text": "¿Hasta cuándo, oh Dios, el angustiador nos afrentará? ¿ha de blasfemar el enemigo perpetuamente tu nombre?", "words": [[0, 67520], [7, 67742], [15, 68422], [18, 68562], [24, 69382], [27, 69502], [39, 70142], [43, 70362], [54, 71599], [58, 71939], [61, 72039], [71, 72799], [74, 72959], [82, 73399], [96, 74339], [99, 74559]]}, {"verse": 11, "start": 75590, "end": 81946, "text": "¿Por qué retraes tu mano, y tu diestra? ¿ por qué la escondes dentro de tu seno?", "words": [[0, 75590], [5, 75712], [9, 76062], [17, 76412], [20, 76652], [26, 76932], [28, 77132], [31, 77232], [40, 79359], [42, 79455], [46, 79552], [50, 79649], [53, 79745], [62, 79842], [69, 80402], [72, 80642], [75, 80802]]}, {"verse": 12, "start": 82396, "end": 88365, "text": "Pero Dios es mi rey ya de antiguo; el que obra salvación en medio de la tierra.", "words": [[0, 82396], [5, 82519], [10, 82799], [13, 83079], [16, 83419], [20, 83799], [23, 83939], [26, 84079], [35, 85075], [38, 85199], [42, 85359], [47, 85619], [57, 86439], [60, 86979], [66, 87339], [69, 87539], [72, 87659]]}, {"verse": 13, "start": 88815, "end": 95052, "text": "Tú hendiste el mar con tu fortaleza: quebrantaste cabezas de ballenas en las aguas.", "words": [[0, 88815], [3, 89229], [12, 89679], [15, 90019], [19, 90359], [23, 90879], [26, 91059], [37, 92732], [50, 93152], [58, 93572], [61, 93672], [70, 94052], [73, 94252], [77, 94392]]}, {"verse": 14, "start": 95502, "end": 101419, "text": "Tú magullaste las cabezas del leviathán; lo diste por comida al pueblo de los desiertos.", "words": [[0, 95502], [3, 95886], [14, 96306], [18, 96526], [26, 97086], [30, 97622], [41, 98415], [44, 98559], [50, 98979], [54, 99179], [61, 99619], [64, 99839], [71, 100159], [74, 100399], [78, 100519]]}, {"verse": 15, "start": 101869, "end": 106354, "text": "Tú abriste fuente y río; tú secaste ríos impetuosos.", "words": [[0, 101869], [3, 101991], [11, 102391], [18, 102951], [20, 103251], [25, 103999], [28, 104103], [36, 104873], [41, 105644]]}, {"verse": 16, "start": 106804, "end": 112055, "text": "Tuyo es el día, tuya también es la noche: tú preparaste la luna y el sol.", "words": [[0, 106804], [5, 107184], [8, 107304], [11, 107444], [16, 108084], [21, 108364], [29, 108704], [32, 108904], [35, 109064], [42, 109939], [45, 110086], [56, 110746], [59, 110926], [64, 111266], [66, 111426], [69, 111546]]}, {"verse": 17, "start": 112505, "end": 118656, "text": "Tú estableciste todos los términos de la tierra: el verano y el invierno tú los formaste.", "words": [[0, 112505], [3, 112628], [16, 113408], [22, 113768], [26, 114068], [35, 114608], [38, 114688], [41, 114768], [49, 115744], [52, 116027], [59, 116347], [61, 116527], [64, 116647], [73, 117167], [76, 117527], [80, 117727]]}, {"verse": 18, "start": 119106, "end": 127201, "text": "Acuérdate de esto: que el enemigo ha dicho afrentas a Jehová, y que el pueblo insensato ha blasfemado tu nombre.", "words": [[0, 119106], [10, 119846], [13, 120126], [19, 120997], [23, 121121], [26, 121261], [34, 121761], [37, 121881], [43, 122281], [52, 122681], [54, 122781], [62, 123541], [64, 123721], [68, 123881], [71, 124021], [78, 124341], [88, 125001], [91, 125661], [102, 126321], [105, 126501]]}, {"verse": 19, "start": 127651, "end": 135183, "text": "No entregues a las bestias el alma de tu tórtola: y no olvides para siempre la congregación de tus afligidos.", "words": [[0, 127651], [3, 127857], [13, 128597], [15, 128697], [19, 128817], [27, 129297], [30, 129517], [35, 129777], [38, 129977], [41, 130097], [50, 131205], [52, 131346], [55, 131526], [63, 131986], [68, 132246], [76, 132586], [79, 132886], [92, 133566], [95, 133726], [99, 133866]]}, {"verse": 20, "start": 135633, "end": 140865, "text": "Mira al pacto: porque las tinieblas de la tierra llenas están de habitaciones de violencia.", "words": [[0, 135633], [5, 135633], [8, 135822], [15, 136801], [22, 136968], [26, 137188], [36, 137768], [39, 137848], [42, 137948], [49, 138228], [56, 138748], [62, 139068], [65, 139248], [78, 139828], [81, 140048]]}, {"verse": 21, "start": 141315, "end": 147651, "text": "No vuelva avergonzado el abatido: el afligido y el necesitado alabarán tu nombre.", "words": [[0, 141315], [3, 141503], [10, 142083], [22, 143043], [25, 143303], [34, 144294], [37, 144442], [46, 145082], [48, 145222], [51, 145322], [62, 146102], [71, 146762], [74, 146962]]}, {"verse": 22, "start": 148101, "end": 155466, "text": "Levántate, oh Dios, defiende tu causa: acuérdate de cómo el insensato te injuria cada día.", "words": [[0, 148101], [11, 148528], [14, 148988], [20, 149288], [29, 150288], [32, 150488], [39, 151559], [49, 152142], [52, 152422], [57, 152782], [60, 153332], [70, 153882], [73, 154102], [81, 154662], [86, 154882]]}, {"verse": 23, "start": 155916, "end": 163296, "text": "No olvides las voces de tus enemigos: el alboroto de los que se levantan contra ti sube continuamente.", "words": [[0, 155916], [3, 156102], [11, 156642], [15, 156882], [21, 157302], [24, 157482], [28, 157622], [38, 158869], [41, 159014], [50, 159614], [53, 159814], [57, 159934], [61, 160074], [64, 160214], [73, 160714], [80, 161074], [83, 161334], [88, 162054]]}]}