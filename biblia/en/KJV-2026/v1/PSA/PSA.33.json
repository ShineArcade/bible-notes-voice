, [54, 57269], [57, 57489], [61, 57629], [67, 57949], [70, 58169], [74, 58429]]}, {"verse": 12, "start": 59866, "end": 66293, "text": "Blessed is the nation whose God is the LORD; and the people whom he has chosen for his own inheritance.", "words": [[0, 59866], [8, 60129], [11, 60549], [15, 60749], [22, 61069], [28, 61329], [32, 61729], [35, 61929], [39, 62089], [45, 62923], [49, 63050], [53, 63170], [60, 63470], [65, 63770], [68, 63990], [72, 64190], [79, 64610], [83, 64910], [87, 65130], [91, 65390]]}, {"verse": 13, "start": 66743, "end": 70592, "text": "The LORD looks from heaven; he sees all the sons of men.", "words": [[0, 66743], [4, 66847], [9, 67147], [15, 67467], [20, 67707], [28, 68530], [31, 68652], [36, 68912], [40, 69372], [44, 69572], [49, 69852], [52, 70072]]}, {"verse": 14, "start": 71042, "end": 75335, "text": "From the place of his habitation he looks upon all the inhabitants of the earth.", "words": [[0, 71042], [5, 71177], [9, 71297], [15, 71537], [18, 71757], [22, 71877], [33, 72677], [36, 72757], [42, 72977], [47, 73317], [51, 73757], [55, 73937], [67, 74437], [70, 74717], [74, 74877]]}, {"verse": 15, "start": 75785, "end": 79602, "text": "He fashions their hearts alike; he considers all their works.", "words": [[0, 75785], [3, 75885], [12, 76405], [18, 76585], [25, 76905], [32, 77824], [35, 77890], [45, 78330], [49, 78730], [55, 78950]]}, {"verse": 16, "start": 80052, "end": 85689, "text": "There is no king saved by the multitude of a host: a mighty man is not delivered by much strength.", "words": [[0, 80052], [6, 80179], [9, 80299], [12, 80479], [17, 80779], [23, 81199], [26, 81459], [30, 81579], [40, 81959], [43, 82199], [45, 82299], [51, 83053], [53, 83153], [60, 83393], [64, 83713], [67, 83913], [71, 84093], [81, 84513], [84, 84813], [89, 85053]]}, {"verse": 17, "start": 86139, "end": 90939, "text": "A horse is a vain thing for safety: neither shall he deliver any by his great strength.", "words": [[0, 86139], [2, 86261], [8, 86481], [11, 86661], [13, 86761], [18, 86981], [24, 87281], [28, 87501], [36, 88368], [44, 88588], [50, 88888], [53, 89048], [61, 89368], [65, 89668], [68, 89908], [72, 90108], [78, 90348]]}, {"verse": 18, "start": 91389, "end": 96529, "text": "Behold, the eye of the LORD is upon them that fear him, upon them that hope in his mercy;", "words": [[0, 91389], [8, 91837], [12, 91937], [16, 92237], [19, 92337], [23, 92477], [28, 92737], [31, 92917], [36, 93237], [41, 93497], [46, 93737], [51, 93997], [56, 94657], [61, 94897], [66, 95217], [71, 95397], [76, 95617], [79, 95817], [83, 95937]]}, {"verse": 19, "start": 96979, "end": 100564, "text": "To deliver their soul from death, and to keep them alive in famine.", "words": [[0, 96979], [3, 97079], [11, 97399], [17, 97619], [22, 97959], [27, 98199], [34, 98519], [38, 98879], [41, 99019], [46, 99199], [51, 99419], [57, 99689], [60, 99959]]}, {"verse": 20, "start": 101014, "end": 104778, "text": "Our soul waits for the LORD: he is our help and our shield.", "words": [[0, 101014], [4, 101132], [9, 101452], [15, 101772], [19, 101992], [23, 102132], [29, 102944], [32, 103063], [35, 103223], [39, 103383], [44, 103723], [48, 104063], [52, 104223]]}, {"verse": 21, "start": 105228, "end": 109902, "text": "For our heart shall rejoice in him, because we have trusted in his holy name.", "words": [[0, 105228], [4, 105353], [8, 105573], [14, 105893], [20, 106233], [28, 106673], [31, 106973], [36, 107193], [44, 107813], [47, 108033], [52, 108173], [60, 108613], [63, 108873], [67, 109013], [72, 109333]]}, {"verse": 22, "start": 110352, "end": 115057, "text": "Let your mercy, O LORD, be upon us, according as we hope in you.", "words": [[0, 110352], [4, 110521], [9, 110721], [16, 111261], [18, 111381], [24, 112181], [27, 112421], [32, 112761], [36, 113121], [46, 113741], [49, 114101], [52, 114261], [57, 114481], [60, 114681]]}]}