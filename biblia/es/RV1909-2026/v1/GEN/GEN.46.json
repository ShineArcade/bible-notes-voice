{"book": "GEN", "chapter": 46, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 279830, "verses": [{"verse": 1, "start": 300, "end": 8296, "text": "Salió Israel con todo lo que tenía, y vino a Beerseba, y ofreció sacrificios al Dios de su padre Isaac.", "words": [[0, 300], [6, 688], [13, 1188], [17, 1528], [22, 1868], [25, 2088], [29, 2488], [36, 2888], [38, 3168], [43, 3428], [45, 4016], [55, 4603], [57, 4683], [65, 5283], [77, 6223], [80, 6423], [85, 6683], [88, 6923], [91, 7063], [97, 7583]]}, {"verse": 2, "start": 8646, "end": 16427, "text": "Y habló Dios a Israel en visiones de noche, y dijo: Jacob, Jacob. Y él respondió: Aquí estoy.", "words": [[0, 8646], [2, 8950], [8, 9290], [13, 9430], [15, 9670], [22, 10150], [25, 10350], [34, 10850], [37, 10970], [44, 11770], [46, 12010], [52, 13107], [59, 13467], [66, 14332], [68, 14514], [71, 14654], [82, 15649], [87, 15873]]}, {"verse": 3, "start": 16707, "end": 24388, "text": "Y dijo: Yo soy Dios, el Dios de tu padre; no temas de descender a Egipto, porque yo te pondré allí en gran nación.", "words": [[0, 16707], [2, 16835], [8, 17557], [11, 17705], [15, 17885], [21, 18445], [24, 18505], [29, 18685], [32, 18865], [35, 18985], [42, 20010], [45, 20127], [51, 20447], [54, 20667], [64, 21127], [66, 21247], [74, 21927], [81, 22287], [84, 22467], [87, 22607], [94, 23007], [99, 23247], [102, 23387], [107, 23547]]}, {"verse": 4, "start": 24738, "end": 31698, "text": "Yo descenderé contigo a Egipto, y yo también te haré volver: y José pondrá su mano sobre tus ojos.", "words": [[0, 24738], [3, 25006], [14, 25586], [22, 26046], [24, 26126], [32, 26646], [34, 27026], [37, 27146], [45, 27426], [48, 27746], [53, 27946], [61, 28960], [63, 29079], [68, 29359], [75, 29839], [78, 29999], [83, 30279], [89, 30579], [93, 30799]]}, {"verse": 5, "start": 31978, "end": 44045, "text": "Y se levantó Jacob de Beerseba; y tomaron los hijos de Israel a su padre Jacob, y a sus niños, y a sus mujeres, en los carros que Faraón había enviado para llevarlo.", "words": [[0, 31978], [2, 32105], [5, 32225], [13, 32805], [19, 33145], [22, 33747], [32, 34506], [34, 34819], [42, 35219], [46, 35399], [52, 35679], [55, 35859], [62, 36239], [64, 36419], [67, 36539], [73, 36899], [80, 37339], [82, 37704], [84, 37764], [88, 37904], [95, 38324], [97, 38844], [99, 38904], [103, 39064], [112, 39524], [115, 40104], [119, 40244], [126, 40864], [130, 41344], [137, 41824], [143, 42164], [151, 42964], [156, 43244]]}, {"verse": 6, "start": 44395, "end": 54278, "text": "Y tomaron sus ganados, y sus bienes que había adquirido en la tierra de Canaán, y se vinieron a Egipto, Jacob, y toda su descendencia consigo;", "words": [[0, 44395], [2, 44492], [10, 44932], [14, 45152], [23, 45772], [25, 46127], [29, 46287], [36, 46767], [40, 46887], [46, 47167], [56, 47887], [59, 47987], [62, 48107], [69, 48427], [72, 48667], [80, 49247], [82, 49727], [85, 49847], [94, 50267], [96, 50427], [104, 51247], [111, 51667], [113, 52227], [118, 52447], [121, 52707], [134, 53507]]}, {"verse": 7, "start": 54628, "end": 64402, "text": "Sus hijos, y los hijos de sus hijos consigo; sus hijas, y las hijas de sus hijos, y a toda su descendencia trajo consigo a Egipto.", "words": [[0, 54628], [4, 54828], [11, 55208], [13, 55508], [17, 55688], [23, 56008], [26, 56568], [30, 56808], [36, 57108], [45, 58195], [49, 58360], [56, 58940], [58, 59300], [62, 59480], [68, 59900], [71, 60020], [75, 60220], [82, 60540], [84, 61020], [86, 61140], [91, 61300], [94, 61600], [107, 62480], [113, 63000], [121, 63420], [123, 63720]]}, {"verse": 8, "start": 64752, "end": 74160, "text": "Y estos son los nombres de los hijos de Israel, que entraron en Egipto, Jacob y sus hijos: Rubén, el primogénito de Jacob.", "words": [[0, 64752], [2, 64938], [8, 65158], [12, 65558], [16, 65738], [24, 66218], [27, 66398], [31, 66518], [37, 66838], [40, 67038], [48, 67538], [52, 68138], [61, 68898], [64, 69018], [72, 69698], [78, 69958], [80, 70398], [84, 70618], [91, 71490], [98, 72416], [101, 72516], [113, 73356], [116, 73496]]}, {"verse": 9, "start": 74510, "end": 78819, "text": "Y los hijos de Rubén: Hanoc, y Falú, y Hezrón, y Carmi.", "words": [[0, 74510], [2, 74611], [6, 74731], [12, 74991], [15, 75211], [22, 76380], [29, 76739], [31, 77097], [37, 77455], [39, 77814], [47, 78172], [49, 78531]]}, {"verse": 10, "start": 79169, "end": 86674, "text": "Y los hijos de Simeón: Jemuel, y Jamín, y Ohad, y Jaquín, y Zohar, y Saúl, hijo de la cananea.", "words": [[0, 79169], [2, 79268], [6, 79408], [12, 79667], [15, 79887], [23, 80900], [31, 81273], [33, 81684], [40, 82095], [42, 82506], [48, 82917], [50, 83327], [58, 83738], [60, 84149], [67, 84560], [69, 84971], [75, 85382], [80, 85542], [83, 85742], [86, 85882]]}, {"verse": 11, "start": 87024, "end": 91376, "text": "Y los hijos de Leví: Gersón, y Coat, y Merari.", "words": [[0, 87024], [2, 87346], [6, 87486], [12, 87786], [15, 88026], [21, 88979], [29, 89299], [31, 89579], [37, 90139], [39, 90699]]}, {"verse": 12, "start": 91726, "end": 103297, "text": "Y los hijos de Judá: Er, y Onán, y Sela, y Fares, y Zara: mas Er y Onán, murieron en la tierra de Canaán. Y los hijos de Fares fueron Hezrón y Hamul.", "words": [[0, 91726], [2, 91814], [6, 91954], [12, 92234], [15, 92414], [21, 94309], [25, 95394], [27, 95481], [33, 95568], [35, 95656], [41, 95743], [43, 95830], [50, 95917], [52, 96004], [58, 96292], [62, 96564], [65, 96869], [67, 97174], [73, 97479], [82, 98259], [85, 98539], [88, 98679], [95, 99059], [98, 99559], [106, 100229], [108, 100353], [112, 100493], [118, 100793], [121, 100973], [127, 101413], [134, 101963], [141, 102513], [143, 102933]]}, {"verse": 13, "start": 103647, "end": 108813, "text": "Y los hijos de Isacar: Tola, y Fúa, y Job, y Simrón.", "words": [[0, 103647], [2, 103736], [6, 103876], [12, 104196], [15, 104436], [23, 105373], [29, 105884], [31, 106064], [36, 106964], [38, 107374], [43, 107784], [45, 108326]]}, {"verse": 14, "start": 109163, "end": 113320, "text": "Y los hijos de Zabulón: Sered, y Elón, y Jahleel.", "words": [[0, 109163], [2, 109271], [6, 109411], [12, 109751], [15, 110321], [24, 111436], [31, 111820], [33, 112203], [39, 112587], [41, 112971]]}, {"verse": 15, "start": 113670, "end": 124156, "text": "Estos fueron los hijos de Lea, los que parió a Jacob en Padan-aram, y además su hija Dina: treinta y tres las almas todas de sus hijos e hijas.", "words": [[0, 113670], [6, 113894], [13, 114194], [17, 114394], [23, 114694], [26, 114894], [31, 115494], [35, 115934], [39, 116074], [45, 116494], [47, 116654], [53, 116994], [56, 117354], [68, 118214], [70, 118694], [77, 118994], [80, 119467], [85, 119941], [91, 120812], [99, 121092], [101, 121372], [106, 121652], [110, 121812], [116, 122192], [122, 122472], [125, 122732], [129, 122932], [135, 123212], [137, 123492]]}, {"verse": 16, "start": 124506, "end": 132640, "text": "Y los hijos de Gad: Zifión, y Hagui, y Ezbón, y Suni, y Heri, y Arodi, y Areli.", "words": [[0, 124506], [2, 124806], [6, 124966], [12, 125246], [15, 125566], [20, 126569], [28, 126859], [30, 127349], [37, 127839], [39, 128429], [46, 129019], [48, 129509], [54, 129999], [56, 130449], [62, 130899], [64, 131019], [71, 131859], [73, 131959]]}, {"verse": 17, "start": 132990, "end": 143240, "text": "Y los hijos de Aser: Imna, e Isúa, e Isúi, y Beria, y Sera, hermana de ellos. Los hijos de Beria: Heber, y Malquiel.", "words": [[0, 132990], [2, 133117], [6, 133237], [12, 133537], [15, 134277], [21, 135536], [27, 135911], [29, 136286], [35, 136661], [37, 137036], [43, 137411], [45, 137786], [52, 138161], [54, 138381], [60, 138641], [68, 139181], [71, 139361], [78, 140118], [82, 140536], [88, 140816], [91, 141246], [98, 142045], [105, 142255], [107, 142785]]}, {"verse": 18, "start": 143590, "end": 151961, "text": "Estos fueron los hijos de Zilpa, la que Labán dio a su hija Lea, y parió estos a Jacob; todas dieciséis almas.", "words": [[0, 143590], [6, 143857], [13, 144077], [17, 144277], [23, 144557], [26, 145057], [33, 145557], [36, 145677], [40, 146017], [46, 146357], [50, 146697], [52, 146957], [55, 147270], [60, 147584], [65, 147897], [67, 148237], [73, 148557], [79, 148877], [81, 149097], [88, 149920], [94, 150454], [104, 151024]]}, {"verse": 19, "start": 152311, "end": 156762, "text": "Y los hijos de Raquel, mujer de Jacob: José y Benjamín.", "words": [[0, 152311], [2, 152701], [6, 152841], [12, 153061], [15, 153301], [23, 153861], [29, 154341], [32, 154541], [39, 155313], [44, 155791], [46, 156306]]}, {"verse": 20, "start": 157112, "end": 165630, "text": "Y nacieron a José en la tierra de Egipto Manasés y Efraín, los que le parió Asenat, hija de Potifera, sacerdote de On.", "words": [[0, 157112], [2, 157212], [11, 157572], [13, 157692], [18, 158072], [21, 158372], [24, 158492], [31, 158832], [34, 159112], [41, 159692], [49, 160152], [51, 160412], [59, 161392], [63, 161472], [67, 161612], [70, 161732], [76, 162244], [84, 162757], [89, 163097], [92, 163177], [102, 164257], [112, 164715], [115, 165172]]}, {"verse": 21, "start": 165980, "end": 175647, "text": "Y los hijos de Benjamín fueron Bela, y Bequer y Asbel, y Gera, y Naamán, y Ehi, y Ros y Mupim, y Hupim, y Ard.", "words": [[0, 165980], [2, 166104], [6, 166244], [12, 166524], [15, 166744], [24, 167324], [31, 167584], [37, 168649], [39, 168926], [46, 169202], [48, 169479], [55, 169756], [57, 170032], [63, 170309], [65, 170749], [73, 171256], [75, 171762], [80, 172269], [82, 172469], [86, 172829], [88, 173189], [95, 173696], [97, 174202], [104, 174709], [106, 175189]]}, {"verse": 22, "start": 175997, "end": 181859, "text": "Estos fueron los hijos de Raquel, que nacieron a Jacob: en todas, catorce almas.", "words": [[0, 175997], [6, 176239], [13, 176619], [17, 176839], [23, 177139], [26, 177339], [34, 177899], [38, 177979], [47, 178439], [49, 178619], [56, 180537], [59, 180537], [66, 180537], [74, 181159]]}, {"verse": 23, "start": 182209, "end": 185826, "text": "Y los hijos de Dan: Husim.", "words": [[0, 182209], [2, 182334], [6, 182454], [12, 182714], [15, 182954], [20, 185038]]}, {"verse": 24, "start": 186176, "end": 189069, "text": "Y los hijos de Neftalí: Jahzeel, y Guni, y Jezer, y Silem.", "words": [[0, 186283], [2, 186419], [6, 186556], [12, 186692], [15, 186828], [24, 187378], [33, 187573], [35, 187767], [41, 187961], [43, 188155], [50, 188350], [52, 188544]]}, {"verse": 25, "start": 189419, "end": 197290, "text": "Estos fueron los hijos de Bilha, la que dio Labán a Raquel su hija, y parió estos a Jacob; todas siete almas.", "words": [[0, 189419], [6, 189682], [13, 189982], [17, 190202], [23, 190482], [26, 190942], [33, 191402], [36, 191642], [40, 191782], [44, 192002], [50, 192462], [52, 192742], [59, 193022], [62, 193222], [68, 193882], [70, 194042], [76, 194461], [82, 194879], [84, 195298], [91, 195873], [97, 196161], [103, 196541]]}, {"verse": 26, "start": 197640, "end": 207968, "text": "Todas las personas que vinieron con Jacob a Egipto, descendientes directos de Jacob, sin las mujeres de los hijos de Jacob, todas las personas fueron sesenta y seis.", "words": [[0, 197640], [6, 197905], [10, 198065], [19, 198465], [23, 198685], [32, 199125], [36, 199345], [42, 199685], [44, 199985], [52, 200805], [66, 201745], [75, 202365], [78, 202445], [85, 202845], [89, 203485], [93, 203725], [101, 204125], [104, 204365], [108, 204465], [114, 204725], [117, 204905], [124, 205625], [130, 205805], [134, 205985], [143, 206385], [150, 206796], [158, 207206], [160, 207617]]}, {"verse": 27, "start": 208318, "end": 218002, "text": "Y los hijos de José, que le nacieron en Egipto, dos personas. Todas las almas de la casa de Jacob, que entraron en Egipto, fueron setenta.", "words": [[0, 208318], [2, 208441], [6, 208581], [12, 208861], [15, 209061], [21, 209361], [25, 209581], [28, 209701], [37, 210241], [40, 210421], [48, 211161], [52, 211301], [62, 212404], [68, 212791], [72, 213031], [78, 213511], [81, 213671], [84, 213771], [89, 214071], [92, 214291], [99, 214691], [103, 215171], [112, 215871], [115, 216071], [123, 216671], [130, 217371]]}, {"verse": 28, "start": 218352, "end": 224884, "text": "Y envió a Judá delante de sí a José, para que le viniese a ver a Gosén; y llegaron a la tierra de Gosén.", "words": [[0, 218352], [2, 218476], [8, 218856], [10, 219016], [15, 219316], [23, 219696], [26, 219896], [29, 220056], [31, 220196], [37, 220496], [42, 220891], [46, 221031], [49, 221171], [57, 221631], [59, 221731], [63, 221871], [65, 222274], [72, 222847], [74, 222951], [83, 223431], [85, 223551], [88, 223611], [95, 224091], [98, 224513]]}, {"verse": 29, "start": 225234, "end": 236507, "text": "Y José unció su carro y vino a recibir a Israel su padre a Gosén; y se manifestó a él, y se echó sobre su cuello, y lloró sobre su cuello bastante.", "words": [[0, 225234], [2, 225376], [7, 225656], [13, 226256], [16, 226456], [22, 226876], [24, 227356], [29, 227596], [31, 227716], [39, 228076], [41, 228296], [48, 228776], [51, 228976], [57, 229375], [59, 229774], [66, 230349], [68, 230604], [71, 230724], [81, 231464], [83, 231604], [87, 232184], [89, 232444], [92, 232584], [97, 232924], [103, 233204], [106, 233404], [114, 234344], [116, 234444], [122, 234764], [128, 235004], [131, 235244], [138, 235604]]}, {"verse": 30, "start": 236857, "end": 243179, "text": "Entonces Israel dijo a José: Muera yo ahora, ya que he visto tu rostro, pues aun vives.", "words": [[0, 236857], [9, 237359], [16, 238059], [21, 238639], [23, 238999], [29, 239731], [35, 240049], [38, 240249], [45, 240549], [48, 240769], [52, 240949], [55, 241009], [61, 241269], [64, 241449], [72, 242249], [77, 242349], [81, 242529]]}, {"verse": 31, "start": 243459, "end": 256167, "text": "Y José dijo a sus hermanos, y a la casa de su padre: Subiré y haré saber a Faraón, y le diré: Mis hermanos y la casa de mi padre, que estaban en la tierra de Canaán, han venido a mí;", "words": [[0, 243459], [2, 243621], [7, 243861], [12, 244321], [14, 244481], [18, 244641], [28, 245501], [30, 246021], [32, 246121], [35, 246201], [40, 246521], [43, 246761], [46, 246921], [53, 247839], [60, 248246], [62, 248426], [67, 248666], [73, 248866], [75, 249156], [83, 249446], [85, 249526], [88, 249626], [94, 250266], [98, 250368], [107, 250928], [109, 251028], [112, 251128], [117, 251388], [120, 251568], [123, 251688], [130, 252028], [134, 252268], [142, 252608], [145, 252788], [148, 252908], [155, 253168], [158, 253368], [166, 253848], [170, 254148], [177, 254528], [179, 254668]]}, {"verse": 32, "start": 256517, "end": 263237, "text": "Y los hombres son pastores de ovejas, porque son hombres ganaderos: y han traído sus ovejas y sus vacas, y todo lo que tenían.", "words": [[0, 256517], [2, 256601], [6, 256721], [14, 257001], [18, 257241], [27, 257721], [30, 257901], [38, 258381], [45, 258656], [49, 258896], [57, 259176], [68, 260227], [70, 260345], [74, 260445], [81, 260765], [85, 260925], [92, 261365], [94, 261525], [98, 261685], [105, 262185], [107, 262305], [112, 262465], [115, 262625], [119, 262725]]}, {"verse": 33, "start": 263587, "end": 266941, "text": "Y cuando Faraón os llame y diga: ¿cuál es vuestro oficio?", "words": [[0, 263587], [2, 263672], [9, 263892], [16, 264112], [19, 264332], [25, 264732], [27, 264872], [33, 265476], [39, 265780], [42, 265900], [50, 266280]]}, {"verse": 34, "start": 267291, "end": 279430, "text": "Entonces diréis: Tus siervos se han dedicado a criar ganado desde nuestra juventud hasta ahora, al igual que nuestros padres; a fin de que moréis en la tierra de Gosén, porque los egipcios detestan el oficio de pastor.", "words": [[0, 267291], [9, 267672], [17, 268482], [21, 268584], [29, 269024], [32, 269184], [36, 269264], [45, 269784], [47, 269864], [53, 270104], [60, 270564], [66, 270744], [74, 271024], [83, 271724], [89, 271944], [96, 272484], [99, 272764], [105, 272964], [109, 273164], [118, 273384], [126, 274244], [128, 274368], [132, 274588], [135, 274748], [139, 274848], [146, 275288], [149, 275408], [152, 275528], [159, 275788], [162, 2