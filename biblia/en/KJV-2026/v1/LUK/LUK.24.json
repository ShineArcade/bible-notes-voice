{"book": "LUK", "chapter": 24, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 333749, "verses": [{"verse": 1, "start": 300, "end": 9149, "text": "Now upon the first day of the week, very early in the morning, they came to the tomb, bringing the spices which they had prepared, and certain others with them.", "words": [[0, 300], [4, 540], [9, 840], [13, 1060], [19, 1300], [23, 1540], [26, 1640], [30, 1760], [36, 2440], [41, 2760], [47, 3120], [50, 3300], [54, 3380], [63, 3880], [68, 3960], [73, 4240], [76, 4440], [80, 4560], [86, 5360], [95, 5640], [99, 5920], [106, 6300], [112, 6600], [117, 6820], [121, 6960], [131, 7400], [135, 7960], [143, 8220], [150, 8540], [155, 8820]]}, {"verse": 2, "start": 9599, "end": 12331, "text": "And they found the stone rolled away from the tomb.", "words": [[0, 9599], [4, 9732], [9, 9872], [15, 10172], [19, 10432], [25, 10732], [32, 11112], [37, 11432], [42, 11692], [46, 11832]]}, {"verse": 3, "start": 12781, "end": 16647, "text": "And they entered in, and found not the body of the Lord Jesus.", "words": [[0, 12781], [4, 12924], [9, 13044], [17, 13384], [21, 13724], [25, 14184], [31, 14524], [35, 14804], [39, 15024], [44, 15384], [47, 15544], [51, 15664], [56, 15884]]}, {"verse": 4, "start": 17097, "end": 23688, "text": "And it came to pass, as they were much perplexed about this, behold, two men stood by them in shining garments:", "words": [[0, 17097], [4, 17219], [7, 17319], [12, 17460], [15, 17620], [21, 17939], [24, 18259], [29, 18399], [34, 18519], [39, 18739], [49, 19319], [55, 19460], [61, 20300], [69, 21079], [73, 21239], [77, 21519], [83, 21780], [86, 22059], [91, 22339], [94, 22519], [102, 22939]]}, {"verse": 5, "start": 24138, "end": 31378, "text": "And as they were afraid, and bowed down their faces to the earth, they said to them, Why do you seek the living among the dead?", "words": [[0, 24138], [4, 24277], [7, 24477], [12, 24637], [17, 24837], [25, 25297], [29, 25677], [35, 26077], [40, 26217], [46, 26417], [52, 26777], [55, 27037], [59, 27177], [66, 27877], [71, 28077], [76, 28357], [79, 28537], [85, 29630], [89, 29794], [92, 29914], [96, 30014], [101, 30154], [105, 30314], [112, 30494], [118, 30774], [122, 30954]]}, {"verse": 6, "start": 31828, "end": 36290, "text": "He is not here, but is risen: remember how he spoke to you when he was yet in Galilee,", "words": [[0, 31828], [3, 31910], [6, 32010], [10, 32210], [16, 32730], [20, 32810], [23, 32970], [30, 33720], [39, 33961], [43, 34241], [46, 34361], [52, 34521], [55, 34741], [59, 34861], [64, 35001], [67, 35141], [71, 35281], [75, 35501], [78, 35741]]}, {"verse": 7, "start": 36740, "end": 42509, "text": "Saying, The Son of man must be delivered into the hands of sinful men, and be crucified, and the third day rise again.", "words": [[0, 36740], [8, 36914], [12, 37094], [16, 37354], [19, 37474], [23, 37694], [28, 37894], [31, 38054], [41, 38374], [46, 38654], [50, 38834], [56, 39054], [59, 39214], [66, 39454], [71, 39854], [75, 40354], [78, 40474], [89, 40894], [93, 41274], [97, 41414], [103, 41634], [107, 41834], [112, 42054]]}, {"verse": 8, "start": 42859, "end": 44419, "text": "And they remembered his words,", "words": [[0, 42859], [4, 42987], [9, 43087], [20, 43487], [24, 43727]]}, {"verse": 9, "start": 44869, "end": 49788, "text": "And returned from the tomb, and told all these things to the eleven, and to all the rest.", "words": [[0, 44869], [4, 45011], [13, 45331], [18, 45651], [22, 45811], [28, 46111], [32, 46491], [37, 46711], [41, 47051], [47, 47251], [54, 47651], [57, 47911], [61, 48031], [69, 48351], [73, 48831], [76, 48971], [80, 49151], [84, 49271]]}, {"verse": 10, "start": 50238, "end": 58869, "text": "It was Mary Magdalene, and Joanna, and Mary the mother of James, and other women that were with them, which told these things to the apostles.", "words": [[0, 50238], [3, 50347], [7, 50547], [12, 50827], [23, 51707], [27, 51967], [35, 53147], [39, 53187], [44, 53487], [48, 53647], [55, 53847], [58, 54107], [65, 54467], [69, 54787], [75, 54987], [81, 55307], [86, 55547], [91, 55687], [96, 55987], [102, 56487], [108, 56707], [113, 57027], [119, 57327], [126, 57687], [129, 57907], [133, 58047]]}, {"verse": 11, "start": 59319, "end": 63194, "text": "And their words seemed to them as idle tales, and they believed them not.", "words": [[0, 59319], [4, 59472], [10, 59592], [16, 59932], [23, 60232], [26, 60412], [31, 60572], [34, 60712], [39, 61032], [46, 61772], [50, 61872], [55, 62012], [64, 62412], [69, 62672]]}, {"verse": 12, "start": 63644, "end": 74416, "text": "Then arose Peter, and ran to the tomb; and stooping down, he beheld the linen clothes laid by themselves, and departed, wondering in himself at that which was come to pass.", "words": [[0, 63644], [5, 63851], [11, 64151], [18, 64551], [22, 64931], [26, 65191], [29, 65411], [33, 65531], [39, 66370], [43, 66485], [52, 66965], [58, 67245], [61, 67445], [68, 67845], [72, 68005], [78, 68245], [86, 68725], [91, 69065], [94, 69305], [106, 69805], [110, 70505], [120, 71465], [130, 71865], [133, 72165], [141, 72585], [144, 72865], [149, 73025], [155, 73265], [159, 73425], [164, 73665], [167, 73805]]}, {"verse": 13, "start": 74866, "end": 82444, "text": "¶ And, behold, two of them went that same day to a village called Emmaus, which was from Jerusalem about sixty furlongs.", "words": [[2, 74866], [7, 75021], [15, 75761], [19, 75981], [22, 76141], [27, 76341], [32, 76541], [37, 76841], [42, 77181], [46, 77481], [49, 77701], [51, 77861], [59, 78101], [66, 78711], [74, 79321], [80, 79601], [84, 79821], [89, 80061], [99, 80661], [105, 81061], [111, 81501]]}, {"verse": 14, "start": 82894, "end": 85618, "text": "And they talked together of all these things which had happened.", "words": [[0, 82894], [4, 83002], [9, 83122], [16, 83402], [25, 83762], [28, 84002], [32, 84162], [38, 84342], [45, 84662], [51, 84902], [55, 85062]]}, {"verse": 15, "start": 86068, "end": 92807, "text": "And it came to pass, that, while they communed together and reasoned, Jesus himself drew near, and went with them.", "words": [[0, 86068], [4, 86199], [7, 86319], [12, 86539], [15, 86719], [21, 87539], [27, 87799], [33, 88139], [38, 88339], [47, 88819], [56, 89099], [60, 89379], [70, 90219], [76, 90359], [84, 90919], [89, 91219], [95, 91459], [99, 91979], [104, 92179], [109, 92459]]}, {"verse": 16, "start": 93257, "end": 95580, "text": "But their eyes were held that they should not know him.", "words": [[0, 93257], [4, 93364], [10, 93504], [15, 93804], [20, 94004], [25, 94244], [30, 94444], [35, 94604], [42, 94744], [46, 95024], [51, 95304]]}, {"verse": 17, "start": 96030, "end": 102860, "text": "And he said to them, What manner of communications are these that you have one to another, as you walk, and are sad?", "words": [[0, 96030], [4, 96160], [7, 96280], [12, 96520], [15, 96720], [21, 97316], [26, 97451], [33, 97811], [36, 98011], [51, 98631], [55, 98971], [61, 99191], [66, 99411], [70, 99551], [75, 99731], [79, 99991], [82, 100171], [91, 100531], [94, 101171], [98, 101331], [104, 101671], [108, 102171], [112, 102291]]}, {"verse": 18, "start": 103210, "end": 112644, "text": "And the one of them, whose name was Cleopas, answering said to him, Are you only a stranger in Jerusalem, and have not known the things which are come to pass there in these days?", "words": [[0, 103210], [4, 103358], [8, 103438], [12, 103638], [15, 103778], [21, 104318], [27, 104478], [32, 104778], [36, 104978], [45, 106158], [55, 106598], [60, 106918], [63, 107098], [68, 107663], [72, 107803], [76, 107943], [81, 108103], [83, 108243], [92, 108523], [95, 108743], [106, 109163], [110, 109643], [115, 109803], [119, 109963], [125, 110223], [129, 110423], [136, 110623], [142, 110863], [146, 110983], [151, 111223], [154, 111363], [159, 111623], [165, 111843], [168, 111963], [174, 112123]]}, {"verse": 19, "start": 112994, "end": 125426, "text": "And he said to them, What things? And they said to him, Concerning Jesus of Nazareth, which was a prophet mighty in deed and word before God and all the people:", "words": [[0, 112994], [4, 113124], [7, 113244], [12, 113484], [15, 113684], [21, 114280], [26, 114439], [32, 116799], [34, 118340], [38, 118499], [43, 118599], [48, 118859], [51, 119059], [56, 119634], [67, 120087], [73, 120447], [76, 120727], [86, 121207], [92, 121627], [96, 121827], [98, 121947], [106, 122207], [113, 122514], [116, 122820], [121, 123127], [125, 123407], [130, 123627], [137, 124007], [141, 124367], [145, 124647], [149, 124867], [153, 125007]]}, {"verse": 20, "start": 125876, "end": 131010, "text": "And how the chief priests and our rulers delivered him to be condemned to death, and have crucified him.", "words": [[0, 125876], [4, 126031], [8, 126191], [12, 126331], [18, 126611], [26, 127091], [30, 127291], [34, 127431], [41, 127751], [51, 128151], [55, 128431], [58, 128591], [61, 128731], [71, 129071], [74, 129351], [81, 129591], [85, 129971], [90, 130111], [100, 130531]]}, {"verse": 21, "start": 131460, "end": 138179, "text": "But we trusted that it had been he which should have redeemed Israel: and beside all this, today is the third day since these things were done.", "words": [[0, 131460], [4, 131557], [7, 131697], [15, 132077], [20, 132317], [23, 132457], [27, 132577], [32, 132877], [35, 133157], [41, 133457], [48, 133637], [53, 133777], [62, 134217], [70, 135056], [74, 135203], [81, 135363], [85, 135683], [91, 136003], [97, 136163], [100, 136323], [104, 136443], [110, 136663], [114, 136903], [120, 137063], [126, 137323], [133, 137623], [138, 137803]]}, {"verse": 22, "start": 138629, "end": 142847, "text": "Yes, and certain women also of our company made us astonished, which were early at the tomb;", "words": [[0, 138629], [5, 139128], [9, 139228], [17, 139468], [23, 139748], [28, 140048], [31, 140188], [35, 140288], [43, 140588], [48, 140848], [51, 140988], [63, 141728], [69, 141808], [74, 141988], [80, 142228], [83, 142368], [87, 142448]]}, {"verse": 23, "start": 143297, "end": 148970, "text": "And when they found not his body, they came, saying, that they had also seen a vision of angels, which said that he was alive.", "words": [[0, 143297], [4, 143432], [9, 143572], [14, 143712], [20, 143932], [24, 144112], [28, 144292], [34, 144692], [39, 144772], [45, 145032], [53, 145312], [58, 145532], [63, 145672], [67, 145852], [72, 146092], [77, 146372], [79, 146452], [86, 146672], [89, 146852], [97, 147472], [103, 147692], [108, 147932], [113, 148112], [116, 148252], [120, 148412]]}, {"verse": 24, "start": 149420, "end": 155868, "text": "And certain of them which were with us went to the tomb, and found it even so as the women had said: but him they saw not.", "words": [[0, 149420], [4, 149540], [12, 149760], [15, 149980], [20, 150180], [26, 150420], [31, 150600], [36, 150820], [39, 150980], [44, 151160], [47, 151300], [51, 151420], [57, 151720], [61, 152160], [67, 152440], [70, 152560], [75, 152880], [78, 153140], [81, 153280], [85, 153420], [91, 153720], [95, 153980], [101, 154677], [105, 154795], [109, 154975], [114, 155155], [118, 155395]]}, {"verse": 25, "start": 156218, "end": 162180, "text": "Then he said to them, O fools, and slow of heart to believe all that the prophets have spoken:", "words": [[0, 156218], [5, 156419], [8, 156579], [13, 156819], [16, 156999], [22, 158147], [24, 158305], [31, 158745], [35, 159065], [40, 159405], [43, 159565], [49, 159805], [52, 160005], [60, 160305], [64, 160725], [69, 160925], [73, 161045], [82, 161365], [87, 161585]]}, {"verse": 26, "start": 162630, "end": 166527, "text": "Ought not Christ to have suffered these things, and to enter into his glory?", "words": [[0, 162630], [6, 162810], [10, 162950], [17, 163310], [20, 163590], [25, 163710], [34, 164010], [40, 164270], [48, 164670], [52, 165150], [55, 165250], [61, 165470], [66, 165730], [70, 165910]]}, {"verse": 27, "start": 166877, "end": 173975, "text": "And beginning at Moses and all the prophets, he expounded to them in all the scriptures the things concerning himself.", "words": [[0, 166877], [4, 167002], [14, 167382], [17, 167642], [23, 168042], [27, 168382], [31, 168582], [35, 168702], [45, 169562], [48, 169782], [58, 170442], [61, 170662], [66, 170862], [69, 171082], [73, 171302], [77, 171482], [88, 171882], [92, 172282], [99, 172582], [110, 173122]]}, {"verse": 28, "start": 174425, "end": 179820, "text": "And they drew near to the village, where they went: and he made as though he would have gone further.", "words": [[0, 174425], [4, 174549], [9, 174669], [14, 174929], [19, 175169], [22, 175329], [26, 175469], [35, 175869], [41, 176289], [46, 176489], [52, 177271], [56, 177409], [59, 177529], [64, 177849], [67, 178109], [74, 178309], [77, 178489], [83, 178749], [88, 178909], [93, 179149]]}, {"verse": 29, "start": 180270, "end": 188644, "text": "But they constrained him, saying, Abide with us: for it is toward evening, and the day is far spent. And he went in to stay with them.", "words": [[0, 180270], [4, 180373], [9, 180533], [21, 180993], [26, 181493], [34, 182677], [40, 182957], [45, 183237], [49, 183907], [53, 184039], [56, 184199], [59, 184359], [66, 184619], [75, 185039], [79, 185519], [83, 185639], [87, 185859], [90, 186079], [94, 186299], [101, 187095], [105, 187221], [108, 187321], [113, 187501], [116, 187681], [119, 187821], [124, 188061], [129, 188301]]}, {"verse": 30, "start": 189094, "end": 195425, "text": "And it came to pass, as he sat at the table with them, he took bread, and blessed it, and broke, and gave to them.", "words": [[0, 189094], [4, 189196], [7, 189296], [12, 189496], [15, 189676], [21, 190016], [24, 190316], [27, 190436], [31, 190736], [34, 190856], [38, 190956], [44, 191316], [49, 191596], [55, 192056], [58, 192216], [63, 192436], [70, 192796], [74, 193136], [82, 193436], [86, 193696], [90, 193876], [97, 194196], [101, 194556], [106, 194836], [109, 195056]]}, {"verse": 31, "start": 195875, "end": 200430, "text": "And their eyes were opened, and they knew him; and he vanished out of their sight.", "words": [[0, 195875], [4, 196028], [10, 196168], [15, 196448], [20, 196688], [28, 197068], [32, 197568], [37, 197728], [42, 197988], [47, 198681], [51, 198802], [54, 198922], [63, 199262], [67, 199622], [70, 199742], [76, 199882]]}, {"verse": 32, "start": 200880, "end": 207968, "text": "And they said one to another, Did not our heart burn within us, while he talked with us by the way, and while he opened to us the scriptures?", "words": [[0, 200880], [4, 201017], [9, 201157], [14, 201397], [18, 201697], [21, 201897], [30, 202722], [34, 202859], [38, 202999], [42, 203199], [48, 203479], [53, 203759], [60, 203979], [64, 204659], [70, 204799], [73, 204949], [80, 205099], [85, 205299], [88, 205419], [91, 205579], [95, 205679], [100, 206219], [104, 206339], [110, 206479], [113, 206599], [120, 206799], [123, 206999], [126, 207139], [130, 207259]]}, {"verse": 33, "start": 208318, "end": 215649, "text": "And they rose up the same hour, and returned to Jerusalem, and found the eleven gathered together, and them that were with them,", "words": [[0, 208318], [4, 208465], [9, 208545], [14, 208805], [17, 209065], [21, 209225], [26, 209505], [32, 210145], [36, 210565], [45, 210965], [48, 211205], [59, 212185], [63, 212385], [69, 212665], [73, 212865], [80, 213185], [89, 213585], [99, 214385], [103, 214725], [108, 214985], [113, 215205], [118, 215365], [123, 215525]]}, {"verse": 34, "start": 216099, "end": 220435, "text": "Saying, The Lord is risen indeed, and has appeared to Simon.", "words": [[0, 216334], [8, 217701], [12, 217800], [17, 218000], [20, 218200], [26, 218440], [34, 218800], [38, 219280], [42, 219440], [51, 219760], [54, 219940]]}, {"verse": 35, "start": 220785, "end": 225903, "text": "And they told what things were done in the way, and how he was known of them in breaking of bread.", "words": [[0, 220785], [4, 220905], [9, 221005], [14, 221245], [19, 221525], [26, 221825], [31, 222045], [36, 222265], [39, 222405], [43, 222505], [48, 222805], [52, 223465], [56, 223665], [59, 223825], [63, 224025], [69, 224265], [72, 224465], [77, 224645], [80, 224825], [89, 225145], [92, 225385]]}, {"verse": 36, "start": 226353, "end": 232356, "text": "¶ And as they thus spoke, Jesus himself stood in the midst of them, and says to them, Peace be to you.", "words": [[2, 226353], [6, 226484], [9, 226684], [14, 226844], [19, 227024], [26, 227944], [32, 228284], [40, 228804], [46, 229124], [49, 229304], [53, 229384], [59, 229584], [62, 229784], [68, 229964], [72, 230164], [77, 230364], [80, 230584], [86, 231156], [92, 231396], [95, 231676], [98, 231916]]}, {"verse": 37, "start": 232706, "end": 236962, "text": "But they were terrified and affrighted, and supposed that they had seen a spirit.", "words": [[0, 232706], [4, 232812], [9, 232932], [14, 233072], [24, 233672], [28, 234072], [40, 234812], [44, 235072], [53, 235452], [58, 235752], [63, 235932], [67, 236032], [72, 236232], [74, 236372]]}, {"verse": 38, "start": 237412, "end": 242237, "text": "And he said to them, Why are you troubled? and why do thoughts arise in your hearts?", "words": [[0, 237412], [4, 237557], [7, 237637], [12, 237857], [15, 238057], [21, 238643], [25, 238866], [29, 239026], [33, 239166], [43, 240068], [47, 240186], [51, 240406], [54, 240546], [63, 240866], [69, 241266], [72, 241526], [77, 241646]]}, {"verse": 39, "start": 242687, "end": 251566, "text": "Behold my hands and my feet, that it is I myself: handle me, and see; for a spirit has not flesh and bones, as you see me have.", "words": [[0, 242687], [7, 243011], [10, 243211], [16, 243571], [20, 243731], [23, 243891], [29, 244371], [34, 244651], [37, 244791], [40, 245011], [42, 245251], [50, 246231], [57, 246577], [61, 246797], [65, 247137], [70, 247904], [74, 248076], [76, 248236], [83, 248596], [87, 248856], [91, 249136], [97, 249456], [101, 249716], [108, 250176], [111, 250596], [115, 250756], [119, 250976], [122, 251116]]}, {"verse": 40, "start": 251916, "end": 255794, "text": "And when he had thus spoken, he showed them his hands and his feet.", "words": [[0, 251916], [4, 252049], [9, 252209], [12, 252409], [16, 252569], [21, 252749], [29, 253709], [32, 253849], [39, 254109], [44, 254369], [48, 254549], [54, 254949], [58, 255169], [62, 255329]]}, {"verse": 41, "start": 256244, "end": 262106, "text": "And while they yet believed not for joy, and wondered, he said to them, Have you here any food?", "words": [[0, 256244], [4, 256390], [10, 256610], [15, 256850], [19, 257050], [28, 257490], [32, 257830], [36, 258070], [41, 258770], [45, 259030], [55, 259770], [58, 259890], [63, 260090], [66, 260270], [72, 260928], [77, 261076], [81, 261246], [86, 261416], [90, 261576]]}, {"verse": 42, "start": 262456, "end": 265900, "text": "And they gave him a piece of a broiled fish, and of a honeycomb.", "words": [[0, 262456], [4, 262585], [9, 262725], [14, 262965], [18, 263145], [20, 263285], [26, 263505], [29, 263705], [31, 263805], [39, 264285], [45, 264605], [49, 264965], [52, 265105], [54, 265185]]}, {"verse": 43, "start": 266350, "end": 268418, "text": "And he took it, and did eat before them.", "words": [[0, 266350], [4, 266475], [7, 266575], [12, 266835], [16, 267015], [20, 267215], [24, 267435], [28, 267595], [35, 267955]]}, {"verse": 44, "start": 268868, "end": 281215, "text": "And he said to them, These are the words which I spoke to you, while I was yet with you, that all things must be fulfilled, which were written in the law of Moses, and in the prophets, and in the psalms, concerning me.", "words": [[0, 268868], [4, 269013], [7, 269153], [12, 269393], [15, 269593], [21, 270217], [27, 270468], [31, 270648], [35, 270748], [41, 271028], [47, 271268], [49, 271408], [55, 271668], [58, 271908], [63, 272088], [69, 272348], [71, 272508], [75, 272688], [79, 272888], [84, 273128], [89, 273568], [94, 273888], [98, 274128], [105, 274428], [110, 274688], [113, 274908], [124, 275308], [130, 275928], [135, 276088], [143, 276368], [146, 276588], [150, 276688], [154, 276908], [157, 277108], [164, 278057], [168, 278201], [171, 278321], [175, 278421], [185, 279341], [189, 279461], [192, 279601], [196, 279701], [204, 280301], [215, 280701]]}, {"verse": 45, "start": 281565, "end": 285629, "text": "Then opened he their understanding, that they might understand the scriptures,", "words": [[0, 281565], [5, 281794], [12, 282034], [15, 282334], [21, 282594], [36, 283194], [41, 283914], [46, 284074], [52, 284254], [63, 284774], [67, 284934]]}, {"verse": 46, "start": 286079, "end": 293479, "text": "And said to them, Thus it is written, and thus it was necessary for Christ to suffer, and to rise from the dead the third day:", "words": [[0, 286079], [4, 286227], [9, 286407], [12, 286587], [18, 287191], [23, 287409], [26, 287689], [29, 287829], [38, 288729], [42, 288829], [47, 289089], [50, 289229], [54, 289349], [64, 289909], [68, 290169], [75, 290489], [78, 290709], [86, 291289], [90, 291589], [93, 291729], [98, 292009], [103, 292289], [107, 292409], [112, 292629], [116, 292829], [122, 293049]]}, {"verse": 47, "start": 293929, "end": 299899, "text": "And that repentance and remission of sins should be preached in his name among all nations, beginning at Jerusalem.", "words": [[0, 293929], [4, 294061], [9, 294201], [20, 294661], [24, 295001], [34, 295441], [37, 295561], [42, 295921], [49, 296141], [52, 296301], [61, 296581], [64, 296821], [68, 296981], [73, 297281], [79, 297501], [83, 297761], [92, 298581], [102, 298921], [105, 299161]]}, {"verse": 48, "start": 300349, "end": 302232, "text": "And you are witnesses of these things.", "words": [[0, 300349], [4, 300505], [8, 300685], [12, 300825], [22, 301145], [25, 301465], [31, 301625]]}, {"verse": 49, "start": 302682, "end": 311557, "text": "¶ And, behold, I send the promise of my Father upon you: but stay in the city of Jerusalem, until you be endued with power from on high.", "words": [[2, 302682], [7, 302831], [15, 303911], [17, 304161], [22, 304411], [26, 304611], [34, 304991], [37, 305191], [40, 305371], [47, 305711], [52, 306051], [57, 306777], [61, 306917], [66, 307197], [69, 307397], [73, 307517], [78, 307757], [81, 307917], [92, 308517], [98, 309217], [102, 309477], [105, 309637], [112, 310097], [117, 310217], [123, 310597], [128, 310877], [131, 311057]]}, {"verse": 50, "start": 311907, "end": 316815, "text": "¶ And he led them out as far as to Bethany, and he lifted up his hands, and blessed them.", "words": [[2, 311907], [6, 312038], [9, 312158], [13, 312378], [18, 312598], [22, 312818], [25, 312978], [29, 313238], [32, 313358], [35, 313498], [44, 314478], [48, 314538], [51, 314658], [58, 314938], [61, 315158], [65, 315298], [72, 315718], [76, 316078], [84, 316338]]}, {"verse": 51, "start": 317265, "end": 323249, "text": "And it came to pass, while he blessed them, he was parted from them, and carried up into heaven.", "words": [[0, 317265], [4, 317420], [7, 317520], [12, 317740], [15, 317960], [21, 318780], [27, 319060], [30, 319300], [38, 319620], [44, 320060], [47, 320140], [51, 320320], [58, 320800], [63, 321000], [69, 321260], [73, 321740], [81, 322080], [84, 322400], [89, 322640]]}, {"verse": 52, "start": 323699, "end": 327638, "text": "And they worshipped him, and returned to Jerusalem with great joy:", "words": [[0, 323699], [4, 323861], [9, 324281], [20, 324701], [25, 324821], [29, 325141], [38, 325581], [41, 325821], [51, 326421], [56, 326701], [62, 326961]]}, {"verse": 53, "start": 328088, "end": 333349, "text": "And were continually in the temple, praising and blessing God. Amen.", "words": [[0, 328088], [4, 328215], [9, 328375], [21, 328955], [24, 329375], [28, 329515], [36, 330235], [45, 330775], [49, 331195], [58, 331575], [63, 332673]]}]}