{"book": "PSA", "chapter": 69, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 246553, "verses": [{"verse": 1, "start": 300, "end": 9167, "text": "Al Músico principal: sobre Sosannim: Salmo de David. SÁLVAME, oh Dios, porque las aguas han entrado hasta el alma.", "words": [[0, 300], [3, 484], [10, 984], [21, 2083], [27, 2367], [37, 3649], [43, 4433], [46, 4633], [53, 5382], [62, 5751], [65, 6131], [71, 6811], [78, 6971], [82, 7251], [88, 7631], [92, 7771], [100, 8311], [106, 8471], [109, 8651]]}, {"verse": 2, "start": 9517, "end": 17405, "text": "Estoy hundido en cieno profundo, donde no hay pie: he venido a abismos de aguas, y la corriente me ha anegado.", "words": [[0, 9517], [6, 9903], [14, 10383], [17, 10563], [23, 10943], [33, 11503], [39, 12003], [42, 12303], [46, 12463], [51, 13124], [54, 13251], [61, 13651], [63, 13831], [71, 14251], [74, 14391], [81, 14971], [83, 15391], [86, 15511], [96, 16111], [99, 16411], [102, 16945]]}, {"verse": 3, "start": 17755, "end": 25677, "text": "Cansado estoy de llamar; mi garganta se ha enronquecido; han desfallecido mis ojos esperando a mi Dios.", "words": [[0, 17755], [8, 18317], [14, 18557], [17, 18797], [25, 19375], [28, 19675], [37, 19942], [40, 20208], [43, 20475], [57, 22025], [61, 22325], [74, 23165], [78, 23345], [83, 23665], [93, 24185], [95, 24505], [98, 24585]]}, {"verse": 4, "start": 26027, "end": 39729, "text": "Se han aumentado más que los cabellos de mi cabeza los que me aborrecen sin causa; se han fortalecido mis enemigos, los que me destruyen sin por qué: he venido pues a pagar lo que no he tomado.", "words": [[0, 26027], [3, 26173], [7, 26333], [17, 27053], [21, 27313], [25, 27533], [29, 27693], [38, 28273], [41, 28353], [44, 28473], [51, 29473], [55, 29533], [59, 29693], [62, 29833], [72, 30413], [76, 30613], [83, 31648], [86, 31977], [90, 32117], [102, 33057], [106, 33237], [116, 34257], [120, 34617], [124, 34757], [127, 34897], [137, 35617], [141, 35857], [145, 36177], [150, 36887], [153, 36991], [160, 37391], [165, 37631], [167, 37851], [173, 38151], [176, 38551], [180, 38691], [183, 38931], [186, 39071]]}, {"verse": 5, "start": 40079, "end": 44010, "text": "Dios, tú sabes mi locura; y mis delitos no te son ocultos.", "words": [[0, 40079], [6, 40324], [9, 40564], [15, 40824], [18, 41104], [26, 41854], [28, 41963], [32, 42103], [40, 42603], [43, 42823], [46, 42983], [50, 43223]]}, {"verse": 6, "start": 44360, "end": 54139, "text": "No sean avergonzados por mi causa los que te esperan, oh Señor Jehová de los ejércitos; no sean confusos por mí los que te buscan, oh Dios de Israel.", "words": [[0, 44360], [3, 44487], [8, 44767], [21, 45687], [25, 45927], [28, 46107], [34, 46487], [38, 46727], [42, 46867], [45, 46967], [54, 47477], [57, 47987], [63, 48387], [70, 48987], [73, 49087], [77, 49247], [88, 50473], [91, 50578], [96, 50818], [105, 51478], [109, 51685], [112, 51891], [116, 52098], [120, 52218], [123, 52338], [131, 52698], [134, 53058], [139, 53258], [142, 53478]]}, {"verse": 7, "start": 54489, "end": 60252, "text": "Porque por amor de ti he sufrido afrenta; confusión ha cubierto mi rostro.", "words": [[0, 54489], [7, 54753], [11, 55033], [16, 55293], [19, 55553], [22, 55773], [25, 56013], [33, 56613], [42, 57746], [52, 58573], [55, 58773], [64, 59333], [67, 59513]]}, {"verse": 8, "start": 60602, "end": 65960, "text": "He sido extrañado de mis hermanos, y extraño a los hijos de mi madre.", "words": [[0, 60602], [3, 60708], [8, 61008], [18, 61988], [21, 62168], [25, 62308], [35, 63328], [37, 63508], [45, 64288], [47, 64549], [51, 64728], [57, 65029], [60, 65228], [63, 65348]]}, {"verse": 9, "start": 66310, "end": 72784, "text": "Porque me consumió el celo de tu casa; y los denuestos de los que te vituperaban, cayeron sobre mí.", "words": [[0, 66310], [7, 66535], [10, 66735], [19, 67535], [22, 67795], [27, 68255], [30, 68355], [33, 68535], [39, 69281], [41, 69512], [45, 69672], [55, 70292], [58, 70412], [62, 70512], [66, 70652], [69, 70812], [82, 71512], [90, 72112], [96, 72372]]}, {"verse": 10, "start": 73134, "end": 78178, "text": "Y lloré afligiendo con ayuno mi alma; y esto me ha sido por afrenta.", "words": [[0, 73134], [2, 73260], [8, 73780], [19, 74680], [23, 74900], [29, 75300], [32, 75560], [38, 76347], [40, 76464], [45, 76664], [48, 76864], [51, 76964], [56, 77184], [60, 77444]]}, {"verse": 11, "start": 78528, "end": 83591, "text": "Puse además saco por mi vestido; y vine a serles por proverbio.", "words": [[0, 78528], [5, 78810], [12, 79070], [17, 79690], [21, 79890], [24, 80070], [33, 81057], [35, 81390], [40, 81590], [42, 81970], [49, 82350], [53, 82630]]}, {"verse": 12, "start": 83941, "end": 92084, "text": "Hablaban contra mí los que se sentaban a la puerta, y se burlaban de mí en sus canciones de los bebedores de sidra.", "words": [[0, 83941], [9, 84365], [16, 84745], [19, 85025], [23, 85345], [27, 85505], [30, 85645], [39, 86265], [41, 86365], [44, 86465], [52, 87455], [54, 87745], [57, 87945], [66, 88545], [69, 88785], [72, 88965], [75, 89265], [79, 89585], [89, 90445], [92, 90665], [96, 90785], [106, 91325], [109, 91735]]}, {"verse": 13, "start": 92434, "end": 103290, "text": "Pero yo enderezaba mi oración a ti, oh Jehová, al tiempo de tu buena voluntad: oh Dios, por la multitud de tu misericordia, por la verdad de tu salvación, óyeme.", "words": [[0, 92434], [5, 92581], [8, 92881], [19, 93681], [22, 93861], [30, 94281], [32, 94481], [36, 94691], [39, 94901], [47, 95421], [50, 95601], [57, 95881], [60, 96141], [63, 96281], [69, 96501], [79, 98551], [82, 98551], [88, 98551], [92, 98913], [95, 99093], [104, 99713], [107, 99893], [110, 100033], [124, 101033], [128, 101113], [131, 101273], [138, 101533], [141, 101793], [144, 101933], [155, 102753]]}, {"verse": 14, "start": 103640, "end": 111523, "text": "Sácame del lodo, y no sea yo sumergido: sea yo libertado de los que me aborrecen, y del profundo de las aguas.", "words": [[0, 103640], [7, 104124], [11, 104404], [17, 104784], [19, 104884], [22, 105064], [26, 105244], [29, 105524], [40, 106678], [44, 106895], [47, 107115], [57, 107835], [60, 107995], [64, 108095], [68, 108255], [71, 108395], [82, 109095], [84, 109555], [88, 109715], [97, 110395], [100, 110595], [104, 110775]]}, {"verse": 15, "start": 111873, "end": 118867, "text": "No me anegue el ímpetu de las aguas, ni me trague la hondura, ni el pozo cierre sobre mí su boca.", "words": [[0, 111873], [3, 112057], [6, 112357], [13, 112657], [16, 112917], [23, 113497], [26, 113657], [30, 113857], [37, 114897], [40, 115237], [43, 115397], [50, 115717], [53, 116207], [62, 116697], [65, 116837], [68, 116957], [73, 117297], [80, 117717], [86, 117957], [89, 118197], [92, 118377]]}, {"verse": 16, "start": 119217, "end": 126096, "text": "Óyeme, Jehová, porque apacible es tu misericordia; mírame conforme a la multitud de tus misericordias.", "words": [[0, 119537], [7, 119857], [15, 120177], [22, 120377], [31, 121137], [34, 121317], [37, 121377], [51, 122778], [58, 123083], [67, 123383], [69, 123683], [72, 123783], [81, 124403], [84, 124643], [88, 124803]]}, {"verse": 17, "start": 126446, "end": 131976, "text": "Y no escondas tu rostro de tu siervo; porque estoy angustiado; apresúrate, óyeme.", "words": [[0, 126446], [2, 126563], [5, 126703], [14, 127263], [17, 127403], [24, 127903], [27, 128023], [30, 128183], [38, 129030], [45, 129214], [51, 129454], [63, 130545], [75, 131244]]}, {"verse": 18, "start": 132326, "end": 136931, "text": "Acércate a mi alma, redímela: líbrame a causa de mis enemigos.", "words": [[0, 132326], [9, 132946], [11, 133126], [14, 133246], [20, 133953], [30, 135082], [38, 135322], [40, 135462], [46, 135762], [49, 136022], [53, 136122]]}, {"verse": 19, "start": 137281, "end": 144021, "text": "Tú sabes mi afrenta, y mi confusión, y mi deshonra: delante de ti están todos mis enemigos.", "words": [[0, 137281], [3, 137387], [9, 137647], [12, 137887], [21, 138727], [23, 138887], [26, 139007], [37, 139847], [39, 140107], [42, 140593], [52, 141244], [60, 141844], [63, 142004], [66, 142244], [72, 142504], [78, 142904], [82, 143184]]}, {"verse": 20, "start": 144371, "end": 154365, "text": "La afrenta ha quebrantado mi corazón, y estoy acongojado: y esperé quien se compadeciese de mí, y no lo hubo: y consoladores, y ninguno hallé.", "words": [[0, 144371], [3, 144521], [11, 145201], [14, 145361], [26, 146181], [29, 146361], [38, 146861], [40, 147341], [46, 147581], [58, 148760], [60, 148906], [67, 149386], [73, 149586], [76, 150116], [89, 150646], [92, 150866], [96, 151026], [98, 151206], [101, 151346], [104, 151506], [110, 152148], [112, 152253], [126, 153133], [128, 153493], [136, 153956]]}, {"verse": 21, "start": 154715, "end": 159836, "text": "Me pusieron además hiel por comida, y en mi sed me dieron a beber vinagre.", "words": [[0, 154715], [3, 154805], [12, 155325], [19, 155835], [24, 156345], [28, 156605], [36, 157125], [38, 157405], [41, 157585], [44, 157785], [48, 158105], [51, 158365], [58, 158725], [60, 158845], [66, 159045]]}, {"verse": 22, "start": 160186, "end": 165127, "text": "Sea su mesa delante de ellos por lazo, y lo que es para bien por tropiezo.", "words": [[0, 160186], [4, 160429], [7, 160669], [12, 160989], [20, 161509], [23, 161709], [29, 161889], [33, 162129], [39, 162629], [41, 163069], [44, 163209], [48, 163369], [51, 163529], [56, 163709], [61, 163929], [65, 164189]]}, {"verse": 23, "start": 165477, "end": 171571, "text": "Sean oscurecidos sus ojos para ver, y haz siempre titubear sus lomos.", "words": [[0, 165477], [5, 165917], [17, 167017], [21, 167317], [26, 167617], [31, 167937], [36, 168237], [38, 168657], [42, 168837], [50, 169497], [59, 170537], [63, 170757]]}, {"verse": 24, "start": 171921, "end": 176679, "text": "Derrama sobre ellos tu ira, y el furor de tu enojo los alcance.", "words": [[0, 171921], [8, 172455], [14, 172755], [20, 173075], [23, 173395], [28, 174255], [30, 174435], [33, 174575], [39, 174975], [42, 175135], [45, 175295], [51, 175675], [55, 175855]]}, {"verse": 25, "start": 177029, "end": 181447, "text": "Sea su palacio asolado: en sus tiendas no haya habitante.", "words": [[0, 177029], [4, 177314], [7, 177554], [15, 178204], [24, 179073], [27, 179180], [31, 179320], [39, 179940], [42, 180320], [47, 180540]]}, {"verse": 26, "start": 181797, "end": 187439, "text": "Porque persiguieron al que tú heriste; y cuentan del dolor de los que tú llagaste.", "words": [[0, 181797], [7, 182778], [20, 183178], [23, 183338], [27, 183498], [30, 184016], [39, 184720], [41, 184822], [49, 185342], [53, 185542], [59, 185922], [62, 186142], [66, 186262], [70, 186442], [73, 186969]]}, {"verse": 27, "start": 187789, "end": 192043, "text": "Pon maldad sobre su maldad, y no entren en tu justicia.", "words": [[0, 187789], [4, 187932], [11, 188472], [17, 188892], [20, 189112], [28, 189732], [30, 190172], [33, 190352], [40, 190672], [43, 190932], [46, 191092]]}, {"verse": 28, "start": 192393, "end": 196823, "text": "Sean raídos del libro de los vivientes, y no sean escritos con los justos.", "words": [[0, 192393], [5, 192614], [12, 193194], [16, 193354], [22, 193674], [25, 193854], [29, 193974], [40, 194534], [42, 194974], [45, 195094], [50, 195334], [59, 195854], [63, 196054], [67, 196234]]}, {"verse": 29, "start": 197173, "end": 202047, "text": "Y yo afligido y dolorido, tu salvación, oh Dios, me defenderá.", "words": [[0, 197173], [2, 197319], [5, 197519], [14, 198279], [16, 198379], [26, 199399], [29, 199479], [40, 200639], [43, 200779], [49, 201159], [52, 201279]]}, {"verse": 30, "start": 202397, "end": 207463, "text": "Alabaré yo el nombre de Dios con cántico, lo ensalzaré con alabanza.", "words": [[0, 202586], [8, 202812], [11, 203039], [14, 203199], [21, 203579], [24, 203779], [29, 204039], [33, 204339], [42, 205479], [45, 205559], [55, 206359], [59, 206499]]}, {"verse": 31, "start": 207813, "end": 213876, "text": "Y agradará a Jehová más que sacrificio de buey, o becerro que echa cuernos y uñas.", "words": [[0, 207813], [2, 207977], [11, 208617], [13, 208857], [20, 209317], [24, 209497], [28, 209907], [39, 210317], [42, 210757], [48, 211197], [50, 211637], [58, 212077], [62, 212287], [67, 212497], [75, 213057], [77, 213217]]}, {"verse": 32, "start": 214226, "end": 219982, "text": "Lo verán los humildes, y se gozarán; buscad a Dios, y vivirá vuestro corazón.", "words": [[0, 214226], [3, 214374], [9, 214674], [13, 214834], [23, 215694], [25, 216074], [28, 216254], [37, 217274], [44, 217758], [46, 217858], [52, 218098], [54, 218458], [61, 218898], [69, 219238]]}, {"verse": 33, "start": 220332, "end": 225582, "text": "Porque Jehová oye a los necesitados, y no menosprecia a sus prisioneros.", "words": [[0, 220332], [7, 220594], [14, 221174], [18, 221514], [20, 221674], [24, 221774], [37, 222774], [39, 223039], [42, 223239], [54, 224139], [56, 224419], [60, 224599]]}, {"verse": 34, "start": 225932, "end": 231978, "text": "Alábenlo los cielos y la tierra, los mares, y todo lo que se mueve en ellos.", "words": [[0, 226276], [9, 226656], [13, 226836], [20, 227396], [22, 227516], [25, 227656], [33, 228596], [37, 228676], [44, 229236], [46, 229636], [51, 229976], [54, 230276], [58, 230416], [61, 230596], [67, 231176], [70, 231396]]}, {"verse": 35, "start": 232328, "end": 239764, "text": "Porque Dios guardará a Sion, y reedificará las ciudades de Judá; y habitarán allí, y la poseerán.", "words": [[0, 232328], [7, 232573], [12, 232853], [21, 233313], [23, 233773], [29, 234233], [31, 234662], [43, 235091], [47, 235520], [56, 235949], [59, 236378], [65, 237232], [67, 237452], [77, 237992], [83, 238332], [85, 238672], [88, 238792]]}, {"verse": 36, "start": 240114, "end": 246153, "text": "Y la descendencia de sus siervos la heredará, y los que aman su nombre habitarán en ella.", "words": [[0, 240114], [2, 240217], [5, 240337], [18, 241297], [21, 241437], [25, 241597], [33, 242277], [36, 242717], [46, 243457], [48, 243897], [52, 244037], [56, 244197], [61, 244377], [64, 244637], [71, 244917], [81, 245497], [84, 245617]]}]}