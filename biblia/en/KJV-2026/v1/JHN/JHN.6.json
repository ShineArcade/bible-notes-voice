{"book": "JHN", "chapter": 6, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 472705, "verses": [{"verse": 1, "start": 300, "end": 5692, "text": "After these things Jesus went over the sea of Galilee, which is the sea of Tiberias.", "words": [[0, 300], [6, 514], [12, 794], [19, 1294], [25, 1554], [30, 1954], [35, 2254], [39, 2454], [43, 2714], [46, 2834], [55, 3714], [61, 3934], [64, 4134], [68, 4274], [72, 4534], [75, 4654]]}, {"verse": 2, "start": 6142, "end": 11621, "text": "And a great multitude followed him, because they saw his miracles which he did on them that were diseased.", "words": [[0, 6142], [4, 6274], [6, 6354], [12, 6614], [22, 7074], [31, 7674], [36, 7934], [44, 8254], [49, 8474], [53, 8754], [57, 8954], [66, 9454], [72, 9794], [75, 9934], [79, 10154], [82, 10354], [87, 10534], [92, 10734], [97, 10854]]}, {"verse": 3, "start": 12071, "end": 16338, "text": "And Jesus went up into a mountain, and there he sat with his disciples.", "words": [[0, 12071], [4, 12200], [10, 12520], [15, 12860], [18, 13000], [23, 13220], [25, 13380], [35, 14020], [39, 14340], [45, 14560], [48, 14760], [52, 15060], [57, 15320], [61, 15440]]}, {"verse": 4, "start": 16788, "end": 19546, "text": "And the passover, a feast of the Jews, was near.", "words": [[0, 16788], [4, 16919], [8, 17019], [18, 17289], [20, 17559], [26, 18179], [29, 18279], [33, 18399], [39, 18719], [43, 18979]]}, {"verse": 5, "start": 19996, "end": 28458, "text": "¶ When Jesus then lifted up his eyes, and saw a great company come to him, he says to Philip, From where shall we buy bread, that these may eat?", "words": [[2, 19996], [7, 20143], [13, 20483], [18, 20803], [25, 21103], [28, 21343], [32, 21523], [38, 21843], [42, 22343], [46, 22583], [48, 22783], [54, 23003], [62, 23403], [67, 23743], [70, 23963], [75, 24563], [78, 24663], [83, 24883], [86, 25083], [94, 25769], [99, 25895], [105, 26095], [111, 26355], [114, 26495], [118, 26695], [125, 27115], [130, 27575], [136, 27775], [140, 28035]]}, {"verse": 6, "start": 28808, "end": 32854, "text": "And this he said to prove him: for he himself knew what he would do.", "words": [[0, 28808], [4, 28960], [9, 29160], [12, 29300], [17, 29540], [20, 29700], [26, 29980], [31, 30762], [35, 30853], [38, 31033], [46, 31493], [51, 31813], [56, 32033], [59, 32173], [65, 32353]]}, {"verse": 7, "start": 33304, "end": 40378, "text": "Philip answered him, Two hundred denarii worth of bread is not sufficient for them, that every one of them may take a little.", "words": [[0, 33304], [7, 33527], [16, 33947], [21, 34996], [25, 35306], [33, 35616], [41, 35926], [47, 36126], [50, 36326], [56, 36586], [59, 36846], [63, 37066], [74, 37506], [78, 37766], [84, 38306], [89, 38506], [95, 38846], [99, 39066], [102, 39186], [107, 39386], [111, 39626], [116, 39906], [118, 40066]]}, {"verse": 8, "start": 40728, "end": 44845, "text": "One of his disciples, Andrew, Simon Peter’s brother, says to him,", "words": [[0, 40728], [4, 40852], [7, 40952], [11, 41072], [22, 41992], [30, 42732], [36, 42992], [44, 43512], [53, 44072], [58, 44252], [61, 44492]]}, {"verse": 9, "start": 45095, "end": 50905, "text": "There is a lad here, which has five barley loaves, and two small fishes: but what are they among so many?", "words": [[0, 45095], [6, 45252], [9, 45412], [11, 45592], [15, 45712], [21, 46032], [27, 46312], [31, 46492], [36, 46732], [43, 47132], [51, 47572], [55, 47852], [59, 48012], [65, 48272], [73, 49269], [77, 49405], [82, 49565], [86, 49665], [91, 49905], [97, 50225], [100, 50525]]}, {"verse": 10, "start": 51255, "end": 59537, "text": "And Jesus said, Make the men sit down. Now there was much grass in the place. So the men sat down, in number about five thousand.", "words": [[0, 51255], [4, 51377], [10, 51697], [16, 52624], [21, 52821], [25, 53001], [29, 53221], [33, 53461], [39, 54375], [43, 54576], [49, 54736], [53, 54876], [58, 55076], [64, 55396], [67, 55636], [71, 55716], [78, 56497], [81, 56641], [85, 56801], [89, 56981], [93, 57301], [99, 57681], [102, 57981], [109, 58281], [115, 58705], [120, 59130]]}, {"verse": 11, "start": 59987, "end": 70750, "text": "And Jesus took the loaves; and when he had given thanks, he distributed to the disciples, and the disciples to them that were set down; and likewise of the fishes as much as they would.", "words": [[0, 59987], [4, 60133], [10, 60433], [15, 60733], [19, 60933], [27, 61809], [31, 61937], [36, 62097], [39, 62277], [43, 62377], [49, 62617], [57, 63377], [60, 63457], [72, 64017], [75, 64297], [79, 64457], [90, 64957], [94, 65617], [98, 65757], [108, 66217], [111, 66497], [116, 66757], [121, 66957], [126, 67077], [130, 67297], [136, 68085], [140, 68229], [149, 68609], [152, 68929], [156, 69049], [163, 69369], [166, 69749], [171, 69969], [174, 70109], [179, 70249]]}, {"verse": 12, "start": 71200, "end": 77263, "text": "When they were filled, he said to his disciples, Gather up the fragments that remain, that nothing be lost.", "words": [[0, 71200], [5, 71349], [10, 71489], [15, 71629], [23, 72389], [26, 72509], [31, 72729], [34, 72889], [38, 73029], [49, 74089], [56, 74273], [59, 74553], [63, 74673], [73, 75013], [78, 75333], [86, 76053], [91, 76193], [99, 76453], [102, 76733]]}, {"verse": 13, "start": 77613, "end": 85477, "text": "Therefore they gathered them together, and filled twelve baskets with the fragments of the five barley loaves, which remained over and above to them that had eaten.", "words": [[0, 77613], [10, 78005], [15, 78125], [24, 78445], [29, 78685], [39, 79045], [43, 79405], [50, 79645], [57, 79965], [65, 80485], [70, 80705], [74, 80865], [84, 81205], [87, 81485], [91, 81605], [96, 81865], [103, 82245], [111, 83005], [117, 83205], [126, 83565], [131, 83945], [135, 84125], [141, 84325], [144, 84545], [149, 84745], [154, 84945], [158, 85085]]}, {"verse": 14, "start": 85927, "end": 93211, "text": "Then those men, when they had seen the miracle that Jesus did, said, This is of a truth that prophet that should come into the world.", "words": [[0, 85927], [5, 86175], [11, 86455], [16, 86995], [21, 87115], [26, 87275], [30, 87415], [35, 87675], [39, 87875], [47, 88275], [52, 88575], [58, 88855], [63, 89415], [69, 90045], [74, 90244], [77, 90384], [80, 90544], [82, 90664], [88, 91124], [93, 91264], [101, 91644], [106, 91924], [113, 92064], [118, 92384], [123, 92604], [127, 92764]]}, {"verse": 15, "start": 93561, "end": 101747, "text": "¶ When Jesus therefore perceived that they would come and take him by force, to make him a king, he departed again into a mountain himself alone.", "words": [[2, 93561], [7, 93728], [13, 94088], [23, 94608], [33, 95168], [38, 95448], [43, 95588], [49, 95768], [54, 96048], [58, 96188], [63, 96428], [67, 96588], [70, 96788], [77, 97288], [80, 97608], [85, 97828], [89, 97968], [91, 98068], [97, 98848], [100, 98968], [109, 99388], [115, 99808], [120, 100088], [122, 100268], [131, 100528], [139, 101028]]}, {"verse": 16, "start": 102197, "end": 106165, "text": "And when even was now come, his disciples went down to the sea,", "words": [[0, 102197], [4, 102335], [9, 102495], [14, 102855], [18, 103115], [22, 103375], [28, 103995], [32, 104135], [42, 104715], [47, 105055], [52, 105355], [55, 105535], [59, 105655]]}, {"verse": 17, "start": 106615, "end": 113733, "text": "And entered into a ship, and went over the sea toward Capernaum. And it was now dark, and Jesus was not come to them.", "words": [[0, 106615], [4, 106780], [12, 107040], [17, 107380], [19, 107540], [25, 107840], [29, 108320], [34, 108500], [39, 108780], [43, 108960], [47, 109220], [54, 109580], [65, 110766], [69, 110892], [72, 110952], [76, 111092], [80, 111312], [86, 111892], [90, 112252], [96, 112512], [100, 112792], [104, 112992], [109, 113252], [112, 113432]]}, {"verse": 18, "start": 114183, "end": 117430, "text": "And the sea arose by reason of a great wind that blew.", "words": [[0, 114183], [4, 114348], [8, 114468], [12, 114748], [18, 115088], [21, 115368], [28, 115728], [31, 115928], [33, 116028], [39, 116248], [44, 116588], [49, 116908]]}, {"verse": 19, "start": 117880, "end": 127042, "text": "So when they had rowed about five and twenty or thirty furlongs, they see Jesus walking on the sea, and drawing near to the ship: and they were afraid.", "words": [[0, 117880], [3, 118085], [8, 118305], [13, 118465], [17, 118655], [23, 118845], [29, 119165], [34, 119565], [38, 119785], [45, 120125], [48, 120345], [55, 120665], [65, 121845], [70, 122025], [74, 122265], [80, 122665], [88, 123165], [91, 123445], [95, 123605], [100, 123885], [104, 124385], [112, 124685], [117, 124965], [120, 125125], [124, 125245], [130, 125971], [134, 126098], [139, 126198], [144, 126398]]}, {"verse": 20, "start": 127492, "end": 131219, "text": "But he says to them, It is I; be not afraid.", "words": [[0, 127492], [4, 127896], [7, 127996], [12, 128196], [15, 128416], [21, 129039], [24, 129168], [27, 129388], [30, 130295], [33, 130374], [37, 130554]]}, {"verse": 21, "start": 131569, "end": 137284, "text": "Then they willingly received him into the ship: and immediately the ship was at the land where they went.", "words": [[0, 131569], [5, 131697], [10, 131857], [20, 132217], [29, 132797], [33, 133157], [38, 133397], [42, 133557], [48, 134290], [52, 134436], [64, 134776], [68, 135276], [73, 135476], [77, 135716], [80, 135876], [84, 136016], [89, 136396], [95, 136636], [100, 136796]]}, {"verse": 22, "start": 137734, "end": 151131, "text": "¶ The day following, when the people which stood on the other side of the sea saw that there was none other boat there, save that one into which his disciples were entered, and that Jesus went not with his disciples into the boat, but that his disciples were gone away alone;", "words": [[2, 137734], [6, 137854], [10, 138014], [21, 138374], [26, 138714], [30, 138854], [37, 139134], [43, 139334], [49, 139574], [52, 139754], [56, 139874], [62, 140014], [67, 140294], [70, 140414], [74, 140494], [78, 140714], [82, 141034], [87, 141234], [93, 141374], [97, 141534], [102, 141754], [108, 141994], [113, 142214], [120, 142967], [125, 143147], [130, 143407], [134, 143607], [139, 143827], [145, 144087], [149, 144207], [159, 144687], [164, 144947], [173, 145647], [177, 145827], [182, 145987], [188, 146267], [193, 146627], [197, 146887], [202, 147127], [206, 147247], [216, 147767], [221, 148027], [225, 148187], [231, 148727], [235, 148907], [240, 149067], [244, 149247], [254, 149747], [259, 149987], [264, 150227], [269, 150507]]}, {"verse": 23, "start": 151581, "end": 159048, "text": "(However there came other boats from Tiberias near to the place where they did eat bread, after that the Lord had given thanks:)", "words": [[0, 151581], [9, 152061], [15, 152141], [20, 152381], [26, 152661], [32, 153001], [37, 153221], [46, 153941], [51, 154241], [54, 154401], [58, 154481], [64, 154761], [70, 155021], [75, 155221], [79, 155521], [83, 155801], [90, 156701], [96, 157121], [101, 157381], [105, 157581], [110, 157801], [114, 158001], [120, 158241]]}, {"verse": 24, "start": 159498, "end": 167941, "text": "When the people therefore saw that Jesus was not there, neither his disciples, they also took shipping, and came to Capernaum, seeking for Jesus.", "words": [[0, 159498], [5, 159622], [9, 159722], [16, 160002], [26, 160362], [30, 160762], [35, 160942], [41, 161222], [45, 161522], [49, 161722], [56, 162382], [64, 162622], [68, 162902], [79, 163942], [84, 164122], [89, 164402], [94, 164642], [104, 164982], [108, 165582], [113, 165802], [116, 166002], [127, 166642], [135, 166922], [139, 167222]]}, {"verse": 25, "start": 168391, "end": 175485, "text": "And when they had found him on the other side of the sea, they said to him, Rabbi, when did you come here?", "words": [[0, 168391], [4, 168515], [9, 168655], [14, 168855], [18, 168975], [24, 169295], [28, 169475], [31, 169615], [35, 169775], [41, 169935], [46, 170275], [49, 170415], [53, 170535], [58, 171475], [63, 171635], [68, 171875], [71, 172075], [76, 173960], [83, 174500], [88, 174580], [92, 174740], [96, 174860], [101, 175100]]}, {"verse": 26, "start": 175835, "end": 184946, "text": "Jesus answered them and said, Most assuredly, I say to you, You seek me, not because you saw the miracles, but because you did eat of the loaves, and were filled.", "words": [[0, 175835], [6, 176135], [15, 176655], [20, 176935], [24, 177095], [30, 177773], [35, 177938], [46, 178558], [48, 178678], [52, 178918], [55, 179118], [60, 179638], [64, 179798], [69, 180038], [73, 180518], [77, 180678], [85, 180958], [89, 181138], [93, 181338], [97, 181458], [107, 182238], [111, 182358], [119, 182638], [123, 182858], [127, 183098], [131, 183318], [134, 183478], [138, 183578], [146, 184058], [150, 184258], [155, 184398]]}, {"verse": 27, "start": 185396, "end": 195030, "text": "Labour not for the food which perishes, but for that food which endures to everlasting life, which the Son of man shall give to you: for him has God the Father sealed.", "words": [[0, 185520], [7, 185680], [11, 185960], [15, 186180], [19, 186280], [24, 186560], [30, 186760], [40, 187640], [44, 188000], [48, 188160], [53, 188320], [58, 188620], [64, 188860], [72, 189320], [75, 189440], [87, 189860], [93, 190860], [99, 191040], [103, 191220], [107, 191460], [110, 191580], [114, 191820], [120, 192040], [125, 192220], [128, 192400], [133, 193010], [137, 193115], [141, 193355], [145, 193615], [149, 193935], [153, 194115], [160, 194395]]}, {"verse": 28, "start": 195380, "end": 199624, "text": "Then said they to him, What shall we do, that we might work the works of God?", "words": [[0, 195380], [5, 195621], [10, 195940], [15, 196160], [18, 196360], [23, 196960], [28, 197094], [34, 197314], [37, 197454], [41, 197854], [46, 197974], [49, 198134], [55, 198314], [60, 198594], [64, 198754], [70, 198974], [73, 199134]]}, {"verse": 29, "start": 199974, "end": 206019, "text": "Jesus answered and said to them, This is the work of God, that you believe on him whom he has sent.", "words": [[0, 199974], [6, 200219], [15, 200759], [19, 200979], [24, 201179], [27, 201359], [33, 202078], [38, 202390], [41, 202670], [45, 202810], [50, 203030], [53, 203190], [58, 203470], [63, 204050], [67, 204190], [75, 204490], [78, 204730], [82, 204910], [87, 205190], [90, 205390], [94, 205590]]}, {"verse": 30, "start": 206369, "end": 212223, "text": "They said therefore to him, What sign do you show then, that we may see, and believe you? what do you work?", "words": [[0, 206369], [5, 206481], [10, 206721], [20, 207161], [23, 207441], [28, 208292], [33, 208411], [38, 208711], [41, 208871], [45, 208951], [50, 209171], [56, 209391], [61, 209631], [64, 209791], [68, 209931], [73, 210251], [77, 210611], [85, 210871], [90, 211493], [95, 211632], [98, 211732], [102, 211812]]}, {"verse": 31, "start": 212673, "end": 218263, "text": "Our fathers did eat manna in the desert; as it is written, He gave them bread from heaven to eat.", "words": [[0, 212673], [4, 212796], [12, 213136], [16, 213396], [20, 213666], [26, 213936], [29, 214156], [33, 214256], [41, 214948], [44, 215128], [47, 215268], [50, 215388], [59, 216288], [62, 216368], [67, 216568], [72, 216768], [78, 217028], [83, 217268], [90, 217548], [93, 217788]]}, {"verse": 32, "start": 218613, "end": 228748, "text": "Then Jesus said to them, Most assuredly, I say to you, Moses gave you not that bread from heaven; but my Father gives you the true bread from heaven.", "words": [[0, 218613], [5, 218818], [11, 219098], [16, 219498], [19, 219678], [25, 221807], [30, 221987], [41, 222647], [43, 222807], [47, 223047], [50, 223227], [55, 223727], [61, 224047], [66, 224367], [70, 224547], [74, 224747], [79, 225007], [85, 225247], [90, 225487], [98, 226278], [102, 226375], [105, 226535], [112, 226835], [118, 227155], [122, 227335], [126, 227455], [131, 227715], [137, 228015], [142, 228275]]}, {"verse": 33, "start": 229198, "end": 234087, "text": "For the bread of God is he which comes down from heaven, and gives life to the world.", "words": [[0, 229198], [4, 229311], [8, 229451], [14, 229711], [17, 229871], [21, 230191], [24, 230571], [27, 230831], [33, 231131], [39, 231431], [44, 231751], [49, 231991], [57, 232291], [61, 232671], [67, 232891], [72, 233231], [75, 233451], [79, 233551]]}, {"verse": 34, "start": 234437, "end": 238061, "text": "Then said they to him, Lord, evermore give us this bread.", "words": [[0, 234437], [5, 234678], [10, 234998], [15, 235218], [18, 235418], [23, 236018], [29, 236264], [38, 236884], [43, 237244], [46, 237384], [51, 237584]]}, {"verse": 35, "start": 238411, "end": 246981, "text": "And Jesus said to them, I am the bread of life: he that comes to me shall never hunger; and he that believes on me shall never thirst.", "words": [[0, 238411], [4, 238536], [10, 238876], [15, 239276], [18, 239456], [24, 240050], [26, 240327], [29, 240547], [33, 240667], [39, 240887], [42, 241047], [48, 241901], [51, 242086], [56, 242306], [62, 242586], [65, 242826], [68, 242966], [74, 243226], [80, 243546], [88, 244439], [92, 244543], [95, 244723], [100, 244903], [109, 245283], [112, 245523], [115, 245723], [121, 246003], [127, 246303]]}, {"verse": 36, "start": 247431, "end": 251397, "text": "But I said to you, That you also have seen me, and believe not.", "words": [[0, 247431], [4, 247534], [6, 247674], [11, 247934], [14, 248154], [19, 248394], [24, 248794], [28, 248954], [33, 249314], [38, 249594], [43, 249834], [47, 250094], [51, 250474], [59, 250774]]}, {"verse": 37, "start": 251847, "end": 258178, "text": "All that the Father gives me shall come to me; and him that comes to me I will by no means cast out.", "words": [[0, 251847], [4, 252051], [9, 252231], [13, 252371], [20, 252631], [26, 252971], [29, 253231], [35, 253491], [40, 253751], [43, 253951], [47, 254538], [51, 254702], [55, 254942], [60, 255142], [66, 255422], [69, 255642], [72, 256102], [74, 256402], [79, 256542], [82, 256722], [85, 256962], [91, 257242], [96, 257582]]}, {"verse": 38, "start": 258628, "end": 263316, "text": "For I came down from heaven, not to do my own will, but the will of him that sent me.", "words": [[0, 258628], [4, 258751], [6, 258891], [11, 259131], [16, 259391], [21, 259611], [29, 260311], [33, 260571], [36, 260771], [39, 260891], [42, 261091], [46, 261271], [52, 261791], [56, 262031], [60, 262171], [65, 262331], [68, 262491], [72, 262611], [77, 262771], [82, 262991]]}, {"verse": 39, "start": 263766, "end": 271485, "text": "And this is the Father’s will which has sent me, that of all which he has given me I should lose nothing, but should raise it up again at the last day.", "words": [[0, 263766], [4, 263922], [9, 264202], [12, 264422], [16, 264562], [25, 265062], [30, 265422], [36, 265562], [40, 265702], [45, 265982], [49, 266462], [54, 266622], [57, 266762], [61, 267022], [67, 267242], [70, 267362], [74, 267542], [80, 267742], [83, 268002], [85, 268142], [92, 268322], [97, 268562], [106, 269497], [110, 269576], [117, 269736], [123, 269996], [126, 270136], [129, 270276], [135, 270536], [138, 270696], [142, 270796], [147, 271076]]}, {"verse": 40, "start": 271935, "end": 281466, "text": "And this is the will of him that sent me, that every one which sees the Son, and believes on him, may have everlasting life: and I will raise him up at the last day.", "words": [[0, 271935], [4, 272079], [9, 272299], [12, 272439], [16, 272599], [21, 272759], [24, 272939], [28, 273099], [33, 273319], [38, 273579], [42, 274239], [47, 274392], [53, 274546], [57, 274699], [63, 275159], [68, 275419], [72, 275659], [77, 276019], [81, 276399], [90, 276699], [93, 276999], [98, 277239], [102, 277719], [107, 277939], [119, 278279], [125, 279337], [129, 279481], [131, 279641], [136, 279801], [142, 280081], [146, 280281], [149, 280481], [152, 280601], [156, 280701], [161, 281021]]}, {"verse": 41, "start": 281816, "end": 287379, "text": "The Jews then murmured at him, because he said, I am the bread which came down from heaven.", "words": [[0, 281816], [4, 281983], [9, 282283], [14, 282543], [23, 283023], [26, 283163], [31, 283403], [39, 283983], [42, 284263], [48, 284883], [50, 285263], [53, 285463], [57, 285603], [63, 285903], [69, 286163], [74, 286423], [79, 286683], [84, 286903]]}, {"verse": 42, "start": 287829, "end": 295597, "text": "And they said, Is not this Jesus, the son of Joseph, whose father and mother we know? how is it then that he says, I came down from heaven?", "words": [[0, 287829], [4, 287973], [9, 288113], [15, 288824], [18, 288993], [22, 289173], [27, 289373], [34, 289933], [38, 290033], [42, 290273], [45, 290373], [53, 291053], [59, 291153], [66, 291553], [70, 291853], [77, 292113], [80, 292313], [86, 292982], [90, 293148], [93, 293308], [96, 293428], [101, 293568], [106, 293748], [109, 293868], [115, 294368], [117, 294608], [122, 294788], [127, 295008], [132, 295188]]}, {"verse": 43, "start": 295947, "end": 300472, "text": "Jesus therefore answered and said to them, Murmur not among yourselves.", "words": [[0, 295947], [6, 296239], [16, 296758], [25, 297258], [29, 297578], [34, 297778], [37, 297939], [43, 298562], [50, 298987], [54, 299247], [60, 299587]]}, {"verse": 44, "start": 300922, "end": 307091, "text": "No man can come to me, except the Father which has sent me draw him: and I will raise him up at the last day.", "words": [[0, 300922], [3, 301119], [7, 301399], [11, 301639], [16, 301899], [19, 302099], [23, 302339], [30, 302839], [34, 303099], [41, 303379], [47, 303639], [51, 303819], [56, 304019], [59, 304179], [64, 304459], [69, 305168], [73, 305271], [75, 305391], [80, 305511], [86, 305751], [90, 305931], [93, 306111], [96, 306231], [100, 306351], [105, 306611]]}, {"verse": 45, "start": 307541, "end": 315353, "text": "It is written in the prophets, And they shall be all taught of God. Every man therefore that has heard, and has learned of the Father, comes to me.", "words": [[0, 307541], [3, 307662], [6, 307802], [14, 308062], [17, 308262], [21, 308362], [31, 309222], [35, 309362], [40, 309522], [46, 309742], [49, 309902], [53, 310182], [60, 310442], [63, 310602], [68, 311356], [74, 311614], [78, 312074], [88, 312554], [93, 312614], [97, 312794], [104, 313114], [108, 313454], [112, 313614], [120, 313894], [123, 314054], [127, 314174], [135, 314454], [141, 314854], [144, 315094]]}, {"verse": 46, "start": 315803, "end": 321142, "text": "Not that any man has seen the Father, save he which is of God, he has seen the Father.", "words": [[0, 315803], [4, 316063], [9, 316323], [13, 316563], [17, 316883], [21, 317083], [26, 317343], [30, 317483], [38, 318203], [43, 318503], [46, 318783], [52, 319063], [55, 319203], [58, 319323], [63, 320003], [66, 320143], [70, 320323], [75, 320543], [79, 320703]]}, {"verse": 47, "start": 321592, "end": 326090, "text": "Most assuredly, I say to you, He that believes on me has everlasting life.", "words": [[0, 321592], [5, 321812], [16, 322492], [18, 322672], [22, 322892], [25, 323072], [30, 323512], [33, 323712], [38, 323932], [47, 324232], [50, 324512], [53, 324692], [57, 324932], [69, 325312]]}, {"verse": 48, "start": 326540, "end": 327938, "text": "I am that bread of life.", "words": [[0, 326540], [2, 326729], [5, 326889], [10, 327089], [16, 327309], [19, 327449]]}, {"verse": 49, "start": 328388, "end": 331411, "text": "Your fathers did eat manna in the wilderness, and are dead.", "words": [[0, 328388], [5, 328490], [13, 328850], [17, 329170], [21, 329330], [27, 329730], [30, 329890], [34, 329990], [46, 330370], [50, 330830], [54, 330930]]}, {"verse": 50, "start": 331861, "end": 336811, "text": "This is the bread which comes down from heaven, that a man may eat of it, and not die.", "words": [[0, 331861], [5, 332129], [8, 332329], [12, 332489], [18, 332709], [24, 332969], [30, 333209], [35, 333509], [40, 333709], [48, 334009], [53, 334569], [55, 334689], [59, 334889], [63, 335129], [67, 335349], [70, 335509], [74, 335689], [78, 336009], [82, 336229]]}, {"verse": 51, "start": 337261, "end": 347015, "text": "I am the living bread which came down from heaven: if any man eat of this bread, he shall live for ever: and the bread that I will give is my flesh, which I will give for the life of the world.", "words": [[0, 337261], [2, 337497], [5, 337637], [9, 337777], [16, 338017], [22, 338357], [28, 338637], [33, 338857], [38, 339157], [43, 339377], [51, 340155], [54, 340297], [58, 340477], [62, 340737], [66, 340997], [69, 341137], [74, 341337], [81, 341837], [84, 341937], [90, 342117], [95, 342430], [99, 342744], [105, 343301], [109, 343398], [113, 343498], [119, 343718], [124, 343878], [126, 343998], [131, 344118], [136, 344378], [139, 344578], [142, 344758], [149, 345218], [155, 345358], [157, 345478], [162, 345598], [167, 345798], [171, 345978], [175, 346078], [180, 346318], [183, 346458], [187, 346538]]}, {"verse": 52, "start": 347365, "end": 353593, "text": "The Jews therefore strove among themselves, saying, How can this man give us his flesh to eat?", "words": [[0, 347365], [4, 347452], [9, 347852], [19, 348372], [26, 348812], [32, 348972], [44, 350032], [52, 351034], [56, 351230], [60, 351450], [65, 351690], [69, 351970], [74, 352230], [77, 352410], [81, 352590], [87, 352890], [90, 353150]]}, {"verse": 53, "start": 353943, "end": 363937, "text": "Then Jesus said to them, Most assuredly, I say to you, Unless you eat the flesh of the Son of man, and drink his blood, you have no life in you.", "words": [[0, 353943], [5, 354148], [11, 354428], [16, 354828], [19, 355008], [25, 357137], [30, 357365], [41, 358025], [43, 358185], [47, 358425], [50, 358625], [55, 359165], [62, 359445], [66, 359725], [70, 359905], [74, 360065], [80, 360305], [83, 360505], [87, 360645], [91, 360845], [94, 360965], [99, 361325], [103, 361745], [109, 361965], [113, 362145], [120, 362805], [124, 362905], [129, 363065], [132, 363225], [137, 363525], [140, 363705]]}, {"verse": 54, "start": 364387, "end": 370779, "text": "Whoever eats my flesh, and drinks my blood, has eternal life; and I will raise him up at the last day.", "words": [[0, 364387], [8, 364633], [13, 364953], [16, 365133], [23, 365573], [27, 365953], [34, 366193], [37, 366413], [44, 366813], [48, 367333], [56, 367713], [62, 368665], [66, 368965], [68, 369105], [73, 369245], [79, 369465], [83, 369665], [86, 369825], [89, 369945], [93, 370045], [98, 370345]]}, {"verse": 55, "start": 371229, "end": 374836, "text": "For my flesh is food indeed, and my blood is drink indeed.", "words": [[0, 371229], [4, 371332], [7, 371472], [13, 371812], [16, 372032], [21, 372272], [29, 372952], [33, 373312], [36, 373472], [42, 373752], [45, 373952], [51, 374212]]}, {"verse": 56, "start": 375286, "end": 380262, "text": "He that eats my flesh, and drinks my blood, dwells in me, and I in him.", "words": [[0, 375286], [3, 375458], [8, 375698], [13, 375878], [16, 376098], [23, 376858], [27, 376958], [34, 377218], [37, 377478], [44, 378178], [51, 378618], [54, 378718], [58, 379178], [62, 379298], [64, 379558], [67, 379818]]}, {"verse": 57, "start": 380712, "end": 387342, "text": "As the living Father has sent me, and I live by the Father: so he that eats me, even he shall live by me.", "words": [[0, 380712], [3, 380836], [7, 380956], [14, 381176], [21, 381496], [25, 381716], [30, 381976], [34, 382476], [38, 382556], [40, 382696], [45, 382916], [48, 383136], [52, 383276], [60, 384464], [63, 384667], [66, 384867], [71, 385067], [76, 385287], [80, 385907], [85, 386087], [88, 386387], [94, 386607], [99, 386807], [102, 387027]]}, {"verse": 58, "start": 387792, "end": 395959, "text": "This is that bread which came down from heaven: not as your fathers did eat manna, and are dead: he that eats of this bread shall live for ever.", "words": [[0, 387792], [5, 387991], [8, 388131], [13, 388311], [19, 388591], [25, 388851], [30, 389071], [35, 389291], [40, 389491], [48, 390258], [52, 390398], [55, 390558], [60, 390678], [68, 390978], [72, 391298], [76, 391418], [83, 391838], [87, 392098], [91, 392198], [97, 392899], [100, 393067], [105, 393367], [110, 393627], [113, 393867], [118, 394087], [124, 394467], [130, 394787], [135, 395194], [139, 395600]]}, {"verse": 59, "start": 396309, "end": 399943, "text": "These things said he in the synagogue, as he taught in Capernaum.", "words": [[0, 396309], [6, 396469], [13, 396789], [18, 397129], [21, 397329], [24, 397489], [28, 397589], [39, 398049], [42, 398529], [45, 398629], [52, 398889], [55, 399427]]}, {"verse": 60, "start": 400393, "end": 406077, "text": "Many therefore of his disciples, when they had heard this, said, This is a hard saying; who can hear it?", "words": [[0, 400393], [5, 400617], [15, 401037], [18, 401337], [22, 401477], [33, 402037], [38, 402437], [43, 402617], [47, 402777], [53, 402957], [59, 403217], [65, 403913], [70, 404093], [73, 404253], [75, 404353], [80, 404553], [88, 405369], [92, 405475], [96, 405655], [101, 405875]]}, {"verse": 61, "start": 406427, "end": 412423, "text": "When Jesus knew in himself that his disciples murmured at it, he said to them, Does this offend you?", "words": [[0, 406427], [5, 406550], [11, 406890], [16, 407270], [19, 407390], [27, 407790], [32, 408110], [36, 408230], [46, 408750], [55, 409350], [58, 409510], [62, 410050], [65, 410150], [70, 410410], [73, 410610], [79, 411313], [84, 411453], [89, 411673], [96, 412013]]}, {"verse": 62, "start": 412873, "end": 416817, "text": "What and if you shall see the Son of man ascend up where he was before?", "words": [[0, 412873], [5, 413139], [9, 413419], [12, 413679], [16, 413919], [22, 414119], [26, 414359], [30, 414499], [34, 414739], [37, 414839], [41, 415139], [48, 415419], [51, 415679], [57, 415859], [60, 415999], [64, 416199]]}, {"verse": 63, "start": 417267, "end": 425077, "text": "It is the spirit that gives life; the flesh profits nothing: the words that I speak to you, they are spirit, and they are life.", "words": [[0, 417267], [3, 417375], [6, 417515], [10, 417655], [17, 417995], [22, 418235], [28, 418455], [34, 419255], [38, 419352], [44, 419612], [52, 420052], [61, 420980], [65, 421084], [71, 421344], [76, 421564], [78, 421704], [84, 421964], [87, 422224], [92, 422804], [97, 423044], [101, 423224], [109, 423684], [113, 424224], [118, 424384], [122, 424544]]}, {"verse": 64, "start": 425527, "end": 433441, "text": "But there are some of you that believe not. For Jesus knew from the beginning who they were that believed not, and who should betray him.", "words": [[0, 425527], [4, 425727], [10, 425907], [14, 426027], [19, 426287], [22, 426447], [26, 426647], [31, 426867], [39, 427247], [44, 428274], [48, 428391], [54, 428751], [59, 429171], [64, 429371], [68, 429491], [78, 429851], [82, 430131], [87, 430331], [92, 430571], [97, 430771], [106, 431131], [111, 431951], [115, 432271], [119, 432451], [126, 432631], [133, 433051]]}, {"verse": 65, "start": 433891, "end": 441207, "text": "And he said, Therefore said I to you, that no man can come to me, unless it were given to him of my Father.", "words": [[0, 433891], [4, 434036], [7, 434136], [13, 434873], [23, 435260], [28, 435620], [30, 435880], [33, 436080], [38, 436800], [43, 437000], [46, 437280], [50, 437580], [54, 437800], [59, 438080], [62, 438300], [66, 438800], [73, 439100], [76, 439320], [81, 439440], [87, 439700], [90, 439940], [94, 440180], [97, 440420], [100, 440620]]}, {"verse": 66, "start": 441557, "end": 445998, "text": "¶ From that time many of his disciples went back, and walked no more with him.", "words": [[2, 441557], [7, 441681], [12, 441921], [17, 442321], [22, 442581], [25, 442781], [29, 442921], [39, 443441], [44, 443781], [50, 444081], [54, 444681], [61, 444941], [64, 445241], [69, 445501], [74, 445721]]}, {"verse": 67, "start": 446448, "end": 449954, "text": "Then said Jesus to the twelve, Will you also go away?", "words": [[0, 446448], [5, 446658], [10, 446938], [16, 447318], [19, 447638], [23, 447738], [31, 448571], [36, 448750], [40, 448910], [45, 449210], [48, 449470]]}, {"verse": 68, "start": 450304, "end": 455817, "text": "Then Simon Peter answered him, Lord, to whom shall we go? you have the words of eternal life.", "words": [[0, 450304], [5, 450550], [11, 450950], [17, 451330], [26, 451770], [31, 452462], [37, 452742], [40, 452962], [45, 453142], [51, 453382], [54, 453542], [58, 454223], [62, 454343], [67, 454503], [71, 454643], [77, 454883], [80, 455063], [88, 455363]]}, {"verse": 69, "start": 456267, "end": 460244, "text": "And we believe and are sure that you are that Christ, the Son of the living God.", "words": [[0, 456267], [4, 456373], [7, 456493], [15, 456873], [19, 457033], [23, 457133], [28, 457433], [33, 457653], [37, 457873], [41, 457993], [46, 458173], [54, 458913], [58, 459033], [62, 459293], [65, 459393], [69, 459513], [76, 459733]]}, {"verse": 70, "start": 460594, "end": 465366, "text": "Jesus answered them, Have not I chosen you twelve, and one of you is a devil?", "words": [[0, 460594], [6, 460871], [15, 461311], [21, 461970], [26, 462133], [30, 462333], [32, 462493], [39, 462813], [43, 463053], [51, 463893], [55, 463993], [59, 464213], [62, 464333], [66, 464513], [69, 464753], [71, 464873]]}, {"verse": 71, "start": 465716, "end": 472305, "text": "He spoke of Judas Iscariot the son of Simon: for he it was that should betray him, being one of the twelve.", "words": [[0, 465716], [3, 465802], [9, 466042], [12, 466282], [18, 466562], [27, 467582], [31, 467682], [35, 467922], [38, 468022], [45, 469053], [49, 469173], [52, 469673], [55, 469733], [59, 469953], [64, 470213], [71, 470413], [78, 470773], [83, 471153], [89, 471333], [93, 471553], [96, 471673], [100, 471753]]}]}