{"book": "JHN", "chapter": 21, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 248797, "verses": [{"verse": 1, "start": 300, "end": 8144, "text": "Después se manifestó Jesús otra vez a sus discípulos en el mar de Tiberias; y se manifestó de esta manera.", "words": [[0, 300], [8, 648], [11, 928], [21, 1628], [27, 1988], [32, 2368], [36, 2688], [38, 2808], [42, 3008], [53, 3828], [56, 4308], [59, 4448], [63, 4688], [66, 4868], [76, 6007], [78, 6275], [81, 6415], [91, 7135], [94, 7255], [99, 7435]]}, {"verse": 2, "start": 8494, "end": 20646, "text": "Estaban juntos Simón Pedro, y Tomás, llamado el Dídimo, y Natanael, el que era de Caná de Galilea, y los hijos de Zebedeo, y otros dos de sus discípulos.", "words": [[0, 8494], [8, 8875], [15, 9375], [21, 10055], [28, 10455], [30, 10715], [37, 11555], [45, 11995], [48, 12235], [56, 12820], [58, 13405], [68, 13990], [71, 14130], [75, 14270], [79, 14470], [82, 14650], [87, 14990], [90, 15090], [99, 15950], [101, 16290], [105, 16430], [111, 16730], [114, 17180], [123, 17630], [125, 17990], [131, 18230], [135, 18730], [138, 19250], [142, 19490]]}, {"verse": 3, "start": 20996, "end": 31487, "text": "Les dice Simón: A pescar voy. Le dicen: Vamos nosotros también contigo. Fueron, y subieron en una barca; y aquella noche no pescaron nada.", "words": [[0, 21045], [4, 21125], [9, 21405], [16, 22502], [18, 22643], [25, 23048], [30, 23685], [33, 23850], [40, 24677], [46, 24936], [55, 25476], [63, 25916], [72, 26970], [80, 27259], [82, 27479], [91, 27979], [94, 28139], [98, 28319], [105, 29234], [107, 29336], [115, 29636], [121, 29896], [124, 30256], [133, 30896]]}, {"verse": 4, "start": 31837, "end": 38302, "text": "Y venida la mañana, Jesús se puso a la ribera: pero los discípulos no reconocieron que era Jesús.", "words": [[0, 31837], [2, 31944], [9, 32304], [12, 32424], [20, 32804], [26, 33344], [29, 33744], [34, 34124], [36, 34204], [39, 34324], [47, 35240], [52, 35403], [56, 35623], [67, 36223], [70, 36523], [83, 37223], [87, 37443], [91, 37563]]}, {"verse": 5, "start": 38652, "end": 44315, "text": "Y les dijo: Muchachos, ¿tenéis algo de comer? Le respondieron: No.", "words": [[0, 38652], [2, 38884], [6, 39004], [12, 39933], [23, 41058], [31, 41538], [36, 41838], [39, 42018], [46, 42725], [49, 42866], [63, 43979]]}, {"verse": 6, "start": 44595, "end": 55861, "text": "Y él les dice: Echad la red al lado derecho de la barca, y hallaréis. Entonces la echaron, y no la podían en ninguna manera sacar, por la multitud de los peces.", "words": [[0, 44595], [2, 44836], [5, 45006], [9, 45176], [15, 45976], [21, 46463], [24, 46723], [28, 47003], [31, 47303], [36, 47543], [44, 47883], [47, 48143], [50, 48243], [57, 48603], [59, 48803], [70, 49751], [79, 50315], [82, 50615], [91, 51175], [93, 51595], [96, 51735], [99, 51855], [106, 52355], [109, 52635], [117, 53035], [124, 53375], [131, 53815], [135, 54250], [138, 54410], [147, 54970], [150, 55130], [154, 55230]]}, {"verse": 7, "start": 56211, "end": 69942, "text": "Entonces aquel discípulo, al cual amaba Jesús, dijo a Pedro: El Señor es. Y Simón Pedro, cuando oyó que era el Señor, se ciñó la ropa, porque estaba desnudo, y se echó al mar.", "words": [[0, 56211], [9, 56775], [15, 57415], [26, 58195], [29, 58495], [34, 58735], [40, 59255], [47, 60195], [52, 60415], [54, 60595], [61, 61278], [64, 61440], [70, 61780], [74, 62764], [76, 62924], [82, 63084], [89, 63444], [96, 63844], [100, 64424], [104, 64604], [108, 64844], [111, 64964], [118, 65744], [121, 65884], [126, 66244], [129, 66364], [135, 67104], [142, 67404], [149, 67704], [158, 68284], [160, 68724], [163, 68864], [168, 69224], [171, 69524]]}, {"verse": 8, "start": 70292, "end": 79928, "text": "Y los otros discípulos vinieron con el barco (porque no estaban lejos de tierra sino como doscientos codos), trayendo la red de peces.", "words": [[0, 70292], [2, 70377], [6, 70557], [12, 70837], [23, 71537], [32, 72257], [36, 72477], [39, 72677], [45, 73197], [53, 73592], [56, 73872], [64, 74252], [70, 74852], [73, 75112], [80, 75512], [85, 75872], [90, 76222], [101, 76572], [109, 77792], [118, 78612], [121, 78792], [125, 79072], [128, 79531]]}, {"verse": 9, "start": 80278, "end": 87222, "text": "Y como descendieron a tierra, vieron unas brasas preparadas, y un pez encima de ellas, y pan.", "words": [[0, 80278], [2, 80374], [7, 80594], [20, 81354], [22, 81534], [30, 82294], [37, 82774], [42, 83074], [49, 83374], [61, 84314], [63, 85114], [66, 85274], [70, 85594], [77, 86074], [80, 86274], [87, 86494], [89, 86714]]}, {"verse": 10, "start": 87572, "end": 91893, "text": "Les dice Jesús: Traed de los peces que pescasteis ahora.", "words": [[0, 87572], [4, 87753], [9, 88033], [16, 89241], [22, 89541], [25, 89861], [29, 90001], [35, 90381], [39, 90521], [50, 91341]]}, {"verse": 11, "start": 92243, "end": 103451, "text": "Subió Simón Pedro, y trajo la red a tierra, llena de grandes peces, ciento cincuenta y tres: y siendo tantos, la red no se rompió.", "words": [[0, 92243], [6, 92656], [12, 93056], [19, 93496], [21, 93736], [27, 94116], [30, 94276], [34, 94576], [36, 94836], [44, 95856], [50, 96376], [53, 96516], [61, 96816], [68, 97404], [75, 97992], [85, 98580], [87, 99169], [93, 99936], [95, 100052], [102, 100352], [110, 101592], [113, 101692], [117, 101992], [120, 102472], [123, 102632]]}, {"verse": 12, "start": 103801, "end": 112838, "text": "Les dice Jesús: Venid, comed. Y ninguno de los discípulos se atrevía a preguntarle: ¿Tú, quién eres? sabiendo que era el Señor.", "words": [[0, 103801], [4, 103949], [9, 104229], [16, 105561], [23, 105950], [30, 106561], [32, 106641], [40, 107061], [43, 107161], [47, 107281], [58, 107961], [61, 108341], [69, 108721], [71, 108761], [84, 109869], [89, 110267], [95, 110587], [101, 111332], [110, 111775], [114, 112015], [118, 112115], [121, 112275]]}, {"verse": 13, "start": 113188, "end": 117530, "text": "Viene pues Jesús, y toma el pan, y les da; y asimismo del pez.", "words": [[0, 113188], [6, 113474], [11, 113654], [18, 114074], [20, 114374], [25, 114594], [28, 114734], [33, 115014], [35, 115254], [39, 115414], [43, 116050], [45, 116178], [54, 116738], [58, 116918]]}, {"verse": 14, "start": 117880, "end": 124587, "text": "Esta era ya la tercera vez que Jesús se manifestó a sus discípulos, habiendo resucitado de los muertos.", "words": [[0, 117880], [5, 118185], [9, 118385], [12, 118605], [15, 118745], [23, 119245], [27, 119445], [31, 119625], [37, 119965], [40, 120345], [50, 121005], [52, 121105], [56, 121265], [68, 122052], [77, 122838], [88, 123625], [91, 123765], [95, 123845]]}, {"verse": 15, "start": 124937, "end": 137838, "text": "Y cuando hubieron comido, Jesús dijo a Simón Pedro: Simón, hijo de Jonás, ¿me amas más que estos? Le dice: Sí, Señor: tú sabes que te amo. Le dice: Apacienta mis corderos.", "words": [[0, 124937], [2, 125027], [9, 125267], [18, 125787], [26, 126307], [32, 126627], [37, 127047], [39, 127227], [45, 127607], [52, 128443], [59, 129203], [64, 129343], [67, 129523], [74, 130263], [78, 130413], [83, 130563], [87, 130783], [91, 130983], [98, 131839], [101, 131978], [107, 132777], [111, 133072], [118, 133772], [121, 133856], [127, 134156], [131, 134356], [134, 134496], [139, 135173], [142, 135383], [148, 136174], [158, 136834], [162, 137336]]}, {"verse": 16, "start": 138188, "end": 149132, "text": "Le vuelve a decir la segunda vez: Simón, hijo de Jonás, ¿me amas? Le responde: Sí, Señor: tú sabes que te amo. Le dice: Apacienta mis ovejas.", "words": [[0, 138188], [3, 138285], [10, 138665], [12, 138745], [18, 138985], [21, 139245], [29, 139545], [34, 140372], [41, 141379], [46, 141519], [49, 141719], [56, 142319], [60, 142459], [66, 143169], [69, 143349], [79, 144307], [83, 144616], [90, 145204], [93, 145350], [99, 145570], [103, 145790], [106, 145930], [111, 146542], [114, 146682], [120, 147493], [130, 148174], [134, 148314]]}, {"verse": 17, "start": 149482, "end": 168096, "text": "Le dice la tercera vez: Simón, hijo de Jonás, ¿me amas? Se entristeció Pedro de que le dijese la tercera vez: ¿Me amas? y le dice: Señor, tú sabes todas las cosas; tú sabes que te amo. Le dice Jesús: Apacienta mis ovejas.", "words": [[0, 149482], [3, 149662], [8, 149962], [11, 150162], [19, 150622], [24, 151402], [31, 152179], [36, 152439], [39, 152579], [46, 153199], [50, 153339], [56, 154111], [59, 154296], [71, 155336], [77, 155896], [80, 156516], [84, 156636], [87, 156776], [94, 157316], [97, 157496], [105, 158036], [110, 158760], [114, 159009], [120, 160032], [122, 160140], [125, 160260], [131, 161065], [138, 161628], [141, 161748], [147, 162108], [153, 162528], [157, 162888], [164, 163818], [167, 163920], [173, 164200], [177, 164420], [180, 164560], [185, 165240], [188, 165387], [193, 165607], [200, 166849], [210, 167199], [214, 167339]]}, {"verse": 18, "start": 168446, "end": 182214, "text": "De cierto, de cierto te digo: Cuando eras más joven, te ceñías, e ibas donde querías; pero cuando ya seas viejo, extenderás tus manos, y te ceñirá otro, y te llevará a donde no quieras.", "words": [[0, 168655], [3, 168899], [11, 169143], [14, 169387], [21, 169631], [24, 169871], [30, 170588], [37, 170792], [42, 171132], [46, 171312], [53, 171825], [56, 172339], [64, 172852], [66, 173047], [71, 173307], [77, 173507], [86, 174534], [91, 174659], [98, 174919], [101, 175259], [106, 175639], [113, 176599], [124, 177539], [128, 177699], [135, 178159], [137, 178619], [140, 178929], [147, 179239], [153, 179659], [155, 180159], [158, 180299], [166, 180819], [168, 180979], [174, 181159], [177, 181439]]}, {"verse": 19, "start": 182564, "end": 189930, "text": "Y esto dijo, dando a entender con qué muerte había de glorificar a Dios. Y dicho esto, le dice: Sígueme.", "words": [[0, 182564], [2, 182883], [7, 183083], [13, 183403], [19, 183763], [21, 183943], [30, 184383], [34, 184783], [38, 185063], [45, 185463], [51, 185843], [54, 186063], [65, 186703], [67, 186883], [73, 187735], [75, 187842], [81, 188102], [87, 188382], [90, 188562], [96, 189314]]}, {"verse": 20, "start": 190280, "end": 203717, "text": "Volviéndose Pedro, ve a aquel discípulo al cual amaba Jesús, que seguía, el que también se había recostado a su pecho en la cena, y le había dicho: Señor, ¿quién es el que te ha de entregar?", "words": [[0, 190280], [12, 191026], [19, 191746], [22, 191886], [24, 192126], [30, 192446], [40, 193106], [43, 193406], [48, 193606], [54, 194126], [61, 194886], [65, 194886], [73, 195486], [76, 195926], [80, 196046], [88, 196386], [91, 196606], [97, 196846], [107, 197546], [109, 197646], [112, 197786], [118, 198126], [121, 198246], [124, 198346], [130, 198686], [132, 199206], [135, 199326], [141, 199586], [148, 200418], [155, 201661], [162, 201941], [165, 202141], [168, 202281], [172, 202441], [175, 202721], [178, 202841], [181, 202961]]}, {"verse": 21, "start": 204067, "end": 208353, "text": "Así que Pedro vio a este, dice a Jesús: Señor, ¿y este, qué?", "words": [[0, 204067], [4, 204447], [8, 204627], [14, 204947], [18, 205267], [20, 205387], [26, 205887], [31, 206067], [33, 206267], [40, 207099], [47, 207762], [50, 207842], [56, 208022]]}, {"verse": 22, "start": 208633, "end": 214727, "text": "Le dice Jesús: Si quiero que él quede hasta que yo venga, ¿qué te importa a ti? Sígueme tú.", "words": [[0, 208633], [3, 208798], [8, 209098], [15, 210056], [18, 210240], [25, 210560], [29, 210780], [32, 210920], [38, 211280], [44, 211460], [48, 211620], [51, 211780], [58, 212540], [63, 212620], [66, 212760], [74, 213100], [76, 213380], [80, 214126], [88, 214458]]}, {"verse": 23, "start": 215077, "end": 228565, "text": "Salió entonces este dicho entre los hermanos, que aquel discípulo no había de morir. Pero Jesús no le dijo, No morirá; sino: Si quiero que él quede hasta que yo venga ¿qué te importa a ti?", "words": [[0, 215077], [6, 215419], [15, 215959], [20, 216439], [26, 216779], [32, 217019], [36, 217219], [46, 217939], [50, 218199], [56, 218519], [66, 219219], [69, 219759], [75, 220059], [78, 220259], [85, 220998], [90, 221160], [96, 221520], [99, 222080], [102, 222220], [108, 223000], [111, 223260], [119, 224139], [125, 224910], [128, 225075], [135, 225435], [139, 225655], [142, 225835], [148, 226255], [154, 226435], [158, 226675], [161, 226855], [167, 227335], [172, 227415], [175, 227555], [183, 227955], [185, 228295]]}, {"verse": 24, "start": 228915, "end": 237282, "text": "Este es aquel discípulo que da testimonio de estas cosas, y escribió estas cosas: y sabemos que su testimonio es verdadero.", "words": [[0, 228915], [5, 229265], [8, 229505], [14, 229885], [24, 230525], [28, 230745], [31, 230865], [42, 231565], [45, 231665], [51, 231825], [58, 232325], [60, 233045], [69, 233605], [75, 233745], [82, 234746], [84, 235005], [92, 235285], [96, 235585], [99, 235725], [110, 236465], [113, 236545]]}, {"verse": 25, "start": 237632, "end": 248397, "text": "Y hay también otras muchas cosas que hizo Jesús, que si se escribiesen cada una por sí, ni aun en el mundo pienso que cabrían los libros que se habrían de escribir. Amén.", "words": [[0, 237632], [2, 237796], [6, 237896], [14, 238296], [20, 238696], [27, 239056], [33, 239516], [37, 239756], [42, 240016], [49, 240936], [53, 241036], [56, 241196], [59, 241396], [71, 242036], [76, 242376], [80, 242676], [84, 242896], [88, 243518], [91, 243608], [95, 243908], [98, 244128], [101, 244288], [107, 244588], [114, 245148], [118, 245288], [126, 245768], [130, 245948], [137, 246408], [141, 246508], [144, 246738], [152, 246968], [155, 247148], [165, 247851]]}]}