{"book": "JHN", "chapter": 6, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 516904, "verses": [{"verse": 1, "start": 300, "end": 6799, "text": "Pasadas estas cosas, Jesús fue al otro lado del mar de Galilea, que es de Tiberias.", "words": [[0, 300], [8, 788], [14, 1088], [21, 2128], [27, 2588], [31, 2993], [34, 3293], [39, 3533], [44, 3873], [48, 4153], [52, 4606], [55, 5060], [64, 5513], [68, 5553], [71, 5793], [74, 5933]]}, {"verse": 2, "start": 7149, "end": 12250, "text": "Y le seguía grande multitud, porque veían sus señales que hacía en los enfermos.", "words": [[0, 7149], [2, 7234], [5, 7354], [12, 7834], [19, 8394], [29, 8954], [36, 9534], [42, 10054], [46, 10254], [54, 10834], [58, 11001], [64, 11167], [67, 11334], [71, 11494]]}, {"verse": 3, "start": 12600, "end": 17516, "text": "Y subió Jesús a un monte, y se sentó allí con sus discípulos.", "words": [[0, 12600], [2, 12723], [8, 13123], [14, 13443], [16, 13743], [19, 13843], [26, 14303], [28, 15103], [31, 15223], [37, 15723], [42, 15943], [46, 16203], [50, 16463]]}, {"verse": 4, "start": 17866, "end": 21434, "text": "Y estaba cerca la Pascua, la fiesta de los judíos.", "words": [[0, 17866], [2, 18129], [9, 18409], [15, 18789], [18, 19049], [26, 19989], [29, 20069], [36, 20449], [39, 20589], [43, 20709]]}, {"verse": 5, "start": 21784, "end": 31411, "text": "Y como alzó Jesús los ojos, y vio que había venido a él grande multitud, dice a Felipe: ¿De dónde compraremos pan para que coman estos?", "words": [[0, 21784], [2, 21930], [7, 22230], [12, 22830], [18, 23130], [22, 23670], [28, 24490], [30, 24750], [34, 24950], [38, 25090], [44, 25290], [51, 25750], [53, 25850], [56, 25990], [63, 26330], [73, 27410], [78, 27730], [80, 27910], [88, 28661], [92, 28925], [98, 29125], [110, 29805], [114, 30165], [119, 30405], [123, 30565], [129, 30905]]}, {"verse": 6, "start": 31761, "end": 36327, "text": "Pero esto decía para probarle; porque él sabía lo que había de hacer.", "words": [[0, 31761], [5, 31941], [10, 32201], [16, 32861], [21, 33161], [31, 33971], [38, 34234], [41, 34534], [47, 34994], [50, 35154], [54, 35334], [60, 35574], [63, 35754]]}, {"verse": 7, "start": 36677, "end": 43534, "text": "Le respondió Felipe: Doscientos denarios de pan no les bastarán, para que cada uno de ellos tome un poco.", "words": [[0, 36677], [3, 36822], [13, 37562], [21, 38679], [32, 38869], [41, 39509], [44, 39689], [48, 39989], [51, 40229], [55, 40389], [65, 41029], [70, 41529], [74, 41689], [79, 41929], [83, 42209], [86, 42369], [92, 42629], [97, 42949], [100, 43049]]}, {"verse": 8, "start": 43814, "end": 48163, "text": "Le dice uno de sus discípulos, Andrés, hermano de Simón Pedro:", "words": [[0, 43814], [3, 43938], [8, 44218], [12, 44578], [15, 44738], [19, 44918], [31, 45818], [39, 46438], [47, 46918], [50, 47038], [56, 47418]]}, {"verse": 9, "start": 48363, "end": 54200, "text": "Un muchacho está aquí que tiene cinco panes de cebada y dos pececillos; ¿pero qué es esto entre tantos?", "words": [[0, 48363], [3, 48492], [12, 48932], [17, 49192], [22, 49432], [26, 49592], [32, 49832], [38, 50212], [44, 50692], [47, 50812], [54, 51292], [56, 51392], [60, 51937], [72, 52648], [78, 52774], [82, 52974], [85, 53114], [90, 53374], [96, 53534]]}, {"verse": 10, "start": 54480, "end": 65011, "text": "Entonces Jesús dijo: Haced recostar la gente. Y había mucha hierba en aquel lugar: y se recostaron como número de cinco mil varones.", "words": [[0, 54480], [9, 54996], [15, 55576], [21, 56571], [27, 56995], [36, 57735], [39, 57875], [46, 58744], [48, 58841], [54, 59001], [60, 59401], [67, 59981], [70, 60121], [76, 60421], [83, 61254], [85, 61474], [88, 61594], [99, 62374], [104, 62654], [111, 63154], [114, 63484], [120, 63814], [124, 64447]]}, {"verse": 11, "start": 65361, "end": 76836, "text": "Y tomó Jesús aquellos panes, y habiendo dado gracias, repartió a los discípulos, y los discípulos a los que estaban recostados: asimismo de los peces, cuanto querían.", "words": [[0, 65361], [2, 65485], [7, 65765], [13, 66065], [22, 66425], [29, 67125], [31, 67645], [40, 67945], [45, 68185], [54, 69445], [63, 69965], [65, 70045], [69, 70145], [81, 70865], [83, 71305], [87, 71445], [98, 72085], [100, 72465], [104, 72565], [108, 72665], [116, 73025], [128, 74645], [137, 74935], [140, 75055], [144, 75175], [151, 75625], [158, 76075]]}, {"verse": 12, "start": 77186, "end": 84814, "text": "Y como fueron saciados, dijo a sus discípulos: Recoged los pedazos que han quedado, porque no se pierda nada.", "words": [[0, 77186], [2, 77291], [7, 77491], [14, 77791], [24, 78871], [29, 79251], [31, 79471], [35, 79631], [47, 80740], [55, 81465], [59, 81665], [67, 82325], [71, 82425], [75, 82545], [84, 83085], [91, 83505], [94, 83745], [97, 83885], [104, 84285]]}, {"verse": 13, "start": 85164, "end": 93632, "text": "Recogieron pues, y llenaron doce cestas de pedazos de los cinco panes de cebada, que sobraron a los que habían comido.", "words": [[0, 85164], [11, 85789], [17, 86049], [19, 86429], [28, 86869], [33, 87349], [40, 87929], [43, 88029], [51, 88669], [54, 88789], [58, 88989], [64, 89489], [70, 90149], [73, 90269], [81, 90829], [85, 91369], [94, 92049], [96, 92289], [100, 92409], [104, 92549], [111, 92889]]}, {"verse": 14, "start": 93982, "end": 102456, "text": "Aquellos hombres entonces, cuando vieron la señal que Jesús había hecho, decían: Este verdaderamente es el profeta que había de venir al mundo.", "words": [[0, 93982], [9, 94401], [17, 94681], [27, 95601], [34, 95701], [41, 96121], [44, 96261], [50, 96681], [54, 96801], [60, 97081], [66, 97441], [73, 98081], [81, 99087], [86, 99328], [101, 100148], [104, 100448], [107, 100588], [115, 101028], [119, 101208], [125, 101408], [128, 101588], [134, 101788], [137, 101948]]}, {"verse": 15, "start": 102736, "end": 111035, "text": "Y entendiendo Jesús que habían de venir para arrebatarle, y hacerle rey, volvió a retirarse al monte, él solo.", "words": [[0, 102736], [2, 102879], [14, 103559], [20, 103959], [24, 104334], [31, 104574], [34, 104794], [40, 105054], [45, 105334], [58, 106414], [60, 106854], [68, 107374], [73, 108114], [80, 108594], [82, 108674], [92, 109294], [95, 109454], [102, 109944], [105, 110434]]}, {"verse": 16, "start": 111385, "end": 115207, "text": "Y como se hizo tarde, descendieron sus discípulos al mar;", "words": [[0, 111385], [2, 111470], [7, 111690], [10, 111890], [15, 112150], [22, 112990], [35, 113710], [39, 113930], [50, 114550], [53, 114770]]}, {"verse": 17, "start": 115557, "end": 124557, "text": "Y entrando en un barco, venían de la otra parte del mar hacia Capernaum. Y era ya oscuro, y Jesús no había venido a ellos.", "words": [[0, 115557], [2, 115741], [11, 116261], [14, 116421], [17, 116541], [24, 117061], [31, 117741], [34, 117881], [37, 118001], [42, 118141], [48, 118501], [52, 118781], [56, 119041], [62, 119481], [73, 120561], [75, 120830], [79, 121000], [82, 121170], [90, 122150], [92, 122250], [98, 122590], [101, 123150], [107, 123390], [114, 123870], [116, 124010]]}, {"verse": 18, "start": 124907, "end": 128606, "text": "Y levantábase el mar con un gran viento que soplaba.", "words": [[0, 124907], [2, 125036], [14, 125916], [17, 126136], [21, 126416], [25, 126716], [28, 126896], [33, 127096], [40, 127676], [44, 127836]]}, {"verse": 19, "start": 128956, "end": 139211, "text": "Y cuando hubieron navegado como veinticinco o treinta estadios, ven a Jesús que andaba sobre el mar, y se acercaba al barco: y tuvieron miedo.", "words": [[0, 128956], [2, 129198], [9, 129458], [18, 129918], [27, 130478], [32, 130948], [44, 131418], [46, 131818], [54, 132218], [64, 133358], [68, 133698], [70, 133998], [76, 134318], [80, 134658], [87, 135078], [93, 135398], [96, 135618], [101, 135878], [103, 136358], [106, 136498], [115, 137158], [118, 137338], [125, 138099], [127, 138220], [136, 138620]]}, {"verse": 20, "start": 139561, "end": 143194, "text": "Pero él les dijo: Yo soy; no tengáis miedo.", "words": [[0, 139561], [5, 139725], [8, 140145], [12, 140350], [18, 141078], [21, 141325], [26, 141957], [29, 142141], [37, 142581]]}, {"verse": 21, "start": 143544, "end": 150543, "text": "Ellos entonces quisieron recibirle en el barco: y de inmediato el barco llegó a la tierra donde iban.", "words": [[0, 143544], [6, 143942], [15, 144282], [25, 145022], [35, 145822], [38, 146042], [41, 146202], [48, 147090], [50, 147237], [53, 147317], [63, 148077], [66, 148217], [72, 148597], [78, 148837], [80, 149057], [83, 149157], [90, 149437], [96, 149817]]}, {"verse": 22, "start": 150893, "end": 165575, "text": "El día siguiente, la gente que estaba de la otra parte del mar, cuando vio que no había allí otra navecilla sino una, y que Jesús no había entrado con sus discípulos en ella, sino que sus discípulos se habían ido solos;", "words": [[0, 150893], [3, 151039], [7, 151239], [18, 151919], [21, 152019], [27, 152359], [31, 152579], [38, 152939], [41, 153139], [44, 153259], [49, 153459], [55, 153819], [59, 154099], [64, 154379], [71, 155239], [75, 155599], [79, 155759], [82, 155939], [88, 156179], [93, 156479], [98, 156779], [108, 157379], [113, 157639], [118, 158421], [120, 158545], [124, 158665], [130, 159085], [133, 159500], [139, 159740], [147, 160360], [151, 160540], [155, 160780], [166, 161520], [169, 161760], [175, 162460], [180, 162740], [184, 162960], [188, 163160], [199, 164080], [202, 164400], [209, 164680], [213, 164920]]}, {"verse": 23, "start": 165925, "end": 174240, "text": "Y que otras barcas habían arribado de Tiberias junto al lugar donde habían comido el pan después de haber el Señor dado gracias;", "words": [[0, 165925], [2, 166047], [6, 166167], [12, 166407], [19, 167047], [26, 167647], [35, 168307], [38, 168467], [47, 169067], [53, 169387], [56, 169687], [62, 169987], [68, 170307], [75, 170727], [82, 171167], [85, 171287], [89, 171527], [97, 172147], [100, 172367], [106, 172527], [109, 172727], [115, 172967], [120, 173347]]}, {"verse": 24, "start": 174590, "end": 184085, "text": "Cuando vio pues la gente que Jesús no estaba allí, ni sus discípulos, entraron ellos en las barcas, y vinieron a Capernaum buscando a Jesús.", "words": [[0, 174590], [7, 174791], [11, 175131], [16, 175331], [19, 175531], [25, 175831], [29, 176031], [35, 176371], [38, 176911], [45, 177291], [51, 177711], [54, 178131], [58, 178351], [70, 179531], [79, 180171], [85, 180491], [88, 180751], [92, 180871], [100, 181331], [102, 181711], [111, 182151], [113, 182351], [123, 182851], [132, 183171], [134, 183451]]}, {"verse": 25, "start": 184435, "end": 189427, "text": "Y hallándole de la otra parte del mar, le dijeron: Rabí, ¿cuándo llegaste acá?", "words": [[0, 184435], [2, 184769], [13, 185139], [16, 185319], [19, 185459], [24, 185659], [30, 186099], [34, 186339], [39, 186939], [42, 187139], [51, 188193], [57, 188343], [65, 188543], [74, 189003]]}, {"verse": 26, "start": 189707, "end": 200378, "text": "Les respondió Jesús, y dijo: De cierto, de cierto os digo, que me buscáis, no porque habéis visto las señales, sino porque comisteis el pan y os hartasteis.", "words": [[0, 189766], [4, 189856], [14, 190476], [21, 190776], [23, 191056], [29, 192100], [32, 192432], [40, 192764], [43, 193096], [50, 193428], [53, 193648], [59, 193908], [63, 194128], [66, 194268], [75, 195068], [78, 195148], [85, 195468], [92, 195728], [98, 195988], [102, 196188], [111, 197128], [116, 197348], [123, 197708], [133, 198328], [136, 198468], [140, 198768], [142, 199168], [145, 199328]]}, {"verse": 27, "start": 200728, "end": 211726, "text": "Trabajad no por la comida que perece, sino por la comida que a vida eterna permanece, la cual el Hijo del hombre os dará: porque a este señaló el Padre, que es Dios.", "words": [[0, 200905], [9, 201125], [12, 201605], [16, 201845], [19, 201985], [26, 202325], [30, 202545], [38, 203285], [43, 203585], [47, 203945], [50, 204105], [57, 204545], [61, 204785], [63, 204945], [68, 205105], [75, 205625], [86, 206785], [89, 206885], [94, 207085], [97, 207305], [102, 207605], [106, 207825], [113, 208145], [116, 208365], [122, 209091], [129, 209332], [131, 209492], [136, 209732], [143, 210332], [146, 210412], [153, 210852], [157, 210992], [160, 211132]]}, {"verse": 28, "start": 212076, "end": 215823, "text": "Y le dijeron: ¿Qué haremos para que obremos las obras de Dios?", "words": [[0, 212076], [2, 212200], [5, 212300], [14, 213216], [19, 213321], [27, 213761], [32, 214081], [36, 214261], [44, 214621], [48, 214821], [54, 215081], [57, 215321]]}, {"verse": 29, "start": 216103, "end": 223481, "text": "Respondió Jesús, y les dijo: Esta es la obra de Dios, que creáis en el que él ha enviado.", "words": [[0, 216479], [10, 216889], [17, 217229], [19, 217529], [23, 217689], [29, 218451], [34, 218834], [37, 219174], [40, 219654], [45, 219994], [48, 220234], [54, 220554], [58, 221174], [65, 221754], [68, 221994], [71, 222154], [75, 222334], [78, 222534], [81, 222674]]}, {"verse": 30, "start": 223831, "end": 230003, "text": "Le dijeron entonces: ¿Qué señal pues haces tú, para que veamos, y te creamos? ¿Qué obras?", "words": [[0, 223831], [3, 223976], [11, 224516], [21, 225594], [26, 225692], [32, 226212], [37, 226532], [43, 226832], [47, 227132], [52, 227412], [56, 227592], [64, 228012], [66, 228292], [69, 228432], [78, 229333], [83, 229453]]}, {"verse": 31, "start": 230353, "end": 236654, "text": "Nuestros padres comieron el maná en el desierto, como está escrito: Pan del cielo les dio a comer.", "words": [[0, 230353], [9, 230736], [16, 231036], [25, 231596], [28, 231796], [33, 232156], [36, 232276], [39, 232376], [49, 233076], [54, 233236], [59, 233436], [68, 234311], [72, 234494], [76, 234654], [82, 235034], [86, 235234], [90, 235454], [92, 235554]]}, {"verse": 32, "start": 236934, "end": 247380, "text": "Y Jesús les dijo: De cierto, de cierto os digo: No os dio Moisés pan del cielo; sino que mi Padre os da el verdadero pan del cielo.", "words": [[0, 236934], [2, 237058], [8, 237438], [12, 237758], [18, 238754], [21, 239071], [29, 239388], [32, 239705], [39, 240022], [42, 240322], [48, 241053], [51, 241263], [54, 241603], [58, 241823], [65, 242009], [69, 242194], [73, 242380], [80, 244167], [85, 244327], [89, 244527], [92, 244707], [98, 245027], [101, 245247], [104, 245387], [107, 245507], [117, 246127], [121, 246467], [125, 246707]]}, {"verse": 33, "start": 247730, "end": 252778, "text": "Porque el pan de Dios es aquel que descendió del cielo y da vida al mundo.", "words": [[0, 247730], [7, 248014], [10, 248214], [14, 248554], [17, 248794], [22, 249134], [25, 249494], [31, 249914], [35, 250014], [45, 250674], [49, 250834], [55, 251394], [57, 251597], [60, 251799], [65, 251979], [68, 252239]]}, {"verse": 34, "start": 253128, "end": 256351, "text": "Y le dijeron: Señor, danos siempre este pan.", "words": [[0, 253128], [2, 253252], [5, 253352], [14, 254268], [21, 254773], [27, 255033], [35, 255413], [40, 255893]]}, {"verse": 35, "start": 256631, "end": 266700, "text": "Y Jesús les dijo: Yo soy el pan de vida: el que a mí viene, nunca tendrá hambre; y el que en mí cree, no tendrá sed jamás.", "words": [[0, 256631], [2, 256755], [8, 257135], [12, 257455], [18, 258176], [21, 258420], [25, 258700], [28, 259020], [32, 259360], [35, 259640], [41, 260413], [44, 260578], [48, 260738], [50, 260838], [53, 260978], [60, 261438], [66, 262158], [73, 262529], [81, 263596], [83, 263916], [86, 264236], [90, 264396], [93, 264536], [96, 264696], [102, 264976], [105, 265416], [112, 265857], [116, 266297]]}, {"verse": 36, "start": 267050, "end": 270436, "text": "Pero os he dicho, que aunque me habéis visto, no creéis.", "words": [[0, 267050], [5, 267254], [8, 267494], [11, 267574], [18, 267974], [22, 268189], [29, 268349], [32, 268649], [39, 268929], [46, 269489], [49, 269609]]}, {"verse": 37, "start": 270786, "end": 275400, "text": "Todo lo que el Padre me da, vendrá a mí; y al que a mí viene, no le echo fuera.", "words": [[0, 270786], [5, 270910], [8, 271130], [12, 271230], [15, 271350], [21, 271710], [24, 271830], [28, 272010], [35, 272590], [37, 272690], [41, 273214], [43, 273362], [46, 273502], [50, 273662], [52, 273742], [55, 273862], [62, 274242], [65, 274502], [68, 274692], [73, 274882]]}, {"verse": 38, "start": 275750, "end": 283003, "text": "Porque he descendido del cielo, no para hacer mi voluntad, sino la voluntad del que me envió.", "words": [[0, 275750], [7, 276034], [10, 276414], [21, 277094], [25, 277294], [32, 277754], [35, 278574], [40, 278854], [46, 279234], [49, 279414], [59, 280154], [64, 280714], [67, 281054], [76, 281564], [80, 282074], [84, 282194], [87, 282374]]}, {"verse": 39, "start": 283353, "end": 292064, "text": "Y esta es la voluntad del que me envió, del Padre: Que todo lo que me da, no pierda de ello, sino que lo resucite en el día postrero.", "words": [[0, 283353], [2, 283710], [7, 284030], [10, 284270], [13, 284430], [22, 285050], [26, 285210], [30, 285390], [33, 285570], [40, 286090], [44, 286210], [51, 287061], [55, 287143], [60, 287423], [63, 287663], [67, 287803], [70, 287963], [74, 288163], [77, 288303], [84, 288723], [87, 288963], [93, 289203], [98, 289523], [102, 289703], [105, 289863], [114, 290543], [117, 290683], [120, 290823], [124, 291023]]}, {"verse": 40, "start": 292414, "end": 302302, "text": "Y esta es la voluntad del que me ha enviado: Que todo aquel que ve al Hijo, y cree en él, tenga vida eterna: y yo le resucitaré en el día postrero.", "words": [[0, 292414], [2, 292581], [7, 293021], [10, 293601], [13, 293741], [22, 294421], [26, 294621], [30, 294801], [33, 294961], [36, 295061], [45, 296014], [49, 296117], [54, 296357], [60, 296797], [64, 296897], [67, 297077], [70, 297217], [76, 297437], [78, 297617], [83, 297837], [86, 298057], [90, 298307], [96, 298557], [101, 298697], [109, 299655], [111, 299773], [114, 299953], [117, 300093], [128, 301033], [131, 301153], [134, 301313], [138, 301513]]}, {"verse": 41, "start": 302652, "end": 309247, "text": "Murmuraban entonces de él los judíos, porque había dicho: Yo soy el pan que descendí del cielo.", "words": [[0, 302652], [11, 303378], [20, 303858], [23, 304238], [26, 304438], [30, 304558], [38, 305198], [45, 305538], [51, 305818], [58, 306622], [61, 306807], [65, 307027], [68, 307267], [72, 307547], [76, 307787], [85, 308467], [89, 308607]]}, {"verse": 42, "start": 309597, "end": 318355, "text": "Y decían: ¿No es este Jesús, el hijo de José, cuyo padre y madre nosotros conocemos? ¿cómo, pues, dice este: Del cielo he descendido?", "words": [[0, 309597], [2, 310074], [10, 310782], [14, 310946], [17, 311146], [22, 311366], [29, 312126], [32, 312206], [37, 312426], [40, 312526], [46, 313106], [51, 313326], [57, 313686], [59, 313766], [65, 314046], [74, 314266], [85, 315502], [92, 315666], [98, 315986], [103, 316246], [109, 317006], [113, 317168], [119, 317488], [122, 317668]]}, {"verse": 43, "start": 318635, "end": 323218, "text": "Y Jesús respondió, y les dijo: No murmuréis entre vosotros.", "words": [[0, 318635], [2, 318758], [8, 319098], [19, 320058], [21, 320298], [25, 320418], [31, 321216], [34, 321402], [44, 322042], [50, 322342]]}, {"verse": 44, "start": 323568, "end": 330608, "text": "Ninguno puede venir a mí, si el Padre que me envió no le trae; y yo le resucitaré en el día postrero.", "words": [[0, 323568], [8, 324116], [14, 324336], [20, 324736], [22, 324876], [26, 325236], [29, 325516], [32, 325676], [38, 325976], [42, 326216], [45, 326376], [51, 326736], [54, 327056], [57, 327196], [63, 327961], [65, 328079], [68, 328259], [71, 328399], [82, 329339], [85, 329459], [88, 329619], [92, 329819]]}, {"verse": 45, "start": 330958, "end": 339413, "text": "Escrito está en los profetas: Y serán todos enseñados de Dios. Así que, todo aquel que oyó del Padre, y aprendió, viene a mí.", "words": [[0, 330958], [8, 331396], [13, 331676], [16, 331816], [20, 331916], [30, 332954], [32, 333081], [38, 333461], [44, 333901], [54, 334721], [57, 334881], [63, 335625], [67, 335790], [72, 335970], [77, 336190], [83, 336610], [87, 336820], [91, 337030], [95, 337150], [102, 337530], [104, 337830], [114, 338410], [120, 338870], [122, 339130]]}, {"verse": 46, "start": 339763, "end": 346194, "text": "No que alguno haya visto al Padre, sino aquel que vino de Dios, este ha visto al Padre.", "words": [[0, 339763], [3, 339932], [7, 340092], [14, 340552], [19, 340672], [25, 340992], [28, 341172], [35, 342072], [40, 342342], [46, 342612], [50, 342732], [55, 342952], [58, 343152], [64, 343972], [69, 344252], [72, 344392], [78, 344592], [81, 344772]]}, {"verse": 47, "start": 346544, "end": 351930, "text": "De cierto, de cierto os digo: El que cree en mí, tiene vida eterna.", "words": [[0, 346820], [3, 347137], [11, 347454], [14, 347771], [21, 348088], [24, 348388], [30, 349118], [33, 349371], [37, 349657], [42, 349944], [45, 350124], [49, 350344], [55, 350864], [60, 351184]]}, {"verse": 48, "start": 352280, "end": 353880, "text": "Yo soy el pan de vida.", "words": [[0, 352280], [3, 352468], [7, 352708], [10, 352948], [14, 353188], [17, 353388]]}, {"verse": 49, "start": 354230, "end": 358043, "text": "Vuestros padres comieron el maná en el desierto, y han muerto.", "words": [[0, 354230], [9, 354612], [16, 354992], [25, 355532], [28, 355772], [33, 356172], [36, 356272], [39, 356392], [49, 356972], [51, 357192], [55, 357352]]}, {"verse": 50, "start": 358393, "end": 364097, "text": "Este es el pan que desciende del cielo, para que el que de él come, no muera.", "words": [[0, 358393], [5, 358719], [8, 358939], [11, 359099], [15, 359479], [19, 359719], [29, 360239], [33, 360459], [40, 361059], [45, 361599], [49, 361819], [52, 362139], [56, 362319], [59, 362539], [62, 362679], [68, 363099], [71, 363559]]}, {"verse": 51, "start": 364447, "end": 376149, "text": "Yo soy el pan vivo que he descendido del cielo: si alguno come de este pan, vivirá para siempre; y el pan que yo daré es mi carne, la cual yo daré por la vida del mundo.", "words": [[0, 364447], [3, 364633], [7, 364853], [10, 365113], [14, 365393], [19, 365793], [23, 366073], [26, 366233], [37, 366933], [41, 367113], [48, 367986], [51, 368123], [58, 368603], [63, 368863], [66, 369063], [71, 369243], [76, 369743], [83, 370343], [88, 370503], [97, 371378], [99, 371498], [102, 371638], [106, 371918], [110, 372138], [113, 372318], [118, 372718], [121, 372978], [124, 373158], [131, 373938], [134, 374178], [139, 374358], [142, 374558], [147, 374858], [151, 374998], [154, 375158], [159, 375358], [163, 375598]]}, {"verse": 52, "start": 376499, "end": 383195, "text": "Entonces los judíos contendían entre sí, diciendo: ¿Cómo puede este darnos su carne a comer?", "words": [[0, 376499], [9, 377139], [13, 377739], [20, 378299], [31, 379139], [37, 379439], [41, 380179], [51, 381093], [57, 381313], [63, 381573], [68, 381833], [75, 382173], [78, 382373], [84, 382673], [86, 382813]]}, {"verse": 53, "start": 383475, "end": 394155, "text": "Y Jesús les dijo: De cierto, de cierto os digo: Si no coméis la carne del Hijo del hombre, y bebéis su sangre, no tendréis vida en vosotros.", "words": [[0, 383475], [2, 383599], [8, 383979], [12, 384299], [18, 385295], [21, 385612], [29, 385929], [32, 386246], [39, 386563], [42, 386863], [48, 387594], [51, 387773], [54, 387953], [61, 388413], [64, 388613], [70, 388913], [74, 389213], [79, 389513], [83, 389673], [91, 390293], [93, 390553], [100, 390993], [103, 391153], [111, 392073], [114, 392173], [123, 392793], [128, 393093], [131, 393273]]}, {"verse": 54, "start": 394505, "end": 402038, "text": "El que come mi carne y bebe mi sangre, tiene vida eterna: y yo le resucitaré en el día postrero.", "words": [[0, 394505], [3, 394675], [7, 394835], [12, 395175], [15, 395395], [21, 395915], [23, 396255], [28, 396595], [31, 396755], [39, 397255], [45, 397915], [50, 398275], [58, 399391], [60, 399509], [63, 399689], [66, 399829], [77, 400769], [80, 400889], [83, 401049], [87, 401249]]}, {"verse": 55, "start": 402388, "end": 407026, "text": "Porque mi carne es verdadera comida, y mi sangre es verdadera bebida.", "words": [[0, 402388], [7, 402551], [10, 402771], [16, 403091], [19, 403351], [29, 403991], [37, 404311], [39, 404631], [42, 404751], [49, 405171], [52, 405471], [62, 406351]]}, {"verse": 56, "start": 407376, "end": 412912, "text": "El que come mi carne y bebe mi sangre, en mí permanece, y yo en él.", "words": [[0, 407376], [3, 407537], [7, 407677], [12, 407997], [15, 408217], [21, 408677], [23, 409117], [28, 409417], [31, 409557], [39, 410637], [42, 410757], [45, 410957], [56, 411337], [58, 411717], [61, 412237], [64, 412597]]}, {"verse": 57, "start": 413262, "end": 420493, "text": "Como me envió el Padre viviente, y yo vivo por el Padre, asimismo el que me come, él también vivirá por mí.", "words": [[0, 413262], [5, 413428], [8, 413628], [14, 413948], [17, 414068], [23, 414328], [33, 415288], [35, 415408], [38, 415548], [43, 415788], [47, 416128], [50, 416248], [57, 417038], [66, 417828], [69, 417988], [73, 418108], [76, 418248], [82, 419008], [85, 419148], [93, 419508], [100, 420008], [104, 420168]]}, {"verse": 58, "start": 420843, "end": 431631, "text": "Este es el pan que descendió del cielo: no como vuestros padres comieron el maná, y han muerto: el que come de este pan, vivirá eternamente.", "words": [[0, 420843], [5, 421086], [8, 421246], [11, 421366], [15, 421646], [19, 421866], [29, 422486], [33, 422626], [40, 423511], [43, 423718], [48, 423998], [57, 424438], [64, 424858], [73, 425438], [76, 425658], [82, 426138], [84, 426818], [88, 426998], [96, 427983], [99, 428327], [103, 428487], [108, 428827], [111, 429067], [116, 429267], [121, 429667], [128, 430507]]}, {"verse": 59, "start": 431981, "end": 436344, "text": "Estas cosas dijo en la sinagoga, enseñando en Capernaum.", "words": [[0, 431981], [6, 432163], [12, 432875], [17, 433208], [20, 433388], [23, 433508], [33, 434588], [43, 435368], [46, 435877]]}, {"verse": 60, "start": 436694, "end": 442555, "text": "Y muchos de sus discípulos oyéndolo, dijeron: Dura es esta palabra: ¿quién la puede oír?", "words": [[0, 436694], [2, 436803], [9, 437083], [12, 437323], [16, 437503], [27, 438123], [37, 438803], [46, 439903], [51, 440226], [54, 440466], [59, 440746], [68, 441546], [75, 441751], [78, 441831], [84, 442051]]}, {"verse": 61, "start": 442835, "end": 450017, "text": "Y sabiendo Jesús en sí mismo que sus discípulos murmuraban de esto, les dijo: ¿Esto os escandaliza?", "words": [[0, 442835], [2, 442958], [11, 443438], [17, 443798], [20, 444138], [23, 444338], [29, 444758], [33, 444958], [37, 445178], [48, 445918], [59, 446638], [62, 446898], [68, 447598], [72, 447738], [78, 448452], [84, 448777], [87, 449002]]}, {"verse": 62, "start": 450367, "end": 454331, "text": "¿Pues qué, si veis al Hijo del hombre que sube donde estaba primero?", "words": [[0, 450367], [6, 450638], [11, 450758], [14, 450898], [19, 451258], [22, 451398], [27, 451598], [31, 451818], [38, 452118], [42, 452318], [47, 452898], [53, 453278], [60, 453658]]}, {"verse": 63, "start": 454681, "end": 462531, "text": "El espíritu es el que da vida; la carne nada aprovecha: las palabras que yo os he hablado, son espíritu, y son vida.", "words": [[0, 454681], [3, 454807], [12, 455347], [15, 455447], [18, 455567], [22, 455707], [25, 455827], [31, 456560], [34, 456665], [40, 457045], [45, 457425], [56, 458638], [60, 458818], [69, 459198], [73, 459498], [76, 459758], [79, 459978], [82, 460098], [91, 460618], [95, 460858], [105, 461538], [107, 461658], [111, 461798]]}, {"verse": 64, "start": 462881, "end": 472272, "text": "Pero hay algunos de vosotros que no creen. Porque Jesús desde el principio sabía quiénes eran los que no creían, y quién le había de entregar.", "words": [[0, 462881], [5, 463221], [9, 463441], [17, 463781], [20, 463961], [29, 464341], [33, 464521], [36, 464661], [43, 465566], [50, 465771], [56, 466251], [62, 466751], [65, 467031], [75, 467631], [81, 468211], [89, 468751], [94, 468991], [98, 469231], [102, 469411], [105, 469591], [113, 470191], [115, 470671], [121, 470911], [124, 471131], [130, 471351], [133, 471571]]}, {"verse": 65, "start": 472622, "end": 478790, "text": "Y dijo: Por eso os he dicho que ninguno puede venir a mí, si no le es dado del Padre.", "words": [[0, 472622], [2, 472770], [8, 473463], [12, 473627], [16, 473867], [19, 474427], [22, 474667], [28, 474947], [32, 475087], [40, 475527], [46, 475807], [52, 476147], [54, 476287], [58, 476467], [61, 477007], [64, 477167], [67, 477347], [70, 477547], [75, 477867], [79, 478107]]}, {"verse": 66, "start": 479140, "end": 483797, "text": "Desde esto, muchos de sus discípulos volvieron atrás, y ya no andaban con él.", "words": [[0, 479140], [6, 479366], [12, 479866], [19, 480226], [22, 480446], [26, 480626], [37, 481206], [47, 481706], [54, 482026], [56, 482546], [59, 482726], [62, 482866], [70, 483286], [74, 483466]]}, {"verse": 67, "start": 484147, "end": 488610, "text": "Dijo entonces Jesús a los doce: ¿Queréis vosotros iros también?", "words": [[0, 484147], [5, 484455], [14, 484915], [20, 485335], [22, 485615], [26, 485755], [32, 486527], [41, 486934], [50, 487494], [55, 487914]]}, {"verse": 68, "start": 488960, "end": 494878, "text": "Y le respondió Simón Pedro: Señor, ¿a quién iremos? tú tienes palabras de vida eterna.", "words": [[0, 488960], [2, 489080], [5, 489200], [15, 489820], [21, 490220], [28, 491051], [35, 491866], [38, 491926], [44, 492066], [52, 492954], [55, 493051], [62, 493291], [71, 493711], [74, 494011], [79, 494171]]}, {"verse": 69, "start": 495228, "end": 500443, "text": "Y nosotros creemos y conocemos que tú eres el Cristo, el Hijo de Dios viviente.", "words": [[0, 495228], [2, 495333], [11, 495613], [19, 496253], [21, 496413], [31, 496913], [35, 497133], [38, 497333], [43, 497533], [46, 497673], [54, 498533], [57, 498613], [62, 498833], [65, 498933], [70, 499173]]}, {"verse": 70, "start": 500723, "end": 507408, "text": "Jesús le respondió: ¿No he escogido yo a vosotros doce, y uno de vosotros es diablo?", "words": [[0, 500723], [6, 501012], [9, 501492], [20, 502355], [24, 502521], [27, 502761], [36, 503401], [39, 503601], [41, 503821], [50, 504301], [56, 505501], [58, 505621], [62, 505781], [65, 505901], [74, 506361], [77, 506681]]}, {"verse": 71, "start": 507758, "end": 516504, "text": "Y hablaba de Judas Iscariote, hijo de Simón, porque este era el que le había de entregar, el cual era uno de los doce.", "words": [[0, 507758], [2, 507904], [10, 508304], [13, 508444], [19, 508764], [30, 510264], [35, 510564], [38, 510744], [45, 511584], [52, 511984], [57, 512444], [61, 512764], [64, 512964], [68, 513124], [71, 513284], [77, 513544], [80, 513744], [90, 514624], [93, 514784], [98, 515004], [102, 515324], [106, 515604], [109, 515764], [113, 515924]]}]}