{"book": "GEN", "chapter": 12, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 159317, "verses": [{"verse": 1, "start": 300, "end": 8201, "text": "Now the LORD had said to Abram, Get out of your country, and from your kindred, and from your father’s house, to a land that I will show you:", "words": [[0, 300], [4, 527], [8, 767], [13, 987], [17, 1147], [22, 1347], [25, 1527], [32, 2407], [36, 2511], [40, 2671], [43, 2771], [48, 2851], [57, 3231], [61, 3651], [66, 3851], [71, 3991], [80, 4511], [84, 4971], [89, 5151], [94, 5291], [103, 5791], [110, 6031], [113, 6631], [115, 6791], [120, 7071], [125, 7251], [127, 7391], [132, 7531], [137, 7791]]}, {"verse": 2, "start": 8779, "end": 15024, "text": "And I will make of you a great nation, and I will bless you, and make your name great; and you shall be a blessing:", "words": [[0, 8779], [4, 8878], [6, 8978], [11, 9098], [16, 9338], [19, 9498], [23, 9618], [25, 9718], [31, 9938], [39, 10718], [43, 10958], [45, 11078], [50, 11198], [56, 11438], [61, 11778], [65, 12158], [70, 12358], [75, 12518], [80, 12718], [87, 13723], [91, 13844], [95, 13944], [101, 14104], [104, 14264], [106, 14364]]}, {"verse": 3, "start": 15607, "end": 23161, "text": "And I will bless them that bless you, and curse him that curses you: and in you shall all families of the earth be blessed.", "words": [[0, 15607], [4, 15757], [6, 15877], [11, 16017], [17, 16317], [22, 16617], [27, 16862], [33, 17162], [38, 17562], [42, 17982], [48, 18342], [52, 18602], [57, 18942], [64, 19402], [69, 20332], [73, 20471], [76, 20631], [80, 20791], [86, 20991], [90, 21251], [99, 21711], [102, 21951], [106, 22071], [112, 22271], [115, 22491]]}, {"verse": 4, "start": 23672, "end": 33215, "text": "So Abram departed, as the LORD had spoken to him; and Lot went with him: and Abram was seventy and five years old when he departed out of Haran.", "words": [[0, 23672], [3, 24202], [9, 24732], [19, 25152], [22, 25492], [26, 25672], [31, 25912], [3