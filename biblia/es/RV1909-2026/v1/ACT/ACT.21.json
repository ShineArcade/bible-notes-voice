{"book": "ACT", "chapter": 21, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 378876, "verses": [{"verse": 1, "start": 300, "end": 9445, "text": "Y habiendo partido de ellos, navegamos y vinimos camino derecho a Cos, y al día siguiente a Rodas, y de allí a Pátara.", "words": [[0, 300], [2, 424], [11, 784], [19, 1204], [22, 1564], [29, 2424], [39, 3244], [41, 3524], [49, 3944], [56, 4224], [64, 4644], [66, 5034], [71, 5424], [73, 5904], [76, 6044], [80, 6164], [90, 6524], [92, 6884], [99, 7564], [101, 8004], [104, 8144], [109, 8364], [111, 8624]]}, {"verse": 2, "start": 9795, "end": 14692, "text": "Y hallando un barco que pasaba a Fenicia, nos embarcamos, y partimos.", "words": [[0, 9795], [2, 9917], [11, 10317], [14, 10477], [20, 10897], [24, 11037], [31, 11477], [33, 11617], [42, 12537], [46, 12617], [58, 13537], [60, 13872]]}, {"verse": 3, "start": 15042, "end": 25513, "text": "Y como avistamos a Chipre, dejándola a mano izquierda, navegamos a Siria, y vinimos a Tiro: porque el barco había de descargar allí su carga.", "words": [[0, 15042], [2, 15232], [7, 15472], [17, 16132], [19, 16652], [27, 17172], [37, 17812], [39, 18052], [44, 18252], [55, 19332], [65, 19932], [67, 20172], [74, 20692], [76, 21092], [84, 21532], [86, 21712], [92, 22477], [99, 22647], [102, 22787], [108, 23187], [114, 23387], [117, 23647], [127, 24347], [132, 24587], [135, 24787]]}, {"verse": 4, "start": 25863, "end": 34946, "text": "Y nos quedamos allí siete días, hallados los discípulos, los cuales decían a Pablo por Espíritu, que no subiese a Jerusalén.", "words": [[0, 25863], [2, 25971], [6, 26091], [15, 26571], [20, 26831], [26, 27211], [32, 28071], [41, 28671], [45, 29011], [57, 30091], [61, 30211], [68, 30471], [75, 31411], [77, 31531], [83, 31771], [87, 32031], [97, 32851], [101, 33151], [104, 33311], [112, 33851], [114, 34031]]}, {"verse": 5, "start": 35296, "end": 46887, "text": "Y cumplidos aquellos días, salimos, y todos nos acompañaron con sus mujeres e hijos, hasta fuera de la ciudad; y puestos de rodillas en la ribera, oramos.", "words": [[0, 35296], [2, 35420], [12, 36079], [21, 36439], [27, 36939], [36, 37920], [38, 38540], [44, 38820], [48, 39060], [60, 40000], [64, 40200], [68, 40460], [76, 40880], [78, 41160], [85, 41500], [91, 42160], [97, 42500], [100, 42720], [103, 42840], [111, 43706], [113, 43927], [121, 44427], [124, 44547], [133, 45047], [136, 45267], [139, 45407], [147, 45987]]}, {"verse": 6, "start": 47237, "end": 54727, "text": "Y abrazándonos los unos a los otros, subimos al barco, y ellos se volvieron a sus casas.", "words": [[0, 47237], [2, 47361], [15, 48321], [19, 48621], [24, 49101], [26, 49401], [30, 49581], [37, 50781], [45, 51301], [48, 51561], [55, 52081], [57, 52661], [63, 52961], [66, 53181], [76, 53681], [78, 53801], [82, 53941]]}, {"verse": 7, "start": 55077, "end": 64669, "text": "Y nosotros, cumplida la navegación, vinimos de Tiro a Tolemaida; y habiendo saludado a los hermanos, nos quedamos con ellos un día.", "words": [[0, 55077], [2, 55381], [12, 55641], [21, 56621], [24, 56741], [36, 57601], [44, 58461], [47, 58621], [52, 59041], [54, 59301], [65, 60281], [67, 60403], [76, 60763], [85, 61463], [87, 61583], [91, 61723], [101, 62803], [105, 62943], [114, 63423], [118, 63703], [124, 63943], [127, 64223]]}, {"verse": 8, "start": 65019, "end": 76775, "text": "Y otro día, partidos Pablo y los que con él estábamos, vinimos a Cesarea: y entrando en casa de Felipe el evangelista, el cual era uno de los siete, nos alojamos con él.", "words": [[0, 65019], [2, 65146], [7, 65306], [12, 65586], [21, 66066], [27, 66446], [29, 66626], [33, 66746], [37, 66886], [41, 67106], [44, 67206], [55, 67766], [63, 68566], [65, 68786], [74, 69727], [76, 69885], [85, 70385], [88, 70545], [93, 70845], [96, 71085], [103, 71805], [106, 71985], [119, 73125], [122, 73265], [127, 73485], [131, 73845], [135, 74105], [138, 74245], [142, 74385], [149, 75405], [153, 75645], [162, 76185], [166, 76405]]}, {"verse": 9, "start": 77125, "end": 81133, "text": "Y este tenía cuatro hijas, vírgenes, que profetizaban.", "words": [[0, 77125], [2, 77229], [7, 77409], [13, 77789], [20, 78169], [27, 79089], [37, 79609], [41, 79989]]}, {"verse": 10, "start": 81483, "end": 88657, "text": "Y parando nosotros allí por muchos días, descendió de Judea un profeta, llamado Agabo;", "words": [[0, 81483], [2, 81608], [10, 82128], [19, 82428], [24, 83068], [28, 83608], [35, 83888], [41, 84828], [51, 85708], [54, 85828], [60, 86308], [63, 86448], [72, 87088], [80, 87728]]}, {"verse": 11, "start": 89007, "end": 103689, "text": "Y venido a nosotros, tomó el cinto de Pablo, y atándose los pies y las manos, dijo: Esto dice el Espíritu Santo: Así atarán los judíos en Jerusalén al varón a quien pertenece este cinto, y le entregarán en manos de los Gentiles.", "words": [[0, 89007], [2, 89131], [9, 89511], [11, 89611], [21, 90011], [26, 90811], [29, 90951], [35, 91311], [38, 91451], [45, 91951], [47, 92511], [56, 93131], [60, 93351], [65, 93591], [67, 93751], [71, 93891], [78, 94471], [84, 95203], [89, 95423], [94, 95683], [97, 95843], [106, 96303], [113, 97022], [117, 97361], [124, 97821], [128, 97981], [135, 98441], [138, 98581], [148, 99161], [151, 99341], [157, 99701], [159, 99861], [165, 99961], [175, 100561], [180, 100801], [187, 101481], [189, 101681], [192, 101781], [203, 102341], [206, 102461], [212, 102661], [215, 102841], [219, 102941]]}, {"verse": 12, "start": 103969, "end": 110105, "text": "Lo cual como oímos, le rogamos nosotros y los de aquel lugar, que no subiese a Jerusalén.", "words": [[0, 103969], [3, 104105], [8, 104325], [13, 104585], [20, 105215], [23, 105845], [31, 106325], [40, 106845], [42, 107185], [46, 107325], [49, 107445], [55, 107685], [62, 108065], [66, 108665], [69, 108805], [77, 109245], [79, 109405]]}, {"verse": 13, "start": 110455, "end": 121163, "text": "Entonces Pablo respondió: ¿Qué hacéis llorando y afligiéndome el corazón? porque yo no sólo estoy dispuesto a ser atado, sino también a morir en Jerusalén por el nombre del Señor Jesús.", "words": [[0, 110455], [9, 110844], [15, 111404], [26, 112532], [31, 112625], [38, 113005], [47, 113425], [49, 113565], [62, 114225], [65, 114325], [74, 115306], [81, 115483], [84, 115683], [87, 115803], [92, 116003], [98, 116243], [108, 116703], [110, 116863], [114, 117023], [121, 117803], [126, 118083], [134, 118483], [136, 118663], [142, 118963], [145, 119043], [155, 119623], [159, 119803], [162, 119923], [169, 120183], [173, 120343], [179, 120603]]}, {"verse": 14, "start": 121443, "end": 127696, "text": "Y como no le pudimos persuadir, desistimos, diciendo: Hágase la voluntad del Señor.", "words": [[0, 121443], [2, 121569], [7, 121809], [10, 121989], [13, 122109], [21, 122529], [32, 123809], [44, 124689], [54, 126038], [61, 126403], [64, 126523], [73, 127003], [77, 127143]]}, {"verse": 15, "start": 127976, "end": 133084, "text": "Y después de estos días, hechos ya los preparativos, subimos a Jerusalén.", "words": [[0, 127976], [2, 128100], [10, 128400], [13, 128580], [19, 128760], [25, 129680], [32, 129980], [35, 130180], [39, 130320], [53, 131580], [61, 132040], [63, 132200]]}, {"verse": 16, "start": 133434, "end": 146123, "text": "Y vinieron también con nosotros de Cesarea algunos de los discípulos, trayendo consigo a un Mnasón, Cyprio, discípulo antiguo, con quien nos alojaríamos.", "words": [[0, 133434], [2, 133561], [11, 134041], [19, 134541], [23, 134821], [32, 135461], [35, 135881], [43, 136571], [51, 137261], [54, 137341], [58, 137481], [70, 138581], [79, 139201], [87, 139721], [89, 140061], [92, 140921], [100, 141781], [108, 142641], [118, 143541], [127, 144341], [131, 144481], [137, 144701], [141, 145001]]}, {"verse": 17, "start": 146473, "end": 151521, "text": "Y cuando llegamos a Jerusalén, los hermanos nos recibieron de buena voluntad.", "words": [[0, 146473], [2, 146596], [9, 146776], [18, 147316], [20, 147476], [31, 148816], [35, 148896], [44, 149416], [48, 149576], [59, 150276], [62, 150456], [68, 150696]]}, {"verse": 18, "start": 151871, "end": 158059, "text": "Y al día siguiente Pablo entró con nosotros a Jacobo, y todos los ancianos se juntaron;", "words": [[0, 151871], [2, 151959], [5, 152079], [9, 152199], [19, 152639], [25, 153239], [31, 153739], [35, 153899], [44, 154439], [46, 154719], [54, 155339], [56, 155659], [62, 156039], [66, 156479], [75, 157099], [78, 157259]]}, {"verse": 19, "start": 158409, "end": 165175, "text": "A los cuales, como los hubo saludado, contó en detalle lo que Dios había hecho entre los Gentiles por su ministerio.", "words": [[0, 158409], [2, 158501], [6, 158621], [14, 158901], [19, 159221], [23, 159421], [28, 159881], [38, 160741], [44, 161321], [47, 161421], [55, 161921], [58, 162101], [62, 162241], [67, 162401], [73, 162721], [79, 163061], [85, 163281], [89, 163481], [98, 163981], [102, 164221], [105, 164401]]}, {"verse": 20, "start": 165525, "end": 175791, "text": "Y ellos como lo oyeron, glorificaron a Dios, y le dijeron: Ya ves, hermano, cuántos millares de judíos hay que han creído; y todos son celosos de la ley:", "words": [[0, 165525], [2, 165672], [8, 166012], [13, 166192], [16, 166372], [24, 167312], [37, 168132], [39, 168272], [45, 168512], [47, 169152], [50, 169252], [59, 170167], [62, 170333], [67, 170493], [76, 171433], [84, 171753], [93, 172173], [96, 172333], [103, 172833], [107, 173053], [111, 173193], [115, 173293], [123, 174101], [125, 174222], [131, 174382], [135, 174682], [143, 175142], [146, 175322], [149, 175442]]}, {"verse": 21, "start": 176141, "end": 187858, "text": "Pero fueron informados acerca de ti, que enseñas a apartarse de Moisés a todos los judíos que están entre los Gentiles, diciéndoles que no han de circuncidar a los hijos, ni andar según la costumbre.", "words": [[0, 176141], [5, 176299], [12, 176579], [23, 177259], [30, 177599], [33, 177919], [37, 178359], [41, 178459], [49, 179039], [51, 179139], [61, 179739], [64, 179899], [71, 180279], [73, 180579], [79, 180799], [83, 181079], [90, 181579], [94, 181719], [100, 181959], [106, 182199], [110, 182379], [120, 183279], [132, 183879], [136, 184099], [139, 184279], [143, 184419], [146, 184539], [158, 185179], [160, 185299], [164, 185439], [171, 186183], [174, 186341], [180, 186621], [186, 186981], [189, 187181]]}, {"verse": 22, "start": 188208, "end": 192606, "text": "¿Qué hay pues? La multitud se reunirá de cierto: porque oirán que has venido.", "words": [[0, 188208], [5, 188328], [9, 188468], [15, 189149], [18, 189236], [27, 189736], [30, 189936], [38, 190329], [41, 190723], [49, 191287], [56, 191473], [62, 191833], [66, 191953], [70, 192073]]}, {"verse": 23, "start": 192956, "end": 198120, "text": "Haz pues esto que te decimos: Hay entre nosotros cuatro hombres que tienen voto sobre sí:", "words": [[0, 192956], [4, 193139], [9, 193319], [14, 193639], [18, 193819], [21, 193939], [30, 194834], [34, 194994], [40, 195234], [49, 195714], [56, 196114], [64, 196554], [68, 196794], [75, 197054], [80, 197454], [86, 197674]]}, {"verse": 24, "start": 198470, "end": 211237, "text": "Tomando a estos contigo, purifícate con ellos, y paga sus gastos, para que rasuren sus cabezas, y todos entiendan que no hay nada de lo que fueron informados acerca de ti; sino que tú también andas guardando la ley.", "words": [[0, 198470], [8, 198850], [10, 198970], [16, 199130], [25, 200090], [36, 200730], [40, 200970], [47, 201250], [49, 201600], [54, 201950], [58, 202150], [66, 202810], [71, 203130], [75, 203270], [83, 203730], [87, 203950], [96, 204980], [98, 205105], [104, 205285], [114, 205905], [118, 206045], [121, 206225], [125, 206365], [130, 206645], [133, 206805], [136, 206925], [140, 207045], [147, 207305], [158, 208005], [165, 208305], [168, 208565], [172, 209094], [177, 209292], [181, 209472], [184, 209652], [192, 209892], [198, 210312], [208, 210772], [211, 210912]]}, {"verse": 25, "start": 211587, "end": 226131, "text": "Pero cuanto a los que de los Gentiles han creído, nosotros hemos escrito haberse acordado que no guarden nada de esto; solamente que se abstengan de lo que sea sacrificado a los ídolos, y de sangre, y de animales estrangulados, y de inmoralidad sexual.", "words": [[0, 211587], [5, 211745], [12, 212065], [14, 212225], [18, 212385], [22, 212525], [25, 212605], [29, 212725], [38, 213205], [42, 213425], [50, 214445], [59, 214525], [65, 214965], [73, 215385], [81, 215865], [90, 216365], [94, 216525], [97, 216795], [105, 217065], [110, 217305], [113, 217545], [119, 218208], [129, 218553], [133, 218933], [136, 219113], [146, 219693], [149, 219833], [152, 219953], [156, 220053], [160, 220253], [172, 221013], [174, 221093], [178, 221213], [186, 221773], [188, 221913], [191, 222013], [199, 222413], [201, 222813], [204, 222893], [213, 223213], [228, 224173], [230, 224733], [233, 224833], [245, 225493]]}, {"verse": 26, "start": 226411, "end": 241973, "text": "Entonces Pablo tomó consigo aquellos hombres, y al día siguiente, habiéndose purificado con ellos, entró en el templo, para anunciar el cumplimiento de los días de la purificación, hasta ser ofrecida ofrenda por cada uno de ellos.", "words": [[0, 226411], [9, 226857], [15, 227442], [20, 228122], [28, 228542], [37, 228842], [46, 229362], [48, 229767], [51, 229887], [55, 230027], [66, 230847], [77, 231427], [88, 232147], [92, 232407], [99, 233047], [105, 233667], [108, 233847], [111, 234007], [119, 234787], [124, 235007], [133, 235727], [136, 235827], [149, 236547], [152, 236727], [156, 236847], [161, 237087], [164, 237247], [167, 237347], [181, 238636], [187, 238826], [191, 239106], [200, 239706], [208, 240346], [212, 240506], [217, 240746], [221, 241046], [224, 241306]]}, {"verse": 27, "start": 242323, "end": 252143, "text": "Y cuando estaban para acabarse los siete días, unos judíos de Asia, como le vieron en el templo, alborotaron todo el pueblo y le echaron mano,", "words": [[0, 242323], [2, 242407], [9, 242607], [17, 242947], [22, 243347], [31, 244147], [35, 244327], [41, 244767], [47, 245227], [52, 245747], [59, 246247], [62, 246387], [68, 247007], [73, 247307], [76, 247467], [83, 247807], [86, 248007], [89, 248147], [97, 249147], [109, 249867], [114, 250127], [117, 250347], [124, 250727], [126, 251052], [129, 251192], [137, 251552]]}, {"verse": 28, "start": 252493, "end": 266771, "text": "Dando voces: Varones israelitas, ayudad: Este es el hombre que por todas partes enseña a todos contra el pueblo, y la ley, y este lugar; y además de esto ha metido Gentiles en el templo, y ha contaminado este lugar santo.", "words": [[0, 252493], [6, 252801], [13, 254049], [21, 254229], [33, 254929], [41, 255702], [46, 255967], [49, 256167], [52, 256307], [59, 256507], [63, 256687], [67, 256847], [73, 257067], [80, 257607], [87, 258227], [89, 258347], [95, 258587], [102, 259007], [105, 259147], [113, 259487], [115, 259827], [118, 259967], [123, 260287], [125, 260567], [130, 260767], [137, 261462], [139, 261581], [146, 261841], [149, 262121], [154, 262401], [157, 262581], [164, 262961], [173, 263441], [176, 263661], [179, 263781], [187, 264621], [189, 264761], [192, 264901], [204, 265601], [209, 265801], [215, 266061]]}, {"verse": 29, "start": 267051, "end": 275279, "text": "Porque antes habían visto con él en la ciudad a Trófimo, efesio, al cual pensaban que Pablo había metido en el templo.", "words": [[0, 267051], [7, 267275], [13, 267695], [20, 268115], [26, 268455], [30, 268815], [33, 268975], [36, 269135], [39, 269275], [46, 269887], [48, 270500], [57, 271113], [65, 271725], [68, 271865], [73, 272085], [82, 272705], [86, 272905], [92, 273345], [98, 273785], [105, 274305], [108, 274465], [111, 274605]]}, {"verse": 30, "start": 275629, "end": 287608, "text": "Así que, toda la ciudad se alborotó, y se agolpó el pueblo; y tomando a Pablo, le hicieron salir fuera del templo, y luego las puertas fueron cerradas.", "words": [[0, 275629], [4, 275949], [9, 276129], [14, 276489], [17, 276769], [24, 277149], [27, 277549], [37, 278509], [39, 278769], [42, 278969], [49, 279789], [52, 279949], [60, 280883], [62, 281004], [70, 281444], [72, 281604], [79, 282704], [82, 282984], [91, 283444], [97, 283824], [103, 284124], [107, 284444], [115, 285304], [117, 285504], [123, 285744], [127, 285964], [135, 286364], [142, 287008]]}, {"verse": 31, "start": 287958, "end": 296915, "text": "Y procurando ellos matarle, fue dado aviso al comandante de la unidad militar, que toda la ciudad de Jerusalén estaba alborotada;", "words": [[0, 287958], [2, 288085], [13, 288805], [19, 289085], [28, 290105], [32, 290385], [37, 290605], [43, 291085], [46, 291225], [57, 292045], [60, 292185], [63, 292305], [70, 292685], [79, 293125], [83, 293565], [88, 293865], [91, 294085], [98, 294405], [101, 294665], [111, 295425], [118, 295825]]}, {"verse": 32, "start": 297265, "end": 307832, "text": "El cual tomando luego soldados y centuriones, corrió a ellos. Y ellos como vieron al comandante y a los soldados, cesaron de herir a Pablo.", "words": [[0, 297265], [3, 297570], [8, 297750], [16, 298270], [22, 298590], [31, 299490], [33, 299650], [46, 300370], [53, 301150], [55, 301310], [62, 302073], [64, 302261], [70, 302941], [75, 303261], [82, 303681], [85, 303801], [96, 304641], [98, 304781], [100, 304841], [104, 304981], [114, 306021], [122, 306501], [125, 306741], [131, 307121], [133, 307201]]}, {"verse": 33, "start": 308182, "end": 316446, "text": "Entonces llegando el comandante, le prendió, y le mandó atar con dos cadenas; y preguntó quién era, y qué había hecho.", "words": [[0, 308182], [9, 309206], [18, 309586], [21, 309686], [33, 310306], [36, 310466], [45, 311026], [47, 311546], [50, 311646], [56, 311916], [61, 312186], [65, 312486], [69, 312666], [78, 313696], [80, 313813], [89, 314393], [95, 314613], [100, 315013], [102, 315238], [106, 315458], [112, 315758]]}, {"verse": 34, "start": 316796, "end": 327790, "text": "Y entre la multitud, unos gritaban una cosa, y otros otra: y como no podía entender nada de cierto a causa del alboroto, le mandó llevar a la fortaleza.", "words": [[0, 316796], [2, 316914], [8, 317134], [11, 317314], [21, 317994], [26, 318514], [35, 319114], [39, 319314], [45, 319674], [47, 320094], [53, 320314], [59, 321148], [61, 321254], [66, 321494], [69, 321674], [75, 322054], [84, 322494], [89, 322974], [92, 323234], [99, 323654], [101, 323874], [107, 324174], [111, 324494], [121, 325534], [124, 325914], [130, 326274], [137, 326494], [139, 326694], [142, 326814]]}, {"verse": 35, "start": 328140, "end": 334736, "text": "Y cuando llegó a las escaleras, aconteció que fue llevado de los soldados a causa de la violencia del pueblo;", "words": [[0, 328140], [2, 328264], [9, 328504], [15, 328884], [17, 329064], [21, 329204], [32, 330229], [42, 330729], [46, 330869], [50, 331049], [58, 331509], [61, 331649], [65, 331769], [74, 332329], [76, 332489], [82, 332849], [85, 333129], [88, 333229], [98, 333869], [102, 334029]]}, {"verse": 36, "start": 335086, "end": 339563, "text": "Porque multitud de pueblo venía detrás, gritando: Mátale.", "words": [[0, 335086], [7, 335308], [16, 335988], [19, 336188], [26, 336668], [32, 337128], [40, 337728], [50, 338958]]}, {"verse": 37, "start": 339843, "end": 349073, "text": "Y como comenzaron a meter a Pablo en la fortaleza, dice al comandante: ¿Me será lícito hablarte algo? Y él dijo: ¿Sabes griego?", "words": [[0, 339843], [2, 339966], [7, 340226], [18, 340886], [20, 341026], [26, 341246], [28, 341426], [34, 341766], [37, 341926], [40, 342046], [51, 343326], [56, 343806], [59, 344046], [71, 345136], [75, 345235], [80, 345475], [87, 345715], [96, 346295], [102, 347067], [104, 347255], [107, 347415], [113, 348134], [120, 348508]]}, {"verse": 38, "start": 349423, "end": 355773, "text": "¿No eres tú aquel egipcio que provocó una revuelta antes de estos días, y sacó al desierto cuatro mil sicarios?", "words": [[0, 349423], [4, 349606], [9, 349826], [12, 350086], [18, 350346], [26, 350806], [30, 350946], [38, 351486], [42, 351606], [51, 352146], [57, 352446], [60, 352626], [66, 352826], [72, 353226], [74, 353501], [79, 353861], [82, 353961], [91, 354401], [98, 354661], [102, 355001]]}, {"verse": 39, "start": 356053, "end": 366606, "text": "Entonces dijo Pablo: Yo de cierto soy hombre judío, ciudadano de Tarso, ciudad no desconocida de Cilicia: pero te ruego que me permitas que hable al pueblo.", "words": [[0, 356053], [9, 357069], [14, 357289], [21, 358132], [24, 358330], [27, 358390], [34, 358990], [38, 359150], [45, 359510], [52, 360310], [62, 360850], [65, 360970], [72, 361830], [79, 362050], [82, 362350], [94, 363070], [97, 363510], [106, 364115], [111, 364258], [114, 364398], [120, 364718], [124, 364858], [127, 364958], [136, 365478], [140, 365598], [146, 365858], [149, 365938]]}, {"verse": 40, "start": 366886, "end": 378476, "text": "Y como él se lo permitió, Pablo, estando en pie en las escaleras, hizo señal con la mano al pueblo. Y hecho grande silencio, habló en lengua hebrea, diciendo:", "words": [[0, 366886], [2, 366987], [7, 367227], [10, 367427], [13, 367627], [16, 367747], [26, 368327], [33, 368827], [41, 369407], [44, 369587], [48, 369847], [51, 370127], [55, 370267], [66, 371187], [71, 371607], [77, 372127], [81, 372247], [84, 372407], [89, 372627], [92, 372807], [100, 373661], [102, 373968], [108, 374208], [115, 374528], [125, 375588], [131, 376148], [134, 376268], [141, 376748], [149, 377668]]}]}