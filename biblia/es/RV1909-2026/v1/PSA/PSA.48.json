{"book": "PSA", "chapter": 48, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 92533, "verses": [{"verse": 1, "start": 300, "end": 11283, "text": "Canción: Salmo de los hijos de Coré. GRANDE es Jehová y digno de ser en gran manera alabado, en la ciudad de nuestro Dios, en el monte de su santuario.", "words": [[0, 300], [9, 1297], [15, 1778], [18, 1898], [22, 2018], [28, 2338], [31, 2745], [37, 3372], [44, 3598], [47, 3858], [54, 4518], [56, 4618], [62, 5138], [65, 5218], [69, 5518], [72, 5818], [77, 6058], [84, 6458], [93, 7338], [96, 7838], [99, 7998], [106, 8298], [109, 8618], [117, 8798], [123, 9298], [126, 9618], [129, 9738], [135, 10038], [138, 10258], [141, 10398]]}, {"verse": 2, "start": 11633, "end": 19782, "text": "Hermosa provincia, el gozo de toda la tierra es el monte de Sion, a los lados del norte, la ciudad del gran Rey.", "words": [[0, 11633], [8, 12081], [19, 12591], [22, 13101], [27, 13421], [30, 13581], [35, 13821], [38, 14061], [45, 14381], [48, 14761], [51, 14921], [57, 15221], [60, 15831], [66, 16441], [68, 16521], [72, 16661], [78, 16961], [82, 17221], [89, 18161], [92, 18261], [99, 18657], [103, 19053], [108, 19448]]}, {"verse": 3, "start": 20132, "end": 23386, "text": "Dios en sus palacios es conocido por refugio.", "words": [[0, 20132], [5, 20480], [8, 20840], [12, 21060], [21, 21700], [24, 21820], [33, 22420], [37, 22640]]}, {"verse": 4, "start": 23736, "end": 28022, "text": "Porque he aquí los reyes de la tierra se reunieron; pasaron todos.", "words": [[0, 23736], [7, 23843], [10, 23983], [15, 24223], [19, 24583], [25, 24923], [28, 25063], [31, 25163], [38, 25503], [41, 25683], [52, 26760], [60, 27162]]}, {"verse": 5, "start": 28372, "end": 34127, "text": "Y viéndola ellos así, se maravillaron, se turbaron, se dieron prisa a huir.", "words": [[0, 28372], [2, 28477], [11, 28977], [17, 29317], [22, 30137], [25, 30297], [39, 31337], [42, 31417], [52, 32217], [55, 32317], [62, 32637], [68, 33177], [70, 33652]]}, {"verse": 6, "start": 34127, "end": 37644, "text": "Los tomó allí temblor; dolor, como a mujer que pare.", "words": [[0, 34137], [4, 34237], [9, 34617], [14, 34777], [23, 35622], [30, 35966], [35, 36426], [37, 36586], [43, 36846], [47, 37086]]}, {"verse": 7, "start": 37994, "end": 42109, "text": "Con viento solano quiebras tú las naves de Tarsis.", "words": [[0, 37994], [4, 38119], [11, 38619], [18, 39169], [27, 39719], [30, 40019], [34, 40499], [40, 41059], [43, 41319]]}, {"verse": 8, "start": 42459, "end": 52268, "text": "Como lo oímos, así hemos visto en la ciudad de Jehová de los ejércitos, en la ciudad de nuestro Dios: la afirmará Dios para siempre. (Selah.)", "words": [[0, 42459], [5, 42643], [8, 42863], [15, 43423], [19, 43863], [25, 44023], [31, 44403], [34, 44563], [37, 44703], [44, 44983], [47, 45283], [54, 45723], [57, 45803], [61, 45943], [72, 47143], [75, 47283], [78, 47443], [85, 47783], [88, 48123], [96, 48283], [102, 49249], [105, 49438], [114, 50098], [119, 50358], [124, 50698], [133, 52007]]}, {"verse": 9, "start": 52618, "end": 57101, "text": "Esperamos tu misericordia, oh Dios, en medio de tu templo.", "words": [[0, 52618], [10, 53240], [13, 53460], [27, 54070], [30, 54680], [36, 54960], [39, 55600], [45, 55960], [48, 56200], [51, 56360]]}, {"verse": 10, "start": 57451, "end": 65697, "text": "Conforme a tu nombre, oh Dios, así es tu alabanza hasta los fines de la tierra: de justicia está llena tu diestra.", "words": [[0, 57451], [9, 58035], [11, 58075], [14, 58175], [22, 59135], [25, 59435], [31, 60155], [35, 60395], [38, 60575], [41, 60775], [50, 61495], [56, 61795], [60, 61995], [66, 62315], [69, 62515], [72, 62635], [80, 63523], [83, 63632], [92, 64172], [97, 64412], [103, 64792], [106, 64952]]}, {"verse": 11, "start": 66047, "end": 71488, "text": "Se alegrará el monte de Sion; se gozarán las hijas de Judá por tus juicios.", "words": [[0, 66047], [3, 66210], [12, 66810], [15, 67070], [21, 67410], [24, 67590], [30, 68466], [33, 68605], [41, 69125], [45, 69305], [51, 69745], [54, 69945], [59, 70365], [63, 70565], [67, 70765]]}, {"verse": 12, "start": 71838, "end": 76460, "text": "Andad alrededor de Sion, y rodeadla: contad sus torres.", "words": [[0, 71838], [6, 72293], [16, 72713], [19, 73233], [25, 73573], [27, 73813], [37, 74933], [44, 75440], [48, 75950]]}, {"verse": 13, "start": 76810, "end": 83906, "text": "Poned vuestro corazón a sus murallas, mirad sus palacios; para que lo contéis a la generación venidera.", "words": [[0, 76810], [6, 77135], [14, 77515], [22, 77935], [24, 78275], [28, 78475], [38, 79475], [44, 79835], [48, 80075], [58, 81306], [63, 81446], [67, 81566], [70, 81686], [78, 82226], [80, 82446], [83, 82546], [94, 83146]]}, {"verse": 14, "start": 84256, "end": 92133, "text": "Porque este Dios es Dios nuestro eternamente y para siempre: él nos capitaneará hasta la muerte.", "words": [[0, 84256], [7, 84458], [12, 84638], [17, 84938], [20, 85218], [25, 85698], [33, 86738], [45, 87978], [47, 88118], [52, 88338], [61, 89452], [64, 89797], [68, 89917], [80, 90897], [86, 91237], [89, 91417]]}]}