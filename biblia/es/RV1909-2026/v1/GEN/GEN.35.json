{"book": "GEN", "chapter": 35, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 253889, "verses": [{"verse": 1, "start": 300, "end": 9885, "text": "Y dijo Dios a Jacob: Levántate, sube a Bet-el, y quédate allí; y haz allí un altar al Dios que te apareció cuando huías de tu hermano Esaú.", "words": [[0, 300], [2, 442], [7, 702], [12, 962], [14, 1162], [21, 1953], [32, 2491], [37, 3071], [39, 3131], [47, 3571], [49, 4091], [57, 4511], [63, 5500], [65, 5645], [69, 5825], [74, 6085], [77, 6225], [83, 6545], [86, 6705], [91, 6965], [95, 7245], [98, 7385], [107, 7925], [114, 8205], [120, 8685], [123, 8825], [126, 8945], [134, 9325]]}, {"verse": 2, "start": 10364, "end": 20823, "text": "Entonces Jacob dijo a su familia y a todos los que con él estaban: Quitad los dioses ajenos que hay entre vosotros, y limpiaos, y cambiad vuestros vestidos.", "words": [[0, 10364], [9, 11268], [15, 11568], [20, 12008], [22, 12208], [25, 12328], [33, 12928], [35, 13288], [37, 13369], [43, 13828], [47, 14288], [51, 14468], [55, 14689], [58, 14808], [67, 15799], [74, 15979], [78, 16199], [85, 16559], [92, 17119], [96, 17279], [100, 17439], [106, 17659], [116, 18239], [118, 18459], [128, 19119], [130, 19379], [138, 19639], [147, 20119]]}, {"verse": 3, "start": 21173, "end": 30554, "text": "Y levantémonos, y subamos a Bet-el; y haré allí altar al Dios que me respondió en el día de mi angustia, y ha sido conmigo en el camino que he andado.", "words": [[0, 21173], [2, 21273], [16, 22093], [18, 22213], [26, 22633], [28, 22813], [36, 23496], [38, 23650], [43, 23990], [48, 24250], [54, 24610], [57, 24830], [62, 25090], [66, 25330], [69, 25450], [79, 26110], [82, 26270], [85, 26390], [89, 26630], [92, 26770], [95, 26890], [105, 27590], [107, 28030], [110, 28150], [115, 28370], [123, 28910], [126, 29050], [129, 29150], [136, 29490], [140, 29790], [143, 29990]]}, {"verse": 4, "start": 30834, "end": 44507, "text": "Así dieron a Jacob todos los dioses ajenos que había en poder de ellos, y los aretes que estaban en sus orejas; y Jacob los escondió debajo de una encina, que estaba junto a Siquem.", "words": [[0, 30834], [4, 31136], [11, 31556], [13, 31796], [19, 32176], [25, 32576], [29, 32896], [36, 33356], [43, 34016], [47, 34156], [53, 34416], [56, 34696], [62, 34976], [65, 35276], [72, 35636], [74, 36276], [78, 36456], [85, 37036], [89, 37596], [97, 37956], [100, 38196], [104, 38376], [112, 39652], [114, 39877], [120, 40102], [124, 40327], [133, 40947], [140, 41387], [143, 41627], [147, 41807], [155, 42827], [159, 43127], [166, 43387], [172, 43727], [174, 44117]]}, {"verse": 5, "start": 44857, "end": 53460, "text": "Y salieron, y el terror de Dios fue sobre las ciudades que había en sus alrededores, y no siguieron tras los hijos de Jacob.", "words": [[0, 44857], [2, 45023], [12, 46203], [14, 46503], [17, 46663], [24, 47063], [27, 47303], [32, 47603], [36, 48023], [42, 48383], [46, 48623], [55, 49303], [59, 49463], [65, 49723], [68, 49883], [72, 50043], [85, 50943], [87, 51383], [90, 51523], [100, 52023], [105, 52223], [109, 52443], [115, 52723], [118, 52903]]}, {"verse": 6, "start": 53810, "end": 62178, "text": "Y llegó Jacob a Luz, que está en tierra de Canaán, (esta es Bet-el) él y todo el pueblo que con él estaba;", "words": [[0, 53810], [2, 53909], [8, 54169], [14, 54549], [16, 55009], [21, 55429], [25, 55674], [30, 55894], [33, 56094], [40, 56394], [43, 56634], [51, 57814], [57, 58134], [60, 58621], [68, 59107], [71, 59594], [73, 59914], [78, 60134], [81, 60354], [88, 60654], [92, 60994], [96, 61254], [99, 61394]]}, {"verse": 7, "start": 62528, "end": 70837, "text": "Y edificó allí un altar, y llamó al lugar El-bet-el, porque allí le había aparecido Dios, cuando huía de su hermano.", "words": [[0, 62528], [2, 62670], [10, 63270], [15, 63530], [18, 63750], [25, 64170], [27, 64405], [33, 64845], [36, 65005], [42, 65685], [53, 66365], [60, 66945], [65, 67265], [68, 67465], [74, 67745], [84, 68405], [90, 68805], [97, 69385], [102, 69945], [105, 70085], [108, 70245]]}, {"verse": 8, "start": 71187, "end": 82763, "text": "Entonces murió Débora, nodriza de Rebeca, y fue sepultada a las raíces de Bet-el, debajo de una encina: y se llamó su nombre Alón-bacut.", "words": [[0, 71187], [9, 71644], [15, 72384], [23, 72884], [31, 73544], [34, 73724], [42, 74344], [44, 74884], [48, 75064], [58, 75844], [60, 76004], [64, 76124], [71, 76724], [74, 76944], [82, 77744], [89, 78504], [92, 78664], [96, 78824], [104, 79903], [106, 80163], [109, 80263], [115, 80603], [118, 80723], [125, 81743]]}, {"verse": 9, "start": 83113, "end": 90203, "text": "Y se apareció otra vez Dios a Jacob, cuando se había vuelto de Padan-aram, y le bendijo.", "words": [[0, 83113], [2, 83254], [5, 83374], [14, 84054], [19, 84434], [23, 84754], [28, 85154], [30, 85494], [37, 86474], [44, 86894], [47, 87154], [53, 87374], [60, 87854], [63, 88494], [75, 89134], [77, 89299], [80, 89419]]}, {"verse": 10, "start": 90553, "end": 100939, "text": "Y le dijo Dios: Tu nombre es Jacob; no se llamará más tu nombre Jacob, sino Israel será tu nombre: y llamó su nombre Israel.", "words": [[0, 90673], [2, 90793], [5, 90913], [10, 91213], [16, 92168], [19, 92252], [26, 92572], [29, 92952], [36, 94148], [39, 94330], [42, 94610], [50, 94890], [54, 95070], [57, 95250], [64, 95630], [71, 96390], [76, 96690], [83, 97170], [88, 97530], [91, 97750], [99, 98812], [101, 98959], [107, 99259], [110, 99419], [117, 99819]]}, {"verse": 11, "start": 100939, "end": 112699, "text": "Y le dijo Dios: Yo soy el Dios Omnipotente: crece y multiplícate; una nación y conjunto de naciones procederá de ti, y reyes saldrán de tus lomos:", "words": [[0, 101059], [2, 101179], [5, 101299], [10, 101599], [16, 102554], [19, 102693], [23, 102953], [26, 103253], [31, 103473], [44, 105087], [50, 105523], [52, 105723], [66, 107159], [70, 107339], [77, 107799], [79, 108019], [88, 108499], [91, 108759], [100, 109279], [110, 109999], [113, 110079], [117, 110699], [119, 110759], [125, 111199], [133, 111819], [136, 111919], [140, 112059]]}, {"verse": 12, "start": 113289, "end": 121314, "text": "Y la tierra que yo he dado a Abraham y a Isaac, la daré a ti: y a tu descendencia después de ti daré la tierra.", "words": [[0, 113289], [2, 113396], [5, 113516], [12, 113816], [16, 114096], [19, 114296], [22, 114376], [27, 114656], [29, 114976], [37, 115336], [39, 115526], [41, 115716], [48, 116596], [51, 116796], [56, 117096], [58, 117176], [62, 118002], [64, 118184], [66, 118244], [69, 118364], [82, 119344], [90, 119704], [93, 119944], [96, 120384], [101, 120624], [104, 120684]]}, {"verse": 13, "start": 121825, "end": 126412, "text": "Y se fue de él Dios, del lugar donde con él había hablado.", "words": [[0, 121825], [2, 121947], [5, 122087], [9, 122287], [12, 122487], [15, 122787], [21, 123527], [25, 123787], [31, 124147], [37, 124567], [41, 124907], [44, 125127], [50, 125507]]}, {"verse": 14, "start": 126762, "end": 137608, "text": "Y Jacob erigió una columna en el lugar donde había hablado con él, una columna de piedra, y derramó sobre él libación, y echó sobre él aceite.", "words": [[0, 126762], [2, 126886], [8, 127166], [15, 127686], [19, 127846], [27, 128406], [30, 128546], [33, 128706], [39, 128986], [45, 129246], [51, 129606], [59, 130026], [63, 130246], [67, 130826], [71, 131106], [79, 131626], [82, 131746], [90, 132406], [92, 132966], [100, 133606], [106, 133886], [109, 134166], [119, 134906], [121, 135586], [126, 135966], [132, 136266], [135, 136666]]}, {"verse": 15, "start": 137958, "end": 143451, "text": "Y llamó Jacob el nombre de aquel lugar donde Dios había hablado con él, Bet-el.", "words": [[0, 137958], [2, 138064], [8, 138424], [14, 138804], [17, 139204], [24, 139564], [27, 139764], [33, 140104], [39, 140364], [45, 140704], [50, 141004], [56, 141444], [64, 142024], [68, 142224], [72, 142924]]}, {"verse": 16, "start": 143801, "end": 153428, "text": "Y partieron de Bet-el, y había aún como media legua de tierra para llegar a Efrata, cuando