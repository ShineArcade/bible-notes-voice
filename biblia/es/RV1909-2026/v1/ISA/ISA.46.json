{"book": "ISA", "chapter": 46, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 117272, "verses": [{"verse": 1, "start": 300, "end": 11764, "text": "Se postró Bel, se abatió Nebo; sus simulacros fueron puestos sobre bestias, y sobre animales de carga: os llevarán cargados de vosotros, carga penosa.", "words": [[0, 300], [3, 461], [10, 971], [15, 1481], [18, 1681], [25, 2174], [31, 2910], [35, 3075], [46, 4075], [53, 4555], [61, 5175], [67, 5475], [76, 6135], [78, 6315], [84, 6535], [93, 6955], [96, 7255], [103, 8171], [106, 8491], [115, 9151], [124, 9731], [127, 9911], [137, 10711], [143, 11031]]}, {"verse": 2, "start": 12214, "end": 21710, "text": "Fueron humillados, fueron abatidos juntamente; no pudieron escaparse de la carga, sino que tuvieron ellos mismos que ir en cautiverio.", "words": [[0, 12214], [7, 12494], [19, 13654], [26, 13934], [35, 15034], [47, 16351], [50, 16480], [59, 16900], [69, 17580], [72, 17700], [75, 17840], [82, 18680], [87, 18940], [91, 19100], [100, 19560], [106, 19800], [113, 20180], [117, 20460], [120, 20640], [123, 20780]]}, {"verse": 3, "start": 22010, "end": 31865, "text": "Oídme, oh casa de Jacob, y todo el resto de la casa de Israel, los que sois traídos por mí desde el vientre, los que sois llevados desde la matriz.", "words": [[0, 22010], [7, 22325], [10, 22685], [15, 22985], [18, 23165], [25, 24165], [27, 24265], [32, 24485], [35, 24705], [41, 24985], [44, 25165], [47, 25265], [52, 25565], [55, 25725], [63, 26685], [67, 26805], [71, 26965], [76, 27265], [84, 27765], [88, 27945], [91, 28165], [97, 28585], [100, 28805], [109, 29665], [113, 29765], [117, 29925], [122, 30245], [131, 30705], [137, 30905], [140, 31145]]}, {"verse": 4, "start": 32551, "end": 40461, "text": "Y hasta la vejez yo mismo, y hasta las canas os soportaré yo: yo hice, yo llevaré, yo soportaré y guardaré.", "words": [[0, 32551], [2, 32696], [8, 32896], [11, 33186], [17, 33476], [20, 33596], [27, 33916], [29, 34336], [35, 34536], [39, 34736], [45, 35196], [48, 35376], [58, 35956], [62, 36927], [65, 37111], [71, 37851], [74, 37911], [83, 38791], [86, 38891], [96, 39571], [98, 39811]]}, {"verse": 5, "start": 41172, "end": 45966, "text": "¿A quién me asemejáis, y me igualáis, y me comparáis, para que sea semejante?", "words": [[0, 41172], [3, 41296], [9, 41496], [12, 41696], [23, 42416], [25, 42856], [28, 42956], [38, 43516], [40, 43736], [43, 43836], [54, 44436], [59, 44676], [63, 44836], [67, 45016]]}, {"verse": 6, "start": 46700, "end": 54688, "text": "Sacan oro del talego, y pesan plata con balanzas, alquilan un platero para hacer un dios de ello; se humillan y adoran.", "words": [[0, 46700], [6, 47128], [10, 47408], [14, 47588], [22, 48088], [24, 48488], [30, 48888], [36, 49188], [40, 49408], [50, 50118], [59, 50828], [62, 50968], [70, 51448], [75, 51628], [81, 51908], [84, 52048], [89, 52288], [92, 52448], [98, 53364], [101, 53548], [110, 54048], [112, 54148]]}, {"verse": 7, "start": 55389, "end": 67202, "text": "Se lo echan sobre los hombros, lo llevan, y lo asientan en su lugar; allí se está, y no se mueve de su sitio. Le dan voces, y tampoco responde, ni libra de la tribulación.", "words": [[0, 55389], [3, 55515], [6, 55655], [12, 55935], [18, 56175], [22, 56375], [31, 57195], [34, 57275], [42, 57755], [44, 58115], [47, 58235], [56, 58775], [59, 58895], [62, 58995], [69, 60033], [74, 60375], [77, 60495], [83, 60875], [85, 61295], [88, 61435], [91, 61615], [97, 61935], [100, 62055], [103, 62195], [110, 63287], [113, 63412], [117, 63612], [124, 64132], [126, 64312], [134, 64592], [144, 65572], [147, 65832], [153, 66192], [156, 66312], [159, 66412]]}, {"verse": 8, "start": 67908, "end": 72868, "text": "Acordaos de esto, y tened vergüenza; volved en vosotros, prevaricadores.", "words": [[0, 67908], [9, 68471], [12, 68611], [18, 68851], [20, 69151], [26, 69471], [37, 70768], [44, 71148], [47, 71288], [57, 72078]]}, {"verse": 9, "start": 73602, "end": 81364, "text": "Acordaos de las cosas pasadas desde el siglo; porque yo soy Dios, y no hay más Dios, y nada hay a mí semejante;", "words": [[0, 73866], [9, 74166], [12, 74306], [16, 74426], [22, 74646], [30, 75246], [36, 75466], [39, 75686], [46, 76755], [53, 76994], [56, 77214], [60, 77474], [66, 77734], [68, 78234], [71, 78414], [75, 78574], [79, 78794], [85, 79114], [87, 79654], [92, 79934], [96, 80274], [98, 80334], [101, 80474]]}, {"verse": 10, "start": 82060, "end": 92344, "text": "Que anuncio lo por venir desde el principio, y desde antiguo lo que aún no era hecho; que digo: Mi consejo permanecerá, y haré todo lo que quiero;", "words": [[0, 82060], [4, 82144], [12, 82684], [15, 82864], [19, 83084], [25, 83364], [31, 83664], [34, 83884], [45, 84484], [47, 85004], [53, 85204], [61, 86084], [64, 86284], [68, 86464], [72, 86644], [75, 86884], [79, 87104], [86, 88164], [90, 88288], [96, 89302], [99, 89444], [107, 89964], [120, 90784], [122, 91004], [127, 91244], [132, 91484], [135, 91704], [139, 91824]]}, {"verse": 11, "start": 93027, "end": 101971, "text": "Que llamo desde el oriente al ave, y de tierra lejana al varón de mi consejo. Yo hablé, y lo haré venir: lo he pensado, y también lo haré.", "words": [[0, 93027], [4, 93127], [10, 93507], [16, 93707], [19, 93907], [27, 94267], [30, 94447], [35, 94707], [37, 95147], [40, 95287], [47, 95587], [54, 96187], [57, 96427], [63, 96787], [66, 96887], [69, 96967], [78, 98358], [81, 98552], [88, 98745], [90, 99005], [93, 99105], [98, 99345], [105, 100253], [108, 100371], [111, 100491], [120, 101011], [122, 101131], [130, 101351], [133, 101591]]}, {"verse": 12, "start": 102658, "end": 106262, "text": "Oídme, duros de corazón, que estáis lejos de la justicia.", "words": [[0, 102658], [7, 103062], [13, 103462], [16, 103582], [25, 104042], [29, 104522], [36, 104902], [42, 105242], [45, 105382], [48, 105462]]}, {"verse": 13, "start": 106953, "end": 116644, "text": "Haré que se acerque mi justicia, no se alejará: y mi salvación no se detendrá. Y pondré salvación