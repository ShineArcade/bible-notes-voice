{"book": "JHN", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 357252, "verses": [{"verse": 1, "start": 300, "end": 9322, "text": "Y pasadas estas cosas andaba Jesús en Galilea: que no quería andar en Judea, porque los judíos procuraban matarle.", "words": [[0, 300], [2, 407], [10, 967], [16, 1227], [22, 1727], [29, 2427], [35, 2807], [38, 3267], [47, 4303], [51, 4386], [54, 4546], [61, 4926], [67, 5386], [70, 5626], [77, 6346], [84, 6966], [88, 7226], [95, 7726], [106, 8426]]}, {"verse": 2, "start": 9672, "end": 13727, "text": "Y estaba cerca la fiesta de los judíos, la de los tabernáculos.", "words": [[0, 9672], [2, 9923], [9, 10203], [15, 10643], [18, 10923], [25, 11283], [28, 11403], [32, 11523], [40, 12323], [43, 12443], [46, 12543], [50, 13166]]}, {"verse": 3, "start": 14077, "end": 21433, "text": "Y le dijeron sus hermanos: Pásate de aquí, y vete a Judea, para que también tus discípulos vean las obras que haces.", "words": [[0, 14077], [2, 14201], [5, 14321], [13, 14821], [17, 14981], [27, 16023], [34, 16413], [37, 16593], [43, 16913], [45, 17213], [50, 17513], [52, 17633], [59, 18093], [64, 18713], [68, 18873], [76, 19213], [80, 19473], [91, 20053], [96, 20453], [100, 20573], [106, 20833], [110, 21053]]}, {"verse": 4, "start": 21783, "end": 28323, "text": "Que ninguno que busca ser conocido públicamente, hace algo en oculto. Si estas cosas haces, manifiéstate al mundo.", "words": [[0, 21783], [4, 21862], [12, 22302], [16, 22462], [22, 22722], [26, 22962], [35, 23482], [49, 24222], [54, 24602], [59, 24862], [62, 24982], [70, 25747], [73, 25886], [79, 26066], [85, 26346], [92, 27086], [105, 27706], [108, 27846]]}, {"verse": 5, "start": 28603, "end": 31516, "text": "Porque ni aun sus hermanos creían en él.", "words": [[0, 28603], [7, 28847], [10, 29147], [14, 29387], [18, 29707], [27, 30427], [34, 30907], [37, 31067]]}, {"verse": 6, "start": 31866, "end": 37786, "text": "Les dice entonces Jesús: Mi tiempo aún no ha venido; pero vuestro tiempo siempre es oportuno.", "words": [[0, 32000], [4, 32166], [9, 32333], [18, 32773], [25, 33751], [28, 33878], [35, 34258], [39, 34558], [42, 34838], [45, 34938], [53, 35691], [58, 35838], [66, 36198], [73, 36498], [81, 36838], [84, 37038]]}, {"verse": 7, "start": 38136, "end": 46821, "text": "No puede el mundo aborreceros a vosotros; pero a mí me aborrece, porque yo doy testimonio de él, que sus obras son malas.", "words": [[0, 38136], [3, 38263], [9, 38623], [12, 39063], [18, 39563], [30, 40583], [32, 40703], [42, 41716], [47, 41860], [49, 42000], [52, 42140], [55, 42670], [65, 43200], [72, 43560], [75, 43800], [79, 44040], [90, 44740], [93, 44900], [97, 45220], [101, 45300], [105, 45460], [111, 45820], [115, 46120]]}, {"verse": 8, "start": 47171, "end": 54626, "text": "Vosotros subid a esta fiesta; yo no subo aún a esta fiesta, porque mi tiempo aún no es cumplido.", "words": [[0, 47171], [9, 47691], [15, 48225], [17, 48758], [22, 48958], [30, 49871], [33, 50049], [36, 50209], [41, 50629], [45, 50809], [47, 51009], [52, 51169], [60, 51929], [67, 52409], [70, 52629], [77, 53029], [81, 53289], [84, 53609], [87, 53809]]}, {"verse": 9, "start": 54976, "end": 57689, "text": "Y habiéndoles dicho esto, se quedó en Galilea.", "words": [[0, 54976], [2, 55125], [14, 55625], [20, 55925], [26, 56245], [29, 56485], [35, 56825], [38, 56925]]}, {"verse": 10, "start": 58039, "end": 65580, "text": "Pero como sus hermanos hubieron subido, entonces él también subió a la fiesta, no abiertamente, sino como en secreto.", "words": [[0, 58039], [5, 58203], [10, 58463], [14, 58663], [23, 59223], [32, 59563], [40, 60523], [49, 60843], [52, 61283], [60, 61643], [66, 62223], [68, 62323], [71, 62403], [79, 63123], [82, 63303], [96, 64123], [101, 64423], [106, 64743], [109, 64903]]}, {"verse": 11, "start": 65930, "end": 70506, "text": "Y le buscaban los judíos en la fiesta, y decían: ¿Dónde está aquel?", "words": [[0, 65930], [2, 66054], [5, 66134], [14, 66654], [18, 66814], [25, 67334], [28, 67494], [31, 67614], [39, 68154], [41, 68734], [49, 69554], [56, 69837], [61, 70077]]}, {"verse": 12, "start": 70786, "end": 80343, "text": "Y había grande murmullo de él entre la gente: porque unos decían: Bueno es; y otros decían: No, antes engaña a la gente.", "words": [[0, 70786], [2, 70902], [8, 71082], [15, 71562], [24, 72242], [27, 72382], [30, 72622], [36, 73022], [39, 73202], [46, 74019], [53, 74304], [58, 74724], [66, 76234], [72, 76528], [76, 77049], [78, 77215], [84, 77395], [92, 78510], [96, 78755], [102, 79095], [109, 79635], [111, 79735], [114, 79775]]}, {"verse": 13, "start": 80623, "end": 85043, "text": "Pero ninguno hablaba abiertamente de él, por miedo de los judíos.", "words": [[0, 80623], [5, 80790], [13, 81270], [21, 81670], [34, 82410], [37, 82590], [41, 83010], [45, 83630], [51, 83990], [54, 84190], [58, 84310]]}, {"verse": 14, "start": 85393, "end": 89035, "text": "Y al medio de la fiesta subió Jesús al templo, y enseñaba.", "words": [[0, 85393], [2, 85491], [5, 85591], [11, 85831], [14, 86011], [17, 86111], [24, 86431], [30, 86831], [36, 87111], [39, 87431], [47, 88011], [49, 88111]]}, {"verse": 15, "start": 89385, "end": 94948, "text": "Y se maravillaban los judíos, diciendo: ¿Cómo tiene este conocimientos, sin haber estudiado?", "words": [[0, 89385], [2, 89491], [5, 89631], [18, 90331], [22, 90491], [30, 91071], [40, 92098], [46, 92258], [52, 92598], [57, 93078], [72, 93558], [76, 93978], [82, 94218]]}, {"verse": 16, "start": 95228, "end": 100812, "text": "Les respondió Jesús, y dijo: Mi doctrina no es mía, sino de aquel que me envió.", "words": [[0, 95228], [4, 95383], [14, 95943], [21, 96383], [23, 96802], [29, 97387], [32, 97513], [41, 98033], [44, 98293], [47, 98433], [52, 99093], [57, 99293], [60, 99533], [66, 99913], [70, 100073], [73, 100213]]}, {"verse": 17, "start": 101162, "end": 108803, "text": "El que quiera hacer la voluntad de Dios, conocerá si la doctrina es de Dios, o si yo hablo de mí mismo.", "words": [[0, 101162], [3, 101308], [7, 101468], [14, 101908], [20, 102308], [23, 102548], [32, 103208], [35, 103368], [41, 104188], [50, 105128], [53, 105228], [56, 105408], [65, 105908], [68, 106188], [71, 106328], [77, 106668], [79, 107188], [82, 107348], [85, 107588], [91, 107948], [94, 108088], [97, 108228]]}, {"verse": 18, "start": 109153, "end": 120096, "text": "El que habla de sí mismo, su propia gloria busca; pero el que busca la gloria del que le envió, este es verdadero, y no hay en él injusticia.", "words": [[0, 109153], [3, 109276], [7, 109416], [13, 109656], [16, 109856], [19, 110056], [26, 110436], [29, 110876], [36, 111336], [43, 111816], [50, 112659], [55, 112822], [58, 112962], [62, 113062], [68, 113342], [71, 113562], [78, 113962], [82, 114142], [86, 114342], [89, 114522], [96, 115462], [101, 116002], [104, 116262], [115, 117082], [117, 117502], [120, 117722], [124, 118082], [127, 118582], [130, 118802]]}, {"verse": 19, "start": 120446, "end": 127026, "text": "¿No os dio Moisés la ley, y ninguno de vosotros cumple la ley? ¿Por qué me procuráis matar?", "words": [[0, 120446], [4, 120675], [7, 120835], [11, 121095], [18, 121695], [21, 122035], [26, 122355], [28, 122795], [36, 123295], [39, 123395], [48, 123845], [55, 124295], [58, 124415], [63, 125339], [68, 125444], [72, 125644], [75, 125784], [85, 126424]]}, {"verse": 20, "start": 127376, "end": 131559, "text": "Respondió la gente, y dijo: Demonio tienes: ¿quién te procura matar?", "words": [[0, 127376], [10, 127920], [13, 128040], [20, 128340], [22, 128560], [28, 129251], [36, 129695], [44, 130439], [51, 130643], [54, 130703], [62, 131063]]}, {"verse": 21, "start": 131839, "end": 137589, "text": "Jesús respondió, y les dijo: Una obra hice, y todos os maravilláis.", "words": [[0, 131839], [6, 132191], [17, 133231], [19, 133491], [23, 133591], [29, 134333], [33, 134557], [38, 134917], [44, 135377], [46, 135937], [52, 136257], [55, 136537]]}, {"verse": 22, "start": 137939, "end": 146704, "text": "Cierto, Moisés os dio la circuncisión (no porque sea de Moisés, sino de los padres); y en sábado circuncidáis al hombre.", "words": [[0, 137939], [8, 138423], [15, 138983], [18, 139303], [22, 139583], [25, 139763], [38, 141183], [42, 141263], [49, 141583], [53, 141843], [56, 142003], [64, 142763], [69, 143043], [72, 143223], [76, 143363], [85, 144252], [87, 144401], [90, 144541], [97, 145121], [110, 146021], [113, 146221]]}, {"verse": 23, "start": 147054, "end": 159634, "text": "Si recibe el hombre la circuncisión en sábado, para que la ley de Moisés no sea quebrantada, ¿os enojáis conmigo porque en sábado hice sano todo un hombre?", "words": [[0, 147054], [3, 147205], [10, 147785], [13, 147945], [20, 148225], [23, 148685], [36, 149665], [39, 149825], [47, 150445], [52, 151225], [56, 151405], [59, 151545], [63, 151745], [66, 151885], [73, 152305], [76, 152925], [80, 153165], [93, 154485], [97, 155225], [105, 155985], [113, 156685], [120, 157025], [123, 157245], [130, 157845], [135, 158145], [140, 158525], [145, 158805], [148, 159065]]}, {"verse": 24, "start": 159984, "end": 165019, "text": "No juzguéis según lo que parece, sino juzgad con justicia.", "words": [[0, 159984], [3, 160151], [12, 160831], [18, 161291], [21, 161551], [25, 161671], [33, 162731], [38, 163071], [45, 163791], [49, 164091]]}, {"verse": 25, "start": 165369, "end": 171403, "text": "Decían entonces unos de los de Jerusalén: ¿No es este al que buscan para matarlo?", "words": [[0, 165369], [7, 165896], [16, 166456], [21, 167236], [24, 167636], [28, 167796], [31, 168116], [42, 169218], [46, 169418], [49, 169658], [54, 169938], [57, 170038], [61, 170178], [68, 170578], [73, 170758]]}, {"verse": 26, "start": 171753, "end": 178650, "text": "Y he aquí, habla públicamente, y no le dicen nada; ¿Habrán entendido verdaderamente los dirigentes, que este es el Cristo?", "words": [[0, 171753], [2, 171864], [5, 172014], [11, 172274], [17, 172534], [31, 173334], [33, 173614], [36, 173734], [39, 173834], [45, 174074], [51, 174854], [59, 175334], [69, 175834], [84, 176534], [88, 176754], [100, 177374], [104, 177634], [109, 177814], [112, 177954], [115, 178074]]}, {"verse": 27, "start": 179000, "end": 184529, "text": "Pero este, sabemos de dónde es; mas cuando venga el Cristo, nadie sabrá de dónde sea.", "words": [[0, 179000], [5, 179300], [11, 179520], [19, 179920], [22, 180120], [28, 180240], [32, 181018], [36, 181195], [43, 181395], [49, 181855], [52, 181975], [60, 182835], [66, 183135], [72, 183655], [75, 183815], [81, 183955]]}, {"verse": 28, "start": 184809, "end": 199134, "text": "Entonces clamaba Jesús en el templo, enseñando y diciendo: Y a mí me conocéis, y sabéis de dónde soy; y no he venido de mí mismo; pero el que me envió es verdadero, al cual vosotros no conocéis.", "words": [[0, 184809], [9, 185796], [17, 186316], [23, 186636], [26, 186976], [29, 187136], [37, 187936], [47, 188656], [49, 188776], [59, 189693], [61, 189841], [63, 189881], [66, 190021], [69, 190181], [79, 190881], [81, 191221], [88, 191641], [91, 191781], [97, 191981], [102, 192792], [104, 192920], [107, 193100], [110, 193240], [117, 193660], [120, 193800], [123, 193960], [130, 194819], [135, 195003], [138, 195163], [142, 195323], [145, 195523], [151, 195903], [154, 196043], [165, 196523], [168, 197003], [173, 197223], [182, 197843], [185, 198103]]}, {"verse": 29, "start": 199484, "end": 202926, "text": "Yo le conozco, porque de él soy, y él me envió.", "words": [[0, 199484], [3, 199669], [6, 199809], [15, 200369], [22, 200709], [25, 200909], [28, 201029], [33, 201469], [35, 202009], [38, 202209], [41, 202389]]}, {"verse": 30, "start": 203276, "end": 209775, "text": "Entonces procuraban prenderle; pero ninguno puso en él mano, porque aún no había venido su hora.", "words": [[0, 203276], [9, 203759], [20, 204639], [31, 205889], [36, 206051], [44, 206511], [49, 206891], [52, 207031], [55, 207151], [61, 207491], [68, 207871], [72, 208151], [75, 208351], [81, 208611], [88, 209051], [91, 209271]]}, {"verse": 31, "start": 210125, "end": 218274, "text": "Y muchos del pueblo creyeron en él, y decían: El Cristo, cuando venga, ¿hará más señales que las que este hace?", "words": [[0, 210125], [2, 210408], [9, 210708], [13, 210968], [20, 211348], [29, 212188], [32, 212328], [36, 212928], [38, 213368], [46, 214477], [49, 214605], [57, 214925], [64, 215185], [71, 215725], [77, 216425], [81, 216545], [89, 217025], [93, 217225], [97, 217365], [101, 217565], [106, 217805]]}, {"verse": 32, "start": 218554, "end": 228403, "text": "Los fariseos oyeron a la gente que murmuraba de él estas cosas; y los príncipes de los sacerdotes y los fariseos enviaron guardias que lo arrestaran.", "words": [[0, 218554], [4, 218930], [13, 219340], [20, 219840], [22, 220000], [25, 220080], [31, 220420], [35, 220680], [45, 221420], [48, 221640], [51, 221860], [57, 222060], [64, 223135], [66, 223222], [70, 223322], [80, 223922], [83, 224042], [87, 224162], [98, 224862], [100, 225042], [104, 225162], [113, 225922], [122, 226642], [131, 227302], [135, 227422], [138, 227582]]}, {"verse": 33, "start": 228753, "end": 234168, "text": "Y Jesús dijo: Aun un poco de tiempo estaré con vosotros, e iré al que me envió.", "words": [[0, 228753], [2, 228876], [8, 229196], [14, 230049], [18, 230288], [21, 230488], [26, 230728], [29, 230888], [36, 231128], [43, 231648], [47, 231788], [57, 232408], [59, 232828], [63, 233188], [66, 233328], [70, 233488], [73, 233648]]}, {"verse": 34, "start": 234518, "end": 239970, "text": "Me buscaréis, y no me hallaréis; y donde yo estaré, vosotros no podréis venir.", "words": [[0, 234518], [3, 234622], [14, 235382], [16, 235862], [19, 236022], [22, 236557], [33, 237251], [35, 237349], [41, 237529], [44, 237769], [52, 238489], [61, 238969], [64, 239149], [72, 239589]]}, {"verse": 35, "start": 240320, "end": 249121, "text": "Entonces los judíos dijeron entre sí: ¿A dónde se ha de ir este que no le hallemos? ¿Se ha de ir a los esparcidos entre los griegos, y a enseñar a los griegos?", "words": [[0, 240320], [9, 240940], [13, 241500], [20, 241960], [28, 242460], [34, 242700], [38, 243325], [41, 243450], [47, 243590], [50, 243730], [53, 243870], [56, 244030], [59, 244150], [64, 244370], [68, 244510], [71, 244630], [74, 244750], [84, 245546], [88, 245704], [91, 245804], [94, 245864], [97, 245964], [99, 246044], [103, 246184], [114, 246764], [120, 247024], [124, 247204], [133, 247684], [135, 247884], [137, 247944], [145, 248324], [147, 248344], [151, 248484]]}, {"verse": 36, "start": 249471, "end": 256022, "text": "¿Qué dicho es este que dijo: Me buscaréis, y no me hallaréis; y donde yo estaré, vosotros no podréis venir?", "words": [[0, 249471], [5, 249575], [11, 249795], [14, 249955], [19, 250195], [23, 250335], [29, 251239], [32, 251319], [43, 251879], [45, 252079], [48, 252199], [51, 252339], [62, 253125], [64, 253222], [70, 253382], [73, 253602], [81, 254242], [90, 254602], [93, 254782], [101, 255182]]}, {"verse": 37, "start": 256302, "end": 265349, "text": "Pero en el último día grande de la fiesta, Jesús se ponía en pie y clamaba, diciendo: Si alguno tiene sed, venga a mí y beba.", "words": [[0, 256302], [5, 256444], [8, 256604], [11, 256704], [18, 256964], [22, 257364], [29, 257724], [32, 257944], [35, 258064], [43, 258884], [49, 259324], [52, 259884], [58, 260324], [61, 260484], [65, 260764], [67, 261064], [76, 261624], [86, 262650], [89, 262943], [96, 263383], [102, 263563], [107, 264123], [113, 264403], [115, 264583], [118, 264723], [120, 264923]]}, {"verse": 38, "start": 265699, "end": 271585, "text": "El que cree en mí, como dice la Escritura, ríos de agua viva correrán de su vientre.", "words": [[0, 265699], [3, 265845], [7, 265985], [12, 266265], [15, 266485], [19, 267145], [24, 267305], [29, 267605], [32, 267805], [43, 268515], [48, 269225], [51, 269365], [56, 269625], [61, 270005], [70, 270605], [73, 270725], [76, 270885]]}, {"verse": 39, "start": 271935, "end": 281653, "text": "(Y esto dijo del Espíritu que habían de recibir los que creyesen en él: pues aún no había venido el Espíritu Santo; porque Jesús no estaba aún glorificado.)", "words": [[0, 271935], [3, 272273], [8, 272493], [13, 272773], [17, 272993], [26, 273533], [30, 273653], [37, 273893], [40, 274113], [48, 274493], [52, 274753], [56, 274893], [65, 275513], [68, 275613], [72, 276215], [77, 276337], [81, 276597], [84, 276837], [90, 277077], [97, 277537], [100, 277637], [109, 278137], [116, 278961], [123, 279148], [129, 279548], [132, 280028], [139, 280348], [143, 280668]]}, {"verse": 40, "start": 282003, "end": 289042, "text": "Entonces algunos de la multitud, oyendo este dicho, decían: Verdaderamente este es el profeta.", "words": [[0, 282003], [9, 282842], [17, 283302], [20, 283522], [23, 283622], [33, 284582], [40, 284942], [45, 285222], [52, 286142], [60, 287062], [75, 287784], [80, 288124], [83, 288304], [86, 288444]]}, {"verse": 41, "start": 289322, "end": 296032, "text": "Otros decían: Este es el Cristo. Pero algunos decían: ¿De Galilea ha de venir el Cristo?", "words": [[0, 289322], [6, 289693], [14, 290921], [19, 291227], [22, 291567], [25, 291707], [33, 292546], [38, 292710], [46, 293090], [54, 294168], [58, 294295], [66, 294550], [69, 294805], [72, 295060], [78, 295315], [81, 295415]]}, {"verse": 42, "start": 296382, "end": 302705, "text": "¿No dice la Escritura, que del linaje de David, y de la aldea de Belén, de donde era David, vendrá el Cristo?", "words": [[0, 296382], [4, 296485], [9, 296685], [12, 296845], [23, 297325], [27, 297565], [31, 297705], [38, 298165], [41, 298285], [48, 298605], [50, 298925], [53, 299025], [56, 299165], [62, 299465], [65, 299605], [72, 300025], [75, 300445], [81, 300685], [85, 300925], [92, 301325], [99, 301985], [102, 302105]]}, {"verse": 43, "start": 302985, "end": 306079, "text": "Así que había división entre la gente acerca de él.", "words": [[0, 302985], [4, 303219], [8, 303419], [14, 303639], [23, 304279], [29, 304519], [32, 304719], [38, 304999], [45, 305379], [48, 305739]]}, {"verse": 44, "start": 306079, "end": 311352, "text": "Y algunos de ellos querían prenderle; pero ninguno echó sobre él manos.", "words": [[0, 306139], [2, 306199], [10, 306759], [13, 307039], [19, 307279], [27, 307699], [38, 308870], [43, 309015], [51, 309695], [56, 310195], [62, 310515], [65, 310715]]}, {"verse": 45, "start": 311702, "end": 319542, "text": "Y los guardias vinieron a los principales sacerdotes y a los fariseos; y ellos les dijeron: ¿Por qué no le trajisteis?", "words": [[0, 311702], [2, 311872], [6, 312032], [15, 312492], [24, 313112], [26, 313292], [30, 313392], [42, 314112], [53, 314952], [55, 315192], [57, 315292], [61, 315412], [71, 316561], [73, 316745], [79, 317015], [83, 317285], [92, 318177], [97, 318299], [101, 318539], [104, 318639], [107, 318719]]}, {"verse": 46, "start": 319822, "end": 323964, "text": "Los guardias respondieron: Nunca ha hablado hombre así como este hombre.", "words": [[0, 319822], [4, 319948], [13, 320528], [27, 321943], [33, 322265], [36, 322365], [44, 322665], [51, 322885], [55, 323085], [60, 323325], [65, 323565]]}, {"verse": 47, "start": 324244, "end": 329849, "text": "Entonces los fariseos les respondieron: ¿Estáis también vosotros engañados?", "words": [[0, 324244], [9, 324829], [13, 325489], [22, 326289], [26, 326569], [40, 327785], [48, 328126], [56, 328446], [65, 328906]]}, {"verse": 48, "start": 330199, "end": 333440, "text": "¿Ha creído en él alguno de los dirigentes, o de los fariseos?", "words": [[0, 330199], [4, 330301], [11, 330661], [14, 330781], [17, 330881], [24, 331281], [27, 331361], [31, 331481], [43, 332141], [45, 332401], [48, 332501], [52, 332621]]}, {"verse": 49, "start": 333790, "end": 336452, "text": "Pero esta gente que no sabe la ley, maldita es.", "words": [[0, 333790], [5, 333912], [10, 334132], [16, 334452], [20, 334672], [23, 334792], [28, 335032], [31, 335192], [36, 335612], [44, 336032]]}, {"verse": 50, "start": 336732, "end": 341572, "text": "Les dice Nicodemo (el que vino a él de noche, el cual era uno de ellos):", "words": [[0, 336797], [4, 336897], [9, 337137], [18, 337919], [22, 338022], [26, 338162], [31, 338382], [33, 338562], [36, 338682], [39, 338822], [46, 339662], [49, 339822], [54, 340102], [58, 340562], [62, 340922], [65, 341142]]}, {"verse": 51, "start": 341772, "end": 346521, "text": "¿Juzga nuestra ley a hombre, si primero no oye de él, y entiende lo que ha hecho?", "words": [[0, 341772], [7, 342157], [15, 342357], [19, 342797], [21, 342937], [29, 343237], [32, 343657], [40, 344037], [43, 344277], [47, 344537], [50, 344697], [54, 344937], [56, 345257], [65, 345697], [68, 345857], [72, 345997], [75, 346117]]}, {"verse": 52, "start": 346801, "end": 354508, "text": "Respondieron y le dijeron: ¿Eres tú también galileo? Escudriña y ve que de Galilea nunca se levantó profeta.", "words": [[0, 346801], [13, 347606], [15, 348026], [18, 348146], [27, 349026], [33, 349250], [36, 349490], [44, 349850], [53, 350825], [63, 351608], [65, 351928], [68, 352068], [72, 352228], [75, 352368], [83, 352908], [89, 353188], [92, 353488], [100, 353988]]}, {"verse": 53, "start": 354788, "end": 356852, "text": "Y se fue cada uno a su casa.", "words": [[0, 354788], [2, 354913], [5, 355053], [9, 355273], [14, 355573], [18, 355913], [20, 356113], [23, 356213]]}]}