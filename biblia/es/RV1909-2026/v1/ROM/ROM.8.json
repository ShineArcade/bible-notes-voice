{"book": "ROM", "chapter": 8, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 296410, "verses": [{"verse": 1, "start": 300, "end": 8977, "text": "Ahora pues, ninguna condenación hay para los que están en Cristo Jesús, los que no andan conforme a la carne, sino conforme al espíritu.", "words": [[0, 300], [6, 538], [12, 1258], [20, 1618], [32, 2518], [36, 2858], [41, 3098], [45, 3298], [49, 3438], [55, 3698], [58, 3838], [65, 4138], [72, 5138], [76, 5318], [80, 5478], [83, 5658], [89, 5938], [98, 6478], [100, 6538], [103, 6618], [110, 7358], [115, 7538], [124, 8218], [127, 8318]]}, {"verse": 2, "start": 9327, "end": 14394, "text": "Porque la ley del Espíritu de vida en Cristo Jesús me ha librado de la ley del pecado y de la muerte.", "words": [[0, 9327], [7, 9506], [10, 9646], [14, 9826], [18, 9966], [27, 10506], [30, 10606], [35, 10806], [38, 10946], [45, 11246], [51, 11846], [54, 12011], [57, 12091], [65, 12491], [68, 12631], [71, 12731], [75, 12911], [79, 13051], [86, 13531], [88, 13651], [91, 13751], [94, 13851]]}, {"verse": 3, "start": 14744, "end": 25908, "text": "Porque lo que era imposible a la ley, por cuanto era débil por la carne, Dios enviando a su Hijo en semejanza de carne de pecado, y a causa del pecado, condenó al pecado en la carne;", "words": [[0, 14744], [7, 14970], [10, 15170], [14, 15310], [18, 15490], [28, 16110], [30, 16230], [33, 16310], [38, 16950], [42, 17190], [49, 17490], [53, 17750], [59, 18110], [63, 18310], [66, 18470], [73, 19250], [78, 19630], [87, 20150], [89, 20270], [92, 20470], [97, 20690], [100, 20810], [110, 21470], [113, 21590], [119, 21870], [122, 22030], [130, 22860], [132, 22982], [134, 23062], [140, 23282], [144, 23502], [152, 24262], [160, 24742], [163, 24842], [170, 25242], [173, 25342], [176, 25442]]}, {"verse": 4, "start": 26258, "end": 32557, "text": "Para que la justicia de la ley fuese cumplida en nosotros, que no andamos conforme a la carne, sino conforme al espíritu.", "words": [[0, 26258], [5, 26380], [9, 26500], [12, 26580], [21, 27080], [24, 27220], [27, 27340], [31, 27540], [37, 27840], [46, 28340], [49, 28440], [59, 28860], [63, 29380], [66, 29540], [74, 29900], [83, 30400], [85, 30460], [88, 30520], [95, 30880], [100, 31320], [109, 31880], [112, 31960]]}, {"verse": 5, "start": 32907, "end": 41578, "text": "Porque los que viven conforme a la carne, de las cosas que son de la carne se ocupan; pero los que conforme al espíritu, de las cosas del espíritu.", "words": [[0, 32907], [7, 33091], [11, 33291], [15, 33451], [21, 33751], [30, 33991], [32, 34231], [35, 34351], [42, 35091], [45, 35271], [49, 35411], [55, 35691], [59, 35911], [63, 36131], [66, 36251], [69, 36351], [75, 36651], [78, 36831], [86, 37633], [91, 37755], [95, 37935], [99, 38075], [108, 38595], [111, 38655], [121, 39315], [124, 39595], [128, 39735], [134, 39995], [138, 40235]]}, {"verse": 6, "start": 41928, "end": 47295, "text": "Porque la mente puesta en la carne es muerte; pero la mente puesta en el espíritu, vida y paz:", "words": [[0, 41928], [7, 42107], [10, 42267], [16, 42467], [23, 42947], [26, 43047], [29, 43167], [35, 43507], [38, 43667], [46, 44483], [51, 44625], [54, 44805], [60, 45045], [67, 45545], [70, 45645], [73, 45745], [83, 46465], [88, 46765], [90, 46945]]}, {"verse": 7, "start": 47645, "end": 54304, "text": "Por cuanto la intención de la carne es enemistad contra Dios; porque no se sujeta a la ley de Dios, ni tampoco puede.", "words": [[0, 47645], [4, 47771], [11, 47951], [14, 48211], [24, 48711], [27, 48831], [30, 48971], [36, 49311], [39, 49571], [49, 50231], [56, 50531], [62, 51410], [69, 51510], [72, 51650], [75, 51770], [82, 52020], [84, 52270], [87, 52350], [91, 52570], [94, 52710], [100, 53250], [103, 53390], [111, 53710]]}, {"verse": 8, "start": 54654, "end": 57679, "text": "Así que, los que están en la carne no pueden agradar a Dios.", "words": [[0, 54654], [4, 54876], [9, 55056], [13, 55196], [17, 55356], [23, 55616], [26, 55756], [29, 55856], [35, 56176], [38, 56376], [45, 56636], [53, 57096], [55, 57176]]}, {"verse": 9, "start": 58029, "end": 67772, "text": "Pero vosotros no estáis en la carne, sino en el espíritu, si es que el Espíritu de Dios mora en vosotros. Y si alguno no tiene el Espíritu de Cristo, el tal no es de él.", "words": [[0, 58029], [5, 58188], [14, 58608], [17, 58848], [24, 59248], [27, 59348], [30, 59468], [37, 59788], [42, 60128], [45, 60288], [48, 60408], [58, 61408], [61, 61548], [64, 61708], [68, 61828], [71, 61928], [80, 62468], [83, 62548], [88, 62788], [93, 63228], [96, 63288], [106, 64048], [108, 64158], [111, 64258], [118, 64658], [121, 64758], [127, 64998], [130, 65178], [139, 65698], [142, 65778], [150, 66718], [153, 66818], [157, 67018], [160, 67218], [163, 67358], [166, 67538]]}, {"verse": 10, "start": 68122, "end": 75900, "text": "Pero si Cristo está en vosotros, el cuerpo a la verdad está muerto a causa del pecado; pero el espíritu vive a causa de la justicia.", "words": [[0, 68122], [5, 68247], [8, 68407], [15, 68767], [20, 69047], [23, 69207], [33, 70087], [36, 70207], [43, 70547], [45, 70687], [48, 70747], [55, 71047], [60, 71407], [67, 71807], [69, 71947], [75, 72167], [79, 72407], [87, 73183], [92, 73343], [95, 73503], [104, 74103], [109, 74303], [111, 74523], [117, 74763], [120, 75023], [123, 75123]]}, {"verse": 11, "start": 76250, "end": 87753, "text": "Y si el Espíritu de aquel que levantó de los muertos a Jesús mora en vosotros, el que levantó a Cristo Jesús de los muertos, vivificará también vuestros cuerpos mortales por su Espíritu que mora en vosotros.", "words": [[0, 76250], [2, 76358], [5, 76478], [8, 76578], [17, 77098], [20, 77198], [26, 77478], [30, 77558], [38, 78078], [41, 78158], [45, 78258], [53, 78718], [55, 78878], [61, 79138], [66, 79718], [69, 79798], [79, 80698], [82, 80798], [86, 80918], [94, 81418], [96, 81538], [103, 81738], [109, 82218], [112, 82378], [116, 82498], [125, 83401], [136, 84064], [144, 84344], [153, 84784], [161, 85184], [170, 85684], [174, 85884], [177, 86044], [186, 86564], [190, 86684], [195, 86984], [198, 87064]]}, {"verse": 12, "start": 88103, "end": 93310, "text": "Así que, hermanos, deudores somos, no a la carne, para que vivamos conforme a la carne:", "words": [[0, 88103], [4, 88267], [9, 88447], [19, 89167], [28, 89627], [35, 90427], [38, 90547], [40, 90667], [43, 90747], [50, 91407], [55, 91587], [59, 91747], [67, 92167], [76, 92707], [78, 92727], [81, 92827]]}, {"verse": 13, "start": 93660, "end": 100128, "text": "Porque si vivís conforme a la carne, moriréis; pero si por el espíritu hacéis morir las obras de la carne, viviréis.", "words": [[0, 93660], [7, 93840], [10, 94040], [16, 94400], [25, 94940], [27, 95000], [30, 95080], [37, 95340], [47, 96411], [52, 96555], [55, 96715], [59, 96915], [62, 97035], [71, 97595], [78, 98015], [84, 98355], [88, 98495], [94, 98755], [97, 98935], [100, 99055], [107, 99375]]}, {"verse": 14, "start": 100478, "end": 105379, "text": "Porque todos los que son guiados por el Espíritu de Dios, los tales son hijos de Dios.", "words": [[0, 100478], [7, 100658], [13, 100958], [17, 101218], [21, 101358], [25, 101538], [33, 101998], [37, 102238], [40, 102338], [49, 102838], [52, 102938], [58, 103758], [62, 103838], [68, 104118], [72, 104438], [78, 104658], [81, 104878]]}, {"verse": 15, "start": 105729, "end": 114897, "text": "Porque no habéis recibido el espíritu de esclavitud para estar otra vez en temor; sino que habéis recibido el espíritu de adopción, por el cual clamamos, Abba, Padre.", "words": [[0, 105729], [7, 105888], [10, 106108], [17, 106388], [26, 106928], [29, 107028], [38, 107528], [41, 107608], [52, 108148], [57, 108588], [63, 108808], [68, 109028], [72, 109308], [75, 109468], [82, 110219], [87, 110414], [91, 110614], [98, 110914], [107, 111514], [110, 111614], [119, 112174], [122, 112254], [132, 112734], [136, 113014], [139, 113134], [144, 113274], [154, 113954], [160, 114394]]}, {"verse": 16, "start": 115247, "end": 119183, "text": "Porque el mismo Espíritu da testimonio a nuestro espíritu que somos hijos de Dios.", "words": [[0, 115247], [7, 115448], [10, 115608], [16, 115808], [25, 116388], [28, 116488], [39, 117108], [41, 117148], [49, 117288], [58, 117908], [62, 117988], [68, 118228], [74, 118548], [77, 118788]]}, {"verse": 17, "start": 119533, "end": 130077, "text": "Y si hijos, también herederos; herederos de Dios, y coherederos de Cristo; si en verdad padecemos juntamente con él, para que juntamente con él seamos glorificados.", "words": [[0, 119533], [2, 119631], [5, 119731], [12, 119991], [20, 120251], [31, 121270], [41, 121790], [44, 121930], [50, 122170], [52, 122590], [64, 123290], [67, 123390], [75, 124360], [78, 124528], [81, 124628], [88, 124868], [98, 125448], [109, 126088], [113, 126388], [117, 126588], [122, 127068], [126, 127228], [137, 127808], [141, 128088], [144, 128248], [151, 128648]]}, {"verse": 18, "start": 130427, "end": 137479, "text": "Porque tengo por cierto que lo que en este tiempo se padece, no es de comparar con la gloria venidera que en nosotros ha de ser manifestada.", "words": [[0, 130427], [7, 130606], [13, 130846], [17, 131066], [24, 131366], [28, 131626], [31, 131766], [35, 131906], [38, 132026], [43, 132226], [50, 132606], [53, 132786], [61, 133226], [64, 133551], [67, 133691], [70, 133811], [79, 134371], [83, 134471], [86, 134631], [93, 134931], [102, 135491], [106, 135571], [109, 135651], [118, 135971], [121, 136411], [124, 136491], [128, 136651]]}, {"verse": 19, "start": 137829, "end": 142813, "text": "Porque el continuo anhelar de la creación espera la manifestación de los hijos de Dios.", "words": [[0, 137829], [7, 138037], [10, 138177], [19, 138757], [27, 139217], [30, 139317], [33, 139437], [42, 140117], [49, 140617], [52, 140817], [66, 141597], [69, 141757], [73, 141897], [79, 142117], [82, 142337]]}, {"verse": 20, "start": 143163, "end": 149455, "text": "Porque la creación fue sujetada a frustración, no voluntariamente, sino por causa del que la sujetó con esperanza,", "words": [[0, 143163], [7, 143332], [10, 143512], [19, 144012], [23, 144212], [32, 144832], [34, 144912], [47, 145552], [50, 145832], [67, 146912], [72, 147092], [76, 147332], [82, 147612], [86, 147852], [90, 147992], [93, 148132], [100, 148592], [104, 148732]]}, {"verse": 21, "start": 149805, "end": 156179, "text": "Que también la creación misma será librada de la servidumbre de corrupción en la libertad gloriosa de los hijos de Dios.", "words": [[0, 149805], [4, 149887], [12, 150207], [15, 150387], [24, 150827], [30, 151087], [35, 151407], [43, 151887], [46, 152027], [49, 152127], [61, 152767], [64, 152887], [75, 153507], [78, 153747], [81, 153827], [90, 154347], [99, 154847], [102, 155027], [106, 155147], [112, 155407], [115, 155647]]}, {"verse": 22, "start": 156529, "end": 160784, "text": "Porque sabemos que toda la creación gime y está de parto juntamente hasta ahora.", "words": [[0, 156529], [7, 156707], [15, 157047], [19, 157287], [24, 157467], [27, 157667], [36, 158137], [41, 158607], [43, 158807], [48, 158987], [51, 159127], [57, 159487], [68, 160107], [74, 160327]]}, {"verse": 23, "start": 161134, "end": 172356, "text": "Y no solo ella, sino también nosotros mismos, que tenemos las primicias del Espíritu, nosotros también gemimos dentro de nosotros mismos, esperando la adopción, es decir, la redención de nuestro cuerpo.", "words": [[0, 161134], [2, 161237], [5, 161337], [10, 161557], [16, 161897], [21, 162197], [29, 162597], [38, 162817], [46, 163377], [50, 163672], [58, 164012], [62, 164212], [72, 164632], [76, 164832], [86, 165492], [95, 165892], [103, 166412], [111, 166992], [118, 167232], [121, 167452], [130, 167652], [138, 168272], [148, 169012], [151, 169332], [161, 169852], [164, 170052], [171, 170802], [174, 170899], [184, 171419], [187, 171559], [195, 171739]]}, {"verse": 24, "start": 172706, "end": 179436, "text": "Porque en esperanza somos salvos; pero la esperanza que se ve, no es esperanza; porque lo que alguno ve, ¿a qué esperarlo?", "words": [[0, 172706], [7, 172906], [10, 172986], [20, 173506], [26, 173746], [34, 174678], [39, 174814], [42, 174974], [52, 175434], [56, 175574], [59, 175714], [63, 175914], [66, 176214], [69, 176354], [80, 177354], [87, 177504], [90, 177664], [94, 177784], [101, 178124], [105, 178244], [108, 178544], [112, 178684]]}, {"verse": 25, "start": 179786, "end": 182734, "text": "Pero si lo que no vemos esperamos, por paciencia esperamos.", "words": [[0, 179786], [5, 180004], [8, 180164], [11, 180284], [15, 180404], [18, 180524], [24, 180784], [35, 181364], [39, 181584], [49, 182084]]}, {"verse": 26, "start": 183084, "end": 193481, "text": "Y asimismo también el Espíritu ayuda nuestra debilidad: porque qué hemos de pedir como conviene, no lo sabemos; sino que el mismo Espíritu pide por nosotros con gemidos indecibles.", "words": [[0, 183084], [2, 183194], [11, 183754], [19, 184054], [22, 184314], [31, 184954], [37, 185274], [45, 185514], [56, 186615], [63, 186765], [67, 186959], [73, 187152], [76, 187392], [82, 187612], [87, 187892], [97, 188552], [100, 188652], [103, 188772], [112, 189659], [117, 189861], [121, 190061], [124, 190161], [130, 190381], [139, 191021], [144, 191301], [148, 191501], [157, 191861], [161, 192261], [169, 192661]]}, {"verse": 27, "start": 193831, "end": 202862, "text": "Pero el que escudriña los corazones, sabe cuál es la intención del Espíritu, porque conforme a la voluntad de Dios, intercede por los santos.", "words": [[0, 193831], [5, 193968], [8, 194108], [12, 194228], [22, 194868], [26, 195008], [37, 195808], [42, 196428], [47, 196728], [50, 196968], [53, 197108], [63, 197628], [67, 197788], [77, 198528], [84, 199008], [93, 199708], [95, 199788], [98, 199848], [107, 200408], [110, 200528], [116, 200828], [126, 201708], [130, 201968], [134, 202128]]}, {"verse": 28, "start": 203212, "end": 210969, "text": "Y sabemos que a los que a Dios aman, todas las cosas les ayudan a bien, es decir, a los que conforme al propósito son llamados.", "words": [[0, 203212], [2, 203343], [10, 203563], [14, 204003], [16, 204103], [20, 204223], [24, 204390], [26, 204556], [31, 204723], [37, 205523], [43, 205603], [47, 205883], [53, 206223], [57, 206483], [64, 206963], [66, 207003], [72, 207763], [75, 207803], [82, 208623], [84, 208703], [88, 208823], [92, 209070], [101, 209316], [104, 209563], [114, 210083], [118, 210303]]}, {"verse": 29, "start": 211319, "end": 220133, "text": "Porque a los que antes conoció, también predestinó para que fuesen hechos conformes a la imagen de su Hijo, para que él sea el primogénito entre muchos hermanos;", "words": [[0, 211319], [7, 211549], [9, 211649], [13, 211789], [17, 211949], [23, 212209], [32, 213249], [40, 213309], [51, 214089], [56, 214269], [60, 214429], [67, 214849], [74, 215109], [84, 215789], [86, 215909], [89, 215989], [96, 216289], [99, 216469], [102, 216649], [108, 217249], [113, 217529], [117, 217729], [120, 217869], [124, 218069], [127, 218229], [139, 218889], [145, 219089], [152, 219369]]}, {"verse": 30, "start": 220483, "end": 230078, "text": "Y a los que predestinó, a estos también llamó; y a los que llamó, a estos también justificó; y a los que justificó, a estos también glorificó.", "words": [[0, 220483], [2, 220606], [4, 220666], [8, 220806], [12, 220946], [24, 222126], [26, 222246], [32, 222546], [40, 222986], [47, 223756], [49, 223879], [51, 223959], [55, 224099], [59, 224259], [66, 224919], [68, 225159], [74, 225439], [82, 225799], [93, 226933], [95, 227057], [97, 227137], [101, 227277], [105, 227417], [116, 228477], [118, 228597], [124, 228817], [132, 229177]]}, {"verse": 31, "start": 230427, "end": 235377, "text": "¿Pues qué diremos a esto? Si Dios por nosotros, ¿quién contra nosotros?", "words": [[0, 230427], [6, 230629], [10, 230809], [18, 231289], [20, 231409], [26, 232682], [29, 232837], [34, 233017], [38, 233277], [48, 234157], [55, 234317], [62, 234557]]}, {"verse": 32, "start": 235727, "end": 242690, "text": "El que no escatimó ni a su propio Hijo, antes le entregó por todos nosotros, ¿cómo no nos dará también con él todas las cosas?", "words": [[0, 235727], [3, 235831], [7, 235951], [10, 236224], [19, 236498], [22, 236771], [24, 236891], [27, 237011], [34, 237231], [40, 237911], [46, 238211], [49, 238411], [57, 238811], [61, 238951], [67, 239151], [77, 240191], [83, 240371], [86, 240551], [90, 240731], [95, 240991], [103, 241251], [107, 241491], [110, 241611], [116, 241791], [120, 242071]]}, {"verse": 33, "start": 243040, "end": 247113, "text": "¿Quién acusará a los escogidos de Dios? Dios es el que justifica.", "words": [[0, 243263], [7, 243503], [15, 243743], [17, 243843], [21, 243943], [31, 244543], [34, 244703], [40, 245467], [45, 245725], [48, 246045], [51, 246165], [55, 246305]]}, {"verse": 34, "start": 247463, "end": 256835, "text": "¿Quién es el que condenará? Cristo es el que murió; más aún, el que también resucitó, quien además está a la diestra de Dios, el que también intercede por nosotros.", "words": [[0, 247463], [7, 247684], [10, 247784], [13, 247904], [17, 248004], [28, 248978], [35, 249260], [38, 249420], [41, 249540], [45, 249660], [52, 250356], [56, 250535], [61, 250875], [64, 251035], [68, 251175], [76, 251515], [86, 252575], [92, 252655], [99, 253035], [104, 253375], [106, 253495], [109, 253555], [117, 253935], [120, 254115], [126, 254755], [129, 254875], [133, 254995], [141, 255295], [151, 255895], [155, 256155]]}, {"verse": 35, "start": 257185, "end": 266610, "text": "¿Quién nos apartará del amor de Cristo? tribulación? o angustia? o persecución? o hambre? o desnudez? o peligro? o espada?", "words": [[0, 257185], [7, 257382], [11, 257502], [20, 258042], [24, 258202], [29, 258422], [32, 258602], [40, 259381], [53, 260549], [55, 260714], [65, 261684], [67, 261825], [80, 262895], [82, 263075], [90, 263789], [92, 264209], [102, 264886], [104, 264984], [113, 265854], [115, 265972]]}, {"verse": 36, "start": 266960, "end": 273419, "text": "Como está escrito: Por causa de ti somos muertos todo el tiempo: somos estimados como ovejas de matadero.", "words": [[0, 266960], [5, 267124], [10, 267344], [19, 268214], [23, 268335], [29, 268595], [32, 268835], [35, 268995], [41, 269275], [49, 269755], [54, 269995], [57, 270195], [65, 271025], [71, 271226], [81, 271946], [86, 272226], [93, 272586], [96, 272726]]}, {"verse": 37, "start": 273769, "end": 278764, "text": "Antes, en todas estas cosas hacemos más que vencer por medio de aquel que nos amó.", "words": [[0, 273769], [7, 274073], [10, 274293], [16, 274473], [22, 274833], [28, 275313], [36, 275913], [40, 276313], [44, 276513], [51, 277013], [55, 277273], [61, 277533], [64, 277753], [70, 278053], [74, 278153], [78, 278313]]}, {"verse": 38, "start": 279114, "end": 287229, "text": "Por lo cual estoy cierto que ni la muerte, ni la vida, ni ángeles, ni principados, ni potestades, ni lo presente, ni lo por venir,", "words": [[0, 279114], [4, 279219], [7, 279339], [12, 279599], [18, 279859], [25, 280239], [29, 280459], [32, 280599], [35, 280719], [43, 281319], [46, 281419], [49, 281559], [55, 282039], [58, 282179], [67, 282859], [70, 282939], [83, 284059], [86, 284139], [98, 285139], [101, 285319], [104, 285419], [114, 286359], [117, 286439], [120, 286712], [124, 286986]]}, {"verse": 39, "start": 287579, "end": 296010, "text": "Ni lo alto, ni lo bajo, ni ninguna criatura nos podrá apartar del amor de Dios, que es en Cristo Jesús Señor nuestro.", "words": [[0, 287579], [3, 287720], [6, 287860], [12, 288140], [15, 288380], [18, 288500], [24, 288820], [27, 289240], [35, 289620], [44, 290220], [48, 290380], [54, 290860], [62, 291380], [66, 291540], [71, 291800], [74, 292000], [80, 292720], [84, 292980], [87, 293220], [90, 293360], [97, 293680], [103, 294420], [109, 294660]]}]}