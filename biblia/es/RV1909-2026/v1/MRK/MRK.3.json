{"book": "MRK", "chapter": 3, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 250087, "verses": [{"verse": 1, "start": 300, "end": 6078, "text": "Y otra vez entró en la sinagoga; y había allí un hombre que tenía una mano atrofiada.", "words": [[0, 300], [2, 463], [7, 623], [11, 943], [17, 1403], [20, 1523], [23, 1623], [33, 2732], [35, 2858], [41, 3158], [46, 3458], [49, 3678], [56, 4018], [60, 4218], [66, 4538], [70, 4798], [75, 5058]]}, {"verse": 2, "start": 6428, "end": 12153, "text": "Y lo observaban atentamente para ver si lo sanaría en sábado, para acusarle.", "words": [[0, 6428], [2, 6668], [5, 6808], [16, 7728], [28, 8748], [33, 9008], [37, 9208], [40, 9408], [43, 9635], [51, 9861], [54, 10088], [62, 10808], [67, 11496]]}, {"verse": 3, "start": 12503, "end": 17542, "text": "Entonces dijo al hombre que tenía la mano atrofiada: Levántate en medio.", "words": [[0, 12503], [9, 13148], [14, 13753], [17, 13973], [24, 14233], [28, 14453], [34, 14733], [37, 14933], [42, 15153], [53, 16230], [63, 16815], [66, 16995]]}, {"verse": 4, "start": 17892, "end": 26163, "text": "Y les dice: ¿Es lícito hacer bien en sábado, o hacer mal? ¿salvar la vida, o quitarla? Pero ellos callaban.", "words": [[0, 17892], [2, 18019], [6, 18139], [12, 18955], [16, 19240], [23, 19920], [29, 20180], [34, 20440], [37, 20640], [45, 21260], [47, 21600], [53, 21840], [58, 22633], [66, 22996], [69, 23276], [75, 23596], [77, 24036], [87, 24988], [92, 25132], [98, 25669]]}, {"verse": 5, "start": 26513, "end": 39238, "text": "Y mirándolos alrededor con enojo, entristecido por la dureza de sus corazones, dice al hombre: Extiende tu mano. Y la extendió, y su mano fue restaurada sana.", "words": [[0, 26513], [2, 26654], [13, 27454], [23, 27874], [27, 28334], [34, 29254], [47, 30254], [51, 30534], [54, 30734], [61, 31234], [64, 31374], [68, 31554], [79, 32634], [84, 32994], [87, 33234], [95, 33977], [104, 34607], [107, 34807], [113, 35540], [115, 35747], [118, 35987], [128, 36887], [130, 37127], [133, 37307], [138, 37627], [142, 37887], [153, 38627]]}, {"verse": 6, "start": 39588, "end": 46212, "text": "Entonces saliendo los fariseos, tomaron consejo con los Herodianos contra él, para matarle.", "words": [[0, 39588], [9, 40486], [18, 40999], [22, 41179], [32, 42159], [40, 42599], [48, 43379], [52, 43599], [56, 43799], [67, 44599], [74, 44919], [78, 45219], [83, 45459]]}, {"verse": 7, "start": 46562, "end": 53518, "text": "Pero Jesús se apartó al mar con sus discípulos: y le siguió gran multitud de Galilea, y de Judea,", "words": [[0, 46562], [5, 46706], [11, 47086], [14, 47706], [21, 48166], [24, 48306], [28, 48526], [32, 48746], [36, 48886], [48, 49986], [50, 50107], [53, 50227], [60, 50667], [65, 50847], [74, 51507], [77, 51667], [86, 52447], [88, 52727], [91, 52847]]}, {"verse": 8, "start": 53868, "end": 66672, "text": "Y de Jerusalén, y de Idumea, y del otro lado del Jordán. Y los de alrededor de Tiro y de Sidón, grande multitud, oyendo cuán grandes cosas hacía, vinieron a él.", "words": [[0, 53868], [2, 53989], [5, 54089], [16, 54849], [18, 55049], [21, 55169], [29, 55989], [31, 56409], [35, 56589], [40, 56829], [45, 57189], [49, 57757], [57, 58478], [59, 58585], [63, 58765], [66, 58945], [76, 59365], [79, 59785], [84, 60205], [86, 60345], [89, 60505], [96, 61345], [103, 61885], [113, 63005], [120, 63385], [125, 63825], [133, 64265], [139, 64665], [146, 65585], [155, 66105], [157, 66285]]}, {"verse": 9, "start": 67022, "end": 75599, "text": "Y dijo a sus discípulos que le estuviese siempre lista una barca pequeña, por causa del gentío, para que no lo aplastaran.", "words": [[0, 67022], [2, 67147], [7, 67467], [9, 67607], [13, 67807], [24, 68607], [28, 68887], [31, 69167], [41, 69447], [49, 69807], [55, 70247], [59, 70487], [65, 70867], [74, 71347], [78, 71867], [84, 72247], [88, 72527], [96, 73167], [101, 73987], [105, 74167], [108, 74427], [111, 74587]]}, {"verse": 10, "start": 75949, "end": 82830, "text": "Porque había sanado a muchos; de manera que se lanzaban sobre él cuantos tenían dolencias, por tocarle.", "words": [[0, 75949], [7, 76112], [13, 76392], [20, 76932], [22, 77032], [30, 77990], [33, 78098], [40, 78318], [44, 78598], [47, 78758], [56, 79378], [62, 79678], [65, 79938], [73, 80198], [80, 80818], [91, 81578], [95, 81933]]}, {"verse": 11, "start": 83179, "end": 91965, "text": "Y los espíritus inmundos, al verle, se postraban delante de él, y daban voces, diciendo: Tú eres el Hijo de Dios.", "words": [[0, 83179], [2, 83283], [6, 83423], [16, 84143], [26, 84824], [29, 85203], [36, 85964], [39, 86044], [49, 86803], [57, 87303], [60, 87503], [64, 87723], [66, 87884], [72, 88203], [79, 88923], [89, 90282], [92, 90399], [97, 90639], [100, 90839], [105, 91039], [108, 91179]]}, {"verse": 12, "start": 92245, "end": 96001, "text": "Pero él les ordenaba firmemente que no le manifestasen.", "words": [[0, 92245], [5, 92391], [8, 92671], [12, 93031], [21, 93791], [32, 94551], [36, 94811], [39, 94951], [42, 95071]]}, {"verse": 13, "start": 96351, "end": 101005, "text": "Y subió al monte, y llamó a sí a los que él quiso; y vinieron a él.", "words": [[0, 96351], [2, 96460], [8, 96860], [11, 97000], [18, 97400], [20, 97910], [26, 98420], [28, 98510], [31, 98600], [33, 98690], [37, 98780], [41, 98920], [44, 99060], [51, 99831], [53, 99957], [62, 100417], [64, 100637]]}, {"verse": 14, "start": 101355, "end": 106951, "text": "Y estableció doce, para que estuviesen con él, y para enviarlos a predicar,", "words": [[0, 101355], [2, 101480], [13, 102080], [19, 102760], [24, 103260], [28, 103420], [39, 103960], [43, 104220], [47, 104500], [49, 105180], [54, 105360], [64, 105900], [66, 106140]]}, {"verse": 15, "start": 107301, "end": 112300, "text": "Y que tuviesen autoridad de sanar enfermedades, y de echar fuera demonios:", "words": [[0, 107301], [2, 107403], [6, 107523], [15, 108043], [25, 108743], [28, 108963], [34, 109383], [48, 110303], [50, 110663], [53, 110783], [59, 111103], [65, 111343]]}, {"verse": 16, "start": 112650, "end": 115446, "text": "A Simón, al cual puso por nombre Pedro;", "words": [[0, 112650], [2, 112759], [9, 113479], [12, 113599], [17, 113799], [22, 114199], [26, 114419], [33, 114699]]}, {"verse": 17, "start": 115796, "end": 125270, "text": "Y a Jacobo, hijo de Zebedeo, y a Juan hermano de Jacobo; y les dio el sobrenombre Boanerges, que es, Hijos del trueno;", "words": [[0, 115796], [2, 115937], [4, 116057], [12, 116937], [17, 117117], [20, 117588], [29, 118060], [31, 118322], [33, 118402], [38, 118602], [46, 119162], [49, 119242], [57, 120159], [59, 120261], [63, 120421], [67, 120661], [70, 120821], [82, 121941], [93, 123061], [97, 123181], [101, 123501], [107, 124181], [111, 124621]]}, {"verse": 18, "start": 125620, "end": 134731, "text": "Y a Andrés, y a Felipe, y a Bartolomé, y a Mateo, y a Tomás, y a Jacobo hijo de Alfeo, y a Tadeo, y a Simón el cananista,", "words": [[0, 125620], [2, 125784], [4, 125884], [12, 126384], [14, 126604], [16, 126644], [24, 127624], [26, 127684], [28, 127764], [39, 128804], [41, 128824], [43, 128884], [50, 129364], [52, 129544], [54, 129584], [61, 130344], [63, 130404], [65, 130464], [72, 131124], [77, 131284], [80, 131504], [87, 132024], [89, 132144], [91, 132264], [98, 133004], [100, 133064], [102, 133164], [108, 133724], [111, 133804]]}, {"verse": 19, "start": 135081, "end": 139768, "text": "Y a Judas Iscariote, el que le entregó. Y vinieron a casa.", "words": [[0, 135081], [2, 135216], [4, 135336], [10, 135556], [21, 136696], [24, 137116], [28, 137336], [31, 137496], [40, 138456], [42, 138586], [51, 139006], [53, 139166]]}, {"verse": 20, "start": 140118, "end": 145172, "text": "Y se agolpó de nuevo la gente, de modo que ellos ni siquiera podían comer.", "words": [[0, 140118], [2, 140247], [5, 140387], [12, 140967], [15, 141027], [21, 141247], [24, 141487], [31, 142347], [34, 142547], [39, 142727], [43, 143047], [49, 143327], [52, 143682], [61, 144122], [68, 144582]]}, {"verse": 21, "start": 145522, "end": 152334, "text": "Y como lo oyeron los suyos, vinieron para sujetarlo: porque decían: Está fuera de sí.", "words": [[0, 145522], [2, 145624], [7, 145864], [10, 146044], [17, 146504], [21, 146644], [28, 147704], [37, 148344], [42, 148604], [53, 150036], [60, 150186], [68, 151251], [73, 151475], [79, 151735], [82, 151955]]}, {"verse": 22, "start": 152614, "end": 161933, "text": "Y los escribas que habían venido de Jerusalén, decían que tenía a Beelzebú, y que por el príncipe de los demonios echaba fuera los demonios.", "words": [[0, 152614], [2, 152701], [6, 152841], [15, 153381], [19, 153521], [26, 153781], [33, 154241], [36, 154381], [47, 155061], [54, 155881], [58, 156061], [64, 156521], [66, 156981], [76, 157441], [78, 158041], [82, 158161], [86, 158381], [89, 158501], [98, 159181], [101, 159361], [105, 159501], [114, 160101], [121, 160561], [127, 160841], [131, 161121]]}, {"verse": 23, "start": 162283, "end": 168766, "text": "Y habiéndolos llamado, les decía en parábolas: ¿Cómo puede Satanás echar fuera a Satanás?", "words": [[0, 162283], [2, 162408], [14, 163088], [23, 163668], [27, 164248], [33, 164668], [36, 164888], [47, 166012], [53, 166245], [59, 166515], [67, 167075], [73, 167375], [79, 167815], [81, 167935]]}, {"verse": 24, "start": 169116, "end": 174753, "text": "Y si algún reino contra sí mismo está dividido, no puede permanecer el tal reino.", "words": [[0, 169116], [2, 169391], [5, 169551], [11, 169871], [17, 170391], [24, 170751], [27, 170991], [33, 171371], [38, 171591], [48, 172251], [51, 172631], [57, 172951], [68, 173751], [71, 173911], [75, 174091]]}, {"verse": 25, "start": 175103, "end": 180075, "text": "Y si una casa está dividida contra sí misma, no puede permanecer la tal casa.", "words": [[0, 175103], [2, 175183], [5, 175283], [9, 175483], [14, 175743], [19, 176003], [28, 176623], [35, 176903], [38, 177163], [45, 177963], [48, 178043], [54, 178283], [65, 179063], [68, 179243], [72, 179403]]}, {"verse": 26, "start": 180425, "end": 187778, "text": "Y si Satanás se levanta contra sí mismo, y se divide, no puede permanecer; antes tiene fin.", "words": [[0, 180425], [2, 180553], [5, 180713], [13, 181393], [16, 181493], [24, 181993], [31, 182333], [34, 182593], [41, 183093], [43, 183773], [46, 183933], [54, 184793], [57, 185153], [63, 185433], [75, 186563], [81, 186907], [87, 187247]]}, {"verse": 27, "start": 188128, "end": 196504, "text": "Nadie puede saquear los bienes del hombre fuerte entrando en su casa, si antes no ata al hombre fuerte y entonces saqueará su casa.", "words": [[0, 188128], [6, 188594], [12, 188914], [20, 189694], [24, 189874], [31, 190314], [35, 190454], [42, 190674], [49, 191054], [58, 191754], [61, 191954], [64, 192094], [70, 192814], [73, 192934], [79, 193174], [82, 193494], [86, 193854], [89, 193974], [96, 194174], [103, 194574], [105, 194774], [114, 195274], [123, 195774], [126, 195974]]}, {"verse": 28, "start": 196854, "end": 205644, "text": "De cierto os digo que todos los pecados serán perdonados a los hijos de los hombres, y las blasfemias, cualesquiera que sean;", "words": [[0, 197070], [3, 197324], [10, 197577], [13, 198057], [18, 198417], [22, 198637], [28, 198937], [32, 199197], [40, 199797], [46, 200257], [57, 201077], [59, 201317], [63, 201477], [69, 201777], [72, 201977], [76, 202097], [85, 202457], [87, 202977], [91, 203137], [103, 203977], [116, 204817], [120, 205017]]}, {"verse": 29, "start": 205994, "end": 214308, "text": "Pero cualquiera que blasfeme contra el Espíritu Santo, no tiene jamás perdón, sino que es reo de juicio eterno.", "words": [[0, 205994], [5, 206158], [16, 206758], [20, 206978], [29, 207758], [36, 208178], [39, 208378], [48, 208978], [55, 209418], [58, 209796], [64, 210175], [70, 210553], [78, 211313], [83, 211753], [87, 211933], [90, 212073], [94, 212653], [97, 212753], [104, 213353]]}, {"verse": 30, "start": 214658, "end": 217284, "text": "Porque decían: Tiene espíritu inmundo.", "words": [[0, 214658], [7, 214884], [15, 215887], [21, 216107], [30, 216727]]}, {"verse": 31, "start": 217564, "end": 223940, "text": "Vienen después sus hermanos y su madre, y estando fuera, enviaron a él llamándole.", "words": [[0, 217564], [7, 217868], [15, 218208], [19, 218508], [28, 219148], [30, 219268], [33, 219388], [40, 220568], [42, 220608], [50, 221048], [57, 221968], [66, 222688], [68, 222868], [71, 223008]]}, {"verse": 32, "start": 224290, "end": 230848, "text": "Y la gente estaba sentada alrededor de él, y le dijeron: He aquí, tu madre y tus hermanos te buscan fuera.", "words": [[0, 224290], [2, 224394], [5, 224474], [11, 224754], [18, 225114], [26, 225794], [36, 226174], [39, 226834], [43, 227094], [45, 227274], [48, 227394], [57, 228174], [60, 228339], [66, 228579], [69, 228759], [75, 229059], [77, 229219], [81, 229339], [90, 229819], [93, 229919], [100, 230299]]}, {"verse": 33, "start": 231128, "end": 235983, "text": "Y él les respondió, diciendo: ¿Quién es mi madre y mis hermanos?", "words": [[0, 231128], [2, 231316], [5, 231466], [9, 231616], [20, 232396], [30, 233715], [37, 233939], [40, 234059], [43, 234199], [49, 234599], [51, 234879], [55, 235079]]}, {"verse": 34, "start": 236333, "end": 242748, "text": "Y mirando a los que estaban sentados alrededor de él, dijo: He aquí mi madre y hermanos.", "words": [[0, 236333], [2, 236595], [10, 237055], [12, 237175], [16, 237295], [20, 237415], [28, 237775], [37, 238455], [47, 238875], [50, 239375], [54, 239515], [60, 240386], [63, 240476], [68, 240716], [71, 240936], [77, 241316], [79, 241856]]}, {"verse": 35, "start": 243098, "end": 249687, "text": "Porque cualquiera que hace la voluntad de Dios, este es mi hermano, y mi hermana, y mi madre.", "words": [[0, 243098], [7, 243360], [18, 244040], [22, 244240], [27, 244540], [30, 244760], [39, 245320], [42, 245460], [48, 246140], [53, 246600], [56, 246740], [59, 246860], [68, 247660], [70, 247840], [73, 247980], [82, 248500], [84, 248960], [87, 249080]]}]}