{"book": "GEN", "chapter": 44, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 243775, "verses": [{"verse": 1, "start": 300, "end": 8658, "text": "And he commanded the steward of his house, saying, Fill the men’s sacks with food, as much as they can carry, and put every man’s money in his sack’s mouth.", "words": [[0, 300], [4, 428], [7, 548], [17, 1068], [21, 1328], [29, 1768], [32, 1908], [36, 2048], [43, 2648], [51, 3508], [56, 3598], [60, 3778], [66, 3958], [72, 4358], [77, 4538], [83, 4858], [86, 5118], [91, 5358], [94, 5478], [99, 5578], [103, 5738], [110, 6098], [114, 6538], [118, 6718], [124, 6998], [130, 7358], [136, 7598], [139, 7838], [143, 7958], [150, 8358]]}, {"verse": 2, "start": 9008, "end": 17064, "text": "And put my cup, the silver cup, in the sack’s mouth of the youngest, and his grain money. And he did according to the word that Joseph had spoken.", "words": [[0, 9008], [4, 9126], [8, 9326], [11, 9526], [16, 10086], [20, 10166], [27, 10466], [32, 11126], [35, 11286], [39, 11476], [46, 11666], [52, 11986], [55, 12186], [59, 12306], [69, 12646], [73, 13186], [77, 13326], [83, 13546], [90, 14262], [94, 14390], [97, 14530], [101, 14730], [111, 15070], [114, 15349], [118, 15470], [123, 15710], [128, 15890], [135, 16209], [139, 16470]]}, {"verse": 3, "start": 17414, "end": 22071, "text": "As soon as the morning was light, the men were sent away, they and their donkeys.", "words": [[0, 17414], [3, 17596], [8, 17816], [11, 17936], [15, 18036], [23, 18256], [27, 18516], [34, 19216], [38, 19296], [42, 19536], [47, 19696], [52, 19956], [58, 20796], [63, 20996], [67, 21196], [73, 21356]]}, {"verse": 4, "start": 22421, "end": 33744, "text": "And when they were gone out of the city, and not yet far off, Joseph said to his steward, Up, follow after the men; and when you do overtake them, say to them, Why have you rewarded evil for good?", "words": [[0, 22421], [4, 22566], [9, 22686], [14, 22846], [19, 22986], [24, 23226], [28, 23426], [31, 23546], [35, 23666], [41, 24266], [45, 24486], [49, 24706], [53, 24886], [57, 25226], [62, 25946], [69, 26186], [74, 26566], [77, 26746], [81, 26906], [90, 27618], [94, 27758], [101, 28078], [107, 28418], [111, 28618], [116, 29175], [120, 29314], [125, 29474], [129, 29634], [132, 29814], [141, 30334], [147, 30814], [151, 31014], [154, 31174], [160, 31654], [164, 31914], [169, 32134], [173, 32254], [182, 32694], [187, 33034], [191, 33314]]}, {"verse": 5, "start": 34094, "end": 40647, "text": "Is not this it in which my lord drinks, and by which indeed he practices divination? you have done evil in so doing.", "words": [[0, 34094], [3, 34240], [7, 34460], [12, 34720], [15, 34960], [18, 35180], [24, 35340], [27, 35500], [32, 35740], [40, 36380], [44, 36580], [47, 36740], [53, 36980], [60, 37280], [63, 37480], [73, 37900], [85, 39002], [89, 39120], [94, 39280], [99, 39480], [104, 39780], [107, 39980], [110, 40200]]}, {"verse": 6, "start": 40927, "end": 44613, "text": "¶ And he overtook them, and he spoke to them these same words.", "words": [[2, 40927], [6, 41072], [9, 41212], [18, 41792], [24, 42432], [28, 42612], [31, 42712], [37, 42972], [40, 43212], [45, 43412], [51, 43612], [56, 44012]]}, {"verse": 7, "start": 44963, "end": 51583, "text": "And they said to him, Why says my lord these words? God forbid that your servants should do according to this thing:", "words": [[0, 44963], [4, 45127], [9, 45247], [14, 45487], [17, 45687], [22, 46227], [26, 46547], [31, 46867], [34, 47107], [39, 47347], [45, 47627], [52, 48377], [56, 48560], [63, 48940], [68, 49260], [73, 49520], [82, 49780], [89, 50040], [92, 50280], [102, 50620], [105, 50900], [110, 51100]]}, {"verse": 8, "start": 51933, "end": 61907, "text": "Behold, the money, which we found in our sacks’ mouths, we brought again to you out of the land of Canaan: how then should we steal out of your lord’s house silver or gold?", "words": [[0, 51933], [8, 52340], [12, 52520], [19, 53120], [25, 53340], [28, 53500], [34, 53800], [37, 53960], [41, 54100], [48, 54420], [56, 55260], [59, 55400], [67, 55680], [73, 56020], [76, 56300], [80, 56520], [84, 56780], [87, 56920], [91, 57020], [96, 57300], [99, 57440], [107, 58383], [111, 58542], [116, 58802], [123, 59042], [126, 59222], [132, 59502], [136, 59762], [139, 59902], [144, 60022], [151, 60462], [157, 60562], [164, 61002], [167, 61302]]}, {"verse": 9, "start": 62257, "end": 68443, "text": "With whomsoever of your servants it be found, both let him die, and we also will be my lord’s bondmen.", "words": [[0, 62257], [5, 62615], [16, 63005], [19, 63305], [24, 63425], [33, 63825], [36, 64045], [39, 64205], [46, 65005], [51, 65185], [55, 65445], [59, 65625], [64, 66345], [68, 66485], [71, 66645], [76, 66905], [81, 67105], [84, 67265], [87, 67465], [94, 67971]]}, {"verse": 10, "start": 68793, "end": 76038, "text": "And he said, Now also let it be according to your words: he with whom it is found shall be my servant; and you shall be blameless.", "words": [[0, 68793], [4, 68935], [7, 69055], [13, 69723], [17, 69843], [22, 70103], [26, 70303], [29, 70403], [32, 70563], [42, 70883], [45, 71143], [50, 71263], [57, 71972], [60, 72441], [65, 72541], [70, 72781], [73, 72901], [76, 73041], [82, 73481], [88, 73601], [91, 73761], [94, 73901], [103, 74759], [107, 74901], [111, 75041], [117, 75221], [120, 75361]]}, {"verse": 11, "start": 76318, "end": 81806, "text": "Then they speedily took down every man his sack to the ground, and opened every man his sack.", "words": [[0, 76318], [5, 76451], [10, 76591], [19, 77071], [24, 77291], [29, 77551], [35, 77891], [39, 78211], [43, 78451], [48, 78731], [51, 78931], [55, 79031], [63, 79691], [67, 79991], [74, 80291], [80, 80731], [84, 81031], [88, 81291]]}, {"verse": 12, "start": 82156, "end": 88115, "text": "And he searched, and began at the eldest, and left at the youngest: and the cup was found in Benjamin’s sack.", "words": [[0, 82156], [4, 82281], [7, 82361], [17, 82741], [21, 83021], [27, 83341], [30, 83521], [34, 83621], [42, 83921], [46, 84421], [51, 84681], [54, 84821], [58, 84941], [68, 85755], [72, 85885], [76, 86005], [80, 86265], [84, 86525], [90, 86845], [93, 87025], [104, 87645]]}, {"verse": 13, "start": 88465, "end": 93347, "text": "Then they tore their clothes, and loaded every man his donkey, and returned to the city.", "words": [[0, 88465], [5, 88629], [10, 88769], [15, 89009], [21, 89209], [30, 89589], [34, 90229], [41, 90549], [47, 90829], [51, 91129], [55, 91369], [63, 91729], [67, 92209], [76, 92569], [79, 92749], [83, 92869]]}, {"verse": 14, "start": 93697, "end": 100440, "text": "¶ And Judah and his brethren came to Joseph’s house; for he was yet there: and they fell before him on the ground.", "words": [[2, 93697], [6, 93863], [12, 94143], [16, 94443], [20, 94583], [29, 94963], [34, 95343], [37, 95523], [46, 96043], [53, 96787], [57, 96915], [60, 97115], [64, 97315], [68, 97535], [75, 98387], [79, 98513], [84, 98653], [89, 98913], [96, 99233], [100, 99553], [103, 99713], [107, 99853]]}, {"verse": 15, "start": 100790, "end": 107334, "text": "And Joseph said to them, What deed is this that you have done? do you not know that such a man as I can certainly divine?", "words": [[0, 100790], [4, 100937], [11, 101257], [16, 101617], [19, 101837], [25, 102424], [30, 102619], [35, 102819], [38, 102979], [43, 103179], [48, 103379], [52, 103539], [57, 103679], [63, 104274], [66, 104415], [70, 104535], [74, 104695], [79, 104915], [84, 105075], [89, 105295], [91, 105435], [95, 105635], [98, 105775], [100, 105895], [104, 106115], [114, 106495]]}, {"verse": 16, "start": 107614, "end": 120236, "text": "And Judah said, What shall we say to my lord? what shall we speak? or how shall we clear ourselves? God has found out the iniquity of your servants: behold, we are my lord’s servants, both we, and he also with whom the cup is found.", "words": [[0, 107614], [4, 107772], [10, 107932], [16, 108619], [21, 108740], [27, 108920], [30, 109060], [34, 109240], [37, 109380], [40, 109520], [46, 110173], [51, 110297], [57, 110457], [60, 110597], [67, 111257], [70, 111396], [74, 111596], [80, 111796], [83, 111956], [89, 112256], [100, 113108], [104, 113348], [108, 113548], [114, 113808], [118, 113988], [122, 114148], [131, 114648], [134, 114768], [139, 114888], [149, 115757], [157, 116335], [160, 116415], [164, 116555], [167, 116755], [174, 116955], [184, 117395], [189, 117735], [193, 117995], [197, 118275], [200, 118515], [205, 118895], [210, 119135], [215, 119295], [219, 119455], [223, 119635], [226, 119815]]}, {"verse": 17, "start": 120516, "end": 129677, "text": "And he said, God forbid that I should do so: but the man in whose hand the cup is found, he shall be my servant; and as for you, get you up in peace to your father.", "words": [[0, 120516], [4, 120650], [7, 120790], [13, 122199], [17, 122358], [24, 122738], [29, 122958], [31, 123058], [38, 123198], [41, 123398], [45, 123987], [49, 124113], [53, 124273], [57, 124473], [60, 124593], [66, 124733], [71, 125033], [75, 125153], [79, 125333], [82, 125473], [89, 125853], [92, 125933], [98, 126093], [101, 126233], [104, 126373], [113, 127155], [117, 127260], [120, 127400], [124, 127540], [129, 128000], [133, 128140], [137, 128320], [140, 128440], [143, 128560], [149, 128840], [152, 129060], [157, 129180]]}, {"verse": 18, "start": 129957, "end": 139798, "text": "¶ Then Judah came near to him, and said, Oh my lord, let your servant, please, speak a word in my lord’s ears, and let not your anger burn against your servant: for you are even as Pharaoh.", "words": [[2, 129957], [7, 130242], [13, 130562], [18, 130922], [23, 131182], [26, 131402], [31, 131642], [35, 131842], [41, 132611], [44, 132711], [47, 132891], [53, 133311], [57, 133391], [62, 133571], [71, 133891], [79, 134271], [85, 134646], [87, 134826], [92, 135046], [95, 135166], [98, 135286], [105, 135626], [111, 135826], [115, 136306], [119, 136446], [123, 136646], [128, 136866], [134, 137146], [139, 137426], [147, 137646], [152, 137826], [161, 138543], [165, 138631], [169, 138771], [173, 138911], [178, 139151], [181, 139496]]}, {"verse": 19, "start": 140148, "end": 143509, "text": "My lord asked his servants, saying, Have you a father, or a brother?", "words": [[0, 140148], [3, 140287], [8, 140547], [14, 140814], [18, 141080], [28, 141347], [36, 141927], [41, 142087], [45, 142247], [47, 142367], [55, 142647], [58, 142947], [60, 143027]]}, {"verse": 20, "start": 143859, "end": 154453, "text": "And we said to my lord, We have a father, an old man, and a child of his old age, a little one; and his brother is dead, and he alone is left of his mother, and his father loves him.", "words": [[0, 143859], [4, 143984], [7, 144144], [12, 144364], [15, 144504], [18, 144624], [24, 145124], [27, 145284], [32, 145464], [34, 145564], [42, 146224], [45, 146304], [49, 146544], [54, 147124], [58, 147264], [60, 147344], [66, 147664], [69, 147864], [73, 147984], [77, 148224], [82, 148724], [84, 148804], [91, 149024], [96, 149519], [100, 149637], [104, 149797], [112, 150157], [115, 150457], [121, 150797], [125, 151277], [128, 151477], [134, 151757], [137, 152037], [142, 152277], [145, 152437], [149, 152577], [157, 152897], [161, 153297], [165, 153457], [172, 153797], [178, 154137]]}, {"verse": 21, "start": 154803, "end": 159526, "text": "And you said to your servants, Bring him down to me, that I may set my eyes upon him.", "words": [[0, 154803], [4, 154949], [8, 155069], [13, 155269], [16, 155429], [21, 155549], [31, 156349], [37, 156609], [41, 156809], [46, 157069], [49, 157269], [53, 157609], [58, 157789], [60, 157909], [64, 157989], [68, 158289], [71, 158509], [76, 158849], [81, 159129]]}, {"verse": 22, "start": 159876, "end": 165850, "text": "And we said to my lord, The lad cannot leave his father: for if he should leave his father, his father would die.", "words": [[0, 159876], [4, 160004], [7, 160104], [12, 160324], [15, 160484], [18, 160624], [24, 161104], [28, 161224], [32, 161444], [39, 161704], [45, 162084], [49, 162284], [57, 162977], [61, 163145], [64, 163285], [67, 163425], [74, 163625], [80, 163845], [84, 164005], [92, 164745], [96, 164825], [103, 165165], [109, 165385]]}, {"verse": 23, "start": 166200, "end": 171460, "text": "And you said to your servants, Unless your youngest brother come down with you, you shall see my face no more.", "words": [[0, 166200], [4, 166338], [8, 166458], [13, 166638], [16, 166798], [21, 166918], [31, 167618], [38, 167858], [43, 168098], [52, 168398], [60, 168738], [65, 168978], [70, 169218], [75, 169438], [80, 169858], [84, 169978], [90, 170158], [94, 170398], [97, 170558], [102, 170838], [105, 171058]]}, {"verse": 24, "start": 171810, "end": 176583, "text": "And it came to pass when we came up to your servant my father, we told him the words of my lord.", "words": [[0, 171810], [4, 171940], [7, 172060], [12, 172200], [15, 172360], [20, 172640], [25, 172840], [28, 172960], [33, 173140], [36, 173320], [39, 173460], [44, 173600], [52, 174080], [55, 174220], [63, 174920], [66, 175060], [71, 175300], [75, 175500], [79, 175640], [85, 175860], [88, 176000], [91, 176160]]}, {"verse": 25, "start": 176933, "end": 179507, "text": "And our father said, Go again, and buy us a little food.", "words": [[0, 176933], [4, 177037], [8, 177157], [15, 177397], [21, 177777], [24, 177877], [31, 178217], [35, 178437], [39, 178637], [42, 178797], [44, 178897], [51, 179057]]}, {"verse": 26, "start": 179857, "end": 188921, "text": "And we said, We cannot go down: if our youngest brother be with us, then will we go down: for we may not see the man’s face, except our youngest brother be with us.", "words": [[0, 179857], [4, 180017], [7, 180157], [13, 180357], [16, 180537], [23, 180777], [26, 181037], [32, 181663], [35, 181865], [39, 182025], [48, 182325], [56, 182645], [59, 182885], [64, 183125], [68, 183645], [73, 183785], [78, 184025], [81, 184185], [84, 184365], [90, 184970], [94, 185079], [97, 185239], [101, 185399], [105, 185599], [109, 185839], [113, 185979], [119, 186299], [125, 186799], [132, 187079], [136, 187359], [145, 187639], [153, 187999], [156, 188279], [161, 188499]]}, {"verse": 27, "start": 189271, "end": 193355, "text": "And your servant my father said to us, You know that my wife bore me two sons:", "words": [[0, 189271], [4, 189387], [9, 189507], [17, 189867], [20, 190067], [27, 190367], [32, 190667], [35, 190887], [39, 191287], [43, 191447], [48, 191647], [53, 191807], [56, 191947], [61, 192187], [66, 192447], [69, 192587], [73, 192767]]}, {"verse": 28, "start": 193705, "end": 198928, "text": "And the one went out from me, and I said, Surely he is torn in pieces; and I saw him not since:", "words": [[0, 193705], [4, 193812], [8, 193892], [12, 194032], [17, 194192], [21, 194352], [26, 194512], [30, 194692], [34, 194992], [36, 195112], [42, 195352], [49, 195912], [52, 196132], [55, 196272], [60, 196492], [63, 196652], [71, 197462], [75, 197568], [77, 197688], [81, 197928], [85, 198108], [89, 198308]]}, {"verse": 29, "start": 199278, "end": 204991, "text": "And if you take this also from me, and mischief befall him, you shall bring down my gray hairs with sorrow to the grave.", "words": [[0, 199278], [4, 199382], [7, 199482], [11, 199582], [16, 199722], [21, 199942], [26, 200182], [31, 200442], [35, 200702], [39, 201062], [48, 201402], [55, 201822], [60, 202242], [64, 202402], [70, 202542], [76, 202742], [81, 202982], [84, 203162], [89, 203402], [95, 203742], [100, 203942], [107, 204242], [110, 204462], [114, 204582]]}, {"verse": 30, "start": 205341, "end": 212243, "text": "Now therefore when I come to your servant my father, and the lad be not with us; seeing that his life is bound up in the lad’s life;", "words": [[0, 205341], [4, 205554], [14, 206114], [19, 206214], [21, 206354], [26, 206554], [29, 206714], [34, 206854], [42, 207334], [45, 207454], [53, 208274], [57, 208394], [61, 208514], [65, 208734], [68, 208894], [72, 209074], [77, 209254], [81, 209808], [88, 210068], [93, 210288], [97, 210408], [102, 210668], [105, 210808], [111, 211088], [114, 211308], [117, 211488], [121, 211608], [127, 211928]]}, {"verse": 31, "start": 212593, "end": 221734, "text": "It shall come to pass, when he sees that the lad is not with us, that he will die: and your servants shall bring down the gray hairs of your servant our father with sorrow to the grave.", "words": [[0, 212593], [3, 212750], [9, 212870], [14, 213050], [17, 213170], [23, 213810], [28, 214070], [31, 214190], [36, 214430], [41, 214670], [45, 214770], [49, 214950], [52, 215090], [56, 215250], [61, 215450], [65, 215930], [70, 216110], [73, 216250], [78, 216390], [83, 217008], [87, 217130], [92, 217380], [101, 217630], [107, 217970], [113, 218250], [118, 218490], [122, 218670], [127, 218910], [133, 219230], [136, 219410], [141, 219530], [149, 219910], [153, 220110], [160, 220430], [165, 220670], [172, 221010], [175, 221250], [179, 221370]]}, {"verse": 32, "start": 222084, "end": 229311, "text": "For your servant became surety for the lad to my father, saying, If I bring him not to you, then I shall bear the blame to my father for ever.", "words": [[0, 222084], [4, 222167], [9, 222287], [17, 222707], [24, 223027], [31, 223567], [35, 223727], [39, 223867], [43, 224067], [46, 224207], [49, 224327], [57, 224787], [65, 225427], [68, 225587], [70, 225707], [76, 225907], [80, 226087], [84, 226267], [87, 226467], [92, 227047], [97, 227127], [99, 227287], [105, 227447], [110, 227667], [114, 227807], [120, 228027], [123, 228187], [126, 228327], [133, 228670], [137, 229014]]}, {"verse": 33, "start": 229661, "end": 236655, "text": "Now therefore, please, let your servant abide instead of the lad a bondman to my lord; and let the lad go up with his brethren.", "words": [[0, 229661], [4, 229876], [15, 230276], [23, 230996], [27, 231216], [32, 231376], [40, 231736], [46, 232116], [54, 232476], [57, 232696], [61, 232926], [65, 233156], [67, 233386], [75, 233616], [78, 233796], [81, 233936], [87, 234591], [91, 234721], [95, 234901], [99, 235061], [103, 235261], [106, 235481], [109, 235721], [114, 235921], [118, 236081]]}, {"verse": 34, "start": 237005, "end": 243375, "text": "For how shall I go up to my father, and the lad be not with me? lest perhaps I see the evil that shall come on my father.", "words": [[0, 237005], [4, 237106], [8, 237346], [14, 237586], [16, 237726], [19, 237946], [22, 238106], [25, 238226], [28, 238366], [36, 239106], [40, 239226], [44, 239366], [48, 239526], [51, 239686], [55, 239886], [60, 240106], [64, 240709], [69, 240839], [77, 241119], [79, 241319], [83, 241519], [87, 241679], [92, 241979], [97, 242199], [103, 242399], [108, 242639], [111, 242759], [114, 242919]]}]}