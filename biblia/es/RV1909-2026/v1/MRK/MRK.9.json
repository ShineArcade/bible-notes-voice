{"book": "MRK", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 401511, "verses": [{"verse": 1, "start": 300, "end": 9636, "text": "También les dijo: De cierto os digo que hay algunos de los que están aquí, que no probarán la muerte hasta que hayan visto el reino de Dios que viene con poder.", "words": [[0, 300], [8, 620], [12, 820], [18, 1566], [21, 1714], [28, 1894], [31, 2074], [36, 2614], [40, 2854], [44, 3014], [52, 3454], [55, 3634], [59, 3734], [63, 3854], [69, 4094], [75, 4894], [79, 4974], [82, 5134], [91, 5674], [94, 5794], [101, 6214], [107, 6714], [111, 6914], [117, 7174], [123, 7434], [126, 7634], [132, 8014], [135, 8174], [140, 8414], [144, 8614], [150, 8874], [154, 9094]]}, {"verse": 2, "start": 9986, "end": 20768, "text": "Y seis días después tomó Jesús a Pedro, y a Jacobo, y a Juan, y los sacó aparte solos a un monte alto; y fue transfigurado delante de ellos.", "words": [[0, 9986], [2, 10108], [7, 10408], [12, 10868], [20, 11288], [25, 11808], [31, 12088], [33, 12328], [40, 12808], [42, 13093], [44, 13173], [52, 13873], [54, 14133], [56, 14193], [62, 14553], [64, 14873], [68, 15193], [73, 15553], [80, 15993], [86, 16553], [88, 16753], [91, 16893], [97, 17253], [103, 18171], [105, 18428], [109, 18588], [123, 19588], [131, 20108], [134, 20288]]}, {"verse": 3, "start": 21118, "end": 31193, "text": "Y sus vestidos se volvieron resplandecientes, muy blancos, como la nieve; tanto que ningún lavandero en la tierra los puede hacer tan blancos.", "words": [[0, 21118], [2, 21226], [6, 21386], [15, 21886], [18, 22046], [28, 22566], [46, 24066], [50, 24386], [59, 25326], [64, 25586], [67, 25766], [74, 26566], [80, 26771], [84, 27031], [91, 27431], [101, 28191], [104, 28291], [107, 28411], [114, 28771], [118, 29351], [124, 29651], [130, 29991], [134, 30331]]}, {"verse": 4, "start": 31543, "end": 35754, "text": "Y les apareció Elías con Moisés, que hablaban con Jesús.", "words": [[0, 31543], [2, 31653], [6, 31773], [15, 32473], [21, 33053], [25, 33313], [33, 34373], [37, 34433], [46, 34873], [50, 35053]]}, {"verse": 5, "start": 36104, "end": 47301, "text": "Entonces respondiendo Pedro, dice a Jesús: Maestro, bien será que nos quedemos aquí, y hagamos tres refugios: para ti uno, y para Moisés otro, y para Elías otro;", "words": [[0, 36104], [9, 37086], [22, 37789], [29, 38689], [34, 38989], [36, 39209], [43, 40017], [52, 40603], [57, 40723], [62, 41023], [66, 41243], [70, 41403], [79, 41863], [85, 42143], [87, 42368], [95, 42708], [100, 42988], [110, 44069], [115, 44212], [118, 44412], [123, 44672], [125, 45032], [130, 45212], [137, 45552], [143, 45892], [145, 46312], [150, 46472], [156, 46892]]}, {"verse": 6, "start": 47581, "end": 50874, "text": "Porque no sabía qué decir, pues estaban espantados.", "words": [[0, 47581], [7, 47788], [10, 47988], [16, 48428], [20, 48588], [27, 49348], [32, 49488], [40, 49848]]}, {"verse": 7, "start": 51224, "end": 59968, "text": "Y vino una nube que les hizo sombra, y una voz de la nube, que decía: Este es mi Hijo amado: a él oíd.", "words": [[0, 51224], [2, 51347], [7, 51647], [11, 51967], [16, 52367], [20, 52567], [24, 52807], [29, 53287], [37, 54187], [39, 54327], [43, 54507], [47, 54867], [50, 55147], [53, 55287], [59, 55727], [63, 55967], [70, 56931], [75, 57254], [78, 57514], [81, 57694], [86, 57914], [93, 59211], [95, 59463], [98, 59716]]}, {"verse": 8, "start": 60532, "end": 66335, "text": "Y luego, como miraron, no vieron más a nadie consigo, sino a Jesús solo.", "words": [[0, 60532], [2, 60649], [9, 61049], [14, 61269], [23, 62369], [26, 62669], [33, 63069], [37, 63329], [39, 63649], [45, 63969], [54, 64449], [59, 64929], [61, 65209], [67, 65489]]}, {"verse": 9, "start": 66685, "end": 76806, "text": "Y descendiendo ellos del monte, les mandó que a nadie dijesen lo que habían visto, sino cuando el Hijo del hombre hubiese resucitado de los muertos.", "words": [[0, 66685], [2, 66807], [15, 67547], [21, 67767], [25, 67947], [32, 68987], [36, 69107], [42, 69567], [46, 69727], [48, 69887], [54, 70497], [62, 71107], [65, 71267], [69, 71407], [76, 71727], [83, 72767], [88, 73007], [95, 73267], [98, 73507], [103, 73787], [107, 73947], [114, 74247], [122, 74687], [133, 75687], [136, 75807], [140, 75927]]}, {"verse": 10, "start": 77156, "end": 83553, "text": "Y retuvieron la palabra en sí, discutiendo qué sería aquéllo: Resucitar de los muertos.", "words": [[0, 77156], [2, 77280], [13, 77900], [16, 78040], [24, 78380], [27, 78620], [31, 79220], [43, 79800], [47, 80020], [53, 80460], [62, 81565], [72, 82391], [75, 82531], [79, 82651]]}, {"verse": 11, "start": 83903, "end": 90478, "text": "Y le preguntaron, diciendo: ¿Qué es lo que los escribas dicen, que es necesario que Elías venga antes?", "words": [[0, 83903], [2, 84029], [5, 84109], [18, 84829], [28, 85828], [33, 85828], [36, 85990], [39, 86110], [43, 86270], [47, 86410], [56, 87010], [63, 87870], [67, 88150], [70, 88270], [80, 88870], [84, 89150], [90, 89430], [96, 89850]]}, {"verse": 12, "start": 90758, "end": 103616, "text": "Y respondiendo él, les dijo: Elías a la verdad, viniendo antes, restaurará todas las cosas: y cómo está escrito del Hijo del hombre, que padezca mucho y sea tenido en nada.", "words": [[0, 90865], [2, 91005], [15, 91845], [19, 92265], [23, 92685], [29, 93539], [35, 94086], [37, 94286], [40, 94366], [48, 94666], [57, 95401], [64, 95720], [75, 96039], [81, 96358], [85, 96676], [92, 97983], [94, 98903], [99, 99203], [104, 99403], [112, 99743], [116, 100043], [121, 100283], [125, 100423], [133, 100883], [137, 101263], [145, 101743], [151, 102063], [153, 102353], [157, 102643], [164, 102783], [167, 102923]]}, {"verse": 13, "start": 103966, "end": 109759, "text": "Pero os digo que Elías ya vino, y le hicieron todo lo que quisieron, como está escrito de él.", "words": [[0, 103966], [5, 104130], [8, 104330], [13, 104590], [17, 104830], [23, 105510], [26, 105730], [32, 106030], [34, 106275], [37, 106415], [46, 106855], [51, 107135], [54, 107355], [58, 107515], [69, 108075], [74, 108575], [79, 108755], [87, 109055], [90, 109375]]}, {"verse": 14, "start": 110109, "end": 117798, "text": "Y cuando vino a los discípulos, vio grande compañía alrededor de ellos, y escribas que disputaban con ellos.", "words": [[0, 110109], [2, 110231], [9, 110411], [14, 110831], [16, 111011], [20, 111131], [32, 112151], [36, 112571], [43, 112871], [52, 113751], [62, 114231], [65, 114691], [72, 115011], [74, 115531], [83, 116151], [87, 116311], [98, 117031], [102, 117251]]}, {"verse": 15, "start": 118148, "end": 123935, "text": "Y luego toda la gente, viéndole, se espantó, y corriendo a él, le saludaron.", "words": [[0, 118148], [2, 118295], [8, 118555], [13, 119095], [16, 119315], [23, 119615], [33, 120615], [36, 121065], [45, 121515], [47, 121835], [57, 122395], [59, 122515], [63, 123055], [66, 123135]]}, {"verse": 16, "start": 124285, "end": 126995, "text": "Y les preguntó: ¿Qué disputáis con ellos?", "words": [[0, 124285], [2, 124430], [6, 124510], [16, 125480], [21, 125604], [31, 126224], [35, 126444]]}, {"verse": 17, "start": 127345, "end": 133569, "text": "Y respondiendo uno de la multitud, dijo: Maestro, traje a ti mi hijo, que tiene un espíritu mudo,", "words": [[0, 127345], [2, 127621], [15, 128501], [19, 128681], [22, 128841], [25, 128961], [35, 129481], [41, 130292], [50, 130748], [56, 131128], [58, 131228], [61, 131448], [64, 131508], [70, 132088], [74, 132168], [80, 132408], [83, 132568], [92, 133108]]}, {"verse": 18, "start": 133919, "end": 144949, "text": "El cual, donde quiera que le toma, lo convulsiona; y echa espuma por la boca, y rechina los dientes, y queda rígido: y dije a tus discípulos que le echasen fuera, y no pudieron.", "words": [[0, 133919], [3, 134038], [9, 134458], [15, 134638], [22, 135018], [26, 135158], [29, 135258], [35, 135978], [38, 136058], [51, 137170], [53, 137291], [58, 137491], [65, 137951], [69, 138131], [72, 138251], [78, 138531], [80, 138791], [88, 139251], [92, 139391], [101, 139831], [103, 140271], [109, 140471], [117, 141300], [119, 141399], [124, 141679], [126, 141859], [130, 142019], [141, 142679], [145, 142899], [148, 143039], [156, 143479], [163, 143819], [165, 144219], [168, 144339]]}, {"verse": 19, "start": 145229, "end": 155575, "text": "Y respondiendo él, les dijo: ¡Oh generación infiel! ¿hasta cuándo estaré con vosotros? ¿hasta cuándo tendré que soportaros? Traédmele.", "words": [[0, 145337], [2, 145477], [15, 146317], [19, 146737], [23, 147157], [29, 148087], [33, 148197], [44, 148957], [52, 149944], [59, 150127], [66, 150427], [73, 150967], [77, 151147], [87, 152210], [94, 152490], [101, 152910], [108, 153250], [112, 153350], [124, 154482]]}, {"verse": 20, "start": 155925, "end": 165864, "text": "Y se le trajeron: y como le vio, luego el espíritu lo convulsionó; y cayendo en tierra, se revolcaba, echando espuma por la boca.", "words": [[0, 155925], [2, 156032], [5, 156152], [8, 156292], [18, 157306], [20, 157391], [25, 157571], [28, 157751], [33, 158451], [39, 158791], [42, 159191], [51, 159711], [54, 159811], [67, 160902], [69, 161046], [77, 161626], [80, 161786], [88, 162246], [91, 162896], [102, 163546], [110, 164366], [117, 164946], [121, 165146], [124, 165306]]}, {"verse": 21, "start": 166214, "end": 172478, "text": "Y Jesús preguntó a su padre: ¿Desde cuándo le sucede esto? Y él dijo: Desde niño:", "words": [[0, 166214], [2, 166340], [8, 166700], [17, 167700], [19, 167760], [22, 167860], [29, 168630], [36, 168879], [43, 169199], [46, 169539], [53, 169919], [59, 170739], [61, 170907], [64, 171027], [70, 171754], [76, 171958]]}, {"verse": 22, "start": 172478, "end": 180441, "text": "Y muchas veces le echa en el fuego y en aguas, para matarle; pero, si puedes algo, ayúdanos, teniendo misericordia de nosotros.", "words": [[0, 172498], [2, 172518], [9, 172758], [15, 173198], [18, 173478], [23, 173758], [26, 173878], [29, 173998], [35, 174318], [37, 174598], [40, 174718], [47, 175178], [52, 175618], [61, 176507], [67, 176631], [70, 176811], [77, 177071], [83, 177791], [93, 178451], [102, 179031], [115, 179771], [118, 179871]]}, {"verse": 23, "start": 180721, "end": 185363, "text": "Y Jesús le dijo: Si puedes creer, al que cree todo es posible.", "words": [[0, 180721], [2, 180851], [8, 181251], [11, 181611], [17, 182420], [20, 182563], [27, 182863], [34, 183243], [37, 183623], [41, 183903], [46, 184183], [51, 184383], [54, 184583]]}, {"verse": 24, "start": 185713, "end": 190298, "text": "Y luego el padre del muchacho dijo clamando: Creo, ayuda mi incredulidad.", "words": [[0, 185713], [2, 185822], [8, 186002], [11, 186242], [17, 186562], [21, 186782], [30, 187342], [35, 187802], [45, 188755], [51, 188932], [57, 189272], [60, 189532]]}, {"verse": 25, "start": 190578, "end": 202617, "text": "Y como Jesús vio que la multitud se agolpaba, reprendió al espíritu inmundo, diciéndole: Espíritu mudo y sordo, yo te mando, sal de él, y no entres más en él.", "words": [[0, 190578], [2, 190683], [7, 190923], [13, 191243], [17, 191723], [21, 191863], [24, 192003], [33, 192623], [36, 192823], [46, 193883], [56, 194623], [59, 194783], [68, 195343], [77, 196303], [89, 197512], [98, 198037], [103, 198457], [105, 198557], [112, 199317], [115, 199477], [118, 199617], [125, 199997], [129, 200237], [132, 200497], [136, 200797], [138, 201257], [141, 201437], [148, 201817], [152, 202117], [155, 202397]]}, {"verse": 26, "start": 202967, "end": 212218, "text": "Entonces el espíritu clamó, lo convulsionó violentamente y salió; y él quedó como muerto, de modo que muchos decían: Está muerto.", "words": [[0, 202967], [9, 203483], [12, 203763], [21, 204303], [28, 205403], [31, 205543], [43, 206403], [57, 207363], [59, 207543], [66, 208238], [68, 208358], [71, 208498], [77, 208818], [82, 208998], [90, 209718], [93, 209878], [98, 210018], [102, 210218], [109, 210418], [117, 211447], [122, 211669]]}, {"verse": 27, "start": 212498, "end": 217109, "text": "Pero Jesús tomándole de la mano, le enderezó; y se levantó.", "words": [[0, 212498], [5, 212660], [11, 213260], [21, 213800], [24, 213980], [27, 214120], [33, 214880], [36, 215000], [46, 216074], [48, 216222], [51, 216302]]}, {"verse": 28, "start": 217459, "end": 224496, "text": "Y como él entró en casa, sus discípulos le preguntaron aparte: ¿Por qué nosotros no pudimos echarle fuera?", "words": [[0, 217459], [2, 217546], [7, 217766], [10, 217986], [16, 218366], [19, 218486], [25, 219386], [29, 219546], [40, 220286], [43, 220466], [55, 221186], [63, 222122], [68, 222281], [72, 222401], [81, 222781], [84, 223101], [92, 223561], [100, 224041]]}, {"verse": 29, "start": 224776, "end": 229985, "text": "Y les dijo: Este género con nada puede salir, sino con oración y ayuno.", "words": [[0, 224776], [2, 224934], [6, 225014], [12, 225717], [17, 225920], [24, 226480], [28, 226640], [33, 226960], [39, 227240], [46, 227980], [51, 228180], [55, 228460], [63, 229080], [65, 229380]]}, {"verse": 30, "start": 230335, "end": 236174, "text": "Y habiendo salido de allí, caminaron por Galilea; y no quería que nadie lo supiese.", "words": [[0, 230335], [2, 230525], [11, 230845], [18, 231345], [21, 231525], [27, 232145], [37, 232785], [41, 233025], [50, 234090], [52, 234186], [55, 234306], [62, 234546], [66, 234846], [72, 235126], [75, 235366]]}, {"verse": 31, "start": 236524, "end": 248529, "text": "Porque enseñaba a sus discípulos, y les decía: El Hijo del hombre será entregado en manos de hombres, y le matarán; pero muerto él, resucitará al tercer día.", "words": [[0, 236524], [7, 236806], [16, 237846], [18, 238086], [22, 238306], [34, 239246], [36, 239446], [40, 239626], [47, 240563], [50, 240731], [55, 241071], [59, 241231], [66, 241611], [71, 241811], [81, 242511], [84, 242631], [90, 242871], [93, 243111], [102, 243451], [104, 243786], [107, 243906], [116, 244842], [121, 245252], [128, 245812], [132, 246452], [143, 247352], [146, 247512], [153, 247832]]}, {"verse": 32, "start": 248879, "end": 253075, "text": "Pero ellos no entendían esta palabra, y tenían miedo de preguntarle.", "words": [[0, 248879], [5, 249027], [11, 249287], [14, 249587], [24, 250167], [29, 250407], [38, 250807], [40, 251007], [47, 251307], [53, 251807], [56, 252027]]}, {"verse": 33, "start": 253075, "end": 260456, "text": "Y llegó a Capernaum; y así que estuvo en casa, les preguntó: ¿Qué disputabais entre vosotros en el camino?", "words": [[0, 253075], [2, 253415], [8, 253635], [10, 253895], [21, 255131], [23, 255236], [27, 255456], [31, 255676], [38, 255996], [41, 256136], [47, 256576], [51, 256656], [61, 257649], [66, 258209], [78, 258789], [84, 258989], [93, 259509], [96, 259729], [99, 259869]]}, {"verse": 34, "start": 260806, "end": 267270, "text": "Pero ellos callaron; porque los unos con los otros habían disputado en el camino quién había de ser el mayor.", "words": [[0, 260806], [5, 260951], [11, 261171], [21, 262237], [28, 262464], [32, 262684], [37, 262964], [41, 263224], [45, 263424], [51, 263744], [58, 264104], [68, 264924], [71, 265064], [74, 265184], [81, 265424], [87, 265804], [93, 266104], [96, 266304], [100, 266524], [103, 266664]]}, {"verse": 35, "start": 267620, "end": 277821, "text": "Entonces sentándose, llamó a los doce, y les dice: Si alguno quiere ser el primero, será el último de todos, y el servidor de todos.", "words": [[0, 267620], [9, 268666], [21, 269826], [27, 270306], [29, 270466], [33, 270646], [39, 271126], [41, 271626], [45, 271826], [51, 272641], [54, 272806], [61, 273286], [68, 273486], [72, 273826], [75, 273986], [84, 274406], [89, 274766], [92, 275026], [99, 275426], [102, 275666], [109, 276046], [111, 276441], [114, 276581], [123, 277141], [126, 277341]]}, {"verse": 36, "start": 278171, "end": 284122, "text": "Y tomando un niño, lo puso en medio de ellos; y tomándole en sus brazos, les dice:", "words": [[0, 278171], [2, 278269], [10, 278689], [13, 278889], [19, 279249], [22, 279789], [27, 280149], [30, 280289], [36, 280549], [39, 280829], [46, 281616], [48, 281724], [58, 282324], [61, 282464], [65, 282644], [73, 283144], [77, 283644]]}, {"verse": 37, "start": 284472, "end": 294234, "text": "El que reciba en mi nombre uno de los tales niños, a mí recibe; y quien me recibe a mí no me recibe a mí, sino al que me envió.", "words": [[0, 284472], [3, 284620], [7, 284760], [14, 285400], [17, 285520], [20, 285680], [27, 286060], [31, 286480], [34, 286640], [38, 286780], [44, 287020], [51, 287940], [53, 288360], [56, 288480], [64, 289501], [66, 289625], [72, 289845], [75, 290045], [82, 290545], [84, 290645], [87, 291205], [90, 291305], [93, 291445], [100, 291965], [102, 292045], [106, 292545], [111, 292785], [114, 293205], [118, 293385], [121, 293545]]}, {"verse": 38, "start": 294584, "end": 303567, "text": "Y le respondió Juan, diciendo: Maestro, hemos visto a uno que en tu nombre echaba fuera los demonios, el cual no nos sigue; y se lo prohibimos, porque no nos sigue.", "words": [[0, 294584], [2, 294705], [5, 294845], [15, 295545], [21, 295985], [31, 296407], [40, 296886], [46, 296966], [52, 297346], [54, 297526], [58, 297666], [62, 297886], [65, 297986], [68, 298106], [75, 298386], [82, 298806], [88, 299026], [92, 299286], [102, 300026], [105, 300126], [110, 300326], [113, 300526], [117, 300706], [124, 301391], [126, 301495], [129, 301575], [132, 301715], [144, 302375], [151, 302715], [154, 302935], [158, 303135]]}, {"verse": 39, "start": 303847, "end": 311883, "text": "Y Jesús dijo: No se lo prohibáis; porque ninguno hay que haga milagro en mi nombre que luego pueda decir mal de mí.", "words": [[0, 303847], [2, 303985], [8, 304345], [14, 305165], [17, 305334], [20, 305554], [23, 305734], [34, 307002], [41, 307206], [49, 307786], [53, 308026], [57, 308186], [62, 308426], [70, 309046], [73, 309146], [76, 309326], [83, 309666], [87, 309886], [93, 310126], [99, 310566], [105, 310966], [109, 311326], [112, 311546]]}, {"verse": 40, "start": 312233, "end": 315925, "text": "Porque el que no es contra nosotros, por nosotros es.", "words": [[0, 312233], [7, 312584], [10, 312764], [14, 312904], [17, 313084], [20, 313224], [27, 313544], [37, 314424], [41, 314764], [50, 315284]]}, {"verse": 41, "start": 316275, "end": 324360, "text": "Y cualquiera que os dé un vaso de agua en mi nombre, porque sois de Cristo, de cierto os digo que no perderá su recompensa.", "words": [[0, 316275], [2, 316420], [13, 317020], [17, 317240], [20, 317360], [23, 317500], [26, 317620], [31, 318020], [34, 318160], [39, 318400], [42, 318580], [45, 318740], [53, 319200], [60, 319440], [65, 319820], [68, 319940], [76, 320385], [79, 320830], [86, 321275], [89, 321550], [94, 321890], [98, 322370], [101, 322530], [109, 323070], [112, 323230]]}, {"verse": 42, "start": 324710, "end": 334909, "text": "Y cualquiera que haga caer a uno de estos pequeños que creen en mí, mejor le fuera si se le atase una piedra de molino al cuello, y fuera echado en el mar.", "words": [[0, 324710], [2, 324815], [13, 325415], [17, 325635], [22, 325875], [27, 326335], [29, 326415], [33, 326635], [36, 326875], [42, 327075], [51, 327695], [55, 327855], [61, 328255], [64, 328395], [68, 329035], [74, 329475], [77, 329695], [83, 330015], [86, 330255], [89, 330415], [92, 330685], [98, 330955], [102, 331115], [109, 331575], [112, 331695], [119, 332155], [122, 332315], [130, 333085], [132, 333193], [138, 333493], [145, 334173], [148, 334373], [151, 334493]]}, {"verse": 43, "start": 335259, "end": 345899, "text": "Y si tu mano te hace pecar, córtala: mejor te es entrar a la vida manco, que teniendo dos manos ir a la Gehenna, al fuego que no puede ser apagado;", "words": [[0, 335259], [2, 335362], [5, 335502], [8, 335682], [13, 335942], [16, 336162], [21, 336342], [28, 336982], [37, 337867], [43, 338216], [46, 338396], [49, 338576], [56, 338916], [58, 339096], [61, 339196], [66, 339396], [73, 340216], [77, 340416], [86, 340996], [90, 341376], [96, 341996], [99, 342436], [101, 342536], [104, 342866], [113, 343196], [116, 343716], [122, 344076], [126, 344336], [129, 344476], [135, 344716], [139, 345036]]}, {"verse": 44, "start": 346249, "end": 350054, "text": "Donde su gusano no muere, y el fuego nunca se apaga.", "words": [[0, 346249], [6, 346514], [9, 346834], [16, 347294], [19, 347514], [26, 347914], [28, 348154], [31, 348294], [37, 348574], [43, 348994], [46, 349414]]}, {"verse": 45, "start": 350404, "end": 361898, "text": "Y si tu pie te es ocasión de caer, córtalo: mejor te es entrar a la vida cojo, que teniendo dos pies ser echado en la Gehenna, al fuego que no puede ser apagado;", "words": [[0, 350404], [2, 350511], [5, 350631], [8, 350841], [12, 351051], [15, 351191], [18, 351331], [26, 351851], [29, 351991], [35, 352451], [44, 353357], [50, 353709], [53, 353929], [56, 354109], [63, 354449], [65, 354629], [68, 354729], [73, 354949], [79, 355929], [83, 356169], [92, 356749], [96, 356949], [101, 357349], [105, 357729], [112, 358209], [115, 358329], [118, 358939], [127, 359549], [130, 359769], [136, 360189], [140, 360449], [143, 360589], [149, 360829], [153, 361129]]}, {"verse": 46, "start": 362248, "end": 367480, "text": "Donde el gusano de ellos no muere, y el fuego nunca se apaga.", "words": [[0, 362248], [6, 362592], [9, 362912], [16, 363392], [19, 363612], [25, 363832], [28, 364092], [35, 364592], [37, 365052], [40, 365212], [46, 365632], [52, 366412], [55, 366812]]}, {"verse": 47, "start": 367830, "end": 378938, "text": "Y si tu ojo te es ocasión de caer, sácalo: mejor te es entrar al reino de Dios con un ojo, que teniendo dos ojos ser echado a la Gehenna;", "words": [[0, 367830], [2, 368130], [5, 368290], [8, 368510], [12, 368850], [15, 369030], [18, 369210], [26, 369750], [29, 369930], [35, 370510], [43, 371455], [49, 371938], [52, 372158], [55, 372378], [62, 372798], [65, 373118], [71, 373558], [74, 373718], [79, 373978], [83, 374258], [86, 374478], [91, 375178], [95, 375398], [104, 375958], [108, 376298], [113, 376698], [117, 377158], [124, 377878], [126, 378018], [129, 378514]]}, {"verse": 48, "start": 379288, "end": 384520, "text": "Donde el gusano de ellos no muere, y el fuego nunca se apaga.", "words": [[0, 379288], [6, 379632], [9, 379952], [16, 380432], [19, 380652], [25, 380872], [28, 381132], [35, 381632], [37, 382092], [40, 382252], [46, 382672], [52, 383452], [55, 383852]]}, {"verse": 49, "start": 384870, "end": 389843, "text": "Porque todos serán salados con fuego, y todo sacrificio será salado con sal.", "words": [[0, 384870], [7, 385094], [13, 385454], [19, 385994], [27, 386494], [31, 386694], [38, 387134], [40, 387389], [45, 387609], [56, 388389], [61, 388629], [68, 389129], [72, 389329]]}, {"verse": 50, "start": 390193, "end": 401111, "text": "Buena es la sal; pero si la sal pierde su sabor, ¿con qué la sazonaréis? Tened en vosotros mismos sal; y tened paz los unos con los otros.", "words": [[0, 390193], [6, 390630], [9, 390910], [12, 391070], [17, 391720], [22, 391862], [25, 392042], [28, 392202], [32, 392595], [39, 392995], [42, 393155], [49, 393875], [54, 394095], [58, 394395], [61, 394575], [73, 395875], [79, 396393], [82, 396513], [91, 396953], [98, 397213], [103, 398198], [105, 398380], [111, 398600], [115, 398980], [119, 399420], [124, 399800], [128, 400220], [132, 400420]]}]}