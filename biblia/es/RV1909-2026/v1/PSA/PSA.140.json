{"book": "PSA", "chapter": 140, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 92407, "verses": [{"verse": 1, "start": 300, "end": 8433, "text": "Al Músico principal: Salmo de David. LÍBRAME, oh Jehová, de hombre malo: guárdame de hombre violento;", "words": [[0, 300], [3, 470], [10, 950], [21, 2093], [27, 2635], [30, 2795], [37, 3891], [46, 4331], [49, 4771], [57, 5211], [60, 5311], [67, 5631], [73, 6478], [82, 7059], [85, 7219], [92, 7479]]}, {"verse": 2, "start": 8783, "end": 13744, "text": "Los cuales maquinan males en el corazón, cada día urden contiendas.", "words": [[0, 8783], [4, 8927], [11, 9127], [20, 9807], [26, 10227], [29, 10507], [32, 10627], [41, 11167], [46, 11687], [50, 12047], [56, 12895]]}, {"verse": 3, "start": 13744, "end": 20708, "text": "Aguzaron su lengua como la serpiente; veneno de áspid hay debajo de sus labios. (Selah.)", "words": [[0, 14104], [9, 14464], [12, 14704], [19, 15184], [24, 15424], [27, 15564], [38, 16734], [45, 17238], [48, 17398], [54, 17938], [58, 18158], [65, 18578], [68, 18738], [72, 18878], [80, 20285]]}, {"verse": 4, "start": 21058, "end": 28418, "text": "Guárdame, oh Jehová, de manos del impío, presérvame del hombre injurioso; que han pensado trastornar mis pasos.", "words": [[0, 21058], [10, 21436], [13, 21850], [21, 22263], [24, 22383], [30, 22876], [34, 23370], [41, 23863], [52, 24363], [56, 24603], [63, 24823], [74, 26051], [78, 26132], [82, 26232], [90, 26772], [101, 27532], [105, 27692]]}, {"verse": 5, "start": 28768, "end": 36955, "text": "Me han escondido lazo y cuerdas los soberbios; han tendido red junto a la senda; me han puesto lazos. (Selah.)", "words": [[0, 28768], [3, 29008], [7, 29068], [17, 29568], [22, 30068], [24, 30448], [32, 30908], [36, 31028], [47, 32035], [51, 32236], [59, 32796], [63, 33136], [69, 33496], [71, 33736], [74, 33816], [81, 34658], [84, 34774], [88, 34854], [95, 35054], [102, 36532]]}, {"verse": 6, "start": 37305, "end": 43232, "text": "He dich