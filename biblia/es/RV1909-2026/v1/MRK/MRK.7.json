{"book": "MRK", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 314204, "verses": [{"verse": 1, "start": 300, "end": 6667, "text": "Y se juntaron a él los fariseos, y algunos de los escribas, que habían venido de Jerusalén;", "words": [[0, 300], [2, 465], [5, 545], [14, 1145], [16, 1305], [19, 1485], [23, 1745], [33, 2585], [35, 3125], [43, 3485], [46, 3705], [50, 3845], [60, 4485], [64, 4865], [71, 5165], [78, 5685], [81, 5845]]}, {"verse": 2, "start": 7117, "end": 14782, "text": "Los cuales, viendo a algunos de sus discípulos comer pan con manos impuras, es decir, no lavadas, los criticaban.", "words": [[0, 7117], [4, 7242], [12, 7782], [19, 7952], [21, 8122], [29, 8582], [32, 8802], [36, 8982], [47, 9642], [53, 9942], [57, 10282], [61, 10542], [67, 10822], [76, 11902], [79, 11962], [86, 12742], [89, 12882], [98, 13482], [102, 13802]]}, {"verse": 3, "start": 15232, "end": 24073, "text": "(Porque los fariseos y todos los judíos, teniendo la tradición de los ancianos, si muchas veces no se lavan las manos, no comen.", "words": [[0, 15232], [8, 15495], [12, 15675], [21, 16415], [23, 16575], [29, 16835], [33, 17095], [41, 18075], [50, 18635], [53, 18795], [63, 19395], [66, 19575], [70, 19695], [80, 20735], [83, 20835], [90, 21095], [96, 21535], [99, 21895], [102, 22095], [108, 22495], [112, 22635], [119, 23215], [122, 23375]]}, {"verse": 4, "start": 24523, "end": 38463, "text": "Y volviendo de la plaza, si no se lavan, no comen. Y otras muchas cosas hay, que tomaron para guardar, como las lavaduras de los vasos de beber, y de los jarros, y de los recipientes de metal, y de las camas.)", "words": [[0, 24523], [2, 24648], [12, 25128], [15, 25288], [18, 25408], [25, 25828], [28, 26008], [31, 26168], [34, 26308], [41, 27028], [44, 27268], [51, 28276], [53, 28401], [59, 28581], [66, 28881], [72, 29341], [77, 29841], [81, 30261], [89, 30701], [94, 30941], [103, 31721], [108, 32061], [112, 32321], [122, 33061], [125, 33221], [129, 33361], [135, 33741], [138, 33841], [145, 34121], [147, 34561], [150, 34661], [154, 34801], [162, 35361], [164, 35681], [167, 35781], [171, 35901], [183, 36501], [186, 36641], [193, 37489], [195, 37609], [198, 37689], [202, 37809]]}, {"verse": 5, "start": 38913, "end": 48811, "text": "Y le preguntaron los fariseos y los escribas: ¿Por qué tus discípulos no andan conforme a la tradición de los ancianos, sino que comen pan con manos impuras?", "words": [[0, 38913], [2, 39036], [5, 39136], [17, 39816], [21, 39976], [30, 40736], [32, 40876], [36, 41016], [46, 42153], [51, 42273], [55, 42453], [59, 42653], [70, 43293], [73, 43553], [79, 43853], [88, 44373], [90, 44433], [93, 44473], [103, 45013], [106, 45153], [110, 45273], [120, 46373], [125, 46573], [129, 46773], [135, 47013], [139, 47393], [143, 47633], [149, 47933]]}, {"verse": 6, "start": 49161, "end": 62173, "text": "Y respondiendo él, les dijo: Hipócritas, bien profetizó de vosotros Isaías, como está escrito: Este pueblo con los labios me honra, pero su corazón lejos está de mí.", "words": [[0, 49161], [2, 49282], [15, 50122], [19, 50522], [23, 50922], [29, 51814], [41, 53121], [46, 53501], [56, 54421], [59, 54561], [68, 55081], [76, 55355], [81, 55630], [86, 55904], [95, 57638], [100, 57858], [107, 58238], [111, 58518], [115, 58698], [122, 59118], [125, 59338], [132, 59718], [137, 59958], [140, 60138], [148, 60958], [154, 61418], [159, 61698], [162, 61898]]}, {"verse": 7, "start": 62623, "end": 67881, "text": "Y en vano me honran, enseñando como doctrinas mandamientos de hombres.", "words": [[0, 62623], [2, 62765], [5, 62905], [10, 63245], [13, 63385], [21, 63965], [31, 65265], [36, 65525], [46, 66225], [59, 66885], [62, 67105]]}, {"verse": 8, "start": 68331, "end": 80763, "text": "Porque dejando el mandamiento de Dios, tenéis la tradición de los hombres; las lavaduras de los jarros y de los vasos de beber: y hacéis otras muchas cosas semejantes.", "words": [[0, 68331], [7, 68890], [15, 69570], [18, 69690], [30, 70370], [33, 70570], [39, 71310], [46, 71810], [49, 72070], [59, 72690], [62, 72830], [66, 72990], [75, 74012], [79, 74470], [89, 75370], [92, 75510], [96, 75630], [103, 76190], [105, 76370], [108, 76470], [112, 76590], [118, 77010], [121, 77322], [128, 77881], [130, 78170], [137, 78500], [143, 79000], [150, 79380], [156, 79740]]}, {"verse": 9, "start": 81213, "end": 88007, "text": "Les decía también: Bien invalidáis el mandamiento de Dios para guardar vuestra tradición.", "words": [[0, 81213], [4, 81361], [10, 81741], [19, 82820], [24, 83144], [35, 84204], [38, 84364], [50, 85064], [53, 85244], [58, 85544], [63, 86184], [71, 86784], [79, 87144]]}, {"verse": 10, "start": 88457, "end": 98051, "text": "Porque Moisés dijo: Honra a tu padre y a tu madre, y: El que maldiga al padre o a la madre, morirá de muerte.", "words": [[0, 88457], [7, 88798], [14, 89278], [20, 90491], [26, 90975], [28, 91155], [31, 91255], [37, 91615], [39, 91955], [41, 92055], [44, 92095], [51, 92495], [54, 93713], [57, 93878], [61, 94018], [69, 94558], [72, 94778], [78, 95198], [80, 95558], [82, 95678], [85, 95778], [92, 96678], [99, 97278], [102, 97358]]}, {"verse": 11, "start": 98501, "end": 110953, "text": "Y vosotros decís: Basta que diga un hombre al padre o a la madre: Es Corbán (que quiere decir, mi ofrenda a Dios) todo aquello con que pudiera ayudarte;", "words": [[0, 98501], [2, 98646], [11, 99066], [18, 100277], [24, 100777], [28, 101077], [33, 101437], [36, 101597], [43, 101937], [46, 102137], [52, 102597], [54, 103017], [56, 103137], [59, 103237], [66, 104116], [69, 104301], [76, 105381], [81, 105621], [88, 105921], [95, 106421], [98, 106921], [106, 107481], [108, 107681], [114, 108381], [119, 108541], [127, 109061], [131, 109301], [135, 109481], [143, 110001]]}, {"verse": 12, "start": 111403, "end": 115499, "text": "Y no le dejáis hacer más por su padre o por su madre,", "words": [[0, 111403], [2, 111663], [5, 111803], [8, 111943], [15, 112403], [21, 112723], [25, 112983], [29, 113243], [32, 113443], [38, 113863], [40, 114403], [44, 114623], [47, 114803]]}, {"verse": 13, "start": 115949, "end": 124940, "text": "Invalidando la palabra de Dios con vuestra tradición que habéis transmitido: y muchas cosas hacéis semejantes a estas.", "words": [[0, 115949], [12, 116730], [15, 116930], [23, 117270], [26, 117510], [31, 117770], [35, 118070], [43, 118550], [53, 119310], [57, 119570], [64, 119910], [77, 121313], [79, 121560], [86, 121800], [92, 122510], [99, 123220], [110, 124140], [112, 124360]]}, {"verse": 14, "start": 125390, "end": 130405, "text": "Y llamando a toda la multitud, les dijo: Oídme todos, y entended:", "words": [[0, 125390], [2, 125591], [11, 126031], [13, 126131], [18, 126271], [21, 126511], [31, 127091], [35, 127351], [41, 128245], [47, 128734], [54, 129074], [56, 129614]]}, {"verse": 15, "start": 130855, "end": 140501, "text": "Nada hay fuera del hombre que entre en él, que le pueda contaminar: pero lo que sale de él, aquello es lo que contamina al hombre.", "words": [[0, 130855], [5, 131219], [9, 131679], [15, 131999], [19, 132319], [26, 132639], [30, 132919], [36, 133499], [39, 133839], [43, 134219], [47, 134599], [50, 134739], [56, 134999], [68, 136216], [73, 136357], [76, 136537], [80, 136657], [85, 136917], [88, 137157], [92, 137717], [100, 138217], [103, 138477], [106, 138837], [110, 138977], [120, 139717], [123, 139897]]}, {"verse": 16, "start": 140951, "end": 144139, "text": "Si alguno tiene oídos para oír, oiga.", "words": [[0, 140951], [3, 141112], [10, 141652], [16, 141912], [22, 142572], [27, 142772], [32, 143592]]}, {"verse": 17, "start": 144589, "end": 151400, "text": "Y apartado de la multitud, habiendo entrado en casa, le preguntaron sus discípulos sobre la parábola.", "words": [[0, 144589], [2, 144692], [11, 145272], [14, 145452], [17, 145552], [27, 146472], [36, 146872], [44, 147332], [47, 147472], [53, 148372], [56, 148512], [68, 149192], [72, 149412], [83, 150112], [89, 150472], [92, 150692]]}, {"verse": 18, "start": 151850, "end": 161106, "text": "Y les dijo: ¿También vosotros estáis así sin comprender? ¿No entendéis que todo lo de fuera que entra en el hombre, no le puede contaminar;", "words": [[0, 151850], [2, 152170], [6, 152290], [12, 153096], [21, 153374], [30, 153934], [37, 154394], [41, 154634], [45, 154834], [57, 155990], [61, 156140], [71, 156760], [75, 156940], [80, 157280], [83, 157500], [86, 157620], [92, 157940], [96, 158240], [102, 158600], [105, 158820], [108, 158980], [116, 159280], [119, 159860], [122, 160020], [128, 160240]]}, {"verse": 19, "start": 161556, "end": 170240, "text": "Porque no entra en su corazón, sino en el vientre, y sale a la letrina? Esto decía, declarando limpios todos los alimentos.", "words": [[0, 161556], [7, 161997], [10, 162277], [16, 162637], [19, 162797], [22, 162937], [31, 163457], [36, 163817], [39, 163997], [42, 164117], [51, 164737], [53, 165097], [58, 165377], [60, 165557], [63, 165657], [72, 166698], [77, 166986], [84, 167556], [95, 168126], [103, 168746], [109, 169026], [113, 169326]]}, {"verse": 20, "start": 170690, "end": 175501, "text": "Pero decía, que lo que del hombre sale, aquello contamina al hombre.", "words": [[0, 170690], [5, 170832], [12, 171171], [16, 171914], [19, 172274], [23, 172474], [27, 172674], [34, 172954], [40, 173454], [48, 173954], [58, 174694], [61, 174934]]}, {"verse": 21, "start": 175951, "end": 186059, "text": "Porque de dentro, del corazón de los hombres, salen los malos pensamientos, los adulterios, las fornicaciones, los homicidios,", "words": [[0, 175951], [7, 176233], [10, 176473], [18, 176953], [22, 177253], [30, 177753], [33, 178013], [37, 178153], [46, 178593], [52, 179513], [56, 179753], [62, 180213], [76, 181573], [80, 181673], [92, 182973], [96, 183093], [111, 184593], [115, 184753]]}, {"verse": 22, "start": 186509, "end": 197395, "text": "Los hurtos, las avaricias, las maldades, el engaño, la lascivia, el ojo maligno, las injurias, la soberbia, la insensatez.", "words": [[0, 186509], [4, 187213], [12, 187953], [16, 188113], [27, 189573], [31, 190273], [41, 190973], [44, 191133], [52, 192113], [55, 192193], [65, 193173], [68, 193313], [72, 193633], [81, 194733], [85, 194853], [95, 195793], [98, 195833], [108, 196513], [111, 196954]]}, {"verse": 23, "start": 197845, "end": 202773, "text": "Todas estas maldades de dentro salen, y contaminan al hombre.", "words": [[0, 197845], [6, 198598], [12, 198938], [21, 199718], [24, 199938], [31, 200318], [38, 200958], [40, 201278], [51, 202058], [54, 202238]]}, {"verse": 24, "start": 203223, "end": 212991, "text": "Y levantándose de allí, se fue a la región de Tiro y Sidón; y entrando en casa, quiso que nadie lo supiese; pero no pudo esconderse.", "words": [[0, 203223], [2, 203340], [15, 204220], [18, 204400], [24, 205180], [27, 205380], [31, 205580], [33, 205700], [36, 205760], [43, 206100], [46, 206320], [51, 206720], [53, 206840], [60, 207863], [62, 208039], [71, 208599], [74, 208819], [80, 209119], [86, 209639], [90, 209819], [96, 210119], [99, 210339], [108, 211371], [113, 211538], [116, 211698], [121, 212058]]}, {"verse": 25, "start": 213441, "end": 221421, "text": "Porque una mujer, cuya hija tenía un espíritu inmundo, luego que oyó de él, vino y se echó a sus pies.", "words": [[0, 213441], [7, 213665], [11, 213925], [18, 214365], [23, 214825], [28, 215165], [34, 215445], [37, 215685], [46, 216385], [55, 216985], [61, 217565], [65, 217925], [69, 218285], [72, 218425], [76, 218665], [81, 219365], [83, 219985], [86, 220145], [91, 220485], [93, 220585], [97, 220745]]}, {"verse": 26, "start": 221871, "end": 228730, "text": "Y la mujer era griega, Sirofenisa de nación; y le rogaba que echase fuera de su hija al demonio.", "words": [[0, 221871], [2, 221966], [5, 222086], [11, 222386], [15, 222973], [23, 223559], [34, 224146], [37, 224326], [45, 225362], [47, 225474], [50, 225624], [57, 226164], [61, 226534], [68, 226904], [74, 227224], [77, 227424], [80, 227624], [85, 227834], [88, 228044]]}, {"verse": 27, "start": 229180, "end": 238371, "text": "Pero Jesús le dijo: Deja primero hartarse los hijos, porque no es bien tomar el pan de los hijos y echarlo a los perrillos.", "words": [[0, 229180], [5, 229322], [11, 229722], [14, 230242], [20, 231086], [25, 231450], [33, 231830], [42, 232410], [46, 232590], [53, 233570], [60, 233950], [63, 234210], [66, 234370], [71, 234550], [77, 234910], [80, 235170], [84, 235510], [87, 235730], [91, 235870], [97, 236270], [99, 236610], [107, 237250], [109, 237350], [113, 237890]]}, {"verse": 28, "start": 238821, "end": 246761, "text": "Y respondió ella, y le dijo: Sí, Señor; pero aun los perrillos debajo de la mesa, comen de las migajas de los hijos.", "words": [[0, 238821], [2, 238914], [12, 239674], [18, 239994], [20, 240514], [23, 240654], [29, 241430], [33, 241810], [40, 242502], [45, 242644], [49, 242924], [53, 243144], [63, 243604], [70, 244024], [73, 244164], [76, 244264], [82, 244564], [88, 245084], [91, 245264], [95, 245404], [103, 245924], [106, 246044], [110, 246164]]}, {"verse": 29, "start": 247111, "end": 252237, "text": "Entonces le dice: Por esta respuesta, ve; el demonio ha salido de tu hija.", "words": [[0, 247111], [9, 247550], [12, 247890], [18, 248723], [22, 248867], [27, 249067], [38, 249567], [42, 250253], [45, 250437], [53, 250918], [56, 250997], [63, 251418], [66, 251578], [69, 251758]]}, {"verse": 30, "start": 252687, "end": 258985, "text": "Y como fue a su casa, halló que el demonio había salido, y a la hija echada sobre la cama.", "words": [[0, 252687], [2, 252967], [7, 253227], [11, 253467], [13, 253567], [16, 253707], [22, 254197], [28, 254687], [32, 254847], [35, 255027], [43, 255487], [49, 255687], [57, 256327], [59, 256787], [61, 256867], [64, 256967], [69, 257387], [76, 257887], [82, 258227], [85, 258447]]}, {"verse": 31, "start": 259435, "end": 268120, "text": "Y volviendo a salir de la región de Tiro, vino por Sidón al mar de Galilea, por en medio de la región de Decápolis.", "words": [[0, 259435], [2, 259578], [12, 260098], [14, 260218], [20, 260558], [23, 260818], [26, 260958], [33, 261358], [36, 261598], [42, 262498], [47, 262818], [51, 263138], [57, 263718], [60, 263978], [64, 264238], [67, 264438], [76, 265438], [80, 265718], [83, 265878], [89, 266158], [92, 266378], [95, 266518], [102, 266938], [105, 267118]]}, {"verse": 32, "start": 268570, "end": 275679, "text": "Y le traen un hombre sordo y con dificultad para hablar, y le ruegan que le ponga la mano encima.", "words": [[0, 268570], [2, 268711], [5, 268791], [11, 269331], [14, 269471], [21, 269771], [27, 270351], [29, 270931], [33, 271131], [44, 271971], [49, 272231], [57, 272671], [59, 273151], [62, 273451], [69, 273751], [73, 273891], [76, 274031], [82, 274471], [85, 274571], [90, 274911]]}, {"verse": 33, "start": 276129, "end": 284329, "text": "Y tomándole aparte de la gente, metió sus dedos en las orejas de él, y escupiendo, tocó su lengua;", "words": [[0, 276129], [2, 276265], [12, 276945], [19, 277585], [22, 277665], [25, 277805], [32, 278845], [38, 279225], [42, 279505], [48, 279965], [51, 280105], [55, 280285], [62, 280725], [65, 280945], [69, 281165], [71, 281745], [83, 282925], [88, 283445], [91, 283705]]}, {"verse": 34, "start": 284779, "end": 291780, "text": "Y mirando al cielo, gimió, y le dijo: Efata: que es decir: Sé abierto.", "words": [[0, 284779], [2, 284942], [10, 285322], [13, 285502], [20, 286202], [27, 286902], [29, 287782], [32, 287902], [38, 288988], [45, 289615], [49, 289760], [52, 289940], [59, 290781], [62, 291206]]}, {"verse": 35, "start": 292230, "end": 299173, "text": "Y luego fueron abiertos sus oídos, y se soltó la atadura de su lengua, y hablaba con claridad.", "words": [[0, 292230], [2, 292374], [8, 292574], [15, 293014], [24, 293794], [28, 294034], [35, 294854], [37, 294994], [40, 295134], [46, 295614], [49, 295814], [57, 296374], [60, 296614], [63, 296754], [71, 297614], [73, 297774], [81, 298214], [85, 298394]]}, {"verse": 36, "start": 299623, "end": 306441, "text": "Y les mandó que no lo dijesen a nadie; pero cuanto más les mandaba, tanto más y más lo divulgaban.", "words": [[0, 299623], [2, 299731], [6, 299851], [12, 300231], [16, 300351], [19, 300511], [22, 300821], [30, 301131], [32, 301291], [39, 302126], [44, 302268], [51, 302568], [55, 302868], [59, 303008], [68, 304128], [74, 304288], [78, 304668], [80, 304908], [84, 305148], [87, 305388]]}, {"verse": 37, "start": 306891, "end": 313804, "text": "Y en gran manera se maravillaban, diciendo: Bien lo ha hecho todo: hace a los sordos oír, y a los mudos hablar.", "words": [[0, 306891], [2, 307017], [5, 307137], [10, 307337], [17, 307737], [20, 307957], [34, 308637], [44, 309567], [49, 309792], [52, 310012], [55, 310092], [61, 310252], [67, 311009], [72, 311313], [74, 311393], [78, 311513], [85, 311993], [90, 312393], [92, 312793], [94, 312853], [98, 312973], [104, 313353]]}]}