{"book": "GEN", "chapter": 30, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 370362, "verses": [{"verse": 1, "start": 300, "end": 11700, "text": "Y viendo Raquel que no daba hijos a Jacob, tuvo envidia de su hermana, y decía a Jacob: Dame hijos, o si no, me muero.", "words": [[0, 300], [2, 428], [9, 748], [16, 1488], [20, 1548], [23, 1748], [28, 2068], [34, 2388], [36, 2648], [43, 3448], [48, 3788], [56, 4708], [59, 4848], [62, 5028], [71, 5568], [73, 5788], [79, 6148], [81, 6588], [88, 7459], [93, 7679], [100, 8419], [102, 8519], [105, 8659], [109, 9179], [112, 9359]]}, {"verse": 2, "start": 12050, "end": 19890, "text": "Y Jacob se enojaba contra Raquel, y decía: ¿Soy yo en lugar de Dios, que te impidió el fruto de tu vientre?", "words": [[0, 12050], [2, 12237], [8, 12517], [11, 13177], [19, 13857], [26, 14217], [34, 14797], [36, 15217], [43, 16148], [48, 16391], [51, 16691], [54, 16831], [60, 17031], [63, 17251], [69, 17811], [73, 18011], [76, 18151], [84, 18631], [87, 18731], [93, 19071], [96, 19191], [99, 19331]]}, {"verse": 3, "start": 20240, "end": 29284, "text": "Y ella dijo: He aquí mi sierva Bilha; entra a ella, y parirá sobre mis rodillas, y yo también tendré hijos de ella.", "words": [[0, 20240], [2, 20402], [7, 20602], [13, 21516], [16, 21626], [21, 21906], [24, 22406], [31, 22898], [38, 23662], [44, 23792], [46, 23952], [52, 24372], [54, 24832], [61, 25252], [67, 25492], [71, 25692], [81, 26672], [83, 26752], [86, 26912], [94, 27172], [101, 27692], [107, 27992], [110, 28232]]}, {"verse": 4, "start": 29634, "end": 34572, "text": "Así le dio a Bilha su sierva por mujer; y Jacob entró a ella.", "words": [[0, 29634], [4, 29998], [7, 30258], [11, 30498], [13, 30738], [19, 30978], [22, 31178], [29, 31698], [33, 31998], [40, 32941], [42, 33104], [48, 33344], [54, 33964], [56, 34084]]}, {"verse": 5, "start": 35022, "end": 38112, "text": "Y concibió Bilha, y parió a Jacob un hijo.", "words": [[0, 35022], [2, 35119], [11, 35629], [18, 36139], [20, 36519], [26, 36939], [28, 37059], [34, 37339], [37, 37599]]}, {"verse": 6, "start": 38562, "end": 46265, "text": "Y dijo Raquel: Me juzgó Dios, y también oyó mi voz, y me dio un hijo. Por tanto llamó su nombre Dan.", "words": [[0, 38562], [2, 38684], [7, 38904], [15, 39794], [18, 39914], [24, 40294], [30, 40554], [32, 41094], [40, 41394], [44, 41814], [47, 41934], [52, 42274], [54, 42614], [57, 42734], [61, 42934], [64, 43114], [70, 43894], [74, 44016], [80, 44576], [86, 44936], [89, 45076], [96, 45436]]}, {"verse": 7, "start": 46715, "end": 52751, "text": "Y concibió otra vez Bilha, la sierva de Raquel, y parió el hijo segundo a Jacob.", "words": [[0, 46715], [2, 46817], [11, 47437], [16, 47697], [20, 48307], [27, 48917], [30, 49017], [37, 49477], [40, 49617], [48, 50117], [50, 50697], [56, 51137], [59, 51297], [64, 51477], [72, 51937], [74, 52177]]}, {"verse": 8, "start": 53201, "end": 61255, "text": "Y dijo Raquel: Con luchas de Dios he contendido con mi hermana, y he vencido. Y llamó su nombre Neftalí.", "words": [[0, 53201], [2, 53323], [7, 53543], [15, 54434], [19, 54574], [26, 55014], [29, 55134], [34, 55394], [37, 55694], [48, 56334], [52, 56474], [55, 56614], [64, 57054], [66, 57474], [69, 57574], [78, 59547], [80, 59752], [86, 59992], [89, 60232], [96, 60472]]}, {"verse": 9, "start": 61705, "end": 68765, "text": "Y viendo Lea que había dejado de parir, tomó a Zilpa su sierva, y la dio a Jacob por mujer.", "words": [[0, 61705], [2, 61971], [9, 62277], [13, 62584], [17, 62764], [23, 63004], [30, 63524], [33, 63704], [40, 64124], [45, 64684], [47, 64964], [53, 65244], [56, 65384], [64, 65904], [66, 66284], [69, 66664], [73, 66904], [75, 67104], [81, 67444], [85, 68124]]}, {"verse": 10, "start": 69215, "end": 73399, "text": "Y Zilpa, sierva de Lea, parió a Jacob un hijo.", "words": [[0, 69439], [2, 69699], [9, 69959], [16, 70219], [19, 70579], [24, 71039], [30, 71979], [32, 72179], [38, 72539], [41, 72919]]}, {"verse": 11, "start": 73849, "end": 78188, "text": "Y dijo Lea: Vino la ventura. Y llamó su nombre Gad.", "words": [[0, 73849], [2, 74148], [7, 74368], [12, 75173], [17, 75477], [20, 75879], [29, 76571], [31, 76696], [37, 77016], [40, 77116], [47, 77673]]}, {"verse": 12, "start": 78638, "end": 82488, "text": "Y Zilpa, la sierva de Lea, parió otro hijo a Jacob.", "words": [[0, 78638], [2, 78895], [9, 79185], [12, 79305], [19, 79725], [22, 79845], [27, 80285], [33, 80885], [38, 81305], [43, 81565], [45, 81785]]}, {"verse": 13, "start": 82938, "end": 89906, "text": "Y dijo Lea: Para dicha mía; porque las mujeres me dirán dichosa: y llamó su nombre Aser.", "words": [[0, 82938], [2, 83237], [7, 83457], [12, 84262], [17, 84473], [23, 84893], [28, 85632], [35, 85815], [39, 86035], [47, 86415], [50, 86705], [56, 86995], [65, 88276], [67, 88402], [73, 88722], [76, 88862], [83, 89411]]}, {"verse": 14, "start": 90356, "end": 105147, "text": "Y fue Rubén en tiempo de la siega de los trigos, y halló mandrágoras en el campo, y las trajo a Lea su madre: y dijo Raquel a Lea: Te ruego que me des de las mandrágoras de tu hijo.", "words": [[0, 90356], [2, 90613], [6, 90773], [12, 91253], [15, 91533], [22, 91973], [25, 92193], [28, 92433], [34, 92673], [37, 92753], [41, 92893], [49, 93833], [51, 94133], [57, 94493], [69, 95493], [72, 95813], [75, 95973], [82, 96813], [84, 97033], [88, 97193], [94, 97500], [96, 97806], [100, 98113], [103, 98273], [110, 99168], [112, 99572], [117, 99892], [124, 100366], [126, 100839], [131, 101502], [134, 101602], [140, 101982], [144, 102142], [147, 102302], [151, 102542], [154, 102702], [158, 102842], [170, 103542], [173, 103742], [176, 103922]]}, {"verse": 15, "start": 105497, "end": 118038, "text": "Y ella respondió: ¿Es poco que hayas tomado mi marido, sino que también te has de llevar las mandrágoras de mi hijo? y dijo Raquel: Pues dormirá contigo esta noche por las mandrágoras de tu hijo.", "words": [[0, 105497], [2, 105697], [7, 105977], [18, 107245], [22, 107425], [27, 107665], [31, 107925], [37, 108285], [44, 108645], [47, 108805], [55, 109505], [60, 109685], [64, 109905], [72, 110205], [75, 110465], [79, 110605], [82, 110745], [89, 110945], [93, 111225], [105, 111865], [108, 112085], [111, 112245], [117, 113111], [119, 113233], [124, 113473], [132, 114338], [137, 114558], [145, 115158], [153, 115618], [158, 115798], [164, 116138], [168, 116398], [172, 116788], [184, 117178], [187, 117358], [190, 117538]]}, {"verse": 16, "start": 118388, "end": 132450, "text": "Y cuando Jacob volvía del campo a la tarde, salió Lea a él, y le dijo: A mí has de entrar, porque a la verdad te he alquilado por las mandrágoras de mi hijo. Y durmió con ella aquella noche.", "words": [[0, 118388], [2, 118470], [9, 118690], [15, 119090], [22, 119583], [26, 120077], [32, 120570], [34, 120650], [37, 120710], [44, 121350], [50, 121970], [54, 122590], [56, 122850], [60, 123150], [62, 123690], [65, 123830], [71, 124597], [73, 124801], [76, 124974], [80, 125148], [83, 125321], [91, 126321], [98, 126501], [100, 126641], [103, 126741], [110, 127081], [113, 127401], [116, 127541], [126, 128101], [130, 128321], [134, 128501], [146, 129161], [149, 129381], [152, 129541], [158, 130366], [160, 130492], [167, 131012], [171, 131172], [176, 131432], [184, 131812]]}, {"verse": 17, "start": 132900, "end": 138245, "text": "Y oyó Dios a Lea: y concibió, y parió a Jacob el quinto hijo.", "words": [[0, 132900], [2, 133036], [6, 133206], [11, 133609], [13, 134012], [18, 134645], [20, 134765], [30, 135605], [32, 135925], [38, 136405], [40, 136672], [46, 136938], [49, 137205], [56, 137665]]}, {"verse": 18, "start": 138695, "end": 146874, "text": "Y dijo Lea: Dios me ha dado mi recompensa, por cuanto di mi sierva a mi marido: por eso llamó su nombre Isacar.", "words": [[0, 138695], [2, 138994], [7, 139214], [12, 140019], [17, 140258], [20, 140458], [23, 140598], [28, 140778], [31, 140958], [43, 142178], [47, 142438], [54, 142698], [57, 142978], [60, 143098], [67, 143578], [69, 143698], [72, 143778], [80, 144725], [84, 144850], [88, 145050], [94, 145450], [97, 145590], [104, 146263]]}, {"verse": 19, "start": 147324, "end": 151110, "text": "Y concibió Lea otra vez, y parió el sexto hijo a Jacob.", "words": [[0, 147324], [2, 147431], [11, 148031], [15, 148351], [20, 148531], [25, 148931], [27, 149331], [33, 149671], [36, 149791], [42, 150231], [47, 150411], [49, 150571]]}, {"verse": 20, "start": 151560, "end": 162142, "text": "Y dijo Lea: Dios me ha dado una buena dote: ahora morará conmigo mi marido, porque le he parido seis hijos: y llamó su nombre Zabulón.", "words": [[0, 151560], [2, 151858], [7, 152078], [12, 152884], [17, 153209], [20, 153529], [23, 153729], [28, 153969], [32, 154189], [38, 154509], [44, 155409], [50, 155780], [57, 156280], [65, 156940], [68, 157020], [76, 157960], [83, 158160], [86, 158360], [89, 158560], [96, 158980], [101, 159280], [108, 160366], [110, 160468], [116, 160788], [119, 160948], [126, 161579]]}, {"verse": 21, "start": 162592, "end": 166685, "text": "Y después parió una hija, y llamó su nombre Dina.", "words": [[0, 162592], [2, 162913], [10, 163213], [16, 163713], [20, 163933], [26, 164693], [28, 164853], [34, 165213], [37, 165373], [44, 165753]]}, {"verse": 22, "start": 167135, "end": 173000, "text": "Y se acordó Dios de Raquel, y la oyó Dios, y abrió su matriz.", "words": [[0, 167135], [2, 167435], [5, 167575], [12, 168075], [17, 168315], [20, 168515], [28, 168955], [30, 169335], [33, 169715], [37, 170035], [43, 171315], [45, 171635], [51, 171955], [54, 172155]]}, {"verse": 23, "start": 173450, "end": 181003, "text": "Y concibió, y parió un hijo: y dijo: Quitado ha Dios mi afrenta:", "words": [[0, 173450], [2, 173572], [12, 174352], [14, 174572], [20, 175012], [23, 175292], [29, 176194], [31, 176363], [37, 177141], [45, 177411], [48, 177681], [53, 177881], [56, 178081]]}, {"verse": 24, "start": 181353, "end": 187488, "text": "Y llamó su nombre José, diciendo: Añádame Jehová otro hijo.", "words": [[0, 181353], [2, 181481], [8, 181821], [11, 182021], [18, 182401], [24, 182881], [34, 184528], [42, 185073], [49, 185593], [54, 185913]]}, {"verse": 25, "start": 187838, "end": 196261, "text": "Y aconteció, cuando Raquel hubo parido a José, que Jacob dijo a Labán: Envíame, e iré a mi lugar, y a mi tierra.", "words": [[0, 187838], [2, 187968], [13, 188648], [20, 189048], [27, 189448], [32, 189748], [39, 190148], [41, 190248], [47, 191128], [51, 191348], [57, 191708], [62, 192248], [64, 192408], [71, 193236], [80, 193822], [82, 194182], [86, 194482], [88, 194562], [91, 194682], [98, 195062], [100, 195422], [102, 195482], [105, 195602]]}, {"verse": 26, "start": 196711, "end": 204550, "text": "Dame mis mujeres y mis hijos, por las cuales he servido contigo, y déjame ir; pues tú sabes los servicios que te he hecho.", "words": [[0, 196711], [5, 196950], [9, 197210], [17, 197650], [19, 197910], [23, 198110], [30, 198710], [34, 198930], [38, 199090], [45, 199390], [48, 199750], [56, 200150], [65, 200790], [67, 201110], [74, 201530], [78, 202216], [83, 202320], [86, 202540], [92, 202840], [96, 203080], [106, 203580], [110, 203860], [113, 204020], [116, 204120]]}, {"verse": 27, "start": 204900, "end": 212816, "text": "Y Labán le respondió: Halle yo ahora gracia en tus ojos, y quédate; experimentado he que Jehová me ha bendecido por tu causa.", "words": [[0, 204900], [2, 205111], [8, 205361], [11, 205741], [22, 206896], [28, 207030], [31, 207163], [37, 207463], [44, 207763], [47, 207983], [51, 208123], [57, 208423], [59, 208823], [68, 210299], [82, 210569], [85, 210839], [89, 210859], [96, 211239], [99, 211339], [102, 211419], [112, 211899], [116, 212099], [119, 212239]]}, {"verse": 28, "start": 213166, "end": 216072, "text": "Y dijo: Señálame tu salario, que yo lo daré.", "words": [[0, 213166], [2, 213294], [8, 214067], [17, 214586], [20, 214746], [29, 215206], [33, 215366], [36, 215526], [39, 215646]]}, {"verse": 29, "start": 216422, "end": 221727, "text": "Y él respondió: Tú sabes cómo te he servido, y cómo ha estado tu ganado conmigo;", "words": [[0, 216422], [2, 216603], [5, 216743], [16, 217788], [19, 217884], [25, 218224], [30, 218564], [33, 218764], [36, 218884], [45, 219424], [47, 219644], [52, 219924], [55, 220084], [62, 220404], [65, 220644], [72, 221064]]}, {"verse": 30, "start": 222177, "end": 233171, "text": "Porque poco tenías antes de mi venida, y ha crecido en gran número; y Jehová te ha bendecido con mi llegada: y ahora ¿cuándo voy a hacer yo también por mi propia casa?", "words": [[0, 222177], [7, 222405], [12, 222665], [19, 223145], [25, 223545], [28, 223765], [31, 223865], [39, 224345], [41, 224745], [44, 224845], [52, 225265], [55, 225425], [60, 225605], [68, 226450], [70, 226571], [77, 226971], [80, 227071], [83, 227191], [93, 227731], [97, 227911], [100, 228091], [109, 229686], [111, 229823], [117, 230403], [125, 230803], [129, 230963], [131, 231143], [137, 231383], [140, 231583], [148, 231923], [152, 232183], [155, 232323], [162, 232523]]}, {"verse": 31, "start": 233521, "end": 241549, "text": "Y él dijo: ¿Qué te daré? Y respondió Jacob: No me des nada: si haces por mí esto, volveré a apacentar tus ovejas.", "words": [[0, 233521], [2, 233709], [5, 233869], [11, 234638], [16, 234742], [19, 234882], [25, 235649], [27, 235772], [37, 236352], [44, 237184], [47, 237323], [50, 237463], [54, 237583], [60, 238389], [63, 238572], [69, 238852], [73, 239092], [76, 239272], [82, 239852], [90, 240232], [92, 240312], [102, 240712], [106, 240892]]}, {"verse": 32, "start": 241999, "end": 256417, "text": "Yo pasaré hoy por todas tus ovejas, poniendo aparte todas las ovejas manchadas y salpicadas de color, y todas las reses de color oscuro entre las ovejas, y las manchadas y moteadas entre las cabras; y esto será mi salario.", "words": [[0, 241999], [3, 242088], [10, 242488], [14, 242708], [18, 242908], [24, 243168], [28, 243428], [36, 244528], [45, 244928], [52, 245428], [58, 245628], [62, 245888], [69, 246348], [79, 246928], [81, 247108], [92, 247708], [95, 247868], [102, 248768], [104, 248848], [110, 249088], [114, 249378], [120, 249668], [123, 249848], [129, 250088], [136, 250608], [142, 250788], [146, 250988], [154, 251949], [156, 252049], [160, 252169], [170, 252809], [172, 253029], [181, 253549], [187, 253849], [191, 254069], [199, 254977], [201, 255118], [206, 255358], [211, 255638], [214, 255798]]}, {"verse": 33, "start": 256867, "end": 268634, "text": "Así responderá por mí mi honradez mañana, cuando venga mi salario delante de ti: toda la que no sea pintada ni manchada en las cabras y de color oscuro en las ovejas mías, se me tendrá por robada.", "words": [[0, 256867], [4, 257113], [15, 257793], [19, 257993], [22, 258333], [25, 258603], [34, 258873], [42, 259733], [49, 259833], [55, 260213], [58, 260353], [66, 260793], [74, 261153], [77, 261333], [81, 262183], [86, 262399], [89, 262459], [93, 262599], [96, 262739], [100, 262939], [108, 263539], [111, 263659], [120, 264159], [123, 264219], [127, 264359], [134, 264839], [136, 264939], [139, 265079], [145, 265279], [152, 265819], [155, 265919], [159, 266019], [166, 266419], [172, 267099], [175, 267359], [178, 267499], [185, 267892], [189, 268286]]}, {"verse": 34, "start": 268984, "end": 272228, "text": "Y dijo Labán: Mira, ojalá fuese como tú dices.", "words": [[0, 268984], [2, 269104], [7, 269404], [14, 270264], [20, 270444], [26, 270884], [32, 271244], [37, 271464], [40, 271644]]}, {"verse": 35, "start": 272578, "end": 289777, "text": "Y apartó aquel día los machos cabríos rayados y manchados; y todas las cabras manchadas y de color vario, y toda res que tenía en sí algo de blanco, y todas las de color oscuro entre las ovejas, y las puso en manos de sus hijos;", "words": [[0, 272578], [2, 272695], [9, 273155], [15, 273495], [19, 273755], [23, 274275], [30, 274742], [38, 275208], [46, 275675], [48, 275855], [59, 276990], [61, 277138], [67, 277398], [71, 277658], [78, 278118], [88, 278818], [90, 279498], [93, 279638], [99, 280148], [106, 280658], [108, 281038], [113, 281258], [117, 281578], [121, 282068], [127, 282558], [130, 282678], [133, 282898], [138, 283298], [141, 283478], [149, 284018], [151, 284518], [157, 284858], [161, 285398], [164, 285558], [170, 285758], [177, 286258], [183, 286438], [187, 286658], [195, 287767], [197, 287888], [201, 287988], [206, 288388], [209, 288528], [215, 288748], [218, 288968], [222, 289148]]}, {"verse": 36, "start": 290227, "end": 296859, "text": "Y puso tres días de camino entre sí y Jacob: y Jacob apacentaba las otras ovejas de Labán.", "words": [[0, 290227], [2, 290540], [7, 290860], [12, 291120], [17, 291420], [20, 291560], [27, 291940], [33, 292220], [36, 292520], [38, 292760], [45, 293634], [47, 293900], [53, 294500], [64, 295100], [68, 295320], [74, 295600], [81, 296120], [84, 296510]]}, {"verse": 37, "start": 297309, "end": 308691, "text": "Y Jacob tomó varas de álamo verdes, y de avellano, y de castaño, y les quitó parte de la corteza para formar franjas blancas, descubriendo así lo blanco de las varas.", "words": [[0, 297309], [2, 297434], [8, 297774], [13, 298694], [19, 299114], [22, 299474], [28, 299834], [36, 300194], [38, 300454], [41, 300554], [51, 301074], [53, 301154], [56, 301274], [65, 301934], [67, 302394], [71, 302534], [77, 302834], [83, 303094], [86, 303294], [89, 303394], [97, 303954], [102, 304174], [109, 304614], [117, 305094], [126, 306124], [139, 306906], [143, 307146], [146, 307326], [153, 307766], [156, 307906], [160, 308026]]}, {"verse": 38, "start": 309141, "end": 320582, "text": "Y puso las varas que había pelado en las pilas, delante del ganado, en los abrevaderos del agua donde venían a beber las ovejas, las cuales entraban en celo viniendo a beber.", "words": [[0, 309141], [2, 309247], [7, 309647], [11, 309847], [17, 310267], [21, 310407], [27, 310667], [34, 311147], [37, 311267], [41, 311387], [48, 312047], [56, 312507], [60, 312967], [68, 313427], [71, 313967], [75, 314127], [87, 315047], [91, 315207], [96, 315467], [102, 315707], [109, 316207], [111, 316327], [117, 316527], [121, 316747], [129, 317828], [133, 317952], [140, 318172], [149, 318852], [152, 319012], [157, 319492], [166, 319972], [168, 320092]]}, {"verse": 39, "start": 321032, "end": 329901, "text": "Y concebían las ovejas delante de las varas, y parían borregos listados, pintados y salpicados de diversos colores.", "words": [[0, 321032], [2, 321160], [12, 321760], [16, 321960], [23, 322400], [31, 322960], [34, 323100], [38, 323200], [45, 323700], [47, 324060], [54, 324560], [63, 325420], [73, 326420], [82, 327420], [84, 327720], [95, 328420], [98, 328640], [107, 329160]]}, {"verse": 40, "start": 330351, "end": 343014, "text": "Y apartaba Jacob los corderos, y los ponía con su rebaño, los listados, y todo lo que era oscuro en el hato de Labán. Y ponía su hato aparte, y no lo ponía con las ovejas de Labán.", "words": [[0, 330351], [2, 330469], [11, 330989], [17, 331389], [21, 331929], [31, 332469], [33, 332729], [37, 332849], [43, 333229], [47, 333409], [50, 333609], [58, 334429], [62, 334569], [72, 335229], [74, 335749], [79, 336009], [82, 336249], [86, 336429], [90, 336589], [97, 337189], [100, 337349], [103, 337549], [108, 337749], [111, 337849], [118, 338750], [120, 338853], [126, 339233], [129, 339513], [134, 339793], [142, 340753], [144, 340873], [147, 341013], [150, 341133], [156, 341513], [160, 341673], [164, 341833], [171, 342253], [174, 342413]]}, {"verse": 41, "start": 343464, "end": 354699, "text": "Y sucedía que cuantas veces entraban en celo las tempranas, Jacob ponía las varas delante de las ovejas en las pilas, para que concibiesen a la vista de las varas.", "words": [[0, 343464], [2, 343589], [10, 344169], [14, 344389], [22, 344789], [28, 345229], [37, 346009], [40, 346196], [45, 346382], [49, 346569], [60, 348209], [66, 348489], [72, 349129], [76, 349309], [82, 349629], [90, 350069], [93, 350229], [97, 350389], [104, 350809], [107, 350989], [111, 351149], [118, 351889], [123, 352109], [127, 352289], [139, 353109], [141, 353349], [144, 353449], [150, 353689], [153, 353929], [157, 354069]]}, {"verse": 42, "start": 355149, "end": 362907, "text": "Y cuando venían las ovejas tardías, no las ponía: así eran las tardías para Labán, y las tempranas para Jacob.", "words": [[0, 355149], [2, 355250], [9, 355490], [16, 355970], [20, 356150], [27, 356570], [36, 357590], [39, 357850], [43, 358010], [50, 358888], [54, 359156], [59, 359476], [63, 359676], [71, 360176], [76, 360506], [83, 360836], [85, 361316], [89, 361456], [99, 362076], [104, 362276]]}, {"verse": 43, "start": 363357, "end": 369962, "text": "Y el varón prosperó muchísimo, y tuvo muchas ovejas, y siervas y siervos, y camellos y asnos.", "words": [[0, 363357], [2, 363519], [5, 363699], [11, 364119], [20, 364739], [31, 365319], [33, 366059], [38, 366279], [45, 366679], [53, 367259], [55, 367399], [63, 367819], [65, 368019], [74, 368439], [76, 368619], [85, 369159], [87, 369319]]}]}