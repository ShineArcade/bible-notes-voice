{"book": "GEN", "chapter": 2, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 218520, "verses": [{"verse": 1, "start": 300, "end": 6334, "text": "Así quedaron terminados los cielos y la tierra, y todo lo que hay en ellos.", "words": [[0, 300], [4, 582], [13, 1102], [24, 1922], [28, 2202], [35, 3022], [37, 3222], [40, 3362], [48, 3762], [50, 4562], [55, 4862], [58, 5142], [62, 5322], [66, 5502], [69, 5742]]}, {"verse": 2, "start": 6784, "end": 15030, "text": "Y acabó Dios en el día séptimo su obra que hizo, y reposó el día séptimo de toda su obra que había hecho.", "words": [[0, 6784], [2, 6902], [8, 7382], [13, 7642], [16, 7902], [19, 8042], [23, 8242], [31, 8882], [34, 9122], [39, 9482], [43, 9682], [49, 10662], [51, 11132], [58, 11602], [61, 11742], [65, 11922], [73, 12702], [76, 13202], [81, 13442], [84, 13762], [89, 14022], [93, 14242], [99, 14482]]}, {"verse": 3, "start": 15480, "end": 24048, "text": "Y bendijo Dios al día séptimo, y lo santificó, porque en él reposó de toda su obra que había Dios creado y hecho.", "words": [[0, 15480], [2, 15601], [10, 16061], [15, 16341], [18, 16641], [22, 16841], [31, 17941], [33, 18201], [36, 18321], [47, 19601], [54, 19981], [57, 20181], [60, 20341], [67, 20941], [70, 21081], [75, 21281], [78, 21621], [83, 21901], [87, 22161], [93, 22421], [98, 22761], [105, 23321], [107, 23521]]}, {"verse": 4, "start": 24498, "end": 33308, "text": "Estos son los orígenes de los cielos y de la tierra cuando fueron creados, el día que Jehová Dios hizo la tierra y los cielos,", "words": [[0, 24498], [6, 24903], [10, 25143], [14, 25323], [23, 26023], [26, 26103], [30, 26243], [37, 26823], [39, 26943], [42, 27043], [45, 27183], [52, 27743], [59, 27923], [66, 28263], [75, 29023], [78, 29963], [82, 30203], [86, 30403], [93, 30903], [98, 31173], [103, 31443], [106, 31603], [113, 31983], [115, 32383], [119, 32543]]}, {"verse": 5, "start": 33758, "end": 48112, "text": "Y toda planta del campo antes que fuese en