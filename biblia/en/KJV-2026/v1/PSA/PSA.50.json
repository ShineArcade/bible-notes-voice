{"book": "PSA", "chapter": 50, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 131424, "verses": [{"verse": 1, "start": 300, "end": 6015, "text": "The mighty God, even the LORD, has spoken, and called the earth from the rising of the sun to the going down of it.", "words": [[0, 300], [4, 403], [11, 603], [16, 1063], [21, 1283], [25, 1483], [31, 1963], [35, 2043], [43, 2443], [47, 2748], [54, 3008], [58, 3208], [64, 3388], [69, 3628], [73, 3768], [80, 4088], [83, 4308], [87, 4448], [91, 4728], [94, 4928], [98, 5068], [104, 5288], [109, 5588], [112, 5808]]}, {"verse": 2, "start": 6365, "end": 9373, "text": "Out of Zion, the perfection of beauty, God has shined.", "words": [[0, 6365], [4, 6507], [7, 6627], [13, 7087], [17, 7127], [28, 7447], [31, 7787], [39, 8067], [43, 8447], [47, 8707]]}, {"verse": 3, "start": 9723, "end": 17789, "text": "Our God shall come, and shall not keep silence: a fire shall devour before him, and it shall be very tempestuous round about him.", "words": [[0, 9723], [4, 9847], [8, 10147], [14, 10387], [20, 11127], [24, 11187], [30, 11387], [34, 11607], [39, 11867], [48, 12922], [50, 13029], [55, 13349], [61, 13609], [68, 14129], [75, 14449], [80, 15209], [84, 15349], [87, 15469], [93, 15629], [96, 15789], [101, 16069], [113, 16809], [119, 17109], [125, 17409]]}, {"verse": 4, "start": 18139, "end": 23020, "text": "He shall call to the heavens from above, and to the earth, that he may judge his people.", "words": [[0, 18139], [3, 18246], [9, 18446], [14, 18726], [17, 18946], [21, 19086], [29, 19406], [34, 19706], [41, 20146], [45, 20766], [48, 20926], [52, 21046], [59, 21366], [64, 21666], [67, 21786], [71, 21926], [77, 22246], [81, 22446]]}, {"verse": 5, "start": 23240, "end": 28610, "text": "Gather my saints together to me; those that have made a covenant with me by sacrifice.", "words": [[0, 23240], [7, 23499], [10, 23759], [17, 24079], [26, 24579], [29, 24799], [33, 25621], [39, 25880], [44, 26140], [49, 262