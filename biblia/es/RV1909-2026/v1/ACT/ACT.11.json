{"book": "ACT", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 247673, "verses": [{"verse": 1, "start": 300, "end": 9563, "text": "Y oyeron los apóstoles y los hermanos que estaban en Judea, que también los Gentiles habían recibido la palabra de Dios.", "words": [[0, 300], [2, 466], [9, 865], [13, 1046], [23, 1806], [25, 2046], [29, 2206], [38, 2866], [42, 2966], [50, 3286], [53, 3506], [60, 4586], [64, 4845], [72, 5285], [76, 5785], [85, 6645], [92, 7305], [101, 8226], [104, 8366], [112, 8766], [115, 9006]]}, {"verse": 2, "start": 10013, "end": 16094, "text": "Y como Pedro subió a Jerusalén, contendían contra él los que eran de la circuncisión,", "words": [[0, 10013], [2, 10130], [7, 10370], [13, 10770], [19, 11350], [21, 11550], [32, 12670], [43, 13410], [50, 13830], [53, 14130], [57, 14310], [61, 14510], [66, 14690], [69, 14850], [72, 14970]]}, {"verse": 3, "start": 16544, "end": 21608, "text": "Diciendo: ¿Por qué has entrado en casa de hombres incircuncisos, y has comido con ellos?", "words": [[0, 16544], [10, 17569], [15, 17689], [19, 17789], [23, 17909], [31, 18289], [34, 18369], [39, 18549], [42, 18749], [50, 19399], [65, 20049], [67, 20389], [71, 20549], [78, 20889], [82, 21109]]}, {"verse": 4, "start": 21958, "end": 27035, "text": "Entonces comenzando Pedro, les declaró por orden lo pasado, diciendo:", "words": [[0, 21958], [9, 22635], [20, 23275], [27, 23595], [31, 23835], [39, 24355], [43, 24535], [49, 24795], [52, 25095], [60, 26215]]}, {"verse": 5, "start": 27285, "end": 39089, "text": "Estaba yo en la ciudad de Jope orando, y vi en éxtasis una visión: un objeto semejante a una gran tela, que descendía, que por sus cuatro extremos era bajado del cielo, y venía hasta mí.", "words": [[0, 27285], [7, 27671], [10, 27831], [13, 27931], [16, 28031], [23, 28331], [26, 28664], [31, 28998], [39, 29331], [41, 29931], [44, 30091], [47, 30231], [55, 30711], [59, 30911], [67, 31815], [70, 31951], [77, 32331], [87, 33071], [89, 33211], [93, 33351], [98, 33591], [104, 33991], [108, 34231], [119, 34891], [123, 35331], [127, 35511], [131, 35671], [138, 35971], [147, 36671], [151, 36871], [158, 37311], [162, 37451], [169, 37871], [171, 38171], [177, 38551], [183, 38771]]}, {"verse": 6, "start": 39539, "end": 47458, "text": "En el cual como puse los ojos, consideré y vi animales terrestres de cuatro pies, y fieras, y reptiles, y aves del cielo.", "words": [[0, 39539], [3, 39660], [6, 39740], [11, 39980], [16, 40240], [21, 40600], [25, 40740], [31, 41140], [41, 41860], [43, 42020], [46, 42160], [55, 42520], [66, 43340], [69, 43440], [76, 43680], [82, 44040], [84, 44620], [92, 45180], [94, 45480], [104, 46060], [106, 46560], [111, 46820], [115, 46980]]}, {"verse": 7, "start": 47908, "end": 52505, "text": "Y oí una voz que me decía: Levántate, Pedro, mata y come.", "words": [[0, 47908], [2, 48095], [5, 48275], [9, 48475], [13, 48715], [17, 48875], [20, 48995], [27, 49875], [38, 50673], [45, 51193], [50, 51433], [52, 51753]]}, {"verse": 8, "start": 52855, "end": 58624, "text": "Y dije: Señor, no; porque ninguna cosa común o inmunda entró jamás en mi boca.", "words": [[0, 52855], [2, 53021], [8, 53763], [15, 54078], [19, 54850], [26, 55051], [34, 55371], [39, 55831], [45, 56251], [47, 56491], [55, 57011], [61, 57571], [67, 57891], [70, 58031], [73, 58131]]}, {"verse": 9, "start": 59074, "end": 65500, "text": "Entonces la voz me respondió del cielo segunda vez: Lo que Dios limpió, no lo llames tú común.", "words": [[0, 59074], [9, 59476], [12, 59756], [16, 59956], [19, 60136], [29, 60656], [33, 60796], [39, 61076], [47, 61416], [52, 62272], [55, 62387], [59, 62527], [64, 62807], [72, 63787], [75, 63967], [78, 64107], [85, 64547], [88, 64647]]}, {"verse": 10, "start": 65800, "end": 70523, "text": "Y esto fue hecho por tres veces: y volvió todo a ser tomado arriba en el cielo.", "words": [[0, 65800], [2, 65938], [7, 66178], [11, 66418], [17, 66638], [21, 66878], [26, 67098], [33, 68067], [35, 68170], [42, 68510], [47, 68710], [49, 68910], [53, 69030], [60, 69450], [67, 69670], [70, 69910], [73, 70010]]}, {"verse": 11, "start": 70973, "end": 76745, "text": "Y he aquí, de inmediato llegaron tres hombres a la casa donde yo estaba, enviados a mí de Cesarea.", "words": [[0, 70973], [2, 71120], [5, 71260], [11, 71460], [14, 71620], [24, 72160], [33, 72600], [38, 72880], [46, 73260], [48, 73480], [51, 73560], [56, 73840], [62, 74100], [65, 74380], [73, 75140], [82, 75640], [84, 75820], [87, 75980], [90, 76100]]}, {"verse": 12, "start": 77195, "end": 84720, "text": "Y el Espíritu me dijo que fuese con ellos sin dudar. Y vinieron también conmigo estos seis hermanos, y entramos en casa de un varón,", "words": [[0, 77195], [2, 77293], [5, 77373], [14, 77893], [17, 77993], [22, 78213], [26, 78393], [32, 78713], [36, 78933], [42, 79133], [46, 79393], [53, 80206], [55, 80325], [64, 80725], [72, 81085], [80, 81605], [86, 81825], [91, 82105], [101, 82945], [103, 83105], [112, 83525], [115, 83705], [120, 83885], [123, 84125], [126, 84225]]}, {"verse": 13, "start": 85170, "end": 93795, "text": "El cual nos contó cómo había visto un ángel en su casa, que se paró, y le dijo: Envía a Jope, y haz venir a un Simón que tiene por sobrenombre Pedro;", "words": [[0, 85170], [3, 85296], [8, 85496], [12, 85696], [18, 86136], [23, 86296], [29, 86496], [35, 86816], [38, 86996], [44, 87316], [47, 87416], [50, 87516], [56, 88136], [60, 88196], [63, 88356], [69, 88736], [71, 89036], [74, 89136], [80, 89884], [86, 90243], [88, 90533], [94, 90823], [96, 91030], [100, 91236], [106, 91443], [108, 91523], [111, 91563], [117, 91963], [121, 92103], [127, 92323], [131, 92583], [143, 93263]]}, {"verse": 14, "start": 94245, "end": 99329, "text": "El cual te hablará palabras por las cuales serás salvo tú, y toda tu casa.", "words": [[0, 94245], [3, 94401], [8, 94601], [11, 94821], [19, 95181], [28, 95501], [32, 95841], [36, 96021], [43, 96281], [49, 96681], [55, 97041], [59, 97221], [61, 97641], [66, 97861], [69, 98081]]}, {"verse": 15, "start": 99779, "end": 106247, "text": "Y como comencé a hablar, cayó el Espíritu Santo sobre ellos también, como sobre nosotros al principio.", "words": [[0, 99779], [2, 99898], [7, 100098], [15, 100658], [17, 100798], [25, 101578], [30, 101978], [33, 102058], [42, 102538], [48, 102778], [54, 103158], [60, 103378], [69, 104398], [74, 104538], [80, 104818], [89, 105178], [92, 105478]]}, {"verse": 16, "start": 106697, "end": 116252, "text": "Entonces me acordé del dicho del Señor, como dijo: Juan ciertamente bautizó en agua; pero vosotros seréis bautizados en Espíritu Santo.", "words": [[0, 106697], [9, 107018], [12, 107258], [19, 107678], [23, 107818], [29, 108018], [33, 108198], [40, 108758], [45, 108858], [51, 109734], [56, 110124], [68, 111364], [76, 111984], [79, 112124], [85, 112938], [90, 113082], [99, 113622], [106, 114122], [117, 114902], [120, 115102], [129, 115642]]}, {"verse": 17, "start": 116552, "end": 124600, "text": "Así que, si Dios les dio el mismo don también como a nosotros que hemos creído en el Señor Jesucristo, ¿quién era yo que pudiese estorbar a Dios?", "words": [[0, 116552], [4, 116711], [9, 116891], [12, 117031], [17, 117291], [21, 117491], [25, 117711], [28, 117831], [34, 118191], [38, 118411], [46, 118831], [51, 119151], [53, 119311], [62, 119671], [66, 119971], [72, 120131], [79, 120631], [82, 120751], [85, 120871], [91, 121111], [103, 122351], [110, 122551], [114, 122711], [117, 122891], [121, 123051], [129, 123511], [138, 124031], [140, 124131]]}, {"verse": 18, "start": 124950, "end": 135840, "text": "Entonces, oídas estas cosas, callaron, y glorificaron a Dios, diciendo: De manera que también a los Gentiles ha dado Dios arrepentimiento para vida.", "words": [[0, 124950], [10, 125818], [16, 126398], [22, 126598], [29, 127058], [39, 128138], [41, 128858], [54, 129578], [56, 129718], [62, 129958], [72, 131507], [75, 131604], [82, 131804], [86, 132064], [94, 132324], [96, 132544], [100, 132684], [109, 133264], [112, 133644], [117, 133864], [122, 134164], [138, 135164], [143, 135424]]}, {"verse": 19, "start": 136190, "end": 149470, "text": "Y los que habían sido esparcidos por causa de la tribulación que sobrevino en tiempo de Esteban, anduvieron hasta Fenicia, y Chipre, y Antioquía, no hablando a nadie la palabra, sino sólo a los judíos.", "words": [[0, 136190], [2, 136292], [6, 136412], [10, 136552], [17, 136752], [22, 137112], [33, 137712], [37, 137932], [43, 138252], [46, 138492], [49, 138612], [61, 139312], [65, 139472], [75, 140112], [78, 140272], [85, 140572], [88, 140792], [97, 141732], [108, 142452], [114, 142652], [123, 143352], [125, 143592], [133, 144172], [135, 144352], [146, 145432], [149, 145652], [158, 146112], [160, 146332], [166, 146592], [169, 146752], [178, 147736], [183, 147981], [188, 148361], [190, 148561], [194, 148661]]}, {"verse": 20, "start": 149920, "end": 160452, "text": "Y de ellos había unos varones Ciprios y Cirenenses, los cuales como entraron en Antioquía, hablaron a los griegos, anunciando el evangelio del Señor Jesús.", "words": [[0, 149920], [2, 150050], [5, 150190], [11, 150490], [17, 150870], [22, 151210], [30, 151670], [38, 152350], [40, 153050], [52, 153750], [56, 153810], [63, 154230], [68, 154430], [77, 155070], [80, 155310], [91, 156310], [100, 156890], [102, 157070], [106, 157190], [115, 157710], [126, 158510], [129, 158630], [139, 159270], [143, 159430], [149, 159690]]}, {"verse": 21, "start": 160902, "end": 167352, "text": "Y la mano del Señor era con ellos: y creyendo, gran número se convirtió al Señor.", "words": [[0, 160902], [2, 161010], [5, 161130], [10, 161370], [14, 161590], [20, 161990], [24, 162410], [28, 162670], [35, 163665], [37, 163792], [47, 164792], [52, 165072], [59, 165532], [62, 165872], [72, 166592], [75, 166752]]}, {"verse": 22, "start": 167802, "end": 177129, "text": "Y llegó la noticia de estas cosas a oídos de la iglesia que estaba en Jerusalén: y enviaron a Bernabé que fuese hasta Antioquía.", "words": [[0, 167802], [2, 167906], [8, 168166], [11, 168326], [19, 168906], [22, 169066], [28, 169226], [34, 169706], [36, 170266], [42, 170926], [45, 171106], [48, 171246], [56, 171746], [60, 171926], [67, 172226], [70, 172406], [81, 173553], [83, 173690], [92, 174270], [94, 174450], [102, 174950], [106, 175050], [112, 175530], [118, 176030]]}, {"verse": 23, "start": 177579, "end": 189090, "text": "El cual, cuando llegó, y vio la gracia de Dios, se regocijó; y exhortó a todos a que permaneciesen en el propósito del corazón en el Señor.", "words": [[0, 177579], [3, 177748], [9, 177968], [16, 178228], [23, 179088], [25, 179348], [29, 179568], [32, 179728], [39, 180188], [42, 180328], [48, 181120], [51, 181912], [61, 182956], [63, 183098], [71, 183998], [73, 184178], [79, 184578], [81, 184898], [85, 184998], [99, 186158], [102, 186358], [105, 186498], [115, 187238], [119, 187458], [127, 187978], [130, 188318], [133, 188458]]}, {"verse": 24, "start": 189540, "end": 196667, "text": "Porque era varón bueno, y lleno de Espíritu Santo y de fe: y muchas personas fueron agregadas al Señor.", "words": [[0, 189540], [7, 189784], [11, 189984], [17, 190304], [24, 190704], [26, 191444], [32, 191764], [35, 191884], [44, 192424], [50, 192804], [52, 192924], [55, 193024], [59, 193668], [61, 193868], [68, 194108], [77, 194628], [84, 194928], [94, 195748], [97, 196008]]}, {"verse": 25, "start": 197117, "end": 202800, "text": "Después fue Bernabé a Tarso a buscar a Saulo; y hallado, le trajo a Antioquía.", "words": [[0, 197117], [8, 197345], [12, 197625], [20, 198165], [22, 198305], [28, 198805], [30, 198925], [37, 199205], [39, 199425], [46, 200306], [48, 200455], [57, 200915], [60, 201315], [66, 201775], [68, 201875]]}, {"verse": 26, "start": 203250, "end": 213553, "text": "Y se reunieron allí con la iglesia durante todo un año, y enseñaron a mucha gente; y los discípulos fueron llamados Cristianos primeramente en Antioquía.", "words": [[0, 203250], [2, 203396], [5, 203536], [15, 204336], [20, 204596], [24, 204836], [27, 204996], [35, 205416], [43, 205636], [48, 206136], [51, 206416], [56, 206776], [58, 207296], [68, 208116], [70, 208216], [76, 208456], [83, 209517], [85, 209639], [89, 209779], [100, 210399], [107, 210759], [116, 211299], [127, 211839], [140, 212659], [143, 212759]]}, {"verse": 27, "start": 214003, "end": 218249, "text": "Y en aquellos días descendieron de Jerusalén profetas a Antioquía.", "words": [[0, 214003], [2, 214111], [5, 214324], [14, 214538], [19, 214751], [32, 215391], [35, 215571], [45, 216251], [54, 217051], [56, 217271]]}, {"verse": 28, "start": 218699, "end": 231364, "text": "Y levantándose uno de ellos, llamado Agabo, daba a entender por Espíritu, que había de haber una grande hambre en toda la tierra habitada: la cual hubo en tiempo de Claudio.", "words": [[0, 218699], [2, 218824], [15, 219684], [19, 219924], [22, 220124], [29, 220944], [37, 221244], [44, 222464], [49, 222884], [51, 223084], [60, 223584], [64, 223984], [74, 225124], [78, 225304], [84, 225544], [87, 225764], [93, 225904], [97, 226144], [104, 226524], [111, 226984], [114, 227204], [119, 227424], [122, 227624], [129, 227904], [139, 229198], [142, 229326], [147, 229526], [152, 229986], [155, 230086], [162, 230406], [165, 230892]]}, {"verse": 29, "start": 231814, "end": 240750, "text": "Entonces los discípulos, cada uno conforme a lo que tenía, determinaron enviar ayuda a los hermanos que habitaban en Judea:", "words": [[0, 231814], [9, 232776], [13, 233036], [25, 233656], [30, 233916], [34, 234296], [43, 235056], [45, 235136], [48, 235216], [52, 235336], [59, 235756], [72, 237056], [79, 237816], [85, 238336], [87, 238756], [91, 238856], [100, 239396], [104, 239516], [114, 239996], [117, 240176]]}, {"verse": 30, "start": 241200, "end": 247273, "text": "Lo cual asimismo hicieron, enviándolo a los ancianos por mano de Bernabé y de Saulo.", "words": [[0, 241200], [3, 241326], [8, 241776], [17, 242226], [27, 242906], [38, 244066], [40, 244286], [44, 244446], [53, 245066], [57, 245286], [62, 245586], [65, 245766], [73, 246326], [75, 246506], [78, 246666]]}]}