{"book": "GEN", "chapter": 24, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 594994, "verses": [{"verse": 1, "start": 300, "end": 7042, "text": "Y Abraham era viejo, y bien entrado en días; y Jehová había bendecido a Abraham en todo.", "words": [[0, 300], [2, 444], [10, 784], [14, 1164], [21, 1744], [23, 2284], [28, 2544], [36, 3104], [39, 3224], [45, 4124], [47, 4249], [54, 4709], [60, 4989], [70, 5769], [72, 5929], [80, 6269], [83, 6549]]}, {"verse": 2, "start": 7492, "end": 17314, "text": "Y dijo Abraham a un criado suyo, el más viejo de su casa, que era el que gobernaba en todo lo que tenía: Pon ahora tu mano debajo de mi muslo,", "words": [[0, 7492], [2, 7599], [7, 7899], [15, 8319], [17, 8579], [20, 8699], [27, 9199], [33, 10159], [36, 10339], [40, 10539], [46, 11059], [49, 11179], [52, 11339], [58, 12179], [62, 12319], [66, 12519], [69, 12679], [73, 12819], [83, 13519], [86, 13739], [91, 13979], [94, 14199], [98, 14319], [105, 15169], [109, 15313], [115, 15573], [118, 15793], [123, 16033], [130, 16493], [133, 16633], [136, 16753]]}, {"verse": 3, "start": 17764, "end": 27760, "text": "Y te juramentaré por Jehová, Dios de los cielos y Dios de la tierra, que no has de tomar mujer para mi hijo de las hijas de los cananeos, entre los cuales yo habito;", "words": [[0, 17764], [2, 17868], [5, 17988], [17, 18688], [21, 18888], [29, 19808], [34, 20128], [37, 20328], [41, 20468], [48, 20928], [50, 21048], [55, 21248], [58, 21368], [61, 21468], [69, 22188], [73, 22308], [76, 22488], [80, 22608], [83, 22708], [89, 22968], [95, 23268], [100, 23568], [103, 23788], [108, 23988], [111, 24128], [115, 24288], [121, 24608], [124, 24708], [128, 24828], [138, 25928], [144, 26152], [148, 26312], [155, 26572], [158, 26852]]}, {"verse": 4, "start": 28210, "end": 33086, "text": "Sino que irás a mi tierra y a mi parentela, y tomarás mujer para mi hijo Isaac.", "words": [[0, 28210], [5, 28405], [9, 28625], [14, 28945], [16, 29065], [19, 29185], [26, 29505], [28, 29705], [30, 29765], [33, 29845], [44, 30525], [46, 30965], [54, 31405], [60, 31665], [65, 32025], [68, 32225], [73, 32465]]}, {"verse": 5, "start": 33436, "end": 41801, "text": "Y el criado le respondió: Quizá la mujer no querrá venir en pos de mí a esta tierra: ¿volveré, pues, tu hijo a la tierra de donde saliste?", "words": [[0, 33436], [2, 33558], [5, 33658], [12, 34178], [15, 34338], [26, 35454], [32, 35818], [35, 35918], [41, 36158], [44, 36398], [51, 36738], [57, 36998], [60, 37218], [64, 37358], [67, 37558], [70, 37778], [72, 37898], [77, 38118], [85, 39043], [95, 39584], [101, 39984], [104, 40044], [109, 40224], [111, 40364], [114, 40424], [121, 40684], [124, 40884], [130, 41044]]}, {"verse": 6, "start": 42151, "end": 47164, "text": "Y Abraham le dijo: Guárdate que no lleves otra vez a mi hijo allá.", "words": [[0, 42151], [2, 42319], [10, 42699], [13, 43019], [19, 43788], [28, 44224], [32, 44424], [35, 44564], [42, 44844], [47, 45064], [51, 45364], [53, 45604], [56, 45764], [61, 46004]]}, {"verse": 7, "start": 47614, "end": 62367, "text": "Jehová, Dios de los cielos, que me tomó de la casa de mi padre y de la tierra de mi parentela, y me habló y me juró, diciendo: A tu descendencia daré esta tierra; él enviará su ángel delante de ti, y tú tomarás de allá mujer para mi hijo.", "words": [[0, 47614], [8, 48186], [13, 48446], [16, 48686], [20, 48826], [28, 49526], [32, 49586], [35, 49686], [40, 50006], [43, 50086], [46, 50206], [51, 50486], [54, 50686], [57, 50786], [63, 51246], [65, 51326], [68, 51406], [71, 51506], [78, 51786], [81, 52006], [84, 52106], [95, 53266], [97, 53306], [100, 53426], [106, 53826], [108, 53906], [111, 54026], [117, 54406], [127, 55456], [129, 55557], [132, 55677], [145, 56417], [150, 56717], [155, 56877], [163, 57697], [166, 57842], [174, 58282], [177, 58462], [183, 58822], [191, 59242], [194, 59382], [198, 59662], [200, 60142], [203, 60262], [211, 60762], [214, 60902], [219, 61062], [225, 61402], [230, 61742], [233, 61922]]}, {"verse": 8, "start": 62817, "end": 70415, "text": "Y si la mujer no quiere venir en pos de ti, serás libre de este mi juramento; solamente que no lleves otra vez allá a mi hijo.", "words": [[0, 62817], [2, 62898], [5, 63018], [8, 63138], [14, 63358], [17, 63598], [24, 63798], [30, 64118], [33, 64298], [37, 64478], [40, 64678], [44, 65098], [50, 65458], [56, 65738], [59, 65978], [64, 66178], [67, 66358], [78, 67465], [88, 67848], [92, 68188], [95, 68348], [102, 68748], [107, 68968], [111, 69328], [116, 69628], [118, 69868], [121, 69968]]}, {"verse": 9, "start": 70765, "end": 78690, "text": "Entonces el criado puso su mano debajo del muslo de Abraham su señor, y le juró sobre este negocio.", "words": [[0, 70765], [9, 71308], [12, 71668], [19, 72168], [24, 72588], [27, 72788], [32, 73088], [39, 73528], [43, 73768], [49, 74268], [52, 74428], [60, 75468], [63, 75668], [70, 76748], [72, 76828], [75, 76968], [80, 77368], [86, 77588], [91, 77868]]}, {"verse": 10, "start": 79140, "end": 93550, "text": "Y el criado tomó diez camellos de los camellos de su señor, y se fue, pues tenía a su disposición todos los bienes de su señor: y puesto en camino, llegó a Mesopotamia, a la ciudad de Nacor.", "words": [[0, 79140], [2, 79440], [5, 79540], [12, 80020], [17, 80460], [22, 80800], [31, 81560], [34, 81680], [38, 81780], [47, 82280], [50, 82360], [53, 82500], [60, 82900], [62, 83440], [65, 83580], [70, 84240], [75, 84570], [81, 84900], [83, 85080], [86, 85240], [98, 86060], [104, 86580], [108, 86880], [115, 87360], [118, 87540], [121, 87720], [128, 88660], [130, 88780], [137, 89020], [140, 89200], [148, 90160], [154, 90560], [156, 90740], [169, 91960], [171, 92160], [174, 92240], [181, 92580], [184, 93083]]}, {"verse": 11, "start": 94000, "end": 104722, "text": "E hizo arrodillar los camellos fuera de la ciudad, junto a un pozo de agua, a la hora de la tarde, a la hora en que salen las doncellas por agua.", "words": [[0, 94000], [2, 94442], [7, 94702], [18, 95402], [22, 95792], [31, 96182], [37, 96522], [40, 96742], [43, 96862], [51, 97242], [57, 97802], [59, 98042], [62, 98142], [67, 98482], [70, 98662], [76, 99022], [78, 99662], [81, 99802], [86, 100082], [89, 100242], [92, 100382], [99, 101695], [101, 101878], [104, 101998], [109, 102318], [112, 102518], [116, 102638], [122, 103118], [126, 103318], [136, 104058], [140, 104238]]}, {"verse": 12, "start": 105172, "end": 112522, "text": "Y dijo: Jehová, Dios de mi señor Abraham, te ruego que hoy me vaya bien y muestres misericordia a mi señor Abraham.", "words": [[0, 105172], [2, 105319], [8, 106086], [16, 106578], [21, 106718], [24, 106918], [27, 107305], [33, 107691], [42, 108078], [45, 108318], [51, 108598], [55, 108798], [59, 108978], [62, 109138], [67, 109358], [72, 109698], [74, 109978], [83, 110638], [96, 111298], [98, 111498], [101, 111858], [107, 112218]]}, {"verse": 13, "start": 112972, "end": 118878, "text": "He aquí yo estoy junto a la fuente de agua, y las hijas de los varones de esta ciudad salen por agua:", "words": [[0, 112972], [3, 113111], [8, 113351], [11, 113511], [17, 113711], [23, 113911], [25, 114111], [28, 114151], [35, 114451], [38, 114611], [44, 114871], [46, 115311], [50, 115471], [56, 115791], [59, 115891], [63, 115991], [71, 116411], [74, 116591], [79, 116751], [86, 117091], [92, 117711], [96, 117891]]}, {"verse": 14, "start": 119328, "end": 136498, "text": "Sea, pues, que la doncella a quien yo diga: Baja tu cántaro, te ruego, para que yo beba; y ella responda: Bebe, y también daré de beber a tus camellos: que sea esta la que tú has destinado para tu siervo Isaac; y en esto conoceré que habrás hecho misericordia con mi señor.", "words": [[0, 119328], [5, 119328], [11, 119328], [15, 119409], [18, 119509], [27, 120009], [29, 120109], [35, 120229], [38, 120409], [44, 122069], [49, 122436], [52, 122596], [61, 122943], [64, 123289], [71, 123636], [76, 123936], [80, 124096], [83, 124236], [89, 125025], [91, 125165], [96, 125285], [106, 126617], [112, 126887], [114, 127027], [122, 127287], [127, 127727], [130, 127807], [136, 128047], [138, 128207], [142, 128347], [152, 129422], [156, 129522], [160, 129742], [165, 130082], [168, 130242], [172, 130402], [175, 130562], [179, 130742], [189, 131322], [194, 131522], [197, 131802], [204, 132082], [211, 133346], [213, 133462], [216, 133542], [221, 133762], [230, 134322], [234, 134442], [241, 134762], [247, 134962], [260, 135702], [264, 135882], [267, 136002]]}, {"verse": 15, "start": 136848, "end": 150320, "text": "Y aconteció que antes que él acabase de hablar, he aquí Rebeca, que había nacido a Betuel, hijo de Milca, mujer de Nacor hermano de Abraham, la cual salía con su cántaro sobre su hombro.", "words": [[0, 136848], [2, 136991], [12, 137691], [16, 138091], [22, 138491], [26, 138811], [29, 139131], [37, 139831], [40, 140011], [48, 140831], [51, 140951], [56, 141631], [64, 142311], [68, 142391], [74, 142571], [81, 143031], [83, 143171], [91, 143991], [96, 144151], [99, 144541], [106, 144931], [112, 145111], [115, 145411], [121, 145711], [129, 146111], [132, 146231], [141, 147114], [144, 147259], [149, 147479], [155, 147979], [159, 148199], [162, 148439], [170, 149039], [176, 149399], [179, 149639]]}, {"verse": 16, "start": 150770, "end": 161930, "text": "Y la doncella era de muy hermoso aspecto, virgen, a la que varón no había conocido; la cual descendió a la fuente, y llenó su cántaro, y se volvía.", "words": [[0, 150770], [2, 151018], [5, 151388], [14, 151758], [18, 151938], [21, 152118], [25, 152318], [33, 152898], [42, 153578], [50, 154678], [52, 154758], [55, 154858], [59, 155168], [65, 155478], [68, 155858], [74, 156258], [84, 157540], [87, 157665], [92, 157905], [102, 158545], [104, 158665], [107, 158745], [115, 159245], [117, 159785], [123, 160145], [126, 160285], [135, 160925], [137, 161065], [140, 161205]]}, {"verse": 17, "start": 162380, "end": 169054, "text": "Entonces el criado corrió hacia ella, y dijo: Te ruego que me des a beber un poco de agua de tu cántaro.", "words": [[0, 162380], [9, 163300], [12, 163500], [19, 163920], [26, 164380], [32, 164620], [38, 165020], [40, 165240], [46, 166020], [49, 166139], [55, 166439], [59, 166599], [62, 166739], [66, 166939], [68, 167079], [74, 167279], [77, 167519], [82, 167759], [85, 167979], [90, 168199], [93, 168359], [96, 168479]]}, {"verse": 18, "start": 169404, "end": 177087, "text": "Y ella respondió: Bebe, señor mío: y se dio prisa a bajar su cántaro sobre su mano, y le dio a beber.", "words": [[0, 169404], [2, 169565], [7, 169805], [18, 171033], [24, 171203], [30, 171503], [35, 172432], [37, 172533], [40, 172673], [44, 172873], [50, 173333], [52, 173493], [58, 173873], [61, 174033], [69, 174613], [75, 174953], [78, 175193], [84, 175573], [86, 176093], [89, 176213], [93, 176473], [95, 176633]]}, {"verse": 19, "start": 177537, "end": 184554, "text": "Y cuando acabó de darle a beber, dijo: También para tus camellos sacaré agua, hasta que acaben de beber.", "words": [[0, 177537], [2, 177643], [9, 177843], [15, 178423], [18, 178523], [24, 178823], [26, 179043], [33, 179703], [39, 180615], [47, 180935], [52, 181195], [56, 181375], [65, 181975], [72, 182355], [78, 182735], [84, 183335], [88, 183535], [95, 183955], [98, 184055]]}, {"verse": 20, "start": 184904, "end": 194128, "text": "Y se dio prisa, y vació su cántaro en la pila, y corrió otra vez al pozo para sacar agua, y sacó para todos sus camellos.", "words": [[0, 184904], [2, 185048], [5, 185148], [9, 185348], [16, 186268], [18, 186348], [24, 186708], [27, 186868], [35, 187428], [38, 187588], [41, 187728], [47, 188588], [49, 188768], [56, 189208], [61, 189528], [65, 189808], [68, 190088], [73, 190628], [78, 191048], [84, 191268], [90, 191688], [92, 192128], [97, 192528], [102, 192728], [108, 193008], [112, 193348]]}, {"verse": 21, "start": 194578, "end": 202529, "text": "Y el hombre estaba maravillado de ella, callando, para saber si Jehová había prosperado o no su viaje.", "words": [[0, 194578], [2, 194708], [5, 194828], [12, 195088], [19, 195448], [31, 196268], [34, 196468], [40, 197268], [50, 198028], [55, 198768], [61, 199148], [64, 199388], [71, 199968], [77, 200308], [88, 201328], [90, 201528], [93, 201668], [96, 201868]]}, {"verse": 22, "start": 202979, "end": 213377, "text": "Y aconteció que como los camellos acabaron de beber, le presentó el hombre un pendiente de oro que pesaba medio siclo, y dos brazaletes que pesaban diez:", "words": [[0, 202979], [2, 203155], [12, 203975], [16, 204235], [21, 204495], [25, 204675], [34, 205295], [43, 205795], [46, 205975], [53, 206675], [56, 206815], [65, 207375], [68, 207495], [75, 207735], [78, 207955], [88, 208555], [91, 208815], [95, 209035], [99, 209215], [106, 209675], [112, 210205], [119, 210735], [121, 211235], [125, 211415], [136, 212095], [140, 212275], [148, 212775]]}, {"verse": 23, "start": 213827, "end": 220196, "text": "Y dijo: ¿De quién eres hija? Te ruego me digas, ¿hay lugar en casa de tu padre donde podamos hospedarnos?", "words": [[0, 213827], [2, 213973], [8, 214741], [12, 214900], [18, 215060], [23, 215320], [29, 216132], [32, 216231], [38, 216571], [41, 216631], [48, 217311], [53, 217431], [59, 217631], [62, 217831], [67, 218011], [70, 218191], [73, 218311], [79, 218591], [85, 218831], [93, 219311]]}, {"verse": 24, "start": 220546, "end": 226814, "text": "Y ella respondió: Soy hija de Betuel, hijo de Milca, el cual parió ella a Nacor.", "words": [[0, 220546], [2, 220708], [7, 220948], [18, 222006], [22, 222286], [27, 222866], [30, 222946], [38, 223806], [43, 224046], [46, 224576], [53, 225106], [56, 225206], [61, 225426], [67, 225886], [72, 226218], [74, 226551]]}, {"verse": 25, "start": 227164, "end": 232849, "text": "Y añadió: También hay en nuestra casa paja y mucho forraje, y lugar para posar.", "words": [[0, 227164], [2, 227286], [10, 228201], [18, 228464], [22, 228704], [25, 228824], [33, 228984], [38, 229344], [43, 229944], [45, 230204], [51, 230524], [60, 231204], [62, 231644], [68, 231924], [73, 232244]]}, {"verse": 26, "start": 233199, "end": 237539, "text": "El hombre entonces se inclinó, y adoró a Jehová.", "words": [[0, 233199], [3, 233329], [10, 233669], [19, 234269], [22, 234789], [31, 235869], [33, 236129], [39, 236749], [41, 236909]]}, {"verse": 27, "start": 237989, "end": 248346, "text": "Y dijo: Bendito sea Jehová, Dios de mi amo Abraham, que no apartó su misericordia y su verdad de mi amo, guiándome Jehová en el camino a casa de los hermanos de mi amo.", "words": [[0, 237989], [2, 238135], [8, 238903], [16, 239402], [20, 239622], [28, 240122], [33, 240342], [36, 240602], [39, 240762], [43, 240962], [52, 241822], [56, 242022], [59, 242202], [66, 242642], [69, 242762], [82, 243602], [84, 243782], [87, 243942], [94, 244202], [97, 244402], [100, 244562], [105, 245204], [115, 245711], [122, 246111], [125, 246171], [128, 246291], [135, 246591], [137, 246791], [142, 246951], [145, 247171], [149, 247271], [158, 247771], [161, 247871], [164, 247991]]}, {"verse": 28, "start": 248696, "end": 253913, "text": "Y la doncella corrió, e hizo saber en casa de su madre estas cosas.", "words": [[0, 248696], [2, 248823], [5, 248943], [14, 249483], [22, 250043], [24, 250943], [29, 251223], [35, 251583], [38, 251803], [43, 252083], [46, 252323], [49, 252483], [55, 252783], [61, 253083]]}, {"verse": 29, "start": 254363, "end": 261039, "text": "Y Rebeca tenía un hermano que se llamaba Labán, el cual corrió afuera al hombre, a la fuente;", "words": [[0, 254363], [2, 254744], [9, 255164], [15, 255584], [18, 255744], [26, 256244], [30, 256324], [33, 256464], [41, 256904], [48, 257764], [51, 257844], [56, 258104], [63, 258664], [70, 259284], [73, 259544], [81, 260244], [83, 260344], [86, 260444]]}, {"verse": 30, "start": 261489, "end": 274620, "text": "Y aconteció que como vio el pendiente y los brazaletes en las manos de su hermana, que decía, Así me habló aquel hombre; vino a él: y he aquí que estaba junto a los camellos a la fuente.", "words": [[0, 261489], [2, 261612], [12, 262332], [16, 262652], [21, 262832], [25, 263152], [28, 263292], [38, 264112], [40, 264252], [44, 264392], [55, 265112], [58, 265352], [62, 265512], [68, 265832], [71, 266032], [74, 266172], [83, 266992], [87, 267072], [94, 267972], [98, 268172], [101, 268412], [107, 268752], [113, 269052], [121, 270053], [126, 270263], [128, 270383], [132, 271084], [134, 271291], [137, 271411], [142, 271731], [146, 271911], [153, 272231], [159, 272551], [161, 272791], [165, 272891], [174, 273551], [176, 273711], [179, 273811]]}, {"verse": 31, "start": 275070, "end": 282546, "text": "Y le dijo: Ven, bendito de Jehová; ¿por qué estás fuera? yo he limpiado la casa, y el lugar para los camellos.", "words": [[0, 275070], [2, 275192], [5, 275312], [11, 276266], [16, 276509], [24, 277049], [27, 277399], [35, 278034], [40, 278150], [44, 278290], [50, 278450], [57, 279339], [60, 279516], [63, 279636], [72, 280076], [75, 280196], [81, 280516], [83, 280996], [86, 281136], [92, 281376], [97, 281656], [101, 281836]]}, {"verse": 32, "start": 282896, "end": 295538, "text": "Entonces el hombre vino a casa, y Labán desató los camellos; y les dio paja y forraje, y agua para lavar los pies de él, y los pies de los hombres que con él venían.", "words": [[0, 282896], [9, 283400], [12, 284280], [19, 284540], [24, 284860], [26, 285040], [32, 285360], [34, 285900], [40, 286440], [47, 287160], [51, 287340], [61, 288433], [63, 288594], [67, 288734], [71, 288994], [76, 289554], [78, 289934], [87, 290314], [89, 290814], [94, 291134], [99, 291414], [105, 291874], [109, 292274], [114, 292494], [117, 292734], [121, 292994], [123, 293414], [127, 293554], [132, 293734], [135, 293854], [139, 293954], [147, 294294], [151, 294514], [155, 294714], [158, 294834]]}, {"verse": 33, "start": 295988, "end": 303623, "text": "Y le pusieron comida delante; mas él dijo: No comeré hasta que haya dicho mi mensaje. Y él le dijo: Habla.", "words": [[0, 295988], [2, 296077], [5, 296177], [14, 296597], [21, 297233], [30, 298106], [34, 298272], [37, 298666], [43, 299289], [46, 299434], [53, 299834], [59, 300154], [63, 300354], [68, 300514], [74, 300774], [77, 300934], [86, 301943], [88, 302110], [91, 302250], [94, 302410], [100, 303415]]}, {"verse": 34, "start": 303973, "end": 306833, "text": "Entonces dijo: Yo soy criado de Abraham;", "words": [[0, 303973], [9, 304418], [15, 305377], [18, 305503], [22, 305663], [29, 306083], [32, 306223]]}, {"verse": 35, "start": 307283, "end": 315814, "text": "Y Jehová ha bendecido mucho a mi amo, y él se ha engrandecido: y le ha dado ovejas y vacas, plata y oro, siervos y siervas, camellos y asnos.", "words": [[0, 307283], [2, 307386], [9, 307806], [12, 307866], [22, 308326], [28, 308566], [30, 308746], [33, 308886], [38, 309106], [40, 309446], [43, 309586], [46, 309746], [49, 309846], [63, 310920], [65, 311026], [68, 311126], [71, 311246], [76, 311426], [83, 311826], [85, 311986], [92, 312586], [98, 312886], [100, 313106], [105, 313466], [113, 313866], [115, 314006], [124, 314646], [133, 315126], [135, 315246]]}, {"verse": 36, "start": 316264, "end": 321683, "text": "Y Sara, mujer de mi amo, parió en su vejez un hijo a mi señor, quien le ha dado todo cuanto tiene.", "words": [[0, 316264], [2, 316363], [8, 316743], [14, 316923], [17, 317163], [20, 317263], [25, 317663], [31, 317963], [34, 318063], [37, 318293], [43, 318523], [46, 318753], [51, 318983], [53, 319083], [56, 319163], [63, 319843], [69, 320083], [72, 320283], [75, 320363], [80, 320563], [85, 320823], [92, 321103]]}, {"verse": 37, "start": 322133, "end": 329279, "text": "Y mi amo me hizo jurar, diciendo: No tomarás mujer para mi hijo de las hijas de los cananeos, en cuya tierra habito;", "words": [[0, 322133], [2, 322256], [5, 322376], [9, 322536], [12, 322736], [17, 322916], [24, 323356], [34, 324344], [37, 324487], [45, 324987], [51, 325287], [56, 325587], [59, 325787], [64, 326027], [67, 326167], [71, 326327], [77, 326667], [80, 326767], [84, 326887], [94, 327967], [97, 328067], [102, 328347], [109, 328567]]}, {"verse": 38, "start": 329729, "end": 334743, "text": "Sino que irás a la casa de mi padre, y a mi parentela, y tomarás mujer para mi hijo.", "words": [[0, 329729], [5, 329929], [9, 330129], [14, 330469], [16, 330569], [19, 330649], [24, 330889], [27, 331089], [30, 331209], [37, 331529], [39, 331869], [41, 331929], [44, 332029], [55, 332669], [57, 333149], [65, 333589], [71, 333829], [76, 334149], [79, 334349]]}, {"verse": 39, "start": 335193, "end": 338091, "text": "Y yo dije: Quizás la mujer no querrá seguirme.", "words": [[0, 335193], [2, 335320], [5, 335420], [11, 336184], [18, 336571], [21, 336731], [27, 336951], [30, 337191], [37, 337511]]}, {"verse": 40, "start": 338541, "end": 349690, "text": "Entonces él me respondió: Jehová, en cuya presencia he andado, enviará su ángel contigo, y prosperará tu camino; y tomarás mujer para mi hijo de mi linaje y de la casa de mi padre:", "words": [[0, 338541], [9, 339065], [12, 339305], [15, 339425], [26, 340378], [34, 340807], [37, 340907], [42, 341147], [52, 341707], [55, 341947], [63, 342707], [71, 343167], [74, 343347], [80, 343687], [89, 344227], [91, 344487], [102, 345107], [105, 345247], [113, 346081], [115, 346179], [123, 346599], [129, 346839], [134, 347179], [137, 347379], [142, 347579], [145, 347739], [148, 347839], [155, 348339], [157, 348419], [160, 348499], [163, 348599], [168, 348839], [171, 349039], [174, 349139]]}, {"verse": 41, "start": 350140, "end": 356801, "text": "Entonces serás libre de mi juramento, cuando hayas llegado a mi familia; y si no te la dan, serás libre de mi juramento.", "words": [[0, 350140], [9, 350526], [15, 351046], [21, 351326], [24, 351526], [27, 351606], [38, 352126], [45, 352406], [51, 352806], [59, 353126], [61, 353186], [64, 353246], [73, 354216], [75, 354318], [78, 354458], [81, 354578], [84, 354718], [87, 354838], [92, 355298], [98, 355618], [104, 355858], [107, 356018], [110, 356118]]}, {"verse": 42, "start": 357251, "end": 364024, "text": "Llegué, pues, hoy a la fuente, y dije: Jehová, Dios de mi señor Abraham, si tú prosperas ahora mi camino por el cual ando;", "words": [[0, 357251], [8, 357538], [14, 357818], [18, 358078], [20, 358198], [23, 358258], [31, 358638], [33, 358818], [39, 359538], [47, 359907], [52, 360107], [55, 360307], [58, 360497], [64, 360687], [73, 361547], [76, 361647], [79, 361787], [89, 362347], [95, 362547], [98, 362747], [105, 363107], [109, 363307], [112, 363407], [117, 363567]]}, {"verse": 43, "start": 364474, "end": 374462, "text": "He aquí yo estoy junto a la fuente de agua; sea, pues, que la joven que salga por agua, a la cual diga: Dame a beber, te ruego, un poco de agua de tu cántaro;", "words": [[0, 364503], [3, 364573], [8, 364813], [11, 365033], [17, 365273], [23, 365513], [25, 365713], [28, 365753], [35, 366073], [38, 366233], [44, 366935], [49, 367089], [55, 367369], [59, 367649], [62, 367789], [68, 368209], [72, 368329], [78, 368729], [82, 368929], [88, 369549], [90, 369789], [93, 369849], [98, 370089], [104, 371024], [109, 371264], [111, 371424], [118, 372004], [121, 372104], [128, 372824], [131, 372964], [136, 373164], [139, 373364], [144, 373564], [147, 373744], [150, 373864]]}, {"verse": 44, "start": 374912, "end": 383827, "text": "Y ella me responda, Bebe tú, y también para tus camellos sacaré agua: esta sea la mujer que destinó Jehová para el hijo de mi señor.", "words": [[0, 374912], [2, 375056], [7, 375236], [10, 375396], [20, 376476], [25, 376776], [29, 377056], [31, 377496], [39, 377856], [44, 378096], [48, 378316], [57, 378876], [64, 379296], [70, 380107], [75, 380333], [79, 380573], [82, 380753], [88, 381053], [92, 381420], [100, 381786], [107, 382153], [112, 382393], [115, 382553], [120, 382773], [123, 382893], [126, 383013]]}, {"verse": 45, "start": 384277, "end": 395409, "text": "Y antes que acabase de hablar en mi corazón, he aquí Rebeca, que salía con su cántaro sobre su hombro; y descendió a la fuente, y sacó agua; y le dije: Te ruego que me des a beber.", "words": [[0, 384277], [2, 384439], [8, 384679], [12, 384879], [20, 385339], [23, 385479], [30, 385699], [33, 385899], [36, 386019], [45, 386489], [48, 386959], [53, 387429], [61, 387899], [65, 388159], [71, 388519], [75, 388699], [78, 388839], [86, 389279], [92, 389539], [95, 389759], [103, 390529], [105, 390632], [115, 391132], [117, 391232], [120, 391292], [128, 391712], [130, 391972], [135, 392312], [141, 393056], [143, 393175], [146, 393255], [152, 394003], [155, 394176], [161, 394386], [165, 394506], [168, 394646], [172, 394826], [174, 394946]]}, {"verse": 46, "start": 395859, "end": 404515, "text": "Y rápidamente bajó su cántaro de encima de sí, y dijo: Bebe, y también a tus camellos daré a beber. Y bebí, y dio también de beber a mis camellos.", "words": [[0, 395859], [2, 395960], [14, 396560], [19, 396940], [22, 397060], [30, 397480], [33, 397620], [40, 397960], [43, 398140], [47, 398580], [49, 398640], [55, 399357], [61, 399995], [63, 400075], [71, 400295], [73, 400455], [77, 400615], [86, 401075], [91, 401335], [93, 401600], [100, 402135], [102, 402252], [108, 402572], [110, 402672], [114, 402792], [122, 403152], [125, 403312], [131, 403532], [133, 403652], [137, 403792]]}, {"verse": 47, "start": 404965, "end": 417849, "text": "Entonces le pregunté, y dije: ¿De quién eres hija? Y ella respondió: Hija de Betuel, hijo de Nacor, que le parió Milca. Entonces le puse un pendiente sobre su nariz, y brazaletes sobre sus manos:", "words": [[0, 404965], [9, 405364], [12, 405604], [22, 406264], [24, 406364], [30, 407171], [34, 407330], [40, 407490], [45, 407750], [51, 408562], [53, 408724], [58, 408904], [69, 409960], [74, 410245], [77, 410305], [85, 411005], [90, 411165], [93, 411305], [100, 412045], [104, 412125], [107, 412245], [113, 412505], [120, 413383], [129, 413727], [132, 414007], [137, 414327], [140, 414427], [150, 414927], [156, 415187], [159, 415407], [166, 415867], [168, 416227], [179, 416827], [185, 417107], [189, 417287]]}, {"verse": 48, "start": 418299, "end": 428417, "text": "Y me incliné, y adoré a Jehová, y bendije a Jehová, Dios de mi señor Abraham, que me había guiado por camino de verdad para tomar la hija del hermano de mi señor para su hijo.", "words": [[0, 418299], [2, 418442], [5, 418802], [14, 419162], [16, 419342], [22, 419682], [24, 419782], [32, 420362], [34, 420602], [42, 421022], [44, 421162], [52, 421762], [57, 421982], [60, 422162], [63, 422495], [69, 422829], [78, 423409], [82, 423490], [85, 423610], [91, 423830], [98, 424290], [102, 424470], [109, 424750], [112, 425030], [119, 425390], [124, 425650], [130, 425910], [133, 426150], [138, 426430], [142, 426550], [150, 426970], [153, 427050], [156, 427170], [162, 427530], [167, 427770], [170, 427990]]}, {"verse": 49, "start": 428867, "end": 438312, "text": "Ahora pues, si vosotros hacéis misericordia y verdad con mi señor, declarádmelo; y si no, declarádmelo; y iré a la derecha o a la izquierda.", "words": [[0, 428867], [6, 429151], [12, 429611], [15, 429671], [24, 430131], [31, 430591], [44, 431331], [46, 431411], [53, 431651], [57, 431991], [60, 432151], [67, 432991], [81, 434092], [83, 434195], [86, 434335], [90, 434455], [104, 435605], [106, 435746], [110, 435966], [112, 436026], [115, 436066], [123, 436466], [125, 436666], [127, 436746], [130, 436786]]}, {"verse": 50, "start": 438662, "end": 447383, "text": "Entonces Labán y Betuel respondieron y dijeron: De Jehová ha salido esto; no podemos hablarte malo ni bueno.", "words": [[0, 438662], [9, 439219], [15, 440119], [17, 440259], [24, 440659], [37, 441719], [39, 441999], [48, 442895], [51, 443120], [58, 443600], [61, 443720], [68, 444200], [74, 444757], [77, 445223], [85, 445603], [94, 446203], [99, 446623], [102, 446743]]}, {"verse": 51, "start": 447833, "end": 455448, "text": "He ahí Rebeca delante de ti; tómala y vete, y sea mujer del hijo de tu señor, como lo ha dicho Jehová.", "words": [[0, 447898], [3, 447998], [7, 448618], [14, 449238], [22, 449578], [25, 449758], [29, 450357], [36, 450877], [38, 451497], [44, 451777], [46, 451877], [50, 452037], [56, 452337], [60, 452637], [65, 452897], [68, 453057], [71, 453217], [78, 454117], [83, 454277], [86, 454457], [89, 454537], [95, 454757]]}, {"verse": 52, "start": 455898, "end": 462678, "text": "Y fue, que como el criado de Abraham oyó sus palabras, se inclinó en tierra ante Jehová.", "words": [[0, 455898], [2, 456000], [7, 456160], [11, 456340], [16, 456580], [19, 456720], [26, 457260], [29, 457420], [37, 457860], [41, 458500], [45, 458640], [55, 459780], [58, 460360], [66, 461020], [69, 461160], [76, 461620], [81, 462000]]}, {"verse": 53, "start": 463128, "end": 473212, "text": "Y sacó el criado vasos de plata, y vasos de oro y vestidos, y dio a Rebeca: también dio cosas preciosas a su hermano y a su madre.", "words": [[0, 463128], [2, 463249], [7, 463579], [10, 463909], [17, 464489], [23, 464989], [26, 465109], [33, 465489], [35, 465669], [41, 466109], [44, 466229], [48, 466489], [50, 466669], [60, 467689], [62, 467949], [66, 468189], [68, 468349], [76, 469327], [84, 469630], [88, 469950], [94, 470350], [104, 471130], [106, 471250], [109, 471410], [117, 472190], [119, 472370], [121, 472430], [124, 472590]]}, {"verse": 54, "start": 473662, "end": 483497, "text": "Y comieron y bebieron él y los varones que venían con él, y durmieron; y levantándose de mañana, dijo: Enviadme a mi señor.", "words": [[0, 473662], [2, 473783], [11, 474303], [13, 474663], [22, 475163], [25, 475623], [27, 475863], [31, 476003], [39, 476443], [43, 476643], [50, 477063], [54, 477303], [58, 477523], [60, 478063], [71, 479217], [73, 479467], [86, 480207], [89, 480367], [97, 481167], [103, 482160], [112, 482764], [114, 482844], [117, 482924]]}, {"verse": 55, "start": 483847, "end": 491978, "text": "Entonces respondió su hermano y su madre: Espere la doncella con nosotros a lo menos diez días, y después irá.", "words": [[0, 483847], [9, 484945], [19, 485645], [22, 485805], [30, 486305], [32, 486365], [35, 486505], [42, 487343], [49, 487759], [52, 488109], [61, 488459], [65, 488619], [74, 489159], [76, 489439], [79, 489499], [85, 489719], [90, 489939], [96, 490299], [98, 491159], [106, 491419]]}, {"verse": 56, "start": 492428, "end": 499248, "text": "Y él les dijo: No me detengáis, pues que Jehová ha prosperado mi camino; despachadme para que me vaya a mi señor.", "words": [[0, 492428], [2, 492595], [5, 492715], [9, 492875], [15, 493628], [18, 493752], [21, 493872], [32, 494492], [37, 494772], [41, 495052], [48, 495512], [51, 495572], [62, 496072], [65, 496192], [73, 497067], [85, 497785], [90, 497985], [94, 498145], [97, 498265], [102, 498485], [104, 498625], [107, 498705]]}, {"verse": 57, "start": 499598, "end": 504450, "text": "Ellos respondieron entonces: Llamemos la doncella y preguntémosle.", "words": [[0, 499598], [6, 500019], [19, 500879], [29, 502170], [38, 502596], [41, 502946], [50, 503296], [52, 503416]]}, {"verse": 58, "start": 504900, "end": 512256, "text": "Y llamaron a Rebeca, y le dijeron: ¿Irás tú con este varón? Y ella respondió: Sí, iré.", "words": [[0, 504900], [2, 505011], [11, 505384], [13, 505758], [21, 506131], [23, 506231], [26, 506331], [35, 507295], [41, 507611], [44, 507871], [48, 508171], [53, 508351], [60, 509262], [62, 509424], [67, 509664], [78, 511224], [82, 511764]]}, {"verse": 59, "start": 512606, "end": 519381, "text": "Entonces dejaron ir a Rebeca su hermana, y a su nodriza, y al criado de Abraham y a sus hombres.", "words": [[0, 512606], [9, 513112], [17, 513932], [20, 514112], [22, 514232], [29, 514672], [32, 514872], [41, 515332], [43, 515472], [45, 515532], [48, 515932], [57, 516332], [59, 516812], [62, 516952], [69, 517492], [72, 517652], [80, 518052], [82, 518432], [84, 518512], [88, 518692]]}, {"verse": 60, "start": 519831, "end": 531091, "text": "Y bendijeron a Rebeca, y le dijeron: Nuestra hermana eres; seas en millares de millares, y tu generación posea la puerta de sus enemigos.", "words": [[0, 520103], [2, 520417], [13, 520730], [15, 520850], [23, 521330], [25, 521430], [28, 521530], [37, 522552], [45, 522860], [53, 523512], [59, 524445], [64, 524857], [67, 525277], [76, 525957], [79, 526177], [89, 527257], [91, 527477], [94, 527637], [105, 528537], [111, 529237], [114, 529357], [121, 529697], [124, 529977], [128, 530157]]}, {"verse": 61, "start": 531541, "end": 542048, "text": "Se levantó entonces Rebeca y sus doncellas, y subieron sobre los camellos, y siguieron al hombre; y el criado tomó a Rebeca, y se fue.", "words": [[0, 531541], [3, 531660], [11, 532140], [20, 532660], [27, 533600], [29, 534020], [33, 534200], [44, 534980], [46, 535300], [55, 535760], [61, 536020], [65, 536240], [75, 536960], [77, 537280], [87, 537820], [90, 537980], [98, 538844], [100, 538986], [103, 539126], [110, 539706], [115, 540126], [117, 540246], [125, 540806], [127, 541426], [130, 541586]]}, {"verse": 62, "start": 542498, "end": 548831, "text": "Y venía Isaac del pozo del Viviente que me ve; porque él habitaba en la tierra del Neguev;", "words": [[0, 542498], [2, 542793], [8, 543233], [14, 543693], [18, 544093], [23, 544533], [27, 544713], [36, 545233], [40, 545413], [43, 545553], [47, 546226], [54, 546610], [57, 546890], [66, 547350], [69, 547450], [72, 547570], [79, 547870], [83, 548170]]}, {"verse": 63, "start": 549281, "end": 558637, "text": "Y había salido Isaac a meditar al campo, a la hora de la tarde; y alzando sus ojos miró, y he aquí los camellos que venían.", "words": [[0, 549281], [2, 549389], [8, 549569], [15, 550089], [21, 550389], [23, 550809], [31, 551276], [34, 551742], [41, 552209], [43, 552609], [46, 552709], [51, 552949], [54, 553129], [57, 553249], [64, 554145], [66, 554428], [74, 555108], [78, 555288], [83, 555608], [89, 556188], [91, 556458], [94, 556728], [99, 556968], [103, 557168], [112, 557768], [116, 557888]]}, {"verse": 64, "start": 559087, "end": 565591, "text": "Rebeca también alzó sus ojos, y vio a Isaac, y descendió del camello;", "words": [[0, 559087], [7, 559611], [15, 560011], [20, 560651], [24, 560811], [30, 561171], [32, 561911], [36, 562251], [38, 562491], [45, 562891], [47, 564031], [57, 564651], [61, 564851]]}, {"verse": 65, "start": 566041, "end": 578444, "text": "Porque había preguntado al criado: ¿Quién es este varón que viene por el campo hacia nosotros? Y el siervo había respondido: Este es mi señor. Ella entonces tomó el velo, y se cubrió.", "words": [[0, 566041], [7, 566204], [13, 566484], [24, 567164], [27, 567284], [35, 568255], [42, 568415], [45, 568535], [50, 568795], [56, 569155], [60, 569295], [66, 569575], [70, 569795], [73, 569935], [79, 570255], [85, 570495], [95, 571801], [97, 571917], [100, 572057], [107, 572557], [113, 572877], [125, 574149], [130, 574396], [133, 574616], [136, 574736], [143, 575669], [148, 575759], [157, 576239], [162, 577019], [165, 577159], [171, 577499], [173, 577659], [176, 577759]]}, {"verse": 66, "start": 578894, "end": 583332, "text": "Entonces el criado contó a Isaac todo lo que había hecho.", "words": [[0, 578894], [9, 579390], [12, 579690], [19, 580270], [25, 580910], [27, 581030], [33, 581310], [38, 582050], [41, 582330], [45, 582470], [51, 582730]]}, {"verse": 67, "start": 583782, "end": 594594, "text": "E la introdujo Isaac a la tienda de su madre Sara, y tomó a Rebeca por mujer; y la amó: y se consoló Isaac después de la muerte de su madre.", "words": [[0, 583850], [2, 583956], [5, 584063], [15, 584803], [21, 585163], [23, 585623], [26, 585703], [33, 586163], [36, 586303], [39, 586483], [45, 586743], [51, 587183], [53, 587783], [58, 588203], [60, 588403], [67, 588603], [71, 589003], [78, 589833], [80, 590000], [83, 590335], [88, 590903], [90, 591002], [93, 591142], [101, 591782], [107, 592102], [115, 592942], [118, 593182], [121, 593302], [128, 593642], [131, 593862], [134, 594022]]}]}