{"book": "MAT", "chapter": 20, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 279099, "verses": [{"verse": 1, "start": 300, "end": 8476, "text": "Porque el reino de los cielos es semejante a un propietario, que salió por la mañana a contratar trabajadores para su viña.", "words": [[0, 300], [7, 522], [10, 702], [16, 1082], [19, 1202], [23, 1362], [30, 1882], [33, 2082], [43, 2862], [45, 2982], [48, 3122], [61, 4082], [65, 4307], [71, 4727], [75, 4947], [78, 5147], [85, 5547], [87, 5887], [97, 6607], [110, 7387], [115, 7687], [118, 7867]]}, {"verse": 2, "start": 8826, "end": 14747, "text": "Y habiendo acordado con los obreros en un denario al día, los envió a su viña.", "words": [[0, 8826], [2, 8968], [11, 9348], [20, 10028], [24, 10228], [28, 10648], [36, 11068], [39, 11288], [42, 11428], [50, 11948], [53, 12168], [58, 13088], [62, 13348], [68, 13828], [70, 13968], [73, 14088]]}, {"verse": 3, "start": 15097, "end": 21657, "text": "Y saliendo cerca de la tercera hora del día, vio otros que estaban en la plaza ociosos;", "words": [[0, 15097], [2, 15521], [11, 16001], [17, 16341], [20, 16621], [23, 16741], [31, 17321], [36, 17601], [40, 17841], [45, 18701], [49, 19061], [55, 19521], [59, 19921], [67, 20281], [70, 20481], [73, 20601], [79, 20901]]}, {"verse": 4, "start": 22007, "end": 27990, "text": "Y les dijo: Id también vosotros a mi viña, y os daré lo que sea justo. Y ellos fueron.", "words": [[0, 22007], [2, 22276], [6, 22580], [12, 23086], [15, 23166], [23, 23466], [32, 24106], [34, 24306], [37, 24426], [43, 24846], [45, 25246], [48, 25386], [53, 25646], [56, 25726], [60, 25866], [64, 26026], [71, 26921], [73, 27087], [79, 27247]]}, {"verse": 5, "start": 28340, "end": 33027, "text": "Salió otra vez cerca de las horas sexta y novena, e hizo lo mismo.", "words": [[0, 28340], [6, 28762], [11, 29082], [15, 29342], [21, 29762], [24, 30002], [28, 30162], [34, 30362], [40, 31002], [42, 31102], [50, 31662], [52, 31942], [57, 32302], [60, 32502]]}, {"verse": 6, "start": 33377, "end": 42153, "text": "Y saliendo cerca de la hora undécima, halló otros que estaban ociosos; y les dice: ¿Por qué estáis aquí todo el día ociosos?", "words": [[0, 33377], [2, 33506], [11, 34006], [17, 34346], [20, 34606], [23, 34746], [28, 35257], [38, 35768], [44, 36121], [50, 36541], [54, 36821], [62, 37201], [71, 38542], [73, 38668], [77, 38788], [83, 39589], [88, 39711], [92, 40031], [99, 40351], [104, 40671], [109, 40771], [112, 41031], [116, 41191]]}, {"verse": 7, "start": 42503, "end": 50864, "text": "Le dicen: Porque nadie nos ha contratado. Les dice: Id también vosotros a la viña, y recibiréis lo que sea justo.", "words": [[0, 42503], [3, 42668], [10, 43536], [17, 43796], [23, 44156], [27, 44416], [30, 44556], [42, 45751], [46, 45841], [52, 46720], [55, 46820], [63, 47080], [72, 47740], [74, 47940], [77, 48020], [83, 48540], [85, 48980], [96, 49760], [99, 49920], [103, 50040], [107, 50220]]}, {"verse": 8, "start": 51214, "end": 62053, "text": "Y cuando fue la tarde del día, el señor de la viña dijo a su encargado: Llama a los obreros y págales el salario, comenzando desde los últimos hasta los primeros.", "words": [[0, 51214], [2, 51504], [9, 51664], [13, 51884], [16, 52024], [22, 52344], [26, 52664], [31, 53384], [34, 53504], [40, 53824], [43, 54004], [46, 54124], [51, 54584], [56, 55184], [58, 55404], [61, 55524], [72, 56603], [78, 56909], [80, 57129], [84, 57459], [92, 57789], [94, 57949], [102, 58529], [105, 58689], [114, 59409], [125, 60129], [131, 60309], [135, 60529], [143, 60889], [149, 61189], [153, 61369]]}, {"verse": 9, "start": 62403, "end": 68578, "text": "Y viniendo los que habían ido cerca de la hora undécima, recibieron cada uno un denario.", "words": [[0, 62403], [2, 62501], [11, 62981], [15, 63181], [19, 63341], [26, 63641], [30, 63881], [36, 64321], [39, 64601], [42, 64741], [47, 65401], [57, 66060], [68, 66761], [73, 67041], [77, 67420], [80, 67741]]}, {"verse": 10, "start": 68928, "end": 77645, "text": "Y viniendo también los primeros, pensaron que habían de recibir más; pero también ellos recibieron cada uno un denario.", "words": [[0, 68928], [2, 69175], [11, 69455], [19, 69815], [23, 70055], [33, 71015], [42, 71855], [46, 72095], [53, 72415], [56, 72635], [64, 73055], [69, 74042], [74, 74282], [82, 74702], [88, 75062], [99, 76082], [104, 76342], [108, 76642], [111, 76842]]}, {"verse": 11, "start": 77995, "end": 81662, "text": "Y tomándolo, murmuraban contra el padre de la familia,", "words": [[0, 77995], [2, 78073], [13, 78673], [24, 79493], [31, 79893], [34, 80113], [40, 80453], [43, 80713], [46, 80833]]}, {"verse": 12, "start": 82012, "end": 91458, "text": "Diciendo: Estos últimos sólo han trabajado una hora, y los has hecho iguales a nosotros, que hemos llevado la carga y el calor del día.", "words": [[0, 82012], [10, 83216], [16, 83638], [24, 84018], [29, 84418], [33, 84638], [43, 85298], [47, 85578], [53, 85918], [55, 86133], [59, 86293], [63, 86513], [69, 86973], [77, 87713], [79, 87833], [89, 88253], [93, 88793], [99, 88953], [107, 89393], [110, 89573], [116, 89953], [118, 90173], [121, 90293], [127, 90613], [131, 90893]]}, {"verse": 13, "start": 91808, "end": 100267, "text": "Y él respondiendo, dijo a uno de ellos: Amigo, no cometo injusticia contigo; ¿no te concertaste conmigo por un denario?", "words": [[0, 91808], [2, 92068], [5, 92208], [19, 92968], [24, 93248], [26, 93468], [30, 93648], [33, 93808], [40, 95240], [47, 95649], [50, 95749], [57, 96269], [68, 96929], [77, 97937], [81, 98024], [84, 98144], [96, 98764], [104, 99204], [108, 99444], [111, 99584]]}, {"verse": 14, "start": 100617, "end": 104805, "text": "Toma lo que es tuyo, y vete; pero quiero dar a este último, como a ti.", "words": [[0, 100617], [5, 100822], [8, 100962], [12, 101082], [15, 101242], [21, 101582], [23, 101782], [29, 102472], [34, 102596], [41, 102876], [45, 103156], [47, 103316], [52, 103716], [60, 104116], [65, 104316], [67, 104496]]}, {"verse": 15, "start": 105155, "end": 111788, "text": "¿No me es lícito a mí hacer lo que quiero con lo mío? o ¿es malo tu ojo, porque yo soy bueno?", "words": [[0, 105155], [4, 105320], [7, 105500], [10, 105680], [17, 106240], [19, 106440], [22, 106560], [28, 106860], [31, 107100], [35, 107240], [42, 107520], [46, 107720], [49, 107880], [54, 108595], [56, 108849], [60, 108969], [65, 109449], [68, 109609], [73, 110409], [80, 110749], [83, 110969], [87, 111169]]}, {"verse": 16, "start": 112138, "end": 120426, "text": "Así los primeros serán últimos, y los últimos primeros: porque muchos son llamados, pero pocos escogidos.", "words": [[0, 112138], [4, 112338], [8, 112538], [17, 113238], [23, 113858], [32, 114418], [34, 115058], [38, 115238], [46, 115658], [56, 116815], [63, 117057], [70, 117517], [74, 117997], [84, 118717], [89, 118977], [95, 119452]]}, {"verse": 17, "start": 120776, "end": 126707, "text": "Y subiendo Jesús a Jerusalén, tomó sus doce discípulos aparte en el camino, y les dijo:", "words": [[0, 120776], [2, 120881], [11, 121341], [17, 121701], [19, 121961], [30, 123041], [35, 123321], [39, 123521], [44, 124021], [55, 124741], [62, 125341], [65, 125441], [68, 125561], [76, 125921], [78, 126081], [82, 126201]]}, {"verse": 18, "start": 127057, "end": 137082, "text": "He aquí subimos a Jerusalén, y el Hijo del hombre será entregado a los príncipes de los sacerdotes y a los escribas, y le condenarán a muerte;", "words": [[0, 127108], [3, 127198], [8, 127418], [16, 127978], [18, 128118], [29, 129118], [31, 129398], [34, 129518], [39, 129798], [43, 129938], [50, 130378], [55, 130618], [65, 131358], [67, 131438], [71, 131558], [81, 132338], [84, 132458], [88, 132598], [99, 133438], [101, 133818], [103, 133878], [107, 133998], [117, 135278], [119, 135378], [122, 135498], [133, 136298], [135, 136438]]}, {"verse": 19, "start": 137432, "end": 146805, "text": "Y le entregarán a los Gentiles para que se burlen de él, lo azoten y lo crucifiquen; pero al tercer día resucitará.", "words": [[0, 137432], [2, 137556], [5, 137676], [16, 138376], [18, 138456], [22, 138576], [31, 139196], [36, 139736], [40, 139896], [43, 140076], [50, 140536], [53, 140736], [57, 141576], [60, 141926], [67, 142276], [69, 142976], [72, 143516], [85, 144276], [90, 144576], [93, 144776], [100, 145076], [104, 145516]]}, {"verse": 20, "start": 147155, "end": 154748, "text": "Entonces se llegó a él la madre de los hijos de Zebedeo con sus hijos, adorándole, y pidiéndole algo.", "words": [[0, 147155], [9, 147596], [12, 147916], [18, 148236], [20, 148516], [23, 148996], [26, 149076], [32, 149436], [35, 149636], [39, 149776], [45, 150096], [48, 150576], [56, 151056], [60, 151156], [64, 151396], [71, 152196], [83, 153016], [85, 153456], [96, 154156]]}, {"verse": 21, "start": 155098, "end": 165137, "text": "Y él le dijo: ¿Qué quieres? Ella le dijo: Di que se sienten estos dos hijos míos, el uno a tu mano derecha, y el otro a tu izquierda, en tu reino.", "words": [[0, 155098], [2, 155267], [5, 155387], [8, 155527], [14, 156181], [19, 156305], [28, 157104], [33, 157329], [36, 157529], [42, 158903], [45, 158953], [49, 159053], [52, 159193], [60, 159713], [66, 159973], [70, 160253], [76, 160493], [82, 161273], [85, 161413], [89, 161633], [91, 161773], [94, 161853], [99, 162053], [108, 162713], [110, 163033], [113, 163153], [118, 163353], [120, 163493], [123, 163593], [134, 164413], [137, 164493], [140, 164633]]}, {"verse": 22, "start": 165417, "end": 178325, "text": "Entonces Jesús respondiendo, dijo: No sabéis lo que pedís: ¿podéis beber la copa que yo he de beber, y ser bautizados del bautismo de que yo soy bautizado? Y ellos le dicen: Podemos.", "words": [[0, 165417], [9, 165926], [15, 167026], [29, 167846], [35, 168491], [38, 168680], [45, 169200], [48, 169380], [52, 169520], [59, 170354], [67, 170658], [73, 170938], [76, 171198], [81, 171578], [85, 171678], [88, 171878], [91, 171998], [94, 172118], [101, 172398], [103, 172798], [107, 172998], [118, 173738], [122, 173938], [131, 174538], [134, 174698], [138, 174818], [141, 174978], [145, 175178], [156, 176313], [158, 176422], [164, 176622], [167, 176842], [174, 177661]]}, {"verse": 23, "start": 178605, "end": 195753, "text": "Y él les dice: A la verdad mi copa beberéis, y del bautismo de que yo soy bautizado, seréis bautizados; pero el sentaros a mi mano derecha y a mi izquierda, no es mío darlo, sino a aquellos para quienes está preparado por mi Padre.", "words": [[0, 178605], [2, 178810], [5, 178990], [9, 179290], [15, 180152], [17, 180256], [20, 180336], [27, 180859], [30, 180991], [35, 181331], [45, 181911], [47, 182431], [51, 182591], [60, 183211], [63, 183391], [67, 183511], [70, 183691], [74, 183911], [85, 185011], [92, 185431], [104, 186866], [109, 187032], [112, 187192], [121, 187772], [123, 187952], [126, 188072], [131, 188292], [139, 188872], [141, 189052], [143, 189112], [146, 189232], [157, 189992], [160, 190612], [163, 190732], [167, 191012], [174, 191932], [179, 192252], [181, 192612], [190, 192992], [195, 193412], [203, 193692], [208, 194092], [218, 194732], [222, 194932], [225, 195112]]}, {"verse": 24, "start": 196103, "end": 200763, "text": "Y como los diez oyeron esto, se enojaron de los dos hermanos.", "words": [[0, 196103], [2, 196205], [7, 196405], [11, 196585], [16, 196845], [23, 197625], [29, 198345], [32, 198645], [41, 199325], [44, 199465], [48, 199625], [52, 199825]]}, {"verse": 25, "start": 201113, "end": 211408, "text": "Entonces Jesús llamándolos, dijo: Sabéis que los príncipes de los Gentiles los dominan, y los que son grandes ejercen autoridad sobre ellos.", "words": [[0, 201113], [9, 201654], [15, 202734], [28, 203394], [34, 204184], [41, 204694], [45, 204874], [49, 205034], [59, 205754], [62, 205914], [66, 206014], [75, 206554], [79, 206774], [88, 207434], [90, 207794], [94, 207934], [98, 208054], [102, 208254], [110, 208694], [118, 209534], [128, 210354], [134, 210814]]}, {"verse": 26, "start": 211758, "end": 219627, "text": "Pero entre vosotros no será así; sino que el que quiera hacerse grande entre vosotros será vuestro servidor;", "words": [[0, 211758], [5, 211922], [11, 212182], [20, 212902], [23, 213522], [28, 213802], [33, 214556], [38, 214795], [42, 215095], [45, 215355], [49, 215535], [56, 215855], [64, 216335], [71, 216755], [77, 217055], [86, 217735], [91, 218255], [99, 218775]]}, {"verse": 27, "start": 219977, "end": 224240, "text": "Y el que quiera ser el primero entre vosotros, será vuestro siervo:", "words": [[0, 219977], [2, 220102], [5, 220202], [9, 220322], [16, 220622], [20, 220922], [23, 221062], [31, 221442], [37, 221682], [47, 222342], [52, 222942], [60, 223602]]}, {"verse": 28, "start": 224590, "end": 232341, "text": "Como el Hijo del hombre no vino para ser servido, sino para servir, y para dar su vida en rescate por muchos.", "words": [[0, 224590], [5, 224754], [8, 224914], [13, 225174], [17, 225334], [24, 225894], [27, 226174], [32, 226414], [37, 226694], [41, 226974], [50, 227894], [55, 228174], [60, 228494], [68, 228974], [70, 229534], [75, 229774], [79, 230014], [82, 230294], [87, 230614], [90, 230774], [98, 231354], [102, 231574]]}, {"verse": 29, "start": 232691, "end": 238147, "text": "Entonces saliendo ellos de Jericó, le seguía una gran multitud.", "words": [[0, 232691], [9, 233754], [18, 234394], [24, 234694], [27, 234994], [35, 235934], [38, 236014], [45, 236554], [49, 236814], [54, 237114]]}, {"verse": 30, "start": 238497, "end": 250073, "text": "Y he aquí dos ciegos sentados junto al camino, cuando oyeron que Jesús pasaba, clamaron, diciendo: Señor, Hijo de David, ten misericordia de nosotros.", "words": [[0, 238497], [2, 238683], [5, 238823], [10, 239103], [14, 239323], [21, 239903], [30, 240683], [36, 241003], [39, 241283], [47, 242383], [54, 242703], [61, 243243], [65, 243403], [71, 243663], [79, 244863], [89, 245523], [99, 246931], [106, 247186], [111, 247506], [114, 247606], [121, 248386], [125, 248506], [138, 249286], [141, 249386]]}, {"verse": 31, "start": 250353, "end": 259268, "text": "Y la gente les reñía para que callasen; pero ellos clamaban más, diciendo: Señor, Hijo de David, ten misericordia de nosotros.", "words": [[0, 250353], [2, 250457], [5, 250577], [11, 250917], [15, 251277], [21, 252137], [26, 252337], [30, 252867], [40, 253617], [45, 253762], [51, 253962], [60, 254602], [65, 255002], [75, 256127], [82, 256381], [87, 256701], [90, 256801], [97, 257581], [101, 257701], [114, 258481], [117, 258581]]}, {"verse": 32, "start": 259548, "end": 265013, "text": "Y parándose Jesús, los llamó, y dijo: ¿Qué queréis que haga por vosotros?", "words": [[0, 259548], [2, 259670], [12, 260370], [19, 260830], [23, 261370], [30, 261930], [32, 262310], [38, 262998], [43, 263123], [51, 263503], [55, 263663], [60, 263883], [64, 264143]]}, {"verse": 33, "start": 265363, "end": 268953, "text": "Ellos le dicen: Señor, que sean abiertos nuestros ojos.", "words": [[0, 265363], [6, 265767], [9, 265887], [16, 266694], [23, 267193], [27, 267273], [32, 267473], [41, 268053], [50, 268233]]}, {"verse": 34, "start": 269233, "end": 278699, "text": "Entonces Jesús, teniendo misericordia de ellos, les tocó los ojos, y luego sus ojos recibieron la vista; y le siguieron.", "words": [[0, 269233], [9, 270016], [16, 270742], [25, 271468], [38, 272368], [41, 272508], [48, 273228], [52, 273368], [57, 273928], [61, 274168], [67, 274508], [69, 275208], [75, 275408], [79, 275668], [84, 275988], [95, 276708], [98, 276908], [105, 277714], [107, 277837], [110, 277917]]}]}