{"book": "JHN", "chapter": 17, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 182738, "verses": [{"verse": 1, "start": 300, "end": 9935, "text": "These words spoke Jesus, and lifted up his eyes to heaven, and said, Father, the hour is come; glorify your Son, that your Son also may glorify you:", "words": [[0, 300], [6, 450], [12, 810], [18, 1230], [25, 1730], [29, 2165], [36, 2465], [39, 2685], [43, 2845], [48, 3125], [51, 3365], [59, 3685], [63, 4125], [69, 4820], [77, 5120], [81, 5300], [86, 5600], [89, 5860], [95, 6589], [103, 7085], [108, 7305], [113, 7705], [118, 7985], [123, 8125], [127, 8445], [132, 8825], [136, 9045], [144, 9585]]}, {"verse": 2, "start": 10285, "end": 16935, "text": "As you have given him power over all flesh, that he should give eternal life to as many as you have given him.", "words": [[0, 10285], [3, 10470], [7, 10610], [12, 10770], [18, 11030], [22, 11230], [28, 11670], [33, 12030], [37, 12310], [44, 13010], [49, 13350], [52, 13490], [59, 13690], [64, 13970], [72, 14510], [77, 14930], [80, 15150], [83, 15350], [88, 15610], [91, 15950], [95, 16110], [100, 16270], [106, 16530]]}, {"verse": 3, "start": 17285, "end": 23808, "text": "And this is life eternal, that they might know you the only true God, and Jesus Christ, whom you have sent.", "words": [[0, 17285], [4, 17443], [9, 17683], [12, 17843], [17, 18143], [26, 19143], [31, 19323], [36, 19503], [42, 19723], [47, 19963], [51, 20183], [55, 20363], [60, 20683], [65, 21003], [70, 21403], [74, 21723], [80, 22043], [88, 22483], [93, 23003], [97, 23203], [102, 23363]]}, {"verse": 4, "start": 24158, "end": 28606, "text": "I have glorified you on the earth: I have finished the work which you gave me to do.", "words": [[0, 24158], [2, 24362], [7, 24482], [17, 25082], [21, 25242], [24, 25402], [28, 25522], [35, 26148], [37, 26311], [42, 26471], [51, 26791], [55, 27031], [60, 27271], [66, 27531], [70, 27691], [75, 27871], [78, 28071], [81, 28211]]}, {"verse": 5, "start": 28956, "end": 35467, "text": "And now, O Father, glorify you me with your own self with the glory which I had with you before the world was.", "words": [[0, 28956], [4, 29077], [9, 29417], [11, 29517], [19, 30297], [27, 30877], [31, 31057], [34, 31197], [39, 31397], [44, 31497], [48, 31737], [53, 32637], [58, 32737], [62, 32857], [68, 33157], [74, 33437], [76, 33577], [80, 33837], [85, 34017], [89, 34197], [96, 34497], [100, 34717], [106, 34977]]}, {"verse": 6, "start": 35817, "end": 43899, "text": "I have manifested your name to the men which you gave me out of the world: yours they were, and you gave them me; and they have kept your word.", "words": [[0, 35817], [2, 36000], [7, 36180], [18, 36660], [23, 36980], [28, 37260], [31, 37460], [35, 37580], [39, 37840], [45, 38100], [49, 38240], [54, 38420], [57, 38700], [61, 38900], [64, 39000], [68, 39120], [75, 39876], [81, 40162], [86, 40422], [92, 40982], [96, 41282], [100, 41422], [105, 41662], [110, 41882], [114, 42562], [118, 42687], [123, 42807], [128, 42947], [133, 43187], [138, 43367]]}, {"verse": 7, "start": 44249, "end": 48321, "text": "Now they have known that all things whatever you have given me are of you.", "words": [[0, 44249], [4, 44592], [9, 44892], [14, 45072], [20, 45332], [25, 45572], [29, 45832], [36, 46232], [45, 46592], [49, 46892], [54, 47012], [60, 47252], [63, 47492], [67, 47712], [70, 47872]]}, {"verse": 8, "start": 48671, "end": 57804, "text": "For I have given to them the words which you gave me; and they have received them, and have known surely that I came out from you, and they have believed that you did send me.", "words": [[0, 48671], [4, 48777], [6, 48937], [11, 49077], [17, 49317], [20, 49537], [25, 49757], [29, 49977], [35, 50317], [41, 50557], [45, 50717], [50, 50917], [54, 51580], [58, 51724], [63, 51884], [68, 52044], [77, 52404], [83, 53084], [87, 53304], [92, 53444], [98, 53644], [105, 54024], [110, 54344], [112, 54464], [117, 54684], [121, 54904], [126, 55124], [131, 55684], [135, 55864], [140, 56044], [145, 56165], [154, 56524], [159, 56824], [163, 57004], [167, 57224], [172, 57485]]}, {"verse": 9, "start": 58154, "end": 63790, "text": "I pray for them: I pray not for the world, but for them which you have given me; for they are yours.", "words": [[0, 58154], [2, 58279], [7, 58499], [11, 58739], [17, 59239], [19, 59402], [24, 59662], [28, 59922], [32, 60162], [36, 60262], [43, 60582], [47, 60842], [51, 61062], [56, 61262], [62, 61502], [66, 61662], [71, 61822], [77, 62062], [81, 62659], [85, 62761], [90, 62961], [94, 63141]]}, {"verse": 10, "start": 64140, "end": 68743, "text": "And all mine are yours, and yours are mine; and I am glorified in them.", "words": [[0, 64140], [4, 64265], [8, 64525], [13, 64865], [17, 65145], [24, 65805], [28, 65905], [34, 66205], [38, 66505], [44, 67175], [48, 67320], [50, 67520], [53, 67640], [63, 68160], [66, 68400]]}, {"verse": 11, "start": 69093, "end": 79629, "text": "And now I am no more in the world, but these are in the world, and I come to you. Holy Father, keep through your own name those whom you have given me, that they may be one, as we are.", "words": [[0, 69093], [4, 69240], [8, 69500], [10, 69800], [13, 69920], [16, 70120], [21, 70420], [24, 70560], [28, 70660], [35, 71260], [39, 71440], [45, 71720], [49, 71960], [52, 72100], [56, 72180], [63, 72740], [67, 72840], [69, 72980], [74, 73220], [77, 73440], [82, 73913], [87, 74169], [95, 74589], [100, 74869], [108, 75129], [113, 75309], [117, 75589], [122, 75949], [128, 76269], [133, 76529], [137, 76669], [142, 76809], [148, 77029], [152, 77569], [157, 77769], [162, 77969], [166, 78169], [169, 78349], [174, 78649], [177, 79029], [180, 79249]]}, {"verse": 12, "start": 79979, "end": 90528, "text": "While I was with them in the world, I kept them in your name: those that you gave me I have kept, and none of them is lost, but the son of perdition; that the scripture might be fulfilled.", "words": [[0, 79979], [6, 80140], [8, 80340], [12, 80500], [17, 80760], [22, 80900], [25, 81020], [29, 81120], [36, 81780], [38, 81960], [43, 82220], [48, 82460], [51, 82600], [56, 82740], [62, 83471], [68, 83713], [73, 83973], [77, 84153], [82, 84393], [85, 84633], [87, 84813], [92, 84973], [98, 85653], [102, 85733], [107, 85933], [110, 86093], [115, 86233], [118, 86413], [124, 87033], [128, 87273], [132, 87413], [136, 87733], [139, 88013], [150, 88944], [155, 89041], [159, 89181], [169, 89461], [175, 89741], [178, 89921]]}, {"verse": 13, "start": 90878, "end": 96721, "text": "And now come I to you; and these things I speak in the world, that they might have my joy fulfilled in themselves.", "words": [[0, 90878], [4, 90997], [8, 91177], [13, 91437], [15, 91617], [18, 91817], [23, 92342], [27, 92464], [33, 92684], [40, 92944], [42, 93124], [48, 93364], [51, 93544], [55, 93644], [62, 93984], [67, 94424], [72, 94564], [78, 94744], [83, 94924], [86, 95084], [90, 95304], [100, 95744], [103, 95964]]}, {"verse": 14, "start": 97071, "end": 104602, "text": "I have given them your word; and the world has hated them, because they are not of the world, even as I am not of the world.", "words": [[0, 97071], [2, 97237], [7, 97397], [13, 97677], [18, 97917], [23, 98077], [29, 98880], [33, 98988], [37, 99108], [43, 99408], [47, 99628], [53, 99988], [59, 100288], [67, 100828], [72, 101128], [76, 101248], [80, 101488], [83, 101648], [87, 101768], [94, 102328], [99, 102688], [102, 102948], [104, 103368], [107, 103608], [111, 103868], [114, 104008], [118, 104148]]}, {"verse": 15, "start": 104952, "end": 109725, "text": "I pray not that you should take them out of the world, but that you should keep them from the evil.", "words": [[0, 104952], [2, 105113], [7, 105433], [11, 105753], [16, 105973], [20, 106133], [27, 106313], [32, 106553], [37, 106753], [41, 106913], [44, 107013], [48, 107113], [55, 107673], [59, 108033], [64, 108173], [68, 108333], [75, 108493], [80, 108713], [85, 108913], [90, 109113], [94, 109273]]}, {"verse": 16, "start": 110075, "end": 113322, "text": "They are not of the world, even as I am not of the world.", "words": [[0, 110075], [5, 110275], [9, 110415], [13, 110675], [16, 110875], [20, 110995], [27, 111475], [32, 111775], [35, 111995], [37, 112235], [40, 112375], [44, 112595], [47, 112775], [51, 112875]]}, {"verse": 17, "start": 113672, "end": 116511, "text": "Sanctify them through your truth: your word is truth.", "words": [[0, 113672], [9, 114257], [14, 114477], [22, 114697], [27, 114857], [34, 115437], [39, 115581], [44, 115861], [47, 116041]]}, {"verse": 18, "start": 116861, "end": 120715, "text": "As you have sent me into the world, even so have I also sent them into the world.", "words": [[0, 116861], [3, 117025], [7, 117145], [12, 117265], [17, 117465], [20, 117645], [25, 117785], [29, 117905], [36, 118405], [41, 118565], [44, 118865], [49, 119045], [51, 119165], [56, 119485], [61, 119805], [66, 119985], [71, 120145], [75, 120265]]}, {"verse": 19, "start": 121065, "end": 125560, "text": "And for their sakes I sanctify myself, that they also might be sanctified through the truth.", "words": [[0, 121065], [4, 121170], [8, 121290], [14, 121430], [20, 121790], [22, 121930], [31, 122430], [39, 123190], [44, 123330], [49, 123450], [54, 123810], [60, 124030], [63, 124170], [74, 124790], [82, 124990], [86, 125110]]}, {"verse": 20, "start": 125910, "end": 130697, "text": "Neither pray I for these alone, but for them also which shall believe on me through their word;", "words": [[0, 125910], [8, 126113], [13, 126433], [15, 126653], [19, 126813], [25, 126973], [32, 127753], [36, 127873], [40, 128033], [45, 128153], [50, 128513], [56, 128793], [62, 129033], [70, 129333], [73, 129533], [76, 129753], [84, 129993], [90, 130193]]}, {"verse": 21, "start": 131047, "end": 140739, "text": "That they all may be one; as you, Father, are in me, and I in you, that they also may be one in us: that the world may believe that you have sent me.", "words": [[0, 131047], [5, 131154], [10, 131314], [14, 131574], [18, 131814], [21, 131974], [26, 132673], [29, 132871], [34, 133091], [42, 133831], [46, 134011], [49, 134231], [53, 134451], [57, 134911], [59, 135291], [62, 135591], [67, 136251], [72, 136491], [77, 136631], [82, 136931], [86, 137171], [89, 137311], [93, 137571], [96, 137851], [100, 138541], [105, 138641], [109, 138741], [115, 139001], [119, 139181], [127, 139641], [132, 139861], [136, 140021], [141, 140161], [146, 140421]]}, {"verse": 22, "start": 141089, "end": 146746, "text": "And the glory which you gave me I have given them; that they may be one, even as we are one:", "words": [[0, 141089], [4, 141196], [8, 141316], [14, 141636], [20, 141896], [24, 142056], [29, 142276], [32, 142856], [34, 143036], [39, 143216], [45, 143476], [51, 144146], [56, 144246], [61, 144406], [65, 144586], [68, 144746], [73, 145446], [78, 145646], [81, 145886], [84, 146086], [88, 146266]]}, {"verse": 23, "start": 147096, "end": 156482, "text": "I in them, and you in me, that they may be made perfect in one; and that the world may know that you have sent me, and have loved them, as you have loved me.", "words": [[0, 147096], [2, 147422], [5, 147722], [11, 148022], [15, 148442], [19, 148762], [22, 149082], [26, 149682], [31, 149942], [36, 150122], [40, 150282], [43, 150422], [48, 150642], [56, 151022], [59, 151282], [64, 151954], [68, 152076], [73, 152216], [77, 152356], [83, 152636], [87, 152856], [92, 153136], [97, 153356], [101, 153516], [106, 153676], [111, 153936], [115, 154156], [119, 154516], [124, 154676], [130, 154916], [136, 155176], [139, 155516], [143, 155736], [148, 155896], [154, 156096]]}, {"verse": 24, "start": 156832, "end": 167822, "text": "Father, I will that they also, whom you have given me, be with me where I am; that they may behold my glory, which you have given me: for you loved me before the foundation of the world.", "words": [[0, 156832], [8, 157087], [10, 157427], [15, 157687], [20, 157987], [25, 158147], [31, 159107], [36, 159267], [40, 159507], [45, 159667], [51, 159927], [55, 160547], [58, 160647], [63, 160887], [66, 161087], [72, 161347], [74, 161627], [78, 162218], [83, 162320], [88, 162480], [92, 162660], [99, 162980], [102, 163260], [109, 163700], [115, 164140], [119, 164320], [124, 164480], [130, 164720], [134, 165351], [138, 165411], [142, 165531], [148, 165791], [151, 166031], [158, 166331], [162, 166491], [173, 166991], [176, 167211], [180, 167291]]}, {"verse": 25, "start": 168172, "end": 174133, "text": "O righteous Father, the world has not known you: but I have known you, and these have known that you have sent me.", "words": [[0, 168172], [2, 168296], [12, 168596], [20, 169396], [24, 169496], [30, 169756], [34, 169956], [38, 170176], [44, 170396], [49, 171007], [53, 171168], [55, 171308], [60, 171548], [66, 171768], [71, 172368], [75, 172488], [81, 172648], [86, 172848], [92, 173068], [97, 173308], [101, 173468], [106, 173568], [111, 173788]]}, {"verse": 26, "start": 174483, "end": 182338, "text": "And I have declared to them your name, and will declare it: that the love with which you have loved me may be in them, and I in them.", "words": [[0, 174483], [4, 174608], [6, 174808], [11, 174968], [20, 175348], [23, 175608], [28, 175788], [33, 175968], [39, 176328], [43, 176828], [48, 177048], [56, 177448], [60, 178087], [65, 178191], [69, 178331], [74, 178651], [79, 178851], [85, 179091], [89, 179271], [94, 179411], [100, 179691], [103, 179971], [107, 180271], [110, 180471], [113, 180751], [119, 181231], [123, 181471], [125, 181731], [128, 181971]]}]}