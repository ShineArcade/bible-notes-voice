{"book": "PSA", "chapter": 48, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 92748, "verses": [{"verse": 1, "start": 300, "end": 11283, "text": "Canción: Salmo de los hijos de Coré. GRANDE es Jehová y digno de ser en gran manera alabado, en la ciudad de nuestro Dios, en el monte de su santuario.", "words": [[0, 300], [9, 1297], [15, 1778], [18, 1898], [22, 2018], [28, 2338], [31, 2745], [37, 3372], [44, 3598], [47, 3858], [54, 4518], [56, 4618], [62, 5138], [65, 5218], [69, 5518], [72, 5818], [77, 6058], [84, 6458], [93, 7338], [96, 7838], [99, 7998], [106, 8298], [109, 8618], [117, 8798], [123, 9298], [126, 9618], [129, 9738], [135, 10038], [138, 10258], [141, 10398]]}, {"verse": 2, "start": 11633, "end": 19782, "text": "Hermosa provincia, el gozo de toda la tierra es el monte de Sion, a los lados del norte, la ciudad del gran Rey.", "words": [[0, 11633], [8, 12081], [19, 12591], [22, 13101], [27, 13421], [30, 13581], [35, 13821], [38, 14061], [45, 14381], [48, 14761], [51, 14921], [57, 15221], [60, 15831], [66, 16441], [68, 16521], [72, 16661], [78, 16961], [82, 17221], [89, 18161], [92, 18261], [99, 18657], [103, 19053], [108, 19448]]}, {"verse": 3, "start": 20132, "end": 23386, "text": "Dios en sus palacios es conocido por refugio.", "words": [[0, 20132], [5, 20480], [8, 20840], [12, 21060], [21, 21700], [24, 21820], [33, 22420], [37, 22640]]}, {"verse": 4, "start": 23736, "end": 28022, "text": "Porque he aquí los reyes de la tierra se reunieron; pasaron todos.", "words": [[0, 23736], [7, 23843], [10, 23983], [15, 24223], [19, 24583], [25, 24923], [28, 25063], [31, 25163], [38, 25503], [41, 25683], [52, 26760], [60, 27162]]}, {"verse": 5, "start": 28372, "end": 33997, "text": "Y viéndola ellos así, se maravillaron, se turbaron, se dieron prisa a huir.", "words": [[0, 28372], [2, 28477], [11, 28977], [17, 29317], [22, 30137], [25, 30297], [39, 31337], [42, 31417], [52, 32217], [55, 32317], [62, 32637], [68, 33177], [70, 33587]]}, {"verse": 6, "start": 34347, "end": 37859, "text": "Los tomó allí temblor; dolor, como a mujer que pare.", "words": [[0, 34347], [4, 34446], [9, 34826], [14, 34986], [23, 35837], [30, 36181], [35, 36641], [37, 36801], [43, 37061], [47, 37301]]}, {"verse": 7, "start": 38209, "end": 42324, "text": "Con viento solano quiebras tú las naves de Tarsis.", "words": [[0, 38209], [4, 38334], [11, 38834], [18, 39384], [27, 39934], [30, 40234], [34, 40714], [40, 41274], [43, 41534]]}, {"verse": 8, "start": 42674, "end": 52483, "text": "Como lo oímos, así hemos visto en la ciudad de Jehová de los ejércitos, en la ciudad de nuestro Dios: la afirmará Dios para siempre. (Selah.)", "words": [[0, 42674], [5, 42858], [8, 43078], [15, 43638], [19, 44078], [25, 44238], [31, 44618], [34, 44778], [37, 44918], [44, 45198], [47, 45498], [54, 45938], [57, 46018], [61, 46158], [72, 47358], [75, 47498], [78, 47658], [85, 47998], [88, 48338], [96, 48498], [102, 49464], [105, 49653], [114, 50313], [119, 50573], [124, 50913], [133, 52222]]}, {"verse": 9, "start": 52833, "end": 57316, "text": "Esperamos tu misericordia, oh Dios, en medio de tu templo.", "words": [[0, 52833], [10, 53455], [13, 53675], [27, 54285], [30, 54895], [36, 55175], [39, 55815], [45, 56175], [48, 56415], [51, 56575]]}, {"verse": 10, "start": 57666, "end": 65911, "text": "Conforme a tu nombre, oh Dios, así es tu alabanza hasta los fines de la tierra: de justicia está llena tu diestra.", "words": [[0, 57666], [9, 58250], [11, 58290], [14, 58390], [22, 59350], [25, 59650], [31, 60370], [35, 60610], [38, 60790], [41, 60990], [50, 61710], [56, 62010], [60, 62210], [66, 62530], [69, 62730], [72, 62850], [80, 63738], [83, 63847], [92, 64387], [97, 64627], [103, 65007], [106, 65167]]}, {"verse": 11, "start": 66261, "end": 71703, "text": "Se alegrará el monte de Sion; se gozarán las hijas de Judá por tus juicios.", "words": [[0, 66261], [3, 66425], [12, 67025], [15, 67285], [21, 67625], [24, 67805], [30, 68681], [33, 68820], [41, 69340], [45, 69520], [51, 69960], [54, 70160], [59, 70580], [63, 70780], [67, 70980]]}, {"verse": 12, "start": 72053, "end": 76675, "text": "Andad alrededor de Sion, y rodeadla: contad sus torres.", "words": [[0, 72053], [6, 72508], [16, 72928], [19, 73448], [25, 73788], [27, 74028], [37, 75148], [44, 75655], [48, 76165]]}, {"verse": 13, "start": 77025, "end": 84121, "text": "Poned vuestro corazón a sus murallas, mirad sus palacios; para que lo contéis a la generación venidera.", "words": [[0, 77025], [6, 77349], [14, 77729], [22, 78149], [24, 78489], [28, 78689], [38, 79689], [44, 80049], [48, 80289], [58, 81521], [63, 81660], [67, 81780], [70, 81900], [78, 82440], [80, 82660], [83, 82760], [94, 83360]]}, {"verse": 14, "start": 84471, "end": 92348, "text": "Porque este Dios es Dios nuestro eternamente y para siempre: él nos capitaneará hasta la muerte.", "words": [[0, 84471], [7, 84673], [12, 84853], [17, 85153], [20, 85433], [25, 85913], [33, 86953], [45, 88193], [47, 88333], [52, 88553], [61, 89667], [64, 90012], [68, 90132], [80, 91112], [86, 91452], [89, 91632]]}]}