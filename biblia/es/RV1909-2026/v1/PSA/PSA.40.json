{"book": "PSA", "chapter": 40, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 144331, "verses": [{"verse": 1, "start": 300, "end": 8672, "text": "Al Músico principal: Salmo de David. PACIENTEMENTE esperé a Jehová, y se inclinó a mí, y oyó mi clamor.", "words": [[0, 300], [3, 487], [10, 987], [21, 2081], [27, 2619], [30, 2779], [37, 3419], [51, 4145], [58, 4865], [60, 5025], [68, 5585], [70, 5885], [73, 6065], [81, 6785], [83, 6905], [87, 7085], [89, 7665], [93, 7965], [96, 8085]]}, {"verse": 2, "start": 9022, "end": 18209, "text": "Y me hizo sacar de un lago de miseria, del lodo cenagoso; y puso mis pies sobre peña, y enderezó mis pasos.", "words": [[0, 9022], [2, 9146], [5, 9266], [10, 9566], [16, 9906], [19, 10186], [22, 10306], [27, 10626], [30, 10786], [39, 11826], [43, 12546], [48, 13294], [58, 14205], [60, 14350], [65, 14710], [69, 14910], [74, 15250], [80, 15740], [86, 16230], [88, 16710], [97, 17330], [101, 17470]]}, {"verse": 3, "start": 18559, "end": 26277, "text": "Puso luego en mi boca canción nueva, alabanza a nuestro Dios. Verán esto muchos, y temerán, y esperarán en Jehová.", "words": [[0, 18559], [5, 18844], [11, 19104], [14, 19324], [17, 19464], [22, 19704], [30, 20064], [37, 20814], [46, 21564], [48, 21684], [56, 21824], [62, 22740], [68, 23149], [73, 23442], [81, 23736], [83, 24029], [92, 24629], [94, 25029], [104, 25609], [107, 25709]]}, {"verse": 4, "start": 26627, "end": 34406, "text": "Bienaventurado el hombre que puso a Jehová por su confianza, y no mira a los soberbios, ni a los que declinan a la mentira.", "words": [[0, 27152], [15, 27712], [18, 27892], [25, 28192], [29, 28392], [34, 28772], [36, 28892], [43, 29332], [47, 29452], [50, 29652], [61, 30412], [63, 30532], [66, 30672], [71, 30912], [73, 31192], [77, 31352], [88, 32172], [91, 32672], [93, 32772], [97, 32912], [101, 33272], [110, 33632], [112, 33692], [115, 33792]]}, {"verse": 5, "start": 34756, "end": 47038, "text": "Aumentado has tú, oh Jehová Dios mío, tus maravillas; y tus pensamientos para con nosotros, no te los podremos contar: si yo los anuncio y hablo de ellos, no pueden ser enumerados.", "words": [[0, 34881], [10, 35211], [14, 35541], [18, 35866], [21, 36191], [28, 36516], [33, 36841], [38, 37121], [42, 37321], [54, 38923], [56, 39026], [60, 39166], [73, 39966], [78, 40246], [82, 40486], [92, 41306], [95, 41626], [98, 41766], [102, 41866], [111, 42286], [119, 43167], [122, 43311], [125, 43491], [129, 43671], [137, 44151], [139, 44291], [145, 44531], [148, 44691], [155, 45291], [158, 45511], [165, 45831], [169, 46071]]}, {"verse": 6, "start": 47388, "end": 54720, "text": "Sacrificio y ofrenda no te agrada; has abierto mis oídos; holocausto y expiación no has pedido.", "words": [[0, 47848], [11, 48208], [13, 48328], [21, 48828], [24, 48908], [27, 49028], [35, 49836], [39, 50099], [47, 50559], [51, 50759], [58, 51749], [69, 52454], [71, 52634], [81, 53334], [84, 53714], [88, 53934]]}, {"verse": 7, "start": 55070, "end": 60705, "text": "Entonces dije: He aquí, vengo; en el envoltorio del libro está escrito de mí:", "words": [[0, 55070], [9, 55539], [15, 56455], [18, 56565], [24, 56865], [31, 58027], [34, 58175], [37, 58295], [48, 59015], [52, 59115], [58, 59495], [63, 59775], [71, 60115], [74, 60395]]}, {"verse": 8, "start": 61055, "end": 68277, "text": "El hacer tu voluntad, Dios mío, me ha agradado; y tu ley está en medio de mis entrañas.", "words": [[0, 61055], [3, 61238], [9, 61598], [12, 61858], [22, 62777], [27, 63098], [32, 63898], [35, 64037], [38, 64257], [48, 65228], [50, 65350], [53, 65470], [57, 65810], [62, 66230], [65, 66490], [71, 66810], [74, 67070], [78, 67210]]}, {"verse": 9, "start": 68627, "end": 75458, "text": "Anunciado he justicia en grande congregación: he aquí no detuve mis labios, Jehová, tú lo sabes.", "words": [[0, 68627], [10, 69083], [13, 69563], [22, 70183], [25, 70363], [32, 70603], [46, 72102], [49, 72172], [54, 72452], [57, 72672], [64, 73152], [68, 73372], [76, 73992], [84, 74492], [87, 74612], [90, 74752]]}, {"verse": 10, "start": 75808, "end": 86256, "text": "No encubrí tu justicia dentro de mi corazón: tu verdad y tu salvación he dicho: no oculté tu misericordia y tu verdad en gran asamblea.", "words": [[0, 75808], [3, 76278], [11, 76748], [14, 76908], [23, 77608], [30, 77868], [33, 78208], [36, 78308], [45, 79317], [48, 79401], [55, 79781], [57, 80341], [60, 80461], [70, 81201], [73, 81381], [80, 82187], [83, 82514], [90, 82874], [93, 83014], [106, 83934], [108, 84074], [111, 84214], [118, 84554], [121, 84934], [126, 85154]]}, {"verse": 11, "start": 86606, "end": 93976, "text": "Tú, Jehová, no apartes de mí tus misericordias: tu misericordia y tu verdad me guarden siempre.", "words": [[0, 86606], [4, 87006], [12, 87866], [15, 87966], [23, 88486], [26, 88646], [29, 88806], [33, 88966], [48, 90430], [51, 90681], [64, 91541], [66, 91701], [69, 91861], [76, 92201], [79, 92741], [87, 93241]]}, {"verse": 12, "start": 94326, "end": 106579, "text": "Porque me han cercado males hasta no haber cuento: me han alcanzado mis maldades, y no puedo levantar la vista: se han aumentado más que los cabellos de mi cabeza, y mi corazón me falta.", "words": [[0, 94326], [7, 94551], [10, 94771], [14, 94911], [22, 95531], [28, 96151], [34, 96471], [37, 96711], [43, 96931], [51, 97889], [54, 98149], [58, 98289], [68, 99029], [72, 99209], [82, 99949], [84, 100209], [87, 100349], [93, 100609], [102, 101189], [105, 101309], [112, 102116], [115, 102258], [119, 102418], [129, 103018], [133, 103198], [137, 103338], [141, 103478], [150, 103958], [153, 104058], [156, 104178], [164, 104658], [166, 105138], [169, 105278], [177, 105698], [180, 105938]]}, {"verse": 13, "start": 106929, "end": 111674, "text": "Quieras, oh Jehová, librarme; Jehová, apresúrate a socorrerme.", "words": [[0, 106929], [9, 107231], [12, 107571], [20, 107911], [30, 108826], [38, 109626], [49, 110286], [51, 110786]]}, {"verse": 14, "start": 112024, "end": 121147, "text": "Sean avergonzados y confusos a una los que buscan mi vida para cortarla: vuelvan atrás y avergüéncense los que mi mal desean.", "words": [[0, 112024], [5, 112323], [18, 113403], [20, 113603], [29, 114563], [31, 114643], [35, 114723], [39, 114843], [43, 114983], [50, 115343], [53, 115523], [58, 115783], [63, 116003], [73, 117170], [81, 117557], [87, 117937], [89, 118707], [103, 119477], [107, 119817], [111, 120037], [114, 120197], [118, 120457]]}, {"verse": 15, "start": 121497, "end": 126371, "text": "Sean asolados en pago de su afrenta los que me dicen: ¡Ea, ea!", "words": [[0, 121497], [5, 121781], [14, 122621], [17, 122941], [22, 123401], [25, 123541], [28, 123911], [36, 124281], [40, 124401], [44, 124561], [47, 124721], [54, 125784], [59, 126078]]}, {"verse": 16, "start": 126651, "end": 134874, "text": "Gócense y alégrense en ti todos los que te buscan; y digan siempre los que aman tu salvación: Jehová sea enaltecido.", "words": [[0, 126651], [8, 127376], [10, 127636], [20, 128336], [23, 128496], [26, 128656], [32, 129036], [36, 129356], [40, 129496], [43, 129636], [51, 130472], [53, 130571], [59, 130911], [67, 131251], [71, 131491], [75, 131691], [80, 131871], [83, 132091], [94, 133521], [101, 133988], [105, 134456]]}, {"verse": 17, "start": 135154, "end": 143931, "text": "Aunque afligido yo y necesitado, Jehová pensará en mí: mi ayuda y mi libertador eres tú; Dios mío, no te tardes.", "words": [[0, 135154], [7, 135398], [16, 136058], [19, 136278], [21, 136398], [33, 137698], [40, 138458], [48, 139018], [51, 139118], [55, 139694], [58, 139838], [64, 140178], [66, 140398], [69, 140518], [80, 141278], [85, 141578], [89, 142302], [94, 142429], [99, 143029], [102, 143109], [105, 143229]]}]}