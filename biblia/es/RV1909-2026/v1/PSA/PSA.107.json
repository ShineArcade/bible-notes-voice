{"book": "PSA", "chapter": 107, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 255238, "verses": [{"verse": 1, "start": 300, "end": 6083, "text": "Alabad a Jehová, porque es bueno; porque para siempre es su misericordia.", "words": [[0, 606], [7, 926], [9, 1186], [17, 1746], [24, 2046], [27, 2286], [34, 3132], [41, 3337], [46, 3597], [54, 4177], [57, 4797], [60, 4957]]}, {"verse": 2, "start": 6533, "end": 11573, "text": "Díganlo los redimidos de Jehová, los que ha redimido del poder del enemigo,", "words": [[0, 6533], [8, 7056], [12, 7256], [22, 7876], [25, 8036], [33, 8836], [37, 8916], [41, 9096], [44, 9276], [53, 10076], [57, 10256], [63, 10576], [67, 10836]]}, {"verse": 3, "start": 12023, "end": 17573, "text": "Y los ha congregado de las tierras, del oriente y del occidente, del norte y del mar.", "words": [[0, 12023], [2, 12116], [6, 12236], [9, 12456], [20, 13156], [23, 13296], [27, 13436], [36, 14416], [40, 14676], [48, 15136], [50, 15296], [54, 15416], [65, 16176], [69, 16316], [75, 16776], [77, 16976], [81, 17156]]}, {"verse": 4, "start": 18023, "end": 24535, "text": "Anduvieron perdidos por el desierto, por la soledad sin camino, no hallando ciudad de población.", "words": [[0, 18023], [11, 18742], [20, 19342], [24, 19562], [27, 19702], [37, 20362], [41, 20482], [44, 20622], [52, 21162], [56, 21302], [64, 22142], [67, 22242], [76, 22722], [83, 23122], [86, 23442]]}, {"verse": 5, "start": 24985, "end": 29225, "text": "Hambrientos y sedientos, su alma desfallecía en ellos.", "words": [[0, 24985], [12, 25829], [14, 26009], [25, 26689], [28, 27109], [33, 27429], [45, 28409], [48, 28589]]}, {"verse": 6, "start": 29675, "end": 35265, "text": "Pero habiendo clamado a Jehová en su angustia, los libró de sus aflicciones:", "words": [[0, 29675], [5, 29822], [14, 30182], [22, 30542], [24, 30922], [31, 31362], [34, 31482], [37, 31662], [47, 32742], [51, 32882], [57, 33622], [60, 33782], [64, 33962]]}, {"verse": 7, "start": 35715, "end": 40840, "text": "Y los dirigió por camino derecho, para que viniesen a ciudad de población.", "words": [[0, 35715], [2, 35823], [6, 35983], [14, 36583], [18, 36803], [25, 37163], [34, 37763], [39, 38403], [43, 38603], [52, 39123], [54, 39323], [61, 39643], [64, 39983]]}, {"verse": 8, "start": 41290, "end": 46844, "text": "Alaben la misericordia de Jehová, y sus maravillas para con los hijos de los hombres.", "words": [[0, 41457], [7, 41657], [10, 41837], [23, 42637], [26, 42737], [34, 43677], [36, 43877], [40, 44017], [51, 44697], [56, 45097], [60, 45357], [64, 45557], [70, 45857], [73, 46017], [77, 46157]]}, {"verse": 9, "start": 47294, "end": 52992, "text": "Porque sació al alma menesterosa, y llenó de bien al alma hambrienta.", "words": [[0, 47294], [7, 47500], [13, 48080], [16, 48320], [21, 48940], [34, 49560], [36, 50320], [42, 50740], [45, 50880], [50, 51140], [53, 51480], [58, 51800]]}, {"verse": 10, "start": 53442, "end": 59814, "text": "Los que moraban en tinieblas y sombra de muerte, aprisionados en aflicción y en hierros;", "words": [[0, 53442], [4, 53549], [8, 53689], [16, 54209], [19, 54659], [29, 55109], [31, 55229], [38, 55709], [41, 55829], [49, 57149], [62, 57629], [65, 57849], [75, 58549], [77, 58789], [80, 58949]]}, {"verse": 11, "start": 60264, "end": 66545, "text": "Por cuanto fueron rebeldes a las palabras de Jehová, y aborrecieron el consejo del Altísimo,", "words": [[0, 60264], [4, 60408], [11, 60708], [18, 61168], [27, 61868], [29, 62028], [33, 62148], [42, 62528], [45, 62828], [53, 63508], [55, 63728], [68, 64628], [71, 64788], [79, 65448], [83, 65648]]}, {"verse": 12, "start": 66995, "end": 73141, "text": "Por lo que quebrantó él con trabajo sus corazones, cayeron y no hubo quien les ayudase;", "words": [[0, 66995], [4, 67157], [7, 67277], [11, 67437], [21, 68097], [24, 68317], [28, 68557], [36, 68937], [40, 69197], [51, 70027], [59, 70857], [61, 71357], [64, 71537], [69, 71837], [75, 72017], [79, 72257]]}, {"verse": 13, "start": 73591, "end": 78597, "text": "Luego que clamaron a Jehová en su angustia, los libró de sus aflicciones.", "words": [[0, 73591], [6, 73811], [10, 74051], [19, 74531], [21, 74691], [28, 74991], [31, 75091], [34, 75231], [44, 76291], [48, 76491], [54, 77151], [57, 77251], [61, 77411]]}, {"verse": 14, "start": 79047, "end": 84046, "text": "Los sacó de las tinieblas y de la sombra de muerte, y rompió sus prisiones.", "words": [[0, 79141], [4, 79271], [9, 79711], [12, 79811], [16, 79971], [26, 80631], [28, 80771], [31, 80851], [34, 80991], [41, 81411], [44, 81551], [52, 82011], [54, 82431], [61, 82971], [65, 83131]]}, {"verse": 15, "start": 84496, "end": 90051, "text": "Alaben la misericordia de Jehová, y sus maravillas para con los hijos de los hombres.", "words": [[0, 84664], [7, 84864], [10, 85044], [23, 85844], [26, 85944], [34, 86884], [36, 87084], [40, 87224], [51, 87904], [56, 88304], [60, 88564], [64, 88764], [70, 89064], [73, 89224], [77, 89364]]}, {"verse": 16, "start": 90501, "end": 96459, "text": "Porque quebrantó las puertas de bronce, y desmenuzó los cerrojos de hierro.", "words": [[0, 90501], [7, 90803], [17, 91723], [21, 91883], [29, 92423], [32, 92603], [40, 93203], [42, 93683], [52, 94743], [56, 95193], [65, 95643], [68, 95843]]}, {"verse": 17, "start": 96909, "end": 104391, "text": "Los insensatos, a causa del camino de su rebelión y a causa de sus maldades, fueron afligidos.", "words": [[0, 96909], [4, 97484], [16, 98094], [18, 98294], [24, 98574], [28, 98894], [35, 99254], [38, 99454], [41, 99634], [50, 100314], [52, 100814], [54, 100934], [60, 101514], [63, 101754], [67, 101954], [77, 102794], [84, 103354]]}, {"verse": 18, "start": 104841, "end": 109074, "text": "Su alma abominó toda comida, y llegaron hasta las puertas de la muerte.", "words": [[0, 104841], [3, 105002], [8, 105302], [16, 106162], [21, 106402], [29, 106862], [31, 107102], [40, 107542], [46, 107742], [50, 107902], [58, 108322], [61, 108442], [64, 108562]]}, {"verse": 19, "start": 109524, "end": 114266, "text": "Pero clamaron a Jehová en su angustia, y los salvó de sus aflicciones.", "words": [[0, 109524], [5, 109858], [14, 110228], [16, 110388], [23, 110868], [26, 111008], [29, 111168], [39, 111868], [41, 112208], [45, 112368], [51, 112908], [54, 112988], [58, 113148]]}, {"verse": 20, "start": 114716, "end": 119072, "text": "Envió su palabra, y los curó, y los libró de su ruina.", "words": [[0, 114716], [6, 115100], [9, 115300], [18, 115800], [20, 116000], [24, 116160], [30, 116680], [32, 117420], [36, 117620], [42, 118140], [45, 118220], [48, 118400]]}, {"verse": 21, "start": 119522, "end": 124961, "text": "Alaben la misericordia de Jehová, y sus maravillas para con los hijos de los hombres:", "words": [[0, 119733], [7, 119983], [10, 120223], [23, 121123], [26, 121243], [34, 121923], [36, 122123], [40, 122283], [51, 122943], [56, 123203], [60, 123443], [64, 123643], [70, 123923], [73, 124103], [77, 124223]]}, {"verse": 22, "start": 125411, "end": 129582, "text": "Y sacrifiquen sacrificios de alabanza, y publiquen sus obras con júbilo.", "words": [[0, 125411], [2, 125796], [14, 126216], [26, 126916], [29, 127036], [39, 127576], [41, 127866], [51, 128156], [55, 128316], [61, 128616], [65, 128876]]}, {"verse": 23, "start": 130032, "end": 134794, "text": "Los que descienden al mar en naves, y hacen negocio en las muchas aguas,", "words": [[0, 130032], [4, 130320], [8, 130460], [19, 131020], [22, 131260], [26, 131460], [29, 131680], [36, 132140], [38, 132620], [44, 132840], [52, 133580], [55, 133740], [59, 133820], [66, 134080]]}, {"verse": 24, "start": 135244, "end": 139729, "text": "Ellos han visto las obras de Jehová, y sus maravillas en el profundo.", "words": [[0, 135244], [6, 135468], [10, 135728], [16, 135988], [20, 136208], [26, 136508], [29, 136688], [37, 137508], [39, 137748], [43, 137888], [54, 138508], [57, 138728], [60, 138868]]}, {"verse": 25, "start": 140179, "end": 145767, "text": "Él dijo, e hizo saltar el viento de la tempestad, que levanta sus ondas.", "words": [[0, 140179], [3, 140383], [9, 140803], [11, 141243], [16, 141663], [23, 142563], [26, 142643], [33, 143103], [36, 143243], [39, 143383], [50, 144083], [54, 144423], [62, 144903], [66, 145043]]}, {"verse": 26, "start": 146217, "end": 153389, "text": "Suben a los cielos, descienden a los abismos: sus almas se derriten con el mal.", "words": [[0, 146217], [6, 146857], [8, 147057], [12, 147197], [20, 148457], [31, 149297], [33, 149597], [37, 149717], [46, 150821], [50, 150984], [56, 151504], [59, 151884], [68, 152564], [72, 152724], [75, 152924]]}, {"verse": 27, "start": 153839, "end": 159778, "text": "Tiemblan, y titubean como borrachos, y de nada les sirve toda su pericia.", "words": [[0, 153839], [10, 154404], [12, 154704], [21, 155424], [26, 155684], [37, 156544], [39, 157384], [42, 157504], [47, 157724], [51, 157944], [57, 158344], [62, 158624], [65, 158944]]}, {"verse": 28, "start": 160228, "end": 164401, "text": "Pero claman a Jehová en su angustia, y los libra de sus aflicciones.", "words": [[0, 160228], [5, 160397], [12, 160837], [14, 160977], [21, 161357], [24, 161457], [27, 161597], [37, 162217], [39, 162377], [43, 162537], [49, 162917], [52, 163057], [56, 163237]]}, {"verse": 29, "start": 164851, "end": 169304, "text": "Hace parar la tempestad en sosiego, y se apaciguan sus ondas.", "words": [[0, 165077], [5, 165343], [11, 165610], [14, 165710], [24, 166350], [27, 166780], [36, 167210], [38, 167630], [41, 168010], [51, 168390], [55, 168590]]}, {"verse": 30, "start": 169754, "end": 176073, "text": "Alégranse luego porque se reposaron; y él los guía al puerto que deseaban.", "words": [[0, 169754], [10, 170651], [16, 170911], [23, 171291], [26, 171471], [37, 172762], [39, 172944], [42, 173164], [46, 173564], [51, 174024], [54, 174284], [61, 174824], [65, 175044]]}, {"verse": 31, "start": 176523, "end": 182077, "text": "Alaben la misericordia de Jehová, y sus maravillas para con los hijos de los hombres.", "words": [[0, 176690], [7, 176890], [10, 177070], [23, 177870], [26, 177970], [34, 178910], [36, 179110], [40, 179250], [51, 179930], [56, 180330], [60, 180590], [64, 180790], [70, 181090], [73, 181250], [77, 181390]]}, {"verse": 32, "start": 182527, "end": 189727, "text": "Y ensálcenlo en la congregación del pueblo; y en asamblea de ancianos lo alaben.", "words": [[0, 182527], [2, 182787], [13, 183807], [16, 184047], [19, 184597], [32, 185147], [36, 185387], [44, 186609], [46, 186815], [49, 186975], [58, 187875], [61, 187975], [70, 188635], [73, 188955]]}, {"verse": 33, "start": 190177, "end": 195431, "text": "El vuelve los ríos en desierto, y los manantiales de las aguas en lugares secos;", "words": [[0, 190177], [3, 190365], [10, 190785], [14, 190925], [19, 191345], [22, 191505], [32, 192165], [34, 192645], [38, 192785], [50, 193525], [53, 193605], [57, 193725], [63, 194145], [66, 194265], [74, 194565]]}, {"verse": 34, "start": 195881, "end": 201300, "text": "La tierra fructífera en terreno salado, por la maldad de los que la habitan.", "words": [[0, 195881], [3, 196007], [10, 196347], [21, 197387], [24, 197627], [32, 198047], [40, 198647], [44, 199267], [47, 199427], [54, 199887], [57, 200107], [61, 200247], [65, 200387], [68, 200547]]}, {"verse": 35, "start": 201750, "end": 207333, "text": "Vuelve el desierto en estanques de aguas, y la tierra seca en manantiales.", "words": [[0, 201750], [7, 202450], [10, 202690], [19, 203350], [22, 203530], [32, 204150], [35, 204330], [42, 204870], [44, 205250], [47, 205370], [54, 205650], [59, 206170], [62, 206290]]}, {"verse": 36, "start": 207783, "end": 212906, "text": "Y allí aposenta a los hambrientos, y disponen ciudad para habitación;", "words": [[0, 207783], [2, 207967], [7, 208227], [16, 209047], [18, 209247], [22, 209367], [35, 210347], [37, 210817], [46, 211287], [53, 211687], [58, 212107]]}, {"verse": 37, "start": 213356, "end": 218100, "text": "Y siembran campos, y plantan viñas, y rinden crecido fruto.", "words": [[0, 213356], [2, 213556], [11, 214016], [19, 214656], [21, 214836], [29, 215336], [36, 215916], [38, 216336], [45, 216756], [53, 217436]]}, {"verse": 38, "start": 218550, "end": 223880, "text": "Y los bendice, y se multiplican en gran manera; y no disminuye sus bestias.", "words": [[0, 218550], [2, 218648], [6, 218768], [15, 219368], [17, 219708], [20, 219828], [32, 220588], [35, 220708], [40, 220888], [48, 221810], [50, 221995], [53, 222415], [63, 222835], [67, 223015]]}, {"verse": 39, "start": 224330, "end": 229296, "text": "Y luego son menoscabados y abatidos a causa de tiranía, de males y congojas.", "words": [[0, 224330], [2, 224439], [8, 224619], [12, 225229], [25, 225839], [27, 226019], [36, 226539], [38, 226699], [44, 226979], [47, 227259], [56, 227859], [59, 227999], [65, 228279], [67, 228499]]}, {"verse": 40, "start": 229746, "end": 236920, "text": "El derrama menosprecio sobre los príncipes, y les hace andar errados, vagabundos, sin camino:", "words": [[0, 229746], [3, 230067], [11, 230657], [23, 231247], [29, 231587], [33, 231787], [44, 232487], [46, 232867], [50, 233047], [55, 233587], [61, 234107], [70, 234927], [82, 235747], [86, 236187]]}, {"verse": 41, "start": 237370, "end": 244005, "text": "Y levanta al pobre de la miseria, y hace multiplicar las familias como rebaños de ovejas.", "words": [[0, 237370], [2, 237494], [10, 237954], [13, 238074], [19, 238354], [22, 238554], [25, 238654], [34, 239194], [36, 239314], [41, 239474], [53, 240434], [57, 240554], [66, 241054], [71, 241234], [79, 241794], [82, 241914]]}, {"verse": 42, "start": 244455, "end": 248371, "text": "Vean los rectos, y alégrense; y toda maldad cierre su boca.", "words": [[0, 244475], [5, 244530], [9, 244585], [17, 244640], [19, 244780], [30, 245949], [32, 246098], [37, 246318], [44, 246968], [51, 247618], [54, 247798]]}, {"verse": 43, "start": 248821, "end": 254837, "text": "¿Quién es sabio y guardará estas cosas, y entenderá las misericordias de Jehová?", "words": [[0, 248821], [7, 249025], [10, 249305], [16, 249905], [18, 250385], [27, 250865], [33, 251065], [40, 251665], [42, 252425], [52, 253085], [56, 253225], [70, 254065], [73, 254225]]}]}