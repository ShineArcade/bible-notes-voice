{"book": "PSA", "chapter": 106, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 268262, "verses": [{"verse": 1, "start": 300, "end": 6609, "text": "Praise the LORD. O give thanks to the LORD; for he is good: for his mercy endures for ever.", "words": [[0, 300], [7, 507], [11, 847], [17, 1688], [19, 1808], [24, 1968], [31, 2308], [34, 2568], [38, 2708], [44, 3467], [48, 3593], [51, 3773], [54, 3913], [60, 4706], [64, 4826], [68, 4986], [74, 5386], [82, 5816], [86, 6245]]}, {"verse": 2, "start": 7059, "end": 11754, "text": "Who can utter the mighty acts of the LORD? who can show forth all his praise?", "words": [[0, 7059], [4, 7168], [8, 7348], [14, 7628], [18, 7848], [25, 8148], [30, 8568], [33, 8728], [37, 8888], [43, 9675], [47, 9782], [51, 9923], [56, 10202], [62, 10522], [66, 10862], [70, 11042]]}, {"verse": 3, "start": 12204, "end": 17164, "text": "Blessed are they that keep judgment, and he that does righteousness at all times.", "words": [[0, 12204], [8, 12684], [12, 12984], [17, 13164], [22, 13344], [27, 13564], [37, 14484], [41, 14644], [44, 14824], [49, 15004], [54, 15264], [68, 15884], [71, 16284], [75, 16424]]}, {"verse": 4, "start": 17614, "end": 23821, "text": "Remember me, O LORD, with the favour that you bear to your people: O visit me with your salvation;", "words": [[0, 17614], [9, 17961], [13, 18361], [15, 18461], [21, 19141], [26, 19421], [30, 19651], [37, 19881], [42, 20141], [46, 20321], [51, 20661], [54, 20881], [59, 21061], [67, 22094], [69, 22254], [75, 22394], [78, 22634], [83, 22854], [88, 22974]]}, {"verse": 5, "start": 24271, "end": 33045, "text": "That I may see the good of your chosen, that I may rejoice in the gladness of your nation, that I may glory with your inheritance.", "words": [[0, 24271], [5, 24397], [7, 24517], [11, 24677], [15, 24917], [19, 25097], [24, 25297], [27, 25437], [32, 25577], [40, 26477], [45, 26577], [47, 26697], [51, 26837], [59, 27297], [62, 27557], [66, 27677], [75, 28137], [78, 28357], [83, 28497], [91, 29217], [96, 29497], [98, 29657], [102, 29797], [108, 30197], [113, 30517], [118, 30697]]}, {"verse": 6, "start": 33495, "end": 38607, "text": "We have sinned with our fathers, we have committed iniquity, we have done wickedly.", "words": [[0, 33495], [3, 33604], [8, 33744], [15, 34184], [20, 34284], [24, 34464], [33, 35344], [36, 35524], [41, 35684], [51, 36104], [61, 37124], [64, 37404], [69, 37584], [74, 37844]]}, {"verse": 7, "start": 39057, "end": 48550, "text": "Our fathers understood not your wonders in Egypt; they remembered not the multitude of your mercies; but provoked him at the sea, even at the Red sea.", "words": [[0, 39057], [4, 39163], [12, 39503], [23, 40103], [27, 40543], [32, 40843], [40, 41263], [43, 41563], [50, 42407], [55, 42511], [66, 42951], [70, 43271], [74, 43471], [84, 43971], [87, 44291], [92, 44411], [101, 45434], [105, 45599], [114, 46159], [118, 46299], [121, 46459], [125, 46599], [130, 47219], [135, 47499], [138, 47739], [142, 47839], [146, 48059]]}, {"verse": 8, "start": 49000, "end": 54214, "text": "Nevertheless he saved them for his name’s sake, that he might make his mighty power to be known.", "words": [[0, 49000], [13, 49703], [16, 49843], [22, 50203], [27, 50363], [31, 50563], [35, 50723], [42, 51183], [48, 51783], [53, 51983], [56, 52103], [62, 52303], [67, 52563], [71, 52743], [78, 53003], [84, 53403], [87, 53583], [90, 53743]]}, {"verse": 9, "start": 54664, "end": 61334, "text": "He rebuked the Red sea also, and it was dried up: so he led them through the depths, as through the wilderness.", "words": [[0, 54664], [3, 54746], [11, 55326], [15, 55446], [19, 55646], [23, 55886], [29, 56786], [33, 56906], [36, 56986], [40, 57126], [46, 57426], [50, 58133], [53, 58278], [56, 58418], [60, 58638], [65, 58898], [73, 59138], [77, 59298], [85, 59638], [88, 60158], [96, 60478], [100, 60618]]}, {"verse": 10, "start": 61784, "end": 67179, "text": "And he saved them from the hand of him that hated them, and redeemed them from the hand of the enemy.", "words": [[0, 61784], [4, 61911], [7, 62031], [13, 62451], [18, 62691], [23, 62891], [27, 63071], [32, 63351], [35, 63511], [39, 63691], [44, 63891], [50, 64171], [56, 64831], [60, 65051], [69, 65551], [74, 65771], [79, 66031], [83, 66211], [88, 66411], [91, 66531], [95, 66691]]}, {"verse": 11, "start": 67629, "end": 71453, "text": "And the waters covered their enemies: there was not one of them left.", "words": [[0, 67629], [4, 67752], [8, 67852], [15, 68192], [23, 68592], [29, 68852], [38, 69834], [44, 69934], [48, 70114], [52, 70334], [56, 70614], [59, 70734], [64, 70914]]}, {"verse": 12, "start": 71903, "end": 75827, "text": "Then believed they his words; they sang his praise.", "words": [[0, 71903], [5, 72091], [14, 72631], [19, 72991], [23, 73251], [30, 74342], [35, 74461], [40, 74841], [44, 75081]]}, {"verse": 13, "start": 76277, "end": 79907, "text": "They soon forgot his works; they waited not for his counsel:", "words": [[0, 76277], [5, 76382], [10, 76622], [17, 76962], [21, 77282], [28, 78107], [33, 78347], [40, 78607], [44, 78927], [48, 79127], [52, 79267]]}, {"verse": 14, "start": 80357, "end": 85261, "text": "But lusted exceedingly in the wilderness, and tempted God in the desert.", "words": [[0, 80357], [4, 80677], [11, 81057], [23, 81717], [26, 81917], [30, 82017], [42, 82457], [46, 82937], [54, 83277], [58, 83617], [61, 83797], [65, 83877]]}, {"verse": 15, "start": 85711, "end": 89708, "text": "And he gave them their request; but sent leanness into their soul.", "words": [[0, 85711], [4, 85850], [7, 85970], [12, 86190], [17, 86430], [23, 86630], [32, 87710], [36, 87814], [41, 88094], [50, 88694], [55, 88894], [61, 89114]]}, {"verse": 16, "start": 90158, "end": 94461, "text": "They envied Moses also in the camp, and Aaron the saint of the LORD.", "words": [[0, 90158], [5, 90306], [12, 90706], [18, 91046], [23, 91486], [26, 91746], [30, 91826], [36, 92686], [40, 92866], [46, 93186], [50, 93406], [56, 93646], [59, 93826], [63, 93946]]}, {"verse": 17, "start": 94911, "end": 99329, "text": "The earth opened and swallowed up Dathan, and covered the company of Abiram.", "words": [[0, 94911], [4, 95051], [10, 95311], [17, 95711], [21, 95911], [31, 96351], [34, 96631], [42, 97091], [46, 97671], [54, 98031], [58, 98231], [66, 98591], [69, 98998]]}, {"verse": 18, "start": 99779, "end": 103790, "text": "And a fire was kindled in their company; the flame burned up the wicked.", "words": [[0, 99779], [4, 99906], [6, 100006], [11, 100326], [15, 100566], [23, 101046], [26, 101186], [32, 101326], [41, 102237], [45, 102314], [51, 102674], [58, 102994], [61, 103174], [65, 103314]]}, {"verse": 19, "start": 104240, "end": 108129, "text": "They made a calf in Horeb, and worshipped the molten image.", "words": [[0, 104240], [5, 104393], [10, 104593], [12, 104693], [17, 105093], [20, 105593], [27, 106093], [31, 106533], [42, 107053], [46, 107193], [53, 107433]]}, {"verse": 20, "start": 108579, "end": 113191, "text": "Thus they changed their glory into the similitude of an ox that eats grass.", "words": [[0, 108579], [5, 108806], [10, 109106], [18, 109526], [24, 109786], [30, 110226], [35, 110566], [39, 110726], [50, 111306], [53, 111526], [56, 111646], [59, 111946], [64, 112206], [69, 112406]]}, {"verse": 21, "start": 113641, "end": 117539, "text": "They forgot God their saviour, which had done great things in Egypt;", "words": [[0, 113641], [5, 113735], [12, 114055], [16, 114475], [22, 115045], [31, 115615], [37, 115815], [41, 115975], [46, 116195], [52, 116455], [59, 116775], [62, 116995]]}, {"verse": 22, "start": 117989, "end": 122348, "text": "Wondrous works in the land of Ham, and terrible things by the Red sea.", "words": [[0, 117989], [9, 118454], [15, 118714], [18, 118974], [22, 119094], [27, 119314], [30, 119474], [35, 119834], [39, 120394], [48, 120754], [55, 121194], [58, 121514], [62, 121654], [66, 121834]]}, {"verse": 23, "start": 122798, "end": 131711, "text": "Therefore he said that he would destroy them, had not Moses his chosen stood before him in the breach, to turn away his wrath, lest he should destroy them.", "words": [[0, 122798], [10, 123232], [13, 123312], [18, 123572], [23, 123772], [26, 123912], [32, 124112], [40, 124592], [46, 125332], [50, 125412], [54, 125612], [60, 126072], [64, 126352], [71, 126772], [77, 127112], [84, 127512], [88, 127732], [91, 127852], [95, 127952], [103, 128692], [106, 128792], [111, 129012], [116, 129272], [120, 129492], [127, 130192], [132, 130512], [135, 130652], [142, 130872], [150, 131272]]}, {"verse": 24, "start": 132161, "end": 135650, "text": "Yes, they despised the pleasant land, they believed not his word:", "words": [[0, 132161], [5, 132472], [10, 132782], [19, 133092], [23, 133232], [32, 133532], [38, 134152], [43, 134352], [52, 134552], [56, 134852], [60, 135072]]}, {"verse": 25, "start": 136100, "end": 139808, "text": "But murmured in their tents, and hearkened not to the voice of the LORD.", "words": [[0, 136100], [4, 136224], [13, 136684], [16, 136784], [22, 136924], [29, 137244], [33, 137704], [43, 138244], [47, 138524], [50, 138724], [54, 138824], [60, 139064], [63, 139204], [67, 139344]]}, {"verse": 26, "start": 140258, "end": 144458, "text": "Therefore he lifted up his hand against them, to overthrow them in the wilderness:", "words": [[0, 140258], [10, 140570], [13, 140830], [20, 141150], [23, 141350], [27, 141490], [32, 141770], [40, 142070], [46, 142370], [49, 142650], [59, 143090], [64, 143470], [67, 143670], [71, 143770]]}, {"verse": 27, "start": 144908, "end": 149390, "text": "To overthrow their seed also among the nations, and to scatter them in the lands.", "words": [[0, 144908], [3, 144985], [13, 145425], [19, 145705], [24, 146045], [29, 146445], [35, 146745], [39, 146965], [48, 147345], [52, 147845], [55, 147965], [63, 148285], [68, 148545], [71, 148685], [75, 148805]]}, {"verse": 28, "start": 149840, "end": 154969, "text": "They joined themselves also to Baal-peor, and ate the sacrifices of the dead.", "words": [[0, 149840], [5, 149984], [12, 150284], [23, 150804], [28, 151364], [31, 151884], [42, 152404], [46, 153004], [50, 153204], [54, 153404], [65, 154004], [68, 154344], [72, 154484]]}, {"verse": 29, "start": 155419, "end": 160620, "text": "Thus they provoked him to anger with their inventions: and the plague broke in upon them.", "words": [[0, 155419], [5, 155881], [10, 156061], [19, 156541], [23, 156681], [26, 156841], [32, 157161], [37, 157421], [43, 157581], [55, 158818], [59, 158940], [63, 159040], [70, 159300], [76, 159700], [79, 159940], [84, 160120]]}, {"verse": 30, "start": 161070, "end": 166385, "text": "Then stood up Phinehas, and executed judgment: and so the plague was stayed.", "words": [[0, 161070], [5, 161332], [11, 161672], [14, 162082], [24, 162492], [28, 163052], [37, 163592], [47, 164716], [51, 164862], [54, 165042], [58, 165202], [65, 165542], [69, 165842]]}, {"verse": 31, "start": 166835, "end": 170896, "text": "And that was counted to him for righteousness to all generations for evermore.", "words": [[0, 166835], [4, 166958], [9, 167078], [13, 167218], [21, 167498], [24, 167738], [28, 167898], [32, 168118], [46, 168578], [49, 168938], [53, 169158], [65, 169760], [69, 170361]]}, {"verse": 32, "start": 171346, "end": 176932, "text": "They angered him also at the waters of strife, so that it went ill with Moses for their sakes:", "words": [[0, 171346], [5, 171470], [13, 171950], [17, 172050], [22, 172470], [25, 172710], [29, 172830], [36, 173150], [39, 173390], [47, 174250], [50, 174470], [55, 174630], [58, 174710], [63, 174890], [67, 175190], [72, 175470], [78, 175830], [82, 176130], [88, 176290]]}, {"verse": 33, "start": 177382, "end": 181850, "text": "Because they provoked his spirit, so that he spoke unadvisedly with his lips.", "words": [[0, 177382], [8, 177570], [13, 177790], [22, 178290], [26, 178450], [34, 178890], [37, 179310], [42, 179510], [45, 179610], [51, 179930], [63, 180970], [68, 181150], [72, 181310]]}, {"verse": 34, "start": 182300, "end": 185941, "text": "They did not destroy the nations, concerning whom the LORD commanded them:", "words": [[0, 182300], [5, 182463], [9, 182603], [13, 182783], [21, 183223], [25, 183403], [34, 183783], [45, 184343], [50, 184683], [54, 184863], [59, 185043], [69, 185523]]}, {"verse": 35, "start": 186391, "end": 189170, "text": "But were mingled among the heathen, and learned their works.", "words": [[0, 186391], [4, 186500], [9, 186660], [17, 187080], [23, 187240], [27, 187480], [36, 187880], [40, 188140], [48, 188360], [54, 188600]]}, {"verse": 36, "start": 189620, "end": 193725, "text": "And they served their idols: which were a snare to them.", "words": [[0, 189620], [4, 189747], [9, 189847], [16, 190167], [22, 190427], [29, 191316], [35, 191464], [40, 191704], [42, 191804], [48, 192044], [51, 192284]]}, {"verse": 37, "start": 194175, "end": 197906, "text": "Yes, they sacrificed their sons and their daughters to demons,", "words": [[0, 194175], [5, 194558], [10, 194678], [21, 195238], [27, 195598], [32, 196038], [36, 196258], [42, 196378], [52, 196778], [55, 197078]]}, {"verse": 38, "start": 198356, "end": 207600, "text": "And shed innocent blood, even the blood of their sons and of their daughters, whom they sacrificed to the idols of Canaan: and the land was polluted with blood.", "words": [[0, 198356], [4, 198503], [9, 198763], [18, 199303], [25, 199983], [30, 200243], [34, 200423], [40, 200643], [43, 200803], [49, 201003], [54, 201343], [58, 201583], [61, 201703], [67, 201863], [78, 202663], [83, 202843], [88, 203023], [99, 203543], [102, 203883], [106, 204003], [112, 204383], [115, 204623], [123, 205685], [127, 205816], [131, 205916], [136, 206156], [140, 206336], [149, 206816], [154, 207016]]}, {"verse": 39, "start": 208050, "end": 212912, "text": "Thus were they defiled with their own works, and went a whoring with their own inventions.", "words": [[0, 208050], [5, 208240], [10, 208480], [15, 208620], [23, 209160], [28, 209360], [34, 209560], [38, 209820], [45, 210220], [49, 210740], [54, 210993], [56, 211247], [64, 211500], [69, 211680], [75, 211840], [79, 212020]]}, {"verse": 40, "start": 213362, "end": 219912, "text": "Therefore was the wrath of the LORD kindled against his people, so that he abhorred his own inheritance.", "words": [[0, 213362], [10, 213829], [14, 214229], [18, 214429], [24, 214749], [27, 214949], [31, 215109], [36, 215409], [44, 215989], [52, 216269], [56, 216549], [64, 217369], [67, 217549], [72, 217749], [75, 217909], [84, 218629], [88, 218789], [92, 218989]]}, {"verse": 41, "start": 220362, "end": 225343, "text": "And he gave them into the hand of the heathen; and they that hated them ruled over them.", "words": [[0, 220362], [4, 220485], [7, 220605], [12, 220825], [17, 221085], [22, 221325], [26, 221465], [31, 221765], [34, 221925], [38, 222065], [47, 222984], [51, 223130], [56, 223330], [61, 223550], [67, 223890], [72, 224190], [78, 224510], [83, 224870]]}, {"verse": 42, "start": 225793, "end": 230599, "text": "Their enemies also oppressed them, and they were brought into subjection under their hand.", "words": [[0, 225793], [6, 225939], [14, 226339], [19, 226779], [29, 227219], [35, 227799], [39, 227879], [44, 228019], [49, 228179], [57, 228479], [62, 228739], [73, 229519], [79, 229739], [85, 229979]]}, {"verse": 43, "start": 231049, "end": 237236, "text": "Many times did he deliver them; but they provoked him with their counsel, and were brought low for their iniquity.", "words": [[0, 231049], [5, 231276], [11, 231656], [15, 231956], [18, 232096], [26, 232456], [32, 233230], [36, 233360], [41, 233480], [50, 233980], [54, 234120], [59, 234300], [65, 234420], [74, 234840], [78, 235520], [83, 235660], [91, 235940], [95, 236260], [99, 236460], [105, 236640]]}, {"verse": 44, "start": 237686, "end": 241257, "text": "Nevertheless he regarded their affliction, when he heard their cry:", "words": [[0, 237686], [13, 238429], [16, 238569], [25, 238989], [31, 239249], [43, 239809], [48, 240169], [51, 240309], [57, 240489], [63, 240669]]}, {"verse": 45, "start": 241707, "end": 247324, "text": "And he remembered for them his covenant, and repented according to the multitude of his mercies.", "words": [[0, 241707], [4, 241848], [7, 241948], [18, 242408], [22, 242708], [27, 242928], [31, 243168], [41, 243628], [45, 244348], [54, 244988], [64, 245368], [67, 245648], [71, 245768], [81, 246188], [84, 246488], [88, 246608]]}, {"verse": 46, "start": 247774, "end": 251638, "text": "He made them also to be pitied of all those that carried them captives.", "words": [[0, 247774], [3, 247883], [8, 248103], [13, 248303], [18, 248603], [21, 248803], [24, 248983], [31, 249423], [34, 249583], [38, 249763], [44, 250043], [49, 250343], [57, 250703], [62, 250903]]}, {"verse": 47, "start": 252088, "end": 259283, "text": "Save us, O LORD our God, and gather us from among the heathen, to give thanks to your holy name, and to triumph in your praise.", "words": [[0, 252088], [5, 252268], [9, 252548], [11, 252628], [16, 253028], [20, 253108], [25, 253928], [29, 254088], [36, 254328], [39, 254628], [44, 254808], [50, 255088], [54, 255268], [63, 255748], [66, 255988], [71, 256128], [78, 256428], [81, 256648], [86, 256788], [91, 257048], [97, 257408], [101, 257768], [104, 257908], [112, 258248], [115, 258508], [120, 258628]]}, {"verse": 48, "start": 259733, "end": 267862, "text": "Blessed be the LORD God of Israel from everlasting to everlasting: and let all the people say, Amen. Praise the LORD.", "words": [[0, 259733], [8, 259960], [11, 260300], [15, 260460], [20, 260700], [24, 261040], [27, 261240], [34, 261620], [39, 261960], [51, 262500], [54, 262940], [67, 264125], [71, 264251], [75, 264411], [79, 264631], [83, 264771], [90, 265051], [95, 265731], [101, 266827], [108, 267071], [112, 267371]]}]}