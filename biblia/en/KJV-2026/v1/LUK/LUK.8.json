{"book": "LUK", "chapter": 8, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 448033, "verses": [{"verse": 1, "start": 300, "end": 9886, "text": "And it came to pass afterward, that he went throughout every city and village, preaching and showing the glad tidings of the kingdom of God: and the twelve were with him,", "words": [[0, 300], [4, 431], [7, 531], [12, 771], [15, 971], [20, 1291], [31, 2231], [36, 2511], [39, 2611], [44, 2811], [55, 3071], [61, 3471], [66, 3831], [70, 4031], [79, 4851], [89, 5271], [93, 5551], [101, 5851], [105, 6091], [110, 6371], [118, 6911], [121, 7071], [125, 7211], [133, 7491], [136, 7731], [141, 8488], [145, 8612], [149, 8712], [156, 9032], [161, 9312], [166, 9572]]}, {"verse": 2, "start": 10236, "end": 17706, "text": "And certain women, which had been healed of evil spirits and infirmities, Mary called Magdalene, out of whom went seven demons,", "words": [[0, 10236], [4, 10366], [12, 10666], [19, 10986], [25, 11286], [29, 11446], [34, 11606], [41, 11866], [44, 12066], [49, 12266], [57, 12706], [61, 12966], [74, 13986], [79, 14286], [86, 14686], [97, 15886], [101, 16066], [104, 16226], [109, 16406], [114, 16666], [120, 17046]]}, {"verse": 3, "start": 18056, "end": 25710, "text": "And Joanna the wife of Chuza Herod’s steward, and Susanna, and many others, which ministered to him of their substance.", "words": [[0, 18056], [4, 18197], [11, 18517], [15, 18797], [20, 19037], [23, 19384], [29, 19730], [37, 20077], [46, 21137], [50, 21417], [59, 21937], [63, 22537], [68, 22777], [76, 23117], [82, 23717], [93, 24337], [96, 24437], [100, 24597], [103, 24737], [109, 24897]]}, {"verse": 4, "start": 26060, "end": 32162, "text": "¶ And when much people were gathered together, and were come to him out of every city, he spoke by a parable:", "words": [[2, 26060], [6, 26208], [11, 26328], [16, 26588], [23, 26928], [28, 27128], [37, 27468], [47, 27988], [51, 28448], [56, 28608], [61, 28808], [64, 29008], [68, 29268], [72, 29508], [75, 29628], [81, 29868], [87, 30788], [90, 30888], [96, 31188], [99, 31488], [101, 31588]]}, {"verse": 5, "start": 32362, "end": 41015, "text": "A sower went out to sow his seed: and as he sowed, some fell by the way side; and it was trodden down, and the fowls of the air devoured it.", "words": [[0, 32362], [2, 32462], [8, 32822], [13, 33022], [17, 33182], [20, 33362], [24, 33562], [28, 33742], [34, 34475], [38, 34616], [41, 34796], [44, 34956], [51, 35656], [56, 35816], [61, 36196], [64, 36456], [68, 36773], [72, 37089], [78, 37565], [82, 37875], [85, 37935], [89, 38075], [97, 38535], [103, 38835], [107, 39235], [111, 39375], [117, 39795], [120, 39895], [124, 40035], [128, 40255], [137, 40775]]}, {"verse": 6, "start": 41365, "end": 47233, "text": "And some fell upon a rock; and as soon as it was sprung up, it withered away, because it lacked moisture.", "words": [[0, 41365], [4, 41510], [9, 41790], [14, 42110], [19, 42370], [21, 42530], [27, 43212], [31, 43329], [34, 43469], [39, 43669], [42, 43809], [45, 43889], [49, 44009], [56, 44349], [60, 44849], [63, 44929], [72, 45269], [78, 45569], [86, 46089], [89, 46269], [96, 46509]]}, {"verse": 7, "start": 47583, "end": 52152, "text": "And some fell among thorns; and the thorns sprang up with it, and choked it.", "words": [[0, 47583], [4, 47708], [9, 48008], [14, 48308], [20, 48568], [28, 49594], [32, 49716], [36, 49956], [43, 50196], [50, 50656], [53, 50776], [58, 50996], [62, 51236], [66, 51516], [73, 51876]]}, {"verse": 8, "start": 52502, "end": 62348, "text": "And other fell on good ground, and sprang up, and bore fruit a hundredfold. And when he had said these things, he cried, He that has ears to hear, let him hear.", "words": [[0, 52502], [4, 52620], [10, 52860], [15, 53180], [18, 53380], [23, 53580], [31, 53940], [35, 54300], [42, 54740], [46, 54920], [50, 55200], [55, 55460], [61, 55840], [63, 56060], [76, 57110], [80, 57241], [85, 57401], [88, 57621], [92, 57781], [97, 58001], [103, 58261], [111, 58921], [114, 59001], [121, 59838], [124, 59968], [129, 60208], [133, 60408], [138, 60708], [141, 60948], [147, 61568], [151, 61728], [155, 61928]]}, {"verse": 9, "start": 62628, "end": 66701, "text": "And his disciples asked him, saying, What might this parable be?", "words": [[0, 62628], [4, 62752], [8, 62872], [18, 63372], [24, 63792], [29, 64252], [37, 65097], [42, 65327], [48, 65627], [53, 65907], [61, 66387]]}, {"verse": 10, "start": 66981, "end": 77629, "text": "And he said, To you it is given to know the mysteries of the kingdom of God: but to others in parables; that seeing they might not see, and hearing they might not understand.", "words": [[0, 66981], [4, 67116], [7, 67256], [13, 68665], [16, 68805], [20, 69045], [23, 69285], [26, 69425], [32, 69645], [35, 69865], [40, 70045], [44, 70185], [54, 70625], [57, 70845], [61, 70945], [69, 71205], [72, 71405], [77, 72121], [81, 72300], [84, 72500], [91, 72840], [94, 73100], [104, 74028], [109, 74152], [116, 74392], [121, 74632], [127, 74792], [131, 74992], [136, 75372], [140, 75892], [148, 76172], [153, 76392], [159, 76572], [163, 76772]]}, {"verse": 11, "start": 77979, "end": 81766, "text": "Now the parable is this: The seed is the word of God.", "words": [[0, 77979], [4, 78292], [8, 78552], [16, 78972], [19, 79172], [25, 79975], [29, 80077], [34, 80457], [37, 80717], [41, 80877], [46, 81117], [49, 81257]]}, {"verse": 12, "start": 82116, "end": 90878, "text": "Those by the way side are they that hear; then comes the devil, and takes away the word out of their hearts, lest they should believe and be saved.", "words": [[0, 82116], [6, 82579], [9, 82679], [13, 82799], [17, 83059], [22, 83599], [26, 83679], [31, 83839], [36, 84019], [42, 84714], [47, 84968], [53, 85348], [57, 85608], [64, 86208], [68, 86448], [74, 86708], [79, 86988], [83, 87188], [88, 87428], [92, 87748], [95, 87868], [101, 88048], [109, 88628], [114, 89008], [119, 89208], [126, 89388], [134, 89788], [138, 90148], [141, 90328]]}, {"verse": 13, "start": 91228, "end": 100734, "text": "They on the rock are they, which, when they hear, receive the word with joy; and these have no root, which for a while believe, and in time of temptation fall away.", "words": [[0, 91228], [5, 91415], [8, 91635], [12, 91775], [17, 92095], [21, 92255], [27, 92855], [34, 93195], [39, 93315], [44, 93495], [50, 94115], [58, 94455], [62, 94715], [67, 94935], [72, 95135], [77, 95869], [81, 96011], [87, 96171], [92, 96411], [95, 96611], [101, 97171], [107, 97331], [111, 97551], [113, 97651], [119, 97831], [128, 98571], [132, 98731], [135, 98871], [140, 99111], [143, 99271], [154, 99791], [159, 100211]]}, {"verse": 14, "start": 101084, "end": 111622, "text": "And that which fell among thorns are they, which, when they have heard, go forth, and are choked with cares and riches and pleasures of this life, and bring no fruit to perfection.", "words": [[0, 101084], [4, 101241], [9, 101441], [15, 101701], [20, 102001], [26, 102281], [33, 102861], [37, 103081], [43, 103741], [50, 104301], [55, 104481], [60, 104621], [65, 104781], [72, 105381], [75, 105581], [82, 106341], [86, 106461], [90, 106601], [97, 106921], [102, 107101], [108, 107481], [112, 107781], [119, 108081], [123, 108381], [133, 108681], [136, 108981], [141, 109141], [147, 109833], [151, 110033], [157, 110193], [160, 110453], [166, 110753], [169, 110953]]}, {"verse": 15, "start": 111972, "end": 119593, "text": "But that on the good ground are they, which in an honest and good heart, having heard the word, keep it, and bring forth fruit with patience.", "words": [[0, 111972], [4, 112076], [9, 112256], [12, 112416], [16, 112536], [21, 112756], [28, 113116], [32, 113336], [38, 114176], [44, 114356], [47, 114516], [50, 114636], [57, 115056], [61, 115216], [66, 115396], [73, 115976], [80, 116136], [86, 116416], [90, 116536], [96, 117136], [101, 117356], [105, 117576], [109, 117896], [115, 118096], [121, 118376], [127, 118696], [132, 118896]]}, {"verse": 16, "start": 119943, "end": 128177, "text": "¶ No man, when he has lighted a lamp, covers it with a vessel, or puts it under a bed; but sets it on a lampstand, that they which enter in may see the light.", "words": [[2, 119943], [5, 120129], [10, 120429], [15, 120629], [18, 120789], [22, 120989], [30, 121369], [32, 121449], [38, 121709], [45, 122129], [48, 122329], [53, 122449], [55, 122549], [63, 122849], [66, 123054], [71, 123294], [74, 123474], [80, 123614], [82, 123774], [87, 124362], [91, 124478], [96, 124698], [99, 124878], [102, 124978], [104, 125098], [115, 125638], [120, 126138], [125, 126398], [131, 126638], [137, 126918], [140, 127118], [144, 127338], [148, 127618], [152, 127778]]}, {"verse": 17, "start": 128527, "end": 135400, "text": "For nothing is secret, that shall not be made manifest; neither any thing hid, that shall not be known and come abroad.", "words": [[0, 128527], [4, 128620], [12, 128880], [15, 129140], [23, 129500], [28, 130000], [34, 130220], [38, 130460], [41, 130640], [46, 130900], [56, 131950], [64, 132138], [68, 132364], [74, 132591], [79, 132991], [84, 133411], [90, 133631], [94, 133851], [97, 134011], [103, 134371], [107, 134631], [112, 134831]]}, {"verse": 18, "start": 135750, "end": 144470, "text": "Take heed therefore how you hear: for whoever has, to him shall be given; and whoever has not, from him shall be taken even that which he seems to have.", "words": [[0, 135750], [5, 135892], [10, 136492], [20, 136792], [24, 136952], [28, 137112], [34, 137707], [38, 137843], [46, 138143], [51, 138503], [54, 138703], [58, 138883], [64, 139103], [67, 139263], [74, 139977], [78, 140120], [86, 140380], [90, 140740], [95, 141220], [100, 141500], [104, 141720], [110, 141980], [113, 142140], [119, 142400], [124, 142840], [129, 143200], [135, 143440], [138, 143600], [144, 143860], [147, 144040]]}, {"verse": 19, "start": 144750, "end": 149645, "text": "¶ Then came to him his mother and his brethren, and could not come at him for the press.", "words": [[2, 144750], [7, 144956], [12, 145236], [15, 145476], [19, 145656], [23, 145876], [30, 146196], [34, 146436], [38, 146596], [48, 147416], [52, 147656], [58, 147836], [62, 148056], [67, 148376], [70, 148516], [74, 148696], [78, 148876], [82, 148996]]}, {"verse": 20, "start": 149995, "end": 156577, "text": "And it was told him by certain which said, Your mother and your brethren stand without, desiring to see you.", "words": [[0, 149995], [4, 150141], [7, 150221], [11, 150381], [16, 150641], [20, 150901], [23, 151121], [31, 151421], [37, 151701], [43, 152416], [48, 152575], [55, 152915], [59, 153215], [64, 153375], [73, 153755], [79, 154195], [88, 155055], [97, 155735], [100, 156015], [104, 156275]]}, {"verse": 21, "start": 156857, "end": 163708, "text": "And he answered and said to them, My mother and my brethren are these which hear the word of God, and do it.", "words": [[0, 156857], [4, 156993], [7, 157113], [16, 157493], [20, 157693], [25, 157933], [28, 158133], [34, 158688], [37, 158832], [44, 159192], [48, 159532], [51, 159732], [60, 160152], [64, 160552], [70, 160892], [76, 161252], [81, 161572], [85, 161752], [90, 162012], [93, 162172], [98, 162532], [102, 163112], [105, 163372]]}, {"verse": 22, "start": 163988, "end": 173775, "text": "¶ Now it came to pass on a certain day, that he went into a ship with his disciples: and he said to them, Let us go over to the other side of the lake. And they launched forth.", "words": [[2, 163988], [6, 164228], [9, 164368], [14, 164588], [17, 164768], [22, 165028], [25, 165248], [27, 165388], [35, 165588], [40, 165948], [45, 166213], [48, 166313], [53, 166513], [58, 166733], [60, 166913], [65, 167073], [70, 167333], [74, 167433], [85, 168498], [89, 168664], [92, 168744], [97, 168964], [100, 169124], [106, 170038], [110, 170218], [113, 170358], [116, 170538], [121, 170818], [124, 170998], [128, 171158], [134, 171398], [139, 171718], [142, 171878], [146, 171978], [152, 172633], [156, 172761], [161, 172881], [170, 173241]]}, {"verse": 23, "start": 174125, "end": 181365, "text": "But as they sailed he fell asleep: and there came down a storm of wind on the lake; and they were filled with water, and were in jeopardy.", "words": [[0, 174125], [4, 174231], [7, 174431], [12, 174611], [19, 175111], [22, 175171], [27, 175411], [35, 176263], [39, 176403], [45, 176503], [50, 176743], [55, 176983], [57, 177143], [63, 177423], [66, 177663], [71, 177903], [74, 178103], [78, 178223], [84, 178833], [88, 178958], [93, 179078], [98, 179218], [105, 179458], [110, 179698], [117, 180078], [121, 180458], [126, 180638], [129, 180758]]}, {"verse": 24, "start": 181715, "end": 191979, "text": "And they came to him, and awoke him, saying, Master, master, we perish. Then he arose, and rebuked the wind and the raging of the water: and they ceased, and there was a calm.", "words": [[0, 181715], [4, 181858], [9, 181958], [14, 182218], [17, 182438], [22, 182658], [26, 182938], [32, 183418], [37, 183718], [45, 184481], [53, 184921], [61, 185281], [64, 185361], [72, 186401], [77, 186533], [80, 186673], [87, 187033], [91, 187253], [99, 187813], [103, 187973], [108, 188273], [112, 188533], [116, 188613], [123, 188953], [126, 189153], [130, 189253], [137, 189977], [141, 190101], [146, 190221], [154, 190661], [158, 191081], [164, 191201], [168, 191321], [170, 191421]]}, {"verse": 25, "start": 192329, "end": 204024, "text": "And he said to them, Where is your faith? And they being afraid wondered, saying one to another, What manner of man is this! for he commands even the winds and water, and they obey him.", "words": [[0, 192329], [4, 192459], [7, 192559], [12, 192819], [15, 193019], [21, 193581], [27, 193785], [30, 194105], [35, 194245], [40, 195269], [42, 195817], [46, 195934], [51, 196094], [57, 196354], [64, 196754], [74, 197554], [81, 197814], [85, 198114], [88, 198334], [97, 199019], [102, 199166], [109, 199466], [112, 199666], [116, 199846], [119, 200066], [125, 200885], [129, 200962], [132, 201082], [141, 201442], [146, 201702], [150, 201902], [156, 202202], [160, 202382], [167, 202922], [171, 203142], [176, 203302], [181, 203562]]}, {"verse": 26, "start": 204304, "end": 208523, "text": "¶ And they arrived at the country of the Gadarenes, which is over against Galilee.", "words": [[2, 204304], [6, 204455], [11, 204555], [19, 204835], [22, 205055], [26, 205155], [34, 205455], [37, 205615], [41, 206135], [52, 206655], [58, 206935], [61, 207095], [66, 207355], [74, 207715]]}, {"verse": 27, "start": 208873, "end": 219339, "text": "And when he went forth to land, there met him out of the city a certain man, which had demons long time, and wore no clothes, nor did he live in a house, but in the tombs.", "words": [[0, 208873], [4, 209000], [9, 209140], [12, 209260], [17, 209480], [23, 209740], [26, 210000], [32, 210780], [38, 211020], [42, 211240], [46, 211400], [50, 211580], [53, 211700], [57, 211800], [62, 212020], [64, 212200], [72, 212420], [77, 213240], [83, 213460], [87, 213660], [94, 214020], [99, 214380], [105, 215280], [109, 215420], [114, 215600], [117, 215780], [126, 216748], [130, 216966], [134, 217206], [137, 217326], [142, 217506], [145, 217666], [147, 217746], [154, 218226], [158, 218466], [161, 218606], [165, 218706]]}, {"verse": 28, "start": 219689, "end": 231048, "text": "When he saw Jesus, he cried out, and fell down before him, and with a loud voice said, What have I to do with you, Jesus, you Son of God most high? I beg you, torment me not.", "words": [[0, 219689], [5, 219836], [8, 219976], [12, 220236], [19, 220856], [22, 220916], [28, 221216], [33, 221496], [37, 221756], [42, 221996], [47, 222256], [54, 222576], [59, 223116], [63, 223396], [68, 223556], [70, 223696], [75, 223956], [81, 224236], [87, 225710], [92, 225830], [97, 225970], [99, 226070], [102, 226210], [105, 226370], [110, 226570], [115, 226810], [122, 227590], [126, 227690], [130, 227950], [133, 228090], [137, 228330], [142, 228610], [148, 229416], [150, 229540], [154, 229780], [159, 230000], [167, 230300], [170, 230580]]}, {"verse": 29, "start": 231328, "end": 244270, "text": "(For he had commanded the unclean spirit to come out of the man. For often it had caught him: and he was kept bound with chains and in fetters; and he broke the bands, and was driven by the demon into the wilderness.)", "words": [[0, 231328], [5, 231471], [8, 231671], [12, 231831], [22, 232311], [26, 232571], [34, 233291], [41, 233771], [44, 233971], [49, 234211], [53, 234431], [56, 234571], [60, 234711], [65, 235498], [69, 235655], [75, 236015], [78, 236275], [82, 236415], [89, 236675], [94, 237322], [98, 237449], [101, 237529], [105, 237689], [110, 237889], [116, 238289], [121, 238589], [128, 239069], [132, 239489], [135, 239649], [144, 240574], [148, 240719], [151, 240799], [157, 241039], [161, 241239], [168, 241679], [172, 241974], [176, 242154], [183, 242394], [186, 242674], [190, 242814], [196, 243094], [201, 243374], [205, 243514]]}, {"verse": 30, "start": 244620, "end": 253205, "text": "And Jesus asked him, saying, What is your name? And he said, Legion: because many demons were entered into him.", "words": [[0, 244620], [4, 244765], [10, 245105], [16, 245565], [21, 245925], [29, 246991], [34, 247151], [37, 247311], [42, 247451], [46, 248606], [48, 249154], [52, 249298], [55, 249438], [61, 250142], [69, 250981], [77, 251224], [82, 251564], [89, 251924], [94, 252184], [102, 252484], [107, 252784]]}, {"verse": 31, "start": 253555, "end": 257189, "text": "And they besought him that he would not command them to go out into the deep.", "words": [[0, 253555], [4, 253699], [9, 253819], [18, 254219], [22, 254399], [27, 254579], [30, 254679], [36, 254839], [40, 255079], [48, 255439], [53, 255739], [56, 255899], [59, 256079], [63, 256279], [68, 256519], [72, 256679]]}, {"verse": 32, "start": 257539, "end": 265390, "text": "And there was there a herd of many swine feeding on the mountain: and they besought him that he would permit them to enter into them. And he permitted them.", "words": [[0, 257539], [4, 257682], [10, 257802], [14, 257982], [20, 258162], [22, 258302], [27, 258622], [30, 258802], [35, 259062], [41, 259582], [49, 259882], [52, 260122], [56, 260242], [66, 260982], [70, 261182], [75, 261302], [84, 261782], [88, 262002], [93, 262182], [96, 262282], [102, 262422], [109, 262682], [114, 262922], [117, 263062], [123, 263362], [128, 263682], [134, 264281], [138, 264481], [141, 264581], [151, 264941]]}, {"verse": 33, "start": 265740, "end": 272937, "text": "Then went the demons out of the man, and entered into the swine: and the herd ran violently down a steep place into the lake, and were choked.", "words": [[0, 265740], [5, 265914], [10, 266094], [14, 266234], [21, 266534], [25, 266814], [28, 266954], [32, 267054], [37, 267314], [41, 267534], [49, 267854], [54, 268074], [58, 268234], [65, 269060], [69, 269188], [73, 269288], [78, 269468], [82, 269748], [92, 270268], [97, 270568], [99, 270728], [105, 270908], [111, 271208], [116, 271488], [120, 271648], [126, 271908], [130, 272268], [135, 272388]]}, {"verse": 34, "start": 273287, "end": 279126, "text": "When they that fed them saw what was done, they fled, and went and told it in the city and in the country.", "words": [[0, 273287], [5, 273430], [10, 273570], [15, 273810], [19, 274090], [24, 274310], [28, 274670], [33, 274890], [37, 275110], [43, 275770], [48, 275870], [54, 276230], [58, 276690], [63, 276910], [67, 277110], [72, 277350], [75, 277550], [78, 277730], [82, 277870], [87, 278110], [91, 278350], [94, 278490], [98, 278590]]}, {"verse": 35, "start": 279476, "end": 291612, "text": "Then they went out to see what was done; and came to Jesus, and found the man, out of whom the demons were departed, sitting at the feet of Jesus, clothed, and in his right mind: and they were afraid.", "words": [[0, 279476], [5, 279705], [10, 279905], [15, 280065], [19, 280225], [22, 280405], [26, 280585], [31, 280785], [35, 280985], [41, 281690], [45, 281810], [50, 282050], [53, 282290], [60, 282730], [64, 283155], [70, 283475], [74, 283675], [79, 284035], [83, 284400], [86, 284560], [91, 284740], [95, 284940], [102, 285300], [107, 285580], [117, 286420], [125, 286720], [128, 286920], [132, 287040], [137, 287260], [140, 287380], [147, 288260], [156, 288940], [160, 289100], [163, 289240], [167, 289400], [173, 289640], [179, 290415], [183, 290554], [188, 290694], [193, 290914]]}, {"verse": 36, "start": 291962, "end": 297166, "text": "They also which saw it told them by what means he that was possessed of the demons was healed.", "words": [[0, 291962], [5, 292058], [10, 292678], [16, 292798], [20, 293098], [23, 293218], [28, 293458], [33, 293738], [36, 293938], [41, 294198], [47, 294558], [50, 294738], [55, 294938], [59, 295098], [69, 295498], [72, 295758], [76, 295878], [83, 296518], [87, 296598]]}, {"verse": 37, "start": 297516, "end": 308469, "text": "¶ Then the whole multitude of the country of the Gadarenes round about besought him to depart from them; for they were taken with great fear: and he went up into the ship, and returned back again.", "words": [[2, 297516], [7, 297773], [11, 297973], [17, 298233], [27, 298833], [30, 299073], [34, 299213], [42, 299533], [45, 299733], [49, 300073], [59, 300413], [65, 300673], [71, 301053], [80, 301633], [84, 301833], [87, 301993], [94, 302353], [99, 302653], [105, 303197], [109, 303447], [114, 303607], [119, 303767], [125, 304067], [130, 304327], [136, 304587], [142, 305432], [146, 305567], [149, 305687], [154, 305867], [157, 306067], [162, 306267], [166, 306427], [172, 306707], [176, 307147], [185, 307527], [190, 307847]]}, {"verse": 38, "start": 308819, "end": 315888, "text": "Now the man out of whom the demons were departed besought him that he might be with him: but Jesus sent him away, saying,", "words": [[0, 308819], [4, 309041], [8, 309261], [12, 309561], [16, 309861], [19, 310021], [24, 310221], [28, 310441], [35, 310761], [40, 311001], [49, 311501], [58, 312001], [62, 312221], [67, 312441], [70, 312621], [76, 312841], [79, 313041], [84, 313281], [89, 313859], [93, 314006], [99, 314306], [104, 314726], [108, 314886], [114, 315386]]}, {"verse": 39, "start": 316088, "end": 325833, "text": "Return to your own house, and show how great things God has done to you. And he went his way, and published throughout the whole city how great things Jesus had done to him.", "words": [[0, 316088], [7, 316435], [10, 316635], [15, 316755], [19, 316975], [26, 317375], [30, 317660], [35, 317940], [39, 318120], [45, 318440], [52, 318740], [56, 319060], [60, 319340], [65, 319560], [68, 319740], [73, 320361], [77, 320514], [80, 320614], [85, 320834], [89, 321034], [94, 321354], [98, 321914], [108, 322274], [119, 322654], [123, 322874], [129, 323114], [134, 323454], [138, 323714], [144, 324034], [151, 324334], [157, 324714], [161, 325034], [166, 325294], [169, 325494]]}, {"verse": 40, "start": 326183, "end": 332826, "text": "And it came to pass, that, when Jesus was returned, the people gladly received him: for they were all waiting for him.", "words": [[0, 326183], [4, 326307], [7, 326407], [12, 326607], [15, 326787], [21, 327107], [27, 327627], [32, 327767], [38, 328047], [42, 328347], [52, 329287], [56, 329327], [63, 329627], [70, 330047], [79, 330527], [84, 331153], [88, 331241], [93, 331381], [98, 331581], [102, 331741], [110, 332061], [114, 332461]]}, {"verse": 41, "start": 333176, "end": 342565, "text": "¶ And, behold, there came a man named Jairus, and he was a ruler of the synagogue: and he fell down at Jesus’ feet, and besought him that he would come into his house:", "words": [[2, 333176], [7, 333342], [15, 334202], [21, 334342], [26, 334562], [28, 334722], [32, 334942], [38, 335592], [46, 336242], [50, 336322], [53, 336422], [57, 336582], [59, 336702], [65, 336962], [68, 337202], [72, 337302], [83, 338233], [87, 338371], [90, 338471], [95, 338691], [100, 338971], [103, 339131], [110, 339671], [116, 339831], [120, 340371], [129, 340791], [133, 341011], [138, 341171], [141, 341271], [147, 341411], [152, 341631], [157, 341831], [161, 342031]]}, {"verse": 42, "start": 342915, "end": 349738, "text": "For he had one only daughter, about twelve years of age, and she lay a dying. But as he went the people thronged him.", "words": [[0, 342915], [4, 343001], [7, 343121], [11, 343301], [15, 343521], [20, 343821], [30, 344421], [36, 344751], [43, 345081], [49, 345301], [52, 345521], [57, 346221], [61, 346381], [65, 346541], [69, 346761], [71, 346861], [78, 347551], [82, 347700], [85, 347940], [88, 348120], [93, 348480], [97, 348560], [104, 348820], [113, 349420]]}, {"verse": 43, "start": 350088, "end": 357669, "text": "¶ And a woman having an issue of blood twelve years, which had spent all her living upon physicians, neither could be healed of any,", "words": [[2, 350088], [6, 350250], [8, 350370], [14, 350630], [21, 350930], [24, 351130], [30, 351470], [33, 351670], [39, 351970], [46, 352310], [53, 353290], [59, 353470], [63, 353630], [69, 353890], [73, 354210], [77, 354390], [84, 354670], [89, 354970], [101, 356090], [109, 356270], [115, 356550], [118, 356750], [125, 357070], [128, 357270]]}, {"verse": 44, "start": 358019, "end": 363239, "text": "Came behind him, and touched the border of his garment: and immediately her issue of blood stopped.", "words": [[0, 358019], [5, 358199], [12, 358579], [17, 358859], [21, 359079], [29, 359359], [33, 359559], [40, 359819], [43, 360019], [47, 360139], [56, 360894], [60, 361037], [72, 361397], [76, 361797], [82, 362157], [85, 362317], [91, 362577]]}, {"verse": 45, "start": 363589, "end": 373792, "text": "And Jesus said, Who touched me? When all denied, Peter and they that were with him said, Master, the multitude throng you and press you, and do you say, Who touched me?", "words": [[0, 363589], [4, 363733], [10, 364013], [16, 364756], [20, 364856], [28, 365156], [30, 366241], [32, 366789], [37, 366933], [41, 367133], [49, 367513], [55, 367873], [59, 368173], [64, 368473], [69, 368733], [74, 368873], [79, 369113], [83, 369253], [89, 369984], [97, 370365], [101, 370565], [111, 370985], [118, 371445], [122, 371585], [126, 371725], [132, 371965], [137, 372165], [141, 372285], [144, 372425], [148, 372565], [153, 372805], [157, 373070], [165, 373370]]}, {"verse": 46, "start": 374072, "end": 379701, "text": "And Jesus said, Somebody has touched me: for I perceive that power is gone out of me.", "words": [[0, 374072], [4, 374194], [10, 374514], [16, 375391], [25, 375753], [29, 376093], [37, 376393], [41, 377043], [45, 377165], [47, 377325], [56, 377765], [61, 378065], [67, 378445], [70, 378705], [75, 378965], [79, 379225], [82, 379385]]}, {"verse": 47, "start": 379981, "end": 391766, "text": "And when the woman saw that she was not hid, she came trembling, and falling down before him, she declared to him before all the people for what cause she had touched him, and how she was healed immediately.", "words": [[0, 379981], [4, 380115], [9, 380255], [13, 380415], [19, 380655], [23, 381035], [28, 381215], [32, 381375], [36, 381535], [40, 381755], [45, 382535], [49, 382715], [54, 382955], [65, 383475], [69, 383815], [77, 384155], [82, 384515], [89, 384855], [94, 385600], [98, 385700], [107, 386080], [110, 386360], [114, 386500], [121, 386820], [125, 387140], [129, 387280], [136, 387660], [140, 387920], [145, 388120], [151, 388560], [155, 388820], [159, 388980], [167, 389300], [172, 389520], [176, 389980], [180, 390180], [184, 390400], [188, 390600], [195, 390900]]}, {"verse": 48, "start": 392116, "end": 397571, "text": "And he said to her, Daughter, be of good comfort: your faith has made you whole; go in peace.", "words": [[0, 392116], [4, 392258], [7, 392358], [12, 392578], [15, 392818], [20, 393317], [30, 393597], [33, 393837], [36, 393977], [41, 394197], [50, 395077], [55, 395158], [61, 395418], [65, 395678], [70, 395878], [74, 396018], [81, 396719], [84, 396841], [87, 397001]]}, {"verse": 49, "start": 397851, "end": 405973, "text": "¶ While he yet spoke, there comes one from the ruler of the synagogue’s house, saying to him, Your daughter is dead; trouble not the Master.", "words": [[2, 397851], [8, 398070], [11, 398270], [15, 398430], [22, 399270], [28, 399410], [34, 399710], [38, 400010], [43, 400250], [47, 400410], [53, 400690], [56, 400910], [60, 401050], [72, 401690], [79, 402250], [86, 402590], [89, 402850], [94, 403473], [99, 403575], [108, 403895], [111, 404155], [117, 404833], [125, 405130], [129, 405310], [133, 405470]]}, {"verse": 50, "start": 406253, "end": 412135, "text": "But when Jesus heard it, he answered him, saying, Fear not: believe only, and she shall be made whole.", "words": [[0, 406253], [4, 406373], [9, 406533], [15, 406853], [21, 407233], [25, 407613], [28, 407753], [37, 408133], [42, 408433], [50, 409159], [55, 409337], [60, 410016], [68, 410263], [74, 410903], [78, 410983], [82, 411163], [88, 411383], [91, 411523], [96, 411703]]}, {"verse": 51, "start": 412415, "end": 420475, "text": "And when he came into the house, he permitted no one to go in, save Peter, and James, and John, and the father and the mother of the maiden.", "words": [[0, 412415], [4, 412559], [9, 412719], [12, 412879], [17, 413079], [22, 413299], [26, 413439], [33, 414199], [36, 414319], [46, 414699], [49, 414999], [53, 415199], [56, 415339], [59, 415519], [63, 415759], [68, 416139], [75, 416539], [79, 416939], [86, 417359], [90, 417719], [96, 418079], [100, 418599], [104, 418739], [111, 419039], [115, 419319], [119, 419419], [126, 419659], [129, 419899], [133, 419999]]}, {"verse": 52, "start": 420825, "end": 426699, "text": "And all wept, and bewailed her: but he said, Weep not; she is not dead, but sleeps.", "words": [[0, 420825], [4, 420950], [8, 421150], [14, 421570], [18, 421750], [27, 422250], [32, 422841], [36, 422961], [39, 423061], [45, 423705], [50, 424065], [55, 424692], [59, 424857], [62, 425037], [66, 425217], [72, 425937], [76, 426037]]}, {"verse": 53, "start": 426979, "end": 430012, "text": "And they laughed him to scorn, knowing that she was dead.", "words": [[0, 426979], [4, 427121], [9, 427241], [17, 427521], [21, 427741], [24, 427991], [31, 428241], [39, 428781], [44, 429121], [48, 429301], [52, 429481]]}, {"verse": 54, "start": 430362, "end": 435768, "text": "And he put them all out, and took her by the hand, and called, saying, Maid, arise.", "words": [[0, 430362], [4, 430524], [7, 430604], [11, 430784], [16, 430984], [20, 431144], [25, 431484], [29, 431804], [34, 432044], [38, 432144], [41, 432344], [45, 432484], [51, 432924], [55, 433244], [63, 433864], [71, 434818], [77, 434978]]}, {"verse": 55, "start": 436048, "end": 441562, "text": "And her spirit came again, and she arose immediately: and he commanded to give her food.", "words": [[0, 436048], [4, 436227], [8, 436347], [15, 436727], [20, 437007], [27, 437887], [31, 438027], [35, 438227], [41, 438547], [54, 439720], [58, 439845], [61, 439985], [71, 440425], [74, 440645], [79, 440825], [83, 441005]]}, {"verse": 56, "start": 441912, "end": 447633, "text": "And her parents were astonished: but he charged them that they should tell no man what was done.", "words": [[0, 441912], [4, 442258], [8, 442378], [16, 442798], [21, 443078], [33, 444102], [37, 444405], [40, 444565], [48, 444945], [53, 445265], [58, 445465], [63, 445645], [70, 445825], [75, 446065], [78, 446345], [82, 446645], [87, 446885], [91, 447065]]}]}