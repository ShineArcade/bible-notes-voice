{"book": "LUK", "chapter": 23, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 421927, "verses": [{"verse": 1, "start": 300, "end": 5634, "text": "Levantándose entonces toda la multitud de ellos, le llevaron a Pilato.", "words": [[0, 300], [13, 1218], [22, 1858], [27, 2338], [30, 2558], [39, 3118], [42, 3338], [49, 3878], [52, 4418], [61, 4878], [63, 4998]]}, {"verse": 2, "start": 5984, "end": 16052, "text": "Y comenzaron a acusarle, diciendo: A este hemos hallado que pervierte la nación, y que prohíbe pagar impuestos a César, diciendo que él es el Cristo, el rey.", "words": [[0, 5984], [2, 6110], [13, 6770], [15, 7050], [25, 7770], [35, 9203], [37, 9321], [42, 9561], [48, 9761], [56, 10221], [60, 10531], [70, 10841], [73, 11001], [81, 11461], [83, 11636], [87, 11756], [95, 12156], [101, 12376], [111, 12956], [113, 13196], [120, 13976], [129, 14336], [133, 14656], [136, 14836], [139, 14996], [142, 15116], [150, 15656], [153, 15716]]}, {"verse": 3, "start": 16332, "end": 25293, "text": "Entonces Pilato le preguntó, diciendo: ¿Eres tú el Rey de los judíos? Y respondiéndole él, dijo: Tú lo dices.", "words": [[0, 16332], [9, 16897], [16, 17677], [19, 17877], [29, 18837], [39, 20172], [45, 20360], [48, 20660], [51, 20840], [55, 21060], [58, 21120], [62, 21260], [70, 22248], [72, 22372], [87, 23292], [91, 23572], [97, 24320], [100, 24444], [103, 24584]]}, {"verse": 4, "start": 25643, "end": 31611, "text": "Y Pilato dijo a los principales sacerdotes, y a la gente: Ninguna culpa hallo en este hombre.", "words": [[0, 25643], [2, 25917], [9, 26417], [14, 26717], [16, 26897], [20, 26997], [32, 27817], [44, 28737], [46, 28877], [48, 28957], [51, 28977], [58, 29788], [66, 30086], [72, 30476], [78, 30866], [81, 30946], [86, 31166]]}, {"verse": 5, "start": 31891, "end": 38901, "text": "Pero ellos insistían, diciendo: Alborota al pueblo, enseñando por toda Judea, comenzando desde Galilea hasta aquí.", "words": [[0, 31891], [5, 32078], [11, 32358], [22, 33198], [32, 34290], [41, 34726], [44, 34866], [52, 35106], [62, 35746], [66, 35906], [71, 36086], [78, 36926], [89, 37546], [95, 37726], [103, 38286], [109, 38486]]}, {"verse": 6, "start": 39181, "end": 43960, "text": "Entonces Pilato, oyendo de Galilea, preguntó si el hombre era galileo.", "words": [[0, 39181], [9, 39655], [17, 40475], [24, 40855], [27, 41035], [36, 41755], [45, 42235], [48, 42395], [51, 42575], [58, 42855], [62, 43135]]}, {"verse": 7, "start": 44310, "end": 52955, "text": "Y como entendió que era de la jurisdicción de Herodes, le remitió a Herodes, el cual también estaba en Jerusalén en aquellos días.", "words": [[0, 44310], [2, 44410], [7, 44610], [16, 45150], [20, 45330], [24, 45510], [27, 45650], [30, 45790], [43, 46610], [46, 46770], [55, 47610], [58, 47710], [66, 48410], [68, 48690], [77, 49510], [80, 49630], [85, 49870], [93, 50310], [100, 50690], [103, 50870], [113, 51610], [116, 51810], [125, 52090]]}, {"verse": 8, "start": 53305, "end": 65381, "text": "Y Herodes, viendo a Jesús, se alegró mucho, porque hacía mucho que deseaba verle; porque había oído de él muchas cosas, y tenía esperanza que le vería hacer alguna señal.", "words": [[0, 53305], [2, 53489], [11, 53869], [18, 54289], [20, 54549], [27, 54909], [30, 55489], [37, 55829], [44, 56689], [51, 57089], [57, 57449], [63, 57769], [67, 57989], [75, 58489], [82, 59356], [89, 59559], [95, 59919], [100, 60519], [103, 60739], [106, 60939], [113, 61199], [120, 61739], [122, 62499], [128, 62739], [138, 63379], [142, 63539], [145, 63679], [151, 64019], [157, 64319], [164, 64619]]}, {"verse": 9, "start": 65731, "end": 70361, "text": "Y le preguntaba con muchas palabras; pero él nada le respondió:", "words": [[0, 65731], [2, 65857], [5, 65957], [16, 66617], [20, 66877], [27, 67197], [37, 68326], [42, 68511], [45, 68771], [50, 69136], [53, 69416]]}, {"verse": 10, "start": 70711, "end": 77375, "text": "Y estaban los principales sacerdotes y los escribas acusándolo con gran insistencia.", "words": [[0, 70711], [2, 70819], [10, 71179], [14, 71439], [26, 72339], [37, 73319], [39, 73579], [43, 73699], [52, 74379], [63, 75399], [67, 75639], [72, 75939]]}, {"verse": 11, "start": 77725, "end": 86812, "text": "Pero Herodes con su corte le menospreció, y se burló de él, vistiéndole de una ropa rica; y le volvió a enviar a Pilato.", "words": [[0, 77725], [5, 77907], [13, 78287], [17, 78567], [20, 78897], [26, 79227], [29, 79307], [42, 80227], [44, 80607], [47, 80787], [53, 81247], [56, 81407], [60, 81847], [72, 82807], [75, 82967], [79, 83087], [84, 83507], [90, 84388], [92, 84531], [95, 84611], [102, 85211], [104, 85391], [111, 85931], [113, 86151]]}, {"verse": 12, "start": 87162, "end": 93924, "text": "Y fueron hechos amigos entre sí Pilato y Herodes en el mismo día; porque antes eran enemigos entre sí.", "words": [[0, 87162], [2, 87283], [9, 87503], [16, 87863], [23, 88243], [29, 88643], [32, 88923], [39, 89483], [41, 89683], [49, 90143], [52, 90323], [55, 90443], [61, 90723], [66, 91418], [73, 91660], [79, 92200], [84, 92580], [93, 93160], [99, 93500]]}, {"verse": 13, "start": 94274, "end": 100489, "text": "Entonces Pilato, convocando los principales sacerdotes, y los dirigentes, y el pueblo,", "words": [[0, 94274], [9, 94898], [17, 95818], [28, 96618], [32, 96798], [44, 97598], [56, 98398], [58, 98558], [62, 98678], [74, 99338], [76, 99658], [79, 99838]]}, {"verse": 14, "start": 100839, "end": 111666, "text": "Les dijo: Me habéis presentado a este por hombre que desvía al pueblo: y he aquí, preguntando yo delante de vosotros, no he hallado culpa alguna en este hombre de aquellas de que le acusáis.", "words": [[0, 100839], [4, 101055], [10, 101824], [13, 101926], [20, 102146], [31, 102826], [33, 102966], [38, 103206], [42, 103466], [49, 103686], [53, 103886], [60, 104346], [63, 104466], [71, 105183], [73, 105324], [76, 105424], [82, 105684], [94, 106364], [97, 106524], [105, 106944], [108, 107064], [118, 107924], [121, 108124], [124, 108264], [132, 108584], [138, 108804], [145, 109264], [148, 109464], [153, 109664], [160, 109944], [163, 110124], [172, 110604], [175, 110744], [179, 110844], [182, 110984]]}, {"verse": 15, "start": 112016, "end": 117879, "text": "Y ni aun Herodes; porque os remití a él, y he aquí, ninguna cosa digna de muerte ha hecho.", "words": [[0, 112016], [2, 112179], [5, 112259], [9, 112764], [18, 113440], [25, 113640], [28, 113820], [35, 114320], [37, 114420], [41, 114660], [43, 114900], [46, 115020], [52, 115320], [60, 115940], [65, 116400], [71, 116820], [74, 116920], [81, 117180], [84, 117440]]}, {"verse": 16, "start": 118229, "end": 120586, "text": "Le soltaré, pues, después de castigarlo.", "words": [[0, 118275], [3, 118355], [12, 118625], [18, 118895], [26, 119135], [29, 119735]]}, {"verse": 17, "start": 120866, "end": 124413, "text": "Y tenía necesidad de soltarles uno en cada fiesta.", "words": [[0, 120866], [2, 121093], [8, 121353], [18, 122113], [21, 122273], [31, 123053], [35, 123413], [38, 123553], [43, 123773]]}, {"verse": 18, "start": 124763, "end": 131434, "text": "Pero toda la multitud dio voces a una, diciendo: Quita a este, y suéltanos a Barrabás:", "words": [[0, 124763], [5, 124908], [10, 125348], [13, 125628], [22, 126388], [26, 126688], [32, 127128], [34, 127328], [39, 127908], [49, 128880], [55, 129040], [57, 129240], [63, 129640], [65, 130060], [75, 130640], [77, 130820]]}, {"verse": 19, "start": 131714, "end": 138117, "text": "(El cual había sido echado en la cárcel por una revuelta ocurrida en la ciudad y un homicidio.)", "words": [[0, 131714], [4, 131871], [9, 132151], [15, 132551], [20, 132971], [27, 133491], [30, 133611], [33, 133751], [40, 134271], [44, 134571], [48, 134751], [57, 135451], [66, 136251], [69, 136431], [72, 136551], [79, 136871], [81, 137191], [84, 137331]]}, {"verse": 20, "start": 138467, "end": 141928, "text": "Y les habló otra vez Pilato, queriendo soltar a Jesús.", "words": [[0, 138467], [2, 138573], [6, 138713], [12, 139133], [17, 139393], [21, 139613], [29, 140233], [39, 140713], [46, 141193], [48, 141293]]}, {"verse": 21, "start": 142278, "end": 147256, "text": "Pero ellos volvieron a dar voces, diciendo: Crucifícale, crucifícale.", "words": [[0, 142278], [5, 142460], [11, 142760], [21, 143340], [23, 143480], [27, 143620], [34, 144260], [44, 145583], [57, 146443]]}, {"verse": 22, "start": 147536, "end": 156885, "text": "Y él les dijo la tercera vez: ¿Pues qué mal ha hecho este? Ninguna culpa de muerte he hallado en él: le castigaré, pues, y le soltaré.", "words": [[0, 147536], [2, 147756], [5, 147996], [9, 148396], [14, 148856], [17, 149056], [25, 149636], [30, 150425], [36, 150580], [40, 150760], [44, 150980], [47, 151140], [53, 151380], [59, 152140], [67, 152543], [73, 152783], [76, 153023], [83, 153363], [86, 153643], [94, 154023], [97, 154203], [101, 154710], [104, 154795], [115, 155415], [121, 155715], [123, 156035], [126, 156155]]}, {"verse": 23, "start": 157165, "end": 165864, "text": "Pero ellos instaban a grandes voces, pidiendo que fuese crucificado. Y las voces de ellos y de los principales sacerdotes crecían.", "words": [[0, 157165], [5, 157329], [11, 157569], [20, 158309], [22, 158449], [30, 158709], [37, 159509], [46, 159949], [50, 160109], [56, 160449], [69, 161798], [71, 161906], [75, 162026], [81, 162426], [84, 162586], [90, 162886], [92, 163346], [95, 163426], [99, 163546], [111, 164286], [122, 164946]]}, {"verse": 24, "start": 166214, "end": 170295, "text": "Entonces Pilato juzgó que se hiciese lo que ellos pedían;", "words": [[0, 166214], [9, 166845], [16, 167425], [22, 167985], [26, 168145], [29, 168345], [37, 169005], [40, 169225], [44, 169385], [50, 169605]]}, {"verse": 25, "start": 170645, "end": 181459, "text": "Y les soltó a aquel que había sido echado en la cárcel por una revuelta y un homicidio, al cual habían pedido; y entregó a Jesús a la voluntad de ellos.", "words": [[0, 170645], [2, 170802], [6, 170922], [12, 171542], [14, 171882], [20, 172322], [24, 172462], [30, 172682], [35, 173062], [42, 173502], [45, 173622], [48, 173762], [55, 174242], [59, 174502], [63, 174702], [72, 175422], [74, 175562], [77, 175722], [88, 176229], [91, 176737], [96, 176957], [103, 177477], [111, 178565], [113, 178707], [121, 179207], [123, 179307], [129, 179667], [131, 179967], [134, 180047], [143, 180687], [146, 180867]]}, {"verse": 26, "start": 181809, "end": 190090, "text": "Y llevándole, tomaron a un Simón cireneo, que venía del campo, y le pusieron encima la cruz para que la llevase tras Jesús.", "words": [[0, 181809], [2, 181930], [14, 182490], [22, 183150], [24, 183410], [27, 183550], [33, 184090], [42, 184630], [46, 184795], [52, 185055], [56, 185315], [63, 185815], [65, 186080], [68, 186200], [77, 186660], [84, 187260], [87, 187480], [92, 188160], [97, 188460], [101, 188600], [104, 188740], [112, 189160], [117, 189380]]}, {"verse": 27, "start": 190440, "end": 196574, "text": "Y le seguía una grande multitud de pueblo, y de mujeres, las cuales le lloraban y lamentaban.", "words": [[0, 190440], [2, 190544], [5, 190684], [12, 191144], [16, 191304], [23, 191644], [32, 192364], [35, 192524], [43, 192964], [45, 193124], [48, 193244], [57, 194084], [61, 194204], [68, 194524], [71, 194984], [80, 195504], [82, 195764]]}, {"verse": 28, "start": 196924, "end": 206853, "text": "Pero Jesús, vuelto a ellas, les dice: Hijas de Jerusalén, no me lloréis a mí, sino llorad por vosotras mismas, y por vuestros hijos.", "words": [[0, 196924], [5, 197052], [12, 197712], [19, 198092], [21, 198212], [28, 198752], [32, 198852], [38, 199586], [44, 200050], [47, 200230], [58, 201050], [61, 201290], [64, 201590], [72, 201890], [74, 202010], [78, 202550], [83, 203100], [90, 203650], [94, 204010], [103, 204650], [111, 205530], [113, 205650], [117, 205870], [126, 206290]]}, {"verse": 29, "start": 207203, "end": 217052, "text": "Porque he aquí vendrán días en que dirán: Bienaventuradas las estériles, y los vientres que no engendraron, y los pechos que no amamantaron.", "words": [[0, 207203], [7, 207288], [10, 207408], [15, 207628], [23, 208328], [28, 208688], [31, 209028], [35, 209168], [42, 210612], [58, 211182], [62, 211402], [73, 212202], [75, 212782], [79, 212922], [88, 213382], [92, 213542], [95, 214082], [108, 214622], [110, 214942], [114, 215082], [121, 215522], [125, 215682], [128, 215882]]}, {"verse": 30, "start": 217402, "end": 224051, "text": "Entonces comenzarán a decir a los montes: Caed sobre nosotros: y a las colinas: Cubridnos.", "words": [[0, 217402], [9, 217807], [20, 218667], [22, 218727], [28, 219047], [30, 219207], [34, 219327], [42, 220274], [47, 220638], [53, 220938], [63, 221785], [65, 222025], [67, 222085], [71, 222205], [80, 223607]]}, {"verse": 31, "start": 224401, "end": 229409, "text": "Porque si en el árbol verde hacen estas cosas, ¿en el seco, qué se hará?", "words": [[0, 224401], [7, 224625], [10, 224865], [13, 225065], [16, 225205], [22, 225545], [28, 226005], [34, 226465], [40, 226745], [47, 227745], [51, 227985], [54, 228105], [60, 228605], [64, 228705], [67, 228905]]}, {"verse": 32, "start": 229759, "end": 234449, "text": "Y llevaban también con él otros dos, malhechores, a ser muertos.", "words": [[0, 229759], [2, 229866], [11, 230346], [19, 230726], [23, 230966], [26, 231186], [32, 231506], [37, 232216], [50, 232926], [52, 233406], [56, 233586]]}, {"verse": 33, "start": 234799, "end": 243688, "text": "Y cuando vinieron al lugar que se llama de la Calavera, le crucificaron allí, y a los malhechores, uno a la derecha, y otro a la izquierda.", "words": [[0, 234799], [2, 234919], [9, 235139], [18, 235739], [21, 235919], [27, 236259], [31, 236479], [34, 236599], [40, 236859], [43, 237039], [46, 237159], [56, 238259], [59, 238339], [72, 239259], [78, 239619], [80, 239804], [82, 239904], [86, 240464], [99, 241024], [103, 241364], [105, 241564], [108, 241644], [117, 242204], [119, 242444], [124, 242664], [126, 242824], [129, 242904]]}, {"verse": 34, "start": 244038, "end": 252182, "text": "Y Jesús decía: Padre, perdónalos, porque no saben lo que hacen. Y partiendo sus vestidos, echaron suertes.", "words": [[0, 244038], [2, 244163], [8, 244483], [15, 245501], [22, 245904], [34, 246724], [41, 247284], [44, 247504], [50, 247884], [53, 248104], [57, 248244], [64, 249117], [66, 249205], [76, 249825], [80, 250065], [90, 250685], [98, 251285]]}, {"verse": 35, "start": 252532, "end": 264731, "text": "Y el pueblo estaba mirando; y se burlaban de él los dirigentes con ellos, diciendo: A otros hizo salvos: sálvese a sí, si este es el Mesías, el escogido de Dios.", "words": [[0, 252532], [2, 252788], [5, 252908], [12, 253248], [19, 253588], [28, 254648], [30, 254796], [33, 254936], [42, 255536], [45, 255796], [48, 255976], [52, 256116], [63, 256716], [67, 256996], [74, 257296], [84, 258530], [86, 258674], [92, 259137], [97, 259601], [105, 260231], [113, 260476], [115, 260762], [119, 261049], [122, 261389], [127, 261629], [130, 261789], [133, 261889], [141, 262749], [144, 262829], [153, 263329], [156, 263469]]}, {"verse": 36, "start": 265011, "end": 270610, "text": "Se burlaban de él también los soldados, llegándose y presentándole vinagre,", "words": [[0, 265011], [3, 265212], [12, 265792], [15, 266032], [18, 266252], [26, 266572], [30, 266852], [40, 267692], [51, 268612], [53, 268912], [67, 269872]]}, {"verse": 37, "start": 270960, "end": 275287, "text": "Y diciendo: Si tú eres el Rey de los judíos, sálvate a ti mismo.", "words": [[0, 270960], [2, 271090], [12, 272061], [15, 272241], [18, 272421], [23, 272621], [26, 272821], [30, 273061], [33, 273121], [37, 273241], [45, 274041], [53, 274521], [55, 274681], [58, 274761]]}, {"verse": 38, "start": 275567, "end": 284449, "text": "Y había también sobre él un letrero escrito con letras griegas, y latinas, y hebreas: ESTE ES EL REY DE LOS JUDÍOS.", "words": [[0, 275567], [2, 275673], [8, 275873], [16, 276173], [22, 276593], [25, 276913], [28, 277133], [36, 277753], [44, 278133], [48, 278653], [55, 279153], [64, 279873], [66, 280093], [75, 280613], [77, 280913], [86, 281816], [91, 282204], [94, 282604], [97, 283104], [101, 283444], [104, 283524], [108, 283684]]}, {"verse": 39, "start": 284799, "end": 293399, "text": "Y uno de los malhechores que estaban colgados, le injuriaba, diciendo: Si tú eres el Cristo, sálvate a ti mismo y a nosotros.", "words": [[0, 284799], [2, 284924], [6, 285084], [9, 285204], [13, 285324], [25, 285944], [29, 286144], [37, 286654], [47, 287164], [50, 287624], [61, 288484], [71, 289714], [74, 289919], [77, 290079], [82, 290259], [85, 290419], [93, 291419], [101, 291779], [103, 291959], [106, 292039], [112, 292399], [114, 292579], [116, 292659]]}, {"verse": 40, "start": 293679, "end": 301176, "text": "Y respondiendo el otro, le reprendió, diciendo: ¿Ni aun tú temes a Dios, estando en la misma condenación?", "words": [[0, 293679], [2, 294084], [15, 294524], [18, 294724], [24, 295484], [27, 295724], [38, 296504], [48, 297756], [52, 297913], [56, 298073], [59, 298333], [65, 298713], [67, 298813], [73, 299333], [81, 299733], [84, 299833], [87, 299933], [93, 300173]]}, {"verse": 41, "start": 301526, "end": 308725, "text": "Y nosotros, a la verdad, justamente padecemos; porque recibimos lo que merecieron nuestros hechos: pero este ningún mal hizo.", "words": [[0, 301526], [2, 301611], [12, 302131], [14, 302231], [17, 302311], [25, 302971], [36, 303311], [47, 304528], [54, 304710], [64, 305330], [67, 305510], [71, 305630], [82, 306170], [91, 306430], [99, 307180], [104, 307498], [109, 307718], [116, 308058], [120, 308418]]}, {"verse": 42, "start": 309005, "end": 312693, "text": "Y dijo a Jesús: Acuérdate de mí cuando vengas a tu reino.", "words": [[0, 309005], [2, 309171], [7, 309451], [9, 309551], [16, 310483], [26, 311004], [29, 311244], [32, 311364], [39, 311584], [46, 312064], [48, 312144], [51, 312264]]}, {"verse": 43, "start": 312973, "end": 318626, "text": "Entonces Jesús le dijo: De cierto te digo, que hoy estarás conmigo en el paraíso.", "words": [[0, 312973], [9, 313437], [15, 313937], [18, 314257], [24, 314966], [27, 315112], [34, 315412], [37, 315792], [43, 316152], [47, 316367], [51, 316627], [59, 317107], [67, 317627], [70, 317747], [73, 318213]]}, {"verse": 44, "start": 318976, "end": 326479, "text": "Y cuando era como la hora de sexta, fueron hechas tinieblas sobre toda la tierra hasta la hora de nona.", "words": [[0, 318976], [2, 319100], [9, 319360], [13, 319700], [18, 319960], [21, 320160], [26, 320340], [29, 320520], [36, 321440], [43, 321900], [50, 322420], [60, 322940], [66, 323200], [71, 323560], [74, 323760], [81, 324100], [87, 324560], [90, 325048], [95, 325537], [98, 326025]]}, {"verse": 45, "start": 326829, "end": 331318, "text": "Y el sol se oscureció: y el velo del templo se rompió por medio.", "words": [[0, 326829], [2, 326829], [5, 326829], [9, 326829], [12, 327075], [23, 328300], [25, 328428], [28, 328568], [33, 328868], [37, 329028], [44, 329668], [47, 329748], [54, 330328], [58, 330588]]}, {"verse": 46, "start": 331668, "end": 342040, "text": "Entonces Jesús, clamando a gran voz, dijo: Padre, en tus manos encomiendo mi espíritu. Y habiendo dicho esto, exhaló su último aliento.", "words": [[0, 331668], [9, 332146], [16, 332886], [25, 333386], [27, 333466], [32, 333626], [37, 334226], [43, 334867], [50, 335354], [53, 335614], [57, 335794], [63, 336194], [74, 337034], [77, 337274], [87, 338321], [89, 338448], [98, 338768], [104, 339068], [110, 340088], [117, 340588], [120, 340748], [127, 341208]]}, {"verse": 47, "start": 342390, "end": 350559, "text": "Y como el centurión vio lo que había acontecido, dio gloria a Dios, diciendo: Verdaderamente este hombre era justo.", "words": [[0, 342390], [2, 342491], [7, 342731], [10, 342931], [20, 343551], [24, 343831], [27, 343951], [31, 344111], [37, 344351], [49, 345571], [53, 345971], [60, 346571], [62, 346891], [68, 347151], [78, 348472], [93, 349270], [98, 349490], [105, 349750], [109, 350010]]}, {"verse": 48, "start": 350839, "end": 360556, "text": "Y toda la multitud de los que estaban presentes a este espectáculo, viendo lo que había acontecido, se volvían golpeándose el pecho.", "words": [[0, 350839], [2, 350963], [7, 351243], [10, 351483], [19, 352263], [22, 352543], [26, 352683], [30, 352803], [38, 353143], [48, 353883], [50, 354003], [55, 354243], [68, 355463], [75, 355963], [78, 356263], [82, 356403], [88, 356723], [100, 357963], [103, 358143], [111, 358683], [123, 359643], [126, 359843]]}, {"verse": 49, "start": 360906, "end": 368130, "text": "Pero todos sus conocidos, y las mujeres que le habían seguido desde Galilea, estaban lejos mirando estas cosas.", "words": [[0, 360906], [5, 361047], [11, 361367], [15, 361667], [26, 362467], [28, 362627], [32, 362767], [40, 363187], [44, 363507], [47, 363667], [54, 363927], [62, 364507], [68, 364687], [77, 365467], [85, 366047], [91, 366647], [99, 367192], [105, 367352]]}, {"verse": 50, "start": 368480, "end": 375546, "text": "Y he aquí un varón llamado José, el cual era miembro del Consejo, varón bueno y justo,", "words": [[0, 368480], [2, 368626], [5, 368786], [10, 369066], [13, 369306], [19, 369666], [27, 369946], [33, 371126], [36, 371226], [41, 371486], [45, 371886], [53, 372466], [57, 372646], [66, 373906], [72, 374346], [78, 374646], [80, 374926]]}, {"verse": 51, "start": 375896, "end": 385848, "text": "(El cual no había consentido en el consejo ni en los hechos de ellos), de Arimatea, ciudad de la Judea, el cual también esperaba el reino de Dios;", "words": [[0, 375896], [4, 376039], [9, 376199], [12, 376439], [18, 376679], [29, 377459], [32, 377559], [35, 377659], [43, 378239], [46, 378359], [49, 378459], [53, 378619], [60, 378939], [63, 379139], [71, 379919], [74, 380159], [84, 381179], [91, 381619], [94, 381919], [97, 382039], [104, 382939], [107, 383059], [112, 383279], [120, 383839], [129, 384639], [132, 384799], [138, 385199], [141, 385339]]}, {"verse": 52, "start": 386198, "end": 390053, "text": "Este llegó a Pilato, y pidió el cuerpo de Jesús.", "words": [[0, 386198], [5, 386455], [11, 386775], [13, 386875], [21, 387415], [23, 388215], [29, 388555], [32, 388655], [39, 389015], [42, 389295]]}, {"verse": 53, "start": 390403, "end": 399770, "text": "Y quitado, lo envolvió en una sábana, y le puso en un sepulcro abierto en una peña, en el cual ninguno había aún sido puesto.", "words": [[0, 390403], [2, 390530], [11, 390970], [14, 391110], [23, 391630], [26, 391730], [30, 391890], [38, 392510], [40, 393170], [43, 393310], [48, 393730], [51, 393870], [54, 394030], [63, 394770], [71, 395510], [74, 395730], [78, 395890], [84, 396410], [87, 396890], [90, 397010], [95, 397270], [103, 397990], [109, 398270], [113, 398650], [118, 399010]]}, {"verse": 54, "start": 400120, "end": 404733, "text": "Y era día de la víspera de la Pascua; y estaba para comenzar el sábado.", "words": [[0, 400120], [2, 400322], [6, 400462], [10, 400702], [13, 400902], [16, 401042], [24, 401502], [27, 401582], [30, 401682], [38, 402557], [40, 402681], [47, 403001], [52, 403281], [61, 403941], [64, 404061]]}, {"verse": 55, "start": 405083, "end": 413668, "text": "Y las mujeres que con él habían venido de Galilea, siguieron también y vieron el sepulcro, y cómo fue puesto su cuerpo.", "words": [[0, 405083], [2, 405322], [6, 405442], [14, 405922], [18, 406247], [22, 406467], [25, 406607], [32, 406847], [39, 407307], [42, 407467], [51, 408167], [61, 408947], [69, 409367], [71, 409967], [78, 410307], [81, 410507], [91, 411227], [93, 411827], [98, 412127], [102, 412407], [109, 412787], [112, 413027]]}, {"verse": 56, "start": 414018, "end": 421527, "text": "Y vueltas, prepararon especias aromáticas y ungüentos; y descansaron el sábado, conforme al mandamiento.", "words": [[0, 414018], [2, 414138], [11, 414598], [22, 415318], [31, 416038], [42, 416798], [44, 417078], [55, 418214], [57, 418336], [69, 419076], [72, 419256], [80, 419896], [89, 420556], [92, 420656]]}]}