{"book": "ACT", "chapter": 3, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 220143, "verses": [{"verse": 1, "start": 300, "end": 5358, "text": "Pedro y Juan subían juntos al templo a la hora de oración, la novena.", "words": [[0, 300], [6, 565], [8, 725], [13, 1025], [20, 1565], [27, 1885], [30, 2265], [37, 2805], [39, 2925], [42, 3045], [47, 3325], [50, 3525], [59, 4065], [62, 4685]]}, {"verse": 2, "start": 5808, "end": 19698, "text": "Y un hombre que era cojo desde el vientre de su madre, era traído; al cual ponían cada día a la puerta del templo que se llama la Hermosa, para que pidiese limosna de los que entraban en el templo.", "words": [[0, 5808], [2, 5905], [5, 6045], [12, 6305], [16, 6525], [20, 6665], [25, 7065], [31, 7265], [34, 7485], [42, 7965], [45, 8085], [48, 8245], [55, 8845], [59, 9065], [67, 10159], [70, 10334], [75, 10554], [82, 11194], [87, 11534], [91, 11954], [93, 12274], [96, 12354], [103, 12714], [107, 13134], [114, 13814], [118, 13914], [121, 14094], [127, 14434], [130, 14674], [139, 15634], [144, 15954], [148, 16114], [156, 16714], [164, 17534], [167, 17694], [171, 17834], [175, 18014], [184, 18634], [187, 18854], [190, 19034]]}, {"verse": 3, "start": 20148, "end": 26858, "text": "Este, cuando vio a Pedro y a Juan que iban a entrar en el templo, rogaba que le diesen limosna.", "words": [[0, 20148], [6, 20493], [13, 20733], [17, 21153], [19, 21253], [25, 21633], [27, 21853], [29, 21933], [34, 22213], [38, 22413], [43, 22713], [45, 22813], [52, 23213], [55, 23453], [58, 23593], [66, 24513], [73, 25153], [77, 25353], [80, 25533], [87, 25933]]}, {"verse": 4, "start": 27308, "end": 32071, "text": "Y Pedro, con Juan, fijando los ojos en él, dijo: Míranos.", "words": [[0, 27308], [2, 27417], [9, 27777], [13, 28097], [19, 28897], [27, 29417], [31, 29617], [36, 29917], [39, 30197], [43, 30597], [49, 31749]]}, {"verse": 5, "start": 32421, "end": 37848, "text": "Entonces él estuvo atento a ellos, esperando recibir de ellos algo.", "words": [[0, 32421], [9, 33003], [12, 33903], [19, 34343], [26, 34763], [28, 34903], [35, 35583], [45, 36063], [53, 36623], [56, 36943], [62, 37203]]}, {"verse": 6, "start": 38298, "end": 48185, "text": "Y Pedro dijo: Ni tengo plata ni oro; pero lo que tengo te doy: en el nombre de Jesucristo de Nazaret, levántate y anda.", "words": [[0, 38298], [2, 38404], [8, 38884], [14, 39839], [17, 39929], [23, 40269], [29, 40609], [32, 40829], [37, 41465], [42, 41587], [45, 41727], [49, 41827], [55, 42087], [58, 42267], [63, 42914], [66, 43055], [69, 43155], [76, 43455], [79, 43615], [90, 44255], [93, 44355], [102, 45135], [112, 45735], [114, 45995]]}, {"verse": 7, "start": 48535, "end": 54633, "text": "Y tomándole por la mano derecha le levantó: y de inmediato se fortalecieron sus pies y tobillos;", "words": [[0, 48535], [2, 48642], [12, 49202], [16, 49402], [19, 49562], [24, 49782], [32, 50242], [35, 50382], [44, 51377], [46, 51525], [49, 51645], [59, 52285], [62, 52425], [76, 53225], [80, 53385], [85, 53625], [87, 53805]]}, {"verse": 8, "start": 55083, "end": 63059, "text": "Y saltando, se puso en pie, y anduvo; y entró con ellos en el templo, andando, y saltando, y alabando a Dios.", "words": [[0, 55083], [2, 55223], [12, 55803], [15, 55983], [20, 56383], [23, 56583], [28, 56843], [30, 57103], [38, 58062], [40, 58207], [46, 58627], [50, 58787], [56, 59007], [59, 59247], [62, 59407], [70, 60087], [79, 60567], [81, 60747], [91, 61527], [93, 61947], [102, 62447], [104, 62527]]}, {"verse": 9, "start": 63509, "end": 66813, "text": "Y todo el pueblo le vio andar y alabar a Dios.", "words": [[0, 63509], [2, 63632], [7, 63852], [10, 64052], [17, 64492], [20, 64752], [24, 65032], [30, 65392], [32, 65772], [39, 66172], [41, 66252]]}, {"verse": 10, "start": 67263, "end": 78773, "text": "Y conocían que él era el que se sentaba a la limosna a la puerta del templo, la Hermosa: y fueron llenos de asombro y de espanto por lo que le había acontecido.", "words": [[0, 67263], [2, 67403], [11, 68023], [15, 68263], [18, 68583], [22, 68943], [25, 69203], [29, 69363], [32, 69523], [40, 70123], [42, 70343], [45, 70423], [53, 71043], [55, 71223], [58, 71303], [65, 71563], [69, 71883], [77, 72783], [80, 72903], [89, 73885], [91, 73974], [98, 74174], [105, 74674], [108, 74814], [116, 75454], [118, 75614], [121, 75774], [129, 76414], [133, 76954], [136, 77214], [140, 77374], [143, 77534], [149, 77814]]}, {"verse": 11, "start": 79223, "end": 90009, "text": "Y mientras el cojo que había sido sanado sujetaba a Pedro y a Juan, todo el pueblo concurrió a ellos al pórtico que se llama de Salomón, atónitos.", "words": [[0, 79223], [2, 79349], [11, 79709], [14, 79989], [19, 80429], [23, 80569], [29, 80789], [34, 81149], [41, 81689], [50, 82429], [52, 82569], [58, 82909], [60, 83169], [62, 83249], [68, 84029], [73, 84229], [76, 84449], [83, 85119], [93, 85789], [95, 86009], [101, 86249], [104, 86529], [112, 87429], [116, 87589], [119, 87729], [125, 87989], [128, 88189], [137, 89133]]}, {"verse": 12, "start": 90459, "end": 103449, "text": "Y viendo esto Pedro, respondió al pueblo: Varones israelitas, ¿por qué os maravilláis de esto? o ¿por qué ponéis los ojos en nosotros, como si con nuestro poder o piedad hubiésemos hecho andar a este?", "words": [[0, 90459], [2, 90563], [9, 90863], [14, 91283], [21, 91643], [31, 92723], [34, 92823], [42, 93660], [50, 94027], [62, 95167], [67, 95447], [71, 95667], [74, 95807], [86, 96387], [89, 96587], [95, 97378], [97, 97497], [102, 97657], [106, 97817], [113, 98217], [117, 98357], [122, 98637], [125, 98857], [135, 99597], [140, 99917], [143, 100077], [147, 100277], [155, 100477], [161, 100977], [163, 101237], [170, 101677], [181, 102297], [187, 102557], [193, 102777], [195, 102977]]}, {"verse": 13, "start": 103899, "end": 116620, "text": "El Dios de Abraham, y de Isaac, y de Jacob, el Dios de nuestros padres ha glorificado a su Hijo Jesús, al cual vosotros entregasteis, y negasteis delante de Pilato, juzgando él que había de ser suelto.", "words": [[0, 103899], [3, 104018], [8, 104239], [11, 104399], [20, 104779], [22, 105239], [25, 105358], [32, 105739], [34, 106179], [37, 106279], [44, 107218], [47, 107358], [52, 107539], [55, 107699], [64, 107899], [71, 108399], [74, 108739], [86, 109459], [88, 109559], [91, 109699], [96, 109858], [103, 110679], [106, 110899], [111, 111059], [120, 111539], [134, 112419], [136, 112619], [146, 113218], [154, 113639], [157, 113759], [165, 114853], [174, 115093], [177, 115313], [181, 115493], [187, 115693], [190, 115873], [194, 116033]]}, {"verse": 14, "start": 117070, "end": 122054, "text": "Pero vosotros al Santo y al Justo negasteis, y pedisteis que se os diese un homicida;", "words": [[0, 117070], [5, 117214], [14, 117874], [17, 117974], [23, 118374], [25, 118494], [28, 118614], [34, 118874], [45, 119694], [47, 120054], [57, 120594], [61, 120714], [64, 120854], [67, 121074], [73, 121294], [76, 121454]]}, {"verse": 15, "start": 122504, "end": 129434, "text": "Y matasteis al Autor de la vida, al cual Dios ha resucitado de los muertos; de lo que nosotros somos testigos.", "words": [[0, 122504], [2, 122602], [12, 123202], [15, 123322], [21, 123622], [24, 123802], [27, 123902], [33, 124482], [36, 124842], [41, 125022], [46, 125362], [49, 125682], [60, 126382], [63, 126482], [67, 126602], [76, 127638], [79, 127736], [82, 127836], [86, 127916], [95, 128216], [101, 128596]]}, {"verse": 16, "start": 129884, "end": 141303, "text": "Y en la fe de su nombre, a este que vosotros veis y conocéis, su nombre lo ha fortalecido: y la fe que por él es, ha dado a este esta completa sanidad en presencia de todos vosotros.", "words": [[0, 129884], [2, 129987], [5, 130087], [8, 130187], [11, 130327], [14, 130447], [17, 130567], [25, 131247], [27, 131487], [32, 131727], [36, 131867], [45, 132307], [50, 132707], [52, 132807], [62, 133707], [65, 133807], [72, 134107], [75, 134287], [78, 134387], [91, 135499], [93, 135604], [96, 135724], [99, 135944], [103, 136084], [107, 136324], [110, 136444], [114, 137124], [117, 137264], [122, 137504], [124, 137664], [129, 137944], [134, 138264], [143, 138684], [151, 139324], [154, 139484], [164, 140044], [167, 140204], [173, 140424]]}, {"verse": 17, "start": 141753, "end": 146648, "text": "Pero ahora, hermanos, sé que por ignorancia lo habéis hecho, como también vuestros príncipes.", "words": [[0, 141753], [5, 141872], [12, 142132], [22, 142892], [25, 143152], [29, 143292], [33, 143472], [44, 144012], [47, 144212], [54, 144472], [61, 144792], [66, 145092], [74, 145432], [83, 145832]]}, {"verse": 18, "start": 147098, "end": 154411, "text": "Pero Dios ha cumplido así lo que había antes anunciado por boca de todos sus profetas, que su Cristo había de padecer.", "words": [[0, 147098], [5, 147236], [10, 147476], [13, 147696], [22, 148236], [26, 148556], [29, 149016], [33, 149156], [39, 149376], [45, 149776], [55, 150436], [59, 150656], [64, 151016], [67, 151216], [73, 151436], [77, 151736], [87, 152576], [91, 152736], [94, 152916], [101, 153256], [107, 153576], [110, 153796]]}, {"verse": 19, "start": 154861, "end": 163125, "text": "Así que, arrepentíos y convertíos, para que sean borrados vuestros pecados; pues que vendrán los tiempos de alivio de la presencia del Señor,", "words": [[0, 154861], [4, 155079], [9, 155219], [21, 155939], [23, 156039], [35, 156799], [40, 157219], [44, 157359], [49, 157599], [58, 158079], [67, 158479], [76, 159458], [81, 159597], [85, 159777], [93, 160197], [97, 160357], [105, 160837], [108, 160977], [115, 161417], [118, 161517], [121, 161637], [131, 162217], [135, 162397]]}, {"verse": 20, "start": 163575, "end": 166939, "text": "Y enviará a Jesucristo, que os fue antes anunciado:", "words": [[0, 163575], [2, 163702], [10, 164242], [12, 164242], [24, 165082], [28, 165442], [31, 165582], [35, 165802], [41, 166082]]}, {"verse": 21, "start": 167389, "end": 178209, "text": "Al cual de cierto es necesario que el cielo reciba hasta los tiempos de la restauración de todas las cosas, que habló Dios por boca de sus santos profetas que han sido desde tiempos antiguos.", "words": [[0, 167389], [3, 167507], [8, 167667], [11, 167887], [18, 168167], [21, 168467], [31, 169027], [35, 169287], [38, 169447], [44, 169687], [51, 170327], [57, 170527], [61, 170707], [69, 171167], [72, 171247], [75, 171367], [88, 172107], [91, 172287], [97, 172467], [101, 172727], [108, 173674], [112, 173755], [118, 174115], [123, 174315], [127, 174635], [132, 174935], [135, 175115], [139, 175255], [146, 175695], [155, 176215], [159, 176395], [163, 176515], [168, 176755], [174, 177015], [182, 177515]]}, {"verse": 22, "start": 178659, "end": 187531, "text": "Porque Moisés dijo a los padres: El Señor vuestro Dios os levantará profeta de entre vuestros hermanos, como yo; a él oiréis en todas las cosas que os hable.", "words": [[0, 178659], [7, 178864], [14, 179244], [19, 179624], [21, 179724], [25, 179824], [33, 180709], [36, 180807], [42, 181087], [50, 181507], [55, 181827], [58, 181907], [68, 182467], [76, 182947], [79, 183067], [85, 183227], [94, 183627], [104, 184167], [109, 184347], [113, 185033], [115, 185160], [118, 185340], [125, 185780], [128, 185960], [134, 186120], [138, 186380], [144, 186700], [148, 186960], [151, 187120]]}, {"verse": 23, "start": 187981, "end": 192643, "text": "Y será, que toda alma que no oiga a aquel profeta, será desarraigada del pueblo.", "words": [[0, 187981], [2, 188086], [8, 188286], [12, 188466], [17, 188686], [22, 189046], [26, 189246], [29, 189466], [34, 189766], [36, 189946], [42, 190146], [51, 190726], [56, 191166], [69, 191926], [73, 192106]]}, {"verse": 24, "start": 193093, "end": 199481, "text": "Y todos los profetas desde Samuel y en adelante, todos los que han hablado, han anunciado estos días.", "words": [[0, 193093], [2, 193218], [8, 193418], [12, 193678], [21, 194238], [27, 194478], [34, 195018], [36, 195318], [39, 195418], [49, 196358], [55, 196658], [59, 196898], [63, 197098], [67, 197238], [76, 197798], [80, 197978], [90, 198638], [96, 198838]]}, {"verse": 25, "start": 199931, "end": 210859, "text": "Vosotros sois los hijos de los profetas, y del pacto que Dios concertó con nuestros padres, diciendo a Abraham: Y en tu simiente serán benditas todas las familias de la tierra.", "words": [[0, 199931], [9, 200434], [14, 200854], [18, 200994], [24, 201274], [27, 201494], [31, 201614], [41, 202234], [43, 202834], [47, 203014], [53, 203514], [57, 203614], [62, 203794], [71, 204454], [75, 204614], [84, 204834], [92, 205714], [101, 206054], [103, 206394], [112, 207181], [114, 207309], [117, 207582], [120, 207856], [129, 208129], [135, 208529], [144, 209089], [150, 209369], [154, 209649], [163, 210149], [166, 210249], [169, 210349]]}, {"verse": 26, "start": 211309, "end": 219743, "text": "A vosotros primeramente, Dios, habiendo levantado a su Hijo, le envió para que os bendijese, a fin de que cada uno se convierta de su maldad.", "words": [[0, 211309], [2, 211426], [11, 211786], [25, 212486], [31, 213116], [40, 213746], [50, 214246], [52, 214326], [55, 214486], [61, 215166], [64, 215266], [70, 215666], [75, 215846], [79, 216006], [82, 216606], [93, 217206], [95, 217286], [99, 217486], [102, 217646], [106, 217746], [111, 217966], [115, 218226], [118, 218406], [128, 218966], [131, 219086], [134, 219206]]}]}