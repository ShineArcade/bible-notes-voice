{"book": "ISA", "chapter": 38, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 181037, "verses": [{"verse": 1, "start": 300, "end": 13469, "text": "En aquellos días cayó Ezequías enfermo para morir. Y vino a él Isaías profeta, hijo de Amoz, y le dijo: Jehová dice así: Ordena tu casa, porque tú morirás, y no vivirás.", "words": [[0, 300], [3, 404], [12, 644], [17, 1044], [22, 1614], [31, 2184], [39, 2784], [44, 3004], [51, 3885], [53, 4012], [58, 4232], [60, 4432], [63, 4572], [70, 5172], [79, 5992], [84, 6152], [87, 6552], [93, 6952], [95, 6972], [98, 7112], [104, 8224], [111, 8594], [116, 9114], [121, 9816], [128, 10239], [131, 10379], [137, 11059], [144, 11239], [147, 11499], [156, 12079], [158, 12559], [161, 12719]]}, {"verse": 2, "start": 14049, "end": 19663, "text": "Entonces volvió Ezequías su rostro a la pared, e hizo oración a Jehová,", "words": [[0, 14049], [9, 14853], [16, 15493], [25, 16113], [28, 16413], [35, 16933], [37, 17053], [40, 17113], [47, 17533], [49, 17913], [54, 18253], [62, 18913], [64, 19153]]}, {"verse": 3, "start": 20113, "end": 32477, "text": "Y dijo: Oh Jehová, te ruego que te acuerdes ahora que he andado delante de ti en verdad y con íntegro corazón, y que he hecho lo que ha sido agradable delante de tus ojos. Y lloró Ezequías con gran lloro.", "words": [[0, 20113], [2, 20255], [8, 21032], [11, 21102], [19, 21522], [22, 21602], [28, 21902], [32, 22042], [35, 22182], [44, 22662], [50, 22942], [54, 23202], [57, 23322], [64, 23722], [72, 24142], [75, 24282], [78, 24502], [81, 24682], [88, 25042], [90, 25282], [94, 25442], [102, 25882], [111, 26892], [113, 26994], [117, 27114], [120, 27214], [126, 27414], [129, 27554], [133, 27674], [136, 27814], [141, 27994], [151, 28534], [159, 28914], [162, 29034], [166, 29174], [172, 30129], [174, 30266], [180, 30706], [189, 31366], [193, 31606], [198, 31866]]}, {"verse": 4, "start": 32927, "end": 37441, "text": "Entonces vino palabra de Jehová a Isaías, diciendo:", "words": [[0, 32927], [9, 33684], [14, 34304], [22, 34684], [25, 34944], [32, 35444], [34, 35644], [42, 36644]]}, {"verse": 5, "start": 37691, "end": 49315, "text": "Ve, y di a Ezequías: Jehová Dios de David tu padre dice así: Tu oración he oído, y visto tus lágrimas: he aquí que yo añado a tus días quince años.", "words": [[0, 37691], [4, 37974], [6, 38344], [9, 38714], [11, 39084], [21, 39998], [28, 40600], [33, 40760], [36, 40980], [42, 41440], [45, 41500], [51, 41980], [56, 42120], [61, 43166], [64, 43268], [72, 43708], [75, 44008], [81, 44388], [83, 44848], [89, 45128], [93, 45348], [103, 46669], [106, 46795], [111, 47055], [115, 47215], [118, 47375], [124, 47735], [126, 47835], [130, 47935], [135, 48245], [142, 48555]]}, {"verse": 6, "start": 50037, "end": 56173, "text": "Y te libraré, y a esta ciudad, de mano del rey de Asiria; y a esta ciudad ampararé.", "words": [[0, 50037], [2, 50160], [5, 50260], [14, 50860], [16, 51140], [18, 51200], [23, 51440], [31, 51840], [34, 52220], [39, 52560], [43, 52700], [47, 52920], [50, 53100], [58, 54322], [60, 54483], [62, 54543], [67, 54803], [74, 55488]]}, {"verse": 7, "start": 56712, "end": 60898, "text": "Y esto te será señal de parte de Jehová, que Jehová hará esto que ha dicho:", "words": [[0, 56712], [2, 56836], [7, 57076], [10, 57196], [15, 57396], [21, 57816], [24, 57936], [30, 58156], [33, 58336], [41, 58796], [45, 59216], [52, 59676], [57, 59956], [62, 60196], [66, 60376], [69, 60456]]}, {"verse": 8, "start": 61198, "end": 75062, "text": "He aquí que yo vuelvo atrás la sombra de los grados, que ha descendido en el reloj de Acaz por el sol, diez grados. Y el sol fue tornado diez grados atrás, por los cuales había ya descendido.", "words": [[0, 61198], [3, 61319], [8, 61599], [12, 61759], [15, 61939], [22, 62279], [28, 62839], [31, 62919], [38, 63319], [41, 63419], [45, 63539], [53, 64279], [57, 64519], [60, 64619], [71, 65219], [74, 65339], [77, 65419], [83, 65819], [86, 66049], [91, 66279], [95, 66459], [98, 66599], [103, 67009], [108, 67419], [116, 68829], [118, 68973], [121, 69153], [125, 69433], [129, 69733], [137, 70233], [142, 70733], [149, 71453], [156, 72333], [160, 72553], [164, 72713], [171, 73053], [177, 73773], [180, 74073]]}, {"verse": 9, "start": 75512, "end": 81446, "text": "Escritura de Ezequías rey de Judá, de cuando enfermó y sanó de su enfermedad.", "words": [[0, 75512], [10, 76258], [13, 76838], [22, 77418], [26, 77758], [29, 78098], [35, 78738], [38, 78918], [45, 79138], [53, 79838], [55, 79978], [60, 80318], [63, 80438], [66, 80558]]}, {"verse": 10, "start": 81746, "end": 88250, "text": "Yo dije: En el medio de mis días iré a las puertas del sepulcro: privado soy del resto de mis años.", "words": [[0, 81746], [3, 81944], [9, 82675], [12, 82816], [15, 82936], [21, 83216], [24, 83376], [28, 83516], [33, 83836], [37, 84236], [39, 84276], [43, 84416], [51, 84856], [55, 85036], [65, 86060], [73, 86560], [77, 86780], [81, 87020], [87, 87320], [90, 87540], [94, 87680]]}, {"verse": 11, "start": 88700, "end": 96178, "text": "Dije: No veré a JAH, a JAH en la tierra de los que viven: ya no veré más hombre con los habitantes del mundo.", "words": [[0, 88961], [6, 89498], [9, 89664], [14, 89984], [16, 90304], [21, 90624], [23, 90944], [27, 91264], [30, 91384], [33, 91504], [40, 91804], [43, 92004], [47, 92144], [51, 92324], [58, 93006], [61, 93168], [64, 93348], [69, 93668], [73, 93828], [80, 94128], [84, 94388], [88, 94528], [99, 95128], [103, 95348]]}, {"verse": 12, "start": 96628, "end": 106424, "text": "Mi morada ha sido movida y traspasada de mí, como tienda de pastor. Como el tejedor corté mi vida; me cortará con la enfermedad; me consumirás entre el día y la noche.", "words": [[0, 96628], [3, 96752], [10, 97152], [13, 97292], [18, 97472], [25, 97932], [27, 98032], [38, 98652], [41, 98812], [45, 99352], [50, 99605], [57, 99859], [60, 100112], [68, 100906], [73, 101067], [76, 101187], [84, 101567], [90, 101967], [93, 102067], [99, 102764], [102, 102842], [110, 103262], [114, 103402], [117, 103522], [129, 104447], [132, 104526], [143, 105166], [149, 105386], [152, 105566], [156, 105726], [158, 105846], [161, 105966]]}, {"verse": 13, "start": 106874, "end": 113056, "text": "Contaba yo hasta la mañana. Como un león molió todos mis huesos: de la mañana a la noche me acabarás.", "words": [[0, 106874], [8, 107234], [11, 107434], [17, 107614], [20, 107754], [28, 108599], [33, 108783], [36, 108943], [41, 109283], [47, 109623], [53, 109823], [57, 110103], [65, 111039], [68, 111124], [71, 111244], [78, 111584], [80, 111824], [83, 111904], [89, 112184], [92, 112364]]}, {"verse": 14, "start": 113506, "end": 122447, "text": "Como la grulla y como la golondrina me quejaba; gemía como la paloma: alzaba en alto mis ojos: Jehová, violencia padezco; confórtame.", "words": [[0, 113506], [5, 113649], [8, 113909], [15, 114169], [17, 114269], [22, 114449], [25, 114589], [36, 115149], [39, 115289], [48, 116211], [54, 116600], [59, 116800], [62, 116960], [70, 117973], [77, 118213], [80, 118313], [85, 118493], [89, 118693], [95, 119592], [103, 120293], [113, 120853], [122, 121713]]}, {"verse": 15, "start": 122897, "end": 130256, "text": "¿Qué diré? El que me lo dijo, él mismo lo ha hecho. Andaré recapacitando en la amargura de mi alma todos los años de mi vida.", "words": [[0, 122897], [5, 122999], [11, 123716], [14, 123820], [18, 123920], [21, 124020], [24, 124120], [30, 124680], [33, 124860], [39, 125100], [42, 125320], [45, 125420], [52, 126143], [59, 126546], [73, 127446], [76, 127566], [79, 127686], [88, 128166], [91, 128286], [94, 128426], [99, 128666], [105, 128986], [109, 129246], [114, 129506], [117, 129686], [120, 129786]]}, {"verse": 16, "start": 130706, "end": 139444, "text": "Oh Señor, sobre ellos vivirán tus piedades, y a todos diré consistir en ellas la vida de mi espíritu; pues tú me restablecerás, y me harás que viva.", "words": [[0, 130801], [3, 130931], [10, 131391], [16, 131551], [22, 131831], [30, 132351], [34, 132511], [44, 133511], [46, 133571], [48, 133691], [54, 133931], [59, 134311], [69, 134891], [72, 134991], [78, 135171], [81, 135371], [86, 135551], [89, 135711], [92, 135831], [102, 136747], [107, 136870], [110, 137110], [113, 137230], [128, 138170], [130, 138430], [133, 138590], [139, 138890], [143, 139030]]}, {"verse": 17, "start": 139894, "end": 148949, "text": "He aquí amargura grande me sobrevino en la paz: mas a ti agradó librar mi vida del hoyo de corrupción: porque echaste tras tus espaldas todos mis pecados.", "words": [[0, 139930], [3, 140000], [8, 140360], [17, 140720], [24, 141060], [27, 141260], [37, 141800], [40, 141900], [43, 142000], [48, 142765], [52, 142930], [54, 143090], [57, 143190], [64, 143630], [71, 143990], [74, 144130], [79, 144370], [83, 144550], [88, 144810], [91, 144870], [103, 145880], [110, 146106], [118, 146686], [123, 146906], [127, 147126], [136, 147766], [142, 147986], [146, 148266]]}, {"verse": 18, "start": 149399, "end": 155661, "text": "Porque el sepulcro no te celebrará, ni te alabará la muerte; ni los que descienden al hoyo esperarán tu verdad.", "words": [[0, 149399], [7, 149642], [10, 149782], [19, 150282], [22, 150442], [25, 150582], [36, 151222], [39, 151502], [42, 151682], [50, 152122], [53, 152262], [61, 153111], [64, 153230], [68, 153370], [72, 153530], [83, 154090], [86, 154290], [91, 154550], [101, 155110], [104, 155190]]}, {"verse": 19, "start": 156111, "end": 162025, "text": "El que vive, el que vive, este te confesará, como yo hoy: el padre hará notoria tu verdad a los hijos.", "words": [[0, 156111], [3, 156229], [7, 156369], [13, 156729], [16, 156789], [20, 156889], [26, 157429], [31, 157709], [34, 157869], [45, 158569], [50, 158769], [53, 158989], [58, 159596], [61, 159702], [67, 160082], [72, 160442], [80, 160802], [83, 160902], [90, 161162], [92, 161382], [96, 161482]]}, {"verse": 20, "start": 162475, "end": 168707, "text": "Jehová para salvarme; por tanto cantaremos nuestros salmos en la casa de Jehová todos los días de nuestra vida.", "words": [[0, 162475], [7, 162818], [12, 162938], [22, 163887], [26, 164007], [32, 164287], [43, 164927], [52, 165167], [59, 165827], [62, 165967], [65, 166067], [70, 166327], [73, 166507], [80, 166907], [86, 167127], [90, 167427], [95, 167727], [98, 167947], [106, 168107]]}, {"verse": 21, "start": 169057, "end": 174591, "text": "Y había dicho Isaías: Tomen masa de higos, y pónganla en la llaga, y sanará.", "words": [[0, 169057], [2, 169181], [8, 169361], [14, 169741], [22, 171184], [28, 171442], [33, 171722], [36, 171942], [43, 172362], [45, 172702], [54, 173242], [57, 173322], [60, 173422], [67, 173802], [69, 174042]]}, {"verse": 22, "start": 174941, "end": 180637, "text": "Había asimismo dicho Ezequías: ¿Qué señal tendré de que he de subir a la casa de Jehová?", "words": [[0, 174941], [6, 175519], [15, 176129], [21, 176489], [31, 177785], [36, 177890], [42, 178330], [49, 178710], [52, 178810], [56, 178950], [59, 179090], [62, 179110], [68, 179390], [70, 179590], [73, 179670], [78, 179910], [81, 180090]]}]}