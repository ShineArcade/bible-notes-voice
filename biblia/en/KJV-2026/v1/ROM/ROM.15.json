{"book": "ROM", "chapter": 15, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 218559, "verses": [{"verse": 1, "start": 300, "end": 4652, "text": "We then that are strong ought to bear the infirmities of the weak, and not to please ourselves.", "words": [[0, 300], [3, 425], [8, 585], [13, 745], [17, 865], [24, 1205], [30, 1485], [33, 1645], [38, 1825], [42, 1965], [54, 2405], [57, 2585], [61, 2685], [67, 2925], [71, 3345], [75, 3545], [78, 3685], [85, 3865]]}, {"verse": 2, "start": 5102, "end": 8063, "text": "Let every one of us please his neighbour for his good to edification.", "words": [[0, 5102], [4, 5203], [10, 5483], [14, 5663], [17, 5743], [20, 5863], [27, 6123], [31, 6383], [41, 6643], [45, 6883], [49, 7023], [54, 7203], [57, 7363]]}, {"verse": 3, "start": 8513, "end": 14778, "text": "For even Christ pleased not himself; but, as it is written, The reproaches of them that reproached you fell on me.", "words": [[0, 8513], [4, 8636], [9, 8816], [16, 9166], [24, 9516], [28, 9776], [37, 10635], [42, 11152], [45, 11332], [48, 11472], [51, 11572], [60, 12252], [64, 12372], [75, 12852], [78, 13052], [83, 13272], [88, 13432], [99, 13952], [103, 14072], [108, 14312], [111, 14512]]}, {"verse": 4, "start": 15228, "end": 21024, "text": "For whatever things were written before were written for our learning, that we through patience and comfort of the scriptures might have hope.", "words": [[0, 15228], [4, 15228], [13, 15530], [20, 15930], [25, 16130], [33, 16330], [40, 16690], [45, 16970], [53, 17230], [57, 17450], [61, 17570], [71, 17890], [76, 18430], [79, 18630], [87, 18850], [96, 19290], [100, 19470], [108, 19770], [111, 19930], [115, 20010], [126, 20270], [132, 20570], [137, 20750]]}, {"verse": 5, "start": 21474, "end": 27422, "text": "Now the God of patience and consolation grant you to be likeminded one toward another according to Christ Jesus:", "words": [[0, 21474], [4, 21993], [8, 22093], [12, 22313], [15, 22433], [24, 22773], [28, 23013], [40, 23443], [46, 23873], [50, 24093], [53, 24213], [56, 24523], [67, 24833], [71, 25093], [78, 25353], [86, 25733], [96, 26273], [99, 26493], [106, 26713]]}, {"verse": 6, "start": 27872, "end": 32890, "text": "That you may with one mind and one mouth glorify God, even the Father of our Lord Jesus Christ.", "words": [[0, 27872], [5, 27996], [9, 28136], [13, 28276], [18, 28476], [22, 28716], [27, 29036], [31, 29176], [35, 29356], [41, 29716], [49, 30236], [54, 30896], [59, 31096], [63, 31296], [70, 31556], [73, 31756], [77, 31896], [82, 32076], [88, 32296]]}, {"verse": 7, "start": 33340, "end": 37373, "text": "Therefore receive one another, as Christ also received us to the glory of God.", "words": [[0, 33340], [10, 33621], [18, 33981], [22, 34201], [31, 34841], [34, 34981], [41, 35261], [46, 35601], [55, 36021], [58, 36241], [61, 36401], [65, 36521], [71, 36761], [74, 36961]]}, {"verse": 8, "start": 37823, "end": 44903, "text": "Now I say that Jesus Christ was a minister of the circumcision for the truth of God, to confirm the promises made to the fathers:", "words": [[0, 37823], [4, 38021], [6, 38201], [10, 38401], [15, 38541], [21, 38841], [28, 39261], [32, 39521], [34, 39701], [43, 40021], [46, 40301], [50, 40441], [63, 41081], [67, 41301], [71, 41441], [77, 41701], [80, 41901], [85, 42201], [88, 42721], [96, 43121], [100, 43341], [109, 43721], [114, 44061], [117, 44221], [121, 44341]]}, {"verse": 9, "start": 45353, "end": 53402, "text": "And that the Gentiles might glorify God for his mercy; as it is written, For this cause I will confess to you among the Gentiles, and sing to your name.", "words": [[0, 45353], [4, 45458], [9, 45578], [13, 45698], [22, 46218], [28, 46438], [36, 47038], [40, 47278], [44, 47518], [48, 47678], [55, 48463], [58, 48605], [61, 48705], [64, 48805], [73, 49445], [77, 49545], [82, 49785], [88, 50005], [90, 50185], [95, 50305], [103, 50665], [106, 50885], [110, 51025], [116, 51225], [120, 51425], [130, 52025], [134, 52425], [139, 52665], [142, 52845], [147, 52985]]}, {"verse": 10, "start": 53852, "end": 57154, "text": "And again he says, Rejoice, you Gentiles, with his people.", "words": [[0, 53852], [4, 53970], [10, 54270], [13, 54270], [19, 54570], [28, 55250], [32, 55350], [42, 56230], [47, 56410], [51, 56590]]}, {"verse": 11, "start": 57604, "end": 62390, "text": "And again, Praise the Lord, all you Gentiles; and praise him, all you people.", "words": [[0, 57604], [4, 57702], [11, 57982], [18, 58162], [22, 58382], [28, 58622], [32, 59202], [36, 59382], [46, 60498], [50, 60627], [57, 60907], [62, 61207], [66, 61707], [70, 61887]]}, {"verse": 12, "start": 62840, "end": 71168, "text": "And again, Esaias says, There shall be a root of Jesse, and he that shall rise to reign over the Gentiles; in him shall the Gentiles trust.", "words": [[0, 62840], [4, 62976], [11, 63306], [18, 63636], [24, 64336], [30, 64536], [36, 64796], [39, 65016], [41, 65116], [46, 65296], [49, 65436], [56, 66336], [60, 66396], [63, 66616], [68, 66796], [74, 67016], [79, 67296], [82, 67526], [88, 67756], [93, 68056], [97, 68216], [107, 69221], [110, 69369], [114, 69609], [120, 69869], [124, 70049], [133, 70549]]}, {"verse": 13, "start": 71618, "end": 78008, "text": "Now the God of hope fill you with all joy and peace in believing, that you may abound in hope, through the power of the Holy Spirit.", "words": [[0, 71618], [4, 71758], [8, 71918], [12, 72138], [15, 72238], [20, 72438], [25, 72738], [29, 72938], [34, 73098], [38, 73378], [42, 73698], [46, 73918], [52, 74128], [55, 74338], [66, 74698], [71, 75218], [75, 75358], [79, 75518], [86, 75878], [89, 75998], [95, 76218], [103, 76618], [107, 76758], [113, 77038], [116, 77158], [120, 77258], [125, 77458]]}, {"verse": 14, "start": 78458, "end": 86997, "text": "And I myself also am persuaded of you, my brethren, that you also are full of goodness, filled with all knowledge, able also to admonish one another.", "words": [[0, 78458], [4, 78583], [6, 78723], [13, 79143], [18, 79583], [21, 79783], [31, 80163], [34, 80503], [39, 81003], [42, 81143], [52, 81923], [57, 82063], [61, 82203], [66, 82483], [70, 82663], [75, 82883], [78, 83003], [88, 83623], [95, 83823], [100, 84023], [104, 84263], [115, 85003], [120, 85243], [125, 85663], [128, 85843], [137, 86383], [141, 86563]]}, {"verse": 15, "start": 87447, "end": 95217, "text": "Nevertheless, brethren, I have written the more boldly to you in some sort, as putting you in mind, because of the grace that is given to me of God,", "words": [[0, 87447], [14, 88114], [24, 88994], [26, 89134], [31, 89274], [39, 89464], [43, 89654], [48, 89854], [55, 90334], [58, 90474], [62, 90654], [65, 90794], [70, 91074], [76, 91714], [79, 91854], [87, 92134], [91, 92334], [94, 92434], [100, 92994], [108, 93214], [111, 93414], [115, 93514], [121, 93814], [126, 93994], [129, 94114], [135, 94334], [138, 94534], [141, 94654], [144, 94794]]}, {"verse": 16, "start": 95667, "end": 105899, "text": "That I should be the minister of Jesus Christ to the Gentiles, ministering the gospel of God, that the offering up of the Gentiles might be acceptable, being sanctified by the Holy Spirit.", "words": [[0, 95667], [5, 95782], [7, 95942], [14, 96162], [17, 96382], [21, 96522], [30, 96882], [33, 97182], [39, 97502], [46, 97902], [49, 98162], [53, 98262], [63, 99082], [75, 99602], [79, 99702], [86, 100042], [89, 100262], [94, 100882], [99, 101042], [103, 101162], [112, 101462], [115, 101742], [118, 101882], [122, 101982], [131, 102522], [137, 102762], [140, 102982], [152, 103966], [158, 104123], [169, 104783], [172, 104963], [176, 105083], [181, 105303]]}, {"verse": 17, "start": 106349, "end": 111647, "text": "Therefore I have reason to glory through Jesus Christ in those things which pertain to God.", "words": [[0, 106349], [10, 106730], [12, 107030], [17, 107230], [24, 107570], [27, 107810], [33, 108210], [41, 108470], [47, 108830], [54, 109250], [57, 109830], [63, 110030], [70, 110370], [76, 110590], [84, 111090], [87, 111250]]}, {"verse": 18, "start": 112097, "end": 119021, "text": "For I will not dare to speak of any of those things which Christ has not wrought by me, to make the Gentiles obedient, by word and deed,", "words": [[0, 112097], [4, 112205], [6, 112445], [11, 112625], [15, 112825], [20, 113085], [23, 113265], [29, 113465], [32, 113685], [36, 113865], [39, 113965], [45, 114145], [52, 114405], [58, 114625], [65, 114905], [69, 115145], [73, 115365], [81, 115645], [84, 115785], [88, 116025], [91, 116445], [96, 116585], [100, 116725], [109, 117245], [119, 117665], [122, 118125], [127, 118425], [131, 118665]]}, {"verse": 19, "start": 119471, "end": 128712, "text": "Through mighty signs and wonders, by the power of the Spirit of God; so that from Jerusalem, and round about to Illyricum, I have fully preached the gospel of Christ.", "words": [[0, 119471], [8, 119601], [15, 119881], [21, 120301], [25, 120501], [34, 120881], [37, 121401], [41, 121541], [47, 121861], [50, 122121], [54, 122241], [61, 122541], [64, 122741], [69, 123435], [72, 123586], [77, 123766], [82, 123946], [93, 124506], [97, 124853], [103, 125199], [109, 125546], [112, 125746], [123, 126406], [125, 126746], [130, 126906], [136, 127166], [145, 127546], [149, 127726], [156, 127986], [159, 128206]]}, {"verse": 20, "start": 129162, "end": 135582, "text": "Yes, so have I strived to preach the gospel, not where Christ was named, lest I should build upon another man’s foundation:", "words": [[0, 129162], [5, 129478], [8, 129618], [13, 129818], [15, 129958], [23, 130438], [26, 130558], [33, 130798], [37, 130998], [45, 131618], [49, 131758], [55, 131958], [62, 132258], [66, 132458], [73, 133118], [78, 133358], [80, 133518], [87, 133678], [93, 133918], [98, 134198], [106, 134578], [112, 134958]]}, {"verse": 21, "start": 136032, "end": 142281, "text": "But as it is written, To whom he was not spoken of, they shall see: and they that have not heard shall understand.", "words": [[0, 136032], [4, 136158], [7, 136378], [10, 136478], [13, 136618], [22, 137198], [25, 137398], [30, 137558], [33, 137678], [37, 137838], [41, 138018], [48, 138378], [52, 138918], [57, 139098], [63, 139358], [68, 140086], [72, 140242], [77, 140402], [82, 140582], [87, 140762], [91, 140922], [97, 141202], [103, 141462]]}, {"verse": 22, "start": 142731, "end": 145980, "text": "For which cause also I have been much hindered from coming to you.", "words": [[0, 142731], [4, 142838], [10, 142998], [16, 143258], [21, 143678], [23, 143898], [28, 144078], [33, 144258], [38, 144598], [47, 145038], [52, 145178], [59, 145438], [62, 145678]]}, {"verse": 23, "start": 146430, "end": 151192, "text": "But now having no more place in these parts, and having a great desire these many years to come to you;", "words": [[0, 146430], [4, 146528], [8, 146768], [15, 147028], [18, 147288], [23, 147468], [29, 147708], [32, 147908], [38, 148088], [45, 148388], [49, 148728], [56, 148948], [58, 149108], [64, 149308], [71, 149668], [77, 149928], [82, 150188], [88, 150468], [91, 150668], [96, 150848], [99, 150988]]}, {"verse": 24, "start": 151642, "end": 162293, "text": "Whenever I take my journey into Spain, I will come to you: for I trust to see you in my journey, and to be brought on my way in that direction by you, if first I be somewhat filled with your company.", "words": [[0, 151642], [9, 151860], [11, 152060], [16, 152220], [19, 152380], [27, 152680], [32, 152900], [39, 153660], [41, 153780], [46, 153920], [51, 154220], [54, 154420], [59, 154932], [63, 155198], [65, 155578], [71, 155878], [74, 156118], [78, 156358], [82, 156538], [85, 156658], [88, 156798], [97, 157138], [101, 157638], [104, 157778], [107, 157878], [115, 158118], [118, 158298], [121, 158438], [125, 158618], [128, 158738], [133, 158858], [143, 159218], [146, 159438], [151, 159758], [154, 160218], [160, 160478], [162, 160638], [165, 160778], [174, 161078], [181, 161398], [186, 161618], [191, 161738]]}, {"verse": 25, "start": 162743, "end": 165667, "text": "But now I go to Jerusalem to minister to the saints.", "words": [[0, 162743], [4, 162901], [8, 163121], [10, 163301], [13, 163461], [16, 163621], [26, 164081], [29, 164401], [38, 164721], [41, 165021], [45, 165141]]}, {"verse": 26, "start": 166117, "end": 172302, "text": "For it has pleased them of Macedonia and Achaia to make a certain contribution for the poor saints which are at Jerusalem.", "words": [[0, 166117], [4, 166250], [7, 166410], [11, 166590], [19, 166850], [24, 167130], [27, 167290], [37, 167970], [41, 168090], [48, 168590], [51, 168810], [56, 168970], [58, 169130], [66, 169370], [79, 169870], [83, 170330], [87, 170470], [92, 170710], [99, 170990], [105, 171290], [109, 171510], [112, 171610]]}, {"verse": 27, "start": 172752, "end": 182465, "text": "It has pleased them indeed; and their debtors they are. For if the Gentiles have been made partakers of their spiritual things, their duty is also to minister to them in carnal things.", "words": [[0, 172752], [3, 172899], [7, 173079], [15, 173399], [20, 173699], [28, 174649], [32, 174772], [38, 174912], [46, 175332], [51, 175492], [56, 176090], [60, 176258], [63, 176418], [67, 176538], [76, 177158], [81, 177378], [86, 177498], [91, 177678], [101, 178138], [104, 178358], [110, 178498], [120, 178858], [128, 179598], [134, 179731], [139, 179865], [142, 179998], [147, 180398], [150, 180598], [159, 180898], [162, 181198], [167, 181465], [170, 181731], [177, 181998]]}, {"verse": 28, "start": 182915, "end": 188316, "text": "When therefore I have performed this, and have sealed to them this fruit, I will come by you into Spain.", "words": [[0, 182915], [5, 183073], [15, 183513], [17, 183853], [22, 184013], [32, 184393], [38, 184773], [42, 185193], [47, 185333], [54, 185633], [57, 185813], [62, 185953], [67, 186113], [74, 186733], [76, 186873], [81, 187013], [86, 187233], [89, 187453], [93, 187593], [98, 187753]]}, {"verse": 29, "start": 188766, "end": 194424, "text": "And I am sure that, when I come to you, I shall come in the fulness of the blessing of the gospel of Christ.", "words": [[0, 188766], [4, 188928], [6, 189088], [9, 189228], [14, 189488], [20, 189788], [25, 190048], [27, 190188], [32, 190388], [35, 190568], [40, 191048], [42, 191248], [48, 191468], [53, 191728], [56, 191848], [60, 192068], [68, 192288], [71, 192568], [75, 192668], [84, 193048], [87, 193248], [91, 193368], [98, 193688], [101, 193888]]}, {"verse": 30, "start": 194874, "end": 202462, "text": "Now I beg you, brethren, for the Lord Jesus Christ’s sake, and for the love of the Spirit, that you strive together with me in your prayers to God for me;", "words": [[0, 194874], [4, 195107], [6, 195307], [10, 195567], [15, 195767], [25, 196527], [29, 196587], [33, 196707], [38, 196907], [44, 197207], [53, 197767], [59, 197927], [63, 198267], [67, 198407], [71, 198507], [76, 198727], [79, 198847], [83, 198987], [91, 199789], [96, 199889], [100, 200009], [107, 200269], [116, 200629], [121, 200889], [124, 201049], [127, 201169], [132, 201289], [140, 201629], [143, 201849], [147, 202069], [151, 202249]]}, {"verse": 31, "start": 202912, "end": 209563, "text": "That I may be delivered from them that do not believe in Judaea; and that my service which I have for Jerusalem may be accepted of the saints;", "words": [[0, 202912], [5, 203015], [7, 203175], [11, 203375], [14, 203495], [24, 203815], [29, 204075], [34, 204275], [39, 204455], [42, 204595], [46, 204735], [54, 205075], [57, 205465], [65, 206099], [69, 206205], [74, 206325], [77, 206505], [85, 206845], [91, 207065], [93, 207205], [98, 207365], [102, 207525], [112, 207945], [116, 208225], [119, 208305], [128, 208745], [131, 208925], [135, 209065]]}, {"verse": 32, "start": 210013, "end": 214574, "text": "That I may come to you with joy by the will of God, and may with you be refreshed.", "words": [[0, 210013], [5, 210183], [7, 210303], [11, 210503], [16, 210783], [19, 210983], [23, 211103], [28, 211263], [32, 211583], [35, 212083], [39, 212203], [44, 212363], [47, 212483], [52, 212763], [56, 213243], [60, 213463], [65, 213643], [69, 213783], [72, 213903]]}, {"verse": 33, "start": 215024, "end": 218159, "text": "Now the God of peace be with you all. Amen.", "words": [[0, 215024], [4, 215683], [8, 215743], [12, 215963], [15, 216083], [21, 216343], [24, 216603], [29, 216803], [33, 216923], [38, 217617]]}]}