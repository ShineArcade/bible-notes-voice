{"book": "MAT", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 206983, "verses": [{"verse": 1, "start": 300, "end": 5690, "text": "Libro de la genealogía de Jesucristo, hijo de David, hijo de Abraham.", "words": [[0, 300], [6, 801], [9, 901], [12, 1041], [23, 1821], [26, 1941], [38, 3261], [43, 3561], [46, 3721], [53, 4481], [58, 4761], [61, 4921]]}, {"verse": 2, "start": 6040, "end": 13862, "text": "Abraham engendró a Isaac: e Isaac engendró a Jacob: y Jacob engendró a Judas y a sus hermanos:", "words": [[0, 6040], [8, 6460], [17, 7280], [19, 7400], [26, 8535], [28, 8841], [34, 9148], [43, 9728], [45, 10182], [52, 10781], [54, 10981], [60, 11281], [69, 12121], [71, 12261], [77, 12481], [79, 12841], [81, 12961], [85, 13081]]}, {"verse": 3, "start": 14212, "end": 22734, "text": "Y Judas engendró de Tamar a Fares y a Zara: y Fares engendró a Esrom: y Esrom engendró a Aram:", "words": [[0, 14212], [2, 14357], [8, 14677], [17, 15577], [20, 15697], [26, 15990], [28, 16284], [34, 16577], [36, 16858], [38, 17138], [44, 17584], [46, 17879], [52, 18395], [61, 18911], [63, 19427], [70, 20112], [72, 20511], [78, 20911], [87, 21771], [89, 21971]]}, {"verse": 4, "start": 23084, "end": 31106, "text": "Y Aram engendró a Aminadab: y Aminadab engendró a Naassón: y Naassón engendró a Salmón:", "words": [[0, 23281], [2, 23501], [7, 23721], [16, 24701], [18, 25311], [28, 26141], [30, 26234], [39, 26328], [48, 26421], [50, 27501], [59, 28801], [61, 29145], [69, 29525], [78, 30205], [80, 30425]]}, {"verse": 5, "start": 31456, "end": 39493, "text": "Y Salmón engendró de Rahab a Booz, y Booz engendró de Ruth a Obed: y Obed engendró a Isaí:", "words": [[0, 31456], [2, 31579], [9, 32099], [18, 32759], [21, 32919], [27, 33539], [29, 34089], [35, 34639], [37, 34829], [42, 35019], [51, 35839], [54, 35979], [59, 36279], [61, 36599], [67, 37615], [69, 37965], [74, 38315], [83, 38665], [85, 38925]]}, {"verse": 6, "start": 39843, "end": 46954, "text": "Y Isaí engendró al rey David: y el rey David engendró a Salomón de la que fue mujer de Urías:", "words": [[0, 39843], [2, 40049], [7, 40569], [16, 41469], [19, 41749], [23, 42129], [30, 42866], [32, 43028], [35, 43168], [39, 43468], [45, 43728], [54, 44528], [56, 44708], [64, 45148], [67, 45408], [70, 45508], [74, 45628], [78, 45808], [84, 46168], [87, 46368]]}, {"verse": 7, "start": 47304, "end": 54991, "text": "Y Salomón engendró a Roboam: y Roboam engendró a Abía: y Abía engendró a Asa:", "words": [[0, 47304], [2, 47446], [10, 47933], [19, 48419], [21, 48906], [29, 49950], [31, 50170], [38, 50900], [47, 51630], [49, 52088], [55, 52721], [57, 53115], [62, 53529], [71, 53942], [73, 54342]]}, {"verse": 8, "start": 55341, "end": 62872, "text": "Y Asa engendró a Josafat: y Josafat engendró a Joram: y Joram engendró a Uzías:", "words": [[0, 55616], [2, 55931], [6, 56246], [15, 56561], [17, 57078], [26, 57736], [28, 58147], [36, 58587], [45, 59287], [47, 59756], [54, 60377], [56, 60518], [62, 60918], [71, 61658], [73, 62291]]}, {"verse": 9, "start": 63222, "end": 71303, "text": "Y Uzías engendró a Jotam: y Jotam engendró a Acaz: y Acaz engendró a Ezequías:", "words": [[0, 63222], [2, 63735], [8, 64281], [17, 64828], [19, 65068], [26, 65983], [28, 66278], [34, 66908], [43, 67538], [45, 68054], [51, 69140], [53, 69589], [58, 70037], [67, 70485], [69, 70934]]}, {"verse": 10, "start": 71653, "end": 78944, "text": "Y Ezequías engendró a Manasés: y Manasés engendró a Amón: y Amón engendró a Josías:", "words": [[0, 71653], [2, 72137], [11, 72657], [20, 73237], [22, 73357], [31, 74327], [33, 74688], [41, 75088], [50, 75398], [52, 75708], [58, 76679], [60, 76905], [65, 77132], [74, 78032], [76, 78192]]}, {"verse": 11, "start": 79294, "end": 85843, "text": "Y Josías engendró a Jeconías y a sus hermanos, en la deportación de Babilonia.", "words": [[0, 79294], [2, 79583], [9, 80163], [18, 80883], [20, 81123], [29, 81843], [31, 82163], [33, 82263], [37, 82403], [47, 83363], [50, 83583], [53, 83723], [65, 84803], [68, 85003]]}, {"verse": 12, "start": 86193, "end": 93738, "text": "Y después de la deportación de Babilonia, Jeconías engendró a Salatiel: y Salatiel engendró a Zorobabel:", "words": [[0, 86193], [2, 86311], [10, 86571], [13, 86811], [16, 86911], [28, 87611], [31, 87771], [42, 88681], [51, 89591], [60, 90191], [62, 90351], [72, 91326], [74, 91433], [83, 92033], [92, 92793], [94, 93295]]}, {"verse": 13, "start": 94088, "end": 101589, "text": "Y Zorobabel engendró a Abiud: y Abiud engendró a Eliaquim: y Eliaquim engendró a Azor:", "words": [[0, 94088], [2, 94516], [12, 94976], [21, 95436], [23, 95781], [30, 96539], [32, 96733], [38, 96926], [47, 97666], [49, 98283], [59, 99081], [61, 99555], [70, 100035], [79, 100875], [81, 101254]]}, {"verse": 14, "start": 101939, "end": 108379, "text": "Y Azor engendró a Sadoc: y Sadoc engendró a Aquim: y Aquim engendró a Eliud:", "words": [[0, 101939], [2, 102087], [7, 102467], [16, 103047], [18, 103467], [25, 104043], [27, 104269], [33, 104529], [42, 105189], [44, 105600], [51, 106386], [53, 106632], [59, 106879], [68, 107579], [70, 107879]]}, {"verse": 15, "start": 108729, "end": 115733, "text": "Y Eliud engendró a Eleazar: y Eleazar engendró a Matán: y Matán engendró a Jacob:", "words": [[0, 108729], [2, 109151], [8, 109611], [17, 110071], [19, 110605], [28, 111139], [30, 111679], [38, 112219], [47, 112759], [49, 112959], [56, 113814], [58, 113916], [64, 114486], [73, 115056], [75, 115156]]}, {"verse": 16, "start": 116083, "end": 123009, "text": "Y Jacob engendró a José, marido de María, de la cual nació Jesús, el cual es llamado el Cristo.", "words": [[0, 116083], [2, 116208], [8, 116548], [17, 117348], [19, 117448], [25, 118228], [32, 118708], [35, 118848], [42, 119768], [45, 119848], [48, 119968], [53, 120168], [59, 120628], [66, 121528], [69, 121628], [74, 121848], [77, 122028], [85, 122355], [88, 122682]]}, {"verse": 17, "start": 123359, "end": 139404, "text": "De manera que todas las generaciones desde Abraham hasta David son catorce generaciones: y desde David hasta la deportación de Babilonia, catorce generaciones: y desde la deportación de Babilonia hasta Cristo, catorce generaciones.", "words": [[0, 123359], [3, 124003], [10, 124223], [14, 124543], [20, 124803], [24, 125103], [37, 125843], [43, 126123], [51, 126543], [57, 127083], [63, 127463], [67, 127983], [75, 128703], [89, 130120], [91, 130262], [97, 130502], [103, 130922], [109, 131362], [112, 131542], [124, 132242], [127, 132402], [138, 132959], [146, 133517], [160, 135136], [162, 135241], [168, 135421], [171, 135601], [183, 136201], [186, 136341], [196, 136841], [202, 137061], [210, 137539], [218, 138016]]}, {"verse": 18, "start": 139754, "end": 150792, "text": "Y el nacimiento de Jesucristo fue así: Que siendo María su madre desposada con José, antes que se juntasen, se halló que había concebido del Espíritu Santo.", "words": [[0, 139754], [2, 139883], [5, 140003], [16, 140743], [19, 140943], [30, 141743], [34, 141963], [39, 142630], [43, 142736], [50, 143076], [56, 143436], [59, 143736], [65, 144136], [75, 145136], [79, 145376], [85, 146436], [91, 146636], [95, 146836], [98, 146976], [108, 147931], [111, 148151], [117, 148471], [121, 148611], [127, 148811], [137, 149491], [141, 149671], [150, 150191]]}, {"verse": 19, "start": 151142, "end": 158599, "text": "Y José su marido, como era justo, y no quisiese avergonzarla públicamente, quiso dejarla secretamente.", "words": [[0, 151142], [2, 151306], [7, 151526], [10, 151786], [18, 152606], [23, 152806], [27, 153006], [34, 154006], [36, 154106], [39, 154206], [48, 154686], [61, 155566], [75, 156686], [81, 156946], [89, 157546]]}, {"verse": 20, "start": 158949, "end": 171747, "text": "Y pensando él en esto, he aquí el ángel del Señor se le apareció en sueños, diciendo: José, hijo de David, no temas de recibir a María tu mujer, porque lo que en ella es engendrado, del Espíritu Santo es.", "words": [[0, 158949], [2, 159055], [11, 159415], [14, 159775], [17, 159915], [23, 160415], [26, 160495], [31, 160815], [34, 161035], [40, 161455], [44, 161635], [50, 161995], [53, 162315], [56, 162475], [65, 163095], [68, 163235], [76, 164075], [86, 165106], [92, 165394], [97, 165614], [100, 165734], [107, 166354], [110, 166474], [116, 166794], [119, 166994], [127, 167374], [129, 167534], [135, 167774], [138, 167974], [145, 168554], [152, 168734], [155, 168914], [159, 169054], [162, 169174], [167, 169314], [170, 169494], [182, 170114], [186, 170414], [195, 170954], [201, 171214]]}, {"verse": 21, "start": 172097, "end": 177676, "text": "Y dará a luz un hijo, y llamarás su nombre JESÚS, porque él salvará a su pueblo de sus pecados.", "words": [[0, 172097], [2, 172215], [7, 172535], [9, 172635], [13, 172915], [16, 173015], [22, 173255], [24, 173547], [33, 173840], [36, 174040], [43, 174320], [50, 175140], [57, 175480], [60, 175660], [68, 176180], [70, 176260], [73, 176360], [80, 176680], [83, 176840], [87, 177000]]}, {"verse": 22, "start": 177956, "end": 184174, "text": "Todo esto aconteció para que se cumpliese lo que fue dicho por el Señor, por el profeta que dijo:", "words": [[0, 177956], [5, 178119], [10, 178479], [20, 179219], [25, 179439], [29, 179599], [32, 179759], [42, 180339], [45, 180519], [49, 180639], [53, 180819], [59, 181119], [63, 181399], [66, 181519], [73, 182559], [77, 182739], [80, 182879], [88, 183539], [92, 183679]]}, {"verse": 23, "start": 184524, "end": 193993, "text": "He aquí la virgen concebirá y parirá un hijo, y llamarás su nombre Emanuel, que traducido significa: Dios con nosotros.", "words": [[0, 184524], [3, 184669], [8, 184949], [11, 185089], [18, 185469], [28, 186229], [30, 186309], [37, 186749], [40, 186869], [46, 187789], [48, 187869], [57, 188349], [60, 188549], [67, 188909], [76, 190149], [80, 190429], [90, 191109], [101, 192169], [106, 192549], [110, 193049]]}, {"verse": 24, "start": 194343, "end": 201297, "text": "Y despertando José del sueño, hizo como el ángel del Señor le había mandado, y recibió a su mujer.", "words": [[0, 194343], [2, 194439], [14, 195119], [19, 195479], [23, 195739], [30, 196799], [35, 197179], [40, 197479], [43, 197639], [49, 198019], [53, 198139], [59, 198499], [62, 198779], [68, 198999], [77, 199599], [79, 199839], [87, 200499], [89, 200579], [92, 200719]]}, {"verse": 25, "start": 201297, "end": 206583, "text": "Y no la conoció hasta que parió a su hijo primogénito: y llamó su nombre JESÚS.", "words": [[0, 201297], [2, 201457], [5, 201637], [8, 201777], [16, 202377], [22, 202697], [26, 202877], [32, 203257], [34, 203417], [37, 203557], [42, 203797], [55, 205007], [57, 205113], [63, 205433], [66, 205553], [73, 205873]]}]}