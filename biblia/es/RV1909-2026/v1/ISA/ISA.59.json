{"book": "ISA", "chapter": 59, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 239196, "verses": [{"verse": 1, "start": 300, "end": 6256, "text": "He aquí que no se ha acortado la mano de Jehová para salvar, ni se ha agravado su oído para oír:", "words": [[0, 300], [3, 446], [8, 706], [12, 886], [15, 1046], [18, 1206], [21, 1506], [30, 1806], [33, 1946], [38, 2186], [41, 2366], [48, 2786], [53, 2926], [61, 3426], [64, 3926], [67, 4126], [70, 4286], [79, 4906], [82, 5126], [87, 5486], [92, 5726]]}, {"verse": 2, "start": 6706, "end": 17797, "text": "Pero vuestras iniquidades han hecho división entre vosotros y vuestro Dios, y vuestros pecados han hecho ocultar su rostro de vosotros, para no oír.", "words": [[0, 6706], [5, 6870], [14, 7590], [26, 8310], [30, 8670], [36, 9030], [45, 9710], [51, 9970], [60, 10550], [62, 10770], [70, 11130], [76, 11470], [78, 12030], [87, 12410], [95, 13110], [99, 13650], [105, 14070], [113, 14890], [116, 15110], [123, 15650], [126, 15810], [136, 16410], [141, 16910], [144, 17210]]}, {"verse": 3, "start": 18247, "end": 28984, "text": "Porque vuestras manos están contaminadas de sangre, y vuestros dedos de iniquidad; vuestros labios pronuncian mentira, habla maldad vuestra lengua.", "words": [[0, 18247], [7, 18492], [16, 18972], [22, 19292], [28, 19672], [41, 20732], [44, 20932], [52, 21432], [54, 22092], [63, 22532], [69, 23052], [72, 23212], [83, 24468], [92, 24874], [99, 25274], [110, 25994], [119, 26994], [125, 27354], [132, 27914], [140, 28314]]}, {"verse": 4, "start": 29434, "end": 40106, "text": "No hay quien clame por la justicia, ni quien juzgue por la verdad: confían en vanidad, y hablan vanidades; conciben maldades, y paren iniquidad.", "words": [[0, 29434], [3, 29797], [7, 29937], [13, 30177], [19, 30657], [23, 30857], [26, 30997], [36, 31857], [39, 32197], [45, 32497], [52, 32797], [56, 32997], [59, 33117], [67, 33972], [75, 34514], [78, 34814], [87, 35374], [89, 35614], [96, 35974], [107, 37238], [116, 37762], [126, 38442], [128, 38682], [134, 39122]]}, {"verse": 5, "start": 40556, "end": 49674, "text": "Ponen huevos de áspides, y tejen telas de arañas: el que come de sus huevos, morirá; y si lo aprietan, saldrá un basilisco.", "words": [[0, 40556], [6, 40902], [13, 41382], [16, 41732], [25, 42082], [27, 42522], [33, 42942], [39, 43402], [42, 43522], [50, 44556], [53, 44683], [57, 44823], [62, 45083], [65, 45263], [69, 45443], [77, 45923], [85, 47030], [87, 47270], [90, 47370], [93, 47530], [103, 48310], [110, 48710], [113, 48790]]}, {"verse": 6, "start": 50124, "end": 60988, "text": "Sus telas no servirán para vestir, ni de sus obras serán cubiertos: sus obras son obras de iniquidad, y obra de rapiña está en sus manos.", "words": [[0, 50124], [4, 50262], [10, 50702], [13, 50842], [22, 51422], [27, 51662], [35, 52642], [38, 52922], [41, 53082], [45, 53242], [51, 53602], [57, 54002], [68, 55285], [72, 55430], [78, 55830], [82, 56450], [88, 56910], [91, 57150], [102, 57950], [104, 58420], [109, 58890], [112, 59090], [119, 59540], [124, 59990], [127, 60190], [131, 60270]]}, {"verse": 7, "start": 61438, "end": 74128, "text": "Sus pies corren al mal, y se apresuran para derramar la sangre inocente; sus pensamientos, pensamientos de iniquidad, destrucción y quebrantamiento en sus caminos.", "words": [[0, 61438], [4, 61563], [9, 61943], [16, 62863], [19, 63103], [24, 63463], [26, 64023], [29, 64143], [39, 64743], [44, 65043], [53, 65703], [56, 65803], [63, 66223], [73, 67732], [77, 67890], [91, 68790], [104, 69470], [107, 69650], [118, 70690], [130, 71750], [132, 72010], [148, 73090], [151, 73290], [155, 73450]]}, {"verse": 8, "start": 74578, "end": 85170, "text": "No conocieron camino de paz, ni hay derecho en sus caminos: sus veredas son torcidas; cualquiera que vaya por ellas, no conocerá paz.", "words": [[0, 74578], [3, 74788], [14, 75468], [21, 75748], [24, 76068], [29, 76968], [32, 77428], [36, 77648], [44, 78028], [47, 78268], [51, 78408], [60, 79527], [64, 79691], [72, 80231], [76, 80511], [86, 81860], [97, 82363], [101, 82563], [106, 82763], [110, 83063], [117, 83303], [120, 83923], [129, 84623]]}, {"verse": 9, "start": 85620, "end": 96421, "text": "Por esto se alejó de nosotros el juicio, y no nos alcanzó justicia: esperamos luz, y he aquí tinieblas; resplandores, y andamos en oscuridad.", "words": [[0, 85620], [4, 85764], [9, 85984], [12, 86204], [18, 86664], [21, 86744], [30, 87024], [33, 87404], [41, 87884], [43, 88444], [46, 88664], [50, 89064], [58, 89624], [68, 90713], [78, 91354], [83, 92394], [85, 92474], [88, 92614], [93, 92854], [104, 94055], [118, 94840], [120, 95080], [128, 95500], [131, 95660]]}, {"verse": 10, "start": 96871, "end": 107384, "text": "Palpamos la pared como ciegos, y andamos a tiento como sin ojos; tropezamos al medio día como de noche; estamos en oscuros lugares como muertos.", "words": [[0, 96871], [9, 97334], [12, 97514], [18, 97834], [23, 98054], [31, 98834], [33, 99274], [41, 99561], [43, 99847], [50, 100134], [55, 100515], [59, 100896], [65, 101578], [76, 102202], [79, 102535], [85, 102869], [89, 103202], [94, 103462], [97, 103622], [104, 104544], [112, 105004], [115, 105264], [123, 105684], [131, 106184], [136, 106504]]}, {"verse": 11, "start": 107834, "end": 119323, "text": "Aullamos como osos todos nosotros, y gemimos lastimeramente como palomas: esperamos juicio, y no lo hay; salvación, y alejóse de nosotros.", "words": [[0, 107834], [9, 108394], [14, 108714], [19, 109274], [25, 109574], [35, 110274], [37, 110794], [45, 111374], [60, 112294], [65, 112554], [74, 113658], [84, 114299], [92, 114959], [94, 115459], [97, 115639], [100, 115819], [105, 116515], [116, 117298], [118, 117738], [126, 118318], [129, 118518]]}, {"verse": 12, "start": 119773, "end": 132497, "text": "Porque nuestras rebeliones se han multiplicado delante de ti, y nuestros pecados han atestiguado contra nosotros: porque con nosotros están nuestras iniquidades, y conocemos nuestros pecados:", "words": [[0, 119773], [7, 120010], [16, 120390], [27, 121450], [30, 121650], [34, 121730], [47, 122570], [55, 123010], [58, 123170], [62, 123390], [64, 123610], [73, 123870], [81, 124450], [85, 124610], [97, 125290], [104, 125610], [114, 126785], [121, 127007], [125, 127267], [134, 127767], [140, 128227], [149, 128647], [162, 129927], [164, 130667], [174, 131227], [183, 131507]]}, {"verse": 13, "start": 132947, "end": 145017, "text": "El prevaricar y mentir contra Jehová, y volverse de en pos de nuestro Dios; el hablar calumnia y rebelión, concebir y proferir de corazón palabras de mentira.", "words": [[0, 132947], [3, 133092], [14, 133892], [16, 134052], [23, 134552], [30, 134912], [38, 135712], [40, 136092], [49, 136652], [52, 136892], [55, 137202], [59, 137512], [62, 137992], [70, 138172], [76, 139245], [79, 139368], [86, 139628], [95, 140228], [97, 140328], [107, 141088], [116, 141808], [118, 141908], [127, 142488], [130, 142628], [138, 143148], [147, 143908], [150, 144228]]}, {"verse": 14, "start": 145467, "end": 154907, "text": "Y el derecho se retiró, y la justicia se puso lejos: porque la verdad tropezó en la plaza, y la equidad no pudo venir.", "words": [[0, 145467], [2, 145631], [5, 145751], [13, 146031], [16, 146451], [24, 147151], [26, 147731], [29, 147831], [38, 148411], [41, 148551], [46, 148891], [53, 149844], [60, 150331], [63, 150551], [70, 150831], [78, 151591], [81, 151711], [84, 151851], [91, 152371], [93, 152811], [96, 152971], [104, 153631], [107, 153931], [112, 154311]]}, {"verse": 15, "start": 155357, "end": 166265, "text": "Y la verdad fue detenida; y el que se apartó del mal, fue puesto en presa: y lo vio Jehová, y desagradó en sus ojos, porque pereció el derecho.", "words": [[0, 155357], [2, 155512], [5, 155612], [12, 155812], [16, 156232], [26, 157460], [28, 157607], [31, 157727], [35, 157867], [38, 158047], [45, 158547], [49, 158687], [54, 159047], [58, 159447], [65, 159827], [68, 160067], [75, 160969], [77, 161242], [80, 161382], [84, 161622], [92, 162262], [94, 162542], [104, 163242], [107, 163342], [111, 163502], [117, 163902], [124, 164502], [132, 165302], [135, 165602]]}, {"verse": 16, "start": 166715, "end": 176135, "text": "Y vio que no había hombre, y se maravilló que no hubiera quien se interpusiese; y lo salvó su brazo, y le afirmó su misma justicia.", "words": [[0, 166715], [2, 166838], [6, 167118], [10, 167258], [13, 167438], [19, 167658], [27, 168578], [29, 168818], [32, 168938], [42, 169578], [46, 169678], [49, 169898], [57, 170278], [63, 170498], [66, 170758], [80, 172178], [82, 172275], [85, 172405], [91, 172905], [94, 173025], [101, 173645], [103, 174245], [106, 174325], [113, 174785], [116, 174945], [122, 175205]]}, {"verse": 17, "start": 176585, "end": 187296, "text": "Pues de justicia se vistió como de loriga, con yelmo de salvación en su cabeza: y se vistió de vestido de venganza por vestidura, y se cubrió de celo como de manto,", "words": [[0, 176640], [5, 176730], [8, 176830], [17, 177350], [20, 177570], [27, 178050], [32, 178270], [35, 178630], [43, 178990], [47, 179210], [53, 179710], [56, 179850], [66, 180470], [69, 180650], [72, 180790], [80, 181797], [82, 182063], [85, 182163], [92, 182543], [95, 182643], [103, 183083], [106, 183443], [115, 183803], [119, 184063], [130, 184723], [132, 185083], [135, 185203], [142, 185723], [145, 185883], [150, 186343], [155, 186523], [158, 186683]]}, {"verse": 18, "start": 187746, "end": 197613, "text": "Como para retribuir, como para retornar ira a sus enemigos, y dar el pago a sus adversarios: el pago dará a las islas.", "words": [[0, 187746], [5, 187932], [10, 188212], [21, 189232], [26, 189252], [31, 189592], [40, 190242], [44, 190892], [46, 191032], [50, 191272], [60, 192072], [62, 192652], [66, 192832], [69, 193012], [74, 193472], [76, 193572], [80, 193732], [93, 195098], [96, 195244], [101, 195884], [106, 196624], [108, 196724], [112, 196864]]}, {"verse": 19, "start": 198063, "end": 211238, "text": "Y temerán desde el occidente el nombre de Jehová, y desde el nacimiento del sol su gloria: porque vendrá el enemigo como río, mas el espíritu de Jehová levantará bandera contra él.", "words": [[0, 198063], [2, 198190], [10, 198750], [16, 199070], [19, 199490], [29, 200230], [32, 200530], [39, 200910], [42, 201090], [50, 201910], [52, 202090], [58, 202310], [61, 202550], [72, 203290], [76, 203550], [80, 203910], [83, 204210], [91, 205225], [98, 205411], [105, 205891], [108, 206031], [116, 206551], [121, 206791], [126, 207631], [130, 207831], [133, 207991], [142, 208671], [145, 208751], [152, 209231], [162, 209751], [170, 210311], [177, 210671]]}, {"verse": 20, "start": 211538, "end": 218428, "text": "Y vendrá el Redentor a Sion, y a los que se vuelven de la iniquidad en Jacob, dice Jehová.", "words": [[0, 211538], [2, 211674], [9, 212154], [12, 212664], [21, 213174], [23, 213684], [29, 214194], [31, 214274], [33, 214334], [37, 214474], [41, 214614], [44, 214754], [52, 215194], [55, 215314], [58, 215434], [68, 216054], [71, 216234], [78, 217409], [83, 217735]]}, {"verse": 21, "start": 218728, "end": 238555, "text": "Y este será mi pacto con ellos, dijo Jehová: El espíritu mío que está sobre ti, y mis palabras que puse en tu boca, no faltarán de tu boca, ni de la boca de tu simiente, ni de la boca de la simiente de tu simiente, dijo Jehová, desde ahora y para siempre.", "words": [[0, 218728], [2, 218875], [7, 219135], [12, 219415], [15, 219575], [21, 219975], [25, 220115], [32, 221230], [37, 221740], [45, 222471], [48, 222631], [57, 223271], [61, 223651], [65, 223791], [70, 224051], [76, 224411], [80, 224691], [82, 225351], [86, 225491], [95, 225891], [99, 226331], [104, 226691], [107, 226811], [110, 226931], [116, 227291], [119, 227851], [128, 228491], [131, 228631], [134, 228751], [140, 229131], [143, 229591], [146, 229711], [149, 229811], [154, 230091], [157, 230271], [160, 230411], [170, 231700], [173, 231882], [176, 232022], [179, 232122], [184, 232462], [187, 232682], [190, 233032], [199, 233382], [202, 233522], [205, 233967], [215, 234989], [220, 235733], [228, 236763], [234, 236965], [240, 237385], [242, 237665], [247, 237865]]}]}