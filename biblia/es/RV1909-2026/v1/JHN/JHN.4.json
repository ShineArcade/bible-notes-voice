{"book": "JHN", "chapter": 4, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 420029, "verses": [{"verse": 1, "start": 300, "end": 8098, "text": "De manera que como Jesús entendió que los fariseos habían oído que Jesús hacía y bautizaba más discípulos que Juan,", "words": [[0, 300], [3, 407], [10, 627], [14, 1027], [19, 1167], [25, 1487], [34, 2247], [38, 2367], [42, 2527], [51, 3187], [58, 3447], [63, 3907], [67, 4087], [73, 4427], [79, 5067], [81, 5247], [91, 5947], [95, 6207], [106, 7347], [110, 7487]]}, {"verse": 2, "start": 8548, "end": 12562, "text": "(Aunque Jesús no bautizaba, sino sus discípulos),", "words": [[0, 8548], [8, 8805], [14, 9205], [17, 9625], [28, 10725], [33, 11005], [37, 11625]]}, {"verse": 3, "start": 13012, "end": 16089, "text": "Salió de Judea y se fue otra vez a Galilea.", "words": [[0, 13012], [6, 13418], [9, 13538], [15, 14058], [17, 14158], [20, 14258], [24, 14498], [29, 14738], [33, 15098], [35, 15358]]}, {"verse": 4, "start": 16539, "end": 19308, "text": "Y era necesario que pasase por Samaria.", "words": [[0, 16539], [2, 16705], [6, 16865], [16, 17545], [20, 17745], [27, 18265], [31, 18505]]}, {"verse": 5, "start": 19758, "end": 27768, "text": "Vino, pues, a una ciudad de Samaria que se llamaba Sicar, junto a la parcela que Jacob dio a José su hijo.", "words": [[0, 19758], [6, 20024], [12, 20884], [14, 21124], [18, 21284], [25, 21584], [28, 21864], [36, 22364], [40, 22624], [43, 22784], [51, 23474], [58, 24164], [64, 24544], [66, 24764], [69, 24844], [77, 25404], [81, 25584], [87, 25964], [91, 26424], [93, 26564], [98, 26844], [101, 27144]]}, {"verse": 6, "start": 28218, "end": 36430, "text": "Y estaba allí la fuente de Jacob. Pues Jesús, cansado del camino, así se sentó a la fuente. Era como la hora de sexta.", "words": [[0, 28218], [2, 28323], [9, 28583], [14, 28903], [17, 29063], [24, 29463], [27, 29603], [34, 30517], [39, 30701], [46, 31421], [54, 31751], [58, 32081], [66, 33101], [70, 33281], [73, 33441], [79, 33861], [81, 33941], [84, 34001], [92, 34890], [96, 35075], [101, 35335], [104, 35515], [109, 35695], [112, 35855]]}, {"verse": 7, "start": 36880, "end": 42492, "text": "Vino una mujer de Samaria a sacar agua: y Jesús le dice: Dame de beber.", "words": [[0, 36880], [5, 37143], [9, 37423], [15, 37723], [18, 37923], [26, 38403], [28, 38643], [34, 38863], [40, 39878], [42, 40099], [48, 40419], [51, 40759], [57, 41533], [62, 41800], [65, 42164]]}, {"verse": 8, "start": 42942, "end": 46863, "text": "(Porque sus discípulos habían ido a la ciudad a comprar de comer.)", "words": [[0, 42942], [8, 43129], [12, 43369], [23, 44109], [30, 44389], [34, 44749], [36, 44889], [39, 44949], [46, 45289], [48, 45529], [56, 46009], [59, 46269]]}, {"verse": 9, "start": 47313, "end": 58371, "text": "Y la mujer samaritana le dice: ¿Cómo tú, siendo judío, me pides a mí de beber, que soy mujer samaritana? porque los judíos no se tratan con los samaritanos.", "words": [[0, 47313], [2, 47608], [5, 47708], [11, 48008], [22, 48868], [25, 49028], [31, 49841], [37, 50055], [41, 50295], [48, 50655], [55, 51595], [58, 51735], [64, 52075], [66, 52235], [69, 52395], [72, 52535], [79, 52835], [83, 53315], [87, 53555], [93, 53875], [105, 55207], [112, 55431], [116, 55631], [123, 56131], [126, 56291], [129, 56451], [136, 56951], [140, 57111], [144, 57311]]}, {"verse": 10, "start": 58821, "end": 70876, "text": "Respondió Jesús y le dijo: Si conocieses el don de Dios, y quién es el que te dice: Dame de beber: tú pedirías de él, y él te daría agua viva.", "words": [[0, 58821], [10, 59361], [16, 59781], [18, 60201], [21, 60341], [27, 61148], [30, 61313], [41, 62313], [44, 62473], [48, 62733], [51, 62953], [57, 63253], [59, 63613], [65, 63873], [68, 64213], [71, 64473], [75, 64633], [78, 64773], [84, 65642], [89, 66082], [92, 66460], [99, 67115], [102, 67219], [111, 67859], [114, 68119], [118, 68419], [120, 69239], [123, 69399], [126, 69539], [132, 69979], [137, 70299]]}, {"verse": 11, "start": 71326, "end": 80130, "text": "La mujer le dice: Señor, no tienes con qué sacarla, y el pozo es hondo: ¿de dónde, pues, tienes el agua viva?", "words": [[0, 71326], [3, 71414], [9, 71774], [12, 72274], [18, 73036], [25, 73818], [28, 73918], [35, 74358], [39, 74658], [43, 74818], [52, 75538], [54, 75998], [57, 76158], [62, 76478], [65, 76638], [72, 77552], [76, 77740], [83, 78020], [89, 78780], [96, 79040], [99, 79280], [104, 79480]]}, {"verse": 12, "start": 80580, "end": 88392, "text": "¿Eres tú mayor que nuestro padre Jacob, que nos dio este pozo, del cual él bebió, y sus hijos, y sus ganados?", "words": [[0, 80580], [6, 80800], [9, 81040], [15, 81380], [19, 81660], [27, 81860], [33, 82280], [40, 83200], [44, 83240], [48, 83440], [52, 83640], [57, 83900], [63, 84560], [67, 85160], [72, 85460], [75, 85680], [82, 86440], [84, 86720], [88, 86920], [95, 87260], [97, 87520], [101, 87660]]}, {"verse": 13, "start": 88742, "end": 95180, "text": "Respondió Jesús y le dijo: Cualquiera que bebe de esta agua, volverá a tener sed;", "words": [[0, 88742], [10, 89282], [16, 89702], [18, 90122], [21, 90262], [27, 91069], [38, 91799], [42, 91979], [47, 92319], [50, 92459], [55, 92719], [61, 93139], [69, 94159], [71, 94299], [77, 94579]]}, {"verse": 14, "start": 95630, "end": 106611, "text": "Pero el que beba del agua que yo le daré, no tendrá sed jamás; sino que el agua que yo le daré, será en él una fuente de agua que salte para vida eterna.", "words": [[0, 95630], [5, 95795], [8, 95955], [12, 96095], [17, 96395], [21, 96615], [26, 96875], [30, 97055], [33, 97235], [36, 97375], [42, 97835], [45, 98135], [52, 98535], [56, 98835], [63, 100067], [68, 100427], [72, 100667], [75, 101007], [80, 101287], [84, 101507], [87, 101727], [90, 101867], [96, 102307], [101, 102667], [104, 102987], [107, 103147], [111, 103467], [118, 103947], [121, 104127], [126, 104447], [130, 104667], [136, 105227], [141, 105487], [146, 105767]]}, {"verse": 15, "start": 107061, "end": 115990, "text": "La mujer le dice: Señor, dame esta agua, para que no tenga sed, ni venga acá a sacarla.", "words": [[0, 107061], [3, 107150], [9, 107510], [12, 108010], [18, 108772], [25, 109312], [30, 109572], [35, 109872], [41, 110272], [46, 110852], [50, 110992], [53, 111152], [59, 111392], [64, 111732], [67, 112172], [73, 112492], [77, 112772], [79, 112912]]}, {"verse": 16, "start": 116340, "end": 120783, "text": "Jesús le dice: Ve, llama a tu marido, y ven acá.", "words": [[0, 116340], [6, 116714], [9, 117194], [15, 118380], [19, 118680], [25, 119160], [27, 119380], [30, 119500], [38, 119980], [40, 120120], [44, 120220]]}, {"verse": 17, "start": 121233, "end": 128977, "text": "Respondió la mujer, y dijo: No tengo marido. Le dice Jesús: Bien has dicho, No tengo marido;", "words": [[0, 121233], [10, 122077], [13, 122237], [20, 122557], [22, 122757], [28, 123559], [31, 123725], [37, 124005], [45, 125040], [48, 125188], [53, 125408], [60, 126454], [65, 126861], [69, 126981], [76, 127841], [79, 127961], [85, 128261]]}, {"verse": 18, "start": 129427, "end": 136654, "text": "Porque cinco maridos has tenido: y el que ahora tienes no es tu marido; esto has dicho con verdad.", "words": [[0, 129427], [7, 129630], [13, 129970], [21, 130610], [25, 130910], [33, 131917], [35, 132075], [38, 132235], [42, 132435], [48, 132735], [55, 133195], [58, 133575], [61, 133795], [64, 133935], [72, 134944], [77, 135344], [81, 135524], [87, 135784], [91, 136064]]}, {"verse": 19, "start": 137104, "end": 141232, "text": "Le dice la mujer: Señor, me parece que tú eres profeta.", "words": [[0, 137104], [3, 137384], [8, 137644], [11, 137824], [18, 138642], [25, 139378], [28, 139458], [35, 139858], [39, 140058], [42, 140258], [47, 140458]]}, {"verse": 20, "start": 141682, "end": 147981, "text": "Nuestros padres adoraron en este monte, y vosotros decís que en Jerusalén es el lugar donde es necesario adorar.", "words": [[0, 141682], [9, 142090], [16, 142390], [25, 142990], [28, 143130], [33, 143310], [40, 143650], [42, 144130], [51, 144550], [57, 145090], [61, 145230], [64, 145310], [74, 145950], [77, 146170], [80, 146310], [86, 146530], [92, 146790], [95, 146990], [105, 147510]]}, {"verse": 21, "start": 148331, "end": 156637, "text": "Le dice Jesús: Mujer, créeme, que la hora viene, cuando ni en este monte, ni en Jerusalén adoraréis al Padre.", "words": [[0, 148331], [3, 148480], [8, 148700], [15, 149746], [22, 150551], [30, 151031], [34, 151511], [37, 151671], [42, 151871], [49, 152291], [56, 152751], [59, 153031], [62, 153131], [67, 153351], [74, 153671], [77, 153971], [80, 154071], [90, 154811], [100, 155551], [103, 155851]]}, {"verse": 22, "start": 157087, "end": 165009, "text": "Vosotros adoráis lo que no sabéis; nosotros adoramos lo que sabemos: porque la salvación viene de los judíos.", "words": [[0, 157087], [9, 157554], [17, 158314], [20, 158714], [24, 158854], [27, 158994], [35, 160054], [44, 160521], [53, 161161], [56, 161441], [60, 161561], [69, 162513], [76, 162717], [79, 162917], [89, 163537], [95, 163877], [98, 164097], [102, 164217]]}, {"verse": 23, "start": 165459, "end": 178659, "text": "Pero la hora viene, y ahora es, cuando los verdaderos adoradores adorarán al Padre en espíritu y en verdad; porque también el Padre tales adoradores busca que le adoren.", "words": [[0, 165459], [5, 165604], [8, 165804], [13, 165984], [20, 166444], [22, 167004], [28, 167264], [32, 167704], [39, 168224], [43, 168524], [54, 169304], [65, 170004], [74, 170844], [77, 170984], [83, 171604], [86, 171804], [95, 172724], [97, 172884], [100, 172984], [108, 173930], [115, 174131], [123, 174611], [126, 174931], [132, 175611], [138, 175851], [149, 177051], [155, 177511], [159, 177791], [162, 177951]]}, {"verse": 24, "start": 179109, "end": 186380, "text": "Dios es Espíritu; y los que le adoran, en espíritu y en verdad es necesario que adoren.", "words": [[0, 179109], [5, 179471], [8, 179911], [18, 181310], [20, 181415], [24, 181555], [28, 181735], [31, 181875], [39, 182575], [42, 182955], [51, 183735], [53, 183835], [56, 183975], [63, 184295], [66, 184675], [76, 185415], [80, 185655]]}, {"verse": 25, "start": 186830, "end": 195290, "text": "Le dice la mujer: Sé que el Mesías ha de venir, llamado el Cristo: cuando él venga nos declarará todas las cosas.", "words": [[0, 186830], [3, 187110], [8, 187370], [11, 187550], [18, 188368], [21, 188676], [25, 188896], [28, 189116], [35, 189636], [38, 189936], [41, 190056], [48, 190716], [56, 191236], [59, 191516], [67, 192401], [74, 192625], [77, 192845], [83, 193425], [87, 193525], [97, 194125], [103, 194365], [107, 194625]]}, {"verse": 26, "start": 195640, "end": 198871, "text": "Le dice Jesús: Yo soy, que hablo contigo.", "words": [[0, 195640], [3, 195789], [8, 196009], [15, 197055], [18, 197245], [23, 197525], [27, 197805], [33, 198145]]}, {"verse": 27, "start": 199321, "end": 208653, "text": "Y en esto vinieron sus discípulos, y se maravillaron de que hablaba con mujer; pero ninguno dijo: ¿Qué preguntas? o, ¿Qué hablas con ella?", "words": [[0, 199321], [2, 199466], [5, 199566], [10, 199806], [19, 200326], [23, 200586], [35, 201406], [37, 201866], [40, 202026], [53, 202766], [56, 202966], [60, 203086], [68, 203486], [72, 203666], [79, 204492], [84, 204636], [92, 205156], [98, 206041], [103, 206316], [114, 206927], [117, 207347], [122, 207597], [129, 207847], [133, 208147]]}, {"verse": 28, "start": 209103, "end": 215349, "text": "Entonces la mujer dejó su cántaro, y fue a la ciudad, y dijo a aquellos hombres:", "words": [[0, 209103], [9, 210087], [12, 210287], [18, 210567], [23, 211007], [26, 211127], [35, 211747], [37, 212227], [41, 212447], [43, 212647], [46, 212667], [54, 213027], [56, 213707], [61, 214027], [63, 214167], [72, 214407]]}, {"verse": 29, "start": 215599, "end": 220480, "text": "Venid, ved un hombre que me ha dicho todo lo que he hecho: ¿No será este el Cristo?", "words": [[0, 215599], [7, 216082], [11, 216602], [14, 216762], [21, 216962], [25, 217102], [28, 217242], [31, 217342], [37, 217562], [42, 217802], [45, 218022], [49, 218182], [52, 218342], [59, 219158], [63, 219284], [68, 219484], [73, 219764], [76, 219904]]}, {"verse": 30, "start": 220830, "end": 224505, "text": "Entonces salieron de la ciudad, y vinieron a él.", "words": [[0, 220830], [9, 221290], [18, 222190], [21, 222330], [24, 222450], [32, 222770], [34, 223510], [43, 223990], [45, 224190]]}, {"verse": 31, "start": 224955, "end": 230104, "text": "Entre tanto los discípulos le rogaban, diciendo: Rabí, come.", "words": [[0, 224955], [6, 225196], [12, 225596], [16, 225836], [27, 226596], [30, 226996], [39, 227996], [49, 229214], [55, 229414]]}, {"verse": 32, "start": 230454, "end": 236119, "text": "Y él les dijo: Yo tengo una comida que comer, que vosotros no sabéis.", "words": [[0, 230454], [2, 230640], [5, 230760], [9, 230940], [15, 231713], [18, 231900], [24, 232320], [28, 232720], [35, 233160], [39, 233360], [46, 233760], [50, 234340], [59, 234880], [62, 235260]]}, {"verse": 33, "start": 236569, "end": 242347, "text": "Entonces los discípulos decían el uno al otro: ¿Le habrá traído alguien de comer?", "words": [[0, 236569], [9, 237117], [13, 237737], [24, 238517], [31, 239257], [34, 239517], [38, 239777], [41, 240077], [47, 240873], [51, 240994], [57, 241214], [64, 241494], [72, 241754], [75, 241934]]}, {"verse": 34, "start": 242697, "end": 248640, "text": "Les dice Jesús: Mi comida es que haga la voluntad del que me envió, y que acabe su obra.", "words": [[0, 242697], [4, 242884], [9, 243184], [16, 244239], [19, 244344], [26, 244724], [29, 244964], [33, 245144], [38, 245384], [41, 245564], [50, 245880], [54, 246196], [58, 246512], [61, 246828], [68, 247144], [70, 247404], [74, 247544], [80, 247904], [83, 248124]]}, {"verse": 35, "start": 249090, "end": 260670, "text": "¿No decís vosotros: Aun hay cuatro meses hasta que llegue la siega? He aquí os digo: Alzad vuestros ojos, y mirad los campos, porque ya están blancos para la siega.", "words": [[0, 249090], [4, 249317], [10, 249587], [20, 250827], [24, 251128], [28, 251268], [35, 251548], [41, 252008], [47, 252588], [51, 252788], [58, 253088], [61, 253463], [68, 254139], [71, 254229], [76, 254469], [79, 254689], [85, 255477], [91, 255911], [100, 256271], [106, 256611], [108, 257171], [114, 257491], [118, 257631], [126, 258311], [133, 258731], [136, 258991], [142, 259251], [150, 259751], [155, 259951], [158, 260338]]}, {"verse": 36, "start": 261120, "end": 270038, "text": "Y el que siega, recibe salario, y recoge fruto para vida eterna; para que el que siembra también goce, y el que siega.", "words": [[0, 261120], [2, 261402], [5, 261502], [9, 261832], [16, 262162], [23, 262802], [32, 263442], [34, 264009], [41, 264575], [47, 265142], [52, 265422], [57, 265662], [65, 266662], [70, 266822], [74, 267042], [77, 267162], [81, 267322], [89, 267862], [97, 268142], [103, 268842], [105, 269162], [108, 269262], [112, 269677]]}, {"verse": 37, "start": 270488, "end": 275691, "text": "Porque en esto es el dicho verdadero: Que uno es el que siembra, y otro es el que siega.", "words": [[0, 270488], [7, 270731], [10, 270951], [15, 271151], [18, 271331], [21, 271471], [27, 271711], [38, 274245], [42, 274245], [46, 274245], [49, 274245], [52, 274245], [56, 274245], [65, 274245], [67, 274402], [72, 274642], [75, 274842], [78, 274982], [82, 275364]]}, {"verse": 38, "start": 276141, "end": 285529, "text": "Yo os he enviado a segar lo que vosotros no labrasteis: otros labraron, y vosotros habéis entrado en sus labores.", "words": [[0, 276141], [3, 276429], [6, 276709], [9, 276949], [17, 277629], [19, 277909], [25, 278189], [28, 278309], [32, 278449], [41, 279069], [44, 279689], [56, 281286], [62, 281634], [72, 282474], [74, 282914], [83, 283374], [90, 283854], [98, 284414], [101, 284534], [105, 284694]]}, {"verse": 39, "start": 285979, "end": 298095, "text": "Y muchos de los samaritanos de aquella ciudad creyeron en él por la palabra de la mujer, que daba testimonio, diciendo: Que me dijo todo lo que he hecho.", "words": [[0, 285979], [2, 286100], [9, 286540], [12, 286760], [16, 287210], [28, 287660], [31, 287720], [39, 288060], [46, 288500], [55, 289580], [58, 289720], [61, 289860], [65, 290100], [68, 290300], [76, 290680], [79, 290840], [82, 290980], [89, 291740], [93, 291780], [98, 292080], [110, 293200], [120, 294374], [124, 294480], [127, 294620], [132, 294920], [137, 295300], [140, 295580], [144, 295760], [147, 295940]]}, {"verse": 40, "start": 298445, "end": 304963, "text": "Viniendo pues los samaritanos a él, le rogaron que se quedase allí: y se quedó allí dos días.", "words": [[0, 298445], [9, 298908], [14, 299208], [18, 299728], [30, 300248], [32, 300408], [36, 300768], [39, 301188], [47, 301688], [51, 301808], [54, 301948], [62, 302388], [68, 303239], [70, 303346], [73, 303466], [79, 303786], [84, 303966], [88, 304206]]}, {"verse": 41, "start": 305413, "end": 308704, "text": "Y creyeron muchos más por la palabra de él.", "words": [[0, 305413], [2, 305522], [11, 306142], [18, 306602], [22, 307102], [26, 307542], [29, 307702], [37, 308042], [40, 308282]]}, {"verse": 42, "start": 309154, "end": 319663, "text": "Y decían a la mujer: Ya no creemos por tu dicho; porque nosotros mismos hemos oído, y sabemos que verdaderamente este es el Salvador del mundo, el Cristo.", "words": [[0, 309154], [2, 309281], [9, 309821], [11, 310021], [14, 310101], [21, 310899], [24, 311062], [27, 311202], [35, 311602], [39, 311842], [42, 311982], [49, 312662], [56, 312863], [65, 313103], [72, 313543], [78, 313843], [84, 314283], [86, 314763], [94, 315083], [98, 315303], [113, 316083], [118, 316363], [121, 316583], [124, 316663], [133, 317003], [137, 317303], [144, 317923], [147, 318123]]}, {"verse": 43, "start": 320013, "end": 324633, "text": "Y dos días después, salió de allí, y se fue a Galilea.", "words": [[0, 320013], [2, 320134], [6, 320334], [11, 320654], [20, 321934], [26, 322454], [29, 322574], [35, 322894], [37, 323414], [40, 323514], [44, 323714], [46, 323834]]}, {"verse": 44, "start": 325083, "end": 330947, "text": "Porque el mismo Jesús dio testimonio de que el profeta en su tierra no tiene honra.", "words": [[0, 325083], [7, 325463], [10, 325643], [16, 325983], [22, 326543], [26, 327223], [37, 328043], [40, 328163], [44, 328303], [47, 328463], [55, 329003], [58, 329103], [61, 329263], [68, 329603], [71, 329903], [77, 330203]]}, {"verse": 45, "start": 331397, "end": 342984, "text": "Y cuando vino a Galilea, los galileos le recibieron, vistas todas las cosas que había hecho en Jerusalén en el día de la fiesta: porque también ellos habían ido a la fiesta.", "words": [[0, 331397], [2, 331499], [9, 331699], [14, 331999], [16, 332159], [25, 333039], [29, 333299], [38, 333919], [41, 334059], [53, 334819], [60, 335599], [66, 335879], [70, 336179], [76, 336499], [80, 336739], [86, 336979], [92, 337279], [95, 337399], [105, 338119], [108, 338559], [111, 338699], [115, 338899], [118, 339039], [121, 339139], [129, 340015], [136, 340220], [144, 340640], [150, 341140], [157, 341740], [161, 342120], [163, 342260], [166, 342320]]}, {"verse": 46, "start": 343434, "end": 355266, "text": "Vino pues Jesús otra vez a Caná de Galilea, donde había hecho el vino del agua. Y había en Capernaum un funcionario del rey, cuyo hijo estaba enfermo.", "words": [[0, 343434], [5, 343679], [10, 343979], [16, 344499], [21, 345199], [25, 345579], [27, 345859], [32, 346199], [35, 346299], [44, 347339], [50, 347699], [56, 348099], [62, 348379], [65, 348559], [70, 348779], [74, 348999], [80, 349911], [82, 350040], [88, 350300], [91, 350920], [101, 351540], [104, 351820], [116, 352620], [120, 352860], [125, 353600], [130, 354020], [135, 354200], [142, 354500]]}, {"verse": 47, "start": 355716, "end": 367211, "text": "Este, cuando oyó que Jesús venía de Judea a Galilea, fue a él, y le rogaba que descendiese, y sanase a su hijo, porque se comenzaba a morir.", "words": [[0, 355716], [6, 356094], [13, 356414], [17, 356954], [21, 357074], [27, 357454], [33, 358114], [36, 358254], [42, 358854], [44, 359054], [53, 360234], [57, 360314], [59, 360634], [63, 360934], [65, 361414], [68, 361574], [75, 362114], [79, 362294], [92, 363914], [94, 363974], [101, 364434], [103, 364554], [106, 364734], [112, 364974], [119, 365354], [122, 365514], [132, 366174], [134, 366294]]}, {"verse": 48, "start": 367661, "end": 373833, "text": "Entonces Jesús le dijo: Si no veis señales y milagros no creeréis.", "words": [[0, 367661], [9, 368143], [15, 368883], [18, 369343], [24, 370174], [27, 370339], [30, 370499], [35, 370939], [43, 371719], [45, 371899], [54, 372579], [57, 372759]]}, {"verse": 49, "start": 374283, "end": 380566, "text": "El funcionario del rey le dijo: Señor, desciende antes que mi hijo muera.", "words": [[0, 374283], [3, 374450], [15, 375190], [19, 375390], [23, 375890], [26, 376030], [32, 376865], [39, 377191], [49, 377891], [55, 378311], [59, 378571], [62, 378771], [67, 378971]]}, {"verse": 50, "start": 380916, "end": 388010, "text": "Le dice Jesús: Ve, tu hijo vive. Y el hombre creyó a la palabra que Jesús le dijo, y se fue.", "words": [[0, 380916], [3, 381065], [8, 381285], [15, 382578], [19, 382858], [22, 383058], [27, 383298], [33, 384179], [35, 384277], [38, 384377], [45, 384637], [51, 385177], [53, 385297], [56, 385377], [64, 385757], [68, 385977], [74, 386277], [77, 386697], [83, 386997], [85, 387457], [88, 387597]]}, {"verse": 51, "start": 388460, "end": 396213, "text": "Y cuando ya él descendía, los siervos le salieron a recibir, y le dieron nuevas, diciendo: Tu hijo vive.", "words": [[0, 388460], [2, 388565], [9, 388845], [12, 389105], [15, 389305], [26, 390705], [30, 390825], [38, 391425], [41, 391785], [50, 392265], [52, 392425], [61, 392825], [63, 393345], [66, 393465], [73, 393765], [81, 394125], [91, 395388], [94, 395492], [99, 395712]]}, {"verse": 52, "start": 396563, "end": 404173, "text": "Entonces él les preguntó a qué hora comenzó a estar mejor. Y le dijeron: Ayer a las siete le dejó la fiebre.", "words": [[0, 396563], [9, 397188], [12, 397488], [16, 397728], [25, 398448], [27, 398628], [31, 398808], [36, 399188], [44, 399828], [46, 399908], [52, 400088], [59, 401022], [61, 401168], [64, 401228], [73, 402282], [78, 402572], [80, 402692], [84, 402872], [90, 403052], [93, 403272], [98, 403552], [101, 403652]]}, {"verse": 53, "start": 404523, "end": 413802, "text": "El padre entonces entendió, que aquella hora era cuando Jesús le dijo: Tu hijo vive; y creyó él y toda su casa.", "words": [[0, 404523], [3, 404665], [9, 405245], [18, 405705], [28, 406665], [32, 406885], [40, 407285], [45, 407625], [49, 407965], [56, 408225], [62, 408865], [65, 409305], [71, 410131], [74, 410252], [79, 410472], [85, 411333], [87, 411477], [93, 411957], [96, 412377], [98, 412757], [103, 412937], [106, 413197]]}, {"verse": 54, "start": 414252, "end": 419629, "text": "Esta segunda señal volvió Jesús a hacer, cuando vino de Judea a Galilea.", "words": [[0, 414252], [5, 414561], [13, 415001], [19, 415581], [26, 415921], [32, 416221], [34, 416521], [41, 416981], [48, 417481], [53, 417881], [56, 418101], [62, 418661], [64, 418861]]}]}