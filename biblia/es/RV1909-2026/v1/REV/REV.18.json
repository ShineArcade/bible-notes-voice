{"book": "REV", "chapter": 18, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 259187, "verses": [{"verse": 1, "start": 300, "end": 7692, "text": "Y después de estas cosas vi otro ángel descender del cielo teniendo gran autoridad; y la tierra fue alumbrada de su gloria.", "words": [[0, 300], [2, 404], [10, 724], [13, 1004], [19, 1224], [25, 1644], [28, 1984], [33, 2244], [39, 2724], [49, 3224], [53, 3364], [59, 3764], [68, 4344], [73, 4544], [84, 5580], [86, 5661], [89, 5761], [96, 6081], [100, 6341], [110, 6881], [113, 7041], [116, 7161]]}, {"verse": 2, "start": 8141, "end": 21480, "text": "Y clamó con fortaleza en alta voz, diciendo: Caída es, caída es la grande Babilonia, y es hecha habitación de demonios, y guarida de todo espíritu inmundo, y albergue de todas aves sucias y aborrecibles.", "words": [[0, 8141], [2, 8246], [8, 8606], [12, 8726], [22, 9366], [25, 9486], [30, 9686], [35, 9966], [45, 11826], [51, 12144], [55, 12284], [61, 12684], [64, 12844], [67, 12964], [74, 13224], [85, 13844], [87, 14304], [90, 14444], [96, 14764], [107, 15244], [110, 15384], [120, 16004], [122, 16364], [130, 16764], [133, 16904], [138, 17084], [147, 17614], [156, 18144], [158, 18564], [167, 19044], [170, 19164], [176, 19364], [181, 19784], [188, 20304], [190, 20564]]}, {"verse": 3, "start": 21930, "end": 35349, "text": "Porque todas las naciones han bebido del vino del furor de su inmoralidad sexual; y los reyes de la tierra han practicado inmoralidad sexual con ella, y los mercaderes de la tierra se han enriquecido por la abundancia de sus lujos.", "words": [[0, 21930], [7, 22121], [13, 22381], [17, 22681], [26, 23101], [30, 23381], [37, 23781], [41, 23981], [46, 24181], [50, 24341], [56, 24741], [59, 24881], [62, 25041], [74, 25661], [82, 26616], [84, 26702], [88, 26842], [94, 27282], [97, 27402], [100, 27522], [107, 27882], [111, 28202], [122, 28922], [134, 29722], [141, 30182], [145, 30542], [151, 31102], [153, 31222], [157, 31342], [168, 31982], [171, 32042], [174, 32142], [181, 32442], [184, 32682], [188, 32782], [200, 33442], [204, 33662], [207, 33822], [218, 34382], [221, 34502], [225, 34662]]}, {"verse": 4, "start": 35799, "end": 45557, "text": "Y oí otra voz del cielo, que decía: Salid de ella, pueblo mío, porque no seáis participantes de sus pecados, y que no recibáis de sus plagas;", "words": [[0, 35799], [2, 35968], [5, 36228], [10, 36548], [14, 36848], [18, 37048], [25, 37468], [29, 37808], [36, 38692], [42, 39137], [45, 39277], [51, 39577], [58, 39717], [63, 40457], [70, 40797], [73, 41047], [79, 41297], [93, 42257], [96, 42437], [100, 42597], [109, 43317], [111, 43677], [115, 43797], [118, 43957], [127, 44477], [130, 44637], [134, 44797]]}, {"verse": 5, "start": 46241, "end": 51435, "text": "Porque sus pecados han llegado hasta el cielo, y Dios se ha acordado de sus maldades.", "words": [[0, 46241], [7, 46445], [11, 46625], [19, 47205], [23, 47385], [31, 47845], [37, 48065], [40, 48225], [47, 48585], [49, 49145], [54, 49385], [57, 49645], [60, 49745], [69, 50285], [72, 50445], [76, 50585]]}, {"verse": 6, "start": 52141, "end": 60421, "text": "Devolvedle como ella os ha dado, y pagadle al doble según sus obras; en la copa que ella os dio a beber, dadle a beber doblado.", "words": [[0, 52141], [11, 52821], [16, 53061], [21, 53341], [24, 53561], [27, 53681], [33, 53981], [35, 54431], [43, 54881], [46, 54981], [52, 55341], [58, 55561], [62, 55821], [69, 56830], [72, 56951], [75, 57071], [80, 57471], [84, 57584], [89, 57698], [92, 57811], [96, 58051], [98, 58171], [105, 58871], [111, 59391], [113, 59471], [119, 59671]]}, {"verse": 7, "start": 61103, "end": 72816, "text": "Cuanto ella se ha glorificado, y ha vivido en lujos, tanto dadle de tormento y llanto; porque dice en su corazón: Yo estoy sentada reina, y no soy viuda, y no veré llanto.", "words": [[0, 61103], [7, 61346], [12, 61646], [15, 61866], [18, 62006], [31, 62826], [33, 63226], [36, 63326], [43, 63706], [46, 63786], [53, 64546], [59, 64826], [65, 65266], [68, 65406], [77, 65966], [79, 66066], [87, 67097], [94, 67261], [99, 67461], [102, 67661], [105, 67901], [114, 69095], [117, 69216], [123, 69476], [131, 69976], [138, 70736], [140, 70796], [143, 70916], [147, 71136], [154, 71876], [156, 71916], [159, 72036], [164, 72316]]}, {"verse": 8, "start": 73500, "end": 83233, "text": "Por lo cual en un día vendrán sus plagas, muerte, llanto y hambre, y será quemada con fuego; porque el Señor Dios es fuerte, que la juzgará.", "words": [[0, 73500], [4, 73616], [7, 73756], [12, 74056], [15, 74276], [18, 74416], [22, 74676], [30, 75116], [34, 75276], [42, 75996], [50, 76836], [57, 77196], [59, 77476], [67, 77836], [69, 78196], [74, 78416], [82, 78856], [86, 79056], [93, 80080], [100, 80323], [103, 80463], [109, 80703], [114, 81043], [117, 81343], [125, 82103], [129, 82343], [132, 82463]]}, {"verse": 9, "start": 83759, "end": 94716, "text": "Y llorarán y se lamentarán sobre ella los reyes de la tierra, los cuales han practicado inmoralidad sexual con ella y han vivido en lujos, cuando ellos vean el humo de su incendio,", "words": [[0, 83759], [2, 83886], [11, 84506], [13, 84606], [16, 84726], [27, 85386], [33, 85606], [38, 85906], [42, 86086], [48, 86426], [51, 86546], [54, 86666], [62, 87586], [66, 87686], [73, 87966], [77, 88246], [88, 88866], [100, 89426], [107, 89806], [111, 90206], [116, 90446], [118, 90946], [122, 91066], [129, 91466], [132, 91566], [139, 92486], [146, 92669], [152, 92949], [157, 93389], [160, 93509], [165, 93769], [168, 93849], [171, 94009]]}, {"verse": 10, "start": 95166, "end": 105094, "text": "Estando lejos por el temor de su tormento, diciendo: ¡Ay, ay, de aquella gran ciudad de Babilonia, aquella fuerte ciudad; porque en una hora vino tu juicio!", "words": [[0, 95166], [8, 95567], [14, 95947], [18, 96227], [21, 96347], [27, 96727], [30, 96847], [33, 96967], [43, 97667], [53, 98799], [58, 99180], [62, 99660], [65, 99720], [73, 100060], [78, 100240], [85, 100600], [88, 100840], [99, 101680], [107, 102000], [114, 102280], [122, 103394], [129, 103592], [132, 103712], [136, 103852], [141, 104112], [146, 104312], [149, 104532]]}, {"verse": 11, "start": 105544, "end": 111481, "text": "Y los mercaderes de la tierra lloran y se lamentan sobre ella, porque ninguno compra más sus mercaderías:", "words": [[0, 105544], [2, 105626], [6, 105726], [17, 106406], [20, 106486], [23, 106586], [30, 106886], [37, 107466], [39, 107566], [42, 107626], [51, 108126], [57, 108366], [63, 108766], [70, 109306], [78, 109806], [85, 110146], [89, 110366], [93, 110546]]}, {"verse": 12, "start": 111931, "end": 130404, "text": "Mercadería de oro, y de plata, y de piedras preciosas, y de perlas, y de lino fino, y de escarlata, y de seda, y de grana, y de toda madera olorosa, y de todo objeto de marfil, y de todo objeto de madera preciosa, y de cobre, y de hierro, y de mármol;", "words": [[0, 111931], [11, 112571], [14, 112691], [19, 112931], [21, 113091], [24, 113171], [31, 113571], [33, 113971], [36, 114071], [44, 114491], [55, 115291], [57, 115451], [60, 115591], [68, 116051], [70, 116551], [73, 116651], [78, 116911], [84, 117251], [86, 117811], [89, 117911], [100, 118531], [102, 118831], [105, 118931], [111, 119331], [113, 119751], [116, 119851], [123, 120647], [125, 120774], [128, 120894], [133, 121094], [140, 121614], [149, 122234], [151, 122734], [154, 122874], [159, 123054], [166, 123474], [169, 123814], [177, 124154], [179, 124674], [182, 124794], [187, 124974], [194, 125394], [197, 125594], [204, 125974], [214, 126634], [216, 127034], [219, 127134], [226, 127594], [228, 127854], [231, 127914], [239, 128434], [241, 128694], [244, 128814]]}, {"verse": 13, "start": 130854, "end": 143275, "text": "Y canela, y olores, y ungüentos, y de incienso, y de vino, y de aceite; y flor de harina y trigo, y de bestias, y de ovejas; y de caballos, y de carros, y de esclavos, y de vidas humanas.", "words": [[0, 130854], [2, 130962], [10, 131442], [12, 131602], [20, 132102], [22, 132422], [33, 133142], [35, 133342], [38, 133442], [48, 134042], [50, 134182], [53, 134322], [59, 134542], [61, 134842], [64, 134922], [72, 135898], [74, 136178], [79, 136418], [82, 136618], [89, 136978], [91, 137098], [98, 137518], [100, 137718], [103, 137818], [112, 138318], [114, 138578], [117, 138678], [125, 139681], [127, 139771], [130, 139851], [140, 140391], [142, 140511], [145, 140631], [153, 141111], [155, 141331], [158, 141451], [168, 142031], [170, 142211], [173, 142331], [179, 142631]]}, {"verse": 14, "start": 143725, "end": 151935, "text": "Y los frutos del deseo de tu alma se apartaron de ti; y todas las cosas lujosas y espléndidas te han faltado, y nunca más las hallarás.", "words": [[0, 143725], [2, 143803], [6, 143923], [13, 144363], [17, 144583], [23, 145003], [26, 145083], [29, 145223], [34, 145483], [37, 145723], [47, 146243], [50, 146423], [54, 147040], [56, 147145], [62, 147305], [66, 147565], [72, 148065], [80, 148565], [82, 148685], [94, 149365], [97, 149545], [101, 149625], [110, 150225], [112, 150525], [118, 150765], [122, 151105], [126, 151225]]}, {"verse": 15, "start": 152385, "end": 160354, "text": "Los mercaderes de estas cosas, que se han enriquecido, se pondrán lejos de ella por el temor de su tormento, llorando y lamentando,", "words": [[0, 152385], [4, 152484], [15, 153124], [18, 153224], [24, 153404], [31, 153904], [35, 154304], [38, 154464], [42, 154604], [55, 155304], [58, 155904], [66, 156324], [72, 156644], [75, 156864], [80, 157104], [84, 157364], [87, 157484], [93, 157824], [96, 157944], [99, 158064], [109, 159064], [118, 159464], [120, 159584]]}, {"verse": 16, "start": 160804, "end": 171834, "text": "Y diciendo: ¡Ay, ay, aquella gran ciudad, que estaba vestida de lino fino, y de escarlata, y de grana, y estaba dorada con oro, y adornada de piedras preciosas y de perlas!", "words": [[0, 160804], [2, 160919], [12, 161878], [17, 162036], [21, 162556], [29, 162996], [34, 163216], [42, 163596], [46, 163976], [53, 164256], [61, 164756], [64, 164896], [69, 165176], [75, 165496], [77, 166036], [80, 166426], [91, 166816], [93, 166976], [96, 167076], [103, 167476], [105, 167776], [112, 168056], [119, 168456], [123, 168676], [128, 168936], [130, 169336], [139, 169856], [142, 170036], [150, 170376], [160, 171036], [162, 171156], [165, 171276]]}, {"verse": 17, "start": 172284, "end": 182703, "text": "Porque en una hora han sido desoladas tantas riquezas. Y todo capitán de barco, y todos los que viajan en naves, y marineros, y todos los que trabajan en el mar, se estuvieron lejos;", "words": [[0, 172284], [7, 172514], [10, 172694], [14, 172854], [19, 173174], [23, 173434], [28, 173714], [38, 174294], [45, 174774], [55, 175786], [57, 175892], [62, 176072], [70, 176552], [73, 176652], [80, 177092], [82, 177412], [88, 177612], [92, 177812], [96, 177992], [103, 178352], [106, 178472], [113, 178852], [115, 179132], [126, 179792], [128, 179932], [134, 180152], [138, 180372], [142, 180512], [151, 180972], [154, 181052], [157, 181192], [162, 181412], [165, 181732], [176, 182172]]}, {"verse": 18, "start": 183153, "end": 189240, "text": "Y viendo el humo de su incendio, dieron voces, diciendo: ¿Qué ciudad era semejante a esta gran ciudad?", "words": [[0, 183153], [2, 183273], [9, 183533], [12, 183713], [17, 183953], [20, 184053], [23, 184193], [33, 184713], [40, 184993], [47, 185593], [57, 186771], [62, 186868], [69, 187148], [73, 187388], [83, 188068], [85, 188188], [90, 188388], [95, 188608]]}, {"verse": 19, "start": 189690, "end": 204274, "text": "Y echaron polvo sobre sus cabezas; y dieron voces, llorando y lamentando, diciendo: ¡Ay, ay, de aquella gran ciudad, en la cual todos los que tenían barcos en el mar se habían enriquecido de sus riquezas; que en una hora ha sido desolada!", "words": [[0, 189690], [2, 189950], [10, 190250], [16, 190690], [22, 190930], [26, 191150], [35, 192220], [37, 192363], [44, 192583], [51, 193083], [60, 193563], [62, 193643], [74, 194323], [84, 195348], [89, 195506], [93, 195706], [96, 196326], [104, 196666], [109, 196846], [117, 197206], [120, 197666], [123, 197786], [128, 197966], [134, 198266], [138, 198586], [142, 198746], [149, 199066], [156, 199526], [159, 199706], [162, 199826], [166, 200046], [169, 200246], [176, 200526], [188, 201186], [191, 201346], [195, 201486], [205, 202529], [209, 202634], [212, 202734], [216, 202874], [221, 203114], [224, 203254], [229, 203514]]}, {"verse": 20, "start": 204724, "end": 212970, "text": "Alégrate sobre ella, cielo, y vosotros, santos, apóstoles, y profetas; porque Dios ha vengado vuestra causa en ella.", "words": [[0, 204724], [9, 205224], [15, 205524], [21, 205784], [28, 206264], [30, 206864], [40, 207464], [48, 208144], [59, 208764], [61, 208924], [71, 209986], [78, 210167], [83, 210447], [86, 210667], [94, 211067], [102, 211447], [108, 211747], [111, 212027]]}, {"verse": 21, "start": 213420, "end": 225307, "text": "Y un ángel fuerte tomó una piedra como una grande piedra de molino, y la echó en el mar, diciendo: Con tanto ímpetu será derribada Babilonia, aquella grande ciudad, y nunca jamás será hallada.", "words": [[0, 213420], [2, 213525], [5, 213665], [11, 213965], [18, 214265], [23, 214765], [27, 214885], [34, 215325], [39, 215545], [43, 215765], [50, 216045], [57, 216505], [60, 216605], [68, 217105], [70, 217545], [73, 217665], [78, 217925], [81, 218025], [84, 218145], [89, 218605], [99, 219560], [103, 219703], [109, 220143], [116, 220583], [121, 221023], [131, 221463], [142, 222283], [150, 222543], [157, 222743], [165, 223163], [167, 223683], [173, 223903], [179, 224343], [184, 224503]]}, {"verse": 22, "start": 225757, "end": 238787, "text": "Y voz de arpistas, y de músicos, y de flautistas y trompetistas, no será más oída en ti; y todo artesano de cualquier oficio, no será más hallado en ti; y el sonido de piedra de molino no será más en ti oído:", "words": [[0, 225757], [2, 225863], [6, 226063], [9, 226223], [19, 226763], [21, 226963], [24, 227043], [33, 227563], [35, 227743], [38, 227823], [49, 228403], [51, 228583], [65, 229643], [68, 229843], [73, 230083], [77, 230323], [82, 230743], [85, 230943], [89, 231521], [91, 231625], [96, 231785], [105, 232445], [108, 232585], [118, 232865], [126, 233425], [129, 233785], [134, 233985], [138, 234205], [146, 234625], [149, 234765], [153, 235318], [155, 235420], [158, 235540], [165, 235960], [168, 236100], [175, 236480], [178, 236600], [185, 237080], [188, 237300], [193, 237520], [197, 237850], [200, 238180], [203, 238510]]}, {"verse": 23, "start": 239237, "end": 252164, "text": "Y luz de antorcha no alumbrará más en ti; y voz de esposo ni de esposa no será más en ti oída; porque tus mercaderes eran los grandes de la tierra; porque en tus hechicerías todas las naciones han sido engañadas.", "words": [[0, 239237], [2, 239340], [6, 239480], [9, 239660], [18, 240200], [21, 240460], [31, 241100], [35, 241240], [38, 241480], [42, 242150], [44, 242256], [48, 242416], [51, 242576], [58, 243016], [61, 243176], [64, 243316], [71, 243776], [74, 243916], [79, 244096], [83, 244371], [86, 244646], [89, 244921], [95, 245440], [102, 245605], [106, 245785], [117, 246445], [122, 246605], [126, 246805], [134, 247125], [137, 247345], [140, 247445], [148, 248226], [155, 248449], [158, 248569], [162, 248689], [174, 249349], [180, 249569], [184, 249869], [193, 250249], [197, 250489], [202, 250729]]}, {"verse": 24, "start": 252614, "end": 258787, "text": "Y en ella fue hallada la sangre de los profetas y de los santos, y de todos los que han sido muertos en la tierra.", "words": [[0, 252614], [2, 252737], [5, 252857], [10, 253037], [14, 253277], [22, 253657], [25, 253797], [32, 254177], [35, 254357], [39, 254477], [48, 255037], [50, 255197], [53, 255277], [57, 255417], [65, 256237], [67, 256377], [70, 256517], [76, 256737], [80, 256977], [84, 257177], [88, 257297], [93, 257517], [101, 257977], [104, 258177], [107, 258277]]}]}