{"book": "LUK", "chapter": 4, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 352884, "verses": [{"verse": 1, "start": 300, "end": 7460, "text": "Y Jesús, lleno del Espíritu Santo, volvió del Jordán, y fue llevado por el Espíritu al desierto", "words": [[0, 300], [2, 465], [9, 1405], [15, 1925], [19, 2065], [28, 2625], [35, 3545], [42, 3985], [46, 4125], [54, 4865], [56, 5285], [60, 5445], [68, 5905], [72, 6145], [75, 6265], [84, 6825], [87, 6945]]}, {"verse": 2, "start": 7810, "end": 16335, "text": "Por cuarenta días, y era tentado del diablo. Y no comió cosa en aquellos días: los cuales pasados, tuvo hambre.", "words": [[0, 7810], [4, 8230], [13, 8650], [19, 9110], [21, 9610], [25, 9750], [33, 10350], [37, 10590], [45, 11598], [47, 11723], [50, 11843], [56, 12263], [61, 12683], [64, 12863], [73, 13123], [79, 14196], [83, 14276], [90, 14616], [99, 15336], [104, 15676]]}, {"verse": 3, "start": 16685, "end": 22783, "text": "Entonces el diablo le dijo: Si eres Hijo de Dios, di a esta piedra que se haga pan.", "words": [[0, 16685], [9, 17632], [12, 17952], [19, 18392], [22, 18572], [28, 19327], [31, 19540], [36, 19780], [41, 20040], [44, 20200], [50, 20920], [53, 21100], [55, 21200], [60, 21380], [67, 21860], [71, 21960], [74, 22140], [79, 22300]]}, {"verse": 4, "start": 23063, "end": 31751, "text": "Y Jesús respondiéndole, dijo: Escrito está: Que no con pan solo vivirá el hombre, sino con toda palabra de Dios.", "words": [[0, 23063], [2, 23191], [8, 24061], [24, 24931], [30, 25745], [38, 26345], [44, 27130], [48, 27212], [51, 27459], [55, 27705], [59, 27952], [64, 28272], [71, 28812], [74, 28952], [82, 29592], [87, 29832], [91, 30152], [96, 30412], [104, 30952], [107, 31192]]}, {"verse": 5, "start": 32101, "end": 39304, "text": "Y le llevó el diablo a un alto monte, y le mostró en un momento de tiempo todos los reinos de la tierra.", "words": [[0, 32101], [2, 32220], [5, 32340], [11, 32720], [14, 32840], [21, 33280], [23, 33520], [26, 33700], [31, 33940], [38, 34400], [40, 34820], [43, 34960], [50, 35560], [53, 35800], [56, 35960], [64, 36400], [67, 36600], [74, 37000], [80, 37460], [84, 37920], [91, 38460], [94, 38580], [97, 38680]]}, {"verse": 6, "start": 39654, "end": 46745, "text": "Y le dijo el diablo: A ti te daré toda esta potestad, y la gloria de ellos; porque a mí es entregada, y a quien quiero la doy:", "words": [[0, 39654], [2, 39782], [5, 39882], [10, 40142], [13, 40302], [21, 41111], [23, 41218], [26, 41378], [29, 41498], [34, 41798], [39, 41958], [44, 42278], [54, 42978], [56, 43278], [59, 43398], [66, 43738], [69, 43858], [76, 44563], [83, 44811], [85, 44951], [88, 45031], [91, 45171], [102, 45691], [104, 45851], [106, 45911], [112, 46051], [119, 46311], [122, 46451]]}, {"verse": 7, "start": 47095, "end": 50008, "text": "Pues si tú adoras delante de mí, serán todos tuyos.", "words": [[0, 47095], [5, 47235], [8, 47395], [11, 47495], [18, 47875], [26, 48275], [29, 48375], [33, 48815], [39, 49115], [45, 49335]]}, {"verse": 8, "start": 50288, "end": 60367, "text": "Y respondiendo Jesús, le dijo: Vete de mí, Satanás, porque escrito está: A tu Señor Dios adorarás, y a él solo servirás.", "words": [[0, 50288], [2, 50409], [15, 51189], [22, 51529], [25, 51909], [31, 52697], [36, 53001], [39, 53181], [43, 53441], [52, 54481], [59, 54701], [67, 55161], [73, 56021], [75, 56227], [78, 56347], [84, 56707], [89, 57127], [99, 58087], [101, 58447], [103, 58547], [106, 58787], [111, 59207]]}, {"verse": 9, "start": 60717, "end": 69029, "text": "Y le llevó a Jerusalén, y le puso sobre el pináculo del templo, y le dijo: Si eres Hijo de Dios, échate de aquí abajo:", "words": [[0, 60717], [2, 60859], [5, 60959], [11, 61319], [13, 61419], [24, 62599], [26, 62819], [29, 62959], [34, 63379], [40, 63699], [43, 63899], [52, 64619], [56, 64839], [64, 65499], [66, 65599], [69, 65679], [75, 66402], [78, 66593], [83, 66793], [88, 67073], [91, 67233], [97, 67793], [104, 68113], [107, 68313], [112, 68493]]}, {"verse": 10, "start": 69379, "end": 73316, "text": "Porque escrito está: Que a sus ángeles mandará de ti, que te guarden;", "words": [[0, 69379], [7, 69672], [15, 70012], [21, 70762], [25, 70842], [27, 70942], [31, 71042], [39, 71442], [47, 71882], [50, 72042], [54, 72242], [58, 72582], [61, 72702]]}, {"verse": 11, "start": 73666, "end": 77378, "text": "Y en las manos te llevarán, para que no dañes tu pie en piedra.", "words": [[0, 73666], [2, 73793], [5, 73893], [9, 74013], [15, 74313], [18, 74533], [28, 75093], [33, 75553], [37, 75713], [40, 75853], [46, 76273], [49, 76393], [53, 76633], [56, 76833]]}, {"verse": 12, "start": 77658, "end": 83141, "text": "Y respondiendo Jesús, le dijo: Dicho está: No tentarás al Señor tu Dios.", "words": [[0, 77658], [2, 77780], [15, 78560], [22, 78900], [25, 79280], [31, 80068], [37, 80378], [43, 81160], [46, 81507], [55, 81887], [58, 82027], [64, 82347], [67, 82587]]}, {"verse": 13, "start": 83491, "end": 87959, "text": "Y acabada toda tentación, el diablo se fue de él por un tiempo.", "words": [[0, 83491], [2, 83715], [10, 84255], [15, 84475], [26, 85695], [29, 85795], [36, 86155], [39, 86395], [43, 86615], [46, 86815], [49, 86975], [53, 87175], [56, 87335]]}, {"verse": 14, "start": 88309, "end": 95086, "text": "Y Jesús volvió en el poder del Espíritu a Galilea, y salió la fama de él por toda la tierra de alrededor.", "words": [[0, 88309], [2, 88451], [8, 88811], [15, 89611], [18, 89711], [21, 89851], [27, 90151], [31, 90431], [40, 91011], [42, 91071], [51, 91731], [53, 92091], [59, 92411], [62, 92551], [67, 92891], [70, 93011], [73, 93131], [77, 93311], [82, 93611], [85, 93791], [92, 94111], [95, 94311]]}, {"verse": 15, "start": 95436, "end": 100525, "text": "Y enseñaba en las sinagogas de ellos, y era glorificado de todos.", "words": [[0, 95436], [2, 95705], [11, 96365], [14, 96485], [18, 96625], [28, 97385], [31, 97565], [38, 98405], [40, 98945], [44, 99395], [56, 99845], [59, 100025]]}, {"verse": 16, "start": 100875, "end": 110854, "text": "Y vino a Nazaret, donde había sido criado; y entró, conforme a su costumbre, el día del sábado en la sinagoga, y se levantó a leer.", "words": [[0, 100875], [2, 101012], [7, 101232], [9, 101392], [18, 101872], [24, 102692], [30, 103052], [35, 103372], [43, 104326], [45, 104471], [52, 104971], [61, 105711], [63, 105771], [66, 105891], [77, 106551], [80, 106991], [84, 107251], [88, 107471], [95, 108131], [98, 108251], [101, 108391], [111, 109071], [113, 109531], [116, 109651], [124, 110251], [126, 110391]]}, {"verse": 17, "start": 111204, "end": 118536, "text": "Y le fue dado el libro del profeta Isaías; y como abrió el libro, halló el lugar donde estaba escrito:", "words": [[0, 111204], [2, 111329], [5, 111429], [9, 111609], [14, 111909], [17, 112169], [23, 112429], [27, 112669], [35, 113309], [43, 114466], [45, 114570], [50, 114790], [56, 115210], [59, 115410], [66, 116210], [72, 116650], [75, 116790], [81, 117150], [87, 117450], [94, 117830]]}, {"verse": 18, "start": 118886, "end": 136368, "text": "El Espíritu del Señor es sobre mí, por cuanto me ha ungido para dar buenas nuevas a los pobres: me ha enviado para sanar a los quebrantados de corazón; para pregonar a los cautivos libertad, y a los ciegos vista; para poner en libertad a los quebrantados:", "words": [[0, 118886], [3, 119027], [12, 119667], [16, 119807], [22, 120147], [25, 120367], [31, 120587], [35, 121187], [39, 121347], [46, 121527], [49, 121827], [52, 122107], [59, 122387], [64, 122627], [68, 122887], [75, 123167], [82, 123487], [84, 123827], [88, 123927], [96, 124909], [99, 125038], [102, 125178], [110, 125658], [115, 125918], [121, 126418], [123, 126478], [127, 126618], [140, 127518], [143, 127698], [152, 128691], [157, 128858], [166, 129538], [168, 129598], [172, 129738], [181, 130278], [191, 131038], [193, 131218], [195, 131298], [199, 131478], [206, 132118], [213, 133081], [218, 133341], [224, 133701], [227, 134081], [236, 134761], [238, 134961], [242, 135101]]}, {"verse": 19, "start": 136718, "end": 139455, "text": "Para predicar el año agradable del Señor.", "words": [[0, 136718], [5, 136865], [14, 137505], [17, 137785], [21, 138215], [31, 138645], [35, 138805]]}, {"verse": 20, "start": 139805, "end": 148673, "text": "Y enrollando el libro, lo dio al ministro, y se sentó: y los ojos de todos en la sinagoga estaban fijos en él.", "words": [[0, 139805], [2, 139929], [13, 140589], [16, 140789], [23, 141689], [26, 141929], [30, 142169], [33, 142409], [43, 143189], [45, 143769], [48, 143929], [55, 144906], [57, 145014], [61, 145154], [66, 145474], [69, 145714], [75, 146054], [78, 146334], [81, 146474], [90, 147034], [98, 147414], [104, 148114], [107, 148334]]}, {"verse": 21, "start": 149023, "end": 154326, "text": "Y comenzó a decirles: Hoy se ha cumplido esta Escritura en vuestros oídos.", "words": [[0, 149023], [2, 149398], [10, 149958], [12, 150058], [22, 151153], [26, 151339], [29, 151539], [32, 151679], [41, 152379], [46, 152559], [56, 153199], [59, 153299], [68, 153659]]}, {"verse": 22, "start": 154676, "end": 163412, "text": "Y todos le daban testimonio, y estaban maravillados de las palabras de gracia que salían de su boca, y decían: ¿No es este el hijo de José?", "words": [[0, 154676], [2, 154801], [8, 155021], [11, 155261], [17, 155561], [29, 156481], [31, 156601], [39, 156901], [52, 157781], [55, 157941], [59, 158061], [68, 158461], [71, 158641], [78, 159141], [82, 159241], [89, 159661], [92, 159821], [95, 159961], [101, 160281], [103, 160721], [111, 161643], [115, 161858], [118, 162098], [123, 162418], [126, 162598], [131, 162778], [134, 162898]]}, {"verse": 23, "start": 163692, "end": 175046, "text": "Y les dijo: Sin duda me diréis este refrán: Médico, cúrate a ti mismo: de tantas cosas que hemos oído haber sido hechas en Capernaum, haz también aquí en tu tierra.", "words": [[0, 163692], [2, 163840], [6, 163940], [12, 164729], [16, 164914], [21, 165174], [24, 165394], [31, 165754], [36, 166034], [44, 166931], [52, 167881], [59, 168161], [61, 168341], [64, 168441], [71, 169258], [74, 169403], [81, 169823], [87, 170203], [91, 170783], [97, 170963], [102, 171343], [108, 171523], [113, 171843], [120, 172163], [123, 172588], [134, 173013], [138, 173438], [146, 173863], [151, 174083], [154, 174263], [157, 174383]]}, {"verse": 24, "start": 175396, "end": 180543, "text": "Y dijo: De cierto os digo, que ningún profeta es acepto en su tierra.", "words": [[0, 175396], [2, 175599], [8, 176299], [11, 176501], [18, 176821], [21, 177241], [27, 177541], [31, 177756], [38, 178116], [46, 178836], [49, 179016], [56, 179556], [59, 179656], [62, 179816]]}, {"verse": 25, "start": 180893, "end": 193659, "text": "Pero en verdad os digo, que muchas viudas había en Israel en los días de Elías, cuando el cielo fue cerrado por tres años y seis meses, que hubo una gran hambruna en toda la tierra;", "words": [[0, 180893], [5, 181096], [8, 181216], [15, 181476], [18, 181756], [24, 182116], [28, 182356], [35, 182656], [42, 183436], [48, 183836], [51, 184096], [58, 184496], [61, 184976], [65, 185136], [70, 185396], [73, 185616], [80, 186076], [87, 186656], [90, 186916], [96, 187196], [100, 187476], [108, 187976], [112, 188236], [117, 188736], [122, 189156], [124, 189376], [129, 189616], [136, 190520], [140, 190626], [145, 191026], [149, 191166], [154, 191466], [163, 192406], [166, 192586], [171, 192726], [174, 192946]]}, {"verse": 26, "start": 194009, "end": 200103, "text": "Pero a ninguna de ellas fue enviado Elías, sino a Sarepta de Sidón, a una mujer viuda.", "words": [[0, 194009], [5, 194150], [7, 194270], [15, 194517], [18, 194763], [24, 195010], [28, 195190], [36, 195690], [43, 196790], [48, 197210], [50, 197530], [58, 197850], [61, 197990], [68, 198930], [70, 199010], [74, 199150], [80, 199490]]}, {"verse": 27, "start": 200453, "end": 210140, "text": "Y muchos leprosos había en Israel en tiempo del profeta Eliseo; pero ninguno de ellos fue limpio, sino Naamán el sirio.", "words": [[0, 200453], [2, 200599], [9, 200879], [18, 201839], [24, 202279], [27, 202539], [34, 203039], [37, 203479], [44, 203939], [48, 204199], [56, 204918], [64, 205808], [69, 205952], [77, 206452], [80, 206632], [86, 206892], [90, 207152], [98, 208072], [103, 208582], [110, 209092], [113, 209412]]}, {"verse": 28, "start": 210490, "end": 216133, "text": "Entonces todos en la sinagoga fueron llenos de ira, oyendo estas cosas;", "words": [[0, 210490], [9, 211277], [15, 211737], [18, 212177], [21, 212297], [30, 212937], [37, 213257], [44, 213897], [47, 214097], [52, 214637], [59, 215177], [65, 215377]]}, {"verse": 29, "start": 216483, "end": 226381, "text": "Y levantándose, le echaron fuera de la ciudad, y le llevaron hasta la cumbre del monte sobre el cual la ciudad de ellos estaba edificada, para despeñarle.", "words": [[0, 216483], [2, 216604], [16, 218024], [19, 218224], [27, 218624], [33, 218884], [36, 219104], [39, 219224], [47, 219484], [49, 219989], [52, 220109], [61, 220589], [67, 220909], [70, 221089], [77, 221529], [81, 221709], [87, 222009], [93, 222329], [96, 222549], [101, 222769], [104, 223409], [111, 223829], [114, 224049], [120, 224309], [127, 224729], [138, 225509], [143, 225929]]}, {"verse": 30, "start": 226731, "end": 229565, "text": "Pero él, pasando por medio de ellos, se fue.", "words": [[0, 226731], [5, 226896], [9, 227176], [17, 227616], [21, 227976], [27, 228236], [30, 228496], [37, 228796], [40, 229076]]}, {"verse": 31, "start": 229915, "end": 236116, "text": "Y descendió a Capernaum, ciudad de Galilea. Y los enseñaba en los sábados.", "words": [[0, 229915], [2, 230186], [12, 230826], [14, 231426], [25, 232026], [32, 232346], [35, 232666], [44, 233665], [46, 233856], [50, 234086], [59, 234966], [62, 235146], [66, 235266]]}, {"verse": 32, "start": 236466, "end": 241118, "text": "Y se maravillaban de su doctrina, porque su palabra era con autoridad.", "words": [[0, 236466], [2, 236676], [5, 236836], [18, 237616], [21, 237796], [24, 237976], [34, 238576], [41, 238956], [44, 239156], [52, 239636], [56, 240016], [60, 240276]]}, {"verse": 33, "start": 241468, "end": 248886, "text": "Y estaba en la sinagoga un hombre que tenía un espíritu de un demonio inmundo, el cual exclamó a gran voz,", "words": [[0, 241468], [2, 241597], [9, 241997], [12, 242197], [15, 242317], [24, 242997], [27, 243257], [34, 243617], [38, 243837], [44, 244197], [47, 244397], [56, 245037], [59, 245157], [62, 245277], [70, 245757], [79, 246377], [82, 246897], [87, 247467], [95, 248037], [97, 248137], [102, 248317]]}, {"verse": 34, "start": 249236, "end": 256990, "text": "Diciendo: Déjanos, ¿qué tenemos contigo, Jesús nazareno? ¿has venido a destruirnos? Yo te conozco quién eres, el Santo de Dios.", "words": [[0, 249236], [10, 250270], [19, 250715], [24, 250855], [32, 251195], [41, 251755], [47, 251915], [57, 252935], [62, 253105], [69, 253505], [71, 253605], [84, 254670], [87, 254752], [90, 254872], [98, 255312], [104, 255492], [110, 256012], [113, 256072], [119, 256372], [122, 256572]]}, {"verse": 35, "start": 257270, "end": 269210, "text": "Y Jesús le reprendió, diciendo: Enmudece, y sal de él. Entonces el demonio, derribándole en medio, salió de él, y no le hizo daño alguno.", "words": [[0, 257270], [2, 257394], [8, 257774], [11, 258129], [22, 259093], [32, 260181], [42, 261232], [44, 261412], [48, 261672], [51, 261972], [55, 262607], [64, 263159], [67, 263539], [76, 264079], [89, 264859], [92, 265139], [99, 265499], [105, 266339], [108, 266539], [112, 266819], [114, 267459], [117, 267619], [120, 267759], [125, 268059], [130, 268619]]}, {"verse": 36, "start": 269560, "end": 279236, "text": "Y hubo espanto en todos, y hablaban unos a otros, diciendo: ¿Qué palabra es esta, que con autoridad y poder manda a los espíritus inmundos, y salen?", "words": [[0, 269560], [2, 269721], [7, 270021], [15, 270601], [18, 270821], [25, 271301], [27, 271716], [36, 272216], [41, 272536], [43, 272796], [50, 273216], [60, 274553], [65, 274633], [73, 274913], [76, 275193], [82, 275833], [86, 275833], [90, 276013], [100, 276553], [102, 276653], [108, 276893], [114, 277113], [116, 277333], [120, 277453], [130, 277993], [140, 278453], [142, 278753]]}, {"verse": 37, "start": 279516, "end": 284137, "text": "Y la fama de él se divulgaba de todas partes por todos los lugares de la comarca.", "words": [[0, 279516], [2, 279624], [5, 279764], [10, 280124], [13, 280224], [16, 280404], [19, 280564], [29, 281164], [32, 281324], [38, 281484], [45, 281964], [49, 282184], [55, 282464], [59, 282724], [67, 283064], [70, 283284], [73, 283404]]}, {"verse": 38, "start": 284487, "end": 295193, "text": "Y levantándose Jesús de la sinagoga, entró en casa de Simón: y la suegra de Simón estaba con una grande fiebre; y le rogaron por ella.", "words": [[0, 284487], [2, 284989], [15, 285749], [21, 286209], [24, 286629], [27, 286749], [37, 287909], [43, 288349], [46, 288529], [51, 288789], [54, 289049], [61, 289946], [63, 290069], [66, 290189], [73, 290749], [76, 290869], [82, 291409], [89, 291789], [93, 292089], [97, 292289], [104, 292629], [112, 293663], [114, 293798], [117, 293968], [125, 294548], [129, 294728]]}, {"verse": 39, "start": 295543, "end": 304858, "text": "E inclinándose hacia ella, reprendió a la fiebre; y la fiebre la dejó; y ella levantándose luego, les servía.", "words": [[0, 295543], [2, 295703], [15, 296983], [21, 297383], [27, 298183], [37, 298923], [39, 299063], [42, 299123], [50, 299976], [52, 300200], [55, 300320], [62, 300700], [65, 300860], [71, 301616], [73, 301762], [78, 302062], [91, 303162], [98, 303542], [102, 304062]]}, {"verse": 40, "start": 305208, "end": 316542, "text": "Y poniéndose el sol, todos los que tenían enfermos de diversas enfermedades, los traían a él; y él, poniendo las manos sobre cada uno de ellos, los sanaba.", "words": [[0, 305208], [2, 305336], [13, 306016], [16, 306196], [21, 306856], [27, 307176], [31, 307476], [35, 307616], [42, 307956], [51, 308636], [54, 308756], [63, 309296], [77, 310556], [81, 310796], [88, 311356], [90, 311496], [94, 312161], [96, 312348], [100, 312908], [109, 313308], [113, 313488], [119, 313848], [125, 314208], [130, 314488], [134, 314848], [137, 315048], [144, 315428], [148, 315808]]}, {"verse": 41, "start": 316892, "end": 329384, "text": "Y salían también demonios de muchos, dando voces, y diciendo: Tú eres el Hijo de Dios. Pero reprendiéndolos no les dejaba hablar; porque sabían que él era el Cristo.", "words": [[0, 316892], [2, 317016], [9, 317496], [17, 317836], [26, 318476], [29, 318596], [37, 319336], [43, 319656], [50, 320356], [52, 320816], [62, 321793], [65, 321910], [70, 322150], [73, 322350], [78, 322550], [81, 322690], [87, 323756], [92, 324453], [108, 325183], [111, 325643], [115, 325863], [122, 326303], [130, 327162], [137, 327346], [144, 327806], [148, 328006], [151, 328226], [155, 328427], [158, 328626]]}, {"verse": 42, "start": 329734, "end": 340284, "text": "Y siendo ya de día salió, y se fue a un lugar desierto: y la gente lo buscaba y acudía a él; y le detenían para que no se apartase de ellos.", "words": [[0, 329734], [2, 329858], [9, 330198], [12, 330478], [15, 330638], [19, 330918], [26, 332058], [28, 332178], [31, 332278], [35, 332498], [37, 332638], [40, 332738], [46, 333078], [56, 334343], [58, 334467], [61, 334567], [67, 334847], [70, 335087], [78, 335627], [80, 335767], [87, 336307], [89, 336527], [93, 337251], [95, 337395], [98, 337515], [107, 338095], [112, 338355], [116, 338515], [119, 338655], [122, 338835], [131, 339455], [134, 339655]]}, {"verse": 43, "start": 340634, "end": 349629, "text": "Pero él les dijo: Que también a otras ciudades es necesario que anuncie el evangelio del reino de Dios; porque para esto soy enviado.", "words": [[0, 340634], [5, 340776], [8, 340996], [12, 341116], [18, 341856], [22, 341941], [30, 342241], [32, 342501], [38, 342701], [47, 343341], [50, 343561], [60, 344461], [64, 344721], [72, 345581], [75, 345841], [85, 346501], [89, 346701], [95, 347101], [98, 347261], [104, 347889], [111, 348092], [116, 348392], [121, 348612], [125, 348892]]}, {"verse": 44, "start": 349979, "end": 352484, "text": "Y predicaba en las sinagogas de Galilea.", "words": [[0, 349979], [2, 350089], [12, 350709], [15, 350869], [19, 350989], [29, 351589], [32, 351669]]}]}