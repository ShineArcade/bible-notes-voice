{"book": "ACT", "chapter": 26, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 273957, "verses": [{"verse": 1, "start": 300, "end": 11166, "text": "Entonces Agripa dijo a Pablo: Se te permite hablar por ti mismo. Pablo entonces, extendiendo la mano, comenzó a responder por sí, diciendo:", "words": [[0, 300], [9, 859], [16, 1862], [21, 2134], [23, 2374], [30, 3045], [33, 3149], [36, 3269], [44, 3609], [51, 3889], [55, 4169], [58, 4329], [65, 5067], [71, 5463], [81, 6363], [93, 7263], [96, 7423], [102, 8123], [110, 8843], [112, 9003], [122, 9503], [126, 9823], [130, 10143]]}, {"verse": 2, "start": 11366, "end": 19556, "text": "Acerca de todas las cosas de que soy acusado por los judíos, oh rey Agripa, me tengo por dichoso de que haya hoy de defenderme delante de ti;", "words": [[0, 11366], [7, 11703], [10, 11943], [16, 12123], [20, 12443], [26, 12763], [29, 13003], [33, 13123], [37, 13303], [45, 13863], [49, 14083], [53, 14223], [61, 14603], [64, 14983], [68, 15283], [76, 16143], [79, 16263], [85, 16523], [89, 16763], [97, 17183], [100, 17383], [104, 17543], [109, 17743], [113, 18003], [116, 18103], [127, 18703], [135, 19103], [138, 19243]]}, {"verse": 3, "start": 19906, "end": 27161, "text": "Especialmente sabiendo tú todas las costumbres y cuestiones que hay entre los judíos: por lo cual te ruego que me oigas con paciencia.", "words": [[0, 19906], [14, 20412], [23, 21192], [26, 21432], [32, 21672], [36, 21952], [47, 22572], [49, 22692], [60, 23192], [64, 23412], [68, 23572], [74, 23772], [78, 23932], [86, 24750], [90, 24850], [93, 24950], [98, 25170], [101, 25350], [107, 25650], [111, 25810], [114, 25950], [120, 26290], [124, 26450]]}, {"verse": 4, "start": 27511, "end": 35213, "text": "Mi vida pues desde la juventud, la cual desde el principio fue en mi nación, en Jerusalén, todos los judíos la saben:", "words": [[0, 27511], [3, 27645], [8, 27865], [13, 28505], [19, 28625], [22, 28865], [32, 29845], [35, 29985], [40, 30225], [46, 30445], [49, 30625], [59, 31125], [63, 31545], [66, 31912], [69, 32278], [77, 32645], [80, 32725], [91, 33705], [97, 33865], [101, 34065], [108, 34565], [111, 34685]]}, {"verse": 5, "start": 35563, "end": 44567, "text": "Los cuales tienen ya conocido que yo desde el principio, si quieren testificarlo, conforme a la más rigurosa secta de nuestra religión he vivido fariseo.", "words": [[0, 35748], [4, 35948], [11, 36108], [18, 36408], [21, 36608], [30, 37148], [34, 37308], [37, 37488], [43, 37708], [46, 37948], [57, 38928], [60, 39088], [68, 39328], [82, 40528], [91, 41008], [93, 41088], [96, 41168], [100, 41555], [109, 41941], [115, 42328], [118, 42428], [126, 42588], [135, 43351], [138, 43453], [145, 43853]]}, {"verse": 6, "start": 44917, "end": 50516, "text": "Y ahora, por la esperanza de la promesa que hizo Dios a nuestros padres, soy llamado en juicio;", "words": [[0, 44917], [2, 45018], [9, 45238], [13, 45478], [16, 45618], [26, 46118], [29, 46238], [32, 46358], [40, 46858], [44, 47058], [49, 47418], [54, 47738], [56, 47918], [65, 48078], [73, 49118], [77, 49398], [85, 49738], [88, 49998]]}, {"verse": 7, "start": 50866, "end": 61936, "text": "A la cual promesa nuestras doce tribus, sirviendo constantemente de día y de noche, esperan que han de llegar. Por la cual esperanza, oh rey Agripa, soy acusado de los judíos.", "words": [[0, 50866], [2, 50963], [5, 51043], [10, 51223], [18, 51803], [27, 52023], [32, 52563], [40, 53243], [50, 53863], [65, 54723], [68, 54883], [72, 55103], [74, 55203], [77, 55283], [84, 56023], [92, 56503], [96, 56650], [100, 56796], [103, 56943], [111, 57622], [115, 57726], [118, 57866], [123, 58026], [134, 58486], [137, 58946], [141, 59406], [149, 60126], [153, 60406], [161, 61006], [164, 61126], [168, 61246]]}, {"verse": 8, "start": 62286, "end": 67055, "text": "¡Qué! ¿Se juzga cosa increíble entre vosotros que Dios resucite los muertos?", "words": [[0, 62286], [6, 62984], [10, 63104], [16, 63464], [21, 63724], [31, 64544], [37, 64724], [46, 65404], [50, 65464], [55, 65684], [64, 66184], [68, 66324]]}, {"verse": 9, "start": 67405, "end": 72042, "text": "Yo ciertamente había pensado deber hacer muchas cosas contra el nombre de Jesús de Nazaret:", "words": [[0, 67405], [3, 67527], [15, 68087], [21, 68307], [29, 68727], [35, 69147], [41, 69387], [48, 69667], [54, 70107], [61, 70487], [64, 70607], [71, 70867], [74, 71027], [80, 71267], [83, 71507]]}, {"verse": 10, "start": 72392, "end": 83050, "text": "Lo cual también hice en Jerusalén, y yo encerré en cárceles a muchos de los santos, recibida potestad de los principales sacerdotes; y cuando eran matados, yo di mi voto.", "words": [[0, 72392], [3, 72520], [8, 72760], [16, 73100], [21, 73480], [24, 73640], [35, 74740], [37, 74800], [40, 74980], [48, 75460], [51, 75560], [60, 76180], [62, 76260], [69, 76520], [72, 76740], [76, 76880], [84, 77640], [93, 78140], [102, 78740], [105, 78860], [109, 78980], [121, 79700], [133, 80640], [135, 80743], [142, 80983], [147, 81323], [156, 82143], [159, 82363], [162, 82483], [165, 82623]]}, {"verse": 11, "start": 83400, "end": 93553, "text": "Y muchas veces, castigándolos por todas las sinagogas, los forcé a blasfemar; y enfurecido sobremanera contra ellos, los perseguí hasta en las ciudades extranjeras.", "words": [[0, 83400], [2, 83510], [9, 83730], [16, 84050], [30, 85030], [34, 85190], [40, 85470], [44, 85730], [55, 86830], [59, 86930], [65, 87410], [67, 87550], [78, 88590], [80, 88690], [91, 89260], [103, 89830], [110, 90250], [117, 90990], [121, 91360], [130, 91730], [136, 91910], [139, 92050], [143, 92150], [152, 92630]]}, {"verse": 12, "start": 93903, "end": 100439, "text": "En lo cual ocupado, yendo a Damasco con potestad y comisión de los principales sacerdotes,", "words": [[0, 93903], [3, 94047], [6, 94167], [11, 94647], [20, 95547], [26, 96027], [28, 96167], [36, 96667], [40, 96887], [49, 97487], [51, 97587], [60, 98067], [63, 98267], [67, 98387], [79, 99107]]}, {"verse": 13, "start": 100789, "end": 109129, "text": "En mitad del día, oh rey, vi en el camino una luz del cielo, que superaba el resplandor del sol, la cual me rodeó y a los que iban conmigo.", "words": [[0, 100789], [3, 100912], [9, 101172], [13, 101432], [18, 101682], [21, 101932], [26, 102572], [29, 102772], [32, 102892], [35, 102992], [42, 103292], [46, 103572], [50, 103792], [54, 103972], [61, 104392], [65, 104852], [74, 105372], [77, 105492], [88, 106052], [92, 106192], [97, 106812], [100, 106992], [105, 107152], [108, 107352], [114, 107792], [116, 107912], [118, 107992], [122, 108132], [126, 108252], [131, 108492]]}, {"verse": 14, "start": 109479, "end": 123264, "text": "Y habiendo caído todos nosotros en tierra, oí una voz que me hablaba, y decía en lengua hebrea: Saulo, Saulo, ¿por qué me persigues? Dura cosa te es dar coces contra los aguijones.", "words": [[0, 109479], [2, 109597], [11, 109977], [17, 110397], [23, 110657], [32, 111237], [35, 111517], [43, 112237], [46, 112637], [50, 112817], [54, 113057], [58, 113237], [61, 113357], [70, 113837], [72, 114237], [78, 114637], [81, 114857], [88, 115217], [96, 116017], [103, 116722], [110, 117682], [115, 117802], [119, 118002], [122, 118182], [133, 119421], [138, 119810], [143, 120210], [146, 120590], [149, 120770], [153, 121050], [159, 121330], [166, 121890], [170, 122170]]}, {"verse": 15, "start": 123484, "end": 131028, "text": "Yo entonces dije: ¿Quién eres, Señor? Y el Señor dijo: Yo soy Jesús, a quien tú persigues.", "words": [[0, 123484], [3, 123704], [12, 124024], [18, 124904], [25, 125128], [31, 125268], [38, 126064], [40, 126150], [43, 126250], [49, 126490], [55, 128160], [58, 128368], [62, 128648], [69, 129508], [71, 129608], [77, 129768], [80, 130088]]}, {"verse": 16, "start": 131378, "end": 143008, "text": "Pero levántate, y ponte sobre tus pies; porque para esto te he aparecido, para ponerte por ministro y testigo de las cosas que has visto, y de aquellas en que apareceré a ti:", "words": [[0, 131378], [5, 131542], [16, 132302], [18, 132482], [24, 133022], [30, 133302], [34, 133542], [40, 134324], [47, 134587], [52, 134927], [57, 135307], [60, 135647], [63, 135807], [74, 137087], [79, 137427], [87, 137947], [91, 138167], [100, 138827], [102, 138927], [110, 139447], [113, 139567], [117, 139707], [123, 139967], [127, 140187], [131, 140267], [138, 140627], [140, 141052], [143, 141192], [152, 141632], [155, 141792], [159, 141912], [169, 142572], [171, 142632]]}, {"verse": 17, "start": 143358, "end": 147704, "text": "Librándote del pueblo y de los Gentiles, a los cuales ahora te envío,", "words": [[0, 143358], [11, 144081], [15, 144301], [22, 144661], [24, 144861], [27, 144961], [31, 145081], [41, 145741], [43, 146056], [47, 146176], [54, 146396], [60, 146796], [63, 147036]]}, {"verse": 18, "start": 148054, "end": 163828, "text": "Para que abras sus ojos, para que se conviertan de las tinieblas a la luz, y de la potestad de Satanás a Dios; para que reciban, por la fe que es en mí, perdón de pecados y herencia entre los santificados.", "words": [[0, 148054], [5, 148224], [9, 148484], [15, 148744], [19, 149104], [25, 150104], [30, 150424], [34, 150564], [37, 150704], [48, 151484], [51, 151624], [55, 151824], [65, 152604], [67, 152764], [70, 152844], [75, 153124], [77, 153744], [80, 153844], [83, 153964], [92, 154744], [95, 154904], [103, 155604], [105, 155804], [111, 156606], [116, 156793], [120, 156993], [129, 157713], [133, 158013], [136, 158213], [139, 158433], [143, 158633], [146, 158873], [149, 159053], [153, 159313], [160, 160293], [163, 160413], [171, 161053], [173, 161273], [182, 161813], [188, 162353], [192, 162593]]}, {"verse": 19, "start": 164048, "end": 168422, "text": "Por lo cual, oh rey Agripa, no fui rebelde a la visión celestial:", "words": [[0, 164048], [4, 164171], [7, 164271], [13, 164731], [16, 164951], [20, 165291], [28, 166071], [31, 166291], [35, 166544], [43, 166798], [45, 167051], [48, 167171], [55, 167571]]}, {"verse": 20, "start": 168772, "end": 180107, "text": "Más bien, anuncié primeramente a los que están en Damasco, y Jerusalén, y por toda la tierra de Judea, y a los Gentiles, que se arrepintiesen y se convirtiesen a Dios, haciendo obras dignas de arrepentimiento.", "words": [[0, 168772], [4, 168950], [10, 169110], [18, 169630], [31, 170270], [33, 170350], [37, 170470], [41, 170610], [47, 170830], [50, 170950], [59, 171490], [61, 171650], [72, 172390], [74, 172610], [78, 172810], [83, 173050], [86, 173230], [93, 173450], [96, 173670], [103, 174170], [105, 174330], [107, 174390], [111, 174510], [121, 175511], [125, 175596], [128, 175756], [142, 176516], [144, 176636], [147, 176736], [160, 177336], [162, 177476], [168, 177716], [177, 178181], [183, 178561], [190, 179081], [193, 179181]]}, {"verse": 21, "start": 180457, "end": 184623, "text": "Por causa de esto los judíos, tomándome en el templo, intentaron matarme.", "words": [[0, 180457], [4, 180560], [10, 180780], [13, 181020], [18, 181260], [22, 181360], [30, 181880], [40, 182400], [43, 182500], [46, 182620], [54, 183340], [65, 183960]]}, {"verse": 22, "start": 184973, "end": 196398, "text": "Pero ayudado del auxilio de Dios, persevero hasta el día de hoy, dando testimonio a pequeños y a grandes, no diciendo nada fuera de las cosas que los profetas y Moisés dijeron que habían de venir:", "words": [[0, 184973], [5, 185113], [13, 185613], [17, 185753], [25, 186273], [28, 186373], [34, 187073], [44, 187693], [50, 187853], [53, 187993], [57, 188153], [60, 188293], [65, 188993], [71, 189233], [82, 189913], [84, 189973], [93, 190513], [95, 190633], [97, 190713], [106, 191504], [109, 191682], [118, 192022], [123, 192362], [129, 192682], [132, 192862], [136, 193002], [142, 193342], [146, 193582], [150, 193722], [159, 194282], [161, 194462], [168, 194802], [176, 195402], [180, 195542], [187, 195802], [190, 195962]]}, {"verse": 23, "start": 196748, "end": 204579, "text": "Que Cristo había de padecer, y ser el primero de la resurrección de los muertos, para anunciar luz al pueblo y a los Gentiles.", "words": [[0, 196748], [4, 196859], [11, 197219], [17, 197439], [20, 197619], [29, 198239], [31, 198479], [35, 198699], [38, 198839], [46, 199159], [49, 199379], [52, 199499], [65, 200239], [68, 200359], [72, 200459], [81, 200959], [86, 201352], [95, 201746], [99, 202139], [102, 202379], [109, 202739], [111, 203059], [113, 203139], [117, 203259]]}, {"verse": 24, "start": 204859, "end": 213992, "text": "Y diciendo él estas cosas en su defensa, Festo a gran voz dijo: Estás loco, Pablo: el mucho estudio te vuelve loco.", "words": [[0, 204859], [2, 205001], [11, 205481], [14, 205941], [20, 206401], [26, 206941], [29, 207381], [32, 207641], [41, 208661], [47, 209201], [49, 209521], [54, 209871], [58, 210221], [64, 211102], [70, 211398], [76, 211678], [83, 212342], [86, 212459], [92, 212679], [100, 213039], [103, 213239], [110, 213559]]}, {"verse": 25, "start": 214272, "end": 220072, "text": "Pero él dijo: No estoy loco, excelentísimo Festo, sino que hablo palabras de verdad y de cordura.", "words": [[0, 214272], [5, 214458], [8, 214698], [14, 215457], [17, 215583], [23, 215843], [29, 216223], [43, 217003], [50, 217883], [55, 218023], [59, 218183], [65, 218423], [74, 218663], [77, 218943], [84, 219163], [86, 219383], [89, 219483]]}, {"verse": 26, "start": 220422, "end": 228636, "text": "Pues el rey sabe estas cosas, delante del cual también hablo confiadamente. Pues no pienso que ignora nada de esto; pues no ha sido esto hecho en algún rincón.", "words": [[0, 220422], [5, 220535], [8, 220695], [12, 220955], [17, 221075], [23, 221275], [30, 221935], [38, 222255], [42, 222415], [47, 222595], [55, 222875], [61, 223275], [76, 224392], [81, 224480], [84, 224620], [91, 224940], [95, 225060], [102, 225360], [107, 225580], [110, 225780], [116, 226356], [121, 226471], [124, 226691], [127, 226831], [132, 227031], [137, 227371], [143, 227691], [146, 227831], [152, 228031]]}, {"verse": 27, "start": 228986, "end": 232279, "text": "¿Crees, rey Agripa, a los profetas? Yo sé que crees.", "words": [[0, 229088], [8, 229228], [12, 229548], [20, 229968], [22, 230148], [26, 230248], [36, 231232], [39, 231398], [42, 231558], [46, 231678]]}, {"verse": 28, "start": 232559, "end": 237356, "text": "Entonces Agripa dijo a Pablo: Por poco me persuades a ser Cristiano.", "words": [[0, 232559], [9, 233119], [16, 234122], [21, 234394], [23, 234634], [30, 235304], [34, 235429], [39, 235649], [42, 235849], [52, 236329], [54, 236489], [58, 236629]]}, {"verse": 29, "start": 237636, "end": 248368, "text": "Y Pablo dijo: ¡Quisiera Dios que por poco o por mucho, no solamente tú, sino también todos los que hoy me oyen, fueseis hechos tales cual yo soy, excepto estas cadenas!", "words": [[0, 237636], [2, 237780], [8, 238120], [14, 238868], [24, 239201], [29, 239441], [33, 239641], [37, 239881], [42, 240111], [44, 240341], [48, 240481], [55, 241341], [58, 241441], [68, 241801], [72, 242641], [77, 242821], [85, 243241], [91, 243501], [95, 243741], [99, 243941], [103, 244041], [106, 244201], [112, 244901], [120, 245361], [127, 245741], [133, 245941], [138, 246261], [141, 246441], [146, 246981], [154, 247461], [160, 247621]]}, {"verse": 30, "start": 248648, "end": 257271, "text": "Y cuando hubo dicho estas cosas, se levantó el rey, y el gobernador, y Bernice, y los que se habían sentado con ellos;", "words": [[0, 248648], [2, 248769], [9, 249029], [14, 249489], [20, 249729], [26, 249989], [33, 250989], [36, 251209], [44, 251749], [47, 251869], [52, 252449], [54, 252609], [57, 252729], [69, 253489], [71, 253949], [80, 254569], [82, 255049], [86, 255189], [90, 255329], [93, 255489], [100, 255789], [108, 256409], [112, 256649]]}, {"verse": 31, "start": 257621, "end": 267592, "text": "Y como se retiraron aparte, hablaban los unos a los otros, diciendo: Ninguna cosa digna ni de muerte, ni de prisión, hace este hombre.", "words": [[0, 257621], [2, 257723], [7, 257963], [10, 258143], [20, 258763], [28, 259883], [37, 260363], [41, 260503], [46, 260783], [48, 261003], [52, 261163], [59, 261943], [69, 262836], [77, 263235], [82, 263515], [88, 264035], [91, 264195], [94, 264335], [102, 264775], [105, 265255], [108, 265375], [117, 266035], [122, 266675], [127, 267075]]}, {"verse": 32, "start": 267872, "end": 273557, "text": "Y Agripa dijo a Festo: Podía este hombre ser suelto, si no hubiera apelado a César.", "words": [[0, 267872], [2, 268041], [9, 268541], [14, 268941], [16, 269161], [23, 269913], [29, 270181], [34, 270501], [41, 270761], [45, 271021], [53, 271801], [56, 272041], [59, 272201], [67, 272501], [75, 272941], [77, 273061]]}]}