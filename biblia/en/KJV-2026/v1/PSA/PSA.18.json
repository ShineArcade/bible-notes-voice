{"book": "PSA", "chapter": 18, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 311301, "verses": [{"verse": 1, "start": 300, "end": 2944, "text": "I will love you, O LORD, my strength.", "words": [[0, 300], [2, 480], [7, 660], [12, 940], [17, 1180], [19, 1300], [25, 2060], [28, 2180]]}, {"verse": 2, "start": 3394, "end": 14917, "text": "The LORD is my rock, and my fortress, and my deliverer; my God, my strength, in whom I will trust; my buckler, and the horn of my salvation, and my high tower.", "words": [[0, 3394], [4, 3503], [9, 3763], [12, 3963], [15, 4163], [21, 4583], [25, 5183], [28, 5363], [38, 6023], [42, 6483], [45, 6663], [56, 7716], [59, 7882], [64, 8642], [67, 8762], [77, 9402], [80, 9682], [85, 9842], [87, 10022], [92, 10162], [99, 11064], [102, 11215], [111, 11545], [115, 11875], [119, 11995], [124, 12195], [127, 12355], [130, 12535], [141, 13735], [145, 13815], [148, 14015], [153, 14275]]}, {"verse": 3, "start": 15367, "end": 21314, "text": "I will call upon the LORD, who is worthy to be praised: so shall I be saved from my enemies.", "words": [[0, 15367], [2, 15510], [7, 15670], [12, 15930], [17, 16230], [21, 16490], [27, 16790], [31, 17090], [34, 17230], [41, 17550], [44, 17770], [47, 17910], [56, 18903], [59, 19105], [65, 19305], [67, 19525], [70, 19665], [76, 20065], [81, 20365], [84, 20565]]}, {"verse": 4, "start": 21764, "end": 26746, "text": "The sorrows of death compassed me, and the floods of ungodly men made me afraid.", "words": [[0, 21764], [4, 21864], [12, 22344], [15, 22424], [21, 22704], [31, 23304], [35, 23764], [39, 23904], [43, 24004], [50, 24384], [53, 24644], [61, 25344], [65, 25644], [70, 25884], [73, 26104]]}, {"verse": 5, "start": 27196, "end": 31803, "text": "The sorrows of hell compassed me about: the snares of death confronted me.", "words": [[0, 27196], [4, 27304], [12, 27784], [15, 27904], [20, 28144], [30, 28804], [33, 28864], [40, 29976], [44, 30210], [51, 30443], [54, 30583], [60, 30863], [71, 31323]]}, {"verse": 6, "start": 32253, "end": 42044, "text": "In my distress I called upon the LORD, and cried to my God: he heard my voice out of his temple, and my cry came before him, even into his ears.", "words": [[0, 32253], [3, 32402], [6, 32602], [15, 33002], [17, 33362], [24, 33642], [29, 33962], [33, 34202], [39, 34482], [43, 34682], [49, 35062], [52, 35282], [55, 35502], [60, 36325], [63, 36455], [69, 36695], [72, 36895], [78, 37235], [82, 37535], [85, 37655], [89, 37795], [97, 38515], [101, 38715], [104, 38915], [108, 39275], [113, 39635], [120, 40015], [125, 40635], [130, 40895], [135, 41235], [139, 41495]]}, {"verse": 7, "start": 42494, "end": 50388, "text": "Then the earth shook and trembled; the foundations also of the hills moved and were shaken, because he was angry.", "words": [[0, 42494], [5, 42746], [9, 42966], [15, 43206], [21, 43586], [25, 43866], [35, 44805], [39, 44906], [51, 45486], [56, 46046], [59, 46306], [63, 46466], [69, 46726], [75, 47266], [79, 47526], [84, 47706], [92, 48126], [100, 48866], [103, 49066], [107, 49246]]}, {"verse": 8, "start": 50838, "end": 56668, "text": "There went up a smoke out of his nostrils, and fire out of his mouth devoured: coals were kindled by it.", "words": [[0, 50838], [6, 51007], [11, 51177], [14, 51317], [16, 51397], [22, 51737], [26, 51957], [29, 52057], [33, 52157], [43, 52977], [47, 53217], [52, 53537], [56, 53777], [59, 53877], [63, 53977], [69, 54237], [79, 55239], [85, 55644], [90, 55764], [98, 56184], [101, 56424]]}, {"verse": 9, "start": 57118, "end": 61850, "text": "He bowed the heavens also, and came down: and darkness was under his feet.", "words": [[0, 57118], [3, 57205], [9, 57645], [13, 57765], [21, 58005], [27, 58485], [31, 59005], [36, 59225], [42, 60136], [46, 60283], [55, 60643], [59, 60883], [65, 61123], [69, 61363]]}, {"verse": 10, "start": 62300, "end": 67944, "text": "And he rode upon a cherub, and did fly: yes, he did fly upon the wings of the wind.", "words": [[0, 62300], [4, 62444], [7, 62584], [12, 62824], [17, 63144], [19, 63444], [27, 63744], [31, 64164], [35, 64384], [40, 65337], [45, 65881], [48, 65961], [52, 66161], [56, 66421], [61, 66701], [65, 66901], [71, 67161], [74, 67361], [78, 67481]]}, {"verse": 11, "start": 68394, "end": 75629, "text": "He made darkness his secret place; his pavilion round about him were dark waters and thick clouds of the skies.", "words": [[0, 68394], [3, 68484], [8, 68664], [17, 69104], [21, 69404], [28, 69764], [35, 70742], [39, 70854], [48, 71414], [54, 71774], [60, 72154], [64, 72454], [69, 72654], [74, 73014], [81, 73474], [85, 73754], [91, 74034], [98, 74534], [101, 74734], [105, 74874]]}, {"verse": 12, "start": 76079, "end": 81506, "text": "At the brightness that was before him his thick clouds passed, hail stones and coals of fire.", "words": [[0, 76079], [3, 76189], [7, 76309], [18, 76629], [23, 76949], [27, 77109], [34, 77449], [38, 77909], [42, 77989], [48, 78269], [55, 78749], [63, 79529], [68, 79729], [75, 80089], [79, 80389], [85, 80809], [88, 80929]]}, {"verse": 13, "start": 81956, "end": 89015, "text": "The LORD also thundered in the heavens, and the Highest gave his voice; hail stones and coals of fire.", "words": [[0, 81956], [4, 82083], [9, 82423], [14, 82863], [24, 83483], [27, 83603], [31, 83723], [40, 84623], [44, 84723], [48, 84863], [56, 85183], [61, 85523], [65, 85743], [72, 86683], [77, 86943], [84, 87383], [88, 87783], [94, 88263], [97, 88383]]}, {"verse": 14, "start": 89465, "end": 95858, "text": "Yes, he sent out his arrows, and scattered them; and he shot out lightnings, and discomfited them.", "words": [[0, 89465], [5, 90066], [8, 90166], [13, 90426], [17, 90626], [21, 90846], [29, 91186], [33, 91566], [43, 91926], [49, 92718], [53, 92852], [56, 92952], [61, 93272], [65, 93432], [77, 94172], [81, 94582], [93, 94992]]}, {"verse": 15, "start": 96308, "end": 104678, "text": "Then the channels of waters were seen, and the foundations of the world were discovered at your rebuke, O LORD, at the blast of the breath of your nostrils.", "words": [[0, 96308], [5, 96495], [9, 96615], [18, 96955], [21, 97235], [28, 97555], [33, 97815], [39, 98455], [43, 98615], [47, 98735], [59, 99195], [62, 99515], [66, 99635], [72, 99955], [77, 100115], [88, 100555], [91, 100795], [96, 100935], [104, 101615], [106, 101795], [112, 102415], [115, 102555], [119, 102675], [125, 102995], [128, 103215], [132, 103335], [139, 103575], [142, 103755], [147, 103875]]}, {"verse": 16, "start": 105128, "end": 108932, "text": "He sent from above, he took me, he drew me out of many waters.", "words": [[0, 105128], [3, 105209], [8, 105449], [13, 105629], [20, 106389], [23, 106589], [28, 106829], [32, 107269], [35, 107369], [40, 107589], [43, 107749], [47, 107909], [50, 108009], [55, 108229]]}, {"verse": 17, "start": 109382, "end": 114505, "text": "He delivered me from my strong enemy, and from them which hated me: for they were too strong for me.", "words": [[0, 109382], [3, 109470], [13, 109790], [16, 110050], [21, 110250], [24, 110430], [31, 110710], [38, 111110], [42, 111510], [47, 111710], [52, 111890], [58, 112150], [64, 112390], [68, 113082], [72, 113168], [77, 113288], [82, 113428], [86, 113628], [93, 114008], [97, 114248]]}, {"verse": 18, "start": 114955, "end": 119207, "text": "They confronted me in the day of my calamity: but the LORD was my stay.", "words": [[0, 114955], [5, 115063], [16, 115523], [19, 115863], [22, 116023], [26, 116123], [30, 116343], [33, 116463], [36, 116643], [46, 117682], [50, 117789], [54, 117909], [59, 118169], [63, 118409], [66, 118629]]}, {"verse": 19, "start": 119657, "end": 126255, "text": "He brought me forth also into a large place; he delivered me, because he delighted in me.", "words": [[0, 119657], [3, 119757], [11, 119977], [14, 120177], [20, 120477], [25, 120957], [30, 121237], [32, 121457], [38, 121697], [45, 122693], [48, 122893], [58, 123233], [62, 123573], [70, 124073], [73, 124293], [83, 124693], [86, 124933]]}, {"verse": 20, "start": 126705, "end": 133637, "text": "The LORD rewarded me according to my righteousness; according to the cleanness of my hands has he recompensed me.", "words": [[0, 126705], [4, 126845], [9, 127185], [18, 127745], [21, 128005], [31, 128385], [34, 128665], [37, 128825], [52, 130035], [62, 130341], [65, 130601], [69, 130701], [79, 131241], [82, 131401], [85, 131601], [91, 132141], [95, 132341], [98, 132541], [110, 133261]]}, {"verse": 21, "start": 134087, "end": 139246, "text": "For I have kept the ways of the LORD, and have not wickedly departed from my God.", "words": [[0, 134156], [4, 134236], [6, 134416], [11, 134616], [16, 134936], [20, 135236], [25, 135516], [28, 135736], [32, 135876], [38, 136216], [42, 136776], [47, 136956], [51, 137156], [60, 137736], [69, 138136], [74, 138436], [77, 138696]]}, {"verse": 22, "start": 139696, "end": 144714, "text": "For all his judgments were before me, and I did not put away his statutes from me.", "words": [[0, 139696], [4, 139844], [8, 140144], [12, 140344], [22, 140804], [27, 141124], [34, 141464], [38, 141964], [42, 142304], [44, 142444], [48, 142604], [52, 142784], [56, 143044], [61, 143304], [65, 143484], [74, 144084], [79, 144324]]}, {"verse": 23, "start": 145164, "end": 149802, "text": "I was also upright before him, and I kept myself from my iniquity.", "words": [[0, 145164], [2, 145320], [6, 145520], [11, 145960], [19, 146420], [26, 146960], [31, 147680], [35, 147840], [37, 147980], [42, 148160], [49, 148620], [54, 148860], [57, 149100]]}, {"verse": 24, "start": 150252, "end": 157295, "text": "Therefore has the LORD recompensed me according to my righteousness, according to the cleanness of my hands in his eyesight.", "words": [[0, 150252], [10, 150581], [14, 150921], [18, 151141], [23, 151421], [35, 152221], [38, 152381], [48, 152721], [51, 153001], [54, 153161], [69, 154261], [79, 154601], [82, 154881], [86, 155001], [96, 155541], [99, 155681], [102, 155901], [108, 156261], [111, 156461], [115, 156621]]}, {"verse": 25, "start": 157745, "end": 163645, "text": "With the merciful you will show yourself merciful; with an upright man you will show yourself upright;", "words": [[0, 157745], [5, 157896], [9, 158056], [18, 158736], [22, 158816], [27, 158956], [32, 159216], [41, 159736], [51, 160847], [56, 160994], [59, 161154], [67, 161474], [71, 162074], [75, 162154], [80, 162294], [85, 162534], [94, 162974]]}, {"verse": 26, "start": 164095, "end": 169633, "text": "With the pure you will show yourself pure; and with the perverse you will show yourself perverse.", "words": [[0, 164095], [5, 164455], [9, 164615], [14, 164915], [18, 165115], [23, 165255], [28, 165475], [37, 165935], [43, 166875], [47, 167002], [52, 167162], [56, 167302], [65, 167762], [69, 168002], [74, 168102], [79, 168322], [88, 168762]]}, {"verse": 27, "start": 170083, "end": 173909, "text": "For you will save the afflicted people; but will bring down high looks.", "words": [[0, 170083], [4, 170181], [8, 170381], [13, 170541], [18, 170861], [22, 171081], [32, 171541], [40, 172325], [44, 172435], [49, 172575], [55, 172835], [60, 173075], [65, 173355]]}, {"verse": 28, "start": 174359, "end": 178417, "text": "For you will light my lamp: the LORD my God will enlighten my darkness.", "words": [[0, 174359], [4, 174486], [8, 174686], [13, 174886], [19, 175046], [22, 175246], [28, 175993], [32, 176092], [37, 176292], [40, 176512], [44, 176832], [49, 177092], [59, 177572], [62, 177692]]}, {"verse": 29, "start": 178867, "end": 184361, "text": "For by you I have run through a troop; and by my God have I leaped over a wall.", "words": [[0, 178867], [4, 178999], [7, 179219], [11, 179539], [13, 179819], [18, 180039], [22, 180259], [30, 180499], [32, 180659], [39, 181526], [43, 181669], [46, 181869], [49, 182069], [53, 182509], [58, 182829], [60, 182989], [67, 183329], [72, 183569], [74, 183769]]}, {"verse": 30, "start": 184811, "end": 191910, "text": "As for God, his way is perfect: the word of the LORD is tried: he is a buckler to all those that trust in him.", "words": [[0, 184811], [3, 185014], [7, 185234], [12, 185734], [16, 185834], [20, 186114], [23, 186294], [32, 187349], [36, 187475], [41, 187715], [44, 187855], [48, 187995], [53, 188315], [56, 188515], [63, 189503], [66, 189597], [69, 189737], [71, 189817], [79, 190297], [82, 190477], [86, 190677], [92, 190877], [97, 191077], [103, 191357], [106, 191597]]}, {"verse": 31, "start": 192360, "end": 196428, "text": "For who is God save the LORD? or who is a rock save our God?", "words": [[0, 192360], [4, 192486], [8, 192646], [11, 192826], [15, 193126], [20, 193486], [24, 193706], [30, 194487], [33, 194611], [37, 194771], [40, 194951], [42, 195051], [47, 195371], [52, 195611], [56, 195831]]}, {"verse": 32, "start": 196878, "end": 200972, "text": "It is God that girds me with strength, and makes my way perfect.", "words": [[0, 196878], [3, 197018], [6, 197158], [10, 197458], [15, 197718], [21, 198198], [24, 198318], [29, 198518], [39, 198958], [43, 199658], [49, 199898], [52, 200138], [56, 200318]]}, {"verse": 33, "start": 201422, "end": 205647, "text": "He makes my feet like hinds’ feet, and sets me upon my high places.", "words": [[0, 201422], [3, 201515], [9, 201755], [12, 201995], [17, 202295], [22, 202665], [29, 203035], [35, 203275], [39, 203735], [44, 203955], [47, 204195], [52, 204415], [55, 204675], [60, 204895]]}, {"verse": 34, "start": 206097, "end": 211290, "text": "He teaches my hands to war, so that a bow of steel is broken by my arms.", "words": [[0, 206097], [3, 206198], [11, 206518], [14, 206818], [20, 207118], [23, 207358], [28, 208098], [31, 208378], [36, 208538], [38, 208678], [42, 208878], [45, 209038], [51, 209438], [54, 209678], [61, 210018], [64, 210318], [67, 210518]]}, {"verse": 35, "start": 211740, "end": 219086, "text": "You have also given me the shield of your salvation: and your right hand has held me up, and your gentleness has made me great.", "words": [[0, 211740], [4, 211864], [9, 212024], [14, 212304], [20, 212624], [23, 212864], [27, 213004], [34, 213304], [37, 213564], [42, 213724], [53, 214798], [57, 214924], [62, 215044], [68, 215324], [73, 215784], [77, 216004], [82, 216224], [85, 216444], [89, 216904], [93, 217244], [98, 217364], [109, 217964], [113, 218144], [118, 218364], [121, 218544]]}, {"verse": 36, "start": 219536, "end": 223051, "text": "You have enlarged my steps under me, that my feet did not slip.", "words": [[0, 219536], [4, 219662], [9, 219862], [18, 220362], [21, 220542], [27, 220842], [33, 221182], [37, 221402], [42, 221762], [45, 221922], [50, 222162], [54, 222382], [58, 222562]]}, {"verse": 37, "start": 223501, "end": 229586, "text": "I have pursued my enemies, and overtaken them: neither did I turn again till they were consumed.", "words": [[0, 223501], [2, 223688], [7, 223868], [15, 224288], [18, 224568], [27, 224988], [31, 225528], [41, 226268], [47, 226922], [55, 227209], [59, 227509], [61, 227649], [66, 227889], [72, 228229], [77, 228509], [82, 228689], [87, 228809]]}, {"verse": 38, "start": 230036, "end": 234822, "text": "I have wounded them that they were not able to rise: they are fallen under my feet.", "words": [[0, 230036], [2, 230182], [7, 230362], [15, 230662], [20, 230982], [25, 231182], [30, 231342], [35, 231482], [39, 231722], [44, 232042], [47, 232242], [53, 233203], [58, 233324], [62, 233424], [69, 233764], [75, 234084], [78, 234324]]}, {"verse": 39, "start": 235272, "end": 241021, "text": "For you have girded me with strength to the battle: you have subdued under me those that rose up against me.", "words": [[0, 235272], [4, 235369], [8, 235549], [13, 235749], [20, 236169], [23, 236289], [28, 236509], [37, 236869], [40, 237109], [44, 237229], [52, 237949], [56, 238074], [61, 238234], [69, 238834], [75, 239094], [78, 239334], [84, 239614], [89, 239854], [94, 240094], [97, 240334], [105, 240614]]}, {"verse": 40, "start": 241471, "end": 246476, "text": "You have also given me the necks of my enemies; that I might destroy them that hate me.", "words": [[0, 241471], [4, 241596], [9, 241756], [14, 242056], [20, 242376], [23, 242596], [27, 242716], [33, 243056], [36, 243196], [39, 243376], [48, 244354], [53, 244490], [55, 244610], [61, 244830], [69, 245350], [74, 245650], [79, 245850], [84, 246090]]}, {"verse": 41, "start": 246926, "end": 252284, "text": "They cried, but there was none to save them: even to the LORD, but he answered them not.", "words": [[0, 246926], [5, 247190], [12, 247730], [16, 247850], [22, 248010], [26, 248170], [31, 248410], [34, 248650], [39, 248950], [45, 249711], [50, 249907], [53, 250107], [57, 250227], [63, 250867], [67, 251007], [70, 251147], [79, 251487], [84, 251767]]}, {"verse": 42, "start": 252734, "end": 259057, "text": "Then did I beat them small as the dust before the wind: I did cast them out as the dirt in the streets.", "words": [[0, 252734], [5, 253004], [9, 253244], [11, 253384], [16, 253664], [21, 253924], [27, 254384], [30, 254624], [34, 254784], [39, 255084], [46, 255444], [50, 255664], [56, 256394], [58, 256538], [62, 256758], [67, 257118], [72, 257378], [76, 257598], [79, 257838], [83, 257978], [88, 258218], [91, 258398], [95, 258498]]}, {"verse": 43, "start": 259507, "end": 267192, "text": "You have delivered me from the strivings of the people; and you have made me the head of the heathen: a people whom I have not known shall serve me.", "words": [[0, 259507], [4, 259630], [9, 259750], [19, 260090], [22, 260390], [27, 260610], [31, 260770], [41, 261390], [44, 261470], [48, 261590], [56, 262366], [60, 262493], [64, 262613], [69, 262753], [74, 262973], [77, 263193], [81, 263393], [86, 263593], [89, 263713], [93, 263853], [102, 264668], [104, 264755], [111, 265055], [116, 265315], [118, 265475], [123, 265635], [127, 265835], [133, 266195], [139, 266475], [145, 266835]]}, {"verse": 44, "start": 267642, "end": 272976, "text": "As soon as they hear of me, they shall obey me: the strangers shall submit themselves to me.", "words": [[0, 267642], [3, 267766], [8, 268026], [11, 268146], [16, 268286], [21, 268566], [24, 268706], [28, 269266], [33, 269386], [39, 269626], [44, 269966], [48, 270670], [52, 270906], [62, 271156], [68, 271516], [75, 271896], [86, 272296], [89, 272596]]}, {"verse": 45, "start": 273426, "end": 277718, "text": "The strangers shall fade away, and be afraid out of their close places.", "words": [[0, 273426], [4, 273528], [14, 273968], [20, 274288], [25, 274588], [31, 274988], [35, 275488], [38, 275648], [45, 276068], [49, 276348], [52, 276468], [58, 276678], [64, 276888]]}, {"verse": 46, "start": 278168, "end": 284312, "text": "The LORD lives; and blessed be my rock; and let the God of my salvation be exalted.", "words": [[0, 278168], [4, 278275], [9, 278575], [16, 279560], [20, 279717], [28, 280017], [31, 280517], [34, 280737], [40, 281580], [44, 281683], [48, 281883], [52, 282043], [56, 282323], [59, 282463], [62, 282643], [72, 283223], [75, 283563]]}, {"verse": 47, "start": 284762, "end": 288378, "text": "It is God that avenges me, and subdues the people under me.", "words": [[0, 284762], [3, 284885], [6, 285045], [10, 285305], [15, 285525], [23, 286065], [27, 286305], [31, 286745], [39, 287285], [43, 287405], [50, 287705], [56, 288025]]}, {"verse": 48, "start": 288828, "end": 297396, "text": "He delivers me from my enemies: yes, you lift me up above those that rise up against me: you have delivered me from the violent man.", "words": [[0, 288828], [3, 288936], [12, 289296], [15, 289616], [20, 289836], [23, 290116], [32, 291072], [37, 291839], [41, 291979], [46, 292179], [49, 292459], [52, 292639], [58, 292919], [64, 293259], [69, 293519], [74, 293819], [77, 294079], [85, 294379], [89, 295150], [93, 295297], [98, 295436], [108, 295776], [111, 296096], [116, 296316], [120, 296456], [128, 296816]]}, {"verse": 49, "start": 297846, "end": 303127, "text": "Therefore will I give thanks to you, O LORD, among the heathen, and sing praises to your name.", "words": [[0, 297846], [10, 298243], [15, 298603], [17, 298763], [22, 298923], [29, 299263], [32, 299543], [37, 299843], [39, 299983], [45, 300383], [51, 300543], [55, 300803], [64, 301323], [68, 301423], [73, 301683], [81, 302203], [84, 302443], [89, 302603]]}, {"verse": 50, "start": 303577, "end": 310901, "text": "Great deliverance gives he to his king; and shows mercy to his anointed, to David, and to his seed for evermore.", "words": [[0, 303577], [6, 303842], [18, 304522], [24, 304742], [27, 304962], [30, 305122], [34, 305282], [40, 306116], [44, 306242], [50, 306502], [56, 306942], [59, 307202], [63, 307342], [73, 308442], [76, 308522], [83, 309242], [87, 309362], [90, 309502], [94, 309662], [99, 309982], [103, 310222]]}]}