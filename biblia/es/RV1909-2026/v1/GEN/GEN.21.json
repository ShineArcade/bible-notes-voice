{"book": "GEN", "chapter": 21, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 278567, "verses": [{"verse": 1, "start": 300, "end": 6689, "text": "Y visitó Jehová a Sara, como había dicho, e hizo Jehová con Sara como había hablado.", "words": [[0, 300], [2, 425], [9, 1005], [16, 1525], [18, 1725], [24, 2185], [29, 2325], [35, 2625], [42, 3785], [44, 3885], [49, 4185], [56, 4785], [60, 4945], [65, 5265], [70, 5585], [76, 5965]]}, {"verse": 2, "start": 7139, "end": 14530, "text": "Y concibió y parió Sara a Abraham un hijo en su vejez, en el tiempo que Dios le había dicho.", "words": [[0, 7139], [2, 7259], [11, 8079], [13, 8239], [19, 8659], [24, 9059], [26, 9519], [34, 10599], [37, 10719], [42, 11019], [45, 11446], [48, 11872], [55, 12299], [58, 12459], [61, 12599], [68, 12899], [72, 13179], [77, 13459], [80, 13739], [86, 13939]]}, {"verse": 3, "start": 14980, "end": 20930, "text": "Y llamó Abraham el nombre de su hijo que le nació, que le parió Sara, Isaac.", "words": [[0, 14980], [2, 15104], [8, 15484], [16, 16084], [19, 16484], [26, 16904], [29, 17144], [32, 17324], [37, 17624], [41, 17844], [44, 17984], [51, 18624], [55, 18684], [58, 18844], [64, 19553], [70, 20263]]}, {"verse": 4, "start": 21380, "end": 27716, "text": "Y circuncidó Abraham a su hijo Isaac de ocho días, como Dios le había mandado.", "words": [[0, 21380], [2, 21508], [13, 22408], [21, 23048], [23, 23348], [26, 23548], [31, 23808], [37, 24158], [40, 24508], [45, 24868], [51, 25588], [56, 25848], [61, 26168], [64, 26708], [70, 26928]]}, {"verse": 5, "start": 28166, "end": 33233, "text": "Y era Abraham de cien años, cuando le nació Isaac su hijo.", "words": [[0, 28166], [2, 28352], [6, 28572], [14, 29252], [17, 29512], [22, 29872], [28, 30892], [35, 31052], [38, 31312], [44, 31752], [50, 32292], [53, 32712]]}, {"verse": 6, "start": 33683, "end": 41177, "text": "Entonces dijo Sara: Dios me ha hecho reír, y cualquiera que lo oiga, se reirá conmigo.", "words": [[0, 33683], [9, 34230], [14, 34830], [20, 35671], [25, 35916], [28, 36176], [31, 36356], [37, 36576], [43, 37076], [45, 37376], [56, 37896], [60, 38056], [63, 38216], [69, 38536], [72, 38896], [78, 39316]]}, {"verse": 7, "start": 41527, "end": 49180, "text": "Y añadió: ¿Quién habría dicho a Abraham que Sara había de dar de mamar a hijos? pues que le he parido un hijo a su vejez.", "words": [[0, 41527], [2, 41650], [10, 42565], [17, 42765], [24, 43065], [30, 43365], [32, 43605], [40, 43945], [44, 44265], [49, 44585], [55, 44885], [58, 45105], [62, 45305], [65, 45465], [71, 45825], [73, 45885], [80, 46838], [85, 46961], [89, 47161], [92, 47281], [95, 47421], [102, 47821], [105, 48021], [110, 48281], [112, 48603], [115, 48925]]}, {"verse": 8, "start": 49530, "end": 58095, "text": "Y creció el niño, y fue destetado; e hizo Abraham gran banquete el día que fue destetado Isaac.", "words": [[0, 49530], [2, 49695], [9, 50155], [12, 50354], [18, 50774], [20, 51314], [24, 51555], [35, 53098], [37, 53244], [42, 53524], [50, 54104], [55, 54744], [64, 55444], [67, 55764], [71, 56004], [75, 56184], [79, 56424], [89, 57404]]}, {"verse": 9, "start": 58545, "end": 65594, "text": "Y vio Sara al hijo de Agar la egipcia, el cual había esta parido a Abraham, que se burlaba.", "words": [[0, 58545], [2, 58671], [6, 58871], [11, 59251], [14, 59611], [19, 59831], [22, 60038], [27, 60244], [30, 60451], [39, 61551], [42, 61671], [47, 61951], [53, 62438], [58, 62924], [65, 63411], [67, 63671], [76, 64651], [80, 64671], [83, 64871]]}, {"verse": 10, "start": 66044, "end": 75086, "text": "Por tanto dijo a Abraham: Echa a esta sierva y a su hijo; que el hijo de esta sierva no ha de heredar con mi hijo, con Isaac.", "words": [[0, 66044], [4, 66168], [10, 66868], [15, 67098], [17, 67328], [26, 68567], [31, 68717], [33, 68867], [38, 69207], [45, 69787], [47, 70007], [49, 70107], [52, 70227], [58, 70981], [62, 71083], [65, 71183], [70, 71363], [73, 71523], [78, 71743], [85, 72283], [88, 72563], [91, 72743], [94, 72883], [102, 73283], [106, 73483], [109, 73663], [115, 74263], [119, 74503]]}, {"verse": 11, "start": 75436, "end": 80507, "text": "Este dicho pareció grave en gran manera a Abraham a causa de su hijo.", "words": [[0, 75436], [5, 75744], [11, 76144], [19, 76744], [25, 77104], [28, 77364], [33, 77564], [40, 78104], [42, 78404], [50, 78844], [52, 79244], [58, 79584], [61, 79844], [64, 80024]]}, {"verse": 12, "start": 80957, "end": 93939, "text": "Entonces dijo Dios a Abraham: No te parezca grave a causa del muchacho y de tu sierva; en todo lo que te diga Sara, oye su voz, porque por medio de Isaac te vendrá descendencia.", "words": [[0, 80957], [9, 81442], [14, 82122], [19, 82602], [21, 83022], [30, 84042], [33, 84223], [36, 84403], [44, 84903], [50, 85243], [52, 85403], [58, 85703], [62, 85943], [71, 86443], [73, 86563], [76, 86643], [79, 86783], [87, 87912], [90, 88076], [95, 88316], [98, 88536], [102, 88656], [105, 88796], [110, 89096], [116, 89836], [120, 90076], [123, 90216], [128, 90836], [135, 91116], [139, 91356], [145, 91656], [148, 91856], [154, 92196], [157, 92456], [164, 92816]]}, {"verse": 13, "start": 94389, "end": 98684, "text": "Y también al hijo de la sierva pondré en nación, porque es tu simiente.", "words": [[0, 94389], [2, 94492], [10, 94772], [13, 95052], [18, 95232], [21, 95372], [24, 95472], [31, 95952], [38, 96412], [41, 96512], [49, 97232], [56, 97432], [59, 97672], [62, 97772]]}, {"verse": 14, "start": 99034, "end": 115700, "text": "Entonces Abraham se levantó muy de mañana, y tomó pan, y un odre de agua, y lo dio a Agar, poniéndolo sobre su hombro, y le entregó el muchacho, y la despidió. Y ella salió y anduvo errante por el desierto de Beerseba.", "words": [[0, 99034], [9, 99481], [17, 100121], [20, 100521], [28, 101021], [32, 101241], [35, 101401], [43, 101861], [45, 102541], [50, 102861], [55, 103161], [57, 103661], [60, 103841], [65, 104301], [68, 104441], [74, 104801], [76, 105221], [79, 105361], [83, 105561], [85, 105841], [91, 106361], [102, 107301], [108, 107561], [111, 107841], [119, 108501], [121, 108641], [124, 108761], [132, 109031], [135, 109301], [145, 110335], [147, 110438], [150, 110558], [160, 111499], [162, 111647], [167, 111867], [173, 112467], [175, 112867], [182, 113207], [190, 113687], [194, 113927], [197, 114047], [206, 114607], [209, 115188]]}, {"verse": 15, "start": 116150, "end": 120212, "text": "Y faltó el agua del odre, y echó al muchacho debajo de un árbol;", "words": [[0, 116150], [2, 116272], [8, 116652], [11, 116752], [16, 116972], [20, 117192], [26, 117852], [28, 118012], [33, 118332], [36, 118432], [45, 118952], [52, 119392], [55, 119552], [58, 119672]]}, {"verse": 16, "start": 120662, "end": 134669, "text": "Y se fue y se sentó enfrente, a distancia de un tiro de arco; porque decía: No veré cuando el muchacho muera: y cuando ella se sentó enfrente, el muchacho alzó su voz y lloró.", "words": [[0, 120662], [2, 120830], [5, 120910], [9, 121170], [11, 121690], [14, 121850], [20, 122470], [30, 123370], [32, 123990], [42, 124750], [45, 124970], [48, 125130], [53, 125410], [56, 125630], [62, 126455], [69, 126679], [76, 127749], [79, 127936], [84, 128296], [91, 128496], [94, 128696], [103, 129076], [110, 129979], [112, 130086], [119, 130386], [124, 130686], [127, 130906], [133, 131526], [143, 132146], [146, 132186], [155, 132746], [160, 133486], [163, 133606], [167, 133866], [169, 134146]]}, {"verse": 17, "start": 135119, "end": 147985, "text": "Y oyó Dios la voz del muchacho; y el ángel de Dios llamó a Agar desde el cielo, y le dijo: ¿Qué tienes, Agar? No temas; porque Dios ha oído la voz del muchacho en donde está.", "words": [[0, 135119], [2, 135394], [6, 135704], [11, 136104], [14, 136444], [18, 136684], [22, 136864], [32, 137945], [34, 138075], [37, 138215], [43, 138635], [46, 138755], [51, 139055], [57, 139795], [59, 140055], [64, 140315], [70, 140575], [73, 140775], [80, 141195], [82, 141375], [85, 141495], [91, 142337], [96, 142439], [104, 142904], [110, 143614], [113, 143783], [120, 144656], [127, 144859], [132, 145199], [135, 145559], [140, 145979], [143, 146159], [147, 146399], [151, 146559], [160, 147119], [163, 147279], [169, 147419]]}, {"verse": 18, "start": 148285, "end": 154043, "text": "Levántate, alza al muchacho, y tómalo de tu mano, porque en gran gente lo tengo de poner.", "words": [[0, 148285], [11, 148904], [16, 149325], [19, 149425], [29, 149985], [31, 150504], [38, 150944], [41, 151064], [44, 151184], [50, 151485], [57, 152124], [60, 152344], [65, 152485], [71, 152884], [74, 153105], [80, 153404], [83, 153564]]}, {"verse": 19, "start": 154393, "end": 164514, "text": "Entonces abrió Dios sus ojos, y vio una fuente de agua; y fue, y llenó el odre de agua, y dio de beber al muchacho.", "words": [[0, 154393], [9, 154857], [15, 155577], [20, 155817], [24, 156157], [30, 156557], [32, 157117], [36, 157397], [40, 157717], [47, 158197], [50, 158397], [56, 159209], [58, 159357], [63, 160097], [65, 160377], [71, 160857], [74, 161137], [79, 161537], [82, 161657], [88, 162577], [90, 162897], [94, 163097], [97, 163257], [103, 163537], [106, 163757]]}, {"verse": 20, "start": 164964, "end": 171901, "text": "Y fue Dios con el muchacho; y creció, y habitó en el desierto, y fue tirador de arco.", "words": [[0, 164964], [2, 165352], [6, 165552], [11, 165852], [15, 166212], [18, 166352], [28, 167412], [30, 167557], [38, 168137], [40, 168397], [47, 168857], [50, 168977], [53, 169097], [63, 169757], [65, 170297], [69, 170457], [77, 171017], [80, 171277]]}, {"verse": 21, "start": 172351, "end": 178276, "text": "Y habitó en el desierto de Parán; y su madre le tomó mujer de la tierra de Egipto.", "words": [[0, 172351], [2, 172483], [9, 172903], [12, 173023], [15, 173143], [24, 173623], [27, 173823], [34, 174741], [36, 174840], [39, 174980], [45, 175360], [48, 175640], [53, 176100], [59, 176360], [62, 176620], [65, 176880], [72, 177140], [75, 177380]]}, {"verse": 22, "start": 178726, "end": 190998, "text": "Y aconteció en aquel mismo tiempo que habló Abimelec, y Ficol, príncipe de su ejército, a Abraham diciendo: Dios es contigo en todo cuanto haces:", "words": [[0, 178726], [2, 178869], [12, 179649], [15, 179869], [21, 180189], [27, 180449], [34, 180969], [38, 181209], [44, 181829], [54, 182449], [56, 183249], [63, 184049], [72, 184709], [75, 184909], [78, 185069], [88, 186089], [90, 186369], [98, 186769], [108, 188030], [113, 188359], [116, 188739], [124, 189279], [127, 189439], [132, 189679], [139, 190079]]}, {"verse": 23, "start": 191448, "end": 205377, "text": "Ahora pues, júrame aquí por Dios, que no faltarás a mí, ni a mi hijo, ni a mi nieto; sino que conforme a la bondad que yo hice contigo, harás tú conmigo, y con la tierra donde has morado.", "words": [[0, 191448], [6, 191852], [12, 192652], [19, 193132], [24, 193392], [28, 193652], [34, 194392], [38, 194452], [41, 194592], [50, 195192], [52, 195292], [56, 195872], [59, 196132], [61, 196212], [64, 196392], [70, 197212], [73, 197312], [75, 197412], [78, 197532], [85, 198473], [90, 198701], [94, 198921], [103, 199661], [105, 199741], [108, 199821], [115, 200361], [119, 200481], [122, 200701], [127, 200881], [136, 201661], [142, 202121], [145, 202321], [154, 203061], [156, 203501], [160, 203701], [163, 203841], [170, 204161], [176, 204441], [180, 204721]]}, {"verse": 24, "start": 205827, "end": 208403, "text": "Y respondió Abraham: Yo juraré.", "words": [[0, 205827], [2, 205935], [12, 206575], [21, 207649], [24, 207833]]}, {"verse": 25, "start": 208753, "end": 217606, "text": "Y Abraham reprendió a Abimelec a causa de un pozo de agua, que los siervos de Abimelec le habían quitado.", "words": [[0, 208753], [2, 208875], [10, 209515], [20, 210795], [22, 211325], [31, 211855], [33, 212255], [39, 212595], [42, 212835], [45, 212935], [50, 213315], [53, 213475], [59, 214075], [63, 214315], [67, 214475], [75, 215055], [78, 215475], [87, 215895], [90, 216095], [97, 216455]]}, {"verse": 26, "start": 218056, "end": 225382, "text": "Y respondió Abimelec: No sé quién haya hecho esto, ni tampoco tú me lo hiciste saber, ni yo lo he oído hasta hoy.", "words": [[0, 218056], [2, 218056], [12, 219030], [22, 220290], [25, 220434], [28, 220574], [34, 220774], [39, 221014], [45, 221334], [51, 221874], [54, 221974], [62, 222314], [65, 222574], [68, 222694], [71, 222814], [79, 223174], [86, 223854], [89, 223974], [92, 224174], [95, 224334], [98, 224494], [103, 224794], [109, 225054]]}, {"verse": 27, "start": 225732, "end": 231760, "text": "Y tomó Abraham ovejas y vacas, y dio a Abimelec; e hicieron ambos pacto.", "words": [[0, 225732], [2, 225876], [7, 226396], [15, 226916], [22, 227356], [24, 227516], [31, 228616], [33, 228716], [37, 228956], [39, 229615], [49, 230511], [51, 230636], [60, 231296], [66, 231528]]}, {"verse": 28, "start": 232210, "end": 236320, "text": "Y puso Abraham siete corderas del rebaño aparte.", "words": [[0, 232715], [2, 233075], [7, 233595], [15, 233855], [21, 234235], [30, 234682], [34, 235128], [41, 235575]]}, {"verse": 29, "start": 236770, "end": 242459, "text": "Y dijo Abimelec a Abraham: ¿Qué significan esas siete corderas que has puesto aparte?", "words": [[0, 236770], [2, 237010], [7, 237530], [16, 238077], [18, 238624], [27, 239360], [32, 239460], [43, 240140], [48, 240320], [54, 240680], [63, 241260], [67, 241460], [71, 241600], [78, 241800]]}, {"verse": 30, "start": 242809, "end": 249719, "text": "Y él respondió: Que estas siete corderas tomarás de mi mano, para que me sean en testimonio de que yo cavé este pozo.", "words": [[0, 242809], [2, 242991], [5, 243131], [16, 244176], [20, 244280], [26, 244560], [32, 244880], [41, 245420], [49, 245940], [52, 246020], [55, 246120], [61, 246420], [66, 246680], [70, 246840], [73, 247000], [78, 247220], [81, 247400], [92, 248080], [95, 248200], [99, 248360], [102, 248630], [107, 248900], [112, 249100]]}, {"verse": 31, "start": 250069, "end": 254995, "text": "Por esto llamó a aquel lugar Beerseba; porque allí juraron ambos.", "words": [[0, 250069], [4, 250213], [9, 250453], [15, 250953], [17, 251113], [23, 251533], [29, 252263], [39, 253263], [46, 253480], [51, 253730], [59, 254310]]}, {"verse": 32, "start": 255445, "end": 265908, "text": "Así hicieron pacto en Beerseba: y se levantó Abimelec, y Ficol, príncipe de su ejército, y se volvieron a tierra de los filisteos.", "words": [[0, 255445], [4, 255745], [13, 256385], [19, 257145], [22, 257698], [32, 258500], [34, 258641], [37, 258741], [45, 259441], [55, 260141], [57, 260501], [64, 261361], [73, 262261], [76, 262441], [79, 262621], [89, 263281], [91, 263441], [94, 263541], [104, 264121], [106, 264241], [113, 264541], [116, 264781], [120, 264941]]}, {"verse": 33, "start": 266358, "end": 273445, "text": "Y plantó Abraham un bosque en Beerseba, e invocó allí el nombre de Jehová Dios eterno.", "words": [[0, 266358], [2, 266480], [9, 267040], [17, 267600], [20, 267860], [27, 268380], [30, 269020], [40, 269660], [42, 269940], [49, 270540], [54, 270780], [57, 271020], [64, 271340], [67, 271560], [74, 272360], [79, 272560]]}, {"verse": 34, "start": 273895, "end": 278167, "text": "Y moró Abraham en tierra de los filisteos muchos días.", "words": [[0, 273895], [2, 274024], [7, 274424], [15, 275024], [18, 275384], [25, 275844], [28, 276104], [32, 276244], [42, 276944], [49, 277364]]}]}