{"book": "PSA", "chapter": 135, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 115298, "verses": [{"verse": 1, "start": 300, "end": 5926, "text": "Praise the LORD. Praise the name of the LORD; praise him, O you servants of the LORD.", "words": [[0, 300], [7, 519], [11, 799], [17, 1620], [24, 1804], [28, 2124], [33, 2444], [36, 2644], [40, 2804], [46, 3614], [53, 3818], [58, 4318], [60, 4438], [64, 4658], [73, 4998], [76, 5338], [80, 5498]]}, {"verse": 2, "start": 6376, "end": 10923, "text": "You that stand in the house of the LORD, in the courts of the house of our God,", "words": [[0, 6376], [4, 6582], [9, 6802], [15, 7202], [18, 7442], [22, 7562], [28, 7802], [31, 7962], [35, 8102], [41, 8902], [44, 9062], [48, 9182], [55, 9502], [58, 9722], [62, 9842], [68, 10062], [71, 10222], [75, 10362]]}, {"verse": 3, "start": 11373, "end": 17069, "text": "Praise the LORD; for the LORD is good: sing praises to his name; for it is pleasant.", "words": [[0, 11373], [7, 11573], [11, 11873], [17, 12677], [21, 12765], [25, 12925], [30, 13165], [33, 13345], [39, 14269], [44, 14399], [52, 14959], [55, 15179], [59, 15359], [65, 16105], [69, 16230], [72, 16350], [75, 16450]]}, {"verse": 4, "start": 17519, "end": 21990, "text": "For the LORD has chosen Jacob to himself, and Israel for his special treasure.", "words": [[0, 17519], [4, 17603], [8, 17743], [13, 17983], [17, 18183], [24, 18523], [30, 18963], [33, 19183], [42, 19683], [46, 20023], [53, 20423], [57, 20723], [61, 20883], [69, 21243]]}, {"verse": 5, "start": 22440, "end": 26812, "text": "For I know that the LORD is great, and that our Lord is above all gods.", "words": [[0, 22440], [4, 22680], [6, 22880], [11, 23100], [16, 23360], [20, 23500], [25, 23760], [28, 23940], [35, 24500], [39, 24760], [44, 24920], [48, 25100], [53, 25420], [56, 25600], [62, 25860], [66, 26120]]}, {"verse": 6, "start": 27262, "end": 33326, "text": "Whatever the LORD pleased, that did he in heaven, and in earth, in the seas, and all deep places.", "words": [[0, 27262], [9, 27489], [13, 27769], [18, 27989], [27, 29009], [32, 29149], [36, 29369], [39, 29569], [42, 29749], [50, 30069], [54, 30449], [57, 30569], [64, 31129], [67, 31249], [71, 31369], [77, 31689], [81, 32089], [85, 32369], [90, 32589]]}, {"verse": 7, "start": 33776, "end": 41140, "text": "He causes the vapours to ascend from the ends of the earth; he makes lightnings for the rain; he brings the wind out of his treasuries.", "words": [[0, 33776], [3, 33860], [10, 34220], [14, 34580], [22, 34940], [25, 35080], [32, 35420], [37, 35720], [41, 35880], [46, 36060], [49, 36220], [53, 36340], [60, 37024], [63, 37115], [69, 37335], [80, 37935], [84, 38055], [88, 38195], [94, 38981], [97, 39068], [104, 39328], [108, 39548], [113, 39788], [117, 40068], [120, 40188], [124, 40288]]}, {"verse": 8, "start": 41590, "end": 45169, "text": "Who struck the firstborn of Egypt, both of man and beast.", "words": [[0, 41590], [4, 41693], [11, 41933], [15, 42133], [25, 42693], [28, 42853], [35, 43453], [40, 43673], [43, 43893], [47, 44253], [51, 44553]]}, {"verse": 9, "start": 45619, "end": 51896, "text": "Who sent tokens and wonders into the midst of you, O Egypt, upon Pharaoh, and upon all his servants.", "words": [[0, 45619], [4, 45724], [9, 45984], [16, 46424], [20, 46724], [28, 47084], [33, 47444], [37, 47604], [43, 47884], [46, 48104], [51, 48484], [53, 48544], [60, 49124], [65, 49364], [74, 49864], [78, 50384], [83, 50664], [87, 51004], [91, 51204]]}, {"verse": 10, "start": 52346, "end": 55293, "text": "Who struck great nations, and killed mighty kings;", "words": [[0, 52346], [4, 52449], [11, 52769], [17, 53129], [26, 53549], [30, 53849], [37, 54169], [44, 54509]]}, {"verse": 11, "start": 55743, "end": 61621, "text": "Sihon king of the Amorites, and Og king of Bashan, and all the kingdoms of Canaan:", "words": [[0, 55993], [6, 56243], [11, 56623], [14, 56863], [18, 56983], [28, 57883], [32, 57943], [35, 58203], [40, 58563], [43, 59183], [51, 59803], [55, 59883], [59, 60143], [63, 60303], [72, 60603], [75, 60903]]}, {"verse": 12, "start": 62071, "end": 66740, "text": "And gave their land for a heritage, a heritage to Israel his people.", "words": [[0, 62071], [4, 62229], [9, 62449], [15, 62729], [20, 63109], [24, 63389], [26, 63529], [36, 64409], [38, 64569], [47, 64989], [50, 65309], [57, 65969], [61, 66149]]}, {"verse": 13, "start": 67190, "end": 73689, "text": "Your name, O LORD, endures for ever; and your memorial, O LORD, throughout all generations.", "words": [[0, 67190], [5, 67322], [11, 67762], [13, 67882], [19, 68562], [27, 69006], [31, 69448], [37, 70138], [41, 70304], [46, 70444], [56, 71284], [58, 71404], [64, 71984], [75, 72204], [79, 72624]]}, {"verse": 14, "start": 74139, "end": 78895, "text": "For the LORD will judge his people, and he will repent himself concerning his servants.", "words": [[0, 74139], [4, 74241], [8, 74381], [13, 74641], [18, 74841], [24, 75141], [28, 75341], [36, 76041], [40, 76241], [43, 76361], [48, 76501], [55, 76841], [63, 77341], [74, 77901], [78, 78161]]}, {"verse": 15, "start": 79345, "end": 83421, "text": "The idols of the heathen are silver and gold, the work of men’s hands.", "words": [[0, 79345], [4, 79448], [10, 79808], [13, 80048], [17, 80168], [25, 80568], [29, 80688], [36, 81068], [40, 81288], [46, 81948], [50, 82048], [55, 82288], [58, 82468], [64, 82888]]}, {"verse": 16, "start": 83871, "end": 87955, "text": "They have mouths, but they speak not; eyes have they, but they see not;", "words": [[0, 83871], [5, 83972], [10, 84152], [18, 84672], [22, 84792], [27, 84952], [33, 85192], [38, 86062], [43, 86285], [48, 86585], [54, 86965], [58, 87045], [63, 87225], [67, 87465]]}, {"verse": 17, "start": 88405, "end": 93294, "text": "They have ears, but they hear not; neither is there any breath in their mouths.", "words": [[0, 88405], [5, 88511], [10, 88771], [16, 89351], [20, 89451], [25, 89671], [30, 89871], [35, 90750], [43, 91034], [46, 91334], [52, 91534], [56, 91794], [63, 92134], [66, 92414], [72, 92534]]}, {"verse": 18, "start": 93744, "end": 98037, "text": "They that make them are like to them: so is every one that trusts in them.", "words": [[0, 93744], [5, 94124], [10, 94364], [15, 94604], [20, 94784], [24, 94904], [29, 95124], [32, 95324], [38, 96089], [41, 96237], [44, 96410], [50, 96584], [54, 96757], [59, 97077], [66, 97397], [69, 97697]]}, {"verse": 19, "start": 98487, "end": 103326, "text": "Bless the LORD, O house of Israel: bless the LORD, O house of Aaron:", "words": [[0, 98487], [6, 98754], [10, 99074], [16, 99554], [18, 99654], [24, 99954], [27, 100194], [35, 101115], [41, 101319], [45, 101619], [51, 102139], [53, 102219], [59, 102499], [62, 102699]]}, {"verse": 20, "start": 103776, "end": 109482, "text": "Bless the LORD, O house of Levi: you that fear the LORD, bless the LORD.", "words": [[0, 104034], [6, 104324], [10, 104324], [16, 104724], [18, 104844], [24, 105104], [27, 105324], [33, 106329], [37, 106551], [42, 106791], [47, 107071], [51, 107251], [57, 107751], [63, 107931], [67, 108251]]}, {"verse": 21, "start": 109932, "end": 114898, "text": "Blessed be the LORD out of Zion, which dwells at Jerusalem. Praise the LORD.", "words": [[0, 109932], [8, 110199], [11, 110559], [15, 110719], [20, 110979], [24, 111159], [27, 111299], [33, 112039], [39, 112119], [46, 112619], [49, 112699], [60, 113855], [67, 114117], [71, 114437]]}]}