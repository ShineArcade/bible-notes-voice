{"book": "JHN", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 412793, "verses": [{"verse": 1, "start": 300, "end": 7627, "text": "Estaba entonces enfermo uno llamado Lázaro, de Betania, la aldea de María y de Marta su hermana.", "words": [[0, 300], [7, 684], [16, 1184], [24, 1984], [28, 2304], [36, 2664], [44, 3344], [47, 3824], [56, 4789], [59, 4869], [65, 5389], [68, 5549], [74, 5849], [76, 6209], [79, 6329], [85, 6769], [88, 6969]]}, {"verse": 2, "start": 7977, "end": 16911, "text": "(Y María, cuyo hermano Lázaro estaba enfermo, era la que ungió al Señor con perfume, y limpió sus pies con sus cabellos.)", "words": [[0, 7977], [3, 8103], [10, 8503], [15, 8983], [23, 9423], [30, 9923], [37, 10223], [46, 11423], [50, 11843], [53, 12043], [57, 12423], [63, 12803], [66, 13083], [72, 13463], [76, 13823], [85, 14443], [87, 14723], [94, 15243], [98, 15443], [103, 15663], [107, 15943], [111, 16083]]}, {"verse": 3, "start": 17261, "end": 23652, "text": "Enviaron, pues, sus hermanas a él, diciendo: Señor, he aquí, el que amas está enfermo.", "words": [[0, 17261], [10, 17789], [16, 18429], [20, 18549], [29, 19049], [31, 19249], [35, 19449], [45, 20505], [52, 21365], [55, 21485], [61, 21865], [64, 22245], [68, 22425], [73, 22765], [78, 22985]]}, {"verse": 4, "start": 23932, "end": 34314, "text": "Y oyéndolo Jesús, dijo: Esta enfermedad no es para muerte, sino para la gloria de Dios, para que el Hijo de Dios sea glorificado por ella.", "words": [[0, 23932], [2, 24276], [11, 24656], [18, 24896], [24, 25856], [29, 26083], [40, 26803], [43, 26943], [46, 27063], [51, 27263], [59, 28343], [64, 28723], [69, 29043], [72, 29203], [79, 29623], [82, 29783], [88, 30723], [93, 31043], [97, 31263], [100, 31543], [105, 31843], [108, 32003], [113, 32303], [117, 32703], [129, 33563], [133, 33803]]}, {"verse": 5, "start": 34664, "end": 39050, "text": "Y amaba Jesús a Marta, y a su hermana, y a Lázaro.", "words": [[0, 34664], [2, 34771], [8, 35211], [14, 35431], [16, 35711], [23, 36551], [25, 36931], [27, 36991], [30, 37151], [39, 38171], [41, 38484], [43, 38796]]}, {"verse": 6, "start": 39400, "end": 44626, "text": "Cuando oyó pues que estaba enfermo, se quedó aún dos días en aquel lugar donde estaba.", "words": [[0, 39400], [7, 39693], [11, 40023], [16, 40283], [20, 40463], [27, 40703], [36, 41363], [39, 41523], [45, 41843], [49, 42163], [53, 42383], [58, 42703], [61, 42983], [67, 43323], [73, 43583], [79, 43883]]}, {"verse": 7, "start": 44976, "end": 49780, "text": "Luego, después de esto, dijo a los discípulos: Vamos a Judea otra vez.", "words": [[0, 44976], [7, 45431], [15, 45631], [18, 45911], [24, 46451], [29, 46751], [31, 46911], [35, 47011], [47, 48069], [53, 48315], [55, 48475], [61, 48955], [66, 49215]]}, {"verse": 8, "start": 50130, "end": 56014, "text": "Le dicen los discípulos: Rabí, ahora procuraban los judíos apedrearte, ¿y otra vez vas allá?", "words": [[0, 50130], [3, 50350], [9, 50670], [13, 50930], [25, 52156], [31, 52326], [37, 52506], [48, 53126], [52, 53306], [59, 53896], [71, 54486], [74, 54846], [79, 55026], [83, 55366], [87, 55566]]}, {"verse": 9, "start": 56294, "end": 63648, "text": "Respondió Jesús: ¿No tiene el día doce horas? El que anda de día, no tropieza, porque ve la luz de este mundo.", "words": [[0, 56294], [10, 56783], [17, 57680], [21, 57784], [27, 58024], [30, 58224], [34, 58424], [39, 58624], [46, 59527], [49, 59679], [53, 59819], [58, 59979], [61, 60179], [66, 60459], [69, 60839], [79, 61459], [86, 61959], [89, 62159], [92, 62299], [96, 62559], [99, 62779], [104, 62959]]}, {"verse": 10, "start": 63998, "end": 68839, "text": "Pero el que anda de noche, tropieza, porque no hay luz en él.", "words": [[0, 63998], [5, 64144], [8, 64324], [12, 64484], [17, 64724], [20, 64904], [27, 65404], [37, 66584], [44, 67004], [47, 67244], [51, 67564], [55, 67884], [58, 68424]]}, {"verse": 11, "start": 69189, "end": 75233, "text": "Dicho esto, les dice después: Lázaro nuestro amigo duerme; pero voy a despertarle del sueño.", "words": [[0, 69189], [6, 69428], [12, 69668], [16, 69868], [21, 70128], [30, 71078], [37, 71630], [45, 71850], [51, 72210], [59, 73086], [64, 73250], [68, 73470], [70, 73570], [82, 74410], [86, 74550]]}, {"verse": 12, "start": 75583, "end": 80873, "text": "Dijeron entonces sus discípulos: Señor, si duerme, se recuperará.", "words": [[0, 75583], [8, 76128], [17, 76628], [21, 76988], [33, 79003], [40, 79483], [43, 79523], [51, 79863], [54, 80063]]}, {"verse": 13, "start": 81153, "end": 87568, "text": "Pero esto decía Jesús de la muerte de él: y ellos pensaron que hablaba del reposar del sueño.", "words": [[0, 81153], [5, 81295], [10, 81575], [16, 81995], [22, 82455], [25, 82915], [28, 83035], [35, 83335], [38, 83733], [42, 84278], [44, 84578], [50, 84818], [59, 85518], [63, 85718], [71, 86098], [75, 86278], [83, 86858], [87, 86998]]}, {"verse": 14, "start": 87918, "end": 93144, "text": "Entonces, pues, Jesús les dijo claramente: Lázaro ha muerto;", "words": [[0, 87918], [10, 88794], [16, 89314], [22, 89714], [26, 90114], [31, 90454], [43, 91569], [50, 92116], [53, 92516]]}, {"verse": 15, "start": 93494, "end": 99523, "text": "Y me alegro por vosotros, que yo no haya estado allí, para que creáis: pero vamos a él.", "words": [[0, 93494], [2, 93635], [5, 93755], [12, 94195], [16, 94435], [26, 95095], [30, 95370], [33, 95530], [36, 95710], [41, 95970], [48, 96290], [54, 96710], [59, 97270], [63, 97470], [71, 98525], [76, 98650], [82, 98910], [84, 99150]]}, {"verse": 16, "start": 99873, "end": 108825, "text": "Dijo entonces Tomás, el que se dice el Dídimo, a sus condiscípulos: Vamos también nosotros, para que muramos con él.", "words": [[0, 99873], [5, 100209], [14, 100729], [21, 101609], [24, 101849], [28, 102009], [31, 102169], [36, 102529], [39, 102929], [47, 103589], [49, 104049], [53, 104754], [68, 105659], [74, 105876], [82, 106196], [92, 106576], [97, 106936], [101, 107076], [109, 107456], [113, 107696]]}, {"verse": 17, "start": 109105, "end": 114542, "text": "Vino pues Jesús, y halló que había ya cuatro días que estaba en el sepulcro.", "words": [[0, 109105], [5, 109371], [10, 109631], [17, 110631], [19, 110931], [25, 111331], [29, 111551], [35, 111771], [38, 111991], [45, 112371], [50, 112851], [54, 113051], [61, 113331], [64, 113511], [67, 113651]]}, {"verse": 18, "start": 114892, "end": 119291, "text": "Y Betania estaba cerca de Jerusalén, como quince estadios;", "words": [[0, 114892], [2, 115118], [10, 115658], [17, 116078], [23, 116458], [26, 116718], [37, 117438], [42, 117858], [49, 118278]]}, {"verse": 19, "start": 119641, "end": 125078, "text": "Y muchos de los judíos habían venido a Marta y a María, a consolarlas de su hermano.", "words": [[0, 119641], [2, 119763], [9, 120063], [12, 120243], [16, 120363], [23, 120803], [30, 121003], [37, 121503], [39, 121623], [45, 122103], [47, 122443], [49, 122523], [56, 123323], [58, 123403], [70, 124203], [73, 124343], [76, 124463]]}, {"verse": 20, "start": 125428, "end": 132789, "text": "Entonces Marta, cuando oyó que Jesús venía, salió a encontrarle; pero María se estuvo en casa.", "words": [[0, 125428], [9, 126311], [16, 126971], [23, 127281], [27, 127591], [31, 127751], [37, 127991], [44, 128891], [50, 129351], [52, 129571], [65, 130861], [70, 131143], [76, 131443], [79, 131683], [86, 132003], [89, 132163]]}, {"verse": 21, "start": 133139, "end": 139385, "text": "Y Marta dijo a Jesús: Señor, si hubieses estado aquí, mi hermano no habría muerto;", "words": [[0, 133139], [2, 133422], [8, 133742], [13, 133962], [15, 134162], [22, 134978], [29, 135803], [32, 135923], [41, 136323], [48, 136643], [54, 137483], [57, 137623], [65, 138163], [68, 138323], [75, 138703]]}, {"verse": 22, "start": 139735, "end": 145705, "text": "Pero también sé ahora, que todo lo que pidas a Dios, Dios te lo dará.", "words": [[0, 139735], [5, 139886], [13, 140236], [16, 140586], [23, 140986], [27, 141446], [32, 141666], [35, 141866], [39, 142006], [45, 142306], [47, 142466], [53, 143186], [58, 143366], [61, 143606], [64, 143726]]}, {"verse": 23, "start": 145985, "end": 149151, "text": "Le dice Jesús: Resucitará tu hermano.", "words": [[0, 145985], [3, 146102], [8, 146362], [15, 147375], [26, 148357], [29, 148497]]}, {"verse": 24, "start": 149501, "end": 155531, "text": "Marta le dice: Yo sé que resucitará en la resurrección en el día postrero.", "words": [[0, 149501], [6, 150046], [9, 150186], [15, 150927], [18, 151110], [21, 151290], [25, 151450], [36, 152310], [39, 152490], [42, 152590], [55, 153470], [58, 153730], [61, 153870], [65, 154110]]}, {"verse": 25, "start": 155811, "end": 162761, "text": "Le dice Jesús: Yo soy la resurrección y la vida: el que cree en mí, aunque esté muerto, vivirá.", "words": [[0, 155811], [3, 155927], [8, 156187], [15, 157201], [18, 157387], [22, 157687], [25, 157972], [38, 158892], [40, 159132], [43, 159252], [49, 159960], [52, 160108], [56, 160248], [61, 160588], [64, 160968], [68, 161588], [75, 161768], [80, 162028], [88, 162395]]}, {"verse": 26, "start": 163111, "end": 168907, "text": "Y todo aquel que vive y cree en mí, no morirá eternamente. ¿Crees esto?", "words": [[0, 163718], [2, 163873], [7, 164093], [13, 164533], [17, 164633], [22, 164933], [24, 165193], [29, 165473], [32, 165813], [36, 166053], [39, 166513], [46, 166973], [59, 168132], [66, 168357]]}, {"verse": 27, "start": 169257, "end": 175275, "text": "Le dice: Sí, Señor; yo he creído que tú eres el Cristo, el Hijo de Dios, que has venido al mundo.", "words": [[0, 169257], [3, 169403], [9, 170116], [13, 170441], [20, 171138], [23, 171285], [26, 171385], [33, 171685], [37, 171845], [40, 172025], [45, 172245], [48, 172405], [56, 173125], [59, 173205], [64, 173425], [67, 173545], [73, 174105], [77, 174165], [81, 174325], [88, 174645], [91, 174785]]}, {"verse": 28, "start": 175555, "end": 184141, "text": "Habiendo dicho esto, fue y llamó a María su hermana, diciéndole en secreto: El Maestro está aquí y te llama.", "words": [[0, 175555], [9, 175943], [15, 176263], [21, 176563], [25, 177035], [27, 177158], [33, 177518], [35, 177618], [41, 177878], [44, 178218], [53, 179378], [64, 180298], [67, 180698], [76, 181753], [79, 181884], [87, 182464], [92, 182764], [97, 183164], [99, 183444], [102, 183584]]}, {"verse": 29, "start": 184421, "end": 187994, "text": "Ella, como lo oyó, se levanta rápidamente y viene a él.", "words": [[0, 184421], [6, 184646], [11, 184926], [14, 185216], [19, 185506], [22, 185741], [30, 186241], [42, 186961], [44, 187161], [50, 187401], [52, 187601]]}, {"verse": 30, "start": 188344, "end": 195101, "text": "(Que aún no había llegado Jesús a la aldea, pero estaba en aquel lugar donde Marta le había encontrado.)", "words": [[0, 188344], [5, 188446], [9, 188666], [12, 188906], [18, 189126], [26, 189586], [32, 189906], [34, 190286], [37, 190446], [44, 191046], [49, 191506], [56, 191806], [59, 192006], [65, 192306], [71, 192606], [77, 192966], [83, 193566], [86, 193886], [92, 194126]]}, {"verse": 31, "start": 195451, "end": 209035, "text": "Entonces los judíos que estaban en casa con ella, y la consolaban, cuando vieron que María se había levantado rápidamente, y había salido, la siguieron, diciendo: Va al sepulcro a llorar allí.", "words": [[0, 195451], [9, 196464], [13, 196724], [20, 197264], [24, 197384], [32, 197664], [35, 197824], [40, 198064], [44, 198364], [50, 198644], [52, 199124], [55, 199264], [67, 200664], [74, 200744], [81, 201084], [85, 201264], [91, 201524], [94, 201804], [100, 202004], [110, 202564], [123, 203424], [125, 203884], [131, 204104], [139, 204984], [142, 205084], [153, 205684], [163, 207112], [166, 207375], [169, 207535], [178, 208135], [180, 208315], [187, 208615]]}, {"verse": 32, "start": 209315, "end": 220228, "text": "Pero María, cuando vino donde estaba Jesús, viéndole, se derribó a sus pies, diciéndole: Señor, si hubieras estado aquí, no habría muerto mi hermano.", "words": [[0, 209315], [5, 209459], [12, 209819], [19, 210199], [24, 210579], [30, 210819], [37, 211199], [44, 212219], [54, 213119], [57, 213259], [65, 213819], [67, 213919], [71, 214079], [77, 214599], [89, 215668], [96, 216810], [99, 216950], [108, 217430], [115, 217790], [121, 218630], [124, 218750], [131, 219130], [138, 219490], [141, 219650]]}, {"verse": 33, "start": 220508, "end": 229321, "text": "Jesús entonces, como la vio llorando, y a los judíos que habían venido juntamente con ella llorando, se conmovió en espíritu, y se turbó,", "words": [[0, 220508], [6, 220838], [16, 221538], [21, 221718], [24, 221858], [28, 222058], [38, 222618], [40, 223098], [42, 223198], [46, 223298], [53, 223838], [57, 223958], [64, 224198], [71, 224638], [82, 225218], [86, 225408], [91, 225598], [101, 226433], [104, 226513], [113, 227173], [116, 227253], [126, 228313], [128, 228533], [131, 228673]]}, {"verse": 34, "start": 229671, "end": 234802, "text": "Y dijo: ¿Dónde le pusisteis? Le dicen: Señor, ven, y ve.", "words": [[0, 229671], [2, 229773], [8, 231203], [15, 231203], [18, 231203], [29, 232790], [32, 233112], [39, 233624], [46, 233879], [51, 234169], [53, 234509]]}, {"verse": 35, "start": 235082, "end": 236099, "text": "Y lloró Jesús.", "words": [[0, 235082], [2, 235270], [8, 235490]]}, {"verse": 36, "start": 236449, "end": 239822, "text": "Dijeron entonces los judíos: Mirad cómo le amaba.", "words": [[0, 236449], [8, 236994], [17, 237454], [21, 237734], [29, 238719], [35, 239017], [40, 239237], [43, 239397]]}, {"verse": 37, "start": 240102, "end": 246297, "text": "Y algunos de ellos dijeron: ¿No podía este que abrió los ojos al ciego, hacer que este no muriera?", "words": [[0, 240102], [2, 240223], [10, 240543], [13, 240783], [19, 241103], [28, 242356], [32, 242481], [38, 242761], [43, 243161], [47, 243301], [53, 243581], [57, 243741], [62, 244001], [65, 244241], [72, 244881], [78, 245121], [82, 245341], [87, 245561], [90, 245701]]}, {"verse": 38, "start": 246577, "end": 255115, "text": "Y Jesús, conmoviéndose otra vez en sí mismo, vino al sepulcro. Era una cueva, la cual tenía una piedra encima.", "words": [[0, 246577], [2, 246706], [9, 247466], [23, 248406], [28, 248706], [32, 248986], [35, 249186], [38, 249366], [45, 250466], [50, 250706], [53, 250906], [63, 251939], [67, 252124], [71, 252324], [78, 253064], [81, 253164], [86, 253384], [92, 253764], [96, 254004], [103, 254424]]}, {"verse": 39, "start": 255465, "end": 264864, "text": "Dice Jesús: Quitad la piedra. Marta, la hermana del que se había muerto, le dice: Señor, ya huele mal, porque lleva cuatro días muerto.", "words": [[0, 255465], [5, 255987], [12, 256867], [19, 257229], [22, 257389], [30, 258177], [37, 258743], [40, 258863], [48, 259096], [52, 259330], [56, 259563], [59, 259783], [65, 259983], [73, 260563], [76, 260663], [82, 261418], [89, 261736], [92, 262036], [98, 262376], [103, 262676], [110, 263096], [116, 263376], [123, 263676], [128, 264056]]}, {"verse": 40, "start": 265144, "end": 270391, "text": "Jesús le dice: ¿No te he dicho que, si crees, verás la gloria de Dios?", "words": [[0, 265144], [6, 265479], [9, 265719], [15, 266553], [19, 266677], [22, 266857], [25, 266937], [31, 267197], [36, 267437], [39, 267997], [46, 268597], [52, 269137], [55, 269257], [62, 269657], [65, 269797]]}, {"verse": 41, "start": 270741, "end": 281693, "text": "Entonces quitaron la piedra de donde el muerto había sido puesto. Y Jesús, alzando los ojos arriba, dijo: Padre, gracias te doy que me has oído.", "words": [[0, 270741], [9, 271432], [18, 272232], [21, 272412], [28, 272932], [31, 273072], [37, 273332], [40, 273552], [47, 274012], [53, 274232], [58, 274572], [66, 275529], [68, 275638], [75, 276478], [83, 276958], [87, 277178], [92, 277518], [100, 278378], [106, 279104], [113, 279769], [121, 280412], [124, 280504], [128, 280724], [132, 280804], [135, 280944], [139, 281084]]}, {"verse": 42, "start": 282043, "end": 290267, "text": "Que yo sabía que siempre me oyes; pero por causa de la multitud que está alrededor, lo dije, para que crean que tú me has enviado.", "words": [[0, 282043], [4, 282127], [7, 282267], [13, 282647], [17, 282767], [25, 283127], [28, 283407], [34, 284213], [39, 284357], [43, 284597], [49, 284937], [52, 285197], [55, 285577], [64, 285957], [68, 286137], [73, 286357], [84, 287217], [87, 287317], [93, 287617], [98, 288137], [102, 288337], [108, 288737], [112, 288897], [115, 289077], [118, 289277], [122, 289477]]}, {"verse": 43, "start": 290617, "end": 295721, "text": "Y habiendo dicho estas cosas, clamó a gran voz: Lázaro, ven fuera.", "words": [[0, 290617], [2, 290761], [11, 291101], [17, 291441], [23, 291661], [30, 292541], [36, 292981], [38, 293081], [43, 293221], [48, 294003], [56, 294968], [60, 295108]]}, {"verse": 44, "start": 296071, "end": 309342, "text": "Y el que había estado muerto, salió, atadas las manos y los pies con vendas; y su rostro estaba envuelto en un paño funerario. Les dice Jesús: Desatadle, y dejadle ir.", "words": [[0, 296071], [2, 296168], [5, 296248], [9, 296388], [15, 296608], [22, 296868], [30, 297508], [37, 298308], [44, 299168], [48, 299368], [54, 299768], [56, 300028], [60, 300168], [65, 300388], [69, 300608], [77, 301570], [79, 301674], [82, 301814], [89, 302394], [96, 302714], [105, 303414], [108, 303534], [111, 303694], [116, 304254], [127, 305662], [131, 305856], [136, 306049], [143, 306997], [154, 307774], [156, 308234], [164, 308854]]}, {"verse": 45, "start": 309692, "end": 317919, "text": "Entonces muchos de los judíos que habían venido a María, y habían visto lo que había hecho Jesús, creyeron en él.", "words": [[0, 309692], [9, 310495], [16, 310935], [19, 311155], [23, 311255], [30, 311715], [34, 311875], [41, 312115], [48, 312555], [50, 312635], [57, 312935], [59, 313400], [66, 313680], [72, 314120], [75, 314720], [79, 314860], [85, 315140], [91, 315440], [98, 316370], [107, 317300], [110, 317620]]}, {"verse": 46, "start": 318269, "end": 323338, "text": "Pero algunos de ellos fueron a los fariseos, y les dijeron lo que Jesús había hecho.", "words": [[0, 318269], [5, 318415], [13, 318775], [16, 318995], [22, 319275], [29, 319595], [31, 319855], [35, 319955], [45, 320695], [47, 321055], [51, 321195], [59, 321675], [62, 321815], [66, 321955], [72, 322235], [78, 322675]]}, {"verse": 47, "start": 323688, "end": 332592, "text": "Entonces los principales sacerdotes y los fariseos reunieron el Consejo, y decían: ¿Qué hacemos? porque este hombre hace muchas señales.", "words": [[0, 323688], [9, 324193], [13, 324693], [25, 325373], [36, 326053], [38, 326193], [42, 326333], [51, 327093], [61, 327853], [64, 328033], [73, 328653], [75, 328833], [83, 329703], [88, 329803], [97, 330681], [104, 330865], [109, 331045], [116, 331305], [121, 331565], [128, 331845]]}, {"verse": 48, "start": 332942, "end": 338799, "text": "Si le dejamos así, todos creerán en él: y vendrán los Romanos, y quitarán nuestro lugar y la nación.", "words": [[0, 332942], [3, 333062], [6, 333182], [14, 333522], [19, 334322], [25, 334462], [33, 335022], [36, 335122], [40, 335637], [42, 335753], [50, 336093], [54, 336213], [63, 336773], [65, 337033], [74, 337453], [82, 337633], [88, 338033], [90, 338193], [93, 338293]]}, {"verse": 49, "start": 339079, "end": 345474, "text": "Y Caifás, uno de ellos, sumo sacerdote de aquel año, les dijo: Vosotros no sabéis nada;", "words": [[0, 339079], [2, 339224], [10, 340224], [14, 340384], [17, 340584], [24, 341324], [29, 341704], [39, 342344], [42, 342544], [48, 342824], [53, 343064], [57, 343304], [63, 344030], [72, 344454], [75, 344654], [82, 345014]]}, {"verse": 50, "start": 345824, "end": 351227, "text": "Ni pensáis que nos conviene que un hombre muera por el pueblo, y no que toda la nación se pierda.", "words": [[0, 345824], [3, 345948], [11, 346448], [15, 346628], [19, 346788], [28, 347288], [32, 347468], [35, 347628], [42, 347868], [48, 348268], [52, 348468], [55, 348608], [63, 349008], [65, 349468], [68, 349608], [72, 349768], [77, 349948], [80, 350168], [87, 350528], [90, 350688]]}, {"verse": 51, "start": 351507, "end": 360516, "text": "Pero esto no lo dijo de sí mismo; sino que, como era el sumo sacerdote de aquel año, profetizó que Jesús había de morir por la nación:", "words": [[0, 351507], [5, 351651], [10, 351871], [13, 352071], [16, 352191], [21, 352471], [24, 352671], [27, 352811], [34, 353523], [39, 353723], [44, 354175], [49, 354395], [53, 354615], [56, 354775], [61, 355335], [71, 356035], [74, 356235], [80, 356535], [85, 357200], [95, 357800], [99, 357980], [105, 358340], [111, 358840], [114, 359120], [120, 359520], [124, 359680], [127, 359860]]}, {"verse": 52, "start": 360866, "end": 367728, "text": "Y no solamente por aquella nación, sino también para que juntase en uno los hijos de Dios que estaban dispersos.", "words": [[0, 360866], [2, 361011], [5, 361131], [15, 361511], [19, 361931], [27, 362271], [35, 363111], [40, 363431], [48, 363871], [53, 364191], [57, 364491], [65, 364791], [68, 365091], [72, 365291], [76, 365531], [82, 365831], [85, 366091], [90, 366311], [94, 366471], [102, 366731]]}, {"verse": 53, "start": 368078, "end": 371713, "text": "Así que, desde aquel día planeaban juntos matarle.", "words": [[0, 368078], [4, 368476], [9, 368676], [15, 368996], [21, 369416], [25, 369656], [35, 370376], [42, 370736]]}, {"verse": 54, "start": 372063, "end": 385827, "text": "Por tanto, Jesús ya no andaba abiertamente entre los judíos; sino que se alejó de allí a la región contigua al desierto, a una ciudad llamada Efraín: y estábase allí con sus discípulos.", "words": [[0, 372063], [4, 372207], [11, 372507], [17, 373027], [20, 373687], [23, 373907], [30, 374447], [43, 375327], [49, 375667], [53, 375887], [61, 376977], [66, 377174], [70, 377354], [73, 377514], [79, 377914], [82, 378034], [87, 378314], [89, 378494], [92, 378594], [99, 379204], [108, 379814], [111, 379894], [121, 380854], [123, 381054], [127, 381194], [134, 381534], [142, 382214], [150, 383361], [152, 383688], [161, 384048], [166, 384368], [170, 384608], [174, 384828]]}, {"verse": 55, "start": 386177, "end": 394394, "text": "Y la Pascua de los judíos estaba cerca: y muchos subieron de aquella tierra a Jerusalén antes de la Pascua, para purificarse;", "words": [[0, 386177], [2, 386303], [5, 386653], [12, 387003], [15, 387063], [19, 387203], [26, 387703], [33, 387983], [40, 388947], [42, 389071], [49, 389351], [58, 389971], [61, 390151], [69, 390511], [76, 390851], [78, 391151], [88, 391791], [94, 392131], [97, 392311], [100, 392411], [108, 392931], [113, 393331]]}, {"verse": 56, "start": 394744, "end": 401615, "text": "Y buscaban a Jesús, y hablaban los unos con los otros estando en el templo: ¿Qué os parece, que no vendrá a la fiesta?", "words": [[0, 394744], [2, 394909], [11, 395409], [13, 395549], [20, 395829], [22, 396174], [31, 396634], [35, 396814], [40, 397134], [44, 397454], [48, 397654], [54, 398034], [62, 398634], [65, 398774], [68, 398894], [76, 399676], [81, 399777], [84, 399897], [92, 400257], [96, 400437], [99, 400597], [106, 400937], [108, 401017], [111, 401057]]}, {"verse": 57, "start": 401895, "end": 412393, "text": "Y los principales sacerdotes y los fariseos habían dado mandamiento, que si alguno supiese dónde estuviera, lo manifestase, para que le prendiesen.", "words": [[0, 401895], [2, 402003], [6, 402123], [18, 402823], [29, 403543], [31, 403703], [35, 403823], [44, 404563], [51, 404808], [56, 405208], [69, 405988], [73, 406428], [76, 406568], [83, 407008], [91, 407448], [97, 407728], [108, 409028], [111, 409128], [124, 410588], [129, 411248], [133, 411408], [136, 411528]]}]}