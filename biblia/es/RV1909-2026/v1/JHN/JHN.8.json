{"book": "JHN", "chapter": 8, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 494356, "verses": [{"verse": 1, "start": 300, "end": 3196, "text": "Y Jesús se fue al monte de los Olivos.", "words": [[0, 300], [2, 466], [8, 826], [11, 1446], [15, 1686], [18, 1866], [24, 2206], [27, 2426], [31, 2566]]}, {"verse": 2, "start": 3646, "end": 10491, "text": "Y por la mañana volvió al templo, y todo el pueblo vino a él: y sentado él, los enseñaba.", "words": [[0, 3646], [2, 3750], [6, 3910], [9, 4070], [16, 4390], [23, 4890], [26, 5030], [34, 5790], [36, 5950], [41, 6210], [44, 6410], [51, 6690], [56, 7090], [58, 7350], [62, 8027], [64, 8131], [72, 8671], [76, 8951], [80, 9411]]}, {"verse": 3, "start": 10941, "end": 18632, "text": "Entonces los escribas y los fariseos le traen una mujer sorprendida en adulterio; y poniéndola en medio,", "words": [[0, 10941], [9, 11385], [13, 11645], [22, 12305], [24, 12445], [28, 12585], [37, 13345], [40, 13825], [46, 14265], [50, 14425], [56, 14685], [68, 15585], [71, 15705], [82, 16988], [84, 17093], [95, 17773], [98, 17973]]}, {"verse": 4, "start": 19082, "end": 23786, "text": "Le dicen: Maestro, esta mujer ha sido sorprendida en el acto de adulterio;", "words": [[0, 19082], [3, 19479], [10, 20160], [19, 20561], [24, 20781], [30, 21081], [33, 21341], [38, 21521], [50, 22321], [53, 22521], [56, 22641], [61, 22961], [64, 23041]]}, {"verse": 5, "start": 24236, "end": 28717, "text": "Y en la ley Moisés nos mandó apedrear a las tales: tú pues, ¿qué dices?", "words": [[0, 24236], [2, 24337], [5, 24417], [8, 24537], [12, 24717], [19, 25137], [23, 25477], [29, 25927], [38, 26377], [40, 26437], [44, 26577], [51, 27478], [54, 27596], [60, 28136], [65, 28216]]}, {"verse": 6, "start": 29067, "end": 37847, "text": "Pero esto decían tentándole, para poder acusarle. Pero Jesús, inclinado hacia abajo, escribía en tierra con el dedo.", "words": [[0, 29067], [5, 29210], [10, 29770], [17, 30330], [29, 30890], [34, 31790], [40, 32130], [50, 33364], [55, 33508], [62, 34188], [72, 34828], [78, 35048], [85, 35648], [94, 36268], [97, 36428], [104, 36768], [108, 37088], [111, 37268]]}, {"verse": 7, "start": 38297, "end": 48161, "text": "Y como perseverasen preguntándole, se enderezó, y les dijo: El que de vosotros esté sin pecado, arroje contra ella la piedra el primero.", "words": [[0, 38297], [2, 38561], [7, 39111], [20, 39661], [35, 40211], [38, 40761], [48, 41581], [50, 41901], [54, 42021], [60, 42915], [63, 43074], [67, 43254], [70, 43394], [79, 43814], [84, 44234], [88, 44654], [96, 45074], [103, 46054], [110, 46434], [115, 46734], [118, 46974], [125, 47434], [128, 47554]]}, {"verse": 8, "start": 48611, "end": 52870, "text": "Y volviéndose a inclinar hacia abajo, escribía en tierra.", "words": [[0, 48611], [2, 48710], [14, 49350], [16, 49670], [25, 49990], [31, 50370], [38, 50830], [47, 52050], [50, 52210]]}, {"verse": 9, "start": 53320, "end": 65185, "text": "Oyendo, pues, ellos, acusados por su conciencia, se salían uno a uno, comenzando desde los más viejos hasta los últimos: y quedó solo Jesús, y la mujer que estaba en medio.", "words": [[0, 53320], [8, 53706], [14, 53946], [21, 54806], [30, 55246], [34, 55486], [37, 55646], [49, 56666], [52, 56746], [59, 57246], [63, 57606], [65, 57886], [70, 58126], [81, 58906], [87, 59266], [91, 59606], [95, 59866], [102, 60406], [108, 60726], [112, 60946], [121, 62029], [123, 62165], [129, 62525], [134, 62745], [141, 63225], [143, 63685], [146, 63785], [152, 64045], [156, 64245], [163, 64425], [166, 64605]]}, {"verse": 10, "start": 65635, "end": 74639, "text": "Y enderezándose Jesús, y no viendo a nadie más que a la mujer, le dijo: ¿Mujer, dónde están los que te acusaban? ¿Ninguno te ha condenado?", "words": [[0, 65635], [2, 65796], [16, 66676], [23, 67076], [25, 67476], [28, 67616], [35, 67876], [37, 68056], [43, 68316], [47, 68536], [51, 68736], [53, 68836], [56, 68876], [63, 69656], [66, 69856], [72, 70722], [80, 71071], [86, 71251], [92, 71651], [96, 71851], [100, 72011], [103, 72111], [113, 73196], [122, 73586], [125, 73766], [128, 73866]]}, {"verse": 11, "start": 75089, "end": 84589, "text": "Y ella dijo: Señor, ninguno. Entonces Jesús le dijo: Ni yo te condeno: vete, y no peques más.", "words": [[0, 75089], [2, 75259], [7, 75429], [13, 76247], [20, 76648], [29, 78823], [38, 79310], [44, 79990], [47, 80430], [53, 81513], [56, 81768], [59, 82022], [62, 82276], [71, 82775], [77, 83223], [79, 83603], [82, 83783], [89, 84063]]}, {"verse": 12, "start": 85039, "end": 95529, "text": "Y les habló Jesús otra vez, diciendo: Yo soy la luz del mundo: el que me sigue, no andará en tinieblas, sino que tendrá la luz de la vida.", "words": [[0, 85039], [2, 85144], [6, 85304], [12, 85664], [18, 85864], [23, 86204], [28, 86504], [38, 87714], [41, 87958], [45, 88258], [48, 88618], [52, 88878], [56, 89198], [63, 90034], [66, 90195], [70, 90335], [73, 90515], [80, 91375], [83, 91595], [90, 91935], [93, 92515], [104, 93095], [109, 93255], [113, 93455], [120, 93915], [123, 94075], [127, 94495], [130, 94895], [133, 95015]]}, {"verse": 13, "start": 95979, "end": 103247, "text": "Entonces los fariseos le dijeron: Tú de ti mismo das testimonio: tu testimonio no es verdadero.", "words": [[0, 95979], [9, 96856], [13, 97436], [22, 98296], [25, 98476], [34, 99473], [37, 99590], [40, 99750], [43, 99910], [49, 100190], [53, 100470], [65, 101633], [68, 101736], [79, 102316], [82, 102456], [85, 102576]]}, {"verse": 14, "start": 103597, "end": 117376, "text": "Respondió Jesús, y les dijo: Aunque yo doy testimonio de mí mismo, mi testimonio es verdadero, porque sé de dónde he venido y a dónde voy; pero vosotros no sabéis de dónde vengo, y a dónde voy.", "words": [[0, 103887], [10, 104177], [17, 104517], [19, 104857], [23, 104997], [29, 105933], [36, 106313], [39, 106593], [43, 106833], [54, 107533], [57, 107653], [60, 107813], [67, 108693], [70, 108933], [81, 109613], [84, 109693], [95, 110353], [102, 110853], [105, 111133], [108, 111313], [114, 111533], [117, 111873], [124, 112433], [126, 112753], [128, 112833], [134, 113073], [139, 113916], [144, 114080], [153, 114540], [156, 114700], [163, 115160], [166, 115360], [172, 115540], [179, 116100], [181, 116580], [183, 116720], [189, 116900]]}, {"verse": 15, "start": 117826, "end": 122293, "text": "Vosotros según la carne juzgáis; pero yo no juzgo a nadie.", "words": [[0, 117826], [9, 118713], [15, 118933], [18, 119173], [24, 119513], [33, 120749], [38, 120916], [41, 121096], [44, 121216], [50, 121636], [52, 121756]]}, {"verse": 16, "start": 122743, "end": 131270, "text": "Y si yo juzgo, mi juicio es verdadero; porque no soy solo, sino yo y el que me envió, el Padre.", "words": [[0, 122743], [2, 122891], [5, 122991], [8, 123151], [15, 124071], [18, 124191], [25, 124611], [28, 125071], [39, 126369], [46, 126594], [49, 126814], [53, 127034], [59, 127914], [64, 128234], [67, 128914], [69, 129434], [72, 129594], [76, 129754], [79, 129914], [86, 130334], [89, 130574]]}, {"verse": 17, "start": 131720, "end": 136947, "text": "Y en vuestra ley está escrito que el testimonio de dos hombres es verdadero.", "words": [[0, 131720], [2, 131863], [5, 131983], [13, 132403], [17, 132803], [22, 133323], [30, 133663], [34, 133923], [37, 134043], [48, 134763], [51, 134883], [55, 135083], [63, 135483], [66, 135943]]}, {"verse": 18, "start": 137397, "end": 143843, "text": "Yo soy el que doy testimonio de mí mismo: y da testimonio de mí el que me envió, el Padre.", "words": [[0, 137397], [3, 137583], [7, 137863], [10, 138063], [14, 138203], [18, 138483], [29, 139163], [32, 139263], [35, 139403], [42, 140319], [44, 140434], [47, 140554], [58, 141294], [61, 141394], [64, 141614], [67, 141914], [71, 142074], [74, 142234], [81, 143054], [84, 143194]]}, {"verse": 19, "start": 144293, "end": 159156, "text": "Y le decían: ¿Dónde está tu Padre? Respondió Jesús: Ni a mí me conocéis, ni a mi Padre; si a mí me conocieseis, a mi Padre también conocierais.", "words": [[0, 144293], [2, 144422], [5, 144522], [13, 145536], [20, 145804], [25, 146044], [28, 146164], [35, 150349], [45, 150789], [52, 151918], [55, 152118], [57, 152218], [60, 152358], [63, 152498], [73, 153138], [76, 153778], [78, 153838], [81, 153918], [88, 154895], [91, 155054], [93, 155174], [96, 155414], [99, 156124], [112, 156834], [114, 156914], [117, 157074], [123, 157414], [131, 158309]]}, {"verse": 20, "start": 159606, "end": 169578, "text": "Estas palabras habló Jesús en el lugar de las limosnas, enseñando en el templo: y nadie le prendió; porque aún no había venido su hora.", "words": [[0, 159606], [6, 159946], [15, 160306], [21, 160886], [27, 161286], [30, 161766], [33, 161886], [39, 162246], [42, 162446], [46, 163066], [56, 163686], [66, 164486], [69, 164606], [72, 164726], [80, 165652], [82, 165795], [88, 166115], [91, 166355], [100, 167313], [107, 167537], [111, 167817], [114, 168117], [120, 168377], [127, 168817], [130, 169017]]}, {"verse": 21, "start": 170027, "end": 180807, "text": "Y les dijo otra vez Jesús: Yo me voy, y me buscaréis, pero en vuestro pecado moriréis: a donde yo voy, vosotros no podéis venir.", "words": [[0, 170027], [2, 170327], [6, 170467], [11, 170807], [16, 171107], [20, 171387], [27, 172332], [30, 172559], [33, 172719], [38, 172999], [40, 173319], [43, 173459], [54, 174559], [59, 174899], [62, 175079], [70, 175459], [77, 175979], [87, 177475], [89, 177644], [95, 177824], [98, 178104], [103, 179004], [112, 179484], [115, 179704], [122, 180144]]}, {"verse": 22, "start": 181257, "end": 188625, "text": "Decían entonces los judíos: ¿Se va a matar a sí mismo, que dice: A donde yo voy, vosotros no podéis venir?", "words": [[0, 181257], [7, 181863], [16, 182643], [20, 183183], [28, 184226], [32, 184361], [35, 184541], [37, 184621], [43, 184861], [45, 185021], [48, 185161], [55, 185481], [59, 185681], [65, 186465], [67, 186567], [73, 186727], [76, 186967], [81, 187187], [90, 187687], [93, 187867], [100, 188167]]}, {"verse": 23, "start": 188975, "end": 197896, "text": "Y les decía: Vosotros sois de abajo, yo soy de arriba; vosotros sois de este mundo, yo no soy de este mundo.", "words": [[0, 188975], [2, 189257], [6, 189577], [13, 190152], [22, 190775], [27, 191415], [30, 191555], [37, 192455], [40, 192575], [44, 192835], [47, 193015], [55, 193982], [64, 194528], [69, 195048], [72, 195228], [77, 195408], [84, 196148], [87, 196508], [90, 196608], [94, 196888], [97, 197088], [102, 197248]]}, {"verse": 24, "start": 198346, "end": 207141, "text": "Por eso os dije que moriréis en vuestros pecados; porque si no creéis que yo soy, en vuestros pecados moriréis.", "words": [[0, 198346], [4, 198546], [8, 198786], [11, 199066], [16, 199386], [20, 199626], [29, 200426], [32, 200646], [41, 201106], [50, 202221], [57, 202445], [60, 202645], [63, 202865], [70, 203405], [74, 203565], [77, 203785], [82, 204225], [85, 204745], [94, 205185], [102, 206225]]}, {"verse": 25, "start": 207591, "end": 216619, "text": "Y le decían: ¿Tú quién eres? Entonces Jesús les dijo: Quien os he dicho desde el principio.", "words": [[0, 207591], [2, 207720], [5, 207820], [13, 208834], [17, 208974], [23, 209214], [29, 211190], [38, 211656], [44, 212376], [48, 212896], [54, 213724], [60, 214114], [63, 214434], [66, 214674], [72, 214994], [78, 215474], [81, 215794]]}, {"verse": 26, "start": 217069, "end": 227296, "text": "Muchas cosas tengo que decir y juzgar de vosotros: pero el que me envió, es verdadero: y yo, lo que he oído de él, esto hablo en el mundo.", "words": [[0, 217069], [7, 217296], [13, 217676], [19, 217996], [23, 218216], [29, 218596], [31, 218896], [38, 219396], [41, 219576], [51, 220618], [56, 220783], [59, 220923], [63, 221063], [66, 221223], [73, 221663], [76, 222263], [87, 223445], [89, 223591], [93, 223811], [96, 223991], [100, 224191], [103, 224491], [108, 224931], [111, 225191], [115, 225571], [120, 225871], [126, 226391], [129, 226531], [132, 226671]]}, {"verse": 27, "start": 227746, "end": 230760, "text": "Pero no entendieron que él les hablaba del Padre.", "words": [[0, 227746], [5, 227890], [8, 228050], [20, 228730], [24, 228990], [27, 229230], [31, 229410], [39, 229890], [43, 230050]]}, {"verse": 28, "start": 231210, "end": 243638, "text": "Les dijo pues, Jesús: Cuando levantéis al Hijo del hombre, entonces entenderéis que yo soy, y que nada hago de mí mismo; pero como el Padre me enseñó, esto hablo.", "words": [[0, 231210], [4, 231504], [9, 231784], [15, 232124], [22, 233227], [29, 233431], [39, 234191], [42, 234411], [47, 234651], [51, 234871], [59, 235651], [68, 235851], [80, 236871], [84, 237051], [87, 237251], [92, 237631], [94, 238071], [98, 238231], [103, 238531], [108, 239071], [111, 239251], [114, 239431], [121, 240366], [126, 240512], [131, 240772], [134, 240932], [140, 241292], [143, 241532], [151, 242732], [156, 242972]]}, {"verse": 29, "start": 244088, "end": 252220, "text": "Porque el que me envió, conmigo está; no me ha dejado solo el Padre; porque yo, lo que a él agrada, hago siempre.", "words": [[0, 244088], [7, 244291], [10, 244451], [14, 244591], [17, 244711], [24, 245091], [32, 245851], [38, 247139], [41, 247289], [44, 247429], [47, 247509], [54, 247929], [59, 248229], [62, 248409], [69, 250048], [76, 250048], [80, 250048], [83, 250153], [87, 250333], [89, 250473], [92, 250613], [100, 251053], [105, 251433]]}, {"verse": 30, "start": 252670, "end": 256279, "text": "Hablando él estas cosas, muchos creyeron en él.", "words": [[0, 252670], [9, 252937], [12, 253247], [18, 253467], [25, 254367], [32, 254927], [41, 255487], [44, 255847]]}, {"verse": 31, "start": 256729, "end": 265868, "text": "Y decía Jesús a los judíos que le habían creído: Si vosotros permanecéis en mi palabra, seréis verdaderamente mis discípulos;", "words": [[0, 256729], [2, 256836], [8, 257276], [14, 257516], [16, 257756], [20, 257876], [27, 258356], [31, 258476], [34, 258596], [41, 258876], [49, 259842], [52, 260026], [61, 260626], [73, 261706], [76, 261826], [79, 261966], [88, 262986], [95, 263666], [110, 264726], [114, 264946]]}, {"verse": 32, "start": 266318, "end": 270012, "text": "Y conoceréis la verdad, y la verdad os libertará.", "words": [[0, 266318], [2, 266405], [13, 267105], [16, 267285], [24, 267645], [26, 268305], [29, 268425], [36, 268765], [39, 269105]]}, {"verse": 33, "start": 270462, "end": 278422, "text": "Y le respondieron: Linaje de Abraham somos, y jamás fuimos esclavos de nadie: ¿cómo dices tú: Seréis libres?", "words": [[0, 270462], [2, 270611], [5, 270731], [19, 272075], [26, 272513], [29, 272713], [37, 273053], [44, 273473], [46, 273993], [52, 274373], [59, 274753], [68, 275373], [71, 275493], [78, 276291], [84, 276449], [90, 276749], [94, 277425], [101, 277752]]}, {"verse": 34, "start": 278772, "end": 286860, "text": "Jesús les respondió: De cierto, de cierto os digo, que todo aquel que hace pecado, es esclavo del pecado.", "words": [[0, 278772], [6, 279135], [10, 279532], [21, 280677], [24, 281153], [32, 281630], [35, 282107], [42, 282583], [45, 283060], [51, 283240], [55, 283460], [60, 283700], [66, 284080], [70, 284180], [75, 284380], [83, 284920], [86, 285460], [94, 285943], [98, 286425]]}, {"verse": 35, "start": 287310, "end": 292014, "text": "Y el esclavo no queda en casa para siempre: el hijo queda para siempre.", "words": [[0, 287310], [2, 287454], [5, 287754], [13, 288054], [16, 288254], [22, 288494], [25, 288674], [30, 288994], [35, 289274], [44, 290278], [47, 290638], [52, 290838], [58, 291118], [63, 291358]]}, {"verse": 36, "start": 292464, "end": 296809, "text": "Así que, si el Hijo os libera, seréis verdaderamente libres.", "words": [[0, 292464], [4, 292780], [9, 292980], [12, 293180], [15, 293400], [20, 293530], [23, 293660], [31, 294360], [38, 294980], [53, 296020]]}, {"verse": 37, "start": 297259, "end": 303990, "text": "Sé que sois descendientes de Abraham, pero procuráis matarme, porque mi palabra no cabe en vosotros.", "words": [[0, 297259], [3, 297421], [7, 297541], [12, 297921], [26, 298921], [29, 299081], [38, 300101], [43, 300241], [53, 300821], [62, 301501], [69, 301921], [72, 302141], [80, 302481], [83, 302761], [88, 303061], [91, 303261]]}, {"verse": 38, "start": 304440, "end": 311371, "text": "Yo hablo lo que he visto cerca del Padre; y vosotros hacéis lo que habéis oído cerca de vuestro padre.", "words": [[0, 304440], [3, 304666], [9, 305046], [12, 305206], [16, 305406], [19, 305506], [25, 305746], [31, 306086], [35, 306406], [42, 307377], [44, 307504], [53, 307944], [60, 308604], [63, 308924], [67, 309064], [74, 309364], [79, 309724], [85, 310064], [88, 310424], [96, 310744]]}, {"verse": 39, "start": 311821, "end": 323430, "text": "Respondieron y le dijeron: Nuestro padre es Abraham. Les dice Jesús: Si fuerais hijos de Abraham, las obras de Abraham haríais.", "words": [[0, 311821], [13, 312505], [15, 312805], [18, 312925], [27, 314758], [35, 315098], [41, 315538], [44, 315718], [53, 317288], [57, 317437], [62, 317737], [69, 318822], [72, 319164], [80, 319544], [86, 319864], [89, 320104], [98, 321264], [102, 321364], [108, 321704], [111, 321924], [119, 322344]]}, {"verse": 40, "start": 323880, "end": 332979, "text": "Pero ahora procuráis matarme, hombre que os he hablado la verdad, la cual he oído de Dios: no hizo esto Abraham.", "words": [[0, 323880], [5, 324026], [11, 324366], [21, 325046], [30, 326286], [37, 326626], [41, 326866], [44, 327086], [47, 327226], [55, 327726], [58, 327886], [66, 328686], [69, 328946], [74, 329186], [77, 329506], [82, 329886], [85, 330106], [91, 331036], [94, 331494], [99, 331874], [104, 332414]]}, {"verse": 41, "start": 333429, "end": 343550, "text": "Vosotros hacéis las obras de vuestro padre. Le dijeron entonces: Nosotros no somos nacidos de fornicación; un padre tenemos, que es Dios.", "words": [[0, 333429], [9, 334035], [16, 334955], [20, 335175], [26, 335555], [29, 335815], [37, 336195], [44, 337092], [47, 337217], [55, 337697], [65, 338885], [74, 339350], [77, 339550], [83, 339870], [91, 340410], [94, 340590], [107, 341727], [110, 341870], [116, 342170], [125, 342530], [129, 342910], [132, 343050]]}, {"verse": 42, "start": 343900, "end": 356936, "text": "Jesús entonces les dijo: Si vuestro padre fuera Dios, ciertamente me amaríais: porque yo de Dios he salido, y he venido; que no he venido de mí mismo, sino que él me envió.", "words": [[0, 343900], [6, 344225], [15, 344965], [19, 345545], [25, 346393], [28, 346552], [36, 346952], [42, 347372], [48, 347572], [54, 348372], [66, 349072], [69, 349332], [79, 350660], [86, 350844], [89, 351084], [92, 351224], [97, 351464], [100, 351664], [108, 351855], [110, 352046], [113, 352238], [121, 353625], [125, 353765], [128, 353945], [131, 354065], [138, 354465], [141, 354625], [144, 354805], [151, 355345], [156, 355545], [160, 355785], [163, 356085], [166, 356265]]}, {"verse": 43, "start": 357386, "end": 361553, "text": "¿Por qué no reconocéis mi lenguaje? porque no podéis oír mi palabra.", "words": [[0, 357386], [5, 357509], [9, 357669], [12, 357809], [23, 358489], [26, 358629], [36, 359721], [43, 359851], [46, 359991], [53, 360351], [57, 360691], [60, 360811]]}, {"verse": 44, "start": 362003, "end": 381445, "text": "Vosotros de vuestro padre el diablo sois, y los deseos de vuestro padre queréis cumplir. El, homicida ha sido desde el principio, y no permaneció en la verdad, porque no hay verdad en él. Cuando habla mentira, de lo suyo habla; porque es mentiroso, y padre de mentira.", "words": [[0, 362003], [9, 362502], [12, 362722], [20, 363102], [26, 363642], [29, 363882], [36, 364282], [42, 364962], [44, 365582], [48, 365762], [55, 366362], [58, 366482], [66, 366862], [72, 367322], [80, 367682], [89, 368842], [93, 368966], [102, 369486], [105, 369626], [110, 369846], [116, 370126], [119, 370366], [130, 371126], [132, 371926], [135, 372066], [146, 372786], [149, 372926], [152, 373066], [160, 373406], [167, 374006], [170, 374266], [174, 374406], [181, 374726], [184, 374986], [188, 375695], [195, 375877], [201, 376197], [210, 376777], [213, 376917], [216, 377057], [221, 377417], [228, 378225], [235, 378449], [238, 378629], [249, 379629], [251, 380049], [257, 380429], [260, 380649]]}, {"verse": 45, "start": 381895, "end": 384881, "text": "Y porque yo digo verdad, no me creéis.", "words": [[0, 381895], [2, 382019], [9, 382339], [12, 382599], [17, 382819], [25, 383619], [28, 383859], [31, 384019]]}, {"verse": 46, "start": 385331, "end": 391199, "text": "¿Quién de vosotros demuestra que he pecado? Pues si digo verdad, ¿por qué vosotros no me creéis?", "words": [[0, 385331], [7, 385554], [10, 385674], [19, 386114], [29, 386734], [33, 386854], [36, 386974], [44, 387955], [49, 388080], [52, 388260], [57, 388480], [65, 389280], [70, 389540], [74, 389680], [83, 390140], [86, 390320], [89, 390400]]}, {"verse": 47, "start": 391649, "end": 399546, "text": "El que es de Dios, las palabras de Dios oye: por esto no las oís vosotros, porque no sois de Dios.", "words": [[0, 391649], [3, 391795], [7, 391955], [10, 392155], [13, 392255], [19, 393115], [23, 393215], [32, 393695], [35, 393955], [40, 394215], [45, 395056], [49, 395183], [54, 395403], [57, 395703], [61, 395983], [65, 396503], [75, 397463], [82, 398063], [85, 398303], [90, 398783], [93, 399023]]}, {"verse": 48, "start": 399996, "end": 407385, "text": "Respondieron entonces los judíos, y le dijeron: ¿No decimos bien nosotros, que tú eres samaritano, y tienes demonio?", "words": [[0, 399996], [13, 400704], [22, 401224], [26, 401544], [34, 402084], [36, 402224], [39, 402324], [48, 403341], [52, 403521], [60, 404021], [65, 404201], [75, 404701], [79, 405101], [82, 405321], [87, 405541], [99, 406281], [101, 406521], [108, 406781]]}, {"verse": 49, "start": 407735, "end": 414984, "text": "Respondió Jesús: Yo no tengo demonio, antes honro a mi Padre; y vosotros me habéis deshonrado.", "words": [[0, 407839], [10, 408279], [17, 409240], [20, 409408], [23, 409548], [29, 409848], [38, 410588], [44, 411008], [50, 411708], [52, 411848], [55, 411928], [62, 412844], [64, 413078], [73, 413558], [76, 413778], [83, 414058]]}, {"verse": 50, "start": 415434, "end": 419122, "text": "Y no busco mi gloria: hay quien la busque, y juzgue.", "words": [[0, 415434], [2, 415539], [5, 415639], [11, 415979], [14, 416119], [22, 417034], [26, 417201], [32, 417461], [35, 417621], [43, 418041], [45, 418501]]}, {"verse": 51, "start": 419572, "end": 425952, "text": "De cierto, de cierto os digo, que el que guarda mi palabra, no verá muerte para siempre.", "words": [[0, 419798], [3, 420058], [11, 420318], [14, 420578], [21, 420838], [24, 421058], [30, 421878], [34, 422158], [37, 422338], [41, 422518], [48, 422998], [51, 423118], [60, 423898], [63, 424178], [68, 424458], [75, 424898], [80, 425178]]}, {"verse": 52, "start": 426402, "end": 437658, "text": "Entonces los judíos le dijeron: Ahora conocemos que tienes demonio. Abraham murió, y los profetas, y tú dices: El que guarda mi palabra, no gustará muerte para siempre.", "words": [[0, 426402], [9, 427370], [13, 427510], [20, 427950], [23, 428090], [32, 429053], [38, 429335], [48, 429895], [52, 430075], [59, 430335], [68, 431299], [76, 431702], [83, 432202], [85, 432302], [89, 432442], [99, 433382], [101, 433502], [104, 433662], [111, 434544], [114, 434668], [118, 434768], [125, 435128], [128, 435208], [137, 435628], [140, 436028], [148, 436448], [155, 436808], [160, 437048]]}, {"verse": 53, "start": 438108, "end": 444242, "text": "¿Eres tú mayor que nuestro padre Abraham, el cual murió? y los profetas murieron: ¿quién te haces a ti mismo?", "words": [[0, 438108], [6, 438305], [9, 438465], [15, 438765], [19, 438965], [27, 439145], [33, 439565], [42, 440205], [45, 440285], [50, 440445], [57, 441318], [59, 441398], [63, 441498], [72, 441978], [82, 442936], [89, 443164], [92, 443264], [98, 443544], [100, 443684], [103, 443744]]}, {"verse": 54, "start": 444592, "end": 454161, "text": "Respondió Jesús: Si yo me glorifico a mí mismo, mi gloria es nada: mi Padre es el que me glorifica; el que vosotros decís que es vuestro Dios;", "words": [[0, 444696], [10, 445136], [17, 446097], [20, 446241], [23, 446441], [26, 446561], [36, 447221], [38, 447281], [41, 447401], [48, 447881], [51, 448001], [58, 448381], [61, 448521], [67, 449275], [70, 449403], [76, 449723], [79, 450003], [82, 450123], [86, 450243], [89, 450403], [100, 451556], [103, 451796], [107, 451916], [116, 452456], [122, 452996], [126, 453116], [129, 453236], [137, 453616]]}, {"verse": 55, "start": 454611, "end": 463657, "text": "Y no le conocéis: pero yo le conozco; y si digo que no le conozco, seré como vosotros mentiroso: pero le conozco, y guardo su palabra.", "words": [[0, 454611], [2, 454711], [5, 454871], [8, 455011], [18, 456304], [23, 456424], [26, 456574], [29, 456724], [38, 457766], [40, 458016], [43, 458156], [48, 458416], [52, 458576], [55, 458736], [58, 458856], [67, 459376], [72, 459676], [77, 459876], [86, 460396], [97, 461638], [102, 461784], [105, 461924], [114, 462404], [116, 462504], [123, 462844], [126, 463004]]}, {"verse": 56, "start": 464107, "end": 469657, "text": "Abraham vuestro padre se gozó por ver mi día; y lo vio, y se gozó.", "words": [[0, 464389], [8, 464709], [16, 465089], [22, 465389], [25, 465689], [30, 466109], [34, 466289], [38, 466509], [41, 466689], [46, 467544], [48, 467685], [51, 467805], [56, 468105], [58, 468845], [61, 469085]]}, {"verse": 57, "start": 470107, "end": 476066, "text": "Le dijeron entonces los judíos: Aún no tienes cincuenta años, ¿y has visto a Abraham?", "words": [[0, 470107], [3, 470235], [11, 470775], [20, 471255], [24, 471615], [32, 472751], [36, 472994], [39, 473281], [46, 473567], [56, 473854], [62, 474374], [65, 474874], [69, 475034], [75, 475174], [77, 475314]]}, {"verse": 58, "start": 476416, "end": 483900, "text": "Les dijo Jesús: De cierto, de cierto os digo: Antes que Abraham fuese, yo soy.", "words": [[0, 476471], [4, 476561], [9, 476841], [16, 478253], [19, 478625], [27, 478997], [30, 479369], [37, 479741], [40, 479961], [46, 480750], [52, 481137], [56, 481437], [64, 481817], [71, 482677], [74, 482917]]}, {"verse": 59, "start": 484350, "end": 493956, "text": "Tomaron entonces piedras para tirarle: pero Jesús se ocultó, y salió del templo; y atravesando por medio de ellos, se fue.", "words": [[0, 484350], [8, 485192], [17, 485592], [25, 486192], [30, 486372], [39, 487422], [44, 487547], [50, 487887], [53, 488287], [61, 488867], [63, 489227], [69, 489587], [73, 489747], [81, 490711], [83, 490839], [95, 491579], [99, 491839], [105, 492199], [108, 492459], [115, 493239], [118, 493559]]}]}