{"book": "LUK", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 478527, "verses": [{"verse": 1, "start": 300, "end": 11331, "text": "Y aconteció que estando él orando en un lugar, cuando acabó, uno de sus discípulos le dijo: Señor, enséñanos a orar, como también Juan enseñó a sus discípulos.", "words": [[0, 300], [2, 419], [12, 1179], [16, 1439], [24, 1939], [27, 2179], [34, 2599], [37, 2759], [40, 2899], [47, 3799], [54, 4019], [61, 5099], [65, 5259], [68, 5439], [72, 5619], [83, 6299], [86, 6499], [92, 7225], [99, 7620], [109, 8100], [111, 8320], [117, 8860], [122, 9000], [130, 9420], [135, 9760], [142, 10320], [144, 10401], [148, 10540]]}, {"verse": 2, "start": 11611, "end": 25045, "text": "Y les dijo: Cuando oréis, decid: Padre nuestro que estás en los cielos; sea tu nombre santificado. Venga tu reino. Sea hecha tu voluntad, como en el cielo, así también en la tierra.", "words": [[0, 11611], [2, 11740], [6, 11900], [12, 12643], [19, 12907], [26, 13861], [33, 14782], [39, 15142], [47, 15342], [51, 15802], [57, 16042], [60, 16282], [64, 16422], [72, 17521], [76, 17757], [79, 17997], [86, 18317], [99, 19739], [105, 20066], [108, 20246], [115, 20956], [119, 21296], [125, 21696], [128, 21876], [138, 22556], [143, 22776], [146, 22936], [149, 23056], [156, 23576], [160, 23756], [168, 24136], [171, 24316], [174, 24436]]}, {"verse": 3, "start": 25395, "end": 28742, "text": "El pan nuestro de cada día, dánoslo hoy.", "words": [[0, 25395], [3, 25552], [7, 25832], [15, 26392], [18, 26632], [23, 26852], [28, 27752], [36, 28272]]}, {"verse": 4, "start": 28742, "end": 38828, "text": "Y perdónanos nuestros pecados, porque también nosotros perdonamos a todos los que nos deben. Y no nos metas en tentación, sino líbranos del malo.", "words": [[0, 28817], [2, 28892], [13, 29612], [22, 29972], [31, 30672], [38, 31192], [46, 31652], [55, 32072], [66, 32992], [68, 33172], [74, 33532], [78, 33852], [82, 34032], [86, 34152], [93, 35010], [95, 35135], [98, 35235], [102, 35415], [108, 35875], [111, 36015], [122, 36635], [127, 37135], [136, 38035], [140, 38295]]}, {"verse": 5, "start": 39178, "end": 47759, "text": "Les dijo también: ¿Quién de vosotros tendrá un amigo, e irá a él a media noche, y le dirá: Amigo, préstame tres panes,", "words": [[0, 39178], [4, 39313], [9, 39593], [18, 40441], [25, 40742], [28, 40842], [37, 41362], [44, 41802], [47, 41962], [54, 42942], [56, 43042], [60, 43382], [62, 43562], [65, 43762], [67, 44029], [73, 44295], [80, 44562], [82, 44802], [85, 45133], [91, 45640], [98, 46183], [107, 46643], [112, 46983]]}, {"verse": 6, "start": 48109, "end": 52531, "text": "Porque un amigo mío ha venido a mí de camino, y no tengo qué ponerle delante;", "words": [[0, 48109], [7, 48311], [10, 48491], [16, 48751], [20, 49171], [23, 49271], [30, 49671], [32, 49791], [35, 49891], [38, 50031], [46, 50451], [48, 50691], [51, 50831], [57, 51151], [61, 51391], [69, 51931]]}, {"verse": 7, "start": 52531, "end": 64503, "text": "Y aquel, respondiendo desde adentro, le dice: No me molestes; la puerta ya está cerrada, y mis niños están conmigo en cama; no puedo levantarme y dártelos?", "words": [[0, 52631], [2, 52671], [9, 53391], [22, 54071], [28, 54291], [37, 55351], [40, 55451], [46, 56287], [49, 56555], [52, 56695], [62, 57920], [65, 58065], [72, 58365], [75, 58725], [80, 58945], [89, 59545], [91, 59665], [95, 59825], [101, 60145], [107, 60545], [115, 61105], [118, 61265], [124, 62388], [127, 62388], [133, 62574], [144, 63474], [146, 63674]]}, {"verse": 8, "start": 64853, "end": 73987, "text": "Os digo, que aunque no se levante a darle por ser su amigo, cierto por su insistencia se levantará, y le dará todo lo que necesite.", "words": [[0, 64853], [3, 64968], [9, 65248], [13, 65648], [20, 65848], [23, 66128], [26, 66288], [34, 66748], [36, 66888], [42, 67168], [46, 67408], [50, 67668], [53, 67908], [60, 68768], [67, 69088], [71, 69448], [74, 69628], [86, 70788], [89, 70928], [100, 71608], [102, 72048], [105, 72188], [110, 72528], [115, 72828], [118, 73108], [122, 73228]]}, {"verse": 9, "start": 74337, "end": 80923, "text": "Y yo os digo: Pedid, y se os dará; buscad, y hallaréis; llamad, y os será abierto.", "words": [[0, 74337], [2, 74485], [5, 74685], [8, 74825], [14, 75680], [21, 75870], [23, 76130], [26, 76270], [29, 76430], [35, 77145], [43, 77710], [45, 78303], [56, 79057], [64, 79618], [66, 80038], [69, 80158], [74, 80398]]}, {"verse": 10, "start": 81273, "end": 87765, "text": "Porque todo aquel que pide, recibe; y el que busca, halla; y al que llama, se abre.", "words": [[0, 81273], [7, 81859], [12, 82219], [18, 82659], [22, 82759], [28, 83359], [36, 84377], [38, 84492], [41, 84612], [45, 84960], [52, 85308], [59, 85876], [61, 86024], [64, 86124], [68, 86304], [75, 86964], [78, 87244]]}, {"verse": 11, "start": 88115, "end": 97469, "text": "¿Y cuál padre de vosotros, si su hijo le pide pan, le dará una piedra? o, si pescado, ¿en lugar de pescado, le dará una serpiente?", "words": [[0, 88115], [3, 88233], [8, 88433], [14, 88783], [17, 89133], [27, 89833], [30, 90373], [33, 90593], [38, 90853], [41, 91033], [46, 91353], [51, 91653], [54, 92253], [59, 92593], [63, 92733], [71, 93682], [74, 93905], [77, 94065], [86, 94665], [90, 94885], [96, 95125], [99, 95365], [108, 95925], [111, 96105], [116, 96385], [120, 96485]]}, {"verse": 12, "start": 97819, "end": 101305, "text": "O, si le pide un huevo, ¿le dará un escorpión?", "words": [[0, 97819], [3, 97945], [6, 98065], [9, 98205], [14, 98525], [17, 98665], [24, 99485], [28, 99745], [33, 100165], [36, 100345]]}, {"verse": 13, "start": 101655, "end": 111886, "text": "Pues si vosotros, siendo malos, sabéis dar buenos regalos a vuestros hijos, ¿cuánto más vuestro Padre celestial dará el Espíritu Santo a los que se lo pidan?", "words": [[0, 101655], [5, 102022], [8, 102214], [18, 102974], [25, 103214], [32, 104094], [39, 104514], [43, 104694], [50, 105034], [58, 105614], [60, 105754], [69, 106114], [76, 106934], [84, 107434], [88, 107654], [96, 108054], [102, 108394], [112, 108914], [117, 109354], [120, 109554], [129, 110094], [135, 110474], [137, 110879], [141, 110999], [145, 111119], [148, 111259], [151, 111399]]}, {"verse": 14, "start": 112236, "end": 120885, "text": "Y estaba él lanzando un demonio, el cual era mudo: y aconteció que salido fuera el demonio, el mudo habló, y la gente se maravilló.", "words": [[0, 112236], [2, 112359], [9, 112659], [12, 112899], [21, 113479], [24, 113619], [33, 114239], [36, 114299], [41, 114479], [45, 114799], [51, 115558], [53, 115648], [63, 116268], [67, 116408], [74, 116868], [80, 117108], [83, 117328], [92, 118268], [95, 118388], [100, 118728], [107, 119068], [109, 119508], [112, 119628], [118, 119908], [121, 120128]]}, {"verse": 15, "start": 121235, "end": 127052, "text": "Pero algunos de ellos decían: En Beelzebú, príncipe de los demonios, echa fuera los demonios.", "words": [[0, 121235], [5, 121436], [13, 121676], [16, 122079], [22, 122483], [30, 123086], [33, 123477], [43, 123907], [52, 124347], [55, 124507], [59, 124647], [69, 125267], [74, 125887], [80, 126087], [84, 126347]]}, {"verse": 16, "start": 127332, "end": 130452, "text": "Y otros, tentando, pedían de él señal del cielo.", "words": [[0, 127332], [2, 127494], [9, 127674], [19, 128354], [26, 128874], [29, 129034], [32, 129194], [38, 129694], [42, 129814]]}, {"verse": 17, "start": 130802, "end": 140631, "text": "Pero él, conociendo los pensamientos de ellos, les dijo: Todo reino dividido contra sí mismo, es asolado; y una casa dividida contra sí misma, cae.", "words": [[0, 130802], [5, 131057], [9, 131347], [20, 131807], [24, 131987], [37, 132667], [40, 132867], [47, 133527], [51, 133667], [57, 134354], [62, 134516], [68, 135076], [77, 135676], [84, 135976], [87, 136236], [94, 136596], [97, 136776], [106, 137924], [108, 138027], [112, 138187], [117, 138507], [126, 139167], [133, 139447], [136, 139667], [143, 140087]]}, {"verse": 18, "start": 140981, "end": 150254, "text": "Y si también Satanás está dividido contra sí mismo, ¿cómo estará en pie su reino? porque decís que en Beelzebú echo yo fuera los demonios.", "words": [[0, 140981], [2, 141087], [5, 141227], [13, 141567], [21, 142367], [26, 142627], [35, 143117], [42, 143607], [45, 144097], [52, 144587], [58, 144827], [65, 145327], [68, 145487], [72, 145647], [75, 145847], [82, 146877], [89, 147017], [95, 147457], [99, 147537], [102, 147890], [111, 148244], [116, 148597], [119, 148857], [125, 149157], [129, 149417]]}, {"verse": 19, "start": 150604, "end": 159977, "text": "Pues si yo echo fuera los demonios en Beelzebú, ¿vuestros hijos en quién los echan fuera? Por tanto, ellos serán vuestros jueces.", "words": [[0, 150604], [5, 150766], [8, 151046], [11, 151356], [16, 151666], [22, 151986], [26, 152226], [35, 152906], [38, 153626], [48, 154346], [58, 154986], [64, 155346], [67, 155866], [73, 156146], [77, 156446], [83, 156746], [90, 157572], [94, 157676], [101, 158036], [107, 158356], [113, 158836], [122, 159256]]}, {"verse": 20, "start": 160327, "end": 167201, "text": "Pero si por el dedo de Dios echo yo fuera los demonios, cierto el reino de Dios ha llegado a vosotros.", "words": [[0, 160327], [5, 160491], [8, 160711], [12, 160991], [15, 161151], [20, 161551], [23, 161651], [28, 162001], [33, 162351], [36, 162491], [42, 162771], [46, 163011], [56, 164071], [63, 164431], [66, 164771], [72, 165231], [75, 165391], [80, 165751], [83, 165991], [91, 166471], [93, 166591]]}, {"verse": 21, "start": 167551, "end": 173167, "text": "Cuando el hombre fuerte y armado guarda su atrio, en paz está lo que posee.", "words": [[0, 167551], [7, 167777], [10, 167997], [17, 168257], [24, 168777], [26, 169017], [33, 169517], [40, 169997], [43, 170177], [50, 171237], [53, 171537], [57, 171817], [62, 172177], [65, 172377], [69, 172517]]}, {"verse": 22, "start": 173517, "end": 181841, "text": "Pero si sobreviniendo otro más fuerte que él, le vence, le quita todas sus armas en que confiaba, y reparte el botín.", "words": [[0, 173517], [5, 173683], [8, 174203], [22, 174723], [27, 175103], [31, 175363], [38, 175743], [42, 176003], [46, 176423], [49, 176683], [56, 177483], [59, 177603], [65, 177923], [71, 178163], [75, 178503], [81, 178883], [84, 179163], [88, 179303], [98, 180023], [100, 180503], [108, 181043], [111, 181465]]}, {"verse": 23, "start": 182191, "end": 187670, "text": "El que no es conmigo, contra mí es; y el que conmigo no recoge, desparrama.", "words": [[0, 182191], [3, 182333], [7, 182473], [10, 182693], [13, 182853], [22, 183393], [29, 183753], [32, 184053], [36, 184711], [38, 184836], [41, 184956], [45, 185096], [53, 185696], [56, 186374], [64, 187051]]}, {"verse": 24, "start": 188020, "end": 199205, "text": "Cuando el espíritu inmundo sale del hombre, anda por lugares secos, buscando reposo; y no hallándolo, dice: Volveré a mi casa, de donde salí.", "words": [[0, 188020], [7, 188207], [10, 188407], [19, 189027], [27, 189507], [32, 189847], [36, 190087], [44, 190447], [49, 191007], [53, 191307], [61, 191707], [68, 192487], [77, 192967], [85, 194210], [87, 194417], [90, 195099], [102, 195782], [108, 196584], [116, 197110], [118, 197210], [121, 197330], [127, 197750], [130, 198350], [136, 198590]]}, {"verse": 25, "start": 199555, "end": 202289, "text": "Y viniendo, la halla barrida y adornada.", "words": [[0, 199555], [2, 199677], [12, 200197], [15, 200417], [21, 200737], [29, 201277], [31, 201457]]}, {"verse": 26, "start": 202639, "end": 212534, "text": "Entonces va, y toma otros siete espíritus peores que él; y entrados, habitan allí: y lo postrero del tal hombre es peor que lo primero.", "words": [[0, 202639], [9, 203187], [13, 203727], [15, 203967], [20, 204247], [26, 204587], [32, 205027], [42, 205727], [49, 206187], [53, 206427], [57, 207046], [59, 207207], [69, 207907], [77, 208687], [83, 209301], [85, 209407], [88, 209527], [97, 210107], [101, 210307], [105, 210507], [112, 210887], [115, 211247], [120, 211667], [124, 211807], [127, 211927]]}, {"verse": 27, "start": 212884, "end": 224504, "text": "Y aconteció que diciendo estas cosas, una mujer de la multitud, levantando la voz, le dijo: Bienaventurado el vientre que te trajo, y los pechos que mamaste.", "words": [[0, 212884], [2, 213047], [12, 213787], [16, 214127], [25, 214447], [31, 214787], [38, 216027], [42, 216207], [48, 216627], [51, 216787], [54, 216887], [64, 217767], [75, 218367], [78, 218507], [83, 219147], [86, 219267], [92, 220099], [107, 220938], [110, 221078], [118, 221578], [122, 221658], [125, 221798], [132, 222398], [134, 222838], [138, 223018], [145, 223438], [149, 223658]]}, {"verse": 28, "start": 224784, "end": 231118, "text": "Y él dijo: Más bien, bienaventurados los que oyen la palabra de Dios, y la guardan.", "words": [[0, 224784], [2, 224944], [5, 225278], [11, 225770], [15, 225917], [21, 226735], [37, 227552], [41, 228052], [45, 228272], [50, 228672], [53, 228832], [61, 229192], [64, 229412], [70, 229732], [72, 230292], [75, 230432]]}, {"verse": 29, "start": 231468, "end": 243881, "text": "Y apiñándose las multitudes en torno a él, comenzó a decir: Esta generación mala es: señal busca, pero señal no le será dada, sino la señal de Jonás.", "words": [[0, 231468], [2, 231594], [13, 232414], [17, 232614], [28, 233314], [31, 233594], [37, 234014], [39, 234134], [43, 234314], [51, 235154], [53, 235254], [60, 235989], [65, 236449], [76, 237269], [81, 237669], [85, 238413], [91, 238877], [98, 239437], [103, 239597], [109, 240197], [112, 240497], [115, 240677], [120, 240937], [126, 241897], [131, 242237], [134, 242457], [140, 242957], [143, 243097]]}, {"verse": 30, "start": 244231, "end": 251176, "text": "Porque como Jonás fue señal a los ninivitas, así también será el Hijo del hombre a esta generación.", "words": [[0, 244231], [7, 244433], [12, 244693], [18, 245073], [22, 245353], [28, 245973], [30, 246133], [34, 246923], [45, 247713], [49, 247893], [57, 248313], [62, 248653], [65, 248953], [70, 249213], [74, 249373], [81, 249693], [83, 249933], [88, 250193]]}, {"verse": 31, "start": 251526, "end": 266095, "text": "La reina del Sur se levantará en juicio con los hombres de esta generación, y los condenará; porque vino de los fines de la tierra a oír la sabiduría de Salomón; y he aquí más que Salomón en este lugar.", "words": [[0, 251526], [3, 251649], [9, 252049], [13, 252229], [17, 252689], [20, 252964], [30, 253604], [33, 253784], [40, 254244], [44, 254544], [48, 254704], [56, 255124], [59, 255404], [64, 255604], [76, 256504], [78, 256839], [82, 257039], [93, 258274], [100, 258458], [105, 258798], [108, 258978], [112, 259138], [118, 259478], [121, 259678], [124, 259818], [131, 260218], [133, 260938], [137, 261398], [140, 261558], [150, 262278], [153, 262418], [162, 263430], [164, 263546], [167, 263696], [172, 263996], [176, 264296], [180, 264496], [188, 265236], [191, 265356], [196, 265576]]}, {"verse": 32, "start": 266445, "end": 278832, "text": "Los hombres de Nínive se levantarán en juicio con esta generación, y la condenarán; porque a la predicación de Jonás se arrepintieron; y he aquí más que Jonás en este lugar.", "words": [[0, 266445], [4, 266569], [12, 266949], [15, 267299], [22, 267649], [25, 268109], [36, 268849], [39, 268969], [46, 269449], [50, 269709], [55, 269909], [67, 270689], [69, 271109], [72, 271249], [84, 272433], [91, 272737], [93, 273017], [96, 273117], [108, 273857], [111, 274037], [117, 274597], [120, 275425], [135, 276409], [137, 276546], [140, 276726], [145, 277006], [149, 277246], [153, 277446], [159, 277946], [162, 278086], [167, 278266]]}, {"verse": 33, "start": 279182, "end": 289038, "text": "Nadie pone en oculto la lámpara encendida, ni debajo de un recipiente para medir grano, sino en el candelero, para que los que entran vean la luz.", "words": [[0, 279182], [6, 279543], [11, 279863], [14, 280123], [21, 280683], [24, 280823], [32, 281303], [43, 282583], [46, 282783], [53, 283203], [56, 283403], [59, 283503], [70, 284123], [75, 284323], [81, 284683], [88, 285083], [93, 285323], [96, 285763], [99, 285903], [110, 286603], [115, 287083], [119, 287223], [123, 287383], [127, 287563], [134, 287963], [139, 288323], [142, 288483]]}, {"verse": 34, "start": 289388, "end": 301206, "text": "La lámpara del cuerpo es el ojo: cuando tu ojo es bueno, también todo tu cuerpo está lleno de luz; pero cuando tu ojo es maligno, también tu cuerpo está en tinieblas.", "words": [[0, 289388], [3, 289492], [11, 289892], [15, 290072], [22, 290492], [25, 290952], [28, 291232], [33, 291871], [40, 292072], [43, 292332], [47, 292572], [50, 292712], [57, 293692], [65, 294172], [70, 294592], [73, 294872], [80, 295192], [85, 295452], [91, 295852], [94, 295952], [99, 296715], [104, 296859], [111, 297159], [114, 297439], [118, 297699], [121, 297819], [130, 298819], [138, 299199], [141, 299479], [148, 299799], [153, 300099], [156, 300279]]}, {"verse": 35, "start": 301556, "end": 305308, "text": "Mira pues, si la luz que en ti hay, es tinieblas.", "words": [[0, 301556], [5, 301753], [11, 301973], [14, 302633], [17, 302813], [21, 302973], [25, 303153], [28, 303313], [31, 303453], [36, 303753], [39, 304393]]}, {"verse": 36, "start": 305658, "end": 317018, "text": "Así que, siendo todo tu cuerpo resplandeciente, no teniendo alguna parte de tinieblas, será todo luminoso, como cuando una lámpara te alumbra con su resplandor.", "words": [[0, 305658], [4, 305900], [9, 306200], [16, 306540], [21, 306960], [24, 307260], [31, 307660], [48, 309420], [51, 309520], [60, 310060], [67, 310320], [73, 310760], [76, 311360], [87, 311960], [92, 312220], [97, 312560], [107, 313680], [112, 313880], [119, 314240], [123, 314540], [131, 315080], [134, 315300], [142, 315780], [146, 315980], [149, 316160]]}, {"verse": 37, "start": 317368, "end": 324220, "text": "Y luego que hubo hablado, le rogó un fariseo que comiese con él: y entrado Jesús, se sentó a la mesa.", "words": [[0, 317368], [2, 317490], [8, 317690], [12, 317970], [17, 318350], [26, 318790], [29, 319070], [34, 319530], [37, 319670], [45, 320350], [49, 320470], [57, 320970], [61, 321270], [65, 321814], [67, 321912], [75, 322332], [82, 322792], [85, 323212], [91, 323592], [93, 323652], [96, 323732]]}, {"verse": 38, "start": 324570, "end": 329779, "text": "Y el fariseo, como lo vio, se maravilló de que no se lavó antes de comer.", "words": [[0, 324570], [2, 324694], [5, 324814], [14, 325494], [19, 325654], [22, 325834], [27, 326694], [30, 326894], [40, 327614], [43, 327814], [47, 327934], [50, 328114], [53, 328274], [58, 328714], [64, 329094], [67, 329274]]}, {"verse": 39, "start": 330129, "end": 340619, "text": "Y el Señor le dijo: Ahora vosotros los fariseos lo de fuera del vaso y del plato limpiáis; pero lo interior de vosotros está lleno de robo y de maldad.", "words": [[0, 330129], [2, 330236], [5, 330356], [11, 330676], [14, 330876], [20, 331614], [26, 332034], [35, 333154], [39, 333254], [48, 334154], [51, 334354], [54, 334494], [60, 334694], [64, 334994], [69, 335414], [71, 335494], [75, 335634], [81, 335974], [91, 337181], [96, 337326], [99, 337486], [108, 337906], [111, 338106], [120, 338566], [125, 338846], [131, 339206], [134, 339306], [139, 339746], [141, 339826], [144, 339966]]}, {"verse": 40, "start": 340969, "end": 345043, "text": "Necios, ¿el que hizo lo de fuera, no hizo también lo de dentro?", "words": [[0, 340969], [8, 341987], [12, 342187], [16, 342367], [21, 342607], [24, 342787], [27, 342927], [34, 343207], [37, 343467], [42, 343647], [50, 344067], [53, 344307], [56, 344447]]}, {"verse": 41, "start": 345393, "end": 350192, "text": "Pero de lo que os resta, dad limosna; y he aquí todo os será limpio.", "words": [[0, 345393], [5, 345537], [8, 345697], [11, 345857], [15, 345977], [18, 346097], [25, 347017], [29, 347237], [38, 348367], [40, 348432], [43, 348532], [48, 348852], [53, 349032], [56, 349212], [61, 349672]]}, {"verse": 42, "start": 350542, "end": 365048, "text": "Pero ¡ay de vosotros, fariseos! que diezmáis la menta, y la ruda, y toda hortaliza; y pasáis por alto la justicia y el amor de Dios. Pues estas cosas era necesario hacer, y no dejar las otras.", "words": [[0, 350554], [5, 350911], [9, 351267], [12, 351467], [22, 352007], [32, 353299], [36, 353572], [45, 353882], [48, 354192], [55, 354502], [57, 354602], [60, 354762], [66, 355322], [68, 355542], [73, 355802], [84, 356980], [86, 357085], [93, 357565], [97, 357885], [102, 358245], [105, 358485], [114, 359225], [116, 359425], [119, 359545], [124, 359745], [127, 359985], [133, 360722], [138, 360866], [144, 361146], [150, 361606], [154, 362066], [164, 362606], [171, 363046], [173, 363606], [176, 363853], [182, 364099], [186, 364346]]}, {"verse": 43, "start": 365398, "end": 372779, "text": "¡Ay de vosotros, fariseos! que amáis los asientos de honor en las sinagogas, y los saludos en las plazas.", "words": [[0, 365562], [4, 365762], [7, 366322], [17, 366742], [27, 367966], [31, 368050], [37, 368410], [41, 368570], [50, 369110], [53, 369330], [59, 369550], [62, 369810], [66, 369950], [77, 370850], [79, 371130], [83, 371270], [91, 371830], [94, 371970], [98, 372090]]}, {"verse": 44, "start": 373129, "end": 383159, "text": "¡Ay de vosotros, escribas y fariseos, hipócritas! que sois como sepulcros que no se ven, y los hombres que andan encima no lo saben.", "words": [[0, 373284], [4, 373474], [7, 373974], [17, 374434], [26, 375134], [28, 375274], [38, 375954], [50, 377426], [54, 377509], [59, 377909], [64, 378169], [74, 378909], [78, 379109], [81, 379269], [84, 379429], [89, 379649], [91, 380129], [95, 380289], [103, 380669], [107, 380929], [113, 381329], [120, 382009], [123, 382349], [126, 382489]]}, {"verse": 45, "start": 383509, "end": 391923, "text": "Y respondiendo uno de los intérpretes de la ley, le dice: Maestro, cuando dices esto, también nos afrentas a nosotros.", "words": [[0, 383611], [2, 383751], [15, 384631], [19, 384991], [22, 385151], [26, 385701], [38, 386251], [41, 386331], [44, 386471], [49, 387051], [52, 387231], [58, 388003], [67, 388728], [74, 388788], [80, 389208], [86, 390228], [94, 390328], [98, 390568], [107, 391128], [109, 391228]]}, {"verse": 46, "start": 392203, "end": 403940, "text": "Y él dijo: ¡Ay de vosotros también, intérpretes de la ley! que cargáis a los hombres con cargas que no pueden llevar; pero vosotros ni aun con un dedo tocáis las cargas.", "words": [[0, 392203], [2, 392363], [5, 392697], [11, 393369], [15, 393549], [18, 393709], [27, 394209], [36, 394589], [48, 395764], [51, 395924], [54, 396044], [59, 396750], [63, 396834], [71, 397314], [73, 397434], [77, 397554], [85, 397894], [89, 398154], [96, 398674], [100, 398814], [103, 398974], [110, 399294], [118, 400124], [123, 400364], [132, 400964], [135, 401564], [139, 401764], [143, 402004], [146, 402164], [151, 402564], [158, 402984], [162, 403144]]}, {"verse": 47, "start": 404290, "end": 411057, "text": "¡Ay de vosotros! que edificáis los sepulcros de los profetas, y los mataron vuestros padres.", "words": [[0, 404461], [4, 404667], [7, 404874], [17, 406014], [21, 406098], [31, 407038], [35, 407338], [45, 408038], [48, 408218], [52, 408318], [62, 408918], [64, 409418], [68, 409558], [76, 410038], [85, 410398]]}, {"verse": 48, "start": 411407, "end": 422166, "text": "De cierto dais testimonio que consentís en los hechos de vuestros padres; porque a la verdad ellos los mataron, pero vosotros edificáis sus sepulcros.", "words": [[0, 411783], [3, 412193], [10, 412603], [15, 413013], [26, 413693], [30, 414033], [40, 414373], [43, 414713], [47, 414893], [54, 415233], [57, 415393], [66, 415733], [74, 416643], [81, 416890], [83, 417010], [86, 417090], [93, 417370], [99, 417790], [103, 418010], [112, 418630], [117, 418830], [126, 419550], [136, 420630], [140, 421429]]}, {"verse": 49, "start": 422516, "end": 432786, "text": "Por tanto, la sabiduría de Dios también dijo: Enviaré a ellos profetas y apóstoles; y de ellos a unos matarán y a otros perseguirán;", "words": [[0, 422516], [4, 422620], [11, 423340], [14, 423900], [24, 424460], [27, 424580], [32, 424820], [40, 425120], [46, 425994], [54, 426559], [56, 426639], [62, 426839], [71, 427439], [73, 427619], [84, 428682], [86, 428820], [89, 428960], [95, 429247], [97, 429533], [102, 429820], [110, 430520], [112, 430900], [114, 431020], [120, 431360]]}, {"verse": 50, "start": 433136, "end": 440918, "text": "Para que de esta generación sea demandada la sangre de todos los profetas, que ha sido derramada desde la fundación del mundo;", "words": [[0, 433136], [5, 433378], [9, 433558], [12, 433718], [17, 433958], [28, 434798], [32, 435058], [42, 435758], [45, 435898], [52, 436318], [55, 436518], [61, 436778], [65, 437058], [75, 437658], [79, 438038], [82, 438158], [87, 438398], [97, 439118], [103, 439338], [106, 439598], [116, 440138], [120, 440338]]}, {"verse": 51, "start": 441268, "end": 451610, "text": "Desde la sangre de Abel, hasta la sangre de Zacarías, que murió entre el altar y el templo: así os digo, será demandada de esta generación.", "words": [[0, 441268], [6, 441505], [9, 441765], [16, 442125], [19, 442325], [25, 442725], [31, 443525], [34, 443705], [41, 444145], [44, 444365], [54, 445025], [58, 445485], [64, 445925], [70, 446285], [73, 446525], [79, 446885], [81, 447225], [84, 447365], [92, 448236], [96, 448420], [99, 448580], [105, 449320], [110, 449600], [120, 450280], [123, 450460], [128, 450660]]}, {"verse": 52, "start": 451960, "end": 462451, "text": "¡Ay de vosotros, intérpretes de la ley! que habéis quitado la llave del conocimiento; vosotros mismos no entrasteis, y a los que entraban impedisteis.", "words": [[0, 452158], [4, 452388], [7, 452588], [17, 453028], [29, 454008], [32, 454108], [35, 454228], [40, 454897], [44, 455001], [51, 455301], [59, 455781], [62, 455921], [68, 456241], [72, 456381], [86, 457696], [95, 458096], [102, 458396], [105, 458656], [117, 459616], [119, 460056], [121, 460116], [125, 460216], [129, 460356], [138, 460956]]}, {"verse": 53, "start": 462801, "end": 472948, "text": "Y diciéndoles estas cosas, los escribas y los fariseos comenzaron a presionarle en gran manera, y a provocarle a que hablase de muchas cosas;", "words": [[0, 462801], [2, 462945], [14, 463605], [20, 463945], [27, 465165], [31, 465265], [40, 465905], [42, 466085], [46, 466185], [55, 466905], [66, 467825], [68, 467925], [80, 468745], [83, 468905], [88, 469105], [96, 469625], [98, 470245], [100, 470325], [111, 471125], [113, 471265], [117, 471385], [125, 471785], [128, 471905], [135, 472125]]}, {"verse": 54, "start": 473298, "end": 478127, "text": "Acechándole, y procurando cazar algo de su boca para acusarle.", "words": [[0, 473298], [13, 474239], [15, 474619], [26, 475209], [32, 475799], [37, 476159], [40, 476379], [43, 476559], [48, 476919], [53, 477199]]}]}