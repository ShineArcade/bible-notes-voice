{"book": "GEN", "chapter": 16, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 151423, "verses": [{"verse": 1, "start": 300, "end": 7102, "text": "Y Sarai, mujer de Abram, no le paría: y ella tenía una sierva egipcia, que se llamaba Agar.", "words": [[0, 300], [2, 531], [9, 801], [15, 1061], [18, 1281], [25, 2061], [28, 2221], [31, 2361], [38, 3303], [40, 3419], [45, 3639], [51, 3946], [55, 4252], [62, 4560], [71, 5380], [75, 5800], [78, 5960], [86, 6460]]}, {"verse": 2, "start": 7552, "end": 20160, "text": "Dijo, pues, Sarai a Abram: Ya ves que Jehová me ha hecho estéril: te ruego que entres a mi sierva; quizá tendré hijos de ella. Y atendió Abram al dicho de Sarai.", "words": [[0, 7552], [6, 8296], [12, 8816], [18, 9416], [20, 9676], [27, 10496], [30, 10680], [34, 10900], [38, 11080], [45, 11560], [48, 11700], [51, 11840], [57, 12040], [66, 13174], [69, 13294], [75, 13414], [79, 13714], [86, 14074], [88, 14194], [91, 14334], [99, 15212], [105, 15576], [112, 16016], [118, 16236], [121, 16496], [127, 17250], [129, 17391], [137, 18151], [143, 18911], [146, 19071], [152, 19331], [155, 19768]]}, {"verse": 3, "start": 20610, "end": 32178, "text": "Y Sarai, mujer de Abram, tomó a Agar su sierva egipcia, al cabo de diez años que había habitado Abram en la tierra de Canaán, y la dio a Abram su marido por mujer.", "words": [[0, 20610], [2, 20951], [9, 21321], [15, 21621], [18, 21901], [25, 22701], [30, 23161], [32, 23321], [37, 23661], [40, 23821], [47, 24241], [56, 24821], [59, 25021], [64, 25301], [67, 25521], [72, 25781], [77, 26221], [81, 26481], [87, 26761], [96, 27481], [102, 27941], [105, 28101], [108, 28221], [115, 28501], [118, 29085], [126, 29913], [128, 30077], [131, 30177], [135, 30397], [137, 30687], [143, 30977], [146, 31077], [153, 31437], [157, 31637]]}, {"verse": 4, "start": 32628, "end": 40105, "text": "Y él cohabitó con Agar, la cual concibió: y cuando vio que había concebido, miraba con desprecio a su señora.", "words": [[0, 32628], [2, 33048], [5, 33468], [14, 33888], [18, 34068], [24, 34808], [27, 34888], [32, 35412], [42, 36180], [44, 36279], [51, 36479], [55, 36819], [59, 36959], [65, 37179], [76, 38059], [83, 38399], [87, 38599], [97, 39259], [99, 39279], [102, 39399]]}, {"verse": 5, "start": 40555, "end": 53068, "text": "Entonces Sarai dijo a Abram: Mi afrenta sea sobre ti: yo puse mi sierva en tu seno, y viéndose embarazada, me mira con desprecio; juzgue Jehová entre mí y ti.", "words": [[0, 40555], [9, 41185], [15, 41815], [20, 42415], [22, 42715], [29, 43468], [32, 43594], [40, 44154], [44, 44374], [50, 44714], [54, 45463], [57, 45691], [62, 46011], [65, 46191], [72, 46571], [75, 46691], [78, 46811], [84, 47411], [86, 47731], [95, 48171], [107, 49271], [110, 49391], [115, 49631], [119, 49831], [130, 51009], [137, 51483], [144, 51963], [150, 52223], [153, 52503], [155, 52703]]}, {"verse": 6, "start": 53418, "end": 64311, "text": "Y respondió Abram a Sarai: He ahí tu sierva en tu mano, haz con ella lo que bien te parezca. Y como Sarai la afligiese, huyó de su presencia.", "words": [[0, 53418], [2, 53836], [12, 54286], [18, 54783], [20, 55281], [27, 55970], [30, 56149], [34, 56389], [37, 56549], [44, 56969], [47, 57069], [50, 57189], [56, 58029], [60, 58229], [64, 58489], [69, 58689], [72, 58889], [76, 59029], [81, 59229], [84, 59409], [93, 60367], [95, 60491], [100, 60778], [106, 61064], [109, 61351], [120, 62371], [125, 63091], [128, 63251], [131, 63411]]}, {"verse": 7, "start": 64762, "end": 72390, "text": "Y la halló el ángel de Jehová junto a una fuente de agua en el desierto, junto a la fuente que está en el camino del Sur.", "words": [[0, 64762], [2, 64907], [5, 65067], [11, 65447], [14, 65607], [20, 66067], [23, 66227], [30, 66727], [36, 66927], [38, 67187], [42, 67347], [49, 67807], [52, 67967], [57, 68207], [60, 68347], [63, 68467], [73, 69127], [79, 69687], [81, 69987], [84, 70047], [91, 70507], [95, 70687], [100, 70967], [103, 71187], [106, 71307], [113, 71587], [117, 71887]]}, {"verse": 8, "start": 72840, "end": 84300, "text": "Y le dijo: Agar, sierva de Sarai, ¿de dónde vienes tú, y a dónde vas? Y ella respondió: Huyo de delante de Sarai, mi señora.", "words": [[0, 72840], [2, 72962], [5, 73082], [11, 73933], [17, 74290], [24, 74790], [27, 75400], [34, 76010], [38, 76270], [44, 76470], [51, 76990], [55, 77150], [57, 77610], [59, 77710], [65, 77870], [70, 78801], [72, 79038], [77, 79258], [88, 80350], [93, 80630], [96, 80790], [104, 81230], [107, 81330], [114, 81910], [117, 82310]]}, {"verse": 9, "start": 84650, "end": 90783, "text": "Y le dijo el ángel de Jehová: Vuélvete a tu señora, y ponte sumisa bajo de su mano.", "words": [[0, 84650], [2, 84776], [5, 84876], [10, 85136], [13, 85336], [19, 85696], [22, 85816], [30, 86718], [39, 87205], [41, 87325], [44, 87405], [52, 87905], [54, 88385], [60, 88935], [67, 89485], [72, 89765], [75, 90005], [78, 90185]]}, {"verse": 10, "start": 91233, "end": 100279, "text": "Le dijo también el ángel de Jehová: Multiplicaré tanto tu descendencia, que no podrá ser contada a causa de la multitud.", "words": [[0, 91233], [3, 91318], [8, 91578], [16, 92018], [19, 92358], [25, 92778], [28, 92898], [36, 93784], [49, 94650], [55, 95030], [58, 95430], [72, 96870], [76, 97090], [79, 97250], [85, 97710], [89, 97910], [97, 98590], [99, 98750], [105, 99050], [108, 99310], [111, 99390]]}, {"verse": 11, "start": 100729, "end": 109482, "text": "Le dijo aún el ángel de Jehová: He aquí que has concebido, y darás a luz un hijo, y llamarás su nombre Ismael, porque Jehová ha oído tu aflicción.", "words": [[0, 100729], [3, 100836], [8, 101136], [12, 101416], [15, 101576], [21, 101996], [24, 102347], [32, 102988], [35, 103058], [40, 103318], [44, 103478], [48, 103618], [59, 104198], [61, 104298], [67, 104638], [69, 104738], [73, 104958], [76, 105058], [82, 105318], [84, 105858], [93, 106278], [96, 106418], [103, 106658], [111, 107398], [118, 107658], [125, 108198], [128, 108318], [133, 108618], [136, 108798]]}, {"verse": 12, "start": 109832, "end": 119211, "text": "Y él será hombre fiero; su mano contra todos, y las manos de todos contra él, y delante de todos sus hermanos habitará.", "words": [[0, 109832], [2, 110054], [5, 110254], [10, 110614], [17, 111154], [24, 112245], [27, 112428], [32, 112688], [39, 113088], [46, 113588], [48, 114288], [52, 114428], [58, 114688], [61, 114848], [67, 115188], [74, 115708], [78, 116228], [80, 116768], [88, 117288], [91, 117468], [97, 117728], [101, 118008], [110, 118645]]}, {"verse": 13, "start": 119661, "end": 129296, "text": "Entonces llamó el nombre de Jehová que con ella hablaba: Tú eres el Dios que ve; porque dijo: ¿No he visto también aquí al que me ve?", "words": [[0, 119661], [9, 120092], [15, 120892], [18, 120992], [25, 121312], [28, 121512], [35, 122072], [39, 122412], [43, 122632], [48, 122812], [57, 123924], [60, 124065], [65, 124285], [68, 124545], [73, 124725], [77, 124985], [81, 126405], [88, 126575], [94, 127345], [98, 127491], [101, 127551], [107, 127771], [115, 128111], [120, 128511], [123, 128711], [127, 128831], [130, 128951]]}, {"verse": 14, "start": 129646, "end": 136638, "text": "Por lo cual llamó al pozo, Pozo del Viviente que me ve. He aquí está entre Cades y Bered.", "words": [[0, 129646], [4, 129832], [7, 129932], [12, 130212], [18, 130632], [21, 130792], [27, 131672], [32, 132332], [36, 132532], [45, 133092], [49, 133292], [52, 133452], [56, 134204], [59, 134294], [64, 134534], [69, 134894], [75, 135434], [81, 135974], [83, 136334]]}, {"verse": 15, "start": 137088, "end": 144826, "text": "Y parió Agar a Abram un hijo, y llamó Abram el nombre de su hijo que le parió Agar, Ismael.", "words": [[0, 137088], [2, 137233], [8, 137743], [13, 138253], [15, 138553], [21, 139193], [24, 139413], [30, 140353], [32, 140433], [38, 140793], [44, 141273], [47, 141413], [54, 141773], [57, 141993], [60, 142233], [65, 142493], [69, 142713], [72, 142873], [78, 143463], [84, 144053]]}, {"verse": 16, "start": 145276, "end": 151023, "text": "Y era Abram de edad de ochenta y seis años, cuando parió Agar a Ismael.", "words": [[0, 145276], [2, 145452], [6, 145742], [12, 146032], [15, 146332], [20, 146652], [23, 146877], [31, 147102], [33, 147327], [38, 147552], [44, 148672], [51, 149092], [57, 149372], [62, 149652], [64, 150337]]}]}