{"book": "PSA", "chapter": 88, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 103042, "verses": [{"verse": 1, "start": 300, "end": 4732, "text": "O LORD God of my salvation, I have cried day and night before you:", "words": [[0, 300], [2, 460], [7, 740], [11, 1040], [14, 1220], [17, 1400], [28, 2480], [30, 2680], [35, 2840], [41, 3160], [45, 3520], [49, 3680], [55, 3900], [62, 4220]]}, {"verse": 2, "start": 5182, "end": 9180, "text": "Let my prayer come before you: incline your ear to my cry;", "words": [[0, 5182], [4, 5311], [7, 5511], [14, 5851], [19, 6151], [26, 6531], [31, 7309], [39, 7767], [44, 7987], [48, 8207], [51, 8407], [54, 8607]]}, {"verse": 3, "start": 9630, "end": 14086, "text": "For my soul is full of troubles: and my life draws near to the grave.", "words": [[0, 9630], [4, 9749], [7, 9909], [12, 10269], [15, 10529], [20, 10729], [23, 10869], [33, 11847], [37, 11972], [40, 12132], [45, 12432], [51, 12772], [56, 13132], [59, 13352], [63, 13472]]}, {"verse": 4, "start": 14536, "end": 19566, "text": "I am counted with them that go down into the pit: I am as a man that has no strength:", "words": [[0, 14536], [2, 14680], [5, 14780], [13, 15120], [18, 15460], [23, 15700], [28, 15860], [31, 16060], [36, 16340], [41, 16560], [45, 16720], [50, 17417], [52, 17581], [55, 17721], [58, 17861], [60, 18021], [64, 18241], [69, 18481], [73, 18701], [76, 18881]]}, {"verse": 5, "start": 20016, "end": 26856, "text": "Free among the dead, like the slain that lie in the grave, whom you remember no more: and they are cut off from your hand.", "words": [[0, 20016], [5, 20162], [11, 20422], [15, 20682], [21, 21242], [26, 21462], [30, 21642], [36, 22062], [41, 22202], [45, 22442], [48, 22622], [52, 22722], [59, 23082], [64, 23462], [68, 23642], [77, 24062], [80, 24362], [86, 25190], [90, 25334], [95, 25474], [99, 25554], [103, 25774], [107, 25974], [112, 26214], [117, 26354]]}, {"verse": 6, "start": 27306, "end": 30804, "text": "You have laid me in the lowest pit, in darkness, in the deeps.", "words": [[0, 27306], [4, 27404], [9, 27544], [14, 27764], [17, 28004], [20, 28124], [24, 28224], [31, 28504], [36, 29224], [39, 29324], [49, 30004], [52, 30124], [56, 30204]]}, {"verse": 7, "start": 31254, "end": 36484, "text": "Your wrath lies hard upon me, and you have afflicted me with all your waves. Selah.", "words": [[0, 31254], [5, 31359], [11, 31699], [16, 31999], [21, 32339], [26, 32599], [30, 33199], [34, 33339], [38, 33459], [43, 33579], [53, 34099], [56, 34239], [61, 34439], [65, 34659], [70, 34859], [77, 36193]]}, {"verse": 8, "start": 36934, "end": 45400, "text": "You have put away my acquaintance far from me; you have made me an abomination to them: I am shut up, and I cannot come forth.", "words": [[0, 36934], [4, 37092], [9, 37272], [13, 37512], [18, 37792], [21, 38032], [34, 38712], [38, 39072], [43, 39352], [47, 40073], [51, 40391], [56, 40571], [61, 40811], [64, 41031], [67, 41171], [79, 41851], [82, 42171], [88, 42835], [90, 43018], [93, 43158], [98, 43438], [102, 43698], [106, 43998], [108, 44118], [115, 44438], [120, 44778]]}, {"verse": 9, "start": 45850, "end": 53536, "text": "My eye mourns by reason of affliction: LORD, I have called daily upon you, I have stretched out my hands to you.", "words": [[0, 45850], [3, 46225], [7, 46545], [14, 47125], [17, 47305], [24, 47665], [27, 47865], [39, 48895], [45, 49360], [47, 49520], [52, 49720], [59, 49980], [65, 50440], [70, 50760], [75, 51600], [77, 51700], [82, 51800], [92, 52120], [96, 52400], [99, 52640], [105, 52960], [108, 53180]]}, {"verse": 10, "start": 53986, "end": 58942, "text": "Will you show wonders to the dead? shall the dead arise and praise you? Selah.", "words": [[0, 53986], [5, 54130], [9, 54270], [14, 54490], [22, 54830], [25, 55130], [29, 55270], [35, 56084], [41, 56266], [45, 56426], [50, 56646], [56, 57026], [60, 57286], [67, 57586], [72, 58673]]}, {"verse": 11, "start": 59392, "end": 64792, "text": "Shall your lovingkindness be declared in the grave? or your faithfulness in destruction?", "words": [[0, 59392], [6, 59552], [11, 60132], [26, 60712], [29, 60912], [38, 61332], [41, 61592], [45, 61692], [52, 62675], [55, 62819], [60, 62999], [73, 63469], [76, 63939]]}, {"verse": 12, "start": 65242, "end": 70631, "text": "Shall your wonders be known in the dark? and your righteousness in the land of forgetfulness?", "words": [[0, 65242], [6, 65665], [11, 65865], [19, 66245], [22, 66565], [28, 66845], [31, 67025], [35, 67125], [41, 68004], [45, 68171], [50, 68311], [64, 68791], [67, 69171], [71, 69291], [76, 69531], [79, 69691]]}, {"verse": 13, "start": 71081, "end": 76943, "text": "But to you have I cried, O LORD; and in the morning my prayer shall come before you.", "words": [[0, 71081], [4, 71239], [7, 71439], [11, 71679], [16, 71919], [18, 72099], [25, 72859], [27, 72979], [33, 73918], [37, 74063], [40, 74203], [44, 74323], [52, 74663], [55, 74943], [62, 75383], [68, 75683], [73, 75983], [80, 76343]]}, {"verse": 14, "start": 77393, "end": 82563, "text": "LORD, why do you cast off my soul? why do you hide your face from me?", "words": [[0, 77393], [6, 77920], [10, 78140], [13, 78340], [17, 78460], [22, 78760], [26, 79100], [29, 79360], [35, 80362], [39, 80587], [42, 80767], [46, 80907], [51, 81247], [56, 81467], [61, 81787], [66, 82127]]}, {"verse": 15, "start": 83013, "end": 89373, "text": "I am afflicted and ready to die from my youth up: while I suffer your terrors I am distracted.", "words": [[0, 83013], [2, 83218], [5, 83398], [15, 84058], [19, 84178], [25, 84418], [28, 84658], [32, 84978], [37, 85238], [40, 85498], [46, 85778], [50, 86504], [56, 86650], [58, 86850], [65, 87150], [70, 87410], [78, 88110], [80, 88230], [83, 88390]]}, {"verse": 16, "start": 89823, "end": 93852, "text": "Your fierce wrath goes over me; your terrors have cut me off.", "words": [[0, 89823], [5, 89964], [12, 90284], [18, 90764], [23, 91044], [28, 91364], [32, 92080], [37, 92205], [45, 92785], [50, 92925], [54, 93145], [57, 93365]]}, {"verse": 17, "start": 94302, "end": 98411, "text": "They came round about me daily like water; they compassed me about together.", "words": [[0, 94302], [5, 94410], [10, 94590], [16, 94830], [22, 95090], [25, 95310], [31, 95630], [36, 95930], [43, 96799], [48, 96903], [58, 97423], [61, 97523], [67, 97763]]}, {"verse": 18, "start": 98861, "end": 102642, "text": "Lover and friend have you put far from me, and my acquaintance into darkness.", "words": [[0, 98861], [6, 99168], [10, 99348], [17, 99768], [22, 99848], [26, 99988], [30, 100188], [34, 100508], [39, 100768], [43, 100948], [47, 101108], [50, 101288], [63, 101788], [68, 101948]]}]}