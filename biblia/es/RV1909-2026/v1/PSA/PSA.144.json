{"book": "PSA", "chapter": 144, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 110924, "verses": [{"verse": 1, "start": 300, "end": 7840, "text": "Salmo de David. BENDITO sea Jehová, mi roca, que enseña mis manos a la batalla, y mis dedos a la guerra:", "words": [[0, 300], [6, 770], [9, 930], [16, 1540], [24, 2085], [28, 2392], [36, 2698], [39, 3005], [45, 3805], [49, 4065], [56, 4565], [60, 4725], [66, 5065], [68, 5305], [71, 5365], [80, 5885], [82, 6345], [86, 6525], [92, 6985], [94, 7125], [97, 7205]]}, {"verse": 2, "start": 8190, "end": 17521, "text": "Misericordia mía y mi castillo, altura mía y mi libertador, escudo mío, en quien he confiado; el que somete mi pueblo delante de mí.", "words": [[0, 8190], [13, 8976], [17, 9156], [19, 9336], [22, 9436], [32, 10636], [39, 10856], [43, 11106], [45, 11356], [48, 11456], [60, 12436], [67, 12876], [72, 13356], [75, 13676], [81, 13876], [84, 14056], [94, 15152], [97, 15277], [101, 15397], [108, 15917], [111, 16017], [118, 16377], [126, 16917], [129, 17097]]}, {"verse": 3, "start": 17871, "end": 24290, "text": "Oh Jehová, ¿qué es el hombre, para que lo conozcas? ¿o el hijo del hombre, para que lo estimes?", "words": [[0, 18090], [3, 18341], [11, 18593], [16, 18993], [19, 19193], [22, 19373], [30, 19713], [35, 20233], [39, 20393], [42, 20533], [52, 21655], [55, 21761], [58, 21901], [63, 22121], [67, 22321], [75, 22701], [80, 23181], [84, 23321], [87, 23481]]}, {"verse": 4, "start": 24640, "end": 29523, "text": "El hombre es semejante a la vanidad: sus días son como la sombra que pasa.", "words": [[0, 24640], [3, 24900], [10, 25160], [13, 25400], [23, 26080], [25, 26200], [28, 26300], [37, 27241], [41, 27385], [46, 27665], [50, 27925], [55, 28145], [58, 28305], [65, 28745], [69, 28885]]}, {"verse": 5, "start": 29873, "end": 35277, "text": "Oh Jehová, inclina tus cielos y desciende: toca los montes, y humeen.", "words": [[0, 30197], [3, 30587], [11, 30977], [19, 31367], [23, 31607], [30, 32287], [32, 32427], [43, 33494], [48, 33859], [52, 33959], [60, 34539], [62, 34913]]}, {"verse": 6, "start": 35627, "end": 41463, "text": "Despide relámpagos, y disípalos; envía tus flechas, y confúndelos.", "words": [[0, 35627], [8, 36309], [20, 37609], [22, 37769], [33, 38850], [39, 39373], [43, 39573], [52, 40153], [54, 40433]]}, {"verse": 7, "start": 41463, "end": 48482, "text": "Envía tu mano desde lo alto; redímeme, y sácame de las muchas aguas, de la mano de los hijos extraños;", "words": [[0, 41533], [6, 41933], [9, 42093], [14, 42373], [20, 42633], [23, 42893], [29, 43644], [39, 44288], [41, 44453], [48, 44953], [51, 45133], [55, 45273], [62, 45533], [69, 46253], [72, 46633], [75, 46733], [80, 46953], [83, 47113], [87, 47253], [93, 47473]]}, {"verse": 8, "start": 48832, "end": 53801, "text": "Cuya boca habla vanidad, y su diestra es diestra de mentira.", "words": [[0, 48832], [5, 49138], [10, 49518], [16, 49898], [25, 50458], [27, 50873], [30, 51053], [38, 51593], [41, 52013], [49, 52713], [52, 52933]]}, {"verse": 9, "start": 54151, "end": 59933, "text": "Oh Dios, a ti cantaré canción nueva: con salterio, con decacordio cantaré a ti.", "words": [[0, 54254], [3, 54394], [9, 54534], [11, 54774], [14, 54974], [22, 55574], [30, 55854], [37, 56881], [41, 57025], [51, 58125], [55, 58285], [66, 58945], [74, 59425], [76, 59545]]}, {"verse": 10, "start": 60283, "end": 66758, "text": "Tú, el que da victoria a los reyes, el que redime a David su siervo de maligna espada.", "words": [[0, 60283], [4, 60885], [7, 60985], [11, 61125], [14, 61285], [23, 61885], [25, 62025], [29, 62145], [36, 62885], [39, 63085], [43, 63205], [50, 63725], [52, 63965], [58, 64325], [61, 64785], [68, 65325], [71, 65445], [79, 66005]]}, {"verse": 11, "start": 67108, "end": 75876, "text": "Redímeme, y sálvame de mano de los hijos extraños, cuya boca habla vanidad, y su diestra es diestra de mentira.", "words": [[0, 67108], [10, 67771], [12, 68011], [20, 68491], [23, 68671], [28, 68931], [3