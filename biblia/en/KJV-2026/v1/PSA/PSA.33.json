{"book": "PSA", "chapter": 33, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 115457, "verses": [{"verse": 1, "start": 300, "end": 5317, "text": "Rejoice in the LORD, O you righteous: for praise is comely for the upright.", "words": [[0, 300], [8, 908], [11, 1048], [15, 1148], [21, 1708], [23, 1808], [27, 2008], [38, 3061], [42, 3381], [49, 3741], [52, 3961], [59, 4401], [63, 4581], [67, 4721]]}, {"verse": 2, "start": 5767, "end": 11175, "text": "Praise the LORD with harp: sing to him with the psaltery and an instrument of ten strings.", "words": [[0, 5767], [7, 6160], [11, 6460], [16, 6740], [21, 7000], [27, 7797], [32, 8044], [35, 8284], [39, 8424], [44, 8624], [48, 8897], [57, 9171], [61, 9444], [64, 9544], [75, 9944], [78, 10144], [82, 10384]]}, {"verse": 3, "start": 11625, "end": 15296, "text": "Sing to him a new song; play skilfully with a loud noise.", "words": [[0, 11625], [5, 11785], [8, 12005], [12, 12145], [14, 12265], [18, 12425], [24, 13340], [29, 13704], [39, 14104], [44, 14284], [46, 14384], [51, 14624]]}, {"verse": 4, "start": 15746, "end": 19371, "text": "For the word of the LORD is right; and all his works are done in truth.", "words": [[0, 15746], [4, 15829], [8, 15929], [13, 16149], [16, 16269], [20, 16389], [25, 16649], [28, 16829], [35, 17578], [39, 17685], [43, 17885], [47, 18065], [53, 18345], [57, 18505], [62, 18705], [65, 18865]]}, {"verse": 5, "start": 19821, "end": 24613, "text": "He loves righteousness and judgment: the earth is full of the goodness of the LORD.", "words": [[0, 19821], [3, 19913], [9, 20173], [23, 20873], [27, 21173], [37, 22059], [41, 22158], [47, 22418], [50, 22658], [55, 22958], [58, 23158], [62, 23298], [71, 23638], [74, 23938], [78, 24098]]}, {"verse": 6, "start": 25063, "end": 30753, "text": "By the word of the LORD were the heavens made; and all the host of them by the breath of his mouth.", "words": [[0, 25063], [3, 25171], [7, 25311], [12, 25631], [15, 25791], [19, 25931], [24