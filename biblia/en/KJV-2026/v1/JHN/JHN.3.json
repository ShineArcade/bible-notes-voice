{"book": "JHN", "chapter": 3, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 237393, "verses": [{"verse": 1, "start": 300, "end": 4357, "text": "There was a man of the Pharisees, named Nicodemus, a ruler of the Jews:", "words": [[0, 300], [6, 392], [10, 552], [12, 672], [16, 892], [19, 1052], [23, 1172], [34, 1912], [40, 2152], [51, 3092], [53, 3172], [59, 3432], [62, 3712], [66, 3812]]}, {"verse": 2, "start": 4707, "end": 14310, "text": "The same came to Jesus by night, and said to him, Rabbi, we know that you are a teacher come from God: for no man can do these miracles that you do, unless God be with him.", "words": [[0, 4707], [4, 4795], [9, 5035], [14, 5275], [17, 5455], [23, 5735], [26, 6095], [33, 6355], [37, 6615], [42, 6835], [45, 7035], [50, 7576], [57, 8020], [60, 8080], [65, 8300], [70, 8480], [74, 8620], [78, 8720], [80, 8820], [88, 9280], [93, 9360], [98, 9560], [103, 10314], [107, 10420], [110, 10680], [114, 10940], [118, 11160], [121, 11360], [127, 11540], [136, 11960], [141, 12240], [145, 12400], [149, 12620], [156, 13160], [160, 13540], [163, 13780], [168, 14000]]}, {"verse": 3, "start": 14590, "end": 22414, "text": "Jesus answered and said to him, Most assuredly I say to you Unless a man be born again he can not see the kingdom of God", "words": [[0, 14590], [6, 14820], [15, 15380], [19, 15580], [24, 15800], [27, 16000], [32, 16488], [37, 16673], [47, 17393], [49, 17473], [53, 17753], [56, 17973], [60, 18333], [67, 18573], [69, 18813], [73, 19073], [76, 19273], [81, 19553], [87, 20473], [90, 20600], [94, 20726], [98, 20853], [102, 21173], [106, 21313], [114, 21613], [117, 21873]]}, {"verse": 4, "start": 22694, "end": 30143, "text": "Nicodemus says to him, How can a man be born when he is old? can he enter the second time into his mother’s womb, and be born?", "words": [[0, 22694], [10, 23321], [15, 23481], [18, 23701], [23, 24267], [27, 24427], [31, 24627], [33, 24747], [37, 24927], [40, 25127], [45, 25387], [50, 25587], [53, 25767], [56, 25907], [61, 26630], [65, 26767], [68, 26907], [74, 27167], [78, 27347], [85, 27627], [90, 27947], [95, 28207], [99, 28367], [108, 28747], [114, 29047], [118, 29427], [121, 29587]]}, {"verse": 5, "start": 30423, "end": 38135, "text": "Jesus answered, Most assuredly I say to you Unless a man be born of water and of the Spirit he can not enter into the kingdom of God", "words": [[0, 30423], [6, 30700], [16, 31671], [21, 31832], [31, 32472], [33, 32632], [37, 32852], [40, 33052], [44, 33372], [51, 33572], [53, 33772], [57, 34012], [60, 34212], [65, 34472], [68, 34632], [74, 34912], [78, 35152], [81, 35272], [85, 35412], [92, 35992], [95, 36132], [99, 36272], [103, 36412], [109, 36792], [114, 37012], [118, 37192], [126, 37452], [129, 37652]]}, {"verse": 6, "start": 38485, "end": 44108, "text": "That which is born of the flesh is flesh; and that which is born of the Spirit is spirit.", "words": [[0, 38485], [5, 38741], [11, 38961], [14, 39161], [19, 39501], [22, 39781], [26, 39901], [32, 40281], [35, 40561], [42, 41397], [46, 41517], [51, 41677], [57, 41897], [60, 42057], [65, 42317], [68, 42477], [72, 42617], [79, 43057], [82, 43457]]}, {"verse": 7, "start": 44458, "end": 47747, "text": "Marvel not that I said to you, You must be born again.", "words": [[0, 44458], [7, 44938], [11, 45078], [16, 45298], [18, 45418], [23, 45618], [26, 45818], [31, 46178], [35, 46318], [40, 46518], [43, 46758], [48, 47038]]}, {"verse": 8, "start": 48097, "end": 57235, "text": "The wind blows where it wishes, and you hear the sound of it, but can not tell from where it comes, and where it goes: so is every one that is born of the Spirit.", "words": [[0, 48097], [4, 48174], [9, 48474], [15, 48814], [21, 49174], [24, 49314], [32, 50054], [36, 50354], [40, 50474], [45, 50694], [49, 50834], [55, 51194], [58, 51334], [62, 51574], [66, 51707], [70, 51841], [74, 51974], [79, 52354], [84, 52574], [90, 52754], [93, 52874], [100, 53214], [104, 53754], [110, 53954], [113, 5