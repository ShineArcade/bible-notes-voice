{"book": "GEN", "chapter": 25, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 247829, "verses": [{"verse": 1, "start": 300, "end": 4333, "text": "Then again Abraham took a wife, and her name was Keturah.", "words": [[0, 300], [5, 460], [11, 1060], [19, 1380], [24, 1720], [26, 1880], [32, 2860], [36, 2940], [40, 3080], [45, 3320], [49, 3860]]}, {"verse": 2, "start": 4683, "end": 10787, "text": "And she bore him Zimran, and Jokshan, and Medan, and Midian, and Ishbak, and Shuah.", "words": [[0, 4683], [4, 4804], [8, 4944], [13, 5204], [17, 5384], [25, 6304], [29, 6824], [38, 7344], [42, 7424], [49, 8144], [53, 8204], [61, 8984], [65, 9494], [73, 10004], [77, 10396]]}, {"verse": 3, "start": 11137, "end": 17717, "text": "And Jokshan begot Sheba, and Dedan. And the sons of Dedan were Asshurim, and Letushim, and Leummim.", "words": [[0, 11137], [4, 11562], [12, 11987], [18, 12412], [25, 12837], [29, 13368], [36, 14060], [40, 14168], [44, 14268], [49, 14528], [52, 14798], [58, 15068], [63, 15488], [73, 15908], [77, 16378], [87, 16848], [91, 17305]]}, {"verse": 4, "start": 18067, "end": 26586, "text": "And the sons of Midian; Ephah, and Epher, and Hanoch, and Abidah, and Eldaah. All these were the children of Keturah.", "words": [[0, 18067], [4, 18194], [8, 18294], [13, 18514], [16, 18694], [24, 19991], [31, 19991], [35, 20482], [42, 21012], [46, 21472], [54, 21932], [58, 22462], [66, 22992], [70, 23394], [78, 23960], [82, 24415], [88, 24595], [93, 24835], [97, 24955], [106, 25315], [109, 25988]]}, {"verse": 5, "start": 26936, "end": 29368, "text": "¶ And Abraham gave all that he had to Isaac.", "words": [[2, 26936], [6, 27063], [14, 27483], [19, 27823], [23, 28163], [28, 28363], [31, 28483], [35, 28723], [38, 28883]]}, {"verse": 6, "start": 29718, "end": 40118, "text": "But to the sons of the concubines, which Abraham had, Abraham gave gifts, and sent them away from Isaac his son, while he yet lived, eastward, to the east country.", "words": [[0, 29718], [4, 29826], [7, 29966], [11, 30106], [16, 30406], [19, 30606], [23, 30706], [35, 31466], [41, 31726], [49, 32206], [54, 33066], [62, 33466], [67, 33866], [74, 34246], [78, 34586], [83, 34826], [88, 35066], [93, 35366], [98, 35586], [104, 35966], [108, 36246], [113, 36886], [119, 37146], [122, 37366], [126, 37586], [133, 37906], [143, 38726], [146, 39146], [150, 39286], [155, 39486]]}, {"verse": 7, "start": 40468, "end": 46591, "text": "And these are the days of the years of Abraham’s life which he lived, a hundred threescore and fifteen years.", "words": [[0, 40468], [4, 40607], [10, 40807], [14, 40967], [18, 41107], [23, 41367], [26, 41607], [30, 41707], [36, 42007], [39, 42227], [49, 42907], [54, 43167], [60, 43447], [63, 43587], [70, 43956], [72, 44324], [80, 44693], [91, 45062], [95, 45402], [103, 45742]]}, {"verse": 8, "start": 46941, "end": 55670, "text": "Then Abraham breathed his last, and died in a good old age, an old man, and full of years; and was gathered to his people.", "words": [[0, 46941], [5, 47128], [13, 47628], [22, 48268], [26, 48388], [32, 48888], [36, 49203], [41, 49523], [44, 49743], [46, 49883], [51, 50083], [55, 50323], [60, 51403], [63, 51523], [67, 51723], [72, 52083], [76, 52743], [81, 52963], [84, 53123], [91, 54042], [95, 54188], [99, 54328], [108, 54708], [111, 54988], [115, 55128]]}, {"verse": 9, "start": 56020, "end": 65329, "text": "And his sons Isaac and Ishmael buried him in the cave of Machpelah, in the field of Ephron the son of Zohar the Hittite, which is before Mamre;", "words": [[0, 56020], [4, 56152], [8, 56272], [13, 56672], [19, 57172], [23, 57472], [31, 57992], [38, 58272], [42, 58572], [45, 58752], [49, 58852], [54, 59132], [57, 59592], [68, 60052], [71, 60652], [75, 60752], [81, 61052], [84, 61252], [91, 61892], [95, 61932], [99, 62192], [102, 62332], [108, 62832], [112, 62972], [121, 63872], [127, 64032], [130, 64192], [137, 64592]]}, {"verse": 10, "start": 65679, "end": 71809, "text": "The field which Abraham purchased of the sons of Heth: there was Abraham buried, and Sarah his wife.", "words": [[0, 65679], [4, 65800], [10, 66120], [16, 66360], [24, 66780], [34, 67320], [37, 67560], [41, 67680], [46, 67960], [49, 68140], [55, 68724], [61, 68889], [65, 69189], [73, 69889], [81, 70409], [85, 70889], [91, 71209], [95, 71429]]}, {"verse": 11, "start": 72159, "end": 79928, "text": "¶ And it came to pass after the death of Abraham, that God blessed his son Isaac; and Isaac dwelt by the well Lahai-roi.", "words": [[2, 72159], [6, 72299], [9, 72399], [14, 72599], [17, 72799], [22, 73059], [28, 73399], [32, 73539], [38, 73779], [41, 73959], [50, 74479], [55, 75119], [59, 75379], [67, 75719], [71, 75999], [75, 76279], [82, 77126], [86, 77252], [92, 77732], [98, 78092], [101, 78292], [105, 78432], [110, 79211]]}, {"verse": 12, "start": 80278, "end": 88719, "text": "¶ Now these are the generations of Ishmael, Abraham’s son, whom Hagar the Egyptian, Sarah’s handmaid, bore to Abraham:", "words": [[2, 80278], [6, 80566], [12, 80926], [16, 81186], [20, 81306], [32, 81906], [35, 82246], [44, 83106], [54, 83846], [59, 84566], [64, 84746], [70, 85146], [74, 85406], [84, 86246], [92, 86786], [102, 87506], [107, 87666], [110, 87866]]}, {"verse": 13, "start": 89069, "end": 100285, "text": "And these are the names of the sons of Ishmael, by their names, according to their generations: the firstborn of Ishmael, Nebajoth; and Kedar, and Adbeel, and Mibsam,", "words": [[0, 89069], [4, 89269], [10, 89509], [14, 89729], [18, 89849], [24, 90189], [27, 90429], [31, 90549], [36, 90849], [39, 91109], [48, 91789], [51, 92089], [57, 92309], [64, 92769], [74, 93469], [77, 93829], [83, 94009], [96, 95587], [100, 95673], [110, 95760], [113, 95960], [122, 96698], [132, 97595], [136, 97985], [143, 98415], [147, 98965], [155, 99515], [159, 99900]]}, {"verse": 14, "start": 100635, "end": 102950, "text": "And Mishma, and Dumah, and Massa,", "words": [[0, 100635], [4, 100790], [12, 101330], [16, 101660], [23, 101990], [27, 102350]]}, {"verse": 15, "start": 103300, "end": 106681, "text": "Hadar, and Tema, Jetur, Naphish, and Kedemah:", "words": [[0, 103451], [7, 103611], [11, 104226], [17, 104841], [24, 105456], [33, 106071], [37, 106406]]}, {"verse": 16, "start": 107031, "end": 114410, "text": "These are the sons of Ishmael, and these are their names, by their towns, and by their castles; twelve princes according to their nations.", "words": [[0, 107031], [6, 107183], [10, 107323], [14, 107423], [19, 107623], [22, 107803], [31, 108403], [35, 108583], [41, 108763], [45, 108903], [51, 109043], [58, 109403], [61, 109843], [67, 110003], [74, 110423], [78, 110923], [81, 111083], [87, 111243], [96, 112328], [103, 112548], [111, 113008], [121, 113348], [124, 113608], [130, 113768]]}, {"verse": 17, "start": 114760, "end": 122803, "text": "And these are the years of the life of Ishmael, a hundred and thirty and seven years: and he breathed his last and died; and was gathered to his people.", "words": [[0, 114760], [4, 114902], [10, 115102], [14, 115262], [18, 115402], [24, 115662], [27, 115882], [31, 115982], [36, 116262], [39, 116402], [48, 116691], [50, 116979], [58, 117268], [62, 117556], [69, 117845], [73, 118133], [79, 118422], [86, 119178], [90, 119302], [93, 119422], [102, 119842], [106, 119962], [111, 120302], [115, 120562], [121, 121334], [125, 121459], [129, 121619], [138, 121959], [141, 122199], [145, 122339]]}, {"verse": 18, "start": 123153, "end": 131507, "text": "And they dwelt from Havilah to Shur, that is before Egypt, as you go toward Assyria: and he died in the presence of all his brethren.", "words": [[0, 123153], [4, 123294], [9, 123434], [15, 123794], [20, 124184], [28, 124574], [31, 124774], [37, 125674], [42, 125794], [45, 125954], [52, 126314], [59, 127094], [62, 127294], [66, 127414], [69, 127594], [76, 127934], [85, 128885], [89, 129031], [92, 129131], [97, 129431], [100, 129671], [104, 129751], [113, 130071], [116, 130371], [120, 130631], [124, 130831]]}, {"verse": 19, "start": 131857, "end": 136797, "text": "¶ And these are the generations of Isaac, Abraham’s son: Abraham begot Isaac:", "words": [[2, 131857], [6, 132000], [12, 132200], [16, 132360], [20, 132480], [32, 133040], [35, 133340], [42, 133960], [52, 134640], [57, 135255], [65, 135717], [71, 136217]]}, {"verse": 20, "start": 137147, "end": 146449, "text": "And Isaac was forty years old when he took Rebekah to wife, the daughter of Bethuel the Syrian of Padan-aram, the sister to Laban the Syrian.", "words": [[0, 137147], [4, 137269], [10, 137589], [14, 137909], [20, 138229], [26, 138509], [30, 138909], [35, 139129], [38, 139249], [43, 139469], [51, 140049], [54, 140109], [60, 140969], [64, 141009], [73, 141329], [76, 141729], [84, 142129], [88, 142289], [95, 142649], [98, 143559], [110, 144469], [114, 144569], [121, 144869], [124, 145109], [130, 145609], [134, 145809]]}, {"verse": 21, "start": 146799, "end": 155170, "text": "And Isaac entreated the LORD for his wife, because she was barren: and the LORD was entreated of him, and Rebekah his wife conceived.", "words": [[0, 146799], [4, 146948], [10, 147348], [20, 147868], [24, 148088], [29, 148328], [33, 148548], [37, 148748], [43, 149108], [51, 149708], [55, 149988], [59, 150188], [67, 151036], [71, 151376], [75, 151476], [80, 151716], [84, 151916], [94, 152336], [97, 152636], [102, 153156], [106, 153256], [114, 153776], [118, 153956], [123, 154196]]}, {"verse": 22, "start": 155520, "end": 163122, "text": "And the children struggled together within her; and she said, If it be so, why am I thus? And she went to enquire of the LORD.", "words": [[0, 155520], [4, 155760], [8, 155880], [17, 156280], [27, 156680], [36, 157120], [43, 157480], [48, 158123], [52, 158247], [56, 158427], [62, 159145], [65, 159308], [68, 159408], [71, 159528], [75, 160048], [79, 160188], [82, 160368], [84, 160508], [90, 161174], [94, 161287], [98, 161447], [103, 161647], [106, 162017], [114, 162387], [117, 162507], [121, 162607]]}, {"verse": 23, "start": 163472, "end": 174080, "text": "And the LORD said to her, Two nations are in your womb, and two manner of people shall be separated from your bowels; and the one people shall be stronger than the other people; and the elder shall serve the younger.", "words": [[0, 163472], [4, 163587], [8, 163687], [13, 163847], [18, 164107], [21, 164307], [26, 164855], [30, 164970], [38, 165290], [42, 165530], [45, 165650], [50, 165770], [56, 166330], [60, 166410], [64, 166570], [71, 166830], [74, 167010], [81, 167230], [87, 167450], [90, 167590], [100, 168010], [105, 168270], [110, 168410], [118, 169531], [122, 169643], [126, 169743], [130, 169883], [137, 170143], [143, 170363], [146, 170503], [155, 170823], [160, 171063], [164, 171183], [170, 171323], [178, 172318], [182, 172420], [186, 172500], [192, 172780], [198, 173080], [204, 173380], [208, 173560]]}, {"verse": 24, "start": 174599, "end": 179405, "text": "¶ And when her days to be delivered were fulfilled, behold, there were twins in her womb.", "words": [[2, 174599], [6, 174711], [11, 174871], [15, 175051], [20, 175331], [23, 175531], [26, 175651], [36, 176071], [41, 176351], [52, 177111], [60, 177851], [66, 177931], [71, 178071], [77, 178411], [80, 178711], [84, 178891]]}, {"verse": 25, "start": 179755, "end": 185437, "text": "And the first came out red, all over like a hairy garment; and they called his name Esau.", "words": [[0, 179755], [4, 179880], [8, 180000], [14, 180260], [19, 180540], [23, 180780], [28, 181460], [32, 181740], [37, 182040], [42, 182320], [44, 182400], [50, 182680], [59, 183543], [63, 183668], [68, 183788], [75, 184048], [79, 184288], [84, 184628]]}, {"verse": 26, "start": 185787, "end": 195167, "text": "And after that came his brother out, and his hand took hold on Esau’s heel; and his name was called Jacob: and Isaac was threescore years old when she bore them.", "words": [[0, 185787], [4, 185936], [10, 186236], [15, 186476], [20, 186756], [24, 186936], [32, 187216], [37, 187716], [41, 188056], [45, 188216], [50, 188496], [55, 188636], [60, 188956], [63, 189176], [70, 189776], [76, 190422], [80, 190725], [84, 190865], [89, 191105], [93, 191285], [100, 191505], [107, 192399], [111, 192541], [117, 192901], [121, 193331], [132, 193761], [138, 193961], [142, 194241], [147, 194441], [151, 194581], [156, 194821]]}, {"verse": 27, "start": 195517, "end": 203430, "text": "And the boys grew: and Esau was a cunning hunter, a man of the field; and Jacob was a plain man, dwelling in tents.", "words": [[0, 195517], [4, 195660], [8, 195760], [13, 196080], [19, 197006], [23, 197172], [28, 197732], [32, 197972], [34, 198152], [42, 198372], [50, 199132], [52, 199212], [56, 199412], [59, 199572], [63, 199712], [70, 200502], [74, 200650], [80, 200930], [84, 201210], [86, 201330], [92, 201650], [97, 202290], [106, 202490], [109, 202830]]}, {"verse": 28, "start": 203780, "end": 209226, "text": "And Isaac loved Esau, because he did eat of his venison: but Rebekah loved Jacob.", "words": [[0, 203780], [4, 203928], [10, 204248], [16, 204688], [22, 205308], [30, 205888], [33, 206128], [37, 206368], [41, 206488], [44, 206628], [48, 206748], [57, 207639], [61, 207858], [69, 208108], [75, 208528]]}, {"verse": 29, "start": 209576, "end": 214375, "text": "¶ And Jacob boiled pottage: and Esau came from the field, and he was faint:", "words": [[2, 209576], [6, 209722], [12, 210022], [19, 210675], [28, 211485], [32, 211634], [37, 212074], [42, 212354], [47, 212594], [51, 212734], [58, 213434], [62, 213594], [65, 213694], [69, 213854]]}, {"verse": 30, "start": 214725, "end": 222271, "text": "And Esau said to Jacob, Feed me, please, with that same red pottage; for I am faint: therefore was his name called Edom.", "words": [[0, 214725], [4, 214872], [9, 215292], [14, 215532], [17, 215732], [24, 216636], [29, 216764], [33, 216904], [41, 217424], [46, 217684], [51, 217824], [56, 218024], [60, 218414], [69, 218997], [73, 219114], [75, 219274], [78, 219394], [85, 220168], [95, 220523], [99, 220863], [103, 221023], [108, 221263], [115, 221603]]}, {"verse": 31, "start": 222621, "end": 225242, "text": "And Jacob said, Sell me this day your birthright.", "words": [[0, 222621], [4, 222745], [10, 223025], [16, 223820], [21, 223880], [24, 224060], [29, 224200], [33, 224420], [38, 224580]]}, {"verse": 32, "start": 225522, "end": 231224, "text": "And Esau said, Behold, I am at the point to die: and what profit shall this birthright do to me?", "words": [[0, 225522], [4, 225685], [9, 226225], [15, 226877], [23, 227336], [25, 227596], [28, 227776], [31, 227896], [35, 228016], [41, 228216], [44, 228416], [49, 229049], [53, 229166], [58, 229306], [65, 229666], [71, 229906], [76, 230146], [87, 230606], [90, 230826], [93, 230966]]}, {"verse": 33, "start": 231504, "end": 237332, "text": "And Jacob said, Swear to me this day; and he swore to him: and he sold his birthright to Jacob.", "words": [[0, 231504], [4, 231651], [10, 231951], [16, 232653], [22, 232932], [25, 233072], [28, 233232], [33, 233412], [38, 234045], [42, 234168], [45, 234268], [51, 234628], [54, 234788], [59, 235341], [63, 235486], [66, 235586], [71, 235846], [75, 236066], [86, 236606], [89, 236786]]}, {"verse": 34, "start": 237682, "end": 247429, "text": "Then Jacob gave Esau bread and pottage of lentils; and he did eat and drink, and rose up, and went his way: thus Esau despised his birthright.", "words": [[0, 237682], [5, 237865], [11, 238165], [16, 238485], [21, 239005], [27, 239325], [31, 239685], [39, 240045], [42, 240165], [51, 241079], [55, 241399], [58, 241519], [62, 241719], [66, 242059], [70, 242299], [77, 242659], [81, 243159], [86, 243379], [90, 243699], [94, 243979], [99, 244139], [103, 244339], [108, 245073], [113, 245322], [118, 245962], [127, 246562], [131, 246722]]}]}