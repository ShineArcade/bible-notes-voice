{"book": "MAT", "chapter": 17, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 241414, "verses": [{"verse": 1, "start": 300, "end": 9599, "text": "Y después de seis días, Jesús toma a Pedro, y a Jacobo, y a Juan su hermano, y los lleva aparte a un monte alto:", "words": [[0, 300], [2, 424], [10, 684], [13, 904], [18, 1244], [24, 1684], [30, 2324], [35, 3104], [37, 3264], [44, 3644], [46, 4244], [48, 4304], [56, 5104], [58, 5404], [60, 5484], [65, 5764], [68, 6084], [77, 6784], [79, 6924], [83, 7084], [89, 7344], [96, 8144], [98, 8284], [101, 8464], [107, 8884]]}, {"verse": 2, "start": 10049, "end": 18745, "text": "Y se transfiguró delante de ellos; y resplandeció su rostro como el sol, y sus vestidos fueron blancos como la luz.", "words": [[0, 10049], [2, 10136], [5, 10276], [17, 11076], [25, 11456], [28, 11656], [35, 12561], [37, 12723], [50, 13743], [53, 13923], [60, 14503], [65, 14743], [68, 14943], [73, 15263], [75, 15803], [79, 15983], [88, 16583], [95, 16923], [103, 17683], [108, 17983], [111, 18203]]}, {"verse": 3, "start": 19195, "end": 24409, "text": "Y he aquí les aparecieron Moisés y Elías, hablando con él.", "words": [[0, 19195], [2, 19508], [5, 19808], [10, 20228], [14, 20648], [26, 21448], [33, 21988], [35, 22388], [42, 23228], [51, 23548], [55, 23968]]}, {"verse": 4, "start": 24859, "end": 36914, "text": "Y respondiendo Pedro, dijo a Jesús: Señor, bien es que nos quedemos aquí: si quieres, hagamos aquí tres refugios: para ti uno, y para Moisés otro, y otro para Elías.", "words": [[0, 24859], [2, 24982], [15, 25722], [22, 26562], [27, 27022], [29, 27222], [36, 28104], [43, 28385], [48, 29165], [51, 29285], [55, 29405], [59, 29545], [68, 29945], [74, 30703], [77, 30861], [86, 31181], [94, 31821], [99, 32041], [104, 32321], [114, 33442], [119, 33587], [122, 33807], [127, 34107], [129, 34467], [134, 34647], [141, 34987], [147, 35367], [149, 35787], [154, 36027], [159, 36287]]}, {"verse": 5, "start": 37264, "end": 50297, "text": "Y estando aún él hablando, he aquí una nube de luz que los cubrió; y he aquí una voz de la nube, que dijo: Este es mi Hijo amado, en el cual tengo mi agrado: a él oíd.", "words": [[0, 37264], [2, 37390], [10, 37890], [14, 38170], [17, 38390], [27, 39000], [30, 39610], [35, 39850], [39, 40050], [44, 40490], [47, 40650], [51, 40910], [55, 41470], [59, 41610], [67, 42591], [69, 42714], [72, 42864], [77, 43124], [81, 43364], [85, 43684], [88, 43884], [91, 44004], [97, 44364], [101, 44564], [107, 45384], [112, 45708], [115, 45948], [118, 46128], [123, 46368], [130, 47088], [133, 47188], [136, 47288], [141, 47488], [147, 47868], [150, 48088], [158, 49169], [160, 49344], [163, 49694]]}, {"verse": 6, "start": 50647, "end": 56594, "text": "Y oyendo esto los discípulos, cayeron sobre sus rostros, y temieron en gran manera.", "words": [[0, 50647], [2, 50809], [9, 51209], [14, 51509], [18, 51709], [30, 52489], [38, 53389], [44, 53649], [48, 53909], [57, 54609], [59, 54989], [68, 55489], [71, 55709], [76, 55909]]}, {"verse": 7, "start": 57044, "end": 62816, "text": "Entonces Jesús llegando, los tocó, y dijo: Levantaos, y no temáis.", "words": [[0, 57044], [9, 57688], [15, 58181], [25, 58675], [29, 59168], [35, 59828], [37, 60028], [43, 60837], [54, 61664], [56, 61884], [59, 62004]]}, {"verse": 8, "start": 63266, "end": 67834, "text": "Y alzando ellos sus ojos, a nadie vieron, sino a solo Jesús.", "words": [[0, 63266], [2, 63386], [10, 63906], [16, 64126], [20, 64426], [26, 64806], [28, 65246], [34, 65566], [42, 66506], [47, 66726], [49, 66926], [54, 67086]]}, {"verse": 9, "start": 68284, "end": 78691, "text": "Y como descendieron del monte, les mandó Jesús, diciendo: No digáis a nadie la visión, hasta que el Hijo del hombre resucite de los muertos.", "words": [[0, 68284], [2, 68394], [7, 68674], [20, 69414], [24, 69634], [31, 70654], [35, 70754], [41, 71114], [48, 71594], [58, 72835], [61, 73163], [68, 73523], [70, 73683], [76, 73983], [79, 74203], [87, 74963], [93, 75503], [97, 75723], [100, 75903], [105, 76163], [109, 76323], [116, 76763], [125, 77663], [128, 77803], [132, 77943]]}, {"verse": 10, "start": 79141, "end": 87228, "text": "Entonces sus discípulos le preguntaron, diciendo: ¿Por qué dicen pues los escribas que es necesario que Elías venga primero?", "words": [[0, 79141], [9, 79998], [13, 80218], [24, 80958], [27, 81258], [40, 82058], [50, 83382], [55, 83517], [59, 83677], [65, 83977], [70, 84197], [74, 84377], [83, 84937], [87, 85097], [90, 85217], [100, 85777], [104, 86017], [110, 86397], [116, 86657]]}, {"verse": 11, "start": 87578, "end": 95346, "text": "Y respondiendo Jesús, les dijo: A la verdad, Elías vendrá primero, y restaurará todas las cosas.", "words": [[0, 87578], [2, 87765], [15, 88825], [22, 89185], [26, 89645], [32, 90598], [34, 90842], [37, 90902], [45, 91402], [51, 91882], [58, 92202], [67, 92702], [69, 93202], [80, 94102], [86, 94362], [90, 94662]]}, {"verse": 12, "start": 95796, "end": 106275, "text": "Pero os digo, que ya vino Elías, y no le conocieron; antes hicieron en él todo lo que quisieron: así también el Hijo del hombre padecerá de ellos.", "words": [[0, 95796], [5, 96058], [8, 96198], [14, 96378], [18, 96578], [21, 96758], [26, 96938], [33, 97598], [35, 98038], [38, 98178], [41, 98298], [53, 99489], [59, 99916], [68, 100636], [71, 100816], [74, 101036], [79, 101516], [82, 101796], [86, 101916], [97, 102983], [101, 103284], [109, 103704], [112, 104004], [117, 104284], [121, 104424], [128, 104844], [137, 105524], [140, 105664]]}, {"verse": 13, "start": 106725, "end": 111524, "text": "Los discípulos entonces entendieron, que les habló de Juan el Bautista.", "words": [[0, 106725], [4, 106970], [15, 107630], [24, 108130], [37, 109050], [41, 109690], [45, 109830], [51, 110230], [54, 110310], [59, 110550], [62, 110750]]}, {"verse": 14, "start": 111974, "end": 118396, "text": "Y como ellos llegaron al gentío, vino a él un hombre arrodillándose ante él,", "words": [[0, 111974], [2, 112101], [7, 112361], [13, 112621], [22, 113141], [25, 113321], [33, 114481], [38, 115021], [40, 115261], [43, 115561], [46, 115861], [53, 116568], [68, 117274], [73, 117981]]}, {"verse": 15, "start": 118846, "end": 130385, "text": "Y diciendo: Señor, ten misericordia de mi hijo, que sufre convulsiones y padece mucho; porque muchas veces cae en el fuego, y muchas en el agua.", "words": [[0, 118846], [2, 118993], [12, 121111], [19, 121563], [23, 121663], [36, 122423], [39, 122543], [42, 122703], [48, 123243], [52, 123543], [58, 123903], [71, 124643], [73, 124823], [80, 125163], [87, 126018], [94, 126185], [101, 126485], [107, 126785], [111, 127085], [114, 127385], [117, 127505], [124, 127785], [126, 128145], [133, 128445], [136, 128665], [139, 128805]]}, {"verse": 16, "start": 130835, "end": 134587, "text": "Y le he presentado a tus discípulos, y no le han podido sanar.", "words": [[0, 130835], [2, 130979], [5, 131079], [8, 131199], [19, 131819], [21, 131939], [25, 132079], [37, 132719], [39, 133319], [42, 133499], [45, 133639], [49, 133759], [56, 134119]]}, {"verse": 17, "start": 134937, "end": 146678, "text": "Y respondiendo Jesús, dijo: ¡Oh generación incrédula y perversa! ¿hasta cuándo tengo de estar con vosotros? ¿hasta cuándo os tengo de sufrir? traédmele acá.", "words": [[0, 134937], [2, 135055], [15, 135795], [22, 136215], [28, 137644], [32, 137724], [43, 138404], [53, 139244], [55, 139384], [65, 140573], [72, 140893], [79, 141133], [85, 141573], [88, 141793], [94, 142033], [98, 142293], [108, 143486], [115, 143672], [122, 143812], [125, 143952], [131, 144392], [134, 144572], [142, 145561], [152, 146165]]}, {"verse": 18, "start": 147128, "end": 154025, "text": "Y Jesús le reprendió, y salió el demonio de él; y el muchacho fue sano desde aquella hora.", "words": [[0, 147128], [2, 147254], [8, 147594], [11, 148054], [22, 148814], [24, 149254], [30, 149714], [33, 149974], [41, 150514], [44, 150654], [48, 151378], [50, 151544], [53, 151744], [62, 152284], [66, 152504], [71, 152924], [77, 153164], [85, 153544]]}, {"verse": 19, "start": 154475, "end": 162028, "text": "Entonces, viniendo los discípulos a Jesús, aparte, dijeron: ¿Por qué nosotros no lo pudimos echar fuera?", "words": [[0, 154475], [10, 155596], [19, 156196], [23, 156356], [34, 156956], [36, 157116], [43, 157796], [51, 158656], [60, 159572], [65, 159716], [69, 159916], [78, 160296], [81, 160596], [84, 160716], [92, 161176], [98, 161476]]}, {"verse": 20, "start": 162378, "end": 175864, "text": "Y Jesús les dijo: Por vuestra poca fe; porque de cierto os digo, que si tenéis fe como un grano de mostaza, diréis a este monte: Pásate de aquí allá: y se pasará: y nada os será imposible.", "words": [[0, 162378], [2, 162501], [8, 162821], [12, 163081], [18, 163963], [22, 164125], [30, 164445], [35, 164805], [39, 165444], [46, 165628], [49, 165788], [56, 166028], [59, 166408], [65, 166648], [69, 166828], [72, 166968], [79, 167388], [82, 167648], [87, 167948], [90, 168108], [96, 168468], [99, 168608], [108, 169208], [115, 169948], [117, 170108], [122, 170328], [129, 171251], [136, 171640], [139, 171820], [144, 172228], [150, 172885], [152, 172992], [155, 173112], [163, 174138], [165, 174266], [170, 174516], [173, 174766], [178, 174946]]}, {"verse": 21, "start": 176314, "end": 179558, "text": "Pero esta clase no sale sino por oración y ayuno.", "words": [[0, 176314], [5, 176457], [10, 176697], [16, 177097], [19, 177317], [24, 177557], [29, 177837], [33, 178097], [41, 178597], [43, 178897]]}, {"verse": 22, "start": 180008, "end": 186557, "text": "Y estando ellos en Galilea, Jesús les dijo: El Hijo del hombre será entregado en manos de hombres,", "words": [[0, 180008], [2, 180152], [10, 180572], [16, 180832], [19, 181092], [28, 181972], [34, 182252], [38, 182632], [44, 183466], [47, 183626], [52, 183826], [56, 184006], [63, 184346], [68, 184646], [78, 185326], [81, 185446], [87, 185666], [90, 185886]]}, {"verse": 23, "start": 187007, "end": 193255, "text": "Y le matarán; pero al tercer día resucitará. Y ellos se entristecieron en gran manera.", "words": [[0, 187007], [2, 187324], [5, 187673], [14, 188266], [19, 188391], [22, 188551], [29, 188791], [33, 189211], [45, 190589], [47, 190755], [53, 190975], [56, 191235], [71, 192295], [74, 192415], [79, 192595]]}, {"verse": 24, "start": 193705, "end": 202226, "text": "Y cuando llegaron a Capernaum, vinieron a Pedro los que cobraban las dos dracmas, y dijeron: ¿Vuestro Maestro no paga las dos dracmas?", "words": [[0, 193705], [2, 193784], [9, 193944], [18, 194464], [20, 194604], [31, 195404], [40, 196164], [42, 196324], [48, 196624], [52, 196844], [56, 196984], [65, 197564], [69, 197744], [73, 197924], [82, 198444], [84, 198604], [93, 199662], [102, 200043], [110, 200563], [113, 200743], [118, 201143], [122, 201323], [126, 201543]]}, {"verse": 25, "start": 202576, "end": 218655, "text": "Él dice: Sí. Y entrando él en casa, Jesús le habló antes, diciendo: ¿Qué te parece, Simón? Los reyes de la tierra, ¿de quién cobran los tributos o el censo? ¿de sus hijos o de los extraños?", "words": [[0, 202576], [3, 202780], [9, 204080], [13, 205060], [15, 205219], [24, 205779], [27, 206119], [30, 206279], [36, 207199], [42, 207639], [45, 208039], [51, 208359], [58, 208759], [68, 210070], [73, 210176], [76, 210336], [84, 210796], [91, 211674], [95, 211799], [101, 212159], [104, 212319], [107, 212419], [115, 213099], [119, 213359], [125, 213559], [132, 214159], [136, 214299], [145, 214939], [147, 215059], [150, 215481], [157, 216202], [161, 216442], [165, 216642], [171, 217002], [173, 217462], [176, 217522], [180, 217662]]}, {"verse": 26, "start": 219105, "end": 225564, "text": "Pedro le dice: De los extraños. Jesús le dijo: Luego los hijos son exentos.", "words": [[0, 219105], [6, 219369], [9, 219589], [15, 220361], [18, 220501], [22, 220601], [32, 221814], [38, 222228], [41, 222728], [47, 223564], [53, 223793], [57, 224093], [63, 224373], [67, 224653]]}, {"verse": 27, "start": 226014, "end": 241014, "text": "Pero porque no los ofendamos, ve al mar, y echa el anzuelo, y el primer pez que saques, tómalo, y al abrirle la boca, hallarás una moneda de cuatro dracmas: tómala, y dásela por mí y por ti.", "words": [[0, 226014], [5, 226178], [12, 226498], [15, 226698], [19, 226898], [30, 228038], [33, 228318], [36, 228638], [41, 228958], [43, 229538], [48, 229918], [51, 230138], [60, 230898], [62, 231038], [65, 231198], [72, 231498], [76, 231878], [80, 231958], [88, 232858], [96, 233498], [98, 233758], [101, 233878], [109, 234418], [112, 234558], [118, 235238], [127, 235798], [131, 235998], [138, 236478], [141, 236638], [148, 236998], [157, 238236], [165, 238841], [167, 239301], [174, 239801], [178, 239981], [181, 240181], [183, 240441], [187, 240621]]}]}