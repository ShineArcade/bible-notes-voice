{"book": "ROM", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 236409, "verses": [{"verse": 1, "start": 300, "end": 5874, "text": "Verdad digo en Cristo, no miento, dándome testimonio mi conciencia en el Espíritu Santo,", "words": [[0, 300], [7, 591], [12, 891], [15, 1091], [23, 1911], [26, 1991], [34, 2891], [42, 3271], [53, 3931], [56, 4031], [67, 4651], [70, 4791], [73, 4891], [82, 5391]]}, {"verse": 2, "start": 6324, "end": 9300, "text": "Que tengo gran tristeza y continuo dolor en mi corazón.", "words": [[0, 6324], [4, 6385], [10, 6585], [15, 6845], [24, 7485], [26, 7565], [35, 8085], [41, 8365], [44, 8525], [47, 8625]]}, {"verse": 3, "start": 9750, "end": 15651, "text": "Porque deseara yo mismo ser apartado de Cristo por mis hermanos, los que son mis parientes según la carne;", "words": [[0, 9750], [7, 10160], [15, 10570], [18, 10730], [24, 10970], [28, 11250], [37, 11750], [40, 11910], [47, 12230], [51, 12490], [55, 12630], [65, 13530], [69, 13710], [73, 13850], [77, 14010], [81, 14170], [91, 14690], [97, 14970], [100, 15150]]}, {"verse": 4, "start": 16101, "end": 23274, "text": "Que son israelitas, de los cuales es la adopción, y la gloria, y el pacto, y la entrega de la ley, y el culto, y las promesas;", "words": [[0, 16101], [4, 16196], [8, 16376], [20, 17076], [23, 17256], [27, 17376], [34, 17636], [37, 17936], [40, 18096], [50, 18636], [52, 18916], [55, 19036], [63, 19516], [65, 19736], [68, 19856], [75, 20396], [77, 20516], [80, 20616], [88, 21016], [91, 21076], [94, 21196], [99, 21436], [101, 21676], [104, 21796], [111, 22276], [113, 22396], [117, 22536]]}, {"verse": 5, "start": 23724, "end": 32394, "text": "Cuyos son los padres, y de los cuales es Cristo según la carne, el cual es Dios sobre todas las cosas, bendito por los siglos. Amén.", "words": [[0, 23724], [6, 24063], [10, 24203], [14, 24323], [22, 24703], [24, 25123], [27, 25223], [31, 25343], [38, 25623], [41, 25983], [48, 26383], [54, 26683], [57, 26883], [64, 27743], [67, 27803], [72, 28043], [75, 28243], [80, 28483], [86, 28783], [92, 29063], [96, 29363], [103, 29743], [111, 30763], [115, 30963], [119, 31123], [127, 31969]]}, {"verse": 6, "start": 32844, "end": 39155, "text": "Pero no es que la palabra de Dios haya faltado: porque no todos los que son de Israel son israelitas;", "words": [[0, 32844], [5, 33002], [8, 33182], [11, 33382], [15, 33502], [18, 33642], [26, 33982], [29, 34182], [34, 34442], [39, 34822], [48, 35880], [55, 36102], [58, 36322], [64, 36662], [68, 36942], [72, 37122], [76, 37362], [79, 37482], [86, 37802], [90, 38202]]}, {"verse": 7, "start": 39605, "end": 47206, "text": "Ni por ser simiente de Abraham, son todos hijos; pero: En Isaac te será llamada descendencia.", "words": [[0, 39605], [3, 39726], [7, 39886], [11, 40106], [20, 40626], [23, 40806], [32, 41226], [36, 41746], [42, 42046], [49, 43011], [55, 43959], [58, 44119], [64, 44529], [67, 44939], [72, 45199], [80, 45739]]}, {"verse": 8, "start": 47506, "end": 55682, "text": "Quiere decir: No los que son hijos de la carne, estos son los hijos de Dios; sino que los que son hijos de la promesa, son contados como descendientes.", "words": [[0, 47506], [7, 47682], [14, 48522], [17, 48661], [21, 48801], [25, 48921], [29, 49121], [35, 49321], [38, 49461], [41, 49561], [48, 50061], [54, 50281], [58, 50521], [62, 50641], [68, 50861], [71, 51081], [77, 51849], [82, 52033], [86, 52193], [90, 52313], [94, 52453], [98, 52613], [104, 52853], [107, 52993], [110, 53073], [119, 53593], [123, 53953], [132, 54473], [137, 54673]]}, {"verse": 9, "start": 56132, "end": 62891, "text": "Porque la palabra de la promesa es esta: Como en este tiempo vendré, y tendrá Sara un hijo.", "words": [[0, 56132], [7, 56336], [10, 56516], [18, 56856], [21, 57016], [24, 57116], [32, 57656], [35, 57956], [41, 58905], [46, 59102], [49, 59242], [54, 59442], [61, 59882], [69, 60462], [71, 60942], [78, 61402], [83, 61782], [86, 62162]]}, {"verse": 10, "start": 63191, "end": 68723, "text": "Y no solo esto, sino que también a Rebeca, habiendo concebido de uno, de Isaac nuestro padre,", "words": [[0, 63191], [2, 63293], [5, 63393], [10, 63613], [16, 64293], [21, 64453], [25, 64593], [33, 64873], [35, 65033], [43, 65693], [52, 66033], [62, 66613], [65, 66773], [70, 67413], [73, 67673], [79, 67933], [87, 68133]]}, {"verse": 11, "start": 69173, "end": 79439, "text": "(Porque no siendo aún nacidos, ni habiendo hecho aún ni bien ni mal, para que el propósito de Dios conforme a la elección, no por las obras sino por el que llama, permaneciese;)", "words": [[0, 69173], [8, 69339], [11, 69539], [18, 69819], [22, 70079], [31, 70719], [34, 71199], [43, 71579], [49, 71879], [53, 72139], [56, 72339], [61, 72619], [64, 72799], [69, 73119], [74, 73679], [78, 73819], [81, 73939], [91, 74459], [94, 74579], [99, 74779], [108, 75319], [110, 75379], [113, 75439], [123, 76430], [126, 76556], [130, 76756], [134, 76896], [140, 77196], [145, 77636], [149, 77855], [152, 77955], [156, 78075], [163, 78416]]}, {"verse": 12, "start": 79889, "end": 82198, "text": "Le fue dicho que el mayor serviría al menor.", "words": [[0, 79889], [3, 80009], [7, 80169], [13, 80469], [17, 80669], [20, 80769], [26, 81049], [35, 81669], [38, 81789]]}, {"verse": 13, "start": 82648, "end": 86508, "text": "Como está escrito: A Jacob amé, mas a Esaú aborrecí.", "words": [[0, 82648], [5, 82792], [10, 82952], [19, 83845], [21, 83983], [27, 84223], [32, 84683], [36, 84923], [38, 85103], [43, 85683]]}, {"verse": 14, "start": 86808, "end": 90924, "text": "¿Pues qué diremos? ¿Que hay injusticia en Dios? En ninguna manera.", "words": [[0, 86808], [6, 86953], [10, 87093], [19, 88023], [24, 88125], [28, 88305], [39, 88945], [42, 89145], [48, 89955], [51, 90076], [59, 90336]]}, {"verse": 15, "start": 91374, "end": 99182, "text": "Pero a Moisés dice: Tendré misericordia del que tendré misericordia, y me compadeceré del que me compadeceré.", "words": [[0, 91374], [5, 91495], [7, 91635], [14, 91935], [20, 92893], [27, 93215], [40, 94175], [44, 94335], [48, 94515], [55, 94915], [69, 95875], [71, 96315], [74, 96435], [86, 97475], [90, 97675], [94, 97835], [97, 97975]]}, {"verse": 16, "start": 99482, "end": 103970, "text": "Así que no es del que quiere, ni del que corre, sino de Dios que tiene misericordia.", "words": [[0, 99482], [4, 99657], [8, 99797], [11, 99977], [14, 100117], [18, 100217], [22, 100377], [30, 100737], [33, 101097], [37, 101257], [41, 101357], [48, 102077], [53, 102237], [56, 102417], [61, 102677], [65, 102877], [71, 103077]]}, {"verse": 17, "start": 104420, "end": 114256, "text": "Porque la Escritura dice de Faraón: Que para esto mismo te he levantado, para mostrar en ti mi poder, y que mi nombre sea anunciado por toda la tierra.", "words": [[0, 104420], [7, 104587], [10, 104747], [20, 105267], [25, 105487], [28, 105917], [36, 106593], [40, 106674], [45, 106914], [50, 107214], [56, 107574], [59, 107874], [62, 107974], [73, 108694], [78, 109274], [86, 109714], [89, 109994], [92, 110174], [95, 110314], [102, 110714], [104, 111254], [108, 111354], [111, 111514], [118, 111814], [122, 112134], [132, 112794], [136, 113014], [141, 113234], [144, 113434]]}, {"verse": 18, "start": 114556, "end": 120027, "text": "De manera que Dios tiene misericordia de quien él quiere; y endurece a quien él quiere endurecer.", "words": [[0, 114556], [3, 114661], [10, 114861], [14, 115141], [19, 115341], [25, 115781], [38, 116641], [41, 116761], [47, 116961], [50, 117121], [58, 117959], [60, 118060], [69, 118560], [71, 118700], [77, 118840], [80, 119020], [87, 119300]]}, {"verse": 19, "start": 120477, "end": 125525, "text": "Me dirás pues: ¿Por qué, pues, se enoja? porque ¿quién resistirá a su voluntad?", "words": [[0, 120477], [3, 120580], [9, 120840], [15, 121695], [20, 121816], [25, 121896], [31, 121976], [34, 122356], [41, 123476], [48, 123686], [55, 123946], [65, 124666], [67, 124746], [70, 124846]]}, {"verse": 20, "start": 125975, "end": 133397, "text": "Pero antes, oh hombre, ¿quién eres tú, para que disputes con Dios? Dirá el vaso de barro al que le labró: ¿Por qué me has hecho tal?", "words": [[0, 125975], [5, 126117], [12, 126367], [15, 126617], [23, 127197], [30, 127417], [35, 127597], [39, 127837], [44, 128057], [48, 128197], [57, 128817], [61, 128997], [67, 129824], [72, 130121], [75, 130221], [80, 130561], [83, 130661], [89, 131021], [92, 131141], [96, 131281], [99, 131381], [106, 132182], [111, 132321], [115, 132461], [118, 132601], [122, 132741], [128, 132941]]}, {"verse": 21, "start": 133847, "end": 140124, "text": "¿O no tiene potestad el alfarero para hacer de la misma masa un vaso para honra, y otro para vergüenza?", "words": [[0, 133847], [3, 133964], [6, 134224], [12, 134484], [21, 134744], [24, 135004], [33, 135484], [38, 135704], [44, 136004], [47, 136144], [50, 136264], [56, 136524], [61, 136964], [64, 137324], [69, 137704], [74, 137924], [81, 138544], [83, 138864], [88, 139104], [93, 139404]]}, {"verse": 22, "start": 140574, "end": 148956, "text": "¿Y qué, si Dios, queriendo mostrar la ira y dar a conocer su poder, soportó con mucha paciencia los vasos de ira preparados para muerte,", "words": [[0, 140574], [3, 140669], [8, 140809], [11, 140989], [17, 141869], [27, 142309], [35, 142729], [38, 142969], [42, 143369], [44, 143549], [48, 143709], [50, 143789], [58, 144209], [61, 144429], [68, 145229], [76, 145689], [80, 145869], [86, 146129], [96, 146689], [100, 146869], [106, 147269], [109, 147389], [113, 147629], [124, 148169], [129, 148369]]}, {"verse": 23, "start": 149406, "end": 156659, "text": "Y para hacer notorias las riquezas de su gloria, las mostró para con los vasos de misericordia que él ha preparado para gloria;", "words": [[0, 149406], [2, 149524], [7, 149744], [13, 150044], [22, 150604], [26, 150764], [35, 151284], [38, 151444], [41, 151604], [49, 152164], [53, 152644], [60, 153104], [65, 153344], [69, 153564], [73, 153724], [79, 154104], [82, 154204], [95, 154984], [99, 155144], [102, 155324], [105, 155404], [115, 155904], [120, 156104]]}, {"verse": 24, "start": 157109, "end": 163513, "text": "Los cuales también ha llamado, es decir, a nosotros, no sólo de los judíos, sino también de los Gentiles?", "words": [[0, 157109], [4, 157213], [11, 157453], [19, 157833], [22, 158053], [31, 158473], [34, 158913], [41, 159373], [43, 159673], [53, 160413], [56, 160573], [61, 160793], [64, 160953], [68, 161073], [76, 161853], [81, 162093], [89, 162433], [92, 162573], [96, 162713]]}, {"verse": 25, "start": 163963, "end": 171056, "text": "Como también en Oseas dice: Llamaré al que no era mi pueblo, pueblo mío; y a la no amada, amada.", "words": [[0, 163963], [5, 164106], [13, 164426], [16, 164756], [22, 165086], [28, 165824], [36, 166292], [39, 166452], [43, 166612], [46, 166792], [50, 166972], [53, 167152], [61, 167712], [68, 168072], [73, 169097], [75, 169223], [77, 169303], [80, 169383], [83, 169603], [90, 170263]]}, {"verse": 26, "start": 171356, "end": 178785, "text": "Y será, que en el lugar donde les fue dicho: Vosotros no sois pueblo mío: allí serán llamados hijos del Dios viviente.", "words": [[0, 171356], [2, 171460], [8, 171660], [12, 171900], [15, 172060], [18, 172160], [24, 172400], [30, 172600], [34, 172820], [38, 173000], [45, 173793], [54, 174271], [57, 174471], [62, 174751], [69, 174971], [74, 176009], [79, 176333], [85, 176613], [94, 177153], [100, 177453], [104, 177793], [109, 178033]]}, {"verse": 27, "start": 179235, "end": 187024, "text": "También Isaías clama tocante a Israel: Aunque sea el número de los hijos de Israel como la arena del mar, el remanente será salvo:", "words": [[0, 179235], [8, 179536], [15, 180156], [21, 180636], [29, 180866], [31, 181096], [39, 182069], [46, 182271], [50, 182571], [53, 182731], [60, 182931], [63, 183171], [67, 183311], [73, 183531], [76, 183751], [83, 184071], [88, 184371], [91, 184551], [97, 184811], [101, 185031], [106, 185631], [109, 185711], [119, 186211], [124, 186471]]}, {"verse": 28, "start": 187474, "end": 194503, "text": "Porque el Señor cumplirá su palabra por completo y sin demora en justicia; porque ejecutará prontamente su palabra sobre la tierra.", "words": [[0, 187474], [7, 187702], [10, 187802], [16, 188042], [25, 188622], [28, 188742], [36, 189082], [40, 189322], [49, 189782], [51, 189982], [55, 190232], [62, 190482], [65, 190602], [75, 191660], [82, 191867], [92, 192407], [104, 192967], [107, 193147], [115, 193527], [121, 193787], [124, 193967]]}, {"verse": 29, "start": 194953, "end": 205360, "text": "Y como antes dijo Isaías: Si el Señor de los ejércitos no nos hubiera dejado descendencia, como Sodoma habríamos venido a ser, y a Gomorra fuéramos semejantes.", "words": [[0, 194953], [2, 195051], [7, 195251], [13, 195531], [18, 195851], [26, 196968], [29, 197107], [32, 197227], [38, 197507], [41, 197727], [45, 197867], [55, 198527], [58, 198787], [62, 198987], [70, 199327], [77, 199747], [91, 200567], [96, 201107], [103, 201647], [113, 202067], [120, 202427], [122, 202587], [127, 202827], [129, 203154], [131, 203480], [139, 203807], [148, 204427]]}, {"verse": 30, "start": 205810, "end": 214176, "text": "¿Pues qué diremos? Que los Gentiles que no seguían justicia, han alcanzado la justicia, es decir, la justicia que es por la fe;", "words": [[0, 205810], [6, 205949], [10, 206089], [19, 207011], [23, 207096], [27, 207236], [36, 207736], [40, 207956], [43, 208096], [51, 208496], [61, 209236], [65, 209816], [75, 210476], [78, 210616], [88, 211556], [91, 211656], [98, 212516], [101, 212616], [110, 213196], [114, 213356], [117, 213516], [121, 213696], [124, 213836]]}, {"verse": 31, "start": 214626, "end": 218999, "text": "Pero Israel que seguía la ley de justicia, no ha llegado a la ley de justicia.", "words": [[0, 214626], [5, 214774], [12, 215174], [16, 215374], [23, 215734], [26, 215854], [30, 216074], [33, 216174], [43, 217194], [46, 217314], [49, 217434], [57, 217814], [59, 217914], [62, 217974], [66, 218174], [69, 218294]]}, {"verse": 32, "start": 219449, "end": 226632, "text": "¿Por qué? Porque la seguían no por fe, sino como por las obras de la ley: por lo cual tropezaron en la piedra de tropiezo,", "words": [[0, 219449], [5, 219567], [10, 220237], [17, 220419], [20, 220579], [28, 221019], [31, 221199], [35, 221399], [39, 221879], [44, 222179], [49, 222399], [53, 222599], [57, 222779], [63, 223039], [66, 223239], [69, 223379], [74, 224007], [78, 224135], [81, 224255], [86, 224535], [97, 225235], [100, 225375], [103, 225475], [110, 225835], [113, 225935]]}, {"verse": 33, "start": 227082, "end": 236009, "text": "Como está escrito: He aquí pongo en Sion piedra de tropiezo, y piedra de caída; y aquel que cree en ella, no será avergonzado.", "words": [[0, 227082], [5, 227246], [10, 227446], [19, 228428], [22, 228518], [27, 228738], [33, 229018], [36, 229298], [41, 229578], [48, 230158], [51, 230258], [61, 230958], [63, 231238], [70, 231678], [73, 231798], [80, 232880], [82, 232999], [88, 233279], [92, 233399], [97, 233699], [100, 233899], [106, 234139], [109, 234519], [114, 234759]]}]}