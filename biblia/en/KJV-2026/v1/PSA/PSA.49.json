{"book": "PSA", "chapter": 49, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 120860, "verses": [{"verse": 1, "start": 300, "end": 4333, "text": "Hear this, all you people; give ear, all you inhabitants of the world:", "words": [[0, 300], [5, 439], [11, 679], [15, 939], [19, 1079], [27, 1874], [32, 2016], [37, 2756], [41, 2876], [45, 3016], [57, 3416], [60, 3736], [64, 3836]]}, {"verse": 2, "start": 4783, "end": 7882, "text": "Both low and high, rich and poor, together.", "words": [[0, 4783], [5, 4932], [9, 5292], [13, 5532], [19, 6292], [24, 6432], [28, 6632], [34, 7272]]}, {"verse": 3, "start": 8332, "end": 13739, "text": "My mouth shall speak of wisdom; and the meditation of my heart shall be of understanding.", "words": [[0, 8332], [3, 8697], [9, 9017], [15, 9277], [21, 9517], [24, 9717], [32, 10607], [36, 10732], [40, 10832], [51, 11412], [54, 11692], [57, 11892], [63, 12192], [69, 12492], [72, 12692], [75, 12852]]}, {"verse": 4, "start": 14189, "end": 19619, "text": "I will incline my ear to a parable: I will open my dark saying upon the harp.", "words": [[0, 14189], [2, 14468], [7, 14628], [15, 15108], [18, 15308], [22, 15548], [25, 15768], [27, 15908], [36, 16904], [38, 17204], [43, 17364], [48, 17684], [51, 17904], [56, 18224], [63, 18644], [68, 18964], [72, 19244]]}, {"verse": 5, "start": 20069, "end": 25652, "text": "Why should I fear in the days of evil, when the iniquity of my heels shall compass me about?", "words": [[0, 20069], [4, 20259], [11, 20479], [13, 20639], [18, 21019], [21, 21259], [25, 21359], [30, 21659], [33, 21819], [39, 22459], [44, 22759], [48, 22919], [57, 23419], [60, 23579], [63, 23759], [69, 24219], [75, 24499], [83, 24839], [86, 25099]]}, {"verse": 6, "start": 26102, "end": 30811, "text": "They that trust in their wealth, and boast themselves in the multitude of their riches;", "words": [[0, 26102], [5, 26290], [10, 26530], [16, 26870], [19, 27150], [25, 27310], [33, 27630], [37, 28130], [43, 28410], [54, 28970], [57, 29270], [61, 29350], [71, 29730], [74, 30010], [80, 30190]]}, {"verse": 7, "start": 31261, "end": 36701, "text": "None of them can by any means redeem his brother, nor give to God a ransom for him:", "words": [[0, 31261], [5, 31443], [8, 31643], [13, 31843], [17, 32063], [20, 32263], [24, 32543], [30, 32863], [37, 33263], [41, 33543], [50, 34363], [54, 34583], [59, 34903], [62, 35103], [66, 35363], [68, 35563], [75, 35923], [79, 36323]]}, {"verse": 8, "start": 37151, "end": 41307, "text": "(For the redemption of their soul is precious, and it ceases for ever:)", "words": [[0, 37151], [5, 37263], [9, 37383], [20, 37803], [23, 38103], [29, 38263], [34, 38663], [37, 39003], [47, 39463], [51, 39983], [54, 40123], [61, 40518], [65, 40913]]}, {"verse": 9, "start": 41757, "end": 45680, "text": "That he should still live for ever, and not see corruption.", "words": [[0, 41757], [5, 41890], [8, 42030], [15, 42250], [21, 42650], [26, 42990], [30, 43330], [36, 43670], [40, 44310], [44, 44550], [48, 44850]]}, {"verse": 10, "start": 46130, "end": 53518, "text": "For he sees that wise men die, likewise the fool and the brutish person perish, and leave their wealth to others.", "words": [[0, 46130], [4, 46241], [7, 46401], [12, 46681], [17, 46961], [22, 47341], [26, 47721], [31, 48461], [40, 48741], [44, 49201], [49, 49581], [53, 49881], [57, 50021], [65, 50421], [72, 50781], [80, 51741], [84, 51941], [90, 52161], [96, 52421], [103, 52701], [106, 52941]]}, {"verse": 11, "start": 53968, "end": 64182, "text": "Their inward thought is, that their houses shall continue for ever, and their dwelling places to all generations; they call their lands after their own names.", "words": [[0, 53968], [6, 54095], [13, 54435], [21, 54895], [25, 55255], [30, 55935], [36, 56115], [43, 56495], [49, 56835], [58, 57295], [62, 57755], [68, 58215], [72, 58535], [78, 58675], [87, 59015], [94, 59535], [97, 59875], [101, 60195], [114, 61609], [119, 61711], [124, 61971], [130, 62171], [136, 62551], [142, 62891], [148, 63111], [152, 63351]]}, {"verse": 12, "start": 64632, "end": 69920, "text": "Nevertheless man being in honour abides not: he is like the beasts that perish.", "words": [[0, 64632], [13, 65472], [17, 65772], [23, 66052], [26, 66312], [33, 66572], [40, 67152], [45, 67982], [48, 68104], [51, 68224], [56, 68424], [60, 68584], [67, 68944], [72, 69244]]}, {"verse": 13, "start": 70370, "end": 75935, "text": "This their way is their folly: yet their posterity approve their sayings. Selah.", "words": [[0, 70370], [5, 70617], [11, 70897], [15, 71177], [18, 71457], [24, 71657], [31, 72557], [35, 72703], [41, 72923], [51, 73473], [59, 74023], [65, 74283], [74, 75312]]}, {"verse": 14, "start": 76385, "end": 86310, "text": "Like sheep they are laid in the grave; death shall feed on them; and the upright shall have dominion over them in the morning; and their beauty shall consume in the grave from their dwelling.", "words": [[0, 76385], [5, 76529], [11, 76849], [16, 77149], [20, 77249], [25, 77489], [28, 77649], [32, 77749], [39, 78635], [45, 78800], [51, 79080], [56, 79340], [59, 79540], [65, 80242], [69, 80360], [73, 80460], [81, 80760], [87, 81100], [92, 81340], [101, 81840], [106, 82020], [111, 82220], [114, 82360], [118, 82440], [127, 83237], [131, 83364], [137, 83504], [144, 83824], [150, 84124], [158, 84624], [161, 84824], [165, 84924], [171, 85244], [176, 85544], [182, 85724]]}, {"verse": 15, "start": 86760, "end": 92640, "text": "But God will redeem my soul from the power of the grave: for he shall receive me. Selah.", "words": [[0, 86760], [4, 86883], [8, 87163], [13, 87383], [20, 87763], [23, 88003], [28, 88363], [33, 88643], [37, 88803], [43, 89083], [46, 89283], [50, 89383], [57, 90309], [61, 90426], [64, 90626], [70, 90846], [78, 91246], [82, 92316]]}, {"verse": 16, "start": 93090, "end": 97738, "text": "Be not you afraid when one is made rich, when the glory of his house is increased;", "words": [[0, 93090], [3, 93212], [7, 93452], [11, 93672], [18, 94032], [23, 94332], [27, 94532], [30, 94672], [35, 94892], [41, 95412], [46, 95552], [50, 95672], [56, 95972], [59, 96192], [63, 96332], [69, 96652], [72, 96812]]}, {"verse": 17, "start": 98188, "end": 103421, "text": "For when he dies he shall carry nothing away: his glory shall not descend after him.", "words": [[0, 98188], [4, 98428], [9, 98648], [12, 98768], [17, 99328], [20, 99408], [26, 99588], [32, 99868], [40, 100128], [46, 101052], [50, 101180], [56, 101620], [62, 101920], [66, 102160], [74, 102520], [80, 102980]]}, {"verse": 18, "start": 103871, "end": 109572, "text": "Though while he lived he blessed his soul: and men will praise you, when you do well to yourself.", "words": [[0, 103871], [7, 104118], [13, 104438], [16, 104658], [22, 105098], [25, 105158], [33, 105438], [37, 105718], [43, 106549], [47, 106670], [51, 106890], [56, 107150], [63, 107510], [68, 107850], [73, 108190], [77, 108350], [80, 108510], [85, 108770], [88, 108970]]}, {"verse": 19, "start": 110022, "end": 114199, "text": "He shall go to the generation of his fathers; they shall never see light.", "words": [[0, 110022], [3, 110116], [9, 110296], [12, 110496], [15, 110656], [19, 110796], [30, 111336], [33, 111556], [37, 111676], [46, 112745], [51, 112872], [57, 113032], [63, 113352], [67, 113652]]}, {"verse": 20, "start": 114649, "end": 120460, "text": "Man that is in honour, and understands not, is like the beasts that perish.", "words": [[0, 114649], [4, 114936], [9, 115196], [12, 115376], [15, 115636], [23, 115896], [27, 116296], [39, 116856], [44, 117396], [47, 117896], [52, 118096], [56, 118256], [63, 118616], [68, 118896]]}]}