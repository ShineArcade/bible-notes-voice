{"book": "LUK", "chapter": 18, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 293525, "verses": [{"verse": 1, "start": 300, "end": 6278, "text": "And he spoke a parable to them to this end, that men ought always to pray, and not to faint;", "words": [[0, 300], [4, 409], [7, 509], [13, 789], [15, 1009], [23, 1409], [26, 1629], [31, 1829], [34, 2029], [39, 2249], [44, 2909], [49, 3189], [53, 3449], [59, 3689], [66, 4129], [69, 4369], [75, 4749], [79, 5269], [83, 5509], [86, 5729]]}, {"verse": 2, "start": 6728, "end": 12455, "text": "Saying, There was in a city a judge, which feared not God, neither regarded man:", "words": [[0, 7160], [8, 7883], [14, 8005], [18, 8185], [21, 8365], [23, 8485], [28, 8685], [30, 8845], [37, 9225], [43, 9765], [50, 10085], [54, 10345], [59, 11225], [67, 11425], [76, 11885]]}, {"verse": 3, "start": 12805, "end": 21129, "text": "And there was a widow in that city; and she came to him, saying, Avenge me of my adversary.", "words": [[0, 12805], [4, 12958], [10, 13058], [14, 13258], [16, 13378], [22, 13598], [25, 13858], [30, 14038], [36, 14805], [40, 14928], [44, 15088], [49, 15388], [52, 15608], [57, 15808], [65, 17006], [72, 17544], [75, 17704], [78, 17884], [81, 18044]]}, {"verse": 4, "start": 21479, "end": 29717, "text": "And he would not for a while: but afterward he said within himself, Though I fear not God, nor regard man;", "words": [[0, 21479], [4, 21623], [7, 21703], [13, 21863], [17, 22123], [21, 22383], [23, 22523], [30, 23359], [34, 23482], [44, 24101], [47, 24222], [52, 24482], [59, 24761], [68, 27123], [75, 27297], [77, 27437], [82, 27697], [86, 27897], [91, 28497], [95, 28597], [102, 28977]]}, {"verse": 5, "start": 30167, "end": 35562, "text": "Yet because this widow troubles me, I will avenge her, lest by her continual coming she weary me.", "words": [[0, 30167], [4, 30270], [12, 30590], [17, 30850], [23, 31050], [32, 31470], [36, 32090], [38, 32190], [43, 32330], [50, 32790], [55, 33190], [60, 33390], [63, 33570], [67, 33710], [77, 34330], [84, 34670], [88, 34950], [94, 35230]]}, {"verse": 6, "start": 35912, "end": 39967, "text": "And the Lord said, Hear what the unjust judge says.", "words": [[0, 35912], [4, 36041], [8, 36161], [13, 36361], [19, 37702], [24, 37937], [29, 38177], [33, 38337], [40, 38737], [46, 39217]]}, {"verse": 7, "start": 40417, "end": 46313, "text": "And shall not God avenge his own elect, which cry day and night to him, though he bear long with them?", "words": [[0, 40417], [4, 40537], [10, 40757], [14, 41037], [18, 41377], [25, 41857], [29, 41997], [33, 42217], [40, 42917], [46, 43177], [50, 43437], [54, 43737], [58, 43897], [64, 44117], [67, 44317], [72, 44757], [79, 44957], [82, 45117], [87, 45317], [92, 45657], [97, 45937]]}, {"verse": 8, "start": 46763, "end": 52819, "text": "I tell you that he will avenge them speedily. Nevertheless when the Son of man comes, shall he find faith on the earth?", "words": [[0, 46763], [2, 46887], [7, 47087], [11, 47267], [16, 47427], [19, 47567], [24, 47687], [31, 48127], [36, 48247], [46, 49180], [59, 49787], [64, 49927], [68, 50047], [72, 50287], [75, 50407], [79, 50647], [86, 51107], [92, 51427], [95, 51587], [100, 51907], [106, 52207], [109, 52427], [113, 52547]]}, {"verse": 9, "start": 53169, "end": 59766, "text": "And he spoke this parable to certain which trusted in themselves that they were righteous, and despised others:", "words": [[0, 53169], [4, 53294], [7, 53394], [13, 53714], [18, 54014], [26, 54534], [29, 54734], [37, 55054], [43, 55334], [51, 55934], [54, 56154], [65, 56594], [70, 56974], [75, 57174], [80, 57354], [91, 57834], [95, 58534], [104, 59134]]}, {"verse": 10, "start": 60016, "end": 65989, "text": "Two men went up into the temple to pray; the one a Pharisee, and the other a tax collector.", "words": [[0, 60016], [4, 60154], [8, 60474], [13, 60714], [16, 61014], [21, 61174], [25, 61354], [32, 61674], [35, 61854], [41, 62658], [45, 62738], [49, 63045], [51, 63351], [61, 63658], [65, 64218], [69, 64398], [75, 64658], [77, 64998], [81, 65318]]}, {"verse": 11, "start": 66339, "end": 76409, "text": "The Pharisee stood and prayed thus with himself, God, I thank you, that I am not as other men are, extortioners, unjust, adulterers, or even as this tax collector.", "words": [[0, 66339], [4, 66432], [13, 66972], [19, 67192], [23, 67392], [30, 67662], [35, 67932], [40, 68192], [49, 69077], [54, 69257], [56, 69437], [62, 69697], [67, 69917], [72, 70257], [74, 70437], [77, 70537], [81, 70737], [84, 70877], [90, 71057], [94, 71217], [99, 71457], [113, 72957], [121, 73917], [133, 74597], [136, 74957], [141, 75157], [144, 75337], [149, 75517], [153, 75777]]}, {"verse": 12, "start": 76859, "end": 80855, "text": "I fast twice in the week, I give tithes of all that I possess.", "words": [[0, 76859], [2, 76959], [7, 77179], [13, 77499], [16, 77759], [20, 77859], [26, 78579], [28, 78679], [33, 79049], [40, 79419], [43, 79599], [47, 79879], [52, 80059], [54, 80159]]}, {"verse": 13, "start": 81205, "end": 91559, "text": "And the tax collector, standing afar off, would not lift up so much as his eyes to heaven, but struck upon his breast, saying, God be merciful to me a sinner.", "words": [[0, 81205], [4, 81337], [8, 81457], [12, 81757], [23, 82257], [32, 82757], [37, 83157], [42, 83537], [48, 83737], [52, 83957], [57, 84217], [60, 84437], [63, 84637], [68, 84917], [71, 85057], [75, 85197], [80, 85577], [83, 85817], [91, 86577], [95, 86717], [102, 87037], [107, 87397], [111, 87617], [119, 88277], [127, 89688], [131, 89887], [134, 90107], [143, 90527], [146, 90827], [149, 91007], [151, 91147]]}, {"verse": 14, "start": 91859, "end": 101597, "text": "I tell you, this man went down to his house justified rather than the other: for every one that exalts himself shall be abased; and he that humbles himself shall be exalted.", "words": [[0, 91859], [2, 91998], [7, 92218], [12, 92378], [17, 92578], [21, 92858], [26, 93058], [31, 93338], [34, 93538], [38, 93698], [44, 93938], [54, 94558], [61, 94958], [66, 95258], [70, 95418], [77, 96091], [81, 96211], [87, 96365], [91, 96518], [96, 96858], [103, 97278], [111, 97678], [117, 97998], [120, 98178], [128, 99122], [132, 99244], [135, 99464], [140, 99684], [148, 100084], [156, 100444], [162, 100724], [165, 100884]]}, {"verse": 15, "start": 101947, "end": 108631, "text": "And they brought to him also infants, that he would touch them: but when his disciples saw it, they rebuked them.", "words": [[0, 101947], [4, 102077], [9, 102177], [17, 102457], [20, 102717], [24, 102917], [29, 103257], [38, 103817], [43, 104417], [46, 104537], [52, 104697], [58, 105037], [64, 105806], [68, 105916], [73, 106096], [77, 106256], [87, 106736], [91, 107156], [95, 107576], [100, 107676], [108, 108236]]}, {"verse": 16, "start": 109081, "end": 117665, "text": "But Jesus called them to him, and said, Let the little children come to me, and forbid them not: for of such is the kingdom of God.", "words": [[0, 109081], [4, 109229], [10, 109549], [17, 109989], [22, 110229], [25, 110429], [30, 110689], [34, 110889], [40, 111648], [44, 111845], [48, 112085], [55, 112305], [64, 112765], [69, 113085], [72, 113305], [76, 113785], [80, 114005], [87, 114325], [92, 114605], [97, 115460], [101, 115583], [104, 115823], [109, 116083], [112, 116463], [116, 116623], [124, 116923], [127, 117163]]}, {"verse": 17, "start": 118115, "end": 124457, "text": "Assuredly I say to you, Whoever shall not receive the kingdom of God as a little child shall by no means enter in it.", "words": [[0, 118115], [10, 118695], [12, 118815], [16, 119055], [19, 119235], [24, 119835], [32, 120155], [38, 120475], [42, 120675], [50, 121035], [54, 121195], [62, 121435], [65, 121655], [69, 121935], [72, 122175], [74, 122295], [81, 122455], [87, 122855], [93, 123115], [96, 123295], [99, 123495], [105, 123815], [111, 124135], [114, 124315]]}, {"verse": 18, "start": 124807, "end": 130555, "text": "And a certain ruler asked him, saying, Good Master, what shall I do to inherit eternal life?", "words": [[0, 124807], [4, 124962], [6, 125062], [14, 125302], [20, 125642], [26, 126062], [31, 126262], [39, 127606], [44, 127727], [52, 128307], [57, 128407], [63, 128667], [65, 128827], [68, 129067], [71, 129267], [79, 129607], [87, 130067]]}, {"verse": 19, "start": 130905, "end": 137225, "text": "And Jesus said to him, Why do you call me good? none is good, save one, that is, God.", "words": [[0, 130905], [4, 131056], [10, 131356], [15, 131756], [18, 131956], [23, 132508], [27, 132745], [30, 132885], [34, 132985], [39, 133205], [42, 133345], [48, 134186], [53, 134425], [56, 134605], [62, 135045], [67, 135225], [72, 136025], [77, 136125], [81, 136445]]}, {"verse": 20, "start": 137675, "end": 144741, "text": "You know the commandments, Do not commit adultery, Do not kill, Do not steal, Do not bear false witness, Honour your father and your mother.", "words": [[0, 137675], [4, 137812], [9, 137952], [13, 138072], [27, 138992], [30, 139072], [34, 139232], [41, 139452], [51, 140232], [54, 140292], [58, 140472], [64, 141112], [67, 141172], [71, 141332], [78, 142032], [81, 142072], [85, 142232], [90, 142452], [96, 142732], [105, 143142], [112, 143552], [117, 143732], [124, 144012], [128, 144232], [133, 144352]]}, {"verse": 21, "start": 145091, "end": 148932, "text": "And he said, All these have I kept from my youth up.", "words": [[0, 145091], [4, 145226], [7, 145366], [13, 146824], [17, 147075], [23, 147295], [28, 147555], [30, 147695], [35, 147935], [40, 148175], [43, 148355], [49, 148535]]}, {"verse": 22, "start": 149282, "end": 160850, "text": "Now when Jesus heard these things, he said to him, Yet do you lack one thing: sell all that you have, and distribute to the poor, and you shall have treasure in heaven: and come, follow me.", "words": [[0, 149282], [4, 149535], [9, 149635], [15, 149915], [21, 150295], [27, 150515], [35, 151395], [38, 151535], [43, 151765], [46, 151995], [51, 152623], [55, 152814], [58, 153034], [62, 153214], [67, 153494], [71, 153734], [78, 154529], [83, 154768], [87, 155088], [92, 155268], [96, 155408], [102, 155708], [106, 156088], [117, 156488], [120, 156788], [124, 156888], [130, 157468], [134, 157708], [138, 157848], [144, 158028], [149, 158228], [158, 158568], [161, 158828], [169, 159574], [173, 159715], [179, 160275], [186, 160535]]}, {"verse": 23, "start": 161200, "end": 165633, "text": "And when he heard this, he was very sorrowful: for he was very rich.", "words": [[0, 161200], [4, 161341], [9, 161501], [12, 161661], [18, 161921], [24, 162481], [27, 162621], [31, 162801], [36, 163081], [47, 164233], [51, 164356], [54, 164476], [58, 164656], [63, 164956]]}, {"verse": 24, "start": 166083, "end": 173531, "text": "And when Jesus saw that he was very sorrowful, he said, How hardly shall they that have riches enter into the kingdom of God!", "words": [[0, 166083], [4, 166228], [9, 166368], [15, 166648], [19, 167068], [24, 167268], [27, 167368], [31, 167528], [36, 167788], [47, 168568], [50, 168668], [56, 169493], [60, 169693], [67, 170113], [73, 170433], [78, 170633], [83, 170853], [88, 171073], [95, 171453], [101, 171833], [106, 172153], [110, 172333], [118, 172693], [121, 172953]]}, {"verse": 25, "start": 173981, "end": 180206, "text": "For it is easier for a camel to go through a needle’s eye, than for a rich man to enter into the kingdom of God.", "words": [[0, 173981], [4, 174132], [7, 174292], [10, 174432], [17, 174892], [21, 175152], [23, 175292], [29, 175592], [32, 175812], [35, 175972], [43, 176172], [45, 176292], [54, 176712], [59, 176992], [64, 177452], [68, 177672], [70, 177792], [75, 178012], [79, 178332], [82, 178572], [88, 178852], [93, 179112], [97, 179272], [105, 179532], [108, 179752]]}, {"verse": 26, "start": 180556, "end": 183473, "text": "And they that heard it said, Who then can be saved?", "words": [[0, 180556], [4, 180704], [9, 180884], [14, 181124], [20, 181344], [23, 181524], [29, 182227], [33, 182365], [38, 182525], [42, 182745], [45, 182885]]}, {"verse": 27, "start": 183823, "end": 189102, "text": "And he said, The things which are impossible with men are possible with God.", "words": [[0, 183823], [4, 183957], [7, 184097], [13, 185556], [17, 185654], [24, 185914], [30, 186114], [34, 186294], [45, 186774], [50, 187114], [54, 187414], [58, 187894], [67, 188294], [72, 188574]]}, {"verse": 28, "start": 189452, "end": 193260, "text": "Then Peter said, Lo, we have left all, and followed you.", "words": [[0, 189452], [5, 189691], [11, 189991], [17, 191426], [21, 191506], [24, 191646], [29, 191786], [34, 191986], [39, 192306], [43, 192526], [52, 192846]]}, {"verse": 29, "start": 193610, "end": 202981, "text": "And he said to them, Assuredly I say to you, There is no man that has left house, or parents, or brethren, or wife, or children, for the kingdom of God’s sake,", "words": [[0, 193610], [4, 193740], [7, 193860], [12, 194100], [15, 194300], [21, 194896], [31, 195481], [33, 195621], [37, 195821], [40, 196001], [45, 196501], [51, 196741], [54, 196881], [57, 197101], [61, 197401], [66, 197601], [70, 197721], [75, 197921], [82, 198281], [85, 198681], [94, 199121], [97, 199441], [107, 199781], [110, 200141], [116, 200461], [119, 200721], [129, 201121], [133, 201561], [137, 201661], [145, 201941], [148, 202161], [154, 202621]]}, {"verse": 30, "start": 203431, "end": 209384, "text": "Who shall not receive manifold more in this present time, and in the world to come life everlasting.", "words": [[0, 203431], [4, 203530], [10, 203710], [14, 203950], [22, 204370], [31, 204810], [36, 205370], [39, 205650], [44, 205810], [52, 206130], [58, 206830], [62, 207210], [65, 207350], [69, 207450], [75, 207730], [78, 207890], [83, 208090], [88, 208390]]}, {"verse": 31, "start": 209734, "end": 219714, "text": "¶ Then he took to him the twelve, and said to them, Behold, we go up to Jerusalem, and all things that are written by the prophets concerning the Son of man shall be accomplished.", "words": [[2, 209734], [7, 209991], [10, 210231], [15, 210471], [18, 210671], [22, 210851], [26, 211011], [34, 212031], [38, 212131], [43, 212411], [46, 212651], [52, 213295], [60, 213757], [63, 213817], [66, 213997], [69, 214177], [72, 214317], [83, 215137], [87, 215537], [91, 215737], [98, 215997], [103, 216197], [107, 216297], [115, 216517], [118, 216717], [122, 216837], [131, 217177], [142, 217657], [146, 217877], [150, 218077], [153, 218177], [157, 218497], [163, 218857], [166, 218997]]}, {"verse": 32, "start": 220164, "end": 225694, "text": "For he shall be delivered to the Gentiles, and shall be mocked, and spitefully entreated, and spitted on:", "words": [[0, 220164], [4, 220286], [7, 220486], [13, 220686], [16, 220846], [26, 221226], [29, 221446], [33, 221546], [43, 222186], [47, 222586], [53, 222786], [56, 222946], [64, 223446], [68, 223626], [79, 224146], [90, 224626], [94, 224966], [102, 225306]]}, {"verse": 33, "start": 226144, "end": 230721, "text": "And they shall scourge him, and put him to death: and the third day he shall rise again.", "words": [[0, 226144], [4, 226270], [9, 226410], [15, 226590], [23, 227050], [28, 227190], [32, 227510], [36, 227690], [40, 227810], [43, 227950], [50, 228707], [54, 228804], [58, 228924], [64, 229184], [68, 229484], [71, 229664], [77, 229844], [82, 230144]]}, {"verse": 34, "start": 231071, "end": 237590, "text": "And they understood none of these things: and this saying was hid from them, neither knew they the things which were spoken.", "words": [[0, 231071], [4, 231202], [9, 231342], [20, 231722], [25, 232062], [28, 232242], [34, 232382], [42, 233245], [46, 233407], [51, 233627], [58, 233967], [62, 234227], [66, 234467], [71, 234707], [77, 235207], [85, 235527], [90, 235867], [95, 236107], [99, 236307], [106, 236587], [112, 236827], [117, 236987]]}, {"verse": 35, "start": 238040, "end": 245313, "text": "¶ And it came to pass, that as he was come near to Jericho, a certain blind man sat by the way side begging:", "words": [[2, 238040], [6, 238176], [9, 238296], [14, 238516], [17, 238736], [23, 239076], [28, 239696], [31, 239956], [34, 240116], [38, 240316], [43, 240556], [48, 240896], [51, 241116], [60, 242196], [62, 242296], [70, 242596], [76, 243016], [80, 243436], [84, 243756], [87, 244056], [91, 244296], [95, 244536], [100, 244776]]}, {"verse": 36, "start": 245763, "end": 249299, "text": "And hearing the multitude pass by, he asked what it meant.", "words": [[0, 245763], [4, 245889], [12, 246149], [16, 246349], [26, 246829], [31, 247249], [35, 248029], [38, 248149], [44, 248469], [49, 248689], [52, 248809]]}, {"verse": 37, "start": 249749, "end": 253065, "text": "And they told him, that Jesus of Nazareth passes by.", "words": [[0, 249749], [4, 249872], [9, 249952], [14, 250192], [19, 250432], [24, 250952], [30, 251332], [33, 251612], [42, 252072], [49, 252452]]}, {"verse": 38, "start": 253515, "end": 257426, "text": "And he cried, saying, Jesus, you Son of David, have mercy on me.", "words": [[0, 253515], [4, 253619], [7, 253719], [14, 253979], [22, 254887], [29, 255568], [33, 255648], [37, 255908], [40, 256008], [47, 256568], [52, 256668], [58, 256988], [61, 257188]]}, {"verse": 39, "start": 257776, "end": 266363, "text": "And they which went before rebuked him, that he should keep silent: but he cried so much the more, You Son of David, have mercy on me.", "words": [[0, 257776], [4, 257928], [9, 258108], [15, 258388], [20, 258608], [27, 258968], [35, 259548], [40, 260048], [45, 260228], [48, 260348], [55, 260528], [60, 260728], [68, 261757], [72, 261860], [75, 261980], [81, 262300], [84, 262600], [89, 262880], [93, 263040], [99, 264375], [103, 264476], [107, 264756], [110, 264876], [117, 265456], [122, 265536], [128, 265916], [131, 266136]]}, {"verse": 40, "start": 266713, "end": 272316, "text": "And Jesus stood, and commanded him to be brought to him: and when he was come near, he asked him,", "words": [[0, 266713], [4, 266857], [10, 267197], [17, 267637], [21, 267877], [31, 268297], [35, 268597], [38, 268757], [41, 268877], [49, 269117], [52, 269357], [57, 269918], [61, 270027], [66, 270167], [69, 270267], [73, 270387], [78, 270587], [84, 271007], [87, 271107], [93, 271407]]}, {"verse": 41, "start": 272766, "end": 279467, "text": "Saying, What will you that I shall do to you? And he said, Lord, that I may receive my sight.", "words": [[0, 272898], [8, 273323], [13, 273488], [18, 273728], [22, 274008], [27, 274248], [29, 274448], [35, 274648], [38, 274888], [41, 275048], [46, 275803], [50, 275938], [53, 276078], [59, 277537], [65, 277821], [70, 278121], [72, 278261], [76, 278421], [84, 278781], [87, 278961]]}, {"verse": 42, "start": 279817, "end": 284431, "text": "And Jesus said to him, Receive your sight: your faith has saved you.", "words": [[0, 279817], [4, 279968], [10, 280268], [15, 280668], [18, 280868], [23, 281419], [31, 281785], [36, 282285], [43, 283024], [48, 283167], [54, 283467], [58, 283747], [64, 284067]]}, {"verse": 43, "start": 284781, "end": 293125, "text": "And immediately he received his sight, and followed him, glorifying God: and all the people, when they saw it, gave praise to God.", "words": [[0, 284781], [4, 284927], [16, 285307], [19, 285747], [28, 286227], [32, 286447], [39, 286787], [43, 287247], [52, 287587], [57, 288167], [68, 288927], [73, 289841], [77, 289986], [81, 290186], [85, 290326], [93, 290826], [98, 291006], [103, 291186], [107, 291446], [111, 291786], [116, 291946], [123, 292386], [126, 292646]]}]}