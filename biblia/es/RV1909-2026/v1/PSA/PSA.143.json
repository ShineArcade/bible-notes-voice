{"book": "PSA", "chapter": 143, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 89355, "verses": [{"verse": 1, "start": 300, "end": 7823, "text": "Salmo de David. OH Jehová, oye mi oración, escucha mis ruegos: respóndeme por tu verdad, por tu justicia.", "words": [[0, 300], [6, 802], [9, 982], [16, 1902], [19, 2022], [27, 2642], [31, 2962], [34, 3102], [43, 3722], [51, 4162], [55, 4262], [63, 5271], [74, 5867], [78, 6087], [81, 6207], [89, 6727], [93, 6787], [96, 6947]]}, {"verse": 2, "start": 8173, "end": 14388, "text": "Y no entres en juicio con tu siervo; porque no se justificará delante de ti ningún viviente.", "words": [[0, 8173], [2, 8298], [5, 8638], [12, 8978], [15, 9098], [22, 9518], [26, 9738], [29, 9898], [37, 10757], [44, 10981], [47, 11221], [50, 11401], [62, 12281], [70, 12781], [73, 12961], [76, 13161], [83, 13481]]}, {"verse": 3, "start": 14738, "end": 23740, "text": "Porque ha perseguido el enemigo mi alma; ha postrado en tierra mi vida; me ha hecho habitar en tinieblas como los ya muertos.", "words": [[0, 14738], [7, 15002], [10, 15302], [21, 16042], [24, 16182], [32, 16662], [35, 16862], [41, 17718], [44, 18333], [53, 18963], [56, 19183], [63, 19523], [66, 19823], [72, 20627], [75, 20773], [78, 20913], [84, 21073], [92, 21493], [95, 21693], [105, 22353], [110, 22553], [114, 22713], [117, 22893]]}, {"verse": 4, "start": 24090, "end": 28349, "text": "Y mi espíritu se angustió dentro de mí; se pasmó mi corazón.", "words": [[0, 24090], [2, 24206], [5, 24326], [14, 24926], [17, 25046], [26, 25626], [33, 25826], [36, 26126], [40, 26641], [43, 26786], [49, 27366], [52, 27506]]}, {"verse": 5, "start": 28699, "end": 35544, "text": "Me acordé de los días antiguos; meditaba en todas tus obras; reflexionaba en las obras de tus manos.", "words": [[0, 28699], [3, 28806], [10, 29246], [13, 29366], [17, 29506], [22, 29706], [32, 30789], [41, 31355], [44, 31535], [50, 31715], [54, 31955], [61, 33302], [74, 33742], [77, 33922],