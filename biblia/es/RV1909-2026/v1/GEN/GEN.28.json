{"book": "GEN", "chapter": 28, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 205543, "verses": [{"verse": 1, "start": 300, "end": 8680, "text": "Entonces Isaac llamó a Jacob, y lo bendijo, y le mandó diciendo: No tomes mujer de las hijas de Canaán.", "words": [[0, 300], [9, 804], [15, 1424], [21, 2364], [23, 2424], [30, 2824], [32, 3524], [35, 3664], [44, 4284], [46, 4764], [49, 4904], [55, 5344], [65, 6427], [68, 6571], [74, 6951], [80, 7211], [83, 7411], [87, 7591], [93, 7951], [96, 8071]]}, {"verse": 2, "start": 9130, "end": 16519, "text": "Levántate, ve a Padan-aram, a casa de Betuel, padre de tu madre, y toma allí mujer de las hijas de Labán, hermano de tu madre.", "words": [[0, 9130], [11, 9729], [14, 9929], [16, 10449], [28, 10969], [30, 11049], [35, 11249], [38, 11429], [46, 12009], [52, 12209], [55, 12409], [58, 12509], [65, 13229], [67, 13309], [72, 13529], [77, 13809], [83, 14089], [86, 14289], [90, 14449], [96, 14789], [99, 14909], [106, 15449], [114, 15829], [117, 15909], [120, 16029]]}, {"verse": 3, "start": 16969, "end": 24356, "text": "Y el Dios omnipotente te bendiga, y te haga fructificar, y te multiplique, hasta venir a ser congregación de pueblos;", "words": [[0, 16969], [2, 17088], [5, 17228], [10, 17448], [22, 18268], [25, 18488], [34, 19068], [36, 19488], [39, 19608], [44, 19828], [57, 20548], [59, 20968], [62, 21088], [75, 21868], [81, 22308], [87, 22568], [89, 22748], [93, 22908], [106, 23588], [109, 23748]]}, {"verse": 4, "start": 24806, "end": 32060, "text": "Y te dé la bendición de Abraham, y a tu descendencia contigo, para que heredes la tierra en que moras, que Dios dio a Abraham.", "words": [[0, 24806], [2, 24912], [5, 25012], [8, 25152], [11, 25272], [21, 25832], [24, 26012], [33, 26452], [35, 26932], [37, 27012], [40, 27112], [53, 27832], [62, 28472], [67, 28872], [71, 29052], [79, 29392], [82, 29512], [89, 29812], [92, 29992], [96, 30072], [103, 30732], [107, 30852], [112, 31012], [116, 31172], [118, 31332]]}, {"verse": 5, "start": 32410, "end": 42799, "text": "Así envió Isaac a Jacob, el cual fue a Padan-aram, a Labán, hijo de Betuel arameo, hermano de Rebeca, madre de Jacob y de Esaú.", "words": [[0, 32410], [4, 32753], [10, 33213], [16, 33493], [18, 33833], [25, 34833], [28, 34953], [33, 35153], [37, 35493], [39, 36128], [51, 36763], [53, 37398], [60, 38033], [65, 38233], [68, 38413], [75, 38733], [83, 39793], [91, 40333], [94, 40413], [102, 41033], [108, 41253], [111, 41453], [117, 41833], [119, 42113], [122, 42489]]}, {"verse": 6, "start": 43249, "end": 59175, "text": "Y vio Esaú cómo Isaac había bendecido a Jacob, y le había enviado a Padan-aram, para tomar para sí mujer de allí; y que cuando le bendijo, le había mandado, diciendo: No tomarás mujer de las hijas de Canaán;", "words": [[0, 43249], [2, 43399], [6, 43829], [11, 44259], [16, 44299], [22, 44719], [28, 45179], [38, 45859], [40, 45979], [47, 46319], [49, 47079], [52, 47219], [58, 47399], [66, 47799], [68, 48349], [80, 48899], [85, 49599], [91, 49939], [96, 50219], [99, 50439], [105, 50699], [108, 50979], [114, 51734], [116, 51931], [120, 52071], [127, 52331], [130, 52571], [139, 53291], [142, 53871], [148, 54091], [157, 54871], [167, 56647], [170, 56921], [178, 57231], [184, 57551], [187, 57811], [191, 57991], [197, 58371], [200, 58471]]}, {"verse": 7, "start": 59625, "end": 66025, "text": "Y que Jacob había obedecido a su padre y a su madre, y se había ido a Padan-aram.", "words": [[0, 59625], [2, 59731], [6, 59831], [12, 60291], [18, 61151], [28, 62071], [30, 62191], [33, 62311], [39, 62711], [41, 62911], [43, 62951], [46, 63111], [53, 63511], [55, 64011], [58, 64191], [64, 64471], [68, 64871], [70, 65460]]}, {"verse": 8, "start": 66475, "end": 72680, "text": "vio asimismo Esaú que las hijas de Canaán parecían mal a Isaac su padre;", "words": [[0, 66475], [4, 66874], [13, 67308], [18, 67741], [22, 67921], [26, 68141], [32, 68661], [35, 69071], [42, 69481], [51, 70501], [55, 70941], [57, 