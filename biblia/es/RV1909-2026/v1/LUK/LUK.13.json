{"book": "LUK", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 308823, "verses": [{"verse": 1, "start": 300, "end": 9467, "text": "Y en este mismo tiempo estaban allí unos que le contaban acerca de los galileos, cuya sangre Pilato había mezclado con sus sacrificios.", "words": [[0, 300], [2, 442], [5, 542], [10, 742], [16, 1022], [23, 1422], [31, 1802], [36, 2162], [41, 2622], [45, 2982], [48, 3102], [57, 3662], [64, 3982], [67, 4282], [71, 4422], [81, 5142], [86, 5802], [93, 6142], [100, 6762], [106, 7123], [115, 8003], [119, 8222], [123, 8423]]}, {"verse": 2, "start": 9817, "end": 19734, "text": "Y respondiendo Jesús, les dijo: ¿Pensáis que estos galileos, porque han padecido tales cosas, hayan sido más pecadores que todos los galileos?", "words": [[0, 9817], [2, 10120], [15, 10820], [22, 11240], [26, 11780], [32, 12624], [41, 13006], [45, 13206], [51, 13386], [61, 14486], [68, 14826], [72, 15066], [81, 15606], [87, 15886], [94, 16946], [100, 17226], [105, 17486], [109, 17686], [119, 18166], [123, 18366], [129, 18626], [133, 18806]]}, {"verse": 3, "start": 20084, "end": 25509, "text": "No, os digo; sino que si no os arrepentís, todos pereceréis igualmente.", "words": [[0, 20144], [4, 20238], [7, 20331], [13, 21215], [18, 21611], [22, 21811], [25, 22011], [28, 22231], [31, 22431], [43, 23531], [49, 23751], [60, 24571]]}, {"verse": 4, "start": 25859, "end": 36280, "text": "O aquellos dieciocho, sobre los cuales cayó la torre en Siloé, y los mató, ¿pensáis que ellos fueron más culpables que todos los hombres que habitan en Jerusalén?", "words": [[0, 25859], [2, 25967], [11, 26437], [22, 26907], [28, 27387], [32, 27587], [39, 27867], [44, 28387], [47, 28507], [53, 28927], [56, 29147], [63, 29727], [65, 30347], [69, 30487], [75, 31287], [84, 31827], [88, 32087], [94, 32287], [101, 32587], [105, 32887], [115, 33607], [119, 33767], [125, 34047], [129, 34287], [137, 34627], [141, 34827], [149, 35267], [152, 35367]]}, {"verse": 5, "start": 36630, "end": 41953, "text": "No, os digo; sino que si no os arrepentís, todos pereceréis asimismo.", "words": [[0, 36690], [4, 36784], [7, 36877], [13, 37760], [18, 37983], [22, 38163], [25, 38343], [28, 38523], [31, 38703], [43, 39923], [49, 40363], [60, 41196]]}, {"verse": 6, "start": 42303, "end": 49709, "text": "Y dijo esta parábola: Tenía uno una higuera plantada en su viña, y vino a buscar fruto en ella, y no lo halló.", "words": [[0, 42303], [2, 42431], [7, 42671], [12, 42871], [22, 44001], [28, 44181], [32, 44501], [36, 44881], [44, 45401], [53, 45941], [56, 46061], [59, 46221], [65, 46701], [67, 47281], [72, 47481], [74, 47641], [81, 47841], [87, 48321], [90, 48481], [96, 48721], [98, 49001], [101, 49161], [104, 49465]]}, {"verse": 7, "start": 50059, "end": 60256, "text": "Y dijo al encargado de la viña: He aquí hace tres años que vengo a buscar fruto en esta higuera, y no lo hallo; córtala, ¿por qué ocupará aún la tierra?", "words": [[0, 50059], [2, 50266], [7, 50506], [10, 50646], [20, 51266], [23, 51426], [26, 51546], [32, 52509], [35, 52689], [40, 52989], [45, 53409], [50, 53749], [55, 54169], [59, 54429], [65, 54729], [67, 54789], [74, 55029], [80, 55649], [83, 55809], [88, 56029], [97, 56509], [99, 56649], [102, 56809], [105, 57009], [112, 57701], [121, 58066], [126, 58306], [130, 58466], [138, 59046], [142, 59386], [145, 59586]]}, {"verse": 8, "start": 60606, "end": 69690, "text": "Él entonces respondiendo, le dijo: Señor, déjala aún este año, hasta que cave a su alrededor y la abone con estiércol.", "words": [[0, 60606], [3, 60870], [12, 61570], [26, 62635], [29, 62795], [35, 63547], [42, 64334], [49, 64754], [53, 65134], [58, 65454], [63, 66214], [69, 66454], [73, 66754], [78, 67054], [80, 67254], [83, 67414], [93, 67834], [95, 68174], [98, 68314], [104, 68734], [108, 68934]]}, {"verse": 9, "start": 70040, "end": 74389, "text": "Y si da fruto, bien; y si no, la cortarás después.", "words": [[0, 70040], [2, 70142], [5, 70282], [8, 70462], [15, 71202], [21, 72010], [23, 72139], [26, 72259], [30, 72779], [33, 73079], [42, 73699]]}, {"verse": 10, "start": 74739, "end": 77338, "text": "Y enseñaba en una sinagoga en sábado.", "words": [[0, 74739], [2, 74862], [11, 75482], [14, 75642], [18, 75802], [27, 76462], [30, 76642]]}, {"verse": 11, "start": 77688, "end": 87031, "text": "Y he aquí una mujer que tenía espíritu de enfermedad dieciocho años, y andaba encorvada, que en ninguna manera se podía enderezar.", "words": [[0, 77688], [2, 77912], [5, 78192], [10, 78452], [14, 78692], [20, 78992], [24, 79252], [30, 79592], [39, 80412], [42, 80532], [53, 81162], [63, 81792], [69, 82492], [71, 82807], [78, 83287], [89, 84447], [93, 84567], [96, 84687], [104, 85127], [111, 85507], [114, 85747], [120, 86087]]}, {"verse": 12, "start": 87381, "end": 93972, "text": "Y como Jesús la vio, la llamó, y le dijo: Mujer, libre eres de tu enfermedad.", "words": [[0, 87381], [2, 87488], [7, 87728], [13, 88028], [16, 88368], [21, 89088], [24, 89248], [31, 89768], [33, 90128], [36, 90268], [42, 91025], [49, 91894], [55, 92354], [60, 92794], [63, 93014], [66, 93154]]}, {"verse": 13, "start": 94322, "end": 99985, "text": "Y puso las manos sobre ella; y enseguida se enderezó, y glorificaba a Dios.", "words": [[0, 94322], [2, 94448], [7, 94728], [11, 94888], [17, 95168], [23, 95528], [29, 96349], [31, 96656], [41, 97256], [44, 97456], [54, 98176], [56, 98516], [68, 99236], [70, 99416]]}, {"verse": 14, "start": 100335, "end": 115175, "text": "Y respondiendo el dirigente de la sinagoga, enojado de que Jesús hubiese curado en sábado, dijo a la multitud: Seis días hay en que es necesario trabajar: en estos, pues, venid y sed curados, y no en día de sábado.", "words": [[0, 100335], [2, 100457], [15, 100937], [18, 101417], [28, 102117], [31, 102237], [34, 102377], [44, 103137], [52, 104257], [55, 104437], [59, 104557], [65, 104957], [73, 105697], [80, 106177], [83, 106357], [91, 106937], [96, 107577], [98, 107737], [101, 107817], [111, 108842], [116, 109013], [121, 109353], [125, 109773], [128, 109913], [132, 110073], [135, 110213], [145, 110693], [155, 111661], [158, 111786], [165, 112326], [171, 112586], [177, 112906], [179, 113026], [183, 113166], [192, 113686], [194, 113966], [197, 114146], [200, 114266], [204, 114426], [207, 114586]]}, {"verse": 15, "start": 115455, "end": 126581, "text": "Entonces el Señor le respondió, y dijo: Hipócrita, cada uno de vosotros ¿no desata en sábado su buey o su asno del pesebre, y lo lleva a beber?", "words": [[0, 115455], [9, 115916], [12, 116296], [18, 116596], [21, 116896], [32, 117536], [34, 117756], [40, 118438], [51, 119505], [56, 119705], [60, 120045], [63, 120205], [72, 120845], [76, 121405], [83, 121925], [86, 122145], [93, 122645], [96, 123085], [101, 123525], [103, 123665], [106, 123825], [111, 124365], [115, 124545], [124, 125125], [126, 125505], [129, 125645], [135, 125905], [137, 126105]]}, {"verse": 16, "start": 126931, "end": 136385, "text": "Y a esta hija de Abraham, que he aquí Satanás la había atado dieciocho años, ¿no convino desatarla de esta ligadura en día de sábado?", "words": [[0, 126931], [2, 127113], [4, 127213], [9, 127493], [14, 127953], [17, 128073], [26, 128513], [30, 128786], [33, 129058], [38, 129498], [46, 130238], [49, 130378], [55, 130678], [61, 131128], [71, 131578], [77, 132738], [81, 133118], [89, 133498], [99, 134318], [102, 134478], [107, 134678], [116, 135218], [119, 135398], [123, 135578], [126, 135738]]}, {"verse": 17, "start": 136735, "end": 147170, "text": "Y diciendo estas cosas, se avergonzaban todos sus adversarios: pero todo el pueblo se gozaba de todas las cosas gloriosas que eran por él hechas.", "words": [[0, 136735], [2, 137115], [11, 137495], [17, 137755], [24, 138755], [27, 139035], [40, 139855], [46, 140255], [50, 140695], [63, 142097], [68, 142241], [73, 142601], [76, 142801], [83, 143201], [86, 143441], [93, 143901], [96, 144061], [102, 144321], [106, 144601], [112, 144881], [122, 145641], [126, 145821], [131, 146021], [135, 146261], [138, 146461]]}, {"verse": 18, "start": 147520, "end": 152234, "text": "Y dijo: ¿A qué es semejante el reino de Dios, y a qué le compararé?", "words": [[0, 147520], [2, 147650], [8, 148330], [11, 148610], [15, 148750], [18, 149090], [28, 149750], [31, 149890], [37, 150250], [40, 150390], [46, 150850], [48, 150930], [50, 151070], [54, 151210], [57, 151350]]}, {"verse": 19, "start": 152584, "end": 164525, "text": "Semejante es a la semilla de mostaza, que tomándola un hombre la metió en su huerto; y creció, y fue hecho árbol grande, y las aves del cielo hicieron nidos en sus ramas.", "words": [[0, 152584], [10, 153208], [13, 153448], [15, 153548], [18, 153668], [26, 154128], [29, 154288], [38, 154848], [42, 155063], [52, 155703], [55, 155883], [62, 156223], [65, 156603], [71, 156923], [74, 157023], [77, 157163], [85, 157839], [87, 158479], [95, 159215], [97, 159355], [101, 159535], [107, 159815], [113, 160215], [121, 160695], [123, 161135], [127, 161275], [132, 161735], [136, 161875], [142, 162235], [151, 162825], [157, 163415], [160, 163575], [164, 163775]]}, {"verse": 20, "start": 164875, "end": 168527, "text": "Y otra vez dijo: ¿A qué compararé el reino de Dios?", "words": [[0, 164875], [2, 165062], [7, 165222], [11, 165542], [17, 166258], [20, 166402], [24, 166482], [34, 167242], [37, 167442], [43, 167822], [46, 167962]]}, {"verse": 21, "start": 168877, "end": 177664, "text": "Semejante es a la levadura, que tomó una mujer, y la escondió en tres medidas de harina, hasta que todo hubo fermentado.", "words": [[0, 169210], [10, 169580], [13, 169840], [15, 169960], [18, 170080], [28, 170660], [32, 170860], [37, 171240], [41, 171380], [48, 171780], [50, 172480], [53, 172620], [62, 173300], [65, 173560], [70, 173800], [78, 174280], [81, 174500], [89, 175000], [95, 175820], [99, 176020], [104, 176300], [109, 176700]]}, {"verse": 22, "start": 178014, "end": 184605, "text": "Y pasaba por todas las ciudades y aldeas, enseñando, y caminando a Jerusalén.", "words": [[0, 178014], [2, 178129], [9, 178569], [13, 178849], [19, 179169], [23, 179489], [32, 180309], [34, 180469], [42, 181309], [53, 182389], [55, 182949], [65, 183649], [67, 183749]]}, {"verse": 23, "start": 184955, "end": 190316, "text": "Y le dijo uno: Señor, ¿son pocos los que se salvan? Y él les dijo:", "words": [[0, 184955], [2, 185146], [5, 185286], [10, 185606], [15, 186701], [22, 187447], [27, 187707], [33, 188207], [37, 188307], [41, 188487], [44, 188607], [52, 189452], [54, 189596], [57, 189696], [61, 189836]]}, {"verse": 24, "start": 190596, "end": 198302, "text": "Esforzaos por entrar por la puerta angosta; porque os digo que muchos procurarán entrar, y no podrán.", "words": [[0, 191125], [10, 191685], [14, 191965], [21, 192445], [25, 192725], [28, 192885], [35, 193325], [44, 194655], [51, 195027], [54, 195207], [59, 195387], [63, 195587], [70, 195827], [81, 196687], [89, 197107], [91, 197407], [94, 197567]]}, {"verse": 25, "start": 198652, "end": 213450, "text": "Después que el padre de familia se levante, y cierre la puerta, y comencéis a estar fuera, y llamar a la puerta, diciendo: Señor, Señor, ábrenos; y respondiendo os dirá: No os conozco de dónde seáis.", "words": [[0, 198652], [8, 198977], [12, 199277], [15, 199397], [21, 199677], [24, 199897], [32, 200257], [35, 200537], [44, 201317], [46, 201577], [53, 202117], [56, 202257], [64, 202657], [66, 203137], [76, 203857], [78, 203957], [84, 204137], [91, 204597], [93, 205077], [100, 205417], [102, 205497], [105, 205597], [113, 205897], [123, 206993], [130, 207546], [137, 208309], [146, 209256], [148, 209363], [161, 210183], [164, 210463], [170, 211168], [173, 211377], [176, 211517], [184, 212137], [187, 212277], [193, 212887]]}, {"verse": 26, "start": 213800, "end": 220507, "text": "Entonces comenzaréis a decir: Delante de ti hemos comido y bebido, y en nuestras plazas enseñaste;", "words": [[0, 213800], [9, 214268], [21, 215168], [23, 215328], [30, 216123], [38, 216569], [41, 216729], [44, 216969], [50, 217249], [57, 217749], [59, 217849], [67, 218309], [69, 218669], [72, 218769], [81, 218949], [88, 219629]]}, {"verse": 27, "start": 220857, "end": 228080, "text": "Y os dirá: Os digo que no os conozco de dónde seáis; apartaos de mí todos los obreros de iniquidad.", "words": [[0, 220857], [2, 221005], [5, 221105], [11, 221764], [14, 221872], [19, 222112], [23, 222312], [26, 222572], [29, 222712], [37, 223232], [40, 223372], [46, 223572], [53, 224995], [62, 225355], [65, 225575], [68, 225875], [74, 225995], [78, 226275], [86, 226875], [89, 227508]]}, {"verse": 28, "start": 228430, "end": 240998, "text": "Allí será el llanto y el crujir de dientes, cuando veáis a Abraham, a Isaac, a Jacob y a todos los profetas en el reino de Dios, y vosotros estéis excluidos.", "words": [[0, 228430], [5, 228794], [10, 229034], [13, 229294], [20, 229734], [22, 229894], [25, 230264], [32, 230634], [35, 230754], [44, 231734], [51, 232014], [57, 232614], [59, 232874], [68, 234074], [70, 234154], [77, 234954], [79, 234994], [85, 235374], [87, 235914], [89, 235994], [95, 236234], [99, 236554], [108, 237114], [111, 237334], [114, 237474], [120, 237874], [123, 238014], [129, 238749], [131, 238874], [140, 239414], [147, 239954]]}, {"verse": 29, "start": 241348, "end": 248409, "text": "Y vendrán del Oriente y del Occidente, del Norte y del Sur, y se sentarán a la mesa en el reino de Dios.", "words": [[0, 241348], [2, 241476], [10, 241976], [14, 242176], [22, 242656], [24, 242816], [28, 242996], [39, 243696], [43, 243976], [49, 244396], [51, 244616], [55, 244796], [60, 245656], [62, 245736], [65, 245856], [74, 246476], [76, 246576], [79, 246636], [84, 246916], [87, 247096], [90, 247256], [96, 247696], [99, 247836]]}, {"verse": 30, "start": 248759, "end": 254618, "text": "Y he aquí, son últimos los que eran primeros, y son primeros los que eran últimos.", "words": [[0, 248759], [2, 248921], [5, 249121], [11, 249461], [15, 249721], [23, 250654], [27, 250766], [31, 250926], [36, 251106], [46, 252086], [48, 252306], [52, 252446], [61, 253246], [65, 253466], [69, 253646], [74, 253886]]}, {"verse": 31, "start": 254968, "end": 263000, "text": "Aquel mismo día llegaron unos de los fariseos, diciéndole: Sal, y vete de aquí, porque Herodes te quiere matar.", "words": [[0, 254968], [6, 255386], [12, 255626], [16, 255986], [25, 256466], [30, 256946], [33, 257146], [37, 257266], [47, 258066], [59, 259386], [64, 259720], [66, 260020], [71, 260260], [74, 260400], [80, 261120], [87, 261520], [95, 261880], [98, 262160], [105, 262380]]}, {"verse": 32, "start": 263280, "end": 273773, "text": "Y les dijo: Id, y decid a aquella zorra: He aquí, echo fuera demonios y acabo sanidades hoy y mañana, y al tercer día culmino mi obra.", "words": [[0, 263280], [2, 263429], [6, 263549], [12, 264424], [16, 264574], [18, 264954], [24, 265254], [26, 265714], [34, 266252], [41, 266944], [44, 267087], [50, 267507], [55, 267927], [61, 268227], [70, 269007], [72, 269107], [78, 269527], [88, 270087], [92, 270487], [94, 270687], [102, 271627], [104, 271707], [107, 271827], [114, 272067], [118, 272487], [126, 273147], [129, 273267]]}, {"verse": 33, "start": 274123, "end": 282919, "text": "Pero es necesario que hoy, y mañana, y pasado mañana camine; porque no es posible que profeta muera fuera de Jerusalén.", "words": [[0, 274123], [5, 274288], [8, 274548], [18, 275568], [22, 275868], [27, 276248], [29, 276868], [37, 277308], [39, 277673], [46, 278073], [53, 278553], [61, 279643], [68, 279804], [71, 279984], [74, 280084], [82, 280484], [86, 280664], [94, 281124], [100, 281504], [106, 281884], [109, 282004]]}, {"verse": 34, "start": 283269, "end": 297122, "text": "¡Jerusalén, Jerusalén! que matas a los profetas, y apedreas a los que son enviados a ti: ¡cuántas veces quise juntar tus hijos, como la gallina sus pollos debajo de sus alas, y no quisiste!", "words": [[0, 283269], [12, 284515], [23, 285586], [27, 285670], [33, 286170], [35, 286270], [39, 286390], [49, 287070], [51, 287525], [60, 288225], [62, 288345], [66, 288465], [70, 288625], [74, 288865], [83, 289445], [85, 289665], [89, 290244], [98, 290671], [104, 291151], [110, 291571], [117, 292111], [121, 292311], [128, 292731], [133, 293331], [136, 293511], [144, 294071], [148, 294211], [155, 294771], [162, 295151], [165, 295311], [169, 295431], [175, 295971], [177, 296231], [180, 296371]]}, {"verse": 35, "start": 297472, "end": 308423, "text": "He aquí, os es dejada vuestra casa desierta: y os digo que no me veréis, hasta que venga tiempo cuando digáis: Bendito el que viene en nombre del Señor.", "words": [[0, 297544], [3, 297654], [9, 297934], [12, 298254], [15, 298474], [22, 299134], [30, 299534], [35, 299794], [45, 301001], [47, 301167], [50, 301287], [55, 301527], [59, 301727], [62, 301967], [65, 302127], [73, 302627], [79, 303287], [83, 303507], [89, 303827], [96, 304187], [103, 304507], [111, 305549], [119, 306236], [122, 306376], [126, 306516], [132, 306796], [135, 307156], [142, 307516], [146, 307796]]}]}