{"book": "LUK", "chapter": 23, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 422692, "verses": [{"verse": 1, "start": 300, "end": 5634, "text": "Levantándose entonces toda la multitud de ellos, le llevaron a Pilato.", "words": [[0, 300], [13, 1218], [22, 1858], [27, 2338], [30, 2558], [39, 3118], [42, 3338], [49, 3878], [52, 4418], [61, 4878], [63, 4998]]}, {"verse": 2, "start": 5984, "end": 16052, "text": "Y comenzaron a acusarle, diciendo: A este hemos hallado que pervierte la nación, y que prohíbe pagar impuestos a César, diciendo que él es el Cristo, el rey.", "words": [[0, 5984], [2, 6110], [13, 6770], [15, 7050], [25, 7770], [35, 9203], [37, 9321], [42, 9561], [48, 9761], [56, 10221], [60, 10531], [70, 10841], [73, 11001], [81, 11461], [83, 11636], [87, 11756], [95, 12156], [101, 12376], [111, 12956], [113, 13196], [120, 13976], [129, 14336], [133, 14656], [136, 14836], [139, 14996], [142, 15116], [150, 15656], [153, 15716]]}, {"verse": 3, "start": 16332, "end": 25293, "text": "Entonces Pilato le preguntó, diciendo: ¿Eres tú el Rey de los judíos? Y respondiéndole él, dijo: Tú lo dices.", "words": [[0, 16332], [9, 16897], [16, 17677], [19, 17877], [29, 18837], [39, 20172], [45, 20360], [48, 20660], [51, 20840], [55, 21060], [58, 21120], [62, 21260], [70, 22248], [72, 22372], [87, 23292], [91, 23572], [97, 24320], [100, 24444], [103, 24584]]}, {"verse": 4, "start": 25643, "end": 31611, "text": "Y Pilato dijo a los principales sacerdotes, y a la gente: Ninguna culpa hallo en este hombre.", "words": [[0, 25643], [2, 25917], [9, 26417], [14, 26717], [16, 26897], [20, 26997], [32, 27817], [44, 28737], [46, 28877], [48, 28957], [51, 28977], [58, 29788], [66, 30086], [72, 30476], [78, 30866], [81, 30946], [86, 31166]]}, {"verse": 5, "start": 31891, "end": 38901, "text": "Pero ellos insistían, diciendo: Alborota al pueblo, enseñando por toda Judea, comenzando desde Galilea hasta aquí.", "words": [[0, 31891], [5, 32078], [11, 32358], [22, 33198], [32, 34290], [41, 34726], [44, 34866], [52, 35106], [62, 35746], [66, 35906], [71, 36086], [78, 36926], [89, 37546], [95, 37726], [103, 38286], [109, 38486]]}, {"verse": 6, "start": 39181, "end": 43960, "text": "Entonces Pilato, oyendo de Galilea, preguntó si el hombre era galileo.", "words": [[0, 39181], [9, 39655], [17, 40475], [24, 40855], [27, 41035], [36, 41755], [45, 42235], [48, 42395], [51, 42575], [58, 42855], [62, 43135]]}, {"verse": 7, "start": 44310, "end": 52955, "text": "Y como entendió que era de la jurisdicción de Herodes, le remitió a Herodes, el cual también estaba en Jerusalén en aquellos días.", "words": [[0, 44310], [2, 44410], [7, 44610], [16, 45150], [20, 45330], [24, 45510], [27, 45650], [30, 45790], [43, 46610], [46, 46770], [55, 47610], [58, 47710], [66, 48410], [68, 48690], [77, 49510], [80, 49630], [85, 49870], [93, 50310], [100, 50690], [103, 50870], [113, 51610], [116, 51810], [125, 52090]]}, {"verse": 8, "start": 53305, "end": 65381, "text": "Y Herodes, viendo a Jesús, se alegró mucho, porque hacía mucho que deseaba verle; porque había oído de él muchas cosas, y tenía esperanza que le vería hacer alguna señal.", "words": [[0, 53305], [2, 53489], [11, 53869], [18, 54289], [20, 54549], [27, 54909], [30, 55489], [37, 55829], [44, 56689], [51, 57089], [57, 57449], [63, 57769], [67, 57989], [75, 58489], [82, 59356], [89, 59559], [95, 59919], [100, 60519], [103, 60739], [106, 60939], [113, 61199], [120, 61739], [122, 62499], [128, 62739], [138, 63379], [142, 63539], [145, 63679], [151, 64019], [157, 64319], [164, 64619]]}, {"verse": 9, "start": 65731, "end": 70361, "text": "Y le preguntaba con muchas palabras; pero él nada le respondió:", "words": [[0, 65731], [2, 65857], [5, 65957], [16, 66617], [20, 66877], [27, 67197], [37, 68326], [42, 68511], [45, 68771], [50, 69136], [53, 69416]]}, {"verse": 10, "start": 70711, "end": 77375, "text": "Y estaban los principales sacerdotes y los escribas acusándolo con gran insistencia.", "words": [[0, 70711], [2, 70819], [10, 71179], [14, 71439], [26, 72339], [37, 73319], [39, 73579], [43, 73699], [52, 74379], [63, 75399], [67, 75639], [72, 75939]]}, {"verse": 11, "start": 77725, "end": 86812, "text": "Pero Herodes con su corte le menospreció, y se burló de él, vistiéndole de una ropa rica; y le volvió a enviar a Pilato.", "words": [[0, 77725], [5, 77907], [13, 78287], [17, 78567], [20, 78897], [26, 79227], [29, 79307], [42, 80227], [44, 80607], [47, 80787], [53, 81247], [56, 81407], [60, 81847], [72, 82807], [75, 82967], [79, 83087], [84, 83507], [90, 84388], [92, 84531], [95, 84611], [102, 85211], [104, 85391], [111, 85931], [113, 86151]]}, {"verse": 12, "start": 87162, "end": 93924, "text": "Y fueron hechos amigos entre sí Pilato y Herodes en el mismo día; porque antes eran enemigos entre sí.", "words": [[0, 87162], [2, 87283], [9, 87503], [16, 87863], [23, 88243], [29, 88643], [32, 88923], [39, 89483], [41, 89683], [49, 90143], [52, 90323], [55, 90443], [61, 90723], [66, 91418], [73, 91660], [79, 92200], [84, 92580], [93, 93160], [99, 93500]]}, {"verse": 13, "start": 94274, "end": 100489, "text": "Entonces Pilato, convocando los principales sacerdotes, y los dirigentes, y el pueblo,", "words": [[0, 94274], [9, 94898], [17, 95818], [28, 96618], [32, 96798], [44, 97598], [56, 98398], [58, 98558], [62, 98678], [74, 99338], [76, 99658], [79, 99838]]}, {"verse": 14, "start": 100839, "end": 111666, "text": "Les dijo: Me habéis presentado a este por hombre que desvía al pueblo: y he aquí, preguntando yo delante de vosotros, no he hallado culpa alguna en este hombre de aquellas de que le acusáis.", "words": [[0, 100839], [4, 101055], [10, 101824], [13, 101926], [20, 102146], [31, 102826], [33, 102966], [38, 103206], [42, 103466], [49, 103686], [53, 103886], [60, 104346], [63, 104466], [71, 105183], [73, 105324], [76, 105424], [82, 105684], [94, 106364], [97, 106524], [105, 106944], [108, 107064], [118, 107924], [121, 108124], [124, 108264], [132, 108584], [138, 108804], [145, 109264], [148, 109464], [153, 109664], [160, 109944], [163, 110124], [172, 110604], [175, 110744], [179, 110844], [182, 110984]]}, {"verse": 15, "start": 112016, "end": 117879, "text": "Y ni aun Herodes; porque os remití a él, y he aquí, ninguna cosa digna de muerte ha hecho.", "words": [[0, 112016], [2, 112179], [5, 112259], [9, 112764], [18, 113440], [25, 113640], [28, 113820], [35, 114320], [37, 114420], [41, 114660], [43, 114900], [46, 115020], [52, 115320], [60, 115940], [65, 116400], [71, 116820], [74, 116920], [81, 117180], [84, 117440]]}, {"verse": 16, "start": 118229, "end": 120586, "text": "Le soltaré, pues, después de castigarlo.", "words": [[0, 118275], [3, 118355], [12, 118625], [18, 118895], [26, 119135], [29, 119735]]}, {"verse": 17, "start": 120866, "end": 124413, "text": "Y tenía necesidad de soltarles uno en cada fiesta.", "words": [[0, 120866], [2, 121093], [8, 121353], [18, 122113], [21, 122273], [31, 123053], [35, 123413], [38, 123553], [43, 123773]]}, {"verse": 18, "start": 124763, "end": 131434, "text": "Pero toda la multitud dio voces a una, diciendo: Quita a este, y suéltanos a Barrabás:", "words": [[0, 124763], [5, 124908], [10, 125348], [13, 125628], [22, 126388], [26, 126688], [32, 127128], [34, 127328], [39, 127908], [49, 128880], [55, 129040], [57, 129240], [63, 129640], [65, 130060], [75, 130640], [77, 130820]]}, {"verse": 19, "start": 131714, "end": 138117, "text": "(El cual había sido echado en la cárcel por una revuelta ocurrida en la ciudad y un homicidio.)", "words": [[0, 131714], [4, 131871], [9, 132151], [15, 132551], [20, 132971], [27, 133491], [30, 133611], [33, 133751], [40, 134271], [44, 134571], [48, 134751], [57, 135451], [66, 136251], [69, 136431], [72, 136551], [79, 136871], [81, 137191], [84, 137331]]}, {"verse": 20, "start": 138467, "end": 141928, "text": "Y les habló otra vez Pilato, queriendo soltar a Jesús.", "words": [[0, 138467], [2, 138573], [6, 138713], [12, 139133], [17, 139393], [21, 139613], [29, 140233], [39, 140713], [46, 141193], [48, 141293]]}, {"verse": 21, "start": 142278, "end": 147223, "text": "Pero ellos volvieron a dar voces, diciendo: Crucifícale, crucifícale.", "words": [[0, 142278], [5, 142460], [11, 142760], [21, 143340], [23, 143480], [27, 143620], [34, 144260], [44, 145583], [57, 146443]]}, {"verse": 22, "start": 147503, "end": 156853, "text": "Y él les dijo la tercera vez: ¿Pues qué mal ha hecho este? Ninguna culpa de muerte he hallado en él: le castigaré, pues, y le soltaré.", "words": [[0, 147503], [2, 147724], [5, 147964], [9, 148364], [14, 148824], [17, 149024], [25, 149604], [30, 150393], [36, 150548], [40, 150728], [44, 150948], [47, 151108], [53, 151348], [59, 152107], [67, 152511], [73, 152751], [76, 152991], [83, 153331], [86, 153611], [94, 153991], [97, 154171], [101, 154677], [104, 154763], [115, 155383], [121, 155683], [123, 156003], [126, 156123]]}, {"verse": 23, "start": 157133, "end": 165832, "text": "Pero ellos instaban a grandes voces, pidiendo que fuese crucificado. Y las voces de ellos y de los principales sacerdotes crecían.", "words": [[0, 157133], [5, 157297], [11, 157537], [20, 158277], [22, 158417], [30, 158677], [37, 159477], [46, 159917], [50, 160077], [56, 160417], [69, 161765], [71, 161873], [75, 161993], [81, 162393], [84, 162553], [90, 162853], [92, 163313], [95, 163393], [99, 163513], [111, 164253], [122, 164913]]}, {"verse": 24, "start": 166182, "end": 170262, "text": "Entonces Pilato juzgó que se hiciese lo que ellos pedían;", "words": [[0, 166182], [9, 166812], [16, 167392], [22, 167952], [26, 168112], [29, 168312], [37, 168972], [40, 169192], [44, 169352], [50, 169572]]}, {"verse": 25, "start": 170612, "end": 181427, "text": "Y les soltó a aquel que había sido echado en la cárcel por una revuelta y un homicidio, al cual habían pedido; y entregó a Jesús a la voluntad de ellos.", "words": [[0, 170612], [2, 170769], [6, 170889], [12, 171509], [14, 171849], [20, 172289], [24, 172429], [30, 172649], [35, 173029], [42, 173469], [45, 173589], [48, 173729], [55, 174209], [59, 174469], [63, 174669], [72, 175389], [74, 175529], [77, 175689], [88, 176196], [91, 176704], [96, 176924], [103, 177444], [111, 178533], [113, 178674], [121, 179174], [123, 179274], [129, 179634], [131, 179934], [134, 180014], [143, 180654], [146, 180834]]}, {"verse": 26, "start": 181777, "end": 190058, "text": "Y llevándole, tomaron a un Simón cireneo, que venía del campo, y le pusieron encima la cruz para que la llevase tras Jesús.", "words": [[0, 181777], [2, 181898], [14, 182458], [22, 183118], [24, 183378], [27, 183518], [33, 184058], [42, 184598], [46, 184763], [52, 185023], [56, 185283], [63, 185783], [65, 186048], [68, 186168], [77, 186628], [84, 187228], [87, 187448], [92, 188128], [97, 188428], [101, 188568], [104, 188708], [112, 189128], [117, 189348]]}, {"verse": 27, "start": 190408, "end": 196542, "text": "Y le seguía una grande multitud de pueblo, y de mujeres, las cuales le lloraban y lamentaban.", "words": [[0, 190408], [2, 190512], [5, 190652], [12, 191112], [16, 191272], [23, 191612], [32, 192332], [35, 192492], [43, 192932], [45, 193092], [48, 193212], [57, 194052], [61, 194172], [68, 194492], [71, 194952], [80, 195472], [82, 195732]]}, {"verse": 28, "start": 196892, "end": 206821, "text": "Pero Jesús, vuelto a ellas, les dice: Hijas de Jerusalén, no me lloréis a mí, sino llorad por vosotras mismas, y por vuestros hijos.", "words": [[0, 196892], [5, 197020], [12, 197680], [19, 198060], [21, 198180], [28, 198720], [32, 198820], [38, 199554], [44, 200018], [47, 200198], [58, 201018], [61, 201258], [64, 201558], [72, 201858], [74, 201978], [78, 202518], [83, 203068], [90, 203618], [94, 203978], [103, 204618], [111, 205498], [113, 205618], [117, 205838], [126, 206258]]}, {"verse": 29, "start": 207171, "end": 217019, "text": "Porque he aquí vendrán días en que dirán: Bienaventuradas las estériles, y los vientres que no engendraron, y los pechos que no amamantaron.", "words": [[0, 207171], [7, 207255], [10, 207375], [15, 207595], [23, 208295], [28, 208655], [31, 208995], [35, 209135], [42, 210579], [58, 211149], [62, 211369], [73, 212169], [75, 212749], [79, 212889], [88, 213349], [92, 213509], [95, 214049], [108, 214589], [110, 214909], [114, 215049], [121, 215489], [125, 215649], [128, 215849]]}, {"verse": 30, "start": 217369, "end": 224019, "text": "Entonces comenzarán a decir a los montes: Caed sobre nosotros: y a las colinas: Cubridnos.", "words": [[0, 217369], [9, 217775], [20, 218635], [22, 218695], [28, 219015], [30, 219175], [34, 219295], [42, 220241], [47, 220606], [53, 220906], [63, 221752], [65, 221992], [67, 222052], [71, 222172], [80, 223575]]}, {"verse": 31, "start": 224369, "end": 229377, "text": "Porque si en el árbol verde hacen estas cosas, ¿en el seco, qué se hará?", "words": [[0, 224369], [7, 224592], [10, 224832], [13, 225032], [16, 225172], [22, 225512], [28, 225972], [34, 226432], [40, 226712], [47, 227712], [51, 227952], [54, 228072], [60, 228572], [64, 228672], [67, 228872]]}, {"verse": 32, "start": 229727, "end": 234417, "text": "Y llevaban también con él otros dos, malhechores, a ser muertos.", "words": [[0, 229727], [2, 229833], [11, 230313], [19, 230693], [23, 230933], [26, 231153], [32, 231473], [37, 232183], [50, 232893], [52, 233373], [56, 233553]]}, {"verse": 33, "start": 234767, "end": 243655, "text": "Y cuando vinieron al lugar que se llama de la Calavera, le crucificaron allí, y a los malhechores, uno a la derecha, y otro a la izquierda.", "words": [[0, 234767], [2, 234886], [9, 235106], [18, 235706], [21, 235886], [27, 236226], [31, 236446], [34, 236566], [40, 236826], [43, 237006], [46, 237126], [56, 238226], [59, 238306], [72, 239226], [78, 239586], [80, 239771], [82, 239871], [86, 240431], [99, 240991], [103, 241331], [105, 241531], [108, 241611], [117, 242171], [119, 242411], [124, 242631], [126, 242791], [129, 242871]]}, {"verse": 34, "start": 244005, "end": 252149, "text": "Y Jesús decía: Padre, perdónalos, porque no saben lo que hacen. Y partiendo sus vestidos, echaron suertes.", "words": [[0, 244005], [2, 244131], [8, 244451], [15, 245468], [22, 245871], [34, 246691], [41, 247251], [44, 247471], [50, 247851], [53, 248071], [57, 248211], [64, 249084], [66, 249172], [76, 249792], [80, 250032], [90, 250652], [98, 251252]]}, {"verse": 35, "start": 252499, "end": 264698, "text": "Y el pueblo estaba mirando; y se burlaban de él los dirigentes con ellos, diciendo: A otros hizo salvos: sálvese a sí, si este es el Mesías, el escogido de Dios.", "words": [[0, 252499], [2, 252756], [5, 252876], [12, 253216], [19, 253556], [28, 254616], [30, 254763], [33, 254903], [42, 255503], [45, 255763], [48, 255943], [52, 256083], [63, 256683], [67, 256963], [74, 257263], [84, 258497], [86, 258642], [92, 259105], [97, 259569], [105, 260199], [113, 260443], [115, 260729], [119, 261016], [122, 261356], [127, 261596], [130, 261756], [133, 261856], [141, 262716], [144, 262796], [153, 263296], [156, 263436]]}, {"verse": 36, "start": 264978, "end": 270577, "text": "Se burlaban de él también los soldados, llegándose y presentándole vinagre,", "words": [[0, 264978], [3, 265180], [12, 265760], [15, 266000], [18, 266220], [26, 266540], [30, 266820], [40, 267660], [51, 268580], [53, 268880], [67, 269840]]}, {"verse": 37, "start": 270927, "end": 275255, "text": "Y diciendo: Si tú eres el Rey de los judíos, sálvate a ti mismo.", "words": [[0, 270927], [2, 271057], [12, 272028], [15, 272208], [18, 272388], [23, 272588], [26, 272788], [30, 273028], [33, 273088], [37, 273208], [45, 274008], [53, 274488], [55, 274648], [58, 274728]]}, {"verse": 38, "start": 275535, "end": 284417, "text": "Y había también sobre él un letrero escrito con letras griegas, y latinas, y hebreas: ESTE ES EL REY DE LOS JUDÍOS.", "words": [[0, 275535], [2, 275641], [8, 275841], [16, 276141], [22, 276561], [25, 276881], [28, 277101], [36, 277721], [44, 278101], [48, 278621], [55, 279121], [64, 279841], [66, 280061], [75, 280581], [77, 280881], [86, 281783], [91, 282171], [94, 282571], [97, 283071], [101, 283411], [104, 283491], [108, 283651]]}, {"verse": 39, "start": 284767, "end": 293366, "text": "Y uno de los malhechores que estaban colgados, le injuriaba, diciendo: Si tú eres el Cristo, sálvate a ti mismo y a nosotros.", "words": [[0, 284767], [2, 284891], [6, 285051], [9, 285171], [13, 285291], [25, 285911], [29, 286111], [37, 286621], [47, 287131], [50, 287591], [61, 288451], [71, 289682], [74, 289887], [77, 290047], [82, 290227], [85, 290387], [93, 291387], [101, 291747], [103, 291927], [106, 292007], [112, 292367], [114, 292547], [116, 292627]]}, {"verse": 40, "start": 293646, "end": 301144, "text": "Y respondiendo el otro, le reprendió, diciendo: ¿Ni aun tú temes a Dios, estando en la misma condenación?", "words": [[0, 293646], [2, 294052], [15, 294492], [18, 294692], [24, 295452], [27, 295692], [38, 296472], [48, 297723], [52, 297881], [56, 298041], [59, 298301], [65, 298681], [67, 298781], [73, 299301], [81, 299701], [84, 299801], [87, 299901], [93, 300141]]}, {"verse": 41, "start": 301494, "end": 308692, "text": "Y nosotros, a la verdad, justamente padecemos; porque recibimos lo que merecieron nuestros hechos: pero este ningún mal hizo.", "words": [[0, 301494], [2, 301579], [12, 302099], [14, 302199], [17, 302279], [25, 302939], [36, 303279], [47, 304495], [54, 304678], [64, 305298], [67, 305478], [71, 305598], [82, 306138], [91, 306398], [99, 307148], [104, 307466], [109, 307686], [116, 308026], [120, 308386]]}, {"verse": 42, "start": 308972, "end": 312661, "text": "Y dijo a Jesús: Acuérdate de mí cuando vengas a tu reino.", "words": [[0, 308972], [2, 309139], [7, 309419], [9, 309519], [16, 310450], [26, 310972], [29, 311212], [32, 311332], [39, 311552], [46, 312032], [48, 312112], [51, 312232]]}, {"verse": 43, "start": 312941, "end": 318593, "text": "Entonces Jesús le dijo: De cierto te digo, que hoy estarás conmigo en el paraíso.", "words": [[0, 312941], [9, 313405], [15, 313905], [18, 314225], [24, 314933], [27, 315079], [34, 315379], [37, 315759], [43, 316119], [47, 316334], [51, 316594], [59, 317074], [67, 317594], [70, 317714], [73, 318180]]}, {"verse": 44, "start": 318943, "end": 326447, "text": "Y cuando era como la hora de sexta, fueron hechas tinieblas sobre toda la tierra hasta la hora de nona.", "words": [[0, 318943], [2, 319067], [9, 319327], [13, 319667], [18, 319927], [21, 320127], [26, 320307], [29, 320487], [36, 321407], [43, 321867], [50, 322387], [60, 322907], [66, 323167], [71, 323527], [74, 323727], [81, 324067], [87, 324527], [90, 325015], [95, 325504], [98, 325992]]}, {"verse": 45, "start": 326797, "end": 332084, "text": "Y el sol se oscureció: y el velo del templo se rompió por medio.", "words": [[0, 326797], [2, 326944], [5, 327104], [9, 327424], [12, 327804], [23, 329066], [25, 329194], [28, 329334], [33, 329634], [37, 329794], [44, 330434], [47, 330514], [54, 331094], [58, 331354]]}, {"verse": 46, "start": 332434, "end": 342805, "text": "Entonces Jesús, clamando a gran voz, dijo: Padre, en tus manos encomiendo mi espíritu. Y habiendo dicho esto, exhaló su último aliento.", "words": [[0, 332434], [9, 332912], [16, 333652], [25, 334152], [27, 334232], [32, 334392], [37, 334992], [43, 335633], [50, 336120], [53, 336380], [57, 336560], [63, 336960], [74, 337800], [77, 338040], [87, 339086], [89, 339213], [98, 339533], [104, 339833], [110, 340853], [117, 341353], [120, 341513], [127, 341973]]}, {"verse": 47, "start": 343155, "end": 351325, "text": "Y como el centurión vio lo que había acontecido, dio gloria a Dios, diciendo: Verdaderamente este hombre era justo.", "words": [[0, 343155], [2, 343257], [7, 343497], [10, 343697], [20, 344317], [24, 344597], [27, 344717], [31, 344877], [37, 345117], [49, 346337], [53, 346737], [60, 347337], [62, 347657], [68, 347917], [78, 349238], [93, 350036], [98, 350256], [105, 350516], [109, 350776]]}, {"verse": 48, "start": 351605, "end": 361322, "text": "Y toda la multitud de los que estaban presentes a este espectáculo, viendo lo que había acontecido, se volvían golpeándose el pecho.", "words": [[0, 351605], [2, 351729], [7, 352009], [10, 352249], [19, 353029], [22, 353309], [26, 353449], [30, 353569], [38, 353909], [48, 354649], [50, 354769], [55, 355009], [68, 356229], [75, 356729], [78, 357029], [82, 357169], [88, 357489], [100, 358729], [103, 358909], [111, 359449], [123, 360409], [126, 360609]]}, {"verse": 49, "start": 361672, "end": 368896, "text": "Pero todos sus conocidos, y las mujeres que le habían seguido desde Galilea, estaban lejos mirando estas cosas.", "words": [[0, 361672], [5, 361813], [11, 362133], [15, 362433], [26, 363233], [28, 363393], [32, 363533], [40, 363953], [44, 364273], [47, 364433], [54, 364693], [62, 365273], [68, 365453], [77, 366233], [85, 366813], [91, 367413], [99, 367958], [105, 368118]]}, {"verse": 50, "start": 369246, "end": 376312, "text": "Y he aquí un varón llamado José, el cual era miembro del Consejo, varón bueno y justo,", "words": [[0, 369246], [2, 369392], [5, 369552], [10, 369832], [13, 370072], [19, 370432], [27, 370712], [33, 371892], [36, 371992], [41, 372252], [45, 372652], [53, 373232], [57, 373412], [66, 374672], [72, 375112], [78, 375412], [80, 375692]]}, {"verse": 51, "start": 376662, "end": 386614, "text": "(El cual no había consentido en el consejo ni en los hechos de ellos), de Arimatea, ciudad de la Judea, el cual también esperaba el reino de Dios;", "words": [[0, 376662], [4, 376805], [9, 376965], [12, 377205], [18, 377445], [29, 378225], [32, 378325], [35, 378425], [43, 379005], [46, 379125], [49, 379225], [53, 379385], [60, 379705], [63, 379905], [71, 380685], [74, 380925], [84, 381945], [91, 382385], [94, 382685], [97, 382805], [104, 383705], [107, 383825], [112, 384045], [120, 384605], [129, 385405], [132, 385565], [138, 385965], [141, 386105]]}, {"verse": 52, "start": 386964, "end": 390819, "text": "Este llegó a Pilato, y pidió el cuerpo de Jesús.", "words": [[0, 386964], [5, 387220], [11, 387540], [13, 387640], [21, 388180], [23, 388980], [29, 389320], [32, 389420], [39, 389780], [42, 390060]]}, {"verse": 53, "start": 391169, "end": 400535, "text": "Y quitado, lo envolvió en una sábana, y le puso en un sepulcro abierto en una peña, en el cual ninguno había aún sido puesto.", "words": [[0, 391169], [2, 391296], [11, 391736], [14, 391876], [23, 392396], [26, 392496], [30, 392656], [38, 393276], [40, 393936], [43, 394076], [48, 394496], [51, 394636], [54, 394796], [63, 395536], [71, 396276], [74, 396496], [78, 396656], [84, 397176], [87, 397656], [90, 397776], [95, 398036], [103, 398756], [109, 399036], [113, 399416], [118, 399776]]}, {"verse": 54, "start": 400885, "end": 405499, "text": "Y era día de la víspera de la Pascua; y estaba para comenzar el sábado.", "words": [[0, 400885], [2, 401087], [6, 401227], [10, 401467], [13, 401667], [16, 401807], [24, 402267], [27, 402347], [30, 402447], [38, 403323], [40, 403447], [47, 403767], [52, 404047], [61, 404707], [64, 404827]]}, {"verse": 55, "start": 405849, "end": 414433, "text": "Y las mujeres que con él habían venido de Galilea, siguieron también y vieron el sepulcro, y cómo fue puesto su cuerpo.", "words": [[0, 405849], [2, 406088], [6, 406208], [14, 406688], [18, 407013], [22, 407233], [25, 407373], [32, 407613], [39, 408073], [42, 408233], [51, 408933], [61, 409713], [69, 410133], [71, 410733], [78, 411073], [81, 411273], [91, 411993], [93, 412593], [98, 412893], [102, 413173], [109, 413553], [112, 413793]]}, {"verse": 56, "start": 414783, "end": 422292, "text": "Y vueltas, prepararon especias aromáticas y ungüentos; y descansaron el sábado, conforme al mandamiento.", "words": [[0, 414783], [2, 414904], [11, 415364], [22, 416084], [31, 416804], [42, 417564], [44, 417844], [55, 418980], [57, 419102], [69, 419842], [72, 420022], [80, 420662], [89, 421322], [92, 421422]]}]}