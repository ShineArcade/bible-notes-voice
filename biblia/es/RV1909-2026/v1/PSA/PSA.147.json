{"book": "PSA", "chapter": 147, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 112675, "verses": [{"verse": 1, "start": 300, "end": 7833, "text": "Alabad a JAH, porque es bueno cantar salmos a nuestro Dios; porque agradable y hermosa es la alabanza.", "words": [[0, 300], [7, 725], [9, 1166], [14, 1607], [21, 1809], [24, 1989], [30, 2209], [37, 2889], [44, 3529], [46, 3689], [54, 3869], [60, 4796], [67, 5006], [77, 5786], [79, 5946], [87, 6546], [90, 6686], [93, 6906]]}, {"verse": 2, "start": 8183, "end": 13590, "text": "Jehová edifica a Jerusalén; a los desterrados de Israel recogerá.", "words": [[0, 8504], [7, 8864], [15, 9224], [17, 9324], [28, 10465], [30, 10699], [34, 10859], [46, 11879], [49, 12079], [56, 12579]]}, {"verse": 3, "start": 13940, "end": 18290, "text": "Él sana a los quebrantados de corazón, y venda sus heridas.", "words": [[0, 13940], [3, 14126], [8, 14506], [10, 14806], [14, 14946], [27, 15826], [30, 15986], [39, 16506], [41, 16933], [47, 17361], [51, 17541]]}, {"verse": 4, "start": 18640, "end": 23689, "text": "Él cuenta el número de las estrellas; a todas ellas llama por sus nombres.", "words": [[0, 18640], [3, 18788], [10, 19188], [13, 19348], [20, 19728], [23, 19968], [27, 20148], [38, 21193], [40, 21413], [46, 21593], [52, 21913], [58, 22453], [62, 22753], [66, 22933]]}, {"verse": 5, "start": 24039, "end": 29838, "text": "Grande es el Señor nuestro, y de mucho poder; y de su entendimiento no hay número.", "words": [[0, 24039], [7, 24407], [10, 24767], [13, 24927], [19, 25227], [28, 26287], [30, 26427], [33, 26567], [39, 26847], [46, 27653], [48, 27755], [51, 27875], [54, 28015], [68, 28795], [71, 28995], [75, 29215]]}, {"verse": 6, "start": 30188, "end": 35622, "text": "Jehová ensalza a los humildes; humilla los impíos hasta la tierra.", "words": [[0, 30610], [7, 31070], [15, 31530], [17, 31870], [21, 32030], [31, 33349], [39, 33659], [43, 33779], [50, 34459], [56, 34719], [59, 34879]]}, {"verse": 7, "s