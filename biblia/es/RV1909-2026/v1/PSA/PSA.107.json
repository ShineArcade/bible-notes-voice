{"book": "PSA", "chapter": 107, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 249766, "verses": [{"verse": 1, "start": 300, "end": 5728, "text": "Alabad a Jehová, porque es bueno; porque para siempre es su misericordia.", "words": [[0, 606], [7, 926], [9, 1186], [17, 1746], [24, 2046], [27, 2286], [34, 3052], [41, 3257], [46, 3517], [54, 4097], [57, 4442], [60, 4602]]}, {"verse": 2, "start": 6078, "end": 11118, "text": "Díganlo los redimidos de Jehová, los que ha redimido del poder del enemigo,", "words": [[0, 6078], [8, 6601], [12, 6801], [22, 7421], [25, 7581], [33, 8381], [37, 8461], [41, 8641], [44, 8821], [53, 9621], [57, 9801], [63, 10121], [67, 10381]]}, {"verse": 3, "start": 11468, "end": 17018, "text": "Y los ha congregado de las tierras, del oriente y del occidente, del norte y del mar.", "words": [[0, 11468], [2, 11561], [6, 11681], [9, 11901], [20, 12601], [23, 12741], [27, 12881], [36, 13861], [40, 14121], [48, 14581], [50, 14741], [54, 14861], [65, 15621], [69, 15761], [75, 16221], [77, 16421], [81, 16601]]}, {"verse": 4, "start": 17368, "end": 23880, "text": "Anduvieron perdidos por el desierto, por la soledad sin camino, no hallando ciudad de población.", "words": [[0, 17368], [11, 18087], [20, 18687], [24, 18907], [27, 19047], [37, 19707], [41, 19827], [44, 19967], [52, 20507], [56, 20647], [64, 21487], [67, 21587], [76, 22067], [83, 22467], [86, 22787]]}, {"verse": 5, "start": 24230, "end": 28471, "text": "Hambrientos y sedientos, su alma desfallecía en ellos.", "words": [[0, 24230], [12, 25074], [14, 25254], [25, 25934], [28, 26354], [33, 26674], [45, 27654], [48, 27834]]}, {"verse": 6, "start": 28821, "end": 34410, "text": "Pero habiendo clamado a Jehová en su angustia, los libró de sus aflicciones:", "words": [[0, 28821], [5, 28967], [14, 29327], [22, 29687], [24, 30067], [31, 30507], [34, 30627], [37, 30807], [47, 31887], [51, 32027], [57, 32767], [60, 32927], [64, 33107]]}, {"verse": 7, "start": 34760, "end": 39885, "text": "Y los dirigió por camino derecho, para que viniesen a ciudad de población.", "words": [[0, 34760], [2, 34868], [6, 35028], [14, 35628], [18, 35848], [25, 36208], [34, 36808], [39, 37448], [43, 37648], [52, 38168], [54, 38368], [61, 38688], [64, 39028]]}, {"verse": 8, "start": 40235, "end": 45789, "text": "Alaben la misericordia de Jehová, y sus maravillas para con los hijos de los hombres.", "words": [[0, 40402], [7, 40602], [10, 40782], [23, 41582], [26, 41682], [34, 42622], [36, 42822], [40, 42962], [51, 43642], [56, 44042], [60, 44302], [64, 44502], [70, 44802], [73, 44962], [77, 45102]]}, {"verse": 9, "start": 46139, "end": 51837, "text": "Porque sació al alma menesterosa, y llenó de bien al alma hambrienta.", "words": [[0, 46139], [7, 46345], [13, 46925], [16, 47165], [21, 47785], [34, 48405], [36, 49165], [42, 49585], [45, 49725], [50, 49985], [53, 50325], [58, 50645]]}, {"verse": 10, "start": 52187, "end": 58234, "text": "Los que moraban en tinieblas y sombra de muerte, aprisionados en aflicción y en hierros;", "words": [[0, 52187], [4, 52294], [8, 52434], [16, 52954], [19, 53404], [29, 53854], [31, 53974], [38, 54454], [41, 54574], [49, 55569], [62, 56049], [65, 56269], [75, 56969], [77, 57209], [80, 57369]]}, {"verse": 11, "start": 58584, "end": 64865, "text": "Por cuanto fueron rebeldes a las palabras de Jehová, y aborrecieron el consejo del Altísimo,", "words": [[0, 58584], [4, 58728], [11, 59028], [18, 59488], [27, 60188], [29, 60348], [33, 60468], [42, 60848], [45, 61148], [53, 61828], [55, 62048], [68, 62948], [71, 63108], [79, 63768], [83, 63968]]}, {"verse": 12, "start": 65215, "end": 71361, "text": "Por lo que quebrantó él con trabajo sus corazones, cayeron y no hubo quien les ayudase;", "words": [[0, 65215], [4, 65377], [7, 65497], [11, 65657], [21, 66317], [24, 66537], [28, 66777], [36, 67157], [40, 67417], [51, 68247], [59, 69077], [61, 69577], [64, 69757], [69, 70057], [75, 70237], [79, 70477]]}, {"verse": 13, "start": 71711, "end": 76717, "text": "Luego que clamaron a Jehová en su angustia, los libró de sus aflicciones.", "words": [[0, 71711], [6, 71931], [10, 72171], [19, 72651], [21, 72811], [28, 73111], [31, 73211], [34, 73351], [44, 74411], [48, 74611], [54, 75271], [57, 75371], [61, 75531]]}, {"verse": 14, "start": 77067, "end": 82323, "text": "Los sacó de las tinieblas y de la sombra de muerte, y rompió sus prisiones.", "words": [[0, 77114], [4, 77194], [9, 77674], [12, 77774], [16, 78264], [26, 78754], [28, 78954], [31, 79054], [34, 79174], [41, 79634], [44, 79754], [52, 80234], [54, 80539], [61, 81139], [65, 81339]]}, {"verse": 15, "start": 82673, "end": 88678, "text": "Alaben la misericordia de Jehová, y sus maravillas para con los hijos de los hombres.", "words": [[0, 82952], [7, 83262], [10, 83462], [23, 84362], [26, 84482], [34, 85422], [36, 85722], [40, 85902], [51, 86582], [56, 86842], [60, 87102], [64, 87302], [70, 87622], [73, 87822], [77, 87942]]}, {"verse": 16, "start": 89028, "end": 94986, "text": "Porque quebrantó las puertas de bronce, y desmenuzó los cerrojos de hierro.", "words": [[0, 89028], [7, 89330], [17, 90250], [21, 90410], [29, 90950], [32, 91130], [40, 91730], [42, 92210], [52, 93270], [56, 93720], [65, 94170], [68, 94370]]}, {"verse": 17, "start": 95336, "end": 102623, "text": "Los insensatos, a causa del camino de su rebelión y a causa de sus maldades, fueron afligidos.", "words": [[0, 95336], [4, 95911], [16, 96521], [18, 96721], [24, 97001], [28, 97321], [35, 97681], [38, 97881], [41, 98061], [50, 98741], [52, 99046], [54, 99166], [60, 99746], [63, 99986], [67, 100186], [77, 101026], [84, 101586]]}, {"verse": 18, "start": 102973, "end": 107757, "text": "Su alma abominó toda comida, y llegaron hasta las puertas de la muerte.", "words": [[0, 102973], [3, 103142], [8, 103502], [16, 104362], [21, 104582], [29, 105122], [31, 105467], [40, 106007], [46, 106307], [50, 106527], [58, 106927], [61, 107067], [64, 107167]]}, {"verse": 19, "start": 108107, "end": 113047, "text": "Pero clamaron a Jehová en su angustia, y los salvó de sus aflicciones.", "words": [[0, 108107], [5, 108629], [14, 109389], [16, 109549], [23, 109949], [26, 110069], [29, 110229], [39, 110969], [41, 111069], [45, 111229], [51, 111729], [54, 111809], [58, 111969]]}, {"verse": 20, "start": 113397, "end": 117753, "text": "Envió su palabra, y los curó, y los libró de su ruina.", "words": [[0, 113397], [6, 113781], [9, 113981], [18, 114481], [20, 114681], [24, 114841], [30, 115361], [32, 116101], [36, 116301], [42, 116821], [45, 116901], [48, 117081]]}, {"verse": 21, "start": 118103, "end": 123542, "text": "Alaben la misericordia de Jehová, y sus maravillas para con los hijos de los hombres:", "words": [[0, 118314], [7, 118564], [10, 118804], [23, 119704], [26, 119824], [34, 120504], [36, 120704], [40, 120864], [51, 121524], [56, 121784], [60, 122024], [64, 122224], [70, 122504], [73, 122684], [77, 122804]]}, {"verse": 22, "start": 123892, "end": 128062, "text": "Y sacrifiquen sacrificios de alabanza, y publiquen sus obras con júbilo.", "words": [[0, 123892], [2, 124277], [14, 124697], [26, 125397], [29, 125517], [39, 126057], [41, 126347], [51, 126637], [55, 126797], [61, 127097], [65, 127357]]}, {"verse": 23, "start": 128412, "end": 133174, "text": "Los que descienden al mar en naves, y hacen negocio en las muchas aguas,", "words": [[0, 128412], [4, 128700], [8, 128840], [19, 129400], [22, 129640], [26, 129840], [29, 130060], [36, 130520], [38, 131000], [44, 131220], [52, 131960], [55, 132120], [59, 132200], [66, 132460]]}, {"verse": 24, "start": 133524, "end": 138010, "text": "Ellos han visto las obras de Jehová, y sus maravillas en el profundo.", "words": [[0, 133524], [6, 133748], [10, 134008], [16, 134268], [20, 134488], [26, 134788], [29, 134968], [37, 135788], [39, 136028], [43, 136168], [54, 136788], [57, 137008], [60, 137148]]}, {"verse": 25, "start": 138360, "end": 143947, "text": "Él dijo, e hizo saltar el viento de la tempestad, que levanta sus ondas.", "words": [[0, 138360], [3, 138564], [9, 138984], [11, 139424], [16, 139844], [23, 140744], [26, 140824], [33, 141284], [36, 141424], [39, 141564], [50, 142264], [54, 142604], [62, 143084], [66, 143224]]}, {"verse": 26, "start": 144297, "end": 151390, "text": "Suben a los cielos, descienden a los abismos: sus almas se derriten con el mal.", "words": [[0, 144297], [6, 144937], [8, 145137], [12, 145277], [20, 146537], [31, 147377], [33, 147677], [37, 147797], [46, 148822], [50, 148985], [56, 149505], [59, 149885], [68, 150565], [72, 150725], [75, 150925]]}, {"verse": 27, "start": 151740, "end": 157344, "text": "Tiemblan, y titubean como borrachos, y de nada les sirve toda su pericia.", "words": [[0, 151740], [10, 152305], [12, 152605], [21, 153325], [26, 153585], [37, 154445], [39, 154950], [42, 155070], [47, 155290], [51, 155510], [57, 155910], [62, 156190], [65, 156510]]}, {"verse": 28, "start": 157694, "end": 161867, "text": "Pero claman a Jehová en su angustia, y los libra de sus aflicciones.", "words": [[0, 157694], [5, 157863], [12, 158303], [14, 158443], [21, 158823], [24, 158923], [27, 159063], [37, 159683], [39, 159843], [43, 160003], [49, 160383], [52, 160523], [56, 160703]]}, {"verse": 29, "start": 162217, "end": 166670, "text": "Hace parar la tempestad en sosiego, y se apaciguan sus ondas.", "words": [[0, 162443], [5, 162709], [11, 162976], [14, 163076], [24, 163716], [27, 164146], [36, 164576], [38, 164996], [41, 165376], [51, 165756], [55, 165956]]}, {"verse": 30, "start": 167020, "end": 172759, "text": "Alégranse luego porque se reposaron; y él los guía al puerto que deseaban.", "words": [[0, 167020], [10, 167740], [16, 168000], [23, 168380], [26, 168560], [37, 169590], [39, 169789], [42, 169989], [46, 170369], [51, 170829], [54, 171069], [61, 171549], [65, 171729]]}, {"verse": 31, "start": 173109, "end": 178711, "text": "Alaben la misericordia de Jehová, y sus maravillas para con los hijos de los hombres.", "words": [[0, 173329], [7, 173549], [10, 174109], [23, 174889], [26, 174989], [34, 175769], [36, 175909], [40, 176049], [51, 176689], [56, 176949], [60, 177149], [64, 177349], [70, 177649], [73, 177829], [77, 177949]]}, {"verse": 32, "start": 179061, "end": 186087, "text": "Y ensálcenlo en la congregación del pueblo; y en asamblea de ancianos lo alaben.", "words": [[0, 179061], [2, 179241], [13, 180381], [16, 180801], [19, 180941], [32, 181741], [36, 181941], [44, 182968], [46, 183175], [49, 183335], [58, 184235], [61, 184335], [70, 184995], [73, 185315]]}, {"verse": 33, "start": 186437, "end": 191691, "text": "El vuelve los ríos en desierto, y los manantiales de las aguas en lugares secos;", "words": [[0, 186437], [3, 186625], [10, 187045], [14, 187185], [19, 187605], [22, 187765], [32, 188425], [34, 188905], [38, 189045], [50, 189785], [53, 189865], [57, 189985], [63, 190405], [66, 190525], [74, 190825]]}, {"verse": 34, "start": 192041, "end": 197459, "text": "La tierra fructífera en terreno salado, por la maldad de los que la habitan.", "words": [[0, 192041], [3, 192166], [10, 192506], [21, 193546], [24, 193786], [32, 194206], [40, 194806], [44, 195426], [47, 195586], [54, 196046], [57, 196266], [61, 196406], [65, 196546], [68, 196706]]}, {"verse": 35, "start": 197809, "end": 203392, "text": "Vuelve el desierto en estanques de aguas, y la tierra seca en manantiales.", "words": [[0, 197809], [7, 198509], [10, 198749], [19, 199409], [22, 199589], [32, 200209], [35, 200389], [42, 200929], [44, 201309], [47, 201429], [54, 201709], [59, 202229], [62, 202349]]}, {"verse": 36, "start": 203742, "end": 208865, "text": "Y allí aposenta a los hambrientos, y disponen ciudad para habitación;", "words": [[0, 203742], [2, 203927], [7, 204187], [16, 205007], [18, 205207], [22, 205327], [35, 206307], [37, 206777], [46, 207247], [53, 207647], [58, 208067]]}, {"verse": 37, "start": 208865, "end": 213609, "text": "Y siembran campos, y plantan viñas, y rinden crecido fruto.", "words": [[0, 208865], [2, 209065], [11, 209525], [19, 210165], [21, 210345], [29, 210845], [36, 211425], [38, 211845], [45, 212265], [53, 212945]]}, {"verse": 38, "start": 213959, "end": 219209, "text": "Y los bendice, y se multiplican en gran manera; y no disminuye sus bestias.", "words": [[0, 213959], [2, 214057], [6, 214177], [15, 214777], [17, 215117], [20, 215237], [32, 215997], [35, 216117], [40, 216297], [48, 217140], [50, 217324], [53, 217744], [63, 218164], [67, 218344]]}, {"verse": 39, "start": 219559, "end": 224525, "text": "Y luego son menoscabados y abatidos a causa de tiranía, de males y congojas.", "words": [[0, 219559], [2, 219668], [8, 219848], [12, 220458], [25, 221068], [27, 221248], [36, 221768], [38, 221928], [44, 222208], [47, 222488], [56, 223088], [59, 223228], [65, 223508], [67, 223728]]}, {"verse": 40, "start": 224875, "end": 232049, "text": "El derrama menosprecio sobre los príncipes, y les hace andar errados, vagabundos, sin camino:", "words": [[0, 224875], [3, 225197], [11, 225787], [23, 226377], [29, 226717], [33, 226917], [44, 227617], [46, 227997], [50, 228177], [55, 228717], [61, 229237], [70, 230057], [82, 230877], [86, 231317]]}, {"verse": 41, "start": 232399, "end": 238570, "text": "Y levanta al pobre de la miseria, y hace multiplicar las familias como rebaños de ovejas.", "words": [[0, 232399], [2, 232526], [10, 232856], [13, 233186], [19, 233566], [22, 233786], [25, 233906], [34, 234826], [36, 235086], [41, 235306], [53, 236166], [57, 236266], [66, 236866], [71, 237106], [79, 237686], [82, 237846]]}, {"verse": 42, "start": 238920, "end": 243649, "text": "Vean los rectos, y alégrense; y toda maldad cierre su boca.", "words": [[0, 238920], [5, 239248], [9, 239408], [17, 239988], [19, 240088], [30, 241207], [32, 241332], [37, 241512], [44, 242092], [51, 242852], [54, 243032]]}, {"verse": 43, "start": 243999, "end": 249366, "text": "¿Quién es sabio y guardará estas cosas, y entenderá las misericordias de Jehová?", "words": [[0, 243999], [7, 244203], [10, 244483], [16, 245083], [18, 245258], [27, 245738], [33, 245938], [40, 246538], [42, 246953], [52, 247613], [56, 247753], [70, 248593], [73, 248753]]}]}