{"book": "ROM", "chapter": 14, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 158604, "verses": [{"verse": 1, "start": 300, "end": 4223, "text": "Him that is weak in the faith receive you, but not to doubtful disputations.", "words": [[0, 300], [4, 471], [9, 671], [12, 811], [17, 1011], [20, 1151], [24, 1251], [30, 1511], [38, 1951], [43, 2191], [47, 2351], [51, 2611], [54, 2791], [63, 3251]]}, {"verse": 2, "start": 4673, "end": 9318, "text": "For one believes that he may eat all things: another, who is weak, eats herbs.", "words": [[0, 4673], [4, 4756], [8, 4956], [17, 5316], [22, 5536], [25, 5716], [29, 5896], [33, 6116], [37, 6356], [45, 7248], [54, 7587], [58, 8047], [61, 8207], [67, 8447], [72, 8727]]}, {"verse": 3, "start": 9768, "end": 17136, "text": "Let not him that eats despise him that eats not; and let not him which eats not judge him that eats: for God has received him.", "words": [[0, 9768], [4, 9929], [8, 10149], [12, 10369], [17, 10589], [22, 10829], [30, 11449], [34, 11589], [39, 11769], [44, 12009], [49, 12784], [53, 12923], [57, 13103], [61, 13303], [65, 13583], [71, 13823], [76, 14083], [80, 14303], [86, 14603], [90, 14843], [95, 15003], [101, 15757], [105, 15867], [109, 16147], [113, 16367], [122, 16767]]}, {"verse": 4, "start": 17586, "end": 25312, "text": "Who are you that judge another man’s servant? to his own master he stands or falls. Yes, he shall be held up: for God is able to make him stand.", "words": [[0, 17586], [4, 17692], [8, 17812], [12, 17952], [17, 18132], [23, 18392], [31, 18652], [37, 19132], [46, 19852], [49, 19946], [53, 20126], [57, 20306], [64, 20746], [67, 20806], [74, 21149], [77, 21493], [84, 22074], [89, 22380], [92, 22420], [98, 22580], [101, 22740], [106, 22940], [110, 23580], [114, 23689], [118, 23909], [121, 24089], [126, 24329], [129, 24529], [134, 24729], [138, 24829]]}, {"verse": 5, "start": 25762, "end": 33583, "text": "One man esteems one day above another: another esteems every day alike. Let every man be fully persuaded in his own mind.", "words": [[0, 25762], [4, 26016], [8, 26310], [16, 26603], [20, 26823], [24, 27043], [30, 27343], [39, 28194], [47, 28552], [55, 28952], [61, 29312], [65, 29592], [72, 30492], [76, 30694], [82, 31114], [86, 31394], [89, 31534], [95, 31794], [105, 32314], [108, 32674], [112, 32834], [116, 33074]]}, {"verse": 6, "start": 34033, "end": 48449, "text": "He that regards the day, regards it to the Lord; and he that regards not the day, to the Lord he does not regard it. He that eats, eats to the Lord, for he gives God thanks; and he that eats not, to the Lord he eats not, and gives God thanks.", "words": [[0, 34033], [3, 34142], [8, 34262], [16, 34582], [20, 34822], [25, 35262], [33, 35642], [36, 35882], [39, 36022], [43, 36142], [49, 36802], [53, 36964], [56, 37184], [61, 37384], [69, 37764], [73, 38084], [77, 38304], [82, 38544], [85, 38964], [89, 39104], [94, 39364], [97, 39544], [102, 39744], [106, 39944], [113, 40284], [117, 40940], [120, 41097], [125, 41297], [131, 41557], [136, 41777], [139, 42037], [143, 42177], [149, 42757], [153, 42857], [156, 42997], [162, 43257], [166, 43557], [174, 44536], [178, 44678], [181, 44818], [186, 44978], [191, 45178], [196, 45738], [199, 46098], [203, 46218], [208, 46418], [211, 46598], [216, 46758], [221, 47218], [225, 47438], [231, 47618], [235, 47898]]}, {"verse": 7, "start": 48899, "end": 51916, "text": "For none of us lives to himself, and no man dies to himself.", "words": [[0, 48899], [4, 49003], [9, 49203], [12, 49323], [15, 49443], [21, 49603], [24, 49763], [33, 50143], [37, 50583], [40, 50743], [44, 50963], [49, 51223], [52, 51443]]}, {"verse": 8, "start": 52366, "end": 59937, "text": "For whether we live, we live to the Lord; and whether we die, we die to the Lord: whether we live therefore, or die, we are the Lord’s.", "words": [[0, 52366], [4, 52471], [12, 52671], [15, 52831], [21, 53411], [24, 53531], [29, 53671], [32, 53831], [36, 53951], [42, 54691], 