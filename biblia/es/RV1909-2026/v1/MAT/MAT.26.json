{"book": "MAT", "chapter": 26, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 615422, "verses": [{"verse": 1, "start": 300, "end": 7022, "text": "Y aconteció que, cuando hubo acabado Jesús todas estas palabras, dijo a sus discípulos:", "words": [[0, 300], [2, 442], [12, 1242], [17, 1522], [24, 1782], [29, 2202], [37, 2762], [43, 3122], [49, 3862], [55, 4262], [65, 5482], [70, 5822], [72, 5982], [76, 6142]]}, {"verse": 2, "start": 7472, "end": 14490, "text": "Sabéis que dentro de dos días se hace la pascua, y el Hijo del hombre es entregado para ser crucificado.", "words": [[0, 7472], [7, 8074], [11, 8234], [18, 8494], [21, 8774], [25, 8974], [30, 9294], [33, 9614], [38, 9834], [41, 10034], [49, 10894], [51, 11074], [54, 11194], [59, 11474], [63, 11634], [70, 12054], [73, 12274], [83, 12994], [88, 13194], [92, 13434]]}, {"verse": 3, "start": 14940, "end": 26126, "text": "Entonces los príncipes de los sacerdotes, y los escribas, y los ancianos del pueblo se juntaron al patio del sumo sacerdote, el cual se llamaba Caifás;", "words": [[0, 14940], [9, 15425], [13, 16105], [23, 16725], [26, 16845], [30, 16965], [42, 17765], [44, 17905], [48, 18045], [58, 18725], [60, 19345], [64, 19505], [73, 19985], [77, 20105], [84, 20465], [87, 20665], [96, 21205], [99, 21405], [105, 21785], [109, 22005], [114, 22445], [125, 23505], [128, 23585], [133, 23785], [136, 24025], [144, 25108]]}, {"verse": 4, "start": 26576, "end": 31163, "text": "Y tuvieron consejo para prender por engaño a Jesús, y matarle.", "words": [[0, 26576], [2, 26674], [11, 27054], [19, 27734], [24, 28043], [32, 28354], [36, 28694], [43, 29214], [45, 29313], [52, 29654], [54, 30394]]}, {"verse": 5, "start": 31613, "end": 36611, "text": "Y decían: No en el día de la fiesta, porque no se haga alboroto en el pueblo.", "words": [[0, 31613], [2, 31737], [10, 32727], [13, 32932], [16, 33092], [19, 33192], [23, 33412], [26, 33532], [29, 33652], [37, 34392], [44, 34752], [47, 34932], [50, 35132], [55, 35332], [64, 35852], [67, 35972], [70, 36092]]}, {"verse": 6, "start": 36961, "end": 41758, "text": "Y estando Jesús en Betania, en casa de Simón el leproso,", "words": [[0, 36961], [2, 37125], [10, 37505], [16, 37885], [19, 38185], [28, 39345], [31, 39405], [36, 39705], [39, 39965], [45, 40725], [48, 40845]]}, {"verse": 7, "start": 42208, "end": 52686, "text": "Vino a él una mujer, teniendo un frasco de alabastro con perfume muy costoso, y lo derramó sobre la cabeza de él, estando sentado a la mesa.", "words": [[0, 42208], [5, 42513], [7, 42773], [10, 42953], [14, 43213], [21, 44133], [30, 44733], [33, 44893], [40, 45333], [43, 45473], [53, 46053], [57, 46253], [65, 46713], [69, 47133], [78, 47853], [80, 48333], [83, 48473], [91, 49093], [97, 49353], [100, 49553], [107, 49973], [110, 50193], [114, 50993], [122, 51453], [130, 51973], [132, 52053], [135, 52133]]}, {"verse": 8, "start": 53136, "end": 59181, "text": "Lo cual viendo sus discípulos, se enojaron, diciendo: ¿Por qué se pierde esto?", "words": [[0, 53136], [3, 53262], [8, 53522], [15, 53862], [19, 54162], [31, 55262], [34, 55562], [44, 56822], [54, 57946], [59, 58063], [63, 58203], [66, 58323], [73, 58743]]}, {"verse": 9, "start": 59631, "end": 63194, "text": "Porque esto se podía vender por gran precio, y darse a los pobres.", "words": [[0, 59631], [7, 59828], [12, 60148], [15, 60328], [21, 60608], [28, 60948], [32, 61188], [37, 61408], [45, 61808], [47, 62108], [53, 62428], [55, 62468], [59, 62588]]}, {"verse": 10, "start": 63544, "end": 70439, "text": "Y entendiéndolo Jesús, les dijo: ¿Por qué molestáis a esta mujer? pues ha hecho conmigo buena obra.", "words": [[0, 63544], [2, 64035], [16, 64565], [23, 65005], [27, 65445], [33, 66257], [38, 66382], [42, 66642], [52, 67322], [54, 67502], [59, 67642], [66, 68586], [71, 68710], [74, 68870], [80, 69070], [88, 69570], [94, 69830]]}, {"verse": 11, "start": 70889, "end": 75298, "text": "Porque siempre tendréis pobres con vosotros, pero a mí no siempre me tendréis.", "words": [[0, 70889], [7, 71073], [15, 71393], [24, 71993], [31, 72453], [35, 72693], [45, 73393], [50, 73533], [52, 73653], [55, 73793], [58, 73913], [66, 74273], [69, 74513]]}, {"verse": 12, "start": 75748, "end": 81073, "text": "Porque echando este perfume sobre mi cuerpo, para sepultarme lo ha hecho.", "words": [[0, 75748], [7, 76010], [15, 76590], [20, 76810], [28, 77350], [34, 77750], [37, 77990], [45, 78490], [50, 79310], [61, 80110], [64, 80370], [67, 80550]]}, {"verse": 13, "start": 81523, "end": 91607, "text": "De cierto os digo que dondequiera que se predique este evangelio en todo el mundo, también se contará, en memoria de esta mujer, lo que ella ha hecho.", "words": [[0, 81523], [3, 81767], [10, 82047], [13, 82327], [18, 82647], [22, 82907], [34, 83607], [38, 83827], [41, 83987], [50, 84547], [55, 84927], [65, 85687], [68, 85807], [73, 86007], [76, 86207], [83, 86547], [91, 87247], [94, 87567], [103, 88167], [106, 88747], [114, 89207], [117, 89387], [122, 89567], [129, 90007], [132, 90487], [136, 90647], [141, 90927], [144, 91187]]}, {"verse": 14, "start": 92057, "end": 98803, "text": "Entonces uno de los doce, que se llamaba Judas Iscariote, fue a los príncipes de los sacerdotes,", "words": [[0, 92057], [9, 93058], [13, 93438], [16, 93598], [20, 93758], [26, 94158], [30, 94298], [33, 94438], [41, 94838], [47, 95138], [58, 96038], [62, 96598], [64, 96758], [68, 96858], [78, 97458], [81, 97558], [85, 97698]]}, {"verse": 15, "start": 99253, "end": 106231, "text": "Y les dijo: ¿Qué me queréis dar, y yo os lo entregaré? Y ellos le señalaron treinta piezas de plata.", "words": [[0, 99253], [2, 99376], [6, 99496], [12, 100295], [17, 100395], [20, 100495], [28, 100795], [33, 101095], [35, 101475], [38, 101715], [41, 101815], [44, 101895], [55, 102877], [57, 103065], [63, 103395], [66, 103725], [76, 104325], [84, 104925], [91, 105585], [94, 105685]]}, {"verse": 16, "start": 106681, "end": 110904, "text": "Y desde entonces buscaba oportunidad para entregarle.", "words": [[0, 106681], [2, 106805], [8, 106985], [17, 107665], [25, 108585], [37, 109365], [42, 109825]]}, {"verse": 17, "start": 111354, "end": 121681, "text": "Y el primer día de la fiesta de los panes sin levadura, vinieron los discípulos a Jesús, diciéndole: ¿Dónde quieres que preparemos para ti para comer la pascua?", "words": [[0, 111354], [2, 111480], [5, 111600], [12, 111920], [16, 112240], [19, 112420], [22, 112540], [29, 112920], [32, 113060], [36, 113180], [42, 113620], [46, 113920], [56, 114560], [65, 115420], [69, 115640], [80, 116340], [82, 116520], [89, 116860], [101, 118447], [108, 118730], [116, 119030], [120, 119230], [131, 119770], [136, 119990], [139, 120250], [144, 120550], [150, 120870], [153, 121300]]}, {"verse": 18, "start": 122031, "end": 133842, "text": "Y él dijo: Id a la ciudad a cierto hombre, y decidle: El Maestro dice: Mi tiempo está cerca; en tu casa haré la pascua con mis discípulos.", "words": [[0, 122031], [2, 122221], [5, 122361], [11, 123247], [14, 123347], [16, 123427], [19, 123527], [26, 123847], [28, 124127], [35, 124407], [43, 125047], [45, 125759], [54, 126709], [57, 127037], [65, 127617], [71, 128620], [74, 129316], [81, 129576], [86, 129816], [93, 130851], [96, 130977], [99, 131137], [104, 131457], [109, 131877], [112, 131997], [119, 132477], [123, 132657], [127, 132857]]}, {"verse": 19, "start": 134292, "end": 139786, "text": "Y los discípulos hicieron como Jesús les mandó, y prepararon la pascua.", "words": [[0, 134292], [2, 134398], [6, 134538], [17, 135178], [26, 135898], [31, 136158], [37, 136538], [41, 137038], [48, 137678], [50, 138178], [61, 138918], [64, 139078]]}, {"verse": 20, "start": 140236, "end": 144416, "text": "Y como fue la tarde del día, se sentó a la mesa con los doce.", "words": [[0, 140236], [2, 140516], [7, 140776], [11, 141036], [14, 141196], [20, 141536], [24, 141836], [29, 142476], [32, 142596], [38, 143016], [40, 143076], [43, 143156], [48, 143396], [52, 143636], [56, 143816]]}, {"verse": 21, "start": 144866, "end": 150084, "text": "Y comiendo ellos, dijo: De cierto os digo, que uno de vosotros me ha de entregar.", "words": [[0, 144866], [2, 144990], [11, 145450], [18, 145750], [24, 146818], [27, 146984], [34, 147264], [37, 147544], [43, 147784], [47, 148024], [51, 148224], [54, 148404], [63, 148924], [66, 149164], [69, 149264], [72, 149364]]}, {"verse": 22, "start": 150534, "end": 160283, "text": "Y entristecidos ellos en gran manera, comenzó cada uno de ellos a decirle: ¿Soy yo, Señor?", "words": [[0, 150534], [2, 151206], [16, 151896], [22, 152196], [25, 152476], [30, 152696], [38, 153236], [46, 154156], [51, 154376], [55, 154816], [58, 155036], [64, 155336], [66, 155536], [75, 156613], [80, 156973], [84, 157193]]}, {"verse": 23, "start": 160633, "end": 167944, "text": "Entonces él respondiendo, dijo: El que mete la mano conmigo en el plato, ese me ha de entregar.", "words": [[0, 160633], [9, 161109], [12, 161689], [26, 162849], [32, 163725], [35, 164086], [39, 164266], [44, 164546], [47, 164786], [52, 165066], [60, 165686], [63, 165806], [66, 165926], [73, 166546], [77, 166766], [80, 167026], [83, 167146], [86, 167246]]}, {"verse": 24, "start": 168394, "end": 180653, "text": "A la verdad el Hijo del hombre va, como está escrito de él; pero ¡ay de aquel hombre por quien el Hijo del hombre es entregado! bueno le fuera al tal hombre no haber nacido.", "words": [[0, 168394], [2, 168486], [5, 168586], [12, 168966], [15, 169446], [20, 169746], [24, 169886], [31, 170306], [35, 170546], [40, 171046], [45, 171226], [53, 171546], [56, 171886], [60, 172811], [65, 173146], [69, 173516], [72, 173736], [78, 174096], [85, 174376], [89, 174656], [95, 174996], [98, 175356], [103, 175676], [107, 175836], [114, 176176], [117, 176576], [128, 177725], [134, 178110], [137, 178210], [143, 178430], [146, 178830], [150, 179010], [157, 179370], [160, 179650], [166, 179830]]}, {"verse": 25, "start": 181103, "end": 188566, "text": "Entonces respondiendo Judas, que le entregaba, dijo: ¿Soy yo, Maestro? Le dice: Tú lo has dicho.", "words": [[0, 181103], [9, 182165], [22, 183105], [29, 183505], [33, 183865], [36, 184025], [47, 184765], [53, 185445], [58, 185644], [62, 185784], [71, 186783], [74, 186950], [80, 187715], [83, 187842], [86, 187962], [90, 188082]]}, {"verse": 26, "start": 189016, "end": 197490, "text": "Y comiendo ellos, tomó Jesús el pan, y bendijo, y lo partió, y dio a sus discípulos, y dijo: Tomad, comed: esto es mi cuerpo.", "words": [[0, 189016], [2, 189114], [11, 189574], [18, 189834], [23, 190254], [29, 190494], [32, 190834], [37, 191074], [39, 191294], [48, 191994], [50, 192034], [53, 192154], [61, 192814], [63, 192874], [67, 193074], [69, 193234], [73, 193394], [85, 194414], [87, 194494], [93, 195212], [100, 195821], [107, 196722], [112, 196968], [115, 197048], [118, 197269]]}, {"verse": 27, "start": 197940, "end": 204572, "text": "Y tomando la copa, y hechas gracias, les dio, diciendo: Bebed de ella todos;", "words": [[0, 198085], [2, 198531], [10, 198936], [13, 199076], [19, 199536], [21, 199636], [28, 199916], [37, 200856], [41, 201036], [46, 201356], [56, 202965], [62, 203255], [65, 203545], [70, 203835]]}, {"verse": 28, "start": 205022, "end": 211628, "text": "Porque esto es mi sangre del nuevo pacto, la cual es derramada por muchos para perdón de los pecados.", "words": [[0, 205022], [7, 205269], [12, 205709], [15, 205889], [18, 206069], [25, 206489], [29, 206769], [35, 207029], [42, 207989], [45, 208049], [50, 208229], [53, 208409], [63, 209069], [67, 209309], [74, 209709], [79, 210009], [86, 210529], [89, 210669], [93, 210789]]}, {"verse": 29, "start": 212078, "end": 221627, "text": "Y os digo, que desde ahora no beberé más de este fruto de la vid, hasta aquel día, cuando lo beba nuevo con vosotros en el reino de mi Padre.", "words": [[0, 212078], [2, 212204], [5, 212324], [11, 212604], [15, 212844], [21, 213224], [27, 213684], [30, 214064], [37, 214544], [41, 214924], [44, 215304], [49, 215524], [55, 215984], [58, 216144], [61, 216514], [66, 216884], [72, 217164], [78, 217504], [83, 218104], [90, 218264], [93, 218484], [98, 218764], [104, 219024], [108, 219304], [117, 219944], [120, 220224], [123, 220364], [129, 220804], [132, 220944], [135, 221064]]}, {"verse": 30, "start": 222077, "end": 226628, "text": "Y habiendo cantado el himno, salieron al monte de los Olivos.", "words": [[0, 222077], [2, 222205], [11, 222525], [19, 223125], [22, 223285], [29, 224125], [38, 224905], [41, 225145], [47, 225445], [50, 225685], [54, 225825]]}, {"verse": 31, "start": 227078, "end": 238604, "text": "Entonces Jesús les dice: Todos vosotros me abandonaréis esta noche; porque escrito está: Heriré al Pastor, y las ovejas de la manada serán dispersas.", "words": [[0, 227078], [9, 227944], [15, 228484], [19, 228884], [25, 229751], [31, 229914], [40, 230534], [43, 230774], [56, 231614], [61, 231894], [68, 232733], [75, 233197], [83, 233697], [89, 234418], [96, 234893], [99, 235033], [107, 235473], [109, 236053], [113, 236213], [120, 236653], [123, 236773], [126, 236873], [133, 237253], [139, 237633]]}, {"verse": 32, "start": 239054, "end": 243737, "text": "Pero después que haya resucitado, iré delante de vosotros a Galilea.", "words": [[0, 239054], [5, 239196], [13, 239536], [17, 239716], [22, 239916], [34, 240896], [38, 241596], [46, 242016], [49, 242196], [58, 242716], [60, 242976]]}, {"verse": 33, "start": 244187, "end": 249699, "text": "Y respondiendo Pedro, le dijo: Aunque todos te abandonen, yo nunca te abandonaré.", "words": [[0, 244187], [2, 244468], [15, 245408], [22, 245708], [25, 245928], [31, 246744], [38, 246960], [44, 247280], [47, 247480], [58, 248280], [61, 248540], [67, 248800], [70, 249020]]}, {"verse": 34, "start": 250049, "end": 258410, "text": "Jesús le dice: De cierto te digo que esta noche, antes que el gallo cante, me negarás tres veces.", "words": [[0, 250049], [6, 250421], [9, 250941], [15, 251812], [18, 251979], [25, 252279], [28, 252679], [33, 252999], [37, 253199], [42, 253479], [49, 254199], [55, 254799], [59, 255019], [62, 255239], [68, 255599], [75, 256279], [78, 256479], [86, 257019], [91, 257399]]}, {"verse": 35, "start": 258860, "end": 266120, "text": "Le dice Pedro: Aunque me sea necesario morir contigo, no te negaré. Y todos los discípulos dijeron lo mismo.", "words": [[0, 258860], [3, 258965], [8, 259225], [15, 260066], [22, 260268], [25, 260468], [29, 260668], [39, 261208], [45, 261608], [54, 262388], [57, 262588], [60, 262748], [68, 263644], [70, 263769], [76, 264049], [80, 264329], [91, 264969], [99, 265549], [102, 265649]]}, {"verse": 36, "start": 266570, "end": 275519, "text": "Entonces llegó Jesús con ellos al lugar llamado Getsemaní, y dice a sus discípulos: Sentaos aquí, hasta que vaya allí y ore.", "words": [[0, 266570], [9, 267019], [15, 267439], [21, 267799], [25, 268079], [31, 268279], [34, 268539], [40, 268859], [48, 269319], [59, 270679], [61, 270979], [66, 271219], [68, 271379], [72, 271519], [84, 272851], [92, 273151], [98, 273511], [104, 274011], [108, 274211], [113, 274431], [118, 274831], [120, 275091]]}, {"verse": 37, "start": 275969, "end": 283528, "text": "Y tomando a Pedro, y a los dos hijos de Zebedeo, comenzó a entristecerse y a angustiarse en gran manera.", "words": [[0, 275969], [2, 276112], [10, 276492], [12, 276612], [19, 277032], [21, 277552], [23, 277612], [27, 277772], [31, 277932], [37, 278312], [40, 278732], [49, 279152], [57, 280072], [59, 280232], [73, 281352], [75, 281612], [77, 281732], [89, 282492], [92, 282612], [97, 282792]]}, {"verse": 38, "start": 283978, "end": 291264, "text": "Entonces Jesús les dice: Mi alma está muy triste hasta la muerte; quedaos aquí, y velad conmigo.", "words": [[0, 283978], [9, 284549], [15, 285149], [19, 285749], [25, 286659], [28, 286770], [33, 286990], [38, 287270], [42, 287470], [49, 287870], [55, 288090], [58, 288250], [66, 289172], [74, 289653], [80, 289953], [82, 290213], [88, 290533]]}, {"verse": 39, "start": 291714, "end": 304023, "text": "Y yéndose un poco más adelante, se postró sobre su rostro, orando, y diciendo: Padre mío, si es posible, pase de mí esta copa; pero no como yo quiero, sino como tú.", "words": [[0, 291881], [2, 292081], [10, 292281], [13, 292421], [18, 292641], [22, 292881], [32, 293421], [35, 293661], [42, 294221], [48, 294481], [51, 294701], [59, 295341], [67, 296141], [69, 296441], [79, 297487], [85, 297831], [90, 298531], [93, 298651], [96, 298791], [105, 299711], [110, 300191], [113, 300431], [116, 300651], [121, 300891], [127, 301792], [132, 301961], [135, 302181], [140, 302401], [143, 302581], [151, 302941], [156, 303241], [161, 303541]]}, {"verse": 40, "start": 304473, "end": 311684, "text": "Y vino a sus discípulos, y los halló durmiendo, y dijo a Pedro: ¿Así no habéis podido velar conmigo una hora?", "words": [[0, 304473], [2, 304796], [7, 305016], [9, 305176], [13, 305356], [25, 306036], [27, 306516], [31, 306656], [37, 306996], [48, 307576], [50, 307676], [55, 307876], [57, 308016], [64, 308753], [69, 309093], [72, 309313], [79, 309613], [86, 310013], [92, 310373], [100, 310953], [104, 311133]]}, {"verse": 41, "start": 312134, "end": 319656, "text": "Velad y orad, para que no entréis en tentación: el espíritu está dispuesto, pero la carne es débil.", "words": [[0, 312134], [6, 312602], [8, 312822], [14, 313142], [19, 313422], [23, 313582], [26, 313782], [34, 314242], [37, 314442], [48, 315612], [51, 315932], [60, 316512], [65, 316692], [76, 317912], [81, 318192], [84, 318372], [90, 318732], [93, 318992]]}, {"verse": 42, "start": 320106, "end": 329787, "text": "Otra vez fue, segunda vez, y oró diciendo: Padre mío, si no puede esta copa pasar de mí sin que yo la beba, hágase tu voluntad.", "words": [[0, 320106], [5, 320357], [9, 320697], [14, 320897], [22, 321317], [27, 321777], [29, 322237], [33, 322697], [43, 323990], [49, 324275], [54, 324715], [57, 324815], [60, 325035], [66, 325255], [71, 325535], [76, 325955], [82, 326255], [85, 326475], [88, 326635], [92, 326855], [96, 327075], [99, 327255], [102, 327415], [108, 328255], [115, 328675], [118, 328875]]}, {"verse": 43, "start": 330237, "end": 336142, "text": "Y vino, y los halló otra vez durmiendo; porque tenían los ojos pesados de sueño.", "words": [[0, 330237], [2, 330363], [8, 330703], [10, 331263], [14, 331443], [20, 331883], [25, 332143], [29, 332403], [40, 333568], [47, 333872], [54, 334212], [58, 334392], [63, 334712], [71, 335292], [74, 335492]]}, {"verse": 44, "start": 336592, "end": 343074, "text": "Y dejándolos se fue de nuevo y oró por tercera vez, diciendo las mismas palabras.", "words": [[0, 336592], [2, 336739], [13, 337799], [16, 338039], [20, 338239], [23, 338399], [29, 338719], [31, 339079], [35, 339399], [39, 339619], [47, 340239], [52, 340999], [61, 341379], [65, 341779], [72, 342259]]}, {"verse": 45, "start": 343524, "end": 355655, "text": "Entonces vino a sus discípulos y les dice: Dormid ya, y descansad: he aquí ha llegado la hora, y el Hijo del hombre es entregado en manos de pecadores.", "words": [[0, 343524], [9, 344406], [14, 345146], [16, 345366], [20, 345546], [31, 346346], [33, 346526], [37, 346646], [43, 347625], [50, 347795], [54, 348235], [56, 348890], [67, 349787], [70, 349954], [75, 350374], [78, 350614], [86, 351094], [89, 351274], [95, 351854], [97, 352254], [100, 352394], [105, 352674], [109, 352834], [116, 353254], [119, 353374], [129, 354054], [132, 354174], [138, 354454], [141, 354674]]}, {"verse": 46, "start": 356105, "end": 360562, "text": "Levantaos, vamos: he aquí ha llegado el que me ha entregado.", "words": [[0, 356105], [11, 357213], [18, 358176], [21, 358321], [26, 358541], [29, 358681], [37, 359121], [40, 359281], [44, 359461], [47, 359641], [50, 359741]]}, {"verse": 47, "start": 361012, "end": 375116, "text": "Y hablando aún él, he aquí Judas, uno de los doce, vino, y con él mucha gente con espadas y con palos, de parte de los príncipes de los sacerdotes, y de los ancianos del pueblo.", "words": [[0, 361012], [2, 361149], [11, 361409], [15, 361849], [19, 362349], [22, 363089], [27, 363329], [34, 364489], [38, 364809], [41, 364989], [45, 365129], [51, 366209], [57, 366529], [59, 367149], [63, 367389], [66, 367549], [72, 367789], [78, 368209], [82, 368449], [90, 368989], [92, 369189], [96, 369389], [103, 370049], [106, 370429], [112, 370689], [115, 370929], [119, 371069], [129, 371809], [132, 371929], [136, 372069], [148, 373357], [150, 373480], [153, 373580], [157, 373700], [166, 374300], [170, 374460]]}, {"verse": 48, "start": 375566, "end": 383397, "text": "Y el que le entregaba les había dado señal, diciendo: Al que yo bese, aquel es: prendedle.", "words": [[0, 375566], [2, 375709], [5, 375849], [9, 376029], [12, 376229], [22, 377009], [26, 377369], [32, 377789], [37, 378049], [44, 379269], [54, 380392], [57, 380576], [61, 380676], [64, 381056], [70, 381436], [76, 381956], [80, 382691]]}, {"verse": 49, "start": 383747, "end": 388712, "text": "Y luego que llegó a Jesús, dijo: Salve, Maestro. Y le besó.", "words": [[0, 383747], [2, 383891], [8, 384071], [12, 384351], [18, 384631], [20, 384791], [27, 385651], [33, 386511], [40, 386910], [49, 387874], [51, 388016], [54, 388136]]}, {"verse": 50, "start": 389162, "end": 397544, "text": "Y Jesús le dijo: Amigo, ¿a qué vienes? Entonces llegaron, y echaron mano a Jesús, y le prendieron.", "words": [[0, 389162], [2, 389309], [8, 389709], [11, 390049], [17, 390887], [24, 391472], [27, 391572], [31, 391672], [39, 392644], [48, 393132], [58, 394132], [60, 394452], [68, 394932], [73, 395272], [75, 395472], [82, 395812], [84, 396492], [87, 396612]]}, {"verse": 51, "start": 397994, "end": 408279, "text": "Y he aquí, uno de los que estaban con Jesús, extendiendo la mano, sacó su espada, e hiriendo a un siervo del sumo sacerdote, le quitó la oreja.", "words": [[0, 397994], [2, 398172], [5, 398272], [11, 398532], [15, 398832], [18, 398992], [22, 399112], [26, 399252], [34, 399552], [38, 399812], [45, 400692], [57, 401452], [60, 401612], [66, 402512], [71, 402852], [74, 402992], [82, 403532], [84, 403952], [93, 404512], [95, 404712], [98, 404832], [105, 405392], [109, 405552], [114, 406072], [125, 407112], [128, 407212], [134, 407572], [137, 407692]]}, {"verse": 52, "start": 408729, "end": 418023, "text": "Entonces Jesús le dice: Vuelve tu espada a su lugar; porque todos los que tomen espada, a espada perecerán.", "words": [[0, 408729], [9, 409318], [15, 409998], [18, 410498], [24, 411333], [31, 411719], [34, 411879], [41, 412439], [43, 412679], [46, 412859], [53, 413740], [60, 413922], [66, 414362], [70, 414662], [74, 414802], [80, 415182], [88, 416042], [90, 416282], [97, 416902]]}, {"verse": 53, "start": 418473, "end": 425027, "text": "¿Acaso piensas que no puedo ahora orar a mi Padre, y él me daría más de doce legiones de ángeles?", "words": [[0, 418473], [7, 418984], [15, 419404], [19, 419544], [22, 419724], [28, 420084], [34, 420474], [39, 420864], [41, 420944], [44, 421084], [51, 421504], [53, 422084], [56, 422304], [59, 422484], [65, 422884], [69, 423064], [72, 423391], [77, 423717], [86, 424044], [89, 424264]]}, {"verse": 54, "start": 425477, "end": 430032, "text": "¿Cómo, pues, se cumplirían las Escrituras, que así conviene que sea hecho?", "words": [[0, 425477], [7, 425891], [13, 426331], [16, 426851], [27, 427491], [31, 427671], [43, 428331], [47, 428491], [51, 428651], [60, 429111], [64, 429231], [68, 429471]]}, {"verse": 55, "start": 430482, "end": 442273, "text": "En aquella hora dijo Jesús a la gente: ¿Como a ladrón habéis salido con espadas y con palos a prenderme? Cada día me sentaba con vosotros enseñando en el templo, y no me prendisteis.", "words": [[0, 430482], [3, 430623], [11, 431003], [16, 431223], [21, 431523], [27, 431863], [29, 432143], [32, 432203], [39, 433038], [45, 433182], [47, 433362], [54, 433722], [61, 434022], [68, 434462], [72, 434662], [80, 435122], [82, 435302], [86, 435502], [92, 435982], [94, 436122], [105, 437105], [110, 437249], [114, 437549], [117, 437709], [125, 438169], [129, 438369], [138, 438909], [148, 439769], [151, 439869], [154, 440029], [162, 440789], [164, 440949], [167, 441069], [170, 441209]]}, {"verse": 56, "start": 442723, "end": 452302, "text": "Pero todo esto se hace, para que se cumplan las Escrituras de los profetas. Entonces todos los discípulos huyeron, dejándole.", "words": [[0, 442723], [5, 442865], [10, 443165], [15, 443485], [18, 443765], [24, 444145], [29, 444845], [33, 445025], [36, 445185], [44, 445805], [48, 446065], [59, 446765], [62, 446885], [66, 447005], [76, 448106], [85, 448710], [91, 449450], [95, 449730], [106, 450450], [115, 451350]]}, {"verse": 57, "start": 452752, "end": 461326, "text": "Y ellos, prendido Jesús, le llevaron al sumo sacerdote Caifás, donde los escribas y los ancianos estaban juntos.", "words": [[0, 452752], [2, 452932], [9, 453482], [18, 454032], [25, 454622], [28, 455212], [37, 455692], [40, 455832], [45, 456432], [55, 457172], [63, 458092], [69, 458332], [73, 458612], [82, 459232], [84, 459392], [88, 459552], [97, 460132], [105, 460472]]}, {"verse": 58, "start": 461776, "end": 471172, "text": "Pero Pedro le seguía de lejos hasta el patio del sumo sacerdote; y entrando dentro, se estaba sentado con los criados, para ver el fin.", "words": [[0, 461776], [5, 462016], [11, 462316], [14, 462536], [21, 462936], [24, 463036], [30, 463356], [36, 463616], [39, 463796], [45, 464156], [49, 464356], [54, 464876], [65, 466057], [67, 466201], [76, 466761], [84, 467101], [87, 467421], [94, 467761], [102, 468401], [106, 468581], [110, 468761], [119, 469881], [124, 470161], [128, 470361], [131, 470521]]}, {"verse": 59, "start": 471622, "end": 481878, "text": "Y los príncipes de los sacerdotes, y los ancianos, y todo el consejo, buscaban falso testimonio contra Jesús, para entregarle a la muerte;", "words": [[0, 471622], [2, 471749], [6, 471869], [16, 472709], [19, 472829], [23, 472989], [35, 473869], [37, 474269], [41, 474449], [51, 475169], [53, 475549], [58, 475789], [61, 475969], [70, 476689], [79, 477469], [85, 477969], [96, 478769], [103, 479129], [110, 479589], [115, 480369], [126, 481129], [128, 481209], [131, 481289]]}, {"verse": 60, "start": 482328, "end": 489073, "text": "Y no lo hallaron, aunque muchos testigos falsos se llegaban; pero al fin vinieron dos testigos falsos,", "words": [[0, 482328], [2, 482450], [5, 482610], [8, 482750], [18, 483490], [25, 483670], [32, 484030], [41, 484570], [48, 485110], [51, 485250], [61, 486321], [66, 486483], [69, 486603], [73, 486803], [82, 487323], [86, 487603], [95, 488203]]}, {"verse": 61, "start": 489523, "end": 494757, "text": "Que dijeron: Este dijo: Puedo derribar el templo de Dios, y en tres días reedificarlo.", "words": [[0, 489523], [4, 489627], [13, 490581], [18, 490801], [24, 491554], [30, 491743], [39, 492223], [42, 492323], [49, 492703], [52, 492743], [58, 492983], [60, 493263], [63, 493383], [68, 493583], [73, 494193]]}, {"verse": 62, "start": 495107, "end": 502064, "text": "Y levantándose el sumo sacerdote, le dijo: ¿No respondes nada? ¿qué testifican estos contra ti?", "words": [[0, 495107], [2, 495232], [15, 496192], [18, 496412], [23, 496892], [34, 497932], [37, 498112], [43, 498847], [47, 498993], [57, 499553], [63, 500336], [68, 500432], [79, 501072], [85, 501272], [92, 501672]]}, {"verse": 63, "start": 502414, "end": 511732, "text": "Pero Jesús callaba. Respondiendo el sumo sacerdote, le dijo: Te conjuro por el Dios viviente, que nos digas si eres tú el Cristo, Hijo de Dios.", "words": [[0, 502414], [5, 502582], [11, 502902], [20, 504473], [33, 504833], [36, 504973], [41, 505393], [52, 506193], [55, 506253], [61, 507060], [64, 507160], [72, 507660], [76, 507840], [79, 507960], [84, 508140], [94, 508660], [98, 508840], [102, 509110], [108, 509380], [111, 509560], [116, 509800], [119, 510040], [122, 510200], [130, 510880], [135, 511020], [138, 511180]]}, {"verse": 64, "start": 512082, "end": 525614, "text": "Jesús le dijo: Tú lo has dicho: y aun os digo, que desde ahora habéis de ver al Hijo del hombre sentado a la diestra del poder de Dios, y que viene en las nubes del cielo.", "words": [[0, 512082], [6, 512555], [9, 512995], [15, 513847], [18, 513972], [21, 514112], [25, 514252], [32, 515057], [34, 515179], [38, 515379], [41, 515599], [47, 516459], [51, 516679], [57, 516939], [63, 517379], [70, 517919], [73, 518099], [77, 518279], [80, 518439], [85, 518719], [89, 518919], [96, 519279], [104, 519959], [106, 520099], [109, 520179], [117, 520639], [121, 520879], [127, 521279], [130, 521579], [136, 521979], [138, 522839], [142, 522999], [148, 523359], [151, 523699], [155, 523879], [161, 524619], [165, 524899]]}, {"verse": 65, "start": 526064, "end": 537289, "text": "Entonces el sumo sacerdote rasgó sus vestidos, diciendo: Ha blasfemado: ¿qué más necesidad tenemos de testigos? He aquí, ahora habéis oído su blasfemia.", "words": [[0, 526064], [9, 527303], [12, 527423], [17, 527803], [27, 528483], [33, 529383], [37, 529583], [47, 530263], [57, 531771], [60, 532125], [72, 532730], [77, 532835], [81, 533015], [91, 533635], [99, 533955], [102, 534155], [112, 535204], [115, 535274], [121, 535494], [127, 535794], [134, 536134], [139, 536394], [142, 536554]]}, {"verse": 66, "start": 537739, "end": 542441, "text": "¿Qué os parece? Y respondiendo ellos, dijeron: Culpado es de muerte.", "words": [[0, 537739], [5, 537836], [8, 537936], [16, 538846], [18, 539241], [31, 539671], [38, 540211], [47, 541115], [55, 541598], [58, 541718], [61, 541858]]}, {"verse": 67, "start": 542791, "end": 550525, "text": "Entonces le escupieron en el rostro, y le dieron de bofetadas; y otros le herían con puñetazos,", "words": [[0, 542791], [9, 543332], [12, 544032], [23, 544712], [26, 544912], [29, 545072], [37, 545652], [39, 546032], [42, 546152], [49, 546662], [52, 547172], [63, 547924], [65, 548069], [71, 548369], [74, 548869], [81, 549209], [85, 549429]]}, {"verse": 68, "start": 550975, "end": 555052, "text": "Diciendo: Profetízanos tú, Cristo, quién es el que te ha herido.", "words": [[0, 550975], [10, 552588], [23, 552908], [27, 553068], [35, 553848], [41, 554008], [44, 554168], [47, 554288], [51, 554408], [54, 554548], [57, 554628]]}, {"verse": 69, "start": 555402, "end": 564427, "text": "Y Pedro estaba sentado fuera en el patio: y se llegó a él una criada, diciendo: Y tú con Jesús el galileo estabas.", "words": [[0, 555402], [2, 555528], [8, 555868], [15, 556268], [23, 556928], [29, 557208], [32, 557468], [35, 557608], [42, 558647], [44, 558900], [47, 559020], [53, 559360], [55, 559540], [58, 559700], [62, 559980], [70, 560640], [80, 561774], [82, 561925], [85, 562085], [89, 562325], [95, 562785], [98, 563205], [106, 563725]]}, {"verse": 70, "start": 564777, "end": 569477, "text": "Pero él negó delante de todos, diciendo: No sé lo que dices.", "words": [[0, 564777], [5, 564939], [8, 565179], [13, 565579], [21, 565999], [24, 566179], [31, 567079], [41, 568230], [44, 568414], [47, 568654], [50, 568794], [54, 568914]]}, {"verse": 71, "start": 569827, "end": 577981, "text": "Y saliendo él a la puerta, le vio otra, y dijo a los que estaban allí: También este estaba con Jesús nazareno.", "words": [[0, 569827], [2, 569932], [11, 570392], [14, 570592], [16, 570672], [19, 570792], [27, 571292], [30, 572072], [34, 572312], [40, 572772], [42, 573452], [47, 573752], [49, 573912], [53, 574032], [57, 574172], [65, 574512], [71, 575286], [79, 575586], [84, 575866], [91, 576166], [95, 576406], [101, 576686]]}, {"verse": 72, "start": 578331, "end": 584984, "text": "Y negó otra vez con juramento: No conozco al hombre.", "words": [[0, 578331], [2, 578455], [7, 578795], [12, 579275], [16, 579775], [20, 580195], [31, 581507], [34, 581662], [42, 582102], [45, 582222]]}, {"verse": 73, "start": 585334, "end": 594723, "text": "Y un poco después llegaron los que estaban por allí, y dijeron a Pedro: Verdaderamente también tú eres de ellos, porque aun tu habla te hace manifiesto.", "words": [[0, 585334], [2, 585453], [5, 585573], [10, 585793], [18, 586693], [27, 587313], [31, 587473], [35, 587593], [43, 587873], [47, 588153], [53, 588453], [55, 589013], [63, 589433], [65, 589513], [72, 590338], [87, 591023], [95, 591323], [98, 591663], [103, 591883], [106, 592043], [113, 592603], [120, 593003], [124, 593223], [127, 593423], [133, 593643], [136, 593883], [141, 594043]]}, {"verse": 74, "start": 595073, "end": 604359, "text": "Entonces comenzó a maldecir, y a jurar, diciendo: No conozco al hombre. Y el gallo cantó luego.", "words": [[0, 595073], [9, 595503], [17, 596243], [19, 596303], [29, 596843], [31, 597043], [33, 597163], [40, 597603], [50, 598830], [53, 598985], [61, 599425], [64, 599545], [72, 602658], [74, 602784], [77, 602994], [83, 603204], [89, 603764]]}, {"verse": 75, "start": 604809, "end": 615022, "text": "Y se acordó Pedro de las palabras de Jesús, que le dijo: Antes que cante el gallo, me negarás tres veces. Y saliendo fuera, lloró amargamente.", "words": [[0, 604809], [2, 604948], [5, 605068], [12, 605548], [18, 606048], [21, 606268], [25, 606408], [34, 606768], [37, 606988], [44, 607348], [48, 607648], [51, 607788], [57, 608564], [63, 609024], [67, 609224], [73, 609644], [76, 609704], [83, 610204], [86, 610524], [94, 610844], [99, 611084], [106, 611969], [108, 612075], [117, 612535], [124, 612915], [130, 613755]]}]}