, 142705], [15, 142785], [21, 144172], [29, 144372], [33, 144552], [38, 144692], [48, 145072], [51, 145192], [55, 145272], [61, 145532], [64, 145692], [69, 145812], [75, 146512], [79, 146832], [84, 146952], [90, 147172], [93, 147352], [97, 147452], [103, 147812], [106, 148172], [112, 148332], [114, 148452], [124, 148852], [129, 149292], [137, 150232], [141, 150372], [147, 150572], [151, 150752], [155, 150932], [158, 151072], [162, 151934], [169, 152273], [172, 152433], [176, 152573], [183, 152833], [187, 153053], [192, 153153], [198, 154216], [201, 154353], [208, 154713], [214, 155053], [218, 155233], [222, 155433], [225, 155553], [228, 155653], [232, 155913], [236, 156073], [241, 156313], [244, 156433], [249, 156533]]}, {"verse": 18, "start": 157647, "end": 163041, "text": "Thorns also and thistles shall it bring forth to you; and you shall eat the herb of the field;", "words": [[0, 157647], [7, 157909], [12, 158529], [16, 158629], [25, 158989], [31, 159229], [34, 159349], [40, 159529], [46, 159789], [49, 160029], [54, 160850], [58, 161002], [62, 161122], [68, 161322], [72, 161562], [76, 161742], [81, 161982], [84, 162142], [88, 162222]]}, {"verse": 19, "start": 163491, "end": 172579, "text": "In the sweat of your face shall you eat bread, till you return to the ground; for out of it were you taken: for dust you are, and to dust shall you return.", "words": [[0, 163491], [3, 163614], [7, 163714], [13, 163914], [16, 164054], [21, 164174], [26, 164454], [32, 164694], [36, 164834], [40, 165014], [47, 165314], [52, 165754], [56, 165914], [63, 166254], [66, 166394], [70, 166474], [78, 167589], [82, 167676], [86, 167916], [89, 168056], [92, 168196], [97, 168336], [101, 168476], [108, 169587], [112, 169665], [117, 169925], [121, 170185], [126, 170805], [130, 170865], [133, 170985], [138, 171245], [144, 171565], [148, 171705]]}, {"verse": 20, "start": 172929, "end": 177566, "text": "And Adam called his wife’s name Eve; because she was the mother of all living.", "words": [