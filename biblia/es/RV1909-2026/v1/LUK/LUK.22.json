{"book": "LUK", "chapter": 22, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 505851, "verses": [{"verse": 1, "start": 300, "end": 5579, "text": "Y estaba cerca el día de la fiesta de los panes sin levadura, que se llama la Pascua.", "words": [[0, 300], [2, 385], [9, 665], [15, 1025], [18, 1305], [22, 1465], [25, 1625], [28, 1745], [35, 2125], [38, 2265], [42, 2385], [48, 2825], [52, 3185], [62, 4265], [66, 4385], [69, 4505], [75, 4765], [78, 4925]]}, {"verse": 2, "start": 5929, "end": 12924, "text": "Y los principales sacerdotes y los escribas buscaban cómo le matarían; pero tenían miedo del pueblo.", "words": [[0, 5929], [2, 5994], [6, 6134], [18, 6794], [29, 7594], [31, 7774], [35, 7894], [44, 8514], [53, 9334], [58, 9654], [61, 9794], [71, 10828], [76, 11192], [83, 11532], [89, 11972], [93, 12192]]}, {"verse": 3, "start": 13274, "end": 20502, "text": "Y entró Satanás en Judas, por sobrenombre Iscariote, el cual era uno del número de los doce;", "words": [[0, 13274], [2, 13436], [8, 13856], [16, 14416], [19, 14556], [26, 15616], [30, 15736], [42, 16696], [53, 18016], [56, 18116], [61, 18336], [65, 18596], [69, 18856], [73, 19056], [80, 19456], [83, 19676], [87, 19836]]}, {"verse": 4, "start": 20852, "end": 27441, "text": "Y fue, y habló con los principales sacerdotes, y con los jefes de la guardia, de cómo se lo entregaría.", "words": [[0, 20852], [2, 21016], [7, 21196], [9, 21476], [15, 21836], [19, 21956], [23, 22076], [35, 22876], [47, 23816], [49, 24021], [53, 24181], [57, 24321], [63, 24721], [66, 24801], [69, 24901], [78, 25801], [81, 25881], [86, 26121], [89, 26381], [92, 26501]]}, {"verse": 5, "start": 27792, "end": 31311, "text": "Los cuales se alegraron, y acordaron darle dinero.", "words": [[0, 27792], [4, 27900], [11, 28160], [14, 28460], [25, 29180], [27, 29680], [37, 30280], [43, 30520]]}, {"verse": 6, "start": 31661, "end": 38791, "text": "Y prometió, y buscaba oportunidad para entregarle a ellos sin la multitud presente.", "words": [[0, 31661], [2, 31825], [12, 32945], [14, 33165], [22, 33645], [34, 34525], [39, 35025], [50, 35885], [52, 36005], [58, 36365], [62, 36945], [65, 37225], [74, 37785]]}, {"verse": 7, "start": 39141, "end": 45761, "text": "Y vino el día de los panes sin levadura, en el cual era necesario sacrificar el cordero de la Pascua.", "words": [[0, 39141], [2, 39246], [7, 39466], [10, 39646], [14, 39826], [17, 39966], [21, 40106], [27, 40546], [31, 40786], [41, 41806], [44, 41966], [47, 42086], [52, 42306], [56, 42686], [66, 43326], [77, 44166], [80, 44286], [88, 44826], [91, 44966], [94, 45066]]}, {"verse": 8, "start": 46111, "end": 51249, "text": "Y envió a Pedro y a Juan, diciendo: Id, preparadnos la pascua para que comamos.", "words": [[0, 46111], [2, 46271], [8, 46691], [10, 46831], [16, 47131], [18, 47391], [20, 47471], [26, 47741], [36, 48358], [40, 48488], [52, 49508], [55, 49648], [62, 50168], [67, 50348], [71, 50508]]}, {"verse": 9, "start": 51599, "end": 54868, "text": "Y ellos le dijeron: ¿Dónde quieres que preparemos?", "words": [[0, 51599], [2, 51747], [8, 52047], [11, 52387], [20, 53287], [27, 53574], [35, 53874], [39, 54054]]}, {"verse": 10, "start": 55148, "end": 64496, "text": "Y él les dijo: He aquí cuando entréis en la ciudad, os encontrará un hombre que lleva un cántaro de agua: seguidle hasta la casa donde entre,", "words": [[0, 55148], [2, 55344], [5, 55484], [9, 55684], [15, 56505], [18, 56585], [23, 56805], [30, 57085], [38, 57685], [41, 57845], [44, 57985], [52, 58345], [55, 58725], [66, 59445], [69, 59625], [76, 59865], [80, 60045], [86, 60305], [89, 60525], [97, 61085], [100, 61285], [106, 61982], [115, 62621], [121, 62961], [124, 63161], [129, 63401], [135, 63721]]}, {"verse": 11, "start": 64846, "end": 73027, "text": "Y decid al dueño de la casa: El Maestro te dice: ¿Dónde está el aposento donde tengo de comer la pascua con mis discípulos?", "words": [[0, 64846], [2, 64967], [8, 65287], [11, 65707], [17, 66107], [20, 66207], [23, 66327], [29, 67203], [32, 67353], [40, 67893], [43, 68073], [49, 68824], [56, 69212], [61, 69412], [64, 69572], [73, 70052], [79, 70292], [85, 70672], [88, 70832], [94, 71092], [97, 71422], [104, 71752], [108, 71892], [112, 72092]]}, {"verse": 12, "start": 73377, "end": 79501, "text": "Entonces él os mostrará una gran sala amueblada en el piso de arriba; preparad allí.", "words": [[0, 73377], [9, 74064], [12, 74464], [15, 74709], [24, 75329], [28, 75489], [33, 75709], [38, 76229], [48, 76749], [51, 76909], [54, 77049], [59, 77549], [62, 77689], [70, 78535], [79, 79023]]}, {"verse": 13, "start": 79851, "end": 84399, "text": "Fueron pues, y hallaron como les había dicho; y prepararon la pascua.", "words": [[0, 79851], [7, 80137], [13, 80577], [15, 80902], [24, 81322], [29, 81682], [33, 81902], [39, 82242], [46, 83112], [48, 83221], [59, 83901], [62, 84150]]}, {"verse": 14, "start": 84749, "end": 89231, "text": "Y como fue hora, se sentó a la mesa, y con él los apóstoles.", "words": [[0, 84749], [2, 85072], [7, 85292], [11, 85702], [17, 86112], [20, 86212], [26, 86632], [28, 86712], [31, 86792], [37, 87072], [39, 87512], [43, 87752], [46, 87952], [50, 88212]]}, {"verse": 15, "start": 89581, "end": 95876, "text": "Y les dijo: En gran manera he deseado comer con vosotros esta pascua antes que padezca;", "words": [[0, 89581], [2, 89705], [6, 89845], [12, 90576], [15, 90743], [20, 90983], [27, 91463], [30, 91663], [38, 92203], [44, 92543], [48, 92803], [57, 93503], [62, 93883], [69, 94403], [75, 94843], [79, 95103]]}, {"verse": 16, "start": 96226, "end": 101816, "text": "Porque os digo que no comeré más de ella, hasta que se cumpla en el reino de Dios.", "words": [[0, 96226], [7, 96619], [10, 96779], [15, 96999], [19, 97179], [22, 97339], [29, 97779], [33, 98039], [36, 98259], [42, 98579], [48, 99059], [52, 99239], [55, 99379], [62, 100019], [65, 100499], [68, 100659], [74, 101059], [77, 101219]]}, {"verse": 17, "start": 102166, "end": 108572, "text": "Y tomando la copa, habiendo dado gracias, dijo: Tomad esto, y repartidlo entre vosotros;", "words": [[0, 102166], [2, 102311], [10, 102791], [13, 102971], [19, 103571], [28, 103911], [33, 104171], [42, 105011], [48, 105813], [54, 106197], [60, 106577], [62, 107049], [73, 107522], [79, 107942]]}, {"verse": 18, "start": 108922, "end": 114431, "text": "Porque os digo, que no beberé más del fruto de la vid, hasta que el reino de Dios venga.", "words": [[0, 108922], [7, 109143], [10, 109283], [16, 109503], [20, 109883], [23, 110083], [30, 110563], [34, 110783], [38, 111173], [44, 111563], [47, 111683], [50, 111843], [55, 112003], [61, 112523], [65, 112703], [68, 112843], [74, 113223], [77, 113383], [82, 113623]]}, {"verse": 19, "start": 114781, "end": 125592, "text": "Y tomando el pan, habiendo dado gracias, partió, y les dio, diciendo: Esto es mi cuerpo, que por vosotros es dado: haced esto en memoria de mí.", "words": [[0, 114781], [2, 114898], [10, 115318], [13, 115478], [18, 116018], [27, 116558], [32, 116818], [41, 117858], [49, 118538], [51, 119018], [55, 119198], [60, 119660], [70, 120702], [75, 120895], [78, 121035], [81, 121135], [89, 121495], [93, 121755], [97, 121975], [106, 122535], [109, 122735], [115, 123643], [121, 123843], [126, 124403], [129, 124583], [137, 125063], [140, 125243]]}, {"verse": 20, "start": 125942, "end": 136535, "text": "Asimismo también la copa, después que hubo cenado, diciendo: Esta copa es el nuevo pacto en mi sangre, que por vosotros se derrama.", "words": [[0, 126203], [9, 126493], [17, 127492], [20, 127656], [26, 128096], [34, 128376], [38, 128576], [43, 128976], [51, 129376], [61, 130879], [66, 131141], [71, 131681], [74, 131821], [77, 132001], [83, 132341], [89, 133041], [92, 133141], [95, 133301], [103, 133721], [107, 134201], [111, 134961], [120, 135501], [123, 135761]]}, {"verse": 21, "start": 136885, "end": 141047, "text": "Con todo eso, he aquí la mano del que me entrega, conmigo en la mesa.", "words": [[0, 136885], [4, 137027], [9, 137307], [14, 137647], [17, 137967], [22, 138247], [25, 138407], [30, 138587], [34, 138767], [38, 138947], [41, 139127], [50, 139807], [58, 140267], [61, 140367], [64, 140487]]}, {"verse": 22, "start": 141397, "end": 149231, "text": "Y a la verdad el Hijo del hombre va, según lo que está determinado; pero ¡ay de aquel hombre por el cual es entregado!", "words": [[0, 141397], [2, 141494], [4, 141534], [7, 141654], [14, 142094], [17, 142634], [22, 142934], [26, 143094], [33, 143474], [37, 143674], [43, 144134], [46, 144434], [50, 144574], [55, 144794], [68, 146004], [73, 146292], [77, 146612], [80, 146832], [86, 147112], [93, 147352], [97, 147652], [100, 147792], [105, 148032], [108, 148292]]}, {"verse": 23, "start": 149581, "end": 156252, "text": "Ellos entonces comenzaron a preguntar entre sí, cuál de ellos sería el que había de hacer esto.", "words": [[0, 149581], [6, 150013], [15, 150673], [26, 151633], [28, 151713], [38, 152333], [44, 152593], [48, 152953], [53, 153713], [56, 153973], [62, 154213], [68, 154523], [71, 154833], [75, 154953], [81, 155173], [84, 155393], [90, 155633]]}, {"verse": 24, "start": 156602, "end": 160857, "text": "Y hubo entre ellos una disputa, quién de ellos parecía ser el mayor.", "words": [[0, 156602], [2, 156762], [7, 157102], [13, 157322], [19, 157642], [23, 157882], [32, 158642], [38, 158902], [41, 159002], [47, 159282], [55, 159862], [59, 160142], [62, 160262]]}, {"verse": 25, "start": 161207, "end": 171483, "text": "Entonces él les dijo: Los reyes de las naciones dominan sobre ellas; y los que sobre ellas tienen autoridad, son llamados bienhechores:", "words": [[0, 161207], [9, 162032], [12, 162172], [16, 162392], [22, 163130], [26, 163276], [32, 163676], [35, 163796], [39, 163956], [48, 164476], [56, 165336], [62, 165636], [69, 166624], [71, 166751], [75, 166891], [79, 167071], [85, 167391], [91, 167651], [98, 168151], [109, 169091], [113, 169651], [122, 170231]]}, {"verse": 26, "start": 171833, "end": 180705, "text": "Pero vosotros, no así: antes el que es mayor entre vosotros, sea como el más joven; y el que dirige, como el que sirve.", "words": [[0, 171833], [5, 172000], [15, 173040], [18, 173120], [23, 173825], [29, 174325], [32, 174705], [36, 174865], [39, 175025], [45, 175385], [51, 175685], [61, 176325], [65, 177025], [70, 177325], [73, 177465], [77, 177605], [84, 178424], [86, 178548], [89, 178698], [93, 178858], [101, 179438], [106, 179728], [109, 180018], [113, 180098]]}, {"verse": 27, "start": 181055, "end": 191010, "text": "Porque, ¿cuál es mayor, el que se sienta a la mesa, o el que sirve? ¿No es el que se sienta a la mesa? Y yo soy entre vosotros como el que sirve.", "words": [[0, 181217], [8, 181417], [14, 182037], [17, 182197], [24, 182617], [27, 182937], [31, 183117], [34, 183277], [41, 183837], [43, 183917], [46, 184037], [52, 184377], [54, 184722], [57, 184842], [61, 184962], [68, 185867], [72, 186057], [75, 186377], [78, 186657], [82, 186797], [85, 186937], [92, 187457], [94, 187557], [97, 187637], [103, 188420], [105, 188548], [108, 188728], [112, 189028], [118, 189288], [127, 189908], [132, 190168], [135, 190348], [139, 190448]]}, {"verse": 28, "start": 191360, "end": 196649, "text": "Pero vosotros sois los que habéis permanecido conmigo en mis tentaciones:", "words": [[0, 191360], [5, 191524], [14, 192084], [19, 193164], [23, 193664], [27, 193824], [34, 194064], [46, 194804], [54, 195284], [57, 195424], [61, 195564]]}, {"verse": 29, "start": 196999, "end": 202420, "text": "Yo pues os concedo un reino, como mi Padre me lo concedió a mí,", "words": [[0, 196999], [3, 197440], [8, 197760], [11, 198200], [19, 198740], [22, 198840], [29, 199580], [34, 200100], [37, 200300], [43, 200720], [46, 201140], [49, 201260], [58, 201920], [60, 202040]]}, {"verse": 30, "start": 202770, "end": 211503, "text": "Para que comáis y bebáis en mi mesa en mi reino, y os sentéis sobre tronos juzgando a las doce tribus de Israel.", "words": [[0, 202770], [5, 202931], [9, 203111], [16, 203851], [18, 204211], [25, 204651], [28, 204871], [31, 205031], [36, 205311], [39, 205511], [42, 205651], [49, 206040], [51, 206428], [54, 206817], [62, 207206], [68, 207546], [75, 208366], [84, 209086], [86, 209246], [90, 209386], [95, 209806], [102, 210446], [105, 210586]]}, {"verse": 31, "start": 211853, "end": 219242, "text": "Dijo también el Señor: Simón, Simón, he aquí Satanás os ha pedido para zarandaros como a trigo;", "words": [[0, 211853], [5, 212339], [13, 212659], [16, 212939], [23, 213696], [30, 214100], [37, 214750], [40, 215400], [45, 215780], [53, 216720], [56, 216820], [59, 216940], [66, 217340], [71, 217580], [82, 218360], [87, 218674], [89, 218988]]}, {"verse": 32, "start": 219592, "end": 226453, "text": "Pero yo he rogado por ti que tu fe no falte: y tú, una vez vuelto, fortalece a tus hermanos.", "words": [[0, 219592], [5, 219933], [8, 220133], [11, 220413], [18, 220693], [22, 220953], [25, 221233], [29, 221373], [32, 221553], [35, 221813], [38, 221913], [45, 222865], [47, 223004], [51, 223244], [55, 223644], [59, 223984], [67, 224544], [77, 225344], [79, 225424], [83, 225564]]}, {"verse": 33, "start": 226803, "end": 231600, "text": "Y él le dijo: Señor, estoy dispuesto a ir contigo aun a cárcel y a muerte.", "words": [[0, 226803], [2, 227009], [5, 227149], [8, 227269], [14, 227987], [21, 228683], [27, 228883], [37, 229383], [39, 229543], [42, 229623], [50, 229883], [54, 230143], [56, 230403], [63, 230883], [65, 231043], [67, 231063]]}, {"verse": 34, "start": 231880, "end": 238592, "text": "Y él dijo: Pedro, te digo que el gallo no cantará hoy antes que tú niegues tres veces que me conoces.", "words": [[0, 231880], [2, 232025], [5, 232145], [11, 232806], [18, 233651], [21, 233831], [26, 234091], [30, 234271], [33, 234371], [39, 234651], [42, 234791], [50, 235331], [54, 235611], [60, 235971], [64, 236191], [67, 236391], [75, 236831], [80, 237051], [86, 237431], [90, 237631], [93, 237771]]}, {"verse": 35, "start": 238942, "end": 248316, "text": "Y a ellos dijo: Cuando os envié sin bolsa, y sin bolsa de viaje, y sin zapatos, ¿os faltó algo? Y ellos dijeron: Nada.", "words": [[0, 238942], [2, 239089], [4, 239169], [10, 239329], [16, 240149], [23, 240454], [26, 240794], [32, 241134], [36, 241274], [43, 241794], [45, 241914], [49, 242094], [55, 242534], [58, 242634], [65, 242934], [67, 243214], [71, 243374], [80, 244414], [84, 244574], [90, 245034], [96, 245789], [98, 245930], [104, 246110], [113, 247112]]}, {"verse": 36, "start": 248596, "end": 257382, "text": "Y les dijo: Pues ahora, el que tiene bolsa, tómela, y también la bolsa de viaje, y el que no tiene, venda su capa y compre espada.", "words": [[0, 248596], [2, 248720], [6, 248860], [12, 249591], [17, 249736], [24, 250136], [27, 250696], [31, 250836], [37, 251056], [44, 251781], [52, 252161], [54, 252541], [62, 252821], [65, 253001], [71, 253321], [74, 253441], [81, 253781], [83, 254261], [86, 254361], [90, 254481], [93, 254641], [100, 255361], [106, 255621], [109, 255801], [114, 256221], [116, 256301], [123, 256701]]}, {"verse": 37, "start": 257732, "end": 267110, "text": "Porque os digo, que es necesario que se cumpla todavía en mí aquello que está escrito: Y con los malos fue contado: porque lo que está escrito de mí, cumplimiento tiene.", "words": [[0, 257732], [7, 257954], [10, 258114], [16, 258314], [20, 258554], [23, 258734], [33, 259454], [37, 259654], [40, 259794], [47, 260254], [55, 260574], [58, 260874], [61, 261014], [69, 261634], [73, 261754], [78, 261894], [87, 262677], [89, 262755], [93, 262915], [97, 263075], [103, 263395], [107, 263555], [116, 264441], [123, 264625], [126, 264805], [130, 264925], [135, 265065], [143, 265385], [146, 265645], [150, 265805], [163, 266465]]}, {"verse": 38, "start": 267460, "end": 273313, "text": "Entonces ellos dijeron: Señor, he aquí dos espadas. Y él les dijo: Basta.", "words": [[0, 267460], [9, 267976], [15, 268376], [24, 269390], [31, 269908], [34, 269988], [39, 270228], [43, 270408], [52, 271452], [54, 271648], [57, 271788], [61, 271988], [67, 272763]]}, {"verse": 39, "start": 273663, "end": 279613, "text": "Y saliendo, se fue, como solía, al monte de los Olivos; y sus discípulos también le siguieron.", "words": [[0, 273663], [2, 273853], [12, 274393], [15, 274593], [20, 274873], [25, 275193], [32, 275693], [35, 275953], [41, 276233], [44, 276493], [48, 276633], [56, 277555], [58, 277663], [62, 277823], [73, 278403], [81, 278703], [84, 278923]]}, {"verse": 40, "start": 279963, "end": 285328, "text": "Y cuando llegó a aquel lugar, les dijo: Orad que no entréis en tentación.", "words": [[0, 279963], [2, 280095], [9, 280395], [15, 280795], [17, 281135], [23, 281475], [30, 282115], [34, 282295], [40, 283042], [45, 283445], [49, 283620], [52, 283800], [60, 284280], [63, 284460]]}, {"verse": 41, "start": 285678, "end": 290553, "text": "Y él se apartó de ellos como un tiro de piedra; y puesto de rodillas oró,", "words": [[0, 285678], [2, 285829], [5, 285969], [8, 286129], [15, 286669], [18, 286809], [24, 287089], [29, 287409], [32, 287629], [37, 287909], [40, 288109], [48, 288949], [50, 289185], [57, 289445], [60, 289705], [69, 290205]]}, {"verse": 42, "start": 290903, "end": 298417, "text": "Diciendo: Padre, si quieres, aparta esta copa de mí; pero no se haga mi voluntad, sino la tuya.", "words": [[0, 290976], [10, 292409], [17, 292986], [20, 293206], [29, 293916], [36, 294626], [41, 294806], [46, 295226], [49, 295346], [53, 295834], [58, 296000], [61, 296180], [64, 296360], [69, 296540], [72, 296720], [82, 297340], [87, 297640], [90, 297880]]}, {"verse": 43, "start": 298767, "end": 302059, "text": "Y le apareció un ángel del cielo confortándole.", "words": [[0, 298767], [2, 298892], [5, 298992], [14, 299592], [17, 299872], [23, 300312], [27, 300472], [33, 300872]]}, {"verse": 44, "start": 302409, "end": 311182, "text": "Y estando en agonía, oraba más intensamente: y fue su sudor como grandes gotas de sangre que caían hasta la tierra.", "words": [[0, 302409], [2, 302589], [10, 303029], [13, 303189], [21, 304249], [27, 304809], [31, 305109], [45, 306512], [47, 306633], [51, 306813], [54, 307033], [60, 307473], [65, 307713], [73, 308193], [79, 308813], [82, 308953], [89, 309393], [93, 309613], [99, 310073], [105, 310353], [108, 310533]]}, {"verse": 45, "start": 311532, "end": 317539, "text": "Y como se levantó de la oración, y vino a sus discípulos, los halló durmiendo de tristeza;", "words": [[0, 311532], [2, 311770], [7, 311970], [10, 312150], [18, 312630], [21, 312883], [24, 313137], [33, 313390], [35, 313790], [40, 314030], [42, 314190], [46, 314370], [58, 315390], [62, 315550], [68, 315970], [78, 316530], [81, 316690]]}, {"verse": 46, "start": 317889, "end": 323365, "text": "Y les dijo: ¿Por qué dormís? Levantaos, y orad que no entréis en tentación.", "words": [[0, 317889], [2, 318013], [6, 318153], [12, 318884], [17, 319008], [21, 319208], [29, 320198], [40, 320968], [42, 321188], [47, 321508], [51, 321708], [54, 321888], [62, 322428], [65, 322568]]}, {"verse": 47, "start": 323715, "end": 334418, "text": "Estando él aún hablando, he aquí una turba; y el que se llamaba Judas, uno de los doce, iba delante de ellos; y se acercó hasta Jesús para besarlo.", "words": [[0, 323715], [8, 324162], [11, 324462], [15, 324762], [25, 325062], [28, 325362], [33, 325562], [37, 325802], [44, 326681], [46, 326902], [49, 327022], [53, 327142], [56, 327302], [64, 327682], [71, 328522], [75, 328922], [78, 329082], [82, 329222], [88, 330022], [92, 330302], [100, 330762], [103, 330942], [110, 331764], [112, 331887], [115, 332027], [122, 332627], [128, 332867], [134, 333247], [139, 333861]]}, {"verse": 48, "start": 334768, "end": 340261, "text": "Entonces Jesús le dijo: Judas, ¿con beso entregas al Hijo del hombre?", "words": [[0, 334768], [9, 335175], [15, 335715], [18, 336055], [24, 336806], [31, 337745], [36, 338165], [41, 338585], [50, 339145], [53, 339305], [58, 339545], [62, 339745]]}, {"verse": 49, "start": 340611, "end": 346906, "text": "Y viendo los que estaban con él lo que había de ser, le dijeron: Señor, ¿heriremos con la espada?", "words": [[0, 340611], [2, 340757], [9, 341097], [13, 341297], [17, 341437], [25, 341757], [29, 342057], [32, 342297], [35, 342617], [39, 342757], [45, 342977], [48, 343177], [53, 343757], [56, 343917], [65, 344897], [72, 345616], [83, 346116], [87, 346276], [90, 346376]]}, {"verse": 50, "start": 347186, "end": 353287, "text": "Y uno de ellos hirió a un siervo del sumo sacerdote, y le quitó la oreja derecha.", "words": [[0, 347186], [2, 347366], [6, 347606], [9, 347766], [15, 348106], [21, 348646], [23, 348866], [26, 349026], [33, 349566], [37, 349686], [42, 350206], [53, 350946], [55, 351366], [58, 351506], [64, 352026], [67, 352226], [73, 352626]]}, {"verse": 51, "start": 353637, "end": 360155, "text": "Entonces respondiendo Jesús, dijo: Dejad hasta aquí. Y tocando su oreja, le sanó.", "words": [[0, 353637], [9, 354349], [22, 355169], [29, 355349], [35, 356248], [41, 356745], [47, 357065], [53, 357920], [55, 358026], [63, 358446], [66, 358706], [73, 359586], [76, 359686]]}, {"verse": 52, "start": 360505, "end": 373444, "text": "Y Jesús dijo a los que habían venido a él, los principales sacerdotes, y los jefes de la guardia del templo, y los ancianos: ¿Como a ladrón habéis salido con espadas y con palos?", "words": [[0, 360505], [2, 360632], [8, 361032], [13, 361532], [15, 361852], [19, 361992], [23, 362152], [30, 362472], [37, 362952], [39, 363112], [43, 363892], [47, 364052], [59, 364752], [71, 365552], [73, 366052], [77, 366192], [83, 366572], [86, 366652], [89, 366752], [97, 367092], [101, 367252], [109, 367812], [111, 368292], [115, 368432], [125, 369546], [131, 369714], [133, 369914], [140, 370414], [147, 371074], [154, 371714], [158, 371934], [166, 372414], [168, 372614], [172, 372794]]}, {"verse": 53, "start": 373794, "end": 383874, "text": "Habiendo estado con vosotros cada día en el templo, no extendisteis las manos contra mí; pero esta es vuestra hora, y la potestad de las tinieblas.", "words": [[0, 373794], [9, 374119], [16, 374419], [20, 374759], [29, 375259], [34, 375479], [38, 375799], [41, 375959], [44, 376099], [52, 377119], [55, 377259], [68, 378639], [72, 378959], [78, 379339], [85, 379679], [89, 380260], [94, 380406], [99, 380666], [102, 380806], [110, 381186], [116, 381506], [118, 381741], [121, 381881], [130, 382481], [133, 382601], [137, 382741]]}, {"verse": 54, "start": 384224, "end": 391584, "text": "Y prendiéndole le trajeron, y le metieron en casa del sumo sacerdote. Y Pedro le seguía de lejos.", "words": [[0, 384224], [2, 384349], [15, 385369], [18, 385669], [28, 386509], [30, 386694], [33, 386794], [42, 387254], [45, 387454], [50, 387754], [54, 387994], [59, 388474], [70, 389579], [72, 389848], [78, 390168], [81, 390388], [88, 390788], [91, 390888]]}, {"verse": 55, "start": 391934, "end": 400249, "text": "Y habiendo encendido fuego en medio del patio, y sentándose todos alrededor, se sentó también Pedro entre ellos.", "words": [[0, 391934], [2, 392039], [11, 392439], [21, 393119], [27, 393479], [30, 393859], [36, 394139], [40, 394359], [47, 395379], [49, 395459], [60, 396259], [66, 396639], [77, 398019], [80, 398159], [86, 398579], [94, 398859], [100, 399339], [106, 399659]]}, {"verse": 56, "start": 400599, "end": 408221, "text": "Y como una criada le vio que estaba sentado al fuego, se fijó en él, y dijo: Y este con él estaba.", "words": [[0, 400599], [2, 400723], [7, 400963], [11, 401203], [18, 401763], [21, 401943], [25, 402203], [29, 402323], [36, 402773], [44, 403223], [47, 403363], [54, 404323], [57, 404563], [62, 405003], [65, 405183], [69, 405463], [71, 405758], [77, 406531], [79, 406679], [84, 406979], [88, 407259], [91, 407459]]}, {"verse": 57, "start": 408501, "end": 412945, "text": "Entonces él lo negó, diciendo: Mujer, no le conozco.", "words": [[0, 408501], [9, 408946], [12, 409446], [15, 409746], [21, 410206], [31, 411580], [38, 411921], [41, 412221], [44, 412341]]}, {"verse": 58, "start": 413225, "end": 420171, "text": "Y un poco después, viéndole otro, dijo: Y tú de ellos eras. Y Pedro dijo: Hombre, no soy.", "words": [[0, 413225], [2, 413327], [5, 413447], [10, 413667], [19, 414567], [28, 414987], [34, 415707], [40, 416349], [42, 416471], [45, 416691], [48, 416891], [54, 417111], [60, 417992], [62, 418116], [68, 418456], [74, 419358], [82, 419560], [85, 419760]]}, {"verse": 59, "start": 420451, "end": 427914, "text": "Y como una hora pasada otro afirmaba, diciendo: Verdaderamente también este estaba con él, porque es galileo.", "words": [[0, 420451], [2, 420580], [7, 420840], [11, 421080], [16, 421480], [23, 421880], [28, 422100], [38, 423360], [48, 424417], [63, 425154], [71, 425414], [76, 425774], [83, 426074], [87, 426354], [91, 426974], [98, 427214], [101, 427334]]}, {"verse": 60, "start": 428194, "end": 434979, "text": "Y Pedro dijo: Hombre, no sé qué dices. Y enseguida, estando él aún hablando, el gallo cantó.", "words": [[0, 428194], [2, 428318], [8, 428658], [14, 429560], [22, 429942], [25, 430002], [28, 430182], [32, 430282], [39, 431199], [41, 431325], [52, 431885], [60, 432325], [63, 432525], [67, 432705], [77, 433825], [80, 433965], [86, 434385]]}, {"verse": 61, "start": 435329, "end": 446591, "text": "Entonces, vuelto el Señor, miró a Pedro: y Pedro se acordó de la palabra del Señor como le había dicho: Antes que el gallo cante, me negarás tres veces.", "words": [[0, 435329], [10, 435930], [17, 436710], [20, 436870], [27, 437990], [32, 438330], [34, 438410], [41, 438930], [43, 439150], [49, 439510], [52, 439910], [59, 440390], [62, 440490], [65, 440590], [73, 440890], [77, 441150], [83, 441450], [88, 442070], [91, 442230], [97, 442450], [104, 443248], [110, 443591], [114, 443791], [117, 443931], [123, 444361], [130, 444791], [133, 445131], [141, 445471], [146, 445731]]}, {"verse": 62, "start": 446941, "end": 450197, "text": "Y saliendo fuera Pedro, lloró amargamente.", "words": [[0, 446941], [2, 447047], [11, 447507], [17, 447747], [24, 448707], [30, 449087]]}, {"verse": 63, "start": 450547, "end": 454946, "text": "Y los hombres que tenían a Jesús, se burlaban de él hiriéndole;", "words": [[0, 450547], [2, 450653], [6, 450813], [14, 451153], [18, 451333], [25, 451673], [27, 451893], [34, 452273], [37, 452833], [46, 453433], [49, 453693], [52, 454348]]}, {"verse": 64, "start": 455296, "end": 462611, "text": "Y cubriéndole, herían su rostro, y le preguntaban, diciendo: Profetiza quién es el que te hirió.", "words": [[0, 455296], [2, 455460], [15, 456180], [22, 456900], [25, 457060], [33, 458100], [35, 458180], [38, 458300], [51, 459060], [61, 460679], [71, 461263], [77, 461503], [80, 461723], [83, 461823], [87, 461963], [90, 462308]]}, {"verse": 65, "start": 462891, "end": 465791, "text": "Y decían otras muchas cosas injuriándole.", "words": [[0, 462891], [2, 463000], [9, 463480], [15, 463760], [22, 464140], [28, 464993]]}, {"verse": 66, "start": 466141, "end": 474345, "text": "Al amanecer, se juntaron los ancianos del pueblo, y los principales sacerdotes, y los escribas, y le trajeron a su Consejo,", "words": [[0, 466141], [3, 466341], [13, 466961], [16, 467161], [25, 467721], [29, 467901], [38, 468421], [42, 468561], [50, 469061], [52, 469521], [56, 469661], [68, 470361], [80, 471241], [82, 471461], [86, 471581], [96, 472281], [98, 472621], [101, 472741], [110, 473321], [112, 473401], [115, 473541]]}, {"verse": 67, "start": 474695, "end": 481591, "text": "Y le preguntaron: ¿Eres tú el Cristo? dínoslo. Y les dijo: Si os lo digo, no creeréis;", "words": [[0, 474695], [2, 474794], [5, 474914], [18, 476095], [24, 476275], [27, 476575], [30, 476715], [38, 477535], [47, 478404], [49, 478528], [53, 478668], [59, 479399], [62, 479749], [65, 479909], [68, 480069], [74, 480429], [77, 480569]]}, {"verse": 68, "start": 481941, "end": 486652, "text": "Y también si os pregunto, no me responderíais ni me soltaríais.", "words": [[0, 481941], [2, 482048], [10, 482328], [13, 482588], [16, 482668], [26, 483448], [29, 483748], [32, 483928], [46, 484988], [49, 485428], [52, 486065]]}, {"verse": 69, "start": 487002, "end": 491864, "text": "Pero desde ahora el Hijo del hombre se sentará a la diestra del poder de Dios.", "words": [[0, 487002], [5, 487148], [11, 487428], [17, 487808], [20, 488028], [25, 488308], [29, 488448], [36, 488848], [39, 488968], [47, 489548], [49, 489788], [52, 489868], [60, 490368], [64, 490608], [70, 490968], [73, 491208]]}, {"verse": 70, "start": 492214, "end": 499164, "text": "Y dijeron todos: ¿Entonces tú eres Hijo de Dios? Y él les dijo: Vosotros decís que yo soy.", "words": [[0, 492214], [2, 492381], [10, 492901], [17, 493941], [27, 494463], [30, 494723], [35, 494883], [40, 495163], [43, 495323], [49, 496136], [51, 496332], [54, 496472], [58, 496672], [64, 497448], [73, 497913], [79, 498393], [83, 498493], [86, 498673]]}, {"verse": 71, "start": 499514, "end": 505451, "text": "Entonces ellos dijeron: ¿Qué más testimonio deseamos? porque nosotros lo hemos oído de su boca.", "words": [[0, 499514], [9, 500030], [15, 500430], [24, 501444], [29, 501548], [33, 501728], [44, 502328], [54, 503331], [61, 503495], [70, 503835], [73, 504155], [79, 504295], [84, 504675], [87, 504835], [90, 504975]]}]}