{"book": "MRK", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 278307, "verses": [{"verse": 1, "start": 300, "end": 9131, "text": "Y como fueron cerca de Jerusalén, de Betfagé, y de Betania, al monte de los Olivos, envía dos de sus discípulos,", "words": [[0, 300], [2, 403], [7, 624], [14, 924], [20, 1404], [23, 1724], [34, 2923], [37, 3383], [46, 3843], [48, 4103], [51, 4224], [60, 5403], [63, 5504], [69, 5804], [72, 6004], [76, 6143], [84, 6624], [90, 7363], [94, 7684], [97, 7943], [101, 8143]]}, {"verse": 2, "start": 9581, "end": 22269, "text": "Y les dice: Id a la aldea que está frente a vosotros, y al entrar en ella, hallaréis un pollino atado, sobre el cual ningún hombre ha subido; desatadlo y traedlo.", "words": [[0, 9581], [2, 9709], [6, 9869], [12, 10812], [15, 10906], [17, 10999], [20, 11199], [26, 11699], [30, 11859], [35, 12059], [42, 12339], [44, 12579], [54, 13079], [56, 13339], [59, 13459], [66, 13899], [69, 14259], [75, 14819], [85, 15599], [88, 15759], [96, 16219], [103, 16859], [109, 17379], [112, 17579], [117, 17739], [124, 18159], [131, 18819], [134, 19259], [142, 20232], [152, 21138], [154, 21338]]}, {"verse": 3, "start": 22719, "end": 30411, "text": "Y si alguien os dice: ¿Por qué hacéis eso? decid que el Señor lo necesita: y que luego lo devolverá.", "words": [[0, 22719], [2, 22838], [5, 22958], [13, 23318], [16, 23638], [22, 24610], [27, 24714], [31, 24914], [38, 25294], [43, 26079], [49, 26566], [53, 26786], [56, 27006], [62, 27346], [65, 27626], [75, 28786], [77, 28904], [81, 29024], [87, 29284], [90, 29544]]}, {"verse": 4, "start": 30861, "end": 37347, "text": "Y fueron, y hallaron el pollino atado a la puerta fuera, entre dos caminos; y le desataron.", "words": [[0, 30861], [2, 31123], [10, 31423], [12, 31763], [21, 32223], [24, 32553], [32, 32883], [38, 33343], [40, 33463], [43, 33543], [50, 33863], [57, 34663], [63, 34983], [67, 35223], [76, 36229], [78, 36352], [81, 36432]]}, {"verse": 5, "start": 37797, "end": 42446, "text": "Y unos de los que estaban allí, les dijeron: ¿Qué hacéis desatando el pollino?", "words": [[0, 37797], [2, 37948], [7, 38138], [10, 38318], [14, 38458], [18, 38618], [26, 38878], [32, 39278], [36, 39798], [45, 40812], [50, 40912], [57, 41272], [67, 41812], [70, 41912]]}, {"verse": 6, "start": 42796, "end": 48081, "text": "Ellos entonces les dijeron como Jesús había mandado: y los dejaron.", "words": [[0, 42796], [6, 43203], [15, 43743], [19, 44203], [27, 44803], [32, 45043], [38, 45383], [44, 45943], [53, 47053], [55, 47197], [59, 47317]]}, {"verse": 7, "start": 48531, "end": 54874, "text": "Y trajeron el pollino a Jesús, y echaron sobre él sus vestidos, y se sentó sobre él.", "words": [[0, 48531], [2, 48656], [11, 49236], [14, 49356], [22, 49836], [24, 49956], [31, 50296], [33, 51036], [41, 51516], [47, 51856], [50, 52096], [54, 52316], [64, 52916], [66, 53436], [69, 53576], [75, 54096], [81, 54416]]}, {"verse": 8, "start": 55324, "end": 63069, "text": "Y muchos tendían sus vestidos por el camino, y otros cortaban hojas de los árboles, y las tendían por el camino.", "words": [[0, 55324], [2, 55467], [9, 55787], [17, 56387], [21, 56607], [30, 57147], [34, 57387], [37, 57487], [45, 58307], [47, 58567], [53, 58787], [62, 59507], [68, 60007], [71, 60147], [75, 60247], [84, 60847], [86, 61467], [90, 61587], [98, 62107], [102, 62327], [105, 62467]]}, {"verse": 9, "start": 63519, "end": 71650, "text": "Y los que iban delante, y los que iban detrás, daban voces diciendo: ¡Hosanna! Bendito el que viene en el nombre del Señor.", "words": [[0, 63519], [2, 63755], [6, 63855], [10, 64015], [15, 64275], [24, 64795], [26, 65195], [30, 65335], [34, 65475], [39, 65755], [47, 66275], [53, 66935], [59, 67395], [69, 68812], [79, 69465], [87, 69942], [90, 70062], [94, 70162], [100, 70422], [103, 70602], [106, 70702], [113, 70922], [117, 71122]]}, {"verse": 10, "start": 72100, "end": 76748, "text": "Bendito el reino de nuestro padre David que viene: ¡Hosanna en las alturas!", "words": [[0, 72100], [8, 72603], [11, 72723], [17, 73063], [20, 73183], [28, 73343], [34, 73863], [40, 74163], [44, 74363], [51, 75359], [60, 75599], [63, 75799], [67, 75919]]}, {"verse": 11, "start": 77098, "end": 87172, "text": "Y entró Jesús en Jerusalén, y en el templo: y habiendo mirado alrededor todas las cosas, y siendo ya tarde, se salió a Betania con los doce.", "words": [[0, 77098], [2, 77255], [8, 77675], [14, 77955], [17, 78255], [28, 79015], [30, 79175], [33, 79295], [36, 79415], [44, 80331], [46, 80615], [55, 80935], [62, 81375], [72, 81655], [78, 82295], [82, 82555], [89, 83015], [91, 83335], [98, 83635], [101, 83835], [108, 84675], [111, 84895], [117, 85275], [119, 85355], [127, 85935], [131, 86395], [135, 86575]]}, {"verse": 12, "start": 87622, "end": 91380, "text": "Y el día siguiente, cuando salieron de Betania, tuvo hambre.", "words": [[0, 87622], [2, 87744], [5, 87864], [9, 88044], [20, 88804], [27, 88964], [36, 89624], [39, 89804], [48, 90444], [53, 90644]]}, {"verse": 13, "start": 91830, "end": 103766, "text": "Y viendo de lejos una higuera que tenía hojas, se acercó, si quizá hallaría en ella algo: y cuando vino a ella, nada halló sino hojas; porque no era tiempo de higos.", "words": [[0, 91830], [2, 91958], [9, 92278], [12, 92498], [18, 92798], [22, 93058], [30, 93538], [34, 93678], [40, 94018], [47, 94758], [50, 94978], [58, 95998], [61, 96218], [67, 96738], [76, 97258], [79, 97438], [84, 97678], [90, 98561], [92, 98667], [99, 98887], [104, 99187], [106, 99407], [112, 99567], [117, 100287], [123, 100827], [128, 101067], [135, 102026], [142, 102230], [145, 102450], [149, 102570], [156, 102870], [159, 103150]]}, {"verse": 14, "start": 104216, "end": 114032, "text": "Entonces Jesús respondiendo, dijo a la higuera: Nunca más coma nadie fruto de ti para siempre. Y lo oyeron sus discípulos.", "words": [[0, 104216], [9, 104736], [15, 105576], [29, 106796], [34, 107216], [36, 107476], [39, 107576], [48, 108591], [54, 109037], [58, 109277], [63, 109497], [69, 109817], [75, 110237], [78, 110377], [81, 110557], [86, 110777], [95, 111858], [97, 112000], [100, 112420], [107, 112840], [111, 113000]]}, {"verse": 15, "start": 114482, "end": 129225, "text": "Vienen, pues, a Jerusalén; y entrando Jesús en el templo, comenzó a echar fuera a los que vendían y compraban en el templo; y volcó las mesas de los cambistas, y las sillas de los que vendían palomas;", "words": [[0, 114482], [8, 114829], [14, 115169], [16, 115629], [27, 116836], [29, 116981], [38, 117461], [44, 117841], [47, 118161], [50, 118321], [58, 118981], [66, 119681], [68, 119781], [74, 119941], [80, 120341], [82, 120821], [86, 120941], [90, 121061], [98, 121621], [100, 121841], [110, 122541], [113, 122661], [116, 122821], [124, 123795], [126, 123900], [132, 124360], [136, 124500], [142, 124960], [145, 125040], [149, 125470], [160, 125900], [162, 126620], [166, 126780], [173, 127240], [176, 127700], [180, 127820], [184, 127940], [192, 128380]]}, {"verse": 16, "start": 129675, "end": 134718, "text": "Y no consentía que alguien transportara ningún objeto por el templo.", "words": [[0, 129675], [2, 129926], [5, 130046], [15, 130906], [19, 131106], [27, 131446], [40, 132466], [47, 132846], [54, 133506], [58, 133846], [61, 134006]]}, {"verse": 17, "start": 135168, "end": 145867, "text": "Y les enseñaba diciendo: ¿No está escrito que mi casa, casa de oración será llamada por todas las naciones? Pero vosotros la habéis hecho cueva de ladrones.", "words": [[0, 135168], [2, 135292], [6, 135452], [15, 136172], [25, 137369], [29, 137477], [34, 137637], [42, 138077], [46, 138317], [49, 138457], [55, 138877], [60, 139177], [63, 139397], [71, 139937], [76, 140077], [84, 140557], [88, 140757], [94, 141057], [98, 141357], [108, 142445], [113, 142590], [122, 143190], [125, 143730], [132, 144110], [138, 144410], [144, 144870], [147, 144990]]}, {"verse": 18, "start": 146317, "end": 157676, "text": "Y lo oyeron los escribas y los principales sacerdotes, y buscaban cómo le matarían; porque le tenían miedo, por cuanto todo el pueblo estaba maravillado de su enseñanza.", "words": [[0, 146317], [2, 146442], [5, 146622], [12, 147082], [16, 147262], [25, 147962], [27, 148122], [31, 148222], [43, 149002], [55, 149802], [57, 150362], [66, 150882], [71, 151222], [74, 151442], [84, 152592], [91, 152797], [94, 152977], [101, 153277], [108, 153757], [112, 153977], [119, 154277], [124, 154617], [127, 154817], [134, 155177], [141, 155577], [153, 156417], [156, 156577], [159, 156737]]}, {"verse": 19, "start": 158126, "end": 161738, "text": "Pero como fue tarde, Jesús salió de la ciudad.", "words": [[0, 158126], [5, 158252], [10, 158492], [14, 158692], [21, 159672], [27, 160092], [33, 160852], [36, 160972], [39, 161092]]}, {"verse": 20, "start": 162188, "end": 167164, "text": "Y pasando por la mañana, vieron que la higuera se había secado desde las raíces.", "words": [[0, 162188], [2, 162294], [10, 162634], [14, 162954], [17, 163094], [25, 163794], [32, 164114], [36, 164334], [39, 164474], [47, 164954], [50, 165114], [56, 165354], [63, 165894], [69, 166094], [73, 166354]]}, {"verse": 21, "start": 167614, "end": 174532, "text": "Entonces Pedro, recordando, le dice: Maestro, he aquí la higuera que maldijiste, se ha secado.", "words": [[0, 167614], [9, 168272], [16, 169172], [28, 170152], [31, 170232], [37, 170987], [46, 171786], [49, 171866], [54, 172146], [57, 172306], [65, 172646], [69, 173196], [81, 173746], [84, 173886], [87, 174006]]}, {"verse": 22, "start": 174882, "end": 178911, "text": "Y respondiendo Jesús, les dice: Tened fe en Dios.", "words": [[0, 174882], [2, 175026], [15, 175806], [22, 176666], [26, 176786], [32, 177632], [38, 177956], [41, 178176], [44, 178376]]}, {"verse": 23, "start": 179361, "end": 192011, "text": "Porque de cierto os digo que cualquiera que diga a este monte: Quítate, y échate en el mar, y no dude en su corazón, sino crea que será hecho lo que dice, lo que diga le será hecho.", "words": [[0, 179361], [7, 179585], [10, 179785], [17, 180045], [20, 180425], [25, 180665], [29, 180905], [40, 181585], [44, 181745], [49, 181935], [51, 182125], [56, 182445], [63, 183477], [72, 183941], [74, 184301], [81, 184721], [84, 185001], [87, 185141], [92, 185401], [94, 185961], [97, 186121], [102, 186501], [105, 186661], [108, 186821], [117, 187521], [122, 188221], [127, 188661], [131, 188821], [136, 189101], [142, 189501], [145, 189721], [149, 189881], [155, 190361], [158, 190481], [162, 190701], [167, 190921], [170, 191061], [175, 191341]]}, {"verse": 24, "start": 192461, "end": 198586, "text": "Por tanto, os digo que todo lo que orando pidáis, creed que lo recibiréis, y os vendrá.", "words": [[0, 192461], [4, 192587], [11, 192947], [14, 193147], [19, 193347], [23, 193547], [28, 193847], [31, 194087], [35, 194247], [42, 194757], [50, 195267], [56, 196367], [60, 196567], [63, 196727], [75, 197527], [77, 197767], [80, 197927]]}, {"verse": 25, "start": 199036, "end": 209520, "text": "Y cuando estéis orando, perdonad, si tenéis algo contra alguno, para que vuestro Padre que está en los cielos os perdone también a vosotros vuestras ofensas.", "words": [[0, 199036], [2, 199163], [9, 199443], [16, 199903], [24, 200943], [34, 201643], [37, 202103], [44, 202523], [49, 202843], [56, 203223], [64, 204323], [69, 204483], [73, 204643], [81, 204983], [87, 205423], [91, 205563], [96, 205783], [99, 205963], [103, 206123], [110, 206583], [113, 206723], [121, 207203], [129, 207523], [131, 207803], [140, 208223], [149, 208623]]}, {"verse": 26, "start": 209970, "end": 217378, "text": "Porque si vosotros no perdonáis, tampoco vuestro Padre que está en los cielos os perdonará vuestras ofensas.", "words": [[0, 209970], [7, 210133], [10, 210353], [19, 210873], [22, 211093], [33, 211773], [41, 212373], [49, 212993], [55, 213293], [59, 213533], [64, 213733], [67, 213873], [71, 214013], [78, 214593], [81, 214733], [91, 215993], [100, 216453]]}, {"verse": 27, "start": 217828, "end": 226884, "text": "Y volvieron a Jerusalén; y andando él por el templo, vienen a él los principales sacerdotes, y los escribas, y los ancianos;", "words": [[0, 217828], [2, 217938], [12, 218398], [14, 218538], [25, 219666], [27, 219794], [35, 220274], [38, 220454], [42, 220654], [45, 220834], [53, 221534], [60, 221994], [62, 222374], [65, 222594], [69, 222774], [81, 223514], [93, 224354], [95, 224534], [99, 224714], [109, 225434], [111, 225854], [115, 226014]]}, {"verse": 28, "start": 227334, "end": 233680, "text": "Y le dicen: ¿Con qué autoridad haces estas cosas? ¿y quién te ha dado esta autoridad para hacer estas cosas?", "words": [[0, 227334], [2, 227499], [5, 227579], [12, 228406], [17, 228539], [21, 228739], [31, 229339], [37, 229619], [43, 229859], [50, 230823], [53, 230964], [59, 231124], [62, 231284], [65, 231384], [70, 231584], [75, 231784], [85, 232284], [90, 232564], [96, 232784], [102, 232984]]}, {"verse": 29, "start": 234030, "end": 243864, "text": "Y Jesús respondiendo entonces, les dice: Os haré también una pregunta; y respondedme, y os diré con qué autoridad hago estas cosas:", "words": [[0, 234030], [2, 234152], [8, 234532], [21, 235672], [31, 236132], [35, 236812], [41, 237785], [44, 237954], [49, 238254], [57, 238454], [61, 238714], [71, 239782], [73, 240245], [86, 240745], [88, 241145], [91, 241285], [96, 241585], [100, 241725], [104, 241905], [114, 242505], [119, 242885], [125, 243105]]}, {"verse": 30, "start": 244314, "end": 248860, "text": "El bautismo de Juan, ¿era del cielo, o de los hombres? Respondedme.", "words": [[0, 244314], [3, 244440], [12, 244940], [15, 245080], [21, 245480], [26, 245900], [30, 246140], [37, 246440], [39, 246760], [42, 246820], [46, 246940], [55, 248405]]}, {"verse": 31, "start": 249310, "end": 257342, "text": "Entonces ellos pensaron dentro de sí, diciendo: Si decimos, del cielo, dirá: ¿Por qué, pues, no le creísteis?", "words": [[0, 249310], [9, 249776], [15, 250156], [24, 250816], [31, 251076], [34, 251316], [38, 252036], [48, 253030], [51, 253163], [60, 253623], [64, 253843], [71, 254663], [77, 255376], [82, 255500], [87, 255680], [93, 256020], [96, 256300], [99, 256440]]}, {"verse": 32, "start": 257792, "end": 264657, "text": "Y si decimos, de los hombres, tememos al pueblo: porque todos juzgaban de Juan, que verdaderamente era profeta.", "words": [[0, 257792], [2, 257910], [5, 258010], [14, 258470], [17, 258650], [21, 258790], [30, 259170], [38, 259830], [41, 260010], [49, 260926], [56, 261112], [62, 261432], [71, 262052], [74, 262232], [80, 262532], [84, 262972], [99, 263732], [103, 263932]]}, {"verse": 33, "start": 265007, "end": 277907, "text": "Y respondiendo, dicen a Jesús: No sabemos. Entonces respondiendo Jesús, les dice: Tampoco yo os diré con qué autoridad hago estas cosas.", "words": [[0, 265007], [2, 265136], [16, 266496], [22, 266976], [24, 267436], [31, 268406], [34, 268564], [43, 269660], [52, 270704], [65, 271744], [72, 272004], [76, 272464], [82, 273436], [90, 273945], [93, 274405], [96, 274665], [101, 275105], [105, 275485], [109, 275745], [119, 276605], [124, 276965], [130, 277185]]}]}