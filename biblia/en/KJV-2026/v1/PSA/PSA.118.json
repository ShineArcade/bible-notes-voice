{"book": "PSA", "chapter": 118, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 155133, "verses": [{"verse": 1, "start": 300, "end": 5758, "text": "O give thanks to the LORD; for he is good: because his mercy endures for ever.", "words": [[0, 300], [2, 408], [7, 608], [14, 948], [17, 1208], [21, 1348], [27, 2194], [31, 2331], [34, 2571], [37, 2771], [43, 3589], [51, 3814], [55, 4034], [61, 4434], [69, 4898], [73, 5363]]}, {"verse": 2, "start": 6208, "end": 10562, "text": "Let Israel now say, that his mercy endures for ever.", "words": [[0, 6208], [4, 6357], [11, 6737], [15, 7097], [20, 7457], [25, 7937], [29, 8077], [35, 8437], [43, 9156], [47, 9874]]}, {"verse": 3, "start": 11012, "end": 15313, "text": "Let the house of Aaron now say, that his mercy endures for ever.", "words": [[0, 11012], [4, 11157], [8, 11317], [14, 11577], [17, 11757], [23, 11977], [27, 12277], [32, 12657], [37, 13237], [41, 13457], [47, 13897], [55, 14387], [59, 14877]]}, {"verse": 4, "start": 15763, "end": 19925, "text": "Let them now that fear the LORD say, that his mercy endures for ever.", "words": [[0, 15763], [4, 15888], [9, 16108], [13, 16328], [18, 16528], [23, 16788], [27, 16988], [32, 17228], [37, 17608], [42, 18108], [46, 18268], [52, 18668], [60, 19092], [64, 19516]]}, {"verse": 5, "start": 20375, "end": 26265, "text": "I called upon the LORD in distress: the LORD answered me, and set me in a large place.", "words": [[0, 20375], [2, 20903], [9, 21143], [14, 21383], [18, 21603], [23, 21823], [26, 21983], [36, 23092], [40, 23231], [45, 23511], [54, 23891], [58, 24211], [62, 24611], [66, 24851], [69, 25051], [72, 25191], [74, 25271], [80, 25531]]}, {"verse": 6, "start": 26715, "end": 31267, "text": "The LORD is on my side; I will not fear: what can man do to me?", "words": [[0, 26715], [4, 26840], [9, 27140], [12, 27420], [15, 27620], [18, 27800], [24, 28679], [26, 28843], [31, 28963], [35, 29163], [41, 30003], [46, 30170], [50, 30390], [54, 30630], 