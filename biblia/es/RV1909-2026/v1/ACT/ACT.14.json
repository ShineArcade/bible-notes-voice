{"book": "ACT", "chapter": 14, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 249321, "verses": [{"verse": 1, "start": 300, "end": 12801, "text": "Y aconteció en Iconio, que entrados juntamente en la sinagoga de los judíos, hablaron de tal manera, que creyó una grande multitud de judíos, y asimismo de griegos.", "words": [[0, 300], [2, 400], [12, 1100], [15, 1480], [23, 1860], [27, 2660], [36, 3300], [47, 4300], [50, 4460], [53, 4600], [62, 5240], [65, 5380], [69, 5540], [77, 6380], [86, 6960], [89, 7120], [93, 7340], [101, 7800], [105, 8420], [111, 8880], [115, 9060], [122, 9580], [131, 10100], [134, 10300], [142, 10960], [144, 11300], [153, 12000], [156, 12040]]}, {"verse": 2, "start": 13251, "end": 20641, "text": "Pero los judíos que fueron incrédulos, incitaron y corrompieron los ánimos de los Gentiles contra los hermanos.", "words": [[0, 13251], [5, 13417], [9, 13557], [16, 14097], [20, 14217], [27, 14457], [39, 15257], [49, 16717], [51, 17077], [64, 17897], [68, 18077], [75, 18557], [78, 18677], [82, 18757], [91, 19257], [98, 19597], [102, 19817]]}, {"verse": 3, "start": 21091, "end": 33560, "text": "Con todo eso permanecieron allí mucho tiempo, confiados en el Señor, el cual daba testimonio a la palabra de su gracia, dando que señales y milagros fuesen hechos por las manos de ellos.", "words": [[0, 21091], [4, 21254], [9, 21494], [13, 21834], [27, 22604], [32, 23374], [38, 23654], [46, 24094], [56, 24794], [59, 25034], [62, 25174], [69, 26034], [72, 26174], [77, 26334], [82, 26734], [93, 27614], [95, 27694], [98, 27774], [106, 28094], [109, 28294], [112, 28474], [120, 29477], [126, 29837], [130, 30037], [138, 30617], [140, 30757], [149, 31297], [156, 31737], [163, 32137], [167, 32350], [171, 32564], [177, 32777], [180, 32977]]}, {"verse": 4, "start": 34010, "end": 41202, "text": "Pero la población de la ciudad estaba dividida; y unos eran con los judíos, y otros con los apóstoles.", "words": [[0, 34010], [5, 34175], [8, 34335], [18, 34775], [21, 35055], [24, 35175], [31, 35475], [38, 36015], [48, 37244], [50, 37428], [55, 37588], [60, 37928], [64, 38148], [68, 38328], [76, 38988], [78, 39448], [84, 39748], [88, 40108], [92, 40268]]}, {"verse": 5, "start": 41652, "end": 48607, "text": "Y intentando los judíos y los Gentiles, junto con sus dirigentes, maltratarlos y apedrearlos.", "words": [[0, 41652], [2, 41652], [13, 42555], [17, 42735], [24, 43275], [26, 43415], [30, 43535], [40, 44215], [46, 44595], [50, 44935], [54, 45135], [66, 46155], [79, 47195], [81, 47555]]}, {"verse": 6, "start": 49057, "end": 57432, "text": "Al enterarse, los apóstoles huyeron a Listra y Derbe, ciudades de Licaonia, y por toda la tierra alrededor.", "words": [[0, 49057], [3, 49226], [14, 49846], [18, 50046], [28, 50786], [36, 51586], [38, 51686], [45, 52146], [47, 52286], [54, 53066], [63, 53726], [66, 53906], [76, 54606], [78, 55166], [82, 55366], [87, 55646], [90, 55886], [97, 56286]]}, {"verse": 7, "start": 57882, "end": 60167, "text": "Y allí predicaban el evangelio.", "words": [[0, 57882], [2, 58020], [7, 58260], [18, 59140], [21, 59320]]}, {"verse": 8, "start": 60617, "end": 69700, "text": "Y un hombre de Listra, sin fuerza en los pies, estaba sentado, cojo desde el vientre de su madre, que jamás había andado.", "words": [[0, 60617], [2, 60746], [5, 60866], [12, 61206], [15, 61426], [23, 62286], [27, 62506], [34, 62946], [37, 63206], [41, 63326], [47, 64046], [54, 64266], [63, 65206], [68, 66146], [74, 66286], [77, 66636], [85, 66986], [88, 67106], [91, 67306], [98, 68126], [102, 68356], [108, 68586], [114, 68926]]}, {"verse": 9, "start": 70151, "end": 76969, "text": "Este oyó hablar a Pablo; el cual, como puso los ojos en él, y vio que tenía fe para ser sano,", "words": [[0, 70405], [5, 70670], [9, 70938], [16, 71238], [18, 71398], [25, 72291], [28, 72471], [34, 72691], [39, 73051], [44, 73451], [48, 73611], [53, 73911], [56, 74231], [60, 74411], [62, 74891], [66, 75111], [70, 75231], [76, 75551], [79, 75851], [84, 76111], [88, 76331]]}, {"verse": 10, "start": 77419, "end": 83277, "text": "Dijo a gran voz: Levántate derecho sobre tus pies. Y saltó, y anduvo.", "words": [[0, 77419], [5, 77787], [7, 78147], [12, 78327], [17, 79210], [27, 79769], [35, 80109], [41, 80469], [45, 80709], [51, 81615], [53, 81741], [60, 82201], [62, 82681]]}, {"verse": 11, "start": 83727, "end": 94042, "text": "Entonces la gente, visto lo que Pablo había hecho, alzó la voz, diciendo en lengua licaónica: Dioses semejantes a hombres han descendido a nosotros.", "words": [[0, 83727], [9, 84187], [12, 84507], [19, 84907], [25, 85127], [28, 85347], [32, 85467], [38, 85867], [44, 86167], [51, 86620], [56, 87074], [59, 87527], [64, 88247], [73, 88707], [76, 88987], [83, 89809], [94, 90846], [101, 91293], [112, 91873], [114, 92073], [122, 92313], [126, 92673], [137, 93273], [139, 93353]]}, {"verse": 12, "start": 94392, "end": 100768, "text": "Y a Bernabé llamaban Júpiter, y a Pablo, Mercurio, porque era el que llevaba la palabra.", "words": [[0, 94392], [2, 94610], [4, 94864], [12, 95117], [21, 95577], [30, 96177], [32, 96417], [34, 96537], [41, 97617], [51, 98697], [58, 98877], [62, 99197], [65, 99377], [69, 99537], [77, 99937], [80, 100097]]}, {"verse": 13, "start": 101218, "end": 112307, "text": "Y el sacerdote de Júpiter, que estaba delante de la ciudad de ellos, trayendo toros y guirnaldas delante de las puertas, quería con el pueblo sacrificar.", "words": [[0, 101218], [2, 101355], [5, 101515], [15, 102255], [18, 102435], [27, 103395], [31, 103515], [38, 103795], [46, 104375], [49, 104575], [52, 104695], [59, 105035], [62, 105355], [69, 106135], [78, 106735], [84, 107355], [86, 107615], [97, 108435], [105, 108875], [108, 109035], [112, 109155], [121, 110055], [128, 110335], [132, 110695], [135, 110835], [142, 111295]]}, {"verse": 14, "start": 112757, "end": 121619, "text": "Y como lo oyeron los apóstoles Bernabé y Pablo, rotas sus ropas, se lanzaron hacia la multitud, dando voces,", "words": [[0, 112757], [2, 112878], [7, 113158], [10, 113378], [17, 113858], [21, 113998], [31, 114938], [39, 115478], [41, 115638], [48, 116368], [54, 117098], [58, 117278], [65, 118218], [68, 118358], [77, 118998], [83, 119318], [86, 119578], [96, 120618], [102, 120878]]}, {"verse": 15, "start": 122069, "end": 137894, "text": "Y diciendo: Varones, ¿por qué hacéis esto? Nosotros también somos hombres semejantes a vosotros, que os anunciamos que de estas vanidades os convirtáis al Dios vivo, que hizo el cielo y la tierra, y el mar, y todo lo que está en ellos:", "words": [[0, 122069], [2, 122193], [12, 123701], [21, 124151], [26, 124431], [30, 124711], [37, 124991], [43, 125957], [52, 126445], [60, 126785], [66, 127225], [74, 127745], [85, 128465], [87, 128665], [97, 129445], [101, 129705], [104, 129845], [115, 130445], [119, 130665], [122, 130825], [128, 131085], [138, 131665], [141, 131865], [152, 132545], [155, 132725], [160, 132925], [166, 133665], [170, 133765], [175, 134045], [178, 134245], [184, 134485], [186, 134685], [189, 134785], [197, 135105], [199, 135385], [202, 135505], [207, 136160], [209, 136288], [214, 136548], [217, 136788], [221, 136908], [226, 137128], [229, 137328]]}, {"verse": 16, "start": 138344, "end": 143107, "text": "El cual en las edades pasadas ha dejado a todas las gentes andar en sus caminos;", "words": [[0, 138344], [3, 138502], [8, 138742], [11, 138922], [15, 139082], [22, 139482], [30, 140082], [33, 140322], [40, 140742], [42, 140862], [48, 141062], [52, 141342], [59, 141782], [65, 142062], [68, 142262], [72, 142402]]}, {"verse": 17, "start": 143557, "end": 153168, "text": "Si bien no se dejó a sí mismo sin testimonio, haciendo bien, dándonos lluvias del cielo y tiempos fructíferos, llenando de alimento y de alegría nuestros corazones.", "words": [[0, 143557], [3, 143690], [8, 143910], [11, 144090], [14, 144230], [19, 144570], [21, 144690], [24, 144790], [30, 145150], [34, 145410], [46, 146450], [55, 146770], [61, 147570], [70, 148030], [78, 148410], [82, 148570], [88, 148890], [90, 149090], [98, 149470], [111, 150550], [120, 150910], [123, 151030], [132, 151410], [134, 151590], [137, 151650], [145, 152030], [154, 152190]]}, {"verse": 18, "start": 153518, "end": 160182, "text": "Y diciendo estas cosas, apenas apaciguaron el pueblo, para que no les ofreciesen sacrificio.", "words": [[0, 153518], [2, 153663], [11, 154103], [17, 154363], [24, 154903], [31, 155603], [43, 156623], [46, 156803], [54, 157263], [59, 158063], [63, 158223], [66, 158423], [70, 158813], [81, 159203]]}, {"verse": 19, "start": 160632, "end": 174287, "text": "Entonces sobrevinieron unos judíos de Antioquía y de Iconio, que persuadieron a la multitud, y habiendo apedreado a Pablo, le sacaron fuera de la ciudad, pensando que estaba muerto.", "words": [[0, 160632], [9, 161835], [23, 162895], [28, 163335], [35, 163935], [38, 164075], [48, 164835], [50, 164955], [53, 165075], [61, 166315], [65, 166375], [78, 167155], [80, 167315], [83, 167395], [93, 168075], [95, 168575], [104, 168835], [114, 169455], [116, 169595], [123, 170475], [126, 170555], [134, 171035], [140, 171355], [143, 171595], [146, 171735], [154, 172575], [163, 173015], [167, 173255], [174, 173515]]}, {"verse": 20, "start": 174737, "end": 182826, "text": "Pero rodeándole los discípulos, se levantó y entró en la ciudad; y un día después, salió con Bernabé a Derbe.", "words": [[0, 174737], [5, 174960], [16, 175960], [20, 176140], [32, 177120], [35, 177340], [43, 178040], [45, 178240], [51, 178660], [54, 178780], [57, 178900], [65, 179914], [67, 180022], [70, 180102], [74, 180282], [83, 180622], [89, 181382], [93, 181754], [101, 182126], [103, 182498]]}, {"verse": 21, "start": 183276, "end": 193095, "text": "Y cuando hubieron anunciado el evangelio a aquella ciudad, y enseñado a muchos, volvieron a Listra, y a Iconio, y a Antioquía,", "words": [[0, 183276], [2, 183397], [9, 183637], [18, 184037], [28, 184857], [31, 185017], [41, 185677], [43, 185817], [51, 186057], [59, 186437], [61, 187077], [70, 187737], [72, 187857], [80, 188757], [90, 189197], [92, 189637], [100, 190077], [102, 190577], [104, 190657], [112, 191577], [114, 191937], [116, 192017]]}, {"verse": 22, "start": 193545, "end": 205279, "text": "Fortaleciendo los ánimos de los discípulos, exhortándoles a que permaneciesen en la fe, y que es necesario que por muchas tribulaciones entremos en el reino de Dios.", "words": [[0, 193545], [14, 194332], [18, 194572], [25, 195032], [28, 195152], [32, 195292], [44, 197032], [58, 197552], [60, 197772], [64, 197912], [78, 198832], [81, 199052], [84, 199252], [88, 199952], [90, 200032], [94, 200172], [97, 200372], [107, 201232], [111, 201492], [115, 201712], [122, 202072], [136, 202912], [145, 203752], [148, 203932], [151, 204112], [157, 204552], [160, 204712]]}, {"verse": 23, "start": 205729, "end": 216740, "text": "Y habiéndoles constituido ancianos en cada una de las iglesias, y habiendo orado con ayunos, los encomendaron al Señor en el cual habían creído.", "words": [[0, 205729], [2, 205872], [14, 206492], [26, 207392], [35, 208112], [38, 208372], [43, 208652], [47, 209012], [50, 209172], [54, 209372], [64, 210172], [66, 210732], [75, 211152], [81, 211712], [85, 211952], [93, 213132], [97, 213232], [110, 214072], [113, 214272], [119, 214552], [122, 214912], [125, 215052], [130, 215312], [137, 215872]]}, {"verse": 24, "start": 217190, "end": 220160, "text": "Y pasando por Pisidia vinieron a Panfilia.", "words": [[0, 217190], [2, 217316], [10, 217656], [14, 217996], [22, 218676], [31, 219116], [33, 219651]]}, {"verse": 25, "start": 220610, "end": 225343, "text": "Y habiendo predicado la palabra en Perge, descendieron a Atalia;", "words": [[0, 220610], [2, 220730], [11, 221050], [21, 221770], [24, 221910], [32, 222437], [35, 222963], [42, 223490], [55, 224350], [57, 224550]]}, {"verse": 26, "start": 225793, "end": 233537, "text": "Y de allí navegaron a Antioquía, donde habían sido encomendados a la gracia de Dios para la obra que habían acabado.", "words": [[0, 225793], [2, 225940], [5, 226040], [10, 226360], [20, 227200], [22, 227300], [33, 228320], [39, 228580], [46, 228960], [51, 229300], [64, 230200], [66, 230380], [69, 230440], [76, 230940], [79, 231100], [84, 231340], [89, 231680], [92, 231880], [97, 232240], [101, 232500], [108, 232780]]}, {"verse": 27, "start": 233987, "end": 245211, "text": "Y habiendo llegado, y reunido la iglesia, relataron cuán grandes cosas había Dios hecho con ellos, y cómo había abierto a los Gentiles la puerta de la fe.", "words": [[0, 233987], [2, 234095], [11, 234455], [20, 234935], [22, 235035], [30, 235575], [33, 235715], [42, 236975], [52, 237655], [57, 238055], [65, 238515], [71, 239035], [77, 239615], [82, 239975], [88, 240255], [92, 240535], [99, 241295], [101, 241635], [106, 241895], [112, 242195], [120, 242755], [122, 242915], [126, 243035], [135, 243795], [138, 244255], [145, 244555], [148, 244775], [151, 244895]]}, {"verse": 28, "start": 245661, "end": 248921, "text": "Y se quedaron allí mucho tiempo con los discípulos.", "words": [[0, 245661], [2, 245788], [5, 245928], [14, 246468], [19, 246708], [25, 247108], [32, 247568], [36, 247908], [40, 248028]]}]}