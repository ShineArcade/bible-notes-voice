{"book": "PSA", "chapter": 32, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 91318, "verses": [{"verse": 1, "start": 300, "end": 8122, "text": "Salmo de David: Masquil. BIENAVENTURADO aquel cuyas iniquidades son perdonadas, y borrados sus pecados.", "words": [[0, 300], [6, 893], [9, 1052], [16, 2273], [25, 2994], [40, 3920], [46, 4340], [52, 4780], [64, 5720], [68, 6040], [80, 6900], [82, 7140], [91, 7660], [95, 7891]]}, {"verse": 2, "start": 8572, "end": 16657, "text": "Bienaventurado el hombre a quien no imputa Jehová la iniquidad, y en cuyo espíritu no hay engaño.", "words": [[0, 9559], [15, 10519], [18, 10659], [25, 10939], [27, 11159], [33, 11319], [36, 11659], [43, 12379], [50, 12939], [53, 13019], [64, 13819], [66, 14279], [69, 14419], [74, 14759], [83, 15439], [86, 15639], [90, 15839]]}, {"verse": 3, "start": 17107, "end": 21405, "text": "Mientras callé, se envejecieron mis huesos en mi gemir todo el día.", "words": [[0, 17107], [9, 17605], [16, 18135], [19, 18255], [32, 18955], [36, 19195], [43, 19675], [46, 19855], [49, 20015], [55, 20415], [60, 20655], [63, 20955]]}, {"verse": 4, "start": 21855, "end": 28906, "text": "Porque de día y de noche se agravó sobre mí tu mano; se volvió mi verdor en sequedades de verano. (Selah.)", "words": [[0, 21855], [7, 22083], [10, 22349], [14, 22616], [16, 22716], [19, 22856], [25, 23136], [28, 23416], [35, 23916], [41, 24156], [44, 24396], [47, 24536], [53, 25433], [56, 25575], [63, 25955], [66, 26095], [73, 26555], [76, 26915], [87, 27275], [90, 27435], [98, 28631]]}, {"verse": 5, "start": 29356, "end": 40607, "text": "Mi pecado te declaré, y no encubrí mi iniquidad. Confesaré, dije, contra mí mis rebeliones a Jehová; y tú perdonaste la maldad de mi pecado. (Selah.)", "words": [[0, 29356], [3, 29485], [10, 29945], [13, 30165], [22, 30805], [24, 31365], [27, 31545], [35, 32105], [38, 32265], [49, 33387], [60, 34010], [66, 34610], [73, 34850], [76, 35130], [80, 35510], [91, 35890], [