{"book": "GEN", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 159902, "verses": [{"verse": 1, "start": 300, "end": 8106, "text": "Subió, pues, Abram de Egipto hacia el sur, él, y su mujer, con todo lo que tenía, y con él Lot.", "words": [[0, 300], [7, 678], [13, 1108], [19, 1538], [22, 1898], [29, 2438], [35, 2598], [38, 2938], [43, 3638], [47, 4098], [49, 4678], [52, 4818], [59, 5538], [63, 5698], [68, 5878], [71, 6058], [75, 6158], [82, 7018], [84, 7118], [88, 7298], [91, 7458]]}, {"verse": 2, "start": 8456, "end": 12206, "text": "Y Abram era riquísimo en ganado, en plata y oro.", "words": [[0, 8456], [2, 8645], [8, 8871], [12, 9098], [22, 9671], [25, 10245], [33, 10818], [36, 11078], [42, 11458], [44, 11798]]}, {"verse": 3, "start": 12556, "end": 21115, "text": "Y volvió por sus jornadas desde el Neguev hacia Bet-el, hasta el lugar donde había estado antes su tienda entre Bet-el y Hai;", "words": [[0, 12556], [2, 12702], [9, 13102], [13, 13282], [17, 13482], [26, 14122], [32, 14762], [35, 15312], [42, 15862], [48, 16302], [56, 17202], [62, 17522], [65, 17742], [71, 18022], [77, 18282], [83, 18542], [90, 18822], [96, 19142], [99, 19402], [106, 19782], [112, 20002], [119, 20522], [121, 20844]]}, {"verse": 4, "start": 21465, "end": 28048, "text": "Al lugar del altar que había hecho allí antes: e invocó allí Abram el nombre de Jehová.", "words": [[0, 21465], [3, 21630], [9, 21930], [13, 22190], [19, 22610], [23, 22830], [29, 23090], [35, 23400], [40, 23710], [47, 24738], [49, 24882], [56, 25702], [61, 26042], [67, 26382], [70, 26762], [77, 27162], [80, 27382]]}, {"verse": 5, "start": 28398, "end": 34631, "text": "Y asimismo Lot, que andaba con Abram, tenía ovejas, y vacas, y tiendas.", "words": [[0, 28398], [2, 28885], [11, 29415], [16, 30075], [20, 30335], [27, 30735], [31, 30975], [38, 31525], [44, 32075], [52, 32715], [54, 33075], [61, 33615], [63, 33795]]}, {"verse": 6, "start": 34981, "end": 43918, "text": "Y la tierra no podía darles para que habitasen juntos: porque sus posesiones eran muchas, y no podían morar en un mismo lugar.", "words": [[0, 34981], [2, 35085], [5, 35205], [12, 35545], [15, 35845], [21, 36245], [28, 36785], [33, 37065], [37, 37265], [47, 37885], [55, 38920], [62, 39124], [66, 39344], [77, 40064], [82, 40364], [90, 40924], [92, 41604], [95, 41724], [102, 42104], [108, 42644], [111, 42824], [114, 42944], [120, 43304]]}, {"verse": 7, "start": 44268, "end": 54817, "text": "Y hubo contienda entre los pastores del ganado de Abram y los pastores del ganado de Lot: y el cananeo y el ferezeo habitaban entonces en la tierra.", "words": [[0, 44268], [2, 44533], [7, 44773], [17, 45413], [23, 45713], [27, 45893], [36, 46413], [40, 46673], [47, 47153], [50, 47413], [56, 47673], [58, 48273], [62, 48393], [71, 48933], [75, 49113], [82, 49480], [85, 49847], [90, 50386], [92, 50550], [95, 50690], [103, 51430], [105, 51550], [108, 51970], [116, 52390], [126, 53010], [135, 53570], [138, 53990], [141, 54150]]}, {"verse": 8, "start": 55167, "end": 63681, "text": "Entonces Abram dijo a Lot: No haya ahora altercado entre mí y ti, entre mis pastores y los tuyos, porque somos hermanos.", "words": [[0, 55167], [9, 55812], [15, 56457], [20, 57022], [22, 57262], [27, 57831], [30, 57992], [35, 58232], [41, 58552], [51, 59172], [57, 59452], [60, 59692], [62, 59892], [66, 60372], [72, 60532], [76, 60752], [85, 61272], [87, 61452], [91, 61592], [98, 62332], [105, 62572], [111, 62892]]}, {"verse": 9, "start": 64031, "end": 73233, "text": "¿No está toda la tierra delante de ti? Yo te ruego que te apartes de mí. Si vas a la mano izquierda, yo iré a la derecha: y si tú a la derecha, yo iré a la izquierda.", "words": [[0, 64031], [4, 64175], [9, 64435], [14, 64715], [17, 64895], [24, 65135], [32, 65615], [35, 65775], [39, 66306], [42, 66464], [45, 66604], [51, 66904], [55, 67064], [58, 67204], [66, 67684], [69, 67784], [73, 68286], [76, 68452], [80, 68652], [82, 68792], [85, 68852], 