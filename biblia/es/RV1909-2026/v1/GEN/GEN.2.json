{"book": "GEN", "chapter": 2, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 210724, "verses": [{"verse": 1, "start": 300, "end": 6039, "text": "Así quedaron terminados los cielos y la tierra, y todo lo que hay en ellos.", "words": [[0, 300], [4, 582], [13, 1102], [24, 1922], [28, 2202], [35, 3022], [37, 3222], [40, 3362], [48, 3762], [50, 4267], [55, 4567], [58, 4847], [62, 5027], [66, 5207], [69, 5447]]}, {"verse": 2, "start": 6389, "end": 14635, "text": "Y acabó Dios en el día séptimo su obra que hizo, y reposó el día séptimo de toda su obra que había hecho.", "words": [[0, 6389], [2, 6507], [8, 6987], [13, 7247], [16, 7507], [19, 7647], [23, 7847], [31, 8487], [34, 8727], [39, 9087], [43, 9287], [49, 10267], [51, 10737], [58, 11207], [61, 11347], [65, 11527], [73, 12307], [76, 12807], [81, 13047], [84, 13367], [89, 13627], [93, 13847], [99, 14087]]}, {"verse": 3, "start": 14985, "end": 23553, "text": "Y bendijo Dios al día séptimo, y lo santificó, porque en él reposó de toda su obra que había Dios creado y hecho.", "words": [[0, 14985], [2, 15106], [10, 15566], [15, 15846], [18, 16146], [22, 16346], [31, 17446], [33, 17706], [36, 17826], [47, 19106], [54, 19486], [57, 19686], [60, 19846], [67, 20446], [70, 20586], [75, 20786], [78, 21126], [83, 21406], [87, 21666], [93, 21926], [98, 22266], [105, 22826], [107, 23026]]}, {"verse": 4, "start": 23903, "end": 32278, "text": "Estos son los orígenes de los cielos y de la tierra cuando fueron creados, el día que Jehová Dios hizo la tierra y los cielos,", "words": [[0, 23903], [6, 24308], [10, 24548], [14, 24728], [23, 25428], [26, 25508], [30, 25648], [37, 26228], [39, 26348], [42, 26448], [45, 26588], [52, 27148], [59, 27328], [66, 27668], [75, 28428], [78, 28933], [82, 29173], [86, 29373], [93, 29873], [98, 30143], [103, 30413], [106, 30573], [113, 30953], [115, 31353], [119, 31513]]}, {"verse": 5, "start": 32628, "end": 46567, "text": "Y toda planta del campo antes que fuese en la tierra, y toda hierba del campo antes que naciese: porque aún no había Jehová Dios hecho llover sobre la tierra, ni había hombre para que labrase la tierra;", "words": [[0, 32628], [2, 32770], [7, 32950], [14, 33550], [18, 33690], [24, 34190], [30, 34650], [34, 34850], [40, 35230], [43, 35350], [46, 35510], [54, 35930], [56, 36570], [61, 36810], [68, 37370], [72, 37510], [78, 38030], [84, 38470], [88, 38710], [97, 39700], [104, 39925], [108, 40185], [111, 40405], [117, 40665], [124, 41305], [129, 41485], [135, 41945], [142, 42405], [148, 42705], [151, 42925], [159, 43387], [162, 43850], [168, 44130], [175, 44690], [180, 44990], [184, 45190], [192, 45710], [195, 45890]]}, {"verse": 6, "start": 46918, "end": 51711, "text": "Mas subía de la tierra un vapor, que regaba toda la faz de la tierra.", "words": [[0, 46918], [4, 47086], [10, 47526], [13, 47646], [16, 47786], [23, 48126], [26, 48366], [33, 48706], [37, 49006], [44, 49486], [49, 49806], [52, 50126], [56, 50426], [59, 50886], [62, 51006]]}, {"verse": 7, "start": 52061, "end": 61685, "text": "Formó, pues, Jehová Dios al hombre del polvo de la tierra, y sopló en su nariz aliento de vida; y fue el hombre un ser viviente.", "words": [[0, 52061], [7, 52500], [13, 52851], [20, 53202], [25, 53553], [28, 53904], [35, 54255], [39, 54435], [45, 54975], [48, 55095], [51, 55235], [59, 55655], [61, 56060], [67, 56700], [70, 56860], [73, 57080], [79, 57540], [87, 58060], [90, 58320], [96, 59010], [98, 59106], [102, 59326], [105, 59606], [112, 59966], [115, 60366], [119, 60706]]}, {"verse": 8, "start": 62035, "end": 69021, "text": "Y había Jehová Dios plantado un huerto en Edén al oriente, y puso allí al hombre que había formado.", "words": [[0, 62035], [2, 62161], [8, 62401], [15, 62981], [20, 63181], [29, 64041], [32, 64241], [39, 64681], [42, 65021], [47, 65261], [50, 65641], [59, 66181], [61, 66721], [66, 67061], [71, 67301], [74, 67521], [81, 67761], [85, 67981], [91, 68201]]}, {"verse": 9, "start": 69371, "end": 82847, "text": "Y había Jehová Dios hecho nacer de la tierra todo árbol delicioso a la vista, y bueno para comer: también el árbol de vida en medio del huerto, y el árbol del conocimiento del bien y del mal.", "words": [[0, 69371], [2, 69507], [8, 69727], [15, 70347], [20, 70567], [26, 71007], [32, 71527], [35, 71667], [38, 71807], [45, 72167], [50, 72527], [56, 73187], [66, 73987], [68, 74167], [71, 74227], [78, 74607], [80, 75152], [86, 75472], [91, 75792], [98, 76664], [106, 77028], [109, 77368], [115, 77728], [118, 77888], [123, 78188], [126, 78368], [132, 78648], [136, 78848], [144, 79308], [146, 79743], [149, 79883], [155, 80243], [159, 80443], [172, 81303], [176, 81523], [181, 81843], [183, 82143], [187, 82263]]}, {"verse": 10, "start": 83197, "end": 90927, "text": "Y salía de Edén un río para regar el huerto, y de allí se repartía en cuatro ramales.", "words": [[0, 83197], [2, 83342], [8, 83782], [11, 83942], [16, 84322], [19, 84742], [23, 85122], [28, 85362], [34, 85962], [37, 86082], [45, 86542], [47, 87182], [50, 87322], [55, 87642], [58, 88062], [67, 88942], [70, 89282], [77, 89762]]}, {"verse": 11, "start": 91277, "end": 97642, "text": "El nombre del uno era Pisón: este es el que cerca toda la tierra de Havila, donde hay oro:", "words": [[0, 91277], [3, 91417], [10, 91817], [14, 92077], [18, 92297], [22, 92537], [29, 93482], [34, 93774], [37, 93994], [40, 94154], [44, 94274], [50, 94614], [55, 94954], [58, 95194], [65, 95414], [68, 95954], [76, 96494], [82, 96714], [86, 96994]]}, {"verse": 12, "start": 97992, "end": 102247, "text": "Y el oro de aquella tierra es bueno: hay allí también bedelio y ónice.", "words": [[0, 97992], [2, 98109], [5, 98269], [9, 98449], [12, 98649], [20, 98969], [27, 99269], [30, 99469], [37, 100196], [41, 100396], [46, 100596], [54, 100916], [62, 101536], [64, 101910]]}, {"verse": 13, "start": 102597, "end": 109098, "text": "El nombre del segundo río es Gihón: este es el que rodea toda la tierra de Etiopía.", "words": [[0, 102597], 