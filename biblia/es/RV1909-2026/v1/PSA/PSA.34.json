37], [42, 106097], [51, 107277], [53, 107405], [61, 108105], [63, 108305], [67, 108445], [77, 109125], [80, 109285]]}, {"verse": 19, "start": 110437, "end": 116116, "text": "Muchos son los males del justo; pero de todos ellos lo librará Jehová.", "words": [[0, 110437], [7, 110881], [11, 111081], [15, 111221], [21, 111561], [25, 111821], [32, 112712], [37, 112856], [40, 113016], [46, 113256], [52, 113656], [55, 114096], [63, 114736]]}, {"verse": 20, "start": 116566, "end": 120727, "text": "Él guarda todos sus huesos; ni uno de ellos será quebrantado.", "words": [[0, 116566], [3, 116566], [10, 117067], [16, 117287], [20, 117627], [28, 118749], [31, 118859], [35, 119119], [38, 119279], [44, 119519], [49, 119799]]}, {"verse": 21, "start": 121177, "end": 126428, "text": "Matará al malo la maldad; y los que aborrecen al justo serán asolados.", "words": [[0, 121177], [7, 121666], [10, 121946], [15, 122366], [18, 122526], [26, 123494], [28, 123597], [32, 123717], [36, 123857], [46, 124457], [49, 124637], [55, 124897], [61, 125457]]}, {"verse": 22, "start": 126878, "end": 133486, "text": "Jehová redime el alma de sus siervos; y no serán asolados cuantos en él confían.", "words": [[0, 126878], [7, 127501], [14, 128261], [17, 128461], [22, 128741], [25, 128901], [29, 129081], [38, 130163], [40, 130270], [43, 130410], [49, 130870], [58, 131590], [66, 132190], [69, 132350], [72, 132510]]}]}