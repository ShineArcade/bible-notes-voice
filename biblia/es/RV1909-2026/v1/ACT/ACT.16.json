{"book": "ACT", "chapter": 16, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 365941, "verses": [{"verse": 1, "start": 300, "end": 11057, "text": "Después llegó a Derbe, y a Listra: y he aquí, estaba allí un discípulo llamado Timoteo, hijo de una mujer judía fiel, pero de padre griego.", "words": [[0, 300], [8, 729], [14, 1289], [16, 1529], [23, 1989], [25, 2425], [27, 2861], [35, 3552], [37, 3687], [40, 3857], [46, 4257], [53, 4837], [58, 5157], [61, 5317], [71, 5917], [79, 6197], [88, 7517], [93, 7837], [96, 8037], [100, 8177], [106, 8517], [112, 9017], [118, 9797], [123, 9937], [126, 10097], [132, 10357]]}, {"verse": 2, "start": 11507, "end": 16396, "text": "De este daban buen testimonio los hermanos que estaban en Listra y en Iconio.", "words": [[0, 11507], [3, 11692], [8, 12072], [14, 12592], [19, 12832], [30, 13552], [34, 13612], [43, 14232], [47, 14332], [55, 14592], [58, 14812], [65, 15352], [67, 15492], [70, 15632]]}, {"verse": 3, "start": 16846, "end": 29222, "text": "Este quiso Pablo que fuese con él; y tomándole, le circuncidó por causa de los judíos que estaban en aquellos lugares; porque todos sabían que su padre era griego.", "words": [[0, 16966], [5, 17086], [11, 17446], [17, 18026], [21, 18146], [27, 18486], [31, 18746], [35, 20314], [37, 20418], [48, 21158], [51, 21698], [62, 22578], [66, 22838], [72, 23118], [75, 23438], [79, 23558], [86, 24118], [90, 24258], [98, 24618], [101, 24838], [110, 25118], [119, 26409], [126, 26754], [132, 27074], [139, 27614], [143, 27774], [146, 27934], [152, 28254], [156, 28514]]}, {"verse": 4, "start": 29672, "end": 39628, "text": "Y como pasaban por las ciudades, les daban que guardasen los decretos que habían sido determinados por los apóstoles y los ancianos que estaban en Jerusalén.", "words": [[0, 29672], [2, 29793], [7, 30033], [15, 30633], [19, 30853], [23, 31013], [33, 32033], [37, 32453], [43, 32813], [47, 32993], [57, 33653], [61, 33833], [70, 34433], [74, 34553], [81, 34813], [86, 35193], [99, 35993], [103, 36213], [107, 36373], [117, 37033], [119, 37453], [123, 37613], [132, 38193], [136, 38313], [144, 38613], [147, 38773]]}, {"verse": 5, "start": 40078, "end": 46516, "text": "Así que, las iglesias eran fortalecidas en la fe, y eran aumentadas en número cada día.", "words": [[0, 40078], [4, 40271], [9, 40491], [13, 40671], [22, 41251], [27, 41471], [40, 42531], [43, 42751], [46, 42891], [50, 43171], [52, 43651], [57, 43931], [68, 44931], [71, 45231], [78, 45611], [83, 45931]]}, {"verse": 6, "start": 46966, "end": 54891, "text": "Y pasando a Frigia y la provincia de Galacia, les fue prohibido por el Espíritu Santo hablar la palabra en Asia.", "words": [[0, 46966], [2, 47090], [10, 47470], [12, 47810], [19, 48430], [21, 48550], [24, 48690], [34, 49290], [37, 49430], [46, 50190], [50, 50690], [54, 50910], [64, 51670], [68, 51870], [71, 52010], [80, 52610], [86, 52910], [93, 53350], [96, 53710], [104, 54090], [107, 54330]]}, {"verse": 7, "start": 55341, "end": 61051, "text": "Y cuando vinieron a Misia, intentaron ir a Bitinia; pero el Espíritu no les dejó.", "words": [[0, 55341], [2, 55448], [9, 55648], [18, 56208], [20, 56568], [27, 56928], [38, 58088], [41, 58288], [43, 58731], [52, 59412], [57, 59575], [60, 59695], [69, 60255], [72, 60375], [76, 60555]]}, {"verse": 8, "start": 61501, "end": 64648, "text": "Y pasando a Misia, descendieron a Troas.", "words": [[0, 61501], [2, 61606], [10, 61926], [12, 62526], [19, 63126], [32, 63746], [34, 63906]]}, {"verse": 9, "start": 65098, "end": 75195, "text": "Y fue mostrada a Pablo de noche una visión: Un varón macedonio se puso delante, rogándole, y diciendo: Pasa a Macedonia, y ayúdanos.", "words": [[0, 65098], [2, 65205], [6, 65365], [15, 65945], [17, 66225], [23, 66625], [26, 66805], [32, 67085], [36, 67345], [44, 68398], [47, 68544], [53, 68944], [63, 69664], [66, 69844], [71, 70184], [80, 71084], [91, 71944], [93, 72184], [103, 73174], [108, 73416], [110, 73576], [121, 74176], [123, 74436]]}, {"verse": 10, "start": 75545, "end": 85880, "text": "Y cuando vio la visión, luego procuramos partir a Macedonia, dando por cierto que Dios nos llamaba para que les anunciásemos el evangelio.", "words": [[0, 75545], [2, 75652], [9, 75852], [13, 76152], [16, 76272], [24, 77272], [30, 77712], [41, 78492], [48, 78952], [50, 79132], [61, 80332], [67, 80632], [71, 80892], [78, 81192], [82, 81512], [87, 81772], [91, 82172], [99, 82772], [104, 83332], [108, 83512], [112, 83732], [125, 84872], [128, 85032]]}, {"verse": 11, "start": 86330, "end": 93394, "text": "Habiendo partido, pues, de Troas, vinimos camino derecho a Samotracia, y el día siguiente a Neápolis;", "words": [[0, 86330], [9, 86677], [18, 87117], [24, 87497], [27, 88017], [34, 88617], [42, 89357], [49, 89637], [57, 90097], [59, 90627], [71, 91157], [73, 91517], [76, 91677], [80, 91797], [90, 92177], [92, 92537]]}, {"verse": 12, "start": 93844, "end": 103395, "text": "Y de allí a Filipos, que es la primera ciudad de la parte de Macedonia, y una colonia; y estuvimos en aquella ciudad algunos días.", "words": [[0, 93844], [2, 93991], [5, 94071], [10, 94331], [12, 94591], [21, 95631], [25, 95831], [28, 96011], [31, 96251], [39, 96551], [46, 97051], [49, 97371], [52, 97471], [58, 97791], [61, 97991], [72, 98751], [74, 99151], [78, 99351], [87, 100456], [89, 100592], [99, 101132], [102, 101392], [110, 101772], [117, 102132], [125, 102492]]}, {"verse": 13, "start": 103845, "end": 113964, "text": "Y un día de sábado salimos de la puerta junto al río, donde solía hacerse la oración; y sentándonos, hablamos a las mujeres que se habían reunido.", "words": [[0, 103845], [2, 103941], [5, 104061], [9, 104301], [12, 104461], [19, 104961], [27, 105441], [30, 105601], [33, 105721], [40, 106061], [46, 106361], [49, 106701], [54, 107081], [60, 107601], [66, 108201], [74, 108741], [77, 108921], [86, 110030], [88, 110332], [101, 111092], [110, 111812], [112, 111972], [116, 112072], [124, 112412], [128, 112652], [131, 112812], [138, 113092]]}, {"verse": 14, "start": 114414, "end": 129082, "text": "Entonces una mujer llamada Lidia, que vendía púrpura en la ciudad de Tiatira, temerosa de Dios, estaba oyendo; el corazón de la cual abrió el Señor para que estuviese atenta a lo que Pablo decía.", "words": [[0, 114414], [9, 114931], [13, 115611], [19, 115951], [27, 116711], [34, 117471], [38, 117511], [45, 117931], [53, 118791], [56, 118931], [59, 119071], [66, 119411], [69, 119911], [78, 120411], [87, 121091], [90, 121291], [96, 122131], [103, 122451], [111, 123569], [114, 123710], [122, 124150], [125, 124390], [128, 124510], [133, 124690], [139, 125150], [142, 125290], [148, 125590], [153, 125930], [157, 126280], [167, 126630], [174, 127410], [176, 127650], [179, 127770], [183, 127910], [189, 128270]]}, {"verse": 15, "start": 129532, "end": 141058, "text": "Y cuando fue bautizada, y su familia, nos rogó, diciendo: Si habéis juzgado que yo sea fiel al Señor, entrad en mi casa, y alojaos: y nos insistió.", "words": [[0, 129532], [2, 129807], [9, 130027], [13, 130307], [24, 131087], [26, 131287], [29, 131427], [38, 131947], [42, 132467], [48, 133027], [58, 134212], [61, 134452], [68, 134852], [76, 135392], [80, 135632], [83, 135832], [87, 136052], [92, 136432], [95, 136552], [102, 137005], [109, 137459], [112, 137912], [115, 138072], [121, 138452], [123, 138912], [132, 140031], [134, 140159], [138, 140259]]}, {"verse": 16, "start": 141408, "end": 153833, "text": "Y aconteció, que yendo nosotros a la oración, una muchacha que tenía espíritu de adivinación, nos salió al encuentro, la cual daba grande ganancia a sus amos adivinando.", "words": [[0, 141408], [2, 141514], [13, 142294], [17, 142674], [23, 142994], [32, 143394], [34, 143794], [37, 143854], [46, 144954], [50, 145134], [59, 145734], [63, 145914], [69, 146274], [78, 146954], [81, 147054], [94, 147914], [98, 148394], [104, 148974], [107, 149274], [118, 150374], [121, 150474], [126, 150674], [131, 151034], [138, 151414], [147, 152094], [149, 152354], [153, 152454], [158, 152894]]}, {"verse": 17, "start": 154283, "end": 167026, "text": "Esta, siguiendo a Pablo y a nosotros, daba voces, diciendo: Estos hombres son siervos del Dios Alto, los cuales os anuncian el camino de salvación.", "words": [[0, 154283], [6, 154691], [16, 155671], [18, 155851], [24, 156251], [26, 156491], [28, 156571], [38, 157391], [43, 157831], [50, 158431], [60, 159726], [66, 160106], [74, 160486], [78, 160786], [86, 161226], [90, 161446], [95, 161726], [101, 162626], [105, 162726], [112, 163126], [115, 163326], [124, 163986], [127, 164106], [134, 164366], [137, 164566]]}, {"verse": 18, "start": 167376, "end": 179166, "text": "Y esto hacía por muchos días; pero desagradando a Pablo, se volvió y dijo al espíritu: Te mando en el nombre de Jesucristo, que salgas de ella. Y salió en la misma hora.", "words": [[0, 167376], [2, 167532], [7, 167812], [13, 168172], [17, 168412], [24, 168672], [30, 169732], [35, 169897], [48, 170797], [50, 170937], [57, 171817], [60, 171917], [67, 172317], [69, 172397], [74, 172697], [77, 172797], [87, 173760], [90, 173861], [96, 174201], [99, 174301], [102, 174401], [109, 174681], [112, 174821], [124, 175601], [128, 175881], [135, 176321], [138, 176501], [144, 177258], [146, 177409], [152, 177809], [155, 178089], [158, 178229], [164, 178509]]}, {"verse": 19, "start": 179616, "end": 187948, "text": "Y viendo sus amos que se había ido la esperanza de su ganancia, prendieron a Pablo y a Silas, y los trajeron al foro, al magistrado;", "words": [[0, 179616], [2, 179721], [9, 179981], [13, 180201], [18, 180641], [22, 180741], [25, 180881], [31, 181061], [35, 181341], [38, 181521], [48, 182181], [51, 182341], [54, 182521], [64, 183181], [75, 183681], [77, 183861], [83, 184161], [85, 184341], [87, 184461], [94, 184901], [96, 185381], [100, 185501], [109, 186081], [112, 186201], [118, 186981], [121, 187061]]}, {"verse": 20, "start": 188398, "end": 195691, "text": "Y presentándolos a los magistrados, dijeron: Estos hombres, siendo judíos, alborotan nuestra ciudad,", "words": [[0, 188398], [2, 188543], [17, 189883], [19, 189983], [23, 190123], [36, 191263], [45, 192253], [51, 192601], [60, 192961], [67, 193241], [75, 194181], [85, 194761], [93, 194921]]}, {"verse": 21, "start": 196141, "end": 201768, "text": "Y predican ritos, los cuales no nos es lícito recibir ni hacer, pues somos Romanos.", "words": [[0, 196141], [2, 196415], [11, 196725], [18, 197545], [22, 197665], [29, 197945], [32, 198265], [36, 198465], [39, 198625], [46, 199045], [54, 199485], [57, 199805], [64, 200545], [69, 200685], [75, 200985]]}, {"verse": 22, "start": 202118, "end": 210934, "text": "Y se agolpó el pueblo contra ellos: y los magistrados rompiéndoles sus ropas, les mandaron azotar con varas.", "words": [[0, 202118], [2, 202258], [5, 202398], [12, 203078], [15, 203178], [22, 203518], [29, 203998], [36, 205022], [38, 205245], [42, 205365], [54, 206145], [67, 207385], [71, 207625], [78, 208705], [82, 208805], [91, 209425], [98, 210045], [102, 210205]]}, {"verse": 23, "start": 211384, "end": 219938, "text": "Y después que los hubieron herido de muchos azotes, los echaron en la cárcel, mandando al carcelero que los guardase con diligencia:", "words": [[0, 211384], [2, 211489], [10, 211809], [14, 212009], [18, 212129], [27, 212579], [34, 213029], [37, 213169], [44, 213389], [52, 214449], [56, 214849], [64, 215369], [67, 215529], [70, 215669], [78, 216109], [87, 216669], [90, 217229], [100, 217869], [104, 218019], [108, 218169], [117, 218689], [121, 218869]]}, {"verse": 24, "start": 220388, "end": 228811, "text": "El cual, recibido este mandamiento, los metió en la cárcel de más adentro; y les aseguró los pies en el cepo.", "words": [[0, 220388], [3, 220538], [9, 221218], [18, 221918], [23, 222118], [36, 223318], [40, 223538], [46, 223978], [49, 224098], [52, 224218], [59, 224678], [62, 224858], [66, 225038], [75, 226074], [77, 226237], [81, 226457], [89, 227417], [93, 227577], [98, 227817], [101, 228077], [104, 228197]]}, {"verse": 25, "start": 229261, "end": 236761, "text": "Pero a media noche, orando Pablo y Silas, cantaban himnos a Dios: y los que estaban presos los oían.", "words": [[0, 229261], [5, 229425], [7, 229765], [13, 230105], [20, 230445], [27, 230985], [33, 231425], [35, 231665], [42, 232345], [51, 232865], [58, 233305], [60, 233425], [66, 234278], [68, 234388], [72, 234528], [76, 234688], [84, 234988], [91, 235748], [95, 236008]]}, {"verse": 26, "start": 237211, "end": 250158, "text": "Entonces fue hecho de repente un gran terremoto, de tal manera que los cimientos de la cárcel se movían; y luego todas las puertas se abrieron, y las ataduras de todos se soltaron.", "words": [[0, 237211], [9, 237817], [13, 238417], [19, 238717], [22, 239017], [30, 239457], [33, 239637], [38, 239897], [49, 241037], [52, 241157], [56, 241397], [63, 241757], [67, 241997], [71, 242157], [81, 242797], [84, 242957], [87, 243097], [94, 243637], [97, 244057], [105, 245134], [107, 245256], [113, 245496], [119, 245816], [123, 246076], [131, 246516], [134, 246716], [144, 247256], [146, 247656], [150, 247816], [159, 248416], [162, 248556], [168, 248856], [171, 249196]]}, {"verse": 27, "start": 250608, "end": 259838, "text": "Y despertado el carcelero, cuando vio abiertas las puertas de la cárcel, sacando la espada se quería matar, pensando que los presos se habían huido.", "words": [[0, 250608], [2, 250726], [13, 251426], [16, 251546], [27, 252226], [34, 252546], [38, 252966], [47, 253606], [51, 253746], [59, 254186], [62, 254306], [65, 254406], [73, 255126], [81, 255666], [84, 255806], [91, 256206], [94, 256406], [101, 256686], [108, 257386], [117, 257726], [121, 258006], [125, 258146], [132, 258566], [135, 258766], [142, 259066]]}, {"verse": 28, "start": 260288, "end": 266535, "text": "Pero Pablo clamó a gran voz, diciendo: No te hagas ningún mal; que todos estamos aquí.", "words": [[0, 260288], [5, 260592], [11, 261222], [17, 261852], [19, 261952], [24, 262132], [29, 262452], [39, 263601], [42, 263807], [45, 263967], [51, 264247], [58, 264487], [63, 265260], [67, 265361], [73, 265581], [81, 266001]]}, {"verse": 29, "start": 266885, "end": 275376, "text": "Él entonces pidiendo luz, entró dentro, y temblando, se postró a los pies de Pablo y de Silas;", "words": [[0, 266885], [3, 267132], [12, 268492], [21, 268892], [26, 269872], [32, 270332], [40, 270752], [42, 271492], [53, 272552], [56, 272692], [63, 273232], [65, 273432], [69, 273572], [74, 273812], [77, 273972], [83, 274372], [85, 274552], [88, 274732]]}, {"verse": 30, "start": 275826, "end": 280297, "text": "Y sacándolos fuera, les dice: Señores, ¿qué debo hacer para ser salvo?", "words": [[0, 275826], [2, 276115], [13, 276445], [20, 276825], [24, 277165], [30, 277997], [39, 278801], [44, 278861], [49, 279101], [55, 279361], [60, 279571], [64, 279781]]}, {"verse": 31, "start": 280647, "end": 285857, "text": "Y ellos dijeron: Cree en el Señor Jesucristo, y serás salvo tú, y tu casa.", "words": [[0, 280647], [2, 280813], [8, 280993], [17, 282123], [22, 282249], [25, 282376], [28, 282476], [34, 282716], [46, 283476], [48, 283816], [54, 284156], [60, 284656], [64, 284876], [66, 285236], [69, 285336]]}, {"verse": 32, "start": 286207, "end": 291054, "text": "Y le hablaron la palabra del Señor, y a todos los que estaban en su casa.", "words": [[0, 286207], [2, 286369], [5, 286449], [14, 287009], [17, 287169], [25, 287549], [29, 287809], [36, 288189], [38, 289049], [40, 289169], [46, 289369], [50, 289589], [54, 289749], [62, 290049], [65, 290309], [68, 290469]]}, {"verse": 33, "start": 291504, "end": 301580, "text": "Y tomándolos en aquella misma hora de la noche, les lavó las heridas de los azotes; y se bautizó luego él, y todos los suyos.", "words": [[0, 291504], [2, 291816], [13, 292556], [16, 292716], [24, 293136], [30, 293416], [35, 293796], [38, 293956], [41, 294076], [48, 294936], [52, 295196], [57, 295856], [61, 296156], [69, 296716], [72, 296896], [76, 297036], [84, 298250], [86, 298395], [89, 298765], [97, 299135], [103, 299295], [107, 299775], [109, 300315], [115, 300615], [119, 300875]]}, {"verse": 34, "start": 302030, "end": 308831, "text": "Y llevándolos a su casa, les puso la mesa: y se gozó de que con toda su casa había creído a Dios.", "words": [[0, 302030], [2, 302132], [14, 302772], [16, 302872], [19, 303012], [25, 303522], [29, 304032], [34, 304352], [37, 304492], [43, 305286], [45, 305430], [48, 305570], [53, 306030], [56, 306250], [60, 306390], [64, 306630], [69, 306910], [72, 307150], [77, 307470], [83, 307730], [90, 308230], [92, 308390]]}, {"verse": 35, "start": 309281, "end": 316721, "text": "Y como fue de día, los magistrados enviaron los alguaciles, diciendo: Deja ir a aquellos hombres.", "words": [[0, 309281], [2, 309404], [7, 309664], [11, 309964], [14, 310124], [19, 311164], [23, 311384], [35, 312204], [44, 312944], [48, 313444], [60, 313944], [70, 315069], [75, 315354], [78, 315594], [80, 315734], [89, 315974]]}, {"verse": 36, "start": 317071, "end": 326630, "text": "Y el carcelero hizo saber estas palabras a Pablo: Los magistrados han enviado a decir que seáis sueltos: así que ahora salid, e id en paz.", "words": [[0, 317071], [2, 317215], [5, 317375], [15, 318115], [20, 318595], [26, 319495], [32, 319775], [41, 320255], [43, 320535], [50, 321359], [54, 321466], [66, 322146], [70, 322366], [78, 322826], [80, 322926], [86, 323186], [90, 323426], [96, 323746], [105, 324727], [109, 324948], [113, 325128], [119, 325408], [126, 325688], [128, 325888], [131, 326088], [134, 326208]]}, {"verse": 37, "start": 326980, "end": 340484, "text": "Entonces Pablo les dijo: Azotados públicamente sin ser condenados, siendo hombres Romanos, nos echaron en la cárcel; y ¿ahora nos echan encubiertamente? No, de cierto, sino vengan ellos y sáquennos.", "words": [[0, 326980], [9, 327420], [15, 328100], [19, 328440], [25, 329280], [34, 329823], [47, 330563], [51, 330823], [55, 331003], [67, 332023], [74, 332383], [82, 332823], [91, 333723], [95, 333823], [103, 334303], [106, 334443], [109, 334543], [117, 335473], [119, 335593], [126, 335773], [130, 335993], [136, 336293], [153, 337654], [157, 337964], [160, 338310], [168, 338657], [173, 338917], [180, 339337], [186, 339577], [188, 339777]]}, {"verse": 38, "start": 340834, "end": 348208, "text": "Y los alguaciles volvieron a decir a los magistrados estas palabras: y tuvieron miedo, oído que eran Romanos.", "words": [[0, 340834], [2, 340935], [6, 341375], [17, 341815], [27, 342815], [29, 342935], [35, 343235], [37, 343415], [41, 343555], [53, 344315], [59, 344615], [69, 345759], [71, 345865], [80, 346245], [87, 346645], [92, 347065], [96, 347265], [101, 347425]]}, {"verse": 39, "start": 348658, "end": 354687, "text": "Y viniendo, les rogaron; y sacándolos, les pidieron que se saliesen de la ciudad.", "words": [[0, 348658], [2, 348801], [12, 349361], [16, 349861], [25, 351136], [27, 351221], [39, 351881], [43, 352541], [52, 353001], [56, 353141], [59, 353281], [68, 353781], [71, 353941], [74, 354061]]}, {"verse": 40, "start": 355137, "end": 365541, "text": "Entonces salidos de la cárcel, entraron en casa de Lidia; y habiendo visto a los hermanos, los animaron, y se salieron.", "words": [[0, 355137], [9, 355984], [17, 356524], [20, 356684], [23, 356784], [31, 357644], [40, 358504], [43, 358624], [48, 358864], [51, 359104], [58, 360109], [60, 360413], [69, 360753], [75, 361053], [77, 361233], [81, 361353], [91, 362013], [95, 362333], [105, 363033], [107, 363613], [110, 363713]]}]}