{"book": "GEN", "chapter": 31, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 477447, "verses": [{"verse": 1, "start": 300, "end": 10839, "text": "Y oía él las palabras de los hijos de Labán, que decían: Jacob ha tomado todo lo que era de nuestro padre; y de lo que era de nuestro padre ha adquirido toda esta grandeza.", "words": [[0, 300], [2, 502], [6, 842], [9, 1222], [13, 1382], [22, 1742], [25, 2002], [29, 2102], [35, 2402], [38, 2582], [45, 3002], [49, 3442], [57, 4568], [63, 4937], [66, 5257], [73, 5657], [78, 5897], [81, 6117], [85, 6277], [89, 6437], [92, 6557], [100, 6717], [107, 7624], [109, 7706], [112, 7806], [115, 7926], [119, 8086], [123, 8266], [126, 8386], [134, 8566], [140, 9246], [143, 9326], [153, 9766], [158, 9946], [163, 10206]]}, {"verse": 2, "start": 11189, "end": 17442, "text": "Miraba también Jacob el semblante de Labán, y veía que no era para con él como ayer y antes de ayer.", "words": [[0, 11189], [7, 11574], [15, 11894], [21, 12334], [24, 12634], [34, 13214], [37, 13394], [44, 13814], [46, 14194], [51, 14514], [55, 14674], [58, 14854], [62, 15014], [67, 15234], [71, 15474], [74, 15634], [79, 15874], [84, 16274], [86, 16514], [92, 16834], [95, 17034]]}, {"verse": 3, "start": 17892, "end": 26059, "text": "También Jehová dijo a Jacob: Vuélvete a la tierra de tus padres, y a tu parentela; que yo seré contigo.", "words": [[0, 17892], [8, 18156], [15, 19056], [20, 19246], [22, 19436], [29, 20324], [38, 20905], [40, 21045], [43, 21145], [50, 21485], [53, 21685], [57, 21865], [65, 22325], [67, 22945], [69, 23065], [72, 23185], [83, 24566], [87, 24666], [90, 24826], [95, 25166]]}, {"verse": 4, "start": 26409, "end": 31609, "text": "Y envió Jacob, y llamó a Raquel y a Lea al campo a sus ovejas,", "words": [[0, 26409], [2, 26556], [8, 26956], [15, 27336], [17, 28136], [23, 28496], [25, 28616], [32, 28996], [34, 29296], [36, 29596], [40, 29896], [43, 30156], [49, 30556], [51, 30696], [55, 30796]]}, {"verse": 5, "start": 32059, "end": 40069, "text": "Y les dijo: Veo que el semblante de vuestro padre no es para conmigo como ayer y antes de ayer: mas el Dios de mi padre ha sido conmigo.", "words": [[0, 32059], [2, 32203], [6, 32343], [12, 33152], [16, 33431], [20, 33551], [23, 33651], [33, 34171], [36, 34291], [44, 34611], [50, 34931], [53, 35211], [56, 35411], [61, 35571], [69, 36051], [74, 36271], [79, 36611], [81, 36851], [87, 37131], [90, 37311], [96, 37970], [100, 38110], [103, 38290], [108, 38490], [111, 38670], [114, 38790], [120, 39190], [123, 39270], [128, 39430]]}, {"verse": 6, "start": 40519, "end": 44463, "text": "Y vosotras sabéis que con todas mis fuerzas he servido a vuestro padre:", "words": [[0, 40519], [2, 40640], [11, 41120], [18, 41480], [22, 41620], [26, 41820], [32, 42020], [36, 42280], [44, 42860], [47, 43060], [55, 43520], [57, 43620], [65, 43960]]}, {"verse": 7, "start": 44913, "end": 51956, "text": "Y vuestro padre me ha engañado, y me ha cambiado el salario diez veces: pero Dios no le ha permitido que me hiciese mal.", "words": [[0, 44913], [2, 45016], [10, 45336], [16, 45636], [19, 45896], [22, 45976], [32, 46576], [34, 46916], [37, 47036], [40, 47156], [49, 47616], [52, 47716], [60, 48156], [65, 48316], [72, 49348], [77, 49489], [82, 49709], [85, 50029], [88, 50169], [91, 50249], [101, 50869], [105, 50989], [108, 51149], [116, 51529]]}, {"verse": 8, "start": 52406, "end": 65345, "text": "Si él decía así: Los pintados serán tu salario; entonces todas las ovejas parían pintados: y si decía así: Los listados serán tu salario; entonces todas las ovejas parían listados.", "words": [[0, 52406], [3, 52626], [6, 52786], [12, 53066], [17, 53967], [21, 54068], [30, 54608], [36, 54968], [39, 55088], [48, 56023], [57, 56720], [63, 56880], [67, 57180], [74, 57560], [81, 57960], [91, 59100], [93, 59258], [96, 59338], [102, 59738], [107, 60551], [111, 60860], [120, 61210], [126, 61570], [129, 61670], [138, 62571], [147, 63036], [153, 63376], [157, 63716], [164, 64156], [171, 64556]]}, {"verse": 9, "start": 65795, "end": 71411, "text": "Así quitó Dios el ganado de vuestro padre, y me lo dio a mí.", "words": [[0, 65795], [4, 66031], [10, 66371], [15, 66691], [18, 66871], [25, 67271], [28, 67391], [36, 67711], [43, 68231], [45, 68411], [48, 68551], [51, 68691], [55, 68851], [57, 69031]]}, {"verse": 10, "start": 71861, "end": 83250, "text": "Y sucedió que al tiempo que las ovejas estaban en celo, alcé yo mis ojos y vi en sueños, y he aquí los machos que cubrían a las hembras eran listados, pintados y abigarrados.", "words": [[0, 71861], [2, 71966], [10, 72426], [14, 72606], [17, 72746], [24, 73066], [28, 73326], [32, 73486], [39, 73906], [47, 74366], [50, 74606], [56, 74993], [61, 75379], [64, 75766], [68, 75926], [73, 76266], [75, 76646], [78, 76826], [81, 76946], [89, 77887], [91, 78028], [94, 78148], [99, 78388], [103, 78568], [110, 79048], [114, 79148], [122, 79628], [124, 79708], [128, 79868], [136, 80268], [141, 80508], [151, 81608], [160, 82208], [162, 82738]]}, {"verse": 11, "start": 83700, "end": 88793, "text": "Y me dijo el ángel de Dios en sueños: Jacob. Y yo dije: Aquí estoy.", "words": [[0, 83700], [2, 83809], [5, 83909], [10, 84129], [13, 84289], [19, 84609], [22, 84709], [27, 84909], [30, 85089], [38, 86346], [45, 86931], [47, 87055], [50, 87175], [56, 87976], [61, 88183]]}, {"verse": 12, "start": 89243, "end": 99766, "text": "Y él dijo: Alza ahora tus ojos, y verás todos los machos que cubren a las ovejas listados, pintados y abigarrados; porque yo he visto todo lo que Labán te ha hecho.", "words": [[0, 89243], [2, 89373], [5, 89493], [11, 90207], [16, 90604], [22, 90864], [26, 91084], [32, 91464], [34, 91844], [40, 92184], [46, 92404], [50, 92684], [57, 93144], [61, 93264], [68, 93664], [70, 93744], [74, 93884], [81, 94264], [91, 95264], [100, 95884], [102, 96429], [115, 97235], [122, 97689], [125, 97889], [128, 97989], [134, 98209], [139, 98529], [142, 98729], [146, 98896], [152, 99062], [155, 99229], [158, 99389]]}, {"verse": 13, "start": 100216, "end": 110000, "text": "Yo soy el Dios de Bet-el, donde tú ungiste la columna, y donde me hiciste un voto. Levántate ahora, y sal de esta tierra, y vuélvete a la tierra de tu naturaleza.", "words": [[0, 100216], [3, 100361], [7, 100541], [10, 100741], [15, 101021], [18, 101141], [26, 101941], [32, 102181], [35, 102441], [43, 102901], [46, 103041], [55, 103641], [57, 104001], [63, 104201], [66, 104421], [74, 104861], [77, 104981], [83, 105724], [93, 106211], [100, 106451], [102, 106631], [106, 106851], [109, 107011], [114, 107171], [122, 107571], [124, 107884], [133, 108198], [135, 108511], [138, 108611], [145, 108891], [148, 109091], [151, 109231]]}, {"verse": 14, "start": 110350, "end": 117435, "text": "Y respondió Raquel y Lea, y le dijeron: ¿Tenemos ya parte ni heredad en la casa de nuestro padre?", "words": [[0, 110350], [2, 110506], [12, 111066], [19, 111486], [21, 111786], [26, 112166], [28, 112526], [31, 112646], [40, 113682], [49, 114024], [52, 114304], [58, 114624], [61, 115004], [69, 115544], [72, 115764], [75, 115924], [80, 116204], [83, 116444], [91, 116624]]}, {"verse": 15, "start": 117885, "end": 125316, "text": "¿No nos tiene ya como por extrañas, pues que nos vendió, y aun se ha comido del todo nuestro precio?", "words": [[0, 117885], [4, 118050], [8, 118290], [14, 118530], [17, 118810], [22, 119070], [26, 119350], [36, 120490], [41, 120890], [45, 121070], [49, 121230], [57, 121730], [59, 122370], [63, 122570], [66, 122850], [69, 122950], [76, 123410], [80, 123610], [85, 123990], [93, 124290]]}, {"verse": 16, "start": 125766, "end": 135920, "text": "Porque toda la riqueza que Dios ha quitado a nuestro padre, nuestra es y de nuestros hijos: ahora pues, haz todo lo que Dios te ha dicho.", "words": [[0, 125766], [7, 125988], [12, 126328], [15, 126588], [23, 127208], [27, 127388], [32, 127668], [35, 127968], [43, 128508], [45, 128588], [53, 128768], [60, 129768], [68, 130008], [71, 130708], [73, 131028], [76, 131148], [85, 131368], [92, 132485], [98, 132744], [104, 133104], [108, 133864], [113, 134184], [116, 134484], [120, 134644], [125, 134964], [128, 135244], [131, 135364]]}, {"verse": 17, "start": 136370, "end": 142018, "text": "Entonces se levantó Jacob, y subió sus hijos y sus mujeres sobre los camellos.", "words": [[0, 136370], [9, 136830], [12, 137190], [20, 137710], [27, 138090], [29, 138890], [35, 139290], [39, 139490], [45, 139830], [47, 140030], [51, 140210], [59, 140590], [65, 141030], [69, 141230]]}, {"verse": 18, "start": 142468, "end": 156158, "text": "Y puso en camino todo su ganado, y toda su hacienda que había adquirido, el ganado de su ganancia que había obtenido en Padan-aram, para volverse a Isaac su padre en la tierra de Canaán.", "words": [[0, 142468], [2, 142590], [7, 142930], [10, 143050], [17, 143410], [22, 143770], [25, 144050], [33, 144530], [35, 145050], [40, 145310], [43, 145550], [52, 146030], [56, 146190], [62, 146470], [73, 147590], [76, 148030], [83, 148470], [86, 148630], [89, 148810], [98, 149430], [102, 149630], [108, 149910], [117, 150870], [120, 151110], [132, 152431], [137, 152596], [146, 153136], [148, 153276], [154, 153856], [157, 153956], [163, 154616], [166, 154756], [169, 154876], [176, 155196], [179, 155709]]}, {"verse": 19, "start": 156608, "end": 162546, "text": "Y Labán había ido a trasquilar sus ovejas: y Raquel hurtó los ídolos de su padre.", "words": [[0, 156608], [2, 156734], [8, 157154], [14, 157454], [18, 157774], [20, 158124], [31, 158474], [35, 158654], [43, 159698], [45, 159815], [52, 160195], [58, 160755], [62, 161075], [69, 161695], [72, 161795], [75, 161915]]}, {"verse": 20, "start": 162996, "end": 167837, "text": "Y engañó Jacob a Labán arameo, no haciéndole saber que se huía.", "words": [[0, 162996], [2, 163137], [9, 163597], [15, 163897], [17, 164257], [23, 164617], [31, 165597], [34, 165837], [45, 166457], [51, 166737], [55, 166997], [58, 167157]]}, {"verse": 21, "start": 168287, "end": 176338, "text": "Huyó, pues, con todo lo que tenía; y se levantó, y pasó el río, y puso su rostro al monte de Galaad.", "words": [[0, 168287], [6, 168731], [12, 169491], [16, 169631], [21, 169911], [24, 170111], [28, 170251], [35, 171125], [37, 171251], [40, 171351], [49, 172071], [51, 172391], [56, 172671], [59, 172891], [64, 173351], [66, 173651], [71, 173971], [74, 174151], [81, 174751], [84, 174991], [90, 175371], [93, 175571]]}, {"verse": 22, "start": 176788, "end": 181066, "text": "Y fue dicho a Labán al tercero día como Jacob se había huido.", "words": [[0, 176788], [2, 176915], [6, 177075], [12, 177375], [14, 177595], [20, 178015], [23, 178535], [31, 179095], [35, 179335], [40, 179615], [46, 179955], [49, 180235], [55, 180455]]}, {"verse": 23, "start": 181516, "end": 190142, "text": "Entonces tomó a sus hermanos consigo, y fue tras él camino de siete días, y le alcanzó en el monte de Galaad.", "words": [[0, 181516], [9, 181998], [14, 182618], [16, 182778], [20, 182958], [29, 183518], [38, 184078], [40, 184918], [44, 185098], [49, 185358], [52, 185738], [59, 186018], [62, 186318], [68, 186638], [74, 187098], [76, 187448], [79, 187798], [87, 188558], [90, 188758], [93, 188898], [99, 189218], [102, 189710]]}, {"verse": 24, "start": 190592, "end": 198287, "text": "Y vino Dios a Labán arameo en sueños aquella noche, y le dijo: Cuídate de no hablar a Jacob con dureza.", "words": [[0, 190592], [2, 190716], [7, 190916], [12, 191216], [14, 191546], [20, 191876], [27, 192576], [30, 192796], [37, 193396], [45, 193736], [52, 194036], [54, 194796], [57, 194916], [63, 195660], [71, 195996], [74, 196276], [77, 196436], [84, 196716], [86, 196836], [92, 197156], [96, 197436]]}, {"verse": 25, "start": 198637, "end": 208158, "text": "Alcanzó pues Labán a Jacob, y este había fijado su tienda en el monte: y Labán plantó su tienda con sus hermanos en el monte de Galaad.", "words": [[0, 198637], [8, 199324], [13, 199544], [19, 199964], [21, 200104], [28, 200444], [30, 201204], [35, 201424], [41, 201684], [48, 202224], [51, 202384], [58, 202744], [61, 202904], [64, 203004], [71, 203978], [73, 204232], [79, 204592], [86, 205072], [89, 205192], [96, 205612], [100, 205812], [104, 206012], [113, 206652], [116, 206792], [119, 206912], [125, 207252], [128, 207492]]}, {"verse": 26, "start": 208608, "end": 215395, "text": "Y dijo Labán a Jacob: ¿Qué has hecho, que me hurtaste el corazón, y has traído a mis hijas como prisioneras de guerra?", "words": [[0, 208608], [2, 208781], [7, 208991], [13, 209491], [15, 209926], [22, 210557], [27, 210653], [31, 210833], [38, 211033], [42, 211193], [45, 211473], [54, 211753], [57, 211913], [66, 212333], [68, 212913], [72, 213073], [79, 213393], [81, 213513], [85, 213653], [91, 213993], [96, 214363], [108, 214733], [111, 214913]]}, {"verse": 27, "start": 215845, "end": 224508, "text": "¿Por qué te escondiste para huir, y me engañaste, y no me diste noticia, para que yo te despidiera con alegría y con cantares, con tamborín y vihuela?", "words": [[0, 215845], [5, 215962], [9, 216122], [12, 216242], [23, 216782], [28, 217022], [34, 217402], [36, 217522], [39, 217602], [50, 218182], [52, 218462], [55, 218602], [58, 218722], [64, 219062], [73, 219942], [78, 220202], [82, 220342], [85, 220502], [88, 220622], [99, 221222], [103, 221402], [111, 221942], [113, 222102], [117, 222282], [127, 223042], [131, 223142], [140, 223702], [142, 223942]]}, {"verse": 28, "start": 224958, "end": 229544, "text": "Que aun no me dejaste besar mis hijos y mis hijas. Ahora locamente has hecho.", "words": [[0, 224958], [4, 225054], [8, 225234], [11, 225434], [14, 225534], [22, 225974], [28, 226274], [32, 226554], [38, 226854], [40, 227054], [44, 227214], [51, 228067], [57, 228335], [67, 228875], [71, 229095]]}, {"verse": 29, "start": 229994, "end": 237516, "text": "Poder hay en mi mano para haceros mal: mas el Dios de vuestro padre me habló anoche diciendo: Cuídate de no hablar a Jacob con dureza.", "words": [[0, 229994], [6, 230298], [10, 230398], [13, 230518], [16, 230638], [21, 230878], [26, 231138], [34, 231598], [39, 232289], [43, 232435], [46, 232615], [51, 232855], [54, 232955], [62, 233275], [68, 233615], [71, 233715], [77, 233975], [84, 234295], [94, 235249], [102, 235593], [105, 235813], [108, 235973], [115, 236253], [117, 236373], [123, 236673], [127, 236913]]}, {"verse": 30, "start": 237966, "end": 243284, "text": "Y ya que te ibas, porque tenías deseo de la casa de tu padre, ¿por qué me hurtaste mis dioses?", "words": [[0, 237966], [2, 238051], [5, 238211], [9, 238331], [12, 238471], [18, 239111], [25, 239311], [32, 239691], [38, 240091], [41, 240171], [44, 240271], [49, 240511], [52, 240711], [55, 240831], [62, 241591], [67, 241811], [71, 241951], [74, 242071], [83, 242471], [87, 242651]]}, {"verse": 31, "start": 243634, "end": 250602, "text": "Y Jacob respondió, y dijo a Labán: Porque tuve miedo; pues dije, que quizá me quitarías por fuerza tus hijas.", "words": [[0, 243634], [2, 243777], [8, 244017], [19, 244817], [21, 245037], [26, 245267], [28, 245497], [35, 246315], [42, 246494], [47, 246794], [54, 247632], [59, 247765], [65, 248065], [69, 248465], [75, 248805], [78, 248865], [88, 249305], [92, 249505], [99, 249825], [103, 250025]]}, {"verse": 32, "start": 251052, "end": 260859, "text": "En quien halles tus dioses, no viva: delante de nuestros hermanos reconoce lo que yo tenga tuyo, y llévatelo. Jacob no sabía que Raquel los había hurtado.", "words": [[0, 251052], [3, 251177], [9, 251357], [16, 251537], [20, 251717], [28, 252217], [31, 252477], [37, 253228], [45, 253651], [48, 253771], [57, 253931], [66, 254931], [75, 255351], [78, 255491], [82, 255591], [85, 255731], [91, 255931], [97, 256391], [99, 256611], [110, 257590], [116, 257895], [119, 258275], [125, 258695], [129, 258875], [136, 259315], [140, 259635], [146, 260275]]}, {"verse": 33, "start": 261309, "end": 273331, "text": "Y entró Labán en la tienda de Jacob, y en la tienda de Lea, y en la tienda de las dos siervas, y no los halló, y salió de la tienda de Lea, y vino a la tienda de Raquel.", "words": [[0, 261309], [2, 261607], [8, 262047], [14, 262487], [17, 262707], [20, 262867], [27, 263267], [30, 263407], [37, 264167], [39, 264327], [42, 264447], [45, 264567], [52, 264987], [55, 265167], [60, 266027], [62, 266067], [65, 266187], [68, 266307], [75, 266747], [78, 266907], [82, 267047], [86, 267207], [95, 268047], [97, 268287], [100, 268507], [104, 268807], [111, 269790], [113, 269915], [119, 270315], [122, 270435], [125, 270555], [132, 270975], [135, 271115], [140, 271495], [142, 271655], [147, 271895], [149, 272035], [152, 272095], [159, 272475], [162, 272938]]}, {"verse": 34, "start": 273781, "end": 283768, "text": "Y tomó Raquel los ídolos, y los puso en la montura de un camello, y se sentó sobre ellos: y buscó Labán por toda la tienda, y no los halló.", "words": [[0, 273781], [2, 274060], [7, 274400], [14, 274740], [18, 274980], [26, 275640], [28, 275960], [32, 276100], [37, 276440], [40, 276560], [43, 276660], [51, 277160], [54, 277320], [57, 277460], [66, 278020], [68, 278400], [71, 278540], [77, 279040], [83, 279320], [90, 280346], [92, 280491], [98, 280831], [104, 281171], [108, 281391], [113, 281651], [116, 281891], [124, 282371], [126, 282831], [129, 283164], [133, 283497]]}, {"verse": 35, "start": 284218, "end": 295741, "text": "Y ella dijo a su padre: No se enoje mi señor, porque no me puedo levantar delante de ti; pues tengo la menstruación. Y él buscó, pero no halló los ídolos.", "words": [[0, 284218], [2, 284413], [7, 284639], [12, 284866], [14, 285106], [17, 285206], [24, 286095], [27, 286280], [30, 286500], [36, 286880], [39, 287020], [46, 287640], [53, 288140], [56, 288340], [59, 288480], [65, 288740], [74, 289480], [82, 289980], [85, 290140], [89, 290763], [94, 290892], [100, 291192], [103, 291372], [117, 292675], [119, 292815], [122, 292955], [129, 294015], [134, 294215], [137, 294435], [143, 294835], [147, 295015]]}, {"verse": 36, "start": 296041, "end": 303892, "text": "Entonces Jacob se enojó y discutió con Labán. Jacob le dijo: ¿Qué falta he cometido? ¿cuál es mi pecado, que me persigues con tanto ardor?", "words": [[0, 296041], [9, 296541], [15, 296756], [18, 296971], [24, 297186], [26, 297401], [35, 297921], [39, 298081], [46, 298846], [52, 299112], [55, 299312], [61, 300031], [66, 300115], [72, 300395], [75, 300615], [85, 301539], [91, 301717], [94, 301797], [97, 301897], [105, 302297], [109, 302457], [112, 302557], [122, 303037], [126, 303197], [132, 303417]]}, {"verse": 37, "start": 304342, "end": 315086, "text": "Pues que has registrado todos mis muebles, ¿qué has hallado de todas las pertenencias de tu casa? Ponlo aquí delante de mis hermanos y tuyos, y juzguen entre nosotros ambos.", "words": [[0, 304342], [5, 304473], [9, 304633], [13, 304833], [24, 305493], [30, 305733], [34, 306053], [43, 306593], [48, 307153], [52, 307333], [60, 307693], [63, 307853], [69, 308033], [73, 308313], [86, 309013], [89, 309213], [92, 309333], [98, 310137], [104, 310396], [109, 310596], [117, 310996], [120, 311136], [124, 311256], [133, 311736], [135, 311856], [142, 312296], [144, 312476], [152, 312936], [158, 313136], [167, 313556]]}, {"verse": 38, "start": 315536, "end": 322575, "text": "Estos veinte años he estado contigo: tus ovejas y tus cabras nunca abortaron, ni yo comí carnero de tus ovejas.", "words": [[0, 315536], [6, 315815], [13, 316135], [18, 316515], [21, 316695], [28, 316935], [37, 317940], [41, 318036], [48, 318536], [50, 318676], [54, 318836], [61, 319276], [67, 319476], [78, 320396], [81, 320736], [84, 320916], [89, 321216], [97, 321676], [100, 321756], [104, 321916]]}, {"verse": 39, "start": 323025, "end": 330761, "text": "Nunca te traje lo arrebatado por las fieras; yo pagaba el daño; lo hurtado así de día como de noche, a mí me lo cobrabas.", "words": [[0, 323025], [6, 323368], [9, 323488], [15, 323828], [18, 323928], [29, 324488], [33, 324648], [37, 324808], [45, 325618], [48, 325918], [55, 326318], [58, 326418], [64, 327170], [67, 327421], [75, 327711], [79, 327951], [82, 328111], [86, 328331], [91, 328591], [94, 328751], [101, 329531], [103, 329591], [106, 329771], [109, 329931], [112, 330071]]}, {"verse": 40, "start": 331211, "end": 336309, "text": "De día me consumía el calor, y de noche la helada, y el sueño se huía de mis ojos.", "words": [[0, 331211], [3, 331313], [7, 331533], [10, 331693], [19, 332293], [22, 332413], [29, 332753], [31, 333213], [34, 333333], [40, 333553], [43, 333773], [51, 334193], [53, 334513], [56, 334613], [62, 335013], [65, 335193], [70, 335513], [73, 335633], [77, 335753]]}, {"verse": 41, "start": 336759, "end": 345755, "text": "Así he estado veinte años en tu casa: catorce años te serví por tus dos hijas, y seis años por tu ganado; y has cambiado mi salario diez veces.", "words": [[0, 336759], [4, 336981], [7, 337101], [14, 337371], [21, 337641], [26, 337981], [29, 338221], [32, 338321], [38, 339236], [46, 339446], [51, 339826], [54, 340066], [60, 340446], [64, 340546], [68, 340746], [72, 340926], [79, 341426], [81, 341586], [86, 341786], [91, 342106], [95, 342406], [98, 342486], [106, 343329], [108, 343455], [112, 343575], [121, 344055], [124, 344175], [132, 344495], [137, 344815]]}, {"verse": 42, "start": 346205, "end": 359072, "text": "Si el Dios de mi padre, el Dios de Abraham, y el temor de Isaac, no fuera conmigo, de cierto me enviarías ahora vacío: vio Dios mi aflicción y el trabajo de mis manos, y te reprendió anoche.", "words": [[0, 346205], [3, 346406], [6, 346526], [11, 346786], [14, 346906], [17, 347026], [24, 347986], [27, 348046], [32, 348326], [35, 348446], [44, 348846], [46, 349386], [49, 349526], [55, 349846], [58, 349986], [65, 350446], [68, 350826], [74, 351086], [83, 352226], [86, 352286], [93, 352526], [96, 352886], [106, 353466], [112, 353726], [119, 354955], [123, 355136], [128, 355356], [131, 355496], [141, 356096], [143, 356236], [146, 356356], [154, 356756], [157, 356936], [161, 357036], [168, 357456], [170, 357756], [173, 358126], [183, 358496]]}, {"verse": 43, "start": 359422, "end": 373929, "text": "Y respondió Labán, y dijo a Jacob: Las hijas son hijas mías, y los hijos, hijos míos son, y las ovejas son mis ovejas, y todo lo que tú ves es mío: ¿y qué puedo yo hacer hoy a estas mis hijas, o a sus hijos que ellas han parido?", "words": [[0, 359422], [2, 359539], [12, 360159], [19, 360619], [21, 360839], [26, 361119], [28, 361259], [35, 362018], [39, 362136], [45, 362476], [49, 362616], [55, 362936], [61, 363616], [63, 363896], [67, 364056], [74, 364656], [80, 364816], [85, 365216], [90, 365816], [92, 365936], [96, 366096], [103, 366456], [107, 366696], [111, 366856], [119, 367616], [121, 367796], [126, 367976], [129, 368176], [133, 368296], [136, 368476], [140, 368676], [143, 368996], [148, 369755], [151, 369862], [155, 369982], [161, 370282], [164, 370462], [170, 370722], [174, 370902], [176, 371002], [182, 371162], [186, 371422], [193, 371902], [195, 372282], [197, 372382], [201, 372562], [207, 372762], [211, 373022], [217, 373202], [221, 373382]]}, {"verse": 44, "start": 374379, "end": 379810, "text": "Ven pues ahora, y hagamos alianza yo y tú; y sea en testimonio entre mí y entre ti.", "words": [[0, 374379], [4, 374559], [9, 374739], [16, 375119], [18, 375299], [26, 375639], [34, 376219], [37, 376479], [39, 376619], [43, 377240], [45, 377365], [49, 377605], [52, 377805], [63, 378445], [69, 378665], [72, 378945], [74, 379165], [80, 379405]]}, {"verse": 45, "start": 380160, "end": 384647, "text": "Entonces Jacob tomó una piedra, y la levantó por señal.", "words": [[0, 380160], [9, 380963], [15, 381403], [20, 381943], [24, 382083], [32, 382943], [34, 383123], [37, 383243], [45, 383823], [49, 383983]]}, {"verse": 46, "start": 385097, "end": 398724, "text": "Y dijo Jacob a sus hermanos: Recoged piedras. Y tomaron piedras e hicieron un montón de piedras; y comieron allí sobre aquel montón.", "words": [[0, 385097], [2, 385326], [7, 385586], [13, 385946], [15, 386486], [19, 386626], [29, 387803], [37, 388013], [46, 391823], [48, 391964], [56, 392424], [64, 393224], [66, 393504], [75, 394104], [78, 394324], [85, 394824], [88, 395144], [97, 396289], [99, 396376], [108, 396836], [113, 397136], [119, 397476], [125, 397856]]}, {"verse": 47, "start": 399174, "end": 404762, "text": "Y lo llamó Labán Jegar Sahadutha: y lo llamó Jacob Galaad.", "words": [[0, 399174], [2, 399434], [5, 399554], [11, 399914], [17, 400734], [23, 401410], [34, 402329], [36, 402453], [39, 403030], [45, 403607], [51, 404184]]}, {"verse": 48, "start": 405212, "end": 412244, "text": "Porque Labán dijo: Este montón es testigo hoy entre mí y entre ti; por eso fue llamado su nombre Galaad;", "words": [[0, 405212], [7, 405568], [13, 406008], [19, 406795], [24, 406997], [31, 407317], [34, 407597], [42, 408017], [46, 408197], [52, 408417], [55, 408657], [57, 408897], [63, 409117], [67, 409805], [71, 409909], [75, 410129], [79, 410349], [87, 410629], [90, 410909], [97, 411249]]}, {"verse": 49, "start": 412694, "end": 419294, "text": "Y Mizpa, por cuanto dijo: Vigile Jehová entre mí y entre ti, cuando nos apartemos el uno del otro.", "words": [[0, 412694], [2, 413184], [9, 413694], [13, 413954], [20, 414194], [26, 415099], [33, 415558], [40, 416018], [46, 416238], [49, 416518], [51, 416718], [57, 416918], [61, 417198], [68, 417538], [72, 417718], [82, 418128], [85, 418538], [89, 418718], [93, 418878]]}, {"verse": 50, "start": 419744, "end": 428835, "text": "Si afliges mis hijas, o si tomas otras mujeres además de mis hijas, aunque no haya otro testigo entre nosotros; mira, Dios es testigo entre mí y entre ti.", "words": [[0, 419744], [3, 419867], [11, 420327], [15, 420487], [22, 420987], [24, 421167], [27, 421307], [33, 421627], [39, 421807], [47, 422267], [54, 422667], [57, 422887], [61, 423027], [68, 423667], [75, 423867], [78, 424127], [83, 424287], [88, 424527], [96, 425047], [102, 425227], [112, 426281], [118, 426486], [123, 426859], [126, 427233], [134, 427606], [140, 427806], [143, 428066], [145, 428246], [151, 428446]]}, {"verse": 51, "start": 429185, "end": 436868, "text": "Dijo más Labán a Jacob: He aquí este montón de piedras, y he aquí esta señal, que he erigido entre mí y ti.", "words": [[0, 429185], [5, 429486], [9, 429766], [15, 430446], [17, 430566], [24, 431373], [27, 431522], [32, 431802], [37, 432082], [44, 432402], [47, 432642], [56, 433162], [58, 433562], [61, 433702], [66, 433942], [71, 434222], [78, 434802], [82, 435182], [85, 435322], [93, 435742], [99, 435962], [102, 436262], [104, 436502]]}, {"verse": 52, "start": 437318, "end": 447210, "text": "Testigo sea este montón, y testigo sea esta columna, que ni yo pasaré contra ti este montón, ni tú pasarás contra mí este montón ni esta columna, para mal.", "words": [[0, 437475], [8, 437735], [12, 437955], [17, 438195], [25, 439035], [27, 439235], [35, 439675], [39, 439895], [44, 440155], [53, 440995], [57, 441155], [60, 441295], [63, 441455], [70, 441875], [77, 442115], [80, 442355], [85, 442555], [93, 443395], [96, 443535], [99, 443675], [107, 444155], [114, 444395], [117, 444635], [122, 444835], [129, 445235], [132, 445495], [137, 445715], [146, 446515], [151, 446755]]}, {"verse": 53, "start": 447660, "end": 457323, "text": "El Dios de Abraham, y el Dios de Nacor juzgue entre nosotros, el Dios de sus padres. Y Jacob juró por el temor de Isaac su padre.", "words": [[0, 447660], [3, 447819], [8, 448079], [11, 448319], [20, 448759], [22, 449219], [25, 449359], [30, 449559], [33, 449759], [39, 450219], [46, 450619], [52, 450859], [62, 451419], [65, 452059], [70, 452279], [73, 452459], [77, 452599], [85, 453700], [87, 453818], [93, 454418], [98, 455018], [102, 455218], [105, 455358], [111, 455738], [114, 455878], [120, 456518], [123, 456638]]}, {"verse": 54, "start": 457773, "end": 467188, "text": "Entonces Jacob inmoló víctimas en el monte, y llamó a sus hermanos a comer pan: y comieron pan, y durmieron aquella noche en el monte.", "words": [[0, 457773], [9, 458427], [15, 459107], [22, 459787], [31, 460287], [34, 460467], [37, 460587], [44, 460887], [46, 461167], [52, 461527], [54, 461607], [58, 461747], [67, 462367], [69, 462467], [75, 462707], [80, 463590], [82, 463708], [91, 464128], [96, 464548], [98, 464848], [108, 465428], [116, 465848], [122, 466148], [125, 466448], [128, 466588]]}, {"verse": 55, "start": 467638, "end": 477047, "text": "Y se levantó Labán de mañana, y besó sus hijos y sus hijas, y los bendijo; y retrocedió y se volvió a su lugar.", "words": [[0, 467638], [2, 467763], [5, 467943], [13, 468543], [19, 469143], [22, 469343], [30, 469883], [32, 470503], [37, 470883], [41, 471143], [47, 471463], [49, 471683], [53, 471923], [60, 472303], [62, 472443], [66, 472603], [75, 473785], [77, 474062], [88, 475042], [90, 475502], [93, 475662], [100, 476142], [102, 476262], [105, 476422]]}]}