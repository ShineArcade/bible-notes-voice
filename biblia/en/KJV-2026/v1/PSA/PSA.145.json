{"book": "PSA", "chapter": 145, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 113550, "verses": [{"verse": 1, "start": 300, "end": 5378, "text": "I will extol you, my God, O king; and I will bless your name for ever and ever.", "words": [[0, 300], [2, 438], [7, 618], [13, 1138], [18, 1318], [21, 1458], [26, 1898], [28, 1958], [34, 2749], [38, 2876], [40, 3036], [45, 3196], [51, 3476], [56, 3716], [61, 3983], [65, 4249], [70, 4516], [74, 4896]]}, {"verse": 2, "start": 5828, "end": 11587, "text": "Every day will I bless you; and I will praise your name for ever and ever.", "words": [[0, 5828], [6, 6096], [10, 6376], [15, 6576], [17, 6736], [23, 6936], [28, 7723], [32, 7888], [34, 8028], [39, 8188], [46, 8528], [51, 8768], [56, 9061], [60, 9355], [65, 9648], [69, 9928]]}, {"verse": 3, "start": 12037, "end": 16654, "text": "Great is the LORD, and greatly to be praised; and his greatness is unsearchable.", "words": [[0, 12037], [6, 12257], [9, 12457], [13, 12617], [19, 12897], [23, 13297], [31, 13637], [34, 13857], [37, 13977], [46, 14983], [50, 15123], [54, 15243], [64, 15603], [67, 15863]]}, {"verse": 4, "start": 17104, "end": 22432, "text": "One generation shall praise your works to another, and shall declare your mighty acts.", "words": [[0, 17104], [4, 17542], [15, 18122], [21, 18522], [28, 18902], [33, 19182], [39, 19462], [42, 19662], [51, 20442], [55, 20522], [61, 20722], [69, 21102], [74, 21362], [81, 21702]]}, {"verse": 5, "start": 22882, "end": 28000, "text": "I will speak of the glorious honour of your majesty, and of your wondrous works.", "words": [[0, 22882], [2, 23044], [7, 23224], [13, 23564], [16, 23784], [20, 23884], [29, 24354], [36, 24824], [39, 25084], [44, 25204], [53, 25744], [57, 26484], [60, 26644], [65, 26804], [74, 27344]]}, {"verse": 6, "start": 28450, "end": 34370, "text": "And men shall speak of the might of your terrible acts: and I will declare your greatness.", "words": [[0, 28450], [4, 28595], [8, 28