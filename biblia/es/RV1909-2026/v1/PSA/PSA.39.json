{"book": "PSA", "chapter": 39, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 104326, "verses": [{"verse": 1, "start": 300, "end": 13926, "text": "Al Músico principal, a Jedutún: Salmo de David. YO DIJE: Atenderé a mis caminos, para no pecar con mi lengua: guardaré mi boca con freno, en tanto que el impío esté contra mí.", "words": [[0, 300], [3, 446], [10, 946], [21, 1552], [23, 2158], [32, 3001], [38, 3485], [41, 3665], [48, 4706], [51, 4947], [57, 5428], [66, 6088], [68, 6148], [72, 6268], [81, 6848], [86, 7368], [89, 7568], [95, 8108], [99, 8348], [102, 8568], [110, 9474], [119, 9942], [122, 10142], [127, 10402], [131, 10662], [138, 11382], [141, 11682], [147, 11982], [151, 12242], [154, 12582], [160, 12922], [165, 13162], [172, 13502]]}, {"verse": 2, "start": 14376, "end": 20451, "text": "Enmudecí con silencio, me callé aun respecto de lo bueno: y se excitó mi dolor.", "words": [[0, 14722], [9, 15102], [13, 15262], [23, 15902], [26, 16082], [32, 16522], [36, 16962], [45, 17402], [48, 17702], [51, 17842], [58, 18680], [60, 18847], [63, 18967], [70, 19767], [73, 19867]]}, {"verse": 3, "start": 20901, "end": 29296, "text": "Se enardeció mi corazón dentro de mí; en mi meditación se encendió fuego, y así proferí con mi lengua:", "words": [[0, 20901], [3, 21344], [13, 21824], [16, 21984], [24, 22424], [31, 22804], [34, 23124], [38, 23767], [41, 24047], [44, 24227], [55, 24947], [58, 25147], [67, 25747], [74, 26727], [76, 26807], [80, 26987], [88, 27647], [92, 27827], [95, 28007]]}, {"verse": 4, "start": 29746, "end": 37860, "text": "Hazme saber, Jehová, mi fin, y cuánta sea la medida de mis días; sepa yo cuánto tengo de ser del mundo.", "words": [[0, 29746], [6, 30170], [13, 30730], [21, 31290], [24, 31390], [29, 32190], [31, 32270], [38, 32770], [42, 33070], [45, 33290], [52, 33690], [55, 33950], [59, 34110], [65, 35468], [70, 35728], [73, 35848], [80, 36328], [86, 36567], [89, 36747], [93, 37008], [97, 37168]]}, {"verse": 5, "start": 38310, "end": 48930, "text": "He aquí diste a mis días término corto, y mi edad es como nada delante de ti: ciertamente es completa vanidad todo hombre que vive. (Selah.)", "words": [[0, 38310], [3, 38550], [8, 38824], [14, 39097], [16, 39197], [20, 39297], [25, 39517], [33, 40137], [40, 40917], [42, 41117], [45, 41297], [50, 41717], [53, 41917], [58, 42157], [63, 42497], [71, 43037], [74, 43217], [78, 43883], [90, 44627], [93, 44787], [102, 45247], [110, 45767], [115, 46027], [122, 46407], [126, 46627], [132, 48719]]}, {"verse": 6, "start": 49380, "end": 57913, "text": "Ciertamente en tinieblas anda el hombre; ciertamente en vano se afana: amontona riquezas y no sabe quién las recogerá.", "words": [[0, 49380], [12, 50090], [15, 50250], [25, 50910], [30, 51250], [33, 51490], [41, 52297], [53, 53144], [56, 53304], [61, 53604], [64, 53724], [71, 54729], [80, 55180], [89, 55666], [91, 56152], [94, 56312], [99, 56592], [105, 56832], [109, 57052]]}, {"verse": 7, "start": 58363, "end": 62692, "text": "Y ahora, Señor, ¿qué esperaré? Mi esperanza en ti está.", "words": [[0, 58363], [2, 58623], [9, 58863], [16, 59723], [21, 59823], [31, 61065], [34, 61176], [44, 61676], [47, 61876], [50, 62036]]}, {"verse": 8, "start": 63142, "end": 68360, "text": "Líbrame de todas mis rebeliones; no me pongas por burla del insensato.", "words": [[0, 63142], [8, 63678], [11, 63898], [17, 64098], [21, 64438], [33, 65818], [36, 65945], [39, 66085], [46, 66505], [50, 66745], [56, 67125], [60, 67345]]}, {"verse": 9, "start": 68810, "end": 72254, "text": "Enmudecí, no abrí mi boca; porque tú lo hiciste.", "words": [[0, 69167], [10, 69557], [13, 70017], [18, 70337], [21, 70477], [27, 71231], [34, 71415], [37, 71655], [40, 71815]]}, {"verse": 10, "start": 72704, "end": 77397, "text": "Quita de sobre mí tu plaga; de la guerra de tu mano soy consumido.", "words": [[0, 72704], [6, 73398], [9, 73538], [15, 73778], [18, 74018], [21, 74158], [28, 75063], [31, 75189], [34, 75309], [41, 75569], [44, 75789], [47, 75949], [52, 76189], [56, 76449]]}, {"verse": 11, "start": 77847, "end": 87966, "text": "Con castigos sobre el pecado corriges al hombre, y haces consumirse como de polilla su grandeza: ciertamente vanidad es todo hombre. (Selah.)", "words": [[0, 77847], [4, 78163], [13, 78513], [19, 78853], [22, 79053], [29, 79583], [38, 80113], [41, 80293], [49, 80593], [51, 81113], [57, 81413], [68, 82253], [73, 82553], [76, 82733], [84, 83233], [87, 83433], [97, 84553], [109, 85511], [117, 85991], [120, 86211], [125, 86391], [133, 87684]]}, {"verse": 12, "start": 88416, "end": 99664, "text": "Oye mi oración, oh Jehová, y escucha mi clamor: no calles a mis lágrimas; porque forastero soy para ti, y advenedizo, como todos mis padres.", "words": [[0, 88416], [4, 88741], [7, 88901], [16, 89414], [19, 89928], [27, 90441], [29, 90721], [37, 91221], [40, 91567], [48, 92185], [51, 92501], [58, 92851], [60, 92991], [64, 93111], [74, 94368], [81, 95025], [91, 95715], [95, 95975], [100, 96275], [104, 96575], [106, 97075], [118, 97915], [123, 98435], [129, 98755], [133, 98995]]}, {"verse": 13, "start": 100114, "end": 103926, "text": "Déjame, y tomaré fuerzas, antes que vaya y perezca.", "words": [[0, 100114], [8, 100701], [10, 101121], [17, 101501], [26, 102221], [32, 102641], [36, 102881], [41, 103230], [43, 103578]]}]}