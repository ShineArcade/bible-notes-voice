{"book": "PSA", "chapter": 72, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 140512, "verses": [{"verse": 1, "start": 300, "end": 6138, "text": "Para Salomón. OH Dios, da tus juicios al rey, y tu justicia al hijo del rey.", "words": [[0, 300], [5, 486], [14, 1703], [17, 1803], [23, 2196], [26, 2590], [30, 2983], [38, 3463], [41, 3783], [46, 4123], [48, 4263], [51, 4403], [60, 5063], [63, 5283], [68, 5463], [72, 5683]]}, {"verse": 2, "start": 6588, "end": 11386, "text": "Él juzgará tu pueblo con justicia, y tus afligidos con juicio.", "words": [[0, 6588], [3, 6951], [11, 7451], [14, 7651], [21, 8071], [25, 8371], [35, 9251], [37, 9631], [41, 9791], [51, 10431], [55, 10731]]}, {"verse": 3, "start": 11836, "end": 15685, "text": "Los montes llevarán paz al pueblo, y los collados justicia.", "words": [[0, 11836], [4, 11962], [11, 12422], [20, 12822], [24, 13042], [27, 13242], [35, 13682], [37, 14242], [41, 14402], [50, 14862]]}, {"verse": 4, "start": 16135, "end": 22980, "text": "Juzgará los afligidos del pueblo, salvará los hijos del necesitado, y quebrantará al violento.", "words": [[0, 16135], [8, 16611], [12, 16751], [22, 17371], [26, 17551], [34, 18331], [42, 18891], [46, 19071], [52, 19391], [56, 19711], [68, 20731], [70, 21091], [82, 21851], [85, 22111]]}, {"verse": 5, "start": 23430, "end": 29232, "text": "Te temerán mientras duren el sol y la luna, por generación de generaciones.", "words": [[0, 23430], [3, 23552], [11, 24112], [20, 24472], [26, 25132], [29, 25392], [33, 25752], [35, 26052], [38, 26192], [44, 26572], [48, 27352], [59, 28012], [62, 28152]]}, {"verse": 6, "start": 29682, "end": 37395, "text": "Descenderá como la lluvia sobre la hierba cortada; como el rocío que destila sobre la tierra.", "words": [[0, 29682], [11, 30535], [16, 30775], [19, 30955], [26, 31415], [32, 31675], [35, 31895], [42, 32375], [51, 33596], [56, 34368], [59, 34888], [65, 35408], [69, 35548], [77, 36168], [83, 36428], [86, 36648]]}, {"verse": 7, "start": 37845, "end": 43680, "text": "Florecerá en sus días justicia, y muchedumbre de paz, hasta que no haya luna.", "words": [[0, 37845], [10, 38562], [13, 38662], [17, 38822], [22, 39082], [32, 40002], [34, 40622], [46, 41242], [49, 41382], [54, 41842], [60, 42462], [64, 42662], [67, 42842], [72, 43082]]}, {"verse": 8, "start": 44130, "end": 48833, "text": "Y dominará de mar a mar, y desde el río hasta los cabos de la tierra.", "words": [[0, 44130], [2, 44234], [11, 44814], [14, 44914], [18, 45154], [20, 45254], [25, 45574], [27, 45974], [33, 46174], [36, 46474], [40, 46894], [46, 47174], [50, 47394], [56, 47934], [59, 48094], [62, 48194]]}, {"verse": 9, "start": 49283, "end": 55059, "text": "Delante de él se postrarán los etíopes; y sus enemigos lamerán la tierra.", "words": [[0, 49283], [8, 49828], [11, 49948], [14, 50228], [17, 50428], [27, 51148], [31, 51328], [40, 52549], [42, 52822], [46, 52982], [55, 53622], [63, 54202], [66, 54362]]}, {"verse": 10, "start": 55509, "end": 63185, "text": "Los reyes de Tarsis y de las islas traerán presentes: los reyes de Sheba y de Seba ofrecerán dones.", "words": [[0, 55509], [4, 55635], [10, 56055], [13, 56195], [20, 56775], [22, 56935], [25, 57055], [29, 57215], [35, 57675], [43, 58615], [54, 59904], [58, 60192], [64, 60522], [67, 60682], [73, 61122], [75, 61242], [78, 61452], [83, 61662], [93, 62362]]}, {"verse": 11, "start": 63635, "end": 69214, "text": "Todos los reyes se postrarán delante de él; todas las naciones le servirán.", "words": [[0, 63635], [6, 63940], [10, 64340], [16, 64780], [19, 64980], [29, 65700], [37, 66160], [40, 66380], [44, 67030], [50, 67454], [54, 67634], [63, 68024], [66, 68414]]}, {"verse": 12, "start": 69664, "end": 75964, "text": "Porque él librará al necesitado que clama, y al afligido que no tiene quien le socorra.", "words": [[0, 69664], [7, 69910], [10, 70270], [18, 71110], [21, 71390], [32, 72210], [36, 72390], [43, 72890], [45, 73270], [48, 73390], [57, 74150], [61, 74330], [64, 74470], [70, 74730], [76, 75150], [79, 75570]]}, {"verse": 13, "start": 76414, "end": 82298, "text": "Tendrá misericordia del pobre y del necesitado, y salvará las almas de los pobres.", "words": [[0, 76414], [7, 76758], [20, 77638], [24, 77818], [30, 78238], [32, 78578], [36, 78778], [48, 79698], [50, 80218], [58, 80758], [62, 80918], [68, 81338], [71, 81478], [75, 81598]]}, {"verse": 14, "start": 82748, "end": 89445, "text": "De engaño y de violencia redimirá sus almas; y la sangre de ellos será preciosa en sus ojos.", "words": [[0, 82748], [3, 82934], [10, 83514], [12, 83594], [15, 83714], [25, 84354], [34, 85094], [38, 85234], [45, 86375], [47, 86652], [50, 86772], [57, 87172], [60, 87392], [66, 87652], [71, 87932], [80, 88612], [83, 88712], [87, 88852]]}, {"verse": 15, "start": 89895, "end": 97971, "text": "Y vivirá, y se le dará del oro de Seba; y se orará por él continuamente; todo el día se le bendecirá.", "words": [[0, 89895], [2, 90038], [10, 90598], [12, 90778], [15, 90938], [18, 91078], [23, 91418], [27, 91558], [31, 91778], [34, 92018], [40, 92918], [42, 93098], [45, 93238], [51, 93698], [55, 93978], [58, 94138], [73, 95904], [78, 96089], [81, 96349], [85, 96569], [88, 96789], [91, 96929]]}, {"verse": 16, "start": 98421, "end": 110168, "text": "Será echado un puño de grano en tierra, en las cumbres de los montes; su fruto hará ruido como el Líbano, y los de la ciudad florecerán como la hierba de la tierra.", "words": [[0, 98421], [5, 98664], [12, 99124], [15, 99284], [20, 99704], [23, 99864], [29, 100204], [32, 100364], [40, 100724], [43, 101504], [47, 101644], [55, 102144], [58, 102284], [62, 102404], [70, 103497], [73, 103678], [79, 104138], [84, 104518], [90, 105118], [95, 105338], [98, 105538], [106, 106098], [108, 106578], [112, 106738], [115, 106878], [118, 106978], [125, 107338], [136, 108398], [141, 108618], [144, 108798], [151, 109258], [154, 109378], [157, 109498]]}, {"verse": 17, "start": 110618, "end": 122796, "text": "Será su nombre para siempre, se perpetuará su nombre mientras el sol dure: y benditas serán en él todas las naciones: lo llamarán bienaventurado.", "words": [[0, 110618], [5, 110900], [8, 111140], [15, 111500], [20, 111760], [29, 112820], [32, 113100], [43, 114000], [46, 114180], [53, 114620], [62, 115000], [65, 115400], [69, 115895], [75, 116636], [77, 116778], [86, 117458], [92, 118198], [95, 118418], [98, 118638], [104, 119178], [108, 119538], [118, 120779], [121, 120859], [130, 121419]]}, {"verse": 18, "start": 123246, "end": 128186, "text": "Bendito Jehová Dios, el Dios de Israel, que solo hace maravillas.", "words": [[0, 123246], [8, 123874], [15, 124394], [21, 124974], [24, 125074], [29, 125314], [32, 125514], [40, 126254], [44, 126514], [49, 126834], [54, 127194]]}, {"verse": 19, "start": 128636, "end": 135747, "text": "Y bendito su nombre glorioso para siempre: y toda la tierra sea llena de su gloria. Amén y Amén.", "words": [[0, 128636], [2, 128742], [10, 129242], [13, 129422], [20, 129722], [29, 130322], [34, 130602], [43, 131573], [45, 131719], [50, 131939], [53, 132179], [60, 132519], [64, 132859], [70, 133279], [73, 133399], [76, 133599], [84, 134521], [89, 134981], [91, 135281]]}, {"verse": 20, "start": 136197, "end": 140112, "text": "Acábanse las oraciones de David, hijo de Isaí.", "words": [[0, 136197], [9, 136957], [13, 137117], [23, 137737], [26, 137957], [33, 138957], [38, 139177], [41, 139437]]}]}