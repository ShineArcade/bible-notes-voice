{"book": "GEN", "chapter": 34, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 288649, "verses": [{"verse": 1, "start": 300, "end": 7442, "text": "Y salió Dina la hija de Lea, la cual había esta parido a Jacob, a ver las hijas del país.", "words": [[0, 300], [2, 444], [8, 844], [13, 1324], [16, 1404], [21, 1804], [24, 1884], [29, 2584], [32, 2824], [37, 3104], [43, 3524], [48, 3944], [55, 4364], [57, 4504], [64, 5344], [66, 5444], [70, 5604], [74, 5804], [80, 6304], [84, 6684]]}, {"verse": 2, "start": 7892, "end": 17376, "text": "Y la vio Siquem, hijo de Hamor heveo, príncipe de aquella tierra, y la tomó, y se acostó con ella, y la deshonró.", "words": [[0, 7892], [2, 8033], [5, 8153], [9, 8793], [17, 9433], [22, 9813], [25, 10333], [31, 10853], [38, 11373], [47, 11933], [50, 12133], [58, 12453], [66, 13453], [68, 13553], [71, 13673], [77, 14173], [79, 14593], [82, 14753], [89, 15293], [93, 15493], [99, 15793], [101, 16353], [104, 16473]]}, {"verse": 3, "start": 17826, "end": 25059, "text": "Pero su alma se apegó a Dina la hija de Lea, y se enamoró de la joven, y habló al corazón de la joven.", "words": [[0, 17826], [5, 17988], [8, 18208], [13, 18528], [16, 18788], [22, 19208], [24, 19348], [29, 19668], [32, 19748], [37, 20108], [40, 20188], [45, 20888], [47, 21208], [50, 21348], [58, 22028], [61, 22128], [64, 22248], [71, 22968], [73, 23148], [79, 23508], [82, 23628], [90, 24088], [93, 24328], [96, 24428]]}, {"verse": 4, "start": 25509, "end": 32009, "text": "Y habló Siquem a Hamor su padre, diciendo: Tómame por mujer esta joven.", "words": [[0, 25509], [2, 25822], [8, 26322], [15, 26822], [17, 26982], [23, 27142], [26, 27362], [33, 27922], [43, 28934], [50, 29218], [54, 29438], [60, 29758], [65, 29978]]}, {"verse": 5, "start": 32359, "end": 43186, "text": "Y oyó Jacob que había Siquem deshonrado a Dina su hija: y estando sus hijos con su ganado en el campo, calló Jacob hasta que ellos viniesen.", "words": [[0, 32359], [2, 32547], [6, 32777], [12, 33597], [16, 33697], [22, 33977], [29, 34597], [40, 35457], [42, 35657], [47, 35877], [50, 36097], [56, 36897], [58, 36997], [66, 37437], [70, 37737], [76, 38057], [80, 38417], [83, 38657], [90, 39177], [93, 39297], [96, 39397], [103, 40157], [109, 40917], [115, 41257], [121, 41817], [125, 42037], [131, 42257]]}, {"verse": 6, "start": 43636, "end": 48252, "text": "Y se dirigió Hamor padre de Siquem a Jacob, para hablar con él.", "words": [[0, 43636], [2, 43760], [5, 43900], [13, 44380], [19, 44860], [25, 45380], [28, 45680], [35, 45980], [37, 46340], [44, 46700], [49, 47260], [56, 47580], [60, 47880]]}, {"verse": 7, "start": 48702, "end": 63770, "text": "Y los hijos de Jacob vinieron del campo cuando lo supieron; y se entristecieron los varones, y se ensañaron mucho, porque hizo vileza en Israel echándose con la hija de Jacob, lo que no se debía haber hecho.", "words": [[0, 48702], [2, 48790], [6, 48930], [12, 49230], [15, 49390], [21, 49690], [30, 50330], [34, 50590], [40, 51030], [47, 51350], [50, 51610], [60, 52811], [62, 52977], [65, 53097], [80, 54197], [84, 54397], [93, 55337], [95, 55597], [98, 55717], [108, 56417], [115, 56957], [122, 57577], [127, 58147], [134, 58717], [137, 58857], [144, 59277], [154, 60117], [158, 60357], [161, 60537], [166, 60877], [169, 61407], [176, 61937], [179, 62077], [183, 62217], [186, 62397], [189, 62597], [195, 62997], [201, 63237]]}, {"verse": 8, "start": 64220, "end": 72342, "text": "Y Hamor habló con ellos, diciendo: El alma de mi hijo Siquem se ha apegado a vuestra hija; os ruego que se la deis por mujer.", "words": [[0, 64220], [2, 64452], [8, 64722], [14, 65522], [18, 65722], [25, 66022], [35, 67379], [38, 67497], [43, 67757], [46, 67937], [49, 68037], [54, 68387], [61, 68737], [64, 68877], [67, 69167], [75, 69457], [77, 69537], [85, 69837], [91, 70555], [94, 70679], [100, 71039], [104, 71179], [107, 71319], [110, 71439], [115, 71679], [119, 71839]]}, {"verse": 9, "start": 72792, "end": 77803, "text": "Y emparentad con nosotros; dadnos vuestras hijas, y tomad vosotros las nuestras.", "words": [[0, 72792], [2, 72911], [13, 73491], [17, 73651], [27, 74659], [34, 75065], [43, 75465], [50, 76125], [52, 76245], [58, 76565], [67, 77005], [71, 77185]]}, {"verse": 10, "start": 78253, "end": 86660, "text": "Y habitad con nosotros; porque la tierra estará delante de vosotros; morad y negociad en ella, y tomad en ella posesión.", "words": [[0, 78253], [2, 78375], [10, 78835], [14, 78995], [24, 80111], [31, 80312], [34, 80492], [41, 80833], [48, 81452], [56, 81872], [59, 82012], [69, 83129], [75, 83529], [77, 83709], [86, 84289], [89, 84449], [95, 84709], [97, 85149], [103, 85489], [106, 85609], [111, 85809]]}, {"verse": 11, "start": 87010, "end": 94112, "text": "Siquem también dijo a su padre y a sus hermanos: Halle yo gracia en vuestros ojos, y daré lo que me digáis.", "words": [[0, 87234], [7, 87494], [15, 87874], [20, 88314], [22, 88514], [25, 88634], [31, 89014], [33, 89434], [35, 89534], [39, 89654], [49, 90917], [55, 91057], [58, 91237], [65, 91617], [68, 91717], [77, 92057], [83, 92397], [85, 92857], [90, 93117], [93, 93217], [97, 93317], [100, 93457]]}, {"verse": 12, "start": 94562, "end": 100139, "text": "Aumentad a cargo mío mucho dote y dones, que yo daré cuanto me digáis, y dadme la joven por mujer.", "words": [[0, 94723], [9, 94923], [11, 95123], [17, 95343], [21, 95823], [27, 96003], [32, 96363], [34, 96503], [41, 97003], [45, 97083], [48, 97223], [53, 97463], [60, 97623], [63, 97903], [71, 98383], [73, 98663], [79, 99003], [82, 99083], [88, 99423], [92, 99603]]}, {"verse": 13, "start": 100489, "end": 109162, "text": "Y respondieron los hijos de Jacob a Siquem y a Hamor su padre con engaño; y hablaron, por cuanto había deshonrado a Dina su hermana.", "words": [[0, 100489], [2, 100608], [15, 101308], [19, 101528], [25, 101828], [28, 102028], [34, 102408], [36, 102818], [43, 103228], [45, 103448], [47, 103728], [53, 104008], [56, 104208], [62, 104548], [66, 104828], [74, 105873], [76, 105975], [86, 106395], [90, 106575], [97, 106875], [103, 107425], [114, 107975], [116, 108155], [121, 108395], [124, 108575]]}, {"verse": 14, "start": 109612, "end": 118595, "text": "Y les dijeron: No podemos hacer esto de dar nuestra hermana a hombre que tiene prepucio; porque entre nosotros es abominación.", "words": [[0, 109612], [2, 109729], [6, 109829], [15, 110887], [18, 111012], [26, 111392], [32, 111732], [37, 112032], [40, 112212], [44, 112432], [52, 112752], [60, 113272], [62, 113492], [69, 113752], [73, 113952], [79, 114252], [89, 115452], [96, 115697], [102, 116218], [111, 116738], [114, 117197]]}, {"verse": 15, "start": 119045, "end": 126909, "text": "Mas con esta condición aceptaremos: si habéis de ser como nosotros, que se circuncide entre vosotros todo varón;", "words": [[0, 119045], [4, 119153], [8, 119353], [13, 119513], [23, 120173], [36, 121581], [39, 121747], [46, 122087], [49, 122207], [53, 122407], [58, 122647], [68, 123087], [72, 123467], [75, 123987], [86, 125067], [92, 125367], [101, 125967], [106, 126187]]}, {"verse": 16, "start": 127359, "end": 135237, "text": "Entonces os daremos nuestras hijas, y tomaremos nosotros las vuestras; y habitaremos con vosotros, y seremos un pueblo.", "words": [[0, 127359], [9, 127979], [12, 128239], [20, 128679], [29, 128999], [36, 129739], [38, 129899], [48, 130359], [57, 130839], [61, 131139], [71, 132096], [73, 132317], [85, 132857], [89, 133077], [99, 133677], [101, 134037], [109, 134357], [112, 134597]]}, {"verse": 17, "start": 135687, "end": 141995, "text": "Mas si no nos prestáis oído para circuncidaros, tomaremos nuestra hija, y nos iremos.", "words": [[0, 135784], [4, 135914], [7, 136094], [10, 136274], [14, 136434], [23, 137014], [28, 137394], [33, 137654], [48, 139114], [58, 139634], [66, 140054], [72, 140874], [74, 141074], [78, 141234]]}, {"verse": 18, "start": 142445, "end": 146872, "text": "Y parecieron bien sus palabras a Hamor y a Siquem, hijo de Hamor.", "words": [[0, 142445], [2, 142589], [13, 143169], [18, 143349], [22, 143549], [31, 143989], [33, 144299], [39, 144609], [41, 144916], [43, 145222], [51, 145529], [56, 146189], [59, 146545]]}, {"verse": 19, "start": 147322, "end": 157337, "text": "Y el mozo no tardó en hacer aquello, porque la hija de Jacob le había agradado: y él era el más honrado de toda la casa de su padre.", "words": [[0, 147322], [2, 147462], [5, 147602], [10, 147942], [13, 148182], [19, 148662], [22, 148842], [28, 149122], [37, 149722], [44, 150402], [47, 150662], [52, 150942], [55, 151062], [61, 151442], [64, 152162], [70, 152818], [80, 153723], [82, 153912], [85, 154052], [89, 154352], [92, 154532], [96, 154732], [104, 155512], [107, 155752], [112, 155932], [115, 156152], [120, 156412], [123, 156632], [126, 156772]]}, {"verse": 20, "start": 157787, "end": 166073, "text": "Entonces Hamor y Siquem su hijo vinieron a la puerta de su ciudad, y hablaron a los varones de su ciudad, diciendo:", "words": [[0, 157787], [9, 158301], [15, 158851], [17, 159191], [24, 159531], [27, 160011], [32, 160251], [41, 160771], [43, 161011], [46, 161111], [53, 161411], [56, 161711], [59, 161891], [67, 162371], [69, 162971], [78, 163531], [80, 163711], [84, 163891], [92, 164391], [95, 164551], [98, 164751], [106, 165191]]}, {"verse": 21, "start": 166523, "end": 182470, "text": "Estos varones son pacíficos con nosotros, y habitarán en el país, y comerciarán en él: pues he aquí la tierra es bastante ancha para ellos: nosotros tomaremos sus hijas por mujeres, y les daremos las nuestras.", "words": [[0, 166523], [6, 166825], [14, 167205], [18, 167425], [28, 168105], [32, 168245], [42, 168805], [44, 169445], [54, 170045], [57, 170185], [60, 170345], [66, 170685], [68, 171225], [80, 172185], [83, 172425], [87, 173058], [92, 173205], [95, 173505], [100, 174305], [103, 174445], [110, 174725], [113, 175005], [122, 175285], [128, 175825], [133, 176045], [140, 176898], [149, 177803], [159, 178623], [163, 178903], [169, 179283], [173, 179483], [182, 179983], [184, 180763], [188, 180943], [196, 181403], [200, 181583]]}, {"verse": 22, "start": 182920, "end": 195885, "text": "Mas con esta condición nos harán estos hombres el placer de habitar con nosotros, para que seamos un pueblo: que se circuncide todo varón entre nosotros, así como ellos son circuncidados.", "words": [[0, 182920], [4, 183088], [8, 183268], [13, 183448], [23, 184088], [27, 184328], [33, 184688], [39, 184888], [47, 185328], [50, 185588], [57, 186348], [60, 186528], [68, 186888], [72, 187088], [82, 187668], [87, 188428], [91, 188588], [98, 188968], [101, 189148], [109, 190085], [113, 190189], [116, 190809], [127, 191429], [132, 191689], [138, 192129], [144, 192349], [154, 193569], [158, 193809], [163, 194109], [169, 194309], [173, 194609]]}, {"verse": 23, "start": 196335, "end": 204996, "text": "Sus ganados, y sus bienes y todas sus bestias, serán nuestros: solamente convengamos con ellos, y habitarán con nosotros.", "words": [[0, 196335], [4, 196442], [13, 196982], [15, 197142], [19, 197322], [26, 197742], [28, 197882], [34, 198082], [38, 198382], [47, 198842], [53, 199542], [63, 200733], [73, 201263], [85, 202163], [89, 202423], [96, 202763], [98, 203283], [108, 203843], [112, 204043]]}, {"verse": 24, "start": 205446, "end": 216909, "text": "Y obedecieron a Hamor y a Siquem su hijo todos los que salían por la puerta de la ciudad, y circuncidaron a todo varón, a cuantos salían por la puerta de su ciudad.", "words": [[0, 205446], [2, 205611], [14, 206351], [16, 206631], [22, 206911], [24, 207191], [26, 207471], [33, 207751], [36, 207991], [41, 208571], [47, 208871], [51, 209271], [55, 209431], [62, 209891], [66, 210111], [69, 210271], [76, 210591], [79, 210851], [82, 210951], [90, 211251], [92, 211951], [106, 212991], [108, 213131], [113, 213311], [120, 214299], [122, 214430], [130, 214600], [137, 215280], [141, 215500], [144, 215640], [151, 215940], [154, 216283], [157, 216626]]}, {"verse": 25, "start": 217359, "end": 233716, "text": "Y sucedió que al tercer día, cuando sentían ellos el mayor dolor, los dos hijos de Jacob, Simeón y Leví, hermanos de Dina, tomaron cada uno su espada, y vinieron contra la ciudad animosamente, y mataron a todo varón.", "words": [[0, 217359], [2, 217483], [10, 218043], [14, 218243], [17, 218403], [24, 218723], [29, 219763], [36, 219903], [44, 220523], [50, 220823], [53, 221063], [59, 221343], [66, 222303], [70, 222403], [74, 222603], [80, 223143], [83, 223463], [90, 224083], [97, 224703], [99, 225143], [105, 225583], [114, 226043], [117, 226163], [123, 226963], [131, 227363], [136, 227583], [140, 227903], [143, 228143], [151, 229101], [153, 229223], [162, 229683], [169, 230103], [172, 230303], [179, 230583], [193, 231623], [195, 231963], [203, 232503], [205, 232743], [210, 232983]]}, {"verse": 26, "start": 234166, "end": 242989, "text": "Y a Hamor y a Siquem su hijo los mataron a filo de espada: y tomaron a Dina de casa de Siquem, y se salieron.", "words": [[0, 234166], [2, 234304], [4, 234584], [10, 234864], [12, 235177], [14, 235491], [21, 235804], [24, 236124], [29, 236504], [33, 237164], [41, 237724], [43, 237864], [48, 238224], [51, 238364], [59, 239410], [61, 239514], [69, 239934], [71, 240134], [76, 240354], [79, 240514], [84, 240734], [87, 241114], [95, 241494], [97, 242014], [100, 242174]]}, {"verse": 27, "start": 243439, "end": 250050, "text": "Y los hijos de Jacob vinieron a los muertos, y saquearon la ciudad; por cuanto habían deshonrado a su hermana.", "words": [[0, 243439], [2, 243521], [6, 243641], [12, 243921], [15, 244101], [21, 244381], [30, 245041], [32, 245221], [36, 245321], [45, 245761], [47, 246021], [57, 246581], [60, 246721], [68, 247627], [72, 247772], [79, 248245], [86, 248719], [97, 249192], [99, 249312], [102, 249412]]}, {"verse": 28, "start": 250500, "end": 256070, "text": "Tomaron sus ovejas y vacas y sus asnos, y lo que había en la ciudad y en el campo,", "words": [[0, 250500], [8, 250865], [12, 251245], [19, 251625], [21, 251745], [27, 252185], [29, 252305], [33, 252485], [40, 253265], [42, 253525], [45, 253665], [49, 253825], [55, 254025], [58, 254225], [61, 254365], [68, 254665], [70, 254965], [73, 255105], [76, 255225]]}, {"verse": 29, "start": 256520, "end": 264884, "text": "Y todos sus bienes; se llevaron cautivos a todos sus niños y sus mujeres, y robaron todo lo que había en casa.", "words": [[0, 256520], [2, 256520], [8, 256763], [12, 257263], [20, 258286], [23, 258430], [32, 258850], [41, 259430], [43, 259730], [49, 260010], [53, 260270], [59, 260730], [61, 261010], [65, 261190], [74, 261630], [76, 262310], [84, 262950], [89, 263310], [92, 263610], [96, 263790], [102, 263990], [105, 264270]]}, {"verse": 30, "start": 265334, "end": 281540, "text": "Entonces dijo Jacob a Simeón y a Leví: Me habéis turbado con hacerme abominable a los moradores de esta tierra, el cananeo y el ferezeo; y teniendo yo pocos hombres, se juntarán contra mí, y me herirán, y seré destruido yo y mi casa.", "words": [[0, 265334], [9, 265803], [14, 266563], [20, 266983], [22, 267483], [29, 267983], [31, 268283], [33, 268403], [39, 269104], [42, 269205], [49, 269465], [57, 269965], [61, 270145], [69, 270565], [80, 271245], [82, 271385], [86, 271485], [96, 271945], [99, 272185], [104, 272385], [112, 273345], [115, 273445], [123, 274025], [125, 274125], [128, 274540], [137, 275223], [139, 275328], [148, 275788], [151, 275948], [157, 276368], [166, 277088], [169, 277228], [178, 277748], [185, 278088], [189, 278348], [191, 278648], [194, 278768], [203, 279468], [205, 279728], [210, 280008], [220, 280588], [223, 280788], [225, 280908], [228, 281008]]}, {"verse": 31, "start": 281890, "end": 288249, "text": "Y ellos respondieron: ¿Había él de tratar a nuestra hermana como a una ramera?", "words": [[0, 281890], [2, 282093], [8, 282453], [22, 284092], [29, 284452], [32, 284932], [35, 285112], [42, 285472], [44, 285732], [52, 286032], [60, 286692], [65, 287012], [67, 287212], [71, 287755]]}]}