{"book": "MRK", "chapter": 3, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 249737, "verses": [{"verse": 1, "start": 300, "end": 6078, "text": "Y otra vez entró en la sinagoga; y había allí un hombre que tenía una mano atrofiada.", "words": [[0, 300], [2, 463], [7, 623], [11, 943], [17, 1403], [20, 1523], [23, 1623], [33, 2732], [35, 2858], [41, 3158], [46, 3458], [49, 3678], [56, 4018], [60, 4218], [66, 4538], [70, 4798], [75, 5058]]}, {"verse": 2, "start": 6078, "end": 11802, "text": "Y lo observaban atentamente para ver si lo sanaría en sábado, para acusarle.", "words": [[0, 6078], [2, 6318], [5, 6458], [16, 7378], [28, 8398], [33, 8658], [37, 8858], [40, 9058], [43, 9285], [51, 9511], [54, 9738], [62, 10458], [67, 11146]]}, {"verse": 3, "start": 12152, "end": 17191, "text": "Entonces dijo al hombre que tenía la mano atrofiada: Levántate en medio.", "words": [[0, 12152], [9, 12797], [14, 13402], [17, 13622], [24, 13882], [28, 14102], [34, 14382], [37, 14582], [42, 14802], [53, 15880], [63, 16465], [66, 16645]]}, {"verse": 4, "start": 17541, "end": 25812, "text": "Y les dice: ¿Es lícito hacer bien en sábado, o hacer mal? ¿salvar la vida, o quitarla? Pero ellos callaban.", "words": [[0, 17541], [2, 17668], [6, 17788], [12, 18604], [16, 18890], [23, 19570], [29, 19830], [34, 20090], [37, 20290], [45, 20910], [47, 21250], [53, 21490], [58, 22282], [66, 22645], [69, 22925], [75, 23245], [77, 23685], [87, 24638], [92, 24782], [98, 25319]]}, {"verse": 5, "start": 26162, "end": 38887, "text": "Y mirándolos alrededor con enojo, entristecido por la dureza de sus corazones, dice al hombre: Extiende tu mano. Y la extendió, y su mano fue restaurada sana.", "words": [[0, 26162], [2, 26304], [13, 27104], [23, 27524], [27, 27984], [34, 28904], [47, 29904], [51, 30184], [54, 30384], [61, 30884], [64, 31024], [68, 31204], [79, 32284], [84, 32644], [87, 32884], [95, 33626], [104, 34256], [107, 34456], [113, 35190], [115, 35397], [118, 35637], [128, 36537], [130, 36777], [133, 36957], [138, 37277], [142, 37537], [153, 38277]]}, {"verse": 6, "start": 39237, "end": 45862, "text": "Entonces saliendo los fariseos, tomaron consejo con los Herodianos contra él, para matarle.", "words": [[0, 39237], [9, 40136], [18, 40649], [22, 40829], [32, 41809], [40, 42249], [48, 43029], [52, 43249], [56, 43449], [67, 44249], [74, 44569], [78, 44869], [83, 45109]]}, {"verse": 7, "start": 46212, "end": 53167, "text": "Pero Jesús se apartó al mar con sus discípulos: y le siguió gran multitud de Galilea, y de Judea,", "words": [[0, 46212], [5, 46356], [11, 46736], [14, 47356], [21, 47816], [24, 47956], [28, 48176], [32, 48396], [36, 48536], [48, 49635], [50, 49757], [53, 49877], [60, 50317], [65, 50497], [74, 51157], [77, 51317], [86, 52097], [88, 52377], [91, 52497]]}, {"verse": 8, "start": 53517, "end": 66321, "text": "Y de Jerusalén, y de Idumea, y del otro lado del Jordán. Y los de alrededor de Tiro y de Sidón, grande multitud, oyendo cuán grandes cosas hacía, vinieron a él.", "words": [[0, 53517], [2, 53639], [5, 53739], [16, 54499], [18, 54699], [21, 54819], [29, 55639], [31, 56059], [35, 56239], [40, 56479], [45, 56839], [49, 57407], [57, 58128], [59, 58234], [63, 58414], [66, 58594], [76, 59014], [79, 59434], [84, 59854], [86, 59994], [89, 60154], [96, 60994], [103, 61534], [113, 62654], [120, 63034], [125, 63474], [133, 63914], [139, 64314], [146, 65234], [155, 65754], [157, 65934]]}, {"verse": 9, "start": 66671, "end": 75248, "text": "Y dijo a sus discípulos que le estuviese siempre lista una barca pequeña, por causa del gentío, para que no lo aplastaran.", "words": [[0, 66671], [2, 66797], [7, 67117], [9, 67257], [13, 67457], [24, 68257], [28, 68537], [31, 68817], [41, 69097], [49, 69457], [55, 69897], [59, 70137], [65, 70517], [74, 70997], [78, 71517], [84, 71897], [88, 72177], [96, 72817], [101, 73637], [105, 73817], [108, 74077], [111, 74237]]}, {"verse": 10, "start": 75598, "end": 82479, "text": "Porque había sanado a muchos; de manera que se lanzaban sobre él cuantos tenían dolencias, por tocarle.", "words": [[0, 75598], [7, 75762], [13, 76042], [20, 76582], [22, 76682], [30, 77640], [33, 77748], [40, 77968], [44, 78248], [47, 78408], [56, 79028], [62, 79328], [65, 79588], [73, 79848], [80, 80468], [91, 81228], [95, 81583]]}, {"verse": 11, "start": 82829, "end": 91614, "text": "Y los espíritus inmundos, al verle, se postraban delante de él, y daban voces, diciendo: Tú eres el Hijo de Dios.", "words": [[0, 82829], [2, 82933], [6, 83073], [16, 83793], [26, 84473], [29, 84853], [36, 85613], [39, 85693], [49, 86453], [57, 86953], [60, 87153], [64, 87373], [66, 87533], [72, 87853], [79, 88573], [89, 89931], [92, 90048], [97, 90288], [100, 90488], [105, 90688], [108, 90828]]}, {"verse": 12, "start": 91894, "end": 95651, "text": "Pero él les ordenaba firmemente que no le manifestasen.", "words": [[0, 91894], [5, 92041], [8, 92321], [12, 92681], [21, 93441], [32, 94201], [36, 94461], [39, 94601], [42, 94721]]}, {"verse": 13, "start": 96001, "end": 100654, "text": "Y subió al monte, y llamó a sí a los que él quiso; y vinieron a él.", "words": [[0, 96001], [2, 96110], [8, 96510], [11, 96650], [18, 97050], [20, 97560], [26, 98070], [28, 98160], [31, 98250], [33, 98340], [37, 98430], [41, 98570], [44, 98710], [51, 99481], [53, 99607], [62, 100067], [64, 100287]]}, {"verse": 14, "start": 101004, "end": 106600, "text": "Y estableció doce, para que estuviesen con él, y para enviarlos a predicar,", "words": [[0, 101004], [2, 101129], [13, 101729], [19, 102409], [24, 102909], [28, 103069], [39, 103609], [43, 103869], [47, 104149], [49, 104829], [54, 105009], [64, 105549], [66, 105789]]}, {"verse": 15, "start": 106950, "end": 111949, "text": "Y que tuviesen autoridad de sanar enfermedades, y de echar fuera demonios:", "words": [[0, 106950], [2, 107052], [6, 107172], [15, 107692], [25, 108392], [28, 108612], [34, 109032], [48, 109952], [50, 110312], [53, 110432], [59, 110752], [65, 110992]]}, {"verse": 16, "start": 112299, "end": 115095, "text": "A Simón, al cual puso por nombre Pedro;", "words": [[0, 112299], [2, 112409], [9, 113129], [12, 113249], [17, 113449], [22, 113849], [26, 114069], [33, 114349]]}, {"verse": 17, "start": 115445, "end": 124920, "text": "Y a Jacobo, hijo de Zebedeo, y a Juan hermano de Jacobo; y les dio el sobrenombre Boanerges, que es, Hijos del trueno;", "words": [[0, 115445], [2, 115587], [4, 115707], [12, 116587], [17, 116767], [20, 117238], [29, 117710], [31, 117972], [33, 118052], [38, 118252], [46, 118812], [49, 118892], [57, 119809], [59, 119910], [63, 120070], [67, 120310], [70, 120470], [82, 121590], [93, 122710], [97, 122830], [101, 123150], [107, 123830], [111, 124270]]}, {"verse": 18, "start": 125270, "end": 134380, "text": "Y a Andrés, y a Felipe, y a Bartolomé, y a Mateo, y a Tomás, y a Jacobo hijo de Alfeo, y a Tadeo, y a Simón el cananista,", "words": [[0, 125270], [2, 125434], [4, 125534], [12, 126034], [14, 126254], [16, 126294], [24, 127274], [26, 127334], [28, 127414], [39, 128454], [41, 128474], [43, 128534], [50, 129014], [52, 129194], [54, 129234], [61, 129994], [63, 130054], [65, 130114], [72, 130774], [77, 130934], [80, 131154], [87, 131674], [89, 131794], [91, 131914], [98, 132654], [100, 132714], [102, 132814], [108, 133374], [111, 133454]]}, {"verse": 19, "start": 134730, "end": 139418, "text": "Y a Judas Iscariote, el que le entregó. Y vinieron a casa.", "words": [[0, 134730], [2, 134866], [4, 134986], [10, 135206], [21, 136346], [24, 136766], [28, 136986], [31, 137146], [40, 138106], [42, 138235], [51, 138655], [53, 138815]]}, {"verse": 20, "start": 139768, "end": 144822, "text": "Y se agolpó de nuevo la gente, de modo que ellos ni siquiera podían comer.", "words": [[0, 139768], [2, 139896], [5, 140036], [12, 140616], [15, 140676], [21, 140896], [24, 141136], [31, 141996], [34, 142196], [39, 142376], [43, 142696], [49, 142976], [52, 143331], [61, 143771], [68, 144231]]}, {"verse": 21, "start": 145172, "end": 151983, "text": "Y como lo oyeron los suyos, vinieron para sujetarlo: porque decían: Está fuera de sí.", "words": [[0, 145172], [2, 145274], [7, 145514], [10, 145694], [17, 146154], [21, 146294], [28, 147354], [37, 147994], [42, 148254], [53, 149686], [60, 149836], [68, 150900], [73, 151124], [79, 151384], [82, 151604]]}, {"verse": 22, "start": 152263, "end": 161583, "text": "Y los escribas que habían venido de Jerusalén, decían que tenía a Beelzebú, y que por el príncipe de los demonios echaba fuera los demonios.", "words": [[0, 152263], [2, 152351], [6, 152491], [15, 153031], [19, 153171], [26, 153431], [33, 153891], [36, 154031], [47, 154711], [54, 155531], [58, 155711], [64, 156171], [66, 156631], [76, 157091], [78, 157691], [82, 157811], [86, 158031], [89, 158151], [98, 158831], [101, 159011], [105, 159151], [114, 159751], [121, 160211], [127, 160491], [131, 160771]]}, {"verse": 23, "start": 161933, "end": 168415, "text": "Y habiéndolos llamado, les decía en parábolas: ¿Cómo puede Satanás echar fuera a Satanás?", "words": [[0, 161933], [2, 162058], [14, 162738], [23, 163318], [27, 163898], [33, 164318], [36, 164538], [47, 165662], [53, 165894], [59, 166164], [67, 166724], [73, 167024], [79, 167464], [81, 167584]]}, {"verse": 24, "start": 168765, "end": 174403, "text": "Y si algún reino contra sí mismo está dividido, no puede permanecer el tal reino.", "words": [[0, 168765], [2, 169041], [5, 169201], [11, 169521], [17, 170041], [24, 170401], [27, 170641], [33, 171021], [38, 171241], [48, 171901], [51, 172281], [57, 172601], [68, 173401], [71, 173561], [75, 173741]]}, {"verse": 25, "start": 174753, "end": 179725, "text": "Y si una casa está dividida contra sí misma, no puede permanecer la tal casa.", "words": [[0, 174753], [2, 174832], [5, 174932], [9, 175132], [14, 175392], [19, 175652], [28, 176272], [35, 176552], [38, 176812], [45, 177612], [48, 177692], [54, 177932], [65, 178712], [68, 178892], [72, 179052]]}, {"verse": 26, "start": 180075, "end": 187428, "text": "Y si Satanás se levanta contra sí mismo, y se divide, no puede permanecer; antes tiene fin.", "words": [[0, 180075], [2, 180202], [5, 180362], [13, 181042], [16, 181142], [24, 181642], [31, 181982], [34, 182242], [41, 182742], [43, 183422], [46, 183582], [54, 184442], [57, 184802], [63, 185082], [75, 186213], [81, 186557], [87, 186897]]}, {"verse": 27, "start": 187778, "end": 196154, "text": "Nadie puede saquear los bienes del hombre fuerte entrando en su casa, si antes no ata al hombre fuerte y entonces saqueará su casa.", "words": [[0, 187778], [6, 188243], [12, 188563], [20, 189343], [24, 189523], [31, 189963], [35, 190103], [42, 190323], [49, 190703], [58, 191403], [61, 191603], [64, 191743], [70, 192463], [73, 192583], [79, 192823], [82, 193143], [86, 193503], [89, 193623], [96, 193823], [103, 194223], [105, 194423], [114, 194923], [123, 195423], [126, 195623]]}, {"verse": 28, "start": 196504, "end": 205294, "text": "De cierto os digo que todos los pecados serán perdonados a los hijos de los hombres, y las blasfemias, cualesquiera que sean;", "words": [[0, 196719], [3, 196973], [10, 197226], [13, 197706], [18, 198066], [22, 198286], [28, 198586], [32, 198846], [40, 199446], [46, 199906], [57, 200726], [59, 200966], [63, 201126], [69, 201426], [72, 201626], [76, 201746], [85, 202106], [87, 202626], [91, 202786], [103, 203626], [116, 204466], [120, 204666]]}, {"verse": 29, "start": 205644, "end": 213958, "text": "Pero cualquiera que blasfeme contra el Espíritu Santo, no tiene jamás perdón, sino que es reo de juicio eterno.", "words": [[0, 205644], [5, 205807], [16, 206407], [20, 206627], [29, 207407], [36, 207827], [39, 208027], [48, 208627], [55, 209067], [58, 209445], [64, 209824], [70, 210202], [78, 210962], [83, 211402], [87, 211582], [90, 211722], [94, 212302], [97, 212402], [104, 213002]]}, {"verse": 30, "start": 214308, "end": 216933, "text": "Porque decían: Tiene espíritu inmundo.", "words": [[0, 214308], [7, 214533], [15, 215537], [21, 215756], [30, 216376]]}, {"verse": 31, "start": 217213, "end": 223589, "text": "Vienen después sus hermanos y su madre, y estando fuera, enviaron a él llamándole.", "words": [[0, 217213], [7, 217518], [15, 217858], [19, 218158], [28, 218798], [30, 218918], [33, 219038], [40, 220218], [42, 220258], [50, 220698], [57, 221618], [66, 222338], [68, 222518], [71, 222658]]}, {"verse": 32, "start": 223939, "end": 230498, "text": "Y la gente estaba sentada alrededor de él, y le dijeron: He aquí, tu madre y tus hermanos te buscan fuera.", "words": [[0, 223939], [2, 224044], [5, 224124], [11, 224404], [18, 224764], [26, 225444], [36, 225824], [39, 226484], [43, 226744], [45, 226924], [48, 227044], [57, 227824], [60, 227988], [66, 228228], [69, 228408], [75, 228708], [77, 228868], [81, 228988], [90, 229468], [93, 229568], [100, 229948]]}, {"verse": 33, "start": 230778, "end": 235633, "text": "Y él les respondió, diciendo: ¿Quién es mi madre y mis hermanos?", "words": [[0, 230778], [2, 230965], [5, 231115], [9, 231265], [20, 232045], [30, 233364], [37, 233588], [40, 233708], [43, 233848], [49, 234248], [51, 234528], [55, 234728]]}, {"verse": 34, "start": 235983, "end": 242398, "text": "Y mirando a los que estaban sentados alrededor de él, dijo: He aquí mi madre y hermanos.", "words": [[0, 235983], [2, 236245], [10, 236705], [12, 236825], [16, 236945], [20, 237065], [28, 237425], [37, 238105], [47, 238525], [50, 239025], [54, 239165], [60, 240035], [63, 240125], [68, 240365], [71, 240585], [77, 240965], [79, 241505]]}, {"verse": 35, "start": 242748, "end": 249337, "text": "Porque cualquiera que hace la voluntad de Dios, este es mi hermano, y mi hermana, y mi madre.", "words": [[0, 242748], [7, 243009], [18, 243689], [22, 243889], [27, 244189], [30, 244409], [39, 244969], [42, 245109], [48, 245789], [53, 246249], [56, 246389], [59, 246509], [68, 247309], [70, 247489], [73, 247629], [82, 248149], [84, 248609], [87, 248729]]}]}