{"book": "GEN", "chapter": 29, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 299235, "verses": [{"verse": 1, "start": 300, "end": 4565, "text": "Y siguió Jacob su camino, y fue a la tierra de los orientales.", "words": [[0, 300], [2, 442], [9, 882], [15, 1162], [18, 1502], [26, 1962], [28, 2422], [32, 2622], [34, 2782], [37, 2842], [44, 3182], [47, 3482], [51, 3602]]}, {"verse": 2, "start": 5015, "end": 18102, "text": "Y miró, y vio un pozo en el campo: y he aquí tres rebaños de ovejas que yacían cerca de él; porque de aquel pozo bebían los ganados: y había una gran piedra sobre la boca del pozo.", "words": [[0, 5015], [2, 5139], [8, 5519], [10, 5719], [14, 5939], [17, 6079], [22, 6459], [25, 6619], [28, 6739], [35, 7670], [37, 7815], [40, 7955], [45, 8235], [50, 8555], [58, 9135], [61, 9335], [68, 9795], [72, 10255], [79, 10715], [85, 11075], [88, 11435], [92, 12110], [99, 12412], [102, 12712], [108, 13032], [113, 13452], [120, 13852], [124, 14032], [133, 15033], [135, 15158], [141, 15358], [145, 15638], [150, 15898], [157, 16518], [163, 16838], [166, 17078], [171, 17278], [175, 17518]]}, {"verse": 3, "start": 18552, "end": 31225, "text": "Y se juntaban allí todos los rebaños; y revolvían la piedra de sobre la boca del pozo, y daban de beber a las ovejas; y volvían la piedra sobre la boca del pozo a su lugar.", "words": [[0, 18552], [2, 18674], [5, 18794], [14, 19514], [19, 19774], [25, 20214], [29, 20514], [38, 21715], [40, 22098], [50, 22518], [53, 22698], [60, 23158], [63, 23418], [69, 23678], [72, 23758], [77, 23958], [81, 24178], [87, 24778], [89, 25338], [95, 25678], [98, 25858], [104, 26118], [106, 26298], [110, 26478], [118, 27548], [120, 27788], [128, 28268], [131, 28448], [138, 28968], [144, 29208], [147, 29408], [152, 29648], [156, 29888], [161, 30468], [163, 30608], [166, 30728]]}, {"verse": 4, "start": 31675, "end": 39557, "text": "Y les dijo Jacob: Hermanos míos, ¿de dónde sois? Y ellos respondieron: De Harán somos.", "words": [[0, 31675], [2, 31885], [6, 32115], [11, 32656], [18, 33403], [27, 33928], [33, 34688], [37, 34768], [43, 34968], [49, 35979], [51, 36162], [57, 36502], [71, 38169], [74, 38445], [80, 38765]]}, {"verse": 5, "start": 39907, "end": 49530, "text": "Y él les dijo: ¿Conocéis a Labán, hijo de Nacor? Y ellos dijeron: Sí, le conocemos.", "words": [[0, 39907], [2, 40112], [5, 40292], [9, 40592], [15, 41439], [25, 41956], [27, 42116], [34, 42716], [39, 42916], [42, 43291], [49, 43957], [51, 44123], [57, 44303], [66, 45346], [70, 45550], [73, 45630]]}, {"verse": 6, "start": 49880, "end": 57167, "text": "Y él les dijo: ¿Tiene paz? Y ellos dijeron: Paz; y he aquí Raquel su hija viene con el ganado.", "words": [[0, 49880], [2, 50086], [5, 50266], [9, 50566], [15, 51412], [22, 51613], [27, 52476], [29, 52642], [35, 52822], [44, 54070], [49, 54531], [51, 54669], [54, 54849], [59, 55129], [66, 55489], [69, 55729], [74, 55989], [80, 56169], [84, 56409], [87, 56549]]}, {"verse": 7, "start": 57517, "end": 66161, "text": "Y él dijo: He aquí el día es aún grande; no es tiempo todavía de recoger el ganado; dad de beber a las ovejas, e id a apacentarlas.", "words": [[0, 57517], [2, 57705], [5, 57865], [11, 58675], [14, 58755], [19, 59015], [22, 59275], [26, 59515], [29, 59795], [33, 59995], [41, 60903], [44, 61049], [47, 61189], [54, 61469], [62, 61949], [65, 62109], [73, 62569], [76, 62689], [84, 63508], [88, 63608], [91, 63768], [97, 63968], [99, 64108], [103, 64248], [111, 64668], [113, 64868], [116, 65068], [118, 65188]]}, {"verse": 8, "start": 66511, "end": 76392, "text": "Y ellos respondieron: No podemos, hasta que se junten todos los ganados, y remuevan la piedra de sobre la boca del pozo, para que demos de beber a las ovejas.", "words": [[0, 66511], [2, 66694], [8, 67034], [22, 68700], [25, 68859], [34, 69199], [40, 69519], [44, 69679], [47, 69819], [54, 70259], [60, 70479], [64, 70719], [73, 71219], [75, 71699], [84, 72179], [87, 72319], [94, 72719], [97, 72819], [103, 73059], [106, 73259], [111, 73479], [115, 73679], [121, 74219], [126, 74659], [130, 74799], [136, 75039], [139, 75199], [145, 75419], [147, 75579], [151, 75739]]}, {"verse": 9, "start": 76742, "end": 84321, "text": "Estando aún él hablando con ellos, Raquel vino con el ganado de su padre, porque ella era la pastora.", "words": [[0, 76742], [8, 77208], [12, 77508], [15, 77928], [24, 78428], [28, 78808], [35, 79548], [42, 80288], [47, 80528], [51, 80808], [54, 81098], [61, 81388], [64, 81568], [67, 81708], [74, 82348], [81, 82648], [86, 83088], [90, 83428], [93, 83588]]}, {"verse": 10, "start": 84771, "end": 101580, "text": "Y sucedió que, como Jacob vio a Raquel, hija de Labán hermano de su madre, y a las ovejas de Labán el hermano de su madre, Jacob se acercó, y removió la piedra de sobre la boca del pozo, y dio de beber al ganado de Labán hermano de su madre.", "words": [[0, 84771], [2, 84877], [10, 85417], [15, 85577], [20, 85837], [26, 86217], [30, 86737], [32, 86917], [40, 87817], [45, 88097], [48, 88177], [54, 88657], [62, 89137], [65, 89257], [68, 89377], [75, 90177], [77, 90237], [79, 90317], [83, 90497], [90, 90997], [93, 91177], [99, 91657], [102, 91697], [110, 92177], [113, 92257], [116, 92397], [123, 93077], [129, 93437], [132, 93737], [140, 94769], [142, 94932], [150, 95532], [153, 95692], [160, 96232], [163, 96352], [169, 96652], [172, 96872], [177, 97092], [181, 97312], [187, 98112], [189, 98432], [193, 98672], [196, 98832], [202, 99082], [205, 99332], [212, 99652], [215, 99972], [221, 100292], [229, 100712], [232, 100812], [235, 100972]]}, {"verse": 11, "start": 102030, "end": 107297, "text": "Y Jacob besó a Raquel, y alzó su voz, y lloró.", "words": [[0, 102030], [2, 102552], [8, 102892], [13, 103632], [15, 103772], [23, 104212], [25, 104832], [30, 105212], [33, 105372], [38, 105732], [40, 106772]]}, {"verse": 12, "start": 107747, "end": 116951, "text": "Y Jacob dijo a Raquel como él era hermano de su padre, y como era hijo de Rebeca: y ella corrió, y dio las nuevas a su padre.", "words": [[0, 107747], [2, 107868], [8, 108188], [13, 108848], [15, 109218], [22, 109588], [27, 109788], [30, 110028], [34, 110328], [42, 110848], [45, 110928], [48, 111068], [55, 111468], [57, 111948], [62, 112168], [66, 112388], [71, 112668], [74, 113154], [82, 113891], [84, 114037], [89, 114257], [97, 114857], [99, 115297], [103, 115457], [107, 115637], [114, 115917], [116, 116197], [119, 116337]]}, {"verse": 13, "start": 117401, "end": 129347, "text": "Y así que oyó Labán las nuevas de Jacob, hijo de su hermana, corrió a recibirlo, y lo abrazó, y lo besó, y lo trajo a su casa: y él contó a Labán todas estas cosas.", "words": [[0, 117401], [2, 117517], [6, 117737], [10, 117977], [14, 118287], [20, 118597], [24, 118777], [31, 119097], [34, 119357], [41, 120097], [46, 120377], [49, 120597], [52, 120757], [61, 121227], [68, 121697], [70, 121857], [81, 122577], [83, 123017], [86, 123157], [94, 123797], [96, 123977], [99, 124117], [105, 124577], [107, 124737], [110, 124877], [116, 125317], [118, 125457], [121, 125577], [127, 126496], [129, 126689], [132, 126849], [138, 127142], [140, 127436], [146, 127729], [152, 128129], [158, 128529]]}, {"verse": 14, "start": 129797, "end": 136845, "text": "Y Labán le dijo: Ciertamente hueso mío y carne mía eres. Y estuvo con él el tiempo de un mes.", "words": [[0, 129797], [2, 129923], [8, 130363], [11, 130703], [17, 131501], [29, 132229], [35, 132629], [39, 133029], [41, 133189], [47, 133489], [51, 133909], [57, 134789], [59, 134888], [66, 135228], [70, 135428], [73, 135568], [76, 135708], [83, 135988], [86, 136188], [89, 136288]]}, {"verse": 15, "start": 137295, "end": 145834, "text": "Entonces dijo Labán a Jacob: ¿Por ser tú mi hermano, me has de servir gratis? dime qué será tu salario.", "words": [[0, 137295], [9, 137901], [14, 138641], [20, 139121], [22, 139341], [29, 140185], [34, 140311], [38, 140511], [41, 140731], [44, 140871], [53, 141471], [56, 141751], [60, 141931], [63, 142031], [70, 142311], [78, 143399], [83, 143724], [87, 143904], [92, 144164], [95, 144324]]}, {"verse": 16, "start": 146184, "end": 153265, "text": "Y Labán tenía dos hijas: el nombre de la mayor era Lea, y el nombre de la menor, Raquel.", "words": [[0, 146184], [2, 146479], [8, 146813], [14, 147146], [18, 147306], [25, 148304], [28, 148491], [35, 148891], [38, 149131], [41, 149291], [47, 149591], [51, 149891], [56, 150631], [58, 150831], [61, 151011], [68, 151451], [71, 151691], [74, 151831], [81, 152548]]}, {"verse": 17, "start": 153715, "end": 160726, "text": "Y los ojos de Lea eran tiernos, pero Raquel era de lindo semblante y de hermoso parecer.", "words": [[0, 153715], [2, 153817], [6, 153957], [11, 154257], [14, 154457], [18, 154817], [23, 155077], [32, 156477], [37, 156887], [44, 157297], [48, 157557], [51, 157697], [57, 157997], [67, 158797], [69, 159337], [72, 159437], [80, 159977]]}, {"verse": 18, "start": 161176, "end": 166526, "text": "Y Jacob amó a Raquel, y dijo: Yo te serviré siete años por Raquel tu hija menor.", "words": [[0, 161176], [2, 161447], [8, 161727], [12, 162247], [14, 162327], [22, 162727], [24, 162987], [30, 163780], [33, 163922], [36, 164042], [44, 164482], [50, 164742], [55, 165102], [59, 165372], [66, 165642], [69, 165842], [74, 166102]]}, {"verse": 19, "start": 166876, "end": 172657, "text": "Y Labán respondió: Mejor es que te la dé a ti, que no que la dé a otro hombre: quédate conmigo.", "words": [[0, 166876], [2, 166998], [8, 167338], [19, 168350], [25, 168631], [28, 168791], [32, 168931], [35, 169071], [38, 169211], [41, 169351], [43, 169491], [47, 169911], [51, 170091], [54, 170211], [58, 170351], [61, 170451], [64, 170631], [66, 170671], [71, 170911], [79, 171706], [87, 171987]]}, {"verse": 20, "start": 173007, "end": 179215, "text": "Así sirvió Jacob por Raquel siete años: y le parecieron como pocos días, porque la amaba.", "words": [[0, 173007], [4, 173231], [11, 173731], [17, 173951], [21, 174471], [28, 174811], [34, 175151], [40, 176254], [42, 176533], [45, 176653], [56, 177213], [61, 177433], [67, 177833], [73, 178053], [80, 178293], [83, 178533]]}, {"verse": 21, "start": 179665, "end": 185779, "text": "Y dijo Jacob a Labán: Dame mi mujer, porque mi tiempo es cumplido, para que cohabite con ella.", "words": [[0, 179665], [2, 179792], [7, 180085], [13, 180379], [15, 180672], [22, 181545], [27, 181761], [30, 181981], [37, 182321], [44, 182661], [47, 182901], [54, 183201], [57, 183401], [67, 184301], [72, 184581], [76, 184891], [85, 185201], [89, 185421]]}, {"verse": 22, "start": 186129, "end": 191047, "text": "Entonces Labán juntó a todos los varones de aquel lugar, e hizo banquete.", "words": [[0, 186129], [9, 186986], [15, 187426], [21, 187906], [23, 188006], [29, 188226], [33, 188536], [41, 188846], [44, 189006], [50, 189266], [57, 189566], [59, 190026], [64, 190246]]}, {"verse": 23, "start": 191497, "end": 196944, "text": "Y sucedió que a la noche tomó a Lea su hija, y se la trajo: y él entró a ella.", "words": [[0, 191497], [2, 191613], [10, 192193], [14, 192373], [16, 192433], [19, 192513], [25, 192793], [30, 193293], [32, 193393], [36, 193653], [39, 193853], [45, 194233], [47, 194333], [50, 194453], [53, 194593], [60, 195471], [62, 195642], [65, 195822], [71, 196362], [73, 196482]]}, {"verse": 24, "start": 197394, "end": 201178, "text": "Y dio Labán su sierva Zilpa a su hija Lea por criada.", "words": [[0, 197394], [2, 197500], [6, 197713], [12, 197927], [15, 198140], [22, 198570], [28, 199000], [30, 199180], [33, 199340], [38, 199800], [42, 200120], [46, 200340]]}, {"verse": 25, "start": 201628, "end": 211853, "text": "Y venida la mañana, he aquí que era Lea: y él dijo a Labán: ¿Qué es esto que me has hecho? ¿no te he servido por Raquel? ¿por qué, pues, me has engañado?", "words": [[0, 201628], [2, 201895], [9, 202254], [12, 202374], [20, 202844], [23, 203314], [28, 203594], [32, 203814], [36, 203995], [41, 204849], [43, 205015], [46, 205155], [51, 205495], [53, 205735], [60, 206599], [65, 206740], [68, 206900], [73, 207100], [77, 207260], [80, 207380], [84, 207520], [91, 208274], [95, 208460], [98, 208620], [101, 208720], [109, 209100], [113, 209475], [121, 210094], [126, 210240], [131, 210380], [137, 210720], [140, 211020], [144, 211160]]}, {"verse": 26, "start": 212203, "end": 217866, "text": "Y Labán respondió: No se hace así en nuestro lugar, que se dé la menor antes de la mayor.", "words": [[0, 212203], [2, 212325], [8, 212665], [19, 213677], [22, 213841], [25, 214061], [30, 214261], [34, 214601], [37, 214761], [45, 214961], [52, 215821], [56, 215921], [59, 216081], [62, 216261], [65, 216361], [71, 216661], [77, 217101], [80, 217321], [83, 217421]]}, {"verse": 27, "start": 218316, "end": 224564, "text": "Cumple la semana de esta, y se te dará también la otra, por el servicio que hagas conmigo otros siete años.", "words": [[0, 218316], [7, 218593], [10, 218733], [17, 219053], [20, 219273], [26, 219673], [28, 220093], [31, 220233], [34, 220373], [39, 220673], [47, 220873], [50, 221113], [56, 221413], [60, 221713], [63, 221833], [72, 222173], [76, 222453], [82, 222733], [90, 223293], [96, 223593], [102, 223913]]}, {"verse": 28, "start": 224914, "end": 231388, "text": "E hizo Jacob así, y cumplió la semana de aquella: y él le dio a Raquel su hija por mujer.", "words": [[0, 225215], [2, 225555], [7, 225895], [13, 226235], [18, 226575], [20, 226935], [28, 227295], [31, 227435], [38, 227775], [41, 227995], [50, 228931], [52, 229096], [55, 229256], [58, 229416], [62, 229636], [64, 229776], [71, 230096], [74, 230376], [79, 230656], [83, 230816]]}, {"verse": 29, "start": 231838, "end": 236026, "text": "Y dio Labán a Raquel su hija por criada a su sierva Bilha.", "words": [[0, 231838], [2, 231977], [6, 232292], [12, 232607], [14, 232922], [21, 233237], [24, 233417], [29, 233777], [33, 234137], [40, 234497], [42, 234697], [45, 234837], [52, 235455]]}, {"verse": 30, "start": 236476, "end": 243697, "text": "Y entró también a Raquel: y la amó también más que a Lea: y sirvió con él aún otros siete años.", "words": [[0, 236476], [2, 236651], [8, 237031], [16, 237311], [18, 237631], [26, 238534], [28, 238814], [31, 238974], [35, 239254], [43, 239494], [47, 239814], [51, 239974], [53, 240114], [58, 240845], [60, 241099], [67, 241539], [71, 241719], [74, 241879], [78, 242119], [84, 242519], [90, 242919]]}, {"verse": 31, "start": 244147, "end": 250946, "text": "Y vio Jehová que Lea era aborrecida, y abrió su matriz: pero Raquel era estéril.", "words": [[0, 244147], [2, 244289], [6, 244549], [13, 244929], [17, 245159], [21, 245389], [25, 245629], [37, 246949], [39, 247269], [45, 247629], [48, 247809], [56, 248941], [61, 249122], [68, 249562], [72, 250002]]}, {"verse": 32, "start": 251396, "end": 264465, "text": "Y concibió Lea, y parió un hijo, y llamó su nombre Rubén, porque dijo: Ya que ha mirado Jehová mi aflicción; ahora por tanto me amará mi marido.", "words": [[0, 251396], [2, 251503], [11, 252143], [16, 253023], [18, 253063], [24, 253423], [27, 253643], [33, 254383], [35, 254503], [41, 254803], [44, 254963], [51, 255343], [58, 256543], [65, 256763], [71, 257583], [74, 257831], [78, 258071], [81, 258251], [88, 258631], [95, 259151], [98, 259271], [109, 260395], [115, 260880], [119, 260960], [125, 261480], [128, 261580], [134, 261900], [137, 262040]]}, {"verse": 33, "start": 264815, "end": 276229, "text": "Y concibió otra vez, y parió un hijo, y dijo: Por cuanto oyó Jehová que yo era aborrecida, me ha dado también este. Y llamó su nombre Simeón.", "words": [[0, 264815], [2, 264939], [11, 265599], [16, 265819], [21, 266639], [23, 266679], [29, 267099], [32, 267399], [38, 268079], [40, 268139], [46, 268911], [50, 269031], [57, 269401], [61, 269771], [68, 270391], [72, 270451], [75, 270671], [79, 271301], [91, 271931], [94, 272091], [97, 272231], [102, 272451], [110, 272891], [116, 274277], [118, 274401], [124, 274761], [127, 274941], [134, 275321]]}, {"verse": 34, "start": 276679, "end": 288551, "text": "Y concibió otra vez, y parió un hijo, y dijo: Ahora esta vez se unirá mi marido conmigo, porque le he parido tres hijos: por tanto, llamó su nombre Leví.", "words": [[0, 276679], [2, 276803], [11, 277463], [16, 277683], [21, 278503], [23, 278543], [29, 278963], [32, 279263], [38, 279943], [40, 280003], [46, 280775], [52, 281189], [57, 281589], [61, 281909], [64, 282289], [70, 282709], [73, 282829], [80, 283229], [89, 284049], [96, 284469], [99, 284689], [102, 284829], [109, 285229], [114, 285449], [121, 286462], [125, 286586], [132, 287066], [138, 287446], [141, 287586], [148, 287946]]}, {"verse": 35, "start": 289001, "end": 298835, "text": "Y concibió otra vez, y parió un hijo, y dijo: Esta vez alabaré a Jehová: por esto llamó su nombre Judá: y dejó de parir.", "words": [[0, 289001], [2, 289126], [11, 289786], [16, 290006], [21, 290826], [23, 290866], [29, 291286], [32, 291586], [38, 292266], [40, 292326], [46, 293098], [51, 293319], [55, 293459], [63, 293599], [65, 294247], [73, 295183], [77, 295308], [82, 295608], [88, 296048], [91, 296188], [98, 296528], [104, 297457], [106, 297730], [111, 298110], [114, 298250]]}]}