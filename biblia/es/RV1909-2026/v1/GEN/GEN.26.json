{"book": "GEN", "chapter": 26, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 312346, "verses": [{"verse": 1, "start": 300, "end": 10973, "text": "Y hubo hambre en la tierra, además de la primera hambre que fue en los días de Abraham: y se fue Isaac a Abimelec rey de los filisteos, en Gerar.", "words": [[0, 300], [2, 500], [7, 840], [14, 1200], [17, 1380], [20, 1480], [28, 2100], [35, 2380], [38, 2940], [41, 3060], [49, 3360], [56, 3820], [60, 3980], [64, 4200], [67, 4520], [71, 4680], [76, 5020], [79, 5200], [88, 6213], [90, 6362], [93, 6442], [97, 6682], [103, 7262], [105, 7727], [114, 8387], [118, 9047], [121, 9227], [125, 9387], [136, 10227], [139, 10627]]}, {"verse": 2, "start": 11323, "end": 18881, "text": "Y se le apareció Jehová, y le dijo: No desciendas a Egipto: habita en la tierra que yo te diré;", "words": [[0, 11323], [2, 11469], [5, 11549], [8, 11729], [17, 12349], [25, 13329], [27, 13629], [30, 13749], [36, 14463], [39, 14681], [50, 15301], [52, 15521], [60, 16778], [67, 16944], [70, 17111], [73, 17291], [80, 17671], [84, 17871], [87, 18031], [90, 18171]]}, {"verse": 3, "start": 19231, "end": 31681, "text": "Habita en esta tierra, y seré contigo, y te bendeciré; porque a ti y a tu descendencia daré todas estas tierras, y confirmaré el juramento que juré a Abraham tu padre:", "words": [[0, 19231], [7, 19670], [10, 19790], [15, 19990], [23, 20410], [25, 20930], [30, 21230], [39, 21870], [41, 22170], [44, 22330], [55, 23616], [62, 23865], [64, 24045], [67, 24285], [69, 24565], [71, 24625], [74, 24745], [87, 25525], [92, 26065], [98, 26265], [104, 26645], [113, 27245], [115, 27765], [126, 28505], [129, 28725], [139, 29305], [143, 29565], [148, 30005], [150, 30145], [158, 30605], [161, 30945]]}, {"verse": 4, "start": 32031, "end": 42620, "text": "Y multiplicaré tu descendencia como las estrellas del cielo, y daré a tu descendencia todas estas tierras; y todas las naciones de la tierra serán benditas en tu simiente:", "words": [[0, 32031], [2, 32169], [15, 33009], [18, 33169], [31, 33989], [36, 34229], [40, 34449], [50, 35009], [54, 35129], [61, 35529], [63, 35724], [68, 36064], [70, 36124], [73, 36244], [86, 37164], [92, 37349], [98, 37749], [107, 38682], [109, 38782], [115, 39022], [119, 39302], [128, 39762], [131, 39942], [134, 40042], [141, 40422], [147, 40882], [156, 41402], [159, 41562], [162, 41662]]}, {"verse": 5, "start": 42970, "end": 50000, "text": "Por cuanto oyó Abraham mi voz, y guardó mi precepto, mis mandamientos, mis estatutos y mis leyes.", "words": [[0, 42970], [4, 43134], [11, 43521], [15, 43907], [23, 44294], [26, 44454], [31, 44794], [33, 45134], [40, 45554], [43, 45674], [53, 46574], [57, 46654], [71, 47894], [75, 47974], [85, 48534], [87, 48974], [91, 49114]]}, {"verse": 6, "start": 50280, "end": 52977, "text": "Habitó, pues, Isaac en Gerar.", "words": [[0, 50280], [8, 50790], [14, 51030], [20, 51810], [23, 52411]]}, {"verse": 7, "start": 53327, "end": 71553, "text": "Y los hombres de aquel lugar le preguntaron acerca de su mujer; y él respondió: Es mi hermana; porque tuvo miedo de decir: Es mi mujer; que tal vez, dijo, los hombres del lugar me matarían por causa de Rebeca; porque era de hermoso aspecto.", "words": [[0, 53327], [2, 53436], [6, 53556], [14, 53936], [17, 54136], [23, 54436], [29, 54756], [32, 54996], [44, 55836], [51, 56336], [54, 56676], [57, 56856], [64, 57914], [66, 58200], [69, 58487], [80, 59348], [83, 59535], [86, 59735], [95, 60552], [102, 60754], [107, 61074], [113, 61514], [116, 61754], [123, 62604], [126, 62965], [129, 63165], [136, 64068], [140, 64170], [144, 64330], [149, 64990], [155, 66070], [159, 66190], [167, 66530], [171, 66690], [177, 67030], [180, 67290], [189, 67890], [193, 68130], [199, 68450], [202, 68800], [210, 69470], [217, 69850], [221, 70190], [224, 70330], [232, 70830]]}, {"verse": 8, "start": 71903, "end": 82822, "text": "Y sucedió que, después que él estuvo allí muchos días, Abimelec, rey de los filisteos, mirando por una ventana, vio a Isaac que jugaba con Rebeca su mujer.", "words": [[0, 71903], [2, 72030], [10, 72570], [15, 72750], [23, 73150], [27, 73450], [30, 73750], [37, 74150], [42, 74370], [49, 74630], [55, 75329], [65, 76027], [69, 76410], [72, 76510], [76, 76650], [87, 77690], [95, 78070], [99, 78310], [103, 78490], [112, 79450], [116, 79650], [118, 79910], [124, 80790], [128, 80870], [135, 81370], [139, 81570], [146, 82030], [149, 82230]]}, {"verse": 9, "start": 83172, "end": 96528, "text": "Y llamó Abimelec a Isaac, y dijo: He aquí ella es de cierto tu mujer: ¿cómo, pues, dijiste: Es mi hermana? E Isaac le respondió: Porque dije: Quizá moriré por causa de ella.", "words": [[0, 83172], [2, 83297], [8, 83477], [17, 83657], [19, 84457], [26, 85557], [28, 85657], [34, 86376], [37, 86456], [42, 86716], [47, 87036], [50, 87276], [53, 87376], [60, 87696], [63, 87956], [70, 88681], [77, 88909], [83, 89179], [92, 89964], [95, 90083], [98, 90223], [107, 91008], [109, 91008], [115, 91557], [118, 92117], [129, 93377], [136, 93517], [142, 94199], [148, 94538], [155, 94938], [159, 95118], [165, 95358], [168, 95618]]}, {"verse": 10, "start": 96808, "end": 105577, "text": "Y Abimelec dijo: ¿Por qué nos has hecho esto? Por poco hubiera dormido alguno del pueblo con tu mujer, y hubieras traído sobre nosotros el pecado.", "words": [[0, 97062], [2, 97348], [11, 97635], [17, 98577], [22, 98722], [26, 98862], [30, 99022], [34, 99222], [40, 99442], [46, 100221], [50, 100346], [55, 100646], [63, 101006], [71, 101406], [78, 101806], [82, 101886], [89, 102186], [93, 102426], [96, 102546], [103, 102886], [105, 103346], [114, 103706], [121, 104046], [127, 104306], [136, 104706], [139, 104966]]}, {"verse": 11, "start": 105857, "end": 113509, "text": "Entonces Abimelec mandó a todo el pueblo, diciendo: El que toque a este hombre o a su mujer, de cierto morirá.", "words": [[0, 105857], [9, 106569], [18, 107319], [24, 108019], [26, 108099], [31, 108279], [34, 108499], [42, 108859], [52, 109888], [55, 110007], [59, 110127], [65, 110467], [67, 110567], [72, 110807], [79, 111187], [81, 111387], [83, 111487], [86, 111607], [93, 112427], [96, 112487], [103, 112787]]}, {"verse": 12, "start": 113789, "end": 120449, "text": "Y sembró Isaac en aquella tierra, y halló aquel año ciento por uno: y le bendijo Jehová.", "words": [[0, 113789], [2, 113907], [9, 114467], [15, 114827], [18, 115322], [26, 115682], [34, 116242], [36, 116664], [42, 117087], [48, 117347], [52, 117627], [59, 117907], [63, 118287], [68, 118975], [70, 119102], [73, 119202], [81, 119682]]}, {"verse": 13, "start": 120799, "end": 128012, "text": "Y el varón se engrandeció, y fue adelantando y engrandeciéndose, hasta hacerse muy poderoso:", "words": [[0, 120799], [2, 120925], [5, 121025], [11, 121425], [14, 121565], [27, 122405], [29, 122965], [33, 123165], [45, 124305], [47, 124565], [65, 125845], [71, 126265], [79, 126945], [83, 127165]]}, {"verse": 14, "start": 128362, "end": 134626, "text": "Y tuvo hato de ovejas, y hato de vacas, y grande apero; y los filisteos le tuvieron envidia.", "words": [[0, 128362], [2, 128483], [7, 128803], [12, 129123], [15, 129223], [23, 129743], [25, 130015], [30, 130288], [33, 130388], [40, 131048], [42, 131348], [49, 131668], [56, 132445], [58, 132673], [62, 132793], [72, 133413], [75, 133553], [84, 133953]]}, {"verse": 15, "start": 134976, "end": 143567, "text": "Y todos los pozos que habían abierto los criados de Abraham su padre en sus días, los filisteos los habían cegado y llenado de tierra.", "words": [[0, 134976], [2, 135120], [8, 135400], [12, 135660], [18, 136220], [22, 136380], [29, 136680], [37, 137160], [41, 137340], [49, 137920], [52, 138140], [60, 138740], [63, 138820], [69, 139140], [72, 139320], [76, 139460], [82, 140160], [86, 140670], [96, 141180], [100, 141340], [107, 141660], [114, 142320], [116, 142440], [124, 142880], [127, 143020]]}, {"verse": 16, "start": 143917, "end": 149994, "text": "Y dijo Abimelec a Isaac: Apártate de nosotros, porque mucho más poderoso que nosotros te has hecho.", "words": [[0, 143917], [2, 144082], [7, 144608], [16, 145135], [18, 145661], [25, 146361], [34, 146899], [37, 146999], [47, 147399], [54, 147699], [60, 148019], [64, 148199], [73, 148719], [77, 148879], [86, 149159], [89, 149499], [93, 149639]]}, {"verse": 17, "start": 150274, "end": 156410, "text": "E Isaac se fue de allí; y asentó sus tiendas en el valle de Gerar, y habitó allí.", "words": [[0, 150274], [2, 150542], [8, 150842], [11, 151422], [15, 151622], [18, 152002], [24, 152530], [26, 152696], [33, 153236], [37, 153436], [45, 154036], [48, 154176], [51, 154316], [57, 154596], [60, 154886], [67, 155176], [69, 155556], [76, 155976]]}, {"verse": 18, "start": 156760, "end": 170621, "text": "Y volvió a abrir Isaac los pozos de agua que habían abierto en los días de Abraham su padre, y que los filisteos habían cegado, muerto Abraham; y los llamó por los nombres que su padre los había llamado.", "words": [[0, 156760], [2, 156897], [9, 157357], [11, 157517], [17, 157947], [23, 158377], [27, 158772], [33, 159272], [36, 159412], [41, 159812], [45, 160027], [52, 160267], [60, 160747], [63, 160927], [67, 161047], [72, 161307], [75, 161487], [83, 162067], [86, 162147], [93, 163047], [95, 163087], [99, 163187], [103, 163327], [113, 164027], [120, 164307], [128, 165007], [135, 165547], [144, 166558], [146, 166659], [150, 166799], [156, 167259], [160, 167459], [164, 167619], [172, 168239], [176, 168699], [179, 168859], [185, 169232], [189, 169606], [195, 169979]]}, {"verse": 19, "start": 170971, "end": 176925, "text": "Y los siervos de Isaac cavaron en el valle, y hallaron allí un pozo de aguas vivas.", "words": [[0, 170971], [2, 171056], [6, 171196], [14, 171736], [17, 171856], [23, 172396], [31, 173091], [34, 173251], [37, 173411], [44, 173731], [46, 174191], [55, 174611], [60, 174851], [63, 175091], [68, 175571], [71, 175731], [77, 176131]]}, {"verse": 20, "start": 177275, "end": 188556, "text": "Y los pastores de Gerar riñeron con los pastores de Isaac, diciendo: El agua es nuestra: por eso llamó el nombre del pozo Esek, porque habían altercado con él.", "words": [[0, 177275], [2, 177400], [6, 177520], [15, 178020], [18, 178350], [24, 178680], [32, 179515], [36, 179715], [40, 179915], [49, 180395], [52, 180555], [59, 180975], [69, 182165], [72, 182305], [77, 182605], [80, 182985], [89, 183939], [93, 184106], [97, 184286], [103, 184646], [106, 184746], [113, 185046], [117, 185266], [122, 185786], [128, 186306], [135, 186746], [142, 187106], [152, 187886], [156, 188146]]}, {"verse": 21, "start": 188906, "end": 195240, "text": "Y abrieron otro pozo, y también riñeron sobre él: y llamó su nombre Sitna.", "words": [[0, 188906], [2, 189177], [11, 189697], [16, 189897], [22, 190497], [24, 190857], [32, 191597], [40, 192337], [46, 192657], [50, 193413], [52, 193540], [58, 193860], [61, 194000], [68, 194620]]}, {"verse": 22, "start": 195590, "end": 208451, "text": "Y se apartó de allí, y abrió otro pozo, y no riñeron sobre él: y llamó su nombre Rehobot, y dijo: Porque ahora nos ha hecho ensanchar Jehová, y fructificaremos en la tierra.", "words": [[0, 195590], [2, 195777], [5, 195877], [12, 196437], [15, 196597], [21, 196897], [23, 197437], [29, 197777], [34, 198037], [40, 198657], [42, 199177], [45, 199607], [53, 200037], [59, 200357], [63, 201089], [65, 201235], [71, 201555], [74, 201715], [81, 202615], [90, 203515], [92, 203695], [98, 204409], [105, 204619], [111, 204899], [115, 205099], [118, 205279], [124, 205479], [134, 206049], [142, 206619], [144, 206819], [160, 207639], [163, 207839], [166, 207939]]}, {"verse": 23, "start": 208731, "end": 210441, "text": "Y de allí subió a Beerseba.", "words": [[0, 208731], [2, 208895], [5, 208955], [10, 209155], [16, 209615], [18, 210053]]}, {"verse": 24, "start": 210791, "end": 224206, "text": "Y se le apareció Jehová aquella noche, y dijo: Yo soy el Dios de Abraham tu padre; no temas, que yo soy contigo, y yo te bendeciré, y multiplicaré tu descendencia por amor de Abraham mi siervo.", "words": [[0, 210791], [2, 210938], [5, 211058], [8, 211218], [17, 211858], [24, 212418], [32, 212778], [39, 213118], [41, 213398], [47, 214077], [50, 214237], [54, 214537], [57, 214737], [62, 214957], [65, 215177], [73, 215817], [76, 215877], [83, 216900], [86, 217060], [93, 217440], [97, 217840], [100, 218000], [104, 218200], [113, 218940], [115, 219200], [118, 219340], [121, 219480], [132, 220280], [134, 220580], [147, 221300], [150, 221440], [163, 222200], [167, 222400], [172, 222620], [175, 222910], [183, 223200], [186, 223400]]}, {"verse": 25, "start": 224486, "end": 234823, "text": "Y edificó allí un altar, e invocó el nombre de Jehová, y tendió allí su tienda: y abrieron allí los siervos de Isaac un pozo.", "words": [[0, 224486], [2, 224646], [10, 225406], [15, 225626], [18, 225906], [25, 226926], [27, 227026], [34, 227726], [37, 227886], [44, 228266], [47, 228466], [55, 229306], [57, 229546], [64, 230086], [69, 230366], [72, 230586], [80, 231494], [82, 231600], [91, 231960], [96, 232320], [100, 232560], [108, 233140], [111, 233320], [117, 233720], [120, 234160]]}, {"verse": 26, "start": 235173, "end": 242582, "text": "Y Abimelec vino a él desde Gerar, y Ahuzat, amigo suyo, y Ficol, capitán de su ejército.", "words": [[0, 235173], [2, 235567], [11, 235997], [16, 236277], [18, 236557], [21, 236717], [27, 237157], [34, 237597], [36, 238337], [44, 239077], [50, 239397], [56, 240037], [58, 240197], [65, 240937], [73, 241497], [76, 241617], [79, 241737]]}, {"verse": 27, "start": 242932, "end": 249338, "text": "Y les dijo Isaac: ¿Por qué venís a mí, pues que me habéis aborrecido, y me echasteis de entre vosotros?", "words": [[0, 243012], [2, 243132], [6, 243252], [11, 243732], [18, 244473], [23, 244599], [27, 244719], [33, 245039], [35, 245139], [39, 245719], [44, 245799], [48, 245939], [51, 246059], [58, 246299], [70, 247039], [72, 247479], [75, 247599], [85, 248199], [88, 248299], [94, 248519]]}, {"verse": 28, "start": 249618, "end": 260072, "text": "Y ellos respondieron: Hemos visto que Jehová es contigo; y dijimos: Haya ahora juramento entre nosotros, entre nosotros y ti, y haremos pacto contigo:", "words": [[0, 249618], [2, 249801], [8, 250141], [22, 251758], [28, 251976], [34, 252376], [38, 252726], [45, 253076], [48, 253196], [57, 254386], [59, 254686], [68, 255151], [73, 255415], [79, 255675], [89, 256255], [95, 256515], [105, 257255], [111, 257455], [120, 257915], [122, 258215], [126, 258715], [128, 258795], [136, 259055], [142, 259515]]}, {"verse": 29, "start": 260422, "end": 268439, "text": "Que no nos hagas mal, como nosotros no te hemos tocado, y como solamente te hemos hecho bien, y te enviamos en paz: tú ahora, bendito de Jehová.", "words": [[0, 260422], [4, 260504], [7, 260684], [11, 260864], [17, 261184], [22, 261604], [27, 261784], [36, 262224], [39, 262444], [42, 262604], [48, 262744], [56, 263284], [58, 263504], [63, 263684], [73, 264084], [76, 264384], [82, 264544], [88, 264804], [94, 265104], [96, 265344], [99, 265504], [108, 265924], [111, 266104], [116, 266811], [119, 266927], [126, 267367], [134, 267807], [137, 267927]]}, {"verse": 30, "start": 268719, "end": 273055, "text": "Entonces él les hizo banquete, y comieron y bebieron.", "words": [[0, 268719], [9, 269323], [12, 269983], [16, 270348], [21, 270608], [31, 271308], [33, 271523], [42, 272043], [44, 272243]]}, {"verse": 31, "start": 273405, "end": 281628, "text": "Y se levantaron de madrugada, y juraron el uno al otro; e Isaac los despidió, y ellos se partieron de él en paz.", "words": [[0, 273405], [2, 273512], [5, 273632], [16, 274272], [19, 274432], [30, 275132], [32, 275232], [40, 275772], [43, 275972], [47, 276192], [50, 276392], [56, 277152], [58, 277590], [64, 278060], [68, 278440], [78, 279100], [80, 279620], [86, 279900], [89, 280100], [99, 280620], [102, 280840], [105, 281000], [108, 281140]]}, {"verse": 32, "start": 281978, "end": 291872, "text": "Y en aquel día sucedió que vinieron los criados de Isaac, y le dieron nuevas acerca del pozo que habían abierto, y le dijeron: Agua hemos hallado.", "words": [[0, 281978], [2, 282137], [5, 282257], [11, 282597], [15, 282877], [23, 283657], [27, 283817], [36, 284377], [40, 284577], [48, 285117], [51, 285257], [58, 285777], [60, 286357], [63, 286477], [70, 286817], [77, 287157], [84, 287677], [88, 287977], [93, 288437], [97, 288597], [104, 288837], [113, 289457], [115, 289692], [118, 289812], [127, 290757], [132, 291095], [138, 291235]]}, {"verse": 33, "start": 292152, "end": 298612, "text": "Y lo llamó Seba: por cuya causa el nombre de aquella ciudad es Beerseba hasta este día.", "words": [[0, 292152], [2, 292416], [5, 292716], [11, 293016], [17, 293467], [21, 293612], [26, 293972], [32, 294412], [35, 294672], [42, 295052], [45, 295272], [53, 295672], [60, 295972], [63, 296662], [72, 297352], [78, 297732], [83, 298032]]}, {"verse": 34, "start": 298962, "end": 308288, "text": "Y cuando Esaú fue de cuarenta años, tomó por mujer a Judit hija de Beeri heteo, y a Basemat hija de Elón heteo:", "words": [[0, 298962], [2, 299087], [9, 299517], [14, 299947], [18, 300207], [21, 300347], [30, 300947], [36, 301927], [41, 302407], [45, 302587], [51, 302987], [53, 303557], [59, 304127], [64, 304427], [67, 304960], [73, 305494], [80, 306027], [82, 306434], [84, 306840], [92, 307247], [97, 307567], [100, 307687], [105, 307988]]}, {"verse": 35, "start": 308638, "end": 311946, "text": "Y fueron amargura de espíritu a Isaac y a Rebeca.", "words": [[0, 309224], [2, 309316], [9, 309716], [18, 310116], [21, 310256], [30, 310696], [32, 310966], [38, 311236], [40, 311356], [42, 311396]]}]}