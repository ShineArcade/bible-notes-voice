{"book": "GEN", "chapter": 30, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 350576, "verses": [{"verse": 1, "start": 300, "end": 9840, "text": "Y viendo Raquel que no daba hijos a Jacob, tuvo envidia de su hermana, y decía a Jacob: Dame hijos, o si no, me muero.", "words": [[0, 300], [2, 428], [9, 748], [16, 1488], [20, 1548], [23, 1748], [28, 2068], [34, 2388], [36, 2648], [43, 3448], [48, 3788], [56, 4708], [59, 4848], [62, 5028], [71, 5568], [73, 5788], [79, 6148], [81, 6588], [88, 7409], [93, 7629], [100, 8369], [102, 8469], [105, 8609], [109, 9129], [112, 9309]]}, {"verse": 2, "start": 10120, "end": 17910, "text": "Y Jacob se enojaba contra Raquel, y decía: ¿Soy yo en lugar de Dios, que te impidió el fruto de tu vientre?", "words": [[0, 10120], [2, 10307], [8, 10587], [11, 11247], [19, 11927], [26, 12287], [34, 12867], [36, 13287], [43, 14168], [48, 14411], [51, 14711], [54, 14851], [60, 15051], [63, 15271], [69, 15831], [73, 16031], [76, 16171], [84, 16651], [87, 16751], [93, 17091], [96, 17211], [99, 17351]]}, {"verse": 3, "start": 18190, "end": 26466, "text": "Y ella dijo: He aquí mi sierva Bilha; entra a ella, y parirá sobre mis rodillas, y yo también tendré hijos de ella.", "words": [[0, 18190], [2, 18352], [7, 18552], [13, 19416], [16, 19526], [21, 19806], [24, 20306], [31, 20798], [38, 21482], [44, 21612], [46, 21772], [52, 22192], [54, 22652], [61, 23072], [67, 23312], [71, 23512], [81, 24492], [83, 24572], [86, 24732], [94, 24992], [101, 25512], [107, 25812], [110, 26052]]}, {"verse": 4, "start": 26746, "end": 31604, "text": "Así le dio a Bilha su sierva por mujer; y Jacob entró a ella.", "words": [[0, 26746], [4, 27110], [7, 27370], [11, 27610], [13, 27850], [19, 28090], [22, 28290], [29, 28810], [33, 29110], [40, 29972], [42, 30136], [48, 30376], [54, 30996], [56, 31116]]}, {"verse": 5, "start": 31954, "end": 35043, "text": "Y concibió Bilha, y parió a Jacob un hijo.", "words": [[0, 31954], [2, 32051], [11, 32561], [18, 33071], [20, 33451], [26, 33871], [28, 33991], [34, 34271], [37, 34531]]}, {"verse": 6, "start": 35393, "end": 42976, "text": "Y dijo Raquel: Me juzgó Dios, y también oyó mi voz, y me dio un hijo. Por tanto llamó su nombre Dan.", "words": [[0, 35393], [2, 35515], [7, 35735], [15, 36576], [18, 36696], [24, 37076], [30, 37336], [32, 37876], [40, 38176], [44, 38596], [47, 38716], [52, 39056], [54, 39396], [57, 39516], [61, 39716], [64, 39896], [70, 40605], [74, 40728], [80, 41288], [86, 41648], [89, 41788], [96, 42148]]}, {"verse": 7, "start": 43326, "end": 49363, "text": "Y concibió otra vez Bilha, la sierva de Raquel, y parió el hijo segundo a Jacob.", "words": [[0, 43326], [2, 43429], [11, 44049], [16, 44309], [20, 44919], [27, 45529], [30, 45629], [37, 46089], [40, 46229], [48, 46729], [50, 47309], [56, 47749], [59, 47909], [64, 48089], [72, 48549], [74, 48789]]}, {"verse": 8, "start": 49713, "end": 56687, "text": "Y dijo Raquel: Con luchas de Dios he contendido con mi hermana, y he vencido. Y llamó su nombre Neftalí.", "words": [[0, 49713], [2, 49835], [7, 50055], [15, 50895], [19, 51035], [26, 51475], [29, 51595], [34, 51855], [37, 52155], [48, 52795], [52, 52935], [55, 53075], [64, 53515], [66, 53935], [69, 54035], [78, 54979], [80, 55183], [86, 55423], [89, 55663], [96, 55903]]}, {"verse": 9, "start": 57037, "end": 63722, "text": "Y viendo Lea que había dejado de parir, tomó a Zilpa su sierva, y la dio a Jacob por mujer.", "words": [[0, 57037], [2, 57302], [9, 57608], [13, 57915], [17, 58095], [23, 58335], [30, 58855], [33, 59035], [40, 59455], [45, 60015], [47, 60295], [53, 60575], [56, 60715], [64, 61235], [66, 61615], [69, 61995], [73, 62235], [75, 62435], [81, 62775], [85, 63080]]}, {"verse": 10, "start": 64072, "end": 68256, "text": "Y Zilpa, sierva de Lea, parió a Jacob un hijo.", "words": [[0, 64295], [2, 64555], [9, 64815], [16, 65075], [19, 65435], [24, 65895], [30, 66835], [32, 67035], [38, 67395], [41, 67775]]}, {"verse": 11, "start": 68606, "end": 72662, "text": "Y dijo Lea: Vino la ventura. Y llamó su nombre Gad.", "words": [[0, 68606], [2, 68904], [7, 69124], [12, 69880], [17, 70183], [20, 70585], [29, 71208], [31, 71332], [37, 71652], [40, 71752], [47, 72207]]}, {"verse": 12, "start": 73012, "end": 76862, "text": "Y Zilpa, la sierva de Lea, parió otro hijo a Jacob.", "words": [[0, 73012], [2, 73268], [9, 73558], [12, 73678], [19, 74098], [22, 74218], [27, 74658], [33, 75258], [38, 75678], [43, 75938], [45, 76158]]}, {"verse": 13, "start": 77212, "end": 83980, "text": "Y dijo Lea: Para dicha mía; porque las mujeres me dirán dichosa: y llamó su nombre Aser.", "words": [[0, 77212], [2, 77511], [7, 77731], [12, 78486], [17, 78697], [23, 79117], [28, 79776], [35, 79959], [39, 80179], [47, 80559], [50, 80849], [56, 81139], [65, 82350], [67, 82476], [73, 82796], [76, 82936], [83, 83485]]}, {"verse": 14, "start": 84330, "end": 98112, "text": "Y fue Rubén en tiempo de la siega de los trigos, y halló mandrágoras en el campo, y las trajo a Lea su madre: y dijo Raquel a Lea: Te ruego que me des de las mandrágoras de tu hijo.", "words": [[0, 84330], [2, 84586], [6, 84746], [12, 85226], [15, 85506], [22, 85946], [25, 86166], [28, 86406], [34, 86646], [37, 86726], [41, 86866], [49, 87806], [51, 88106], [57, 88466], [69, 89466], [72, 89786], [75, 89946], [82, 90786], [84, 91006], [88, 91166], [94, 91473], [96, 91779], [100, 92086], [103, 92246], [110, 93062], [112, 93291], [117, 93611], [124, 94085], [126, 94558], [131, 95171], [134, 95271], [140, 95651], [144, 95811], [147, 95971], [151, 96211], [154, 96371], [158, 96511], [170, 97211], [173, 97411], [176, 97591]]}, {"verse": 15, "start": 98392, "end": 110764, "text": "Y ella respondió: ¿Es poco que hayas tomado mi marido, sino que también te has de llevar las mandrágoras de mi hijo? y dijo Raquel: Pues dormirá contigo esta noche por las mandrágoras de tu hijo.", "words": [[0, 98392], [2, 98593], [7, 98873], [18, 100091], [22, 100271], [27, 100511], [31, 100771], [37, 101131], [44, 101491], [47, 101651], [55, 102351], [60, 102531], [64, 102751], [72, 103051], [75, 103311], [79, 103451], [82, 103591], [89, 103791], [93, 104071], [105, 104711], [108, 104931], [111, 105091], [117, 105886], [119, 106009], [124, 106249], [132, 107064], [137, 107284], [145, 107884], [153, 108344], [158, 108524], [164, 108864], [168, 109124], [172, 109514], [184, 109904], [187, 110084], [190, 110264]]}, {"verse": 16, "start": 111044, "end": 124630, "text": "Y cuando Jacob volvía del campo a la tarde, salió Lea a él, y le dijo: A mí has de entrar, porque a la verdad te he alquilado por las mandrágoras de mi hijo. Y durmió con ella aquella noche.", "words": [[0, 111044], [2, 111126], [9, 111346], [15, 111746], [22, 112239], [26, 112733], [32, 113226], [34, 113306], [37, 113366], [44, 114006], [50, 114626], [54, 115246], [56, 115506], [60, 115806], [62, 115991], [65, 116131], [71, 116848], [73, 117052], [76, 117225], [80, 117399], [83, 117572], [91, 118572], [98, 118752], [100, 118892], [103, 118992], [110, 119332], [113, 119652], [116, 119792], [126, 120352], [130, 120572], [134, 120752], [146, 121412], [149, 121632], [152, 121792], [158, 122547], [160, 122673], [167, 123193], [171, 123353], [176, 123613], [184, 123993]]}, {"verse": 17, "start": 124980, "end": 130246, "text": "Y oyó Dios a Lea: y concibió, y parió a Jacob el quinto hijo.", "words": [[0, 124980], [2, 125117], [6, 125287], [11, 125690], [13, 126093], [18, 126646], [20, 126766], [30, 127606], [32, 127926], [38, 128406], [40, 128673], [46, 128938], [49, 129206], [56, 129666]]}, {"verse": 18, "start": 130596, "end": 138655, "text": "Y dijo Lea: Dios me ha dado mi recompensa, por cuanto di mi sierva a mi marido: por eso llamó su nombre Isacar.", "words": [[0, 130596], [2, 130895], [7, 131115], [12, 131870], [17, 132109], [20, 132309], [23, 132449], [28, 132629], [31, 132809], [43, 134029], [47, 134289], [54, 134549], [57, 134829], [60, 134949], [67, 135429], [69, 135549], [72, 135629], [80, 136506], [84, 136631], [88, 136831], [94, 137231], [97, 137371], [104, 138044]]}, {"verse": 19, "start": 139005, "end": 142791, "text": "Y concibió Lea otra vez, y parió el sexto hijo a Jacob.", "words": [[0, 139005], [2, 139112], [11, 139712], [15, 140032], [20, 140212], [25, 140612], [27, 141012], [33, 141352], [36, 141472], [42, 141912], [47, 142092], [49, 142252]]}, {"verse": 20, "start": 143141, "end": 153378, "text": "Y dijo Lea: Dios me ha dado una buena dote: ahora morará conmigo mi marido, porque le he parido seis hijos: y llamó su nombre Zabulón.", "words": [[0, 143141], [2, 143439], [7, 143659], [12, 144415], [17, 144740], [20, 145060], [23, 145260], [28, 145500], [32, 145720], [38, 146040], [44, 146860], [50, 147231], [57, 147731], [65, 148391], [68, 148471], [76, 149411], [83, 149611], [86, 149811], [89, 150011], [96, 150431], [101, 150731], [108, 151601], [110, 151704], [116, 152024], [119, 152184], [126, 152815]]}, {"verse": 21, "start": 153728, "end": 157820, "text": "Y después parió una hija, y llamó su nombre Dina.", "words": [[0, 153728], [2, 154048], [10, 154348], [16, 154848], [20, 155068], [26, 155828], [28, 155988], [34, 156348], [37, 156508], [44, 156888]]}, {"verse": 22, "start": 158170, "end": 163241, "text": "Y se acordó Dios de Raquel, y la oyó Dios, y abrió su matriz.", "words": [[0, 158170], [2, 158471], [5, 158611], [12, 159111], [17, 159351], [20, 159551], [28, 159991], [30, 160214], [33, 160436], [37, 160756], [43, 161556], [45, 161876], [51, 162196], [54, 162396]]}, {"verse": 23, "start": 163591, "end": 168740, "text": "Y concibió, y parió un hijo: y dijo: Quitado ha Dios mi afrenta:", "words": [[0, 163591], [2, 163712], [12, 164492], [14, 164712], [20, 165152], [23, 165432], [29, 166255], [31, 166424], [37, 167152], [45, 167422], [48, 167692], [53, 167892], [56, 168092]]}, {"verse": 24, "start": 169020, "end": 172842, "text": "Y llamó su nombre José, diciendo: Añádame Jehová otro hijo.", "words": [[0, 169020], [2, 169149], [8, 169489], [11, 169689], [18, 170069], [24, 170549], [34, 170972], [42, 171518], [49, 172038], [54, 172358]]}, {"verse": 25, "start": 173122, "end": 181496, "text": "Y aconteció, cuando Raquel hubo parido a José, que Jacob dijo a Labán: Envíame, e iré a mi lugar, y a mi tierra.", "words": [[0, 173122], [2, 173252], [13, 173932], [20, 174332], [27, 174732], [32, 175032], [39, 175432], [41, 175532], [47, 176412], [51, 176632], [57, 176992], [62, 177532], [64, 177692], [71, 178470], [80, 179057], [82, 179417], [86, 179717], [88, 179797], [91, 179917], [98, 180297], [100, 180657], [102, 180717], [105, 180837]]}, {"verse": 26, "start": 181846, "end": 189604, "text": "Dame mis mujeres y mis hijos, por las cuales he servido contigo, y déjame ir; pues tú sabes los servicios que te he hecho.", "words": [[0, 181846], [5, 182084], [9, 182344], [17, 182784], [19, 183044], [23, 183244], [30, 183844], [34, 184064], [38, 184224], [45, 184524], [48, 184884], [56, 185284], [65, 185924], [67, 186244], [74, 186664], [78, 187271], [83, 187375], [86, 187595], [92, 187895], [96, 188135], [106, 188635], [110, 188915], [113, 189075], [116, 189175]]}, {"verse": 27, "start": 189884, "end": 197670, "text": "Y Labán le respondió: Halle yo ahora gracia en tus ojos, y quédate; experimentado he que Jehová me ha bendecido por tu causa.", "words": [[0, 189884], [2, 190096], [8, 190346], [11, 190726], [22, 191830], [28, 191964], [31, 192097], [37, 192397], [44, 192697], [47, 192917], [51, 193057], [57, 193357], [59, 193757], [68, 195153], [82, 195423], [85, 195693], [89, 195713], [96, 196093], [99, 196193], [102, 196273], [112, 196753], [116, 196953], [119, 197093]]}, {"verse": 28, "start": 197950, "end": 200806, "text": "Y dijo: Señálame tu salario, que yo lo daré.", "words": [[0, 197950], [2, 198079], [8, 198801], [17, 199321], [20, 199481], [29, 199941], [33, 200101], [36, 200261], [39, 200381]]}, {"verse": 29, "start": 201086, "end": 206341, "text": "Y él respondió: Tú sabes cómo te he servido, y cómo ha estado tu ganado conmigo;", "words": [[0, 201086], [2, 201268], [5, 201408], [16, 202403], [19, 202499], [25, 202839], [30, 203179], [33, 203379], [36, 203499], [45, 204039], [47, 204259], [52, 204539], [55, 204699], [62, 205019], [65, 205259], [72, 205679]]}, {"verse": 30, "start": 206691, "end": 217525, "text": "Porque poco tenías antes de mi venida, y ha crecido en gran número; y Jehová te ha bendecido con mi llegada: y ahora ¿cuándo voy a hacer yo también por mi propia casa?", "words": [[0, 206691], [7, 206920], [12, 207180], [19, 207660], [25, 208060], [28, 208280], [31, 208380], [39, 208860], [41, 209260], [44, 209360], [52, 209780], [55, 209940], [60, 210120], [68, 210885], [70, 211005], [77, 211405], [80, 211505], [83, 211625], [93, 212165], [97, 212345], [100, 212525], [109, 214041], [111, 214178], [117, 214758], [125, 215158], [129, 215318], [131, 215498], [137, 215738], [140, 215938], [148, 216278], [152, 216538], [155, 216678], [162, 216878]]}, {"verse": 31, "start": 217805, "end": 225584, "text": "Y él dijo: ¿Qué te daré? Y respondió Jacob: No me des nada: si haces por mí esto, volveré a apacentar tus ovejas.", "words": [[0, 217805], [2, 217994], [5, 218154], [11, 218873], [16, 218976], [19, 219116], [25, 219813], [27, 219937], [37, 220517], [44, 221298], [47, 221438], [50, 221578], [54, 221698], [60, 222423], [63, 222607], [69, 222887], [73, 223127], [76, 223307], [82, 223887], [90, 224267], [92, 224347], [102, 224747], [106, 224927]]}, {"verse": 32, "start": 225934, "end": 240191, "text": "Yo pasaré hoy por todas tus ovejas, poniendo aparte todas las ovejas manchadas y salpicadas de color, y todas las reses de color oscuro entre las ovejas, y las manchadas y moteadas entre las cabras; y esto será mi salario.", "words": [[0, 225934], [3, 226022], [10, 226422], [14, 226642], [18, 226842], [24, 227102], [28, 227362], [36, 228462], [45, 228862], [52, 229362], [58, 229562], [62, 229822], [69, 230282], [79, 230862], [81, 231042], [92, 231642], [95, 231802], [102, 232702], [104, 232782], [110, 233022], [114, 233312], [120, 233602], [123, 233782], [129, 234022], [136, 234542], [142, 234722], [146, 234922], [154, 235803], [156, 235904], [160, 236024], [170, 236664], [172, 236884], [181, 237404], [187, 237704], [191, 237924], [199, 238751], [201, 238892], [206, 239132], [211, 239412], [214, 239572]]}, {"verse": 33, "start": 240541, "end": 252228, "text": "Así responderá por mí mi honradez mañana, cuando venga mi salario delante de ti: toda la que no sea pintada ni manchada en las cabras y de color oscuro en las ovejas mías, se me tendrá por robada.", "words": [[0, 240541], [4, 240788], [15, 241468], [19, 241668], [22, 242008], [25, 242278], [34, 242548], [42, 243408], [49, 243508], [55, 243888], [58, 244028], [66, 244468], [74, 244828], [77, 245008], [81, 245778], [86, 245994], [89, 246054], [93, 246194], [96, 246334], [100, 246534], [108, 247134], [111, 247254], [120, 247754], [123, 247814], [127, 247954], [134, 248434], [136, 248534], [139, 248674], [145, 248874], [152, 249414], [155, 249514], [159, 249614], [166, 250014], [172, 250694], [175, 250954], [178, 251094], [185, 251487], [189, 251881]]}, {"verse": 34, "start": 252508, "end": 255703, "text": "Y dijo Labán: Mira, ojalá fuese como tú dices.", "words": [[0, 252508], [2, 252628], [7, 252928], [14, 253738], [20, 253918], [26, 254358], [32, 254718], [37, 254938], [40, 255118]]}, {"verse": 35, "start": 255983, "end": 272247, "text": "Y apartó aquel día los machos cabríos rayados y manchados; y todas las cabras manchadas y de color vario, y toda res que tenía en sí algo de blanco, y todas las de color oscuro entre las ovejas, y las puso en manos de sus hijos;", "words": [[0, 255983], [2, 256100], [9, 256560], [15, 256900], [19, 257160], [23, 257395], [30, 257862], [38, 258328], [46, 258795], [48, 258975], [59, 260029], [61, 260177], [67, 260437], [71, 260697], [78, 261157], [88, 261857], [90, 262202], [93, 262342], [99, 262852], [106, 263362], [108, 263742], [113, 263962], [117, 264282], [121, 264772], [127, 265262], [130, 265382], [133, 265602], [138, 266002], [141, 266182], [149, 266722], [151, 267067], [157, 267407], [161, 267947], [164, 268107], [170, 268307], [177, 268807], [183, 268987], [187, 269207], [195, 270236], [197, 270358], [201, 270458], [206, 270858], [209, 270998], [215, 271218], [218, 271438], [222, 271618]]}, {"verse": 36, "start": 272597, "end": 279148, "text": "Y puso tres días de camino entre sí y Jacob: y Jacob apacentaba las otras ovejas de Labán.", "words": [[0, 272597], [2, 272909], [7, 273229], [12, 273489], [17, 273789], [20, 273929], [27, 274309], [33, 274589], [36, 274889], [38, 275129], [45, 275924], [47, 276190], [53, 276790], [64, 277390], [68, 277610], [74, 277890], [81, 278410], [84, 278800]]}, {"verse": 37, "start": 279498, "end": 290445, "text": "Y Jacob tomó varas de álamo verdes, y de avellano, y de castaño, y les quitó parte de la corteza para formar franjas blancas, descubriendo así lo blanco de las varas.", "words": [[0, 279498], [2, 279624], [8, 279964], [13, 280529], [19, 280949], [22, 281309], [28, 281669], [36, 282029], [38, 282289], [41, 282389], [51, 282909], [53, 282989], [56, 283109], [65, 283769], [67, 284229], [71, 284369], [77, 284669], [83, 284929], [86, 285129], [89, 285229], [97, 285789], [102, 286009], [109, 286449], [117, 286929], [126, 287878], [139, 288661], [143, 288901], [146, 289081], [153, 289521], [156, 289661], [160, 289781]]}, {"verse": 38, "start": 290795, "end": 302157, "text": "Y puso las varas que había pelado en las pilas, delante del ganado, en los abrevaderos del agua donde venían a beber las ovejas, las cuales entraban en celo viniendo a beber.", "words": [[0, 290795], [2, 290901], [7, 291301], [11, 291501], [17, 291921], [21, 292061], [27, 292321], [34, 292801], [37, 292921], [41, 293041], [48, 293701], [56, 294161], [60, 294621], [68, 295081], [71, 295621], [75, 295781], [87, 296701], [91, 296861], [96, 297121], [102, 297361], [109, 297861], [111, 297981], [117, 298181], [121, 298401], [129, 299402], [133, 299526], [140, 299746], [149, 300426], [152, 300586], [157, 301066], [166, 301546], [168, 301666]]}, {"verse": 39, "start": 302507, "end": 311375, "text": "Y concebían las ovejas delante de las varas, y parían borregos listados, pintados y salpicados de diversos colores.", "words": [[0, 302507], [2, 302634], [12, 303234], [16, 303434], [23, 303874], [31, 304434], [34, 304574], [38, 304674], [45, 305174], [47, 305534], [54, 306034], [63, 306894], [73, 307894], [82, 308894], [84, 309194], [95, 309894], [98, 310114], [107, 310634]]}, {"verse": 40, "start": 311725, "end": 324033, "text": "Y apartaba Jacob los corderos, y los ponía con su rebaño, los listados, y todo lo que era oscuro en el hato de Labán. Y ponía su hato aparte, y no lo ponía con las ovejas de Labán.", "words": [[0, 311725], [2, 311843], [11, 312363], [17, 312763], [21, 313303], [31, 313843], [33, 314103], [37, 314223], [43, 314603], [47, 314783], [50, 314983], [58, 315803], [62, 315943], [72, 316603], [74, 316848], [79, 317108], [82, 317348], [86, 317528], [90, 317688], [97, 318288], [100, 318448], [103, 318648], [108, 318848], [111, 318948], [118, 319769], [120, 319872], [126, 320252], [129, 320532], [134, 320812], [142, 321772], [144, 321892], [147, 322032], [150, 322152], [156, 322532], [160, 322692], [164, 322852], [171, 323272], [174, 323432]]}, {"verse": 41, "start": 324383, "end": 335618, "text": "Y sucedía que cuantas veces entraban en celo las tempranas, Jacob ponía las varas delante de las ovejas en las pilas, para que concibiesen a la vista de las varas.", "words": [[0, 324383], [2, 324509], [10, 325089], [14, 325309], [22, 325709], [28, 326149], [37, 326929], [40, 327116], [45, 327302], [49, 327489], [60, 329129], [66, 329409], [72, 330049], [76, 330229], [82, 330549], [90, 330989], [93, 331149], [97, 331309], [104, 331729], [107, 331909], [111, 332069], [118, 332809], [123, 333029], [127, 333209], [139, 334029], [141, 334269], [144, 334369], [150, 334609], [153, 334849], [157, 334989]]}, {"verse": 42, "start": 335968, "end": 343647, "text": "Y cuando venían las ovejas tardías, no las ponía: así eran las tardías para Labán, y las tempranas para Jacob.", "words": [[0, 335968], [2, 336070], [9, 336310], [16, 336790], [20, 336970], [27, 337390], [36, 338410], [39, 338670], [43, 338830], [50, 339627], [54, 339895], [59, 340215], [63, 340415], [71, 340915], [76, 341245], [83, 341575], [85, 342055], [89, 342195], [99, 342815], [104, 343015]]}, {"verse": 43, "start": 343997, "end": 350177, "text": "Y el varón prosperó muchísimo, y tuvo muchas ovejas, y siervas y siervos, y camellos y asnos.", "words": [[0, 343997], [2, 344158], [5, 344338], [11, 344758], [20, 345378], [31, 345958], [33, 346273], [38, 346493], [45, 346893], [53, 347473], [55, 347613], [63, 348033], [65, 348233], [74, 348653], [76, 348833], [85, 349373], [87, 349533]]}]}