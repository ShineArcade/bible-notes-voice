{"book": "LUK", "chapter": 17, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 270064, "verses": [{"verse": 1, "start": 300, "end": 8069, "text": "Y A SUS discípulos dice: Imposible es que no vengan escándalos; pero ¡ay de aquel por quien vienen!", "words": [[0, 300], [2, 443], [4, 543], [8, 683], [19, 1523], [25, 2742], [35, 3102], [38, 3282], [42, 3382], [45, 3562], [52, 3942], [64, 5148], [69, 5520], [73, 5930], [76, 6330], [82, 6770], [86, 6990], [92, 7250]]}, {"verse": 2, "start": 8419, "end": 18075, "text": "Mejor le fuera, si le pusiesen al cuello una piedra de molino, y le lanzasen en el mar, que escandalizar a uno de estos pequeñitos.", "words": [[0, 8419], [6, 8804], [9, 8984], [16, 9384], [19, 9924], [22, 10064], [31, 10564], [34, 10844], [41, 11244], [45, 11464], [52, 11944], [55, 12064], [63, 12804], [65, 13104], [68, 13224], [77, 14044], [80, 14184], [83, 14344], [88, 14624], [92, 15084], [105, 16124], [107, 16384], [111, 16584], [114, 16764], [120, 17004]]}, {"verse": 3, "start": 18425, "end": 25256, "text": "Mirad por vosotros: si peca contra ti tu hermano, repréndele; y si se arrepiente, perdónale.", "words": [[0, 18425], [6, 18873], [10, 19213], [20, 20123], [23, 20267], [28, 20687], [35, 21007], [38, 21347], [41, 21447], [50, 21947], [62, 23129], [64, 23214], [67, 23334], [70, 23534], [82, 24214]]}, {"verse": 4, "start": 25606, "end": 33270, "text": "Y si siete veces al día peca contra ti, y siete veces al día se vuelve a ti, diciendo, me arrepiento, perdónalo.", "words": [[0, 25606], [2, 25713], [5, 25833], [11, 26173], [17, 26453], [20, 26813], [24, 27033], [29, 27573], [36, 27893], [40, 28153], [42, 28533], [48, 28793], [54, 29093], [57, 29333], [61, 29533], [64, 29713], [71, 30073], [73, 30193], [77, 30333], [87, 30933], [90, 31453], [102, 32193]]}, {"verse": 5, "start": 33620, "end": 37162, "text": "Y dijeron los apóstoles al Señor: Auméntanos la fe.", "words": [[0, 33620], [2, 33744], [10, 34204], [14, 34344], [24, 35004], [27, 35224], [34, 35986], [45, 36634], [48, 36814]]}, {"verse": 6, "start": 37442, "end": 49527, "text": "Entonces el Señor dijo: Si tuvieseis fe como un grano de mostaza, diréis a este sicómoro: Desarráigate, y plántate en el mar; y os obedecerá.", "words": [[0, 37442], [9, 37915], [12, 38275], [18, 38575], [24, 39416], [27, 39878], [37, 40358], [40, 40678], [45, 40998], [48, 41178], [54, 41538], [57, 41638], [66, 42738], [73, 43378], [75, 43578], [80, 44223], [90, 45573], [104, 46143], [106, 46583], [115, 47303], [118, 47483], [121, 47603], [126, 48288], [128, 48374], [131, 48461]]}, {"verse": 7, "start": 49877, "end": 57697, "text": "¿Y quién de vosotros tiene un siervo que ara o apacienta, que vuelto del campo le diga enseguida: Pasa, siéntate a la mesa?", "words": [[0, 49877], [3, 50019], [9, 50219], [12, 50379], [21, 50859], [27, 51159], [30, 51359], [37, 51859], [41, 52019], [45, 52379], [47, 52659], [58, 53499], [62, 53559], [69, 53999], [73, 54139], [79, 54779], [82, 54959], [87, 55139], [98, 56170], [104, 56654], [113, 57074], [115, 57194], [118, 57294]]}, {"verse": 8, "start": 58047, "end": 67388, "text": "¿No le dice antes: Prepárame la cena, y arremángate, y sírveme hasta que haya comido y bebido; y después de esto, come tú y bebe?", "words": [[0, 58047], [4, 58346], [7, 58466], [12, 58706], [19, 59586], [29, 60169], [32, 60309], [38, 60609], [40, 60809], [53, 61609], [55, 62009], [63, 62589], [69, 63049], [73, 63229], [78, 63409], [85, 63949], [87, 64069], [95, 64828], [97, 64934], [105, 65194], [108, 65394], [114, 66134], [119, 66354], [122, 66654], [124, 66954]]}, {"verse": 9, "start": 67738, "end": 72857, "text": "¿Da gracias al siervo porque hizo lo que le había sido mandado? Pienso que no.", "words": [[0, 67738], [4, 67961], [12, 68361], [15, 68681], [22, 69121], [29, 69421], [34, 69841], [37, 70121], [41, 70261], [44, 70401], [50, 70601], [55, 70961], [64, 71961], [71, 72327], [75, 72487]]}, {"verse": 10, "start": 73207, "end": 83020, "text": "Así también vosotros, cuando hayáis hecho todo lo que os es mandado, decid: Siervos inútiles somos, porque lo que debíamos hacer, hicimos.", "words": [[0, 73207], [4, 73437], [12, 73777], [22, 74437], [29, 74737], [36, 75297], [42, 75517], [47, 75857], [50, 76117], [54, 76277], [57, 76457], [60, 76637], [69, 77737], [76, 78845], [84, 79125], [93, 79785], [100, 80665], [107, 81005], [110, 81185], [114, 81325], [123, 81785], [130, 82245]]}, {"verse": 11, "start": 83370, "end": 89411, "text": "Y aconteció que yendo él a Jerusalén, pasaba por medio de Samaria y de Galilea.", "words": [[0, 83370], [2, 83515], [12, 84255], [16, 84495], [22, 84795], [25, 85135], [27, 85375], [38, 86655], [45, 87135], [49, 87375], [55, 87655], [58, 87875], [66, 88395], [68, 88575], [71, 88675]]}, {"verse": 12, "start": 89761, "end": 97373, "text": "Y entrando en una aldea, le vinieron al encuentro diez hombres leprosos, los cuales se pararon de lejos,", "words": [[0, 89761], [2, 89887], [11, 90367], [14, 90567], [18, 90807], [25, 91867], [28, 92087], [37, 92547], [40, 92727], [50, 93327], [55, 93507], [63, 94047], [73, 95087], [77, 95207], [84, 95607], [87, 96107], [95, 96627], [98, 96767]]}, {"verse": 13, "start": 97723, "end": 103145, "text": "Y alzaron la voz, diciendo: Jesús, Maestro, ten misericordia de nosotros.", "words": [[0, 97723], [2, 97847], [10, 98347], [13, 98507], [18, 98867], [28, 100110], [35, 100755], [44, 101595], [48, 101675], [61, 102455], [64, 102555]]}, {"verse": 14, "start": 103425, "end": 111209, "text": "Y como él los vio, les dijo: Id, mostraos a los sacerdotes. Y aconteció, que yendo ellos, fueron limpios.", "words": [[0, 103425], [2, 103547], [7, 103787], [10, 104047], [14, 104187], [19, 104447], [23, 104567], [29, 105455], [33, 105575], [42, 106715], [44, 106835], [48, 106975], [60, 108357], [62, 108457], [73, 109117], [77, 109327], [83, 109537], [90, 109857], [97, 110257]]}, {"verse": 15, "start": 111559, "end": 118377, "text": "Entonces uno de ellos, como se vio que estaba limpio, volvió, glorificando a Dios a gran voz;", "words": [[0, 111559], [9, 112083], [13, 112623], [16, 112823], [23, 113203], [28, 113503], [31, 113703], [35, 113923], [39, 114043], [46, 114263], [54, 115363], [62, 116683], [75, 117163], [77, 117303], [82, 117443], [84, 117683], [89, 117843]]}, {"verse": 16, "start": 118727, "end": 124465, "text": "Y se postró sobre el rostro a sus pies, dándole gracias: y este era samaritano.", "words": [[0, 118727], [2, 118834], [5, 118974], [12, 119434], [18, 119734], [21, 119954], [28, 120414], [30, 120514], [34, 120674], [40, 121394], [48, 121774], [57, 122817], [59, 122956], [64, 123196], [68, 123436]]}, {"verse": 17, "start": 124815, "end": 130850, "text": "Y respondiendo Jesús, dijo: ¿No son diez los que fueron limpios? ¿Y los nueve dónde están?", "words": [[0, 124815], [2, 124939], [15, 125679], [22, 126399], [28, 127103], [32, 127253], [36, 127503], [41, 127753], [45, 128053], [49, 128213], [56, 128493], [65, 129505], [68, 129613], [72, 129733], [78, 130053], [84, 130193]]}, {"verse": 18, "start": 131200, "end": 135642, "text": "¿No hubo quien volviese y diese gloria a Dios sino este extranjero?", "words": [[0, 131200], [4, 131386], [9, 131706], [15, 131886], [24, 132526], [26, 132786], [32, 133046], [39, 133566], [41, 133746], [46, 134046], [51, 134706], [56, 134766]]}, {"verse": 19, "start": 135992, "end": 139798, "text": "Y le dijo: Levántate, vete; tu fe te ha salvado.", "words": [[0, 135992], [2, 136135], [5, 136255], [11, 137048], [22, 137815], [28, 138498], [31, 138600], [34, 138800], [37, 138960], [40, 139040]]}, {"verse": 20, "start": 140148, "end": 150294, "text": "Y preguntado por los fariseos, cuándo había de venir el reino de Dios, les respondió y dijo: El reino de Dios no vendrá con advertencia;", "words": [[0, 140148], [2, 140253], [13, 140913], [17, 141153], [21, 141313], [31, 142253], [38, 142793], [44, 143253], [47, 143433], [53, 143733], [56, 143993], [62, 144353], [65, 144513], [71, 145353], [75, 145533], [85, 146493], [87, 146593], [93, 147269], [96, 147414], [102, 147794], [105, 147954], [110, 148194], [113, 148494], [120, 148974], [124, 149174]]}, {"verse": 21, "start": 150644, "end": 157559, "text": "Ni dirán: Está aquí, o está allí: porque he aquí el reino de Dios entre vosotros está.", "words": [[0, 150968], [3, 151326], [10, 151886], [15, 152250], [21, 152570], [23, 153090], [28, 153350], [34, 154057], [41, 154278], [44, 154558], [49, 154878], [52, 155038], [58, 155438], [61, 155578], [66, 155878], [72, 156338], [81, 157178]]}, {"verse": 22, "start": 157909, "end": 165209, "text": "Y dijo a sus discípulos: Tiempo vendrá, cuando desearéis ver uno de los días del Hijo del hombre, y no lo veréis.", "words": [[0, 157909], [2, 158159], [7, 158399], [9, 158559], [13, 158679], [25, 159846], [32, 160211], [40, 160631], [47, 160871], [57, 161771], [61, 162031], [65, 162391], [68, 162551], [72, 162691], [77, 162951], [81, 163211], [86, 163471], [90, 163631], [98, 164071], [100, 164231], [103, 164371], [106, 164491]]}, {"verse": 23, "start": 165559, "end": 170103, "text": "Y os dirán: Está aquí, o está allí. No vayáis, ni sigáis.", "words": [[0, 165559], [2, 165707], [5, 165807], [12, 166601], [17, 166907], [23, 167187], [25, 167587], [30, 167847], [36, 168524], [39, 168654], [47, 169114], [50, 169374]]}, {"verse": 24, "start": 170453, "end": 182027, "text": "Porque como el relámpago, relampagueando desde una parte de debajo del cielo, resplandece hasta la otra debajo del cielo, así también será el Hijo del hombre en su día.", "words": [[0, 170453], [7, 170697], [12, 171077], [15, 171297], [26, 172657], [41, 173797], [47, 174057], [51, 174297], [57, 174677], [60, 174877], [67, 175277], [71, 175517], [78, 176492], [90, 177132], [96, 177352], [99, 177532], [104, 177732], [111, 178172], [115, 178372], [122, 178972], [126, 179152], [134, 179572], [139, 179932], [142, 180252], [147, 180512], [151, 180712], [158, 181032], [161, 181372], [164, 181532]]}, {"verse": 25, "start": 182377, "end": 188242, "text": "Pero primero es necesario que padezca mucho, y sea rechazado por esta generación.", "words": [[0, 182377], [5, 182539], [13, 182939], [16, 183159], [26, 183819], [30, 184139], [38, 184719], [45, 185079], [47, 185374], [51, 185734], [61, 186814], [65, 187074], [70, 187254]]}, {"verse": 26, "start": 188592, "end": 194089, "text": "Y como fue en los días de Noé, así también será en los días del Hijo del hombre.", "words": [[0, 188592], [2, 188849], [7, 189089], [11, 189389], [14, 189629], [18, 189769], [23, 190009], [26, 190189], [31, 190909], [35, 191109], [43, 191629], [48, 192069], [51, 192469], [55, 192629], [60, 192869], [64, 193129], [69, 193349], [73, 193549]]}, {"verse": 27, "start": 194439, "end": 204785, "text": "Comían, bebían, se casaban y se daban en casamiento, hasta el día que entró Noé en el arca; y vino el diluvio, y destruyó a todos.", "words": [[0, 194439], [8, 195003], [16, 195863], [19, 195963], [27, 196663], [29, 196868], [32, 196988], [38, 197288], [41, 197428], [53, 198608], [59, 198988], [62, 199148], [66, 199328], [70, 199508], [76, 199988], [80, 200468], [83, 200708], [86, 200848], [92, 201671], [94, 201777], [99, 201997], [102, 202157], [111, 202837], [113, 203217], [122, 203937], [124, 204137]]}, {"verse": 28, "start": 205135, "end": 213075, "text": "Asimismo también como fue en los días de Lot; comían, bebían, compraban, vendían, plantaban, edificaban;", "words": [[0, 205135], [9, 205818], [17, 206178], [22, 206618], [26, 206958], [29, 207138], [33, 207278], [38, 207597], [41, 207916], [46, 208410], [54, 209054], [62, 209674], [73, 210514], [82, 211174], [93, 212154]]}, {"verse": 29, "start": 213425, "end": 219877, "text": "Pero el día que Lot salió de Sodoma, llovió del cielo fuego y azufre, y destruyó a todos:", "words": [[0, 213425], [5, 213569], [8, 213729], [12, 213929], [16, 214129], [20, 214349], [26, 214909], [29, 215049], [37, 216149], [44, 216529], [48, 216669], [54, 216989], [60, 217449], [62, 217829], [70, 218209], [72, 218589], [81, 219189], [83, 219309]]}, {"verse": 30, "start": 220227, "end": 223880, "text": "Como esto será el día en que el Hijo del hombre se manifestará.", "words": [[0, 220227], [5, 220411], [10, 220671], [15, 221051], [18, 221291], [22, 221531], [25, 221751], [29, 221891], [32, 222051], [37, 222311], [41, 222471], [48, 222731], [51, 222931]]}, {"verse": 31, "start": 224230, "end": 234342, "text": "En aquel día, el que esté en la azotea, y sus bienes en casa, no descienda a tomarlos: y el que en el campo, asimismo no vuelva atrás.", "words": [[0, 224230], [3, 224370], [9, 224730], [14, 224970], [17, 225290], [21, 225490], [26, 225810], [29, 226170], [32, 226350], [40, 227130], [42, 227270], [46, 227450], [53, 227810], [56, 227950], [62, 228270], [65, 228890], [75, 229490], [77, 229690], [87, 230756], [89, 230920], [92, 231100], [96, 231280], [99, 231580], [102, 231740], [109, 232320], [118, 233195], [121, 233335], [128, 233715]]}, {"verse": 32, "start": 234692, "end": 236998, "text": "Acordaos de la mujer de Lot.", "words": [[0, 235092], [9, 235492], [12, 235712], [15, 235812], [21, 236142], [24, 236472]]}, {"verse": 33, "start": 237348, "end": 242822, "text": "Todo el que procure salvar su vida, la perderá; y todo el que la pierda, la salvará.", "words": [[0, 237348], [5, 237522], [8, 237732], [12, 237832], [20, 238252], [27, 238692], [30, 239012], [36, 239292], [39, 239452], [48, 240413], [50, 240556], [55, 240756], [58, 240976], [62, 241116], [65, 241256], [73, 241856], [76, 242156]]}, {"verse": 34, "start": 243172, "end": 249233, "text": "Os digo que en aquella noche estarán dos en una cama; el uno será tomado, y el otro será dejado.", "words": [[0, 243172], [3, 243279], [8, 243539], [12, 243799], [15, 243959], [23, 244319], [29, 244499], [37, 245039], [41, 245199], [44, 245419], [48, 245619], [54, 246343], [57, 246488], [61, 246708], [66, 246928], [74, 247568], [76, 247828], [79, 247988], [84, 248228], [89, 248528]]}, {"verse": 35, "start": 249583, "end": 255208, "text": "Dos mujeres estarán moliendo juntas: la una será tomada, y la otra dejada.", "words": [[0, 249583], [4, 249773], [12, 250213], [20, 250933], [29, 251433], [37, 252505], [40, 252655], [44, 252855], [49, 253095], [57, 253675], [59, 254115], [62, 254255], [67, 254762]]}, {"verse": 36, "start": 255558, "end": 260660, "text": "Dos estarán en el campo; el uno será tomado, y el otro dejado.", "words": [[0, 255558], [4, 255864], [12, 256584], [15, 256784], [18, 256904], [25, 257800], [28, 257948], [32, 258168], [37, 258388], [45, 259108], [47, 259508], [50, 259648], [55, 259868]]}, {"verse": 37, "start": 261010, "end": 269664, "text": "Y respondiendo, le dicen: ¿Dónde, Señor? Y él les dijo: Donde esté el cuerpo, allá se juntarán también las águilas.", "words": [[0, 261010], [2, 261346], [16, 261712], [19, 262079], [26, 263024], [34, 263364], [41, 264139], [43, 264321], [46, 264461], [50, 264601], [56, 265394], [62, 265641], [67, 265981], [70, 266261], [78, 267181], [83, 267401], [86, 267641], [95, 268301], [103, 268601], [107, 268881]]}]}