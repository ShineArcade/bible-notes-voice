{"book": "GEN", "chapter": 28, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 197953, "verses": [{"verse": 1, "start": 300, "end": 8205, "text": "Entonces Isaac llamó a Jacob, y lo bendijo, y le mandó diciendo: No tomes mujer de las hijas de Canaán.", "words": [[0, 300], [9, 804], [15, 1424], [21, 2364], [23, 2424], [30, 2824], [32, 3099], [35, 3239], [44, 3859], [46, 4339], [49, 4479], [55, 4919], [65, 5952], [68, 6096], [74, 6476], [80, 6736], [83, 6936], [87, 7116], [93, 7476], [96, 7596]]}, {"verse": 2, "start": 8555, "end": 15944, "text": "Levántate, ve a Padan-aram, a casa de Betuel, padre de tu madre, y toma allí mujer de las hijas de Labán, hermano de tu madre.", "words": [[0, 8555], [11, 9154], [14, 9354], [16, 9874], [28, 10394], [30, 10474], [35, 10674], [38, 10854], [46, 11434], [52, 11634], [55, 11834], [58, 11934], [65, 12654], [67, 12734], [72, 12954], [77, 13234], [83, 13514], [86, 13714], [90, 13874], [96, 14214], [99, 14334], [106, 14874], [114, 15254], [117, 15334], [120, 15454]]}, {"verse": 3, "start": 16294, "end": 23681, "text": "Y el Dios omnipotente te bendiga, y te haga fructificar, y te multiplique, hasta venir a ser congregación de pueblos;", "words": [[0, 16294], [2, 16413], [5, 16553], [10, 16773], [22, 17593], [25, 17813], [34, 18393], [36, 18813], [39, 18933], [44, 19153], [57, 19873], [59, 20293], [62, 20413], [75, 21193], [81, 21633], [87, 21893], [89, 22073], [93, 22233], [106, 22913], [109, 23073]]}, {"verse": 4, "start": 24031, "end": 31010, "text": "Y te dé la bendición de Abraham, y a tu descendencia contigo, para que heredes la tierra en que moras, que Dios dio a Abraham.", "words": [[0, 24031], [2, 24137], [5, 24237], [8, 24377], [11, 24497], [21, 25057], [24, 25237], [33, 25677], [35, 25882], [37, 25962], [40, 26062], [53, 26782], [62, 27422], [67, 27822], [71, 28002], [79, 28342], [82, 28462], [89, 28762], [92, 28942], [96, 29022], [103, 29682], [107, 29802], [112, 29962], [116, 30122], [118, 30282]]}, {"verse": 5, "start": 31290, "end": 41204, "text": "Así envió Isaac a Jacob, el cual fue a Padan-aram, a Labán, hijo de Betuel arameo, hermano de Rebeca, madre de Jacob y de Esaú.", "words": [[0, 31290], [4, 31633], [10, 32093], [16, 32373], [18, 32713], [25, 33713], [28, 33833], [33, 34033], [37, 34373], [39, 34889], [51, 35405], [53, 35922], [60, 36438], [65, 36638], [68, 36818], [75, 37138], [83, 38198], [91, 38738], [94, 38818], [102, 39438], [108, 39658], [111, 39858], [117, 40238], [119, 40518], [122, 40894]]}, {"verse": 6, "start": 41554, "end": 56580, "text": "Y vio Esaú cómo Isaac había bendecido a Jacob, y le había enviado a Padan-aram, para tomar para sí mujer de allí; y que cuando le bendijo, le había mandado, diciendo: No tomarás mujer de las hijas de Canaán;", "words": [[0, 41554], [2, 41704], [6, 42134], [11, 42564], [16, 42604], [22, 43024], [28, 43484], [38, 44164], [40, 44284], [47, 44624], [49, 44949], [52, 45089], [58, 45269], [66, 45669], [68, 46219], [80, 46769], [85, 47469], [91, 47809], [96, 48089], [99, 48309], [105, 48569], [108, 48849], [114, 49524], [116, 49721], [120, 49861], [127, 50121], [130, 50361], [139, 51081], [142, 51356], [148, 51576], [157, 52356], [167, 54052], [170, 54326], [178, 54636], [184, 54956], [187, 55216], [191, 55396], [197, 55776], [200, 55876]]}, {"verse": 7, "start": 56930, "end": 62791, "text": "Y que Jacob había obedecido a su padre y a su madre, y se había ido a Padan-aram.", "words": [[0, 56930], [2, 57036], [6, 57136], [12, 57596], [18, 58021], [28, 58941], [30, 59061], [33, 59181], [39, 59581], [41, 59781], [43, 59821], [46, 59981], [53, 60381], [55, 60881], [58, 61061], [64, 61341], [68, 61741], [70, 62266]]}, {"verse": 8, "start": 63141, "end": 69060, "text": "vio asimismo Esaú que las hijas de Canaán parecían mal a Isaac su padre;", "words": [[0, 63141], [4, 63540], [13, 63974], [18, 64407], [22, 64587], [26, 64807], [32, 65327], [35, 65737], [42, 66147], [51, 66882], [55, 67322], [57, 6