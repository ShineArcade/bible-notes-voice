{"book": "ROM", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 146251, "verses": [{"verse": 1, "start": 300, "end": 6361, "text": "Hermanos, ciertamente la voluntad de mi corazón y mi oración a Dios sobre Israel, es para salvación.", "words": [[0, 518], [10, 778], [22, 1418], [25, 1558], [34, 2078], [37, 2198], [40, 2278], [48, 2718], [50, 2978], [53, 3078], [61, 3578], [63, 3778], [68, 3958], [74, 4298], [82, 4758], [85, 5338], [90, 5558]]}, {"verse": 2, "start": 6711, "end": 11881, "text": "Porque yo les doy testimonio que tienen celo de Dios, pero no conforme al conocimiento.", "words": [[0, 6711], [7, 6911], [10, 7091], [14, 7231], [18, 7471], [29, 8071], [33, 8171], [40, 8471], [45, 8951], [48, 9051], [54, 9851], [59, 10091], [62, 10291], [71, 10871], [74, 10951]]}, {"verse": 3, "start": 12231, "end": 19738, "text": "Porque ignorando la justicia de Dios, y procurando establecer la suya propia, no se han sujetado a la justicia de Dios.", "words": [[0, 12231], [7, 12471], [17, 13091], [20, 13231], [29, 13811], [32, 13951], [38, 14231], [40, 14851], [51, 15391], [62, 16011], [65, 16171], [70, 16491], [78, 16811], [81, 17431], [84, 17611], [88, 17771], [97, 18391], [99, 18471], [102, 18551], [111, 19051], [114, 19191]]}, {"verse": 4, "start": 20088, "end": 24099, "text": "Porque el fin de la ley es Cristo, para justicia a todo aquel que cree.", "words": [[0, 20088], [7, 20316], [10, 20456], [14, 20636], [17, 20776], [20, 20876], [24, 21096], [27, 21416], [35, 21736], [40, 22096], [49, 22776], [51, 22996], [56, 23156], [62, 23516], [66, 23616]]}, {"verse": 5, "start": 24449, "end": 30276, "text": "Porque Moisés describe la justicia que es por la ley: Que el hombre que haga estas cosas, vivirá por ellas.", "words": [[0, 24449], [7, 24653], [14, 25033], [23, 25573], [26, 25753], [35, 26313], [39, 26473], [42, 26633], [46, 26793], [49, 26953], [54, 27522], [58, 27618], [61, 27738], [68, 27938], [72, 28178], [77, 28378], [83, 28618], [90, 29058], [97, 29598], [101, 29758]]}, {"verse": 6, "start": 30626, "end": 38212, "text": "Pero la justicia que es por la fe dice así: No digas en tu corazón: ¿Quién subirá al cielo? (esto es, para traer abajo a Cristo:)", "words": [[0, 30626], [5, 30752], [8, 30872], [17, 31452], [21, 31612], [24, 31752], [28, 31892], [31, 32052], [34, 32252], [39, 32472], [44, 33192], [47, 33329], [53, 33669], [56, 33789], [59, 33869], [68, 34747], [75, 34947], [82, 35347], [85, 35427], [92, 36109], [98, 36392], [102, 36552], [107, 36772], [113, 37152], [119, 37412], [121, 37632]]}, {"verse": 7, "start": 38562, "end": 43316, "text": "O, ¿quién descenderá al abismo? (esto es, para volver a traer a Cristo de los muertos.)", "words": [[0, 38562], [3, 38727], [10, 39027], [21, 39687], [24, 39807], [32, 40587], [38, 40867], [42, 41047], [47, 41247], [54, 41527], [56, 41707], [62, 42007], [64, 42107], [71, 42347], [74, 42547], [78, 42647]]}, {"verse": 8, "start": 43666, "end": 51085, "text": "Pero ¿qué dice? Cercana está la palabra, en tu boca y en tu corazón. Esta es la palabra de fe, la cual predicamos:", "words": [[0, 43666], [5, 43809], [10, 43969], [16, 44849], [24, 45344], [29, 45584], [32, 45724], [41, 46144], [44, 46384], [47, 46524], [52, 46864], [54, 47064], [57, 47144], [60, 47284], [69, 48226], [74, 48511], [77, 48691], [80, 48811], [88, 49151], [91, 49351], [95, 49871], [98, 50031], [103, 50231]]}, {"verse": 9, "start": 51435, "end": 59130, "text": "Que si confiesas con tu boca que Jesús es el Señor, y creyeres en tu corazón que Dios le levantó de los muertos, serás salvo.", "words": [[0, 51435], [4, 51594], [7, 51734], [17, 52394], [21, 52574], [24, 52734], [29, 53034], [33, 53234], [39, 53534], [42, 53754], [45, 53894], [52, 54334], [54, 54774], [63, 55254], [66, 55454], [69, 55554], [77, 56014], [81, 56274], [86, 56514], [89, 56734], [97, 57214], [100, 57314], [104, 57434], [113, 57984], [119, 58534]]}, {"verse": 10, "start": 59480, "end": 64672, "text": "Porque con el corazón se cree para justicia; pero con la boca se hace confesión para salvación.", "words": [[0, 59480], [7, 59681], [11, 59881], [14, 59981], [22, 60421], [25, 60641], [30, 60881], [35, 61101], [45, 62122], [50, 62259], [54, 62459], [57, 62579], [62, 62819], [65, 63039], [70, 63179], [80, 63739], [85, 63939]]}, {"verse": 11, "start": 65022, "end": 69507, "text": "Porque la Escritura dice: Todo aquel que en él cree, no será avergonzado.", "words": [[0, 65022], [7, 65203], [10, 65363], [20, 65863], [26, 66603], [31, 66747], [37, 67147], [41, 67247], [44, 67387], [47, 67507], [53, 67807], [56, 68367], [61, 68967]]}, {"verse": 12, "start": 69857, "end": 77105, "text": "Porque no hay diferencia de judío y de griego: porque el mismo que es Señor de todos, rico es para con todos los que le invocan:", "words": [[0, 69857], [7, 70034], [10, 70254], [14, 70394], [25, 70834], [28, 71094], [34, 71514], [36, 71634], [39, 71754], [47, 72544], [54, 72723], [57, 72863], [63, 73123], [67, 73363], [70, 73563], [76, 73803], [79, 74023], [86, 74683], [91, 75083], [94, 75323], [99, 75543], [103, 75743], [109, 76023], [113, 76183], [117, 76383], [120, 76483]]}, {"verse": 13, "start": 77455, "end": 80639, "text": "Porque todo aquel que invoque el nombre del Señor, será salvo.", "words": [[0, 77455], [7, 77635], [12, 77895], [18, 78275], [22, 78375], [30, 78775], [33, 78915], [40, 79175], [44, 79355], [51, 79715], [56, 80055]]}, {"verse": 14, "start": 80989, "end": 89735, "text": "¿Cómo, pues invocarán a aquel en el cual no han creído? ¿y cómo creerán a aquel de quien no han oído? ¿y cómo oirán sin haber quien les predique?", "words": [[0, 80989], [7, 81193], [12, 81533], [22, 82393], [24, 82473], [30, 82893], [33, 83033], [36, 83173], [41, 83373], [44, 83633], [48, 83773], [56, 84622], [59, 84727], [64, 84987], [72, 85587], [74, 85707], [80, 86007], [83, 86127], [89, 86327], [92, 86587], [96, 86707], [102, 87418], [105, 87518], [110, 87778], [116, 88218], [120, 88378], [126, 88598], [132, 88858], [136, 89078]]}, {"verse": 15, "start": 90085, "end": 99687, "text": "¿Y cómo predicarán si no son enviados? Como está escrito: ¡Cuán hermosos son los pies de los que anuncian el evangelio de la paz, de los que anuncian el evangelio de los bienes!", "words": [[0, 90085], [3, 90169], [8, 90369], [19, 91049], [22, 91209], [25, 91329], [29, 91529], [39, 92493], [44, 92672], [49, 92872], [58, 93676], [64, 93858], [73, 94378], [77, 94538], [81, 94698], [86, 94978], [89, 95198], [93, 95338], [97, 95498], [106, 95938], [109, 96038], [119, 96558], [122, 96638], [125, 96758], [130, 97218], [133, 97518], [137, 97658], [141, 97778], [150, 98218], [153, 98298], [163, 98838], [166, 98898], [170, 99038]]}, {"verse": 16, "start": 100037, "end": 106202, "text": "Pero no todos obedecen al evangelio; pues Isaías dice: Señor, ¿quién ha creído a nuestro anuncio?", "words": [[0, 100037], [5, 100178], [8, 100338], [14, 100598], [23, 101218], [26, 101378], [37, 102281], [42, 102444], [49, 103024], [55, 103845], [62, 104722], [69, 104822], [72, 104962], [79, 105242], [81, 105342], [89, 105482]]}, {"verse": 17, "start": 106552, "end": 110120, "text": "Luego la fe es por el oír; y el oír por la palabra de Dios.", "words": [[0, 106552], [6, 106770], [9, 106950], [12, 107190], [15, 107470], [19, 107670], [22, 107790], [27, 108426], [29, 108547], [32, 108627], [36, 108847], [40, 109007], [43, 109127], [51, 109447], [54, 109627]]}, {"verse": 18, "start": 110470, "end": 118397, "text": "Pero digo: ¿No han oído? Antes bien, por toda la tierra ha salido la fama de ellos, y hasta los confines del mundo las palabras de ellos.", "words": [[0, 110470], [5, 110608], [11, 111276], [15, 111433], [19, 111553], [25, 112231], [31, 112518], [37, 112798], [41, 113078], [46, 113298], [49, 113498], [56, 113858], [59, 114158], [66, 114538], [69, 114658], [74, 114978], [77, 115098], [84, 115378], [86, 115623], [92, 115803], [96, 116003], [105, 116483], [109, 116683], [115, 116943], [119, 117223], [128, 117623], [131, 117883]]}, {"verse": 19, "start": 118747, "end": 131797, "text": "Pero digo: ¿No ha conocido esto Israel? Primeramente Moisés dice: Yo os provocaré a celos con gente que no es mía; con gente insensata os provocaré a ira.", "words": [[0, 118747], [5, 118889], [11, 119554], [15, 119913], [18, 120033], [27, 120613], [32, 120913], [40, 121685], [53, 122328], [60, 122708], [66, 123618], [69, 123921], [72, 124201], [82, 124728], [84, 125254], [90, 125781], [94, 126081], [100, 126461], [104, 126741], [107, 126921], [110, 127101], [115, 128037], [119, 128194], [125, 128494], [135, 129214], [138, 129474], [148, 130114], [150, 130254]]}, {"verse": 20, "start": 132017, "end": 139489, "text": "E Isaías con osadía dice: fui hallado de los que no me buscaban; me manifesté a los que no preguntaban por mí.", "words": [[0, 132017], [2, 132142], [9, 132549], [13, 132955], [20, 133362], [26, 134043], [30, 134202], [38, 134682], [41, 134822], [45, 134962], [49, 135142], [52, 135282], [55, 135402], [65, 136672], [68, 136756], [78, 137436], [80, 137636], [84, 137776], [88, 137916], [91, 138036], [103, 138676], [107, 138916]]}, {"verse": 21, "start": 139709, "end": 145851, "text": "Pero acerca de Israel dice: Todo el día extendí mis manos a un pueblo rebelde y contradictor.", "words": [[0, 139709], [5, 139851], [12, 140171], [15, 140431], [22, 140751], [28, 141574], [33, 141714], [36, 141934], [40, 142154], [48, 142754], [52, 142854], [58, 143194], [60, 143514], [63, 143634], [70, 143914], [78, 144594], [80, 144754]]}]}