{"book": "PSA", "chapter": 91, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 99349, "verses": [{"verse": 1, "start": 300, "end": 6162, "text": "El que habita al abrigo del Altísimo, morará bajo la sombra del Omnipotente.", "words": [[0, 300], [3, 466], [7, 626], [14, 1086], [17, 1226], [24, 1646], [28, 1746], [38, 2426], [45, 3406], [50, 3806], [53, 4026], [60, 4526], [64, 4746]]}, {"verse": 2, "start": 6612, "end": 13001, "text": "Diré yo a Jehová: Esperanza mía, y castillo mío; mi Dios, en él confiaré.", "words": [[0, 6612], [5, 7152], [8, 7352], [10, 7532], [18, 9666], [28, 9666], [33, 9666], [35, 9919], [44, 10209], [49, 11902], [52, 11902], [58, 11902], [61, 12083], [64, 12273]]}, {"verse": 3, "start": 13451, "end": 18608, "text": "Y él te librará del lazo del cazador: de la peste destruidora.", "words": [[0, 13451], [2, 13614], [5, 13754], [8, 13894], [16, 14434], [20, 14614], [25, 15114], [29, 15294], [38, 16397], [41, 16540], [44, 16660], [50, 17180]]}, {"verse": 4, "start": 19058, "end": 26004, "text": "Con sus plumas te cubrirá, y debajo de sus alas estarás seguro: escudo y defensa es su verdad.", "words": [[0, 19058], [4, 19352], [8, 19592], [15, 20152], [18, 20292], [27, 20952], [29, 21332], [36, 21732], [39, 21892], [43, 22072], [48, 22512], [56, 22992], [64, 23926], [71, 24526], [73, 24626], [81, 25146], [84, 25326], [87, 25486]]}, {"verse": 5, "start": 26454, "end": 31562, "text": "No tendrás temor de espanto nocturno, ni de flecha que vuele de día;", "words": [[0, 26454], [3, 26603], [11, 27063], [17, 27503], [20, 27663], [28, 28223], [38, 29503], [41, 29763], [44, 29903], [51, 30343], [55, 30603], [61, 30863], [64, 31023]]}, {"verse": 6, "start": 32012, "end": 38247, "text": "Ni de pestilencia que ande en oscuridad, ni de mortandad que en medio del día destruya.", "words": [[0, 32012], [3, 32140], [6, 32280], [18, 33060], [22, 33320], [27, 33640], [30, 33800], [41, 34880], [44, 35080], [47, 35220], [57, 36020], [61, 36260], [64, 36400], [70, 36700], [74, 37000], [78, 37300]]}, {"verse": 7, "start": 38697, "end": 44051, "text": "Caerán a tu lado mil, y diez mil a tu diestra: mas a ti no llegará.", "words": [[0, 38697], [7, 39181], [9, 39301], [12, 39401], [17, 39681], [22, 39961], [24, 40581], [29, 40841], [33, 41261], [35, 41441], [38, 41581], [47, 42775], [51, 42903], [53, 43031], [56, 43159], [59, 43287]]}, {"verse": 8, "start": 44501, "end": 50273, "text": "Ciertamente con tus ojos mirarás, y verás la recompensa de los impíos.", "words": [[0, 44501], [12, 45306], [16, 45546], [20, 45766], [25, 46086], [34, 46966], [36, 47386], [42, 47846], [45, 48166], [56, 49086], [59, 49226], [63, 49346]]}, {"verse": 9, "start": 50723, "end": 55707, "text": "Porque tú has puesto a Jehová, que es mi esperanza, al Altísimo por tu habitación,", "words": [[0, 50723], [7, 50945], [10, 51185], [14, 51365], [21, 51565], [23, 51845], [31, 52325], [35, 52385], [38, 52525], [41, 52645], [52, 53665], [55, 53865], [64, 54505], [68, 54785], [71, 54945]]}, {"verse": 10, "start": 56157, "end": 59543, "text": "No te sobrevendrá mal, ni plaga tocará tu morada.", "words": [[0, 56157], [3, 56284], [6, 56404], [18, 57124], [23, 57444], [26, 57844], [32, 58304], [39, 58784], [42, 58884]]}, {"verse": 11, "start": 59993, "end": 65860, "text": "Pues que a sus ángeles mandará acerca de ti, que te guarden en todos tus caminos.", "words": [[0, 59993], [5, 60237], [9, 60597], [11, 60737], [15, 60857], [23, 61477], [31, 62237], [38, 62637], [41, 62977], [45, 63517], [49, 64077], [52, 64237], [60, 64817], [63, 64937], [69, 65317], [73, 65589]]}, {"verse": 12, "start": 66310, "end": 70913, "text": "En las manos te llevarán, porque tu pie no tropiece en piedra.", "words": [[0, 67257], [3, 67437], [7, 67577], [13, 67917], [16, 68137], [26, 68657], [33, 68917], [36, 69157], [40, 69397], [43, 69597], [52, 70117], [55, 70297]]}, {"verse": 13, "start": 71363, "end": 77960, "text": "Sobre el león y el áspid pisarás; hollarás al cachorro del león y al dragón.", "words": [[0, 71363], [6, 71749], [9, 72089], [14, 72529], [16, 72999], [19, 73468], [25, 73938], [34, 74916], [43, 75236], [46, 75396], [55, 75976], [59, 76196], [64, 76776], [66, 77036], [69, 77216]]}, {"verse": 14, "start": 78260, "end": 86313, "text": "Por cuanto en mí ha puesto su voluntad, yo también lo libraré: lo pondré en alto, por cuanto ha conocido mi nombre.", "words": [[0, 78260], [4, 78424], [11, 78724], [14, 78964], [17, 79204], [20, 79404], [27, 79684], [30, 79924], [40, 81064], [43, 81184], [51, 81544], [54, 81744], [63, 82932], [66, 83037], [73, 83437], [76, 83557], [82, 84137], [86, 84397], [93, 84657], [96, 84857], [105, 85337], [108, 85477]]}, {"verse": 15, "start": 86763, "end": 94453, "text": "Me invocará, y yo le responderé: con él estaré yo en la angustia: lo libraré, y le glorificaré.", "words": [[0, 86763], [3, 86866], [13, 87426], [15, 87746], [18, 87886], [21, 88006], [33, 89358], [37, 89522], [40, 89702], [47, 90142], [50, 90322], [53, 90582], [56, 90722], [66, 92042], [69, 92140], [78, 92660], [80, 93140], [83, 93280]]}, {"verse": 16, "start": 94903, "end": 98949, "text": "Lo saciaré de larga vida, y mostraréle mi salvación.", "words": [[0, 95102], [3, 95342], [11, 95582], [14, 95722], [20, 96082], [26, 96362], [28, 96882], [39, 97602], [42, 97862]]}]}