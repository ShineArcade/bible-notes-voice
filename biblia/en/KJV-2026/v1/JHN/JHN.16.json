{"book": "JHN", "chapter": 16, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 233418, "verses": [{"verse": 1, "start": 300, "end": 3847, "text": "These things have I spoken to you, that you should not be offended.", "words": [[0, 300], [6, 454], [13, 834], [18, 1054], [20, 1194], [27, 1494], [30, 1794], [35, 2354], [40, 2574], [44, 2714], [51, 2854], [55, 3074], [58, 3274]]}, {"verse": 2, "start": 4197, "end": 10720, "text": "They shall put you out of the synagogues: yes, the time comes, that whoever kills you will think that he does God service.", "words": [[0, 4197], [5, 4281], [11, 4441], [15, 4661], [19, 4821], [23, 5041], [26, 5141], [30, 5281], [42, 6283], [47, 6707], [51, 6767], [56, 7007], [63, 7447], [68, 7752], [76, 8012], [82, 8412], [86, 8672], [91, 8852], [97, 9132], [102, 9332], [105, 9492], [110, 9822], [114, 10152]]}, {"verse": 3, "start": 11070, "end": 15460, "text": "And these things will they do to you, because they have not known the Father, nor me.", "words": [[0, 11070], [4, 11214], [10, 11454], [17, 11814], [22, 12034], [27, 12194], [30, 12394], [33, 12574], [38, 12994], [46, 13314], [51, 13594], [56, 13774], [60, 13974], [66, 14174], [70, 14354], [78, 14914], [82, 15074]]}, {"verse": 4, "start": 15810, "end": 25812, "text": "But these things have I told you, that when the time shall come, you may remember that I told you of them. And these things I said not to you at the beginning, because I was with you.", "words": [[0, 15810], [4, 15909], [10, 16129], [17, 16469], [22, 16669], [24, 16809], [29, 17049], [34, 17899], [39, 18109], [44, 18289], [48, 18429], [53, 18709], [59, 18909], [65, 19589], [69, 19769], [73, 19929], [82, 20309], [87, 20609], [89, 20729], [94, 20949], [98, 21169], [101, 21329], [107, 21779], [111, 21925], [117, 22165], [124, 22465], [126, 22645], [131, 22925], [135, 23145], [138, 23365], [142, 23565], [145, 23745], [149, 23845], [160, 24545], [168, 24865], [170, 25105], [174, 25245], [179, 25445]]}, {"verse": 5, "start": 26162, "end": 31521, "text": "But now I go my way to him that sent me; and none of you asks me, Where are you going?", "words": [[0, 26162], [4, 26302], [8, 26622], [10, 26982], [13, 27162], [16, 27342], [20, 27522], [23, 27682], [27, 27882], [32, 28082], [37, 28322], [41, 28878], [45, 29021], [50, 29241], [53, 29401], [57, 29541], [62, 29821], [66, 30441], [72, 30701], [76, 30861], [80, 30981]]}, {"verse": 6, "start": 31871, "end": 36043, "text": "But because I have said these things to you, sorrow has filled your heart.", "words": [[0, 31871], [4, 32071], [12, 32371], [14, 32651], [19, 32771], [24, 32991], [30, 33271], [37, 33631], [40, 33871], [45, 34411], [52, 34791], [56, 35111], [63, 35351], [68, 35591]]}, {"verse": 7, "start": 36393, "end": 46073, "text": "Nevertheless I tell you the truth; It is expedient for you that I go away: for if I go not away, the Comforter will not come to you; but if I depart, I will send him to you.", "words": [[0, 36393], [13, 37110], [15, 37290], [20, 37510], [24, 37670], [28, 37810], [35, 38450], [38, 38550], [41, 38690], [51, 39310], [55, 39510], [59, 39690], [64, 39890], [66, 40010], [69, 40210], [75, 40903], [79, 41011], [82, 41171], [84, 41271], [87, 41471], [91, 41631], [97, 42251], [101, 42351], [111, 42751], [116, 42891], [120, 43071], [125, 43291], [128, 43471], [133, 43942], [137, 44024], [140, 44144], [142, 44244], [150, 44964], [152, 45044], [157, 45164], [162, 45444], [166, 45644], [169, 45824]]}, {"verse": 8, "start": 46423, "end": 52281, "text": "And when he is come, he will reprove the world of sin, and of righteousness, and of judgment:", "words": [[0, 46423], [4, 46566], [9, 46746], [12, 46946], [15, 47086], [21, 47866], [24, 47966], [29, 48146], [37, 48766], [41, 48906], [47, 49186], [50, 49386], [55, 49746], [59, 50366], [62, 50486], [77, 50966], [81, 51486], [84, 51606]]}, {"verse": 9, "start": 52631, "end": 55320, "text": "Of sin, because they believe not on me;", "words": [[0, 52631], [3, 52790], [8, 53150], [16, 53610], [21, 53910], [29, 54310], [33, 54630], [36, 54870]]}, {"verse": 10, "start": 55670, "end": 59068, "text": "Of righteousness, because I go to my Father, and you see me no more;", "words": [[0, 55670], [3, 55816], [18, 56316], [26, 56636], [28, 56796], [31, 56976], [34, 57056], [37, 57216], [45, 57576], [49, 58056], [53, 58176], [57, 58336], [60, 58476], [63, 58656]]}, {"verse": 11, "start": 59418, "end": 62325, "text": "Of judgment, because the prince of this world is judged.", "words": [[0, 59418], [3, 59598], [13, 59978], [21, 60458], [25, 60638], [32, 60878], [35, 61018], [40, 61198], [46, 61518], [49, 61718]]}, {"verse": 12, "start": 62675, "end": 66331, "text": "I have yet many things to say to you, but you cannot bear them now.", "words": [[0, 62675], [2, 62833], [7, 62993], [11, 63133], [16, 63393], [23, 63773], [26, 64013], [30, 64213], [33, 64393], [38, 64793], [42, 64933], [46, 65073], [53, 65373], [58, 65673], [63, 65873]]}, {"verse": 13, "start": 66681, "end": 77913, "text": "However when he, the Spirit of truth, is come, he will guide you into all truth: for he shall not speak of himself; but whatever he shall hear, that shall he speak: and he will show you things to come.", "words": [[0, 66681], [8, 67149], [13, 67249], [17, 67389], [21, 67529], [28, 67869], [31, 68029], [38, 68349], [41, 68629], [47, 69329], [50, 69409], [55, 69549], [61, 69809], [65, 70029], [70, 70229], [74, 70509], [81, 71232], [85, 71375], [88, 71615], [94, 71815], [98, 72035], [104, 72335], [107, 72515], [116, 73384], [120, 73484], [129, 73784], [132, 73984], [138, 74204], [144, 74804], [149, 75064], [155, 75324], [158, 75484], [165, 76222], [169, 76344], [172, 76484], [177, 76624], [182, 76864], [186, 77024], [193, 77264], [196, 77484]]}, {"verse": 14, "start": 78263, "end": 82705, "text": "He shall glorify me: for he shall receive of mine, and shall show it to you.", "words": [[0, 78263], [3, 78374], [9, 78554], [17, 79074], [21, 79695], [25, 79806], [28, 79986], [34, 80206], [42, 80586], [45, 80786], [51, 81146], [55, 81586], [61, 81826], [66, 82086], [69, 82226], [72, 82386]]}, {"verse": 15, "start": 83055, "end": 89344, "text": "All things that the Father has are mine: therefore said I, that he shall take of mine, and shall show it to you.", "words": [[0, 83055], [4, 83295], [11, 83615], [16, 83855], [20, 83975], [27, 84215], [31, 84615], [35, 84935], [41, 85555], [51, 85879], [56, 86239], [59, 86499], [64, 86759], [67, 86899], [73, 87059], [78, 87299], [81, 87439], [87, 87959], [91, 88319], [97, 88499], [102, 88759], [105, 88879], [108, 89039]]}, {"verse": 16, "start": 89694, "end": 96184, "text": "A little while, and you shall not see me: and again, a little while, and you shall see me, because I go to the Father.", "words": [[0, 89694], [2, 89793], [9, 89953], [16, 90293], [20, 90733], [24, 90893], [30, 91093], [34, 91273], [38, 91513], [42, 91883], [46, 92046], [53, 92266], [55, 92486], [62, 92646], [69, 93466], [73, 93666], [77, 93826], [83, 94026], [87, 94306], [91, 94726], [99, 95026], [101, 95186], [104, 95366], [107, 95506], [111, 95646]]}, {"verse": 17, "start": 96464, "end": 107477, "text": "Then said some of his disciples among themselves, What is this that he says to us, A little while, and you shall not see me: and again, a little while, and you shall see me: and, Because I go to the Father?", "words": [[0, 96464], [5, 96674], [10, 96974], [15, 97194], [18, 97354], [22, 97474], [32, 97974], [38, 98274], [50, 99314], [55, 99451], [58, 99611], [63, 99911], [68, 100091], [71, 100211], [76, 100431], [79, 100651], [83, 100871], [85, 101071], [92, 101251], [99, 101591], [103, 102031], [107, 102131], [113, 102311], [117, 102531], [121, 102771], [125, 103260], [129, 103364], [136, 103844], [138, 103924], [145, 104124], [152, 104464], [156, 104904], [160, 105024], [166, 105184], [170, 105364], [174, 105824], [179, 106109], [187, 106509], [189, 106669], [192, 106789], [195, 106909], [199, 107009]]}, {"verse": 18, "start": 107757, "end": 112823, "text": "They said therefore, What is this that he says, A little while? we cannot tell what he says.", "words": [[0, 107757], [5, 107915], [10, 108215], [21, 109251], [26, 109369], [29, 109509], [34, 109709], [39, 109889], [42, 109989], [48, 110209], [50, 110449], [57, 110629], [64, 111415], [67, 111534], [74, 111754], [79, 112074], [84, 112274], [87, 112354]]}, {"verse": 19, "start": 113103, "end": 126368, "text": "Now Jesus knew that they were desirous to ask him, and said to them, Do you enquire among yourselves of that I said, A little while, and you shall not see me: and again, a little while, and you shall see me?", "words": [[0, 113103], [4, 113366], [10, 113686], [15, 114086], [20, 114286], [25, 114446], [30, 114606], [39, 115226], [42, 115366], [46, 115706], [51, 115926], [55, 116286], [60, 116526], [63, 116706], [69, 118137], [72, 118236], [76, 118626], [84, 119016], [90, 119196], [101, 119676], [104, 119976], [109, 120156], [111, 120336], [117, 120876], [119, 121016], [126, 121196], [133, 122036], [137, 122296], [141, 122456], [147, 122656], [151, 122896], [155, 123176], [159, 123726], [163, 123884], [170, 124464], [172, 124524], [179, 124684], [186, 125344], [190, 125444], [194, 125584], [200, 125784], [204, 126024]]}, {"verse": 20, "start": 126718, "end": 136192, "text": "Most assuredly, I say to you, That you shall weep and lament, but the world shall rejoice: and you shall be sorrowful, but your sorrow shall be turned into joy.", "words": [[0, 126718], [5, 126882], [16, 127602], [18, 127742], [22, 127962], [25, 128162], [30, 128622], [35, 129002], [39, 129162], [45, 129362], [50, 129822], [54, 129962], [62, 130702], [66, 130882], [70, 131022], [76, 131302], [82, 131582], [91, 132586], [95, 132711], [99, 132831], [105, 132991], [108, 133131], [119, 133991], [123, 134231], [128, 134351], [135, 134691], [141, 134951], [144, 135091], [151, 135351], [156, 135611]]}, {"verse": 21, "start": 136542, "end": 147512, "text": "A woman when she is in travail has sorrow, because her hour is come: but as soon as she is delivered of the child, she remembers no more the anguish, for joy that a man is born into the world.", "words": [[0, 136542], [2, 136648], [8, 136928], [13, 137228], [17, 137468], [20, 137628], [23, 137768], [31, 138088], [35, 138548], [43, 139008], [51, 139648], [55, 139888], [60, 140168], [63, 140448], [69, 141107], [73, 141204], [76, 141324], [81, 141564], [84, 141664], [88, 141824], [91, 141924], [101, 142264], [104, 142424], [108, 142524], [115, 143264], [119, 143424], [129, 143744], [132, 144024], [137, 144244], [141, 144384], [150, 145184], [154, 145364], [158, 145684], [163, 145904], [165, 146004], [169, 146184], [172, 146384], [177, 146664], [182, 146844], [186, 147004]]}, {"verse": 22, "start": 147862, "end": 155303, "text": "And you now therefore have sorrow: but I will see you again, and your heart shall rejoice, and your joy no man takes from you.", "words": [[0, 147862], [4, 147981], [8, 148081], [12, 148281], [22, 148721], [27, 148961], [35, 149821], [39, 149944], [41, 150104], [46, 150264], [50, 150484], [54, 150644], [61, 151384], [65, 151624], [70, 151744], [76, 152004], [82, 152244], [91, 153104], [95, 153344], [100, 153484], [104, 153784], [107, 154044], [111, 154364], [117, 154684], [122, 154944]]}, {"verse": 23, "start": 155653, "end": 163146, "text": "And in that day you shall ask me nothing. Most assuredly, I say to you, Whatever you shall ask the Father in my name, he will give it you.", "words": [[0, 155653], [4, 155793], [7, 155913], [12, 156113], [16, 156613], [20, 156813], [26, 156973], [30, 157233], [33, 157393], [42, 158171], [47, 158352], [58, 158932], [60, 159012], [64, 159232], [67, 159432], [72, 159952], [81, 160232], [85, 160472], [91, 160652], [95, 160892], [99, 161052], [106, 161312], [109, 161512], [112, 161692], [118, 162312], [121, 162392], [126, 162532], [131, 162712], [134, 162832]]}, {"verse": 24, "start": 163496, "end": 168834, "text": "Until now have you asked nothing in my name: ask, and you shall receive, that your joy may be full.", "words": [[0, 163496], [6, 163741], [10, 164201], [15, 164321], [19, 164481], [25, 164681], [33, 165081], [36, 165301], [39, 165481], [45, 166112], [50, 166417], [54, 166597], [58, 166717], [64, 166917], [73, 167357], [78, 167657], [83, 167797], [87, 168097], [91, 168277], [94, 168397]]}, {"verse": 25, "start": 169184, "end": 177634, "text": "These things have I spoken to you in proverbs: but the time comes, when I shall no more speak to you in proverbs, but I shall show you plainly of the Father.", "words": [[0, 169184], [6, 169367], [13, 169727], [18, 169947], [20, 170067], [27, 170387], [30, 170647], [34, 170787], [37, 170927], [47, 171907], [51, 172031], [55, 172131], [60, 172411], [67, 172831], [72, 173116], [74, 173256], [80, 173416], [83, 173616], [88, 173836], [94, 174096], [97, 174316], [101, 174456], [104, 174616], [114, 175476], [118, 175776], [120, 175916], [126, 176076], [131, 176316], [135, 176476], [143, 176936], [146, 177036], [150, 177136]]}, {"verse": 26, "start": 177984, "end": 183788, "text": "At that day you shall ask in my name: and I say not to you, that I will pray the Father for you:", "words": [[0, 177984], [3, 178126], [8, 178306], [12, 178586], [16, 178746], [22, 178906], [26, 179226], [29, 179386], [32, 179546], [38, 180261], [42, 180382], [44, 180542], [48, 180782], [52, 181042], [55, 181262], [60, 181722], [65, 182082], [67, 182222], [72, 182362], [77, 182642], [81, 182802], [88, 183102], [92, 183402]]}, {"verse": 27, "start": 184138, "end": 189929, "text": "For the Father himself loves you, because you have loved me, and have believed that I came out from God.", "words": [[0, 184138], [4, 184225], [8, 184365], [15, 184665], [23, 184945], [29, 185485], [34, 185805], [42, 186345], [46, 186605], [51, 186785], [57, 187025], [61, 187365], [65, 187865], [70, 187985], [79, 188365], [84, 188605], [86, 188705], [91, 188925], [95, 189145], [100, 189365]]}, {"verse": 28, "start": 190279, "end": 196263, "text": "I came forth from the Father, and am come into the world: again, I leave the world, and go to the Father.", "words": [[0, 190279], [2, 190446], [7, 190686], [13, 190966], [18, 191226], [22, 191346], [30, 192086], [34, 192186], [37, 192286], [42, 192546], [47, 192766], [51, 192906], [58, 193599], [65, 194221], [67, 194361], [73, 194621], [77, 194781], [84, 195061], [88, 195381], [91, 195561], [94, 195681], [98, 195781]]}, {"verse": 29, "start": 196543, "end": 201153, "text": "His disciples said to him, Lo, now do you speak plainly, and speak no proverb.", "words": [[0, 196543], [4, 196657], [14, 197157], [19, 197477], [22, 197657], [27, 198235], [31, 198305], [35, 198525], [38, 198745], [42, 198865], [48, 199065], [57, 199685], [61, 199965], [67, 200245], [70, 200525]]}, {"verse": 30, "start": 201503, "end": 209051, "text": "Now are we sure that you know all things, and need not that any man should ask you: by this we believe that you came forth from God.", "words": [[0, 201503], [4, 201743], [8, 201983], [11, 202143], [16, 202403], [21, 202603], [25, 202723], [30, 202903], [34, 203203], [42, 203563], [46, 204103], [51, 204383], [55, 204643], [60, 204883], [64, 205043], [68, 205323], [75, 205563], [79, 205843], [84, 206360], [87, 206481], [92, 207001], [95, 207101], [103, 207441], [108, 207641], [112, 207781], [117, 207981], [123, 208301], [128, 208561]]}, {"verse": 31, "start": 209331, "end": 211737, "text": "Jesus answered them, Do you now believe?", "words": [[0, 209331], [6, 209607], [15, 210047], [21, 210517], [24, 210617], [28, 210797], [32, 211017]]}, {"verse": 32, "start": 212087, "end": 223087, "text": "Behold, the hour comes, yes, is now come, that you shall be scattered, every man to his own, and shall leave me alone: and yet I am not alone, because the Father is with me.", "words": [[0, 212087], [8, 212532], [12, 212712], [17, 212952], [24, 213652], [29, 214312], [32, 214452], [36, 214712], [42, 215432], [47, 215532], [51, 215732], [57, 215932], [60, 216092], [71, 216472], [77, 216892], [81, 217172], [84, 217392], [88, 217552], [93, 218092], [97, 218192], [103, 218412], [109, 218672], [112, 218892], [119, 219668], [123, 219810], [127, 220010], [129, 220230], [132, 220370], [136, 220570], [143, 221250], [151, 221750], [155, 221970], [162, 222270], [165, 222510], [170, 222690]]}, {"verse": 33, "start": 223437, "end": 233018, "text": "These things I have spoken to you, that in me you might have peace. In the world you shall have tribulation: but be of good cheer; I have overcome the world.", "words": [[0, 223437], [6, 223662], [13, 224042], [15, 224282], [20, 224382], [27, 224722], [30, 224982], [35, 225662], [40, 225782], [43, 225942], [46, 226202], [50, 226422], [56, 226622], [61, 226822], [68, 227705], [71, 228001], [75, 228121], [81, 228461], [85, 228721], [91, 228921], [96, 229101], [109, 230131], [113, 230234], [116, 230454], [119, 230574], [124, 230774], [131, 231570], [133, 231721], [138, 231861], [147, 232201], [151, 232461]]}]}