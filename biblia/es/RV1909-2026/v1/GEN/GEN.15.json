{"book": "GEN", "chapter": 15, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 164381, "verses": [{"verse": 1, "start": 300, "end": 10918, "text": "Después de estas cosas fue la palabra de Jehová a Abram en visión, diciendo: No temas, Abram; yo soy tu escudo, y tu galardón sobremanera grande.", "words": [[0, 300], [8, 519], [11, 679], [17, 839], [23, 1179], [27, 1459], [30, 1579], [38, 1879], [41, 2099], [48, 2599], [50, 2839], [56, 3079], [59, 3419], [67, 4299], [77, 5233], [80, 5432], [87, 5947], [94, 6930], [97, 7108], [101, 7388], [104, 7628], [112, 8188], [114, 8628], [117, 8768], [126, 9348], [138, 10068]]}, {"verse": 2, "start": 11198, "end": 20489, "text": "Y respondió Abram: Señor Jehová ¿qué me has de dar, siendo así que sigo sin hijos, y el mayordomo de mi casa es ese damasceno Eliezer?", "words": [[0, 11198], [2, 11323], [12, 11953], [19, 12783], [25, 13039], [32, 13742], [37, 13834], [40, 13994], [44, 14154], [47, 14314], [52, 14894], [59, 15174], [63, 15594], [67, 15794], [72, 16194], [76, 16374], [83, 17134], [85, 17274], [88, 17634], [98, 17994], [101, 18094], [104, 18194], [109, 18514], [112, 18794], [116, 19377], [126, 19961]]}, {"verse": 3, "start": 20769, "end": 27406, "text": "Dijo más Abram: Mira que no me has dado descendencia, y he aquí que mi heredero será un esclavo nacido en mi casa.", "words": [[0, 20769], [5, 21072], [9, 21660], [16, 22413], [21, 22616], [25, 22776], [28, 22896], [31, 23016], [35, 23116], [40, 23316], [54, 24356], [56, 24436], [59, 24556], [64, 24776], [68, 24936], [71, 25076], [80, 25496], [85, 25716], [88, 26026], [96, 26336], [103, 26716], [106, 26816], [109, 26936]]}, {"verse": 4, "start": 27686, "end": 37452, "text": "Y luego la palabra de Jehová fue a él diciendo: No te heredará este, sino el que saldrá de tus entrañas será el que te herede.", "words": [[0, 27686], [2, 27810], [8, 28030], [11, 28310], [19, 28690], [22, 28890], [29, 29450], [33, 29550], [35, 29750], [38, 29930],