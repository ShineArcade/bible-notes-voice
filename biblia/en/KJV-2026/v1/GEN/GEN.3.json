{"book": "GEN", "chapter": 3, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 212028, "verses": [{"verse": 1, "start": 300, "end": 10190, "text": "Now the serpent was more cunning than any beast of the field which the LORD God had made. And he said to the woman, Has God indeed said, You shall not eat of every tree of the garden?", "words": [[0, 300], [4, 501], [8, 701], [16, 1001], [20, 1241], [25, 1481], [33, 1841], [38, 2121], [42, 2401], [48, 2721], [51, 2921], [55, 3041], [61, 3361], [67, 3601], [71, 3781], [76, 4001], [80, 4301], [84, 4581], [90, 5409], [94, 5548], [97, 5628], [102, 5848], [105, 6028], [109, 6108], [116, 6865], [120, 7032], [124, 7252], [131, 7472], [137, 8192], [141, 8332], [147, 8512], [151, 8732], [155, 8932], [158, 9072], [164, 9272], [169, 9532], [172, 9652], [176, 9732]]}, {"verse": 2, "start": 10540, "end": 16528, "text": "And the woman said to the serpent, We may eat of the fruit of the trees of the garden:", "words": [[0, 10540], [4, 10692], [8, 10812], [14, 10992], [19, 11332], [22, 11512], [26, 11652], [35, 13761], [38, 13847], [42, 14027], [46, 14387], [49, 14627], [53, 14767], [59, 14987], [62, 15167], [66, 15267], [72, 15587], [75, 15787], [79, 15887]]}, {"verse": 3, "start": 16978, "end": 25898, "text": "But of the fruit of the tree which is in the midst of the garden, God has said, You shall not eat of it, neither shall you touch it, lest you die.", "words": [[0, 16978], [4, 17078], [7, 17198], [11, 17318], [17, 17578], [20, 17758], [24, 17878], [29, 18178], [35, 18438], [38, 18578], [41, 18718], [45, 18798], [51, 18998], [54, 19198], [58, 19318], [66, 20238], [70, 20498], [74, 20758], [80, 21578], [84, 21758], [90, 21978], [94, 22258], [98, 22478], [101, 22618], [105, 23138], [113, 23318], [119, 23718], [123, 23918], [129, 24198], [133, 24840], [138, 25207], [142, 25387]]}, {"verse": 4, "start": 26248, "end": 29504, "text": "And the serpent said to the woman, You shall not surely die:", "words": [[0, 26248], [4, 26394], [8, 26494], [16, 26814], [21, 27154], [24, 27294], [28, 27394], [35, 28122], [39, 28282], [45, 28462], [49, 28682], [56, 28982]]}, {"verse": 5, "start": 29954, "end": 36933, "text": "For God does know that in the day you eat of it, then your eyes shall be opened, and you shall be as gods, knowing good and evil.", "words": [[0, 29954], [4, 30066], [8, 30306], [13, 30546], [18, 30806], [23, 31026], [26, 31226], [30, 31366], [34, 31566], [38, 31706], [42, 31966], [45, 32086], [49, 32526], [54, 32686], [59, 32826], [64, 33086], [70, 33366], [73, 33506], [81, 34326], [85, 34386], [89, 34506], [95, 34666], [98, 34866], [101, 35186], [107, 35686], [115, 35866], [120, 36186], [124, 36426]]}, {"verse": 6, "start": 37284, "end": 50983, "text": "And when the woman saw that the tree was good for food, and that it was pleasant to the eyes, and a tree to be desired to make one wise, she took of the fruit of it, and did eat, and gave also to her husband with her; and he did eat.", "words": [[0, 37284], [4, 37417], [9, 37557], [13, 37697], [19, 37937], [23, 38337], [28, 38517], [32, 38657], [37, 38937], [41, 39157], [46, 39377], [50, 39577], [56, 39997], [60, 40557], [65, 40677], [68, 40757], [72, 40877], [81, 41277], [84, 41497], [88, 41637], [94, 41997], [98, 42417], [100, 42537], [105, 42737], [108, 42857], [111, 42977], [119, 43377], [122, 43637], [127, 43857], [131, 44157], [137, 45235], [141, 45355], [146, 45575], [149, 45735], [153, 45835], [159, 46075], [162, 46215], [166, 46375], [170, 46655], [174, 46915], [179, 47295], [183, 47715], [188, 47915], [193, 48315], [196, 48595], [200, 48795], [208, 49075], [213, 49395], [218, 49997], [222, 50142], [225, 50302], [229, 50542]]}, {"verse": 7, "start": 51433, "end": 59149, "text": "And the eyes of them both were opened, and they knew that they were naked; and they sewed fig leaves together, and made themselves aprons.", "words": [[0, 51433], [4, 51575], [8, 51695], [13, 51955], [16, 52135], [21, 52275]