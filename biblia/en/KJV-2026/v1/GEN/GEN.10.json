{"book": "GEN", "chapter": 10, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 194006, "verses": [{"verse": 1, "start": 300, "end": 7510, "text": "Now these are the generations of the sons of Noah, Shem, Ham, and Japheth: and to them were sons born after the flood.", "words": [[0, 300], [4, 551], [10, 911], [14, 1191], [18, 1311], [30, 1851], [33, 2151], [37, 2251], [42, 2511], [45, 2691], [51, 3311], [57, 3811], [62, 4211], [66, 4271], [75, 5163], [79, 5286], [82, 5486], [87, 5706], [92, 5886], [97, 6146], [102, 6506], [108, 6846], [112, 7026]]}, {"verse": 2, "start": 7860, "end": 13997, "text": "The sons of Japheth; Gomer, and Magog, and Madai, and Javan, and Tubal, and Meshech, and Tiras.", "words": [[0, 7860], [4, 7961], [9, 8281], [12, 8586], [21, 9337], [28, 9597], [32, 9657], [39, 10097], [43, 10467], [50, 10837], [54, 11217], [61, 11597], [65, 11797], [72, 12297], [76, 12657], [85, 13017], [89, 13507]]}, {"verse": 3, "start": 13997, "end": 18180, "text": "And the sons of Gomer; Ashkenaz, and Riphath, and Togarmah.", "words": [[0, 13997], [4, 14257], [8, 14377], [13, 14697], [16, 15105], [23, 15679], [33, 16399], [37, 16799], [46, 17199], [50, 17689]]}, {"verse": 4, "start": 18530, "end": 22906, "text": "And the sons of Javan; Elishah, and Tarshish, Kittim, and Dodanim.", "words": [[0, 18530], [4, 18677], [8, 18817], [13, 19137], [16, 19558], [23, 20344], [32, 20564], [36, 20884], [46, 21424], [54, 21964], [58, 22468]]}, {"verse": 5, "start": 23256, "end": 31255, "text": "By these were the isles of the Gentiles divided in their lands; every one after his tongue, after their families, in their nations.", "words": [[0, 23256], [3, 23445], [9, 23785], [14, 24085], [18, 24375], [24, 24665], [27, 24765], [31, 24865], [40, 25565], [48, 26045], [51, 26385], [57, 26585], [64, 27549], [70, 27669], [74, 27789], [80, 28249], [84, 28489], [92, 29149], [98, 29349], [104, 29569], [114, 30309], [117, 30389], [123, 30509]]}, {"verse": 6, "start": 31605, "end": 36408, "text": "¶ And the sons of Ham; Cush, and Mizraim, and Phut, and Canaan.", "words": [[2, 31605], [6, 31845], [10, 31985], [15, 32245], [18, 32445], [23, 33482], [29, 33802], [33, 34293], [42, 34785], [46, 35183], [52, 35582], [56, 36034]]}, {"verse": 7, "start": 36758, "end": 47094, "text": "And the sons of Cush; Seba, and Havilah, and Sabtah, and Raamah, and Sabtecha: and the sons of Raamah; Sheba, and Dedan.", "words": [[0, 36758], [4, 36997], [8, 37117], [13, 37437], [16, 37860], [22, 38441], [28, 38958], [32, 39398], [41, 40078], [45, 40648], [53, 41218], [57, 41588], [65, 41958], [69, 42799], [79, 43797], [83, 44067], [87, 44187], [92, 44427], [95, 44838], [103, 45709], [110, 45999], [114, 46572]]}, {"verse": 8, "start": 47444, "end": 52193, "text": "And Cush begot Nimrod: he began to be a mighty one in the earth.", "words": [[0, 47444], [4, 47699], [9, 47954], [15, 48454], [23, 49823], [26, 49913], [32, 50273], [35, 50433], [38, 50633], [40, 50753], [47, 51093], [51, 51453], [54, 51773], [58, 51893]]}, {"verse": 9, "start": 52543, "end": 59730, "text": "He was a mighty hunter before the LORD: therefore it is said, Even as Nimrod the mighty hunter before the LORD.", "words": [[0, 52543], [3, 52657], [7, 52837], [9, 52977], [16, 53277], [23, 53717], [30, 54097], [34, 54357], [40, 55098], [50, 55525], [53, 55905], [56, 56065], [62, 56705], [67, 57005], [70, 57285], [77, 57805], [81, 58025], [88, 58265], [95, 58645], [102, 59005], [106, 59245]]}, {"verse": 10, "start": 60080, "end": 66956, "text": "And the beginning of his kingdom was Babel, and Erech, and Accad, and Calneh, in the land of Shinar.", "words": [[0, 60080], [4, 60255], [8, 60335], [18, 60615], [21, 60875], [25, 60975], [33, 61335], [37, 61615], [44, 62215], [48, 62755], [55, 63355], [59, 63925], [66, 64495], [70, 64895], [78, 65295], [81, 65650], [85, 65790], [90, 66050], [93, 66190]]}, {"verse": 11, "start": 67306, "end": 73183, "text": "Out of that land went forth Asshur, and built Nineveh, and the city Rehoboth, and Calah,", "words": [[0, 67306], [4, 67476], [7, 67636], [12, 67856], [17, 68196], [22, 68396], [28, 69096], [36, 69796], [40, 69796], [46, 70056], [55, 70956], [59, 71056], [63, 71156], [68, 71416], [78, 72476], [82, 72840]]}, {"verse": 12, "start": 73533, "end": 77401, "text": "And Resen between Nineveh and Calah: the same is a great city.", "words": [[0, 73533], [4, 73759], [10, 73999], [18, 74379], [26, 75099], [30, 75464], [37, 75975], [41, 76080], [46, 76340], [49, 76540], [51, 76640], [57, 76820]]}, {"verse": 13, "start": 77751, "end": 82342, "text": "And Mizraim begot Ludim, and Anamim, and Lehabim, and Naphtuhim,", "words": [[0, 77751], [4, 78098], [12, 78458], [18, 78938], [25, 79418], [29, 79898], [37, 80378], [41, 80798], [50, 81218], [54, 81780]]}, {"verse": 14, "start": 82692, "end": 87545, "text": "And Pathrusim, and Casluhim, (out of whom came Philistim,) and Caphtorim.", "words": [[0, 82692], [4, 83345], [15, 84025], [19, 84475], [29, 84925], [34, 85125], [37, 85265], [42, 85445], [47, 85725], [59, 86705], [63, 87155]]}, {"verse": 15, "start": 87895, "end": 91394, "text": "¶ And Canaan begot Sidon his firstborn, and Heth,", "words": [[2, 87895], [6, 88157], [13, 88657], [19, 89197], [25, 89737], [29, 89917], [40, 90577], [44, 90997]]}, {"verse": 16, "start": 91744, "end": 95014, "text": "And the Jebusite, and the Amorite, and the Girgasite,", "words": [[0, 91744], [4, 91897], [8, 91997], [18, 92717], [22, 92897], [26, 92997], [35, 93597], [39, 94077], [43, 94580]]}, {"verse": 17, "start": 95364, "end": 98671, "text": "And the Hivite, and the Arkite, and the Sinite,", "words": [[0, 95364], [4, 95503], [8, 95583], [16, 96343], [20, 96663], [24, 97223], [32, 97783], [36, 97823], [40, 97903]]}, {"verse": 18, "start": 99021, "end": 106469, "text": "And the Arvadite, and the Zemarite, and the Hamathite: and afterward were the families of the Canaanites spread abroad.", "words": [[0, 99021], [4, 99164], [8, 99734], [18, 100304], [22, 100584], [26, 101174], [36, 101764], [40, 102044], [44, 102492], [55, 103097], [59, 103202], [69, 103592], [74, 103982], [78, 104122], [87, 104542], [90, 104762], [94, 104902], [105, 105502], [112, 105822]]}, {"verse": 19, "start": 106819, "end": 117990, "text": "And the border of the Canaanites was from Sidon, as you come to Gerar, to Gaza; as you go, to Sodom, and Gomorrah, and Admah, and Zeboim, even to Lasha.", "words": [[0, 106819], [4, 106943], [8, 107043], [15, 107323], [18, 107523], [22, 107643], [33, 108223], [37, 108383], [42, 108603], [49, 109263], [52, 109663], [56, 109783], [61, 109983], [64, 110143], [71, 110583], [74, 110943], [80, 111796], [83, 111981], [87, 112061], [91, 112201], [94, 112321], [101, 113381], [105, 113461], [115, 114581], [119, 115161], [126, 115741], [130, 115921], [138, 116721], [143, 116981], [146, 117181]]}, {"verse": 20, "start": 118340, "end": 125080, "text": "These are the sons of Ham, after their families, after their tongues, in their countries, and in their nations.", "words": [[0, 118340], [6, 118700], [10, 118840], [14, 118980], [19, 119260], [22, 119460], [27, 119800], [33, 120300], [39, 120500], [49, 121480], [55, 121660], [61, 121880], [70, 122260], [73, 122720], [79, 122880], [90, 123320], [94, 124020], [97, 124220], [103, 124380]]}, {"verse": 21, "start": 125430, "end": 132590, "text": "¶ To Shem also, the father of all the children of Eber, the brother of Japheth the elder, even to him were children born.", "words": [[2, 125430], [5, 125530], [10, 125870], [16, 126170], [20, 126390], [27, 126710], [30, 126990], [34, 127150], [38, 127310], [47, 127630], [50, 127830], [56, 128610], [60, 128810], [68, 129070], [71, 129310], [79, 129790], [83, 129930], [90, 130650], [95, 130890], [98, 131150], [102, 131350], [107, 131590], [116, 131950]]}, {"verse": 22, "start": 132940, "end": 138231, "text": "The children of Shem; Elam, and Asshur, and Arphaxad, and Lud, and Aram.", "words": [[0, 132940], [4, 133019], [13, 133379], [16, 133559], [22, 134365], [28, 134755], [32, 135145], [40, 135535], [44, 136075], [54, 136615], [58, 136975], [63, 137335], [67, 137595]]}, {"verse": 23, "start": 138581, "end": 142980, "text": "And the children of Aram; Uz, and Hul, and Gether, and Mash.", "words": [[0, 138581], [4, 138721], [8, 138821], [17, 139201], [20, 139722], [26, 140567], [30, 140767], [34, 141007], [39, 141247], [43, 141577], [51, 141907], [55, 142327]]}, {"verse": 24, "start": 143330, "end": 147143, "text": "And Arphaxad begot Salah; and Salah begot Eber.", "words": [[0, 143330], [4, 143744], [13, 144184], [19, 144624], [26, 145536], [30, 145680], [36, 146160], [42, 146560]]}, {"verse": 25, "start": 147493, "end": 156204, "text": "And to Eber were born two sons: the name of one was Peleg; for in his days was the earth divided; and his brother’s name was Joktan.", "words": [[0, 147493], [4, 147633], [7, 147863], [12, 148093], [17, 148293], [22, 148633], [26, 148953], [32, 149943], [36, 150028], [41, 150288], [44, 150468], [48, 150688], [52, 151203], [59, 151865], [63, 151956], [66, 152156], [70, 152316], [75, 152636], [79, 152896], [83, 153056], [89, 153256], [98, 154175], [102, 154298], [106, 154438], [116, 154898], [121, 155138], [125, 155671]]}, {"verse": 26, "start": 156554, "end": 161270, "text": "And Joktan begot Almodad, and Sheleph, and Hazarmaveth, and Jerah,", "words": [[0, 156554], [4, 156863], [11, 157203], [17, 157743], [26, 158283], [30, 158683], [39, 159083], [43, 159613], [56, 160143], [60, 160727]]}, {"verse": 27, "start": 161620, "end": 164549, "text": "And Hadoram, and Uzal, and Diklah,", "words": [[0, 161620], [4, 161784], [13, 162484], [17, 162924], [23, 163584], [27, 164067]]}, {"verse": 28, "start": 164899, "end": 167361, "text": "And Obal, and Abimael, and Sheba,", "words": [[0, 164899], [4, 165305], [10, 165745], [14, 166195], [23, 166645], [27, 167024]]}, {"verse": 29, "start": 167711, "end": 172880, "text": "And Ophir, and Havilah, and Jobab: all these were the sons of Joktan.", "words": [[0, 167711], [4, 167963], [11, 168503], [15, 168903], [24, 169303], [28, 169763], [35, 170635], [39, 170830], [45, 171110], [50, 171570], [54, 171710], [59, 171990], [62, 172150]]}, {"verse": 30, "start": 173230, "end": 177198, "text": "And their dwelling was from Mesha, as you go to Sephar a mount of the east.", "words": [[0, 173230], [4, 173379], [10, 173459], [19, 173799], [23, 174112], [28, 174426], [35, 174739], [38, 175259], [42, 175379], [45, 175499], [48, 175619], [55, 175859], [57, 176099], [63, 176339], [66, 176539], [70, 176679]]}, {"verse": 31, "start": 177548, "end": 184268, "text": "These are the sons of Shem, after their families, after their tongues, in their lands, after their nations.", "words": [[0, 177548], [6, 177778], [10, 177958], [14, 178098], [19, 178458], [22, 178658], [28, 179538], [34, 179838], [40, 180078], [50, 180938], [56, 181118], [62, 181358], [71, 182138], [74, 182218], [80, 182378], [87, 183058], [93, 183298], [99, 183538]]}, {"verse": 32, "start": 184618, "end": 193606, "text": "These are the families of the sons of Noah, after their generations, in their nations: and by these were the nations divided in the earth after the flood.", "words": [[0, 184618], [6, 184865], [10, 185045], [14, 185165], [23, 185625], [26, 185885], [30, 186005], [35, 186285], [38, 186465], [44, 186865], [50, 187405], [56, 187585], [69, 188265], [72, 188685], [78, 188885], [87, 189865], [91, 189991], [94, 190171], [100, 190471], [105, 190771], [109, 190891], [117, 191271], [125, 191831], [128, 192131], [132, 192271], [138, 192471], [144, 192891], [148, 193071]]}]}