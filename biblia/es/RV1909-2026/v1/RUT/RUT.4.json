{"book": "RUT", "chapter": 4, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 209204, "verses": [{"verse": 1, "start": 300, "end": 12635, "text": "Y Booz subió a la puerta y se sentó allí: y he aquí pasaba aquel pariente del cual había Booz hablado, y le dijo: Eh, fulano, ven acá y siéntate. Y él vino, y se sentó.", "words": [[0, 300], [2, 471], [7, 681], [13, 1601], [15, 1741], [18, 1821], [25, 2081], [27, 2361], [30, 2481], [36, 2901], [42, 3575], [44, 3725], [47, 3875], [52, 4155], [59, 4735], [65, 5035], [74, 5535], [78, 5795], [83, 6015], [89, 6325], [94, 6635], [103, 7335], [105, 7435], [108, 7535], [114, 8189], [118, 8454], [126, 9314], [130, 9434], [134, 9714], [136, 9954], [146, 10864], [148, 11048], [151, 11188], [157, 11528], [159, 11813], [162, 11953]]}, {"verse": 2, "start": 12985, "end": 20880, "text": "Entonces él tomó diez varones de los ancianos de la ciudad, y dijo: Sentaos aquí. Y ellos se sentaron.", "words": [[0, 12985], [9, 13605], [12, 14205], [17, 14525], [22, 14845], [30, 15485], [33, 15665], [37, 15785], [46, 16465], [49, 16585], [52, 16685], [60, 17045], [62, 17425], [68, 18070], [76, 18512], [82, 19204], [84, 19407], [90, 19727], [93, 20027]]}, {"verse": 3, "start": 21230, "end": 28904, "text": "Luego dijo al pariente: Noemí, que ha vuelto del campo de Moab, vende una parte de las tierras que tuvo nuestro hermano Elimelec;", "words": [[0, 21230], [6, 21626], [11, 21946], [14, 22126], [24, 23022], [31, 23484], [35, 23524], [38, 23644], [45, 23984], [49, 24144], [55, 24464], [58, 24664], [64, 25234], [70, 25804], [74, 25924], [80, 26204], [83, 26384], [87, 26544], [95, 26944], [99, 27124], [104, 27324], [112, 27564], [120, 28254]]}, {"verse": 4, "start": 29254, "end": 48311, "text": "Y yo decidí hacértelo saber, y decirte que la compres delante de los que están aquí sentados, y delante de los ancianos de mi pueblo. Si tú quieres redimir, redime; y si no quieres redimir, decláramelo para que yo lo sepa: porque no hay otro que redima sino tú, y yo después de ti. Y él respondió: Yo redimiré.", "words": [[0, 29254], [2, 29371], [5, 29531], [12, 30051], [22, 30551], [29, 30951], [31, 31431], [39, 31991], [43, 32131], [46, 32431], [54, 32731], [62, 33151], [65, 33311], [69, 33451], [73, 33631], [79, 33871], [84, 34111], [94, 34791], [96, 35231], [104, 35651], [107, 35811], [111, 35951], [120, 36491], [123, 36651], [126, 36771], [134, 37503], [137, 37642], [140, 37802], [148, 38082], [157, 39002], [165, 39828], [167, 39916], [170, 40016], [173, 40136], [181, 40596], [190, 41056], [202, 41596], [207, 41816], [211, 41956], [214, 42076], [217, 42176], [223, 42868], [230, 43033], [233, 43193], [237, 43333], [242, 43513], [246, 43833], [253, 44153], [258, 44293], [262, 44613], [264, 45033], [267, 45133], [275, 45393], [278, 45673], [282, 46212], [284, 46394], [287, 46534], [298, 47777], [301, 48067]]}, {"verse": 5, "start": 48591, "end": 61092, "text": "Entonces replicó Booz: El mismo día que compres las tierras de mano de Noemí, has de tomar también a Ruth moabita, mujer del difunto, para que restaures el nombre del muerto sobre su posesión.", "words": [[0, 48591], [9, 49130], [17, 50004], [23, 51021], [26, 51145], [32, 51365], [36, 51625], [40, 51785], [48, 52165], [52, 52305], [60, 52665], [63, 52825], [68, 53025], [71, 53185], [78, 53715], [82, 54245], [85, 54365], [91, 54645], [99, 54985], [101, 55325], [106, 55665], [115, 56705], [121, 56965], [125, 57205], [134, 58076], [139, 58223], [143, 58363], [153, 58903], [156, 59083], [163, 59363], [167, 59523], [174, 59923], [180, 60163], [183, 60343]]}, {"verse": 6, "start": 61372, "end": 70279, "text": "Y respondió el pariente: No puedo redimir por mi parte, porque echaría a perder mi heredad: redime tú usando de mi derecho, porque yo no podré redimir.", "words": [[0, 61372], [2, 61727], [12, 62117], [15, 62237], [25, 63289], [28, 63432], [34, 63672], [42, 64132], [46, 64332], [49, 64492], [56, 65132], [63, 65292], [71, 65772], [73, 65812], [80, 66032], [83, 66272], [92, 66968], [99, 67335], [102, 67595], [109, 67975], [112, 68215], [115, 68295], [124, 68695], [131, 69015], [134, 69195], [137, 69295], [143, 69635]]}, {"verse": 7, "start": 70559, "end": 85298, "text": "Había ya de largo tiempo esta costumbre en Israel en la redención o contrato, que para la confirmación de cualquier negocio, el uno se quitaba el zapato y lo daba a su compañero: y este era el testimonio en Israel.", "words": [[0, 70559], [6, 70901], [9, 71121], [12, 71241], [18, 71481], [25, 71921], [30, 72221], [40, 72921], [43, 73081], [50, 73501], [53, 73921], [56, 74121], [66, 74801], [68, 75061], [78, 75761], [82, 76201], [87, 76421], [90, 76581], [103, 77421], [106, 77621], [116, 77861], [125, 79256], [128, 79420], [132, 79600], [135, 79780], [143, 80240], [146, 80580], [153, 80920], [155, 81020], [158, 81140], [163, 81440], [165, 81500], [168, 81640], [179, 82820], [181, 82984], [186, 83244], [190, 83544], [193, 83724], [204, 84364], [207, 84484]]}, {"verse": 8, "start": 85648, "end": 91329, "text": "Entonces el pariente dijo a Booz: Tómalo tú. Y descalzó su zapato.", "words": [[0, 85648], [9, 86154], [12, 86474], [21, 86974], [26, 87334], [28, 87772], [34, 88410], [41, 88896], [45, 89507], [47, 89651], [56, 90451], [59, 90591]]}, {"verse": 9, "start": 91679, "end": 103589, "text": "Y Booz dijo a los ancianos y a todo el pueblo: Vosotros sois hoy testigos de que he adquirido todas las cosas que fueron de Elimelec, y todo lo que fue de Quelión y de Mahlón, de mano de Noemí;", "words": [[0, 91679], [2, 92169], [7, 92689], [12, 92909], [14, 93049], [18, 93149], [27, 93789], [29, 93949], [31, 94009], [36, 94229], [39, 94409], [47, 95224], [56, 95526], [61, 95866], [65, 96206], [74, 96806], [77, 97046], [81, 97186], [84, 97306], [94, 97846], [100, 98106], [104, 98426], [110, 98746], [114, 98986], [121, 99246], [124, 99692], [134, 100138], [136, 100221], [141, 100441], [144, 100641], [148, 100781], [152, 100981], [155, 101281], [163, 101581], [165, 101681], [168, 101971], [176, 102261], [179, 102641], [184, 102861], [187, 103041]]}, {"verse": 10, "start": 103939, "end": 118022, "text": "Y que también tomo por mi mujer a Ruth moabita, mujer de Mahlón, para restaurar el nombre del difunto sobre su heredad, para que el nombre del muerto no se borre de entre sus hermanos y de la puerta de su lugar. Vosotros sois hoy testigos.", "words": [[0, 103939], [2, 104028], [6, 104108], [14, 104428], [19, 104848], [23, 105008], [26, 105128], [32, 105528], [34, 105928], [39, 106328], [48, 106728], [54, 106988], [57, 107368], [65, 107748], [70, 108148], [80, 108748], [83, 108848], [90, 109108], [94, 109308], [102, 109828], [108, 110088], [111, 110308], [120, 111095], [125, 111234], [129, 111414], [132, 111535], [139, 111794], [143, 111974], [150, 112395], [153, 112614], [156, 112794], [162, 113214], [165, 113334], [171, 113554], [175, 113754], [184, 114434], [186, 114574], [189, 114674], [192, 114774], [199, 115074], [202, 115274], [205, 115414], [212, 116082], [221, 116604], [226, 117024], [230, 117224]]}, {"verse": 11, "start": 118302, "end": 134934, "text": "Y dijeron todos los del pueblo que estaban a la puerta con los ancianos: Testigos somos. Jehová haga a la mujer que entra en tu casa como a Raquel y a Lea, las cuales dos edificaron la casa de Israel; y tú seas ilustre en Efrata, y seas de renombre en Belén;", "words": [[0, 118302], [2, 118403], [10, 118903], [16, 119203], [20, 119483], [24, 119663], [31, 120023], [35, 120263], [43, 120543], [45, 120743], [48, 120823], [55, 121083], [59, 121363], [63, 121523], [73, 123497], [82, 123707], [89, 124538], [96, 125007], [101, 125247], [103, 125387], [106, 125467], [112, 125747], [116, 125987], [122, 126227], [125, 126387], [128, 126507], [133, 126807], [138, 127127], [140, 127267], [147, 127607], [149, 127767], [151, 127827], [156, 128547], [160, 128647], [167, 128907], [171, 129207], [182, 129967], [185, 130107], [190, 130367], [193, 130547], [201, 131338], [203, 131462], [206, 131582], [211, 131822], [219, 132189], [222, 132555], [230, 132922], [232, 133322], [237, 133642], [240, 133822], [249, 134342], [252, 134462]]}, {"verse": 12, "start": 135284, "end": 141659, "text": "Y de la simiente que Jehová te dé de esta moza, sea tu casa como la de Fares, el hijo que Tamar dio a Judá.", "words": [[0, 135284], [2, 135393], [5, 135493], [8, 135613], [17, 136053], [21, 136213], [28, 136633], [31, 136713], [34, 136893], [37, 136993], [42, 137213], [48, 138013], [52, 138253], [55, 138453], [60, 138733], [65, 139033], [68, 139173], [71, 139273], [78, 140073], [81, 140233], [86, 140433], [90, 140593], [96, 140953], [100, 141133], [102, 141293]]}, {"verse": 13, "start": 141939, "end": 150898, "text": "Booz pues tomó a Ruth, y ella fue su mujer; y luego que se unió a ella, Jehová le dio que concibiese y pariese un hijo.", "words": [[0, 142203], [5, 142503], [10, 142903], [15, 143183], [17, 143323], [23, 144163], [25, 144283], [30, 144463], [34, 144703], [37, 144883], [44, 145743], [46, 145849], [52, 146069], [56, 146329], [59, 146509], [64, 146949], [66, 147109], [72, 147789], [79, 148229], [82, 148329], [86, 148529], [90, 148689], [101, 149389], [103, 149549], [111, 150029], [114, 150409]]}, {"verse": 14, "start": 151248, "end": 160163, "text": "Y las mujeres decían a Noemí: Alabado sea Jehová, que hizo que no te faltase hoy pariente, cuyo nombre será celebrado en Israel.", "words": [[0, 151248], [2, 151331], [6, 151451], [14, 151871], [21, 152771], [23, 153011], [30, 153767], [38, 154267], [42, 154507], [50, 155027], [54, 155207], [59, 155487], [63, 155667], [66, 155827], [69, 155947], [77, 156487], [81, 156667], [91, 157507], [96, 158007], [103, 158347], [108, 158707], [118, 159347], [121, 159487]]}, {"verse": 15, "start": 160513, "end": 169178, "text": "El cual será restaurador de tu alma, y el que sustentará tu vejez; pues que tu nuera, la cual te ama y te vale más que siete hijos, le ha parido.", "words": [[0, 160513], [3, 160657], [8, 160857], [13, 161367], [25, 161877], [28, 161997], [31, 162157], [37, 162477], [39, 162837], [42, 162917], [46, 163017], [57, 163697], [60, 163857], [67, 164607], [72, 164784], [76, 164904], [79, 165314], [86, 165724], [89, 165824], [94, 166004], [97, 166264], [101, 166484], [103, 166704], [106, 166844], [111, 167044], [115, 167284], [119, 167444], [125, 167704], [132, 168404], [135, 168524], [138, 168664]]}, {"verse": 16, "start": 169458, "end": 173477, "text": "Y tomando Noemí el hijo, lo puso en su regazo, y lo crio.", "words": [[0, 169458], [2, 169560], [10, 170040], [16, 170540], [19, 170700], [25, 171000], [28, 171360], [33, 171720], [36, 171820], [39, 171980], [47, 172580], [49, 172795], [52, 172935]]}, {"verse": 17, "start": 173697, "end": 184123, "text": "Y las vecinas diciendo, A Noemí ha nacido un hijo, le pusieron nombre; y le llamaron Obed. Este es padre de Isaí, padre de David.", "words": [[0, 173697], [2, 173823], [6, 174023], [14, 174543], [24, 175643], [26, 175883], [32, 176263], [35, 176623], [42, 177083], [45, 177303], [51, 178063], [54, 178163], [63, 178663], [71, 179569], [73, 179714], [76, 179814], [85, 180353], [91, 181172], [96, 181421], [99, 181561], [105, 181921], [108, 182061], [114, 182881], [120, 183441], [123, 183541]]}, {"verse": 18, "start": 184473, "end": 189424, "text": "Y estas son las generaciones de Fares: Fares engendró a Hezrón;", "words": [[0, 184473], [2, 184574], [8, 184754], [12, 185054], [16, 185254], [29, 185974], [32, 186154], [39, 187001], [45, 187605], [54, 188405], [56, 188914]]}, {"verse": 19, "start": 189774, "end": 194852, "text": "Y Hezrón engendró a Ram, y Ram engendró a Aminadab;", "words": [[0, 189774], [2, 190307], [9, 190841], [18, 191374], [20, 191894], [25, 192414], [27, 192881], [31, 193347], [40, 193814], [42, 193974]]}, {"verse": 20, "start": 195202, "end": 200415, "text": "Y Aminadab engendró a Naasón, y Naasón engendró a Salmón;", "words": [[0, 195202], [2, 195559], [11, 195949], [20, 196629], [22, 197099], [30, 197569], [32, 198169], [39, 198769], [48, 199469], [50, 199649]]}, {"verse": 21, "start": 200765, "end": 204868, "text": "Y Salmón engendró a Booz, y Booz engendró a Obed;", "words": [[0, 200765], [2, 200985], [9, 201505], [18, 202165], [20, 202486], [26, 202807], [28, 203084], [33, 203360], [42, 204080], [44, 204220]]}, {"verse": 22, "start": 205218, "end": 208804, "text": "Y Obed engendró a Isaí, e Isaí engendró a David.", "words": [[0, 205334], [2, 205480], [7, 205627], [16, 206367], [18, 206487], [24, 206817], [26, 207147], [31, 207807], [40, 208327], [42, 208427]]}]}