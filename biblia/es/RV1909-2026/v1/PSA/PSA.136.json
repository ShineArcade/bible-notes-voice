148], [12, 109348], [21, 109968], [28, 110128], [33, 110388], [41, 110828], [44, 111248], [47, 111508]]}, {"verse": 20, "start": 112959, "end": 118004, "text": "Y a Og rey de Basán, porque para siempre es su misericordia;", "words": [[0, 112959], [2, 113126], [4, 113316], [7, 113506], [11, 113886], [14, 113986], [21, 114886], [28, 115346], [33, 115586], [41, 116146], [44, 116566], [47, 116766]]}, {"verse": 21, "start": 118354, "end": 123947, "text": "Y dio la tierra de ellos en heredad, porque para siempre es su misericordia;", "words": [[0, 118354], [2, 118500], [6, 118700], [9, 118860], [16, 119200], [19, 119440], [25, 119700], [28, 119940], [37, 120700], [44, 121140], [49, 121660], [57, 122180], [60, 122620], [63, 122800]]}, {"verse": 22, "start": 124297, "end": 129562, "text": "En heredad a Israel su siervo, porque para siempre es su misericordia.", "words": [[0, 124297], [3, 124482], [11, 125022], [13, 125262], [20, 125882], [23, 126162], [31, 126842], [38, 127402], [43, 127702], [51, 128202], [54, 128682], [57, 129122]]}, {"verse": 23, "start": 129912, "end": 137050, "text": "Él es el que en nuestro abatimiento se acordó de nosotros, porque para siempre es su misericordia;", "words": [[0, 130559], [3, 131139], [6, 131399], [9, 131559], [13, 131799], [16, 132099], [24, 132319], [36, 133199], [39, 133479], [46, 133899], [49, 133999], [59, 134399], [66, 134884], [71, 135144], [79, 135584], [82, 135924], [85, 136024]]}, {"verse": 24, "start": 137400, "end": 142335, "text": "Y nos rescató de nuestros enemigos, porque para siempre es su misericordia.", "words": [[0, 137400], [2, 137544], [6, 137724], [14, 138604], [17, 138704], [26, 138924], [36, 139724], [43, 140024], [48, 140304], [56, 140724], [59, 141124], [62, 141224]]}, {"verse": 25, "start": 142685, "end": 148251, "text": "El da alimento a toda carne, porque para siempre es su misericordia.", "words": [[0, 142685], [3, 142742], [6, 142842], [15, 143442], [17, 143642], [22, 143822], [29, 144822], [36, 145102],