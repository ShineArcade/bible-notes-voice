{"book": "MAT", "chapter": 25, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 379891, "verses": [{"verse": 1, "start": 300, "end": 8410, "text": "Entonces el reino de los cielos será semejante a diez vírgenes, que tomando sus lámparas, salieron a recibir al esposo.", "words": [[0, 300], [9, 862], [12, 1302], [18, 1682], [21, 1802], [25, 1962], [32, 2482], [37, 2702], [47, 3442], [49, 3562], [54, 3722], [64, 4342], [68, 5002], [76, 5302], [80, 5502], [90, 6422], [99, 6922], [101, 7142], [109, 7462], [112, 7782]]}, {"verse": 2, "start": 8860, "end": 13472, "text": "Y las cinco de ellas eran prudentes, y las cinco insensatas.", "words": [[0, 8860], [2, 8970], [6, 9110], [12, 9470], [15, 9730], [21, 9890], [26, 10190], [37, 11050], [39, 11630], [43, 11770], [49, 12150]]}, {"verse": 3, "start": 13922, "end": 18660, "text": "Las que eran insensatas, tomando sus lámparas, no tomaron consigo aceite;", "words": [[0, 13922], [4, 14079], [8, 14279], [13, 14499], [25, 15519], [33, 15899], [37, 16079], [47, 16919], [50, 17099], [58, 17479], [66, 17859]]}, {"verse": 4, "start": 19110, "end": 23970, "text": "Pero las prudentes tomaron aceite en sus vasos, juntamente con sus lámparas.", "words": [[0, 19110], [5, 19370], [9, 19530], [19, 20010], [27, 20490], [34, 20930], [37, 21210], [41, 21370], [48, 21970], [59, 22650], [63, 22870], [67, 23452]]}, {"verse": 5, "start": 24420, "end": 28781, "text": "Y tardándose el esposo, cabecearon todas, y se durmieron.", "words": [[0, 24420], [2, 24565], [13, 25225], [16, 25365], [24, 26035], [35, 26705], [42, 27085], [44, 27825], [47, 27965]]}, {"verse": 6, "start": 29231, "end": 35419, "text": "Y a la media noche fue oído un clamor: He aquí, el esposo viene; salid a recibirle.", "words": [[0, 29231], [2, 29373], [4, 29473], [7, 29706], [13, 29940], [19, 30173], [23, 30373], [28, 30673], [31, 30833], [39, 31736], [42, 31816], [48, 32496], [51, 32656], [58, 33056], [65, 33917], [71, 34267], [73, 34617]]}, {"verse": 7, "start": 35869, "end": 40616, "text": "Entonces todas aquellas vírgenes se levantaron, y prepararon sus lámparas.", "words": [[0, 35869], [9, 36590], [15, 36870], [24, 37370], [33, 37790], [36, 37970], [48, 38570], [50, 38910], [61, 39550], [65, 39750]]}, {"verse": 8, "start": 41066, "end": 48858, "text": "Y las insensatas dijeron a las prudentes: Dadnos de vuestro aceite; porque nuestras lámparas se apagan.", "words": [[0, 41066], [2, 41169], [6, 41349], [17, 42509], [25, 43309], [27, 43429], [31, 43509], [42, 44640], [49, 45122], [52, 45322], [60, 45682], [68, 46676], [75, 46881], [84, 47181], [93, 47981], [96, 48141]]}, {"verse": 9, "start": 49308, "end": 59127, "text": "Pero las prudentes respondieron, diciendo: No sea que nos falte a nosotras y a vosotras, id antes a los que venden, y comprad para vosotras.", "words": [[0, 49308], [5, 49568], [9, 49808], [19, 50388], [33, 51168], [43, 52235], [46, 52361], [50, 52581], [54, 52761], [58, 52901], [64, 53321], [66, 53421], [75, 54001], [77, 54121], [79, 54221], [89, 54751], [92, 55281], [98, 55801], [100, 56021], [104, 56141], [108, 56281], [116, 56721], [118, 57221], [126, 57721], [131, 58201]]}, {"verse": 10, "start": 59577, "end": 69569, "text": "Y mientras que ellas iban a comprar, vino el esposo; y las que estaban preparadas, entraron con él a las bodas; y se cerró la puerta.", "words": [[0, 59577], [2, 59721], [11, 60141], [15, 60421], [21, 60661], [26, 61061], [28, 61161], [37, 61681], [42, 62301], [45, 62541], [53, 63543], [55, 63843], [59, 63963], [63, 64103], [71, 64423], [83, 65363], [92, 66463], [96, 66663], [99, 66863], [101, 66963], [105, 67083], [112, 68020], [114, 68184], [117, 68284], [123, 68744], [126, 68884]]}, {"verse": 11, "start": 70019, "end": 76211, "text": "Y después vinieron también las otras vírgenes, diciendo: Señor, Señor, ábrenos.", "words": [[0, 70019], [2, 70259], [10, 70559], [19, 71379], [27, 71759], [31, 72059], [37, 72339], [47, 72939], [57, 74273], [64, 74860], [71, 75440]]}, {"verse": 12, "start": 76661, "end": 81239, "text": "Pero respondiendo él, dijo: De cierto os digo, que no os conozco.", "words": [[0, 76661], [5, 76806], [18, 77606], [22, 77746], [28, 78860], [31, 79085], [38, 79310], [41, 79535], [47, 79855], [51, 80155], [54, 80515], [57, 80755]]}, {"verse": 13, "start": 81689, "end": 87744, "text": "Velad, pues, porque no sabéis el día ni la hora en que el Hijo del hombre ha de venir.", "words": [[0, 81689], [7, 82496], [13, 82716], [20, 83456], [23, 83656], [30, 84136], [33, 84336], [37, 84576], [40, 84936], [43, 85136], [48, 85436], [51, 85676], [55, 85836], [58, 85996], [63, 86276], [67, 86436], [74, 86796], [77, 87076], [80, 87236]]}, {"verse": 14, "start": 88194, "end": 95799, "text": "Porque el reino de los cielos es como un hombre que partiéndose lejos llamó a sus siervos, y les entregó sus bienes.", "words": [[0, 88194], [7, 88438], [10, 88658], [16, 89058], [19, 89178], [23, 89338], [30, 89778], [33, 89958], [38, 90178], [41, 90378], [48, 90638], [52, 90978], [64, 91738], [70, 92198], [76, 92498], [78, 92578], [82, 92738], [91, 93278], [93, 93878], [97, 94098], [105, 94858], [109, 95058]]}, {"verse": 15, "start": 96249, "end": 104761, "text": "Y a este dio cinco talentos, y al otro dos, y al otro uno: a cada uno conforme a su capacidad; y luego se fue lejos.", "words": [[0, 96249], [2, 96386], [4, 96486], [9, 96776], [13, 97066], [19, 97486], [29, 98386], [31, 98566], [34, 98706], [39, 98926], [44, 99186], [46, 99446], [49, 99586], [54, 99786], [59, 100655], [61, 100802], [66, 101002], [70, 101322], [79, 101682], [81, 102042], [84, 102142], [95, 103321], [97, 103441], [103, 103701], [106, 103981], [110, 104141]]}, {"verse": 16, "start": 105211, "end": 112690, "text": "Y el que había recibido cinco talentos se fue, y negoció con ellos, e hizo otros cinco talentos.", "words": [[0, 105211], [2, 105359], [5, 105479], [9, 105659], [15, 105899], [24, 106579], [30, 106859], [39, 107659], [42, 107779], [47, 108039], [49, 108539], [57, 108979], [61, 109259], [68, 109559], [70, 110259], [75, 110619], [81, 111139], [87, 111719]]}, {"verse": 17, "start": 113140, "end": 118000, "text": "Asimismo el que había recibido dos, ganó también él otros dos.", "words": [[0, 113464], [9, 113814], [12, 113954], [16, 114114], [22, 114354], [31, 115034], [36, 115754], [41, 116074], [49, 116354], [52, 116894], [58, 117374]]}, {"verse": 18, "start": 118450, "end": 125828, "text": "Pero el que había recibido uno, fue y cavó en la tierra, y escondió el dinero de su señor.", "words": [[0, 118450], [5, 118654], [8, 118814], [12, 118994], [18, 119234], [27, 119994], [32, 120334], [36, 121114], [38, 121524], [43, 121934], [46, 122094], [49, 122234], [57, 122694], [59, 123534], [68, 124194], [71, 124374], [78, 124714], [81, 124954], [84, 125114]]}, {"verse": 19, "start": 126278, "end": 132346, "text": "Y después de mucho tiempo, vino el señor de aquellos siervos, e hizo cuentas con ellos.", "words": [[0, 126278], [2, 126400], [10, 126700], [13, 126900], [19, 127120], [27, 127680], [32, 128540], [35, 128840], [41, 129160], [44, 129460], [53, 129720], [62, 130380], [64, 130820], [69, 131060], [77, 131600], [81, 131820]]}, {"verse": 20, "start": 132796, "end": 146308, "text": "Y llegando el que había recibido cinco talentos, trajo otros cinco talentos, diciendo: Señor, cinco talentos me entregaste; he aquí otros cinco talentos he ganado sobre ellos.", "words": [[0, 132796], [2, 133068], [11, 133398], [14, 133728], [18, 133848], [24, 134068], [33, 134728], [39, 134968], [49, 136148], [55, 136588], [61, 136908], [67, 137528], [77, 138548], [87, 139847], [94, 140487], [100, 140707], [109, 141347], [112, 141467], [124, 142719], [127, 142799], [132, 143079], [138, 143359], [144, 143839], [153, 144699], [156, 144819], [163, 145239], [169, 145599]]}, {"verse": 21, "start": 146758, "end": 156846, "text": "Y su señor le dijo: Bien, buen siervo y fiel; sobre poco has sido fiel, sobre mucho te pondré: entra en el gozo de tu señor.", "words": [[0, 146758], [2, 146864], [5, 146984], [11, 147384], [14, 147584], [20, 148361], [26, 149086], [31, 149286], [38, 149866], [40, 149986], [46, 150729], [52, 150973], [57, 151283], [61, 151593], [66, 151753], [72, 152613], [78, 152873], [84, 153353], [87, 153613], [95, 154634], [101, 155218], [104, 155398], [107, 155518], [112, 155918], [115, 156058], [118, 156218]]}, {"verse": 22, "start": 157296, "end": 167550, "text": "Y llegando también el que había recibido dos talentos, dijo: Señor, dos talentos me entregaste; he aquí otros dos talentos he ganado sobre ellos.", "words": [[0, 157296], [2, 157607], [11, 158087], [19, 158487], [22, 158847], [26, 159007], [32, 159227], [41, 159967], [45, 160167], [55, 160867], [61, 161738], [68, 162356], [72, 162676], [81, 163276], [84, 163609], [96, 164512], [99, 164792], [104, 165032], [110, 165312], [114, 165572], [123, 166152], [126, 166252], [133, 166592], [139, 166872]]}, {"verse": 23, "start": 168000, "end": 178110, "text": "Su señor le dijo: Bien, buen siervo y fiel; sobre poco has sido fiel, sobre mucho te pondré: entra en el gozo de tu señor.", "words": [[0, 168000], [3, 168147], [9, 168527], [12, 168807], [18, 169624], [24, 170350], [29, 170550], [36, 171130], [38, 171250], [44, 171993], [50, 172237], [55, 172547], [59, 172857], [64, 173017], [70, 173877], [76, 174137], [82, 174617], [85, 174877], [93, 175898], [99, 176481], [102, 176661], [105, 176781], [110, 177181], [113, 177321], [116, 177481]]}, {"verse": 24, "start": 178560, "end": 189486, "text": "Y llegando también el que había recibido un talento, dijo: Señor, te conocía que eres hombre duro, que siegas donde no sembraste, y recoges donde no esparciste;", "words": [[0, 178560], [2, 178664], [11, 179064], [19, 179424], [22, 179664], [26, 179824], [32, 180044], [41, 180704], [44, 180824], [53, 181384], [59, 183096], [66, 183096], [69, 183387], [77, 183717], [81, 183817], [86, 183957], [93, 184257], [99, 184957], [103, 185297], [110, 185637], [116, 185817], [119, 186077], [130, 186757], [132, 187237], [140, 187717], [146, 188177], [149, 188497]]}, {"verse": 25, "start": 189936, "end": 195808, "text": "Y tuve miedo, y fui, y escondí tu talento en la tierra: he aquí tienes lo que es tuyo.", "words": [[0, 189936], [2, 190077], [7, 190337], [14, 190737], [16, 190937], [21, 191197], [23, 191817], [31, 192417], [34, 192497], [42, 193057], [45, 193137], [48, 193237], [56, 194219], [59, 194319], [64, 194539], [71, 194879], [74, 195099], [78, 195219], [81, 195339]]}, {"verse": 26, "start": 196258, "end": 206877, "text": "Y respondiendo su señor, le dijo: Malo y negligente siervo, sabías que siego donde no sembré y que recojo donde no esparcí;", "words": [[0, 196258], [2, 196383], [15, 197163], [18, 197363], [25, 198263], [28, 198363], [34, 199246], [39, 199793], [41, 200373], [52, 200953], [60, 201973], [67, 202653], [71, 203003], [77, 203353], [83, 203573], [86, 203873], [93, 204713], [95, 204873], [99, 205013], [106, 205633], [112, 205853], [115, 206133]]}, {"verse": 27, "start": 207327, "end": 215136, "text": "Por tanto te convenía dar mi dinero a los banqueros, y viniendo yo, hubiera recibido lo que es mío con intereses.", "words": [[0, 207327], [4, 207451], [10, 207951], [13, 208071], [22, 208691], [26, 208871], [29, 209071], [36, 209431], [38, 209591], [42, 209691], [53, 210471], [55, 210871], [64, 211311], [68, 211891], [76, 212231], [85, 212971], [88, 213111], [92, 213271], [95, 213471], [99, 213871], [103, 214031]]}, {"verse": 28, "start": 215586, "end": 220674, "text": "Quitadle pues el talento, y dadlo al que tiene diez talentos.", "words": [[0, 215955], [9, 216345], [14, 216585], [17, 217005], [26, 217805], [28, 218045], [34, 218485], [37, 218705], [41, 218865], [47, 219235], [52, 219605]]}, {"verse": 29, "start": 221124, "end": 229100, "text": "Porque a cualquiera que tiene, le será dado, y tendrá más; y al que no tiene, aun lo que tiene le será quitado.", "words": [[0, 221124], [7, 221407], [9, 221567], [20, 222107], [24, 222267], [31, 222687], [34, 223047], [39, 223327], [45, 223767], [47, 224047], [54, 224447], [59, 225301], [61, 225447], [64, 225607], [68, 225767], [71, 225927], [78, 226347], [82, 226787], [85, 227087], [89, 227227], [95, 227887], [98, 228047], [103, 228347]]}, {"verse": 30, "start": 229550, "end": 237437, "text": "Y al siervo inútil echadle en las tinieblas de afuera: allí será el llanto y el crujir de dientes.", "words": [[0, 229550], [2, 229654], [5, 229774], [12, 230234], [19, 230914], [27, 231594], [30, 231834], [34, 231994], [44, 232714], [47, 232794], [55, 233707], [60, 234110], [65, 234370], [68, 234570], [75, 235210], [77, 235770], [80, 236130], [87, 236490], [90, 236650]]}, {"verse": 31, "start": 237887, "end": 248388, "text": "Y cuando el Hijo del hombre venga en su gloria, y todos los santos ángeles con él, entonces se sentará sobre el trono de su gloria.", "words": [[0, 237887], [2, 237994], [9, 238234], [12, 238494], [17, 238774], [21, 238954], [28, 239394], [34, 239754], [37, 239894], [40, 240054], [48, 241274], [50, 241514], [56, 241794], [60, 242094], [67, 242634], [75, 243134], [79, 243434], [83, 244394], [92, 244994], [95, 245594], [103, 246234], [109, 246534], [112, 246774], [118, 247234], [121, 247374], [124, 247554]]}, {"verse": 32, "start": 248838, "end": 258761, "text": "Y serán reunidas delante de él todas las naciones: y los apartará los unos de los otros, como aparta el pastor las ovejas de los cabritos.", "words": [[0, 248838], [2, 248964], [8, 249364], [17, 250024], [25, 250584], [28, 250804], [31, 250964], [37, 251344], [41, 251724], [51, 252844], [53, 252945], [57, 253065], [66, 253705], [70, 253965], [75, 254305], [78, 254625], [82, 254805], [89, 255145], [94, 255545], [101, 256185], [104, 256305], [111, 256805], [115, 257165], [122, 257705], [125, 257865], [129, 257985]]}, {"verse": 33, "start": 259211, "end": 263803, "text": "Y pondrá las ovejas a su derecha, y los cabritos a la izquierda.", "words": [[0, 259211], [2, 259333], [9, 259813], [13, 260013], [20, 260573], [22, 260733], [25, 260873], [34, 261493], [36, 261913], [40, 262053], [49, 262653], [51, 262893], [54, 262993]]}, {"verse": 34, "start": 264253, "end": 277213, "text": "Entonces el Rey dirá a los que estarán a su derecha: Venid, benditos de mi Padre, heredad el reino preparado para vosotros desde la fundación del mundo:", "words": [[0, 264253], [9, 264993], [12, 265473], [16, 266193], [21, 266613], [23, 266773], [27, 266913], [31, 267053], [39, 267493], [41, 267573], [44, 267713], [53, 268820], [60, 269265], [69, 269965], [72, 270125], [75, 270245], [82, 271465], [90, 272005], [93, 272325], [99, 272765], [109, 273485], [114, 273745], [123, 274525], [129, 275365], [132, 275745], [142, 276405], [146, 276625]]}, {"verse": 35, "start": 277663, "end": 286483, "text": "Porque tuve hambre, y me disteis de comer; tuve sed, y me disteis de beber; fui forastero, y me hospedasteis;", "words": [[0, 277663], [7, 278007], [12, 278347], [20, 278927], [22, 279367], [25, 279487], [33, 280007], [36, 280127], [43, 281223], [48, 281457], [53, 281690], [55, 282010], [58, 282110], [66, 282610], [69, 282750], [76, 283612], [80, 283816], [91, 284536], [93, 284596], [96, 284716]]}, {"verse": 36, "start": 286933, "end": 292874, "text": "Desnudo, y me cubristeis; enfermo, y me visitasteis; estuve en la cárcel, y vinisteis a mí.", "words": [[0, 286933], [9, 286933], [11, 287074], [14, 287613], [26, 288743], [35, 289023], [37, 289163], [40, 289283], [53, 290642], [60, 291009], [63, 291109], [66, 291209], [74, 291689], [76, 291909], [86, 292489], [88, 292609]]}, {"verse": 37, "start": 293324, "end": 302583, "text": "Entonces los justos le responderán, diciendo: Señor, ¿cuándo te vimos hambriento, y te sustentamos? ¿o sediento, y te dimos de beber?", "words": [[0, 293324], [9, 293924], [13, 294444], [20, 295004], [23, 295204], [36, 295924], [46, 296972], [53, 297776], [61, 297956], [64, 298196], [70, 298416], [82, 299096], [84, 299216], [87, 299336], [100, 300749], [103, 300874], [113, 301374], [115, 301534], [118, 301674], [124, 301974], [127, 302094]]}, {"verse": 38, "start": 303033, "end": 307651, "text": "¿Y cuándo te vimos forastero, y te hospedamos? ¿o desnudo, y te cubrimos?", "words": [[0, 303033], [3, 303139], [10, 303339], [13, 303579], [19, 303779], [30, 304579], [32, 304639], [35, 304759], [47, 305847], [50, 306087], [59, 306627], [61, 306747], [64, 306847]]}, {"verse": 39, "start": 308101, "end": 312545, "text": "¿O cuándo te vimos enfermo, o en la cárcel, y vinimos a ti?", "words": [[0, 308101], [3, 308249], [10, 308549], [13, 308789], [19, 309049], [28, 309809], [30, 310229], [33, 310369], [36, 310509], [44, 311029], [46, 311629], [54, 312069], [56, 312249]]}, {"verse": 40, "start": 312995, "end": 323611, "text": "Y respondiendo el Rey, les dirá: De cierto os digo que en cuanto lo hicisteis a uno de estos mis hermanos pequeñitos, a mí lo hicisteis.", "words": [[0, 312995], [2, 313200], [15, 313940], [18, 314120], [23, 314700], [27, 315042], [33, 315628], [36, 315832], [43, 316052], [46, 316472], [51, 316812], [55, 317072], [58, 317452], [65, 317772], [68, 318112], [78, 319092], [80, 319352], [84, 319532], [87, 319712], [93, 319992], [97, 320212], [106, 320832], [118, 322192], [120, 322372], [123, 322552], [126, 322712]]}, {"verse": 41, "start": 324061, "end": 334417, "text": "Entonces dirá también a los que estarán a la izquierda: Apartaos de mí, malditos, al fuego eterno preparado para el diablo y para sus ángeles:", "words": [[0, 324061], [9, 324735], [14, 325445], [22, 325845], [24, 326205], [28, 326345], [32, 326505], [40, 326965], [42, 327105], [45, 327205], [56, 328687], [65, 329047], [68, 329247], [72, 329367], [82, 330607], [85, 330927], [91, 331187], [98, 331787], [108, 332367], [113, 332547], [116, 332707], [123, 333067], [125, 333187], [130, 333387], [134, 333567]]}, {"verse": 42, "start": 334867, "end": 340806, "text": "Porque tuve hambre, y no me disteis de comer; tuve sed, y no me disteis de beber;", "words": [[0, 334867], [7, 335132], [12, 335432], [20, 335872], [22, 336172], [25, 336312], [28, 336452], [36, 337032], [39, 337172], [46, 338035], [51, 338298], [56, 338638], [58, 339038], [61, 339198], [64, 339318], [72, 339998], [75, 340402]]}, {"verse": 43, "start": 341256, "end": 350019, "text": "fui forastero, y no me hospedasteis; desnudo, y no me cubristeis; enfermo, y en la cárcel, y no me visitasteis.", "words": [[0, 341256], [4, 341491], [15, 342271], [17, 342291], [20, 342451], [23, 342591], [37, 343904], [46, 344510], [48, 344890], [51, 345010], [54, 345150], [66, 346469], [75, 347215], [77, 347535], [80, 347635], [83, 347775], [91, 348375], [93, 348715], [96, 348835], [99, 348975]]}, {"verse": 44, "start": 350469, "end": 363087, "text": "Entonces también ellos le responderán, diciendo: Señor, ¿cuándo te vimos hambriento, o sediento, o forastero, o desnudo, o enfermo, o en la cárcel, y no te servimos?", "words": [[0, 350469], [9, 351049], [17, 351349], [23, 351599], [26, 351849], [39, 352649], [49, 353983], [56, 354970], [64, 355370], [67, 355670], [73, 355930], [85, 356790], [87, 356970], [97, 357570], [99, 357730], [110, 358470], [112, 358790], [121, 359470], [123, 359730], [132, 360470], [134, 360650], [137, 360770], [140, 360910], [148, 361510], [150, 361950], [153, 362090], [156, 362230]]}, {"verse": 45, "start": 363537, "end": 374065, "text": "Entonces les responderá, diciendo: De cierto os digo que en cuanto no lo hicisteis a uno de estos pequeñitos, ni a mí lo hicisteis.", "words": [[0, 363537], [9, 364104], [13, 364764], [25, 365724], [35, 366844], [38, 367048], [45, 367308], [48, 367708], [53, 368008], [57, 368288], [60, 368688], [67, 369048], [70, 369588], [73, 369808], [83, 370688], [85, 370948], [89, 371148], [92, 371328], [98, 371548], [110, 372208], [113, 372868], [115, 373008], [118, 373088], [121, 373228]]}, {"verse": 46, "start": 374515, "end": 379491, "text": "E irán estos al castigo eterno, y los justos a la vida eterna.", "words": [[0, 374515], [2, 374632], [7, 374952], [13, 375272], [16, 375712], [24, 376272], [32, 377332], [34, 377492], [38, 377632], [45, 378212], [47, 378332], [50, 378432], [55, 378672]]}]}