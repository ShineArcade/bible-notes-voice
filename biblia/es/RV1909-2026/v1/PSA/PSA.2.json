{"book": "PSA", "chapter": 2, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 73563, "verses": [{"verse": 1, "start": 300, "end": 4598, "text": "¿Por qué se amotinan las gentes, y los pueblos piensan cosas vanas?", "words": [[0, 300], [5, 417], [9, 677], [12, 897], [21, 1517], [25, 1677], [33, 2257], [35, 2522], [39, 2662], [47, 3062], [55, 3542], [61, 3782]]}, {"verse": 2, "start": 4948, "end": 13175, "text": "Estarán los reyes de la tierra, y príncipes consultarán unidos contra Jehová, y contra su ungido, diciendo:", "words": [[0, 4948], [8, 5398], [12, 5558], [18, 5978], [21, 6118], [24, 6238], [32, 7198], [34, 7258], [44, 7923], [56, 8803], [63, 9283], [70, 9623], [78, 10423], [80, 10603], [87, 10963], [90, 11243], [98, 12223]]}, {"verse": 3, "start": 13375, "end": 17081, "text": "Rompamos sus ataduras, y echemos de nosotros sus cuerdas.", "words": [[0, 13375], [9, 13854], [13, 14034], [23, 14494], [25, 14674], [33, 14974], [36, 15114], [45, 15394], [49, 15694]]}, {"verse": 4, "start": 17361, "end": 22135, "text": "El que mora en los cielos se reirá; el Señor se burlará de ellos.", "words": [[0, 17361], [3, 17488], [7, 17668], [12, 18028], [15, 18108], [19, 18228], [26, 18788], [29, 19255], [36, 20109], [39, 20349], [45, 20589], [48, 20749], [56, 21329], [59, 21469]]}, {"verse": 5, "start": 22485, "end": 27662, "text": "Entonces hablará a ellos en su furor, y los turbará con su ira.", "words": [[0, 22485], [9, 23048], [17, 23988], [19, 24168], [25, 24448], [28, 24728], [31, 24928], [38, 25528], [40, 25828], [44, 26008], [52, 26668], [56, 26928], [59, 27168]]}, {"verse": 6, "start": 27882, "end": 32412, "text": "Pero yo he puesto mi rey sobre Sion, monte de mi santidad.", "words": [[0, 27882], [5, 28052], [8, 28292], [11, 28432], [18, 28732], [21, 29012], [25, 29432], [31, 29732], [37, 30752], [43, 31152], [46, 31392], [49, 31492]]}, {"verse": 7, "start": 32692, "end": 39441, "text": "Yo publicaré el decreto: Jehová me ha dicho: Mi hijo eres tú; yo te engendré hoy.", "words": [[0, 32692], [3, 32899], [13, 33519], [16, 33679], [25, 34598], [32, 35109], [35, 35229], [38, 35329], [45, 36060], [48, 36248], [53, 36508], [58, 36828], [62, 37799], [65, 38023], [68, 38243], [77, 38823]]}, {"verse": 8, "start": 39791, "end": 45744, "text": "Pídeme, y te daré por herencia las naciones, y por posesión tuya los confines de la tierra.", "words": [[0, 39791], [8, 40210], [10, 40470], [13, 40630], [18, 40970], [22, 41130], [31, 41570], [35, 41790], [45, 42390], [47, 42930], [51, 43130], [60, 43710], [65, 44110], [69, 44250], [78, 44810], [81, 44970], [84, 45090]]}, {"verse": 9, "start": 46094, "end": 51762, "text": "Los quebrantarás con vara de hierro: como vasija de alfarero los desmenuzarás.", "words": [[0, 46094], [4, 46664], [17, 47234], [21, 47414], [26, 47694], [29, 47874], [37, 48878], [42, 49082], [49, 49602], [52, 49742], [61, 50262], [65, 50482]]}, {"verse": 10, "start": 52042, "end": 57939, "text": "Y ahora, reyes, sean prudentes; acepten la corrección, jueces de la tierra.", "words": [[0, 52042], [2, 52192], [9, 52432], [16, 53092], [21, 53672], [32, 55111], [40, 55617], [43, 55737], [55, 56717], [62, 57077], [65, 57217], [68, 57597]]}, {"verse": 11, "start": 58289, "end": 61869, "text": "Servid a Jehová con temor, y alegraos con temblor.", "words": [[0, 58421], [7, 58595], [9, 58768], [16, 59208], [20, 59388], [27, 59888], [29, 60208], [38, 60908], [42, 61148]]}, {"verse": 12, "start": 62219, "end": 73163, "text": "Besad al Hijo, porque no se enoje, y perezcáis en el camino, cuando se encienda un poco su furor. Bienaventurados todos los que en él confían.", "words": [[0, 62402], [6, 62622], [9, 62842], [15, 63062], [22, 63402], [25, 63642], [28, 63822], [35, 64782], [37, 65042], [47, 65842], [50, 66082], [53, 66202], [61, 66722], [68, 66977], [71, 67257], [80, 67837], [83, 68037], [88, 68337], [91, 68597], [98, 69424], [114, 70793], [120, 71213], [124, 71773], [128, 72033], [131, 72213], 