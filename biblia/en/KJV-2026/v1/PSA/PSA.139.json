{"book": "PSA", "chapter": 139, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 136940, "verses": [{"verse": 1, "start": 300, "end": 3352, "text": "O LORD, you have searched me, and known me.", "words": [[0, 300], [2, 485], [8, 1065], [12, 1145], [17, 1325], [26, 1645], [30, 1945], [34, 2545], [40, 2885]]}, {"verse": 2, "start": 3802, "end": 8519, "text": "You know my downsitting and my uprising, you understand my thought afar off.", "words": [[0, 3802], [4, 3946], [9, 4086], [12, 4546], [24, 5006], [28, 5226], [31, 5406], [41, 6346], [45, 6506], [56, 6946], [59, 7306], [67, 7676], [72, 8046]]}, {"verse": 3, "start": 8969, "end": 13793, "text": "You compass my path and my lying down, and are acquainted with all my ways.", "words": [[0, 8969], [4, 9084], [12, 9404], [15, 9744], [20, 10164], [24, 10384], [27, 10544], [33, 10924], [39, 11344], [43, 11624], [47, 11764], [58, 12184], [63, 12504], [67, 12744], [70, 12944]]}, {"verse": 4, "start": 14243, "end": 19346, "text": "For there is not a word in my tongue, but, lo, O LORD, you know it altogether.", "words": [[0, 14243], [4, 14563], [10, 14703], [13, 14843], [17, 15003], [19, 15123], [24, 15343], [27, 15483], [30, 15623], [38, 16063], [43, 16663], [47, 17103], [49, 17203], [55, 17943], [59, 18063], [64, 18303], [67, 18852]]}, {"verse": 5, "start": 19796, "end": 23623, "text": "You have beset me behind and before, and laid your hand upon me.", "words": [[0, 19796], [4, 19908], [9, 20068], [15, 20488], [18, 20608], [25, 21048], [29, 21288], [37, 21688], [41, 22268], [46, 22488], [51, 22688], [56, 22948], [61, 23188]]}, {"verse": 6, "start": 24073, "end": 28680, "text": "Such knowledge is too wonderful for me; it is high, I cannot attain to it.", "words": [[0, 24073], [5, 24280], [15, 24700], [18, 24980], [22, 25160], [32, 25520], [36, 25840], [40, 26467], [43, 26576], [46, 26696], [52, 27356], [54, 27476], [61, 27776], [68, 28176], [71, 28436]]}, {"verse": 7, "start": 29130, "end": 33825, "text": "Where shall I go from your spirit? or where shall I flee from your presence?", "words": [[0, 29130], [6, 29321], [12, 29621], [14, 29841], [17, 30061], [22, 30301], [27, 30521], [35, 31493], [38, 31638], [44, 31878], [50, 32178], [52, 32358], [57, 32618], [62, 32898], [67, 33078]]}, {"verse": 8, "start": 34275, "end": 40744, "text": "If I ascend up into heaven, you are there: if I make my bed in hell, behold, you are there.", "words": [[0, 34275], [3, 34458], [5, 34658], [12, 35018], [15, 35298], [20, 35478], [28, 36038], [32, 36158], [36, 36338], [43, 37147], [46, 37307], [48, 37447], [53, 37647], [56, 37847], [60, 38127], [63, 38287], [69, 38867], [77, 39687], [81, 39947], [85, 40207]]}, {"verse": 9, "start": 41194, "end": 45262, "text": "If I take the wings of the morning, and dwell in the uttermost parts of the sea;", "words": [[0, 41194], [3, 41320], [5, 41440], [10, 41660], [14, 41840], [20, 42080], [23, 42300], [27, 42400], [36, 42720], [40, 43060], [46, 43340], [49, 43580], [53, 43680], [63, 44160], [69, 44520], [72, 44720], [76, 44840]]}, {"verse": 10, "start": 45712, "end": 49808, "text": "Even there shall your hand lead me, and your right hand shall hold me.", "words": [[0, 45712], [5, 45932], [11, 46332], [17, 46612], [22, 46852], [27, 47192], [32, 47452], [36, 47912], [40, 48232], [45, 48392], [51, 48652], [56, 48952], [62, 49172], [67, 49432]]}, {"verse": 11, "start": 50258, "end": 55156, "text": "If I say, Surely the darkness shall cover me; even the night shall be light about me.", "words": [[0, 50258], [3, 50542], [5, 50702], [10, 50942], [17, 51322], [21, 51582], [30, 51962], [36, 52262], [42, 52562], [46, 53215], [51, 53437], [55, 53617], [61, 53857], [67, 54097], [70, 54277], [76, 54537], [82, 54757]]}, {"verse": 12, "start": 55606, "end": 63194, "text": "Yes, the darkness hides not from you; but the night shines as the day: the darkness and the light are both alike to you.", "words": [[0, 55606], [5, 55975], [9, 56035], [18, 56415], [24, 56855], [28, 57195], [33, 57475], [38, 58268], [42, 58377], [46, 58517], [52, 58777], [59, 59177], [62, 59477], [66, 59637], [71, 60472], [75, 60555], [84, 60935], [88, 61255], [92, 61395], [98, 61695], [102, 61915], [107, 62155], [113, 62515], [116, 62775]]}, {"verse": 13, "start": 63644, "end": 68031, "text": "For you have formed my inward parts: you have covered me in my mother’s womb.", "words": [[0, 63644], [4, 63753], [8, 63933], [13, 64133], [20, 64373], [23, 64653], [30, 64993], [37, 66091], [41, 66224], [46, 66324], [54, 66624], [57, 66884], [60, 66984], [63, 67144], [72, 67544]]}, {"verse": 14, "start": 68481, "end": 75679, "text": "I will praise you; for I am fearfully and wonderfully made: marvellous are your works; and that my soul knows right well.", "words": [[0, 68481], [2, 68624], [7, 68764], [14, 69064], [19, 69833], [23, 69939], [25, 70139], [28, 70239], [38, 70799], [42, 70999], [54, 71359], [60, 72521], [71, 72791], [75, 72911], [80, 73051], [87, 73959], [91, 74067], [96, 74187], [99, 74327], [104, 74647], [110, 74927], [116, 75167]]}, {"verse": 15, "start": 76129, "end": 83000, "text": "My substance was not hid from you, when I was made in secret, and curiously wrought in the lowest parts of the earth.", "words": [[0, 76129], [3, 76274], [13, 76714], [17, 77054], [21, 77334], [25, 77574], [30, 77894], [35, 78114], [40, 78674], [42, 78794], [46, 78954], [51, 79214], [54, 79354], [62, 79794], [66, 80394], [76, 81114], [84, 81454], [87, 81614], [91, 81734], [98, 81954], [104, 82354], [107, 82594], [111, 82714]]}, {"verse": 16, "start": 83450, "end": 94142, "text": "Your eyes did see my substance, yet being unperfect; and in your book all my members were written, which in continuance were fashioned, when as yet there was none of them.", "words": [[0, 83450], [5, 83593], [10, 83893], [14, 84173], [18, 84473], [21, 84673], [32, 85613], [36, 85773], [42, 86053], [53, 87300], [57, 87453], [60, 87653], [65, 87853], [70, 88193], [74, 88493], [77, 88733], [85, 89073], [90, 89393], [99, 90093], [105, 90313], [108, 90453], [120, 91213], [125, 91413], [136, 92233], [141, 92413], [144, 92713], [148, 92953], [154, 93213], [158, 93393], [163, 93613], [166, 93773]]}, {"verse": 17, "start": 94592, "end": 99546, "text": "How precious also are your thoughts to me, O God! how great is the sum of them!", "words": [[0, 94592], [4, 94781], [13, 95221], [18, 95681], [22, 95961], [27, 96101], [36, 96421], [39, 96701], [43, 96941], [45, 97081], [50, 97976], [54, 98106], [60, 98426], [63, 98646], [67, 98786], [71, 99086], [74, 99266]]}, {"verse": 18, "start": 99996, "end": 105471, "text": "If I should count them, they are more in number than the sand: when I awake, I am still with you.", "words": [[0, 99996], [3, 100137], [5, 100317], [12, 100497], [18, 100777], [24, 101237], [29, 101337], [33, 101437], [38, 101677], [41, 101877], [48, 102117], [53, 102377], [57, 102537], [63, 103433], [68, 103563], [70, 103723], [77, 104363], [79, 104463], [82, 104563], [88, 104843], [93, 105143]]}, {"verse": 19, "start": 105921, "end": 111002, "text": "Surely you will slay the wicked, O God: depart from me therefore, you bloody men.", "words": [[0, 105921], [7, 106201], [11, 106481], [16, 106621], [21, 107021], [25, 107141], [33, 107741], [35, 107781], [40, 108677], [47, 109059], [52, 109239], [55, 109539], [66, 110059], [70, 110159], [77, 110459]]}, {"verse": 20, "start": 111452, "end": 115449, "text": "For they speak against you wickedly, and your enemies take your name in vain.", "words": [[0, 111452], [4, 111542], [9, 111702], [15, 112042], [23, 112362], [27, 112622], [37, 113202], [41, 113422], [46, 113582], [54, 113922], [59, 114262], [64, 114462], [69, 114722], [72, 114882]]}, {"verse": 21, "start": 115899, "end": 122634, "text": "Do not I hate them, O LORD, that hate you? and am not I grieved with those that rise up against you?", "words": [[0, 115899], [3, 115999], [7, 116239], [9, 116619], [14, 116879], [20, 117299], [22, 117439], [28, 117919], [33, 118059], [38, 118379], [43, 119095], [47, 119453], [50, 119613], [54, 119813], [56, 120073], [64, 120573], [69, 120773], [75, 121033], [80, 121273], [85, 121553], [88, 121813], [96, 122173]]}, {"verse": 22, "start": 123084, "end": 127068, "text": "I hate them with perfect hatred: I count them my enemies.", "words": [[0, 123084], [2, 123424], [7, 123664], [12, 123884], [17, 124084], [25, 124484], [33, 125481], [35, 125608], [41, 125868], [46, 126108], [49, 126328]]}, {"verse": 23, "start": 127518, "end": 132079, "text": "Search me, O God, and know my heart: try me, and know my thoughts:", "words": [[0, 127518], [7, 127838], [11, 128158], [13, 128478], [18, 129058], [22, 129158], [27, 129358], [30, 129558], [37, 130343], [41, 130586], [45, 130806], [49, 131086], [54, 131286], [57, 131486]]}, {"verse": 24, "start": 132529, "end": 136540, "text": "And see if there be any wicked way in me, and lead me in the way everlasting.", "words": [[0, 132529], [4, 132658], [8, 132898], [11, 133038], [17, 133178], [20, 133338], [24, 133578], [31, 133898], [35, 134138], [38, 134358], [42, 134518], [46, 134738], [51, 134958], [54, 135138], [57, 135298], [61, 135418], [65, 135618]]}]}