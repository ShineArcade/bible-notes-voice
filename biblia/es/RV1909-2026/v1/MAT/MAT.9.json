{"book": "MAT", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 312466, "verses": [{"verse": 1, "start": 300, "end": 5495, "text": "Entonces entrando en el barco, pasó a la otra parte, y vino a su ciudad.", "words": [[0, 300], [9, 824], [18, 1544], [21, 1704], [24, 1844], [31, 2724], [36, 3084], [38, 3224], [41, 3304], [46, 3484], [53, 3944], [55, 4284], [60, 4504], [62, 4664], [65, 4824]]}, {"verse": 2, "start": 5845, "end": 17108, "text": "Y he aquí le trajeron un paralítico, echado en una cama: y viendo Jesús la fe de ellos, dijo al paralítico: Confía, hijo; tus pecados te son perdonados.", "words": [[0, 5845], [2, 6174], [5, 6314], [10, 6574], [13, 6734], [22, 7314], [25, 7434], [37, 8394], [44, 9014], [47, 9174], [51, 9354], [57, 10152], [59, 10256], [66, 10496], [72, 11236], [75, 11316], [78, 11496], [81, 11676], [88, 12476], [93, 12876], [96, 13096], [108, 14185], [116, 14680], [122, 15379], [126, 15443], [134, 15923], [137, 16043], [141, 16203]]}, {"verse": 3, "start": 17458, "end": 22624, "text": "Y he aquí, algunos de los escribas decían dentro de sí: Este blasfema.", "words": [[0, 17458], [2, 17621], [5, 17821], [11, 18161], [19, 18681], [22, 18921], [26, 19041], [35, 19561], [42, 20041], [49, 20321], [52, 20621], [56, 21150], [61, 21411]]}, {"verse": 4, "start": 22904, "end": 28282, "text": "Y viendo Jesús sus pensamientos, dijo: ¿Por qué pensáis mal en vuestros corazones?", "words": [[0, 22904], [2, 23030], [9, 23270], [15, 23990], [19, 24090], [33, 25030], [39, 25797], [44, 25923], [48, 26083], [56, 26523], [60, 26803], [63, 26983], [72, 27403]]}, {"verse": 5, "start": 28632, "end": 34997, "text": "Porque, ¿qué es más fácil, decir: Los pecados te son perdonados; o decir: Levántate, y anda?", "words": [[0, 28702], [8, 28772], [13, 28912], [16, 29172], [20, 29332], [27, 29672], [34, 30794], [38, 30902], [46, 31222], [49, 31542], [53, 31722], [65, 32805], [67, 32921], [74, 33637], [85, 34278], [87, 34598]]}, {"verse": 6, "start": 35347, "end": 46449, "text": "Pues para que sepáis que el Hijo del hombre tiene autoridad en la tierra de perdonar pecados, (dice entonces al paralítico): Levántate, toma tu cama, y vete a tu casa.", "words": [[0, 35347], [5, 35711], [10, 36016], [14, 36176], [21, 36716], [25, 36956], [28, 37116], [33, 37376], [37, 37516], [44, 37816], [50, 38136], [60, 38916], [63, 39076], [66, 39216], [73, 39576], [76, 39796], [85, 40356], [94, 41392], [100, 41612], [109, 42012], [112, 42332], [125, 43511], [136, 44195], [141, 44355], [144, 44555], [150, 44895], [152, 45435], [157, 45715], [159, 45795], [162, 45895]]}, {"verse": 7, "start": 46799, "end": 50193, "text": "Entonces él se levantó y se fue a su casa.", "words": [[0, 46799], [9, 47762], [12, 47964], [15, 48164], [23, 48804], [25, 48969], [28, 49089], [32, 49309], [34, 49429], [37, 49589]]}, {"verse": 8, "start": 50543, "end": 57248, "text": "Y la gente, al verlo, se maravilló y glorificó a Dios, que había dado tal autoridad a los hombres.", "words": [[0, 50543], [2, 50792], [5, 50912], [12, 51232], [15, 51432], [22, 51892], [25, 52292], [35, 52912], [37, 53012], [47, 53732], [49, 53952], [55, 54672], [59, 54872], [65, 55092], [70, 55372], [74, 55632], [84, 56272], [86, 56412], [90, 56532]]}, {"verse": 9, "start": 57598, "end": 70705, "text": "Y pasando Jesús de allí, vio a un hombre que estaba sentado a la mesa de recaudación de impuestos, el cual se llamaba Mateo; y le dice: Sígueme. Y se levantó, y le siguió.", "words": [[0, 57598], [2, 57721], [10, 58121], [16, 58581], [19, 58881], [25, 59466], [29, 59826], [31, 60046], [34, 60266], [41, 60606], [45, 60766], [52, 61066], [60, 61746], [62, 61866], [65, 61966], [70, 62246], [73, 62466], [85, 63346], [88, 63586], [99, 64786], [102, 64866], [107, 65046], [110, 65226], [118, 65706], [125, 66719], [127, 66879], [130, 66919], [136, 67721], [145, 68721], [147, 68850], [150, 68950], [159, 69730], [161, 70010], [164, 70130]]}, {"verse": 10, "start": 71055, "end": 82602, "text": "Y aconteció que estando él sentado a la mesa en casa, he aquí que muchos publicanos y pecadores, que habían venido, se sentaron juntamente a la mesa con Jesús y sus discípulos.", "words": [[0, 71055], [2, 71163], [12, 71843], [16, 72063], [24, 72703], [27, 73003], [35, 73663], [37, 73803], [40, 73923], [45, 74203], [48, 74403], [54, 75003], [57, 75603], [62, 75843], [66, 76003], [73, 76223], [84, 76963], [86, 77273], [97, 77583], [101, 77783], [108, 77943], [116, 78852], [119, 78999], [128, 79479], [139, 80139], [141, 80259], [144, 80319], [149, 80519], [153, 80739], [159, 81119], [161, 81619], [165, 81779]]}, {"verse": 11, "start": 82952, "end": 90683, "text": "Y viendo esto los fariseos, dijeron a sus discípulos: ¿Por qué come vuestro Maestro con los publicanos y pecadores?", "words": [[0, 82952], [2, 83057], [9, 83377], [14, 83777], [18, 84077], [28, 84997], [36, 85857], [38, 85957], [42, 86117], [54, 87312], [59, 87458], [63, 87638], [68, 87898], [76, 88318], [84, 88798], [88, 89018], [92, 89118], [103, 89738], [105, 89898]]}, {"verse": 12, "start": 90963, "end": 98557, "text": "Y oyéndolo Jesús, les dijo: Los que están sanos no tienen necesidad de médico, sino los enfermos.", "words": [[0, 90963], [2, 91165], [11, 91765], [18, 92065], [22, 92445], [28, 93273], [32, 93401], [36, 93541], [42, 93821], [48, 94481], [51, 94721], [58, 95081], [68, 96241], [71, 96421], [79, 96981], [84, 97521], [88, 97761]]}, {"verse": 13, "start": 98907, "end": 109401, "text": "Andad pues, y aprended qué cosa es: Misericordia quiero, y no sacrificio: porque no he venido a llamar justos, sino pecadores a arrepentimiento.", "words": [[0, 99102], [6, 99322], [12, 99522], [14, 99842], [23, 100162], [27, 100482], [32, 100802], [36, 101535], [49, 102283], [57, 102683], [59, 103143], [62, 103263], [74, 104354], [81, 104620], [84, 104840], [87, 104920], [94, 105280], [96, 105380], [103, 105720], [111, 106660], [116, 106940], [126, 107620], [128, 107960]]}, {"verse": 14, "start": 109751, "end": 119333, "text": "Entonces los discípulos de Juan vienen a él, diciendo: ¿Por qué nosotros y los fariseos ayunamos muchas veces, y tus discípulos no ayunan?", "words": [[0, 109751], [9, 110197], [13, 110557], [24, 111197], [27, 111357], [32, 111637], [39, 112277], [41, 112517], [45, 112757], [55, 114182], [60, 114308], [64, 114468], [73, 114968], [75, 115208], [79, 115328], [88, 116028], [97, 116608], [104, 116848], [111, 117248], [113, 117648], [117, 117788], [128, 118448], [131, 118728]]}, {"verse": 15, "start": 119613, "end": 131760, "text": "Y Jesús les dijo: ¿Pueden los que son de bodas tener luto entre tanto que el esposo está con ellos? pero vendrán días cuando el esposo será quitado de ellos, y entonces ayunarán.", "words": [[0, 119613], [2, 119753], [8, 120133], [12, 120613], [18, 121397], [26, 121719], [30, 121839], [34, 121959], [38, 122192], [41, 122426], [47, 122659], [53, 122899], [58, 123399], [64, 123619], [70, 124019], [74, 124259], [77, 124379], [84, 124739], [89, 124919], [93, 125199], [100, 125943], [105, 126087], [113, 126567], [118, 126867], [125, 127567], [128, 127787], [135, 128147], [140, 128427], [148, 128987], [151, 129207], [158, 129527], [160, 130067], [169, 130547]]}, {"verse": 16, "start": 132110, "end": 141571, "text": "Y nadie echa remiendo de tela sin encoger en vestido viejo; porque el tal remiendo tira del vestido, y se hace peor la rotura.", "words": [[0, 132110], [2, 132248], [8, 132548], [13, 133118], [22, 133688], [25, 133888], [30, 134248], [34, 134608], [42, 135288], [45, 135508], [53, 135948], [60, 136768], [67, 137033], [70, 137293], [74, 137493], [83, 138213], [88, 138613], [92, 138813], [101, 139393], [103, 139833], [106, 139973], [111, 140213], [116, 140613], [119, 140793]]}, {"verse": 17, "start": 141921, "end": 156750, "text": "Ni echan vino nuevo en odres viejos: de otra manera los odres se rompen, y el vino se derrama, y se pierden los odres; sino que echan el vino nuevo en odres nuevos, y lo uno y lo otro se conserva juntamente.", "words": [[0, 141921], [3, 142117], [9, 142437], [14, 142897], [20, 143357], [23, 143557], [29, 143757], [37, 144920], [40, 145087], [45, 145267], [52, 145687], [56, 145947], [62, 146367], [65, 146487], [73, 147027], [75, 147527], [78, 147687], [83, 147887], [86, 148107], [95, 148647], [97, 148862], [100, 148982], [108, 149442], [112, 149602], [119, 150515], [124, 150761], [128, 151021], [134, 151501], [137, 151681], [142, 151901], [148, 152361], [151, 152741], [157, 153241], [165, 153681], [167, 154021], [170, 154181], [174, 154481], [176, 154641], [179, 154761], [184, 155001], [187, 155201], [196, 155841]]}, {"verse": 18, "start": 157100, "end": 166917, "text": "Hablando él estas cosas a ellos, he aquí vino un dirigente, y le adoraba, diciendo: Mi hija acaba de morir: pero ven y pon tu mano sobre ella, y vivirá.", "words": [[0, 157100], [9, 157468], [12, 157708], [18, 157908], [24, 158328], [26, 158588], [33, 159248], [36, 159328], [41, 159588], [46, 159928], [49, 160128], [60, 160848], [62, 161328], [65, 161468], [74, 161948], [84, 162987], [87, 163133], [92, 163433], [98, 163613], [101, 163833], [108, 164520], [113, 164664], [117, 164904], [119, 165024], [123, 165224], [126, 165344], [131, 165544], [137, 165864], [143, 166144], [145, 166344]]}, {"verse": 19, "start": 167197, "end": 171413, "text": "Y se levantó Jesús, y le siguió, y sus discípulos.", "words": [[0, 167197], [2, 167341], [5, 167441], [13, 168001], [20, 168421], [22, 168981], [25, 169121], [33, 169701], [35, 170101], [39, 170281]]}, {"verse": 20, "start": 171763, "end": 179732, "text": "Y he aquí una mujer enferma de hemorragia doce años había, llegándose por detrás, tocó la franja de su vestido:", "words": [[0, 171763], [2, 172145], [5, 172285], [10, 172505], [14, 172705], [20, 172985], [28, 173625], [31, 173765], [42, 174315], [47, 174865], [52, 175245], [59, 175705], [70, 176925], [74, 177105], [82, 177685], [87, 178245], [90, 178365], [97, 178805], [100, 178945], [103, 179105]]}, {"verse": 21, "start": 180082, "end": 185285, "text": "Porque decía entre sí: Si toco solamente su vestido, seré salva.", "words": [[0, 180082], [7, 180303], [13, 180783], [19, 181263], [23, 181899], [26, 182079], [31, 182439], [41, 182959], [44, 183379], [53, 184399], [58, 184719]]}, {"verse": 22, "start": 185565, "end": 194908, "text": "Pero Jesús volviéndose, y mirándola, dijo: Confía, hija, tu fe te ha salvado. Y la mujer fue salva desde aquella hora.", "words": [[0, 185565], [5, 185729], [11, 186549], [24, 187369], [26, 187629], [37, 188689], [43, 189536], [51, 190258], [57, 190978], [60, 191098], [63, 191278], [66, 191418], [69, 191498], [78, 192420], [80, 192506], [83, 192606], [89, 192806], [93, 193106], [99, 193566], [105, 193746], [113, 194166]]}, {"verse": 23, "start": 195258, "end": 201723, "text": "Y llegado Jesús a casa del principal, viendo los flautistas, y la gente que hacía bullicio,", "words": [[0, 195258], [2, 195362], [10, 195762], [16, 196062], [18, 196362], [23, 196662], [27, 196902], [38, 198062], [45, 198322], [49, 198582], [61, 199282], [63, 199762], [66, 199882], [72, 200142], [76, 200342], [82, 200682]]}, {"verse": 24, "start": 202073, "end": 208063, "text": "Les dice: Apartaos, que la muchacha no es muerta, sino que duerme. Y se burlaban de él.", "words": [[0, 202123], [4, 202203], [10, 203438], [20, 203958], [24, 204058], [27, 204158], [36, 204598], [39, 204798], [42, 204898], [50, 205518], [55, 205738], [59, 205938], [67, 206726], [69, 206830], [72, 206990], [81, 207530], [84, 207770]]}, {"verse": 25, "start": 208413, "end": 215273, "text": "Y como la gente fue echada fuera, entró, y la tomó de la mano, y se levantó la muchacha.", "words": [[0, 208413], [2, 208542], [7, 208762], [10, 208922], [16, 209262], [20, 209562], [27, 210272], [34, 210982], [41, 211502], [43, 212122], [46, 212242], [51, 212662], [54, 212722], [57, 212882], [63, 213282], [65, 213762], [68, 213902], [76, 214382], [79, 214502]]}, {"verse": 26, "start": 215623, "end": 219266, "text": "Y salió esta fama por toda aquella tierra.", "words": [[0, 215623], [2, 215943], [8, 216423], [13, 216803], [18, 217343], [22, 217523], [27, 217903], [35, 218503]]}, {"verse": 27, "start": 219616, "end": 228450, "text": "Y pasando Jesús de allí, le siguieron dos ciegos, dando voces y diciendo: Ten misericordia de nosotros, Hijo de David.", "words": [[0, 219616], [2, 219720], [10, 220160], [16, 220640], [19, 220940], [25, 221640], [28, 221740], [38, 222300], [42, 222540], [50, 223640], [56, 223900], [62, 224640], [64, 224880], [74, 225801], [78, 225922], [91, 226702], [94, 226822], [104, 227662], [109, 227822], [112, 228002]]}, {"verse": 28, "start": 228730, "end": 238121, "text": "Y llegado a la casa, vinieron a él los ciegos; y Jesús les dice: ¿Creéis que puedo hacer esto? Ellos dicen: Sí, Señor.", "words": [[0, 228730], [2, 228836], [10, 229256], [12, 229356], [15, 229436], [21, 229816], [30, 230716], [32, 230876], [35, 231076], [39, 231256], [47, 232221], [49, 232366], [55, 232726], [59, 233106], [65, 233883], [73, 234309], [77, 234429], [83, 234669], [89, 234969], [95, 235741], [101, 236284], [108, 237143], [112, 237570]]}, {"verse": 29, "start": 238401, "end": 244411, "text": "Entonces tocó los ojos de ellos, diciendo: Conforme a vuestra fe os sea hecho.", "words": [[0, 238401], [9, 239005], [14, 239585], [18, 239765], [23, 240065], [26, 240365], [33, 240685], [43, 241858], [52, 242442], [54, 242522], [62, 242802], [65, 243082], [68, 243362], [72, 243742]]}, {"verse": 30, "start": 244761, "end": 252910, "text": "Y los ojos de ellos fueron abiertos. Y Jesús les advirtió firmemente, diciendo: Mirad que nadie lo sepa.", "words": [[0, 244761], [2, 245022], [6, 245182], [11, 245462], [14, 245682], [20, 245902], [27, 246222], [37, 247412], [39, 247686], [45, 248106], [49, 248646], [58, 249346], [70, 250386], [80, 251358], [86, 251765], [90, 251920], [96, 252160], [99, 252380]]}, {"verse": 31, "start": 253260, "end": 257566, "text": "Pero ellos salidos, divulgaron su fama por toda aquella tierra.", "words": [[0, 253260], [5, 253404], [11, 253684], [20, 254384], [31, 255444], [34, 255604], [39, 256004], [43, 256184], [48, 256424], [56, 256864]]}, {"verse": 32, "start": 257916, "end": 262646, "text": "Y saliendo ellos, he aquí, le trajeron un hombre mudo, endemoniado.", "words": [[0, 257916], [2, 258167], [11, 258687], [18, 258947], [21, 259207], [27, 259887], [30, 259967], [39, 260587], [42, 260687], [49, 260927], [55, 261816]]}, {"verse": 33, "start": 262996, "end": 272085, "text": "Y echado fuera el demonio, el mudo habló; y la gente se maravillaba, diciendo: Nunca ha sido vista cosa semejante en Israel.", "words": [[0, 262996], [2, 263252], [9, 263652], [15, 263872], [18, 264132], [27, 264972], [30, 265092], [35, 265452], [42, 266279], [44, 266401], [47, 266521], [53, 266821], [56, 267101], [69, 267961], [79, 269203], [85, 269649], [88, 269769], [93, 269929], [99, 270209], [104, 270609], [114, 271329], [117, 271469]]}, {"verse": 34, "start": 272365, "end": 277937, "text": "Pero los fariseos decían: Por el príncipe de los demonios echa fuera los demonios.", "words": [[0, 272365], [5, 272529], [9, 272769], [18, 273569], [26, 274609], [30, 274753], [33, 274853], [42, 275433], [45, 275553], [49, 275673], [58, 276173], [63, 276673], [69, 276893], [73, 277133]]}, {"verse": 35, "start": 278217, "end": 291471, "text": "Y rodeaba Jesús por todas las ciudades y aldeas, enseñando en las sinagogas de ellos, y predicando el evangelio del reino, y sanando toda enfermedad y toda dolencia en el pueblo.", "words": [[0, 278217], [2, 278401], [10, 279101], [16, 279501], [20, 279901], [26, 280221], [30, 280481], [39, 281121], [41, 281261], [49, 282001], [59, 282881], [62, 283001], [66, 283121], [76, 283861], [79, 284021], [86, 284301], [88, 284761], [99, 285561], [102, 285721], [112, 286301], [116, 286501], [123, 287366], [125, 287470], [133, 287990], [138, 288310], [149, 289230], [151, 289370], [156, 289590], [165, 290490], [168, 290630], [171, 290770]]}, {"verse": 36, "start": 291821, "end": 300135, "text": "Y al ver las multitudes, tuvo compasión de ellas; porque estaban desamparadas y dispersas como ovejas que no tienen pastor.", "words": [[0, 291821], [2, 291944], [5, 292084], [9, 292284], [13, 292504], [25, 293144], [30, 293424], [40, 294164], [43, 294364], [50, 295127], [57, 295427], [65, 295767], [78, 296747], [80, 296907], [90, 297747], [95, 298207], [102, 298747], [106, 299007], [109, 299167], [116, 299427]]}, {"verse": 37, "start": 300485, "end": 306552, "text": "Entonces dice a sus discípulos: A la verdad la cosecha es mucha, pero los obreros pocos.", "words": [[0, 300485], [9, 301029], [14, 301669], [16, 302009], [20, 302189], [32, 303310], [34, 303420], [37, 303520], [44, 303980], [47, 304230], [55, 304480], [58, 304600], [65, 305000], [70, 305200], [74, 305380], [82, 305860]]}, {"verse": 38, "start": 306902, "end": 312066, "text": "Rogad, pues, al Señor de la cosecha, que envíe obreros a su cosecha.", "words": [[0, 307158], [7, 307448], [13, 307688], [16, 308388], [22, 308688], [25, 308868], [28, 308988], [37, 309588], [41, 310008], [47, 310488], [55, 311108], [57, 311228], [60, 311368]]}]}