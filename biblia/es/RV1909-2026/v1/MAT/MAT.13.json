{"book": "MAT", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 482167, "verses": [{"verse": 1, "start": 300, "end": 4596, "text": "Y aquel día, saliendo Jesús de casa, se sentó junto al mar.", "words": [[0, 300], [2, 445], [8, 765], [13, 1025], [22, 1645], [28, 2005], [31, 2285], [37, 3065], [40, 3245], [46, 3645], [52, 3825], [55, 4105]]}, {"verse": 2, "start": 4946, "end": 12326, "text": "Y se le juntó mucha gente; y entrando él en el barco, se sentó, y toda la gente estaba a la ribera.", "words": [[0, 4946], [2, 5054], [5, 5174], [8, 5294], [14, 5514], [20, 5954], [27, 6937], [29, 7082], [38, 7642], [41, 7982], [44, 8222], [47, 8381], [54, 8822], [57, 8982], [64, 9662], [66, 10182], [71, 10402], [74, 10622], [80, 10922], [87, 11342], [89, 11561], [92, 11622]]}, {"verse": 3, "start": 12676, "end": 19128, "text": "Y les habló muchas cosas por parábolas, diciendo: He aquí el que sembraba salió a sembrar.", "words": [[0, 12676], [2, 12801], [6, 12941], [12, 13321], [19, 13581], [25, 14121], [29, 14401], [40, 15101], [50, 16581], [53, 16661], [58, 16941], [61, 17281], [65, 17421], [74, 17941], [80, 18321], [82, 18421]]}, {"verse": 4, "start": 19478, "end": 26722, "text": "Y sembrando, parte de la semilla cayó junto al camino; y vinieron las aves, y la comieron.", "words": [[0, 19478], [2, 19815], [13, 20535], [19, 20975], [22, 21255], [25, 21395], [33, 21955], [38, 22455], [44, 22755], [47, 23015], [55, 23863], [57, 24083], [66, 24563], [70, 24823], [76, 25403], [78, 25683], [81, 25823]]}, {"verse": 5, "start": 27072, "end": 35615, "text": "Y parte cayó en pedregales, donde no tenía mucha tierra; y nació luego, porque no tenía profundidad de tierra:", "words": [[0, 27072], [2, 27169], [8, 27509], [13, 28069], [16, 28249], [28, 29529], [34, 29889], [37, 30189], [43, 30549], [49, 30849], [57, 31810], [59, 31953], [65, 32333], [72, 32733], [79, 33053], [82, 33343], [88, 33633], [100, 34653], [103, 35141]]}, {"verse": 6, "start": 35965, "end": 40759, "text": "Pero al salir el sol, se quemó; y se secó, porque no tenía raíz.", "words": [[0, 35965], [5, 36108], [8, 36268], [14, 36588], [17, 36788], [22, 37108], [25, 37348], [32, 38152], [34, 38232], [37, 38352], [43, 38852], [50, 39272], [53, 39492], [59, 39892]]}, {"verse": 7, "start": 41109, "end": 46021, "text": "Y parte cayó en espinas; y las espinas crecieron, y la ahogaron.", "words": [[0, 41109], [2, 41253], [8, 41553], [13, 42233], [16, 42453], [25, 43401], [27, 43524], [31, 43644], [39, 44064], [50, 44784], [52, 45024], [55, 45164]]}, {"verse": 8, "start": 46371, "end": 51664, "text": "Y parte cayó en buena tierra, y dio fruto, cuál a ciento, cuál a sesenta, y cuál a treinta.", "words": [[0, 46371], [2, 46472], [8, 46672], [13, 47072], [16, 47152], [22, 47312], [30, 47632], [32, 47902], [36, 48172], [43, 48592], [48, 48919], [50, 49245], [58, 49572], [63, 49865], [65, 50159], [74, 50452], [76, 50692], [81, 51028], [83, 51365]]}, {"verse": 9, "start": 52014, "end": 54392, "text": "Quien tiene oídos para oír, oiga.", "words": [[0, 52014], [6, 52160], [12, 52500], [18, 52960], [23, 53160], [28, 53980]]}, {"verse": 10, "start": 54742, "end": 60434, "text": "Entonces, acercándose los discípulos, le dijeron: ¿Por qué les hablas por parábolas?", "words": [[0, 54742], [10, 55750], [22, 56510], [26, 56710], [38, 57390], [41, 57730], [50, 58624], [55, 58768], [59, 58968], [63, 59108], [70, 59488], [74, 59688]]}, {"verse": 11, "start": 60714, "end": 69992, "text": "Y él respondiendo, les dijo: Porque a vosotros es concedido saber los misterios del reino de los cielos; pero a ellos no es concedido.", "words": [[0, 60714], [2, 60899], [5, 61099], [19, 62179], [23, 62359], [29, 63116], [36, 63548], [38, 63688], [47, 64128], [50, 64308], [60, 65048], [66, 65308], [70, 65588], [80, 66228], [84, 66408], [90, 66788], [93, 66908], [97, 67048], [105, 67965], [110, 68108], [112, 68288], [118, 68528], [121, 68988], [124, 69168]]}, {"verse": 12, "start": 70342, "end": 77972, "text": "Porque a cualquiera que tiene, se le dará, y tendrá más; pero al que no tiene, aun lo que tiene le será quitado.", "words": [[0, 70342], [7, 70628], [9, 70748], [20, 71268], [24, 71408], [31, 71828], [34, 72368], [37, 72548], [43, 73228], [45, 73468], [52, 73848], [57, 74518], [62, 74662], [65, 74802], [69, 74962], [72, 75102], [79, 75802], [83, 76022], [86, 76282], [90, 76422], [96, 76762], [99, 76962], [104, 77202]]}, {"verse": 13, "start": 78322, "end": 85755, "text": "Por eso les hablo por parábolas; porque viendo no ven, y oyendo no oyen, ni entienden.", "words": [[0, 78322], [4, 78467], [8, 78747], [12, 79072], [18, 79632], [22, 79852], [33, 81053], [40, 81275], [47, 81655], [50, 81935], [55, 82255], [57, 82955], [64, 83395], [67, 83675], [73, 84295], [76, 84915]]}, {"verse": 14, "start": 86105, "end": 95554, "text": "De manera que se cumple en ellos la profecía de Isaías, que dice: De oído oiréis, y no entenderéis; y viendo veréis, y no miraréis.", "words": [[0, 86105], [3, 86230], [10, 86470], [14, 86750], [17, 86910], [24, 87470], [27, 87670], [33, 87910], [36, 88130], [45, 88770], [48, 88910], [56, 89530], [60, 89730], [66, 90317], [69, 90617], [74, 91017], [82, 91677], [84, 91937], [87, 92117], [100, 93350], [102, 93474], [109, 93794], [117, 94374], [119, 94649], [122, 94789]]}, {"verse": 15, "start": 95904, "end": 109736, "text": "Porque el corazón de este pueblo se ha vuelto insensible, y oyen con dificultad, y han cerrado sus ojos: para que no vean con los ojos, ni oigan con los oídos, ni entiendan con el corazón, y se conviertan, y yo los sane.", "words": [[0, 95904], [7, 96105], [10, 96245], [18, 96625], [21, 96885], [26, 97025], [33, 97305], [36, 97565], [39, 97685], [46, 98045], [58, 98945], [60, 99225], [65, 99565], [69, 99705], [81, 100565], [83, 100765], [87, 101175], [95, 101585], [99, 101785], [105, 102653], [110, 102797], [114, 102957], [117, 103117], [122, 103397], [126, 103537], [130, 103717], [136, 104149], [139, 104580], [145, 105012], [149, 105272], [153, 105472], [160, 105942], [163, 106412], [173, 107072], [177, 107192], [180, 107352], [189, 107772], [191, 107952], [194, 108032], [206, 108732], [208, 108892], [211, 109022], [215, 109152]]}, {"verse": 16, "start": 110086, "end": 115004, "text": "Pero bienaventurados vuestros ojos, porque ven; y vuestros oídos, porque oyen.", "words": [[0, 110086], [5, 110560], [21, 111070], [30, 111490], [36, 112170], [43, 112490], [48, 113153], [50, 113261], [59, 113621], [66, 114081], [73, 114401]]}, {"verse": 17, "start": 115354, "end": 125315, "text": "Porque de cierto os digo, que muchos profetas y justos desearon ver lo que veis, y no lo vieron: y oír lo que oís, y no lo oyeron.", "words": [[0, 115354], [7, 115581], [10, 115761], [17, 116121], [20, 116481], [26, 117121], [30, 117441], [37, 117701], [46, 118341], [48, 118521], [55, 119241], [64, 120001], [68, 120201], [71, 120441], [75, 120601], [81, 121101], [83, 121381], [86, 121561], [89, 121701], [97, 122597], [99, 122783], [103, 123063], [106, 123283], [110, 123443], [115, 123883], [117, 124203], [120, 124403], [123, 124583]]}, {"verse": 18, "start": 125665, "end": 129114, "text": "Oíd, pues, vosotros la parábola del que siembra:", "words": [[0, 125832], [5, 126012], [11, 126312], [20, 127157], [23, 127557], [32, 128097], [36, 128297], [40, 128457]]}, {"verse": 19, "start": 129464, "end": 141515, "text": "Oyendo cualquiera la palabra del reino, y no entendiéndola, viene el malo, y arrebata lo que fue sembrado en su corazón: este es el que fue sembrado junto al camino.", "words": [[0, 129618], [7, 129808], [18, 130408], [21, 130588], [29, 130948], [33, 131228], [40, 132148], [42, 132388], [45, 132528], [60, 133928], [66, 134268], [69, 134568], [75, 135248], [77, 135708], [86, 136168], [89, 136268], [93, 136368], [97, 136528], [106, 137128], [109, 137248], [112, 137408], [121, 138451], [126, 138777], [129, 139117], [132, 139397], [136, 139537], [140, 139737], [149, 140357], [155, 140577], [158, 140837]]}, {"verse": 20, "start": 141865, "end": 149539, "text": "Y el que fue sembrado en pedregales, este es el que oye la palabra, y luego la recibe con gozo.", "words": [[0, 141865], [2, 142065], [5, 142165], [9, 142285], [13, 142465], [22, 143065], [25, 143225], [37, 144885], [42, 145185], [45, 145345], [48, 145505], [52, 145665], [56, 145985], [59, 146125], [68, 147265], [70, 147605], [76, 147825], [79, 148105], [86, 148605], [90, 148845]]}, {"verse": 21, "start": 149889, "end": 158944, "text": "Pero no tiene raíz en sí, sino que dura poco: que venida la aflicción o la persecución por la palabra, enseguida tropieza.", "words": [[0, 149889], [5, 150032], [8, 150192], [14, 150432], [19, 150972], [22, 151172], [26, 151832], [31, 152152], [35, 152352], [40, 152552], [46, 153501], [50, 153605], [57, 153985], [60, 154145], [70, 155005], [72, 155265], [75, 155385], [87, 156185], [91, 156385], [94, 156585], [103, 157505], [113, 158065]]}, {"verse": 22, "start": 159294, "end": 170878, "text": "Y el que fue sembrado en espinas, este es el que oye la palabra; pero el afán de este siglo y el engaño de las riquezas, ahogan la palabra, y se hace infructuosa.", "words": [[0, 159294], [2, 159443], [5, 159523], [9, 159643], [13, 159823], [22, 160423], [25, 160523], [34, 161803], [39, 162243], [42, 162483], [45, 162643], [49, 162823], [53, 163103], [56, 163243], [65, 164134], [70, 164298], [73, 164458], [78, 164818], [81, 164918], [86, 165078], [92, 165558], [94, 165738], [97, 165858], [104, 166358], [107, 166478], [111, 166638], [121, 167398], [128, 168198], [131, 168418], [140, 168878], [142, 169343], [145, 169483], [150, 169743]]}, {"verse": 23, "start": 171228, "end": 183164, "text": "Pero el que fue sembrado en buena tierra, este es el que oye y entiende la palabra, y el que lleva fruto: y lleva uno a ciento, y otro a sesenta, y otro a treinta.", "words": [[0, 171228], [5, 171391], [8, 171531], [12, 171671], [16, 171871], [25, 172531], [28, 172651], [34, 172871], [42, 173871], [47, 174171], [50, 174451], [53, 174611], [57, 174791], [61, 175211], [63, 175391], [72, 175931], [75, 176111], [84, 176891], [86, 177171], [89, 177301], [93, 177431], [99, 177731], [106, 178673], [108, 178800], [114, 179060], [118, 179320], [120, 179540], [128, 179900], [130, 180580], [135, 180860], [137, 181100], [146, 181780], [148, 182000], [153, 182240], [155, 182440]]}, {"verse": 24, "start": 183514, "end": 191399, "text": "Otra parábola les refirió, diciendo: El reino de los cielos es semejante al hombre que siembra buena semilla en su campo:", "words": [[0, 183514], [5, 183861], [14, 184361], [18, 184801], [27, 185241], [37, 186254], [40, 186502], [46, 186882], [49, 186982], [53, 187122], [60, 187582], [63, 188052], [73, 188522], [76, 188682], [83, 188902], [87, 189102], [95, 189602], [101, 189782], [109, 190382], [112, 190562], [115, 190722]]}, {"verse": 25, "start": 191749, "end": 196840, "text": "Pero durmiendo los hombres, vino su enemigo, y sembró cizaña entre el trigo, y se fue.", "words": [[0, 191749], [5, 191894], [15, 192394], [19, 192574], [28, 193354], [33, 193674], [36, 193894], [45, 194354], [47, 194454], [54, 194874], [61, 195414], [67, 195674], [70, 195854], [77, 196234], [79, 196354], [82, 196454]]}, {"verse": 26, "start": 197190, "end": 202897, "text": "Y como la hierba salió e hizo fruto, entonces apareció también la cizaña.", "words": [[0, 197190], [2, 197494], [7, 197714], [10, 197874], [17, 198334], [23, 198874], [25, 199254], [30, 199494], [37, 200374], [46, 200714], [55, 201554], [63, 201914], [66, 202431]]}, {"verse": 27, "start": 203247, "end": 212978, "text": "Y llegándose los siervos del padre de la familia, le dijeron: Señor, ¿no sembraste buena semilla en tu campo? ¿de dónde, pues, tiene cizaña?", "words": [[0, 203247], [2, 203350], [13, 203950], [17, 204130], [25, 204610], [29, 204810], [35, 205190], [38, 205410], [41, 205550], [50, 206450], [53, 206690], [62, 207632], [69, 208354], [73, 208474], [83, 208887], [89, 209301], [97, 209714], [100, 209794], [103, 209914], [110, 210767], [114, 210913], [121, 211353], [127, 211906], [133, 212459]]}, {"verse": 28, "start": 213328, "end": 221729, "text": "Y él les dijo: Un hombre enemigo ha hecho esto. Y los siervos le dijeron: ¿Quieres, pues, que vayamos y la arranquemos?", "words": [[0, 213328], [2, 213513], [5, 213713], [9, 214073], [15, 214866], [18, 215009], [25, 215329], [33, 215989], [36, 216229], [42, 216469], [48, 217261], [50, 217382], [54, 217522], [62, 218022], [65, 218362], [74, 219400], [84, 219566], [90, 219733], [94, 220128], [102, 220568], [104, 220748], [107, 221239]]}, {"verse": 29, "start": 222079, "end": 228070, "text": "Y él dijo: No; porque cogiendo la cizaña, no arranquéis también con ella el trigo.", "words": [[0, 222079], [2, 222234], [5, 222354], [11, 223031], [15, 223586], [22, 223809], [31, 224329], [34, 224719], [42, 225109], [45, 225609], [56, 226409], [64, 226709], [68, 227069], [73, 227289], [76, 227509]]}, {"verse": 30, "start": 228420, "end": 243632, "text": "Dejad crecer juntamente lo uno y lo otro hasta la siega; y al tiempo de la siega yo diré a los segadores: Recoged primero la cizaña, y atadla en manojos para quemarla; pero recoged el trigo en mi granero.", "words": [[0, 228420], [6, 228825], [13, 229325], [24, 230165], [27, 230365], [31, 230665], [33, 230885], [36, 231025], [41, 231365], [47, 231565], [50, 231982], [57, 232548], [59, 232654], [62, 232794], [69, 233114], [72, 233354], [75, 233584], [81, 233814], [84, 233994], [89, 234354], [91, 234454], [95, 235029], [106, 236028], [114, 236328], [122, 236728], [125, 237178], [133, 237628], [135, 238068], [142, 238688], [145, 238948], [153, 239648], [158, 239843], [168, 240840], [173, 241027], [181, 241727], [184, 241967], [190, 242427], [193, 242846], [196, 243266]]}, {"verse": 31, "start": 243982, "end": 253946, "text": "Otra parábola les refirió, diciendo: El reino de los cielos es semejante al grano de mostaza, que tomándolo alguno lo sembró en su campo:", "words": [[0, 243982], [5, 244329], [14, 244829], [18, 245269], [27, 245709], [37, 246722], [40, 246869], [46, 247349], [49, 247469], [53, 247609], [60, 248149], [63, 248649], [73, 249149], [76, 249329], [82, 249729], [85, 249869], [94, 250869], [98, 251029], [108, 251749], [115, 252409], [118, 252529], [125, 253029], [128, 253109], [131, 253269]]}, {"verse": 32, "start": 254296, "end": 268105, "text": "El cual a la verdad es la más pequeña de todas las semillas; pero cuando ha crecido, es la mayor de las hortalizas, y se hace árbol, que vienen las aves del cielo y hacen nidos en sus ramas.", "words": [[0, 254296], [3, 254463], [8, 254703], [10, 255023], [13, 255123], [20, 255363], [23, 255803], [26, 256123], [30, 256423], [38, 256923], [41, 257323], [47, 257623], [51, 257943], [61, 258980], [66, 259109], [73, 259349], [76, 259549], [85, 260029], [88, 260149], [91, 260269], [97, 260529], [100, 260709], [104, 260849], [116, 261709], [118, 262389], [121, 262549], [126, 262809], [133, 263489], [137, 263929], [144, 264369], [148, 264509], [153, 264849], [157, 265009], [163, 265489], [165, 265834], [171, 266094], [177, 266774], [180, 267094], [184, 267294]]}, {"verse": 33, "start": 268455, "end": 280247, "text": "Otra parábola les dijo: El reino de los cielos es semejante a la levadura que tomó una mujer, y escondió en tres medidas de harina, hasta que todo quedó fermentado.", "words": [[0, 268455], [5, 268842], [14, 269402], [18, 269642], [24, 270392], [27, 270571], [33, 270991], [36, 271131], [40, 271271], [47, 271931], [50, 272151], [60, 272991], [62, 273131], [65, 273251], [74, 273791], [78, 273971], [83, 274351], [87, 274511], [94, 274891], [96, 275391], [105, 276091], [108, 276411], [113, 276731], [121, 277411], [124, 277631], [132, 278451], [138, 278631], [142, 278811], [147, 279011], [153, 279371]]}, {"verse": 34, "start": 280597, "end": 286070, "text": "Todo esto habló Jesús por parábolas a la gente, y sin parábolas no les hablaba:", "words": [[0, 280597], [5, 280759], [10, 281059], [16, 281439], [22, 281699], [26, 282079], [36, 282759], [38, 282979], [41, 283039], [48, 283499], [50, 283754], [54, 283954], [64, 284794], [67, 285194], [71, 285414]]}, {"verse": 35, "start": 286420, "end": 296176, "text": "Para que se cumpliese lo que fue dicho por el profeta, que dijo: Abriré en parábolas mi boca; declararé cosas escondidas desde la fundación del mundo.", "words": [[0, 286420], [5, 286858], [9, 286998], [12, 287138], [22, 287698], [25, 287898], [29, 287998], [33, 288158], [39, 288418], [43, 288678], [46, 288798], [55, 289318], [59, 289478], [65, 290210], [72, 290810], [75, 291140], [85, 291470], [88, 291670], [94, 292411], [104, 293055], [110, 293335], [121, 294235], [127, 294675], [130, 294895], [140, 295375], [144, 295595]]}, {"verse": 36, "start": 296526, "end": 307905, "text": "Entonces, despedida la gente, Jesús entró en la casa; y acercándose a él sus discípulos, le dijeron: Decláranos la parábola de la cizaña del campo.", "words": [[0, 296526], [10, 297389], [20, 298149], [23, 298269], [30, 299289], [36, 299709], [42, 300429], [45, 300509], [48, 300649], [54, 301482], [56, 301591], [68, 302471], [70, 302751], [73, 303131], [77, 303271], [89, 304051], [92, 304351], [101, 305487], [112, 305807], [115, 305967], [124, 306487], [127, 306647], [130, 306937], [137, 307227], [141, 307347]]}, {"verse": 37, "start": 308185, "end": 314346, "text": "Y respondiendo él, les dijo: El que siembra la buena semilla es el Hijo del hombre;", "words": [[0, 308185], [2, 308309], [15, 309149], [19, 309569], [23, 310049], [29, 310873], [32, 310999], [36, 311099], [44, 311579], [47, 311679], [53, 311899], [61, 312499], [64, 312919], [67, 313099], [72, 313479], [76, 313739]]}, {"verse": 38, "start": 314696, "end": 322073, "text": "Y el campo es el mundo; y la buena semilla son los hijos del reino, y la cizaña son los hijos del malo;", "words": [[0, 314696], [2, 314835], [5, 314975], [11, 315335], [14, 315535], [17, 315675], [24, 316568], [26, 316677], [29, 316797], [35, 316997], [43, 317537], [47, 317777], [51, 317977], [57, 318237], [61, 318497], [68, 319217], [70, 319657], [73, 320097], [80, 320537], [84, 320817], [88, 321017], [94, 321277], [98, 321517]]}, {"verse": 39, "start": 322423, "end": 330170, "text": "Y el enemigo que la sembró, es el diablo; y la siega es el fin del mundo, y los segadores son los ángeles.", "words": [[0, 322423], [2, 322550], [5, 322690], [13, 323230], [17, 323390], [20, 323510], [28, 324270], [31, 324630], [34, 324810], [42, 325694], [44, 325795], [47, 326135], [53, 326475], [56, 326680], [59, 326840], [63, 327040], [67, 327200], [74, 327640], [76, 328200], [80, 328620], [90, 329040], [94, 329380], [98, 329540]]}, {"verse": 40, "start": 330520, "end": 337335, "text": "De manera que como es cogida la cizaña, y quemada al fuego, así será en el fin de este siglo.", "words": [[0, 330520], [3, 330625], [10, 330825], [14, 331065], [19, 331305], [22, 331525], [29, 332005], [32, 332395], [40, 332785], [42, 333205], [50, 333605], [53, 333805], [60, 334605], [64, 334805], [69, 335245], [72, 335745], [75, 335905], [79, 336185], [82, 336425], [87, 336645]]}, {"verse": 41, "start": 337685, "end": 346774, "text": "Enviará el Hijo del hombre sus ángeles, y recogerán de su reino todas las causas de tropiezo, y los que hacen iniquidad,", "words": [[0, 337685], [8, 338189], [11, 338349], [16, 338629], [20, 338789], [27, 339189], [31, 339329], [40, 340529], [42, 340769], [52, 341589], [55, 341729], [58, 341929], [64, 342409], [70, 342729], [74, 343049], [81, 343589], [84, 343709], [94, 344449], [96, 344929], [100, 345069], [104, 345249], [110, 345589]]}, {"verse": 42, "start": 347124, "end": 353388, "text": "Y los echarán en el horno de fuego: allí será el llanto y el crujir de dientes.", "words": [[0, 347204], [2, 347684], [6, 347844], [14, 348484], [17, 348744], [20, 348904], [26, 349304], [29, 349444], [36, 350307], [41, 350760], [46, 350960], [49, 351100], [56, 351540], [58, 351720], [61, 352060], [68, 352400], [71, 352560]]}, {"verse": 43, "start": 353738, "end": 362003, "text": "Entonces los justos resplandecerán como el sol en el reino de su Padre: el que tiene oídos para oír, oiga.", "words": [[0, 353738], [9, 354466], [13, 355126], [20, 355866], [35, 357046], [40, 357306], [43, 357526], [47, 357786], [50, 358126], [53, 358286], [59, 358686], [62, 358826], [65, 358986], [72, 359798], [75, 359905], [79, 360025], [85, 360305], [91, 360765], [96, 360985], [101, 361495]]}, {"verse": 44, "start": 362353, "end": 377376, "text": "Además, el reino de los cielos es semejante al tesoro escondido en el campo; el cual hallado, el hombre lo encubre, y de gozo de ello va, y vende todo lo que tiene, y compra aquel campo.", "words": [[0, 362353], [8, 363316], [11, 363676], [17, 364116], [20, 364236], [24, 364396], [31, 365016], [34, 365236], [44, 366196], [47, 366556], [54, 367196], [64, 367996], [67, 368116], [70, 368276], [77, 369237], [80, 369402], [85, 369682], [94, 370342], [97, 370482], [104, 370742], [107, 371365], [116, 371987], [118, 372067], [121, 372247], [126, 372587], [129, 372807], [134, 373027], [138, 373867], [140, 373927], [146, 374327], [151, 374587], [154, 374827], [158, 374947], [165, 375807], [167, 375887], [174, 376287], [180, 376667]]}, {"verse": 45, "start": 377726, "end": 383912, "text": "También el reino de los cielos es semejante a un comerciante, que busca buenas perlas;", "words": [[0, 377726], [8, 378052], [11, 378372], [17, 378792], [20, 378912], [24, 379052], [31, 379672], [34, 379952], [44, 380792], [46, 380912], [49, 381032], [62, 381872], [66, 382332], [72, 382632], [79, 383312]]}, {"verse": 46, "start": 384262, "end": 389258, "text": "Que hallando una preciosa perla, fue y vendió todo lo que tenía, y la compró.", "words": [[0, 384262], [4, 384445], [13, 384725], [17, 384905], [26, 385425], [33, 386045], [37, 386145], [39, 386465], [46, 386905], [51, 387305], [54, 387565], [58, 387685], [65, 388045], [67, 388545], [70, 388665]]}, {"verse": 47, "start": 389608, "end": 397733, "text": "Asimismo el reino de los cielos es semejante a la red, que echada en el mar, recoge de toda clase de peces:", "words": [[0, 389608], [9, 390275], [12, 390375], [18, 390755], [21, 390875], [25, 391035], [32, 391695], [35, 392185], [45, 392675], [47, 392835], [50, 392935], [55, 393215], [59, 393755], [66, 394175], [69, 394315], [72, 394455], [77, 394735], [84, 395975], [87, 396115], [92, 396375], [98, 396735], [101, 397075]]}, {"verse": 48, "start": 398083, "end": 406932, "text": "La cual estando llena, la sacaron a la orilla; y sentados, cogieron lo bueno en cestas, y lo malo echaron fuera.", "words": [[0, 398083], [3, 398211], [8, 398644], [16, 399078], [23, 399511], [26, 400051], [34, 400591], [36, 400691], [39, 400831], [47, 401633], [49, 401777], [59, 402477], [68, 403237], [71, 403457], [77, 403717], [80, 403937], [88, 404697], [90, 405297], [93, 405437], [98, 405757], [106, 406177]]}, {"verse": 49, "start": 407282, "end": 414642, "text": "Así será al fin del siglo: saldrán los ángeles, y apartarán a los malos de entre los justos,", "words": [[0, 407282], [4, 407486], [9, 407886], [12, 408206], [16, 408446], [20, 408962], [27, 409646], [35, 410432], [39, 410612], [48, 411272], [50, 411672], [60, 412472], [62, 412632], [66, 412772], [72, 413332], [75, 413552], [81, 413852], [85, 414072]]}, {"verse": 50, "start": 414992, "end": 420621, "text": "Y los echarán en el horno del fuego: allí será el llanto y el crujir de dientes.", "words": [[0, 414992], [2, 415116], [6, 415256], [14, 415876], [17, 416116], [20, 416276], [26, 416576], [30, 416736], [37, 417541], [42, 417993], [47, 418193], [50, 418333], [57, 418773], [59, 418953], [62, 419293], [69, 419633], [72, 419793]]}, {"verse": 51, "start": 420971, "end": 427677, "text": "Les dice Jesús: ¿Habéis entendido todas estas cosas? Ellos responden: Sí, Señor.", "words": [[0, 420971], [4, 421195], [9, 421555], [16, 422529], [24, 422976], [34, 423656], [40, 423856], [46, 424216], [53, 425465], [59, 425635], [70, 426698], [74, 427126]]}, {"verse": 52, "start": 427957, "end": 438362, "text": "Y él les dijo: Por eso todo escriba instruido en el reino de los cielos, es semejante a un padre de familia, que saca de su tesoro cosas nuevas y cosas viejas.", "words": [[0, 427957], [2, 428142], [5, 428342], [9, 428702], [15, 429495], [19, 429601], [23, 429821], [28, 430101], [36, 430701], [46, 431301], [49, 431441], [52, 431601], [58, 431981], [61, 432101], [65, 432241], [73, 433101], [76, 433381], [86, 433941], [88, 434041], [91, 434141], [97, 434401], [100, 434621], [109, 435161], [113, 435381], [118, 435741], [121, 435821], [124, 435961], [131, 436441], [137, 436736], [144, 437116], [146, 437376], [152, 437536]]}, {"verse": 53, "start": 438712, "end": 443262, "text": "Y aconteció que acabando Jesús estas parábolas, pasó de allí.", "words": [[0, 438712], [2, 438871], [12, 439611], [16, 439831], [25, 440291], [31, 440691], [37, 441171], [48, 442091], [53, 442511], [56, 442771]]}, {"verse": 54, "start": 443612, "end": 455100, "text": "Y venido a su tierra, les enseñaba en la sinagoga de ellos, de tal manera que ellos estaban atónitos, y decían: ¿De dónde tiene este esta sabiduría, y estas maravillas?", "words": [[0, 443612], [2, 443721], [9, 444101], [11, 444221], [14, 444341], [22, 444821], [26, 445341], [35, 446101], [38, 446221], [41, 446321], [50, 446941], [53, 447161], [60, 447761], [63, 447981], [67, 448241], [74, 448601], [78, 448881], [84, 449121], [92, 449561], [102, 450581], [104, 450901], [112, 451847], [116, 451990], [122, 452110], [128, 452330], [133, 452550], [138, 452850], [149, 453850], [151, 454030], [157, 454230]]}, {"verse": 55, "start": 455450, "end": 462298, "text": "¿No es este el hijo del carpintero? ¿no se llama su madre María, y sus hermanos Jacobo y José, y Simón, y Judas?", "words": [[0, 455450], [4, 455596], [7, 455816], [12, 456136], [15, 456296], [20, 456476], [24, 456616], [36, 457659], [40, 457782], [43, 457902], [49, 458122], [52, 458302], [58, 458542], [65, 458962], [67, 459382], [71, 459502], [80, 459982], [87, 460442], [89, 460502], [95, 460762], [97, 461102], [104, 461542], [106, 461722]]}, {"verse": 56, "start": 462648, "end": 467448, "text": "¿Y no están todas sus hermanas con nosotros? ¿De dónde, pues, tiene este todas estas cosas?", "words": [[0, 462648], [3, 462744], [6, 462864], [12, 463064], [18, 463344], [22, 463624], [31, 463984], [35, 464204], [45, 465108], [49, 465253], [56, 465553], [62, 465805], [68, 466056], [73, 466308], [79, 466508], [85, 466768]]}, {"verse": 57, "start": 467728, "end": 475737, "text": "Y se escandalizaban en él. Pero Jesús les dijo: No hay profeta sin honra sino en su tierra y en su casa.", "words": [[0, 467728], [2, 467874], [5, 468074], [20, 469134], [23, 469314], [27, 469885], [32, 470029], [38, 470449], [42, 470949], [48, 471704], [51, 471831], [55, 471991], [63, 472551], [67, 472791], [73, 473531], [78, 473731], [81, 473971], [84, 474071], [91, 474531], [93, 474791], [96, 474931], [99, 475091]]}, {"verse": 58, "start": 476087, "end": 481767, "text": "Y no hizo allí muchas maravillas, a causa de la incredulidad de ellos.", "words": [[0, 476087], [2, 476211], [5, 476411], [10, 476691], [15, 476971], [22, 477311], [34, 478671], [36, 478771], [42, 479171], [45, 479471], [48, 479591], [61, 480751], [64, 481051]]}]}