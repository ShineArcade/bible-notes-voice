{"book": "MAT", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 481712, "verses": [{"verse": 1, "start": 300, "end": 4596, "text": "Y aquel día, saliendo Jesús de casa, se sentó junto al mar.", "words": [[0, 300], [2, 445], [8, 765], [13, 1025], [22, 1645], [28, 2005], [31, 2285], [37, 3065], [40, 3245], [46, 3645], [52, 3825], [55, 4105]]}, {"verse": 2, "start": 4946, "end": 12326, "text": "Y se le juntó mucha gente; y entrando él en el barco, se sentó, y toda la gente estaba a la ribera.", "words": [[0, 4946], [2, 5054], [5, 5174], [8, 5294], [14, 5514], [20, 5954], [27, 6937], [29, 7082], [38, 7642], [41, 7982], [44, 8222], [47, 8381], [54, 8822], [57, 8982], [64, 9662], [66, 10182], [71, 10402], [74, 10622], [80, 10922], [87, 11342], [89, 11561], [92, 11622]]}, {"verse": 3, "start": 12676, "end": 19128, "text": "Y les habló muchas cosas por parábolas, diciendo: He aquí el que sembraba salió a sembrar.", "words": [[0, 12676], [2, 12801], [6, 12941], [12, 13321], [19, 13581], [25, 14121], [29, 14401], [40, 15101], [50, 16581], [53, 16661], [58, 16941], [61, 17281], [65, 17421], [74, 17941], [80, 18321], [82, 18421]]}, {"verse": 4, "start": 19478, "end": 26955, "text": "Y sembrando, parte de la semilla cayó junto al camino; y vinieron las aves, y la comieron.", "words": [[0, 19478], [2, 19815], [13, 20535], [19, 20975], [22, 21255], [25, 21395], [33, 21955], [38, 22455], [44, 22755], [47, 23015], [55, 24083], [57, 24303], [66, 24783], [70, 25043], [76, 25623], [78, 25903], [81, 26043]]}, {"verse": 5, "start": 27305, "end": 35847, "text": "Y parte cayó en pedregales, donde no tenía mucha tierra; y nació luego, porque no tenía profundidad de tierra:", "words": [[0, 27305], [2, 27401], [8, 27741], [13, 28301], [16, 28481], [28, 29761], [34, 30121], [37, 30421], [43, 30781], [49, 31081], [57, 32043], [59, 32186], [65, 32566], [72, 32966], [79, 33286], [82, 33576], [88, 33866], [100, 34886], [103, 35374]]}, {"verse": 6, "start": 36197, "end": 40982, "text": "Pero al salir el sol, se quemó; y se secó, porque no tenía raíz.", "words": [[0, 36197], [5, 36341], [8, 36501], [14, 36821], [17, 37021], [22, 37341], [25, 37581], [32, 38375], [34, 38455], [37, 38575], [43, 39075], [50, 39495], [53, 39715], [59, 40115]]}, {"verse": 7, "start": 41332, "end": 46244, "text": "Y parte cayó en espinas; y las espinas crecieron, y la ahogaron.", "words": [[0, 41332], [2, 41476], [8, 41776], [13, 42456], [16, 42676], [25, 43624], [27, 43747], [31, 43867], [39, 44287], [50, 45007], [52, 45247], [55, 45387]]}, {"verse": 8, "start": 46594, "end": 51887, "text": "Y parte cayó en buena tierra, y dio fruto, cuál a ciento, cuál a sesenta, y cuál a treinta.", "words": [[0, 46594], [2, 46695], [8, 46895], [13, 47295], [16, 47375], [22, 47535], [30, 47855], [32, 48125], [36, 48395], [43, 48815], [48, 49142], [50, 49468], [58, 49795], [63, 50088], [65, 50382], [74, 50675], [76, 50915], [81, 51251], [83, 51588]]}, {"verse": 9, "start": 52237, "end": 54615, "text": "Quien tiene oídos para oír, oiga.", "words": [[0, 52237], [6, 52383], [12, 52723], [18, 53183], [23, 53383], [28, 54203]]}, {"verse": 10, "start": 54965, "end": 60657, "text": "Entonces, acercándose los discípulos, le dijeron: ¿Por qué les hablas por parábolas?", "words": [[0, 54965], [10, 55973], [22, 56733], [26, 56933], [38, 57613], [41, 57953], [50, 58847], [55, 58991], [59, 59191], [63, 59331], [70, 59711], [74, 59911]]}, {"verse": 11, "start": 60937, "end": 70215, "text": "Y él respondiendo, les dijo: Porque a vosotros es concedido saber los misterios del reino de los cielos; pero a ellos no es concedido.", "words": [[0, 60937], [2, 61122], [5, 61322], [19, 62402], [23, 62582], [29, 63339], [36, 63771], [38, 63911], [47, 64351], [50, 64531], [60, 65271], [66, 65531], [70, 65811], [80, 66451], [84, 66631], [90, 67011], [93, 67131], [97, 67271], [105, 68187], [110, 68331], [112, 68511], [118, 68751], [121, 69211], [124, 69391]]}, {"verse": 12, "start": 70565, "end": 78195, "text": "Porque a cualquiera que tiene, se le dará, y tendrá más; pero al que no tiene, aun lo que tiene le será quitado.", "words": [[0, 70565], [7, 70851], [9, 70971], [20, 71491], [24, 71631], [31, 72051], [34, 72591], [37, 72771], [43, 73451], [45, 73691], [52, 74071], [57, 74740], [62, 74885], [65, 75025], [69, 75185], [72, 75325], [79, 76025], [83, 76245], [86, 76505], [90, 76645], [96, 76985], [99, 77185], [104, 77425]]}, {"verse": 13, "start": 78545, "end": 85978, "text": "Por eso les hablo por parábolas; porque viendo no ven, y oyendo no oyen, ni entienden.", "words": [[0, 78545], [4, 78690], [8, 78970], [12, 79295], [18, 79855], [22, 80075], [33, 81276], [40, 81498], [47, 81878], [50, 82158], [55, 82478], [57, 83178], [64, 83618], [67, 83898], [73, 84518], [76, 85138]]}, {"verse": 14, "start": 86328, "end": 96003, "text": "De manera que se cumple en ellos la profecía de Isaías, que dice: De oído oiréis, y no entenderéis; y viendo veréis, y no miraréis.", "words": [[0, 86328], [3, 86452], [10, 86692], [14, 86972], [17, 87132], [24, 87692], [27, 87892], [33, 88132], [36, 88352], [45, 88992], [48, 89132], [56, 89752], [60, 89952], [66, 90760], [69, 91060], [74, 91460], [82, 92120], [84, 92380], [87, 92560], [100, 93799], [102, 93923], [109, 94243], [117, 94823], [119, 95098], [122, 95238]]}, {"verse": 15, "start": 96353, "end": 110185, "text": "Porque el corazón de este pueblo se ha vuelto insensible, y oyen con dificultad, y han cerrado sus ojos: para que no vean con los ojos, ni oigan con los oídos, ni entiendan con el corazón, y se conviertan, y yo los sane.", "words": [[0, 96353], [7, 96554], [10, 96694], [18, 97074], [21, 97334], [26, 97474], [33, 97754], [36, 98014], [39, 98134], [46, 98494], [58, 99394], [60, 99674], [65, 100014], [69, 100154], [81, 101014], [83, 101214], [87, 101624], [95, 102034], [99, 102234], [105, 103102], [110, 103246], [114, 103406], [117, 103566], [122, 103846], [126, 103986], [130, 104166], [136, 104598], [139, 105029], [145, 105461], [149, 105721], [153, 105921], [160, 106391], [163, 106861], [173, 107521], [177, 107641], [180, 107801], [189, 108221], [191, 108401], [194, 108481], [206, 109181], [208, 109341], [211, 109471], [215, 109601]]}, {"verse": 16, "start": 110535, "end": 115453, "text": "Pero bienaventurados vuestros ojos, porque ven; y vuestros oídos, porque oyen.", "words": [[0, 110535], [5, 111009], [21, 111519], [30, 111939], [36, 112619], [43, 112939], [48, 113602], [50, 113710], [59, 114070], [66, 114530], [73, 114850]]}, {"verse": 17, "start": 115803, "end": 125765, "text": "Porque de cierto os digo, que muchos profetas y justos desearon ver lo que veis, y no lo vieron: y oír lo que oís, y no lo oyeron.", "words": [[0, 115803], [7, 116030], [10, 116210], [17, 116570], [20, 116930], [26, 117570], [30, 117890], [37, 118150], [46, 118790], [48, 118970], [55, 119690], [64, 120450], [68, 120650], [71, 120890], [75, 121050], [81, 121550], [83, 121830], [86, 122010], [89, 122150], [97, 123046], [99, 123232], [103, 123512], [106, 123732], [110, 123892], [115, 124332], [117, 124652], [120, 124852], [123, 125032]]}, {"verse": 18, "start": 126115, "end": 129563, "text": "Oíd, pues, vosotros la parábola del que siembra:", "words": [[0, 126281], [5, 126461], [11, 126761], [20, 127606], [23, 128006], [32, 128546], [36, 128746], [40, 128906]]}, {"verse": 19, "start": 129913, "end": 141964, "text": "Oyendo cualquiera la palabra del reino, y no entendiéndola, viene el malo, y arrebata lo que fue sembrado en su corazón: este es el que fue sembrado junto al camino.", "words": [[0, 130067], [7, 130257], [18, 130857], [21, 131037], [29, 131397], [33, 131677], [40, 132597], [42, 132837], [45, 132977], [60, 134377], [66, 134717], [69, 135017], [75, 135697], [77, 136157], [86, 136617], [89, 136717], [93, 136817], [97, 136977], [106, 137577], [109, 137697], [112, 137857], [121, 138900], [126, 139227], [129, 139567], [132, 139847], [136, 139987], [140, 140187], [149, 140807], [155, 141027], [158, 141287]]}, {"verse": 20, "start": 142314, "end": 149989, "text": "Y el que fue sembrado en pedregales, este es el que oye la palabra, y luego la recibe con gozo.", "words": [[0, 142314], [2, 142514], [5, 142614], [9, 142734], [13, 142914], [22, 143514], [25, 143674], [37, 145334], [42, 145634], [45, 145794], [48, 145954], [52, 146114], [56, 146434], [59, 146574], [68, 147714], [70, 148054], [76, 148274], [79, 148554], [86, 149054], [90, 149294]]}, {"verse": 21, "start": 150339, "end": 159393, "text": "Pero no tiene raíz en sí, sino que dura poco: que venida la aflicción o la persecución por la palabra, enseguida tropieza.", "words": [[0, 150339], [5, 150481], [8, 150641], [14, 150881], [19, 151421], [22, 151621], [26, 152281], [31, 152601], [35, 152801], [40, 153001], [46, 153950], [50, 154054], [57, 154434], [60, 154594], [70, 155454], [72, 155714], [75, 155834], [87, 156634], [91, 156834], [94, 157034], [103, 157954], [113, 158514]]}, {"verse": 22, "start": 159743, "end": 171327, "text": "Y el que fue sembrado en espinas, este es el que oye la palabra; pero el afán de este siglo y el engaño de las riquezas, ahogan la palabra, y se hace infructuosa.", "words": [[0, 159743], [2, 159892], [5, 159972], [9, 160092], [13, 160272], [22, 160872], [25, 160972], [34, 162252], [39, 162692], [42, 162932], [45, 163092], [49, 163272], [53, 163552], [56, 163692], [65, 164583], [70, 164748], [73, 164908], [78, 165268], [81, 165368], [86, 165528], [92, 166008], [94, 166188], [97, 166308], [104, 166808], [107, 166928], [111, 167088], [121, 167848], [128, 168648], [131, 168868], [140, 169328], [142, 169793], [145, 169933], [150, 170193]]}, {"verse": 23, "start": 171677, "end": 183613, "text": "Pero el que fue sembrado en buena tierra, este es el que oye y entiende la palabra, y el que lleva fruto: y lleva uno a ciento, y otro a sesenta, y otro a treinta.", "words": [[0, 171677], [5, 171840], [8, 171980], [12, 172120], [16, 172320], [25, 172980], [28, 173100], [34, 173320], [42, 174320], [47, 174620], [50, 174900], [53, 175060], [57, 175240], [61, 175660], [63, 175840], [72, 176380], [75, 176560], [84, 177340], [86, 177620], [89, 177750], [93, 177880], [99, 178180], [106, 179122], [108, 179250], [114, 179510], [118, 179770], [120, 179990], [128, 180350], [130, 181030], [135, 181310], [137, 181550], [146, 182230], [148, 182450], [153, 182690], [155, 182890]]}, {"verse": 24, "start": 183963, "end": 191848, "text": "Otra parábola les refirió, diciendo: El reino de los cielos es semejante al hombre que siembra buena semilla en su campo:", "words": [[0, 183963], [5, 184310], [14, 184810], [18, 185250], [27, 185690], [37, 186704], [40, 186951], [46, 187331], [49, 187431], [53, 187571], [60, 188031], [63, 188501], [73, 188971], [76, 189131], [83, 189351], [87, 189551], [95, 190051], [101, 190231], [109, 190831], [112, 191011], [115, 191171]]}, {"verse": 25, "start": 192198, "end": 197290, "text": "Pero durmiendo los hombres, vino su enemigo, y sembró cizaña entre el trigo, y se fue.", "words": [[0, 192198], [5, 192343], [15, 192843], [19, 193023], [28, 193803], [33, 194123], [36, 194343], [45, 194803], [47, 194903], [54, 195323], [61, 195863], [67, 196123], [70, 196303], [77, 196683], [79, 196803], [82, 196903]]}, {"verse": 26, "start": 197640, "end": 203346, "text": "Y como la hierba salió e hizo fruto, entonces apareció también la cizaña.", "words": [[0, 197640], [2, 197944], [7, 198164], [10, 198324], [17, 198784], [23, 199324], [25, 199704], [30, 199944], [37, 200824], [46, 201164], [55, 202004], [63, 202364], [66, 202881]]}, {"verse": 27, "start": 203696, "end": 213427, "text": "Y llegándose los siervos del padre de la familia, le dijeron: Señor, ¿no sembraste buena semilla en tu campo? ¿de dónde, pues, tiene cizaña?", "words": [[0, 203696], [2, 203799], [13, 204399], [17, 204579], [25, 205059], [29, 205259], [35, 205639], [38, 205859], [41, 205999], [50, 206899], [53, 207139], [62, 208081], [69, 208803], [73, 208923], [83, 209336], [89, 209750], [97, 210163], [100, 210243], [103, 210363], [110, 211216], [114, 211362], [121, 211802], [127, 212355], [133, 212908]]}, {"verse": 28, "start": 213777, "end": 222178, "text": "Y él les dijo: Un hombre enemigo ha hecho esto. Y los siervos le dijeron: ¿Quieres, pues, que vayamos y la arranquemos?", "words": [[0, 213777], [2, 213962], [5, 214162], [9, 214522], [15, 215315], [18, 215458], [25, 215778], [33, 216438], [36, 216678], [42, 216918], [48, 217710], [50, 217832], [54, 217972], [62, 218472], [65, 218812], [74, 219849], [84, 220015], [90, 220182], [94, 220577], [102, 221017], [104, 221197], [107, 221688]]}, {"verse": 29, "start": 222528, "end": 228519, "text": "Y él dijo: No; porque cogiendo la cizaña, no arranquéis también con ella el trigo.", "words": [[0, 222528], [2, 222683], [5, 222803], [11, 223480], [15, 224035], [22, 224259], [31, 224779], [34, 225169], [42, 225559], [45, 226059], [56, 226859], [64, 227159], [68, 227519], [73, 227739], [76, 227959]]}, {"verse": 30, "start": 228869, "end": 244081, "text": "Dejad crecer juntamente lo uno y lo otro hasta la siega; y al tiempo de la siega yo diré a los segadores: Recoged primero la cizaña, y atadla en manojos para quemarla; pero recoged el trigo en mi granero.", "words": [[0, 228869], [6, 229274], [13, 229774], [24, 230614], [27, 230814], [31, 231114], [33, 231334], [36, 231474], [41, 231814], [47, 232014], [50, 232431], [57, 232998], [59, 233104], [62, 233244], [69, 233564], [72, 233804], [75, 234034], [81, 234264], [84, 234444], [89, 234804], [91, 234904], [95, 235479], [106, 236477], [114, 236777], [122, 237177], [125, 237627], [133, 238077], [135, 238517], [142, 239137], [145, 239397], [153, 240097], [158, 240292], [168, 241290], [173, 241476], [181, 242176], [184, 242416], [190, 242876], [193, 243295], [196, 243715]]}, {"verse": 31, "start": 244431, "end": 254395, "text": "Otra parábola les refirió, diciendo: El reino de los cielos es semejante al grano de mostaza, que tomándolo alguno lo sembró en su campo:", "words": [[0, 244431], [5, 244778], [14, 245278], [18, 245718], [27, 246158], [37, 247171], [40, 247318], [46, 247798], [49, 247918], [53, 248058], [60, 248598], [63, 249098], [73, 249598], [76, 249778], [82, 250178], [85, 250318], [94, 251318], [98, 251478], [108, 252198], [115, 252858], [118, 252978], [125, 253478], [128, 253558], [131, 253718]]}, {"verse": 32, "start": 254745, "end": 268555, "text": "El cual a la verdad es la más pequeña de todas las semillas; pero cuando ha crecido, es la mayor de las hortalizas, y se hace árbol, que vienen las aves del cielo y hacen nidos en sus ramas.", "words": [[0, 254745], [3, 254912], [8, 255152], [10, 255472], [13, 255572], [20, 255812], [23, 256252], [26, 256572], [30, 256872], [38, 257372], [41, 257772], [47, 258072], [51, 258392], [61, 259430], [66, 259558], [73, 259798], [76, 259998], [85, 260478], [88, 260598], [91, 260718], [97, 260978], [100, 261158], [104, 261298], [116, 262158], [118, 262838], [121, 262998], [126, 263258], [133, 263938], [137, 264378], [144, 264818], [148, 264958], [153, 265298], [157, 265458], [163, 265938], [165, 266283], [171, 266543], [177, 267223], [180, 267543], [184, 267743]]}, {"verse": 33, "start": 268905, "end": 280696, "text": "Otra parábola les dijo: El reino de los cielos es semejante a la levadura que tomó una mujer, y escondió en tres medidas de harina, hasta que todo quedó fermentado.", "words": [[0, 268905], [5, 269292], [14, 269852], [18, 270092], [24, 270842], [27, 271020], [33, 271440], [36, 271580], [40, 271720], [47, 272380], [50, 272600], [60, 273440], [62, 273580], [65, 273700], [74, 274240], [78, 274420], [83, 274800], [87, 274960], [94, 275340], [96, 275840], [105, 276540], [108, 276860], [113, 277180], [121, 277860], [124, 278080], [132, 278900], [138, 279080], [142, 279260], [147, 279460], [153, 279820]]}, {"verse": 34, "start": 281046, "end": 286519, "text": "Todo esto habló Jesús por parábolas a la gente, y sin parábolas no les hablaba:", "words": [[0, 281046], [5, 281208], [10, 281508], [16, 281888], [22, 282148], [26, 282528], [36, 283208], [38, 283428], [41, 283488], [48, 283948], [50, 284204], [54, 284404], [64, 285244], [67, 285644], [71, 285864]]}, {"verse": 35, "start": 286869, "end": 296625, "text": "Para que se cumpliese lo que fue dicho por el profeta, que dijo: Abriré en parábolas mi boca; declararé cosas escondidas desde la fundación del mundo.", "words": [[0, 286869], [5, 287307], [9, 287447], [12, 287587], [22, 288147], [25, 288347], [29, 288447], [33, 288607], [39, 288867], [43, 289127], [46, 289247], [55, 289767], [59, 289927], [65, 290659], [72, 291259], [75, 291589], [85, 291919], [88, 292119], [94, 292860], [104, 293504], [110, 293784], [121, 294684], [127, 295124], [130, 295344], [140, 295824], [144, 296044]]}, {"verse": 36, "start": 296975, "end": 308354, "text": "Entonces, despedida la gente, Jesús entró en la casa; y acercándose a él sus discípulos, le dijeron: Decláranos la parábola de la cizaña del campo.", "words": [[0, 296975], [10, 297839], [20, 298599], [23, 298719], [30, 299739], [36, 300159], [42, 300879], [45, 300959], [48, 301099], [54, 301931], [56, 302040], [68, 302920], [70, 303200], [73, 303580], [77, 303720], [89, 304500], [92, 304800], [101, 305936], [112, 306256], [115, 306416], [124, 306936], [127, 307096], [130, 307386], [137, 307676], [141, 307796]]}, {"verse": 37, "start": 308634, "end": 314795, "text": "Y respondiendo él, les dijo: El que siembra la buena semilla es el Hijo del hombre;", "words": [[0, 308634], [2, 308758], [15, 309598], [19, 310018], [23, 310498], [29, 311322], [32, 311449], [36, 311549], [44, 312029], [47, 312129], [53, 312349], [61, 312949], [64, 313369], [67, 313549], [72, 313929], [76, 314189]]}, {"verse": 38, "start": 315145, "end": 322523, "text": "Y el campo es el mundo; y la buena semilla son los hijos del reino, y la cizaña son los hijos del malo;", "words": [[0, 315145], [2, 315284], [5, 315424], [11, 315784], [14, 315984], [17, 316124], [24, 317017], [26, 317126], [29, 317246], [35, 317446], [43, 317986], [47, 318226], [51, 318426], [57, 318686], [61, 318946], [68, 319666], [70, 320106], [73, 320546], [80, 320986], [84, 321266], [88, 321466], [94, 321726], [98, 321966]]}, {"verse": 39, "start": 322873, "end": 330620, "text": "Y el enemigo que la sembró, es el diablo; y la siega es el fin del mundo, y los segadores son los ángeles.", "words": [[0, 322873], [2, 322999], [5, 323139], [13, 323679], [17, 323839], [20, 323959], [28, 324719], [31, 325079], [34, 325259], [42, 326143], [44, 326245], [47, 326585], [53, 326925], [56, 327130], [59, 327290], [63, 327490], [67, 327650], [74, 328090], [76, 328650], [80, 329070], [90, 329490], [94, 329830], [98, 329990]]}, {"verse": 40, "start": 330970, "end": 337784, "text": "De manera que como es cogida la cizaña, y quemada al fuego, así será en el fin de este siglo.", "words": [[0, 330970], [3, 331075], [10, 331275], [14, 331515], [19, 331755], [22, 331975], [29, 332455], [32, 332845], [40, 333235], [42, 333655], [50, 334055], [53, 334255], [60, 335055], [64, 335255], [69, 335695], [72, 336195], [75, 336355], [79, 336635], [82, 336875], [87, 337095]]}, {"verse": 41, "start": 338134, "end": 346339, "text": "Enviará el Hijo del hombre sus ángeles, y recogerán de su reino todas las causas de tropiezo, y los que hacen iniquidad,", "words": [[0, 338134], [8, 338799], [11, 339039], [16, 339439], [20, 339599], [27, 340079], [31, 340159], [40, 340819], [42, 341359], [52, 342159], [55, 342299], [58, 342479], [64, 342979], [70, 343319], [74, 343659], [81, 344239], [84, 344339], [94, 345099], [96, 345739], [100, 345879], [104, 346079], [110, 346209]]}, {"verse": 42, "start": 346689, "end": 352933, "text": "Y los echarán en el horno de fuego: allí será el llanto y el crujir de dientes.", "words": [[0, 346769], [2, 347229], [6, 347389], [14, 348049], [17, 348289], [20, 348449], [26, 348849], [29, 348989], [36, 349852], [41, 350304], [46, 350504], [49, 350644], [56, 351084], [58, 351264], [61, 351604], [68, 351944], [71, 352104]]}, {"verse": 43, "start": 353283, "end": 361547, "text": "Entonces los justos resplandecerán como el sol en el reino de su Padre: el que tiene oídos para oír, oiga.", "words": [[0, 353283], [9, 354011], [13, 354671], [20, 355411], [35, 356591], [40, 356851], [43, 357071], [47, 357331], [50, 357671], [53, 357831], [59, 358231], [62, 358371], [65, 358531], [72, 359343], [75, 359450], [79, 359570], [85, 359850], [91, 360310], [96, 360530], [101, 361040]]}, {"verse": 44, "start": 361897, "end": 376921, "text": "Además, el reino de los cielos es semejante al tesoro escondido en el campo; el cual hallado, el hombre lo encubre, y de gozo de ello va, y vende todo lo que tiene, y compra aquel campo.", "words": [[0, 361897], [8, 362860], [11, 363220], [17, 363660], [20, 363780], [24, 363940], [31, 364560], [34, 364780], [44, 365740], [47, 366100], [54, 366740], [64, 367540], [67, 367660], [70, 367820], [77, 368782], [80, 368946], [85, 369226], [94, 369886], [97, 370026], [104, 370286], [107, 370909], [116, 371531], [118, 371611], [121, 371791], [126, 372131], [129, 372351], [134, 372571], [138, 373411], [140, 373471], [146, 373871], [151, 374131], [154, 374371], [158, 374491], [165, 375351], [167, 375431], [174, 375831], [180, 376211]]}, {"verse": 45, "start": 377271, "end": 383456, "text": "También el reino de los cielos es semejante a un comerciante, que busca buenas perlas;", "words": [[0, 377271], [8, 377596], [11, 377916], [17, 378336], [20, 378456], [24, 378596], [31, 379216], [34, 379496], [44, 380336], [46, 380456], [49, 380576], [62, 381416], [66, 381876], [72, 382176], [79, 382856]]}, {"verse": 46, "start": 383806, "end": 388802, "text": "Que hallando una preciosa perla, fue y vendió todo lo que tenía, y la compró.", "words": [[0, 383806], [4, 383990], [13, 384270], [17, 384450], [26, 384970], [33, 385590], [37, 385690], [39, 386010], [46, 386450], [51, 386850], [54, 387110], [58, 387230], [65, 387590], [67, 388090], [70, 388210]]}, {"verse": 47, "start": 389152, "end": 397278, "text": "Asimismo el reino de los cielos es semejante a la red, que echada en el mar, recoge de toda clase de peces:", "words": [[0, 389152], [9, 389820], [12, 389920], [18, 390300], [21, 390420], [25, 390580], [32, 391240], [35, 391730], [45, 392220], [47, 392380], [50, 392480], [55, 392760], [59, 393300], [66, 393720], [69, 393860], [72, 394000], [77, 394280], [84, 395520], [87, 395660], [92, 395920], [98, 396280], [101, 396620]]}, {"verse": 48, "start": 397628, "end": 406477, "text": "La cual estando llena, la sacaron a la orilla; y sentados, cogieron lo bueno en cestas, y lo malo echaron fuera.", "words": [[0, 397628], [3, 397756], [8, 398189], [16, 398623], [23, 399056], [26, 399596], [34, 400136], [36, 400236], [39, 400376], [47, 401177], [49, 401321], [59, 402021], [68, 402781], [71, 403001], [77, 403261], [80, 403481], [88, 404241], [90, 404841], [93, 404981], [98, 405301], [106, 405721]]}, {"verse": 49, "start": 406827, "end": 414187, "text": "Así será al fin del siglo: saldrán los ángeles, y apartarán a los malos de entre los justos,", "words": [[0, 406827], [4, 407031], [9, 407431], [12, 407751], [16, 407991], [20, 408507], [27, 409190], [35, 409977], [39, 410157], [48, 410817], [50, 411217], [60, 412017], [62, 412177], [66, 412317], [72, 412877], [75, 413097], [81, 413397], [85, 413617]]}, {"verse": 50, "start": 414537, "end": 420166, "text": "Y los echarán en el horno del fuego: allí será el llanto y el crujir de dientes.", "words": [[0, 414537], [2, 414661], [6, 414801], [14, 415421], [17, 415661], [20, 415821], [26, 416121], [30, 416281], [37, 417085], [42, 417537], [47, 417737], [50, 417877], [57, 418317], [59, 418497], [62, 418837], [69, 419177], [72, 419337]]}, {"verse": 51, "start": 420516, "end": 427221, "text": "Les dice Jesús: ¿Habéis entendido todas estas cosas? Ellos responden: Sí, Señor.", "words": [[0, 420516], [4, 420740], [9, 421100], [16, 422074], [24, 422521], [34, 423201], [40, 423401], [46, 423761], [53, 425010], [59, 425180], [70, 426243], [74, 426670]]}, {"verse": 52, "start": 427501, "end": 437907, "text": "Y él les dijo: Por eso todo escriba instruido en el reino de los cielos, es semejante a un padre de familia, que saca de su tesoro cosas nuevas y cosas viejas.", "words": [[0, 427501], [2, 427687], [5, 427887], [9, 428247], [15, 429039], [19, 429146], [23, 429366], [28, 429646], [36, 430246], [46, 430846], [49, 430986], [52, 431146], [58, 431526], [61, 431646], [65, 431786], [73, 432646], [76, 432926], [86, 433486], [88, 433586], [91, 433686], [97, 433946], [100, 434166], [109, 434706], [113, 434926], [118, 435286], [121, 435366], [124, 435506], [131, 435986], [137, 436281], [144, 436661], [146, 436921], [152, 437081]]}, {"verse": 53, "start": 438257, "end": 442807, "text": "Y aconteció que acabando Jesús estas parábolas, pasó de allí.", "words": [[0, 438257], [2, 438416], [12, 439156], [16, 439376], [25, 439836], [31, 440236], [37, 440716], [48, 441636], [53, 442056], [56, 442316]]}, {"verse": 54, "start": 443157, "end": 454644, "text": "Y venido a su tierra, les enseñaba en la sinagoga de ellos, de tal manera que ellos estaban atónitos, y decían: ¿De dónde tiene este esta sabiduría, y estas maravillas?", "words": [[0, 443157], [2, 443265], [9, 443645], [11, 443765], [14, 443885], [22, 444365], [26, 444885], [35, 445645], [38, 445765], [41, 445865], [50, 446485], [53, 446705], [60, 447305], [63, 447525], [67, 447785], [74, 448145], [78, 448425], [84, 448665], [92, 449105], [102, 450125], [104, 450445], [112, 451391], [116, 451534], [122, 451654], [128, 451874], [133, 452094], [138, 452394], [149, 453394], [151, 453574], [157, 453774]]}, {"verse": 55, "start": 454994, "end": 461843, "text": "¿No es este el hijo del carpintero? ¿no se llama su madre María, y sus hermanos Jacobo y José, y Simón, y Judas?", "words": [[0, 454994], [4, 455140], [7, 455360], [12, 455680], [15, 455840], [20, 456020], [24, 456160], [36, 457203], [40, 457326], [43, 457446], [49, 457666], [52, 457846], [58, 458086], [65, 458506], [67, 458926], [71, 459046], [80, 459526], [87, 459986], [89, 460046], [95, 460306], [97, 460646], [104, 461086], [106, 461266]]}, {"verse": 56, "start": 462193, "end": 466993, "text": "¿Y no están todas sus hermanas con nosotros? ¿De dónde, pues, tiene este todas estas cosas?", "words": [[0, 462193], [3, 462289], [6, 462409], [12, 462609], [18, 462889], [22, 463169], [31, 463529], [35, 463749], [45, 464653], [49, 464798], [56, 465098], [62, 465350], [68, 465601], [73, 465853], [79, 466053], [85, 466313]]}, {"verse": 57, "start": 467273, "end": 475282, "text": "Y se escandalizaban en él. Pero Jesús les dijo: No hay profeta sin honra sino en su tierra y en su casa.", "words": [[0, 467273], [2, 467419], [5, 467619], [20, 468679], [23, 468859], [27, 469430], [32, 469574], [38, 469994], [42, 470494], [48, 471249], [51, 471376], [55, 471536], [63, 472096], [67, 472336], [73, 473076], [78, 473276], [81, 473516], [84, 473616], [91, 474076], [93, 474336], [96, 474476], [99, 474636]]}, {"verse": 58, "start": 475632, "end": 481312, "text": "Y no hizo allí muchas maravillas, a causa de la incredulidad de ellos.", "words": [[0, 475632], [2, 475756], [5, 475956], [10, 476236], [15, 476516], [22, 476856], [34, 478216], [36, 478316], [42, 478716], [45, 479016], [48, 479136], [61, 480296], [64, 480596]]}]}