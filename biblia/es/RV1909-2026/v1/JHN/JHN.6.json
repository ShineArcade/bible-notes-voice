{"book": "JHN", "chapter": 6, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 534359, "verses": [{"verse": 1, "start": 300, "end": 7094, "text": "Pasadas estas cosas, Jesús fue al otro lado del mar de Galilea, que es de Tiberias.", "words": [[0, 300], [8, 788], [14, 1088], [21, 2128], [27, 2588], [31, 3288], [34, 3588], [39, 3828], [44, 4168], [48, 4448], [52, 4901], [55, 5355], [64, 5808], [68, 5848], [71, 6088], [74, 6228]]}, {"verse": 2, "start": 7544, "end": 12645, "text": "Y le seguía grande multitud, porque veían sus señales que hacía en los enfermos.", "words": [[0, 7544], [2, 7629], [5, 7749], [12, 8229], [19, 8789], [29, 9349], [36, 9929], [42, 10449], [46, 10649], [54, 11229], [58, 11396], [64, 11562], [67, 11729], [71, 11889]]}, {"verse": 3, "start": 13095, "end": 18011, "text": "Y subió Jesús a un monte, y se sentó allí con sus discípulos.", "words": [[0, 13095], [2, 13218], [8, 13618], [14, 13938], [16, 14238], [19, 14338], [26, 14798], [28, 15598], [31, 15718], [37, 16218], [42, 16438], [46, 16698], [50, 16958]]}, {"verse": 4, "start": 18461, "end": 22029, "text": "Y estaba cerca la Pascua, la fiesta de los judíos.", "words": [[0, 18461], [2, 18724], [9, 19004], [15, 19384], [18, 19644], [26, 20584], [29, 20664], [36, 21044], [39, 21184], [43, 21304]]}, {"verse": 5, "start": 22479, "end": 32186, "text": "Y como alzó Jesús los ojos, y vio que había venido a él grande multitud, dice a Felipe: ¿De dónde compraremos pan para que coman estos?", "words": [[0, 22479], [2, 22625], [7, 22925], [12, 23525], [18, 23825], [22, 24365], [28, 25185], [30, 25445], [34, 25645], [38, 25785], [44, 25985], [51, 26445], [53, 26545], [56, 26685], [63, 27025], [73, 28105], [78, 28425], [80, 28605], [88, 29436], [92, 29700], [98, 29900], [110, 30580], [114, 30940], [119, 31180], [123, 31340], [129, 31680]]}, {"verse": 6, "start": 32636, "end": 37529, "text": "Pero esto decía para probarle; porque él sabía lo que había de hacer.", "words": [[0, 32636], [5, 32816], [10, 33076], [16, 33736], [21, 34036], [31, 35174], [38, 35436], [41, 35736], [47, 36196], [50, 36356], [54, 36536], [60, 36776], [63, 36956]]}, {"verse": 7, "start": 37979, "end": 44886, "text": "Le respondió Felipe: Doscientos denarios de pan no les bastarán, para que cada uno de ellos tome un poco.", "words": [[0, 37979], [3, 38124], [13, 38864], [21, 40031], [32, 40221], [41, 40861], [44, 41041], [48, 41341], [51, 41581], [55, 41741], [65, 42381], [70, 42881], [74, 43041], [79, 43281], [83, 43561], [86, 43721], [92, 43981], [97, 44301], [100, 44401]]}, {"verse": 8, "start": 45236, "end": 49585, "text": "Le dice uno de sus discípulos, Andrés, hermano de Simón Pedro:", "words": [[0, 45236], [3, 45360], [8, 45640], [12, 46000], [15, 46160], [19, 46340], [31, 47240], [39, 47860], [47, 48340], [50, 48460], [56, 48840]]}, {"verse": 9, "start": 49835, "end": 55753, "text": "Un muchacho está aquí que tiene cinco panes de cebada y dos pececillos; ¿pero qué es esto entre tantos?", "words": [[0, 49835], [3, 49965], [12, 50405], [17, 50665], [22, 50905], [26, 51065], [32, 51305], [38, 51685], [44, 52165], [47, 52285], [54, 52765], [56, 52865], [60, 53410], [72, 54201], [78, 54326], [82, 54526], [85, 54666], [90, 54926], [96, 55086]]}, {"verse": 10, "start": 56103, "end": 66873, "text": "Entonces Jesús dijo: Haced recostar la gente. Y había mucha hierba en aquel lugar: y se recostaron como número de cinco mil varones.", "words": [[0, 56103], [9, 56618], [15, 57198], [21, 58273], [27, 58697], [36, 59437], [39, 59577], [46, 60526], [48, 60623], [54, 60783], [60, 61183], [67, 61763], [70, 61903], [76, 62203], [83, 63116], [85, 63336], [88, 63456], [99, 64236], [104, 64516], [111, 65016], [114, 65346], [120, 65676], [124, 66309]]}, {"verse": 11, "start": 67323, "end": 78878, "text": "Y tomó Jesús aquellos panes, y habiendo dado gracias, repartió a los discípulos, y los discípulos a los que estaban recostados: asimismo de los peces, cuanto querían.", "words": [[0, 67323], [2, 67447], [7, 67727], [13, 68027], [22, 68387], [29, 69087], [31, 69607], [40, 69907], [45, 70147], [54, 71407], [63, 71927], [65, 72007], [69, 72107], [81, 72827], [83, 73267], [87, 73407], [98, 74047], [100, 74427], [104, 74527], [108, 74627], [116, 74987], [128, 76688], [137, 76978], [140, 77098], [144, 77218], [151, 77668], [158, 78118]]}, {"verse": 12, "start": 79328, "end": 87036, "text": "Y como fueron saciados, dijo a sus discípulos: Recoged los pedazos que han quedado, porque no se pierda nada.", "words": [[0, 79328], [2, 79434], [7, 79634], [14, 79934], [24, 81014], [29, 81394], [31, 81614], [35, 81774], [47, 82962], [55, 83687], [59, 83887], [67, 84547], [71, 84647], [75, 84767], [84, 85307], [91, 85727], [94, 85967], [97, 86107], [104, 86507]]}, {"verse": 13, "start": 87486, "end": 95954, "text": "Recogieron pues, y llenaron doce cestas de pedazos de los cinco panes de cebada, que sobraron a los que habían comido.", "words": [[0, 87486], [11, 88111], [17, 88371], [19, 88751], [28, 89191], [33, 89671], [40, 90251], [43, 90351], [51, 90991], [54, 91111], [58, 91311], [64, 91811], [70, 92471], [73, 92591], [81, 93151], [85, 93691], [94, 94371], [96, 94611], [100, 94731], [104, 94871], [111, 95211]]}, {"verse": 14, "start": 96404, "end": 104928, "text": "Aquellos hombres entonces, cuando vieron la señal que Jesús había hecho, decían: Este verdaderamente es el profeta que había de venir al mundo.", "words": [[0, 96404], [9, 96823], [17, 97103], [27, 98023], [34, 98123], [41, 98543], [44, 98683], [50, 99103], [54, 99223], [60, 99503], [66, 99863], [73, 100503], [81, 101560], [86, 101800], [101, 102620], [104, 102920], [107, 103060], [115, 103500], [119, 103680], [125, 103880], [128, 104060], [134, 104260], [137, 104420]]}, {"verse": 15, "start": 105278, "end": 113902, "text": "Y entendiendo Jesús que habían de venir para arrebatarle, y hacerle rey, volvió a retirarse al monte, él solo.", "words": [[0, 105278], [2, 105421], [14, 106101], [20, 106501], [24, 107201], [31, 107441], [34, 107661], [40, 107921], [45, 108201], [58, 109281], [60, 109721], [68, 110241], [73, 110981], [80, 111461], [82, 111541], [92, 112161], [95, 112321], [102, 112811], [105, 113301]]}, {"verse": 16, "start": 114352, "end": 118175, "text": "Y como se hizo tarde, descendieron sus discípulos al mar;", "words": [[0, 114352], [2, 114437], [7, 114657], [10, 114857], [15, 115117], [22, 115957], [35, 116677], [39, 116897], [50, 117517], [53, 117737]]}, {"verse": 17, "start": 118625, "end": 127916, "text": "Y entrando en un barco, venían de la otra parte del mar hacia Capernaum. Y era ya oscuro, y Jesús no había venido a ellos.", "words": [[0, 118625], [2, 118808], [11, 119328], [14, 119488], [17, 119608], [24, 120128], [31, 120808], [34, 120948], [37, 121068], [42, 121208], [48, 121568], [52, 121848], [56, 122108], [62, 122548], [73, 123920], [75, 124189], [79, 124359], [82, 124529], [90, 125509], [92, 125609], [98, 125949], [101, 126509], [107, 126749], [114, 127229], [116, 127369]]}, {"verse": 18, "start": 128366, "end": 132065, "text": "Y levantábase el mar con un gran viento que soplaba.", "words": [[0, 128366], [2, 128495], [14, 129375], [17, 129595], [21, 129875], [25, 130175], [28, 130355], [33, 130555], [40, 131135], [44, 131295]]}, {"verse": 19, "start": 132515, "end": 142850, "text": "Y cuando hubieron navegado como veinticinco o treinta estadios, ven a Jesús que andaba sobre el mar, y se acercaba al barco: y tuvieron miedo.", "words": [[0, 132515], [2, 132757], [9, 133017], [18, 133477], [27, 134037], [32, 134507], [44, 134977], [46, 135377], [54, 135777], [64, 136917], [68, 137257], [70, 137557], [76, 137877], [80, 138217], [87, 138637], [93, 138957], [96, 139177], [101, 139437], [103, 139917], [106, 140057], [115, 140717], [118, 140897], [125, 141738], [127, 141859], [136, 142259]]}, {"verse": 20, "start": 143300, "end": 147368, "text": "Pero él les dijo: Yo soy; no tengáis miedo.", "words": [[0, 143300], [5, 143464], [8, 143884], [12, 144364], [18, 145172], [21, 145420], [26, 146131], [29, 146315], [37, 146755]]}, {"verse": 21, "start": 147818, "end": 154897, "text": "Ellos entonces quisieron recibirle en el barco: y de inmediato el barco llegó a la tierra donde iban.", "words": [[0, 147818], [6, 148216], [15, 148556], [25, 149296], [35, 150096], [38, 150316], [41, 150476], [48, 151444], [50, 151592], [53, 151672], [63, 152432], [66, 152572], [72, 152952], [78, 153192], [80, 153412], [83, 153512], [90, 153792], [96, 154172]]}, {"verse": 22, "start": 155347, "end": 170658, "text": "El día siguiente, la gente que estaba de la otra parte del mar, cuando vio que no había allí otra navecilla sino una, y que Jesús no había entrado con sus discípulos en ella, sino que sus discípulos se habían ido solos;", "words": [[0, 155347], [3, 155493], [7, 155693], [18, 156373], [21, 156473], [27, 156813], [31, 157033], [38, 157393], [41, 157593], [44, 157713], [49, 157913], [55, 158273], [59, 158553], [64, 158833], [71, 159693], [75, 160053], [79, 160213], [82, 160393], [88, 160633], [93, 160933], [98, 161233], [108, 161833], [113, 162093], [118, 162955], [120, 163079], [124, 163199], [130, 163619], [133, 164459], [139, 164699], [147, 165319], [151, 165499], [155, 165739], [166, 166479], [169, 166719], [175, 167419], [180, 167699], [184, 167919], [188, 168119], [199, 169039], [202, 169359], [209, 169639], [213, 169879]]}, {"verse": 23, "start": 171108, "end": 179422, "text": "Y que otras barcas habían arribado de Tiberias junto al lugar donde habían comido el pan después de haber el Señor dado gracias;", "words": [[0, 171108], [2, 171229], [6, 171349], [12, 171589], [19, 172229], [26, 172829], [35, 173489], [38, 173649], [47, 174249], [53, 174569], [56, 174869], [62, 175169], [68, 175489], [75, 175909], [82, 176349], [85, 176469], [89, 176709], [97, 177329], [100, 177549], [106, 177709], [109, 177909], [115, 178149], [120, 178529]]}, {"verse": 24, "start": 179872, "end": 189368, "text": "Cuando vio pues la gente que Jesús no estaba allí, ni sus discípulos, entraron ellos en las barcas, y vinieron a Capernaum buscando a Jesús.", "words": [[0, 179872], [7, 180074], [11, 180414], [16, 180614], [19, 180814], [25, 181114], [29, 181314], [35, 181654], [38, 182194], [45, 182574], [51, 182994], [54, 183414], [58, 183634], [70, 184814], [79, 185454], [85, 185774], [88, 186034], [92, 186154], [100, 186614], [102, 186994], [111, 187434], [113, 187634], [123, 188134], [132, 188454], [134, 188734]]}, {"verse": 25, "start": 189818, "end": 194860, "text": "Y hallándole de la otra parte del mar, le dijeron: Rabí, ¿cuándo llegaste acá?", "words": [[0, 189818], [2, 190151], [13, 190521], [16, 190701], [19, 190841], [24, 191041], [30, 191481], [34, 191721], [39, 192321], [42, 192521], [51, 193625], [57, 193775], [65, 193975], [74, 194435]]}, {"verse": 26, "start": 195210, "end": 205960, "text": "Les respondió Jesús, y dijo: De cierto, de cierto os digo, que me buscáis, no porque habéis visto las señales, sino porque comisteis el pan y os hartasteis.", "words": [[0, 195269], [4, 195359], [14, 195979], [21, 196279], [23, 196559], [29, 197682], [32, 198014], [40, 198346], [43, 198678], [50, 199010], [53, 199230], [59, 199490], [63, 199710], [66, 199850], [75, 200650], [78, 200730], [85, 201050], [92, 201310], [98, 201570], [102, 201770], [111, 202710], [116, 202930], [123, 203290], [133, 203910], [136, 204050], [140, 204350], [142, 204750], [145, 204910]]}, {"verse": 27, "start": 206410, "end": 217488, "text": "Trabajad no por la comida que perece, sino por la comida que a vida eterna permanece, la cual el Hijo del hombre os dará: porque a este señaló el Padre, que es Dios.", "words": [[0, 206588], [9, 206808], [12, 207288], [16, 207528], [19, 207668], [26, 208008], [30, 208228], [38, 208968], [43, 209268], [47, 209628], [50, 209788], [57, 210228], [61, 210468], [63, 210628], [68, 210788], [75, 211308], [86, 212468], [89, 212568], [94, 212768], [97, 212988], [102, 213288], [106, 213508], [113, 213828], [116, 214048], [122, 214854], [129, 215095], [131, 215255], [136, 215495], [143, 216095], [146, 216175], [153, 216615], [157, 216755], [160, 216895]]}, {"verse": 28, "start": 217938, "end": 221735, "text": "Y le dijeron: ¿Qué haremos para que obremos las obras de Dios?", "words": [[0, 217938], [2, 218062], [5, 218162], [14, 219129], [19, 219233], [27, 219673], [32, 219993], [36, 220173], [44, 220533], [48, 220733], [54, 220993], [57, 221233]]}, {"verse": 29, "start": 222085, "end": 229543, "text": "Respondió Jesús, y les dijo: Esta es la obra de Dios, que creáis en el que él ha enviado.", "words": [[0, 222462], [10, 222872], [17, 223212], [19, 223512], [23, 223672], [29, 224514], [34, 224897], [37, 225237], [40, 225717], [45, 226057], [48, 226297], [54, 226617], [58, 227237], [65, 227817], [68, 228057], [71, 228217], [75, 228397], [78, 228597], [81, 228737]]}, {"verse": 30, "start": 229993, "end": 236295, "text": "Le dijeron entonces: ¿Qué señal pues haces tú, para que veamos, y te creamos? ¿Qué obras?", "words": [[0, 229993], [3, 230139], [11, 230679], [21, 231806], [26, 231904], [32, 232424], [37, 232744], [43, 233044], [47, 233344], [52, 233624], [56, 233804], [64, 234224], [66, 234504], [69, 234644], [78, 235626], [83, 235746]]}, {"verse": 31, "start": 236745, "end": 243127, "text": "Nuestros padres comieron el maná en el desierto, como está escrito: Pan del cielo les dio a comer.", "words": [[0, 236745], [9, 237129], [16, 237429], [25, 237989], [28, 238189], [33, 238549], [36, 238669], [39, 238769], [49, 239469], [54, 239629], [59, 239829], [68, 240784], [72, 240967], [76, 241127], [82, 241507], [86, 241707], [90, 241927], [92, 242027]]}, {"verse": 32, "start": 243477, "end": 254438, "text": "Y Jesús les dijo: De cierto, de cierto os digo: No os dio Moisés pan del cielo; sino que mi Padre os da el verdadero pan del cielo.", "words": [[0, 243477], [2, 243601], [8, 243981], [12, 244301], [18, 245432], [21, 245804], [29, 246176], [32, 246548], [39, 246920], [42, 247220], [48, 248030], [51, 248241], [54, 248581], [58, 248801], [65, 248987], [69, 249172], [73, 249358], [80, 251225], [85, 251385], [89, 251585], [92, 251765], [98, 252085], [101, 252305], [104, 252445], [107, 252565], [117, 253185], [121, 253525], [125, 253765]]}, {"verse": 33, "start": 254888, "end": 260371, "text": "Porque el pan de Dios es aquel que descendió del cielo y da vida al mundo.", "words": [[0, 254888], [7, 255172], [10, 255372], [14, 255712], [17, 255952], [22, 256292], [25, 256652], [31, 257072], [35, 257172], [45, 257832], [49, 257992], [55, 258552], [57, 258972], [60, 259392], [65, 259572], [68, 259832]]}, {"verse": 34, "start": 260821, "end": 264094, "text": "Y le dijeron: Señor, danos siempre este pan.", "words": [[0, 260821], [2, 260944], [5, 261044], [14, 262011], [21, 262515], [27, 262775], [35, 263155], [40, 263635]]}, {"verse": 35, "start": 264444, "end": 274752, "text": "Y Jesús les dijo: Yo soy el pan de vida: el que a mí viene, nunca tendrá hambre; y el que en mí cree, no tendrá sed jamás.", "words": [[0, 264444], [2, 264567], [8, 264947], [12, 265267], [18, 266068], [21, 266312], [25, 266592], [28, 266912], [32, 267252], [35, 267532], [41, 268386], [44, 268551], [48, 268711], [50, 268811], [53, 268951], [60, 269411], [66, 270131], [73, 270502], [81, 271648], [83, 271968], [86, 272288], [90, 272448], [93, 272588], [96, 272748], [102, 273028], [105, 273468], [112, 273909], [116, 274349]]}, {"verse": 36, "start": 275202, "end": 279294, "text": "Pero os he dicho, que aunque me habéis visto, no creéis.", "words": [[0, 275202], [5, 275407], [8, 275647], [11, 275727], [18, 276127], [22, 277047], [29, 277207], [32, 277507], [39, 277787], [46, 278347], [49, 278467]]}, {"verse": 37, "start": 279744, "end": 284438, "text": "Todo lo que el Padre me da, vendrá a mí; y al que a mí viene, no le echo fuera.", "words": [[0, 279744], [5, 279868], [8, 280088], [12, 280188], [15, 280308], [21, 280668], [24, 280788], [28, 280968], [35, 281548], [37, 281648], [41, 282252], [43, 282399], [46, 282539], [50, 282699], [52, 282779], [55, 282899], [62, 283279], [65, 283539], [68, 283729], [73, 283919]]}, {"verse": 38, "start": 284888, "end": 292141, "text": "Porque he descendido del cielo, no para hacer mi voluntad, sino la voluntad del que me envió.", "words": [[0, 284888], [7, 285172], [10, 285552], [21, 286232], [25, 286432], [32, 286892], [35, 287712], [40, 287992], [46, 288372], [49, 288552], [59, 289292], [64, 289852], [67, 290192], [76, 290702], [80, 291212], [84, 291332], [87, 291512]]}, {"verse": 39, "start": 292591, "end": 301945, "text": "Y esta es la voluntad del que me envió, del Padre: Que todo lo que me da, no pierda de ello, sino que lo resucite en el día postrero.", "words": [[0, 292591], [2, 292947], [7, 293267], [10, 293507], [13, 293667], [22, 294287], [26, 294447], [30, 294627], [33, 294807], [40, 295327], [44, 295447], [51, 296943], [55, 297024], [60, 297304], [63, 297544], [67, 297684], [70, 297844], [74, 298044], [77, 298184], [84, 298604], [87, 298844], [93, 299084], [98, 299404], [102, 299584], [105, 299744], [114, 300424], [117, 300564], [120, 300704], [124, 300904]]}, {"verse": 40, "start": 302395, "end": 312444, "text": "Y esta es la voluntad del que me ha enviado: Que todo aquel que ve al Hijo, y cree en él, tenga vida eterna: y yo le resucitaré en el día postrero.", "words": [[0, 302395], [2, 302563], [7, 303003], [10, 303583], [13, 303723], [22, 304403], [26, 304603], [30, 304783], [33, 304943], [36, 305043], [45, 306076], [49, 306178], [54, 306418], [60, 306858], [64, 306958], [67, 307138], [70, 307278], [76, 307498], [78, 307678], [83, 307898], [86, 308118], [90, 308368], [96, 308618], [101, 308758], [109, 309797], [111, 309915], [114, 310095], [117, 310235], [128, 311175], [131, 311295], [134, 311455], [138, 311655]]}, {"verse": 41, "start": 312894, "end": 319568, "text": "Murmuraban entonces de él los judíos, porque había dicho: Yo soy el pan que descendí del cielo.", "words": [[0, 312894], [11, 313620], [20, 314100], [23, 314480], [26, 314680], [30, 314800], [38, 315440], [45, 315780], [51, 316060], [58, 316944], [61, 317129], [65, 317349], [68, 317589], [72, 317869], [76, 318109], [85, 318789], [89, 318929]]}, {"verse": 42, "start": 320018, "end": 328987, "text": "Y decían: ¿No es este Jesús, el hijo de José, cuyo padre y madre nosotros conocemos? ¿cómo, pues, dice este: Del cielo he descendido?", "words": [[0, 320018], [2, 320495], [10, 321254], [14, 321418], [17, 321618], [22, 321838], [29, 322598], [32, 322678], [37, 322898], [40, 322998], [46, 323578], [51, 323798], [57, 324158], [59, 324238], [65, 324518], [74, 324738], [85, 326054], [92, 326218], [98, 326538], [103, 326798], [109, 327638], [113, 327800], [119, 328120], [122, 328300]]}, {"verse": 43, "start": 329337, "end": 333999, "text": "Y Jesús respondió, y les dijo: No murmuréis entre vosotros.", "words": [[0, 329337], [2, 329460], [8, 329800], [19, 330760], [21, 331000], [25, 331120], [31, 331998], [34, 332183], [44, 332823], [50, 333123]]}, {"verse": 44, "start": 334449, "end": 341570, "text": "Ninguno puede venir a mí, si el Padre que me envió no le trae; y yo le resucitaré en el día postrero.", "words": [[0, 334449], [8, 334998], [14, 335218], [20, 335618], [22, 335758], [26, 336118], [29, 336398], [32, 336558], [38, 336858], [42, 337098], [45, 337258], [51, 337618], [54, 337938], [57, 338078], [63, 338923], [65, 339041], [68, 339221], [71, 339361], [82, 340301], [85, 340421], [88, 340581], [92, 340781]]}, {"verse": 45, "start": 342020, "end": 350634, "text": "Escrito está en los profetas: Y serán todos enseñados de Dios. Así que, todo aquel que oyó del Padre, y aprendió, viene a mí.", "words": [[0, 342020], [8, 342458], [13, 342738], [16, 342878], [20, 342978], [30, 344096], [32, 344223], [38, 344603], [44, 345043], [54, 345863], [57, 346023], [63, 346847], [67, 347011], [72, 347191], [77, 347411], [83, 347831], [87, 348041], [91, 348251], [95, 348371], [102, 348751], [104, 349051], [114, 349631], [120, 350091], [122, 350351]]}, {"verse": 46, "start": 351084, "end": 357516, "text": "No que alguno haya visto al Padre, sino aquel que vino de Dios, este ha visto al Padre.", "words": [[0, 351084], [3, 351253], [7, 351413], [14, 351873], [19, 351993], [25, 352313], [28, 352493], [35, 353393], [40, 353663], [46, 353933], [50, 354053], [55, 354273], [58, 354473], [64, 355293], [69, 355573], [72, 355713], [78, 355913], [81, 356093]]}, {"verse": 47, "start": 357966, "end": 363707, "text": "De cierto, de cierto os digo: El que cree en mí, tiene vida eterna.", "words": [[0, 358296], [3, 358668], [11, 359040], [14, 359412], [21, 359784], [24, 360084], [30, 360895], [33, 361148], [37, 361434], [42, 361721], [45, 361901], [49, 362121], [55, 362641], [60, 362961]]}, {"verse": 48, "start": 364157, "end": 365756, "text": "Yo soy el pan de vida.", "words": [[0, 364157], [3, 364344], [7, 364584], [10, 364824], [14, 365064], [17, 365264]]}, {"verse": 49, "start": 366206, "end": 370020, "text": "Vuestros padres comieron el maná en el desierto, y han muerto.", "words": [[0, 366206], [9, 366589], [16, 366969], [25, 367509], [28, 367749], [33, 368149], [36, 368249], [39, 368369], [49, 368949], [51, 369169], [55, 369329]]}, {"verse": 50, "start": 370470, "end": 376174, "text": "Este es el pan que desciende del cielo, para que el que de él come, no muera.", "words": [[0, 370470], [5, 370796], [8, 371016], [11, 371176], [15, 371556], [19, 371796], [29, 372316], [33, 372536], [40, 373136], [45, 373676], [49, 373896], [52, 374216], [56, 374396], [59, 374616], [62, 374756], [68, 375176], [71, 375636]]}, {"verse": 51, "start": 376624, "end": 388485, "text": "Yo soy el pan vivo que he descendido del cielo: si alguno come de este pan, vivirá para siempre; y el pan que yo daré es mi carne, la cual yo daré por la vida del mundo.", "words": [[0, 376624], [3, 376810], [7, 377030], [10, 377290], [14, 377570], [19, 377970], [23, 378250], [26, 378410], [37, 379110], [41, 379290], [48, 380243], [51, 380380], [58, 380860], [63, 381120], [66, 381320], [71, 381500], [76, 382000], [83, 382600], [88, 382760], [97, 383715], [99, 383835], [102, 383975], [106, 384255], [110, 384475], [113, 384655], [118, 385055], [121, 385315], [124, 385495], [131, 386275], [134, 386515], [139, 386695], [142, 386895], [147, 387195], [151, 387335], [154, 387495], [159, 387695], [163, 387935]]}, {"verse": 52, "start": 388935, "end": 396456, "text": "Entonces los judíos contendían entre sí, diciendo: ¿Cómo puede este darnos su carne a comer?", "words": [[0, 388935], [9, 389575], [13, 390175], [20, 390735], [31, 391575], [37, 391875], [41, 392615], [51, 393580], [57, 393800], [63, 394060], [68, 394320], [75, 394660], [78, 394860], [84, 395160], [86, 395300]]}, {"verse": 53, "start": 396806, "end": 407921, "text": "Y Jesús les dijo: De cierto, de cierto os digo: Si no coméis la carne del Hijo del hombre, y bebéis su sangre, no tendréis vida en vosotros.", "words": [[0, 396806], [2, 396930], [8, 397310], [12, 397630], [18, 398761], [21, 399133], [29, 399505], [32, 399877], [39, 400249], [42, 400549], [48, 401360], [51, 401539], [54, 401719], [61, 402179], [64, 402379], [70, 402679], [74, 402979], [79, 403279], [83, 403439], [91, 404059], [93, 404319], [100, 404759], [103, 404919], [111, 405839], [114, 405939], [123, 406559], [128, 406859], [131, 407039]]}, {"verse": 54, "start": 408371, "end": 415984, "text": "El que come mi carne y bebe mi sangre, tiene vida eterna: y yo le resucitaré en el día postrero.", "words": [[0, 408371], [3, 408541], [7, 408701], [12, 409041], [15, 409261], [21, 409781], [23, 410121], [28, 410461], [31, 410621], [39, 411121], [45, 411781], [50, 412141], [58, 413337], [60, 413455], [63, 413635], [66, 413775], [77, 414715], [80, 414835], [83, 414995], [87, 415195]]}, {"verse": 55, "start": 416434, "end": 421071, "text": "Porque mi carne es verdadera comida, y mi sangre es verdadera bebida.", "words": [[0, 416434], [7, 416596], [10, 416816], [16, 417136], [19, 417396], [29, 418036], [37, 418356], [39, 418676], [42, 418796], [49, 419216], [52, 419516], [62, 420396]]}, {"verse": 56, "start": 421521, "end": 427058, "text": "El que come mi carne y bebe mi sangre, en mí permanece, y yo en él.", "words": [[0, 421521], [3, 421683], [7, 421823], [12, 422143], [15, 422363], [21, 422823], [23, 423263], [28, 423563], [31, 423703], [39, 424783], [42, 424903], [45, 425103], [56, 425483], [58, 425863], [61, 426383], [64, 426743]]}, {"verse": 57, "start": 427508, "end": 434739, "text": "Como me envió el Padre viviente, y yo vivo por el Padre, asimismo el que me come, él también vivirá por mí.", "words": [[0, 427508], [5, 427674], [8, 427874], [14, 428194], [17, 428314], [23, 428574], [33, 429534], [35, 429654], [38, 429794], [43, 430034], [47, 430374], [50, 430494], [57, 431284], [66, 432074], [69, 432234], [73, 432354], [76, 432494], [82, 433254], [85, 433394], [93, 433754], [100, 434254], [104, 434414]]}, {"verse": 58, "start": 435189, "end": 446137, "text": "Este es el pan que descendió del cielo: no como vuestros padres comieron el maná, y han muerto: el que come de este pan, vivirá eternamente.", "words": [[0, 435189], [5, 435432], [8, 435592], [11, 435712], [15, 435992], [19, 436212], [29, 436832], [33, 436972], [40, 437937], [43, 438144], [48, 438424], [57, 438864], [64, 439284], [73, 439864], [76, 440084], [82, 440564], [84, 441244], [88, 441424], [96, 442488], [99, 442833], [103, 442993], [108, 443333], [111, 443573], [116, 443773], [121, 444173], [128, 445013]]}, {"verse": 59, "start": 446587, "end": 451124, "text": "Estas cosas dijo en la sinagoga, enseñando en Capernaum.", "words": [[0, 446587], [6, 446769], [12, 447609], [17, 447989], [20, 448169], [23, 448289], [33, 449369], [43, 450149], [46, 450658]]}, {"verse": 60, "start": 451574, "end": 457705, "text": "Y muchos de sus discípulos oyéndolo, dijeron: Dura es esta palabra: ¿quién la puede oír?", "words": [[0, 451574], [2, 451684], [9, 451964], [12, 452204], [16, 452384], [27, 453004], [37, 453684], [46, 454972], [51, 455295], [54, 455535], [59, 455815], [68, 456695], [75, 456901], [78, 456981], [84, 457201]]}, {"verse": 61, "start": 458055, "end": 465651, "text": "Y sabiendo Jesús en sí mismo que sus discípulos murmuraban de esto, les dijo: ¿Esto os escandaliza?", "words": [[0, 458055], [2, 458177], [11, 458657], [17, 459017], [20, 459357], [23, 459557], [29, 459977], [33, 460177], [37, 460397], [48, 461137], [59, 461857], [62, 462117], [68, 462817], [72, 462957], [78, 463751], [84, 464076], [87, 464636]]}, {"verse": 62, "start": 466101, "end": 470066, "text": "¿Pues qué, si veis al Hijo del hombre que sube donde estaba primero?", "words": [[0, 466101], [6, 466373], [11, 466493], [14, 466633], [19, 466993], [22, 467133], [27, 467333], [31, 467553], [38, 467853], [42, 468053], [47, 468633], [53, 469013], [60, 469393]]}, {"verse": 63, "start": 470516, "end": 478766, "text": "El espíritu es el que da vida; la carne nada aprovecha: las palabras que yo os he hablado, son espíritu, y son vida.", "words": [[0, 470516], [3, 470642], [12, 471182], [15, 471282], [18, 471402], [22, 471542], [25, 471662], [31, 472475], [34, 472579], [40, 472959], [45, 473339], [56, 474632], [60, 475052], [69, 475432], [73, 475732], [76, 475992], [79, 476212], [82, 476332], [91, 476852], [95, 477092], [105, 477772], [107, 477892], [111, 478032]]}, {"verse": 64, "start": 479216, "end": 488687, "text": "Pero hay algunos de vosotros que no creen. Porque Jesús desde el principio sabía quiénes eran los que no creían, y quién le había de entregar.", "words": [[0, 479216], [5, 479556], [9, 479776], [17, 480116], [20, 480296], [29, 480676], [33, 480856], [36, 480996], [43, 481981], [50, 482186], [56, 482666], [62, 483166], [65, 483446], [75, 484046], [81, 484626], [89, 485166], [94, 485406], [98, 485646], [102, 485826], [105, 486006], [113, 486606], [115, 487086], [121, 487326], [124, 487546], [130, 487766], [133, 487986]]}, {"verse": 65, "start": 489137, "end": 495384, "text": "Y dijo: Por eso os he dicho que ninguno puede venir a mí, si no le es dado del Padre.", "words": [[0, 489137], [2, 489284], [8, 490058], [12, 490221], [16, 490461], [19, 491021], [22, 491261], [28, 491541], [32, 491681], [40, 492121], [46, 492401], [52, 492741], [54, 492881], [58, 493061], [61, 493601], [64, 493761], [67, 493941], [70, 494141], [75, 494461], [79, 494701]]}, {"verse": 66, "start": 495834, "end": 500492, "text": "Desde esto, muchos de sus discípulos volvieron atrás, y ya no andaban con él.", "words": [[0, 495834], [6, 496061], [12, 496561], [19, 496921], [22, 497141], [26, 497321], [37, 497901], [47, 498401], [54, 498721], [56, 499241], [59, 499421], [62, 499561], [70, 499981], [74, 500161]]}, {"verse": 67, "start": 500942, "end": 505485, "text": "Dijo entonces Jesús a los doce: ¿Queréis vosotros iros también?", "words": [[0, 500942], [5, 501250], [14, 501710], [20, 502130], [22, 502410], [26, 502550], [32, 503401], [41, 503808], [50, 504368], [55, 504788]]}, {"verse": 68, "start": 505935, "end": 511983, "text": "Y le respondió Simón Pedro: Señor, ¿a quién iremos? tú tienes palabras de vida eterna.", "words": [[0, 505935], [2, 506055], [5, 506175], [15, 506795], [21, 507195], [28, 508076], [35, 508891], [38, 508951], [44, 509091], [52, 510058], [55, 510156], [62, 510396], [71, 510816], [74, 511116], [79, 511276]]}, {"verse": 69, "start": 512433, "end": 517648, "text": "Y nosotros creemos y conocemos que tú eres el Cristo, el Hijo de Dios viviente.", "words": [[0, 512433], [2, 512538], [11, 512818], [19, 513458], [21, 513618], [31, 514118], [35, 514338], [38, 514538], [43, 514738], [46, 514878], [54, 515738], [57, 515818], [62, 516038], [65, 516138], [70, 516378]]}, {"verse": 70, "start": 517998, "end": 524762, "text": "Jesús le respondió: ¿No he escogido yo a vosotros doce, y uno de vosotros es diablo?", "words": [[0, 517998], [6, 518286], [9, 518766], [20, 519709], [24, 519875], [27, 520115], [36, 520755], [39, 520955], [41, 521175], [50, 521655], [56, 522855], [58, 522975], [62, 523135], [65, 523255], [74, 523715], [77, 524035]]}, {"verse": 71, "start": 525212, "end": 533959, "text": "Y hablaba de Judas Iscariote, hijo de Simón, porque este era el que le había de entregar, el cual era uno de los doce.", "words": [[0, 525212], [2, 525359], [10, 525759], [13, 525899], [19, 526219], [30, 527719], [35, 528019], [38, 528199], [45, 529039], [52, 529439], [57, 529899], [61, 530219], [64, 530419], [68, 530579], [71, 530739], [77, 530999], [80, 531199], [90, 532079], [93, 532239], [98, 532459], [102, 532779], [106, 533059], [109, 533219], [113, 533379]]}]}