{"book": "MAT", "chapter": 26, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 614565, "verses": [{"verse": 1, "start": 300, "end": 7022, "text": "Y aconteció que, cuando hubo acabado Jesús todas estas palabras, dijo a sus discípulos:", "words": [[0, 300], [2, 442], [12, 1242], [17, 1522], [24, 1782], [29, 2202], [37, 2762], [43, 3122], [49, 3862], [55, 4262], [65, 5482], [70, 5822], [72, 5982], [76, 6142]]}, {"verse": 2, "start": 7472, "end": 14490, "text": "Sabéis que dentro de dos días se hace la pascua, y el Hijo del hombre es entregado para ser crucificado.", "words": [[0, 7472], [7, 8074], [11, 8234], [18, 8494], [21, 8774], [25, 8974], [30, 9294], [33, 9614], [38, 9834], [41, 10034], [49, 10894], [51, 11074], [54, 11194], [59, 11474], [63, 11634], [70, 12054], [73, 12274], [83, 12994], [88, 13194], [92, 13434]]}, {"verse": 3, "start": 14940, "end": 26126, "text": "Entonces los príncipes de los sacerdotes, y los escribas, y los ancianos del pueblo se juntaron al patio del sumo sacerdote, el cual se llamaba Caifás;", "words": [[0, 14940], [9, 15425], [13, 16105], [23, 16725], [26, 16845], [30, 16965], [42, 17765], [44, 17905], [48, 18045], [58, 18725], [60, 19345], [64, 19505], [73, 19985], [77, 20105], [84, 20465], [87, 20665], [96, 21205], [99, 21405], [105, 21785], [109, 22005], [114, 22445], [125, 23505], [128, 23585], [133, 23785], [136, 24025], [144, 25108]]}, {"verse": 4, "start": 26576, "end": 31163, "text": "Y tuvieron consejo para prender por engaño a Jesús, y matarle.", "words": [[0, 26576], [2, 26674], [11, 27054], [19, 27734], [24, 28043], [32, 28354], [36, 28694], [43, 29214], [45, 29313], [52, 29654], [54, 30394]]}, {"verse": 5, "start": 31613, "end": 36611, "text": "Y decían: No en el día de la fiesta, porque no se haga alboroto en el pueblo.", "words": [[0, 31613], [2, 31737], [10, 32727], [13, 32932], [16, 33092], [19, 33192], [23, 33412], [26, 33532], [29, 33652], [37, 34392], [44, 34752], [47, 34932], [50, 35132], [55, 35332], [64, 35852], [67, 35972], [70, 36092]]}, {"verse": 6, "start": 36961, "end": 41758, "text": "Y estando Jesús en Betania, en casa de Simón el leproso,", "words": [[0, 36961], [2, 37125], [10, 37505], [16, 37885], [19, 38185], [28, 39345], [31, 39405], [36, 39705], [39, 39965], [45, 40725], [48, 40845]]}, {"verse": 7, "start": 42208, "end": 52686, "text": "Vino a él una mujer, teniendo un frasco de alabastro con perfume muy costoso, y lo derramó sobre la cabeza de él, estando sentado a la mesa.", "words": [[0, 42208], [5, 42513], [7, 42773], [10, 42953], [14, 43213], [21, 44133], [30, 44733], [33, 44893], [40, 45333], [43, 45473], [53, 46053], [57, 46253], [65, 46713], [69, 47133], [78, 47853], [80, 48333], [83, 48473], [91, 49093], [97, 49353], [100, 49553], [107, 49973], [110, 50193], [114, 50993], [122, 51453], [130, 51973], [132, 52053], [135, 52133]]}, {"verse": 8, "start": 53136, "end": 59181, "text": "Lo cual viendo sus discípulos, se enojaron, diciendo: ¿Por qué se pierde esto?", "words": [[0, 53136], [3, 53262], [8, 53522], [15, 53862], [19, 54162], [31, 55262], [34, 55562], [44, 56822], [54, 57946], [59, 58063], [63, 58203], [66, 58323], [73, 58743]]}, {"verse": 9, "start": 59631, "end": 63194, "text": "Porque esto se podía vender por gran precio, y darse a los pobres.", "words": [[0, 59631], [7, 59828], [12, 60148], [15, 60328], [21, 60608], [28, 60948], [32, 61188], [37, 61408], [45, 61808], [47, 62108], [53, 62428], [55, 62468], [59, 62588]]}, {"verse": 10, "start": 63544, "end": 70439, "text": "Y entendiéndolo Jesús, les dijo: ¿Por qué molestáis a esta mujer? pues ha hecho conmigo buena obra.", "words": [[0, 63544], [2, 64035], [16, 64565], [23, 65005], [27, 65445], [33, 66257], [38, 66382], [42, 66642], [52, 67322], [54, 67502], [59, 67642], [66, 68586], [71, 68710], [74, 68870], [80, 69070], [88, 69570], [94, 69830]]}, {"verse": 11, "start": 70889, "end": 75298, "text": "Porque siempre tendréis pobres con vosotros, pero a mí no siempre me tendréis.", "words": [[0, 70889], [7, 71073], [15, 71393], [24, 71993], [31, 72453], [35, 72693], [45, 73393], [50, 73533], [52, 73653], [55, 73793], [58, 73913], [66, 74273], [69, 74513]]}, {"verse": 12, "start": 75748, "end": 81073, "text": "Porque echando este perfume sobre mi cuerpo, para sepultarme lo ha hecho.", "words": [[0, 75748], [7, 76010], [15, 76590], [20, 76810], [28, 77350], [34, 77750], [37, 77990], [45, 78490], [50, 79310], [61, 80110], [64, 80370], [67, 80550]]}, {"verse": 13, "start": 81523, "end": 91607, "text": "De cierto os digo que dondequiera que se predique este evangelio en todo el mundo, también se contará, en memoria de esta mujer, lo que ella ha hecho.", "words": [[0, 81523], [3, 81767], [10, 82047], [13, 82327], [18, 82647], [22, 82907], [34, 83607], [38, 83827], [41, 83987], [50, 84547], [55, 84927], [65, 85687], [68, 85807], [73, 86007], [76, 86207], [83, 86547], [91, 87247], [94, 87567], [103, 88167], [106, 88747], [114, 89207], [117, 89387], [122, 89567], [129, 90007], [132, 90487], [136, 90647], [141, 90927], [144, 91187]]}, {"verse": 14, "start": 92057, "end": 98803, "text": "Entonces uno de los doce, que se llamaba Judas Iscariote, fue a los príncipes de los sacerdotes,", "words": [[0, 92057], [9, 93058], [13, 93438], [16, 93598], [20, 93758], [26, 94158], [30, 94298], [33, 94438], [41, 94838], [47, 95138], [58, 96038], [62, 96598], [64, 96758], [68, 96858], [78, 97458], [81, 97558], [85, 97698]]}, {"verse": 15, "start": 99253, "end": 106231, "text": "Y les dijo: ¿Qué me queréis dar, y yo os lo entregaré? Y ellos le señalaron treinta piezas de plata.", "words": [[0, 99253], [2, 99376], [6, 99496], [12, 100295], [17, 100395], [20, 100495], [28, 100795], [33, 101095], [35, 101475], [38, 101715], [41, 101815], [44, 101895], [55, 102877], [57, 103065], [63, 103395], [66, 103725], [76, 104325], [84, 104925], [91, 105585], [94, 105685]]}, {"verse": 16, "start": 106681, "end": 110904, "text": "Y desde entonces buscaba oportunidad para entregarle.", "words": [[0, 106681], [2, 106805], [8, 106985], [17, 107665], [25, 108585], [37, 109365], [42, 109825]]}, {"verse": 17, "start": 111354, "end": 121681, "text": "Y el primer día de la fiesta de los panes sin levadura, vinieron los discípulos a Jesús, diciéndole: ¿Dónde quieres que preparemos para ti para comer la pascua?", "words": [[0, 111354], [2, 111480], [5, 111600], [12, 111920], [16, 112240], [19, 112420], [22, 112540], [29, 112920], [32, 113060], [36, 113180], [42, 113620], [46, 113920], [56, 114560], [65, 115420], [69, 115640], [80, 116340], [82, 116520], [89, 116860], [101, 118447], [108, 118730], [116, 119030], [120, 119230], [131, 119770], [136, 119990], [139, 120250], [144, 120550], [150, 120870], [153, 121300]]}, {"verse": 18, "start": 122031, "end": 133842, "text": "Y él dijo: Id a la ciudad a cierto hombre, y decidle: El Maestro dice: Mi tiempo está cerca; en tu casa haré la pascua con mis discípulos.", "words": [[0, 122031], [2, 122221], [5, 122361], [11, 123247], [14, 123347], [16, 123427], [19, 123527], [26, 123847], [28, 124127], [35, 124407], [43, 125047], [45, 125759], [54, 126709], [57, 127037], [65, 127617], [71, 128620], [74, 129316], [81, 129576], [86, 129816], [93, 130851], [96, 130977], [99, 131137], [104, 131457], [109, 131877], [112, 131997], [119, 132477], [123, 132657], [127, 132857]]}, {"verse": 19, "start": 134292, "end": 139786, "text": "Y los discípulos hicieron como Jesús les mandó, y prepararon la pascua.", "words": [[0, 134292], [2, 134398], [6, 134538], [17, 135178], [26, 135898], [31, 136158], [37, 136538], [41, 137038], [48, 137678], [50, 138178], [61, 138918], [64, 139078]]}, {"verse": 20, "start": 140236, "end": 144416, "text": "Y como fue la tarde del día, se sentó a la mesa con los doce.", "words": [[0, 140236], [2, 140516], [7, 140776], [11, 141036], [14, 141196], [20, 141536], [24, 141836], [29, 142476], [32, 142596], [38, 143016], [40, 143076], [43, 143156], [48, 143396], [52, 143636], [56, 143816]]}, {"verse": 21, "start": 144866, "end": 150084, "text": "Y comiendo ellos, dijo: De cierto os digo, que uno de vosotros me ha de entregar.", "words": [[0, 144866], [2, 144990], [11, 145450], [18, 145750], [24, 146818], [27, 146984], [34, 147264], [37, 147544], [43, 147784], [47, 148024], [51, 148224], [54, 148404], [63, 148924], [66, 149164], [69, 149264], [72, 149364]]}, {"verse": 22, "start": 150534, "end": 160283, "text": "Y entristecidos ellos en gran manera, comenzó cada uno de ellos a decirle: ¿Soy yo, Señor?", "words": [[0, 150534], [2, 151206], [16, 151896], [22, 152196], [25, 152476], [30, 152696], [38, 153236], [46, 154156], [51, 154376], [55, 154816], [58, 155036], [64, 155336], [66, 155536], [75, 156613], [80, 156973], [84, 157193]]}, {"verse": 23, "start": 160633, "end": 167944, "text": "Entonces él respondiendo, dijo: El que mete la mano conmigo en el plato, ese me ha de entregar.", "words": [[0, 160633], [9, 161109], [12, 161689], [26, 162849], [32, 163725], [35, 164086], [39, 164266], [44, 164546], [47, 164786], [52, 165066], [60, 165686], [63, 165806], [66, 165926], [73, 166546], [77, 166766], [80, 167026], [83, 167146], [86, 167246]]}, {"verse": 24, "start": 168394, "end": 180653, "text": "A la verdad el Hijo del hombre va, como está escrito de él; pero ¡ay de aquel hombre por quien el Hijo del hombre es entregado! bueno le fuera al tal hombre no haber nacido.", "words": [[0, 168394], [2, 168486], [5, 168586], [12, 168966], [15, 169446], [20, 169746], [24, 169886], [31, 170306], [35, 170546], [40, 171046], [45, 171226], [53, 171546], [56, 171886], [60, 172811], [65, 173146], [69, 173516], [72, 173736], [78, 174096], [85, 174376], [89, 174656], [95, 174996], [98, 175356], [103, 175676], [107, 175836], [114, 176176], [117, 176576], [128, 177725], [134, 178110], [137, 178210], [143, 178430], [146, 178830], [150, 179010], [157, 179370], [160, 179650], [166, 179830]]}, {"verse": 25, "start": 181103, "end": 188566, "text": "Entonces respondiendo Judas, que le entregaba, dijo: ¿Soy yo, Maestro? Le dice: Tú lo has dicho.", "words": [[0, 181103], [9, 182165], [22, 183105], [29, 183505], [33, 183865], [36, 184025], [47, 184765], [53, 185445], [58, 185644], [62, 185784], [71, 186783], [74, 186950], [80, 187715], [83, 187842], [86, 187962], [90, 188082]]}, {"verse": 26, "start": 189016, "end": 197490, "text": "Y comiendo ellos, tomó Jesús el pan, y bendijo, y lo partió, y dio a sus discípulos, y dijo: Tomad, comed: esto es mi cuerpo.", "words": [[0, 189016], [2, 189114], [11, 189574], [18, 189834], [23, 190254], [29, 190494], [32, 190834], [37, 191074], [39, 191294], [48, 191994], [50, 192034], [53, 192154], [61, 192814], [63, 192874], [67, 193074], [69, 193234], [73, 193394], [85, 194414], [87, 194494], [93, 195212], [100, 195821], [107, 196722], [112, 196968], [115, 197048], [118, 197269]]}, {"verse": 27, "start": 197940, "end": 204572, "text": "Y tomando la copa, y hechas gracias, les dio, diciendo: Bebed de ella todos;", "words": [[0, 198085], [2, 198531], [10, 198936], [13, 199076], [19, 199536], [21, 199636], [28, 199916], [37, 200856], [41, 201036], [46, 201356], [56, 202965], [62, 203255], [65, 203545], [70, 203835]]}, {"verse": 28, "start": 205022, "end": 211628, "text": "Porque esto es mi sangre del nuevo pacto, la cual es derramada por muchos para perdón de los pecados.", "words": [[0, 205022], [7, 205269], [12, 205709], [15, 205889], [18, 206069], [25, 206489], [29, 206769], [35, 207029], [42, 207989], [45, 208049], [50, 208229], [53, 208409], [63, 209069], [67, 209309], [74, 209709], [79, 210009], [86, 210529], [89, 210669], [93, 210789]]}, {"verse": 29, "start": 212078, "end": 221627, "text": "Y os digo, que desde ahora no beberé más de este fruto de la vid, hasta aquel día, cuando lo beba nuevo con vosotros en el reino de mi Padre.", "words": [[0, 212078], [2, 212204], [5, 212324], [11, 212604], [15, 212844], [21, 213224], [27, 213684], [30, 214064], [37, 214544], [41, 214924], [44, 215304], [49, 215524], [55, 215984], [58, 216144], [61, 216514], [66, 216884], [72, 217164], [78, 217504], [83, 218104], [90, 218264], [93, 218484], [98, 218764], [104, 219024], [108, 219304], [117, 219944], [120, 220224], [123, 220364], [129, 220804], [132, 220944], [135, 221064]]}, {"verse": 30, "start": 222077, "end": 226652, "text": "Y habiendo cantado el himno, salieron al monte de los Olivos.", "words": [[0, 222077], [2, 222204], [11, 222564], [19, 223224], [22, 223404], [29, 224284], [38, 224924], [41, 225124], [47, 225444], [50, 225664], [54, 225804]]}, {"verse": 31, "start": 227102, "end": 237935, "text": "Entonces Jesús les dice: Todos vosotros me abandonaréis esta noche; porque escrito está: Heriré al Pastor, y las ovejas de la manada serán dispersas.", "words": [[0, 227102], [9, 228102], [15, 228331], [19, 228560], [25, 229085], [31, 229410], [40, 230070], [43, 230270], [56, 231110], [61, 231370], [68, 232377], [75, 232547], [83, 232947], [89, 233749], [96, 234224], [99, 234364], [107, 234804], [109, 235384], [113, 235544], [120, 235984], [123, 236104], [126, 236204], [133, 236584], [139, 236964]]}, {"verse": 32, "start": 238385, "end": 243068, "text": "Pero después que haya resucitado, iré delante de vosotros a Galilea.", "words": [[0, 238385], [5, 238527], [13, 238867], [17, 239047], [22, 239247], [34, 240227], [38, 240927], [46, 241347], [49, 241527], [58, 242047], [60, 242307]]}, {"verse": 33, "start": 243518, "end": 249030, "text": "Y respondiendo Pedro, le dijo: Aunque todos te abandonen, yo nunca te abandonaré.", "words": [[0, 243518], [2, 243799], [15, 244739], [22, 245039], [25, 245259], [31, 246074], [38, 246291], [44, 246611], [47, 246811], [58, 247611], [61, 247871], [67, 248131], [70, 248351]]}, {"verse": 34, "start": 249380, "end": 257740, "text": "Jesús le dice: De cierto te digo que esta noche, antes que el gallo cante, me negarás tres veces.", "words": [[0, 249380], [6, 249751], [9, 250271], [15, 251143], [18, 251310], [25, 251610], [28, 252010], [33, 252330], [37, 252530], [42, 252810], [49, 253530], [55, 254130], [59, 254350], [62, 254570], [68, 254930], [75, 255610], [78, 255810], [86, 256350], [91, 256730]]}, {"verse": 35, "start": 258190, "end": 265451, "text": "Le dice Pedro: Aunque me sea necesario morir contigo, no te negaré. Y todos los discípulos dijeron lo mismo.", "words": [[0, 258190], [3, 258295], [8, 258555], [15, 259397], [22, 259599], [25, 259799], [29, 259999], [39, 260539], [45, 260939], [54, 261719], [57, 261919], [60, 262079], [68, 262975], [70, 263100], [76, 263380], [80, 263660], [91, 264300], [99, 264880], [102, 264980]]}, {"verse": 36, "start": 265901, "end": 274850, "text": "Entonces llegó Jesús con ellos al lugar llamado Getsemaní, y dice a sus discípulos: Sentaos aquí, hasta que vaya allí y ore.", "words": [[0, 265901], [9, 266350], [15, 266770], [21, 267130], [25, 267410], [31, 267610], [34, 267870], [40, 268190], [48, 268650], [59, 270010], [61, 270310], [66, 270550], [68, 270710], [72, 270850], [84, 272182], [92, 272482], [98, 272842], [104, 273342], [108, 273542], [113, 273762], [118, 274162], [120, 274422]]}, {"verse": 37, "start": 275300, "end": 283184, "text": "Y tomando a Pedro, y a los dos hijos de Zebedeo, comenzó a entristecerse y a angustiarse en gran manera.", "words": [[0, 275300], [2, 275421], [10, 275841], [12, 275961], [19, 276821], [21, 277161], [23, 277221], [27, 277381], [31, 277521], [37, 277841], [40, 278441], [49, 279041], [57, 279761], [59, 279921], [73, 281081], [75, 281241], [77, 281361], [89, 282141], [92, 282321], [97, 282501]]}, {"verse": 38, "start": 283634, "end": 290921, "text": "Entonces Jesús les dice: Mi alma está muy triste hasta la muerte; quedaos aquí, y velad conmigo.", "words": [[0, 283634], [9, 284634], [15, 284863], [19, 285092], [25, 286325], [28, 286485], [33, 286705], [38, 286985], [42, 287185], [49, 287565], [55, 287785], [58, 287925], [66, 288828], [74, 289310], [80, 289610], [82, 289870], [88, 290190]]}, {"verse": 39, "start": 291371, "end": 303680, "text": "Y yéndose un poco más adelante, se postró sobre su rostro, orando, y diciendo: Padre mío, si es posible, pase de mí esta copa; pero no como yo quiero, sino como tú.", "words": [[0, 291538], [2, 291738], [10, 291938], [13, 292078], [18, 292298], [22, 292538], [32, 293078], [35, 293318], [42, 293878], [48, 294138], [51, 294358], [59, 294998], [67, 295798], [69, 296098], [79, 297143], [85, 297488], [90, 298188], [93, 298308], [96, 298448], [105, 299368], [110, 299848], [113, 300088], [116, 300308], [121, 300548], [127, 301449], [132, 301617], [135, 301837], [140, 302057], [143, 302237], [151, 302597], [156, 302897], [161, 303197]]}, {"verse": 40, "start": 304130, "end": 311340, "text": "Y vino a sus discípulos, y los halló durmiendo, y dijo a Pedro: ¿Así no habéis podido velar conmigo una hora?", "words": [[0, 304130], [2, 304453], [7, 304673], [9, 304833], [13, 305013], [25, 305693], [27, 306173], [31, 306313], [37, 306653], [48, 307233], [50, 307333], [55, 307533], [57, 307673], [64, 308410], [69, 308750], [72, 308970], [79, 309270], [86, 309670], [92, 310030], [100, 310610], [104, 310790]]}, {"verse": 41, "start": 311790, "end": 319313, "text": "Velad y orad, para que no entréis en tentación: el espíritu está dispuesto, pero la carne es débil.", "words": [[0, 311790], [6, 312258], [8, 312478], [14, 312798], [19, 313078], [23, 313238], [26, 313438], [34, 313898], [37, 314098], [48, 315269], [51, 315589], [60, 316169], [65, 316349], [76, 317569], [81, 317849], [84, 318029], [90, 318389], [93, 318649]]}, {"verse": 42, "start": 319763, "end": 329444, "text": "Otra vez fue, segunda vez, y oró diciendo: Padre mío, si no puede esta copa pasar de mí sin que yo la beba, hágase tu voluntad.", "words": [[0, 319763], [5, 320013], [9, 320353], [14, 320553], [22, 320973], [27, 321433], [29, 321893], [33, 322353], [43, 323647], [49, 323932], [54, 324372], [57, 324472], [60, 324692], [66, 324912], [71, 325192], [76, 325612], [82, 325912], [85, 326132], [88, 326292], [92, 326512], [96, 326732], [99, 326912], [102, 327072], [108, 327912], [115, 328332], [118, 328532]]}, {"verse": 43, "start": 329894, "end": 335798, "text": "Y vino, y los halló otra vez durmiendo; porque tenían los ojos pesados de sueño.", "words": [[0, 329894], [2, 330019], [8, 330359], [10, 330919], [14, 331099], [20, 331539], [25, 331799], [29, 332059], [40, 333225], [47, 333529], [54, 333869], [58, 334049], [63, 334369], [71, 334949], [74, 335149]]}, {"verse": 44, "start": 336248, "end": 342129, "text": "Y dejándolos se fue de nuevo y oró por tercera vez, diciendo las mismas palabras.", "words": [[0, 336248], [2, 336378], [13, 337158], [16, 337298], [20, 337498], [23, 337638], [29, 337958], [31, 338318], [35, 338518], [39, 338858], [47, 339518], [52, 340238], [61, 340618], [65, 340978], [72, 341358]]}, {"verse": 45, "start": 342579, "end": 355136, "text": "Entonces vino a sus discípulos y les dice: Dormid ya, y descansad: he aquí ha llegado la hora, y el Hijo del hombre es entregado en manos de pecadores.", "words": [[0, 342579], [9, 343268], [14, 343908], [16, 344228], [20, 344468], [31, 345348], [33, 345528], [37, 345688], [43, 347237], [50, 347237], [54, 347557], [56, 348267], [67, 349268], [70, 349435], [75, 349855], [78, 350095], [86, 350575], [89, 350755], [95, 351335], [97, 351735], [100, 351875], [105, 352155], [109, 352315], [116, 352735], [119, 352855], [129, 353535], [132, 353655], [138, 353935], [141, 354155]]}, {"verse": 46, "start": 355586, "end": 360043, "text": "Levantaos, vamos: he aquí ha llegado el que me ha entregado.", "words": [[0, 355586], [11, 356694], [18, 357657], [21, 357802], [26, 358022], [29, 358162], [37, 358602], [40, 358762], [44, 358942], [47, 359122], [50, 359222]]}, {"verse": 47, "start": 360493, "end": 374597, "text": "Y hablando aún él, he aquí Judas, uno de los doce, vino, y con él mucha gente con espadas y con palos, de parte de los príncipes de los sacerdotes, y de los ancianos del pueblo.", "words": [[0, 360493], [2, 360631], [11, 360891], [15, 361331], [19, 361831], [22, 362571], [27, 362811], [34, 363971], [38, 364291], [41, 364471], [45, 364611], [51, 365691], [57, 366011], [59, 366631], [63, 366871], [66, 367031], [72, 367271], [78, 367691], [82, 367931], [90, 368471], [92, 368671], [96, 368871], [103, 369531], [106, 369911], [112, 370171], [115, 370411], [119, 370551], [129, 371291], [132, 371411], [136, 371551], [148, 372838], [150, 372961], [153, 373061], [157, 373181], [166, 373781], [170, 373941]]}, {"verse": 48, "start": 375047, "end": 382540, "text": "Y el que le entregaba les había dado señal, diciendo: Al que yo bese, aquel es: prendedle.", "words": [[0, 375047], [2, 375190], [5, 375330], [9, 375510], [12, 375710], [22, 376490], [26, 376850], [32, 377270], [37, 377530], [44, 378750], [54, 379873], [57, 380040], [61, 380356], [64, 380672], [70, 380988], [76, 381304], [80, 382209]]}, {"verse": 49, "start": 382890, "end": 387855, "text": "Y luego que llegó a Jesús, dijo: Salve, Maestro. Y le besó.", "words": [[0, 382890], [2, 383034], [8, 383214], [12, 383494], [18, 383774], [20, 383934], [27, 384794], [33, 385654], [40, 386053], [49, 387017], [51, 387159], [54, 387279]]}, {"verse": 50, "start": 388305, "end": 396687, "text": "Y Jesús le dijo: Amigo, ¿a qué vienes? Entonces llegaron, y echaron mano a Jesús, y le prendieron.", "words": [[0, 388305], [2, 388453], [8, 388853], [11, 389193], [17, 390030], [24, 390615], [27, 390715], [31, 390815], [39, 391788], [48, 392275], [58, 393275], [60, 393595], [68, 394075], [73, 394415], [75, 394615], [82, 394955], [84, 395635], [87, 395755]]}, {"verse": 51, "start": 397137, "end": 407422, "text": "Y he aquí, uno de los que estaban con Jesús, extendiendo la mano, sacó su espada, e hiriendo a un siervo del sumo sacerdote, le quitó la oreja.", "words": [[0, 397137], [2, 397315], [5, 397415], [11, 397675], [15, 397975], [18, 398135], [22, 398255], [26, 398395], [34, 398695], [38, 398955], [45, 399835], [57, 400595], [60, 400755], [66, 401655], [71, 401995], [74, 402135], [82, 402675], [84, 403095], [93, 403655], [95, 403855], [98, 403975], [105, 404535], [109, 404695], [114, 405215], [125, 406255], [128, 406355], [134, 406715], [137, 406835]]}, {"verse": 52, "start": 407872, "end": 417167, "text": "Entonces Jesús le dice: Vuelve tu espada a su lugar; porque todos los que tomen espada, a espada perecerán.", "words": [[0, 407872], [9, 408461], [15, 409141], [18, 409641], [24, 410476], [31, 410862], [34, 411022], [41, 411582], [43, 411822], [46, 412002], [53, 412883], [60, 413065], [66, 413505], [70, 413805], [74, 413945], [80, 414325], [88, 415185], [90, 415425], [97, 416045]]}, {"verse": 53, "start": 417617, "end": 424170, "text": "¿Acaso piensas que no puedo ahora orar a mi Padre, y él me daría más de doce legiones de ángeles?", "words": [[0, 417617], [7, 418127], [15, 418547], [19, 418687], [22, 418867], [28, 419227], [34, 419617], [39, 420007], [41, 420087], [44, 420227], [51, 420647], [53, 421227], [56, 421447], [59, 421627], [65, 422027], [69, 422207], [72, 422534], [77, 422860], [86, 423187], [89, 423407]]}, {"verse": 54, "start": 424620, "end": 429175, "text": "¿Cómo, pues, se cumplirían las Escrituras, que así conviene que sea hecho?", "words": [[0, 424620], [7, 425034], [13, 425474], [16, 425994], [27, 426634], [31, 426814], [43, 427474], [47, 427634], [51, 427794], [60, 428254], [64, 428374], [68, 428614]]}, {"verse": 55, "start": 429625, "end": 441416, "text": "En aquella hora dijo Jesús a la gente: ¿Como a ladrón habéis salido con espadas y con palos a prenderme? Cada día me sentaba con vosotros enseñando en el templo, y no me prendisteis.", "words": [[0, 429625], [3, 429766], [11, 430146], [16, 430366], [21, 430666], [27, 431006], [29, 431286], [32, 431346], [39, 432181], [45, 432325], [47, 432505], [54, 432865], [61, 433165], [68, 433605], [72, 433805], [80, 434265], [82, 434445], [86, 434645], [92, 435125], [94, 435265], [105, 436248], [110, 436392], [114, 436692], [117, 436852], [125, 437312], [129, 437512], [138, 438052], [148, 438912], [151, 439012], [154, 439172], [162, 439932], [164, 440092], [167, 440212], [170, 440352]]}, {"verse": 56, "start": 441866, "end": 451445, "text": "Pero todo esto se hace, para que se cumplan las Escrituras de los profetas. Entonces todos los discípulos huyeron, dejándole.", "words": [[0, 441866], [5, 442008], [10, 442308], [15, 442628], [18, 442908], [24, 443288], [29, 443988], [33, 444168], [36, 444328], [44, 444948], [48, 445208], [59, 445908], [62, 446028], [66, 446148], [76, 447249], [85, 447853], [91, 448593], [95, 448873], [106, 449593], [115, 450493]]}, {"verse": 57, "start": 451895, "end": 460469, "text": "Y ellos, prendido Jesús, le llevaron al sumo sacerdote Caifás, donde los escribas y los ancianos estaban juntos.", "words": [[0, 451895], [2, 452075], [9, 452625], [18, 453175], [25, 453765], [28, 454355], [37, 454835], [40, 454975], [45, 455575], [55, 456315], [63, 457235], [69, 457475], [73, 457755], [82, 458375], [84, 458535], [88, 458695], [97, 459275], [105, 459615]]}, {"verse": 58, "start": 460919, "end": 470315, "text": "Pero Pedro le seguía de lejos hasta el patio del sumo sacerdote; y entrando dentro, se estaba sentado con los criados, para ver el fin.", "words": [[0, 460919], [5, 461159], [11, 461459], [14, 461679], [21, 462079], [24, 462179], [30, 462499], [36, 462759], [39, 462939], [45, 463299], [49, 463499], [54, 464019], [65, 465200], [67, 465344], [76, 465904], [84, 466244], [87, 466564], [94, 466904], [102, 467544], [106, 467724], [110, 467904], [119, 469024], [124, 469304], [128, 469504], [131, 469664]]}, {"verse": 59, "start": 470765, "end": 481021, "text": "Y los príncipes de los sacerdotes, y los ancianos, y todo el consejo, buscaban falso testimonio contra Jesús, para entregarle a la muerte;", "words": [[0, 470765], [2, 470893], [6, 471013], [16, 471852], [19, 471972], [23, 472133], [35, 473013], [37, 473412], [41, 473593], [51, 474313], [53, 474693], [58, 474932], [61, 475112], [70, 475833], [79, 476612], [85, 477112], [96, 477912], [103, 478273], [110, 478732], [115, 479513], [126, 480273], [128, 480352], [131, 480432]]}, {"verse": 60, "start": 481471, "end": 488216, "text": "Y no lo hallaron, aunque muchos testigos falsos se llegaban; pero al fin vinieron dos testigos falsos,", "words": [[0, 481471], [2, 481593], [5, 481753], [8, 481893], [18, 482633], [25, 482813], [32, 483173], [41, 483713], [48, 484253], [51, 484393], [61, 485464], [66, 485626], [69, 485746], [73, 485946], [82, 486466], [86, 486746], [95, 487346]]}, {"verse": 61, "start": 488666, "end": 493900, "text": "Que dijeron: Este dijo: Puedo derribar el templo de Dios, y en tres días reedificarlo.", "words": [[0, 488666], [4, 488770], [13, 489724], [18, 489944], [24, 490698], [30, 490887], [39, 491367], [42, 491467], [49, 491847], [52, 491887], [58, 492127], [60, 492407], [63, 492527], [68, 492727], [73, 493337]]}, {"verse": 62, "start": 494250, "end": 501207, "text": "Y levantándose el sumo sacerdote, le dijo: ¿No respondes nada? ¿qué testifican estos contra ti?", "words": [[0, 494250], [2, 494375], [15, 495335], [18, 495555], [23, 496035], [34, 497075], [37, 497255], [43, 497990], [47, 498136], [57, 498696], [63, 499479], [68, 499575], [79, 500215], [85, 500415], [92, 500815]]}, {"verse": 63, "start": 501557, "end": 510875, "text": "Pero Jesús callaba. Respondiendo el sumo sacerdote, le dijo: Te conjuro por el Dios viviente, que nos digas si eres tú el Cristo, Hijo de Dios.", "words": [[0, 501557], [5, 501725], [11, 502045], [20, 503616], [33, 503976], [36, 504116], [41, 504536], [52, 505336], [55, 505396], [61, 506204], [64, 506303], [72, 506803], [76, 506983], [79, 507103], [84, 507283], [94, 507803], [98, 507983], [102, 508253], [108, 508523], [111, 508703], [116, 508943], [119, 509183], [122, 509343], [130, 510023], [135, 510163], [138, 510323]]}, {"verse": 64, "start": 511225, "end": 524757, "text": "Jesús le dijo: Tú lo has dicho: y aun os digo, que desde ahora habéis de ver al Hijo del hombre sentado a la diestra del poder de Dios, y que viene en las nubes del cielo.", "words": [[0, 511225], [6, 511698], [9, 512138], [15, 512991], [18, 513115], [21, 513255], [25, 513395], [32, 514200], [34, 514322], [38, 514522], [41, 514742], [47, 515602], [51, 515822], [57, 516082], [63, 516522], [70, 517062], [73, 517242], [77, 517422], [80, 517582], [85, 517862], [89, 518062], [96, 518422], [104, 519102], [106, 519242], [109, 519322], [117, 519782], [121, 520022], [127, 520422], [130, 520722], [136, 521122], [138, 521982], [142, 522142], [148, 522502], [151, 522842], [155, 523022], [161, 523762], [165, 524042]]}, {"verse": 65, "start": 525207, "end": 536433, "text": "Entonces el sumo sacerdote rasgó sus vestidos, diciendo: Ha blasfemado: ¿qué más necesidad tenemos de testigos? He aquí, ahora habéis oído su blasfemia.", "words": [[0, 525207], [9, 526446], [12, 526566], [17, 526946], [27, 527626], [33, 528526], [37, 528726], [47, 529406], [57, 530914], [60, 531268], [72, 531874], [77, 531978], [81, 532158], [91, 532778], [99, 533098], [102, 533298], [112, 534347], [115, 534417], [121, 534637], [127, 534937], [134, 535277], [139, 535537], [142, 535697]]}, {"verse": 66, "start": 536883, "end": 541584, "text": "¿Qué os parece? Y respondiendo ellos, dijeron: Culpado es de muerte.", "words": [[0, 536883], [5, 536979], [8, 537079], [16, 537989], [18, 538384], [31, 538814], [38, 539354], [47, 540258], [55, 540741], [58, 540861], [61, 541001]]}, {"verse": 67, "start": 541934, "end": 549668, "text": "Entonces le escupieron en el rostro, y le dieron de bofetadas; y otros le herían con puñetazos,", "words": [[0, 541934], [9, 542475], [12, 543175], [23, 543855], [26, 544055], [29, 544215], [37, 544795], [39, 545175], [42, 545295], [49, 545805], [52, 546315], [63, 547067], [65, 547212], [71, 547512], [74, 548012], [81, 548352], [85, 548572]]}, {"verse": 68, "start": 550118, "end": 554195, "text": "Diciendo: Profetízanos tú, Cristo, quién es el que te ha herido.", "words": [[0, 550118], [10, 551731], [23, 552051], [27, 552211], [35, 552991], [41, 553151], [44, 553311], [47, 553431], [51, 553551], [54, 553691], [57, 553771]]}, {"verse": 69, "start": 554545, "end": 563570, "text": "Y Pedro estaba sentado fuera en el patio: y se llegó a él una criada, diciendo: Y tú con Jesús el galileo estabas.", "words": [[0, 554545], [2, 554671], [8, 555011], [15, 555411], [23, 556071], [29, 556351], [32, 556611], [35, 556751], [42, 557790], [44, 558044], [47, 558164], [53, 558504], [55, 558684], [58, 558844], [62, 559124], [70, 559784], [80, 560918], [82, 561068], [85, 561228], [89, 561468], [95, 561928], [98, 562348], [106, 562868]]}, {"verse": 70, "start": 563920, "end": 568620, "text": "Pero él negó delante de todos, diciendo: No sé lo que dices.", "words": [[0, 563920], [5, 564082], [8, 564322], [13, 564722], [21, 565142], [24, 565322], [31, 566222], [41, 567373], [44, 567557], [47, 567797], [50, 567937], [54, 568057]]}, {"verse": 71, "start": 568970, "end": 577124, "text": "Y saliendo él a la puerta, le vio otra, y dijo a los que estaban allí: También este estaba con Jesús nazareno.", "words": [[0, 568970], [2, 569075], [11, 569535], [14, 569735], [16, 569815], [19, 569935], [27, 570435], [30, 571215], [34, 571455], [40, 571915], [42, 572595], [47, 572895], [49, 573055], [53, 573175], [57, 573315], [65, 573655], [71, 574429], [79, 574729], [84, 575009], [91, 575309], [95, 575549], [101, 575829]]}, {"verse": 72, "start": 577474, "end": 584127, "text": "Y negó otra vez con juramento: No conozco al hombre.", "words": [[0, 577474], [2, 577598], [7, 577938], [12, 578418], [16, 578918], [20, 579338], [31, 580650], [34, 580805], [42, 581245], [45, 581365]]}, {"verse": 73, "start": 584477, "end": 593866, "text": "Y un poco después llegaron los que estaban por allí, y dijeron a Pedro: Verdaderamente también tú eres de ellos, porque aun tu habla te hace manifiesto.", "words": [[0, 584477], [2, 584596], [5, 584716], [10, 584936], [18, 585836], [27, 586456], [31, 586616], [35, 586736], [43, 587016], [47, 587296], [53, 587596], [55, 588156], [63, 588576], [65, 588656], [72, 589482], [87, 590166], [95, 590466], [98, 590806], [103, 591026], [106, 591186], [113, 591746], [120, 592146], [124, 592366], [127, 592566], [133, 592786], [136, 593026], [141, 593186]]}, {"verse": 74, "start": 594216, "end": 603502, "text": "Entonces comenzó a maldecir, y a jurar, diciendo: No conozco al hombre. Y el gallo cantó luego.", "words": [[0, 594216], [9, 594646], [17, 595386], [19, 595446], [29, 595986], [31, 596186], [33, 596306], [40, 596746], [50, 597973], [53, 598128], [61, 598568], [64, 598688], [72, 601801], [74, 601927], [77, 602137], [83, 602347], [89, 602907]]}, {"verse": 75, "start": 603952, "end": 614165, "text": "Y se acordó Pedro de las palabras de Jesús, que le dijo: Antes que cante el gallo, me negarás tres veces. Y saliendo fuera, lloró amargamente.", "words": [[0, 603952], [2, 604091], [5, 604211], [12, 604691], [18, 605191], [21, 605411], [25, 605551], [34, 605911], [37, 606131], [44, 606491], [48, 606791], [51, 606931], [57, 607707], [63, 608167], [67, 608367], [73, 608787], [76, 608847], [83, 609347], [86, 609667], [94, 609987], [99, 610227], [106, 611112], [108, 611218], [117, 611678], [124, 612058], [130, 612898]]}]}