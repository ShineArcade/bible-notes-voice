{"book": "ACT", "chapter": 4, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 300359, "verses": [{"verse": 1, "start": 300, "end": 8677, "text": "Y hablando ellos al pueblo, sobrevinieron los sacerdotes, y el jefe de la guardia del templo, y los saduceos,", "words": [[0, 300], [2, 422], [11, 662], [17, 1062], [20, 1342], [28, 2102], [42, 3022], [46, 3262], [58, 4182], [60, 4662], [63, 4802], [68, 5242], [71, 5342], [74, 5442], [82, 5922], [86, 6102], [94, 7122], [96, 7282], [100, 7502]]}, {"verse": 2, "start": 9027, "end": 15523, "text": "Resentidos de que enseñasen al pueblo, y anunciasen en Jesús la resurrección de los muertos.", "words": [[0, 9027], [11, 9808], [14, 9968], [18, 10378], [28, 10788], [31, 10908], [39, 11328], [41, 11988], [52, 12648], [55, 12748], [61, 13128], [64, 13648], [77, 14488], [80, 14668], [84, 14788]]}, {"verse": 3, "start": 15873, "end": 21656, "text": "Y les echaron mano, y los pusieron en la cárcel hasta el día siguiente; porque era ya tarde.", "words": [[0, 15873], [2, 15999], [6, 16139], [14, 16599], [20, 16979], [22, 17204], [26, 17304], [35, 17804], [38, 17964], [41, 18104], [48, 18624], [54, 18904], [57, 19084], [61, 19284], [72, 20353], [79, 20617], [83, 20837], [86, 20997]]}, {"verse": 4, "start": 22006, "end": 28495, "text": "Pero muchos de los que habían oído la palabra, creyeron; y fue el número de los varones como cinco mil.", "words": [[0, 22006], [5, 22210], [12, 22850], [15, 23230], [19, 23370], [23, 23530], [30, 23790], [35, 24110], [38, 24270], [47, 24650], [57, 25610], [59, 25736], [63, 25956], [66, 26316], [73, 26636], [76, 26856], [80, 27016], [88, 27376], [93, 27762], [99, 28148]]}, {"verse": 5, "start": 28845, "end": 36233, "text": "Y aconteció al día siguiente, que se juntaron en Jerusalén los príncipes de ellos, y los ancianos, y los escribas;", "words": [[0, 28845], [2, 28950], [12, 29690], [15, 29830], [19, 29990], [30, 30430], [34, 30710], [37, 30870], [46, 31550], [49, 31690], [59, 32430], [63, 32655], [73, 33335], [76, 33515], [83, 33815], [85, 34275], [89, 34435], [99, 35015], [101, 35235], [105, 35395]]}, {"verse": 6, "start": 36583, "end": 45389, "text": "Y Anás, sumo sacerdote, y Caifás, y Juan y Alejandro, y todos los que eran del linaje sacerdotal;", "words": [[0, 36583], [2, 36747], [8, 37167], [13, 37887], [24, 38687], [26, 39267], [34, 40027], [36, 40627], [41, 40947], [43, 41247], [54, 41887], [56, 42467], [62, 42747], [66, 43047], [70, 43287], [75, 43567], [79, 43847], [86, 44347]]}, {"verse": 7, "start": 45739, "end": 53196, "text": "Y haciéndolos presentar en medio, les preguntaron: ¿Con qué potestad, o en qué nombre, habéis hecho vosotros esto?", "words": [[0, 45739], [2, 46039], [14, 46719], [24, 47399], [27, 47519], [34, 48339], [38, 48559], [51, 49529], [56, 49693], [60, 49973], [70, 50253], [72, 50533], [75, 50693], [79, 50833], [87, 51213], [94, 51933], [100, 52153], [109, 52653]]}, {"verse": 8, "start": 53476, "end": 59488, "text": "Entonces Pedro, lleno del Espíritu Santo, les dijo: Príncipes del pueblo, y ancianos de Israel:", "words": [[0, 53476], [9, 54401], [16, 54701], [22, 55001], [26, 55301], [35, 55861], [42, 56141], [46, 56401], [52, 57132], [62, 57583], [66, 57763], [74, 58103], [76, 58323], [85, 58843], [88, 58943]]}, {"verse": 9, "start": 59838, "end": 66123, "text": "Pues que somos hoy interrogados acerca del beneficio hecho a un hombre enfermo, de qué manera este haya sido sanado,", "words": [[0, 59838], [5, 59958], [9, 60078], [15, 60358], [19, 60658], [32, 61338], [39, 61638], [43, 61958], [53, 62578], [59, 62798], [61, 62978], [64, 63098], [71, 63318], [80, 64098], [83, 64258], [87, 64378], [94, 64638], [99, 65038], [104, 65278], [109, 65538]]}, {"verse": 10, "start": 66473, "end": 79904, "text": "Sea notorio a todos vosotros, y a todo el pueblo de Israel, que en el nombre de Jesucristo de Nazaret, al que vosotros crucificasteis y Dios le resucitó de los muertos, por él este hombre está en vuestra presencia sano.", "words": [[0, 66473], [4, 66648], [12, 67168], [14, 67288], [20, 67528], [30, 68168], [32, 68433], [34, 68493], [39, 68693], [42, 68833], [49, 69033], [52, 69213], [60, 69613], [64, 70013], [67, 70113], [70, 70213], [77, 70513], [80, 70673], [91, 71333], [94, 71453], [103, 72769], [106, 72926], [110, 73046], [119, 73446], [134, 74606], [136, 74826], [141, 75046], [144, 75286], [153, 75886], [156, 75966], [160, 76106], [169, 77046], [173, 77246], [176, 77406], [181, 77786], [188, 78066], [193, 78346], [196, 78486], [204, 78866], [214, 79386]]}, {"verse": 11, "start": 80254, "end": 86423, "text": "Este es la piedra rechazada por vosotros los edificadores, la cual es puesta por cabeza del ángulo.", "words": [[0, 80254], [5, 80537], [8, 80777], [11, 80957], [18, 81357], [28, 81997], [32, 82197], [41, 82697], [45, 82917], [59, 84197], [62, 84297], [67, 84564], [70, 84830], [77, 85097], [81, 85317], [88, 85657], [92, 85897]]}, {"verse": 12, "start": 86773, "end": 94635, "text": "Y en ningún otro hay salvación; porque no hay otro nombre debajo del cielo, dado a los hombres, en que podamos ser salvos.", "words": [[0, 86773], [2, 86898], [5, 86998], [12, 87338], [17, 87678], [21, 87978], [32, 88983], [39, 89194], [42, 89434], [46, 89634], [51, 89894], [58, 90314], [65, 90794], [69, 90994], [76, 91414], [81, 91954], [83, 92154], [87, 92274], [96, 92634], [99, 93174], [103, 93314], [111, 93734], [115, 93954]]}, {"verse": 13, "start": 94915, "end": 107733, "text": "Entonces viendo la valentía de Pedro y de Juan, sabido que eran hombres sin formación y del pueblo común, se maravillaban; y reconocían que habían estado con Jesús.", "words": [[0, 94915], [9, 96028], [16, 96348], [19, 96588], [28, 97228], [31, 97348], [37, 97868], [39, 98048], [42, 98148], [48, 98908], [55, 99408], [59, 99608], [64, 99848], [72, 100368], [76, 100848], [86, 101588], [88, 102068], [92, 102228], [99, 102548], [106, 103388], [109, 103608], [123, 104788], [125, 105028], [136, 105948], [140, 106168], [147, 106428], [154, 106728], [158, 107048]]}, {"verse": 14, "start": 108083, "end": 114057, "text": "Y viendo al hombre que había sido sanado, que estaba con ellos, no podían decir nada en contra.", "words": [[0, 108083], [2, 108225], [9, 108545], [12, 108745], [19, 108985], [23, 109185], [29, 109385], [34, 109705], [42, 110345], [46, 110385], [53, 110605], [57, 110905], [64, 111665], [67, 112045], [74, 112485], [80, 112785], [85, 113145], [88, 113365]]}, {"verse": 15, "start": 114407, "end": 119650, "text": "Pero les mandaron que se saliesen fuera del Consejo; y deliberaban entre sí,", "words": [[0, 114407], [5, 114542], [9, 114712], [18, 115192], [22, 115372], [25, 115512], [34, 116052], [40, 116372], [44, 116652], [53, 117981], [55, 117981], [67, 118788], [73, 119108]]}, {"verse": 16, "start": 120000, "end": 130370, "text": "Diciendo: ¿Qué hemos de hacer a estos hombres? porque de cierto, señal manifiesta ha sido hecha por ellos, notoria a todos los que moran en Jerusalén, y no lo podemos negar.", "words": [[0, 120000], [10, 121068], [15, 121223], [21, 121463], [24, 121683], [30, 121863], [32, 122023], [38, 122183], [47, 123046], [54, 123269], [57, 123429], [65, 123649], [71, 124229], [82, 124909], [85, 125029], [90, 125209], [96, 125489], [100, 125709], [107, 126289], [115, 126869], [117, 127189], [123, 127389], [127, 127669], [131, 127849], [137, 128169], [140, 128409], [151, 128649], [153, 129289], [156, 129409], [159, 129509], [167, 129809]]}, {"verse": 17, "start": 130720, "end": 138145, "text": "Sin embargo, para que no se divulgue más por el pueblo, amenacémoslos que no hablen de aquí en adelante a hombre alguno en este nombre.", "words": [[0, 130720], [4, 130835], [13, 131315], [18, 131475], [22, 131615], [25, 131755], [28, 131895], [37, 132375], [41, 132575], [45, 132835], [48, 132955], [56, 133755], [70, 134555], [74, 134755], [77, 134975], [84, 135295], [87, 135375], [92, 135615], [95, 135755], [104, 136195], [106, 136495], [113, 136775], [120, 137315], [123, 137455], [128, 137675]]}, {"verse": 18, "start": 138425, "end": 144983, "text": "Y llamándolos, les ordenaron que en ninguna manera hablasen ni enseñasen en el nombre de Jesús.", "words": [[0, 138425], [2, 138551], [15, 139871], [19, 140071], [29, 140871], [33, 141071], [36, 141211], [44, 141571], [51, 142066], [60, 142561], [63, 143056], [73, 143551], [76, 143671], [79, 143791], [86, 144091], [89, 144311]]}, {"verse": 19, "start": 145333, "end": 153414, "text": "Entonces Pedro y Juan, respondiendo, les dijeron: Juzgad si es justo delante de Dios obedecer antes a vosotros que a Dios:", "words": [[0, 145333], [9, 146162], [15, 146522], [17, 146702], [23, 147182], [37, 147662], [41, 148142], [50, 148930], [57, 149449], [60, 149709], [63, 149869], [69, 150069], [77, 150549], [80, 150649], [85, 150869], [94, 151629], [100, 151989], [102, 152189], [111, 152609], [115, 152849], [117, 152949]]}, {"verse": 20, "start": 153764, "end": 156855, "text": "Porque no podemos dejar de decir lo que hemos visto y oído.", "words": [[0, 153764], [7, 153953], [10, 154173], [18, 154553], [24, 154893], [27, 155073], [33, 155353], [36, 155573], [40, 155693], [46, 155853], [52, 156233], [54, 156433]]}, {"verse": 21, "start": 157135, "end": 168757, "text": "Ellos entonces los despacharon amenazándolos, no hallando ningún modo de castigarlos, por causa del pueblo; porque todos glorificaban a Dios de lo que había sido hecho.", "words": [[0, 157135], [6, 157502], [15, 157982], [19, 158302], [31, 159062], [46, 160462], [49, 160782], [58, 161362], [65, 161702], [70, 162162], [73, 162322], [86, 163082], [90, 163382], [96, 163702], [100, 163982], [108, 164799], [115, 165002], [121, 165442], [134, 166602], [136, 166742], [141, 166962], [144, 167342], [147, 167482], [151, 167642], [157, 167842], [162, 168202]]}, {"verse": 22, "start": 169107, "end": 175559, "text": "Porque el hombre en quien había sido hecho este milagro de sanidad, era de más de cuarenta años.", "words": [[0, 169107], [7, 169393], [10, 169793], [17, 170133], [20, 170393], [26, 170553], [32, 170933], [37, 171393], [43, 171693], [48, 171933], [56, 172513], [59, 172613], [68, 173273], [72, 173648], [75, 173828], [79, 174048], [82, 174328], [91, 174608]]}, {"verse": 23, "start": 175909, "end": 183158, "text": "Y sueltos, vinieron a los suyos, y contaron todo lo que los principales sacerdotes y los ancianos les habían dicho.", "words": [[0, 175909], [2, 176014], [11, 176554], [20, 177074], [22, 177334], [26, 177494], [33, 178034], [35, 178174], [44, 178774], [49, 179094], [52, 179374], [56, 179494], [60, 179634], [72, 180334], [83, 181114], [85, 181274], [89, 181434], [98, 182054], [102, 182234], [109, 182574]]}, {"verse": 24, "start": 183508, "end": 194979, "text": "Y ellos, habiéndolo oído, alzaron unánimes la voz a Dios, y dijeron: Señor, tú eres el Dios que hiciste el cielo y la tierra, el mar, y todo lo que en ellos hay;", "words": [[0, 183508], [2, 183768], [9, 184068], [20, 184748], [26, 185468], [34, 186348], [43, 187228], [46, 187528], [50, 187748], [52, 188008], [58, 188208], [60, 188528], [69, 189494], [76, 190132], [79, 190172], [84, 190392], [87, 190572], [92, 190772], [96, 191012], [104, 191342], [107, 191672], [113, 191972], [115, 192132], [118, 192272], [126, 192932], [129, 193012], [134, 193232], [136, 193692], [141, 193892], [144, 194112], [148, 194232], [151, 194392], [157, 194572]]}, {"verse": 25, "start": 195329, "end": 201211, "text": "Que por boca de David, tu siervo, dijiste: ¿Por qué han bramado las gentes, y los pueblos han pensado cosas vanas?", "words": [[0, 195329], [4, 195411], [8, 195591], [13, 195891], [16, 196071], [23, 196331], [26, 196571], [34, 196931], [43, 197637], [48, 197764], [52, 197904], [56, 198134], [64, 198364], [68, 198524], [76, 198984], [78, 199264], [82, 199404], [90, 199804], [94, 199924], [102, 200344], [108, 200584]]}, {"verse": 26, "start": 201561, "end": 207287, "text": "Se presentaron los reyes de la tierra, y los príncipes se juntaron en uno contra el Señor, y contra su Cristo.", "words": [[0, 201561], [3, 201665], [15, 202185], [19, 202325], [25, 202665], [28, 202785], [31, 202885], [39, 203245], [41, 203625], [45, 203765], [55, 204325], [58, 204465], [67, 204925], [70, 205065], [74, 205225], [81, 205525], [84, 205665], [91, 205925], [93, 206365], [100, 206605], [103, 206785]]}, {"verse": 27, "start": 207637, "end": 217385, "text": "Porque verdaderamente se juntaron en esta ciudad contra tu santo Hijo Jesús, al cual ungiste, Herodes y Poncio Pilato, con los Gentiles y los pueblos de Israel,", "words": [[0, 207637], [7, 207841], [22, 208581], [25, 208821], [34, 209301], [37, 209441], [42, 209641], [49, 210041], [56, 210381], [59, 210561], [65, 210821], [70, 211101], [77, 212101], [80, 212181], [85, 212381], [94, 212981], [102, 213581], [104, 213921], [111, 214281], [119, 215341], [123, 215421], [127, 215541], [136, 216021], [138, 216181], [142, 216301], [150, 216721], [153, 216801]]}, {"verse": 28, "start": 217735, "end": 222380, "text": "Para hacer lo que tu mano y tu consejo habían antes determinado que había de ser hecho.", "words": [[0, 217735], [5, 217904], [11, 218224], [14, 218384], [18, 218504], [21, 218664], [26, 218924], [28, 219104], [31, 219204], [39, 219804], [46, 220124], [52, 220524], [64, 221224], [68, 221384], [74, 221604], [77, 221764], [81, 221944]]}, {"verse": 29, "start": 222730, "end": 228303, "text": "Y ahora, Señor, mira sus amenazas, y da a tus siervos que con toda confianza hablen tu palabra;", "words": [[0, 222730], [2, 222852], [9, 223152], [16, 223892], [21, 224072], [25, 224252], [35, 225012], [37, 225232], [40, 225392], [42, 225492], [46, 225592], [54, 226032], [58, 226212], [62, 226412], [67, 226572], [77, 227312], [84, 227592], [87, 227732]]}, {"verse": 30, "start": 228653, "end": 235217, "text": "Que extiendas tu mano a que sanidades, y milagros, y prodigios sean hechos por el nombre de tu santo Hijo Jesús.", "words": [[0, 228653], [4, 228767], [14, 229367], [17, 229527], [22, 229767], [24, 229927], [28, 230007], [39, 230627], [41, 230827], [51, 231407], [53, 231527], [63, 232207], [68, 232787], [75, 233127], [79, 233407], [82, 233547], [89, 233787], [92, 233987], [95, 234127], [101, 234407], [106, 234727]]}, {"verse": 31, "start": 235497, "end": 245983, "text": "Y cuando hubieron orado, el lugar en que estaban congregados tembló; y todos fueron llenos del Espíritu Santo, y hablaron la palabra de Dios con confianza.", "words": [[0, 235497], [2, 235601], [9, 235941], [18, 236281], [25, 237241], [28, 237681], [34, 238061], [37, 238281], [41, 238381], [49, 238721], [61, 239581], [69, 240437], [71, 240543], [77, 240723], [84, 241083], [91, 241623], [95, 241783], [104, 242283], [111, 242623], [113, 243363], [122, 243803], [125, 243943], [133, 244283], [136, 244523], [141, 244763], [145, 245003]]}, {"verse": 32, "start": 246333, "end": 256613, "text": "Y la multitud de los que habían creído era de un corazón y un alma: y ninguno decía ser suyo algo de lo que poseía; pero todas las cosas les eran comunes.", "words": [[0, 246333], [2, 246439], [5, 246809], [14, 247179], [17, 247399], [21, 247539], [25, 247699], [32, 247939], [39, 248439], [43, 248599], [46, 248759], [49, 248859], [57, 249239], [59, 249499], [62, 249639], [68, 250388], [70, 250512], [78, 250992], [84, 251272], [88, 251592], [93, 252052], [98, 252292], [101, 252512], [104, 252632], [108, 252732], [116, 253785], [121, 253929], [127, 254209], [131, 254489], [137, 254909], [141, 255489], [146, 255749]]}, {"verse": 33, "start": 256963, "end": 265362, "text": "Y los apóstoles daban testimonio de la resurrección del Señor Jesús con gran poder; y gran gracia era en todos ellos.", "words": [[0, 256963], [2, 257108], [6, 257248], [16, 258068], [22, 258808], [33, 259588], [36, 259708], [39, 259848], [52, 260728], [56, 260948], [62, 261268], [68, 261788], [72, 262088], [77, 262328], [84, 263137], [86, 263242], [91, 263442], [98, 264162], [102, 264462], [105, 264622], [111, 264842]]}, {"verse": 34, "start": 265712, "end": 275783, "text": "Que ningún necesitado había entre ellos: porque todos los que poseían tierras o casas, vendiéndolas, traían el precio de lo vendido,", "words": [[0, 265712], [4, 265922], [11, 266302], [22, 267382], [28, 267642], [34, 268062], [41, 268819], [48, 269023], [54, 269443], [58, 269863], [62, 270023], [70, 270663], [78, 271343], [80, 271543], [87, 272203], [101, 273183], [108, 274043], [111, 274263], [118, 274803], [121, 275003], [124, 275103]]}, {"verse": 35, "start": 276133, "end": 282549, "text": "Y lo ponían a los pies de los apóstoles; y era repartido a cada uno según su necesidad.", "words": [[0, 276176], [2, 276246], [5, 276386], [12, 276846], [14, 277046], [18, 277166], [23, 277446], [26, 277646], [30, 277807], [41, 278188], [43, 279038], [47, 279338], [57, 280278], [59, 280398], [64, 280598], [68, 280978], [74, 281278], [77, 281578]]}, {"verse": 36, "start": 282899, "end": 293875, "text": "Entonces José, que fue llamado de los apóstoles por sobrenombre, Bernabé, (que es interpretado, Hijo de consolación) levita, natural de Chipre,", "words": [[0, 282899], [9, 283717], [15, 283959], [19, 284159], [23, 284339], [31, 284679], [34, 284959], [38, 285079], [48, 285879], [52, 286199], [65, 287199], [74, 288499], [79, 288539], [82, 288759], [96, 289839], [101, 290359], [104, 290559], [117, 291919], [125, 292639], [133, 293039], [136, 293239]]}, {"verse": 37, "start": 294225, "end": 299959, "text": "Como tuviese un terreno, lo vendió, y trajo el precio, y lo puso a los pies de los apóstoles.", "words": [[0, 294225], [5, 294388], [13, 294808], [16, 294988], [25, 295468], [28, 295688], [36, 296268], [38, 296648], [44, 297088], [47, 297228], [55, 297688], [57, 297983], [60, 298103], [65, 298403], [67, 298503], [71, 298603], [76, 298783], [79, 298963], [83, 299063]]}]}