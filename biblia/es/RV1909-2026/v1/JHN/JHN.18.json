{"book": "JHN", "chapter": 18, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 352933, "verses": [{"verse": 1, "start": 300, "end": 11261, "text": "Como Jesús hubo dicho estas cosas, se salió con sus discípulos tras el arroyo de Cedrón, donde estaba un huerto, en el cual entró Jesús y sus discípulos.", "words": [[0, 300], [5, 485], [11, 785], [16, 1365], [22, 1605], [28, 1825], [35, 2625], [38, 2845], [44, 3225], [48, 3405], [52, 3645], [63, 4325], [68, 4545], [71, 4905], [78, 5265], [81, 5385], [89, 6205], [95, 6445], [102, 6785], [105, 7065], [113, 7545], [116, 7860], [119, 8020], [124, 8340], [130, 9220], [136, 9600], [138, 10100], [142, 10280]]}, {"verse": 2, "start": 11611, "end": 20705, "text": "Y también Judas, el que le entregaba, sabía aquel lugar; porque muchas veces Jesús se juntaba allí con sus discípulos.", "words": [[0, 11611], [2, 11752], [10, 12132], [17, 12632], [20, 12952], [24, 13132], [27, 13292], [38, 14332], [44, 14912], [50, 15512], [57, 16339], [64, 16540], [71, 16840], [77, 17340], [83, 17860], [86, 18360], [94, 18880], [99, 19180], [103, 19420], [107, 19660]]}, {"verse": 3, "start": 21055, "end": 31094, "text": "Judas pues tomando una tropa, y guardias de los principales sacerdotes y de los fariseos, vino allí con linternas y antorchas, y con armas.", "words": [[0, 21312], [6, 21607], [11, 21902], [19, 22197], [23, 22337], [30, 23177], [32, 23337], [41, 23857], [44, 23997], [48, 24117], [60, 24817], [71, 25557], [73, 25757], [76, 25857], [80, 25997], [90, 27157], [95, 27537], [100, 27797], [104, 28037], [114, 28817], [116, 28977], [127, 29677], [129, 30237], [133, 30417]]}, {"verse": 4, "start": 31444, "end": 39167, "text": "Pero Jesús, sabiendo todas las cosas que habían de venir sobre él, salió delante, y les dijo: ¿A quién buscáis?", "words": [[0, 31444], [5, 31592], [12, 32552], [21, 33072], [27, 33392], [31, 33712], [37, 34052], [41, 34312], [48, 34532], [51, 34732], [57, 34972], [63, 35312], [67, 35932], [73, 36232], [82, 36772], [84, 37012], [88, 37172], [94, 37941], [97, 38065], [103, 38205]]}, {"verse": 5, "start": 39517, "end": 47797, "text": "Le respondieron: A Jesús nazareno. Les dice Jesús: Yo soy. (Y estaba también con ellos Judas, el que le entregaba.)", "words": [[0, 39517], [3, 39697], [17, 40896], [19, 41042], [25, 41282], [35, 42539], [39, 42629], [44, 42929], [51, 43857], [54, 44045], [59, 44626], [62, 44847], [69, 45087], [77, 45467], [81, 45667], [87, 45847], [94, 46507], [97, 46767], [101, 46887], [104, 47027]]}, {"verse": 6, "start": 48147, "end": 52761, "text": "Y como les dijo, Yo soy, volvieron atrás, y cayeron en tierra.", "words": [[0, 48147], [2, 48327], [7, 48527], [11, 48687], [17, 49367], [20, 49487], [25, 50127], [35, 50567], [42, 50887], [44, 51447], [52, 51967], [55, 52087]]}, {"verse": 7, "start": 53111, "end": 59162, "text": "Les volvió, pues, a preguntar: ¿A quién buscáis? Y ellos dijeron: A Jesús nazareno.", "words": [[0, 53111], [4, 53217], [12, 53677], [18, 53997], [20, 54357], [31, 55296], [34, 55420], [40, 55560], [49, 56742], [51, 56891], [57, 57051], [66, 57889], [68, 58036], [74, 58276]]}, {"verse": 8, "start": 59442, "end": 65267, "text": "Respondió Jesús: Os he dicho que yo soy: pues si a mí buscáis, dejad ir a estos.", "words": [[0, 59562], [10, 60022], [17, 60999], [20, 61133], [23, 61266], [29, 61486], [33, 61706], [36, 61866], [41, 62631], [46, 62776], [49, 63016], [51, 63096], [54, 63256], [63, 64416], [69, 64776], [72, 64896], [74, 65081]]}, {"verse": 9, "start": 65617, "end": 72197, "text": "Para que se cumpliese la palabra que había dicho: De los que me diste, ninguno de ellos perdí.", "words": [[0, 65617], [5, 66581], [9, 66741], [12, 66901], [22, 67601], [25, 67801], [33, 68201], [37, 68441], [43, 68701], [50, 69581], [53, 69703], [57, 69823], [61, 69963], [64, 70123], [71, 70783], [79, 71263], [82, 71423], [88, 71623]]}, {"verse": 10, "start": 72547, "end": 84435, "text": "Entonces Simón Pedro, que tenía espada, la sacó, e hirió al siervo del sumo sacerdote, y le cortó la oreja derecha. Y el siervo se llamaba Malco.", "words": [[0, 72547], [9, 73550], [15, 74050], [22, 74530], [26, 74570], [32, 74890], [40, 75790], [43, 75910], [49, 76450], [51, 76900], [57, 77350], [60, 77790], [67, 78230], [71, 78390], [76, 78890], [87, 79590], [89, 79990], [92, 80110], [98, 80630], [101, 80990], [107, 81390], [116, 82274], [118, 82439], [121, 82619], [128, 83099], [131, 83259], [139, 83719]]}, {"verse": 11, "start": 84785, "end": 93302, "text": "Jesús entonces dijo a Pedro: Mete tu espada en la vaina: la copa que el Padre me ha dado, ¿no la he de beber?", "words": [[0, 84785], [6, 85568], [15, 86228], [20, 86388], [22, 86528], [29, 87239], [34, 87526], [37, 87786], [44, 88366], [47, 88506], [50, 88646], [57, 89486], [60, 89633], [65, 90093], [69, 90193], [72, 90353], [78, 90673], [81, 90973], [84, 91073], [90, 91393], [94, 92013], [97, 92393], [100, 92633], [103, 92813]]}, {"verse": 12, "start": 93652, "end": 100162, "text": "Entonces la tropa y su comandante, y los guardias de los judíos, prendieron a Jesús y le ataron,", "words": [[0, 93652], [9, 94157], [12, 94597], [18, 95137], [20, 95217], [23, 95337], [35, 96137], [37, 96297], [41, 96437], [50, 96897], [53, 96997], [57, 97117], [65, 97807], [76, 98497], [78, 98657], [84, 98957], [86, 99357], [89, 99457]]}, {"verse": 13, "start": 100512, "end": 108646, "text": "Y le llevaron primeramente a Anás; porque era suegro de Caifás, el cual era sumo sacerdote de aquel año.", "words": [[0, 100512], [2, 100629], [5, 100779], [14, 101259], [27, 102459], [29, 102719], [35, 103634], [42, 103896], [46, 104196], [53, 104656], [56, 104776], [64, 105756], [67, 105856], [72, 106136], [76, 106556], [81, 107136], [91, 107836], [94, 108036], [100, 108336]]}, {"verse": 14, "start": 108996, "end": 115886, "text": "Y era Caifás el que había dado el consejo a los judíos, que era necesario que un hombre muriese por el pueblo.", "words": [[0, 108996], [2, 109122], [6, 109282], [13, 110127], [16, 110207], [20, 110347], [26, 110567], [31, 110867], [34, 110987], [42, 111567], [44, 111647], [48, 111727], [56, 112367], [60, 112727], [64, 112907], [74, 113607], [78, 113867], [81, 114027], [88, 114267], [96, 114807], [100, 115087], [103, 115227]]}, {"verse": 15, "start": 116236, "end": 127949, "text": "Y seguía a Jesús Simón Pedro, y otro discípulo. Y aquel discípulo era conocido del sumo sacerdote, y entró con Jesús al patio del sumo sacerdote;", "words": [[0, 116236], [2, 116488], [9, 116928], [11, 117128], [17, 117388], [23, 118008], [30, 118468], [32, 118988], [37, 119248], [48, 120589], [50, 120692], [56, 121192], [66, 121692], [70, 121872], [79, 122532], [83, 122712], [88, 123092], [99, 124232], [101, 124552], [107, 124972], [111, 125112], [117, 125512], [120, 126072], [126, 126472], [130, 126692], [135, 127092]]}, {"verse": 16, "start": 128299, "end": 138566, "text": "Pero Pedro estaba fuera a la puerta. Y salió aquel discípulo que era conocido del sumo sacerdote, y habló a la portera, y metió dentro a Pedro.", "words": [[0, 128299], [5, 128821], [11, 129121], [18, 129421], [24, 129801], [26, 130001], [29, 130101], [37, 131043], [39, 131161], [45, 131621], [51, 132121], [61, 132781], [65, 133021], [69, 133181], [78, 133841], [82, 134041], [87, 134561], [98, 135281], [100, 135681], [106, 136021], [108, 136101], [111, 136201], [120, 136881], [122, 137101], [128, 137461], [135, 137761], [137, 138041]]}, {"verse": 17, "start": 138916, "end": 147206, "text": "Entonces la criada portera dijo a Pedro: ¿No eres tú también de los discípulos de este hombre? Dice él: No soy.", "words": [[0, 138916], [9, 139722], [12, 139902], [19, 140295], [27, 140689], [32, 141082], [34, 141222], [41, 141966], [45, 142174], [50, 142434], [53, 142694], [61, 143114], [64, 143354], [68, 143514], [79, 144134], [82, 144334], [87, 144594], [95, 145458], [100, 145926], [104, 146574], [107, 146739]]}, {"verse": 18, "start": 147486, "end": 159016, "text": "Y estaban en pie los siervos y los guardias que habían preparado un fuego de brasas; porque hacía frío, y se calentaban: y estaba también con ellos Pedro en pie, calentándose.", "words": [[0, 147486], [2, 147613], [10, 147993], [13, 148253], [17, 148513], [21, 148733], [29, 149333], [31, 149493], [35, 149633], [44, 150153], [48, 150313], [55, 150593], [65, 151233], [68, 151353], [74, 151633], [77, 151853], [85, 152811], [92, 153013], [98, 153333], [104, 153913], [106, 154333], [109, 154453], [121, 155722], [123, 155807], [130, 156107], [138, 156567], [142, 156787], [148, 157027], [154, 157487], [157, 157687], [162, 157907]]}, {"verse": 19, "start": 159366, "end": 165809, "text": "Y el sumo sacerdote preguntó a Jesús acerca de sus discípulos y de su doctrina.", "words": [[0, 159366], [2, 159511], [5, 159671], [10, 160171], [20, 160771], [29, 161411], [31, 161531], [37, 161871], [44, 162731], [47, 163071], [51, 163271], [62, 164191], [64, 164631], [67, 164751], [70, 164931]]}, {"verse": 20, "start": 166159, "end": 179943, "text": "Jesús le respondió: Yo manifiestamente he hablado al mundo: yo siempre he enseñado en la sinagoga y en el templo, donde se juntan todos los judíos, y nada he hablado en oculto.", "words": [[0, 166159], [6, 166521], [9, 166941], [20, 167956], [23, 168183], [39, 169123], [42, 169423], [50, 169843], [53, 169963], [60, 170760], [63, 170925], [71, 171385], [74, 171790], [83, 172510], [86, 172670], [89, 172830], [98, 173570], [100, 173790], [103, 173930], [106, 174090], [114, 174870], [120, 175170], [123, 175450], [130, 176050], [136, 176350], [140, 176650], [148, 177310], [150, 177890], [155, 178190], [158, 178750], [166, 179210], [169, 179330]]}, {"verse": 21, "start": 180293, "end": 187379, "text": "¿Qué me preguntas a mí? Pregunta a los que han oído, qué les haya yo hablado: he aquí, esos saben lo que yo he dicho.", "words": [[0, 180293], [5, 180377], [8, 180517], [18, 180897], [20, 181177], [24, 181727], [33, 182210], [35, 182330], [39, 182430], [43, 182610], [47, 182750], [53, 183070], [57, 183290], [61, 183490], [66, 183750], [69, 183990], [78, 184843], [81, 184923], [87, 185353], [92, 185783], [98, 186263], [101, 186483], [105, 186583], [108, 186763], [111, 186863]]}, {"verse": 22, "start": 187729, "end": 197000, "text": "Y como él hubo dicho esto, uno de los guardias que estaba allí, dio una bofetada a Jesús, diciendo: ¿Así respondes al sumo sacerdote?", "words": [[0, 187729], [2, 187831], [7, 188051], [10, 188291], [15, 188591], [21, 188811], [27, 189691], [31, 189811], [34, 189951], [38, 190091], [47, 190591], [51, 190711], [58, 191011], [64, 191331], [68, 191871], [72, 192111], [81, 192791], [83, 192951], [90, 193291], [100, 194761], [105, 195018], [115, 195718], [118, 195858], [123, 196238]]}, {"verse": 23, "start": 197280, "end": 204974, "text": "Le respondió Jesús: Si he hablado mal, da testimonio del mal: y si bien, ¿por qué me golpeas?", "words": [[0, 197280], [3, 197428], [13, 198088], [20, 199083], [23, 199286], [26, 199566], [34, 200106], [39, 200679], [42, 201253], [53, 201826], [57, 201946], [62, 202784], [64, 202908], [67, 203028], [73, 203768], [78, 203908], [82, 204028], [85, 204168]]}, {"verse": 24, "start": 205324, "end": 209696, "text": "Y Anás le había enviado atado a Caifás, el sumo sacerdote.", "words": [[0, 205476], [2, 205662], [7, 205849], [10, 206129], [16, 206329], [24, 206799], [30, 207269], [32, 207409], [40, 208309], [43, 208409], [48, 208829]]}, {"verse": 25, "start": 210046, "end": 219070, "text": "Estaba pues Pedro en pie calentándose. Y le dijeron: ¿No eres tú de sus discípulos? Él negó, y dijo: No soy.", "words": [[0, 210046], [7, 210496], [12, 210756], [18, 211276], [21, 211516], [25, 211776], [39, 213369], [41, 213534], [44, 213634], [53, 214590], [57, 214787], [62, 214987], [65, 215307], [68, 215467], [72, 215647], [84, 216779], [87, 216988], [93, 217428], [95, 217663], [101, 218437], [104, 218603]]}, {"verse": 26, "start": 219350, "end": 229326, "text": "Uno de los siervos del sumo sacerdote, pariente de aquel a quien Pedro había cortado la oreja, le dice: ¿No te vi yo en el huerto con él?", "words": [[0, 219350], [4, 219576], [7, 219736], [11, 219896], [19, 220476], [23, 220676], [28, 221176], [39, 222116], [48, 222796], [51, 222996], [57, 223356], [59, 223456], [65, 223636], [71, 224156], [77, 224476], [85, 225176], [88, 225316], [95, 226216], [98, 226296], [104, 227168], [108, 227345], [111, 227505], [114, 227685], [117, 227845], [120, 227965], [123, 228065], [130, 228305], [134, 228525]]}, {"verse": 27, "start": 229606, "end": 233878, "text": "Y negó Pedro otra vez: y de inmediato el gallo cantó.", "words": [[0, 229606], [2, 229727], [7, 229987], [13, 230447], [18, 230847], [23, 231714], [25, 231901], [28, 231981], [38, 232681], [41, 232861], [47, 233241]]}, {"verse": 28, "start": 234228, "end": 244681, "text": "Y llevaron a Jesús de Caifás al pretorio: y era por la mañana: y ellos no entraron en el pretorio por no ser contaminados, sino que comiesen la pascua.", "words": [[0, 234228], [2, 234333], [11, 234773], [13, 234873], [19, 235133], [22, 235353], [29, 235893], [32, 236053], [42, 236916], [44, 237196], [48, 237356], [52, 237556], [55, 237696], [63, 238580], [65, 238726], [71, 238946], [74, 239186], [83, 239826], [86, 239946], [89, 240086], [98, 240806], [102, 241226], [105, 241386], [109, 241606], [123, 242766], [128, 243006], [132, 243406], [141, 243806], [144, 243986]]}, {"verse": 29, "start": 245031, "end": 251016, "text": "Entonces salió Pilato a ellos fuera, y dijo: ¿Qué acusación traéis contra este hombre?", "words": [[0, 245031], [9, 245912], [15, 246352], [22, 246812], [24, 246972], [30, 247172], [37, 247632], [39, 247967], [45, 248776], [50, 248896], [60, 249536], [67, 249936], [74, 250216], [79, 250496]]}, {"verse": 30, "start": 251296, "end": 256580, "text": "Respondieron y le dijeron: Si este no fuera malhechor, no te le habríamos entregado.", "words": [[0, 251296], [13, 252101], [15, 252521], [18, 252641], [27, 253521], [30, 253675], [35, 253955], [38, 254155], [44, 254628], [55, 255100], [58, 255200], [61, 255360], [64, 255590], [74, 255820]]}, {"verse": 31, "start": 256860, "end": 266193, "text": "Les dice entonces Pilato: Tomadle vosotros, y juzgadle según vuestra ley. Y los judíos le dijeron: A nosotros no es lícito matar a nadie:", "words": [[0, 256860], [4, 257001], [9, 257281], [18, 257821], [26, 258993], [34, 259475], [44, 259975], [46, 260235], [55, 260815], [61, 261055], [69, 261515], [74, 262186], [76, 262314], [80, 262434], [87, 262934], [90, 263034], [99, 263909], [101, 264013], [110, 264293], [113, 264693], [116, 264873], [123, 265253], [129, 265553], [131, 265713]]}, {"verse": 32, "start": 266473, "end": 273440, "text": "Para que se cumpliese el dicho de Jesús, que había dicho, dando a entender de qué muerte había de morir.", "words": [[0, 266473], [5, 266659], [9, 266839], [12, 266999], [22, 267699], [25, 267999], [31, 268319], [34, 268499], [41, 269479], [45, 269559], [51, 269759], [58, 270699], [64, 270939], [66, 271212], [75, 271486], [78, 271759], [82, 271939], [89, 272359], [95, 272679], [98, 272919]]}, {"verse": 33, "start": 273790, "end": 281753, "text": "Así que, Pilato volvió a entrar en el pretorio, y llamó a Jesús, y le dijo: ¿Eres tú el Rey de los judíos?", "words": [[0, 273790], [4, 274009], [9, 274189], [16, 274709], [23, 275209], [25, 275309], [32, 275669], [35, 276009], [38, 276509], [48, 277009], [50, 277569], [56, 277949], [58, 278049], [65, 278469], [67, 279069], [70, 279209], [76, 279957], [82, 280145], [85, 280445], [88, 280625], [92, 280845], [95, 280905], [99, 281045]]}, {"verse": 34, "start": 282033, "end": 287745, "text": "Le respondió Jesús: ¿Dices tú esto de ti mismo, o te lo han dicho otros de mí?", "words": [[0, 282033], [3, 282181], [13, 282841], [20, 283835], [27, 284304], [30, 284644], [35, 284964], [38, 285224], [41, 285364], [48, 285664], [50, 285964], [53, 286164], [56, 286284], [60, 286424], [66, 286784], [72, 287224], [75, 287444]]}, {"verse": 35, "start": 288095, "end": 294930, "text": "Pilato respondió: ¿Soy yo judío? Tu nación, y los principales sacerdotes, te han entregado a mí: ¿qué has hecho?", "words": [[0, 288095], [7, 288521], [18, 289546], [23, 289790], [26, 289990], [33, 290769], [36, 290830], [44, 291290], [46, 291410], [50, 291550], [62, 292190], [74, 292870], [77, 293030], [81, 293110], [91, 293650], [93, 293770], [97, 294259], [102, 294473], [106, 294723]]}, {"verse": 36, "start": 295210, "end": 310141, "text": "Respondió Jesús: Mi reino no es de este mundo: si de este mundo fuera mi reino, mis servidores pelearían para que yo no fuera entregado a los judíos: ahora, pues, mi reino no es de aquí.", "words": [[0, 295330], [10, 295790], [17, 296668], [20, 296908], [26, 297488], [29, 297773], [32, 298033], [35, 298253], [40, 298513], [47, 299425], [50, 299609], [53, 299789], [58, 300089], [64, 300409], [70, 300809], [73, 300989], [80, 301969], [84, 302069], [95, 302829], [105, 303909], [110, 304249], [114, 304449], [117, 304649], [120, 304789], [126, 305089], [136, 305789], [138, 305869], [142, 305989], [150, 306994], [157, 307394], [163, 308254], [166, 308334], [172, 308854], [175, 309214], [178, 309454], [181, 309634]]}, {"verse": 37, "start": 310491, "end": 326888, "text": "Le dijo entonces Pilato: ¿Luego rey eres tú? Respondió Jesús: Tú dices que yo soy rey. Yo para esto he nacido, y para esto he venido al mundo, para dar testimonio a la verdad. Todo aquel que es de la verdad, oye mi voz.", "words": [[0, 310491], [3, 310620], [8, 310900], [17, 311360], [25, 312450], [32, 312717], [36, 313027], [41, 313367], [45, 314255], [55, 314715], [62, 315593], [65, 315697], [71, 315997], [75, 316177], [78, 316357], [82, 316697], [87, 317385], [90, 317569], [95, 317829], [100, 318169], [103, 318329], [111, 319049], [113, 319389], [118, 319629], [123, 319969], [126, 320109], [133, 320489], [136, 320649], [143, 321009], [148, 321549], [152, 321809], [163, 322649], [165, 322749], [168, 322809], [176, 323758], [181, 323979], [187, 324459], [191, 324559], [194, 324779], [197, 324899], [200, 325019], [208, 325899], [212, 326199], [215, 326339]]}, {"verse": 38, "start": 327238, "end": 336981, "text": "Le dice Pilato: ¿Qué cosa es verdad? Y cuando hubo dicho esto, salió otra vez a los judíos, y les dice: Yo no hallo en él ningún crimen.", "words": [[0, 327238], [3, 327440], [8, 327660], [16, 328626], [21, 328728], [26, 329008], [29, 329168], [37, 330011], [39, 330113], [46, 330313], [51, 330753], [57, 330973], [63, 332013], [69, 332593], [74, 332833], [78, 333113], [80, 333233], [84, 333373], [92, 333993], [94, 334163], [98, 334333], [104, 335102], [107, 335262], [110, 335512], [116, 335762], [119, 335902], [122, 336022], [129, 336322]]}, {"verse": 39, "start": 337331, "end": 343400, "text": "Pero vosotros tenéis costumbre, que os suelte uno en la Pascua: ¿queréis, pues, que os suelte al Rey de los judíos?", "words": [[0, 337331], [5, 337474], [14, 337914], [21, 338314], [32, 338934], [36, 339094], [39, 339234], [46, 339574], [50, 339774], [53, 339914], [56, 340014], [64, 340857], [74, 341139], [80, 341399], [84, 341719], [87, 341859], [94, 342219], [97, 342339], [101, 342579], [104, 342619], [108, 342759]]}, {"verse": 40, "start": 343680, "end": 352533, "text": "Entonces todos dieron voces otra vez, diciendo: No a este, sino a Barrabás. Y Barrabás era ladrón.", "words": [[0, 343680], [9, 344489], [15, 344801], [22, 345421], [28, 345881], [33, 346101], [38, 346541], [48, 347622], [51, 347710], [53, 347840], [59, 348240], [64, 348520], [66, 348720], [76, 350093], [78, 350427], [87, 350797], [91, 351097]]}]}