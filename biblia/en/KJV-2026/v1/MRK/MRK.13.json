{"book": "MRK", "chapter": 13, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 257196, "verses": [{"verse": 1, "start": 300, "end": 8133, "text": "And as he went out of the temple, one of his disciples says to him, Master, see what manner of stones and what buildings are here!", "words": [[0, 300], [4, 461], [7, 681], [10, 821], [15, 1041], [19, 1341], [22, 1461], [26, 1581], [34, 2441], [38, 2621], [41, 2721], [45, 2841], [55, 3301], [60, 3621], [63, 3841], [68, 4390], [76, 5095], [80, 5356], [85, 5555], [92, 5855], [95, 6036], [102, 6416], [106, 6916], [111, 7076], [121, 7476], [125, 7796]]}, {"verse": 2, "start": 8413, "end": 16051, "text": "And Jesus answering said to him, Do you see these great buildings? there shall not be left one stone upon another, that shall not be thrown down.", "words": [[0, 8413], [4, 8562], [10, 8882], [20, 9402], [25, 9662], [28, 9842], [33, 10349], [36, 10444], [40, 10544], [44, 10704], [50, 10924], [56, 11164], [67, 12134], [73, 12238], [79, 12418], [83, 12638], [86, 12818], [91, 13038], [95, 13318], [101, 13678], [106, 13938], [115, 14578], [120, 14798], [126, 14978], [130, 15178], [133, 15318], [140, 15538]]}, {"verse": 3, "start": 16331, "end": 23137, "text": "And as he sat upon the mount of Olives over against the temple, Peter and James and John and Andrew asked him privately,", "words": [[0, 16331], [4, 16466], [7, 16666], [10, 16786], [14, 17026], [19, 17266], [23, 17466], [29, 17686], [32, 17846], [39, 18346], [44, 18606], [52, 18966], [56, 19166], [64, 19946], [70, 20166], [74, 20386], [80, 20706], [84, 20986], [89, 21286], [93, 21486], [100, 21926], [106, 22266], [110, 22406]]}, {"verse": 4, "start": 23337, "end": 28160, "text": "Tell us, when shall these things be? and what shall be the sign when all these things shall be fulfilled?", "words": [[0, 23337], [5, 23490], [9, 23650], [14, 23830], [20, 24010], [26, 24230], [33, 24450], [37, 25095], [41, 25177], [46, 25437], [52, 25717], [55, 25877], [59, 25997], [64, 26277], [69, 26457], [73, 26757], [79, 26977], [86, 27237], [92, 27457], [95, 27597]]}, {"verse": 5, "start": 28440, "end": 33334, "text": "And Jesus answering them began to say, Take heed lest any man deceive you:", "words": [[0, 28440], [4, 28602], [10, 28942], [20, 29602], [25, 29922], [31, 30242], [34, 30482], [39, 31164], [44, 31323], [49, 31643], [54, 32023], [58, 32243], [62, 32503], [70, 32863]]}, {"verse": 6, "start": 33684, "end": 38240, "text": "For many shall come in my name, saying, I am Christ; and shall deceive many.", "words": [[0, 33684], [4, 33802], [9, 34062], [15, 34302], [20, 34522], [23, 34642], [26, 34782], [32, 35222], [40, 35782], [42, 36042], [45, 36142], [53, 36983], [57, 37101], [63, 37301], [71, 37661]]}, {"verse": 7, "start": 38590, "end": 46645, "text": "And when you shall hear of wars and rumours of wars, do not be troubled: for such things must needs be; but the end shall not be yet.", "words": [[0, 38590], [4, 38726], [9, 38906], [13, 39126], [19, 39326], [24, 39626], [27, 39806], [32, 40166], [36, 40456], [44, 40746], [47, 40986], [53, 41586], [56, 41766], [60, 41986], [63, 42186], [73, 43012], [77, 43097], [82, 43377], [89, 43737], [94, 43997], [100, 44317], [104, 45037], [108, 45140], [112, 45280], [116, 45580], [122, 45820], [126, 46040], [129, 46240]]}, {"verse": 8, "start": 46995, "end": 58070, "text": "For nation shall rise against nation, and kingdom against kingdom: and there shall be earthquakes in various places, and there shall be famines and troubles: these are the beginnings of sorrows.", "words": [[0, 46995], [4, 47109], [11, 47449], [17, 47809], [22, 48189], [30, 48529], [38, 49089], [42, 49529], [50, 49989], [58, 50349], [67, 51215], [71, 51338], [77, 51518], [83, 51718], [86, 51898], [98, 52278], [101, 52578], [109, 52898], [117, 53898], [121, 53958], [127, 54138], [133, 54298], [136, 54438], [144, 55018], [148, 55178], [158, 56041], [164, 56317], [168, 56557], [172, 56677], [183, 57037], 