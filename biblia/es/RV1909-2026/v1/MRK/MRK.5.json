{"book": "MRK", "chapter": 5, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 323135, "verses": [{"verse": 1, "start": 300, "end": 3901, "text": "Y vinieron de la otra parte del mar a la provincia de los gadarenos.", "words": [[0, 300], [2, 431], [11, 811], [14, 991], [17, 1111], [22, 1271], [28, 1631], [32, 1871], [36, 2111], [38, 2351], [41, 2451], [51, 3051], [54, 3171], [58, 3291]]}, {"verse": 2, "start": 4251, "end": 12034, "text": "Y salido él del barco, luego le salió al encuentro, de los sepulcros, un hombre con un espíritu inmundo,", "words": [[0, 4261], [2, 4496], [9, 4996], [12, 5216], [16, 5396], [23, 6167], [29, 6427], [32, 6687], [38, 7107], [41, 7247], [52, 8187], [55, 8407], [59, 8567], [70, 9827], [73, 9967], [80, 10307], [84, 10567], [87, 10707], [96, 11247]]}, {"verse": 3, "start": 12384, "end": 17996, "text": "Que vivía entre los sepulcros, y ni aun con cadenas le podía alguien atar;", "words": [[0, 12384], [4, 12489], [10, 12989], [16, 13269], [20, 13489], [31, 14349], [33, 14869], [36, 15069], [40, 15349], [44, 15649], [52, 16309], [55, 16509], [61, 17020], [69, 17532]]}, {"verse": 4, "start": 18346, "end": 29704, "text": "Porque muchas veces había sido atado con grilletes y cadenas, pero las cadenas habían sido hechas pedazos por él, y los grilletes rotos; y nadie le podía domar.", "words": [[0, 18346], [7, 18593], [14, 18913], [20, 19353], [26, 19693], [31, 20093], [37, 20553], [41, 20973], [51, 21393], [53, 21593], [62, 22473], [67, 22573], [71, 22753], [79, 23233], [86, 23573], [91, 24073], [98, 24413], [106, 24953], [110, 25173], [114, 25353], [116, 25953], [120, 26313], [130, 26673], [137, 27741], [139, 27872], [145, 28232], [148, 28772], [154, 29132]]}, {"verse": 5, "start": 30054, "end": 37733, "text": "Y siempre, de día y de noche, andaba dando voces en los montes y en los sepulcros, e hiriéndose con las piedras.", "words": [[0, 30054], [2, 30175], [11, 30535], [14, 30795], [18, 31075], [20, 31195], [23, 31315], [30, 31635], [37, 32455], [43, 32755], [49, 33195], [52, 33375], [56, 33495], [63, 34135], [65, 34315], [68, 34435], [72, 34595], [83, 35415], [85, 35975], [96, 36655], [100, 36835], [104, 36995]]}, {"verse": 6, "start": 38083, "end": 41245, "text": "Y cuando vio a Jesús de lejos, corrió, y le adoró.", "words": [[0, 38083], [2, 38171], [9, 38331], [13, 38671], [15, 38771], [21, 39031], [24, 39231], [31, 39631], [39, 40311], [41, 40546], [44, 40686]]}, {"verse": 7, "start": 41595, "end": 49958, "text": "Y clamando a gran voz, dijo: ¿Qué tienes conmigo, Jesús, Hijo del Dios Altísimo? Te suplico en nombre de Dios que no me atormentes.", "words": [[0, 41595], [2, 41737], [11, 42317], [13, 42437], [18, 42597], [23, 43377], [29, 44135], [34, 44216], [41, 44496], [50, 44956], [57, 45656], [62, 45816], [66, 46016], [71, 46216], [81, 47207], [84, 47285], [92, 47785], [95, 47905], [102, 48185], [105, 48385], [110, 48625], [114, 48825], [117, 48945], [120, 49065]]}, {"verse": 8, "start": 50238, "end": 54580, "text": "Porque le decía: Sal de este hombre, espíritu inmundo.", "words": [[0, 50238], [7, 50462], [10, 50642], [17, 51667], [21, 51841], [24, 52014], [29, 52274], [37, 52694], [46, 53663]]}, {"verse": 9, "start": 54930, "end": 61535, "text": "Y le preguntó: ¿Cómo te llamas? Y respondió diciendo: Legión me llamo; porque somos muchos.", "words": [[0, 54930], [2, 55031], [5, 55131], [15, 56054], [21, 56337], [24, 56497], [32, 57428], [34, 57533], [44, 58073], [54, 59048], [61, 59475], [64, 59695], [71, 60317], [78, 60518], [84, 60798]]}, {"verse": 10, "start": 61815, "end": 65798, "text": "Y le rogaba mucho que no le enviase fuera de aquella provincia.", "words": [[0, 61902], [2, 62022], [5, 62142], [12, 62662], [18, 62982], [22, 63182], [25, 63362], [28, 63482], [36, 63962], [42, 64302], [45, 64542], [53, 64802]]}, {"verse": 11, "start": 66148, "end": 70825, "text": "Y estaba allí cerca del monte una grande manada de cerdos paciendo.", "words": [[0, 66148], [2, 66434], [9, 66754], [14, 67054], [20, 67394], [24, 67694], [30, 68074], [34, 68334], [41, 68734], [48, 69314], [51, 69494], [58, 70190]]}, {"verse": 12, "start": 71175, "end": 77320, "text": "Y le rogaron todos los demonios, diciendo: Envíanos a los cerdos para que entremos en ellos.", "words": [[0, 71175], [2, 71280], [5, 71420], [13, 71980], [19, 72340], [23, 72720], [33, 73420], [43, 74532], [52, 75156], [54, 75276], [58, 75376], [65, 75856], [70, 76076], [74, 76216], [83, 76656], [86, 76796]]}, {"verse": 13, "start": 77600, "end": 91311, "text": "Y luego Jesús se lo permitió. Y saliendo aquellos espíritus inmundos, entraron en los cerdos, y la manada cayó por un despeñadero en el mar; los cuales eran como dos mil; y en el mar se ahogaron.", "words": [[0, 77600], [2, 77741], [8, 77881], [14, 78301], [17, 78641], [20, 78741], [30, 79693], [32, 79797], [41, 80357], [50, 80517], [60, 81257], [70, 82037], [79, 82817], [82, 82937], [86, 83077], [94, 83837], [96, 84277], [99, 84437], [106, 84777], [111, 85237], [115, 85477], [118, 85617], [130, 86377], [133, 86517], [136, 86637], [141, 87263], [145, 87386], [152, 87546], [157, 87926], [162, 88352], [166, 88778], [171, 89392], [173, 89547], [176, 89687], [179, 89807], [183, 90047], [186, 90287]]}, {"verse": 14, "start": 91661, "end": 101520, "text": "Y los que apacentaban los cerdos huyeron, y dieron aviso en la ciudad y en los campos. Y salieron para ver qué era aquello que había acontecido.", "words": [[0, 91661], [2, 91783], [6, 91903], [10, 92373], [22, 92843], [26, 93003], [33, 93603], [42, 94363], [44, 94843], [51, 95123], [57, 95523], [60, 95683], [63, 95803], [70, 96123], [72, 96383], [75, 96483], [79, 96603], [87, 97707], [89, 97968], [98, 98448], [103, 98708], [107, 98928], [111, 99128], [115, 99488], [123, 100008], [127, 100148], [133, 100448]]}, {"verse": 15, "start": 101870, "end": 113429, "text": "Y vienen a Jesús, y ven al que había sido atormentado del demonio, y que había tenido la legión, sentado y vestido, y en su juicio cabal; y tuvieron miedo.", "words": [[0, 101870], [2, 101972], [9, 102232], [11, 102412], [18, 103472], [20, 103732], [24, 103932], [27, 104192], [31, 104392], [37, 104592], [42, 104952], [54, 105832], [58, 106052], [67, 107052], [69, 107212], [73, 107352], [79, 107552], [86, 107872], [89, 108112], [97, 108932], [105, 109492], [107, 109592], [116, 110252], [118, 110612], [121, 110752], [124, 110912], [131, 111312], [138, 112230], [140, 112434], [149, 112794]]}, {"verse": 16, "start": 113779, "end": 121457, "text": "Y les contaron los que lo habían visto, cómo había acontecido al que había tenido el demonio, y lo de los cerdos.", "words": [[0, 113779], [2, 113903], [6, 114023], [15, 114723], [19, 114943], [23, 115103], [26, 115263], [33, 115523], [40, 116523], [45, 116783], [51, 117203], [62, 118183], [65, 118303], [69, 118443], [75, 118683], [82, 118983], [85, 119223], [94, 120083], [96, 120243], [99, 120403], [102, 120503], [106, 120643]]}, {"verse": 17, "start": 121807, "end": 124988, "text": "Y comenzaron a rogarle que se fuese de su región.", "words": [[0, 121807], [2, 121893], [13, 122593], [15, 122983], [23, 123373], [27, 123533], [30, 123673], [36, 123993], [39, 124133], [42, 124293]]}, {"verse": 18, "start": 125338, "end": 132377, "text": "Y entrando él en el barco, le rogaba el que había estado poseído por el demonio, para estar con él.", "words": [[0, 125338], [2, 125483], [11, 125983], [14, 126323], [17, 126623], [20, 126783], [27, 127763], [30, 128263], [37, 128763], [40, 129003], [44, 129163], [50, 129363], [57, 129703], [65, 130403], [69, 130643], [72, 130783], [81, 131323], [86, 131523], [92, 131783], [96, 132083]]}, {"verse": 19, "start": 132727, "end": 144107, "text": "Pero Jesús no le permitió, sino le dijo: Vete a tu casa, a los tuyos, y cuéntales cuán grandes cosas el Señor ha hecho contigo, y cómo ha tenido misericordia de ti.", "words": [[0, 132727], [5, 132871], [11, 133271], [14, 133771], [17, 133931], [27, 134461], [32, 134991], [35, 135131], [41, 135939], [46, 136244], [48, 136364], [51, 136444], [57, 136824], [59, 137224], [63, 137324], [70, 137864], [72, 138024], [82, 138444], [87, 138744], [95, 139084], [101, 139484], [104, 139744], [110, 140084], [113, 140424], [119, 140684], [128, 141304], [130, 141684], [135, 142024], [138, 142204], [145, 142524], [158, 143584], [161, 143704]]}, {"verse": 20, "start": 144457, "end": 153109, "text": "Y se fue, y comenzó a publicar en Decápolis cuán grandes cosas Jesús había hecho con él: y todos se maravillaban.", "words": [[0, 144457], [2, 144623], [5, 144703], [10, 145208], [12, 145308], [20, 145888], [22, 145988], [31, 146528], [34, 146628], [44, 147268], [49, 147828], [57, 148248], [63, 148608], [69, 149128], [75, 149688], [81, 150048], [85, 150308], [89, 150915], [91, 151217], [97, 151597], [100, 152057]]}, {"verse": 21, "start": 153459, "end": 161222, "text": "Y pasando otra vez Jesús en un barco a la otra parte, se juntó a él una gran multitud; y estaba junto al mar.", "words": [[0, 153459], [2, 153562], [10, 153962], [15, 154302], [19, 154622], [25, 155022], [28, 155402], [31, 155542], [37, 155922], [39, 156022], [42, 156082], [47, 156242], [54, 157102], [57, 157402], [63, 157902], [65, 158022], [68, 158142], [72, 158322], [77, 158602], [87, 159816], [89, 159924], [96, 160224], [102, 160544], [105, 160784]]}, {"verse": 22, "start": 161572, "end": 168965, "text": "Y vino uno de los dirigentes de la sinagoga, llamado Jairo; y luego que le vio, se postró a sus pies,", "words": [[0, 161572], [2, 161696], [7, 161976], [11, 162396], [14, 162616], [18, 162736], [29, 163436], [32, 163596], [35, 163716], [45, 164436], [53, 164836], [60, 165999], [62, 166146], [68, 166326], [72, 166606], [75, 166746], [80, 167066], [83, 167606], [90, 168106], [92, 168226], [96, 168326]]}, {"verse": 23, "start": 169315, "end": 177272, "text": "Y le rogaba mucho, diciendo: Mi hija está a punto de morir: ven y pondrás las manos sobre ella para que sane, y vivirá.", "words": [[0, 169315], [2, 169439], [5, 169789], [12, 170139], [19, 170999], [29, 171952], [32, 172090], [37, 172410], [42, 172630], [44, 172770], [50, 172970], [53, 173210], [60, 173920], [64, 174147], [66, 174327], [74, 174707], [78, 174847], [84, 175087], [90, 175447], [95, 175687], [100, 175947], [104, 176107], [110, 176407], [112, 176727]]}, {"verse": 24, "start": 177552, "end": 181928, "text": "Y fue con él, y le seguía gran multitud, y le apretaban.", "words": [[0, 177552], [2, 177693], [6, 177853], [10, 178133], [14, 178393], [16, 178933], [19, 179073], [26, 179513], [31, 179813], [41, 180593], [43, 180828], [46, 180948]]}, {"verse": 25, "start": 182278, "end": 186905, "text": "Y una mujer que padecía hemorragias desde hacía doce años,", "words": [[0, 182278], [2, 182535], [6, 182695], [12, 183015], [16, 183215], [24, 183835], [36, 184855], [42, 185195], [48, 185655], [53, 186115]]}, {"verse": 26, "start": 187255, "end": 196442, "text": "Y había sufrido mucho de muchos médicos, y había gastado todo lo que tenía, y no había mejorado, antes le iba peor,", "words": [[0, 187255], [2, 187399], [8, 187619], [16, 188279], [22, 188799], [25, 189059], [32, 189299], [41, 190159], [43, 190584], [49, 190824], [57, 191484], [62, 191884], [65, 192144], [69, 192284], [76, 192744], [78, 193089], [81, 193229], [87, 193489], [97, 194549], [103, 195049], [106, 195589], [110, 195829]]}, {"verse": 27, "start": 196792, "end": 202837, "text": "Cuando oyó hablar de Jesús, llegó por detrás entre la multitud, y tocó su vestido.", "words": [[0, 196792], [7, 196994], [11, 197454], [18, 197734], [21, 197974], [28, 198914], [34, 199354], [38, 199714], [45, 200274], [51, 200554], [54, 200754], [64, 201394], [66, 201629], [71, 201989], [74, 202129]]}, {"verse": 28, "start": 203187, "end": 207455, "text": "Porque decía: Si toco tan solamente su vestido, seré salva.", "words": [[0, 203187], [7, 203408], [14, 204275], [17, 204455], [22, 204815], [26, 205035], [36, 205455], [39, 205795], [48, 206635], [53, 206955]]}, {"verse": 29, "start": 207735, "end": 214256, "text": "Y luego se detuvo la hemorragia; y sintió en el cuerpo que estaba sana de aquella enfermedad.", "words": [[0, 207735], [2, 207861], [8, 208121], [11, 208361], [18, 208841], [21, 209041], [33, 210291], [35, 210540], [42, 211100], [45, 211320], [48, 211460], [55, 211840], [59, 212060], [66, 212320], [71, 212740], [74, 212960], [82, 213340]]}, {"verse": 30, "start": 214606, "end": 223833, "text": "Y luego Jesús, conociendo en sí mismo el poder que había salido de él, volviéndose a la multitud, dijo: ¿Quién ha tocado mis vestidos?", "words": [[0, 214606], [2, 214732], [8, 214952], [15, 216032], [26, 216612], [29, 216832], [32, 216972], [38, 217372], [41, 217492], [47, 217752], [51, 218012], [57, 218212], [64, 218712], [67, 218932], [71, 219437], [83, 220177], [85, 220277], [88, 220377], [98, 221397], [104, 222062], [111, 222326], [114, 222426], [121, 222866], [125, 223026]]}, {"verse": 31, "start": 224183, "end": 229553, "text": "Y le dijeron sus discípulos: Ves que la multitud te aprieta, y dices: ¿Quién me ha tocado?", "words": [[0, 224183], [2, 224327], [5, 224387], [13, 224847], [17, 225007], [29, 226079], [33, 226260], [37, 226460], [40, 226560], [49, 227060], [52, 227200], [61, 227660], [63, 227840], [70, 228620], [77, 228839], [80, 228919], [83, 229019]]}, {"verse": 32, "start": 229833, "end": 233732, "text": "Y él miraba alrededor para ver a la que había hecho esto.", "words": [[0, 229833], [2, 230017], [5, 230137], [12, 230617], [22, 231117], [27, 231677], [31, 231997], [33, 232217], [36, 232317], [40, 232497], [46, 232817], [52, 233117]]}, {"verse": 33, "start": 234082, "end": 244237, "text": "Entonces la mujer, temiendo y temblando, sabiendo lo que en sí había sido hecho, vino y se postró delante de él, y le dijo toda la verdad.", "words": [[0, 234082], [9, 234883], [12, 234995], [19, 235275], [28, 235935], [30, 236055], [41, 236715], [50, 237435], [53, 237635], [57, 237795], [60, 238115], [63, 238415], [69, 238775], [74, 239235], [81, 239995], [86, 240395], [88, 240895], [91, 241035], [98, 241475], [106, 241855], [109, 242035], [113, 242255], [115, 242715], [118, 242815], [123, 243135], [128, 243395], [131, 243615]]}, {"verse": 34, "start": 244587, "end": 250717, "text": "Y él le dijo: Hija, tu fe te ha hecho salva: ve en paz, y queda sana de tu enfermedad.", "words": [[0, 244587], [2, 244732], [5, 244872], [8, 245032], [14, 245789], [20, 246113], [23, 246253], [26, 246493], [29, 246713], [32, 246813], [38, 246993], [45, 247923], [48, 248017], [51, 248110], [56, 248470], [58, 249070], [64, 249290], [69, 249610], [72, 249810], [75, 249950]]}, {"verse": 35, "start": 251067, "end": 258547, "text": "Hablando aún él, vinieron de casa del dirigente de la sinagoga, diciendo: Tu hija ha muerto; ¿para qué molestas más al Maestro?", "words": [[0, 251067], [9, 251476], [13, 251876], [17, 251936], [26, 252436], [29, 252636], [34, 252876], [38, 253076], [48, 253716], [51, 253836], [54, 253936], [64, 254516], [74, 255495], [77, 255599], [82, 255899], [85, 255899], [93, 256680], [99, 256825], [103, 256965], [112, 257505], [116, 257705], [119, 257905]]}, {"verse": 36, "start": 258827, "end": 267101, "text": "Pero luego Jesús, oyendo esta razón que se decía, dijo al dirigente de la sinagoga: No temas, cree solamente.", "words": [[0, 258827], [5, 258991], [11, 259291], [18, 259991], [25, 260411], [30, 260671], [36, 261111], [40, 261331], [43, 261491], [50, 262551], [55, 262851], [58, 263071], [68, 263691], [71, 263851], [74, 263991], [84, 265021], [87, 265150], [94, 265930], [99, 266130]]}, {"verse": 37, "start": 267451, "end": 273942, "text": "Y no permitió que alguno viniese tras él sino Pedro, y Jacobo, y Juan hermano de Jacobo.", "words": [[0, 267451], [2, 267577], [5, 267697], [14, 268297], [18, 268457], [25, 268897], [33, 269337], [38, 269617], [41, 270077], [46, 270157], [53, 270697], [55, 270942], [63, 272002], [65, 272122], [70, 272642], [78, 273122], [81, 273202]]}, {"verse": 38, "start": 274292, "end": 280430, "text": "Y vino a casa del dirigente de la sinagoga, y vio la conmoción, los que lloraban y gemían mucho.", "words": [[0, 274292], [2, 274418], [7, 274658], [9, 274858], [14, 275118], [18, 275418], [28, 276038], [31, 276158], [34, 276278], [44, 276938], [46, 277078], [50, 277278], [53, 277378], [64, 278158], [68, 278618], [72, 278798], [81, 279318], [83, 279478], [90, 279858]]}, {"verse": 39, "start": 280780, "end": 288219, "text": "Y entrando, les dice: ¿Por qué alborotáis y lloráis? La muchacha no es muerta, sino que duerme.", "words": [[0, 280780], [2, 281052], [12, 281552], [16, 281792], [22, 282659], [27, 282765], [31, 283045], [42, 284065], [44, 284365], [53, 285350], [56, 285486], [65, 285946], [68, 286146], [71, 286246], [79, 286966], [84, 287326], [88, 287566]]}, {"verse": 40, "start": 288569, "end": 301007, "text": "Y se burlaban de él: pero él, después de hacer salir a todos, toma al padre y a la madre de la muchacha, y a los que estaban con él, y entra donde la muchacha estaba.", "words": [[0, 288569], [2, 288735], [5, 288875], [14, 289435], [17, 289715], [21, 290328], [26, 290516], [30, 291376], [38, 291816], [41, 292016], [47, 292356], [53, 292756], [55, 292936], [62, 293996], [67, 294376], [70, 294616], [76, 295056], [78, 295416], [80, 295496], [83, 295616], [89, 295976], [92, 296176], [95, 296296], [105, 296896], [107, 297376], [109, 297476], [113, 297596], [117, 297756], [125, 298056], [129, 298396], [133, 298997], [135, 299159], [141, 299459], [147, 299699], [150, 299919], [159, 300359]]}, {"verse": 41, "start": 301357, "end": 309429, "text": "Y tomando la mano de la muchacha, le dice: Talitha cumi; que traducido significa: Muchacha, a ti digo, levántate.", "words": [[0, 301357], [2, 301498], [10, 301978], [13, 302158], [18, 302438], [21, 302598], [24, 302718], [34, 303338], [37, 303438], [43, 304561], [51, 304886], [57, 305431], [61, 305534], [71, 306254], [82, 307433], [92, 308158], [94, 308158], [97, 308278], [103, 308698]]}, {"verse": 42, "start": 309779, "end": 316935, "text": "Y luego la muchacha se levantó, y andaba; porque tenía doce años. Y quedaron sumamente asombrados.", "words": [[0, 309779], [2, 309883], [8, 310083], [11, 310283], [20, 310763], [23, 310923], [32, 311643], [34, 311883], [42, 312757], [49, 312941], [55, 313271], [60, 313601], [66, 314602], [68, 314726], [77, 315226], [87, 315886]]}, {"verse": 43, "start": 317285, "end": 322735, "text": "Pero él les mandó mucho que nadie lo supiese, y dijo que le diesen de comer.", "words": [[0, 317285], [5, 317450], [8, 317850], [12, 318170], [18, 318650], [24, 318990], [28, 319210], [34, 319510], [37, 319730], [46, 320350], [48, 320950], [53, 321290], [57, 321450], [60, 321610], [67, 321970], [70, 322190]]}]}