{"book": "PSA", "chapter": 41, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 77086, "verses": [{"verse": 1, "start": 300, "end": 5199, "text": "Blessed is he that considers the poor: the LORD will deliver him in time of trouble.", "words": [[0, 300], [8, 607], [11, 907], [14, 1067], [19, 1227], [29, 1687], [33, 2007], [39, 2892], [43, 2989], [48, 3249], [53, 3469], [61, 3829], [65, 4069], [68, 4249], [73, 4489], [76, 4689]]}, {"verse": 2, "start": 5649, "end": 13766, "text": "The LORD will preserve him, and keep him alive; and he shall be blessed upon the earth: and you will not deliver him to the will of his enemies.", "words": [[0, 5649], [4, 5751], [9, 6011], [14, 6231], [23, 6651], [28, 6991], [32, 7471], [37, 7731], [41, 7911], [48, 8864], [52, 8989], [55, 9129], [61, 9329], [64, 9489], [72, 9789], [77, 10129], [81, 10409], [88, 11066], [92, 11187], [96, 11307], [101, 11447], [105, 11647], [113, 12047], [117, 12287], [120, 12487], [124, 12627], [129, 12807], [132, 12947], [136, 13087]]}, {"verse": 3, "start": 14216, "end": 19276, "text": "The LORD will strengthen him upon the bed of languishing: you will make all his bed in his sickness.", "words": [[0, 14216], [4, 14305], [9, 14565], [14, 14745], [25, 15085], [29, 15405], [34, 15645], [38, 15865], [42, 16025], [45, 16125], [58, 17195], [62, 17300], [67, 17420], [72, 17580], [76, 17860], [80, 18040], [84, 18240], [87, 18440], [91, 18580]]}, {"verse": 4, "start": 19726, "end": 25328, "text": "I said, LORD, be merciful to me: heal my soul; for I have sinned against you.", "words": [[0, 19726], [2, 19851], [8, 20171], [14, 20751], [17, 20951], [26, 21351], [29, 21711], [33, 22360], [38, 22550], [41, 22790], [47, 23668], [51, 23758], [53, 23978], [58, 24138], [65, 24598], [73, 24798]]}, {"verse": 5, "start": 25778, "end": 29941, "text": "My enemies speak evil of me, When shall he die, and his name perish?", "words": [[0, 25778], [3, 25904], [11, 26244], [17, 26664], [22, 27044],