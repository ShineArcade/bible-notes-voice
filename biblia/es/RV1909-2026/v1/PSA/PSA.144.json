{"book": "PSA", "chapter": 144, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 111332, "verses": [{"verse": 1, "start": 300, "end": 7840, "text": "Salmo de David. BENDITO sea Jehová, mi roca, que enseña mis manos a la batalla, y mis dedos a la guerra:", "words": [[0, 300], [6, 770], [9, 930], [16, 1540], [24, 2085], [28, 2392], [36, 2698], [39, 3005], [45, 3805], [49, 4065], [56, 4565], [60, 4725], [66, 5065], [68, 5305], [71, 5365], [80, 5885], [82, 6345], [86, 6525], [92, 6985], [94, 7125], [97, 7205]]}, {"verse": 2, "start": 8190, "end": 17521, "text": "Misericordia mía y mi castillo, altura mía y mi libertador, escudo mío, en quien he confiado; el que somete mi pueblo delante de mí.", "words": [[0, 8190], [13, 8976], [17, 9156], [19, 9336], [22, 9436], [32, 10636], [39, 10856], [43, 11106], [45, 11356], [48, 11456], [60, 12436], [67, 12876], [72, 13356], [75, 13676], [81, 13876], [84, 14056], [94, 15152], [97, 15277], [101, 15397], [108, 15917], [111, 16017], [118, 16377], [126, 16917], [129, 17097]]}, {"verse": 3, "start": 17871, "end": 24290, "text": "Oh Jehová, ¿qué es el hombre, para que lo conozcas? ¿o el hijo del hombre, para que lo estimes?", "words": [[0, 18090], [3, 18341], [11, 18593], [16, 18993], [19, 19193], [22, 19373], [30, 19713], [35, 20233], [39, 20393], [42, 20533], [52, 21655], [55, 21761], [58, 21901], [63, 22121], [67, 22321], [75, 22701], [80, 23181], [84, 23321], [87, 23481]]}, {"verse": 4, "start": 24640, "end": 29523, "text": "El hombre es semejante a la vanidad: sus días son como la sombra que pasa.", "words": [[0, 24640], [3, 24900], [10, 25160], [13, 25400], [23, 26080], [25, 26200], [28, 26300], [37, 27241], [41, 27385], [46, 27665], [50, 27925], [55, 28145], [58, 28305], [65, 28745], [69, 28885]]}, {"verse": 5, "start": 29873, "end": 35277, "text": "Oh Jehová, inclina tus cielos y desciende: toca los montes, y humeen.", "words": [[0, 30197], [3, 30587], [11, 30977], [19, 31367], [23, 31607], [30, 32287], [32, 32427], [43, 33494], [48, 33859], [52, 33959], [60, 34539], [62, 34913]]}, {"verse": 6, "start": 35627, "end": 41463, "text": "Despide relámpagos, y disípalos; envía tus flechas, y confúndelos.", "words": [[0, 35627], [8, 36309], [20, 37609], [22, 37769], [33, 38850], [39, 39373], [43, 39573], [52, 40153], [54, 40433]]}, {"verse": 7, "start": 41813, "end": 48890, "text": "Envía tu mano desde lo alto; redímeme, y sácame de las muchas aguas, de la mano de los hijos extraños;", "words": [[0, 41883], [6, 42283], [9, 42443], [14, 42723], [20, 42983], [23, 43243], [29, 44053], [39, 44697], [41, 44862], [48, 45362], [51, 45542], [55, 45682], [62, 45942], [69, 46662], [72, 47042], [75, 47142], [80, 47362], [83, 47522], [87, 47662], [93, 47882]]}, {"verse": 8, "start": 49240, "end": 54210, "text": "Cuya boca habla vanidad, y su diestra es diestra de mentira.", "words": [[0, 49240], [5, 49546], [10, 49926], [16, 50306], [25, 50866], [27, 51281], [30, 51461], [38, 52001], [41, 52421], [49, 53121], [52, 53341]]}, {"verse": 9, "start": 54560, "end": 60342, "text": "Oh Dios, a ti cantaré canción nueva: con salterio, con decacordio cantaré a ti.", "words": [[0, 54663], [3, 54803], [9, 54943], [11, 55183], [14, 55383], [22, 55983], [30, 56263], [37, 57290], [41, 57433], [51, 58533], [55, 58693], [66, 59353], [74, 59833], [76, 59953]]}, {"verse": 10, "start": 60692, "end": 67166, "text": "Tú, el que da victoria a los reyes, el que redime a David su siervo de maligna espada.", "words": [[0, 60692], [4, 61294], [7, 61394], [11, 61534], [14, 61694], [23, 62294], [25, 62434], [29, 62554], [36, 63294], [39, 63494], [43, 63614], [50, 64134], [52, 64374], [58, 64734], [61, 65194], [68, 65734], [71, 65854], [79, 66414]]}, {"verse": 11, "start": 67516, "end": 76285, "text": "Redímeme, y sálvame de mano de los hijos extraños, cuya boca habla vanidad, y su diestra es diestra de mentira.", "words": [[0, 67516], [10, 68180], [12, 68420], [20, 68900], [23, 69080], [28, 69340], [3