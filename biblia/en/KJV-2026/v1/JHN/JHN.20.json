{"book": "JHN", "chapter": 20, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 238960, "verses": [{"verse": 1, "start": 300, "end": 7747, "text": "The first day of the week comes Mary Magdalene early, when it was yet dark, to the tomb, and sees the stone taken away from the tomb.", "words": [[0, 300], [4, 386], [10, 586], [14, 806], [17, 886], [21, 986], [26, 1186], [32, 1466], [37, 1786], [47, 2386], [54, 3246], [59, 3326], [62, 3446], [66, 3586], [70, 3766], [76, 4146], [79, 4506], [83, 4646], [89, 4926], [93, 5526], [98, 5726], [102, 5986], [108, 6326], [114, 6666], [119, 6946], [124, 7166], [128, 7306]]}, {"verse": 2, "start": 8097, "end": 19909, "text": "Then she runs, and comes to Simon Peter, and to the other disciple, whom Jesus loved, and says to them, They have taken away the Lord out of the tomb, and we know not where they have laid him.", "words": [[0, 8097], [5, 8363], [9, 8623], [15, 8983], [19, 9243], [25, 9503], [28, 9703], [34, 10003], [41, 10403], [45, 10723], [48, 10863], [52, 10983], [58, 11183], [68, 11703], [73, 12038], [79, 12398], [86, 12998], [90, 13558], [95, 13798], [98, 14018], [104, 14622], [109, 14762], [114, 14962], [120, 15262], [125, 15522], [129, 15722], [134, 15982], [138, 16302], [141, 16422], [145, 16542], [151, 17342], [155, 17502], [158, 17682], [163, 17922], [167, 18142], [173, 18382], [178, 18582], [183, 18762], [188, 18982]]}, {"verse": 3, "start": 20189, "end": 24668, "text": "Peter therefore went forth, and that other disciple, and came to the tomb.", "words": [[0, 20189], [6, 20409], [16, 20909], [21, 21209], [28, 22189], [32, 22309], [37, 22449], [43, 22649], [53, 23489], [57, 23589], [62, 23849], [65, 24049], [69, 24169]]}, {"verse": 4, "start": 25018, "end": 30709, "text": "So they ran both together: and the other disciple did outrun Peter, and came first to the tomb.", "words": [[0, 25018], [3, 25163], [8, 25323], [12, 25603], [17, 25863], [27, 26802], [31, 26941], [35, 27041], [41, 27201], [50, 27701], [54, 28041], [61, 28601], [68, 28981], [72, 29361], [77, 29581], [83, 29901], [86, 30141], [90, 30221]]}, {"verse": 5, "start": 31059, "end": 36789, "text": "And he stooping down, and looking in, saw the linen clothes lying; yet went he not in.", "words": [[0, 31059], [4, 31228], [7, 31418], [16, 31878], [22, 32198], [26, 32478], [34, 32738], [38, 33058], [42, 33418], [46, 33598], [52, 33858], [60, 34338], [67, 35379], [71, 35583], [76, 35823], [79, 35983], [83, 36203]]}, {"verse": 6, "start": 37139, "end": 42433, "text": "Then comes Simon Peter following him, and went into the tomb, and sees the linen clothes lie,", "words": [[0, 37139], [5, 37399], [11, 37679], [17, 37999], [23, 38339], [33, 38799], [38, 39159], [42, 39279], [47, 39439], [52, 39659], [56, 39799], [62, 40579], [66, 40679], [71, 40899], [75, 41119], [81, 41319], [89, 41699]]}, {"verse": 7, "start": 42783, "end": 49475, "text": "And the cloth, that was about his head, not lying with the linen clothes, but wrapped together in a place by itself.", "words": [[0, 42783], [4, 42925], [8, 43045], [15, 43345], [20, 43625], [24, 43825], [30, 44065], [34, 44305], [40, 44785], [44, 44985], [50, 45385], [55, 45605], [59, 45785], [65, 46024], [74, 47105], [78, 47245], [86, 47505], [95, 48005], [98, 48245], [100, 48345], [106, 48645], [109, 48945]]}, {"verse": 8, "start": 49825, "end": 55857, "text": "Then went in also that other disciple, which came first to the tomb, and he saw, and believed.", "words": [[0, 49825], [5, 50033], [10, 50253], [13, 50413], [18, 50753], [23, 51033], [29, 51273], [39, 52033], [45, 52233], [50, 52493], [56, 52833], [59, 53053], [63, 53153], [69, 54013], [73, 54133], [76, 54293], [81, 54693], [85, 55113]]}, {"verse": 9, "start": 56207, "end": 60517, "text": "For as yet they knew not the scripture, that he must rise again from the dead.", "words": [[0, 56207], [4, 56330], [7, 56530], [11, 56730], [16, 56950], [21, 57150], [25, 57330], [29, 57510], [40, 58350], [45, 58510], [48, 58630], [53, 58810], [58, 59210], [64, 59610], [69, 59890], [73, 60030]]}, {"verse": 10, "start": 60867, "end": 63824, "text": "Then the disciples went away again to their own home.", "words": [[0, 60867], [5, 61103], [9, 61283], [19, 61723], [24, 62043], [29, 62303], [35, 62683], [38, 62863], [44, 63043], [48, 63303]]}, {"verse": 11, "start": 64174, "end": 69958, "text": "¶ But Mary stood without at the tomb weeping: and as she wept, she stooped down, and looked into the tomb,", "words": [[2, 64174], [6, 64278], [11, 64598], [17, 64918], [25, 65318], [28, 65498], [32, 65598], [37, 65998], [46, 66709], [50, 66835], [53, 67015], [57, 67195], [63, 67715], [67, 67815], [75, 68335], [81, 68595], [85, 68855], [92, 69035], [97, 69295], [101, 69455]]}, {"verse": 12, "start": 70308, "end": 77636, "text": "And sees two angels in white sitting, the one at the head, and the other at the feet, where the body of Jesus had lain.", "words": [[0, 70308], [4, 70438], [9, 70678], [13, 71018], [20, 71538], [23, 71818], [29, 72158], [38, 73038], [42, 73218], [46, 73478], [49, 73618], [53, 73718], [59, 73978], [63, 74498], [67, 74638], [73, 74838], [76, 75038], [80, 75158], [86, 75618], [92, 75858], [96, 75998], [101, 76298], [104, 76478], [110, 76818], [114, 77098]]}, {"verse": 13, "start": 77986, "end": 86698, "text": "And they say to her, Woman, why do you weep? She says to them, Because they have taken away my Lord, and I know not where they have laid him.", "words": [[0, 77986], [4, 78125], [9, 78245], [13, 78505], [16, 78705], [21, 79276], [28, 79894], [32, 80034], [35, 80174], [39, 80274], [45, 80968], [49, 81108], [54, 81348], [57, 81568], [63, 82186], [71, 82406], [76, 82586], [81, 82746], [87, 83106], [92, 83386], [95, 83626], [101, 84566], [105, 84806], [107, 84966], [112, 85186], [116, 85386], [122, 85626], [127, 85826], [132, 86006], [137, 86206]]}, {"verse": 14, "start": 86978, "end": 93052, "text": "And when she had thus said, she turned herself back, and saw Jesus standing, and knew not that it was Jesus.", "words": [[0, 86978], [4, 87114], [9, 87274], [13, 87494], [17, 87674], [22, 87914], [28, 88394], [32, 88554], [39, 88834], [47, 89134], [53, 89494], [57, 89789], [61, 90049], [67, 90409], [77, 90909], [81, 91429], [86, 91629], [90, 91909], [95, 92129], [98, 92229], [102, 92369]]}, {"verse": 15, "start": 93402, "end": 107019, "text": "Jesus says to her, Woman, why do you weep? whom do you seek? She, supposing him to be the gardener, says to him, Sir, if you have borne him from here, tell me where you have laid him, and I will take him away.", "words": [[0, 93402], [6, 93692], [11, 93992], [14, 94212], [19, 94787], [26, 95435], [30, 95655], [33, 95835], [37, 95975], [43, 96713], [48, 96964], [51, 97084], [55, 97184], [61, 98172], [66, 98322], [76, 98722], [80, 98882], [83, 99022], [86, 99162], [90, 99282], [100, 99962], [105, 100422], [108, 100662], [113, 101159], [118, 101679], [121, 101819], [125, 102039], [130, 102219], [136, 102679], [140, 102799], [145, 102999], [151, 103719], [156, 103959], [159, 104159], [165, 104359], [169, 104559], [174, 104719], [179, 104959], [184, 105599], [188, 105719], [190, 105899], [195, 106039], [200, 106279], [204, 106499]]}, {"verse": 16, "start": 107299, "end": 114397, "text": "Jesus says to her, Mary. She turned herself, and says to him, Rabboni; which is to say, Master.", "words": [[0, 107299], [6, 107539], [11, 107879], [14, 108099], [19, 108652], [25, 109495], [29, 109635], [36, 109995], [45, 110355], [49, 110615], [54, 110835], [57, 111055], [62, 111983], [71, 112596], [77, 112744], [80, 112924], [83, 113064], [88, 113424]]}, {"verse": 17, "start": 114747, "end": 126899, "text": "Jesus says to her, Touch me not; for I am not yet ascended to my Father: but go to my brethren, and say to them, I ascend to my Father, and your Father; and to my God, and your God.", "words": [[0, 114747], [6, 115011], [11, 115331], [14, 115551], [19, 116059], [25, 116258], [28, 116478], [33, 11718