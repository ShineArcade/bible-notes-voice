{"book": "GEN", "chapter": 31, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 440926, "verses": [{"verse": 1, "start": 300, "end": 9735, "text": "And he heard the words of Laban’s sons, saying, Jacob has taken away all that was our father’s; and of that which was our father’s has he gotten all this glory.", "words": [[0, 300], [4, 450], [7, 610], [13, 870], [17, 1050], [23, 1350], [26, 1590], [34, 2270], [40, 2610], [48, 3946], [54, 4182], [58, 4402], [64, 4662], [69, 4922], [73, 5302], [78, 5502], [82, 5702], [86, 5862], [96, 6823], [100, 6947], [103, 7047], [108, 7347], [114, 7447], [118, 7627], [122, 7767], [131, 8307], [135, 8407], [138, 8527], [145, 8787], [149, 9067], [154, 9267]]}, {"verse": 2, "start": 10085, "end": 15980, "text": "And Jacob beheld the countenance of Laban, and, behold, it was not toward him as before.", "words": [[0, 10085], [4, 10236], [10, 10536], [17, 11056], [21, 11216], [33, 11796], [36, 11936], [43, 12696], [48, 13156], [56, 13936], [59, 14016], [63, 14196], [67, 14456], [74, 14736], [78, 14976], [81, 15196]]}, {"verse": 3, "start": 16430, "end": 22678, "text": "And the LORD said to Jacob, Return to the land of your fathers, and to your kindred; and I will be with you.", "words": [[0, 16430], [4, 16555], [8, 16675], [13, 16875], [18, 17155], [21, 17335], [28, 18164], [35, 18450], [38, 18650], [42, 18730], [47, 18950], [50, 19110], [55, 19210], [64, 19550], [68, 19870], [71, 19990], [76, 20110], [85, 21275], [89, 21376], [91, 21496], [96, 21636], [99, 21776], [104, 21996]]}, {"verse": 4, "start": 23028, "end": 26761, "text": "And Jacob sent and called Rachel and Leah to the field to his flock,", "words": [[0, 23028], [4, 23175], [10, 23495], [15, 23855], [19, 24075], [26, 24315], [33, 24715], [37, 24935], [42, 25195], [45, 25395], [49, 25515], [55, 25835], [58, 26075], [62, 26255]]}, {"verse": 5, "start": 27211, "end": 34745, "text": "And said to them, I see your father’s countenance, that it is not toward me as before; but the God of my father has been with me.", "words": [[0, 27211], [4, 27354], [9, 27554], [12, 27754], [18, 28343], [20, 28503], [24, 28743], [29, 28903], [38, 29363], [51, 30183], [56, 30463], [59, 30603], [62, 30743], [66, 30983], [73, 31263], [76, 31523], [79, 31703], [87, 32664], [91, 32788], [95, 32928], [99, 33188], [102, 33308], [105, 33488], [112, 33848], [116, 34088], [121, 34268], [126, 34428]]}, {"verse": 6, "start": 35195, "end": 37919, "text": "And you know that with all my power I have served your father.", "words": [[0, 35195], [4, 35341], [8, 35461], [13, 35661], [18, 35901], [23, 36081], [27, 36241], [30, 36401], [36, 36761], [38, 36941], [43, 37041], [50, 37301], [55, 37461]]}, {"verse": 7, "start": 38369, "end": 43949, "text": "And your father has deceived me, and changed my wages ten times; but God did not allow him to hurt me.", "words": [[0, 38369], [4, 38482], [9, 38582], [16, 38822], [20, 39062], [29, 39342], [33, 39702], [37, 40042], [45, 40342], [48, 40542], [54, 40862], [58, 41202], [65, 42157], [69, 42254], [73, 42494], [77, 42674], [81, 42814], [87, 43134], [91, 43334], [94, 43474], [99, 43674]]}, {"verse": 8, "start": 44399, "end": 54750, "text": "If he said thus, The speckled shall be your wages; then all the cattle bore speckled: and if he said thus, The streaked shall be your hire; then bore all the cattle streaked.", "words": [[0, 44399], [3, 44562], [6, 44682], [11, 44922], [17, 45682], [21, 45862], [30, 46362], [36, 46622], [39, 46842], [44, 47042], [51, 47979], [56, 48118], [60, 48418], [64, 48598], [71, 48898], [76, 49198], [86, 50161], [90, 50257], [93, 50357], [96, 50457], [101, 50657], [107, 51357], [111, 51587], [120, 51817], [126, 52057], [129, 52217], [134, 52357], [140, 53126], [145, 53295], [150, 53515], [154, 53855], [158, 53995], [165, 54395]]}, {"verse": 9, "start": 55200, "end": 59174, "text": "Thus God has taken away the cattle of your father, and given them to me.", "words": [[0, 55200], [5, 55436], [9, 55796], [13, 56076], [19, 56396], [24, 56636], [28, 56816], [35, 57076], [38, 57236], [43, 57356], [51, 57676], [55, 58196], [61, 58456], [66, 58696], [69, 58876]]}, {"verse": 10, "start": 59624, "end": 69437, "text": "And it came to pass at the time that the cattle conceived, that I lifted up my eyes, and saw in a dream, and, behold, the rams which leaped upon the cattle were streaked, speckled, and grisled.", "words": [[0, 59624], [4, 59745], [7, 59865], [12, 60005], [15, 60165], [20, 60425], [23, 60605], [27, 60725], [32, 60965], [37, 61125], [41, 61325], [48, 61525], [59, 61925], [64, 62405], [66, 62525], [73, 62785], [76, 62985], [79, 63145], [85, 63445], [89, 63565], [93, 63785], [96, 63885], [98, 63985], [105, 64245], [110, 64605], [118, 65534], [122, 65687], [127, 66027], [133, 66207], [140, 66547], [145, 66727], [149, 66907], [156, 67207], [161, 67387], [171, 68107], [181, 68547], [185, 68992]]}, {"verse": 11, "start": 69887, "end": 74385, "text": "And the angel of God spoke to me in a dream, saying, Jacob: And I said, Here am I.", "words": [[0, 69887], [4, 70010], [8, 70130], [14, 70510], [17, 70690], [21, 70910], [27, 71210], [30, 71430], [33, 71550], [36, 71610], [38, 71710], [45, 71970], [53, 72450], [60, 73189], [64, 73316], [66, 73436], [72, 73796], [77, 73956], [80, 74136]]}, {"verse": 12, "start": 74835, "end": 83895, "text": "And he said, Lift up now your eyes, and see, all the rams which leap upon the cattle are streaked, speckled, and grisled: for I have seen all that Laban does to you.", "words": [[0, 74835], [4, 74956], [7, 75076], [13, 75376], [18, 75536], [21, 75776], [25, 75996], [30, 76216], [36, 76556], [40, 76776], [45, 77056], [49, 77576], [53, 77716], [58, 77976], [64, 78176], [69, 78376], [74, 78636], [78, 78796], [85, 79096], [89, 79316], [99, 79976], [109, 80596], [113, 81011], [122, 81726], [126, 81834], [128, 82094], [133, 82234], [138, 82454], [142, 82754], [147, 82914], [153, 83294], [158, 83474], [161, 83694]]}, {"verse": 13, "start": 84345, "end": 93121, "text": "I am the God of Beth-el, where you anointed the pillar, and where you vowed a vow to me: now arise, get out from this land, and return to the land of your kindred.", "words": [[0, 84345], [2, 84564], [5, 84704], [9, 84824], [13, 85084], [16, 85204], [25, 85824], [31, 85924], [35, 86084], [44, 86504], [48, 86704], [56, 87004], [60, 87424], [66, 87584], [70, 87704], [76, 88064], [78, 88104], [82, 88284], [85, 88484], [89, 89071], [93, 89231], [100, 90051], [104, 90171], [108, 90331], [113, 90511], [118, 90711], [124, 91111], [128, 91431], [135, 91771], [138, 91951], [142, 92071], [147, 92271], [150, 92411], [155, 92531]]}, {"verse": 14, "start": 93471, "end": 100001, "text": "And Rachel and Leah answered and said to him, Is there yet any portion or inheritance for us in our father’s house?", "words": [[0, 93471], [4, 93614], [11, 93955], [15, 94134], [20, 94354], [29, 94794], [33, 95014], [38, 95234], [41, 95414], [46, 96035], [49, 96234], [55, 96414], [59, 96634], [63, 96895], [71, 97315], [74, 97654], [86, 98175], [90, 98574], [93, 98754], [96, 98895], [100, 99014], [109, 99535]]}, {"verse": 15, "start": 100451, "end": 106367, "text": "Are we not counted of him strangers? for he has sold us, and has quite devoured also our money.", "words": [[0, 100451], [4, 100576], [7, 100716], [11, 100896], [19, 101256], [22, 101476], [26, 101596], [37, 102705], [41, 102855], [44, 103055], [48, 103255], [53, 103575], [57, 104315], [61, 104435], [65, 104595], [71, 104875], [80, 105435], [85, 105715], [89, 105955]]}, {"verse": 16, "start": 106817, "end": 115270, "text": "For all the riches which God has taken from our father, that is ours, and our children’s: now then, whatever God has said to you, do.", "words": [[0, 106817], [4, 106950], [8, 107130], [12, 107270], [19, 107510], [25, 107790], [29, 108030], [33, 108250], [39, 108510], [44, 108750], [48, 108910], [56, 109690], [61, 109790], [64, 109950], [70, 110690], [74, 110870], [78, 111010], [90, 112045], [94, 112296], [100, 112716], [109, 112896], [113, 113296], [117, 113516], [122, 113756], [125, 113956], [130, 114516]]}, {"verse": 17, "start": 115720, "end": 120021, "text": "¶ Then Jacob rose up, and set his sons and his wives upon camels;", "words": [[2, 115720], [7, 115968], [13, 116368], [18, 116728], [22, 117068], [26, 117368], [30, 117628], [34, 117808], [39, 118128], [43, 118348], [47, 118508], [53, 118868], [58, 119148]]}, {"verse": 18, "start": 120471, "end": 132361, "text": "And he carried away all his cattle, and all his goods which he had gotten, the cattle of his getting, which he had gotten in Padan-aram, to go to Isaac his father in the land of Canaan.", "words": [[0, 120471], [4, 120605], [7, 120725], [15, 121025], [20, 121345], [24, 121705], [28, 121925], [36, 122845], [40, 122925], [44, 123125], [48, 123325], [54, 123685], [60, 123925], [63, 124085], [67, 124205], [75, 125005], [79, 125125], [86, 125445], [89, 125645], [93, 125805], [102, 126105], [108, 126465], [111, 126605], [115, 126705], [122, 127025], [125, 127920], [137, 129057], [140, 129151], [143, 129311], [146, 129471], [152, 129911], [156, 130231], [163, 130611], [166, 130951], [170, 131071], [175, 131391], [178, 131591]]}, {"verse": 19, "start": 132811, "end": 138184, "text": "And Laban went to shear his sheep: and Rachel had stolen the images that were her father’s.", "words": [[0, 132811], [4, 132975], [10, 133435], [15, 133635], [18, 133835], [24, 134075], [28, 134315], [35, 135126], [39, 135285], [46, 135605], [50, 135865], [57, 136225], [61, 136465], [68, 136845], [73, 137145], [78, 137305], [82, 137465]]}, {"verse": 20, "start": 138634, "end": 144051, "text": "And Jacob stole away unawares to Laban the Syrian, in that he told him not that he fled.", "words": [[0, 138634], [4, 138785], [10, 139105], [16, 139445], [21, 139725], [30, 140345], [33, 140625], [39, 140905], [43, 141085], [51, 142025], [54, 142105], [59, 142245], [62, 142365], [67, 142565], [71, 142765], [75, 143045], [80, 143425], [83, 143525]]}, {"verse": 21, "start": 144501, "end": 152028, "text": "So he fled with all that he had; and he rose up, and passed over the river, and set his face toward the mount Gilead.", "words": [[0, 144501], [3, 144644], [6, 144804], [11, 145104], [16, 145664], [20, 145864], [25, 146004], [28, 146084], [33, 146844], [37, 146988], [40, 147108], [45, 147388], [49, 147788], [53, 148248], [60, 148568], [65, 148828], [69, 149008], [76, 149268], [80, 149808], [84, 150048], [88, 150248], [93, 150528], [100, 150828], [104, 151028], [110, 151556]]}, {"verse": 22, "start": 152478, "end": 156528, "text": "And it was told Laban on the third day that Jacob was fled.", "words": [[0, 152478], [4, 152617], [7, 152697], [11, 152837], [16, 153077], [22, 153617], [25, 153737], [29, 153877], [35, 154117], [39, 154377], [44, 154537], [50, 154837], [54, 155137]]}, {"verse": 23, "start": 156978, "end": 164061, "text": "And he took his brethren with him, and pursued after him seven days’ journey; and they overtook him in the mount Gilead.", "words": [[0, 156978], [4, 157102], [7, 157222], [12, 157422], [16, 157622], [25, 157982], [30, 158382], [35, 158662], [39, 159102], [47, 159522], [53, 159882], [57, 160122], [63, 160462], [69, 161042], [78, 161872], [82, 162014], [87, 162114], [96, 162674], [100, 162814], [103, 162934], [107, 163034], [113, 163581]]}, {"verse": 24, "start": 164511, "end": 172761, "text": "And God came to Laban the Syrian in a dream by night, and said to him, Take heed that you speak not to Jacob either good or bad.", "words": [[0, 164511], [4, 164662], [8, 165002], [13, 165342], [16, 165652], [22, 165962], [26, 166142], [33, 166562], [36, 166822], [38, 166942], [44, 167282], [47, 167542], [54, 167882], [58, 168322], [63, 168562], [66, 168762], [71, 169318], [76, 169473], [81, 169733], [86, 169933], [90, 170053], [96, 170333], [100, 170613], [103, 170813], [109, 171133], [116, 171393], [121, 171753], [124, 171913]]}, {"verse": 25, "start": 173111, "end": 180651, "text": "¶ Then Laban overtook Jacob. Now Jacob had pitched his tent in the mount: and Laban with his brethren pitched in the mount of Gilead.", "words": [[2, 173111], [7, 173335], [13, 173775], [22, 174295], [29, 175246], [33, 175450], [39, 175789], [43, 176029], [51, 176270], [55, 176510], [60, 176749], [63, 176930], [67, 177029], [74, 177758], [78, 177905], [84, 178285], [89, 178445], [93, 178585], [102, 178965], [110, 179345], [113, 179565], [117, 179665], [123, 179885], [126, 180045]]}, {"verse": 26, "start": 181101, "end": 190183, "text": "And Laban said to Jacob, What have you done, that you have stolen away unawares to me, and carried away my daughters, as captives taken with the sword?", "words": [[0, 181101], [4, 181249], [10, 181589], [15, 181769], [18, 181929], [25, 183344], [30, 183489], [35, 183649], [39, 183829], [45, 184189], [50, 184649], [54, 184829], [59, 184929], [66, 185269], [71, 185629], [80, 186229], [83, 186449], [87, 186609], [91, 186969], [99, 187349], [104, 187549], [107, 187789], [118, 188129], [121, 188569], [130, 189129], [136, 189369], [141, 189549], [145, 189689]]}, {"verse": 27, "start": 190633, "end": 199434, "text": "Why did you flee away secretly, and steal away from me; and did not tell me, that I might have sent you away with mirth, and with songs, with tambourine, and with harp?", "words": [[0, 190633], [4, 190871], [8, 191131], [12, 191251], [17, 191451], [22, 191651], [32, 192231], [36, 192571], [42, 192891], [47, 193171], [52, 193351], [56, 193989], [60, 194114], [64, 194314], [68, 194474], [73, 194814], [77, 195034], [82, 195454], [84, 195574], [90, 195734], [95, 195914], [100, 196174], [104, 196374], [109, 196594], [114, 196794], [121, 197254], [125, 197374], [130, 197534], [137, 197874], [142, 198154], [154, 198734], [158, 198874], [163, 199034]]}, {"verse": 28, "start": 199884, "end": 205242, "text": "And you did not allow me to kiss my sons and my daughters? you have now done foolishly in so doing.", "words": [[0, 199884], [4, 200048], [8, 200148], [12, 200328], [16, 200508], [22, 200808], [25, 201028], [28, 201188], [33, 201388], [36, 201628], [41, 201908], [45, 202108], [48, 202228], [59, 203088], [63, 203208], [68, 203368], [72, 203548], [77, 203788], [87, 204348], [90, 204508], [93, 204728]]}, {"verse": 29, "start": 205692, "end": 213696, "text": "It is in the power of my hand to do you hurt: but the God of your father spoke to me yesternight, saying, Take heed that you speak not to Jacob either good or bad.", "words": [[0, 205692], [3, 205795], [6, 205895], [9, 206035], [13, 206135], [19, 206435], [22, 206615], [25, 206755], [30, 207055], [33, 207215], [36, 207375], [40, 207535], [46, 208262], [50, 208361], [54, 208461], [58, 208681], [61, 208781], [66, 208881], [73, 209141], [79, 209441], [82, 209621], [85, 209951], [98, 210281], [106, 211001], [111, 211181], [116, 211441], [121, 211621], [125, 211761], [131, 212001], [135, 212261], [138, 212441], [144, 212701], [151, 212961], [156, 213181], [159, 213321]]}, {"verse": 30, "start": 214146, "end": 220772, "text": "And now, though you would needs be gone, because you greatly longed for your father’s house, yet why have you stolen my gods?", "words": [[0, 214146], [4, 214317], [9, 214637], [16, 215157], [20, 215337], [26, 215617], [32, 215897], [35, 215977], [41, 216277], [49, 216737], [53, 216917], [61, 217237], [68, 217557], [72, 217757], [77, 217897], [86, 218357], [93, 218577], [97, 219077], [101, 219357], [106, 219537], [110, 219657], [117, 219997], [120, 220237]]}, {"verse": 31, "start": 221122, "end": 228108, "text": "And Jacob answered and said to Laban, Because I was afraid: for I said, Perhaps you would take by force your daughters from me.", "words": [[0, 221122], [4, 221277], [10, 221597], [19, 222057], [23, 222357], [28, 222537], [31, 222697], [38, 223605], [46, 223853], [48, 224013], [52, 224153], [60, 224974], [64, 225082], [66, 225202], [72, 225782], [80, 226082], [84, 226302], [90, 226422], [95, 226602], [98, 226802], [104, 227082], [109, 227242], [119, 227542], [124, 227782]]}, {"verse": 32, "start": 228558, "end": 239158, "text": "With whomsoever you find your gods, let him not live: before our brethren discern you what is your with me, and take it to you. For Jacob knew not that Rachel had stolen them.", "words": [[0, 228558], [5, 228873], [16, 229223], [20, 229383], [25, 229623], [30, 229763], [36, 230443], [40, 230583], [44, 230723], [48, 230923], [54, 232513], [61, 232714], [65, 232954], [74, 233314], [82, 233774], [86, 233994], [91, 234234], [94, 234394], [99, 234554], [104, 234814], [108, 235034], [112, 235374], [117, 235674], [120, 235774], [123, 235934], [128, 236566], [132, 236655], [138, 236935], [143, 237235], [147, 237455], [152, 237675], [159, 238015], [163, 238275], [170, 238675]]}, {"verse": 33, "start": 239608, "end": 250505, "text": "And Laban went into Jacob’s tent, and into Leah’s tent, and into the two maidservants’ tents; but he found them not. Then went he out of Leah’s tent, and entered into Rachel’s tent.", "words": [[0, 239608], [4, 239754], [10, 240194], [15, 240454], [20, 240734], [28, 241254], [34, 241514], [38, 241834], [43, 242014], [50, 242494], [56, 242734], [60, 243034], [65, 243254], [69, 243414], [73, 243614], [87, 244514], [94, 245247], [98, 245368], [101, 245468], [107, 245768], [112, 246008], [117, 246848], [122, 246997], [127, 247237], [130, 247417], [134, 247597], [137, 247717], [144, 248117], [150, 248357], [154, 248917], [162, 249257], [167, 249517], [176, 250017]]}, {"verse": 34, "start": 250955, "end": 259032, "text": "Now Rachel had taken the images, and put them in the camel’s furniture, and sat upon them. And Laban searched all the tent, but found them not.", "words": [[0, 250955], [4, 251165], [11, 251485], [15, 251745], [21, 252025], [25, 252205], [33, 252505], [37, 252965], [41, 253185], [46, 253385], [49, 253505], [53, 253605], [61, 254045], [72, 254425], [76, 254785], [80, 255005], [85, 255285], [91, 256020], [95, 256167], [101, 256587], [110, 256847], [114, 257207], [118, 257347], [124, 257967], [128, 258087], [134, 258387], [139, 258587]]}, {"verse": 35, "start": 259482, "end": 270522, "text": "And she said to her father, Let it not displease my lord that I cannot rise up before you; for the custom of women is upon me. And he searched, but found not the images.", "words": [[0, 259482], [4, 259605], [8, 259745], [13, 259965], [16, 260125], [20, 260265], [28, 261092], [32, 261347], [35, 261507], [39, 261727], [49, 262347], [52, 262627], [57, 263027], [62, 263307], [64, 263447], [71, 263847], [76, 264247], [79, 264487], [86, 264807], [91, 265574], [95, 265678], [99, 265778], [106, 266158], [109, 266438], [115, 266698], [118, 266998], [123, 267278], [127, 268204], [131, 268336], [134, 268436], [144, 268796], [148, 269076], [154, 269416], [158, 269656], [162, 269876]]}, {"verse": 36, "start": 270972, "end": 280603, "text": "¶ And Jacob was angry, and quarreled with Laban: and Jacob answered and said to Laban, What is my trespass? what is my sin, that you have so hotly pursued after me?", "words": [[2, 270972], [6, 271082], [12, 271322], [16, 271562], [23, 271982], [27, 272362], [37, 272822], [42, 272982], [49, 273913], [53, 274038], [59, 274298], [68, 274818], [72, 275138], [77, 275358], [80, 275538], [87, 276470], [92, 276616], [95, 276696], [98, 276966], [108, 277536], [113, 277890], [116, 277990], [119, 278130], [124, 278510], [129, 278930], [133, 279050], [138, 279150], [141, 279370], [147, 279730], [155, 279970], [161, 280310]]}, {"verse": 37, "start": 281053, "end": 289635, "text": "Whereas you have searched all my stuff, what have you found of all your household stuff? set it here before my brethren and your brethren, that they may judge between us both.", "words": [[0, 281053], [8, 281253], [12, 281413], [17, 281493], [26, 281773], [30, 282073], [33, 282273], [40, 282893], [45, 283173], [50, 283293], [54, 283393], [60, 283693], [63, 283873], [67, 283973], [72, 284113], [82, 284433], [89, 285195], [93, 285285], [96, 285445], [101, 285665], [108, 285945], [111, 286145], [120, 286545], [124, 286925], [129, 287145], [139, 287585], [144, 288105], [149, 288285], [153, 288405], [159, 288685], [167, 289005], [170, 289285]]}, {"verse": 38, "start": 290085, "end": 297477, "text": "This twenty years have I been with you; your ewes and your she goats have not cast their young, and the rams of your flock have I not eaten.", "words": [[0, 290085], [5, 290307], [12, 290567], [18, 290927], [23, 291187], [25, 291307], [30, 291467], [35, 291667], [40, 292275], [45, 292442], [50, 292982], [54, 293102], [59, 293222], [63, 293422], [69, 293782], [74, 293922], [78, 294082], [83, 294442], [89, 294662], [96, 294882], [100, 295282], [104, 295402], [109, 295742], [112, 295882], [117, 296002], [123, 296302], [128, 296562], [130, 296822], [134, 296982]]}, {"verse": 39, "start": 297927, "end": 306541, "text": "That which was torn of beasts I brought not to you; I bore the loss of it; of my hand did you require it, whether stolen by day, or stolen by night.", "words": [[0, 297927], [5, 298046], [11, 298206], [15, 298426], [20, 298726], [23, 298926], [30, 299226], [32, 299446], [40, 299666], [44, 299946], [47, 300186], [52, 300803], [54, 301004], [59, 301244], [63, 301404], [68, 301644], [71, 301824], [75, 302279], [78, 302420], [81, 302620], [86, 302980], [90, 303140], [94, 303280], [102, 303660], [106, 304160], [114, 304280], [121, 304680], [124, 304940], [129, 305220], [132, 305600], [139, 305940], [142, 306200]]}, {"verse": 40, "start": 306991, "end": 313690, "text": "Thus I was; in the day the drought consumed me, and the frost by night; and my sleep departed from my eyes.", "words": [[0, 306991], [5, 307231], [7, 307511], [12, 308274], [15, 308399], [19, 308519], [23, 308729], [27, 308939], [35, 309179], [44, 309579], [48, 309979], [52, 310419], [56, 310559], [62, 310779], [65, 311019], [72, 311801], [76, 311921], [79, 312061], [85, 312321], [94, 312821], [99, 313001], [102, 313181]]}, {"verse": 41, "start": 314140, "end": 322930, "text": "Thus have I been twenty years in your house; I served you fourteen years for your two daughters, and six years for your cattle: and you have changed my wages ten times.", "words": [[0, 314140], [5, 314324], [10, 314564], [12, 314664], [17, 314924], [24, 315184], [30, 315504], [33, 315724], [38, 315844], [45, 316699], [47, 316824], [54, 317104], [58, 317364], [67, 317624], [73, 317944], [77, 318144], [82, 318284], [86, 318484], [97, 318844], [101, 319244], [105, 319544], [111, 319784], [115, 319984], [120, 320084], [128, 320818], [132, 320935], [136, 321035], [141, 321135], [149, 321415], [152, 321615], [158, 321955], [162, 322295]]}, {"verse": 42, "start": 323380, "end": 334957, "text": "Except the God of my father, the God of Abraham, and the fear of Isaac, had been with me, surely you had sent me away now empty. God has seen my affliction and the labour of my hands, and rebuked you yesternight.", "words": [[0, 323380], [7, 323686], [11, 323886], [15, 324146], [18, 324286], [21, 324446], [29, 325246], [33, 325346], [37, 325626], [40, 325766], [49, 326526], [53, 326646], [57, 326766], [62, 327066], [65, 327206], [72, 327646], [76, 328086], [81, 328286], [86, 328486], [90, 328886], [97, 329106], [101, 329406], [105, 329526], [110, 329746], [113, 329966], [118, 330206], [122, 330406], [129, 331162], [133, 331322], [137, 331542], [142, 331722], [145, 331902], [156, 332342], [160, 332482], [164, 332642], [171, 332802], [174, 333002], [177, 333162], [184, 333422], [188, 333842], [196, 334362], [200, 334687]]}, {"verse": 43, "start": 335307, "end": 348814, "text": "¶ And Laban answered and said to Jacob, These daughters are my daughters, and these children are my children, and these cattle are my cattle, and all that you see is mine: and what can I do this day to these my daughters, or to their children which they have born?", "words": [[2, 335307], [6, 335461], [12, 335921], [21, 336441], [25, 336761], [30, 337001], [33, 337161], [40, 337949], [46, 338086], [56, 338406], [60, 338646], [63, 338886], [74, 339646], [78, 339686], [84, 339846], [93, 340246], [97, 340486], [100, 340666], [110, 341386], [114, 341426], [120, 341606], [127, 341926], [131, 342146], [134, 342326], [142, 342926], [146, 343006], [150, 343266], [155, 343446], [159, 343566], [163, 343746], [166, 343886], [172, 344561], [176, 344659], [181, 344819], [185, 344999], [187, 345099], [190, 345279], [195, 345499], [199, 345779], [202, 345959], [208, 346139], [211, 346299], [222, 346679], [225, 347099], [228, 347219], [234, 347359], [243, 347739], [249, 347959], [254, 348139], [259, 348319]]}, {"verse": 44, "start": 349264, "end": 356903, "text": "Now therefore come, let us make a covenant, I and you; and let it be for a witness between me and you.", "words": [[0, 349264], [4, 349826], [14, 350046], [20, 350546], [24, 350646], [27, 350766], [32, 350966], [34, 351106], [44, 351866], [46, 352126], [50, 352466], [55, 353583], [59, 353703], [63, 353843], [66, 353963], [69, 354123], [73, 354273], [75, 354423], [83, 354663], [91, 355043], [94, 355303], [98, 355483]]}, {"verse": 45, "start": 357253, "end": 360248, "text": "And Jacob took a stone, and set it up for a pillar.", "words": [[0, 357253], [4, 357389], [10, 357669], [15, 357929], [17, 358069], [24, 358429], [28, 358909], [32, 359149], [35, 359289], [38, 359409], [42, 359589], [44, 359709]]}, {"verse": 46, "start": 360698, "end": 368172, "text": "And Jacob said to his brethren, Gather stones; and they took stones, and made a heap: and they did eat there upon the heap.", "words": [[0, 360698], [4, 360821], [10, 361121], [15, 361381], [18, 361581], [22, 361701], [32, 362596], [39, 362912], [47, 364023], [51, 364149], [56, 364269], [61, 364489], [69, 364949], [73, 365469], [78, 365649], [80, 365749], [86, 366464], [90, 366580], [95, 366700], [99, 366900], [103, 367060], [109, 367280], [114, 367520], [118, 367760]]}, {"verse": 47, "start": 368622, "end": 372960, "text": "And Laban called it Jegar-sahadutha: but Jacob called it Galeed.", "words": [[0, 368622], [4, 368902], [10, 369342], [17, 369682], [20, 370398], [37, 371362], [41, 371471], [47, 371771], [54, 372151], [57, 372594]]}, {"verse": 48, "start": 373410, "end": 380484, "text": "And Laban said, This heap is a witness between me and you this day. Therefore was the name of it called Galeed;", "words": [[0, 373410], [4, 373743], [10, 374111], [16, 374674], [21, 374878], [26, 375218], [29, 375438], [31, 375558], [39, 375798], [47, 376198], [50, 376498], [54, 376758], [58, 376938], [63, 377138], [68, 377856], [78, 378443], [82, 378603], [86, 378763], [91, 379063], [94, 379203], [97, 379303], [104, 379924]]}, {"verse": 49, "start": 380934, "end": 387991, "text": "And Mizpah; for he said, The LORD watch between me and you, when we are absent one from another.", "words": [[0, 380934], [4, 381862], [12, 383094], [16, 383234], [19, 383374], [25, 384093], [29, 384191], [34, 384411], [40, 384771], [48, 385191], [51, 385531], [55, 385811], [60, 386071], [65, 386471], [68, 386631], [72, 386731], [79, 387011], [83, 387331], [88, 387551]]}, {"verse": 50, "start": 388441, "end": 396406, "text": "If you shall afflict my daughters, or if you shall take other wives beside my daughters, no man is with us; see, God is witness between me and you.", "words": [[0, 388441], [3, 388583], [7, 388723], [13, 388943], [21, 389163], [24, 389443], [35, 390063], [38, 390323], [41, 390463], [45, 390603], [51, 390803], [56, 391036], [62, 391270], [68, 391503], [75, 391983], [78, 392263], [89, 392763], [92, 392903], [96, 393123], [99, 393303], [104, 393463], [108, 394115], [113, 394382], [117, 394582], [120, 394842], [128, 395102], [136, 395462], [139, 395782], [143, 396082]]}, {"verse": 51, "start": 396756, "end": 402942, "text": "And Laban said to Jacob, Behold this heap, and behold this pillar, which I have cast between me and you;", "words": [[0, 396756], [4, 396989], [10, 397249], [15, 397469], [18, 397649], [25, 398472], [32, 398848], [37, 399048], [43, 399308], [47, 399568], [54, 399868], [59, 400108], [67, 400468], [73, 400968], [75, 401248], [80, 401428], [85, 401668], [93, 402008], [96, 402288], [100, 402608]]}, {"verse": 52, "start": 403392, "end": 413296, "text": "This heap be witness, and this pillar be witness, that I will not pass over this heap to you, and that you shall not pass over this heap and this pillar to me, for harm.", "words": [[0, 403392], [5, 403582], [10, 403812], [13, 404012], [22, 404452], [26, 404812], [31, 405012], [38, 405412], [41, 405932], [50, 406352], [55, 406792], [57, 406972], [62, 407112], [66, 407292], [71, 407552], [76, 407832], [81, 408032], [86, 408232], [89, 408412], [94, 409067], [98, 409209], [103, 409369], [107, 409569], [113, 409809], [117, 410049], [122, 410329], [127, 410569], [132, 410829], [137, 411149], [141, 411389], [146, 411609], [153, 411889], [156, 412109], [160, 412309], [164, 412769]]}, {"verse": 53, "start": 413746, "end": 422037, "text": "The God of Abraham, and the God of Nahor, the God of their father, judge between us. And Jacob swore by the fear of his father Isaac.", "words": [[0, 413746], [4, 413846], [8, 414066], [11, 414206], [20, 414606], [24, 414906], [28, 415006], [32, 415226], [35, 415346], [42, 416026], [46, 416126], [50, 416386], [53, 416526], [59, 416706], [67, 417346], [73, 417626], [81, 417986], [85, 418859], [89, 419012], [95, 419332], [101, 419972], [104, 420192], [108, 420352], [113, 420652], [116, 420832], [120, 420972], [127, 421272]]}, {"verse": 54, "start": 422487, "end": 431028, "text": "Then Jacob offered sacrifice upon the mount, and called his brethren to eat bread: and they did eat bread, and stayed all night in the mount.", "words": [[0, 422487], [5, 422750], [11, 423110], [19, 423510], [29, 424090], [34, 424530], [38, 424770], [45, 425030], [49, 425430], [56, 425710], [60, 425910], [69, 426310], [72, 426630], [76, 426830], [83, 427681], [87, 427824], [92, 427944], [96, 428204], [100, 428384], [107, 428724], [111, 429344], [118, 429644], [122, 429924], [128, 430204], [131, 430404], [135, 430504]]}, {"verse": 55, "start": 431478, "end": 440526, "text": "And early in the morning Laban rose up, and kissed his sons and his daughters, and blessed them: and Laban departed, and returned to his place.", "words": [[0, 431478], [4, 431624], [10, 431944], [13, 432164], [17, 432264], [25, 432704], [31, 433144], [36, 433464], [40, 433844], [44, 434184], [51, 434464], [55, 434724], [60, 435104], [64, 435364], [68, 435524], [79, 435924], [83, 436364], [91, 436684], [97, 437565], [101, 437724], [107, 438184], [117, 438764], [121, 439044], [130, 439464], [133, 439724], [137, 439884]]}]}