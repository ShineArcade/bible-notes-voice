{"book": "LUK", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 539305, "verses": [{"verse": 1, "start": 300, "end": 8763, "text": "Y juntando a sus doce discípulos, les dio poder y autoridad sobre todos los demonios, y que sanasen enfermedades.", "words": [[0, 300], [2, 422], [11, 1002], [13, 1122], [17, 1262], [22, 1622], [34, 2621], [38, 2802], [42, 3002], [48, 3362], [50, 3641], [60, 4342], [66, 4702], [72, 5082], [76, 5361], [86, 6242], [88, 6401], [92, 6802], [100, 7202]]}, {"verse": 2, "start": 9113, "end": 14899, "text": "Y los envió a que predicasen el reino de Dios, y que sanasen a los enfermos.", "words": [[0, 9113], [2, 9239], [6, 9359], [12, 9879], [14, 10099], [18, 10629], [29, 11159], [32, 11419], [38, 11879], [41, 12039], [47, 12359], [49, 12979], [53, 13409], [61, 13839], [63, 13939], [67, 14079]]}, {"verse": 3, "start": 15249, "end": 24415, "text": "Y les dice: No toméis nada para el camino, ni bastón, ni alforja, ni pan, ni dinero; ni tengáis dos vestidos cada uno.", "words": [[0, 15249], [2, 15514], [6, 15812], [12, 16279], [15, 16428], [22, 16848], [27, 17108], [32, 17428], [35, 17588], [43, 18388], [46, 18568], [54, 19528], [57, 19608], [66, 20328], [69, 20468], [74, 21208], [77, 21328], [85, 22269], [88, 22419], [96, 22839], [100, 23039], [109, 23559], [114, 23819]]}, {"verse": 4, "start": 24765, "end": 29261, "text": "Y en cualquier casa donde entréis, quedad allí, y de allí salid.", "words": [[0, 24765], [2, 24892], [5, 24992], [15, 25252], [20, 25892], [26, 26582], [35, 27272], [42, 27652], [48, 27992], [50, 28352], [53, 28492], [58, 28672]]}, {"verse": 5, "start": 29611, "end": 39073, "text": "Y todos los que no os reciban, saliéndoos de aquella ciudad, aun el polvo sacudid de vuestros pies en testimonio contra ellos.", "words": [[0, 29611], [2, 29736], [8, 30036], [12, 30736], [16, 31136], [19, 31356], [22, 31596], [31, 32443], [42, 33291], [45, 33471], [53, 33811], [61, 34191], [65, 34851], [68, 35051], [74, 35661], [82, 36271], [85, 36451], [94, 36771], [99, 37051], [102, 37291], [113, 38031], [120, 38351]]}, {"verse": 6, "start": 39423, "end": 47161, "text": "Y saliendo, rodeaban por todas las aldeas, anunciando el evangelio, y sanando por todas partes.", "words": [[0, 39423], [2, 39566], [12, 40166], [21, 41326], [25, 41626], [31, 41946], [35, 42266], [43, 43186], [54, 44026], [57, 44146], [68, 44986], [70, 45346], [78, 45806], [82, 46026], [88, 46286]]}, {"verse": 7, "start": 47511, "end": 56795, "text": "Y oyó Herodes el tetrarca todas las cosas que hacía; y estaba en duda, porque decían algunos: Juan ha resucitado de los muertos;", "words": [[0, 47511], [2, 47634], [6, 48059], [14, 48484], [17, 48909], [26, 49334], [32, 49594], [36, 49934], [42, 50294], [46, 50554], [53, 51411], [55, 51581], [62, 51861], [65, 52081], [71, 52361], [78, 52761], [85, 53301], [94, 54308], [99, 54630], [102, 54930], [113, 55730], [116, 55890], [120, 55990]]}, {"verse": 8, "start": 57145, "end": 64187, "text": "Y otros: Elías ha aparecido; y otros: Algún profeta de los antiguos ha resucitado.", "words": [[0, 57145], [2, 57348], [9, 58180], [15, 58743], [18, 59003], [29, 60203], [31, 60523], [38, 61343], [44, 61699], [52, 62239], [55, 62359], [59, 62499], [68, 63079], [71, 63179]]}, {"verse": 9, "start": 64537, "end": 71931, "text": "Y dijo Herodes: A Juan yo degollé: ¿quién pues será este, de quien yo oigo tales cosas? Y procuraba verle.", "words": [[0, 64537], [2, 64777], [7, 65037], [16, 65942], [18, 66061], [23, 66421], [26, 66781], [35, 67302], [42, 67566], [47, 67706], [52, 67966], [58, 68346], [61, 68626], [67, 68786], [70, 68986], [75, 69226], [81, 69446], [88, 70500], [90, 70640], [100, 71260]]}, {"verse": 10, "start": 72281, "end": 83192, "text": "Y vueltos los apóstoles, le contaron todas las cosas que habían hecho. Y tomándolos, se retiró aparte a un lugar desierto de la ciudad que se llama Betsaida.", "words": [[0, 72281], [2, 72408], [10, 72848], [14, 72968], [25, 73748], [28, 73973], [37, 74533], [43, 74853], [47, 75153], [53, 75453], [57, 75653], [64, 75893], [71, 76610], [73, 76714], [85, 77574], [88, 77874], [95, 78394], [102, 79094], [104, 79234], [107, 79414], [113, 79754], [122, 80474], [125, 80714], [128, 80834], [135, 81154], [139, 81474], [142, 81594], [148, 82420]]}, {"verse": 11, "start": 83542, "end": 93967, "text": "Y cuando la gente lo supo, lo siguió; y él la recibió, y les hablaba del reino de Dios, y sanaba a los que tenían necesidad de cura.", "words": [[0, 83542], [2, 83626], [9, 83846], [12, 84046], [18, 84366], [21, 84646], [27, 85146], [30, 85446], [38, 86289], [40, 86476], [43, 86696], [46, 87076], [55, 88076], [57, 88256], [61, 88416], [69, 89056], [73, 89296], [79, 89756], [82, 89916], [88, 90256], [90, 90771], [97, 91271], [99, 91431], [103, 91531], [107, 91671], [114, 92091], [124, 93151], [127, 93331]]}, {"verse": 12, "start": 94317, "end": 108812, "text": "Y el día había comenzado a declinar; y acercándose los doce, le dijeron: Despide a la gente, para que yendo a las aldeas y campos de alrededor, procedan a alojarse y encuentren comida; porque aquí estamos en lugar desierto.", "words": [[0, 94317], [2, 94442], [5, 94562], [9, 94782], [15, 95062], [25, 95782], [27, 95862], [37, 96774], [39, 96881], [51, 97761], [55, 97981], [61, 98521], [64, 98941], [73, 99791], [81, 100231], [83, 100311], [86, 100351], [93, 100751], [98, 101291], [102, 101451], [108, 101631], [110, 101811], [114, 101951], [121, 102491], [123, 102611], [130, 103031], [133, 103111], [144, 103611], [153, 104531], [155, 104631], [164, 105211], [166, 105411], [177, 105891], [185, 106717], [192, 106928], [197, 107168], [205, 107588], [208, 107808], [214, 107988]]}, {"verse": 13, "start": 109092, "end": 119953, "text": "Y les dice: Dadles vosotros de comer. Y dijeron ellos: No tenemos más que cinco panes y dos pescados, si no vamos nosotros a comprar comida para toda esta multitud.", "words": [[0, 109092], [2, 109357], [6, 109655], [12, 110428], [19, 110768], [28, 111448], [31, 111668], [38, 112493], [40, 112618], [48, 113098], [55, 113905], [58, 114026], [66, 114306], [70, 114606], [74, 114806], [80, 115006], [86, 115446], [88, 115546], [92, 115646], [102, 116546], [105, 116746], [108, 116826], [114, 117086], [123, 117406], [125, 117706], [133, 118006], [140, 118426], [145, 118706], [150, 118946], [155, 119246]]}, {"verse": 14, "start": 120233, "end": 129274, "text": "Y eran como cinco mil hombres. Entonces dijo a sus discípulos: Hacedlos sentar en grupos, de cincuenta en cincuenta.", "words": [[0, 120233], [2, 120376], [7, 120596], [12, 120896], [18, 121196], [22, 121496], [31, 122431], [40, 123000], [45, 123380], [47, 123600], [51, 123760], [63, 124832], [72, 125473], [79, 126193], [82, 126333], [90, 126753], [93, 127343], [103, 127933], [106, 128603]]}, {"verse": 15, "start": 129624, "end": 133340, "text": "Y así lo hicieron, haciéndolos sentar a todos.", "words": [[0, 129624], [2, 129749], [6, 129929], [9, 130149], [19, 131289], [31, 132029], [38, 132629], [40, 132709]]}, {"verse": 16, "start": 133690, "end": 144142, "text": "Y tomando los cinco panes y los dos pescados, mirando al cielo los bendijo, y partió, y dio a sus discípulos para que pusiesen delante de la gente.", "words": [[0, 133690], [2, 133813], [10, 134273], [14, 134473], [20, 134933], [26, 135653], [28, 135873], [32, 136033], [36, 136193], [46, 136813], [54, 137553], [57, 137753], [63, 138033], [67, 138253], [76, 138833], [78, 139333], [86, 139933], [88, 140148], [92, 140348], [94, 140508], [98, 140708], [109, 141648], [114, 142268], [118, 142408], [127, 142868], [135, 143388], [138, 143528], [141, 143628]]}, {"verse": 17, "start": 144492, "end": 150939, "text": "Y comieron todos, y se saciaron; y alzaron lo que les sobró, doce cestos de pedazos.", "words": [[0, 144492], [2, 144764], [11, 145144], [18, 145624], [20, 145984], [23, 146084], [33, 147203], [35, 147308], [43, 147888], [46, 148068], [50, 148188], [54, 148348], [61, 148921], [66, 149495], [73, 150068], [76, 150168]]}, {"verse": 18, "start": 151289, "end": 160238, "text": "Y aconteció que estando él solo orando, estaban con él los discípulos; y les preguntó diciendo: ¿Quién dice la gente que soy yo?", "words": [[0, 151289], [2, 151556], [12, 152276], [16, 152496], [24, 152936], [27, 153176], [32, 153516], [40, 154556], [48, 154916], [52, 155216], [55, 155376], [59, 155536], [71, 156622], [73, 156907], [77, 157027], [86, 157647], [96, 158617], [103, 158877], [108, 159077], [111, 159257], [117, 159477], [121, 159657], [125, 159837]]}, {"verse": 19, "start": 160588, "end": 169733, "text": "Y ellos respondieron, y dijeron: Juan el Bautista; y otros, Elías; y otros, que algún profeta de los antiguos ha resucitado.", "words": [[0, 160588], [2, 160750], [8, 160930], [22, 161790], [24, 162210], [33, 163030], [38, 163372], [41, 163692], [51, 164659], [53, 164841], [60, 165401], [67, 166200], [69, 166368], [76, 166628], [80, 167068], [86, 167348], [94, 167808], [97, 167948], [101, 168068], [110, 168728], [113, 168908]]}, {"verse": 20, "start": 170013, "end": 178515, "text": "Y les dijo: ¿Y vosotros, quién decís que soy? Entonces respondiendo Simón Pedro, dijo: El Cristo de Dios.", "words": [[0, 170013], [2, 170143], [6, 170303], [12, 171035], [15, 171139], [25, 171539], [31, 171779], [37, 172179], [41, 172259], [46, 172985], [55, 173903], [68, 174943], [74, 175343], [81, 175763], [87, 176841], [90, 176961], [97, 177341], [100, 177581]]}, {"verse": 21, "start": 178795, "end": 183494, "text": "Pero él, advirtiéndoles, mandó que a nadie dijesen esto;", "words": [[0, 178795], [5, 178961], [9, 179461], [25, 181061], [31, 181601], [35, 181781], [37, 181901], [43, 182451], [51, 183001]]}, {"verse": 22, "start": 183844, "end": 199201, "text": "Diciendo: Es necesario que el Hijo del hombre padezca muchas cosas, y sea desechado de los ancianos, y de los principales sacerdotes, y de los escribas, y que sea muerto, y resucite al tercer día.", "words": [[0, 183844], [10, 184838], [13, 185125], [23, 186125], [27, 186405], [30, 186605], [35, 186865], [39, 187005], [46, 187405], [54, 187965], [61, 188265], [68, 188845], [70, 189340], [74, 189600], [84, 190420], [87, 190560], [91, 190720], [101, 191460], [103, 191780], [106, 191860], [110, 191980], [122, 192740], [134, 193600], [136, 194080], [139, 194180], [143, 194340], [153, 195080], [155, 195580], [159, 195700], [163, 195900], [171, 196850], [173, 197206], [182, 197986], [185, 198166], [192, 198466]]}, {"verse": 23, "start": 199551, "end": 207792, "text": "Y decía a todos: Si alguno quiere venir en pos de mí, niéguese a sí mismo, y tome su cruz cada día, y sígame.", "words": [[0, 199551], [2, 199708], [8, 200208], [10, 200508], [17, 201492], [20, 201633], [27, 202073], [34, 202233], [40, 202573], [43, 202773], [47, 202973], [50, 203133], [54, 203653], [63, 204173], [65, 204453], [68, 204553], [75, 204933], [77, 205433], [82, 205773], [85, 205953], [90, 206393], [95, 206593], [100, 206953], [102, 207173]]}, {"verse": 24, "start": 208142, "end": 215747, "text": "Porque todo el que quiera salvar su vida, la perderá; y todo el que pierda su vida por causa de mí, este la salvará.", "words": [[0, 208142], [7, 208344], [12, 208654], [15, 208964], [19, 209084], [26, 209384], [33, 209804], [36, 210104], [42, 210424], [45, 210604], [54, 211545], [56, 211667], [61, 211937], [64, 212207], [68, 212327], [75, 212727], [78, 212867], [83, 213127], [87, 213347], [93, 213687], [96, 213987], [100, 214587], [105, 214887], [108, 215047]]}, {"verse": 25, "start": 216097, "end": 224279, "text": "Porque ¿qué aprovecha al hombre, si gana todo el mundo, y se pierde él a sí mismo, o se perjudica a sí mismo?", "words": [[0, 216097], [7, 216341], [12, 216681], [22, 217401], [25, 217541], [33, 217881], [36, 218401], [41, 218701], [46, 218981], [49, 219241], [56, 219641], [58, 220201], [61, 220341], [68, 220821], [71, 221021], [73, 221141], [76, 221261], [83, 221721], [85, 222181], [88, 222321], [98, 223221], [100, 223461], [103, 223601]]}, {"verse": 26, "start": 224629, "end": 235873, "text": "Porque el que se avergüence de mí y de mis palabras, de este se avergonzará el Hijo del hombre cuando venga en su gloria y en la del Padre, y de los santos ángeles.", "words": [[0, 224629], [7, 224872], [10, 225172], [14, 225352], [17, 225812], [28, 226272], [31, 226512], [34, 226712], [36, 226972], [39, 227092], [43, 227232], [53, 227692], [56, 228137], [61, 228597], [64, 229117], [76, 229937], [79, 230157], [84, 230477], [88, 230657], [95, 231037], [102, 231237], [108, 231757], [111, 231877], [114, 232037], [121, 232477], [123, 232757], [126, 232897], [129, 233037], [133, 233257], [140, 234111], [142, 234311], [145, 234431], [149, 234571], [156, 235071]]}, {"verse": 27, "start": 236223, "end": 243357, "text": "Y os digo en verdad, que hay algunos de los que están aquí, que no probarán la muerte, hasta que vean el reino de Dios.", "words": [[0, 236223], [2, 236359], [5, 236459], [10, 236679], [13, 236819], [21, 237139], [25, 237439], [29, 237639], [37, 238059], [40, 238239], [44, 238339], [48, 238459], [54, 238659], [60, 239659], [64, 239759], [67, 239939], [76, 240559], [79, 240699], [87, 241179], [93, 241574], [97, 241754], [102, 242094], [105, 242254], [111, 242614], [114, 242774]]}, {"verse": 28, "start": 243707, "end": 253046, "text": "Y aconteció como ocho días después de estas palabras, que tomó a Pedro y a Juan y a Jacobo, y subió al monte a orar.", "words": [[0, 243707], [2, 243827], [12, 244647], [17, 244947], [22, 245367], [27, 245687], [35, 246167], [38, 246427], [44, 246667], [54, 247907], [58, 248147], [63, 248507], [65, 248607], [71, 248947], [73, 249207], [75, 249267], [80, 249627], [82, 249807], [84, 249847], [92, 250607], [94, 251167], [100, 251627], [103, 251887], [109, 252267], [111, 252567]]}, {"verse": 29, "start": 253396, "end": 260907, "text": "Y entre tanto que oraba, la apariencia de su rostro se hizo otra, y su vestido blanco y resplandeciente.", "words": [[0, 253396], [2, 253514], [8, 253774], [14, 254174], [18, 254434], [25, 255114], [28, 255534], [39, 256194], [42, 256374], [45, 256574], [52, 257134], [55, 257294], [60, 257634], [66, 258154], [68, 258674], [71, 258834], [79, 259274], [86, 259634], [88, 259774]]}, {"verse": 30, "start": 261257, "end": 266847, "text": "Y he aquí dos varones que hablaban con él, los cuales eran Moisés y Elías;", "words": [[0, 261257], [2, 261442], [5, 261582], [10, 261862], [14, 262062], [22, 262522], [26, 262702], [35, 263102], [39, 263302], [43, 263922], [47, 264062], [54, 264262], [59, 264582], [66, 265482], [68, 266042]]}, {"verse": 31, "start": 267197, "end": 274071, "text": "Que aparecieron en majestad, y hablaban de su partida, la cual había de cumplir en Jerusalén.", "words": [[0, 267197], [4, 267301], [16, 268101], [19, 268281], [29, 269101], [31, 269661], [40, 270101], [43, 270261], [46, 270421], [55, 271321], [58, 271581], [63, 271801], [69, 272081], [72, 272261], [80, 272921], [83, 273141]]}, {"verse": 32, "start": 274421, "end": 284161, "text": "Y Pedro y los que estaban con él, estaban cargados de sueño: y como despertaron, vieron su majestad, y a aquellos dos varones que estaban con él.", "words": [[0, 274421], [2, 274526], [8, 275066], [10, 275486], [14, 275626], [18, 275766], [26, 276106], [30, 276406], [34, 276626], [42, 277006], [51, 277746], [54, 277906], [61, 278770], [63, 278914], [68, 279214], [81, 280314], [88, 280614], [91, 280894], [101, 281239], [103, 281584], [105, 281929], [114, 282349], [118, 282629], [126, 283049], [130, 283229], [138, 283489], [142, 283789]]}, {"verse": 33, "start": 284511, "end": 299012, "text": "Y aconteció, que apartándose ellos de él, Pedro dice a Jesús: Maestro, bien es que nos quedemos aquí: y hagamos tres refugios, uno para ti, y uno para Moisés, y uno para Elías; no sabiendo lo que se decía.", "words": [[0, 284511], [2, 284807], [13, 285567], [17, 285807], [29, 286587], [35, 286907], [38, 287107], [42, 287387], [48, 288247], [53, 288567], [55, 288767], [62, 289640], [71, 289876], [76, 290150], [79, 290423], [83, 290543], [87, 290683], [96, 291123], [102, 291837], [104, 291959], [112, 292299], [117, 292559], [127, 293419], [131, 293599], [136, 293859], [140, 294119], [142, 294639], [146, 294799], [151, 295019], [159, 295419], [161, 295819], [165, 295979], [170, 296219], [177, 297114], [180, 297262], [189, 297762], [192, 297942], [196, 298082], [199, 298222]]}, {"verse": 34, "start": 299362, "end": 306766, "text": "Y estando él hablando esto, vino una nube que los cubrió; y tuvieron temor, entrando ellos en la nube.", "words": [[0, 299362], [2, 299471], [10, 299851], [13, 300051], [22, 300351], [28, 301231], [33, 301471], [37, 301691], [42, 302071], [46, 302231], [50, 302371], [58, 303387], [60, 303512], [69, 303932], [76, 304552], [85, 305142], [91, 305732], [94, 306032], [97, 306152]]}, {"verse": 35, "start": 307116, "end": 312915, "text": "Y vino una voz de la nube, que decía: Este es mi Hijo amado; a él oíd.", "words": [[0, 307116], [2, 307239], [7, 307519], [11, 307839], [15, 308159], [18, 308339], [21, 308479], [27, 308799], [31, 308959], [38, 309878], [43, 310200], [46, 310460], [49, 310640], [54, 310860], [61, 312158], [63, 312410], [66, 312663]]}, {"verse": 36, "start": 313479, "end": 322718, "text": "Y pasada aquella voz, Jesús fue hallado solo: y ellos callaron; y por aquellos días no dijeron nada a nadie de lo que habían visto.", "words": [[0, 313479], [2, 313587], [9, 314127], [17, 314527], [22, 315167], [28, 315547], [32, 316047], [40, 316467], [46, 317319], [48, 317483], [54, 318058], [64, 318796], [66, 318876], [70, 319016], [79, 319196], [84, 319576], [87, 319816], [95, 320396], [100, 320796], [102, 321036], [108, 321316], [111, 321536], [114, 321656], [118, 321796], [125, 322076]]}, {"verse": 37, "start": 323068, "end": 330812, "text": "Y aconteció al día siguiente, que apartándose ellos del monte, una gran multitud les salió al encuentro.", "words": [[0, 323068], [2, 323185], [12, 323825], [15, 324005], [19, 324145], [30, 324605], [34, 325025], [46, 325845], [52, 326265], [56, 326505], [63, 327385], [67, 327585], [72, 327905], [81, 328765], [85, 329105], [91, 329805], [94, 329985]]}, {"verse": 38, "start": 331162, "end": 338678, "text": "Y he aquí, un hombre de la multitud clamó, diciendo: Maestro, te ruego que veas a mi hijo; que es el único que tengo:", "words": [[0, 331162], [2, 331367], [5, 331487], [11, 331707], [14, 331887], [21, 332147], [24, 332327], [27, 332447], [36, 333047], [43, 333647], [53, 334889], [62, 335455], [65, 335535], [71, 335855], [75, 336055], [80, 336455], [82, 336555], [85, 336675], [91, 337351], [95, 337453], [98, 337573], [101, 337733], [107, 337913], [111, 338153]]}, {"verse": 39, "start": 339028, "end": 348185, "text": "Y he aquí un espíritu le toma, y de repente da voces; y lo sacude con violencia y le hace echar espuma, y apenas se aparta de él quebrantándole.", "words": [[0, 339028], [2, 339185], [5, 339265], [10, 339545], [13, 339725], [22, 340285], [25, 340365], [31, 340725], [33, 341185], [36, 341305], [44, 341625], [47, 341905], [54, 342739], [56, 342945], [59, 343165], [66, 343385], [70, 343605], [80, 344265], [82, 344525], [85, 344645], [90, 344865], [96, 345185], [104, 345965], [106, 346025], [113, 346285], [116, 346565], [123, 347005], [126, 347125], [129, 347245]]}, {"verse": 40, "start": 348535, "end": 351888, "text": "Y rogué a tus discípulos que le echasen fuera, y no pudieron.", "words": [[0, 348535], [2, 348661], [8, 349021], [10, 349121], [14, 349241], [25, 349901], [29, 350081], [32, 350388], [40, 350694], [47, 351001], [49, 351181], [52, 351301]]}, {"verse": 41, "start": 352168, "end": 362092, "text": "Y respondiendo Jesús, dice: ¡Oh generación infiel y perversa! ¿hasta cuándo tengo de estar con vosotros, y os sufriré? Trae tu hijo acá.", "words": [[0, 352168], [2, 352292], [15, 353052], [22, 354012], [28, 354791], [32, 354891], [43, 355571], [50, 356071], [52, 356191], [62, 357190], [69, 357398], [76, 357698], [82, 358098], [85, 358278], [91, 358498], [95, 358778], [105, 359298], [107, 359458], [110, 359558], [119, 360668], [124, 361104], [127, 361264], [132, 361564]]}, {"verse": 42, "start": 362442, "end": 374097, "text": "Y como aún se acercaba, el demonio lo derribó y lo sacudió con violencia: pero Jesús reprendió al espíritu inmundo, y sanó al muchacho, y se lo volvió a su padre.", "words": [[0, 362442], [2, 362584], [7, 362904], [11, 363184], [14, 363424], [24, 364364], [27, 364504], [35, 365064], [38, 365224], [46, 365784], [48, 365864], [51, 365984], [59, 366524], [63, 366704], [74, 367950], [79, 368093], [85, 368493], [95, 369653], [98, 369813], [107, 370493], [116, 371073], [118, 371313], [123, 371713], [126, 371853], [136, 372393], [138, 372533], [141, 372653], [144, 372813], [151, 373273], [153, 373353], [156, 373513]]}, {"verse": 43, "start": 374447, "end": 383758, "text": "Y todos estaban atónitos de la grandeza de Dios. Y maravillándose todos de todas las cosas que hacía, dijo a sus discípulos:", "words": [[0, 374447], [2, 374610], [8, 374910], [16, 375510], [25, 376210], [28, 376450], [31, 376550], [40, 377210], [43, 377370], [49, 378150], [51, 378258], [66, 379158], [72, 379678], [75, 380178], [81, 380478], [85, 380778], [91, 381118], [95, 381398], [102, 382158], [107, 382578], [109, 382738], [113, 382898]]}, {"verse": 44, "start": 384108, "end": 392453, "text": "Poned vosotros en vuestros oídos estas palabras; porque ha de acontecer que el Hijo del hombre será entregado en manos de hombres.", "words": [[0, 384108], [6, 384432], [15, 384992], [18, 385212], [27, 385592], [33, 386012], [39, 386232], [49, 387306], [56, 387530], [59, 387830], [62, 387910], [72, 388550], [76, 388870], [79, 389210], [84, 389550], [88, 389710], [95, 390170], [100, 390390], [110, 391110], [113, 391230], [119, 391490], [122, 391710]]}, {"verse": 45, "start": 392803, "end": 402026, "text": "Pero ellos no entendían esta palabra, y les era encubierta para que no la entendiesen; y temían preguntarle de esta palabra.", "words": [[0, 392803], [5, 393045], [11, 393325], [14, 394005], [24, 394805], [29, 395085], [38, 395665], [40, 396245], [44, 396445], [48, 396645], [59, 397565], [64, 397850], [68, 398030], [71, 398190], [74, 398330], [87, 399563], [89, 399663], [96, 400083], [108, 400843], [111, 401063], [116, 401283]]}, {"verse": 46, "start": 402376, "end": 406638, "text": "Entonces entraron en disputa, cuál de ellos sería el mayor.", "words": [[0, 402376], [9, 403106], [18, 404046], [21, 404186], [30, 404906], [35, 405106], [38, 405346], [44, 405526], [50, 405926], [53, 406106]]}, {"verse": 47, "start": 406988, "end": 413543, "text": "Pero Jesús, viendo los pensamientos del corazón de ellos, tomó un niño, y le puso junto a sí,", "words": [[0, 406988], [5, 407111], [12, 408051], [19, 408371], [23, 408611], [36, 409331], [40, 409531], [48, 409951], [51, 410211], [58, 410911], [63, 411191], [66, 411371], [72, 411731], [74, 412211], [77, 412351], [82, 412691], [88, 412989], [90, 413288]]}, {"verse": 48, "start": 413893, "end": 427681, "text": "Y les dice: Cualquiera que reciba este niño en mi nombre, a mí recibe; y cualquiera que me reciba a mí, recibe al que me envió; porque el que es más pequeño entre todos vosotros, este es el más grande.", "words": [[0, 413893], [2, 414158], [6, 414456], [12, 414922], [23, 415326], [27, 415466], [34, 416086], [39, 416146], [44, 416526], [47, 416726], [50, 416826], [58, 417186], [60, 417666], [63, 417806], [71, 418514], [73, 418734], [84, 419194], [88, 419354], [91, 419454], [98, 419974], [100, 420074], [104, 420474], [111, 421254], [114, 421774], [118, 421934], [121, 422114], [128, 422952], [135, 423196], [138, 423476], [142, 423636], [145, 423776], [149, 423996], [157, 424536], [163, 424856], [169, 425216], [179, 426116], [184, 426536], [187, 426736], [190, 426896], [194, 427056]]}, {"verse": 49, "start": 428031, "end": 437435, "text": "Entonces respondiendo Juan, dijo: Maestro, hemos visto a uno que echaba fuera demonios en tu nombre; y se lo prohibimos, porque no sigue con nosotros.", "words": [[0, 428287], [9, 428876], [22, 429576], [28, 430256], [34, 431014], [43, 431456], [49, 431636], [55, 432016], [57, 432176], [61, 432316], [65, 432536], [72, 432856], [78, 433076], [87, 433696], [90, 433856], [93, 433976], [101, 434748], [103, 434850], [106, 434950], [109, 435070], [121, 435750], [128, 436110], [131, 436270], [137, 436510], [141, 436770]]}, {"verse": 50, "start": 437715, "end": 444704, "text": "Jesús le dijo: No se lo prohibáis; porque el que no es contra nosotros, por nosotros es.", "words": [[0, 437715], [6, 438003], [9, 438343], [15, 439052], [18, 439179], [21, 439339], [24, 439499], [35, 440614], [42, 440878], [45, 441218], [49, 441378], [52, 441638], [55, 441878], [62, 442218], [72, 443278], [76, 443578], [85, 444078]]}, {"verse": 51, "start": 445054, "end": 453602, "text": "Y aconteció que, como se cumplió el tiempo en que había de ser recibido arriba, él afirmó su rostro para ir a Jerusalén.", "words": [[0, 445054], [2, 445181], [12, 445801], [17, 446001], [22, 446261], [25, 446461], [33, 447081], [36, 447201], [43, 447701], [46, 448001], [50, 448101], [56, 448361], [59, 448521], [63, 448701], [72, 449301], [80, 450321], [83, 450581], [90, 451401], [93, 451561], [100, 452141], [105, 452341], [108, 452601], [110, 452661]]}, {"verse": 52, "start": 453952, "end": 462779, "text": "Y envió mensajeros delante de sí, los cuales fueron y entraron en una ciudad de los samaritanos, para preparar su llegada.", "words": [[0, 453952], [2, 454119], [8, 454479], [19, 455139], [27, 455579], [30, 455739], [34, 456639], [38, 456759], [45, 457019], [52, 457419], [54, 457939], [63, 458559], [66, 458699], [70, 458879], [77, 459279], [80, 459539], [84, 459659], [97, 460679], [102, 461119], [111, 461919], [114, 462079]]}, {"verse": 53, "start": 463129, "end": 467347, "text": "Pero no le recibieron, porque tenía intención de ir a Jerusalén.", "words": [[0, 463129], [5, 463274], [8, 463494], [11, 463654], [23, 464454], [30, 464749], [36, 465109], [46, 466049], [49, 466249], [52, 466409], [54, 466489]]}, {"verse": 54, "start": 467697, "end": 478115, "text": "Y viendo esto sus discípulos Jacobo y Juan, dijeron: Señor, ¿quieres que mandemos que descienda fuego del cielo, y los consuma, como hizo Elías?", "words": [[0, 467697], [2, 467822], [9, 468112], [14, 468402], [18, 468742], [29, 469582], [36, 470342], [38, 470462], [44, 471402], [53, 472354], [60, 473368], [69, 473668], [73, 473788], [82, 474288], [86, 474448], [96, 474968], [102, 475268], [106, 475548], [113, 475968], [115, 476208], [119, 476348], [128, 476948], [133, 477168], [138, 477428]]}, {"verse": 55, "start": 478395, "end": 485644, "text": "Entonces volviéndose él, los reprendió, diciendo: Vosotros no sabéis de qué espíritu sois;", "words": [[0, 478395], [9, 479359], [21, 480159], [25, 480612], [29, 481066], [40, 481519], [50, 482453], [59, 483057], [62, 483597], [69, 484077], [72, 484257], [76, 484622], [85, 484987]]}, {"verse": 56, "start": 485994, "end": 493875, "text": "Porque el Hijo del hombre no ha venido para perder las almas de los hombres, sino para salvarlas. Y se fueron a otra aldea.", "words": [[0, 485994], [7, 486218], [10, 486538], [15, 486818], [19, 486958], [26, 487318], [29, 487498], [32, 487618], [39, 487978], [44, 488198], [51, 488538], [55, 488818], [61, 489198], [64, 489318], [68, 489458], [77, 489818], [82, 490318], [87, 490578], [98, 491798], [100, 491939], [103, 492039], [110, 492339], [112, 492719], [117, 492999]]}, {"verse": 57, "start": 494225, "end": 500471, "text": "Y aconteció que yendo ellos, uno le dijo en el camino: Señor, te seguiré adondequiera que vayas.", "words": [[0, 494225], [2, 494347], [12, 494967], [16, 495167], [22, 495547], [29, 496367], [33, 496567], [36, 496747], [41, 497027], [44, 497207], [47, 497307], [55, 498148], [62, 498468], [65, 498668], [73, 499218], [86, 499768], [90, 499908]]}, {"verse": 58, "start": 500751, "end": 509051, "text": "Y le dijo Jesús: Las zorras tienen cuevas, y las aves de los cielos nidos; pero el Hijo del hombre no tiene donde recline la cabeza.", "words": [[0, 500751], [2, 500897], [5, 500977], [10, 501257], [17, 502195], [21, 502495], [28, 502825], [35, 503045], [43, 503605], [45, 503745], [49, 503885], [54, 504185], [57, 504285], [61, 504405], [68, 504925], [75, 505528], [80, 505808], [83, 506008], [88, 506268], [92, 506448], [99, 506768], [102, 507008], [108, 507348], [114, 507808], [122, 508268], [125, 508448]]}, {"verse": 59, "start": 509401, "end": 515173, "text": "Y dijo a otro: Sígueme. Y él dijo: Señor, déjame que primero vaya y entierre a mi padre.", "words": [[0, 509401], [2, 509520], [7, 509760], [9, 509900], [15, 510480], [24, 511366], [26, 511507], [29, 511647], [35, 512338], [42, 512592], [49, 513112], [53, 513272], [61, 513572], [66, 513932], [68, 514112], [77, 514532], [79, 514612], [82, 514692]]}, {"verse": 60, "start": 515453, "end": 524107, "text": "Y Jesús le dijo: Deja los muertos que entierren a sus muertos; y tú, ve, y anuncia el reino de Dios.", "words": [[0, 515453], [2, 515577], [8, 515917], [11, 516417], [17, 517198], [22, 517665], [26, 517745], [34, 518285], [38, 518585], [48, 519405], [50, 519545], [54, 519685], [63, 520762], [65, 520909], [69, 521469], [73, 521769], [75, 522229], [83, 522849], [86, 523049], [92, 523429], [95, 523589]]}, {"verse": 61, "start": 524457, "end": 530711, "text": "Entonces también dijo otro: Te seguiré, Señor; pero déjame que me despida primero de los que están en mi casa.", "words": [[0, 524457], [9, 525020], [17, 525440], [22, 525780], [28, 526477], [31, 526571], [40, 526991], [47, 527697], [52, 527833], [59, 528253], [63, 528393], [66, 528493], [74, 528953], [82, 529253], [85, 529513], [89, 529633], [93, 529753], [99, 529973], [102, 530113], [105, 530233]]}, {"verse": 62, "start": 530991, "end": 538905, "text": "Y Jesús le dijo: Ninguno que poniendo su mano al arado mira atrás, es apto para el reino de Dios.", "words": [[0, 530991], [2, 531115], [8, 531455], [11, 531955], [17, 532736], [25, 533450], [29, 533630], [38, 534150], [41, 534350], [46, 534650], [49, 534870], [55, 535230], [60, 535510], [67, 536590], [70, 536850], [75, 537430], [80, 537570], [83, 537750], [89, 538150], [92, 538310]]}]}