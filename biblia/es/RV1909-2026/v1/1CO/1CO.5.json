{"book": "1CO", "chapter": 5, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 108670, "verses": [{"verse": 1, "start": 300, "end": 11640, "text": "De cierto se oye que hay entre vosotros inmoralidad sexual, y tal inmoralidad sexual cual ni aun se nombra entre los Gentiles; tanto que alguno tenga la mujer de su padre.", "words": [[0, 300], [3, 474], [10, 734], [13, 1054], [17, 1334], [21, 1514], [25, 1774], [31, 2134], [40, 2754], [52, 3674], [60, 4154], [62, 4894], [66, 5074], [78, 5874], [85, 6394], [90, 6914], [93, 7174], [97, 7374], [100, 7594], [107, 7974], [113, 8154], [117, 8334], [127, 9400], [133, 9580], [137, 9760], [144, 10180], [150, 10380], [153, 10540], [159, 10820], [162, 11000], [165, 11120]]}, {"verse": 2, "start": 12090, "end": 19837, "text": "Y vosotros estáis engreídos, y no más bien tuvisteis duelo, para que fuese quitado de en medio de vosotros el que hizo tal obra.", "words": [[0, 12090], [2, 12193], [11, 12653], [18, 13173], [29, 14113], [31, 14373], [34, 14513], [38, 14693], [43, 14893], [53, 15473], [60, 15853], [65, 16433], [69, 16593], [75, 16873], [83, 17373], [86, 17533], [89, 17693], [95, 17933], [98, 18093], [107, 18593], [110, 18853], [114, 18993], [119, 19193], [123, 19413]]}, {"verse": 3, "start": 20287, "end": 27776, "text": "Y ciertamente, como ausente con el cuerpo, pero presente en espíritu, ya como presente he juzgado al que esto así ha cometido:", "words": [[0, 20287], [2, 20452], [15, 21052], [20, 21352], [28, 21812], [32, 22012], [35, 22112], [43, 22792], [48, 22952], [57, 23332], [60, 23552], [70, 24512], [73, 24732], [78, 24952], [87, 25352], [90, 25612], [98, 26012], [101, 26252], [105, 26392], [110, 26632], [114, 26952], [117, 27072]]}, {"verse": 4, "start": 28226, "end": 35435, "text": "En el nombre del Señor nuestro Jesucristo, reunidos vosotros y mi espíritu, con el poder de nuestro Señor Jesucristo,", "words": [[0, 28226], [3, 28384], [6, 28464], [13, 28784], [17, 29024], [23, 29324], [31, 29824], [43, 30944], [52, 31464], [61, 31984], [63, 32184], [66, 32284], [76, 33204], [80, 33384], [83, 33504], [89, 33744], [92, 33984], [100, 34324], [106, 34564]]}, {"verse": 5, "start": 35885, "end": 42387, "text": "El tal sea entregado a Satanás para muerte de la carne, porque el espíritu sea salvo en el día del Señor Jesús.", "words": [[0, 35885], [3, 36045], [7, 36205], [11, 36445], [21, 37045], [23, 37125], [31, 37665], [36, 37865], [43, 38205], [46, 38385], [49, 38505], [56, 39125], [63, 39485], [66, 39665], [75, 40205], [79, 40385], [85, 40845], [88, 40965], [91, 41065], [95, 41285], [99, 41465], [105, 41705]]}, {"verse": 6, "start": 42837, "end": 47963, "text": "No es buena vuestra jactancia. ¿No sabéis que un poco de levadura fermenta toda la masa?", "words": [[0, 42837], [3, 42977], [6, 43117], [12, 43337], [20, 43927], [31, 44762], [35, 44947], [42, 45387], [46, 45567], [49, 45707], [54, 45927], [57, 46107], [66, 46547], [75, 47107], [80, 47227], [83, 47407]]}, {"verse": 7, "start": 48413, "end": 57300, "text": "Limpiad pues la vieja levadura, para que seáis nueva masa, como sois sin levadura: porque nuestra pascua, que es Cristo, fue sacrificada por nosotros.", "words": [[0, 48413], [8, 48911], [13, 49051], [16, 49251], [22, 49551], [32, 49971], [37, 50211], [41, 50351], [47, 50671], [53, 50871], [59, 51351], [64, 51821], [69, 52291], [73, 52531], [83, 53477], [90, 53704], [98, 53904], [106, 54564], [110, 54724], [113, 54844], [121, 55224], [125, 55684], [137, 56384], [141, 56584]]}, {"verse": 8, "start": 57750, "end": 66714, "text": "Así que hagamos fiesta, no en la vieja levadura, ni en la levadura de malicia y de maldad, sino en panes sin levadura de sinceridad y de verdad.", "words": [[0, 57750], [4, 57954], [8, 58134], [16, 58434], [24, 59294], [27, 59434], [30, 59574], [33, 59674], [39, 59994], [49, 60914], [52, 61074], [55, 61214], [58, 61294], [67, 61694], [70, 61834], [78, 62294], [80, 62414], [83, 62514], [91, 63254], [96, 63554], [99, 63774], [105, 64194], [109, 64434], [118, 64934], [121, 65074], [132, 65854], [134, 66094], [137, 66194]]}, {"verse": 9, "start": 67164, "end": 72479, "text": "Os he escrito por carta, que no os asociéis con quienes practican inmoralidad sexual:", "words": [[0, 67164], [3, 67310], [6, 67530], [14, 67870], [18, 68110], [25, 69010], [29, 69210], [32, 69390], [35, 69550], [44, 70090], [48, 70290], [56, 70470], [66, 71190], [78, 71850]]}, {"verse": 10, "start": 72929, "end": 83238, "text": "No absolutamente con quienes practican inmoralidad sexual en este mundo, o con los avaros, o con los ladrones, o con los idólatras; pues en tal caso tendríais que salir del mundo.", "words": [[0, 72929], [3, 73095], [17, 73695], [21, 74135], [29, 74315], [39, 75055], [51, 75755], [58, 76175], [61, 76455], [66, 76675], [73, 77335], [75, 77555], [79, 77695], [83, 77835], [91, 78515], [93, 78535], [97, 78715], [101, 78835], [111, 79555], [113, 79615], [117, 79755], [121, 79875], [132, 80899], [137, 81002], [140, 81202], [144, 81322], [149, 81642], [159, 82182], [163, 82302], [169, 82522], [173, 82722]]}, {"verse": 11, "start": 83688, "end": 96110, "text": "Pero ahora os he escrito, que no os asociéis, es decir, que si alguno que se llama hermano es sexualmente inmoral, o avaro, o idólatra, o maldiciente, o borracho, o ladrón, con el tal ni aun comáis.", "words": [[0, 83688], [5, 83826], [11, 84106], [14, 84326], [17, 84446], [26, 84886], [30, 85306], [33, 85506], [36, 85666], [46, 86506], [49, 86566], [56, 87426], [60, 87486], [63, 87606], [70, 88046], [74, 88106], [77, 88246], [83, 88506], [91, 89006], [94, 89106], [106, 89786], [115, 90486], [117, 90566], [124, 91126], [126, 91166], [136, 91906], [138, 91926], [151, 92626], [153, 92866], [163, 93838], [165, 93961], [173, 94341], [177, 94521], [180, 94661], [184, 94901], [187, 95141], [191, 95361]]}, {"verse": 12, "start": 96560, "end": 102596, "text": "Porque ¿qué me va a mí en juzgar a los que están fuera? ¿No juzgáis vosotros a los que están dentro?", "words": [[0, 96671], [7, 96821], [12, 96981], [15, 97101], [18, 97281], [20, 97321], [23, 97461], [26, 97641], [33, 98101], [35, 98221], [39, 98341], [43, 98461], [49, 98641], [56, 99447], [60, 99566], [68, 100006], [77, 100526], [79, 100686], [83, 100786], [87, 100906], [93, 101106]]}, {"verse": 13, "start": 103046, "end": 108270, "text": "Porque a los que están fuera, Dios juzgará: quitad pues a ese malo de entre vosotros.", "words": [[0, 103046], [7, 103280], [9, 103400], [13, 103520], [17, 103660], [23, 103860], [30, 104640], [35, 104820], [44, 105771], [51, 106115], [56, 106355], [58, 106675], [62, 106815], [67, 107215], [70, 107315], [76, 107495]]}]}