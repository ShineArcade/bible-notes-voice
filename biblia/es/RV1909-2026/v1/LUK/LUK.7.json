{"book": "LUK", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 440551, "verses": [{"verse": 1, "start": 300, "end": 5637, "text": "Y como acabó todas sus palabras oyéndole el pueblo, entró en Capernaum.", "words": [[0, 300], [2, 407], [7, 647], [13, 1067], [19, 1267], [23, 1547], [32, 1927], [41, 2687], [44, 2827], [52, 3807], [58, 4507], [61, 4727]]}, {"verse": 2, "start": 6087, "end": 13712, "text": "Y el siervo de un centurión, al cual tenía él en estima, estaba enfermo y a punto de morir.", "words": [[0, 6087], [2, 6527], [5, 6667], [12, 7147], [15, 7287], [18, 7407], [29, 8097], [32, 8787], [37, 8887], [43, 9327], [46, 9747], [49, 9987], [57, 10947], [64, 11227], [72, 12027], [74, 12407], [76, 12527], [82, 12827], [85, 13107]]}, {"verse": 3, "start": 14162, "end": 22323, "text": "Y cuando oyó hablar de Jesús, envió a él los ancianos de los judíos, rogándole que viniese y librase a su siervo.", "words": [[0, 14162], [2, 14240], [9, 14520], [13, 14860], [20, 15120], [23, 15300], [30, 16380], [36, 16900], [38, 17080], [41, 17240], [45, 17420], [54, 18000], [57, 18120], [61, 18220], [69, 18990], [79, 19760], [83, 19940], [91, 20520], [93, 20860], [101, 21400], [103, 21560], [106, 21700]]}, {"verse": 4, "start": 22773, "end": 29572, "text": "Y viniendo ellos a Jesús, le rogaron con diligencia, diciéndole: Porque es digno de concederle esto;", "words": [[0, 22773], [2, 22954], [11, 23454], [17, 23714], [19, 23934], [26, 24374], [29, 24814], [37, 25354], [41, 25514], [53, 26554], [65, 27715], [72, 27948], [75, 28068], [81, 28428], [84, 28488], [95, 29148]]}, {"verse": 5, "start": 30022, "end": 33145, "text": "Que ama nuestra nación, y él nos edificó una sinagoga.", "words": [[0, 30022], [4, 30139], [8, 30299], [16, 30519], [24, 31139], [26, 31499], [29, 31619], [33, 31759], [41, 32299], [45, 32419]]}, {"verse": 6, "start": 33495, "end": 47134, "text": "Y Jesús fue con ellos. Pero como ya no estuviesen lejos de su casa, envió el centurión amigos a él, diciéndole: Señor, no te incomodes, que no soy digno que entres debajo de mi techo;", "words": [[0, 33495], [2, 33616], [8, 33976], [12, 34336], [16, 34596], [23, 35543], [28, 35727], [33, 35987], [36, 36267], [39, 36467], [50, 37087], [56, 37607], [59, 37767], [62, 37927], [68, 38807], [74, 39247], [77, 39407], [87, 40407], [94, 40647], [96, 40927], [100, 41487], [112, 42773], [119, 43332], [122, 43432], [125, 43572], [136, 44512], [140, 44752], [143, 44892], [147, 45092], [153, 45552], [157, 45652], [164, 45992], [171, 46372], [174, 46532], [177, 46592]]}, {"verse": 7, "start": 47584, "end": 53823, "text": "Por lo cual ni aun me tuve por digno de venir a ti; pero di la palabra, y mi siervo será sano.", "words": [[0, 47584], [4, 47687], [7, 47827], [12, 48127], [15, 48407], [19, 48587], [22, 48807], [27, 49087], [31, 49247], [37, 49627], [40, 49707], [46, 49927], [48, 50127], [52, 50737], [57, 50896], [60, 51096], [63, 51236], [72, 52116], [74, 52396], [77, 52556], [84, 52996], [89, 53236]]}, {"verse": 8, "start": 54273, "end": 66534, "text": "Porque también yo soy hombre puesto bajo autoridad, que tengo debajo de mí soldados; y digo a este: Ve, y va; y al otro: Ven, y viene; y a mi siervo: Haz esto, y lo hace.", "words": [[0, 54273], [7, 54450], [15, 54850], [18, 55050], [22, 55230], [29, 55510], [36, 55890], [41, 56110], [52, 56770], [56, 57230], [62, 57550], [69, 57930], [72, 58070], [75, 58210], [85, 59225], [87, 59364], [92, 59564], [94, 59684], [100, 60560], [104, 60765], [106, 60970], [110, 61475], [112, 61641], [115, 61741], [121, 62446], [126, 62723], [128, 63063], [135, 63822], [137, 63982], [139, 64002], [142, 64082], [150, 65022], [154, 65234], [160, 65614], [162, 65994], [165, 66154]]}, {"verse": 9, "start": 66884, "end": 77361, "text": "Lo cual oyendo Jesús, se maravilló de él, y vuelto, dijo a la gente que le seguía: Os digo que ni aun en Israel he hallado tanta fe.", "words": [[0, 66884], [3, 67010], [8, 67330], [15, 67870], [22, 68810], [25, 69200], [35, 69590], [38, 69690], [42, 69970], [44, 70410], [52, 71290], [57, 71590], [59, 71750], [62, 71810], [68, 72070], [72, 72290], [75, 72410], [83, 73325], [86, 73682], [91, 74002], [95, 74282], [98, 74622], [102, 74962], [105, 75342], [112, 75822], [115, 76202], [123, 76642], [129, 76842]]}, {"verse": 10, "start": 77811, "end": 84411, "text": "Y vueltos a casa los que habían sido enviados, hallaron sano al siervo que había estado enfermo.", "words": [[0, 77811], [2, 77954], [10, 78514], [12, 78634], [17, 78954], [21, 79194], [25, 79354], [32, 79574], [37, 79914], [47, 80874], [56, 81474], [61, 81974], [64, 82274], [71, 82834], [75, 83014], [81, 83214], [88, 83594]]}, {"verse": 11, "start": 84861, "end": 93448, "text": "Y aconteció después, que él iba a la ciudad que se llama Naín, e iban con él muchos de sus discípulos, y una gran multitud.", "words": [[0, 84861], [2, 85005], [12, 85705], [21, 85985], [25, 86305], [28, 86485], [32, 86685], [34, 86825], [37, 86865], [44, 87165], [48, 87465], [51, 87605], [57, 88225], [63, 88845], [65, 88905], [70, 89205], [74, 89405], [77, 89605], [84, 89985], [87, 90185], [91, 90365], [103, 91605], [105, 91945], [109, 92125], [114, 92525]]}, {"verse": 12, "start": 93898, "end": 106763, "text": "Y cuando llegó cerca de la puerta de la ciudad, he aquí que sacaban fuera a un difunto, único hijo de su madre, la cual también era viuda: y había con ella una gran multitud de la ciudad.", "words": [[0, 93898], [2, 94004], [9, 94244], [15, 94584], [21, 94964], [24, 95204], [27, 95344], [34, 95604], [37, 95844], [40, 95964], [48, 96984], [51, 97324], [56, 97564], [60, 98044], [68, 98524], [74, 98704], [76, 99024], [79, 99144], [88, 99744], [94, 100204], [99, 100644], [102, 100864], [105, 101004], [112, 101724], [115, 101844], [120, 102044], [128, 102424], [132, 102804], [139, 103706], [141, 103848], [147, 104048], [151, 104328], [156, 104528], [160, 104748], [165, 105008], [174, 105788], [177, 106008], [180, 106128]]}, {"verse": 13, "start": 107213, "end": 112320, "text": "Y como el Señor la vio, se compadeció de ella, y le dice: No llores.", "words": [[0, 107213], [2, 107300], [7, 107500], [10, 107660], [16, 107900], [19, 108140], [24, 108740], [27, 108900], [38, 109720], [41, 109880], [47, 110160], [49, 110660], [52, 110800], [58, 111865], [61, 112129]]}, {"verse": 14, "start": 112770, "end": 121036, "text": "Y acercándose, tocó el féretro: y los que lo llevaban, pararon. Y dice: Joven, a ti digo, levántate.", "words": [[0, 112770], [2, 112871], [15, 113631], [20, 114171], [23, 114311], [32, 115248], [34, 115376], [38, 115516], [42, 115646], [45, 115776], [55, 116376], [64, 117902], [66, 118044], [72, 118834], [79, 119459], [81, 119559], [84, 119659], [90, 119959]]}, {"verse": 15, "start": 121486, "end": 127464, "text": "Entonces se incorporó el que había muerto, y comenzó a hablar. Y le dio a su madre.", "words": [[0, 121486], [9, 122050], [12, 122430], [22, 122880], [25, 123330], [29, 123470], [35, 123690], [43, 123846], [45, 124001], [53, 124157], [55, 124313], [63, 125969], [65, 126249], [68, 126369], [72, 126609], [74, 126769], [77, 126889]]}, {"verse": 16, "start": 127914, "end": 138136, "text": "Y todos tuvieron miedo, y glorificaban a Dios, diciendo: Que un gran profeta se ha levantado entre nosotros; y que Dios ha visitado a su pueblo.", "words": [[0, 127914], [2, 128038], [8, 128318], [17, 128918], [24, 129378], [26, 130078], [39, 130918], [41, 131058], [47, 131678], [57, 132680], [61, 133356], [64, 133482], [69, 133662], [77, 134162], [80, 134362], [83, 134442], [93, 134982], [99, 135162], [109, 136241], [111, 136345], [115, 136445], [120, 136705], [123, 136945], [132, 137425], [134, 137505], [137, 137605]]}, {"verse": 17, "start": 138486, "end": 143895, "text": "Y salió esta fama de él por toda Judea, y por toda la tierra de alrededor.", "words": [[0, 138486], [2, 138613], [8, 139033], [13, 139333], [18, 139733], [21, 139853], [24, 140013], [28, 140233], [33, 140473], [40, 141253], [42, 141633], [46, 141853], [51, 142253], [54, 142453], [61, 142833], [64, 143073]]}, {"verse": 18, "start": 144345, "end": 150836, "text": "Y sus discípulos informaron a Juan de todas estas cosas: y llamó Juan a dos de sus discípulos,", "words": [[0, 144345], [2, 144453], [6, 144593], [17, 145253], [28, 146013], [30, 146193], [35, 146453], [38, 146693], [44, 146953], [50, 147293], [57, 148336], [59, 148442], [65, 148722], [70, 148942], [72, 149242], [76, 149462], [79, 149622], [83, 149822]]}, {"verse": 19, "start": 151286, "end": 157110, "text": "Y envió a Jesús, diciendo: ¿Eres tú aquel que había de venir, o esperaremos a otro?", "words": [[0, 151286], [2, 151451], [8, 151871], [10, 152151], [17, 152591], [27, 154015], [33, 154232], [36, 154472], [42, 154832], [46, 154932], [52, 155132], [55, 155292], [62, 155572], [64, 155912], [76, 156492], [78, 156732]]}, {"verse": 20, "start": 157460, "end": 168343, "text": "Y como los hombres vinieron a él, dijeron: Juan el Bautista nos ha enviado a ti, diciendo: ¿Eres tú aquel que había de venir, o esperaremos a otro?", "words": [[0, 157460], [2, 157584], [7, 157824], [11, 158024], [19, 158444], [28, 159024], [30, 159224], [34, 159764], [43, 161649], [48, 162166], [51, 162206], [60, 162926], [64, 163046], [67, 163226], [75, 163686], [77, 163806], [81, 163966], [91, 165248], [97, 165465], [100, 165705], [106, 166065], [110, 166165], [116, 166365], [119, 166525], [126, 166805], [128, 167145], [140, 167725], [142, 167965]]}, {"verse": 21, "start": 168693, "end": 177006, "text": "Y en la misma hora sanó a muchos de enfermedades y plagas, y de espíritus malos; y a muchos ciegos dio la vista.", "words": [[0, 168693], [2, 168839], [5, 168939], [8, 169059], [14, 169319], [19, 169739], [24, 170259], [26, 170379], [33, 170659], [36, 170939], [49, 171799], [51, 171979], [59, 172819], [61, 172999], [64, 173139], [74, 173679], [81, 174646], [83, 174772], [85, 174812], [92, 175072], [99, 175872], [103, 176192], [106, 176352]]}, {"verse": 22, "start": 177456, "end": 196697, "text": "Y respondiendo Jesús, les dijo: Id, dad las nuevas a Juan de lo que habéis visto y oído: que los ciegos ven, los cojos andan, los leprosos son limpiados, los sordos oyen, los muertos resucitan, a los pobres es anunciado el evangelio:", "words": [[0, 177456], [2, 177564], [15, 178264], [22, 178704], [26, 179284], [32, 180196], [36, 180306], [40, 180686], [44, 181086], [51, 181486], [53, 181726], [58, 182026], [61, 182666], [64, 182786], [68, 182926], [75, 183266], [81, 183726], [83, 184146], [89, 185058], [93, 185140], [97, 185300], [104, 185800], [109, 186760], [113, 186880], [119, 187340], [126, 188380], [130, 188500], [139, 189080], [143, 189400], [154, 190480], [158, 190580], [165, 191220], [171, 192200], [175, 192320], [183, 192840], [194, 194040], [196, 194080], [200, 194220], [207, 194700], [210, 194980], [220, 195740], [223, 195860]]}, {"verse": 23, "start": 197147, "end": 199934, "text": "Y dichoso es el que no halle tropiezo en mí.", "words": [[0, 197147], [2, 197292], [10, 197812], [13, 198032], [16, 198152], [20, 198332], [23, 198552], [29, 198772], [38, 199452], [41, 199572]]}, {"verse": 24, "start": 200384, "end": 211669, "text": "Y como se fueron los mensajeros de Juan, comenzó a hablar de Juan a la gente: ¿Qué salisteis a ver al desierto? ¿una caña que es agitada por el viento?", "words": [[0, 200384], [2, 200525], [7, 200805], [10, 201025], [17, 201385], [21, 201625], [32, 202405], [35, 202565], [41, 203385], [49, 204085], [51, 204185], [58, 204385], [61, 204585], [66, 204845], [68, 205005], [71, 205065], [78, 206062], [83, 206166], [93, 206866], [95, 207026], [99, 207166], [102, 207306], [112, 208438], [117, 208818], [122, 209338], [126, 209798], [129, 209998], [137, 210658], [141, 210878], [144, 211018]]}, {"verse": 25, "start": 212119, "end": 223420, "text": "Pero ¿qué salisteis a ver? ¿un hombre cubierto de vestidos delicados? He aquí, los que están en vestido precioso, y viven en delicias, en los palacios de los reyes están.", "words": [[0, 212119], [5, 212302], [10, 212702], [20, 213282], [22, 213422], [27, 214100], [31, 214247], [38, 214527], [47, 215227], [50, 215387], [59, 215867], [70, 217018], [73, 217176], [79, 217476], [83, 217656], [87, 217796], [93, 217996], [96, 218176], [104, 218556], [114, 219256], [116, 219756], [122, 220156], [125, 220256], [135, 220816], [138, 221416], [142, 221536], [151, 222096], [154, 222216], [158, 222506], [164, 222796]]}, {"verse": 26, "start": 223870, "end": 229318, "text": "Pero ¿qué salisteis a ver? ¿un profeta? También os digo, y aun más que profeta.", "words": [[0, 223870], [5, 224053], [10, 224453], [20, 225033], [22, 225173], [27, 225852], [31, 226000], [40, 227021], [48, 227245], [51, 227485], [57, 227785], [59, 228185], [63, 228325], [67, 228565], [71, 228685]]}, {"verse": 27, "start": 229768, "end": 237829, "text": "Este es de quien está escrito: He aquí, envío mi mensajero delante de tu faz, el cual preparará tu camino delante de ti.", "words": [[0, 229768], [5, 230012], [8, 230268], [11, 230524], [17, 230779], [22, 231035], [31, 231531], [34, 231719], [40, 232039], [46, 232539], [49, 232699], [59, 233399], [67, 233839], [70, 233999], [73, 234139], [78, 235059], [81, 235159], [86, 235419], [96, 236259], [99, 236419], [106, 236779], [114, 237339], [117, 237499]]}, {"verse": 28, "start": 238279, "end": 248108, "text": "Porque os digo que entre los nacidos de mujeres, no hay mayor profeta que Juan el Bautista: pero el más pequeño en el reino de los cielos es mayor que él.", "words": [[0, 238279], [7, 238521], [10, 238741], [15, 239021], [19, 239241], [25, 239481], [29, 239701], [37, 240221], [40, 240381], [49, 240841], [52, 241441], [56, 241601], [62, 241981], [70, 242601], [74, 242741], [79, 243001], [82, 243181], [92, 244327], [97, 244495], [100, 244635], [104, 244755], [112, 245195], [115, 245415], [118, 245555], [124, 245915], [127, 246015], [131, 246175], [138, 246615], [141, 246795], [147, 247415], [151, 247755]]}, {"verse": 29, "start": 248558, "end": 258164, "text": "Y todo el pueblo oyéndole, y los recaudadores de impuestos, reconocieron la justicia de Dios, bautizándose con el bautismo de Juan.", "words": [[0, 248558], [2, 248703], [7, 248963], [10, 249183], [17, 249543], [27, 250423], [29, 251023], [33, 251183], [46, 251963], [49, 252143], [60, 253463], [73, 254083], [76, 254243], [85, 254763], [88, 254923], [94, 255783], [107, 256623], [111, 256863], [114, 256983], [123, 257463], [126, 257603]]}, {"verse": 30, "start": 258614, "end": 267012, "text": "Pero los fariseos y los sabios de la ley, desecharon el consejo de Dios contra sí mismos, no siendo bautizados de él.", "words": [[0, 258614], [5, 258759], [9, 258939], [18, 259719], [20, 259859], [24, 260019], [31, 260519], [34, 260599], [37, 260739], [42, 261059], [53, 262279], [56, 262459], [64, 263119], [67, 263239], [72, 263459], [79, 263859], [82, 264059], [90, 264979], [93, 265219], [100, 265519], [111, 266339], [114, 266619]]}, {"verse": 31, "start": 267462, "end": 274959, "text": "Y dice el Señor: ¿A quién, pues, compararé los hombres de esta generación, y a qué son semejantes?", "words": [[0, 267462], [2, 267587], [7, 267887], [10, 268067], [17, 269021], [20, 269145], [27, 269385], [33, 270085], [43, 270845], [47, 271005], [55, 271385], [58, 271685], [63, 271905], [75, 273265], [77, 273405], [79, 273525], [83, 273625], [87, 273865]]}, {"verse": 32, "start": 275409, "end": 289497, "text": "Semejantes son a los muchachos sentados en la plaza, y que dan voces los unos a los otros, y dicen: Tocamos flautas para vosotros, y no bailasteis: os cantamos lamentos, y no llorasteis.", "words": [[0, 275409], [11, 276092], [15, 276352], [17, 276472], [21, 276592], [31, 277192], [40, 277792], [43, 278012], [46, 278152], [53, 278652], [55, 278999], [59, 279345], [63, 279692], [69, 280252], [73, 280452], [78, 280832], [80, 281192], [84, 281372], [91, 281752], [93, 282272], [100, 283230], [108, 283613], [116, 284173], [121, 284353], [131, 284913], [133, 285233], [136, 285393], [148, 286821], [151, 286971], [160, 287531], [170, 288051], [172, 288351], [175, 288531]]}, {"verse": 33, "start": 289947, "end": 295982, "text": "Porque vino Juan el Bautista, que ni comía pan, ni bebía vino, y decís: Demonio tiene.", "words": [[0, 289947], [7, 290150], [12, 290410], [17, 290930], [20, 291030], [30, 291750], [34, 291830], [37, 291970], [43, 292290], [48, 292970], [51, 293250], [57, 293610], [63, 293890], [65, 294110], [72, 294982], [80, 295486]]}, {"verse": 34, "start": 296432, "end": 307355, "text": "Vino el Hijo del hombre, que come y bebe, y decís: He aquí un hombre comilón, y bebedor de vino, amigo de recaudadores de impuestos y de pecadores.", "words": [[0, 296432], [5, 296717], [8, 296877], [13, 297097], [17, 297277], [25, 297617], [29, 298117], [34, 298557], [36, 298817], [42, 299157], [44, 299317], [51, 300345], [54, 300621], [59, 300881], [62, 301041], [69, 301301], [78, 302041], [80, 302501], [88, 302981], [91, 303121], [97, 303801], [103, 304181], [106, 304401], [119, 305241], [122, 305461], [132, 306121], [134, 306321], [137, 306441]]}, {"verse": 35, "start": 307805, "end": 311025, "text": "Pero la sabiduría es justificada de todos sus hijos.", "words": [[0, 307805], [5, 307950], [8, 308130], [18, 308830], [21, 308930], [33, 309730], [36, 309910], [42, 310110], [46, 310450]]}, {"verse": 36, "start": 311475, "end": 319061, "text": "Y le rogó uno de los fariseos, que comiese con él. Y entrado en casa del fariseo, se sentó a la mesa.", "words": [[0, 311475], [2, 311601], [5, 311721], [10, 312161], [14, 312361], [17, 312501], [21, 312621], [31, 313461], [35, 313881], [43, 314321], [47, 314581], [51, 315219], [53, 315497], [61, 316137], [64, 316297], [69, 316597], [73, 316857], [82, 317697], [85, 317937], [91, 318377], [93, 318457], [96, 318557]]}, {"verse": 37, "start": 319511, "end": 330424, "text": "Y he aquí una mujer que había sido pecadora en la ciudad, como entendió que estaba a la mesa en casa de aquel fariseo, trajo un frasco de alabastro con ungüento,", "words": [[0, 319511], [2, 319688], [5, 319848], [10, 320208], [14, 320508], [20, 320928], [24, 321168], [30, 321408], [35, 321768], [44, 322428], [47, 322588], [50, 322708], [58, 323768], [63, 324088], [72, 324608], [76, 324748], [83, 325068], [85, 325288], [88, 325348], [93, 325628], [96, 325828], [101, 326188], [104, 326408], [110, 326688], [119, 327719], [125, 328043], [128, 328183], [135, 328703], [138, 328843], [148, 329443], [152, 329962]]}, {"verse": 38, "start": 330874, "end": 343260, "text": "Y estando detrás a sus pies, comenzó llorando a regar con lágrimas sus pies, y los limpiaba con los cabellos de su cabeza; y besaba sus pies, y los ungía con el perfume.", "words": [[0, 330874], [2, 330999], [10, 331559], [17, 332079], [19, 332219], [23, 332419], [29, 332699], [37, 333699], [46, 334199], [48, 334299], [54, 334699], [58, 334799], [67, 335439], [71, 335679], [77, 335959], [79, 336459], [83, 336599], [92, 337319], [96, 337559], [100, 337719], [109, 338239], [112, 338339], [115, 338479], [123, 339545], [125, 339651], [132, 340031], [136, 340231], [142, 340551], [144, 341251], [148, 341431], [154, 342151], [158, 342391], [161, 342511]]}, {"verse": 39, "start": 343710, "end": 358209, "text": "Y cuando vio esto el fariseo que le había invitado, habló entre sí, diciendo: Este, si fuera profeta, conocería quién y cuál es la mujer que le toca, que es pecadora.", "words": [[0, 343710], [2, 343813], [9, 344053], [13, 344473], [18, 344793], [21, 344953], [29, 345673], [33, 345813], [36, 345973], [42, 346193], [52, 347093], [58, 347873], [64, 348233], [68, 349133], [78, 350128], [84, 350449], [87, 350649], [93, 350929], [102, 351949], [112, 352589], [118, 352829], [120, 353009], [125, 353289], [128, 353569], [131, 353709], [137, 354029], [141, 354229], [144, 354349], [150, 355129], [154, 355189], [157, 355349]]}, {"verse": 40, "start": 358559, "end": 367145, "text": "Entonces respondiendo Jesús, le dijo: Simón, una cosa tengo que decirte. Y él dice: Di, Maestro.", "words": [[0, 358559], [9, 359700], [22, 360480], [29, 361380], [32, 361480], [38, 362316], [45, 363154], [49, 363334], [54, 363614], [60, 363954], [64, 364174], [73, 365269], [75, 365475], [78, 365615], [84, 366422], [88, 366512]]}, {"verse": 41, "start": 367495, "end": 374176, "text": "Un acreedor tenía dos deudores: el uno le debía quinientos denarios, y el otro cincuenta;", "words": [[0, 367728], [3, 367994], [12, 368261], [18, 368741], [22, 369161], [32, 370470], [35, 370647], [39, 370857], [42, 371017], [48, 371537], [59, 372057], [69, 372577], [71, 372877], [74, 373037], [79, 373635]]}, {"verse": 42, "start": 374626, "end": 381468, "text": "Y no teniendo ellos de qué pagar, perdonó a ambos. Di, pues, ¿cuál de estos le amará más?", "words": [[0, 374626], [2, 374926], [5, 375086], [14, 375626], [20, 375886], [23, 376146], [27, 376246], [34, 377046], [42, 377786], [44, 377926], [51, 378844], [55, 379284], [61, 379744], [67, 380144], [70, 380264], [76, 380484], [79, 380744], [85, 380984]]}, {"verse": 43, "start": 381918, "end": 389778, "text": "Y respondiendo Simón, dijo: Pienso que aquel al cual perdonó más. Y él le dijo: Rectamente has juzgado.", "words": [[0, 381918], [2, 382046], [15, 382786], [22, 383306], [28, 384214], [35, 384511], [39, 384651], [45, 384931], [48, 385071], [53, 385231], [61, 385731], [66, 386761], [68, 386966], [71, 387106], [74, 387266], [80, 388313], [91, 388587], [95, 388860]]}, {"verse": 44, "start": 390228, "end": 402917, "text": "Y vuelto a la mujer, dijo a Simón: ¿Ves esta mujer? Entré en tu casa, no diste agua para mis pies; pero esta ha regado mis pies con lágrimas, y los ha limpiado con los cabellos.", "words": [[0, 390228], [2, 390351], [9, 390691], [11, 390771], [14, 390831], [21, 391451], [26, 391751], [28, 391931], [35, 392839], [40, 392969], [45, 393109], [52, 394066], [58, 394508], [61, 394588], [64, 394708], [70, 395041], [73, 395375], [79, 395708], [84, 396028], [89, 396288], [93, 396448], [99, 397353], [104, 397501], [109, 397881], [112, 398021], [119, 398501], [123, 398681], [128, 398961], [132, 399241], [142, 400021], [144, 400481], [148, 400941], [151, 401101], [160, 401741], [164, 401961], [168, 402460]]}, {"verse": 45, "start": 403367, "end": 409808, "text": "No me diste beso, pero esta, desde que entré, no ha cesado de besar mis pies.", "words": [[0, 403367], [3, 403495], [6, 403635], [12, 403955], [18, 404655], [23, 404875], [29, 405755], [35, 406075], [39, 406395], [46, 407355], [49, 407555], [52, 407695], [59, 408195], [62, 408375], [68, 408815], [72, 408975]]}, {"verse": 46, "start": 410258, "end": 415710, "text": "No ungiste mi cabeza con aceite; pero esta ha ungido con perfume mis pies.", "words": [[0, 410258], [3, 410465], [11, 410925], [14, 411125], [21, 411485], [25, 411825], [33, 413134], [38, 413134], [43, 413421], [46, 413741], [53, 414061], [57, 414341], [65, 414841], [69, 415101]]}, {"verse": 47, "start": 416160, "end": 424265, "text": "Por lo cual te digo que sus muchos pecados son perdonados, porque amó mucho; pero al que se perdona poco, poco ama.", "words": [[0, 416160], [4, 416263], [7, 416383], [12, 416583], [15, 416784], [20, 417064], [24, 417224], [28, 417404], [35, 417763], [43, 418323], [47, 418544], [59, 419763], [66, 420224], [70, 420703], [77, 421527], [82, 421721], [85, 421951], [89, 422091], [92, 422271], [100, 422791], [106, 423131], [111, 423731]]}, {"verse": 48, "start": 424715, "end": 428117, "text": "Y a ella dijo: Los pecados te son perdonados.", "words": [[0, 424715], [2, 424882], [4, 424962], [9, 425162], [15, 426141], [19, 426248], [27, 426748], [30, 426888], [34, 427088]]}, {"verse": 49, "start": 428567, "end": 436033, "text": "Y los que estaban juntamente sentados a la mesa, comenzaron a decir entre sí: ¿Quién es este, que también perdona pecados?", "words": [[0, 428567], [2, 428657], [6, 428777], [10, 428917], [18, 429297], [29, 430157], [38, 430917], [40, 431077], [43, 431177], [49, 431417], [60, 432257], [62, 432377], [68, 432697], [74, 433017], [78, 433724], [85, 433945], [88, 434085], [94, 434305], [98, 434465], [106, 434825], [114, 435265]]}, {"verse": 50, "start": 436383, "end": 440151, "text": "Y dijo a la mujer: Tu fe te ha salvado, ve en paz.", "words": [[0, 436383], [2, 436531], [7, 436831], [9, 436951], [12, 437031], [19, 437886], [22, 437968], [25, 438168], [28, 438328], [31, 438428], [40, 439348], [43, 439508], [46, 439668]]}]}