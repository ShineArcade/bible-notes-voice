{"book": "GEN", "chapter": 29, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 285844, "verses": [{"verse": 1, "start": 300, "end": 4565, "text": "Y siguió Jacob su camino, y fue a la tierra de los orientales.", "words": [[0, 300], [2, 442], [9, 882], [15, 1162], [18, 1502], [26, 1962], [28, 2422], [32, 2622], [34, 2782], [37, 2842], [44, 3182], [47, 3482], [51, 3602]]}, {"verse": 2, "start": 4915, "end": 17762, "text": "Y miró, y vio un pozo en el campo: y he aquí tres rebaños de ovejas que yacían cerca de él; porque de aquel pozo bebían los ganados: y había una gran piedra sobre la boca del pozo.", "words": [[0, 4915], [2, 5039], [8, 5419], [10, 5619], [14, 5839], [17, 5979], [22, 6359], [25, 6519], [28, 6639], [35, 7490], [37, 7635], [40, 7775], [45, 8055], [50, 8375], [58, 8955], [61, 9155], [68, 9615], [72, 10075], [79, 10535], [85, 10895], [88, 11255], [92, 11850], [99, 12152], [102, 12452], [108, 12772], [113, 13192], [120, 13592], [124, 13772], [133, 14693], [135, 14818], [141, 15018], [145, 15298], [150, 15558], [157, 16178], [163, 16498], [166, 16738], [171, 16938], [175, 17178]]}, {"verse": 3, "start": 18112, "end": 30625, "text": "Y se juntaban allí todos los rebaños; y revolvían la piedra de sobre la boca del pozo, y daban de beber a las ovejas; y volvían la piedra sobre la boca del pozo a su lugar.", "words": [[0, 18112], [2, 18234], [5, 18354], [14, 19074], [19, 19334], [25, 19774], [29, 20074], [38, 21195], [40, 21578], [50, 21998], [53, 22178], [60, 22638], [63, 22898], [69, 23158], [72, 23238], [77, 23438], [81, 23658], [87, 24258], [89, 24818], [95, 25158], [98, 25338], [104, 25598], [106, 25778], [110, 25958], [118, 26948], [120, 27188], [128, 27668], [131, 27848], [138, 28368], [144, 28608], [147, 28808], [152, 29048], [156, 29288], [161, 29868], [163, 30008], [166, 30128]]}, {"verse": 4, "start": 30975, "end": 38687, "text": "Y les dijo Jacob: Hermanos míos, ¿de dónde sois? Y ellos respondieron: De Harán somos.", "words": [[0, 30975], [2, 31185], [6, 31415], [11, 31956], [18, 32653], [27, 33178], [33, 33938], [37, 34018], [43, 34218], [49, 35159], [51, 35342], [57, 35682], [71, 37299], [74, 37575], [80, 37895]]}, {"verse": 5, "start": 38967, "end": 45255, "text": "Y él les dijo: ¿Conocéis a Labán, hijo de Nacor? Y ellos dijeron: Sí, le conocemos.", "words": [[0, 38967], [2, 39172], [5, 39352], [9, 39652], [15, 40449], [25, 40966], [27, 41126], [34, 41726], [39, 41926], [42, 42301], [49, 42897], [51, 43063], [57, 43243], [66, 44236], [70, 44440], [73, 44520]]}, {"verse": 6, "start": 45535, "end": 52572, "text": "Y él les dijo: ¿Tiene paz? Y ellos dijeron: Paz; y he aquí Raquel su hija viene con el ganado.", "words": [[0, 45535], [2, 45741], [5, 45921], [9, 46221], [15, 47017], [22, 47218], [27, 48011], [29, 48177], [35, 48357], [44, 49555], [49, 49936], [51, 50074], [54, 50254], [59, 50534], [66, 50894], [69, 51134], [74, 51394], [80, 51574], [84, 51814], [87, 51954]]}, {"verse": 7, "start": 52852, "end": 61286, "text": "Y él dijo: He aquí el día es aún grande; no es tiempo todavía de recoger el ganado; dad de beber a las ovejas, e id a apacentarlas.", "words": [[0, 52852], [2, 53040], [5, 53200], [11, 53960], [14, 54040], [19, 54300], [22, 54560], [26, 54800], [29, 55080], [33, 55280], [41, 56108], [44, 56254], [47, 56394], [54, 56674], [62, 57154], [65, 57314], [73, 57774], [76, 57894], [84, 58633], [88, 58733], [91, 58893], [97, 59093], [99, 59233], [103, 59373], [111, 59793], [113, 59993], [116, 60193], [118, 60313]]}, {"verse": 8, "start": 61566, "end": 71112, "text": "Y ellos respondieron: No podemos, hasta que se junten todos los ganados, y remuevan la piedra de sobre la boca del pozo, para que demos de beber a las ovejas.", "words": [[0, 61566], [2, 61749], [8, 62089], [22, 63705], [25, 63864], [34, 64204], [40, 64524], [44, 64684], [47, 64824], [54, 65264], [60, 65484], [64, 65724], [73, 66224], [75, 66419], [84, 66899], [87, 67039], [94, 67439], [97, 67539], [103, 67779], [106, 67979], [111, 68199], [115, 68399], [121, 68939], [126, 69379], [130, 69519], [136, 69759], [139, 69919], [145, 70139], [147, 70299], [151, 70459]]}, {"verse": 9, "start": 71392, "end": 78646, "text": "Estando aún él hablando con ellos, Raquel vino con el ganado de su padre, porque ella era la pastora.", "words": [[0, 71392], [8, 71858], [12, 72158], [15, 72578], [24, 73078], [28, 73458], [35, 74036], [42, 74613], [47, 74853], [51, 75133], [54, 75423], [61, 75713], [64, 75893], [67, 76033], [74, 76673], [81, 76973], [86, 77413], [90, 77753], [93, 77913]]}, {"verse": 10, "start": 78996, "end": 95725, "text": "Y sucedió que, como Jacob vio a Raquel, hija de Labán hermano de su madre, y a las ovejas de Labán el hermano de su madre, Jacob se acercó, y removió la piedra de sobre la boca del pozo, y dio de beber al ganado de Labán hermano de su madre.", "words": [[0, 78996], [2, 79102], [10, 79642], [15, 79802], [20, 80062], [26, 80442], [30, 80962], [32, 81142], [40, 82042], [45, 82322], [48, 82402], [54, 82882], [62, 83362], [65, 83482], [68, 83602], [75, 84402], [77, 84462], [79, 84542], [83, 84722], [90, 85222], [93, 85402], [99, 85882], [102, 85922], [110, 86402], [113, 86482], [116, 86622], [123, 87302], [129, 87662], [132, 87962], [140, 88914], [142, 89077], [150, 89677], [153, 89837], [160, 90377], [163, 90497], [169, 90797], [172, 91017], [177, 91237], [181, 91457], [187, 92257], [189, 92577], [193, 92817], [196, 92977], [202, 93227], [205, 93477], [212, 93797], [215, 94117], [221, 94437], [229, 94857], [232, 94957], [235, 95117]]}, {"verse": 11, "start": 96075, "end": 101342, "text": "Y Jacob besó a Raquel, y alzó su voz, y lloró.", "words": [[0, 96075], [2, 96597], [8, 96937], [13, 97677], [15, 97817], [23, 98257], [25, 98877], [30, 99257], [33, 99417], [38, 99777], [40, 100817]]}, {"verse": 12, "start": 101692, "end": 110816, "text": "Y Jacob dijo a Raquel como él era hermano de su padre, y como era hijo de Rebeca: y ella corrió, y dio las nuevas a su padre.", "words": [[0, 101692], [2, 101813], [8, 102133], [13, 102793], [15, 103163], [22, 103533], [27, 103733], [30, 103973], [34, 104273], [42, 104793], [45, 104873], [48, 105013], [55, 105413], [57, 105893], [62, 106113], [66, 106333], [71, 106613], [74, 107099], [82, 107756], [84, 107902], [89, 108122], [97, 108722], [99, 109162], [103, 109322], [107, 109502], [114, 109782], [116, 110062], [119, 110202]]}, {"verse": 13, "start": 111166, "end": 123032, "text": "Y así que oyó Labán las nuevas de Jacob, hijo de su hermana, corrió a recibirlo, y lo abrazó, y lo besó, y lo trajo a su casa: y él contó a Labán todas estas cosas.", "words": [[0, 111166], [2, 111282], [6, 111502], [10, 111742], [14, 112052], [20, 112362], [24, 112542], [31, 112862], [34, 113122], [41, 113862], [46, 114142], [49, 114362], [52, 114522], [61, 114992], [68, 115462], [70, 115622], [81, 116342], [83, 116782], [86, 116922], [94, 117562], [96, 117742], [99, 117882], [105, 118342], [107, 118502], [110, 118642], [116, 119082], [118, 119222], [121, 119342], [127, 120181], [129, 120374], [132, 120534], [138, 120827], [140, 121121], [146, 121414], [152, 121814], [158, 122214]]}, {"verse": 14, "start": 123382, "end": 130310, "text": "Y Labán le dijo: Ciertamente hueso mío y carne mía eres. Y estuvo con él el tiempo de un mes.", "words": [[0, 123382], [2, 123508], [8, 123948], [11, 124288], [17, 125036], [29, 125764], [35, 126164], [39, 126564], [41, 126724], [47, 127024], [51, 127444], [57, 128254], [59, 128353], [66, 128693], [70, 128893], [73, 129033], [76, 129173], [83, 129453], [86, 129653], [89, 129753]]}, {"verse": 15, "start": 130660, "end": 138175, "text": "Entonces dijo Labán a Jacob: ¿Por ser tú mi hermano, me has de servir gratis? dime qué será tu salario.", "words": [[0, 130660], [9, 131266], [14, 132006], [20, 132486], [22, 132706], [29, 133500], [34, 133626], [38, 133826], [41, 134046], [44, 134186], [53, 134786], [56, 135066], [60, 135246], [63, 135346], [70, 135626], [78, 