{"book": "ISA", "chapter": 23, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 182211, "verses": [{"verse": 1, "start": 300, "end": 11753, "text": "Carga de Tiro. Aullad, naves de Tarsis, porque destruida es hasta no quedar casa, ni entrada: de la tierra de Quitim les es revelado.", "words": [[0, 300], [6, 544], [9, 804], [15, 1622], [23, 2165], [29, 2705], [32, 2905], [40, 3945], [47, 4345], [57, 5305], [60, 5585], [66, 5905], [69, 6145], [76, 6445], [82, 6905], [85, 7405], [94, 8465], [97, 8593], [100, 8733], [107, 9073], [110, 9473], [117, 9873], [121, 10433], [124, 10733]]}, {"verse": 2, "start": 12203, "end": 19142, "text": "Callad, habitantes de la isla, mercader de Sidón, que pasando el mar te abastecían.", "words": [[0, 12390], [8, 12610], [19, 13310], [22, 13470], [25, 13590], [31, 14490], [40, 15110], [43, 15330], [50, 15830], [54, 16470], [62, 16850], [65, 17110], [69, 17807], [72, 18503]]}, {"verse": 3, "start": 19592, "end": 28779, "text": "Su provisión era de las sementeras que crecen con las muchas aguas del Nilo, de la mies del río. fue también emporio de las naciones.", "words": [[0, 19592], [3, 19731], [13, 20451], [17, 20811], [20, 20971], [24, 21421], [35, 21871], [39, 22071], [46, 22571], [50, 22771], [54, 22971], [61, 23251], [67, 23771], [71, 23931], [77, 24571], [80, 24831], [83, 24951], [88, 25311], [92, 25531], [97, 26423], [101, 26545], [109, 26885], [117, 27645], [120, 27765], [124, 27925]]}, {"verse": 4, "start": 29229, "end": 41320, "text": "Avergüénzate, Sidón, porque el mar, la fortaleza del mar habló, diciendo: Nunca estuve de parto, ni parí, ni crié jóvenes, ni levanté vírgenes.", "words": [[0, 29611], [14, 30031], [21, 30531], [28, 31091], [31, 31291], [36, 32071], [39, 32231], [49, 32831], [53, 32971], [57, 33231], [64, 33771], [74, 35125], [80, 35740], [87, 36160], [90, 36300], [97, 36840], [100, 37000], [106, 37680], [109, 37800], [114, 38200], [123, 39100], [126, 39220], [134, 39740]]}, {"verse": 5, "start": 41770, "end": 46368, "text": "Al llegar la fama a Egipto, tendrán dolor de las nuevas de Tiro.", "words": [[0, 41770], [3, 41943], [10, 42203], [13, 42463], [18, 42903], [20, 43043], [28, 44083], [36, 44643], [42, 44963], [45, 45183], [49, 45323], [56, 45583], [59, 45803]]}, {"verse": 6, "start": 46818, "end": 50589, "text": "Pasaos a Tarsis; aullad, habitantes de la isla.", "words": [[0, 46818], [7, 47283], [9, 47443], [17, 48912], [25, 49322], [36, 49802], [39, 49962], [42, 50299]]}, {"verse": 7, "start": 51039, "end": 58870, "text": "¿No era esta vuestra ciudad alegre, su antigüedad de muchos días? Sus pies la llevarán a morar lejos.", "words": [[0, 51039], [4, 51219], [8, 51479], [13, 51799], [21, 52279], [28, 52619], [36, 53819], [39, 53939], [50, 54719], [53, 54899], [60, 55139], [66, 56173], [70, 56291], [75, 56621], [78, 56951], [87, 57451], [89, 57611], [95, 58011]]}, {"verse": 8, "start": 59320, "end": 69014, "text": "¿Quién decretó esto sobre Tiro, la que repartía coronas, cuyos negociantes eran príncipes, cuyos mercaderes eran los nobles de la tierra?", "words": [[0, 59320], [7, 59545], [15, 60065], [20, 60245], [26, 60545], [32, 60985], [35, 61385], [39, 61545], [48, 62265], [57, 63425], [63, 63765], [75, 64505], [80, 64825], [91, 66085], [97, 66465], [108, 67185], [113, 67385], [117, 67585], [124, 68045], [127, 68185], [130, 68305]]}, {"verse": 9, "start": 69464, "end": 79596, "text": "Jehová de los ejércitos lo decretó, para envilecer la soberbia de toda gloria; y para abatir todos los ilustres de la tierra.", "words": [[0, 69464], [7, 70039], [10, 70119], [14, 70299], [24, 71139], [27, 71499], [36, 72619], [41, 73079], [51, 73819], [54, 74019], [63, 74619], [66, 74799], [71, 75019], [79, 75999], [81, 76265], [86, 76545], [93, 77285], [99, 77745], [103, 78084], [112, 78745], [115, 78845], [118, 78965]]}, {"verse": 10, "start": 80046, "end": 86424, "text": "Pasa cual río de tu tierra, oh hija de Tarsis; porque no tendrás ya más fortaleza.", "words": [[0, 80046], [5, 80313], [10, 80573], [14, 81053], [17, 81173], [20, 81353], [28, 81763], [31, 82173], [36, 82513], [39, 82633], [47, 83688], [54, 83914], [57, 84114], [65, 84674], [68, 85054], [72, 85354]]}, {"verse": 11, "start": 86874, "end": 96218, "text": "Extendió su mano sobre el mar, hizo temblar los reinos: Jehová mandó sobre Canaán que sus fuerzas sean debilitadas.", "words": [[0, 86874], [9, 87660], [12, 87840], [17, 88180], [23, 88580], [26, 88800], [31, 89540], [36, 89680], [44, 90220], [48, 90736], [56, 91488], [63, 92319], [69, 92719], [75, 93259], [82, 93799], [86, 94019], [90, 94199], [98, 94759], [103, 95059]]}, {"verse": 12, "start": 96668, "end": 107402, "text": "Y dijo: No te alegrarás más, oh tú, oprimida virgen hija de Sidón. Levántate para pasar a Quitim; y aun allí no tendrás reposo.", "words": [[0, 96668], [2, 96848], [8, 97531], [11, 97710], [14, 97870], [24, 98410], [29, 98710], [32, 99010], [36, 99750], [45, 100250], [52, 100850], [57, 101050], [60, 101190], [67, 102195], [77, 102861], [82, 103101], [88, 103424], [90, 103748], [98, 104595], [100, 104732], [104, 104912], [109, 105292], [112, 105612], [120, 106032]]}, {"verse": 13, "start": 108036, "end": 122158, "text": "Mira la tierra de los caldeos; este pueblo no era; Assur la fundó para los que habitaban en el desierto: levantaron sus fortalezas, edificaron sus palacios; él la convirtió en ruinas.", "words": [[0, 108142], [5, 108282], [8, 108422], [15, 108782], [18, 108982], [22, 109102], [31, 110180], [36, 110369], [43, 110669], [46, 110989], [51, 112001], [57, 112281], [60, 112421], [66, 112901], [71, 113121], [75, 113301], [79, 113481], [89, 113981], [92, 114141], [95, 114281], [105, 115388], [116, 116188], [120, 116428], [132, 117788], [143, 118388], [147, 118628], [157, 119868], [160, 120214], [163, 120534], [173, 121214], [176, 121334]]}, {"verse": 14, "start": 122608, "end": 128348, "text": "Aullad, naves de Tarsis; porque destruida es vuestra fortaleza.", "words": [[0, 122878], [8, 123178], [14, 123798], [17, 124018], [25, 125128], [32, 125392], [42, 126472], [45, 126812], [53, 127432]]}, {"verse": 15, "start": 128798, "end": 141642, "text": "Y acontecerá en aquel día, que Tiro será puesta en olvido por setenta años, como días de un rey. Después de los setenta años, cantará Tiro canción como de prostituta.", "words": [[0, 128798], [2, 128924], [13, 129744], [16, 129844], [22, 130184], [27, 130484], [31, 131264], [36, 131624], [41, 131904], [48, 132424], [51, 132564], [58, 133004], [62, 133294], [70, 133584], [76, 134264], [81, 134604], [86, 134904], [89, 135164], [92, 135324], [97, 136190], [105, 136450], [108, 136710], [112, 136980], [120, 137250], [126, 138050], [134, 138750], [139, 139070], [147, 139590], [152, 140350], [155, 140510]]}, {"verse": 16, "start": 142092, "end": 150939, "text": "Toma arpa, y rodea la ciudad, oh prostituta olvidada: haz buena melodía, repite la canción, para que seas recordada.", "words": [[0, 142092], [5, 142315], [11, 142895], [13, 143175], [19, 143695], [22, 143815], [30, 144195], [33, 144575], [44, 145375], [54, 146465], [58, 146730], [64, 147210], [73, 148130], [80, 148550], [83, 148710], [92, 149110], [97, 149670], [101, 149810], [106, 150386]]}, {"verse": 17, "start": 151389, "end": 165508, "text": "Y acontecerá, que al fin de los setenta años visitará Jehová a Tiro: y volverá a su ganancia, y otra vez fornicará con todos los reinos de la tierra sobre la haz de la tierra.", "words": [[0, 151389], [2, 151694], [14, 152534], [18, 152794], [21, 152874], [25, 153134], [28, 153294], [32, 153574], [40, 153854], [45, 154874], [54, 155594], [61, 156214], [63, 156334], [69, 157239], [71, 157386], [79, 157946], [81, 157966], [84, 158166], [94, 159786], [96, 159846], [101, 160026], [105, 160406], [115, 161226], [119, 161446], [125, 161806], [129, 162066], [136, 162626], [139, 162706], [142, 162846], [149, 163266], [155, 163926], [158, 164186], [162, 164526], [165, 164666], [168, 164786]]}, {"verse": 18, "start": 165958, "end": 181811, "text": "Pero sus negocios y ganancias serán consagrados a Jehová; no se guardarán ni se atesorarán, porque su negociación será para los que estén delante de Jehová, para que coman hasta hartarse, y vistan honradamente.", "words": [[0, 165958], [5, 166218], [9, 166398], [18, 167158], [20, 167358], [30, 167958], [36, 168438], [48, 169258], [50, 169458], [58, 170377], [61, 170522], [64, 170682], [74, 171322], [77, 171722], [80, 171942], [92, 173462], [99, 173782], [102, 174042], [114, 174922], [119, 175242], [124, 175562], [128, 175802], [132, 176002], [138, 176362], [146, 176742], [149, 176922], [157, 177502], [162, 177782], [166, 177962], [172, 178382], [178, 178642], [188, 179422], [190, 179882], [197, 180282]]}]}