{"book": "PSA", "chapter": 94, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 143635, "verses": [{"verse": 1, "start": 300, "end": 5179, "text": "Jehová, Dios de las venganzas, Dios de las venganzas, muéstrate.", "words": [[0, 300], [8, 1078], [13, 1318], [16, 1638], [20, 1778], [31, 2718], [36, 3198], [39, 3378], [43, 3518], [54, 4348]]}, {"verse": 2, "start": 5629, "end": 10990, "text": "Ensálzate, oh Juez de la tierra: da el pago a los soberbios.", "words": [[0, 6333], [11, 6783], [14, 7233], [19, 7653], [22, 7813], [25, 7933], [33, 8924], [36, 9129], [39, 9289], [44, 9849], [46, 9949], [50, 10069]]}, {"verse": 3, "start": 11440, "end": 17027, "text": "¿Hasta cuándo los impíos, hasta cuándo, oh Jehová, se gozarán los impíos?", "words": [[0, 11440], [7, 11780], [14, 12200], [18, 12750], [26, 13300], [32, 13580], [40, 14113], [43, 14647], [51, 15180], [54, 15320], [62, 15880], [66, 16475]]}, {"verse": 4, "start": 17477, "end": 25298, "text": "¿Hasta cuándo pronunciarán, hablarán cosas duras, y se vanagloriarán todos los que hacen iniquidad?", "words": [[0, 17477], [7, 17697], [14, 17997], [28, 19377], [37, 19857], [43, 20567], [50, 21277], [52, 21717], [55, 22357], [69, 22997], [75, 23357], [79, 23817], [83, 24017], [89, 24317]]}, {"verse": 5, "start": 25748, "end": 29966, "text": "A tu pueblo, oh Jehová, quebrantan, y a tu heredad afligen.", "words": [[0, 25748], [2, 25852], [5, 25952], [13, 26152], [16, 26352], [24, 27162], [36, 27972], [38, 28332], [40, 28432], [43, 28612], [51, 29132]]}, {"verse": 6, "start": 30416, "end": 35426, "text": "A la viuda y al extranjero matan, y a los huérfanos quitan la vida.", "words": [[0, 30416], [2, 30558], [5, 30698], [11, 31158], [13, 31318], [16, 31438], [27, 32138], [34, 32698], [36, 33558], [38, 33658], [42, 33758], [52, 34458], [59, 34818], [62, 34958]]}, {"verse": 7, "start": 35876, "end": 39601, "text": "Y dijeron: No verá JAH, ni entenderá el Dios de Jacob.", "words": [[0, 35876],