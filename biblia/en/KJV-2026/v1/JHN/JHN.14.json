{"book": "JHN", "chapter": 14, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 218555, "verses": [{"verse": 1, "start": 300, "end": 4461, "text": "Let not your heart be troubled: you believe in God, believe also in me.", "words": [[0, 300], [4, 478], [8, 698], [13, 879], [19, 1118], [22, 1258], [32, 2068], [36, 2209], [44, 2429], [47, 2649], [52, 3469], [60, 3529], [65, 3909], [68, 4129]]}, {"verse": 2, "start": 4911, "end": 11224, "text": "In my Father’s house are many mansions: if it were not so, I would have told you. I go to prepare a place for you.", "words": [[0, 4911], [3, 5014], [6, 5134], [15, 5574], [21, 5774], [25, 5974], [30, 6194], [40, 7216], [43, 7358], [46, 7458], [51, 7538], [55, 7718], [59, 8238], [61, 8338], [67, 8458], [72, 8538], [77, 8738], [82, 9407], [84, 9572], [87, 9792], [90, 9952], [98, 10232], [100, 10432], [106, 10672], [110, 10952]]}, {"verse": 3, "start": 11674, "end": 19254, "text": "And if I go and prepare a place for you, I will come again, and receive you to myself; that where I am, there you may be also.", "words": [[0, 11674], [4, 11751], [7, 11891], [9, 12051], [12, 12291], [16, 12511], [24, 12791], [26, 12931], [32, 13171], [36, 13431], [41, 13951], [43, 14171], [48, 14311], [53, 14511], [60, 14831], [64, 15171], [72, 15491], [76, 15711], [79, 15851], [87, 16668], [92, 16799], [98, 17019], [100, 17299], [104, 17899], [110, 18159], [114, 18339], [118, 18519], [121, 18679]]}, {"verse": 4, "start": 19704, "end": 22247, "text": "And where I go you know, and the way you know.", "words": [[0, 19704], [4, 19806], [10, 19986], [12, 20206], [15, 20406], [19, 20626], [25, 21246], [29, 21366], [33, 21486], [37, 21626], [41, 21826]]}, {"verse": 5, "start": 22597, "end": 27116, "text": "Thomas says to him, Lord, we know not where you go; and how can we know the way?", "words": [[0, 22717], [7, 22837], [12, 23117], [15, 23377], [20, 23955], [26, 24339], [29, 24399], [34, 24579], [38, 24779], [44, 25039], [48, 25199], [52, 25909], [56, 26008], [60, 26188], [64, 26388], [67, 26488], [72, 26648], [76, 26788]]}, {"verse": 6, "start": 27466, "end": 35121, "text": "Jesus says to him, I am the way, the truth, and the life: no man comes to the Father, but by me.", "words": [[0, 27466], [6, 27721], [11, 28061], [14, 28301], [19, 29647], [21, 29869], [24, 30009], [28, 30149], [33, 30769], [37, 30849], [44, 31589], [48, 31749], [52, 31889], [58, 32718], [61, 32902], [65, 33142], [71, 33482], [74, 33722], [78, 33842], [86, 34142], [90, 34462], [93, 34702]]}, {"verse": 7, "start": 35571, "end": 42065, "text": "If you had known me, you should have known my Father also: and from now on you know him, and have seen him.", "words": [[0, 35571], [3, 35708], [7, 35888], [11, 36048], [17, 36248], [21, 36808], [25, 36948], [32, 37108], [37, 37248], [43, 37468], [46, 37688], [53, 37988], [59, 39030], [63, 39155], [68, 39335], [72, 39595], [75, 39955], [79, 40115], [84, 40315], [89, 40575], [93, 41155], [98, 41395], [103, 41635]]}, {"verse": 8, "start": 42415, "end": 46975, "text": "Philip says to him, Lord, show us the Father, and it suffices us.", "words": [[0, 42415], [7, 42655], [12, 42935], [15, 43175], [20, 44357], [26, 44601], [31, 44921], [34, 45121], [38, 45241], [46, 45521], [50, 45881], [53, 46001], [62, 46521]]}, {"verse": 9, "start": 47325, "end": 58974, "text": "Jesus says to him, Have I been so long time with you, and yet have you not known me, Philip? he that has seen me has seen the Father; and how do you say then, Show us the Father?", "words": [[0, 47325], [6, 47580], [11, 47920], [14, 48160], [19, 49505], [24, 49629], [26, 49729], [31, 49929], [34, 50209], [39, 50449], [44, 50749], [49, 51009], [54, 51729], [58, 51849], [62, 52049], [67, 52289], [71, 52429], [75, 52649], [81, 52929], [85, 53169], [93, 53960], [96, 54151], [101, 54411], [105, 54571], [110, 54851], [113, 55091], [117, 55311], [122, 55551], [126, 55671], [134, 56481], [138, 56620], [142, 56780], [145, 56900], [149, 57000], [153, 57200], [159, 57740], [164, 58120], [167, 58300], [171, 58440]]}, {"verse": 10, "start": 59424, "end": 69239, "text": "Do you not believe that I am in the Father, and the Father in me? the words that I speak to you I speak not of myself: but the Father that dwells in me, he does the works.", "words": [[0, 59424], [3, 59507], [7, 59627], [11, 59767], [19, 60167], [24, 60387], [26, 60567], [29, 60687], [32, 60807], [36, 60907], [44, 61247], [48, 61827], [52, 61987], [59, 62207], [62, 62447], [66, 63141], [70, 63223], [76, 63503], [81, 63743], [83, 63883], [89, 64143], [92, 64383], [96, 64723], [98, 64823], [104, 65083], [108, 65343], [111, 65503], [119, 66396], [123, 66498], [127, 66618], [134, 66918], [139, 67158], [146, 67598], [149, 67698], [153, 68178], [156, 68258], [161, 68478], [165, 68658]]}, {"verse": 11, "start": 69689, "end": 75356, "text": "Believe me that I am in the Father, and the Father in me: or else believe me for the very works’ sake.", "words": [[0, 69689], [8, 69973], [11, 70273], [16, 70493], [18, 70633], [21, 70733], [24, 70853], [28, 70953], [36, 71713], [40, 71813], [44, 71953], [51, 72233], [54, 72473], [58, 73117], [61, 73238], [66, 73398], [74, 73718], [77, 74018], [81, 74178], [85, 74298], [90, 74518], [97, 74918]]}, {"verse": 12, "start": 75806, "end": 85572, "text": "Most assuredly, I say to you, He that believes on me, the works that I do shall he do also; and greater works than these shall he do; because I go to my Father.", "words": [[0, 75806], [5, 75990], [16, 76610], [18, 76730], [22, 76970], [25, 77170], [30, 77670], [33, 77930], [38, 78190], [47, 78510], [50, 78790], [54, 79290], [58, 79390], [64, 79630], [69, 79850], [71, 79970], [74, 80170], [80, 80390], [83, 80590], [86, 80790], [92, 81809], [96, 81933], [104, 82173], [110, 82473], [115, 82693], [121, 82953], [127, 83193], [130, 83353], [134, 84062], [142, 84402], [144, 84562], [147, 84722], [150, 84862], [153, 85022]]}, {"verse": 13, "start": 86022, "end": 91140, "text": "And whatever you shall ask in my name, that will I do, that the Father may be glorified in the Son.", "words": [[0, 86022], [4, 86129], [13, 86409], [17, 86629], [23, 86809], [27, 87109], [30, 87249], [33, 87449], [39, 87989], [44, 88209], [49, 88369], [51, 88549], [55, 89009], [60, 89209], [64, 89329], [71, 89589], [75, 89809], [78, 89909], [88, 90449], [91, 90609], [95, 90709]]}, {"verse": 14, "start": 91590, "end": 94238, "text": "If you shall ask any thing in my name, I will do it.", "words": [[0, 91590], [3, 91712], [7, 91832], [13, 91992], [17, 92179], [21, 92365], [27, 92552], [30, 92812], [33, 92972], [39, 93512], [41, 93632], [46, 93772], [49, 93952]]}, {"verse": 15, "start": 94688, "end": 96858, "text": "¶ If you love me, keep my commandments.", "words": [[2, 94688], [5, 94829], [9, 94949], [14, 95189], [18, 95649], [23, 95809], [26, 96009]]}, {"verse": 16, "start": 97308, "end": 102263, "text": "And I will pray the Father, and he shall give you another Comforter, that he may abide with you for ever;", "words": [[0, 97308], [4, 97389], [6, 97529], [11, 97648], [16, 97868], [20, 98008], [28, 98748], [32, 98828], [35, 98968], [41, 99128], [46, 99328], [50, 99428], [58, 99688], [69, 100449], [74, 100589], [77, 100748], [81, 100889], [87, 101248], [92, 101468], [96, 101628], [100, 101809]]}, {"verse": 17, "start": 102713, "end": 113675, "text": "Even the Spirit of truth; whom the world cannot receive, because it sees him not, neither knows him: but you know him; for he dwells with you, and shall be in you.", "words": [[0, 102713], [5, 103095], [9, 103275], [16, 103555], [19, 103715], [26, 104825], [31, 105005], [35, 105185], [41, 105505], [48, 105825], [57, 106685], [65, 107185], [68, 107365], [73, 107605], [77, 107825], [82, 108445], [90, 108665], [96, 109065], [101, 109827], [105, 109933], [109, 110133], [114, 110373], [119, 111161], [123, 111266], [126, 111426], [133, 111866], [138, 112026], [143, 112226], [147, 112546], [153, 112826], [156, 113066], [159, 113286]]}, {"verse": 18, "start": 114125, "end": 117467, "text": "I will not leave you comfortless: I will come to you.", "words": [[0, 114125], [2, 114423], [7, 114543], [11, 114723], [17, 115003], [21, 115223], [34, 116420], [36, 116606], [41, 116746], [46, 116966], [49, 117166]]}, {"verse": 19, "start": 117917, "end": 124476, "text": "Yet a little while, and the world sees me no more; but you see me: because I live, you shall live also.", "words": [[0, 117917], [4, 118037], [6, 118157], [13, 118337], [20, 118677], [24, 119197], [28, 119317], [34, 119577], [39, 119897], [42, 120097], [45, 120317], [51, 121129], [55, 121214], [59, 121354], [63, 121634], [67, 122314], [75, 122498], [77, 122718], [83, 123338], [87, 123478], [93, 123638], [98, 123858]]}, {"verse": 20, "start": 124926, "end": 129286, "text": "At that day you shall know that I am in my Father, and you in me, and I in you.", "words": [[0, 124926], [3, 125035], [8, 125235], [12, 125475], [16, 125655], [22, 125815], [27, 126015], [32, 126195], [34, 126315], [37, 126435], [40, 126515], [43, 126675], [51, 127455], [55, 127535], [59, 127715], [62, 127875], [66, 128435], [70, 128535], [72, 128735], [75, 128935]]}, {"verse": 21, "start": 129736, "end": 140818, "text": "He that has my commandments, and keeps them, he it is that loves me: and he that loves me shall be loved of my Father, and I will love him, and will manifest myself to him.", "words": [[0, 129736], [3, 129844], [8, 130004], [12, 130224], [15, 130384], [29, 130844], [33, 131384], [39, 131664], [45, 132264], [48, 132444], [51, 132764], [54, 133044], [59, 133264], [65, 133484], [69, 134175], [73, 134316], [76, 134536], [81, 134756], [87, 135036], [90, 135316], [96, 135656], [99, 135816], [105, 136116], [108, 136296], [111, 136476], [119, 137236], [123, 137496], [125, 137676], [130, 137836], [135, 138096], [140, 138876], [144, 138976], [149, 139136], [158, 139596], [165, 140176], [168, 140416]]}, {"verse": 22, "start": 141168, "end": 147865, "text": "Judas says to him, not Iscariot, Lord, how is it that you will manifest yourself to us, and not to the world?", "words": [[0, 141168], [6, 141367], [11, 141727], [14, 141947], [19, 142447], [23, 142687], [33, 143776], [39, 144225], [43, 144365], [46, 144605], [49, 144765], [54, 144945], [58, 145125], [63, 145265], [72, 145705], [81, 146185], [84, 146465], [88, 146705], [92, 146905], [96, 147125], [99, 147325], [103, 147425]]}, {"verse": 23, "start": 148215, "end": 156898, "text": "Jesus answered and said to him, If a man love me, he will keep my words: and my Father will love him, and we will come to him, and make our abode with him.", "words": [[0, 148215], [6, 148445], [15, 149005], [19, 149205], [24, 149425], [27, 149625], [32, 150163], [35, 150293], [37, 150393], [41, 150653], [46, 150893], [50, 151473], [53, 151573], [58, 151693], [63, 151893], [66, 152113], [73, 153000], [77, 153099], [80, 153219], [87, 153499], [92, 153719], [97, 153999], [102, 154339], [106, 154499], [109, 154619], [114, 154759], [119, 154979], [122, 155179], [127, 155399], [131, 155659], [136, 155859], [140, 156019], [146, 156359], [151, 156579]]}, {"verse": 24, "start": 157348, "end": 163937, "text": "He that loves me not keeps not my sayings: and the word which you hear is not mine, but the Father’s which sent me.", "words": [[0, 157348], [3, 157463], [8, 157643], [14, 157883], [17, 158103], [21, 158343], [27, 159163], [31, 159343], [34, 159523], [43, 160524], [47, 160641], [51, 160741], [56, 160941], [62, 161121], [66, 161301], [71, 161541], [74, 161681], [78, 161861], [84, 162441], [88, 162681], [92, 162801], [101, 163121], [107, 163381], [112, 163621]]}, {"verse": 25, "start": 164387, "end": 167953, "text": "These things have I spoken to you, being yet present with you.", "words": [[0, 164387], [6, 164543], [13, 164883], [18, 165103], [20, 165243], [27, 165563], [30, 165863], [35, 166403], [41, 166643], [45, 166923], [53, 167303], [58, 167583]]}, {"verse": 26, "start": 168403, "end": 178128, "text": "But the Comforter, which is the Holy Spirit, whom the Father will send in my name, he shall teach you all things, and bring all things to your remembrance, whatever I have said to you.", "words": [[0, 168403], [4, 168510], [8, 168630], [19, 169090], [25, 169270], [28, 169390], [32, 169510], [37, 169790], [45, 170570], [50, 170790], [54, 170930], [61, 171190], [66, 171390], [71, 171650], [74, 171790], [77, 171950], [83, 172710], [86, 172790], [92, 172970], [98, 173230], [102, 173410], [106, 173670], [114, 174390], [118, 174570], [124, 174710], [128, 175010], [135, 175350], [138, 175570], [143, 175730], [156, 176842], [165, 177087], [167, 177327], [172, 177427], [177, 177627], [180, 177807]]}, {"verse": 27, "start": 178578, "end": 186943, "text": "Peace I leave with you, my peace I give to you: not as the world gives, give I to you. Let not your heart be troubled, neither let it be afraid.", "words": [[0, 178578], [6, 178779], [8, 178999], [14, 179199], [19, 179439], [24, 179839], [27, 179979], [33, 180279], [35, 180499], [40, 180679], [43, 180859], [48, 181519], [52, 181658], [55, 181818], [59, 181938], [65, 182158], [72, 182678], [77, 182918], [79, 183078], [82, 183278], [87, 184011], [91, 184173], [95, 184373], [100, 184553], [106, 184773], [109, 184933], [119, 185693], [127, 185853], [131, 186113], [134, 186213], [137, 186353]]}, {"verse": 28, "start": 187393, "end": 197428, "text": "You have heard how I said to you, I go away, and come again to you. If you loved me, you would rejoice, because I said, I go to the Father: for my Father is greater than I.", "words": [[0, 187393], [4, 187500], [9, 187620], [15, 187820], [19, 187960], [21, 188100], [26, 188320], [29, 188480], [34, 188960], [36, 189100], [39, 189300], [45, 189620], [49, 189940], [54, 190160], [60, 190380], [63, 190620], [68, 191168], [71, 191300], [75, 191420], [81, 191700], [85, 192260], [89, 192380], [95, 192500], [104, 192880], [112, 193420], [114, 193660], [120, 194280], [122, 194480], [125, 194660], [128, 194760], [132, 194880], [140, 195732], [144, 195838], [147, 195978], [154, 196298], [157, 196538], [165, 196798], [170, 197078]]}, {"verse": 29, "start": 197878, "end": 203626, "text": "And now I have told you before it come to pass, that, when it is come to pass, you might believe.", "words": [[0, 197878], [4, 198022], [8, 198302], [10, 198542], [15, 198662], [20, 198942], [24, 199182], [31, 199482], [34, 199662], [39, 199842], [42, 199962], [48, 200662], [54, 201022], [59, 201522], [62, 201652], [65, 201782], [70, 201982], [73, 202102], [79, 202662], [83, 202762], [89, 202942]]}, {"verse": 30, "start": 204076, "end": 209890, "text": "Hereafter I will not talk much with you: for the prince of this world comes, and has nothing in me.", "words": [[0, 204076], [10, 204960], [12, 205060], [17, 205200], [21, 205380], [26, 205660], [31, 205880], [36, 206120], [41, 206780], [45, 206890], [49, 206990], [56, 207290], [59, 207490], [64, 207690], [70, 207970], [77, 208410], [81, 208850], [85, 209050], [93, 209370], [96, 209590]]}, {"verse": 31, "start": 210340, "end": 218155, "text": "But that the world may know that I love the Father; and as the Father gave me commandment, even so I do. Arise, let us go from here.", "words": [[0, 210340], [4, 210422], [9, 210542], [13, 210682], [19, 210942], [23, 211142], [28, 211402], [33, 211622], [35, 211742], [40, 212022], [44, 212242], [52, 213060], [56, 213162], [59, 213282], [63, 213422], [70, 213682], [75, 213942], [78, 214142], [91, 214902], [96, 215082], [99, 215362], [101, 215542], [105, 216241], [112, 216837], [116, 217037], [119, 217197], [122, 217437], [127, 217677]]}]}