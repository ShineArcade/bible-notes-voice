{"book": "PSA", "chapter": 80, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 125120, "verses": [{"verse": 1, "start": 300, "end": 12611, "text": "Al Músico principal: sobre Sosannim Eduth: Salmo de Asaf. OH Pastor de Israel, escucha: tú que pastoreas como a ovejas a José, que estás entre querubines, resplandece.", "words": [[0, 300], [3, 444], [10, 924], [21, 2084], [27, 2650], [36, 3256], [43, 4083], [49, 4525], [52, 4685], [58, 5344], [61, 5424], [68, 5784], [71, 6084], [79, 6833], [88, 7604], [91, 7664], [95, 7824], [105, 8484], [110, 8758], [112, 9031], [119, 9304], [121, 9404], [127, 10064], [131, 10144], [137, 10324], [143, 10644], [155, 11604]]}, {"verse": 2, "start": 12961, "end": 20189, "text": "Despierta tu valentía delante de Efraín, y de Benjamín, y de Manasés, y ven a salvarnos.", "words": [[0, 12961], [10, 13664], [13, 13844], [22, 14484], [30, 14944], [33, 15124], [41, 15884], [43, 16084], [46, 16204], [56, 16564], [58, 17064], [61, 17444], [70, 17824], [72, 18224], [76, 18364], [78, 18484]]}, {"verse": 3, "start": 20539, "end": 26573, "text": "Oh Dios, haznos volver; y haz resplandecer tu rostro, y seremos salvos.", "words": [[0, 20630], [3, 20750], [9, 20870], [16, 20990], [24, 22498], [26, 22818], [30, 22998], [43, 24198], [46, 24498], [54, 25138], [56, 25458], [64, 25818]]}, {"verse": 4, "start": 26923, "end": 33258, "text": "Jehová, Dios de los ejércitos, ¿hasta cuándo humearás tú contra la oración de tu pueblo?", "words": [[0, 27141], [8, 27395], [13, 27648], [16, 27768], [20, 27928], [31, 29248], [38, 29668], [45, 30248], [54, 30788], [57, 31028], [64, 31468], [67, 31708], [75, 32248], [78, 32428], [81, 32548]]}, {"verse": 5, "start": 33608, "end": 39084, "text": "Les diste a comer pan de lágrimas, y les diste a beber lágrimas en gran abundancia.", "words": [[0, 33608], [4, 33772], [10, 34172], [12, 34252], [18, 34532], [22, 34992], [25, 35192], [35, 35852], [37, 36172], [41, 36292], [47, 36652], [49, 36712], [55, 36912], [64, 37612], [67, 37832], [72, 38012]]}, {"verse": 6, "start": 39434, "end": 45225, "text": "Nos pusiste por contienda a nuestros vecinos: y nuestros enemigos se burlan entre sí.", "words": [[0, 39434], [4, 39559], [12, 40099], [16, 40339], [26, 41059], [28, 41359], [37, 41519], [46, 42677], [48, 42777], [57, 43017], [66, 43697], [69, 43897], [76, 44357], [82, 44737]]}, {"verse": 7, "start": 45575, "end": 52725, "text": "Oh Dios de los ejércitos, haznos volver; y haz resplandecer tu rostro, y seremos salvos.", "words": [[0, 45650], [3, 45760], [8, 46080], [11, 46420], [15, 46560], [26, 47210], [33, 47860], [41, 48649], [43, 48970], [47, 49150], [60, 50350], [63, 50650], [71, 51290], [73, 51610], [81, 51970]]}, {"verse": 8, "start": 53075, "end": 57953, "text": "Hiciste venir una vid de Egipto: echaste las naciones, y la plantaste.", "words": [[0, 53075], [8, 53579], [14, 53819], [18, 54099], [22, 54299], [25, 54559], [33, 55509], [41, 56035], [45, 56215], [55, 56755], [57, 56995], [60, 57095]]}, {"verse": 9, "start": 58303, "end": 64631, "text": "Limpiaste sitio delante de ella, e hiciste arraigar sus raíces, y llenó la tierra.", "words": [[0, 58303], [10, 59243], [16, 59723], [24, 60283], [27, 60503], [33, 60823], [35, 61043], [43, 61703], [52, 62303], [56, 62463], [64, 63143], [66, 63543], [72, 63883], [75, 63963]]}, {"verse": 10, "start": 64981, "end": 70350, "text": "Los montes fueron cubiertos de su sombra; y sus sarmientos como cedros de Dios.", "words": [[0, 64981], [4, 65181], [11, 65661], [18, 65921], [28, 66701], [31, 66821], [34, 66961], [42, 67861], [44, 67971], [48, 68391], [59, 68811], [64, 69091], [71, 69671], [74, 69791]]}, {"verse": 11, "start": 70700, "end": 74942, "text": "Extendió sus vástagos hasta el mar, y hasta el río sus renuevos.", "words": [[0, 70700], [9, 71426], [13, 71626], [22, 72366], [28, 72566], [31, 72766], [36, 72986], [38, 73226], [44, 73446], [47, 73666], [51, 73966], [55, 74146]]}, {"verse": 12, "start": 75292, "end": 80752, "text": "¿Por qué rompiste sus vallados, y la vendimian todos los que pasan por el camino?", "words": [[0, 75292], [5, 75418], [9, 75638], [18, 76398], [22, 76618], [32, 77258], [34, 77778], [37, 78208], [47, 78638], [53, 78938], [57, 79218], [61, 79398], [67, 79818], [71, 79998], [74, 80138]]}, {"verse": 13, "start": 81102, "end": 85039, "text": "La estropeó el jabalí, y la comió la bestia del campo.", "words": [[0, 81102], [3, 81265], [12, 82025], [15, 82145], [23, 82745], [25, 83125], [28, 83245], [34, 83645], [37, 83805], [44, 84205], [48, 84365]]}, {"verse": 14, "start": 85389, "end": 92440, "text": "Oh Dios de los ejércitos, vuelve ahora: mira desde el cielo, y considera, y visita esta viña,", "words": [[0, 85461], [3, 85571], [8, 85811], [11, 86111], [15, 86271], [26, 87031], [33, 87751], [40, 88501], [45, 88849], [51, 89109], [54, 89369], [61, 89789], [63, 90029], [74, 90969], [76, 91109], [83, 91569], [88, 91769]]}, {"verse": 15, "start": 92790, "end": 97570, "text": "Y la planta que plantó tu diestra, y el renuevo que para ti afirmaste.", "words": [[0, 92790], [2, 92892], [5, 93012], [12, 93432], [16, 93532], [23, 93992], [26, 94112], [35, 94692], [37, 95017], [40, 95197], [48, 95877], [52, 96017], [57, 96297], [60, 96557]]}, {"verse": 16, "start": 97920, "end": 103153, "text": "Quemada a fuego está, asolada: perezcan por la reprensión de tu rostro.", "words": [[0, 97920], [8, 98124], [10, 98364], [16, 98704], [22, 99104], [31, 100404], [40, 101071], [44, 101291], [47, 101711], [58, 102131], [61, 102351], [64, 102471]]}, {"verse": 17, "start": 103503, "end": 110809, "text": "Sea tu mano sobre el varón de tu diestra, sobre el hijo del hombre que para ti corroboraste.", "words": [[0, 103503], [4, 103726], [7, 103966], [12, 104266], [18, 104626], [21, 104846], [27, 105246], [30, 105346], [33, 105526], [42, 106586], [48, 107106], [51, 107446], [56, 107726], [60, 107966], [67, 108366], [71, 108846], [76, 109106], [79, 109426]]}, {"verse": 18, "start": 111159, "end": 116198, "text": "Así no nos volveremos de ti: vida nos darás, e invocaremos tu nombre.", "words": [[0, 111159], [4, 111385], [7, 111625], [11, 111765], [22, 112405], [25, 112565], [29, 113105], [34, 113472], [38, 113612], [45, 114172], [47, 114752], [59, 115412], [62, 115612]]}, {"verse": 19, "start": 116548, "end": 124720, "text": "Oh Jehová, Dios de los ejércitos, haznos volver; haz resplandecer tu rostro, y seremos salvos.", "words": [[0, 116548], [3, 116855], [11, 117875], [16, 118155], [19, 118415], [23, 118555], [34, 119695], [41, 120175], [49, 121140], [53, 121890], [66, 122640], [69, 122840], [77, 123420], [79, 123740], [87, 124160]]}]}