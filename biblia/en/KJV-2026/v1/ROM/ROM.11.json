{"book": "ROM", "chapter": 11, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 252524, "verses": [{"verse": 1, "start": 300, "end": 9272, "text": "I say then, Has God cast away his people? God forbid. For I also am an Israelite, of the seed of Abraham, of the tribe of Benjamin.", "words": [[0, 300], [2, 444], [6, 704], [12, 964], [16, 1204], [20, 1444], [25, 1764], [30, 2004], [34, 2224], [42, 3088], [46, 3293], [54, 4181], [58, 4321], [60, 4541], [65, 4901], [68, 5141], [71, 5261], [82, 5901], [85, 6401], [89, 6541], [94, 6801], [97, 6961], [106, 7401], [109, 8001], [113, 8141], [119, 8481], [122, 8621]]}, {"verse": 2, "start": 9722, "end": 18633, "text": "God has not cast away his people which he foreknew. Do you not know what the scripture says of Elias? how he makes intercession to God against Israel, saying,", "words": [[0, 9722], [4, 9977], [8, 10217], [12, 10417], [17, 10697], [22, 10977], [26, 11257], [33, 11637], [39, 11877], [42, 11997], [52, 12916], [55, 13013], [59, 13113], [63, 13253], [68, 13433], [73, 13593], [77, 13713], [87, 14033], [92, 14373], [95, 14778], [102, 15429], [106, 15575], [109, 15715], [115, 15915], [128, 16655], [131, 16855], [135, 17115], [143, 17375], [151, 18175]]}, {"verse": 3, "start": 19083, "end": 24828, "text": "Lord, they have killed your prophets, and dug down your altars; and I am left alone, and they seek my life.", "words": [[0, 19083], [6, 19602], [11, 19722], [16, 19902], [23, 20162], [28, 20342], [38, 20702], [42, 21202], [46, 21362], [51, 21622], [56, 21802], [64, 22712], [68, 22830], [70, 22970], [73, 23070], [78, 23270], [85, 23630], [89, 24010], [94, 24130], [99, 24330], [102, 24530]]}, {"verse": 4, "start": 25278, "end": 32712, "text": "But what says the answer of God to him? I have reserved to myself seven thousand men, who have not bowed the knee to the image of Baal.", "words": [[0, 25278], [4, 25359], [9, 25499], [14, 25679], [18, 25859], [25, 26079], [28, 26239], [32, 26419], [35, 26619], [40, 27279], [42, 27457], [47, 27597], [56, 27937], [59, 28137], [66, 28544], [72, 28950], [81, 29357], [86, 29697], [90, 30237], [95, 30357], [99, 30517], [105, 30897], [109, 30977], [114, 31177], [117, 31357], [121, 31497], [127, 31777], [130, 32122]]}, {"verse": 5, "start": 33012, "end": 37931, "text": "Even so then at this present time also there is a remnant according to the election of grace.", "words": [[0, 33012], [5, 33197], [8, 33457], [13, 33697], [16, 33877], [21, 34037], [29, 34417], [34, 34797], [39, 35157], [45, 35437], [48, 35597], [50, 35737], [58, 36177], [68, 36537], [71, 36817], [75, 36917], [84, 37237], [87, 37417]]}, {"verse": 6, "start": 38381, "end": 48515, "text": "And if by grace, then is it no more of works: otherwise grace is no more grace. But if it be of works, then is it no more grace: otherwise work is no more work.", "words": [[0, 38381], [4, 38506], [7, 38606], [10, 38826], [17, 39466], [22, 39706], [25, 39866], [28, 40006], [31, 40186], [36, 40466], [39, 40586], [46, 41436], [56, 42046], [62, 42266], [65, 42546], [68, 42726], [73, 42946], [80, 43786], [84, 43909], [87, 44049], [90, 44149], [93, 44329], [96, 44719], [103, 45109], [108, 45329], [111, 45489], [114, 45589], [117, 45749], [122, 45969], [129, 46804], [139, 47147], [144, 47487], [147, 47687], [150, 47887], [155, 48087]]}, {"verse": 7, "start": 48965, "end": 55712, "text": "What then? Israel has not obtained that which he seeks for; but the election has obtained it, and the rest were blinded", "words": [[0, 48965], [5, 49128], [11, 49823], [18, 50163], [22, 50383], [26, 50643], [35, 51203], [40, 51703], [46, 51923], [49, 52043], [55, 52263], [60, 52976], [64, 53102], [68, 53222], [77, 53542], [81, 53802], [90, 54202], [94, 54442], [98, 54702], [102, 54842], [107, 55002], [112, 55162]]}, {"verse": 8, "start": 56162, "end": 64382, "text": "(According as it is written, God has given them the spirit of slumber, eyes that they should not see, and ears that they should not hear;) to this day.", "words": [[0, 56162], [11, 56466], [14, 56726], [17, 56846], [20, 56966], [29, 57286], [33, 57846], [37, 58126], [43, 58386], [48, 58646], [52, 58826], [59, 59106], [62, 59326], [71, 59806], [76, 60366], [81, 60626], [86, 60766], [93, 60906], [97, 61106], [102, 61466], [106, 61926], [111, 62226], [116, 62486], [121, 62666], [128, 62806], [132, 63026], [139, 63406], [142, 63826], [147, 64026]]}, {"verse": 9, "start": 64832, "end": 71262, "text": "And David says, Let their table be made a snare, and a trap, and a stumblingblock, and a recompence to them:", "words": [[0, 64832], [4, 64957], [10, 65177], [16, 65984], [20, 66136], [26, 66316], [32, 66676], [35, 66876], [40, 67076], [42, 67296], [49, 68056], [53, 68136], [55, 68236], [61, 68936], [65, 68996], [67, 69516], [83, 70036], [87, 70116], [89, 70456], [100, 70796], [103, 70956]]}, {"verse": 10, "start": 71712, "end": 76192, "text": "Let their eyes be darkened, that they may not see, and bow down their back always.", "words": [[0, 71712], [4, 71874], [10, 72074], [15, 72374], [18, 72574], [28, 73114], [33, 73374], [38, 73554], [42, 73674], [46, 73794], [51, 74114], [55, 74534], [59, 74774], [64, 74974], [70, 75174], [75, 75454]]}, {"verse": 11, "start": 76642, "end": 84500, "text": "I say then, Have they stumbled that they should fall? God forbid: but rather through their fall salvation is come to the Gentiles, to provoke them to jealousy.", "words": [[0, 76642], [2, 76789], [6, 77009], [12, 77209], [17, 77389], [22, 77529], [31, 77829], [36, 78129], [41, 78269], [48, 78349], [54, 79099], [58, 79276], [66, 80166], [70, 80270], [77, 80550], [85, 80830], [91, 81070], [96, 81310], [106, 81810], [109, 82030], [114, 82210], [117, 82350], [121, 82450], [131, 83010], [134, 83190], [142, 83470], [147, 83710], [150, 83850]]}, {"verse": 12, "start": 84950, "end": 91745, "text": "Now if the fall of them be the riches of the world, and the diminishing of them the riches of the Gentiles; how much more their fulness?", "words": [[0, 84950], [4, 85227], [7, 85467], [11, 85607], [16, 85827], [19, 85927], [24, 86087], [27, 86227], [31, 86367], [38, 86587], [41, 86787], [45, 86867], [52, 87147], [56, 87587], [60, 87707], [72, 88187], [75, 88347], [80, 88487], [84, 88647], [91, 88927], [94, 89127], [98, 89227], [108, 90396], [112, 90539], [117, 90759], [122, 90959], [128, 91379]]}, {"verse": 13, "start": 92195, "end": 97787, "text": "For I speak to you Gentiles, inasmuch as I am the apostle of the Gentiles, I magnify my office:", "words": [[0, 92195], [4, 92302], [6, 92462], [12, 92722], [15, 92982], [19, 93102], [29, 93722], [38, 94402], [41, 94582], [43, 94762], [46, 94862], [50, 94982], [58, 95462], [61, 95542], [65, 95642], [75, 96222], [77, 96442], [85, 97002], [88, 97202]]}, {"verse": 14, "start": 98237, "end": 103443, "text": "If by any means I may provoke to emulation them which are my flesh, and might save some of them.", "words": [[0, 98237], [3, 98374], [6, 98554], [10, 98814], [16, 99174], [18, 99374], [22, 99574], [30, 99974], [33, 100174], [43, 100594], [48, 100854], [54, 101054], [58, 101194], [61, 101314], [68, 101614], [72, 102214], [78, 102454], [83, 102734], [88, 103014], [91, 103154]]}, {"verse": 15, "start": 103893, "end": 110351, "text": "For if the casting away of them be the reconciling of the world, what shall the receiving of them be, but life from the dead?", "words": [[0, 103893], [4, 104015], [7, 104155], [11, 104295], [19, 104635], [24, 104955], [27, 105195], [32, 105375], [35, 105595], [39, 105755], [51, 106455], [54, 106555], [58, 106675], [65, 107295], [70, 107575], [76, 107795], [80, 107915], [90, 108255], [93, 108475], [98, 108635], [102, 108895], [106, 109295], [111, 109575], [116, 109815], [120, 109975]]}, {"verse": 16, "start": 110801, "end": 116697, "text": "For if the firstfruit be holy, the lump is also holy: and if the root be holy, so are the branches.", "words": [[0, 110801], [4, 110931], [7, 111051], [11, 111361], [22, 111671], [25, 111851], [31, 112611], [35, 112761], [40, 112911], [43, 113091], [48, 113411], [54, 114173], [58, 114296], [61, 114396], [65, 114536], [70, 114696], [73, 114856], [79, 115516], [82, 115636], [86, 115896], [90, 116016]]}, {"verse": 17, "start": 117147, "end": 126457, "text": "And if some of the branches be broken off, and you, being a wild olive tree, wert grafted in among them, and with them partake of the root and fatness of the olive tree;", "words": [[0, 117147], [4, 117276], [7, 117376], [12, 117616], [15, 117736], [19, 117856], [28, 118216], [31, 118456], [38, 118756], [43, 119396], [47, 119556], [52, 120036], [58, 120236], [60, 120396], [65, 120636], [71, 120956], [77, 121386], [82, 121816], [90, 122396], [93, 122476], [99, 122676], [105, 123400], [109, 123537], [114, 123717], [119, 123937], [127, 124417], [130, 124537], [134, 124657], [139, 124877], [143, 125097], [151, 125537], [154, 125697], [158, 125817], [164, 126037]]}, {"verse": 18, "start": 126907, "end": 131569, "text": "Boast not against the branches. But if you boast, you bear not the root, but the root you.", "words": [[0, 127007], [6, 127107], [10, 127407], [18, 127627], [22, 127827], [32, 128755], [36, 128837], [39, 128957], [43, 129037], [50, 129497], [54, 129557], [59, 129797], [63, 129977], [67, 130177], [73, 130597], [77, 130717], [81, 130877], [86, 131117]]}, {"verse": 19, "start": 132019, "end": 135790, "text": "You will say then, The branches were broken off, that I might be grafted in.", "words": [[0, 132019], [4, 132158], [9, 132278], [13, 132498], [19, 132778], [23, 133138], [32, 133518], [37, 133758], [44, 134078], [49, 134378], [54, 134658], [56, 134758], [62, 134978], [65, 135138], [73, 135578]]}, {"verse": 20, "start": 136240, "end": 142150, "text": "Well; because of unbelief they were broken off, and you stand by faith. Be not highminded, but fear:", "words": [[0, 136240], [6, 136959], [14, 137191], [17, 137411], [26, 137991], [31, 138131], [36, 138251], [43, 138551], [48, 138831], [52, 139271], [56, 139371], [62, 139651], [65, 139891], [72, 140583], [75, 140707], [79, 141067], [91, 141427], [95, 141707]]}, {"verse": 21, "start": 142600, "end": 146820, "text": "For if God spared not the natural branches, take heed lest he also spare not you.", "words": [[0, 142600], [4, 142712], [7, 142832], [11, 143052], [18, 143332], [22, 143612], [26, 143792], [34, 144072], [44, 144812], [49, 144932], [54, 145192], [59, 145572], [62, 145712], [67, 146032], [73, 146332], [77, 146512]]}, {"verse": 22, "start": 147270, "end": 158040, "text": "Behold therefore the goodness and severity of God: on them which fell, severity; but toward you, goodness, if you continue in his goodness: otherwise you also shall be cut off.", "words": [[0, 147270], [7, 147908], [17, 148588], [21, 148648], [30, 148988], [34, 149328], [43, 149788], [46, 150088], [51, 150818], [54, 150957], [59, 151157], [65, 151397], [71, 151697], [81, 152921], [85, 153046], [92, 153306], [97, 153586], [107, 154306], [110, 154466], [114, 154586], [123, 155046], [126, 155326], [130, 155466], [140, 156383], [150, 156879], [154, 156959], [159, 157179], [165, 157539], [168, 157659], [172, 157859]]}, {"verse": 23, "start": 158490, "end": 164969, "text": "And they also, if they abide not still in unbelief, shall be grafted in: for God is able to graft them in again.", "words": [[0, 158490], [4, 158653], [9, 158793], [15, 159353], [18, 159493], [23, 159673], [29, 159993], [33, 160313], [39, 160673], [42, 160833], [52, 161613], [58, 161873], [61, 162033], [69, 162533], [73, 163045], [77, 163194], [81, 163414], [84, 163574], [89, 163814], [92, 163994], [98, 164254], [103, 164494], [106, 164594]]}, {"verse": 24, "start": 165419, "end": 178320, "text": "For if you wert cut out of the olive tree which is wild by nature, and wert grafted contrary to nature into a good olive tree: how much more shall these, which be the natural branches, be grafted into their own olive tree?", "words": [[0, 165419], [4, 165647], [7, 165907], [11, 166107], [16, 166307], [20, 166587], [24, 166807], [27, 166947], [31, 167087], [37, 167307], [42, 167667], [48, 167907], [51, 168047], [56, 168367], [59, 168567], [67, 168947], [71, 169397], [76, 169847], [84, 170467], [93, 170887], [96, 171187], [103, 171527], [108, 171867], [110, 172067], [115, 172187], [121, 172507], [127, 173220], [131, 173383], [136, 173583], [141, 173803], [147, 174023], [154, 174683], [160, 174803], [163, 174943], [167, 175063], [175, 175383], [185, 176183], [188, 176283], [196, 176783], [201, 176983], [207, 177243], [211, 177523], [217, 177843]]}, {"verse": 25, "start": 178770, "end": 190506, "text": "For I would not, brethren, that you should be ignorant of this mystery, lest you should be wise in your own conceits; that blindness in part is happened to Israel, until the fulness of the Gentiles be come in.", "words": [[0, 178770], [4, 178935], [6, 179055], [12, 179255], [17, 179695], [27, 180515], [32, 180635], [36, 180815], [43, 181035], [46, 181215], [55, 181655], [58, 181955], [63, 182155], [72, 182995], [77, 183195], [81, 183355], [88, 183535], [91, 183675], [96, 184035], [99, 184335], [104, 184495], [108, 184695], [118, 185782], [123, 185937], [133, 186357], [136, 186597], [141, 186877], [144, 187077], [153, 187357], [156, 187557], [164, 188157], [170, 188437], [174, 188677], [182, 188917], [185, 189177], [189, 189277], [198, 189557], [201, 189837], [206, 190117]]}, {"verse": 26, "start": 190956, "end": 198875, "text": "And so all Israel shall be saved: as it is written, There shall come out of Sion the Deliverer, and shall turn away ungodliness from Jacob:", "words": [[0, 190956], [4, 191055], [7, 191255], [11, 191595], [18, 191875], [24, 192255], [27, 192415], [34, 193205], [37, 193373], [40, 193473], [43, 193593], [52, 194371], [58, 194469], [64, 194609], [69, 194849], [73, 194989], [76, 195169], [81, 195349], [85, 195529], [96, 196269], [100, 196569], [106, 196689], [111, 196929], [116, 197149], [128, 197809], [133, 198069]]}, {"verse": 27, "start": 199325, "end": 202708, "text": "For this is my covenant to them, when I shall take away their sins.", "words": [[0, 199325], [4, 199380], [9, 199620], [12, 199760], [15, 199900], [24, 200260], [27, 200540], [33, 200740], [38, 200960], [40, 201100], [46, 201220], [51, 201420], [56, 201620], [62, 201820]]}, {"verse": 28, "start": 203008, "end": 209811, "text": "As concerning the gospel, they are enemies for your sakes: but as touching the election, they are beloved for the fathers’ sakes.", "words": [[0, 203008], [3, 203150], [14, 203570], [18, 203770], [26, 204430], [31, 204550], [35, 204670], [43, 204990], [47, 205270], [52, 205430], [59, 206299], [63, 206439], [66, 206579], [75, 206859], [79, 207059], [89, 207719], [94, 207939], [98, 208039], [106, 208519], [110, 208759], [114, 208939], [123, 209419]]}, {"verse": 29, "start": 210261, "end": 213129, "text": "For the gifts and calling of God are without repentance.", "words": [[0, 210261], [4, 210366], [8, 210526], [14, 210766], [18, 211026], [26, 211326], [29, 211526], [33, 211786], [37, 212026], [45, 212286]]}, {"verse": 30, "start": 213579, "end": 218798, "text": "For as you in times past have not believed God, yet have now obtained mercy through their unbelief:", "words": [[0, 213579], [4, 213681], [7, 213881], [11, 214061], [14, 214201], [20, 214441], [25, 214801], [30, 215021], [34, 215201], [43, 215501], [48, 216301], [52, 216481], [57, 216701], [61, 216901], [70, 217281], [76, 217781], [84, 218081], [90, 218281]]}, {"verse": 31, "start": 219248, "end": 224427, "text": "Even so have these also now not believed, that through your mercy they also may obtain mercy.", "words": [[0, 219248], [5, 219427], [8, 219647], [13, 219827], [19, 220027], [24, 220407], [28, 220647], [32, 220847], [42, 221227], [47, 221787], [55, 222007], [60, 222187], [66, 222567], [71, 223087], [76, 223427], [80, 223647], [87, 223927]]}, {"verse": 32, "start": 224877, "end": 228957, "text": "For God has concluded them all in unbelief, that he might have mercy upon all.", "words": [[0, 224877], [4, 224985], [8, 225225], [12, 225425], [22, 225765], [27, 226045], [31, 226265], [34, 226425], [44, 227025], [49, 227365], [52, 227545], [58, 227805], [63, 228025], [69, 228305], [74, 228545]]}, {"verse": 33, "start": 229407, "end": 237490, "text": "O the depth of the riches both of the wisdom and knowledge of God! how unsearchable are his judgments, and his ways past finding out!", "words": [[0, 229610], [2, 229850], [6, 229930], [12, 230310], [15, 230470], [19, 230610], [26, 230890], [31, 231310], [34, 231530], [38, 231650], [45, 231950], [49, 232430], [59, 232810], [62, 232990], [67, 233740], [71, 233923], [84, 234743], [88, 234943], [92, 235103], [103, 235543], [107, 236083], [111, 236203], [116, 236423], [121, 236783], [129, 237143]]}, {"verse": 34, "start": 237940, "end": 241568, "text": "For who has known the mind of the Lord? or who has been his counsellor?", "words": [[0, 237940], [4, 238073], [8, 238253], [12, 238473], [18, 238713], [22, 238893], [27, 239113], [30, 239253], [34, 239353], [40, 240049], [43, 240169], [47, 240309], [51, 240469], [56, 240669], [60, 241144]]}, {"verse": 35, "start": 242018, "end": 245668, "text": "Or who has first given to him, and it shall be recompensed to him again?", "words": [[0, 242018], [3, 242122], [7, 242242], [11, 242422], [17, 242662], [23, 242902], [26, 243122], [31, 243322], [35, 243782], [38, 243922], [44, 244062], [47, 244242], [59, 244902], [62, 245042], [66, 245182]]}, {"verse": 36, "start": 246118, "end": 252124, "text": "For of him, and through him, and to him, are all things: to whom be glory for ever. Amen.", "words": [[0, 246118], [4, 246241], [7, 246441], [12, 246641], [16, 246981], [24, 247201], [29, 247461], [33, 247881], [36, 248061], [41, 248301], [45, 248621], [49, 248861], [57, 249727], [60, 249841], [65, 250041], [68, 250201], [74, 250591], [78, 250981], [84, 251614]]}]}