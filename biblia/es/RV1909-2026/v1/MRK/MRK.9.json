{"book": "MRK", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 402211, "verses": [{"verse": 1, "start": 300, "end": 9636, "text": "También les dijo: De cierto os digo que hay algunos de los que están aquí, que no probarán la muerte hasta que hayan visto el reino de Dios que viene con poder.", "words": [[0, 300], [8, 620], [12, 820], [18, 1566], [21, 1714], [28, 1894], [31, 2074], [36, 2614], [40, 2854], [44, 3014], [52, 3454], [55, 3634], [59, 3734], [63, 3854], [69, 4094], [75, 4894], [79, 4974], [82, 5134], [91, 5674], [94, 5794], [101, 6214], [107, 6714], [111, 6914], [117, 7174], [123, 7434], [126, 7634], [132, 8014], [135, 8174], [140, 8414], [144, 8614], [150, 8874], [154, 9094]]}, {"verse": 2, "start": 9986, "end": 20768, "text": "Y seis días después tomó Jesús a Pedro, y a Jacobo, y a Juan, y los sacó aparte solos a un monte alto; y fue transfigurado delante de ellos.", "words": [[0, 9986], [2, 10108], [7, 10408], [12, 10868], [20, 11288], [25, 11808], [31, 12088], [33, 12328], [40, 12808], [42, 13093], [44, 13173], [52, 13873], [54, 14133], [56, 14193], [62, 14553], [64, 14873], [68, 15193], [73, 15553], [80, 15993], [86, 16553], [88, 16753], [91, 16893], [97, 17253], [103, 18171], [105, 18428], [109, 18588], [123, 19588], [131, 20108], [134, 20288]]}, {"verse": 3, "start": 21118, "end": 31193, "text": "Y sus vestidos se volvieron resplandecientes, muy blancos, como la nieve; tanto que ningún lavandero en la tierra los puede hacer tan blancos.", "words": [[0, 21118], [2, 21226], [6, 21386], [15, 21886], [18, 22046], [28, 22566], [46, 24066], [50, 24386], [59, 25326], [64, 25586], [67, 25766], [74, 26566], [80, 26771], [84, 27031], [91, 27431], [101, 28191], [104, 28291], [107, 28411], [114, 28771], [118, 29351], [124, 29651], [130, 29991], [134, 30331]]}, {"verse": 4, "start": 31543, "end": 35754, "text": "Y les apareció Elías con Moisés, que hablaban con Jesús.", "words": [[0, 31543], [2, 31653], [6, 31773], [15, 32473], [21, 33053], [25, 33313], [33, 34373], [37, 34433], [46, 34873], [50, 35053]]}, {"verse": 5, "start": 36104, "end": 47301, "text": "Entonces respondiendo Pedro, dice a Jesús: Maestro, bien será que nos quedemos aquí, y hagamos tres refugios: para ti uno, y para Moisés otro, y para Elías otro;", "words": [[0, 36104], [9, 37086], [22, 37789], [29, 38689], [34, 38989], [36, 39209], [43, 40017], [52, 40603], [57, 40723], [62, 41023], [66, 41243], [70, 41403], [79, 41863], [85, 42143], [87, 42368], [95, 42708], [100, 42988], [110, 44069], [115, 44212], [118, 44412], [123, 44672], [125, 45032], [130, 45212], [137, 45552], [143, 45892], [145, 46312], [150, 46472], [156, 46892]]}, {"verse": 6, "start": 47581, "end": 50874, "text": "Porque no sabía qué decir, pues estaban espantados.", "words": [[0, 47581], [7, 47788], [10, 47988], [16, 48428], [20, 48588], [27, 49348], [32, 49488], [40, 49848]]}, {"verse": 7, "start": 51224, "end": 60252, "text": "Y vino una nube que les hizo sombra, y una voz de la nube, que decía: Este es mi Hijo amado: a él oíd.", "words": [[0, 51224], [2, 51347], [7, 51647], [11, 51967], [16, 52367], [20, 52567], [24, 52807], [29, 53287], [37, 54187], [39, 54327], [43, 54507], [47, 54867], [50, 55147], [53, 55287], [59, 55727], [63, 55967], [70, 56931], [75, 57254], [78, 57514], [81, 57694], [86, 57914], [93, 59211], [95, 59463], [98, 59716]]}, {"verse": 8, "start": 60532, "end": 66335, "text": "Y luego, como miraron, no vieron más a nadie consigo, sino a Jesús solo.", "words": [[0, 60532], [2, 60649], [9, 61049], [14, 61269], [23, 62369], [26, 62669], [33, 63069], [37, 63329], [39, 63649], [45, 63969], [54, 64449], [59, 64929], [61, 65209], [67, 65489]]}, {"verse": 9, "start": 66685, "end": 76806, "text": "Y descendiendo ellos del monte, les mandó que a nadie dijesen lo que habían visto, sino cuando el Hijo del hombre hubiese resucitado de los muertos.", "words": [[0, 66685], [2, 66807], [15, 67547], [21, 67767], [25, 67947], [32, 68987], [36, 69107], [42, 69567], [46, 69727], [48, 69887], [54, 70497], [62, 71107], [65, 71267], [69, 71407], [76, 71727], [83, 72767], [88, 73007], [95, 73267], [98, 73507], [103, 73787], [107, 73947], [114, 74247], [122, 74687], [133, 75687], [136, 75807], [140, 75927]]}, {"verse": 10, "start": 77156, "end": 83553, "text": "Y retuvieron la palabra en sí, discutiendo qué sería aquéllo: Resucitar de los muertos.", "words": [[0, 77156], [2, 77280], [13, 77900], [16, 78040], [24, 78380], [27, 78620], [31, 79220], [43, 79800], [47, 80020], [53, 80460], [62, 81565], [72, 82391], [75, 82531], [79, 82651]]}, {"verse": 11, "start": 83903, "end": 90478, "text": "Y le preguntaron, diciendo: ¿Qué es lo que los escribas dicen, que es necesario que Elías venga antes?", "words": [[0, 83903], [2, 84029], [5, 84109], [18, 84829], [28, 85828], [33, 85828], [36, 85990], [39, 86110], [43, 86270], [47, 86410], [56, 87010], [63, 87870], [67, 88150], [70, 88270], [80, 88870], [84, 89150], [90, 89430], [96, 89850]]}, {"verse": 12, "start": 90758, "end": 103616, "text": "Y respondiendo él, les dijo: Elías a la verdad, viniendo antes, restaurará todas las cosas: y cómo está escrito del Hijo del hombre, que padezca mucho y sea tenido en nada.", "words": [[0, 90865], [2, 91005], [15, 91845], [19, 92265], [23, 92685], [29, 93539], [35, 94086], [37, 94286], [40, 94366], [48, 94666], [57, 95401], [64, 95720], [75, 96039], [81, 96358], [85, 96676], [92, 97983], [94, 98903], [99, 99203], [104, 99403], [112, 99743], [116, 100043], [121, 100283], [125, 100423], [133, 100883], [137, 101263], [145, 101743], [151, 102063], [153, 102353], [157, 102643], [164, 102783], [167, 102923]]}, {"verse": 13, "start": 103966, "end": 109759, "text": "Pero os digo que Elías ya vino, y le hicieron todo lo que quisieron, como está escrito de él.", "words": [[0, 103966], [5, 104130], [8, 104330], [13, 104590], [17, 104830], [23, 105510], [26, 105730], [32, 106030], [34, 106275], [37, 106415], [46, 106855], [51, 107135], [54, 107355], [58, 107515], [69, 108075], [74, 108575], [79, 108755], [87, 109055], [90, 109375]]}, {"verse": 14, "start": 110109, "end": 117798, "text": "Y cuando vino a los discípulos, vio grande compañía alrededor de ellos, y escribas que disputaban con ellos.", "words": [[0, 110109], [2, 110231], [9, 110411], [14, 110831], [16, 111011], [20, 111131], [32, 112151], [36, 112571], [43, 112871], [52, 113751], [62, 114231], [65, 114691], [72, 115011], [74, 115531], [83, 116151], [87, 116311], [98, 117031], [102, 117251]]}, {"verse": 15, "start": 118148, "end": 123935, "text": "Y luego toda la gente, viéndole, se espantó, y corriendo a él, le saludaron.", "words": [[0, 118148], [2, 118295], [8, 118555], [13, 119095], [16, 119315], [23, 119615], [33, 120615], [36, 121065], [45, 121515], [47, 121835], [57, 122395], [59, 122515], [63, 123055], [66, 123135]]}, {"verse": 16, "start": 124285, "end": 126995, "text": "Y les preguntó: ¿Qué disputáis con ellos?", "words": [[0, 124285], [2, 124430], [6, 124510], [16, 125480], [21, 125604], [31, 126224], [35, 126444]]}, {"verse": 17, "start": 127345, "end": 133569, "text": "Y respondiendo uno de la multitud, dijo: Maestro, traje a ti mi hijo, que tiene un espíritu mudo,", "words": [[0, 127345], [2, 127621], [15, 128501], [19, 128681], [22, 128841], [25, 128961], [35, 129481], [41, 130292], [50, 130748], [56, 131128], [58, 131228], [61, 131448], [64, 131508], [70, 132088], [74, 132168], [80, 132408], [83, 132568], [92, 133108]]}, {"verse": 18, "start": 133919, "end": 144949, "text": "El cual, donde quiera que le toma, lo convulsiona; y echa espuma por la boca, y rechina los dientes, y queda rígido: y dije a tus discípulos que le echasen fuera, y no pudieron.", "words": [[0, 133919], [3, 134038], [9, 134458], [15, 134638], [22, 135018], [26, 135158], [29, 135258], [35, 135978], [38, 136058], [51, 137170], [53, 137291], [58, 137491], [65, 137951], [69, 138131], [72, 138251], [78, 138531], [80, 138791], [88, 139251], [92, 139391], [101, 139831], [103, 140271], [109, 140471], [117, 141300], [119, 141399], [124, 141679], [126, 141859], [130, 142019], [141, 142679], [145, 142899], [148, 143039], [156, 143479], [163, 143819], [165, 144219], [168, 144339]]}, {"verse": 19, "start": 145229, "end": 155575, "text": "Y respondiendo él, les dijo: ¡Oh generación infiel! ¿hasta cuándo estaré con vosotros? ¿hasta cuándo tendré que soportaros? Traédmele.", "words": [[0, 145337], [2, 145477], [15, 146317], [19, 146737], [23, 147157], [29, 148087], [33, 148197], [44, 148957], [52, 149944], [59, 150127], [66, 150427], [73, 150967], [77, 151147], [87, 152210], [94, 152490], [101, 152910], [108, 153250], [112, 153350], [124, 154482]]}, {"verse": 20, "start": 155925, "end": 165864, "text": "Y se le trajeron: y como le vio, luego el espíritu lo convulsionó; y cayendo en tierra, se revolcaba, echando espuma por la boca.", "words": [[0, 155925], [2, 156032], [5, 156152], [8, 156292], [18, 157306], [20, 157391], [25, 157571], [28, 157751], [33, 158451], [39, 158791], [42, 159191], [51, 159711], [54, 159811], [67, 160902], [69, 161046], [77, 161626], [80, 161786], [88, 162246], [91, 162896], [102, 163546], [110, 164366], [117, 164946], [121, 165146], [124, 165306]]}, {"verse": 21, "start": 166214, "end": 172478, "text": "Y Jesús preguntó a su padre: ¿Desde cuándo le sucede esto? Y él dijo: Desde niño:", "words": [[0, 166214], [2, 166340], [8, 166700], [17, 167700], [19, 167760], [22, 167860], [29, 168630], [36, 168879], [43, 169199], [46, 169539], [53, 169919], [59, 170739], [61, 170907], [64, 171027], [70, 171754], [76, 171958]]}, {"verse": 22, "start": 172828, "end": 180791, "text": "Y muchas veces le echa en el fuego y en aguas, para matarle; pero, si puedes algo, ayúdanos, teniendo misericordia de nosotros.", "words": [[0, 172858], [2, 172888], [9, 173108], [15, 173528], [18, 173848], [23, 174088], [26, 174248], [29, 174448], [35, 174728], [37, 174948], [40, 175068], [47, 175508], [52, 175968], [61, 176857], [67, 176981], [70, 177161], [77, 177421], [83, 178141], [93, 178801], [102, 179381], [115, 180121], [118, 180221]]}, {"verse": 23, "start": 181071, "end": 185714, "text": "Y Jesús le dijo: Si puedes creer, al que cree todo es posible.", "words": [[0, 181071], [2, 181201], [8, 181601], [11, 181961], [17, 182770], [20, 182913], [27, 183213], [34, 183593], [37, 183973], [41, 184253], [46, 184533], [51, 184733], [54, 184933]]}, {"verse": 24, "start": 186064, "end": 190648, "text": "Y luego el padre del muchacho dijo clamando: Creo, ayuda mi incredulidad.", "words": [[0, 186064], [2, 186172], [8, 186352], [11, 186592], [17, 186912], [21, 187132], [30, 187692], [35, 188152], [45, 189105], [51, 189282], [57, 189622], [60, 189882]]}, {"verse": 25, "start": 190928, "end": 202967, "text": "Y como Jesús vio que la multitud se agolpaba, reprendió al espíritu inmundo, diciéndole: Espíritu mudo y sordo, yo te mando, sal de él, y no entres más en él.", "words": [[0, 190928], [2, 191033], [7, 191273], [13, 191593], [17, 192073], [21, 192213], [24, 192353], [33, 192973], [36, 193173], [46, 194233], [56, 194973], [59, 195133], [68, 195693], [77, 196653], [89, 197862], [98, 198387], [103, 198807], [105, 198907], [112, 199667], [115, 199827], [118, 199967], [125, 200347], [129, 200587], [132, 200847], [136, 201147], [138, 201607], [141, 201787], [148, 202167], [152, 202467], [155, 202747]]}, {"verse": 26, "start": 203317, "end": 212568, "text": "Entonces el espíritu clamó, lo convulsionó violentamente y salió; y él quedó como muerto, de modo que muchos decían: Está muerto.", "words": [[0, 203317], [9, 203833], [12, 204113], [21, 204653], [28, 205753], [31, 205893], [43, 206753], [57, 207713], [59, 207893], [66, 208588], [68, 208708], [71, 208848], [77, 209168], [82, 209348], [90, 210068], [93, 210228], [98, 210368], [102, 210568], [109, 210768], [117, 211798], [122, 212019]]}, {"verse": 27, "start": 212848, "end": 217459, "text": "Pero Jesús tomándole de la mano, le enderezó; y se levantó.", "words": [[0, 212848], [5, 213011], [11, 213611], [21, 214151], [24, 214331], [27, 214471], [33, 215231], [36, 215351], [46, 216424], [48, 216572], [51, 216652]]}, {"verse": 28, "start": 217809, "end": 224846, "text": "Y como él entró en casa, sus discípulos le preguntaron aparte: ¿Por qué nosotros no pudimos echarle fuera?", "words": [[0, 217809], [2, 217897], [7, 218117], [10, 218337], [16, 218717], [19, 218837], [25, 219737], [29, 219897], [40, 220637], [43, 220817], [55, 221537], [63, 222472], [68, 222631], [72, 222751], [81, 223131], [84, 223451], [92, 223911], [100, 224391]]}, {"verse": 29, "start": 225126, "end": 230335, "text": "Y les dijo: Este género con nada puede salir, sino con oración y ayuno.", "words": [[0, 225126], [2, 225284], [6, 225364], [12, 226067], [17, 226270], [24, 226830], [28, 226990], [33, 227310], [39, 227590], [46, 228330], [51, 228530], [55, 228810], [63, 229430], [65, 229730]]}, {"verse": 30, "start": 230685, "end": 236524, "text": "Y habiendo salido de allí, caminaron por Galilea; y no quería que nadie lo supiese.", "words": [[0, 230685], [2, 230875], [11, 231195], [18, 231695], [21, 231875], [27, 232495], [37, 233135], [41, 233375], [50, 234440], [52, 234536], [55, 234656], [62, 234896], [66, 235196], [72, 235476], [75, 235716]]}, {"verse": 31, "start": 236874, "end": 248879, "text": "Porque enseñaba a sus discípulos, y les decía: El Hijo del hombre será entregado en manos de hombres, y le matarán; pero muerto él, resucitará al tercer día.", "words": [[0, 236874], [7, 237156], [16, 238196], [18, 238436], [22, 238656], [34, 239596], [36, 239796], [40, 239976], [47, 240913], [50, 241081], [55, 241421], [59, 241581], [66, 241961], [71, 242161], [81, 242861], [84, 242981], [90, 243221], [93, 243461], [102, 243801], [104, 244136], [107, 244256], [116, 245192], [121, 245602], [128, 246162], [132, 246802], [143, 247702], [146, 247862], [153, 248182]]}, {"verse": 32, "start": 249229, "end": 253425, "text": "Pero ellos no entendían esta palabra, y tenían miedo de preguntarle.", "words": [[0, 249229], [5, 249377], [11, 249637], [14, 249937], [24, 250517], [29, 250757], [38, 251157], [40, 251357], [47, 251657], [53, 252157], [56, 252377]]}, {"verse": 33, "start": 253775, "end": 261156, "text": "Y llegó a Capernaum; y así que estuvo en casa, les preguntó: ¿Qué disputabais entre vosotros en el camino?", "words": [[0, 253775], [2, 254115], [8, 254335], [10, 254595], [21, 255831], [23, 255936], [27, 256156], [31, 256376], [38, 256696], [41, 256836], [47, 257276], [51, 257356], [61, 258349], [66, 258909], [78, 259489], [84, 259689], [93, 260209], [96, 260429], [99, 260569]]}, {"verse": 34, "start": 261506, "end": 267970, "text": "Pero ellos callaron; porque los unos con los otros habían disputado en el camino quién había de ser el mayor.", "words": [[0, 261506], [5, 261651], [11, 261871], [21, 262937], [28, 263164], [32, 263384], [37, 263664], [41, 263924], [45, 264124], [51, 264444], [58, 264804], [68, 265624], [71, 265764], [74, 265884], [81, 266124], [87, 266504], [93, 266804], [96, 267004], [100, 267224], [103, 267364]]}, {"verse": 35, "start": 268320, "end": 278521, "text": "Entonces sentándose, llamó a los doce, y les dice: Si alguno quiere ser el primero, será el último de todos, y el servidor de todos.", "words": [[0, 268320], [9, 269366], [21, 270526], [27, 271006], [29, 271166], [33, 271346], [39, 271826], [41, 272326], [45, 272526], [51, 273341], [54, 273506], [61, 273986], [68, 274186], [72, 274526], [75, 274686], [84, 275106], [89, 275466], [92, 275726], [99, 276126], [102, 276366], [109, 276746], [111, 277141], [114, 277281], [123, 277841], [126, 278041]]}, {"verse": 36, "start": 278871, "end": 284822, "text": "Y tomando un niño, lo puso en medio de ellos; y tomándole en sus brazos, les dice:", "words": [[0, 278871], [2, 278969], [10, 279389], [13, 279589], [19, 279949], [22, 280489], [27, 280849], [30, 280989], [36, 281249], [39, 281529], [46, 282316], [48, 282424], [58, 283024], [61, 283164], [65, 283344], [73, 283844], [77, 284344]]}, {"verse": 37, "start": 285172, "end": 294934, "text": "El que reciba en mi nombre uno de los tales niños, a mí recibe; y quien me recibe a mí no me recibe a mí, sino al que me envió.", "words": [[0, 285172], [3, 285320], [7, 285460], [14, 286100], [17, 286220], [20, 286380], [27, 286760], [31, 287180], [34, 287340], [38, 287480], [44, 287720], [51, 288640], [53, 289060], [56, 289180], [64, 290202], [66, 290325], [72, 290545], [75, 290745], [82, 291245], [84, 291345], [87, 291905], [90, 292005], [93, 292145], [100, 292665], [102, 292745], [106, 293245], [111, 293485], [114, 293905], [118, 294085], [121, 294245]]}, {"verse": 38, "start": 295284, "end": 304267, "text": "Y le respondió Juan, diciendo: Maestro, hemos visto a uno que en tu nombre echaba fuera los demonios, el cual no nos sigue; y se lo prohibimos, porque no nos sigue.", "words": [[0, 295284], [2, 295405], [5, 295545], [15, 296245], [21, 296685], [31, 297107], [40, 297586], [46, 297666], [52, 298046], [54, 298226], [58, 298366], [62, 298586], [65, 298686], [68, 298806], [75, 299086], [82, 299506], [88, 299726], [92, 299986], [102, 300726], [105, 300826], [110, 301026], [113, 301226], [117, 301406], [124, 302091], [126, 302195], [129, 302275], [132, 302415], [144, 303075], [151, 303415], [154, 303635], [158, 303835]]}, {"verse": 39, "start": 304547, "end": 312583, "text": "Y Jesús dijo: No se lo prohibáis; porque ninguno hay que haga milagro en mi nombre que luego pueda decir mal de mí.", "words": [[0, 304547], [2, 304685], [8, 305045], [14, 305865], [17, 306034], [20, 306254], [23, 306434], [34, 307702], [41, 307906], [49, 308486], [53, 308726], [57, 308886], [62, 309126], [70, 309746], [73, 309846], [76, 310026], [83, 310366], [87, 310586], [93, 310826], [99, 311266], [105, 311666], [109, 312026], [112, 312246]]}, {"verse": 40, "start": 312933, "end": 316625, "text": "Porque el que no es contra nosotros, por nosotros es.", "words": [[0, 312933], [7, 313284], [10, 313464], [14, 313604], [17, 313784], [20, 313924], [27, 314244], [37, 315124], [41, 315464], [50, 315984]]}, {"verse": 41, "start": 316975, "end": 325060, "text": "Y cualquiera que os dé un vaso de agua en mi nombre, porque sois de Cristo, de cierto os digo que no perderá su recompensa.", "words": [[0, 316975], [2, 317121], [13, 317721], [17, 317941], [20, 318061], [23, 318201], [26, 318321], [31, 318721], [34, 318861], [39, 319101], [42, 319281], [45, 319441], [53, 319901], [60, 320141], [65, 320521], [68, 320641], [76, 321086], [79, 321531], [86, 321976], [89, 322251], [94, 322591], [98, 323071], [101, 323231], [109, 323771], [112, 323931]]}, {"verse": 42, "start": 325410, "end": 335610, "text": "Y cualquiera que haga caer a uno de estos pequeños que creen en mí, mejor le fuera si se le atase una piedra de molino al cuello, y fuera echado en el mar.", "words": [[0, 325410], [2, 325515], [13, 326115], [17, 326335], [22, 326575], [27, 327035], [29, 327115], [33, 327335], [36, 327575], [42, 327775], [51, 328395], [55, 328555], [61, 328955], [64, 329095], [68, 329735], [74, 330175], [77, 330395], [83, 330715], [86, 330955], [89, 331115], [92, 331385], [98, 331655], [102, 331815], [109, 332275], [112, 332395], [119, 332855], [122, 333015], [130, 333785], [132, 333893], [138, 334193], [145, 334873], [148, 335073], [151, 335193]]}, {"verse": 43, "start": 335960, "end": 346600, "text": "Y si tu mano te hace pecar, córtala: mejor te es entrar a la vida manco, que teniendo dos manos ir a la Gehenna, al fuego que no puede ser apagado;", "words": [[0, 335960], [2, 336062], [5, 336202], [8, 336382], [13, 336642], [16, 336862], [21, 337042], [28, 337682], [37, 338567], [43, 338916], [46, 339096], [49, 339276], [56, 339616], [58, 339796], [61, 339896], [66, 340096], [73, 340916], [77, 341116], [86, 341696], [90, 342076], [96, 342696], [99, 343136], [101, 343236], [104, 343566], [113, 343896], [116, 344416], [122, 344776], [126, 345036], [129, 345176], [135, 345416], [139, 345736]]}, {"verse": 44, "start": 346950, "end": 350754, "text": "Donde su gusano no muere, y el fuego nunca se apaga.", "words": [[0, 346950], [6, 347214], [9, 347534], [16, 347994], [19, 348214], [26, 348614], [28, 348854], [31, 348994], [37, 349274], [43, 349694], [46, 350114]]}, {"verse": 45, "start": 351104, "end": 362598, "text": "Y si tu pie te es ocasión de caer, córtalo: mejor te es entrar a la vida cojo, que teniendo dos pies ser echado en la Gehenna, al fuego que no puede ser apagado;", "words": [[0, 351104], [2, 351211], [5, 351331], [8, 351541], [12, 351751], [15, 351891], [18, 352031], [26, 352551], [29, 352691], [35, 353151], [44, 354057], [50, 354409], [53, 354629], [56, 354809], [63, 355149], [65, 355329], [68, 355429], [73, 355649], [79, 356629], [83, 356869], [92, 357449], [96, 357649], [101, 358049], [105, 358429], [112, 358909], [115, 359029], [118, 359639], [127, 360249], [130, 360469], [136, 360889], [140, 361149], [143, 361289], [149, 361529], [153, 361829]]}, {"verse": 46, "start": 362948, "end": 368180, "text": "Donde el gusano de ellos no muere, y el fuego nunca se apaga.", "words": [[0, 362948], [6, 363292], [9, 363612], [16, 364092], [19, 364312], [25, 364532], [28, 364792], [35, 365292], [37, 365752], [40, 365912], [46, 366332], [52, 367112], [55, 367512]]}, {"verse": 47, "start": 368530, "end": 379638, "text": "Y si tu ojo te es ocasión de caer, sácalo: mejor te es entrar al reino de Dios con un ojo, que teniendo dos ojos ser echado a la Gehenna;", "words": [[0, 368530], [2, 368830], [5, 368990], [8, 369210], [12, 369550], [15, 369730], [18, 369910], [26, 370450], [29, 370630], [35, 371210], [43, 372155], [49, 372638], [52, 372858], [55, 373078], [62, 373498], [65, 373818], [71, 374258], [74, 374418], [79, 374678], [83, 374958], [86, 375178], [91, 375878], [95, 376098], [104, 376658], [108, 376998], [113, 377398], [117, 377858], [124, 378578], [126, 378718], [129, 379214]]}, {"verse": 48, "start": 379988, "end": 385220, "text": "Donde el gusano de ellos no muere, y el fuego nunca se apaga.", "words": [[0, 379988], [6, 380332], [9, 380652], [16, 381132], [19, 381352], [25, 381572], [28, 381832], [35, 382332], [37, 382792], [40, 382952], [46, 383372], [52, 384152], [55, 384552]]}, {"verse": 49, "start": 385570, "end": 390543, "text": "Porque todos serán salados con fuego, y todo sacrificio será salado con sal.", "words": [[0, 385570], [7, 385794], [13, 386154], [19, 386694], [27, 387194], [31, 387394], [38, 387834], [40, 388089], [45, 388309], [56, 389089], [61, 389329], [68, 389829], [72, 390029]]}, {"verse": 50, "start": 390893, "end": 401811, "text": "Buena es la sal; pero si la sal pierde su sabor, ¿con qué la sazonaréis? Tened en vosotros mismos sal; y tened paz los unos con los otros.", "words": [[0, 390893], [6, 391330], [9, 391610], [12, 391770], [17, 392420], [22, 392563], [25, 392743], [28, 392903], [32, 393296], [39, 393696], [42, 393856], [49, 394576], [54, 394796], [58, 395096], [61, 395276], [73, 396575], [79, 397093], [82, 397213], [91, 397653], [98, 397913], [103, 398898], [105, 399080], [111, 399300], [115, 399680], [119, 400120], [124, 400500], [128, 400920], [132, 401120]]}]}