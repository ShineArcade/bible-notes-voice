{"book": "ROM", "chapter": 2, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 199125, "verses": [{"verse": 1, "start": 300, "end": 9642, "text": "Por lo cual eres inexcusable, oh hombre, cualquiera que juzgas: porque en lo que juzgas a otro, te condenas a ti mismo; porque lo mismo haces, tú que juzgas.", "words": [[0, 300], [4, 428], [7, 548], [12, 808], [17, 1028], [30, 1598], [33, 2168], [41, 2728], [52, 3148], [56, 3328], [64, 4189], [71, 4447], [74, 4607], [77, 4707], [81, 4807], [88, 5227], [90, 5407], [96, 5647], [99, 5887], [108, 6447], [110, 6587], [113, 6647], [120, 7419], [127, 7605], [130, 7785], [136, 8005], [143, 8565], [146, 8825], [150, 9005]]}, {"verse": 2, "start": 9992, "end": 14472, "text": "Pero sabemos que el juicio de Dios es según verdad contra los que hacen tales cosas.", "words": [[0, 9992], [5, 10129], [13, 10489], [17, 10769], [20, 10849], [27, 11189], [30, 11329], [35, 11609], [38, 12029], [44, 12269], [51, 12629], [58, 13009], [62, 13189], [66, 13349], [72, 13589], [78, 13849]]}, {"verse": 3, "start": 14822, "end": 22966, "text": "¿Y piensas esto, oh hombre, que juzgas a los que hacen tales cosas, y haces las mismas, que tú escaparás del juicio de Dios?", "words": [[0, 14822], [3, 14950], [11, 15470], [17, 15810], [20, 16150], [28, 16670], [32, 16770], [39, 17290], [41, 17510], [45, 17650], [49, 17790], [55, 18050], [61, 18410], [68, 18890], [70, 19530], [76, 19810], [80, 19990], [88, 20730], [92, 20930], [95, 21110], [105, 21750], [109, 21870], [116, 22290], [119, 22470]]}, {"verse": 4, "start": 23316, "end": 30707, "text": "¿O menosprecias las riquezas de su bondad, y tolerancia, y paciencia, ignorando que su bondad te guía a arrepentimiento?", "words": [[0, 23316], [3, 23440], [16, 24200], [20, 24570], [29, 24940], [32, 25220], [35, 25500], [43, 25780], [45, 25895], [57, 26595], [59, 26835], [70, 27815], [80, 28415], [84, 28655], [87, 28895], [94, 29135], [97, 29255], [102, 29415], [104, 29575]]}, {"verse": 5, "start": 31057, "end": 39910, "text": "Pero por tu dureza, y por tu corazón no arrepentido, atesoras para ti mismo ira para el día de la ira y de la manifestación del justo juicio de Dios;", "words": [[0, 31057], [5, 31216], [9, 31396], [12, 31536], [20, 32036], [22, 32176], [26, 32356], [29, 32496], [37, 32856], [40, 33530], [53, 34204], [62, 34876], [67, 35156], [70, 35376], [76, 35656], [80, 36037], [85, 36236], [88, 36416], [92, 36596], [95, 36736], [98, 36896], [102, 37196], [104, 37276], [107, 37396], [110, 37496], [124, 38256], [128, 38436], [134, 38736], [141, 39156], [144, 39336]]}, {"verse": 6, "start": 40260, "end": 43062, "text": "El cual pagará a cada uno conforme a sus obras:", "words": [[0, 40260], [3, 40380], [8, 40580], [15, 41080], [17, 41180], [22, 41320], [26, 41620], [35, 42260], [37, 42300], [41, 42420]]}, {"verse": 7, "start": 43412, "end": 48469, "text": "A los que perseverando en bien hacer, buscan gloria y honra e inmortalidad, la vida eterna.", "words": [[0, 43412], [2, 43498], [6, 43598], [10, 43718], [23, 44398], [26, 44631], [31, 44865], [38, 45098], [45, 45578], [52, 46078], [54, 46238], [60, 46638], [62, 47038], [76, 47438], [79, 47678], [84, 47858]]}, {"verse": 8, "start": 48819, "end": 55329, "text": "Pero a los que son contenciosos, y no obedecen a la verdad, antes obedecen a la injusticia, enojo e ira;", "words": [[0, 48819], [5, 48979], [7, 49139], [11, 49299], [15, 49419], [19, 49619], [33, 50639], [35, 50819], [38, 50999], [47, 51579], [49, 51659], [52, 51719], [60, 52494], [66, 52854], [75, 53214], [77, 53274], [80, 53374], [92, 54064], [98, 54754], [100, 54914]]}, {"verse": 9, "start": 55679, "end": 62228, "text": "Tribulación y angustia sobre toda persona humana que obra lo malo, el judío primeramente, y también el griego:", "words": [[0, 55679], [12, 56314], [14, 56454], [23, 57034], [29, 57234], [34, 57454], [42, 57894], [49, 58414], [53, 58534], [58, 58754], [61, 58914], [67, 59754], [70, 59794], [76, 60174], [90, 60894], [92, 61314], [100, 61554], [103, 61754]]}, {"verse": 10, "start": 62578, "end": 68121, "text": "Pero gloria y honra y paz a cualquiera que obra el bien, al judío primeramente, y también al griego.", "words": [[0, 62578], [5, 62737], [12, 63117], [14, 63257], [20, 63657], [22, 63887], [26, 64117], [28, 64217], [39, 64657], [43, 64837], [48, 65037], [51, 65197], [57, 65717], [60, 65817], [66, 66237], [80, 66977], [82, 67217], [90, 67457], [93, 67657]]}, {"verse": 11, "start": 68471, "end": 70618, "text": "Porque Dios no muestra favoritismo.", "words": [[0, 68471], [7, 68649], [12, 68949], [15, 69209], [23, 69589]]}, {"verse": 12, "start": 70968, "end": 78470, "text": "Porque todos los que sin ley pecaron, sin ley también perecerán; y todos los que en la ley pecaron, por la ley serán juzgados:", "words": [[0, 70968], [7, 71126], [13, 71446], [17, 71726], [21, 71926], [25, 72146], [29, 72346], [38, 73086], [42, 73246], [46, 73486], [54, 73926], [65, 74906], [67, 75025], [73, 75265], [77, 75525], [81, 75745], [84, 75845], [87, 75925], [91, 76125], [100, 76625], [104, 76885], [107, 77025], [111, 77185], [117, 77505]]}, {"verse": 13, "start": 78820, "end": 85440, "text": "Porque no los oyentes de la ley son justos para con Dios, sino que los hacedores de la ley serán justificados.", "words": [[0, 78820], [7, 79030], [10, 79230], [14, 79390], [22, 79810], [25, 80030], [28, 80170], [32, 80390], [36, 80610], [43, 81170], [48, 81370], [52, 81630], [58, 82370], [63, 82710], [67, 82930], [71, 83110], [81, 83750], [84, 83890], [87, 84030], [91, 84250], [97, 84570]]}, {"verse": 14, "start": 85790, "end": 94370, "text": "Porque los Gentiles que no tienen ley, naturalmente haciendo lo que es de la ley, los tales, aunque no tengan ley, ellos son ley a sí mismos:", "words": [[0, 85790], [7, 85970], [11, 86130], [20, 86610], [24, 86830], [27, 86990], [34, 87270], [39, 87870], [52, 88690], [61, 89030], [64, 89290], [68, 89430], [71, 89590], [74, 89710], [77, 89870], [82, 90510], [86, 90650], [93, 91310], [100, 91490], [103, 91710], [110, 92010], [115, 92730], [121, 92950], [125, 93210], [129, 93470], [131, 93570], [134, 93690]]}, {"verse": 15, "start": 94720, "end": 105161, "text": "Mostrando la obra de la ley escrita en sus corazones, dando testimonio juntamente sus conciencias, y acusándose y también excusándose sus pensamientos unos con otros;", "words": [[0, 94720], [10, 95199], [13, 95359], [18, 95579], [21, 95719], [24, 95839], [28, 96059], [36, 96579], [39, 96659], [43, 96819], [54, 98039], [60, 98219], [71, 98959], [82, 99499], [86, 99759], [99, 100899], [101, 101179], [112, 101919], [114, 102039], [122, 102259], [134, 103079], [138, 103299], [151, 103979], [156, 104299], [160, 104579]]}, {"verse": 16, "start": 105511, "end": 111723, "text": "En el día que juzgará el Señor lo encubierto de los hombres, conforme a mi evangelio, por Jesucristo.", "words": [[0, 105511], [3, 105636], [6, 105736], [10, 105976], [14, 106156], [22, 106676], [25, 106796], [31, 107116], [34, 107396], [45, 107976], [48, 108116], [52, 108236], [61, 109016], [70, 109676], [72, 109756], [75, 109836], [86, 110596], [90, 110916]]}, {"verse": 17, "start": 112073, "end": 117399, "text": "He aquí, tú llevas el nombre de judío, y descansas en la ley, y te glorías en Dios,", "words": [[0, 112073], [3, 112201], [9, 112501], [12, 112721], [19, 113121], [22, 113221], [29, 113461], [32, 113621], [39, 114201], [41, 114541], [51, 115201], [54, 115341], [57, 115461], [62, 115761], [64, 116201], [67, 116321], [75, 116721], [78, 116921]]}, {"verse": 18, "start": 117749, "end": 121564, "text": "Y sabes su voluntad, y apruebas lo mejor, instruido por la ley;", "words": [[0, 117749], [2, 117878], [8, 118048], [11, 118248], [21, 118888], [23, 119048], [32, 119468], [35, 119608], [42, 119948], [52, 120828], [56, 121028], [59, 121148]]}, {"verse": 19, "start": 121914, "end": 126766, "text": "Y confías en que eres guía de los ciegos, luz de los que están en tinieblas,", "words": [[0, 121914], [2, 122005], [10, 122525], [13, 122725], [17, 122885], [22, 123125], [27, 123565], [30, 123685], [34, 123805], [42, 124805], [46, 125085], [49, 125305], [53, 125425], [57, 125565], [63, 125805], [66, 126025]]}, {"verse": 20, "start": 127116, "end": 133139, "text": "Instructor de los que no saben, maestro de niños, que tienes la forma del conocimiento y de la verdad en la ley:", "words": [[0, 127415], [11, 127745], [14, 127845], [18, 127965], [22, 128125], [25, 128245], [32, 128625], [40, 129065], [43, 129205], [50, 129785], [54, 129985], [61, 130205], [64, 130385], [70, 130645], [74, 130825], [87, 131665], [89, 131905], [92, 131985], [95, 132085], [102, 132365], [105, 132685], [108, 132785]]}, {"verse": 21, "start": 133489, "end": 139686, "text": "Tú pues, que enseñas a otro, ¿no te enseñas a ti mismo? ¿Tú, que predicas que no se ha de hurtar, hurtas?", "words": [[0, 133489], [3, 133613], [9, 133953], [13, 134133], [21, 134573], [23, 134693], [29, 135353], [33, 135473], [36, 135613], [44, 136073], [46, 136173], [49, 136253], [56, 137016], [61, 137112], [65, 137232], [74, 137812], [78, 137932], [81, 138065], [84, 138199], [87, 138332], [90, 138802], [98, 139272]]}, {"verse": 22, "start": 140036, "end": 145725, "text": "¿Tú, que dices que no se ha de adulterar, adulteras? ¿Tú, que abominas los ídolos, cometes sacrilegio?", "words": [[0, 140036], [5, 140112], [9, 140232], [15, 140532], [19, 140712], [22, 140892], [25, 141092], [28, 141212], [31, 141292], [42, 141952], [53, 142945], [58, 143064], [62, 143164], [71, 143664], [75, 143824], [83, 144324], [91, 144824]]}, {"verse": 23, "start": 146075, "end": 150458, "text": "¿Tú, que te jactas de la ley, con infracción de la ley deshonras a Dios?", "words": [[0, 146075], [5, 146233], [9, 146353], [12, 146513], [19, 147013], [22, 147133], [25, 147293], [30, 147553], [34, 147853], [45, 148533], [48, 148693], [51, 148833], [55, 149073], [65, 149793], [67, 149953]]}, {"verse": 24, "start": 150808, "end": 156587, "text": "Porque el nombre de Dios es blasfemado por causa de vosotros entre los Gentiles, como está escrito.", "words": [[0, 150808], [7, 151030], [10, 151170], [17, 151430], [20, 151610], [25, 151910], [28, 152250], [39, 152990], [43, 153190], [49, 153430], [52, 153710], [61, 154150], [67, 154450], [71, 154630], [81, 155210], [86, 155730], [91, 155970]]}, {"verse": 25, "start": 156937, "end": 165336, "text": "Porque la circuncisión en verdad aprovecha, si guardas la ley; pero si eres rebelde a la ley, tu circuncisión es hecha incircuncisión.", "words": [[0, 156937], [7, 157146], [10, 157346], [23, 158166], [26, 158266], [33, 158526], [44, 159306], [47, 159526], [55, 159946], [58, 160066], [63, 160619], [68, 160741], [71, 160941], [76, 161161], [84, 161701], [86, 161761], [89, 161861], [94, 162441], [97, 162561], [110, 163421], [113, 163721], [119, 164556]]}, {"verse": 26, "start": 165686, "end": 172104, "text": "De manera que, si el incircunciso guardare las ordenanzas de la ley, ¿no será tenida su incircuncisión por circuncisión?", "words": [[0, 165686], [3, 165782], [10, 166002], [15, 166262], [18, 166422], [21, 166502], [34, 167242], [43, 167682], [47, 167822], [58, 168482], [61, 168582], [64, 168702], [69, 169242], [73, 169362], [78, 169542], [85, 169942], [88, 170102], [103, 170882], [107, 171082]]}, {"verse": 27, "start": 172454, "end": 181620, "text": "Y el que no está circuncidado físicamente, pero guarda perfectamente la ley, te juzgará a ti, que con la letra y con la circuncisión eres rebelde a la ley.", "words": [[0, 172454], [2, 172614], [5, 172734], [9, 172854], [12, 172994], [17, 173214], [30, 174074], [43, 175074], [48, 175374], [55, 175774], [69, 176534], [72, 176694], [77, 177254], [80, 177394], [88, 177914], [90, 178054], [94, 178174], [98, 178574], [102, 178754], [105, 178894], [111, 179234], [113, 179294], [117, 179394], [120, 179494], [133, 180274], [138, 180534], [146, 181114], [148, 181194], [151, 181254]]}, {"verse": 28, "start": 181970, "end": 188186, "text": "Porque no es judío el que lo es exteriormente; ni la circuncisión es la que es exteriormente en la carne:", "words": [[0, 181970], [7, 182150], [10, 182330], [13, 182510], [19, 182890], [22, 183030], [26, 183150], [29, 183290], [32, 183450], [47, 184668], [50, 184817], [53, 184957], [66, 185977], [69, 186257], [72, 186357], [76, 186517], [79, 186677], [93, 187417], [96, 187537], [99, 187657]]}, {"verse": 29, "start": 188536, "end": 198725, "text": "Pero es judío el que lo es en lo interior; y la circuncisión es la del corazón, en espíritu, no en letra; la alabanza del cual no es de los hombres, sino de Dios.", "words": [[0, 188536], [5, 188675], [8, 188875], [14, 189135], [17, 189395], [21, 189515], [24, 189695], [27, 189935], [30, 190155], [33, 190255], [43, 191076], [45, 191169], [48, 191269], [61, 192249], [64, 192449], [67, 192629], [71, 192809], [80, 193709], [83, 193909], [93, 194829], [96, 194909], [99, 195049], [106, 195718], [109, 195844], [118, 196404], [122, 196544], [127, 196764], [130, 197004], [133, 197104], [136, 197224], [140, 197344], [149, 197704], [154, 198004], [157, 198204]]}]}