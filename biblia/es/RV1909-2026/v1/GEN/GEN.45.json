{"book": "GEN", "chapter": 45, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 248421, "verses": [{"verse": 1, "start": 300, "end": 10826, "text": "No podía ya José contenerse delante de todos los que estaban al lado suyo, y clamó: Haced salir de conmigo a todos. Y no quedó nadie con él, al darse a conocer José a sus hermanos.", "words": [[0, 300], [3, 438], [9, 738], [12, 958], [17, 1238], [28, 1938], [36, 2318], [39, 2458], [45, 2678], [49, 2878], [53, 3018], [61, 3258], [64, 3458], [69, 3578], [75, 4138], [77, 4358], [84, 5237], [90, 5387], [96, 5627], [99, 5807], [107, 6187], [109, 6307], [116, 7086], [118, 7186], [121, 7286], [127, 7606], [133, 7946], [137, 8246], [141, 8466], [144, 8786], [150, 9126], [152, 9186], [160, 9486], [165, 9866], [167, 10066], [171, 10166]]}, {"verse": 2, "start": 11176, "end": 19079, "text": "Entonces se dio a llorar a voz en grito; y oyeron los egipcios, y oyó también la casa de Faraón.", "words": [[0, 11176], [9, 11803], [12, 12243], [16, 12503], [18, 12683], [25, 13083], [27, 13233], [31, 13383], [34, 13723], [41, 14661], [43, 14825], [50, 15165], [54, 15405], [64, 16545], [66, 16905], [70, 17205], [78, 17505], [81, 17805], [86, 18065], [89, 18265]]}, {"verse": 3, "start": 19379, "end": 28313, "text": "Y dijo José a sus hermanos: Yo soy José: ¿vive aún mi padre? Y sus hermanos no pudieron responderle, porque estaban turbados delante de él.", "words": [[0, 19379], [2, 19485], [7, 19785], [12, 20145], [14, 20365], [18, 20465], [28, 21517], [31, 21695], [35, 21895], [41, 22746], [47, 22967], [51, 23147], [54, 23347], [61, 24187], [63, 24290], [67, 24410], [76, 24950], [79, 25050], [88, 25430], [101, 26270], [108, 26490], [116, 26850], [125, 27410], [133, 27850], [136, 28030]]}, {"verse": 4, "start": 28663, "end": 42200, "text": "Entonces dijo José a sus hermanos: Acercaos ahora a mí. Y ellos se llegaron. Y él dijo: Yo soy José vuestro hermano el que vendisteis para Egipto.", "words": [[0, 28663], [9, 29270], [14, 29990], [19, 30350], [21, 30650], [25, 30810], [35, 32188], [44, 32508], [50, 32768], [52, 33008], [56, 35928], [58, 36133], [64, 36453], [67, 36773], [77, 37897], [79, 38062], [82, 38222], [88, 39047], [91, 39210], [95, 39390], [100, 39850], [108, 40130], [116, 40630], [119, 40730], [123, 40850], [134, 41450], [139, 41630]]}, {"verse": 5, "start": 42650, "end": 50223, "text": "Ahora pues, no os entristezcáis, ni os pese de haberme vendido acá; que para preservación de vida me envió Dios delante de vosotros:", "words": [[0, 42650], [6, 42928], [12, 43128], [15, 43408], [18, 43878], [33, 44348], [36, 44868], [39, 45008], [44, 45268], [47, 45408], [55, 45728], [63, 46128], [68, 46831], [72, 46932], [77, 47112], [90, 47812], [93, 47972], [98, 48192], [101, 48372], [107, 48692], [112, 48912], [120, 49352], [123, 49492]]}, {"verse": 6, "start": 50673, "end": 56907, "text": "Que ya ha habido dos años de hambre en medio de la tierra, y aún quedan cinco años en que no habrá siembra ni cosecha.", "words": [[0, 50673], [4, 50767], [7, 50947], [10, 51127], [17, 51307], [21, 51507], [26, 51807], [29, 52067], [36, 52347], [39, 52447], [45, 52647], [48, 52807], [51, 52907], [59, 53187], [61, 53787], [65, 53947], [72, 54327], [78, 54647], [83, 54987], [86, 55207], [90, 55327], [93, 55507], [99, 55747], [107, 56167], [110, 56287]]}, {"verse": 7, "start": 57357, "end": 63656, "text": "Y Dios me envió delante de vosotros, para que vosotros quedaseis en la tierra, y para daros vida por medio de gran liberación.", "words": [[0, 57357], [2, 57478], [7, 57638], [10, 57838], [16, 58118], [24, 58438], [27, 58558], [37, 58998], [42, 59238], [46, 59358], [55, 59698], [65, 60318], [68, 60418], [71, 60538], [79, 60838], [81, 61398], [86, 61618], [92, 61918], [97, 62138], [101, 62358], [107, 62598], [110, 62758], [115, 62918]]}, {"verse": 8, "start": 64106, "end": 75051, "text": "Así pues, no me enviasteis vosotros acá, sino Dios, que me ha puesto por padre de Faraón, y por señor de toda su casa, y por gobernador en toda la tierra de Egipto.", "words": [[0, 64106], [4, 64321], [10, 64581], [13, 64821], [16, 64961], [27, 65561], [36, 66001], [41, 66821], [46, 66961], [52, 67721], [56, 67781], [59, 67921], [62, 68021], [69, 68281], [73, 68561], [79, 68841], [82, 69021], [90, 69521], [92, 69801], [96, 69941], [102, 70221], [105, 70421], [110, 70581], [113, 70821], [119, 71658], [121, 71761], [125, 71901], [136, 72521], [139, 72781], [144, 72901], [147, 73101], [154, 73340], [157, 73521]]}, {"verse": 9, "start": 75501, "end": 84786, "text": "Daos prisa, id a mi padre y decidle: Así dice tu hijo José: Dios me ha puesto por señor de todo Egipto; ven a mí, no te detengas:", "words": [[0, 75501], [5, 75861], [12, 76241], [15, 76621], [17, 76721], [20, 76821], [26, 77161], [28, 77601], [37, 78286], [41, 78485], [46, 78785], [49, 79005], [54, 79245], [60, 80141], [65, 80379], [68, 80599], [71, 80699], [78, 80979], [82, 81259], [88, 81559], [91, 81859], [96, 82039], [104, 83024], [108, 83229], [110, 83349], [114, 83809], [117, 83929], [120, 84049]]}, {"verse": 10, "start": 85236, "end": 95341, "text": "Y habitarás en la tierra de Gosén, y estarás cerca de mí, tú y tus hijos, y los hijos de tus hijos, tus ganados y tus vacas, y todo lo que tienes.", "words": [[0, 85236], [2, 85355], [12, 85935], [15, 86035], [18, 86115], [25, 86395], [28, 86755], [35, 87115], [37, 87515], [45, 87955], [51, 88255], [54, 88535], [58, 89195], [61, 89455], [63, 89735], [67, 89915], [74, 90715], [76, 90775], [80, 90935], [86, 91235], [89, 91435], [93, 91615], [100, 92235], [104, 92315], [112, 92835], [114, 93055], [118, 93195], [125, 94119], [127, 94235], [132, 94395], [135, 94595], [139, 94695]]}, {"verse": 11, "start": 95791, "end": 103899, "text": "Y allí te alimentaré, pues aún quedan cinco años de hambre, para que no perezcas de pobreza tú y tu casa, y todo lo que tienes:", "words": [[0, 95791], [2, 95897], [7, 96097], [10, 96317], [22, 97337], [27, 97457], [31, 97757], [38, 98217], [44, 98517], [49, 98817], [52, 99037], [60, 99417], [65, 99877], [69, 100037], [72, 100197], [81, 100717], [84, 100877], [92, 101377], [95, 101657], [97, 101837], [100, 101957], [106, 102277], [108, 102777], [113, 102997], [116, 103197], [120, 103317]]}, {"verse": 12, "start": 104349, "end": 109499, "text": "Y he aquí, vuestros ojos ven, y los ojos de mi hermano Benjamín, que mi boca os habla.", "words": [[0, 104349], [2, 104470], [5, 104610], [11, 104850], [20, 105290], [25, 105530], [30, 105910], [32, 106270], [36, 106430], [41, 106670], [44, 106910], [47, 107050], [55, 107470], [65, 108310], [69, 108430], [72, 108570], [77, 108810], [80, 109050]]}, {"verse": 13, "start": 109949, "end": 117192, "text": "Haréis pues saber a mi padre toda mi gloria en Egipto, y todo lo que habéis visto: y daos prisa, y traed a mi padre acá.", "words": [[0, 109949], [7, 110272], [12, 110452], [18, 110752], [20, 110872], [23, 110992], [29, 111332], [34, 111672], [37, 111892], [44, 112252], [47, 112352], [55, 112912], [57, 113252], [62, 113432], [65, 113612], [69, 113732], [76, 113952], [83, 114784], [85, 114921], [90, 115141], [97, 115621], [99, 115848], [105, 116074], [107, 116301], [110, 116461], [116, 116701]]}, {"verse": 14, "start": 117542, "end": 124229, "text": "Y se echó sobre el cuello de Benjamín su hermano, y lloró; y también Benjamín lloró sobre su cuello.", "words": [[0, 117542], [2, 117706], [5, 117806], [10, 118146], [16, 118426], [19, 118626], [26, 118946], [29, 119086], [38, 119526], [41, 119806], [50, 120546], [52, 120746], [59, 121536], [61, 121696], [69, 121996], [78, 122536], [84, 123276], [90, 123496], [93, 123716]]}, {"verse": 15, "start": 124679, "end": 130771, "text": "Y besó a todos sus hermanos, y lloró sobre ellos: y después sus hermanos hablaron con él.", "words": [[0, 124679], [2, 124937], [7, 125317], [9, 125417], [15, 125657], [19, 125997], [29, 126697], [31, 126877], [37, 127257], [43, 127497], [50, 128486], [52, 128618], [60, 128858], [64, 129158], [73, 129778], [82, 130238], [86, 130535]]}, {"verse": 16, "start": 131221, "end": 141416, "text": "Y se oyó la noticia en la casa de Faraón, diciendo: Los hermanos de José han venido. Y agradó a los ojos de Faraón y de sus siervos.", "words": [[0, 131221], [2, 131408], [5, 131548], [9, 131908], [12, 132048], [20, 132728], [23, 132908], [26, 133068], [31, 133368], [34, 133778], [42, 134188], [52, 135562], [56, 135667], [65, 136247], [68, 136327], [73, 136627], [77, 137047], [85, 138033], [87, 138194], [94, 138694], [96, 138794], [100, 138934], [105, 139254], [108, 139454], [115, 140034], [117, 140234], [120, 140354], [124, 140494]]}, {"verse": 17, "start": 141866, "end": 149753, "text": "Y dijo Faraón a José: Di a tus hermanos: Haced esto: cargad vuestras bestias, e id, volved a la tierra de Canaán;", "words": [[0, 141866], [2, 141970], [7, 142290], [14, 142610], [16, 142930], [22, 143845], [25, 143995], [27, 144055], [31, 144135], [41, 145400], [47, 145660], [53, 146507], [60, 146687], [69, 147067], [78, 147567], [80, 147920], [84, 148274], [91, 148627], [93, 148767], [96, 148787], [103, 148987], [106, 149387]]}, {"verse": 18, "start": 150203, "end": 157632, "text": "Y tomad a vuestro padre y vuestras familias, y venid a mí, que yo os daré lo bueno de la tierra de Egipto y comeréis lo mejor de la tierra.", "words": [[0, 150203], [2, 150337], [8, 150511], [10, 150684], [18, 151044], [24, 151364], [26, 151544], [35, 151904], [45, 152564], [47, 152864], [53, 153164], [55, 153264], [59, 153384], [63, 153944], [66, 154144], [69, 154264], [74, 154524], [77, 154604], [83, 154884], [86, 155044], [89, 155144], [96, 155424], [99, 155624], [106, 156044], [108, 156124], [117, 156504], [120, 156644], [126, 156864], [129, 157024], [132, 157124]]}, {"verse": 19, "start": 158082, "end": 166491, "text": "Y tú manda: Haced esto: tomad de la tierra de Egipto carros para vuestros niños y vuestras mujeres; y tomad a vuestro padre, y venid.", "words": [[0, 158082], [2, 158198], [5, 158318], [12, 159352], [18, 159612], [24, 160316], [30, 160639], [33, 160759], [36, 160859], [43, 161159], [46, 161359], [53, 161819], [60, 162159], [65, 162379], [74, 162779], [80, 163079], [82, 163339], [91, 163679], [100, 164624], [102, 164732], [108, 165072], [110, 165132], [118, 165432], [125, 165732], [127, 166092]]}, {"verse": 20, "start": 166941, "end": 172037, "text": "Y no se os dé nada de vuestras pertenencias, porque el bien de la tierra de Egipto será vuestro.", "words": [[0, 166941], [2, 167057], [5, 167157], [8, 167337], [11, 167497], [14, 167657], [19, 167817], [22, 167977], [31, 168297], [45, 169377], [52, 169737], [55, 169897], [60, 170057], [63, 170217], [66, 170317], [73, 170637], [76, 170777], [83, 171197], [88, 171417]]}, {"verse": 21, "start": 172387, "end": 183493, "text": "Y lo hicieron así los hijos de Israel: y les dio José carros conforme a la orden de Faraón, y les suministró víveres para el camino.", "words": [[0, 172387], [2, 172531], [5, 172671], [14, 173231], [18, 173571], [22, 174071], [28, 174451], [31, 175042], [39, 175873], [41, 176115], [45, 176275], [49, 176495], [54, 176965], [61, 177435], [70, 178255], [72, 178355], [75, 178435], [81, 178775], [84, 179235], [92, 179695], [94, 180135], [98, 180335], [109, 181475], [117, 182275], [122, 182655], [125, 182815]]}, {"verse": 22, "start": 183943, "end": 191500, "text": "A cada uno de todos ellos dio cambios de ropa, y a Benjamín dio trescientas piezas de plata, y cinco cambios de ropa.", "words": [[0, 183943], [2, 184068], [7, 184268], [11, 184588], [14, 184768], [20, 185008], [26, 185408], [30, 185688], [38, 186268], [41, 186368], [47, 186828], [49, 187468], [51, 187568], [60, 187948], [64, 188308], [76, 188988], [83, 189348], [86, 189468], [93, 189768], [95, 189948], [101, 190268], [109, 190808], [112, 190908]]}, {"verse": 23, "start": 191950, "end": 203742, "text": "Y a su padre envió esto: diez asnos cargados de lo mejor de Egipto, y diez asnas cargadas de trigo, y pan y comida, para su padre en el camino.", "words": [[0, 191950], [2, 192108], [4, 192208], [7, 192368], [13, 192828], [19, 193488], [25, 194368], [30, 194596], [36, 195256], [45, 196096], [48, 196276], [51, 196396], [57, 196696], [60, 196916], [68, 197616], [70, 198036], [75, 198256], [81, 198796], [90, 199416], [93, 199596], [100, 200076], [102, 200596], [106, 200896], [108, 201216], [116, 201656], [121, 202216], [124, 202396], [130, 202756], [133, 202976], [136, 203076]]}, {"verse": 24, "start": 204192, "end": 210620, "text": "Y despidió a sus hermanos, y se fueron. Y él les dijo: No riñáis por el camino.", "words": [[0, 204192], [2, 204556], [11, 205076], [13, 205196], [17, 205316], [27, 206136], [29, 206576], [32, 206696], [40, 207622], [42, 207828], [45, 208008], [49, 208308], [55, 209155], [58, 209311], [65, 209751], [69, 209991], [72, 210111]]}, {"verse": 25, "start": 210970, "end": 216386, "text": "Y subieron de Egipto, y llegaron a la tierra de Canaán a Jacob su padre.", "words": [[0, 210970], [2, 211067], [11, 211567], [14, 211807], [22, 212547], [24, 212947], [33, 213507], [35, 213627], [38, 213707], [45, 214027], [48, 214327], [55, 214767], [57, 215007], [63, 215627], [66, 215727]]}, {"verse": 26, "start": 216836, "end": 227214, "text": "Y le dieron las nuevas, diciendo: José vive aún; y él es señor en toda la tierra de Egipto. Y su corazón se desmayó; pues no los creía.", "words": [[0, 216836], [2, 216946], [5, 217046], [12, 217386], [16, 217546], [24, 217886], [34, 219309], [39, 219700], [44, 220125], [49, 220790], [51, 220957], [54, 221117], [57, 221297], [63, 221637], [66, 221997], [71, 222197], [74, 222437], [81, 222717], [84, 222957], [92, 223879], [94, 224025], [97, 224165], [105, 224565], [108, 224905], [117, 226003], [122, 226125], [125, 226325], [129, 226465]]}, {"verse": 27, "start": 227664, "end": 240574, "text": "Y ellos le contaron todas las palabras de José, que él les había hablado; y viendo él los carros que José enviaba para llevarlo, el espíritu de Jacob su padre revivió.", "words": [[0, 227664], [2, 228010], [8, 228270], [11, 228450], [20, 229050], [26, 229350], [30, 229650], [39, 230030], [42, 230270], [48, 230570], [52, 231110], [55, 231330], [59, 231670], [65, 232030], [74, 233057], [76, 233181], [83, 233501], [86, 233721], [90, 233901], [97, 234501], [101, 234881], [106, 235201], [114, 236041], [119, 236301], [129, 237301], [132, 237421], [141, 238081], [144, 238161], [150, 238841], [153, 239041], [159, 239861]]}, {"verse": 28, "start": 241024, "end": 248021, "text": "Entonces dijo Israel: Basta; José mi hijo vive todavía: iré, y le veré antes que yo muera.", "words": [[0, 241024], [9, 241696], [14, 242296], [22, 243385], [29, 244159], [34, 244325], [37, 244585], [42, 244785], [47, 244965], [56, 245949], [61, 246287], [63, 246667], [66, 246807], [71, 247047], [77, 247247], [81, 247467], [84, 247587]]}]}