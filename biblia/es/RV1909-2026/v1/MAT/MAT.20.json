{"book": "MAT", "chapter": 20, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 290084, "verses": [{"verse": 1, "start": 300, "end": 8791, "text": "Porque el reino de los cielos es semejante a un propietario, que salió por la mañana a contratar trabajadores para su viña.", "words": [[0, 300], [7, 522], [10, 702], [16, 1082], [19, 1202], [23, 1362], [30, 1882], [33, 2082], [43, 2862], [45, 2982], [48, 3122], [61, 4082], [65, 4622], [71, 5042], [75, 5262], [78, 5462], [85, 5862], [87, 6202], [97, 6922], [110, 7702], [115, 8002], [118, 8182]]}, {"verse": 2, "start": 9241, "end": 15162, "text": "Y habiendo acordado con los obreros en un denario al día, los envió a su viña.", "words": [[0, 9241], [2, 9382], [11, 9762], [20, 10442], [24, 10642], [28, 11062], [36, 11482], [39, 11702], [42, 11843], [50, 12362], [53, 12582], [58, 13502], [62, 13762], [68, 14242], [70, 14382], [73, 14502]]}, {"verse": 3, "start": 15612, "end": 22384, "text": "Y saliendo cerca de la tercera hora del día, vio otros que estaban en la plaza ociosos;", "words": [[0, 15612], [2, 16036], [11, 16516], [17, 16856], [20, 17136], [23, 17256], [31, 17836], [36, 18116], [40, 18356], [45, 19216], [49, 19576], [55, 20036], [59, 20436], [67, 20796], [70, 20996], [73, 21116], [79, 21416]]}, {"verse": 4, "start": 22834, "end": 28977, "text": "Y les dijo: Id también vosotros a mi viña, y os daré lo que sea justo. Y ellos fueron.", "words": [[0, 22834], [2, 23103], [6, 23407], [12, 23993], [15, 24073], [23, 24373], [32, 25013], [34, 25213], [37, 25333], [43, 25753], [45, 26153], [48, 26293], [53, 26553], [56, 26633], [60, 26773], [64, 26933], [71, 27908], [73, 28074], [79, 28234]]}, {"verse": 5, "start": 29427, "end": 34115, "text": "Salió otra vez cerca de las horas sexta y novena, e hizo lo mismo.", "words": [[0, 29427], [6, 29849], [11, 30169], [15, 30429], [21, 30849], [24, 31089], [28, 31249], [34, 31449], [40, 32089], [42, 32189], [50, 32749], [52, 33029], [57, 33389], [60, 33589]]}, {"verse": 6, "start": 34565, "end": 43825, "text": "Y saliendo cerca de la hora undécima, halló otros que estaban ociosos; y les dice: ¿Por qué estáis aquí todo el día ociosos?", "words": [[0, 34565], [2, 34694], [11, 35194], [17, 35534], [20, 35794], [23, 35934], [28, 36554], [38, 37174], [44, 37634], [50, 38054], [54, 38334], [62, 38714], [71, 40134], [73, 40260], [77, 40380], [83, 41261], [88, 41384], [92, 41704], [99, 42024], [104, 42344], [109, 42444], [112, 42704], [116, 42864]]}, {"verse": 7, "start": 44275, "end": 52876, "text": "Le dicen: Porque nadie nos ha contratado. Les dice: Id también vosotros a la viña, y recibiréis lo que sea justo.", "words": [[0, 44275], [3, 44440], [10, 45389], [17, 45649], [23, 46009], [27, 46269], [30, 46409], [42, 47684], [46, 47774], [52, 48732], [55, 48832], [63, 49092], [72, 49752], [74, 49952], [77, 50032], [83, 50552], [85, 50992], [96, 51772], [99, 51932], [103, 52052], [107, 52232]]}, {"verse": 8, "start": 53326, "end": 64245, "text": "Y cuando fue la tarde del día, el señor de la viña dijo a su encargado: Llama a los obreros y págales el salario, comenzando desde los últimos hasta los primeros.", "words": [[0, 53326], [2, 53616], [9, 53776], [13, 53996], [16, 54136], [22, 54456], [26, 54776], [31, 55496], [34, 55616], [40, 55936], [43, 56116], [46, 56236], [51, 56696], [56, 57296], [58, 57516], [61, 57636], [72, 58795], [78, 59101], [80, 59321], [84, 59651], [92, 59981], [94, 60141], [102, 60721], [105, 60881], [114, 61601], [125, 62321], [131, 62501], [135, 62721], [143, 63081], [149, 63381], [153, 63561]]}, {"verse": 9, "start": 64695, "end": 70871, "text": "Y viniendo los que habían ido cerca de la hora undécima, recibieron cada uno un denario.", "words": [[0, 64695], [2, 64793], [11, 65273], [15, 65473], [19, 65633], [26, 65933], [30, 66173], [36, 66613], [39, 66893], [42, 67033], [47, 67693], [57, 68353], [68, 69053], [73, 69333], [77, 69713], [80, 70033]]}, {"verse": 10, "start": 71321, "end": 80214, "text": "Y viniendo también los primeros, pensaron que habían de recibir más; pero también ellos recibieron cada uno un denario.", "words": [[0, 71321], [2, 71568], [11, 71848], [19, 72208], [23, 72448], [33, 73408], [42, 74248], [46, 74488], [53, 74808], [56, 75028], [64, 75448], [69, 76514], [74, 76851], [82, 77271], [88, 77631], [99, 78651], [104, 78911], [108, 79211], [111, 79411]]}, {"verse": 11, "start": 80664, "end": 84330, "text": "Y tomándolo, murmuraban contra el padre de la familia,", "words": [[0, 80664], [2, 80742], [13, 81342], [24, 82162], [31, 82562], [34, 82782], [40, 83122], [43, 83382], [46, 83502]]}, {"verse": 12, "start": 84780, "end": 94612, "text": "Diciendo: Estos últimos sólo han trabajado una hora, y los has hecho iguales a nosotros, que hemos llevado la carga y el calor del día.", "words": [[0, 84780], [10, 86065], [16, 86486], [24, 86866], [29, 87266], [33, 87486], [43, 88146], [47, 88426], [53, 88766], [55, 89286], [59, 89446], [63, 89666], [69, 90126], [77, 90866], [79, 90986], [89, 91406], [93, 91946], [99, 92106], [107, 92546], [110, 92726], [116, 93106], [118, 93326], [121, 93446], [127, 93766], [131, 94046]]}, {"verse": 13, "start": 95062, "end": 103680, "text": "Y él respondiendo, dijo a uno de ellos: Amigo, no cometo injusticia contigo; ¿no te concertaste conmigo por un denario?", "words": [[0, 95062], [2, 95322], [5, 95462], [19, 96222], [24, 96502], [26, 96722], [30, 96902], [33, 97062], [40, 98573], [47, 98983], [50, 99083], [57, 99603], [68, 100263], [77, 101351], [81, 101438], [84, 101558], [96, 102178], [104, 102618], [108, 102858], [111, 102998]]}, {"verse": 14, "start": 104130, "end": 108399, "text": "Toma lo que es tuyo, y vete; pero quiero dar a este último, como a ti.", "words": [[0, 104130], [5, 104336], [8, 104476], [12, 104596], [15, 104756], [21, 105096], [23, 105296], [29, 106065], [34, 106189], [41, 106469], [45, 106749], [47, 106909], [52, 107309], [60, 107709], [65, 107909], [67, 108089]]}, {"verse": 15, "start": 108849, "end": 115562, "text": "¿No me es lícito a mí hacer lo que quiero con lo mío? o ¿es malo tu ojo, porque yo soy bueno?", "words": [[0, 108849], [4, 109014], [7, 109194], [10, 109374], [17, 109934], [19, 110134], [22, 110254], [28, 110554], [31, 110794], [35, 110934], [42, 111214], [46, 111414], [49, 111574], [54, 112369], [56, 112623], [60, 112743], [65, 113223], [68, 113383], [73, 114183], [80, 114523], [83, 114743], [87, 114943]]}, {"verse": 16, "start": 116012, "end": 124705, "text": "Así los primeros serán últimos, y los últimos primeros: porque muchos son llamados, pero pocos escogidos.", "words": [[0, 116012], [4, 116211], [8, 116411], [17, 117111], [23, 117731], [32, 118291], [34, 118931], [38, 119111], [46, 119531], [56, 120768], [63, 121011], [70, 121471], [74, 121951], [84, 122671], [89, 122931], [95, 123731]]}, {"verse": 17, "start": 125155, "end": 131086, "text": "Y subiendo Jesús a Jerusalén, tomó sus doce discípulos aparte en el camino, y les dijo:", "words": [[0, 125155], [2, 125260], [11, 125720], [17, 126080], [19, 126340], [30, 127420], [35, 127700], [39, 127900], [44, 128400], [55, 129120], [62, 129720], [65, 129820], [68, 129940], [76, 130300], [78, 130460], [82, 130580]]}, {"verse": 18, "start": 131536, "end": 141561, "text": "He aquí subimos a Jerusalén, y el Hijo del hombre será entregado a los príncipes de los sacerdotes y a los escribas, y le condenarán a muerte;", "words": [[0, 131587], [3, 131677], [8, 131897], [16, 132457], [18, 132597], [29, 133597], [31, 133877], [34, 133997], [39, 134277], [43, 134417], [50, 134857], [55, 135097], [65, 135837], [67, 135917], [71, 136037], [81, 136817], [84, 136937], [88, 137077], [99, 137917], [101, 138297], [103, 138357], [107, 138477], [117, 139757], [119, 139857], [122, 139977], [133, 140777], [135, 140917]]}, {"verse": 19, "start": 142011, "end": 151557, "text": "Y le entregarán a los Gentiles para que se burlen de él, lo azoten y lo crucifiquen; pero al tercer día resucitará.", "words": [[0, 142011], [2, 142135], [5, 142255], [16, 142955], [18, 143035], [22, 143155], [31, 143775], [36, 144315], [40, 144475], [43, 144655], [50, 145115], [53, 145315], [57, 146155], [60, 146505], [67, 146855], [69, 147555], [72, 148178], [85, 149028], [90, 149328], [93, 149528], [100, 149828], [104, 150268]]}, {"verse": 20, "start": 152007, "end": 159600, "text": "Entonces se llegó a él la madre de los hijos de Zebedeo con sus hijos, adorándole, y pidiéndole algo.", "words": [[0, 152007], [9, 152449], [12, 152769], [18, 153089], [20, 153369], [23, 153849], [26, 153929], [32, 154289], [35, 154489], [39, 154629], [45, 154949], [48, 155429], [56, 155909], [60, 156009], [64, 156249], [71, 157049], [83, 157869], [85, 158309], [96, 159009]]}, {"verse": 21, "start": 160050, "end": 170299, "text": "Y él le dijo: ¿Qué quieres? Ella le dijo: Di que se sienten estos dos hijos míos, el uno a tu mano derecha, y el otro a tu izquierda, en tu reino.", "words": [[0, 160050], [2, 160219], [5, 160339], [8, 160479], [14, 161213], [19, 161337], [28, 162216], [33, 162441], [36, 162641], [42, 164065], [45, 164115], [49, 164215], [52, 164355], [60, 164875], [66, 165135], [70, 165415], [76, 165655], [82, 166435], [85, 166575], [89, 166795], [91, 166935], [94, 167015], [99, 167215], [108, 167875], [110, 168195], [113, 168315], [118, 168515], [120, 168655], [123, 168755], [134, 169575], [137, 169655], [140, 169795]]}, {"verse": 22, "start": 170649, "end": 186575, "text": "Entonces Jesús respondiendo, dijo: No sabéis lo que pedís: ¿podéis beber la copa que yo he de beber, y ser bautizados del bautismo de que yo soy bautizado? Y ellos le dicen: Podemos.", "words": [[0, 170649], [9, 171158], [15, 172258], [29, 173078], [35, 173804], [38, 173992], [45, 174512], [48, 174692], [52, 174832], [59, 175746], [67, 176050], [73, 176330], [76, 176590], [81, 176970], [85, 177070], [88, 177270], [91, 177390], [94, 177510], [101, 177790], [103, 178190], [107, 178390], [118, 179130], [122, 179330], [131, 179930], [134, 180090], [138, 180210], [141, 180370], [145, 180570], [156, 181785], [158, 181894], [164, 182094], [167, 182314], [174, 183183]]}, {"verse": 23, "start": 186925, "end": 204657, "text": "Y él les dice: A la verdad mi copa beberéis, y del bautismo de que yo soy bautizado, seréis bautizados; pero el sentaros a mi mano derecha y a mi izquierda, no es mío darlo, sino a aquellos para quienes está preparado por mi Padre.", "words": [[0, 186925], [2, 187129], [5, 187309], [9, 187609], [15, 188552], [17, 188656], [20, 188736], [27, 189476], [30, 189816], [35, 190156], [45, 190736], [47, 191256], [51, 191416], [60, 192036], [63, 192216], [67, 192336], [70, 192516], [74, 192736], [85, 193836], [92, 194256], [104, 195771], [109, 195937], [112, 196097], [121, 196677], [123, 196857], [126, 196977], [131, 197197], [139, 197777], [141, 197957], [143, 198017], [146, 198137], [157, 198897], [160, 199517], [163, 199637], [167, 199917], [174, 200837], [179, 201157], [181, 201517], [190, 201897], [195, 202317], [203, 202597], [208, 202997], [218, 203637], [222, 203837], [225, 204017]]}, {"verse": 24, "start": 205107, "end": 209768, "text": "Y como los diez oyeron esto, se enojaron de los dos hermanos.", "words": [[0, 205107], [2, 205209], [7, 205409], [11, 205589], [16, 205849], [23, 206629], [29, 207349], [32, 207649], [41, 208329], [44, 208469], [48, 208629], [52, 208829]]}, {"verse": 25, "start": 210218, "end": 220809, "text": "Entonces Jesús llamándolos, dijo: Sabéis que los príncipes de los Gentiles los dominan, y los que son grandes ejercen autoridad sobre ellos.", "words": [[0, 210218], [9, 210759], [15, 211839], [28, 212499], [34, 213368], [41, 213878], [45, 214058], [49, 214218], [59, 214938], [62, 215098], [66, 215198], [75, 215738], [79, 215958], [88, 216618], [90, 216978], [94, 217118], [98, 217238], [102, 217438], [110, 217878], [118, 218718], [128, 219538], [134, 219998]]}, {"verse": 26, "start": 221259, "end": 229208, "text": "Pero entre vosotros no será así; sino que el que quiera hacerse grande entre vosotros será vuestro servidor;", "words": [[0, 221259], [5, 221423], [11, 221683], [20, 222403], [23, 223023], [28, 223303], [33, 224136], [38, 224376], [42, 224676], [45, 224936], [49, 225116], [56, 225436], [64, 225916], [71, 226336], [77, 226636], [86, 227316], [91, 227836], [99, 228356]]}, {"verse": 27, "start": 229658, "end": 233920, "text": "Y el que quiera ser el primero entre vosotros, será vuestro siervo:", "words": [[0, 229658], [2, 229782], [5, 229882], [9, 230002], [16, 230302], [20, 230602], [23, 230742], [31, 231122], [37, 231362], [47, 232022], [52, 232622], [60, 233282]]}, {"verse": 28, "start": 234370, "end": 242122, "text": "Como el Hijo del hombre no vino para ser servido, sino para servir, y para dar su vida en rescate por muchos.", "words": [[0, 234370], [5, 234534], [8, 234694], [13, 234954], [17, 235114], [24, 235674], [27, 235954], [32, 236194], [37, 236474], [41, 236754], [50, 237674], [55, 237954], [60, 238274], [68, 238754], [70, 239314], [75, 239554], [79, 239794], [82, 240074], [87, 240394], [90, 240554], [98, 241134], [102, 241354]]}, {"verse": 29, "start": 242572, "end": 248027, "text": "Entonces saliendo ellos de Jericó, le seguía una gran multitud.", "words": [[0, 242572], [9, 243635], [18, 244275], [24, 244575], [27, 244875], [35, 245815], [38, 245895], [45, 246435], [49, 246695], [54, 246995]]}, {"verse": 30, "start": 248477, "end": 260104, "text": "Y he aquí dos ciegos sentados junto al camino, cuando oyeron que Jesús pasaba, clamaron, diciendo: Señor, Hijo de David, ten misericordia de nosotros.", "words": [[0, 248477], [2, 248663], [5, 248803], [10, 249083], [14, 249303], [21, 249883], [30, 250663], [36, 250983], [39, 251263], [47, 252363], [54, 252683], [61, 253223], [65, 253383], [71, 253643], [79, 254843], [89, 255503], [99, 256962], [106, 257217], [111, 257537], [114, 257637], [121, 258417], [125, 258537], [138, 259317], [141, 259417]]}, {"verse": 31, "start": 260454, "end": 269499, "text": "Y la gente les reñía para que callasen; pero ellos clamaban más, diciendo: Señor, Hijo de David, ten misericordia de nosotros.", "words": [[0, 260454], [2, 260557], [5, 260677], [11, 261017], [15, 261377], [21, 262237], [26, 262437], [30, 262967], [40, 263798], [45, 263942], [51, 264142], [60, 264782], [65, 265182], [75, 266357], [82, 266612], [87, 266932], [90, 267032], [97, 267812], [101, 267932], [114, 268712], [117, 268812]]}, {"verse": 32, "start": 269849, "end": 275394, "text": "Y parándose Jesús, los llamó, y dijo: ¿Qué queréis que haga por vosotros?", "words": [[0, 269849], [2, 269971], [12, 270671], [19, 271131], [23, 271671], [30, 272231], [32, 272611], [38, 273379], [43, 273503], [51, 273883], [55, 274043], [60, 274263], [64, 274523]]}, {"verse": 33, "start": 275844, "end": 279483, "text": "Ellos le dicen: Señor, que sean abiertos nuestros ojos.", "words": [[0, 275844], [6, 276248], [9, 276368], [16, 277224], [23, 277723], [27, 277803], [32, 278003], [41, 278583], [50, 278763]]}, {"verse": 34, "start": 279833, "end": 289684, "text": "Entonces Jesús, teniendo misericordia de ellos, les tocó los ojos, y luego sus ojos recibieron la vista; y le siguieron.", "words": [[0, 279833], [9, 280833], [16, 281603], [25, 282373], [38, 283273], [41, 283413], [48, 284133], [52, 284273], [57, 284833], [61, 285073], [67, 285413], [69, 286113], [75, 286313], [79, 286573], [84, 286893], [95, 287613], [98, 287813], [105, 288700], [107, 288823], [110, 288903]]}]}