{"book": "PSA", "chapter": 38, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 131769, "verses": [{"verse": 1, "start": 300, "end": 7438, "text": "Salmo de David, para recordar. JEHOVÁ, no me reprendas en tu furor, ni me castigues en tu ira.", "words": [[0, 300], [6, 743], [9, 903], [16, 1203], [21, 1563], [31, 2790], [39, 3291], [42, 3371], [45, 3551], [55, 4351], [58, 4551], [61, 4751], [68, 5281], [71, 5811], [74, 5991], [84, 6611], [87, 6771], [90, 6971]]}, {"verse": 2, "start": 7788, "end": 12555, "text": "Porque tus flechas descendieron a mí, y sobre mí ha caído tu mano.", "words": [[0, 7788], [7, 8251], [11, 8471], [19, 8911], [32, 9651], [34, 9831], [38, 10031], [40, 10551], [46, 10811], [49, 11131], [52, 11391], [58, 11791], [61, 11991]]}, {"verse": 3, "start": 12905, "end": 20018, "text": "No hay sanidad en mi carne a causa de tu ira; ni hay paz en mis huesos a causa de mi pecado.", "words": [[0, 12905], [3, 13173], [7, 13413], [15, 14073], [18, 14313], [21, 14673], [27, 15033], [29, 15193], [35, 15493], [38, 15773], [41, 15973], [46, 16749], [49, 17029], [53, 17189], [57, 17469], [60, 17809], [64, 17989], [71, 18529], [73, 18669], [79, 18969], [82, 19229], [85, 19369]]}, {"verse": 4, "start": 20368, "end": 26999, "text": "Porque mis iniquidades han pasado mi cabeza: como carga pesada se han agravado sobre mí.", "words": [[0, 20368], [7, 20592], [11, 20832], [23, 21872], [27, 22272], [34, 22752], [37, 23032], [45, 23972], [50, 24155], [56, 24555], [63, 25215], [66, 25435], [70, 25595], [79, 26315], [85, 26555]]}, {"verse": 5, "start": 27349, "end": 31865, "text": "Se pudrieron, se corrompieron mis llagas, a causa de mi locura.", "words": [[0, 27349], [3, 27490], [14, 28330], [17, 28410], [30, 29210], [34, 29700], [42, 30190], [44, 30610], [50, 30870], [53, 31150], [56, 31250]]}, {"verse": 6, "start": 32215, "end": 37255, "text": "Estoy encorvado, estoy humillado en gran manera, ando enlutado todo el día.", "words": [[0, 32215], [6, 32442], [17, 33582], [23, 33702], [33, 34282], [36, 34442], [41, 34582], [49, 35262], [54, 35682], [63, 36262], [68, 36482], [71, 36742]]}, {"verse": 7, "start": 37605, "end": 41881, "text": "Porque mis lomos están llenos de irritación, y no hay sanidad en mi carne.", "words": [[0, 37605], [7, 37846], [11, 38026], [17, 38406], [23, 38746], [30, 39166], [33, 39306], [45, 40026], [47, 40261], [50, 40401], [54, 40521], [62, 40961], [65, 41161], [68, 41301]]}, {"verse": 8, "start": 42231, "end": 48020, "text": "Estoy debilitado y molido en gran manera; bramo a causa de la conmoción de mi corazón.", "words": [[0, 42231], [6, 42624], [17, 43344], [19, 43484], [26, 43884], [29, 44024], [34, 44204], [42, 45090], [48, 45520], [50, 45720], [56, 46020], [59, 46260], [62, 46360], [72, 46980], [75, 47180], [78, 47280]]}, {"verse": 9, "start": 48370, "end": 54781, "text": "Señor, delante de ti están todos mis deseos; y mi suspiro no te es oculto.", "words": [[0, 48370], [7, 49541], [15, 49961], [18, 50121], [21, 50361], [27, 50661], [33, 51061], [37, 51381], [45, 52480], [47, 52608], [50, 52748], [58, 53488], [61, 53648], [64, 54045], [67, 54443]]}, {"verse": 10, "start": 55131, "end": 61901, "text": "Mi corazón está acongojado, me ha dejado mi vigor; y aun la misma luz de mis ojos no está conmigo.", "words": [[0, 55131], [3, 55254], [11, 55694], [16, 56074], [28, 57294], [31, 57414], [34, 57494], [41, 57914], [44, 58074], [51, 58774], [53, 58919], [57, 59099], [60, 59299], [66, 59519], [70, 59919], [73, 60319], [77, 60459], [82, 60739], [85, 60959], [90, 61099]]}, {"verse": 11, "start": 62251, "end": 68519, "text": "Mis amigos y mis compañeros se quitaron de delante de mi plaga; y mis cercanos se pusieron lejos.", "words": [[0, 62251], [4, 62359], [11, 62719], [13, 62899], [17, 63039], [28, 63759], [31, 64139], [40, 64619], [43, 64759], [51, 65199], [54, 65359], [57, 65519], [64, 66430], [66, 66529], [70, 66649], [79, 67269], [82, 67509], [91, 67969]]}, {"verse": 12, "start": 68869, "end": 77714, "text": "Y los que buscaban mi alma armaron lazos; y los que procuraban mi mal hablaban iniquidades, y meditaban fraudes todo el día.", "words": [[0, 68869], [2, 68976], [6, 69096], [10, 69256], [19, 69816], [22, 70056], [27, 70356], [35, 70976], [42, 71957], [44, 72042], [48, 72142], [52, 72282], [63, 72902], [66, 73142], [70, 73422], [79, 74142], [92, 75042], [94, 75582], [104, 76162], [112, 76722], [117, 77042], [120, 77282]]}, {"verse": 13, "start": 78064, "end": 84202, "text": "Mas yo, como si fuera sordo, no oía; y estaba como un mudo, que no abre su boca.", "words": [[0, 78064], [4, 78253], [8, 78413], [13, 78633], [16, 78833], [22, 79093], [29, 80013], [32, 80173], [37, 81050], [39, 81175], [46, 81555], [51, 81935], [54, 82155], [60, 82675], [64, 82895], [67, 83115], [72, 83355], [75, 83595]]}, {"verse": 14, "start": 84552, "end": 89598, "text": "fui pues como un hombre que no oye, y que en su boca no tiene reprensiones.", "words": [[0, 84552], [4, 84823], [9, 85003], [14, 85323], [17, 85563], [24, 85883], [28, 86083], [31, 86283], [36, 86683], [38, 87123], [42, 87263], [45, 87383], [48, 87563], [53, 87923], [56, 88123], [62, 88443]]}, {"verse": 15, "start": 89948, "end": 94759, "text": "Porque a ti, oh Jehová, esperé yo: tú responderás, Jehová Dios mío.", "words": [[0, 89948], [7, 90191], [9, 90371], [13, 90698], [16, 91024], [24, 91351], [31, 91671], [35, 92328], [38, 92532], [51, 93587], [58, 93967], [63, 94128]]}, {"verse": 16, "start": 95109, "end": 101629, "text": "Porque dije: Que no se alegren de mí: cuando mi pie resbalaba, sobre mí se engrandecían.", "words": [[0, 95236], [7, 95396], [13, 96254], [17, 96474], [20, 96634], [23, 96794], [31, 97314], [34, 97474], [38, 98064], [45, 98248], [48, 98668], [52, 99088], [63, 99508], [69, 99968], [72, 100228], [75, 100448]]}, {"verse": 17, "start": 101979, "end": 106670, "text": "Pero yo estoy a punto de caer, y mi dolor está delante de mí continuamente.", "words": [[0, 101979], [5, 102123], [8, 102323], [14, 102543], [16, 102663], [22, 102923], [25, 103183], [31, 103683], [33, 104163], [36, 104303], [42, 104583], [47, 104883], [55, 105363], [58, 105523], [61, 105643]]}, {"verse": 18, "start": 107020, "end": 111389, "text": "Por tanto confesaré mi maldad; me angustiaré por mi pecado.", "words": [[0, 107020], [4, 107280], [10, 107740], [20, 108580], [23, 108680], [31, 109619], [34, 109967], [45, 110347], [49, 110547], [52, 110707]]}, {"verse": 19, "start": 111739, "end": 117866, "text": "Porque mis enemigos están vivos y fuertes: y se han aumentado los que me aborrecen sin causa:", "words": [[0, 111739], [7, 111921], [11, 112121], [20, 112701], [26, 112941], [32, 113561], [34, 113681], [43, 114670], [45, 114797], [48, 114937], [52, 115097], [62, 115837], [66, 115997], [70, 116157], [73, 116297], [83, 116817], [87, 117057]]}, {"verse": 20, "start": 118216, "end": 122952, "text": "Y pagando mal por bien me son contrarios, por seguir yo lo bueno.", "words": [[0, 118216], [2, 118463], [10, 118943], [14, 119223], [18, 119483], [23, 119703], [26, 119923], [30, 120163], [42, 121383], [46, 121683], [53, 121983], [56, 122303], [59, 122443]]}, {"verse": 21, "start": 123302, "end": 127344, "text": "No me desampares, oh Jehová: Dios mío, no te alejes de mí.", "words": [[0, 123302], [3, 123540], [6, 123680], [18, 124290], [21, 124900], [29, 125781], [34, 125951], [39, 126271], [42, 126351], [45, 126531], [52, 126871], [55, 127031]]}, {"verse": 22, "start": 127694, "end": 131369, "text": "Apresúrate a ayudarme, oh Señor, mi salvación.", "words": [[0, 127694], [11, 128514], [13, 128734], [23, 129434], [26, 129554], [33, 130354], [36, 130514]]}]}