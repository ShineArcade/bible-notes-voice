{"book": "LUK", "chapter": 3, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 311441, "verses": [{"verse": 1, "start": 300, "end": 16254, "text": "Y en el año quince del imperio de Tiberio César, siendo gobernador de Judea Poncio Pilato, y Herodes tetrarca de Galilea, y su hermano Felipe tetrarca de Iturea y de la provincia de Traconite, y Lisanias tetrarca de Abilinia,", "words": [[0, 300], [2, 445], [5, 545], [8, 645], [12, 925], [19, 1205], [23, 1585], [31, 2105], [34, 2245], [42, 2665], [49, 3605], [56, 3945], [67, 4925], [70, 5085], [76, 5565], [83, 5945], [91, 6505], [93, 7025], [101, 7545], [110, 8065], [113, 8205], [122, 9202], [124, 9323], [127, 9463], [135, 9923], [142, 10283], [151, 11043], [154, 11473], [161, 11903], [163, 12063], [166, 12143], [169, 12283], [179, 12903], [182, 13043], [193, 13763], [195, 14273], [204, 14783], [213, 15343], [216, 15483]]}, {"verse": 2, "start": 16604, "end": 25076, "text": "Siendo sumos sacerdotes Anás y Caifás, vino palabra del Señor sobre Juan, hijo de Zacarías, en el desierto.", "words": [[0, 16604], [7, 17148], [13, 17728], [24, 18308], [29, 18888], [31, 19199], [39, 19510], [44, 19843], [52, 20303], [56, 20663], [62, 21083], [68, 21483], [74, 22583], [79, 22823], [82, 23293], [92, 23763], [95, 24123], [98, 24263]]}, {"verse": 3, "start": 25426, "end": 34095, "text": "Y él vino por toda la tierra alrededor del Jordán predicando el bautismo del arrepentimiento para la remisión de pecados;", "words": [[0, 25426], [2, 25592], [5, 25752], [10, 25992], [14, 26272], [19, 26572], [22, 26812], [29, 27252], [39, 27832], [43, 28462], [50, 29092], [61, 29792], [64, 29912], [73, 30552], [77, 30752], [93, 31932], [98, 32232], [101, 32412], [110, 33032], [113, 33232]]}, {"verse": 4, "start": 34445, "end": 45859, "text": "Como está escrito en el libro de las palabras del profeta Isaías que dice: Voz del que clama en el desierto: Preparad el camino del Señor, haced derechas sus sendas.", "words": [[0, 34445], [5, 34589], [10, 34789], [18, 35169], [21, 35389], [24, 35549], [30, 35829], [33, 36049], [37, 36169], [46, 36549], [50, 36789], [58, 37269], [65, 37789], [69, 37949], [75, 38714], [79, 39121], [83, 39541], [87, 39781], [93, 40021], [96, 40261], [99, 40481], [109, 41751], [118, 42179], [121, 42379], [128, 42739], [132, 42999], [139, 43999], [145, 44369], [154, 44739], [158, 44979]]}, {"verse": 5, "start": 46209, "end": 56331, "text": "Todo valle se llenará, y se bajará todo monte y collado; y los caminos torcidos serán enderezados, y los caminos ásperos allanados;", "words": [[0, 46209], [5, 46473], [11, 46773], [14, 46933], [23, 47453], [25, 47853], [28, 47973], [35, 48413], [40, 48673], [46, 49133], [48, 49660], [57, 50335], [59, 50439], [63, 50579], [71, 51039], [80, 51659], [86, 52499], [99, 53499], [101, 53934], [105, 54094], [113, 54634], [121, 55509]]}, {"verse": 6, "start": 56681, "end": 59389, "text": "Y verá toda carne la salvación de Dios.", "words": [[0, 56681], [2, 56807], [7, 57107], [12, 57247], [18, 57927], [21, 58007], [31, 58647], [34, 58827]]}, {"verse": 7, "start": 59739, "end": 68775, "text": "Y decía a las multitudes que salían para ser bautizadas por él: ¡Oh generación de víboras, quién os enseñó a huir de la ira que vendrá?", "words": [[0, 59739], [2, 59866], [8, 60366], [10, 60806], [14, 60906], [25, 61626], [29, 61906], [36, 62406], [41, 62606], [45, 62866], [56, 63926], [60, 64186], [64, 64799], [68, 64879], [79, 65479], [82, 65639], [91, 66479], [97, 66649], [100, 66819], [107, 67259], [109, 67359], [114, 67619], [117, 67739], [120, 67859], [124, 68099], [128, 68199]]}, {"verse": 8, "start": 69125, "end": 80580, "text": "Haced, pues, frutos dignos de arrepentimiento, y no comencéis a decir en vosotros mismos: Tenemos a Abraham por padre: porque os digo que puede Dios, aun de estas piedras, levantar hijos a Abraham.", "words": [[0, 69125], [7, 69466], [13, 69936], [20, 70406], [27, 70826], [30, 70926], [47, 71806], [49, 72266], [52, 72586], [62, 72906], [64, 73046], [70, 73326], [73, 73486], [82, 73846], [90, 74720], [98, 74977], [100, 75217], [108, 75537], [112, 75797], [119, 76519], [126, 76719], [129, 76859], [134, 77039], [138, 77199], [144, 77439], [150, 77799], [154, 78179], [157, 78379], [163, 78559], [172, 79119], [181, 79639], [187, 79799], [189, 80039]]}, {"verse": 9, "start": 80930, "end": 88798, "text": "Y ya también el hacha está puesta a la raíz de los árboles: todo árbol pues que no hace buen fruto, es cortado, y echado en el fuego.", "words": [[0, 80930], [2, 81052], [5, 81192], [13, 81492], [16, 81692], [22, 81912], [27, 82072], [34, 82492], [36, 82592], [39, 82652], [44, 82971], [47, 83092], [51, 83192], [60, 84054], [65, 84274], [71, 84654], [76, 84894], [80, 85134], [83, 85334], [88, 85574], [93, 85814], [100, 86314], [103, 86674], [112, 87374], [114, 87694], [121, 88094], [124, 88214], [127, 88334]]}, {"verse": 10, "start": 89078, "end": 92929, "text": "Y la gente le preguntaba, diciendo: ¿Pues qué haremos?", "words": [[0, 89078], [2, 89184], [5, 89284], [11, 89604], [14, 89844], [26, 90544], [36, 92091], [42, 92230], [46, 92370]]}, {"verse": 11, "start": 93209, "end": 100238, "text": "Y respondiendo, les dijo: El que tiene dos túnicas, dé al que no tiene; y el que tiene qué comer, haga lo mismo.", "words": [[0, 93209], [2, 93314], [16, 94214], [20, 94294], [26, 95065], [29, 95182], [33, 95302], [39, 95562], [43, 95802], [52, 96342], [55, 96862], [58, 97022], [62, 97162], [65, 97302], [72, 97966], [74, 98063], [77, 98163], [81, 98263], [87, 98543], [91, 98723], [98, 99523], [103, 99643], [106, 99783]]}, {"verse": 12, "start": 100518, "end": 108171, "text": "Y vinieron también recaudadores de impuestos para ser bautizados, y le dijeron: Maestro, ¿qué haremos?", "words": [[0, 100518], [2, 100620], [11, 101060], [19, 101460], [32, 102520], [35, 102720], [45, 103240], [50, 103480], [54, 104130], [66, 104780], [68, 104880], [71, 105000], [80, 105981], [89, 106658], [94, 106758]]}, {"verse": 13, "start": 108451, "end": 112444, "text": "Y él les dijo: No exijáis más de lo que os está ordenado.", "words": [[0, 108451], [2, 108657], [5, 108837], [9, 109137], [15, 109934], [18, 110118], [26, 110698], [30, 110898], [33, 111118], [36, 111238], [40, 111398], [43, 111538], [48, 111798]]}, {"verse": 14, "start": 112724, "end": 124097, "text": "Y le preguntaron también los soldados, diciendo: Y nosotros, ¿qué haremos? Y les dice: No hagáis extorsión a nadie, ni calumniéis; y contentaos con vuestras pagas.", "words": [[0, 112724], [2, 112848], [5, 112948], [17, 113648], [25, 113968], [29, 114228], [39, 115228], [49, 116159], [51, 116259], [61, 117059], [66, 117159], [75, 118078], [77, 118222], [81, 118580], [87, 119095], [90, 119274], [97, 119594], [107, 120254], [109, 120334], [116, 120654], [119, 121094], [131, 122204], [133, 122530], [144, 122890], [148, 123130], [157, 123470]]}, {"verse": 15, "start": 124377, "end": 132203, "text": "Y estando el pueblo esperando, y pensando todos de Juan en sus corazones, si él fuese el Cristo,", "words": [[0, 124377], [2, 124501], [10, 124841], [13, 125181], [20, 125541], [31, 126141], [33, 126901], [42, 127361], [48, 127921], [51, 128201], [56, 128541], [59, 128721], [63, 128921], [74, 130281], [77, 130641], [80, 130861], [86, 131241], [89, 131421]]}, {"verse": 16, "start": 132553, "end": 145873, "text": "Respondió Juan, diciendo a todos: Yo, a la verdad, os bautizo en agua; pero viene quien es más poderoso que yo, de quien no soy digno de desatar la correa de sus zapatos: él os bautizará en Espíritu Santo y fuego;", "words": [[0, 132817], [10, 133117], [16, 133537], [25, 134157], [27, 134537], [34, 135406], [38, 135605], [40, 135745], [43, 135825], [51, 136145], [54, 136425], [62, 136885], [65, 137065], [71, 137666], [76, 137810], [82, 138090], [88, 138270], [91, 138470], [95, 138610], [104, 139190], [108, 139370], [112, 139810], [115, 140070], [121, 140250], [124, 140470], [128, 140670], [134, 141090], [137, 141130], [145, 141530], [148, 141730], [155, 142090], [158, 142210], [162, 142350], [171, 143277], [174, 143421], [177, 143521], [187, 144201], [190, 144261], [199, 144821], [205, 145121], [207, 145361]]}, {"verse": 17, "start": 146223, "end": 155093, "text": "Cuya horquilla para aventar está en su mano, y limpiará su lugar de trilla, y juntará el trigo en su granero, y la paja quemará en fuego que nunca se apagará.", "words": [[0, 146223], [5, 146452], [15, 146872], [20, 147112], [28, 147632], [33, 147852], [36, 148012], [39, 148152], [45, 148452], [47, 148647], [56, 149147], [59, 149267], [65, 149567], [68, 149727], [76, 150127], [78, 150312], [86, 150732], [89, 150872], [95, 151192], [98, 151292], [101, 151412], [110, 152150], [112, 152252], [115, 152372], [120, 152732], [128, 153192], [131, 153352], [137, 153632], [141, 153952], [147, 154212], [150, 154512]]}, {"verse": 18, "start": 155373, "end": 160042, "text": "Y amonestando, otras muchas cosas también anunciaba al pueblo.", "words": [[0, 155373], [2, 155518], [15, 156338], [21, 156718], [28, 157118], [34, 157618], [42, 158078], [52, 158998], [55, 159298]]}, {"verse": 19, "start": 160392, "end": 171790, "text": "Entonces Herodes el tetrarca, siendo reprendido por él a causa de Herodías, mujer de Felipe su hermano, y de todas las maldades que había hecho Herodes,", "words": [[0, 160392], [9, 161194], [17, 162114], [20, 162637], [30, 163159], [37, 163539], [48, 164339], [52, 164579], [55, 164779], [57, 164999], [63, 165339], [66, 165659], [76, 166799], [82, 167099], [85, 167339], [92, 167679], [95, 167959], [104, 168759], [106, 168919], [109, 169059], [115, 169339], [119, 169639], [128, 170239], [132, 170439], [138, 170719], [144, 170999]]}, {"verse": 20, "start": 172140, "end": 176353, "text": "Añadió también esto sobre todo, que encerró a Juan en la cárcel.", "words": [[0, 172140], [7, 172625], [15, 172945], [20, 173445], [26, 173765], [32, 174105], [36, 174365], [44, 174925], [46, 175085], [51, 175345], [54, 175625], [57, 175765]]}, {"verse": 21, "start": 176703, "end": 185477, "text": "Y aconteció que, como todo el pueblo se bautizaba, también Jesús fue bautizado; y orando, el cielo se abrió,", "words": [[0, 176703], [2, 176993], [12, 177673], [17, 177853], [22, 178113], [27, 178413], [30, 178653], [37, 178993], [40, 179233], [51, 180013], [59, 180313], [65, 180813], [69, 181473], [80, 183277], [82, 183731], [90, 184184], [93, 184304], [99, 184664], [102, 184904]]}, {"verse": 22, "start": 185827, "end": 197436, "text": "Y descendió el Espíritu Santo sobre él en forma corporal, como paloma, y fue hecha una voz del cielo que decía: Tú eres mi Hijo amado, en ti me he complacido.", "words": [[0, 185827], [2, 185951], [12, 186491], [15, 186611], [24, 187091], [30, 187431], [36, 187871], [39, 188131], [42, 188251], [48, 188491], [58, 189351], [63, 189851], [71, 190411], [73, 191091], [77, 191311], [83, 191771], [87, 191911], [91, 192131], [95, 192291], [101, 192711], [105, 192951], [112, 193823], [115, 193986], [120, 194366], [123, 194726], [128, 194946], [135, 195806], [138, 195946], [141, 196206], [144, 196506], [147, 196626]]}, {"verse": 23, "start": 197945, "end": 205960, "text": "Y el mismo Jesús comenzaba a ser como de treinta años, hijo de José, como se creía; que fue hijo de Elí,", "words": [[0, 197945], [2, 198065], [5, 198185], [11, 198505], [17, 198945], [27, 199905], [29, 200125], [33, 200425], [38, 200685], [41, 201005], [49, 201325], [55, 202125], [60, 202345], [63, 202505], [69, 203305], [74, 203445], [77, 203645], [84, 204543], [88, 204627], [92, 204867], [97, 205307], [100, 205527]]}, {"verse": 24, "start": 206310, "end": 212371, "text": "Que fue de Matat, que fue de Leví, que fue de Melqui, que fue de Jana, que fue de José,", "words": [[0, 206310], [4, 206415], [8, 206635], [11, 206795], [18, 207795], [22, 207855], [26, 208055], [29, 208195], [35, 209015], [39, 209075], [43, 209255], [46, 209395], [54, 210335], [58, 210335], [62, 210515], [65, 210985], [71, 211455], [75, 211475], [79, 211675], [82, 211815]]}, {"verse": 25, "start": 212721, "end": 218600, "text": "Que fue de Matatías, que fue de Amós, que fue de Nahum, que fue de Esli,", "words": [[0, 212721], [4, 212805], [8, 213005], [11, 213165], [21, 214605], [25, 214625], [29, 214845], [32, 215005], [38, 216005], [42, 216005], [46, 216185], [49, 216775], [56, 217365], [60, 217405], [64, 217625], [67, 217805]]}, {"verse": 26, "start": 218950, "end": 227014, "text": "Que fue de Nagai, que fue de Maat, que fue de Matatías, que fue de Simei, que fue de José, que fue de Judá,", "words": [[0, 218950], [4, 219052], [8, 219272], [11, 219892], [18, 220512], [22, 220532], [26, 220752], [29, 221272], [35, 221792], [39, 221892], [43, 222072], [46, 222192], [56, 223432], [60, 223452], [64, 223652], [67, 223772], [74, 224852], [78, 224872], [82, 225052], [85, 225192], [91, 226012], [95, 226092], [99, 226292], [102, 226432]]}, {"verse": 27, "start": 227364, "end": 232458, "text": "Que fue de Joana, que fue de Resa, que fue de Zorobabel, que fue de Salatiel,", "words": [[0, 227364], [4, 227468], [8, 227668], [11, 227828], [18, 228548], [22, 228548], [26, 228728], [29, 229368], [35, 230008], [39, 230008], [43, 230188], [46, 230756], [57, 231323], [61, 231343], [65, 231543], [68, 231683]]}, {"verse": 28, "start": 232808, "end": 241614, "text": "Que fue de Neri, que fue de Melqui, que fue de Abdi, que fue de Cosam, que fue de Elmodam, que fue de Er,", "words": [[0, 232808], [4, 232912], [8, 233152], [11, 233312], [17, 234372], [21, 234392], [25, 234652], [28, 234792], [36, 235832], [40, 235892], [44, 236132], [47, 236652], [53, 237172], [57, 237272], [61, 237452], [64, 238102], [71, 238752], [75, 238792], [79, 238992], [82, 239152], [91, 240652], [95, 240692], [99, 240912], [102, 241152]]}, {"verse": 29, "start": 241964, "end": 247233, "text": "Que fue de Josué, que fue de Eliezer, que fue de Jorim, que fue de Matat,", "words": [[0, 241964], [4, 242068], [8, 242248], [11, 242388], [18, 243308], [22, 243308], [26, 243508], [29, 243648], [38, 244808], [42, 244868], [46, 245048], [49, 245658], [56, 246268], [60, 246288], [64, 246448], [67, 246588]]}, {"verse": 30, "start": 247583, "end": 255311, "text": "Que fue de Leví, que fue de Simeón, que fue de Judá, que fue de José, que fue de Jonán, que fue de Eliaquim,", "words": [[0, 247583], [4, 247685], [8, 247905], [11, 248065], [17, 248985], [21, 249005], [25, 249205], [28, 249345], [36, 250405], [40, 250465], [44, 250645], [47, 250765], [53, 251585], [57, 251585], [61, 251765], [64, 251865], [70, 252505], [74, 252525], [78, 252705], [81, 253275], [88, 253845], [92, 253865], [96, 254045], [99, 254678]]}, {"verse": 31, "start": 255661, "end": 260357, "text": "Que fue de Melea, que fue de Mainán, que fue de Matata, que fue de Natán,", "words": [[0, 255661], [4, 255763], [8, 255963], [11, 256123], [18, 257183], [22, 257183], [26, 257383], [29, 257503], [37, 258143], [41, 258163], [45, 258323], [48, 258463], [56, 259363], [60, 259363], [64, 259563], [67, 259683]]}, {"verse": 32, "start": 260707, "end": 269542, "text": "Que fue de David, que fue de Isaí, que fue de Obed, que fue de Booz, que fue de Salmón, que fue de Naassón,", "words": [[0, 260707], [4, 260792], [8, 260992], [11, 261172], [18, 262192], [22, 262212], [26, 262412], [29, 262552], [35, 263792], [39, 263812], [43, 263992], [46, 264152], [52, 265072], [56, 265292], [60, 265472], [63, 266092], [69, 266712], [73, 266812], [77, 267012], [80, 267152], [88, 268372], [92, 268392], [96, 268592], [99, 269067]]}, {"verse": 33, "start": 269892, "end": 275584, "text": "Que fue de Aminadab, que fue de Aram, que fue de Esrom, que fue de Fares,", "words": [[0, 269892], [4, 269977], [8, 270237], [11, 270417], [21, 271452], [25, 271512], [29, 271772], [32, 271932], [38, 272932], [42, 272972], [46, 273172], [49, 273332], [56, 274452], [60, 274492], [64, 274692], [67, 274832]]}, {"verse": 34, "start": 275934, "end": 283737, "text": "Que fue de Judá, que fue de Jacob, que fue de Isaac, que fue de Abraham, que fue de Taré, que fue de Nacor,", "words": [[0, 275934], [4, 276018], [8, 276218], [11, 276358], [17, 277238], [21, 277238], [25, 277438], [28, 277558], [35, 278383], [39, 278443], [43, 278643], [46, 278783], [53, 279803], [57, 279823], [61, 280023], [64, 280203], [73, 281503], [77, 281523], [81, 281683], [84, 281823], [90, 282643], [94, 282783], [98, 282943], [101, 283367]]}, {"verse": 35, "start": 284087, "end": 288744, "text": "Que fue de Serug, que fue de Ragau, que fue de Peleg, que fue de Heber,", "words": [[0, 284087], [4, 284174], [8, 284374], [11, 285454], [18, 286534], [22, 286554], [26, 286734], [29, 287074], [36, 287414], [40, 287754], [44, 287974], [47, 288106], [54, 288239], [58, 288371], [62, 288504], [65, 288636]]}, {"verse": 36, "start": 289094, "end": 297082, "text": "Que fue de Sala, que fue de Cainán, que fue de Arfaxad, que fue de Sem, que fue de Noé, que fue de Lamec,", "words": [[0, 289094], [4, 289176], [8, 289356], [11, 289496], [17, 290576], [21, 290596], [25, 290796], [28, 291436], [36, 292076], [40, 292076], [44, 292276], [47, 292956], [56, 293636], [60, 293716], [64, 293876], [67, 294016], [72, 294876], [76, 294976], [80, 295156], [83, 295296], [88, 296116], [92, 296176], [96, 296376], [99, 296476]]}, {"verse": 37, "start": 297432, "end": 303957, "text": "Que fue de Matusalén, que fue de Enoc, que fue de Jared, que fue de Mahalaleel,", "words": [[0, 297432], [4, 297537], [8, 297717], [11, 297877], [22, 299297], [26, 299297], [30, 299557], [33, 300207], [39, 300857], [43, 300857], [47, 301057], [50, 301197], [57, 302017], [61, 302117], [65, 302337], [68, 303147]]}, {"verse": 38, "start": 304307, "end": 311041, "text": "Que fue de Cainán, que fue de Enós, que fue de Set, que fue de Adam, que fue de Dios.", "words": [[0, 304307], [4, 304389], [8, 304609], [11, 304789], [19, 305929], [23, 305929], [27, 306169], [30, 306329], [36, 307369], [40, 307389], [44, 307609], [47, 307769], [52, 308709], [56, 308809], [60, 308969], [63, 309129], [69, 310029], [73, 310069], [77, 310249], [80, 310409]]}]}