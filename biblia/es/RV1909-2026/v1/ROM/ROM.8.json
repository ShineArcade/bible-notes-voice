{"book": "ROM", "chapter": 8, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 306404, "verses": [{"verse": 1, "start": 300, "end": 8977, "text": "Ahora pues, ninguna condenación hay para los que están en Cristo Jesús, los que no andan conforme a la carne, sino conforme al espíritu.", "words": [[0, 300], [6, 538], [12, 1258], [20, 1618], [32, 2518], [36, 2858], [41, 3098], [45, 3298], [49, 3438], [55, 3698], [58, 3838], [65, 4138], [72, 5138], [76, 5318], [80, 5478], [83, 5658], [89, 5938], [98, 6478], [100, 6538], [103, 6618], [110, 7358], [115, 7538], [124, 8218], [127, 8318]]}, {"verse": 2, "start": 9427, "end": 14829, "text": "Porque la ley del Espíritu de vida en Cristo Jesús me ha librado de la ley del pecado y de la muerte.", "words": [[0, 9427], [7, 9606], [10, 9746], [14, 9926], [18, 10066], [27, 10606], [30, 10706], [35, 10906], [38, 11046], [45, 11346], [51, 11946], [54, 12446], [57, 12526], [65, 12926], [68, 13066], [71, 13166], [75, 13346], [79, 13486], [86, 13966], [88, 14086], [91, 14186], [94, 14286]]}, {"verse": 3, "start": 15279, "end": 26523, "text": "Porque lo que era imposible a la ley, por cuanto era débil por la carne, Dios enviando a su Hijo en semejanza de carne de pecado, y a causa del pecado, condenó al pecado en la carne;", "words": [[0, 15279], [7, 15505], [10, 15705], [14, 15845], [18, 16025], [28, 16645], [30, 16765], [33, 16845], [38, 17485], [42, 17725], [49, 18025], [53, 18285], [59, 18645], [63, 18845], [66, 19005], [73, 19785], [78, 20165], [87, 20685], [89, 20805], [92, 21005], [97, 21225], [100, 21345], [110, 22005], [113, 22125], [119, 22405], [122, 22565], [130, 23475], [132, 23597], [134, 23677], [140, 23897], [144, 24117], [152, 24877], [160, 25357], [163, 25457], [170, 25857], [173, 25957], [176, 26057]]}, {"verse": 4, "start": 26973, "end": 33272, "text": "Para que la justicia de la ley fuese cumplida en nosotros, que no andamos conforme a la carne, sino conforme al espíritu.", "words": [[0, 26973], [5, 27095], [9, 27215], [12, 27295], [21, 27795], [24, 27935], [27, 28055], [31, 28255], [37, 28555], [46, 29055], [49, 29155], [59, 29575], [63, 30095], [66, 30255], [74, 30615], [83, 31115], [85, 31175], [88, 31235], [95, 31595], [100, 32035], [109, 32595], [112, 32675]]}, {"verse": 5, "start": 33722, "end": 43058, "text": "Porque los que viven conforme a la carne, de las cosas que son de la carne se ocupan; pero los que conforme al espíritu, de las cosas del espíritu.", "words": [[0, 33722], [7, 33906], [11, 34106], [15, 34266], [21, 34566], [30, 34806], [32, 35046], [35, 35166], [42, 35906], [45, 36086], [49, 36226], [55, 36506], [59, 36726], [63, 36946], [66, 37066], [69, 37166], [75, 37466], [78, 37646], [86, 38528], [91, 38650], [95, 38830], [99, 38970], [108, 39490], [111, 39550], [121, 40210], [124, 40490], [128, 40630], [134, 40890], [138, 41130]]}, {"verse": 6, "start": 43508, "end": 49097, "text": "Porque la mente puesta en la carne es muerte; pero la mente puesta en el espíritu, vida y paz:", "words": [[0, 43508], [7, 43687], [10, 43847], [16, 44047], [23, 44527], [26, 44627], [29, 44747], [35, 45087], [38, 45247], [46, 46143], [51, 46285], [54, 46465], [60, 46705], [67, 47205], [70, 47305], [73, 47405], [83, 48125], [88, 48425], [90, 48605]]}, {"verse": 7, "start": 49547, "end": 56287, "text": "Por cuanto la intención de la carne es enemistad contra Dios; porque no se sujeta a la ley de Dios, ni tampoco puede.", "words": [[0, 49547], [4, 49673], [11, 49853], [14, 50113], [24, 50613], [27, 50733], [30, 50873], [36, 51213], [39, 51473], [49, 52133], [56, 52433], [62, 53392], [69, 53492], [72, 53632], [75, 53752], [82, 54002], [84, 54252], [87, 54332], [91, 54552], [94, 54692], [100, 55232], [103, 55372], [111, 55692]]}, {"verse": 8, "start": 56737, "end": 59761, "text": "Así que, los que están en la carne no pueden agradar a Dios.", "words": [[0, 56737], [4, 56959], [9, 57139], [13, 57279], [17, 57439], [23, 57699], [26, 57839], [29, 57939], [35, 58259], [38, 58459], [45, 58719], [53, 59179], [55, 59259]]}, {"verse": 9, "start": 60211, "end": 70257, "text": "Pero vosotros no estáis en la carne, sino en el espíritu, si es que el Espíritu de Dios mora en vosotros. Y si alguno no tiene el Espíritu de Cristo, el tal no es de él.", "words": [[0, 60211], [5, 60370], [14, 60790], [17, 61030], [24, 61430], [27, 61530], [30, 61650], [37, 61970], [42, 62310], [45, 62470], [48, 62590], [58, 63590], [61, 63730], [64, 63890], [68, 64010], [71, 64110], [80, 64650], [83, 64730], [88, 64970], [93, 65410], [96, 65470], [106, 66533], [108, 66643], [111, 66743], [118, 67143], [121, 67243], [127, 67483], [130, 67663], [139, 68183], [142, 68263], [150, 69203], [153, 69303], [157, 69503], [160, 69703], [163, 69843], [166, 70023]]}, {"verse": 10, "start": 70707, "end": 78565, "text": "Pero si Cristo está en vosotros, el cuerpo a la verdad está muerto a causa del pecado; pero el espíritu vive a causa de la justicia.", "words": [[0, 70707], [5, 70832], [8, 70992], [15, 71352], [20, 71632], [23, 71792], [33, 72672], [36, 72792], [43, 73132], [45, 73272], [48, 73332], [55, 73632], [60, 73992], [67, 74392], [69, 74532], [75, 74752], [79, 74992], [87, 75848], [92, 76008], [95, 76168], [104, 76768], [109, 76968], [111, 77188], [117, 77428], [120, 77688], [123, 77788]]}, {"verse": 11, "start": 79015, "end": 91013, "text": "Y si el Espíritu de aquel que levantó de los muertos a Jesús mora en vosotros, el que levantó a Cristo Jesús de los muertos, vivificará también vuestros cuerpos mortales por su Espíritu que mora en vosotros.", "words": [[0, 79015], [2, 79123], [5, 79243], [8, 79343], [17, 79863], [20, 79963], [26, 80243], [30, 80323], [38, 80843], [41, 80923], [45, 81023], [53, 81483], [55, 81643], [61, 81903], [66, 82483], [69, 82563], [79, 83463], [82, 83563], [86, 83683], [94, 84183], [96, 84303], [103, 84503], [109, 84983], [112, 85143], [116, 85263], [125, 86660], [136, 87324], [144, 87604], [153, 88044], [161, 88444], [170, 88944], [174, 89144], [177, 89304], [186, 89824], [190, 89944], [195, 90244], [198, 90324]]}, {"verse": 12, "start": 91463, "end": 96670, "text": "Así que, hermanos, deudores somos, no a la carne, para que vivamos conforme a la carne:", "words": [[0, 91463], [4, 91627], [9, 91807], [19, 92527], [28, 92987], [35, 93787], [38, 93907], [40, 94027], [43, 94107], [50, 94767], [55, 94947], [59, 95107], [67, 95527], [76, 96067], [78, 96087], [81, 96187]]}, {"verse": 13, "start": 97120, "end": 104165, "text": "Porque si vivís conforme a la carne, moriréis; pero si por el espíritu hacéis morir las obras de la carne, viviréis.", "words": [[0, 97120], [7, 97299], [10, 97499], [16, 97859], [25, 98399], [27, 98459], [30, 98539], [37, 98799], [47, 99951], [52, 100095], [55, 100255], [59, 100455], [62, 100575], [71, 101135], [78, 101555], [84, 101895], [88, 102035], [94, 102295], [97, 102475], [100, 102595], [107, 102915]]}, {"verse": 14, "start": 104615, "end": 109516, "text": "Porque todos los que son guiados por el Espíritu de Dios, los tales son hijos de Dios.", "words": [[0, 104615], [7, 104795], [13, 105095], [17, 105355], [21, 105495], [25, 105675], [33, 106135], [37, 106375], [40, 106475], [49, 106975], [52, 107075], [58, 107895], [62, 107975], [68, 108255], [72, 108575], [78, 108795], [81, 109015]]}, {"verse": 15, "start": 109966, "end": 119215, "text": "Porque no habéis recibido el espíritu de esclavitud para estar otra vez en temor; sino que habéis recibido el espíritu de adopción, por el cual clamamos, Abba, Padre.", "words": [[0, 109966], [7, 110125], [10, 110345], [17, 110625], [26, 111165], [29, 111265], [38, 111765], [41, 111845], [52, 112385], [57, 112825], [63, 113045], [68, 113265], [72, 113545], [75, 113705], [82, 114536], [87, 114731], [91, 114931], [98, 115231], [107, 115831], [110, 115931], [119, 116491], [122, 116571], [132, 117051], [136, 117331], [139, 117451], [144, 117591], [154, 118271], [160, 118711]]}, {"verse": 16, "start": 119665, "end": 123601, "text": "Porque el mismo Espíritu da testimonio a nuestro espíritu que somos hijos de Dios.", "words": [[0, 119665], [7, 119866], [10, 120026], [16, 120226], [25, 120806], [28, 120906], [39, 121526], [41, 121566], [49, 121706], [58, 122326], [62, 122406], [68, 122646], [74, 122966], [77, 123206]]}, {"verse": 17, "start": 124051, "end": 134754, "text": "Y si hijos, también herederos; herederos de Dios, y coherederos de Cristo; si en verdad padecemos juntamente con él, para que juntamente con él seamos glorificados.", "words": [[0, 124051], [2, 124149], [5, 124249], [12, 124509], [20, 124769], [31, 125868], [41, 126387], [44, 126527], [50, 126767], [52, 127187], [64, 127887], [67, 127987], [75, 129037], [78, 129205], [81, 129305], [88, 129545], [98, 130125], [109, 130765], [113, 131065], [117, 131265], [122, 131745], [126, 131905], [137, 132485], [141, 132765], [144, 132925], [151, 133325]]}, {"verse": 18, "start": 135204, "end": 143059, "text": "Porque tengo por cierto que lo que en este tiempo se padece, no es de comparar con la gloria venidera que en nosotros ha de ser manifestada.", "words": [[0, 135204], [7, 135383], [13, 135623], [17, 135843], [24, 136143], [28, 136403], [31, 136543], [35, 136683], [38, 136803], [43, 137003], [50, 137383], [53, 137563], [61, 138003], [64, 138623], [67, 138763], [70, 138883], [79, 139443], [83, 139543], [86, 139703], [93, 140003], [102, 140563], [106, 140643], [109, 140723], [118, 141043], [121, 141483], [124, 141563], [128, 141723]]}, {"verse": 19, "start": 143509, "end": 148493, "text": "Porque el continuo anhelar de la creación espera la manifestación de los hijos de Dios.", "words": [[0, 143509], [7, 143716], [10, 143856], [19, 144436], [27, 144896], [30, 144996], [33, 145116], [42, 145796], [49, 146296], [52, 146496], [66, 147276], [69, 147436], [73, 147576], [79, 147796], [82, 148016]]}, {"verse": 20, "start": 148943, "end": 155235, "text": "Porque la creación fue sujetada a frustración, no voluntariamente, sino por causa del que la sujetó con esperanza,", "words": [[0, 148943], [7, 149111], [10, 149291], [19, 149791], [23, 149991], [32, 150611], [34, 150691], [47, 151331], [50, 151611], [67, 152691], [72, 152871], [76, 153111], [82, 153391], [86, 153631], [90, 153771], [93, 153911], [100, 154371], [104, 154511]]}, {"verse": 21, "start": 155685, "end": 162059, "text": "Que también la creación misma será librada de la servidumbre de corrupción en la libertad gloriosa de los hijos de Dios.", "words": [[0, 155685], [4, 155766], [12, 156086], [15, 156266], [24, 156706], [30, 156966], [35, 157286], [43, 157766], [46, 157906], [49, 158006], [61, 158646], [64, 158766], [75, 159386], [78, 159626], [81, 159706], [90, 160226], [99, 160726], [102, 160906], [106, 161026], [112, 161286], [115, 161526]]}, {"verse": 22, "start": 162509, "end": 166763, "text": "Porque sabemos que toda la creación gime y está de parto juntamente hasta ahora.", "words": [[0, 162509], [7, 162686], [15, 163026], [19, 163266], [24, 163446], [27, 163646], [36, 164116], [41, 164586], [43, 164787], [48, 164966], [51, 165106], [57, 165466], [68, 166086], [74, 166306]]}, {"verse": 23, "start": 167213, "end": 178821, "text": "Y no solo ella, sino también nosotros mismos, que tenemos las primicias del Espíritu, nosotros también gemimos dentro de nosotros mismos, esperando la adopción, es decir, la redención de nuestro cuerpo.", "words": [[0, 167213], [2, 167317], [5, 167417], [10, 167637], [16, 167977], [21, 168277], [29, 168677], [38, 168897], [46, 169457], [50, 170057], [58, 170397], [62, 170597], [72, 171017], [76, 171217], [86, 171877], [95, 172277], [103, 172797], [111, 173377], [118, 173617], [121, 173837], [130, 174037], [138, 174657], [148, 175397], [151, 175717], [161, 176237], [164, 176437], [171, 177267], [174, 177364], [184, 177884], [187, 178024], [195, 178204]]}, {"verse": 24, "start": 179271, "end": 186161, "text": "Porque en esperanza somos salvos; pero la esperanza que se ve, no es esperanza; porque lo que alguno ve, ¿a qué esperarlo?", "words": [[0, 179271], [7, 179471], [10, 179551], [20, 180071], [26, 180311], [34, 181322], [39, 181459], [42, 181619], [52, 182079], [56, 182219], [59, 182359], [63, 182559], [66, 182859], [69, 182999], [80, 184079], [87, 184228], [90, 184388], [94, 184508], [101, 184848], [105, 184968], [108, 185268], [112, 185408]]}, {"verse": 25, "start": 186611, "end": 189749, "text": "Pero si lo que no vemos esperamos, por paciencia esperamos.", "words": [[0, 186611], [5, 186829], [8, 186989], [11, 187109], [15, 187229], [18, 187349], [24, 187609], [35, 188189], [39, 188409], [49, 188909]]}, {"verse": 26, "start": 190199, "end": 200895, "text": "Y asimismo también el Espíritu ayuda nuestra debilidad: porque qué hemos de pedir como conviene, no lo sabemos; sino que el mismo Espíritu pide por nosotros con gemidos indecibles.", "words": [[0, 190199], [2, 190308], [11, 190868], [19, 191168], [22, 191428], [31, 192068], [37, 192388], [45, 192628], [56, 193809], [63, 193959], [67, 194153], [73, 194346], [76, 194586], [82, 194806], [87, 195086], [97, 195746], [100, 195846], [103, 195966], [112, 196933], [117, 197136], [121, 197336], [124, 197436], [130, 197656], [139, 198296], [144, 198576], [148, 198776], [157, 199136], [161, 199536], [169, 199936]]}, {"verse": 27, "start": 201345, "end": 210376, "text": "Pero el que escudriña los corazones, sabe cuál es la intención del Espíritu, porque conforme a la voluntad de Dios, intercede por los santos.", "words": [[0, 201345], [5, 201482], [8, 201622], [12, 201742], [22, 202382], [26, 202522], [37, 203322], [42, 203942], [47, 204242], [50, 204482], [53, 204622], [63, 205142], [67, 205302], [77, 206042], [84, 206522], [93, 207222], [95, 207302], [98, 207362], [107, 207922], [110, 208042], [116, 208342], [126, 209222], [130, 209482], [134, 209642]]}, {"verse": 28, "start": 210826, "end": 218583, "text": "Y sabemos que a los que a Dios aman, todas las cosas les ayudan a bien, es decir, a los que conforme al propósito son llamados.", "words": [[0, 210826], [2, 210957], [10, 211177], [14, 211617], [16, 211717], [20, 211837], [24, 212004], [26, 212170], [31, 212337], [37, 213137], [43, 213217], [47, 213497], [53, 213837], [57, 214097], [64, 214577], [66, 214617], [72, 215377], [75, 215417], [82, 216237], [84, 216317], [88, 216437], [92, 216684], [101, 216930], [104, 217177], [114, 217697], [118, 217917]]}, {"verse": 29, "start": 219033, "end": 227847, "text": "Porque a los que antes conoció, también predestinó para que fuesen hechos conformes a la imagen de su Hijo, para que él sea el primogénito entre muchos hermanos;", "words": [[0, 219033], [7, 219263], [9, 219363], [13, 219503], [17, 219663], [23, 219923], [32, 220963], [40, 221023], [51, 221803], [56, 221983], [60, 222143], [67, 222563], [74, 222823], [84, 223503], [86, 223623], [89, 223703], [96, 224003], [99, 224183], [102, 224363], [108, 224963], [113, 225243], [117, 225443], [120, 225583], [124, 225783], [127, 225943], [139, 226603], [145, 226803], [152, 227083]]}, {"verse": 30, "start": 228297, "end": 238052, "text": "Y a los que predestinó, a estos también llamó; y a los que llamó, a estos también justificó; y a los que justificó, a estos también glorificó.", "words": [[0, 228297], [2, 228420], [4, 228480], [8, 228620], [12, 228760], [24, 229940], [26, 230060], [32, 230360], [40, 230800], [47, 231650], [49, 231773], [51, 231853], [55, 231993], [59, 232153], [66, 232813], [68, 233053], [74, 233333], [82, 233693], [93, 234907], [95, 235031], [97, 235111], [101, 235251], [105, 235391], [116, 236451], [118, 236571], [124, 236791], [132, 237151]]}, {"verse": 31, "start": 238502, "end": 243531, "text": "¿Pues qué diremos a esto? Si Dios por nosotros, ¿quién contra nosotros?", "words": [[0, 238502], [6, 238703], [10, 238883], [18, 239363], [20, 239483], [26, 240836], [29, 240991], [34, 241171], [38, 241431], [48, 242311], [55, 242471], [62, 242711]]}, {"verse": 32, "start": 243981, "end": 250944, "text": "El que no escatimó ni a su propio Hijo, antes le entregó por todos nosotros, ¿cómo no nos dará también con él todas las cosas?", "words": [[0, 243981], [3, 244085], [7, 244205], [10, 244478], [19, 244752], [22, 245025], [24, 245145], [27, 245265], [34, 245485], [40, 246165], [46, 246465], [49, 246665], [57, 247065], [61, 247205], [67, 247405], [77, 248445], [83, 248625], [86, 248805], [90, 248985], [95, 249245], [103, 249505], [107, 249745], [110, 249865], [116, 250045], [120, 250325]]}, {"verse": 33, "start": 251394, "end": 255547, "text": "¿Quién acusará a los escogidos de Dios? Dios es el que justifica.", "words": [[0, 251617], [7, 251857], [15, 252097], [17, 252197], [21, 252297], [31, 252897], [34, 253057], [40, 253902], [45, 254159], [48, 254479], [51, 254599], [55, 254739]]}, {"verse": 34, "start": 255997, "end": 265529, "text": "¿Quién es el que condenará? Cristo es el que murió; más aún, el que también resucitó, quien además está a la diestra de Dios, el que también intercede por nosotros.", "words": [[0, 255997], [7, 256218], [10, 256318], [13, 256438], [17, 256538], [28, 257592], [35, 257874], [38, 258034], [41, 258154], [45, 258274], [52, 259050], [56, 259229], [61, 259569], [64, 259729], [68, 259869], [76, 260209], [86, 261269], [92, 261349], [99, 261729], [104, 262069], [106, 262189], [109, 262249], [117, 262629], [120, 262809], [126, 263449], [129, 263569], [133, 263689], [141, 263989], [151, 264589], [155, 264849]]}, {"verse": 35, "start": 265979, "end": 275964, "text": "¿Quién nos apartará del amor de Cristo? tribulación? o angustia? o persecución? o hambre? o desnudez? o peligro? o espada?", "words": [[0, 265979], [7, 266176], [11, 266296], [20, 266836], [24, 266996], [29, 267216], [32, 267396], [40, 268255], [53, 269503], [55, 269668], [65, 270718], [67, 270859], [80, 272009], [82, 272189], [90, 272983], [92, 273403], [102, 274160], [104, 274258], [113, 275208], [115, 275326]]}, {"verse": 36, "start": 276414, "end": 283033, "text": "Como está escrito: Por causa de ti somos muertos todo el tiempo: somos estimados como ovejas de matadero.", "words": [[0, 276414], [5, 276578], [10, 276798], [19, 277748], [23, 277869], [29, 278129], [32, 278369], [35, 278529], [41, 278809], [49, 279289], [54, 279529], [57, 279729], [65, 280639], [71, 280840], [81, 281560], [86, 281840], [93, 282200], [96, 282340]]}, {"verse": 37, "start": 283483, "end": 288478, "text": "Antes, en todas estas cosas hacemos más que vencer por medio de aquel que nos amó.", "words": [[0, 283483], [7, 283787], [10, 284007], [16, 284187], [22, 284547], [28, 285027], [36, 285627], [40, 286027], [44, 286227], [51, 286727], [55, 286987], [61, 287247], [64, 287467], [70, 287767], [74, 287867], [78, 288027]]}, {"verse": 38, "start": 288928, "end": 297043, "text": "Por lo cual estoy cierto que ni la muerte, ni la vida, ni ángeles, ni principados, ni potestades, ni lo presente, ni lo por venir,", "words": [[0, 288928], [4, 289033], [7, 289153], [12, 289413], [18, 289673], [25, 290053], [29, 290273], [32, 290413], [35, 290533], [43, 291133], [46, 291233], [49, 291373], [55, 291853], [58, 291993], [67, 292673], [70, 292753], [83, 293873], [86, 293953], [98, 294953], [101, 295133], [104, 295233], [114, 296173], [117, 296253], [120, 296526], [124, 296800]]}, {"verse": 39, "start": 297493, "end": 306004, "text": "Ni lo alto, ni lo bajo, ni ninguna criatura nos podrá apartar del amor de Dios, que es en Cristo Jesús Señor nuestro.", "words": [[0, 297493], [3, 297634], [6, 297774], [12, 298054], [15, 298294], [18, 298414], [24, 298734], [27, 299154], [35, 299534], [44, 300134], [48, 300294], [54, 300774], [62, 301294], [66, 301454], [71, 301714], [74, 301914], [80, 302634], [84, 302894], [87, 303134], [90, 303274], [97, 303594], [103, 304334], [109, 304574]]}]}