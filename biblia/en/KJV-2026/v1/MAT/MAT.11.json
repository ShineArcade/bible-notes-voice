{"book": "MAT", "chapter": 11, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 211402, "verses": [{"verse": 1, "start": 300, "end": 9302, "text": "And it came to pass, when Jesus had made an end of commanding his twelve disciples, he departed from there to teach and to preach in their cities.", "words": [[0, 300], [4, 449], [7, 569], [12, 769], [15, 969], [21, 1809], [26, 2009], [32, 2329], [36, 2609], [41, 2789], [44, 2949], [48, 3269], [51, 3409], [62, 3969], [66, 4109], [73, 4469], [84, 5629], [87, 5689], [96, 6109], [101, 6449], [107, 6749], [110, 6969], [116, 7409], [120, 7769], [123, 7909], [130, 8229], [133, 8509], [139, 8669]]}, {"verse": 2, "start": 9752, "end": 14767, "text": "Now when John had heard in the prison the works of Christ, he sent two of his disciples,", "words": [[0, 9752], [4, 9902], [9, 10102], [14, 10382], [18, 10622], [24, 10862], [27, 11042], [31, 11122], [38, 11402], [42, 11602], [48, 11862], [51, 12042], [59, 12862], [62, 13022], [67, 13302], [71, 13562], [74, 13742], [78, 13882]]}, {"verse": 3, "start": 15217, "end": 19142, "text": "And said to him, Are you he that should come, or do we look for another?", "words": [[0, 15217], [4, 15346], [9, 15606], [12, 15866], [17, 16466], [21, 16602], [25, 16742], [28, 16922], [33, 17122], [40, 17282], [46, 17682], [49, 18002], [52, 18142], [55, 18262], [60, 18422], [64, 18622]]}, {"verse": 4, "start": 19492, "end": 25366, "text": "Jesus answered and said to them, Go and show John again those things which you do hear and see:", "words": [[0, 19492], [6, 19757], [15, 20277], [19, 20497], [24, 20697], [27, 20877], [33, 21596], [36, 21778], [40, 22118], [45, 22398], [50, 22698], [56, 23098], [62, 23378], [69, 23758], [75, 23998], [79, 24158], [82, 24428], [87, 24698], [91, 24898]]}, {"verse": 5, "start": 25816, "end": 34950, "text": "The blind receive their sight, and the lame walk, the lepers are cleansed, and the deaf hear, the dead are raised up, and the poor have the gospel preached to them.", "words": [[0, 25816], [4, 25913], [10, 26233], [18, 26693], [24, 26973], [31, 27593], [35, 27853], [39, 27993], [44, 28233], [50, 28953], [54, 29013], [61, 29353], [65, 29533], [75, 30233], [79, 30413], [83, 30553], [88, 30773], [94, 31433], [98, 31533], [103, 31793], [107, 31973], [114, 32233], [118, 32929], [122, 33053], [126, 33173], [131, 33413], [136, 33613], [140, 33753], [147, 34073], [156, 34433], [159, 34673]]}, {"verse": 6, "start": 35400, "end": 38741, "text": "And blessed is he, who soever shall not be offended in me", "words": [[0, 35400], [4, 35544], [12, 35844], [15, 36124], [19, 36491], [23, 36857], [30, 37224], [36, 37524], [40, 37724], [43, 37884], [52, 38244], [55, 38464]]}, {"verse": 7, "start": 39091, "end": 48069, "text": "¶ And as they departed, Jesus began to say to the multitudes concerning John, What did you go out into the wilderness to see? A reed shaken with the wind?", "words": [[2, 39091], [6, 39221], [9, 39401], [14, 39561], [24, 40421], [30, 40761], [36, 41201], [39, 41421], [43, 41681], [46, 41821], [50, 41961], [61, 42561], [72, 43021], [78, 44021], [83, 44164], [87, 44344], [91, 44464], [94, 44624], [98, 44804], [103, 45024], [107, 45164], [118, 45484], [121, 45824], [126, 46553], [128, 46713], [133, 47013], [140, 47273], [145, 47513], [149, 47633]]}, {"verse": 8, "start": 48519, "end": 55250, "text": "But what did you go out to see? A man clothed in soft clothing? behold, they that wear soft clothing are in kings’ houses.", "words": [[0, 48519], [4, 48617], [9, 48797], [13, 48957], [17, 49057], [20, 49177], [24, 49337], [27, 49497], [32, 50183], [34, 50279], [38, 50519], [46, 51019], [49, 51099], [54, 51359], [64, 52275], [72, 52759], [77, 52859], [82, 53059], [87, 53219], [92, 53559], [101, 53939], [105, 54179], [108, 54319], [115, 54679]]}, {"verse": 9, "start": 55700, "end": 60402, "text": "But what did you go out to see? A prophet? yes, I say to you, and more than a prophet.", "words": [[0, 55700], [4, 55796], [9, 55936], [13, 56076], [17, 56196], [20, 56336], [24, 56496], [27, 56656], [32, 57296], [34, 57618], [43, 58224], [48, 58565], [50, 58645], [54, 58845], [57, 58985], [62, 59165], [66, 59385], [71, 59605], [76, 59765], [78, 60105]]}, {"verse": 10, "start": 60852, "end": 67798, "text": "For this is he, of whom it is written, Behold, I send my messenger before your face, which shall prepare your way before you.", "words": [[0, 60852], [4, 60957], [9, 61157], [12, 61317], [16, 61557], [19, 61877], [24, 62037], [27, 62137], [30, 62257], [39, 62817], [47, 63697], [49, 63957], [54, 64217], [57, 64417], [67, 64817], [74, 65177], [79, 65377], [85, 66017], [91, 66117], [97, 66337], [105, 66657], [110, 66857], [114, 67057], [121, 67397]]}, {"verse": 11, "start": 68248, "end": 78867, "text": "Assuredly I say to you, Among them that are born of women there has not risen a greater than John the Baptist: notwithstanding he that is least in the kingdom of heaven is greater than he.", "words": [[0, 68248], [10, 68852], [12, 68992], [16, 69232], [19, 69412], [24, 69932], [30, 70172], [35, 70492], [40, 70692], [44, 70812], [49, 71072], [52, 71232], [58, 71932], [64, 72012], [68, 72192], [72, 72412], [78, 72732], [80, 72892], [88, 73192], [93, 73472], [98, 73752], [102, 73932], [111, 75270], [127, 75670], [130, 75970], [135, 76190], [138, 76350], [144, 76610], [147, 76850], [151, 76950], [159, 77210], [162, 77450], [169, 77710], [172, 77930], [180, 78230], [185, 78490]]}, {"verse": 12, "start": 79317, "end": 85884, "text": "And from the days of John the Baptist until now the kingdom of heaven suffers violence, and the violent take it by force.", "words": [[0, 79317], [4, 79442], [9, 79602], [13, 79702], [18, 79982], [21, 80102], [26, 80382], [30, 80562], [38, 80902], [44, 81302], [48, 81702], [52, 81882], [60, 82182], [63, 82402], [70, 82642], [78, 83022], [88, 83842], [92, 84242], [96, 84342], [104, 84702], [109, 85002], [112, 85102], [115, 85262]]}, {"verse": 13, "start": 86334, "end": 89210, "text": "For all the prophets and the law prophesied until John.", "words": [[0, 86334], [4, 86419], [8, 86619], [12, 86739], [21, 87119], [25, 87399], [29, 87499], [33, 87719], [44, 88419], [50, 88619]]}, {"verse": 14, "start": 89660, "end": 93190, "text": "And if you will receive it, this is Elias, which was to come.", "words": [[0, 89660], [4, 89804], [7, 89964], [11, 90124], [16, 90264], [24, 90604], [28, 91104], [33, 91324], [36, 91524], [43, 92224], [49, 92364], [53, 92564], [56, 92724]]}, {"verse": 15, "start": 93640, "end": 96097, "text": "He that has ears to hear, let him hear.", "words": [[0, 93640], [3, 93771], [8, 93971], [12, 94191], [17, 94431], [20, 94671], [26, 95131], [30, 95451], [34, 95631]]}, {"verse": 16, "start": 96547, "end": 102968, "text": "¶ But to what shall I liken this generation? It is like to children sitting in the markets, and calling to their fellows,", "words": [[2, 96547], [6, 96652], [9, 96812], [14, 96972], [20, 97192], [22, 97352], [28, 97692], [33, 97952], [45, 98902], [48, 99028], [51, 99168], [56, 99388], [59, 99568], [68, 99988], [76, 100348], [79, 100548], [83, 100628], [92, 101028], [96, 101568], [104, 101928], [107, 102148], [113, 102308]]}, {"verse": 17, "start": 103418, "end": 109864, "text": "And saying, We have piped to you, and you have not danced; we have mourned to you, and you have not lamented.", "words": [[0, 103418], [4, 103581], [12, 104221], [15, 104601], [20, 104781], [26, 105181], [29, 105321], [34, 105541], [38, 105841], [42, 106001], [47, 106141], [51, 106321], [59, 107329], [62, 107503], [67, 107663], [75, 108063], [78, 108203], [83, 108403], [87, 108623], [91, 108763], [96, 108903], [100, 109143]]}, {"verse": 18, "start": 110314, "end": 114615, "text": "For John came neither eating nor drinking, and they say, He has a demon.", "words": [[0, 110314], [4, 110419], [9, 110739], [14, 110999], [22, 111299], [29, 111639], [33, 111939], [43, 112659], [47, 112879], [52, 113019], [57, 113339], [60, 113759], [64, 113979], [66, 114079]]}, {"verse": 19, "start": 115065, "end": 126188, "text": "The Son of man came eating and drinking, and they say, Behold a man gluttonous, and a drunkard, a friend of tax collectors and sinners. But wisdom is justified of her children.", "words": [[0, 115065], [4, 115209], [8, 115469], [11, 115589], [15, 115909], [20, 116149], [27, 116609], [31, 116969], [41, 117849], [45, 117969], [50, 118149], [55, 118909], [62, 119309], [64, 119609], [68, 119829], [80, 120529], [84, 120729], [86, 120829], [96, 121569], [98, 121669], [105, 121949], [108, 122109], [112, 122389], [123, 122869], [127, 123109], [136, 124009], [140, 124111], [147, 124511], [150, 124751], [160, 125251], [163, 125511], [167, 125611]]}, {"verse": 20, "start": 126538, "end": 132895, "text": "¶ Then began he to upbraid the cities in which most of his mighty works were done, because they repented not:", "words": [[2, 126538], [7, 126689], [13, 127029], [16, 127289], [19, 127639], [27, 127989], [31, 128129], [38, 128449], [41, 129029], [47, 129189], [52, 129509], [55, 129709], [59, 129829], [66, 130129], [72, 130469], [77, 130709], [83, 131329], [91, 131649], [96, 131869], [105, 132349]]}, {"verse": 21, "start": 133145, "end": 146117, "text": "Woe to you, Chorazin! woe to you, Bethsaida! for if the mighty works, which were done in you, had been done in Tyre and Sidon, they would have repented long ago in sackcloth and ashes.", "words": [[0, 133145], [4, 133608], [7, 133708], [12, 134293], [22, 135123], [26, 135541], [29, 135641], [34, 136791], [45, 138190], [49, 138338], [52, 138498], [56, 138618], [63, 138838], [70, 139498], [76, 139698], [81, 139838], [86, 140058], [89, 140178], [94, 140718], [98, 140838], [103, 141018], [108, 141218], [111, 141468], [116, 141718], [120, 142328], [127, 142938], [132, 143058], [138, 143198], [143, 143318], [152, 143718], [157, 143958], [161, 144278], [164, 144478], [174, 145238], [178, 145478]]}, {"verse": 22, "start": 146567, "end": 152794, "text": "But I say to you, It shall be more tolerable for Tyre and Sidon at the day of judgment, than for you.", "words": [[0, 146567], [4, 146674], [6, 146854], [10, 147114], [13, 147314], [18, 147954], [21, 148114], [27, 148334], [30, 148494], [35, 148734], [45, 149334], [49, 149614], [54, 149894], [58, 150304], [64, 150714], [67, 150834], [71, 150934], [75, 151134], [78, 151234], [88, 151614], [93, 152134], [97, 152354]]}, {"verse": 23, "start": 153244, "end": 164098, "text": "And you, Capernaum, which are exalted to heaven, shall be brought down to hell: for if the mighty works, which have been done in you, had been done in Sodom, it would have remained until this day.", "words": [[0, 153244], [4, 153385], [9, 154015], [20, 154645], [26, 154825], [30, 154985], [38, 155445], [41, 155645], [49, 156145], [55, 156345], [58, 156505], [66, 156745], [71, 157105], [74, 157305], [80, 158005], [84, 158131], [87, 158291], [91, 158411], [98, 158631], [105, 158991], [111, 159471], [116, 159611], [121, 159791], [126, 159971], [129, 160131], [134, 160371], [138, 160791], [143, 160971], [148, 161171], [151, 161291], [158, 162371], [161, 162431], [167, 162591], [172, 162711], [181, 163051], [187, 163431], [192, 163671]]}, {"verse": 24, "start": 164548, "end": 170682, "text": "But I say to you, That it shall be more tolerable for the land of Sodom in the day of judgment, than for you.", "words": [[0, 164548], [4, 164645], [6, 164745], [10, 164985], [13, 165205], [18, 165745], [23, 165965], [26, 166085], [32, 166285], [35, 166445], [40, 166745], [50, 167385], [54, 167565], [58, 167685], [63, 167985], [66, 168125], [72, 168605], [75, 168705], [79, 168825], [83, 169045], [86, 169145], [96, 169545], [101, 170045], [105, 170285]]}, {"verse": 25, "start": 171032, "end": 180900, "text": "¶ At that time Jesus answered and said, I thank you, O Father, Lord of heaven and earth, because you have hid these things from the wise and prudent, and have revealed them to babes.", "words": [[2, 171032], [5, 171132], [10, 171312], [15, 171772], [21, 171992], [30, 172572], [34, 172812], [40, 173446], [42, 173606], [48, 173846], [53, 174146], [55, 174226], [63, 174986], [68, 175206], [71, 175346], [78, 175626], [82, 175806], [89, 176406], [97, 176626], [101, 176826], [106, 176946], [110, 177126], [116, 177306], [123, 177666], [128, 177886], [132, 178026], [137, 178366], [141, 178606], [150, 179366], [154, 179466], [159, 179566], [168, 179886], [173, 180146], [176, 180306]]}, {"verse": 26, "start": 181350, "end": 184701, "text": "Even so, Father: for so it seemed good in your sight.", "words": [[0, 181350], [5, 181566], [9, 182046], [17, 182753], [21, 182864], [24, 183344], [27, 183424], [34, 183684], [39, 183924], [42, 184084], [47, 184184]]}, {"verse": 27, "start": 185151, "end": 195100, "text": "All things are delivered to me of my Father and no man knows the Son but the Father neither knows any man the Father save the Son and he to whom soever the Son will reveal him.", "words": [[0, 185151], [4, 185332], [11, 185612], [15, 185792], [25, 186092], [28, 186332], [31, 186452], [34, 186592], [37, 186752], [44, 187472], [48, 187632], [51, 187852], [55, 188112], [61, 188392], [65, 188632], [69, 189092], [73, 189172], [77, 189312], [84, 189612], [92, 189832], [98, 190232], [102, 190512], [106, 190792], [110, 190932], [117, 191192], [122, 192082], [126, 192182], [130, 192442], [134, 192582], [137, 192782], [140, 193062], [145, 193342], [152, 193622], [156, 193842], [160, 194122], [165, 194302], [172, 194642]]}, {"verse": 28, "start": 195550, "end": 200140, "text": "¶ Come to me, all you that labour and are heavy laden, and I will give you rest.", "words": [[2, 195550], [7, 195880], [10, 196080], [14, 196360], [18, 196520], [22, 196740], [27, 197000], [34, 197260], [38, 197580], [42, 197720], [48, 197960], [55, 198820], [59, 198920], [61, 199080], [66, 199240], [71, 199420], [75, 199560]]}, {"verse": 29, "start": 200590, "end": 207050, "text": "Take my yoke upon you, and learn of me; for I am meek and lowly in heart: and you shall find rest to your souls.", "words": [[0, 200590], [5, 200707], [8, 200927], [13, 201227], [18, 201467], [23, 201707], [27, 201967], [33, 202207], [36, 202367], [40, 203017], [44, 203124], [46, 203344], [49, 203464], [54, 203784], [58, 203944], [64, 204364], [67, 204464], [74, 205205], [78, 205322], [82, 205422], [88, 205582], [93, 205862], [98, 206162], [101, 206342], [106, 206442]]}, {"verse": 30, "start": 207500, "end": 211002, "text": "For my yoke is easy, and my burden is light.", "words": [[0, 207500], [4, 207632], [7, 207852], [12, 208192], [15, 208352], [21, 208792], [25, 209532], [28, 209712], [35, 210092], [38, 210432]]}]}