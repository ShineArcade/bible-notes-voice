{"book": "LUK", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 359681, "verses": [{"verse": 1, "start": 300, "end": 12206, "text": "Y después de estas cosas, designó el Señor aun otros setenta, los cuales envió de dos en dos delante de sí, a toda ciudad y lugar a donde él había de venir.", "words": [[0, 300], [2, 419], [10, 699], [13, 939], [19, 1119], [26, 2299], [34, 2859], [37, 2999], [43, 3459], [47, 3919], [53, 4379], [62, 5579], [66, 5699], [73, 5979], [79, 6659], [82, 6779], [86, 7079], [89, 7379], [93, 7619], [101, 8159], [104, 8339], [108, 8930], [110, 9130], [115, 9350], [122, 9810], [124, 10230], [130, 10590], [132, 10830], [138, 11090], [141, 11330], [147, 11550], [150, 11750]]}, {"verse": 2, "start": 12556, "end": 22966, "text": "Y les decía: La cosecha a la verdad es mucha, pero los obreros pocos; por tanto, rogad al Señor de la cosecha que envíe obreros a su cosecha.", "words": [[0, 12556], [2, 12726], [6, 12806], [13, 13713], [16, 13822], [24, 14382], [26, 14562], [29, 14622], [36, 14882], [39, 15142], [46, 15882], [51, 16042], [55, 16222], [63, 16642], [70, 17449], [74, 17575], [81, 18365], [87, 19155], [90, 19395], [96, 19775], [99, 20015], [102, 20135], [110, 20655], [114, 20815], [120, 21355], [128, 21995], [130, 22115], [133, 22235]]}, {"verse": 3, "start": 23316, "end": 27946, "text": "Andad, he aquí yo os envío como corderos en medio de lobos.", "words": [[0, 23316], [7, 23805], [10, 24325], [15, 24485], [18, 24785], [21, 25065], [27, 25625], [32, 26115], [41, 26605], [44, 26785], [50, 27105], [53, 27285]]}, {"verse": 4, "start": 28296, "end": 33534, "text": "No llevéis bolsa, ni alforja, ni calzado; y a nadie saludéis en el camino.", "words": [[0, 28296], [3, 28606], [11, 29106], [18, 29606], [21, 29766], [30, 30386], [33, 30506], [42, 31546], [44, 31658], [46, 31718], [52, 32208], [61, 32698], [64, 32838], [67, 32958]]}, {"verse": 5, "start": 33884, "end": 39392, "text": "En cualquier casa donde entréis, primeramente decid: Paz sea a esta casa.", "words": [[0, 33884], [3, 34034], [13, 34294], [18, 34834], [24, 35134], [33, 36134], [46, 36877], [53, 37934], [57, 38128], [61, 38321], [63, 38541], [68, 38761]]}, {"verse": 6, "start": 39742, "end": 47380, "text": "Y si hay allí algún hijo de paz, vuestra paz reposará sobre él; y si no, se volverá a vosotros.", "words": [[0, 39742], [2, 39863], [5, 39983], [9, 40183], [14, 40463], [20, 40723], [25, 40943], [28, 41123], [33, 41883], [41, 42263], [45, 42563], [54, 43583], [60, 43903], [64, 44692], [66, 44916], [69, 45056], [73, 45596], [76, 45796], [84, 46396], [86, 46536]]}, {"verse": 7, "start": 47730, "end": 57734, "text": "Y posad en aquella misma casa, comiendo y bebiendo lo que os den; porque el obrero digno es de su salario. No os paséis de casa en casa.", "words": [[0, 47730], [2, 47855], [8, 48475], [11, 48775], [19, 49115], [25, 49335], [31, 50175], [40, 50835], [42, 50975], [51, 51435], [54, 51615], [58, 51755], [61, 51875], [66, 52563], [73, 52827], [76, 53167], [83, 53567], [89, 54087], [92, 54227], [95, 54347], [98, 54507], [107, 55631], [110, 55821], [113, 56011], [120, 56201], [123, 56621], [128, 56881], [131, 57121]]}, {"verse": 8, "start": 58084, "end": 63857, "text": "Y en cualquier ciudad donde entréis y os reciban, comed lo que os pongan delante;", "words": [[0, 58084], [2, 58229], [5, 58369], [15, 58649], [22, 59289], [28, 59689], [36, 60389], [38, 60629], [41, 60749], [50, 61829], [56, 62189], [59, 62409], [63, 62549], [66, 62689], [73, 63089]]}, {"verse": 9, "start": 64207, "end": 71078, "text": "Y sanad los enfermos que en ella haya, y decidles: Se ha llegado a vosotros el reino de Dios.", "words": [[0, 64207], [2, 64453], [8, 64733], [12, 65013], [21, 65293], [25, 65574], [28, 65854], [33, 66134], [39, 66414], [41, 66753], [51, 68267], [54, 68556], [57, 68736], [65, 69176], [67, 69276], [76, 69716], [79, 69976], [85, 70376], [88, 70536]]}, {"verse": 10, "start": 71428, "end": 77769, "text": "Pero en cualquier ciudad donde entréis y no os reciban, saliendo por sus calles, decid:", "words": [[0, 71428], [5, 71592], [8, 71732], [18, 72072], [25, 72652], [31, 73012], [39, 73792], [41, 74052], [44, 74252], [47, 74432], [56, 75032], [65, 75952], [69, 76152], [73, 76372], [81, 77059]]}, {"verse": 11, "start": 78119, "end": 89029, "text": "Aun el polvo que se nos ha pegado de vuestra ciudad a nuestros pies, sacudimos en vosotros: Pero esto sabed, que el reino de los cielos se ha llegado a vosotros.", "words": [[0, 78119], [4, 78284], [7, 78504], [13, 79043], [17, 79164], [20, 79324], [24, 79463], [27, 79643], [34, 80184], [37, 80344], [45, 80684], [52, 81084], [54, 81384], [63, 81544], [69, 82314], [79, 83084], [82, 83283], [92, 84270], [97, 84434], [102, 84774], [109, 85114], [113, 85414], [116, 85594], [122, 86034], [125, 86174], [129, 86334], [136, 87034], [139, 87474], [142, 87634], [150, 88074], [152, 88194]]}, {"verse": 12, "start": 89379, "end": 95861, "text": "Y os digo que el juicio será más llevadero para los de Sodoma aquel día que para aquella ciudad.", "words": [[0, 89379], [2, 89506], [5, 89626], [10, 89826], [14, 90066], [17, 90186], [24, 90606], [29, 90886], [33, 91226], [43, 91986], [48, 92246], [52, 92486], [55, 92706], [62, 93286], [68, 93746], [72, 94006], [76, 94446], [81, 94726], [89, 95126]]}, {"verse": 13, "start": 96211, "end": 111220, "text": "¡Ay de ti, Corazín! ¡Ay de ti, Betsaida! que si en Tiro y en Sidón hubieran sido hechas las maravillas que se han hecho en vosotras, hace ya tiempo que, sentados en cilicio y ceniza, se habrían arrepentido.", "words": [[0, 96325], [4, 96475], [7, 96675], [11, 97233], [20, 98211], [24, 98509], [27, 98807], [31, 99106], [41, 99562], [45, 99664], [48, 99884], [51, 100064], [56, 100444], [58, 100704], [61, 100844], [67, 101604], [76, 102184], [81, 102484], [88, 102824], [92, 103004], [103, 103564], [107, 103744], [110, 103884], [114, 104024], [120, 104224], [123, 104384], [133, 105264], [138, 105664], [141, 105884], [148, 106264], [153, 106624], [162, 107544], [165, 107964], [173, 108384], [175, 108544], [183, 109064], [186, 109604], [194, 110084]]}, {"verse": 14, "start": 111570, "end": 116332, "text": "Por tanto, el juicio será más llevadero para Tiro y Sidón que para vosotras.", "words": [[0, 111570], [4, 111697], [11, 112117], [14, 112217], [21, 112657], [26, 112937], [30, 113297], [40, 114017], [45, 114257], [50, 114617], [52, 114757], [58, 115137], [62, 115257], [67, 115517]]}, {"verse": 15, "start": 116682, "end": 123262, "text": "Y tú, Capernaum, que hasta los cielos estás levantada, hasta los infiernos serás abatida.", "words": [[0, 116682], [2, 116965], [6, 117165], [17, 118285], [21, 118505], [27, 118685], [31, 118905], [38, 119225], [44, 119545], [55, 120645], [61, 120865], [65, 121065], [75, 121885], [81, 122445]]}, {"verse": 16, "start": 123612, "end": 133250, "text": "El que a vosotros oye, a mí oye; y el que a vosotros desecha, a mí desecha; y el que a mí desecha, desecha al que me envió.", "words": [[0, 123612], [3, 123749], [7, 123889], [9, 123989], [18, 124429], [23, 124849], [25, 125029], [28, 125209], [33, 125995], [35, 126125], [38, 126265], [42, 126425], [44, 126565], [53, 127225], [62, 127885], [64, 128165], [67, 128825], [76, 129662], [78, 129953], [81, 130073], [85, 130233], [87, 130373], [90, 130513], [99, 131553], [107, 132293], [110, 132413], [114, 132553], [117, 132713]]}, {"verse": 17, "start": 133600, "end": 140588, "text": "Y volvieron los setenta con gozo, diciendo: Señor, aun los demonios se nos sujetan en tu nombre.", "words": [[0, 133600], [2, 133723], [12, 134203], [16, 134503], [24, 134803], [28, 135183], [34, 135783], [44, 137360], [51, 138260], [55, 138460], [59, 138660], [68, 139180], [71, 139300], [75, 139400], [83, 139900], [86, 140000], [89, 140120]]}, {"verse": 18, "start": 140868, "end": 146025, "text": "Y les dijo: Yo veía a Satanás, como un rayo, que caía del cielo.", "words": [[0, 140868], [2, 141012], [6, 141327], [12, 141809], [15, 142000], [20, 142460], [22, 142660], [31, 143360], [36, 143740], [39, 143920], [45, 144460], [49, 144780], [54, 145180], [58, 145360]]}, {"verse": 19, "start": 146375, "end": 155510, "text": "He aquí os doy potestad de pisar sobre las serpientes y sobre los escorpiones, y sobre toda fuerza del enemigo, y nada os dañará.", "words": [[0, 146375], [3, 146541], [8, 146801], [11, 146981], [15, 147281], [24, 147941], [27, 148101], [33, 148561], [39, 148821], [43, 149061], [54, 149761], [56, 149981], [62, 150221], [66, 150441], [79, 151221], [81, 151466], [87, 151686], [92, 151966], [99, 152366], [103, 152686], [112, 153426], [114, 153986], [119, 154266], [122, 154666]]}, {"verse": 20, "start": 155860, "end": 164406, "text": "Pero no os gocéis de esto, que los espíritus se os sujetan; sino gozaos de que vuestros nombres están escritos en los cielos.", "words": [[0, 155860], [5, 156028], [8, 156288], [11, 156528], [18, 157068], [21, 157228], [27, 157608], [31, 157823], [35, 157963], [45, 158703], [48, 158823], [51, 158923], [60, 159962], [65, 160260], [72, 161300], [75, 161680], [79, 161800], [88, 162200], [96, 162660], [102, 162940], [111, 163440], [114, 163660], [118, 163800]]}, {"verse": 21, "start": 164756, "end": 183097, "text": "En aquella misma hora Jesús se alegró en espíritu, y dijo: Yo te alabo, oh Padre, Señor del cielo y de la tierra, que escondiste estas cosas a los sabios y entendidos, y las has revelado a los pequeños: así, Padre, porque así te agradó.", "words": [[0, 164756], [3, 165070], [11, 165430], [17, 165650], [22, 165990], [28, 166430], [31, 166890], [38, 167330], [41, 167450], [51, 168430], [53, 168490], [59, 169311], [62, 169445], [65, 169578], [72, 170078], [75, 170178], [82, 170938], [88, 171298], [92, 171638], [98, 172058], [100, 172278], [103, 172398], [106, 172518], [114, 173458], [118, 173598], [129, 174438], [135, 174718], [141, 175178], [143, 175418], [147, 175578], [154, 176118], [156, 176298], [168, 177138], [170, 177598], [174, 177798], [178, 178078], [187, 179058], [189, 179158], [193, 179278], [203, 180339], [208, 181003], [215, 181783], [222, 182063], [226, 182283], [229, 182503]]}, {"verse": 22, "start": 183447, "end": 195382, "text": "Todas las cosas me son entregadas de mi Padre: y nadie sabe quién sea el Hijo sino el Padre; ni quién sea el Padre, sino el Hijo, y a quien el Hijo lo quiera revelar.", "words": [[0, 183447], [6, 183711], [10, 183851], [16, 184251], [19, 184471], [23, 184671], [34, 185311], [37, 185471], [40, 185591], [47, 186426], [49, 186739], [55, 187019], [60, 187479], [66, 187799], [70, 188179], [73, 188439], [78, 188699], [83, 188979], [86, 189219], [93, 190060], [96, 190243], [102, 190463], [106, 190783], [109, 190963], [116, 191323], [121, 191843], [124, 192243], [130, 192623], [132, 193203], [134, 193323], [140, 193483], [143, 193723], [148, 193963], [151, 194143], [158, 194785]]}, {"verse": 23, "start": 195732, "end": 202778, "text": "Y vuelto en privado a los discípulos, dijo: Bienaventurados los ojos que ven lo que vosotros veis:", "words": [[0, 195732], [2, 196072], [9, 196552], [12, 196692], [20, 197192], [22, 197312], [26, 197412], [38, 198352], [44, 199791], [60, 200231], [64, 200431], [69, 200791], [73, 201031], [77, 201211], [80, 201411], [84, 201551], [93, 202011]]}, {"verse": 24, "start": 203128, "end": 212114, "text": "Porque os digo que muchos profetas y reyes desearon ver lo que vosotros veis, y no lo vieron; y oír lo que oís, y no lo oyeron.", "words": [[0, 203128], [7, 203371], [10, 203511], [15, 203731], [19, 203951], [26, 204291], [35, 204951], [37, 205131], [43, 205571], [52, 206351], [56, 206711], [59, 206956], [63, 207096], [72, 207576], [78, 208176], [80, 208391], [83, 208531], [86, 208671], [94, 209739], [96, 209925], [100, 210112], [103, 210292], [107, 210512], [112, 210732], [114, 211032], [117, 211252], [120, 211432]]}, {"verse": 25, "start": 212464, "end": 221846, "text": "Y he aquí, un intérprete de la ley se levantó, tentándole y diciendo: Maestro, ¿haciendo qué cosa poseeré la vida eterna?", "words": [[0, 212464], [2, 212674], [5, 212814], [11, 213194], [14, 213494], [25, 214474], [28, 214614], [31, 214774], [35, 215034], [38, 215294], [47, 216574], [58, 217394], [60, 217634], [70, 218613], [79, 219315], [89, 219655], [93, 219895], [98, 220195], [106, 220795], [109, 220915], [114, 221115]]}, {"verse": 26, "start": 222126, "end": 225878, "text": "Y él le dijo: ¿Qué está escrito en la ley? ¿cómo lees?", "words": [[0, 222126], [2, 222311], [5, 222451], [8, 222611], [14, 223397], [19, 223519], [24, 223679], [32, 224019], [35, 224259], [38, 224399], [43, 225058], [49, 225247]]}, {"verse": 27, "start": 226228, "end": 237154, "text": "Y él respondiendo, dijo: Amarás al Señor tu Dios de todo tu corazón, y de toda tu alma, y de todas tus fuerzas, y de todo tu entendimiento; y a tu prójimo como a ti mismo.", "words": [[0, 226228], [2, 226412], [5, 226832], [19, 227692], [25, 228340], [32, 228837], [35, 228977], [41, 229277], [44, 229577], [49, 229857], [52, 230037], [57, 230277], [60, 230477], [69, 230877], [71, 231317], [74, 231437], [79, 231617], [82, 231877], [88, 232177], [90, 232412], [93, 232532], [99, 232712], [103, 232932], [112, 233472], [114, 233747], [117, 233847], [122, 234047], [125, 234227], [140, 235389], [142, 235514], [144, 235594], [147, 235674], [155, 236174], [160, 236374], [162, 236534], [165, 236614]]}, {"verse": 28, "start": 237434, "end": 241312, "text": "Y le dijo: Bien has respondido: haz esto, y vivirás.", "words": [[0, 237434], [2, 237558], [5, 237678], [11, 238404], [16, 238601], [20, 238831], [32, 239809], [36, 240024], [42, 240324], [44, 240584]]}, {"verse": 29, "start": 241662, "end": 247074, "text": "Pero él, queriéndose justificar a sí mismo, dijo a Jesús: ¿Y quién es mi prójimo?", "words": [[0, 241662], [5, 241826], [9, 242406], [21, 242966], [32, 243626], [34, 243786], [37, 243926], [44, 244686], [49, 244946], [51, 245126], [58, 245874], [61, 245963], [67, 246089], [70, 246216], [73, 246436]]}, {"verse": 30, "start": 247354, "end": 260808, "text": "Y respondiendo Jesús, dijo: Un hombre descendía de Jerusalén a Jericó, y cayó en manos de ladrones, los cuales le despojaron; e hiriéndole, se fueron, dejándole medio muerto.", "words": [[0, 247354], [2, 247468], [15, 248268], [22, 248628], [28, 249796], [31, 249961], [38, 250261], [48, 251021], [51, 251141], [61, 251941], [63, 252141], [71, 252701], [73, 253081], [78, 253501], [81, 253621], [87, 253881], [90, 254101], [100, 254961], [104, 255061], [111, 255341], [114, 255921], [126, 257108], [128, 257596], [140, 258116], [143, 258276], [151, 259056], [161, 259616], [167, 259936]]}, {"verse": 31, "start": 261158, "end": 267539, "text": "Y aconteció, que descendió un sacerdote por aquel camino, y viéndole, se pasó de un lado.", "words": [[0, 261158], [2, 261303], [13, 262123], [17, 262303], [27, 263023], [30, 263243], [40, 263963], [44, 264203], [50, 264483], [58, 264983], [60, 265643], [70, 266303], [73, 266363], [78, 266703], [81, 266903], [84, 267023]]}, {"verse": 32, "start": 267889, "end": 274378, "text": "Y asimismo un levita, llegando cerca de aquel lugar, y viéndole, se pasó de un lado.", "words": [[0, 267889], [2, 268354], [11, 268834], [14, 269174], [22, 270134], [31, 270494], [37, 270794], [40, 271074], [46, 271334], [53, 271674], [55, 272134], [65, 273054], [68, 273134], [73, 273474], [76, 273674], [79, 273814]]}, {"verse": 33, "start": 274728, "end": 281520, "text": "Pero un samaritano que transitaba, viniendo cerca de él, y viéndole, fue movido a misericordia;", "words": [[0, 274728], [5, 274895], [8, 275115], [19, 275815], [23, 275975], [35, 276755], [44, 277295], [50, 277595], [53, 277875], [57, 278035], [59, 278615], [69, 279535], [73, 279875], [80, 280455], [82, 280595]]}, {"verse": 34, "start": 281870, "end": 292154, "text": "Y acercándose, vendó sus heridas, echándoles aceite y vino; y poniéndole sobre su cabalgadura, le llevó al mesón, y cuidó de él.", "words": [[0, 281870], [2, 281974], [15, 283254], [21, 283654], [25, 283874], [34, 284494], [45, 285434], [52, 285913], [54, 286392], [60, 287056], [62, 287177], [73, 287937], [79, 288317], [82, 289037], [95, 289757], [98, 289957], [104, 290317], [107, 290417], [114, 290897], [116, 291117], [122, 291557], [125, 291677]]}, {"verse": 35, "start": 292504, "end": 303321, "text": "Y otro día al partir, sacó dos denarios, y los dio al mesonero, y le dijo: Cuídamele; y todo lo que de más gastes, yo cuando vuelva te lo pagaré.", "words": [[0, 292504], [2, 292629], [7, 292809], [11, 293209], [14, 293329], [22, 294129], [27, 294609], [31, 294969], [41, 295609], [43, 295889], [47, 296069], [51, 296289], [54, 296489], [64, 297129], [66, 297289], [69, 297389], [75, 298112], [86, 299138], [88, 299283], [93, 299583], [96, 299903], [100, 300070], [103, 300236], [107, 300403], [115, 301263], [118, 301503], [125, 301763], [132, 302363], [135, 302483], [138, 302643]]}, {"verse": 36, "start": 303671, "end": 309866, "text": "¿Quién, pues, de estos tres te parece que fue el prójimo de aquel que cayó en manos de los ladrones?", "words": [[0, 303671], [8, 303996], [14, 304216], [17, 304736], [23, 304956], [28, 305276], [31, 305436], [38, 305796], [42, 306056], [46, 306296], [49, 306656], [57, 307296], [60, 307476], [66, 307776], [70, 307916], [75, 308336], [78, 308516], [84, 308796], [87, 308996], [91, 309116]]}, {"verse": 37, "start": 310216, "end": 317585, "text": "Y él dijo: El que usó con él de misericordia. Entonces Jesús le dijo: Ve, y haz tú lo mismo.", "words": [[0, 310216], [2, 310383], [5, 310748], [11, 311242], [14, 311389], [18, 311509], [22, 311869], [26, 312029], [29, 312149], [32, 312269], [46, 314108], [55, 314571], [61, 315271], [64, 315551], [70, 316411], [74, 316613], [76, 316704], [80, 316795], [83, 316955], [86, 317075]]}, {"verse": 38, "start": 317935, "end": 325577, "text": "Y aconteció que yendo, entró él en una aldea: y una mujer llamada Marta, le recibió en su casa.", "words": [[0, 317935], [2, 318078], [12, 318658], [16, 318818], [23, 319278], [29, 320178], [32, 320438], [35, 320698], [39, 320898], [46, 321948], [48, 322250], [52, 322410], [58, 322690], [66, 323150], [73, 323730], [76, 324150], [84, 324710], [87, 324830], [90, 324970]]}, {"verse": 39, "start": 325927, "end": 333667, "text": "Y esta tenía una hermana que se llamaba María, la cual sentándose a los pies de Jesús, oía su palabra.", "words": [[0, 325927], [2, 326054], [7, 326354], [13, 326674], [17, 326894], [25, 327334], [29, 327514], [32, 327654], [40, 328114], [47, 329274], [50, 329374], [55, 329574], [66, 330594], [68, 330734], [72, 330874], [77, 331094], [80, 331254], [87, 331614], [91, 332354], [94, 332534]]}, {"verse": 40, "start": 334017, "end": 345168, "text": "Pero Marta se distraía en muchos servicios; y sobreviniendo, dice: Señor, ¿no tienes cuidado que mi hermana me deja servir sola? Dile pues, que me ayude.", "words": [[0, 334017], [5, 334162], [11, 334782], [14, 334942], [23, 335642], [26, 335822], [33, 336142], [44, 337172], [46, 337272], [61, 338372], [67, 339183], [74, 340188], [78, 340388], [85, 340648], [93, 341108], [97, 341368], [100, 341508], [108, 341908], [111, 342108], [116, 342368], [123, 342708], [129, 343695], [134, 344021], [140, 344201], [144, 344441], [147, 344581]]}, {"verse": 41, "start": 345448, "end": 352311, "text": "Pero respondiendo Jesús, le dijo: Marta, Marta, preocupada estás, y con las muchas cosas estás turbada:", "words": [[0, 345448], [5, 345611], [18, 346331], [25, 346731], [28, 347231], [34, 348007], [41, 348574], [48, 348974], [59, 349554], [66, 349814], [68, 350259], [72, 350419], [76, 350559], [83, 350819], [89, 351219], [95, 351519]]}, {"verse": 42, "start": 352661, "end": 359281, "text": "Pero una cosa es necesaria; y María escogió la buena parte, la cual no le será quitada.", "words": [[0, 352661], [5, 352803], [9, 353003], [14, 353363], [17, 353703], [28, 354875], [30, 354983], [36, 355623], [44, 356203], [47, 356303], [53, 356463], [60, 357303], [63, 357423], [68, 357643], [71, 358203], [74, 358383], [79, 358603]]}]}