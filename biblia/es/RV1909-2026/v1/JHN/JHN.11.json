{"book": "JHN", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 411795, "verses": [{"verse": 1, "start": 300, "end": 7627, "text": "Estaba entonces enfermo uno llamado Lázaro, de Betania, la aldea de María y de Marta su hermana.", "words": [[0, 300], [7, 684], [16, 1184], [24, 1984], [28, 2304], [36, 2664], [44, 3344], [47, 3824], [56, 4789], [59, 4869], [65, 5389], [68, 5549], [74, 5849], [76, 6209], [79, 6329], [85, 6769], [88, 6969]]}, {"verse": 2, "start": 7977, "end": 16911, "text": "(Y María, cuyo hermano Lázaro estaba enfermo, era la que ungió al Señor con perfume, y limpió sus pies con sus cabellos.)", "words": [[0, 7977], [3, 8103], [10, 8503], [15, 8983], [23, 9423], [30, 9923], [37, 10223], [46, 11423], [50, 11843], [53, 12043], [57, 12423], [63, 12803], [66, 13083], [72, 13463], [76, 13823], [85, 14443], [87, 14723], [94, 15243], [98, 15443], [103, 15663], [107, 15943], [111, 16083]]}, {"verse": 3, "start": 17261, "end": 23652, "text": "Enviaron, pues, sus hermanas a él, diciendo: Señor, he aquí, el que amas está enfermo.", "words": [[0, 17261], [10, 17789], [16, 18429], [20, 18549], [29, 19049], [31, 19249], [35, 19449], [45, 20505], [52, 21365], [55, 21485], [61, 21865], [64, 22245], [68, 22425], [73, 22765], [78, 22985]]}, {"verse": 4, "start": 23932, "end": 34314, "text": "Y oyéndolo Jesús, dijo: Esta enfermedad no es para muerte, sino para la gloria de Dios, para que el Hijo de Dios sea glorificado por ella.", "words": [[0, 23932], [2, 24276], [11, 24656], [18, 24896], [24, 25856], [29, 26083], [40, 26803], [43, 26943], [46, 27063], [51, 27263], [59, 28343], [64, 28723], [69, 29043], [72, 29203], [79, 29623], [82, 29783], [88, 30723], [93, 31043], [97, 31263], [100, 31543], [105, 31843], [108, 32003], [113, 32303], [117, 32703], [129, 33563], [133, 33803]]}, {"verse": 5, "start": 34664, "end": 39050, "text": "Y amaba Jesús a Marta, y a su hermana, y a Lázaro.", "words": [[0, 34664], [2, 34771], [8, 35211], [14, 35431], [16, 35711], [23, 36551], [25, 36931], [27, 36991], [30, 37151], [39, 38171], [41, 38484], [43, 38796]]}, {"verse": 6, "start": 39400, "end": 44626, "text": "Cuando oyó pues que estaba enfermo, se quedó aún dos días en aquel lugar donde estaba.", "words": [[0, 39400], [7, 39693], [11, 40023], [16, 40283], [20, 40463], [27, 40703], [36, 41363], [39, 41523], [45, 41843], [49, 42163], [53, 42383], [58, 42703], [61, 42983], [67, 43323], [73, 43583], [79, 43883]]}, {"verse": 7, "start": 44976, "end": 49780, "text": "Luego, después de esto, dijo a los discípulos: Vamos a Judea otra vez.", "words": [[0, 44976], [7, 45431], [15, 45631], [18, 45911], [24, 46451], [29, 46751], [31, 46911], [35, 47011], [47, 48069], [53, 48315], [55, 48475], [61, 48955], [66, 49215]]}, {"verse": 8, "start": 50130, "end": 56014, "text": "Le dicen los discípulos: Rabí, ahora procuraban los judíos apedrearte, ¿y otra vez vas allá?", "words": [[0, 50130], [3, 50350], [9, 50670], [13, 50930], [25, 52156], [31, 52326], [37, 52506], [48, 53126], [52, 53306], [59, 53896], [71, 54486], [74, 54846], [79, 55026], [83, 55366], [87, 55566]]}, {"verse": 9, "start": 56294, "end": 63648, "text": "Respondió Jesús: ¿No tiene el día doce horas? El que anda de día, no tropieza, porque ve la luz de este mundo.", "words": [[0, 56294], [10, 56783], [17, 57680], [21, 57784], [27, 58024], [30, 58224], [34, 58424], [39, 58624], [46, 59527], [49, 59679], [53, 59819], [58, 59979], [61, 60179], [66, 60459], [69, 60839], [79, 61459], [86, 61959], [89, 62159], [92, 62299], [96, 62559], [99, 62779], [104, 62959]]}, {"verse": 10, "start": 63998, "end": 68839, "text": "Pero el que anda de noche, tropieza, porque no hay luz en él.", "words": [[0, 63998], [5, 64144], [8, 64324], [12, 64484], [17, 64724], [20, 64904], [27, 65404], [37, 66584], [44, 67004], [47, 67244], [51, 67564], [55, 67884], [58, 68424]]}, {"verse": 11, "start": 69189, "end": 75233, "text": "Dicho esto, les dice después: Lázaro nuestro amigo duerme; pero voy a despertarle del sueño.", "words": [[0, 69189], [6, 69428], [12, 69668], [16, 69868], [21, 70128], [30, 71078], [37, 71630], [45, 71850], [51, 72210], [59, 73086], [64, 73250], [68, 73470], [70, 73570], [82, 74410], [86, 74550]]}, {"verse": 12, "start": 75583, "end": 80050, "text": "Dijeron entonces sus discípulos: Señor, si duerme, se recuperará.", "words": [[0, 75583], [8, 76128], [17, 76628], [21, 76988], [33, 78181], [40, 78661], [43, 78701], [51, 79041], [54, 79241]]}, {"verse": 13, "start": 80330, "end": 86746, "text": "Pero esto decía Jesús de la muerte de él: y ellos pensaron que hablaba del reposar del sueño.", "words": [[0, 80330], [5, 80473], [10, 80753], [16, 81173], [22, 81633], [25, 82093], [28, 82213], [35, 82513], [38, 82911], [42, 83456], [44, 83756], [50, 83996], [59, 84696], [63, 84896], [71, 85276], [75, 85456], [83, 86036], [87, 86176]]}, {"verse": 14, "start": 87096, "end": 92321, "text": "Entonces, pues, Jesús les dijo claramente: Lázaro ha muerto;", "words": [[0, 87096], [10, 87972], [16, 88492], [22, 88892], [26, 89292], [31, 89632], [43, 90747], [50, 91294], [53, 91694]]}, {"verse": 15, "start": 92671, "end": 98700, "text": "Y me alegro por vosotros, que yo no haya estado allí, para que creáis: pero vamos a él.", "words": [[0, 92671], [2, 92813], [5, 92933], [12, 93373], [16, 93613], [26, 94273], [30, 94548], [33, 94708], [36, 94888], [41, 95148], [48, 95468], [54, 95888], [59, 96448], [63, 96648], [71, 97702], [76, 97828], [82, 98088], [84, 98328]]}, {"verse": 16, "start": 99050, "end": 108003, "text": "Dijo entonces Tomás, el que se dice el Dídimo, a sus condiscípulos: Vamos también nosotros, para que muramos con él.", "words": [[0, 99050], [5, 99386], [14, 99906], [21, 100786], [24, 101026], [28, 101186], [31, 101346], [36, 101706], [39, 102106], [47, 102766], [49, 103226], [53, 103931], [68, 104836], [74, 105054], [82, 105374], [92, 105754], [97, 106114], [101, 106254], [109, 106634], [113, 106874]]}, {"verse": 17, "start": 108283, "end": 113720, "text": "Vino pues Jesús, y halló que había ya cuatro días que estaba en el sepulcro.", "words": [[0, 108283], [5, 108549], [10, 108809], [17, 109809], [19, 110109], [25, 110509], [29, 110729], [35, 110949], [38, 111169], [45, 111549], [50, 112029], [54, 112229], [61, 112509], [64, 112689], [67, 112829]]}, {"verse": 18, "start": 114070, "end": 118469, "text": "Y Betania estaba cerca de Jerusalén, como quince estadios;", "words": [[0, 114070], [2, 114296], [10, 114836], [17, 115256], [23, 115636], [26, 115896], [37, 116616], [42, 117036], [49, 117456]]}, {"verse": 19, "start": 118819, "end": 124256, "text": "Y muchos de los judíos habían venido a Marta y a María, a consolarlas de su hermano.", "words": [[0, 118819], [2, 118940], [9, 119240], [12, 119420], [16, 119540], [23, 119980], [30, 120180], [37, 120680], [39, 120800], [45, 121280], [47, 121620], [49, 121700], [56, 122500], [58, 122580], [70, 123380], [73, 123520], [76, 123640]]}, {"verse": 20, "start": 124606, "end": 131967, "text": "Entonces Marta, cuando oyó que Jesús venía, salió a encontrarle; pero María se estuvo en casa.", "words": [[0, 124606], [9, 125489], [16, 126149], [23, 126459], [27, 126769], [31, 126929], [37, 127169], [44, 128069], [50, 128529], [52, 128749], [65, 130039], [70, 130320], [76, 130620], [79, 130860], [86, 131180], [89, 131340]]}, {"verse": 21, "start": 132317, "end": 138563, "text": "Y Marta dijo a Jesús: Señor, si hubieses estado aquí, mi hermano no habría muerto;", "words": [[0, 132317], [2, 132600], [8, 132920], [13, 133140], [15, 133340], [22, 134156], [29, 134981], [32, 135101], [41, 135501], [48, 135821], [54, 136661], [57, 136801], [65, 137341], [68, 137501], [75, 137881]]}, {"verse": 22, "start": 138913, "end": 143387, "text": "Pero también sé ahora, que todo lo que pidas a Dios, Dios te lo dará.", "words": [[0, 138913], [5, 139064], [13, 139414], [16, 139764], [23, 140164], [27, 140624], [32, 140844], [35, 141044], [39, 141184], [45, 141484], [47, 141644], [53, 142364], [58, 142544], [61, 142784], [64, 142904]]}, {"verse": 23, "start": 143667, "end": 146833, "text": "Le dice Jesús: Resucitará tu hermano.", "words": [[0, 143667], [3, 143784], [8, 144044], [15, 145058], [26, 146039], [29, 146179]]}, {"verse": 24, "start": 147183, "end": 153213, "text": "Marta le dice: Yo sé que resucitará en la resurrección en el día postrero.", "words": [[0, 147183], [6, 147728], [9, 147868], [15, 148610], [18, 148793], [21, 148973], [25, 149133], [36, 149993], [39, 150173], [42, 150273], [55, 151153], [58, 151413], [61, 151553], [65, 151793]]}, {"verse": 25, "start": 153493, "end": 161454, "text": "Le dice Jesús: Yo soy la resurrección y la vida: el que cree en mí, aunque esté muerto, vivirá.", "words": [[0, 153493], [3, 153610], [8, 153870], [15, 154884], [18, 155069], [22, 155369], [25, 155654], [38, 156574], [40, 156814], [43, 156934], [49, 157642], [52, 157787], [56, 157907], [61, 158227], [64, 158467], [68, 159107], [75, 159307], [80, 159647], [88, 160687]]}, {"verse": 26, "start": 161804, "end": 167599, "text": "Y todo aquel que vive y cree en mí, no morirá eternamente. ¿Crees esto?", "words": [[0, 162410], [2, 162565], [7, 162785], [13, 163225], [17, 163325], [22, 163625], [24, 163885], [29, 164165], [32, 164505], [36, 164745], [39, 165205], [46, 165665], [59, 166824], [66, 167049]]}, {"verse": 27, "start": 167949, "end": 173967, "text": "Le dice: Sí, Señor; yo he creído que tú eres el Cristo, el Hijo de Dios, que has venido al mundo.", "words": [[0, 167949], [3, 168095], [9, 168808], [13, 169133], [20, 169830], [23, 169978], [26, 170078], [33, 170378], [37, 170538], [40, 170718], [45, 170938], [48, 171098], [56, 171818], [59, 171898], [64, 172118], [67, 172238], [73, 172798], [77, 172858], [81, 173018], [88, 173338], [91, 173478]]}, {"verse": 28, "start": 174247, "end": 182834, "text": "Habiendo dicho esto, fue y llamó a María su hermana, diciéndole en secreto: El Maestro está aquí y te llama.", "words": [[0, 174247], [9, 174635], [15, 174955], [21, 175255], [25, 175727], [27, 175850], [33, 176210], [35, 176310], [41, 176570], [44, 176910], [53, 178070], [64, 178990], [67, 179390], [76, 180446], [79, 180576], [87, 181156], [92, 181456], [97, 181856], [99, 182136], [102, 182276]]}, {"verse": 29, "start": 183114, "end": 186686, "text": "Ella, como lo oyó, se levanta rápidamente y viene a él.", "words": [[0, 183114], [6, 183338], [11, 183618], [14, 183908], [19, 184198], [22, 184433], [30, 184933], [42, 185653], [44, 185853], [50, 186093], [52, 186293]]}, {"verse": 30, "start": 187036, "end": 193794, "text": "(Que aún no había llegado Jesús a la aldea, pero estaba en aquel lugar donde Marta le había encontrado.)", "words": [[0, 187036], [5, 187138], [9, 187358], [12, 187598], [18, 187818], [26, 188278], [32, 188598], [34, 188978], [37, 189138], [44, 189738], [49, 190198], [56, 190498], [59, 190698], [65, 190998], [71, 191298], [77, 191658], [83, 192258], [86, 192578], [92, 192818]]}, {"verse": 31, "start": 194144, "end": 207727, "text": "Entonces los judíos que estaban en casa con ella, y la consolaban, cuando vieron que María se había levantado rápidamente, y había salido, la siguieron, diciendo: Va al sepulcro a llorar allí.", "words": [[0, 194144], [9, 195157], [13, 195417], [20, 195957], [24, 196077], [32, 196357], [35, 196517], [40, 196757], [44, 197057], [50, 197337], [52, 197817], [55, 197957], [67, 199357], [74, 199437], [81, 199777], [85, 199957], [91, 200217], [94, 200497], [100, 200697], [110, 201257], [123, 202117], [125, 202577], [131, 202797], [139, 203677], [142, 203777], [153, 204377], [163, 205804], [166, 206067], [169, 206227], [178, 206827], [180, 207007], [187, 207307]]}, {"verse": 32, "start": 208007, "end": 218920, "text": "Pero María, cuando vino donde estaba Jesús, viéndole, se derribó a sus pies, diciéndole: Señor, si hubieras estado aquí, no habría muerto mi hermano.", "words": [[0, 208007], [5, 208151], [12, 208511], [19, 208891], [24, 209271], [30, 209511], [37, 209891], [44, 210911], [54, 211811], [57, 211951], [65, 212511], [67, 212611], [71, 212771], [77, 213291], [89, 214360], [96, 215502], [99, 215642], [108, 216122], [115, 216482], [121, 217322], [124, 217442], [131, 217822], [138, 218182], [141, 218342]]}, {"verse": 33, "start": 219200, "end": 228014, "text": "Jesús entonces, como la vio llorando, y a los judíos que habían venido juntamente con ella llorando, se conmovió en espíritu, y se turbó,", "words": [[0, 219200], [6, 219530], [16, 220230], [21, 220410], [24, 220550], [28, 220750], [38, 221310], [40, 221790], [42, 221890], [46, 221990], [53, 222530], [57, 222650], [64, 222890], [71, 223330], [82, 223910], [86, 224100], [91, 224290], [101, 225125], [104, 225205], [113, 225865], [116, 225945], [126, 227005], [128, 227225], [131, 227365]]}, {"verse": 34, "start": 228364, "end": 233805, "text": "Y dijo: ¿Dónde le pusisteis? Le dicen: Señor, ven, y ve.", "words": [[0, 228364], [2, 228465], [8, 229896], [15, 230123], [18, 230343], [29, 231792], [32, 232114], [39, 232627], [46, 232881], [51, 233171], [53, 233511]]}, {"verse": 35, "start": 234085, "end": 235101, "text": "Y lloró Jesús.", "words": [[0, 234085], [2, 234272], [8, 234492]]}, {"verse": 36, "start": 235451, "end": 238824, "text": "Dijeron entonces los judíos: Mirad cómo le amaba.", "words": [[0, 235451], [8, 235996], [17, 236456], [21, 236736], [29, 237721], [35, 238019], [40, 238239], [43, 238399]]}, {"verse": 37, "start": 239104, "end": 245299, "text": "Y algunos de ellos dijeron: ¿No podía este que abrió los ojos al ciego, hacer que este no muriera?", "words": [[0, 239104], [2, 239225], [10, 239545], [13, 239785], [19, 240105], [28, 241358], [32, 241484], [38, 241764], [43, 242164], [47, 242304], [53, 242584], [57, 242744], [62, 243004], [65, 243244], [72, 243884], [78, 244124], [82, 244344], [87, 244564], [90, 244704]]}, {"verse": 38, "start": 245579, "end": 254117, "text": "Y Jesús, conmoviéndose otra vez en sí mismo, vino al sepulcro. Era una cueva, la cual tenía una piedra encima.", "words": [[0, 245579], [2, 245709], [9, 246469], [23, 247409], [28, 247709], [32, 247989], [35, 248189], [38, 248369], [45, 249469], [50, 249709], [53, 249909], [63, 250941], [67, 251127], [71, 251327], [78, 252067], [81, 252167], [86, 252387], [92, 252767], [96, 253007], [103, 253427]]}, {"verse": 39, "start": 254467, "end": 263866, "text": "Dice Jesús: Quitad la piedra. Marta, la hermana del que se había muerto, le dice: Señor, ya huele mal, porque lleva cuatro días muerto.", "words": [[0, 254467], [5, 254989], [12, 255869], [19, 256231], [22, 256391], [30, 257179], [37, 257746], [40, 257866], [48, 258099], [52, 258333], [56, 258566], [59, 258786], [65, 258986], [73, 259566], [76, 259666], [82, 260420], [89, 260738], [92, 261038], [98, 261378], [103, 261678], [110, 262098], [116, 262378], [123, 262678], [128, 263058]]}, {"verse": 40, "start": 264146, "end": 269393, "text": "Jesús le dice: ¿No te he dicho que, si crees, verás la gloria de Dios?", "words": [[0, 264146], [6, 264481], [9, 264721], [15, 265555], [19, 265680], [22, 265860], [25, 265940], [31, 266200], [36, 266440], [39, 267000], [46, 267600], [52, 268140], [55, 268260], [62, 268660], [65, 268800]]}, {"verse": 41, "start": 269743, "end": 280695, "text": "Entonces quitaron la piedra de donde el muerto había sido puesto. Y Jesús, alzando los ojos arriba, dijo: Padre, gracias te doy que me has oído.", "words": [[0, 269743], [9, 270434], [18, 271234], [21, 271414], [28, 271934], [31, 272074], [37, 272334], [40, 272554], [47, 273014], [53, 273234], [58, 273574], [66, 274531], [68, 274640], [75, 275480], [83, 275960], [87, 276180], [92, 276520], [100, 277380], [106, 278106], [113, 278772], [121, 279415], [124, 279507], [128, 279727], [132, 279807], [135, 279947], [139, 280087]]}, {"verse": 42, "start": 281045, "end": 289269, "text": "Que yo sabía que siempre me oyes; pero por causa de la multitud que está alrededor, lo dije, para que crean que tú me has enviado.", "words": [[0, 281045], [4, 281129], [7, 281269], [13, 281649], [17, 281769], [25, 282129], [28, 282409], [34, 283215], [39, 283359], [43, 283599], [49, 283939], [52, 284199], [55, 284579], [64, 284959], [68, 285139], [73, 285359], [84, 286219], [87, 286319], [93, 286619], [98, 287139], [102, 287339], [108, 287739], [112, 287899], [115, 288079], [118, 288279], [122, 288479]]}, {"verse": 43, "start": 289619, "end": 294723, "text": "Y habiendo dicho estas cosas, clamó a gran voz: Lázaro, ven fuera.", "words": [[0, 289619], [2, 289763], [11, 290103], [17, 290443], [23, 290663], [30, 291543], [36, 291983], [38, 292083], [43, 292223], [48, 293006], [56, 293971], [60, 294111]]}, {"verse": 44, "start": 295073, "end": 308344, "text": "Y el que había estado muerto, salió, atadas las manos y los pies con vendas; y su rostro estaba envuelto en un paño funerario. Les dice Jesús: Desatadle, y dejadle ir.", "words": [[0, 295073], [2, 295170], [5, 295250], [9, 295390], [15, 295610], [22, 295870], [30, 296510], [37, 297310], [44, 298170], [48, 298370], [54, 298770], [56, 299030], [60, 299170], [65, 299390], [69, 299610], [77, 300573], [79, 300677], [82, 300817], [89, 301397], [96, 301717], [105, 302417], [108, 302537], [111, 302697], [116, 303257], [127, 304665], [131, 304859], [136, 305052], [143, 305999], [154, 306777], [156, 307237], [164, 307857]]}, {"verse": 45, "start": 308694, "end": 316922, "text": "Entonces muchos de los judíos que habían venido a María, y habían visto lo que había hecho Jesús, creyeron en él.", "words": [[0, 308694], [9, 309497], [16, 309937], [19, 310157], [23, 310257], [30, 310717], [34, 310877], [41, 311117], [48, 311557], [50, 311637], [57, 311937], [59, 312402], [66, 312682], [72, 313122], [75, 313722], [79, 313862], [85, 314142], [91, 314442], [98, 315372], [107, 316302], [110, 316622]]}, {"verse": 46, "start": 317272, "end": 322340, "text": "Pero algunos de ellos fueron a los fariseos, y les dijeron lo que Jesús había hecho.", "words": [[0, 317272], [5, 317417], [13, 317777], [16, 317997], [22, 318277], [29, 318597], [31, 318857], [35, 318957], [45, 319697], [47, 320057], [51, 320197], [59, 320677], [62, 320817], [66, 320957], [72, 321237], [78, 321677]]}, {"verse": 47, "start": 322690, "end": 331594, "text": "Entonces los principales sacerdotes y los fariseos reunieron el Consejo, y decían: ¿Qué hacemos? porque este hombre hace muchas señales.", "words": [[0, 322690], [9, 323195], [13, 323695], [25, 324375], [36, 325055], [38, 325195], [42, 325335], [51, 326095], [61, 326855], [64, 327035], [73, 327655], [75, 327835], [83, 328705], [88, 328805], [97, 329684], [104, 329867], [109, 330047], [116, 330307], [121, 330567], [128, 330847]]}, {"verse": 48, "start": 331944, "end": 337801, "text": "Si le dejamos así, todos creerán en él: y vendrán los Romanos, y quitarán nuestro lugar y la nación.", "words": [[0, 331944], [3, 332064], [6, 332184], [14, 332524], [19, 333324], [25, 333464], [33, 334024], [36, 334124], [40, 334639], [42, 334755], [50, 335095], [54, 335215], [63, 335775], [65, 336035], [74, 336455], [82, 336635], [88, 337035], [90, 337195], [93, 337295]]}, {"verse": 49, "start": 338081, "end": 344477, "text": "Y Caifás, uno de ellos, sumo sacerdote de aquel año, les dijo: Vosotros no sabéis nada;", "words": [[0, 338081], [2, 338227], [10, 339227], [14, 339387], [17, 339587], [24, 340327], [29, 340707], [39, 341347], [42, 341547], [48, 341827], [53, 342067], [57, 342307], [63, 343032], [72, 343457], [75, 343657], [82, 344017]]}, {"verse": 50, "start": 344827, "end": 350229, "text": "Ni pensáis que nos conviene que un hombre muera por el pueblo, y no que toda la nación se pierda.", "words": [[0, 344827], [3, 344950], [11, 345450], [15, 345630], [19, 345790], [28, 346290], [32, 346470], [35, 346630], [42, 346870], [48, 347270], [52, 347470], [55, 347610], [63, 348010], [65, 348470], [68, 348610], [72, 348770], [77, 348950], [80, 349170], [87, 349530], [90, 349690]]}, {"verse": 51, "start": 350509, "end": 359518, "text": "Pero esto no lo dijo de sí mismo; sino que, como era el sumo sacerdote de aquel año, profetizó que Jesús había de morir por la nación:", "words": [[0, 350509], [5, 350654], [10, 350874], [13, 351074], [16, 351194], [21, 351474], [24, 351674], [27, 351814], [34, 352526], [39, 352726], [44, 353178], [49, 353398], [53, 353618], [56, 353778], [61, 354338], [71, 355038], [74, 355238], [80, 355538], [85, 356203], [95, 356803], [99, 356983], [105, 357343], [111, 357843], [114, 358123], [120, 358523], [124, 358683], [127, 358863]]}, {"verse": 52, "start": 359868, "end": 366731, "text": "Y no solamente por aquella nación, sino también para que juntase en uno los hijos de Dios que estaban dispersos.", "words": [[0, 359868], [2, 360014], [5, 360134], [15, 360514], [19, 360934], [27, 361274], [35, 362114], [40, 362434], [48, 362874], [53, 363194], [57, 363494], [65, 363794], [68, 364094], [72, 364294], [76, 364534], [82, 364834], [85, 365094], [90, 365314], [94, 365474], [102, 365734]]}, {"verse": 53, "start": 367081, "end": 370715, "text": "Así que, desde aquel día planeaban juntos matarle.", "words": [[0, 367081], [4, 367478], [9, 367678], [15, 367998], [21, 368418], [25, 368658], [35, 369378], [42, 369738]]}, {"verse": 54, "start": 371065, "end": 384829, "text": "Por tanto, Jesús ya no andaba abiertamente entre los judíos; sino que se alejó de allí a la región contigua al desierto, a una ciudad llamada Efraín: y estábase allí con sus discípulos.", "words": [[0, 371065], [4, 371209], [11, 371509], [17, 372029], [20, 372689], [23, 372909], [30, 373449], [43, 374329], [49, 374669], [53, 374889], [61, 375979], [66, 376177], [70, 376357], [73, 376517], [79, 376917], [82, 377037], [87, 377317], [89, 377497], [92, 377597], [99, 378207], [108, 378817], [111, 378897], [121, 379857], [123, 380057], [127, 380197], [134, 380537], [142, 381217], [150, 382364], [152, 382690], [161, 383050], [166, 383370], [170, 383610], [174, 383830]]}, {"verse": 55, "start": 385179, "end": 393397, "text": "Y la Pascua de los judíos estaba cerca: y muchos subieron de aquella tierra a Jerusalén antes de la Pascua, para purificarse;", "words": [[0, 385179], [2, 385306], [5, 385656], [12, 386006], [15, 386066], [19, 386206], [26, 386706], [33, 386986], [40, 387949], [42, 388074], [49, 388354], [58, 388974], [61, 389154], [69, 389514], [76, 389854], [78, 390154], [88, 390794], [94, 391134], [97, 391314], [100, 391414], [108, 391934], [113, 392334]]}, {"verse": 56, "start": 393747, "end": 400618, "text": "Y buscaban a Jesús, y hablaban los unos con los otros estando en el templo: ¿Qué os parece, que no vendrá a la fiesta?", "words": [[0, 393747], [2, 393911], [11, 394411], [13, 394551], [20, 394831], [22, 395176], [31, 395636], [35, 395816], [40, 396136], [44, 396456], [48, 396656], [54, 397036], [62, 397636], [65, 397776], [68, 397896], [76, 398678], [81, 398780], [84, 398900], [92, 399260], [96, 399440], [99, 399600], [106, 399940], [108, 400020], [111, 400060]]}, {"verse": 57, "start": 400898, "end": 411395, "text": "Y los principales sacerdotes y los fariseos habían dado mandamiento, que si alguno supiese dónde estuviera, lo manifestase, para que le prendiesen.", "words": [[0, 400898], [2, 401005], [6, 401125], [18, 401825], [29, 402545], [31, 402705], [35, 402825], [44, 403565], [51, 403810], [56, 404210], [69, 404990], [73, 405430], [76, 405570], [83, 406010], [91, 406450], [97, 406730], [108, 408030], [111, 408130], [124, 409590], [129, 410250], [133, 410410], [136, 410530]]}]}