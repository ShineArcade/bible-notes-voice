{"book": "GEN", "chapter": 19, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 365307, "verses": [{"verse": 1, "start": 300, "end": 14273, "text": "Llegaron, pues, los dos ángeles a Sodoma a la caída de la tarde: y Lot estaba sentado a la puerta de Sodoma. Y viéndolos Lot, se levantó a recibirlos, y se inclinó hacia el suelo;", "words": [[0, 300], [10, 805], [16, 1125], [20, 1550], [24, 1770], [32, 2470], [34, 2810], [41, 3370], [43, 3570], [46, 3670], [52, 4150], [55, 4350], [58, 4470], [65, 5275], [67, 5405], [71, 5645], [78, 6285], [86, 6925], [88, 7025], [91, 7105], [98, 7405], [101, 7665], [109, 8603], [111, 8727], [121, 9347], [126, 9747], [129, 10142], [137, 10702], [139, 10802], [151, 11762], [153, 12302], [156, 12702], [164, 13102], [170, 13362], [173, 13682]]}, {"verse": 2, "start": 14623, "end": 29850, "text": "Y dijo: Ahora, pues, mis señores, os ruego que vengáis a casa de vuestro siervo y os hospedéis, y lavaréis vuestros pies: y por la mañana os levantaréis, y seguiréis vuestro camino. Y ellos respondieron: No, que en la plaza nos quedaremos esta noche.", "words": [[0, 14623], [2, 14767], [8, 15457], [15, 15694], [21, 16074], [25, 16154], [34, 16914], [37, 17014], [43, 17394], [47, 17554], [55, 18034], [57, 18154], [62, 18394], [65, 18594], [73, 18934], [80, 19394], [82, 19514], [85, 19634], [96, 20214], [98, 20494], [107, 20914], [116, 21294], [122, 22065], [124, 22164], [128, 22304], [131, 22424], [138, 22744], [141, 23044], [154, 23804], [156, 24044], [166, 24464], [174, 24784], [182, 25590], [184, 25774], [190, 26114], [204, 27730], [208, 27888], [212, 28028], [215, 28088], [218, 28188], [224, 28508], [228, 28628], [239, 29088], [244, 29368]]}, {"verse": 3, "start": 30130, "end": 39952, "text": "Mas él insistió tanto, y fueron con él, y entraron en su casa; y les hizo banquete, y coció panes sin levadura, y comieron.", "words": [[0, 30130], [4, 30338], [7, 30718], [16, 31498], [23, 31918], [25, 32118], [32, 32358], [36, 32638], [40, 32918], [42, 33578], [51, 34218], [54, 34378], [57, 34498], [63, 35303], [65, 35447], [69, 35607], [74, 35827], [84, 36507], [86, 37107], [92, 37467], [98, 38067], [102, 38287], [112, 38927], [114, 39332]]}, {"verse": 4, "start": 40302, "end": 52020, "text": "Y antes que se acostasen, rodearon la casa los hombres de la ciudad, los varones de Sodoma, todo el pueblo junto, desde el más joven hasta el más viejo;", "words": [[0, 40302], [2, 40446], [8, 40646], [12, 40826], [15, 40986], [26, 41846], [35, 42806], [38, 43046], [43, 43446], [47, 44146], [55, 44586], [58, 44786], [61, 44886], [69, 45866], [73, 46126], [81, 46506], [84, 46686], [92, 47806], [97, 48066], [100, 48286], [107, 48586], [114, 49766], [120, 50066], [123, 50326], [127, 50506], [133, 50906], [139, 51126], [142, 51246], [146, 51406]]}, {"verse": 5, "start": 52370, "end": 60405, "text": "Y llamaron a Lot, y le dijeron: ¿Dónde están los varones que vinieron a ti esta noche? sácanoslos, para que los conozcamos.", "words": [[0, 52370], [2, 52495], [11, 52955], [13, 53235], [18, 53495], [20, 54055], [23, 54195], [32, 55165], [39, 55491], [45, 55750], [49, 55930], [57, 56311], [61, 56511], [70, 56890], [72, 57051], [75, 57210], [80, 57451], [87, 58591], [99, 58971], [104, 59271], [108, 59411], [112, 59531]]}, {"verse": 6, "start": 60685, "end": 65837, "text": "Entonces Lot salió a ellos a la puerta, y cerró las puertas tras sí,", "words": [[0, 60685], [9, 61187], [13, 61887], [19, 62567], [21, 62767], [27, 63067], [29, 63407], [32, 63507], [40, 63927], [42, 64202], [48, 64602], [52, 64762], [60, 65128], [65, 65493]]}, {"verse": 7, "start": 66187, "end": 69723, "text": "Y dijo: Os ruego, hermanos míos, que no hagáis tal maldad.", "words": [[0, 66187], [2, 66331], [8, 67021], [11, 67145], [18, 67465], [27, 67925], [33, 68305], [37, 68445], [40, 68605], [47, 68905], [51, 69105]]}, {"verse": 8, "start": 70073, "end": 80795, "text": "He aquí ahora yo tengo dos hijas que son vírgenes; os las sacaré afuera, y haced de ellas como bien os parezca: solamente a estos varones no hagáis nada, pues que vinieron a la sombra de mi tejado.", "words": [[0, 70104], [3, 70174], [8, 70354], [14, 70594], [17, 70814], [23, 71114], [27, 71374], [33, 71734], [37, 71834], [41, 72014], [51, 72982], [54, 73096], [58, 73246], [65, 73666], [73, 74086], [75, 74226], [81, 74506], [84, 74686], [90, 74886], [95, 75166], [100, 75386], [103, 75526], [112, 76401], [122, 76974], [124, 77114], [130, 77294], [138, 77734], [141, 77974], [148, 78274], [154, 78814], [159, 78914], [163, 79094], [172, 79474], [174, 79594], [177, 79694], [184, 80094], [187, 80214], [190, 80294]]}, {"verse": 9, "start": 81075, "end": 98606, "text": "Y ellos respondieron: Quita allá: y añadieron: Vino este aquí para habitar como un extraño, ¿y habrá de erigirse en juez? Ahora te haremos más mal que a ellos. Y hacían gran violencia al varón, a Lot, y se acercaron para romper las puertas.", "words": [[0, 81075], [2, 81259], [8, 81599], [22, 83422], [28, 83666], [34, 84135], [36, 84303], [47, 85345], [52, 85608], [57, 85868], [62, 86128], [67, 86368], [75, 86788], [80, 87028], [83, 87208], [92, 87788], [95, 88308], [101, 88628], [104, 88708], [113, 89168], [116, 89328], [122, 90043], [128, 90285], [131, 90445], [139, 90765], [143, 91025], [147, 91305], [151, 91505], [153, 91605], [160, 92444], [162, 92565], [169, 93005], [174, 93265], [184, 93985], [187, 94165], [194, 94677], [196, 95188], [201, 95700], [203, 95800], [206, 95920], [216, 96700], [221, 96980], [228, 97580], [232, 97740]]}, {"verse": 10, "start": 98956, "end": 106195, "text": "Entonces los varones alargaron la mano, y metieron a Lot en casa con ellos, y cerraron las puertas.", "words": [[0, 98956], [9, 99481], [13, 99961], [21, 100341], [31, 101041], [34, 101181], [40, 101521], [42, 101901], [51, 102401], [53, 102681], [57, 102841], [60, 103141], [65, 103481], [69, 103801], [76, 104121], [78, 104601], [87, 105261], [91, 105401]]}, {"verse": 11, "start": 106545, "end": 115112, "text": "Y a los hombres que estaban a la puerta de la casa desde el menor hasta el mayor, hirieron con ceguera; mas ellos no podían encontrar la puerta.", "words": [[0, 106545], [2, 106669], [4, 106748], [8, 106869], [16, 107248], [20, 107449], [28, 107729], [30, 107889], [33, 108029], [40, 108289], [43, 108548], [46, 108669], [51, 108929], [57, 109208], [60, 109429], [66, 109789], [72, 110244], [75, 110424], [82, 110925], [91, 111426], [95, 111928], [104, 112601], [108, 112661], [114, 112901], [117, 113141], [124, 113561], [134, 113981], [137, 114321]]}, {"verse": 12, "start": 115462, "end": 124186, "text": "Y dijeron los varones a Lot: ¿Tienes aquí alguno más? Yernos, y tus hijos y tus hijas, y todo lo que tienes en la ciudad, saca lo de este lugar:", "words": [[0, 115462], [2, 115602], [10, 116022], [14, 116142], [22, 116522], [24, 116702], [29, 117302], [37, 117617], [42, 117837], [49, 118277], [54, 118952], [62, 119450], [64, 119550], [68, 119690], [74, 119970], [76, 120190], [80, 120330], [87, 121030], [89, 121210], [94, 121390], [97, 121590], [101, 121710], [108, 121970], [111, 122150], [114, 122250], [122, 122623], [127, 122997], [130, 123370], [133, 123490], [138, 123690]]}, {"verse": 13, "start": 124536, "end": 132788, "text": "Porque vamos a destruir este lugar, por cuanto el clamor de ellos ha subido de punto delante de Jehová; por tanto Jehová nos ha enviado para destruirlo.", "words": [[0, 124536], [7, 124745], [13, 125005], [15, 125225], [24, 125745], [29, 125925], [36, 126285], [40, 126585], [47, 126825], [50, 127005], [57, 127405], [60, 127565], [66, 127785], [69, 128005], [76, 128385], [79, 128505], [85, 128785], [93, 129265], [96, 129405], [104, 130120], [108, 130221], [114, 130621], [121, 131061], [125, 131181], [128, 131361], [136, 131781], [141, 131981]]}, {"verse": 14, "start": 133068, "end": 147182, "text": "Entonces salió Lot, y habló a sus yernos, los que habían de tomar sus hijas, y les dijo: Levantaos, salid de este lugar; porque Jehová va a destruir esta ciudad. Mas pareció a sus yernos como que se burlaba.", "words": [[0, 133068], [9, 133596], [15, 134296], [20, 134616], [22, 134841], [28, 135201], [30, 135301], [34, 135481], [42, 136011], [46, 136541], [50, 136701], [57, 136921], [60, 137101], [66, 137341], [70, 137881], [77, 138421], [79, 138681], [83, 138841], [89, 139574], [100, 140005], [106, 140475], [109, 140695], [114, 140875], [121, 141583], [128, 141786], [135, 142246], [138, 142306], [140, 142426], [149, 142946], [154, 143126], [162, 143907], [166, 144064], [174, 144684], [176, 144844], [180, 145274], [187, 145704], [192, 146024], [196, 146204], [199, 146364]]}, {"verse": 15, "start": 147532, "end": 158564, "text": "Y al rayar el alba, los ángeles daban prisa a Lot, diciendo: Levántate, toma tu mujer, y tus dos hijas que se hallan aquí, porque no perezcas en el castigo de la ciudad.", "words": [[0, 147532], [2, 147640], [5, 147960], [11, 148280], [14, 148420], [20, 149320], [24, 149460], [32, 150040], [38, 150560], [44, 151000], [46, 151220], [51, 151480], [61, 152641], [72, 153498], [77, 153658], [80, 153838], [87, 154178], [89, 154404], [93, 154584], [97, 154764], [103, 155284], [107, 155404], [110, 155544], [117, 155804], [123, 156264], [130, 156584], [133, 156904], [142, 157224], [145, 157404], [148, 157484], [156, 157904], [159, 158004], [162, 158104]]}, {"verse": 16, "start": 158844, "end": 172721, "text": "Y deteniéndose él, los varones asieron de su mano, y de la mano de su mujer, y de las manos de sus dos hijas, según la misericordia de Jehová para con él; y le sacaron, y le pusieron fuera de la ciudad.", "words": [[0, 158844], [2, 158990], [15, 159930], [19, 160350], [23, 160550], [31, 161323], [39, 161925], [42, 162125], [45, 162285], [51, 162665], [53, 162890], [56, 163010], [59, 163150], [64, 163450], [67, 163630], [70, 163790], [77, 164230], [79, 164595], [82, 164695], [86, 164875], [92, 165255], [95, 165435], [99, 165615], [103, 165855], [110, 166860], [116, 167123], [119, 167383], [132, 168263], [135, 168363], [142, 168903], [147, 169083], [151, 169323], [155, 169943], [157, 170069], [160, 170169], [169, 170769], [171, 171029], [174, 171129], [183, 171609], [189, 171869], [192, 172089], [195, 172189]]}, {"verse": 17, "start": 173071, "end": 183655, "text": "Y aconteció que cuando los hubo sacado fuera, dijo: Escapa por tu vida; no mires tras ti, ni pares en toda esta llanura; escapa al monte, no sea que perezcas.", "words": [[0, 173071], [2, 173338], [12, 174018], [16, 174198], [23, 174458], [27, 174678], [32, 175048], [39, 175418], [46, 175678], [52, 176552], [59, 177091], [63, 177271], [66, 177431], [72, 178111], [75, 178256], [81, 178596], [86, 178736], [90, 179276], [93, 179596], [99, 179956], [102, 180076], [107, 180236], [112, 180476], [121, 181308], [128, 181733], [131, 181873], [138, 182453], [141, 182553], [145, 182733], [149, 182913]]}, {"verse": 18, "start": 183935, "end": 187695, "text": "Y Lot les dijo: No, yo os ruego, señores míos;", "words": [[0, 183935], [2, 184096], [6, 184316], [10, 184776], [16, 185645], [20, 185863], [23, 186143], [26, 186383], [33, 186723], [41, 187163]]}, {"verse": 19, "start": 188045, "end": 200195, "text": "He aquí ahora ha hallado tu siervo gracia en tus ojos, y has engrandecido tu misericordia que has hecho conmigo dándome la vida; mas yo no podré escapar al monte, no sea caso que me alcance el mal, y muera.", "words": [[0, 188045], [3, 188169], [8, 188529], [14, 188699], [17, 188869], [25, 189229], [28, 189389], [35, 189809], [42, 190249], [45, 190349], [49, 190509], [55, 190869], [57, 191389], [61, 191589], [74, 192309], [77, 192429], [90, 193289], [94, 193429], [98, 193609], [104, 193829], [112, 194309], [120, 194769], [123, 194929], [129, 195580], [133, 195741], [136, 195881], [139, 196001], [145, 196361], [153, 196761], [156, 196901], [163, 197641], [166, 197721], [170, 197921], [175, 198241], [179, 198441], [182, 198581], [190, 199041], [193, 199201], [198, 199421], [200, 199741]]}, {"verse": 20, "start": 200545, "end": 208587, "text": "He aquí ahora esta ciudad está cerca para huir allá, la cual es pequeña; escaparé ahora allá, (¿no es ella pequeña?) y salvaré mi vida.", "words": [[0, 200582], [3, 200662], [8, 200842], [14, 201142], [19, 201442], [26, 201782], [31, 202082], [37, 202462], [42, 202762], [47, 203062], [53, 203662], [56, 203742], [61, 203942], [64, 204142], [73, 204940], [82, 205519], [88, 205979], [94, 206439], [99, 206579], [102, 206759], [107, 206899], [117, 207379], [119, 207634], [127, 208094], [130, 208154]]}, {"verse": 21, "start": 208867, "end": 214588, "text": "Y le respondió: También he aceptado tu petición, y no destruiré la ciudad de que has hablado.", "words": [[0, 208867], [2, 209012], [5, 209152], [16, 210231], [24, 210570], [27, 210770], [36, 211270], [39, 211390], [49, 212030], [51, 212330], [54, 212450], [64, 213070], [67, 213170], [74, 213450], [77, 213770], [81, 213910], [85, 214050]]}, {"verse": 22, "start": 214938, "end": 222805, "text": "Date prisa, escápate allá; porque nada podré hacer hasta que allí hayas llegado. Por esto fue llamado el nombre de la ciudad, Zoar.", "words": [[0, 214938], [5, 215125], [12, 215785], [21, 216245], [27, 216879], [34, 217037], [39, 217337], [45, 217637], [51, 217977], [57, 218197], [61, 218357], [66, 218597], [72, 218917], [81, 219663], [85, 219788], [90, 220028], [94, 220288], [102, 220608], [105, 220848], [112, 221188], [115, 221388], [118, 221508], [126, 222192]]}, {"verse": 23, "start": 223155, "end": 227220, "text": "El sol salía sobre la tierra, cuando Lot llegó a Zoar.", "words": [[0, 223155], [3, 223460], [7, 223760], [13, 224380], [19, 224660], [22, 224880], [30, 225200], [37, 225655], [41, 226015], [47, 226455], [49, 226837]]}, {"verse": 24, "start": 227570, "end": 235420, "text": "Entonces llovió Jehová sobre Sodoma y sobre Gomorra azufre y fuego de parte de Jehová desde los cielos;", "words": [[0, 227570], [9, 228458], [16, 228931], [23, 229431], [29, 229651], [36, 230291], [38, 230431], [44, 230671], [52, 231551], [59, 232431], [61, 232616], [67, 232996], [70, 233236], [76, 233556], [79, 233796], [86, 234296], [92, 234396], [96, 234676]]}, {"verse": 25, "start": 235770, "end": 244424, "text": "Y destruyó las ciudades, y toda aquella llanura, con todos los moradores de aquellas ciudades, y el fruto de la tierra.", "words": [[0, 235770], [2, 235931], [11, 236711], [15, 236871], [25, 237651], [27, 238051], [32, 238491], [40, 239071], [49, 239591], [53, 239851], [59, 240291], [63, 240591], [73, 241191], [76, 241391], [85, 241831], [95, 242631], [97, 242811], [100, 242991], [106, 243511], [109, 243631], [112, 243751]]}, {"verse": 26, "start": 244774, "end": 250642, "text": "Entonces la mujer de Lot miró atrás, a espaldas de él, y se volvió estatua de sal.", "words": [[0, 244774], [9, 245278], [12, 245558], [18, 245918], [21, 246078], [25, 246358], [30, 247038], [37, 247878], [39, 247998], [48, 248558], [51, 248906], [55, 249253], [57, 249373], [60, 249513], [67, 249795], [75, 250077], [78, 250359]]}, {"verse": 27, "start": 250992, "end": 257710, "text": "Y subió Abraham por la mañana al lugar donde había estado delante de Jehová:", "words": [[0, 251761], [2, 252321], [8, 253061], [16, 253541], [20, 253961], [23, 254121], [30, 254581], [33, 255041], [39, 255321], [45, 255641], [51, 255941], [58, 256301], [66, 256861], [69, 257041]]}, {"verse": 28, "start": 258060, "end": 268661, "text": "Y miró hacia Sodoma y Gomorra, y hacia toda la tierra de aquella llanura miró; y he aquí que el humo subía de la tierra como el humo de un horno.", "words": [[0, 258060], [2, 258241], [7, 258601], [13, 259001], [20, 259721], [22, 259901], [31, 260581], [33, 261161], [39, 261401], [44, 261821], [47, 262081], [54, 262421], [57, 262761], [65, 263141], [73, 263601], [79, 264463], [81, 264573], [84, 264793], [89, 265093], [93, 265313], [96, 265513], [101, 265773], [107, 266173], [110, 266293], [113, 266413], [120, 266773], [125, 267153], [128, 267393], [133, 267753], [136, 267853], [139, 268053]]}, {"verse": 29, "start": 269011, "end": 282774, "text": "Así fue que, cuando destruyó Dios las ciudades de la llanura, se acordó Dios de Abraham, y envió fuera a Lot de en medio de la destrucción, al asolar las ciudades donde Lot estaba.", "words": [[0, 269011], [4, 269311], [8, 269611], [13, 269811], [20, 270111], [29, 270951], [34, 271271], [38, 271771], [47, 272371], [50, 272511], [53, 272631], [62, 273551], [65, 273851], [72, 274291], [77, 274631], [80, 274831], [89, 275331], [91, 275656], [97, 276076], [103, 276476], [105, 276796], [109, 277076], [112, 277576], [115, 277856], [121, 278216], [124, 278416], [127, 278536], [140, 280003], [143, 280263], [150, 280523], [154, 280843], [163, 281483], [169, 281733], [173, 281983]]}, {"verse": 30, "start": 283124, "end": 293789, "text": "Pero Lot subió de Zoar, y moró en el monte, y sus dos hijas con él; porque tuvo miedo de quedar en Zoar, y se alojó en una cueva él y sus dos hijas.", "words": [[0, 283263], [5, 283437], [9, 283610], [15, 284025], [18, 284355], [24, 284685], [26, 285185], [31, 285485], [34, 285585], [37, 285705], [44, 286105], [46, 286605], [50, 286765], [54, 287025], [60, 287565], [64, 287765], [68, 288375], [75, 288579], [80, 288859], [86, 289279], [89, 289479], [96, 289719], [99, 290149], [105, 290579], [107, 290699], [110, 290839], [116, 291279], [119, 291379], [123, 291559], [129, 291999], [132, 292299], [134, 292539], [138, 292739], [142, 292999]]}, {"verse": 31, "start": 294139, "end": 303472, "text": "Entonces la mayor dijo a la menor: Nuestro padre es viejo, y no queda varón en la tierra que entre a nosotras conforme a la costumbre de toda la tierra:", "words": [[0, 294139], [9, 295064], [12, 295184], [18, 295524], [23, 295864], [25, 296044], [28, 296124], [35, 296866], [43, 297254], [49, 297554], [52, 297854], [59, 298574], [61, 298834], [64, 298954], [70, 299174], [76, 299614], [79, 299734], [82, 299834], [89, 300094], [93, 300334], [99, 300474], [101, 300614], [110, 301254], [119, 301834], [121, 301874], [124, 301934], [134, 302494], [137, 302614], [142, 302794], [145, 302974]]}, {"verse": 32, "start": 303822, "end": 309737, "text": "Ven, demos a beber vino a nuestro padre, y durmamos con él, y conservaremos de nuestro padre descendencia.", "words": [[0, 303989], [5, 304155], [11, 304322], [13, 304522], [19, 304682], [24, 305022], [26, 305162], [34, 305342], [41, 305722], [43, 306162], [52, 306602], [56, 306842], [60, 307022], [62, 307362], [76, 308042], [79, 308242], [87, 308362], [93, 309092]]}, {"verse": 33, "start": 310017, "end": 320480, "text": "Y dieron a beber vino a su padre aquella noche: y entró la mayor, y durmió con su padre; mas él no sintió cuándo se acostó ella, ni cuándo se levantó.", "words": [[0, 310017], [2, 310224], [9, 310464], [11, 310624], [17, 310824], [22, 311204], [24, 311384], [27, 311524], [33, 311944], [41, 312364], [48, 313202], [50, 313350], [56, 313730], [59, 313870], [66, 314250], [68, 314710], [75, 315210], [79, 315390], [82, 315570], [89, 316442], [93, 316651], [96, 316871], [99, 317351], [106, 317891], [113, 318331], [116, 318431], [123, 318741], [129, 319051], [132, 319271], [139, 319651], [142, 319731]]}, {"verse": 34, "start": 320830, "end": 335582, "text": "El día siguiente dijo la mayor a la menor: He aquí yo dormí la noche pasada con mi padre; démosle a beber vino también esta noche, y entra y duerme con él, para que conservemos la descendencia de nuestro padre.", "words": [[0, 320830], [3, 320969], [7, 321149], [17, 321689], [22, 322329], [25, 322609], [31, 322989], [33, 323349], [36, 323449], [43, 324153], [46, 324301], [51, 325021], [54, 325161], [60, 325601], [63, 325681], [69, 325961], [76, 326501], [80, 326681], [83, 326841], [90, 327579], [98, 328103], [100, 328183], [106, 328383], [111, 328703], [119, 329043], [124, 329363], [131, 329743], [133, 330143], [139, 330543], [141, 330683], [148, 331003], [152, 331263], [156, 331483], [161, 331863], [165, 332023], [177, 332703], [180, 332863], [193, 333623], [196, 333743], [204, 333923]]}, {"verse": 35, "start": 335862, "end": 345996, "text": "Y dieron a beber vino a su padre también aquella noche: y se levantó la menor, y durmió con él; pero no echó de ver cuándo se acostó ella, ni cuándo se levantó.", "words": [[0, 335862], [2, 335979], [9, 336319], [11, 336459], [17, 336659], [22, 336999], [24, 337139], [27, 337239], [33, 337559], [41, 337919], [49, 338379], [56, 339192], [58, 339300], [61, 339400], [69, 339920], [72, 340020], [79, 340280], [81, 340645], [88, 341105], [92, 341285], [96, 341887], [101, 342051], [104, 342251], [109, 342551], [112, 342671], [116, 342851], [123, 343291], [126, 343411], [133, 343991], [139, 344191], [142, 344511], [149, 345131], [152, 345251]]}, {"verse": 36, "start": 346346, "end": 350041, "text": "Y concibieron las dos hijas de Lot, de su padre.", "words": [[0, 346346], [2, 346436], [14, 347156], [18, 347396], [22, 347696], [28, 348276], [31, 348416], [36, 348696], [39, 349176], [42, 349356]]}, {"verse": 37, "start": 350391, "end": 357606, "text": "Y parió la mayor un hijo, y llamó su nombre Moab, el cual es padre de los moabitas hasta hoy.", "words": [[0, 350391], [2, 350519], [8, 350859], [11, 351019], [17, 351319], [20, 351579], [26, 351879], [28, 352339], [34, 352659], [37, 352799], [44, 353119], [50, 353819], [53, 354299], [58, 354539], [61, 354759], [67, 355139], [70, 355399], [74, 355539], [83, 356259], [89, 356539]]}, {"verse": 38, "start": 357956, "end": 364907, "text": "La menor también parió un hijo, y llamó su nombre Ben-ammí, el cual es padre de los amonitas hasta hoy.", "words": [[0, 357956], [3, 358082], [9, 358342], [17, 358762], [23, 359142], [26, 359342], [32, 359622], [34, 359867], [40, 360207], [43, 360387], [50, 361185], [60, 361982], [63, 362222], [68, 362402], [71, 362622], [77, 363002], [80, 363202], [84, 363342], [93, 363962], [99, 364462]]}]}