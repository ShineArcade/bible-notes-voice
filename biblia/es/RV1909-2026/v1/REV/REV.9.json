{"book": "REV", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 185996, "verses": [{"verse": 1, "start": 300, "end": 7596, "text": "Y el quinto ángel tocó la trompeta, y vi una estrella que cayó del cielo en la tierra; y le fue dada la llave del pozo del abismo.", "words": [[0, 300], [2, 418], [5, 518], [12, 898], [18, 1318], [23, 1638], [26, 1738], [36, 2438], [38, 2618], [41, 2798], [45, 2938], [54, 3398], [58, 3538], [63, 3858], [67, 3938], [73, 4298], [76, 4438], [79, 4538], [87, 5368], [89, 5458], [92, 5558], [96, 5718], [101, 5978], [104, 6118], [110, 6438], [114, 6598], [119, 6918], [123, 7058]]}, {"verse": 2, "start": 8046, "end": 16236, "text": "Y abrió el pozo del abismo, y subió humo del pozo como el humo de un gran horno; y se oscureció el sol y el aire por el humo del pozo.", "words": [[0, 8046], [2, 8173], [8, 8473], [11, 8613], [16, 8953], [20, 9093], [28, 9573], [30, 10093], [36, 10453], [41, 10733], [45, 10833], [50, 11253], [55, 11493], [58, 11633], [63, 11893], [66, 11993], [69, 12133], [74, 12293], [81, 13143], [83, 13281], [86, 13361], [96, 13941], [99, 14101], [103, 14361], [105, 14661], [108, 14801], [113, 15041], [117, 15281], [120, 15401], [125, 15601], [129, 15701]]}, {"verse": 3, "start": 16686, "end": 23381, "text": "Y del humo salieron langostas sobre la tierra; y les fue dado poder, como tienen poder los escorpiones de la tierra.", "words": [[0, 16686], [2, 16791], [6, 16931], [11, 17251], [20, 17711], [30, 18391], [36, 18571], [39, 18731], [47, 19540], [49, 19662], [53, 19762], [57, 19982], [62, 20202], [69, 20622], [74, 21222], [81, 21502], [87, 21802], [91, 22022], [103, 22622], [106, 22802], [109, 22882]]}, {"verse": 4, "start": 23831, "end": 34269, "text": "Y les fue mandado que no hiciesen daño a la hierba de la tierra, ni a ninguna cosa verde, ni a ningún árbol, sino solamente a los hombres que no tienen el sello de Dios en sus frentes.", "words": [[0, 23831], [2, 23934], [6, 24054], [10, 24254], [18, 24714], [22, 24874], [25, 25014], [34, 25434], [39, 25854], [41, 25934], [44, 25994], [51, 26354], [54, 26454], [57, 26574], [65, 26954], [68, 27434], [70, 27494], [78, 27874], [83, 28194], [90, 28574], [93, 29014], [95, 29074], [102, 29394], [109, 30252], [114, 30491], [124, 30971], [126, 31291], [130, 31391], [138, 31691], [142, 31931], [145, 32141], [152, 32351], [155, 32591], [161, 32871], [164, 32971], [169, 33211], [172, 33371], [176, 33511]]}, {"verse": 5, "start": 34719, "end": 42799, "text": "Y les fue dado que no los matasen, sino que los atormentasen cinco meses; y su tormento era como tormento de escorpión, cuando hiere al hombre.", "words": [[0, 34719], [2, 34818], [6, 34938], [10, 35158], [15, 35358], [19, 35558], [22, 35678], [26, 35818], [35, 36478], [40, 36658], [44, 36818], [48, 36978], [61, 37798], [67, 38038], [74, 39098], [76, 39186], [79, 39286], [88, 39806], [92, 39906], [97, 40126], [106, 40686], [109, 40786], [120, 41426], [127, 41806], [133, 42226], [136, 42366]]}, {"verse": 6, "start": 43249, "end": 49899, "text": "Y en aquellos días buscarán los hombres la muerte, y no la hallarán; y desearán morir, y la muerte huirá de ellos.", "words": [[0, 43249], [2, 43336], [5, 43436], [14, 43636], [19, 44016], [28, 44536], [32, 44656], [40, 44936], [43, 45116], [51, 45456], [53, 45936], [56, 46096], [59, 46236], [69, 47153], [71, 47263], [80, 47803], [87, 48323], [89, 48483], [92, 48563], [99, 48863], [105, 49223], [108, 49343]]}, {"verse": 7, "start": 50349, "end": 60672, "text": "Y el aspecto de las langostas era semejante a caballos preparados para la guerra: y sobre sus cabezas tenían como coronas semejantes al oro; y sus caras como caras de hombres.", "words": [[0, 50349], [2, 50470], [5, 50570], [13, 51070], [16, 51150], [20, 51271], [30, 52010], [34, 52290], [44, 52930], [46, 53030], [55, 53451], [66, 53970], [71, 54171], [74, 54311], [82, 55122], [84, 55204], [90, 55384], [94, 55584], [102, 56104], [109, 56424], [114, 56724], [122, 57204], [133, 57764], [136, 57964], [141, 58588], [143, 58848], [147, 58988], [153, 59428], [158, 59608], [164, 60008], [167, 60108]]}, {"verse": 8, "start": 61122, "end": 66236, "text": "Y tenían cabellos como cabellos de mujeres: y sus dientes eran como dientes de leones.", "words": [[0, 61122], [2, 61233], [9, 61513], [18, 62093], [23, 62273], [32, 62753], [35, 62833], [44, 63826], [46, 63916], [50, 64036], [58, 64536], [63, 64776], [68, 65036], [76, 65476], [79, 65636]]}, {"verse": 9, "start": 66686, "end": 74623, "text": "Y tenían corazas como corazas de hierro; y el estruendo de sus alas, como el ruido de carros que con muchos caballos corren a la batalla.", "words": [[0, 66686], [2, 66786], [9, 67086], [17, 67686], [22, 67846], [30, 68366], [33, 68466], [41, 69266], [43, 69384], [46, 69484], [56, 70004], [59, 70164], [63, 70284], [69, 71004], [74, 71304], [77, 71464], [83, 71764], [86, 71864], [93, 72304], [97, 72444], [101, 72664], [108, 72904], [117, 73524], [124, 73904], [126, 73984], [129, 74064]]}, {"verse": 10, "start": 75073, "end": 83696, "text": "Y tenían colas semejantes a las de los escorpiones, y tenían en sus colas aguijones; y su poder era de hacer daño a los hombres cinco meses.", "words": [[0, 75073], [2, 75158], [9, 75438], [15, 75858], [26, 76458], [28, 76658], [32, 76758], [35, 76898], [39, 76998], [52, 77718], [54, 78258], [61, 78598], [64, 78758], [68, 78898], [74, 79298], [85, 80286], [87, 80416], [90, 80556], [96, 80996], [100, 81376], [103, 81556], [109, 81776], [114, 82176], [116, 82256], [120, 82356], [128, 82636], [134, 82996]]}, {"verse": 11, "start": 84146, "end": 90757, "text": "Y tienen sobre sí por rey al ángel del abismo, cuyo nombre en hebreo es Abaddon, y en griego, Apolión.", "words": [[0, 84146], [2, 84271], [9, 84531], [15, 84871], [18, 85171], [22, 85391], [26, 85711], [29, 85771], [35, 86111], [39, 86251], [47, 87031], [52, 87311], [59, 87651], [62, 87811], [69, 88331], [72, 88841], [81, 89351], [83, 89451], [86, 89591], [94, 90151]]}, {"verse": 12, "start": 91207, "end": 96646, "text": "El primer ¡Ay! es pasado: he aquí, vienen aún dos ayes después de estas cosas.", "words": [[0, 91235], [3, 91305], [10, 91760], [15, 92463], [18, 92605], [26, 93566], [29, 93646], [35, 93866], [42, 94366], [46, 94606], [50, 94846], [55, 95286], [63, 95606], [66, 95826], [72, 95986]]}, {"verse": 13, "start": 97096, "end": 103811, "text": "Y el sexto ángel tocó la trompeta; y oí una voz de los cuatro cuernos del altar de oro que estaba delante de Dios,", "words": [[0, 97096], [2, 97198], [5, 97298], [11, 97638], [17, 97838], [22, 98038], [25, 98238], [35, 99200], [37, 99341], [40, 99601], [44, 99861], [48, 100141], [51, 100301], [55, 100421], [62, 100761], [70, 101321], [74, 101481], [80, 101781], [83, 102001], [87, 102221], [91, 102401], [98, 102701], [106, 103141], [109, 103281]]}, {"verse": 14, "start": 104261, "end": 111810, "text": "Diciendo al sexto ángel que tenía la trompeta: Desata los cuatro ángeles que están atados en el gran río Éufrates.", "words": [[0, 104261], [9, 104603], [12, 104823], [18, 105203], [24, 105543], [28, 105683], [34, 105943], [37, 106083], [47, 107045], [54, 107480], [58, 107720], [65, 108120], [73, 108720], [77, 108960], [83, 109260], [90, 109840], [93, 110120], [96, 110240], [101, 110460], [105, 110860]]}, {"verse": 15, "start": 112358, "end": 120438, "text": "Y fueron desatados los cuatro ángeles que estaban preparados para la hora y día y mes y año, para matar la tercera parte de los hombres.", "words": [[0, 112358], [2, 112478], [9, 112718], [19, 113438], [23, 113638], [30, 113938], [38, 114478], [42, 114638], [50, 114958], [61, 115598], [66, 115838], [69, 115998], [74, 116218], [76, 116398], [80, 116678], [82, 116838], [86, 117058], [88, 117278], [93, 117598], [98, 118158], [104, 118458], [107, 118638], [115, 119018], [121, 119298], [124, 119518], [128, 119638]]}, {"verse": 16, "start": 120888, "end": 126646, "text": "Y el número del ejército de jinetes era doscientos millones. Y oí el número de ellos.", "words": [[0, 120888], [2, 120990], [5, 121090], [12, 121330], [16, 121570], [25, 122150], [28, 122270], [36, 122930], [40, 123250], [51, 123570], [61, 124927], [63, 125088], [66, 125348], [69, 125608], [76, 125888], [79, 126108]]}, {"verse": 17, "start": 127096, "end": 143369, "text": "Y así vi los caballos en visión, y los que sobre ellos estaban sentados, los cuales tenían corazas de fuego, de jacinto, y de azufre. Y las cabezas de los caballos eran como cabezas de leones; y de la boca de ellos salía fuego y humo y azufre.", "words": [[0, 127096], [2, 127204], [6, 127384], [9, 127584], [13, 127784], [22, 128284], [25, 128444], [33, 128944], [35, 129424], [39, 129564], [43, 129744], [49, 130004], [55, 130244], [63, 130664], [73, 131724], [77, 131824], [84, 132144], [91, 132544], [99, 133164], [102, 133304], [109, 134104], [112, 134144], [121, 134724], [123, 135104], [126, 135224], [134, 136139], [136, 136245], [140, 136385], [148, 136985], [151, 137085], [155, 137205], [164, 137865], [169, 138165], [174, 138485], [182, 139105], [185, 139225], [193, 140247], [195, 140357], [198, 140457], [201, 140557], [206, 140797], [209, 140997], [215, 141237], [221, 141697], [227, 141997], [229, 142337], [234, 142637], [236, 142757]]}, {"verse": 18, "start": 143819, "end": 151710, "text": "De estas tres plagas fue muerta la tercera parte de los hombres: del fuego, y del humo, y del azufre, que salían de la boca de ellos.", "words": [[0, 143819], [3, 143962], [9, 144142], [14, 144442], [21, 144962], [25, 145102], [32, 145542], [35, 145662], [43, 146102], [49, 146402], [52, 146662], [56, 146782], [65, 147750], [69, 147917], [76, 148277], [78, 148517], [82, 148657], [88, 148977], [90, 149057], [94, 149197], [102, 149757], [106, 150037], [113, 150497], [116, 150637], [119, 150717], [124, 150957], [127, 151177]]}, {"verse": 19, "start": 152160, "end": 159529, "text": "Porque su poder está en su boca y en sus colas: porque sus colas eran semejantes a serpientes, y tenían cabezas, y con ellas dañan.", "words": [[0, 152160], [7, 152340], [10, 152480], [16, 152780], [21, 153040], [24, 153160], [27, 153300], [32, 153600], [34, 153740], [37, 153820], [41, 153960], [48, 154900], [55, 155055], [59, 155235], [65, 155635], [70, 155775], [81, 156435], [83, 156555], [95, 157175], [97, 157495], [104, 157755], [113, 158415], [115, 158575], [119, 158755], [125, 158935]]}, {"verse": 20, "start": 159979, "end": 177832, "text": "Y los otros hombres que no fueron muertos con estas plagas, aun no se arrepintieron de las obras de sus manos, para que no adorasen a los demonios, y a las imágenes de oro, y de plata, y de bronce, y de piedra, y de madera; las cuales no pueden ver, ni oír, ni andar:", "words": [[0, 159979], [2, 160067], [6, 160247], [12, 160487], [20, 160927], [24, 161167], [27, 161307], [34, 161687], [42, 162067], [46, 162347], [52, 162587], [60, 163607], [64, 163987], [67, 164287], [70, 164447], [84, 165087], [87, 165227], [91, 165387], [97, 165607], [100, 165807], [104, 165967], [111, 166347], [116, 166967], [120, 167107], [123, 167447], [132, 167787], [134, 167867], [138, 167967], [148, 168956], [150, 169059], [152, 169119], [156, 169259], [165, 169759], [168, 169979], [173, 170219], [175, 170919], [178, 171039], [185, 171479], [187, 172039], [190, 172159], [198, 172719], [200, 172939], [203, 173039], [211, 173519], [213, 173679], [216, 173779], [224, 174642], [228, 174946], [235, 175206], [238, 175486], [245, 175806], [250, 176546], [253, 176646], [258, 177226], [261, 177346]]}, {"verse": 21, "start": 178282, "end": 185596, "text": "Y no se arrepintieron de sus homicidios, ni de sus hechicerías, ni de su inmoralidad sexual, ni de sus hurtos.", "words": [[0, 178282], [2, 178404], [5, 178524], [8, 178704], [22, 179384], [25, 179544], [29, 179704], [41, 180704], [44, 181064], [47, 181184], [51, 181364], [64, 182524], [67, 182724], [70, 182844], [73, 183024], [85, 183624], [93, 184524], [96, 184684], [99, 184784], [103, 185219]]}]}