{"book": "ISA", "chapter": 45, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 274175, "verses": [{"verse": 1, "start": 300, "end": 16234, "text": "Así dice Jehová a su ungido, a Ciro, al cual tomé yo por su mano derecha, para sujetar naciones delante de él y desatar lomos de reyes; para abrir delante de él puertas, y las puertas no se cerrarán:", "words": [[0, 300], [4, 561], [9, 861], [16, 1481], [18, 1641], [21, 1821], [29, 2801], [31, 2941], [37, 3661], [40, 3801], [45, 3981], [50, 4401], [53, 4601], [57, 4801], [60, 5001], [65, 5221], [74, 5761], [79, 6001], [87, 6601], [96, 7161], [104, 7621], [107, 7841], [110, 8021], [112, 8461], [120, 9061], [126, 9801], [129, 10001], [136, 11050], [141, 11259], [147, 11719], [155, 12339], [158, 12519], [161, 12679], [170, 13259], [172, 13979], [176, 14119], [184, 14599], [187, 15159], [190, 15359]]}, {"verse": 2, "start": 16484, "end": 24895, "text": "Yo iré delante de ti, y enderezaré las tortuosidades; quebrantaré puertas de bronce, y cerrojos de hierro haré pedazos;", "words": [[0, 16484], [3, 16704], [7, 16984], [15, 17384], [18, 17544], [22, 17784], [24, 18144], [35, 18724], [39, 18884], [54, 20597], [66, 21155], [74, 21555], [77, 21735], [85, 22255], [87, 22695], [96, 23235], [99, 23375], [106, 23835], [111, 24135]]}, {"verse": 3, "start": 25581, "end": 34878, "text": "Y te daré los tesoros escondidos, y los secretos muy guardados; para que sepas que yo soy Jehová, el Dios de Israel, que te pongo nombre.", "words": [[0, 25581], [2, 25890], [5, 26010], [10, 26290], [14, 26410], [22, 26930], [34, 27710], [36, 27930], [40, 28050], [49, 28650], [53, 28830], [64, 30194], [69, 30338], [73, 30518], [79, 30918], [83, 31078], [86, 31258], [90, 31498], [98, 32518], [101, 32558], [106, 32818], [109, 32998], [117, 33418], [121, 33798], [124, 33958], [130, 34278]]}, {"verse": 4, "start": 35559, "end": 43829, "text": "Por amor de mi siervo Jacob, y de Israel mi escogido, te llamé por tu nombre; te puse sobrenombre, aunque no me conociste.", "words": [[0, 35559], [4, 35678], [9, 35878], [12, 36058], [15, 36158], [22, 36558], [29, 36878], [31, 37438], [34, 37538], [41, 37938], [44, 38138], [54, 38718], [57, 39098], [63, 39358], [67, 39558], [70, 39698], [78, 41037], [81, 41139], [86, 41419], [99, 42339], [106, 42559], [109, 42799], [112, 42939]]}, {"verse": 5, "start": 44513, "end": 51784, "text": "Yo Jehová, y ninguno más hay: no hay Dios fuera de mí. Yo te ceñiré, aunque tú no me conociste;", "words": [[0, 44513], [3, 44760], [11, 45400], [13, 45520], [21, 45920], [25, 46160], [30, 47082], [33, 47242], [37, 47462], [42, 47742], [48, 48122], [51, 48382], [55, 49230], [58, 49354], [61, 49704], [69, 50054], [76, 50294], [79, 50634], [82, 50834], [85, 50954]]}, {"verse": 6, "start": 52489, "end": 61054, "text": "Para que se sepa desde el nacimiento del sol, y desde donde se pone, que no hay más que yo; yo Jehová, y ninguno más que yo:", "words": [[0, 52489], [5, 52648], [9, 52808], [12, 52928], [17, 53368], [23, 53608], [26, 53848], [37, 54448], [41, 54648], [46, 55028], [48, 55628], [54, 55828], [60, 56088], [63, 56328], [69, 56668], [73, 57168], [76, 57348], [80, 57468], [84, 57688], [88, 57828], [92, 58723], [95, 58924], [103, 59704], [105, 59904], [113, 60304], [117, 60544], [121, 60704]]}, {"verse": 7, "start": 61734, "end": 69054, "text": "Que formo la luz y crío las tinieblas, que hago la paz y crío el mal. Yo Jehová que hago todo esto.", "words": [[0, 61734], [4, 61818], [10, 62318], [13, 62418], [17, 62718], [19, 62978], [24, 63338], [28, 63518], [39, 64498], [43, 64758], [48, 64958], [51, 65118], [55, 65438], [57, 65798], [62, 66118], [65, 66238], [70, 67268], [73, 67554], [80, 67874], [84, 68034], [89, 68214], [94, 68434]]}, {"verse": 8, "start": 69731, "end": 82740, "text": "Rociad, cielos, de arriba, y las nubes destilen la justicia; ábrase la tierra, y prodúzcanse la salvación y la justicia; háganse brotar juntamente. Yo Jehová lo creé.", "words": [[0, 69731], [8, 70171], [16, 70771], [19, 70951], [27, 71291], [29, 71851], [33, 72011], [39, 72471], [48, 72971], [51, 73131], [61, 74486], [68, 74967], [71, 75107], [79, 75547], [81, 75807], [93, 76587], [96, 76687], [106, 77387], [108, 77587], [111, 77687], [121, 79052], [129, 79491], [136, 79951], [148, 81409], [151, 81750], [158, 82130], [161, 82230]]}, {"verse": 9, "start": 83438, "end": 95171, "text": "¡Ay del que pleitea con su Hacedor! ¡el tiesto con los tiestos de la tierra! ¿Dirá el barro al que lo labra: Qué haces; o tu obra: No tiene manos?", "words": [[0, 83556], [4, 83706], [8, 83886], [12, 84046], [20, 84626], [24, 84766], [27, 85156], [36, 86130], [40, 86268], [47, 86788], [51, 86948], [55, 87068], [63, 87588], [66, 87688], [69, 87768], [77, 88985], [83, 89314], [86, 89454], [92, 89954], [95, 90154], [99, 90294], [102, 90414], [109, 91487], [113, 91604], [120, 92867], [122, 92988], [125, 93128], [131, 94168], [134, 94271], [140, 94511]]}, {"verse": 10, "start": 95846, "end": 101991, "text": "¡Ay del que dice al padre: ¿Por qué engendraste? y a la mujer: ¿Por qué pariste?", "words": [[0, 95946], [4, 96086], [8, 96246], [12, 96426], [17, 96686], [20, 96846], [27, 97914], [32, 98044], [36, 98264], [49, 99652], [51, 99776], [53, 99836], [56, 99896], [63, 101063], [68, 101191], [72, 101331]]}, {"verse": 11, "start": 102587, "end": 113914, "text": "Así dice Jehová, el Santo de Israel, y su Formador: Preguntadme de las cosas por venir; mandadme acerca de mis hijos, y acerca de la obra de mis manos.", "words": [[0, 102587], [4, 102857], [9, 103177], [17, 103797], [20, 103977], [26, 104317], [29, 104597], [37, 105157], [39, 105877], [42, 106017], [52, 107010], [64, 107772], [67, 107912], [71, 108072], [77, 108372], [81, 108672], [88, 109714], [97, 110354], [104, 110694], [107, 110934], [111, 111094], [118, 111474], [120, 111974], [127, 112374], [130, 112634], [133, 112754], [138, 112994], [141, 113174], [145, 113294]]}, {"verse": 12, "start": 114631, "end": 123069, "text": "Yo hice la tierra, y creé sobre ella al hombre. Yo, mis manos, extendieron los cielos, y a todo su ejército mandé.", "words": [[0, 114631], [3, 114910], [8, 115150], [11, 115330], [19, 115730], [21, 116190], [26, 116590], [32, 116810], [37, 117090], [40, 117310], [48, 118297], [52, 118459], [56, 118599], [63, 119039], [75, 120179], [79, 120359], [87, 121259], [89, 121419], [91, 121499], [96, 121719], [99, 121959], [108, 122479]]}, {"verse": 13, "start": 123775, "end": 136546, "text": "Yo lo desperté en justicia, y enderezaré todos sus caminos; él edificará mi ciudad, y soltará mis cautivos, no por precio ni por dones, dice Jehová de los ejércitos.", "words": [[0, 123775], [3, 123899], [6, 124019], [15, 124619], [18, 124679], [28, 125399], [30, 125819], [41, 126519], [47, 126799], [51, 127099], [60, 128372], [63, 128574], [73, 129374], [76, 129534], [84, 129914], [86, 130554], [94, 131114], [98, 131194], [108, 132074], [111, 132274], [115, 132514], [122, 132894], [125, 133114], [129, 133354], [136, 134527], [141, 134816], [148, 135316], [151, 135396], [155, 135516]]}, {"verse": 14, "start": 136846, "end": 159430, "text": "Así dice Jehová: El trabajo de Egipto, las mercaderías de Etiopía, y los sabeos hombres agigantados, se pasarán a ti, y serán tuyos; irán en pos de ti, pasarán con grillos: a ti harán reverencia, y a ti suplicarán, diciendo: Cierto, en ti está Dios, y no hay otro fuera de Dios.", "words": [[0, 136846], [4, 137199], [9, 137519], [17, 138830], [20, 138930], [28, 139290], [31, 139570], [39, 140430], [43, 140530], [55, 141290], [58, 141470], [67, 142150], [69, 142470], [73, 142610], [80, 143150], [88, 143530], [101, 144710], [104, 144930], [112, 145430], [114, 145510], [118, 145690], [120, 146030], [126, 146330], [133, 147624], [138, 148104], [141, 148244], [145, 148464], [148, 148644], [152, 149224], [160, 149744], [164, 149884], [173, 151174], [175, 151302], [178, 151522], [184, 151842], [196, 152562], [198, 153002], [200, 153062], [203, 153242], [215, 154062], [225, 155493], [233, 156300], [236, 156400], [239, 156660], [244, 156960], [250, 157240], [252, 157740], [255, 157920], [259, 158140], [264, 158400], [270, 158700], [273, 158920]]}, {"verse": 15, "start": 160032, "end": 164919, "text": "Verdaderamente tú eres Dios que te encubres, Dios de Israel, que salvas.", "words": [[0, 160032], [15, 160854], [18, 161134], [23, 161294], [28, 161554], [32, 161754], [35, 161914], [45, 162894], [50, 163034], [53, 163194], [61, 164054], [65, 164194]]}, {"verse": 16, "start": 165369, "end": 173671, "text": "Confusos y avergonzados serán todos ellos; irán con afrenta todos los fabricadores de imágenes.", "words": [[0, 165369], [9, 166319], [11, 166519], [24, 167399], [30, 168099], [36, 168299], [43, 169376], [48, 169705], [52, 170065], [60, 170425], [66, 170685], [70, 171025], [83, 171725], [86, 171925]]}, {"verse": 17, "start": 174121, "end": 181935, "text": "Israel es salvo en Jehová con salvación eterna; no os avergonzaréis, ni os afrentaréis, por todos los siglos.", "words": [[0, 174121], [7, 174121], [10, 174515], [16, 174935], [19, 175095], [26, 175635], [30, 175815], [40, 176475], [48, 177571], [51, 177799], [54, 178039], [69, 179019], [72, 179259], [75, 179459], [88, 180339], [92, 180699], [98, 180959], [102, 181219]]}, {"verse": 18, "start": 182385, "end": 197494, "text": "Porque así dijo Jehová, que creó los cielos; él es Dios, el que formó la tierra, el que la hizo y la compuso; no la creó en vano, para que fuese habitada la creó: Yo Jehová, y ninguno más que yo.", "words": [[0, 182385], [7, 182569], [11, 182869], [16, 183249], [24, 183769], [28, 183909], [33, 184249], [37, 184409], [45, 185520], [48, 185658], [51, 185798], [57, 186518], [60, 186818], [64, 186958], [70, 187438], [73, 187558], [81, 188398], [84, 188538], [88, 188678], [91, 188818], [96, 189138], [98, 189498], [101, 189598], [110, 190775], [113, 191003], [116, 191163], [121, 191563], [124, 191763], [130, 192463], [135, 192803], [139, 192983], [145, 193403], [154, 194023], [157, 194203], [163, 195098], [166, 195554], [174, 196044], [176, 196244], [184, 196724], [188, 196924], [192, 197104]]}, {"verse": 19, "start": 198168, "end": 210355, "text": "No hablé en escondido, en lugar de tierra de tinieblas; no dije a la descendencia de Jacob: En vano me buscáis. Yo soy Jehová que hablo justicia, que anuncio rectitud.", "words": [[0, 198168], [3, 198312], [9, 198752], [12, 198832], [23, 199692], [26, 199932], [32, 200172], [35, 200452], [42, 200792], [45, 200992], [56, 202315], [59, 202438], [64, 202678], [66, 202838], [69, 202898], [82, 203618], [85, 203758], [92, 204914], [95, 205059], [100, 205379], [103, 205479], [112, 206765], [115, 206895], [119, 207255], [126, 207615], [130, 207675], [136, 207955], [146, 208995], [150, 209215], [158, 209635]]}, {"verse": 20, "start": 211034, "end": 222722, "text": "Reuníos, y venid; acercaos, todos los que escaparon de entre las naciones: no saben aquellos que erigen el madero de su escultura, y los que ruegan al dios que no salva.", "words": [[0, 211034], [9, 211716], [11, 211896], [18, 212865], [28, 213985], [34, 214165], [38, 214425], [42, 214565], [52, 215185], [55, 215305], [61, 215525], [65, 215725], [75, 216949], [78, 217112], [84, 217512], [93, 217912], [97, 218272], [104, 218592], [107, 218772], [114, 219152], [117, 219272], [120, 219412], [131, 219972], [133, 220592], [137, 220752], [141, 221042], [148, 221332], [151, 221452], [156, 221692], [160, 221972], [163, 222112]]}, {"verse": 21, "start": 223404, "end": 238787, "text": "Publicad, y haced llegar, y entren todos en consulta: ¿quién hizo oír esto desde el principio, y lo tiene dicho desde entonces, sino yo Jehová? Y no hay más Dios que yo; Dios justo y Salvador: ningún otro fuera de mí.", "words": [[0, 223404], [10, 224023], [12, 224223], [18, 224523], [26, 224923], [28, 225383], [35, 225643], [41, 226023], [44, 226303], [54, 227588], [61, 227855], [66, 228095], [70, 228375], [75, 228675], [81, 228895], [84, 229075], [95, 229975], [97, 230035], [100, 230225], [106, 230415], [112, 230675], [118, 230915], [128, 231755], [133, 231995], [136, 232405], [144, 233338], [146, 233459], [149, 233599], [153, 233739], [157, 233939], [162, 234179], [166, 234419], [170, 235355], [175, 235582], [181, 235982], [183, 236182], [193, 237420], [200, 237797], [205, 237997], [211, 238277], [214, 238497]]}, {"verse": 22, "start": 239479, "end": 246114, "text": "Mirad a mí, y sed salvos, todos los términos de la tierra: porque yo soy Dios, y no hay más.", "words": [[0, 239479], [6, 239826], [8, 239926], [12, 240126], [14, 240406], [18, 240686], [26, 241386], [32, 241796], [36, 242206], [45, 242726], [48, 242826], [51, 242906], [59, 244020], [66, 244204], [69, 244404], [73, 244624], [79, 244944], [81, 245324], [84, 245484], [88, 245644]]}, {"verse": 23, "start": 246817, "end": 256195, "text": "Por mí hice juramento, de mi boca salió palabra en justicia, y no será revocada: Que a mí se doblará toda rodilla, jurará toda lengua.", "words": [[0, 246817], [4, 246956], [7, 247176], [12, 247556], [23, 248576], [26, 248876], [29, 248976], [34, 249256], [40, 249656], [48, 249996], [51, 250196], [61, 250996], [63, 251236], [66, 251396], [71, 251916], [81, 252965], [85, 253065], [87, 253165], [90, 253325], [93, 253505], [101, 253985], [106, 254105], [115, 254965], [122, 255345], [127, 255565]]}, {"verse": 24, "start": 256872, "end": 267967, "text": "Y se dirá de mí: Ciertamente en Jehová está la justicia y la fuerza: a él vendrán, y todos los que contra él se enardecen, serán avergonzados.", "words": [[0, 256872], [2, 256974], [5, 257094], [10, 257374], [13, 257474], [17, 258344], [29, 259211], [32, 259371], [39, 259831], [44, 260171], [47, 260331], [56, 261091], [58, 261351], [61, 261471], [69, 262688], [71, 262827], [74, 263027], [83, 263567], [85, 264087], [91, 264367], [95, 264687], [99, 264867], [106, 265207], [109, 265467], [112, 265647], [123, 266327], [129, 266967]]}, {"verse": 25, "start": 268563, "end": 273775, "text": "En Jehová será justificada y se gloriará toda la descendencia de Israel.", "words": [[0, 268563], [3, 268748], [10, 269248], [15, 269408], [27, 270428], [29, 270628], [32, 270768], [41, 271408], [46, 271688], [49, 271948], [62, 272868], [65, 273008]]}]}