{"book": "MAT", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 207739, "verses": [{"verse": 1, "start": 300, "end": 5690, "text": "Libro de la genealogía de Jesucristo, hijo de David, hijo de Abraham.", "words": [[0, 300], [6, 801], [9, 901], [12, 1041], [23, 1821], [26, 1941], [38, 3261], [43, 3561], [46, 3721], [53, 4481], [58, 4761], [61, 4921]]}, {"verse": 2, "start": 6040, "end": 13862, "text": "Abraham engendró a Isaac: e Isaac engendró a Jacob: y Jacob engendró a Judas y a sus hermanos:", "words": [[0, 6040], [8, 6460], [17, 7280], [19, 7400], [26, 8535], [28, 8841], [34, 9148], [43, 9728], [45, 10182], [52, 10781], [54, 10981], [60, 11281], [69, 12121], [71, 12261], [77, 12481], [79, 12841], [81, 12961], [85, 13081]]}, {"verse": 3, "start": 14212, "end": 22734, "text": "Y Judas engendró de Tamar a Fares y a Zara: y Fares engendró a Esrom: y Esrom engendró a Aram:", "words": [[0, 14212], [2, 14357], [8, 14677], [17, 15577], [20, 15697], [26, 15990], [28, 16284], [34, 16577], [36, 16858], [38, 17138], [44, 17584], [46, 17879], [52, 18395], [61, 18911], [63, 19427], [70, 20112], [72, 20511], [78, 20911], [87, 21771], [89, 21971]]}, {"verse": 4, "start": 23084, "end": 31106, "text": "Y Aram engendró a Aminadab: y Aminadab engendró a Naassón: y Naassón engendró a Salmón:", "words": [[0, 23281], [2, 23501], [7, 23721], [16, 24701], [18, 25311], [28, 26141], [30, 26234], [39, 26328], [48, 26421], [50, 27501], [59, 28801], [61, 29145], [69, 29525], [78, 30205], [80, 30425]]}, {"verse": 5, "start": 31456, "end": 39493, "text": "Y Salmón engendró de Rahab a Booz, y Booz engendró de Ruth a Obed: y Obed engendró a Isaí:", "words": [[0, 31456], [2, 31579], [9, 32099], [18, 32759], [21, 32919], [27, 33539], [29, 34089], [35, 34639], [37, 34829], [42, 35019], [51, 35839], [54, 35979], [59, 36279], [61, 36599], [67, 37615], [69, 37965], [74, 38315], [83, 38665], [85, 38925]]}, {"verse": 6, "start": 39843, "end": 46954, "text": "Y Isaí engendró al rey David: y el rey David engendró a Salomón de la que fue mujer de Urías:", "words": [[0, 39843], [2, 40049], [7, 40569], [16, 41469], [19, 41749], [23, 42129], [30, 42866], [32, 43028], [35, 43168], [39, 43468], [45, 43728], [54, 44528], [56, 44708], [64, 45148], [67, 45408], [70, 45508], [74, 45628], [78, 45808], [84, 46168], [87, 46368]]}, {"verse": 7, "start": 47304, "end": 54991, "text": "Y Salomón engendró a Roboam: y Roboam engendró a Abía: y Abía engendró a Asa:", "words": [[0, 47304], [2, 47446], [10, 47933], [19, 48419], [21, 48906], [29, 49950], [31, 50170], [38, 50900], [47, 51630], [49, 52088], [55, 52721], [57, 53115], [62, 53529], [71, 53942], [73, 54342]]}, {"verse": 8, "start": 55341, "end": 62872, "text": "Y Asa engendró a Josafat: y Josafat engendró a Joram: y Joram engendró a Uzías:", "words": [[0, 55616], [2, 55931], [6, 56246], [15, 56561], [17, 57078], [26, 57736], [28, 58147], [36, 58587], [45, 59287], [47, 59756], [54, 60377], [56, 60518], [62, 60918], [71, 61658], [73, 62291]]}, {"verse": 9, "start": 63222, "end": 71303, "text": "Y Uzías engendró a Jotam: y Jotam engendró a Acaz: y Acaz engendró a Ezequías:", "words": [[0, 63222], [2, 63735], [8, 64281], [17, 64828], [19, 65068], [26, 65983], [28, 66278], [34, 66908], [43, 67538], [45, 68054], [51, 69140], [53, 69589], [58, 70037], [67, 70485], [69, 70934]]}, {"verse": 10, "start": 71653, "end": 78944, "text": "Y Ezequías engendró a Manasés: y Manasés engendró a Amón: y Amón engendró a Josías:", "words": [[0, 71653], [2, 72137], [11, 72657], [20, 73237], [22, 73357], [31, 74327], [33, 74688], [41, 75088], [50, 75398], [52, 75708], [58, 76679], [60, 76905], [65, 77132], [74, 78032], [76, 78192]]}, {"verse": 11, "start": 79294, "end": 85843, "text": "Y Josías engendró a Jeconías y a sus hermanos, en la deportación de Babilonia.", "words": [[0, 79294], [2, 79583], [9, 80163], [18, 80883], [20, 81123], [29, 81843], [31, 82163], [33, 82263], [37, 82403], [47, 83363], [50, 83583], [53, 83723], [65, 84803], [68, 85003]]}, {"verse": 12, "start": 86193, "end": 93738, "text": "Y después de la deportación de Babilonia, Jeconías engendró a Salatiel: y Salatiel engendró a Zorobabel:", "words": [[0, 86193], [2, 86311], [10, 86571], [13, 86811], [16, 86911], [28, 87611], [31, 87771], [42, 88681], [51, 89591], [60, 90191], [62, 90351], [72, 91326], [74, 91433], [83, 92033], [92, 92793], [94, 93295]]}, {"verse": 13, "start": 94088, "end": 101589, "text": "Y Zorobabel engendró a Abiud: y Abiud engendró a Eliaquim: y Eliaquim engendró a Azor:", "words": [[0, 94088], [2, 94516], [12, 94976], [21, 95436], [23, 95781], [30, 96539], [32, 96733], [38, 96926], [47, 97666], [49, 98283], [59, 99081], [61, 99555], [70, 100035], [79, 100875], [81, 101254]]}, {"verse": 14, "start": 101939, "end": 108379, "text": "Y Azor engendró a Sadoc: y Sadoc engendró a Aquim: y Aquim engendró a Eliud:", "words": [[0, 101939], [2, 102087], [7, 102467], [16, 103047], [18, 103467], [25, 104043], [27, 104269], [33, 104529], [42, 105189], [44, 105600], [51, 106386], [53, 106632], [59, 106879], [68, 107579], [70, 107879]]}, {"verse": 15, "start": 108729, "end": 115953, "text": "Y Eliud engendró a Eleazar: y Eleazar engendró a Matán: y Matán engendró a Jacob:", "words": [[0, 108729], [2, 109151], [8, 109611], [17, 110071], [19, 110605], [28, 111359], [30, 111899], [38, 112439], [47, 112979], [49, 113179], [56, 114034], [58, 114137], [64, 114707], [73, 115277], [75, 115377]]}, {"verse": 16, "start": 116303, "end": 123229, "text": "Y Jacob engendró a José, marido de María, de la cual nació Jesús, el cual es llamado el Cristo.", "words": [[0, 116303], [2, 116428], [8, 116768], [17, 117568], [19, 117668], [25, 118448], [32, 118928], [35, 119068], [42, 119988], [45, 120068], [48, 120188], [53, 120388], [59, 120848], [66, 121748], [69, 121848], [74, 122068], [77, 122248], [85, 122575], [88, 122902]]}, {"verse": 17, "start": 123579, "end": 139625, "text": "De manera que todas las generaciones desde Abraham hasta David son catorce generaciones: y desde David hasta la deportación de Babilonia, catorce generaciones: y desde la deportación de Babilonia hasta Cristo, catorce generaciones.", "words": [[0, 123579], [3, 124223], [10, 124443], [14, 124763], [20, 125023], [24, 125323], [37, 126063], [43, 126343], [51, 126763], [57, 127303], [63, 127683], [67, 128203], [75, 128923], [89, 130340], [91, 130482], [97, 130722], [103, 131142], [109, 131582], [112, 131762], [124, 132462], [127, 132622], [138, 133179], [146, 133737], [160, 135356], [162, 135461], [168, 135641], [171, 135821], [183, 136421], [186, 136561], [196, 137061], [202, 137281], [210, 137759], [218, 138236]]}, {"verse": 18, "start": 139975, "end": 151013, "text": "Y el nacimiento de Jesucristo fue así: Que siendo María su madre desposada con José, antes que se juntasen, se halló que había concebido del Espíritu Santo.", "words": [[0, 139975], [2, 140103], [5, 140223], [16, 140963], [19, 141163], [30, 141963], [34, 142183], [39, 142850], [43, 142956], [50, 143296], [56, 143656], [59, 143956], [65, 144356], [75, 145356], [79, 145596], [85, 146656], [91, 146856], [95, 147056], [98, 147196], [108, 148151], [111, 148371], [117, 148691], [121, 148831], [127, 149031], [137, 149711], [141, 149891], [150, 150411]]}, {"verse": 19, "start": 151363, "end": 158819, "text": "Y José su marido, como era justo, y no quisiese avergonzarla públicamente, quiso dejarla secretamente.", "words": [[0, 151363], [2, 151527], [7, 151747], [10, 152007], [18, 152827], [23, 153027], [27, 153227], [34, 154227], [36, 154327], [39, 154427], [48, 154907], [61, 155787], [75, 156907], [81, 157167], [89, 157767]]}, {"verse": 20, "start": 159169, "end": 171968, "text": "Y pensando él en esto, he aquí el ángel del Señor se le apareció en sueños, diciendo: José, hijo de David, no temas de recibir a María tu mujer, porque lo que en ella es engendrado, del Espíritu Santo es.", "words": [[0, 159169], [2, 159276], [11, 159636], [14, 159996], [17, 160136], [23, 160636], [26, 160716], [31, 161036], [34, 161256], [40, 161676], [44, 161856], [50, 162216], [53, 162536], [56, 162696], [65, 163316], [68, 163456], [76, 164296], [86, 165327], [92, 165614], [97, 165834], [100, 165954], [107, 166574], [110, 166694], [116, 167014], [119, 167214], [127, 167594], [129, 167754], [135, 167994], [138, 168194], [145, 168774], [152, 168954], [155, 169134], [159, 169274], [162, 169394], [167, 169534], [170, 169714], [182, 170334], [186, 170634], [195, 171174], [201, 171434]]}, {"verse": 21, "start": 172318, "end": 177896, "text": "Y dará a luz un hijo, y llamarás su nombre JESÚS, porque él salvará a su pueblo de sus pecados.", "words": [[0, 172318], [2, 172435], [7, 172755], [9, 172855], [13, 173135], [16, 173235], [22, 173475], [24, 173767], [33, 174060], [36, 174260], [43, 174540], [50, 175360], [57, 175700], [60, 175880], [68, 176400], [70, 176480], [73, 176580], [80, 176900], [83, 177060], [87, 177220]]}, {"verse": 22, "start": 178176, "end": 184394, "text": "Todo esto aconteció para que se cumpliese lo que fue dicho por el Señor, por el profeta que dijo:", "words": [[0, 178176], [5, 178340], [10, 178700], [20, 179440], [25, 179660], [29, 179820], [32, 179980], [42, 180560], [45, 180740], [49, 180860], [53, 181040], [59, 181340], [63, 181620], [66, 181740], [73, 182780], [77, 182960], [80, 183100], [88, 183760], [92, 183900]]}, {"verse": 23, "start": 184744, "end": 194434, "text": "He aquí la virgen concebirá y parirá un hijo, y llamarás su nombre Emanuel, que traducido significa: Dios con nosotros.", "words": [[0, 184744], [3, 184889], [8, 185169], [11, 185309], [18, 185689], [28, 186449], [30, 186529], [37, 186969], [40, 187089], [46, 188009], [48, 188089], [57, 188569], [60, 188769], [67, 189129], [76, 190369], [80, 190649], [90, 191329], [101, 192129], [106, 192989], [110, 193489]]}, {"verse": 24, "start": 194784, "end": 201737, "text": "Y despertando José del sueño, hizo como el ángel del Señor le había mandado, y recibió a su mujer.", "words": [[0, 194784], [2, 194880], [14, 195560], [19, 195920], [23, 196180], [30, 197240], [35, 197620], [40, 197920], [43, 198080], [49, 198460], [53, 198580], [59, 198940], [62, 199220], [68, 199440], [77, 200040], [79, 200280], [87, 200940], [89, 201020], [92, 201160]]}, {"verse": 25, "start": 202087, "end": 207339, "text": "Y no la conoció hasta que parió a su hijo primogénito: y llamó su nombre JESÚS.", "words": [[0, 202087], [2, 202213], [5, 202393], [8, 202533], [16, 203133], [22, 203453], [26, 203633], [32, 204013], [34, 204173], [37, 204313], [42, 204553], [55, 205763], [57, 205869], [63, 206189], [66, 206309], [73, 206629]]}]}