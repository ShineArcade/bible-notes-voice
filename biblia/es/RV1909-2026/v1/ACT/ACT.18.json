{"book": "ACT", "chapter": 18, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 254648, "verses": [{"verse": 1, "start": 300, "end": 4510, "text": "Pasadas estas cosas, Pablo salió de Atenas, y vino a Corinto.", "words": [[0, 300], [8, 708], [14, 948], [21, 1288], [27, 1768], [33, 2188], [36, 2328], [44, 2868], [46, 3288], [51, 3548], [53, 3748]]}, {"verse": 2, "start": 4510, "end": 19349, "text": "Y hallando a un judío llamado Aquila, natural del Ponto, que hacía poco que había venido de Italia, y a Priscila su mujer, (porque Claudio había mandado que todos los judíos saliesen de Roma) se vino a ellos;", "words": [[0, 4510], [2, 4770], [11, 5250], [13, 5490], [16, 5670], [22, 6150], [30, 6410], [38, 7410], [46, 7870], [50, 8130], [57, 9090], [61, 9170], [67, 9430], [72, 9870], [76, 10170], [82, 10370], [89, 10790], [92, 10970], [100, 11970], [102, 12370], [104, 12770], [113, 13170], [116, 13410], [123, 14187], [131, 14587], [139, 15027], [145, 15227], [153, 15807], [157, 15967], [163, 16247], [167, 16487], [174, 16967], [183, 17407], [186, 17647], [192, 18179], [195, 18322], [200, 18542], [202, 18722]]}, {"verse": 3, "start": 19699, "end": 27899, "text": "Y porque era del mismo oficio, se alojó con ellos, y trabajaba; porque el oficio de ellos era hacer tiendas.", "words": [[0, 19699], [2, 19784], [9, 20024], [13, 20384], [17, 20564], [23, 20924], [31, 21984], [34, 22224], [40, 22744], [44, 22964], [51, 23204], [53, 23564], [64, 24644], [71, 24890], [74, 25110], [81, 25550], [84, 25810], [90, 26070], [94, 26330], [100, 27143]]}, {"verse": 4, "start": 28249, "end": 33783, "text": "Y disputaba en la sinagoga todos los sábados, y persuadía a judíos y a griegos.", "words": [[0, 28249], [2, 28374], [12, 28914], [15, 29054], [18, 29154], [27, 29734], [33, 29974], [37, 30314], [46, 30974], [48, 31334], [58, 32094], [60, 32314], [67, 32874], [69, 33014], [71, 33154]]}, {"verse": 5, "start": 34133, "end": 43815, "text": "Y cuando Silas y Timoteo vinieron de Macedonia, Pablo se dedicaba por completo a la palabra, testificando a los judíos que Jesús era el Cristo.", "words": [[0, 34133], [2, 34210], [9, 34585], [15, 34960], [17, 35335], [25, 35710], [34, 36130], [37, 36290], [48, 37290], [54, 37910], [57, 38150], [66, 38770], [70, 39010], [79, 39610], [81, 39810], [84, 39890], [93, 40710], [106, 41470], [108, 41590], [112, 41710], [119, 42190], [123, 42310], [129, 42610], [133, 43030], [136, 43190]]}, {"verse": 6, "start": 44165, "end": 55784, "text": "Pero contradiciendo y blasfemando ellos, les dijo, sacudiendo sus vestidos: Vuestra sangre sea sobre vuestra cabeza; yo, limpio; desde ahora me iré a los Gentiles.", "words": [[0, 44165], [5, 44348], [20, 45408], [22, 45548], [34, 46368], [41, 47288], [45, 47568], [51, 48348], [62, 49088], [66, 49288], [76, 50275], [84, 50635], [91, 50975], [95, 51315], [101, 51595], [109, 51975], [117, 52775], [121, 53020], [129, 53946], [135, 54094], [141, 54454], [144, 54694], [148, 54954], [150, 55014], [154, 55134]]}, {"verse": 7, "start": 56064, "end": 64992, "text": "Y partiendo de allí, entró en casa de uno llamado Justo, temeroso de Dios, la casa del cual estaba junto a la sinagoga.", "words": [[0, 56064], [2, 56187], [12, 56767], [15, 56967], [21, 57767], [27, 58347], [30, 58467], [35, 58747], [38, 59027], [42, 59207], [50, 59527], [57, 60807], [66, 61307], [69, 61507], [75, 62207], [78, 62287], [83, 62567], [87, 62787], [92, 63027], [99, 63407], [105, 63767], [107, 63987], [110, 64067]]}, {"verse": 8, "start": 65342, "end": 75590, "text": "Y Crispo, el dirigente de la sinagoga, creyó al Señor con toda su casa: y muchos de los Corintios oyendo creían, y eran bautizados.", "words": [[0, 65342], [2, 65502], [10, 66322], [13, 66682], [23, 67322], [26, 67462], [29, 67602], [39, 68662], [45, 69102], [48, 69382], [54, 69722], [58, 70062], [63, 70382], [66, 70642], [72, 71461], [74, 71641], [81, 71961], [84, 72181], [88, 72281], [98, 72881], [105, 73341], [113, 73981], [115, 74261], [120, 74461]]}, {"verse": 9, "start": 75940, "end": 82174, "text": "Entonces el Señor dijo de noche en visión a Pablo: No temas, sino habla, y no calles:", "words": [[0, 75940], [9, 76422], [12, 76782], [18, 77102], [23, 77462], [26, 77642], [32, 77902], [35, 78122], [42, 78522], [44, 78642], [51, 79380], [54, 79549], [61, 79929], [66, 80469], [73, 81049], [75, 81304], [78, 81771]]}, {"verse": 10, "start": 82524, "end": 88902, "text": "Porque yo estoy contigo, y ninguno te podrá hacer mal; porque yo tengo mucho pueblo en esta ciudad.", "words": [[0, 82524], [7, 82710], [10, 82910], [16, 83130], [25, 83870], [27, 84290], [35, 84830], [38, 85010], [44, 85450], [50, 85670], [55, 86439], [62, 86603], [65, 86783], [71, 87043], [77, 87363], [84, 87843], [87, 88043], [92, 88223]]}, {"verse": 11, "start": 89252, "end": 94662, "text": "Y permaneció allí un año y seis meses, enseñándoles la palabra de Dios.", "words": [[0, 89252], [2, 89378], [13, 90138], [18, 90398], [21, 90678], [25, 90918], [27, 91078], [32, 91278], [39, 91818], [52, 92973], [55, 93433], [63, 93813], [66, 94053]]}, {"verse": 12, "start": 95012, "end": 103625, "text": "Y siendo Galión procónsul de Acaya, los judíos se levantaron de común acuerdo contra Pablo, y le llevaron al tribunal,", "words": [[0, 95012], [2, 95308], [9, 95768], [16, 96228], [26, 97028], [29, 97188], [36, 98208], [40, 98348], [47, 98888], [50, 99048], [61, 99648], [64, 99848], [70, 100128], [78, 100608], [85, 101068], [92, 101588], [94, 101908], [97, 102228], [106, 102708], [109, 102828]]}, {"verse": 13, "start": 103975, "end": 108365, "text": "Diciendo: Que este persuade a los hombres a honrar a Dios contra la ley.", "words": [[0, 103975], [10, 105025], [14, 105146], [19, 105386], [28, 105946], [30, 106066], [34, 106186], [42, 106486], [44, 106746], [51, 107066], [53, 107186], [58, 107406], [65, 107786], [68, 107986]]}, {"verse": 14, "start": 108645, "end": 118521, "text": "Y comenzando Pablo a abrir la boca, Galión dijo a los judíos: Si fuera algún agravio o algún crimen enorme, oh judíos, conforme a derecho yo os tolerara:", "words": [[0, 108645], [2, 108753], [13, 109433], [19, 109663], [21, 109893], [27, 110193], [30, 110393], [36, 110933], [43, 111613], [48, 112313], [50, 112493], [54, 112613], [62, 113501], [65, 113622], [71, 113862], [77, 114102], [85, 114582], [87, 114682], [93, 114902], [100, 115262], [108, 115732], [111, 116202], [119, 116722], [128, 117222], [130, 117262], [138, 117562], [141, 117762], [144, 117922]]}, {"verse": 15, "start": 118871, "end": 126330, "text": "Pero si son cuestiones de palabras, y de nombres, y de vuestra ley, vedlo vosotros; porque yo no quiero ser juez de estas cosas.", "words": [[0, 118871], [5, 118995], [8, 119135], [12, 119315], [23, 119775], [26, 119915], [36, 120335], [38, 120695], [41, 120775], [50, 121175], [52, 121515], [55, 121615], [63, 121955], [68, 122365], [74, 122775], [84, 123575], [91, 123782], [94, 124002], [97, 124142], [104, 124442], [108, 124742], [113, 125222], [116, 125342], [122, 125542]]}, {"verse": 16, "start": 126610, "end": 128261, "text": "Y los echó del tribunal.", "words": [[0, 126610], [2, 126731], [6, 126871], [11, 127311], [15, 127411]]}, {"verse": 17, "start": 128611, "end": 139784, "text": "Entonces todos los griegos tomando a Sóstenes, dirigente de la sinagoga, le herían delante del tribunal: y a Galión nada de ello le importaba.", "words": [[0, 128611], [9, 129472], [15, 129912], [19, 130232], [27, 130672], [35, 131119], [37, 131565], [47, 132012], [57, 132852], [60, 133032], [63, 133152], [73, 133872], [76, 134392], [83, 135012], [91, 135592], [95, 135852], [105, 136902], [107, 137083], [109, 137203], [116, 137583], [121, 138123], [124, 138443], [129, 138683], [132, 138883]]}, {"verse": 18, "start": 140134, "end": 156015, "text": "Pero Pablo habiendo permanecido aún allí muchos días, después se despidió de los hermanos, y navegó a Siria, y con él Priscila y Aquila, habiéndose cortado el cabello de la cabeza en Cencrea, porque tenía voto.", "words": [[0, 140134], [5, 140379], [11, 141274], [20, 141814], [32, 142714], [36, 142934], [41, 143194], [48, 143494], [54, 144874], [62, 144874], [65, 145414], [74, 145954], [77, 146074], [81, 146194], [91, 147014], [93, 147334], [100, 147814], [102, 147974], [109, 148494], [111, 149114], [115, 149334], [118, 149734], [127, 150134], [129, 150314], [137, 151255], [148, 151795], [156, 152415], [159, 152535], [167, 153015], [170, 153155], [173, 153295], [180, 153809], [183, 154323], [192, 154838], [199, 155010], [205, 155370]]}, {"verse": 19, "start": 156365, "end": 163780, "text": "Y llegó a Éfeso, y los dejó allí: y él entrando en la sinagoga, disputó con los judíos,", "words": [[0, 156365], [2, 156774], [8, 157219], [10, 157664], [17, 158109], [19, 158269], [23, 158429], [28, 158846], [34, 159416], [36, 159780], [39, 160040], [48, 160680], [51, 160840], [54, 160980], [64, 162000], [72, 162660], [76, 162840], [80, 163000]]}, {"verse": 20, "start": 164130, "end": 169137, "text": "Los cuales le rogaban que se quedase con ellos por más tiempo; pero no accedió,", "words": [[0, 164130], [4, 164249], [11, 164529], [14, 164949], [22, 165529], [26, 165729], [29, 165889], [37, 166329], [41, 166589], [47, 166829], [51, 167069], [55, 167249], [63, 168075], [68, 168240], [71, 168440]]}, {"verse": 21, "start": 169487, "end": 180069, "text": "Sino que se despidió de ellos, diciendo: Es necesario que en todo caso tenga la fiesta que viene, en Jerusalén; pero otra vez volveré a vosotros, queriendo Dios. Y partió de Éfeso.", "words": [[0, 169487], [5, 169807], [9, 170007], [12, 170167], [21, 170787], [24, 170927], [31, 171287], [41, 171720], [44, 171842], [54, 172422], [58, 172662], [61, 172782], [66, 172962], [71, 173262], [77, 173602], [80, 173782], [87, 174162], [91, 174322], [98, 174602], [101, 174862], [112, 175790], [117, 175930], [122, 176150], [126, 176390], [134, 176870], [136, 176870], [146, 177330], [156, 177870], [162, 178673], [164, 178799], [171, 179259], [174, 179690]]}, {"verse": 22, "start": 180419, "end": 187605, "text": "Y habiendo arribado a Cesarea subió a Jerusalén; y después de saludar a la iglesia, descendió a Antioquía.", "words": [[0, 180419], [2, 180529], [11, 180869], [20, 181269], [22, 181669], [30, 182069], [36, 182469], [38, 182549], [49, 183566], [51, 183910], [59, 184170], [62, 184370], [70, 184890], [72, 184950], [75, 185090], [84, 185490], [94, 186290], [96, 186590]]}, {"verse": 23, "start": 187955, "end": 197735, "text": "Y habiendo estado allí algún tiempo, salió, andando por orden la provincia de Galacia, y la Frigia, fortaleciendo a todos los discípulos.", "words": [[0, 187955], [2, 188078], [11, 188438], [18, 188738], [23, 189058], [29, 189338], [37, 190278], [44, 191298], [52, 191938], [56, 192198], [62, 192518], [65, 192798], [75, 193698], [78, 193818], [87, 194418], [89, 194618], [92, 194758], [100, 195298], [114, 196138], [116, 196338], [122, 196538], [126, 196798]]}, {"verse": 24, "start": 198085, "end": 207755, "text": "Llegó entonces a Éfeso un judío, llamado Apolos, natural de Alejandría, varón elocuente, poderoso en las Escrituras.", "words": [[0, 198085], [6, 198432], [15, 198852], [17, 199292], [23, 199732], [26, 199932], [33, 200472], [41, 200812], [49, 202072], [57, 202552], [60, 202772], [72, 203952], [78, 204472], [89, 205392], [98, 206212], [101, 206492], [105, 206672]]}, {"verse": 25, "start": 208105, "end": 220594, "text": "Este era instruido en el camino del Señor; y ferviente de espíritu, hablaba y enseñaba con exactitud las cosas que son del Señor, conociendo solamente el bautismo de Juan.", "words": [[0, 208105], [5, 208430], [9, 208750], [19, 209410], [22, 209530], [25, 209630], [32, 209890], [36, 210210], [43, 211050], [45, 211174], [55, 211754], [58, 211974], [68, 212814], [76, 213594], [78, 213954], [87, 214574], [91, 214794], [101, 215614], [105, 216034], [111, 216414], [115, 216614], [119, 216894], [123, 217074], [130, 217994], [141, 218574], [151, 218974], [154, 219334], [163, 219894], [166, 220074]]}, {"verse": 26, "start": 220944, "end": 232358, "text": "Y comenzó a hablar confiadamente en la sinagoga: al cual cuando oyeron Priscila y Aquila, le tomaron, y le explicaron con más precisión el camino de Dios.", "words": [[0, 220944], [2, 221061], [10, 221621], [12, 221721], [19, 222271], [33, 222821], [36, 222981], [39, 223101], [49, 224086], [52, 224296], [57, 224576], [64, 224996], [71, 225676], [80, 226356], [82, 226496], [90, 227036], [93, 227476], [102, 228136], [104, 228676], [107, 228776], [118, 229676], [122, 229896], [126, 230196], [136, 231016], [139, 231176], [146, 231456], [149, 231736]]}, {"verse": 27, "start": 232708, "end": 245304, "text": "Y queriendo él pasar a Acaya, los hermanos exhortados, escribieron a los discípulos que le recibiesen; y venido él, ayudó mucho por la gracia a los que habían creído:", "words": [[0, 232708], [2, 232849], [12, 233349], [15, 233549], [21, 233889], [23, 234169], [30, 235149], [34, 235229], [43, 235789], [55, 236769], [67, 237694], [69, 237994], [73, 238134], [84, 238814], [88, 239034], [91, 239214], [103, 240795], [105, 240899], [112, 241259], [116, 241759], [122, 242199], [128, 242499], [132, 242799], [135, 242999], [142, 243879], [144, 244019], [148, 244139], [152, 244279], [159, 244579]]}, {"verse": 28, "start": 245654, "end": 254248, "text": "Porque con gran vehemencia convencía públicamente a los judíos, mostrando por las Escrituras que Jesús era el Cristo.", "words": [[0, 245654], [7, 245941], [11, 246361], [16, 246661], [27, 247681], [37, 248461], [50, 249281], [52, 249401], [56, 249521], [64, 250521], [74, 251221], [78, 251541], [82, 251721], [93, 252381], [97, 252541], [103, 252941], [107, 253401], [110, 253581]]}]}