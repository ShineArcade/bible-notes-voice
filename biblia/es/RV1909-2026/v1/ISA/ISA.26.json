{"book": "ISA", "chapter": 26, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 193606, "verses": [{"verse": 1, "start": 300, "end": 9418, "text": "En aquel día cantarán este cantar en tierra de Judá: Fuerte ciudad tenemos: salvación puso Dios por muros y baluarte.", "words": [[0, 300], [3, 451], [9, 791], [13, 1011], [22, 1911], [27, 2231], [34, 2931], [37, 3171], [44, 3651], [47, 3931], [53, 4714], [60, 5117], [67, 5417], [76, 6569], [86, 7173], [91, 7573], [96, 7773], [100, 8073], [106, 8573], [108, 9018]]}, {"verse": 2, "start": 9868, "end": 14503, "text": "Abrid las puertas, y entrará la gente justa, guardadora de verdades.", "words": [[0, 10007], [6, 10187], [10, 10327], [19, 10787], [21, 11097], [29, 11407], [32, 11447], [38, 11727], [45, 12687], [56, 13147], [59, 13347]]}, {"verse": 3, "start": 14853, "end": 21763, "text": "Tú le guardarás en completa paz, cuyo pensamiento en ti persevera; porque en ti se ha confiado.", "words": [[0, 14853], [3, 14938], [6, 15098], [16, 15758], [19, 15898], [28, 16378], [33, 16978], [38, 17578], [50, 18318], [53, 18478], [56, 18658], [67, 19939], [74, 20259], [77, 20519], [80, 20619], [83, 20819], [86, 20919]]}, {"verse": 4, "start": 22213, "end": 28814, "text": "Confiad en Jehová perpetuamente: porque en el Señor Jehová está la fortaleza de los siglos.", "words": [[0, 22489], [8, 22799], [11, 23039], [18, 23559], [33, 25010], [40, 25424], [43, 25604], [46, 25744], [52, 26024], [59, 26724], [64, 27004], [67, 27144], [77, 27824], [80, 27944], [84, 28064]]}, {"verse": 5, "start": 29264, "end": 38575, "text": "Porque derribó los que moraban en lugar sublime: humilló la ciudad exaltada, la humilló hasta la tierra, la derribó hasta el polvo.", "words": [[0, 29264], [7, 29510], [15, 30090], [19, 30190], [23, 30350], [31, 30850], [34, 30970], [40, 31250], [49, 32509], [57, 33037], [60, 33197], [67, 33537], [77, 34797], [80, 34897], [88, 35497], [94, 35717], [97, 35897], [105, 36797], [108, 36877], [116, 37437], [122, 37677], [125, 37877]]}, {"verse": 6, "start": 39025, "end": 44762, "text": "La pisoteará el pie, los pies del afligido, los pasos de los necesitados.", "words": [[0, 39025], [3, 39150], [13, 39950], [16, 40250], [21, 41190], [25, 41310], [30, 41550], [34, 41730], [44, 42810], [48, 42910], [54, 43430], [57, 43550], [61, 43650]]}, {"verse": 7, "start": 45212, "end": 50848, "text": "El camino del justo es rectitud: Tú, Recto, pesas el camino del justo.", "words": [[0, 45212], [3, 45631], [10, 45871], [14, 46111], [20, 46351], [23, 46611], [33, 47794], [37, 47978], [44, 48918], [50, 49498], [53, 49618], [60, 50036], [64, 50454]]}, {"verse": 8, "start": 51298, "end": 59825, "text": "También en el camino de tus juicios, oh Jehová, te hemos esperado: a tu nombre y a tu memoria es el deseo del alma.", "words": [[0, 51298], [8, 51643], [11, 51863], [14, 51963], [21, 52303], [24, 52663], [28, 52803], [37, 53263], [40, 53723], [48, 54423], [51, 54703], [57, 54883], [67, 55985], [69, 56233], [72, 56373], [79, 56793], [81, 57193], [83, 57293], [86, 57433], [94, 58013], [97, 58273], [100, 58453], [106, 59053], [110, 59213]]}, {"verse": 9, "start": 60275, "end": 74114, "text": "Con mi alma te he deseado en la noche; y en tanto que me dure el espíritu en medio de mí, madrugaré a buscarte: porque luego que hay juicios tuyos en la tierra, los habitantes del mundo aprenden justicia.", "words": [[0, 60275], [4, 60402], [7, 60642], [12, 60962], [15, 61482], [18, 61622], [26, 62202], [29, 62322], [32, 62462], [39, 63309], [41, 63430], [44, 63550], [50, 63810], [54, 64030], [57, 64190], [62, 64410], [65, 64570], [74, 65090], [77, 65190], [83, 65430], [86, 65650], [90, 66410], [100, 67070], [102, 67190], [112, 68298], [119, 68505], [125, 68785], [129, 69065], [133, 69205], [141, 69785], [147, 70385], [150, 70525], [153, 70645], [161, 71465], [165, 71705], [176, 72265], [180, 72425], [186, 72705], [195, 73265]]}, {"verse": 10, "start": 74564, "end": 84463, "text": "Alcanzará piedad el impío, y no aprenderá justicia; en tierra de rectitud hará iniquidad, y no mirará a la majestad de Jehová.", "words": [[0, 74564], [10, 75289], [17, 75709], [20, 76129], [27, 76549], [29, 77089], [32, 77269], [42, 77909], [52, 79033], [55, 79317], [62, 79657], [65, 79877], [74, 80477], [79, 80957], [90, 81677], [92, 82157], [95, 82317], [102, 82857], [104, 83117], [107, 83197], [116, 83817], [119, 83937]]}, {"verse": 11, "start": 84913, "end": 94889, "text": "Jehová, bien que se levante tu mano, no ven: verán al cabo, y se avergonzarán los que envidian a tu pueblo; y a tus enemigos fuego los consumirá.", "words": [[0, 84913], [8, 85363], [13, 85543], [17, 85743], [20, 85903], [28, 86283], [31, 86443], [37, 87303], [40, 87523], [45, 88270], [51, 88597], [54, 88737], [60, 89097], [62, 89297], [65, 89437], [78, 90317], [82, 90457], [86, 90637], [95, 91257], [97, 91377], [100, 91497], [108, 92474], [110, 92603], [112, 92663], [116, 92803], [125, 93383], [131, 93743], [135, 94003]]}, {"verse": 12, "start": 95339, "end": 101468, "text": "Jehová, tú nos darás paz; porque también hiciste en nosotros todas nuestras obras.", "words": [[0, 95339], [8, 95861], [11, 96041], [15, 96581], [21, 96921], [26, 97819], [33, 98099], [41, 98599], [49, 99339], [52, 99439], [61, 99779], [67, 100239], [76, 100639]]}, {"verse": 13, "start": 101918, "end": 110310, "text": "Jehová Dios nuestro, otros señores distintos de ti nos han dominado; mas en ti solamente nos acordaremos de tu nombre.", "words": [[0, 101918], [7, 102453], [12, 103513], [21, 103753], [27, 104313], [35, 104733], [45, 105353], [48, 105473], [51, 105713], [55, 106193], [59, 106413], [69, 107467], [73, 107591], [76, 107791], [79, 107951], [89, 108311], [93, 108711], [105, 109411], [108, 109631], [111, 109771]]}, {"verse": 14, "start": 110760, "end": 120202, "text": "Muertos son, no vivirán: han fallecido, no resucitarán: porque los visitaste, y destruiste, y deshiciste toda su memoria.", "words": [[0, 110760], [8, 111230], [13, 112010], [16, 112010], [25, 113031], [29, 113176], [40, 114296], [43, 115043], [56, 116039], [63, 116243], [67, 116443], [78, 117083], [80, 117263], [92, 117903], [94, 118243], [105, 118943], [110, 119263], [113, 119543]]}, {"verse": 15, "start": 120652, "end": 130437, "text": "Añadiste al pueblo, oh Jehová, añadiste al pueblo: te hiciste glorioso: lo extendiste hasta todos los confines de la tierra.", "words": [[0, 120652], [9, 121160], [12, 121340], [20, 121813], [23, 122287], [31, 122760], [40, 123380], [43, 123520], [51, 124587], [54, 124711], [62, 125657], [72, 126849], [75, 126986], [86, 127946], [92, 128326], [98, 128746], [102, 128986], [111, 129546], [114, 129686], [117, 129806]]}, {"verse": 16, "start": 130887, "end": 136489, "text": "Jehová, en la tribulación te buscaron: derramaron oración cuando los castigaste.", "words": [[0, 130887], [8, 131350], [11, 131430], [14, 131550], [26, 132290], [29, 132450], [39, 133559], [50, 134327], [58, 134947], [65, 135327], [69, 135949]]}, {"verse": 17, "start": 136939, "end": 145411, "text": "Como la preñada cuando se acerca el parto gime, y da gritos con sus dolores, así hemos sido delante de ti, oh Jehová.", "words": [[0, 136939], [5, 137279], [8, 137459], [16, 138099], [23, 138339], [26, 138619], [33, 139039], [36, 139279], [42, 139759], [48, 140239], [50, 140719], [53, 140879], [60, 141279], [64, 141499], [68, 141719], [77, 142659], [81, 142939], [87, 143199], [92, 143579], [100, 144099], [103, 144279], [107, 144719], [110, 144919]]}, {"verse": 18, "start": 145861, "end": 155333, "text": "Concebimos, tuvimos dolores de parto, parimos como viento: ninguna liberación hicimos en la tierra, ni cayeron los habitantes del mundo.", "words": [[0, 146208], [12, 146588], [20, 146988], [28, 147708], [31, 147848], [38, 148488], [46, 148953], [51, 149417], [59, 150116], [67, 150690], [78, 151430], [86, 151950], [89, 152150], [92, 152310], [100, 152730], [103, 153150], [111, 153730], [115, 153870], [126, 154530], [130, 154770]]}, {"verse": 19, "start": 155783, "end": 170687, "text": "Tus muertos vivirán; junto con mi cuerpo muerto resucitarán. ¡Despertad y cantad, habitantes del polvo! porque tu rocío, cual rocío de hortalizas; y la tierra echará los muertos.", "words": [[0, 155783], [4, 155887], [12, 156407], [21, 157813], [27, 158113], [31, 158433], [34, 158593], [41, 158933], [48, 159533], [61, 161626], [72, 162106], [74, 162676], [82, 163246], [93, 163926], [97, 164106], [104, 165199], [111, 165349], [114, 165509], [121, 166209], [126, 166389], [132, 166699], [135, 167009], [147, 168227], [149, 168333], [152, 168453], [159, 168873], [166, 169693], [170, 169853]]}, {"verse": 20, "start": 171137, "end": 180517, "text": "Anda, pueblo mío, éntrate en tus aposentos, cierra tras ti tus puertas; escóndete un poquito, por un momento, en tanto que pasa la ira.", "words": [[0, 171137], [6, 171443], [13, 171773], [18, 172143], [26, 172513], [29, 172833], [33, 173033], [44, 174173], [51, 174553], [56, 174813], [59, 175133], [63, 175253], [72, 176358], [82, 176998], [85, 177178], [94, 177458], [98, 177818], [101, 177978], [110, 178878], [113, 179038], [119, 179278], [123, 179518], [128, 179778], [131, 180173]]}, {"verse": 21, "start": 180967, "end": 193206, "text": "Porque he aquí que Jehová sale de su lugar, para visitar la maldad del habitante de la tierra contra él; y la tierra descubrirá sus sangres, y no más encubrirá sus muertos.", "words": [[0, 180967], [7, 181189], [10, 181489], [15, 181809], [19, 181969], [26, 182569], [31, 182749], [34, 182949], [37, 183109], [44, 183469], [49, 184009], [57, 184609], [60, 184729], [67, 185189], [71, 185409], [81, 185909], [84, 186069], [87, 186209], [94, 186449], [101, 186929], [105, 187686], [107, 187808], [110, 187948], [117, 188408], [128, 189748], [132, 190338], [141, 190928], [143, 191088], [146, 191248], [150, 191528], [160, 192228], [164, 192388]]}]}