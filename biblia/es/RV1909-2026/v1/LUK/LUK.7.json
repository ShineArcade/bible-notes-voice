{"book": "LUK", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 423758, "verses": [{"verse": 1, "start": 300, "end": 5637, "text": "Y como acabó todas sus palabras oyéndole el pueblo, entró en Capernaum.", "words": [[0, 300], [2, 407], [7, 647], [13, 1067], [19, 1267], [23, 1547], [32, 1927], [41, 2687], [44, 2827], [52, 3807], [58, 4507], [61, 4727]]}, {"verse": 2, "start": 5987, "end": 13457, "text": "Y el siervo de un centurión, al cual tenía él en estima, estaba enfermo y a punto de morir.", "words": [[0, 5987], [2, 6427], [5, 6567], [12, 7047], [15, 7187], [18, 7307], [29, 7997], [32, 8687], [37, 8787], [43, 9227], [46, 9647], [49, 9887], [57, 10847], [64, 11127], [72, 11927], [74, 12152], [76, 12272], [82, 12572], [85, 12852]]}, {"verse": 3, "start": 13807, "end": 21968, "text": "Y cuando oyó hablar de Jesús, envió a él los ancianos de los judíos, rogándole que viniese y librase a su siervo.", "words": [[0, 13807], [2, 13885], [9, 14165], [13, 14505], [20, 14765], [23, 14945], [30, 16025], [36, 16545], [38, 16725], [41, 16885], [45, 17065], [54, 17645], [57, 17765], [61, 17865], [69, 18635], [79, 19405], [83, 19585], [91, 20165], [93, 20505], [101, 21045], [103, 21205], [106, 21345]]}, {"verse": 4, "start": 22318, "end": 29067, "text": "Y viniendo ellos a Jesús, le rogaron con diligencia, diciéndole: Porque es digno de concederle esto;", "words": [[0, 22318], [2, 22499], [11, 22999], [17, 23259], [19, 23479], [26, 23919], [29, 24359], [37, 24899], [41, 25059], [53, 26099], [65, 27210], [72, 27442], [75, 27562], [81, 27922], [84, 27982], [95, 28642]]}, {"verse": 5, "start": 29417, "end": 32540, "text": "Que ama nuestra nación, y él nos edificó una sinagoga.", "words": [[0, 29417], [4, 29534], [8, 29694], [16, 29914], [24, 30534], [26, 30894], [29, 31014], [33, 31154], [41, 31694], [45, 31814]]}, {"verse": 6, "start": 32820, "end": 46329, "text": "Y Jesús fue con ellos. Pero como ya no estuviesen lejos de su casa, envió el centurión amigos a él, diciéndole: Señor, no te incomodes, que no soy digno que entres debajo de mi techo;", "words": [[0, 32820], [2, 32941], [8, 33301], [12, 33661], [16, 33921], [23, 34788], [28, 34972], [33, 35232], [36, 35512], [39, 35712], [50, 36332], [56, 36852], [59, 37012], [62, 37172], [68, 38052], [74, 38492], [77, 38652], [87, 39652], [94, 39892], [96, 40172], [100, 40732], [112, 41968], [119, 42527], [122, 42627], [125, 42767], [136, 43707], [140, 43947], [143, 44087], [147, 44287], [153, 44747], [157, 44847], [164, 45187], [171, 45567], [174, 45727], [177, 45787]]}, {"verse": 7, "start": 46679, "end": 52838, "text": "Por lo cual ni aun me tuve por digno de venir a ti; pero di la palabra, y mi siervo será sano.", "words": [[0, 46679], [4, 46782], [7, 46922], [12, 47222], [15, 47502], [19, 47682], [22, 47902], [27, 48182], [31, 48342], [37, 48722], [40, 48802], [46, 49022], [48, 49222], [52, 49752], [57, 49911], [60, 50111], [63, 50251], [72, 51131], [74, 51411], [77, 51571], [84, 52011], [89, 52251]]}, {"verse": 8, "start": 53188, "end": 64969, "text": "Porque también yo soy hombre puesto bajo autoridad, que tengo debajo de mí soldados; y digo a este: Ve, y va; y al otro: Ven, y viene; y a mi siervo: Haz esto, y lo hace.", "words": [[0, 53188], [7, 53365], [15, 53765], [18, 53965], [22, 54145], [29, 54425], [36, 54805], [41, 55025], [52, 55685], [56, 56145], [62, 56465], [69, 56845], [72, 56985], [75, 57125], [85, 58060], [87, 58199], [92, 58399], [94, 58519], [100, 59315], [104, 59520], [106, 59725], [110, 60150], [112, 60316], [115, 60416], [121, 61041], [126, 61318], [128, 61658], [135, 62337], [137, 62497], [139, 62517], [142, 62597], [150, 63457], [154, 63669], [160, 64049], [162, 64429], [165, 64589]]}, {"verse": 9, "start": 65249, "end": 75530, "text": "Lo cual oyendo Jesús, se maravilló de él, y vuelto, dijo a la gente que le seguía: Os digo que ni aun en Israel he hallado tanta fe.", "words": [[0, 65249], [3, 65375], [8, 65695], [15, 66235], [22, 67175], [25, 67565], [35, 67955], [38, 68055], [42, 68335], [44, 68775], [52, 69655], [57, 69955], [59, 70115], [62, 70175], [68, 70435], [72, 70655], [75, 70775], [83, 71610], [86, 71850], [91, 72170], [95, 72450], [98, 72790], [102, 73130], [105, 73510], [112, 73990], [115, 74370], [123, 74810], [129, 75010]]}, {"verse": 10, "start": 75880, "end": 82479, "text": "Y vueltos a casa los que habían sido enviados, hallaron sano al siervo que había estado enfermo.", "words": [[0, 75880], [2, 76023], [10, 76583], [12, 76703], [17, 77023], [21, 77263], [25, 77423], [32, 77643], [37, 77983], [47, 78943], [56, 79543], [61, 80043], [64, 80343], [71, 80903], [75, 81083], [81, 81283], [88, 81663]]}, {"verse": 11, "start": 82829, "end": 91416, "text": "Y aconteció después, que él iba a la ciudad que se llama Naín, e iban con él muchos de sus discípulos, y una gran multitud.", "words": [[0, 82829], [2, 82973], [12, 83673], [21, 83953], [25, 84273], [28, 84453], [32, 84653], [34, 84793], [37, 84833], [44, 85133], [48, 85433], [51, 85573], [57, 86193], [63, 86813], [65, 86873], [70, 87173], [74, 87373], [77, 87573], [84, 87953], [87, 88153], [91, 88333], [103, 89573], [105, 89913], [109, 90093], [114, 90493]]}, {"verse": 12, "start": 91766, "end": 104552, "text": "Y cuando llegó cerca de la puerta de la ciudad, he aquí que sacaban fuera a un difunto, único hijo de su madre, la cual también era viuda: y había con ella una gran multitud de la ciudad.", "words": [[0, 91766], [2, 91873], [9, 92113], [15, 92453], [21, 92833], [24, 93073], [27, 93213], [34, 93473], [37, 93713], [40, 93833], [48, 94853], [51, 95193], [56, 95433], [60, 95913], [68, 96393], [74, 96573], [76, 96893], [79, 97013], [88, 97613], [94, 98073], [99, 98513], [102, 98733], [105, 98873], [112, 99593], [115, 99713], [120, 99913], [128, 100293], [132, 100673], [139, 101494], [141, 101637], [147, 101837], [151, 102117], [156, 102317], [160, 102537], [165, 102797], [174, 103577], [177, 103797], [180, 103917]]}, {"verse": 13, "start": 104902, "end": 109929, "text": "Y como el Señor la vio, se compadeció de ella, y le dice: No llores.", "words": [[0, 104902], [2, 104989], [7, 105189], [10, 105349], [16, 105589], [19, 105829], [24, 106429], [27, 106589], [38, 107409], [41, 107569], [47, 107849], [49, 108349], [52, 108489], [58, 109474], [61, 109738]]}, {"verse": 14, "start": 110279, "end": 117132, "text": "Y acercándose, tocó el féretro: y los que lo llevaban, pararon. Y dice: Joven, a ti digo, levántate.", "words": [[0, 110279], [2, 110380], [15, 111140], [20, 111680], [23, 111820], [32, 112676], [34, 112785], [38, 112925], [42, 113065], [45, 113205], [55, 113550], [64, 114040], [66, 114185], [72, 114929], [79, 115554], [81, 115654], [84, 115754], [90, 116054]]}, {"verse": 15, "start": 117482, "end": 123146, "text": "Entonces se incorporó el que había muerto, y comenzó a hablar. Y le dio a su madre.", "words": [[0, 117482], [9, 118086], [12, 118426], [22, 118876], [25, 119326], [29, 119466], [35, 119686], [43, 120266], [45, 120686], [53, 121246], [55, 121366], [63, 121861], [65, 121946], [68, 122066], [72, 122286], [74, 122466], [77, 122606]]}, {"verse": 16, "start": 123496, "end": 133044, "text": "Y todos tuvieron miedo, y glorificaban a Dios, diciendo: Que un gran profeta se ha levantado entre nosotros; y que Dios ha visitado a su pueblo.", "words": [[0, 123496], [2, 123621], [8, 123901], [17, 124501], [24, 124961], [26, 125226], [39, 126066], [41, 126206], [47, 126826], [57, 127748], [61, 128343], [64, 128470], [69, 128650], [77, 129150], [80, 129350], [83, 129430], [93, 129970], [99, 130150], [109, 131148], [111, 131252], [115, 131352], [120, 131612], [123, 131852], [132, 132332], [134, 132412], [137, 132512]]}, {"verse": 17, "start": 133324, "end": 138733, "text": "Y salió esta fama de él por toda Judea, y por toda la tierra de alrededor.", "words": [[0, 133324], [2, 133451], [8, 133871], [13, 134171], [18, 134571], [21, 134691], [24, 134851], [28, 135071], [33, 135311], [40, 136091], [42, 136471], [46, 136691], [51, 137091], [54, 137291], [61, 137671], [64, 137911]]}, {"verse": 18, "start": 139083, "end": 145493, "text": "Y sus discípulos informaron a Juan de todas estas cosas: y llamó Juan a dos de sus discípulos,", "words": [[0, 139083], [2, 139190], [6, 139330], [17, 139990], [28, 140750], [30, 140930], [35, 141190], [38, 141430], [44, 141690], [50, 142030], [57, 142994], [59, 143100], [65, 143380], [70, 143600], [72, 143900], [76, 144120], [79, 144280], [83, 144480]]}, {"verse": 19, "start": 145843, "end": 151617, "text": "Y envió a Jesús, diciendo: ¿Eres tú aquel que había de venir, o esperaremos a otro?", "words": [[0, 145843], [2, 146008], [8, 146428], [10, 146708], [17, 147148], [27, 148522], [33, 148740], [36, 148980], [42, 149340], [46, 149440], [52, 149640], [55, 149800], [62, 150080], [64, 150420], [76, 151000], [78, 151240]]}, {"verse": 20, "start": 151897, "end": 161771, "text": "Y como los hombres vinieron a él, dijeron: Juan el Bautista nos ha enviado a ti, diciendo: ¿Eres tú aquel que había de venir, o esperaremos a otro?", "words": [[0, 151897], [2, 152022], [7, 152262], [11, 152462], [19, 152882], [28, 153462], [30, 153662], [34, 154202], [43, 155157], [48, 155674], [51, 155714], [60, 156434], [64, 156554], [67, 156734], [75, 157194], [77, 157314], [81, 157474], [91, 158676], [97, 158893], [100, 159133], [106, 159493], [110, 159593], [116, 159793], [119, 159953], [126, 160233], [128, 160573], [140, 161153], [142, 161393]]}, {"verse": 21, "start": 162051, "end": 170284, "text": "Y en la misma hora sanó a muchos de enfermedades y plagas, y de espíritus malos; y a muchos ciegos dio la vista.", "words": [[0, 162051], [2, 162197], [5, 162297], [8, 162417], [14, 162677], [19, 163097], [24, 163617], [26, 163737], [33, 164017], [36, 164297], [49, 165157], [51, 165337], [59, 166177], [61, 166357], [64, 166497], [74, 167037], [81, 167925], [83, 168050], [85, 168090], [92, 168350], [99, 169150], [103, 169470], [106, 169630]]}, {"verse": 22, "start": 170634, "end": 189715, "text": "Y respondiendo Jesús, les dijo: Id, dad las nuevas a Juan de lo que habéis visto y oído: que los ciegos ven, los cojos andan, los leprosos son limpiados, los sordos oyen, los muertos resucitan, a los pobres es anunciado el evangelio:", "words": [[0, 170634], [2, 170742], [15, 171442], [22, 171882], [26, 172462], [32, 173294], [36, 173404], [40, 173784], [44, 174184], [51, 174584], [53, 174824], [58, 175124], [61, 175764], [64, 175884], [68, 176024], [75, 176364], [81, 176824], [83, 177244], [89, 178076], [93, 178158], [97, 178318], [104, 178818], [109, 179778], [113, 179898], [119, 180358], [126, 181398], [130, 181518], [139, 182098], [143, 182418], [154, 183498], [158, 183598], [165, 184238], [171, 185218], [175, 185338], [183, 185858], [194, 187058], [196, 187098], [200, 187238], [207, 187718], [210, 187998], [220, 188758], [223, 188878]]}, {"verse": 23, "start": 190065, "end": 192852, "text": "Y dichoso es el que no halle tropiezo en mí.", "words": [[0, 190065], [2, 190210], [10, 190730], [13, 190950], [16, 191070], [20, 191250], [23, 191470], [29, 191690], [38, 192370], [41, 192490]]}, {"verse": 24, "start": 193202, "end": 204327, "text": "Y como se fueron los mensajeros de Juan, comenzó a hablar de Juan a la gente: ¿Qué salisteis a ver al desierto? ¿una caña que es agitada por el viento?", "words": [[0, 193202], [2, 193343], [7, 193623], [10, 193843], [17, 194203], [21, 194443], [32, 195223], [35, 195383], [41, 196203], [49, 196903], [51, 197003], [58, 197203], [61, 197403], [66, 197663], [68, 197823], [71, 197883], [78, 198800], [83, 198904], [93, 199604], [95, 199764], [99, 199904], [102, 200044], [112, 201096], [117, 201476], [122, 201996], [126, 202456], [129, 202656], [137, 203316], [141, 203536], [144, 203676]]}, {"verse": 25, "start": 204677, "end": 215818, "text": "Pero ¿qué salisteis a ver? ¿un hombre cubierto de vestidos delicados? He aquí, los que están en vestido precioso, y viven en delicias, en los palacios de los reyes están.", "words": [[0, 204677], [5, 204860], [10, 205260], [20, 205840], [22, 205980], [27, 206578], [31, 206725], [38, 207005], [47, 207705], [50, 207865], [59, 208345], [70, 209416], [73, 209574], [79, 209874], [83, 210054], [87, 210194], [93, 210394], [96, 210574], [104, 210954], [114, 211654], [116, 212154], [122, 212554], [125, 212654], [135, 213214], [138, 213814], [142, 213934], [151, 214494], [154, 214614], [158, 214904], [164, 215194]]}, {"verse": 26, "start": 216168, "end": 221456, "text": "Pero ¿qué salisteis a ver? ¿un profeta? También os digo, y aun más que profeta.", "words": [[0, 216168], [5, 216351], [10, 216751], [20, 217331], [22, 217471], [27, 218070], [31, 218218], [40, 219159], [48, 219383], [51, 219623], [57, 219923], [59, 220323], [63, 220463], [67, 220703], [71, 220823]]}, {"verse": 27, "start": 221806, "end": 229787, "text": "Este es de quien está escrito: He aquí, envío mi mensajero delante de tu faz, el cual preparará tu camino delante de ti.", "words": [[0, 221806], [5, 222050], [8, 222306], [11, 222562], [17, 222817], [22, 223073], [31, 223489], [34, 223677], [40, 223997], [46, 224497], [49, 224657], [59, 225357], [67, 225797], [70, 225957], [73, 226097], [78, 227017], [81, 227117], [86, 227377], [96, 228217], [99, 228377], [106, 228737], [114, 229297], [117, 229457]]}, {"verse": 28, "start": 230137, "end": 239886, "text": "Porque os digo que entre los nacidos de mujeres, no hay mayor profeta que Juan el Bautista: pero el más pequeño en el reino de los cielos es mayor que él.", "words": [[0, 230137], [7, 230379], [10, 230599], [15, 230879], [19, 231099], [25, 231339], [29, 231559], [37, 232079], [40, 232239], [49, 232699], [52, 233299], [56, 233459], [62, 233839], [70, 234459], [74, 234599], [79, 234859], [82, 235039], [92, 236105], [97, 236273], [100, 236413], [104, 236533], [112, 236973], [115, 237193], [118, 237333], [124, 237693], [127, 237793], [131, 237953], [138, 238393], [141, 238573], [147, 239193], [151, 239533]]}, {"verse": 29, "start": 240236, "end": 249276, "text": "Y todo el pueblo oyéndole, y los recaudadores de impuestos, reconocieron la justicia de Dios, bautizándose con el bautismo de Juan.", "words": [[0, 240236], [2, 240381], [7, 240641], [10, 240861], [17, 241221], [27, 242101], [29, 242316], [33, 242476], [46, 243256], [49, 243436], [60, 244756], [73, 245376], [76, 245536], [85, 246056], [88, 246216], [94, 247076], [107, 247916], [111, 248156], [114, 248276], [123, 248756], [126, 248896]]}, {"verse": 30, "start": 249626, "end": 258024, "text": "Pero los fariseos y los sabios de la ley, desecharon el consejo de Dios contra sí mismos, no siendo bautizados de él.", "words": [[0, 249626], [5, 249771], [9, 249951], [18, 250731], [20, 250871], [24, 251031], [31, 251531], [34, 251611], [37, 251751], [42, 252071], [53, 253291], [56, 253471], [64, 254131], [67, 254251], [72, 254471], [79, 254871], [82, 255071], [90, 255991], [93, 256231], [100, 256531], [111, 257351], [114, 257631]]}, {"verse": 31, "start": 258374, "end": 265790, "text": "Y dice el Señor: ¿A quién, pues, compararé los hombres de esta generación, y a qué son semejantes?", "words": [[0, 258374], [2, 258498], [7, 258798], [10, 258978], [17, 259852], [20, 259977], [27, 260217], [33, 260917], [43, 261677], [47, 261837], [55, 262217], [58, 262517], [63, 262737], [75, 264097], [77, 264237], [79, 264357], [83, 264457], [87, 264697]]}, {"verse": 32, "start": 266140, "end": 280068, "text": "Semejantes son a los muchachos sentados en la plaza, y que dan voces los unos a los otros, y dicen: Tocamos flautas para vosotros, y no bailasteis: os cantamos lamentos, y no llorasteis.", "words": [[0, 266140], [11, 266823], [15, 267083], [17, 267203], [21, 267323], [31, 267923], [40, 268523], [43, 268743], [46, 268883], [53, 269383], [55, 269730], [59, 270076], [63, 270423], [69, 270983], [73, 271183], [78, 271563], [80, 271923], [84, 272103], [91, 272483], [93, 273003], [100, 273881], [108, 274264], [116, 274824], [121, 275004], [131, 275564], [133, 275884], [136, 276044], [148, 277392], [151, 277542], [160, 278102], [170, 278622], [172, 278922], [175, 279102]]}, {"verse": 33, "start": 280418, "end": 286373, "text": "Porque vino Juan el Bautista, que ni comía pan, ni bebía vino, y decís: Demonio tiene.", "words": [[0, 280418], [7, 280622], [12, 280882], [17, 281402], [20, 281502], [30, 282222], [34, 282302], [37, 282442], [43, 282762], [48, 283442], [51, 283722], [57, 284082], [63, 284362], [65, 284582], [72, 285373], [80, 285878]]}, {"verse": 34, "start": 286723, "end": 297566, "text": "Vino el Hijo del hombre, que come y bebe, y decís: He aquí un hombre comilón, y bebedor de vino, amigo de recaudadores de impuestos y de pecadores.", "words": [[0, 286723], [5, 287008], [8, 287168], [13, 287388], [17, 287568], [25, 287908], [29, 288408], [34, 288848], [36, 289108], [42, 289448], [44, 289608], [51, 290557], [54, 290832], [59, 291092], [62, 291252], [69, 291512], [78, 292252], [80, 292712], [88, 293192], [91, 293332], [97, 294012], [103, 294392], [106, 294612], [119, 295452], [122, 295672], [132, 296332], [134, 296532], [137, 296652]]}, {"verse": 35, "start": 297916, "end": 301136, "text": "Pero la sabiduría es justificada de todos sus hijos.", "words": [[0, 297916], [5, 298061], [8, 298241], [18, 298941], [21, 299041], [33, 299841], [36, 300021], [42, 300221], [46, 300561]]}, {"verse": 36, "start": 301486, "end": 308992, "text": "Y le rogó uno de los fariseos, que comiese con él. Y entrado en casa del fariseo, se sentó a la mesa.", "words": [[0, 301486], [2, 301612], [5, 301732], [10, 302172], [14, 302372], [17, 302512], [21, 302632], [31, 303472], [35, 303892], [43, 304332], [47, 304592], [51, 305151], [53, 305429], [61, 306069], [64, 306229], [69, 306529], [73, 306789], [82, 307629], [85, 307869], [91, 308309], [93, 308389], [96, 308489]]}, {"verse": 37, "start": 309342, "end": 320175, "text": "Y he aquí una mujer que había sido pecadora en la ciudad, como entendió que estaba a la mesa en casa de aquel fariseo, trajo un frasco de alabastro con ungüento,", "words": [[0, 309342], [2, 309519], [5, 309679], [10, 310039], [14, 310339], [20, 310759], [24, 310999], [30, 311239], [35, 311599], [44, 312259], [47, 312419], [50, 312539], [58, 313599], [63, 313919], [72, 314439], [76, 314579], [83, 314899], [85, 315119], [88, 315179], [93, 315459], [96, 315659], [101, 316019], [104, 316239], [110, 316519], [119, 317470], [125, 317794], [128, 317934], [135, 318454], [138, 318594], [148, 319194], [152, 319713]]}, {"verse": 38, "start": 320525, "end": 332161, "text": "Y estando detrás a sus pies, comenzó llorando a regar con lágrimas sus pies, y los limpiaba con los cabellos de su cabeza; y besaba sus pies, y los ungía con el perfume.", "words": [[0, 320525], [2, 320651], [10, 321211], [17, 321731], [19, 321871], [23, 322071], [29, 322351], [37, 323046], [46, 323546], [48, 323646], [54, 324046], [58, 324146], [67, 324786], [71, 325026], [77, 325306], [79, 325806], [83, 325946], [92, 326666], [96, 326906], [100, 327066], [109, 327586], [112, 327686], [115, 327826], [123, 328811], [125, 328918], [132, 329298], [136, 329498], [142, 329818], [144, 330153], [148, 330333], [154, 331053], [158, 331293], [161, 331413]]}, {"verse": 39, "start": 332511, "end": 344777, "text": "Y cuando vio esto el fariseo que le había invitado, habló entre sí, diciendo: Este, si fuera profeta, conocería quién y cuál es la mujer que le toca, que es pecadora.", "words": [[0, 332511], [2, 332614], [9, 332854], [13, 333274], [18, 333594], [21, 333754], [29, 334474], [33, 334614], [36, 334774], [42, 334994], [52, 335894], [58, 336674], [64, 337034], [68, 337934], [78, 338880], [84, 339200], [87, 339400], [93, 339680], [102, 340700], [112, 341340], [118, 341580], [120, 341760], [125, 342040], [128, 342320], [131, 342460], [137, 342780], [141, 342980], [144, 343100], [150, 343880], [154, 343940], [157, 344100]]}, {"verse": 40, "start": 345057, "end": 353038, "text": "Entonces respondiendo Jesús, le dijo: Simón, una cosa tengo que decirte. Y él dice: Di, Maestro.", "words": [[0, 345057], [9, 345939], [22, 346582], [29, 347482], [32, 347582], [38, 348339], [45, 349176], [49, 349356], [54, 349636], [60, 349976], [64, 350196], [73, 351212], [75, 351418], [78, 351558], [84, 352314], [88, 352404]]}, {"verse": 41, "start": 353318, "end": 359919, "text": "Un acreedor tenía dos deudores: el uno le debía quinientos denarios, y el otro cincuenta;", "words": [[0, 353551], [3, 353817], [12, 354084], [18, 354564], [22, 354984], [32, 356213], [35, 356390], [39, 356600], [42, 356760], [48, 357280], [59, 357800], [69, 358320], [71, 358620], [74, 358780], [79, 359378]]}, {"verse": 42, "start": 360269, "end": 367031, "text": "Y no teniendo ellos de qué pagar, perdonó a ambos. Di, pues, ¿cuál de estos le amará más?", "words": [[0, 360269], [2, 360569], [5, 360729], [14, 361269], [20, 361529], [23, 361789], [27, 361889], [34, 362689], [42, 363429], [44, 363569], [51, 364407], [55, 364847], [61, 365307], [67, 365707], [70, 365827], [76, 366047], [79, 366307], [85, 366547]]}, {"verse": 43, "start": 367381, "end": 374766, "text": "Y respondiendo Simón, dijo: Pienso que aquel al cual perdonó más. Y él le dijo: Rectamente has juzgado.", "words": [[0, 367381], [2, 367508], [15, 368248], [22, 368768], [28, 369627], [35, 369924], [39, 370064], [45, 370344], [48, 370484], [53, 370644], [61, 371144], [66, 371829], [68, 372034], [71, 372174], [74, 372334], [80, 373301], [91, 373575], [95, 373848]]}, {"verse": 44, "start": 375116, "end": 387050, "text": "Y vuelto a la mujer, dijo a Simón: ¿Ves esta mujer? Entré en tu casa, no diste agua para mis pies; pero esta ha regado mis pies con lágrimas, y los ha limpiado con los cabellos.", "words": [[0, 375116], [2, 375239], [9, 375579], [11, 375659], [14, 375719], [21, 376339], [26, 376639], [28, 376819], [35, 377647], [40, 377777], [45, 377917], [52, 378793], [58, 379236], [61, 379316], [64, 379436], [70, 379769], [73, 380103], [79, 380436], [84, 380756], [89, 381016], [93, 381176], [99, 382001], [104, 382149], [109, 382529], [112, 382669], [119, 383149], [123, 383329], [128, 383609], [132, 383889], [142, 384669], [144, 384871], [148, 385074], [151, 385234], [160, 385874], [164, 386094], [168, 386593]]}, {"verse": 45, "start": 387400, "end": 393841, "text": "No me diste beso, pero esta, desde que entré, no ha cesado de besar mis pies.", "words": [[0, 387400], [3, 387528], [6, 387668], [12, 387988], [18, 388688], [23, 388908], [29, 389788], [35, 390108], [39, 390428], [46, 391388], [49, 391588], [52, 391728], [59, 392228], [62, 392408], [68, 392848], [72, 393008]]}, {"verse": 46, "start": 394191, "end": 399576, "text": "No ungiste mi cabeza con aceite; pero esta ha ungido con perfume mis pies.", "words": [[0, 394191], [3, 394398], [11, 394858], [14, 395058], [21, 395418], [25, 395758], [33, 396548], [38, 396967], [43, 397287], [46, 397607], [53, 397927], [57, 398207], [65, 398707], [69, 398967]]}, {"verse": 47, "start": 399926, "end": 407952, "text": "Por lo cual te digo que sus muchos pecados son perdonados, porque amó mucho; pero al que se perdona poco, poco ama.", "words": [[0, 399926], [4, 400030], [7, 400150], [12, 400350], [15, 400550], [20, 400830], [24, 400990], [28, 401170], [35, 401530], [43, 402090], [47, 402310], [59, 403530], [66, 403990], [70, 404470], [77, 405214], [82, 405407], [85, 405637], [89, 405777], [92, 405957], [100, 406477], [106, 406817], [111, 407417]]}, {"verse": 48, "start": 408302, "end": 411624, "text": "Y a ella dijo: Los pecados te son perdonados.", "words": [[0, 408302], [2, 408469], [4, 408549], [9, 408749], [15, 409647], [19, 409754], [27, 410254], [30, 410394], [34, 410594]]}, {"verse": 49, "start": 411974, "end": 419389, "text": "Y los que estaban juntamente sentados a la mesa, comenzaron a decir entre sí: ¿Quién es este, que también perdona pecados?", "words": [[0, 411974], [2, 412064], [6, 412184], [10, 412324], [18, 412704], [29, 413564], [38, 414324], [40, 414484], [43, 414584], [49, 414824], [60, 415664], [62, 415784], [68, 416104], [74, 416424], [78, 417080], [85, 417302], [88, 417442], [94, 417662], [98, 417822], [106, 418182], [114, 418622]]}, {"verse": 50, "start": 419669, "end": 423358, "text": "Y dijo a la mujer: Tu fe te ha salvado, ve en paz.", "words": [[0, 419669], [2, 419817], [7, 420117], [9, 420237], [12, 420317], [19, 421092], [22, 421174], [25, 421374], [28, 421534], [31, 421634], [40, 422554], [43, 422714], [46, 422874]]}]}