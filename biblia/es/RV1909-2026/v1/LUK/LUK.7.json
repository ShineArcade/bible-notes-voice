{"book": "LUK", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 424457, "verses": [{"verse": 1, "start": 300, "end": 5637, "text": "Y como acabó todas sus palabras oyéndole el pueblo, entró en Capernaum.", "words": [[0, 300], [2, 407], [7, 647], [13, 1067], [19, 1267], [23, 1547], [32, 1927], [41, 2687], [44, 2827], [52, 3807], [58, 4507], [61, 4727]]}, {"verse": 2, "start": 5987, "end": 13457, "text": "Y el siervo de un centurión, al cual tenía él en estima, estaba enfermo y a punto de morir.", "words": [[0, 5987], [2, 6427], [5, 6567], [12, 7047], [15, 7187], [18, 7307], [29, 7997], [32, 8687], [37, 8787], [43, 9227], [46, 9647], [49, 9887], [57, 10847], [64, 11127], [72, 11927], [74, 12152], [76, 12272], [82, 12572], [85, 12852]]}, {"verse": 3, "start": 13807, "end": 21968, "text": "Y cuando oyó hablar de Jesús, envió a él los ancianos de los judíos, rogándole que viniese y librase a su siervo.", "words": [[0, 13807], [2, 13885], [9, 14165], [13, 14505], [20, 14765], [23, 14945], [30, 16025], [36, 16545], [38, 16725], [41, 16885], [45, 17065], [54, 17645], [57, 17765], [61, 17865], [69, 18635], [79, 19405], [83, 19585], [91, 20165], [93, 20505], [101, 21045], [103, 21205], [106, 21345]]}, {"verse": 4, "start": 22318, "end": 29067, "text": "Y viniendo ellos a Jesús, le rogaron con diligencia, diciéndole: Porque es digno de concederle esto;", "words": [[0, 22318], [2, 22499], [11, 22999], [17, 23259], [19, 23479], [26, 23919], [29, 24359], [37, 24899], [41, 25059], [53, 26099], [65, 27210], [72, 27442], [75, 27562], [81, 27922], [84, 27982], [95, 28642]]}, {"verse": 5, "start": 29417, "end": 32540, "text": "Que ama nuestra nación, y él nos edificó una sinagoga.", "words": [[0, 29417], [4, 29534], [8, 29694], [16, 29914], [24, 30534], [26, 30894], [29, 31014], [33, 31154], [41, 31694], [45, 31814]]}, {"verse": 6, "start": 32820, "end": 46329, "text": "Y Jesús fue con ellos. Pero como ya no estuviesen lejos de su casa, envió el centurión amigos a él, diciéndole: Señor, no te incomodes, que no soy digno que entres debajo de mi techo;", "words": [[0, 32820], [2, 32941], [8, 33301], [12, 33661], [16, 33921], [23, 34788], [28, 34972], [33, 35232], [36, 35512], [39, 35712], [50, 36332], [56, 36852], [59, 37012], [62, 37172], [68, 38052], [74, 38492], [77, 38652], [87, 39652], [94, 39892], [96, 40172], [100, 40732], [112, 41968], [119, 42527], [122, 42627], [125, 42767], [136, 43707], [140, 43947], [143, 44087], [147, 44287], [153, 44747], [157, 44847], [164, 45187], [171, 45567], [174, 45727], [177, 45787]]}, {"verse": 7, "start": 46679, "end": 52838, "text": "Por lo cual ni aun me tuve por digno de venir a ti; pero di la palabra, y mi siervo será sano.", "words": [[0, 46679], [4, 46782], [7, 46922], [12, 47222], [15, 47502], [19, 47682], [22, 47902], [27, 48182], [31, 48342], [37, 48722], [40, 48802], [46, 49022], [48, 49222], [52, 49752], [57, 49911], [60, 50111], [63, 50251], [72, 51131], [74, 51411], [77, 51571], [84, 52011], [89, 52251]]}, {"verse": 8, "start": 53188, "end": 64969, "text": "Porque también yo soy hombre puesto bajo autoridad, que tengo debajo de mí soldados; y digo a este: Ve, y va; y al otro: Ven, y viene; y a mi siervo: Haz esto, y lo hace.", "words": [[0, 53188], [7, 53365], [15, 53765], [18, 53965], [22, 54145], [29, 54425], [36, 54805], [41, 55025], [52, 55685], [56, 56145], [62, 56465], [69, 56845], [72, 56985], [75, 57125], [85, 58060], [87, 58199], [92, 58399], [94, 58519], [100, 59315], [104, 59520], [106, 59725], [110, 60150], [112, 60316], [115, 60416], [121, 61041], [126, 61318], [128, 61658], [135, 62337], [137, 62497], [139, 62517], [142, 62597], [150, 63457], [154, 63669], [160, 64049], [162, 64429], [165, 64589]]}, {"verse": 9, "start": 65249, "end": 75530, "text": "Lo cual oyendo Jesús, se maravilló de él, y vuelto, dijo a la gente que le seguía: Os digo que ni aun en Israel he hallado tanta fe.", "words": [[0, 65249], [3, 65375], [8, 65695], [15, 66235], [22, 67175], [25, 67565], [35, 67955], [38, 68055], [42, 68335], [44, 68775], [52, 69655], [57, 69955], [59, 70115], [62, 70175], [68, 70435], [72, 70655], [75, 70775], [83, 71610], [86, 71850], [91, 72170], [95, 72450], [98, 72790], [102, 73130], [105, 73510], [112, 73990], [115, 74370], [123, 74810], [129, 75010]]}, {"verse": 10, "start": 75880, "end": 82479, "text": "Y vueltos a casa los que habían sido enviados, hallaron sano al siervo que había estado enfermo.", "words": [[0, 75880], [2, 76023], [10, 76583], [12, 76703], [17, 77023], [21, 77263], [25, 77423], [32, 77643], [37, 77983], [47, 78943], [56, 79543], [61, 80043], [64, 80343], [71, 80903], [75, 81083], [81, 81283], [88, 81663]]}, {"verse": 11, "start": 82829, "end": 91416, "text": "Y aconteció después, que él iba a la ciudad que se llama Naín, e iban con él muchos de sus discípulos, y una gran multitud.", "words": [[0, 82829], [2, 82973], [12, 83673], [21, 83953], [25, 84273], [28, 84453], [32, 84653], [34, 84793], [37, 84833], [44, 85133], [48, 85433], [51, 85573], [57, 86193], [63, 86813], [65, 86873], [70, 87173], [74, 87373], [77, 87573], [84, 87953], [87, 88153], [91, 88333], [103, 89573], [105, 89913], [109, 90093], [114, 90493]]}, {"verse": 12, "start": 91766, "end": 104552, "text": "Y cuando llegó cerca de la puerta de la ciudad, he aquí que sacaban fuera a un difunto, único hijo de su madre, la cual también era viuda: y había con ella una gran multitud de la ciudad.", "words": [[0, 91766], [2, 91873], [9, 92113], [15, 92453], [21, 92833], [24, 93073], [27, 93213], [34, 93473], [37, 93713], [40, 93833], [48, 94853], [51, 95193], [56, 95433], [60, 95913], [68, 96393], [74, 96573], [76, 96893], [79, 97013], [88, 97613], [94, 98073], [99, 98513], [102, 98733], [105, 98873], [112, 99593], [115, 99713], [120, 99913], [128, 100293], [132, 100673], [139, 101494], [141, 101637], [147, 101837], [151, 102117], [156, 102317], [160, 102537], [165, 102797], [174, 103577], [177, 103797], [180, 103917]]}, {"verse": 13, "start": 104902, "end": 109929, "text": "Y como el Señor la vio, se compadeció de ella, y le dice: No llores.", "words": [[0, 104902], [2, 104989], [7, 105189], [10, 105349], [16, 105589], [19, 105829], [24, 106429], [27, 106589], [38, 107409], [41, 107569], [47, 107849], [49, 108349], [52, 108489], [58, 109474], [61, 109738]]}, {"verse": 14, "start": 110279, "end": 117322, "text": "Y acercándose, tocó el féretro: y los que lo llevaban, pararon. Y dice: Joven, a ti digo, levántate.", "words": [[0, 110279], [2, 110380], [15, 111140], [20, 111680], [23, 111820], [32, 112676], [34, 112805], [38, 112945], [42, 113075], [45, 113205], [55, 113805], [64, 114267], [66, 114410], [72, 115119], [79, 115745], [81, 115845], [84, 115945], [90, 116245]]}, {"verse": 15, "start": 117672, "end": 123570, "text": "Entonces se incorporó el que había muerto, y comenzó a hablar. Y le dio a su madre.", "words": [[0, 117672], [9, 118236], [12, 118616], [22, 119066], [25, 119516], [29, 119656], [35, 119876], [43, 120654], [45, 120894], [53, 121454], [55, 121574], [63, 122271], [65, 122355], [68, 122475], [72, 122715], [74, 122875], [77, 122995]]}, {"verse": 16, "start": 123920, "end": 133468, "text": "Y todos tuvieron miedo, y glorificaban a Dios, diciendo: Que un gran profeta se ha levantado entre nosotros; y que Dios ha visitado a su pueblo.", "words": [[0, 123920], [2, 124045], [8, 124325], [17, 124925], [24, 125385], [26, 125650], [39, 126490], [41, 126630], [47, 127250], [57, 128172], [61, 128767], [64, 128894], [69, 129074], [77, 129574], [80, 129774], [83, 129854], [93, 130394], [99, 130574], [109, 131572], [111, 131676], [115, 131776], [120, 132036], [123, 132276], [132, 132756], [134, 132836], [137, 132936]]}, {"verse": 17, "start": 133748, "end": 139157, "text": "Y salió esta fama de él por toda Judea, y por toda la tierra de alrededor.", "words": [[0, 133748], [2, 133875], [8, 134295], [13, 134595], [18, 134995], [21, 135115], [24, 135275], [28, 135495], [33, 135735], [40, 136515], [42, 136895], [46, 137115], [51, 137515], [54, 137715], [61, 138095], [64, 138335]]}, {"verse": 18, "start": 139507, "end": 145917, "text": "Y sus discípulos informaron a Juan de todas estas cosas: y llamó Juan a dos de sus discípulos,", "words": [[0, 139507], [2, 139614], [6, 139754], [17, 140414], [28, 141174], [30, 141354], [35, 141614], [38, 141854], [44, 142114], [50, 142454], [57, 143418], [59, 143524], [65, 143804], [70, 144024], [72, 144324], [76, 144544], [79, 144704], [83, 144904]]}, {"verse": 19, "start": 146267, "end": 152041, "text": "Y envió a Jesús, diciendo: ¿Eres tú aquel que había de venir, o esperaremos a otro?", "words": [[0, 146267], [2, 146432], [8, 146852], [10, 147132], [17, 147572], [27, 148946], [33, 149164], [36, 149404], [42, 149764], [46, 149864], [52, 150064], [55, 150224], [62, 150504], [64, 150844], [76, 151424], [78, 151664]]}, {"verse": 20, "start": 152321, "end": 162195, "text": "Y como los hombres vinieron a él, dijeron: Juan el Bautista nos ha enviado a ti, diciendo: ¿Eres tú aquel que había de venir, o esperaremos a otro?", "words": [[0, 152321], [2, 152446], [7, 152686], [11, 152886], [19, 153306], [28, 153886], [30, 154086], [34, 154626], [43, 155581], [48, 156098], [51, 156138], [60, 156858], [64, 156978], [67, 157158], [75, 157618], [77, 157738], [81, 157898], [91, 159100], [97, 159317], [100, 159557], [106, 159917], [110, 160017], [116, 160217], [119, 160377], [126, 160657], [128, 160997], [140, 161577], [142, 161817]]}, {"verse": 21, "start": 162475, "end": 170708, "text": "Y en la misma hora sanó a muchos de enfermedades y plagas, y de espíritus malos; y a muchos ciegos dio la vista.", "words": [[0, 162475], [2, 162621], [5, 162721], [8, 162841], [14, 163101], [19, 163521], [24, 164041], [26, 164161], [33, 164441], [36, 164721], [49, 165581], [51, 165761], [59, 166601], [61, 166781], [64, 166921], [74, 167461], [81, 168349], [83, 168474], [85, 168514], [92, 168774], [99, 169574], [103, 169894], [106, 170054]]}, {"verse": 22, "start": 171058, "end": 190139, "text": "Y respondiendo Jesús, les dijo: Id, dad las nuevas a Juan de lo que habéis visto y oído: que los ciegos ven, los cojos andan, los leprosos son limpiados, los sordos oyen, los muertos resucitan, a los pobres es anunciado el evangelio:", "words": [[0, 171058], [2, 171166], [15, 171866], [22, 172306], [26, 172886], [32, 173718], [36, 173828], [40, 174208], [44, 174608], [51, 175008], [53, 175248], [58, 175548], [61, 176188], [64, 176308], [68, 176448], [75, 176788], [81, 177248], [83, 177668], [89, 178500], [93, 178582], [97, 178742], [104, 179242], [109, 180202], [113, 180322], [119, 180782], [126, 181822], [130, 181942], [139, 182522], [143, 182842], [154, 183922], [158, 184022], [165, 184662], [171, 185642], [175, 185762], [183, 186282], [194, 187482], [196, 187522], [200, 187662], [207, 188142], [210, 188422], [220, 189182], [223, 189302]]}, {"verse": 23, "start": 190489, "end": 193276, "text": "Y dichoso es el que no halle tropiezo en mí.", "words": [[0, 190489], [2, 190634], [10, 191154], [13, 191374], [16, 191494], [20, 191674], [23, 191894], [29, 192114], [38, 192794], [41, 192914]]}, {"verse": 24, "start": 193626, "end": 204751, "text": "Y como se fueron los mensajeros de Juan, comenzó a hablar de Juan a la gente: ¿Qué salisteis a ver al desierto? ¿una caña que es agitada por el viento?", "words": [[0, 193626], [2, 193767], [7, 194047], [10, 194267], [17, 194627], [21, 194867], [32, 195647], [35, 195807], [41, 196627], [49, 197327], [51, 197427], [58, 197627], [61, 197827], [66, 198087], [68, 198247], [71, 198307], [78, 199224], [83, 199328], [93, 200028], [95, 200188], [99, 200328], [102, 200468], [112, 201520], [117, 201900], [122, 202420], [126, 202880], [129, 203080], [137, 203740], [141, 203960], [144, 204100]]}, {"verse": 25, "start": 205101, "end": 216242, "text": "Pero ¿qué salisteis a ver? ¿un hombre cubierto de vestidos delicados? He aquí, los que están en vestido precioso, y viven en delicias, en los palacios de los reyes están.", "words": [[0, 205101], [5, 205284], [10, 205684], [20, 206264], [22, 206404], [27, 207002], [31, 207149], [38, 207429], [47, 208129], [50, 208289], [59, 208769], [70, 209840], [73, 209998], [79, 210298], [83, 210478], [87, 210618], [93, 210818], [96, 210998], [104, 211378], [114, 212078], [116, 212578], [122, 212978], [125, 213078], [135, 213638], [138, 214238], [142, 214358], [151, 214918], [154, 215038], [158, 215328], [164, 215618]]}, {"verse": 26, "start": 216592, "end": 221880, "text": "Pero ¿qué salisteis a ver? ¿un profeta? También os digo, y aun más que profeta.", "words": [[0, 216592], [5, 216775], [10, 217175], [20, 217755], [22, 217895], [27, 218494], [31, 218642], [40, 219583], [48, 219807], [51, 220047], [57, 220347], [59, 220747], [63, 220887], [67, 221127], [71, 221247]]}, {"verse": 27, "start": 222230, "end": 230211, "text": "Este es de quien está escrito: He aquí, envío mi mensajero delante de tu faz, el cual preparará tu camino delante de ti.", "words": [[0, 222230], [5, 222474], [8, 222730], [11, 222986], [17, 223241], [22, 223497], [31, 223913], [34, 224101], [40, 224421], [46, 224921], [49, 225081], [59, 225781], [67, 226221], [70, 226381], [73, 226521], [78, 227441], [81, 227541], [86, 227801], [96, 228641], [99, 228801], [106, 229161], [114, 229721], [117, 229881]]}, {"verse": 28, "start": 230561, "end": 240310, "text": "Porque os digo que entre los nacidos de mujeres, no hay mayor profeta que Juan el Bautista: pero el más pequeño en el reino de los cielos es mayor que él.", "words": [[0, 230561], [7, 230803], [10, 231023], [15, 231303], [19, 231523], [25, 231763], [29, 231983], [37, 232503], [40, 232663], [49, 233123], [52, 233723], [56, 233883], [62, 234263], [70, 234883], [74, 235023], [79, 235283], [82, 235463], [92, 236529], [97, 236697], [100, 236837], [104, 236957], [112, 237397], [115, 237617], [118, 237757], [124, 238117], [127, 238217], [131, 238377], [138, 238817], [141, 238997], [147, 239617], [151, 239957]]}, {"verse": 29, "start": 240660, "end": 249700, "text": "Y todo el pueblo oyéndole, y los recaudadores de impuestos, reconocieron la justicia de Dios, bautizándose con el bautismo de Juan.", "words": [[0, 240660], [2, 240805], [7, 241065], [10, 241285], [17, 241645], [27, 242525], [29, 242740], [33, 242900], [46, 243680], [49, 243860], [60, 245180], [73, 245800], [76, 245960], [85, 246480], [88, 246640], [94, 247500], [107, 248340], [111, 248580], [114, 248700], [123, 249180], [126, 249320]]}, {"verse": 30, "start": 250050, "end": 258448, "text": "Pero los fariseos y los sabios de la ley, desecharon el consejo de Dios contra sí mismos, no siendo bautizados de él.", "words": [[0, 250050], [5, 250195], [9, 250375], [18, 251155], [20, 251295], [24, 251455], [31, 251955], [34, 252035], [37, 252175], [42, 252495], [53, 253715], [56, 253895], [64, 254555], [67, 254675], [72, 254895], [79, 255295], [82, 255495], [90, 256415], [93, 256655], [100, 256955], [111, 257775], [114, 258055]]}, {"verse": 31, "start": 258798, "end": 266214, "text": "Y dice el Señor: ¿A quién, pues, compararé los hombres de esta generación, y a qué son semejantes?", "words": [[0, 258798], [2, 258922], [7, 259222], [10, 259402], [17, 260276], [20, 260401], [27, 260641], [33, 261341], [43, 262101], [47, 262261], [55, 262641], [58, 262941], [63, 263161], [75, 264521], [77, 264661], [79, 264781], [83, 264881], [87, 265121]]}, {"verse": 32, "start": 266564, "end": 280492, "text": "Semejantes son a los muchachos sentados en la plaza, y que dan voces los unos a los otros, y dicen: Tocamos flautas para vosotros, y no bailasteis: os cantamos lamentos, y no llorasteis.", "words": [[0, 266564], [11, 267247], [15, 267507], [17, 267627], [21, 267747], [31, 268347], [40, 268947], [43, 269167], [46, 269307], [53, 269807], [55, 270154], [59, 270500], [63, 270847], [69, 271407], [73, 271607], [78, 271987], [80, 272347], [84, 272527], [91, 272907], [93, 273427], [100, 274305], [108, 274688], [116, 275248], [121, 275428], [131, 275988], [133, 276308], [136, 276468], [148, 277816], [151, 277966], [160, 278526], [170, 279046], [172, 279346], [175, 279526]]}, {"verse": 33, "start": 280842, "end": 286797, "text": "Porque vino Juan el Bautista, que ni comía pan, ni bebía vino, y decís: Demonio tiene.", "words": [[0, 280842], [7, 281046], [12, 281306], [17, 281826], [20, 281926], [30, 282646], [34, 282726], [37, 282866], [43, 283186], [48, 283866], [51, 284146], [57, 284506], [63, 284786], [65, 285006], [72, 285797], [80, 286302]]}, {"verse": 34, "start": 287147, "end": 297990, "text": "Vino el Hijo del hombre, que come y bebe, y decís: He aquí un hombre comilón, y bebedor de vino, amigo de recaudadores de impuestos y de pecadores.", "words": [[0, 287147], [5, 287432], [8, 287592], [13, 287812], [17, 287992], [25, 288332], [29, 288832], [34, 289272], [36, 289532], [42, 289872], [44, 290032], [51, 290981], [54, 291256], [59, 291516], [62, 291676], [69, 291936], [78, 292676], [80, 293136], [88, 293616], [91, 293756], [97, 294436], [103, 294816], [106, 295036], [119, 295876], [122, 296096], [132, 296756], [134, 296956], [137, 297076]]}, {"verse": 35, "start": 298340, "end": 301560, "text": "Pero la sabiduría es justificada de todos sus hijos.", "words": [[0, 298340], [5, 298485], [8, 298665], [18, 299365], [21, 299465], [33, 300265], [36, 300445], [42, 300645], [46, 300985]]}, {"verse": 36, "start": 301910, "end": 309416, "text": "Y le rogó uno de los fariseos, que comiese con él. Y entrado en casa del fariseo, se sentó a la mesa.", "words": [[0, 301910], [2, 302036], [5, 302156], [10, 302596], [14, 302796], [17, 302936], [21, 303056], [31, 303896], [35, 304316], [43, 304756], [47, 305016], [51, 305575], [53, 305853], [61, 306493], [64, 306653], [69, 306953], [73, 307213], [82, 308053], [85, 308293], [91, 308733], [93, 308813], [96, 308913]]}, {"verse": 37, "start": 309766, "end": 320599, "text": "Y he aquí una mujer que había sido pecadora en la ciudad, como entendió que estaba a la mesa en casa de aquel fariseo, trajo un frasco de alabastro con ungüento,", "words": [[0, 309766], [2, 309943], [5, 310103], [10, 310463], [14, 310763], [20, 311183], [24, 311423], [30, 311663], [35, 312023], [44, 312683], [47, 312843], [50, 312963], [58, 314023], [63, 314343], [72, 314863], [76, 315003], [83, 315323], [85, 315543], [88, 315603], [93, 315883], [96, 316083], [101, 316443], [104, 316663], [110, 316943], [119, 317894], [125, 318218], [128, 318358], [135, 318878], [138, 319018], [148, 319618], [152, 320137]]}, {"verse": 38, "start": 320949, "end": 332585, "text": "Y estando detrás a sus pies, comenzó llorando a regar con lágrimas sus pies, y los limpiaba con los cabellos de su cabeza; y besaba sus pies, y los ungía con el perfume.", "words": [[0, 320949], [2, 321075], [10, 321635], [17, 322155], [19, 322295], [23, 322495], [29, 322775], [37, 323470], [46, 323970], [48, 324070], [54, 324470], [58, 324570], [67, 325210], [71, 325450], [77, 325730], [79, 326230], [83, 326370], [92, 327090], [96, 327330], [100, 327490], [109, 328010], [112, 328110], [115, 328250], [123, 329235], [125, 329342], [132, 329722], [136, 329922], [142, 330242], [144, 330577], [148, 330757], [154, 331477], [158, 331717], [161, 331837]]}, {"verse": 39, "start": 332935, "end": 345201, "text": "Y cuando vio esto el fariseo que le había invitado, habló entre sí, diciendo: Este, si fuera profeta, conocería quién y cuál es la mujer que le toca, que es pecadora.", "words": [[0, 332935], [2, 333038], [9, 333278], [13, 333698], [18, 334018], [21, 334178], [29, 334898], [33, 335038], [36, 335198], [42, 335418], [52, 336318], [58, 337098], [64, 337458], [68, 338358], [78, 339304], [84, 339624], [87, 339824], [93, 340104], [102, 341124], [112, 341764], [118, 342004], [120, 342184], [125, 342464], [128, 342744], [131, 342884], [137, 343204], [141, 343404], [144, 343524], [150, 344304], [154, 344364], [157, 344524]]}, {"verse": 40, "start": 345481, "end": 353462, "text": "Entonces respondiendo Jesús, le dijo: Simón, una cosa tengo que decirte. Y él dice: Di, Maestro.", "words": [[0, 345481], [9, 346363], [22, 347006], [29, 347906], [32, 348006], [38, 348763], [45, 349600], [49, 349780], [54, 350060], [60, 350400], [64, 350620], [73, 351636], [75, 351842], [78, 351982], [84, 352738], [88, 352828]]}, {"verse": 41, "start": 353742, "end": 360343, "text": "Un acreedor tenía dos deudores: el uno le debía quinientos denarios, y el otro cincuenta;", "words": [[0, 353975], [3, 354241], [12, 354508], [18, 354988], [22, 355408], [32, 356637], [35, 356814], [39, 357024], [42, 357184], [48, 357704], [59, 358224], [69, 358744], [71, 359044], [74, 359204], [79, 359802]]}, {"verse": 42, "start": 360693, "end": 367455, "text": "Y no teniendo ellos de qué pagar, perdonó a ambos. Di, pues, ¿cuál de estos le amará más?", "words": [[0, 360693], [2, 360993], [5, 361153], [14, 361693], [20, 361953], [23, 362213], [27, 362313], [34, 363113], [42, 363853], [44, 363993], [51, 364831], [55, 365271], [61, 365731], [67, 366131], [70, 366251], [76, 366471], [79, 366731], [85, 366971]]}, {"verse": 43, "start": 367805, "end": 375465, "text": "Y respondiendo Simón, dijo: Pienso que aquel al cual perdonó más. Y él le dijo: Rectamente has juzgado.", "words": [[0, 367805], [2, 367932], [15, 368672], [22, 369192], [28, 370051], [35, 370348], [39, 370488], [45, 370768], [48, 370908], [53, 371068], [61, 371568], [66, 372528], [68, 372733], [71, 372873], [74, 373033], [80, 374000], [91, 374274], [95, 374547]]}, {"verse": 44, "start": 375815, "end": 387749, "text": "Y vuelto a la mujer, dijo a Simón: ¿Ves esta mujer? Entré en tu casa, no diste agua para mis pies; pero esta ha regado mis pies con lágrimas, y los ha limpiado con los cabellos.", "words": [[0, 375815], [2, 375938], [9, 376278], [11, 376358], [14, 376418], [21, 377038], [26, 377338], [28, 377518], [35, 378346], [40, 378476], [45, 378616], [52, 379492], [58, 379935], [61, 380015], [64, 380135], [70, 380468], [73, 380802], [79, 381135], [84, 381455], [89, 381715], [93, 381875], [99, 382700], [104, 382848], [109, 383228], [112, 383368], [119, 383848], [123, 384028], [128, 384308], [132, 384588], [142, 385368], [144, 385570], [148, 385773], [151, 385933], [160, 386573], [164, 386793], [168, 387292]]}, {"verse": 45, "start": 388099, "end": 394540, "text": "No me diste beso, pero esta, desde que entré, no ha cesado de besar mis pies.", "words": [[0, 388099], [3, 388227], [6, 388367], [12, 388687], [18, 389387], [23, 389607], [29, 390487], [35, 390807], [39, 391127], [46, 392087], [49, 392287], [52, 392427], [59, 392927], [62, 393107], [68, 393547], [72, 393707]]}, {"verse": 46, "start": 394890, "end": 400275, "text": "No ungiste mi cabeza con aceite; pero esta ha ungido con perfume mis pies.", "words": [[0, 394890], [3, 395097], [11, 395557], [14, 395757], [21, 396117], [25, 396457], [33, 397247], [38, 397666], [43, 397986], [46, 398306], [53, 398626], [57, 398906], [65, 399406], [69, 399666]]}, {"verse": 47, "start": 400625, "end": 408651, "text": "Por lo cual te digo que sus muchos pecados son perdonados, porque amó mucho; pero al que se perdona poco, poco ama.", "words": [[0, 400625], [4, 400729], [7, 400849], [12, 401049], [15, 401249], [20, 401529], [24, 401689], [28, 401869], [35, 402229], [43, 402789], [47, 403009], [59, 404229], [66, 404689], [70, 405169], [77, 405913], [82, 406106], [85, 406336], [89, 406476], [92, 406656], [100, 407176], [106, 407516], [111, 408116]]}, {"verse": 48, "start": 409001, "end": 412323, "text": "Y a ella dijo: Los pecados te son perdonados.", "words": [[0, 409001], [2, 409168], [4, 409248], [9, 409448], [15, 410346], [19, 410453], [27, 410953], [30, 411093], [34, 411293]]}, {"verse": 49, "start": 412673, "end": 420088, "text": "Y los que estaban juntamente sentados a la mesa, comenzaron a decir entre sí: ¿Quién es este, que también perdona pecados?", "words": [[0, 412673], [2, 412763], [6, 412883], [10, 413023], [18, 413403], [29, 414263], [38, 415023], [40, 415183], [43, 415283], [49, 415523], [60, 416363], [62, 416483], [68, 416803], [74, 417123], [78, 417779], [85, 418001], [88, 418141], [94, 418361], [98, 418521], [106, 418881], [114, 419321]]}, {"verse": 50, "start": 420368, "end": 424057, "text": "Y dijo a la mujer: Tu fe te ha salvado, ve en paz.", "words": [[0, 420368], [2, 420516], [7, 420816], [9, 420936], [12, 421016], [19, 421791], [22, 421873], [25, 422073], [28, 422233], [31, 422333], [40, 423253], [43, 423413], [46, 423573]]}]}