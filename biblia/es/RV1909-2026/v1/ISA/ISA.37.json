{"book": "ISA", "chapter": 37, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 382500, "verses": [{"verse": 1, "start": 300, "end": 9323, "text": "Aconteció pues, que el rey Ezequías, oído esto, rasgó sus vestidos, y cubierto de saco vino a la casa de Jehová.", "words": [[0, 300], [10, 1126], [16, 1966], [20, 2086], [23, 2286], [27, 2766], [37, 3766], [42, 4086], [48, 4826], [54, 5566], [58, 5746], [68, 6326], [70, 6486], [79, 7086], [82, 7266], [87, 7706], [92, 7886], [94, 8066], [97, 8146], [102, 8446], [105, 8666]]}, {"verse": 2, "start": 9773, "end": 20319, "text": "Y envió a Eliaquim mayordomo, y a Sebna escriba, y a los ancianos de los sacerdotes, cubiertos de sacos, a Isaías profeta, hijo de Amoz.", "words": [[0, 9773], [2, 9915], [8, 10355], [10, 10815], [19, 11275], [30, 12635], [32, 12715], [34, 12795], [40, 13335], [49, 14415], [51, 14475], [53, 14495], [57, 14675], [66, 15255], [69, 15355], [73, 15495], [85, 16875], [95, 17315], [98, 17415], [105, 18015], [107, 18235], [114, 18875], [123, 19495], [128, 19635], [131, 19977]]}, {"verse": 3, "start": 20769, "end": 31676, "text": "Los cuales le dijeron: Ezequías dice así: Día de angustia, de reprensión y de blasfemia, es este día: porque los hijos han llegado al punto de nacer, y la que da a luz no tiene fuerzas.", "words": [[0, 20769], [4, 20969], [11, 21190], [14, 21429], [23, 22312], [32, 22858], [37, 23138], [42, 23909], [46, 24192], [49, 24292], [59, 24932], [62, 24972], [73, 25572], [75, 25712], [78, 25792], [89, 26512], [92, 26652], [97, 26832], [102, 27529], [109, 27690], [113, 27910], [119, 28130], [123, 28370], [131, 28690], [134, 28810], [140, 29050], [143, 29230], [150, 29650], [152, 29930], [155, 30050], [159, 30210], [162, 30370], [164, 30450], [168, 30550], [171, 30770], [177, 30990]]}, {"verse": 4, "start": 32126, "end": 48984, "text": "Quizá oirá Jehová tu Dios las palabras de Rabsaces, al cual envió el rey de Asiria su señor a blasfemar al Dios vivo, y a reprender con las palabras que oyó Jehová tu Dios: alza pues oración tú por las reliquias que aún han quedado.", "words": [[0, 32371], [6, 32625], [11, 32878], [18, 33128], [21, 33378], [26, 33638], [30, 33938], [39, 34318], [42, 34988], [52, 35658], [55, 35758], [60, 35958], [66, 36358], [69, 36498], [73, 36778], [76, 37048], [83, 37318], [86, 37438], [92, 37778], [94, 37998], [104, 38618], [107, 38738], [112, 38918], [118, 39928], [120, 40035], [122, 40095], [132, 40555], [136, 40735], [140, 40895], [149, 41315], [153, 41595], [157, 41915], [164, 42315], [167, 42415], [173, 43192], [178, 43554], [183, 43794], [191, 44474], [194, 44854], [198, 45114], [202, 45294], [212, 45834], [216, 45974], [220, 46174], [224, 46354]]}, {"verse": 5, "start": 49334, "end": 52620, "text": "Vinieron pues los siervos de Ezequías a Isaías.", "words": [[0, 49334], [9, 49761], [14, 49981], [18, 50201], [26, 50681], [29, 50841], [38, 51461], [40, 51701]]}, {"verse": 6, "start": 53070, "end": 64497, "text": "Y les dijo Isaías: Diréis así a vuestro señor: Así dice Jehová: No temas por las palabras que has oído, con las cuales me han blasfemado los siervos del rey de Asiria.", "words": [[0, 53070], [2, 53199], [6, 53299], [11, 53619], [19, 54966], [26, 55366], [30, 55626], [32, 55846], [40, 56186], [47, 57397], [51, 57710], [56, 58024], [64, 58557], [67, 58697], [73, 59037], [77, 59317], [81, 59477], [90, 59857], [94, 60097], [98, 60257], [104, 61137], [108, 61217], [112, 61377], [119, 61697], [122, 62037], [126, 62377], [137, 62717], [141, 62857], [149, 63277], [153, 63477], [157, 63677], [160, 63837]]}, {"verse": 7, "start": 65183, "end": 72981, "text": "He aquí que yo doy en él un espíritu, y oirá un rumor, y se volverá a su tierra: y yo haré que en su tierra caiga a espada.", "words": [[0, 65233], [3, 65323], [8, 65563], [12, 65763], [15, 65923], [19, 66076], [22, 66230], [25, 66383], [28, 66503], [38, 67423], [40, 67583], [45, 67863], [48, 67963], [55, 68323], [57, 68783], [60, 68903], [68, 69383], [70, 69383], [73, 69543], [81, 70643], [83, 70781], [86, 70921], [91, 71221], [95, 71301], [98, 71381], [101, 71521], [108, 71801], [114, 72041], [116, 72281]]}, {"verse": 8, "start": 73569, "end": 81535, "text": "Vuelto pues Rabsaces, halló al rey de Asiria que batía a Libna; porque ya había oído que se había apartado de Laquis.", "words": [[0, 73569], [7, 73994], [12, 74667], [22, 75341], [28, 76014], [31, 76194], [35, 76494], [38, 76754], [45, 77014], [49, 77154], [55, 77554], [57, 77714], [64, 78491], [71, 78675], [74, 78935], [80, 79115], [85, 79435], [89, 79615], [92, 79775], [98, 79995], [107, 80695], [110, 81147]]}, {"verse": 9, "start": 81985, "end": 92997, "text": "Mas oyendo decir de Tirhaca rey de Etiopía: He aquí que ha salido para hacerte guerra: en oyéndolo, envió mensajeros a Ezequías, diciendo:", "words": [[0, 81985], [4, 82192], [11, 82732], [17, 83332], [20, 83802], [28, 84272], [32, 84732], [35, 84832], [44, 86186], [47, 86331], [52, 86611], [56, 86751], [59, 86871], [66, 87251], [71, 87511], [79, 87971], [87, 89351], [90, 89785], [100, 90218], [106, 90518], [117, 91198], [119, 91398], [129, 92058]]}, {"verse": 10, "start": 93247, "end": 102362, "text": "Diréis así a Ezequías rey de Judá: No te engañe tu Dios en quien tú confías, diciendo: Jerusalén no será entregada en mano del rey de Asiria.", "words": [[0, 93247], [7, 93631], [11, 93871], [13, 94051], [22, 94591], [26, 94811], [29, 94971], [35, 95785], [38, 95909], [41, 96069], [48, 96529], [51, 96609], [56, 96929], [59, 97229], [65, 97369], [68, 97609], [77, 98149], [87, 99192], [97, 99833], [100, 99973], [105, 100173], [115, 100813], [118, 100953], [123, 101173], [127, 101393], [131, 101673], [134, 101753]]}, {"verse": 11, "start": 102812, "end": 109385, "text": "He aquí que tú oíste lo que hicieron los reyes de Asiria a todas las tierras, que las destruyeron; ¿y escaparás tú?", "words": [[0, 102812], [3, 102954], [8, 103214], [12, 103394], [15, 103594], [21, 104034], [24, 104194], [28, 104314], [37, 104694], [41, 104874], [47, 105234], [50, 105394], [57, 105874], [59, 105994], [65, 106134], [69, 106414], [78, 106874], [82, 107034], [86, 107194], [99, 108318], [102, 108420], [112, 109040]]}, {"verse": 12, "start": 109835, "end": 118595, "text": "¿Libraron los dioses de las naciones a los que destruyeron mis antepasados, a Gozán, y Harán, Resef, y a los hijos de Edén que moraban en Telasar?", "words": [[0, 109835], [10, 110255], [14, 110455], [21, 110835], [24, 110995], [28, 111155], [37, 111675], [39, 111875], [43, 111975], [47, 112095], [59, 112755], [63, 112895], [76, 113428], [78, 113962], [85, 114495], [87, 115028], [94, 115562], [101, 116095], [103, 116415], [105, 116495], [109, 116595], [115, 116855], [118, 117095], [123, 117295], [127, 117475], [135, 117868], [138, 118262]]}, {"verse": 13, "start": 119045, "end": 125546, "text": "¿Dónde está el rey de Hamat, y el rey de Arfad, el rey de la ciudad de Sefarvaim, de Hena, y de Hivah?", "words": [[0, 119045], [7, 119363], [12, 119603], [15, 119743], [19, 119943], [22, 120193], [29, 120443], [31, 120803], [34, 120903], [38, 121163], [41, 121223], [48, 122103], [51, 122223], [55, 122483], [58, 122543], [61, 122643], [68, 122923], [71, 123613], [82, 124303], [85, 124553], [91, 124803], [93, 124983], [96, 125293]]}, {"verse": 14, "start": 125896, "end": 135417, "text": "Y tomó Ezequías las cartas de mano de los mensajeros, y las leyó; y subió a la casa de Jehová, y las extendió delante de Jehová.", "words": [[0, 125896], [2, 126022], [7, 126572], [16, 127122], [20, 127322], [27, 127982], [30, 128162], [35, 128422], [38, 128622], [42, 128742], [54, 129482], [56, 129722], [60, 129902], [66, 130744], [68, 130874], [74, 131334], [76, 131514], [79, 131594], [84, 131894], [87, 132094], [95, 132674], [97, 133054], [101, 133214], [110, 134034], [118, 134554], [121, 134714]]}, {"verse": 15, "start": 135867, "end": 139394, "text": "Entonces Ezequías oró a Jehová, diciendo:", "words": [[0, 135867], [9, 136594], [18, 137714], [22, 138034], [24, 138314], [32, 138714]]}, {"verse": 16, "start": 139644, "end": 150660, "text": "Jehová de los ejércitos, Dios de Israel, que moras entre los querubines, sólo tú eres Dios sobre todos los reinos de la tierra; tú hiciste los cielos y la tierra.", "words": [[0, 139644], [7, 140054], [10, 140134], [14, 140274], [25, 141014], [30, 141374], [33, 141474], [41, 142214], [45, 142234], [51, 142694], [57, 142914], [61, 143134], [73, 144174], [78, 144534], [81, 144834], [86, 145054], [91, 145374], [97, 145734], [103, 146034], [107, 146314], [114, 146754], [117, 146854], [120, 146974], [128, 147882], [131, 148022], [139, 148542], [143, 148702], [150, 149222], [152, 149342], [155, 149462]]}, {"verse": 17, "start": 151110, "end": 161518, "text": "Inclina, oh Jehová, tu oído, y oye; abre, oh Jehová, tus ojos, y mira: y oye todas las palabras de Senaquerib, el cual ha enviado a blasfemar al Dios viviente.", "words": [[0, 151110], [9, 151463], [12, 151857], [20, 152250], [23, 152430], [29, 152850], [31, 153070], [36, 153877], [42, 154172], [45, 154506], [53, 154839], [57, 155059], [63, 155379], [65, 155659], [71, 156374], [73, 156534], [77, 156774], [83, 156954], [87, 157274], [96, 157654], [99, 158254], [111, 158854], [114, 158974], [119, 159194], [122, 159374], [130, 159834], [132, 159934], [142, 160454], [145, 160594], [150, 160754]]}, {"verse": 18, "start": 161968, "end": 167555, "text": "Ciertamente, oh Jehová, los reyes de Asiria destruyeron todas las tierras y sus comarcas,", "words": [[0, 161968], [13, 162763], [16, 162943], [24, 163843], [28, 163943], [34, 164343], [37, 164463], [44, 164943], [56, 165583], [62, 165783], [66, 166063], [74, 166483], [76, 166623], [80, 166743]]}, {"verse": 19, "start": 168005, "end": 176302, "text": "Y entregaron los dioses de ellos al fuego: porque no eran dioses, sino obra de manos de hombre, leño y piedra: por eso los deshicieron.", "words": [[0, 168005], [2, 168092], [13, 168632], [17, 168752], [24, 169112], [27, 169312], [33, 169532], [36, 169772], [43, 170613], [50, 170804], [53, 171024], [58, 171184], [66, 171984], [71, 172164], [76, 172484], [79, 172644], [85, 172904], [88, 173124], [96, 173724], [101, 174044], [103, 174164], [111, 174987], [115, 175106], [119, 175286], [123, 175486]]}, {"verse": 20, "start": 176752, "end": 184355, "text": "Ahora pues, Jehová Dios nuestro, líbranos de su mano, para que todos los reinos de la tierra conozcan que sólo tú eres Jehová.", "words": [[0, 176752], [6, 177008], [12, 177608], [19, 177908], [24, 178068], [33, 179128], [42, 179488], [45, 179708], [48, 179848], [54, 180168], [59, 180668], [63, 180828], [69, 181048], [73, 181308], [80, 181628], [83, 181788], [86, 181908], [93, 182168], [102, 182788], [106, 182948], [111, 183228], [114, 183528], [119, 183768]]}, {"verse": 21, "start": 184705, "end": 196799, "text": "Entonces Isaías hijo de Amoz, envió a decir a Ezequías: Jehová Dios de Israel dice así: Acerca de lo que me rogaste sobre Senaquerib rey de Asiria,", "words": [[0, 184705], [9, 185168], [16, 186468], [21, 186608], [24, 186968], [30, 187328], [36, 187788], [38, 188008], [44, 188368], [46, 188688], [56, 190263], [63, 190577], [68, 190890], [71, 190990], [78, 191690], [83, 191870], [88, 192583], [95, 193019], [98, 193299], [101, 193399], [105, 193539], [108, 193679], [116, 194199], [122, 194779], [133, 195359], [137, 195939], [140, 196119]]}, {"verse": 22, "start": 197384, "end": 207876, "text": "Esto es lo que Jehová habló de él: Te ha menospreciado, y ha hecho burla de ti la virgen hija de Sion: meneó su cabeza a tus espaldas la hija de Jerusalén.", "words": [[0, 197384], [5, 197692], [8, 197912], [11, 198012], [15, 198152], [22, 198652], [28, 199072], [31, 199232], [35, 199884], [38, 199968], [41, 200108], [56, 201028], [58, 201288], [61, 201408], [67, 201628], [73, 202028], [76, 202168], [79, 202448], [82, 202728], [89, 203148], [94, 203448], [97, 203548], [103, 204706], [109, 204876], [112, 204996], [119, 205436], [121, 205676], [125, 205816], [134, 206736], [137, 206836], [142, 207076], [145, 207156]]}, {"verse": 23, "start": 208576, "end": 217869, "text": "¿A quién injuriaste y a quién blasfemaste? ¿contra quién has alzado tu voz, y levantado tus ojos en alto? Contra el Santo de Israel.", "words": [[0, 208576], [3, 208796], [9, 208876], [20, 209596], [22, 209896], [24, 209956], [30, 210116], [43, 211548], [51, 211789], [57, 212156], [61, 212522], [68, 212889], [71, 213029], [76, 213429], [78, 213889], [88, 214489], [92, 214629], [97, 214969], [100, 215229], [106, 216307], [113, 216569], [116, 216729], [122, 217029], [125, 217449]]}, {"verse": 24, "start": 218558, "end": 237709, "text": "Por mano de tus siervos denostaste al Señor, y dijiste: Yo con la multitud de mis carros subiré a las alturas de los montes, a las laderas del Líbano; cortaré sus altos cedros, sus hayas escogidas; vendré después a lo alto de su límite, al monte de su Carmelo.", "words": [[0, 218558], [4, 218676], [9, 218916], [12, 219136], [16, 219276], [24, 219856], [35, 220796], [38, 220976], [45, 221596], [47, 221676], [56, 222870], [59, 223273], [63, 223393], [66, 223493], [75, 224053], [78, 224173], [82, 224313], [89, 225113], [96, 225613], [98, 225673], [102, 225793], [110, 226353], [113, 226513], [117, 226653], [125, 227493], [127, 227673], [131, 227813], [139, 228233], [143, 228433], [151, 229557], [159, 230022], [163, 230182], [169, 230802], [177, 231482], [181, 231792], [187, 232102], [198, 233499], [205, 233879], [213, 234239], [215, 234579], [218, 234679], [223, 234979], [226, 235139], [229, 235299], [237, 236199], [240, 236319], [246, 236659], [249, 236859], [252, 236999]]}, {"verse": 25, "start": 238388, "end": 245730, "text": "Yo cavé, y bebí las aguas; y con las pisadas de mis pies secaré todos los ríos de lugares atrincherados.", "words": [[0, 238388], [3, 238672], [9, 238992], [11, 239172], [16, 239512], [20, 239672], [27, 240839], [29, 240920], [33, 241060], [37, 241220], [45, 241700], [48, 241880], [52, 242040], [57, 242380], [64, 243260], [70, 243520], [74, 243840], [79, 244240], [82, 244340], [90, 244640]]}, {"verse": 26, "start": 246449, "end": 258936, "text": "¿No has oído decir que de mucho tiempo ha yo lo hice, que de días antiguos lo he formado? Lo he hecho venir ahora, y será para destrucción de ciudades fuertes en montones de ruinas.", "words": [[0, 246449], [4, 246569], [8, 246749], [13, 247069], [19, 247429], [23, 247649], [26, 247769], [32, 248009], [39, 248269], [42, 248529], [45, 248789], [48, 248909], [54, 249729], [58, 249849], [61, 249969], [66, 250189], [75, 250929], [78, 251049], [81, 251149], [90, 252351], [93, 252486], [96, 252626], [102, 252886], [108, 253166], [115, 253606], [117, 254226], [122, 254486], [127, 254786], [139, 255646], [142, 255806], [151, 256386], [159, 257346], [162, 257546], [171, 258086], [174, 258266]]}, {"verse": 27, "start": 259621, "end": 270549, "text": "Y sus habitantes, cortos de manos, quebrantados y confusos, serán como hierba del campo y hortaliza verde, como hierba de los tejados, que antes de sazón se seca.", "words": [[0, 259621], [2, 259719], [6, 259819], [18, 260419], [25, 261019], [28, 261119], [35, 262039], [48, 262679], [50, 262819], [60, 263779], [66, 264219], [71, 264419], [78, 264879], [82, 264999], [88, 265359], [90, 265639], [100, 266119], [107, 266779], [112, 267259], [119, 267739], [122, 267839], [126, 267959], [135, 268559], [139, 268959], [145, 269299], [148, 269479], [154, 269879], [157, 270019]]}, {"verse": 28, "start": 271226, "end": 276295, "text": "Conocido he tu estado, tu salida y tu entrada, y tu furor contra mí.", "words": [[0, 271226], [9, 271865], [12, 272005], [15, 272145], [23, 272965], [26, 273165], [33, 273785], [35, 273985], [38, 274085], [47, 274485], [49, 275065], [52, 275205], [58, 275605], [65, 275865]]}, {"verse": 29, "start": 276991, "end": 288571, "text": "Porque contra mí te airaste, y tu estruendo ha subido a mis oídos: pondré pues mi anzuelo en tu nariz, y mi freno en tus labios, y te haré volver por el camino por donde viniste.", "words": [[0, 276991], [7, 277193], [14, 277533], [17, 277793], [20, 278143], [29, 278493], [31, 278933], [34, 279053], [44, 279693], [47, 279933], [54, 280433], [56, 280513], [60, 280653], [67, 281868], [74, 282251], [79, 282511], [82, 282731], [90, 283251], [93, 283351], [96, 283471], [103, 283951], [105, 284271], [108, 284371], [114, 284771], [117, 284851], [121, 285011], [129, 285571], [131, 286011], [134, 286171], [139, 286371], [146, 286571], [150, 286891], [153, 287011], [160, 287371], [164, 287631], [170, 287831]]}, {"verse": 30, "start": 289271, "end": 301843, "text": "Y esto te será por señal: Comerás este año lo que nace de suyo, y el año segundo lo que nace de suyo: y el año tercero sembraréis y segaréis, y plantaréis viñas, y comeréis su fruto.", "words": [[0, 289271], [2, 289434], [7, 289634], [10, 289794], [15, 290034], [19, 290234], [26, 291343], [34, 291807], [39, 292147], [43, 292447], [46, 292627], [50, 292767], [55, 293047], [58, 293207], [64, 293667], [66, 294027], [69, 294147], [73, 294307], [81, 294727], [84, 294987], [88, 295107], [93, 295387], [96, 295507], [102, 296593], [104, 296693], [107, 296793], [111, 296953], [119, 297553], [130, 298213], [132, 298583], [142, 298953], [144, 299233], [155, 299833], [162, 300253], [164, 300613], [173, 301173], [176, 301293]]}, {"verse": 31, "start": 302541, "end": 309334, "text": "Y el residuo de la casa de Judá que haya escapado, volverá a echar raíces abajo y dará fruto arriba.", "words": [[0, 302541], [2, 302664], [5, 302764], [13, 303304], [16, 303384], [19, 303484], [24, 303784], [27, 303984], [32, 304364], [36, 304624], [41, 304844], [51, 306124], [59, 306644], [61, 306724], [67, 306964], [74, 307464], [80, 307864], [82, 308284], [87, 308544], [93, 308824]]}, {"verse": 32, "start": 310012, "end": 318105, "text": "Porque de Jerusalén saldrán reliquias, y del monte de Sion salvamento: el celo de Jehová de los ejércitos hará esto.", "words": [[0, 310012], [7, 310213], [10, 310373], [20, 311053], [28, 311593], [39, 312233], [41, 312633], [45, 312733], [51, 313033], [54, 313233], [59, 313553], [71, 314938], [74, 315055], [79, 315515], [82, 315615], [89, 316095], [92, 316175], [96, 316315], [106, 317035], [111, 317575]]}, {"verse": 33, "start": 318699, "end": 332456, "text": "Por tanto, así dice Jehová acerca del rey de Asiria: No entrará en esta ciudad, ni echará flecha en ella: no vendrá delante de ella escudo, ni será echado contra ella baluarte.", "words": [[0, 318699], [4, 318825], [11, 319245], [15, 319645], [20, 320245], [27, 320985], [34, 321365], [38, 321825], [42, 322245], [45, 322662], [53, 323285], [56, 323506], [64, 324066], [67, 324186], [72, 324386], [80, 324846], [83, 325396], [90, 325946], [97, 326366], [100, 326486], [106, 327447], [109, 327626], [116, 328046], [124, 328486], [127, 328626], [132, 328786], [140, 329546], [143, 329766], [148, 330026], [155, 330446], [162, 330726], [167, 331591]]}, {"verse": 34, "start": 333143, "end": 338654, "text": "Por el camino que vino se tornará, y no entrará en esta ciudad, dice Jehová:", "words": [[0, 333143], [4, 333282], [7, 333382], [14, 333702], [18, 333942], [23, 334162], [26, 334362], [35, 334903], [37, 335382], [40, 335562], [48, 336102], [51, 336242], [56, 336463], [64, 337635], [69, 337961]]}, {"verse": 35, "start": 338904, "end": 344415, "text": "Pues yo ampararé a esta ciudad para salvarla por amor de mí, y por amor de David mi siervo.", "words": [[0, 338904], [5, 339005], [8, 339285], [17, 339825], [19, 339925], [24, 340145], [31, 340525], [36, 340845], [45, 341465], [49, 341665], [54, 341845], [57, 342065], [61, 342225], [63, 342705], [67, 342885], [72, 343125], [75, 343305], [81, 343765], [84, 343865]]}, {"verse": 36, "start": 345025, "end": 357263, "text": "Y salió el ángel de Jehová, e hirió ciento ochenta y cinco mil en el campamento de los asirios: y cuando se levantaron por la mañana, he aquí que todo era cuerpos de muertos.", "words": [[0, 345025], [2, 345171], [8, 345531], [11, 345671], [17, 346051], [20, 346171], [28, 347011], [30, 347231], [36, 347678], [43, 348124], [51, 348571], [53, 349018], [59, 349464], [63, 349911], [66, 350151], [69, 350291], [80, 351111], [83, 351271], [87, 351791], [96, 352558], [98, 352624], [105, 352824], [108, 353024], [119, 353584], [123, 353804], [126, 353964], [134, 354904], [137, 355004], [142, 355284], [146, 355444], [151, 355684], [155, 355964], [163, 356444], [166, 356584]]}, {"verse": 37, "start": 357713, "end": 365816, "text": "Entonces Senaquerib rey de Asiria partiéndose se fue, y se volvió, e hizo su morada en Nínive.", "words": [[0, 357713], [9, 358410], [20, 359144], [24, 359877], [27, 360237], [34, 360917], [46, 361817], [49, 361917], [54, 362157], [56, 362657], [59, 362817], [67, 363417], [69, 363857], [74, 364177], [77, 364417], [84, 364897], [87, 365390]]}, {"verse": 38, "start": 366266, "end": 382100, "text": "Y aconteció, que estando orando en el templo de Nisroc su dios, Adramelec y Sarezer, sus hijos, le hirieron a espada, y huyeron a la tierra de Ararat; y reinó en su lugar Esar-hadón su hijo.", "words": [[0, 366266], [2, 366448], [13, 367188], [17, 367468], [25, 367908], [32, 368528], [35, 368688], [38, 368848], [45, 369408], [48, 369848], [55, 370288], [58, 370368], [64, 371188], [74, 372008], [76, 372348], [85, 372688], [89, 373028], [96, 373948], [99, 374228], [108, 374788], [110, 374928], [118, 375508], [120, 376048], [128, 376608], [130, 376688], [133, 376768], [140, 377088], [143, 377448], [151, 378357], [153, 378563], [159, 379483], [162, 379583], [165, 379743], [171, 380493], [182, 381243], [185, 381563]]}]}