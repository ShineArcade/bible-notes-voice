{"book": "GEN", "chapter": 25, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 282684, "verses": [{"verse": 1, "start": 300, "end": 4486, "text": "Y Abraham tomó otra mujer, cuyo nombre fue Cetura;", "words": [[0, 300], [2, 426], [10, 766], [15, 1426], [20, 1726], [27, 2206], [32, 3026], [39, 3346], [43, 3646]]}, {"verse": 2, "start": 4936, "end": 11884, "text": "La cual le parió a Zimram, y a Jocsán, y a Medan, y a Madián, y a Isbac, y a Sua.", "words": [[0, 4936], [3, 5216], [8, 5476], [11, 5776], [17, 6196], [19, 6816], [27, 7436], [29, 7456], [31, 7946], [39, 8436], [41, 8456], [43, 8536], [50, 9296], [52, 9356], [54, 9806], [62, 10256], [64, 10296], [66, 10356], [73, 11216], [75, 11216], [77, 11296]]}, {"verse": 3, "start": 12334, "end": 20376, "text": "Y Jocsán engendró a Seba, y a Dedán: e hijos de Dedán fueron Assurim, y Letusim, y Leumim.", "words": [[0, 12334], [2, 12633], [9, 12953], [18, 13533], [20, 13713], [26, 14193], [28, 14433], [30, 14533], [37, 15565], [39, 15735], [45, 16035], [48, 16255], [54, 16635], [61, 17262], [70, 17889], [72, 18516], [81, 19144], [83, 19771]]}, {"verse": 4, "start": 20826, "end": 29153, "text": "E hijos de Madián: Efa, y Efer, y Hanoc, y Abida, y Eldaa. Todos estos fueron hijos de Cetura.", "words": [[0, 20826], [2, 20952], [8, 21272], [11, 21739], [19, 22495], [24, 22909], [26, 23367], [32, 23824], [34, 24281], [41, 24739], [43, 25196], [50, 25653], [52, 26110], [59, 26838], [65, 27142], [71, 27462], [78, 27962], [84, 28282], [87, 28747]]}, {"verse": 5, "start": 29603, "end": 32991, "text": "Y Abraham dio todo cuanto tenía a Isaac.", "words": [[0, 29603], [2, 29892], [10, 30292], [14, 30652], [19, 30972], [26, 31352], [32, 31952], [34, 32272]]}, {"verse": 6, "start": 33441, "end": 45341, "text": "Y a los hijos de sus concubinas dio Abraham dones, y los envió de junto Isaac su hijo, mientras él vivía, hacia el oriente, a la tierra oriental.", "words": [[0, 33441], [2, 33567], [4, 33627], [8, 33787], [14, 34087], [17, 34267], [21, 34427], [32, 35227], [36, 35567], [44, 36187], [51, 36967], [53, 37547], [57, 37707], [63, 38167], [66, 38327], [72, 38627], [78, 39167], [81, 39807], [87, 40207], [96, 40887], [99, 41347], [106, 41967], [112, 42487], [115, 42767], [124, 43307], [126, 43847], [129, 43947], [136, 44287]]}, {"verse": 7, "start": 45791, "end": 51788, "text": "Y estos fueron los días de vida que vivió Abraham: ciento setenta y cinco años.", "words": [[0, 45791], [2, 45955], [8, 46215], [15, 46615], [19, 46875], [24, 47095], [27, 47295], [32, 47535], [36, 47715], [42, 48155], [51, 49518], [58, 49710], [66, 49902], [68, 50094], [74, 50286]]}, {"verse": 8, "start": 52238, "end": 60824, "text": "Y exhaló el espíritu, y murió Abraham en buena vejez, anciano y lleno de días, y fue unido a su pueblo.", "words": [[0, 52238], [2, 52395], [9, 52955], [12, 53075], [22, 54215], [24, 54335], [30, 54795], [38, 55435], [41, 55828], [47, 56222], [54, 56615], [62, 57635], [64, 57815], [70, 58135], [73, 58255], [79, 58575], [81, 59335], [85, 59515], [91, 59895], [93, 59995], [96, 60115]]}, {"verse": 9, "start": 61274, "end": 71703, "text": "Y lo sepultaron Isaac e Ismael sus hijos en la cueva de Macpela, en la heredad de Efrón, hijo de Zoar heteo, que está enfrente de Mamre;", "words": [[0, 61274], [2, 61401], [5, 61561], [16, 62201], [22, 62621], [24, 63121], [31, 63801], [35, 63901], [41, 64241], [44, 64521], [47, 64641], [53, 65041], [56, 65141], [65, 66121], [68, 66301], [71, 66461], [79, 67101], [82, 67641], [89, 68181], [94, 68481], [97, 69014], [102, 69548], [109, 70081], [113, 70121], [118, 70461], [127, 70801], [130, 71282]]}, {"verse": 10, "start": 72153, "end": 79384, "text": "Heredad que compró Abraham de los hijos de Het; allí fue Abraham sepultado, y Sara su mujer.", "words": [[0, 72414], [8, 72704], [12, 72824], [19, 73344], [27, 73864], [30, 74184], [34, 74304], [40, 74644], [43, 75122], [48, 75832], [53, 76138], [57, 76278], [65, 76988], [76, 77698], [78, 78218], [83, 78538], [86, 78798]]}, {"verse": 11, "start": 79834, "end": 89186, "text": "Y sucedió, después de muerto Abraham, que Dios bendijo a Isaac su hijo: y habitó Isaac junto al pozo del Viviente que me ve.", "words": [[0, 79834], [2, 79962], [11, 80602], [19, 81042], [22, 81262], [29, 81682], [38, 82802], [42, 82882], [47, 83142], [55, 83902], [57, 84182], [63, 84542], [66, 85002], [72, 85846], [74, 85988], [81, 86388], [87, 86748], [93, 87188], [96, 87448], [101, 87828], [105, 87988], [114, 88448], [118, 88628], [121, 88788]]}, {"verse": 12, "start": 89636, "end": 96543, "text": "Y estas son las generaciones de Ismael, hijo de Abraham, que le parió Agar egipcia, sierva de Sara:", "words": [[0, 89636], [2, 89910], [8, 90090], [12, 90330], [16, 90470], [29, 91170], [32, 91350], [40, 92030], [45, 92150], [48, 92370], [57, 93330], [61, 93450], [64, 93590], [70, 94010], [75, 94430], [84, 95410], [91, 95830], [94, 95970]]}, {"verse": 13, "start": 96993, "end": 109685, "text": "Estos, pues, son los nombres de los hijos de Ismael, por sus nombres, por sus linajes: El primogénito de Ismael, Nebaiot; luego Cedar, y Abdeel, y Mibsam,", "words": [[0, 96993], [7, 97316], [13, 97636], [17, 98256], [21, 98496], [29, 99176], [32, 99716], [36, 99836], [42, 100136], [45, 100376], [53, 101136], [57, 101456], [61, 101676], [70, 102536], [74, 102716], [78, 102956], [87, 104121], [90, 104268], [102, 105128], [105, 105348], [113, 106100], [122, 107091], [128, 107416], [135, 108136], [137, 108486], [145, 108836], [147, 109260]]}, {"verse": 14, "start": 110135, "end": 112362, "text": "Y Misma, y Duma, y Masah,", "words": [[0, 110135], [2, 110354], [9, 110614], [11, 110954], [17, 111314], [19, 111856]]}, {"verse": 15, "start": 112812, "end": 117424, "text": "Hadad, y Tema, y Jetur, y Nafis, y Cedema.", "words": [[0, 113074], [7, 113354], [9, 113534], [15, 116294], [17, 116492], [24, 116691], [26, 116889], [33, 117088], [35, 117286]]}, {"verse": 16, "start": 117874, "end": 127027, "text": "Estos son los hijos de Ismael, y estos sus nombres, por sus aldeas y por sus campamentos; doce príncipes por sus familias.", "words": [[0, 117874], [6, 118342], [10, 118702], [14, 118862], [20, 119142], [23, 119382], [31, 120082], [33, 120482], [39, 120722], [43, 120942], [52, 121522], [56, 122022], [60, 122222], [67, 122822], [69, 122962], [73, 123122], [77, 123282], [90, 124816], [95, 124956], [105, 125776], [109, 125976], [113, 126136]]}, {"verse": 17, "start": 127477, "end": 138155, "text": "Y estos fueron los años de la vida de Ismael, ciento treinta y siete años: y exhaló el espíritu Ismael, y murió; y fue unido a su pueblo.", "words": [[0, 127477], [2, 127625], [8, 127815], [15, 128175], [19, 128395], [24, 128755], [27, 128975], [30, 129075], [35, 129295], [38, 129495], [46, 130031], [53, 130567], [61, 131103], [63, 131639], [69, 132175], [75, 133220], [77, 133346], [84, 133886], [87, 134066], [96, 134666], [104, 135226], [106, 135586], [113, 136476], [115, 136605], [119, 136765], [125, 137305], [127, 137445], [130, 137565]]}, {"verse": 18, "start": 138605, "end": 147642, "text": "Y habitaron desde Havila hasta Shur, que está enfrente de Egipto viniendo a Asiria; y murió en presencia de todos sus hermanos.", "words": [[0, 138605], [2, 138729], [12, 139229], [18, 139609], [25, 139989], [31, 140509], [37, 141029], [41, 141129], [46, 141429], [55, 141729], [58, 142049], [65, 142609], [74, 143169], [76, 143625], [84, 144324], [86, 144432], [92, 144772], [95, 144892], [105, 145532], [108, 145692], [114, 145992], [118, 146432]]}, {"verse": 19, "start": 148092, "end": 154788, "text": "Y estas son las generaciones de Isaac, hijo de Abraham. Abraham engendró a Isaac:", "words": [[0, 148092], [2, 148092], [8, 148318], [12, 148558], [16, 149038], [29, 149878], [32, 150078], [39, 151018], [44, 151158], [47, 151378], [56, 152389], [64, 152916], [73, 154036], [75, 154156]]}, {"verse": 20, "start": 155238, "end": 164715, "text": "Y era Isaac de cuarenta años cuando tomó por mujer a Rebeca, hija de Betuel arameo de Padan-aram, hermana de Labán arameo.", "words": [[0, 155238], [2, 155375], [6, 155675], [12, 155975], [15, 156155], [24, 156715], [29, 157055], [36, 157595], [41, 158115], [45, 158275], [51, 158748], [53, 159222], [61, 159695], [66, 159995], [69, 160225], [76, 160455], [83, 161375], [86, 162125], [98, 162875], [106, 163395], [109, 163555], [115, 163955]]}, {"verse": 21, "start": 165165, "end": 173300, "text": "Y oró Isaac a Jehová por su mujer, que era estéril; y lo aceptó Jehová, y concibió Rebeca su mujer.", "words": [[0, 165165], [2, 165342], [6, 165762], [12, 166182], [14, 166582], [21, 167122], [25, 167262], [28, 167482], [35, 168102], [39, 168402], [43, 168662], [52, 169857], [54, 169985], [57, 170105], [64, 170605], [72, 171105], [74, 171505], [83, 172125], [90, 172565], [93, 172725]]}, {"verse": 22, "start": 173750, "end": 181955, "text": "Y los hijos se combatían dentro de ella; y dijo: Si es así ¿para qué vivo yo? Y fue a consultar a Jehová.", "words": [[0, 173750], [2, 173857], [6, 173997], [12, 174257], [15, 174477], [25, 175157], [32, 175437], [35, 175757], [41, 176561], [43, 176708], [49, 177443], [52, 177623], [55, 177863], [59, 178483], [65, 178803], [69, 178963], [74, 179163], [78, 180004], [80, 180146], [84, 180346], [86, 180526], [96, 181306], [98, 181346]]}, {"verse": 23, "start": 182405, "end": 195745, "text": "Y le respondió Jehová: Dos naciones hay en tu seno, y dos pueblos serán divididos desde tus entrañas: y el un pueblo será más fuerte que el otro pueblo, y el mayor servirá al menor.", "words": [[0, 182405], [2, 182569], [5, 182689], [15, 183329], [23, 184159], [27, 184415], [36, 185175], [40, 185615], [43, 185795], [46, 185935], [52, 186655], [54, 186875], [58, 187075], [66, 187555], [72, 187855], [82, 188415], [88, 188655], [92, 188915], [102, 190285], [104, 190403], [107, 190483], [110, 190623], [117, 191003], [122, 191503], [126, 191763], [133, 192203], [137, 192403], [140, 192523], [145, 192683], [153, 193123], [155, 193523], [158, 193643], [164, 193963], [172, 194843], [175, 195023]]}, {"verse": 24, "start": 196095, "end": 200782, "text": "Y como se cumplieron sus días para parir, he aquí mellizos en su vientre.", "words": [[0, 196095], [2, 196202], [7, 196422], [10, 196622], [21, 197262], [25, 197462], [30, 197762], [35, 198042], [42, 198432], [45, 198822], [50, 199262], [59, 199702], [62, 199902], [65, 200042]]}, {"verse": 25, "start": 201232, "end": 208083, "text": "Y salió el primero rubio, y todo él velludo como un manto de pelo; y llamaron su nombre Esaú.", "words": [[0, 201232], [2, 201342], [8, 201762], [11, 201902], [19, 202242], [26, 203082], [28, 203402], [33, 203682], [36, 204092], [44, 204502], [49, 204802], [52, 204962], [58, 205402], [61, 205562], [67, 206400], [69, 206506], [78, 206926], [81, 207126], [88, 207636]]}, {"verse": 26, "start": 208533, "end": 219894, "text": "Y después salió su hermano, trabada su mano al talón de Esaú: y fue llamado su nombre Jacob. Y era Isaac de edad de sesenta años cuando ella los parió.", "words": [[0, 208533], [2, 208659], [10, 208959], [16, 209519], [19, 209679], [28, 210439], [36, 211039], [39, 211159], [44, 211439], [47, 211639], [53, 212039], [56, 212422], [62, 213048], [64, 213155], [68, 213275], [76, 213575], [79, 213875], [86, 214635], [93, 215555], [95, 215743], [99, 215923], [105, 216443], [108, 216963], [113, 217323], [116, 217543], [124, 217763], [129, 218383], [136, 218883], [141, 219123], [145, 219363]]}, {"verse": 27, "start": 220344, "end": 229539, "text": "Y crecieron los niños, y Esaú fue diestro en la caza, hombre del campo: pero Jacob era hombre tranquilo, que habitaba en tiendas.", "words": [[0, 220344], [2, 220675], [12, 221045], [16, 221245], [23, 221685], [25, 222058], [30, 222432], [34, 222805], [42, 223245], [45, 223405], [48, 223905], [54, 224405], [61, 224705], [65, 224965], [72, 225948], [77, 226092], [83, 226412], [87, 226872], [94, 227252], [105, 228032], [109, 228212], [118, 228692], [121, 228912]]}, {"verse": 28, "start": 229989, "end": 236695, "text": "Y amó Isaac a Esaú, porque comía de su caza; mas Rebeca amaba a Jacob.", "words": [[0, 229989], [2, 230115], [6, 230515], [12, 230915], [14, 231315], [20, 231715], [27, 232055], [33, 232515], [36, 232655], [39, 233066], [45, 233761], [49, 234583], [56, 235303], [62, 235863], [64, 236103]]}, {"verse": 29, "start": 237145, "end": 241836, "text": "Y guisó Jacob un potaje; y volviendo Esaú del campo cansado,", "words": [[0, 237145], [2, 237310], [8, 237590], [14, 237990], [17, 238410], [25, 239500], [27, 239624], [37, 240034], [42, 240444], [46, 240624], [52, 240924]]}, {"verse": 30, "start": 242286, "end": 251923, "text": "Dijo a Jacob: Te ruego que me des a comer de ese guiso rojo, pues estoy muy cansado. Por tanto fue llamado su nombre Edom.", "words": [[0, 242286], [5, 242612], [7, 242752], [14, 243578], [17, 243716], [23, 244036], [27, 244216], [30, 244376], [34, 244596], [36, 244776], [42, 245036], [45, 245316], [49, 245516], [55, 245856], [61, 246716], [66, 246976], [72, 247316], [76, 247496], [85, 249386], [89, 249489], [95, 249909], [99, 250069], [107, 250389], [110, 250709], [117, 251069]]}, {"verse": 31, "start": 252373, "end": 256260, "text": "Y Jacob respondió: Véndeme en este día tu primogenitura.", "words": [[0, 252373], [2, 252520], [8, 252840], [19, 254139], [27, 254536], [30, 254716], [35, 254896], [39, 255156], [42, 255316]]}, {"verse": 32, "start": 256610, "end": 262819, "text": "Entonces dijo Esaú: He aquí yo me voy a morir; ¿para qué, pues, me servirá la primogenitura?", "words": [[0, 256610], [9, 257194], [14, 257884], [20, 258798], [23, 258868], [28, 259088], [31, 259308], [34, 259428], [38, 259588], [40, 259688], [47, 260423], [53, 260568], [58, 260728], [64, 261088], [67, 261428], [75, 261868], [78, 261928]]}, {"verse": 33, "start": 263169, "end": 269678, "text": "Y dijo Jacob: Júramelo en este día. Y él le juró, y vendió a Jacob su primogenitura.", "words": [[0, 263169], [2, 263296], [7, 263536], [14, 264595], [23, 264875], [26, 265035], [31, 265235], [36, 266020], [38, 266191], [41, 266311], [44, 266451], [50, 267091], [52, 267291], [59, 267691], [61, 267791], [67, 268151], [70, 268511]]}, {"verse": 34, "start": 270128, "end": 282284, "text": "Entonces Jacob dio a Esaú pan y del guisado de las lentejas; y él comió y bebió, y se levantó, y se fue. Así menospreció Esaú la primogenitura.", "words": [[0, 270128], [9, 270890], [15, 271170], [19, 271630], [21, 271977], [26, 272323], [30, 272670], [32, 273110], [36, 273460], [44, 273810], [47, 273950], [51, 274090], [61, 275209], [63, 275333], [66, 275453], [72, 275913], [74, 276033], [81, 276633], [83, 276873], [86, 276973], [95, 277653], [97, 277853], [100, 277973], [105, 278739], [109, 279023], [121, 279973], [126, 280923], [129, 281023]]}]}