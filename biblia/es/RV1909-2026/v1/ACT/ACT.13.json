{"book": "ACT", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 435381, "verses": [{"verse": 1, "start": 300, "end": 15686, "text": "Había entonces en la iglesia que estaba en Antioquía, profetas y maestros: Bernabé, y Simón el que se llamaba Niger, y Lucio cireneo, y Manaén, que había sido criado con Herodes el tetrarca, y Saulo.", "words": [[0, 300], [6, 656], [15, 1136], [18, 1476], [21, 1676], [29, 2176], [33, 2336], [40, 2696], [43, 2956], [54, 4276], [63, 4976], [65, 5156], [75, 6245], [84, 6911], [86, 7092], [92, 7653], [95, 7766], [99, 7886], [102, 8006], [110, 8466], [117, 9546], [119, 9646], [125, 10186], [134, 10726], [136, 10966], [144, 12046], [148, 12126], [154, 12326], [159, 12646], [166, 13206], [170, 13446], [178, 13846], [181, 14086], [191, 14786], [193, 14946]]}, {"verse": 2, "start": 16036, "end": 25532, "text": "Ministrando pues estos al Señor, y ayunando, dijo el Espíritu Santo: Apartadme a Bernabé y a Saulo para la obra para la cual los he llamado.", "words": [[0, 16036], [12, 16805], [17, 17045], [23, 17345], [26, 17645], [33, 17945], [35, 18245], [45, 19065], [50, 19565], [53, 19725], [62, 20225], [69, 20985], [79, 21747], [81, 21827], [89, 22467], [91, 22747], [93, 22807], [99, 23147], [104, 23367], [107, 23527], [112, 23920], [117, 24062], [120, 24202], [125, 24449], [129, 24695], [132, 24942]]}, {"verse": 3, "start": 26037, "end": 32707, "text": "Entonces habiendo ayunado y orado, y puesto las manos encima de ellos, los despidieron.", "words": [[0, 26037], [9, 26948], [18, 27451], [26, 28191], [28, 28371], [35, 28871], [37, 29471], [44, 29711], [48, 29951], [54, 30231], [61, 30731], [64, 30971], [71, 31671], [75, 31771]]}, {"verse": 4, "start": 33057, "end": 40613, "text": "Y ellos, enviados así por el Espíritu Santo, descendieron a Seleucia; y de allí navegaron a Chipre.", "words": [[0, 33057], [2, 33372], [9, 33672], [18, 34392], [22, 34712], [26, 35012], [29, 35192], [38, 35752], [45, 36112], [58, 37472], [60, 37999], [70, 38723], [72, 38923], [75, 39043], [80, 39223], [90, 39883], [92, 40273]]}, {"verse": 5, "start": 40963, "end": 50601, "text": "Y llegados a Salamina, anunciaban la palabra de Dios en las sinagogas de los judíos: y tenían también a Juan como ayudante.", "words": [[0, 40963], [2, 41067], [11, 41547], [13, 41747], [23, 42827], [34, 43667], [37, 43867], [45, 44247], [48, 44487], [53, 44767], [56, 45147], [60, 45327], [70, 46427], [73, 46627], [77, 46787], [85, 47771], [87, 48193], [94, 48553], [102, 48933], [104, 49213], [109, 49433], [114, 49733]]}, {"verse": 6, "start": 50951, "end": 60482, "text": "Y habiendo atravesado toda la isla hasta Pafos, hallaron un hombre mago, falso profeta, judío, llamado Barjesús;", "words": [[0, 50951], [2, 51079], [11, 51459], [22, 52159], [27, 52459], [30, 52739], [35, 53159], [41, 53849], [48, 54539], [57, 55259], [60, 55559], [67, 55839], [73, 56679], [79, 57419], [88, 58339], [95, 59199], [103, 59877]]}, {"verse": 7, "start": 60832, "end": 70972, "text": "El cual estaba con el procónsul Sergio Paulo, varón prudente. Este, llamando a Bernabé y a Saulo, deseaba oír la palabra de Dios.", "words": [[0, 60832], [3, 61010], [8, 61290], [15, 61850], [19, 62150], [22, 62637], [32, 63123], [39, 63610], [46, 64250], [52, 64750], [62, 65805], [68, 66151], [77, 66691], [79, 66871], [87, 67531], [89, 67731], [91, 67831], [98, 68771], [106, 69311], [110, 69731], [113, 69871], [121, 70231], [124, 70471]]}, {"verse": 8, "start": 71322, "end": 79789, "text": "Pero les resistía Elimas el hechicero (que así se interpreta su nombre), procurando apartar de la fe al procónsul.", "words": [[0, 71322], [5, 71687], [9, 72067], [18, 72837], [25, 73607], [28, 73807], [38, 74747], [43, 74907], [47, 75147], [50, 75307], [61, 75987], [64, 76147], [73, 76967], [84, 77587], [92, 78247], [95, 78347], [98, 78487], [101, 78727], [104, 78927]]}, {"verse": 9, "start": 80139, "end": 86548, "text": "Entonces Saulo, que también es Pablo, lleno del Espíritu Santo, poniendo en él los ojos,", "words": [[0, 80139], [9, 80970], [16, 81710], [20, 81770], [28, 82110], [31, 82350], [38, 83270], [44, 83670], [48, 83810], [57, 84410], [64, 84870], [73, 85350], [76, 85510], [79, 85670], [83, 85870]]}, {"verse": 10, "start": 86898, "end": 96662, "text": "Dijo: Oh, lleno de todo engaño y de toda maldad, hijo del diablo, enemigo de toda justicia, ¿no cesarás de trastornar los caminos rectos del Señor?", "words": [[0, 86898], [6, 87730], [10, 87820], [16, 88140], [19, 88280], [24, 88460], [31, 89060], [33, 89160], [36, 89280], [41, 89480], [49, 90520], [54, 90700], [58, 90880], [66, 91640], [74, 92020], [77, 92160], [82, 92360], [92, 93540], [96, 93660], [104, 94180], [107, 94320], [118, 94960], [122, 95080], [130, 95540], [137, 96040], [141, 96180]]}, {"verse": 11, "start": 97012, "end": 111676, "text": "Ahora pues, he aquí la mano del Señor es contra ti, y serás ciego, que no veas el sol por un tiempo. Y de inmediato cayeron en él oscuridad y tinieblas; y andando alrededor, buscaba quién le condujese por la mano.", "words": [[0, 97012], [6, 97267], [12, 97807], [15, 97887], [20, 98127], [23, 98267], [28, 98507], [32, 98687], [38, 99027], [41, 99307], [48, 99607], [52, 100207], [54, 100447], [60, 100747], [67, 101587], [71, 101647], [74, 101827], [79, 102027], [82, 102227], [86, 102427], [90, 102667], [93, 102787], [101, 103629], [103, 103734], [106, 103854], [116, 104474], [124, 105074], [127, 105214], [130, 105414], [140, 106234], [142, 106414], [153, 107493], [155, 107795], [163, 108255], [174, 108555], [182, 109535], [188, 109835], [191, 110055], [201, 110735], [205, 110995], [208, 111175]]}, {"verse": 12, "start": 112026, "end": 119545, "text": "Entonces el procónsul, viendo lo que había sido hecho, creyó, maravillado de la doctrina del Señor.", "words": [[0, 112026], [9, 113082], [12, 113324], [23, 114184], [30, 114484], [33, 114724], [37, 114864], [43, 115084], [48, 115444], [55, 116364], [62, 117164], [74, 117824], [77, 118024], [80, 118164], [89, 118724], [93, 118964]]}, {"verse": 13, "start": 119895, "end": 130944, "text": "Y partidos de Pafos, Pablo y sus compañeros arribaron a Perge de Panfilia: entonces Juan, apartándose de ellos, se volvió a Jerusalén.", "words": [[0, 119895], [2, 120171], [11, 120711], [14, 120891], [21, 121951], [27, 122691], [29, 122891], [33, 123051], [44, 123851], [54, 124611], [56, 124911], [62, 125211], [65, 125351], [75, 126456], [84, 126954], [90, 127634], [102, 128574], [105, 128754], [112, 129074], [115, 129594], [122, 130134], [124, 130254]]}, {"verse": 14, "start": 131294, "end": 139607, "text": "Y ellos pasando de Perge, llegaron a Antioquía de Pisidia, y entrando en la sinagoga un día de sábado, se sentaron.", "words": [[0, 131294], [2, 131439], [8, 131679], [16, 132079], [19, 132469], [26, 132859], [35, 133739], [37, 134059], [47, 134779], [50, 134919], [59, 135619], [61, 135959], [70, 136479], [73, 136619], [76, 136719], [85, 137279], [88, 137459], [92, 137639], [95, 137779], [103, 138319], [106, 138879]]}, {"verse": 15, "start": 139957, "end": 151903, "text": "Y después de la lectura de la ley y de los profetas, los dirigentes de la sinagoga enviaron a ellos, diciendo: Varones hermanos, si tenéis alguna palabra de exhortación para el pueblo, hablad.", "words": [[0, 139957], [2, 140078], [10, 140338], [13, 140558], [16, 140698], [24, 141218], [27, 141358], [30, 141518], [34, 141798], [36, 141998], [39, 142098], [43, 142218], [53, 143418], [57, 143518], [68, 144158], [71, 144318], [74, 144438], [83, 145038], [92, 145578], [94, 145758], [101, 146138], [111, 147671], [119, 147841], [129, 148421], [132, 148501], [139, 148821], [146, 149121], [154, 149521], [157, 149701], [169, 150321], [174, 150601], [177, 150741], [185, 151351]]}, {"verse": 16, "start": 152183, "end": 161543, "text": "Entonces Pablo, levantándose, hecha señal de silencio con la mano, dice: Varones israelitas, y los que teméis a Dios, oíd:", "words": [[0, 152183], [9, 152623], [16, 153263], [30, 154413], [36, 155563], [42, 156083], [45, 156183], [54, 156843], [58, 157043], [61, 157203], [67, 157543], [73, 158357], [81, 158733], [93, 159533], [95, 159733], [99, 159853], [103, 159993], [110, 160326], [112, 160660], [118, 160993]]}, {"verse": 17, "start": 161893, "end": 172016, "text": "El Dios del pueblo de Israel escogió a nuestros padres, y enalteció al pueblo, siendo ellos extranjeros en la tierra de Egipto, y con brazo levantado los sacó de ella.", "words": [[0, 161893], [3, 162013], [8, 162213], [12, 162413], [19, 162733], [22, 162953], [29, 163373], [37, 164073], [39, 164173], [48, 164353], [56, 164913], [58, 165473], [68, 166013], [71, 166173], [79, 166993], [86, 167293], [92, 167573], [104, 168393], [107, 168513], [110, 168613], [117, 168853], [120, 169073], [128, 169553], [130, 169873], [134, 170013], [140, 170353], [150, 170723], [154, 171093], [159, 171473], [162, 171613]]}, {"verse": 18, "start": 172366, "end": 176319, "text": "Y por tiempo como de cuarenta años soportó sus costumbres en el desierto;", "words": [[0, 172366], [2, 172474], [6, 172614], [13, 172854], [18, 173174], [21, 173444], [30, 173714], [35, 174094], [43, 174674], [47, 174814], [58, 175374], [61, 175514], [64, 175614]]}, {"verse": 19, "start": 176669, "end": 181880, "text": "Y destruyendo siete naciones en la tierra de Canaán, les repartió por suerte la tierra de ellas.", "words": [[0, 176669], [2, 176737], [14, 177147], [20, 177557], [29, 178117], [32, 178297], [35, 178397], [42, 178617], [45, 179047], [53, 179477], [57, 179797], [66, 180297], [70, 180437], [77, 180797], [80, 180937], [87, 181197], [90, 181397]]}, {"verse": 20, "start": 182230, "end": 187451, "text": "Y después, como por cuatrocientos cincuenta años, les dio jueces hasta el profeta Samuel.", "words": [[0, 182230], [2, 182331], [11, 182911], [16, 183071], [20, 183358], [34, 183644], [44, 183931], [50, 185291], [54, 185471], [58, 185691], [65, 186091], [71, 186351], [74, 186471], [82, 186871]]}, {"verse": 21, "start": 187801, "end": 195253, "text": "Y entonces pidieron rey; y les dio Dios a Saúl, hijo de Cis, varón de la tribu de Benjamín, por cuarenta años.", "words": [[0, 187801], [2, 187920], [11, 188280], [20, 188840], [25, 189486], [27, 189608], [31, 189808], [35, 190088], [40, 190328], [42, 190608], [48, 191148], [53, 191308], [56, 191488], [61, 192148], [67, 192568], [70, 192668], [73, 192768], [79, 193148], [82, 193268], [92, 194108], [96, 194228], [105, 194788]]}, {"verse": 22, "start": 195603, "end": 207971, "text": "Y quitado aquel, les levantó por rey a David, al que dio también testimonio, diciendo: He hallado a David, hijo de Isaí, varón conforme a mi corazón, el cual hará todo lo que yo quiero.", "words": [[0, 195603], [2, 195724], [10, 196104], [17, 196524], [21, 196664], [29, 197164], [33, 197324], [37, 197484], [39, 197644], [46, 198004], [49, 198404], [53, 198524], [57, 198724], [65, 199044], [77, 199874], [87, 200693], [90, 200831], [98, 201271], [100, 201411], [107, 202031], [112, 202331], [115, 202491], [121, 203271], [127, 203691], [136, 204311], [138, 204391], [141, 204471], [150, 205411], [153, 205591], [158, 205891], [163, 206331], [168, 206551], [171, 206811], [175, 206951], [178, 207111]]}, {"verse": 23, "start": 208474, "end": 214592, "text": "De la descendencia de este, Dios, conforme a la promesa, levantó a Jesús por Salvador a Israel;", "words": [[0, 208474], [3, 208601], [6, 208701], [19, 209421], [22, 209561], [28, 210081], [34, 210741], [43, 211241], [45, 211321], [48, 211361], [57, 212321], [65, 212801], [67, 212881], [73, 213101], [77, 213441], [86, 213821], [88, 214041]]}, {"verse": 24, "start": 214942, "end": 220028, "text": "Predicando Juan antes de su llegada el bautismo de arrepentimiento a todo el pueblo de Israel.", "words": [[0, 214942], [11, 215428], [16, 215748], [22, 216148], [25, 216308], [28, 216428], [36, 216718], [39, 217008], [48, 217548], [51, 217708], [67, 218508], [69, 218668], [74, 218808], [77, 218968], [84, 219248], [87, 219388]]}, {"verse": 25, "start": 220378, "end": 229530, "text": "Pero como Juan cumpliese su carrera, dijo: ¿Quién pensáis que soy? No soy yo él; pero he aquí, viene tras mí uno, cuyo calzado de los pies no soy digno de desatar.", "words": [[0, 220378], [5, 220494], [10, 220694], [15, 221094], [25, 221494], [28, 221674], [37, 222174], [43, 222798], [50, 222982], [58, 223322], [62, 223502], [67, 224135], [70, 224255], [74, 224455], [77, 224615], [81, 225132], [86, 225268], [89, 225428], [95, 225928], [101, 226108], [106, 226308], [109, 226528], [114, 226748], [119, 227088], [127, 227568], [130, 227648], [134, 227788], [139, 228048], [142, 228308], [146, 228508], [152, 228888], [155, 228928]]}, {"verse": 26, "start": 229880, "end": 238384, "text": "Varones hermanos, hijos del linaje de Abraham, y los que entre vosotros temen a Dios, a vosotros es enviada la palabra de esta salvación.", "words": [[0, 229880], [8, 230303], [18, 231063], [24, 231183], [28, 231463], [35, 231883], [38, 232023], [47, 233083], [49, 233143], [53, 233283], [57, 233443], [63, 233683], [72, 234203], [78, 234603], [80, 234703], [86, 235483], [88, 235583], [97, 236003], [100, 236183], [108, 236623], [111, 236803], [119, 237183], [122, 237383], [127, 237603]]}, {"verse": 27, "start": 238734, "end": 248196, "text": "Porque los que habitaban en Jerusalén, y sus príncipes, no conociendo a este, y las voces de los profetas que se leen todos los sábados, condenándolo, las cumplieron.", "words": [[0, 238734], [7, 238938], [11, 239118], [15, 239278], [25, 239778], [28, 239898], [39, 240518], [41, 240618], [45, 240798], [56, 241618], [59, 241718], [70, 242198], [72, 242418], [78, 242758], [80, 243138], [84, 243298], [90, 243658], [93, 243798], [97, 243898], [106, 244478], [110, 244698], [113, 244838], [118, 245158], [124, 245358], [128, 245618], [137, 246538], [151, 247398], [155, 247458]]}, {"verse": 28, "start": 248546, "end": 252905, "text": "Y sin hallar en él causa de muerte, pidieron a Pilato que le matasen.", "words": [[0, 248546], [2, 248675], [6, 248915], [13, 249235], [16, 249355], [19, 249495], [25, 249755], [28, 250015], [36, 250935], [45, 251415], [47, 251515], [54, 251915], [58, 252055], [61, 252175]]}, {"verse": 29, "start": 253255, "end": 259963, "text": "Y habiendo cumplido todas las cosas que de él estaban escritas, quitándolo del madero, lo pusieron en el sepulcro.", "words": [[0, 253255], [2, 253356], [11, 253656], [20, 254216], [26, 254396], [30, 254676], [36, 255016], [40, 255276], [43, 255396], [46, 255596], [54, 255896], [64, 256936], [75, 257436], [79, 257596], [87, 258476], [90, 258636], [99, 259056], [102, 259376], [105, 259696]]}, {"verse": 30, "start": 260313, "end": 262347, "text": "Pero Dios le levantó de los muertos.", "words": [[0, 260313], [5, 260450], [10, 260690], [13, 260950], [21, 261430], [24, 261510], [28, 261630]]}, {"verse": 31, "start": 262697, "end": 270237, "text": "Y él fue visto por muchos días de los que habían subido juntamente con él de Galilea a Jerusalén, los cuales son sus testigos al pueblo.", "words": [[0, 262697], [2, 262834], [5, 262934], [9, 263094], [15, 263334], [19, 263574], [26, 263834], [31, 264214], [34, 264454], [38, 264594], [42, 264774], [49, 265014], [56, 265454], [67, 265994], [71, 266234], [74, 266374], [77, 266494], [85, 266784], [87, 267074], [98, 268134], [102, 268234], [109, 268534], [113, 268814], [117, 269034], [126, 269514], [129, 269694]]}, {"verse": 32, "start": 270587, "end": 275159, "text": "Y nosotros también os anunciamos el evangelio de aquella promesa que fue hecha a los padres,", "words": [[0, 270587], [2, 270690], [11, 270930], [19, 271200], [22, 271470], [33, 272010], [36, 272250], [46, 272830], [49, 272930], [57, 273210], [65, 273690], [69, 273850], [73, 274050], [79, 274330], [81, 274410], [85, 274510]]}, {"verse": 33, "start": 275509, "end": 285375, "text": "La cual Dios ha cumplido a los hijos de ellos, a nosotros, resucitando a Jesús: como también en el salmo segundo está escrito: Mi hijo eres tú, yo te he engendrado hoy.", "words": [[0, 275509], [3, 275636], [8, 275835], [13, 276155], [16, 276516], [25, 276996], [27, 277095], [31, 277215], [37, 277456], [40, 277676], [47, 278155], [49, 278235], [59, 279196], [71, 279655], [73, 279756], [80, 280376], [85, 280539], [93, 280939], [96, 281099], [99, 281219], [105, 281539], [113, 281899], [118, 282159], [127, 282998], [130, 283161], [135, 283361], [140, 283581], [144, 284161], [147, 284261], [150, 284441], [153, 284521], [164, 285021]]}, {"verse": 34, "start": 285725, "end": 292445, "text": "Y que le levantó de los muertos para nunca más volver a corrupción, así lo dijo: Os daré las misericordias fieles de David.", "words": [[0, 285725], [2, 285833], [6, 285933], [9, 286033], [17, 286513], [20, 286573], [24, 286713], [32, 287113], [37, 287373], [43, 287613], [47, 287953], [54, 288133], [56, 288313], [68, 289093], [72, 289273], [75, 289433], [81, 290068], [84, 290185], [89, 290525], [93, 290625], [107, 291345], [114, 291845], [117, 291945]]}, {"verse": 35, "start": 292795, "end": 297212, "text": "Por eso dice también en otro lugar: No permitirás que tu Santo vea corrupción.", "words": [[0, 292795], [4, 292919], [8, 293119], [13, 293359], [21, 293659], [24, 293899], [29, 294059], [36, 294843], [39, 294967], [50, 295587], [54, 295687], [57, 295807], [63, 296147], [67, 296487]]}, {"verse": 36, "start": 297562, "end": 305111, "text": "Porque a la verdad David, habiendo servido en su generación a la voluntad de Dios, durmió, y fue reunido con sus padres, y vio corrupción:", "words": [[0, 297562], [7, 297770], [9, 297910], [12, 297970], [19, 298410], [26, 298890], [35, 299190], [43, 299630], [46, 299730], [49, 299850], [60, 300450], [62, 300590], [65, 300630], [74, 301110], [77, 301210], [83, 301830], [91, 302390], [93, 302650], [97, 302810], [105, 303250], [109, 303390], [113, 303590], [121, 303910], [123, 304250], [127, 304430]]}, {"verse": 37, "start": 305461, "end": 307889, "text": "Pero aquel que Dios levantó, no vio corrupción.", "words": [[0, 305461], [5, 305598], [11, 305878], [15, 305958], [20, 306118], [29, 306718], [32, 306998], [36, 307178]]}, {"verse": 38, "start": 308239, "end": 314099, "text": "Os sea pues notorio, varones hermanos, que por este os es anunciado el perdón de pecados;", "words": [[0, 308268], [3, 308338], [7, 308698], [12, 308818], [21, 309448], [29, 310078], [39, 310878], [43, 311118], [47, 311318], [52, 311578], [55, 311838], [58, 312098], [68, 312758], [71, 312878], [78, 313298], [81, 313398]]}, {"verse": 39, "start": 314449, "end": 321470, "text": "Y de todo lo que por la ley de Moisés no pudisteis ser justificados, en este es justificado todo aquel que cree.", "words": [[0, 314449], [2, 314573], [5, 314693], [10, 314993], [13, 315213], [17, 315353], [21, 315573], [24, 315693], [28, 315893], [31, 316033], [38, 316413], [41, 316733], [51, 317433], [55, 317573], [69, 318913], [72, 319113], [77, 319353], [80, 319553], [92, 320313], [97, 320513], [103, 320933], [107, 321033]]}, {"verse": 40, "start": 321820, "end": 325964, "text": "Mirad, pues, que no venga sobre vosotros lo que está dicho en los profetas;", "words": [[0, 321820], [7, 322178], [13, 322378], [17, 322938], [20, 323078], [26, 323398], [32, 323618], [41, 324178], [44, 324358], [48, 324478], [53, 324658], [59, 324938], [62, 325078], [66, 325178]]}, {"verse": 41, "start": 326314, "end": 334953, "text": "Mirad, oh menospreciadores, y asombraos y pereced; porque yo hago una obra en vuestros días, obra que no creeréis, si alguien os la cuenta.", "words": [[0, 326314], [7, 326795], [10, 327315], [28, 327835], [30, 328355], [40, 329075], [42, 329295], [51, 330191], [58, 330391], [61, 330591], [66, 330771], [70, 331031], [75, 331311], [78, 331471], [87, 331831], [93, 332471], [98, 332671], [102, 332851], [105, 332971], [115, 333531], [118, 333871], [126, 334081], [129, 334291], [132, 334411]]}, {"verse": 42, "start": 335233, "end": 344294, "text": "Y saliendo ellos de la sinagoga de los judíos, los Gentiles les rogaron que el sábado siguiente les hablasen estas palabras.", "words": [[0, 335233], [2, 335355], [11, 335875], [17, 336235], [20, 336475], [23, 336615], [32, 337275], [35, 337475], [39, 337595], [47, 338655], [51, 338835], [60, 339455], [64, 340155], [72, 340855], [76, 341115], [79, 341295], [86, 341715], [96, 342035], [100, 342565], [109, 343095], [115, 343335]]}, {"verse": 43, "start": 344644, "end": 360069, "text": "Y despedida la congregación, muchos de los judíos y de los convertidos devotos al judaísmo siguieron a Pablo y a Bernabé; los cuales hablándoles, les persuadían que permaneciesen en la gracia de Dios.", "words": [[0, 344644], [2, 344778], [12, 345638], [15, 345718], [29, 347258], [36, 347738], [39, 347958], [43, 348098], [50, 348758], [52, 348938], [55, 349018], [59, 349158], [71, 349818], [79, 350478], [82, 350618], [91, 351438], [101, 352338], [103, 352578], [109, 353018], [111, 353338], [113, 353418], [122, 354325], [126, 354471], [133, 354811], [146, 355791], [150, 356311], [161, 357111], [165, 357331], [179, 358671], [182, 358791], [185, 358931], [192, 359331], [195, 359471]]}, {"verse": 44, "start": 360419, "end": 365714, "text": "Y el sábado siguiente se juntó casi toda la ciudad a oír la palabra de Dios.", "words": [[0, 360419], [2, 360542], [5, 360662], [12, 361102], [22, 361562], [25, 361902], [31, 362422], [36, 362622], [41, 363082], [44, 363322], [51, 363662], [53, 364062], [57, 364402], [60, 364562], [68, 364922], [71, 365182]]}, {"verse": 45, "start": 366064, "end": 374580, "text": "Pero los judíos, al ver la multitud, se llenaron de celo, y se oponían a lo que Pablo decía, contradiciendo y blasfemando.", "words": [[0, 366064], [5, 366209], [9, 366389], [17, 366889], [20, 367089], [24, 367269], [27, 367409], [37, 368049], [40, 368669], [49, 369409], [52, 369669], [58, 370349], [60, 370509], [63, 370629], [71, 371229], [73, 371469], [76, 371569], [80, 371669], [86, 371989], [93, 372709], [108, 373569], [110, 373689]]}, {"verse": 46, "start": 374930, "end": 390443, "text": "Entonces Pablo y Bernabé, hablando con franqueza, dijeron: A vosotros a la verdad era necesario que se os hablase la palabra de Dios; pero pues que la desecháis, y os juzgáis indignos de la vida eterna, he aquí, nos volvemos a los Gentiles.", "words": [[0, 374930], [9, 375580], [15, 376360], [17, 376600], [26, 377320], [35, 377720], [39, 378270], [50, 378820], [59, 379796], [61, 379920], [70, 380520], [72, 380640], [75, 380720], [82, 381240], [86, 381420], [96, 382040], [100, 382240], [103, 382380], [106, 382540], [114, 382900], [117, 383020], [125, 383300], [128, 383500], [134, 384200], [139, 384359], [144, 384619], [148, 384759], [151, 384879], [162, 385519], [164, 385799], [167, 385939], [175, 386339], [184, 386979], [187, 387079], [190, 387179], [195, 387359], [203, 387879], [206, 388399], [212, 388719], [216, 389019], [225, 389539], [227, 389639], [231, 389739]]}, {"verse": 47, "start": 390793, "end": 398429, "text": "Porque así nos ha mandado el Señor, diciendo: Te he puesto para luz de los Gentiles, para que seas salvación hasta lo último de la tierra.", "words": [[0, 390793], [7, 390930], [11, 391170], [15, 391330], [18, 391470], [26, 391870], [29, 391970], [36, 392270], [46, 393407], [49, 393541], [52, 393641], [59, 393901], [64, 394281], [68, 394481], [71, 394661], [75, 394781], [85, 395361], [90, 395656], [94, 395866], [99, 396076], [109, 396776], [115, 397136], [118, 397316], [125, 397616], [128, 397836], [131, 397936]]}, {"verse": 48, "start": 398709, "end": 407963, "text": "Y los Gentiles oyendo esto, fueron gozosos, y glorificaban la palabra del Señor: y creyeron todos los que estaban ordenados para vida eterna.", "words": [[0, 398709], [2, 398834], [6, 398974], [15, 399574], [22, 400134], [28, 400434], [35, 401054], [44, 401814], [46, 401994], [59, 402814], [62, 402974], [70, 403334], [74, 403594], [81, 404360], [83, 404468], [92, 405008], [98, 405288], [102, 405568], [106, 405728], [114, 406028], [124, 406648], [129, 406908], [134, 407128]]}, {"verse": 49, "start": 408313, "end": 412260, "text": "Y la palabra del Señor era sembrada por toda aquella provincia.", "words": [[0, 408313], [2, 408562], [5, 408682], [13, 408942], [17, 409222], [23, 409482], [27, 409782], [36, 410422], [40, 410642], [45, 410902], [53, 411362]]}, {"verse": 50, "start": 412610, "end": 424876, "text": "Pero los judíos incitaron a mujeres devotas y de posición distinguida, y a los principales de la ciudad, y levantaron persecución contra Pablo y Bernabé, y los echaron de su territorio.", "words": [[0, 412610], [5, 412793], [9, 412973], [16, 413453], [26, 414193], [28, 414233], [36, 414803], [44, 415373], [46, 415458], [49, 415598], [58, 416018], [71, 417138], [73, 417698], [75, 417778], [79, 417898], [91, 418698], [94, 418858], [97, 418958], [105, 419358], [107, 419693], [118, 420333], [130, 421173], [137, 421553], [143, 422013], [145, 422173], [154, 422850], [156, 423117], [160, 423383], [168, 423650], [171, 423830], [174, 423990]]}, {"verse": 51, "start": 425226, "end": 430509, "text": "Ellos entonces sacudiendo en ellos el polvo de sus pies, vinieron a Iconio.", "words": [[0, 425226], [6, 425614], [15, 426034], [26, 427074], [29, 427254], [35, 427494], [38, 427734], [44, 428274], [47, 428394], [51, 428574], [57, 428934], [66, 429609], [68, 429789]]}, {"verse": 52, "start": 430859, "end": 434981, "text": "Y los discípulos estaban llenos de gozo, y del Espíritu Santo.", "words": [[0, 430859], [2, 430946], [6, 431066], [17, 431686], [25, 432046], [32, 432586], [35, 432706], [41, 433166], [43, 433586], [47, 433726], [56, 434286]]}]}