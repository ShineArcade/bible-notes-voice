{"book": "MRK", "chapter": 2, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 263864, "verses": [{"verse": 1, "start": 300, "end": 6313, "text": "Y entró otra vez en Capernaum después de algunos días, y se supo que estaba en casa.", "words": [[0, 300], [2, 468], [8, 908], [13, 1228], [17, 1528], [20, 2008], [30, 2488], [38, 2948], [41, 3168], [49, 3448], [55, 3888], [57, 4568], [60, 4688], [65, 5088], [69, 5248], [76, 5528], [79, 5728]]}, {"verse": 2, "start": 6763, "end": 14463, "text": "Y luego se juntaron a él muchos, que ya no cabían ni aun a la puerta; y les predicaba la palabra.", "words": [[0, 6763], [2, 7046], [8, 7306], [11, 7586], [20, 8266], [22, 8426], [25, 8566], [33, 9346], [37, 9566], [40, 9726], [43, 9846], [50, 10246], [53, 10646], [57, 10906], [59, 11146], [62, 11246], [70, 12228], [72, 12407], [76, 12607], [86, 13527], [89, 13687]]}, {"verse": 3, "start": 14913, "end": 20520, "text": "Entonces vinieron a él unos que traían a un paralítico entre cuatro personas.", "words": [[0, 14913], [9, 15575], [18, 16415], [20, 16595], [23, 16815], [28, 17135], [32, 17335], [39, 17815], [41, 17915], [44, 18055], [55, 18815], [61, 19095], [68, 19455]]}, {"verse": 4, "start": 20970, "end": 32641, "text": "Y como no podían llegar a él a causa de tanta gente, descubrieron el techo de donde estaba, y haciendo abertura, bajaron la camilla donde estaba acostado el paralítico.", "words": [[0, 20970], [2, 21091], [7, 21291], [10, 21471], [17, 21931], [24, 22231], [26, 22491], [29, 22691], [31, 22911], [37, 23211], [40, 23451], [46, 23631], [53, 24171], [66, 25431], [69, 25611], [75, 26031], [78, 26171], [84, 26331], [92, 26771], [94, 27231], [103, 27631], [113, 28711], [121, 29271], [124, 29471], [132, 30011], [138, 30551], [145, 31031], [154, 31631], [157, 31771]]}, {"verse": 5, "start": 33091, "end": 40189, "text": "Y viendo Jesús la fe de ellos, dice al paralítico: Hijo, tus pecados te son perdonados.", "words": [[0, 33091], [2, 33225], [9, 33565], [15, 34025], [18, 34585], [21, 34785], [24, 34985], [31, 35865], [36, 36225], [39, 36445], [51, 37637], [57, 38265], [61, 38385], [69, 38865], [72, 39025], [76, 39205]]}, {"verse": 6, "start": 40639, "end": 46732, "text": "Y estaban allí sentados algunos de los escribas, los cuales pensando en sus corazones,", "words": [[0, 40639], [2, 40899], [10, 41219], [15, 41519], [24, 42239], [32, 42679], [35, 42919], [39, 43039], [49, 43979], [53, 44079], [60, 44379], [69, 45279], [72, 45619], [76, 45819]]}, {"verse": 7, "start": 47182, "end": 53886, "text": "Decían: ¿Por qué habla este así? Blasfemias dice. ¿Quién puede perdonar pecados, sino solo Dios?", "words": [[0, 47182], [8, 48459], [13, 48601], [17, 48781], [23, 49001], [28, 49221], [33, 50274], [44, 50604], [50, 51396], [57, 51574], [63, 51754], [72, 52274], [81, 52774], [86, 52994], [91, 53274]]}, {"verse": 8, "start": 54236, "end": 63670, "text": "Y conociendo luego Jesús en su espíritu que pensaban así dentro de sí mismos, les dijo: ¿Por qué pensáis estas cosas en vuestros corazones?", "words": [[0, 54236], [2, 54345], [13, 54985], [19, 55265], [25, 55765], [28, 56225], [31, 56365], [40, 57025], [44, 57105], [53, 57725], [57, 57965], [64, 58345], [67, 58625], [70, 58785], [78, 59485], [82, 59665], [88, 60541], [93, 60646], [97, 60786], [105, 61366], [111, 61686], [117, 62106], [120, 62386], [129, 62746]]}, {"verse": 9, "start": 64120, "end": 73471, "text": "¿Qué es más fácil, decir al paralítico: Tus pecados te son perdonados, o decirle: Levántate, y toma tu lecho y anda?", "words": [[0, 64120], [5, 64222], [8, 64342], [12, 64482], [19, 64962], [25, 65742], [28, 66102], [40, 67597], [44, 67741], [52, 68381], [55, 68501], [59, 68701], [71, 69561], [73, 69941], [82, 71118], [93, 71803], [95, 72063], [100, 72283], [103, 72513], [109, 72743], [111, 72983]]}, {"verse": 10, "start": 73921, "end": 80991, "text": "Pues para que sepáis que el Hijo del hombre tiene autoridad en la tierra de perdonar los pecados, (dice al paralítico):", "words": [[0, 73921], [5, 74043], [10, 74223], [14, 74383], [21, 74823], [25, 75023], [28, 75183], [33, 75423], [37, 75563], [44, 75843], [50, 76243], [60, 77023], [63, 77203], [66, 77323], [73, 77643], [76, 77823], [85, 78443], [89, 78563], [98, 79603], [104, 79820], [107, 80070]]}, {"verse": 11, "start": 81441, "end": 85888, "text": "A ti te digo: Levántate, y toma tu lecho, y vete a tu casa.", "words": [[0, 81441], [2, 81581], [5, 81741], [8, 81861], [14, 82708], [25, 83304], [27, 83724], [32, 83924], [35, 84334], [42, 84744], [44, 84884], [49, 85124], [51, 85264], [54, 85324]]}, {"verse": 12, "start": 86338, "end": 99836, "text": "Entonces él se levantó luego, y tomando su lecho, se salió delante de todos, de manera que todos se asombraron, y glorificaron a Dios, diciendo: Nunca hemos visto tal cosa.", "words": [[0, 86338], [9, 86943], [12, 87503], [15, 87823], [23, 88303], [30, 88643], [32, 89383], [40, 89803], [43, 89983], [50, 90383], [53, 90883], [59, 91283], [67, 91683], [70, 91843], [77, 92823], [80, 92963], [87, 93203], [91, 93463], [97, 93763], [100, 94223], [112, 95143], [114, 95793], [127, 96443], [129, 96543], [135, 96783], [145, 98059], [151, 98475], [157, 98635], [163, 99015], [167, 99255]]}, {"verse": 13, "start": 100186, "end": 105877, "text": "Y volvió a salir al mar, y toda la gente venía a él, y los enseñaba.", "words": [[0, 100186], [2, 100309], [9, 100809], [11, 100989], [17, 101329], [20, 101569], [25, 101849], [27, 102069], [32, 102289], [35, 102489], [41, 102769], [47, 103309], [49, 103549], [53, 103789], [55, 104549], [59, 104749]]}, {"verse": 14, "start": 106327, "end": 118275, "text": "Y pasando, vio a Leví, hijo de Alfeo, sentado a la mesa de recaudación de impuestos, y le dice: Sígueme. Y levantándose le siguió.", "words": [[0, 106327], [2, 106451], [11, 107091], [15, 107504], [17, 107918], [23, 108331], [28, 108551], [31, 108751], [38, 109831], [46, 110431], [48, 110551], [51, 110631], [56, 110931], [59, 111131], [71, 111931], [74, 112171], [85, 113731], [87, 113951], [90, 114091], [96, 114899], [105, 116190], [107, 116348], [120, 117188], [123, 117568]]}, {"verse": 15, "start": 118725, "end": 134045, "text": "Y aconteció que estando Jesús a la mesa en casa de él, muchos recaudadores de impuestos y pecadores estaban también a la mesa juntamente con Jesús y con sus discípulos: porque había muchos, y le habían seguido.", "words": [[0, 118725], [2, 118834], [12, 119534], [16, 119734], [24, 120174], [30, 120574], [32, 120934], [35, 121034], [40, 121334], [43, 121554], [48, 121894], [51, 122154], [55, 122654], [62, 123414], [75, 124294], [78, 124514], [88, 125114], [90, 125374], [100, 126014], [108, 126694], [116, 127234], [118, 127534], [121, 127634], [126, 127914], [137, 128634], [141, 128894], [147, 129274], [149, 129814], [153, 130014], [157, 130254], [169, 131576], [176, 131800], [182, 132040], [190, 132420], [192, 132980], [195, 133120], [202, 133360]]}, {"verse": 16, "start": 134495, "end": 148339, "text": "Y los escribas y los fariseos, viéndole comer con los recaudadores de impuestos y con los pecadores, dijeron a sus discípulos: ¿Qué es esto, que él come y bebe con los recaudadores de impuestos y con los pecadores?", "words": [[0, 134495], [2, 134603], [6, 134723], [15, 135463], [17, 135803], [21, 135943], [31, 136683], [40, 137443], [46, 137763], [50, 138143], [54, 138363], [67, 139183], [70, 139403], [80, 139983], [82, 140183], [86, 140343], [90, 140483], [101, 141023], [109, 141983], [111, 142043], [115, 142263], [127, 143724], [132, 143865], [135, 144065], [141, 144325], [145, 144545], [148, 144705], [153, 144985], [155, 145165], [160, 145465], [164, 145625], [168, 145765], [181, 146425], [184, 146585], [194, 147065], [196, 147245], [200, 147405], [204, 147545]]}, {"verse": 17, "start": 148689, "end": 159495, "text": "Y oyéndolo Jesús, les dice: Los sanos no tienen necesidad de médico, sino los enfermos. No he venido a llamar a los justos, sino a los pecadores.", "words": [[0, 148689], [2, 149031], [11, 149411], [18, 149831], [22, 150251], [28, 151034], [32, 151160], [38, 151740], [41, 152120], [48, 152500], [58, 153480], [61, 153640], [69, 154400], [74, 154620], [78, 154880], [88, 156077], [91, 156473], [94, 156553], [101, 156933], [103, 157013], [110, 157353], [112, 157393], [116, 157533], [124, 158073], [129, 158353], [131, 158453], [135, 158573]]}, {"verse": 18, "start": 159945, "end": 172014, "text": "Y los discípulos de Juan, y de los fariseos ayunaban; y vienen, y le dicen: ¿Por qué los discípulos de Juan y los de los fariseos ayunan, y tus discípulos no ayunan?", "words": [[0, 159945], [2, 160049], [6, 160189], [17, 160789], [20, 160989], [26, 161409], [28, 162129], [31, 162249], [35, 162409], [44, 163269], [54, 164704], [56, 164828], [64, 165268], [66, 165688], [69, 165788], [76, 166724], [81, 166824], [85, 166944], [89, 167084], [100, 167644], [103, 167804], [108, 168144], [110, 168384], [114, 168504], [117, 168604], [121, 168724], [130, 169344], [138, 169844], [140, 170324], [144, 170464], [155, 171084], [158, 171384]]}, {"verse": 19, "start": 172364, "end": 182386, "text": "Y Jesús les dice: ¿Pueden ayunar los invitados a la boda, cuando el esposo está con ellos? Entre tanto que tienen consigo al esposo no pueden ayunar.", "words": [[0, 172364], [2, 172494], [8, 172894], [12, 173374], [18, 174378], [26, 174741], [33, 175361], [37, 175481], [47, 176161], [49, 176341], [52, 176401], [58, 176761], [65, 177001], [68, 177261], [75, 177621], [80, 177801], [84, 178041], [91, 178831], [97, 179078], [103, 179438], [107, 179638], [114, 179918], [122, 180398], [125, 180618], [132, 180998], [135, 181238], [142, 181658]]}, {"verse": 20, "start": 182836, "end": 189201, "text": "Pero vendrán días, cuando el esposo les será quitado, y entonces en aquellos días ayunarán.", "words": [[0, 182836], [5, 183001], [13, 183461], [19, 183821], [26, 184401], [29, 184641], [36, 185021], [40, 185221], [45, 185461], [54, 186061], [56, 186761], [65, 187241], [68, 187561], [77, 187781], [82, 188201]]}, {"verse": 21, "start": 189651, "end": 199450, "text": "Nadie echa remiendo de paño nuevo en vestido viejo; de otra manera el mismo remiendo nuevo tira del viejo, y la rotura se hace peor.", "words": [[0, 189651], [6, 190199], [11, 190599], [20, 191379], [23, 191519], [28, 191879], [34, 192199], [37, 192379], [45, 192839], [52, 193727], [55, 193853], [60, 194033], [67, 194573], [70, 194653], [76, 194973], [85, 195653], [91, 195913], [96, 196393], [100, 196573], [107, 197453], [109, 197633], [112, 197793], [119, 198333], [122, 198553], [127, 198833]]}, {"verse": 22, "start": 199900, "end": 214211, "text": "Ni nadie echa vino nuevo en odres viejos; de otra manera, el vino nuevo rompe los odres, y se derrama el vino, y los odres se pierden; pero el vino nuevo en odres nuevos se ha de echar.", "words": [[0, 199900], [3, 200045], [9, 200365], [14, 200705], [19, 200985], [25, 201405], [28, 201605], [34, 201805], [42, 203040], [45, 203176], [50, 203336], [58, 203736], [61, 203976], [66, 204196], [72, 204556], [78, 205176], [82, 205376], [89, 206116], [91, 206656], [94, 206836], [102, 207416], [105, 207716], [111, 208116], [113, 208676], [117, 208836], [123, 209356], [126, 209516], [135, 210656], [140, 210800], [143, 210980], [148, 211200], [154, 211620], [157, 211900], [163, 212320], [170, 212760], [173, 213300], [176, 213460], [179, 213620]]}, {"verse": 23, "start": 214661, "end": 222905, "text": "Y aconteció que pasando él por los sembrados en sábado, sus discípulos andando comenzaron a arrancar espigas.", "words": [[0, 214661], [2, 214847], [12, 215587], [16, 215847], [24, 216267], [27, 216567], [31, 216787], [35, 216987], [45, 217587], [48, 217847], [56, 218707], [60, 218847], [71, 219667], [79, 220207], [90, 220987], [92, 221287], [101, 222124]]}, {"verse": 24, "start": 223355, "end": 229072, "text": "Entonces los fariseos le dijeron: He aquí, ¿por qué hacen en sábado lo que no es lícito?", "words": [[0, 223355], [9, 223799], [13, 224179], [22, 224839], [25, 224979], [34, 225939], [37, 226019], [43, 226819], [48, 226939], [52, 227139], [58, 227459], [61, 227579], [68, 228019], [71, 228159], [75, 228279], [78, 228419], [81, 228539]]}, {"verse": 25, "start": 229422, "end": 237478, "text": "Y él les dijo: ¿Nunca leísteis qué hizo David cuando tuvo necesidad, y tuvo hambre, él y los que con él estaban:", "words": [[0, 229422], [2, 229589], [5, 229709], [9, 229889], [15, 230728], [22, 231038], [31, 231718], [35, 231858], [40, 232278], [46, 232598], [53, 232898], [58, 233258], [69, 234018], [71, 234398], [76, 234658], [84, 235198], [87, 235778], [89, 236198], [93, 236338], [97, 236458], [101, 236678], [104, 236798]]}, {"verse": 26, "start": 237928, "end": 251196, "text": "Cómo entró en la casa de Dios, siendo Abiatar sumo sacerdote, y comió los panes consagrados, de los cuales no es lícito comer sino a los sacerdotes, y aun dio a los que con él estaban?", "words": [[0, 237928], [5, 238113], [11, 238573], [14, 238653], [17, 238773], [22, 239033], [25, 239233], [31, 240193], [38, 240713], [46, 241233], [51, 241653], [62, 242413], [64, 242853], [70, 243293], [74, 243433], [80, 243813], [93, 244653], [96, 245173], [100, 245293], [107, 245513], [110, 245813], [113, 245933], [120, 246333], [126, 246733], [131, 247073], [133, 247253], [137, 247353], [149, 248677], [151, 248818], [155, 249078], [159, 249418], [161, 249658], [165, 249798], [169, 249938], [173, 250158], [176, 250318]]}, {"verse": 27, "start": 251646, "end": 259114, "text": "También les dijo: El sábado por causa del hombre es hecho; no el hombre por causa del sábado.", "words": [[0, 251646], [8, 251950], [12, 252190], [18, 253103], [21, 253251], [28, 253791], [32, 254011], [38, 254371], [42, 254671], [49, 254931], [52, 255191], [59, 256058], [62, 256518], [65, 256878], [72, 257238], [76, 257538], [82, 257958], [86, 258338]]}, {"verse": 28, "start": 259564, "end": 263464, "text": "Así que el Hijo del hombre es Señor aun del sábado.", "words": [[0, 259564], [4, 259826], [8, 260066], [11, 260326], [16, 260626], [20, 260786], [27, 261166], [30, 261386], [36, 261906], [40, 262366], [44, 262686]]}]}