{"book": "MAT", "chapter": 6, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 300417, "verses": [{"verse": 1, "start": 300, "end": 11436, "text": "Mirad que no hagáis vuestra justicia delante de los hombres, para ser vistos de ellos: de otra manera no tendréis recompensa de vuestro Padre que está en los cielos.", "words": [[0, 300], [6, 784], [10, 949], [13, 1169], [20, 1709], [28, 2209], [37, 2889], [45, 3329], [48, 3469], [52, 3609], [61, 4029], [66, 4609], [70, 4809], [77, 5249], [80, 5429], [87, 6044], [90, 6176], [95, 6376], [102, 7096], [105, 7176], [114, 7776], [125, 8956], [128, 9156], [136, 9556], [142, 10056], [146, 10216], [151, 10456], [154, 10656], [158, 10776]]}, {"verse": 2, "start": 11786, "end": 26686, "text": "Cuando pues haces limosna, no toques trompeta delante de ti, como hacen los hipócritas en las sinagogas y en las plazas, para ser elogiados por los hombres: de cierto os digo, que ya tienen su recompensa.", "words": [[0, 11786], [7, 12030], [12, 12390], [18, 12930], [27, 14150], [30, 14430], [37, 14870], [46, 15630], [54, 16070], [57, 16250], [61, 16870], [66, 17130], [72, 17490], [76, 17670], [87, 18650], [90, 18890], [94, 19050], [104, 19810], [106, 19950], [109, 20070], [113, 20170], [121, 20810], [126, 21210], [130, 21510], [140, 22250], [144, 22490], [148, 22650], [157, 23486], [160, 23691], [167, 24051], [170, 24411], [176, 24811], [180, 25311], [183, 25511], [190, 25871], [193, 26151]]}, {"verse": 3, "start": 27036, "end": 32064, "text": "Pero cuando tú haces limosna, no sepa tu izquierda lo que hace tu derecha;", "words": [[0, 27036], [5, 27604], [12, 28024], [15, 28264], [21, 28604], [30, 29184], [33, 29764], [38, 30104], [41, 30284], [51, 30884], [54, 31044], [58, 31204], [63, 31424], [66, 31644]]}, {"verse": 4, "start": 32414, "end": 39183, "text": "Para que sea tu limosna en secreto: y tu Padre que ve en secreto, él te recompensará en público.", "words": [[0, 32474], [5, 32654], [9, 32814], [13, 32974], [16, 33174], [24, 33634], [27, 33714], [36, 34603], [38, 34728], [41, 34828], [47, 35521], [51, 35615], [54, 35709], [57, 35803], [66, 36943], [69, 37376], [72, 37810], [85, 38243], [88, 38363]]}, {"verse": 5, "start": 39533, "end": 54534, "text": "Y cuando ores, no seas como los hipócritas; porque ellos aman el orar en las sinagogas, y en las esquinas de las calles en pie, para ser vistos de los hombres: de cierto os digo, que ya tienen su pago.", "words": [[0, 39533], [2, 39643], [9, 39903], [15, 40663], [18, 40903], [23, 41303], [28, 41603], [32, 42267], [44, 43102], [51, 43344], [57, 43644], [62, 44064], [65, 44384], [70, 44724], [73, 44884], [77, 45064], [88, 45964], [90, 46484], [93, 46644], [97, 46824], [106, 47504], [109, 47664], [113, 47804], [120, 48224], [123, 48404], [128, 48724], [133, 49304], [137, 49544], [144, 50124], [147, 50244], [151, 50384], [160, 51369], [163, 51512], [170, 51852], [173, 52332], [179, 52672], [183, 53172], [186, 53352], [193, 53632], [196, 53872]]}, {"verse": 6, "start": 54884, "end": 66407, "text": "Pero tú, cuando ores, entra en tu habitación, y cerrada tu puerta, ora a tu Padre que está en secreto; y tu Padre que ve en secreto, te recompensará en público.", "words": [[0, 54884], [5, 55029], [9, 55269], [16, 55509], [22, 56109], [28, 56629], [31, 56869], [34, 57009], [46, 57649], [48, 57884], [56, 58364], [59, 58584], [67, 59344], [71, 59724], [73, 60044], [76, 60164], [82, 60604], [86, 61024], [91, 61204], [94, 61384], [103, 62250], [105, 62375], [108, 62475], [114, 62995], [118, 63115], [121, 63315], [124, 63435], [133, 64535], [136, 64755], [149, 65615], [152, 65735]]}, {"verse": 7, "start": 66757, "end": 74918, "text": "Y orando, no uséis repeticiones sin sentido, como los Gentiles; que piensan que por su palabrería serán oídos.", "words": [[0, 66757], [2, 66917], [10, 67297], [13, 67637], [19, 68217], [32, 69217], [36, 69537], [45, 70077], [50, 70397], [54, 70557], [64, 71620], [68, 71929], [76, 72549], [80, 72709], [84, 72962], [87, 73216], [98, 73469], [104, 74289]]}, {"verse": 8, "start": 75268, "end": 84434, "text": "No os hagáis, pues, semejantes a ellos; porque vuestro Padre sabe de qué cosas tenéis necesidad, antes que vosotros le pidáis.", "words": [[0, 75268], [3, 75596], [6, 75956], [14, 76496], [20, 76836], [31, 77896], [33, 78096], [40, 78873], [47, 79078], [55, 79478], [61, 79778], [66, 80198], [69, 80418], [73, 80618], [79, 80998], [86, 81578], [97, 82418], [103, 82798], [107, 83018], [116, 83498], [119, 83698]]}, {"verse": 9, "start": 84784, "end": 91300, "text": "Vosotros pues, oraréis así: Padre nuestro que estás en los cielos, santificado sea tu nombre.", "words": [[0, 84784], [9, 85329], [15, 85609], [23, 86369], [28, 87092], [34, 87463], [42, 87683], [46, 88103], [52, 88303], [55, 88543], [59, 88703], [67, 89443], [79, 90183], [83, 90423], [86, 90623]]}, {"verse": 10, "start": 91650, "end": 97854, "text": "Venga tu reino. Sea hecha tu voluntad, como en el cielo, así también en la tierra.", "words": [[0, 91888], [6, 92158], [9, 92198], [16, 93087], [20, 93411], [26, 93871], [29, 94071], [39, 94771], [44, 95051], [47, 95251], [50, 95371], [57, 96171], [61, 96371], [69, 96831], [72, 97011], [75, 97151]]}, {"verse": 11, "start": 98204, "end": 101086, "text": "Danos hoy nuestro pan de cada día.", "words": [[0, 98204], [6, 98642], [10, 99082], [18, 99542], [22, 100002], [25, 100222], [30, 100442]]}, {"verse": 12, "start": 101436, "end": 107348, "text": "Y perdónanos nuestras deudas, como también nosotros perdonamos a nuestros deudores.", "words": [[0, 101436], [2, 101542], [13, 102242], [22, 102782], [30, 103722], [35, 103942], [43, 104402], [52, 105002], [63, 105942], [65, 106102], [74, 106262]]}, {"verse": 13, "start": 107698, "end": 117542, "text": "Y no nos metas en tentación, sino líbranos del mal: porque tuyo es el reino, y el poder, y la gloria, por todos los siglos. Amén.", "words": [[0, 107698], [2, 107825], [5, 107945], [9, 108105], [15, 108545], [18, 108705], [29, 109485], [34, 109705], [43, 110605], [47, 110865], [52, 111630], [59, 111837], [64, 112337], [67, 112457], [70, 112617], [77, 113197], [79, 113657], [82, 113797], [89, 114197], [91, 114497], [94, 114657], [102, 115137], [106, 115377], [112, 115697], [116, 115957], [124, 117010]]}, {"verse": 14, "start": 117892, "end": 124361, "text": "Porque si perdonáis a los hombres sus ofensas, os perdonará también a vosotros vuestro Padre celestial.", "words": [[0, 117892], [7, 118074], [10, 118254], [20, 118874], [22, 118994], [26, 119134], [34, 119514], [38, 119774], [47, 120754], [50, 121054], [60, 121774], [68, 122174], [70, 122394], [79, 122834], [87, 123214], [93, 123594]]}, {"verse": 15, "start": 124711, "end": 130881, "text": "Pero si no perdonáis a los hombres sus ofensas, tampoco vuestro Padre os perdonará vuestras ofensas.", "words": [[0, 124711], [5, 124855], [8, 125015], [11, 125175], [21, 125755], [23, 125875], [27, 125995], [35, 126355], [39, 126595], [48, 127515], [56, 127835], [64, 128375], [70, 128715], [73, 128935], [83, 129555], [92, 129975]]}, {"verse": 16, "start": 131231, "end": 144074, "text": "Y cuando ayunáis, no seáis como los hipócritas, sombríos; porque ellos desfiguran sus rostros para parecer a los hombres que ayunan: de cierto os digo, que ya tienen su pago.", "words": [[0, 131231], [2, 131375], [9, 131615], [18, 132575], [21, 132695], [27, 133155], [32, 133415], [36, 133595], [48, 134629], [58, 135824], [65, 136086], [71, 136506], [82, 137246], [86, 137486], [94, 138186], [99, 138706], [107, 139166], [109, 139346], [113, 139506], [121, 139806], [125, 140046], [133, 140909], [136, 141052], [143, 141392], [146, 141872], [152, 142212], [156, 142712], [159, 142892], [166, 143172], [169, 143412]]}, {"verse": 17, "start": 144424, "end": 148223, "text": "Pero tú, cuando ayunas, unge tu cabeza y lava tu rostro;", "words": [[0, 144424], [5, 144570], [9, 144810], [16, 145050], [24, 145550], [29, 146050], [32, 146190], [39, 146670], [41, 147210], [46, 147370], [49, 147610]]}, {"verse": 18, "start": 148573, "end": 158080, "text": "Para no parecer a los hombres que ayunas, sino a tu Padre que está en secreto: y tu Padre que ve en secreto, te recompensará en público.", "words": [[0, 148573], [5, 148853], [8, 149243], [16, 149633], [18, 149753], [22, 149913], [30, 150253], [34, 150513], [42, 151213], [47, 151593], [49, 151853], [52, 151973], [58, 152353], [62, 152573], [67, 152793], [70, 152953], [79, 153923], [81, 154048], [84, 154148], [90, 154668], [94, 154788], [97, 154988], [100, 155108], [109, 156208], [112, 156428], [125, 157288], [128, 157408]]}, {"verse": 19, "start": 158430, "end": 166086, "text": "No os hagáis tesoros en la tierra, donde la polilla y el óxido corrompen, y donde ladrones entran a robar;", "words": [[0, 158430], [3, 158635], [6, 158835], [13, 159175], [21, 159875], [24, 159995], [27, 160135], [35, 160555], [41, 161115], [44, 161375], [52, 161855], [54, 162015], [57, 162115], [63, 162535], [74, 163295], [76, 163735], [82, 163975], [91, 164615], [98, 165355], [100, 165515]]}, {"verse": 20, "start": 166436, "end": 175392, "text": "Pero haceos tesoros en el cielo, donde ni polilla ni óxido corrompen, y donde ladrones no entran a robar:", "words": [[0, 166436], [5, 166900], [12, 167400], [20, 168140], [23, 168320], [26, 168460], [33, 169520], [39, 169960], [42, 170340], [50, 171020], [53, 171240], [59, 171780], [70, 172500], [72, 172720], [78, 173020], [87, 173820], [90, 174260], [97, 174660], [99, 174800]]}, {"verse": 21, "start": 175742, "end": 179694, "text": "Porque donde esté vuestro tesoro, allí estará vuestro corazón.", "words": [[0, 175742], [7, 175926], [13, 176186], [18, 176506], [26, 176886], [34, 177726], [39, 178206], [46, 178686], [54, 179046]]}, {"verse": 22, "start": 180044, "end": 187371, "text": "La lámpara del cuerpo es el ojo: así que, si tu ojo es bueno, todo tu cuerpo estará lleno de luz:", "words": [[0, 180044], [3, 180198], [11, 180738], [15, 180938], [22, 181398], [25, 181818], [28, 182158], [33, 182735], [37, 182940], [42, 183420], [45, 183680], [48, 183880], [52, 184160], [55, 184300], [62, 185100], [67, 185280], [70, 185540], [77, 185880], [84, 186420], [90, 186740], [93, 186860]]}, {"verse": 23, "start": 187721, "end": 197714, "text": "Pero si tu ojo es maligno, todo tu cuerpo estará en tinieblas. Así que, si la luz que en ti hay es tinieblas, ¿cuántas serán las mismas tinieblas?", "words": [[0, 187721], [5, 187865], [8, 188085], [11, 188265], [15, 188545], [18, 188665], [27, 189665], [32, 189825], [35, 190085], [42, 190405], [49, 190905], [52, 191461], [63, 192173], [67, 192465], [72, 192665], [75, 192865], [78, 193025], [82, 193265], [86, 193505], [89, 193685], [92, 193865], [96, 194145], [99, 194485], [110, 195685], [119, 196225], [125, 196525], [129, 196665], [136, 197005]]}, {"verse": 24, "start": 198064, "end": 211685, "text": "Ninguno puede servir a dos señores; porque o aborrecerá al uno y amará al otro, o se llegará al uno y menospreciará al otro: no podéis servir a Dios y a las riquezas.", "words": [[0, 198064], [8, 198512], [14, 198732], [21, 199132], [23, 199332], [27, 199492], [36, 200470], [43, 200872], [45, 201352], [56, 202292], [59, 202532], [63, 202812], [65, 203072], [71, 203412], [74, 203732], [80, 204492], [82, 204792], [85, 204932], [93, 205372], [96, 205692], [100, 206012], [102, 206802], [116, 207592], [119, 207912], [125, 208645], [128, 208813], [135, 209293], [142, 209793], [144, 210093], [149, 210313], [151, 210653], [153, 210733], [157, 210853]]}, {"verse": 25, "start": 212035, "end": 225407, "text": "Por tanto os digo: No os preocupéis por vuestra vida, qué habéis de comer, o qué habéis de beber; ni por vuestro cuerpo, qué habéis de vestir: ¿no es la vida más que el alimento, y el cuerpo que el vestido?", "words": [[0, 212035], [4, 212229], [10, 212455], [13, 212682], [19, 213438], [22, 213666], [25, 213806], [36, 214586], [40, 214806], [48, 215206], [54, 215866], [58, 215986], [65, 216346], [68, 216486], [75, 216766], [77, 217086], [81, 217266], [88, 217646], [91, 217786], [98, 218613], [101, 218713], [105, 218953], [113, 219353], [121, 219793], [125, 220213], [132, 220633], [135, 220773], [143, 221645], [147, 221834], [150, 221954], [153, 222094], [158, 222294], [162, 222494], [166, 222694], [169, 222834], [179, 223294], [181, 223594], [184, 223774], [191, 224294], [195, 224574], [198, 224694]]}, {"verse": 26, "start": 225757, "end": 237540, "text": "Mirad las aves del cielo, que no siembran, ni siegan, ni recogen en graneros; y vuestro Padre celestial las alimenta. ¿No sois vosotros mucho mejores que ellas?", "words": [[0, 225757], [6, 226125], [10, 226265], [15, 226625], [19, 226805], [26, 227145], [30, 227385], [33, 227545], [43, 228385], [46, 228905], [54, 229425], [57, 229665], [65, 230425], [68, 230605], [78, 231643], [80, 231741], [88, 232081], [94, 232501], [104, 233141], [108, 233521], [118, 234654], [122, 234761], [127, 235201], [136, 235921], [142, 236221], [150, 236641], [154, 236881]]}, {"verse": 27, "start": 237890, "end": 243639, "text": "Pero ¿quién de vosotros podrá, preocupándose, añadir a su estatura un codo?", "words": [[0, 237890], [5, 238012], [12, 238492], [15, 238592], [24, 238992], [31, 239452], [46, 241012], [53, 241632], [55, 241732], [58, 241892], [67, 242372], [70, 242572]]}, {"verse": 28, "start": 243989, "end": 252076, "text": "Y por el vestido ¿por qué os preocupáis? Observad los lirios del campo, cómo crecen; no trabajan ni hilan;", "words": [[0, 243989], [2, 243989], [6, 244154], [9, 244294], [17, 244956], [22, 245079], [26, 245379], [29, 245559], [41, 246896], [50, 247477], [54, 247657], [61, 247947], [65, 248237], [72, 248997], [77, 249257], [85, 250215], [88, 250422], [97, 251182], [100, 251422]]}, {"verse": 29, "start": 252426, "end": 257756, "text": "Pero os digo, que ni aun Salomón con toda su gloria fue vestido así como uno de ellos.", "words": [[0, 252426], [5, 252570], [8, 252750], [14, 253010], [18, 253320], [21, 253630], [25, 253890], [33, 254630], [37, 254810], [42, 255090], [45, 255350], [52, 255730], [56, 255950], [64, 256390], [68, 256550], [73, 256830], [77, 257030], [80, 257210]]}, {"verse": 30, "start": 258106, "end": 268815, "text": "Y si la hierba del campo que hoy es, y mañana es echada en el horno, Dios la viste así, ¿no hará mucho más a vosotros, hombres de poca fe?", "words": [[0, 258106], [2, 258230], [5, 258350], [8, 258510], [15, 258970], [19, 259130], [25, 259610], [29, 259870], [33, 260090], [37, 260970], [39, 261050], [46, 261370], [49, 261630], [56, 262010], [59, 262150], [62, 262270], [69, 263050], [74, 263370], [77, 263690], [83, 264010], [88, 264830], [92, 265230], [97, 265510], [103, 265770], [107, 266130], [109, 266310], [119, 267170], [127, 267750], [130, 268070], [135, 268410]]}, {"verse": 31, "start": 269165, "end": 275056, "text": "No os preocupéis pues, diciendo: ¿Qué comeremos, o qué beberemos, o con qué nos vestiremos?", "words": [[0, 269165], [3, 269452], [6, 269712], [17, 270492], [23, 271092], [33, 272111], [38, 272205], [49, 272785], [51, 273145], [55, 273305], [66, 273865], [68, 274245], [72, 274485], [76, 274665], [80, 274860]]}, {"verse": 32, "start": 275406, "end": 283693, "text": "Porque los Gentiles buscan todas estas cosas: que vuestro Padre celestial sabe que necesitáis todas estas cosas.", "words": [[0, 276064], [7, 276344], [11, 276524], [20, 277024], [27, 277464], [33, 277744], [39, 278064], [46, 279058], [50, 279313], [58, 279673], [64, 280093], [74, 280653], [79, 281033], [83, 281273], [94, 282293], [100, 282593], [106, 282953]]}, {"verse": 33, "start": 284043, "end": 291676, "text": "Pero buscad primeramente el reino de Dios y su justicia, y todas estas cosas os serán añadidas.", "words": [[0, 284043], [5, 284210], [12, 284710], [25, 285490], [28, 285670], [34, 286070], [37, 286210], [42, 286510], [44, 286970], [47, 287130], [57, 287810], [59, 288550], [65, 288830], [71, 289130], [77, 289630], [80, 290290], [86, 290730]]}, {"verse": 34, "start": 292026, "end": 300017, "text": "Así que, no os preocupéis por el día de mañana; que el día de mañana traerá su fatiga: basta al día su afán.", "words": [[0, 292026], [4, 292316], [9, 292536], [12, 292756], [15, 292956], [26, 293636], [30, 293856], [33, 293996], [37, 294156], [40, 294296], [48, 295130], [52, 295254], [55, 295434], [59, 295674], [62, 295814], [69, 296294], [76, 296994], [79, 297154], [87, 298228], [93, 298674], [96, 298974], [100, 299334], [103, 299434]]}]}