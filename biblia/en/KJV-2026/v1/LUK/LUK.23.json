{"book": "LUK", "chapter": 23, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 364172, "verses": [{"verse": 1, "start": 300, "end": 3386, "text": "And the whole multitude of them arose, and led him to Pilate.", "words": [[0, 300], [4, 423], [8, 523], [14, 703], [24, 1203], [27, 1423], [32, 1603], [39, 1983], [43, 2298], [47, 2518], [51, 2678], [54, 3066]]}, {"verse": 2, "start": 3736, "end": 11973, "text": "And they began to accuse him, saying, We found this fellow perverting the nation, and forbidding to give tribute to Cæsar, saying that he himself is Christ a King.", "words": [[0, 3736], [4, 3860], [9, 3960], [15, 4260], [18, 4440], [25, 4780], [30, 5180], [38, 5926], [41, 6032], [47, 6272], [52, 6452], [59, 6672], [70, 7192], [74, 7332], [82, 7652], [86, 8072], [97, 8552], [100, 8672], [105, 8852], [113, 9172], [116, 9452], [123, 9732], [130, 10312], [135, 10512], [138, 10712], [146, 11052], [149, 11232], [156, 11422], [158, 11612]]}, {"verse": 3, "start": 12253, "end": 18476, "text": "And Pilate asked him, saying, Are you the King of the Jews? And he answered him and said, You say it.", "words": [[0, 12253], [4, 12390], [11, 12910], [17, 13190], [22, 13390], [30, 14215], [34, 14350], [38, 14490], [42, 14630], [47, 14830], [50, 14990], [54, 15090], [60, 15939], [64, 16100], [67, 16260], [76, 16640], [80, 16900], [84, 17060], [90, 17680], [94, 17867], [98, 18147]]}, {"verse": 4, "start": 18756, "end": 23868, "text": "Then said Pilate to the chief priests and to the people, I find no fault in this man.", "words": [[0, 18756], [5, 18964], [10, 19224], [17, 19744], [20, 19864], [24, 19984], [30, 20224], [38, 20644], [42, 21284], [45, 21504], [49, 21584], [57, 22236], [59, 22356], [64, 22596], [67, 22856], [73, 23136], [76, 23356], [81, 23496]]}, {"verse": 5, "start": 24148, "end": 31513, "text": "And they were the more fierce, saying, He stirs up the people, teaching throughout all Judea, beginning from Galilee to this place.", "words": [[0, 24148], [4, 24273], [9, 24413], [14, 24553], [18, 24673], [23, 24893], [31, 25633], [39, 26588], [42, 26677], [48, 27057], [51, 27177], [55, 27317], [63, 27757], [72, 27997], [83, 28317], [87, 28677], [94, 29677], [104, 29817], [109, 30097], [117, 30577], [120, 30757], [125, 30937]]}, {"verse": 6, "start": 31793, "end": 35650, "text": "When Pilate heard of Galilee, he asked whether the man were a Galilæan.", "words": [[0, 31793], [5, 31979], [12, 32419], [18, 32539], [21, 32679], [30, 33359], [33, 33439], [39, 33799], [47, 34059], [51, 34239], [55, 34499], [60, 34699], [62, 35207]]}, {"verse": 7, "start": 36000, "end": 43886, "text": "And as soon as he knew that he belonged to Herod’s jurisdiction, he sent him to Herod, who himself also was at Jerusalem at that time.", "words": [[0, 36000], [4, 36153], [7, 36273], [12, 36493], [15, 36633], [18, 36753], [23, 36993], [28, 37173], [31, 37273], [40, 37593], [43, 37833], [51, 38313], [65, 39533], [68, 39693], [73, 39933], [77, 40093], [80, 40233], [87, 40933], [91, 41173], [99, 41533], [104, 42033], [108, 42333], [111, 42433], [121, 42933], [124, 43233], [129, 43413]]}, {"verse": 8, "start": 44236, "end": 55578, "text": "¶ And when Herod saw Jesus, he was exceeding glad: for he was desirous to see him of a long season, because he had heard many things of him; and he hoped to have seen some miracle done by him.", "words": [[2, 44236], [6, 44374], [11, 44494], [17, 44854], [21, 45054], [28, 45714], [31, 45754], [35, 45954], [45, 46534], [51, 47371], [55, 47491], [58, 47631], [62, 47831], [71, 48471], [74, 48611], [78, 48851], [82, 49031], [85, 49211], [87, 49351], [92, 49591], [100, 50471], [108, 50871], [111, 51151], [115, 51291], [121, 51531], [126, 51831], [133, 52131], [136, 52411], [141, 52949], [145, 53072], [148, 53172], [154, 53392], [157, 53592], [162, 53712], [167, 53932], [172, 54152], [180, 54552], [185, 54932], [188, 55172]]}, {"verse": 9, "start": 55928, "end": 59811, "text": "Then he questioned with him in many words; but he answered him nothing.", "words": [[0, 55928], [5, 56096], [8, 56176], [19, 56536], [24, 56856], [28, 56996], [31, 57136], [36, 57376], [43, 58523], [47, 58621], [50, 58781], [59, 59061], [63, 59241]]}, {"verse": 10, "start": 60161, "end": 64380, "text": "And the chief priests and scribes stood and vehemently accused him.", "words": [[0, 60161], [4, 60318], [8, 60398], [14, 60658], [22, 61118], [26, 61498], [34, 62238], [40, 62638], [44, 62998], [55, 63598], [63, 63938]]}, {"verse": 11, "start": 64730, "end": 73232, "text": "And Herod with his men of war treated him with contempt, and mocked him, and arrayed him in a gorgeous robe, and sent him again to Pilate.", "words": [[0, 64730], [4, 64890], [10, 65330], [15, 65430], [19, 65610], [23, 65830], [26, 65970], [30, 66370], [38, 66590], [42, 66850], [47, 67030], [57, 67990], [61, 68190], [68, 68650], [73, 69210], [77, 69290], [85, 69690], [89, 69830], [92, 69950], [94, 70070], [103, 70410], [109, 71490], [113, 71590], [118, 71850], [122, 72090], [128, 72390], [131, 72845]]}, {"verse": 12, "start": 73582, "end": 80375, "text": "¶ And the same day Pilate and Herod were made friends together: for before they were at enmity between themselves.", "words": [[2, 73582], [6, 73726], [10, 73826], [15, 74066], [19, 74446], [26, 74826], [30, 75246], [36, 75706], [41, 75906], [46, 76146], [54, 76526], [64, 77456], [68, 77696], [75, 78036], [80, 78256], [85, 78456], [88, 78576], [95, 79016], [103, 79336]]}, {"verse": 13, "start": 80725, "end": 86249, "text": "¶ And Pilate, when he had called together the chief priests and the rulers and the people,", "words": [[2, 80725], [6, 80869], [14, 81369], [19, 81569], [22, 81749], [26, 81889], [33, 82169], [42, 82589], [46, 82849], [52, 83109], [60, 83569], [64, 83929], [68, 84049], [75, 84349], [79, 84669], [83, 84769]]}, {"verse": 14, "start": 86599, "end": 97199, "text": "Said to them, You have brought this man to me, as one that perverts the people: and, behold, I, having examined him before you, have found no fault in this man touching those things of which you accuse him:", "words": [[0, 86599], [5, 86836], [8, 86977], [14, 87318], [18, 87434], [23, 87574], [31, 87794], [36, 88014], [40, 88234], [43, 88414], [47, 88594], [50, 89114], [54, 89334], [59, 89704], [68, 90074], [72, 90154], [80, 90813], [85, 90936], [93, 91616], [96, 91996], [103, 92156], [112, 92556], [116, 92756], [123, 93076], [128, 93656], [133, 93776], [139, 93996], [142, 94196], [148, 94476], [151, 94636], [156, 94816], [160, 94976], [169, 95276], [175, 95576], [182, 95796], [185, 95996], [191, 96136], [195, 96256], [202, 96516]]}, {"verse": 15, "start": 97549, "end": 102904, "text": "No, nor yet Herod: for I sent you to him; and, lo, nothing worthy of death is done to him.", "words": [[0, 97549], [4, 97549], [8, 97748], [12, 98008], [19, 98761], [23, 98905], [25, 99105], [30, 99385], [34, 99565], [37, 99725], [42, 100247], [47, 100418], [51, 101138], [59, 101138], [66, 101518], [69, 101778], [75, 102038], [78, 102218], [83, 102438], [86, 102618]]}, {"verse": 16, "start": 103254, "end": 105740, "text": "I will therefore chastise him, and release him.", "words": [[0, 103254], [2, 103398], [7, 103578], [17, 103958], [26, 104638], [31, 104798], [35, 105038], [43, 105318]]}, {"verse": 17, "start": 106020, "end": 109211, "text": "(For of necessity he must release one to them at the feast.)", "words": [[0, 106020], [5, 106153], [8, 106313], [18, 107053], [21, 107153], [26, 107333], [34, 107753], [38, 108013], [41, 108213], [46, 108393], [49, 108573], [53, 108653]]}, {"verse": 18, "start": 109561, "end": 114516, "text": "And they cried out all at once, saying, Away with this man, and release to us Barabbas:", "words": [[0, 109561], [4, 109681], [9, 109781], [15, 110061], [19, 110341], [23, 110541], [26, 110681], [32, 111061], [40, 111664], [45, 111933], [50, 112153], [55, 112353], [60, 112613], [64, 113033], [72, 113353], [75, 113593], [78, 114083]]}, {"verse": 19, "start": 114796, "end": 119690, "text": "(Who for a certain sedition made in the city, and for murder, was cast into prison.)", "words": [[0, 114796], [5, 114893], [9, 115053], [11, 115213], [19, 115473], [28, 116033], [33, 116293], [36, 116453], [40, 116553], [46, 116873], [50, 117453], [54, 117633], [62, 117953], [66, 118513], [71, 118793], [76, 119093]]}, {"verse": 20, "start": 120040, "end": 124391, "text": "Pilate therefore, willing to release Jesus, spoke again to them.", "words": [[0, 120040], [7, 120780], [18, 121040], [26, 121440], [29, 121680], [37, 122020], [44, 122900], [50, 123060], [56, 123380], [59, 123580]]}, {"verse": 21, "start": 124741, "end": 127786, "text": "But they cried, saying, Crucify him, crucify him.", "words": [[0, 124741], [4, 124835], [9, 124975], [16, 125255], [24, 126147], [32, 126627], [37, 126987], [45, 127407]]}, {"verse": 22, "start": 128066, "end": 136591, "text": "And he said to them the third time, Why, what evil has he done? I have found no cause of death in him: I will therefore chastise him, and let him go.", "words": [[0, 128066], [4, 128196], [7, 128316], [12, 128556], [15, 128756], [20, 128936], [24, 129136], [30, 129396], [36, 130213], [41, 130471], [46, 130751], [51, 130951], [55, 131171], [58, 131291], [64, 131912], [66, 132068], [71, 132188], [77, 132428], [80, 132648], [86, 133008], [89, 133208], [95, 133408], [98, 133588], [103, 134137], [105, 134253], [110, 134413], [120, 134793], [129, 135533], [134, 135713], [138, 135973], [142, 136133], [146, 136253]]}, {"verse": 23, "start": 136871, "end": 144484, "text": "And they were instant with loud voices, requiring that he might be crucified. And the voices of them and of the chief priests prevailed.", "words": [[0, 136871], [4, 137017], [9, 137137], [14, 137277], [22, 137717], [27, 137937], [32, 138217], [40, 139017], [50, 139557], [55, 139837], [58, 139937], [64, 140137], [67, 140277], [78, 141342], [82, 141485], [86, 141585], [93, 141905], [96, 142165], [101, 142425], [105, 142705], [108, 142825], [112, 142925], [118, 143145], [126, 143625]]}, {"verse": 24, "start": 144834, "end": 148094, "text": "And Pilate gave sentence that it should be as they required.", "words": [[0, 144834], [4, 145078], [11, 145348], [16, 145688], [25, 146088], [30, 146428], [33, 146548], [40, 146728], [43, 146968], [46, 147128], [51, 147288]]}, {"verse": 25, "start": 148444, "end": 156027, "text": "And he released to them him that for sedition and murder was cast into prison, whom they had desired; but he delivered Jesus to their will.", "words": [[0, 148444], [4, 148602], [7, 148762], [16, 149162], [19, 149362], [24, 149502], [28, 149782], [33, 150102], [37, 150282], [46, 150782], [50, 150962], [57, 151262], [61, 151482], [66, 151742], [71, 152022], [79, 152402], [84, 152707], [89, 152907], [93, 153027], [102, 153931], [106, 154049], [109, 154149], [119, 154529], [125, 155049], [128, 155349], [134, 155529]]}, {"verse": 26, "start": 156377, "end": 166685, "text": "And as they led him away, they laid hold upon one Simon, a Cyrenian, coming out of the country, and on him they laid the cross, that he might bear it after Jesus.", "words": [[0, 156377], [4, 156499], [7, 156699], [12, 156859], [16, 157079], [20, 157219], [26, 158039], [31, 158119], [36, 158319], [41, 158559], [46, 158919], [50, 159239], [57, 160139], [59, 160619], [69, 161099], [76, 161279], [80, 161519], [83, 161619], [87, 161739], [96, 162519], [100, 162719], [103, 162919], [107, 163179], [112, 163379], [117, 163599], [121, 163759], [128, 164613], [133, 164752], [136, 164892], [142, 165112], [147, 165452], [150, 165592], [156, 165892]]}, {"verse": 27, "start": 167035, "end": 172785, "text": "¶ And there followed him a great company of people, and of women, which also bewailed and lamented him.", "words": [[2, 167035], [6, 167170], [12, 167310], [21, 167650], [25, 167910], [27, 168010], [33, 168250], [41, 168690], [44, 168950], [52, 169290], [56, 169650], [59, 169790], [66, 170290], [72, 170530], [77, 170930], [86, 171590], [90, 171830], [99, 172430]]}, {"verse": 28, "start": 173135, "end": 179959, "text": "But Jesus turning to them said, Daughters of Jerusalem, weep not for me, but weep for yourselves, and for your children.", "words": [[0, 173135], [4, 173336], [10, 173656], [18, 174136], [21, 174396], [26, 174576], [32, 175321], [42, 175681], [45, 175841], [56, 176381], [61, 176761], [65, 176921], [69, 177161], [73, 177661], [77, 177741], [82, 178041], [86, 178141], [98, 178581], [102, 179081], [106, 179241], [111, 179361]]}, {"verse": 29, "start": 180309, "end": 188856, "text": "For, behold, the days are coming, in which they shall say, Blessed are the barren, and the wombs that never bore, and the paps which never gave suck.", "words": [[0, 180309], [5, 180397], [13, 181157], [17, 181257], [22, 181557], [26, 181717], [34, 182497], [37, 182637], [43, 182797], [48, 182997], [54, 183257], [59, 183837], [67, 184157], [71, 184457], [75, 184577], [83, 185197], [87, 185437], [91, 185637], [97, 185837], [102, 186077], [108, 186277], [114, 187057], [118, 187177], [122, 187297], [127, 187637], [133, 187777], [139, 188037], [144, 188277]]}, {"verse": 30, "start": 189206, "end": 194579, "text": "Then shall they begin to say to the mountains, Fall on us; and to the hills, Cover us.", "words": [[0, 189206], [5, 189462], [11, 189782], [16, 189962], [22, 190222], [25, 190442], [29, 190722], [32, 190902], [36, 191042], [47, 191782], [52, 192082], [55, 192382], [59, 192933], [63, 193118], [66, 193238], [70, 193358], [77, 193698], [83, 194178]]}, {"verse": 31, "start": 194929, "end": 199614, "text": "For if they do these things in a green tree, what shall be done in the dry?", "words": [[0, 194929], [4, 195089], [7, 195369], [12, 195589], [15, 195849], [21, 196089], [28, 196449], [31, 196689], [33, 196809], [39, 197029], [45, 197909], [50, 198109], [56, 198369], [59, 198549], [64, 198849], [67, 199049], [71, 199129]]}, {"verse": 32, "start": 199894, "end": 204433, "text": "And there were also two other, malefactors, led with him to be put to death.", "words": [[0, 199894], [4, 200046], [10, 200146], [15, 200286], [20, 200646], [24, 200926], [31, 201306], [44, 202626], [48, 202826], [53, 203086], [57, 203266], [60, 203426], [63, 203566], [67, 203766], [70, 203926]]}, {"verse": 33, "start": 204783, "end": 214539, "text": "And when they were come to the place, which is called Calvary, there they crucified him, and the malefactors, one on the right hand, and the other on the left.", "words": [[0, 204783], [4, 204913], [9, 205073], [14, 205253], [19, 205393], [24, 205633], [27, 205813], [31, 205933], [38, 206573], [44, 206693], [47, 206833], [54, 207093], [63, 208293], [69, 208713], [74, 209153], [84, 209553], [89, 210553], [93, 210733], [97, 210833], [110, 211833], [114, 212113], [117, 212273], [121, 212353], [127, 212553], [133, 212933], [137, 213433], [141, 213593], [147, 213753], [150, 213973], [154, 214053]]}, {"verse": 34, "start": 214889, "end": 222536, "text": "¶ Then said Jesus, Father, forgive them; for they know not what they do. And they parted his clothing, and cast lots.", "words": [[2, 214889], [7, 215138], [12, 215398], [19, 216350], [27, 216883], [35, 217203], [41, 217903], [45, 218002], [50, 218182], [55, 218422], [59, 218742], [64, 219002], [69, 219182], [73, 219970], [77, 220119], [82, 220219], [89, 220679], [93, 220799], [103, 221179], [107, 221479], [112, 221819]]}, {"verse": 35, "start": 222886, "end": 232072, "text": "And the people stood beholding. And the rulers also with them derided him, saying, He saved others; let him save himself, if he be Christ, the chosen of God.", "words": [[0, 222886], [4, 222990], [8, 223110], [15, 223370], [21, 223650], [32, 224669], [36, 224811], [40, 224911], [47, 225271], [52, 225671], [57, 226011], [62, 226231], [70, 226771], [75, 227131], [83, 227800], [86, 227920], [92, 228220], [100, 229068], [104, 229213], [108, 229333], [113, 229533], [122, 229913], [125, 230133], [128, 230233], [131, 230333], [139, 231093], [143, 231193], [150, 231493], [153, 231693]]}, {"verse": 36, "start": 232352, "end": 236298, "text": "And the soldiers also mocked him, coming to him, and offering him vinegar,", "words": [[0, 232352], [4, 232473], [8, 232553], [17, 232853], [22, 233233], [29, 233813], [34, 234013], [41, 234233], [44, 234493], [49, 235073], [53, 235193], [62, 235533], [66, 235733]]}, {"verse": 37, "start": 236648, "end": 239791, "text": "And saying, If you be the king of the Jews, save yourself.", "words": [[0, 236648], [4, 236802], [12, 237551], [15, 237691], [19, 237791], [22, 237891], [26, 238011], [31, 238191], [34, 238331], [38, 238431], [44, 238931], [49, 239211]]}, {"verse": 38, "start": 240071, "end": 247768, "text": "And an inscription also was written over him in letters of Greek, and Latin, and Hebrew, THIS IS THE KING OF THE JEWS.", "words": [[0, 240071], [4, 240237], [7, 240337], [19, 240737], [24, 241357], [28, 241677], [36, 241917], [41, 242277], [45, 242557], [48, 242857], [56, 243137], [59, 243417], [66, 243757], [70, 244217], [77, 244557], [81, 244862], [89, 245762], [94, 246122], [97, 246462], [101, 246622], [106, 246862], [109, 247022], [113, 247142]]}, {"verse": 39, "start": 248118, "end": 253991, "text": "¶ And one of the malefactors which were hanged railed on him, saying, If you be Christ, save yourself and us.", "words": [[2, 248118], [6, 248240], [10, 248380], [13, 248520], [17, 248620], [29, 249380], [35, 249560], [40, 249740], [47, 250200], [54, 250540], [57, 250680], [62, 250960], [70, 251739], [73, 251892], [77, 251972], [80, 252112], [88, 252932], [93, 253072], [102, 253392], [106, 253612]]}, {"verse": 40, "start": 254271, "end": 260250, "text": "But the other answering rebuked him, saying, Do you not fear God, seeing you are in the same condemnation?", "words": [[0, 254271], [4, 254375], [8, 254535], [14, 254735], [24, 255275], [32, 255895], [37, 256155], [45, 256940], [48, 257080], [52, 257200], [56, 257400], [61, 257700], [66, 258100], [73, 258540], [77, 258780], [81, 258900], [84, 259000], [88, 259100], [93, 259320]]}, {"verse": 41, "start": 260600, "end": 267013, "text": "And we indeed justly; for we receive the due reward of our deeds: but this man has done nothing amiss.", "words": [[0, 260600], [4, 260742], [7, 260922], [14, 261202], [22, 262159], [26, 262283], [29, 262463], [37, 262843], [41, 263023], [45, 263223], [52, 263603], [55, 263783], [59, 263903], [66, 264607], [70, 264706], [75, 264926], [79, 265146], [83, 265306], [88, 265506], [96, 265846]]}, {"verse": 42, "start": 267293, "end": 271941, "text": "And he said to Jesus, Lord, remember me when you come into your kingdom.", "words": [[0, 267293], [4, 267414], [7, 267514], [12, 267734], [15, 267914], [22, 268791], [28, 269615], [37, 270015], [40, 270415], [45, 270715], [49, 270855], [54, 271095], [59, 271275], [64, 271415]]}, {"verse": 43, "start": 272221, "end": 278126, "text": "And Jesus said to him, Assuredly I say to you, Today shall you be with me in paradise.", "words": [[0, 272221], [4, 272372], [10, 272672], [15, 273072], [18, 273272], [23, 273774], [33, 274436], [35, 274576], [39, 274856], [42, 275016], [47, 275796], [53, 276036], [59, 276376], [63, 276556], [66, 276716], [71, 276956], [74, 277136], [77, 277276]]}, {"verse": 44, "start": 278406, "end": 283786, "text": "And it was about the sixth hour, and there was a darkness over all the earth until the ninth hour.", "words": [[0, 278406], [4, 278517], [7, 278597], [11, 278737], [17, 278997], [21, 279177], [27, 279457], [33, 280357], [37, 280637], [43, 280737], [47, 280897], [49, 281017], [58, 281397], [63, 281777], [67, 282077], [71, 282257], [77, 282497], [83, 282777], [87, 282997], [93, 283277]]}, {"verse": 45, "start": 284136, "end": 288150, "text": "And the sun was darkened, and the veil of the temple was torn in two.", "words": [[0, 284136], [4, 284288], [8, 284388], [12, 284648], [16, 284868], [26, 285648], [30, 285868], [34, 286008], [39, 286288], [42, 286448], [46, 286568], [53, 286868], [57, 287148], [62, 287468], [65, 287648]]}, {"verse": 46, "start": 288500, "end": 297013, "text": "¶ And when Jesus had cried with a loud voice, he said, Father, into your hands I commend my spirit: and having said thus, he breathed his last.", "words": [[2, 288500], [6, 288644], [11, 288804], [17, 289164], [21, 289444], [27, 289804], [32, 290004], [34, 290144], [39, 290364], [46, 290904], [49, 290984], [55, 291651], [63, 292085], [68, 292205], [73, 292405], [79, 292725], [81, 292925], [89, 293265], [92, 293545], [100, 294373], [104, 294483], [111, 294683], [116, 295003], [122, 295683], [125, 295763], [134, 296303], [138, 296443]]}, {"verse": 47, "start": 297293, "end": 304408, "text": "Now when the centurion saw what was done, he glorified God, saying, Certainly this was a righteous man.", "words": [[0, 297293], [4, 297524], [9, 297744], [13, 297904], [23, 298524], [27, 298884], [32, 299124], [36, 299344], [42, 300104], [45, 300184], [55, 300844], [60, 301464], [68, 302772], [78, 303047], [83, 303247], [87, 303407], [89, 303507], [99, 303847]]}, {"verse": 48, "start": 304688, "end": 312254, "text": "And all the people that came together to that sight, beholding the things which were done, struck their breasts, and returned.", "words": [[0, 304688], [4, 304801], [8, 305081], [12, 305301], [19, 305561], [24, 305801], [29, 306061], [38, 306541], [41, 306761], [46, 306981], [53, 307861], [63, 308441], [67, 308561], [74, 308841], [80, 309101], [85, 309281], [91, 310021], [98, 310301], [104, 310561], [113, 311481], [117, 311561]]}, {"verse": 49, "start": 312604, "end": 319193, "text": "And all his acquaintance, and the women that followed him from Galilee, stood afar off, beholding these things.", "words": [[0, 312604], [4, 312747], [8, 313027], [12, 313287], [26, 314287], [30, 314467], [34, 314587], [40, 314847], [45, 315067], [54, 315387], [58, 315647], [63, 315827], [72, 316427], [78, 316747], [83, 317087], [88, 317847], [98, 318447], [104, 318607]]}, {"verse": 50, "start": 319543, "end": 325456, "text": "¶ And, behold, there was a man named Joseph, a counsellor; and he was a good man, and a just:", "words": [[2, 319543], [7, 319671], [15, 320431], [21, 320531], [25, 320691], [27, 320811], [31, 321051], [37, 321311], [45, 322291], [47, 322715], [59, 323297], [63, 323430], [66, 323530], [70, 323690], [72, 323810], [77, 323990], [82, 324390], [86, 324770], [88, 324910]]}, {"verse": 51, "start": 325806, "end": 334715, "text": "(The same had not consented to the counsel and deed of them;) he was of Arimathæa, a city of the Jews: who also himself waited for the kingdom of God.", "words": [[0, 325806], [5, 325932], [10, 326132], [14, 326312], [18, 326472], [28, 326972], [31, 327152], [35, 327357], [43, 327562], [47, 327767], [52, 327972], [55, 328232], [62, 328952], [65, 329072], [69, 329252], [72, 329852], [83, 330452], [85, 330512], [90, 330752], [93, 330952], [97, 331072], [103, 331889], [107, 331999], [112, 332279], [120, 332779], [127, 333259], [131, 333559], [135, 333679], [143, 333939], [146, 334179]]}, {"verse": 52, "start": 335065, "end": 338497, "text": "This man went to Pilate, and begged the body of Jesus.", "words": [[0, 335065], [5, 335274], [9, 335614], [14, 335814], [17, 336014], [25, 336574], [29, 336874], [36, 337174], [40, 337354], [45, 337614], [48, 337774]]}, {"verse": 53, "start": 338847, "end": 346259, "text": "And he took it down, and wrapped it in linen, and laid it in a tomb that was hewn in stone, in which never man before was laid.", "words": [[0, 338847], [4, 338969], [7, 339049], [12, 339249], [15, 339369], [21, 340009], [25, 340069], [33, 340389], [36, 340569], [39, 340709], [46, 341409], [50, 341589], [55, 341809], [58, 341969], [61, 342109], [63, 342209], [68, 342549], [73, 342749], [77, 342909], [82, 343119], [85, 343329], [92, 344189], [95, 344349], [101, 344509], [107, 344809], [111, 345069], [118, 345389], [122, 345709]]}, {"verse": 54, "start": 346609, "end": 349897, "text": "And that day was the preparation, and the sabbath drew on.", "words": [[0, 346609], [4, 346750], [9, 346990], [13, 347190], [17, 347390], [21, 347510], [34, 348370], [38, 348490], [42, 348630], [50, 348950], [55, 349330]]}, {"verse": 55, "start": 350247, "end": 357387, "text": "And the women also, which came with him from Galilee, followed after, and beheld the tomb, and how his body was laid.", "words": [[0, 350247], [4, 350396], [8, 350516], [14, 350736], [20, 351336], [26, 351536], [31, 351796], [36, 352036], [40, 352176], [45, 352376], [54, 353376], [63, 353656], [70, 354096], [74, 354436], [81, 354836], [85, 355016], [91, 355376], [95, 355916], [99, 356116], [103, 356276], [108, 356596], [112, 356816]]}, {"verse": 56, "start": 357737, "end": 363772, "text": "And they returned, and prepared spices and ointments; and rested the sabbath day according to the commandment.", "words": [[0, 357737], [4, 357890], [9, 358010], [19, 358510], [23, 358710], [32, 359050], [39, 359590], [43, 359890], [54, 360822], [58, 360967], [65, 361307], [69, 361547], [77, 361907], [81, 362307], [91, 362647], [94, 362947], [98, 363067]]}]}