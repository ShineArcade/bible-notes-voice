{"book": "1CO", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 91723, "verses": [{"verse": 1, "start": 300, "end": 7656, "text": "Si yo hablase lenguas humanas y angélicas, y no tuviese amor, vengo a ser como metal que resuena, o címbalo que suena.", "words": [[0, 300], [3, 417], [6, 577], [14, 1017], [22, 1557], [30, 2077], [32, 2177], [43, 2957], [45, 3117], [48, 3257], [56, 3697], [62, 4457], [68, 4697], [70, 4837], [74, 4937], [79, 5177], [85, 5477], [89, 5717], [98, 6297], [100, 6607], [108, 6917], [112, 7097]]}, {"verse": 2, "start": 8106, "end": 19901, "text": "Y si tuviese profecía, y entendiese todos los misterios y todo conocimiento; y si tuviese toda la fe, de tal manera que traspasase los montes, y no tuviese amor, nada soy.", "words": [[0, 8106], [2, 8208], [5, 8328], [13, 8728], [23, 9548], [25, 9868], [36, 10388], [42, 10688], [46, 10908], [56, 11608], [58, 11788], [63, 12008], [77, 13302], [79, 13406], [82, 13546], [90, 14026], [95, 14286], [98, 14486], [102, 14766], [105, 15146], [109, 15346], [116, 15646], [120, 15866], [131, 16606], [135, 16746], [143, 17406], [145, 17826], [148, 17946], [156, 18366], [162, 19126], [167, 19386]]}, {"verse": 3, "start": 20351, "end": 28360, "text": "Y si repartiese todos mis bienes para dar de comer a pobres, y si entregase mi cuerpo para ser quemado, y no tuviese amor, de nada me sirve.", "words": [[0, 20351], [2, 20460], [5, 20830], [16, 21200], [22, 21400], [26, 21660], [33, 22080], [38, 22234], [42, 22388], [45, 22540], [51, 22820], [53, 23000], [61, 23400], [63, 23920], [66, 24040], [76, 24540], [79, 24680], [86, 25000], [91, 25260], [95, 25460], [104, 25960], [106, 26300], [109, 26420], [117, 26780], [123, 27120], [126, 27480], [131, 27660], [134, 27840]]}, {"verse": 4, "start": 28810, "end": 36068, "text": "El amor es paciente, es benigno; el amor no tiene envidia, el amor no se jacta, no se envanece;", "words": [[0, 28810], [3, 28911], [8, 29131], [11, 29291], [21, 30031], [24, 30151], [33, 31766], [36, 31862], [41, 32102], [44, 32282], [50, 32502], [59, 33362], [62, 33582], [67, 33802], [70, 33962], [73, 34142], [80, 34962], [83, 35102], [86, 35282]]}, {"verse": 5, "start": 36518, "end": 41843, "text": "No se comporta indebidamente, no busca lo suyo, no se irrita, no piensa el mal;", "words": [[0, 36518], [3, 36625], [6, 36765], [15, 37365], [30, 38505], [33, 38605], [39, 38925], [42, 39105], [48, 39825], [51, 39925], [54, 40105], [62, 40825], [65, 40925], [72, 41305], [75, 41465]]}, {"verse": 6, "start": 42293, "end": 45891, "text": "No se alegra de la injusticia, sino que se alegra de la verdad;", "words": [[0, 42293], [3, 42392], [6, 42552], [13, 42932], [16, 43012], [19, 43112], [31, 44112], [36, 44452], [40, 44652], [43, 44812], [50, 45192], [53, 45272], [56, 45372]]}, {"verse": 7, "start": 46341, "end": 50062, "text": "Todo lo sufre, todo lo cree, todo lo espera, todo lo soporta.", "words": [[0, 46341], [5, 46542], [8, 46742], [15, 47422], [20, 47542], [23, 47742], [29, 48282], [34, 48362], [37, 48522], [45, 49102], [50, 49222], [53, 49382]]}, {"verse": 8, "start": 50512, "end": 58384, "text": "El amor nunca deja de ser: pero las profecías se han de acabar, y cesarán las lenguas, y el conocimiento será quitado;", "words": [[0, 50512], [3, 50640], [8, 50880], [14, 51200], [19, 51500], [22, 51660], [27, 53100], [32, 53224], [36, 53384], [46, 54044], [49, 54244], [53, 54384], [56, 54504], [64, 54864], [66, 55424], [74, 55864], [78, 56004], [87, 56604], [89, 56824], [92, 56924], [105, 57584], [110, 57824]]}, {"verse": 9, "start": 58834, "end": 61514, "text": "Porque en parte conocemos, y en parte profetizamos;", "words": [[0, 58834], [7, 58999], [10, 59139], [16, 59339], [27, 59939], [29, 60219], [32, 60319], [38, 60579]]}, {"verse": 10, "start": 61964, "end": 66692, "text": "Pero cuando venga lo que es perfecto, entonces lo que es en parte será quitado.", "words": [[0, 61964], [5, 62098], [12, 62358], [18, 62818], [21, 62978], [25, 63118], [28, 63298], [38, 64238], [47, 64558], [50, 64958], [54, 65118], [57, 65318], [60, 65438], [66, 65738], [71, 66058]]}, {"verse": 11, "start": 67142, "end": 75563, "text": "Cuando yo era niño, hablaba como niño, pensaba como niño, juzgaba como niño; pero cuando ya fui hombre hecho, dejé lo que era de niño.", "words": [[0, 67142], [7, 67343], [10, 67603], [14, 67803], [20, 68483], [28, 68843], [33, 69063], [39, 69743], [47, 70123], [52, 70383], [58, 70963], [66, 71323], [71, 71563], [77, 72383], [82, 72520], [89, 72800], [92, 73040], [96, 73220], [103, 73520], [110, 74280], [115, 74560], [118, 74660], [122, 74820], [126, 74960], [129, 75100]]}, {"verse": 12, "start": 76013, "end": 84253, "text": "Ahora vemos por espejo, en obscuridad; pero entonces veremos cara a cara: ahora conozco en parte; pero entonces conoceré como soy conocido.", "words": [[0, 76013], [6, 76252], [12, 76552], [16, 76832], [24, 77292], [27, 77412], [39, 78348], [44, 78472], [53, 78832], [61, 79372], [66, 79592], [68, 79732], [74, 80396], [80, 80637], [88, 81117], [91, 81217], [98, 81996], [103, 82133], [112, 82473], [121, 83173], [126, 83353], [130, 83553]]}, {"verse": 13, "start": 84703, "end": 91323, "text": "Y ahora permanecen la fe, la esperanza, y el amor, estas tres: pero la mayor de ellas es el amor.", "words": [[0, 84703], [2, 84844], [8, 85084], [19, 85904], [22, 86044], [26, 86564], [29, 86624], [40, 87284], [42, 87544], [45, 87644], [51, 88284], [57, 88524], [63, 89396], [68, 89531], [71, 89671], [77, 89931], [80, 90131], [86, 90371], [89, 90751], [92, 90911]]}]}