{"book": "ISA", "chapter": 55, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 136270, "verses": [{"verse": 1, "start": 300, "end": 12233, "text": "A todos los sedientos: Venid a las aguas; y los que no tienen dinero, venid, comprad, y comed. Venid, comprad, sin dinero y sin precio, vino y leche.", "words": [[0, 300], [2, 449], [8, 709], [12, 989], [23, 2383], [29, 2784], [31, 2844], [35, 3044], [42, 4183], [44, 4283], [48, 4403], [52, 4583], [55, 4703], [62, 4983], [70, 5803], [77, 6543], [86, 7043], [88, 7343], [95, 8367], [102, 8863], [111, 9403], [115, 9563], [122, 9983], [124, 10163], [128, 10263], [136, 11143], [141, 11463], [143, 11723]]}, {"verse": 2, "start": 12928, "end": 22836, "text": "¿Por qué gastáis el dinero no en pan, y vuestro trabajo no en hartura? Oídme atentamente, y comed del bien, y se deleitará vuestra alma con grosura.", "words": [[0, 12928], [5, 13069], [9, 13249], [17, 13749], [20, 13929], [27, 14269], [30, 14489], [33, 14629], [38, 14889], [40, 15509], [48, 15869], [56, 16289], [59, 16569], [62, 16979], [71, 17924], [77, 18366], [90, 19126], [92, 19266], [98, 19626], [102, 19806], [108, 20306], [110, 20586], [113, 20726], [123, 21346], [131, 21686], [136, 21886], [140, 22126]]}, {"verse": 3, "start": 23520, "end": 34491, "text": "Inclinad vuestros oídos, y venid a mí; oíd, y vivirá vuestra alma; y haré con vosotros pacto eterno, las misericordias firmes a David.", "words": [[0, 23520], [9, 24059], [18, 24399], [25, 24979], [27, 25139], [33, 25439], [35, 25519], [39, 27309], [44, 27549], [46, 27949], [53, 28349], [61, 28749], [67, 29855], [69, 29981], [74, 30261], [78, 30401], [87, 31021], [93, 31621], [101, 32361], [105, 32541], [119, 33421], [126, 33981], [128, 34101]]}, {"verse": 4, "start": 35168, "end": 40835, "text": "He aquí, que yo lo di por testigo a los pueblos, por jefe y por maestro a las naciones.", "words": [[0, 35168], [3, 35295], [9, 35575], [13, 35755], [16, 35895], [19, 35995], [22, 36155], [26, 36355], [34, 37035], [36, 37115], [40, 37255], [49, 38055], [53, 38235], [58, 38755], [60, 39075], [64, 39255], [72, 39755], [74, 39955], [78, 40095]]}, {"verse": 5, "start": 41536, "end": 51236, "text": "He aquí, llamarás a gente que no conociste, y gentes que no te conocieron correrán a ti; por causa de Jehová tu Dios, y del Santo de Israel que te ha honrado.", "words": [[0, 41536], [3, 41697], [9, 41957], [18, 42497], [20, 42597], [26, 42857], [30, 43057], [33, 43197], [44, 43897], [46, 44327], [53, 44757], [57, 44997], [60, 45177], [63, 45317], [74, 45897], [83, 46397], [85, 46497], [89, 47322], [93, 47446], [99, 47726], [102, 47966], [109, 48386], [112, 48486], [118, 48766], [120, 49166], [124, 49286], [130, 49606], [133, 49806], [140, 50146], [144, 50346], [147, 50506], [150, 50626]]}, {"verse": 6, "start": 51809, "end": 57383, "text": "Buscad a Jehová mientras puede ser hallado, llamadle en tanto que está cercano.", "words": [[0, 51956], [7, 52136], [9, 52316], [16, 52796], [25, 52996], [31, 53356], [35, 53676], [44, 54526], [53, 55376], [56, 55836], [62, 56096], [66, 56336], [71, 56556]]}, {"verse": 7, "start": 57833, "end": 71524, "text": "Deje el impío su camino, y el hombre inicuo sus pensamientos; y vuélvase a Jehová, el cual tendrá de él misericordia, y al Dios nuestro, el cual será amplio en perdonar.", "words": [[0, 57833], [5, 58281], [8, 58541], [14, 59101], [17, 59301], [25, 59801], [27, 60281], [30, 60421], [37, 60701], [44, 61501], [48, 61681], [62, 63168], [64, 63465], [73, 63805], [75, 63985], [83, 64905], [86, 65025], [91, 65245], [98, 65825], [101, 65945], [104, 66105], [118, 67225], [120, 67605], [123, 67765], [128, 67965], [137, 68645], [140, 69225], [145, 69485], [150, 69805], [157, 70625], [160, 70785]]}, {"verse": 8, "start": 71824, "end": 79102, "text": "Porque mis pensamientos no son vuestros pensamientos, ni vuestros caminos mis caminos, dijo Jehová.", "words": [[0, 71824], [7, 72048], [11, 72228], [24, 72988], [27, 73468], [31, 73748], [40, 74128], [54, 75268], [57, 75628], [66, 76028], [74, 76568], [78, 76728], [87, 78111], [92, 78621]]}, {"verse": 9, "start": 79402, "end": 88291, "text": "Como son más altos los cielos que la tierra, así son mis caminos más altos que vuestros caminos, y mis pensamientos más que vuestros pensamientos.", "words": [[0, 79402], [5, 79561], [9, 79781], [13, 80001], [19, 80461], [23, 80581], [30, 81081], [34, 81201], [37, 81321], [45, 82181], [49, 82461], [53, 82741], [57, 82901], [65, 83341], [69, 83541], [75, 84021], [79, 84101], [88, 84421], [97, 85041], [99, 85481], [103, 85621], [116, 86361], [120, 86781], [124, 87001], [133, 87341]]}, {"verse": 10, "start": 88987, "end": 102208, "text": "Porque como desciende de los cielos la lluvia, y la nieve, y no vuelve allá, sino que harta la tierra, y la hace germinar y producir, y da semilla al que siembra, y pan al que come;", "words": [[0, 88987], [7, 89229], [12, 89529], [22, 90149], [25, 90329], [29, 90469], [36, 90989], [39, 91149], [47, 91729], [49, 91969], [52, 92089], [59, 92889], [61, 93049], [64, 93189], [71, 93549], [77, 94169], [82, 94429], [86, 94669], [92, 95009], [95, 95169], [103, 95589], [105, 96089], [108, 96229], [113, 96529], [122, 97169], [124, 97249], [134, 98531], [136, 98668], [139, 98828], [147, 99448], [150, 99688], [154, 99848], [163, 100448], [165, 101028], [169, 101368], [172, 101528], [176, 101668]]}, {"verse": 11, "start": 102889, "end": 112235, "text": "Así será mi palabra que sale de mi boca: no volverá a mí vacía, antes hará lo que yo quiero, y será prosperada en aquello para que la envié.", "words": [[0, 102889], [4, 103132], [9, 103432], [12, 103592], [20, 103992], [24, 104292], [29, 104572], [32, 104712], [35, 104832], [41, 105885], [44, 106085], [52, 106605], [54, 106685], [57, 106785], [64, 107785], [70, 108125], [75, 108485], [78, 108585], [82, 108725], [85, 108865], [93, 109265], [95, 109785], [100, 110225], [111, 110665], [114, 110805], [122, 111245], [127, 111485], 