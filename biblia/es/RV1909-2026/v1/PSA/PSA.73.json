{"book": "PSA", "chapter": 73, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 163692, "verses": [{"verse": 1, "start": 300, "end": 6204, "text": "Salmo de Asaf. CIERTAMENTE bueno es Dios a Israel, a los limpios de corazón.", "words": [[0, 300], [6, 764], [9, 924], [15, 1534], [27, 2299], [33, 2599], [36, 3039], [41, 3439], [43, 3799], [51, 4639], [53, 4679], [57, 4839], [65, 5339], [68, 5459]]}, {"verse": 2, "start": 6554, "end": 12487, "text": "Mas yo, casi se deslizaron mis pies; por poco resbalaron mis pasos.", "words": [[0, 6554], [4, 6801], [8, 7261], [13, 7601], [16, 7901], [27, 8661], [31, 8941], [37, 9823], [41, 10157], [46, 10917], [57, 11637], [61, 11857]]}, {"verse": 3, "start": 12837, "end": 18359, "text": "Porque tuve envidia de los insensatos, viendo la prosperidad de los impíos.", "words": [[0, 12837], [7, 13056], [12, 13476], [20, 14236], [23, 14356], [27, 14496], [39, 15616], [46, 15976], [49, 16236], [61, 17216], [64, 17416], [68, 17896]]}, {"verse": 4, "start": 18709, "end": 23651, "text": "Porque no hay ataduras para su muerte; antes su fortaleza está entera.", "words": [[0, 18709], [7, 18913], [10, 19133], [14, 19273], [23, 19733], [28, 19973], [31, 20153], [39, 21113], [45, 21517], [48, 22017], [58, 22576], [63, 23135]]}, {"verse": 5, "start": 24001, "end": 28949, "text": "No están ellos en el trabajo humano; ni son azotados con los otros hombres.", "words": [[0, 24001], [3, 24201], [9, 24421], [15, 24701], [18, 24921], [21, 25061], [29, 25421], [37, 26564], [40, 26724], [44, 26884], [53, 27524], [57, 27724], [61, 27904], [67, 28184]]}, {"verse": 6, "start": 29299, "end": 33863, "text": "Por tanto soberbia los corona: se cubren de vestido de violencia.", "words": [[0, 29299], [4, 29424], [10, 29784], [19, 30504], [23, 30943], [31, 31549], [34, 31843], [41, 32173], [44, 32353], [52, 32893], [55, 33013]]}, {"verse": 7, "start": 34213, "end": 39662, "text": "Sus ojos están salidos de gordura: logran con creces los antojos del corazón.", "words": [[0, 34213], [4, 34336], [9, 34656], [15, 34996], [23, 35456], [26, 35616], [35, 36522], [42, 37146], [46, 37306], [53, 37926], [57, 38146], [65, 38726], [69, 38886]]}, {"verse": 8, "start": 40012, "end": 45944, "text": "Se soltaron, y hablan con maldad de hacer violencia; hablan con altanería.", "words": [[0, 40012], [3, 40171], [13, 40891], [15, 41171], [22, 41611], [26, 41791], [33, 42391], [36, 42671], [42, 42911], [53, 44243], [60, 44681], [64, 44881]]}, {"verse": 9, "start": 46294, "end": 49961, "text": "Ponen en el cielo su boca, y su lengua pasea la tierra.", "words": [[0, 46294], [6, 46661], [9, 46901], [12, 47061], [18, 47381], [21, 47681], [27, 48061], [29, 48261], [32, 48361], [39, 48801], [45, 49221], [48, 49341]]}, {"verse": 10, "start": 50311, "end": 55432, "text": "Por eso su pueblo vuelve aquí, y aguas de lleno les son exprimidas.", "words": [[0, 50311], [4, 50412], [8, 50712], [11, 50997], [18, 51357], [25, 51817], [31, 52057], [33, 52477], [39, 52897], [42, 53017], [48, 53437], [52, 53857], [56, 54197]]}, {"verse": 11, "start": 55782, "end": 59776, "text": "Y dicen: ¿Cómo sabe Dios? ¿y hay conocimiento en lo alto?", "words": [[0, 55782], [2, 55910], [9, 56779], [15, 56960], [20, 57260], [26, 58002], [29, 58123], [33, 58243], [46, 59003], [49, 59143], [52, 59263]]}, {"verse": 12, "start": 60056, "end": 65790, "text": "He aquí estos impíos, sin ser turbados del mundo, alcanzaron riquezas.", "words": [[0, 60101], [3, 60181], [8, 60421], [14, 60681], [22, 61621], [26, 61921], [30, 62201], [39, 62861], [43, 63081], [50, 64021], [61, 64801]]}, {"verse": 13, "start": 66140, "end": 71358, "text": "Verdaderamente en vano he limpiado mi corazón, y lavado mis manos en inocencia;", "words": [[0, 66140], [15, 66965], [18, 67185], [23, 67485], [26, 67565], [35, 68105], [38, 68245], [47, 68705], [49, 69080], [56, 69440], [60, 69600], [66, 69960], [69, 70260]]}, {"verse": 14, "start": 71708, "end": 76955, "text": "Pues he sido azotado todo el día, y empezaba mi castigo por las mañanas.", "words": [[0, 71708], [5, 71872], [8, 72032], [13, 72372], [21, 73111], [26, 73352], [29, 73632], [34, 73971], [36, 74236], [45, 74976], [48, 75156], [56, 75776], [60, 75976], [64, 76136]]}, {"verse": 15, "start": 77305, "end": 83438, "text": "Si dijera yo, Discurriré de esa suerte; he aquí habría negado la nación de tus hijos:", "words": [[0, 77305], [3, 77583], [10, 78083], [14, 78683], [25, 79343], [28, 79423], [32, 79603], [40, 80596], [43, 80676], [48, 80936], [55, 81476], [62, 81936], [65, 82056], [72, 82436], [75, 82616], [79, 82756]]}, {"verse": 16, "start": 83788, "end": 88054, "text": "Pensaré pues para saber esto: es a mis ojos duro trabajo,", "words": [[0, 83788], [8, 84171], [13, 84643], [18, 84806], [24, 85126], [30, 85882], [33, 86081], [35, 86161], [39, 86321], [44, 86561], [49, 87241]]}, {"verse": 17, "start": 88404, "end": 92950, "text": "Hasta que venido al santuario de Dios, entenderé el fin de ellos.", "words": [[0, 88404], [6, 88684], [10, 88824], [17, 89204], [20, 89344], [30, 90044], [33, 90244], [39, 90524], [49, 91644], [52, 91844], [56, 92124], [59, 92384]]}, {"verse": 18, "start": 93300, "end": 99390, "text": "Ciertamente los has puesto en deslizaderos; en asolamientos los harás caer.", "words": [[0, 93300], [12, 94040], [16, 94280], [20, 94480], [27, 95000], [30, 95480], [44, 96991], [47, 97276], [60, 98016], [64, 98396], [70, 98856]]}, {"verse": 19, "start": 99740, "end": 105718, "text": "¡Cómo han sido asolados! ¡cuán en un punto! Se acabaron, fenecieron con turbaciones.", "words": [[0, 99740], [6, 99950], [10, 100150], [15, 100490], [25, 101716], [31, 101816], [34, 102016], [37, 102156], [44, 103065], [47, 103211], [57, 103751], [68, 104429], [72, 105106]]}, {"verse": 20, "start": 106068, "end": 112791, "text": "Como sueño del que despierta, así, Señor, cuando despiertes, menospreciarás sus apariencias.", "words": [[0, 106068], [5, 106232], [11, 106612], [15, 106992], [19, 107092], [30, 108012], [35, 108552], [42, 109092], [49, 109232], [61, 110912], [76, 111432], [80, 111732]]}, {"verse": 21, "start": 113141, "end": 117985, "text": "Se amargó en verdad mi corazón, y en mis riñones sentía punzadas.", "words": [[0, 113141], [3, 113288], [10, 113728], [13, 113828], [20, 114208], [23, 114468], [32, 114988], [34, 115393], [37, 115553], [41, 115773], [49, 116553], [56, 117053]]}, {"verse": 22, "start": 118335, "end": 123371, "text": "Mas yo era ignorante, y no entendía: era como una bestia acerca de ti.", "words": [[0, 118393], [4, 118493], [7, 118673], [11, 118873], [22, 119753], [24, 119953], [27, 120113], [37, 121140], [41, 121310], [46, 121630], [50, 121870], [57, 122410], [64, 122710], [67, 123010]]}, {"verse": 23, "start": 123721, "end": 127970, "text": "Con todo, yo siempre estuve contigo: trabaste de mi mano derecha.", "words": [[0, 123721], [4, 123845], [10, 124125], [13, 124325], [21, 124705], [28, 125085], [37, 126030], [46, 126572], [49, 126752], [52, 126932], [57, 127192]]}, {"verse": 24, "start": 128320, "end": 132777, "text": "Me has guiado según tu consejo, y después me recibirás en gloria.", "words": [[0, 128320], [3, 128445], [7, 128605], [14, 129045], [20, 129325], [23, 129565], [32, 130285], [34, 130705], [42, 130985], [45, 131446], [55, 131907], [58, 132368]]}, {"verse": 25, "start": 133127, "end": 138158, "text": "¿A quién tengo yo en los cielos? Y fuera de ti nada deseo en la tierra.", "words": [[0, 133127], [3, 133226], [9, 133406], [15, 133806], [18, 134086], [21, 134406], [25, 134566], [33, 135565], [35, 135694], [41, 135934], [44, 136174], [47, 136354], [52, 136794], [58, 137234], [61, 137334], [64, 137474]]}, {"verse": 26, "start": 138508, "end": 146053, "text": "Mi carne y mi corazón desfallecen: mas la roca de mi corazón y mi porción es Dios para siempre.", "words": [[0, 138508], [3, 138653], [9, 139093], [11, 139653], [14, 139773], [22, 140253], [35, 141825], [39, 142033], [42, 142513], [47, 142873], [50, 143033], [53, 143133], [61, 143493], [63, 143793], [66, 143913], [74, 144393], [77, 144753], [82, 145133], [87, 145493]]}, {"verse": 27, "start": 146403, "end": 153863, "text": "Porque he aquí, los que se alejan de ti perecerán: tú cortarás a todo aquel que fornicando, de ti se aparta.", "words": [[0, 146403], [7, 146536], [10, 146706], [16, 147226], [20, 147486], [24, 147646], [27, 147786], [34, 148246], [37, 148426], [40, 148966], [51, 149676], [54, 149801], [63, 150441], [65, 150541], [70, 150821], [76, 151261], [80, 151711], [92, 152161], [95, 152821], [98, 153001], [101, 153181]]}, {"verse": 28, "start": 154213, "end": 163292, "text": "Y en cuanto a mí, el acercarme a Dios es el bien: he puesto en el Señor Jehová mi esperanza, para contar todas tus obras.", "words": [[0, 154213], [2, 154303], [5, 154423], [12, 154683], [14, 154903], [18, 155543], [21, 155683], [31, 156343], [33, 156463], [38, 156783], [41, 157303], [44, 157463], [50, 158218], [53, 158326], [60, 158626], [63, 158846], [66, 159006], [72, 159246], [79, 159826], [82, 159926], [93, 160686], [98, 161426], [105, 161806], [111, 162246], [115, 162526]]}]}