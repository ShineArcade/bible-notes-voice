[76, 107500]]}, {"verse": 14, "start": 108574, "end": 113668, "text": "Y si esto llega a oídos del gobernador, nosotros le persuadiremos, y os pondremos a salvo.", "words": [[0, 108574], [2, 108674], [5, 108794], [10, 109034], [16, 109294], [18, 109454], [24, 109814], [28, 109934], [40, 110914], [49, 111194], [52, 111494], [67, 112294], [69, 112454], [72, 112574], [82, 113014], [84, 113174]]}, {"verse": 15, "start": 113948, "end": 122277, "text": "Y ellos, tomando el dinero, hicieron como estaban instruidos: y este dicho fue divulgado entre los judíos hasta el día de hoy.", "words": [[0, 113948], [2, 114110], [9, 114350], [17, 114930], [20, 115050], [28, 115510], [37, 116530], [42, 116790], [50, 117130], [62, 118450], [64, 118650], [69, 118850], [75, 119130], [79, 119370], [89, 120070], [95, 120330], [99, 120550], [106, 121130], [112, 121390], [115, 121550], [119, 121710], [122, 121890]]}, {"verse": 16, "start": 122627, "end": 128520, "text": "Pero los once discípulos se fueron a Galilea, al monte donde Jesús les había ordenado.", "words": [[0, 122627], [5, 122769], [9, 123009], [14, 123249], [25, 124069], [28, 124449], [35, 124729], [37, 124929], [46, 125609], [49, 125849], [55, 126189], [61, 126489], [67, 126929], [71, 127329], [77, 127669]]}, {"verse": 17, "start": 128870, "end": 133071, "text": "Y como le vieron, le adoraron: pero algunos dudaban.", "words": [[0, 128870], [2, 128977], [7, 129217], [10, 129397], [18, 130217], [21, 130417], [31, 131485], [36, 131810], [44, 132150]]}, {"verse": 18, "start": 133421, "end": 140300, "text": "Y llegando Jesús, les habló, diciendo: Toda autoridad me ha sido dada en el cielo y en la tierra.", "words": [[0, 133421], [2, 133527], [11, 133927], [18, 134327], [22, 134727], [29, 135247], [39, 136347], [44, 136632], [54, 137232], [57, 137492], [60, 137632], [65, 137892], [70, 138332], [73, 138472], [76, 138612], [82, 139032], [84, 139272], [87, 139372], [90, 139532]]}, {"verse": 19, "start": 140650, "end": 150622, "text": "Por