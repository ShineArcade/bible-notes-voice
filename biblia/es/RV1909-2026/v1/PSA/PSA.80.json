{"book": "PSA", "chapter": 80, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 124766, "verses": [{"verse": 1, "start": 300, "end": 12611, "text": "Al Músico principal: sobre Sosannim Eduth: Salmo de Asaf. OH Pastor de Israel, escucha: tú que pastoreas como a ovejas a José, que estás entre querubines, resplandece.", "words": [[0, 300], [3, 444], [10, 924], [21, 2084], [27, 2650], [36, 3256], [43, 4083], [49, 4525], [52, 4685], [58, 5344], [61, 5424], [68, 5784], [71, 6084], [79, 6833], [88, 7604], [91, 7664], [95, 7824], [105, 8484], [110, 8758], [112, 9031], [119, 9304], [121, 9404], [127, 10064], [131, 10144], [137, 10324], [143, 10644], [155, 11604]]}, {"verse": 2, "start": 12961, "end": 20189, "text": "Despierta tu valentía delante de Efraín, y de Benjamín, y de Manasés, y ven a salvarnos.", "words": [[0, 12961], [10, 13664], [13, 13844], [22, 14484], [30, 14944], [33, 15124], [41, 15884], [43, 16084], [46, 16204], [56, 16564], [58, 17064], [61, 17444], [70, 17824], [72, 18224], [76, 18364], [78, 18484]]}, {"verse": 3, "start": 20539, "end": 26573, "text": "Oh Dios, haznos volver; y haz resplandecer tu rostro, y seremos salvos.", "words": [[0, 20630], [3, 20750], [9, 20870], [16, 20990], [24, 22498], [26, 22818], [30, 22998], [43, 24198], [46, 24498], [54, 25138], [56, 25458], [64, 25818]]}, {"verse": 4, "start": 26923, "end": 33258, "text": "Jehová, Dios de los ejércitos, ¿hasta cuándo humearás tú contra la oración de tu pueblo?", "words": [[0, 27141], [8, 27395], [13, 27648], [16, 27768], [20, 27928], [31, 29248], [38, 29668], [45, 30248], [54, 30788], [57, 31028], [64, 31468], [67, 31708], [75, 32248], [78, 32428], [81, 32548]]}, {"verse": 5, "start": 33608, "end": 39084, "text": "Les diste a comer pan de lágrimas, y les diste a beber lágrimas en gran abundancia.", "words": [[0, 33608], [4, 33772], [10, 34172], [12, 34252], [18, 34532], [22, 34992], [25, 35192], [35, 35852], [37, 36172], [41, 36292], [47, 36652], [49, 36712], [55, 36912], [64, 37612], [67, 37832], [72, 38012]]}, {"verse": 6, "start": 39434, "end": 45225, "text": "Nos pusiste por contienda a nuestros vecinos: y nuestros enemigos se burlan entre sí.", "words": [[0, 39434], [4, 39559], [12, 40099], [16, 40339], [26, 41059], [28, 41359], [37, 41519], [46, 42677], [48, 42777], [57, 43017], [66, 43697], [69, 43897], [76, 44357], [82, 44737]]}, {"verse": 7, "start": 45575, "end": 52725, "text": "Oh Dios de los ejércitos, haznos volver; y haz resplandecer tu rostro, y seremos salvos.", "words": [[0, 45650], [3, 45760], [8, 46080], [11, 46420], [15, 46560], [26, 47210], [33, 47860], [41, 48649], [43, 48970], [47, 49150], [60, 50350], [63, 50650], [71, 51290], [73, 51610], [81, 51970]]}, {"verse": 8, "start": 53075, "end": 57953, "text": "Hiciste venir una vid de Egipto: echaste las naciones, y la plantaste.", "words": [[0, 53075], [8, 53579], [14, 53819], [18, 54099], [22, 54299], [25, 54559], [33, 55509], [41, 56035], [45, 56215], [55, 56755], [57, 56995], [60, 57095]]}, {"verse": 9, "start": 57953, "end": 64277, "text": "Limpiaste sitio delante de ella, e hiciste arraigar sus raíces, y llenó la tierra.", "words": [[0, 57953], [10, 58893], [16, 59373], [24, 59933], [27, 60153], [33, 60473], [35, 60693], [43, 61353], [52, 61953], [56, 62113], [64, 62793], [66, 63193], [72, 63533], [75, 63613]]}, {"verse": 10, "start": 64627, "end": 69996, "text": "Los montes fueron cubiertos de su sombra; y sus sarmientos como cedros de Dios.", "words": [[0, 64627], [4, 64827], [11, 65307], [18, 65567], [28, 66347], [31, 66467], [34, 66607], [42, 67507], [44, 67616], [48, 68036], [59, 68456], [64, 68736], [71, 69316], [74, 69436]]}, {"verse": 11, "start": 70346, "end": 74588, "text": "Extendió sus vástagos hasta el mar, y hasta el río sus renuevos.", "words": [[0, 70346], [9, 71072], [13, 71272], [22, 72012], [28, 72212], [31, 72412], [36, 72632], [38, 72872], [44, 73092], [47, 73312], [51, 73612], [55, 73792]]}, {"verse": 12, "start": 74938, "end": 80398, "text": "¿Por qué rompiste sus vallados, y la vendimian todos los que pasan por el camino?", "words": [[0, 74938], [5, 75063], [9, 75283], [18, 76043], [22, 76263], [32, 76903], [34, 77423], [37, 77853], [47, 78283], [53, 78583], [57, 78863], [61, 79043], [67, 79463], [71, 79643], [74, 79783]]}, {"verse": 13, "start": 80748, "end": 84684, "text": "La estropeó el jabalí, y la comió la bestia del campo.", "words": [[0, 80748], [3, 80911], [12, 81671], [15, 81791], [23, 82391], [25, 82771], [28, 82891], [34, 83291], [37, 83451], [44, 83851], [48, 84011]]}, {"verse": 14, "start": 85034, "end": 92085, "text": "Oh Dios de los ejércitos, vuelve ahora: mira desde el cielo, y considera, y visita esta viña,", "words": [[0, 85107], [3, 85217], [8, 85457], [11, 85757], [15, 85917], [26, 86677], [33, 87397], [40, 88147], [45, 88495], [51, 88755], [54, 89015], [61, 89435], [63, 89675], [74, 90615], [76, 90755], [83, 91215], [88, 91415]]}, {"verse": 15, "start": 92435, "end": 97216, "text": "Y la planta que plantó tu diestra, y el renuevo que para ti afirmaste.", "words": [[0, 92435], [2, 92538], [5, 92658], [12, 93078], [16, 93178], [23, 93638], [26, 93758], [35, 94338], [37, 94663], [40, 94843], [48, 95523], [52, 95663], [57, 95943], [60, 96203]]}, {"verse": 16, "start": 97566, "end": 102798, "text": "Quemada a fuego está, asolada: perezcan por la reprensión de tu rostro.", "words": [[0, 97566], [8, 97770], [10, 98010], [16, 98350], [22, 98750], [31, 100050], [40, 100717], [44, 100937], [47, 101357], [58, 101777], [61, 101997], [64, 102117]]}, {"verse": 17, "start": 103148, "end": 110455, "text": "Sea tu mano sobre el varón de tu diestra, sobre el hijo del hombre que para ti corroboraste.", "words": [[0, 103148], [4, 103372], [7, 103612], [12, 103912], [18, 104272], [21, 104492], [27, 104892], [30, 104992], [33, 105172], [42, 106232], [48, 106752], [51, 107092], [56, 107372], [60, 107612], [67, 108012], [71, 108492], [76, 108752], [79, 109072]]}, {"verse": 18, "start": 110805, "end": 115844, "text": "Así no nos volveremos de ti: vida nos darás, e invocaremos tu nombre.", "words": [[0, 110805], [4, 111031], [7, 111271], [11, 111411], [22, 112051], [25, 112211], [29, 112751], [34, 113117], [38, 113257], [45, 113817], [47, 114397], [59, 115057], [62, 115257]]}, {"verse": 19, "start": 116194, "end": 124366, "text": "Oh Jehová, Dios de los ejércitos, haznos volver; haz resplandecer tu rostro, y seremos salvos.", "words": [[0, 116194], [3, 116501], [11, 117521], [16, 117801], [19, 118061], [23, 118201], [34, 119341], [41, 119821], [49, 120786], [53, 121536], [66, 122286], [69, 122486], [77, 123066], [79, 123386], [87, 123806]]}]}