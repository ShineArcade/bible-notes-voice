{"book": "LUK", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 317704, "verses": [{"verse": 1, "start": 300, "end": 9467, "text": "Y en este mismo tiempo estaban allí unos que le contaban acerca de los galileos, cuya sangre Pilato había mezclado con sus sacrificios.", "words": [[0, 300], [2, 442], [5, 542], [10, 742], [16, 1022], [23, 1422], [31, 1802], [36, 2162], [41, 2622], [45, 2982], [48, 3102], [57, 3662], [64, 3982], [67, 4282], [71, 4422], [81, 5142], [86, 5802], [93, 6142], [100, 6762], [106, 7123], [115, 8003], [119, 8222], [123, 8423]]}, {"verse": 2, "start": 9917, "end": 19914, "text": "Y respondiendo Jesús, les dijo: ¿Pensáis que estos galileos, porque han padecido tales cosas, hayan sido más pecadores que todos los galileos?", "words": [[0, 9917], [2, 10220], [15, 10920], [22, 11340], [26, 11880], [32, 12804], [41, 13186], [45, 13386], [51, 13566], [61, 14666], [68, 15006], [72, 15246], [81, 15786], [87, 16066], [94, 17126], [100, 17406], [105, 17666], [109, 17866], [119, 18346], [123, 18546], [129, 18806], [133, 18986]]}, {"verse": 3, "start": 20364, "end": 25869, "text": "No, os digo; sino que si no os arrepentís, todos pereceréis igualmente.", "words": [[0, 20424], [4, 20518], [7, 20611], [13, 21575], [18, 21971], [22, 22171], [25, 22371], [28, 22591], [31, 22791], [43, 23891], [49, 24111], [60, 24931]]}, {"verse": 4, "start": 26319, "end": 36740, "text": "O aquellos dieciocho, sobre los cuales cayó la torre en Siloé, y los mató, ¿pensáis que ellos fueron más culpables que todos los hombres que habitan en Jerusalén?", "words": [[0, 26319], [2, 26427], [11, 26897], [22, 27367], [28, 27847], [32, 28047], [39, 28327], [44, 28847], [47, 28967], [53, 29387], [56, 29607], [63, 30187], [65, 30807], [69, 30947], [75, 31747], [84, 32287], [88, 32547], [94, 32747], [101, 33047], [105, 33347], [115, 34067], [119, 34227], [125, 34507], [129, 34747], [137, 35087], [141, 35287], [149, 35727], [152, 35827]]}, {"verse": 5, "start": 37190, "end": 42593, "text": "No, os digo; sino que si no os arrepentís, todos pereceréis asimismo.", "words": [[0, 37250], [4, 37344], [7, 37437], [13, 38400], [18, 38623], [22, 38803], [25, 38983], [28, 39163], [31, 39343], [43, 40563], [49, 41003], [60, 41836]]}, {"verse": 6, "start": 43043, "end": 50529, "text": "Y dijo esta parábola: Tenía uno una higuera plantada en su viña, y vino a buscar fruto en ella, y no lo halló.", "words": [[0, 43043], [2, 43171], [7, 43411], [12, 43611], [22, 44821], [28, 45001], [32, 45321], [36, 45701], [44, 46221], [53, 46761], [56, 46881], [59, 47041], [65, 47521], [67, 48101], [72, 48301], [74, 48461], [81, 48661], [87, 49141], [90, 49301], [96, 49541], [98, 49821], [101, 49981], [104, 50285]]}, {"verse": 7, "start": 50979, "end": 61336, "text": "Y dijo al encargado de la viña: He aquí hace tres años que vengo a buscar fruto en esta higuera, y no lo hallo; córtala, ¿por qué ocupará aún la tierra?", "words": [[0, 50979], [2, 51186], [7, 51426], [10, 51566], [20, 52186], [23, 52346], [26, 52466], [32, 53509], [35, 53689], [40, 53989], [45, 54409], [50, 54749], [55, 55169], [59, 55429], [65, 55729], [67, 55789], [74, 56029], [80, 56649], [83, 56809], [88, 57029], [97, 57509], [99, 57649], [102, 57809], [105, 58009], [112, 58781], [121, 59146], [126, 59386], [130, 59546], [138, 60126], [142, 60466], [145, 60666]]}, {"verse": 8, "start": 61786, "end": 71224, "text": "Él entonces respondiendo, le dijo: Señor, déjala aún este año, hasta que cave a su alrededor y la abone con estiércol.", "words": [[0, 61786], [3, 62050], [12, 62750], [26, 64090], [29, 64250], [35, 65082], [42, 65869], [49, 66289], [53, 66669], [58, 66989], [63, 67749], [69, 67989], [73, 68289], [78, 68589], [80, 68789], [83, 68949], [93, 69369], [95, 69709], [98, 69849], [104, 70269], [108, 70469]]}, {"verse": 9, "start": 71675, "end": 76104, "text": "Y si da fruto, bien; y si no, la cortarás después.", "words": [[0, 71675], [2, 71778], [5, 71918], [8, 72098], [15, 72838], [21, 73725], [23, 73854], [26, 73974], [30, 74494], [33, 74794], [42, 75414]]}, {"verse": 10, "start": 76554, "end": 79153, "text": "Y enseñaba en una sinagoga en sábado.", "words": [[0, 76554], [2, 76677], [11, 77297], [14, 77457], [18, 77617], [27, 78277], [30, 78457]]}, {"verse": 11, "start": 79603, "end": 89421, "text": "Y he aquí una mujer que tenía espíritu de enfermedad dieciocho años, y andaba encorvada, que en ninguna manera se podía enderezar.", "words": [[0, 79603], [2, 80017], [5, 80297], [10, 80557], [14, 80797], [20, 81097], [24, 81357], [30, 81697], [39, 82517], [42, 82637], [53, 83267], [63, 83897], [69, 84597], [71, 85197], [78, 85677], [89, 86837], [93, 86957], [96, 87077], [104, 87517], [111, 87897], [114, 88137], [120, 88477]]}, {"verse": 12, "start": 89871, "end": 96542, "text": "Y como Jesús la vio, la llamó, y le dijo: Mujer, libre eres de tu enfermedad.", "words": [[0, 89871], [2, 89978], [7, 90218], [13, 90518], [16, 90858], [21, 91578], [24, 91738], [31, 92258], [33, 92618], [36, 92758], [42, 93595], [49, 94464], [55, 94923], [60, 95364], [63, 95584], [66, 95724]]}, {"verse": 13, "start": 96992, "end": 102735, "text": "Y puso las manos sobre ella; y enseguida se enderezó, y glorificaba a Dios.", "words": [[0, 96992], [2, 97118], [7, 97398], [11, 97558], [17, 97838], [23, 98198], [29, 99099], [31, 99405], [41, 100005], [44, 100205], [54, 100925], [56, 101265], [68, 101985], [70, 102165]]}, {"verse": 14, "start": 103185, "end": 118154, "text": "Y respondiendo el dirigente de la sinagoga, enojado de que Jesús hubiese curado en sábado, dijo a la multitud: Seis días hay en que es necesario trabajar: en estos, pues, venid y sed curados, y no en día de sábado.", "words": [[0, 103185], [2, 103306], [15, 103786], [18, 104266], [28, 104966], [31, 105086], [34, 105226], [44, 105986], [52, 107106], [55, 107286], [59, 107406], [65, 107806], [73, 108546], [80, 109026], [83, 109206], [91, 109786], [96, 110426], [98, 110586], [101, 110666], [111, 111742], [116, 111912], [121, 112252], [125, 112672], [128, 112812], [132, 112972], [135, 113112], [145, 113592], [155, 114641], [158, 114766], [165, 115306], [171, 115566], [177, 115886], [179, 116006], [183, 116146], [192, 116666], [194, 116946], [197, 117126], [200, 117246], [204, 117406], [207, 117566]]}, {"verse": 15, "start": 118504, "end": 129711, "text": "Entonces el Señor le respondió, y dijo: Hipócrita, cada uno de vosotros ¿no desata en sábado su buey o su asno del pesebre, y lo lleva a beber?", "words": [[0, 118504], [9, 118966], [12, 119346], [18, 119646], [21, 119946], [32, 120586], [34, 120806], [40, 121568], [51, 122635], [56, 122835], [60, 123175], [63, 123335], [72, 123975], [76, 124535], [83, 125055], [86, 125275], [93, 125775], [96, 126215], [101, 126655], [103, 126795], [106, 126955], [111, 127495], [115, 127675], [124, 128255], [126, 128635], [129, 128775], [135, 129035], [137, 129235]]}, {"verse": 16, "start": 130161, "end": 140030, "text": "Y a esta hija de Abraham, que he aquí Satanás la había atado dieciocho años, ¿no convino desatarla de esta ligadura en día de sábado?", "words": [[0, 130161], [2, 130343], [4, 130443], [9, 130723], [14, 131183], [17, 131303], [26, 131743], [30, 132223], [33, 132703], [38, 133143], [46, 133883], [49, 134023], [55, 134323], [61, 134773], [71, 135223], [77, 136383], [81, 136763], [89, 137143], [99, 137963], [102, 138123], [107, 138323], [116, 138863], [119, 139043], [123, 139223], [126, 139383]]}, {"verse": 17, "start": 140480, "end": 150995, "text": "Y diciendo estas cosas, se avergonzaban todos sus adversarios: pero todo el pueblo se gozaba de todas las cosas gloriosas que eran por él hechas.", "words": [[0, 140480], [2, 140860], [11, 141240], [17, 141500], [24, 142500], [27, 142780], [40, 143600], [46, 144000], [50, 144440], [63, 145922], [68, 146066], [73, 146426], [76, 146626], [83, 147026], [86, 147266], [93, 147726], [96, 147886], [102, 148146], [106, 148426], [112, 148706], [122, 149466], [126, 149646], [131, 149846], [135, 150086], [138, 150286]]}, {"verse": 18, "start": 151445, "end": 156239, "text": "Y dijo: ¿A qué es semejante el reino de Dios, y a qué le compararé?", "words": [[0, 151445], [2, 151575], [8, 152334], [11, 152614], [15, 152754], [18, 153094], [28, 153754], [31, 153894], [37, 154254], [40, 154394], [46, 154854], [48, 154934], [50, 155074], [54, 155214], [57, 155354]]}, {"verse": 19, "start": 156689, "end": 169047, "text": "Semejante es a la semilla de mostaza, que tomándola un hombre la metió en su huerto; y creció, y fue hecho árbol grande, y las aves del cielo hicieron nidos en sus ramas.", "words": [[0, 156689], [10, 157313], [13, 157553], [15, 157653], [18, 157773], [26, 158233], [29, 158393], [38, 158953], [42, 159553], [52, 160193], [55, 160373], [62, 160713], [65, 161093], [71, 161413], [74, 161513], [77, 161653], [85, 163770], [87, 163770], [95, 163770], [97, 163877], [101, 164057], [107, 164337], [113, 164737], [121, 165217], [123, 165657], [127, 165797], [132, 166257], [136, 166397], [142, 166757], [151, 167347], [157, 167937], [160, 168097], [164, 168297]]}, {"verse": 20, "start": 169497, "end": 173229, "text": "Y otra vez dijo: ¿A qué compararé el reino de Dios?", "words": [[0, 169497], [2, 169683], [7, 169843], [11, 170163], [17, 170960], [20, 171104], [24, 171184], [34, 171944], [37, 172144], [43, 172524], [46, 172664]]}, {"verse": 21, "start": 173679, "end": 182466, "text": "Semejante es a la levadura, que tomó una mujer, y la escondió en tres medidas de harina, hasta que todo hubo fermentado.", "words": [[0, 174012], [10, 174382], [13, 174642], [15, 174762], [18, 174882], [28, 175462], [32, 175662], [37, 176042], [41, 176182], [48, 176582], [50, 177282], [53, 177422], [62, 178102], [65, 178362], [70, 178602], [78, 179082], [81, 179302], [89, 179802], [95, 180622], [99, 180822], [104, 181102], [109, 181502]]}, {"verse": 22, "start": 182916, "end": 189507, "text": "Y pasaba por todas las ciudades y aldeas, enseñando, y caminando a Jerusalén.", "words": [[0, 182916], [2, 183031], [9, 183471], [13, 183751], [19, 184071], [23, 184391], [32, 185211], [34, 185371], [42, 186211], [53, 187291], [55, 187851], [65, 188551], [67, 188651]]}, {"verse": 23, "start": 189957, "end": 195553, "text": "Y le dijo uno: Señor, ¿son pocos los que se salvan? Y él les dijo:", "words": [[0, 189957], [2, 190253], [5, 190393], [10, 190713], [15, 191858], [22, 192604], [27, 192864], [33, 193364], [37, 193464], [41, 193644], [44, 193764], [52, 194689], [54, 194832], [57, 194932], [61, 195072]]}, {"verse": 24, "start": 195903, "end": 203771, "text": "Esforzaos por entrar por la puerta angosta; porque os digo que muchos procurarán entrar, y no podrán.", "words": [[0, 196431], [10, 196991], [14, 197271], [21, 197731], [25, 198031], [28, 198191], [35, 198515], [44, 199844], [51, 200484], [54, 200684], [59, 200844], [63, 201044], [70, 201304], [81, 202144], [89, 202584], [91, 202884], [94, 203044]]}, {"verse": 25, "start": 204221, "end": 219337, "text": "Después que el padre de familia se levante, y cierre la puerta, y comencéis a estar fuera, y llamar a la puerta, diciendo: Señor, Señor, ábrenos; y respondiendo os dirá: No os conozco de dónde seáis.", "words": [[0, 204221], [8, 204545], [12, 204845], [15, 204965], [21, 205245], [24, 205465], [32, 205825], [35, 206105], [44, 206885], [46, 207145], [53, 207685], [56, 207825], [64, 208225], [66, 208705], [76, 209425], [78, 209525], [84, 209705], [91, 210165], [93, 210645], [100, 210985], [102, 211065], [105, 211165], [113, 211465], [123, 213311], [130, 213782], [137, 214293], [146, 215063], [148, 215169], [161, 215989], [164, 216269], [170, 217055], [173, 217263], [176, 217403], [184, 218023], [187, 218163], [193, 218773]]}, {"verse": 26, "start": 219787, "end": 226573, "text": "Entonces comenzaréis a decir: Delante de ti hemos comido y bebido, y en nuestras plazas enseñaste;", "words": [[0, 219787], [9, 220254], [21, 221154], [23, 221314], [30, 222190], [38, 222636], [41, 222796], [44, 223036], [50, 223316], [57, 223816], [59, 223916], [67, 224376], [69, 224736], [72, 224836], [81, 225016], [88, 225696]]}, {"verse": 27, "start": 227023, "end": 234406, "text": "Y os dirá: Os digo que no os conozco de dónde seáis; apartaos de mí todos los obreros de iniquidad.", "words": [[0, 227023], [2, 227172], [5, 227272], [11, 228010], [14, 228119], [19, 228359], [23, 228559], [26, 228819], [29, 228959], [37, 229479], [40, 229619], [46, 229819], [53, 231322], [62, 231682], [65, 231902], [68, 232202], [74, 232322], [78, 232602], [86, 233202], [89, 233835]]}, {"verse": 28, "start": 234856, "end": 247504, "text": "Allí será el llanto y el crujir de dientes, cuando veáis a Abraham, a Isaac, a Jacob y a todos los profetas en el reino de Dios, y vosotros estéis excluidos.", "words": [[0, 234856], [5, 235220], [10, 235460], [13, 235720], [20, 236160], [22, 236320], [25, 236690], [32, 237060], [35, 237180], [44, 238160], [51, 238440], [57, 239040], [59, 239300], [68, 240500], [70, 240580], [77, 241380], [79, 241420], [85, 241800], [87, 242340], [89, 242420], [95, 242660], [99, 242980], [108, 243540], [111, 243760], [114, 243900], [120, 244300], [123, 244440], [129, 245256], [131, 245381], [140, 245921], [147, 246461]]}, {"verse": 29, "start": 247954, "end": 255016, "text": "Y vendrán del Oriente y del Occidente, del Norte y del Sur, y se sentarán a la mesa en el reino de Dios.", "words": [[0, 247954], [2, 248082], [10, 248582], [14, 248782], [22, 249262], [24, 249422], [28, 249602], [39, 250302], [43, 250582], [49, 251002], [51, 251222], [55, 251402], [60, 252262], [62, 252342], [65, 252462], [74, 253082], [76, 253182], [79, 253242], [84, 253522], [87, 253702], [90, 253862], [96, 254302], [99, 254442]]}, {"verse": 30, "start": 255466, "end": 261760, "text": "Y he aquí, son últimos los que eran primeros, y son primeros los que eran últimos.", "words": [[0, 255466], [2, 255628], [5, 255828], [11, 256168], [15, 256428], [23, 257788], [27, 257908], [31, 258068], [36, 258248], [46, 259228], [48, 259448], [52, 259588], [61, 260388], [65, 260608], [69, 260788], [74, 261028]]}, {"verse": 31, "start": 262210, "end": 270291, "text": "Aquel mismo día llegaron unos de los fariseos, diciéndole: Sal, y vete de aquí, porque Herodes te quiere matar.", "words": [[0, 262210], [6, 262627], [12, 262867], [16, 263227], [25, 263707], [30, 264187], [33, 264387], [37, 264507], [47, 265307], [59, 266677], [64, 267012], [66, 267312], [71, 267552], [74, 267692], [80, 268412], [87, 268812], [95, 269172], [98, 269452], [105, 269672]]}, {"verse": 32, "start": 270641, "end": 281295, "text": "Y les dijo: Id, y decid a aquella zorra: He aquí, echo fuera demonios y acabo sanidades hoy y mañana, y al tercer día culmino mi obra.", "words": [[0, 270641], [2, 270791], [6, 270911], [12, 271866], [16, 272016], [18, 272396], [24, 272696], [26, 273156], [34, 273694], [41, 274466], [44, 274609], [50, 275029], [55, 275449], [61, 275749], [70, 276529], [72, 276629], [78, 277049], [88, 277609], [92, 278009], [94, 278209], [102, 279149], [104, 279229], [107, 279349], [114, 279589], [118, 280009], [126, 280669], [129, 280789]]}, {"verse": 33, "start": 281745, "end": 290896, "text": "Pero es necesario que hoy, y mañana, y pasado mañana camine; porque no es posible que profeta muera fuera de Jerusalén.", "words": [[0, 281745], [5, 281909], [8, 282169], [18, 283189], [22, 283489], [27, 283869], [29, 284489], [37, 284929], [39, 285569], [46, 285969], [53, 286449], [61, 287619], [68, 287781], [71, 287961], [74, 288061], [82, 288461], [86, 288641], [94, 289101], [100, 289481], [106, 289861], [109, 289981]]}, {"verse": 34, "start": 291346, "end": 305744, "text": "¡Jerusalén, Jerusalén! que matas a los profetas, y apedreas a los que son enviados a ti: ¡cuántas veces quise juntar tus hijos, como la gallina sus pollos debajo de sus alas, y no quisiste!", "words": [[0, 291346], [12, 292591], [23, 293742], [27, 293826], [33, 294326], [35, 294426], [39, 294546], [49, 295226], [51, 296066], [60, 296766], [62, 296886], [66, 297006], [70, 297166], [74, 297406], [83, 297986], [85, 298206], [89, 298866], [98, 299292], [104, 299772], [110, 300192], [117, 300732], [121, 300932], [128, 301352], [133, 301952], [136, 302132], [144, 302692], [148, 302832], [155, 303392], [162, 303772], [165, 303932], [169, 304052], [175, 304592], [177, 304852], [180, 304992]]}, {"verse": 35, "start": 306194, "end": 317304, "text": "He aquí, os es dejada vuestra casa desierta: y os digo que no me veréis, hasta que venga tiempo cuando digáis: Bendito el que viene en nombre del Señor.", "words": [[0, 306265], [3, 306375], [9, 306655], [12, 306975], [15, 307195], [22, 307855], [30, 308255], [35, 308515], [45, 309803], [47, 309969], [50, 310089], [55, 310329], [59, 310529], [62, 310769], [65, 310929], [73, 311429], [79, 312089], [83, 312309], [89, 312629], [96, 312989], [103, 313309], [111, 314431], [119, 315118], [122, 315258], [126, 315398], [132, 315678], [135, 316038], [142, 316398], [146, 316678]]}]}