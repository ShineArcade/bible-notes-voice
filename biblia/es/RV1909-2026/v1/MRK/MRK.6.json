{"book": "MRK", "chapter": 6, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 474890, "verses": [{"verse": 1, "start": 300, "end": 5039, "text": "Y salió de allí, y vino a su pueblo, y le siguieron sus discípulos.", "words": [[0, 300], [2, 441], [8, 761], [11, 901], [17, 1201], [19, 1701], [24, 1921], [26, 2101], [29, 2241], [37, 2601], [39, 2971], [42, 3341], [52, 3761], [56, 3981]]}, {"verse": 2, "start": 5489, "end": 20387, "text": "Y llegado el sábado, comenzó a enseñar en la sinagoga; y muchos oyéndole, estaban atónitos, diciendo: ¿De dónde tiene este estas cosas? ¿Y qué sabiduría es esta que le es dada, y tales milagros realizados por sus manos?", "words": [[0, 5489], [2, 5574], [10, 5974], [13, 6094], [21, 6574], [29, 7234], [31, 7374], [39, 7974], [42, 8094], [45, 8254], [55, 9394], [57, 9676], [64, 10116], [74, 11076], [82, 11456], [92, 12616], [102, 13533], [106, 13650], [112, 13790], [118, 14170], [123, 14470], [129, 14670], [136, 15620], [139, 15719], [143, 15839], [153, 16479], [156, 16659], [161, 16899], [165, 17059], [168, 17199], [171, 17359], [177, 17699], [179, 18079], [185, 18259], [194, 18819], [205, 19419], [209, 19639], [213, 19799]]}, {"verse": 3, "start": 20837, "end": 30472, "text": "¿No es este el carpintero, hijo de María, hermano de Jacobo, y de José, y de Judas, y de Simón? ¿No están también aquí con nosotros, sus hermanas? Y lo rechazaban.", "words": [[0, 20837], [4, 21033], [7, 21193], [12, 21433], [15, 21533], [27, 22253], [32, 22433], [35, 22593], [42, 23233], [50, 23553], [53, 23593], [61, 24153], [63, 24293], [66, 24353], [72, 24613], [74, 25013], [77, 25093], [84, 25353], [86, 25713], [89, 25773], [96, 26591], [100, 26735], [106, 26955], [114, 27255], [119, 27455], [123, 27655], [133, 28175], [137, 28255], [147, 29307], [149, 29411], [152, 29551]]}, {"verse": 4, "start": 30922, "end": 39078, "text": "Pero Jesús les decía: No hay profeta deshonrado sino en su tierra, y entre sus parientes, y en su casa.", "words": [[0, 30922], [5, 31109], [11, 31549], [15, 32029], [22, 32999], [25, 33186], [29, 33406], [37, 34086], [48, 34766], [53, 35046], [56, 35286], [59, 35446], [67, 35966], [69, 36686], [75, 36986], [79, 37226], [90, 37786], [92, 38186], [95, 38326], [98, 38486]]}, {"verse": 5, "start": 39528, "end": 47483, "text": "Y no pudo hacer allí alguna maravilla; solamente sanó unos pocos enfermos, poniendo sobre ellos las manos.", "words": [[0, 39528], [2, 39633], [5, 39773], [10, 40113], [16, 40373], [21, 40693], [28, 41133], [39, 42326], [49, 42824], [54, 43524], [59, 43704], [65, 44144], [75, 44884], [84, 45884], [90, 46224], [96, 46544], [100, 46784]]}, {"verse": 6, "start": 47933, "end": 55315, "text": "Y estaba maravillado de la incredulidad de ellos. Y rodeaba las aldeas de alrededor, enseñando.", "words": [[0, 47933], [2, 48044], [9, 48324], [21, 49124], [24, 49324], [27, 49464], [40, 50424], [43, 50704], [50, 51619], [52, 51744], [60, 52464], [64, 52684], [71, 53264], [74, 53384], [85, 54024]]}, {"verse": 7, "start": 55765, "end": 64391, "text": "Y llamó a los doce, y comenzó a enviarlos de dos en dos: y les dio autoridad sobre los espíritus inmundos.", "words": [[0, 55765], [2, 55914], [8, 56334], [10, 56534], [14, 56794], [20, 57054], [22, 57814], [30, 58454], [32, 58594], [42, 59234], [45, 59514], [49, 59814], [52, 60014], [57, 60856], [59, 60975], [63, 61135], [67, 61375], [77, 62215], [83, 62575], [87, 62815], [97, 63638]]}, {"verse": 8, "start": 64841, "end": 73322, "text": "Y les mandó que no llevasen nada para el camino, sino solamente bastón; no bolsa de viaje, ni pan, ni dinero en la bolsa;", "words": [[0, 64841], [2, 65149], [6, 65269], [12, 65669], [16, 65779], [19, 65889], [28, 66409], [33, 66709], [38, 66949], [41, 67109], [49, 67749], [54, 68009], [64, 68609], [72, 69731], [75, 69895], [81, 70315], [84, 70435], [91, 71115], [94, 71295], [99, 71955], [102, 72115], [109, 72455], [112, 72675], [115, 72755]]}, {"verse": 9, "start": 73772, "end": 77450, "text": "Pero que calzasen sandalias, y no vistiesen dos túnicas.", "words": [[0, 73772], [5, 73917], [9, 74357], [18, 74797], [29, 75557], [31, 75737], [34, 76097], [44, 76457], [48, 76617]]}, {"verse": 10, "start": 77900, "end": 84873, "text": "Y les decía: Donde quiera que entréis en una casa, quedaos en ella hasta que salgáis de allí.", "words": [[0, 77900], [2, 78163], [6, 78463], [13, 79441], [19, 79687], [26, 80147], [30, 80287], [38, 80807], [41, 80967], [45, 81127], [51, 81707], [59, 82487], [62, 82767], [67, 83067], [73, 83427], [77, 83627], [85, 84187], [88, 84447]]}, {"verse": 11, "start": 85323, "end": 103317, "text": "Y todos aquellos que no os reciban ni os oigan, saliendo de allí, sacudid el polvo que está debajo de vuestros pies, en testimonio a ellos. De cierto les digo que más tolerable será el castigo de los de Sodoma y Gomorra el día del juicio, que el de aquella ciudad.", "words": [[0, 85323], [2, 85447], [8, 85727], [17, 86227], [21, 86374], [24, 86520], [27, 86667], [35, 87347], [38, 87707], [41, 87867], [48, 88767], [57, 89307], [60, 89487], [66, 90117], [74, 90747], [77, 90887], [83, 91467], [87, 91627], [92, 91827], [99, 92227], [102, 92407], [111, 92687], [117, 92987], [120, 93487], [131, 94247], [133, 94367], [140, 95168], [143, 95333], [150, 95613], [154, 95973], [159, 96333], [163, 96493], [167, 96693], [177, 97393], [182, 97633], [185, 97853], [193, 98373], [196, 98533], [200, 98653], [203, 98833], [210, 99513], [212, 99793], [220, 100513], [223, 100753], [227, 100943], [231, 101133], [239, 101733], [243, 101973], [246, 102133], [249, 102253], [257, 102593]]}, {"verse": 12, "start": 103767, "end": 107814, "text": "Y saliendo, predicaban que los hombres se arrepintiesen.", "words": [[0, 103767], [2, 104070], [12, 104630], [23, 105430], [27, 105590], [31, 105790], [39, 106190], [42, 107028]]}, {"verse": 13, "start": 108264, "end": 113858, "text": "Y echaban fuera muchos demonios, y ungían con aceite a muchos enfermos, y sanaban.", "words": [[0, 108264], [2, 108413], [10, 108893], [16, 109113], [23, 109453], [33, 110253], [35, 110633], [42, 111153], [46, 111393], [53, 111733], [55, 111953], [62, 112113], [72, 112853], [74, 113153]]}, {"verse": 14, "start": 114308, "end": 126627, "text": "Y oyó el rey Herodes la fama de Jesús, porque su nombre se había hecho notorio; y dijo: Juan el que bautizaba, ha resucitado de los muertos, y por tanto, poderes milagrosos actúan en él.", "words": [[0, 114308], [2, 114457], [6, 114737], [9, 114877], [13, 115197], [21, 115717], [24, 115797], [29, 116117], [32, 116197], [39, 116897], [46, 117097], [49, 117297], [56, 117637], [59, 117837], [65, 118077], [71, 118417], [80, 119490], [82, 119806], [88, 120515], [93, 120747], [96, 120847], [100, 120987], [111, 121707], [114, 122207], [125, 122927], [128, 123047], [132, 123167], [141, 123647], [143, 124147], [147, 124307], [154, 124687], [162, 125227], [173, 125827], [180, 126207], [183, 126307]]}, {"verse": 15, "start": 126977, "end": 133551, "text": "Otros decían: Elías es. Y otros decían: Profeta es, o alguno de los profetas.", "words": [[0, 126977], [6, 127348], [14, 128626], [20, 129106], [24, 129896], [26, 130062], [32, 130242], [40, 131408], [48, 131849], [52, 132069], [54, 132209], [61, 132589], [64, 132649], [68, 132769]]}, {"verse": 16, "start": 133901, "end": 140596, "text": "Y oyéndolo Herodes, dijo: Este es Juan el que yo degollé: él ha resucitado de los muertos.", "words": [[0, 133901], [2, 134063], [11, 134663], [20, 135323], [26, 136358], [31, 136678], [34, 136898], [39, 137158], [42, 137478], [46, 137618], [49, 138028], [58, 138682], [61, 138979], [64, 139319], [75, 139659], [78, 139779], [82, 139899]]}, {"verse": 17, "start": 140946, "end": 154080, "text": "Porque el mismo Herodes había enviado, y prendido a Juan, y le había aprisionado en la cárcel a causa de Herodías, mujer de Felipe su hermano; pues la había tomado por mujer.", "words": [[0, 140946], [7, 141267], [10, 141467], [16, 141807], [24, 142287], [30, 142707], [39, 143347], [41, 143787], [50, 144387], [52, 144487], [58, 144927], [60, 145487], [63, 145647], [69, 146007], [81, 147007], [84, 147147], [87, 147307], [94, 147887], [96, 148067], [102, 148427], [105, 148767], [115, 149747], [121, 150187], [124, 150447], [131, 151087], [134, 151187], [143, 152122], [148, 152225], [151, 152425], [157, 152685], [164, 153185], [168, 153465]]}, {"verse": 18, "start": 154530, "end": 159756, "text": "Porque Juan decía a Herodes: No te es lícito tener la mujer de tu hermano.", "words": [[0, 154530], [7, 154734], [12, 155114], [18, 155894], [20, 156334], [29, 157416], [32, 157560], [35, 157787], [38, 158013], [45, 158240], [51, 158520], [54, 158700], [60, 158960], [63, 159140], [66, 159240]]}, {"verse": 19, "start": 160106, "end": 165232, "text": "Pero Herodías le guardaba rencor, y deseaba matarle, y no podía:", "words": [[0, 160106], [5, 160471], [14, 160871], [17, 161390], [26, 161950], [34, 162510], [36, 162991], [44, 163721], [53, 164450], [55, 164551], [58, 164651]]}, {"verse": 20, "start": 165682, "end": 176858, "text": "Porque Herodes temía a Juan, sabiendo que era varón justo y santo, y le tenía respeto: y oyéndole, hacía muchas cosas; y le oía de buena gana.", "words": [[0, 165682], [7, 165925], [15, 166465], [21, 167265], [23, 167465], [29, 168185], [38, 168625], [42, 168825], [46, 168965], [52, 169285], [58, 169625], [60, 169825], [67, 170625], [69, 170685], [72, 170825], [78, 171165], [87, 172322], [89, 172622], [99, 173182], [105, 173702], [112, 174042], [119, 175231], [121, 175373], [124, 175513], [128, 175873], [131, 176033], [137, 176253]]}, {"verse": 21, "start": 177308, "end": 188761, "text": "Y venido un día oportuno, en que Herodes, en la fiesta de su nacimiento, daba una cena a sus nobles y comandantes militares, y a los principales de Galilea;", "words": [[0, 177308], [2, 177438], [9, 177818], [12, 177978], [16, 178178], [26, 179518], [29, 179698], [33, 179878], [42, 180818], [45, 181118], [48, 181258], [55, 181618], [58, 181798], [61, 181938], [73, 183218], [78, 183538], [82, 183738], [87, 184078], [89, 184358], [93, 184558], [100, 185198], [102, 185378], [114, 185998], [125, 186718], [127, 187058], [129, 187098], [133, 187218], [145, 187918], [148, 188058]]}, {"verse": 22, "start": 189211, "end": 202570, "text": "Y entrando la hija de Herodías, y danzando, y agradando a Herodes y a los que estaban con él a la mesa, el rey dijo a la muchacha: Pídeme lo que quieras, que yo te lo daré.", "words": [[0, 189211], [2, 189374], [11, 189914], [14, 190134], [19, 190574], [22, 190694], [32, 191994], [34, 192194], [44, 193514], [46, 193594], [56, 194214], [58, 194454], [66, 194954], [68, 195334], [70, 195414], [74, 195514], [78, 195654], [86, 195954], [90, 196254], [93, 196414], [95, 196494], [98, 196594], [104, 197394], [107, 197594], [111, 197954], [116, 198414], [118, 198554], [121, 198594], [131, 199566], [138, 199904], [141, 200044], [145, 200164], [154, 200684], [158, 200884], [161, 201024], [164, 201144], [167, 201244]]}, {"verse": 23, "start": 202920, "end": 208176, "text": "Y le juró: Todo lo que me pidas te daré, hasta la mitad de mi reino.", "words": [[0, 202920], [2, 203066], [5, 203166], [11, 203987], [16, 204144], [19, 204344], [23, 204464], [26, 204584], [32, 204904], [35, 205064], [41, 205484], [47, 205804], [50, 205984], [56, 206244], [59, 206484], [62, 206604]]}, {"verse": 24, "start": 208526, "end": 216893, "text": "Y saliendo ella, dijo a su madre: ¿Qué pediré? Y ella dijo: La cabeza de Juan Bautista.", "words": [[0, 208526], [2, 208635], [11, 209115], [17, 209355], [22, 209695], [24, 209855], [27, 209975], [34, 210821], [39, 210945], [47, 213950], [49, 214112], [54, 214312], [60, 215152], [63, 215259], [70, 215619], [73, 215859], [78, 216059]]}, {"verse": 25, "start": 217243, "end": 225844, "text": "Entonces ella entró de inmediato al rey, y pidió, diciendo: Quiero que ahora mismo me des en un plato la cabeza de Juan Bautista.", "words": [[0, 217243], [9, 217788], [14, 218668], [20, 219148], [23, 219248], [33, 219848], [36, 220008], [41, 220428], [43, 220588], [50, 221408], [60, 222364], [67, 222544], [71, 222664], [77, 222844], [83, 223184], [86, 223384], [90, 223524], [93, 223664], [96, 223784], [102, 224104], [105, 224224], [112, 224544], [115, 224744], [120, 224964]]}, {"verse": 26, "start": 226194, "end": 234779, "text": "Y el rey se entristeció mucho; pero a causa del juramento, y de los que estaban con él a la mesa, no quiso desecharla.", "words": [[0, 226194], [2, 226391], [5, 226551], [9, 226991], [12, 227071], [24, 227931], [31, 228935], [36, 229079], [38, 229219], [44, 229539], [48, 229859], [59, 230859], [61, 231099], [64, 231199], [68, 231359], [72, 231519], [80, 231839], [84, 232119], [87, 232319], [89, 232399], [92, 232519], [98, 233339], [101, 233459], [107, 233799]]}, {"verse": 27, "start": 235229, "end": 241013, "text": "Y luego el rey, enviando un verdugo de la guardia, mandó que fuese traída su cabeza;", "words": [[0, 235229], [2, 235391], [8, 235551], [11, 235791], [16, 236271], [25, 236911], [28, 237071], [36, 237491], [39, 237651], [42, 237771], [51, 238611], [57, 239051], [61, 239171], [67, 239661], [74, 240151], [77, 240311]]}, {"verse": 28, "start": 241463, "end": 251193, "text": "El cual fue, y le degolló en la cárcel, y trajo su cabeza en un plato, y la dio a la muchacha, y la muchacha la dio a su madre.", "words": [[0, 241463], [3, 241608], [8, 241888], [13, 242408], [15, 242768], [18, 242928], [26, 243548], [29, 243708], [32, 243868], [40, 244448], [42, 244948], [48, 245368], [51, 245548], [58, 245888], [61, 246168], [64, 246288], [71, 246888], [73, 247388], [76, 247528], [80, 247708], [82, 247888], [85, 247948], [95, 248888], [97, 249328], [100, 249448], [109, 249948], [112, 250108], [116, 250328], [118, 250468], [121, 250588]]}, {"verse": 29, "start": 251643, "end": 258952, "text": "Y oyéndolo sus discípulos, vinieron y tomaron su cuerpo, y le pusieron en un sepulcro.", "words": [[0, 251643], [2, 251800], [11, 252420], [15, 252700], [27, 254180], [36, 254800], [38, 255060], [46, 255540], [49, 255780], [57, 256280], [59, 256880], [62, 257020], [71, 257540], [74, 257900], [77, 258080]]}, {"verse": 30, "start": 259402, "end": 268135, "text": "Y los apóstoles se juntaron con Jesús, y le contaron todo lo que habían hecho, y lo que habían enseñado.", "words": [[0, 259402], [2, 259504], [6, 259624], [16, 260224], [19, 260584], [28, 261084], [32, 261284], [39, 261684], [41, 262484], [44, 262604], [53, 263104], [58, 263444], [61, 263704], [65, 263864], [72, 264144], [79, 264524], [81, 265104], [84, 265224], [88, 265344], [95, 265624]]}, {"verse": 31, "start": 268585, "end": 280126, "text": "Y él les dijo: Venid vosotros aparte al lugar desierto, y descansad un poco. Porque eran muchos los que iban y venían, que ni siquiera tenían tiempo para comer.", "words": [[0, 268660], [2, 268736], [5, 268812], [9, 268887], [15, 269263], [21, 269730], [30, 270310], [37, 270890], [40, 271010], [46, 271350], [56, 272150], [58, 272730], [68, 273570], [71, 273730], [77, 274673], [84, 274897], [89, 275117], [96, 275617], [100, 276117], [104, 276337], [109, 276677], [111, 276777], [119, 277437], [123, 277717], [126, 277897], [135, 278317], [142, 278697], [149, 279197], [154, 279477]]}, {"verse": 32, "start": 280576, "end": 284135, "text": "Y se fueron en un barco al lugar desierto aparte.", "words": [[0, 280576], [2, 280684], [5, 280784], [12, 281084], [15, 281644], [18, 281784], [24, 282264], [27, 282404], [33, 282834], [42, 283264]]}, {"verse": 33, "start": 284585, "end": 293768, "text": "Y los vieron ir muchos, y le conocieron; y corrieron allá muchos a pie de las ciudades, y llegaron antes que ellos, y se juntaron a él.", "words": [[0, 284585], [2, 284712], [6, 284832], [13, 285132], [16, 285292], [24, 285692], [26, 286312], [29, 286412], [41, 287585], [43, 287710], [53, 288310], [58, 288810], [65, 288810], [67, 289080], [71, 289350], [74, 289510], [78, 289650], [88, 290390], [90, 290550], [99, 290950], [105, 291210], [109, 291430], [116, 292330], [118, 292590], [121, 292710], [130, 293270], [132, 293390]]}, {"verse": 34, "start": 294218, "end": 304511, "text": "Y saliendo Jesús vio grande multitud, y tuvo compasión de ellos, porque eran como ovejas que no tenían pastor; y les comenzó a enseñar muchas cosas.", "words": [[0, 294218], [2, 294340], [11, 294780], [17, 295220], [21, 295720], [28, 296000], [38, 296680], [40, 297320], [45, 297500], [55, 298140], [58, 298320], [65, 298620], [72, 299360], [77, 299620], [82, 299900], [89, 300400], [93, 300600], [96, 300740], [103, 301060], [111, 302059], [113, 302157], [117, 302277], [125, 302817], [127, 302877], [135, 303397], [142, 303657]]}, {"verse": 35, "start": 304961, "end": 313066, "text": "Y como ya era muy tarde, sus discípulos llegaron a él, diciendo: El lugar es desierto, y ya es muy tarde;", "words": [[0, 304961], [2, 305067], [7, 305267], [10, 305527], [14, 305707], [18, 305887], [25, 306707], [29, 306947], [40, 307987], [49, 308807], [51, 308947], [55, 309187], [65, 310571], [68, 310684], [74, 310884], [77, 311084], [87, 311684], [89, 312064], [92, 312224], [95, 312364], [99, 312504]]}, {"verse": 36, "start": 313516, "end": 319896, "text": "Envíalos para que vayan a los caseríos y aldeas de alrededor, y compren para sí pan; porque no tienen qué comer.", "words": [[0, 313516], [9, 314061], [14, 314281], [18, 314441], [24, 314761], [26, 314861], [30, 315211], [39, 315561], [41, 315661], [48, 316041], [51, 316351], [62, 316661], [64, 317061], [72, 317461], [77, 317764], [80, 318068], [85, 318610], [92, 318776], [95, 318956], [102, 319196], [106, 319396]]}, {"verse": 37, "start": 320246, "end": 330398, "text": "Y respondiendo él, les dijo: Dadles de comer vosotros. Y le dijeron: ¿ Que vayamos y compremos pan por doscientos denarios, y les demos de comer?", "words": [[0, 320246], [2, 320372], [15, 321152], [19, 321392], [23, 321532], [29, 322313], [36, 322918], [39, 323118], [45, 323418], [55, 324734], [57, 324858], [60, 324958], [69, 325933], [71, 325933], [75, 326035], [83, 326515], [85, 326675], [95, 327115], [99, 327475], [103, 327775], [114, 328075], [124, 328815], [126, 329275], [130, 329395], [136, 329695], [139, 329895]]}, {"verse": 38, "start": 330748, "end": 338460, "text": "Y él les dice: ¿Cuántos panes tenéis? Id, y vedlo. Y sabiéndolo, dijeron: Cinco, y dos peces.", "words": [[0, 330748], [2, 330953], [5, 331230], [9, 331507], [15, 332074], [24, 332460], [30, 332900], [38, 333894], [42, 333894], [44, 334322], [51, 335094], [53, 335354], [65, 336054], [74, 337232], [81, 337412], [83, 337602], [87, 337792]]}, {"verse": 39, "start": 338810, "end": 343782, "text": "Y les mandó que hiciesen recostar a todos por grupos sobre la hierba verde.", "words": [[0, 338810], [2, 338933], [6, 339073], [12, 339533], [16, 339693], [25, 340213], [34, 340853], [36, 340953], [42, 341153], [46, 341453], [53, 341853], [59, 342533], [62, 342753], [69, 343173]]}, {"verse": 40, "start": 344232, "end": 349930, "text": "Y se recostaron en grupos, de ciento en ciento, y de cincuenta en cincuenta.", "words": [[0, 344232], [2, 344361], [5, 344481], [16, 345241], [19, 345421], [27, 345781], [30, 346211], [37, 346641], [40, 346991], [48, 347341], [50, 347961], [53, 348291], [63, 348621], [66, 349285]]}, {"verse": 41, "start": 350380, "end": 362791, "text": "Y tomados los cinco panes y los dos peces, mirando al cielo, bendijo, y partió los panes, y dio a sus discípulos para que los pusiesen delante: y repartió a todos los dos peces.", "words": [[0, 350380], [2, 350484], [10, 350924], [14, 351144], [20, 351544], [26, 352124], [28, 352244], [32, 352384], [36, 352544], [43, 353504], [51, 353904], [54, 354064], [61, 354404], [70, 355404], [72, 355444], [79, 355924], [83, 356064], [90, 356644], [92, 356964], [96, 357184], [98, 357364], [102, 357544], [113, 358164], [118, 358384], [122, 358524], [126, 358684], [135, 359144], [144, 360145], [146, 360270], [155, 360990], [157, 361210], [163, 361510], [167, 362010], [171, 362210]]}, {"verse": 42, "start": 363241, "end": 366429, "text": "Y comieron todos, y quedaron satisfechos.", "words": [[0, 363241], [2, 363364], [11, 363804], [18, 364284], [20, 364844], [29, 365324]]}, {"verse": 43, "start": 366879, "end": 371682, "text": "Y alzaron de los pedazos doce cestas llenas, y de los peces.", "words": [[0, 366879], [2, 367021], [10, 367641], [13, 367821], [17, 367981], [25, 368581], [30, 369181], [37, 369781], [45, 370381], [47, 370621], [50, 370741], [54, 370881]]}, {"verse": 44, "start": 372132, "end": 375241, "text": "Y los que comieron eran cinco mil hombres.", "words": [[0, 372132], [2, 372376], [6, 372496], [10, 372636], [19, 373196], [24, 373609], [30, 374023], [34, 374436]]}, {"verse": 45, "start": 375691, "end": 386623, "text": "Y luego hizo que sus discípulos subieran de inmediato al barco y fueran delante de él a Betsaida de la otra parte, entre tanto que él despedía la multitud.", "words": [[0, 375691], [2, 375813], [8, 376033], [13, 376613], [17, 376913], [21, 377113], [32, 377873], [41, 378513], [44, 378693], [54, 379333], [57, 379473], [63, 379973], [65, 380353], [72, 380793], [80, 381213], [83, 381413], [86, 381613], [88, 382013], [97, 382413], [100, 382573], [103, 382693], [108, 382893], [115, 383733], [121, 384053], [127, 384453], [131, 384713], [134, 384913], [143, 385793], [146, 385913]]}, {"verse": 46, "start": 387073, "end": 390247, "text": "Y después que los hubo despedido, se fue al monte a orar.", "words": [[0, 387073], [2, 387199], [10, 387499], [14, 387746], [18, 387992], [23, 388239], [34, 388799], [37, 388959], [41, 389139], [44, 389299], [50, 389559], [52, 389739]]}, {"verse": 47, "start": 390697, "end": 395891, "text": "Y como fue la tarde, el barco estaba en medio del mar, y él solo en tierra.", "words": [[0, 390697], [2, 390977], [7, 391197], [11, 391397], [14, 391557], [21, 392137], [24, 392217], [30, 392637], [37, 392937], [40, 393157], [46, 393377], [50, 393617], [55, 393897], [57, 394417], [60, 394577], [65, 395037], [68, 395497]]}, {"verse": 48, "start": 396341, "end": 408752, "text": "Y los vio esforzándose por remar, porque el viento les era contrario: y cerca del cuarto turno de vigilancia nocturna, vino a ellos andando sobre el mar, y quería precederlos.", "words": [[0, 396341], [2, 396464], [6, 396604], [10, 396884], [23, 397844], [27, 398064], [34, 398904], [41, 399304], [44, 399464], [51, 399824], [55, 400004], [59, 400204], [70, 401371], [72, 401633], [78, 401913], [82, 402173], [89, 402493], [95, 403113], [98, 403213], [109, 403873], [119, 404833], [124, 405053], [126, 405253], [132, 405453], [140, 406053], [146, 406353], [149, 406593], [154, 406833], [156, 407353], [163, 407653]]}, {"verse": 49, "start": 409202, "end": 415349, "text": "Y viéndole ellos, que andaba sobre el mar, pensaron que era fantasma, y dieron voces;", "words": [[0, 409202], [2, 409364], [11, 409864], [18, 410264], [22, 410524], [29, 410924], [35, 411244], [38, 411464], [43, 412164], [52, 412624], [56, 412864], [60, 413024], [70, 413864], [72, 414304], [79, 414584]]}, {"verse": 50, "start": 415799, "end": 423953, "text": "Porque todos le veían, y se turbaron. Pero luego habló con ellos, y les dijo: Ánimo; yo soy, no temáis.", "words": [[0, 415799], [7, 415961], [13, 416281], [16, 416521], [23, 417061], [25, 417501], [28, 417621], [38, 418758], [43, 418903], [49, 419223], [55, 419703], [59, 419863], [66, 420123], [68, 420483], [72, 420623], [78, 421772], [85, 422438], [88, 422665], [93, 422945], [96, 423483]]}, {"verse": 51, "start": 424403, "end": 432256, "text": "Y subió a ellos en el barco, y calmó el viento: y ellos en gran manera estaban fuera de sí, y se maravillaban:", "words": [[0, 424403], [2, 424551], [8, 424951], [10, 425091], [16, 425311], [19, 425551], [22, 425691], [29, 426251], [31, 426631], [37, 427091], [40, 427211], [48, 428177], [50, 428323], [56, 428623], [59, 428843], [64, 429043], [71, 429423], [79, 429823], [85, 430143], [88, 430403], [92, 430643], [94, 431063], [97, 431203]]}, {"verse": 52, "start": 432706, "end": 439550, "text": "Porque aún no habían considerado lo de los panes, por cuanto sus corazones estaban endurecidos.", "words": [[0, 432706], [7, 432968], [11, 433428], [14, 433688], [21, 433988], [33, 434888], [36, 435048], [39, 435188], [43, 435308], [50, 436148], [54, 436548], [61, 436828], [65, 437148], [75, 438008], [83, 438368]]}, {"verse": 53, "start": 440000, "end": 445467, "text": "Y cuando estuvieron de la otra parte, vinieron a tierra de Genezaret, y llegaron a la orilla.", "words": [[0, 440000], [2, 440140], [9, 440320], [20, 440860], [23, 440980], [26, 441100], [31, 441260], [38, 441760], [47, 442520], [49, 442680], [56, 442940], [59, 443430], [70, 443920], [72, 444220], [81, 444680], [83, 444800], [86, 444880]]}, {"verse": 54, "start": 445917, "end": 449438, "text": "Y saliendo ellos del barco, luego le conocieron.", "words": [[0, 445917], [2, 446034], [11, 446534], [17, 446794], [21, 447074], [28, 447954], [34, 448254], [37, 448474]]}, {"verse": 55, "start": 449888, "end": 457962, "text": "Y recorriendo toda la tierra de alrededor, comenzaron a traer de todas partes enfermos en lechos, a donde oían que estaba.", "words": [[0, 449888], [2, 450074], [14, 450734], [19, 450974], [22, 451214], [29, 451614], [32, 451814], [43, 452314], [54, 453314], [56, 453494], [62, 453874], [65, 453994], [71, 454214], [78, 454654], [87, 455374], [90, 455554], [98, 456154], [100, 456434], [106, 456654], [111, 457094], [115, 457294]]}, {"verse": 56, "start": 458412, "end": 474490, "text": "Y donde quiera que entraba, en aldeas, o ciudades, o campos, ponían en las calles a los que estaban enfermos, y le rogaban que tocasen siquiera el borde de su vestido; y todos los que le tocaban quedaban sanos.", "words": [[0, 458412], [2, 458645], [8, 458911], [15, 459178], [19, 459458], [28, 460558], [31, 460938], [39, 461918], [41, 462218], [51, 462898], [53, 463038], [61, 463898], [68, 464478], [71, 464658], [75, 464798], [82, 465318], [84, 465418], [88, 465538], [92, 465678], [100, 465937], [110, 466951], [112, 467231], [115, 467511], [123, 468131], [127, 468311], [135, 468931], [144, 469431], [147, 469611], [153, 469971], [156, 470151], [159, 470291], [168, 471312], [170, 471429], [176, 471789], [180, 472309], [184, 472489], [187, 472589], [195, 473169], [204, 473669]]}]}