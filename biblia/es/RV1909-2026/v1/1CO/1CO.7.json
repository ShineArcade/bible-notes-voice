{"book": "1CO", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 302676, "verses": [{"verse": 1, "start": 300, "end": 4659, "text": "Cuanto a las cosas de que me escribisteis, bien es al hombre no tocar mujer.", "words": [[0, 300], [7, 549], [9, 729], [13, 869], [19, 1189], [22, 1469], [26, 1569], [29, 1689], [43, 2209], [48, 2729], [51, 3249], [54, 3369], [61, 3609], [64, 3829], [70, 4089]]}, {"verse": 2, "start": 5109, "end": 11457, "text": "Pero a causa de la inmoralidad sexual, cada uno tenga su mujer, y cada una tenga su marido.", "words": [[0, 5109], [5, 5233], [7, 5393], [13, 5593], [16, 5833], [19, 5953], [31, 6573], [39, 7453], [44, 7633], [48, 7933], [54, 8253], [57, 8453], [64, 8813], [66, 9213], [71, 9433], [75, 9673], [81, 9973], [84, 10193]]}, {"verse": 3, "start": 11907, "end": 17005, "text": "El marido preste a la mujer la debida atención conyugal; y asimismo la mujer al marido.", "words": [[0, 11907], [3, 12003], [10, 12383], [17, 12743], [19, 12823], [22, 12883], [28, 13163], [31, 13423], [38, 13763], [47, 14368], [57, 15225], [59, 15326], [68, 15866], [71, 16026], [77, 16306], [80, 16486]]}, {"verse": 4, "start": 17455, "end": 25787, "text": "La mujer no tiene potestad de su propio cuerpo, sino el marido: e igualmente tampoco el marido tiene potestad de su propio cuerpo, sino la mujer.", "words": [[0, 17455], [3, 17541], [9, 17801], [12, 18041], [18, 18261], [27, 18861], [30, 18961], [33, 19121], [40, 19381], [48, 20101], [53, 20241], [56, 20421], [64, 21231], [66, 21333], [77, 21893], [85, 22173], [88, 22493], [95, 22853], [101, 23073], [110, 23713], [113, 23853], [116, 24013], [123, 24253], [131, 25033], [136, 25173], [139, 25333]]}, {"verse": 5, "start": 26237, "end": 38149, "text": "No os defraudéis el uno al otro, a no ser por algún tiempo de mutuo consentimiento, para ocuparos en la oración: y volved a juntaros en uno, porque no os tiente Satanás a causa de vuestra falta de dominio propio.", "words": [[0, 26429], [3, 26664], [6, 26899], [17, 27134], [20, 27274], [24, 27454], [27, 27594], [33, 28354], [35, 28434], [38, 28554], [42, 28754], [46, 28934], [52, 29154], [59, 29534], [62, 29734], [68, 30114], [84, 30994], [89, 31294], [98, 31874], [101, 32034], [104, 32134], [113, 33022], [115, 33153], [122, 33323], [124, 33483], [133, 33943], [136, 34123], [141, 34343], [148, 34703], [151, 34943], [154, 35143], [161, 35343], [169, 36003], [171, 36143], [177, 36383], [180, 36603], [188, 36903], [194, 37163], [197, 37323], [205, 37703]]}, {"verse": 6, "start": 38599, "end": 41352, "text": "Pero esto digo como concesión, no por mandamiento.", "words": [[0, 38599], [5, 38721], [10, 38941], [15, 39221], [20, 39501], [31, 40381], [34, 40441], [38, 40621]]}, {"verse": 7, "start": 41802, "end": 50100, "text": "Quisiera más bien que todos los hombres fuesen como yo: pero cada uno tiene su propio don de Dios; uno a la verdad así, y otro así.", "words": [[0, 41802], [9, 42163], [13, 42363], [18, 42623], [22, 42803], [28, 43023], [32, 43243], [40, 43613], [47, 43983], [52, 44183], [56, 44856], [61, 44996], [66, 45196], [70, 45476], [76, 45756], [79, 45956], [86, 46169], [90, 46383], [93, 46596], [99, 47435], [103, 47635], [105, 47775], [108, 47835], [115, 48095], [120, 48495], [122, 48795], [127, 48995]]}, {"verse": 8, "start": 50550, "end": 54771, "text": "Digo pues a los solteros y a las viudas, que bueno les es si se quedan como yo.", "words": [[0, 50550], [5, 50726], [10, 50986], [12, 51186], [16, 51306], [25, 51926], [27, 52046], [29, 52106], [33, 52246], [41, 52706], [45, 52866], [51, 53146], [55, 53366], [58, 53526], [61, 53706], [64, 53846], [71, 54186], [76, 54386]]}, {"verse": 9, "start": 55221, "end": 60240, "text": "Y si no tienen don de dominio propio, cásense; que mejor es casarse que quemarse.", "words": [[0, 55221], [2, 55326], [5, 55426], [8, 55566], [15, 55759], [19, 55953], [22, 56146], [30, 56726], [38, 57446], [47, 58412], [51, 58494], [57, 58787], [60, 59081], [68, 59374], [72, 59574]]}, {"verse": 10, "start": 60690, "end": 68051, "text": "Pero a los que están juntos en matrimonio, ordeno, no yo, sino el Señor: Que la mujer no se aparte del marido;", "words": [[0, 60690], [5, 60848], [7, 60948], [11, 61068], [15, 61168], [21, 61388], [28, 61708], [31, 61948], [43, 62828], [51, 63408], [54, 63508], [58, 64168], [63, 64328], [66, 64508], [73, 65306], [77, 65383], [80, 65463], [86, 65703], [89, 65936], [92, 66170], [99, 66403], [103, 66643]]}, {"verse": 11, "start": 68501, "end": 75086, "text": "Y si se aparta, que se quede sin casar, o que se reconcilie con su marido; y que el marido no despida a su mujer.", "words": [[0, 68501], [2, 68608], [5, 68688], [8, 68848], [16, 69368], [20, 69488], [23, 69678], [29, 69868], [33, 70088], [40, 70708], [42, 71068], [46, 71188], [49, 71308], [60, 71968], [64, 72128], [67, 72268], [75, 73106], [77, 73208], [81, 73308], [84, 73388], [91, 73748], [94, 73888], [102, 74368], [104, 74448], [107, 74568]]}, {"verse": 12, "start": 75536, "end": 83382, "text": "Y a los demás yo digo, no el Señor: Si algún hermano tiene mujer no creyente, y ella consiente en vivir con él, no la despida.", "words": [[0, 75536], [2, 75623], [4, 75683], [8, 75803], [14, 76243], [17, 76363], [23, 76903], [26, 77023], [29, 77163], [36, 77999], [39, 78154], [45, 78454], [53, 78974], [59, 79174], [65, 79534], [68, 79754], [78, 80334], [80, 80654], [85, 81064], [95, 81474], [98, 81594], [104, 81754], [108, 82054], [112, 82554], [115, 82634], [118, 82754]]}, {"verse": 13, "start": 83832, "end": 89436, "text": "Y la mujer que tiene marido no creyente, y él consiente en vivir con ella, no lo deje.", "words": [[0, 83832], [2, 83915], [5, 83995], [11, 84295], [15, 84535], [21, 84795], [28, 85215], [31, 85335], [41, 85975], [43, 86535], [46, 86935], [56, 87335], [59, 87475], [65, 87635], [69, 87955], [75, 88235], [78, 88815], [81, 88955]]}, {"verse": 14, "start": 89886, "end": 99653, "text": "Porque el marido no creyente es santificado en la mujer, y la mujer no creyente en el marido: pues de otra manera vuestros hijos serían inmundos; pero ahora son santos.", "words": [[0, 89886], [7, 90093], [10, 90253], [17, 90593], [20, 90733], [29, 91313], [32, 91653], [44, 92373], [47, 92473], [50, 92553], [57, 92913], [59, 93293], [62, 93413], [68, 93653], [71, 93893], [80, 94453], [83, 94573], [86, 94673], [94, 95469], [99, 95574], [102, 95754], [107, 95934], [114, 96434], [123, 96754], [129, 96934], [136, 97394], [146, 98400], [151, 98544], [157, 98744], [161, 98984]]}, {"verse": 15, "start": 100103, "end": 109803, "text": "Pero si el no creyente se aparta, apártese: que no es el hermano o la hermana sujeto a servidumbre en semejante caso; antes a paz nos llamó Dios.", "words": [[0, 100103], [5, 100260], [8, 100480], [11, 100620], [14, 100780], [23, 101300], [26, 101520], [34, 102320], [44, 103380], [48, 103462], [51, 103662], [54, 103922], [57, 104062], [65, 104642], [67, 104742], [70, 104882], [78, 105302], [85, 105842], [87, 105922], [99, 106562], [102, 106682], [112, 107242], [118, 108016], [124, 108321], [126, 108521], [130, 108721], [134, 108961], [140, 109281]]}, {"verse": 16, "start": 110253, "end": 117781, "text": "Porque ¿de dónde sabes, oh mujer, si quizá harás salvo a tu marido? ¿o de dónde sabes, oh marido, si quizá harás salva a tu mujer?", "words": [[0, 110253], [7, 110479], [11, 110659], [17, 110819], [24, 111359], [27, 111419], [34, 112159], [37, 112419], [43, 112679], [49, 112899], [55, 113199], [57, 113259], [60, 113359], [68, 114166], [71, 114269], [74, 114349], [80, 114529], [87, 114919], [90, 115309], [98, 116009], [101, 116109], [107, 116489], [113, 116709], [119, 117089], [121, 117169], [124, 117269]]}, {"verse": 17, "start": 118231, "end": 125218, "text": "Pero cada uno como el Señor le repartió, y como Dios llamó a cada uno, así ande: y así enseño en todas las iglesias.", "words": [[0, 118231], [5, 118367], [10, 118567], [14, 118907], [19, 119147], [22, 119287], [28, 119507], [31, 119917], [41, 120327], [43, 120647], [48, 120867], [53, 121067], [59, 121467], [61, 121527], [66, 121687], [71, 122107], [75, 122307], [81, 123082], [83, 123185], [87, 123365], [94, 123925], [97, 124045], [103, 124185], [107, 124730]]}, {"verse": 18, "start": 125668, "end": 133226, "text": "¿Es llamado alguno circuncidado? quédese circunciso. ¿Es llamado alguno incircuncidado? que no se circuncide.", "words": [[0, 125696], [4, 125766], [12, 126339], [19, 126913], [33, 127891], [41, 128091], [53, 129259], [57, 129383], [65, 129663], [72, 130123], [88, 132107], [92, 132157], [95, 132257], [98, 132377]]}, {"verse": 19, "start": 133676, "end": 139829, "text": "La circuncisión nada es, y la incircuncisión nada es; sino la observancia de los mandamientos de Dios.", "words": [[0, 133676], [3, 133775], [16, 134495], [21, 134715], [25, 135295], [27, 135555], [30, 135655], [45, 136415], [50, 136675], [54, 137440], [59, 137642], [62, 137782], [74, 138302], [77, 138442], [81, 138542], [94, 139122], [97, 139322]]}, {"verse": 20, "start": 140279, "end": 143242, "text": "Cada uno en la condición en que fue llamado, en ella se quede.", "words": [[0, 140279], [5, 140421], [9, 140661], [12, 140781], [15, 140881], [25, 141341], [28, 141481], [32, 141561], [36, 141721], [45, 142081], [48, 142461], [53, 142621], [56, 142801]]}, {"verse": 21, "start": 143692, "end": 149555, "text": "¿Eres llamado siendo esclavo? no se te dé cuidado: pero también si puedes hacerte libre, procúralo más.", "words": [[0, 143692], [6, 143875], [14, 144175], [21, 144495], [30, 145465], [33, 145563], [36, 145683], [39, 145823], [42, 145923], [51, 146786], [56, 146894], [64, 147254], [67, 147454], [74, 147694], [82, 148174], [89, 148644], [99, 149114]]}, {"verse": 22, "start": 150005, "end": 158472, "text": "Porque el que en el Señor es llamado siendo esclavo, liberto es del Señor: asimismo también el que es llamado siendo libre, esclavo es de Cristo.", "words": [[0, 150005], [7, 150305], [10, 150465], [14, 150585], [17, 150705], [20, 150805], [26, 151025], [29, 151225], [37, 151525], [44, 151845], [53, 152665], [61, 153125], [64, 153345], [68, 153445], [75, 154239], [84, 154860], [92, 155140], [95, 155440], [99, 155600], [102, 155760], [110, 156100], [117, 156400], [124, 157220], [132, 157720], [135, 157840], [138, 157960]]}, {"verse": 23, "start": 158922, "end": 162602, "text": "Por precio sois comprados; no os hagáis siervos de los hombres.", "words": [[0, 158922], [4, 159186], [11, 159486], [16, 159706], [27, 160709], [30, 160910], [33, 161070], [40, 161390], [48, 161790], [51, 161930], [55, 162030]]}, {"verse": 24, "start": 163052, "end": 167159, "text": "Cada uno, hermanos, en lo que es llamado, en esto se quede para con Dios.", "words": [[0, 163052], [5, 163252], [10, 163492], [20, 164092], [23, 164272], [26, 164392], [30, 164532], [33, 164672], [42, 165392], [45, 165592], [50, 165832], [53, 165992], [59, 166272], [64, 166452], [68, 166672]]}, {"verse": 25, "start": 167609, "end": 175993, "text": "En cuanto a las vírgenes, no tengo mandamiento del Señor; pero doy mi parecer, como quien ha alcanzado misericordia del Señor para ser fiel.", "words": [[0, 167609], [3, 167766], [10, 167946], [12, 168126], [16, 168266], [26, 169046], [29, 169186], [35, 169486], [47, 170026], [51, 170226], [58, 171075], [63, 171239], [67, 171519], [70, 171599], [79, 172079], [84, 172819], [90, 173039], [93, 173219], [103, 173819], [116, 174559], [120, 174719], [126, 175059], [131, 175339], [135, 175539]]}, {"verse": 26, "start": 176443, "end": 183321, "text": "Tengo, pues, esto por bueno a causa de la necesidad que apremia, que bueno es al hombre estarse así.", "words": [[0, 176443], [7, 176681], [13, 176961], [18, 177321], [22, 177561], [28, 177881], [30, 178041], [36, 178281], [39, 178521], [42, 178621], [52, 179261], [56, 179401], [65, 180301], [69, 180381], [75, 180661], [78, 180861], [81, 181021], [88, 181221], [96, 181701]]}, {"verse": 27, "start": 183771, "end": 189498, "text": "¿Estás ligado a mujer? no procures soltarte. ¿Estás suelto de mujer? no procures mujer.", "words": [[0, 183771], [7, 184056], [14, 184416], [16, 184516], [23, 185257], [26, 185462], [35, 185702], [45, 186832], [52, 187116], [59, 187496], [62, 187596], [69, 188412], [72, 188557], [81, 188957]]}, {"verse": 28, "start": 189948, "end": 199408, "text": "Pero también si te casas, no pecas; y si la doncella se casa, no peca; pero los tales tendrán aflicción de la carne, y yo os la quisiera evitar.", "words": [[0, 189948], [5, 190069], [13, 190329], [16, 190509], [19, 190629], [26, 191229], [29, 191309], [36, 192230], [38, 192312], [41, 192392], [44, 192532], [53, 192892], [56, 193052], [62, 193792], [65, 193932], [71, 194721], [76, 194861], [80, 195041], [86, 195301], [94, 195881], [104, 196461], [107, 196601], [110, 196701], [117, 197121], [119, 197761], [122, 198001], [125, 198141], [128, 198281], [137, 198741]]}, {"verse": 29, "start": 199858, "end": 207698, "text": "Pero esto digo, hermanos, que el tiempo es corto: lo que resta es, que los que tienen mujeres sean como los que no las tienen;", "words": [[0, 199858], [5, 200002], [10, 200262], [16, 200682], [26, 201282], [30, 201322], [33, 201462], [40, 201742], [43, 201962], [50, 202812], [53, 202943], [57, 203083], [63, 203483], [67, 203763], [71, 204143], [75, 204303], [79, 204483], [86, 204763], [94, 205323], [99, 206003], [104, 206343], [108, 206503], [112, 206703], [115, 206863], [119, 207063]]}, {"verse": 30, "start": 208148, "end": 216399, "text": "Y los que lloran, como los que no lloran; y los que se alegran, como los que no se alegran; y los que compran, como los que no poseen;", "words": [[0, 208148], [2, 208229], [6, 208349], [10, 208529], [18, 209049], [23, 209429], [27, 209649], [31, 209809], [34, 209969], [42, 210786], [44, 210870], [48, 210990], [52, 211190], [55, 211350], [64, 211830], [69, 212190], [73, 212370], [77, 212570], [80, 212710], [83, 212910], [92, 213818], [94, 213919], [98, 214059], [102, 214259], [111, 214739], [116, 214999], [120, 215199], [124, 215399], [127, 215559]]}, {"verse": 31, "start": 216849, "end": 222882, "text": "Y los que usan de este mundo, como los que no usan: porque la apariencia de este mundo se pasa.", "words": [[0, 216849], [2, 217109], [6, 217269], [10, 217469], [15, 217809], [18, 217929], [23, 218089], [30, 218489], [35, 218869], [39, 219069], [43, 219229], [46, 219429], [52, 220278], [59, 220485], [62, 220705], [73, 221385], [76, 221605], [81, 221845], [87, 222165], [90, 222405]]}, {"verse": 32, "start": 223332, "end": 232038, "text": "Quisiera, pues, que estuvieseis sin preocupaciones. El soltero tiene cuidado de las cosas que son del Señor, cómo ha de agradar al Señor:", "words": [[0, 223332], [10, 223790], [16, 224070], [20, 224470], [32, 225370], [36, 225610], [52, 227063], [55, 227327], [63, 227627], [69, 227907], [77, 228347], [80, 228567], [84, 228727], [90, 229087], [94, 229327], [98, 229527], [102, 229707], [109, 230467], [114, 230687], [117, 230887], [120, 230987], [128, 231447], [131, 231547]]}, {"verse": 33, "start": 232488, "end": 237845, "text": "Pero el que se casó tiene cuidado de las cosas que son del mundo, cómo ha de agradar a su mujer.", "words": [[0, 232488], [5, 232628], [8, 232768], [12, 232888], [15, 233008], [20, 233448], [26, 233668], [34, 234068], [37, 234288], [41, 234428], [47, 234748], [51, 234948], [55, 235128], [59, 235308], [66, 235708], [71, 236388], [74, 236588], [77, 236708], [85, 237128], [87, 237168], [90, 237308]]}, {"verse": 34, "start": 238295, "end": 252911, "text": "Hay asimismo diferencia entre la casada y la doncella: la doncella tiene cuidado de las cosas del Señor, para ser santa así en el cuerpo como en el espíritu: pero la casada tiene cuidado de las cosas del mundo, cómo ha de agradar a su marido.", "words": [[0, 238295], [4, 238484], [13, 239064], [24, 239424], [30, 240044], [33, 240224], [40, 240724], [42, 240944], [45, 241044], [55, 241976], [58, 242090], [67, 242650], [73, 242890], [81, 243330], [84, 243550], [88, 243690], [94, 243990], [98, 244230], [105, 244650], [110, 245010], [114, 245250], [120, 245750], [124, 246170], [127, 246330], [130, 246430], [137, 246750], [142, 247030], [145, 247170], [148, 247270], [158, 248210], [163, 248348], [166, 248598], [173, 248848], [179, 249088], [187, 249488], [190, 249708], [194, 249848], [200, 250148], [204, 250388], [211, 251168], [216, 251488], [219, 251708], [222, 251808], [230, 252268], [232, 252328], [235, 252428]]}, {"verse": 35, "start": 253361, "end": 261540, "text": "Pero esto digo para vuestro provecho; no para echaros lazo, sino para lo honesto y decente, y para que sin impedimento os lleguéis al Señor.", "words": [[0, 253361], [5, 253505], [10, 253765], [15, 254045], [20, 254285], [28, 254625], [38, 255544], [41, 255709], [46, 255909], [54, 256329], [60, 257089], [65, 257309], [70, 257549], [73, 257769], [81, 258229], [83, 258269], [92, 258769], [94, 259129], [99, 259349], [103, 259509], [107, 259689], [119, 260429], [122, 260529], [131, 260889], [134, 261049]]}, {"verse": 36, "start": 261990, "end": 270618, "text": "Pero, si a alguno le parece impropio que su hija virgen pase ya de edad, y es necesario que así sea, haga lo que quiera, no peca; cásese.", "words": [[0, 261990], [6, 262128], [9, 262218], [11, 262308], [18, 262728], [21, 262788], [28, 263068], [37, 263728], [41, 263828], [44, 264028], [49, 264328], [56, 264708], [61, 264988], [64, 265288], [67, 265428], [73, 266108], [75, 266288], [78, 266428], [88, 266948], [92, 267188], [96, 267328], [101, 268028], [106, 268268], [109, 268448], [113, 268568], [121, 269268], [124, 269368], [130, 270367]]}, {"verse": 37, "start": 271068, "end": 280766, "text": "Pero el que está firme en su corazón, y no tiene necesidad, sino que tiene libertad de su voluntad, y determinó en su corazón esto, el guardar su hija virgen, bien hace.", "words": [[0, 271068], [5, 271208], [8, 271328], [12, 271428], [17, 271628], [23, 271948], [26, 272028], [29, 272128], [38, 272588], [40, 272888], [43, 273008], [49, 273268], [60, 274248], [65, 274488], [69, 274668], [75, 274908], [84, 275488], [87, 275588], [90, 275708], [100, 276528], [102, 276608], [112, 277168], [115, 277228], [118, 277348], [126, 277688], [132, 278448], [135, 278508], [143, 278928], [146, 279048], [151, 279288], [159, 280078], [164, 280317]]}, {"verse": 38, "start": 281216, "end": 286727, "text": "Así que, el que la da en casamiento, bien hace; y el que no la da en casamiento, hace mejor.", "words": [[0, 281216], [4, 281456], [9, 281656], [12, 281796], [16, 281936], [19, 282076], [22, 282236], [25, 282356], [37, 282876], [42, 283236], [48, 284197], [50, 284299], [53, 284419], [57, 284539], [60, 284719], [63, 284839], [66, 285019], [69, 285119], [81, 285939], [86, 286179]]}, {"verse": 39, "start": 287177, "end": 295792, "text": "La mujer casada está atada a la ley, mientras vive su marido; pero si su marido muere, libre es: cásese con quien quiera, con tal que sea en el Señor.", "words": [[0, 287177], [3, 287274], [9, 287494], [16, 288014], [21, 288214], [27, 288574], [29, 288694], [32, 288754], [37, 289014], [46, 289494], [51, 289874], [54, 290094], [62, 290880], [67, 291000], [70, 291140], [73, 291280], [80, 291640], [87, 291980], [93, 292240], [97, 293028], [104, 293426], [108, 293726], [114, 293886], [122, 294426], [126, 294526], [130, 294726], [134, 294866], [138, 295066], [141, 295186], [144, 295306]]}, {"verse": 40, "start": 296242, "end": 302276, "text": "Pero más feliz será si se queda así, según mi consejo; y pienso que también yo tengo Espíritu de Dios.", "words": [[0, 296242], [5, 296381], [9, 296601], [15, 296941], [20, 297301], [23, 297501], [26, 297641], [32, 297901], [37, 298501], [43, 298721], [46, 298921], [55, 299859], [57, 299959], [64, 300299], [68, 300399], [76, 300739], [79, 300919], [85, 301159], [94, 301739], [97, 301819]]}]}