{"book": "GEN", "chapter": 47, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 302811, "verses": [{"verse": 1, "start": 300, "end": 13514, "text": "Then Joseph came and told Pharaoh, and said, My father and my brethren, and their flocks, and their herds, and all that they have, are come out of the land of Canaan; and, behold, they are in the land of Goshen.", "words": [[0, 300], [5, 499], [12, 819], [17, 1199], [21, 1419], [26, 1579], [35, 2039], [39, 2839], [45, 4140], [48, 4285], [55, 4665], [59, 4985], [62, 5145], [72, 5545], [76, 6145], [82, 6285], [90, 6905], [94, 7165], [100, 7305], [107, 7745], [111, 7865], [115, 8065], [120, 8225], [125, 8385], [131, 8705], [135, 9125], [140, 9345], [144, 9585], [147, 9765], [151, 9865], [156, 10125], [159, 10265], [167, 11161], [172, 11298], [180, 12018], [185, 12198], [189, 12338], [192, 12438], [196, 12538], [201, 12818], [204, 12938]]}, {"verse": 2, "start": 13864, "end": 18253, "text": "And he took some of his brethren, even five men, and presented them to Pharaoh.", "words": [[0, 13864], [4, 13983], [7, 14103], [12, 14323], [17, 14563], [20, 14743], [24, 14883], [34, 15623], [39, 15803], [44, 16243], [49, 16683], [53, 16783], [63, 17123], [68, 17523], [71, 17663]]}, {"verse": 3, "start": 18703, "end": 27991, "text": "And Pharaoh said to his brethren, What is your occupation? And they said to Pharaoh, Your servants are shepherds, both we, and also our fathers.", "words": [[0, 18703], [4, 18843], [12, 19183], [17, 19543], [20, 19743], [24, 19863], [34, 20703], [39, 21003], [42, 21203], [47, 21383], [59, 22514], [63, 22664], [68, 22784], [73, 23064], [76, 23244], [85, 24184], [90, 24324], [99, 24724], [103, 24984], [114, 25884], [119, 26064], [123, 26384], [127, 26764], [132, 27104], [136, 27284]]}, {"verse": 4, "start": 28441, "end": 43256, "text": "They said moreover to Pharaoh, For to sojourn in the land are we come; for your servants have no pasture for their flocks; for the famine is severe in the land of Canaan: now therefore, we pray you, let your servants dwell in the land of Goshen.", "words": [[0, 28441], [5, 28547], [10, 28787], [19, 29287], [22, 29447], [31, 30287], [35, 30387], [38, 30527], [46, 31087], [49, 31187], [53, 31307], [58, 31647], [62, 31807], [65, 31967], [71, 32827], [75, 32957], [80, 33077], [89, 33497], [94, 33797], [97, 34017], [105, 34517], [109, 34817], [115, 34977], [123, 35979], [127, 36087], [131, 36207], [138, 36567], [141, 36847], [148, 37307], [151, 37587], [155, 37687], [160, 37967], [163, 38087], [171, 39052], [175, 39318], [186, 39838], [189, 39978], [194, 40238], [199, 40678], [203, 40798], [208, 40978], [217, 41378], [223, 41798], [226, 42098], [230, 42218], [235, 42478], [238, 42658]]}, {"verse": 5, "start": 43706, "end": 49128, "text": "And Pharaoh spoke to Joseph, saying, Your father and your brethren are come to you:", "words": [[0, 43706], [4, 43850], [12, 44210], [18, 44590], [21, 44810], [29, 45350], [37, 46723], [42, 46840], [49, 47200], [53, 47520], [58, 47660], [67, 48100], [71, 48380], [76, 48640], [79, 48840]]}, {"verse": 6, "start": 49578, "end": 61479, "text": "The land of Egypt is before you; in the best of the land make your father and brethren to dwell; in the land of Goshen let them dwell: and if you know any men of activity among them, then make them rulers over my cattle.", "words": [[0, 49578], [4, 49700], [9, 49960], [12, 50120], [18, 50420], [21, 50660], [28, 51020], [33, 51706], [36, 51823], [40, 51943], [45, 52143], [48, 52303], [52, 52423], [57, 52643], [62, 52863], [67, 52983], [74, 53303], [78, 53523], [87, 53863], [90, 54103], [97, 54920], [100, 55028], [104, 55128], [109, 55348], [112, 55468], [119, 56128], [123, 56288], [128, 56488], [135, 57265], [139, 57369], [142, 57509], [146, 57609], [151, 57769], [155, 57929], [159, 58169], [162, 58309], [171, 58729], [177, 59049], [183, 59629], [188, 59809], [193, 60009], [198, 60169], [205, 60449], [210, 60769], [213, 60969]]}, {"verse": 7, "start": 61829, "end": 67849, "text": "And Joseph brought in Jacob his father, and set him before Pharaoh: and Jacob blessed Pharaoh.", "words": [[0, 61829], [4, 61980], [11, 62340], [19, 62740], [22, 62920], [28, 63280], [32, 63560], [40, 63920], [44, 64480], [48, 64780], [52, 64980], [59, 65320], [68, 66310], [72, 66433], [78, 66813], [86, 67173]]}, {"verse": 8, "start": 68299, "end": 71360, "text": "And Pharaoh said to Jacob, How old are you?", "words": [[0, 68299], [4, 68659], [12, 68979], [17, 69319], [20, 69499], [27, 70393], [31, 70608], [35, 70928], [39, 71108]]}, {"verse": 9, "start": 71710, "end": 86431, "text": "And Jacob said to Pharaoh, The days of the years of my pilgrimage are a hundred and thirty years: few and evil have the days of the years of my life been, and have not attained to the days of the years of the life of my fathers in the days of their pilgrimage.", "words": [[0, 71710], [4, 71856], [10, 72116], [15, 72376], [18, 72556], [27, 73335], [31, 73440], [36, 73720], [39, 73900], [43, 74000], [49, 74280], [52, 74500], [55, 74679], [66, 75080], [70, 75264], [72, 75447], [80, 75632], [84, 75816], [91, 76000], [98, 76924], [102, 77072], [106, 77292], [111, 77572], [116, 77792], [120, 77932], [125, 78232], [128, 78512], [132, 78652], [138, 78912], [141, 79172], [144, 79352], [149, 79652], [155, 79932], [159, 80372], [164, 80532], [168, 80732], [177, 81092], [180, 81312], [184, 81412], [189, 81672], [192, 81912], [196, 82072], [202, 82372], [205, 82852], [209, 83479], [214, 83667], [217, 83867], [220, 84027], [228, 84407], [231, 84907], [235, 84987], [240, 85307], [243, 85447], [249, 85587]]}, {"verse": 10, "start": 86781, "end": 91034, "text": "And Jacob blessed Pharaoh, and went out from before Pharaoh.", "words": [[0, 86781], [4, 86935], [10, 87255], [18, 87595], [27, 88615], [31, 88755], [36, 88955], [40, 89195], [45, 89435], [52, 89775]]}, {"verse": 11, "start": 91484, "end": 100859, "text": "¶ And Joseph placed his father and his brethren, and gave them a possession in the land of Egypt, in the best of the land, in the land of Rameses, as Pharaoh had commanded.", "words": [[2, 91484], [6, 91611], [13, 91951], [20, 92371], [24, 92571], [31, 92891], [35, 93151], [39, 93291], [49, 93711], [53, 94271], [58, 94511], [63, 94711], [65, 94791], [76, 95251], [79, 95531], [83, 95631], [88, 95871], [91, 96051], [98, 96651], [101, 96811], [105, 96911], [110, 97131], [113, 97311], [117, 97411], [123, 97911], [126, 98011], [130, 98131], [135, 98331], [138, 98773], [147, 99515], [150, 99660], [158, 100020], [162, 100240]]}, {"verse": 12, "start": 101309, "end": 108918, "text": "And Joseph nourished his father, and his brethren, and all his father’s household, with bread, according to their families.", "words": [[0, 101309], [4, 101449], [11, 101789], [21, 102409], [25, 102549], [33, 102969], [37, 103569], [41, 103729], [51, 104169], [55, 104769], [59, 105009], [63, 105209], [72, 105709], [83, 106149], [88, 106709], [95, 107109], [105, 107669], [108, 107949], [114, 108129]]}, {"verse": 13, "start": 109368, "end": 118917, "text": "¶ And there was no bread in all the land; for the famine was very severe, so that the land of Egypt and all the land of Canaan fainted by reason of the famine.", "words": [[2, 109368], [6, 109495], [12, 109615], [16, 109775], [19, 109995], [25, 110355], [28, 110575], [32, 110795], [36, 110955], [42, 111788], [46, 111900], [50, 112000], [57, 112340], [61, 112640], [66, 113000], [74, 113940], [77, 114220], [82, 114420], [86, 114540], [91, 114820], [94, 114980], [100, 115360], [104, 115620], [108, 115880], [112, 116040], [117, 116320], [120, 116460], [127, 116920], [135, 117500], [138, 117680], [145, 118060], [148, 118260], [152, 118380]]}, {"verse": 14, "start": 119367, "end": 129200, "text": "And Joseph gathered up all the money that was found in the land of Egypt, and in the land of Canaan, for the grain which they bought: and Joseph brought the money into Pharaoh’s house.", "words": [[0, 119367], [4, 119509], [11, 119869], [20, 120309], [23, 120569], [27, 120849], [31, 121009], [37, 121229], [42, 121429], [46, 121589], [52, 121909], [55, 122089], [59, 122189], [64, 122429], [67, 122569], [74, 122909], [78, 123509], [81, 123649], [85, 123789], [90, 123989], [93, 124129], [101, 124649], [105, 125049], [109, 125189], [115, 125429], [121, 125649], [126, 125829], [134, 126619], [138, 126761], [145, 127101], [153, 127421], [157, 127641], [163, 127881], [168, 128121], [178, 128681]]}, {"verse": 15, "start": 129650, "end": 140288, "text": "And when money failed in the land of Egypt, and in the land of Canaan, all the Egyptians came to Joseph, and said, Give us bread: for why should we die in your presence? for the money fails.", "words": [[0, 129650], [4, 129794], [9, 129954], [15, 130274], [22, 130674], [25, 130874], [29, 130994], [34, 131234], [37, 131374], [44, 131694], [48, 132114], [51, 132254], [55, 132374], [60, 132654], [63, 132754], [71, 133734], [75, 133914], [79, 134094], [89, 134394], [94, 134854], [97, 135054], [105, 135414], [109, 135674], [115, 136400], [120, 136558], [123, 136698], [130, 137420], [134, 137526], [138, 137706], [145, 137846], [148, 137986], [152, 138166], [155, 138306], [160, 138386], [170, 139283], [174, 139380], [178, 139460], [184, 139640]]}, {"verse": 16, "start": 140638, "end": 145442, "text": "And Joseph said, Give your cattle; and I will give you for your cattle, if money fail.", "words": [[0, 140638], [4, 140785], [11, 141125], [17, 141955], [22, 142112], [27, 142292], [35, 143151], [39, 143261], [41, 143401], [46, 143541], [51, 143721], [55, 143841], [59, 144001], [64, 144101], [72, 144441], [75, 144761], [81, 144981]]}, {"verse": 17, "start": 145792, "end": 159504, "text": "And they brought their cattle to Joseph: and Joseph gave them bread in exchange for horses, and for the flocks, and for the cattle of the herds, and for the donkeys: and he fed them with bread for all their cattle for that year.", "words": [[0, 145792], [4, 145914], [9, 146034], [17, 146254], [23, 146494], [30, 146894], [33, 147134], [41, 148043], [45, 148398], [52, 148718], [57, 149058], [62, 149318], [68, 149578], [71, 149778], [80, 150118], [84, 150478], [92, 151298], [96, 151598], [100, 151738], [104, 151838], [112, 152798], [116, 152878], [120, 153038], [124, 153138], [131, 153458], [134, 153658], [138, 153818], [145, 154538], [149, 154758], [153, 154918], [157, 155018], [166, 156106], [170, 156243], [173, 156343], [177, 156623], [182, 156843], [187, 157063], [193, 157383], [197, 157663], [201, 157923], [207, 158123], [214, 158503], [218, 158763], [223, 158983]]}, {"verse": 18, "start": 159954, "end": 174359, "text": "When that year was ended, they came to him the second year, and said to him, We will not hide it from my lord, how that our money is spent; my lord also has our herds of cattle; there is nothing left in the sight of my lord, but our bodies, and our lands:", "words": [[0, 159954], [5, 160102], [10, 160342], [15, 160542], [19, 160742], [26, 161382], [31, 161622], [36, 161902], [39, 162102], [43, 162262], [47, 162442], [54, 162742], [60, 163102], [64, 163682], [69, 163922], [72, 164122], [77, 164744], [80, 164894], [85, 165034], [89, 165234], [94, 165534], [97, 165654], [102, 165814], [105, 165974], [111, 166674], [115, 166894], [120, 167114], [124, 167234], [130, 167474], [133, 167654], [140, 168381], [143, 168500], [148, 168680], [153, 169000], [157, 169240], [161, 169400], [167, 169760], [170, 169840], [178, 170577], [184, 170769], [187, 170929], [195, 171229], [200, 171529], [203, 171729], [207, 171849], [213, 172069], [216, 172189], [219, 172349], [225, 172589], [229, 172829], [233, 172969], [241, 173369], [245, 173709], [249, 173849]]}, {"verse": 19, "start": 174809, "end": 186749, "text": "Why shall we die before your eyes, both we and our land? buy us and our land for bread, and we and our land will be servants to Pharaoh: and give us seed, that we may live, and not die, that the land be not desolate.", "words": [[0, 174809], [4, 175010], [10, 175230], [13, 175390], [17, 175610], [24, 175910], [29, 176110], [35, 176550], [40, 176690], [43, 177010], [47, 177330], [51, 177490], [57, 178263], [61, 178459], [64, 178699], [68, 178939], [72, 179099], [77, 179339], [81, 179499], [88, 179979], [92, 180079], [95, 180279], [99, 180419], [103, 180539], [108, 180779], [113, 180919], [116, 181059], [125, 181399], [128, 181599], [137, 182348], [141, 182445], [146, 182625], [149, 182785], [155, 183125], [160, 183565], [163, 183725], [167, 183885], [173, 184185], [177, 184445], [181, 184645], [186, 185145], [191, 185425], [195, 185565], [200, 185805], [203, 185945], [207, 186125]]}, {"verse": 20, "start": 187099, "end": 196787, "text": "And Joseph bought all the land of Egypt for Pharaoh; for the Egyptians sold every man his field, because the famine prevailed over them: so the land became Pharaoh’s.", "words": [[0, 187099], [4, 187246], [11, 187586], [18, 187966], [22, 188206], [26, 188366], [31, 188606], [34, 188766], [40, 189106], [44, 189366], [53, 190259], [57, 190366], [61, 190506], [71, 190846], [76, 191306], [82, 191646], [86, 192006], [90, 192246], [97, 192866], [105, 193206], [109, 193406], [116, 193706], [126, 194246], [131, 194466], [137, 195136], [140, 195282], [144, 195442], [149, 195662], [156, 196002]]}, {"verse": 21, "start": 197237, "end": 203856, "text": "And as for the people, he removed them to cities from one end of the borders of Egypt even to the other end of it.", "words": [[0, 197237], [4, 197385], [7, 197565], [11, 197725], [15, 197845], [23, 198665], [26, 198745], [34, 199225], [39, 199505], [42, 199705], [49, 200065], [54, 200405], [58, 200725], [62, 200985], [65, 201105], [69, 201205], [77, 201525], [80, 201765], [86, 202365], [91, 202645], [94, 202885], [98, 203045], [104, 203225], [108, 203505], [111, 203625]]}, {"verse": 22, "start": 204306, "end": 215365, "text": "Only the land of the priests bought he not; for the priests had a portion assigned them of Pharaoh, and did eat their portion which Pharaoh gave them: therefore they sold not their lands.", "words": [[0, 204306], [5, 204590], [9, 204790], [14, 205070], [17, 205230], [21, 205370], [29, 205710], [36, 206130], [39, 206350], [44, 207142], [48, 207238], [52, 207378], [60, 207738], [64, 207998], [66, 208118], [74, 208398], [83, 208858], [88, 209078], [91, 209298], [100, 210158], [104, 210318], [108, 210518], [112, 210758], [118, 210958], [126, 211398], [132, 211678], [140, 212118], [145, 212418], [151, 213166], [161, 213690], [166, 213790], [171, 214090], [175, 214350], [181, 214610]]}, {"verse": 23, "start": 215815, "end": 224076, "text": "Then Joseph said to the people, Behold, I have bought you this day and your land for Pharaoh: lo, here is seed for you, and you shall sow the land.", "words": [[0, 215815], [5, 216002], [12, 216342], [17, 216702], [20, 216882], [24, 216982], [32, 217890], [40, 218537], [42, 218617], [47, 218797], [54, 219077], [58, 219237], [63, 219457], [67, 219717], [71, 219977], [76, 220097], [81, 220377], [85, 220577], [94, 221426], [98, 221545], [103, 221765], [106, 221925], [111, 222145], [115, 222325], [120, 222805], [124, 222885], [128, 223004], [134, 223205], [138, 223444], [142, 223605]]}, {"verse": 24, "start": 224526, "end": 235824, "text": "And it shall come to pass in the increase, that you shall give the fifth part to Pharaoh, and four parts shall be your own, for seed of the field, and for your food, and for them of your households, and for food for your little ones.", "words": [[0, 224526], [4, 224680], [7, 224780], [13, 225040], [18, 225240], [21, 225400], [26, 225660], [29, 225820], [33, 225920], [43, 226300], [48, 226800], [52, 226940], [58, 227140], [63, 227340], [67, 227500], [73, 227760], [78, 228040], [81, 228300], [90, 228560], [94, 228920], [99, 229140], [105, 229420], [111, 229600], [114, 229760], [119, 229960], [124, 230200], [128, 230560], [133, 230860], [136, 231000], [140, 231100], [147, 231813], [151, 231911], [155, 232051], [160, 232171], [166, 232511], [170, 232831], [174, 232991], [179, 233211], [182, 233371], [187, 233491], [199, 233911], [203, 234371], [207, 234511], [212, 234751], [216, 234931], [221, 235051], [228, 235311]]}, {"verse": 25, "start": 236174, "end": 242626, "text": "And they said, You have saved our lives: let us find grace in the sight of my lord, and we will be Pharaoh’s servants.", "words": [[0, 236174], [4, 236324], [9, 236444], [15, 237183], [19, 237348], [24, 237468], [30, 237808], [34, 238048], [41, 238938], [45, 239075], [48, 239215], [53, 239435], [59, 239715], [62, 239915], [66, 240015], [72, 240255], [75, 240375], [78, 240475], [84, 241055], [88, 241135], [91, 241275], [96, 241435], [99, 241575], [109, 242055]]}, {"verse": 26, "start": 242976, "end": 252851, "text": "And Joseph made it a law over the land of Egypt to this day, that Pharaoh should have the fifth part; except the land of the priests only, which became not Pharaoh’s.", "words": [[0, 242976], [4, 243109], [11, 243409], [16, 243749], [19, 243869], [21, 243969], [25, 244249], [30, 244549], [34, 244689], [39, 244949], [42, 245089], [48, 245469], [51, 245689], [56, 245909], [61, 246669], [66, 246929], [74, 247269], [81, 247529], [86, 247729], [90, 247869], [96, 248089], [102, 249005], [109, 249282], [113, 249522], [118, 249782], [121, 249942], [125, 250062], [133, 250362], [139, 251202], [145, 251342], [152, 251762], [156, 252022]]}, {"verse": 27, "start": 253301, "end": 261755, "text": "¶ And Israel dwelt in the land of Egypt, in the country of Goshen; and they had possessions in it, and grew, and multiplied exceedingly.", "words": [[2, 253301], [6, 253428], [13, 253788], [19, 254288], [22, 254428], [26, 254528], [31, 254788], [34, 255008], [41, 255668], [44, 255928], [48, 256028], [56, 256348], [59, 256568], [67, 257464], [71, 257587], [76, 257707], [80, 257867], [92, 258307], [95, 258687], [99, 258827], [103, 259247], [109, 259627], [113, 260187], [124, 260807]]}, {"verse": 28, "start": 262205, "end": 269527, "text": "And Jacob lived in the land of Egypt seventeen years: so the whole age of Jacob was a hundred forty and seven years.", "words": [[0, 262205], [4, 262469], [10, 262769], [16, 263109], [19, 263329], [23, 263429], [28, 263669], [31, 263829], [37, 264249], [47, 264669], [54, 265844], [57, 265982], [61, 266102], [67, 266302], [71, 266582], [74, 266722], [80, 267082], [84, 267369], [86, 267655], [94, 267942], [100, 268228], [104, 268514], [110, 268802]]}, {"verse": 29, "start": 269977, "end": 285270, "text": "And the time drew near that Israel must die: and he called his son Joseph, and said to him, If now I have found grace in your sight, put, please, your hand under my thigh, and deal kindly and truly with me; bury me not, please, in Egypt:", "words": [[0, 269977], [4, 270120], [8, 270220], [13, 270540], [18, 270860], [23, 271120], [28, 271400], [35, 271840], [40, 272180], [45, 273141], [49, 273285], [52, 273385], [59, 273685], [63, 273885], [67, 274285], [75, 275025], [79, 275245], [84, 275485], [87, 275705], [92, 276403], [95, 276540], [99, 276780], [101, 276980], [106, 277120], [112, 277380], [118, 277680], [121, 277980], [126, 278100], [133, 278760], [138, 279040], [146, 279440], [151, 279700], [156, 280040], [162, 280320], [165, 280500], [172, 280840], [176, 281280], [181, 281540], [188, 282000], [192, 282300], [198, 282600], [203, 282880], [207, 283595], [212, 283725], [215, 283905], [220, 284385], [228, 284725], [231, 284785]]}, {"verse": 30, "start": 285620, "end": 294234, "text": "But I will lie with my fathers, and you shall carry me out of Egypt, and bury me in their buryingplace. And he said, I will do as you have said.", "words": [[0, 285620], [4, 285800], [6, 285960], [11, 286120], [15, 286360], [20, 286540], [23, 286720], [32, 287520], [36, 287800], [40, 287940], [46, 288140], [52, 288460], [55, 288680], [59, 288860], [62, 289000], [69, 289700], [73, 289800], [78, 290100], [81, 290320], [84, 290460], [90, 291060], [104, 291894], [108, 292022], [111, 292142], [117, 292462], [119, 292622], [124, 292822], [127, 293102], [130, 293422], [134, 293582], [139, 293742]]}, {"verse": 31, "start": 294684, "end": 302411, "text": "And he said, Swear to me. And he swore to him. And Israel bowed himself upon the bed’s head.", "words": [[0, 294684], [4, 294828], [7, 294928], [13, 295660], [19, 295936], [22, 296176], [26, 298126], [30, 298272], [33, 298352], [39, 298712], [42, 298872], [47, 299532], [51, 299647], [58, 300027], [64, 300507], [72, 300727], [77, 301087], [81, 301287], [87, 301607]]}]}