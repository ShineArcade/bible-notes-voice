{"book": "GEN", "chapter": 39, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 218868, "verses": [{"verse": 1, "start": 300, "end": 11554, "text": "Y llevado José a Egipto, lo compró Potifar, eunuco de Faraón, capitán de los de la guardia, varón egipcio, de mano de los ismaelitas que lo habían llevado allá.", "words": [[0, 300], [2, 404], [10, 764], [15, 1044], [17, 1284], [25, 1844], [28, 2264], [35, 2824], [44, 3814], [51, 4804], [54, 4904], [62, 5824], [70, 6364], [73, 6484], [77, 6604], [80, 6724], [83, 6844], [92, 7224], [98, 7604], [107, 8704], [110, 8784], [115, 9024], [118, 9244], [122, 9344], [133, 10104], [137, 10264], [140, 10384], [147, 10604], [155, 11084]]}, {"verse": 2, "start": 12004, "end": 18778, "text": "Mas Jehová estaba con José, y fue un hombre próspero: y estaba en la casa de su señor el egipcio.", "words": [[0, 12164], [4, 12358], [11, 12551], [18, 12811], [22, 13111], [28, 13471], [30, 14271], [34, 14471], [37, 14671], [44, 14951], [54, 16051], [56, 16132], [63, 16452], [66, 16652], [69, 16772], [74, 17072], [77, 17292], [80, 17452], [86, 17642], [89, 17832]]}, {"verse": 3, "start": 19228, "end": 25664, "text": "Y vio su señor que Jehová era con él, y que todo lo que él hacía, Jehová lo hacía prosperar en su mano.", "words": [[0, 19228], [2, 19374], [6, 19594], [9, 19774], [15, 20454], [19, 20534], [26, 21014], [30, 21154], [34, 21434], [38, 22014], [40, 22154], [44, 22274], [49, 22554], [52, 22814], [56, 22954], [59, 23114], [66, 23534], [73, 24034], [76, 24114], [82, 24354], [92, 24934], [95, 25074], [98, 25214]]}, {"verse": 4, "start": 26114, "end": 35057, "text": "Así halló José gracia en sus ojos, y le servía; y él le hizo administrador de su casa, y entregó en su poder todo lo que tenía.", "words": [[0, 26307], [4, 26501], [10, 26694], [15, 27014], [22, 27494], [25, 27594], [29, 27734], [35, 28054], [37, 28394], [40, 28494], [48, 29485], [50, 29647], [53, 29847], [56, 29987], [61, 30347], [75, 31107], [78, 31287], [81, 31427], [87, 31807], [89, 32567], [97, 33107], [100, 33227], [103, 33387], [109, 33747], [114, 34087], [117, 34327], [121, 34467]]}, {"verse": 5, "start": 35507, "end": 51114, "text": "Y aconteció que, desde cuando le dio el encargo de su casa, y de todo lo que tenía, Jehová bendijo la casa del egipcio a causa de José; y la bendición de Jehová fue sobre todo lo que tenía, así en casa como en el campo.", "words": [[0, 35507], [2, 35650], [12, 36310], [17, 36530], [23, 36750], [30, 37170], [33, 37490], [37, 37790], [40, 37990], [48, 38630], [51, 38750], [54, 38930], [60, 39310], [62, 39890], [65, 40070], [70, 40370], [73, 40650], [77, 40790], [84, 41730], [91, 42250], [99, 42790], [102, 42970], [107, 43330], [111, 43570], [119, 44190], [121, 44390], [127, 44690], [130, 44970], [136, 45798], [138, 45923], [141, 46023], [151, 46583], [154, 46743], [161, 47223], [165, 47383], [171, 47703], [176, 48083], [179, 48343], [183, 48483], [190, 49043], [194, 49243], [197, 49523], [202, 49823], [207, 50183], [210, 50363], [213, 50463]]}, {"verse": 6, "start": 51564, "end": 62155, "text": "Y dejó todo lo que tenía en mano de José; no se preocupaba de nada más que del pan que comía. Y era José de hermoso semblante y bella presencia.", "words": [[0, 51564], [2, 51686], [7, 52046], [12, 52406], [15, 52706], [19, 52846], [25, 53186], [28, 53346], [33, 53586], [36, 53786], [42, 54589], [45, 54772], [48, 54912], [59, 55612], [62, 55732], [67, 55912], [71, 56212], [75, 56352], [79, 56572], [83, 56932], [87, 57212], [94, 58167], [96, 58462], [100, 58642], [105, 59122], [108, 59502], [116, 60042], [126, 60682], [128, 60842], [134, 61182]]}, {"verse": 7, "start": 62605, "end": 70162, "text": "Y aconteció después de esto, que la mujer de su señor puso sus ojos en José, y dijo: Duerme conmigo.", "words": [[0, 62605], [2, 62728], [12, 63388], [20, 63688], [23, 63928], [29, 64488], [33, 64908], [36, 65028], [42, 65368], [45, 65568], [48, 65748], [54, 66128], [59, 66628], [63, 66788], [68, 67148], [71, 67448], [77, 67788], [79, 68128], [85, 68905], [92, 69307]]}, {"verse": 8, "start": 70512, "end": 81067, "text": "Y él no quiso, y dijo a la mujer de su señor: He aquí que mi señor no se preocupa de lo que hay en casa estando yo aquí, y ha puesto en mi mano todo lo que tiene:", "words": [[0, 70512], [2, 70676], [5, 70816], [8, 70996], [15, 71796], [17, 72036], [22, 72276], [24, 72356], [27, 72396], [33, 72696], [36, 72876], [39, 73016], [46, 73867], [49, 73977], [54, 74197], [58, 74337], [61, 74477], [67, 74817], [70, 75037], [73, 75197], [82, 75757], [85, 75837], [88, 75937], [92, 76097], [96, 76257], [99, 76417], [104, 76737], [112, 77217], [115, 77417], [121, 77697], [123, 78237], [126, 78297], [133, 78537], [136, 78737], [139, 78877], [144, 79117], [149, 79377], [152, 79557], [156, 79697]]}, {"verse": 9, "start": 81517, "end": 91348, "text": "No hay otro mayor que yo en esta casa, y ninguna cosa me ha reservado sino a ti, por cuanto tú eres su mujer; ¿cómo, pues, haría yo este grande mal, y pecaría contra Dios?", "words": [[0, 81517], [3, 81675], [7, 81815], [12, 81995], [18, 82335], [22, 82515], [25, 82695], [28, 82795], [33, 82975], [39, 83535], [41, 83595], [49, 83875], [54, 84215], [57, 84435], [60, 84475], [70, 85015], [75, 85215], [77, 85435], [81, 85855], [85, 86115], [92, 86435], [95, 86635], [100, 86815], [103, 87015], [110, 87756], [117, 87917], [123, 88257], [129, 88757], [132, 88917], [137, 89117], [144, 89377], [149, 89717], [151, 90017], [159, 90477], [166, 90777]]}, {"verse": 10, "start": 91698, "end": 101118, "text": "Y aconteció que hablando ella a José cada día, y no escuchándola él para acostarse al lado de ella, para estar con ella,", "words": [[0, 91698], [2, 91816], [12, 92616], [16, 93116], [25, 93476], [30, 93896], [32, 94116], [37, 94356], [42, 94736], [47, 95136], [49, 95836], [52, 96096], [65, 97176], [68, 97476], [73, 97756], [83, 98516], [86, 98716], [91, 98976], [94, 99256], [100, 99556], [105, 100076], [111, 100336], [115, 100636]]}, {"verse": 11, "start": 101568, "end": 109034, "text": "Aconteció que entró él un día en casa para cumplir con sus responsabilidades, y no había nadie de la casa allí:", "words": [[0, 101568], [10, 102310], [14, 102510], [20, 102950], [23, 103130], [26, 103370], [30, 103610], [33, 103810], [38, 104150], [43, 104470], [51, 105050], [55, 105210], [59, 105490], [78, 106730], [80, 107290], [83, 107430], [89, 107630], [95, 108010], [98, 108210], [101, 108310], [106, 108590]]}, {"verse": 12, "start": 109484, "end": 119749, "text": "Y lo agarró ella por su ropa, diciendo: Duerme conmigo. Entonces él dejó su ropa en las manos de ella, y huyó, y se salió fuera.", "words": [[0, 109484], [2, 109610], [5, 109750], [12, 110310], [17, 110610], [21, 110890], [24, 111110], [30, 111650], [40, 112839], [47, 113242], [56, 114446], [65, 114904], [68, 115604], [73, 116004], [76, 116144], [81, 116564], [84, 116664], [88, 116784], [94, 117064], [97, 117284], [103, 117524], [105, 117804], [111, 118204], [113, 118664], [116, 118804], [122, 119184]]}, {"verse": 13, "start": 120199, "end": 126706, "text": "Y acaeció que cuando vio ella que le había dejado su ropa en sus manos, y había huido fuera,", "words": [[0, 120199], [2, 120382], [10, 121122], [14, 121382], [21, 121682], [25, 122122], [30, 122382], [34, 122602], [37, 122762], [43, 123022], [50, 123502], [53, 123722], [58, 124122], [61, 124242], [65, 124362], [72, 124802], [74, 125322], [80, 125642], [86, 126122]]}, {"verse": 14, "start": 127156, "end": 138911, "text": "Llamó a los de casa, y les habló diciendo: Mirad, nos ha traído un hebreo, para que hiciese burla de nosotros: vino él a mí para dormir conmigo, y yo di grandes voces;", "words": [[0, 127156], [6, 127618], [8, 127738], [12, 127838], [15, 127998], [21, 128318], [23, 129058], [27, 129238], [33, 129658], [43, 130700], [50, 131092], [54, 131212], [57, 131372], [64, 131712], [67, 131872], [75, 132372], [80, 132832], [84, 132992], [92, 133412], [98, 133852], [101, 133992], [111, 135073], [116, 135398], [119, 135578], [121, 135678], [124, 135818], [129, 136058], [136, 136358], [145, 137138], [147, 137538], [150, 137718], [153, 137838], [161, 138118]]}, {"verse": 15, "start": 139361, "end": 146470, "text": "Y viendo que yo alzaba la voz y gritaba, dejó junto a mí su ropa, y huyó, y se salió fuera.", "words": [[0, 139361], [2, 139461], [9, 139741], [13, 139921], [16, 140081], [23, 140521], [26, 140661], [30, 140961], [32, 141161], [41, 142101], [46, 142301], [52, 142481], [54, 142701], [57, 142801], [60, 142981], [66, 143381], [68, 143631], [74, 143881], [76, 144321], [79, 144461], [85, 144821]]}, {"verse": 16, "start": 146820, "end": 151683, "text": "Y ella puso junto a sí la ropa de él, hasta que vino su señor a su casa.", "words": [[0, 146820], [2, 146959], [7, 147199], [12, 147579], [18, 147772], [20, 147966], [23, 148159], [26, 148359], [31, 148719], [34, 148879], [38, 149359], [44, 149879], [48, 150079], [53, 150279], [56, 150579], [62, 150879], [64, 151039], [67, 151099]]}, {"verse": 17, "start": 152133, "end": 160898, "text": "Entonces le habló ella semejantes palabras, diciendo: El siervo hebreo que nos trajiste, vino a mí para deshonrarme;", "words": [[0, 152133], [9, 152836], [12, 153496], [18, 153766], [23, 154036], [34, 154716], [44, 155216], [54, 156517], [57, 156686], [64, 157126], [71, 157526], [75, 157626], [79, 157806], [89, 158446], [94, 159106], [96, 159366], [99, 159546], [104, 159786]]}, {"verse": 18, "start": 161348, "end": 167340, "text": "Y como yo alcé mi voz y grité, él dejó su ropa junto a mí, y huyó fuera.", "words": [[0, 161348], [2, 161454], [7, 161694], [10, 161934], [15, 162294], [18, 162454], [22, 162754], [24, 162934], [31, 163694], [34, 163834], [39, 164294], [42, 164454], [47, 164814], [53, 165034], [55, 165294], [59, 165494], [61, 165954], [66, 166194]]}, {"verse": 19, "start": 167690, "end": 179395, "text": "Y sucedió que como oyó su señor las palabras que su mujer le hablara, diciendo: Así me ha tratado tu siervo; se encendió su furor.", "words": [[0, 167690], [2, 167818], [10, 168438], [14, 168598], [19, 168998], [23, 169538], [26, 169698], [32, 170118], [36, 170398], [45, 170758], [49, 171038], [52, 171198], [58, 171578], [61, 171798], [70, 172298], [80, 173798], [84, 174202], [87, 174342], [90, 174462], [98, 174922], [101, 175062], [109, 177723], [112, 177930], [121, 178630], [124, 178790]]}, {"verse": 20, "start": 179845, "end": 188260, "text": "Y tomó su señor a José, y lo puso en la casa de la cárcel, donde estaban los presos del rey, y estuvo allí en la casa de la cárcel.", "words": [[0, 179845], [2, 179969], [7, 180289], [10, 180449], [16, 180609], [18, 180769], [24, 181229], [26, 181689], [29, 181809], [34, 182149], [37, 182249], [40, 182349], [45, 182609], [48, 182829], [51, 182949], [59, 183449], [65, 183929], [73, 184329], [77, 184569], [84, 185049], [88, 185269], [93, 185829], [95, 185949], [102, 186309], [107, 186649], [110, 186969], [113, 187089], [118, 187329], [121, 187529], [124, 187649]]}, {"verse": 21, "start": 188710, "end": 197925, "text": "Pero Jehová fue con José, y extendió a él su misericordia, y le dio gracia ante los ojos del jefe de la cárcel.", "words": [[0, 188710], [5, 188914], [12, 189474], [16, 189634], [20, 189914], [26, 190334], [28, 191154], [37, 192034], [39, 192254], [42, 192514], [45, 192794], [59, 193954], [61, 194614], [64, 194774], [68, 194974], [75, 195574], [80, 195794], [84, 195994], [89, 196314], [93, 196594], [98, 197034], [101, 197154], [104, 197294]]}, {"verse": 22, "start": 198375, "end": 207842, "text": "Y el principal de la casa de la cárcel entregó en mano de José todos los presos que había en aquella prisión; todo lo que hacían allí, él lo hacía.", "words": [[0, 198375], [2, 198498], [5, 198618], [15, 199278], [18, 199658], [21, 199778], [26, 200058], [29, 200238], [32, 200358], [39, 200778], [47, 201538], [50, 201658], [55, 201878], [58, 202078], [63, 202318], [69, 202658], [73, 202978], [80, 203378], [84, 203518], [90, 203738], [93, 203938], [101, 204278], [110, 205239], [115, 205441], [118, 205721], [122, 206068], [129, 206414], [135, 206761], [138, 206921], [141, 207181]]}, {"verse": 23, "start": 208292, "end": 218468, "text": "No veía el principal de la cárcel cosa alguna que en su mano estaba; porque Jehová era con él, y lo que él hacía, Jehová lo prosperaba.", "words": [[0, 208292], [3, 208560], [8, 209040], [11, 209260], [21, 209700], [24, 209980], [27, 210100], [34, 210520], [39, 210900], [46, 211380], [50, 211640], [53, 211840], [56, 212000], [61, 212280], [69, 213430], [76, 213768], [83, 214268], [87, 214428], [91, 214688], [95, 214968], [97, 215408], [100, 215788], [104, 215928], [107, 216168], [114, 217048], [121, 217488], [124, 217568]]}]}