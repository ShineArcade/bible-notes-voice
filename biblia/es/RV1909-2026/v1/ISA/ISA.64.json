{"book": "ISA", "chapter": 64, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 123483, "verses": [{"verse": 1, "start": 300, "end": 7237, "text": "¡Oh si rompieses los cielos, y descendieras, y a tu presencia se derritiesen los montes,", "words": [[0, 393], [4, 523], [7, 723], [17, 1603], [21, 1743], [29, 2603], [31, 2803], [45, 4223], [47, 4423], [49, 4523], [52, 4643], [62, 5323], [65, 5583], [77, 6243], [81, 6463]]}, {"verse": 2, "start": 7687, "end": 18937, "text": "Como fuego abrasador de fundiciones, fuego que hace hervir las aguas, para que hicieras notorio tu nombre a tus enemigos, y las naciones temblasen a tu presencia!", "words": [[0, 7687], [5, 7870], [11, 8470], [21, 9070], [24, 9250], [37, 9970], [43, 10610], [47, 10930], [52, 11230], [59, 11750], [63, 12110], [70, 13050], [75, 13350], [79, 13510], [88, 13990], [96, 14510], [99, 14650], [106, 15010], [108, 15210], [112, 15330], [122, 16290], [124, 16550], [128, 16710], [137, 17150], [147, 17930], [149, 18030], [152, 18130]]}, {"verse": 3, "start": 19387, "end": 27221, "text": "Cuando, haciendo cosas terribles cuales nunca esperábamos, descendiste, fluyeron los montes delante de ti.", "words": [[0, 19387], [8, 19573], [17, 19993], [23, 20413], [33, 21093], [40, 21293], [46, 22053], [59, 23693], [72, 24913], [81, 25553], [85, 25713], [92, 26233], [100, 26673], [103, 26833]]}, {"verse": 4, "start": 27671, "end": 36486, "text": "Ni nunca oyeron, ni oídos percibieron, ni ojo ha visto Dios fuera de ti, que hiciese por el que en él espera.", "words": [[0, 27671], [3, 27875], [9, 28395], [17, 28975], [20, 29195], [26, 29635], [39, 30895], [42, 31175], [46, 31515], [49, 31655], [55, 31915], [60, 32255], [66, 32595], [69, 32855], [73, 33595], [77, 33775], [85, 34515], [89, 34835], [92, 35015], [96, 35215], [99, 35415], [102, 35575]]}, {"verse": 5, "start": 36936, "end": 50413, "text": "Saliste al encuentro al que con alegría hacía justicia, a los que se acordaban de ti en tus caminos: he aquí, tú te enojaste porque pecamos; en esos hay perpetuidad, y seremos salvos.", "words": [[0, 36936], [8, 37460], [11, 37640], [21, 38420], [24, 38580], [28, 38740], [32, 38960], [40, 39580], [46, 39980], [56, 40920], [58, 41380], [62, 41500], [66, 41640], [69, 41780], [79, 42400], [82, 42580], [85, 42780], [88, 43020], [92, 43180], [101, 44221], [104, 44347], [110, 45047], [113, 45267], [116, 45427], [125, 45927], [132, 46187], [141, 47307], [144, 47567], [149, 47787], [153, 48067], [166, 48847], [168, 49107], [176, 49507]]}, {"verse": 6, "start": 50863, "end": 63973, "text": "Si bien todos nosotros somos como suciedad, y todas nuestras justicias como trapo de inmundicia; y caímos todos nosotros como la hoja, y nuestras maldades nos llevaron como viento.", "words": [[0, 50863], [3, 51044], [8, 51264], [14, 51564], [23, 52124], [29, 52664], [34, 53084], [44, 54184], [46, 54364], [52, 54664], [61, 55304], [71, 56164], [76, 56484], [82, 56984], [85, 57124], [97, 58413], [99, 58540], [106, 58940], [112, 59200], [121, 59700], [126, 60000], [129, 60180], [135, 60860], [137, 61160], [146, 61360], [155, 62160], [159, 62520], [168, 63000], [173, 63240]]}, {"verse": 7, "start": 64423, "end": 75905, "text": "Y nadie hay que invoque tu nombre, que se despierte para tenerte; por lo cual escondiste de nosotros tu rostro, y nos dejaste marchitar en poder de nuestras maldades.", "words": [[0, 64423], [2, 64547], [8, 64807], [12, 65147], [16, 65327], [24, 65727], [27, 65887], [35, 66567], [39, 66867], [42, 67027], [52, 67687], [57, 67947], [66, 69051], [70, 69196], [73, 69356], [78, 69716], [89, 70736], [92, 70916], [101, 71316], [104, 71596], [112, 72256], [114, 72676], [118, 72996], [126, 73316], [136, 73956], [139, 74156], [145, 74356], [148, 74596], [157, 74796]]}, {"verse": 8, "start": 76355, "end": 87009, "text": "Ahora pues, Jehová, tú eres nuestro padre; nosotros lodo, y tú el que nos formaste; así que obra de tus manos somos todos nosotros.", "words": [[0, 