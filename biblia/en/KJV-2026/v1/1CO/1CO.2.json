{"book": "1CO", "chapter": 2, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 111225, "verses": [{"verse": 1, "start": 300, "end": 7675, "text": "And I, brethren, when I came to you, came not with excellency of speech or of wisdom, declaring to you the testimony of God.", "words": [[0, 300], [4, 469], [7, 729], [17, 1369], [22, 1449], [24, 1629], [29, 1849], [32, 2029], [37, 2249], [42, 2709], [46, 2969], [51, 3209], [62, 3849], [65, 4049], [72, 4369], [75, 4789], [78, 4929], [86, 5509], [96, 5949], [99, 6289], [103, 6469], [107, 6609], [117, 7029], [120, 7289]]}, {"verse": 2, "start": 8125, "end": 13390, "text": "For I determined not to know any thing among you, save Jesus Christ, and him crucified.", "words": [[0, 8125], [4, 8252], [6, 8522], [17, 8792], [21, 9272], [24, 9492], [29, 9665], [33, 9839], [39, 10012], [45, 10332], [50, 10972], [55, 11272], [61, 11612], [69, 11992], [73, 12412], [77, 12592]]}, {"verse": 3, "start": 13840, "end": 17084, "text": "And I was with you in weakness, and in fear, and in much trembling.", "words": [[0, 13840], [4, 13980], [6, 14100], [10, 14280], [15, 14500], [19, 14640], [22, 14760], [32, 15100], [36, 15480], [39, 15560], [45, 15880], [49, 16240], [52, 16340], [57, 16540]]}, {"verse": 4, "start": 17534, "end": 24110, "text": "And my speech and my preaching was not with enticing words of man’s wisdom, but in demonstration of the Spirit and of power:", "words": [[0, 17534], [4, 17636], [7, 17756], [14, 18116], [18, 18556], [21, 18696], [31, 19076], [35, 19336], [39, 19556], [44, 19776], [53, 20236], [59, 20536], [62, 20736], [68, 21076], [76, 21436], [80, 21876], [83, 21976], [97, 22416], [100, 22756], [104, 22876], [111, 23236], [115, 23616], [118, 23716]]}, {"verse": 5, "start": 24560, "end": 28380, "text": "That your faith should not stand in the wisdom of men, but in the power of God.", "words": [[0, 24560], [5, 24690], [10, 24830], [16, 25070], [23, 25310], [27, 25510], [33, 25830], [36, 26010], [40, 26090], [47, 26330], [50, 26550], [55, 27030], [59, 27310], [62, 27470], [66, 27570], [72, 27870], [75, 27990]]}, {"verse": 6, "start": 28830, "end": 35990, "text": "However we speak wisdom among them that are perfect: yet not the wisdom of this world, nor of the princes of this world, that come to nothing:", "words": [[0, 28830], [8, 29270], [11, 29350], [17, 29550], [24, 29870], [30, 30090], [35, 30370], [40, 30570], [44, 30710], [53, 31586], [57, 31723], [61, 31903], [65, 32083], [72, 32363], [75, 32583], [80, 32743], [87, 33083], [91, 33503], [94, 33683], [98, 33783], [106, 34083], [109, 34323], [114, 34503], [121, 34823], [126, 35103], [131, 35383], [134, 35523]]}, {"verse": 7, "start": 36440, "end": 42468, "text": "But we speak the wisdom of God in a mystery, even the hidden wisdom, which God ordained before the world to our glory:", "words": [[0, 36440], [4, 36566], [7, 36686], [13, 36906], [17, 37106], [24, 37366], [27, 37606], [31, 37846], [34, 38066], [36, 38166], [45, 38806], [50, 39006], [54, 39166], [61, 39366], [69, 40006], [75, 40246], [79, 40486], [88, 40966], [95, 41186], [99, 41366], [105, 41646], [108, 41826], [112, 41926]]}, {"verse": 8, "start": 42918, "end": 48755, "text": "Which none of the princes of this world knew: for had they known it, they would not have crucified the Lord of glory.", "words": [[0, 42918], [6, 43045], [11, 43205], [14, 43345], [18, 43445], [26, 43765], [29, 43985], [34, 44145], [40, 44385], [46, 45129], [50, 45271], [54, 45451], [59, 45651], [65, 45911], [69, 46311], [74, 46391], [80, 46551], [84, 46791], [89, 47051], [99, 47571], [103, 47931], [108, 48131], [111, 48271]]}, {"verse": 9, "start": 49205, "end": 58646, "text": "But as it is written, Eye has not seen, nor ear heard, neither have entered into the heart of man, the things which God has prepared for them that love him.", "words": [[0, 49205], [4, 49385], [7, 49745], [10, 49905], [13, 50045], [22, 50455], [26, 50865], [30, 51085], [34, 51345], [40, 51745], [44, 52265], [48, 52605], [55, 53285], [63, 53525], [68, 53845], [76, 54225], [81, 54485], [85, 54645], [91, 54905], [94, 55045], [99, 55766], [103, 55917], [110, 56217], [116, 56477], [120, 56757], [124, 56977], [133, 57317], [137, 57577], [142, 57837], [147, 58017], [152, 58277]]}, {"verse": 10, "start": 59096, "end": 65562, "text": "But God has revealed them to us by his Spirit: for the Spirit searches all things, yes, the deep things of God.", "words": [[0, 59096], [4, 59196], [8, 59456], [12, 59696], [21, 60016], [26, 60236], [29, 60416], [32, 60636], [35, 60876], [39, 61056], [47, 61824], [51, 61933], [55, 62073], [62, 62433], [71, 62833], [75, 63153], [83, 63813], [88, 64293], [92, 64433], [97, 64713], [104, 64933], [107, 65133]]}, {"verse": 11, "start": 66012, "end": 74334, "text": "For what man knows the things of a man, save the spirit of man which is in him? even so the things of God knows no man, but the Spirit of God.", "words": [[0, 66012], [4, 66136], [9, 66376], [13, 66636], [19, 66876], [23, 67076], [30, 67336], [33, 67556], [35, 67636], [40, 68296], [45, 68636], [49, 68856], [56, 69136], [59, 69356], [63, 69596], [69, 69816], [72, 69976], [75, 70216], [80, 70860], [85, 71084], [88, 71404], [92, 71464], [99, 71684], [102, 71864], [106, 72145], [112, 72404], [115, 72645], [120, 72944], [124, 73304], [128, 73464], [135, 73724], [138, 73944]]}, {"verse": 12, "start": 74785, "end": 81962, "text": "Now we have received, not the spirit of the world, but the spirit which is of God; that we might know the things that are freely given to us of God.", "words": [[0, 74785], [4, 75058], [7, 75278], [12, 75458], [22, 76218], [26, 76498], [30, 76718], [37, 76918], [40, 77078], [44, 77198], [51, 77518], [55, 77618], [59, 77738], [66, 78058], [72, 78278], [75, 78398], [78, 78518], [83, 79224], [88, 79321], [91, 79441], [97, 79621], [102, 79821], [106, 79961], [113, 80241], [118, 80421], [122, 80521], [129, 80761], [135, 81081], [138, 81281], [141, 81421], [144, 81541]]}, {"verse": 13, "start": 82412, "end": 91221, "text": "Which things also we speak, not in the words which man’s wisdom teaches, but which the Holy Spirit teaches; comparing spiritual things with spiritual.", "words": [[0, 82412], [6, 82616], [13, 82826], [18, 83226], [21, 83606], [28, 84386], [32, 84646], [35, 84806], [39, 84906], [45, 85106], [51, 85366], [57, 85666], [64, 85946], [73, 86726], [77, 86826], [83, 87006], [87, 87146], [92, 87426], [99, 87826], [108, 88816], [118, 89220], [128, 89760], [135, 90200], [140, 90480]]}, {"verse": 14, "start": 91671, "end": 99907, "text": "But the natural man receives not the things of the Spirit of God: for they are foolishness to him: neither can he know them, because they are spiritually discerned.", "words": [[0, 91671], [4, 91773], [8, 91893], [16, 92193], [20, 92473], [29, 92833], [33, 93093], [37, 93293], [44, 93513], [47, 93693], [51, 93833], [58, 94113], [61, 94293], [66, 95053], [70, 95152], [75, 95292], [79, 95412], [91, 95972], [94, 96152], [99, 96730], [107, 96968], [111, 97268], [114, 97448], [119, 97668], [125, 98048], [133, 98268], [138, 98488], [142, 98608], [154, 99128]]}, {"verse": 15, "start": 100357, "end": 105195, "text": "But he that is spiritual judges all things, yet he himself is judged of no man.", "words": [[0, 100357], [4, 100532], [7, 100832], [12, 101352], [15, 101472], [25, 101872], [32, 102252], [36, 102492], [44, 103092], [48, 103392], [51, 103612], [59, 103972], [62, 104172], [69, 104432], [72, 104632], [75, 104812]]}, {"verse": 16, "start": 105645, "end": 110825, "text": "For who has known the mind of the Lord, that he may instruct him? But we have the mind of Christ.", "words": [[0, 105645], [4, 105748], [8, 105948], [12, 106168], [18, 106348], [22, 106508], [27, 106708], [30, 106848], [34, 106968], [40, 107528], [45, 107668], [48, 107868], [52, 108048], [61, 108408], [66, 109159], [70, 109279], [73, 109419], [78, 109619], [82, 109759], [87, 110039], [90, 110179]]}]}