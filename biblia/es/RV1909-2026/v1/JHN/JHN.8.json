{"book": "JHN", "chapter": 8, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 472856, "verses": [{"verse": 1, "start": 300, "end": 3196, "text": "Y Jesús se fue al monte de los Olivos.", "words": [[0, 300], [2, 466], [8, 826], [11, 1446], [15, 1686], [18, 1866], [24, 2206], [27, 2426], [31, 2566]]}, {"verse": 2, "start": 3546, "end": 10311, "text": "Y por la mañana volvió al templo, y todo el pueblo vino a él: y sentado él, los enseñaba.", "words": [[0, 3546], [2, 3650], [6, 3810], [9, 3970], [16, 4290], [23, 4790], [26, 4930], [34, 5690], [36, 5850], [41, 6110], [44, 6310], [51, 6590], [56, 6990], [58, 7250], [62, 7847], [64, 7951], [72, 8491], [76, 8771], [80, 9231]]}, {"verse": 3, "start": 10661, "end": 18129, "text": "Entonces los escribas y los fariseos le traen una mujer sorprendida en adulterio; y poniéndola en medio,", "words": [[0, 10661], [9, 11105], [13, 11365], [22, 12025], [24, 12165], [28, 12305], [37, 13065], [40, 13545], [46, 13985], [50, 14145], [56, 14405], [68, 15305], [71, 15425], [82, 16485], [84, 16589], [95, 17269], [98, 17469]]}, {"verse": 4, "start": 18479, "end": 23132, "text": "Le dicen: Maestro, esta mujer ha sido sorprendida en el acto de adulterio;", "words": [[0, 18479], [3, 18876], [10, 19506], [19, 19907], [24, 20127], [30, 20427], [33, 20687], [38, 20867], [50, 21667], [53, 21867], [56, 21987], [61, 22307], [64, 22387]]}, {"verse": 5, "start": 23482, "end": 27883, "text": "Y en la ley Moisés nos mandó apedrear a las tales: tú pues, ¿qué dices?", "words": [[0, 23482], [2, 23583], [5, 23663], [8, 23783], [12, 23963], [19, 24383], [23, 24723], [29, 25173], [38, 25623], [40, 25683], [44, 25823], [51, 26644], [54, 26762], [60, 27302], [65, 27382]]}, {"verse": 6, "start": 28163, "end": 36863, "text": "Pero esto decían tentándole, para poder acusarle. Pero Jesús, inclinado hacia abajo, escribía en tierra con el dedo.", "words": [[0, 28163], [5, 28307], [10, 28867], [17, 29427], [29, 29987], [34, 30887], [40, 31227], [50, 32380], [55, 32524], [62, 33204], [72, 33844], [78, 34064], [85, 34664], [94, 35284], [97, 35444], [104, 35784], [108, 36104], [111, 36284]]}, {"verse": 7, "start": 37213, "end": 46997, "text": "Y como perseverasen preguntándole, se enderezó, y les dijo: El que de vosotros esté sin pecado, arroje contra ella la piedra el primero.", "words": [[0, 37213], [2, 37477], [7, 38027], [20, 38577], [35, 39127], [38, 39677], [48, 40497], [50, 40817], [54, 40937], [60, 41751], [63, 41910], [67, 42090], [70, 42230], [79, 42650], [84, 43070], [88, 43490], [96, 43910], [103, 44890], [110, 45270], [115, 45570], [118, 45810], [125, 46270], [128, 46390]]}, {"verse": 8, "start": 47347, "end": 51606, "text": "Y volviéndose a inclinar hacia abajo, escribía en tierra.", "words": [[0, 47347], [2, 47446], [14, 48086], [16, 48406], [25, 48726], [31, 49106], [38, 49566], [47, 50786], [50, 50946]]}, {"verse": 9, "start": 51956, "end": 63741, "text": "Oyendo, pues, ellos, acusados por su conciencia, se salían uno a uno, comenzando desde los más viejos hasta los últimos: y quedó solo Jesús, y la mujer que estaba en medio.", "words": [[0, 51956], [8, 52343], [14, 52583], [21, 53443], [30, 53883], [34, 54123], [37, 54283], [49, 55303], [52, 55383], [59, 55883], [63, 56243], [65, 56523], [70, 56763], [81, 57543], [87, 57903], [91, 58243], [95, 58503], [102, 59043], [108, 59363], [112, 59583], [121, 60585], [123, 60721], [129, 61081], [134, 61301], [141, 61781], [143, 62241], [146, 62341], [152, 62601], [156, 62801], [163, 62981], [166, 63161]]}, {"verse": 10, "start": 64091, "end": 72935, "text": "Y enderezándose Jesús, y no viendo a nadie más que a la mujer, le dijo: ¿Mujer, dónde están los que te acusaban? ¿Ninguno te ha condenado?", "words": [[0, 64091], [2, 64253], [16, 65133], [23, 65533], [25, 65933], [28, 66073], [35, 66333], [37, 66513], [43, 66773], [47, 66993], [51, 67193], [53, 67293], [56, 67333], [63, 68113], [66, 68313], [72, 69099], [80, 69447], [86, 69627], [92, 70027], [96, 70227], [100, 70387], [103, 70487], [113, 71492], [122, 71882], [125, 72062], [128, 72162]]}, {"verse": 11, "start": 73285, "end": 82505, "text": "Y ella dijo: Señor, ninguno. Entonces Jesús le dijo: Ni yo te condeno: vete, y no peques más.", "words": [[0, 73285], [2, 73455], [7, 73625], [13, 74393], [20, 74794], [29, 76899], [38, 77386], [44, 78066], [47, 78506], [53, 79510], [56, 79765], [59, 80019], [62, 80273], [71, 80691], [77, 81139], [79, 81519], [82, 81699], [89, 81979]]}, {"verse": 12, "start": 82855, "end": 93185, "text": "Y les habló Jesús otra vez, diciendo: Yo soy la luz del mundo: el que me sigue, no andará en tinieblas, sino que tendrá la luz de la vida.", "words": [[0, 82855], [2, 82960], [6, 83120], [12, 83480], [18, 83680], [23, 84020], [28, 84320], [38, 85450], [41, 85694], [45, 85994], [48, 86354], [52, 86614], [56, 86934], [63, 87690], [66, 87851], [70, 87991], [73, 88171], [80, 89031], [83, 89251], [90, 89591], [93, 90171], [104, 90751], [109, 90911], [113, 91111], [120, 91571], [123, 91731], [127, 92151], [130, 92551], [133, 92671]]}, {"verse": 13, "start": 93535, "end": 100297, "text": "Entonces los fariseos le dijeron: Tú de ti mismo das testimonio: tu testimonio no es verdadero.", "words": [[0, 93535], [9, 94223], [13, 94803], [22, 95663], [25, 95843], [34, 96603], [37, 96720], [40, 96880], [43, 97040], [49, 97320], [53, 97600], [65, 98684], [68, 98786], [79, 99366], [82, 99506], [85, 99626]]}, {"verse": 14, "start": 100577, "end": 114080, "text": "Respondió Jesús, y les dijo: Aunque yo doy testimonio de mí mismo, mi testimonio es verdadero, porque sé de dónde he venido y a dónde voy; pero vosotros no sabéis de dónde vengo, y a dónde voy.", "words": [[0, 100867], [10, 101157], [17, 101497], [19, 101837], [23, 101977], [29, 102717], [36, 103097], [39, 103377], [43, 103617], [54, 104317], [57, 104437], [60, 104597], [67, 105477], [70, 105717], [81, 106397], [84, 106477], [95, 107137], [102, 107637], [105, 107917], [108, 108097], [114, 108317], [117, 108657], [124, 109217], [126, 109537], [128, 109617], [134, 109857], [139, 110620], [144, 110784], [153, 111244], [156, 111404], [163, 111864], [166, 112064], [172, 112244], [179, 112804], [181, 113284], [183, 113424], [189, 113604]]}, {"verse": 15, "start": 114430, "end": 118817, "text": "Vosotros según la carne juzgáis; pero yo no juzgo a nadie.", "words": [[0, 114430], [9, 115316], [15, 115536], [18, 115776], [24, 116116], [33, 117273], [38, 117440], [41, 117620], [44, 117740], [50, 118160], [52, 118280]]}, {"verse": 16, "start": 119167, "end": 127243, "text": "Y si yo juzgo, mi juicio es verdadero; porque no soy solo, sino yo y el que me envió, el Padre.", "words": [[0, 119167], [2, 119315], [5, 119415], [8, 119575], [15, 120495], [18, 120615], [25, 121035], [28, 121495], [39, 122713], [46, 122938], [49, 123158], [53, 123378], [59, 124258], [64, 124578], [67, 125258], [69, 125503], [72, 125663], [76, 125823], [79, 125983], [86, 126403], [89, 126643]]}, {"verse": 17, "start": 127593, "end": 132820, "text": "Y en vuestra ley está escrito que el testimonio de dos hombres es verdadero.", "words": [[0, 127593], [2, 127736], [5, 127856], [13, 128276], [17, 128676], [22, 129196], [30, 129536], [34, 129796], [37, 129916], [48, 130636], [51, 130756], [55, 130956], [63, 131356], [66, 131816]]}, {"verse": 18, "start": 133170, "end": 139535, "text": "Yo soy el que doy testimonio de mí mismo: y da testimonio de mí el que me envió, el Padre.", "words": [[0, 133170], [3, 133355], [7, 133635], [10, 133835], [14, 133975], [18, 134255], [29, 134935], [32, 135035], [35, 135175], [42, 136011], [44, 136127], [47, 136247], [58, 136987], [61, 137087], [64, 137307], [67, 137607], [71, 137767], [74, 137927], [81, 138747], [84, 138887]]}, {"verse": 19, "start": 139885, "end": 151267, "text": "Y le decían: ¿Dónde está tu Padre? Respondió Jesús: Ni a mí me conocéis, ni a mi Padre; si a mí me conocieseis, a mi Padre también conocierais.", "words": [[0, 139885], [2, 140014], [5, 140114], [13, 141079], [20, 141346], [25, 141586], [28, 141706], [35, 142620], [45, 143060], [52, 144109], [55, 144309], [57, 144409], [60, 144549], [63, 144689], [73, 145329], [76, 145969], [78, 146029], [81, 146109], [88, 147006], [91, 147165], [93, 147285], [96, 147525], [99, 148235], [112, 148945], [114, 149025], [117, 149185], [123, 149525], [131, 150420]]}, {"verse": 20, "start": 151617, "end": 161429, "text": "Estas palabras habló Jesús en el lugar de las limosnas, enseñando en el templo: y nadie le prendió; porque aún no había venido su hora.", "words": [[0, 151617], [6, 151957], [15, 152317], [21, 152897], [27, 153297], [30, 153777], [33, 153897], [39, 154257], [42, 154457], [46, 155077], [56, 155697], [66, 156497], [69, 156617], [72, 156737], [80, 157583], [82, 157727], [88, 158047], [91, 158287], [100, 159165], [107, 159389], [111, 159669], [114, 159969], [120, 160229], [127, 160669], [130, 160869]]}, {"verse": 21, "start": 161779, "end": 172398, "text": "Y les dijo otra vez Jesús: Yo me voy, y me buscaréis, pero en vuestro pecado moriréis: a donde yo voy, vosotros no podéis venir.", "words": [[0, 161779], [2, 162079], [6, 162219], [11, 162559], [16, 162859], [20, 163139], [27, 164004], [30, 164230], [33, 164390], [38, 164670], [40, 164990], [43, 165130], [54, 166230], [59, 166570], [62, 166750], [70, 167130], [77, 167650], [87, 169066], [89, 169235], [95, 169415], [98, 169695], [103, 170595], [112, 171075], [115, 171295], [122, 171735]]}, {"verse": 22, "start": 172748, "end": 179986, "text": "Decían entonces los judíos: ¿Se va a matar a sí mismo, que dice: A donde yo voy, vosotros no podéis venir?", "words": [[0, 172748], [7, 173354], [16, 174134], [20, 174674], [28, 175668], [32, 175803], [35, 175983], [37, 176063], [43, 176303], [45, 176463], [48, 176603], [55, 176923], [59, 177123], [65, 177826], [67, 177929], [73, 178089], [76, 178329], [81, 178549], [90, 179049], [93, 179229], [100, 179529]]}, {"verse": 23, "start": 180266, "end": 189028, "text": "Y les decía: Vosotros sois de abajo, yo soy de arriba; vosotros sois de este mundo, yo no soy de este mundo.", "words": [[0, 180266], [2, 180549], [6, 180869], [13, 181364], [22, 181986], [27, 182626], [30, 182766], [37, 183666], [40, 183786], [44, 184046], [47, 184226], [55, 185114], [64, 185660], [69, 186180], [72, 186360], [77, 186540], [84, 187280], [87, 187640], [90, 187740], [94, 188020], [97, 188220], [102, 188380]]}, {"verse": 24, "start": 189378, "end": 197947, "text": "Por eso os dije que moriréis en vuestros pecados; porque si no creéis que yo soy, en vuestros pecados moriréis.", "words": [[0, 189378], [4, 189578], [8, 189818], [11, 190098], [16, 190418], [20, 190658], [29, 191458], [32, 191678], [41, 192138], [50, 193028], [57, 193252], [60, 193452], [63, 193672], [70, 194212], [74, 194372], [77, 194592], [82, 195032], [85, 195552], [94, 195992], [102, 197032]]}, {"verse": 25, "start": 198297, "end": 207126, "text": "Y le decían: ¿Tú quién eres? Entonces Jesús les dijo: Quien os he dicho desde el principio.", "words": [[0, 198297], [2, 198426], [5, 198526], [13, 199491], [17, 199631], [23, 199871], [29, 201777], [38, 202243], [44, 202963], [48, 203483], [54, 204231], [60, 204621], [63, 204941], [66, 205181], [72, 205501], [78, 205981], [81, 206301]]}, {"verse": 26, "start": 207476, "end": 217543, "text": "Muchas cosas tengo que decir y juzgar de vosotros: pero el que me envió, es verdadero: y yo, lo que he oído de él, esto hablo en el mundo.", "words": [[0, 207476], [7, 207703], [13, 208083], [19, 208403], [23, 208623], [29, 209003], [31, 209303], [38, 209803], [41, 209983], [51, 210945], [56, 211109], [59, 211249], [63, 211389], [66, 211549], [73, 211989], [76, 212589], [87, 213692], [89, 213838], [93, 214058], [96, 214238], [100, 214438], [103, 214738], [108, 215178], [111, 215438], [115, 215818], [120, 216118], [126, 216638], [129, 216778], [132, 216918]]}, {"verse": 27, "start": 217893, "end": 220906, "text": "Pero no entendieron que él les hablaba del Padre.", "words": [[0, 217893], [5, 218037], [8, 218197], [20, 218877], [24, 219137], [27, 219377], [31, 219557], [39, 220037], [43, 220197]]}, {"verse": 28, "start": 221256, "end": 233525, "text": "Les dijo pues, Jesús: Cuando levantéis al Hijo del hombre, entonces entenderéis que yo soy, y que nada hago de mí mismo; pero como el Padre me enseñó, esto hablo.", "words": [[0, 221256], [4, 221550], [9, 221830], [15, 222170], [22, 223194], [29, 223398], [39, 224158], [42, 224378], [47, 224618], [51, 224838], [59, 225618], [68, 225818], [80, 226838], [84, 227018], [87, 227218], [92, 227598], [94, 228038], [98, 228198], [103, 228498], [108, 229038], [111, 229218], [114, 229398], [121, 230253], [126, 230399], [131, 230659], [134, 230819], [140, 231179], [143, 231419], [151, 232619], [156, 232859]]}, {"verse": 29, "start": 233875, "end": 241899, "text": "Porque el que me envió, conmigo está; no me ha dejado solo el Padre; porque yo, lo que a él agrada, hago siempre.", "words": [[0, 233875], [7, 234077], [10, 234237], [14, 234377], [17, 234497], [24, 234877], [32, 235637], [38, 236845], [41, 236995], [44, 237135], [47, 237215], [54, 237655], [59, 237935], [62, 238135], [69, 239001], [76, 239136], [80, 239476], [83, 239836], [87, 240016], [89, 240136], [92, 240276], [100, 240736], [105, 241116]]}, {"verse": 30, "start": 242249, "end": 245858, "text": "Hablando él estas cosas, muchos creyeron en él.", "words": [[0, 242249], [9, 242516], [12, 242826], [18, 243046], [25, 243946], [32, 244506], [41, 245066], [44, 245426]]}, {"verse": 31, "start": 246208, "end": 255267, "text": "Y decía Jesús a los judíos que le habían creído: Si vosotros permanecéis en mi palabra, seréis verdaderamente mis discípulos;", "words": [[0, 246208], [2, 246315], [8, 246755], [14, 246995], [16, 247235], [20, 247355], [27, 247835], [31, 247955], [34, 248075], [41, 248355], [49, 249242], [52, 249425], [61, 250025], [73, 251105], [76, 251225], [79, 251365], [88, 252385], [95, 253065], [110, 254125], [114, 254345]]}, {"verse": 32, "start": 255617, "end": 259006, "text": "Y conoceréis la verdad, y la verdad os libertará.", "words": [[0, 255617], [2, 255704], [13, 256404], [16, 256584], [24, 256944], [26, 257299], [29, 257419], [36, 257759], [39, 258099]]}, {"verse": 33, "start": 259356, "end": 266793, "text": "Y le respondieron: Linaje de Abraham somos, y jamás fuimos esclavos de nadie: ¿cómo dices tú: Seréis libres?", "words": [[0, 259356], [2, 259506], [5, 259626], [19, 260756], [26, 261193], [29, 261393], [37, 261733], [44, 262153], [46, 262673], [52, 263053], [59, 263433], [68, 264053], [71, 264173], [78, 264892], [84, 265049], [90, 265349], [94, 265946], [101, 266273]]}, {"verse": 34, "start": 267073, "end": 275080, "text": "Jesús les respondió: De cierto, de cierto os digo, que todo aquel que hace pecado, es esclavo del pecado.", "words": [[0, 267073], [6, 267435], [10, 267832], [21, 268897], [24, 269373], [32, 269850], [35, 270327], [42, 270803], [45, 271280], [51, 271460], [55, 271680], [60, 271920], [66, 272300], [70, 272400], [75, 272600], [83, 273140], [86, 273680], [94, 274163], [98, 274645]]}, {"verse": 35, "start": 275430, "end": 279944, "text": "Y el esclavo no queda en casa para siempre: el hijo queda para siempre.", "words": [[0, 275430], [2, 275574], [5, 275874], [13, 276174], [16, 276374], [22, 276614], [25, 276794], [30, 277114], [35, 277394], [44, 278318], [47, 278568], [52, 278768], [58, 279048], [63, 279288]]}, {"verse": 36, "start": 280294, "end": 284639, "text": "Así que, si el Hijo os libera, seréis verdaderamente libres.", "words": [[0, 280294], [4, 280610], [9, 280810], [12, 281010], [15, 281230], [20, 281360], [23, 281490], [31, 282190], [38, 282810], [53, 283850]]}, {"verse": 37, "start": 284989, "end": 291720, "text": "Sé que sois descendientes de Abraham, pero procuráis matarme, porque mi palabra no cabe en vosotros.", "words": [[0, 284989], [3, 285151], [7, 285271], [12, 285651], [26, 286651], [29, 286811], [38, 287831], [43, 287971], [53, 288551], [62, 289231], [69, 289651], [72, 289871], [80, 290211], [83, 290491], [88, 290791], [91, 290991]]}, {"verse": 38, "start": 292070, "end": 298921, "text": "Yo hablo lo que he visto cerca del Padre; y vosotros hacéis lo que habéis oído cerca de vuestro padre.", "words": [[0, 292070], [3, 292296], [9, 292676], [12, 292836], [16, 293036], [19, 293136], [25, 293376], [31, 293716], [35, 294036], [42, 294927], [44, 295055], [53, 295495], [60, 296155], [63, 296475], [67, 296615], [74, 296915], [79, 297275], [85, 297615], [88, 297975], [96, 298295]]}, {"verse": 39, "start": 299271, "end": 308734, "text": "Respondieron y le dijeron: Nuestro padre es Abraham. Les dice Jesús: Si fuerais hijos de Abraham, las obras de Abraham haríais.", "words": [[0, 299271], [13, 299955], [15, 300255], [18, 300375], [27, 301165], [35, 301505], [41, 301945], [44, 302125], [53, 303047], [57, 303196], [62, 303496], [69, 304500], [72, 304842], [80, 305222], [86, 305542], [89, 305782], [98, 306567], [102, 306667], [108, 307007], [111, 307227], [119, 307647]]}, {"verse": 40, "start": 309084, "end": 317975, "text": "Pero ahora procuráis matarme, hombre que os he hablado la verdad, la cual he oído de Dios: no hizo esto Abraham.", "words": [[0, 309084], [5, 309229], [11, 309569], [21, 310249], [30, 311489], [37, 311829], [41, 312069], [44, 312289], [47, 312429], [55, 312929], [58, 313089], [66, 313889], [69, 314149], [74, 314389], [77, 314709], [82, 315089], [85, 315309], [91, 316159], [94, 316489], [99, 316869], [104, 317409]]}, {"verse": 41, "start": 318325, "end": 328236, "text": "Vosotros hacéis las obras de vuestro padre. Le dijeron entonces: Nosotros no somos nacidos de fornicación; un padre tenemos, que es Dios.", "words": [[0, 318325], [9, 318930], [16, 319850], [20, 320070], [26, 320450], [29, 320710], [37, 321090], [44, 321907], [47, 322033], [55, 322513], [65, 323651], [74, 324115], [77, 324315], [83, 324635], [91, 325175], [94, 325355], [107, 326413], [110, 326556], [116, 326856], [125, 327216], [129, 327596], [132, 327736]]}, {"verse": 42, "start": 328516, "end": 341250, "text": "Jesús entonces les dijo: Si vuestro padre fuera Dios, ciertamente me amaríais: porque yo de Dios he salido, y he venido; que no he venido de mí mismo, sino que él me envió.", "words": [[0, 328516], [6, 328840], [15, 329580], [19, 330160], [25, 330929], [28, 331087], [36, 331487], [42, 331907], [48, 332107], [54, 332907], [66, 333607], [69, 333867], [79, 335116], [86, 335299], [89, 335539], [92, 335679], [97, 335919], [100, 336119], [108, 336884], [110, 337044], [113, 337164], [121, 337978], [125, 338079], [128, 338259], [131, 338379], [138, 338779], [141, 338939], [144, 339119], [151, 339659], [156, 339859], [160, 340099], [163, 340399], [166, 340579]]}, {"verse": 43, "start": 341600, "end": 345686, "text": "¿Por qué no reconocéis mi lenguaje? porque no podéis oír mi palabra.", "words": [[0, 341600], [5, 341722], [9, 341882], [12, 342022], [23, 342702], [26, 342842], [36, 343854], [43, 343984], [46, 344124], [53, 344484], [57, 344824], [60, 344944]]}, {"verse": 44, "start": 346036, "end": 364793, "text": "Vosotros de vuestro padre el diablo sois, y los deseos de vuestro padre queréis cumplir. El, homicida ha sido desde el principio, y no permaneció en la verdad, porque no hay verdad en él. Cuando habla mentira, de lo suyo habla; porque es mentiroso, y padre de mentira.", "words": [[0, 346036], [9, 346535], [12, 346755], [20, 347135], [26, 347675], [29, 347915], [36, 348315], [42, 348995], [44, 349615], [48, 349795], [55, 350395], [58, 350515], [66, 350895], [72, 351355], [80, 351715], [89, 352795], [93, 352919], [102, 353439], [105, 353579], [110, 353799], [116, 354079], [119, 354319], [130, 355079], [132, 355434], [135, 355574], [146, 356294], [149, 356434], [152, 356574], [160, 356914], [167, 357514], [170, 357774], [174, 357914], [181, 358234], [184, 358494], [188, 359123], [195, 359305], [201, 359625], [210, 360205], [213, 360345], [216, 360485], [221, 360845], [228, 361574], [235, 361798], [238, 361978], [249, 362978], [251, 363398], [257, 363778], [260, 363998]]}, {"verse": 45, "start": 365143, "end": 368129, "text": "Y porque yo digo verdad, no me creéis.", "words": [[0, 365143], [2, 365268], [9, 365588], [12, 365848], [17, 366068], [25, 366868], [28, 367108], [31, 367268]]}, {"verse": 46, "start": 368479, "end": 374267, "text": "¿Quién de vosotros demuestra que he pecado? Pues si digo verdad, ¿por qué vosotros no me creéis?", "words": [[0, 368479], [7, 368703], [10, 368823], [19, 369263], [29, 369883], [33, 370003], [36, 370123], [44, 371023], [49, 371148], [52, 371328], [57, 371548], [65, 372348], [70, 372608], [74, 372748], [83, 373208], [86, 373388], [89, 373468]]}, {"verse": 47, "start": 374617, "end": 382281, "text": "El que es de Dios, las palabras de Dios oye: por esto no las oís vosotros, porque no sois de Dios.", "words": [[0, 374617], [3, 374764], [7, 374924], [10, 375124], [13, 375224], [19, 376084], [23, 376184], [32, 376664], [35, 376924], [40, 377184], [45, 377944], [49, 378071], [54, 378291], [57, 378591], [61, 378871], [65, 379391], [75, 380351], [82, 380951], [85, 381191], [90, 381671], [93, 381911]]}, {"verse": 48, "start": 382631, "end": 389970, "text": "Respondieron entonces los judíos, y le dijeron: ¿No decimos bien nosotros, que tú eres samaritano, y tienes demonio?", "words": [[0, 382631], [13, 383339], [22, 383859], [26, 384179], [34, 384719], [36, 384859], [39, 384959], [48, 385926], [52, 386106], [60, 386606], [65, 386786], [75, 387286], [79, 387686], [82, 387906], [87, 388126], [99, 388866], [101, 389106], [108, 389366]]}, {"verse": 49, "start": 390250, "end": 397339, "text": "Respondió Jesús: Yo no tengo demonio, antes honro a mi Padre; y vosotros me habéis deshonrado.", "words": [[0, 390354], [10, 390794], [17, 391675], [20, 391843], [23, 391983], [29, 392283], [38, 393023], [44, 393443], [50, 394143], [52, 394283], [55, 394363], [62, 395199], [64, 395432], [73, 395912], [76, 396132], [83, 396412]]}, {"verse": 50, "start": 397689, "end": 401297, "text": "Y no busco mi gloria: hay quien la busque, y juzgue.", "words": [[0, 397689], [2, 397794], [5, 397894], [11, 398234], [14, 398374], [22, 399209], [26, 399376], [32, 399636], [35, 399796], [43, 400216], [45, 400676]]}, {"verse": 51, "start": 401647, "end": 408027, "text": "De cierto, de cierto os digo, que el que guarda mi palabra, no verá muerte para siempre.", "words": [[0, 401873], [3, 402133], [11, 402393], [14, 402653], [21, 402913], [24, 403133], [30, 403953], [34, 404233], [37, 404413], [41, 404593], [48, 405073], [51, 405193], [60, 405973], [63, 406253], [68, 406533], [75, 406973], [80, 407253]]}, {"verse": 52, "start": 408377, "end": 419423, "text": "Entonces los judíos le dijeron: Ahora conocemos que tienes demonio. Abraham murió, y los profetas, y tú dices: El que guarda mi palabra, no gustará muerte para siempre.", "words": [[0, 408377], [9, 409344], [13, 409484], [20, 409924], [23, 410064], [32, 410978], [38, 411260], [48, 411820], [52, 412000], [59, 412260], [68, 413144], [76, 413547], [83, 414047], [85, 414147], [89, 414287], [99, 415227], [101, 415347], [104, 415507], [111, 416309], [114, 416433], [118, 416533], [125, 416893], [128, 416973], [137, 417393], [140, 417793], [148, 418213], [155, 418573], [160, 418813]]}, {"verse": 53, "start": 419773, "end": 425747, "text": "¿Eres tú mayor que nuestro padre Abraham, el cual murió? y los profetas murieron: ¿quién te haces a ti mismo?", "words": [[0, 419773], [6, 419970], [9, 420130], [15, 420430], [19, 420630], [27, 420810], [33, 421230], [42, 421870], [45, 421950], [50, 422110], [57, 422903], [59, 422982], [63, 423082], [72, 423562], [82, 424441], [89, 424669], [92, 424769], [98, 425049], [100, 425189], [103, 425249]]}, {"verse": 54, "start": 426027, "end": 435356, "text": "Respondió Jesús: Si yo me glorifico a mí mismo, mi gloria es nada: mi Padre es el que me glorifica; el que vosotros decís que es vuestro Dios;", "words": [[0, 426131], [10, 426571], [17, 427452], [20, 427596], [23, 427796], [26, 427916], [36, 428576], [38, 428636], [41, 428756], [48, 429236], [51, 429356], [58, 429736], [61, 429876], [67, 430550], [70, 430678], [76, 430998], [79, 431278], [82, 431398], [86, 431518], [89, 431678], [100, 432751], [103, 432991], [107, 433111], [116, 433651], [122, 434191], [126, 434311], [129, 434431], [137, 434811]]}, {"verse": 55, "start": 435706, "end": 444511, "text": "Y no le conocéis: pero yo le conozco; y si digo que no le conozco, seré como vosotros mentiroso: pero le conozco, y guardo su palabra.", "words": [[0, 435706], [2, 435806], [5, 435966], [8, 436106], [18, 437319], [23, 437439], [26, 437589], [29, 437739], [38, 438701], [40, 438951], [43, 439091], [48, 439351], [52, 439511], [55, 439671], [58, 439791], [67, 440311], [72, 440611], [77, 440811], [86, 441331], [97, 442493], [102, 442639], [105, 442779], [114, 443259], [116, 443359], [123, 443699], [126, 443859]]}, {"verse": 56, "start": 444861, "end": 449797, "text": "Abraham vuestro padre se gozó por ver mi día; y lo vio, y se gozó.", "words": [[0, 445144], [8, 445464], [16, 445844], [22, 446144], [25, 446444], [30, 446864], [34, 447044], [38, 447264], [41, 447444], [46, 448219], [48, 448360], [51, 448480], [56, 448780], [58, 448985], [61, 449225]]}, {"verse": 57, "start": 450147, "end": 456056, "text": "Le dijeron entonces los judíos: Aún no tienes cincuenta años, ¿y has visto a Abraham?", "words": [[0, 450147], [3, 450275], [11, 450815], [20, 451295], [24, 451655], [32, 452741], [36, 452984], [39, 453271], [46, 453557], [56, 453844], [62, 454364], [65, 454864], [69, 455024], [75, 455164], [77, 455304]]}, {"verse": 58, "start": 456336, "end": 463128, "text": "Les dijo Jesús: De cierto, de cierto os digo: Antes que Abraham fuese, yo soy.", "words": [[0, 456391], [4, 456481], [9, 456761], [16, 458093], [19, 458465], [27, 458837], [30, 459209], [37, 459581], [40, 459801], [46, 460510], [52, 460897], [56, 461197], [64, 461577], [71, 462437], [74, 462677]]}, {"verse": 59, "start": 463478, "end": 472456, "text": "Tomaron entonces piedras para tirarle: pero Jesús se ocultó, y salió del templo; y atravesando por medio de ellos, se fue.", "words": [[0, 463478], [8, 463852], [17, 464252], [25, 464852], [30, 465032], [39, 466002], [44, 466126], [50, 466466], [53, 466866], [61, 467446], [63, 467806], [69, 468166], [73, 468326], [81, 469211], [83, 469338], [95, 470078], [99, 470338], [105, 470698], [108, 470958], [115, 471738], [118, 472058]]}]}