{"book": "JHN", "chapter": 3, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 279429, "verses": [{"verse": 1, "start": 300, "end": 6609, "text": "Y había un hombre de los fariseos que se llamaba Nicodemo, dirigente de los judíos.", "words": [[0, 300], [2, 427], [8, 627], [11, 947], [18, 1247], [21, 1467], [25, 1627], [34, 2307], [38, 2447], [41, 2587], [49, 3087], [59, 4667], [69, 5427], [72, 5607], [76, 5747]]}, {"verse": 2, "start": 7059, "end": 17078, "text": "Este vino a Jesús de noche, y le dijo: Rabí, sabemos que has venido de Dios por maestro; porque nadie puede hacer estas señales que tú haces, si no está Dios con él.", "words": [[0, 7059], [5, 7284], [10, 7544], [12, 7724], [18, 7944], [21, 8184], [28, 8524], [30, 8904], [33, 9024], [39, 9978], [45, 10198], [53, 10478], [57, 10718], [61, 10838], [68, 11178], [71, 11318], [76, 11518], [80, 11778], [89, 12779], [96, 12960], [102, 13220], [108, 13520], [114, 13840], [120, 14100], [128, 14620], [132, 14800], [135, 15000], [142, 15460], [145, 15940], [148, 16040], [153, 16260], [158, 16460], [162, 16780]]}, {"verse": 3, "start": 17428, "end": 26131, "text": "Respondió Jesús, y le dijo: De cierto, de cierto te digo, que el que no nazca otra vez, no puede ver el reino de Dios.", "words": [[0, 17428], [10, 17988], [17, 18308], [19, 18528], [22, 18668], [28, 19707], [31, 20011], [39, 20315], [42, 20619], [49, 20923], [52, 21103], [58, 21443], [62, 22163], [65, 22283], [69, 22423], [72, 22623], [78, 23023], [83, 23263], [88, 23903], [91, 24303], [97, 24563], [101, 24843], [104, 24983], [110, 25363], [113, 25523]]}, {"verse": 4, "start": 26581, "end": 33400, "text": "Le dice Nicodemo: ¿Cómo puede el hombre nacer siendo viejo? ¿puede entrar otra vez en el vientre de su madre, y nacer?", "words": [[0, 26581], [3, 26802], [8, 27062], [18, 28174], [24, 28334], [30, 28614], [33, 28774], [40, 28934], [46, 29314], [53, 29574], [60, 30400], [67, 30582], [74, 30922], [79, 31122], [83, 31382], [86, 31522], [89, 31622], [97, 31962], [100, 32062], [103, 32202], [110, 32522], [112, 32922]]}, {"verse": 5, "start": 33750, "end": 42915, "text": "Respondió Jesús: De cierto, de cierto te digo, que el que no nazca de agua y del Espíritu, no puede entrar en el reino de Dios.", "words": [[0, 33904], [10, 34324], [17, 35306], [20, 35306], [28, 35306], [31, 35531], [38, 36651], [41, 36971], [47, 37891], [51, 38171], [54, 38351], [58, 38511], [61, 38731], [67, 39171], [70, 39371], [75, 39691], [77, 39851], [81, 39971], [91, 40531], [94, 40651], [100, 40931], [107, 41331], [110, 41571], [113, 41711], [119, 42111], [122, 42291]]}, {"verse": 6, "start": 43365, "end": 50123, "text": "Lo que es nacido de la carne, carne es; y lo que es nacido del Espíritu, espíritu es.", "words": [[0, 43365], [3, 43511], [7, 43671], [10, 43931], [17, 44931], [20, 45111], [23, 45251], [30, 45540], [36, 45828], [40, 47195], [42, 47595], [45, 47715], [49, 47835], [52, 47935], [59, 48455], [63, 48655], [73, 49295], [82, 49815]]}, {"verse": 7, "start": 50573, "end": 56060, "text": "No te maravilles de que te dije: Os es necesario nacer otra vez.", "words": [[0, 50573], [3, 50858], [6, 51058], [17, 51638], [20, 51818], [24, 51878], [27, 52038], [33, 52935], [36, 53315], [39, 53655], [49, 54555], [55, 55135], [60, 55495]]}, {"verse": 8, "start": 56510, "end": 67118, "text": "El viento de donde quiere sopla, y oyes su sonido; pero ni sabes de dónde viene, ni a dónde vaya: así es todo aquel que es nacido del Espíritu.", "words": [[0, 56510], [3, 56692], [10, 57072], [13, 57292], [19, 57492], [26, 57892], [33, 58512], [35, 58922], [40, 59332], [43, 59512], [51, 60535], [56, 60794], [59, 60954], [65, 61274], [68, 61514], [74, 61694], [81, 62085], [84, 62476], [86, 62866], [92, 63257], [98, 63904], [102, 64215], [105, 64415], [110, 64695], [116, 65155], [120, 65275], [123, 65475], [130, 66115], [134, 66295]]}, {"verse": 9, "start": 67568, "end": 71681, "text": "Respondió Nicodemo, y le dijo: ¿Cómo puede esto hacerse?", "words": [[0, 67568], [10, 68255], [20, 68975], [22, 69155], [25, 69255], [31, 70106], [37, 70303], [43, 70683], [48, 70963]]}, {"verse": 10, "start": 72031, "end": 77814, "text": "Respondió Jesús, y le dijo: ¿Tú eres el maestro de Israel, y no sabes esto?", "words": [[0, 72031], [10, 72591], [17, 72911], [19, 73131], [22, 73271], [28, 74039], [32, 74184], [37, 74484], [40, 74704], [48, 75264], [51, 75464], [59, 76004], [61, 76764], [64, 76884], [70, 77164]]}, {"verse": 11, "start": 78264, "end": 87074, "text": "De cierto, de cierto te digo, que lo que sabemos hablamos, y lo que hemos visto, testificamos; y no recibís nuestro testimonio.", "words": [[0, 78488], [3, 78748], [11, 79008], [14, 79268], [21, 79528], [24, 79708], [30, 80028], [34, 80208], [37, 80348], [41, 80468], [49, 80948], [59, 81788], [61, 82028], [64, 82168], [68, 82328], [74, 82548], [81, 83048], [95, 84940], [97, 85082], [100, 85242], [108, 85842], [116, 86102]]}, {"verse": 12, "start": 87524, "end": 94574, "text": "Si os he hablado de cosas terrenales y no creéis, ¿cómo creeréis si os digo las celestiales?", "words": [[0, 87524], [3, 87657], [6, 87823], [9, 87990], [17, 88630], [20, 88770], [26, 89070], [37, 90050], [39, 90310], [42, 90450], [50, 91390], [56, 91710], [65, 92710], [68, 92850], [71, 92990], [76, 93330], [80, 93470]]}, {"verse": 13, "start": 95024, "end": 102173, "text": "Y nadie subió al cielo, sino el que descendió del cielo, el Hijo del hombre, que está en el cielo.", "words": [[0, 95024], [2, 95024], [8, 95446], [14, 96006], [17, 96166], [24, 96606], [29, 97226], [32, 97486], [36, 97626], [46, 98486], [50, 98626], [57, 99186], [60, 99666], [65, 99906], [69, 100126], [77, 100466], [81, 100886], [86, 101126], [89, 101366], [92, 101506]]}, {"verse": 14, "start": 102623, "end": 110957, "text": "Y como Moisés levantó la serpiente en el desierto, así es necesario que el Hijo del hombre sea levantado;", "words": [[0, 102623], [2, 102765], [7, 103065], [14, 103625], [22, 104405], [25, 104525], [35, 105205], [38, 105365], [41, 105485], [51, 106585], [55, 106925], [58, 107185], [68, 107965], [72, 108665], [75, 108865], [80, 109105], [84, 109285], [91, 109605], [95, 110025]]}, {"verse": 15, "start": 111407, "end": 116885, "text": "Para que todo aquel que en él crea, no se pierda, sino que tenga vida eterna.", "words": [[0, 111407], [5, 111571], [9, 111731], [14, 112091], [20, 112691], [24, 112844], [27, 112998], [30, 113151], [36, 113571], [39, 113751], [42, 113911], [50, 114851], [55, 115051], [59, 115251], [65, 115591], [70, 115931]]}, {"verse": 16, "start": 117335, "end": 128928, "text": "Porque de tal manera amó Dios al mundo, que ha dado a su Hijo unigénito, para que todo aquel que en él cree, no se pierda, sino que tenga vida eterna.", "words": [[0, 117335], [7, 117557], [10, 117757], [14, 118017], [21, 118584], [25, 119150], [30, 119717], [33, 119857], [40, 120297], [44, 120737], [47, 120877], [52, 121117], [54, 121257], [57, 121437], [62, 122017], [73, 122597], [78, 123317], [82, 123477], [87, 123737], [93, 124237], [97, 124337], [100, 124517], [103, 124617], [109, 125057], [112, 125677], [115, 125857], [123, 126846], [128, 127126], [132, 127346], [138, 127646], [143, 128006]]}, {"verse": 17, "start": 129378, "end": 135918, "text": "Porque no envió Dios a su Hijo al mundo para que condene al mundo, sino para que el mundo sea salvo por él.", "words": [[0, 129378], [7, 129600], [10, 129880], [16, 130240], [21, 130460], [23, 130640], [26, 130800], [31, 131020], [34, 131200], [40, 131460], [45, 131740], [49, 131900], [57, 132460], [60, 132560], [67, 132980], [72, 133160], [77, 133440], [81, 133620], [84, 133780], [90, 134140], [94, 134580], [100, 135300], [104, 135560]]}, {"verse": 18, "start": 136368, "end": 146567, "text": "El que en él cree, no es condenado; pero el que no cree, ya es condenado, porque no creyó en el nombre del unigénito Hijo de Dios.", "words": [[0, 136368], [3, 136554], [7, 136794], [10, 137054], [13, 137174], [19, 137654], [22, 138234], [25, 138434], [36, 139603], [41, 139735], [44, 139905], [48, 140045], [51, 140225], [57, 140885], [60, 141425], [63, 141965], [74, 142505], [81, 142845], [84, 143085], [90, 143525], [93, 143665], [96, 143805], [103, 144245], [107, 144525], [117, 145445], [122, 145825], [125, 146025]]}, {"verse": 19, "start": 147017, "end": 157749, "text": "Y esta es la condenación: porque la luz vino al mundo, y los hombres amaron más las tinieblas que la luz; porque sus obras eran malas.", "words": [[0, 147017], [2, 147174], [7, 147414], [10, 147534], [13, 147674], [26, 148952], [33, 149196], [36, 149396], [40, 149676], [45, 150136], [48, 150416], [55, 150836], [57, 151456], [61, 151656], [69, 152036], [76, 152956], [80, 153296], [84, 153846], [94, 154396], [98, 154596], [101, 154736], [106, 155550], [113, 155752], [117, 155992], [123, 156452], [128, 156892]]}, {"verse": 20, "start": 158199, "end": 167052, "text": "Porque todo aquel que hace lo malo, aborrece la luz y no viene a la luz, para que sus obras no sean puestas en evidencia.", "words": [[0, 158199], [7, 158423], [12, 158763], [18, 159303], [22, 159423], [27, 159703], [30, 159903], [36, 160603], [45, 161243], [48, 161443], [52, 161703], [54, 161983], [57, 162183], [63, 162543], [65, 162743], [68, 162843], [73, 163603], [78, 163883], [82, 164023], [86, 164203], [92, 164583], [95, 165083], [100, 165343], [108, 165943], [111, 166103]]}, {"verse": 21, "start": 167502, "end": 174620, "text": "Pero el que practica la verdad, viene a la luz, para que sus obras sean manifestadas que son hechas en Dios.", "words": [[0, 167502], [5, 167646], [8, 167826], [12, 168206], [21, 168586], [24, 168746], [32, 169146], [38, 169606], [40, 169806], [43, 169866], [48, 170166], [53, 170966], [57, 171106], [61, 171286], [67, 171686], [72, 172066], [85, 172946], [89, 173126], [93, 173446], [100, 173766], [103, 174046]]}, {"verse": 22, "start": 175070, "end": 182294, "text": "Pasado esto, vino Jesús con sus discípulos a la tierra de Judea; y estaba allí con ellos, y bautizaba.", "words": [[0, 175070], [7, 175453], [13, 175733], [18, 176013], [24, 176513], [28, 177113], [32, 177333], [43, 178013], [45, 178193], [48, 178273], [55, 178573], [58, 178773], [65, 179689], [67, 179940], [74, 180220], [79, 180500], [83, 180780], [90, 181060], [92, 181400]]}, {"verse": 23, "start": 182744, "end": 190573, "text": "Y bautizaba también Juan en Enón junto a Salim, porque había allí muchas aguas; y venían, y eran bautizados.", "words": [[0, 182744], [2, 182849], [12, 183469], [20, 183830], [25, 184249], [28, 184569], [33, 184849], [39, 185150], [41, 185409], [48, 185830], [55, 186330], [61, 186650], [66, 186909], [73, 187169], [80, 188189], [82, 188318], [90, 188778], [92, 189298], [97, 189478]]}, {"verse": 24, "start": 191023, "end": 194062, "text": "Porque Juan no había sido aún puesto en la carcel.", "words": [[0, 191023], [7, 191246], [12, 191566], [15, 192066], [21, 192226], [26, 192586], [30, 192826], [37, 193126], [40, 193326], [43, 193426]]}, {"verse": 25, "start": 194512, "end": 200506, "text": "Y hubo una discusión entre los discípulos de Juan y los judíos acerca de la purificación.", "words": [[0, 194512], [2, 194636], [7, 194876], [11, 195036], [21, 195756], [27, 196016], [31, 196216], [42, 196796], [45, 196956], [50, 197256], [52, 197676], [56, 197796], [63, 198336], [70, 198856], [73, 199156], [76, 199256]]}, {"verse": 26, "start": 200956, "end": 210735, "text": "Y vinieron a Juan, y le dijeron: Rabí, el que estaba contigo del otro lado del Jordán, del cual tú diste testimonio, he aquí bautiza, y todos vienen a él.", "words": [[0, 200956], [2, 201080], [11, 201500], [13, 201640], [19, 201920], [21, 202180], [24, 202280], [33, 203282], [39, 203468], [42, 203655], [46, 203735], [53, 204055], [61, 204575], [65, 204755], [70, 204995], [75, 205255], [79, 205475], [87, 206355], [91, 206455], [96, 206675], [99, 206895], [105, 207235], [117, 208195], [120, 208335], [125, 208555], [134, 209515], [136, 209595], [142, 209835], [149, 210215], [151, 210435]]}, {"verse": 27, "start": 211085, "end": 216597, "text": "Respondió Juan, y dijo: No puede el hombre recibir algo, si no le es dado del cielo.", "words": [[0, 211085], [10, 211729], [16, 212029], [18, 212289], [24, 213054], [27, 213195], [33, 213475], [36, 213675], [43, 213875], [51, 214275], [57, 214995], [60, 215215], [63, 215375], [66, 215515], [69, 215655], [74, 215875], [78, 216095]]}, {"verse": 28, "start": 217047, "end": 223250, "text": "Vosotros mismos me sois testigos que dije: Yo no soy el Cristo, sino que soy enviado delante de él.", "words": [[0, 217047], [9, 217490], [16, 217790], [19, 218070], [24, 218390], [33, 218830], [37, 219030], [43, 219774], [46, 219941], [49, 220061], [53, 220361], [56, 220481], [64, 221261], [69, 221441], [73, 221621], [77, 221801], [85, 222321], [93, 222761], [96, 222941]]}, {"verse": 29, "start": 223700, "end": 234115, "text": "El que tiene la esposa, es el esposo; pero el amigo del esposo, que está en pie y le oye, se goza grandemente de la voz del esposo; así pues, este mi gozo es cumplido.", "words": [[0, 223700], [3, 223832], [7, 223972], [13, 224232], [16, 224392], [24, 224932], [27, 225372], [30, 225512], [38, 226478], [43, 226599], [46, 226719], [52, 226959], [56, 227159], [64, 227659], [68, 227839], [73, 228019], [76, 228219], [80, 228399], [82, 228559], [85, 228619], [90, 229199], [93, 229299], [98, 229579], [110, 230259], [113, 230439], [116, 230539], [120, 230719], [124, 230899], [132, 231862], [136, 232040], [142, 232520], [147, 232747], [150, 232973], [155, 233200], [158, 233400]]}, {"verse": 30, "start": 234565, "end": 236813, "text": "A él conviene crecer, pero a mí menguar.", "words": [[0, 234565], [2, 234691], [5, 234851], [14, 235291], [22, 235891], [27, 235991], [29, 236091], [32, 236481]]}, {"verse": 31, "start": 237263, "end": 246185, "text": "El que de arriba viene, sobre todos es: el que es de la tierra, terreno es, y cosas terrenas habla: el que viene del cielo, sobre todos es.", "words": [[0, 237263], [3, 237384], [7, 237504], [10, 237644], [17, 237884], [24, 238264], [30, 238564], [36, 238884], [40, 239714], [43, 239864], [47, 240024], [50, 240184], [53, 240284], [56, 240384], [64, 240764], [72, 241324], [76, 241664], [78, 242064], [84, 242304], [93, 243004], [100, 243845], [103, 243967], [107, 244087], [113, 244327], [117, 244547], [124, 244947], [130, 245267], [136, 245587]]}, {"verse": 32, "start": 246635, "end": 251214, "text": "Y lo que vio y oyó, esto testifica: y nadie recibe su testimonio.", "words": [[0, 246635], [2, 246740], [5, 246840], [9, 246980], [13, 247300], [15, 247520], [20, 248040], [25, 248300], [36, 249473], [38, 249597], [44, 249797], [51, 250317], [54, 250417]]}, {"verse": 33, "start": 251664, "end": 257095, "text": "El que recibe su testimonio, este confirmó con su sello que Dios es verdadero.", "words": [[0, 251720], [3, 251790], [7, 251930], [14, 252470], [17, 252630], [29, 253970], [34, 254170], [43, 254810], [47, 254950], [50, 255130], [56, 255550], [60, 255730], [65, 256010], [68, 256330]]}, {"verse": 34, "start": 257545, "end": 264597, "text": "Porque el que Dios envió, las palabras de Dios habla: porque no da Dios el Espíritu por medida.", "words": [[0, 257545], [7, 257749], [10, 257909], [14, 258049], [19, 258269], [26, 259229], [30, 259349], [39, 259729], [42, 259969], [47, 260414], [54, 261111], [61, 261317], [64, 261537], [67, 261737], [72, 261937], [75, 262157], [84, 262717], [88, 262877]]}, {"verse": 35, "start": 265047, "end": 268654, "text": "El Padre ama al Hijo, y todas las cosas dio en su mano.", "words": [[0, 265047], [3, 265165], [9, 265585], [13, 265805], [16, 266005], [22, 266305], [24, 266785], [30, 267005], [34, 267265], [40, 267565], [44, 267925], [47, 268105], [50, 268245]]}, {"verse": 36, "start": 269104, "end": 279029, "text": "El que cree en el Hijo, tiene vida eterna; pero el que es incrédulo al Hijo, no verá la vida, sino que la ira de Dios está sobre él.", "words": [[0, 269104], [3, 269225], [7, 269345], [12, 269625], [15, 269785], [18, 269905], [24, 270205], [30, 270665], [35, 270945], [43, 271834], [48, 271969], [51, 272129], [55, 272269], [58, 272469], [68, 273069], [71, 273249], [77, 273569], [80, 273949], [85, 274229], [88, 274329], [94, 274909], [99, 275209], [103, 275409], [106, 275549], [110, 275849], [113, 275949], [118, 276209], [123, 276569], [129, 276849]]}]}