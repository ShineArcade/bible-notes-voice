{"book": "PSA", "chapter": 21, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 85736, "verses": [{"verse": 1, "start": 300, "end": 8818, "text": "Al Músico principal: Salmo de David. SE ALEGRARÁ el rey en tu fortaleza, oh Jehová; y en tu salvación se gozará mucho.", "words": [[0, 300], [3, 502], [10, 982], [21, 2087], [27, 2585], [30, 2745], [37, 3585], [40, 3675], [49, 4255], [52, 4455], [56, 4755], [59, 4855], [62, 4995], [73, 5493], [76, 5990], [84, 6669], [86, 6777], [89, 6877], [92, 6997], [102, 7617], [105, 7817], [112, 8197]]}, {"verse": 2, "start": 9168, "end": 15913, "text": "El deseo de su corazón le diste, y no le negaste lo que sus labios pronunciaron. (Selah.)", "words": [[0, 9168], [3, 9354], [9, 9914], [12, 10014], [15, 10194], [23, 10774], [26, 10994], [33, 11614], [35, 12034], [38, 12234], [41, 12414], [49, 12914], [52, 13094], [56, 13234], [60, 13434], [67, 13914], [81, 15592]]}, {"verse": 3, "start": 16263, "end": 23218, "text": "Pues le has salido al encuentro con bendiciones de bien: corona de oro fino has puesto sobre su cabeza.", "words": [[0, 16263], [5, 16408], [8, 16688], [12, 16968], [19, 17388], [22, 17508], [32, 18148], [36, 18308], [48, 18988], [51, 19248], [57, 19970], [64, 20316], [67, 20576], [71, 20776], [76, 21156], [80, 21441], [87, 21741], [93, 22201], [96, 22421]]}, {"verse": 4, "start": 23568, "end": 27933, "text": "Vida te pidió, y le diste largura de días por siglos y siglos.", "words": [[0, 23568], [5, 23859], [8, 24099], [15, 24579], [17, 24779], [20, 24859], [26, 25319], [34, 25819], [37, 25979], [42, 26239], [46, 26479], [53, 27099], [55, 27219]]}, {"verse": 5, "start": 28283, "end": 33868, "text": "Grande es su gloria en tu salvación: honra y majestad has puesto sobre él.", "words": [[0, 28283], [7, 28791], [10, 29111], [13, 29291], [20, 29751], [23, 29891], [26, 30031], [37, 31111], [43, 31644], [45, 31864], [54, 32564], [58, 32764], [65, 33084], [71, 33504]]}, {"verse": 6, "start": 34218, "end": 39236, "text": "Porque lo has bendecido para siempre; lo llenaste de alegría con tu rostro.", "words": [[0, 34218], [7, 34531], [10, 34751], [14, 34871], [24, 35491], [29, 35711], [38, 36693], [41, 36842], [50, 37302], [53, 37502], [61, 38022], [65, 38262], [68, 38442]]}, {"verse": 7, "start": 39586, "end": 45917, "text": "Por cuanto el rey confía en Jehová, y en la misericordia del Altísimo, no será conmovido.", "words": [[0, 39586], [4, 39728], [11, 40048], [14, 40248], [18, 40588], [25, 41088], [28, 41188], [36, 41708], [38, 41888], [41, 42008], [44, 42128], [57, 42928], [61, 43068], [71, 44328], [74, 44568], [79, 44848]]}, {"verse": 8, "start": 46267, "end": 52254, "text": "Alcanzará tu mano a todos tus enemigos; tu diestra alcanzará a los que te aborrecen.", "words": [[0, 46267], [10, 46870], [13, 47050], [18, 47410], [20, 47670], [26, 48030], [30, 48310], [40, 49412], [43, 49514], [51, 49974], [61, 50874], [63, 51054], [67, 51174], [71, 51314], [74, 51434]]}, {"verse": 9, "start": 52604, "end": 60723, "text": "Los pondrás como horno de fuego en el tiempo de tu ira: Jehová los deshará en su furor, y fuego los consumirá.", "words": [[0, 52604], [4, 52713], [12, 53213], [17, 53453], [23, 53833], [26, 53953], [32, 54293], [35, 54513], [38, 54653], [45, 54993], [48, 55213], [51, 55413], [56, 56167], [63, 56709], [67, 57079], [75, 57449], [78, 57629], [81, 57829], [88, 58449], [90, 58709], [96, 59189], [100, 59769]]}, {"verse": 10, "start": 61073, "end": 66651, "text": "Su fruto destruirás de la tierra, y su descendencia de entre los hijos de los hombres.", "words": [[0, 61073], [3, 61274], [9, 61982], [20, 62689], [23, 62809], [26, 62949], [34, 63369], [36, 63704], [39, 63864], [52, 64944], [55, 65104], [61, 65264], [65, 65364], [71, 65624], [74, 65824], [78, 65964]]}, {"verse": 11, "start": 67000, "end": 72758, "text": "Porque trazaron el mal contra ti: tramaron maquinaciones, mas no prevalecerán.", "words": [[0, 67000], [7, 67204], [16, 67864], [19