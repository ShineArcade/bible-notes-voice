{"book": "JHN", "chapter": 12, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 417242, "verses": [{"verse": 1, "start": 300, "end": 11684, "text": "Y Jesús, seis días antes de la Pascua, vino a Betania, donde estaba Lázaro, que había sido muerto, al cual había resucitado de los muertos.", "words": [[0, 300], [2, 460], [9, 1240], [14, 1620], [19, 2060], [25, 2640], [28, 2840], [31, 2960], [39, 3940], [44, 4200], [46, 4520], [55, 5840], [61, 5980], [68, 6380], [76, 7480], [80, 7520], [86, 7760], [91, 8100], [99, 9160], [102, 9300], [107, 9560], [113, 10020], [124, 11000], [127, 11140], [131, 11260]]}, {"verse": 2, "start": 12134, "end": 22048, "text": "Y le hicieron allí una cena: y Marta servía, y Lázaro era uno de los que estaban sentados a la mesa juntamente con él.", "words": [[0, 12134], [2, 12878], [5, 13018], [14, 13428], [19, 13838], [23, 14118], [29, 14954], [31, 15079], [37, 15639], [45, 17019], [47, 17139], [54, 17639], [58, 18019], [62, 18459], [65, 18619], [69, 18759], [73, 18899], [81, 19219], [90, 19959], [92, 20139], [95, 20239], [100, 20479], [111, 21299], [115, 21619]]}, {"verse": 3, "start": 22498, "end": 36316, "text": "Entonces María tomó una libra de perfume de nardo líquido de mucho precio, y ungió los pies de Jesús, y limpió sus pies con sus cabellos: y la casa se llenó del olor del perfume.", "words": [[0, 22498], [9, 23297], [15, 23677], [20, 24157], [24, 24317], [30, 24717], [33, 24857], [41, 25217], [44, 25497], [50, 25897], [58, 26497], [61, 26657], [67, 26897], [75, 27457], [77, 28137], [83, 28597], [87, 28777], [92, 28997], [95, 29157], [102, 29557], [104, 30317], [111, 30917], [115, 31137], [120, 31417], [124, 31737], [128, 31937], [138, 33085], [140, 33211], [143, 33331], [148, 33651], [151, 33911], [157, 34371], [161, 34711], [166, 35271], [170, 35451]]}, {"verse": 4, "start": 36766, "end": 43761, "text": "Y dijo uno de sus discípulos, Judas Iscariote, hijo de Simón, el que le había de entregar:", "words": [[0, 36766], [2, 37022], [7, 37302], [11, 37662], [14, 37822], [18, 38022], [30, 39082], [36, 39442], [47, 40702], [52, 40962], [55, 41162], [62, 42042], [65, 42222], [69, 42382], [72, 42542], [78, 42742], [81, 42982]]}, {"verse": 5, "start": 44011, "end": 48385, "text": "¿Por qué no se ha vendido este perfume por trescientos denarios, y se dio a los pobres?", "words": [[0, 44011], [5, 44135], [9, 44295], [12, 44435], [15, 44575], [18, 44695], [26, 45115], [31, 45275], [39, 45695], [43, 46005], [55, 46315], [65, 46975], [67, 47215], [70, 47355], [74, 47535], [76, 47615], [80, 47715]]}, {"verse": 6, "start": 48735, "end": 57922, "text": "Pero dijo esto, no por el cuidado que él tenía de los pobres; sino porque era ladrón, y tenía la bolsa, y traía lo que se echaba en ella.", "words": [[0, 48735], [5, 48897], [10, 49197], [16, 49497], [19, 49737], [23, 49977], [26, 50137], [34, 50497], [38, 50797], [41, 50957], [47, 51257], [50, 51417], [54, 51537], [62, 52674], [67, 52979], [74, 53359], [78, 53619], [86, 54239], [88, 54759], [94, 55019], [97, 55219], [104, 55719], [106, 55819], [112, 56299], [115, 56499], [119, 56639], [122, 56819], [129, 57199], [132, 57419]]}, {"verse": 7, "start": 58372, "end": 64728, "text": "Entonces Jesús dijo: Déjala: para el día de mi sepultura ha guardado esto;", "words": [[0, 58372], [9, 59036], [15, 59536], [21, 60578], [29, 61557], [34, 61744], [37, 61884], [41, 62144], [44, 62324], [47, 62464], [57, 63124], [60, 63464], [69, 64124]]}, {"verse": 8, "start": 65178, "end": 70572, "text": "Porque a los pobres siempre los tenéis con vosotros, pero a mí no siempre me tenéis.", "words": [[0, 65178], [7, 65400], [9, 65520], [13, 65620], [20, 66180], [28, 66760], [32, 67020], [39, 67380], [43, 67580], [53, 68600], [58, 68900], [60, 69000], [63, 69100], [66, 69240], [74, 69640], [77, 69880]]}, {"verse": 9, "start": 71022, "end": 83624, "text": "Entonces mucha gente de los judíos entendió que él estaba allí; y vinieron no solamente por causa de Jesús, sino también por ver a Lázaro, al cual había resucitado de los muertos.", "words": [[0, 71022], [9, 71842], [15, 72182], [21, 72582], [24, 72782], [28, 72902], [35, 73382], [44, 73942], [48, 74122], [51, 74302], [58, 74602], [64, 75500], [66, 75608], [75, 76048], [78, 76548], [88, 76928], [92, 77368], [98, 77708], [101, 77948], [108, 78628], [113, 78888], [121, 79268], [125, 79568], [129, 80035], [131, 80501], [139, 80968], [142, 81068], [147, 81288], [153, 81688], [164, 82588], [167, 82748], [171, 82848]]}, {"verse": 10, "start": 84074, "end": 88780, "text": "Planearon asimismo los principales sacerdotes matar también a Lázaro;", "words": [[0, 84074], [10, 84658], [19, 85278], [23, 85478], [35, 86258], [46, 86978], [52, 87318], [60, 87830], [62, 88342]]}, {"verse": 11, "start": 89230, "end": 94307, "text": "Porque muchos de los judíos iban y creían en Jesús por causa de él.", "words": [[0, 89230], [7, 89571], [14, 89971], [17, 90171], [21, 90291], [28, 90851], [33, 91251], [35, 91391], [42, 91891], [45, 92031], [51, 92471], [55, 93191], [61, 93551], [64, 93891]]}, {"verse": 12, "start": 94757, "end": 101440, "text": "El siguiente día, mucha gente que había venido a la fiesta, cuando oyeron que Jesús venía a Jerusalén,", "words": [[0, 94757], [3, 94904], [13, 95204], [18, 95604], [24, 95924], [30, 96344], [34, 96544], [40, 96764], [47, 97224], [49, 97304], [52, 97364], [60, 98244], [67, 98704], [74, 99224], [78, 99324], [84, 99604], [90, 100364], [92, 100544]]}, {"verse": 13, "start": 101890, "end": 111253, "text": "Tomaron ramas de palmas, y salieron a recibirle, y clamaban: ¡Hosanna, Bendito el que viene en el nombre del Señor, el Rey de Israel!", "words": [[0, 101890], [8, 102254], [14, 102834], [17, 102934], [25, 103614], [27, 103974], [36, 104454], [38, 104614], [49, 105354], [51, 105854], [61, 107104], [71, 107364], [79, 107944], [82, 108044], [86, 108164], [92, 108464], [95, 108664], [98, 108784], [105, 109064], [109, 109264], [116, 110204], [119, 110304], [123, 110584], [126, 110644]]}, {"verse": 14, "start": 111603, "end": 116417, "text": "Y halló Jesús un asnillo, y se sentó sobre él, como está escrito:", "words": [[0, 111603], [2, 111748], [8, 112048], [14, 112368], [17, 112788], [26, 113368], [28, 114288], [31, 114388], [37, 114808], [43, 115088], [47, 115368], [52, 115628], [57, 115808]]}, {"verse": 15, "start": 116867, "end": 122574, "text": "No temas, hija de Sion: he aquí tu Rey viene, sentado sobre un pollino de asna.", "words": [[0, 116867], [3, 116993], [10, 117273], [15, 117713], [18, 117773], [24, 118747], [27, 118827], [32, 119027], [35, 119247], [39, 119627], [46, 120307], [54, 120867], [60, 121107], [63, 121327], [71, 121807], [74, 121967]]}, {"verse": 16, "start": 123024, "end": 135520, "text": "Estas cosas no las entendieron sus discípulos al principio: pero cuando Jesús fue glorificado, entonces se acordaron de que estas cosas estaban escritas de él, y que le hicieron estas cosas.", "words": [[0, 123024], [6, 123464], [12, 123664], [15, 123984], [19, 124164], [31, 124884], [35, 125124], [46, 125764], [49, 125964], [60, 127166], [65, 127290], [72, 127550], [78, 127870], [82, 128170], [95, 129330], [104, 129670], [107, 130050], [117, 130610], [120, 130810], [124, 130910], [130, 131110], [136, 131550], [144, 131990], [153, 132650], [156, 132830], [160, 133170], [162, 133650], [166, 133790], [169, 133930], [178, 134490], [184, 134710]]}, {"verse": 17, "start": 135970, "end": 144793, "text": "Y la gente que estaba con él, daba testimonio de cuando llamó a Lázaro del sepulcro, y le resucitó de los muertos.", "words": [[0, 135970], [2, 136074], [5, 136174], [11, 136474], [15, 136674], [22, 136894], [26, 137194], [30, 137854], [35, 138414], [46, 139194], [49, 139314], [56, 139554], [62, 140007], [64, 140461], [71, 140914], [75, 141114], [85, 142054], [87, 142694], [90, 142874], [99, 143754], [102, 143814], [106, 143954]]}, {"verse": 18, "start": 145243, "end": 151864, "text": "Por lo cual también había venido la gente a recibirle, porque había oído que él había hecho esta señal;", "words": [[0, 145243], [4, 145386], [7, 145546], [12, 145806], [20, 146106], [26, 146506], [33, 146986], [36, 147126], [42, 147406], [44, 147566], [55, 148386], [62, 148946], [68, 149326], [73, 149806], [77, 150066], [80, 150266], [86, 150526], [92, 150866], [97, 151146]]}, {"verse": 19, "start": 152314, "end": 158401, "text": "Pero los fariseos dijeron entre sí: ¿Veis que nada aprovecháis? he aquí, el mundo se va tras de él.", "words": [[0, 152314], [5, 152456], [9, 152656], [18, 153336], [26, 153876], [32, 154156], [36, 154939], [42, 155181], [46, 155261], [51, 155441], [64, 156654], [67, 156734], [73, 156954], [76, 157134], [82, 157354], [85, 157554], [88, 157734], [93, 157914], [96, 158174]]}, {"verse": 20, "start": 158751, "end": 163759, "text": "Y había ciertos griegos de los que habían subido a adorar en la fiesta:", "words": [[0, 158751], [2, 158879], [8, 159099], [16, 159839], [24, 160439], [27, 160619], [31, 160719], [35, 160859], [42, 161119], [49, 161679], [51, 161859], [58, 162499], [61, 162819], [64, 162979]]}, {"verse": 21, "start": 164209, "end": 172995, "text": "Estos pues, se llegaron a Felipe, que era de Betsaida de Galilea, y le rogaron, diciendo: Señor, querríamos ver a Jesús.", "words": [[0, 164209], [6, 164591], [12, 165231], [15, 165371], [24, 165811], [26, 165911], [34, 166371], [38, 166651], [42, 166811], [45, 167241], [54, 167671], [57, 167751], [66, 168791], [68, 168831], [71, 168971], [80, 169751], [90, 170982], [97, 171787], [108, 172127], [112, 172387], [114, 172467]]}, {"verse": 22, "start": 173345, "end": 179493, "text": "Vino Felipe, y lo dijo a Andrés: Andrés entonces, y Felipe, lo dicen a Jesús.", "words": [[0, 173345], [5, 173611], [13, 174031], [15, 174311], [18, 174391], [23, 174511], [25, 174631], [33, 175710], [40, 176096], [50, 176636], [52, 177336], [60, 177796], [63, 178376], [69, 178696], [71, 178876]]}, {"verse": 23, "start": 179943, "end": 187646, "text": "Entonces Jesús les respondió, diciendo: La hora viene en que el Hijo del hombre ha de ser glorificado.", "words": [[0, 179943], [9, 180406], [15, 180946], [19, 181366], [30, 182026], [40, 183127], [43, 183479], [48, 183759], [54, 184119], [57, 184519], [61, 184699], [64, 184899], [69, 185159], [73, 185339], [80, 185699], [83, 185999], [86, 186179], [90, 186419]]}, {"verse": 24, "start": 188096, "end": 198189, "text": "De cierto, de cierto os digo, que si el grano de trigo no cae en la tierra y muere, él solo queda; pero si muere, lleva mucho fruto.", "words": [[0, 188327], [3, 188591], [11, 188855], [14, 189119], [21, 189383], [24, 189563], [30, 189823], [34, 190063], [37, 190283], [40, 190483], [46, 190863], [49, 191003], [55, 191443], [58, 191683], [62, 192203], [65, 192423], [68, 192583], [75, 193043], [77, 193383], [84, 193783], [87, 194083], [92, 194403], [99, 195406], [104, 195570], [107, 196210], [114, 196850], [120, 197050], [126, 197430]]}, {"verse": 25, "start": 198639, "end": 206358, "text": "El que ama su vida, la perderá; y el que aborrece su vida en este mundo, para vida eterna la guardará.", "words": [[0, 198639], [3, 198793], [7, 198953], [11, 199173], [14, 199393], [20, 199793], [23, 200453], [32, 201524], [34, 201855], [37, 201975], [41, 202115], [50, 202615], [53, 202835], [58, 203155], [61, 203275], [66, 203475], [73, 203915], [78, 204495], [83, 204715], [90, 205315], [93, 205575]]}, {"verse": 26, "start": 206808, "end": 216010, "text": "Si alguno me sirve, sígame: y donde yo esté, allí también estará mi servidor. Si alguno me sirve, mi Padre le honrará.", "words": [[0, 206808], [3, 206991], [10, 207411], [13, 207531], [20, 208169], [28, 209106], [30, 209210], [36, 209410], [39, 209710], [45, 210590], [50, 210830], [58, 211250], [65, 211730], [68, 211830], [78, 212884], [81, 213048], [88, 213488], [91, 213588], [98, 214448], [101, 214548], [107, 214908], [110, 215488]]}, {"verse": 27, "start": 216460, "end": 225095, "text": "Ahora está turbada mi alma; ¿y qué diré? Padre, sálvame de esta hora. Pero por esto he venido en esta hora.", "words": [[0, 216460], [6, 216900], [11, 217140], [19, 217640], [22, 217820], [28, 218625], [31, 218791], [35, 218931], [41, 220711], [48, 221036], [56, 221361], [59, 221686], [64, 221946], [70, 222865], [75, 223010], [79, 223230], [84, 223530], [87, 223850], [94, 224250], [97, 224370], [102, 224590]]}, {"verse": 28, "start": 225545, "end": 234619, "text": "Padre, glorifica tu nombre. Entonces vino una voz del cielo: Y lo he glorificado, y lo glorificaré otra vez.", "words": [[0, 225545], [7, 226010], [17, 226610], [20, 226810], [28, 227751], [37, 228495], [42, 229335], [46, 229655], [50, 229895], [54, 230055], [61, 231024], [63, 231163], [66, 231283], [69, 231443], [82, 232303], [84, 232843], [87, 232943], [99, 233643], [104, 233843]]}, {"verse": 29, "start": 234969, "end": 246728, "text": "Y la gente que estaba presente, y había oído, decía que había sido trueno. Otros decían: Ángel le ha hablado.", "words": [[0, 234969], [2, 235069], [5, 235149], [11, 235469], [15, 235649], [22, 235889], [32, 236409], [34, 236589], [40, 236749], [46, 237149], [52, 237909], [56, 238269], [62, 238489], [67, 238809], [75, 239820], [81, 240209], [89, 241600], [95, 242040], [98, 242200], [101, 242340]]}, {"verse": 30, "start": 247078, "end": 253087, "text": "Respondió Jesús, y dijo: No ha venido esta voz por mi causa, sino por causa de vosotros.", "words": [[0, 247078], [10, 247635], [17, 248055], [19, 248355], [25, 249146], [28, 249311], [31, 249451], [38, 249791], [43, 250031], [47, 250271], [51, 250531], [54, 250671], [61, 251171], [66, 251391], [70, 251651], [76, 252011], [79, 252291]]}, {"verse": 31, "start": 253537, "end": 259326, "text": "Ahora es el juicio de este mundo: ahora el príncipe de este mundo será echado fuera.", "words": [[0, 253537], [6, 253908], [9, 254068], [12, 254128], [19, 254588], [22, 254728], [27, 254888], [34, 255761], [40, 256176], [43, 256376], [52, 257296], [55, 257476], [60, 257676], [66, 257956], [71, 258296], [78, 258716]]}, {"verse": 32, "start": 259776, "end": 264105, "text": "Y yo, si soy levantado de la tierra, a todos traeré a mí mismo.", "words": [[0, 259776], [2, 259917], [6, 260077], [9, 260237], [13, 260457], [23, 261117], [26, 261257], [29, 261377], [37, 262077], [39, 262317], [45, 262617], [52, 263397], [54, 263437], [57, 263557]]}, {"verse": 33, "start": 264555, "end": 267786, "text": "Y esto decía dando a entender de qué muerte había de morir.", "words": [[0, 264555], [2, 264680], [7, 264880], [13, 265260], [19, 265560], [21, 265680], [30, 266040], [33, 266300], [37, 266440], [44, 266760], [50, 267060], [53, 267260]]}, {"verse": 34, "start": 268236, "end": 279538, "text": "Le respondió la gente: Nosotros hemos oído de la ley, que el Cristo permanece para siempre: ¿cómo pues dices tú: Conviene que el Hijo del hombre sea levantado? ¿Quién es este Hijo del hombre?", "words": [[0, 268236], [3, 268345], [13, 268925], [16, 269045], [23, 269949], [32, 270333], [38, 270573], [43, 270933], [46, 271073], [49, 271193], [54, 271453], [58, 271873], [61, 271993], [68, 272293], [78, 272853], [83, 273073], [92, 273997], [98, 274201], [103, 274601], [109, 275061], [113, 275764], [122, 276122], [126, 276282], [129, 276402], [134, 276582], [138, 276722], [145, 276922], [149, 277162], [160, 278188], [167, 278365], [170, 278485], [175, 278705], [180, 278885], [184, 279065]]}, {"verse": 35, "start": 279888, "end": 295367, "text": "Entonces Jesús les dice: Aun por un poco estará la luz entre vosotros: andad entre tanto que tenéis luz, porque no os sorprendan las tinieblas; porque el que anda en tinieblas, no sabe dónde va.", "words": [[0, 279888], [9, 280913], [15, 281373], [19, 281873], [25, 282774], [29, 282999], [33, 283299], [36, 283439], [41, 283739], [48, 284279], [51, 284399], [55, 284659], [61, 284979], [71, 286376], [77, 286596], [83, 286956], [89, 287356], [93, 287576], [100, 287996], [105, 288756], [112, 289196], [115, 289376], [118, 289556], [129, 290696], [133, 290896], [144, 292198], [151, 292442], [154, 292602], [158, 292762], [163, 292962], [166, 293142], [177, 293882], [180, 294302], [185, 294562], [191, 294802]]}, {"verse": 36, "start": 295817, "end": 307296, "text": "Entre tanto que tenéis la luz, creed en la luz, para que seáis hijos de luz. Estas cosas habló Jesús, y se fue, y se escondió de ellos.", "words": [[0, 295817], [6, 296105], [12, 296465], [16, 296705], [23, 297165], [26, 297385], [31, 298045], [37, 298605], [40, 298845], [43, 299025], [48, 299385], [53, 299945], [57, 300105], [63, 300565], [69, 301085], [72, 301445], [77, 302276], [83, 302564], [89, 302984], [95, 303564], [102, 303944], [104, 304704], [107, 304864], [112, 305124], [114, 305624], [117, 305784], [126, 306464], [129, 306624]]}, {"verse": 37, "start": 307746, "end": 312461, "text": "Pero habiendo hecho delante de ellos tantas señales, no creían en él.", "words": [[0, 307746], [5, 307894], [14, 308294], [20, 308614], [28, 309134], [31, 309314], [37, 309574], [44, 310214], [53, 310874], [56, 311294], [63, 311854], [66, 312074]]}, {"verse": 38, "start": 312911, "end": 322545, "text": "Para que se cumpliese el dicho que dijo el profeta Isaías: ¿Señor, quién ha creído a nuestro dicho? ¿y el brazo del Señor, a quién es revelado?", "words": [[0, 312911], [5, 313072], [9, 313212], [12, 313622], [22, 314032], [25, 314212], [31, 314572], [35, 314772], [40, 315092], [43, 315272], [51, 315872], [59, 317081], [67, 317560], [73, 317760], [76, 317860], [83, 318260], [85, 318380], [93, 318500], [100, 319493], [103, 319620], [106, 319780], [112, 320200], [116, 320380], [123, 320860], [125, 321320], [131, 321540], [134, 321760]]}, {"verse": 39, "start": 322995, "end": 327765, "text": "Por esto no podían creer, porque otra vez dijo Isaías:", "words": [[0, 322995], [4, 323139], [9, 323379], [12, 323599], [19, 324039], [26, 324879], [33, 325099], [38, 325339], [42, 325799], [47, 326659]]}, {"verse": 40, "start": 328215, "end": 338723, "text": "Cegó los ojos de ellos, y endureció su corazón; porque no vean con los ojos, y entiendan de corazón, y se conviertan, y yo los sane.", "words": [[0, 328215], [5, 328620], [9, 328800], [14, 329120], [17, 329400], [24, 329760], [26, 330280], [36, 331020], [39, 331260], [48, 332451], [55, 332633], [58, 332873], [63, 333213], [67, 333353], [71, 333533], [77, 333993], [79, 334433], [89, 335153], [92, 335313], [101, 335833], [103, 336393], [106, 336533], [118, 337373], [120, 337793], [123, 337953], [127, 338093]]}, {"verse": 41, "start": 339173, "end": 344076, "text": "Estas cosas dijo Isaías cuando vio su gloria, y habló de él.", "words": [[0, 339173], [6, 339573], [12, 339893], [17, 340453], [24, 341073], [31, 341553], [35, 341853], [38, 342033], [46, 342553], [48, 343093], [54, 343473], [57, 343653]]}, {"verse": 42, "start": 344526, "end": 355854, "text": "Con todo eso, aun de los dirigentes, muchos creyeron en él; pero por causa de los fariseos no lo confesaban, por no ser echados de la sinagoga.", "words": [[0, 344526], [4, 344670], [9, 344970], [14, 345490], [18, 345790], [21, 346050], [25, 346170], [37, 347550], [44, 348050], [53, 348830], [56, 348990], [60, 349690], [65, 349835], [69, 350095], [75, 350535], [78, 350795], [82, 350935], [91, 351715], [94, 352055], [97, 352195], [109, 353275], [113, 353555], [116, 353735], [120, 353995], [128, 354635], [131, 354855], [134, 354975]]}, {"verse": 43, "start": 356304, "end": 360422, "text": "Porque amaban más la gloria de los hombres que la gloria de Dios.", "words": [[0, 356304], [7, 356551], [14, 357011], [18, 357371], [21, 357791], [28, 358191], [31, 358331], [35, 358471], [43, 358891], [47, 359131], [50, 359271], [57, 359671], [60, 359791]]}, {"verse": 44, "start": 360872, "end": 367395, "text": "Pero Jesús clamó y dijo: El que cree en mí, no cree en mí, sino en el que me envió;", "words": [[0, 360872], [5, 361019], [11, 361439], [17, 362279], [19, 362439], [25, 363232], [28, 363361], [32, 363501], [37, 363801], [40, 364141], [44, 364881], [47, 364981], [52, 365241], [55, 365501], [59, 365901], [64, 366221], [67, 366421], [70, 366541], [74, 366661], [77, 366801]]}, {"verse": 45, "start": 367845, "end": 370517, "text": "Y el que me ve, ve al que me envió.", "words": [[0, 367845], [2, 367986], [5, 368106], [9, 368246], [12, 368386], [16, 369006], [19, 369296], [22, 369586], [26, 369726], [29, 369906]]}, {"verse": 46, "start": 370967, "end": 377898, "text": "Yo la luz he venido al mundo, para que todo aquel que cree en mí no permanezca en tinieblas.", "words": [[0, 370967], [3, 371212], [6, 371532], [10, 371792], [13, 372072], [20, 372452], [23, 372592], [30, 372992], [35, 373532], [39, 373712], [44, 373992], [50, 374452], [54, 374572], [59, 374892], [62, 375252], [65, 375532], [68, 376012], [79, 376812], [82, 376972]]}, {"verse": 47, "start": 378348, "end": 388210, "text": "Y el que oye mis palabras, y no las cree, yo no le juzgo; porque no he venido a juzgar al mundo, sino a salvar al mundo.", "words": [[0, 378348], [2, 378512], [5, 378632], [9, 378832], [13, 379212], [17, 379352], [27, 379892], [29, 380392], [32, 380572], [36, 380752], [42, 381752], [45, 381992], [48, 382172], [51, 382352], [58, 383368], [65, 383768], [68, 384068], [71, 384228], [78, 384608], [80, 384728], [87, 385188], [90, 385468], [97, 386228], [102, 386508], [104, 386828], [111, 387208], [114, 387628]]}, {"verse": 48, "start": 388660, "end": 397725, "text": "El que me rechaza, y no recibe mis palabras, tiene quien le juzgue: la palabra que he hablado, ella le juzgará en el día postrero.", "words": [[0, 388660], [3, 388800], [7, 388940], [10, 389100], [19, 389780], [21, 390500], [24, 390700], [31, 391200], [35, 391360], [45, 391780], [51, 392180], [57, 392480], [60, 392700], [68, 393697], [71, 393999], [79, 394359], [83, 394639], [86, 394759], [95, 395339], [100, 395559], [103, 395739], [111, 396379], [114, 396579], [117, 396719], [121, 396939]]}, {"verse": 49, "start": 398175, "end": 407532, "text": "Porque yo no he hablado de mí mismo: sino que el Padre que me envió, él me dio mandamiento de lo que he de decir, y de lo que he de hablar.", "words": [[0, 398175], [7, 398361], [10, 398581], [13, 398741], [16, 398861], [24, 399241], [27, 399381], [30, 399521], [37, 400368], [42, 400589], [46, 400809], [49, 400969], [55, 401309], [59, 401509], [62, 401689], [69, 402609], [72, 402949], [75, 403129], [79, 403309], [91, 404069], [94, 404309], [97, 404469], [101, 404669], [104, 404809], [107, 404929], [114, 405369], [116, 406209], [119, 406349], [122, 406489], [126, 406669], [129, 406809], [132, 406929]]}, {"verse": 50, "start": 407982, "end": 416842, "text": "Y sé que su mandamiento es vida eterna: así que, lo que yo hablo, como el Padre me lo ha dicho, así hablo.", "words": [[0, 407982], [2, 408207], [5, 408447], [9, 408647], [12, 408847], [24, 409527], [27, 409787], [32, 410027], [40, 411174], [44, 411588], [49, 411828], [52, 412008], [56, 412188], [59, 412408], [66, 413428], [71, 413788], [74, 413968], [80, 414428], [83, 414548], [86, 414688], [89, 414788], [96, 415788], [100, 416048]]}]}