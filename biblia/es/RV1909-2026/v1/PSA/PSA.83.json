{"book": "PSA", "chapter": 83, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 108818, "verses": [{"verse": 1, "start": 300, "end": 7358, "text": "Canción: Salmo de Asaf. OH Dios, no tengas silencio: no calles, oh Dios, ni te estés quieto.", "words": [[0, 300], [9, 1377], [15, 1819], [18, 1999], [24, 2697], [27, 2777], [33, 3017], [36, 3327], [43, 3637], [53, 4773], [56, 5053], [64, 5363], [67, 5673], [73, 6273], [76, 6413], [79, 6553], [85, 6853]]}, {"verse": 2, "start": 7708, "end": 13154, "text": "Porque he aquí que rugen tus enemigos; y tus aborrecedores han alzado cabeza.", "words": [[0, 7764], [7, 7924], [10, 8204], [15, 8544], [19, 8854], [25, 9164], [29, 9404], [39, 10419], [41, 10619], [45, 11129], [59, 11639], [63, 11899], [70, 12399]]}, {"verse": 3, "start": 13504, "end": 20729, "text": "Sobre tu pueblo han consultado astuta y secretamente, y han entrado en consejo contra tus escondidos.", "words": [[0, 13504], [6, 13805], [9, 14025], [16, 14465], [20, 14725], [31, 15505], [38, 16005], [40, 16125], [54, 16885], [56, 17485], [60, 17645], [68, 18285], [71, 18445], [79, 19145], [86, 19525], [90, 19785]]}, {"verse": 4, "start": 21079, "end": 26888, "text": "Han dicho: Venid, y cortémoslos de ser pueblo, y no haya más memoria del nombre de Israel.", "words": [[0, 21336], [4, 21592], [11, 22022], [18, 22386], [20, 22836], [32, 23286], [35, 23486], [39, 23666], [47, 24466], [49, 24626], [52, 24746], [57, 24966], [61, 25206], [69, 25706], [73, 25886], [80, 26186], [83, 26366]]}, {"verse": 5, "start": 27168, "end": 32326, "text": "Por esto han conspirado de corazón a una, contra ti han hecho liga;", "words": [[0, 27168], [4, 27310], [9, 27610], [13, 28090], [24, 28910], [27, 29070], [35, 29510], [37, 29890], [42, 30470], [49, 31010], [52, 31170], [56, 31430], [62, 31650]]}, {"verse": 6, "start": 32676, "end": 38304, "text": "Las tiendas de los edomitas y de los ismaelitas, Moab y los agarenos;", "words": [[0, 32676], [4, 32801], [12, 33261], [15, 33361], [19, 33501], [28, 34101], [30, 34301], [33, 34401], [37, 34561], [49, 35661], [54, 36321], [56, 36486], [60, 37421]]}, {"verse": 7, "start": 38654, "end": 43174, "text": "Gebal, y Amón, y Amalec; los filisteos con los habitantes de Tiro.", "words": [[0, 38929], [7, 39239], [9, 39512], [15, 39785], [17, 40059], [25, 40492], [29, 40632], [39, 41472], [43, 41752], [47, 41872], [58, 42512], [61, 42652]]}, {"verse": 8, "start": 43524, "end": 51370, "text": "También el Assur se ha juntado con ellos: son por brazo a los hijos de Lot. (Selah.)", "words": [[0, 43524], [8, 43868], [11, 44328], [17, 44788], [20, 45248], [23, 45348], [31, 45908], [35, 46148], [42, 46900], [46, 47284], [50, 47524], [56, 48104], [58, 48324], [62, 48464], [68, 48764], [71, 49004], [76, 49667]]}, {"verse": 9, "start": 51720, "end": 57320, "text": "Hazles como a Madián; como a Sísara, como a Jabín en el arroyo de Cisón;", "words": [[0, 51720], [7, 52266], [12, 52735], [14, 53205], [22, 53836], [27, 54024], [29, 54334], [37, 54644], [42, 54964], [44, 55294], [50, 55624], [53, 55904], [56, 56214], [63, 56524], [66, 56704]]}, {"verse": 10, "start": 57670, "end": 62217, "text": "Que perecieron en Endor, fueron hechos estiércol para la tierra.", "words": [[0, 57670], [4, 58104], [15, 58574], [18, 58874], [25, 59314], [32, 59834], [39, 60294], [49, 61054], [54, 61354], [57, 61514]]}, {"verse": 11, "start": 62567, "end": 71575, "text": "Pon a ellos y a sus capitanes como a Oreb y como a Zeeb; y como a Zeba y como a Zalmuna, a todos sus príncipes;", "words": [[0, 62651], [4, 62771], [6, 62911], [12, 63271], [14, 63571], [16, 63711], [20, 63871], [30, 64711], [35, 64931], [37, 65211], [42, 65611], [44, 66071], [49, 66371], [51, 66837], [57, 67467], [59, 67574], [64, 67834], [66, 68134], [71, 68434], [73, 68574], [78, 68794], [80, 69294], [89, 69794], [91, 69914], [97, 70194], [101, 70594]]}, {"verse": 12, "start": 71925, "end": 75494, "text": "Que han dicho: Heredemos para nosotros las moradas de Dios.", "words": [[0, 71925], [4, 72048], [8, 72168], [15, 72840], [25, 73322], [30, 73562], [39, 74022], [43, 74282], [51, 74762], [54, 74962]]}, {"verse": 13, "start": 75774, "end": 81226, "text": "Dios mío, ponlos como a torbellinos; como a hojarascas delante del viento.", "words": [[0, 75774], [5, 75982], [10, 76462], [17, 76942], [22, 77528], [24, 78114], [37, 78861], [42, 79066], [44, 79496], [55, 79926], [63, 80366], [67, 80606]]}, {"verse": 14, "start": 81576, "end": 85821, "text": "Como fuego que quema el monte, como llama que abrasa las breñas.", "words": [[0, 81576], [5, 81741], [11, 82061], [15, 82341], [21, 82601], [24, 82741], [31, 83701], [36, 83861], [42, 84141], [46, 84491], [53, 84841], [57, 84981]]}, {"verse": 15, "start": 86171, "end": 90898, "text": "Persíguelos así con tu tempestad, y asómbralos con tu torbellino.", "words": [[0, 86171], [12, 87195], [16, 87495], [20, 87735], [23, 88165], [34, 88595], [36, 89015], [47, 89775], [51, 89955], [54, 90440]]}, {"verse": 16, "start": 91248, "end": 96188, "text": "Llena sus rostros de vergüenza; y busquen tu nombre, oh Jehová.", "words": [[0, 91248], [6, 91673], [10, 91873], [18, 92553], [21, 92733], [32, 93898], [34, 94022], [42, 94522], [45, 94702], [53, 95102], [56, 95502]]}, {"verse": 17, "start": 96538, "end": 102307, "text": "Sean afrentados y turbados para siempre; y sean deshonrados, y perezcan.", "words": [[0, 96538], [5, 96898], [16, 97758], [18, 97958], [27, 98498], [32, 98758], [41, 99860], [43, 99985], [48, 100245], [61, 101185], [63, 101405]]}, {"verse": 18, "start": 102657, "end": 108418, "text": "Y conozcan que tu nombre es JEHOVÁ; tú solo Altísimo sobre toda la tierra.", "words": [[0, 102657], [2, 102908], [11, 103508], [15, 103688], [18, 103848], [25, 104168], [28, 104568], [36, 105672], [39, 105777], [44, 106077], [53, 106797], [59, 107157], [64, 107457], [67, 107717]]}]}