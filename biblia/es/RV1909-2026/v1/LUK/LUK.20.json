{"book": "LUK", "chapter": 20, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 340222, "verses": [{"verse": 1, "start": 300, "end": 11139, "text": "Y aconteció un día, que enseñando él al pueblo en el templo, y anunciando el evangelio, se llegaron los principales sacerdotes y los escribas, con los ancianos;", "words": [[0, 300], [2, 422], [12, 1122], [15, 1302], [20, 1602], [24, 1887], [34, 2527], [37, 2707], [40, 2847], [47, 3227], [50, 3407], [53, 3567], [61, 4267], [63, 4387], [74, 5047], [77, 5167], [88, 6427], [91, 6587], [100, 7047], [104, 7207], [116, 7987], [127, 8947], [129, 9187], [133, 9347], [143, 9927], [147, 10167], [151, 10307]]}, {"verse": 2, "start": 11489, "end": 18827, "text": "Y le hablaron, diciendo: Dinos: ¿con qué autoridad haces estas cosas? ¿o quién es el que te ha dado esta autoridad?", "words": [[0, 11489], [2, 11635], [5, 11715], [15, 12435], [25, 13680], [32, 14434], [37, 14558], [41, 14738], [51, 15318], [57, 15698], [63, 15938], [70, 16856], [73, 16960], [79, 17140], [82, 17320], [85, 17440], [89, 17560], [92, 17720], [95, 17800], [100, 18020], [105, 18200]]}, {"verse": 3, "start": 19107, "end": 25869, "text": "Respondiendo entonces Jesús, les dijo: Os haré yo también una pregunta; respondedme:", "words": [[0, 19107], [13, 19973], [22, 20413], [29, 21053], [33, 21473], [39, 22299], [42, 22736], [47, 23176], [50, 23296], [58, 23636], [62, 23956], [72, 25398]]}, {"verse": 4, "start": 26219, "end": 30051, "text": "El bautismo de Juan, ¿era del cielo, o de los hombres?", "words": [[0, 26219], [3, 26343], [12, 26903], [15, 27063], [21, 27463], [26, 28163], [30, 28403], [37, 28823], [39, 29203], [42, 29263], [46, 29403]]}, {"verse": 5, "start": 30401, "end": 37283, "text": "Pero ellos pensaban dentro de sí, diciendo: Si decimos, del cielo, dirá: ¿Por qué, pues, no le creísteis?", "words": [[0, 30401], [5, 30545], [11, 30765], [20, 31425], [27, 31745], [30, 32005], [34, 32585], [44, 33458], [47, 33591], [56, 34071], [60, 34251], [67, 35091], [73, 35749], [78, 35873], [83, 36113], [89, 36453], [92, 36713], [95, 36998]]}, {"verse": 6, "start": 37633, "end": 43982, "text": "Y si decimos, de los hombres, todo el pueblo nos apedreará: porque están ciertos que Juan era profeta.", "words": [[0, 37633], [2, 38310], [5, 38430], [14, 38910], [17, 39070], [21, 39210], [30, 39570], [35, 39885], [38, 40105], [45, 40385], [49, 40625], [60, 41709], [67, 41871], [73, 42091], [81, 42711], [85, 42811], [90, 43091], [94, 43271]]}, {"verse": 7, "start": 44262, "end": 46754, "text": "Y respondieron que no sabían de dónde.", "words": [[0, 44262], [2, 44386], [15, 45066], [19, 45286], [22, 45466], [29, 45966], [32, 46186]]}, {"verse": 8, "start": 47104, "end": 53724, "text": "Entonces Jesús les dijo: Ni yo os digo con qué autoridad hago estas cosas.", "words": [[0, 47104], [9, 47568], [15, 48468], [19, 48928], [25, 49620], [28, 49786], [31, 50026], [34, 50206], [39, 50566], [43, 50886], [47, 51186], [57, 52066], [62, 52546], [68, 52846]]}, {"verse": 9, "start": 54074, "end": 63663, "text": "Y comenzó a decir al pueblo esta parábola: Un hombre plantó una viña, y la arrendó a labradores, y se ausentó por mucho tiempo.", "words": [[0, 54074], [2, 54356], [10, 54916], [12, 54996], [18, 55276], [21, 55476], [28, 55916], [33, 56453], [43, 57168], [46, 57335], [53, 57595], [60, 58175], [64, 58315], [70, 58875], [72, 59395], [75, 59555], [83, 60275], [85, 60375], [97, 61095], [99, 61535], [102, 61735], [110, 62555], [114, 62735], [120, 62975]]}, {"verse": 10, "start": 64013, "end": 74898, "text": "Y al tiempo, envió un siervo a los labradores, para que le diesen del fruto de la viña; pero los labradores le hirieron, y le enviaron con las manos vacías.", "words": [[0, 64013], [2, 64133], [5, 64253], [13, 64633], [19, 65053], [22, 65193], [29, 65713], [31, 65793], [35, 65973], [47, 66873], [52, 67513], [56, 67693], [59, 68013], [66, 68333], [70, 68573], [76, 69173], [79, 69273], [82, 69393], [88, 70201], [93, 70344], [97, 70544], [108, 71284], [111, 71504], [121, 72124], [123, 72664], [126, 72804], [135, 73304], [139, 73524], [143, 73704], [149, 73964]]}, {"verse": 11, "start": 75248, "end": 83149, "text": "Y volvió a enviar otro siervo; pero ellos a este también, herido y humillado, le enviaron con las manos vacías.", "words": [[0, 75248], [2, 75377], [9, 75857], [11, 76017], [18, 76477], [23, 76837], [31, 77859], [36, 78099], [42, 78399], [44, 78639], [49, 78879], [58, 79599], [65, 79959], [67, 80079], [78, 81059], [81, 81139], [90, 81739], [94, 81959], [98, 82139], [104, 82379]]}, {"verse": 12, "start": 83499, "end": 88844, "text": "Y volvió a enviar al tercer siervo; pero ellos también a este echaron herido.", "words": [[0, 83499], [2, 83624], [9, 84124], [11, 84304], [18, 84844], [21, 85124], [28, 85712], [36, 86448], [41, 86614], [47, 86894], [55, 87294], [57, 87514], [62, 87894], [70, 88274]]}, {"verse": 13, "start": 89194, "end": 96568, "text": "Entonces el señor de la viña dijo: ¿Qué haré? Enviaré mi hijo amado: quizás cuando a este vean, tendrán respeto.", "words": [[0, 89194], [9, 89654], [12, 89994], [18, 90274], [21, 90494], [24, 90614], [29, 90974], [35, 91718], [40, 91834], [46, 92395], [54, 92756], [57, 92956], [62, 93156], [69, 93856], [76, 94237], [83, 94417], [85, 94677], [90, 94857], [96, 95317], [104, 95857]]}, {"verse": 14, "start": 96848, "end": 106581, "text": "Pero los labradores, viéndole, pensaron entre sí, diciendo: Este es el heredero; venid, matémosle para que la herencia sea nuestra.", "words": [[0, 96848], [5, 97013], [9, 97253], [21, 97913], [31, 99053], [40, 99733], [46, 100073], [50, 100513], [60, 102048], [65, 102336], [68, 102575], [71, 102715], [81, 103816], [88, 104186], [98, 104806], [103, 105006], [107, 105146], [110, 105286], [119, 105686], [123, 105966]]}, {"verse": 15, "start": 106861, "end": 112852, "text": "Y le echaron fuera de la viña, y le mataron. ¿Qué pues, les hará el señor de la viña?", "words": [[0, 106861], [2, 107006], [5, 107086], [13, 107506], [19, 107746], [22, 107966], [25, 108086], [31, 108606], [33, 109106], [36, 109206], [45, 110046], [50, 110251], [56, 110851], [60, 111051], [65, 111391], [68, 111531], [74, 111851], [77, 112091], [80, 112211]]}, {"verse": 16, "start": 113202, "end": 122594, "text": "Vendrá, y destruirá a estos labradores, y dará su viña a otros. Y como ellos lo oyeron, dijeron: ¡Dios nos libre!", "words": [[0, 113202], [8, 113768], [10, 114208], [20, 115028], [22, 115188], [28, 115388], [40, 116188], [42, 116568], [47, 116828], [50, 117008], [55, 117428], [57, 117648], [64, 118560], [66, 118664], [71, 118924], [77, 119244], [80, 119664], [88, 120724], [97, 121632], [103, 121849], [107, 122049]]}, {"verse": 17, "start": 122874, "end": 131523, "text": "Pero él mirándolos, dice: ¿Qué pues es lo que está escrito: La piedra que rechazaron los constructores, esta fue por cabeza de esquina?", "words": [[0, 122874], [5, 123036], [8, 123396], [20, 124076], [26, 124721], [31, 124826], [36, 125086], [39, 125446], [42, 125566], [46, 125706], [51, 125886], [60, 126851], [63, 126973], [70, 127473], [74, 127593], [85, 128273], [89, 128453], [104, 129613], [109, 129793], [113, 130013], [117, 130213], [124, 130593], [127, 130873]]}, {"verse": 18, "start": 131873, "end": 139765, "text": "Cualquiera que caiga sobre aquella piedra, será quebrantado; pero sobre el que la piedra caiga, le desmenuzará.", "words": [[0, 131873], [11, 132335], [15, 132615], [21, 132895], [27, 133195], [35, 133575], [43, 134075], [48, 134435], [61, 135752], [66, 135937], [72, 136297], [75, 136537], [79, 136737], [82, 136897], [89, 137337], [96, 137917], [99, 138517]]}, {"verse": 19, "start": 140115, "end": 151550, "text": "Y procuraban los principales sacerdotes y los escribas echarle mano en aquella hora, porque entendieron que contra ellos había dicho esta parábola: pero temieron al pueblo.", "words": [[0, 140115], [2, 140241], [13, 140941], [17, 141141], [29, 141981], [40, 142781], [42, 142901], [46, 143041], [55, 143661], [63, 144361], [68, 144721], [71, 144921], [79, 145301], [85, 145881], [92, 146181], [104, 146961], [108, 147161], [115, 147561], [121, 147841], [127, 148221], [133, 148581], [138, 148881], [148, 149972], [153, 150136], [162, 150656], [165, 150916]]}, {"verse": 20, "start": 151900, "end": 162706, "text": "Y acechándole enviaron espías que fingieran ser justos, para sorprenderle en palabras, para que le entregasen al poder y a la potestad del gobernador.", "words": [[0, 151900], [2, 152062], [14, 152902], [23, 153682], [30, 154302], [34, 154462], [44, 155062], [48, 155282], [56, 156162], [61, 156422], [74, 157382], [77, 157542], [87, 158442], [92, 158782], [96, 158922], [99, 159082], [110, 159882], [113, 160002], [119, 160402], [121, 160682], [123, 160782], [126, 160842], [135, 161332], [139, 161822]]}, {"verse": 21, "start": 163056, "end": 173392, "text": "Los cuales le preguntaron, diciendo: Maestro, sabemos que dices y enseñas bien, y que no haces distinción entre personas; sino que enseñas el camino de Dios con verdad.", "words": [[0, 163056], [4, 163184], [11, 163364], [14, 163584], [27, 164543], [37, 165657], [46, 166140], [54, 166400], [58, 166680], [64, 167040], [66, 167200], [74, 167680], [80, 167940], [82, 168440], [86, 168560], [89, 168740], [95, 169020], [106, 169680], [112, 169940], [122, 170873], [127, 171051], [131, 171231], [139, 171691], [142, 171811], [149, 172071], [152, 172351], [157, 172591], [161, 172851]]}, {"verse": 22, "start": 173742, "end": 176098, "text": "¿Nos es lícito dar tributo a César, o no?", "words": [[0, 173807], [5, 173907], [8, 174007], [15, 174427], [19, 174667], [27, 175167], [29, 175207], [36, 175627], [38, 175807]]}, {"verse": 23, "start": 176378, "end": 181334, "text": "Pero él, entendiendo la astucia de ellos, les dijo: ¿Por qué me tentáis?", "words": [[0, 176378], [5, 176543], [9, 176963], [21, 177643], [24, 177823], [32, 178303], [35, 178483], [42, 179063], [46, 179143], [52, 179883], [57, 180007], [61, 180247], [64, 180407]]}, {"verse": 24, "start": 181684, "end": 189559, "text": "Mostradme la moneda. ¿De quién tiene la imagen y la inscripción? Y respondiendo dijeron: De César.", "words": [[0, 182033], [10, 182413], [13, 182573], [21, 183536], [25, 183682], [31, 183902], [37, 184282], [40, 184482], [47, 184902], [49, 185262], [52, 185422], [65, 186769], [67, 186935], [80, 187795], [89, 188817], [92, 188960]]}, {"verse": 25, "start": 189839, "end": 196499, "text": "Entonces les dijo: Pues dad a César lo que es de César; y lo que es de Dios, a Dios.", "words": [[0, 189839], [9, 190365], [13, 190745], [19, 191582], [24, 191947], [28, 192347], [30, 192607], [36, 193107], [39, 193327], [43, 193467], [46, 193587], [49, 193687], [56, 194507], [58, 194606], [61, 194726], [65, 194846], [68, 194966], [71, 195086], [77, 195572], [79, 196056]]}, {"verse": 26, "start": 196849, "end": 205148, "text": "Y no pudieron sorprenderle en sus palabras delante del pueblo: sino que maravillados de su respuesta, callaron.", "words": [[0, 196849], [2, 196971], [5, 197071], [14, 197531], [27, 198611], [30, 198851], [34, 199011], [43, 199571], [51, 200511], [55, 200751], [63, 201669], [68, 201916], [72, 202216], [85, 203376], [88, 203536], [91, 203696], [102, 204236]]}, {"verse": 27, "start": 205498, "end": 211875, "text": "Y llegando unos de los saduceos, los cuales niegan haber resurrección, le preguntaron,", "words": [[0, 205498], [2, 205606], [11, 206106], [16, 206406], [19, 206586], [23, 206746], [33, 207806], [37, 208026], [44, 208499], [51, 208973], [57, 209446], [71, 210906], [74, 210986]]}, {"verse": 28, "start": 212225, "end": 222119, "text": "Diciendo: Maestro, Moisés nos escribió: Si el hermano de alguno muere teniendo mujer, y muere sin hijos, que su hermano se case con la viuda, y levante descendencia a su hermano.", "words": [[0, 212225], [10, 213202], [19, 213580], [26, 213960], [30, 214180], [40, 215042], [43, 215182], [46, 215322], [54, 215742], [57, 215842], [64, 216242], [70, 216502], [79, 216902], [86, 217262], [88, 217482], [94, 217742], [98, 217902], [105, 218402], [109, 218602], [112, 218742], [120, 219102], [123, 219182], [128, 219402], [132, 219642], [135, 219782], [142, 220102], [144, 220342], [152, 220722], [165, 221442], [167, 221542], [170, 221602]]}, {"verse": 29, "start": 222469, "end": 226945, "text": "Fueron, pues, siete hermanos: y el primero tomó mujer, y murió sin hijos.", "words": [[0, 222469], [8, 222689], [14, 222969], [20, 223449], [30, 224209], [32, 224310], [35, 224410], [43, 224750], [48, 225170], [55, 225550], [57, 225830], [63, 226150], [67, 226370]]}, {"verse": 30, "start": 227295, "end": 230498, "text": "Y la tomó el segundo, el cual también murió sin hijos.", "words": [[0, 227295], [2, 227399], [5, 227499], [10, 227799], [13, 227899], [22, 228679], [25, 228699], [30, 228919], [38, 229259], [44, 229739], [48, 229939]]}, {"verse": 31, "start": 230848, "end": 236524, "text": "Y la tomó el tercero: asimismo también todos siete: y murieron sin dejar descendencia.", "words": [[0, 230848], [2, 230949], [5, 231049], [10, 231349], [13, 231449], [22, 232298], [31, 232923], [39, 233366], [45, 233810], [52, 234473], [54, 234581], [63, 235001], [67, 235221], [73, 235581]]}, {"verse": 32, "start": 236874, "end": 238862, "text": "Y finalmente murió también la mujer.", "words": [[0, 236874], [2, 236979], [13, 237279], [19, 237899], [27, 238139], [30, 238379]]}, {"verse": 33, "start": 239212, "end": 244448, "text": "En la resurrección, pues, ¿mujer de cuál de ellos será? porque los siete la tuvieron por mujer.", "words": [[0, 239212], [3, 239349], [6, 239469], [20, 240269], [26, 240809], [33, 241049], [36, 241289], [41, 241469], [44, 241649], [50, 241849], [56, 242521], [63, 242706], [67, 242866], [73, 243186], [76, 243366], [85, 243766], [89, 243946]]}, {"verse": 34, "start": 244728, "end": 251614, "text": "Entonces respondiendo Jesús, les dijo: Los hijos de esta era se casan, y son dados en casamiento:", "words": [[0, 244728], [9, 245572], [22, 246192], [29, 246532], [33, 246932], [39, 247595], [43, 247705], [49, 248025], [52, 248258], [57, 248492], [61, 248725], [64, 248825], [71, 249345], [73, 249765], [77, 249925], [83, 250265], [86, 250565]]}, {"verse": 35, "start": 251964, "end": 261070, "text": "Pero los que sean tenidos por dignos de aquella era y de la resurrección de los muertos, ni se casan, ni son dados en casamiento:", "words": [[0, 251964], [5, 252128], [9, 252328], [13, 252488], [18, 252808], [26, 253328], [30, 253568], [37, 254028], [40, 254128], [48, 254588], [52, 254968], [54, 255228], [57, 255348], [60, 255488], [73, 256408], [76, 256548], [80, 256668], [89, 257208], [92, 257728], [95, 257948], [102, 258788], [105, 258988], [109, 259268], [115, 259728], [118, 260048]]}, {"verse": 36, "start": 261420, "end": 270005, "text": "Porque no pueden ya más morir: porque son iguales a los ángeles, y son hijos de Dios, cuando son hijos de la resurrección.", "words": [[0, 261420], [7, 261644], [10, 261864], [17, 262384], [20, 262664], [24, 262944], [31, 263756], [38, 264002], [42, 264262], [50, 264942], [52, 265042], [56, 265142], [65, 265722], [67, 265842], [71, 266062], [77, 266502], [80, 266722], [86, 267022], [93, 267642], [97, 268022], [103, 268502], [106, 268802], [109, 268962]]}, {"verse": 37, "start": 270355, "end": 281259, "text": "Y que los muertos hayan de resucitar, aun Moisés lo enseñó en el pasaje de la zarza, cuando llama al Señor: Dios de Abraham, y Dios de Isaac, y Dios de Jacob.", "words": [[0, 270355], [2, 270465], [6, 270565], [10, 270705], [18, 271155], [24, 271605], [27, 271725], [38, 272505], [42, 272665], [49, 273265], [52, 273805], [59, 274425], [62, 274605], [65, 274745], [72, 275285], [75, 275425], [78, 275565], [85, 276165], [92, 276545], [98, 276985], [101, 277205], [108, 277970], [113, 278216], [116, 278416], [125, 278876], [127, 279376], [132, 279576], [135, 279716], [142, 280096], [144, 280361], [149, 280561], [152, 280701]]}, {"verse": 38, "start": 281609, "end": 287201, "text": "Porque Dios no es Dios de muertos, sino de vivos: porque todos viven a él.", "words": [[0, 281609], [7, 281833], [12, 282193], [15, 282693], [18, 282953], [23, 283293], [26, 283493], [35, 284033], [40, 284553], [43, 284773], [50, 285684], [57, 285892], [63, 286192], [69, 286712], [71, 286852]]}, {"verse": 39, "start": 287551, "end": 292152, "text": "Y respondiéndole unos de los escribas, dijeron: Maestro, bien has dicho.", "words": [[0, 287551], [2, 287671], [17, 288671], [22, 288971], [25, 289151], [29, 289541], [39, 289931], [48, 290757], [57, 291346], [62, 291486], [66, 291666]]}, {"verse": 40, "start": 292432, "end": 294981, "text": "Y no se atrevieron más a preguntarle algo.", "words": [[0, 292432], [2, 292557], [5, 292697], [8, 292837], [19, 293377], [23, 293577], [25, 293737], [37, 294417]]}, {"verse": 41, "start": 295331, "end": 299213, "text": "Y él les dijo: ¿Cómo dicen que el Cristo es hijo de David?", "words": [[0, 295331], [2, 295517], [5, 295697], [9, 296017], [15, 296735], [21, 297037], [27, 297297], [31, 297577], [34, 297697], [41, 298077], [44, 298337], [49, 298537], [52, 298717]]}, {"verse": 42, "start": 299563, "end": 306889, "text": "Y el mismo David dice en el libro de los Salmos: Dijo el Señor a mi Señor: Siéntate a mi diestra,", "words": [[0, 299563], [2, 299669], [5, 299769], [11, 300069], [17, 300489], [22, 301189], [25, 301529], [28, 301749], [34, 302009], [37, 302209], [41, 302329], [49, 303417], [54, 303744], [57, 303944], [63, 304224], [65, 304524], [68, 304644], [75, 305435], [84, 306095], [86, 306235], [89, 306335]]}, {"verse": 43, "start": 307239, "end": 310811, "text": "Entre tanto que pongo tus enemigos por estrado de tus pies.", "words": [[0, 307239], [6, 307521], [12, 307961], [16, 308181], [22, 308561], [26, 308761], [35, 309301], [39, 309521], [47, 310021], [50, 310201], [54, 310361]]}, {"verse": 44, "start": 311161, "end": 314401, "text": "Así que David le llama Señor: ¿cómo pues es su hijo?", "words": [[0, 311161], [4, 311501], [8, 311681], [14, 311961], [17, 312241], [23, 312441], [30, 313255], [36, 313419], [41, 313659], [44, 313819], [47, 313979]]}, {"verse": 45, "start": 314751, "end": 317963, "text": "Y oyéndole todo el pueblo, dijo a sus discípulos:", "words": [[0, 314751], [2, 314896], [11, 315436], [16, 315676], [19, 315896], [27, 316196], [32, 316496], [34, 316756], [38, 316936]]}, {"verse": 46, "start": 318313, "end": 330499, "text": "Guardaos de los escribas, que quieren andar con ropas largas, y aman los saludos en las plazas, y las primeras sillas en las sinagogas, y los primeros asientos en las cenas;", "words": [[0, 318587], [9, 318897], [12, 319057], [16, 319177], [26, 319797], [30, 320317], [38, 320657], [44, 320977], [48, 321217], [54, 321597], [62, 322197], [64, 322617], [69, 322897], [73, 323377], [81, 324057], [84, 324304], [88, 324550], [96, 324797], [98, 325257], [102, 325417], [111, 325857], [118, 326277], [121, 326517], [125, 327115], [136, 327895], [138, 328014], [142, 328174], [151, 328774], [160, 329254], [163, 329554], [167, 329714]]}, {"verse": 47, "start": 330849, "end": 339822, "text": "Que devoran las casas de las viudas, poniendo por pretexto la larga oración: estos recibirán mayor condenación.", "words": [[0, 330849], [4, 331159], [12, 331639], [16, 331819], [22, 332279], [25, 332379], [29, 332479], [37, 333479], [46, 334139], [50, 334399], [59, 335279], [62, 335559], [68, 335959], [77, 337022], [83, 337367], [93, 338447], [99, 338787]]}]}