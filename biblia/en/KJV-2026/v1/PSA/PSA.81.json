{"book": "PSA", "chapter": 81, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 96292, "verses": [{"verse": 1, "start": 300, "end": 4695, "text": "Sing aloud to God our strength: make a joyful noise to the God of Jacob.", "words": [[0, 300], [5, 460], [11, 760], [14, 980], [18, 1240], [22, 1440], [32, 2318], [37, 2444], [39, 2584], [46, 2944], [52, 3384], [55, 3664], [59, 3784], [63, 4004], [66, 4104]]}, {"verse": 2, "start": 5145, "end": 9715, "text": "Take a psalm, and bring here the timbrel, the pleasant harp with the psaltery.", "words": [[0, 5145], [5, 5300], [7, 5490], [14, 5850], [18, 6150], [24, 6410], [29, 6670], [33, 6810], [42, 7730], [46, 7790], [55, 8170], [60, 8550], [65, 8870], [69, 9314]]}, {"verse": 3, "start": 10165, "end": 15316, "text": "Blow up the trumpet in the new moon, in the time appointed, on our solemn feast day.", "words": [[0, 10165], [5, 10336], [8, 10596], [12, 10756], [20, 11116], [23, 11336], [27, 11416], [31, 11596], [37, 12336], [40, 12476], [44, 12596], [49, 12836], [60, 13776], [63, 13896], [67, 14036], [74, 14476], [80, 14796]]}, {"verse": 4, "start": 15766, "end": 19825, "text": "For this was a statute for Israel, and a law of the God of Jacob.", "words": [[0, 15766], [4, 15868], [9, 16148], [13, 16388], [15, 16548], [23, 16908], [27, 17268], [35, 17708], [39, 18048], [41, 18388], [45, 18628], [48, 18748], [52, 18888], [56, 19128], [59, 19228]]}, {"verse": 5, "start": 20275, "end": 27450, "text": "This he ordained in Joseph for a testimony, when he went out through the land of Egypt: where I heard a language that I understood not.", "words": [[0, 20275], [5, 20511], [8, 20731], [17, 21151], [20, 21291], [27, 21631], [31, 21951], [33, 22071], [44, 22471], [49, 22871], [52, 23031], [57, 23231], [61, 23391], [69, 23631], [73, 23751], [78, 23971], [81, 24111], [88, 24950], [94, 25077], [96, 25237], [102, 25437], [104, 25537], [113, 25897], [118, 26217], [120, 26357], [131, 26717]]}, {"verse": 6, "start": 27750, "end": 32196, "text": "I removed his shoulder from the burden: his hands were delivered from the pots.", "words": [[0, 27750], [2, 27875], [10, 28195], [14, 28415], [23, 28715], [28, 28975], [32, 29095], [40, 30148], [44, 30251], [50, 30531], [55, 30711], [65, 31031], [70, 31271], [74, 31391]]}, {"verse": 7, "start": 32646, "end": 45056, "text": "You called in trouble, and I delivered you; I answered you in the secret place of thunder: I proved you at the waters of Meribah. Selah.", "words": [[0, 32646], [4, 32756], [11, 32996], [14, 33176], [23, 33456], [27, 33836], [29, 33936], [39, 34256], [44, 35268], [46, 35528], [55, 35828], [59, 36048], [62, 36168], [66, 36288], [73, 36548], [79, 36888], [82, 37048], [91, 38172], [93, 38298], [100, 38618], [104, 38898], [107, 39098], [111, 39198], [118, 39518], [121, 41283], [130, 44369]]}, {"verse": 8, "start": 45356, "end": 51195, "text": "Hear, O my people, and I will testify to you: O Israel, if you will hearken to me;", "words": [[0, 45566], [6, 45786], [8, 45866], [11, 46066], [19, 46806], [23, 46906], [25, 47066], [30, 47186], [38, 47566], [41, 47866], [46, 48873], [48, 48983], [56, 49763], [59, 49863], [63, 50003], [68, 50143], [76, 50443], [79, 50603]]}, {"verse": 9, "start": 51645, "end": 56477, "text": "There shall no strange god be in you; neither shall you worship any strange god.", "words": [[0, 51645], [6, 51746], [12, 51926], [15, 52106], [23, 52426], [27, 52726], [30, 52986], [33, 53186], [38, 54067], [46, 54306], [52, 54606], [56, 54726], [64, 55026], [68, 55306], [76, 55626]]}, {"verse": 10, "start": 56927, "end": 63140, "text": "I am the LORD your God, which brought you out of the land of Egypt: open your mouth wide, and I will fill it.", "words": [[0, 56927], [2, 57071], [5, 57151], [9, 57271], [14, 57491], [19, 57651], [24, 58451], [30, 58591], [38, 58831], [42, 59011], [46, 59151], [49, 59231], [53, 59331], [58, 59551], [61, 59671], [68, 60787], [73, 60965], [78, 61105], [84, 61305], [90, 61665], [94, 62045], [96, 62165], [101, 62285], [106, 62545]]}, {"verse": 11, "start": 63590, "end": 67944, "text": "But my people would not hearken to my voice; and Israel would none of me.", "words": [[0, 63590], [4, 63691], [7, 63811], [14, 64071], [20, 64251], [24, 64411], [32, 64751], [35, 64871], [38, 64991], [45, 66111], [49, 66251], [56, 66651], [62, 66931], [67, 67091], [70, 67251]]}, {"verse": 12, "start": 68394, "end": 73284, "text": "So I gave them up to their own hearts’ lust: and they walked in their own counsels.", "words": [[0, 68394], [3, 68512], [5, 68652], [10, 68832], [15, 69032], [18, 69172], [21, 69312], [27, 69472], [31, 69712], [39, 70132], [45, 71265], [49, 71346], [54, 71446], [61, 71726], [64, 71926], [70, 72086], [74, 72571]]}, {"verse": 13, "start": 73734, "end": 78092, "text": "Oh that my people had hearkened to me, and Israel had walked in my ways!", "words": [[0, 73831], [3, 73961], [8, 74141], [11, 74261], [18, 74581], [22, 74781], [32, 75181], [35, 75321], [39, 75501], [43, 75921], [50, 76261], [54, 76561], [61, 76841], [64, 77041], [67, 77181]]}, {"verse": 14, "start": 78542, "end": 82987, "text": "I should soon have subdued their enemies, and turned my hand against their adversaries.", "words": [[0, 78542], [2, 78653], [9, 78813], [14, 79073], [19, 79253], [27, 79753], [33, 79853], [42, 80213], [46, 80713], [53, 80933], [56, 81113], [61, 81393], [69, 81633], [75, 81833]]}, {"verse": 15, "start": 83337, "end": 89281, "text": "The haters of the LORD should have submitted themselves to him: but their time should have endured for ever.", "words": [[0, 83337], [4, 83453], [11, 83753], [14, 84033], [18, 84173], [23, 84413], [30, 84673], [35, 84873], [45, 85333], [56, 85833], [59, 86153], [64, 86786], [68, 86894], [74, 87074], [79, 87494], [86, 87754], [91, 87934], [99, 88395], [103, 88855]]}, {"verse": 16, "start": 89731, "end": 95892, "text": "He should have fed them also with the finest of the wheat: and with honey out of the rock sh