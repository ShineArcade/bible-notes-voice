{"book": "LUK", "chapter": 6, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 377659, "verses": [{"verse": 1, "start": 300, "end": 11373, "text": "And it came to pass on the second sabbath after the first, that he went through the grain fields; and his disciples plucked the heads of grain, and did eat, rubbing them in their hands.", "words": [[0, 300], [4, 434], [7, 534], [12, 714], [15, 894], [20, 1174], [23, 1394], [27, 1534], [34, 1814], [42, 2274], [48, 2694], [52, 2874], [59, 3234], [64, 3794], [67, 3914], [72, 4114], [80, 4314], [84, 4474], [90, 4754], [98, 6336], [102, 6466], [106, 6566], [116, 7086], [124, 7646], [128, 7726], [134, 7966], [137, 8126], [144, 8506], [148, 9066], [152, 9226], [157, 9886], [165, 10186], [170, 10446], [173, 10606], [179, 10766]]}, {"verse": 2, "start": 11723, "end": 17534, "text": "And certain of the Pharisees said to them, Why do you that which is not lawful to do on the sabbath days?", "words": [[0, 11723], [4, 11833], [12, 12133], [15, 12353], [19, 12473], [29, 13133], [34, 13313], [37, 13513], [43, 14088], [47, 14288], [50, 14428], [54, 14528], [59, 14868], [65, 15208], [68, 15348], [72, 15548], [79, 15928], [82, 16108], [85, 16288], [88, 16508], [92, 16608], [100, 16908]]}, {"verse": 3, "start": 17814, "end": 25840, "text": "And Jesus answering them said, Have you not read so much as this, what David did, when himself was hungry, and they which were with him;", "words": [[0, 17814], [4, 17955], [10, 18275], [20, 18855], [25, 19095], [31, 19773], [36, 19937], [40, 20077], [44, 20257], [49, 20497], [52, 20757], [57, 21037], [60, 21197], [66, 21737], [71, 21877], [77, 22177], [82, 22897], [87, 23097], [95, 23457], [99, 23757], [107, 24497], [111, 24637], [116, 24857], [122, 25097], [127, 25297], [132, 25557]]}, {"verse": 4, "start": 26190, "end": 35721, "text": "How he went into the house of God, and did take and eat the showbread, and gave also to them that were with him; which it is not lawful to eat but for the priests alone?", "words": [[0, 26190], [4, 26352], [7, 26512], [12, 26692], [17, 26892], [21, 27052], [27, 27272], [30, 27432], [35, 27752], [39, 28332], [43, 28532], [48, 28852], [52, 29092], [56, 29312], [60, 29492], [71, 29972], [75, 30392], [80, 30592], [85, 30952], [88, 31172], [93, 31392], [98, 31572], [103, 31672], [108, 31932], [113, 32408], [119, 32601], [122, 32761], [125, 32901], [129, 33101], [136, 33561], [139, 33721], [143, 34001], [147, 34241], [151, 34441], [155, 34581], [163, 34981]]}, {"verse": 5, "start": 36001, "end": 40551, "text": "And he said to them, That the Son of man is Lord also of the sabbath.", "words": [[0, 36001], [4, 36131], [7, 36251], [12, 36491], [15, 36691], [21, 37237], [26, 37361], [30, 37501], [34, 37761], [37, 37881], [41, 38181], [44, 38461], [49, 39221], [54, 39581], [57, 39921], [61, 40061]]}, {"verse": 6, "start": 40831, "end": 48491, "text": "And it came to pass also on another sabbath, that he entered into the synagogue and taught: and there was a man whose right hand was withered.", "words": [[0, 40831], [4, 40956], [7, 41036], [12, 41276], [15, 41456], [20, 41776], [25, 42196], [28, 42416], [36, 42696], [45, 43116], [50, 43401], [53, 43521], [61, 43861], [66, 44141], [70, 44301], [80, 44761], [84, 45241], [92, 46018], [96, 46125], [102, 46245], [106, 46405], [108, 46525], [112, 46785], [118, 47025], [124, 47305], [129, 47665], [133, 47905]]}, {"verse": 7, "start": 48841, "end": 56659, "text": "And the scribes and Pharisees watched him, whether he would heal on the sabbath day; that they might find an accusation against him.", "words": [[0, 48841], [4, 48987], [8, 49087], [16, 49727], [20, 49807], [30, 50547], [38, 50887], [43, 51547], [51, 51807], [54, 52047], [60, 52207], [65, 52487], [68, 52747], [72, 52867], [80, 53187], [85, 54062], [90, 54183], [95, 54363], [101, 54603], [106, 54923], [109, 55123], [120, 55883], [128, 56163]]}, {"verse": 8, "start": 57009, "end": 65906, "text": "But he knew their thoughts, and said to the man which had the withered hand, Rise up, and stand forth in the midst. And he arose and stood forth.", "words": [[0, 57009], [4, 57139], [7, 57259], [12, 57499], [18, 57699], [28, 58159], [32, 58759], [37, 59019], [40, 59179], [44, 59299], [48, 59559], [54, 59819], [58, 60059], [62, 60219], [71, 60579], [77, 61373], [82, 61602], [86, 61962], [90, 62102], [96, 62422], [102, 62822], [105, 63042], [109, 63122], [116, 63937], [120, 64062], [123, 64222], [129, 64602], [133, 65022], [139, 65282]]}, {"verse": 9, "start": 66256, "end": 75211, "text": "Then said Jesus to them, I will ask you one thing; Is it lawful on the sabbath days to do good, or to do evil? to save life, or to destroy it?", "words": [[0, 66256], [5, 66484], [10, 66764], [16, 67164], [19, 67504], [25, 68172], [27, 68296], [32, 68456], [36, 68696], [40, 68876], [44, 69116], [51, 69706], [54, 69852], [57, 69972], [64, 70432], [67, 70592], [71, 70732], [79, 71032], [84, 71412], [87, 71612], [90, 71772], [96, 72052], [99, 72452], [102, 72572], [105, 72712], [111, 73460], [114, 73564], [119, 73804], [125, 74144], [128, 74384], [131, 74504], [139, 74844]]}, {"verse": 10, "start": 75491, "end": 84239, "text": "And looking round about upon them all, he said to the man, Stretch forth your hand. And he did so: and his hand was restored whole as the other.", "words": [[0, 75491], [4, 75615], [12, 75855], [18, 76155], [24, 76455], [29, 76815], [34, 77055], [39, 77675], [42, 77795], [47, 78055], [50, 78255], [54, 78355], [59, 79027], [67, 79310], [73, 79590], [78, 79790], [84, 80578], [88, 80717], [91, 80837], [95, 81037], [99, 81741], [103, 81888], [107, 82008], [112, 82308], [116, 82488], [125, 82988], [131, 83348], [134, 83628], [138, 83828]]}, {"verse": 11, "start": 84589, "end": 90256, "text": "And they were filled with madness; and communed one with another what they might do to Jesus.", "words": [[0, 84589], [4, 84733], [9, 84873], [14, 85033], [21, 85393], [26, 85733], [35, 86763], [39, 87063], [48, 87643], [52, 87823], [57, 88143], [65, 88483], [70, 88763], [75, 88923], [81, 89143], [84, 89383], [87, 89543]]}, {"verse": 12, "start": 90606, "end": 97354, "text": "And it came to pass in those days, that he went out into a mountain to pray, and continued all night in prayer to God.", "words": [[0, 90606], [4, 90742], [7, 90842], [12, 91022], [15, 91202], [20, 91522], [23, 91762], [29, 91962], [35, 92602], [40, 92862], [43, 92962], [48, 93142], [52, 93342], [57, 93582], [59, 93742], [68, 93982], [71, 94222], [77, 94602], [81, 95022], [91, 95462], [95, 95822], [101, 96042], [104, 96242], [111, 96502], [114, 96742]]}, {"verse": 13, "start": 97704, "end": 105107, "text": "¶ And when it was day, he called to him his disciples: and of them he chose twelve, whom also he named apostles;", "words": [[2, 97704], [6, 97831], [11, 98011], [14, 98131], [18, 98271], [23, 98791], [26, 98911], [33, 99231], [36, 99471], [40, 99631], [44, 99871], [55, 101030], [59, 101168], [62, 101368], [67, 101568], [70, 101748], [76, 102068], [84, 102988], [89, 103208], [94, 103628], [97, 103888], [103, 104168]]}, {"verse": 14, "start": 105457, "end": 112023, "text": "Simon, (whom he also named Peter,) and Andrew his brother, James and John, Philip and Bartholomew,", "words": [[0, 105457], [7, 105837], [13, 106172], [16, 106352], [21, 106652], [27, 106992], [35, 107432], [39, 107777], [46, 108197], [50, 108457], [59, 108817], [65, 109457], [69, 109757], [75, 110157], [82, 110777], [86, 111057]]}, {"verse": 15, "start": 112373, "end": 117675, "text": "Matthew and Thomas, James the son of Alphæus, and Simon called Zelotes,", "words": [[0, 112373], [8, 112837], [12, 113077], [20, 113917], [26, 114357], [30, 114597], [34, 114837], [37, 115417], [46, 115997], [50, 116077], [56, 116417], [63, 117084]]}, {"verse": 16, "start": 118025, "end": 123487, "text": "And Judas the brother of James, and Judas Iscariot, which also was the traitor.", "words": [[0, 118025], [4, 118299], [10, 118609], [14, 118709], [22, 118949], [25, 119209], [32, 120109], [36, 120616], [42, 121122], [52, 121629], [58, 121909], [63, 122349], [67, 122749], [71, 122909]]}, {"verse": 17, "start": 123837, "end": 138486, "text": "¶ And he came down with them, and stood in the plain, and the company of his disciples, and a great multitude of people out of all Judæa and Jerusalem, and from the sea coast of Tyre and Sidon, which came to hear him, and to be healed of their diseases;", "words": [[2, 123837], [6, 123960], [9, 124060], [14, 124280], [19, 124560], [24, 124840], [30, 125060], [34, 125300], [40, 125540], [43, 125720], [47, 125950], [54, 126180], [58, 126540], [62, 126660], [70, 126980], [73, 127220], [77, 127340], [88, 127940], [92, 128275], [94, 128415], [100, 128615], [110, 129055], [113, 129455], [120, 129795], [124, 130035], [127, 130195], [131, 130585], [137, 130975], [141, 131115], [152, 132148], [156, 132268], [161, 132448], [165, 132608], [169, 132868], [175, 133188], [178, 133468], [183, 133948], [187, 134048], [194, 135008], [200, 135208], [205, 135488], [208, 135688], [213, 135908], [218, 136148], [222, 136668], [225, 136808], [228, 136928], [235, 137208], [238, 137428], [244, 137588]]}, {"verse": 18, "start": 138836, "end": 143126, "text": "And they that were tormented by unclean spirits: and they were healed.", "words": [[0, 138836], [4, 138983], [9, 139223], [14, 139463], [19, 139603], [29, 140183], [32, 140443], [40, 141103], [49, 141920], [53, 142180], [58, 142340], [63, 142520]]}, {"verse": 19, "start": 143476, "end": 148399, "text": "And the whole multitude sought to touch him: for there went power out of him, and healed them all.", "words": [[0, 143476], [4, 143624], [8, 143724], [14, 143984], [24, 144544], [31, 144944], [34, 145184], [40, 145444], [45, 145984], [49, 146081], [55, 146261], [60, 146481], [66, 146841], [70, 147121], [73, 147281], [78, 147421], [82, 147581], [89, 147821], [94, 148061]]}, {"verse": 20, "start": 148749, "end": 155195, "text": "¶ And he lifted up his eyes on his disciples, and said, Blessed are you poor: for yours is the kingdom of God.", "words": [[2, 148749], [6, 148872], [9, 148992], [16, 149292], [19, 149512], [23, 149672], [28, 149952], [31, 150172], [35, 150312], [46, 150812], [50, 151092], [56, 151773], [64, 152076], [68, 152456], [72, 152616], [78, 153361], [82, 153467], [88, 153747], [91, 153967], [95, 154127], [103, 154427], [106, 154667]]}, {"verse": 21, "start": 155545, "end": 162124, "text": "Blessed are you that hunger now: for you shall be filled. Blessed are you that weep now: for you shall laugh.", "words": [[0, 155545], [8, 155791], [12, 156091], [16, 156251], [21, 156451], [28, 156751], [33, 157461], [37, 157681], [41, 157841], [47, 158061], [50, 158241], [58, 159086], [66, 159306], [70, 159606], [74, 159846], [79, 160086], [84, 160426], [89, 161058], [93, 161184], [97, 161364], [103, 161584]]}, {"verse": 22, "start": 162474, "end": 172058, "text": "Blessed are you, when men shall hate you, and when they shall separate you from their company, and shall reproach you, and cast out your name as evil, for the Son of man’s sake.", "words": [[0, 162474], [8, 162746], [12, 163066], [17, 163266], [22, 163506], [26, 163806], [32, 164046], [37, 164346], [42, 164706], [46, 165066], [51, 165206], [56, 165386], [62, 165586], [71, 166006], [75, 166286], [80, 166466], [86, 166646], [95, 167366], [99, 167566], [105, 167786], [114, 168366], [119, 168846], [123, 168946], [128, 169246], [132, 169486], [137, 169626], [142, 169906], [145, 170066], [151, 170736], [155, 170815], [159, 170935], [163, 171175], [166, 171275], [172, 171755]]}, {"verse": 23, "start": 172408, "end": 180662, "text": "Rejoice in that day, and leap for joy: for, behold, your reward is great in heaven: for in the like manner did their fathers to the prophets.", "words": [[0, 172408], [8, 172913], [11, 173053], [16, 173233], [21, 173553], [25, 173853], [30, 174113], [34, 174333], [39, 175095], [44, 175472], [52, 176192], [57, 176292], [64, 176712], [67, 176892], [73, 177172], [76, 177352], [84, 178033], [88, 178132], [91, 178232], [95, 178312], [100, 178532], [107, 178832], [111, 179012], [117, 179172], [125, 179552], [128, 179792], [132, 179912]]}, {"verse": 24, "start": 181012, "end": 185191, "text": "But woe to you that are rich! for you have received your consolation.", "words": [[0, 181012], [4, 181136], [8, 181496], [11, 181596], [15, 181816], [20, 182016], [24, 182136], [30, 182876], [34, 183030], [38, 183290], [43, 183530], [52, 184010], [57, 184210]]}, {"verse": 25, "start": 185541, "end": 192438, "text": "Woe to you that are full! for you shall hunger. Woe to you that laugh now! for you shall mourn and weep.", "words": [[0, 185541], [4, 185903], [7, 186003], [11, 186243], [16, 186463], [20, 186583], [26, 187306], [30, 187423], [34, 187643], [40, 187863], [48, 188698], [52, 189041], [55, 189141], [59, 189301], [64, 189501], [70, 189781], [75, 190616], [79, 190876], [83, 191056], [89, 191276], [95, 191816], [99, 191936]]}, {"verse": 26, "start": 192788, "end": 197918, "text": "Woe to you, when all men shall speak well of you! for so did their fathers to the false prophets.", "words": [[0, 192788], [4, 193120], [7, 193220], [12, 193420], [17, 193620], [21, 193860], [25, 194140], [31, 194400], [37, 194680], [42, 194960], [45, 195160], [50, 195661], [54, 195740], [57, 195940], [61, 196080], [67, 196220], [75, 196560], [78, 196840], [82, 196960], [88, 197160]]}, {"verse": 27, "start": 198268, "end": 203476, "text": "¶ But I say to you which hear, Love your enemies, do good to them which hate you,", "words": [[2, 198268], [6, 198385], [8, 198525], [12, 198785], [15, 198985], [19, 199185], [25, 199425], [31, 200045], [36, 200405], [41, 200625], [50, 201545], [53, 201845], [58, 202105], [61, 202325], [66, 202565], [72, 202825], [77, 203045]]}, {"verse": 28, "start": 203826, "end": 207908, "text": "Bless them that curse you, and pray for them which despitefully use you.", "words": [[0, 203826], [6, 204013], [11, 204373], [16, 204613], [22, 204933], [27, 205573], [31, 205653], [36, 205913], [40, 206073], [45, 206273], [51, 206513], [64, 207213], [68, 207493]]}, {"verse": 29, "start": 208258, "end": 215766, "text": "And to him that strikes you on the one cheek offer also the other; and him that takes away your cloak forbid not to take your coat also.", "words": [[0, 208258], [4, 208380], [7, 208540], [11, 208820], [16, 209120], [24, 209460], [28, 209700], [31, 209860], [35, 209960], [39, 210200], [45, 210440], [51, 210820], [56, 211280], [60, 211540], [67, 212142], [71, 212372], [75, 212572], [80, 212812], [86, 213052], [91, 213252], [96, 213432], [102, 213692], [109, 214072], [113, 214392], [116, 214592], [121, 214772], [126, 214892], [131, 215132]]}, {"verse": 30, "start": 216116, "end": 221718, "text": "Give to every man that asks of you; and of him that takes away your goods ask them not again.", "words": [[0, 216116], [5, 216318], [8, 216518], [14, 216818], [18, 217178], [23, 217378], [28, 217678], [31, 217958], [36, 218501], [40, 218624], [43, 218784], [47, 218964], [52, 219164], [58, 219424], [63, 219704], [68, 219924], [74, 220324], [78, 220584], [83, 220864], [87, 221104]]}, {"verse": 31, "start": 222068, "end": 226341, "text": "And as you would that men should do to you, do you also to them likewise.", "words": [[0, 222068], [4, 222212], [7, 222432], [11, 222572], [17, 222812], [22, 222992], [26, 223232], [33, 223432], [36, 223652], [39, 223792], [44, 224372], [47, 224612], [51, 224732], [56, 224992], [59, 225232], [64, 225432]]}, {"verse": 32, "start": 226691, "end": 232252, "text": "For if you love them which love you, what thank have you? for sinners also love those that love them.", "words": [[0, 226691], [4, 226832], [7, 226952], [11, 227072], [16, 227312], [21, 227492], [27, 227692], [32, 227952], [37, 228532], [42, 228672], [48, 228912], [53, 229232], [58, 229797], [62, 229908], [70, 230208], [75, 230688], [80, 231028], [86, 231288], [91, 231588], [96, 231828]]}, {"verse": 33, "start": 232602, "end": 238214, "text": "And if you do good to them which do good to you, what thank have you? for sinners also do even the same.", "words": [[0, 232602], [4, 232724], [7, 232844], [11, 232944], [14, 233144], [19, 233384], [22, 233544], [27, 233844], [33, 233964], [36, 234164], [41, 234404], [44, 234564], [49, 234944], [54, 235064], [60, 235344], [65, 235624], [70, 236147], [74, 236330], [82, 236550], [87, 236990], [90, 237250], [95, 237530], [99, 237710]]}, {"verse": 34, "start": 238564, "end": 245567, "text": "And if you lend to them of whom you hope to receive, what thank have you? for sinners also lend to sinners, to receive as much again.", "words": [[0, 238564], [4, 238706], [7, 238826], [11, 238966], [16, 239186], [19, 239366], [24, 239526], [27, 239726], [32, 239906], [36, 240106], [41, 240266], [44, 240426], [53, 241386], [58, 241566], [64, 241806], [69, 242106], [74, 242653], [78, 242734], [86, 242974], [91, 243374], [96, 243634], [99, 243794], [108, 244094], [111, 244334], [119, 244674], [122, 244834], [127, 245054]]}, {"verse": 35, "start": 245917, "end": 258373, "text": "But love your enemies, and do good, and lend, hoping for nothing again; and your reward shall be great, and you shall be the children of the Highest: for he is kind to the unthankful and to the evil.", "words": [[0, 245917], [4, 246061], [9, 246261], [14, 246461], [23, 246881], [27, 247401], [30, 247621], [36, 248021], [40, 248441], [46, 249281], [53, 249541], [57, 249821], [65, 250061], [72, 250851], [76, 250993], [81, 251153], [88, 251613], [94, 251893], [97, 252073], [104, 252533], [108, 252793], [112, 252933], [118, 253113], [121, 253253], [125, 253373], [134, 253753], [137, 253953], [141, 254073], [150, 254868], [154, 255013], [157, 255213], [160, 255373], [165, 255753], [168, 256093], [172, 256193], [183, 256953], [187, 257413], [190, 257793], [194, 257933]]}, {"verse": 36, "start": 258723, "end": 261850, "text": "Be therefore merciful, as your Father also is merciful.", "words": [[0, 258723], [3, 258865], [13, 259225], [23, 260065], [26, 260205], [31, 260345], [38, 260625], [43, 261045], [46, 261285]]}, {"verse": 37, "start": 262200, "end": 269754, "text": "Judge not, and you shall not be judged: condemn not, and you shall not be condemned: forgive, and you shall be forgiven:", "words": [[0, 262200], [6, 262405], [11, 263165], [15, 263265], [19, 263425], [25, 263625], [29, 263845], [32, 264025], [40, 264819], [48, 265138], [53, 266018], [57, 266118], [61, 266298], [67, 266518], [71, 266738], [74, 266918], [85, 267811], [94, 268118], [98, 268578], [102, 268738], [108, 268938], [111, 269138]]}, {"verse": 38, "start": 270104, "end": 282006, "text": "Give, and it shall be given to you; good measure, pressed down, and shaken together, and running over, shall men give into your bosom. For with the same measure that you use it shall be measured to you again.", "words": [[0, 270104], [6, 270723], [10, 270803], [13, 270943], [19, 271103], [22, 271263], [28, 271483], [31, 271723], [36, 272363], [41, 272545], [50, 272885], [58, 273225], [64, 274005], [68, 274185], [75, 274545], [85, 275405], [89, 275485], [97, 275745], [103, 276445], [109, 276605], [113, 276845], [118, 277085], [123, 277345], [128, 277505], [135, 278232], [139, 278336], [144, 278516], [148, 278696], [153, 278956], [161, 279296], [166, 279476], [170, 279676], [174, 279996], [177, 280276], [183, 280536], [186, 280696], [195, 280996], [198, 281236], [202, 281416]]}, {"verse": 39, "start": 282286, "end": 288559, "text": "And he spoke a parable to them, Can the blind lead the blind? shall they not both fall into the ditch?", "words": [[0, 282286], [4, 282404], [7, 282484], [13, 282724], [15, 282944], [23, 283384], [26, 283564], [32, 284209], [36, 284367], [40, 284507], [46, 284927], [51, 285367], [55, 285547], [62, 286436], [68, 286599], [73, 286779], [77, 286979], [82, 287259], [87, 287579], [92, 287839], [96, 287999]]}, {"verse": 40, "start": 288909, "end": 293795, "text": "The disciple is not above his master: but every one that is perfect shall be as his master.", "words": [[0, 288909], [4, 288988], [13, 289408], [16, 289628], [20, 289768], [26, 290008], [30, 290188], [38, 291080], [42, 291187], [48, 291333], [52, 291480], [57, 291820], [60, 291920], [68, 292300], [74, 292620], [77, 292800], [80, 293000], [84, 293120]]}, {"verse": 41, "start": 294145, "end": 299804, "text": "And why do you look at the speck that is in your brother’s eye, but perceive not the beam that is in your own eye?", "words": [[0, 294145], [4, 294249], [8, 294469], [11, 294569], [15, 294669], [20, 294909], [23, 295009], [27, 295109], [33, 295489], [38, 295629], [41, 295749], [44, 295869], [49, 295969], [59, 296409], [64, 297109], [68, 297489], [77, 297889], [81, 298149], [85, 298369], [90, 298609], [95, 298829], [98, 298949], [101, 299089], [106, 299209], [110, 299409]]}, {"verse": 42, "start": 300154, "end": 315122, "text": "Either how can you say to your brother, Brother, let me pull out the speck that is in your eye, when you yourself look at not the beam that is in your own eye? You hypocrite, cast out first the beam out of your own eye, and then shall you see clearly to pull out the mote that is in your brother’s eye.", "words": [[0, 300154], [7, 300374], [11, 300594], [15, 300774], [19, 300894], [23, 301114], [26, 301254], [31, 301374], [40, 301914], [49, 302494], [53, 302594], [56, 302714], [61, 302954], [65, 303094], [69, 303254], [75, 303634], [80, 303774], [83, 303934], [86, 304074], [91, 304234], [96, 304845], [101, 304969], [105, 305109], [114, 305509], [119, 305789], [122, 305949], [126, 306169], [130, 306409], [135, 306669], [140, 306929], [143, 307089], [146, 307209], [151, 307349], [155, 307569], [160, 308189], [164, 308363], [175, 308943], [180, 309183], [184, 309443], [190, 309743], [194, 309983], [199, 310203], [203, 310403], [206, 310523], [211, 310643], [215, 310823], [220, 311443], [224, 311703], [229, 311923], [235, 312143], [239, 312303], [243, 312503], [251, 312883], [254, 313083], [259, 313303], [263, 313423], [267, 313653], [272, 313883], [277, 314003], [280, 314143], [283, 314263], [288, 314363], [298, 314823]]}, {"verse": 43, "start": 315472, "end": 321125, "text": "For a good tree brings not forth corrupt fruit; neither does a corrupt tree bring forth good fruit.", "words": [[0, 315472], [4, 315599], [6, 315779], [11, 315939], [16, 316279], [23, 316639], [27, 316919], [33, 317259], [41, 317659], [48, 318434], [56, 318721], [61, 319001], [63, 319121], [71, 319381], [76, 319741], [82, 320021], [88, 320341], [93, 320621]]}, {"verse": 44, "start": 321475, "end": 329394, "text": "For every tree is known by his own fruit. For of thorns men do not gather figs, nor of a bramble bush gather they grapes.", "words": [[0, 321475], [4, 321575], [10, 321875], [15, 322175], [18, 322395], [24, 322675], [27, 322935], [31, 323135], [35, 323375], [42, 324220], [46, 324310], [49, 324470], [56, 324950], [60, 325310], [63, 325550], [67, 325750], [74, 326050], [80, 326810], [84, 327250], [87, 327490], [89, 327610], [97, 328010], [102, 328250], [109, 328590], [114, 328790]]}, {"verse": 45, "start": 329744, "end": 341520, "text": "A good man out of the good treasure of his heart brings forth that which is good; and an evil man out of the evil treasure of his heart brings forth that which is evil: for of the abundance of the heart his mouth speaks.", "words": [[0, 329744], [2, 329844], [7, 330064], [11, 330344], [15, 330584], [18, 330704], [22, 330804], [27, 330984], [36, 331344], [39, 331564], [43, 331684], [49, 331944], [56, 332264], [62, 332644], [67, 332904], [73, 333104], [76, 333264], [82, 333921], [86, 334064], [89, 334184], [94, 334464], [98, 334884], [102, 335144], [105, 335264], [109, 335384], [114, 335644], [123, 336064], [126, 336264], [130, 336404], [136, 336704], [143, 337004], [149, 337384], [154, 337724], [160, 337944], [163, 338124], [169, 338875], [173, 338979], [176, 339159], [180, 339279], [190, 339619], [193, 339899], [197, 340039], [203, 340299], [207, 340519], [213, 340819]]}, {"verse": 46, "start": 341870, "end": 346163, "text": "¶ And why do you call me, Lord, Lord, and do not the things which I say?", "words": [[2, 341870], [6, 342013], [10, 342233], [13, 342373], [17, 342473], [22, 342753], [26, 342913], [32, 343653], [38, 344513], [42, 344573], [45, 344713], [49, 344873], [53, 345053], [60, 345313], [66, 345533], [68, 345693]]}, {"verse": 47, "start": 346513, "end": 352108, "text": "Whoever comes to me, and hears my sayings, and does them, I will show you to whom he is like:", "words": [[0, 346513], [8, 346720], [14, 347060], [17, 347300], [21, 347760], [25, 347920], [31, 348120], [34, 348380], [43, 349200], [47, 349340], [52, 349580], [58, 350140], [60, 350320], [65, 350460], [70, 350720], [74, 350940], [77, 351100], [82, 351300], [85, 351500], [88, 351640]]}, {"verse": 48, "start": 352458, "end": 364891, "text": "He is like a man which built a house, and dug deep, and laid the foundation on a rock: and when the flood arose, the stream beat vehemently upon that house, and could not shake it: for it was founded upon a rock.", "words": [[0, 352458], [3, 352585], [6, 352745], [11, 352905], [13, 353085], [17, 353365], [23, 353585], [29, 353845], [31, 354005], [38, 354365], [42, 354630], [46, 354850], [52, 355190], [56, 355650], [61, 355850], [65, 356010], [76, 356510], [79, 356770], [81, 356870], [87, 357539], [91, 357681], [96, 357861], [100, 358021], [106, 358241], [113, 359141], [117, 359241], [124, 359581], [129, 359961], [140, 360621], [145, 360861], [150, 361141], [157, 361461], [161, 361941], [167, 362141], [171, 362361], [177, 362661], [181, 363198], [185, 363322], [188, 363442], [192, 363582], [200, 363922], [205, 364202], [207, 364382]]}, {"verse": 49, "start": 365241, "end": 377259, "text": "But he that hears, and does not, is like a man that without a foundation built a house upon the earth; against which the stream did beat vehemently, and immediately it fell; and the ruin of that house was great.", "words": [[0, 365241], [4, 365363], [7, 365603], [12, 365823], [19, 366503], [23, 366763], [28, 366983], [33, 367683], [36, 367883], [41, 368083], [43, 368223], [47, 368483], [52, 368683], [60, 368903], [62, 369023], [73, 369503], [79, 369843], [81, 370003], [87, 370223], [92, 370483], [96, 370703], [103, 371181], [111, 371425], [117, 371725], [121, 371925], [128, 372265], [132, 372485], [137, 372745], [149, 373625], [153, 373685], [165, 374025], [168, 374525], [174, 375209], [178, 375330], [182, 375430], [187, 375710], [190, 375910], [195, 376090], [201, 376430], [205, 376670]]}]}