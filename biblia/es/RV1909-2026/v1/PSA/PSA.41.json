{"book": "PSA", "chapter": 41, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 91537, "verses": [{"verse": 1, "start": 300, "end": 8622, "text": "Al Músico principal: Salmo de David. BIENAVENTURADO el que piensa en el pobre: en el día malo lo librará Jehová.", "words": [[0, 300], [3, 471], [10, 991], [21, 2031], [27, 2550], [30, 2710], [37, 3940], [52, 4400], [55, 4540], [59, 4660], [66, 5200], [69, 5300], [72, 5420], [79, 6371], [82, 6522], [85, 6662], [89, 6862], [94, 7282], [97, 7402], [105, 7902]]}, {"verse": 2, "start": 8972, "end": 17671, "text": "Jehová lo guarde, y le dé vida: sea bienaventurado en la tierra, y no lo entregues a la voluntad de sus enemigos.", "words": [[0, 8972], [7, 9436], [10, 9536], [18, 10196], [20, 10496], [23, 10636], [26, 10796], [32, 12308], [36, 12862], [51, 13452], [54, 13552], [57, 13672], [65, 14092], [67, 14612], [70, 14752], [73, 14892], [83, 15612], [85, 15752], [88, 15832], [97, 16452], [100, 16592], [104, 16772]]}, {"verse": 3, "start": 18021, "end": 24529, "text": "Jehová lo sustentará sobre el lecho del dolor: arreglarás toda su cama en su enfermedad.", "words": [[0, 18021], [7, 18559], [10, 18659], [21, 19519], [27, 19839], [30, 20139], [36, 20459], [40, 20659], [47, 21476], [58, 22440], [63, 22680], [66, 22960], [71, 23340], [74, 23520], [77, 23640]]}, {"verse": 4, "start": 24879, "end": 31278, "text": "Yo dije: Jehová, ten misericordia de mí; sana mi alma, porque contra ti he pecado.", "words": [[0, 25117], [3, 25388], [9, 26070], [17, 26330], [21, 26590], [34, 27510], [37, 27610], [41, 28130], [46, 28435], [49, 28675], [55, 29295], [62, 29695], [69, 30055], [72, 30335], [75, 30595]]}, {"verse": 5, "start": 31628, "end": 36764, "text": "Mis enemigos dicen mal de mí preguntando: ¿Cuándo morirá, y perecerá su nombre?", "words": [[0, 31628], [4, 31735], [13, 32315], [19, 32655], [23, 33075], [26, 33335], [29, 33475], [42, 34653], [50, 35049], [58, 35489], [60, 35609], [69, 36129], [72, 36249]]}, {"verse": 6, "start": 37044, "end": 44686, "text": "Y si venía a verme, hablaba mentira: su corazón se amontonaba iniquidad; y salido fuera, la hablaba.", "words": [[0, 37044], [2, 37214], [5, 37314], [11, 37654], [13, 37814], [20, 38234], [28, 39034], [37, 40099], [40, 40242], [48, 40682], [51, 41042], [62, 41782], [73, 43027], [75, 43133], [82, 43533], [89, 43773], [92, 44093]]}, {"verse": 7, "start": 45036, "end": 53236, "text": "Reunidos murmuraban contra mí todos los que me aborrecían: contra mí pensaban mal, diciendo de mí:", "words": [[0, 45036], [9, 45818], [20, 46898], [27, 47318], [30, 47598], [36, 48138], [40, 48558], [44, 48738], [47, 49258], [59, 49998], [66, 50458], [69, 50658], [78, 51298], [83, 52178], [92, 52578], [95, 52938]]}, {"verse": 8, "start": 53436, "end": 58327, "text": "Cosa pestilencial de él se ha apoderado; y el que cayó en cama, no volverá a levantarse.", "words": [[0, 53436], [5, 53613], [18, 54333], [21, 54553], [24, 54713], [27, 54893], [30, 55013], [41, 55924], [43, 56008], [46, 56088], [50, 56208], [55, 56488], [58, 56588], [64, 56868], [67, 57168], [75, 57588], [77, 57588]]}, {"verse": 9, "start": 58607, "end": 66096, "text": "Aun el hombre de mi paz, en quien yo confiaba, el que de mi pan comía, se volvió contra mí.", "words": [[0, 58607], [4, 58911], [7, 59131], [14, 59371], [17, 59611], [20, 59771], [25, 60591], [28, 61011], [34, 61251], [37, 61551], [47, 62291], [50, 62991], [54, 63171], [57, 63331], [60, 63471], [64, 63771], [71, 64411], [74, 64911], [81, 65351], [88, 65691]]}, {"verse": 10, "start": 66446, "end": 72279, "text": "Mas tú, Jehová, ten misericordia de mí, y hazme levantar, y les daré el pago.", "words": [[0, 66446], [4, 66649], [8, 67219], [16, 67789], [20, 67869], [33, 68829], [36, 68989], [40, 69169], [42, 69709], [48, 70049], [58, 70749], [60, 71069], [64, 71229], [69, 71589], [72, 71709]]}, {"verse": 11, "start": 72629, "end": 77082, "text": "En esto habré conocido que te he agradado, que mi enemigo no se alegrará de mí.", "words": [[0, 72629], [3, 72893], [8, 73093], [14, 73413], [23, 73933], [27, 74053], [30, 74213], [33, 74373], [43, 74933], [47, 75093], [50, 75273], [58, 75673], [61, 75853], [64, 76073], [73, 76633], [76, 76813]]}, {"verse": 12, "start": 77432, "end": 84481, "text": "En cuanto a mí, en mi integridad me has sustentado, y me has hecho estar delante de ti para siempre.", "words": [[0, 77432], [3, 77595], [10, 77755], [12, 77995], [16, 78635], [19, 78775], [22, 78955], [33, 79715], [36, 80155], [40, 80315], [52, 81175], [54, 81515], [57, 81655], [61, 81835], [67, 82195], [73, 82435], [81, 83035], [84, 83215], [87, 83435], [92, 83695]]}, {"verse": 13, "start": 84831, "end": 91137, "text": "Bendito sea Jehová, el Dios de Israel, por siglos de siglos. Amén y Amén.", "words": [[0, 84831], [8, 85497], [12, 85777], [20, 86477], [23, 86717], [28, 87057], [31, 87337], [39, 87917], [43, 88232], [50, 88772], [53, 88952], [61, 89871], [66, 90334], [68, 90654]]}]}