{"book": "MRK", "chapter": 3, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 228628, "verses": [{"verse": 1, "start": 300, "end": 5336, "text": "And he entered again into the synagogue; and there was a man there which had a withered hand.", "words": [[0, 300], [4, 439], [7, 539], [15, 819], [21, 1219], [26, 1599], [30, 1779], [41, 2841], [45, 2968], [51, 3088], [55, 3248], [57, 3348], [61, 3628], [67, 3928], [73, 4228], [77, 4408], [79, 4488], [88, 4788]]}, {"verse": 2, "start": 5786, "end": 10409, "text": "And they watched him, whether he would heal him on the sabbath day; that they might accuse him.", "words": [[0, 5786], [4, 5912], [9, 6012], [17, 6372], [22, 6612], [30, 6872], [33, 7072], [39, 7212], [44, 7452], [48, 7652], [51, 7812], [55, 7932], [63, 8252], [68, 9091], [73, 9240], [78, 9420], [84, 9640], [91, 9960]]}, {"verse": 3, "start": 10859, "end": 14728, "text": "And he says to the man which had the withered hand, Stand forth.", "words": [[0, 10859], [4, 10995], [7, 11115], [12, 11355], [15, 11575], [19, 11715], [23, 11995], [29, 12255], [33, 12435], [37, 12575], [46, 12895], [52, 13714], [58, 14079]]}, {"verse": 4, "start": 15078, "end": 27865, "text": "And he says to them, Is it lawful to do good on the sabbath days, or to do evil? to save life, or to kill? But they kept silent.", "words": [[0, 15078], [4, 15202], [7, 15322], [12, 15542], [15, 15762], [21, 16371], [24, 16509], [27, 16629], [34, 17049], [37, 17209], [40, 17369], [45, 17629], [48, 17809], [52, 17949], [60, 18229], [66, 18889], [69, 19089], [72, 19249], [75, 19389], [81, 20218], [84, 20315], [89, 20575], [95, 20935], [98, 21175], [101, 21275], [105, 23320], [107, 24862], [111, 25000], [116, 25180], [121, 25460]]}, {"verse": 5, "start": 28315, "end": 41355, "text": "And when he had looked round about on them with anger, being grieved for the hardness of their hearts, he says to the man, Stretch forth your hand. And he stretched it out: and his hand was restored whole as the other.", "words": [[0, 28315], [4, 28440], [9, 28600], [12, 28780], [16, 28980], [23, 29240], [29, 29580], [35, 29920], [38, 30240], [43, 30420], [48, 30660], [55, 31560], [61, 31800], [69, 32340], [73, 32540], [77, 32680], [86, 32980], [89, 33300], [95, 33480], [103, 34300], [106, 34420], [111, 34680], [114, 34940], [118, 35080], [123, 35795], [131, 36078], [137, 36358], [142, 36558], [148, 37416], [152, 37543], [155, 37643], [165, 37963], [168, 38243], [173, 38993], [177, 39119], [181, 39239], [186, 39539], [190, 39719], [199, 40139], [205, 40459], [208, 40679], [212, 40879]]}, {"verse": 6, "start": 41805, "end": 48289, "text": "And the Pharisees went forth, and immediately took counsel with the Herodians against him, how they might destroy him.", "words": [[0, 41805], [4, 41933], [8, 42013], [18, 42673], [23, 42853], [30, 43593], [34, 43773], [46, 44133], [51, 44593], [59, 44993], [64, 45253], [68, 45373], [78, 45993], [86, 46273], [91, 46913], [95, 47073], [100, 47233], [106, 47433], [114, 47873]]}, {"verse": 7, "start": 48739, "end": 56119, "text": "But Jesus withdrew himself with his disciples to the sea: and a great multitude from Galilee followed him, and from Judæa,", "words": [[0, 48739], [4, 48923], [10, 49223], [19, 49823], [27, 50163], [32, 50463], [36, 50603], [46, 51083], [49, 51343], [53, 51503], [58, 52242], [62, 52385], [64, 52465], [70, 52685], [80, 53265], [85, 53545], [93, 54045], [102, 54425], [107, 55005], [111, 55205], [116, 55691]]}, {"verse": 8, "start": 56569, "end": 67398, "text": "And from Jerusalem, and from Idumaea, and from beyond Jordan; and they about Tyre and Sidon, a great multitude, when they had heard what great things he did, came to him.", "words": [[0, 56569], [4, 56734], [9, 56874], [20, 58014], [24, 58074], [29, 58744], [38, 59414], [42, 59574], [47, 59774], [54, 60094], [62, 61081], [66, 61232], [71, 61353], [77, 61702], [82, 62052], [86, 62402], [93, 62753], [95, 63272], [101, 63512], [112, 64073], [1