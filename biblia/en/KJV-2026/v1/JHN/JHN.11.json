{"book": "JHN", "chapter": 11, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 396201, "verses": [{"verse": 1, "start": 300, "end": 6479, "text": "Now a certain man was sick, named Lazarus, of Bethany, the town of Mary and her sister Martha.", "words": [[0, 300], [4, 472], [6, 652], [14, 872], [18, 1212], [22, 1452], [28, 2072], [34, 2312], [43, 3072], [46, 3212], [55, 4132], [59, 4352], [64, 4612], [67, 4752], [72, 5092], [76, 5372], [80, 5492], [87, 5792]]}, {"verse": 2, "start": 6929, "end": 14473, "text": "(It was that Mary which anointed the Lord with ointment, and wiped his feet with her hair, whose brother Lazarus was sick.)", "words": [[0, 6929], [4, 7047], [8, 7267], [13, 7527], [18, 7887], [24, 8187], [33, 8667], [37, 8887], [42, 9147], [47, 9367], [57, 10107], [61, 10407], [67, 10647], [71, 10927], [76, 11187], [81, 11447], [85, 11587], [91, 12227], [97, 12327], [105, 12667], [113, 13367], [117, 13547]]}, {"verse": 3, "start": 14923, "end": 21394, "text": "Therefore his sisters sent to him, saying, Lord, behold, he whom you love is sick.", "words": [[0, 14923], [10, 15489], [14, 15749], [22, 16009], [27, 16329], [30, 16529], [35, 16789], [43, 18466], [49, 19033], [57, 19593], [60, 19773], [65, 20013], [69, 20233], [74, 20553], [77, 20833]]}, {"verse": 4, "start": 21744, "end": 29956, "text": "When Jesus heard that, he said, This sickness is not to death, but for the glory of God, that the Son of God might be glorified by it.", "words": [[0, 21744], [5, 21873], [11, 22153], [17, 22493], [23, 22933], [26, 23033], [32, 24370], [37, 24547], [46, 24867], [49, 25127], [53, 25387], [56, 25567], [63, 25927], [67, 26047], [71, 26207], [75, 26307], [81, 26667], [84, 26867], [89, 27627], [94, 27767], [98, 27887], [102, 28107], [105, 28207], [109, 28487], [115, 28707], [118, 28887], [128, 29467], [131, 29727]]}, {"verse": 5, "start": 30306, "end": 33735, "text": "Now Jesus loved Martha, and her sister, and Lazarus.", "words": [[0, 30306], [4, 30487], [10, 30807], [16, 31247], [24, 31707], [28, 32147], [32, 32267], [40, 32627], [44, 33027]]}, {"verse": 6, "start": 34185, "end": 39569, "text": "When he had heard therefore that he was sick, he stayed two more days in the same place where he was.", "words": [[0, 34185], [5, 34313], [8, 34473], [12, 34653], [18, 34893], [28, 35313], [33, 35593], [36, 35733], [40, 35893], [46, 36613], [49, 36673], [56, 36933], [60, 37233], [65, 37473], [70, 37793], [73, 38093], [77, 38213], [82, 38413], [88, 38733], [94, 38993], [97, 39133]]}, {"verse": 7, "start": 40019, "end": 45018, "text": "Then after that says he to his disciples, Let us go into Judæa again.", "words": [[0, 40019], [5, 40250], [11, 40550], [16, 41050], [21, 41310], [24, 41610], [27, 41810], [31, 42010], [42, 43147], [46, 43330], [49, 43530], [52, 43710], [57, 44140], [63, 44570]]}, {"verse": 8, "start": 45368, "end": 52090, "text": "His disciples say to him, Master, the Jews of late sought to stone you; and are you going there again?", "words": [[0, 45368], [4, 45492], [14, 45952], [18, 46252], [21, 46412], [26, 47838], [34, 48172], [38, 48432], [43, 48732], [46, 49042], [51, 49352], [58, 49592], [61, 49792], [67, 50132], [72, 50786], [76, 50887], [80, 51007], [84, 51127], [90, 51327], [96, 51567]]}, {"verse": 9, "start": 52440, "end": 61048, "text": "Jesus answered, Are there not twelve hours in the day? If any man walk in the day, he stumbles not, because he sees the light of this world.", "words": [[0, 52440], [6, 52718], [16, 53738], [20, 53840], [26, 53960], [30, 54220], [37, 54480], [43, 54960], [46, 55260], [50, 55360], [55, 56099], [58, 56236], [62, 56456], [66, 56736], [71, 57056], [74, 57256], [78, 57356], [83, 57576], [86, 57756], [95, 58196], [100, 58676], [108, 59076], [111, 59276], [116, 59536], [120, 59816], [126, 60076], [129, 60296], [134, 60496]]}, {"verse": 10, "start": 61498, "end": 65652, "text": "But if a man walk in the night, he stumbles, because there is no light in him.", "words": [[0, 61498], [4, 61602], [7, 61722], [9, 61842], [13, 62122], [18, 62402], [21, 62582], [25, 62682], [32, 63262], [35, 63362], [45, 63882], [53, 64402], [59, 64622], [62, 64742], [65, 64922], [71, 65202], [74, 65362]]}, {"verse": 11, "start": 66002, "end": 74049, "text": "These things said he: and after that he says to them, Our friend Lazarus sleeps; but I go, that I may awake him out of sleep.", "words": [[0, 66002], [6, 66224], [13, 66584], [18, 66924], [22, 67644], [26, 67809], [32, 68089], [37, 68449], [40, 68549], [45, 68809], [48, 69029], [54, 69582], [58, 69736], [65, 70036], [73, 70616], [81, 71558], [85, 71659], [87, 71799], [91, 72079], [96, 72519], [98, 72639], [102, 72779], [108, 73159], [112, 73319], [116, 73479], [119, 73579]]}, {"verse": 12, "start": 74399, "end": 78515, "text": "Then said his disciples, Lord, if he sleep, he shall do well.", "words": [[0, 74399], [5, 74651], [10, 74971], [14, 75191], [25, 76397], [31, 76958], [34, 77018], [37, 77098], [44, 77718], [47, 77798], [53, 77998], [56, 78158]]}, {"verse": 13, "start": 78865, "end": 83936, "text": "However Jesus spoke of his death: but they thought that he had spoken of taking of rest in sleep.", "words": [[0, 78865], [8, 79365], [14, 79565], [20, 79985], [23, 80185], [27, 80325], [34, 81103], [38, 81212], [43, 81352], [51, 81612], [56, 81852], [59, 81972], [63, 82072], [70, 82372], [73, 82572], [80, 82852], [83, 83072], [88, 83312], [91, 83512]]}, {"verse": 14, "start": 84386, "end": 87660, "text": "Then said Jesus to them plainly, Lazarus is dead.", "words": [[0, 84386], [5, 84573], [10, 84773], [16, 85073], [19, 85353], [24, 85493], [33, 86413], [41, 87003], [44, 87183]]}, {"verse": 15, "start": 88110, "end": 94619, "text": "And I am glad for your sakes that I was not there, to the intent you may believe; nevertheless let us go to him.", "words": [[0, 88110], [4, 88232], [6, 88392], [9, 88492], [14, 88772], [18, 88992], [23, 89112], [29, 89512], [34, 89692], [36, 89872], [40, 90052], [44, 90252], [51, 90572], [54, 91032], [58, 91192], [65, 91552], [69, 91732], [73, 91872], [82, 92750], [95, 93566], [99, 93826], [102, 93966], [105, 94166], [108, 94326]]}, {"verse": 16, "start": 94969, "end": 101835, "text": "Then said Thomas, which is called Didymus, to his fellowdisciples, Let us also go, that we may die with him.", "words": [[0, 94969], [5, 95174], [10, 95414], [18, 95974], [24, 96094], [27, 96234], [34, 96494], [43, 97394], [46, 97674], [50, 98316], [67, 99130], [71, 99322], [74, 99482], [79, 99842], [83, 100102], [88, 100682], [91, 100862], [95, 101022], [99, 101282], [104, 101542]]}, {"verse": 17, "start": 102185, "end": 106752, "text": "Then when Jesus came, he found that he had lain in the grave four days already.", "words": [[0, 102185], [5, 102575], [10, 102695], [16, 103015], [22, 103675], [25, 103755], [31, 104055], [36, 104255], [39, 104375], [43, 104495], [48, 104795], [51, 104995], [55, 105095], [61, 105375], [66, 105735], [71, 106015]]}, {"verse": 18, "start": 107202, "end": 111708, "text": "Now Bethany was near to Jerusalem, about fifteen furlongs off:", "words": [[0, 107202], [4, 107614], [12, 108134], [16, 108374], [21, 108634], [24, 108814], [35, 109754], [41, 110184], [49, 110614], [58, 111394]]}, {"verse": 19, "start": 112158, "end": 117254, "text": "And many of the Jews came to Martha and Mary, to comfort them concerning their brother.", "words": [[0, 112158], [4, 112313], [9, 112533], [12, 112713], [16, 112853], [21, 113173], [26, 113533], [29, 113753], [36, 114113], [40, 114453], [46, 114793], [49, 115333], [57, 115653], [62, 115973], [73, 116453], [79, 116733]]}, {"verse": 20, "start": 117704, "end": 124579, "text": "Then Martha, as soon as she heard that Jesus was coming, went and met him: but Mary sat still in the house.", "words": [[0, 117704], [5, 117933], [13, 118493], [16, 118613], [21, 118853], [24, 118953], [28, 119133], [34, 119393], [39, 119533], [45, 119873], [49, 120173], [57, 120973], [62, 121173], [66, 121393], [70, 121633], [75, 122332], [79, 122499], [84, 122819], [88, 123299], [94, 123719], [97, 123919], [101, 124059]]}, {"verse": 21, "start": 125029, "end": 130382, "text": "Then said Martha to Jesus, Lord, if you had been here, my brother had not died.", "words": [[0, 125029], [5, 125272], [10, 125572], [17, 125972], [20, 126252], [27, 127229], [33, 127705], [36, 127705], [40, 127885], [44, 128045], [49, 128305], [55, 128985], [58, 129105], [66, 129385], [70, 129645], [74, 129825]]}, {"verse": 22, "start": 130832, "end": 135807, "text": "But I know, that even now, whatever you will ask of God, God will give it you.", "words": [[0, 130832], [4, 130936], [6, 131076], [12, 131316], [17, 131556], [22, 131856], [27, 132616], [36, 132896], [40, 133216], [45, 133376], [49, 133696], [52, 133856], [57, 134516], [61, 134796], [66, 135056], [71, 135276], [74, 135376]]}, {"verse": 23, "start": 136157, "end": 139941, "text": "Jesus says to her, Your brother shall rise again.", "words": [[0, 136157], [6, 136397], [11, 136737], [14, 136957], [19, 137561], [24, 137701], [32, 138021], [38, 138321], [43, 138721]]}, {"verse": 24, "start": 140291, "end": 146631, "text": "Martha says to him, I know that he shall rise again in the resurrection at the last day.", "words": [[0, 140291], [7, 140559], [12, 140879], [15, 141119], [20, 142615], [22, 142830], [27, 143110], [32, 143390], [35, 143570], [41, 143750], [46, 144110], [52, 144470], [55, 144730], [59, 144850], [72, 145370], [75, 145690], [79, 145810], [84, 146150]]}, {"verse": 25, "start": 146981, "end": 154046, "text": "Jesus said to her, I am the resurrection, and the life: he that believes in me, though he were dead, yet shall he live:", "words": [[0, 146981], [6, 147251], [11, 147591], [14, 147811], [19, 148337], [21, 148563], [24, 148783], [28, 148903], [42, 149423], [46, 149923], [50, 150043], [56, 150773], [59, 150876], [64, 151056], [73, 151356], [76, 151576], [80, 152076], [87, 152276], [90, 152416], [95, 152556], [101, 153096], [105, 153216], [111, 153456], [114, 153616]]}, {"verse": 26, "start": 154496, "end": 158235, "text": "And whoever lives and believes in me shall never die. Do you believe this?", "words": [[0, 154496], [4, 154637], [12, 154837], [18, 155217], [22, 155397], [31, 155677], [34, 155877], [37, 156037], [43, 156237], [49, 156477], [54, 157301], [57, 157385], [61, 157485], [69, 157705]]}, {"verse": 27, "start": 158585, "end": 166213, "text": "She says to him, Yes, Lord: I believe that you are the Christ, the Son of God, which should come into the world.", "words": [[0, 158585], [4, 158764], [9, 159004], [12, 159244], [17, 159833], [22, 160373], [28, 161252], [30, 161454], [38, 161754], [43, 162014], [47, 162254], [51, 162394], [55, 162494], [63, 163454], [67, 163534], [71, 163774], [74, 163894], [79, 164514], [85, 164634], [92, 164914], [97, 165214], [102, 165494], [106, 165654]]}, {"verse": 28, "start": 166563, "end": 175322, "text": "And when she had so said, she went her way, and called Mary her sister secretly, saying, The Master is come, and calls for you.", "words": [[0, 166563], [4, 166730], [9, 166910], [13, 167110], [17, 167330], [20, 167590], [26, 168110], [30, 168410], [35, 168630], [39, 168810], [44, 169170], [48, 169650], [55, 169930], [60, 170270], [64, 170470], [71, 170810], [81, 171390], [89, 172877], [93, 172975], [100, 173255], [103, 173535], [109, 173855], [113, 174275], [119, 174635], [123, 174915]]}, {"verse": 29, "start": 175672, "end": 179539, "text": "As soon as she heard that, she arose quickly, and came to him.", "words": [[0, 175672], [3, 175807], [8, 176087], [11, 176227], [15, 176367], [21, 176647], [27, 177307], [31, 177427], [37, 177727], [46, 178207], [50, 178687], [55, 178967], [58, 179207]]}, {"verse": 30, "start": 179989, "end": 185146, "text": "Now Jesus was not yet come into the town, but was in that place where Martha met him.", "words": [[0, 179989], [4, 180571], [10, 180871], [14, 181231], [18, 181471], [22, 181691], [27, 181971], [32, 182191], [36, 182351], [42, 182911], [46, 183031], [50, 183231], [53, 183391], [58, 183571], [64, 183851], [70, 184091], [77, 184431], [81, 184711]]}, {"verse": 31, "start": 185596, "end": 195776, "text": "The Jews then which were with her in the house, and comforted her, when they saw Mary, that she rose up hastily and went out, followed her, saying, She goes to the grave to weep there.", "words": [[0, 185596], [4, 185684], [9, 185964], [14, 186384], [20, 186564], [25, 186764], [30, 186984], [34, 187124], [37, 187284], [41, 187384], [48, 188144], [52, 188284], [62, 188824], [67, 189004], [72, 189204], [77, 189364], [81, 189584], [87, 189904], [92, 190164], [96, 190344], [101, 190584], [104, 190864], [112, 191344], [116, 191524], [121, 191704], [126, 192364], [135, 192704], [140, 193084], [148, 193872], [152, 194019], [157, 194219], [160, 194419], [164, 194539], [170, 194819], [173, 195059], [178, 195399]]}, {"verse": 32, "start": 196126, "end": 206012, "text": "Then when Mary was come where Jesus was, and saw him, she fell down at his feet, saying to him, Lord, if you had been here, my brother had not died.", "words": [[0, 196126], [5, 196532], [10, 196692], [15, 196952], [19, 197192], [24, 197392], [30, 197612], [36, 197912], [41, 198312], [45, 198532], [49, 198812], [54, 199412], [58, 199572], [63, 199852], [68, 200152], [71, 200312], [75, 200472], [81, 200892], [88, 201152], [91, 201432], [96, 202041], [102, 202567], [105, 202587], [109, 202787], [113, 203007], [118, 203307], [124, 204167], [127, 204367], [135, 204767], [139, 205107], [143, 205347]]}, {"verse": 33, "start": 206362, "end": 214554, "text": "When Jesus therefore saw her weeping, and the Jews also weeping which came with her, he groaned in the spirit, and was troubled,", "words": [[0, 206362], [5, 206506], [11, 206946], [21, 207486], [25, 207766], [29, 207966], [38, 208866], [42, 209026], [46, 209166], [51, 209426], [56, 209826], [64, 210346], [70, 210606], [75, 210866], [80, 211146], [85, 211786], [88, 211946], [96, 212506], [99, 212626], [103, 212766], [111, 213126], [115, 213686], [119, 213886]]}, {"verse": 34, "start": 215004, "end": 224202, "text": "And said, Where have you laid him? They said to him, Lord, come and see.", "words": [[0, 215004], [4, 215170], [10, 215946], [16, 216158], [21, 216438], [25, 216558], [30, 216798], [33, 219894], [35, 221436], [40, 221541], [45, 221781], [48, 221981], [53, 223222], [59, 223486], [64, 223746], [68, 223866]]}, {"verse": 35, "start": 224552, "end": 225451, "text": "Jesus wept.", "words": [[0, 224552], [6, 224784]]}, {"verse": 36, "start": 225901, "end": 230836, "text": "Then said the Jews, Behold how he loved him!", "words": [[0, 225901], [5, 226126], [10, 226346], [14, 226526], [20, 227379], [27, 227916], [31, 228196], [34, 228316], [40, 228536]]}, {"verse": 37, "start": 231186, "end": 238286, "text": "And some of them said, Could not this man, which opened the eyes of the blind, have caused that even this man should not have died?", "words": [[0, 231186], [4, 231331], [9, 231531], [12, 231711], [17, 231871], [23, 232667], [29, 232791], [33, 232991], [38, 233331], [43, 233891], [49, 234111], [56, 234491], [60, 234691], [65, 234951], [68, 235091], [72, 235211], [79, 235811], [84, 235931], [91, 236251], [96, 236531], [101, 236791], [106, 237051], [110, 237271], [117, 237431], [121, 237671], [126, 237851]]}, {"verse": 38, "start": 238636, "end": 244973, "text": "Jesus therefore again groaning in himself comes to the grave. It was a cave, and a stone lay upon it.", "words": [[0, 238636], [6, 238876], [16, 239376], [22, 239816], [31, 240356], [34, 240476], [42, 240896], [48, 241256], [51, 241476], [55, 241576], [62, 242466], [65, 242593], [69, 242753], [71, 242873], [77, 243273], [81, 243693], [83, 243813], [89, 244173], [93, 244453], [98, 244693]]}, {"verse": 39, "start": 245423, "end": 256812, "text": "Jesus said, Take away the stone. Martha, the sister of him that was dead, says to him, Lord, by this time he stinks: for he has been dead four days.", "words": [[0, 245423], [6, 245892], [12, 246723], [17, 246847], [22, 247087], [26, 247267], [33, 248218], [41, 248527], [45, 248767], [52, 249047], [55, 249267], [59, 249427], [64, 249587], [68, 249747], [74, 250047], [79, 250427], [82, 250647], [87, 252237], [93, 252668], [96, 252748], [101, 252988], [106, 253288], [109, 253568], [117, 254674], [121, 254774], [124, 254934], [128, 255134], [133, 255354], [138, 255634], [143, 256114]]}, {"verse": 40, "start": 257162, "end": 263797, "text": "Jesus says to her, Said I not to you, that, if you would believe, you should see the glory of God?", "words": [[0, 257162], [6, 257402], [11, 257742], [14, 257962], [19, 258566], [24, 258827], [26, 258987], [30, 259187], [33, 259427], [38, 260067], [44, 260707], [47, 260847], [51, 261007], [57, 261147], [66, 262047], [70, 262127], [77, 262287], [81, 262547], [85, 262687], [91, 263027], [94, 263227]]}, {"verse": 41, "start": 264147, "end": 272604, "text": "Then they took away the stone from the place where the dead was laid. And Jesus lifted up his eyes, and said, Father, I thank you that you have heard me.", "words": [[0, 264147], [5, 264324], [10, 264464], [15, 264704], [20, 264964], [24, 265164], [30, 265504], [35, 265844], [39, 266004], [45, 266264], [51, 266504], [55, 266644], [60, 266884], [64, 267124], [70, 267932], [74, 268075], [80, 268435], [87, 268895], [90, 269155], [94, 269335], [100, 269675], [104, 269975], [110, 270704], [118, 271167], [120, 271207], [126, 271467], [130, 271647], [135, 271807], [139, 271967], [144, 272087], [150, 272287]]}, {"verse": 42, "start": 273054, "end": 279837, "text": "And I knew that you hear me always: but because of the people which stand by I said it, that they may believe that you have sent me.", "words": [[0, 273054], [4, 273159], [6, 273299], [11, 273439], [16, 273619], [20, 273759], [25, 273979], [28, 274099], [36, 275093], [40, 275189], [48, 275509], [51, 275689], [55, 275809], [62, 276039], [68, 276269], [74, 276549], [77, 277049], [79, 277209], [84, 277449], [88, 277909], [93, 278069], [98, 278229], [102, 278389], [110, 278769], [115, 278989], [119, 279129], [124, 279269], [129, 279489]]}, {"verse": 43, "start": 280187, "end": 286133, "text": "And when he thus had spoken, he cried with a loud voice, Lazarus, come forth.", "words": [[0, 280187], [4, 280313], [9, 280493], [12, 280693], [17, 280933], [21, 281133], [29, 282113], [32, 282213], [38, 282553], [43, 282773], [45, 282893], [50, 283153], [57, 284691], [66, 285264], [71, 285484]]}, {"verse": 44, "start": 286483, "end": 297530, "text": "And he that was dead came forth, bound hand and foot with graveclothes: and his face was bound about with a cloth. Jesus says to them, Loose him, and let him go.", "words": [[0, 286483], [4, 286652], [7, 286892], [12, 287112], [16, 287272], [21, 287552], [26, 287852], [33, 288712], [39, 289052], [44, 289452], [48, 289732], [53, 290012], [58, 290680], [72, 291575], [76, 291723], [80, 291863], [85, 292163], [89, 292423], [95, 292743], [101, 293023], [106, 293303], [108, 293403], [115, 294374], [121, 294701], [126, 295061], [129, 295301], [135, 295931], [141, 296316], [146, 296456], [150, 296716], [154, 296936], [158, 297076]]}, {"verse": 45, "start": 297880, "end": 304323, "text": "Then many of the Jews which came to Mary, and had seen the things which Jesus did, believed on him.", "words": [[0, 297880], [5, 298108], [10, 298388], [13, 298608], [17, 298768], [22, 299108], [28, 299468], [33, 299728], [36, 300198], [42, 300668], [46, 300928], [50, 301068], [55, 301328], [59, 301528], [66, 301808], [72, 302068], [78, 302488], [83, 303288], [92, 303508], [95, 303868]]}, {"verse": 46, "start": 304773, "end": 309874, "text": "But some of them went their ways to the Pharisees, and told them what things Jesus had done.", "words": [[0, 304773], [4, 304916], [9, 305196], [12, 305356], [17, 305536], [22, 305736], [28, 305956], [33, 306236], [36, 306456], [40, 306596], [51, 307336], [55, 307516], [60, 307796], [65, 308036], [70, 308256], [77, 308596], [83, 308996], [87, 309296]]}, {"verse": 47, "start": 310324, "end": 316819, "text": "¶ Then gathered the chief priests and the Pharisees a council, and said, What do we? for this man does many miracles.", "words": [[2, 310324], [7, 310487], [16, 310907], [20, 311127], [26, 311367], [34, 311807], [38, 312087], [42, 312227], [52, 312827], [54, 312927], [63, 313327], [67, 313647], [73, 314368], [78, 314566], [81, 314766], [85, 315352], [89, 315489], [94, 315709], [98, 315969], [103, 316149], [108, 316469]]}, {"verse": 48, "start": 317269, "end": 324598, "text": "If we let him thus alone, all men will believe on him: and the Romans shall come and take away both our place and nation.", "words": [[0, 317269], [3, 317943], [6, 318083], [10, 318283], [14, 318463], [19, 318743], [26, 319463], [30, 319583], [34, 319803], [39, 320003], [47, 320303], [50, 320483], [55, 321185], [59, 321348], [63, 321468], [70, 321708], [76, 321988], [81, 322288], [85, 322468], [90, 322648], [95, 322868], [100, 323128], [104, 323288], [110, 323548], [114, 323748]]}, {"verse": 49, "start": 324948, "end": 332525, "text": "And one of them, named Caiaphas, being the high priest that same year, said to them, You know nothing at all,", "words": [[0, 324948], [4, 325079], [8, 325319], [11, 325439], [17, 325659], [23, 326579], [33, 327499], [39, 327839], [43, 328079], [48, 328299], [55, 328659], [60, 329019], [65, 329399], [71, 329859], [76, 329999], [79, 330199], [85, 331358], [89, 331458], [94, 331598], [102, 331918], [105, 332118]]}, {"verse": 50, "start": 332975, "end": 339111, "text": "Nor consider that it is expedient for us, that one man should die for the people, and that the whole nation perish not.", "words": [[0, 332975], [4, 333138], [13, 333558], [18, 333798], [21, 333918], [24, 334058], [34, 334678], [38, 334878], [42, 335398], [47, 335578], [51, 335778], [55, 336038], [62, 336258], [66, 336558], [70, 336718], [74, 336838], [82, 337118], [86, 337578], [91, 337718], [95, 337818], [101, 338038], [108, 338338], [115, 338718]]}, {"verse": 51, "start": 339461, "end": 346290, "text": "And this spoke he not of himself: but being high priest that year, he prophesied that Jesus should die for that nation;", "words": [[0, 339461], [4, 339608], [9, 339808], [15, 340188], [18, 340408], [22, 340608], [25, 340768], [34, 341725], [38, 341832], [44, 342072], [49, 342392], [56, 342672], [61, 342972], [67, 343372], [70, 343432], [81, 344152], [86, 344292], [92, 344632], [99, 344972], [103, 345312], [107, 345492], [112, 345692]]}, {"verse": 52, "start": 346740, "end": 354496, "text": "And not for that nation only, but that also he should gather together in one the children of God that were scattered abroad.", "words": [[0, 346740], [4, 346895], [8, 347115], [12, 347335], [17, 347555], [24, 347915], [30, 348835], [34, 348975], [39, 349135], [44, 349515], [47, 349855], [54, 350095], [61, 350375], [70, 350895], [73, 351135], [77, 351615], [81, 351695], [90, 352015], [93, 352235], [97, 352955], [102, 353175], [107, 353315], [117, 353695]]}, {"verse": 53, "start": 354946, "end": 358179, "text": "Then from that day forth they took counsel together to put him to death.", "words": [[0, 354946], [5, 355113], [10, 355293], [15, 355513], [19, 355713], [25, 356133], [30, 356213], [35, 356413], [43, 356773], [52, 357193], [55, 357413], [59, 357593], [63, 357693], [66, 357833]]}, {"verse": 54, "start": 358629, "end": 370311, "text": "Jesus therefore walked no more openly among the Jews; but went from there to a country near to the wilderness, into a city called Ephraim, and there continued with his disciples.", "words": [[0, 358629], [6, 358893], [16, 359413], [23, 359893], [26, 360173], [31, 360433], [38, 360893], [44, 361193], [48, 361433], [54, 362352], [58, 362458], [63, 362698], [68, 362958], [74, 363278], [77, 363518], [79, 363678], [87, 364098], [92, 364478], [95, 364678], [99, 364798], [111, 365698], [116, 365978], [118, 366218], [123, 366438], [130, 366738], [139, 367958], [143, 368078], [149, 368278], [159, 368878], [164, 369278], [168, 369438]]}, {"verse": 55, "start": 370761, "end": 378971, "text": "¶ And the Jews’ passover was near at hand: and many went out of the country up to Jerusalem before the passover, to purify themselves.", "words": [[2, 370761], [6, 370886], [10, 371006], [16, 371266], [25, 371806], [29, 372206], [34, 372446], [37, 372646], [43, 373487], [47, 373641], [52, 373841], [57, 374061], [61, 374261], [64, 374401], [68, 374501], [76, 374841], [79, 375061], [82, 375201], [92, 375741], [99, 376101], [103, 376341], [113, 376921], [116, 377421], [123, 378041]]}, {"verse": 56, "start": 379421, "end": 387121, "text": "Then sought they for Jesus, and spoke among themselves, as they stood in the temple, What do you think, that he will not come to the feast?", "words": [[0, 379421], [5, 379841], [12, 380181], [17, 380421], [21, 380621], [28, 381021], [32, 381621], [38, 381921], [44, 382181], [56, 382741], [59, 383081], [64, 383261], [70, 383481], [73, 383661], [77, 383741], [85, 384516], [90, 384645], [93, 384765], [97, 384865], [104, 385525], [109, 385675], [112, 385825], [117, 385945], [121, 386145], [126, 386405], [129, 386525], [133, 386645]]}, {"verse": 57, "start": 387471, "end": 395801, "text": "Now both the chief priests and the Pharisees had given a commandment, that, if any man knew where he were, he should show it, that they might take him.", "words": [[0, 387471], [4, 387669], [9, 387989], [13, 388189], [19, 388409], [27, 388809], [31, 389189], [35, 389309], [45, 389949], [49, 390069], [55, 390309], [57, 390429], [70, 391029], [76, 391629], [79, 391869], [83, 392129], [87, 392409], [92, 392609], [98, 392829], [101, 392989], [107, 393649], [110, 393749], [117, 393949], [122, 394249], [126, 394429], [131, 394809], [136, 394969], [142, 395189], [147, 395449]]}]}