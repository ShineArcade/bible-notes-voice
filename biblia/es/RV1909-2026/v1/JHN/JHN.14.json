{"book": "JHN", "chapter": 14, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 237890, "verses": [{"verse": 1, "start": 300, "end": 5485, "text": "No se turbe vuestro corazón: creéis en Dios, creed también en mí.", "words": [[0, 300], [3, 487], [6, 667], [12, 1147], [20, 1547], [29, 2589], [36, 3229], [39, 3429], [45, 3891], [51, 4353], [59, 4733], [62, 5113]]}, {"verse": 2, "start": 5835, "end": 14198, "text": "En la casa de mi Padre muchas moradas hay: de otra manera os lo hubiera dicho: voy, pues, a preparar lugar para vosotros.", "words": [[0, 5876], [3, 5996], [6, 6136], [11, 6396], [14, 6636], [17, 6776], [23, 7276], [30, 7576], [38, 8106], [43, 8810], [46, 8958], [51, 9138], [58, 9518], [61, 9718], [64, 9898], [72, 10258], [79, 11034], [84, 11219], [90, 11499], [92, 11999], [101, 12659], [107, 12939], [112, 13259]]}, {"verse": 3, "start": 14548, "end": 21751, "text": "Y si me voy, y os preparo lugar, vendré otra vez y los llevaré conmigo. Así ustedes estarán donde yo esté.", "words": [[0, 14548], [2, 14655], [5, 14775], [8, 14935], [13, 15195], [15, 15455], [18, 15555], [26, 16015], [33, 16335], [40, 17135], [45, 17395], [49, 17775], [51, 18045], [55, 18315], [63, 18775], [72, 19713], [76, 20013], [84, 20313], [92, 20913], [98, 21093], [101, 21333]]}, {"verse": 4, "start": 22101, "end": 25464, "text": "Y sabéis a dónde yo voy; y sabéis el camino.", "words": [[0, 22101], [2, 22381], [9, 22688], [11, 22994], [17, 23301], [20, 23501], [25, 24103], [27, 24225], [34, 24665], [37, 24825]]}, {"verse": 5, "start": 25815, "end": 31528, "text": "Le dice Tomás: Señor, no sabemos a dónde vas: ¿cómo, pues, podemos saber el camino?", "words": [[0, 25815], [3, 25967], [8, 26227], [15, 27125], [22, 27767], [25, 27867], [33, 28227], [35, 28507], [41, 28667], [46, 29466], [53, 29662], [59, 30242], [67, 30482], [73, 30802], [76, 30962]]}, {"verse": 6, "start": 31808, "end": 38806, "text": "Jesús le dice: Yo soy el camino, y la verdad, y la vida: nadie viene al Padre, sino por mí.", "words": [[0, 31808], [6, 32141], [9, 32501], [15, 33214], [18, 33423], [22, 33663], [25, 33903], [33, 34423], [35, 34678], [38, 34818], [46, 35178], [48, 35618], [51, 35758], [57, 36486], [63, 36911], [69, 37171], [72, 37391], [79, 37751], [84, 38111], [88, 38411]]}, {"verse": 7, "start": 39156, "end": 46409, "text": "Si me conocieseis, también a mi Padre conocierais: y desde ahora le conocéis, y le habéis visto.", "words": [[0, 39156], [3, 39536], [6, 39966], [19, 40396], [27, 40876], [29, 41176], [32, 41316], [38, 42115], [51, 43108], [53, 43254], [59, 43434], [65, 43814], [68, 44014], [78, 44734], [80, 45294], [83, 45434], [90, 45734]]}, {"verse": 8, "start": 46759, "end": 50582, "text": "Le dice Felipe: Señor, muéstranos el Padre, y nos basta.", "words": [[0, 46759], [3, 46904], [8, 47204], [16, 48299], [23, 48541], [34, 49081], [37, 49241], [44, 49801], [46, 49941], [50, 50041]]}, {"verse": 9, "start": 50862, "end": 62030, "text": "Jesús le dice: ¿Tanto tiempo ha que estoy con vosotros, y no me has conocido, Felipe? El que me ha visto, ha visto al Padre; ¿cómo, pues, dices tú: Muéstranos el Padre?", "words": [[0, 50862], [6, 51196], [9, 51556], [15, 52268], [22, 52530], [29, 52840], [32, 53150], [36, 53250], [42, 53470], [46, 53770], [56, 54310], [58, 54550], [61, 54710], [64, 54870], [68, 55010], [78, 55690], [86, 56519], [89, 56609], [93, 56729], [96, 56869], [99, 56969], [106, 57609], [109, 57789], [115, 58049], [118, 58229], [125, 59053], [132, 59215], [138, 59895], [144, 60235], [148, 60816], [159, 61385], [162, 61485]]}, {"verse": 10, "start": 62380, "end": 72947, "text": "¿No crees que yo soy en el Padre, y el Padre en mí? Las palabras que yo os hablo, no las hablo de mí mismo: pero el Padre que está en mí, él hace las obras.", "words": [[0, 62380], [4, 62488], [10, 62828], [14, 63028], [17, 63228], [21, 63528], [24, 63728], [27, 63848], [34, 64288], [36, 64523], [39, 64663], [45, 65003], [48, 65383], [52, 65988], [56, 66117], [65, 66457], [69, 66777], [72, 67057], [75, 67237], [82, 67897], [85, 67997], [89, 68197], [95, 68597], [98, 68717], [101, 68877], [108, 69745], [113, 69887], [116, 70027], [122, 70447], [126, 70687], [131, 70907], [134, 71107], [138, 71747], [141, 71887], [146, 72287], [150, 72507]]}, {"verse": 11, "start": 73297, "end": 80169, "text": "Creedme que yo soy en el Padre, y el Padre en mí: de otra manera, creedme por las mismas obras.", "words": [[0, 73547], [8, 73797], [12, 73937], [15, 74097], [19, 74337], [22, 74517], [25, 74637], [32, 75077], [34, 75557], [37, 75697], [43, 76017], [46, 76297], [50, 76888], [53, 76978], [58, 77158], [66, 78078], [74, 78578], [78, 78858], [82, 79038], [89, 79438]]}, {"verse": 12, "start": 80519, "end": 90293, "text": "De cierto, de cierto os digo: El que en mí cree, las obras que yo hago también él las hará; y mayores que estas hará; porque yo voy al Padre.", "words": [[0, 80747], [3, 81007], [11, 81267], [14, 81527], [21, 81787], [24, 81987], [30, 82687], [33, 82869], [37, 83069], [40, 83309], [43, 83409], [49, 83789], [53, 84184], [59, 84724], [63, 84984], [66, 85204], [71, 85384], [79, 85804], [82, 86164], [86, 86484], [92, 87148], [94, 87393], [102, 87833], [106, 88033], [112, 88293], [118, 88902], [125, 89107], [128, 89347], [132, 89507], [135, 89687]]}, {"verse": 13, "start": 90643, "end": 97901, "text": "Y todo lo que pidáis al Padre en mi nombre, lo haré, para que el Padre sea glorificado en el Hijo.", "words": [[0, 90643], [2, 90761], [7, 91061], [10, 91361], [14, 91521], [21, 91981], [24, 92201], [30, 92761], [33, 92981], [36, 93181], [44, 93961], [47, 94181], [53, 94681], [58, 95241], [62, 95441], [65, 95601], [71, 96021], [75, 96221], [87, 97161], [90, 97281], [93, 97421]]}, {"verse": 14, "start": 98251, "end": 101262, "text": "Si algo pidáis en mi nombre, yo lo haré.", "words": [[0, 98251], [3, 98451], [8, 98781], [15, 99111], [18, 99351], [21, 99551], [29, 100371], [32, 100611], [35, 100831]]}, {"verse": 15, "start": 101612, "end": 104897, "text": "Si me amáis, guardad mis mandamientos;", "words": [[0, 101697], [3, 101817], [6, 101937], [13, 102957], [21, 103557], [25, 103717]]}, {"verse": 16, "start": 105247, "end": 111231, "text": "Y yo rogaré al Padre, y os dará otro Consolador, para que esté con vosotros para siempre:", "words": [[0, 105247], [2, 105247], [5, 105554], [12, 106194], [15, 106314], [22, 106874], [24, 107294], [27, 107474], [32, 107794], [37, 108134], [49, 108954], [54, 109214], [58, 109394], [63, 109554], [67, 109834], [76, 110294], [81, 110514]]}, {"verse": 17, "start": 111581, "end": 122157, "text": "Al Espíritu de verdad, al cual el mundo no puede recibir, porque no le ve, ni le conoce: pero vosotros le conocéis; porque está con vosotros, y será en vosotros.", "words": [[0, 111581], [3, 111745], [12, 112365], [15, 112465], [23, 112845], [26, 113210], [31, 113450], [34, 113770], [40, 114070], [43, 114370], [49, 114650], [58, 115270], [65, 115850], [68, 116110], [71, 116250], [75, 116470], [78, 116950], [81, 117130], [89, 118066], [94, 118350], [103, 118790], [106, 118990], [116, 120013], [123, 120177], [128, 120377], [132, 120597], [142, 121057], [144, 121217], [149, 121437], [152, 121597]]}, {"verse": 18, "start": 122507, "end": 125463, "text": "No os dejaré huérfanos: vendré a vosotros.", "words": [[0, 122507], [3, 122768], [6, 122888], [13, 123308], [24, 124148], [31, 124593], [33, 124693]]}, {"verse": 19, "start": 125813, "end": 133917, "text": "Aun un poquito, y el mundo no me verá más; pero vosotros me veréis; porque yo vivo, y vosotros también viviréis.", "words": [[0, 125860], [4, 126120], [7, 126500], [16, 126920], [18, 127340], [21, 127480], [27, 127780], [30, 128060], [33, 128220], [38, 128520], [43, 129213], [48, 129354], [57, 129814], [60, 130014], [68, 130787], [75, 131010], [78, 131250], [84, 131550], [86, 131795], [95, 132295], [103, 132735]]}, {"verse": 20, "start": 134267, "end": 140748, "text": "En aquel día vosotros conoceréis que yo estoy en mi Padre, y vosotros en mí, y yo en vosotros.", "words": [[0, 134267], [3, 134415], [9, 134735], [13, 134955], [22, 135515], [33, 136275], [37, 136435], [40, 136615], [46, 136855], [49, 137115], [52, 137275], [59, 137695], [61, 138275], [70, 138755], [73, 138995], [77, 139235], [79, 139615], [82, 139815], [85, 139935]]}, {"verse": 21, "start": 141098, "end": 152207, "text": "El que tiene mis mandamientos, y los guarda, aquel es el que me ama; y el que me ama, será amado de mi Padre, y yo le amaré, y me manifestaré a él.", "words": [[0, 141098], [3, 141226], [7, 141366], [13, 141686], [17, 141906], [31, 142786], [33, 143246], [37, 143386], [45, 144126], [51, 144446], [54, 144666], [57, 145046], [61, 145186], [64, 145346], [69, 146035], [71, 146178], [74, 146278], [78, 146418], [81, 146618], [86, 146858], [91, 147458], [97, 148158], [100, 148318], [103, 148458], [110, 149318], [112, 149418], [115, 149618], [118, 149798], [125, 150658], [127, 150698], [130, 150838], [142, 151638], [144, 151778]]}, {"verse": 22, "start": 152557, "end": 159197, "text": "Le dice Judas, no el Iscariote: Señor, ¿por qué te has de manifestar a nosotros, y no al mundo?", "words": [[0, 152557], [3, 152683], [8, 152943], [15, 153723], [18, 154123], [21, 154563], [32, 155694], [39, 156309], [44, 156409], [48, 156529], [51, 156709], [55, 156829], [58, 156929], [69, 157529], [71, 157609], [81, 157949], [83, 158449], [86, 158589], [89, 158709]]}, {"verse": 23, "start": 159477, "end": 169131, "text": "Respondió Jesús, y le dijo: El que me ama, mi palabra guardará; y mi Padre le amará, y vendremos a él, y haremos con él morada.", "words": [[0, 159477], [10, 160032], [17, 160352], [19, 160612], [22, 160732], [28, 161453], [31, 161597], [35, 161737], [38, 161937], [43, 162557], [46, 162677], [54, 163057], [64, 164184], [66, 164307], [69, 164427], [75, 164907], [78, 165047], [85, 165487], [87, 165927], [97, 166447], [99, 166687], [103, 166967], [105, 167487], [113, 167887], [117, 168207], [120, 168367]]}, {"verse": 24, "start": 169481, "end": 177642, "text": "El que no me ama, no guarda mis palabras: y la palabra que habéis oído, no es mía, sino del Padre que me envió.", "words": [[0, 169481], [3, 169612], [7, 169752], [10, 169932], [13, 170112], [18, 170852], [21, 171092], [28, 171552], [32, 171692], [42, 172817], [44, 172920], [47, 173040], [55, 173380], [59, 173660], [66, 173980], [72, 174360], [75, 174600], [78, 174760], [83, 175440], [88, 175800], [92, 176080], [98, 176740], [102, 176880], [105, 177060]]}, {"verse": 25, "start": 177992, "end": 181292, "text": "Estas cosas os he hablado estando con vosotros.", "words": [[0, 177992], [6, 178372], [12, 178732], [15, 179112], [18, 179392], [26, 179972], [34, 180412], [38, 180652]]}, {"verse": 26, "start": 181642, "end": 193741, "text": "Pero el Consolador, el Espíritu Santo, al cual el Padre enviará en mi nombre, él os enseñará todas las cosas, y os recordará todas las cosas que os he dicho.", "words": [[0, 181642], [5, 181825], [8, 181965], [20, 182965], [23, 183085], [32, 183705], [39, 184665], [42, 184805], [47, 184985], [50, 185165], [56, 185805], [64, 186485], [67, 186665], [70, 186825], [78, 187865], [81, 188125], [84, 188445], [93, 189225], [99, 189505], [103, 189805], [110, 190225], [112, 190865], [115, 190985], [125, 191725], [131, 192045], [135, 192325], [141, 192685], [145, 192925], [148, 193105], [151, 193225]]}, {"verse": 27, "start": 194091, "end": 202911, "text": "La paz os dejo, mi paz os doy: no como el mundo la da, yo os la doy. No se turbe vuestro corazón, ni tenga miedo.", "words": [[0, 194091], [3, 194215], [7, 194435], [10, 194595], [16, 195475], [19, 195735], [23, 196035], [26, 196175], [31, 196868], [34, 197054], [39, 197294], [42, 197474], [48, 197754], [51, 197974], [55, 198594], [58, 198894], [61, 199054], [64, 199214], [69, 199865], [72, 200011], [75, 200151], [81, 200611], [89, 200991], [98, 201491], [101, 201971], [107, 202291]]}, {"verse": 28, "start": 203261, "end": 215373, "text": "Habéis oído cómo yo os he dicho: Voy, y vengo a vosotros. Si me amaseis, ciertamente os gozaríais, porque he dicho que voy al Padre: porque el Padre mayor es que yo.", "words": [[0, 203261], [7, 203585], [12, 203925], [17, 204225], [20, 204438], [23, 204652], [26, 204865], [33, 205957], [38, 206342], [40, 206567], [46, 206847], [48, 206947], [58, 207902], [61, 208087], [64, 208307], [73, 209007], [85, 209647], [88, 209867], [99, 211007], [106, 211267], [109, 211527], [115, 211847], [119, 212047], [123, 212227], [126, 212407], [133, 213332], [140, 213672], [143, 213832], [149, 214252], [155, 214544], [158, 214837], [162, 215129]]}, {"verse": 29, "start": 215723, "end": 221499, "text": "Y ahora os lo he dicho antes que se haga; para que cuando se haga, creáis.", "words": [[0, 215723], [2, 215953], [8, 216213], [11, 216513], [14, 216673], [17, 216773], [23, 217053], [29, 217453], [33, 217653], [36, 217833], [42, 218565], [47, 218730], [51, 218870], [58, 219130], [61, 219470], [67, 220230]]}, {"verse": 30, "start": 221849, "end": 228608, "text": "Ya no hablaré mucho con vosotros: porque viene el príncipe de este mundo; pero no tiene nada en mí.", "words": [[0, 221849], [3, 221992], [6, 222172], [14, 222552], [20, 222852], [24, 223132], [34, 224184], [41, 224368], [47, 224688], [50, 224968], [59, 225688], [62, 225888], [67, 226088], [74, 226994], [79, 227138], [82, 227338], [88, 227578], [93, 227898], [96, 228158]]}, {"verse": 31, "start": 228958, "end": 237490, "text": "Pero para que conozca el mundo que amo al Padre, y como el Padre me dio el mandamiento, así hago. Levantaos, vamos de aquí.", "words": [[0, 228958], [5, 229142], [10, 229662], [14, 229842], [22, 230382], [25, 230502], [31, 230782], [35, 231062], [39, 231362], [42, 231542], [49, 232142], [51, 232322], [56, 232562], [59, 232722], [65, 233262], [68, 233402], [72, 233622], [75, 233782], [88, 234462], [92, 234822], [98, 235651], [109, 236599], [115, 236859], [118, 237019]]}]}