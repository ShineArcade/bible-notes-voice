{"book": "PSA", "chapter": 59, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 132851, "verses": [{"verse": 1, "start": 300, "end": 15423, "text": "Al Músico principal: sobre No destruyas: Michtam de David, cuando envió Saúl, y guardaron la casa para matarlo. LÍBRAME de mis enemigos, oh Dios mío: ponme en salvo de los que contra mí se levantan.", "words": [[0, 300], [3, 489], [10, 989], [21, 2093], [27, 2457], [30, 2897], [41, 4525], [49, 4785], [52, 5005], [59, 5845], [66, 6185], [72, 6585], [78, 7225], [80, 7525], [90, 8085], [93, 8245], [98, 8565], [103, 8845], [112, 9851], [120, 10316], [123, 10476], [127, 10616], [137, 11086], [140, 11556], [145, 11716], [150, 12419], [156, 12803], [159, 12963], [165, 13523], [168, 13803], [172, 13943], [176, 14123], [183, 14483], [186, 14683], [189, 14843]]}, {"verse": 2, "start": 15773, "end": 21021, "text": "Líbrame de los que obran iniquidad, y sálvame de hombres sanguinarios.", "words": [[0, 15773], [8, 16602], [11, 16842], [15, 16982], [19, 17262], [25, 17542], [36, 18442], [38, 18627], [46, 19167], [49, 19387], [57, 19707]]}, {"verse": 3, "start": 21371, "end": 30000, "text": "Porque he aquí están acechando mi vida: se han juntado contra mí fuertes, no por falta mía, ni pecado mío, oh Jehová.", "words": [[0, 21675], [7, 22015], [10, 22055], [15, 22555], [21, 22815], [31, 23415], [34, 23615], [40, 24386], [43, 24545], [47, 24705], [55, 25265], [62, 25545], [65, 25825], [74, 26745], [77, 26885], [81, 27105], [87, 27425], [92, 27845], [95, 28265], [102, 28685], [107, 29140], [110, 29595]]}, {"verse": 4, "start": 30350, "end": 36127, "text": "Sin delito mío corren y se preparan: despierta para venir a mi encuentro, y mira.", "words": [[0, 30350], [4, 30556], [11, 30976], [15, 31376], [22, 31896], [24, 32136], [27, 32316], [37, 33822], [47, 34222], [52, 34422], [58, 34702], [60, 34862], [63, 34962], [74, 35582], [76, 35722]]}, {"verse": 5, "start": 36477, "end": 49004, "text": "Y tú, Jehová Dios de los ejércitos, Dios de Israel, despierta para castigar a todas las naciones: no hayas misericordia de todos los que se rebelan con iniquidad. (Selah.)", "words": [[0, 36477], [2, 36620], [6, 37200], [13, 37700], [18, 37900], [21, 38120], [25, 38260], [36, 39480], [41, 39720], [44, 39980], [52, 40820], [62, 41840], [67, 42210], [76, 42580], [78, 42720], [84, 42940], [88, 43240], [98, 44318], [101, 44463], [107, 44883], [120, 45723], [123, 45883], [129, 46103], [133, 46383], [137, 46543], [140, 46933], [148, 47323], [152, 47463], [163, 48780]]}, {"verse": 6, "start": 49354, "end": 54660, "text": "Se volverán a la tarde, ladrarán como perros, y rodearán la ciudad.", "words": [[0, 49354], [3, 49498], [12, 50038], [14, 50118], [17, 50218], [24, 50958], [33, 51498], [38, 51718], [46, 52538], [48, 53098], [57, 53798], [60, 53938]]}, {"verse": 7, "start": 55010, "end": 60715, "text": "He aquí proferirán con su boca; cuchillos están en sus labios, porque dicen: ¿Quién oye?", "words": [[0, 55143], [3, 55313], [8, 55813], [19, 56313], [23, 56473], [26, 56693], [32, 57353], [42, 57813], [48, 58133], [51, 58333], [55, 58473], [63, 58853], [70, 59233], [77, 60083], [84, 60303]]}, {"verse": 8, "start": 60995, "end": 66645, "text": "Mas tú, Jehová, te reirás de ellos, te burlarás de todas las naciones.", "words": [[0, 60995], [4, 61161], [8, 61741], [16, 62641], [19, 62841], [26, 63281], [29, 63461], [36, 64301], [39, 64521], [48, 65181], [51, 65321], [57, 65541], [61, 65781]]}, {"verse": 9, "start": 66645, "end": 70747, "text": "De su fuerza esperaré yo en ti: porque Dios es mi defensa.", "words": [[0, 66645], [3, 66845], [6, 66985], [13, 67705], [22, 68185], [25, 68405], [28, 68585], [32, 69123], [39, 69309], [44, 69629], [47, 69829], [50, 69969]]}, {"verse": 10, "start": 71097, "end": 77205, "text": "El Dios de mi misericordia saldrá a mi encuentro: Dios me hará ver en mis enemigos mi deseo.", "words": [[0, 71097], [3, 71472], [8, 71672], [11, 71852], [14, 71972], [27