{"book": "ROM", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 230574, "verses": [{"verse": 1, "start": 300, "end": 5874, "text": "Verdad digo en Cristo, no miento, dándome testimonio mi conciencia en el Espíritu Santo,", "words": [[0, 300], [7, 591], [12, 891], [15, 1091], [23, 1911], [26, 1991], [34, 2891], [42, 3271], [53, 3931], [56, 4031], [67, 4651], [70, 4791], [73, 4891], [82, 5391]]}, {"verse": 2, "start": 6224, "end": 9200, "text": "Que tengo gran tristeza y continuo dolor en mi corazón.", "words": [[0, 6224], [4, 6285], [10, 6485], [15, 6745], [24, 7385], [26, 7465], [35, 7985], [41, 8265], [44, 8425], [47, 8525]]}, {"verse": 3, "start": 9550, "end": 15451, "text": "Porque deseara yo mismo ser apartado de Cristo por mis hermanos, los que son mis parientes según la carne;", "words": [[0, 9550], [7, 9960], [15, 10370], [18, 10530], [24, 10770], [28, 11050], [37, 11550], [40, 11710], [47, 12030], [51, 12290], [55, 12430], [65, 13330], [69, 13510], [73, 13650], [77, 13810], [81, 13970], [91, 14490], [97, 14770], [100, 14950]]}, {"verse": 4, "start": 15801, "end": 22974, "text": "Que son israelitas, de los cuales es la adopción, y la gloria, y el pacto, y la entrega de la ley, y el culto, y las promesas;", "words": [[0, 15801], [4, 15896], [8, 16076], [20, 16776], [23, 16956], [27, 17076], [34, 17336], [37, 17636], [40, 17796], [50, 18336], [52, 18616], [55, 18736], [63, 19216], [65, 19436], [68, 19556], [75, 20096], [77, 20216], [80, 20316], [88, 20716], [91, 20776], [94, 20896], [99, 21136], [101, 21376], [104, 21496], [111, 21976], [113, 22096], [117, 22236]]}, {"verse": 5, "start": 23324, "end": 31914, "text": "Cuyos son los padres, y de los cuales es Cristo según la carne, el cual es Dios sobre todas las cosas, bendito por los siglos. Amén.", "words": [[0, 23324], [6, 23663], [10, 23803], [14, 23923], [22, 24303], [24, 24723], [27, 24823], [31, 24943], [38, 25223], [41, 25583], [48, 25983], [54, 26283], [57, 26483], [64, 27343], [67, 27403], [72, 27643], [75, 27843], [80, 28083], [86, 28383], [92, 28663], [96, 28963], [103, 29343], [111, 30363], [115, 30563], [119, 30723], [127, 31489]]}, {"verse": 6, "start": 32264, "end": 38495, "text": "Pero no es que la palabra de Dios haya faltado: porque no todos los que son de Israel son israelitas;", "words": [[0, 32264], [5, 32422], [8, 32602], [11, 32802], [15, 32922], [18, 33062], [26, 33402], [29, 33602], [34, 33862], [39, 34242], [48, 35220], [55, 35442], [58, 35662], [64, 36002], [68, 36282], [72, 36462], [76, 36702], [79, 36822], [86, 37142], [90, 37542]]}, {"verse": 7, "start": 38845, "end": 46286, "text": "Ni por ser simiente de Abraham, son todos hijos; pero: En Isaac te será llamada descendencia.", "words": [[0, 38845], [3, 38966], [7, 39126], [11, 39346], [20, 39866], [23, 40046], [32, 40466], [36, 40986], [42, 41286], [49, 42171], [55, 43039], [58, 43199], [64, 43609], [67, 44019], [72, 44279], [80, 44819]]}, {"verse": 8, "start": 46506, "end": 54522, "text": "Quiere decir: No los que son hijos de la carne, estos son los hijos de Dios; sino que los que son hijos de la promesa, son contados como descendientes.", "words": [[0, 46506], [7, 46682], [14, 47442], [17, 47581], [21, 47721], [25, 47841], [29, 48041], [35, 48241], [38, 48381], [41, 48481], [48, 48981], [54, 49201], [58, 49441], [62, 49561], [68, 49781], [71, 50001], [77, 50689], [82, 50873], [86, 51033], [90, 51153], [94, 51293], [98, 51453], [104, 51693], [107, 51833], [110, 51913], [119, 52433], [123, 52793], [132, 53313], [137, 53513]]}, {"verse": 9, "start": 54872, "end": 61551, "text": "Porque la palabra de la promesa es esta: Como en este tiempo vendré, y tendrá Sara un hijo.", "words": [[0, 54872], [7, 55076], [10, 55256], [18, 55596], [21, 55756], [24, 55856], [32, 56396], [35, 56696], [41, 57565], [46, 57762], [49, 57902], [54, 58102], [61, 58542], [69, 59122], [71, 59602], [78, 60062], [83, 60442], [86, 60822]]}, {"verse": 10, "start": 61771, "end": 67303, "text": "Y no solo esto, sino que también a Rebeca, habiendo concebido de uno, de Isaac nuestro padre,", "words": [[0, 61771], [2, 61873], [5, 61973], [10, 62193], [16, 62873], [21, 63033], [25, 63173], [33, 63453], [35, 63613], [43, 64273], [52, 64613], [62, 65193], [65, 65353], [70, 65993], [73, 66253], [79, 66513], [87, 66713]]}, {"verse": 11, "start": 67653, "end": 77839, "text": "(Porque no siendo aún nacidos, ni habiendo hecho aún ni bien ni mal, para que el propósito de Dios conforme a la elección, no por las obras sino por el que llama, permaneciese;)", "words": [[0, 67653], [8, 67819], [11, 68019], [18, 68299], [22, 68559], [31, 69199], [34, 69679], [43, 70059], [49, 70359], [53, 70619], [56, 70819], [61, 71099], [64, 71279], [69, 71599], [74, 72159], [78, 72299], [81, 72419], [91, 72939], [94, 73059], [99, 73259], [108, 73799], [110, 73859], [113, 73919], [123, 74830], [126, 74955], [130, 75155], [134, 75295], [140, 75595], [145, 76035], [149, 76255], [152, 76355], [156, 76475], [163, 76815]]}, {"verse": 12, "start": 78189, "end": 80498, "text": "Le fue dicho que el mayor serviría al menor.", "words": [[0, 78189], [3, 78309], [7, 78469], [13, 78769], [17, 78969], [20, 79069], [26, 79349], [35, 79969], [38, 80089]]}, {"verse": 13, "start": 80848, "end": 84628, "text": "Como está escrito: A Jacob amé, mas a Esaú aborrecí.", "words": [[0, 80848], [5, 80992], [10, 81152], [19, 81965], [21, 82103], [27, 82343], [32, 82803], [36, 83043], [38, 83223], [43, 83803]]}, {"verse": 14, "start": 84848, "end": 88804, "text": "¿Pues qué diremos? ¿Que hay injusticia en Dios? En ninguna manera.", "words": [[0, 84848], [6, 84993], [10, 85133], [19, 85983], [24, 86085], [28, 86265], [39, 86905], [42, 87105], [48, 87835], [51, 87956], [59, 88216]]}, {"verse": 15, "start": 89154, "end": 96882, "text": "Pero a Moisés dice: Tendré misericordia del que tendré misericordia, y me compadeceré del que me compadeceré.", "words": [[0, 89154], [5, 89275], [7, 89415], [14, 89715], [20, 90593], [27, 90915], [40, 91875], [44, 92035], [48, 92215], [55, 92615], [69, 93575], [71, 94015], [74, 94135], [86, 95175], [90, 95375], [94, 95535], [97, 95675]]}, {"verse": 16, "start": 97102, "end": 101590, "text": "Así que no es del que quiere, ni del que corre, sino de Dios que tiene misericordia.", "words": [[0, 97102], [4, 97277], [8, 97417], [11, 97597], [14, 97737], [18, 97837], [22, 97997], [30, 98357], [33, 98717], [37, 98877], [41, 98977], [48, 99697], [53, 99857], [56, 100037], [61, 100297], [65, 100497], [71, 100697]]}, {"verse": 17, "start": 101940, "end": 111341, "text": "Porque la Escritura dice de Faraón: Que para esto mismo te he levantado, para mostrar en ti mi poder, y que mi nombre sea anunciado por toda la tierra.", "words": [[0, 101940], [7, 102107], [10, 102267], [20, 102787], [25, 103007], [28, 103437], [36, 104033], [40, 104114], [45, 104354], [50, 104654], [56, 105014], [59, 105314], [62, 105414], [73, 106134], [78, 106714], [86, 107154], [89, 107434], [92, 107614], [95, 107754], [102, 108154], [104, 108339], [108, 108439], [111, 108599], [118, 108899], [122, 109219], [132, 109879], [136, 110099], [141, 110319], [144, 110519]]}, {"verse": 18, "start": 111561, "end": 116952, "text": "De manera que Dios tiene misericordia de quien él quiere; y endurece a quien él quiere endurecer.", "words": [[0, 111561], [3, 111666], [10, 111866], [14, 112146], [19, 112346], [25, 112786], [38, 113646], [41, 113766], [47, 113966], [50, 114126], [58, 114884], [60, 114985], [69, 115485], [71, 115625], [77, 115765], [80, 115945], [87, 116225]]}, {"verse": 19, "start": 117302, "end": 122190, "text": "Me dirás pues: ¿Por qué, pues, se enoja? porque ¿quién resistirá a su voluntad?", "words": [[0, 117302], [3, 117405], [9, 117665], [15, 118440], [20, 118561], [25, 118641], [31, 118721], [34, 119101], [41, 120141], [48, 120351], [55, 120611], [65, 121331], [67, 121411], [70, 121511]]}, {"verse": 20, "start": 122540, "end": 129802, "text": "Pero antes, oh hombre, ¿quién eres tú, para que disputes con Dios? Dirá el vaso de barro al que le labró: ¿Por qué me has hecho tal?", "words": [[0, 122540], [5, 122682], [12, 122932], [15, 123182], [23, 123762], [30, 123982], [35, 124162], [39, 124402], [44, 124622], [48, 124762], [57, 125382], [61, 125562], [67, 126309], [72, 126606], [75, 126706], [80, 127046], [83, 127146], [89, 127506], [92, 127626], [96, 127766], [99, 127866], [106, 128587], [111, 128726], [115, 128866], [118, 129006], [122, 129146], [128, 129346]]}, {"verse": 21, "start": 130152, "end": 136429, "text": "¿O no tiene potestad el alfarero para hacer de la misma masa un vaso para honra, y otro para vergüenza?", "words": [[0, 130152], [3, 130269], [6, 130529], [12, 130789], [21, 131049], [24, 131309], [33, 131789], [38, 132009], [44, 132309], [47, 132449], [50, 132569], [56, 132829], [61, 133269], [64, 133629], [69, 134009], [74, 134229], [81, 134849], [83, 135169], [88, 135409], [93, 135709]]}, {"verse": 22, "start": 136779, "end": 145161, "text": "¿Y qué, si Dios, queriendo mostrar la ira y dar a conocer su poder, soportó con mucha paciencia los vasos de ira preparados para muerte,", "words": [[0, 136779], [3, 136874], [8, 137014], [11, 137194], [17, 138074], [27, 138514], [35, 138934], [38, 139174], [42, 139574], [44, 139754], [48, 139914], [50, 139994], [58, 140414], [61, 140634], [68, 141434], [76, 141894], [80, 142074], [86, 142334], [96, 142894], [100, 143074], [106, 143474], [109, 143594], [113, 143834], [124, 144374], [129, 144574]]}, {"verse": 23, "start": 145511, "end": 152764, "text": "Y para hacer notorias las riquezas de su gloria, las mostró para con los vasos de misericordia que él ha preparado para gloria;", "words": [[0, 145511], [2, 145629], [7, 145849], [13, 146149], [22, 146709], [26, 146869], [35, 147389], [38, 147549], [41, 147709], [49, 148269], [53, 148749], [60, 149209], [65, 149449], [69, 149669], [73, 149829], [79, 150209], [82, 150309], [95, 151089], [99, 151249], [102, 151429], [105, 151509], [115, 152009], [120, 152209]]}, {"verse": 24, "start": 153114, "end": 159518, "text": "Los cuales también ha llamado, es decir, a nosotros, no sólo de los judíos, sino también de los Gentiles?", "words": [[0, 153114], [4, 153218], [11, 153458], [19, 153838], [22, 154058], [31, 154478], [34, 154918], [41, 155378], [43, 155678], [53, 156418], [56, 156578], [61, 156798], [64, 156958], [68, 157078], [76, 157858], [81, 158098], [89, 158438], [92, 158578], [96, 158718]]}, {"verse": 25, "start": 159868, "end": 166801, "text": "Como también en Oseas dice: Llamaré al que no era mi pueblo, pueblo mío; y a la no amada, amada.", "words": [[0, 159868], [5, 160011], [13, 160331], [16, 160661], [22, 160991], [28, 161649], [36, 162117], [39, 162277], [43, 162437], [46, 162617], [50, 162797], [53, 162977], [61, 163537], [68, 163897], [73, 164842], [75, 164968], [77, 165048], [80, 165128], [83, 165348], [90, 166008]]}, {"verse": 26, "start": 167021, "end": 174290, "text": "Y será, que en el lugar donde les fue dicho: Vosotros no sois pueblo mío: allí serán llamados hijos del Dios viviente.", "words": [[0, 167021], [2, 167125], [8, 167325], [12, 167565], [15, 167725], [18, 167825], [24, 168065], [30, 168265], [34, 168485], [38, 168665], [45, 169378], [54, 169856], [57, 170056], [62, 170336], [69, 170556], [74, 171514], [79, 171838], [85, 172118], [94, 172658], [100, 172958], [104, 173298], [109, 173538]]}, {"verse": 27, "start": 174640, "end": 182349, "text": "También Isaías clama tocante a Israel: Aunque sea el número de los hijos de Israel como la arena del mar, el remanente será salvo:", "words": [[0, 174640], [8, 174941], [15, 175561], [21, 176041], [29, 176271], [31, 176501], [39, 177394], [46, 177596], [50, 177896], [53, 178056], [60, 178256], [63, 178496], [67, 178636], [73, 178856], [76, 179076], [83, 179396], [88, 179696], [91, 179876], [97, 180136], [101, 180356], [106, 180956], [109, 181036], [119, 181536], [124, 181796]]}, {"verse": 28, "start": 182699, "end": 189648, "text": "Porque el Señor cumplirá su palabra por completo y sin demora en justicia; porque ejecutará prontamente su palabra sobre la tierra.", "words": [[0, 182699], [7, 182927], [10, 183027], [16, 183267], [25, 183847], [28, 183967], [36, 184307], [40, 184547], [49, 185007], [51, 185207], [55, 185457], [62, 185707], [65, 185827], [75, 186805], [82, 187012], [92, 187552], [104, 188112], [107, 188292], [115, 188672], [121, 188932], [124, 189112]]}, {"verse": 29, "start": 189998, "end": 200325, "text": "Y como antes dijo Isaías: Si el Señor de los ejércitos no nos hubiera dejado descendencia, como Sodoma habríamos venido a ser, y a Gomorra fuéramos semejantes.", "words": [[0, 189998], [2, 190096], [7, 190296], [13, 190576], [18, 190896], [26, 191933], [29, 192072], [32, 192192], [38, 192472], [41, 192692], [45, 192832], [55, 193492], [58, 193752], [62, 193952], [70, 194292], [77, 194712], [91, 195532], [96, 196072], [103, 196612], [113, 197032], [120, 197392], [122, 197552], [127, 197792], [129, 198119], [131, 198445], [139, 198772], [148, 199392]]}, {"verse": 30, "start": 200675, "end": 208961, "text": "¿Pues qué diremos? Que los Gentiles que no seguían justicia, han alcanzado la justicia, es decir, la justicia que es por la fe;", "words": [[0, 200675], [6, 200814], [10, 200954], [19, 201796], [23, 201881], [27, 202021], [36, 202521], [40, 202741], [43, 202881], [51, 203281], [61, 204021], [65, 204601], [75, 205261], [78, 205401], [88, 206341], [91, 206441], [98, 207301], [101, 207401], [110, 207981], [114, 208141], [117, 208301], [121, 208481], [124, 208621]]}, {"verse": 31, "start": 209311, "end": 213684, "text": "Pero Israel que seguía la ley de justicia, no ha llegado a la ley de justicia.", "words": [[0, 209311], [5, 209459], [12, 209859], [16, 210059], [23, 210419], [26, 210539], [30, 210759], [33, 210859], [43, 211879], [46, 211999], [49, 212119], [57, 212499], [59, 212599], [62, 212659], [66, 212859], [69, 212979]]}, {"verse": 32, "start": 214034, "end": 221057, "text": "¿Por qué? Porque la seguían no por fe, sino como por las obras de la ley: por lo cual tropezaron en la piedra de tropiezo,", "words": [[0, 214034], [5, 214152], [10, 214742], [17, 214923], [20, 215083], [28, 215523], [31, 215703], [35, 215903], [39, 216383], [44, 216683], [49, 216903], [53, 217103], [57, 217283], [63, 217543], [66, 217743], [69, 217883], [74, 218432], [78, 218560], [81, 218680], [86, 218960], [97, 219660], [100, 219800], [103, 219900], [110, 220260], [113, 220360]]}, {"verse": 33, "start": 221407, "end": 230174, "text": "Como está escrito: He aquí pongo en Sion piedra de tropiezo, y piedra de caída; y aquel que cree en ella, no será avergonzado.", "words": [[0, 221407], [5, 221571], [10, 221771], [19, 222673], [22, 222763], [27, 222983], [33, 223263], [36, 223543], [41, 223823], [48, 224403], [51, 224503], [61, 225203], [63, 225483], [70, 225923], [73, 226043], [80, 227045], [82, 227164], [88, 227444], [92, 227564], [97, 227864], [100, 228064], [106, 228304], [109, 228684], [114, 228924]]}]}