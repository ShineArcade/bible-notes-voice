{"book": "MAT", "chapter": 12, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 416726, "verses": [{"verse": 1, "start": 300, "end": 10094, "text": "En aquel tiempo iba Jesús por los sembrados en sábado; y sus discípulos tenían hambre, y comenzaron a arrancar espigas, y a comer.", "words": [[0, 300], [3, 455], [9, 755], [16, 1095], [20, 1455], [26, 1895], [30, 2435], [34, 2635], [44, 3375], [47, 3575], [55, 4549], [57, 4834], [61, 4994], [72, 5594], [79, 5974], [87, 6694], [89, 7214], [100, 7834], [102, 8034], [111, 8574], [120, 9274], [122, 9474], [124, 9614]]}, {"verse": 2, "start": 10544, "end": 17360, "text": "Y viéndolo los fariseos, le dijeron: He aquí tus discípulos hacen lo que no es lícito hacer en sábado.", "words": [[0, 10544], [2, 11052], [11, 11532], [15, 11732], [25, 12392], [28, 12532], [37, 13609], [40, 13699], [45, 13919], [49, 14199], [60, 14799], [66, 15219], [69, 15419], [73, 15559], [76, 15759], [79, 15899], [86, 16319], [92, 16619], [95, 16799]]}, {"verse": 3, "start": 17710, "end": 24156, "text": "Y él les dijo: ¿No habéis leído qué hizo David, teniendo él hambre y los que con él estaban:", "words": [[0, 17710], [2, 17878], [5, 18018], [9, 18218], [15, 19089], [19, 19277], [26, 19677], [32, 20057], [36, 20257], [41, 20537], [48, 21217], [57, 21757], [60, 21937], [67, 22517], [69, 22917], [73, 23037], [77, 23197], [81, 23377], [84, 23497]]}, {"verse": 4, "start": 24606, "end": 35120, "text": "Cómo entró en la casa de Dios, y comió los panes consagrados, que no le era lícito comer, ni a los que estaban con él, sino a solos los sacerdotes?", "words": [[0, 24606], [5, 24810], [11, 25230], [14, 25350], [17, 25470], [22, 25730], [25, 25970], [31, 26290], [33, 26570], [39, 27030], [43, 27210], [49, 27650], [62, 28770], [66, 28850], [69, 29070], [72, 29270], [76, 29470], [83, 29950], [90, 30890], [93, 31010], [95, 31090], [99, 31210], [103, 31350], [111, 31630], [115, 31990], [119, 32530], [124, 32770], [126, 33130], [132, 33730], [136, 34070]]}, {"verse": 5, "start": 35570, "end": 43178, "text": "O ¿no habéis leído en la ley, que los sábados en el templo los sacerdotes profanan el sábado, y son sin culpa?", "words": [[0, 35570], [2, 35676], [6, 35796], [13, 36136], [19, 36556], [22, 36696], [25, 36816], [30, 37096], [34, 37356], [38, 37536], [46, 38036], [49, 38236], [52, 38396], [59, 38936], [63, 39076], [74, 39876], [83, 40776], [86, 40996], [94, 41636], [96, 41996], [100, 42196], [104, 42436]]}, {"verse": 6, "start": 43628, "end": 46480, "text": "Pues os digo que uno mayor que el templo está aquí.", "words": [[0, 43628], [5, 43750], [8, 43890], [13, 44130], [17, 44350], [21, 44510], [27, 44930], [31, 45130], [34, 45270], [41, 45750], [46, 45910]]}, {"verse": 7, "start": 46930, "end": 53816, "text": "Pero si supieseis qué es: Misericordia quiero y no sacrificio, no condenaríais a los inocentes:", "words": [[0, 46930], [5, 47077], [8, 47277], [18, 47917], [22, 48177], [26, 49607], [39, 49937], [46, 50267], [48, 50367], [51, 50487], [63, 51467], [66, 52007], [79, 52547], [81, 52667], [85, 52827]]}, {"verse": 8, "start": 54266, "end": 57445, "text": "Porque Señor es del sábado el Hijo del hombre.", "words": [[0, 54266], [7, 54546], [13, 54946], [16, 55326], [20, 55526], [27, 56126], [30, 56386], [35, 56666], [39, 56846]]}, {"verse": 9, "start": 57895, "end": 61883, "text": "Y partiéndose de allí, vino a la sinagoga de ellos.", "words": [[0, 57895], [2, 58122], [14, 58802], [17, 59002], [23, 59762], [28, 60202], [30, 60462], [33, 60522], [42, 61102], [45, 61302]]}, {"verse": 10, "start": 62333, "end": 74149, "text": "Y he aquí había allí uno que tenía una mano atrofiada: y le preguntaron, diciendo: ¿Es lícito curar en sábado? por acusarle.", "words": [[0, 62333], [2, 62407], [5, 62517], [10, 62957], [16, 63397], [21, 63817], [25, 64217], [29, 64417], [35, 64737], [39, 65037], [44, 65357], [55, 66599], [57, 66687], [60, 66787], [73, 67527], [83, 68978], [87, 69146], [94, 69486], [100, 69886], [103, 70006], [111, 73141], [115, 73663]]}, {"verse": 11, "start": 74599, "end": 84166, "text": "Y él les dijo: ¿Qué hombre habrá de vosotros, que tenga una oveja, y si esta cae en una fosa en sábado, no le eche mano, y la levante?", "words": [[0, 74599], [2, 74767], [5, 74907], [9, 75107], [15, 75978], [20, 76102], [27, 76482], [33, 76842], [36, 76942], [46, 77542], [50, 77982], [56, 78302], [60, 78522], [67, 79362], [69, 79442], [72, 79542], [77, 79812], [81, 80082], [84, 80222], [88, 80382], [93, 80702], [96, 80882], [104, 81862], [107, 81962], [110, 82122], [115, 82402], [121, 82782], [123, 83112], [126, 83442]]}, {"verse": 12, "start": 84616, "end": 90292, "text": "Pues ¿cuánto más vale un hombre que una oveja? Así que, lícito es en los sábados hacer bien.", "words": [[0, 84616], [5, 84616], [13, 85177], [17, 85337], [22, 85617], [25, 85817], [32, 86057], [36, 86277], [40, 86457], [47, 87406], [51, 87730], [56, 88110], [63, 88490], [66, 88690], [69, 88850], [73, 88990], [81, 89490], [87, 89750]]}, {"verse": 13, "start": 90742, "end": 99073, "text": "Entonces dijo a aquel hombre: Extiende tu mano. Y él la extendió, y fue restaurada sana como la otra.", "words": [[0, 90742], [9, 91173], [14, 91373], [16, 91573], [22, 91933], [30, 92751], [39, 93276], [42, 93436], [48, 94293], [50, 94469], [53, 94689], [56, 94949], [66, 96029], [68, 96609], [72, 96809], [83, 97589], [88, 97969], [93, 98309], [96, 98509]]}, {"verse": 14, "start": 99523, "end": 104113, "text": "Y salidos los fariseos, consultaron contra él para destruirle.", "words": [[0, 99523], [2, 99791], [10, 100251], [14, 100451], [24, 101131], [36, 101931], [43, 102291], [46, 102551], [51, 102791]]}, {"verse": 15, "start": 104563, "end": 111558, "text": "Pero sabiéndolo Jesús, se apartó de allí: y le siguió mucha gente, y sanaba a todos.", "words": [[0, 104563], [5, 104904], [16, 105524], [23, 105944], [26, 106464], [33, 107064], [36, 107244], [42, 108114], [44, 108238], [47, 108378], [54, 108798], [60, 109018], [67, 109538], [69, 110218], [76, 110678], [78, 110878]]}, {"verse": 16, "start": 112008, "end": 115747, "text": "Y él les ordenaba estrictamente que no le descubriesen:", "words": [[0, 112008], [2, 112151], [5, 112291], [9, 112571], [18, 113271], [32, 114191], [36, 114351], [39, 114511], [42, 114651]]}, {"verse": 17, "start": 116197, "end": 120522, "text": "Para que se cumpliese lo que estaba dicho por el profeta Isaías, que dijo:", "words": [[0, 116197], [5, 116414], [9, 116534], [12, 116674], [22, 117334], [25, 117514], [29, 117634], [36, 117874], [42, 118214], [46, 118494], [49, 118614], [57, 119134], [65, 119714], [69, 119994]]}, {"verse": 18, "start": 120772, "end": 130704, "text": "He aquí mi siervo, al cual he escogido; mi Amado, en el cual se agrada mi alma: pondré mi Espíritu sobre él, y a los Gentiles anunciará juicio.", "words": [[0, 120817], [3, 120897], [8, 121137], [11, 121297], [19, 122097], [22, 122197], [27, 122377], [30, 122597], [40, 123839], [43, 123975], [50, 124415], [53, 124655], [56, 124715], [61, 124955], [64, 125175], [71, 125475], [74, 125655], [80, 126633], [87, 126952], [90, 127072], [99, 127592], [105, 127832], [109, 128092], [111, 128412], [113, 128492], [117, 128592], [126, 129132], [136, 129832]]}, {"verse": 19, "start": 131154, "end": 136339, "text": "No contenderá, ni voceará: ni nadie oirá en las calles su voz.", "words": [[0, 131154], [3, 131313], [15, 132033], [18, 132608], [27, 133745], [30, 133928], [36, 134328], [41, 134808], [44, 134928], [48, 135048], [55, 135508], [58, 135608]]}, {"verse": 20, "start": 136789, "end": 143091, "text": "La caña cascada no quebrará, y la mecha que humea no apagará, hasta que saque a victoria el juicio.", "words": [[0, 136789], [3, 136928], [8, 137248], [16, 137808], [19, 137988], [29, 138548], [31, 139008], [34, 139148], [40, 139408], [44, 139588], [50, 139968], [53, 140128], [62, 140708], [68, 141168], [72, 141348], [78, 141688], [80, 141768], [89, 142208], [92, 142308]]}, {"verse": 21, "start": 143541, "end": 146230, "text": "Y en su nombre esperarán los Gentiles.", "words": [[0, 143541], [2, 143665], [5, 143745], [8, 143925], [15, 144525], [25, 145145], [29, 145245]]}, {"verse": 22, "start": 146580, "end": 155770, "text": "Entonces fue traído a él un endemoniado, ciego y mudo, y le sanó; de tal manera, que el ciego y mudo hablaba y veía.", "words": [[0, 146580], [9, 147126], [13, 147926], [20, 148426], [22, 148566], [25, 148746], [28, 149066], [41, 150346], [47, 150746], [49, 150886], [55, 151286], [57, 151466], [60, 151586], [66, 152437], [69, 152583], [73, 152803], [81, 153263], [85, 153543], [88, 153683], [94, 154083], [96, 154223], [101, 154603], [109, 155043], [111, 155163]]}, {"verse": 23, "start": 156220, "end": 161360, "text": "Y toda la gente estaba atónita y decía: ¿Será este aquel Hijo de David?", "words": [[0, 156220], [2, 156329], [7, 156509], [10, 156749], [16, 157049], [23, 157469], [31, 158409], [33, 158709], [40, 159624], [46, 159983], [51, 160263], [57, 160603], [62, 160783], [65, 160943]]}, {"verse": 24, "start": 161710, "end": 170074, "text": "Pero los fariseos, al oírlo, decían: Este no echa fuera los demonios, sino por Beelzebú, príncipe de los demonios.", "words": [[0, 161710], [5, 161854], [9, 162074], [19, 162854], [22, 163034], [29, 163614], [37, 164982], [42, 165206], [45, 165426], [50, 165626], [56, 165826], [60, 166066], [70, 166906], [75, 167206], [79, 167776], [89, 168346], [98, 168986], [101, 169146], [105, 169286]]}, {"verse": 25, "start": 170424, "end": 182727, "text": "Y Jesús, como sabía los pensamientos de ellos, les dijo: Todo reino dividido contra sí mismo, es desolado; y toda ciudad o casa dividida contra sí misma, no permanecerá.", "words": [[0, 170424], [2, 170537], [9, 171117], [14, 171237], [20, 171637], [24, 171777], [37, 172417], [40, 172637], [47, 173037], [51, 173137], [57, 173936], [62, 174116], [68, 174776], [77, 175416], [84, 175716], [87, 175976], [94, 176296], [97, 176536], [107, 177746], [109, 177866], [114, 178026], [121, 178366], [123, 178666], [128, 178946], [137, 179626], [144, 179946], [147, 180186], [154, 180586], [157, 181106]]}, {"verse": 26, "start": 183177, "end": 191669, "text": "Y si Satanás echa fuera a Satanás, contra sí mismo está dividido; ¿cómo, pues, permanecerá su reino?", "words": [[0, 183177], [2, 183284], [5, 183404], [13, 184064], [18, 184404], [24, 184664], [26, 184904], [35, 185664], [42, 186464], [45, 186744], [51, 187084], [56, 187364], [66, 189160], [73, 189160], [79, 189160], [91, 189980], [94, 190220]]}, {"verse": 27, "start": 192119, "end": 200187, "text": "Y si yo por Beelzebú echo fuera los demonios, ¿vuestros hijos por quién los echan? Por tanto, ellos serán vuestros jueces.", "words": [[0, 192119], [2, 192119], [5, 192119], [8, 192119], [12, 192582], [21, 193062], [26, 193542], [32, 193882], [36, 194102], [46, 195042], [56, 195542], [62, 195822], [66, 196202], [72, 196522], [76, 196782], [83, 197833], [87, 197957], [94, 198297], [100, 198697], [106, 199197], [115, 199497]]}, {"verse": 28, "start": 200637, "end": 207126, "text": "Y si por espíritu de Dios yo echo fuera los demonios, ciertamente ha llegado a vosotros el reino de Dios.", "words": [[0, 200637], [2, 200767], [5, 200847], [9, 201087], [18, 201687], [21, 201787], [26, 202427], [29, 202607], [34, 202787], [40, 203087], [44, 203307], [54, 204127], [66, 204807], [69, 204947], [77, 205327], [79, 205427], [88, 205757], [91, 206087], [97, 206467], [100, 206607]]}, {"verse": 29, "start": 207576, "end": 218227, "text": "Porque, ¿cómo puede alguno entrar en la casa del hombre fuerte, y saquear sus bienes, si primero no ata al hombre fuerte? y entonces saqueará su casa.", "words": [[0, 207576], [8, 207818], [14, 208118], [20, 208438], [27, 208918], [34, 209238], [37, 209458], [40, 209598], [45, 209878], [49, 210078], [56, 210378], [64, 210878], [66, 211198], [74, 211778], [78, 211978], [86, 212638], [89, 212958], [97, 213438], [100, 213758], [104, 214098], [107, 214338], [114, 214618], [122, 215746], [124, 215890], [133, 216370], [142, 217450], [145, 217610]]}, {"verse": 30, "start": 218677, "end": 224122, "text": "El que no es conmigo, contra mí es; y el que conmigo no recoge, derrama.", "words": [[0, 218677], [3, 218816], [7, 218956], [10, 219116], [13, 219216], [22, 219856], [29, 220276], [32, 220596], [36, 221409], [38, 221514], [41, 221614], [45, 221734], [53, 222214], [56, 222374], [64, 223248]]}, {"verse": 31, "start": 224572, "end": 233694, "text": "Por tanto os digo: Todo pecado y blasfemia será perdonado a los hombres: pero la blasfemia contra el Espíritu no será perdonada a los hombres.", "words": [[0, 224572], [4, 224757], [10, 224977], [13, 225197], [19, 225969], [24, 226113], [31, 226653], [33, 226733], [43, 227353], [48, 227633], [58, 228273], [60, 228373], [64, 228493], [73, 229418], [78, 229543], [81, 229723], [91, 230383], [98, 230743], [101, 231003], [110, 231623], [113, 231723], [118, 231983], [128, 232683], [130, 232843], [134, 232943]]}, {"verse": 32, "start": 234144, "end": 246960, "text": "Y cualquiera que hable contra el Hijo del hombre, le será perdonado: pero cualquiera que hable contra el Espíritu Santo, no le será perdonado, ni en este siglo, ni en el venidero.", "words": [[0, 234144], [2, 234434], [13, 235014], [17, 235215], [23, 235534], [30, 235914], [33, 236175], [38, 236455], [42, 236634], [50, 237034], [53, 237634], [58, 237914], [69, 239074], [74, 239217], [85, 239737], [89, 239937], [95, 240317], [102, 240637], [105, 240837], [114, 241377], [121, 241737], [124, 242397], [127, 242537], [132, 242797], [143, 244037], [146, 244297], [149, 244477], [154, 245097], [161, 245717], [164, 245817], [167, 245997], [170, 246137]]}, {"verse": 33, "start": 247410, "end": 256929, "text": "O haced el árbol bueno, y su fruto bueno, o haced el árbol malo y su fruto malo; porque por el fruto es conocido el árbol.", "words": [[0, 247410], [2, 247551], [8, 248071], [11, 248371], [17, 248771], [24, 249171], [26, 249751], [29, 249931], [35, 250311], [42, 250691], [44, 251531], [50, 252011], [53, 252271], [59, 252631], [64, 253131], [66, 253291], [69, 253451], [75, 253771], [81, 254684], [88, 254867], [92, 255107], [95, 255247], [101, 255627], [104, 255707], [113, 256227], [116, 256347]]}, {"verse": 34, "start": 257379, "end": 265097, "text": "Generación de víboras, ¿cómo podéis hablar bien, siendo malos? porque de la abundancia del corazón habla la boca.", "words": [[0, 257379], [11, 258025], [14, 258225], [23, 258865], [29, 259285], [36, 259765], [43, 260105], [49, 260445], [56, 260825], [63, 262000], [70, 262264], [73, 262444], [76, 262604], [87, 263344], [91, 263524], [99, 263984], [105, 264404], [108, 264564]]}, {"verse": 35, "start": 265547, "end": 273322, "text": "El hombre bueno del buen tesoro del corazón saca buenas cosas: y el hombre malo del mal tesoro saca malas cosas.", "words": [[0, 265547], [3, 265691], [10, 265951], [16, 266311], [20, 266571], [25, 266811], [32, 267311], [36, 267451], [44, 267891], [49, 268391], [56, 268571], [63, 269720], [65, 269845], [68, 270005], [75, 270245], [80, 270725], [84, 270905], [88, 271205], [95, 271755], [100, 272305], [106, 272625]]}, {"verse": 36, "start": 273772, "end": 281006, "text": "Pero yo os digo, que toda palabra ociosa que hablen los hombres, de ella darán cuenta en el día del juicio.", "words": [[0, 273772], [5, 273952], [8, 274082], [11, 274212], [17, 274592], [21, 275332], [26, 275612], [34, 276052], [41, 276732], [45, 276932], [52, 277232], [56, 277412], [65, 277812], [68, 278452], [73, 278692], [79, 279172], [86, 279532], [89, 279732], [92, 279872], [96, 280072], [100, 280292]]}, {"verse": 37, "start": 281456, "end": 287037, "text": "Porque por tus palabras serás justificado, y por tus palabras serás condenado.", "words": [[0, 281456], [7, 281716], [11, 281976], [15, 282176], [24, 282706], [30, 283236], [43, 284396], [45, 284736], [49, 284936], [53, 285096], [62, 285526], [68, 285956]]}, {"verse": 38, "start": 287487, "end": 295375, "text": "Entonces respondieron algunos de los escribas y de los fariseos, diciendo: Maestro, deseamos ver de ti señal.", "words": [[0, 287487], [9, 288032], [22, 289332], [30, 289612], [33, 289792], [37, 289952], [46, 290592], [48, 290732], [51, 290852], [55, 290972], [65, 291772], [75, 293132], [84, 293753], [93, 294173], [97, 294453], [100, 294633], [103, 294793]]}, {"verse": 39, "start": 295725, "end": 306617, "text": "Y él respondió, y les dijo: La generación mala y adúltera demanda señal; pero señal no le será dada, sino la señal de Jonás profeta.", "words": [[0, 295725], [2, 295889], [5, 296009], [16, 296749], [18, 297209], [22, 297349], [28, 298248], [31, 298372], [42, 299032], [47, 299412], [49, 299672], [58, 300212], [66, 300812], [73, 301789], [78, 302080], [84, 302740], [87, 303240], [90, 303440], [95, 303740], [101, 304380], [106, 304580], [109, 304800], [115, 305300], [118, 305420], [124, 305720]]}, {"verse": 40, "start": 307067, "end": 319102, "text": "Porque como estuvo Jonás en el vientre del gran pez tres días y tres noches, así estará el Hijo del hombre en el corazón de la tierra tres días y tres noches.", "words": [[0, 307067], [7, 307349], [12, 307649], [19, 308029], [25, 308389], [28, 308669], [31, 308809], [39, 309249], [43, 309409], [48, 309709], [52, 310589], [57, 310829], [62, 311209], [64, 311449], [69, 311669], [77, 312714], [81, 313090], [88, 313630], [91, 313850], [96, 314150], [100, 314370], [107, 314710], [110, 315030], [113, 315170], [121, 315690], [124, 315950], [127, 316050], [134, 316390], [139, 317150], [144, 317710], [146, 318130], [151, 318370]]}, {"verse": 41, "start": 319552, "end": 332641, "text": "Los hombres de Nínive se levantarán en el juicio con esta generación, y la condenarán; porque ellos se arrepintieron a la predicación de Jonás; y aquí hay alguien más grande que Jonás.", "words": [[0, 319552], [4, 319677], [12, 320097], [15, 320507], [22, 320917], [25, 321017], [36, 321737], [39, 321837], [42, 321977], [49, 322357], [53, 322617], [58, 322837], [70, 323597], [72, 324117], [75, 324237], [87, 325604], [94, 325850], [100, 326210], [103, 326800], [117, 327390], [119, 327530], [122, 327610], [134, 328570], [137, 328710], [144, 329654], [146, 330014], [151, 330254], [155, 330634], [163, 330994], [167, 331274], [174, 331714], [178, 331954]]}, {"verse": 42, "start": 333091, "end": 347326, "text": "La reina del Sur se levantará en el juicio con esta generación, y la condenará; porque vino de los fines de la tierra para oír la sabiduría de Salomón: y aquí hay alguien más grande que Salomón.", "words": [[0, 333091], [3, 333212], [9, 333592], [13, 333772], [17, 334152], [20, 334452], [30, 335092], [33, 335252], [36, 335372], [43, 335772], [47, 336032], [52, 336252], [64, 337012], [66, 337692], [69, 337832], [80, 339039], [87, 339246], [92, 339546], [95, 339706], [99, 339846], [105, 340126], [108, 340286], [111, 340406], [118, 340786], [123, 341086], [127, 341646], [130, 342046], [140, 342806], [143, 342926], [152, 344074], [154, 344272], [159, 344572], [163, 345132], [171, 345632], [175, 345932], [182, 346352], [186, 346532]]}, {"verse": 43, "start": 347776, "end": 354911, "text": "Cuando el espíritu inmundo ha salido del hombre, anda por lugares secos, buscando reposo, y no lo halla.", "words": [[0, 347776], [7, 347978], [10, 348158], [19, 348918], [27, 349358], [30, 349498], [37, 349918], [41, 350118], [49, 350838], [54, 351298], [58, 351558], [66, 351898], [73, 352798], [82, 353218], [90, 353958], [92, 354118], [95, 354258], [98, 354613]]}, {"verse": 44, "start": 355361, "end": 364495, "text": "Entonces dice: Me volveré a mi casa de donde salí: y cuando viene, la halla desocupada, barrida y adornada.", "words": [[0, 355361], [9, 355825], [15, 356870], [18, 357015], [26, 357575], [28, 357655], [31, 357795], [36, 358155], [39, 358395], [45, 358635], [51, 359595], [53, 359703], [60, 359923], [67, 360703], [70, 361023], [76, 361263], [88, 362163], [96, 362583], [98, 362723]]}, {"verse": 45, "start": 364945, "end": 380781, "text": "Entonces va, y toma consigo otros siete espíritus peores que él, y entrados, moran allí; y son peores las cosas últimas del tal hombre que las primeras: así también acontecerá a esta generación mala.", "words": [[0, 364945], [9, 364945], [13, 365232], [15, 365652], [20, 365952], [28, 366492], [34, 366952], [40, 367452], [50, 368212], [57, 368752], [61, 369032], [65, 369852], [67, 370112], [77, 370792], [83, 371392], [89, 372137], [91, 372256], [95, 372436], [102, 373036], [106, 373616], [112, 373956], [120, 374756], [124, 375036], [128, 375296], [135, 375636], [139, 375856], [143, 376036], [153, 377114], [157, 377540], [165, 378020], [176, 379060], [178, 379240], [183, 379480], [194, 380200]]}, {"verse": 46, "start": 381231, "end": 388426, "text": "Y estando él aún hablando a la gente, he aquí su madre y sus hermanos estaban fuera, que le querían hablar.", "words": [[0, 381231], [2, 381356], [10, 381816], [13, 382156], [17, 382416], [26, 382776], [28, 382956], [31, 383016], [38, 383486], [41, 383956], [46, 384156], [49, 384376], [55, 384776], [57, 385036], [61, 385216], [70, 385816], [78, 386136], [85, 386576], [89, 387096], [92, 387236], [100, 387696]]}, {"verse": 47, "start": 388876, "end": 393507, "text": "Y le dijo uno: He aquí tu madre y tus hermanos están fuera, que te quieren hablar.", "words": [[0, 388876], [2, 389003], [5, 389103], [10, 389463], [15, 390287], [18, 390427], [23, 390587], [26, 390767], [32, 391047], [34, 391227], [38, 391347], [47, 391787], [53, 392007], [60, 392387], [64, 392627], [67, 392787], [75, 393027]]}, {"verse": 48, "start": 393857, "end": 400383, "text": "Y respondiendo él al que le decía esto, dijo: ¿Quién es mi madre y quiénes son mis hermanos?", "words": [[0, 393857], [2, 393967], [15, 394787], [18, 395067], [21, 395307], [25, 395447], [28, 395607], [34, 395987], [40, 396347], [46, 397174], [53, 397634], [56, 397714], [59, 397854], [65, 398254], [67, 398814], [75, 399214], [79, 399374], [83, 399554]]}, {"verse": 49, "start": 400833, "end": 407181, "text": "Y extendiendo su mano hacia sus discípulos, dijo: He aquí mi madre y mis hermanos.", "words": [[0, 400833], [2, 401148], [14, 401948], [17, 402108], [22, 402488], [28, 402928], [32, 403308], [44, 404168], [50, 405078], [53, 405158], [58, 405358], [61, 405578], [67, 405978], [69, 406258], [73, 406438]]}, {"verse": 50, "start": 407631, "end": 416326, "text": "Porque todo aquel que hace la voluntad de mi Padre que está en los cielos, ese es mi hermano, y hermana, y madre.", "words": [[0, 407631], [7, 407855], [12, 408155], [18, 408655], [22, 408795], [27, 409055], [30, 409255], [39, 409835], [42, 409975], [45, 410115], [51, 410455], [55, 410695], [60, 410875], [63, 411015], [67, 411135], [75, 412355], [79, 412655], [82, 412815], [85, 412975], [94, 413875], [96, 414055], [105, 414715], [107, 415575]]}]}