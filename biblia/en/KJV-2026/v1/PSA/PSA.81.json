{"book": "PSA", "chapter": 81, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 92386, "verses": [{"verse": 1, "start": 300, "end": 4615, "text": "Sing aloud to God our strength: make a joyful noise to the God of Jacob.", "words": [[0, 300], [5, 460], [11, 760], [14, 980], [18, 1240], [22, 1440], [32, 2238], [37, 2364], [39, 2504], [46, 2864], [52, 3304], [55, 3584], [59, 3704], [63, 3924], [66, 4024]]}, {"verse": 2, "start": 4965, "end": 9535, "text": "Take a psalm, and bring here the timbrel, the pleasant harp with the psaltery.", "words": [[0, 4965], [5, 5120], [7, 5310], [14, 5670], [18, 5970], [24, 6230], [29, 6490], [33, 6630], [42, 7550], [46, 7610], [55, 7990], [60, 8370], [65, 8690], [69, 9134]]}, {"verse": 3, "start": 9885, "end": 15036, "text": "Blow up the trumpet in the new moon, in the time appointed, on our solemn feast day.", "words": [[0, 9885], [5, 10056], [8, 10316], [12, 10476], [20, 10836], [23, 11056], [27, 11136], [31, 11316], [37, 12056], [40, 12196], [44, 12316], [49, 12556], [60, 13496], [63, 13616], [67, 13756], [74, 14196], [80, 14516]]}, {"verse": 4, "start": 15386, "end": 19445, "text": "For this was a statute for Israel, and a law of the God of Jacob.", "words": [[0, 15386], [4, 15488], [9, 15768], [13, 16008], [15, 16168], [23, 16528], [27, 16888], [35, 17328], [39, 17668], [41, 18008], [45, 18248], [48, 18368], [52, 18508], [56, 18748], [59, 18848]]}, {"verse": 5, "start": 19795, "end": 26890, "text": "This he ordained in Joseph for a testimony, when he went out through the land of Egypt: where I heard a language that I understood not.", "words": [[0, 19795], [5, 20031], [8, 20251], [17, 20671], [20, 20811], [27, 21151], [31, 21471], [33, 21591], [44, 21991], [49, 22391], [52, 22551], [57, 22751], [61, 22911], [69, 23151], [73, 23271], [78, 23491], [81, 23631], [88, 24390], [94, 24517], [96, 24677], [102, 24877], [104, 24977], [113, 25337], [118, 25657], [120, 25797], [131, 26157]]}, {"verse": 6, "start": 27110, "end": 31251, "text": "I removed his shoulder from the burden: his hands were delivered from the pots.", "words": [[0, 27110], [2, 27235], [10, 27555], [14, 27775], [23, 28075], [28, 28335], [32, 28455], [40, 29428], [44, 29531], [50, 29811], [55, 29991], [65, 30311], [70, 30551], [74, 30671]]}, {"verse": 7, "start": 31826, "end": 42723, "text": "You called in trouble, and I delivered you; I answered you in the secret place of thunder: I proved you at the waters of Meribah. Selah.", "words": [[0, 31826], [4, 31936], [11, 32176], [14, 32356], [23, 32636], [27, 33016], [29, 33116], [39, 33436], [44, 34368], [46, 34628], [55, 34928], [59, 35148], [62, 35268], [66, 35388], [73, 35648], [79, 35988], [82, 36148], [91, 37192], [93, 37318], [100, 37638], [104, 37918], [107, 38118], [111, 38218], [118, 38538], [121, 40051], [130, 42453]]}, {"verse": 8, "start": 42943, "end": 48469, "text": "Hear, O my people, and I will testify to you: O Israel, if you will hearken to me;", "words": [[0, 43153], [6, 43373], [8, 43453], [11, 43653], [19, 44393], [23, 44493], [25, 44653], [30, 44773], [38, 45153], [41, 45453], [46, 46379], [48, 46489], [56, 47269], [59, 47369], [63, 47509], [68, 47649], [76, 47949], [79, 48109]]}, {"verse": 9, "start": 49052, "end": 53572, "text": "There shall no strange god be in you; neither shall you worship any strange god.", "words": [[0, 49052], [6, 49153], [12, 49333], [15, 49513], [23, 49833], [27, 50133], [30, 50393], [33, 50593], [38, 51393], [46, 51632], [52, 51932], [56, 52052], [64, 52352], [68, 52632], [76, 52952]]}, {"verse": 10, "start": 54153, "end": 60051, "text": "I am the LORD your God, which brought you out of the land of Egypt: open your mouth wide, and I will fill it.", "words": [[0, 54153], [2, 54298], [5, 54378], [9, 54498], [14, 54718], [19, 54878], [24, 55678], [30, 55818], [38, 56058], [42, 56238], [46, 56378], [49, 56458], [53, 56558], [58, 56778], [61, 56898], [68, 57934], [73, 58111], [78, 58251], [84, 58451], [90, 58811], [94, 59191], [96, 59311], [101, 59431], [106, 59691]]}, {"verse": 11, "start": 60636, "end": 64687, "text": "But my people would not hearken to my voice; and Israel would none of me.", "words": [[0, 60636], [4, 60738], [7, 60858], [14, 61118], [20, 61298], [24, 61458], [32, 61798], [35, 61918], [38, 62038], [45, 63077], [49, 63217], [56, 63617], [62, 63897], [67, 64057], [70, 64217]]}, {"verse": 12, "start": 65260, "end": 69842, "text": "So I gave them up to their own hearts’ lust: and they walked in their own counsels.", "words": [[0, 65260], [3, 65378], [5, 65518], [10, 65698], [15, 65898], [18, 66038], [21, 66178], [27, 66338], [31, 66578], [39, 66998], [45, 68051], [49, 68132], [54, 68232], [61, 68512], [64, 68712], [70, 68872], [74, 69357]]}, {"verse": 13, "start": 70420, "end": 74547, "text": "Oh that my people had hearkened to me, and Israel had walked in my ways!", "words": [[0, 70517], [3, 70647], [8, 70827], [11, 70947], [18, 71267], [22, 71467], [32, 71867], [35, 72007], [39, 72187], [43, 72607], [50, 72947], [54, 73247], [61, 73527], [64, 73727], [67, 73867]]}, {"verse": 14, "start": 75129, "end": 79339, "text": "I should soon have subdued their enemies, and turned my hand against their adversaries.", "words": [[0, 75129], [2, 75239], [9, 75399], [14, 75659], [19, 75839], [27, 76339], [33, 76439], [42, 76799], [46, 77299], [53, 77519], [56, 77699], [61, 77979], [69, 78219], [75, 78419]]}, {"verse": 15, "start": 79853, "end": 85717, "text": "The haters of the LORD should have submitted themselves to him: but their time should have endured for ever.", "words": [[0, 79853], [4, 79969], [11, 80269], [14, 80549], [18, 80689], [23, 80929], [30, 81189], [35, 81389], [45, 81849], [56, 82349], [59, 82669], [64, 83223], [68, 83331], [74, 83511], [79, 83931], [86, 84191], [91, 84371], [99, 84832], [103, 85292]]}, {"verse": 16, "start": 86067, "end": 91986, "text": "He should have fed them also with the finest of the wheat: and with honey out of the rock shou