{"book": "PSA", "chapter": 73, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 147932, "verses": [{"verse": 1, "start": 300, "end": 4403, "text": "Truly God is good to Israel, even to such as are of a clean heart.", "words": [[0, 300], [6, 760], [10, 960], [13, 1200], [18, 1420], [21, 1580], [29, 2180], [34, 2400], [37, 2600], [42, 2800], [45, 2980], [49, 3240], [52, 3480], [54, 3580], [60, 3820]]}, {"verse": 2, "start": 4853, "end": 9560, "text": "But as for me, my feet were almost gone; my steps had well near slipped.", "words": [[0, 4853], [4, 4957], [7, 5137], [11, 5337], [15, 5757], [18, 5877], [23, 6137], [28, 6397], [35, 6677], [41, 7686], [44, 7810], [50, 8150], [54, 8430], [59, 8650], [64, 8910]]}, {"verse": 3, "start": 10010, "end": 14410, "text": "For I was envious at the foolish, when I saw the prosperity of the wicked.", "words": [[0, 10078], [4, 10158], [6, 10338], [10, 10558], [18, 11038], [21, 11298], [25, 11398], [34, 12278], [39, 12418], [41, 12578], [45, 12778], [49, 12938], [60, 13438], [63, 13838], [67, 13958]]}, {"verse": 4, "start": 14860, "end": 18639, "text": "For there are no bands in their death: but their strength is firm.", "words": [[0, 14860], [4, 14971], [10, 15191], [14, 15311], [17, 15661], [23, 16011], [26, 16191], [32, 16331], [39, 17146], [43, 17253], [49, 17413], [58, 17873], [61, 18073]]}, {"verse": 5, "start": 19089, "end": 23844, "text": "They are not in trouble as other men; neither are they plagued like other men.", "words": [[0, 19089], [5, 19208], [9, 19328], [13, 19508], [16, 19708], [24, 20088], [27, 20368], [33, 20548], [38, 21448], [46, 21774], [50, 22074], [55, 22274], [63, 22874], [68, 23013], [74, 23274]]}, {"verse": 6, "start": 24294, "end": 29739, "text": "Therefore pride compasses them about as a chain; violence covers them as a garment.", "words": [[0, 24294], [10, 24800], [16, 25180], [26, 25880], [31, 26040], [37, 26340], [40, 26580], [42, 26680], [49, 27589], [58, 28014], [65, 28494], [70, 28814], [73, 29034], [75, 29134]]}, {"verse": 7, "start": 30189, "end": 34511, "text": "Their eyes stand out with fatness: they have more than heart could wish.", "words": [[0, 30189], [6, 30372], [11, 30672], [17, 31072], [21, 31372], [26, 31572], [35, 32650], [40, 32751], [45, 32971], [50, 33231], [55, 33451], [61, 33711], [67, 33951]]}, {"verse": 8, "start": 34961, "end": 39948, "text": "They are corrupt, and speak wickedly concerning oppression: they speak loftily.", "words": [[0, 34961], [5, 35088], [9, 35188], [18, 35668], [22, 36008], [28, 36348], [37, 36968], [48, 37448], [60, 38619], [65, 38819], [71, 39139]]}, {"verse": 9, "start": 40398, "end": 44306, "text": "They set their mouth against the heavens, and their tongue walks through the earth.", "words": [[0, 40398], [5, 40506], [9, 40726], [15, 40946], [21, 41206], [29, 41546], [33, 41766], [42, 42326], [46, 42646], [52, 42786], [59, 43126], [65, 43486], [73, 43826], [77, 43966]]}, {"verse": 10, "start": 44756, "end": 49636, "text": "Therefore his people return here: and waters of a full cup are wrung out to them.", "words": [[0, 44756], [10, 45104], [14, 45384], [21, 45724], [28, 46204], [34, 46983], [38, 47240], [45, 47620], [48, 47880], [50, 47980], [55, 48200], [59, 48520], [63, 48720], [69, 49000], [73, 49160], [76, 49340]]}, {"verse": 11, "start": 50086, "end": 54416, "text": "And they say, How does God know? and is there knowledge in the most High?", "words": [[0, 50086], [4, 50370], [9, 50530], [14, 51250], [18, 51409], [23, 51609], [27, 51789], [33, 52483], [37, 52604], [40, 52754], [46, 52904], [56, 53344], [59, 53584], [63, 53704], [68, 53924]]}, {"verse": 12, "start": 54766, "end": 59967, "text": "Behold, these are the ungodly, who prosper in the world; they increase in riches.", "words": [[0, 54766], [8, 55289], [14, 55449], [18, 55669], [22, 55769], [31, 56549], [35, 56769], [43, 57189], [46, 57489], [50, 57569], [57, 58444], [62, 58568], [71, 59048], [74, 59308]]}, {"verse": 13, "start": 60417, "end": 64590, "text": "Indeed I have cleansed my heart in vain, and washed my hands in innocency.", "words": [[0, 60417], [7, 60862], [9, 60982], [14, 61142], [23, 61662], [26, 61742], [32, 62022], [35, 62142], [41, 62422], [45, 62942], [52, 63222], [55, 63462], [61, 63742], [64, 64191]]}, {"verse": 14, "start": 65040, "end": 69246, "text": "For all the day long have I been plagued, and chastened every morning.", "words": [[0, 65040], [4, 65140], [8, 65420], [12, 65600], [16, 65840], [21, 66220], [26, 66480], [28, 66640], [33, 66840], [42, 67520], [46, 67760], [56, 68360], [62, 68620]]}, {"verse": 15, "start": 69696, "end": 75571, "text": "If I say, I will speak thus; behold, I should offend against the generation of your children.", "words": [[0, 69696], [3, 70003], [5, 70183], [10, 70523], [12, 70663], [17, 70823], [23, 71103], [29, 72014], [37, 72820], [39, 72920], [46, 73120], [53, 73460], [61, 73800], [65, 74060], [76, 74600], [79, 74820], [84, 74940]]}, {"verse": 16, "start": 76021, "end": 78830, "text": "When I thought to know this, it was too painful for me;", "words": [[0, 76021], [5, 76158], [7, 76298], [15, 76498], [18, 76718], [23, 76918], [29, 77378], [32, 77458], [36, 77618], [40, 77798], [48, 78178], [52, 78518]]}, {"verse": 17, "start": 79280, "end": 83401, "text": "Until I went into the sanctuary of God; then understood I their end.", "words": [[0, 79280], [6, 79528], [8, 79708], [13, 79888], [18, 80068], [22, 80228], [32, 80708], [35, 80968], [40, 81786], [45, 81971], [56, 82491], [58, 82751], [64, 82911]]}, {"verse": 18, "start": 83851, "end": 89140, "text": "Surely you did set them in slippery places: you castedst them down into destruction.", "words": [[0, 83851], [7, 84177], [11, 84457], [15, 84657], [19, 84937], [24, 85137], [27, 85237], [36, 85577], [44, 86714], [48, 87060], [57, 87420], [62, 87660], [67, 88000], [72, 88280]]}, {"verse": 19, "start": 89590, "end": 95412, "text": "How are they brought into desolation, as 