{"book": "LUK", "chapter": 21, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 289812, "verses": [{"verse": 1, "start": 300, "end": 4857, "text": "Y mirando, vio a los ricos que echaban sus ofrendas en la caja de las ofrendas.", "words": [[0, 300], [2, 437], [11, 897], [15, 1237], [17, 1357], [21, 1477], [27, 1837], [31, 2017], [39, 2377], [43, 2557], [52, 3177], [55, 3317], [58, 3457], [63, 3817], [66, 3937], [70, 4057]]}, {"verse": 2, "start": 4857, "end": 10988, "text": "Y vio también una viuda pobrecilla, que echaba allí dos monedas de poco valor.", "words": [[0, 5097], [2, 5197], [6, 5457], [14, 5837], [18, 6317], [24, 6717], [36, 7597], [40, 8037], [47, 8577], [52, 8877], [56, 9297], [64, 10057], [67, 10157], [72, 10417]]}, {"verse": 3, "start": 11338, "end": 15960, "text": "Y dijo: De verdad os digo, que esta pobre viuda echó más que todos:", "words": [[0, 11338], [2, 11482], [8, 12171], [11, 12318], [18, 12538], [21, 12778], [27, 13638], [31, 13838], [36, 13998], [42, 14305], [48, 14611], [53, 14918], [57, 15098], [61, 15258]]}, {"verse": 4, "start": 16310, "end": 24541, "text": "Porque todos estos, de lo que les sobra echaron para las ofrendas de Dios; pero esta de su pobreza echó todo el sustento que tenía.", "words": [[0, 16310], [7, 16517], [13, 16817], [20, 17237], [23, 17497], [26, 17617], [30, 17737], [34, 18017], [40, 18297], [48, 18757], [53, 18997], [57, 19197], [66, 19777], [69, 19897], [75, 20674], [80, 20816], [85, 21056], [88, 21256], [91, 21416], [99, 21916], [104, 22416], [109, 22876], [112, 23116], [121, 23636], [125, 23856]]}, {"verse": 5, "start": 24891, "end": 30538, "text": "Y a unos que decían del templo, que estaba adornado de hermosas piedras y dones, dijo:", "words": [[0, 24891], [2, 24998], [4, 25118], [9, 25338], [13, 25598], [20, 26098], [24, 26318], [32, 26978], [36, 27058], [43, 27358], [52, 28218], [55, 28378], [64, 28918], [72, 29418], [74, 29578], [81, 29978]]}, {"verse": 6, "start": 30888, "end": 37190, "text": "Estas cosas que veis, días vendrán que no quedará piedra sobre piedra que no sea destruida.", "words": [[0, 30888], [6, 31332], [12, 31692], [16, 31952], [22, 32412], [27, 32932], [35, 33592], [39, 33752], [42, 33912], [50, 34352], [57, 34892], [63, 35192], [70, 35732], [74, 35852], [77, 36012], [81, 36252]]}, {"verse": 7, "start": 37540, "end": 44846, "text": "Y le preguntaron, diciendo: Maestro, ¿cuándo será esto? ¿y qué señal habrá cuando estas cosas hayan de comenzar a ser hechas?", "words": [[0, 37540], [2, 37647], [5, 37727], [18, 38407], [28, 39341], [37, 40020], [45, 40320], [50, 40500], [56, 41264], [59, 41365], [63, 41485], [69, 41965], [75, 42265], [82, 42405], [88, 42725], [94, 43085], [100, 43485], [103, 43545], [112, 44065], [114, 44145], [118, 44325]]}, {"verse": 8, "start": 45126, "end": 57332, "text": "Él entonces dijo: Mirad, no seáis engañados; porque vendrán muchos en mi nombre, diciendo: Yo soy; y, El tiempo está cerca: por tanto, no vayáis en pos de ellos.", "words": [[0, 45126], [3, 45370], [12, 45830], [18, 47099], [25, 47419], [28, 47599], [34, 47779], [45, 49187], [52, 49404], [60, 49884], [67, 50224], [70, 50484], [73, 50644], [81, 50984], [91, 52004], [94, 52209], [99, 52887], [102, 53032], [105, 53152], [112, 53552], [117, 53792], [124, 54722], [128, 54829], [135, 55489], [138, 55749], [145, 56229], [148, 56399], [152, 56569], [155, 56809]]}, {"verse": 9, "start": 57682, "end": 67772, "text": "Pero cuando oigáis guerras y sediciones, no os espantéis; porque es necesario que estas cosas acontezcan primero; pero el fin no será inmediatamente.", "words": [[0, 57682], [5, 57830], [12, 58130], [19, 58770], [27, 59290], [29, 59450], [41, 60610], [44, 60810], [47, 61030], [58, 62201], [65, 62448], [68, 62568], [78, 63168], [82, 63348], [88, 63528], [94, 63828], [105, 64608], [114, 65480], [119, 65643], [122, 65743], [126, 65943], [129, 66143], [134, 66383]]}, {"verse": 10, "start": 68122, "end": 74086, "text": "Entonces les dijo: Se levantará nación contra nación, y reino contra reino;", "words": [[0, 68122], [9, 68598], [13, 69118], [19, 69869], [22, 70032], [32, 70552], [39, 70952], [46, 71312], [54, 71852], [56, 72402], [62, 72952], [69, 73542]]}, {"verse": 11, "start": 74436, "end": 83210, "text": "Y habrá grandes terremotos, y en varios lugares hambrunas y epidemias: y habrá espantos y grandes señales del cielo.", "words": [[0, 74436], [2, 74564], [8, 74904], [16, 75184], [28, 76144], [30, 76424], [33, 76564], [40, 76844], [48, 77284], [58, 78444], [60, 78684], [71, 80026], [73, 80106], [79, 80366], [88, 81166], [90, 81346], [98, 81666], [106, 82386], [110, 82606]]}, {"verse": 12, "start": 83560, "end": 96329, "text": "Pero antes de todas estas cosas os echarán mano, y perseguirán, entregándoos a las sinagogas y a las cárceles, siendo llevados a los reyes y a los gobernadores por causa de mi nombre.", "words": [[0, 83560], [5, 83701], [11, 84041], [14, 84241], [20, 84481], [26, 84841], [32, 85301], [35, 85501], [43, 86021], [49, 86461], [51, 86626], [64, 87746], [77, 88866], [79, 89046], [83, 89166], [93, 90026], [95, 90166], [97, 90226], [101, 90346], [111, 91411], [118, 91851], [127, 92451], [129, 92611], [133, 92751], [139, 93351], [141, 93651], [143, 93731], [147, 93851], [160, 94611], [164, 94911], [170, 95311], [173, 95611], [176, 95731]]}, {"verse": 13, "start": 96679, "end": 98824, "text": "Y os será para testimonio.", "words": [[0, 96737], [2, 96837], [5, 96937], [10, 97437], [15, 97717]]}, {"verse": 14, "start": 99174, "end": 103803, "text": "Poned pues en vuestros corazones no pensar antes cómo habéis de responder:", "words": [[0, 99300], [6, 99460], [11, 99700], [14, 99920], [23, 100280], [33, 101040], [36, 101520], [43, 101860], [49, 102260], [54, 102600], [61, 102940], [64, 103080]]}, {"verse": 15, "start": 104153, "end": 111818, "text": "Porque yo os daré boca y sabiduría, a la cual no podrán resistir ni contradecir todos los que se os opondrán.", "words": [[0, 104153], [7, 104377], [10, 104527], [13, 104677], [18, 105117], [23, 105377], [25, 105577], [36, 106337], [38, 106777], [41, 106817], [46, 107037], [49, 107237], [56, 107677], [65, 108227], [68, 108777], [80, 109677], [86, 110317], [90, 110637], [94, 110797], [97, 110977], [100, 111077]]}, {"verse": 16, "start": 112168, "end": 120462, "text": "Pero seréis entregados aun de vuestros padres, y hermanos, y parientes, y amigos; y matarán a algunos de vosotros.", "words": [[0, 112168], [5, 112332], [12, 112832], [23, 113572], [27, 113792], [30, 113972], [39, 114252], [47, 114672], [49, 115092], [59, 115812], [61, 115992], [72, 116652], [74, 116992], [82, 117961], [84, 118083], [92, 118743], [94, 118923], [102, 119283], [105, 119523]]}, {"verse": 17, "start": 120812, "end": 124268, "text": "Y seréis aborrecidos de todos por causa de mi nombre.", "words": [[0, 120812], [2, 120918], [9, 121318], [21, 122118], [24, 122278], [30, 122598], [34, 122938], [40, 123258], [43, 123538], [46, 123638]]}, {"verse": 18, "start": 124618, "end": 127476, "text": "Pero un pelo de vuestra cabeza no perecerá.", "words": [[0, 124618], [5, 124762], [8, 124942], [13, 125362], [16, 125622], [24, 125982], [31, 126362], [34, 126947]]}, {"verse": 19, "start": 127826, "end": 130931, "text": "En vuestra paciencia poseeréis vuestras almas.", "words": [[0, 127826], [3, 128127], [11, 128447], [21, 129107], [31, 129867], [40, 130287]]}, {"verse": 20, "start": 131281, "end": 138471, "text": "Y cuando veáis a Jerusalén rodeada de ejércitos, sabed entonces que su destrucción ha llegado.", "words": [[0, 131281], [2, 131386], [9, 131646], [15, 132206], [17, 132366], [27, 133086], [35, 133706], [38, 133926], [49, 135086], [55, 135566], [64, 135966], [68, 136406], [71, 136646], [83, 137506], [86, 137726]]}, {"verse": 21, "start": 138821, "end": 149559, "text": "Entonces los que estén en Judea, huyan a los montes; y los que estén en la ciudad, salgan; y los que estén en los campos, no entren en ella.", "words": [[0, 138821], [9, 139448], [13, 139973], [17, 140153], [23, 140513], [26, 140653], [33, 141213], [39, 141653], [41, 141873], [45, 142013], [53, 142986], [55, 143066], [59, 143186], [63, 143326], [69, 143606], [72, 143706], [75, 143786], [83, 144537], [91, 145455], [93, 145577], [97, 145717], [101, 145917], [107, 146257], [110, 146357], [114, 146497], [122, 147577], [125, 148017], [132, 148637], [135, 149017]]}, {"verse": 22, "start": 149909, "end": 156038, "text": "Porque estos son días de venganza: para que se cumplan todas las cosas que están escritas.", "words": [[0, 149909], [7, 150132], [13, 150452], [17, 150812], [22, 151112], [25, 151312], [35, 152404], [40, 152572], [44, 152712], [47, 152872], [55, 153432], [61, 153912], [65, 154292], [71, 154692], [75, 154892], [81, 155132]]}, {"verse": 23, "start": 156388, "end": 166512, "text": "Pero ¡ay de las embarazadas, y de las que amamantan en aquellos días! porque habrá gran angustia sobre la tierra e ira en este pueblo.", "words": [[0, 156388], [5, 156724], [9, 157094], [12, 157399], [16, 157559], [29, 158539], [31, 158864], [34, 158984], [38, 159164], [42, 159384], [52, 160464], [55, 160584], [64, 160864], [70, 161964], [77, 162170], [83, 162630], [88, 163030], [97, 163930], [103, 164170], [106, 164390], [113, 164830], [115, 165170], [119, 165570], [122, 165710], [127, 165890]]}, {"verse": 24, "start": 166862, "end": 179152, "text": "Y caerán a filo de espada, y serán llevados cautivos a todas las naciones: y Jerusalén será pisoteada por los gentiles, hasta que los tiempos de los gentiles sean cumplidos.", "words": [[0, 166862], [2, 166988], [9, 167548], [11, 167608], [16, 167988], [19, 168108], [27, 168708], [29, 169368], [35, 169688], [44, 170108], [53, 170728], [55, 170908], [61, 171208], [65, 171488], [75, 172343], [77, 172503], [87, 173283], [92, 173663], [102, 174403], [106, 174643], [110, 174803], [120, 175523], [126, 176023], [130, 176243], [134, 176383], [142, 176903], [145, 177003], [149, 177103], [158, 177683], [163, 178083]]}, {"verse": 25, "start": 179502, "end": 191740, "text": "Entonces habrá señales en el sol, y en la luna, y en las estrellas; y en la tierra angustia de gentes por la confusión del sonido del mar y de las olas:", "words": [[0, 179502], [9, 179984], [15, 180604], [23, 181244], [26, 181444], [29, 181604], [34, 182564], [36, 182604], [39, 182764], [42, 182924], [48, 183884], [50, 183924], [53, 184064], [57, 184244], [68, 185518], [70, 185928], [73, 186028], [76, 186168], [83, 186548], [92, 187428], [95, 187548], [102, 188008], [106, 188248], [109, 188368], [119, 189188], [123, 189428], [130, 189988], [134, 190188], [138, 190528], [140, 190768], [143, 190888], [147, 191028]]}, {"verse": 26, "start": 192090, "end": 203547, "text": "Desfalleciendo los hombres a causa del temor y expectación de las cosas que sobrevendrán al mundo: porque las potencias de los cielos serán conmovidas.", "words": [[0, 192090], [15, 193178], [19, 193418], [27, 193838], [29, 194078], [35, 194358], [39, 194678], [45, 195358], [47, 195658], [59, 196638], [62, 196858], [66, 197018], [72, 197498], [76, 198038], [89, 198938], [92, 199058], [99, 199861], [106, 200043], [110, 200263], [120, 200923], [123, 201103], [127, 201223], [134, 201843], [140, 202443]]}, {"verse": 27, "start": 203897, "end": 210386, "text": "Y entonces verán al Hijo del hombre, que vendrá en una nube con poder y majestad grande.", "words": [[0, 203897], [2, 204022], [11, 204422], [17, 205182], [20, 205442], [25, 205702], [29, 205862], [37, 206382], [41, 206982], [48, 207442], [51, 207562], [55, 207742], [60, 208142], [64, 208382], [70, 208842], [72, 209142], [81, 209682]]}, {"verse": 28, "start": 210736, "end": 218709, "text": "Y cuando estas cosas comiencen a hacerse, mirad, y levantad vuestras cabezas, porque vuestra redención está cerca.", "words": [[0, 210736], [2, 210821], [9, 211021], [15, 211281], [21, 211621], [31, 212281], [33, 212421], [42, 212981], [49, 213541], [51, 214211], [60, 214881], [69, 215321], [78, 216141], [85, 216561], [93, 217171], [103, 217781], [108, 218041]]}, {"verse": 29, "start": 219059, "end": 222937, "text": "Y les dijo una parábola: Mirad la higuera y todos los árboles:", "words": [[0, 219059], [2, 219187], [6, 219307], [11, 219567], [15, 219807], [25, 220877], [31, 221077], [34, 221197], [42, 221697], [44, 221837], [50, 222037], [54, 222277]]}, {"verse": 30, "start": 222937, "end": 228032, "text": "Cuando ya brotan, viéndolo, de vosotros mismos entendéis que el verano está ya cerca.", "words": [[0, 222957], [7, 223097], [10, 223317], [18, 224037], [28, 224477], [31, 224717], [40, 225157], [47, 225757], [57, 226297], [61, 226497], [64, 226617], [71, 227017], [76, 227227], [79, 227437]]}, {"verse": 31, "start": 228382, "end": 234737, "text": "Así también vosotros, cuando veáis que suceden estas cosas, sabed que está cerca el reino de Dios.", "words": [[0, 228382], [4, 228605], [12, 228945], [22, 229625], [29, 229785], [35, 230265], [39, 230445], [47, 231065], [53, 231285], [60, 232285], [66, 232705], [70, 232885], [75, 233045], [81, 233405], [84, 233665], [90, 234065], [93, 234225]]}, {"verse": 32, "start": 235087, "end": 240107, "text": "De cierto os digo, que no pasará esta generación hasta que todo sea hecho.", "words": [[0, 235087], [3, 235235], [10, 235855], [13, 235935], [19, 236135], [23, 236315], [26, 236515], [33, 236995], [38, 237335], [49, 238155], [55, 238715], [59, 238955], [64, 239175], [68, 239495]]}, {"verse": 33, "start": 240457, "end": 245024, "text": "El cielo y la tierra pasarán; pero mis palabras no pasarán.", "words": [[0, 240457], [3, 240598], [9, 241018], [11, 241298], [14, 241418], [21, 241698], [30, 242914], [35, 243038], [39, 243218], [48, 243658], [51, 244178]]}, {"verse": 34, "start": 245374, "end": 257823, "text": "Y mirad por vosotros, que vuestros corazones no sean cargados de glotonería y embriaguez, y de las preocupaciones de esta vida, y venga de repente sobre vosotros aquel día.", "words": [[0, 245374], [2, 245538], [8, 245938], [12, 246158], [22, 246778], [26, 247258], [35, 247658], [45, 248218], [48, 248438], [53, 248758], [62, 249378], [65, 249868], [76, 250358], [78, 250858], [90, 251358], [92, 251838], [95, 252211], [99, 252585], [114, 252958], [117, 253138], [122, 253378], [128, 254358], [130, 254618], [136, 254958], [139, 255098], [147, 255518], [153, 256058], [162, 256878], [168, 257318]]}, {"verse": 35, "start": 258173, "end": 265019, "text": "Porque como un lazo vendrá sobre todos los que habitan sobre la faz de toda la tierra.", "words": [[0, 258173], [7, 258415], [12, 258775], [15, 258975], [20, 259435], [27, 259935], [33, 260275], [39, 260795], [43, 261435], [47, 261655], [55, 262235], [61, 262535], [64, 262755], [68, 263155], [71, 263755], [76, 264015], [79, 264275]]}, {"verse": 36, "start": 265369, "end": 276898, "text": "Velad pues, orando en todo tiempo, que seáis tenidos por dignos de evitar todas estas cosas que han de venir, y de estar en pie delante del Hijo del hombre.", "words": [[0, 265369], [6, 265973], [12, 266513], [19, 267133], [22, 267333], [27, 267513], [35, 268653], [39, 268874], [45, 269333], [53, 269893], [57, 270174], [64, 270773], [67, 270913], [74, 271254], [80, 271794], [86, 272254], [92, 272694], [96, 272913], [100, 273054], [103, 273153], [110, 273494], [112, 273953], [115, 274114], [121, 274393], [124, 274633], [128, 274994], [136, 275593], [140, 275833], [145, 276093], [149, 276294]]}, {"verse": 37, "start": 277248, "end": 284261, "text": "Y enseñaba de día en el templo; y de noche saliendo, se estaba en el monte que se llama de los Olivos.", "words": [[0, 277248], [2, 277429], [11, 278170], [14, 278330], [18, 278570], [21, 278730], [24, 278850], [32, 279728], [34, 279854], [37, 279954], [43, 280174], [53, 280934], [56, 281474], [63, 281774], [66, 281934], [69, 282074], [75, 282394], [79, 282654], [82, 282774], [88, 283074], [91, 283234], [95, 283354]]}, {"verse": 38, "start": 284611, "end": 289412, "text": "Y todo el pueblo venía a él por la mañana, para oírle en el templo.", "words": [[0, 284611], [2, 284736], [7, 284996], [10, 285216], [17, 285536], [23, 286076], [25, 286356], [28, 286536], [32, 286756], [35, 286936], [43, 287396], [48, 287761], [54, 288461], [57, 288661], [60, 288801]]}]}