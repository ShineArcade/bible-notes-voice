{"book": "PSA", "chapter": 79, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 108957, "verses": [{"verse": 1, "start": 300, "end": 10126, "text": "Salmo de Asaf. OH Dios, vinieron las naciones a tu heredad; el templo de tu santidad han contaminado; pusieron a Jerusalén en montones.", "words": [[0, 300], [6, 744], [9, 924], [15, 1554], [18, 1751], [24, 2291], [33, 2751], [37, 2971], [46, 3511], [48, 3711], [51, 3851], [60, 4679], [63, 4821], [70, 5501], [73, 5601], [76, 5741], [85, 6381], [89, 6561], [102, 7945], [111, 8329], [113, 8489], [123, 9089], [126, 9209]]}, {"verse": 2, "start": 10476, "end": 18375, "text": "Dieron los cuerpos de tus siervos por comida a las aves de los cielos; la carne de tus santos a las bestias de la tierra.", "words": [[0, 10476], [7, 10842], [11, 11062], [19, 11562], [22, 11842], [26, 12122], [34, 12402], [38, 12562], [45, 13002], [47, 13202], [51, 13362], [56, 13662], [59, 13782], [63, 13922], [71, 14824], [74, 14951], [80, 15351], [83, 15611], [87, 15791], [94, 16751], [96, 16951], [100, 17071], [108, 17511], [111, 17631], [114, 17731]]}, {"verse": 3, "start": 18725, "end": 26169, "text": "Derramaron su sangre como agua en los alrededores de Jerusalén; y no hubo quien los enterrase.", "words": [[0, 18725], [11, 19534], [14, 19934], [21, 20334], [26, 20574], [31, 21054], [34, 21334], [38, 21514], [50, 22334], [53, 22514], [64, 23659], [66, 23855], [69, 24015], [74, 24535], [80, 24775], [84, 25508]]}, {"verse": 4, "start": 26519, "end": 33197, "text": "Somos afrentados de nuestros vecinos, escarnecidos y burlados de los que están en nuestros alrededores.", "words": [[0, 26519], [6, 26845], [17, 27585], [20, 27745], [29, 27905], [38, 28795], [51, 29685], [53, 29885], [62, 30505], [65, 30805], [69, 30965], [73, 31105], [79, 31345], [82, 31525], [91, 31845]]}, {"verse": 5, "start": 33547, "end": 40144, "text": "¿Hasta cuándo, oh Jehová? ¿has de estar airado para siempre? ¿arderá como fuego tu celo?", "words": [[0, 33547], [7, 33847], [15, 34375], [18, 34902], [26, 35738], [31, 35898], [34, 36058], [40, 36338], [47, 36978], [52, 37198], [61, 38251], [69, 38831], [74, 39031], [80, 39371], [83, 39591]]}, {"verse": 6, "start": 40494, "end": 47067, "text": "Derrama tu ira sobre las naciones que no te conocen, y sobre los reinos que no invocan tu nombre.", "words": [[0, 40494], [8, 41019], [11, 41259], [15, 41479], [21, 41699], [25, 41939], [34, 42379], [38, 42559], [41, 42699], [44, 42799], [53, 43619], [55, 43759], [61, 44119], [65, 44399], [72, 45059], [76, 45239], [79, 45519], [87, 46359], [90, 46499]]}, {"verse": 7, "start": 47417, "end": 51044, "text": "Porque han consumido a Jacob, y su morada han asolado.", "words": [[0, 47417], [7, 47619], [11, 47819], [21, 48499], [23, 48639], [30, 48979], [32, 49324], [35, 49604], [42, 49884], [46, 50164]]}, {"verse": 8, "start": 51394, "end": 60430, "text": "No recuerdes contra nosotros las iniquidades antiguas: lleguen pronto a nosotros tus misericordias, porque estamos muy abatidos.", "words": [[0, 51394], [3, 51540], [13, 52120], [20, 52460], [29, 53080], [33, 53520], [45, 54420], [55, 55700], [63, 56160], [70, 56520], [72, 56740], [81, 57060], [85, 57360], [100, 58380], [107, 58800], [115, 59100], [119, 59480]]}, {"verse": 9, "start": 60780, "end": 70879, "text": "Ayúdanos, oh Dios de nuestra salvación, por la gloria de tu nombre: y líbranos, y aplácate sobre nuestros pecados por amor de tu nombre.", "words": [[0, 61264], [10, 61644], [13, 62024], [18, 62644], [21, 62784], [29, 62964], [40, 63844], [44, 64484], [47, 64665], [54, 65064], [57, 65225], [60, 65364], [68, 66194], [70, 66361], [80, 66921], [82, 67461], [91, 68081], [97, 68381], [106, 68621], [114, 69381], [118, 69641], [123, 69881], [126, 70101], [129, 70261]]}, {"verse": 10, "start": 71229, "end": 82681, "text": "Porque dirán las gentes: ¿Dónde está su Dios? Sea notoria en las gentes, delante de nuestros ojos, la venganza de la sangre de tus siervos, que fue derramada.", "words": [[0, 71229], [7, 71469], [13, 71729], [17, 71989], [25, 73006], [32, 73306], [37, 73566], [40, 73746], [46, 74593], [50, 74851], [58, 75551], [61, 75691], [65, 75831], [73, 76851], [81, 77391], [84, 77571], [93, 77751], [99, 78891], [102, 79051], [111, 79671], [114, 79791], [117, 79931], [124, 80311], [127, 80531], [131, 80711], [140, 81291], [144, 81571], [148, 81791]]}, {"verse": 11, "start": 83031, "end": 92248, "text": "Entre ante tu presencia el gemido de los presos: conforme a la grandeza de tu brazo preserva a los sentenciados a muerte.", "words": [[0, 83031], [6, 83375], [11, 83795], [14, 83995], [24, 84795], [27, 85295], [34, 85835], [37, 85955], [41, 86075], [49, 87046], [58, 87670], [60, 87750], [63, 87830], [72, 88450], [75, 88590], [78, 88750], [84, 89430], [93, 90230], [95, 90390], [99, 90510], [112, 91470], [114, 91650]]}, {"verse": 12, "start": 92598, "end": 99367, "text": "Y devuelve a nuestros vecinos en su seno siete veces de su infamia, con que te han deshonrado, oh Jehová.", "words": [[0, 92598], [2, 92716], [11, 93236], [13, 93316], [22, 93456], [30, 94136], [33, 94396], [36, 94656], [41, 94916], [47, 95176], [53, 95616], [56, 95856], [59, 96016], [68, 96696], [72, 97176], [76, 97336], [79, 97516], [83, 97636], [95, 98229], [98, 98822]]}, {"verse": 13, "start": 99717, "end": 108557, "text": "Y nosotros, pueblo tuyo, y ovejas de tu prado, te alabaremos para siempre: por generación y generación cantaremos tus alabanzas.", "words": [[0, 99717], [2, 99841], [12, 100121], [19, 100601], [25, 101281], [27, 101441], [34, 101861], [37, 102041], [40, 102181], [47, 102661], [50, 103141], [61, 103701], [66, 103981], [75, 104909], [79, 105032], [90, 105792], [92, 105972], [103, 106652], [114, 107292], [118, 107532]]}]}