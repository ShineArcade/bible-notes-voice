{"book": "ACT", "chapter": 21, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 394723, "verses": [{"verse": 1, "start": 300, "end": 9445, "text": "Y habiendo partido de ellos, navegamos y vinimos camino derecho a Cos, y al día siguiente a Rodas, y de allí a Pátara.", "words": [[0, 300], [2, 424], [11, 784], [19, 1204], [22, 1564], [29, 2424], [39, 3244], [41, 3524], [49, 3944], [56, 4224], [64, 4644], [66, 5034], [71, 5424], [73, 5904], [76, 6044], [80, 6164], [90, 6524], [92, 6884], [99, 7564], [101, 8004], [104, 8144], [109, 8364], [111, 8624]]}, {"verse": 2, "start": 9895, "end": 15297, "text": "Y hallando un barco que pasaba a Fenicia, nos embarcamos, y partimos.", "words": [[0, 9895], [2, 10017], [11, 10417], [14, 10577], [20, 10997], [24, 11137], [31, 11577], [33, 11717], [42, 12637], [46, 12717], [58, 13637], [60, 14337]]}, {"verse": 3, "start": 15747, "end": 26417, "text": "Y como avistamos a Chipre, dejándola a mano izquierda, navegamos a Siria, y vinimos a Tiro: porque el barco había de descargar allí su carga.", "words": [[0, 15747], [2, 16056], [7, 16296], [17, 16956], [19, 17476], [27, 17996], [37, 18636], [39, 18876], [44, 19076], [55, 20156], [65, 20756], [67, 20996], [74, 21516], [76, 21916], [84, 22356], [86, 22536], [92, 23381], [99, 23551], [102, 23691], [108, 24091], [114, 24291], [117, 24551], [127, 25251], [132, 25491], [135, 25691]]}, {"verse": 4, "start": 26867, "end": 35949, "text": "Y nos quedamos allí siete días, hallados los discípulos, los cuales decían a Pablo por Espíritu, que no subiese a Jerusalén.", "words": [[0, 26867], [2, 26974], [6, 27094], [15, 27574], [20, 27834], [26, 28214], [32, 29074], [41, 29674], [45, 30014], [57, 31094], [61, 31214], [68, 31474], [75, 32414], [77, 32534], [83, 32774], [87, 33034], [97, 33854], [101, 34154], [104, 34314], [112, 34854], [114, 35034]]}, {"verse": 5, "start": 36399, "end": 48071, "text": "Y cumplidos aquellos días, salimos, y todos nos acompañaron con sus mujeres e hijos, hasta fuera de la ciudad; y puestos de rodillas en la ribera, oramos.", "words": [[0, 36399], [2, 36523], [12, 37183], [21, 37543], [27, 38043], [36, 39023], [38, 39643], [44, 39923], [48, 40163], [60, 41103], [64, 41303], [68, 41563], [76, 41983], [78, 42263], [85, 42603], [91, 43263], [97, 43603], [100, 43823], [103, 43943], [111, 44889], [113, 45111], [121, 45611], [124, 45731], [133, 46231], [136, 46451], [139, 46591], [147, 47171]]}, {"verse": 6, "start": 48521, "end": 56011, "text": "Y abrazándonos los unos a los otros, subimos al barco, y ellos se volvieron a sus casas.", "words": [[0, 48521], [2, 48644], [15, 49604], [19, 49904], [24, 50384], [26, 50684], [30, 50864], [37, 52064], [45, 52584], [48, 52844], [55, 53364], [57, 53944], [63, 54244], [66, 54464], [76, 54964], [78, 55084], [82, 55224]]}, {"verse": 7, "start": 56461, "end": 66247, "text": "Y nosotros, cumplida la navegación, vinimos de Tiro a Tolemaida; y habiendo saludado a los hermanos, nos quedamos con ellos un día.", "words": [[0, 56461], [2, 56765], [12, 57025], [21, 58005], [24, 58125], [36, 58985], [44, 59845], [47, 60005], [52, 60425], [54, 60685], [65, 61859], [67, 61981], [76, 62341], [85, 63041], [87, 63161], [91, 63301], [101, 64381], [105, 64521], [114, 65001], [118, 65281], [124, 65521], [127, 65801]]}, {"verse": 8, "start": 66697, "end": 78533, "text": "Y otro día, partidos Pablo y los que con él estábamos, vinimos a Cesarea: y entrando en casa de Felipe el evangelista, el cual era uno de los siete, nos alojamos con él.", "words": [[0, 66697], [2, 66824], [7, 66984], [12, 67264], [21, 67744], [27, 68124], [29, 68304], [33, 68424], [37, 68564], [41, 68784], [44, 68884], [55, 69444], [63, 70244], [65, 70464], [74, 71485], [76, 71643], [85, 72143], [88, 72303], [93, 72603], [96, 72843], [103, 73563], [106, 73743], [119, 74883], [122, 75023], [127, 75243], [131, 75603], [135, 75863], [138, 76003], [142, 76143], [149, 77163], [153, 77403], [162, 77943], [166, 78163]]}, {"verse": 9, "start": 78983, "end": 82991, "text": "Y este tenía cuatro hijas, vírgenes, que profetizaban.", "words": [[0, 78983], [2, 79087], [7, 79267], [13, 79647], [20, 80027], [27, 80947], [37, 81467], [41, 81847]]}, {"verse": 10, "start": 83441, "end": 90615, "text": "Y parando nosotros allí por muchos días, descendió de Judea un profeta, llamado Agabo;", "words": [[0, 83441], [2, 83565], [10, 84085], [19, 84385], [24, 85025], [28, 85565], [35, 85845], [41, 86785], [51, 87665], [54, 87785], [60, 88265], [63, 88405], [72, 89045], [80, 89685]]}, {"verse": 11, "start": 91065, "end": 106759, "text": "Y venido a nosotros, tomó el cinto de Pablo, y atándose los pies y las manos, dijo: Esto dice el Espíritu Santo: Así atarán los judíos en Jerusalén al varón a quien pertenece este cinto, y le entregarán en manos de los Gentiles.", "words": [[0, 91065], [2, 91189], [9, 91569], [11, 91669], [21, 92069], [26, 92869], [29, 93009], [35, 93369], [38, 93509], [45, 94009], [47, 94569], [56, 95189], [60, 95409], [65, 95649], [67, 95809], [71, 95949], [78, 96529], [84, 97311], [89, 97531], [94, 97791], [97, 97951], [106, 98411], [113, 99210], [117, 99549], [124, 100009], [128, 100169], [135, 100629], [138, 100769], [148, 101349], [151, 101529], [157, 101889], [159, 102049], [165, 102149], [175, 102749], [180, 102989], [187, 103669], [189, 103869], [192, 103969], [203, 104529], [206, 104649], [212, 104849], [215, 105029], [219, 105129]]}, {"verse": 12, "start": 107109, "end": 113372, "text": "Lo cual como oímos, le rogamos nosotros y los de aquel lugar, que no subiese a Jerusalén.", "words": [[0, 107109], [3, 107245], [8, 107465], [13, 107725], [20, 108355], [23, 108985], [31, 109465], [40, 109985], [42, 110325], [46, 110465], [49, 110585], [55, 110825], [62, 111205], [66, 111805], [69, 111945], [77, 112385], [79, 112545]]}, {"verse": 13, "start": 113822, "end": 124810, "text": "Entonces Pablo respondió: ¿Qué hacéis llorando y afligiéndome el corazón? porque yo no sólo estoy dispuesto a ser atado, sino también a morir en Jerusalén por el nombre del Señor Jesús.", "words": [[0, 113822], [9, 114211], [15, 114771], [26, 115949], [31, 116043], [38, 116423], [47, 116843], [49, 116983], [62, 117643], [65, 117743], [74, 118803], [81, 118980], [84, 119180], [87, 119300], [92, 119500], [98, 119740], [108, 120200], [110, 120360], [114, 120520], [121, 121300], [126, 121580], [134, 121980], [136, 122160], [142, 122460], [145, 122540], [155, 123120], [159, 123300], [162, 123420], [169, 123680], [173, 123840], [179, 124100]]}, {"verse": 14, "start": 125160, "end": 131463, "text": "Y como no le pudimos persuadir, desistimos, diciendo: Hágase la voluntad del Señor.", "words": [[0, 125160], [2, 125287], [7, 125527], [10, 125707], [13, 125827], [21, 126247], [32, 127527], [44, 128407], [54, 129805], [61, 130171], [64, 130291], [73, 130771], [77, 130911]]}, {"verse": 15, "start": 131813, "end": 136921, "text": "Y después de estos días, hechos ya los preparativos, subimos a Jerusalén.", "words": [[0, 131813], [2, 131937], [10, 132237], [13, 132417], [19, 132597], [25, 133517], [32, 133817], [35, 134017], [39, 134157], [53, 135417], [61, 135877], [63, 136037]]}, {"verse": 16, "start": 137371, "end": 150060, "text": "Y vinieron también con nosotros de Cesarea algunos de los discípulos, trayendo consigo a un Mnasón, Cyprio, discípulo antiguo, con quien nos alojaríamos.", "words": [[0, 137371], [2, 137498], [11, 137978], [19, 138478], [23, 138758], [32, 139398], [35, 139818], [43, 140508], [51, 141198], [54, 141278], [58, 141418], [70, 142518], [79, 143138], [87, 143658], [89, 143998], [92, 144858], [100, 145718], [108, 146578], [118, 147478], [127, 148278], [131, 148418], [137, 148638], [141, 148938]]}, {"verse": 17, "start": 150510, "end": 155559, "text": "Y cuando llegamos a Jerusalén, los hermanos nos recibieron de buena voluntad.", "words": [[0, 150510], [2, 150634], [9, 150814], [18, 151354], [20, 151514], [31, 152854], [35, 152934], [44, 153454], [48, 153614], [59, 154314], [62, 154494], [68, 154734]]}, {"verse": 18, "start": 156009, "end": 162196, "text": "Y al día siguiente Pablo entró con nosotros a Jacobo, y todos los ancianos se juntaron;", "words": [[0, 156009], [2, 156096], [5, 156216], [9, 156336], [19, 156776], [25, 157376], [31, 157876], [35, 158036], [44, 158576], [46, 158856], [54, 159476], [56, 159796], [62, 160176], [66, 160616], [75, 161236], [78, 161396]]}, {"verse": 19, "start": 162646, "end": 169412, "text": "A los cuales, como los hubo saludado, contó en detalle lo que Dios había hecho entre los Gentiles por su ministerio.", "words": [[0, 162646], [2, 162738], [6, 162858], [14, 163138], [19, 163458], [23, 163658], [28, 164118], [38, 164978], [44, 165558], [47, 165658], [55, 166158], [58, 166338], [62, 166478], [67, 166638], [73, 166958], [79, 167298], [85, 167518], [89, 167718], [98, 168218], [102, 168458], [105, 168638]]}, {"verse": 20, "start": 169862, "end": 180258, "text": "Y ellos como lo oyeron, glorificaron a Dios, y le dijeron: Ya ves, hermano, cuántos millares de judíos hay que han creído; y todos son celosos de la ley:", "words": [[0, 169862], [2, 170010], [8, 170350], [13, 170530], [16, 170710], [24, 171650], [37, 172470], [39, 172610], [45, 172850], [47, 173490], [50, 173590], [59, 174554], [62, 174720], [67, 174880], [76, 175820], [84, 176140], [93, 176560], [96, 176720], [103, 177220], [107, 177440], [111, 177580], [115, 177680], [123, 178568], [125, 178689], [131, 178849], [135, 179149], [143, 179609], [146, 179789], [149, 179909]]}, {"verse": 21, "start": 180708, "end": 192505, "text": "Pero fueron informados acerca de ti, que enseñas a apartarse de Moisés a todos los judíos que están entre los Gentiles, diciéndoles que no han de circuncidar a los hijos, ni andar según la costumbre.", "words": [[0, 180708], [5, 180866], [12, 181146], [23, 181826], [30, 182166], [33, 182486], [37, 182926], [41, 183026], [49, 183606], [51, 183706], [61, 184306], [64, 184466], [71, 184846], [73, 185146], [79, 185366], [83, 185646], [90, 186146], [94, 186286], [100, 186526], [106, 186766], [110, 186946], [120, 187846], [132, 188446], [136, 188666], [139, 188846], [143, 188986], [146, 189106], [158, 189746], [160, 189866], [164, 190006], [171, 190831], [174, 190989], [180, 191269], [186, 191628], [189, 191829]]}, {"verse": 22, "start": 192955, "end": 197513, "text": "¿Qué hay pues? La multitud se reunirá de cierto: porque oirán que has venido.", "words": [[0, 192955], [5, 193075], [9, 193215], [15, 193977], [18, 194063], [27, 194563], [30, 194763], [38, 195156], [41, 195550], [49, 196194], [56, 196380], [62, 196740], [66, 196860], [70, 196980]]}, {"verse": 23, "start": 197963, "end": 203207, "text": "Haz pues esto que te decimos: Hay entre nosotros cuatro hombres que tienen voto sobre sí:", "words": [[0, 197963], [4, 198146], [9, 198326], [14, 198646], [18, 198826], [21, 198946], [30, 199921], [34, 200082], [40, 200322], [49, 200802], [56, 201202], [64, 201642], [68, 201882], [75, 202142], [80, 202542], [86, 202762]]}, {"verse": 24, "start": 203657, "end": 216584, "text": "Tomando a estos contigo, purifícate con ellos, y paga sus gastos, para que rasuren sus cabezas, y todos entiendan que no hay nada de lo que fueron informados acerca de ti; sino que tú también andas guardando la ley.", "words": [[0, 203657], [8, 204037], [10, 204157], [16, 204317], [25, 205277], [36, 205917], [40, 206157], [47, 206437], [49, 206787], [54, 207137], [58, 207337], [66, 207997], [71, 208317], [75, 208457], [83, 208917], [87, 209137], [96, 210248], [98, 210372], [104, 210552], [114, 211172], [118, 211312], [121, 211492], [125, 211632], [130, 211912], [133, 212072], [136, 212192], [140, 212312], [147, 212572], [158, 213272], [165, 213572], [168, 213832], [172, 214442], [177, 214639], [181, 214819], [184, 214999], [192, 215239], [198, 215659], [208, 216119], [211, 216259]]}, {"verse": 25, "start": 217034, "end": 231659, "text": "Pero cuanto a los que de los Gentiles han creído, nosotros hemos escrito haberse acordado que no guarden nada de esto; solamente que se abstengan de lo que sea sacrificado a los ídolos, y de sangre, y de animales estrangulados, y de inmoralidad sexual.", "words": [[0, 217034], [5, 217192], [12, 217512], [14, 217672], [18, 217832], [22, 217972], [25, 218052], [29, 218172], [38, 218652], [42, 218872], [50, 219892], [59, 219972], [65, 220412], [73, 220832], [81, 221312], [90, 221812], [94, 221972], [97, 222242], [105, 222512], [110, 222752], [113, 222992], [119, 223736], [129, 224081], [133, 224461], [136, 224641], [146, 225221], [149, 225361], [152, 225481], [156, 225581], [160, 225781], [172, 226541], [174, 226621], [178, 226741], [186, 227301], [188, 227441], [191, 227541], [199, 227941], [201, 228341], [204, 228421], [213, 228741], [228, 229701], [230, 230261], [233, 230361], [245, 231021]]}, {"verse": 26, "start": 232009, "end": 248280, "text": "Entonces Pablo tomó consigo aquellos hombres, y al día siguiente, habiéndose purificado con ellos, entró en el templo, para anunciar el cumplimiento de los días de la purificación, hasta ser ofrecida ofrenda por cada uno de ellos.", "words": [[0, 232009], [9, 232455], [15, 233355], [20, 234035], [28, 234455], [37, 234755], [46, 235275], [48, 235995], [51, 236115], [55, 236255], [66, 237075], [77, 237655], [88, 238375], [92, 238635], [99, 239275], [105, 239895], [108, 240075], [111, 240235], [119, 241015], [124, 241235], [133, 241955], [136, 242055], [149, 242775], [152, 242955], [156, 243075], [161, 243315], [164, 243475], [167, 243575], [181, 244943], [187, 245134], [191, 245414], [200, 246014], [208, 246654], [212, 246814], [217, 247054], [221, 247354], [224, 247614]]}, {"verse": 27, "start": 248730, "end": 258825, "text": "Y cuando estaban para acabarse los siete días, unos judíos de Asia, como le vieron en el templo, alborotaron todo el pueblo y le echaron mano,", "words": [[0, 248730], [2, 248814], [9, 249014], [17, 249354], [22, 249754], [31, 250554], [35, 250734], [41, 251174], [47, 251634], [52, 252154], [59, 252654], [62, 252794], [68, 253414], [73, 253714], [76, 253874], [83, 254214], [86, 254414], [89, 254554], [97, 255554], [109, 256274], [114, 256534], [117, 256754], [124, 257134], [126, 257734], [129, 257874], [137, 258234]]}, {"verse": 28, "start": 259275, "end": 274254, "text": "Dando voces: Varones israelitas, ayudad: Este es el hombre que por todas partes enseña a todos contra el pueblo, y la ley, y este lugar; y además de esto ha metido Gentiles en el templo, y ha contaminado este lugar santo.", "words": [[0, 259275], [6, 259584], [13, 260882], [21, 261062], [33, 261762], [41, 262614], [46, 262879], [49, 263079], [52, 263219], [59, 263419], [63, 263599], [67, 263759], [73, 263979], [80, 264519], [87, 265139], [89, 265259], [95, 265499], [102, 265919], [105, 266059], [113, 266399], [115, 266739], [118, 266879], [123, 267199], [125, 267479], [130, 267679], [137, 268946], [139, 269064], [146, 269324], [149, 269604], [154, 269884], [157, 270064], [164, 270444], [173, 270924], [176, 271144], [179, 271264], [187, 272104], [189, 272244], [192, 272384], [204, 273084], [209, 273284], [215, 273544]]}, {"verse": 29, "start": 274604, "end": 283603, "text": "Porque antes habían visto con él en la ciudad a Trófimo, efesio, al cual pensaban que Pablo había metido en el templo.", "words": [[0, 274604], [7, 274828], [13, 275248], [20, 275668], [26, 276008], [30, 276368], [33, 276528], [36, 276688], [39, 276828], [46, 277633], [48, 278438], [57, 279243], [65, 280048], [68, 280188], [73, 280408], [82, 281028], [86, 281228], [92, 281668], [98, 282108], [105, 282628], [108, 282788], [111, 282928]]}, {"verse": 30, "start": 284053, "end": 296111, "text": "Así que, toda la ciudad se alborotó, y se agolpó el pueblo; y tomando a Pablo, le hicieron salir fuera del templo, y luego las puertas fueron cerradas.", "words": [[0, 284053], [4, 284373], [9, 284553], [14, 284913], [17, 285193], [24, 285573], [27, 285973], [37, 286933], [39, 287193], [42, 287393], [49, 288213], [52, 288373], [60, 289386], [62, 289507], [70, 289947], [72, 290107], [79, 291207], [82, 291487], [91, 291947], [97, 292327], [103, 292627], [107, 292947], [115, 293807], [117, 294007], [123, 294247], [127, 294467], [135, 294867], [142, 295511]]}, {"verse": 31, "start": 296561, "end": 305518, "text": "Y procurando ellos matarle, fue dado aviso al comandante de la unidad militar, que toda la ciudad de Jerusalén estaba alborotada;", "words": [[0, 296561], [2, 296688], [13, 297408], [19, 297688], [28, 298708], [32, 298988], [37, 299208], [43, 299688], [46, 299828], [57, 300648], [60, 300788], [63, 300908], [70, 301288], [79, 301728], [83, 302168], [88, 302468], [91, 302688], [98, 303008], [101, 303268], [111, 304028], [118, 304428]]}, {"verse": 32, "start": 305968, "end": 317363, "text": "El cual tomando luego soldados y centuriones, corrió a ellos. Y ellos como vieron al comandante y a los soldados, cesaron de herir a Pablo.", "words": [[0, 305968], [3, 306273], [8, 306453], [16, 306973], [22, 307293], [31, 308193], [33, 308353], [46, 309073], [53, 309853], [55, 310013], [62, 311605], [64, 311792], [70, 312472], [75, 312792], [82, 313212], [85, 313332], [96, 314172], [98, 314312], [100, 314372], [104, 314512], [114, 315552], [122, 316032], [125, 316272], [131, 316652], [133, 316732]]}, {"verse": 33, "start": 317813, "end": 326532, "text": "Entonces llegando el comandante, le prendió, y le mandó atar con dos cadenas; y preguntó quién era, y qué había hecho.", "words": [[0, 317813], [9, 318838], [18, 319218], [21, 319318], [33, 319938], [36, 320098], [45, 320658], [47, 321178], [50, 321278], [56, 321548], [61, 321818], [65, 322118], [69, 322298], [78, 323408], [80, 323524], [89, 324104], [95, 324324], [100, 324724], [102, 325324], [106, 325544], [112, 325844]]}, {"verse": 34, "start": 326982, "end": 338057, "text": "Y entre la multitud, unos gritaban una cosa, y otros otra: y como no podía entender nada de cierto a causa del alboroto, le mandó llevar a la fortaleza.", "words": [[0, 326982], [2, 327101], [8, 327321], [11, 327501], [21, 328181], [26, 328701], [35, 329301], [39, 329501], [45, 329861], [47, 330281], [53, 330501], [59, 331415], [61, 331520], [66, 331760], [69, 331940], [75, 332320], [84, 332760], [89, 333240], [92, 333500], [99, 333920], [101, 334140], [107, 334440], [111, 334760], [121, 335800], [124, 336180], [130, 336540], [137, 336760], [139, 336960], [142, 337080]]}, {"verse": 35, "start": 338507, "end": 345478, "text": "Y cuando llegó a las escaleras, aconteció que fue llevado de los soldados a causa de la violencia del pueblo;", "words": [[0, 338507], [2, 338631], [9, 338871], [15, 339251], [17, 339431], [21, 339571], [32, 340971], [42, 341471], [46, 341611], [50, 341791], [58, 342251], [61, 342391], [65, 342511], [74, 343071], [76, 343231], [82, 343591], [85, 343871], [88, 343971], [98, 344611], [102, 344771]]}, {"verse": 36, "start": 345928, "end": 350455, "text": "Porque multitud de pueblo venía detrás, gritando: Mátale.", "words": [[0, 345928], [7, 346150], [16, 346830], [19, 347030], [26, 347510], [32, 347970], [40, 348570], [50, 349850]]}, {"verse": 37, "start": 350805, "end": 360204, "text": "Y como comenzaron a meter a Pablo en la fortaleza, dice al comandante: ¿Me será lícito hablarte algo? Y él dijo: ¿Sabes griego?", "words": [[0, 350805], [2, 350927], [7, 351187], [18, 351847], [20, 351987], [26, 352207], [28, 352387], [34, 352727], [37, 352887], [40, 353007], [51, 354287], [56, 354767], [59, 355007], [71, 356147], [75, 356247], [80, 356487], [87, 356727], [96, 357307], [102, 358149], [104, 358337], [107, 358497], [113, 359266], [120, 359639]]}, {"verse": 38, "start": 360654, "end": 367922, "text": "¿No eres tú aquel egipcio que provocó una revuelta antes de estos días, y sacó al desierto cuatro mil sicarios?", "words": [[0, 360654], [4, 360838], [9, 361058], [12, 361318], [18, 361578], [26, 362038], [30, 362178], [38, 362718], [42, 362838], [51, 363378], [57, 363678], [60, 363858], [66, 364058], [72, 364458], [74, 365058], [79, 365418], [82, 365518], [91, 365958], [98, 366218], [102, 366558]]}, {"verse": 39, "start": 368272, "end": 382303, "text": "Entonces dijo Pablo: Yo de cierto soy hombre judío, ciudadano de Tarso, ciudad no desconocida de Cilicia: pero te ruego que me permitas que hable al pueblo.", "words": [[0, 368272], [9, 369288], [14, 369508], [21, 372528], [24, 372726], [27, 372786], [34, 373386], [38, 373546], [45, 373906], [52, 374706], [62, 375246], [65, 375366], [72, 376226], [79, 376446], [82, 376746], [94, 377466], [97, 377906], [106, 378591], [111, 378733], [114, 378873], [120, 379193], [124, 379333], [127, 379433], [136, 379953], [140, 380073], [146, 380333], [149, 380413]]}, {"verse": 40, "start": 382653, "end": 394323, "text": "Y como él se lo permitió, Pablo, estando en pie en las escaleras, hizo señal con la mano al pueblo. Y hecho grande silencio, habló en lengua hebrea, diciendo:", "words": [[0, 382653], [2, 382755], [7, 382995], [10, 383195], [13, 383395], [16, 383515], [26, 384095], [33, 384595], [41, 385175], [44, 385355], [48, 385615], [51, 385895], [55, 386035], [66, 386955], [71, 387375], [77, 387895], [81, 388015], [84, 388175], [89, 388395], [92, 388575], [100, 389508], [102, 389815], [108, 390055], [115, 390375], [125, 391435], [131, 391995], [134, 392115], [141, 392595], [149, 393515]]}]}