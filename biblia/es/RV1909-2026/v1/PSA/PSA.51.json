{"book": "PSA", "chapter": 51, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 135953, "verses": [{"verse": 1, "start": 300, "end": 16282, "text": "Al Músico principal: Salmo de David, cuando después que entró a Betsabé, vino a él Natán el profeta. TEN piedad de mí, oh Dios, conforme a tu misericordia: conforme a la multitud de tus piedades borra mis rebeliones.", "words": [[0, 300], [3, 468], [10, 948], [21, 2198], [27, 2718], [30, 2858], [37, 3458], [44, 3718], [52, 4158], [56, 4338], [62, 4738], [64, 4878], [73, 5438], [78, 5998], [80, 6198], [83, 6378], [89, 6858], [92, 7058], [101, 8288], [105, 8494], [112, 8701], [115, 8961], [119, 9248], [122, 9534], [128, 9820], [137, 10461], [139, 10541], [142, 10641], [156, 12112], [165, 12721], [167, 12781], [170, 12861], [179, 13441], [182, 13601], [186, 13741], [195, 14401], [201, 15181], [205, 15341]]}, {"verse": 2, "start": 16732, "end": 21357, "text": "Lávame más y más de mi maldad, y límpiame de mi pecado.", "words": [[0, 16978], [7, 17258], [11, 17778], [13, 18058], [17, 18318], [20, 18438], [23, 18558], [31, 19058], [33, 19778], [42, 20498], [45, 20618], [48, 20698]]}, {"verse": 3, "start": 21807, "end": 26824, "text": "Porque yo reconozco mis rebeliones; y mi pecado está siempre delante de mí.", "words": [[0, 21807], [7, 21991], [10, 22191], [20, 22811], [24, 22971], [36, 24230], [38, 24353], [41, 24493], [48, 25073], [53, 25293], [61, 25673], [69, 26273], [72, 26453]]}, {"verse": 4, "start": 27274, "end": 37636, "text": "A ti, a ti solo he pecado, y he hecho lo malo delante de tus ojos: porque seas reconocido justo en tu palabra, y tenido por puro en tu juicio.", "words": [[0, 27274], [2, 27413], [6, 27673], [8, 27753], [11, 27913], [16, 28213], [19, 28413], [27, 28913], [29, 29593], [32, 29733], [38, 30173], [41, 30533], [46, 30873], [54, 31253], [57, 31413], [61, 31593], [67, 32649], [74, 32856], [79, 33156], [90, 33896], [96, 34136], [99, 34396], [102, 34516], [111, 35016], [113, 35696], [120, 36096], [124, 36316], [129, 36716], [132, 36856], [135, 36976]]}, {"verse": 5, "start": 38086, "end": 43079, "text": "He aquí, en maldad he sido formado, y en pecado me concibió mi madre.", "words": [[0, 38086], [3, 38249], [9, 38509], [12, 38669], [19, 39209], [22, 39269], [27, 39509], [36, 40069], [38, 40249], [41, 40389], [48, 40909], [51, 41089], [60, 41729], [63, 41889]]}, {"verse": 6, "start": 43529, "end": 49437, "text": "He aquí, tú amas la verdad en lo íntimo: y en lo secreto me has hecho comprender sabiduría.", "words": [[0, 43575], [3, 43655], [9, 43875], [12, 44175], [17, 44495], [20, 44595], [27, 44835], [30, 45135], [33, 45255], [41, 46173], [43, 46300], [46, 46420], [49, 46540], [57, 47120], [60, 47280], [64, 47440], [70, 47640], [81, 48559]]}, {"verse": 7, "start": 49887, "end": 56433, "text": "Purifícame con hisopo, y seré limpio: lávame, y seré emblanquecido más que la nieve.", "words": [[0, 49887], [11, 50493], [15, 50973], [23, 51453], [25, 51693], [30, 51953], [38, 53018], [46, 53546], [48, 53966], [53, 54366], [67, 55307], [71, 55546], [75, 55707], [78, 55847]]}, {"verse": 8, "start": 56883, "end": 62740, "text": "Hazme oír gozo y alegría; y se recrearán los huesos que has abatido.", "words": [[0, 56883], [6, 57360], [10, 57800], [15, 58260], [17, 58420], [26, 59427], [28, 59556], [31, 59736], [41, 60736], [45, 60916], [52, 61556], [56, 61963], [60, 62370]]}, {"verse": 9, "start": 63190, "end": 67368, "text": "Esconde tu rostro de mis pecados, y borra todas mis maldades.", "words": [[0, 63190], [8, 63638], [11, 63838], [18, 64318], [21, 64438], [25, 64558], [34, 65138], [36, 65578], [42, 65978], [48, 66238], [52, 66558]]}, {"verse": 10, "start": 67818, "end": 74256, "text": "Crea en mí, oh Dios, un corazón limpio; y renueva un espíritu recto dentro de mí.", "words": [[0, 67998], [5, 68178], [8, 68358], [12, 68608], [15, 68858], [21, 69078], [24, 69418], [32, 69818], [40, 70952], [42, 71133], [50, 71813], [53, 71973], [62, 72793], [68, 73333], [75, 73573], [78, 73913]]}, {"verse": 11, "start": 74706, "end": 78950, "text": "No me eches de delante de ti; y no quites de mí tu santo espíritu.", "words": [[0, 74706], [3, 74833], [6, 75013], [12, 75293], [15, 75533], [23, 75953], [26, 76153], [30, 76864], [32, 76987], [35, 77087], [42, 77487], [45, 77634], [48, 77780], [51, 77927], [57, 78247]]}, {"verse": 12, "start": 79400, "end": 83945, "text": "Vuélveme el gozo de tu salvación; y el espíritu libre me sustente.", "words": [[0, 79400], [9, 79757], [12, 80147], [17, 80447], [20, 80607], [23, 80727], [34, 81887], [36, 81997], [39, 82117], [48, 82617], [54, 83037], [57, 83097]]}, {"verse": 13, "start": 84395, "end": 90465, "text": "Enseñaré a los transgresores tus caminos; y los pecadores se convertirán a ti.", "words": [[0, 84395], [9, 85120], [11, 85260], [15, 85400], [29, 86320], [33, 86540], [42, 87752], [44, 87857], [48, 87957], [58, 88617], [61, 89177], [73, 89977], [75, 90077]]}, {"verse": 14, "start": 90915, "end": 98371, "text": "Líbrame de homicidios, oh Dios, Dios de mi salvación: cantará mi lengua tu justicia.", "words": [[0, 91300], [8, 91720], [11, 91880], [23, 93000], [26, 93220], [32, 93980], [37, 94320], [40, 94820], [43, 94940], [54, 96248], [62, 96788], [65, 96968], [72, 97448], [75, 97508]]}, {"verse": 15, "start": 98821, "end": 103490, "text": "Señor, abre mis labios; y publicará mi boca tu alabanza.", "words": [[0, 98821], [7, 99227], [12, 99847], [16, 100087], [24, 101153], [26, 101298], [36, 101978], [39, 102178], [44, 102438], [47, 102678]]}, {"verse": 16, "start": 103940, "end": 108797, "text": "Porque no quieres tú sacrificio, que yo daría; no quieres holocausto.", "words": [[0, 103940], [7, 104298], [10, 104518], [18, 104838], [21, 105138], [33, 106058], [37, 106178], [40, 106338], [47, 107285], [50, 107767], [58, 108282]]}, {"verse": 17, "start": 109247, "end": 117886, "text": "Los sacrificios de Dios son el espíritu quebrantado: al corazón contrito y humillado no despreciarás tú, oh Dios.", "words": [[0, 109247], [4, 109404], [16, 110284], [19, 110444], [24, 110704], [28, 111204], [31, 111404], [40, 112104], [53, 113416], [56, 113623], [64, 114063], [73, 114803], [75, 114963], [85, 115783], [88, 116323], [101, 116863], [105, 117113], [108, 117363]]}, {"verse": 18, "start": 118336, "end": 123573, "text": "Haz bien con tu benevolencia a Sion: edifica los muros de Jerusalén.", "words": [[0, 118336], [4, 118539], [9, 118799], [13, 119099], [16, 119339], [29, 119940], [31, 120541], [37, 121442], [45, 121951], [49, 122151], [55, 122591], [58, 122691]]}, {"verse": 19, "start": 124023, "end": 135553, "text": "Entonces te agradarán los sacrificios de justicia, el holocausto u ofrenda del todo quemada: entonces ofrecerán sobre tu altar becerros.", "words": [[0, 124023], [9, 124467], [12, 124787], [22, 125407], [26, 125547], [38, 126427], [41, 126527], [51, 127707], [54, 127847], [65, 128767], [67, 129207], [75, 129947], [79, 130147], [84, 130447], [93, 131581], [102, 132303], [112, 133703], [118, 134003], [121, 134263], [127, 134603]]}]}