{"book": "ISA", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 209092, "verses": [{"verse": 1, "start": 300, "end": 3946, "text": "Carga de Babilonia, que vio Isaías, hijo de Amoz.", "words": [[0, 300], [6, 524], [9, 764], [20, 1384], [24, 1564], [28, 1844], [36, 3004], [41, 3164], [44, 3585]]}, {"verse": 2, "start": 4396, "end": 12963, "text": "Levantad bandera sobre un alto monte; alzad la voz a ellos, alzad la mano, para que entren por puertas de príncipes.", "words": [[0, 4396], [9, 5001], [17, 5541], [23, 5821], [26, 6041], [31, 6241], [38, 7257], [44, 7757], [47, 8017], [51, 8257], [53, 8477], [60, 9137], [66, 9517], [69, 9677], [75, 10237], [80, 10557], [84, 10717], [91, 10977], [95, 11297], [103, 11857], [106, 12037]]}, {"verse": 3, "start": 13413, "end": 20535, "text": "Yo mandé a mis santificados, asimismo llamé a mis valientes para mi ira, a los que se alegran con mi gloria.", "words": [[0, 13413], [3, 13640], [9, 14080], [11, 14180], [15, 14320], [29, 15250], [38, 16180], [44, 16600], [46, 16660], [50, 16800], [60, 17300], [65, 17580], [68, 17820], [73, 18420], [75, 18520], [79, 18640], [83, 18780], [86, 18960], [94, 19440], [98, 19640], [101, 19860]]}, {"verse": 4, "start": 20985, "end": 33684, "text": "Murmullo de multitud en los montes, como de mucho pueblo; murmullo de ruido de reinos, de naciones reunidas: Jehová de los ejércitos ordena las tropas de la batalla.", "words": [[0, 20985], [9, 21771], [12, 21891], [21, 22471], [24, 22671], [28, 22771], [36, 23771], [41, 23951], [44, 24131], [50, 24371], [58, 25477], [67, 25862], [70, 26282], [76, 26602], [79, 26762], [87, 27762], [90, 28082], [99, 28542], [109, 29854], [116, 30360], [119, 30440], [123, 30580], [133, 31440], [140, 32160], [144, 32280], [151, 32800], [154, 32880], [157, 32980]]}, {"verse": 5, "start": 34134, "end": 42724, "text": "Vienen de lejana tierra, de lo extremo de los cielos, Jehová y los instrumentos de su furor, para destruir toda la tierra.", "words": [[0, 34134], [7, 34519], [10, 34739], [17, 35179], [25, 36019], [28, 36319], [31, 36459], [39, 37139], [42, 37199], [46, 37319], [54, 38139], [61, 38859], [63, 38999], [67, 39119], [80, 40079], [83, 40159], [86, 40299], [93, 40919], [98, 41219], [107, 41859], [112, 42099], [115, 42339]]}, {"verse": 6, "start": 43174, "end": 49688, "text": "Aullad, porque cerca está el día de Jehová; vendrá como asolamiento del Todopoderoso.", "words": [[0, 43794], [8, 44414], [15, 44774], [21, 45114], [26, 45474], [29, 45654], [33, 45854], [36, 45994], [44, 46949], [51, 47354], [56, 47574], [68, 48254], [72, 48971]]}, {"verse": 7, "start": 50138, "end": 55704, "text": "Por tanto, se debilitarán todas la manos, y se derretirá todo corazón de hombre:", "words": [[0, 50138], [4, 50260], [11, 50700], [14, 50820], [26, 51640], [32, 51960], [35, 52280], [42, 52680], [44, 53180], [47, 53360], [57, 54080], [62, 54320], [70, 54840], [73, 55140]]}, {"verse": 8, "start": 56154, "end": 69995, "text": "Y se llenarán de terror; angustias y dolores los comprenderán; tendrán dolores como mujer de parto; se asombrará cada cual al mirar a su compañero; sus rostros, rostros de llamas.", "words": [[0, 56154], [2, 56276], [5, 56456], [14, 57076], [17, 57196], [25, 58464], [35, 58894], [37, 59034], [45, 59594], [49, 59854], [63, 61165], [71, 61629], [79, 62109], [84, 62429], [90, 62849], [93, 63049], [100, 64057], [103, 64235], [113, 64975], [118, 65175], [123, 65595], [126, 65895], [132, 66215], [134, 66275], [137, 66415], [148, 67631], [152, 68118], [161, 68628], [169, 69208], [172, 69348]]}, {"verse": 9, "start": 70445, "end": 79329, "text": "He aquí el día de Jehová viene, crudo, y de saña y ardor de ira, para convertir la tierra en soledad, y raer de ella sus pecadores.", "words": [[0, 70445], [3, 70652], [8, 70952], [11, 71172], [15, 71372], [18, 71512], [25, 71912], [32, 72452], [39, 72832], [41, 72932], [44, 73052], [49, 73492], [51, 73652], [57, 74052], [60, 74192], [65, 74952], [70, 75132], [80, 75812], [83, 75932], [90, 76192], [93, 76472], [102, 76899], [104, 77325], [109, 77752], [112, 77912], [117, 78132], [121, 78352]]}, {"verse": 10, "start": 79779, "end": 92209, "text": "Por lo cual las estrellas de los cielos y sus luceros no derramarán su luz; y el sol se oscurecerá al nacer, y la luna no echará su resplandor.", "words": [[0, 79779], [4, 79901], [7, 80061], [12, 80501], [16, 81101], [26, 81761], [29, 81861], [33, 81981], [40, 82561], [42, 82681], [46, 82901], [54, 83621], [57, 84361], [68, 85321], [71, 85521], [76, 86380], [78, 86544], [81, 86724], [85, 87044], [88, 87384], [99, 88364], [102, 88584], [109, 89084], [111, 89504], [114, 89644], [119, 90084], [122, 90604], [129, 91104], [132, 91284]]}, {"verse": 11, "start": 92660, "end": 104235, "text": "Y visitaré la maldad sobre el mundo, y sobre los impíos su iniquidad; y haré que cese la arrogancia de los soberbios, y abatiré la altivez de los fuertes.", "words": [[0, 92660], [2, 92766], [11, 93366], [14, 93526], [21, 93986], [27, 94326], [30, 94546], [37, 94926], [39, 95666], [45, 95906], [49, 96126], [56, 96806], [59, 97086], [70, 98269], [72, 98503], [77, 98723], [81, 98953], [86, 99183], [89, 99343], [100, 100163], [103, 100323], [107, 100443], [118, 101363], [120, 101603], [128, 102263], [131, 102713], [139, 103163], [142, 103323], [146, 103463]]}, {"verse": 12, "start": 104685, "end": 109889, "text": "Haré más precioso que el oro fino al varón, y más que el oro de Ofir al hombre.", "words": [[0, 104786], [5, 104926], [9, 105066], [18, 105946], [22, 106146], [25, 106266], [29, 106426], [34, 106786], [37, 106986], [44, 107486], [46, 107926], [50, 108106], [54, 108326], [57, 108486], [61, 108686], [64, 108906], [69, 109226], [72, 109346]]}, {"verse": 13, "start": 110339, "end": 122492, "text": "Porque haré estremecer los cielos, y la tierra se moverá de su lugar, en la indignación de Jehová de los ejércitos, y en el día de la ira de su furor.", "words": [[0, 110339], [7, 110643], [12, 111163], [23, 112303], [27, 112623], [35, 113743], [37, 113963], [40, 114123], [47, 114403], [50, 114783], [57, 115283], [60, 115423], [63, 115603], [70, 116003], [73, 116523], [76, 116703], [88, 117663], [91, 117883], [98, 118343], [101, 118423], [105, 118985], [116, 119846], [118, 120126], [121, 120286], [124, 120546], [128, 120806], [131, 121006], [134, 121146], [138, 121506], [141, 121646], [144, 121826]]}, {"verse": 14, "start": 122942, "end": 132688, "text": "Y será que como gacela espantada, y como oveja sin pastor, cada cual mirará hacia su pueblo, y cada uno huirá a su tierra.", "words": [[0, 122942], [2, 123086], [7, 123306], [11, 123546], [16, 123966], [23, 124386], [34, 125226], [36, 125686], [41, 125946], [47, 126406], [51, 126566], [59, 127606], [64, 127826], [69, 128126], [76, 128706], [82, 129046], [85, 129366], [93, 129786], [95, 130326], [100, 130606], [104, 131006], [110, 131686], [112, 131846], [115, 131986]]}, {"verse": 15, "start": 133138, "end": 140001, "text": "Cualquiera que sea hallado, será alanceado; y cualquiera que a ellos se junte, caerá a espada.", "words": [[0, 133138], [11, 133620], [15, 133800], [19, 134040], [28, 134540], [33, 134800], [44, 136273], [46, 136381], [57, 136921], [61, 137141], [63, 137261], [69, 137421], [72, 137681], [79, 138161], [85, 139101], [87, 139261]]}, {"verse": 16, "start": 140451, "end": 147741, "text": "Sus niños serán estrellados delante de ellos; sus casas serán saqueadas, y violadas sus mujeres.", "words": [[0, 140451], [4, 140591], [10, 141031], [16, 141771], [28, 142571], [36, 143091], [39, 143311], [46, 144174], [50, 144316], [56, 144836], [62, 145176], [73, 145756], [75, 146136], [84, 146716], [88, 146936]]}, {"verse": 17, "start": 148191, "end": 154944, "text": "He aquí que yo despierto contra ellos a los medos, que no curarán de la plata, ni codiciarán oro.", "words": [[0, 148237], [3, 148307], [8, 148507], [12, 148707], [15, 148887], [25, 149467], [32, 149867], [38, 150187], [40, 150387], [44, 150507], [51, 151287], [55, 151487], [58, 151747], [66, 152347], [69, 152467], [72, 152587], [79, 153307], [82, 153607], [93, 154407]]}, {"verse": 18, "start": 155394, "end": 163736, "text": "Y con arcos tirarán a los niños, y no tendrán misericordia de fruto de vientre, ni su ojo perdonará a hijos.", "words": [[0, 155394], [2, 155522], [6, 155722], [12, 156182], [20, 156802], [22, 156882], [26, 157042], [33, 158102], [35, 158362], [38, 158502], [46, 158962], [59, 159842], [62, 159982], [68, 160342], [71, 160482], [80, 161322], [83, 161502], [86, 161742], [90, 162082], [100, 162822], [102, 163062]]}, {"verse": 19, "start": 164186, "end": 174610, "text": "Y Babilonia, hermosura de reinos y ornamento de la grandeza de los caldeos, será como Sodoma y Gomorra, a las que trastornó Dios.", "words": [[0, 164186], [2, 164324], [13, 165004], [23, 165884], [26, 166044], [33, 166704], [35, 166904], [45, 167824], [48, 168164], [51, 168284], [60, 169004], [63, 169124], [67, 169284], [76, 170284], [81, 170624], [86, 170924], [93, 171604], [95, 172254], [104, 172904], [106, 172984], [110, 173124], [114, 173264], [124, 174004]]}, {"verse": 20, "start": 175060, "end": 186751, "text": "Nunca más será habitada, ni se morará en ella de generación en generación; ni plantará allí tienda el árabe, ni pastores tendrán allí majada:", "words": [[0, 175060], [6, 175545], [10, 175845], [15, 176045], [25, 177245], [28, 177565], [31, 177805], [38, 178345], [41, 178665], [46, 178925], [49, 179145], [60, 179925], [63, 180205], [75, 181457], [78, 181808], [87, 182428], [92, 182838], [99, 183248], [102, 183468], [109, 184188], [112, 184328], [121, 185008], [129, 185868], [134, 186028]]}, {"verse": 21, "start": 187201, "end": 196757, "text": "Sino que dormirán allí bestias fieras, y sus casas se llenarán de hurones, allí habitarán hijas del búho, y allí saltarán peludos.", "words": [[0, 187201], [5, 187442], [9, 187682], [18, 188302], [23, 188522], [31, 189042], [39, 189662], [41, 190142], [45, 190282], [51, 190862], [54, 191022], [63, 191562], [66, 192072], [75, 192582], [80, 192842], [90, 193352], [96, 193862], [100, 194182], [106, 194502], [108, 195122], [113, 195362], [122, 195962]]}, {"verse": 22, "start": 197207, "end": 208692, "text": "Y en sus palacios gritarán gatos cervales, y chacales en sus casas de deleite: y cercano está a venir su tiempo, y sus días no se alargarán.", "words": [[0, 197207], [2, 197349], [5, 197449], [9, 197609], [18, 198289], [27, 198909], [33, 199609], [43, 200309], [45, 200809], [54, 201389], [57, 201629], [61, 201769], [67, 202309], [70, 202449], [79, 203519], [81, 203779], [89, 204339], [94, 204599], [96, 204779], [102, 205019], [105, 205259], [113, 205739], [115, 206199], [119, 206359], [124, 206679], [127, 207279], [130, 207539]]}]}