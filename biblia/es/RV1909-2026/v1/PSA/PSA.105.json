{"book": "PSA", "chapter": 105, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 253826, "verses": [{"verse": 1, "start": 300, "end": 7171, "text": "Alabad a Jehová, invocad su nombre: haced notorias sus obras en los pueblos.", "words": [[0, 300], [7, 823], [9, 1003], [17, 2203], [25, 2823], [28, 3023], [36, 4079], [42, 4632], [51, 5222], [55, 5482], [61, 5922], [64, 6182], [68, 6322]]}, {"verse": 2, "start": 7621, "end": 12596, "text": "Cantadle, cantadle salmos: hablad de todas sus maravillas.", "words": [[0, 7621], [10, 8821], [19, 9561], [27, 10700], [34, 10830], [37, 11170], [43, 11350], [47, 11630]]}, {"verse": 3, "start": 13046, "end": 19526, "text": "Gloriaos en su santo nombre: alégrese el corazón de los que buscan a Jehová.", "words": [[0, 13374], [9, 13734], [12, 14014], [15, 14194], [21, 14634], [29, 15938], [38, 16398], [41, 16738], [49, 17298], [52, 17658], [56, 17778], [60, 17938], [67, 18358], [69, 18478]]}, {"verse": 4, "start": 19976, "end": 24744, "text": "Buscad a Jehová, y su fortaleza: buscad siempre su rostro.", "words": [[0, 19976], [7, 19976], [9, 20244], [17, 20884], [19, 21004], [22, 21144], [33, 22619], [40, 22799], [48, 23399], [51, 23859]]}, {"verse": 5, "start": 25194, "end": 31842, "text": "Acordaos de sus maravillas que hizo, de sus prodigios y de los juicios de su boca,", "words": [[0, 25478], [9, 25798], [12, 25958], [16, 26098], [27, 26718], [31, 26918], [37, 27818], [40, 27898], [44, 28078], [54, 28938], [56, 29318], [59, 29418], [63, 29578], [71, 29958], [74, 30138], [77, 30318]]}, {"verse": 6, "start": 32292, "end": 37642, "text": "Oh vosotros, descendencia de Abraham su siervo, hijos de Jacob, sus escogidos.", "words": [[0, 32577], [3, 32862], [13, 33147], [26, 33432], [29, 33612], [37, 34312], [40, 34412], [48, 35392], [54, 35632], [57, 35872], [64, 36592], [68, 36732]]}, {"verse": 7, "start": 38092, "end": 42701, "text": "Él es Jehová nuestro Dios; en toda la tierra son sus juicios.", "words": [[0, 38289], [3, 38524], [6, 38759], [13, 38994], [21, 39294], [27, 40184], [30, 40338], [35, 40578], [38, 40798], [45, 41118], [49, 41558], [53, 41818]]}, {"verse": 8, "start": 43151, "end": 48601, "text": "Se acordó para siempre de su pacto; de la palabra que mandó para mil generaciones,", "words": [[0, 43151], [3, 43276], [10, 43736], [15, 43916], [23, 44336], [26, 44536], [29, 44676], [36, 45431], [39, 46053], [42, 46173], [50, 46513], [54, 46733], [60, 47133], [65, 47313], [69, 47573]]}, {"verse": 9, "start": 49051, "end": 53359, "text": "La cual concertó con Abraham; y de su juramento a Isaac.", "words": [[0, 49051], [3, 49176], [8, 49376], [17, 50136], [21, 50316], [30, 51464], [32, 51573], [35, 51693], [38, 51853], [48, 52513], [50, 52733]]}, {"verse": 10, "start": 53809, "end": 59405, "text": "Y la estableció a Jacob por decreto, a Israel por pacto sempiterno,", "words": [[0, 53809], [2, 53900], [5, 54030], [16, 54650], [18, 54810], [24, 55150], [28, 55590], [37, 56870], [39, 56970], [46, 57370], [50, 58065], [56, 58761]]}, {"verse": 11, "start": 59855, "end": 64747, "text": "Diciendo: A ti daré la tierra de Canaán por cordel de vuestra heredad.", "words": [[0, 59855], [10, 60989], [12, 61150], [15, 61350], [20, 61770], [23, 61830], [30, 62130], [33, 62330], [40, 62770], [44, 63090], [51, 63550], [54, 63710], [62, 64050]]}, {"verse": 12, "start": 65097, "end": 69862, "text": "Esto siendo ellos pocos hombres en número, y extranjeros en ella.", "words": [[0, 65097], [5, 65903], [12, 66183], [18, 66463], [24, 66963], [32, 67243], [35, 67503], [43, 67923], [45, 68383], [57, 69223], [60, 69403]]}, {"verse": 13, "start": 70312, "end": 74605, "text": "Y anduvieron de nación en nación, de un reino a otro pueblo.", "words": [[0, 70312], [2, 70649], [13, 71019], [16, 71159], [23, 71559], [26, 71759], [34, 72279], [37, 72899], [40, 73079], [46, 73519], [48, 73639], [53, 73839]]}, {"verse": 14, "start": 75055, "end": 81080, "text": "No consintió que hombre los agraviase; y por causa de ellos castigó los reyes.", "words": [[0, 75055], [3, 75184], [13, 75884], [17, 76084], [24, 76424], [28, 76684], [39, 77982], [41, 78105], [45, 78305], [51, 78845], [54, 79105], [60, 79385], [68, 80125], [72, 80285]]}, {"verse": 15, "start": 81380, "end": 87775, "text": "No toquéis, dijo, a mis ungidos, ni hagáis mal a mis profetas.", "words": [[0, 81380], [3, 81557], [12, 83731], [18, 84555], [20, 84677], [24, 84817], [33, 85397], [36, 85677], [43, 85997], [47, 86277], [49, 86537], [53, 86657]]}, {"verse": 16, "start": 88125, "end": 93151, "text": "Y llamó al hambre sobre la tierra, y quebrantó todo mantenimiento de pan.", "words": [[0, 88125], [2, 88246], [8, 88586], [11, 88726], [18, 89086], [24, 89326], [27, 89586], [35, 90086], [37, 90666], [47, 91326], [52, 91546], [66, 92426], [69, 92626]]}, {"verse": 17, "start": 93601, "end": 97920, "text": "Envió un varón delante de ellos, a José, que fue vendido por siervo.", "words": [[0, 93601], [6, 93928], [9, 94088], [15, 94468], [23, 94868], [26, 95048], [33, 95328], [35, 95528], [41, 96128], [45, 96348], [49, 96548], [57, 97028], [61, 97188]]}, {"verse": 18, "start": 98370, "end": 103278, "text": "Afligieron sus pies con grillos; en hierro fue puesta su persona.", "words": [[0, 98370], [11, 99170], [15, 99390], [20, 99690], [24, 99990], [33, 101118], [36, 101315], [43, 101755], [47, 101935], [54, 102395], [57, 102495]]}, {"verse": 19, "start": 103728, "end": 107487, "text": "Hasta la hora que llegó su palabra, el dicho de Jehová le probó.", "words": [[0, 103728], [6, 103934], [9, 104134], [14, 104294], [18, 104474], [24, 104734], [27, 104934], [36, 105754], [39, 105854], [45, 106114], [48, 106314], [55, 106754], [58, 106814]]}, {"verse": 20, "start": 107937, "end": 113051, "text": "Envió el rey, y le soltó; el señor de los pueblos, y le desató.", "words": [[0, 107937], [6, 108179], [9, 108459], [14, 109139], [16, 109299], [19, 109736], [26, 110414], [29, 110539], [35, 110899], [38, 111159], [42, 111299], [51, 111979], [53, 112179], [56, 112279]]}, {"verse": 21, "start": 113501, "end": 119205, "text": "Lo puso por señor de su casa, y por gobernador de todas sus posesiones;", "words": [[0, 113501], [3, 113642], [8, 114062], [12, 114282], [18, 114602], [21, 114862], [24, 115022], [30, 115402], [32, 116022], [36, 116262], [47, 117022], [50, 117242], [56, 117522], [60, 117862]]}, {"verse": 22, "start": 119655, "end": 126899, "text": "Para que reprimiera a sus grandes como él quisiese, y a sus ancianos enseñara sabiduría.", "words": [[0, 119655], [5, 119841], [9, 120061], [20, 121061], [22, 121301], [26, 121461], [34, 121941], [39, 122341], [42, 122581], [52, 123241], [54, 123981], [56, 124081], [60, 124221], [69, 125101], [78, 125981]]}, {"verse": 23, "start": 127349, "end": 133126, "text": "Después entró Israel en Egipto, y Jacob fue extranjero en la tierra de Cam.", "words": [[0, 127349], [8, 127667], [14, 128207], [21, 128587], [24, 128927], [32, 129607], [34, 130067], [40, 130387], [44, 130867], [55, 131687], [58, 131787], [61, 131907], [68, 132267], [71, 132487]]}, {"verse": 24, "start": 133576, "end": 138184, "text": "Y multiplicó su pueblo en gran manera, y lo hizo fuerte más que sus enemigos.", "words": [[0, 133576], [2, 133701], [13, 134381], [16, 134521], [23, 134961], [26, 135141], [31, 135361], [39, 135881], [41, 136061], [44, 136221], [49, 136421], [56, 136821], [60, 137081], [64, 137241], [68, 137421]]}, {"verse": 25, "start": 138634, "end": 145468, "text": "Volvió el corazón de ellos para que aborreciesen a su pueblo, para que contra sus siervos pensasen mal.", "words": [[0, 138634], [7, 139121], [10, 139221], [18, 139641], [21, 139941], [27, 140161], [32, 140461], [36, 140621], [49, 141341], [51, 141481], [54, 141621], [62, 142181], [67, 142581], [71, 142741], [78, 143081], [82, 143301], [90, 144151], [99, 145001]]}, {"verse": 26, "start": 145918, "end": 150060, "text": "Envió a su siervo Moisés, y a Aarón al cual escogió.", "words": [[0, 145918], [6, 146380], [8, 146600], [11, 146760], [18, 147180], [26, 147720], [28, 148100], [30, 148430], [36, 148760], [39, 148880], [44, 149140]]}, {"verse": 27, "start": 150510, "end": 156202, "text": "Pusieron en ellos las palabras de sus señales, y sus prodigios en la tierra de Cam.", "words": [[0, 150510], [9, 150994], [12, 151174], [18, 151434], [22, 151674], [31, 152094], [34, 152334], [38, 152494], [47, 153534], [49, 153694], [53, 153854], [63, 154614], [66, 154814], [69, 154994], [76, 155314], [79, 155574]]}, {"verse": 28, "start": 156652, "end": 162233, "text": "Echó tinieblas, e hizo oscuridad; y no fueron rebeldes a su palabra.", "words": [[0, 156848], [5, 157068], [16, 157908], [18, 158108], [23, 158448], [34, 159870], [36, 159995], [39, 160115], [46, 160435], [55, 161215], [57, 161355], [60, 161475]]}, {"verse": 29, "start": 162683, "end": 166306, "text": "Volvió sus aguas en sangre, y mató sus pescados.", "words": [[0, 162683], [7, 163125], [11, 163265], [17, 163725], [20, 163885], [28, 164345], [30, 164825], [35, 165165], [39, 165345]]}, {"verse": 30, "start": 166756, "end": 171018, "text": "Produjo su tierra ranas, aun en las cámaras de sus reyes.", "words": [[0, 166756], [8, 167180], [11, 167380], [18, 167740], [25, 168840], [29, 169260], [32, 169480], [36, 169640], [44, 170160], [47, 170260], [51, 170420]]}, {"verse": 31, "start": 171468, "end": 176625, "text": "Dijo, y vinieron enjambres de moscas, y piojos en todo su término.", "words": [[0, 171468], [6, 171793], [8, 172293], [17, 172893], [27, 173493], [30, 173633], [38, 174253], [40, 174513], [47, 174973], [50, 175233], [55, 175553], [58, 175813]]}, {"verse": 32, "start": 177075, "end": 181701, "text": "Volvió en su tierra sus lluvias en granizo, y en fuego de llamaradas.", "words": [[0, 177075], [7, 177561], [10, 177661], [13, 177821], [20, 178181], [24, 178481], [32, 179021], [35, 179201], [44, 179741], [46, 180221], [49, 180361], [55, 180621], [58, 180881]]}, {"verse": 33, "start": 182151, "end": 187746, "text": "E hirió sus viñas y sus higueras, y quebró los árboles de su término.", "words": [[0, 182151], [2, 182297], [8, 182777], [12, 182997], [18, 183677], [20, 183957], [24, 184137], [34, 184717], [36, 185237], [43, 185637], [47, 185817], [55, 186457], [58, 186817], [61, 186997]]}, {"verse": 34, "start": 188196, "end": 192631, "text": "Dijo, y vinieron langostas, y pulgón sin número;", "words": [[0, 188196], [6, 189102], [8, 189322], [17, 189782], [28, 190842], [30, 191162], [37, 191722], [41, 191982]]}, {"verse": 35, "start": 193081, "end": 197912, "text": "Y comieron toda la hierba de su país, y devoraron el fruto de su tierra.", "words": [[0, 193081], [2, 193326], [11, 193746], [16, 194026], [19, 194266], [26, 194686], [29, 194826], [32, 194986], [38, 195366], [40, 195826], [50, 196386], [53, 196606], [59, 197006], [62, 197126], [65, 197266]]}, {"verse": 36, "start": 198362, "end": 204044, "text": "Hirió además a todos los primogénitos en su tierra, el principio de toda su fuerza.", "words": [[0, 198525], [6, 198725], [13, 199125], [15, 199325], [21, 199545], [25, 199765], [38, 200525], [41, 200705], [44, 200845], [52, 201265], [55, 201865], [65, 202605], [68, 202905], [73, 203105], [76, 203385]]}, {"verse": 37, "start": 204494, "end": 209335, "text": "Y los sacó con plata y oro; y no hubo en sus tribus enfermo.", "words": [[0, 204494], [2, 204586], [6, 204706], [11, 205226], [15, 205466], [21, 205766], [23, 206126], [28, 206957], [30, 207217], [33, 207377], [38, 207837], [41, 207957], [45, 208157], [52, 208577]]}, {"verse": 38, "start": 209785, "end": 215406, "text": "Egipto se alegró de que salieran; porque su terror había caído sobre ellos.", "words": [[0, 209785], [7, 210372], [10, 210532], [17, 210992], [20, 211072], [24, 211654], [34, 212476], [41, 212680], [44, 212880], [51, 213400], [57, 213760], [63, 214300], [69, 214620]]}, {"verse": 39, "start": 215856, "end": 221585, "text": "Extendió una nube por cubierta, y fuego para alumbrar la noche.", "words": [[0, 215856], [9, 216641], [13, 217021], [18, 217461], [22, 217741], [32, 218661], [34, 219181], [40, 219621], [45, 220001], [54, 220661], [57, 220921]]}, {"verse": 40, "start": 222035, "end": 227100, "text": "Pidieron, e hizo venir codornices; y los sació de pan del cielo.", "words": [[0, 222035], [10, 222519], [12, 222859], [17, 223139], [23, 223479], [35, 225103], [37, 225225], [41, 225385], [47, 225805], [50, 225945], [54, 226225], [58, 226445]]}, {"verse": 41, "start": 227550, "end": 232782, "text": "Abrió la peña, y fluyeron aguas; corrieron por los lugares secos como un río.", "words": [[0, 227550], [6, 227859], [9, 228019], [15, 228419], [17, 228579], [26, 229139], [33, 230125], [43, 230587], [47, 230707], [51, 230887], [59, 231227], [65, 231807], [70, 231987], [73, 232207]]}, {"verse": 42, "start": 233232, "end": 237814, "text": "Porque se acordó de su santa palabra, dada a Abraham su siervo.", "words": [[0, 233232], [7, 233395], [10, 233615], [17, 234095], [20, 234195], [23, 234335], [29, 234735], [38, 235675], [43, 236175], [45, 236415], [53, 236655], [56, 237095]]}, {"verse": 43, "start": 238264, "end": 242657, "text": "Y sacó a su pueblo con gozo; con júbilo a sus escogidos.", "words": [[0, 238264], [2, 238385], [7, 238785], [9, 238885], [12, 239005], [19, 239385], [23, 239665], [29, 240662], [33, 240828], [40, 241428], [42, 241588], [46, 241708]]}, {"verse": 44, "start": 243107, "end": 247863, "text": "Y les dio las tierras de las naciones; y heredaron las labores de los pueblos:", "words": [[0, 243107], [2, 243234], [6, 243394], [10, 243574], [14, 243754], [22, 244314], [25, 244454], [29, 244594], [39, 245629], [41, 245776], [51, 246336], [55, 246516], [63, 246976], [66, 247116], [70, 247216]]}, {"verse": 45, "start": 248313, "end": 253426, "text": "Para que guardasen sus estatutos, y observasen sus leyes. Aleluya.", "words": [[0, 248313], [5, 248457], [9, 248897], [19, 249337], [23, 249517], [34, 250217], [36, 250817], [47, 251417], [51, 251597], [58, 253020]]}]}