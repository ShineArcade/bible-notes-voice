{"book": "GEN", "chapter": 32, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 255998, "verses": [{"verse": 1, "start": 300, "end": 5465, "text": "Y Jacob se fue su camino, y le salieron al encuentro ángeles de Dios.", "words": [[0, 519], [2, 773], [8, 1026], [11, 1106], [15, 1326], [18, 1506], [26, 2006], [28, 2746], [31, 2866], [40, 3426], [43, 3606], [53, 4206], [61, 4686], [64, 4866]]}, {"verse": 2, "start": 5815, "end": 13476, "text": "Y dijo Jacob cuando los vio: El campo de Dios es este: y llamó el nombre de aquel lugar Mahanaim.", "words": [[0, 5815], [2, 5960], [7, 6240], [13, 6660], [20, 7100], [24, 7540], [29, 8142], [32, 8260], [38, 8580], [41, 8780], [46, 9060], [49, 9460], [55, 10379], [57, 10486], [63, 10846], [66, 10946], [73, 11306], [76, 11526], [82, 11906], [88, 12186]]}, {"verse": 3, "start": 13826, "end": 21088, "text": "Y envió Jacob mensajeros delante de sí a Esaú su hermano, a la tierra de Seir, campo de Edom.", "words": [[0, 13826], [2, 13970], [8, 14350], [14, 15050], [25, 15750], [33, 16250], [36, 16430], [39, 16870], [41, 17170], [46, 17470], [49, 17590], [58, 18390], [60, 18490], [63, 18570], [70, 18910], [73, 19380], [79, 19850], [85, 20250], [88, 20510]]}, {"verse": 4, "start": 21438, "end": 29593, "text": "Y les mandó diciendo: Así diréis a mi señor Esaú: Así dice tu siervo Jacob: Con Labán he morado, y me he detenido hasta ahora;", "words": [[0, 21438], [2, 21726], [6, 21866], [12, 22306], [22, 23310], [26, 23491], [33, 23891], [35, 24161], [38, 24431], [44, 24701], [50, 25139], [54, 25321], [59, 25601], [62, 25761], [69, 26226], [76, 26944], [80, 27074], [86, 27204], [89, 27334], [97, 27794], [99, 28134], [102, 28314], [105, 28394], [114, 28894], [120, 29134]]}, {"verse": 5, "start": 29943, "end": 37220, "text": "Y tengo vacas, y asnos, y ovejas, y siervos y siervas; y envío a decirlo a mi señor, por hallar gracia en tus ojos.", "words": [[0, 29943], [2, 30032], [8, 30252], [15, 30732], [17, 30872], [24, 31252], [26, 31472], [34, 31912], [36, 32112], [44, 32512], [46, 32692], [55, 33566], [57, 33668], [63, 34048], [65, 34148], [73, 34648], [75, 34748], [78, 34848], [85, 35568], [89, 35708], [96, 35988], [103, 36388], [106, 36468], [110, 36588]]}, {"verse": 6, "start": 37500, "end": 45403, "text": "Y los mensajeros volvieron a Jacob, diciendo: Vinimos a tu hermano Esaú, y él también viene a recibirte, y cuatrocientos hombres con él.", "words": [[0, 37500], [2, 37604], [6, 37704], [17, 38284], [27, 38824], [29, 39044], [36, 39444], [46, 39916], [54, 40335], [56, 40475], [59, 40575], [67, 40975], [73, 41395], [75, 41915], [78, 42055], [86, 42355], [92, 42695], [94, 42855], [105, 43495], [107, 43785], [121, 44075], [129, 44795], [133, 45135]]}, {"verse": 7, "start": 45683, "end": 55655, "text": "Entonces Jacob tuvo gran temor, y se angustió; y partió el pueblo que tenía consigo, y las ovejas y las vacas y los camellos, en dos cuadrillas;", "words": [[0, 45683], [9, 46587], [15, 46930], [20, 47350], [25, 47730], [32, 48150], [34, 48350], [37, 48490], [47, 49551], [49, 49661], [56, 50061], [59, 50201], [66, 50541], [70, 50841], [76, 51181], [85, 51801], [87, 52006], [91, 52146], [98, 52706], [100, 52966], [104, 53106], [110, 53526], [112, 53646], [116, 53786], [126, 54406], [129, 54586], [133, 54786]]}, {"verse": 8, "start": 56005, "end": 61433, "text": "Y dijo: Si viene Esaú contra un campamento y lo ataca, el otro campamento escapará.", "words": [[0, 56005], [2, 56149], [8, 56867], [11, 57103], [17, 57343], [22, 57583], [29, 57843], [32, 58043], [43, 58643], [45, 58763], [48, 58863], [55, 59703], [58, 59803], [63, 59983], [74, 60663]]}, {"verse": 9, "start": 61713, "end": 70658, "text": "Y dijo Jacob: Dios de mi padre Abraham, y Dios de mi padre Isaac, Jehová, que me dijiste: Vuélvete a tu tierra y a tu parentela, y yo te haré bien;", "words": [[0, 61713], [2, 61841], [7, 62081], [14, 62845], [19, 63067], [22, 63247], [25, 63347], [31, 63727], [40, 64107], [42, 64362], [47, 64562], [50, 64722], [53, 64822], [59, 65222], [66, 65862], [74, 66462], [78, 66522], [81, 66642], [90, 67481], [99, 67966], [101, 68066], [104, 68186], [111, 68486], [113, 68706], [115, 68786], [118, 68886], [129, 69486], [131, 69886], [134, 70006], [137, 70126], [142, 70346]]}, {"verse": 10, "start": 71008, "end": 80982, "text": "Menor soy que todas las misericordias, y que toda la verdad que has usado para con tu siervo; que con mi bastón pasé este Jordán, y ahora estoy sobre dos cuadrillas.", "words": [[0, 71008], [6, 71247], [10, 71527], [14, 71687], [20, 71907], [24, 72147], [39, 73087], [41, 73507], [45, 73627], [50, 73887], [53, 74067], [60, 74327], [64, 74647], [68, 74747], [74, 75127], [79, 75367], [83, 75607], [86, 75727], [94, 76496], [98, 76592], [102, 76772], [105, 76932], [112, 77352], [117, 77752], [122, 77932], [130, 78372], [132, 78912], [138, 79212], [144, 79552], [150, 79872], [154, 80132]]}, {"verse": 11, "start": 81332, "end": 88335, "text": "Líbrame ahora de la mano de mi hermano, de la mano de Esaú, porque le temo; no venga quizá, y me hiera la madre con los hijos.", "words": [[0, 81332], [8, 81756], [14, 81976], [17, 82156], [20, 82276], [25, 82496], [28, 82656], [31, 82776], [40, 83516], [43, 83596], [46, 83696], [51, 83896], [54, 84296], [60, 84696], [67, 84856], [70, 85036], [76, 85765], [79, 85865], [85, 86145], [92, 86795], [94, 86935], [97, 87055], [103, 87315], [106, 87415], [112, 87675], [116, 87875], [120, 88075]]}, {"verse": 12, "start": 88685, "end": 95333, "text": "Y tú has dicho: Yo te haré bien, y pondré tu simiente como la arena del mar, que no se puede contar por la multitud.", "words": [[0, 88745], [2, 89030], [5, 89190], [9, 89330], [16, 90064], [19, 90209], [22, 90369], [27, 90609], [33, 90829], [35, 91189], [42, 91589], [45, 91749], [54, 92269], [59, 92549], [62, 92729], [68, 92969], [72, 93169], [77, 93369], [81, 93589], [84, 93729], [87, 93889], [93, 94089], [100, 94429], [104, 94649], [107, 94789]]}, {"verse": 13, "start": 95613, "end": 101725, "text": "Y durmió allí aquella noche, y tomó de lo que le vino a la mano un presente para su hermano Esaú:", "words": [[0, 95613], [2, 95739], [9, 96239], [14, 96519], [22, 96979], [29, 97339], [31, 97979], [36, 98399], [39, 98479], [42, 98619], [46, 98759], [49, 98879], [54, 99139], [56, 99319], [59, 99399], [64, 99639], [67, 99799], [76, 100179], [81, 100639], [84, 100839], [92, 101309]]}, {"verse": 14, "start": 102075, "end": 107308, "text": "Doscientas cabras y veinte machos cabríos, doscientas ovejas y veinte carneros,", "words": [[0, 102300], [11, 102560], [18, 103180], [20, 103380], [27, 103580], [34, 104173], [43, 104767], [54, 105360], [61, 106020], [63, 106469], [70, 106918]]}, {"verse": 15, "start": 107658, "end": 113963, "text": "Treinta camellas paridas, con sus hijos, cuarenta vacas y diez novillos, veinte asnas y diez borricos.", "words": [[0, 107944], [8, 108264], [17, 108584], [26, 109004], [30, 109224], [34, 109444], [41, 110024], [50, 110604], [56, 111124], [58, 111284], [63, 111444], [73, 112004], [80, 112564], [86, 113224], [88, 113492], [93, 113759]]}, {"verse": 16, "start": 114313, "end": 124320, "text": "Y lo entregó en mano de sus siervos, cada manada de por sí; y dijo a sus siervos: Pasad delante de mí, y poned espacio entre manada y manada.", "words": [[0, 114780], [2, 115040], [5, 115140], [13, 115620], [16, 115720], [21, 115940], [24, 116100], [28, 116590], [37, 117080], [42, 117400], [49, 117900], [52, 118080], [56, 118280], [60, 118895], [62, 119071], [67, 119281], [69, 119441], [73, 119581], [82, 120718], [88, 120878], [96, 121338], [99, 121498], [103, 121658], [105, 122085], [111, 122511], [119, 122938], [125, 123158], [132, 123598], [134, 123798]]}, {"verse": 17, "start": 124600, "end": 135329, "text": "Y mandó al primero, diciendo: Si Esaú mi hermano te encuentra, y te pregunta, diciendo: ¿De quién eres? ¿y adónde vas? ¿y para quién es esto que llevas delante de ti?", "words": [[0, 124600], [2, 124741], [8, 125021], [11, 125301], [20, 125701], [30, 126820], [33, 127039], [38, 127293], [41, 127546], [49, 127926], [52, 128026], [63, 128486], [65, 128646], [68, 128766], [78, 129286], [88, 130579], [92, 130737], [98, 130937], [104, 131696], [107, 131874], [114, 132154], [119, 132847], [122, 132929], [127, 133109], [133, 133349], [136, 133569], [141, 133869], [145, 134009], [152, 134369], [160, 134789], [163, 134969]]}, {"verse": 18, "start": 135679, "end": 142986, "text": "Entonces dirás: Es un regalo de tu siervo Jacob, que envía a mi señor Esaú; y he aquí también él viene tras nosotros.", "words": [[0, 135679], [9, 136114], [16, 137055], [19, 137179], [22, 137299], [29, 137699], [32, 137819], [35, 137959], [42, 138379], [49, 138699], [53, 139039], [59, 139399], [61, 139479], [64, 139559], [70, 139879], [76, 140670], [78, 140721], [81, 140811], [86, 141031], [94, 141371], [97, 141731], [103, 141951], [108, 142231]]}, {"verse": 19, "start": 143266, "end": 154063, "text": "Y mandó también al segundo, y al tercero, y a todos los que iban tras aquellas manadas, diciendo: Conforme a esto hablaréis a Esaú, cuando lo encontréis.", "words": [[0, 143266], [2, 143429], [8, 143789], [16, 144209], [19, 144529], [28, 145129], [30, 145534], [33, 145714], [42, 146634], [44, 146914], [46, 146994], [52, 147314], [56, 147634], [60, 147854], [65, 148194], [70, 148394], [79, 148954], [88, 149474], [98, 151041], [107, 151402], [109, 151542], [114, 151782], [124, 152302], [126, 152442], [132, 152742], [139, 153102], [142, 153302]]}, {"verse": 20, "start": 154413, "end": 165784, "text": "Y diréis también: He aquí tu siervo Jacob viene tras nosotros. Porque dijo: Apaciguaré su ira con el regalo que va delante de mí, y después veré su rostro: quizá me reciba bien.", "words": [[0, 154413], [2, 154513], [9, 154833], [18, 155728], [21, 155808], [26, 156008], [29, 156208], [36, 156568], [42, 156868], [48, 157268], [53, 157548], [63, 158676], [70, 158846], [76, 159886], [87, 160206], [90, 160346], [94, 160626], [98, 160786], [101, 160926], [108, 161306], [112, 161446], [115, 161586], [123, 162006], [126, 162166], [130, 162366], [132, 162826], [140, 163126], [145, 163586], [148, 163666], [156, 164475], [162, 164859], [165, 164959], [172, 165419]]}, {"verse": 21, "start": 166064, "end": 172283, "text": "Y pasó el presente delante de él; y él durmió aquella noche en el campamento.", "words": [[0, 166064], [2, 166214], [7, 166634], [10, 166994], [19, 167554], [27, 168234], [30, 168434], [34, 169150], [36, 169572], [39, 169692], [46, 170152], [54, 170612], [60, 171072], [63, 171212], [66, 171332]]}, {"verse": 22, "start": 172633, "end": 181516, "text": "Y se levantó aquella noche, y tomó sus dos mujeres, y sus dos siervas, y sus once hijos, y pasó el vado de Jaboc.", "words": [[0, 172633], [2, 172757], [5, 172877], [13, 173457], [21, 173797], [28, 174777], [30, 175117], [35, 175457], [39, 175637], [43, 175817], [52, 176297], [54, 176637], [58, 176777], [62, 176997], [71, 177617], [73, 177997], [77, 178157], [82, 178617], [89, 179017], [91, 179677], [96, 180037], [99, 180437], [104, 180797], [107, 181189]]}, {"verse": 23, "start": 181866, "end": 186889, "text": "Los tomó pues, y los hizo pasar el arroyo, e hizo pasar lo que tenía.", "words": [[0, 181866], [4, 182014], [9, 182374], [15, 182794], [17, 183134], [21, 183314], [26, 183614], [32, 183994], [35, 184214], [43, 185134], [45, 185314], [50, 185554], [56, 185834], [59, 186094], [63, 186234]]}, {"verse": 24, "start": 187239, "end": 192358, "text": "Y se quedó Jacob solo, y luchó con él un varón hasta que rayaba el alba.", "words": [[0, 187239], [2, 187385], [5, 187465], [11, 187805], [17, 188085], [23, 188605], [25, 189185], [31, 189585], [35, 189765], [38, 189945], [41, 190165], [47, 190665], [53, 190925], [57, 191105], [64, 191605], [67, 191765]]}, {"verse": 25, "start": 192708, "end": 201575, "text": "Y cuando vio que no podía con él, tocó en la coyuntura de su cadera, y se dislocó la cadera de Jacob mientras con él luchaba.", "words": [[0, 192708], [2, 192833], [9, 193073], [13, 193453], [17, 193613], [20, 193773], [26, 194153], [30, 194433], [34, 195033], [39, 195373], [42, 195533], [45, 195673], [55, 196313], [58, 196473], [61, 196633], [69, 197113], [71, 197593], [74, 198073], [82, 198553], [85, 198693], [92, 199113], [95, 199233], [101, 199633], [110, 200233], [114, 200653], [117, 200793]]}, {"verse": 26, "start": 201925, "end": 207461, "text": "Y dijo: Déjame, que raya el alba. Y él dijo: No te dejaré, si no me bendices.", "words": [[0, 201925], [2, 202069], [8, 202813], [16, 203190], [20, 203370], [25, 203770], [28, 203890], [34, 204569], [36, 204757], [39, 204917], [45, 205636], [48, 205817], [51, 205977], [59, 206417], [62, 206537], [65, 206617], [68, 206737]]}, {"verse": 27, "start": 207741, "end": 211945, "text": "Y él le dijo: ¿Cuál es tu nombre? Y él respondió: Jacob.", "words": [[0, 207741], [2, 207909], [5, 208049], [8, 208209], [14, 208933], [20, 209134], [23, 209274], [26, 209394], [34, 210171], [36, 210353], [39, 210493], [50, 211725]]}, {"verse": 28, "start": 212225, "end": 219640, "text": "Y él dijo: No se dirá más tu nombre Jacob, sino Israel: porque has peleado con Dios y con los hombres, y has vencido.", "words": [[0, 212225], [2, 212413], [5, 212573], [11, 213292], [14, 213429], [17, 213549], [22, 213849], [26, 213969], [29, 214189], [36, 214549], [43, 215269], [48, 215429], [56, 216348], [63, 216527], [67, 216707], [75, 217187], [79, 217387], [84, 217627], [86, 217867], [90, 218007], [94, 218147], [103, 218527], [105, 218827], [109, 218987]]}, {"verse": 29, "start": 219920, "end": 228702, "text": "Entonces Jacob le preguntó, y dijo: Dime ahora tu nombre. Y él respondió: ¿Por qué preguntas por mi nombre? Y lo bendijo allí.", "words": [[0, 219920], [9, 220665], [15, 220925], [18, 221285], [28, 221925], [30, 222105], [36, 222766], [41, 223024], [47, 223244], [50, 223444], [58, 224231], [60, 224413], [63, 224553], [74, 225548], [79, 225708], [83, 225828], [93, 226268], [97, 226588], [100, 226728], [108, 227471], [110, 227581], [113, 227721], [121, 228221]]}, {"verse": 30, "start": 229052, "end": 236051, "text": "Y llamó Jacob el nombre de aquel lugar, Peniel: porque vi a Dios cara a cara, y fue librada mi alma.", "words": [[0, 229052], [2, 229160], [8, 229520], [14, 229740], [17, 230080], [24, 230420], [27, 230640], [33, 231000], [40, 231700], [48, 232603], [55, 233438], [58, 233634], [60, 233774], [65, 233994], [70, 234294], [72, 234454], [78, 234714], [80, 234899], [84, 235079], [92, 235479], [95, 235639]]}, {"verse": 31, "start": 236331, "end": 241305, "text": "Y le salió el sol después que hubo pasado Peniel; y cojeaba de su cadera.", "words": [[0, 236331], [2, 236457], [5, 236557], [11, 236957], [14, 237137], [18, 237357], [26, 237777], [30, 238017], [35, 238237], [42, 238577], [50, 239443], [52, 239900], [60, 240360], [63, 240520], [66, 240660]]}, {"verse": 32, "start": 241655, "end": 255598, "text": "Por esto no comen los hijos de Israel, hasta hoy día, del tendón que se contrajo, el cual está en el encaje del muslo: porque tocó a Jacob este sitio de su muslo en el tendón que se contrajo.", "words": [[0, 241655], [4, 241799], [9, 242019], [12, 242259], [18, 242579], [22, 242819], [28, 243159], [31, 243319], [39, 243879], [45, 244359], [49, 244719], [54, 245239], [58, 245879], [65, 246399], [69, 246519], [72, 246679], [82, 247419], [85, 248079], [90, 248319], [95, 248759], [98, 249019], [101, 249179], [108, 249819], [112, 249979], [119, 250897], [126, 251081], [131, 251601], [133, 251701], [139, 252041], [144, 252441], [150, 252881], [153, 253061], [156, 253221], [162, 253721], [165, 253961], [168, 254101], [175, 254521], [179, 254681], [182, 254801]]}]}