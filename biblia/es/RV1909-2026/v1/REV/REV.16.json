{"book": "REV", "chapter": 16, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 179416, "verses": [{"verse": 1, "start": 300, "end": 7837, "text": "Y oí una gran voz del templo, que decía a los siete ángeles: Id, y derramad las siete copas de la ira de Dios sobre la tierra.", "words": [[0, 300], [2, 436], [5, 616], [9, 756], [14, 956], [18, 1216], [22, 1376], [30, 2136], [34, 2256], [40, 2636], [42, 2816], [46, 2896], [52, 3156], [61, 4157], [65, 4157], [67, 4696], [76, 5266], [80, 5406], [86, 5626], [92, 6106], [95, 6206], [98, 6346], [102, 6566], [105, 6666], [110, 6906], [116, 7186], [119, 7346]]}, {"verse": 2, "start": 8288, "end": 20144, "text": "Y fue el primero, y derramó su copa sobre la tierra; y vino una llaga maligna y dolorosa sobre los hombres que tenían la marca de la bestia, y sobre los que adoraban su imagen.", "words": [[0, 8288], [2, 8432], [6, 8572], [9, 8752], [18, 9652], [20, 9752], [28, 10172], [31, 10312], [36, 10672], [42, 10892], [45, 11052], [53, 13319], [55, 13448], [60, 13708], [64, 13928], [70, 14288], [78, 14808], [80, 14888], [89, 15388], [95, 15648], [99, 15828], [107, 16128], [111, 16328], [118, 16628], [121, 16808], [127, 17088], [130, 17248], [133, 17368], [141, 17928], [143, 18388], [149, 18588], [153, 18808], [157, 18968], [166, 19388], [169, 19568]]}, {"verse": 3, "start": 20594, "end": 29469, "text": "Y el segundo ángel derramó su copa sobre el mar, y se convirtió en sangre como de un muerto; y toda alma viviente fue muerta en el mar.", "words": [[0, 20594], [2, 20736], [5, 20856], [13, 21176], [19, 21736], [27, 22216], [30, 22336], [35, 22716], [41, 22936], [44, 23116], [49, 23316], [51, 23816], [54, 23956], [64, 24536], [67, 24636], [74, 25036], [79, 25336], [82, 25496], [85, 25596], [93, 26422], [95, 26526], [100, 26726], [105, 27006], [114, 27506], [118, 27726], [125, 28146], [128, 28326], [131, 28466]]}, {"verse": 4, "start": 29919, "end": 36612, "text": "Y el tercer ángel derramó su copa sobre los ríos, y sobre las fuentes de las aguas, y se convirtieron en sangre.", "words": [[0, 29919], [2, 30042], [5, 30182], [12, 30462], [18, 31002], [26, 31462], [29, 31562], [34, 31882], [40, 32082], [44, 32262], [50, 32762], [52, 33142], [58, 33322], [62, 33562], [70, 33982], [73, 34162], [77, 34322], [84, 34822], [86, 35202], [89, 35302], [102, 35962], [105, 36122]]}, {"verse": 5, "start": 37062, "end": 45887, "text": "Y oí al ángel de las aguas, que decía: Justo eres tú, oh Señor, que eres y que eras, el Santo, porque has juzgado estas cosas:", "words": [[0, 37062], [2, 37199], [5, 37359], [8, 37499], [14, 37819], [17, 37919], [21, 38059], [28, 38499], [32, 38779], [39, 39668], [45, 40119], [50, 40240], [54, 40840], [57, 40920], [64, 41820], [68, 41939], [73, 42220], [75, 42479], [79, 42659], [85, 42920], [88, 43180], [95, 43939], [102, 44259], [106, 44480], [114, 44899], [120, 45140]]}, {"verse": 6, "start": 46337, "end": 53000, "text": "Porque ellos derramaron la sangre de los santos y de los profetas, también tú les has dado a beber sangre; pues lo merecen.", "words": [[0, 46337], [7, 46534], [13, 46794], [24, 47354], [27, 47494], [34, 47794], [37, 47954], [41, 48074], [48, 48554], [50, 48654], [53, 48734], [57, 48854], [67, 49774], [75, 50114], [78, 50374], [82, 50554], [86, 50694], [91, 50954], [93, 51074], [99, 51214], [107, 52155], [112, 52259], [115, 52399]]}, {"verse": 7, "start": 53450, "end": 61310, "text": "Y oí a otro del altar, que decía: Ciertamente, Señor Dios Todopoderoso, tus juicios son verdaderos y justos.", "words": [[0, 53450], [2, 53619], [5, 53829], [7, 53949], [12, 54169], [16, 54329], [23, 55009], [27, 55089], [34, 55945], [47, 56700], [53, 56960], [58, 57950], [72, 58940], [76, 59040], [84, 59480], [88, 59800], [99, 60620], [101, 60720]]}, {"verse": 8, "start": 61894, "end": 67095, "text": "Y el cuarto ángel derramó su copa sobre el sol; y le fue dado quemar a los hombres con fuego.", "words": [[0, 61894], [2, 62012], [5, 62132], [12, 62292], [18, 62892], [26, 63372], [29, 63512], [34, 63872], [40, 64052], [43, 64172], [48, 64880], [50, 64988], [53, 65088], [57, 65228], [62, 65448], [69, 65848], [71, 65908], [75, 66028], [83, 66328], [87, 66568]]}, {"verse": 9, "start": 67545, "end": 76608, "text": "Y los hombres se quemaron con el grande calor, y blasfemaron el nombre de Dios, que tiene potestad sobre estas plagas, y no se arrepintieron para darle gloria.", "words": [[0, 67545], [2, 67627], [6, 67747], [14, 68107], [17, 68327], [26, 68727], [30, 68887], [33, 69047], [40, 69247], [47, 69727], [49, 70187], [61, 70867], [64, 71027], [71, 71287], [74, 71467], [80, 72087], [84, 72187], [90, 72447], [99, 73087], [105, 73347], [111, 73587], [119, 74387], [121, 74647], [124, 74767], [127, 74927], [141, 75587], [146, 75827], [152, 76027]]}, {"verse": 10, "start": 77058, "end": 84309, "text": "Y el quinto ángel derramó su copa sobre el trono de la bestia; y su reino se hizo tenebroso, y se mordían sus lenguas de dolor;", "words": [[0, 77058], [2, 77175], [5, 77275], [12, 77655], [18, 78075], [26, 78515], [29, 78635], [34, 79055], [40, 79295], [43, 79455], [49, 79755], [52, 79855], [55, 79955], [63, 80853], [65, 80962], [68, 81102], [74, 81502], [77, 81642], [82, 81802], [93, 82482], [95, 82622], [98, 82722], [106, 83142], [110, 83302], [118, 83742], [121, 83842]]}, {"verse": 11, "start": 84759, "end": 90757, "text": "Y blasfemaron del Dios del cielo por sus dolores, y por sus llagas, y no se arrepintieron de sus obras.", "words": [[0, 84759], [2, 84864], [14, 85504], [18, 85744], [23, 85944], [27, 86144], [33, 86524], [37, 86764], [41, 86944], [50, 87464], [52, 87684], [56, 87864], [60, 88214], [68, 88564], [70, 88944], [73, 89064], [76, 89454], [90, 89844], [93, 90004], [97, 90144]]}, {"verse": 12, "start": 91207, "end": 100122, "text": "Y el sexto ángel derramó su copa sobre el gran río Éufrates; y el agua de él se secó, para que fuese preparado el camino de los reyes del Oriente.", "words": [[0, 91207], [2, 91334], [5, 91434], [11, 91794], [17, 92154], [25, 92594], [28, 92714], [33, 93174], [39, 93394], [42, 93574], [47, 93754], [51, 94134], [61, 95273], [63, 95403], [66, 95543], [71, 95783], [74, 95943], [77, 96103], [80, 96263], [86, 97023], [91, 97283], [95, 97423], [101, 97723], [111, 98263], [114, 98363], [121, 98603], [124, 98843], [128, 98963], [134, 99323], [138, 99483]]}, {"verse": 13, "start": 100572, "end": 108764, "text": "Y vi salir de la boca del dragón, y de la boca de la bestia, y de la boca del falso profeta, tres espíritus inmundos a manera de ranas:", "words": [[0, 100572], [2, 100652], [5, 100772], [11, 100972], [14, 101212], [17, 101312], [22, 101512], [26, 101732], [34, 102512], [36, 102552], [39, 102652], [42, 102752], [47, 102972], [50, 103152], [53, 103252], [61, 104112], [63, 104132], [66, 104232], [69, 104332], [74, 104552], [78, 104772], [84, 105152], [93, 106052], [98, 106232], [108, 106912], [117, 107552], [119, 107692], [126, 107952], [129, 108152]]}, {"verse": 14, "start": 109214, "end": 119597, "text": "Porque son espíritus de demonios, que hacen señales, para ir a los reyes de la tierra y de todo el mundo, para reunirlos para la batalla de aquel gran día del Dios Todopoderoso.", "words": [[0, 109214], [7, 109394], [11, 109614], [21, 110254], [24, 110354], [34, 111094], [38, 111374], [44, 111654], [53, 112454], [58, 112734], [61, 112934], [63, 112994], [67, 113154], [73, 113474], [76, 113594], [79, 113694], [86, 114054], [88, 114274], [91, 114414], [96, 114634], [99, 114814], [106, 115573], [111, 115714], [121, 116434], [126, 116634], [129, 116774], [137, 117174], [140, 117314], [146, 117594], [151, 117774], [155, 118054], [159, 118254], [164, 118494]]}, {"verse": 15, "start": 119947, "end": 129634, "text": "He aquí, yo vengo como ladrón. Bienaventurado el que vela, y guarda sus vestiduras, para que no ande desnudo, y vean su vergüenza.", "words": [[0, 120003], [3, 120093], [9, 120313], [12, 120533], [18, 120853], [23, 121073], [31, 122050], [46, 123035], [49, 123195], [53, 123335], [59, 124095], [61, 124275], [68, 124695], [72, 124855], [84, 125635], [89, 126235], [93, 126415], [96, 126615], [101, 126955], [110, 127755], [112, 128255], [117, 128595], [120, 128755]]}, {"verse": 16, "start": 129934, "end": 133144, "text": "Y los reunió en el lugar que en hebreo se llama Armagedón.", "words": [[0, 129934], [2, 130042], [6, 130182], [13, 130602], [16, 130702], [19, 130802], [25, 131102], [29, 131322], [32, 131442], [39, 131802], [42, 131902], [48, 132202]]}, {"verse": 17, "start": 133594, "end": 141263, "text": "Y el séptimo ángel derramó su copa por el aire; y salió una grande voz del templo del cielo, del trono, diciendo: Hecho es.", "words": [[0, 133594], [2, 133698], [5, 133798], [13, 134318], [19, 134718], [27, 135138], [30, 135258], [35, 135598], [39, 135758], [42, 135878], [48, 136590], [50, 136696], [56, 137016], [60, 137156], [67, 137456], [71, 137696], [75, 137896], [82, 138296], [86, 138396], [93, 138936], [97, 139036], [104, 139436], [114, 140690], [120, 140976]]}, {"verse": 18, "start": 141793, "end": 152895, "text": "Entonces fueron hechos relámpagos y voces y truenos; y hubo un gran temblor de tierra, un terremoto tan grande, cual no fue jamás desde que los hombres han estado sobre la tierra.", "words": [[0, 141793], [9, 142215], [16, 142655], [23, 143035], [34, 143895], [36, 144035], [42, 144435], [44, 144575], [53, 145523], [55, 145689], [60, 145909], [63, 146009], [68, 146189], [76, 146729], [79, 146829], [87, 147689], [90, 147789], [100, 148389], [104, 148589], [112, 149049], [117, 149549], [120, 149789], [124, 149989], [130, 150489], [136, 150649], [140, 150929], [144, 151089], [152, 151389], [156, 151629], [163, 151929], [169, 152229], [172, 152409]]}, {"verse": 19, "start": 153345, "end": 164812, "text": "Y la ciudad grande fue partida en tres partes, y las ciudades de las naciones cayeron; y la grande Babilonia vino en memoria delante de Dios, para darle la copa del vino del furor de su ira.", "words": [[0, 153345], [2, 153448], [5, 153568], [12, 153848], [19, 154268], [23, 154548], [31, 155128], [34, 155268], [39, 155428], [47, 155908], [49, 156428], [53, 156608], [62, 157048], [65, 157188], [69, 157328], [78, 157748], [87, 158773], [89, 158882], [92, 158982], [99, 159262], [109, 159842], [114, 160102], [117, 160262], [125, 160722], [133, 161162], [136, 161322], [142, 162082], [147, 162302], [153, 162562], [156, 162782], [161, 163142], [165, 163282], [170, 163502], [174, 163682], [180, 164082], [183, 164222], [186, 164402]]}, {"verse": 20, "start": 165262, "end": 168255, "text": "Y toda isla huyó, y los montes no fueron hallados.", "words": [[0, 165262], [2, 165362], [7, 165502], [12, 165902], [18, 166262], [20, 166562], [24, 166702], [31, 167122], [34, 167222], [41, 167462]]}, {"verse": 21, "start": 168705, "end": 179016, "text": "Y cayó del cielo sobre los hombres un grande granizo como del peso de un talento: y los hombres blasfemaron de Dios por la plaga del granizo; porque su plaga fue muy grande.", "words": [[0, 168840], [2, 168986], [7, 169133], [11, 169233], [17, 169613], [23, 169913], [27, 170133], [35, 170533], [38, 170813], [45, 171133], [53, 171713], [58, 171993], [62, 172173], [67, 172493], [70, 172693], [73, 172793], [82, 173771], [84, 173875], [88, 173995], [96, 174315], [108, 175015], [111, 175195], [116, 175415], [120, 175695], [123, 175835], [129, 176075], [133, 176315], [142, 177296], [149, 177502], [152, 177682], [158, 178042], [162, 178242], [166, 178442]]}]}