{"book": "PSA", "chapter": 147, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 116972, "verses": [{"verse": 1, "start": 300, "end": 8524, "text": "Alabad a JAH, porque es bueno cantar salmos a nuestro Dios; porque agradable y hermosa es la alabanza.", "words": [[0, 300], [7, 817], [9, 1351], [14, 1884], [21, 2224], [24, 2404], [30, 2624], [37, 3304], [44, 3944], [46, 4104], [54, 4284], [60, 5291], [67, 5697], [77, 6477], [79, 6637], [87, 7237], [90, 7377], [93, 7597]]}, {"verse": 2, "start": 8974, "end": 14461, "text": "Jehová edifica a Jerusalén; a los desterrados de Israel recogerá.", "words": [[0, 9295], [7, 9655], [15, 10015], [17, 10115], [28, 11335], [30, 11570], [34, 11730], [46, 12750], [49, 12950], [56, 13450]]}, {"verse": 3, "start": 14911, "end": 19545, "text": "Él sana a los quebrantados de corazón, y venda sus heridas.", "words": [[0, 14911], [3, 15097], [8, 15477], [10, 15777], [14, 15917], [27, 16797], [30, 16957], [39, 17477], [41, 18047], [47, 18617], [51, 18797]]}, {"verse": 4, "start": 19995, "end": 25125, "text": "Él cuenta el número de las estrellas; a todas ellas llama por sus nombres.", "words": [[0, 19995], [3, 20144], [10, 20544], [13, 20704], [20, 21084], [23, 21324], [27, 21504], [38, 22629], [40, 22849], [46, 23029], [52, 23349], [58, 23889], [62, 24189], [66, 24369]]}, {"verse": 5, "start": 25575, "end": 31453, "text": "Grande es el Señor nuestro, y de mucho poder; y de su entendimiento no hay número.", "words": [[0, 25575], [7, 25943], [10, 26303], [13, 26463], [19, 26763], [28, 27823], [30, 27963], [33, 28103], [39, 28383], [46, 29269], [48, 29371], [51, 29491], [54, 29631], [68, 30411], [71, 30611], [75, 30831]]}, {"verse": 6, "start": 31903, "end": 37418, "text": "Jehová ensalza a los humildes; humilla los impíos hasta la tierra.", "words": [[0, 32326], [7, 32786], [15, 33246], [17, 33586], [21, 33746], [31, 35145], [39, 35455], [43, 35575], [50, 36255], [56, 36515], [59, 36675]]}, {"verse": 7, "start": 37868, "end": 42409, "text": "Cantad a Jehová con alabanza, cantad con arpa a nuestro Dios.", "words": [[0, 38045], [7, 38259], [9, 38472], [16, 39012], [20, 39152], [30, 40092], [37, 40672], [41, 40872], [46, 41292], [48, 41432], [56, 41612]]}, {"verse": 8, "start": 42859, "end": 50184, "text": "Él es el que cubre los cielos de nubes, el que prepara la lluvia para la tierra, el que hace a los montes producir hierba.", "words": [[0, 42859], [3, 43045], [6, 43205], [9, 43285], [13, 43445], [19, 43905], [23, 44045], [30, 44585], [33, 44665], [40, 45225], [43, 45285], [47, 45465], [55, 45925], [58, 46025], [65, 46405], [70, 46545], [73, 46705], [81, 47565], [84, 47645], [88, 47785], [93, 48125], [95, 48285], [99, 48405], [106, 48845], [115, 49445]]}, {"verse": 9, "start": 50634, "end": 54772, "text": "Él da a la bestia su mantenimiento, y a los hijos de los cuervos que claman.", "words": [[0, 50634], [3, 50775], [6, 50995], [8, 51115], [11, 51345], [18, 51575], [21, 51735], [36, 52655], [38, 52815], [40, 52895], [44, 53035], [50, 53295], [53, 53455], [57, 53555], [65, 53955], [69, 54095]]}, {"verse": 10, "start": 55222, "end": 60416, "text": "No se deleita en la fortaleza del caballo, ni se complace en las piernas del hombre.", "words": [[0, 55222], [3, 55350], [6, 55510], [14, 56030], [17, 56150], [20, 56270], [30, 56950], [34, 57090], [43, 57660], [46, 58230], [49, 58430], [58, 59050], [61, 59190], [65, 59330], [73, 59750], [77, 59950]]}, {"verse": 11, "start": 60866, "end": 67106, "text": "Se complace Jehová en los que le temen, y en los que esperan en su misericordia.", "words": [[0, 60866], [3, 61033], [12, 61713], [19, 62333], [22, 62533], [26, 62693], [30, 62853], [33, 62993], [40, 63593], [42, 64153], [45, 64293], [49, 64493], [53, 64673], [61, 65353], [64, 65573], [67, 65853]]}, {"verse": 12, "start": 67556, "end": 71857, "text": "Alaba a Jehová, Jerusalén; alaba a tu Dios, Sion.", "words": [[0, 67556], [6, 68074], [8, 68274], [16, 68694], [27, 69945], [33, 70146], [35, 70376], [38, 70616], [44, 71336]]}, {"verse": 13, "start": 72307, "end": 77768, "text": "Porque fortificó los cerrojos de tus puertas; bendijo a tus hijos dentro de ti.", "words": [[0, 72307], [7, 72529], [17, 73409], [21, 73759], [30, 74109], [33, 74269], [37, 74409], [46, 75475], [54, 76104], [56, 76244], [60, 76424], [66, 76684], [73, 77064], [76, 77344]]}, {"verse": 14, "start": 78218, "end": 83135, "text": "El pone en tu término la paz; te hará saciar de lo mejor del trigo.", "words": [[0, 78218], [3, 78422], [8, 78842], [11, 79042], [14, 79202], [22, 79762], [25, 79862], [30, 80708], [33, 81000], [38, 81326], [45, 81653], [48, 81793], [51, 81913], [57, 82253], [61, 82453]]}, {"verse": 15, "start": 83585, "end": 88142, "text": "Él envía su palabra a la tierra; muy rápido corre su palabra.", "words": [[0, 83585], [3, 83899], [9, 84319], [12, 84479], [20, 84879], [22, 85099], [25, 85139], [33, 86173], [37, 86341], [44, 86801], [50, 87241], [53, 87441]]}, {"verse": 16, "start": 88592, "end": 93258, "text": "El da la nieve como lana, derrama la escarcha como ceniza.", "words": [[0, 88592], [3, 88801], [6, 89141], [9, 89241], [15, 89641], [20, 89901], [26, 90701], [34, 91381], [37, 91561], [46, 92261], [51, 92481]]}, {"verse": 17, "start": 93708, "end": 98756, "text": "El echa su hielo como pedazos: delante de su frío ¿quién estará?", "words": [[0, 93708], [3, 93871], [8, 94111], [11, 94351], [17, 94831], [22, 95011], [31, 96268], [39, 96674], [42, 96834], [45, 96974], [50, 97794], [57, 98174]]}, {"verse": 18, "start": 99206, "end": 104531, "text": "Enviará su palabra, y los derretirá: soplará su viento, y fluirán las aguas.", "words": [[0, 99410], [8, 99650], [11, 99850], [20, 100190], [22, 100510], [26, 100670], [37, 101802], [45, 102324], [48, 102504], [56, 102924], [58, 103044], [66, 103584], [70, 103784]]}, {"verse": 19, "start": 104981, "end": 110690, "text": "El anuncia sus palabras a Jacob, sus estatutos y sus juicios a Israel.", "words":