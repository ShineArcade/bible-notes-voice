{"book": "ROM", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 249664, "verses": [{"verse": 1, "start": 300, "end": 5894, "text": "Pablo, siervo de Jesucristo, llamado a ser apóstol, apartado para el evangelio de Dios,", "words": [[0, 300], [7, 570], [14, 1050], [17, 1150], [29, 2270], [37, 2570], [39, 2790], [43, 2890], [52, 3690], [61, 4350], [66, 4570], [69, 4710], [79, 5270], [82, 5370]]}, {"verse": 2, "start": 6344, "end": 10156, "text": "Que él había antes prometido por sus profetas en las santas Escrituras,", "words": [[0, 6344], [4, 6464], [7, 6624], [13, 6824], [19, 7204], [29, 7824], [33, 7964], [37, 8124], [46, 8664], [49, 8844], [53, 8984], [60, 9364]]}, {"verse": 3, "start": 10606, "end": 15612, "text": "Acerca de su Hijo, (que fue hecho del linaje de David según la carne;", "words": [[0, 10606], [7, 10948], [10, 11148], [13, 11308], [19, 11888], [24, 11908], [28, 12108], [34, 12348], [38, 12528], [45, 12968], [48, 13068], [54, 13508], [60, 13688], [63, 13888]]}, {"verse": 4, "start": 16062, "end": 25157, "text": "El cual fue declarado Hijo de Dios con poder, según el espíritu de santidad, por la resurrección de los muertos), de Jesucristo Señor nuestro,", "words": [[0, 16062], [3, 16185], [8, 16445], [12, 16765], [22, 17445], [27, 17785], [30, 18005], [35, 18225], [39, 18505], [46, 18865], [52, 19285], [55, 19525], [64, 20125], [67, 20205], [77, 20805], [81, 21325], [84, 21485], [97, 22245], [100, 22365], [104, 22485], [114, 23025], [117, 23425], [128, 24225], [134, 24405]]}, {"verse": 5, "start": 25607, "end": 32537, "text": "Por el cual recibimos la gracia y el apostolado, para la obediencia de la fe en todas las naciones en su nombre,", "words": [[0, 25607], [4, 25735], [7, 25835], [12, 26095], [22, 26955], [25, 27135], [32, 27795], [34, 27935], [37, 28035], [49, 28995], [54, 29275], [57, 29645], [68, 30015], [71, 30215], [74, 30335], [77, 30575], [80, 30735], [86, 30915], [90, 31235], [99, 31655], [102, 31875], [105, 32035]]}, {"verse": 6, "start": 32987, "end": 36478, "text": "Entre las cuales sois también vosotros, llamados de Jesucristo:", "words": [[0, 32987], [6, 33169], [10, 33329], [17, 33589], [22, 33989], [30, 34189], [40, 35089], [49, 35569], [52, 35709]]}, {"verse": 7, "start": 36928, "end": 45569, "text": "A todos los que estáis en Roma, amados de Dios, llamados santos: Gracia y paz tengáis de Dios nuestro Padre, y del Señor Jesucristo.", "words": [[0, 36928], [2, 37071], [8, 37291], [12, 37551], [16, 37731], [23, 38171], [26, 38291], [32, 38831], [39, 39171], [42, 39351], [48, 40111], [57, 40511], [65, 41786], [72, 41996], [74, 42216], [78, 42456], [86, 42976], [89, 43136], [94, 43356], [102, 43656], [109, 44216], [111, 44336], [115, 44456], [121, 44696]]}, {"verse": 8, "start": 46019, "end": 53787, "text": "Primeramente, doy gracias a mi Dios por Jesucristo acerca de todos vosotros, de que vuestra fe es predicada en todo el mundo.", "words": [[0, 46019], [14, 46739], [18, 47039], [26, 47319], [28, 47619], [31, 47699], [36, 47979], [40, 48299], [51, 49019], [58, 49419], [61, 49699], [67, 49939], [77, 50639], [80, 51159], [84, 51279], [92, 51659], [95, 51899], [98, 52159], [108, 52799], [111, 52919], [116, 53119], [119, 53339]]}, {"verse": 9, "start": 54237, "end": 62035, "text": "Porque testigo me es Dios, al cual sirvo en mi espíritu en el evangelio de su Hijo, que sin cesar me acuerdo de vosotros siempre en mis oraciones,", "words": [[0, 54237], [7, 54397], [15, 54897], [18, 55037], [21, 55197], [27, 55857], [30, 55997], [35, 56157], [41, 56557], [44, 56637], [47, 56737], [56, 57257], [59, 57337], [62, 57417], [72, 57897], [75, 57997], [78, 58177], [84, 58777], [88, 58917], [92, 59077], [98, 59497], [101, 59597], [109, 59897], [112, 60117], [121, 60557], [129, 60917], [132, 61137], [136, 61277]]}, {"verse": 10, "start": 62485, "end": 68431, "text": "Rogando, si por fin pudiera tener, por la voluntad de Dios, próspero viaje para ir a vosotros.", "words": [[0, 62485], [9, 62989], [12, 63229], [16, 63409], [20, 63629], [28, 64029], [35, 64689], [39, 64789], [42, 64909], [51, 65449], [54, 65549], [60, 66269], [69, 66789], [75, 67109], [80, 67409], [83, 67589], [85, 67689]]}, {"verse": 11, "start": 68881, "end": 75855, "text": "Porque os deseo ver, para repartir con vosotros algún don espiritual, para fortaleceros;", "words": [[0, 68881], [7, 69122], [10, 69322], [16, 69762], [21, 69982], [26, 70522], [35, 71142], [39, 71262], [48, 71822], [54, 72142], [58, 72342], [70, 73022], [75, 73682]]}, {"verse": 12, "start": 76305, "end": 81881, "text": "Es decir, para ser juntamente consolado con vosotros por la común fe vuestra y juntamente mía.", "words": [[0, 76305], [3, 76449], [10, 76969], [15, 77129], [19, 77389], [30, 77989], [40, 78689], [44, 78849], [53, 79369], [57, 79609], [60, 79749], [66, 79989], [69, 80269], [77, 80749], [79, 80889], [90, 81449]]}, {"verse": 13, "start": 82331, "end": 93513, "text": "Pero no quiero, hermanos, que ignoréis que muchas veces me he propuesto ir a vosotros (pero hasta ahora he sido estorbado), para tener también entre vosotros algún fruto, como entre los demás Gentiles.", "words": [[0, 82331], [5, 82471], [8, 82591], [16, 82811], [26, 83691], [30, 83831], [39, 84291], [43, 84431], [50, 84631], [56, 85091], [59, 85331], [62, 85431], [72, 85891], [75, 86071], [77, 86171], [86, 87111], [92, 87271], [98, 87531], [104, 87831], [107, 87991], [112, 88251], [124, 88951], [129, 89391], [135, 89671], [143, 90031], [149, 90291], [158, 90811], [164, 91111], [171, 91946], [176, 92102], [182, 92282], [186, 92462], [192, 92702]]}, {"verse": 14, "start": 93963, "end": 97464, "text": "A griegos y a no griegos, a sabios y a no sabios soy deudor.", "words": [[0, 93963], [2, 94095], [10, 94515], [12, 94635], [14, 94715], [17, 94795], [26, 95475], [28, 95555], [35, 96015], [37, 96155], [39, 96215], [42, 96295], [49, 96715], [53, 96915]]}, {"verse": 15, "start": 97914, "end": 103077, "text": "Así que, cuanto a mí, dispuesto estoy a anunciar el evangelio también a vosotros que estáis en Roma.", "words": [[0, 97914], [4, 98101], [9, 98241], [16, 98461], [18, 98661], [22, 99041], [32, 99501], [38, 99741], [40, 99981], [49, 100481], [52, 100561], [62, 101141], [70, 101361], [72, 101581], [81, 101961], [85, 102161], [92, 102521], [95, 102661]]}, {"verse": 16, "start": 103527, "end": 111487, "text": "Porque no me avergüenzo del evangelio: porque es poder de Dios para salvación a todo aquel que cree; al judío primeramente y también al griego.", "words": [[0, 103527], [7, 103692], [10, 103892], [13, 104012], [24, 104572], [28, 104712], [39, 105733], [46, 105972], [49, 106112], [55, 106352], [58, 106572], [63, 106792], [68, 107052], [78, 107672], [80, 107912], [85, 108092], [91, 108432], [95, 108552], [101, 109278], [104, 109430], [110, 109830], [123, 110410], [125, 110570], [133, 110750], [136, 110990]]}, {"verse": 17, "start": 111937, "end": 117989, "text": "Porque en él la justicia de Dios se descubre de fe en fe; como está escrito: Pero el justo vivirá por la fe.", "words": [[0, 111937], [7, 112135], [10, 112295], [13, 112415], [16, 112555], [25, 113035], [28, 113175], [33, 113395], [36, 113575], [45, 114095], [48, 114195], [51, 114415], [54, 114555], [58, 115227], [63, 115367], [68, 115567], [77, 116467], [82, 116609], [85, 116729], [91, 116909], [98, 117389], [102, 117549], [105, 117669]]}, {"verse": 18, "start": 118439, "end": 125550, "text": "Porque manifiesta es la ira de Dios del cielo contra toda impiedad e injusticia de los hombres, que detienen la verdad con injusticia:", "words": [[0, 118439], [7, 118619], [18, 119299], [21, 119479], [24, 119619], [28, 119819], [31, 119919], [36, 120119], [40, 120299], [46, 120619], [53, 120919], [58, 121179], [67, 121799], [69, 121879], [80, 122479], [83, 122599], [87, 122719], [96, 123099], [100, 123639], [109, 124059], [112, 124199], [119, 124479], [123, 124739]]}, {"verse": 19, "start": 126000, "end": 130896, "text": "Porque lo que de Dios se conoce, a ellos es manifiesto; porque Dios se lo manifestó.", "words": [[0, 126000], [7, 126187], [10, 126327], [14, 126447], [17, 126567], [22, 126747], [25, 126947], [33, 127567], [35, 127847], [41, 128067], [44, 128287], [56, 129404], [63, 129604], [68, 129844], [71, 130064], [74, 130144]]}, {"verse": 20, "start": 131346, "end": 142531, "text": "Porque las cosas invisibles de él, su eterno poder y divinidad, se perciben desde la creación del mundo, siendo entendidas por las cosas que son hechas; de modo que son inexcusables:", "words": [[0, 131346], [7, 131492], [11, 131712], [17, 131972], [28, 132672], [31, 132912], [35, 133472], [38, 133572], [45, 134052], [51, 134292], [53, 134492], [64, 135332], [67, 135412], [76, 135972], [82, 136132], [85, 136352], [94, 136832], [98, 137012], [105, 137732], [112, 138072], [123, 138732], [127, 138952], [131, 139092], [137, 139412], [141, 139612], [145, 139832], [153, 140690], [156, 140834], [161, 141034], [165, 141234], [169, 141414]]}, {"verse": 21, "start": 142981, "end": 152815, "text": "Porque habiendo conocido a Dios, no le glorificaron como a Dios, ni dieron gracias; sino que sus razonamientos se volvieron vanos, y el necio corazón de ellos fue oscurecido.", "words": [[0, 142981], [7, 143147], [16, 143447], [25, 143967], [27, 144067], [33, 144667], [36, 144747], [39, 144847], [52, 145507], [57, 145707], [59, 145867], [65, 146387], [68, 146587], [75, 146827], [84, 147839], [89, 148001], [93, 148181], [97, 148341], [111, 149081], [114, 149301], [124, 149641], [131, 150181], [133, 150381], [136, 150521], [142, 150821], [150, 151161], [153, 151441], [159, 151721], [163, 151981]]}, {"verse": 22, "start": 153265, "end": 155966, "text": "Diciéndose ser sabios, se hicieron necios,", "words": [[0, 153265], [11, 153881], [15, 154141], [23, 154621], [26, 154821], [35, 155241]]}, {"verse": 23, "start": 156416, "end": 165443, "text": "Y cambiaron la gloria del Dios incorruptible en semejanza de imagen de hombre corruptible, y de aves, y de animales de cuatro pies, y de serpientes.", "words": [[0, 156416], [2, 156501], [12, 156921], [15, 157081], [22, 157481], [26, 157621], [31, 157861], [45, 158741], [48, 158861], [58, 159521], [61, 159641], [68, 159961], [71, 160221], [78, 160441], [91, 161241], [93, 161621], [96, 161721], [102, 162061], [104, 162281], [107, 162381], [116, 162741], [119, 163021], [126, 163241], [132, 163641], [134, 163861], [137, 163981]]}, {"verse": 24, "start": 165893, "end": 175447, "text": "Por lo cual también Dios los entregó a inmundicia, en los malos deseos de sus corazones, de suerte que contaminaron sus cuerpos entre sí mismos:", "words": [[0, 165893], [4, 166021], [7, 166141], [12, 166421], [20, 166841], [25, 167301], [29, 167601], [37, 168161], [39, 168281], [51, 169021], [54, 169561], [58, 169701], [64, 170141], [71, 170641], [74, 170761], [78, 170921], [89, 172041], [92, 172241], [99, 172661], [103, 172841], [116, 173541], [120, 173721], [128, 174241], [134, 174521], [137, 174781]]}, {"verse": 25, "start": 175897, "end": 184822, "text": "Los cuales cambiaron la verdad de Dios en mentira, honrando y sirviendo a las criaturas en lugar de al Creador, el cual es bendito por los siglos. Amén.", "words": [[0, 175897], [4, 176003], [11, 176283], [21, 176863], [24, 177023], [31, 177243], [34, 177463], [39, 177683], [42, 177863], [51, 178583], [60, 179303], [62, 179383], [72, 179863], [74, 179963], [78, 180123], [88, 180603], [91, 180783], [97, 181023], [100, 181223], [103, 181323], [112, 182263], [115, 182323], [120, 182543], [123, 182723], [131, 183163], [135, 183363], [139, 183503], [147, 184423]]}, {"verse": 26, "start": 185272, "end": 192971, "text": "Por esto Dios los entregó a pasiones vergonzosas; pues aun sus mujeres cambiaron el uso natural por el que es contra naturaleza:", "words": [[0, 185272], [4, 185404], [9, 185664], [14, 186004], [18, 186244], [26, 186784], [28, 186844], [37, 187264], [50, 188618], [55, 188748], [59, 189008], [63, 189188], [71, 189648], [81, 190328], [84, 190468], [88, 190668], [96, 191168], [100, 191428], [103, 191568], [107, 191708], [110, 191888], [117, 192148]]}, {"verse": 27, "start": 193421, "end": 208233, "text": "Y del mismo modo también los hombres, dejando el uso natural de las mujeres, se encendieron en pasiones los unos por los otros, cometiendo actos vergonzosos hombres con hombres, y recibiendo en sí mismos la recompensa que convino a su extravío.", "words": [[0, 193421], [2, 193524], [6, 193624], [12, 193944], [17, 194224], [25, 194544], [29, 194804], [38, 195604], [46, 196124], [49, 196244], [53, 196444], [61, 196844], [64, 197044], [68, 197184], [77, 198024], [80, 198124], [92, 198664], [95, 198824], [104, 199284], [108, 199524], [113, 199764], [117, 200024], [121, 200204], [128, 200844], [139, 201424], [145, 201844], [157, 202664], [165, 202984], [169, 203264], [178, 204145], [180, 204268], [191, 204948], [194, 205088], [197, 205268], [204, 205648], [207, 205848], [218, 206608], [222, 206958], [230, 207308], [232, 207428], [235, 207548]]}, {"verse": 28, "start": 208683, "end": 215687, "text": "Y como a ellos no les pareció reconocer a Dios, Dios los entregó a una mente depravada, para hacer lo que no conviene,", "words": [[0, 208683], [2, 208776], [7, 208956], [9, 209076], [15, 209256], [18, 209496], [22, 209636], [30, 210136], [40, 210796], [42, 210856], [48, 211596], [53, 211876], [57, 212056], [65, 212596], [67, 212656], [71, 212796], [77, 213136], [88, 213796], [93, 214316], [99, 214616], [102, 214776], [106, 214896], [109, 215036]]}, {"verse": 29, "start": 216137, "end": 225741, "text": "Estando llenos de toda iniquidad, de inmoralidad sexual, de malicia, de avaricia, de maldad; llenos de envidia, de homicidios, de contiendas, de engaños, de malignidades;", "words": [[0, 216137], [8, 216515], [15, 216855], [18, 216955], [23, 217135], [34, 218055], [37, 218095], [49, 218655], [57, 219415], [60, 219475], [69, 220135], [72, 220155], [82, 220715], [85, 220775], [93, 221596], [100, 221842], [103, 221982], [112, 222582], [115, 222602], [127, 223362], [130, 223402], [142, 224182], [145, 224222], [154, 224782], [157, 224842]]}, {"verse": 30, "start": 226191, "end": 235270, "text": "Murmuradores, difamadores, aborrecedores de Dios, injuriosos, soberbios, altivos, inventores de males, desobedientes a los padres,", "words": [[0, 226191], [14, 226810], [27, 227910], [41, 228590], [44, 228750], [50, 229510], [62, 230470], [73, 231290], [82, 232150], [93, 232690], [96, 232890], [103, 233670], [117, 234330], [119, 234550], [123, 234670]]}, {"verse": 31, "start": 235720, "end": 240266, "text": "Necios, desleales, sin afecto natural, implacables, sin misericordia:", "words": [[0, 235720], [8, 236231], [19, 237031], [23, 237391], [30, 237871], [39, 238491], [52, 239111], [56, 239351]]}, {"verse": 32, "start": 240716, "end": 249264, "text": "Que, habiendo entendido el juicio de Dios que los que hacen tales cosas son dignos de muerte, no sólo las hacen, sino que también aprueban a los que las hacen.", "words": [[0, 240716], [5, 240810], [14, 241190], [24, 241790], [27, 241910], [34, 242210], [37, 242370], [42, 242630], [46, 242890], [50, 243030], [54, 243210], [60, 243390], [66, 243670], [72, 244070], [76, 244390], [83, 244830], [86, 244910], [94, 245730], [97, 245990], [102, 246230], [106, 246430], [113, 247010], [118, 247250], [122, 247410], [130, 247710], [139, 248270], [141, 248370], [145, 248470], [149, 248590], [153, 248690]]}]}