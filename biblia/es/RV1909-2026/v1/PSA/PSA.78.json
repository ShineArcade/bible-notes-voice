{"book": "PSA", "chapter": 78, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 436780, "verses": [{"verse": 1, "start": 300, "end": 6998, "text": "Masquil de Asaf. ESCUCHA, pueblo mío, mi ley: inclinad vuestro oído a las palabras de mi boca.", "words": [[0, 300], [8, 849], [11, 989], [17, 1613], [26, 2013], [33, 2173], [38, 2973], [41, 3073], [46, 4274], [55, 4680], [63, 5100], [68, 5500], [70, 5660], [74, 5740], [83, 6100], [86, 6320], [89, 6440]]}, {"verse": 2, "start": 7348, "end": 12035, "text": "Abriré mi boca en parábola; hablaré cosas reservadas de antiguo:", "words": [[0, 7348], [7, 8008], [10, 8128], [15, 8368], [18, 8568], [28, 9708], [36, 10149], [42, 10389], [53, 11169], [56, 11349]]}, {"verse": 3, "start": 12385, "end": 16930, "text": "Las cuales hemos oído y entendido; que nuestros padres nos las contaron.", "words": [[0, 12385], [4, 12494], [11, 12674], [17, 13034], [22, 13574], [24, 13734], [35, 14852], [39, 14933], [48, 15133], [55, 15713], [59, 15993], [63, 16153]]}, {"verse": 4, "start": 17280, "end": 27675, "text": "No las encubriremos a sus hijos, contando a la generación venidera las alabanzas de Jehová, y su fortaleza, y sus maravillas que hizo.", "words": [[0, 17280], [3, 17651], [7, 17931], [20, 19031], [22, 19251], [26, 19411], [33, 20311], [42, 21071], [44, 21191], [47, 21271], [58, 21991], [67, 22711], [71, 22891], [81, 23571], [84, 23671], [92, 24451], [94, 24611], [97, 24771], [108, 25731], [110, 26091], [114, 26251], [125, 26931], [129, 27131]]}, {"verse": 5, "start": 28025, "end": 36329, "text": "Él estableció testimonio en Jacob, y pusó ley en Israel; la cual mandó a nuestros padres que la notificasen a sus hijos;", "words": [[0, 28025], [3, 28230], [14, 28990], [25, 29650], [28, 29730], [35, 30050], [37, 30350], [42, 30710], [46, 30930], [49, 31290], [57, 32264], [60, 32371], [65, 32571], [71, 33131], [73, 33271], [82, 33471], [89, 34151], [93, 34451], [96, 34971], [108, 35491], [110, 35571], [114, 35751]]}, {"verse": 6, "start": 36679, "end": 43773, "text": "Para que lo sepa la generación venidera, y los hijos que nacerán; y los que se levantarán, lo cuenten a sus hijos;", "words": [[0, 36679], [5, 37014], [9, 37134], [12, 37274], [17, 37594], [20, 37694], [31, 38314], [41, 38954], [43, 39074], [47, 39254], [53, 39534], [57, 39754], [66, 40682], [68, 40808], [72, 40928], [76, 41088], [79, 41268], [91, 42088], [94, 42228], [102, 42768], [104, 42868], [108, 43048]]}, {"verse": 7, "start": 44123, "end": 51647, "text": "A fin de que pongan en Dios su confianza, y no se olviden de las obras de Dios, y guarden sus mandamientos:", "words": [[0, 44123], [2, 44263], [6, 44423], [9, 44583], [13, 44703], [20, 45223], [23, 45363], [28, 45623], [31, 46023], [42, 47043], [44, 47223], [47, 47363], [50, 47543], [58, 48103], [61, 48283], [65, 48463], [71, 48763], [74, 48963], [80, 49303], [82, 49783], [90, 50323], [94, 50543]]}, {"verse": 8, "start": 51997, "end": 62382, "text": "Y no sean como sus padres, generación obstinada y rebelde; generación que no preparó su corazón, ni fue fiel para con Dios su espíritu.", "words": [[0, 51997], [2, 52125], [5, 52265], [10, 52585], [15, 52925], [19, 53145], [27, 54225], [38, 55085], [48, 55965], [50, 56105], [59, 57103], [70, 57712], [74, 57872], [77, 58012], [85, 58492], [88, 58612], [97, 59472], [100, 59712], [104, 59932], [109, 60352], [114, 60652], [118, 60912], [123, 61192], [126, 61572]]}, {"verse": 9, "start": 62732, "end": 68188, "text": "Los hijos de Efraín armados, flecheros, volvieron las espaldas el día de la batalla.", "words": [[0, 62732], [4, 62861], [10, 63221], [13, 63681], [20, 64141], [29, 64801], [40, 65661], [50, 66101], [54, 66281], [63, 66961], [66, 67141], [70, 67361], [73, 67501], [76, 67601]]}, {"verse": 10, "start": 68538, "end": 72878, "text": "No guardaron el pacto de Dios, ni quisieron andar en su ley:", "words": [[0, 68538], [3, 68741], [13, 69381], [16, 69581], [22, 70101], [25, 70201], [31, 70541], [34, 70981], [44, 71601], [50, 72021], [53, 72261], [56, 72421]]}, {"verse": 11, "start": 73228, "end": 78891, "text": "Antes se olvidaron de sus obras, y de sus maravillas que les había mostrado.", "words": [[0, 73228], [6, 73696], [9, 74316], [19, 74956], [22, 75156], [26, 75336], [33, 75756], [35, 76291], [38, 76411], [42, 76591], [53, 77291], [57, 77531], [61, 77711], [67, 78011]]}, {"verse": 12, "start": 79241, "end": 85349, "text": "Delante de sus padres hizo maravillas en la tierra de Egipto, en el campo de Zoán.", "words": [[0, 79241], [8, 79709], [11, 79889], [15, 80009], [22, 80469], [27, 81209], [38, 81989], [41, 82209], [44, 82349], [51, 82709], [54, 82949], [62, 83589], [65, 83969], [68, 84129], [74, 84469], [77, 84941]]}, {"verse": 13, "start": 85699, "end": 90982, "text": "Rompió el mar, y los hizo pasar; e hizo estar las aguas como en un montón.", "words": [[0, 85699], [7, 86141], [10, 86301], [15, 86581], [17, 86816], [21, 86976], [26, 87196], [33, 88115], [35, 88395], [40, 88635], [46, 88955], [50, 89195], [56, 89655], [61, 89855], [64, 90035], [67, 90155]]}, {"verse": 14, "start": 91332, "end": 95823, "text": "Y los llevó de día con nube, y toda la noche con resplandor de fuego.", "words": [[0, 91332], [2, 91572], [6, 91712], [12, 92072], [15, 92152], [19, 92372], [23, 92592], [29, 93092], [31, 93452], [36, 93672], [39, 93912], [45, 94172], [49, 94452], [60, 95112], [63, 95212]]}, {"verse": 15, "start": 96173, "end": 101046, "text": "Hendió las peñas en el desierto: y les dio a beber como de grandes abismos;", "words": [[0, 96317], [7, 96497], [11, 96617], [17, 97137], [20, 97357], [23, 97477], [33, 98506], [35, 98783], [39, 98903], [43, 99063], [45, 99203], [51, 99383], [56, 99683], [59, 99863], [67, 100183]]}, {"verse": 16, "start": 101396, "end": 106221, "text": "Pues sacó de la peña corrientes, e hizo descender aguas como ríos.", "words": [[0, 101396], [5, 101728], [10, 102208], [13, 102288], [16, 102408], [21, 102728], [33, 103368], [35, 103748], [40, 104068], [50, 104708], [56, 105388], [61, 105628]]}, {"verse": 17, "start": 106571, "end": 111626, "text": "Pero aun volvieron a pecar contra él, enojando en la soledad al Altísimo.", "words": [[0, 106571], [5, 106738], [9, 106978], [19, 107538], [21, 107698], [27, 108058], [34, 108398], [38, 109278], [47, 109798], [50, 109918], [53, 110018], [61, 110598], [64, 110738]]}, {"verse": 18, "start": 111976, "end": 116416, "text": "Pues tentaron a Dios en su corazón, pidiendo comida a su gusto.", "words": [[0, 111976], [5, 112137], [14, 112737], [16, 112897], [21, 113157], [24, 113417], [27, 113577], [36, 114457], [45, 115037], [52, 115477], [54, 115657], [57, 115757]]}, {"verse": 19, "start": 116766, "end": 120720, "text": "Y hablaron contra Dios, diciendo: ¿Podrá poner mesa en el desierto?", "words": [[0, 116766], [2, 116871], [11, 117311], [18, 117631], [24, 117911], [34, 118929], [41, 119213], [47, 119393], [52, 119753], [55, 119893], [58, 119993]]}, {"verse": 20, "start": 121070, "end": 128495, "text": "He aquí ha herido la peña, y corrieron aguas, y arroyos salieron ondeando: ¿podrá también dar pan? ¿preparará carne a su pueblo?", "words": [[0, 121070], [3, 121214], [8, 121394], [11, 121574], [18, 121854], [21, 121974], [27, 122394], [29, 122754], [39, 123194], [46, 123674], [48, 123834], [56, 124234], [65, 124654], [75, 125582], [82, 125886], [90, 126126], [94, 126346], [99, 127252], [110, 127492], [116, 127732], [118, 127912], [121, 127992]]}, {"verse": 21, "start": 128775, "end": 136838, "text": "Por tanto, oyó Jehová y se indignó; se encendió el fuego contra Jacob, y el furor subió también contra Israel;", "words": [[0, 128775], [4, 128919], [11, 129412], [15, 129906], [22, 130399], [24, 130579], [27, 130679], [36, 131820], [39, 131980], [48, 132600], [51, 132720], [57, 133020], [64, 133460], [71, 133880], [73, 134200], [76, 134360], [82, 134820], [88, 135260], [96, 135560], [103, 136060]]}, {"verse": 22, "start": 137188, "end": 141708, "text": "Por cuanto no habían creído a Dios, ni habían confiado en su salvación:", "words": [[0, 137188], [4, 137290], [11, 137530], [14, 137870], [21, 138190], [28, 138670], [30, 138810], [36, 139220], [39, 139630], [46, 139930], [55, 140630], [58, 140750], [61, 140890]]}, {"verse": 23, "start": 142058, "end": 147095, "text": "A pesar de que mandó a las nubes de arriba, y abrió las puertas de los cielos,", "words": [[0, 142058], [2, 142200], [8, 142440], [11, 142660], [15, 142800], [21, 143260], [23, 143380], [27, 143480], [33, 143920], [36, 144060], [44, 144460], [46, 145020], [52, 145300], [56, 145460], [64, 146020], [67, 146200], [71, 146340]]}, {"verse": 24, "start": 147445, "end": 152448, "text": "E hizo llover sobre ellos maná para comer, y les dio trigo de los cielos.", "words": [[0, 147445], [2, 147590], [7, 147950], [14, 148430], [20, 148770], [26, 149090], [31, 149470], [36, 149590], [43, 150450], [45, 150810], [49, 150950], [53, 151110], [59, 151510], [62, 151630], [66, 151770]]}, {"verse": 25, "start": 152798, "end": 157237, "text": "Pan de nobles comió el hombre: les envió comida a hartura.", "words": [[0, 152798], [4, 152975], [7, 153115], [14, 153515], [20, 154295], [23, 154455], [31, 155178], [35, 155307], [41, 155727], [48, 156187], [50, 156734]]}, {"verse": 26, "start": 157587, "end": 161855, "text": "Movió el solano en el cielo, y trajo con su fortaleza el sur.", "words": [[0, 157587], [6, 158071], [9, 158191], [16, 158631], [19, 158751], [22, 158871], [29, 159331], [31, 159771], [37, 160191], [41, 160391], [44, 160571], [54, 161271], [57, 161411]]}, {"verse": 27, "start": 162205, "end": 168387, "text": "E hizo llover sobre ellos carne como polvo, y aves de alas como arena del mar.", "words": [[0, 162205], [2, 162349], [7, 162589], [14, 163069], [20, 163329], [26, 163709], [32, 164249], [37, 164549], [44, 165649], [46, 165889], [51, 166189], [54, 166449], [59, 166889], [64, 167189], [70, 167589], [74, 167889]]}, {"verse": 28, "start": 168737, "end": 173517, "text": "Y las hizo caer en medio de su campo, alrededor de sus tiendas.", "words": [[0, 168737], [2, 168863], [6, 169003], [11, 169303], [16, 169863], [19, 170003], [25, 170363], [28, 170583], [31, 170743], [38, 171203], [48, 171943], [51, 172563], [55, 172703]]}, {"verse": 29, "start": 173867, "end": 177987, "text": "Y comieron, y se hartaron mucho: les cumplió pues su deseo.", "words": [[0, 173867], [2, 173968], [12, 174428], [14, 174648], [17, 174768], [26, 175228], [33, 176089], [37, 176386], [45, 176716], [50, 176996], [53, 177336]]}, {"verse": 30, "start": 178337, "end": 183188, "text": "No habían quitado de sí su deseo, aún estaba su comida en su boca,", "words": [[0, 178337], [3, 178447], [10, 178667], [18, 179227], [21, 179467], [24, 179607], [27, 179807], [34, 180867], [38, 181127], [45, 181547], [48, 181827], [55, 182167], [58, 182387], [61, 182567]]}, {"verse": 31, "start": 183538, "end": 191584, "text": "Cuando vino sobre ellos el furor de Dios, y mató los más robustos de ellos, y derribó los escogidos de Israel.", "words": [[0, 183538], [7, 183721], [12, 184001], [18, 184341], [24, 184701], [27, 184921], [33, 185341], [36, 185501], [42, 185821], [44, 186301], [49, 186681], [53, 186841], [57, 187121], [66, 188201], [69, 188361], [76, 188681], [78, 189061], [86, 189901], [90, 190041], [100, 190701], [103, 190861]]}, {"verse": 32, "start": 191934, "end": 196426, "text": "Con todo esto pecaron aún, y no dieron crédito a sus maravillas.", "words": [[0, 191934], [4, 192060], [9, 192320], [14, 192580], [22, 193240], [27, 193500], [29, 194000], [32, 194160], [39, 194420], [47, 195140], [49, 195280], [53, 195420]]}, {"verse": 33, "start": 196776, "end": 201487, "text": "Consumió por tanto en nada sus días, y sus años en la tribulación.", "words": [[0, 196776], [9, 197380], [13, 197560], [19, 197900], [22, 198140], [27, 198480], [31, 198760], [37, 199100], [39, 199400], [43, 199580], [48, 199940], [51, 200325], [54, 200465]]}, {"verse": 34, "start": 201837, "end": 207928, "text": "Si los mataba, entonces buscaban a Dios; entonces se volvían solícitos en busca suya.", "words": [[0, 201837], [3, 201981], [7, 202101], [15, 202501], [24, 202881], [33, 203521], [35, 203621], [41, 204376], [50, 205038], [53, 205618], [61, 206058], [71, 206798], [74, 206998], [80, 207218]]}, {"verse": 35, "start": 208278, "end": 214075, "text": "Y se acordaban que Dios era su refugio, y el Dios Alto su redentor.", "words": [[0, 208278], [2, 208387], [5, 208507], [15, 209127], [19, 209327], [24, 209627], [28, 210007], [31, 210227], [40, 211027], [42, 211447], [45, 211587], [50, 211827], [55, 212907], [58, 213047]]}, {"verse": 36, "start": 214425, "end": 218359, "text": "Pero le halagaban con su boca, y con su lengua le mentían:", "words": [[0, 214425], [5, 214569], [8, 214969], [18, 215369], [22, 215529], [25, 215769], [31, 216149], [33, 216729], [37, 216909], [40, 217089], [47, 217469], [50, 217589]]}, {"verse": 37, "start": 218709, "end": 224333, "text": "Pues sus corazones no eran rectos con él, ni estuvieron firmes en su pacto.", "words": [[0, 218709], [5, 218913], [9, 219473], [19, 220173], [22, 220513], [27, 220773], [34, 221353], [38, 221593], [42, 221973], [45, 222353], [56, 222833], [63, 223413], [66, 223573], [69, 223753]]}, {"verse": 38, "start": 224683, "end": 233892, "text": "Pero él misericordioso, perdonaba la maldad, y no los destruía: y abundó para apartar su ira, y no despertó todo su enojo.", "words": [[0, 224683], [5, 224869], [8, 225309], [24, 226329], [34, 226769], [37, 226929], [45, 227389], [47, 227829], [50, 228009], [54, 228169], [64, 229345], [66, 229471], [73, 229931], [78, 230131], [86, 230791], [89, 231071], [94, 231491], [96, 231911], [99, 232071], [108, 232771], [113, 232991], [116, 233251]]}, {"verse": 39, "start": 234242, "end": 238244, "text": "Y se acordó que eran carne; soplo que va y no vuelve.", "words": [[0, 234242], [2, 234350], [5, 234470], [12, 234930], [16, 235050], [21, 235230], [28, 236090], [34, 236712], [38, 236872], [41, 237152], [43, 237492], [46, 237632]]}, {"verse": 40, "start": 238594, "end": 243903, "text": "¡Cuántas veces lo irritaron en el desierto, lo enojaron en la soledad!", "words": [[0, 238594], [9, 238937], [15, 239397], [18, 239737], [28, 240397], [31, 240597], [34, 240737], [44, 241877], [47, 241997], [56, 242877], [59, 243037], [62, 243177]]}, {"verse": 41, "start": 244253, "end": 249224, "text": "Y volvían, y tentaban a Dios, y ponían límite al Santo de Israel.", "words": [[0, 244253], [2, 244400], [11, 244960], [13, 245380], [22, 245900], [24, 246020], [30, 246260], [32, 246880], [39, 247240], [46, 247860], [49, 247980], [55, 248300], [58, 248540]]}, {"verse": 42, "start": 249574, "end": 254273, "text": "No se acordaron de su mano, del día que los redimió de angustia;", "words": [[0, 249574], [3, 249760], [6, 249920], [16, 250560], [19, 250740], [22, 250900], [28, 251320], [32, 252000], [36, 252280], [40, 252660], [44, 253040], [52, 253420], [55, 253520]]}, {"verse": 43, "start": 254623, "end": 259762, "text": "Cuando puso en Egipto sus señales, y sus maravillas en el campo de Zoán;", "words": [[0, 254623], [7, 254880], [12, 255340], [15, 255440], [22, 255980], [26, 256180], [35, 256980], [37, 257180], [41, 257320], [52, 258060], [55, 258380], [58, 258500], [64, 258840], [67, 259324]]}, {"verse": 44, "start": 260112, "end": 265176, "text": "Y volvió sus ríos en sangre, y sus corrientes, porque no bebiesen.", "words": [[0, 260112], [2, 260233], [9, 260653], [13, 260813], [18, 261293], [21, 261493], [29, 262053], [31, 262573], [35, 262733], [47, 263453], [54, 263993], [57, 264253]]}, {"verse": 45, "start": 265526, "end": 271603, "text": "Envió entre ellos una mezcla de moscas que los comían, y ranas que los destruyeron.", "words": [[0, 265526], [6, 265964], [12, 266304], [18, 266664], [22, 266904], [29, 267444], [32, 267584], [39, 268044], [43, 268204], [47, 268364], [55, 268944], [57, 269464], [63, 270084], [67, 270244], [71, 270444]]}, {"verse": 46, "start": 271953, "end": 276912, "text": "dio también al pulgón sus frutos, y sus trabajos a la langosta.", "words": [[0, 271953], [4, 272160], [12, 272620], [15, 272940], [22, 273480], [26, 273720], [34, 274340], [36, 275020], [40, 275200], [49, 275860], [51, 275960], [54, 276060]]}, {"verse": 47, "start": 277262, "end": 281751, "text": "Sus viñas destruyó con granizo, y sus higuerales con piedra;", "words": [[0, 277262], [4, 277405], [10, 277945], [19, 278705], [23, 278885], [32, 279485], [34, 279985], [38, 280185], [49, 280825], [53, 280965]]}, {"verse": 48, "start": 282101, "end": 286590, "text": "Y entregó al pedrisco sus bestias, y al fuego sus ganados.", "words": [[0, 282101], [2, 282222], [10, 282762], [13, 282882], [22, 283442], [26, 283682], [35, 284302], [37, 284737], [40, 284897], [46, 285177], [50, 285777]]}, {"verse": 49, "start": 286940, "end": 293974, "text": "Envió sobre ellos el furor de su saña, ira y enojo y angustia, con misión de malos ángeles.", "words": [[0, 286940], [6, 287384], [12, 287684], [18, 287964], [21, 288224], [27, 288644], [30, 288897], [33, 289151], [39, 289404], [43, 289957], [45, 290089], [51, 290609], [53, 290829], [63, 291869], [67, 292049], [74, 292529], [77, 292749], [83, 293129]]}, {"verse": 50, "start": 294324, "end": 301869, "text": "Dispuso el camino a su furor; no eximió la vida de ellos de la muerte, sino que entregó su vida a la mortandad.", "words": [[0, 294324], [8, 294954], [11, 295134], [18, 295514], [20, 295774], [23, 295894], [30, 296757], [33, 296964], [40, 297564], [43, 297724], [48, 297964], [51, 298184], [57, 298444], [60, 298604], [63, 298704], [71, 299444], [76, 299624], [80, 299824], [88, 300304], [91, 300444], [96, 300784], [98, 300924], [101, 301422]]}, {"verse": 51, "start": 302219, "end": 307297, "text": "E hirió a todo primogénito en Egipto, las primicias de las fuerzas en las tiendas de Cam.", "words": [[0, 302219], [2, 302555], [8, 302905], [10, 303025], [15, 303205], [27, 304125], [30, 304225], [38, 304685], [42, 304825], [52, 305325], [55, 305465], [59, 305565], [67, 306025], [70, 306205], [74, 306325], [82, 306725], [85, 306825]]}, {"verse": 52, "start": 307647, "end": 313116, "text": "Pero hizo salir a su pueblo como ovejas, y los llevó por el desierto, como un rebaño.", "words": [[0, 307647], [5, 307814], [10, 308094], [16, 308534], [18, 308694], [21, 308814], [28, 309174], [33, 309494], [41, 309994], [43, 310374], [47, 310514], [53, 310914], [57, 311074], [60, 311254], [70, 311834], [75, 312154], [78, 312334]]}, {"verse": 53, "start": 313466, "end": 318970, "text": "Y los guió con seguridad, que no tuvieron miedo; y el mar cubrió a sus enemigos.", "words": [[0, 313466], [2, 313569], [6, 313749], [11, 314049], [15, 314249], [26, 315309], [30, 315469], [33, 315649], [42, 316089], [49, 316932], [51, 317058], [54, 317158], [58, 317398], [65, 317918], [67, 318058], [71, 318178]]}, {"verse": 54, "start": 319320, "end": 324400, "text": "Los metió después en los términos de su santuario, en este monte que ganó su mano derecha.", "words": [[0, 319320], [4, 319468], [10, 319828], [18, 320128], [21, 320368], [25, 320508], [34, 321088], [37, 321168], [40, 321308], [51, 321988], [54, 322148], [59, 322348], [65, 322628], [69, 322888], [74, 323228], [77, 323388], [82, 323668]]}, {"verse": 55, "start": 324750, "end": 334511, "text": "Y echó las naciones de delante de ellos, y les repartió una herencia con cuerdas; e hizo habitar en sus moradas a las tribus de Israel.", "words": [[0, 324750], [2, 325083], [7, 325726], [11, 325906], [20, 326346], [23, 326546], [31, 326986], [34, 327166], [41, 327486], [43, 327906], [47, 328436], [56, 328966], [60, 329186], [69, 329846], [73, 330423], [82, 331194], [84, 331338], [89, 331598], [97, 332058], [100, 332198], [104, 332338], [112, 332878], [114, 333058], [118, 333178], [125, 333638], [128, 333758]]}, {"verse": 56, "start": 334861, "end": 340772, "text": "Mas tentaron y enojaron al Dios Altísimo, y no guardaron sus testimonios;", "words": [[0, 334861], [4, 335161], [13, 335901], [15, 336201], [24, 336841], [27, 337041], [32, 337301], [42, 338321], [44, 338881], [47, 339041], [57, 339601], [61, 339781]]}, {"verse": 57, "start": 341122, "end": 347480, "text": "Sino que se volvieron, y se rebelaron como sus padres: se volvieron como arco engañoso.", "words": [[0, 341122], [5, 341348], [9, 341528], [12, 341688], [23, 342268], [25, 342808], [28, 343258], [38, 343708], [43, 343968], [47, 344168], [55, 345175], [58, 345299], [68, 345799], [73, 346099], [78, 346519]]}, {"verse": 58, "start": 347830, "end": 353107, "text": "Y lo enojaron con sus altos, y lo provocaron a celo con sus esculturas.", "words": [[0, 347830], [2, 347956], [5, 348076], [14, 348736], [18, 348956], [22, 349196], [29, 349936], [31, 350256], [34, 350396], [45, 351096], [47, 351256], [52, 351616], [56, 351796], [60, 352016]]}, {"verse": 59, "start": 353457, "end": 358250, "text": "Lo oyó Dios, y se enojó, y en gran manera aborreció a Israel.", "words": [[0, 353457], [3, 353664], [7, 353964], [13, 354164], [15, 354584], [18, 354724], [25, 355464], [27, 355644], [30, 355804], [35, 356004], [42, 356524], [52, 357404], [54, 357484]]}, {"verse": 60, "start": 358600, "end": 364167, "text": "Dejó por tanto el tabernáculo de Silo, la tienda en que habitó entre los hombres;", "words": [[0, 358600], [5, 359087], [9, 359267], [15, 359687], [18, 359947], [30, 360687], [33, 360907], [39, 361887], [42, 361947], [49, 362387], [52, 362547], [56, 362667], [63, 363047], [69, 363207], [73, 363427]]}, {"verse": 61, "start": 364517, "end": 370234, "text": "Y dio en cautividad su fortaleza, y su gloria en mano del enemigo.", "words": [[0, 364517], [2, 364899], [6, 365199], [9, 365559], [20, 366319], [23, 366639], [34, 367559], [36, 367779], [39, 367939], [46, 368479], [49, 368819], [54, 369179], [58, 369459]]}, {"verse": 62, "start": 370584, "end": 375186, "text": "Entregó también su pueblo a filo de espada, y se airó contra su heredad.", "words": [[0, 370584], [8, 371193], [16, 371513], [19, 371793], [26, 372193], [28, 372393], [33, 372713], [36, 372833], [44, 373353], [46, 373493], [49, 373653], [54, 373993], [61, 374273], [64, 374533]]}, {"verse": 63, "start": 375536, "end": 382305, "text": "El fuego devoró sus jóvenes, y sus vírgenes no fueron alabadas en cantos nupciales.", "words": [[0, 375536], [3, 375879], [9, 376199], [16, 376779], [20, 376959], [29, 377519], [31, 378144], [35, 378324], [44, 378844], [47, 379224], [54, 379504], [63, 380344], [66, 380604], [73, 381224]]}, {"verse": 64, "start": 382655, "end": 387269, "text": "Sus sacerdotes cayeron a espada, y sus viudas no lamentaron.", "words": [[0, 382655], [4, 382780], [15, 383580], [23, 384340], [25, 384460], [33, 385080], [35, 385500], [39, 385700], [46, 385970], [49, 386240]]}, {"verse": 65, "start": 387619, "end": 395665, "text": "Entonces despertó el Señor a la manera del que ha dormido, como un valiente que grita excitado del vino:", "words": [[0, 387619], [9, 388222], [18, 389622], [21, 389962], [27, 390362], [29, 390742], [32, 390862], [39, 391222], [43, 391502], [47, 391702], [50, 391842], [59, 392622], [64, 392962], [67, 393162], [76, 393642], [80, 393902], [86, 394302], [95, 394962], [99, 395162]]}, {"verse": 66, "start": 396015, "end": 401458, "text": "E hirió a sus enemigos en las partes posteriores: les dio perpetua afrenta.", "words": [[0, 396015], [2, 396310], [8, 396640], [10, 396880], [14, 397080], [23, 397660], [26, 397840], [30, 398000], [37, 398360], [50, 399646], [54, 399776], [58, 400056], [67, 400792]]}, {"verse": 67, "start": 401808, "end": 406515, "text": "Y desechó el tabernáculo de José, y no escogió la tribu de Efraín;", "words": [[0, 401808], [2, 401934], [10, 402474], [13, 402884], [25, 403294], [28, 403494], [34, 403854], [36, 404294], [39, 404534], [47, 405074], [50, 405194], [56, 405594], [59, 405734]]}, {"verse": 68, "start": 406865, "end": 411795, "text": "Sino que escogió la tribu de Judá, el monte de Sion, al cual amó.", "words": [[0, 406865], [5, 407127], [9, 407387], [17, 408027], [20, 408297], [26, 408567], [29, 408667], [35, 409307], [38, 409407], [44, 409707], [47, 409927], [53, 410827], [56, 410967], [61, 411207]]}, {"verse": 69, "start": 412145, "end": 418428, "text": "Y edificó su santuario a manera de eminencia, como la tierra que cimentó para siempre.", "words": [[0, 412145], [2, 412291], [10, 412911], [13, 413071], [23, 413891], [25, 414051], [32, 414351], [35, 414591], [46, 415571], [51, 416011], [54, 416171], [61, 416511], [65, 416751], [73, 417411], [78, 417591]]}, {"verse": 70, "start": 418778, "end": 423422, "text": "Y eligió a David su siervo, y lo tomó de las majadas de las ovejas:", "words": [[0, 418778], [2, 418940], [9, 419420], [11, 419520], [17, 419840], [20, 420100], [28, 420680], [30, 421140], [33, 421260], [38, 421660], [41, 421720], [45, 421840], [53, 422380], [56, 422540], [60, 422680]]}, {"verse": 71, "start": 423772, "end": 430053, "text": "De tras las paridas lo trajo, para que apacentase a Jacob su pueblo, y a Israel su heredad.", "words": [[0, 423772], [3, 423899], [8, 424119], [12, 424299], [20, 424739], [23, 424939], [30, 425439], [35, 425919], [39, 426099], [50, 426879], [52, 426999], [58, 427319], [61, 427659], [69, 428079], [71, 428419], [73, 428519], [80, 429059], [83, 429459]]}, {"verse": 72, "start": 430403, "end": 436380, "text": "Y los apacentó con entereza de su corazón; y los pastoreó con la pericia de sus manos.", "words": [[0, 430403], [2, 430528], [6, 430668], [15, 431348], [19, 431758], [28, 432168], [31, 432348], [34, 432488], [43, 433511], [45, 433618], [49, 433738], [58, 434458], [62, 434638], [65, 434798], [73, 435258], [76, 435418], [80, 435538]]}]}