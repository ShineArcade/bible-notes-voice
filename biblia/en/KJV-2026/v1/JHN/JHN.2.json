s": [[2, 122175], [7, 122301], [16, 122661], [20, 122861], [25, 123181], [29, 123461], [34, 123701], [37, 123901], [42, 124528], [47, 124649], [52, 124889], [55, 125029], [59, 125109], [64, 125289], [67, 125449], [71, 125629], [78, 125829], [83, 126009], [87, 126089], [90, 126209], [96, 126409]]}, {"verse": 19, "start": 127191, "end": 132662, "text": "Jesus answered and said to them, Destroy this temple, and in three days I will raise it up.", "words": [[0, 127191], [6, 127456], [15, 127976], [19, 128196], [24, 128396], [27, 128576], [33, 129295], [41, 129694], [46, 130014], [54, 130574], [58, 130694], [61, 130814], [67, 131034], [72, 131394], [74, 131734], [79, 131894], [85, 132154], [88, 132314]]}, {"verse": 20, "start": 133012, "end": 138868, "text": "Then said the Jews, Forty and six years was this temple in building, and will you rear it up in three days?", "words": [[0, 133012], [5, 133222], [10, 133462], [14, 133622], [20, 134443], [26, 134508], [30, 134573], [34, 134638], [40, 135258], [44, 135498], [49, 135718], [56, 136038], [59, 136218], [69, 136918], [73, 137018], [78, 137178], [82, 137338], [87, 137638], [90, 137818], [93, 137938], [96, 138078], [102, 138318]]}, {"verse": 21, "start": 139218, "end": 141277, "text": "But he spoke of the temple of his body.", "words": [[0, 139218], [4, 139336], [7, 139436], [13, 139696], [16, 139956], [20, 140076], [27, 140376], [30, 140596], [34, 140716]]}, {"verse": 22, "start": 141727, "end": 151402, "text": "When therefore he was risen from the dead, his disciples remembered that he had said this to them; and they believed the scripture, and the word which Jesus had said.", "words": [[0, 141727], [5, 141910], [15, 142530], [18, 142650], [22, 142850], [28, 143190], [33, 143470], [37, 143650], [43, 144310], [47, 144490], [57, 145010], [68, 145470], [73, 145850], [76, 145990], [80, 146170], [85, 146370], [90, 146670], [93, 146870], [99, 147767], [103, 147909], [108, 148009], [117, 148369], [121, 148589], [132, 149009], [