{"book": "GEN", "chapter": 41, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 485031, "verses": [{"verse": 1, "start": 300, "end": 6688, "text": "Y aconteció que pasados dos años tuvo Faraón un sueño: Le parecía que estaba junto al río;", "words": [[0, 300], [2, 426], [12, 1086], [16, 1326], [24, 1846], [28, 2066], [33, 2386], [38, 2666], [45, 3246], [48, 3406], [55, 4330], [58, 4608], [66, 5128], [70, 5288], [77, 5548], [83, 5848], [86, 6108]]}, {"verse": 2, "start": 7138, "end": 14221, "text": "Y que del río subían siete vacas, hermosas a la vista, y muy gordas, y pacían en el prado:", "words": [[0, 7138], [2, 7241], [6, 7381], [10, 7601], [14, 7981], [21, 8461], [27, 8821], [34, 9901], [43, 10521], [45, 10641], [48, 10701], [55, 11021], [57, 11321], [61, 11501], [69, 12601], [71, 12941], [78, 13281], [81, 13441], [84, 13581]]}, {"verse": 3, "start": 14671, "end": 25784, "text": "Y que otras siete vacas subían tras ellas del río, de fea vista, y flacas de carne, y se pararon cerca de las vacas hermosas a la orilla del río:", "words": [[0, 14671], [2, 14797], [6, 14937], [12, 15317], [18, 15917], [24, 16517], [31, 16917], [36, 17157], [42, 17517], [46, 17797], [51, 18177], [54, 18737], [58, 19097], [65, 19537], [67, 20057], [74, 20497], [77, 20677], [84, 21197], [86, 21590], [89, 21984], [97, 22377], [103, 22797], [106, 23037], [110, 23157], [116, 23557], [125, 24257], [127, 24457], [130, 24577], [137, 24997], [141, 25257]]}, {"verse": 4, "start": 26234, "end": 35301, "text": "Y que las vacas de fea vista y flacas de carne devoraban a las siete vacas hermosas y muy gordas. Y despertó Faraón.", "words": [[0, 26234], [2, 26352], [6, 26492], [10, 26712], [16, 27192], [19, 27312], [23, 27812], [29, 28272], [31, 28452], [38, 28832], [41, 28992], [47, 29432], [57, 30592], [59, 30872], [63, 30972], [69, 31332], [75, 31852], [84, 32412], [86, 32532], [90, 32712], [98, 33838], [100, 33966], [109, 34565]]}, {"verse": 5, "start": 35751, "end": 43331, "text": "Se durmió de nuevo, y soñó la segunda vez: Que siete espigas llenas y hermosas subían de una sola caña:", "words": [[0, 35751], [3, 36011], [10, 36471], [13, 36571], [20, 36871], [22, 37331], [27, 37711], [30, 37831], [38, 38111], [43, 39082], [47, 39166], [53, 39566], [61, 40326], [68, 40726], [70, 40846], [79, 41506], [86, 42106], [89, 42266], [93, 42406], [98, 42686]]}, {"verse": 6, "start": 43781, "end": 49332, "text": "Y que otras siete espigas menudas y abatidas del Solano, salían después de ellas:", "words": [[0, 43781], [2, 43887], [6, 44007], [12, 44287], [18, 44997], [26, 45707], [34, 46207], [36, 46327], [45, 46847], [49, 47007], [57, 47527], [64, 48247], [72, 48487], [75, 48727]]}, {"verse": 7, "start": 49782, "end": 58388, "text": "Y las siete espigas menudas devoraban a las siete espigas gruesas y llenas. Y despertó Faraón, y he aquí que era sueño.", "words": [[0, 49782], [2, 49911], [6, 50051], [12, 50591], [20, 51131], [28, 51711], [38, 52351], [40, 52471], [44, 52651], [50, 53111], [58, 53571], [66, 54131], [68, 54251], [76, 55072], [78, 55392], [87, 56052], [95, 56712], [97, 56932], [100, 57152], [105, 57412], [109, 57612], [113, 57792]]}, {"verse": 8, "start": 58838, "end": 73863, "text": "Y acaeció que a la mañana estaba agitado su espíritu; y envió e hizo llamar a todos los magos de Egipto, y a todos sus sabios: y les contó Faraón sus sueños, pero nadie podía interpretarlos para Faraón.", "words": [[0, 58838], [2, 59145], [10, 59845], [14, 60105], [16, 60205], [19, 60265], [26, 60545], [33, 60945], [41, 61465], [44, 61625], [54, 62592], [56, 62729], [62, 63209], [64, 63469], [69, 63769], [76, 64189], [78, 64269], [84, 64469], [88, 64709], [94, 65149], [97, 65269], [105, 66289], [107, 66489], [109, 66549], [115, 66809], [119, 67249], [127, 68388], [129, 68496], [133, 68616], [139, 69126], [146, 69636], [150, 69816], [158, 70636], [163, 70916], [169, 71376], [175, 71816], [190, 72876], [195, 73374]]}, {"verse": 9, "start": 74313, "end": 81368, "text": "Entonces el principal de los coperos habló a Faraón, diciendo: Hoy me acuerdo de mis faltas:", "words": [[0, 74313], [9, 75294], [12, 75534], [22, 76154], [25, 76434], [29, 76554], [37, 76994], [43, 77434], [45, 78044], [53, 78654], [63, 79749], [67, 79907], [70, 80027], [78, 80347], [81, 80567], [85, 80687]]}, {"verse": 10, "start": 81818, "end": 90219, "text": "Faraón se enojó contra sus siervos, y a mí me echó a la prisión de la casa del capitán de los de la guardia, a mí y al principal de los panaderos:", "words": [[0, 82051], [7, 82301], [10, 82461], [16, 82861], [23, 83081], [27, 83301], [36, 84021], [38, 84301], [40, 84381], [43, 84541], [46, 84701], [51, 85001], [53, 85081], [56, 85161], [64, 85581], [67, 85721], [70, 85821], [75, 86061], [79, 86261], [87, 86781], [90, 86881], [94, 87001], [97, 87121], [100, 87221], [109, 88085], [111, 88192], [114, 88372], [116, 88632], [119, 88732], [129, 89072], [132, 89312], [136, 89432]]}, {"verse": 11, "start": 90669, "end": 96359, "text": "Y yo y él vimos un sueño una misma noche: cada uno soñó conforme a la interpretación de su sueño.", "words": [[0, 90669], [2, 90828], [5, 91048], [7, 91328], [10, 91468], [16, 91608], [19, 91888], [25, 92248], [29, 92428], [35, 92628], [42, 93484], [47, 93629], [51, 93869], [56, 94289], [65, 94809], [67, 94869], [70, 94909], [85, 95589], [88, 95729], [91, 95849]]}, {"verse": 12, "start": 96809, "end": 108091, "text": "Y estaba allí con nosotros un joven hebreo, sirviente del capitán de los de la guardia; y se lo contamos, y él nos interpretó nuestros sueños, e interpretó a cada uno conforme a su sueño.", "words": [[0, 96809], [2, 96908], [9, 97248], [14, 97508], [18, 97708], [27, 98108], [30, 98368], [36, 98708], [44, 99508], [54, 100108], [58, 100328], [66, 100868], [69, 100988], [73, 101128], [76, 101268], [79, 101368], [88, 102226], [90, 102353], [93, 102413], [96, 102533], [106, 103113], [108, 103553], [111, 103693], [115, 103853], [126, 104453], [135, 104593], [143, 105293], [145, 105693], [156, 106313], [158, 106413], [163, 106533], [167, 106853], [176, 107413], [178, 107473], [181, 107573]]}, {"verse": 13, "start": 108541, "end": 115182, "text": "Y aconteció que como él nos interpretó, así fue: a mí me hizo volver a mi puesto, e hizo colgar al otro.", "words": [[0, 108541], [2, 108861], [12, 109461], [16, 109701], [21, 109841], [24, 110041], [28, 110201], [40, 110981], [44, 111181], [49, 111939], [51, 112036], [54, 112216], [57, 112516], [62, 112776], [69, 113056], [71, 113196], [74, 113316], [82, 113736], [84, 114156], [89, 114376], [96, 114716], [99, 114836]]}, {"verse": 14, "start": 115532, "end": 127496, "text": "Entonces Faraón envió y llamó a José; y le hicieron salir corriendo de la cárcel, y le cortaron el pelo, y cambiaron sus vestidos, y vino a Faraón.", "words": [[0, 115532], [9, 116326], [16, 117156], [22, 117776], [24, 118016], [30, 118396], [32, 118496], [38, 119336], [40, 119499], [43, 119639], [52, 120179], [58, 120559], [68, 121279], [71, 121419], [74, 121539], [82, 122099], [84, 122279], [87, 122399], [96, 122999], [99, 123199], [105, 123659], [107, 124099], [117, 124739], [121, 124979], [131, 126039], [133, 126339], [138, 126559], [140, 127055]]}, {"verse": 15, "start": 127946, "end": 135899, "text": "Y dijo Faraón a José: Yo he tenido un sueño, y no hay quien lo interprete; mas he oído decir de ti, que puedes interpretar sueños.", "words": [[0, 127946], [2, 128091], [7, 128511], [14, 128931], [16, 129131], [22, 129930], [25, 130097], [28, 130157], [35, 130397], [38, 130577], [45, 131077], [47, 131277], [50, 131397], [54, 131497], [60, 131657], [63, 131797], [75, 132808], [79, 132970], [82, 133110], [87, 133370], [93, 133670], [96, 133890], [100, 134090], [104, 134350], [111, 134610], [123, 135270]]}, {"verse": 16, "start": 136249, "end": 143283, "text": "Y respondió José a Faraón, diciendo: No está en mí; Dios dará una respuesta favorable a Faraón.", "words": [[0, 136249], [2, 136375], [12, 137075], [17, 137528], [19, 137982], [27, 138435], [37, 139855], [40, 140000], [45, 140180], [48, 140380], [52, 140904], [57, 141121], [62, 141501], [66, 141581], [76, 141921], [86, 142541], [88, 142941]]}, {"verse": 17, "start": 143633, "end": 149286, "text": "Entonces Faraón dijo a José: En mi sueño me parecía que estaba a la orilla del río:", "words": [[0, 143633], [9, 144320], [16, 145050], [21, 145330], [23, 145530], [29, 146164], [32, 146289], [35, 146409], [41, 146769], [44, 146909], [52, 147429], [56, 147649], [63, 147989], [65, 148209], [68, 148289], [75, 148629], [79, 148809]]}, {"verse": 18, "start": 149736, "end": 155748, "text": "Y que del río subían siete vacas de gruesas carnes y hermosa apariencia, que pacían en el prado:", "words": [[0, 149736], [2, 149841], [6, 149941], [10, 150121], [14, 150421], [21, 150881], [27, 151221], [33, 151741], [36, 151861], [44, 152301], [51, 152801], [53, 153021], [61, 153501], [73, 154121], [77, 154581], [84, 155041], [87, 155161], [90, 155281]]}, {"verse": 19, "start": 156198, "end": 165379, "text": "Y que otras siete vacas subían después de ellas, flacas y de muy fea traza; tan extenuadas, que no he visto otras semejantes en toda la tierra de Egipto en fealdad:", "words": [[0, 156198], [2, 156298], [6, 156418], [12, 156638], [18, 156978], [24, 157438], [31, 157818], [39, 158098], [42, 158378], [49, 159038], [56, 159478], [58, 159698], [61, 159798], [65, 159958], [69, 160388], [76, 161092], [80, 161228], [92, 161868], [96, 162108], [99, 162268], [102, 162348], [108, 162588], [114, 162828], [125, 163468], [128, 163628], [133, 163788], [136, 163968], [143, 164248], [146, 164408], [153, 164788], [156, 164868]]}, {"verse": 20, "start": 165829, "end": 169767, "text": "Y las vacas flacas y feas devoraban a las siete primeras vacas gruesas:", "words": [[0, 165829], [2, 165923], [6, 166043], [12, 166423], [19, 166803], [21, 166983], [26, 167203], [36, 167843], [38, 167963], [42, 168063], [48, 168283], [57, 168783], [63, 169143]]}, {"verse": 21, "start": 170217, "end": 179160, "text": "Y entraban en sus entrañas, mas no se conocía que hubiesen entrado en ellas, porque su apariencia seguía tan mala como antes. Y yo desperté.", "words": [[0, 170217], [2, 170316], [11, 170796], [14, 170916], [18, 171016], [28, 172016], [32, 172316], [35, 172536], [38, 172656], [46, 173176], [50, 173316], [59, 173696], [67, 174176], [70, 174316], [77, 174996], [84, 175376], [87, 175596], [98, 176176], [105, 176656], [109, 176816], [114, 177076], [119, 177336], [126, 178256], [128, 178413], [131, 178493]]}, {"verse": 22, "start": 179610, "end": 183942, "text": "Vi también soñando, que siete espigas subían en una misma caña llenas y hermosas;", "words": [[0, 179610], [3, 179729], [11, 179949], [20, 180569], [24, 180709], [30, 180969], [38, 181509], [45, 181909], [48, 182029], [52, 182169], [58, 182389], [63, 182809], [70, 183209], [72, 183329]]}, {"verse": 23, "start": 184392, "end": 190184, "text": "Y que otras siete espigas menudas, marchitas, abatidas del Solano, subían después de ellas:", "words": [[0, 184392], [2, 184474], [6, 184574], [12, 184774], [18, 185114], [26, 185614], [35, 186254], [46, 187194], [55, 187634], [59, 187814], [67, 188614], [74, 189014], [82, 189254], [85, 189534]]}, {"verse": 24, "start": 190634, "end": 198077, "text": "Y las espigas menudas devoraban a las siete espigas hermosas: y lo he dicho a los magos, mas no hay quien me lo interprete.", "words": [[0, 190634], [2, 190737], [6, 190897], [14, 191437], [22, 191937], [32, 192597], [34, 192717], [38, 192857], [44, 193117], [52, 193657], [62, 194675], [64, 194779], [67, 194899], [70, 194999], [76, 195219], [78, 195359], [82, 195479], [89, 196179], [93, 196379], [96, 196639], [100, 196819], [106, 196999], [109, 197159], [112, 197259]]}, {"verse": 25, "start": 198427, "end": 206207, "text": "Entonces respondió José a Faraón: El sueño de Faraón es uno mismo: Dios ha mostrado a Faraón lo que va a hacer.", "words": [[0, 198427], [9, 199452], [19, 199992], [24, 200416], [26, 200839], [34, 201439], [37, 201566], [43, 201926], [46, 202236], [53, 202546], [56, 202686], [60, 202846], [67, 203678], [72, 203941], [75, 204221], [84, 204721], [86, 204861], [93, 205301], [96, 205441], [100, 205561], [103, 205761], [105, 205861]]}, {"verse": 26, "start": 206657, "end": 213865, "text": "Las siete vacas hermosas siete años son; y las espigas hermosas son siete años: el sueño es uno mismo.", "words": [[0, 206657], [4, 206801], [10, 207121], [16, 207601], [25, 208081], [31, 208361], [36, 208641], [41, 209393], [43, 209603], [47, 209763], [55, 210283], [64, 210823], [68, 211003], [74, 211323], [80, 212269], [83, 212391], [89, 212871], [92, 213191], [96, 213351]]}, {"verse": 27, "start": 214315, "end": 225244, "text": "También las siete vacas flacas y feas que subían tras ellas, son siete años; y las siete espigas menudas y marchitas del Solano, siete años serán de hambre.", "words": [[0, 214315], [8, 214638], [12, 214858], [18, 215158], [24, 215598], [31, 215978], [33, 216158], [38, 216398], [42, 216638], [49, 217058], [54, 217238], [61, 217598], [65, 218058], [71, 218358], [77, 219282], [79, 219384], [83, 219524], [89, 219844], [97, 220404], [105, 220904], [107, 221024], [117, 221477], [121, 221931], [129, 222384], [135, 222664], [140, 223024], [146, 223384], [149, 223504]]}, {"verse": 28, "start": 225694, "end": 230615, "text": "Esto es lo que respondo a Faraón. Lo que Dios va a hacer, lo ha mostrado a Faraón.", "words": [[0, 225694], [5, 225963], [8, 226163], [11, 226283], [15, 226403], [24, 226923], [26, 227238], [34, 227791], [37, 227914], [41, 228034], [46, 228274], [49, 228494], [51, 228634], [58, 228954], [61, 229394], [64, 229494], [73, 229934], [75, 230304]]}, {"verse": 29, "start": 231065, "end": 234665, "text": "He aquí vienen siete años de gran abundancia en toda la tierra de Egipto:", "words": [[0, 231065], [3, 231065], [8, 231343], [15, 231643], [21, 231963], [26, 232323], [29, 232523], [34, 232643], [45, 233283], [48, 233423], [53, 233563], [56, 233743], [63, 233983], [66, 234163]]}, {"verse": 30, "start": 235115, "end": 244468, "text": "Y se levantarán tras ellos siete años de hambre; y toda la abundancia será olvidada en la tierra de Egipto; y el hambre consumirá la tierra;", "words": [[0, 235115], [2, 235218], [5, 235318], [16, 235938], [21, 236058], [27, 236398], [33, 236758], [38, 237058], [41, 237258], [49, 237997], [51, 238143], [56, 238303], [59, 238503], [70, 239203], [75, 239463], [84, 240023], [87, 240143], [90, 240223], [97, 240463], [100, 240663], [108, 241453], [110, 241576], [113, 241676], [120, 241976], [130, 242596], [133, 242656]]}, {"verse": 31, "start": 244918, "end": 249791, "text": "Y aquella abundancia no se echará de ver a causa del hambre siguiente, la cual será gravísima.", "words": [[0, 244918], [2, 245038], [10, 245338], [21, 245918], [24, 246078], [27, 246218], [34, 246618], [37, 246718], [41, 246878], [43, 246958], [49, 247218], [53, 247448], [60, 247678], [71, 248518], [74, 248578], [79, 248798], [84, 249078]]}, {"verse": 32, "start": 250241, "end": 258123, "text": "Y el suceder el sueño a Faraón dos veces, significa que la cosa es firme de parte de Dios, y que Dios se apresura a hacerla.", "words": [[0, 250241], [2, 250347], [5, 250447], [13, 250967], [16, 251107], [22, 251487], [24, 251607], [31, 252067], [35, 252247], [42, 252687], [52, 253407], [56, 253887], [59, 254007], [64, 254267], [67, 254487], [73, 254767], [76, 254867], [82, 255127], [85, 255327], [91, 255567], [93, 256267], [97, 256387], [102, 256627], [105, 256827], [114, 257347], [116, 257487]]}, {"verse": 33, "start": 258573, "end": 264596, "text": "Por tanto, provéase ahora Faraón de un varón prudente y sabio, y póngalo sobre la tierra de Egipto.", "words": [[0, 258573], [4, 258684], [11, 259404], [20, 259844], [26, 260164], [33, 260684], [36, 260804], [39, 260924], [45, 261224], [54, 261644], [56, 261804], [63, 262584], [65, 262764], [73, 263264], [79, 263524], [82, 263684], [89, 263964], [92, 264144]]}, {"verse": 34, "start": 265046, "end": 272629, "text": "Haga esto Faraón, y ponga gobernadores sobre el país, y recoja la quinta parte de las cosechas de Egipto en los siete años de abundancia;", "words": [[0, 265046], [5, 265185], [10, 265465], [18, 265965], [20, 266065], [26, 266385], [39, 266985], [45, 267265], [48, 267425], [54, 267725], [56, 268285], [63, 268765], [66, 268865], [73, 269225], [79, 269545], [82, 269765], [86, 269885], [95, 270385], [98, 270525], [105, 270945], [108, 271065], [112, 271165], [118, 271385], [123, 271705], [126, 271885]]}, {"verse": 35, "start": 273079, "end": 281867, "text": "Y junten toda la provisión de estos buenos años que vienen, y acumulen el trigo bajo la mano de Faraón para mantenimiento de las ciudades; y guárdenlo.", "words": [[0, 273079], [2, 273197], [9, 273537], [14, 273757], [17, 273937], [27, 274437], [30, 274617], [36, 274797], [43, 275097], [48, 275457], [52, 275717], [60, 276097], [62, 276357], [71, 276817], [74, 277037], [80, 277397], [85, 277597], [88, 277797], [93, 278037], [96, 278377], [103, 278717], [108, 278977], [122, 279757], [125, 279897], [129, 280037], [139, 281085], [141, 281187]]}, {"verse": 36, "start": 282317, "end": 292047, "text": "Y esté aquella provisión en depósito para el país, para los siete años del hambre que serán en la tierra de Egipto; y el país no perecerá de hambre.", "words": [[0, 282317], [2, 282420], [7, 282640], [15, 283020], [25, 283600], [28, 283760], [37, 284360], [42, 284600], [45, 284740], [51, 285480], [56, 285740], [60, 285900], [66, 286160], [71, 286520], [75, 286800], [82, 287100], [86, 287260], [92, 287640], [95, 287720], [98, 287820], [105, 288120], [108, 288320], [116, 289200], [118, 289299], [121, 289399], [126, 289679], [129, 290019], [138, 290659], [141, 290739]]}, {"verse": 37, "start": 292397, "end": 296178, "text": "Y el asunto pareció bien a Faraón, y a sus siervos.", "words": [[0, 292397], [2, 292561], [5, 292661], [12, 293061], [20, 293581], [25, 293801], [27, 293941], [35, 294521], [37, 295181], [39, 295221], [43, 295401]]}, {"verse": 38, "start": 296628, "end": 302319, "text": "Y dijo Faraón a sus siervos: ¿Hemos de hallar otro hombre como este, en quien haya espíritu de Dios?", "words": [[0, 296628], [2, 296754], [7, 297014], [14, 297514], [16, 297594], [20, 297754], [29, 298799], [36, 298978], [39, 299178], [46, 299398], [51, 299598], [58, 299858], [63, 300078], [69, 300758], [72, 300918], [78, 301078], [83, 301258], [92, 301778], [95, 301878]]}, {"verse": 39, "start": 302669, "end": 309214, "text": "Y dijo Faraón a José: Pues que Dios te ha hecho saber todo esto, no hay entendido ni sabio como tú:", "words": [[0, 302669], [2, 302815], [7, 303235], [14, 303655], [16, 303855], [22, 304653], [27, 304783], [31, 304943], [36, 305183], [39, 305463], [42, 305603], [48, 305803], [54, 306083], [59, 306363], [65, 307303], [68, 307423], [72, 307623], [82, 308123], [85, 308243], [91, 308643], [96, 308823]]}, {"verse": 40, "start": 309664, "end": 316479, "text": "Tú serás sobre mi casa, y por tu palabra se gobernará todo mi pueblo: solamente en el trono seré yo mayor que tú.", "words": [[0, 309664], [3, 309748], [9, 310128], [15, 310388], [18, 310548], [24, 310888], [26, 311348], [30, 311528], [33, 311668], [41, 312028], [44, 312288], [54, 312828], [59, 312988], [62, 313188], [70, 314069], [80, 314490], [83, 314770], [86, 314890], [92, 315210], [97, 315510], [100, 315610], [106, 315890], [110, 316110]]}, {"verse": 41, "start": 316829, "end": 322118, "text": "Dijo más Faraón a José: He aquí yo te he puesto sobre toda la tierra de Egipto.", "words": [[0, 316829], [5, 317133], [9, 317453], [16, 318093], [18, 318293], [24, 319081], [27, 319220], [32, 319680], [35, 319780], [38, 319940], [41, 320020], [48, 320300], [54, 320600], [59, 320860], [62, 321080], [69, 321360], [72, 321580]]}, {"verse": 42, "start": 322468, "end": 333662, "text": "Entonces Faraón quitó su anillo de su mano, y lo puso en la mano de José, y le hizo vestir de ropas de lino finísimo, y puso un collar de oro en su cuello;", "words": [[0, 322468], [9, 323184], [16, 323934], [22, 324354], [25, 324534], [32, 324914], [35, 325074], [38, 325254], [44, 325574], [46, 326134], [49, 326254], [54, 326594], [57, 326734], [60, 326834], [65, 327054], [68, 327214], [74, 327554], [76, 328014], [79, 328174], [84, 328414], [91, 328994], [94, 329274], [100, 329554], [103, 329714], [108, 330014], [118, 331063], [120, 331324], [125, 331664], [128, 331944], [135, 332224], [138, 332384], [142, 332704], [145, 332864], [148, 333064]]}, {"verse": 43, "start": 334112, "end": 343650, "text": "Y lo hizo subir en su segundo carro, y pregonaron delante de él: Doblad la rodilla: y lo puso sobre toda la tierra de Egipto.", "words": [[0, 334112], [2, 334237], [5, 334397], [10, 334677], [16, 335157], [19, 335377], [22, 335557], [30, 335997], [37, 336557], [39, 337177], [50, 337857], [58, 338437], [61, 338637], [65, 339294], [72, 339699], [75, 339819], [84, 340758], [86, 340866], [89, 341006], [94, 341366], [100, 341646], [105, 342046], [108, 342306], [115, 342666], [118, 342926]]}, {"verse": 44, "start": 344100, "end": 352998, "text": "Y dijo Faraón a José: Yo Faraón; y sin ti ninguno alzará su mano ni su pie en toda la tierra de Egipto.", "words": [[0, 344100], [2, 344245], [7, 344665], [14, 345085], [16, 345285], [22, 346158], [25, 346268], [33, 347163], [35, 347252], [39, 347412], [42, 347652], [50, 348112], [57, 348512], [60, 348652], [65, 348912], [68, 349092], [71, 349292], [75, 349512], [78, 349852], [83, 350032], [86, 350232], [93, 350492], [96, 350692]]}, {"verse": 45, "start": 353348, "end": 365954, "text": "Y llamó Faraón el nombre de José, Zafnat-panea; y le dio por mujer a Asenat, hija de Potifera, sacerdote de On. Y salió José por toda la tierra de Egipto.", "words": [[0, 353348], [2, 353457], [8, 353857], [15, 354257], [18, 354357], [25, 354657], [28, 354877], [34, 355865], [48, 357113], [50, 357410], [53, 357530], [57, 357750], [61, 357990], [67, 358370], [69, 358670], [77, 359790], [82, 360230], [85, 360350], [95, 361250], [105, 361686], [108, 362121], [112, 362814], [114, 363082], [120, 363442], [125, 363822], [129, 364122], [134, 364442], [137, 364682], [144, 364962], [147, 365262]]}, {"verse": 46, "start": 366404, "end": 378483, "text": "Y era José de edad de treinta años cuando fue presentado delante de Faraón, rey de Egipto: y salió José de delante de Faraón, y transitó por toda la tierra de Egipto.", "words": [[0, 366404], [2, 366565], [6, 366745], [11, 367025], [14, 367305], [19, 367665], [22, 367935], [30, 368205], [35, 368705], [42, 368925], [46, 369245], [57, 369985], [65, 370485], [68, 370645], [76, 371525], [80, 371965], [83, 372105], [91, 373146], [93, 373272], [99, 373612], [104, 373952], [107, 374132], [115, 374632], [118, 375012], [126, 375392], [128, 375872], [137, 376472], [141, 376752], [146, 376992], [149, 377252], [156, 377592], [159, 377812]]}, {"verse": 47, "start": 378933, "end": 383717, "text": "E hizo la tierra en aquellos siete años de abundancia a montones.", "words": [[0, 378933], [2, 379076], [7, 379336], [10, 379536], [17, 379956], [20, 380176], [29, 380456], [35, 381096], [40, 381596], [43, 381816], [54, 382596], [56, 382856]]}, {"verse": 48, "start": 384167, "end": 396980, "text": "Y él juntó todo el alimento de los siete años que fueron en la tierra de Egipto, y guardó alimento en las ciudades, poniendo en cada ciudad el alimento del campo de sus alrededores.", "words": [[0, 384167], [2, 384331], [5, 384471], [11, 384931], [16, 385191], [19, 385411], [28, 385851], [31, 386091], [35, 386211], [41, 386511], [46, 387031], [50, 387271], [57, 387571], [60, 387811], [63, 387911], [70, 388251], [73, 388471], [81, 389111], [83, 389791], [90, 390231], [99, 390771], [102, 390991], [106, 391171], [116, 392466], [125, 392890], [128, 393050], [133, 393310], [140, 393710], [143, 394050], [152, 394550], [156, 394810], [162, 395270], [165, 395530], [169, 395670]]}, {"verse": 49, "start": 397430, "end": 404725, "text": "Y acumuló José trigo como arena del mar, mucho en extremo, hasta no poderse contar, porque no tenía número.", "words": [[0, 397430], [2, 397569], [10, 398169], [15, 398449], [21, 398949], [26, 399229], [32, 399569], [36, 399849], [41, 400689], [47, 401029], [50, 401169], [59, 402189], [65, 402429], [68, 402609], [76, 403029], [84, 403369], [91, 403709], [94, 403889], [100, 404189]]}, {"verse": 50, "start": 405175, "end": 414801, "text": "Y nacieron a José dos hijos antes que viniese el primer año del hambre, los cuales le parió Asenat, hija de Potifera, sacerdote de On.", "words": [[0, 405175], [2, 405321], [11, 405801], [13, 405961], [18, 406221], [22, 406481], [28, 406801], [34, 407181], [38, 407561], [46, 407941], [49, 408161], [56, 408481], [60, 408821], [64, 409041], [72, 409461], [76, 409881], [83, 410301], [86, 410441], [92, 411181], [100, 411921], [105, 412181], [108, 412281], [118, 413381], [128, 413874], [131, 414367]]}, {"verse": 51, "start": 415251, "end": 425642, "text": "Y llamó José el nombre del primogénito Manasés; porque Dios ( dijo ) me hizo olvidar todo mi trabajo, y toda la casa de mi padre.", "words": [[0, 415251], [2, 415527], [8, 415807], [13, 416147], [16, 416447], [23, 416867], [27, 417147], [39, 418020], [48, 419129], [55, 419412], [60, 419852], [62, 420292], [67, 420752], [69, 421212], [72, 421372], [77, 421672], [85, 422312], [90, 422552], [93, 422812], [102, 423312], [104, 423952], [109, 424132], [112, 424372], [117, 424632], [120, 424852], [123, 424992]]}, {"verse": 52, "start": 426092, "end": 434332, "text": "Y el nombre del segundo lo llamó Efraín; porque Dios ( dijo ) me hizo fértil en la tierra de mi aflicción.", "words": [[0, 426092], [2, 426238], [5, 426378], [12, 426758], [16, 427038], [24, 427478], [27, 427738], [33, 428118], [41, 429306], [48, 429525], [53, 429665], [55, 429805], [60, 430295], [62, 430785], [65, 431005], [70, 431245], [77, 431805], [80, 432065], [83, 432165], [90, 432445], [93, 432625], [96, 432725]]}, {"verse": 53, "start": 434682, "end": 440083, "text": "Y se cumplieron los siete años de la abundancia, que hubo en la tierra de Egipto.", "words": [[0, 434682], [2, 434789], [5, 434909], [16, 435589], [20, 435769], [26, 436049], [31, 436409], [34, 436609], [37, 436769], [49, 437869], [53, 438349], [58, 438649], [61, 438729], [64, 438849], [71, 439129], [74, 439409]]}, {"verse": 54, "start": 440533, "end": 450753, "text": "Y comenzaron a venir los siete años del hambre, como José había dicho: y hubo hambre en todos los países, mas en toda la tierra de Egipto había pan.", "words": [[0, 440533], [2, 440623], [13, 441263], [15, 441383], [21, 441643], [25, 441863], [31, 442223], [36, 442603], [40, 442823], [48, 443483], [53, 443703], [58, 444003], [64, 444283], [71, 445165], [73, 445323], [78, 445643], [85, 446163], [88, 446483], [94, 446703], [98, 446943], [106, 447523], [110, 448103], [113, 448363], [118, 448523], [121, 448743], [128, 449063], [131, 449303], [138, 449743], [144, 450183]]}, {"verse": 55, "start": 451203, "end": 463171, "text": "Y cuando se sintió el hambre en toda la tierra de Egipto, el pueblo clamó a Faraón por pan. Y dijo Faraón a todos los egipcios: Id a José, y haced lo que él os diga.", "words": [[0, 451203], [2, 451311], [9, 451551], [12, 451811], [19, 452331], [22, 452471], [29, 452871], [32, 453151], [37, 453391], [40, 453631], [47, 454011], [50, 454191], [58, 455331], [61, 455451], [68, 455931], [74, 456411], [76, 456511], [83, 456971], [87, 457191], [92, 458135], [94, 458236], [99, 458666], [106, 459096], [108, 459256], [114, 459536], [118, 459796], [128, 460946], [131, 461046], [133, 461146], [139, 461486], [141, 461826], [147, 462126], [150, 462286], [154, 462446], [157, 462586], [160, 462706]]}, {"verse": 56, "start": 463521, "end": 476433, "text": "Y el hambre estaba por toda la extensión del país. Entonces abrió José todo granero donde había, y vendía a los egipcios; porque había crecido el hambre en la tierra de Egipto.", "words": [[0, 463521], [2, 463667], [5, 463827], [12, 464307], [19, 464587], [23, 464927], [28, 465187], [31, 465447], [41, 466167], [45, 466387], [51, 467453], [60, 468039], [66, 468859], [71, 469239], [76, 469599], [84, 470239], [90, 470479], [97, 470959], [99, 471219], [106, 471719], [108, 471859], [112, 472015], [122, 472470], [129, 473530], [135, 473960], [143, 474390], [146, 474550], [153, 474930], [156, 475110], [159, 475210], [166, 475590], [169, 475770]]}, {"verse": 57, "start": 476883, "end": 484631, "text": "Y toda la tierra venía a Egipto para comprar de José, porque por toda la tierra había crecido el hambre.", "words": [[0, 476883], [2, 477006], [7, 477286], [10, 477526], [17, 477986], [23, 478666], [25, 478886], [32, 479486], [37, 479686], [45, 480106], [48, 480526], [54, 480946], [61, 481746], [65, 482026], [70, 482326], [73, 482586], [80, 482986], [86, 483346], [94, 483946], [97, 484126]]}]}