{"book": "ISA", "chapter": 41, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 283185, "verses": [{"verse": 1, "start": 300, "end": 9073, "text": "Escuchadme, islas, y esfuércense los pueblos; acérquense, y entonces hablen: estemos juntamente a juicio.", "words": [[0, 300], [12, 906], [19, 1286], [21, 1806], [33, 2446], [37, 2646], [46, 3953], [58, 4578], [60, 5058], [69, 5398], [77, 6719], [85, 7143], [96, 7783], [98, 7923]]}, {"verse": 2, "start": 9781, "end": 24148, "text": "¿Quién despertó del oriente al justo, lo llamó para que le siguiese, entregó delante de él naciones, y lo hizo enseñorear de reyes; los entregó a su espada como polvo, y a su arco como hojarascas arrebatadas?", "words": [[0, 9781], [7, 9942], [16, 10682], [20, 10862], [28, 11282], [31, 11422], [38, 12262], [41, 12382], [47, 12722], [52, 12902], [56, 13062], [59, 13162], [69, 14122], [77, 14682], [85, 15182], [88, 15382], [91, 15542], [101, 16142], [103, 16662], [106, 16802], [111, 17292], [122, 17782], [125, 17942], [132, 19052], [136, 19198], [144, 19758], [146, 19838], [149, 19958], [156, 20438], [161, 20658], [168, 21438], [170, 21718], [172, 21798], [175, 21978], [180, 22338], [185, 22758], [196, 23178]]}, {"verse": 3, "start": 24842, "end": 29569, "text": "Los siguió, pasó en paz por camino por donde sus pies nunca habían entrado.", "words": [[0, 24889], [4, 24969], [12, 25469], [17, 25689], [20, 25889], [24, 26089], [28, 26329], [35, 27069], [39, 27309], [45, 27529], [49, 27809], [54, 28109], [60, 28449], [67, 28869]]}, {"verse": 4, "start": 30243, "end": 38679, "text": "¿Quién obró e hizo esto? ¿Quién llama las generaciones desde el principio? Yo Jehová, el primero, y yo mismo con los postreros.", "words": [[0, 30243], [7, 30504], [12, 30844], [14, 31124], [19, 31304], [25, 32408], [32, 32670], [38, 32910], [42, 33130], [55, 33730], [61, 33970], [64, 34170], [75, 35468], [78, 35629], [86, 35989], [89, 36049], [98, 36849], [100, 37029], [103, 37149], [109, 37429], [113, 37709], [117, 37849]]}, {"verse": 5, "start": 39378, "end": 46705, "text": "Las islas vieron, y tuvieron temor; los confines de la tierra se espantaron: se congregaron, y vinieron.", "words": [[0, 39378], [4, 39483], [10, 39863], [18, 40343], [20, 40583], [29, 41023], [36, 42128], [40, 42227], [49, 42727], [52, 42867], [55, 42947], [62, 43287], [65, 43607], [77, 44989], [80, 45115], [93, 45775], [95, 46155]]}, {"verse": 6, "start": 47431, "end": 52440, "text": "Cada cual ayudó a su cercano; y a su hermano dijo: Esfuérzate.", "words": [[0, 47431], [5, 47615], [10, 47895], [16, 48495], [18, 48555], [21, 48635], [30, 49883], [32, 49999], [34, 50059], [37, 50179], [45, 50539], [51, 51960]]}, {"verse": 7, "start": 53149, "end": 65263, "text": "El carpintero animó al platero, y el que alisa con martillo al que batía en el yunque, diciendo, Buena está la soldadura; y lo afirmó con clavos, porque no se moviese.", "words": [[0, 54369], [3, 54929], [14, 55489], [20, 55889], [23, 55989], [32, 56749], [34, 56949], [37, 57029], [41, 57229], [47, 57429], [51, 57609], [60, 58109], [63, 58389], [67, 58469], [73, 58889], [76, 58989], [79, 59089], [87, 59509], [97, 60629], [103, 60929], [108, 61189], [111, 61329], [122, 62513], [124, 62633], [127, 62753], [134, 63193], [138, 63333], [146, 63913], [153, 64233], [156, 64413], [159, 64573]]}, {"verse": 8, "start": 65972, "end": 73151, "text": "Pero tú, Israel, siervo mío eres; tú, Jacob, a quien yo escogí, descendencia de Abraham mi amigo.", "words": [[0, 65972], [5, 66113], [9, 66353], [17, 67193], [24, 67473], [28, 67833], [34, 69017], [38, 69381], [45, 70001], [47, 70121], [53, 70221], [56, 70401], [64, 71261], [77, 71941], [80, 72081], [88, 72601], [91, 72661]]}, {"verse": 9, "start": 73857, "end": 83189, "text": "Porque te tomé de los extremos de la tierra, y de tierras lejanas te llamé, y te dije: Mi siervo eres tú; te escogí, y no te deseché.", "words": [[0, 73857], [7, 74027], [10, 74227], [15, 74567], [18, 74647], [22, 74767], [31, 75367], [34, 75467], [37, 75547], [45, 76027], [47, 76567], [50, 76827], [58, 77087], [66, 77454], [69, 77820], [76, 78187], [78, 78507], [81, 78627], [87, 79605], [90, 79748], [97, 80188], [102, 80388], [106, 81381], [109, 81459], [117, 81979], [119, 82239], [122, 82399], [125, 82539]]}, {"verse": 10, "start": 83882, "end": 94088, "text": "No temas, que yo soy contigo; no desmayes, que yo soy tu Dios que te esfuerzo: siempre te ayudaré, siempre te sustentaré con la diestra de mi justicia.", "words": [[0, 83882], [3, 84006], [10, 84286], [14, 84486], [17, 84646], [21, 84826], [30, 86024], [33, 86183], [43, 86903], [47, 87043], [50, 87203], [54, 87443], [57, 87623], [62, 87903], [66, 88163], [69, 88303], [79, 89589], [87, 90038], [90, 90198], [99, 91018], [107, 91358], [110, 91578], [121, 92278], [125, 92458], [128, 92598], [136, 93038], [139, 93198], [142, 93298]]}, {"verse": 11, "start": 94782, "end": 103791, "text": "He aquí que todos los que se airan contra ti, serán avergonzados y confundidos: serán como nada y perecerán, los que contienden contigo.", "words": [[0, 94782], [3, 94926], [8, 95186], [12, 95346], [18, 95646], [22, 95926], [26, 96106], [29, 96306], [35, 96626], [42, 96886], [46, 97166], [52, 97906], [65, 98666], [67, 98886], [80, 100383], [86, 100711], [91, 100911], [96, 101231], [98, 101471], [109, 102151], [113, 102411], [117, 102551], [128, 103111]]}, {"verse": 12, "start": 104473, "end": 113099, "text": "Los buscarás, y no los hallarás, los que tienen contienda contigo; serán como nada, y como cosa que no es, aquellos que te hacen guerra.", "words": [[0, 104473], [4, 104598], [14, 105298], [16, 105558], [19, 105698], [23, 105838], [33, 106458], [37, 106618], [41, 106758], [48, 107058], [58, 107618], [67, 108862], [73, 109209], [78, 109389], [84, 109749], [86, 109929], [91, 110089], [96, 110429], [100, 110609], [103, 110809], [107, 111249], [116, 111829], [120, 112089], [123, 112229], [129, 112664]]}, {"verse": 13, "start": 113785, "end": 120681, "text": "Porque yo Jehová soy tu Dios, que te ase de tu mano derecha, y te dice: No temas, yo te ayudé.", "words": [[0, 113785], [7, 113986], [10, 114286], [17, 114766], [21, 114946], [24, 115126], [30, 115926], [34, 116146], [37, 116336], [41, 116526], [44, 116686], [47, 116826], [52, 117026], [61, 117666], [63, 117886], [66, 118006], [72, 119027], [75, 119211], [82, 119831], [85, 119891], [88, 120091]]}, {"verse": 14, "start": 121380, "end": 131541, "text": "No temas, gusano de Jacob, oh vosotros los pocos de Israel; yo te socorrí, dice Jehová, y tu Redentor el Santo de Israel.", "words": [[0, 121380], [3, 121523], [10, 121843], [17, 122443], [20, 122583], [27, 123013], [30, 123443], [39, 124003], [43, 124223], [49, 124703], [52, 124783], [60, 126004], [63, 126169], [66, 126329], [75, 127592], [80, 127956], [88, 128976], [90, 129116], [93, 129276], [102, 129706], [105, 130136], [111, 130436], [114, 130716]]}, {"verse": 15, "start": 131841, "end": 141217, "text": "He aquí que yo te he puesto por trillo, trillo nuevo, lleno de dientes: trillarás montes y los molerás, y collados tornarás en tamo.", "words": [[0, 131841], [3, 131963], [8, 132243], [12, 132423], [15, 132583], [18, 132763], [21, 132843], [28, 133143], [32, 133423], [40, 134203], [47, 134603], [54, 135383], [60, 135663], [63, 135763], [72, 136998], [82, 137497], [89, 138097], [91, 138257], [95, 138377], [104, 138837], [106, 139397], [115, 139897], [124, 140557], [127, 140737]]}, {"verse": 16, "start": 141951, "end": 151209, "text": "Los aventarás, y los llevará el viento, y los esparcirá el torbellino. Pero tú te regocijarás en Jehová, te gloriarás en el Santo de Israel.", "words": [[0, 141951], [4, 142077], [15, 142917], [17, 143237], [21, 143377], [29, 143737], [32, 143837], [40, 144297], [42, 144757], [46, 144917], [56, 145597], [59, 145697], [71, 147015], [76, 147139], [79, 147419], [82, 147889], [94, 148359], [97, 148479], [105, 149179], [108, 149299], [118, 149899], [121, 150019], [124, 150139], [130, 150419], [133, 150639]]}, {"verse": 17, "start": 151917, "end": 162569, "text": "Los afligidos y necesitados buscan las aguas, que no hay; se secó de sed su lengua; yo Jehová los oiré, yo el Dios de Israel no los desampararé.", "words": [[0, 151917], [4, 152053], [14, 152753], [16, 152913], [28, 153713], [35, 154293], [39, 154473], [46, 155273], [50, 155433], [53, 155633], [58, 156522], [61, 156662], [66, 157082], [69, 157162], [73, 157402], [76, 157642], [84, 158726], [87, 158936], [94, 159182], [98, 159429], [104, 160169], [107, 160389], [110, 160549], [115, 160829], [118, 160949], [125, 161309], [128, 161589], [132, 161749]]}, {"verse": 18, "start": 163247, "end": 173199, "text": "En los altos abriré ríos, y fuentes en mitad de los llanos: tornaré el desierto en estanques de aguas, y en manaderos de aguas la tierra seca.", "words": [[0, 163247], [3, 163385], [7, 163505], [13, 164085], [20, 164545], [26, 165065], [28, 165485], [36, 165945], [39, 166185], [45, 166425], [48, 166685], [52, 166805], [60, 168050], [68, 168469], [71, 168649], [80, 169209], [83, 169389], [93, 169969], [96, 170129], [103, 170649], [105, 170949], [108, 171049], [118, 171649], [121, 171809], [127, 172189], [130, 172329], [137, 172589]]}, {"verse": 19, "start": 173887, "end": 182843, "text": "Daré en el desierto cedros, espinos, arrayanes, y olivos; pondré en la soledad hayas, olmos, y álamos juntamente;", "words": [[0, 173887], [5, 174287], [8, 174487], [11, 174587], [20, 175047], [28, 175947], [37, 176767], [48, 177307], [50, 177627], [58, 178860], [65, 179223], [68, 179443], [71, 179544], [79, 180136], [86, 180730], [93, 181324], [95, 181563], [102, 181924]]}, {"verse": 20, "start": 183517, "end": 191291, "text": "Porque vean y conozcan, y adviertan y entiendan todos, que la mano de Jehová hace esto, y que el Santo de Israel lo creó.", "words": [[0, 183517], [7, 183741], [12, 184201], [14, 184281], [24, 184901], [26, 185201], [36, 185881], [38, 185981], [48, 186521], [55, 186841], [59, 187421], [62, 187541], [67, 187821], [70, 187981], [77, 188521], [82, 188801], [88, 189221], [90, 189641], [94, 189761], [97, 189881], [103, 190161], [106, 190361], [113, 190681], [116, 190861]]}, {"verse": 21, "start": 192001, "end": 199011, "text": "Presentad vuestra causa, dice Jehová: presentad vuestros fundamentos, dice el Rey de Jacob.", "words": [[0, 192001], [10, 192560], [18, 192900], [25, 193740], [30, 194130], [38, 195055], [48, 195623], [57, 196003], [70, 197541], [75, 197844], [78, 198044], [82, 198344], [85, 198424]]}, {"verse": 22, "start": 199311, "end": 211111, "text": "Traigan, y anúnciennos lo que ha de venir: dígannos lo que ha pasado desde el principio, y pondremos nuestro corazón en ello: sepamos también su final, y hacednos entender lo que ha de venir.", "words": [[0, 199311], [9, 199718], [11, 199978], [23, 200738], [26, 200978], [30, 201138], [33, 201258], [36, 201398], [43, 202653], [52, 202943], [55, 203183], [59, 203343], [62, 203443], [69, 203783], [75, 204043], [78, 204203], [89, 204723], [91, 205163], [101, 205603], [109, 205903], [117, 206323], [120, 206543], [126, 207484], [134, 207921], [142, 208181], [145, 208421], [152, 208741], [154, 209191], [163, 209641], [172, 210021], [175, 210361], [179, 210521], [182, 210601], [185, 210701]]}, {"verse": 23, "start": 211791, "end": 224703, "text": "Dadnos nuevas de lo que ha de ser después, para que sepamos que vosotros sois dioses; o a lo menos haced bien, o mal, para que tengamos qué contar, y juntamente nos maravillemos.", "words": [[0, 211791], [7, 212252], [14, 212652], [17, 212872], [20, 212972], [24, 213132], [27, 213252], [30, 213372], [34, 213532], [43, 214352], [48, 214692], [52, 214872], [60, 215452], [64, 215672], [73, 216192], [78, 216512], [86, 217763], [88, 217923], [90, 217983], [93, 218083], [99, 218403], [105, 218983], [111, 219323], [113, 219743], [118, 220063], [123, 220703], [127, 220863], [136, 221363], [140, 221563], [148, 222023], [150, 222543], [161, 223303], [165, 223643]]}, {"verse": 24, "start": 225403, "end": 231778, "text": "He aquí que vosotros sois de nada, y vuestras obras de vanidad; abominación el que os escogió.", "words": [[0, 225403], [3, 225547], [8, 225827], [12, 226007], [21, 226487], [26, 226827], [29, 226967], [35, 227267], [37, 227807], [46, 228247], [52, 228507], [55, 228747], [64, 229833], [76, 230558], [79, 230838], [83, 230978], [86, 231098]]}, {"verse": 25, "start": 232465, "end": 244150, "text": "Del norte desperté uno, y vendrá; del nacimiento del sol llamará en mi nombre: y pisoteará príncipes como lodo, y como pisa el barro el alfarero.", "words": [[0, 232465], [4, 232601], [10, 232981], [19, 233561], [24, 233801], [26, 234141], [34, 236585], [38, 236685], [49, 237285], [53, 237445], [57, 237745], [65, 238225], [68, 238325], [71, 238425], [79, 239685], [81, 239810], [91, 240430], [101, 241150], [106, 241410], [112, 241850], [114, 242210], [119, 242430], [124, 242830], [127, 242950], [133, 243350], [136, 243510]]}, {"verse": 26, "start": 244842, "end": 259192, "text": "¿Quién lo anunció desde el principio, para que sepamos; o de tiempo atrás, y diremos: Es justo? Cierto, no hay quien anuncie, sí, no hay quien enseñe, ciertamente no hay quien oiga vuestras palabras.", "words": [[0, 244842], [7, 245060], [10, 245140], [18, 245640], [24, 245780], [27, 245960], [38, 246540], [43, 247200], [47, 247340], [56, 248612], [58, 248752], [61, 248852], [68, 249132], [75, 249512], [77, 249912], [86, 251016], [89, 251276], [96, 252420], [104, 252942], [107, 253042], [111, 253242], [117, 253462], [126, 254262], [130, 254802], [133, 254922], [137, 255102], [143, 255342], [151, 256182], [163, 256982], [166, 257282], [170, 257482], [176, 257742], [181, 258182], [190, 258582]]}, {"verse": 27, "start": 259926, "end": 266265, "text": "Yo soy el primero que he enseñado estas cosas a Sion, y a Jerusalén daré un portador de alegres nuevas.", "words": [[0, 259926], [3, 260075], [7, 260275], [10, 260435], [18, 260775], [22, 261015], [25, 261115], [34, 261615], [40, 261795], [46, 262215], [48, 262475], [54, 262715], [56, 263255], [58, 263355], [68, 264015], [73, 264575], [76, 264655], [85, 265135], [88, 265295], [96, 265675]]}, {"verse": 28, "start": 266954, "end": 275166, "text": "Miré, y no había ninguno; y pregunté de estas cosas, y ningún consejero hubo: les pregunté, y no respondieron palabra.", "words": [[0, 266954], [6, 267330], [8, 267630], [11, 267770], [17, 267950], [26, 269210], [28, 269315], [37, 269855], [40, 269975], [46, 270135], [53, 270615], [55, 270955], [62, 271295], [72, 271955], [78, 272892], [82, 273016], [92, 273676], [94, 273836], [97, 273956], [110, 274556]]}, {"verse": 29, "start": 275900, "end": 282542, "text": "He aquí, todos iniquidad, y las obras de ellos nada: viento y vanidad son sus vaciadizos.", "words": [[0, 275900], [3, 276037], [9, 276297], [15, 276557], [26, 277277], [28, 277737], [32, 277897], [38, 278177], [41, 278437], [47, 278657], [53, 279778], [60, 280222], [62, 280382], [70, 280882], [74, 281302], [78, 281922]]}]}