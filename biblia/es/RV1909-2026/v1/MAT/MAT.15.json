{"book": "MAT", "chapter": 15, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 305600, "verses": [{"verse": 1, "start": 300, "end": 5834, "text": "Entonces llegaron a Jesús ciertos escribas y fariseos de Jerusalén, diciendo:", "words": [[0, 300], [9, 710], [18, 1230], [20, 1330], [26, 1630], [34, 2410], [43, 2990], [45, 3130], [54, 3790], [57, 3890], [68, 5090]]}, {"verse": 2, "start": 6084, "end": 12216, "text": "¿Por qué tus discípulos quebrantan la tradición de los ancianos? porque no se lavan las manos cuando comen pan.", "words": [[0, 6084], [5, 6219], [9, 6359], [13, 6539], [24, 7099], [35, 7699], [38, 7799], [48, 8259], [51, 8379], [55, 8479], [65, 9529], [72, 9706], [75, 9886], [78, 10066], [84, 10246], [88, 10446], [94, 10766], [101, 11086], [107, 11406]]}, {"verse": 3, "start": 12566, "end": 20352, "text": "Y él respondiendo, les dijo: ¿Por qué también vosotros quebrantáis el mandamiento de Dios por vuestra tradición?", "words": [[0, 12566], [2, 12759], [5, 12979], [19, 14099], [23, 14299], [29, 15125], [34, 15247], [38, 15407], [46, 15787], [55, 16367], [67, 16947], [70, 17407], [82, 18147], [85, 18387], [90, 18647], [94, 19007], [102, 19427]]}, {"verse": 4, "start": 20802, "end": 30842, "text": "Porque Dios mandó, diciendo: Honra al padre y a la madre; y: El que maldiga al padre o a la madre, sea condenado a muerte.", "words": [[0, 20802], [7, 20984], [12, 21224], [19, 21684], [29, 22768], [35, 23316], [38, 23576], [44, 24016], [46, 24396], [48, 24476], [51, 24576], [58, 25482], [61, 26156], [64, 26296], [68, 26456], [76, 27016], [79, 27196], [85, 27636], [87, 27996], [89, 28116], [92, 28216], [99, 28996], [103, 29316], [113, 30036], [115, 30156]]}, {"verse": 5, "start": 31292, "end": 40235, "text": "Pero vosotros decís: Cualquiera que diga a su padre o a su madre: Es mi ofrenda a Dios todo aquello con que pudiera ayudarte;", "words": [[0, 31292], [5, 31439], [14, 31879], [21, 32972], [32, 33436], [36, 33616], [41, 33956], [43, 34016], [46, 34136], [52, 34536], [54, 34936], [56, 35036], [59, 35156], [66, 36074], [69, 36238], [72, 36418], [80, 36998], [82, 37158], [87, 37358], [92, 37738], [100, 38298], [104, 38538], [108, 38718], [116, 39278]]}, {"verse": 6, "start": 40685, "end": 50009, "text": "No deberá honrar a su padre o a su madre con socorro. Así habéis invalidado el mandamiento de Dios por vuestra tradición.", "words": [[0, 40685], [3, 40951], [10, 41511], [17, 42111], [19, 42271], [22, 42431], [28, 42891], [30, 43191], [32, 43311], [35, 43471], [41, 43811], [45, 44051], [54, 45167], [58, 45586], [65, 45986], [76, 46686], [79, 46826], [91, 47486], [94, 47706], [99, 47966], [103, 48586], [111, 49086]]}, {"verse": 7, "start": 50459, "end": 54505, "text": "Hipócritas, bien profetizó de vosotros Isaías, diciendo:", "words": [[0, 50459], [12, 51320], [17, 51580], [27, 52460], [30, 52560], [39, 53020], [47, 53700]]}, {"verse": 8, "start": 54955, "end": 59156, "text": "Este pueblo de labios me honra; pero su corazón lejos está de mí.", "words": [[0, 54955], [5, 55144], [12, 55464], [15, 55684], [22, 56004], [25, 56431], [32, 57106], [37, 57230], [40, 57410], [48, 57850], [54, 58410], [59, 58710], [62, 58890]]}, {"verse": 9, "start": 59607, "end": 64811, "text": "Pero en vano me honran, enseñando doctrinas y mandamientos de hombres.", "words": [[0, 59607], [5, 59930], [8, 60110], [13, 60630], [16, 60990], [24, 61350], [34, 62450], [44, 63170], [46, 63270], [59, 63970], [62, 64170]]}, {"verse": 10, "start": 65261, "end": 69436, "text": "Y llamando a sí a la multitud, les dijo: Oíd, y entended:", "words": [[0, 65261], [2, 65368], [11, 65595], [13, 65821], [16, 66048], [18, 66188], [21, 66268], [31, 66948], [35, 67048], [41, 67865], [46, 68293], [48, 68890]]}, {"verse": 11, "start": 69886, "end": 76652, "text": "No lo que entra en la boca contamina al hombre; sino lo que sale de la boca, esto contamina al hombre.", "words": [[0, 69886], [3, 70033], [6, 70153], [10, 70313], [16, 70533], [19, 70713], [22, 70833], [27, 71113], [37, 71873], [40, 72013], [48, 72859], [53, 73084], [56, 73284], [60, 73424], [65, 73744], [68, 73944], [71, 74084], [77, 74544], [82, 74704], [92, 75424], [95, 75564]]}, {"verse": 12, "start": 77102, "end": 84371, "text": "Entonces acercándose sus discípulos, le dijeron: ¿Sabes que los fariseos oyendo esta palabra se ofendieron?", "words": [[0, 77102], [9, 77663], [21, 78843], [25, 79123], [37, 79863], [40, 80323], [49, 81233], [56, 81591], [60, 81691], [64, 81811], [73, 82411], [80, 82811], [85, 83011], [93, 83431], [96, 83631]]}, {"verse": 13, "start": 84721, "end": 91699, "text": "Pero respondiendo él, dijo: Toda planta que no plantó mi Padre celestial, será desarraigada.", "words": [[0, 84721], [5, 84888], [18, 85748], [22, 85948], [28, 86728], [33, 87011], [40, 87451], [44, 87551], [47, 87691], [54, 88111], [57, 88251], [63, 88611], [74, 89371], [79, 90191]]}, {"verse": 14, "start": 92149, "end": 100374, "text": "Dejadlos: son ciegos guías de ciegos; y si el ciego guía al ciego, ambos caerán en el hoyo.", "words": [[0, 92149], [10, 93370], [14, 93576], [21, 94156], [27, 94756], [30, 94916], [38, 95894], [40, 96020], [43, 96180], [46, 96380], [52, 96920], [57, 97340], [60, 97560], [67, 98280], [73, 98840], [80, 99560], [83, 99680], [86, 99840]]}, {"verse": 15, "start": 100824, "end": 105358, "text": "Y respondiendo Pedro, le dijo: Decláranos esta parábola.", "words": [[0, 100824], [2, 100945], [15, 101765], [22, 102685], [25, 102945], [31, 104162], [42, 104512], [47, 104772]]}, {"verse": 16, "start": 105708, "end": 110174, "text": "Y Jesús dijo: ¿Aun también vosotros sois sin entendimiento?", "words": [[0, 105708], [2, 105894], [8, 106154], [14, 107159], [19, 107387], [27, 107807], [36, 108247], [41, 108687], [45, 109007]]}, {"verse": 17, "start": 110624, "end": 116903, "text": "¿No entendéis aún, que todo lo que entra en la boca, va al vientre, y es echado en la letrina?", "words": [[0, 110624], [4, 110770], [14, 111063], [19, 111357], [23, 111650], [28, 112190], [31, 112470], [35, 112700], [41, 112930], [44, 113170], [47, 113310], [53, 113550], [56, 113870], [59, 114050], [68, 114750], [70, 114970], [73, 115170], [80, 115750], [83, 116050], [86, 116190]]}, {"verse": 18, "start": 117353, "end": 123305, "text": "Pero lo que sale de la boca, del corazón sale; y esto contamina al hombre.", "words": [[0, 117353], [5, 117478], [8, 117638], [12, 117798], [17, 118058], [20, 118238], [23, 118378], [29, 118718], [33, 119558], [41, 120018], [47, 121097], [49, 121390], [54, 121670], [64, 122450], [67, 122710]]}, {"verse": 19, "start": 123755, "end": 133865, "text": "Porque del corazón salen los malos pensamientos, homicidios, adulterios, fornicaciones, hurtos, falsos testimonios, blasfemias.", "words": [[0, 123755], [7, 123957], [11, 124137], [19, 124617], [25, 125437], [29, 125717], [35, 126137], [49, 127377], [61, 128557], [73, 129597], [88, 130637], [96, 131337], [103, 131797], [116, 132597]]}, {"verse": 20, "start": 134315, "end": 141533, "text": "Estas cosas son las que contaminan al hombre: que comer con las manos sin lavar no contamina al hombre.", "words": [[0, 134315], [6, 134600], [12, 134880], [16, 135500], [20, 135680], [24, 135820], [35, 136500], [38, 136760], [46, 137619], [50, 137702], [56, 137982], [60, 138182], [64, 138382], [70, 138762], [74, 139322], [80, 139702], [83, 139902], [93, 140602], [96, 140842]]}, {"verse": 21, "start": 141983, "end": 146086, "text": "Y saliendo Jesús de allí, se fue a las partes de Tiro y de Sidón.", "words": [[0, 141983], [2, 142090], [11, 142550], [17, 142910], [20, 143170], [26, 143730], [29, 143810], [33, 143990], [35, 144130], [39, 144230], [46, 144610], [49, 144790], [54, 145210], [56, 145310], [59, 145450]]}, {"verse": 22, "start": 146536, "end": 159947, "text": "Y he aquí una mujer cananea, que había salido de aquellos términos, clamaba, diciéndole: Señor, Hijo de David, ten misericordia de mí; mi hija es cruelmente atormentada por un demonio.", "words": [[0, 146536], [2, 146714], [5, 146854], [10, 147154], [14, 147394], [20, 147814], [29, 148694], [33, 149114], [39, 149314], [46, 149834], [49, 149974], [58, 150214], [68, 151174], [77, 152314], [89, 153531], [96, 153927], [101, 154467], [104, 154607], [111, 155027], [115, 155447], [128, 156207], [131, 156327], [135, 156979], [138, 157122], [143, 157402], [146, 157562], [157, 158242], [169, 158922], [173, 159142], [176, 159282]]}, {"verse": 23, "start": 160297, "end": 171553, "text": "Pero él no le respondió palabra. Entonces acercándose sus discípulos, le rogaron, diciendo: Despídela, pues da voces tras nosotros.", "words": [[0, 160297], [5, 160439], [8, 160799], [11, 161179], [14, 161359], [24, 161959], [33, 162969], [42, 163652], [54, 165052], [58, 165412], [70, 166392], [73, 166912], [82, 167752], [92, 169175], [103, 169505], [108, 170145], [111, 170225], [117, 170625], [122, 170765]]}, {"verse": 24, "start": 171903, "end": 178192, "text": "Y él respondiendo, dijo: No soy enviado sino a las ovejas perdidas de la casa de Israel.", "words": [[0, 171903], [2, 172069], [5, 172209], [19, 172929], [25, 173826], [28, 173992], [32, 174312], [40, 174872], [45, 175112], [47, 175292], [51, 175412], [58, 175912], [67, 176592], [70, 176752], [73, 176832], [78, 177112], [81, 177372]]}, {"verse": 25, "start": 178642, "end": 186698, "text": "Entonces ella vino, y le adoró, diciendo: Señor, socórreme.", "words": [[0, 178642], [9, 179210], [14, 179630], [20, 180070], [22, 180670], [25, 180810], [32, 181530], [42, 182752], [49, 183552]]}, {"verse": 26, "start": 187048, "end": 193115, "text": "Y respondiendo él, dijo: No es bien tomar el pan de los hijos, y echarlo a los perrillos.", "words": [[0, 187048], [2, 187170], [15, 187970], [19, 188150], [25, 189012], [28, 189193], [31, 189393], [36, 189553], [42, 189973], [45, 190233], [49, 190453], [52, 190613], [56, 190773], [63, 191113], [65, 191493], [73, 192053], [75, 192133], [79, 192655]]}, {"verse": 27, "start": 193565, "end": 200446, "text": "Y ella dijo: Sí, Señor; pero los perrillos comen de las migajas que caen de la mesa de sus señores.", "words": [[0, 193565], [2, 193903], [7, 194063], [13, 194881], [17, 195367], [24, 196212], [29, 196359], [33, 196539], [43, 196999], [49, 197339], [52, 197559], [56, 197679], [64, 198299], [68, 198479], [73, 198859], [76, 198959], [79, 199079], [84, 199359], [87, 199539], [91, 199679]]}, {"verse": 28, "start": 200796, "end": 210812, "text": "Entonces respondiendo Jesús, dijo: Oh mujer, grande es tu fe; sea hecho contigo como quieres. Y fue sana su hija desde aquella hora.", "words": [[0, 200796], [9, 201839], [22, 202579], [29, 202919], [35, 204082], [38, 204172], [45, 204552], [52, 204868], [55, 205183], [58, 205499], [62, 206226], [66, 206446], [72, 206626], [80, 207186], [85, 207426], [94, 208488], [96, 208596], [100, 208756], [105, 209196], [108, 209316], [113, 209636], [119, 209796], [127, 210256]]}, {"verse": 29, "start": 211262, "end": 218267, "text": "Y partido Jesús de allí, vino junto al mar de Galilea: y subiendo al monte, se sentó allí.", "words": [[0, 211262], [2, 211520], [10, 211820], [16, 212120], [19, 212320], [25, 212600], [30, 213440], [36, 213740], [39, 214020], [43, 214240], [46, 214440], [55, 215519], [57, 215663], [66, 216123], [69, 216283], [76, 216683], [79, 217383], [85, 217843]]}, {"verse": 30, "start": 218717, "end": 229701, "text": "Y se le acercó mucha gente que traía consigo cojos, ciegos, mudos, mancos, y otros muchos enfermos: y los pusieron a los pies de Jesús, y los sanó:", "words": [[0, 218717], [2, 218987], [5, 219107], [8, 219247], [15, 219787], [21, 220247], [27, 220627], [31, 220827], [37, 221207], [45, 221547], [52, 222527], [60, 223327], [67, 223867], [75, 224307], [77, 224827], [83, 225067], [90, 225427], [100, 226597], [102, 226705], [106, 226805], [115, 227265], [117, 227405], [121, 227525], [126, 227685], [129, 227845], [136, 228165], [138, 228965], [142, 229085]]}, {"verse": 31, "start": 230151, "end": 240634, "text": "De manera que la multitud se maravillaba, viendo hablar los mudos, los mancos sanos, andar los cojos, y ver los ciegos: y glorificaron al Dios de Israel.", "words": [[0, 230151], [3, 230292], [10, 230512], [14, 230772], [17, 230912], [26, 231472], [29, 231692], [42, 232392], [49, 232652], [56, 232972], [60, 233232], [67, 234112], [71, 234172], [78, 234672], [85, 235572], [91, 235792], [95, 236052], [102, 236532], [104, 236872], [108, 237052], [112, 237272], [120, 238373], [122, 238558], [135, 239358], [138, 239538], [143, 239838], [146, 239958]]}, {"verse": 32, "start": 241084, "end": 255956, "text": "Y Jesús llamando a sus discípulos, dijo: Tengo compasión de la gente, que ya hace tres días que perseveran conmigo, y no tienen qué comer; y enviarlos en ayunas no quiero, porque no desmayen en el camino.", "words": [[0, 241084], [2, 241227], [8, 242007], [17, 242567], [19, 242667], [23, 242847], [35, 243907], [41, 244709], [47, 244988], [57, 245688], [60, 245848], [63, 245968], [70, 246408], [74, 246948], [77, 247188], [82, 247448], [87, 247808], [92, 248228], [96, 248408], [107, 249068], [116, 249728], [118, 250068], [121, 250188], [128, 250428], [132, 250648], [139, 251479], [141, 251583], [151, 252183], [154, 252463], [161, 252963], [164, 253283], [172, 253923], [179, 254283], [182, 254503], [191, 255083], [194, 255203], [197, 255323]]}, {"verse": 33, "start": 256406, "end": 264808, "text": "Entonces sus discípulos le dicen: ¿Dónde tenemos nosotros tantos panes en el desierto, para alimentar a tanta gente?", "words": [[0, 256406], [9, 257112], [13, 257892], [24, 258892], [27, 259172], [34, 260034], [41, 260255], [49, 260715], [58, 261035], [65, 261715], [71, 262095], [74, 262195], [77, 262315], [87, 262815], [92, 263375], [102, 263895], [104, 263955], [110, 264115]]}, {"verse": 34, "start": 265158, "end": 272401, "text": "Y Jesús les dice: ¿Cuántos panes tenéis? Y ellos dijeron: Siete, y unos pocos pececillos.", "words": [[0, 265158], [2, 265302], [8, 265702], [12, 266082], [18, 266954], [27, 267358], [33, 267878], [41, 268861], [43, 269045], [49, 269225], [58, 270411], [65, 270561], [67, 270901], [72, 271101], [78, 271781]]}, {"verse": 35, "start": 272751, "end": 275959, "text": "Y mandó a la multitud que se recostase en tierra.", "words": [[0, 272751], [2, 272855], [8, 273195], [10, 273295], [13, 273375], [22, 273995], [26, 274135], [29, 274295], [39, 274995], [42, 275215]]}, {"verse": 36, "start": 276409, "end": 284989, "text": "Y tomando los siete panes y los peces, haciendo gracias, partió y dio a sus discípulos; y los discípulos a la gente.", "words": [[0, 276409], [2, 276747], [10, 277307], [14, 277647], [20, 277947], [26, 278567], [28, 278667], [32, 278767], [39, 279447], [48, 279767], [57, 280567], [64, 281087], [66, 281327], [70, 281567], [72, 281707], [76, 281867], [88, 283059], [90, 283161], [94, 283301], [105, 283981], [107, 284281], [110, 284341]]}, {"verse": 37, "start": 285439, "end": 292418, "text": "Y comieron todos, y se saciaron: y alzaron lo que sobró de los pedazos, siete canastas llenas.", "words": [[0, 285439], [2, 285561], [11, 286001], [18, 286401], [20, 286781], [23, 286901], [33, 288165], [35, 288266], [43, 288826], [46, 288986], [50, 289126], [56, 289566], [59, 289626], [63, 289766], [72, 290316], [78, 290866], [87, 291646]]}, {"verse": 38, "start": 292868, "end": 298381, "text": "Y eran los que habían comido, cuatro mil hombres, sin las mujeres y los niños.", "words": [[0, 292868], [2, 293034], [7, 293234], [11, 293454], [15, 293614], [22, 293874], [30, 294514], [37, 295154], [41, 295794], [50, 296154], [54, 296674], [58, 296894], [66, 297294], [68, 297534], [72, 297674]]}, {"verse": 39, "start": 298831, "end": 305200, "text": "Entonces, despedida la gente, subió en el barco: y vino a los términos de Magdala.", "words": [[0, 298831], [10, 299488], [20, 300628], [23, 300748], [30, 301208], [36, 301708], [39, 301848], [42, 301968], [49, 302920], [51, 303200], [56, 303440], [58, 303580], [62, 303720], [71, 304300], [74, 304770]]}]}