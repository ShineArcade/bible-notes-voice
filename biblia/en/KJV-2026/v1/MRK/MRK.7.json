{"book": "MRK", "chapter": 7, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 269030, "verses": [{"verse": 1, "start": 300, "end": 6239, "text": "Then came together to him the Pharisees, and certain of the scribes, which came from Jerusalem.", "words": [[0, 300], [5, 518], [10, 778], [19, 1238], [22, 1438], [26, 1658], [30, 1838], [41, 3058], [45, 3138], [53, 3518], [56, 3698], [60, 3838], [69, 4518], [75, 4918], [80, 5198], [85, 5418]]}, {"verse": 2, "start": 6689, "end": 14439, "text": "And when they saw some of his disciples eat bread with defiled, that is to say, with unwashed, hands, they found fault.", "words": [[0, 6689], [4, 6804], [9, 6964], [14, 7144], [18, 7404], [23, 7664], [26, 7864], [30, 8004], [40, 8504], [44, 8784], [50, 9084], [55, 9324], [64, 10444], [69, 10524], [72, 10684], [75, 10844], [80, 11484], [85, 11584], [95, 12404], [102, 12984], [107, 13544], [113, 13864]]}, {"verse": 3, "start": 14889, "end": 21815, "text": "For the Pharisees, and all the Jews, unless they wash their hands often, eat not, holding the tradition of the elders.", "words": [[0, 14889], [4, 15005], [8, 15085], [19, 15885], [23, 15985], [27, 16165], [31, 16305], [37, 16665], [44, 17125], [49, 17405], [54, 17685], [60, 17945], [66, 18245], [73, 19105], [77, 19245], [82, 19805], [90, 20105], [94, 20345], [104, 20745], [107, 20945], [111, 21065]]}, {"verse": 4, "start": 22265, "end": 34965, "text": "And when they come from the market, unless they wash, they eat not. And many other things there are, which they have received to hold, as the washing of cups, and pots, brasen vessels, and of tables.", "words": [[0, 22265], [4, 22562], [9, 22702], [14, 22882], [19, 23102], [24, 23302], [28, 23442], [36, 24082], [43, 24422], [48, 24722], [54, 25462], [59, 25542], [63, 25782], [68, 26623], [72, 26799], [77, 26999], [83, 27259], [90, 27579], [96, 27839], [101, 28599], [107, 28779], [112, 28979], [117, 29139], [126, 29519], [129, 29759], [135, 30139], [138, 30579], [142, 30719], [150, 31019], [153, 31219], [159, 31559], [163, 32159], [169, 32749], [176, 33339], [185, 34079], [189, 34159], [192, 34259]]}, {"verse": 5, "start": 35415, "end": 43668, "text": "Then the Pharisees and scribes asked him, Why walk not your disciples according to the tradition of the elders, but eat bread with unwashed hands?", "words": [[0, 35415], [5, 35605], [9, 35765], [19, 36405], [23, 36525], [31, 37085], [37, 37325], [42, 38030], [46, 38268], [51, 38508], [55, 38688], [60, 38908], [70, 39408], [80, 39768], [83, 40028], [87, 40148], [97, 40528], [100, 40708], [104, 40828], [112, 41588], [116, 41728], [120, 41888], [126, 42248], [131, 42468], [140, 43048]]}, {"verse": 6, "start": 44018, "end": 53543, "text": "He answered and said to them, Well has Esaias prophesied of you hypocrites, as it is written, This people honours me with their lips, but their heart is far from me.", "words": [[0, 44018], [3, 44110], [12, 44490], [16, 44730], [21, 44970], [24, 45170], [30, 45758], [35, 46124], [39, 46498], [46, 46871], [57, 47591], [60, 47711], [64, 47871], [76, 48671], [79, 48811], [82, 48931], [85, 49071], [94, 49791], [99, 49951], [106, 50281], [114, 50611], [117, 50891], [122, 51111], [128, 51231], [134, 51911], [138, 52051], [144, 52211], [150, 52511], [153, 52711], [157, 52991], [162, 53231]]}, {"verse": 7, "start": 53993, "end": 58976, "text": "However in vain do they worship me, teaching for doctrines the commandments of men.", "words": [[0, 53993], [8, 54358], [11, 54618], [16, 54878], [19, 55118], [24, 55278], [32, 55598], [36, 56358], [45, 56658], [49, 56938], [59, 57538], [63, 57658], [76, 58098], [79, 58478]]}, {"verse": 8, "start": 59426, "end": 67991, "text": "For laying aside the commandment of God, you hold the tradition of men, as the washing of pots and cups: and many other such like things you do.", "words": [[0, 59426], [4, 59507], [11, 59827], [17, 60147], [21, 60427], [33, 60967], [36, 61107], [41, 61807], [45, 61927], [50, 62207], [54, 62387], [64, 62767], [67, 62967], [72, 63307], [75, 63667], [79, 63807], [87, 64147], [90, 64387], [95, 64747], [99, 64967], [105, 65827], [109, 65971], [114, 66231], [120, 66471], [125, 66751], [130, 67051], [137, 67371], [141, 67591]]}, {"verse": 9, "start": 68341, "end": 74267, "text": "And he said to them, Full well you reject the commandment of God, that you may keep your own tradition.", "words": [[0, 68341], [4, 68471], [7, 68591], [12, 68831], [15, 69031], [21, 69627], [26, 69825], [31, 70165], [35, 70425], [42, 70825], [46, 71025], [58, 71545], [61, 71725], [66, 72045], [71, 72625], [75, 72805], [79, 72965], [84, 73225], [89, 73445], [93, 73605]]}, {"verse": 10, "start": 74717, "end": 81549, "text": "For Moses said, Honour your father and your mother; and, Whoever curses father or mother, let him die the death:", "words": [[0, 74717], [4, 74829], [10, 75089], [16, 75449], [23, 75809], [28, 76049], [35, 76389], [39, 76689], [44, 76829], [52, 77557], [57, 77658], [65, 77938], [72, 78558], [79, 78918], [82, 79198], [90, 79838], [94, 80218], [98, 80438], [102, 80778], [106, 80998]]}, {"verse": 11, "start": 81999, "end": 91376, "text": "But you say, If a man shall say to his father or mother, It is Corban, that is to say, a gift, by whatever you might be profited by me; he shall be free.", "words": [[0, 81999], [4, 82101], [8, 82261], [13, 82561], [16, 82841], [18, 82941], [22, 83201], [28, 83441], [32, 83681], [35, 83801], [39, 83941], [46, 84261], [49, 84481], [57, 85341], [60, 85441], [63, 85961], [71, 86481], [76, 86621], [79, 86761], [82, 86901], [87, 87321], [89, 87441], [95, 87761], [98, 88301], [107, 88561], [111, 88801], [117, 88961], [120, 89101], [129, 89501], [132, 89741], [136, 90467], [139, 90553], [145, 90753], [148, 90933]]}, {"verse": 12, "start": 91826, "end": 95375, "text": "And you no longer let him do anything for his father or his mother;", "words": [[0, 91826], [4, 91952], [8, 92072], [11, 92252], [18, 92632], [22, 92852], [26, 93012], [29, 93192], [38, 93672], [42, 93972], [46, 94132], [53, 94492], [56, 94772], [60, 94952]]}, {"verse": 13, "start": 95825, "end": 102369, "text": "Making the word of God of none effect through your tradition, which you have delivered: and many such like things do you.", "words": [[0, 95825], [7, 96067], [11, 96287], [16, 96487], [19, 96627], [23, 96867], [26, 97007], [31, 97347], [38, 97687], [46, 98067], [51, 98247], [62, 99087], [68, 99267], [72, 99447], [77, 99607], [88, 100459], [92, 100583], [97, 100823], [102, 101063], [107, 101323], [114, 101683], [117, 101963]]}, {"verse": 14, "start": 102719, "end": 109026, "text": "¶ And when he had called all the people to him, he said to them, Hearken to me every one of you, and understand:", "words": [[2, 102719], [6, 102840], [11, 103000], [14, 103180], [18, 103300], [25, 103560], [29, 103940], [33, 104080], [40, 104320], [43, 104540], [48, 105080], [51, 105220], [56, 105420], [59, 105600], [65, 106381], [73, 106571], [76, 106731], [79, 106871], [85, 107191], [89, 107431], [92, 107551], [97, 107771], [101, 108071]]}, {"verse": 15, "start": 109476, "end": 117943, "text": "There is nothing from without a man, that entering into him can defile him: but the things which come out of him, those are they that defile the man.", "words": [[0, 109476], [6, 109593], [9, 109733], [17, 110073], [22, 110333], [30, 110613], [32, 110753], [37, 111093], [42, 111493], [51, 111893], [56, 112213], [60, 112453], [64, 112693], [71, 113173], [76, 113855], [80, 113959], [84, 114099], [91, 114419], [97, 114659], [102, 114859], [106, 115099], [109, 115259], [114, 115899], [120, 116279], [124, 116499], [129, 116679], [134, 116859], [141, 117339], [145, 117499]]}, {"verse": 16, "start": 118393, "end": 121242, "text": "If any man have ears to hear, let him hear.", "words": [[0, 118393], [3, 118551], [7, 118771], [11, 119031], [16, 119271], [21, 119531], [24, 119751], [30, 120351], [34, 120591], [38, 120791]]}, {"verse": 17, "start": 121592, "end": 127136, "text": "And when he was entered into the house from the people, his disciples asked him concerning the parable.", "words": [[0, 121592], [4, 121725], [9, 121885], [12, 122045], [16, 122225], [24, 122545], [29, 122805], [33, 122985], [39, 123245], [44, 123525], [48, 123645], [56, 124565], [60, 124665], [70, 125165], [76, 125625], [80, 125825], [91, 126345], [95, 126605]]}, {"verse": 18, "start": 127586, "end": 135597, "text": "And he says to them, Are you so without understanding also Do you not perceive that whatever thing from without enters into the man it can not defile him", "words": [[0, 127586], [4, 127730], [7, 127810], [12, 128030], [15, 128270], [21, 128943], [25, 129049], [29, 129229], [32, 129449], [40, 129729], [54, 130529], [59, 130989], [62, 131109], [66, 131249], [70, 131369], [79, 131729], [84, 132009], [93, 132209], [99, 132569], [104, 132829], [112, 133109], [119, 133429], [124, 133649], [128, 133769], [132, 134329], [135, 134456], [139, 134582], [143, 134709], [150, 135229]]}, {"verse": 19, "start": 136047, "end": 142450, "text": "Because it enters not into his heart, but into the belly, and goes out into the draught, purging all foods?", "words": [[0, 136047], [8, 136309], [11, 136529], [18, 136869], [22, 137189], [27, 137489], [31, 137649], [38, 138269], [42, 138509], [47, 138729], [51, 138869], [58, 139189], [62, 139669], [67, 139909], [71, 140149], [76, 140349], [80, 140769], [89, 141189], [97, 141649], [101, 141829]]}, {"verse": 20, "start": 142800, "end": 147662, "text": "And he said, That which comes out of the man, that defiles the man.", "words": [[0, 142800], [4, 142935], [7, 143075], [13, 144533], [18, 144714], [24, 144894], [30, 145194], [34, 145454], [37, 145554], [41, 145674], [46, 146314], [51, 146434], [59, 147014], [63, 147234]]}, {"verse": 21, "start": 148112, "end": 153840, "text": "For from within, out of the heart of men, proceed evil thoughts, adulteries, fornications, murders,", "words": [[0, 148112], [4, 148216], [9, 148436], [17, 148776], [21, 149076], [24, 149196], [28, 149296], [34, 149516], [37, 149636], [42, 149956], [50, 150516], [55, 150976], [65, 151676], [77, 152396], [91, 153276]]}, {"verse": 22, "start": 154290, "end": 161637, "text": "Thefts, covetousness, wickedness, deceit, lasciviousness, an evil eye, blasphemy, pride, foolishness:", "words": [[0, 154314], [8, 154614], [22, 155474], [34, 156374], [42, 157194], [58, 157814], [61, 158434], [66, 158714], [71, 159414], [82, 160194], [89, 160914]]}, {"verse": 23, "start": 162087, "end": 165573, "text": "All these evil things come from within, and defile the man.", "words": [[0, 162087], [4, 162268], [10, 162488], [15, 162848], [22, 163248], [27, 163568], [32, 163808], [40, 164168], [44, 164548], [51, 165028], [55, 165148]]}, {"verse": 24, "start": 165923, "end": 175414, "text": "¶ And from there he arose, and went into the borders of Tyre and Sidon, and entered into a house, and would have no man know it: but he could not be hid.", "words": [[2, 165923], [6, 166053], [11, 166233], [17, 166553], [20, 166813], [27, 167513], [31, 167833], [36, 168053], [41, 168333], [45, 168493], [53, 168813], [56, 169053], [61, 169553], [65, 169693], [72, 170693], [76, 170833], [84, 171153], [89, 171453], [91, 171633], [98, 172313], [102, 172433], [108, 172573], [113, 172733], [116, 172973], [120, 173233], [125, 173513], [129, 174106], [133, 174215], [136, 174335], [142, 174535], [146, 174775], [149, 174995]]}, {"verse": 25, "start": 175864, "end": 181903, "text": "For a certain woman, whose young daughter had an unclean spirit, heard of him, and came and fell at his feet:", "words": [[0, 175864], [4, 175995], [6, 176135], [14, 176355], [21, 176695], [27, 177015], [33, 177315], [42, 177635], [46, 177875], [49, 177995], [57, 178555], [65, 179295], [71, 179535], [74, 179715], [79, 180115], [83, 180195], [88, 180475], [92, 180675], [97, 180935], [100, 181095], [104, 181235]]}, {"verse": 26, "start": 182353, "end": 189592, "text": "The woman was a Greek, a Syrophenician by nation; and she besought him that he would cast the demon out of her daughter.", "words": [[0, 182353], [4, 182693], [10, 182953], [14, 183273], [16, 183393], [23, 184073], [25, 184443], [39, 184813], [42, 185093], [50, 185969], [54, 186094], [58, 186254], [67, 186754], [71, 187014], [76, 187254], [79, 187374], [85, 187514], [90, 187874], [94, 188114], [100, 188414], [104, 188754], [107, 188894], [111, 189014]]}, {"verse": 27, "start": 190042, "end": 198672, "text": "But Jesus said to her, Let the children first be filled: for it is not meet to take the children’s bread, and to cast it to the dogs.", "words": [[0, 190042], [4, 190152], [10, 190452], [15, 190832], [18, 191032], [23, 192203], [27, 192400], [31, 192580], [40, 193000], [46, 193360], [49, 193620], [57, 194486], [61, 194615], [64, 194735], [67, 194855], [71, 195105], [76, 195355], [79, 195595], [84, 195795], [88, 195935], [99, 196435], [106, 196735], [110, 197175], [113, 197315], [118, 197615], [121, 197775], [124, 197915], [128, 198035]]}, {"verse": 28, "start": 199022, "end": 205735, "text": "And she answered and said to him, Yes, Lord: yet the dogs under the table eat of the children’s crumbs.", "words": [[0, 199022], [4, 199145], [8, 199305], [17, 199705], [21, 199885], [26, 200105], [29, 200305], [34, 200934], [39, 201364], [45, 202156], [49, 202303], [53, 202503], [58, 202843], [64, 203183], [68, 203363], [74, 203743], [78, 204103], [81, 204343], [85, 204483], [96, 205083]]}, {"verse": 29, "start": 206085, "end": 211194, "text": "And he said to her, For this saying go your way; the demon has gone out of your daughter.", "words": [[0, 206085], [4, 206216], [7, 206356], [12, 206616], [15, 206876], [20, 207471], [24, 207560], [29, 207780], [36, 208340], [39, 208460], [44, 208660], [49, 209402], [53, 209479], [59, 209739], [63, 209979], [68, 210219], [72, 210439], [75, 210559], [80, 210659]]}, {"verse": 30, "start": 211544, "end": 217284, "text": "And when she was come to her house, she found the demon gone out, and her daughter laid upon the bed.", "words": [[0, 211544], [4, 211679], [9, 211839], [13, 212019], [17, 212219], [22, 212439], [25, 212619], [29, 212759], [36, 213599], [40, 213759], [46, 214059], [50, 214219], [56, 214519], [61, 214839], [66, 215179], [70, 215619], [74, 215759], [83, 216079], [88, 216359], [93, 216639], [97, 216859]]}, {"verse": 31, "start": 217734, "end": 225103, "text": "¶ And again, departing from the coasts of Tyre and Sidon, he came to the sea of Galilee, through the midst of the coasts of Decapolis.", "words": [[2, 217734], [6, 217882], [13, 218342], [23, 218742], [28, 218902], [32, 219062], [39, 219502], [42, 219562], [47, 220002], [51, 220142], [58, 221062], [61, 221162], [66, 221402], [69, 221602], [73, 221702], [77, 221942], [80, 222082], [89, 222622], [97, 222862], [101, 223022], [107, 223262], [110, 223542], [114, 223642], [121, 224122], [124, 224182]]}, {"verse": 32, "start": 225553, "end": 233058, "text": "And they bring to him one that was deaf, and had an impediment in his speech; and they beseech him to put his hand upon him.", "words": [[0, 225553], [4, 225699], [9, 225799], [15, 226079], [18, 226279], [22, 226459], [26, 226719], [31, 226939], [35, 227099], [41, 227459], [45, 228259], [49, 228459], [52, 228599], [63, 229219], [66, 229479], [70, 229639], [78, 230601], [82, 230785], [87, 230905], [95, 231385], [99, 231505], [102, 231645], [106, 231825], [110, 232005], [115, 232285], [120, 232545]]}, {"verse": 33, "start": 233508, "end": 240117, "text": "And he took him aside from the multitude, and put his fingers into his ears, and he spit, and touched his tongue;", "words": [[0, 233508], [4, 233630], [7, 233710], [12, 233870], [16, 234010], [22, 234370], [27, 234590], [31, 234730], [42, 235230], [46, 235770], [50, 235930], [54, 236090], [62, 236450], [67, 236710], [71, 236930], [77, 237550], [81, 237870], [84, 238010], [90, 238290], [94, 238850], [102, 239150], [106, 239410]]}, {"verse": 34, "start": 240567, "end": 246479, "text": "And looking up to heaven, he sighed, and says to him, Ephphatha, that is, Be opened.", "words": [[0, 240567], [4, 240692], [12, 240892], [15, 241152], [18, 241312], [26, 241592], [29, 241812], [37, 242412], [41, 242612], [46, 242832], [49, 243052], [54, 244342], [65, 245452], [70, 245588], [74, 245708], [77, 245868]]}, {"verse": 35, "start": 246929, "end": 252353, "text": "And immediately his ears were opened, and the string of his tongue was loosed, and he spoke plain.", "words": [[0, 246929], [4, 247072], [16, 247432], [20, 247892], [25, 248192], [30, 248452], [38, 248852], [42, 249352], [46, 249472], [53, 249732], [56, 249912], [60, 250032], [67, 250312], [71, 250532], [79, 251012], [83, 251212], [86, 251332], [92, 251632]]}, {"verse": 36, "start": 252803, "end": 259484, "text": "And he charged them that they should tell no man: but the more he charged them, so much the more a great deal they published it;", "words": [[0, 252803], [4, 252945], [7, 253045], [15, 253425], [20, 253705], [25, 253885], [30, 254045], [37, 254225], [42, 254505], [45, 254745], [50, 255615], [54, 255730], [58, 255830], [63, 256050], [66, 256250], [74, 256590], [80, 257250], [83, 257390], [88, 257630], [92, 257790], [97, 258030], [99, 258150], [105, 258350], [110, 258650], [115, 258830], [125, 259150]]}, {"verse": 37, "start": 259934, "end": 268630, "text": "And were beyond measure astonished, saying, He has done all things well: he makes both the deaf to hear, and the dumb to speak.", "words": [[0, 259934], [4, 260099], [9, 260279], [16, 260639], [24, 261059], [36, 261999], [44, 262852], [47, 262992], [51, 263252], [56, 263532], [60, 263872], [67, 264192], [73, 265039], [76, 265132], [82, 265332], [87, 265652], [91, 265872], [96, 266152], [99, 266372], [105, 266712], [109, 267232], [113, 267352], [118, 267572], [121, 267752]]}]}