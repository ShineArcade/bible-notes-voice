{"book": "PSA", "chapter": 35, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 193798, "verses": [{"verse": 1, "start": 300, "end": 7242, "text": "Salmo de David. DISPUTA, oh Jehová, con los que contra mí contienden; pelea con los que me combaten.", "words": [[0, 300], [6, 784], [9, 944], [16, 1649], [25, 2104], [28, 2590], [36, 3077], [40, 3577], [44, 3737], [48, 3897], [55, 4237], [58, 4457], [70, 5628], [76, 6032], [80, 6192], [84, 6352], [88, 6472], [91, 6612]]}, {"verse": 2, "start": 7592, "end": 12198, "text": "Echa mano al escudo y al escudo grande, y levántate en mi ayuda.", "words": [[0, 7592], [5, 7856], [10, 8116], [13, 8276], [20, 8736], [22, 8896], [25, 9016], [32, 9356], [40, 9816], [42, 10262], [52, 11081], [55, 11381], [58, 11561]]}, {"verse": 3, "start": 12548, "end": 19284, "text": "Y saca la lanza, cierra contra mis perseguidores; di a mi alma: Yo soy tu salvación.", "words": [[0, 12548], [2, 12670], [7, 13030], [10, 13150], [17, 13990], [24, 14370], [31, 14750], [35, 15010], [50, 16335], [53, 16599], [55, 16739], [58, 16859], [64, 17632], [67, 17820], [71, 18040], [74, 18280]]}, {"verse": 4, "start": 19634, "end": 28214, "text": "Avergüéncense y confúndanse los que buscan mi alma: vuelvan atrás, y sean avergonzados los que mi mal intentan.", "words": [[0, 19634], [14, 20576], [16, 20716], [28, 21496], [32, 21696], [36, 21856], [43, 22256], [46, 22496], [52, 23282], [60, 23808], [67, 24188], [69, 24788], [74, 25148], [87, 26188], [91, 26688], [95, 26868], [98, 27028], [102, 27288]]}, {"verse": 5, "start": 28564, "end": 33601, "text": "Sean como el tamo delante del viento; y el ángel de Jehová los acose.", "words": [[0, 28564], [5, 28826], [10, 29186], [13, 29366], [18, 29786], [26, 30266], [30, 30526], [38, 31535], [40, 31655], [43, 31775], [49, 32195], [52, 32335], [59, 32795], [63, 32915]]}, {"verse": 6, "start": 33951, "end": 39761, "text": "Sea su camino oscuridad y resbaladeros; y el ángel de Jehová los persiga.", "words": [[0, 33951], [4, 34237], [7, 34517], [14, 34897], [24, 35797], [26, 36532], [40, 37419], [42, 37585], [45, 37725], [51, 38145], [54, 38565], [61, 38986], [65, 39406]]}, {"verse": 7, "start": 40111, "end": 47030, "text": "Porque sin causa escondieron para mí su red en un hoyo; sin causa hicieron hoyo para mi alma.", "words": [[0, 40111], [7, 40335], [11, 40575], [17, 41055], [29, 41775], [34, 42015], [37, 42235], [40, 42435], [44, 42775], [47, 43075], [50, 43235], [56, 43978], [60, 44236], [66, 44856], [75, 45466], [80, 46076], [85, 46316], [88, 46516]]}, {"verse": 8, "start": 47380, "end": 55290, "text": "Véngale el quebrantamiento que no sepa, y su red que escondió lo prenda: con quebrantamiento en ella caiga.", "words": [[0, 47380], [8, 47885], [11, 48245], [27, 49105], [31, 49366], [34, 49627], [40, 49887], [42, 50080], [45, 50260], [49, 50600], [53, 51240], [62, 51700], [65, 51820], [73, 52671], [77, 52854], [93, 54074], [96, 54274], [101, 54494]]}, {"verse": 9, "start": 55640, "end": 60188, "text": "Y gócese mi alma en Jehová; y alégrese en su salvación.", "words": [[0, 55640], [2, 56034], [9, 56464], [12, 56624], [17, 56844], [20, 57064], [28, 57864], [30, 58142], [39, 58802], [42, 59102], [45, 59262]]}, {"verse": 10, "start": 60538, "end": 71084, "text": "Todos mis huesos dirán: Jehová, ¿quién como tú, que libras al afligido del más fuerte que él, y al pobre y necesitado del que le despoja?", "words": [[0, 60538], [6, 60720], [10, 61020], [17, 61460], [24, 62320], [32, 62320], [39, 63503], [44, 63783], [48, 64483], [52, 64503], [59, 65063], [62, 65203], [71, 65803], [75, 65983], [79, 66183], [86, 66603], [90, 66883], [94, 67243], [96, 67723], [99, 67863], [105, 68476], [107, 69090], [118, 69703], [122, 69903], [126, 70103], [129, 70243]]}, {"verse": 11, "start": 71434, "end": 75637, "text": "Se levantan testigos falsos; de lo que no sé me preguntan;", "words": [[0, 71434], [3, 71612], [12, 72192], [21, 72772], [29, 73932], [32, 74192], [35, 74312], [39, 74432], [42, 74552], [45, 74732], [48, 74852]]}, {"verse": 12, "start": 75987, "end": 79413, "text": "Me devolvieron mal por bien, para abatir a mi alma.", "words": [[0, 75987], [3, 76138], [15, 76758], [19, 77058], [23, 77318], [29, 77638], [34, 78013], [41, 78613], [43, 78693], [46, 78813]]}, {"verse": 13, "start": 79763, "end": 88886, "text": "Pero yo, cuando ellos enfermaron, me vestí de saco; afligí con ayuno mi alma, y mi oración se revolvía en mi seno.", "words": [[0, 79763], [5, 79907], [9, 80547], [16, 80907], [22, 81387], [34, 82607], [37, 82827], [43, 83227], [46, 83287], [52, 84136], [59, 84868], [63, 85048], [69, 85408], [72, 85648], [78, 85968], [80, 86528], [83, 86668], [91, 87168], [94, 87408], [103, 88068], [106, 88188], [109, 88348]]}, {"verse": 14, "start": 89236, "end": 96738, "text": "Como por mi compañero, como por mi hermano andaba; como el que trae luto por madre, enlutado me humillaba.", "words": [[0, 89236], [5, 89398], [9, 89658], [12, 89798], [23, 90638], [28, 90778], [32, 91058], [35, 91198], [43, 91638], [51, 92403], [56, 92763], [59, 92863], [63, 93003], [68, 93343], [73, 93703], [77, 93983], [84, 94823], [93, 95663], [96, 95903]]}, {"verse": 15, "start": 97088, "end": 108458, "text": "Pero ellos se alegraron en mi adversidad, y se juntaron; se juntaron contra mí gentes despreciables, y yo no lo entendía: me despedazaban, y no cesaban;", "words": [[0, 97088], [5, 97252], [11, 97532], [14, 97972], [24, 98672], [27, 98852], [30, 99032], [42, 99752], [44, 100032], [47, 100172], [57, 101092], [60, 101231], [69, 101831], [76, 102158], [79, 102484], [86, 102811], [101, 103731], [103, 103991], [106, 104251], [109, 104496], [112, 104656], [122, 105762], [125, 106036], [139, 106996], [141, 107556], [144, 107696]]}, {"verse": 16, "start": 108808, "end": 113936, "text": "Con los lisonjeros burladores bufones, crujiendo sobre mí sus dientes.", "words": [[0, 108808], [4, 108953], [8, 109193], [19, 110053], [30, 110663], [39, 111273], [49, 112413], [55, 112693], [58, 112973], [62, 113193]]}, {"verse": 17, "start": 114286, "end": 121462, "text": "Señor, ¿hasta cuándo verás esto? Recobra mi alma de sus quebrantamientos, mi única de los leones.", "words": [[0, 114286], [7, 115116], [14, 115256], [21, 115636], [27, 115896], [33, 116620], [41, 117164], [44, 117384], [49, 117684], [52, 117924], [56, 118144], [74, 119664], [77, 119944], [83, 120284], [86, 120484], [90, 120644]]}, {"verse": 18, "start": 121812, "end": 126924, "text": "Te confesaré en grande congregación; te alabaré entre numeroso pueblo.", "words": [[0, 121812], [3, 121897], [13, 122637], [16, 122877], [23, 123277], [37, 124619], [40, 124884], [48, 125184], [54, 125544], [63, 126264]]}, {"verse": 19, "start": 127274, "end": 133489, "text": "No se alegren de mí mis enemigos injustos: ni los que me aborrecen sin causa guiñen el ojo.", "words": [[0, 127274], [3, 127443], [6, 127603], [14, 128083], [17, 128243], [20, 128443], [24, 128623], [33, 129143], [43, 130370], [46, 130544], [50, 130717], [54, 130817], [57, 130977], [67, 131557], [71, 131737], [77, 132337], [84, 132937], [87, 133057]]}, {"verse": 20, "start": 133839, "end": 139195, "text": "Porque no hablan paz; y contra los mansos de la tierra piensan palabras engañosas.", "words": [[0, 133943], [7, 134083], [10, 134243], [17, 134523], [22, 135370], [24, 135466], [31, 135726], [35, 135926], [42, 136406], [45, 136526], [48, 136646], [55, 136946], [63, 137526], [72, 137886]]}, {"verse": 21, "start": 139545, "end": 145531, "text": "Y ensancharon sobre mí su boca; dijeron: ¡Ea, ea, nuestros ojos lo han visto!", "words": [[0, 139545], [2, 139785], [14, 140565], [20, 140905], [23, 141145], [26, 141305], [32, 142123], [41, 143042], [46, 143420], [50, 143860], [59, 144320], [64, 144580], [67, 144820], [71, 144960]]}, {"verse": 22, "start": 145811, "end": 150597, "text": "Tú lo has visto, oh Jehová; no calles: Señor, de mí no te alejes.", "words": [[0, 145811], [3, 145915], [6, 146035], [10, 146155], [17, 146365], [20, 146575], [28, 147349], [31, 147488], [39, 148292], [46, 148917], [49, 149117], [52, 149317], [55, 149777], [58, 149957]]}, {"verse": 23, "start": 150947, "end": 156200, "text": "Muévete y despierta para mi juicio, para mi causa, Dios mío y Señor mío.", "words": [[0, 150947], [8, 151470], [10, 151710], [20, 152470], [25, 152670], [28, 152830], [36, 153550], [41, 153590], [44, 153770], [51, 154590], [56, 154690], [60, 155330], [62, 155470], [68, 155770]]}, {"verse": 24, "start": 156550, "end": 162349, "text": "Júzgame conforme a tu justicia, Jehová Dios mío; y no se alegren de mí.", "words": [[0, 156550], [8, 157121], [17, 157841], [19, 157901], [22, 158001], [32, 159101], [39, 159821], [44, 160101], [49, 160994], [51, 161102], [54, 161242], [57, 161422], [65, 161902], [68, 162062]]}, {"verse": 25, "start": 162699, "end": 168062, "text": "No digan en su corazón: ¡Ea, alma nuestra! No digan: ¡Lo hemos devorado!", "words": [[0, 162699], [3, 162867], [9, 163267], [12, 163387], [15, 163547], [24, 164731], [29, 164978], [34, 165225], [43, 165691], [46, 166143], [53, 167016], [57, 167164], [63, 167304]]}, {"verse": 26, "start": 168412, "end": 178983, "text": "Avergüéncense, y sean confundidos a una los que de mi mal se alegran: vístanse de vergüenza y de confusión los que se engrandecen contra mí.", "words": [[0, 168412], [15, 169358], [17, 169778], [22, 170078], [34, 170958], [36, 171458], [40, 171698], [44, 172198], [48, 172418], [51, 172578], [54, 172738], [58, 173038], [61, 173398], [70, 174268], [79, 174935], [82, 175075], [92, 175695], [94, 175835], [97, 175935], [107, 176655], [111, 177115], [115, 177295], [118, 177815], [130, 178335], [137, 178635]]}, {"verse": 27, "start": 179333, "end": 188773, "text": "Canten y alégrense los que están a favor de mi justa causa, y digan siempre: Sea exaltado Jehová, que ama la paz de su siervo.", "words": [[0, 179333], [7, 179917], [9, 180102], [19, 180782], [23, 180942], [27, 181082], [33, 181282], [35, 181402], [41, 181682], [44, 181882], [47, 182002], [53, 182382], [60, 182802], [62, 183402], [68, 183762], [77, 184708], [81, 185070], [90, 185990], [98, 186630], [102, 187010], [106, 187290], [109, 187490], [113, 187730], [116, 187910], [119, 188050]]}, {"verse": 28, "start": 189123, "end": 193398, "text": "Y mi lengua hablará de tu justicia, y de tu alabanza todo el día.", "words": [[0, 189123], [2, 189244], [5, 189344], [12, 189784], [20, 190324], [23, 190444], [26, 190604], [36, 191304], [38, 191724], [41, 191844], [44, 191984], [53, 192544], [58, 192744], [61, 192964]]}]}