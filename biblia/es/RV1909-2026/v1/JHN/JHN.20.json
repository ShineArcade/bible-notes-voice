{"book": "JHN", "chapter": 20, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 265906, "verses": [{"verse": 1, "start": 300, "end": 10794, "text": "Y el primer día de la semana, María Magdalena vino de mañana, siendo aún oscuro, al sepulcro; y vio la piedra quitada del sepulcro.", "words": [[0, 300], [2, 441], [5, 601], [12, 1001], [16, 1401], [19, 1541], [22, 1681], [30, 2781], [36, 3221], [46, 4061], [51, 4281], [54, 4501], [62, 4961], [69, 5421], [73, 5801], [81, 6556], [84, 7056], [94, 8175], [96, 8297], [100, 8517], [103, 8657], [110, 9197], [118, 9697], [122, 9957]]}, {"verse": 2, "start": 11144, "end": 22727, "text": "Entonces corrió, y vino a Simón Pedro, y al otro discípulo, al cual amaba Jesús, y les dice: Han llevado al Señor del sepulcro, y no sabemos dónde le han puesto.", "words": [[0, 11144], [9, 12008], [17, 12668], [19, 12988], [24, 13268], [26, 13468], [32, 13808], [39, 14248], [41, 14523], [44, 14643], [49, 14883], [60, 15563], [63, 16243], [68, 16323], [74, 16723], [81, 17623], [83, 17683], [87, 17823], [93, 18561], [97, 18701], [105, 19121], [108, 19261], [114, 19541], [118, 19741], [128, 20421], [130, 20881], [133, 21021], [141, 21381], [147, 21701], [150, 21941], [154, 22061]]}, {"verse": 3, "start": 23007, "end": 27512, "text": "Y salió Pedro, y el otro discípulo, y vinieron al sepulcro.", "words": [[0, 23007], [2, 23151], [8, 23471], [15, 23871], [17, 24111], [20, 24231], [25, 24431], [36, 25191], [38, 25741], [47, 26291], [50, 26591]]}, {"verse": 4, "start": 27862, "end": 34678, "text": "Y corrían los dos juntos; pero el otro discípulo corrió más aprisa que Pedro, y llegó primero al sepulcro.", "words": [[0, 27862], [2, 27969], [10, 28429], [14, 28629], [18, 28789], [26, 29613], [31, 30037], [34, 30197], [39, 30357], [49, 30977], [56, 31377], [60, 31717], [67, 32057], [71, 32217], [78, 32597], [80, 33042], [86, 33282], [94, 33722], [97, 33942]]}, {"verse": 5, "start": 35028, "end": 40098, "text": "Y bajándose a mirar, vio las telas de lino allí puestas; pero no entró.", "words": [[0, 35028], [2, 35215], [12, 35795], [14, 35915], [21, 36695], [25, 36975], [29, 37155], [35, 37555], [38, 37675], [43, 37995], [48, 38155], [57, 39190], [62, 39354], [65, 39554]]}, {"verse": 6, "start": 40448, "end": 47827, "text": "Llegó luego Simón Pedro siguiéndole, y entró en el sepulcro, y vio las telas de lino allí puestas,", "words": [[0, 40448], [6, 40835], [12, 41095], [18, 41715], [24, 42115], [37, 42975], [39, 43415], [45, 43915], [48, 44055], [51, 44175], [61, 44895], [63, 45395], [67, 45575], [71, 45775], [77, 46215], [80, 46335], [85, 46655], [90, 46855]]}, {"verse": 7, "start": 48177, "end": 55931, "text": "Y el paño que había estado sobre su cabeza, no puesto con las telas de lino, sino enrollado en un lugar aparte.", "words": [[0, 48177], [2, 48303], [5, 48423], [10, 49003], [14, 49203], [20, 49423], [27, 49823], [33, 50263], [36, 50483], [44, 50943], [47, 51483], [54, 51843], [58, 52163], [62, 52323], [68, 52663], [71, 52763], [77, 53163], [82, 53603], [92, 54563], [95, 54723], [98, 54843], [104, 55183]]}, {"verse": 8, "start": 56281, "end": 62975, "text": "Y entonces entró también el otro discípulo, que había venido primero al sepulcro, y vio, y creyó.", "words": [[0, 56281], [2, 56403], [11, 56783], [17, 57403], [25, 57643], [28, 57903], [33, 58103], [44, 58763], [48, 58943], [54, 59143], [61, 59543], [69, 59923], [72, 60163], [82, 60883], [84, 61503], [89, 61803], [91, 62383]]}, {"verse": 9, "start": 63325, "end": 69980, "text": "Porque aún no sabían la Escritura, que era necesario que él resucitase de los muertos.", "words": [[0, 63325], [7, 63590], [11, 63930], [14, 64150], [21, 64570], [24, 64730], [35, 65610], [39, 65850], [43, 66030], [53, 66830], [57, 67430], [60, 67750], [71, 68850], [74, 69010], [78, 69150]]}, {"verse": 10, "start": 70330, "end": 72693, "text": "Y volvieron los discípulos a los suyos.", "words": [[0, 70330], [2, 70450], [12, 70910], [16, 71070], [27, 71690], [29, 71850], [33, 71990]]}, {"verse": 11, "start": 73043, "end": 79932, "text": "Pero María estaba fuera llorando junto al sepulcro: y estando llorando, se inclinó para mirar el sepulcro;", "words": [[0, 73043], [5, 73164], [11, 73424], [18, 73744], [24, 74064], [33, 74644], [39, 74924], [42, 75264], [52, 76281], [54, 76386], [62, 76746], [72, 77626], [75, 77866], [83, 78406], [88, 78606], [94, 79006], [97, 79146]]}, {"verse": 12, "start": 80282, "end": 90002, "text": "Y vio dos ángeles en ropas blancas que estaban sentados, el uno a la cabecera, y el otro a los pies, donde el cuerpo de Jesús había sido puesto.", "words": [[0, 80282], [2, 80418], [6, 80638], [10, 80838], [18, 81418], [21, 81658], [27, 82038], [35, 82578], [39, 82698], [47, 82998], [57, 84098], [60, 84238], [64, 84458], [66, 84598], [69, 84678], [79, 85298], [81, 85738], [84, 85858], [89, 86078], [91, 86218], [95, 86338], [101, 86918], [107, 87198], [110, 87518], [117, 87898], [120, 88138], [126, 88498], [132, 88918], [137, 89278]]}, {"verse": 13, "start": 90352, "end": 97526, "text": "Y le dijeron: Mujer, ¿por qué lloras? Les dice: Porque se han llevado a mi Señor, y no sé dónde le han puesto.", "words": [[0, 90352], [2, 90518], [5, 90598], [14, 91554], [21, 92119], [26, 92239], [30, 92419], [38, 93282], [42, 93382], [48, 94102], [55, 94296], [58, 94476], [62, 94616], [70, 95016], [72, 95036], [75, 95176], [82, 95616], [84, 96096], [87, 96236], [90, 96416], [96, 96596], [99, 96816], [103, 96916]]}, {"verse": 14, "start": 97806, "end": 105372, "text": "Y cuando hubo dicho esto, se volvió atrás, y vio a Jesús que estaba allí; pero no sabía que era Jesús.", "words": [[0, 97806], [2, 97911], [9, 98131], [14, 98691], [20, 98891], [26, 99171], [29, 99391], [36, 99891], [43, 100291], [45, 101071], [49, 101371], [51, 101551], [57, 101891], [61, 102311], [68, 102611], [74, 103306], [79, 103678], [82, 103858], [88, 104298], [92, 104478], [96, 104718]]}, {"verse": 15, "start": 105722, "end": 118799, "text": "Le dice Jesús: Mujer, ¿por qué lloras? ¿a quién buscas? Ella, pensando que era el jardinero, le dice: Señor, si tú lo has llevado, dime dónde lo has puesto, y yo lo llevaré.", "words": [[0, 105761], [3, 105841], [8, 106121], [15, 107070], [22, 107590], [27, 107770], [31, 107890], [39, 108741], [42, 108847], [48, 109007], [56, 109998], [62, 110223], [71, 110823], [75, 111163], [79, 111363], [82, 111983], [93, 112603], [96, 113103], [102, 113829], [109, 114547], [112, 114587], [115, 114767], [118, 114947], [122, 115107], [131, 116247], [136, 116427], [142, 116707], [145, 116947], [149, 117067], [157, 117467], [159, 117927], [162, 118107], [165, 118227]]}, {"verse": 16, "start": 119079, "end": 127183, "text": "Le dice Jesús: ¡María! Volviéndose ella, le dice: ¡Raboni! que quiere decir, Maestro.", "words": [[0, 119079], [3, 119207], [8, 119447], [15, 120381], [23, 121245], [35, 121952], [41, 122372], [44, 122832], [50, 124404], [59, 125436], [63, 125540], [70, 125860], [77, 126220]]}, {"verse": 17, "start": 127533, "end": 139529, "text": "Le dice Jesús: No me toques: porque aún no he subido a mi Padre: pero ve a mis hermanos, y diles: Subo a mi Padre y a vuestro Padre, a mi Dios y a vuestro Dios.", "words": [[0, 127533], [3, 127659], [8, 127919], [15, 128929], [18, 129058], [21, 129178], [29, 130036], [36, 130240], [40, 130500], [43, 130740], [46, 130840], [53, 131280], [55, 131380], [58, 131500], [65, 132316], [70, 132478], [73, 132658], [75, 132738], [79, 132878], [89, 133498], [91, 133698], [98, 134631], [103, 135134], [105, 135254], [108, 135334], [114, 135994], [116, 136154], [118, 136254], [126, 136534], [133, 137454], [135, 137534], [138, 137654], [143, 137954], [145, 138309], [147, 138429], [155, 138889]]}, {"verse": 18, "start": 139879, "end": 148677, "text": "fue María Magdalena dando la noticia a los discípulos de que había visto al Señor, y que él le había dicho estas cosas.", "words": [[0, 139879], [4, 140086], [10, 140426], [20, 141186], [26, 141506], [29, 141746], [37, 142446], [39, 142706], [43, 142866], [54, 143926], [57, 144446], [61, 144586], [67, 144826], [73, 145206], [76, 145406], [83, 145746], [85, 146286], [89, 146466], [92, 146706], [95, 147106], [101, 147346], [107, 147686], [113, 147926]]}, {"verse": 19, "start": 149027, "end": 164630, "text": "Y como fue tarde aquel día, el primero de la semana, y estando las puertas cerradas donde los discípulos estaban juntos por miedo de los judíos, vino Jesús, y se puso en medio, y les dijo: Paz a vosotros.", "words": [[0, 149027], [2, 149171], [7, 149451], [11, 149731], [17, 150171], [23, 150811], [28, 151671], [31, 151831], [39, 152251], [42, 152431], [45, 152551], [53, 153031], [55, 153291], [63, 153731], [67, 153871], [75, 154271], [84, 155011], [90, 155811], [94, 156071], [105, 156751], [113, 157111], [120, 157651], [124, 158011], [130, 158391], [133, 158611], [137, 158731], [145, 159371], [150, 159991], [157, 161056], [159, 161199], [162, 161299], [167, 161679], [170, 161819], [177, 162199], [179, 162499], [183, 162659], [189, 163565], [193, 163665], [195, 163765]]}, {"verse": 20, "start": 164980, "end": 171677, "text": "Y cuando hubo dicho esto, les mostró las manos y el costado. Y los discípulos se gozaron viendo al Señor.", "words": [[0, 164980], [2, 165081], [9, 165301], [14, 165741], [20, 165961], [26, 166341], [30, 166701], [37, 167181], [41, 167321], [47, 167721], [49, 167941], [52, 168061], [61, 169024], [63, 169128], [67, 169268], [78, 169928], [81, 170108], [89, 170548], [96, 170848], [99, 171088]]}, {"verse": 21, "start": 172027, "end": 179703, "text": "Entonces les dijo Jesús otra vez: Paz a vosotros; como me envió el Padre, así también yo os envío.", "words": [[0, 172027], [9, 172555], [13, 173315], [18, 173655], [24, 173955], [29, 174395], [34, 175367], [38, 175547], [40, 175707], [50, 176510], [55, 176679], [58, 176879], [64, 177139], [67, 177259], [74, 177959], [78, 178139], [86, 178559], [89, 178859], [92, 179039]]}, {"verse": 22, "start": 180053, "end": 184991, "text": "Y cuando hubo dicho esto, sopló, y les dijo: Recibid el Espíritu Santo:", "words": [[0, 180053], [2, 180157], [9, 180377], [14, 180757], [20, 180977], [26, 181377], [33, 181917], [35, 182217], [39, 182337], [45, 183268], [53, 183528], [56, 183868], [65, 184408]]}, {"verse": 23, "start": 185341, "end": 191928, "text": "A los que perdonáis los pecados, les son perdonados: a quienes los retenéis, serán retenidos.", "words": [[0, 185341], [2, 185462], [6, 185582], [10, 185682], [20, 186242], [24, 186402], [33, 187402], [37, 187662], [41, 187922], [53, 189122], [55, 189303], [63, 189443], [67, 189703], [77, 190263], [83, 190983]]}, {"verse": 24, "start": 192278, "end": 198248, "text": "Pero Tomás, uno de los doce, que se dice el Dídimo, no estaba con ellos cuando Jesús vino.", "words": [[0, 192278], [5, 192419], [12, 192839], [16, 193119], [19, 193279], [23, 193419], [29, 194259], [33, 194339], [36, 194499], [41, 194799], [44, 194999], [52, 195839], [55, 195959], [62, 196259], [66, 196539], [72, 196719], [79, 197039], [85, 197419]]}, {"verse": 25, "start": 198598, "end": 211950, "text": "Le dijeron pues los otros discípulos: Al Señor hemos visto. Y él les dijo: Si no veo en sus manos la señal de los clavos, y meto mi dedo en el lugar de los clavos, y meto mi mano en su costado, no creeré.", "words": [[0, 198598], [3, 198720], [11, 199200], [16, 199360], [20, 199540], [26, 199880], [38, 201049], [41, 201194], [47, 201474], [53, 201714], [60, 202598], [62, 202804], [65, 202984], [69, 203284], [75, 204081], [78, 204177], [81, 204317], [85, 204537], [88, 204717], [92, 204857], [98, 205197], [101, 205437], [107, 205857], [110, 205917], [114, 206057], [122, 206597], [124, 206997], [129, 207357], [132, 207517], [137, 207797], [140, 207877], [143, 207977], [149, 208217], [152, 208417], [156, 208537], [164, 209117], [166, 209537], [171, 209897], [174, 210037], [179, 210237], [182, 210397], [185, 210517], [194, 211017], [197, 211337]]}, {"verse": 26, "start": 212230, "end": 224527, "text": "Y ocho días después, estaban otra vez sus discípulos dentro, y con ellos Tomás. Vino Jesús, las puertas cerradas, y se puso en medio, y dijo: Paz a vosotros.", "words": [[0, 212230], [2, 212395], [7, 212735], [12, 212935], [21, 214015], [29, 214515], [34, 214875], [38, 215235], [42, 215655], [53, 216315], [61, 216695], [63, 217035], [67, 217215], [73, 217435], [80, 218466], [85, 218712], [92, 219092], [96, 219572], [104, 219972], [114, 220572], [116, 221072], [119, 221192], [124, 221532], [127, 221692], [134, 222052], [136, 222592], [142, 223467], [146, 223647], [148, 223747]]}, {"verse": 27, "start": 224877, "end": 235019, "text": "Luego dice a Tomás: Mete tu dedo aquí, y ve mis manos: y alarga acá tu mano, y métela en mi costado: y no seas incrédulo, sino creyente.", "words": [[0, 224877], [6, 225164], [11, 225344], [13, 225524], [20, 226443], [25, 226729], [28, 226989], [33, 227289], [39, 227469], [41, 227709], [44, 227829], [48, 227969], [55, 228790], [57, 229030], [64, 229490], [68, 229770], [71, 229930], [77, 230250], [79, 230650], [86, 231130], [89, 231290], [92, 231430], [101, 232394], [103, 232500], [106, 232600], [111, 232880], [122, 234000], [127, 234180]]}, {"verse": 28, "start": 235369, "end": 240109, "text": "Entonces Tomás respondió, y le dijo: ¡Señor mío, y Dios mío!", "words": [[0, 235369], [9, 235797], [15, 236337], [26, 237237], [28, 237797], [31, 237897], [37, 238582], [44, 238866], [49, 239326], [51, 239426], [56, 239606]]}, {"verse": 29, "start": 240389, "end": 248115, "text": "Le dice Jesús: Porque me has visto, Tomás, creíste: bienaventurados los que no vieron y creyeron.", "words": [[0, 240389], [3, 240534], [8, 240834], [15, 241965], [22, 242115], [25, 242255], [29, 242415], [36, 243335], [43, 243925], [52, 245438], [68, 245929], [72, 246189], [76, 246349], [79, 246549], [86, 246929], [88, 247543]]}, {"verse": 30, "start": 248465, "end": 255869, "text": "Y también hizo Jesús muchas otras señales en presencia de sus discípulos, que no están escritas en este libro.", "words": [[0, 248465], [2, 248573], [10, 248873], [15, 249153], [21, 249653], [28, 250273], [34, 250613], [42, 251273], [45, 251453], [55, 252093], [58, 252273], [62, 252473], [74, 253233], [78, 253853], [81, 254013], [87, 254253], [96, 254873], [99, 255033], [104, 255480]]}, {"verse": 31, "start": 256219, "end": 265506, "text": "Pero estas han sido escritas, para que creáis que Jesús es el Cristo, el Hijo de Dios; y para que creyendo, tengáis vida en su nombre.", "words": [[0, 256219], [5, 256383], [11, 256883], [15, 257043], [20, 257343], [30, 258143], [35, 258603], [39, 258783], [46, 259263], [50, 259463], [56, 259803], [59, 260123], [62, 260323], [70, 260943], [73, 261023], [78, 261283], [81, 261443], [87, 262173], [89, 262298], [94, 262478], [98, 262658], [108, 263318], [116, 264218], [121, 264538], [124, 264758], [127, 264918]]}]}