{"book": "GEN", "chapter": 46, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 269088, "verses": [{"verse": 1, "start": 300, "end": 8477, "text": "And Israel took his journey with all that he had, and came to Beer-sheba, and offered sacrifices to the God of his father Isaac.", "words": [[0, 300], [4, 442], [11, 842], [16, 1182], [20, 1422], [28, 1822], [33, 2042], [37, 2302], [42, 2502], [45, 2622], [50, 3362], [54, 3582], [59, 3842], [62, 4042], [74, 5262], [78, 5362], [86, 5702], [97, 6362], [100, 6782], [104, 6902], [108, 7142], [111, 7302], [115, 7462], [122, 7822]]}, {"verse": 2, "start": 8827, "end": 16261, "text": "And God spoke to Israel in the visions of the night, and said, Jacob, Jacob. And he said, Here am I.", "words": [[0, 8827], [4, 8957], [8, 9217], [14, 9557], [17, 9777], [24, 10197], [27, 10417], [31, 10517], [39, 10817], [42, 11077], [46, 11177], [53, 11437], [57, 11697], [63, 12363], [70, 12584], [77, 13670], [81, 13805], [84, 13945], [90, 15353], [95, 15561], [98, 15841]]}, {"verse": 3, "start": 16541, "end": 25607, "text": "And he said, I am God, the God of your father: fear not to go down into Egypt; for I will there make of you a great nation:", "words": [[0, 16541], [4, 16676], [7, 16816], [13, 18225], [15, 18428], [18, 18568], [23, 19328], [27, 19428], [31, 19688], [34, 19828], [39, 19968], [47, 21072], [52, 21174], [56, 21394], [59, 21594], [62, 21754], [67, 22014], [72, 22254], [79, 23328], [83, 23477], [85, 23577], [90, 23797], [96, 23957], [101, 24157], [104, 24337], [108, 24517], [110, 24677], [116, 24897]]}, {"verse": 4, "start": 26188, "end": 33479, "text": "I will go down with you into Egypt; and I will also surely bring you up again: and Joseph shall put his hand upon your eyes.", "words": [[0, 26188], [2, 26306], [7, 26446], [10, 26606], [15, 26826], [20, 27046], [24, 27246], [29, 27406], [36, 28475], [40, 28586], [42, 28686], [47, 28846], [52, 29146], [59, 29506], [65, 29846], [69, 30006], [72, 30186], [79, 31168], [83, 31289], [90, 31609], [96, 31829], [100, 32009], [104, 32169], [109, 32409], [114, 32669], [119, 32909]]}, {"verse": 5, "start": 33993, "end": 44070, "text": "And Jacob rose up from Beer-sheba: and the sons of Israel carried Jacob their father, and their little ones, and their wives, in the wagons which Pharaoh had sent to carry him.", "words": [[0, 33993], [4, 34126], [10, 34446], [15, 34766], [18, 35026], [23, 35637], [35, 36398], [39, 36521], [43, 36641], [48, 36881], [51, 37081], [58, 37481], [66, 37861], [72, 38241], [78, 38501], [86, 39101], [90, 39281], [96, 39401], [103, 39641], [109, 40301], [113, 40421], [119, 40561], [126, 41441], [129, 41581], [133, 41701], [140, 42141], [146, 42341], [154, 42701], [158, 42941], [163, 43141], [166, 43341], [172, 43641]]}, {"verse": 6, "start": 44420, "end": 52312, "text": "And they took their cattle, and their goods, which they had gotten in the land of Canaan, and came into Egypt, Jacob, and all his seed with him:", "words": [[0, 44420], [4, 44560], [9, 44660], [14, 44900], [20, 45120], [28, 45520], [32, 45860], [38, 46020], [45, 46520], [51, 46660], [56, 46860], [60, 47000], [67, 47320], [70, 47520], [74, 47620], [79, 47840], [82, 47940], [90, 48880], [94, 48960], [99, 49200], [104, 49420], [111, 50120], [118, 50920], [122, 51080], [126, 51260], [130, 51460], [135, 51760], [140, 52000]]}, {"verse": 7, "start": 52662, "end": 60669, "text": "His sons, and his sons’ sons with him, his daughters, and his sons’ daughters, and all his seed brought he with him into Egypt.", "words": [[0, 52662], [4, 52781], [10, 53221], [14, 53621], [18, 53781], [24, 54101], [29, 54401], [34, 54741], [39, 55301], [43, 55461], [54, 55801], [58, 56281], [62, 56421], [68, 56721], [79, 57721], [83, 57881], [87, 58181], [91, 58401], [96, 58761], [104, 59121], [107, 59341], [112, 59601], [116, 59821], [121, 60001]]}, {"verse": 8, "start": 61019, "end": 68934, "text": "¶ And these are the names of the children of Israel, which came into Egypt, Jacob and his sons: Reuben, Jacob’s firstborn.", "words": [[2, 61019], [6, 61175], [12, 61435], [16, 61615], [20, 61755], [26, 62095], [29, 62315], [33, 62435], [42, 62775], [45, 62995], [53, 63835], [59, 64015], [64, 64275], [69, 64555], [76, 65315], [82, 65675], [86, 65975], [90, 66135], [96, 67003], [104, 67610], [112, 68090]]}, {"verse": 9, "start": 69284, "end": 74054, "text": "And the sons of Reuben; Hanoch, and Phallu, and Hezron, and Carmi.", "words": [[0, 69284], [4, 69425], [8, 69565], [13, 69905], [16, 70165], [24, 71156], [32, 71416], [36, 71876], [44, 72336], [48, 72766], [56, 73196], [60, 73654]]}, {"verse": 10, "start": 74404, "end": 83027, "text": "¶ And the sons of Simeon; Jemuel, and Jamin, and Ohad, and Jachin, and Zohar, and Shaul the son of a Canaanitish woman.", "words": [[2, 74404], [6, 74547], [10, 74667], [15, 74967], [18, 75147], [26, 76401], [34, 76731], [38, 77131], [45, 77531], [49, 77771], [55, 78291], [59, 78751], [67, 79211], [71, 79631], [78, 80291], [82, 80711], [88, 81131], [92, 81231], [96, 81511], [99, 81651], [101, 81981], [113, 82311]]}, {"verse": 11, "start": 83377, "end": 87044, "text": "¶ And the sons of Levi; Gershon, Kohath, and Merari.", "words": [[2, 83377], [6, 83523], [10, 83663], [15, 83903], [18, 84103], [24, 85189], [33, 85559], [41, 86259], [45, 86686]]}, {"verse": 12, "start": 87394, "end": 98124, "text": "¶ And the sons of Judah; Er, and Onan, and Shelah, and Pharez, and Zerah: but Er and Onan died in the land of Canaan. And the sons of Pharez were Hezron and Hamul.", "words": [[2, 87394], [6, 87521], [10, 87661], [15, 87922], [18, 88122], [25, 89091], [29, 89331], [33, 89391], [39, 89971], [43, 90361], [51, 90751], [55, 91121], [63, 91491], [67, 91791], [74, 92311], [78, 92467], [81, 92677], [85, 92977], [90, 93277], [95, 93577], [98, 93837], [102, 93917], [107, 94197], [110, 94317], [118, 95228], [122, 95357], [126, 95497], [131, 95777], [134, 96147], [141, 96517], [146, 96697], [153, 97277], [157, 97740]]}, {"verse": 13, "start": 98474, "end": 104279, "text": "¶ And the sons of Issachar; Tola, and Phuvah, and Job, and Shimron.", "words": [[2, 98474], [6, 98623], [10, 98723], [15, 99123], [18, 99719], [28, 100499], [34, 101361], [38, 101851], [46, 102341], [50, 102801], [55, 103261], [59, 103421]]}, {"verse": 14, "start": 104629, "end": 109171, "text": "¶ And the sons of Zebulun; Sered, and Elon, and Jahleel.", "words": [[2, 104629], [6, 104889], [10, 105009], [15, 105309], [18, 105509], [27, 106957], [34, 107357], [38, 107637], [44, 108077], [48, 108642]]}, {"verse": 15, "start": 109521, "end": 118911, "text": "These are the sons of Leah, which she bore to Jacob in Padan-aram, with his daughter Dinah: all the souls of his sons and his daughters were thirty and three.", "words": [[0, 109521], [6, 109768], [10, 109928], [14, 110068], [19, 110388], [22, 110628], [28, 111308], [34, 111448], [38, 111688], [43, 111968], [46, 112168], [52, 112661], [55, 113155], [67, 113648], [72, 114128], [76, 114308], [85, 114588], [92, 115408], [96, 115612], [100, 115812], [106, 116112], [109, 116352], [113, 116492], [118, 116812], [122, 117072], [126, 117212], [136, 117592], [141, 117872], [148, 118212], [152, 118412]]}, {"verse": 16, "start": 119261, "end": 126025, "text": "¶ And the sons of Gad; Ziphion, and Haggi, Shuni, and Ezbon, Eri, and Arodi, and Areli.", "words": [[2, 119261], [6, 119420], [10, 119560], [15, 119820], [18, 120020], [23, 121289], [32, 121789], [36, 122199], [43, 122609], [50, 123229], [54, 123682], [61, 124136], [66, 124589], [70, 124959], [77, 125329], [81, 125677]]}, {"verse": 17, "start": 126025, "end": 136700, "text": "¶ And the sons of Asher; Jimnah, and Ishuah, and Isui, and Beriah, and Serah their sister: and the sons of Beriah; Heber, and Malchiel.", "words": [[2, 126025], [6, 126305], [10, 126425], [15, 126645], [18, 126845], [25, 128019], [33, 128439], [37, 128799], [45, 129159], [49, 129639], [55, 130119], [59, 130659], [67, 131199], [71, 131869], [77, 132539], [83, 132679], [91, 133553], [95, 133696], [99, 133796], [104, 134096], [107, 134570], [115, 135207], [122, 135650], [126, 136206]]}, {"verse": 18, "start": 137050, "end": 144366, "text": "These are the sons of Zilpah, whom Laban gave to Leah his daughter, and these she bore to Jacob, even sixteen souls.", "words": [[0, 137050], [6, 137220], [10, 137380], [14, 137500], [19, 137760], [22, 138070], [30, 138380], [35, 138920], [41, 139380], [46, 139620], [49, 139820], [54, 140080], [58, 140320], [68, 141240], [72, 141380], [78, 141560], [82, 141740], [87, 141980], [90, 142140], [97, 142540], [102, 143020], [110, 143520]]}, {"verse": 19, "start": 144716, "end": 148652, "text": "The sons of Rachel Jacob’s wife; Joseph, and Benjamin.", "words": [[0, 144716], [4, 144854], [9, 145194], [12, 145474], [19, 145774], [27, 146454], [33, 146994], [41, 147500], [45, 147960]]}, {"verse": 20, "start": 149002, "end": 157969, "text": "¶ And to Joseph in the land of Egypt were born Manasseh and Ephraim, which Asenath the daughter of Poti-pherah priest of On bore to him.", "words": [[2, 149002], [6, 149171], [9, 149291], [16, 149691], [19, 149951], [23, 150051], [28, 150291], [31, 150451], [37, 150811], [42, 151091], [47, 151411], [56, 152231], [60, 152371], [69, 153391], [75, 153941], [83, 154491], [87, 154551], [96, 154851], [99, 155461], [111, 156071], [118, 156331], [121, 156644], [124, 156958], [129, 157271], [132, 157491]]}, {"verse": 21, "start": 158319, "end": 168838, "text": "¶ And the sons of Benjamin were Belah, and Becher, and Ashbel, Gera, and Naaman, Ehi, and Rosh, Muppim, and Huppim, and Ard.", "words": [[2, 158319], [6, 158466], [10, 158566], [15, 158846], [18, 159026], [27, 159486], [32, 160236], [39, 160986], [43, 161536], [51, 162086], [55, 162126], [63, 163126], [69, 164126], [73, 164639], [81, 165153], [86, 165666], [90, 165766], [96, 166686], [104, 167386], [108, 167406], [116, 168206], [120, 168266]]}, {"verse": 22, "start": 169188, "end": 174752, "text": "These are the sons of Rachel, which were born to Jacob: all the souls were fourteen.", "words": [[0, 169188], [6, 169748], [10, 169948], [14, 170088], [19, 170388], [22, 170628], [30, 171288], [36, 171408], [41, 171588], [46, 171948], [49, 172148], [56, 173049], [60, 173239], [64, 173399], [70, 173679], [75, 173939]]}, {"verse": 23, "start": 175102, "end": 177097, "text": "¶ And the sons of Dan; Hushim.", "words": [[2, 175102], [6, 175235], [10, 175335], [15, 175615], [18, 175815], [23, 176579]]}, {"verse": 24, "start": 177447, "end": 182082, "text": "¶ And the sons of Naphtali; Jahzeel, and Guni, and Jezer, and Shillem.", "words": [[2, 177447], [6, 177576], [10, 177696], [15, 177976], [18, 178483], [28, 179570], [37, 180010], [41, 180380], [47, 180750], [51, 181050], [58, 181350], [62, 181550]]}, {"verse": 25, "start": 182432, "end": 190105, "text": "These are the sons of Bilhah, which Laban gave to Rachel his daughter, and she bore these to Jacob: all the souls were seven.", "words": [[0, 182432], [6, 182642], [10, 182842], [14, 182962], [19, 183282], [22, 183462], [30, 184242], [36, 184522], [42, 185002], [47, 185322], [50, 185502], [57, 185862], [61, 186102], [71, 186862], [75, 186982], [79, 187142], [84, 187382], [90, 187622], [93, 187862], [100, 188632], [104, 188838], [108, 188978], [114, 189298], [119, 189558]]}, {"verse": 26, "start": 190455, "end": 198927, "text": "All the souls that came with Jacob into Egypt, which came out of his loins, besides Jacob’s sons’ wives, all the souls were threescore and six;", "words": [[0, 190455], [4, 190621], [8, 190781], [14, 191061], [19, 191341], [24, 191581], [29, 191781], [35, 192081], [40, 192341], [47, 193101], [53, 193301], [58, 193521], [62, 193741], [65, 193821], [69, 193921], [76, 194341], [84, 194781], [92, 195441], [98, 195721], [105, 196541], [109, 196781], [113, 196981], [119, 197241], [124, 197661], [135, 198081], [139, 198361]]}, {"verse": 27, "start": 199277, "end": 209110, "text": "And the sons of Joseph, which were born him in Egypt, were two souls: all the souls of the house of Jacob, which came into Egypt, were threescore and ten.", "words": [[0, 199277], [4, 199412], [8, 199532], [13, 199812], [16, 199992], [24, 200792], [30, 200952], [35, 201132], [40, 201412], [44, 201612], [47, 201732], [54, 202592], [59, 202752], [63, 203032], [70, 204025], [74, 204214], [78, 204394], [84, 204674], [87, 204914], [91, 204994], [97, 205234], [100, 205394], [107, 205774], [113, 206054], [118, 206314], [123, 206534], [130, 206994], [135, 207564], [146, 208134], [150, 208494]]}, {"verse": 28, "start": 209460, "end": 215880, "text": "¶ And he sent Judah before him to Joseph, to direct his face to Goshen; and they came into the land of Goshen.", "words": [[2, 209460], [6, 209584], [9, 209724], [14, 209984], [20, 210324], [27, 210704], [31, 210964], [34, 211144], [42, 211544], [45, 212124], [52, 212444], [56, 212684], [61, 212964], [64, 213164], [72, 213936], [76, 214061], [81, 214181], [86, 214421], [91, 214681], [95, 214861], [100, 215101], [103, 215261]]}, {"verse": 29, "start": 216230, "end": 226813, "text": "And Joseph made ready his chariot, and went up to meet Israel his father, to Goshen, and presented himself to him; and he fell on his neck, and wept on his neck a good while.", "words": [[0, 216230], [4, 216371], [11, 216651], [16, 217011], [22, 217331], [26, 217531], [35, 218111], [39, 218551], [44, 218711], [47, 218851], [50, 219011], [55, 219151], [62, 219591], [66, 219951], [74, 220331], [77, 220631], [85, 221191], [89, 221551], [99, 221971], [107, 222431], [110, 222671], [115, 223277], [119, 223428], [122, 223528], [127, 223748], [130, 223988], [134, 224148], [140, 224428], [144, 224948], [149, 225308], [152, 225448], [156, 225648], [161, 225928], [163, 226028], [168, 226248]]}, {"verse": 30, "start": 227163, "end": 232820, "text": "And Israel said to Joseph, Now let me die, since I have seen your face, because you are yet alive.", "words": [[0, 227163], [4, 227288], [11, 227648], [16, 227968], [19, 228148], [27, 228930], [31, 229110], [35, 229330], [38, 229450], [43, 229990], [49, 230170], [51, 230350], [56, 230470], [61, 230650], [66, 230810], [72, 231470], [80, 231670], [84, 231910], [88, 232010], [92, 232210]]}, {"verse": 31, "start": 233100, "end": 242808, "text": "And Joseph said to his brethren, and to his father’s house, I will go up, and show Pharaoh, and say to him, My brethren, and my father’s house, which were in the land of Canaan, are come to me;", "words": [[0, 233100], [4, 233257], [11, 233557], [16, 233877], [19, 234077], [23, 234197], [33, 234577], [37, 234962], [40, 235122], [44, 235262], [53, 235742], [60, 236467], [62, 236612], [67, 236752], [70, 236932], [74, 237232], [78, 237492], [83, 237692], [92, 238092], [96, 238592], [100, 238852], [103, 239032], [108, 239172], [111, 239332], [121, 239652], [125, 239872], [128, 240012], [137, 240432], [144, 240592], [150, 240719], [155, 240845], [158, 240972], [162, 241092], [167, 241312], [170, 241412], [178, 241852], [182, 242212], [187, 242412], [190, 242572]]}, {"verse": 32, "start": 243158, "end": 250438, "text": "And the men are shepherds, for their trade has been to feed cattle; and they have brought their flocks, and their herds, and all that they have.", "words": [[0, 243158], [4, 243331], [8, 243471], [12, 243671], [16, 243851], [27, 244591], [31, 244791], [37, 245011], [43, 245391], [47, 245551], [52, 245771], [55, 245931], [60, 246131], [68, 246877], [72, 247018], [77, 247138], [82, 247338], [90, 247598], [96, 247818], [104, 248358], [108, 248618], [114, 248778], [121, 249198], [125, 249578], [129, 249818], [134, 249998], [139, 250138]]}, {"verse": 33, "start": 250788, "end": 255650, "text": "And it shall come to pass, when Pharaoh shall call you, and shall say, What is your occupation?", "words": [[0, 250788], [4, 250946], [7, 251066], [13, 251226], [18, 251446], [21, 251606], [27, 251966], [32, 252386], [40, 252726], [46, 252946], [51, 253226], [56, 253366], [60, 253726], [66, 253906], [71, 254558], [76, 254720], [79, 254840], [84, 254960]]}, {"verse": 34, "start": 256000, "end": 268688, "text": "That you shall say, Your servants’ trade has been about cattle from our youth even until now, both we, and also our fathers: that you may dwell in the land of Goshen; for every shepherd is an abomination to the Egyptians.", "words": [[0, 256000], [5, 256190], [9, 256330], [15, 256530], [20, 256870], [25, 257270], [35, 257930], [41, 258090], [45, 258350], [50, 258590], [56, 258770], [63, 259150], [68, 259430], [72, 259590], [78, 259810], [83, 260150], [89, 260470], [94, 261110], [99, 261310], [103, 261630], [107, 262050], [112, 262290], [116, 262470], [125, 263258], [130, 263377], [134, 263537], [138, 263697], [144, 263997], [147, 264297], [151, 264417], [156, 264637], [159, 264757], [167, 265496], [171, 265640], [177, 265840], [186, 266180], [189, 266620], [192, 266780], [204, 267420], [207, 267820], [211, 267940]]}]}