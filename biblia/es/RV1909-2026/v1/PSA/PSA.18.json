{"book": "PSA", "chapter": 18, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 327339, "verses": [{"verse": 1, "start": 300, "end": 17785, "text": "Al Músico principal: Salmo de David, siervo de Jehová, el cual profirió a Jehová las palabras de este cántico el día que le libró Jehová de mano de todos sus enemigos, y de mano de Saúl. Entonces dijo: TE AMARÉ, oh Jehová, fortaleza mía.", "words": [[0, 300], [3, 491], [10, 971], [21, 2191], [27, 2814], [30, 3074], [37, 3994], [44, 4394], [47, 4514], [55, 5334], [58, 5334], [63, 5534], [72, 6294], [74, 6434], [81, 6854], [85, 6994], [94, 7334], [97, 7674], [102, 7874], [110, 8614], [113, 8634], [117, 8834], [121, 9014], [124, 9154], [130, 9554], [137, 9994], [140, 10094], [145, 10314], [148, 10494], [154, 10734], [158, 11214], [168, 12301], [170, 12426], [173, 12546], [178, 12766], [181, 12986], [187, 13832], [196, 14397], [202, 15333], [205, 15437], [212, 15844], [215, 16250], [223, 16657], [233, 17237]]}, {"verse": 2, "start": 18135, "end": 29123, "text": "Jehová, roca mía y castillo mío, y mi libertador; Dios mío, fuerte mío, en él confiaré; escudo mío, y el cuerno de mi salvación, mi refugio.", "words": [[0, 18135], [8, 18562], [13, 18962], [17, 19342], [19, 19422], [28, 19962], [33, 20302], [35, 20402], [38, 20502], [50, 21729], [55, 22049], [60, 22589], [67, 22829], [72, 23269], [75, 23409], [78, 23529], [88, 24556], [95, 25000], [100, 26000], [102, 26200], [105, 26380], [112, 26940], [115, 27020], [118, 27180], [129, 28160], [132, 28220]]}, {"verse": 3, "start": 29473, "end": 34550, "text": "Invocaré a Jehová, digno de ser alabado, y seré salvo de mis enemigos.", "words": [[0, 29473], [9, 30254], [11, 30334], [19, 30734], [25, 31194], [28, 31274], [32, 31494], [41, 32214], [43, 32654], [48, 32954], [54, 33434], [57, 33574], [61, 33674]]}, {"verse": 4, "start": 34900, "end": 40088, "text": "Me cercaron dolores de muerte, y torrentes de perversidad me atemorizaron.", "words": [[0, 34900], [3, 35008], [12, 35508], [20, 35988], [23, 36128], [31, 36548], [33, 37068], [43, 37828], [46, 37928], [58, 38788], [61, 38968]]}, {"verse": 5, "start": 40438, "end": 45858, "text": "Dolores del sepulcro me rodearon, me sorprendieron lazos de muerte.", "words": [[0, 40438], [8, 40983], [12, 41243], [21, 41963], [24, 42123], [34, 43283], [37, 43563], [51, 44443], [57, 45003], [60, 45123]]}, {"verse": 6, "start": 46208, "end": 56106, "text": "En mi angustia invoqué a Jehová, y clamé a mi Dios: él oyó mi voz desde su templo, y mi clamor llegó delante de él, a sus oídos.", "words": [[0, 46208], [3, 46537], [6, 46677], [15, 47317], [23, 47757], [25, 47897], [33, 48497], [35, 48757], [41, 49177], [43, 49477], [46, 49597], [52, 50446], [55, 50632], [59, 50952], [62, 51072], [66, 51432], [72, 51832], [75, 52132], [83, 53192], [85, 53232], [88, 53372], [95, 53852], [101, 54092], [109, 54612], [112, 54832], [116, 55012], [118, 55232], [122, 55392]]}, {"verse": 7, "start": 56456, "end": 64796, "text": "Y la tierra fue conmovida y tembló; y se movieron los fundamentos de los montes, y se estremecieron, porque se indignó él.", "words": [[0, 56456], [2, 56560], [5, 56700], [12, 57020], [16, 57360], [26, 58000], [28, 58160], [36, 58986], [38, 59151], [41, 59231], [50, 59731], [54, 59911], [66, 60611], [69, 60691], [73, 60831], [81, 61411], [83, 61811], [86, 61991], [101, 63071], [108, 63396], [111, 63656], [119, 64536]]}, {"verse": 8, "start": 65146, "end": 72106, "text": "Humo subió de su nariz, y de su boca consumidor fuego; carbones fueron por él encendidos.", "words": [[0, 65146], [5, 65631], [11, 66231], [14, 66351], [17, 66531], [24, 67151], [26, 67331], [29, 67431], [32, 67591], [37, 67931], [48, 68811], [55, 69793], [64, 70397], [71, 70637], [75, 70957], [78, 71117]]}, {"verse": 9, "start": 72456, "end": 77684, "text": "Y bajó los cielos, y descendió; y oscuridad debajo de sus pies.", "words": [[0, 72456], [2, 72581], [7, 72901], [11, 73021], [19, 73801], [21, 74121], [32, 75114], [34, 75459], [44, 76179], [51, 76679], [54, 76819], [58, 76959]]}, {"verse": 10, "start": 78034, "end": 83209, "text": "Y cabalgó sobre un querubín, y voló: voló sobre las alas del viento.", "words": [[0, 78034], [2, 78370], [10, 78740], [16, 79020], [19, 79200], [29, 79940], [31, 80360], [37, 81148], [42, 81533], [48, 81793], [52, 82013], [57, 82373], [61, 82533]]}, {"verse": 11, "start": 83559, "end": 92100, "text": "Puso tinieblas por escondedero suyo, su pabellón en derredor de sí; oscuridad de aguas, nubes de los cielos.", "words": [[0, 83559], [5, 83783], [15, 84383], [19, 84853], [31, 85323], [37, 86203], [40, 86443], [49, 87063], [52, 87453], [61, 87843], [64, 88143], [68, 88756], [78, 89442], [81, 89662], [88, 90542], [94, 91022], [97, 91162], [101, 91282]]}, {"verse": 12, "start": 92450, "end": 98300, "text": "Por el resplandor delante de él, sus nubes pasaron; granizo y carbones ardientes.", "words": [[0, 92450], [4, 92748], [7, 92928], [18, 93548], [26, 94008], [29, 94148], [33, 94348], [37, 94528], [43, 94948], [52, 95808], [60, 96548], [62, 96788], [71, 97268]]}, {"verse": 13, "start": 98650, "end": 105552, "text": "Y tronó en los cielos Jehová, y el Altísimo dio su voz; granizo y carbones de fuego.", "words": [[0, 98650], [2, 98796], [8, 99216], [11, 99316], [15, 99436], [22, 99916], [30, 100676], [32, 100916], [35, 101056], [44, 101736], [48, 102116], [51, 102416], [56, 103198], [64, 103823], [66, 104303], [75, 104843], [78, 104983]]}, {"verse": 14, "start": 105902, "end": 111919, "text": "Y envió sus flechas, y los desbarató; y echó relámpagos, y los destruyó.", "words": [[0, 105902], [2, 106027], [8, 106447], [12, 106647], [21, 107327], [23, 107787], [27, 107927], [38, 108944], [40, 109225], [45, 109545], [57, 110805], [59, 111005], [63, 111145]]}, {"verse": 15, "start": 112269, "end": 121953, "text": "Y aparecieron las honduras de las aguas, y se descubrieron los cimientos del mundo, a tu reprensión, oh Jehová, por el soplo del viento de tu nariz.", "words": [[0, 112269], [2, 112412], [14, 113072], [18, 113422], [27, 113772], [30, 113912], [34, 114092], [41, 114712], [43, 114892], [46, 115012], [59, 115792], [63, 115952], [73, 116472], [77, 116712], [84, 117472], [86, 117840], [89, 118208], [101, 118576], [104, 118944], [112, 119312], [116, 119632], [119, 119772], [125, 120292], [129, 120492], [136, 120972], [139, 121322], [142, 121671]]}, {"verse": 16, "start": 122303, "end": 126961, "text": "Envió desde lo alto; me tomó, me sacó de las muchas aguas.", "words": [[0, 122303], [6, 122704], [12, 122904], [15, 123144], [21, 123960], [24, 124107], [30, 125087], [33, 125247], [38, 125667], [41, 125787], [45, 125927], [52, 126167]]}, {"verse": 17, "start": 127311, "end": 133624, "text": "Me libró de mi poderoso enemigo, y de los que me aborrecían, aunque eran ellos más fuertes que yo.", "words": [[0, 127311], [3, 127438], [9, 127898], [12, 127998], [15, 128138], [24, 128718], [33, 129518], [35, 129778], [38, 129898], [42, 130078], [46, 130258], [49, 130438], [61, 131538], [68, 131778], [73, 132138], [79, 132358], [83, 132638], [91, 133158], [95, 133258]]}, {"verse": 18, "start": 133974, "end": 138399, "text": "Me asaltaron en el día de mi quebranto: mas Jehová fue mi apoyo.", "words": [[0, 133974], [3, 134120], [13, 134940], [16, 135140], [19, 135280], [23, 135520], [26, 135640], [29, 135800], [40, 136778], [44, 137056], [51, 137366], [55, 137566], [58, 138005]]}, {"verse": 19, "start": 138749, "end": 142908, "text": "Y me sacó a anchura: me libró, porque se agradó de mí.", "words": [[0, 138749], [2, 138895], [5, 138995], [10, 139245], [12, 139495], [21, 140619], [24, 140726], [31, 141406], [38, 141746], [41, 141946], [48, 142426], [51, 142586]]}, {"verse": 20, "start": 143258, "end": 148875, "text": "Me ha pagado Jehová conforme a mi justicia: conforme a la limpieza de mis manos me ha vuelto.", "words": [[0, 143258], [3, 143377], [6, 143497], [13, 143877], [20, 144297], [29, 144917], [31, 144977], [34, 145077], [44, 146125], [53, 146709], [55, 146789], [58, 146849], [67, 147449], [70, 147549], [74, 147709], [80, 148009], [83, 148229], [86, 148309]]}, {"verse": 21, "start": 149225, "end": 155341, "text": "Porque yo he guardado los caminos de Jehová, y no me aparté impíamente de mi Dios.", "words": [[0, 149225], [7, 149427], [10, 149707], [13, 149827], [22, 150347], [26, 150507], [34, 150967], [37, 151147], [45, 151867], [47, 152087], [50, 152307], [53, 152527], [60, 153207], [71, 154287], [74, 154567], [77, 154687]]}, {"verse": 22, "start": 155691, "end": 161210, "text": "Pues todos sus juicios estuvieron delante de mí, y no eché de mí sus estatutos.", "words": [[0, 155691], [5, 155835], [11, 156095], [15, 156375], [23, 156795], [34, 157435], [42, 157935], [45, 158095], [49, 158335], [51, 159195], [54, 159475], [59, 159755], [62, 159915], [65, 160055], [69, 160275]]}, {"verse": 23, "start": 161560, "end": 166260, "text": "Y fui íntegro para con él, y me he guardado de mi maldad.", "words": [[0, 161560], [2, 161688], [6, 161868], [14, 162728], [19, 162968], [23, 163248], [27, 163448], [29, 164288], [32, 164508], [35, 164628], [44, 165208], [47, 165388], [50, 165548]]}, {"verse": 24, "start": 166610, "end": 173103, "text": "Me pagó pues Jehová conforme a mi justicia; conforme a la limpieza de mis manos delante de sus ojos.", "words": [[0, 166610], [3, 166718], [8, 167118], [13, 167358], [20, 167938], [29, 168228], [31, 168518], [34, 168618], [44, 169658], [53, 170202], [55, 170282], [58, 170342], [67, 171002], [70, 171122], [74, 171262], [80, 171682], [88, 172182], [91, 172322], [95, 172482]]}, {"verse": 25, "start": 173453, "end": 179811, "text": "Con el misericordioso te mostrarás misericordioso, y recto para con el hombre íntegro.", "words": [[0, 173453], [4, 173602], [7, 173722], [22, 174742], [25, 175112], [35, 175482], [51, 176522], [53, 177242], [59, 177962], [64, 178242], [68, 178462], [71, 178582], [78, 178842]]}, {"verse": 26, "start": 180161, "end": 185088, "text": "Limpio te mostrarás para con el limpio, y severo serás para con el perverso.", "words": [[0, 180161], [7, 180805], [10, 180925], [20, 181605], [25, 181825], [29, 182065], [32, 182205], [40, 182825], [42, 182925], [49, 183385], [55, 183685], [60, 183865], [64, 184105], [67, 184225]]}, {"verse": 27, "start": 185438, "end": 189832, "text": "Y tú salvarás al pueblo humilde, y humillarás los ojos altivos.", "words": [[0, 185438], [2, 185549], [5, 185689], [14, 186329], [17, 186469], [24, 186709], [33, 187389], [35, 187909], [46, 188509], [50, 188629], [55, 188909]]}, {"verse": 28, "start": 190182, "end": 195952, "text": "Tú pues alumbrarás mi lámpara: Jehová mi Dios alumbrará mis tinieblas.", "words": [[0, 190182], [3, 190816], [8, 191036], [19, 191696], [22, 191896], [31, 192863], [38, 193372], [41, 193452], [46, 194192], [56, 194812], [60, 195012]]}, {"verse": 29, "start": 196302, "end": 201243, "text": "Porque contigo desharé ejércitos; y con mi Dios asaltaré muros.", "words": [[0, 196302], [7, 196507], [15, 197067], [23, 197627], [34, 198925], [36, 199030], [40, 199190], [43, 199390], [48, 199690], [57, 200590]]}, {"verse": 30, "start": 201593, "end": 208841, "text": "Dios, perfecto su camino: es purificada la palabra de Jehová: escudo es a todos los que en él esperan.", "words": [[0, 201593], [6, 201919], [15, 202779], [18, 202899], [26, 203785], [29, 204015], [40, 204955], [43, 205135], [51, 205475], [54, 205675], [62, 206475], [69, 206959], [72, 207099], [74, 207219], [80, 207539], [84, 207779], [88, 207979], [91, 208139], [94, 208219]]}, {"verse": 31, "start": 209191, "end": 213844, "text": "Porque ¿qué Dios hay fuera de Jehová? ¿y qué fuerte fuera de nuestro Dios?", "words": [[0, 209191], [7, 209720], [12, 209973], [17, 210227], [21, 210480], [27, 210780], [30, 210940], [38, 211672], [41, 211760], [45, 211880], [52, 212360], [58, 212680], [61, 212940], [69, 213120]]}, {"verse": 32, "start": 214194, "end": 218588, "text": "Dios es el que me ciñe de fuerza, e hizo perfecto mi camino;", "words": [[0, 214194], [5, 214464], [8, 214924], [11, 215144], [15, 215304], [18, 215424], [23, 215824], [26, 215904], [34, 216264], [36, 216584], [41, 216884], [50, 217744], [53, 217844]]}, {"verse": 33, "start": 218938, "end": 224192, "text": "Quien pone mis pies como pies de ciervas, y me hizo estar sobre mis alturas;", "words": [[0, 218938], [6, 219062], [11, 219382], [15, 219602], [20, 219922], [25, 220482], [30, 220762], [33, 221162], [42, 221562], [44, 221942], [47, 222082], [52, 222362], [58, 222702], [64, 223022], [68, 223262]]}, {"verse": 34, "start": 224542, "end": 231420, "text": "Quien enseña mis manos para la batalla, y será quebrado con mis brazos el arco de acero.", "words": [[0, 224542], [6, 224748], [13, 225628], [17, 225808], [23, 226248], [28, 226668], [31, 226828], [40, 227368], [42, 228088], [47, 228308], [56, 228948], [60, 229128], [64, 229328], [71, 229968], [74, 230193], [79, 230673], [82, 230833]]}, {"verse": 35, "start": 231770, "end": 239668, "text": "Me diste asimismo el escudo de tu salvación: y tu diestra me sustentó, y tu benignidad me ha acrecentado.", "words": [[0, 232087], [3, 232437], [9, 232787], [18, 233137], [21, 233337], [28, 233797], [31, 233957], [34, 234117], [45, 235138], [47, 235240], [50, 235400], [58, 235780], [61, 235960], [71, 236640], [73, 237200], [76, 237640], [87, 238080], [90, 238400], [93, 239061]]}, {"verse": 36, "start": 240018, "end": 244510, "text": "Ensanchaste mis pasos debajo de mí, y no titubearon mis rodillas.", "words": [[0, 240018], [12, 240784], [16, 240964], [22, 241384], [29, 241764], [32, 241904], [36, 242084], [38, 242464], [41, 242644], [52, 243384], [56, 243624]]}, {"verse": 37, "start": 244860, "end": 249998, "text": "He perseguido a mis enemigos, y los alcancé, y no volví hasta acabarlos.", "words": [[0, 244860], [3, 245006], [14, 245726], [16, 245826], [20, 245926], [30, 246586], [32, 247031], [36, 247191], [45, 247991], [47, 248151], [50, 248291], [56, 248791], [62, 249031]]}, {"verse": 38, "start": 250348, "end": 254890, "text": "Los he herido, y no podrán levantarse: cayeron debajo de mis pies.", "words": [[0, 250348], [4, 250492], [7, 250812], [15, 251312], [17, 251432], [20, 251552], [27, 252032], [39, 253468], [47, 253718], [54, 254118], [57, 254258], [61, 254398]]}, {"verse": 39, "start": 255240, "end": 260762, "text": "Pues me ceñiste de fortaleza para la pelea; has agobiado mis enemigos debajo de mí.", "words": [[0, 255240], [5, 255440], [8, 255760], [16, 256080], [19, 256240], [29, 256920], [34, 257120], [37, 257300], [44, 258119], [48, 258403], [57, 259163], [61, 259323], [70, 259883], [77, 260303], [80, 260483]]}, {"verse": 40, "start": 261112, "end": 265715, "text": "Y me diste la cerviz de mis enemigos, y destruí a los que me aborrecían.", "words": [[0, 261112], [2, 261356], [5, 261496], [11, 261843], [14, 262189], [21, 262536], [24, 262636], [28, 262736], [38, 263396], [40, 263591], [48, 264211], [50, 264371], [54, 264511], [58, 264631], [61, 264771]]}, {"verse": 41, "start": 266065, "end": 270734, "text": "Clamaron, y no hubo quien salvase: aun a Jehová, pero no los oyó.", "words": [[0, 266065], [10, 266547], [12, 266767], [15, 266927], [20, 267367], [26, 267527], [35, 268666], [39, 268666], [41, 269130], [49, 269631], [54, 269794], [57, 270127], [61, 270460]]}, {"verse": 42, "start": 271084, "end": 276521, "text": "Y los molí como polvo delante del viento; los esparcí como lodo de las calles.", "words": [[0, 271084], [2, 271189], [6, 271329], [11, 271729], [16, 271929], [22, 272509], [30, 273009], [34, 273229], [42, 274119], [46, 274267], [54, 274927], [59, 275127], [64, 275487], [67, 275647], [71, 275787]]}, {"verse": 43, "start": 276871, "end": 284304, "text": "Me libraste de contiendas de pueblo: me pusiste por cabeza de las naciones: pueblo que yo no conocía, me sirvió.", "words": [[0, 276871], [3, 277052], [12, 277552], [15, 277732], [26, 278552], [29, 278652], [37, 279521], [40, 279687], [48, 280227], [52, 280467], [59, 280907], [62, 281127], [66, 281287], [76, 282329], [83, 282511], [87, 282811], [90, 282971], [93, 283321], [102, 283671], [105, 283731]]}, {"verse": 44, "start": 284654, "end": 289715, "text": "Tan pronto como oyó, me obedeció; los hijos de extraños me mintieron;", "words": [[0, 284654], [4, 284798], [11, 285178], [16, 285568], [21, 285958], [24, 286418], [34, 287424], [38, 287530], [44, 287830], [47, 287990], [56, 288670], [59, 289193]]}, {"verse": 45, "start": 290065, "end": 294466, "text": "Los extraños flaquearon, y tuvieron miedo desde sus escondites.", "words": [[0, 290065], [4, 290191], [13, 290951], [25, 291751], [27, 292011], [36, 292431], [42, 292911], [48, 293191], [52, 293471]]}, {"verse": 46, "start": 294816, "end": 301306, "text": "Viva Jehová, y sea bendita mi roca; y enaltecido sea el Dios de mi salvación:", "words": [[0, 294816], [5, 295221], [13, 295921], [15, 296101], [19, 296321], [27, 296941], [30, 297121], [36, 297971], [38, 298488], [49, 299038], [53, 299378], [56, 299798], [61, 300038], [64, 300298], [67, 300418]]}, {"verse": 47, "start": 301656, "end": 305370, "text": "El Dios que me da las venganzas, y sujetó pueblos a mí.", "words": [[0, 301656], [3, 301840], [8, 302140], [12, 302540], [15, 302680], [18, 302820], [22, 302940], [33, 303600], [35, 303960], [42, 304400], [50, 304920], [52, 305060]]}, {"verse": 48, "start": 305720, "end": 312609, "text": "Mi libertador de mis enemigos: me hiciste también superior de mis adversarios; me libraste de varón violento.", "words": [[0, 305720], [3, 305848], [14, 306468], [17, 306648], [21, 306768], [31, 307761], [34, 307888], [42, 308268], [50, 308568], [59, 309068], [62, 309348], [66, 309468], [79, 310731], [82, 311051], [91, 311371], [94, 311531], [100, 311811]]}, {"verse": 49, "start": 312959, "end": 318308, "text": "Por tanto yo te confesaré entre las naciones, oh Jehová, y cantaré a tu nombre.", "words": [[0, 312959], [4, 313084], [10, 313564], [13, 313704], [16, 313844], [26, 314584], [32, 314884], [36, 315144], [46, 315706], [49, 316267], [57, 316829], [59, 316929], [67, 317449], [69, 317589], [72, 317689]]}, {"verse": 50, "start": 318658, "end": 326939, "text": "El cual da grandes triunfos a su rey, y hace misericordia a su ungido, a David y a su descendencia, para siempre.", "words": [[0, 318658], [3, 318803], [8, 319003], [11, 319203], [19, 319503], [28, 320223], [30, 320323], [33, 320463], [38, 321218], [40, 321378], [45, 321618], [58, 322658], [60, 322878], [63, 323038], [71, 323838], [73, 324018], [79, 324298], [81, 324598], [83, 324698], [86, 324838], [100, 325858], [105, 326238]]}]}