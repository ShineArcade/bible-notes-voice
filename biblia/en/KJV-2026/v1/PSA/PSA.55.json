{"book": "PSA", "chapter": 55, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 146896, "verses": [{"verse": 1, "start": 300, "end": 5425, "text": "Give ear to my prayer, O God; and hide not yourself from my supplication.", "words": [[0, 300], [5, 440], [9, 760], [12, 1000], [15, 1180], [23, 1780], [25, 1880], [30, 2832], [34, 2978], [39, 3258], [43, 3518], [52, 4018], [57, 4278], [60, 4478]]}, {"verse": 2, "start": 5875, "end": 10626, "text": "Attend to me, and hear me: I mourn in my complaint, and make a noise;", "words": [[0, 5875], [7, 6199], [10, 6459], [14, 6659], [18, 6899], [23, 7179], [27, 7806], [29, 7928], [35, 8368], [38, 8468], [41, 8648], [52, 9168], [56, 9648], [61, 9848], [63, 9968]]}, {"verse": 3, "start": 11076, "end": 18727, "text": "Because of the voice of the enemy, because of the oppression of the wicked: for they cast iniquity upon me, and in wrath they hate me.", "words": [[0, 11076], [8, 11236], [11, 11416], [15, 11536], [21, 11756], [24, 11976], [28, 12096], [35, 12856], [43, 13216], [46, 13476], [50, 13576], [61, 14016], [64, 14236], [68, 14356], [76, 15165], [80, 15250], [85, 15390], [90, 15730], [99, 16310], [104, 16530], [108, 17150], [112, 17390], [115, 17490], [121, 17810], [126, 18110], [131, 18390]]}, {"verse": 4, "start": 19177, "end": 23866, "text": "My heart is greatly pained within me: and the terrors of death are fallen upon me.", "words": [[0, 19177], [3, 19307], [9, 19587], [12, 19727], [20, 20007], [27, 20547], [34, 20767], [38, 21433], [42, 21540], [46, 21660], [54, 22140], [57, 22240], [63, 22520], [67, 22680], [74, 23040], [79, 23260]]}, {"verse": 5, "start": 24316, "end": 28675, "text": "Fearfulness and trembling are come upon me, and horror has overwhelmed me.", "words": [[0, 24316], [12, 24785], [16, 25065], [26, 25445], [30, 25705], [35, 25885], [40, 26185], [44, 26885], [48, 26965], [55, 27325], [59, 27625], [71, 28065]]}, {"verse": 6, "start": 29125, "end": 34540, "text": "And I said, Oh that I had wings like a dove! for then would I fly away, and be at rest.", "words": [[0, 29125], [4, 29229], [6, 29369], [12, 29689], [15, 30109], [20, 30209], [22, 30349], [26, 30509], [32, 30789], [37, 31089], [39, 31209], [45, 32078], [49, 32167], [54, 32367], [60, 32567], [62, 32707], [66, 32947], [72, 33367], [76, 33647], [79, 33847], [82, 33947]]}, {"verse": 7, "start": 34990, "end": 39236, "text": "Lo, then would I wander far off, and remain in the wilderness. Selah.", "words": [[0, 34990], [4, 35159], [9, 35439], [15, 35639], [17, 35759], [24, 36099], [28, 36419], [33, 36799], [37, 37039], [44, 37319], [47, 37499], [51, 37579], [63, 38931]]}, {"verse": 8, "start": 39686, "end": 43017, "text": "I would hasten my escape from the windy storm and tempest.", "words": [[0, 39686], [2, 39995], [8, 40155], [15, 40535], [18, 40715], [25, 41055], [30, 41275], [34, 41415], [40, 41655], [46, 42155], [50, 42335]]}, {"verse": 9, "start": 43467, "end": 49219, "text": "Destroy, O Lord, and divide their tongues: for I have seen violence and strife in the city.", "words": [[0, 43467], [9, 44213], [11, 44353], [17, 45013], [21, 45093], [28, 45453], [34, 45693], [43, 46688], [47, 46790], [49, 46970], [54, 47110], [59, 47330], [68, 47810], [72, 48090], [79, 48550], [82, 48650], [86, 48750]]}, {"verse": 10, "start": 49669, "end": 55519, "text": "Day and night they go about it upon the walls of it: mischief also and sorrow are in the midst of it.", "words": [[0, 49669], [4, 49875], [8, 50055], [14, 50295], [19, 50475], [22, 50695], [28, 50935], [31, 51115], [36, 51295], [40, 51535], [46, 51775], [49, 52015], [53, 52538], [62, 53049], [67, 53769], [71, 53869], [78, 54509], [82, 54609], [85, 54789], [89, 54869], [95, 55069], [98, 55289]]}, {"verse": 11, "start": 55969, "end": 60652, "text": "Wickedness is in the midst of it: deceit and guile depart not from her streets.", "words": [[0, 56275], [11, 56595], [14, 56755], [17, 56915], [21, 57035], [27, 57235], [30, 57435], [34, 57961], [41, 58458], [45, 58598], [51, 59018], [58, 59318], [62, 59638], [67, 59898], [71, 60038]]}, {"verse": 12, "start": 61102, "end": 72608, "text": "For it was not an enemy that reproached me; then I could have borne it: neither was it he that hated me that did magnify himself against me; then I would have hid myself from him:", "words": [[0, 61102], [4, 61244], [7, 61364], [11, 61524], [15, 61724], [18, 61864], [24, 62224], [29, 62504], [40, 63084], [44, 64840], [49, 65000], [51, 65140], [57, 65280], [62, 65400], [68, 65800], [72, 66331], [80, 66541], [84, 66861], [87, 67001], [90, 67241], [95, 67521], [101, 67801], [104, 68081], [109, 68281], [113, 68421], [121, 69041], [129, 69321], [137, 69801], [141, 70641], [146, 70768], [148, 70908], [154, 71068], [159, 71188], [163, 71348], [170, 71788], [175, 72088]]}, {"verse": 13, "start": 73058, "end": 77892, "text": "But it was you, a man my equal, my guide, and my acquaintance.", "words": [[0, 73058], [4, 73171], [7, 73251], [11, 73451], [16, 74331], [18, 74491], [22, 74751], [25, 74991], [32, 75891], [35, 76011], [42, 76731], [46, 76831], [49, 77031]]}, {"verse": 14, "start": 78342, "end": 83048, "text": "We took sweet counsel together, and walked to the house of God in company.", "words": [[0, 78342], [3, 78584], [8, 78784], [14, 79104], [22, 79544], [32, 80024], [36, 80724], [43, 81004], [46, 81324], [50, 81444], [56, 81664], [59, 81864], [63, 82184], [66, 82384]]}, {"verse": 15, "start": 83498, "end": 91004, "text": "Let death seize upon them, and let them go down alive into hell: for wickedness is in their dwellings, and among them.", "words": [[0, 83498], [4, 83702], [10, 84162], [16, 84542], [21, 84922], [27, 85522], [31, 85742], [35, 85882], [40, 86062], [43, 86282], [48, 86542], [54, 87042], [59, 87342], [65, 88115], [69, 88245], [80, 88905], [83, 89165], [86, 89325], [92, 89465], [103, 90085], [107, 90345], [113, 90585]]}, {"verse": 16, "start": 91454, "end": 95952, "text": "As for me, I will call upon God; and the LORD shall save me.", "words": [[0, 91454], [3, 91815], [7, 92035], [11, 92655], [13, 92795], [18, 92955], [23, 93155], [28, 93475], [33, 94426], [37, 94571], [41, 94691], [46, 94971], [52, 95251], [57, 95591]]}, {"verse": 17, "start": 96402, "end": 102451, "text": "Evening, and morning, and at noon, will I pray, and cry aloud: and he shall hear my voice.", "words": [[0, 96402], [9, 96846], [13, 96946], [22, 97266], [26, 97806], [29, 97946], [35, 98266], [40, 98686], [42, 98866], [48, 99246], [52, 99666], [56, 99966], [63, 100908], [67, 101029], [70, 101189], [76, 101389], [81, 101629], [84, 101849]]}, {"verse": 18, "start": 102901, "end": 108117, "text": "He has delivered my soul in peace from the battle that was against me: for there were many with me.", "words": [[0, 102901], [3, 103008], [7, 103188], [17, 103548], [20, 103828], [25, 104188], [28, 104388], [34, 104668], [39, 104948], [43, 105108], [50, 105408], [55, 105588], [59, 105748], [67, 106008], [71, 106751], [75, 106859], [81, 107039], [86, 107199], [91, 107499], [96, 107759]]}, {"verse": 19, "start": 108567, "end": 116764, "text": "God shall hear, and afflict them, even he that abides of old. Selah. Because they have no changes, therefore they fear not God.", "words": [[0, 108567], [4, 108771], [10, 109091], [16, 109391], [20, 109571], [28, 109831], [34, 110231], [39, 110411], [42, 110691], [47, 110871], [54, 111291], [57, 111451], [62, 112568], [69, 113168], [77, 113433], [82, 113693], [87, 113893], [90, 114033], [99, 114893], [109, 115353], [114, 115693], [119, 115973], [123, 116193]]}, {"verse": 20, "start": 117214, "end": 122635, "text": "He has put forth his hands against such as be at peace with him: he has broken his covenant.", "words": [[0, 117214], [3, 117323], [7, 117503], [11, 117723], [17, 118023], [21, 118223], [27, 118563], [35, 118843], [40, 119203], [43, 119383], [46, 119583], [49, 119743], [55, 119963], [60, 120243], [65, 120877], [68, 121177], [72, 121377], [79, 121737], [83, 121997]]}, {"verse": 21, "start": 123085, "end": 131018, "text": "The words of his mouth were smoother than butter, but war was in his heart: his words were softer than oil, yet were they drawn swords.", "words": [[0, 123085], [4, 123159], [10, 123419], [13, 123559], [17, 123679], [23, 123939], [28, 124119], [37, 124559], [42, 124839], [50, 125599], [54, 125739], [58, 126079], [62, 126359], [65, 126519], [69, 126679], [76, 127416], [80, 127543], [86, 127823], [91, 128043], [98, 128463], [103, 128703], [108, 129383], [112, 129543], [117, 129723], [122, 129863], [128, 130203]]}, {"verse": 22, "start": 131468, "end": 137277, "text": "Cast your burden upon the LORD, and he shall sustain you: he shall never permit the righteous to be moved.", "words": [[0, 131468], [5, 131660], [10, 131800], [17, 132080], [22, 132340], [26, 132580], [32, 133219], [36, 133320], [39, 133560], [45, 133800], [53, 134200], [58, 134938], [61, 135044], [67, 135224], [73, 135524], [80, 135884], [84, 136084], [94, 136384], [97, 136624], [100, 136744]]}, {"verse": 23, "start": 137727, "end": 146496, "text": "But you, O God, shall bring them down into the pit of destruction: bloody and deceitful men shall not live out half their days; but I will trust in you.", "words": [[0, 137727], [4, 138036], [9, 138396], [11, 138436], [16, 138956], [22, 139076], [28, 139316], [33, 139516], [38, 139776], [43, 139976], [47, 140156], [51, 140316], [54, 140416], [67, 141481], [74, 141827], [78, 142127], [88, 142707], [92, 143007], [98, 143287], [102, 143527], [107, 143747], [111, 143947], [116, 144207], [122, 144407], [128, 145297], [132, 145413], [134, 145513], [139, 145673], [145, 145933], [148, 146213]]}]}