{"book": "ACT", "chapter": 28, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 294664, "verses": [{"verse": 1, "start": 300, "end": 5004, "text": "Y cuando escapamos, entonces supimos que la isla se llamaba Malta.", "words": [[0, 300], [2, 401], [9, 581], [20, 1221], [29, 1801], [37, 2556], [41, 2756], [44, 2916], [49, 3336], [52, 3736], [60, 4196]]}, {"verse": 2, "start": 5354, "end": 17119, "text": "Y los habitantes de la isla nos mostraron no poca humanidad; porque, encendido un fuego, nos recibieron a todos, a causa de la lluvia que venía, y del frío.", "words": [[0, 5354], [2, 5460], [6, 5580], [17, 6280], [20, 6440], [23, 6580], [28, 7000], [32, 7420], [42, 8180], [45, 8560], [50, 9020], [61, 10130], [69, 10375], [79, 11355], [82, 11555], [89, 12035], [93, 12340], [104, 13080], [106, 13220], [113, 13640], [115, 14200], [121, 14520], [124, 14740], [127, 14860], [134, 15240], [138, 15360], [145, 15880], [147, 16340], [151, 16500]]}, {"verse": 3, "start": 17469, "end": 27885, "text": "Entonces habiendo Pablo recogido algunas ramas, y habiéndolas puesto en el fuego, una víbora, huyendo del calor, le acometió a la mano.", "words": [[0, 17469], [9, 18071], [18, 18431], [24, 18851], [33, 19631], [41, 19931], [48, 20991], [50, 21351], [62, 21831], [69, 22331], [72, 22651], [75, 22771], [82, 23591], [86, 23751], [94, 24611], [102, 25051], [106, 25291], [113, 26111], [116, 26251], [125, 27011], [127, 27211], [130, 27291]]}, {"verse": 4, "start": 28235, "end": 41858, "text": "Y como los habitantes de la isla vieron la víbora colgando de su mano, decían los unos a los otros: Ciertamente este hombre es homicida, a quien, escapado del mar, la justicia no deja vivir.", "words": [[0, 28235], [2, 28359], [7, 28599], [11, 28759], [22, 29399], [25, 29559], [28, 29699], [33, 30059], [40, 30379], [43, 30579], [50, 31119], [59, 31659], [62, 31879], [65, 32059], [71, 32714], [78, 33314], [82, 33534], [87, 33874], [89, 34234], [93, 34434], [100, 35333], [112, 36067], [117, 36447], [124, 36827], [127, 37187], [137, 38187], [139, 38267], [146, 38807], [155, 39327], [159, 39527], [164, 40187], [167, 40267], [176, 40827], [179, 41047], [184, 41307]]}, {"verse": 5, "start": 42138, "end": 46377, "text": "Pero él, sacudiendo la víbora en el fuego, ningún mal padeció.", "words": [[0, 42138], [5, 42305], [9, 42925], [20, 43565], [23, 43745], [30, 44165], [33, 44305], [36, 44445], [43, 45005], [50, 45305], [54, 45665]]}, {"verse": 6, "start": 46727, "end": 59359, "text": "Pero ellos estaban esperando cuándo se había de hinchar, o caer muerto de repente; pero habiendo esperado mucho, y viendo que ningún mal le venía, cambiando de parecer, decían que era un dios.", "words": [[0, 46727], [5, 46874], [11, 47274], [19, 47994], [29, 48454], [36, 48794], [39, 49034], [45, 49234], [48, 49394], [57, 49914], [59, 50394], [64, 50734], [71, 51214], [74, 51374], [83, 52331], [88, 52473], [97, 52853], [106, 53293], [113, 53593], [115, 53733], [122, 53973], [126, 54133], [133, 54473], [137, 54913], [140, 55113], [147, 56093], [157, 56693], [160, 56853], [169, 57753], [176, 58313], [180, 58513], [184, 58653], [187, 58813]]}, {"verse": 7, "start": 59709, "end": 69340, "text": "En aquellos lugares había propiedades del principal de la isla, llamado Publio, el cual nos recibió y hospedó tres días con amabilidad.", "words": [[0, 59709], [3, 59833], [12, 60073], [20, 60613], [26, 60953], [38, 61693], [42, 61913], [52, 62433], [55, 62733], [58, 62873], [64, 63533], [72, 63933], [80, 65073], [83, 65173], [88, 65393], [92, 65633], [100, 66356], [102, 66478], [110, 66938], [115, 67258], [120, 67698], [124, 68058]]}, {"verse": 8, "start": 69690, "end": 81870, "text": "Y aconteció que el padre de Publio estaba en cama, enfermo de fiebres y de disentería: al cual Pablo entró, y después de haber orado, le puso las manos encima, y le sanó:", "words": [[0, 69690], [2, 69794], [12, 70494], [16, 70674], [19, 70814], [25, 71114], [28, 71394], [35, 71674], [42, 71934], [45, 72154], [51, 73014], [59, 73554], [62, 73674], [70, 74154], [72, 74334], [75, 74454], [87, 75659], [90, 75947], [95, 76107], [101, 76587], [108, 77287], [110, 77567], [118, 77867], [121, 78067], [127, 78247], [134, 78727], [137, 79147], [142, 79467], [146, 79627], [152, 79907], [160, 80567], [162, 81010], [165, 81453]]}, {"verse": 9, "start": 82220, "end": 88540, "text": "Y esto hecho, también los otros que en la isla tenían enfermedades, llegaban, y eran sanados:", "words": [[0, 82220], [2, 82356], [7, 82636], [14, 83056], [22, 83376], [26, 83636], [32, 83956], [36, 84196], [39, 84336], [42, 84476], [47, 84796], [54, 85136], [68, 86136], [78, 87016], [80, 87556], [85, 87756]]}, {"verse": 10, "start": 88890, "end": 96058, "text": "Los cuales también nos honraron con muchos obsequios; y cuando partimos, nos cargaron de las cosas necesarias.", "words": [[0, 88890], [4, 88995], [11, 89175], [19, 89535], [23, 90075], [32, 90615], [36, 90775], [43, 91135], [54, 92249], [56, 92469], [63, 92669], [73, 93649], [77, 93829], [86, 94389], [89, 94509], [93, 94649], [99, 94949]]}, {"verse": 11, "start": 96408, "end": 107072, "text": "Así que, pasados tres meses, navegamos en una nave alejandrina que había invernado en la isla, la cual tenía como emblema a Cástor y Pólux.", "words": [[0, 96408], [4, 96669], [9, 96949], [17, 97429], [22, 97709], [29, 98629], [39, 99209], [42, 99429], [46, 99609], [51, 99949], [63, 100949], [67, 101149], [73, 101469], [83, 102389], [86, 102509], [89, 102669], [95, 103509], [98, 103649], [103, 103849], [109, 104289], [114, 104569], [122, 105269], [124, 105429], [131, 106089], [133, 106618]]}, {"verse": 12, "start": 107422, "end": 111613, "text": "Y llegados a Siracusa, estuvimos allí tres días.", "words": [[0, 107422], [2, 107726], [11, 108226], [13, 108426], [23, 109666], [33, 110386], [38, 110606], [43, 110906]]}, {"verse": 13, "start": 111963, "end": 121277, "text": "De allí, costeando alrededor, vinimos a Regio; y otro día después, soplando el sur, vinimos al segundo día a Puteoli:", "words": [[0, 111963], [3, 112107], [9, 112567], [19, 113167], [30, 114067], [38, 114377], [40, 114687], [47, 115578], [49, 115722], [54, 115902], [58, 116222], [67, 117082], [76, 117662], [79, 117822], [84, 118482], [92, 119142], [95, 119362], [103, 119702], [107, 120142], [109, 120741]]}, {"verse": 14, "start": 121627, "end": 129297, "text": "Donde habiendo hallado hermanos, nos rogaron que quedásemos con ellos siete días; y luego vinimos a Roma;", "words": [[0, 121627], [6, 121872], [15, 122572], [23, 123032], [33, 123652], [37, 124172], [45, 124972], [49, 125132], [60, 125792], [64, 126012], [70, 126212], [76, 126612], [82, 127640], [84, 127765], [90, 127985], [98, 128565], [100, 128705]]}, {"verse": 15, "start": 129647, "end": 142345, "text": "De donde, oyendo de nosotros los hermanos, nos salieron a recibir hasta la plaza de Apio, y Las Tres Tabernas: a los cuales como Pablo vio, dio gracias a Dios, y tomó aliento.", "words": [[0, 129647], [3, 129810], [10, 130510], [17, 131130], [20, 131310], [29, 131790], [33, 132050], [43, 132930], [47, 133010], [56, 133510], [58, 133650], [66, 134070], [72, 134350], [75, 134470], [81, 134770], [84, 134930], [90, 135270], [92, 135630], [96, 135770], [101, 135970], [111, 137079], [113, 137171], [117, 137291], [124, 137791], [129, 137911], [135, 138311], [140, 139351], [144, 139631], [152, 140071], [154, 140411], [160, 140671], [162, 141191], [167, 141571]]}, {"verse": 16, "start": 142695, "end": 154125, "text": "Y como llegamos a Roma, el centurión entregó los presos al prefecto de los ejércitos, pero a Pablo fue permitido estar por sí, con un soldado que le guardase.", "words": [[0, 142695], [2, 142821], [7, 143041], [16, 143561], [18, 143741], [24, 144566], [27, 144706], [37, 145406], [45, 146086], [49, 146226], [56, 146826], [59, 147066], [68, 147786], [71, 147886], [75, 148026], [86, 149066], [91, 149306], [93, 149466], [99, 149846], [103, 150406], [113, 151046], [119, 151266], [123, 151626], [127, 151946], [131, 152466], [134, 152606], [142, 153126], [146, 153246], [149, 153366]]}, {"verse": 17, "start": 154475, "end": 172991, "text": "Y aconteció que tres días después, Pablo convocó a los principales de los judíos; a los cuales, luego que estuvieron juntos, les dijo: Yo, varones hermanos, no habiendo hecho nada contra el pueblo, ni contra los ritos de la patria, he sido entregado preso desde Jerusalén en manos de los Romanos;", "words": [[0, 154475], [2, 154580], [12, 155300], [16, 155460], [21, 155720], [26, 156040], [35, 156480], [41, 157380], [49, 158140], [51, 158260], [55, 158360], [67, 159060], [70, 159180], [74, 159300], [82, 160226], [84, 160466], [88, 160566], [96, 160926], [102, 161371], [106, 161671], [117, 162151], [125, 162771], [129, 162951], [135, 163637], [139, 163820], [147, 164240], [157, 165080], [160, 165180], [169, 165540], [175, 165800], [180, 166080], [187, 166440], [190, 166600], [198, 167300], [201, 167460], [208, 167780], [212, 167960], [218, 168360], [221, 168460], [224, 168560], [232, 169380], [235, 169460], [240, 169660], [250, 170200], [256, 170660], [262, 170800], [272, 171580], [275, 171760], [281, 171980], [284, 172180], [288, 172260]]}, {"verse": 18, "start": 173341, "end": 179439, "text": "Los cuales, habiéndome examinado, me querían soltar, por no haber en mí ninguna causa de muerte.", "words": [[0, 173341], [4, 173446], [12, 174046], [23, 174566], [34, 175626], [37, 175706], [45, 176176], [53, 176646], [57, 176926], [60, 177106], [66, 177366], [69, 177546], [72, 177726], [80, 178246], [86, 178706], [89, 178926]]}, {"verse": 19, "start": 179789, "end": 185438, "text": "Pero contradiciendo los judíos, fui forzado a apelar a César; no que tenga de qué acusar a mi nación.", "words": [[0, 179789], [5, 179929], [20, 180669], [24, 180849], [32, 181569], [36, 181769], [44, 182309], [46, 182429], [53, 182749], [55, 182829], [62, 183476], [65, 183614], [69, 183754], [75, 183994], [78, 184134], [82, 184294], [89, 184714], [91, 184794], [94, 184854]]}, {"verse": 20, "start": 185788, "end": 192517, "text": "Así que, por esta causa, os he llamado para veros y hablaros; porque por la esperanza de Israel estoy rodeado de esta cadena.", "words": [[0, 185788], [4, 185970], [9, 186110], [13, 186290], [18, 186450], [25, 186870], [28, 187190], [31, 187410], [39, 187670], [44, 187970], [50, 188330], [52, 188450], [62, 189271], [69, 189454], [73, 189654], [76, 189754], [86, 190174], [89, 190294], [96, 190674], [102, 190974], [110, 191514], [113, 191714], [118, 191914]]}, {"verse": 21, "start": 192797, "end": 203009, "text": "Entonces ellos le dijeron: Nosotros ni hemos recibido cartas tocante a ti de Judea, ni ha venido alguno de los hermanos que haya denunciado o hablado algún mal de ti.", "words": [[0, 192797], [9, 193275], [15, 194055], [18, 194515], [27, 195463], [36, 195867], [39, 196067], [45, 196227], [54, 196867], [61, 197287], [69, 197687], [71, 197827], [74, 197907], [77, 198027], [84, 198627], [87, 199027], [90, 199127], [97, 199427], [104, 199807], [107, 199867], [111, 199987], [120, 200507], [124, 200627], [129, 200827], [140, 201547], [142, 201687], [150, 202087], [156, 202347], [160, 202567], [163, 202727]]}, {"verse": 22, "start": 203359, "end": 209298, "text": "Pero querríamos oír de ti lo que piensas; porque sabemos que en todas partes se habla contra esta secta.", "words": [[0, 203359], [5, 203726], [16, 204206], [20, 204566], [23, 204666], [26, 204846], [29, 204966], [33, 205086], [42, 206007], [49, 206217], [57, 206637], [61, 206957], [64, 207077], [70, 207237], [77, 207757], [80, 207997], [86, 208177], [93, 208497], [98, 208757]]}, {"verse": 23, "start": 209578, "end": 227376, "text": "Y habiéndole señalado un día, vinieron a él muchos a la posada, a los cuales declaraba y testificaba el reino de Dios, persuadiéndoles lo concerniente a Jesús, por la ley de Moisés y por los profetas, desde la mañana hasta la tarde.", "words": [[0, 209578], [2, 209697], [13, 210217], [22, 210857], [25, 211017], [30, 211857], [39, 212437], [41, 212597], [44, 212737], [51, 213077], [53, 213337], [56, 213417], [64, 213977], [66, 214197], [70, 214297], [77, 214597], [87, 215797], [89, 215937], [101, 216717], [104, 216877], [110, 217257], [113, 217397], [119, 218077], [135, 219197], [138, 219847], [151, 220497], [153, 220657], [160, 221498], [164, 221642], [167, 221802], [171, 222082], [174, 222222], [181, 222742], [183, 223302], [187, 223502], [191, 223662], [201, 224842], [207, 225402], [210, 225722], [217, 226122], [223, 226542], [226, 226742]]}, {"verse": 24, "start": 227726, "end": 232866, "text": "Y algunos asentían a lo que se decía, pero algunos no creían.", "words": [[0, 227726], [2, 227966], [10, 228286], [19, 229186], [21, 229426], [24, 229526], [28, 229646], [31, 229786], [38, 230746], [43, 230986], [51, 231486], [54, 232126]]}, {"verse": 25, "start": 233216, "end": 243593, "text": "Y como fueron entre sí discordes, se fueron, diciendo Pablo esta palabra: Bien ha hablado el Espíritu Santo por el profeta Isaías a nuestros padres,", "words": [[0, 233216], [2, 233340], [7, 233600], [14, 234000], [20, 234380], [23, 234700], [34, 235700], [37, 236140], [45, 237080], [54, 237540], [60, 238160], [65, 238440], [74, 239343], [79, 239559], [82, 239739], [90, 240119], [93, 240239], [102, 240759], [108, 241039], [112, 241319], [115, 241439], [123, 241879], [130, 242399], [132, 242579], [141, 242699]]}, {"verse": 26, "start": 243943, "end": 253226, "text": "Diciendo: Ve a este pueblo, y diles: De oído oiréis, y no entenderéis; y viendo veréis, y no percibiréis:", "words": [[0, 243943], [10, 244822], [13, 245002], [15, 245182], [20, 245462], [28, 245842], [30, 246342], [37, 247482], [40, 247644], [45, 248204], [53, 248764], [55, 249144], [58, 249324], [71, 250607], [73, 250725], [80, 251065], [88, 251545], [90, 251845], [93, 252005]]}, {"verse": 27, "start": 253446, "end": 266720, "text": "Porque el corazón de este pueblo se ha vuelto insensible, y de los oídos oyeron pesadamente, y sus ojos taparon; porque no vean con los ojos, y oigan con los oídos, y entiendan de corazón, y se conviertan, y yo los sane.", "words": [[0, 253446], [7, 253626], [10, 253746], [18, 254126], [21, 254326], [26, 254466], [33, 254846], [36, 255086], [39, 255166], [46, 255466], [58, 256146], [60, 256381], [63, 256481], [67, 256601], [73, 257061], [80, 257421], [93, 258401], [95, 258661], [99, 258801], [104, 259061], [113, 259977], [120, 260165], [123, 260385], [128, 260645], [132, 260785], [136, 260925], [142, 261285], [144, 261845], [150, 262125], [154, 262345], [158, 262505], [165, 263285], [167, 263445], [177, 263965], [180, 264085], [189, 264525], [191, 264770], [194, 264910], [206, 265650], [208, 265950], [211, 266090], [215, 266230]]}, {"verse": 28, "start": 267070, "end": 272772, "text": "Os sea pues notorio que a los Gentiles es enviada esta salvación de Dios: y ellos oirán.", "words": [[0, 267104], [3, 267174], [7, 267394], [12, 267594], [20, 268134], [24, 268294], [26, 268394], [30, 268474], [39, 269034], [42, 269334], [50, 269874], [55, 270174], [65, 270774], [68, 270914], [74, 271640], [76, 271782], [82, 272002]]}, {"verse": 29, "start": 273052, "end": 279066, "text": "Y habiendo dicho esto, los judíos salieron, teniendo entre sí gran contienda.", "words": [[0, 273052], [2, 273175], [11, 273595], [17, 273915], [23, 274895], [27, 275035], [34, 275615], [44, 276690], [53, 277210], [59, 277490], [62, 277770], [67, 278070]]}, {"verse": 30, "start": 279416, "end": 285526, "text": "Pablo quedó dos años enteros en su casa de alquiler, y recibía a todos los que a él venían,", "words": [[0, 279416], [6, 279827], [12, 280227], [16, 280487], [21, 280747], [29, 281407], [32, 281567], [35, 281707], [40, 281967], [43, 282187], [53, 282667], [55, 283047], [63, 283687], [65, 283887], [71, 284147], [75, 284407], [79, 284607], [81, 284687], [84, 284807]]}, {"verse": 31, "start": 285876, "end": 294264, "text": "Predicando el reino de Dios y enseñando lo que es del Señor Jesucristo con toda libertad, sin impedimento.", "words": [[0, 285876], [11, 286540], [14, 286680], [20, 287060], [23, 287200], [28, 287580], [30, 288100], [40, 288800], [43, 288980], [47, 289160], [50, 289340], [54, 289480], [60, 289780], [71, 290700], [75, 290940], [80, 291200], [90, 292360], [94, 292780]]}]}