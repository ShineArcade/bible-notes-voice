ve years:", "words": [[0, 119676], [4, 119794], [8, 119974], [12, 120114], [17, 120374], [20, 120554], [26, 120854], [31, 121037], [37, 121221], [45, 121404], [51, 121587], [55, 121771], [60, 121954]]}, {"verse": 24, "start": 123479, "end": 127633, "text": "And Enoch walked with God: and he was not; for God took him.", "words": [[0, 123479], [4, 123733], [10, 124023], [17, 124383], [22, 124663], [27, 125469], [31, 125613], [34, 125733], [38, 125913], [43, 126591], [47, 126714], [51, 127014], [56, 127294]]}, {"verse": 25, "start": 127983, "end": 132343, "text": "And Methuselah lived a hundred eighty and seven years, and begot Lamech:", "words": [[0, 127983], [4, 128367], [15, 128787], [21, 129050], [23, 129314], [31, 129577], [38, 129840], [42, 130104], [48, 130367], [55, 130847], [59, 131212], [65, 131632]]}, {"verse": 26, "start": 132693, "end": 139451, "text": "And Methuselah lived after he begot Lamech seven hundred eighty and two years, and begot sons and daughters:", "words": [[0, 132693], [4, 132995], [15, 133415], [21, 133835], [27, 134155], [30, 134335], [36, 134698], [43, 135062], [49, 135425], [57, 135788], [64, 136152], [68, 136515], [72, 136795], [79, 137775], [83, 137855], [89, 138215], [94, 138495], [98, 138775]]}, {"verse": 27, "start": 139801, "end": 144938, "text": "And all the days of Methuselah were nine hundred sixty and nine years: and he died.", "words": [[0, 139801], [4, 139945], [8, 140125], [12, 140245], [17, 140505], [20, 140665], [31, 141465], [36, 141760], [41, 142055], [49, 142350], [55, 142645], [59, 142955], [64, 143265], [71, 144141], [75, 144266], [78, 144406]]}, {"verse": 28, "start": 145288, "end": 148801, "text": "¶ And Lamech lived a hundred eighty and two years, and begot a son:", "words": [[2, 145288], [6, 145454], [13, 145854], [19, 146086], [21, 146318], [29, 146550], [36, 146782], [40, 147014], [44, 147214], [51, 147534], [55, 147914], [61, 148274], [63, 148374]]}, {"verse": 29, "start": 149151, "end": 157105, "text": "And h