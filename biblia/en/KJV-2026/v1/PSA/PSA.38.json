{"book": "PSA", "chapter": 38, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 122142, "verses": [{"verse": 1, "start": 300, "end": 5273, "text": "O LORD, rebuke me not in your wrath: neither chasten me in your hot displeasure.", "words": [[0, 300], [2, 423], [8, 863], [15, 1303], [18, 1423], [22, 1683], [25, 1863], [30, 1983], [37, 2806], [45, 3240], [53, 3710], [56, 3890], [59, 4010], [64, 4150], [68, 4450]]}, {"verse": 2, "start": 5723, "end": 9326, "text": "For your arrows stick fast in me, and your hand presses me down.", "words": [[0, 5723], [4, 5823], [9, 5963], [16, 6343], [22, 6683], [27, 7043], [30, 7303], [34, 7483], [38, 7823], [43, 7943], [48, 8223], [56, 8563], [59, 8823]]}, {"verse": 3, "start": 9776, "end": 16757, "text": "There is no soundness in my flesh because of your anger; neither is there any rest in my bones because of my sin.", "words": [[0, 9776], [6, 9927], [9, 10087], [12, 10327], [22, 10907], [25, 11107], [28, 11267], [34, 11607], [42, 12007], [45, 12247], [50, 12367], [57, 13245], [65, 13487], [68, 13747], [74, 13927], [78, 14207], [83, 14567], [86, 14787], [89, 14967], [95, 15347], [103, 15727], [106, 15967], [109, 16147]]}, {"verse": 4, "start": 17207, "end": 22349, "text": "For my iniquities are gone over my head: as a heavy burden they are too heavy for me.", "words": [[0, 17207], [4, 17332], [7, 17552], [18, 18192], [22, 18352], [27, 18592], [32, 18852], [35, 19112], [41, 19911], [44, 20074], [46, 20194], [52, 20454], [59, 20874], [64, 21134], [68, 21274], [72, 21454], [78, 21734], [82, 22054]]}, {"verse": 5, "start": 22799, "end": 25934, "text": "My wounds stink and are corrupt because of my foolishness.", "words": [[0, 22799], [3, 22928], [10, 23228], [16, 23648], [20, 23908], [24, 24008], [32, 24368], [40, 24728], [43, 24948], [46, 25088]]}, {"verse": 6, "start": 26384, "end": 31565, "text": "I am troubled; I am bowed down greatly; I go mourning all the day long.", "words": [[0, 26384], [2, 266