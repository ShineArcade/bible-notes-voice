], [7, 117500], [16, 117860], [20, 118060], [25, 118380], [29, 118660], [34, 118900], [37, 119100], [42, 119677], [47, 119798], [52, 120038], [55, 120178], [59, 120258], [64, 120438], [67, 120598], [71, 120778], [78, 120978], [83, 121158], [87, 121238], [90, 121358], [96, 121558]]}, {"verse": 19, "start": 122270, "end": 127691, "text": "Jesus answered and said to them, Destroy this temple, and in three days I will raise it up.", "words": [[0, 122270], [6, 122535], [15, 123055], [19, 123275], [24, 123475], [27, 123655], [33, 124324], [41, 124723], [46, 125043], [54, 125603], [58, 125723], [61, 125843], [67, 126063], [72, 126423], [74, 126763], [79, 126923], [85, 127183], [88, 127343]]}, {"verse": 20, "start": 127971, "end": 133777, "text": "Then said the Jews, Forty and six years was this temple in building, and will you rear it up in three days?", "words": [[0, 127971], [5, 128181], [10, 128421], [14, 128581], [20, 129352], [26, 129417], [30, 129482], [34, 129547], [40, 130167], [44, 130407], [49, 130627], [56, 130947], [59, 131127], [69, 131827], [73, 131927], [78, 132087], [82, 132247], [87, 132547], [90, 132727], [93, 132847], [96, 132987], [102, 133227]]}, {"verse": 21, "start": 134057, "end": 136116, "text": "But he spoke of the temple of his body.", "words": [[0, 134057], [4, 134175], [7, 134275], [13, 134535], [16, 134795], [20, 134915], [27, 135215], [30, 135435], [34, 135555]]}, {"verse": 22, "start": 136466, "end": 146061, "text": "When therefore he was risen from the dead, his disciples remembered that he had said this to them; and they believed the scripture, and the word which Jesus had said.", "words": [[0, 136466], [5, 136649], [15, 137269], [18, 137389], [22, 137589], [28, 137929], [33, 138209], [37, 138389], [43, 139049], [47, 139229], [57, 139749], [68, 140209], [73, 140589], [76, 140729], [80, 140909], [85, 141109], [90, 141409], [93, 141609], [99, 142426], [103, 142568], [108, 142668], [117, 143028], [121, 143248], [132, 143668], [136, 144308], [