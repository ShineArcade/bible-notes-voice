{"book": "GEN", "chapter": 38, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 274154, "verses": [{"verse": 1, "start": 300, "end": 9094, "text": "Y aconteció en aquel tiempo, que Judá se apartó de sus hermanos, y se fue a un varón adulamita, que se llamaba Hira.", "words": [[0, 300], [2, 682], [12, 1102], [15, 1242], [21, 1542], [29, 1962], [33, 2310], [38, 2657], [41, 2957], [48, 3417], [51, 3537], [55, 3697], [65, 4617], [67, 4817], [70, 4957], [74, 5197], [76, 5457], [79, 5677], [85, 6117], [96, 6957], [100, 7477], [103, 7617], [111, 8371]]}, {"verse": 2, "start": 9444, "end": 17343, "text": "Y vio allí Judá la hija de un hombre cananeo, el cual se llamaba Súa; y la tomó, y entró a ella:", "words": [[0, 9444], [2, 9565], [6, 9865], [11, 10255], [16, 10645], [19, 10875], [24, 11105], [27, 11265], [30, 11425], [37, 11705], [46, 12885], [49, 12965], [54, 13185], [57, 13425], [65, 13905], [70, 14849], [72, 15012], [75, 15092], [81, 15592], [83, 16212], [89, 16712], [91, 16812]]}, {"verse": 3, "start": 17693, "end": 21780, "text": "La cual concibió, y parió un hijo; y llamó su nombre Er.", "words": [[0, 17693], [3, 17817], [8, 17977], [18, 18797], [20, 18937], [26, 19317], [29, 19617], [35, 20158], [37, 20438], [43, 20758], [46, 20898], [53, 21366]]}, {"verse": 4, "start": 22130, "end": 26907, "text": "Y concibió otra vez, y parió un hijo, y llamó su nombre Onán.", "words": [[0, 22130], [2, 22257], [11, 22917], [16, 23197], [21, 23657], [23, 23912], [29, 24292], [32, 24512], [38, 24792], [40, 25107], [46, 25427], [49, 25607], [56, 26287]]}, {"verse": 5, "start": 27257, "end": 33762, "text": "Y volvió a concebir, y parió un hijo, y llamó su nombre Sela. Y estaba en Quezib cuando lo parió.", "words": [[0, 27257], [2, 27387], [9, 27767], [11, 27847], [21, 28567], [23, 28787], [29, 29147], [32, 29347], [38, 29667], [40, 29922], [46, 30222], [49, 30382], [56, 30865], [62, 31515], [64, 31618], [71, 31878], [74, 32228], [81, 32578], [88, 32998], [91, 33258]]}, {"verse": 6, "start": 34112, "end": 39063, "text": "Y Judá tomó mujer para su primogénito Er, la cual se llamaba Tamar.", "words": [[0, 34112], [2, 34378], [7, 34678], [12, 35018], [18, 35358], [23, 35658], [26, 35858], [38, 36698], [42, 37258], [45, 37378], [50, 37638], [53, 37898], [61, 38378]]}, {"verse": 7, "start": 39413, "end": 46026, "text": "Y Er, el primogénito de Judá, fue malo a los ojos de Jehová, y le quitó Jehová la vida.", "words": [[0, 39413], [2, 39647], [6, 39917], [9, 40077], [21, 40917], [24, 41337], [30, 41757], [34, 41917], [39, 42577], [41, 42777], [45, 42917], [50, 43237], [53, 43437], [61, 43937], [63, 44357], [66, 44517], [72, 44957], [79, 45357], [82, 45417]]}, {"verse": 8, "start": 46376, "end": 54246, "text": "Entonces Judá dijo a Onán: Únete a la mujer de tu hermano, cumple con tu deber de cuñado y da descendencia a tu hermano.", "words": [[0, 46376], [9, 46906], [14, 47648], [19, 47911], [21, 48111], [27, 48854], [33, 49220], [35, 49320], [38, 49380], [44, 49600], [47, 49820], [50, 49960], [59, 50760], [66, 51080], [70, 51260], [73, 51400], [79, 51640], [82, 51820], [89, 52340], [91, 52560], [94, 52680], [107, 53460], [109, 53580], [112, 53680]]}, {"verse": 9, "start": 54526, "end": 66402, "text": "Y sabiendo Onán que la descendencia no había de ser suya, sucedía que cuando entraba a la mujer de su hermano vertía en tierra, por no dar descendencia a su hermano.", "words": [[0, 54526], [2, 54671], [11, 55151], [16, 55891], [20, 56311], [23, 56451], [36, 57331], [39, 57531], [45, 57751], [48, 57911], [52, 58131], [58, 59011], [66, 59691], [70, 59871], [77, 60131], [85, 60461], [87, 60791], [90, 60911], [96, 61211], [99, 61431], [102, 61591], [110, 62051], [117, 62651], [120, 62931], [128, 63930], [132, 64075], [135, 64275], [139, 64555], [152, 65515], [154, 65675], [157, 65735]]}, {"verse": 10, "start": 66752, "end": 72268, "text": "Y desagradó ante los ojos de Jehová lo que hacía, y también quitó a él la vida.", "words": [[0, 66752], [2, 66873], [12, 67613], [17, 67873], [21, 68073], [26, 68473], [29, 68733], [36, 69213], [39, 69333], [43, 69513], [50, 69993], [52, 70453], [60, 70733], [66, 71313], [68, 71413], [71, 71573], [74, 71753]]}, {"verse": 11, "start": 72618, "end": 86317, "text": "Y Judá dijo a Tamar su nuera: Quédate viuda en casa de tu padre, hasta que crezca Sela mi hijo; porque dijo: Que quizá no muera él también como sus hermanos. Y se fue Tamar, y se quedó en casa de su padre.", "words": [[0, 72618], [2, 72747], [7, 73227], [12, 73627], [14, 73807], [20, 74127], [23, 74327], [30, 75148], [38, 75484], [44, 75924], [47, 76084], [52, 76304], [55, 76504], [58, 76624], [65, 76984], [71, 77484], [75, 77824], [82, 78164], [87, 78504], [90, 78724], [96, 79587], [103, 79757], [109, 80476], [113, 80578], [119, 80978], [122, 81118], [128, 81418], [131, 81558], [139, 81858], [144, 82138], [148, 82318], [158, 83303], [160, 83427], [163, 83527], [167, 83707], [174, 84227], [176, 84747], [179, 84867], [185, 85167], [188, 85267], [193, 85527], [196, 85747], [199, 85887]]}, {"verse": 12, "start": 86667, "end": 100280, "text": "Y pasaron muchos días, y murió la hija de Súa, mujer de Judá; y Judá se consoló, y subía a los trasquiladores de sus ovejas a Timnat, él y su amigo Hira el adulamita.", "words": [[0, 86667], [2, 86772], [10, 87192], [17, 87472], [23, 87912], [25, 88532], [31, 88912], [34, 89072], [39, 89452], [42, 89552], [47, 90232], [53, 90472], [56, 90692], [62, 91409], [64, 91576], [69, 91956], [72, 92076], [81, 93296], [83, 93556], [89, 94076], [91, 94256], [95, 94416], [110, 95256], [113, 95456], [117, 95636], [124, 96176], [126, 96796], [134, 97416], [137, 97676], [139, 97876], [142, 98016], [148, 98496], [153, 98976], [156, 99156]]}, {"verse": 13, "start": 100630, "end": 107433, "text": "Y avisaron a Tamar, diciendo: He aquí tu suegro sube a Timnat a esquilar sus ovejas.", "words": [[0, 100630], [2, 100777], [11, 101357], [13, 101517], [20, 101897], [30, 103239], [33, 103329], [38, 103529], [41, 103889], [48, 104249], [53, 104649], [55, 104789], [62, 105329], [64, 105769], [73, 106349], [77, 106923]]}, {"verse": 14, "start": 107783, "end": 123135, "text": "Entonces quitó ella de sobre sí los vestidos de su viudez, y se cubrió con un velo, y se tapó, y se puso a la puerta de las aguas que están junto al camino de Timnat; porque veía que había crecido Sela, y ella no era dada a él por mujer.", "words": [[0, 107783], [9, 108230], [15, 108830], [20, 109070], [23, 109230], [29, 109510], [32, 109810], [36, 110250], [45, 110750], [48, 110910], [51, 111183], [59, 111457], [61, 111730], [64, 111890], [71, 112390], [75, 112610], [78, 112790], [84, 113170], [86, 113310], [89, 113430], [95, 114112], [97, 114212], [100, 114332], [105, 114692], [107, 114772], [110, 114832], [117, 115152], [120, 115392], [124, 115552], [130, 115932], [134, 116052], [140, 116312], [146, 116572], [149, 116852], [156, 117152], [159, 117661], [167, 118323], [174, 118507], [179, 118967], [183, 119127], [189, 119327], [197, 119847], [203, 120307], [205, 120707], [210, 120927], [213, 121187], [217, 121367], [222, 121807], [224, 122047], [227, 122247], [231, 122507]]}, {"verse": 15, "start": 123485, "end": 128446, "text": "Y la vio Judá, y la tuvo por ramera, porque había ella cubierto su rostro.", "words": [[0, 123485], [2, 123606], [5, 123726], [9, 123926], [15, 124406], [17, 124621], [20, 124741], [25, 125001], [29, 125421], [37, 125841], [44, 126421], [50, 126721], [55, 126981], [64, 127521], [67, 127741]]}, {"verse": 16, "start": 128796, "end": 140118, "text": "Y se apartó del camino hacia ella, y le dijo: Vamos, pues, ahora me acostaré contigo; porque no sabía que era su nuera; y ella dijo: ¿Qué me has de dar, si entras a mí?", "words": [[0, 128796], [2, 129188], [5, 129328], [12, 129888], [16, 130048], [23, 130388], [29, 130688], [35, 131148], [37, 131428], [40, 131528], [46, 132263], [53, 132485], [59, 133065], [65, 133205], [68, 133365], [77, 133745], [86, 134630], [93, 134793], [96, 135033], [102, 135453], [106, 135673], [110, 135913], [113, 136133], [120, 137006], [122, 137171], [127, 137351], [133, 138169], [138, 138313], [141, 138553], [145, 138733], [148, 138873], [153, 139113], [156, 139373], [163, 139673], [165, 139813]]}, {"verse": 17, "start": 140398, "end": 148607, "text": "Él respondió: Yo te enviaré del ganado un cabrito de las cabras. Y ella dijo: Me has de dar prenda hasta que lo envíes.", "words": [[0, 140398], [3, 140565], [14, 141594], [17, 141719], [20, 141899], [28, 142339], [32, 142479], [39, 142899], [42, 143039], [50, 143439], [53, 143579], [57, 143719], [65, 144621], [67, 144783], [72, 144983], [78, 145773], [81, 145973], [85, 146173], [88, 146393], [92, 146613], [99, 147233], [105, 147533], [109, 147733], [112, 148210]]}, {"verse": 18, "start": 148887, "end": 162100, "text": "Entonces él dijo: ¿Qué prenda te daré? Ella respondió: Tu anillo, y tu manto, y tu bastón que tienes en tu mano. Y él se los dio, y entró a ella, la cual concibió de él.", "words": [[0, 148887], [9, 149452], [12, 150012], [18, 150770], [23, 150984], [30, 151234], [33, 151414], [39, 152049], [44, 152276], [55, 153406], [58, 153486], [66, 153966], [68, 154146], [71, 154306], [78, 154806], [80, 155206], [83, 155346], [90, 155906], [94, 156046], [101, 156366], [104, 156626], [107, 156746], [113, 157556], [115, 157722], [118, 157882], [121, 158062], [125, 158282], [130, 158602], [132, 158847], [138, 159467], [140, 159667], [146, 160507], [149, 160607], [154, 160807], [163, 161487], [166, 161627]]}, {"verse": 19, "start": 162450, "end": 169699, "text": "Y se levantó, y se fue: y se quitó el velo de sobre sí, y se vistió las ropas de su viudez.", "words": [[0, 162450], [2, 162616], [5, 162696], [14, 163496], [16, 163956], [19, 164096], [24, 164778], [26, 164903], [29, 165003], [35, 165423], [38, 165543], [43, 165843], [46, 166003], [52, 166323], [56, 167243], [58, 167323], [61, 167483], [68, 167983], [72, 168163], [78, 168603], [81, 168991], [84, 169379]]}, {"verse": 20, "start": 170049, "end": 178582, "text": "Y Judá envió el cabrito de las cabras por mano de su amigo el adulamita, para que tomase la prenda de mano de la mujer; pero no la halló.", "words": [[0, 170049], [2, 170175], [7, 170495], [13, 170815], [16, 170955], [24, 171415], [27, 171575], [31, 171715], [38, 172155], [42, 172375], [47, 172635], [50, 172855], [53, 173015], [59, 173355], [62, 173515], [73, 174195], [78, 174895], [82, 175055], [89, 175495], [92, 175635], [99, 176055], [102, 176175], [107, 176375], [110, 176535], [113, 176635], [120, 177356], [125, 177500], [128, 177820], [131, 178228]]}, {"verse": 21, "start": 178932, "end": 188264, "text": "Y preguntó a los hombres de aquel lugar, diciendo: ¿Dónde está la ramera de las aguas junto al camino? Y ellos le dijeron: No ha estado aquí ramera.", "words": [[0, 178932], [2, 179056], [11, 179776], [13, 179936], [17, 180096], [25, 180496], [28, 180696], [34, 181016], [41, 181356], [51, 182482], [58, 182742], [63, 182982], [66, 183252], [73, 183522], [76, 183662], [80, 183842], [86, 184202], [92, 184362], [95, 184562], [103, 185330], [105, 185514], [111, 185734], [114, 185914], [123, 186813], [126, 187016], [129, 187136], [136, 187436], [141, 187816]]}, {"verse": 22, "start": 188544, "end": 196799, "text": "Entonces él se volvió a Judá, y dijo: No la he hallado; y también los hombres del lugar dijeron: Aquí no ha estado ramera.", "words": [[0, 188544], [9, 189510], [12, 189743], [15, 190003], [22, 190483], [24, 190763], [30, 191043], [32, 191223], [38, 191924], [41, 192069], [44, 192209], [47, 192349], [56, 193089], [58, 193196], [66, 193436], [70, 193656], [78, 193976], [82, 194196], [88, 194496], [97, 195364], [102, 195722], [105, 195902], [108, 195962], [115, 196182]]}, {"verse": 23, "start": 197079, "end": 204525, "text": "Y Judá dijo: Que se lo quede, para que no seamos menospreciados: he aquí yo he enviado este cabrito, y tú no la hallaste.", "words": [[0, 197079], [2, 197383], [7, 197722], [13, 198284], [17, 198344], [20, 198424], [23, 198564], [30, 198924], [35, 199264], [39, 199404], [42, 199524], [49, 199924], [65, 201232], [68, 201232], [73, 201536], [76, 201856], [79, 201956], [87, 202396], [92, 202596], [101, 203116], [103, 203556], [106, 203736], [109, 204009], [112, 204283]]}, {"verse": 24, "start": 204805, "end": 217726, "text": "Y acaeció que al cabo de unos tres meses fue dado aviso a Judá, diciendo: Tamar tu nuera ha fornicado, y aun cierto está preñada de las fornicaciones. Y Judá dijo: Sacadla, y sea quemada.", "words": [[0, 204805], [2, 204910], [10, 205470], [14, 205790], [17, 205870], [22, 206150], [25, 206350], [30, 206470], [35, 206750], [41, 207390], [45, 207470], [50, 207770], [56, 208230], [58, 208370], [64, 209110], [74, 210069], [80, 210354], [83, 210494], [89, 210874], [92, 211274], [103, 211674], [105, 211894], [109, 212034], [116, 212494], [121, 212774], [129, 213394], [132, 213534], [136, 214252], [151, 215122], [153, 215426], [158, 215765], [164, 216494], [173, 216754], [175, 216954], [179, 217074]]}, {"verse": 25, "start": 218006, "end": 232365, "text": "Y ella, cuando la sacaban, envió a decir a su suegro: Del varón cuyas son estas cosas, estoy encinta: y dijo más: Mira ahora de quién son estas cosas, el anillo, y el manto, y el bastón.", "words": [[0, 218006], [2, 218189], [8, 218489], [15, 218929], [18, 219369], [27, 219809], [33, 220829], [35, 221069], [41, 221409], [43, 221709], [46, 221869], [54, 222833], [58, 222893], [64, 223353], [70, 223813], [74, 223993], [80, 224213], [87, 224733], [93, 225469], [102, 226417], [104, 226557], [109, 226797], [114, 227641], [119, 227841], [125, 228141], [128, 228321], [134, 228501], [138, 228821], [144, 229041], [151, 229881], [154, 229981], [162, 230481], [164, 230761], [167, 230881], [174, 231341], [176, 231561], [179, 231681]]}, {"verse": 26, "start": 232645, "end": 241036, "text": "Entonces Judá los reconoció, y dijo: Más justa es que yo, por cuanto no la he dado a Sela mi hijo. Y nunca más la conoció.", "words": [[0, 232645], [9, 233168], [14, 233726], [18, 234006], [29, 234706], [31, 234906], [37, 235668], [41, 235926], [47, 236266], [50, 236366], [54, 236486], [58, 236726], [62, 236986], [69, 237246], [72, 237526], [75, 237686], [78, 237786], [83, 237986], [85, 238256], [90, 238526], [93, 238686], [99, 239377], [101, 239502], [107, 239762], [111, 240002], [114, 240242]]}, {"verse": 27, "start": 241386, "end": 246040, "text": "Y aconteció que al tiempo del parir, he aquí había dos en su vientre.", "words": [[0, 241386], [2, 241664], [12, 242304], [16, 242484], [19, 242644], [26, 242944], [30, 243224], [37, 243904], [40, 244064], [45, 244484], [51, 244724], [55, 245004], [58, 245244], [61, 245673]]}, {"verse": 28, "start": 246390, "end": 257018, "text": "Y sucedió, cuando paría, que sacó la mano el uno, y la partera tomó y ató a su mano un hilo escarlata, diciendo: Este salió primero.", "words": [[0, 246390], [2, 246531], [11, 247231], [18, 247511], [25, 248871], [29, 248951], [34, 249291], [37, 249391], [42, 249571], [45, 249791], [50, 250091], [52, 250591], [55, 250711], [63, 251091], [68, 251571], [70, 251711], [74, 252091], [76, 252291], [79, 252451], [84, 252831], [87, 253211], [92, 253591], [103, 254331], [113, 255509], [118, 255760], [124, 256160]]}, {"verse": 29, "start": 257298, "end": 266846, "text": "Pero fue que volviendo él a meter la mano, he aquí su hermano salió; y ella dijo: ¡Cómo te has abierto paso! Y llamó su nombre Fares.", "words": [[0, 257298], [5, 257440], [9, 257660], [13, 257840], [23, 258440], [26, 258640], [28, 258760], [34, 259000], [37, 259240], [43, 259627], [46, 260015], [51, 260235], [54, 260475], [62, 260915], [69, 261718], [71, 261883], [76, 262063], [82, 262881], [88, 263061], [91, 263241], [95, 263401], [103, 263801], [109, 264799], [111, 264922], [117, 265262], [120, 265422], [127, 266102]]}, {"verse": 30, "start": 267196, "end": 273753, "text": "Y después salió su hermano, el que tenía en su mano el hilo escarlata, y llamó su nombre Zara.", "words": [[0, 267196], [2, 267303], [10, 267543], [16, 268043], [19, 268243], [28, 269163], [31, 269343], [35, 269463], [41, 269783], [44, 269983], [47, 270143], [52, 270443], [55, 270723], [60, 270963], [71, 272143], [73, 272223], [79, 272543], [82, 272663], [89, 273226]]}]}