{"book": "GEN", "chapter": 23, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 176280, "verses": [{"verse": 1, "start": 300, "end": 6134, "text": "Y fue la vida de Sara ciento veintisiete años: tantos fueron los años de la vida de Sara.", "words": [[0, 300], [2, 424], [6, 584], [9, 724], [14, 944], [17, 1144], [22, 1477], [29, 1811], [41, 2144], [47, 3551], [54, 4058], [61, 4278], [65, 4558], [70, 4898], [73, 5098], [76, 5198], [81, 5398], [84, 5598]]}, {"verse": 2, "start": 6484, "end": 16104, "text": "Y murió Sara en Quiriat-arba, que es Hebrón, en la tierra de Canaán: y vino Abraham a hacer el duelo a Sara, y a llorarla.", "words": [[0, 6484], [2, 6611], [8, 6931], [13, 7291], [16, 8011], [30, 8731], [34, 8771], [37, 8991], [45, 9871], [48, 10091], [51, 10211], [58, 10531], [61, 11067], [69, 11766], [71, 11913], [76, 12193], [84, 12873], [86, 13228], [92, 13528], [95, 13748], [101, 14108], [103, 14308], [109, 14648], [111, 15208], [113, 15682]]}, {"verse": 3, "start": 16454, "end": 22590, "text": "Y se levantó Abraham de delante de su muerto, y habló a los hijos de Het, diciendo:", "words": [[0, 16454], [2, 16561], [5, 16681], [13, 17261], [21, 17761], [24, 18021], [32, 18461], [35, 18621], [38, 18781], [46, 19341], [48, 20001], [54, 20461], [56, 20581], [60, 20741], [66, 21021], [69, 21301], [74, 21581]]}, {"verse": 4, "start": 22790, "end": 30732, "text": "Extranjero y forastero soy entre vosotros; dadme heredad de sepultura con vosotros, y sepultaré mi muerto de delante de mí.", "words": [[0, 22790], [11, 23551], [13, 23961], [23, 24371], [27, 24611], [33, 24971], [43, 26044], [49, 26462], [57, 26882], [60, 26982], [70, 27522], [74, 27762], [84, 28342], [86, 28642], [96, 29202], [99, 29342], [106, 29742], [109, 29882], [117, 30302], [120, 30462]]}, {"verse": 5, "start": 31012, "end": 35701, "text": "Y respondieron los hijos de Het a Abraham, y le dijeron:", "words": [[0, 31012], [2, 31137], [15, 31857], [19, 32077], [25, 32417], [28, 32787], [32, 33157], [34, 33537], [43, 34197], [45, 34752], [48, 34892]]}, {"verse": 6, "start": 35901, "end": 47173, "text": "Oyenos, señor mío, eres un príncipe de Dios entre nosotros; en lo mejor de nuestras sepulturas sepulta a tu muerta; ninguno de nosotros te impedirá su sepultura, para que entierres a tu muerta.", "words": [[0, 35901], [8, 36285], [14, 36565], [19, 37385], [24, 37585], [27, 37825], [36, 38345], [39, 38505], [44, 38705], [50, 38985], [60, 40002], [63, 40121], [66, 40201], [72, 40521], [75, 40681], [84, 40921], [95, 41531], [103, 42141], [105, 42221], [108, 42301], [116, 43149], [124, 43558], [127, 43658], [136, 44058], [139, 44298], [148, 44758], [151, 45118], [162, 45478], [167, 45763], [171, 45923], [181, 46383], [183, 46503], [186, 46583]]}, {"verse": 7, "start": 47453, "end": 53854, "text": "Y Abraham se levantó, y se inclinó al pueblo de aquella tierra, a los hijos de Het;", "words": [[0, 47453], [2, 47591], [10, 48031], [13, 48331], [22, 49091], [24, 49771], [27, 50161], [35, 50551], [38, 50711], [45, 51011], [48, 51351], [56, 51691], [64, 52111], [66, 52416], [70, 52556], [76, 52896], [79, 53375]]}, {"verse": 8, "start": 54204, "end": 63207, "text": "Y habló con ellos, diciendo: Si tenéis voluntad que yo sepulte mi muerto de delante de mí, oídme, e interceded por mí con Efrón, hijo de Zohar,", "words": [[0, 54204], [2, 54331], [8, 54651], [12, 54811], [19, 55111], [29, 56338], [32, 56459], [39, 56799], [48, 57339], [52, 57479], [55, 57599], [63, 58159], [66, 58239], [73, 58619], [76, 58759], [84, 59139], [87, 59299], [91, 59939], [98, 60339], [100, 60719], [111, 61319], [115, 61479], [118, 61639], [122, 61799], [129, 62459], [134, 62579], [137, 62924]]}, {"verse": 9, "start": 63557, "end": 71931, "text": "Para que me dé la cueva de Macpela, que tiene al extremo de su heredad: que por su justo precio me la dé, para posesión de sepultura en medio de vosotros.", "words": [[0, 63557], [5, 63711], [9, 63851], [12, 63971], [15, 64091], [18, 64251], [24, 64611], [27, 64691], [36, 65271], [40, 65451], [46, 65731], [49, 65871], [57, 66391], [60, 66471], [63, 66651], [72, 67301], [76, 67381], [80, 67581], [83, 67761], [89, 68021], [96, 68441], [99, 68641], [102, 68781], [106, 69001], [111, 69561], [120, 70121], [123, 70241], [133, 70801], [136, 70941], [142, 71161], [145, 71341]]}, {"verse": 10, "start": 72211, "end": 85835, "text": "Este Efrón se hallaba entre los hijos de Het: y respondió Efrón heteo a Abraham, en oídos de los hijos de Het, de todos los que entraban por la puerta de su ciudad, diciendo:", "words": [[0, 72211], [5, 72499], [11, 73199], [14, 73379], [22, 73859], [28, 74139], [32, 74359], [38, 74659], [41, 75082], [46, 75672], [48, 75778], [58, 76438], [64, 77098], [70, 77398], [72, 77698], [81, 78778], [84, 78918], [90, 79478], [93, 79638], [97, 79778], [103, 80118], [106, 80768], [111, 81418], [114, 81578], [120, 81938], [124, 82418], [128, 82618], [137, 83258], [141, 83498], [144, 83638], [151, 83958], [154, 84238], [157, 84398], [165, 84858]]}, {"verse": 11, "start": 86035, "end": 95007, "text": "No, señor mío, óyeme: te doy la heredad, y te doy también la cueva que está en ella; delante de los hijos de mi pueblo te la doy; sepulta tu muerto.", "words": [[0, 86035], [4, 86333], [10, 86493], [15, 87113], [22, 87786], [25, 87869], [29, 88109], [32, 88209], [41, 88769], [43, 89089], [46, 89209], [50, 89429], [58, 89689], [61, 89869], [67, 90209], [71, 90309], [76, 90509], [79, 90649], [85, 91255], [93, 91682], [96, 91842], [100, 91962], [106, 92202], [109, 92382], [112, 92482], [119, 92842], [122, 93022], [125, 93162], [130, 93934], [138, 94214], [141, 94314]]}, {"verse": 12, "start": 95287, "end": 98988, "text": "Y Abraham se inclinó delante del pueblo de la tierra.", "words": [[0, 95287], [2, 95409], [10, 95769], [13, 96209], [21, 96949], [29, 97409], [33, 97629], [40, 98009], [43, 98229], [46, 98349]]}, {"verse": 13, "start": 99338, "end": 110871, "text": "Y respondió a Efrón en oídos del pueblo de la tierra, diciendo: Antes, si te place, te ruego que me oigas; yo daré el precio de la heredad, tómalo de mí, y sepultaré en ella mi muerto.", "words": [[0, 99338], [2, 99462], [12, 100202], [14, 100462], [20, 100962], [23, 101282], [29, 101662], [33, 101782], [40, 102022], [43, 102262], [46, 102382], [54, 102662], [64, 103646], [71, 103883], [74, 104153], [77, 104253], [84, 105073], [87, 105133], [93, 105453], [97, 105613], [100, 105753], [107, 106578], [110, 106760], [115, 107000], [118, 107080], [125, 107380], [128, 107560], [131, 107660], [140, 108280], [147, 108600], [150, 108720], [154, 108880], [156, 109260], [166, 109860], [169, 110000], [174, 110140], [177, 110340]]}, {"verse": 14, "start": 111151, "end": 114637, "text": "Y respondió Efrón a Abraham, diciéndole:", "words": [[0, 111151], [2, 111278], [12, 111938], [18, 112498], [20, 112698], [29, 113718]]}, {"verse": 15, "start": 114837, "end": 121841, "text": "Señor mío, escúchame: la tierra vale cuatrocientos siclos de plata: ¿qué es esto entre mí y ti? entierra pues tu muerto.", "words": [[0, 114837], [6, 115122], [11, 115642], [22, 116385], [25, 116490], [32, 116750], [37, 117237], [51, 117723], [58, 118210], [61, 118330], [68, 119057], [73, 119181], [76, 119361], [81, 119581], [87, 119781], [90, 120001], [92, 120081], [96, 120727], [105, 120887], [110, 121047], [113, 121207]]}, {"verse": 16, "start": 122121, "end": 134598, "text": "Entonces Abraham se convino con Efrón, y pesó Abraham a Efrón el dinero que dijo, oyéndolo los hijos de Het, cuatrocientos siclos de plata, de buena ley entre mercaderes.", "words": [[0, 122121], [9, 122642], [17, 123182], [20, 123662], [28, 124142], [32, 124342], [39, 124742], [41, 124957], [46, 125357], [54, 126037], [56, 126277], [62, 126757], [65, 127017], [72, 127337], [76, 127537], [82, 128437], [91, 129057], [95, 129257], [101, 129577], [104, 129958], [109, 130340], [123, 130931], [130, 131522], [133, 131662], [140, 132062], [143, 132537], [149