{"book": "PSA", "chapter": 31, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 163586, "verses": [{"verse": 1, "start": 300, "end": 7099, "text": "In you, O LORD, do I put my trust; let me never be ashamed: deliver me in your righteousness.", "words": [[0, 300], [3, 485], [8, 865], [10, 985], [16, 1665], [19, 1845], [21, 1985], [25, 2205], [28, 2445], [35, 3463], [39, 3581], [42, 3761], [48, 4021], [51, 4281], [60, 5322], [68, 5679], [71, 5879], [74, 6019], [79, 6139]]}, {"verse": 2, "start": 7549, "end": 14295, "text": "Bow down your ear to me; deliver me speedily: be my strong rock, for a house of defence to save me.", "words": [[0, 7549], [4, 7775], [9, 8075], [14, 8315], [18, 8555], [21, 8755], [25, 9371], [33, 9713], [36, 9873], [46, 10888], [49, 10998], [52, 11198], [59, 11558], [65, 12018], [69, 12538], [71, 12698], [77, 12858], [80, 13138], [88, 13418], [91, 13638], [96, 13938]]}, {"verse": 3, "start": 14745, "end": 20172, "text": "For you are my rock and my fortress; therefore for your name’s sake lead me, and guide me.", "words": [[0, 14745], [4, 14835], [8, 15055], [12, 15215], [15, 15375], [20, 15775], [24, 16075], [27, 16235], [37, 17268], [47, 17635], [51, 17915], [56, 18155], [63, 18395], [68, 18635], [73, 18935], [77, 19195], [81, 19515], [87, 19795]]}, {"verse": 4, "start": 20622, "end": 25202, "text": "Pull me out of the net that they have laid privately for me: for you are my strength.", "words": [[0, 20687], [5, 20767], [8, 20967], [12, 21127], [15, 21247], [19, 21387], [23, 21647], [28, 21887], [33, 22067], [38, 22207], [43, 22407], [53, 22867], [57, 23247], [61, 23875], [65, 23997], [69, 24197], [73, 24377], [76, 24557]]}, {"verse": 5, "start": 25652, "end": 30532, "text": "Into your hand I commit my spirit: you have redeemed me, O LORD God of truth.", "words": [[0, 25652], [5, 25841], [10, 26061], [15, 26401], [17, 26601], [24, 26881], [27, 27121], [35, 28053], [39, 28196], [44, 28396], [53, 28916], [57, 29236], [59, 29336], [64, 29576], [68, 29836], [71, 30016]]}, {"verse": 6, "start": 30982, "end": 35831, "text": "I have hated them that regard lying vanities: but I trust in the LORD.", "words": [[0, 30982], [2, 31190], [7, 31390], [13, 31690], [18, 31990], [23, 32250], [30, 32670], [36, 33170], [46, 34394], [50, 34495], [52, 34595], [58, 34895], [61, 35195], [65, 35295]]}, {"verse": 7, "start": 36281, "end": 43550, "text": "I will be glad and rejoice in your mercy: for you have considered my trouble; you have known my soul in adversities;", "words": [[0, 36281], [2, 36405], [7, 36545], [10, 36685], [15, 37065], [19, 37325], [27, 37705], [30, 38025], [35, 38145], [42, 39112], [46, 39220], [50, 39380], [55, 39540], [66, 40020], [69, 40300], [78, 41187], [82, 41336], [87, 41516], [93, 41736], [96, 41996], [101, 42376], [104, 42636]]}, {"verse": 8, "start": 44000, "end": 49302, "text": "And have not shut me up into the hand of the enemy: you have set my feet in a large room.", "words": [[0, 44000], [4, 44143], [9, 44323], [13, 44543], [18, 44883], [21, 45123], [24, 45323], [29, 45523], [33, 45663], [38, 45903], [41, 46043], [45, 46163], [52, 46929], [56, 47202], [61, 47382], [65, 47622], [68, 47822], [73, 48122], [76, 48322], [78, 48422], [84, 48722]]}, {"verse": 9, "start": 49752, "end": 57475, "text": "Have mercy upon me, O LORD, for I am in trouble: my eye is consumed with grief, yes, my soul and my belly.", "words": [[0, 49752], [5, 49932], [11, 50292], [16, 50612], [20, 51012], [22, 51152], [28, 51632], [32, 51752], [34, 52012], [37, 52132], [40, 52252], [49, 53153], [52, 53321], [56, 53661], [59, 53861], [68, 54341], [73, 54621], [80, 55261], [85, 55961], [88, 56101], [93, 56481], [97, 56761], [100, 56941]]}, {"verse": 10, "start": 57925, "end": 66340, "text": "For my life is spent with grief, and my years with sighing: my strength fails because of my iniquity, and my bones are consumed.", "words": [[0, 57925], [4, 58033], [7, 58213], [12, 58533], [15, 58753], [21, 59033], [26, 59233], [33, 59633], [37, 60313], [40, 60493], [46, 60853], [51, 61113], [60, 62078], [63, 62206], [72, 62586], [78, 63106], [86, 63466], [89, 63706], [92, 63866], [102, 64466], [106, 64766], [109, 64926], [115, 65306], [119, 65506]]}, {"verse": 11, "start": 66790, "end": 75715, "text": "I was a reproach among all my enemies, but especially among my neighbours, and a fear to my acquaintance: they that did see me without fled from me.", "words": [[0, 66790], [2, 66949], [6, 67109], [8, 67229], [17, 67749], [23, 67909], [27, 68269], [30, 68469], [39, 69289], [43, 69469], [54, 69949], [60, 70309], [63, 70919], [75, 71529], [79, 71669], [81, 71809], [86, 72029], [89, 72229], [92, 72429], [106, 73469], [111, 73617], [116, 73797], [120, 74017], [124, 74317], [127, 74517], [135, 74817], [140, 75137], [145, 75397]]}, {"verse": 12, "start": 76165, "end": 80813, "text": "I am forgotten as a dead man out of mind: I am like a broken vessel.", "words": [[0, 76165], [2, 76384], [5, 76524], [15, 76984], [18, 77284], [20, 77424], [25, 77664], [29, 77984], [33, 78224], [36, 78364], [42, 79201], [44, 79382], [47, 79522], [52, 79702], [54, 79842], [61, 80162]]}, {"verse": 13, "start": 81263, "end": 90111, "text": "For I have heard the slander of many: fear was on every side: while they took counsel together against me, they devised to take away my life.", "words": [[0, 81263], [4, 81365], [6, 81625], [11, 81805], [17, 82025], [21, 82245], [29, 82665], [32, 82845], [38, 83640], [43, 83929], [47, 84189], [50, 84409], [56, 84709], [62, 85639], [68, 85747], [73, 85907], [78, 86167], [86, 86567], [95, 86947], [103, 87387], [107, 88027], [112, 88187], [120, 88727], [123, 88887], [128, 89087], [133, 89307], [136, 89527]]}, {"verse": 14, "start": 90561, "end": 93982, "text": "But I trusted in you, O LORD: I said, You are my God.", "words": [[0, 90561], [4, 90666], [6, 90766], [14, 91126], [17, 91406], [22, 91626], [24, 91726], [30, 92505], [32, 92628], [38, 92988], [42, 93168], [46, 93308], [49, 93468]]}, {"verse": 15, "start": 94432, "end": 100375, "text": "My times are in your hand: deliver me from the hand of my enemies, and from them that persecute me.", "words": [[0, 94432], [3, 94808], [9, 95148], [13, 95408], [16, 95548], [21, 95668], [27, 96502], [35, 96842], [38, 97002], [43, 97182], [47, 97342], [52, 97602], [55, 97742], [58, 97902], [67, 98302], [71, 98742], [76, 98922], [81, 99142], [86, 99402], [96, 100102]]}, {"verse": 16, "start": 100825, "end": 105104, "text": "Make your face to shine upon your servant: save me for your mercies’ sake.", "words": [[0, 100825], [5, 100993], [10, 101193], [15, 101453], [18, 101673], [24, 101973], [29, 102193], [34, 102433], [43, 103333], [48, 103613], [51, 103833], [55, 104013], [60, 104373], [69, 104733]]}, {"verse": 17, "start": 105554, "end": 112561, "text": "Let me not be ashamed, O LORD; for I have called upon you: let the wicked be ashamed, and let them be silent in the grave.", "words": [[0, 105554], [4, 105679], [7, 105819], [11, 105999], [14, 106219], [23, 106719], [25, 106859], [31, 107627], [35, 107735], [37, 107915], [42, 108015], [49, 108335], [54, 108615], [59, 109308], [63, 109438], [67, 109598], [74, 109818], [77, 110098], [86, 110498], [90, 110838], [94, 110978], [99, 111138], [102, 111298], [109, 111698], [112, 111918], [116, 112018]]}, {"verse": 18, "start": 113011, "end": 119952, "text": "Let the lying lips be put to silence; which speak grievous things proudly and contemptuously against the righteous.", "words": [[0, 113011], [4, 113135], [8, 113295], [14, 113635], [19, 113975], [22, 114275], [26, 114475], [29, 114615], [38, 115674], [44, 115803], [50, 116143], [59, 116643], [66, 116903], [74, 117543], [78, 117763], [93, 118623], [101, 119003], [105, 119243]]}, {"verse": 19, "start": 120402, "end": 128350, "text": "Oh how great is your goodness, which you have laid up for them that fear you; which you have wrought for them that trust in you before the sons of men!", "words": [[0, 120402], [3, 120564], [7, 120764], [13, 121144], [16, 121344], [21, 121504], [31, 122224], [37, 122524], [41, 122684], [46, 122804], [51, 123004], [54, 123164], [58, 123344], [63, 123544], [68, 123804], [73, 124084], [78, 124802], [84, 124930], [88, 125130], [93, 125290], [101, 125610], [105, 125770], [110, 125990], [115, 126210], [121, 126510], [124, 126750], [128, 126870], [135, 127170], [139, 127410], [144, 127670], [147, 127870]]}, {"verse": 20, "start": 128800, "end": 136644, "text": "You shall hide them in the secret of your presence from the pride of man: you shall keep them secretly in a pavilion from the strife of tongues.", "words": [[0, 128800], [4, 129092], [10, 129312], [15, 129592], [20, 129852], [23, 130012], [27, 130112], [34, 130412], [37, 130652], [42, 130772], [51, 131172], [56, 131492], [60, 131632], [66, 131932], [69, 132072], [74, 132901], [78, 133089], [84, 133309], [89, 133529], [94, 133749], [103, 134189], [106, 134509], [108, 134589], [117, 135029], [122, 135289], [126, 135429], [133, 135869], [136, 135949]]}, {"verse": 21, "start": 137094, "end": 142019, "text": "Blessed be the LORD: for he has showed me his marvellous kindness in a strong city.", "words": [[0, 137094], [8, 137336], [11, 137656], [15, 137816], [21, 138617], [25, 138733], [28, 138893], [32, 139073], [39, 139353], [42, 139553], [46, 139873], [57, 140193], [66, 140753], [69, 141053], [71, 141133], [78, 141453]]}, {"verse": 22, "start": 142469, "end": 150078, "text": "For I said in my haste, I am cut off from before your eyes: nevertheless you heard the voice of my supplications when I cried to you.", "words": [[0, 142469], [4, 142599], [6, 142829], [11, 143059], [14, 143239], [17, 143439], [24, 143999], [26, 144079], [29, 144199], [33, 144419], [37, 144679], [42, 144939], [49, 145279], [54, 145519], [60, 146385], [73, 147094], [77, 147194], [83, 147374], [87, 147494], [93, 147754], [96, 147934], [99, 148114], [113, 148874], [118, 149094], [120, 149234], [126, 149514], [129, 149754]]}, {"verse": 23, "start": 150528, "end": 158152, "text": "O love the LORD, all you his saints: for the LORD preserves the faithful, and plentifully rewards the proud doer.", "words": [[0, 150655], [2, 150795], [7, 151135], [11, 151375], [17, 151995], [21, 152175], [25, 152375], [29, 152555], [37, 153482], [41, 153569], [45, 153689], [50, 153929], [60, 154509], [64, 154709], [74, 155169], [78, 155789], [90, 156369], [98, 156929], [102, 157189], [108, 157569]]}, {"verse": 24, "start": 158602, "end": 163186, "text": "Be of good courage, and he shall strengthen your heart, all you that hope in the LORD.", "words": [[0, 158602], [3, 158801], [6, 158981], [11, 159221], [20, 160241], [24, 160301], [27, 160421], [33, 160601], [44, 161021], [49, 161261], [56, 161801], [60, 161961], [64, 162121], [69, 162281], [74, 162481], [77, 162641], [81, 162741]]}]}