{"book": "1CO", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 292892, "verses": [{"verse": 1, "start": 300, "end": 4659, "text": "Cuanto a las cosas de que me escribisteis, bien es al hombre no tocar mujer.", "words": [[0, 300], [7, 549], [9, 729], [13, 869], [19, 1189], [22, 1469], [26, 1569], [29, 1689], [43, 2209], [48, 2729], [51, 3249], [54, 3369], [61, 3609], [64, 3829], [70, 4089]]}, {"verse": 2, "start": 5009, "end": 11357, "text": "Pero a causa de la inmoralidad sexual, cada uno tenga su mujer, y cada una tenga su marido.", "words": [[0, 5009], [5, 5133], [7, 5293], [13, 5493], [16, 5733], [19, 5853], [31, 6473], [39, 7353], [44, 7533], [48, 7833], [54, 8153], [57, 8353], [64, 8713], [66, 9113], [71, 9333], [75, 9573], [81, 9873], [84, 10093]]}, {"verse": 3, "start": 11707, "end": 16725, "text": "El marido preste a la mujer la debida atención conyugal; y asimismo la mujer al marido.", "words": [[0, 11707], [3, 11803], [10, 12183], [17, 12543], [19, 12623], [22, 12683], [28, 12963], [31, 13223], [38, 13563], [47, 14168], [57, 14945], [59, 15046], [68, 15586], [71, 15746], [77, 16026], [80, 16206]]}, {"verse": 4, "start": 17075, "end": 25327, "text": "La mujer no tiene potestad de su propio cuerpo, sino el marido: e igualmente tampoco el marido tiene potestad de su propio cuerpo, sino la mujer.", "words": [[0, 17075], [3, 17161], [9, 17421], [12, 17661], [18, 17881], [27, 18481], [30, 18581], [33, 18741], [40, 19001], [48, 19721], [53, 19861], [56, 20041], [64, 20771], [66, 20873], [77, 21433], [85, 21713], [88, 22033], [95, 22393], [101, 22613], [110, 23253], [113, 23393], [116, 23553], [123, 23793], [131, 24573], [136, 24713], [139, 24873]]}, {"verse": 5, "start": 25677, "end": 37509, "text": "No os defraudéis el uno al otro, a no ser por algún tiempo de mutuo consentimiento, para ocuparos en la oración: y volved a juntaros en uno, porque no os tiente Satanás a causa de vuestra falta de dominio propio.", "words": [[0, 25869], [3, 26104], [6, 26339], [17, 26574], [20, 26714], [24, 26894], [27, 27034], [33, 27794], [35, 27874], [38, 27994], [42, 28194], [46, 28374], [52, 28594], [59, 28974], [62, 29174], [68, 29554], [84, 30434], [89, 30734], [98, 31314], [101, 31474], [104, 31574], [113, 32382], [115, 32513], [122, 32683], [124, 32843], [133, 33303], [136, 33483], [141, 33703], [148, 34063], [151, 34303], [154, 34503], [161, 34703], [169, 35363], [171, 35503], [177, 35743], [180, 35963], [188, 36263], [194, 36523], [197, 36683], [205, 37063]]}, {"verse": 6, "start": 37859, "end": 40612, "text": "Pero esto digo como concesión, no por mandamiento.", "words": [[0, 37859], [5, 37981], [10, 38201], [15, 38481], [20, 38761], [31, 39641], [34, 39701], [38, 39881]]}, {"verse": 7, "start": 40962, "end": 49100, "text": "Quisiera más bien que todos los hombres fuesen como yo: pero cada uno tiene su propio don de Dios; uno a la verdad así, y otro así.", "words": [[0, 40962], [9, 41323], [13, 41523], [18, 41783], [22, 41963], [28, 42183], [32, 42403], [40, 42773], [47, 43143], [52, 43343], [56, 43936], [61, 44076], [66, 44276], [70, 44556], [76, 44836], [79, 45036], [86, 45249], [90, 45463], [93, 45676], [99, 46435], [103, 46635], [105, 46775], [108, 46835], [115, 47095], [120, 47495], [122, 47795], [127, 47995]]}, {"verse": 8, "start": 49450, "end": 53671, "text": "Digo pues a los solteros y a las viudas, que bueno les es si se quedan como yo.", "words": [[0, 49450], [5, 49626], [10, 49886], [12, 50086], [16, 50206], [25, 50826], [27, 50946], [29, 51006], [33, 51146], [41, 51606], [45, 51766], [51, 52046], [55, 52266], [58, 52426], [61, 52606], [64, 52746], [71, 53086], [76, 53286]]}, {"verse": 9, "start": 54021, "end": 58960, "text": "Y si no tienen don de dominio propio, cásense; que mejor es casarse que quemarse.", "words": [[0, 54021], [2, 54126], [5, 54226], [8, 54366], [15, 54559], [19, 54753], [22, 54946], [30, 55526], [38, 56246], [47, 57132], [51, 57214], [57, 57507], [60, 57801], [68, 58094], [72, 58294]]}, {"verse": 10, "start": 59310, "end": 65689, "text": "Pero a los que están juntos en matrimonio, ordeno, no yo, sino el Señor: Que la mujer no se aparte del marido;", "words": [[0, 59310], [5, 59468], [7, 59568], [11, 59688], [15, 59788], [21, 60008], [28, 60328], [31, 60568], [43, 61448], [51, 62028], [54, 62128], [58, 62788], [63, 62948], [66, 63128], [73, 63846], [77, 63923], [80, 64003], [86, 64243], [89, 64476], [92, 64710], [99, 64943], [103, 65183]]}, {"verse": 11, "start": 66039, "end": 72545, "text": "Y si se aparta, que se quede sin casar, o que se reconcilie con su marido; y que el marido no despida a su mujer.", "words": [[0, 66039], [2, 66146], [5, 66226], [8, 66386], [16, 66906], [20, 67026], [23, 67216], [29, 67406], [33, 67626], [40, 68246], [42, 68606], [46, 68726], [49, 68846], [60, 69506], [64, 69666], [67, 69806], [75, 70564], [77, 70666], [81, 70766], [84, 70846], [91, 71206], [94, 71346], [102, 71826], [104, 71906], [107, 72026]]}, {"verse": 12, "start": 72895, "end": 80660, "text": "Y a los demás yo digo, no el Señor: Si algún hermano tiene mujer no creyente, y ella consiente en vivir con él, no la despida.", "words": [[0, 72895], [2, 72981], [4, 73041], [8, 73161], [14, 73601], [17, 73721], [23, 74261], [26, 74381], [29, 74521], [36, 75277], [39, 75432], [45, 75732], [53, 76252], [59, 76452], [65, 76812], [68, 77032], [78, 77612], [80, 77932], [85, 78342], [95, 78752], [98, 78872], [104, 79032], [108, 79332], [112, 79832], [115, 79912], [118, 80032]]}, {"verse": 13, "start": 81010, "end": 86614, "text": "Y la mujer que tiene marido no creyente, y él consiente en vivir con ella, no lo deje.", "words": [[0, 81010], [2, 81093], [5, 81173], [11, 81473], [15, 81713], [21, 81973], [28, 82393], [31, 82513], [41, 83153], [43, 83713], [46, 84113], [56, 84513], [59, 84653], [65, 84813], [69, 85133], [75, 85413], [78, 85993], [81, 86133]]}, {"verse": 14, "start": 86964, "end": 96571, "text": "Porque el marido no creyente es santificado en la mujer, y la mujer no creyente en el marido: pues de otra manera vuestros hijos serían inmundos; pero ahora son santos.", "words": [[0, 86964], [7, 87171], [10, 87331], [17, 87671], [20, 87811], [29, 88391], [32, 88731], [44, 89451], [47, 89551], [50, 89631], [57, 89991], [59, 90371], [62, 90491], [68, 90731], [71, 90971], [80, 91531], [83, 91651], [86, 91751], [94, 92467], [99, 92572], [102, 92752], [107, 92932], [114, 93432], [123, 93752], [129, 93932], [136, 94392], [146, 95318], [151, 95462], [157, 95662], [161, 95902]]}, {"verse": 15, "start": 96921, "end": 106461, "text": "Pero si el no creyente se aparta, apártese: que no es el hermano o la hermana sujeto a servidumbre en semejante caso; antes a paz nos llamó Dios.", "words": [[0, 96921], [5, 97078], [8, 97298], [11, 97438], [14, 97598], [23, 98118], [26, 98338], [34, 99138], [44, 100118], [48, 100200], [51, 100400], [54, 100660], [57, 100800], [65, 101380], [67, 101480], [70, 101620], [78, 102040], [85, 102580], [87, 102660], [99, 103300], [102, 103420], [112, 103980], [118, 104674], [124, 104979], [126, 105179], [130, 105379], [134, 105619], [140, 105939]]}, {"verse": 16, "start": 106811, "end": 114259, "text": "Porque ¿de dónde sabes, oh mujer, si quizá harás salvo a tu marido? ¿o de dónde sabes, oh marido, si quizá harás salva a tu mujer?", "words": [[0, 106811], [7, 107037], [11, 107217], [17, 107377], [24, 107917], [27, 107977], [34, 108717], [37, 108977], [43, 109237], [49, 109457], [55, 109757], [57, 109817], [60, 109917], [68, 110644], [71, 110747], [74, 110827], [80, 111007], [87, 111397], [90, 111787], [98, 112487], [101, 112587], [107, 112967], [113, 113187], [119, 113567], [121, 113647], [124, 113747]]}, {"verse": 17, "start": 114609, "end": 121516, "text": "Pero cada uno como el Señor le repartió, y como Dios llamó a cada uno, así ande: y así enseño en todas las iglesias.", "words": [[0, 114609], [5, 114745], [10, 114945], [14, 115285], [19, 115525], [22, 115665], [28, 115885], [31, 116295], [41, 116705], [43, 117025], [48, 117245], [53, 117445], [59, 117845], [61, 117905], [66, 118065], [71, 118485], [75, 118685], [81, 119380], [83, 119483], [87, 119663], [94, 120223], [97, 120343], [103, 120483], [107, 121028]]}, {"verse": 18, "start": 121866, "end": 128422, "text": "¿Es llamado alguno circuncidado? quédese circunciso. ¿Es llamado alguno incircuncidado? que no se circuncide.", "words": [[0, 121894], [4, 121964], [12, 122537], [19, 123111], [33, 124009], [41, 124209], [53, 125297], [57, 125421], [65, 125701], [72, 126161], [88, 127303], [92, 127353], [95, 127453], [98, 127573]]}, {"verse": 19, "start": 128772, "end": 134845, "text": "La circuncisión nada es, y la incircuncisión nada es; sino la observancia de los mandamientos de Dios.", "words": [[0, 128772], [3, 128871], [16, 129591], [21, 129811], [25, 130391], [27, 130651], [30, 130751], [45, 131511], [50, 131771], [54, 132456], [59, 132658], [62, 132798], [74, 133318], [77, 133458], [81, 133558], [94, 134138], [97, 134338]]}, {"verse": 20, "start": 135195, "end": 138158, "text": "Cada uno en la condición en que fue llamado, en ella se quede.", "words": [[0, 135195], [5, 135337], [9, 135577], [12, 135697], [15, 135797], [25, 136257], [28, 136397], [32, 136477], [36, 136637], [45, 136997], [48, 137377], [53, 137537], [56, 137717]]}, {"verse": 21, "start": 138508, "end": 144211, "text": "¿Eres llamado siendo esclavo? no se te dé cuidado: pero también si puedes hacerte libre, procúralo más.", "words": [[0, 138508], [6, 138690], [14, 138990], [21, 139310], [30, 140201], [33, 140299], [36, 140419], [39, 140559], [42, 140659], [51, 141441], [56, 141550], [64, 141910], [67, 142110], [74, 142350], [82, 142830], [89, 143300], [99, 143770]]}, {"verse": 22, "start": 144561, "end": 152948, "text": "Porque el que en el Señor es llamado siendo esclavo, liberto es del Señor: asimismo también el que es llamado siendo libre, esclavo es de Cristo.", "words": [[0, 144561], [7, 144861], [10, 145021], [14, 145141], [17, 145261], [20, 145361], [26, 145581], [29, 145781], [37, 146081], [44, 146401], [53, 147221], [61, 147681], [64, 147901], [68, 148001], [75, 148715], [84, 149336], [92, 149616], [95, 149916], [99, 150076], [102, 150236], [110, 150576], [117, 150876], [124, 151696], [132, 152196], [135, 152316], [138, 152436]]}, {"verse": 23, "start": 153298, "end": 156897, "text": "Por precio sois comprados; no os hagáis siervos de los hombres.", "words": [[0, 153298], [4, 153562], [11, 153862], [16, 154082], [27, 155005], [30, 155206], [33, 155366], [40, 155686], [48, 156086], [51, 156226], [55, 156326]]}, {"verse": 24, "start": 157247, "end": 161355, "text": "Cada uno, hermanos, en lo que es llamado, en esto se quede para con Dios.", "words": [[0, 157247], [5, 157447], [10, 157687], [20, 158287], [23, 158467], [26, 158587], [30, 158727], [33, 158867], [42, 159587], [45, 159787], [50, 160027], [53, 160187], [59, 160467], [64, 160647], [68, 160867]]}, {"verse": 25, "start": 161705, "end": 169614, "text": "En cuanto a las vírgenes, no tengo mandamiento del Señor; pero doy mi parecer, como quien ha alcanzado misericordia del Señor para ser fiel.", "words": [[0, 161705], [3, 161862], [10, 162042], [12, 162222], [16, 162362], [26, 163142], [29, 163282], [35, 163582], [47, 164122], [51, 164322], [58, 165091], [63, 165254], [67, 165534], [70, 165614], [79, 166094], [84, 166439], [90, 166659], [93, 166839], [103, 167439], [116, 168179], [120, 168339], [126, 168679], [131, 168959], [135, 169159]]}, {"verse": 26, "start": 169964, "end": 176842, "text": "Tengo, pues, esto por bueno a causa de la necesidad que apremia, que bueno es al hombre estarse así.", "words": [[0, 169964], [7, 170202], [13, 170482], [18, 170842], [22, 171082], [28, 171402], [30, 171562], [36, 171802], [39, 172042], [42, 172142], [52, 172782], [56, 172922], [65, 173822], [69, 173902], [75, 174182], [78, 174382], [81, 174542], [88, 174742], [96, 175222]]}, {"verse": 27, "start": 177192, "end": 182679, "text": "¿Estás ligado a mujer? no procures soltarte. ¿Estás suelto de mujer? no procures mujer.", "words": [[0, 177192], [7, 177477], [14, 177837], [16, 177937], [23, 178597], [26, 178803], [35, 179043], [45, 180093], [52, 180377], [59, 180757], [62, 180857], [69, 181593], [72, 181737], [81, 182137]]}, {"verse": 28, "start": 183029, "end": 191944, "text": "Pero también si te casas, no pecas; y si la doncella se casa, no peca; pero los tales tendrán aflicción de la carne, y yo os la quisiera evitar.", "words": [[0, 183029], [5, 183150], [13, 183410], [16, 183590], [19, 183710], [26, 184310], [29, 184390], [36, 185231], [38, 185313], [41, 185393], [44, 185533], [53, 185893], [56, 186053], [62, 186793], [65, 186933], [71, 187642], [76, 187782], [80, 187962], [86, 188222], [94, 188802], [104, 189382], [107, 189522], [110, 189622], [117, 190042], [119, 190297], [122, 190537], [125, 190677], [128, 190817], [137, 191277]]}, {"verse": 29, "start": 192294, "end": 200054, "text": "Pero esto digo, hermanos, que el tiempo es corto: lo que resta es, que los que tienen mujeres sean como los que no las tienen;", "words": [[0, 192294], [5, 192437], [10, 192697], [16, 193117], [26, 193717], [30, 193757], [33, 193897], [40, 194177], [43, 194397], [50, 195167], [53, 195299], [57, 195439], [63, 195839], [67, 196119], [71, 196499], [75, 196659], [79, 196839], [86, 197119], [94, 197679], [99, 198359], [104, 198699], [108, 198859], [112, 199059], [115, 199219], [119, 199419]]}, {"verse": 30, "start": 200404, "end": 208495, "text": "Y los que lloran, como los que no lloran; y los que se alegran, como los que no se alegran; y los que compran, como los que no poseen;", "words": [[0, 200404], [2, 200485], [6, 200605], [10, 200785], [18, 201305], [23, 201685], [27, 201905], [31, 202065], [34, 202225], [42, 202962], [44, 203045], [48, 203165], [52, 203365], [55, 203525], [64, 204005], [69, 204365], [73, 204545], [77, 204745], [80, 204885], [83, 205085], [92, 205914], [94, 206015], [98, 206155], [102, 206355], [111, 206835], [116, 207095], [120, 207295], [124, 207495], [127, 207655]]}, {"verse": 31, "start": 208845, "end": 214798, "text": "Y los que usan de este mundo, como los que no usan: porque la apariencia de este mundo se pasa.", "words": [[0, 208845], [2, 209105], [6, 209265], [10, 209465], [15, 209805], [18, 209925], [23, 210085], [30, 210485], [35, 210865], [39, 211065], [43, 211225], [46, 211425], [52, 212193], [59, 212401], [62, 212621], [73, 213301], [76, 213521], [81, 213761], [87, 214081], [90, 214321]]}, {"verse": 32, "start": 215148, "end": 223774, "text": "Quisiera, pues, que estuvieseis sin preocupaciones. El soltero tiene cuidado de las cosas que son del Señor, cómo ha de agradar al Señor:", "words": [[0, 215148], [10, 215605], [16, 215885], [20, 216285], [32, 217185], [36, 217425], [52, 218799], [55, 219062], [63, 219362], [69, 219642], [77, 220082], [80, 220302], [84, 220462], [90, 220822], [94, 221062], [98, 221262], [102, 221442], [109, 222202], [114, 222422], [117, 222622], [120, 222722], [128, 223182], [131, 223282]]}, {"verse": 33, "start": 224124, "end": 229481, "text": "Pero el que se casó tiene cuidado de las cosas que son del mundo, cómo ha de agradar a su mujer.", "words": [[0, 224124], [5, 224264], [8, 224404], [12, 224524], [15, 224644], [20, 225084], [26, 225304], [34, 225704], [37, 225924], [41, 226064], [47, 226384], [51, 226584], [55, 226764], [59, 226944], [66, 227344], [71, 228024], [74, 228224], [77, 228344], [85, 228764], [87, 228804], [90, 228944]]}, {"verse": 34, "start": 229831, "end": 244287, "text": "Hay asimismo diferencia entre la casada y la doncella: la doncella tiene cuidado de las cosas del Señor, para ser santa así en el cuerpo como en el espíritu: pero la casada tiene cuidado de las cosas del mundo, cómo ha de agradar a su marido.", "words": [[0, 229831], [4, 230020], [13, 230600], [24, 230960], [30, 231580], [33, 231760], [40, 232260], [42, 232480], [45, 232580], [55, 233432], [58, 233546], [67, 234106], [73, 234346], [81, 234786], [84, 235006], [88, 235146], [94, 235446], [98, 235686], [105, 236106], [110, 236466], [114, 236706], [120, 237206], [124, 237626], [127, 237786], [130, 237886], [137, 238206], [142, 238486], [145, 238626], [148, 238726], [158, 239586], [163, 239724], [166, 239974], [173, 240224], [179, 240464], [187, 240864], [190, 241084], [194, 241224], [200, 241524], [204, 241764], [211, 242544], [216, 242864], [219, 243084], [222, 243184], [230, 243644], [232, 243704], [235, 243804]]}, {"verse": 35, "start": 244637, "end": 252736, "text": "Pero esto digo para vuestro provecho; no para echaros lazo, sino para lo honesto y decente, y para que sin impedimento os lleguéis al Señor.", "words": [[0, 244637], [5, 244781], [10, 245041], [15, 245321], [20, 245561], [28, 245901], [38, 246740], [41, 246905], [46, 247105], [54, 247525], [60, 248285], [65, 248505], [70, 248745], [73, 248965], [81, 249425], [83, 249465], [92, 249965], [94, 250325], [99, 250545], [103, 250705], [107, 250885], [119, 251625], [122, 251725], [131, 252085], [134, 252245]]}, {"verse": 36, "start": 253086, "end": 261634, "text": "Pero, si a alguno le parece impropio que su hija virgen pase ya de edad, y es necesario que así sea, haga lo que quiera, no peca; cásese.", "words": [[0, 253086], [6, 253224], [9, 253314], [11, 253404], [18, 253824], [21, 253884], [28, 254164], [37, 254824], [41, 254924], [44, 255124], [49, 255424], [56, 255804], [61, 256084], [64, 256384], [67, 256524], [73, 257204], [75, 257384], [78, 257524], [88, 258044], [92, 258284], [96, 258424], [101, 259124], [106, 259364], [109, 259544], [113, 259664], [121, 260364], [124, 260464], [130, 261382]]}, {"verse": 37, "start": 261984, "end": 271602, "text": "Pero el que está firme en su corazón, y no tiene necesidad, sino que tiene libertad de su voluntad, y determinó en su corazón esto, el guardar su hija virgen, bien hace.", "words": [[0, 261984], [5, 262124], [8, 262244], [12, 262344], [17, 262544], [23, 262864], [26, 262944], [29, 263044], [38, 263504], [40, 263804], [43, 263924], [49, 264184], [60, 265164], [65, 265404], [69, 265584], [75, 265824], [84, 266404], [87, 266504], [90, 266624], [100, 267444], [102, 267524], [112, 268084], [115, 268144], [118, 268264], [126, 268604], [132, 269364], [135, 269424], [143, 269844], [146, 269964], [151, 270204], [159, 270914], [164, 271153]]}, {"verse": 38, "start": 271952, "end": 277382, "text": "Así que, el que la da en casamiento, bien hace; y el que no la da en casamiento, hace mejor.", "words": [[0, 271952], [4, 272192], [9, 272392], [12, 272532], [16, 272672], [19, 272812], [22, 272972], [25, 273092], [37, 273612], [42, 273972], [48, 274853], [50, 274955], [53, 275075], [57, 275195], [60, 275375], [63, 275495], [66, 275675], [69, 275775], [81, 276595], [86, 276835]]}, {"verse": 39, "start": 277732, "end": 286188, "text": "La mujer casada está atada a la ley, mientras vive su marido; pero si su marido muere, libre es: cásese con quien quiera, con tal que sea en el Señor.", "words": [[0, 277732], [3, 277830], [9, 278050], [16, 278570], [21, 278770], [27, 279130], [29, 279250], [32, 279310], [37, 279570], [46, 280050], [51, 280430], [54, 280650], [62, 281356], [67, 281475], [70, 281615], [73, 281755], [80, 282115], [87, 282455], [93, 282715], [97, 283424], [104, 283822], [108, 284122], [114, 284282], [122, 284822], [126, 284922], [130, 285122], [134, 285262], [138, 285462], [141, 285582], [144, 285702]]}, {"verse": 40, "start": 286538, "end": 292492, "text": "Pero más feliz será si se queda así, según mi consejo; y pienso que también yo tengo Espíritu de Dios.", "words": [[0, 286538], [5, 286677], [9, 286897], [15, 287237], [20, 287597], [23, 287797], [26, 287937], [32, 288197], [37, 288797], [43, 289017], [46, 289217], [55, 290075], [57, 290175], [64, 290515], [68, 290615], [76, 290955], [79, 291135], [85, 291375], [94, 291955], [97, 292035]]}]}