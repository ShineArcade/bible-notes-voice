{"book": "1CO", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 219749, "verses": [{"verse": 1, "start": 300, "end": 3426, "text": "Sed imitadores de mí, así como yo de Cristo.", "words": [[0, 473], [4, 653], [15, 1173], [18, 1413], [22, 2033], [26, 2233], [31, 2533], [34, 2693], [37, 2833]]}, {"verse": 2, "start": 3776, "end": 11087, "text": "Y os alabo, hermanos, que en todo os acordáis de mí, y retenéis las instrucciones mías, de la manera que os enseñé.", "words": [[0, 3776], [2, 3875], [5, 4015], [12, 4335], [22, 4995], [26, 5275], [29, 5455], [34, 5635], [37, 5915], [46, 6375], [49, 6555], [53, 6775], [55, 7375], [64, 7895], [68, 8035], [82, 8695], [88, 9295], [91, 9615], [94, 9735], [101, 9995], [105, 10255], [108, 10375]]}, {"verse": 3, "start": 11437, "end": 19123, "text": "Pero quiero que sepáis, que Cristo es la cabeza de todo varón; y el varón es la cabeza de la mujer; y Dios la cabeza de Cristo.", "words": [[0, 11437], [5, 11574], [12, 11874], [16, 12034], [24, 12594], [28, 13014], [35, 13474], [38, 13734], [41, 13854], [48, 14254], [51, 14474], [56, 14634], [63, 15381], [65, 15509], [68, 15609], [74, 15949], [77, 16069], [80, 16169], [87, 16549], [90, 16729], [93, 16829], [100, 17538], [102, 17685], [107, 17885], [110, 18085], [117, 18425], [120, 18625]]}, {"verse": 4, "start": 19473, "end": 23871, "text": "Todo varón que ora o profetiza cubierta la cabeza, deshonra su cabeza.", "words": [[0, 19473], [5, 19637], [11, 20057], [15, 20217], [19, 20457], [21, 20637], [31, 21237], [40, 21797], [43, 21917], [51, 22337], [60, 23097], [63, 23257]]}, {"verse": 5, "start": 24221, "end": 32153, "text": "Pero toda mujer que ora o profetiza no cubierta su cabeza, deshonra su cabeza; porque lo mismo es que si se afeitara la cabeza.", "words": [[0, 24221], [5, 24363], [10, 24583], [16, 24963], [20, 25243], [24, 25483], [26, 25623], [36, 26263], [39, 26463], [48, 27003], [51, 27123], [59, 28023], [68, 28463], [71, 28623], [79, 29404], [86, 29584], [89, 29724], [95, 30024], [98, 30364], [102, 30584], [105, 30744], [108, 31084], [117, 31424], [120, 31504]]}, {"verse": 6, "start": 32503, "end": 40778, "text": "Porque si la mujer no se cubre, córtese también el cabello: y si es vergonzoso para la mujer cortarse el cabello o afeitarse la cabeza, cúbrase.", "words": [[0, 32503], [7, 32667], [10, 32808], [13, 32928], [19, 33168], [22, 33428], [25, 33588], [32, 34468], [40, 34848], [48, 35188], [51, 35348], [60, 36081], [62, 36176], [65, 36276], [68, 36436], [79, 37016], [84, 37256], [87, 37376], [93, 37596], [102, 38156], [105, 38276], [113, 38696], [115, 38836], [125, 39336], [128, 39456], [136, 40196]]}, {"verse": 7, "start": 41128, "end": 47661, "text": "Porque el varón no ha de cubrir la cabeza, porque es imagen y gloria de Dios: pero la mujer es gloria del varón.", "words": [[0, 41128], [7, 41332], [10, 41472], [16, 41772], [19, 41952], [22, 42072], [25, 42172], [32, 42512], [35, 42612], [43, 43372], [50, 43672], [53, 43852], [60, 44232], [62, 44532], [69, 44912], [72, 45052], [78, 45764], [83, 45903], [86, 46023], [92, 46343], [95, 46583], [102, 46963], [106, 47143]]}, {"verse": 8, "start": 48011, "end": 51027, "text": "Porque el varón no es de la mujer, sino la mujer del varón.", "words": [[0, 48011], [7, 48228], [10, 48368], [16, 48668], [19, 48868], [22, 48988], [25, 49088], [28, 49208], [35, 49768], [40, 49948], [43, 50108], [49, 50368], [53, 50548]]}, {"verse": 9, "start": 51377, "end": 56434, "text": "Porque tampoco el varón fue creado por causa de la mujer, sino la mujer por causa del varón.", "words": [[0, 51377], [7, 51557], [15, 51877], [18, 52157], [24, 52477], [28, 52637], [35, 53117], [39, 53317], [45, 53537], [48, 53757], [51, 53857], [58, 54177], [63, 54737], [66, 54917], [72, 55197], [76, 55477], [82, 55697], [86, 55977]]}, {"verse": 10, "start": 56784, "end": 61852, "text": "Por lo cual, la mujer debe tener señal de autoridad sobre su cabeza, por causa de los ángeles.", "words": [[0, 56784], [4, 56912], [7, 57012], [13, 57292], [16, 57472], [22, 57772], [27, 58112], [33, 58432], [39, 58892], [42, 58972], [52, 59492], [58, 59752], [61, 59952], [69, 60372], [73, 60587], [79, 60847], [82, 61047], [86, 61127]]}, {"verse": 11, "start": 62202, "end": 65891, "text": "Pero ni el varón sin la mujer, ni la mujer sin el varón, en el Señor.", "words": [[0, 62202], [5, 62347], [8, 62507], [11, 62627], [17, 62947], [21, 63127], [24, 63267], [31, 63787], [34, 63887], [37, 64007], [43, 64227], [47, 64487], [50, 64627], [57, 65067], [60, 65287], [63, 65387]]}, {"verse": 12, "start": 66241, "end": 71647, "text": "Porque como la mujer es del varón, así también el varón es por la mujer: pero todo de Dios.", "words": [[0, 66241], [7, 66466], [12, 66746], [15, 66866], [21, 67186], [24, 67386], [28, 67526], [35, 68266], [39, 68506], [47, 68906], [50, 69126], [56, 69426], [59, 69546], [63, 69746], [66, 69846], [73, 70522], [78, 70664], [83, 70924], [86, 71164]]}, {"verse": 13, "start": 71997, "end": 76196, "text": "Juzgad vosotros mismos: ¿es apropiado orar la mujer a Dios no cubierta?", "words": [[0, 71997], [7, 72428], [16, 72888], [24, 73760], [28, 73921], [38, 74421], [43, 74701], [46, 74801], [52, 75041], [54, 75201], [59, 75381], [62, 75541]]}, {"verse": 14, "start": 76546, "end": 81793, "text": "La misma naturaleza ¿no os enseña que al hombre sea deshonroso dejarse crecer el cabello?", "words": [[0, 76546], [3, 76643], [9, 76903], [20, 77743], [24, 77963], [27, 78163], [34, 78703], [38, 78883], [41, 79043], [48, 79243], [52, 79543], [63, 80263], [71, 80703], [78, 81083], [81, 81223]]}, {"verse": 15, "start": 82143, "end": 88467, "text": "Por el contrario, a la mujer dejarse crecer el cabello le es honroso; porque en lugar de velo le es dado el cabello.", "words": [[0, 82143], [4, 82270], [7, 82370], [18, 83010], [20, 83090], [23, 83170], [29, 83410], [37, 83970], [44, 84330], [47, 84470], [55, 84910], [58, 85090], [61, 85525], [70, 86122], [77, 86350], [80, 86490], [86, 86710], [89, 86970], [94, 87250], [97, 87380], [100, 87510], [105, 87750], [108, 87910]]}, {"verse": 16, "start": 88817, "end": 95321, "text": "Con todo eso, si alguno parece ser contencioso, nosotros no tenemos tal costumbre, ni las iglesias de Dios.", "words": [[0, 88817], [4, 88939], [9, 89159], [14, 89579], [17, 89679], [24, 90079], [31, 90359], [35, 90659], [48, 91839], [57, 92159], [60, 92519], [68, 92859], [72, 93119], [83, 93779], [86, 94079], [90, 94279], [99, 94739], [102, 94879]]}, {"verse": 17, "start": 95671, "end": 100896, "text": "Pero os doy esta instrucción sin alabaros, porque os reunís no para lo mejor, sino para lo peor.", "words": [[0, 95671], [5, 95828], [8, 95988], [12, 96248], [17, 96428], [29, 97008], [33, 97188], [43, 97928], [50, 98088], [53, 98288], [60, 98708], [63, 98888], [68, 99088], [71, 99248], [78, 99888], [83, 100048], [88, 100308], [91, 100468]]}, {"verse": 18, "start": 101246, "end": 107361, "text": "Porque lo primero, cuando os juntáis en la iglesia, oigo que hay entre vosotros divisiones; y en parte lo creo.", "words": [[0, 101246], [7, 101431], [10, 101591], [19, 102031], [26, 102211], [29, 102451], [37, 102871], [40, 102991], [43, 103091], [52, 103951], [57, 104131], [61, 104331], [65, 104491], [71, 104691], [80, 105151], [92, 106234], [94, 106373], [97, 106453], [103, 106713], [106, 106933]]}, {"verse": 19, "start": 107711, "end": 114158, "text": "Porque preciso es que haya entre vosotros aun bandos, para que los que son probados se manifiesten entre vosotros.", "words": [[0, 107711], [7, 107916], [15, 108356], [18, 108656], [22, 108816], [27, 109016], [33, 109296], [42, 109856], [46, 110096], [54, 110696], [59, 111216], [63, 111376], [67, 111496], [71, 111656], [75, 111836], [84, 112356], [87, 112556], [99, 113196], [105, 113396]]}, {"verse": 20, "start": 114508, "end": 118621, "text": "Cuando pues os juntáis en uno, esto no es comer la cena del Señor:", "words": [[0, 114508], [7, 114717], [12, 114971], [15, 115224], [23, 115724], [26, 115904], [31, 116624], [36, 116844], [39, 117044], [42, 117144], [48, 117384], [51, 117564], [56, 117824], [60, 118004]]}, {"verse": 21, "start": 118971, "end": 125007, "text": "Porque cada uno toma antes para comer su propia cena; y el uno tiene hambre, y el otro está embriagado.", "words": [[0, 118971], [7, 119155], [12, 119415], [16, 119655], [21, 120015], [27, 120335], [32, 120575], [38, 120835], [41, 121075], [48, 121295], [54, 122114], [56, 122232], [59, 122332], [63, 122472], [69, 122772], [77, 123252], [79, 123652], [82, 123772], [87, 123992], [92, 124232]]}, {"verse": 22, "start": 125357, "end": 135737, "text": "Pues qué, ¿no tenéis casas en que comáis y bebáis? ¿o menospreciáis la iglesia de Dios, y avergonzáis a los que no tienen? ¿Qué os diré? ¿os alabaré? En esto no os alabo.", "words": [[0, 125357], [5, 125505], [10, 125725], [14, 125845], [21, 126225], [27, 126685], [30, 126845], [34, 126965], [41, 127445], [43, 127605], [51, 128452], [54, 128869], [68, 129329], [71, 129469], [79, 129829], [82, 130009], [88, 130309], [90, 130689], [102, 131329], [104, 131489], [108, 131609], [112, 131729], [115, 131869], [123, 132559], [128, 132671], [131, 132771], [137, 133720], [141, 134014], [150, 134472], [153, 134609], [158, 134849], [161, 135129], [164, 135289]]}, {"verse": 23, "start": 136087, "end": 142706, "text": "Porque yo recibí del Señor lo que también os he enseñado: Que el Señor Jesús, la noche que fue entregado, tomó pan;", "words": [[0, 136087], [7, 136280], [10, 136460], [17, 136940], [21, 137020], [27, 137360], [30, 137580], [34, 137700], [42, 138020], [45, 138260], [48, 138380], [58, 139296], [62, 139380], [65, 139460], [71, 139680], [78, 140400], [81, 140500], [87, 140700], [91, 140880], [95, 141060], [106, 142020], [111, 142280]]}, {"verse": 24, "start": 143056, "end": 152575, "text": "Y habiendo dado gracias, lo partió, y dijo: Tomad, comed: esto es mi cuerpo que por vosotros es partido: haced esto en memoria de mí.", "words": [[0, 143056], [2, 143181], [11, 143481], [16, 143701], [25, 144441], [28, 144521], [36, 144981], [38, 145221], [44, 146258], [51, 146596], [58, 147096], [63, 147374], [66, 147594], [69, 147774], [76, 148134], [80, 148414], [84, 148634], [93, 149214], [96, 149394], [105, 150391], [111, 150970], [116, 151490], [119, 151630], [127, 152090], [130, 152250]]}, {"verse": 25, "start": 152795, "end": 164329, "text": "Asimismo tomó también la copa, después de haber cenado, diciendo: Esta copa es el nuevo pacto en mi sangre: haced esto todas las veces que bebáis, en memoria de mí.", "words": [[0, 153093], [9, 153423], [14, 153803], [22, 154023], [25, 154243], [31, 154883], [39, 155123], [42, 155363], [48, 155483], [56, 156303], [66, 157178], [71, 157457], [76, 157977], [79, 158077], [82, 158257], [88, 158497], [94, 159117], [97, 159217], [100, 159397], [108, 160408], [114, 160598], [119, 161098], [125, 161558], [129, 161938], [135, 162258], [139, 162458], [147, 163038], [150, 163378], [158, 163838], [161, 164018]]}, {"verse": 26, "start": 164549, "end": 171200, "text": "Porque todas las veces que coméis este pan, y bebéis esta copa, la muerte del Señor anunciáis hasta que venga.", "words": [[0, 164549], [7, 164756], [13, 164996], [17, 165296], [23, 165616], [27, 165836], [34, 166256], [39, 166516], [44, 166856], [46, 167136], [53, 167516], [58, 167776], [64, 168616], [67, 168676], [74, 168976], [78, 169196], [84, 169536], [94, 170336], [100, 170556], [104, 170736]]}, {"verse": 27, "start": 171550, "end": 179322, "text": "De manera que, cualquiera que coma este pan o beba esta copa del Señor indignamente, será culpado del cuerpo y de la sangre del Señor.", "words": [[0, 171550], [3, 171645], [10, 171865], [15, 172145], [26, 172665], [30, 172825], [35, 173105], [40, 173425], [44, 173825], [46, 174105], [51, 174325], [56, 174545], [61, 174985], [65, 175105], [71, 175425], [85, 176265], [90, 176785], [98, 177325], [102, 177485], [109, 177845], [111, 178125], [114, 178205], [117, 178325], [124, 178665], [128, 178865]]}, {"verse": 28, "start": 179672, "end": 185045, "text": "Por tanto, pruébese cada uno a sí mismo, y coma así de aquel pan, y beba de aquella copa.", "words": [[0, 179672], [4, 179798], [11, 180198], [20, 180758], [25, 180998], [29, 181278], [31, 181458], [34, 181558], [41, 181938], [43, 182298], [48, 182578], [52, 182878], [55, 183018], [61, 183298], [66, 183518], [68, 183898], [73, 184178], [76, 184278], [84, 184598]]}, {"verse": 29, "start": 185395, "end": 191737, "text": "Porque el que come y bebe indignamente, juicio come y bebe para sí, no discerniendo el cuerpo del Señor.", "words": [[0, 185395], [7, 185575], [10, 185695], [14, 185815], [19, 186155], [21, 186375], [26, 186595], [40, 187635], [47, 188195], [52, 188555], [54, 188775], [59, 189075], [64, 189275], [68, 189955], [71, 190035], [84, 190695], [87, 190815], [94, 191035], [98, 191275]]}, {"verse": 30, "start": 192087, "end": 196582, "text": "Por lo cual hay muchos enfermos y debilitados entre vosotros; y muchos duermen.", "words": [[0, 192087], [4, 192188], [7, 192348], [12, 192528], [16, 192708], [23, 192928], [32, 193648], [34, 193788], [46, 194408], [52, 194688], [62, 195678], [64, 195763], [71, 195983]]}, {"verse": 31, "start": 196932, "end": 201280, "text": "Que si nos examinásemos a nosotros mismos, cierto no seríamos juzgados.", "words": [[0, 196932], [4, 197010], [7, 197130], [11, 197250], [24, 198110], [26, 198250], [35, 198490], [43, 199550], [50, 199950], [53, 200030], [62, 200470]]}, {"verse": 32, "start": 201630, "end": 206659, "text": "Pero siendo juzgados, somos castigados del Señor, para que no seamos condenados con el mundo.", "words": [[0, 201630], [5, 201774], [12, 202094], [22, 202734], [28, 203074], [39, 203544], [43, 204014], [50, 204354], [55, 204619], [59, 204759], [62, 204879], [69, 205259], [80, 205839], [84, 205999], [87, 206159]]}, {"verse": 33, "start": 207009, "end": 212180, "text": "Así, que, hermanos míos, cuando os juntáis a comer, esperaos unos a otros.", "words": [[0, 207009], [5, 207254], [10, 207514], [19, 207894], [25, 208614], [32, 208754], [35, 208954], [43, 209394], [45, 209494], [52, 210194], [61, 210854], [66, 211214], [68, 211614]]}, {"verse": 34, "start": 212530, "end": 219349, "text": "Si alguno tiene hambre, coma en su casa, porque no os juntéis para juicio. Las demás cosas ordenaré cuando llegue.", "words": [[0, 212530], [3, 212675], [10, 213055], [16, 213295], [24, 213915], [29, 214115], [32, 214295], [35, 214415], [41, 215055], [48, 215335], [51, 215595], [54, 215715], [62, 216135], [67, 216375], [75, 217195], [79, 217314], [85, 217574], [91, 217974], [100, 218574], [107, 218754]]}]}