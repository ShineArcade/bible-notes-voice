{"book": "ACT", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 382184, "verses": [{"verse": 1, "start": 300, "end": 7701, "text": "Y Saulo, respirando aún amenazas y muerte contra los discípulos del Señor, vino al sumo sacerdote,", "words": [[0, 300], [2, 421], [9, 922], [20, 1423], [24, 1924], [33, 2425], [35, 2926], [42, 3286], [49, 3686], [53, 3926], [64, 4566], [68, 4726], [75, 5726], [80, 6066], [83, 6426], [88, 6846]]}, {"verse": 2, "start": 8051, "end": 18809, "text": "Y pidió de él cartas para las sinagogas de Damasco, para que si hallase algunos hombres o mujeres de esta secta, los trajese presos a Jerusalén.", "words": [[0, 8051], [2, 8209], [8, 8609], [11, 8749], [14, 8929], [21, 9609], [26, 9889], [30, 10109], [40, 10889], [43, 11029], [52, 12109], [57, 12449], [61, 12729], [64, 12769], [72, 13189], [80, 13529], [88, 14169], [90, 14509], [98, 14969], [101, 15189], [106, 15429], [113, 16529], [117, 16629], [125, 17089], [132, 17849], [134, 17969]]}, {"verse": 3, "start": 19159, "end": 27709, "text": "Y yendo por el camino, aconteció que llegando cerca de Damasco, repentinamente le cercó un resplandor de luz del cielo;", "words": [[0, 19159], [2, 19159], [8, 19625], [12, 19885], [15, 20045], [23, 20840], [33, 21520], [37, 21720], [46, 22220], [52, 22540], [55, 22800], [64, 23780], [79, 24740], [82, 24980], [88, 25500], [91, 25640], [102, 26460], [105, 26580], [109, 26780], [113, 27040]]}, {"verse": 4, "start": 28059, "end": 34835, "text": "Y cayendo en tierra, oyó una voz que le decía: Saulo, Saulo, ¿por qué me persigues?", "words": [[0, 28059], [2, 28182], [10, 28642], [13, 28782], [21, 29222], [25, 30002], [29, 30222], [33, 30522], [37, 30782], [40, 30902], [47, 32092], [54, 32362], [61, 33462], [66, 33562], [70, 33722], [73, 33862]]}, {"verse": 5, "start": 35185, "end": 44157, "text": "Y él dijo: ¿Quién eres, Señor? Y él dijo: Yo soy Jesús a quien tú persigues: dura cosa te es dar coces contra el aguijón.", "words": [[0, 35185], [2, 35352], [5, 35729], [11, 36263], [18, 36463], [24, 36723], [31, 37440], [33, 37630], [36, 37750], [42, 38519], [45, 38708], [49, 38948], [55, 39328], [57, 39568], [63, 39708], [66, 39968], [77, 41097], [82, 41380], [87, 41700], [90, 41980], [93, 42180], [97, 42460], [103, 42740], [110, 43240], [113, 43699]]}, {"verse": 6, "start": 44507, "end": 55788, "text": "Él, temblando y temeroso, dijo: Señor, ¿qué quieres que haga? Y el Señor le dice: Levántate y entra en la ciudad, y se te dirá lo que te conviene hacer.", "words": [[0, 44507], [4, 44817], [14, 45477], [16, 45597], [26, 46117], [32, 46968], [39, 47730], [44, 47850], [52, 48110], [56, 48310], [62, 49011], [64, 49168], [67, 49308], [73, 49628], [76, 49868], [82, 50651], [92, 51379], [94, 51706], [100, 52034], [103, 52174], [106, 52274], [114, 52634], [116, 53219], [119, 53359], [122, 53689], [127, 54019], [130, 54419], [134, 54559], [137, 54699], [146, 55179]]}, {"verse": 7, "start": 56138, "end": 63488, "text": "Y los hombres que iban con Saulo, se pararon atónitos, oyendo a la verdad la voz, pero no viendo a nadie.", "words": [[0, 56138], [2, 56239], [6, 56399], [14, 56779], [18, 57079], [23, 57379], [27, 57599], [34, 58225], [37, 58851], [45, 59478], [55, 60104], [62, 60524], [64, 60664], [67, 60724], [74, 61004], [77, 61264], [82, 61964], [87, 62284], [90, 62464], [97, 62764], [99, 62944]]}, {"verse": 8, "start": 63838, "end": 73405, "text": "Entonces Saulo se levantó de tierra, y abriendo los ojos, no veía a nadie: así que, llevándole por la mano, le metieron en Damasco;", "words": [[0, 63838], [9, 64422], [15, 65022], [18, 65262], [26, 65862], [29, 65962], [37, 66422], [39, 67062], [48, 67482], [52, 67722], [58, 68042], [61, 68487], [66, 68967], [68, 69107], [75, 69893], [79, 70136], [84, 70736], [95, 71216], [99, 71436], [102, 71616], [108, 71976], [111, 72036], [120, 72496], [123, 72676]]}, {"verse": 9, "start": 73755, "end": 77682, "text": "Donde estuvo tres días sin ver, y no comió, ni bebió.", "words": [[0, 73755], [6, 73981], [13, 74421], [18, 74701], [23, 75081], [27, 75361], [32, 75601], [34, 75941], [37, 76121], [44, 76661], [47, 77141]]}, {"verse": 10, "start": 78032, "end": 88362, "text": "Había entonces un discípulo en Damasco llamado Ananías, al cual el Señor dijo en visión: Ananías. Y él respondió: Aquí estoy, Señor.", "words": [[0, 78032], [6, 78343], [15, 78723], [18, 79063], [28, 79643], [31, 79783], [39, 80223], [47, 80463], [56, 81903], [59, 82003], [64, 82223], [67, 82443], [73, 82763], [78, 83363], [81, 83743], [89, 84661], [98, 85819], [100, 85967], [103, 86107], [114, 87097], [119, 87357], [126, 87817]]}, {"verse": 11, "start": 88642, "end": 100672, "text": "Y el Señor le dijo: Levántate, y ve a la calle que se llama la Derecha, y busca en casa de Judas a uno llamado Saulo, de Tarso: porque he aquí, él ora;", "words": [[0, 88642], [2, 88810], [5, 88950], [11, 89230], [14, 89490], [20, 90176], [31, 90844], [33, 91344], [36, 91504], [38, 91644], [41, 91744], [47, 92144], [51, 92444], [54, 92604], [60, 92904], [63, 93084], [72, 93864], [74, 94064], [80, 94344], [83, 94584], [88, 94884], [91, 95164], [97, 95484], [99, 95904], [103, 96064], [111, 96364], [118, 97144], [121, 97564], [128, 98577], [135, 98824], [138, 99104], [144, 99444], [147, 100078]]}, {"verse": 12, "start": 101022, "end": 109245, "text": "Y ha visto en visión un varón llamado Ananías, que entra y le pone la mano encima, para que reciba la vista.", "words": [[0, 101022], [2, 101166], [5, 101266], [11, 101526], [14, 101726], [21, 102146], [24, 102406], [30, 102846], [38, 103126], [47, 104526], [51, 104786], [57, 105226], [59, 105706], [62, 105826], [67, 106086], [70, 106306], [75, 106566], [83, 107146], [88, 107786], [92, 108116], [99, 108446], [102, 108606]]}, {"verse": 13, "start": 109595, "end": 118124, "text": "Entonces Ananías respondió: Señor, he oído a muchos acerca de este hombre, cuántos males ha hecho a tus santos en Jerusalén:", "words": [[0, 109595], [9, 110235], [17, 111115], [28, 112409], [35, 113105], [38, 113185], [43, 113445], [45, 113585], [52, 113805], [59, 114265], [62, 114545], [67, 114765], [75, 115505], [83, 115845], [89, 116125], [92, 116405], [98, 116625], [100, 116745], [104, 116885], [111, 117345], [114, 117465]]}, {"verse": 14, "start": 118474, "end": 124007, "text": "Y aun aquí tiene autoridad de los principales sacerdotes de prender a todos los que invocan tu nombre.", "words": [[0, 118474], [2, 118576], [6, 118716], [11, 119076], [17, 119376], [27, 119916], [30, 120056], [34, 120136], [46, 120816], [57, 121516], [60, 121696], [68, 122176], [70, 122256], [76, 122476], [80, 122716], [84, 122916], [92, 123376], [95, 123516]]}, {"verse": 15, "start": 124287, "end": 134797, "text": "Y le dijo el Señor: Ve: porque instrumento escogido me es este, para que lleve mi nombre en presencia de los Gentiles, y de reyes, y de los hijos de Israel:", "words": [[0, 124287], [2, 124409], [5, 124509], [10, 124769], [13, 124929], [20, 125891], [24, 126294], [31, 126498], [43, 127478], [52, 128058], [55, 128238], [58, 128478], [64, 128878], [69, 129478], [73, 129598], [79, 129918], [82, 130058], [89, 130378], [92, 130558], [102, 131158], [105, 131318], [109, 131458], [119, 132078], [121, 132498], [124, 132618], [131, 133098], [133, 133358], [136, 133478], [140, 133598], [146, 133898], [149, 134118]]}, {"verse": 16, "start": 135147, "end": 139149, "text": "Porque yo le mostraré cuánto tendrá que padecer por mi nombre.", "words": [[0, 135147], [7, 135395], [10, 135655], [13, 135795], [22, 136415], [29, 136935], [36, 137315], [40, 137435], [48, 138095], [52, 138355], [55, 138555]]}, {"verse": 17, "start": 139499, "end": 154926, "text": "Ananías entonces fue, y entró en la casa, y poniéndole las manos encima, dijo: Saulo hermano, el Señor Jesús, que te apareció en el camino por donde venías, me ha enviado para que recibas la vista y seas lleno de Espíritu Santo.", "words": [[0, 139499], [8, 140099], [17, 140519], [22, 141039], [24, 141379], [30, 141779], [33, 141879], [36, 142019], [42, 142419], [44, 142939], [55, 143399], [59, 143859], [65, 144319], [73, 144739], [79, 145910], [85, 146422], [94, 146822], [97, 146862], [103, 147122], [110, 148262], [114, 148322], [117, 148462], [126, 148922], [129, 149002], [132, 149122], [139, 149422], [143, 149722], [149, 149962], [157, 150942], [160, 151122], [163, 151242], [171, 151702], [176, 151922], [180, 152232], [188, 152542], [191, 152722], [197, 152982], [199, 153182], [204, 153382], [210, 153782], [213, 153882], [222, 154342]]}, {"verse": 18, "start": 155206, "end": 163566, "text": "Y de inmediato le cayeron de los ojos como escamas, y recibió al punto la vista: y levantándose, fue bautizado.", "words": [[0, 155206], [2, 155407], [5, 155487], [15, 156247], [18, 156407], [26, 156907], [29, 157027], [33, 157167], [38, 157487], [43, 157787], [52, 158427], [54, 158967], [62, 159727], [65, 159907], [71, 160247], [74, 160487], [81, 161324], [83, 161581], [97, 162361], [101, 162601]]}, {"verse": 19, "start": 163916, "end": 170882, "text": "Y como comió, recobró las fuerzas. Y estuvo Saulo por algunos días con los discípulos que estaban en Damasco.", "words": [[0, 163916], [2, 164055], [7, 164495], [14, 164935], [22, 165435], [26, 165595], [35, 166702], [37, 166859], [44, 167049], [50, 167589], [54, 167829], [62, 168109], [67, 168449], [71, 168669], [75, 168789], [86, 169389], [90, 169589], [98, 169909], [101, 170129]]}, {"verse": 20, "start": 171232, "end": 177675, "text": "Y de inmediato en las sinagogas predicaba a Cristo, diciendo que este era el Hijo de Dios.", "words": [[0, 171232], [2, 171572], [5, 171652], [15, 172552], [18, 172839], [22, 173125], [32, 173412], [42, 174172], [44, 174352], [52, 175117], [61, 175557], [65, 175917], [70, 176257], [74, 176497], [77, 176657], [82, 176917], [85, 177057]]}, {"verse": 21, "start": 178025, "end": 190001, "text": "Y todos los que le oían estaban atónitos, y decían: ¿No es este el que asolaba en Jerusalén a los que invocaban este nombre, y a eso vino acá, para llevarlos presos a los principales sacerdotes?", "words": [[0, 178025], [2, 178153], [8, 178493], [12, 179033], [16, 179213], [19, 179353], [24, 179713], [32, 179993], [42, 181233], [44, 181313], [52, 182428], [56, 182626], [59, 182786], [64, 183066], [67, 183166], [71, 183286], [79, 183706], [82, 183806], [92, 184406], [94, 184486], [98, 184606], [102, 184746], [112, 185246], [117, 185486], [125, 185826], [127, 186101], [129, 186221], [133, 186421], [138, 186701], [143, 187061], [148, 187444], [158, 187826], [165, 188286], [167, 188386], [171, 188506], [183, 189126]]}, {"verse": 22, "start": 190281, "end": 198680, "text": "Pero Saulo mucho más se esforzaba, y confundía a los judíos que moraban en Damasco, afirmando que este es el Cristo.", "words": [[0, 190281], [5, 190466], [11, 190866], [17, 191186], [21, 191486], [24, 191726], [35, 192506], [37, 192986], [47, 193726], [49, 193946], [53, 194046], [60, 194566], [64, 194726], [72, 195186], [75, 195366], [84, 196246], [94, 196986], [98, 197186], [103, 197526], [106, 197806], [109, 197926]]}, {"verse": 23, "start": 199030, "end": 202678, "text": "Y como pasaron muchos días, los judíos tramaron matarlo;", "words": [[0, 199030], [2, 199139], [7, 199359], [15, 199799], [22, 200079], [28, 200799], [32, 200879], [39, 201339], [48, 201819]]}, {"verse": 24, "start": 203028, "end": 210002, "text": "Pero las tramas de ellos fueron entendidas de Saulo. Y ellos guardaban las puertas de día y de noche para matarle.", "words": [[0, 203028], [5, 203170], [9, 203370], [16, 203770], [19, 203930], [25, 204110], [32, 204430], [43, 205230], [46, 205390], [53, 206198], [55, 206566], [61, 206786], [71, 207346], [75, 207526], [83, 207926], [86, 208086], [90, 208326], [92, 208526], [95, 208646], [101, 208946], [106, 209226]]}, {"verse": 25, "start": 210352, "end": 216914, "text": "Entonces los discípulos, tomándole de noche, le bajaron por el muro en una canasta.", "words": [[0, 210352], [9, 211038], [13, 211573], [25, 212733], [35, 213508], [38, 213708], [45, 214048], [48, 214588], [56, 215068], [60, 215308], [63, 215488], [68, 215868], [71, 216008], [75, 216168]]}, {"verse": 26, "start": 217264, "end": 226503, "text": "Y cuando vino a Jerusalén, intentaba juntarse con los discípulos; pero todos tenían miedo de él, no creyendo que era discípulo.", "words": [[0, 217264], [2, 217350], [9, 217570], [14, 217870], [16, 218030], [27, 218770], [37, 219590], [46, 220330], [50, 220550], [54, 220730], [66, 221856], [71, 222000], [77, 222400], [84, 222940], [90, 223400], [93, 223660], [97, 224300], [100, 224580], [109, 225160], [113, 225360], [117, 225560]]}, {"verse": 27, "start": 226853, "end": 241640, "text": "Entonces Bernabé, tomándole, lo trajo a los apóstoles, y les contó cómo había visto al Señor en el camino, y que le había hablado, y cómo en Damasco había hablado confiadamente en el nombre de Jesús.", "words": [[0, 226853], [9, 227451], [18, 228291], [29, 229691], [32, 229971], [38, 230371], [40, 230471], [44, 230591], [55, 231331], [57, 231636], [61, 231776], [67, 232276], [72, 232536], [78, 232896], [84, 233236], [87, 233416], [93, 233756], [96, 234016], [99, 234116], [107, 234636], [109, 235176], [113, 235296], [116, 235476], [122, 235756], [131, 236757], [133, 236882], [138, 237222], [141, 237422], [149, 238022], [155, 238322], [163, 238982], [177, 239782], [180, 240222], [183, 240362], [190, 240742], [193, 240942]]}, {"verse": 28, "start": 241990, "end": 245217, "text": "Y entraba y salía con ellos en Jerusalén;", "words": [[0, 241990], [2, 242155], [10, 242875], [12, 243095], [18, 243555], [22, 243815], [28, 244115], [31, 244355]]}, {"verse": 29, "start": 245567, "end": 254105, "text": "Y hablaba confiadamente en el nombre del Señor: y debatía con los judíos de habla griega; pero ellos procuraban matarle.", "words": [[0, 245567], [2, 245787], [10, 246207], [24, 247067], [27, 247407], [30, 247547], [37, 247867], [41, 248107], [48, 248966], [50, 249088], [58, 249728], [62, 249968], [66, 250128], [73, 250748], [76, 250908], [82, 251148], [90, 252116], [95, 252263], [101, 252483], [112, 253223]]}, {"verse": 30, "start": 254455, "end": 260608, "text": "Lo cual, como los hermanos entendieron, le acompañaron hasta Cesarea, y le enviaron a Tarso.", "words": [[0, 254455], [3, 254600], [9, 254920], [14, 255060], [18, 255240], [27, 255760], [40, 256560], [43, 256600], [55, 257400], [61, 257700], [70, 258400], [72, 259080], [75, 259220], [84, 259840], [86, 260000]]}, {"verse": 31, "start": 260958, "end": 274836, "text": "Las iglesias entonces tenían paz por toda Judea y Galilea y Samaria, y eran edificadas, andando en el temor del Señor; y con consuelo del Espíritu Santo eran multiplicadas.", "words": [[0, 260958], [4, 261097], [13, 261777], [22, 262297], [29, 262897], [33, 263297], [37, 263717], [42, 264037], [48, 264797], [50, 264897], [58, 265557], [60, 265697], [69, 266297], [71, 266917], [76, 267217], [88, 268717], [96, 269317], [99, 269437], [102, 269577], [108, 269997], [112, 270157], [119, 271128], [121, 271226], [125, 271446], [134, 272166], [138, 272266], [147, 272826], [153, 273086], [158, 273366]]}, {"verse": 32, "start": 275186, "end": 282952, "text": "Y aconteció que Pedro, recorriendo todos aquellos lugares, vino también a los santos que habitaban en Lida.", "words": [[0, 275186], [2, 275314], [12, 275914], [16, 276094], [23, 277074], [35, 278094], [41, 278394], [50, 278794], [59, 279914], [64, 280074], [72, 280534], [74, 280814], [78, 280914], [85, 281474], [89, 281594], [99, 282094], [102, 282274]]}, {"verse": 33, "start": 283302, "end": 290643, "text": "Y halló allí a uno que se llamaba Eneas, que hacía ocho años que estaba en cama, que era paralítico.", "words": [[0, 283302], [2, 283442], [8, 283742], [13, 284082], [15, 284342], [19, 284522], [23, 284682], [26, 284822], [34, 285662], [41, 286502], [45, 286542], [51, 286882], [56, 287442], [61, 287742], [65, 287982], [72, 288262], [75, 288502], [81, 289442], [85, 289562], [89, 289702]]}, {"verse": 34, "start": 290993, "end": 298666, "text": "Y le dijo Pedro: Eneas, Jesucristo te sana; levántate, y hazte tu cama. Y de inmediato se levantó.", "words": [[0, 290993], [2, 291141], [5, 291201], [10, 291461], [17, 292345], [24, 292845], [35, 293565], [38, 293745], [44, 294478], [55, 295162], [57, 295462], [63, 295802], [66, 295962], [72, 296664], [74, 296825], [77, 296905], [87, 297665], [90, 297845]]}, {"verse": 35, "start": 299016, "end": 305061, "text": "Y le vieron todos los que habitaban en Lida y en Sarón, los cuales se convirtieron al Señor.", "words": [[0, 299016], [2, 299145], [5, 299265], [12, 299585], [18, 299985], [22, 300445], [26, 300645], [36, 301165], [39, 301305], [44, 301705], [46, 301845], [49, 302355], [56, 302865], [60, 302965], [67, 303205], [70, 303445], [83, 304245], [86, 304445]]}, {"verse": 36, "start": 305411, "end": 315816, "text": "Entonces en Jope había una discípula llamada Tabita, que traducido quiere decir Dorcas. Esta era llena de buenas obras y de limosnas que hacía.", "words": [[0, 305411], [9, 306137], [12, 306587], [17, 307037], [23, 307257], [27, 307497], [37, 308277], [45, 308717], [53, 309337], [57, 309837], [67, 310537], [74, 310777], [80, 311488], [88, 312367], [93, 312634], [97, 312814], [103, 313174], [106, 313314], [113, 313554], [119, 314034], [121, 314374], [124, 314674], [133, 314974], [137, 315174]]}, {"verse": 37, "start": 316166, "end": 322761, "text": "Y aconteció en aquellos días que enfermando, murió; a la cual, después de lavada, pusieron en una sala.", "words": [[0, 316166], [2, 316482], [12, 316828], [15, 317175], [24, 317375], [29, 317735], [33, 317995], [45, 319095], [52, 319863], [54, 319969], [57, 320049], [63, 320249], [71, 320529], [74, 320889], [82, 321249], [91, 321694], [94, 322034], [98, 322194]]}, {"verse": 38, "start": 323111, "end": 333755, "text": "Y como Lida estaba cerca de Jope, los discípulos, oyendo que Pedro estaba allí, le enviaron dos hombres, rogándole: No tardes en venir hasta nosotros.", "words": [[0, 323111], [2, 323377], [7, 323747], [12, 324117], [19, 324457], [25, 324837], [28, 325137], [34, 326077], [38, 326157], [50, 327277], [57, 327577], [61, 327757], [67, 327997], [74, 328297], [80, 329137], [83, 329237], [92, 329757], [96, 330037], [105, 330857], [116, 331842], [119, 332045], [126, 332465], [129, 332625], [135, 332885], [141, 333125]]}, {"verse": 39, "start": 334035, "end": 349547, "text": "Pedro entonces levantándose, fue con ellos: y llegado que hubo, le llevaron a la sala, donde le rodearon todas las viudas, llorando y mostrando las túnicas y los vestidos que Dorcas hacía cuando estaba con ellas.", "words": [[0, 334035], [6, 334279], [15, 335379], [29, 336639], [33, 336879], [37, 337139], [44, 337950], [46, 338058], [54, 338458], [58, 338678], [64, 339158], [67, 339638], [76, 340098], [78, 340218], [81, 340298], [87, 341238], [93, 341598], [96, 341958], [105, 342658], [111, 343018], [115, 343338], [123, 344278], [132, 344738], [134, 344838], [144, 345378], [148, 345558], [156, 346218], [158, 346498], [162, 346638], [171, 347158], [175, 347318], [182, 347698], [188, 348118], [195, 348398], [202, 348738], [206, 348998]]}, {"verse": 40, "start": 349897, "end": 362405, "text": "Entonces echados fuera todos, Pedro puesto de rodillas, oró; y vuelto al cuerpo, dijo: Tabita, levántate. Y ella abrió los ojos, y viendo a Pedro, se incorporó.", "words": [[0, 349897], [9, 350458], [17, 351258], [23, 351598], [30, 352398], [36, 352838], [43, 353278], [46, 353578], [56, 354358], [61, 354988], [63, 355113], [70, 355513], [73, 355613], [81, 356033], [87, 356928], [95, 357350], [106, 358240], [108, 358439], [113, 358699], [119, 359199], [123, 359379], [129, 359859], [131, 360164], [138, 360444], [140, 360624], [147, 360964], [150, 361319]]}, {"verse": 41, "start": 362755, "end": 370153, "text": "Y él le dio la mano, y la levantó: entonces llamando a los santos y las viudas, la presentó viva.", "words": [[0, 362755], [2, 362915], [5, 363055], [8, 363215], [12, 363395], [15, 363535], [21, 363935], [23, 364180], [26, 364300], [35, 365281], [44, 366161], [53, 366661], [55, 366741], [59, 366841], [66, 367441], [68, 367561], [72, 367721], [80, 368621], [83, 368961], [92, 369501]]}, {"verse": 42, "start": 370503, "end": 375199, "text": "Esto fue notorio por toda Jope; y creyeron muchos en el Señor.", "words": [[0, 370503], [5, 370809], [9, 371049], [17, 371629], [21, 371869], [26, 372346], [32, 372971], [34, 373324], [43, 373714], [50, 374194], [53, 374474], [56, 374654]]}, {"verse": 43, "start": 375549, "end": 381785, "text": "Y aconteció que se quedó muchos días en Jope en casa de un cierto Simón, curtidor.", "words": [[0, 375549], [2, 375869], [12, 376629], [16, 376829], [19, 376989], [25, 377349], [32, 377589], [37, 377969], [40, 378289], [45, 378609], [48, 378969], [53, 379309], [56, 379609], [59, 379729], [66, 379949], [73, 380885]]}]}