{"book": "1CO", "chapter": 14, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 272059, "verses": [{"verse": 1, "start": 300, "end": 6114, "text": "SEGUID el amor; y procurad los dones espirituales, pero sobre todo que profeticéis.", "words": [[0, 464], [7, 630], [10, 797], [16, 1477], [18, 1787], [27, 2137], [31, 2317], [37, 2717], [51, 3897], [56, 4217], [62, 4517], [67, 4857], [71, 5077]]}, {"verse": 2, "start": 6464, "end": 13909, "text": "Porque el que habla en lenguas, no habla a los hombres, sino a Dios; porque nadie le entiende, aunque en espíritu hable misterios.", "words": [[0, 6464], [7, 6666], [10, 6846], [14, 6986], [20, 7246], [23, 7406], [32, 7906], [35, 8186], [41, 8446], [43, 8586], [47, 8686], [56, 9366], [61, 9506], [63, 9666], [69, 10335], [76, 10515], [82, 10775], [85, 11015], [95, 11815], [102, 11995], [105, 12155], [114, 12815], [120, 13115]]}, {"verse": 3, "start": 14259, "end": 19617, "text": "Pero el que profetiza, habla a los hombres para edificación, y exhortación, y consolación.", "words": [[0, 14259], [5, 14378], [8, 14538], [12, 14638], [23, 15358], [29, 15958], [31, 16138], [35, 16238], [43, 16558], [48, 16838], [61, 17458], [63, 17898], [76, 18578], [78, 18798]]}, {"verse": 4, "start": 19967, "end": 26570, "text": "El que habla lengua extraña, a sí mismo se edifica; pero el que profetiza, edifica a la iglesia.", "words": [[0, 19967], [3, 20248], [7, 20368], [13, 20588], [20, 20988], [29, 21328], [31, 21668], [34, 22008], [40, 22348], [43, 22488], [52, 24069], [57, 24208], [60, 24328], [64, 24428], [75, 25128], [83, 25458], [85, 25788], [88, 25988]]}, {"verse": 5, "start": 26920, "end": 38575, "text": "Así que, quisiera que todos vosotros hablaseis lenguas, pero más que profetizaseis: porque mayor es el que profetiza que el que habla lenguas, si también no interpreta, para que la iglesia tome edificación.", "words": [[0, 26920], [4, 27085], [9, 27225], [18, 27605], [22, 27765], [28, 28005], [37, 28525], [47, 29085], [56, 29665], [61, 29845], [65, 30145], [69, 30325], [84, 31590], [91, 31790], [97, 32170], [100, 32430], [103, 32550], [107, 32670], [117, 33390], [121, 33550], [124, 33670], [128, 33790], [134, 34010], [143, 34730], [146, 34970], [154, 35310], [157, 35510], [169, 36210], [174, 36630], [178, 36810], [181, 36930], [189, 37290], [194, 37710]]}, {"verse": 6, "start": 38925, "end": 48624, "text": "Ahora pues, hermanos, si yo voy a vosotros hablando en lenguas, ¿qué os aprovecharé, si no os hablo, o con revelación, o con conocimiento, o con profecía, o con doctrina?", "words": [[0, 38925], [6, 39181], [12, 39421], [22, 40421], [25, 40541], [28, 40681], [32, 40801], [34, 40921], [43, 41321], [52, 41681], [55, 41921], [64, 42801], [69, 42861], [72, 43021], [85, 43641], [88, 43781], [91, 43961], [94, 44141], [101, 44521], [103, 44681], [107, 44841], [119, 45481], [121, 45781], [125, 45921], [139, 46661], [141, 46861], [145, 47001], [155, 47621], [157, 47801], [161, 47961]]}, {"verse": 7, "start": 48974, "end": 58087, "text": "Ciertamente las cosas inanimadas que hacen sonidos, como la flauta o el arpa, si no dan distinción de voces, ¿cómo se sabrá lo que se toca con la flauta o con el arpa?", "words": [[0, 48974], [12, 49548], [16, 49728], [22, 50068], [33, 50788], [37, 51008], [43, 51248], [52, 52048], [57, 52208], [60, 52348], [67, 52788], [69, 52928], [72, 53048], [78, 53240], [81, 53431], [84, 53623], [88, 53843], [99, 54383], [102, 54543], [109, 55289], [115, 55471], [118, 55611], [124, 55931], [127, 56051], [131, 56171], [134, 56291], [139, 56531], [143, 56771], [146, 56891], [153, 57271], [155, 57391], [159, 57551], [162, 57671]]}, {"verse": 8, "start": 58437, "end": 62932, "text": "Y si la trompeta da sonido incierto, ¿quién se preparará para la batalla?", "words": [[0, 58437], [2, 58535], [5, 58635], [8, 58755], [17, 59295], [20, 59395], [27, 59795], [37, 60815], [44, 61095], [47, 61335], [57, 61935], [62, 62115], [65, 62255]]}, {"verse": 9, "start": 63282, "end": 70627, "text": "Así también vosotros, si por la lengua no dais palabra comprensible, ¿cómo se entenderá lo que se dice? porque hablaréis al aire.", "words": [[0, 63282], [4, 63481], [12, 63841], [22, 64501], [25, 64621], [29, 64821], [32, 64921], [39, 65301], [42, 65461], [47, 65721], [55, 66001], [69, 67381], [75, 67581], [78, 67741], [88, 68241], [91, 68341], [95, 68441], [98, 68561], [104, 69298], [111, 69514], [121, 69994], [124, 70174]]}, {"verse": 10, "start": 70977, "end": 77025, "text": "Tantos géneros de voces, por ejemplo, hay en el mundo, y ninguna de esas voces carece de significado;", "words": [[0, 70977], [7, 71341], [15, 71781], [18, 71881], [25, 72441], [29, 72541], [38, 73221], [42, 73361], [45, 73521], [48, 73621], [55, 74341], [57, 74441], [65, 74761], [68, 74981], [73, 75181], [79, 75621], [86, 76041], [89, 76161]]}, {"verse": 11, "start": 77375, "end": 83112, "text": "Pero si yo ignoro el valor de la voz, seré extranjero para el que habla, y el que habla será extranjero para mí.", "words": [[0, 77375], [5, 77511], [8, 77691], [11, 77871], [18, 78231], [21, 78331], [27, 78531], [30, 78711], [33, 78811], [38, 79391], [43, 79771], [54, 80311], [59, 80491], [62, 80611], [66, 80711], [73, 81031], [75, 81371], [78, 81471], [82, 81571], [88, 81821], [93, 82071], [104, 82651], [109, 82811]]}, {"verse": 12, "start": 83462, "end": 90415, "text": "Así también vosotros; pues que anheláis espirituales dones, procurad ser excelentes para la edificación de la iglesia.", "words": [[0, 83462], [4, 83648], [12, 83928], [22, 84875], [27, 85015], [31, 85175], [40, 85655], [53, 86455], [60, 86935], [69, 87615], [73, 87815], [84, 88555], [89, 88835], [92, 88975], [104, 89495], [107, 89735], [110, 89815]]}, {"verse": 13, "start": 90765, "end": 94359, "text": "Por lo cual, el que habla lengua extraña, pida que la interprete.", "words": [[0, 90765], [4, 90953], [7, 91073], [13, 91353], [16, 91553], [20, 91693], [26, 91893], [33, 92253], [42, 92793], [47, 93333], [51, 93533], [54, 93633]]}, {"verse": 14, "start": 94709, "end": 100403, "text": "Porque si yo orare en lengua desconocida, mi espíritu ora; pero mi entendimiento queda sin fruto.", "words": [[0, 94709], [7, 94916], [10, 95136], [13, 95376], [19, 95736], [22, 95876], [29, 96236], [42, 97036], [45, 97156], [54, 97736], [59, 98346], [64, 98472], [67, 98592], [81, 99152], [87, 99712], [91, 99872]]}, {"verse": 15, "start": 100753, "end": 109072, "text": "¿Qué pues? Oraré con el espíritu, pero oraré también con entendimiento; cantaré con el espíritu, pero cantaré también con entendimiento.", "words": [[0, 100753], [5, 100871], [11, 101562], [17, 101863], [21, 102043], [24, 102163], [34, 103063], [39, 103203], [45, 103543], [53, 103803], [57, 104083], [72, 105305], [80, 105705], [84, 105865], [87, 105985], [97, 106785], [102, 107045], [110, 107525], [118, 107785], [122, 108065]]}, {"verse": 16, "start": 109422, "end": 117048, "text": "Porque si bendices con el espíritu, ¿cómo dirá «Amén» a tu acción de gracias quien no está instruido? Pues no sabe lo que has dicho.", "words": [[0, 109422], [7, 109628], [10, 109828], [19, 110328], [23, 110548], [26, 110668], [36, 111628], [42, 111768], [47, 112168], [54, 112428], [56, 112788], [59, 112888], [66, 113288], [69, 113428], [77, 113748], [83, 114108], [86, 114328], [91, 114508], [102, 115538], [107, 115642], [110, 115802], [115, 116122], [118, 116282], [122, 116422], [126, 116542]]}, {"verse": 17, "start": 117398, "end": 121496, "text": "Porque tú, a la verdad, das gracias bien; pero el otro no es edificado.", "words": [[0, 117398], [7, 117607], [11, 117867], [13, 117987], [16, 118067], [24, 118367], [28, 118647], [36, 119027], [42, 119817], [47, 119958], [50, 120118], [55, 120338], [58, 120558], [61, 120738]]}, {"verse": 18, "start": 121846, "end": 125032, "text": "Doy gracias a Dios que hablo lenguas más que todos vosotros:", "words": [[0, 121846], [4, 122064], [12, 122344], [14, 122584], [19, 122744], [23, 123004], [29, 123264], [37, 123664], [41, 123844], [45, 124044], [51, 124264]]}, {"verse": 19, "start": 125382, "end": 133853, "text": "Pero en la iglesia más quiero hablar cinco palabras con mi entendimiento, para que enseñe también a los otros, que diez mil palabras en lengua desconocida.", "words": [[0, 125382], [5, 125520], [8, 125640], [11, 125720], [19, 126160], [23, 126440], [30, 126700], [37, 127060], [43, 127380], [52, 127860], [56, 128120], [59, 128260], [74, 129000], [79, 129540], [83, 129700], [90, 130120], [98, 130360], [100, 130580], [104, 130740], [111, 131080], [115, 131420], [120, 131760], [124, 132000], [133, 132460], [136, 132720], [143, 133020]]}, {"verse": 20, "start": 134203, "end": 140293, "text": "Hermanos, no seáis niños en el entendimiento, sino sed niños en la malicia: pero maduros en el entendimiento.", "words": [[0, 134203], [10, 134781], [13, 134841], [19, 135181], [25, 135441], [28, 135661], [31, 135761], [46, 136621], [51, 136761], [55, 137061], [61, 137341], [64, 137561], [67, 137661], [76, 138501], [81, 138642], [89, 139062], [92, 139282], [95, 139382]]}, {"verse": 21, "start": 140643, "end": 149612, "text": "En la ley está escrito: En otras lenguas y en otros labios hablaré a este pueblo; y ni aun así me oirán, dice el Señor.", "words": [[0, 140643], [3, 140761], [6, 140861], [10, 141081], [15, 141301], [24, 142191], [27, 142355], [33, 142615], [41, 143315], [43, 143495], [46, 143615], [52, 143855], [59, 144395], [67, 145115], [69, 145295], [74, 145535], [82, 146584], [84, 146749], [87, 146849], [91, 147089], [95, 147469], [98, 147649], [105, 148743], [110, 148964], [113, 149104]]}, {"verse": 22, "start": 149962, "end": 159161, "text": "Así que, las lenguas por señal son, no a los creyentes, sino a los no creyentes: pero la profecía, no a los no creyentes, sino a los creyentes.", "words": [[0, 149962], [4, 150154], [9, 150334], [13, 150474], [21, 150914], [25, 151094], [31, 151554], [36, 151794], [39, 152374], [41, 152534], [45, 152634], [56, 153234], [61, 153574], [63, 153774], [67, 153954], [70, 154114], [81, 155204], [86, 155481], [89, 155641], [99, 156261], [102, 156621], [104, 156821], [108, 156981], [111, 157121], [122, 157901], [127, 158021], [129, 158141], [133, 158281]]}, {"verse": 23, "start": 159511, "end": 169816, "text": "De manera que, si toda la iglesia se reúne en un solo lugar, y todos hablan en lenguas, y entran personas no instruidas o no creyentes, ¿no dirán que estáis locos?", "words": [[0, 159511], [3, 159636], [10, 159856], [15, 160136], [18, 160296], [23, 160516], [26, 160736], [34, 161116], [37, 161316], [43, 161796], [46, 161896], [49, 162016], [54, 162296], [61, 162736], [63, 163136], [69, 163376], [76, 163976], [79, 164116], [88, 164616], [90, 165056], [97, 165376], [106, 165896], [109, 166136], [120, 166776], [122, 167016], [125, 167096], [136, 168188], [140, 168327], [146, 168647], [150, 168807], [157, 169207]]}, {"verse": 24, "start": 170166, "end": 177649, "text": "Pero si todos profetizan, y entra algún no creyente o alguien no instruido, por todos es convencido, por todos es juzgado;", "words": [[0, 170166], [5, 170304], [8, 170464], [14, 170724], [26, 171644], [28, 171844], [34, 172104], [40, 172404], [43, 172584], [52, 173124], [54, 173304], [62, 173564], [65, 173824], [76, 174684], [80, 174844], [86, 175124], [89, 175364], [101, 176424], [105, 176544], [111, 176804], [114, 177004]]}, {"verse": 25, "start": 177999, "end": 187316, "text": "Lo oculto de su corazón se hace manifiesto: y así, postrándose sobre el rostro, adorará a Dios, declarando que verdaderamente Dios está en vosotros.", "words": [[0, 177999], [3, 178164], [10, 178584], [13, 178644], [16, 178764], [24, 179204], [27, 179464], [32, 179644], [44, 180684], [46, 180804], [51, 180984], [63, 181784], [69, 182084], [72, 182244], [80, 183024], [88, 183644], [90, 183764], [96, 184364], [107, 184824], [111, 184964], [126, 185704], [131, 186064], [136, 186444], [139, 186604]]}, {"verse": 26, "start": 187666, "end": 199218, "text": "¿Qué hay pues, hermanos? Cuando os juntáis, cada uno de vosotros tiene salmo, tiene doctrina, tiene lengua, tiene revelación, tiene interpretación: hágase todo para edificación.", "words": [[0, 187666], [5, 187766], [9, 188006], [15, 188266], [25, 188979], [32, 189169], [35, 189329], [44, 189729], [49, 189969], [53, 190229], [56, 190349], [65, 190789], [71, 191089], [78, 192109], [84, 192329], [94, 193489], [100, 193589], [108, 194589], [114, 194669], [126, 195969], [132, 196089], [148, 197373], [155, 197694], [160, 197954], [165, 198214]]}, {"verse": 27, "start": 199568, "end": 206060, "text": "Si habla alguno en lengua extraña, sea esto por dos, o a lo más tres, y por turno; pero uno interprete.", "words": [[0, 199568], [3, 199682], [9, 199922], [16, 200482], [19, 200562], [26, 200902], [35, 201462], [39, 201802], [44, 202122], [48, 202372], [53, 202622], [55, 202962], [57, 203042], [60, 203142], [64, 203372], [70, 203602], [72, 203942], [76, 204102], [83, 204877], [88, 205037], [92, 205257]]}, {"verse": 28, "start": 206410, "end": 211353, "text": "Y si no hay intérprete, calle en la iglesia, y hable para sí mismo y para Dios.", "words": [[0, 206410], [2, 206539], [5, 206639], [8, 206799], [12, 206959], [24, 208039], [30, 208479], [33, 208559], [36, 208699], [45, 209199], [47, 209444], [53, 209744], [58, 209944], [61, 210144], [67, 210504], [69, 210584], [74, 210804]]}, {"verse": 29, "start": 211703, "end": 215282, "text": "Asimismo, los profetas hablen dos o tres, y los demás juzguen.", "words": [[0, 211703], [10, 212281], [14, 212401], [23, 212941], [30, 213321], [34, 213501], [36, 213641], [42, 213901], [44, 214221], [48, 214341], [54, 214561]]}, {"verse": 30, "start": 215632, "end": 219367, "text": "Y si a otro que está sentado, es revelado, el primero debe callar.", "words": [[0, 215632], [2, 215761], [5, 215901], [7, 216001], [12, 216221], [16, 216441], [21, 216681], [30, 217281], [33, 217481], [43, 218041], [46, 218201], [54, 218521], [59, 218781]]}, {"verse": 31, "start": 219717, "end": 225110, "text": "Porque podéis todos profetizar uno por uno, para que todos aprendan, y todos sean exhortados.", "words": [[0, 219717], [7, 219920], [14, 220340], [20, 220560], [31, 221360], [35, 221640], [39, 221860], [44, 222100], [49, 222600], [53, 222780], [59, 223000], [69, 223720], [71, 223900], [77, 224080], [82, 224440]]}, {"verse": 32, "start": 225460, "end": 229305, "text": "Y los espíritus de los que profetizan, sujétense a los profetas;", "words": [[0, 225460], [2, 225543], [6, 225663], [16, 226343], [19, 226443], [23, 226543], [27, 226703], [39, 227743], [49, 228263], [51, 228423], [55, 228543]]}, {"verse": 33, "start": 229655, "end": 235109, "text": "Porque Dios no es Dios de desorden, sino de paz; como en todas las iglesias de los santos.", "words": [[0, 229655], [7, 229839], [12, 230139], [15, 230459], [18, 230619], [23, 230879], [26, 231059], [36, 231799], [41, 232019], [44, 232199], [49, 232926], [54, 233108], [57, 233288], [63, 233428], [67, 233748], [76, 234208], [79, 234308], [83, 234428]]}, {"verse": 34, "start": 235459, "end": 242444, "text": "Vuestras mujeres callen en las congregaciones; porque no les es permitido hablar, sino que estén sujetas, como también la ley dice.", "words": [[0, 235459], [9, 235784], [17, 236084], [24, 236624], [27, 236704], [31, 236824], [47, 238081], [54, 238246], [57, 238426], [61, 238586], [64, 238706], [74, 239246], [82, 239866], [87, 240026], [91, 240206], [97, 240486], [106, 241086], [111, 241306], [119, 241666], [122, 241806], [126, 241986]]}, {"verse": 35, "start": 242794, "end": 250226, "text": "Y si quieren aprender alguna cosa, pregunten en casa a sus maridos; porque cosa vergonzosa es hablar una mujer en la congregación.", "words": [[0, 242794], [2, 242898], [5, 242998], [13, 243258], [22, 243638], [29, 243958], [35, 244698], [45, 245138], [48, 245298], [53, 245518], [55, 245718], [59, 245798], [68, 246659], [75, 246887], [80, 247207], [91, 247907], [94, 248087], [101, 248367], [105, 248587], [111, 248947], [114, 249127], [117, 249227]]}, {"verse": 36, "start": 250576, "end": 254964, "text": "Qué, ¿ha salido de vosotros la palabra de Dios? ¿o a vosotros solos ha llegado?", "words": [[0, 250576], [5, 250698], [9, 250838], [16, 251238], [19, 251358], [28, 251818], [31, 251998], [39, 252298], [42, 252478], [48, 253207], [51, 253344], [53, 253444], [62, 253864], [68, 254304], [71, 254404]]}, {"verse": 37, "start": 255314, "end": 262567, "text": "Si alguno a su parecer, es profeta, o espiritual, reconozca lo que os escribo, porque son mandamientos del Señor.", "words": [[0, 255314], [3, 255448], [10, 255968], [12, 256048], [15, 256188], [24, 256648], [27, 256988], [36, 257588], [38, 257708], [50, 258828], [60, 259468], [63, 259608], [67, 259748], [70, 259868], [79, 260728], [86, 260948], [90, 261188], [103, 261828], [107, 262068]]}, {"verse": 38, "start": 262917, "end": 264397, "text": "Pero el que ignora, ignore.", "words": [[0, 262917], [5, 263036], [8, 263196], [12, 263296], [20, 263936]]}, {"verse": 39, "start": 264747, "end": 269023, "text": "Así que, hermanos, procurad profetizar; y no impidáis el hablar lenguas.", "words": [[0, 264747], [4, 264934], [9, 265114], [19, 265734], [28, 266334], [40, 267371], [42, 267473], [45, 267573], [54, 268053], [57, 268173], [64, 268373]]}, {"verse": 40, "start": 269373, "end": 271659, "text": "Pero hágase todo decentemente y con orden.", "words": [[0, 269373], [5, 269517], [12, 269897], [17, 270177], [30, 270937], [32, 271077], [36, 271217]]}]}