{"book": "PSA", "chapter": 62, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 96011, "verses": [{"verse": 1, "start": 300, "end": 9528, "text": "Al Músico principal: a Jedutún: Salmo de David. EN Dios solamente está acallada mi alma: de él viene mi salvación.", "words": [[0, 300], [3, 483], [10, 1003], [21, 2473], [23, 2781], [32, 3309], [38, 3773], [41, 3913], [48, 4717], [51, 4903], [56, 5163], [66, 5923], [71, 6353], [80, 6783], [83, 6963], [89, 7728], [92, 8028], [95, 8168], [101, 8428], [104, 8608]]}, {"verse": 2, "start": 9878, "end": 15812, "text": "Él solamente es mi fuerte, y mi salvación; es mi refugio, no resbalaré mucho.", "words": [[0, 9878], [3, 10138], [13, 10558], [16, 10918], [19, 10998], [27, 11398], [29, 11738], [32, 11838], [43, 12990], [46, 13350], [49, 13910], [58, 14470], [61, 14900], [71, 15330]]}, {"verse": 3, "start": 16162, "end": 24469, "text": "¿Hasta cuándo maquinaréis contra un hombre? Pereceréis todos vosotros, caeréis como pared inclinada, como cerca ruinosa.", "words": [[0, 16162], [7, 16427], [14, 16707], [26, 17467], [33, 17747], [36, 17967], [44, 18681], [55, 19405], [61, 19825], [71, 20485], [79, 21105], [84, 21385], [90, 21785], [101, 23025], [106, 23521], [112, 24018]]}, {"verse": 4, "start": 24819, "end": 34338, "text": "Solamente tratan de arrojarle de su grandeza; aman la mentira, con su boca bendicen, pero maldicen en sus entrañas. (Selah.)", "words": [[0, 24819], [10, 25437], [17, 26197], [20, 26317], [30, 27037], [33, 27177], [36, 27317], [46, 28449], [51, 28837], [54, 28937], [63, 29477], [67, 29677], [70, 29857], [75, 30117], [85, 31277], [90, 31437], [99, 32257], [102, 32397], [106, 32537], [116, 34027]]}, {"verse": 5, "start": 34688, "end": 39892, "text": "Alma mía, en Dios solamente reposa; porque de él es mi esperanza.", "words": [[0, 34688], [5, 34988], [10, 35388], [13, 35468], [18, 35728], [28, 36552], [36, 37952], [43, 38342], [46, 38502], [49, 38682], [52, 38862], [55, 39062]]}, {"verse": 6, "start": 40242, "end": 45580, "text": "Él solamente es mi fuerte y mí salvación: es mi refugio, no resbalaré.", "words": [[0, 40242], [3, 40407], [13, 40847], [16, 41147], [19, 41247], [26, 41647], [28, 41887], [31, 42007], [42, 43151], [45, 43325], [48, 43505], [57, 44205], [60, 44525]]}, {"verse": 7, "start": 45930, "end": 52811, "text": "En Dios está mi salvación y mi gloria: en Dios está la roca de mi fortaleza, y mi refugio.", "words": [[0, 45930], [3, 46094], [8, 46394], [13, 47114], [16, 47334], [26, 48014], [28, 48254], [31, 48354], [39, 49252], [42, 49563], [47, 49743], [52, 50043], [55, 50203], [60, 50603], [63, 50743], [66, 50863], [77, 51603], [79, 51743], [82, 51903]]}, {"verse": 8, "start": 53161, "end": 62803, "text": "Esperad en él en todo tiempo, oh pueblos; derramad delante de él vuestro corazón: Dios es nuestro amparo. (Selah.)", "words": [[0, 53161], [8, 53901], [11, 54161], [14, 54361], [17, 54641], [22, 54821], [30, 55281], [33, 55741], [42, 56966], [51, 57674], [59, 58214], [62, 58434], [65, 58594], [73, 58974], [82, 60001], [87, 60285], [90, 60705], [98, 61205], [106, 62493]]}, {"verse": 9, "start": 63153, "end": 72917, "text": "Por cierto, vanidad son los hijos de los hombres, mentira los hijos de varón: pesándolos a todos igualmente en la balanza, serán menos que la vanidad.", "words": [[0, 63153], [4, 63433], [12, 64033], [20, 64473], [24, 64833], [28, 65073], [34, 65353], [37, 65553], [41, 65673], [50, 66473], [58, 67073], [62, 67273], [68, 67553], [71, 67773], [78, 68463], [89, 69228], [91, 69348], [97, 69648], [108, 70368], [111, 70488], [114, 70588], [123, 71348], [129, 71708], [135, 71968], [139, 72148], [142, 72288]]}, {"verse": 10, "start": 73267, "end": 82439, "text": "No confiéis en la violencia, ni en la rapiña; no os envanezcáis: si se aumentan las riquezas, no pongáis el corazón en ellas.", "words": [[0, 73267], [3, 73374], [12, 73974], [15, 74094], [18, 74214], [29, 74874], [32, 75154], [35, 75274], [38, 7