{"book": "LUK", "chapter": 18, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 327879, "verses": [{"verse": 1, "start": 300, "end": 7660, "text": "Y LES PROPUSO también una parábola sobre que es necesario orar siempre, y no desanimarse,", "words": [[0, 300], [2, 442], [6, 562], [14, 1202], [22, 1582], [26, 2022], [35, 2641], [41, 3002], [45, 3282], [48, 3462], [58, 4361], [63, 4982], [72, 5442], [74, 5922], [77, 6082]]}, {"verse": 2, "start": 8110, "end": 14043, "text": "Diciendo: Había un juez en una ciudad, el cual ni temía a Dios, ni respetaba a hombre.", "words": [[0, 8110], [10, 9258], [16, 9323], [19, 9388], [24, 9453], [27, 9753], [31, 9913], [39, 10313], [42, 10673], [47, 10893], [50, 11213], [56, 11653], [58, 11873], [64, 12093], [67, 12653], [77, 13313], [79, 13513]]}, {"verse": 3, "start": 14493, "end": 23251, "text": "Había también en aquella ciudad una viuda, la cual venía a él diciendo: Hazme justicia de mi adversario.", "words": [[0, 14493], [6, 14802], [14, 15242], [17, 15682], [25, 16102], [32, 16482], [36, 16862], [43, 17802], [46, 18022], [51, 18242], [57, 18782], [59, 19002], [62, 19242], [72, 20350], [78, 20766], [87, 21506], [90, 21686], [93, 21786]]}, {"verse": 4, "start": 23601, "end": 32859, "text": "Y él no quiso por algún tiempo; pero después de esto dijo dentro de sí: Aunque ni temo a Dios, ni tengo respeto a hombre,", "words": [[0, 23601], [2, 23761], [5, 23901], [8, 24061], [14, 24421], [18, 24641], [24, 24901], [32, 25904], [37, 26279], [45, 26619], [48, 26819], [53, 27059], [58, 27379], [65, 27939], [68, 28239], [72, 28886], [79, 29066], [82, 29286], [87, 29606], [89, 29706], [95, 30386], [98, 30526], [104, 30846], [112, 31426], [114, 32171]]}, {"verse": 5, "start": 33309, "end": 39711, "text": "Sin embargo, porque esta viuda me es molesta, le haré justicia, para que al fin no venga y me muela.", "words": [[0, 33309], [4, 33309], [13, 33309], [20, 33502], [25, 33782], [31, 34142], [34, 34362], [37, 34482], [46, 35362], [49, 35482], [54, 35702], [64, 36642], [69, 37022], [73, 37202], [76, 37322], [80, 37522], [83, 37762], [89, 38102], [91, 38242], [94, 38362]]}, {"verse": 6, "start": 40061, "end": 43967, "text": "Y dijo el Señor: Oíd lo que dice el juez injusto.", "words": [[0, 40061], [2, 40185], [7, 40485], [10, 40625], [17, 41616], [21, 42028], [24, 42308], [28, 42448], [33, 42728], [36, 42928], [41, 43208]]}, {"verse": 7, "start": 44417, "end": 50761, "text": "¿Y Dios no hará justicia a sus escogidos, que claman a él día y noche, aunque sea paciente con ellos?", "words": [[0, 44417], [3, 44545], [8, 44865], [11, 45585], [16, 45765], [25, 46305], [27, 46485], [31, 46605], [42, 47245], [46, 47385], [53, 47615], [55, 47845], [58, 48025], [62, 48265], [64, 48445], [71, 49065], [78, 49245], [82, 49545], [91, 50045], [95, 50285]]}, {"verse": 8, "start": 51211, "end": 57876, "text": "Os digo que los defenderá pronto. Pero cuando venga el Hijo del hombre, ¿hallará fe en la tierra?", "words": [[0, 51211], [3, 51335], [8, 51635], [12, 51795], [16, 51955], [26, 52535], [34, 53541], [39, 53685], [46, 53945], [52, 54385], [55, 54505], [60, 54725], [64, 54885], [72, 55625], [81, 56265], [84, 56565], [87, 56885], [90, 57045]]}, {"verse": 9, "start": 58326, "end": 64853, "text": "Y dijo también a unos que confiaban de sí como justos, y menospreciaban a los otros, esta parábola:", "words": [[0, 58326], [2, 58437], [7, 58677], [15, 59017], [17, 59277], [22, 59457], [26, 59637], [36, 60237], [39, 60497], [42, 60617], [47, 60897], [55, 61537], [57, 61657], [72, 62597], [74, 62777], [78, 62957], [85, 63797], [90, 64117]]}, {"verse": 10, "start": 65303, "end": 72075, "text": "Dos hombres subieron al templo a orar: el uno fariseo, el otro recaudador de impuestos.", "words": [[0, 65303], [4, 65509], [12, 65999], [21, 66489], [24, 66649], [31, 67229], [33, 67389], [39, 68177], [42, 68458], [46, 68618], [55, 69758], [58, 69858], [63, 70058], [74, 70898], [77, 71098]]}, {"verse": 11, "start": 72525, "end": 85163, "text": "El fariseo, en pie, oraba consigo de esta manera: Dios, te doy gracias, que no soy como los otros hombres, ladrones, injustos, adúlteros, ni aun como este recaudador de impuestos;", "words": [[0, 72525], [3, 72689], [12, 73449], [15, 73589], [20, 73949], [26, 75009], [34, 75489], [37, 75809], [42, 76029], [50, 76947], [56, 77113], [59, 77293], [63, 77513], [72, 78273], [76, 78333], [79, 78513], [83, 78753], [88, 78973], [92, 79173], [98, 79413], [107, 80313], [117, 81153], [127, 82013], [138, 82953], [141, 83153], [145, 83353], [150, 83673], [155, 83893], [166, 84533], [169, 84693]]}, {"verse": 12, "start": 85613, "end": 89871, "text": "Ayuno dos veces a la semana, doy diezmos de todo lo que poseo.", "words": [[0, 86054], [6, 86514], [10, 86694], [16, 86954], [18, 87174], [21, 87234], [29, 88074], [33, 88274], [41, 88654], [44, 88834], [49, 88994], [52, 89174], [56, 89294]]}, {"verse": 13, "start": 90221, "end": 102841, "text": "Pero el recaudador de impuestos estando lejos no quería ni aun alzar los ojos al cielo, sino que se golpeaba el pecho, diciendo: Dios, ten misericordia de mí, pecador.", "words": [[0, 90221], [5, 90443], [8, 90643], [19, 91323], [22, 91563], [32, 92143], [40, 92643], [46, 93343], [49, 93783], [56, 94183], [59, 94583], [63, 94883], [69, 95563], [73, 95923], [78, 96323], [81, 96603], [88, 97143], [93, 97683], [97, 97883], [100, 98023], [109, 98623], [112, 98823], [119, 99563], [129, 100584], [135, 100830], [139, 101050], [152, 101810], [155, 101930], [159, 102270]]}, {"verse": 14, "start": 103191, "end": 114765, "text": "Os digo que este descendió a su casa justificado, a diferencia del otro; porque cualquiera que se enaltece, será humillado; y el que se humilla, será enaltecido.", "words": [[0, 103191], [3, 103314], [8, 103634], [12, 103894], [17, 104114], [27, 104834], [29, 104974], [32, 105094], [37, 105434], [50, 106774], [52, 106994], [63, 107334], [67, 107894], [73, 108692], [80, 108916], [91, 109576], [95, 109756], [98, 109916], [108, 110676], [113, 110996], [124, 112299], [126, 112460], [129, 112560], [133, 112700], [136, 112880], [145, 113300], [150, 113640]]}, {"verse": 15, "start": 115215, "end": 121498, "text": "Y traían a él los niños para que los tocase; lo cual viendo los discípulos les reprendían.", "words": [[0, 115215], [2, 115319], [9, 115859], [11, 116039], [14, 116239], [18, 116419], [24, 116859], [29, 117239], [33, 117419], [37, 117539], [45, 118659], [48, 118766], [53, 118926], [60, 119246], [64, 119466], [75, 120226], [79, 120606]]}, {"verse": 16, "start": 121948, "end": 130532, "text": "Pero Jesús llamándolos, dijo: Dejad los niños venir a mí, y no los impidáis; porque de tales es el reino de Dios.", "words": [[0, 121948], [5, 122093], [11, 122733], [24, 123373], [30, 124177], [36, 124757], [40, 124917], [46, 125297], [52, 125677], [54, 125857], [58, 126037], [60, 126457], [63, 126617], [67, 127205], [77, 128062], [84, 128286], [87, 128506], [93, 128806], [96, 129146], [99, 129346], [105, 129766], [108, 129926]]}, {"verse": 17, "start": 130982, "end": 137912, "text": "De cierto os digo, que cualquiera que no reciba el reino de Dios como un niño, no entrará en él.", "words": [[0, 130982], [3, 131168], [10, 131488], [13, 131868], [19, 132148], [23, 132708], [34, 133328], [38, 133468], [41, 133648], [48, 134208], [51, 134348], [57, 134708], [60, 134868], [65, 135108], [70, 135428], [73, 135668], [79, 136048], [82, 136668], [90, 137328], [93, 137508]]}, {"verse": 18, "start": 138362, "end": 144267, "text": "Y le preguntó un dirigente, diciendo: Maestro bueno, ¿qué haré para poseer la vida eterna?", "words": [[0, 138362], [2, 138469], [5, 138569], [14, 139089], [17, 139169], [28, 139849], [38, 141199], [46, 141680], [53, 142400], [58, 142520], [63, 142780], [68, 142940], [75, 143400], [78, 143500], [83, 143680]]}, {"verse": 19, "start": 144617, "end": 150067, "text": "Y Jesús le dijo: ¿Por qué me llamas bueno? ninguno hay bueno sino sólo Dios.", "words": [[0, 144617], [2, 144728], [8, 145128], [11, 145448], [17, 146335], [22, 146456], [26, 146636], [29, 146776], [36, 147116], [43, 147887], [51, 148354], [55, 148514], [61, 148834], [66, 149094], [71, 149414]]}, {"verse": 20, "start": 150517, "end": 161902, "text": "Los mandamientos sabes: No matarás: No adulterarás: No hurtarás: No dirás falso testimonio: Honra a tu padre y a tu madre.", "words": [[0, 150517], [4, 150642], [17, 151262], [24, 152266], [27, 152546], [36, 153692], [39, 154052], [52, 155490], [55, 156094], [65, 157033], [68, 157293], [74, 157653], [80, 158073], [92, 159311], [98, 159815], [100, 160015], [103, 160135], [109, 160575], [111, 161035], [113, 161135], [116, 161275]]}, {"verse": 21, "start": 162352, "end": 166475, "text": "Y él dijo: Todas estas cosas he guardado desde mi juventud.", "words": [[0, 162352], [2, 162669], [5, 162829], [11, 163635], [17, 163773], [23, 164113], [29, 164553], [32, 164893], [41, 165373], [47, 165593], [50, 165813]]}, {"verse": 22, "start": 166825, "end": 178159, "text": "Y Jesús, oído esto, le dijo: Aún te falta una cosa: vende todo lo que tienes, y da a los pobres, y tendrás tesoro en el cielo; y ven, sígueme.", "words": [[0, 166825], [2, 166947], [9, 167347], [14, 168027], [20, 168727], [23, 168867], [29, 169773], [33, 169996], [36, 170196], [42, 170496], [46, 170736], [52, 171540], [58, 171926], [63, 172226], [66, 172446], [70, 172546], [78, 172926], [80, 173426], [83, 173646], [85, 173766], [89, 173866], [97, 174486], [99, 174866], [107, 175326], [114, 175806], [117, 175926], [120, 176046], [127, 176891], [129, 177074], [134, 177534]]}, {"verse": 23, "start": 178609, "end": 184409, "text": "Entonces él, oídas estas cosas, se puso muy triste, porque era muy rico.", "words": [[0, 178609], [9, 179167], [13, 179587], [19, 180147], [25, 180387], [32, 181127], [35, 181387], [40, 181707], [44, 182067], [52, 182627], [59, 183247], [63, 183507], [67, 183787]]}, {"verse": 24, "start": 184859, "end": 194659, "text": "Y viendo Jesús que se había entristecido mucho, dijo: ¡Con cuánta dificultad entrarán en el reino de Dios los que tienen riquezas!", "words": [[0, 184859], [2, 184981], [9, 185241], [15, 185721], [19, 186241], [22, 186401], [28, 187061], [41, 187721], [48, 188361], [54, 189222], [59, 189371], [66, 189951], [77, 190851], [86, 191611], [89, 191831], [92, 192011], [98, 192411], [101, 192551], [106, 192831], [110, 193271], [114, 193411], [121, 194071]]}, {"verse": 25, "start": 195109, "end": 202407, "text": "Porque más fácil cosa es entrar un camello por el ojo de una aguja, que un rico entrar en el reino de Dios.", "words": [[0, 195109], [7, 195334], [11, 195514], [17, 195914], [22, 196354], [25, 196634], [32, 197074], [35, 197334], [43, 197814], [47, 198054], [50, 198174], [54, 198474], [57, 198594], [61, 198774], [68, 199394], [72, 199874], [75, 200034], [80, 200294], [87, 200814], [90, 201174], [93, 201334], [99, 201694], [102, 201814]]}, {"verse": 26, "start": 202857, "end": 206082, "text": "Y los que lo oían, dijeron: ¿Y quién podrá ser salvo?", "words": [[0, 202857], [2, 202963], [6, 203103], [10, 203263], [13, 203463], [19, 203943], [28, 204746], [31, 204871], [37, 205071], [43, 205471], [47, 205571]]}, {"verse": 27, "start": 206432, "end": 212430, "text": "Y él les dijo: Lo que es imposible para con los hombres, posible es para Dios.", "words": [[0, 206432], [2, 206614], [5, 206814], [9, 207174], [15, 208096], [18, 208239], [22, 208399], [25, 208559], [35, 209399], [40, 209639], [44, 209859], [48, 210039], [57, 210679], [65, 211399], [68, 211639], [73, 211839]]}, {"verse": 28, "start": 212880, "end": 219073, "text": "Entonces Pedro dijo: He aquí, nosotros hemos dejado las posesiones nuestras, y te hemos seguido.", "words": [[0, 212880], [9, 213421], [15, 213981], [21, 214955], [24, 215045], [30, 215285], [39, 215585], [45, 216065], [52, 216565], [56, 216705], [67, 217265], [77, 217745], [79, 218165], [82, 218325], [88, 218485]]}, {"verse": 29, "start": 219423, "end": 228944, "text": "Y él les dijo: De cierto os digo, que nadie hay que haya dejado casa, padres, o hermanos, o mujer, o hijos, por el reino de Dios,", "words": [[0, 219423], [2, 219587], [5, 219737], [9, 219887], [15, 220747], [18, 220954], [25, 221254], [28, 221674], [34, 221954], [38, 222554], [44, 222954], [48, 223434], [52, 223654], [57, 223814], [64, 224334], [70, 224702], [78, 225070], [80, 225438], [90, 225806], [92, 226174], [99, 226634], [101, 226834], [108, 227194], [112, 227774], [115, 227934], [121, 228334], [124, 228494]]}, {"verse": 30, "start": 229394, "end": 235035, "text": "Que no haya de recibir mucho más en este tiempo, y en la era venidera la vida eterna.", "words": [[0, 229394], [4, 229479], [7, 229659], [12, 229879], [15, 230059], [23, 230459], [29, 230839], [33, 231099], [36, 231279], [41, 231479], [49, 231939], [51, 232599], [54, 232779], [57, 232979], [61, 233239], [70, 233859], [73, 233939], [78, 234159]]}, {"verse": 31, "start": 235485, "end": 246860, "text": "Y Jesús, tomando a los doce, les dijo: He aquí subimos a Jerusalén, y serán cumplidas todas las cosas que fueron escritas por los profetas, del Hijo del hombre.", "words": [[0, 235485], [2, 235762], [9, 236482], [17, 236942], [19, 237042], [23, 237162], [29, 237962], [33, 238022], [39, 238878], [42, 238958], [47, 239178], [55, 239758], [57, 239918], [68, 240638], [70, 241138], [76, 241518], [86, 242218], [92, 242498], [96, 242798], [102, 243078], [106, 243298], [113, 243558], [122, 244178], [126, 244398], [130, 244558], [140, 245218], [144, 245898], [149, 246198], [153, 246378]]}, {"verse": 32, "start": 247310, "end": 254295, "text": "Porque será entregado a los gentiles, y será objeto de burlas, e injuriado, y escupido.", "words": [[0, 247310], [7, 247513], [12, 247893], [22, 248873], [24, 248953], [28, 249053], [38, 249773], [40, 250293], [45, 250573], [52, 251193], [55, 251433], [63, 251993], [65, 252293], [76, 253213], [78, 253433]]}, {"verse": 33, "start": 254745, "end": 260342, "text": "Y después que le hayan azotado, le matarán: pero al tercer día resucitará.", "words": [[0, 254745], [2, 255015], [10, 255255], [14, 255435], [17, 255555], [23, 255985], [32, 256415], [35, 256555], [44, 257556], [49, 257981], [52, 258221], [59, 258521], [63, 258981]]}, {"verse": 34, "start": 260792, "end": 269372, "text": "Pero ellos nada de estas cosas entendían, y esta palabra les era encubierta, y no entendían lo que se decía.", "words": [[0, 260792], [5, 260954], [11, 261674], [16, 262014], [19, 262234], [25, 262454], [31, 262894], [42, 264194], [44, 264434], [49, 264654], [57, 265034], [61, 265574], [65, 265814], [77, 266654], [79, 267254], [82, 267434], [92, 268114], [95, 268314], [99, 268454], [102, 268594]]}, {"verse": 35, "start": 269822, "end": 276285, "text": "Y aconteció que acercándose él a Jericó, un ciego estaba sentado junto al camino mendigando;", "words": [[0, 269822], [2, 269944], [12, 270664], [16, 271044], [28, 271804], [31, 272164], [33, 272364], [41, 273344], [44, 273614], [50, 273884], [57, 274104], [65, 274644], [71, 274824], [74, 275044], [81, 275384]]}, {"verse": 36, "start": 276735, "end": 280696, "text": "El cual cuando oyó la gente que pasaba, preguntó qué era aquello.", "words": [[0, 276735], [3, 276924], [8, 277144], [15, 277384], [19, 277844], [22, 277964], [28, 278224], [32, 278404], [40, 279124], [49, 279664], [53, 279844], [57, 280044]]}, {"verse": 37, "start": 281146, "end": 283762, "text": "Y le dijeron que pasaba Jesús nazareno.", "words": [[0, 281146], [2, 281254], [5, 281354], [13, 281854], [17, 281974], [24, 282414], [30, 282754]]}, {"verse": 38, "start": 284212, "end": 289903, "text": "Entonces dio voces, diciendo: Jesús, Hijo de David, ten misericordia de mí.", "words": [[0, 284212], [9, 284831], [13, 285411], [20, 285891], [30, 286887], [37, 287435], [42, 287655], [45, 287775], [52, 288235], [56, 288695], [69, 289475], [72, 289615]]}, {"verse": 39, "start": 290253, "end": 302254, "text": "Y los que iban delante, le reprendían para que callase; pero él clamaba mucho más: Hijo de David, ten misericordia de mí.", "words": [[0, 290253], [2, 290374], [6, 290534], [10, 290734], [15, 290994], [24, 291444], [27, 291894], [38, 292634], [43, 292934], [47, 293154], [56, 294349], [61, 294494], [64, 294754], [72, 295314], [78, 295654], [83, 296586], [88, 296843], [91, 296983], [98, 297543], [102, 297663], [115, 298463], [118, 298603]]}, {"verse": 40, "start": 302604, "end": 308961, "text": "Jesús entonces parándose, mandó traerle a sí: y como él llegó, le preguntó,", "words": [[0, 302604], [6, 303391], [15, 304191], [26, 305011], [32, 305331], [40, 305708], [42, 306085], [46, 306695], [48, 306959], [53, 307199], [56, 307419], [63, 307719], [66, 308239]]}, {"verse": 41, "start": 309411, "end": 314119, "text": "Diciendo: ¿Qué quieres que te haga? Y él dijo: Señor, que vea.", "words": [[0, 309411], [10, 310549], [15, 310653], [23, 310993], [27, 311173], [30, 311333], [36, 312139], [38, 312326], [41, 312661], [47, 313193], [54, 313498], [58, 313698]]}, {"verse": 42, "start": 314469, "end": 319528, "text": "Y Jesús le dijo: Recobra la vista, tu fe te ha hecho salvo.", "words": [[0, 314469], [2, 314592], [8, 314992], [11, 315312], [17, 316421], [25, 316751], [28, 316891], [35, 317731], [38, 317951], [41, 318231], [44, 318471], [47, 318611], [53, 318831]]}, {"verse": 43, "start": 319978, "end": 327479, "text": "Y enseguida vio, y le seguía, glorificando a Dios: y todo el pueblo como lo vio, dio a Dios alabanza.", "words": [[0, 319978], [2, 320111], [12, 320591], [17, 320931], [19, 321311], [22, 321431], [30, 321831], [43, 322691], [45, 322791], [51, 323582], [53, 323711], [58, 323951], [61, 324251], [68, 324651], [73, 324871], [76, 325071], [81, 325711], [85, 325971], [87, 326231], [92, 326889]]}]}