{"book": "GEN", "chapter": 33, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 175031, "verses": [{"verse": 1, "start": 300, "end": 12866, "text": "Y alzando Jacob sus ojos miró, y he aquí venía Esaú, y los cuatrocientos hombres con él: entonces repartió él los niños entre Lea y Raquel y las dos siervas.", "words": [[0, 300], [2, 425], [10, 985], [16, 1345], [20, 1705], [25, 2005], [31, 3005], [33, 3145], [36, 3285], [41, 3485], [47, 3935], [53, 4385], [55, 4845], [59, 5185], [73, 5525], [81, 6165], [85, 6485], [89, 7161], [98, 8059], [107, 8779], [110, 9059], [114, 9239], [120, 9599], [126, 10079], [130, 10679], [132, 10859], [139, 11319], [141, 11779], [145, 11919], [149, 12079]]}, {"verse": 2, "start": 13316, "end": 21595, "text": "Y puso las siervas y sus niños delante; luego a Lea y a sus niños; y a Raquel y a José los últimos.", "words": [[0, 13316], [2, 13460], [7, 13860], [11, 14020], [19, 14560], [21, 14720], [25, 14900], [31, 15260], [40, 16339], [46, 16758], [48, 17213], [52, 17666], [54, 17926], [56, 18026], [60, 18146], [67, 19308], [69, 19597], [71, 19717], [78, 20077], [80, 20317], [82, 20397], [87, 20637], [91, 21151]]}, {"verse": 3, "start": 22045, "end": 29204, "text": "Y él pasó delante de ellos, y se inclinó a tierra siete veces, hasta que llegó a su hermano.", "words": [[0, 22045], [2, 22206], [5, 22346], [10, 22746], [18, 23406], [21, 23606], [28, 23926], [30, 24686], [33, 25116], [41, 25546], [43, 25686], [50, 25986], [56, 26426], [63, 27026], [69, 27706], [73, 27906], [79, 28206], [81, 28406], [84, 28586]]}, {"verse": 4, "start": 29654, "end": 36850, "text": "Y Esaú corrió a su encuentro, y le abrazó, y se echó sobre su cuello, y le besó; y lloraron.", "words": [[0, 29654], [2, 29905], [7, 30195], [14, 30615], [16, 30775], [19, 30895], [30, 31875], [32, 32015], [35, 32135], [43, 32875], [45, 33155], [48, 33315], [53, 33695], [59, 33975], [62, 34175], [70, 34675], [72, 35075], [75, 35195], [81, 35954], [83, 36085]]}, {"verse": 5, "start": 37300, "end": 47654, "text": "Y alzó sus ojos, y vio las mujeres y los niños, y dijo: ¿Quiénes son estos? Y él respondió: Son los niños que Dios ha dado a tu siervo.", "words": [[0, 37300], [2, 37544], [7, 37924], [11, 38084], [17, 38444], [19, 38904], [23, 39064], [27, 39204], [35, 39584], [37, 39804], [41, 39944], [48, 40524], [50, 40624], [56, 41915], [65, 42502], [69, 43090], [76, 43969], [78, 44151], [81, 44291], [92, 45336], [96, 45558], [100, 45738], [106, 46018], [110, 46278], [115, 46498], [118, 46698], [123, 46938], [125, 47018], [128, 47118]]}, {"verse": 6, "start": 48004, "end": 52190, "text": "Y se llegaron las siervas, ellas y sus niños, y se inclinaron.", "words": [[0, 48004], [2, 48111], [5, 48231], [14, 48711], [18, 48911], [27, 49431], [33, 49811], [35, 50071], [39, 50231], [46, 50671], [48, 51011], [51, 51151]]}, {"verse": 7, "start": 52640, "end": 61511, "text": "Y Lea se acercó con sus niños, y se inclinaron: y después llegó José y Raquel, y también se inclinaron.", "words": [[0, 52809], [2, 53009], [6, 53209], [9, 53449], [16, 54089], [20, 54249], [24, 54469], [31, 54889], [33, 55429], [36, 55569], [48, 56951], [50, 57088], [58, 57448], [64, 58088], [69, 58568], [71, 59058], [79, 59548], [81, 59828], [89, 60108], [92, 60488]]}, {"verse": 8, "start": 61961, "end": 70224, "text": "Y él dijo: ¿Qué te propones con todas estas cuadrillas que he encontrado? Y él respondió: El hallar gracia en los ojos de mi señor.", "words": [[0, 61961], [2, 62149], [5, 62309], [11, 63078], [16, 63159], [19, 63299], [28, 63819], [32, 64059], [38, 64339], [44, 64659], [55, 65279], [59, 65479], [62, 65539], [74, 66584], [76, 66766], [79, 66906], [90, 67951], [93, 68092], [100, 68372], [107, 68852], [110, 68952], [114, 69072], [119, 69332], [122, 69572], [125, 69652]]}, {"verse": 9, "start": 70574, "end": 75344, "text": "Y dijo Esaú: Bastante tengo yo, hermano mío: sea para ti lo que es tuyo.", "words": [[0, 70574], [2, 70736], [7, 7123