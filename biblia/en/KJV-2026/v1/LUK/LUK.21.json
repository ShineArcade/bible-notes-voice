{"book": "LUK", "chapter": 21, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 248977, "verses": [{"verse": 1, "start": 300, "end": 4722, "text": "And he looked up, and saw the rich men casting their gifts into the treasury.", "words": [[0, 300], [4, 442], [7, 542], [14, 762], [18, 1062], [22, 1622], [26, 1882], [30, 2042], [35, 2282], [39, 2542], [47, 3022], [53, 3282], [59, 3582], [64, 3902], [68, 4082]]}, {"verse": 2, "start": 5072, "end": 8833, "text": "And he saw also a certain poor widow casting in there two mites.", "words": [[0, 5072], [4, 5216], [7, 5316], [11, 5536], [16, 5976], [18, 6196], [26, 6416], [31, 6776], [37, 7096], [45, 7576], [48, 7796], [54, 8016], [58, 8236]]}, {"verse": 3, "start": 9053, "end": 14184, "text": "And he said, Of a truth I say to you, that this poor widow has cast in more than they all:", "words": [[0, 9053], [4, 9194], [7, 9314], [13, 9554], [16, 9694], [18, 9794], [24, 10054], [26, 10294], [30, 10514], [33, 10734], [38, 11214], [43, 11494], [48, 11694], [53, 12054], [59, 12314], [63, 12574], [68, 12954], [71, 13134], [76, 13374], [81, 13574], [86, 13754]]}, {"verse": 4, "start": 14534, "end": 22702, "text": "For all these have of their abundance cast in to the offerings of God: but she of her poverty has cast in all the living that she had.", "words": [[0, 14534], [4, 14644], [8, 14964], [14, 15244], [19, 15684], [22, 15964], [28, 16124], [38, 16544], [43, 16864], [46, 17184], [49, 17504], [53, 17844], [63, 18264], [66, 18524], [71, 19290], [75, 19392], [79, 19652], [82, 19852], [86, 19952], [94, 20352], [98, 20612], [103, 20972], [106, 21212], [110, 21472], [114, 21612], [121, 21852], [126, 22092], [130, 22292]]}, {"verse": 5, "start": 22982, "end": 28555, "text": "¶ And as some spoke of the temple, how it was adorned with goodly stones and gifts, he said,", "words": [[2, 22982], [6, 23144], [9, 23304], [14, 23564], [20, 23884], [23, 24084], [27, 24204], [35, 25084], [39, 25264], [42, 25404], [46, 25624], [54, 26224], [59, 26304], [66, 26744], [73, 27084], [77, 27444], [84, 27964], [87, 28064]]}, {"verse": 6, "start": 28755, "end": 36588, "text": "As for these things which you behold, the days will come, in which there shall not be left one stone upon another, that shall not be thrown down.", "words": [[0, 28755], [3, 28981], [7, 29181], [13, 29321], [20, 29661], [26, 29861], [30, 29981], [38, 31021], [42, 31121], [47, 31381], [52, 31581], [58, 31941], [61, 32186], [67, 32386], [73, 32586], [79, 32786], [83, 33026], [86, 33186], [91, 33406], [95, 33706], [101, 34006], [106, 34226], [115, 34646], [120, 35226], [126, 35426], [130, 35666], [133, 35846], [140, 36066]]}, {"verse": 7, "start": 36868, "end": 42881, "text": "And they asked him, saying, Master, but when shall these things be? and what sign will there be when these things shall come to pass?", "words": [[0, 36868], [4, 36996], [9, 37156], [15, 37456], [20, 37596], [28, 38328], [36, 38867], [40, 38987], [45, 39167], [51, 39327], [57, 39527], [64, 39727], [68, 40307], [72, 40402], [77, 40562], [82, 40822], [87, 41002], [93, 41142], [96, 41342], [101, 41542], [107, 41702], [114, 41942], [120, 42122], [125, 42322], [128, 42442]]}, {"verse": 8, "start": 43161, "end": 53464, "text": "And he said, Take heed that you be not deceived: for many shall come in my name, saying, I am Christ; and the time draws near: do not go therefore after them.", "words": [[0, 43161], [4, 43296], [7, 43436], [13, 44844], [18, 45006], [23, 45326], [28, 45546], [32, 45706], [35, 45846], [39, 46046], [49, 47004], [53, 47105], [58, 47325], [64, 47565], [69, 47785], [72, 47885], [75, 48065], [81, 48385], [89, 49005], [91, 49325], [94, 49445], [102, 50328], [106, 50453], [110, 50533], [115, 50793], [121, 51033], [127, 51800], [130, 51885], [134, 52045], [137, 52355], [147, 52665], [153, 52985]]}, {"verse": 9, "start": 53814, "end": 62200, "text": "But when you shall hear of wars and commotions, be not terrified: for these things must first come to pass; but the end is not immediately.", "words": [[0, 53814], [4, 53936], [9, 54096], [13, 54296], [19, 54536], [24, 54776], [27, 54936], [32, 55296], [36, 55516], [48, 56396], [51, 56696], [55, 56936], [66, 58022], [70, 58085], [76, 58305], [83, 58705], [88, 58945], [94, 59265], [99, 59565], [102, 59705], [108, 60506], [112, 60612], [116, 60772], [120, 61092], [123, 61292], [127, 61452]]}, {"verse": 10, "start": 62480, "end": 67911, "text": "Then said he to them, Nation shall rise against nation, and kingdom against kingdom:", "words": [[0, 62480], [5, 62699], [10, 62939], [13, 63099], [16, 63239], [22, 63793], [29, 64141], [35, 64501], [40, 64901], [48, 65221], [56, 65921], [60, 66321], [68, 66721], [76, 67161]]}, {"verse": 11, "start": 68261, "end": 76187, "text": "And great earthquakes shall be in various places, and famines, and pestilences; and fearful sights and great signs shall there be from heaven.", "words": [[0, 68261], [4, 68385], [10, 68645], [22, 69165], [28, 69505], [31, 69685], [34, 69805], [42, 70085], [50, 70565], [54, 71085], [63, 71665], [67, 71865], [80, 73014], [84, 73137], [92, 73437], [99, 73937], [103, 74217], [109, 74417], [115, 74837], [121, 75117], [127, 75317], [130, 75497], [135, 75697]]}, {"verse": 12, "start": 76537, "end": 86909, "text": "But before all these, they shall lay their hands on you, and persecute you, delivering you up to the synagogues, and into prisons, being brought before kings and rulers for my name’s sake.", "words": [[0, 76537], [4, 76641], [11, 76901], [15, 77241], [22, 77581], [27, 77976], [33, 78196], [37, 78416], [43, 78596], [49, 78896], [52, 79136], [57, 79356], [61, 79816], [71, 80496], [76, 80676], [87, 81256], [91, 81596], [94, 81736], [97, 81856], [101, 81956], [113, 82696], [117, 82856], [122, 83076], [131, 83978], [137, 84158], [145, 84438], [152, 84738], [158, 85118], [162, 85358], [169, 85878], [173, 85958], [176, 86138], [183, 86498]]}, {"verse": 13, "start": 87259, "end": 89613, "text": "And it shall turn to you for a testimony.", "words": [[0, 87259], [4, 87407], [7, 87527], [13, 87727], [18, 88027], [21, 88227], [25, 88467], [29, 88727], [31, 88867]]}, {"verse": 14, "start": 89963, "end": 94214, "text": "Settle it therefore in your hearts, not to meditate before what you shall answer:", "words": [[0, 89963], [7, 90263], [10, 90463], [20, 90883], [23, 91123], [28, 91243], [36, 91883], [40, 92083], [43, 92283], [52, 92683], [59, 93023], [64, 93303], [68, 93443], [74, 93643]]}, {"verse": 15, "start": 94564, "end": 100618, "text": "For I will give you a mouth and wisdom, which all your adversaries shall not be able to contradict nor resist.", "words": [[0, 94564], [4, 94725], [6, 94905], [11, 95025], [16, 95225], [20, 95385], [22, 95485], [28, 95785], [32, 96025], [40, 96685], [46, 96925], [50, 97205], [55, 97385], [67, 98065], [73, 98285], [77, 98505], [80, 98705], [85, 98905], [88, 99025], [99, 99485], [103, 99945]]}, {"verse": 16, "start": 100968, "end": 108064, "text": "And you shall be betrayed both by parents, and brethren, and kinsfolks, and friends; and some of you shall they cause to be put to death.", "words": [[0, 100968], [4, 101103], [8, 101223], [14, 101403], [17, 101543], [26, 101943], [31, 102223], [34, 102463], [43, 102863], [47, 103383], [57, 103723], [61, 104233], [72, 104743], [76, 105183], [85, 106024], [89, 106109], [94, 106289], [97, 106409], [101, 106529], [107, 106689], [112, 106849], [118, 107109], [121, 107349], [124, 107469], [128, 107589], [131, 107729]]}, {"verse": 17, "start": 108414, "end": 111433, "text": "And you shall be hated of all men for my name’s sake.", "words": [[0, 108414], [4, 108536], [8, 108696], [14, 108896], [17, 109076], [23, 109416], [26, 109636], [30, 109836], [34, 110136], [38, 110356], [41, 110556], [48, 111016]]}, {"verse": 18, "start": 111783, "end": 114054, "text": "But there shall not a hair of your head perish.", "words": [[0, 111783], [4, 111888], [10, 112028], [16, 112268], [20, 112488], [22, 112628], [27, 112888], [30, 113028], [35, 113148], [40, 113388]]}, {"verse": 19, "start": 114404, "end": 116700, "text": "In your patience possess you your souls.", "words": [[0, 114447], [3, 114527], [8, 114797], [17, 115067], [25, 115467], [29, 115807], [34, 116027]]}, {"verse": 20, "start": 117050, "end": 122829, "text": "And when you shall see Jerusalem compassed with armies, then know that the desolation of it is near.", "words": [[0, 117050], [4, 117177], [9, 117357], [13, 117537], [19, 117757], [23, 117997], [33, 118637], [43, 119277], [48, 119357], [56, 120197], [61, 120597], [66, 120897], [71, 121117], [75, 121257], [86, 121877], [89, 122077], [92, 122197], [95, 122397]]}, {"verse": 21, "start": 123179, "end": 131913, "text": "Then let them which are in Judæa flee to the mountains; and let them which are in the midst of it depart out; and let not them that are in the countries enter into it.", "words": [[0, 123179], [5, 123375], [9, 123615], [14, 123855], [20, 124135], [24, 124295], [27, 124625], [33, 124955], [38, 125195], [41, 125395], [45, 125515], [56, 126345], [60, 126467], [64, 126647], [69, 126927], [75, 127127], [79, 127287], [82, 127427], [86, 127507], [92, 127787], [95, 127987], [98, 128087], [105, 128347], [110, 129149], [114, 129272], [118, 129432], [122, 129692], [127, 130032], [132, 130232], [136, 130372], [139, 130472], [143, 130572], [153, 130932], [159, 131312], [164, 131632]]}, {"verse": 22, "start": 132263, "end": 137368, "text": "For these are the days of vengeance, that all things which are written may be fulfilled.", "words": [[0, 132263], [4, 132359], [10, 132599], [14, 132819], [18, 132919], [23, 133299], [26, 133559], [37, 134399], [42, 134799], [46, 134999], [53, 135339], [59, 135599], [63, 135759], [71, 135999], [75, 136359], [78, 136539]]}, {"verse": 23, "start": 137718, "end": 146499, "text": "But woe to them that are with child, and to them that give suck, in those days! for there shall be great distress in the land, and wrath upon this people.", "words": [[0, 137718], [4, 137840], [8, 138220], [11, 138320], [16, 138560], [21, 138800], [25, 138920], [30, 139080], [37, 139520], [41, 140100], [44, 140240], [49, 140480], [54, 140700], [59, 140920], [65, 141340], [68, 141740], [74, 141980], [80, 142839], [84, 142937], [90, 143117], [96, 143297], [99, 143437], [105, 143737], [114, 144117], [117, 144437], [121, 144537], [127, 144877], [131, 145157], [137, 145437], [142, 145757], [147, 146017]]}, {"verse": 24, "start": 146849, "end": 157517, "text": "And they shall fall by the edge of the sword, and shall be led away captive into all nations: and Jerusalem shall be trodden down of the Gentiles, until the times of the Gentiles be fulfilled.", "words": [[0, 146849], [4, 146954], [9, 147074], [15, 147234], [20, 147514], [23, 147734], [27, 147854], [32, 148094], [35, 148214], [39, 148314], [46, 148654], [50, 149074], [56, 149234], [59, 149354], [63, 149574], [68, 149774], [76, 150154], [81, 150454], [85, 150714], [94, 151576], [98, 151717], [108, 152317], [114, 152857], [117, 153037], [125, 153477], [130, 153717], [133, 153897], [137, 154017], [147, 154717], [153, 155197], [157, 155417], [163, 155777], [166, 155957], [170, 156057], [179, 156697], [182, 156877]]}, {"verse": 25, "start": 157867, "end": 167720, "text": "¶ And there shall be signs in the sun, and in the moon, and in the stars; and upon the earth distress of nations, with perplexity; the sea and the waves roaring;", "words": [[2, 157867], [6, 157975], [12, 158115], [18, 158315], [21, 158455], [27, 158875], [30, 159095], [34, 159195], [39, 159515], [43, 159915], [46, 160035], [50, 160135], [56, 160455], [60, 160835], [63, 160955], [67, 161055], [74, 161935], [78, 162054], [83, 162294], [87, 162514], [93, 162734], [102, 163194], [105, 163474], [114, 163994], [119, 164554], [131, 165661], [135, 165746], [139, 166166], [143, 166486], [147, 166606], [153, 166986]]}, {"verse": 26, "start": 168070, "end": 175286, "text": "Men’s hearts failing them for fear, and for looking after those things which are coming on the earth: for the powers of heaven shall be shaken.", "words": [[0, 168070], [6, 168433], [13, 168673], [21, 169073], [26, 169353], [30, 169533], [36, 169913], [40, 170453], [44, 170573], [52, 170793], [58, 171093], [64, 171333], [71, 171713], [77, 171913], [81, 172033], [88, 172253], [91, 172433], [95, 172593], [102, 173113], [106, 173222], [110, 173322], [117, 173702], [120, 173962], [127, 174262], [133, 174522], [136, 174662]]}, {"verse": 27, "start": 175636, "end": 180345, "text": "And then shall they see the Son of man coming in a cloud with power and great glory.", "words": [[0, 175636], [4, 175777], [9, 176037], [15, 176337], [20, 176517], [24, 176737], [28, 176877], [32, 177097], [35, 177217], [39, 177517], [46, 177837], [49, 178037], [51, 178117], [57, 178497], [62, 178697], [68, 179097], [72, 179477], [78, 179717]]}, {"verse": 28, "start": 180695, "end": 187414, "text": "And when these things begin to come to pass, then look up, and lift up your heads; for your redemption draws near.", "words": [[0, 180695], [4, 180839], [9, 181019], [15, 181299], [22, 181619], [28, 181959], [31, 182159], [36, 182359], [39, 182519], [45, 183179], [50, 183439], [55, 183659], [59, 183979], [63, 184339], [68, 184579], [71, 184799], [76, 184919], [83, 185680], [87, 185784], [92, 185944], [103, 186424], [109, 186864]]}, {"verse": 29, "start": 187694, "end": 192046, "text": "And he spoke to them a parable; Behold the fig tree, and all the trees;", "words": [[0, 187694], [4, 187813], [7, 187913], [13, 188173], [16, 188393], [21, 188573], [23, 188693], [32, 189508], [39, 189851], [43, 190031], [47, 190251], [53, 190551], [57, 190951], [61, 191231], [65, 191391]]}, {"verse": 30, "start": 192396, "end": 197810, "text": "When they now shoot forth, you see and know of your own selves that summer is now near at hand.", "words": [[0, 192396], [5, 192514], [10, 192654], [14, 192854], [20, 193114], [27, 193894], [31, 194034], [35, 194354], [39, 194574], [44, 194834], [47, 195034], [52, 195154], [56, 195414], [63, 195814], [68, 196134], [75, 196474], [78, 196694], [82, 196894], [87, 197154], [90, 197334]]}, {"verse": 31, "start": 198160, "end": 203788, "text": "So likewise you, when you see these things come to pass, know that the kingdom of God is near at hand.", "words": [[0, 198160], [3, 198342], [12, 198662], [17, 199182], [22, 199302], [26, 199442], [30, 199622], [36, 199842], [43, 200142], [48, 200402], [51, 200562], [57, 201342], [62, 201582], [67, 201782], [71, 201922], [79, 202182], [82, 202402], [86, 202682], [89, 202902], [94, 203102], [97, 203282]]}, {"verse": 32, "start": 204138, "end": 209339, "text": "Assuredly I say to you, This generation shall not pass away, till all be fulfilled.", "words": [[0, 204138], [10, 204700], [12, 204820], [16, 205040], [19, 205220], [24, 205820], [29, 206040], [40, 206580], [46, 206860], [50, 207080], [55, 207340], [61, 207720], [66, 208160], [70, 208460], [73, 208660]]}, {"verse": 33, "start": 209689, "end": 213475, "text": "Heaven and earth shall pass away: but my words shall not pass away.", "words": [[0, 209689], [7, 209953], [11, 210253], [17, 210553], [23, 210753], [28, 210993], [34, 211747], [38, 211849], [41, 212059], [47, 212269], [53, 212509], [57, 212709], [62, 212929]]}, {"verse": 34, "start": 213825, "end": 223395, "text": "¶ And take heed to yourselves, lest at any time your hearts be overcharged with surfeiting, and drunkenness, and cares of this life, and so that day come upon you unawares.", "words": [[2, 213825], [6, 213966], [11, 214166], [16, 214486], [19, 214666], [31, 215766], [36, 215966], [39, 216106], [43, 216266], [48, 216586], [53, 216766], [60, 216986], [63, 217166], [75, 217686], [80, 218066], [92, 218446], [96, 218886], [109, 219526], [113, 219866], [119, 220126], [122, 220306], [127, 220446], [133, 221186], [137, 221266], [140, 221446], [145, 221666], [149, 221906], [154, 222086], [159, 222386], [163, 222606]]}, {"verse": 35, "start": 223745, "end": 228016, "text": "For as a snare shall it come on all them that dwell on the face of the whole earth.", "words": [[0, 223745], [4, 223856], [7, 224076], [9, 224196], [15, 224496], [21, 224836], [24, 224956], [29, 225156], [32, 225376], [36, 225656], [41, 225896], [46, 226196], [52, 226496], [55, 226736], [59, 226836], [64, 227116], [67, 227316], [71, 227436], [77, 227596]]}, {"verse": 36, "start": 228366, "end": 237167, "text": "Watch therefore, and pray always, that you may be accounted worthy to escape all these things that shall come to pass, and to stand before the Son of man.", "words": [[0, 228366], [6, 228689], [17, 229149], [21, 229569], [26, 229889], [34, 230769], [39, 230969], [43, 231129], [47, 231309], [50, 231469], [60, 231869], [67, 232269], [70, 232549], [77, 232929], [81, 233229], [87, 233429], [94, 233809], [99, 234009], [105, 234209], [110, 234449], [113, 234609], [119, 235309], [123, 235449], [126, 235569], [132, 235849], [139, 236169], [143, 236389], [147, 236609], [150, 236729]]}, {"verse": 37, "start": 237447, "end": 244145, "text": "And in the day time he was teaching in the temple; and at night he went out, and stayed on the mountain that is called the mount of Olives.", "words": [[0, 237447], [4, 237581], [7, 237721], [11, 237881], [15, 238041], [20, 238201], [23, 238541], [27, 238661], [36, 238941], [39, 239141], [43, 239221], [51, 239933], [55, 240078], [58, 240178], [64, 240438], [67, 240678], [72, 240858], [77, 241118], [81, 241518], [88, 241798], [91, 241978], [95, 242078], [104, 242338], [109, 242578], [112, 242698], [119, 242958], [123, 243138], [129, 243378], [132, 243558]]}, {"verse": 38, "start": 244495, "end": 248577, "text": "And all the people came early in the morning to him in the temple, to hear him.", "words": [[0, 244495], [4, 244606], [8, 244786], [12, 244926], [19, 245206], [24, 245486], [30, 245846], [33, 246006], [37, 246086], [45, 246366], [48, 246646], [52, 246846], [55, 247026], [59, 247126], [67, 247806], [70, 247946], [75, 248186]]}]}