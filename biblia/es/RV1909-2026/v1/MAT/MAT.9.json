{"book": "MAT", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 312284, "verses": [{"verse": 1, "start": 300, "end": 5495, "text": "Entonces entrando en el barco, pasó a la otra parte, y vino a su ciudad.", "words": [[0, 300], [9, 824], [18, 1544], [21, 1704], [24, 1844], [31, 2724], [36, 3084], [38, 3224], [41, 3304], [46, 3484], [53, 3944], [55, 4284], [60, 4504], [62, 4664], [65, 4824]]}, {"verse": 2, "start": 5845, "end": 17108, "text": "Y he aquí le trajeron un paralítico, echado en una cama: y viendo Jesús la fe de ellos, dijo al paralítico: Confía, hijo; tus pecados te son perdonados.", "words": [[0, 5845], [2, 6174], [5, 6314], [10, 6574], [13, 6734], [22, 7314], [25, 7434], [37, 8394], [44, 9014], [47, 9174], [51, 9354], [57, 10152], [59, 10256], [66, 10496], [72, 11236], [75, 11316], [78, 11496], [81, 11676], [88, 12476], [93, 12876], [96, 13096], [108, 14185], [116, 14680], [122, 15379], [126, 15443], [134, 15923], [137, 16043], [141, 16203]]}, {"verse": 3, "start": 17458, "end": 22624, "text": "Y he aquí, algunos de los escribas decían dentro de sí: Este blasfema.", "words": [[0, 17458], [2, 17621], [5, 17821], [11, 18161], [19, 18681], [22, 18921], [26, 19041], [35, 19561], [42, 20041], [49, 20321], [52, 20621], [56, 21150], [61, 21411]]}, {"verse": 4, "start": 22904, "end": 28282, "text": "Y viendo Jesús sus pensamientos, dijo: ¿Por qué pensáis mal en vuestros corazones?", "words": [[0, 22904], [2, 23030], [9, 23270], [15, 23990], [19, 24090], [33, 25030], [39, 25797], [44, 25923], [48, 26083], [56, 26523], [60, 26803], [63, 26983], [72, 27403]]}, {"verse": 5, "start": 28632, "end": 34997, "text": "Porque, ¿qué es más fácil, decir: Los pecados te son perdonados; o decir: Levántate, y anda?", "words": [[0, 28702], [8, 28772], [13, 28912], [16, 29172], [20, 29332], [27, 29672], [34, 30794], [38, 30902], [46, 31222], [49, 31542], [53, 31722], [65, 32805], [67, 32921], [74, 33637], [85, 34278], [87, 34598]]}, {"verse": 6, "start": 35347, "end": 46449, "text": "Pues para que sepáis que el Hijo del hombre tiene autoridad en la tierra de perdonar pecados, (dice entonces al paralítico): Levántate, toma tu cama, y vete a tu casa.", "words": [[0, 35347], [5, 35711], [10, 36016], [14, 36176], [21, 36716], [25, 36956], [28, 37116], [33, 37376], [37, 37516], [44, 37816], [50, 38136], [60, 38916], [63, 39076], [66, 39216], [73, 39576], [76, 39796], [85, 40356], [94, 41392], [100, 41612], [109, 42012], [112, 42332], [125, 43511], [136, 44195], [141, 44355], [144, 44555], [150, 44895], [152, 45435], [157, 45715], [159, 45795], [162, 45895]]}, {"verse": 7, "start": 46799, "end": 50193, "text": "Entonces él se levantó y se fue a su casa.", "words": [[0, 46799], [9, 47762], [12, 47964], [15, 48164], [23, 48804], [25, 48969], [28, 49089], [32, 49309], [34, 49429], [37, 49589]]}, {"verse": 8, "start": 50543, "end": 57248, "text": "Y la gente, al verlo, se maravilló y glorificó a Dios, que había dado tal autoridad a los hombres.", "words": [[0, 50543], [2, 50792], [5, 50912], [12, 51232], [15, 51432], [22, 51892], [25, 52292], [35, 52912], [37, 53012], [47, 53732], [49, 53952], [55, 54672], [59, 54872], [65, 55092], [70, 55372], [74, 55632], [84, 56272], [86, 56412], [90, 56532]]}, {"verse": 9, "start": 57598, "end": 70523, "text": "Y pasando Jesús de allí, vio a un hombre que estaba sentado a la mesa de recaudación de impuestos, el cual se llamaba Mateo; y le dice: Sígueme. Y se levantó, y le siguió.", "words": [[0, 57598], [2, 57721], [10, 58121], [16, 58581], [19, 58881], [25, 59466], [29, 59826], [31, 60046], [34, 60266], [41, 60606], [45, 60766], [52, 61066], [60, 61746], [62, 61866], [65, 61966], [70, 62246], [73, 62466], [85, 63346], [88, 63586], [99, 64786], [102, 64866], [107, 65046], [110, 65226], [118, 65706], [125, 66719], [127, 66876], [130, 66916], [136, 67498], [145, 68539], [147, 68668], [150, 68768], [159, 69548], [161, 69828], [164, 69948]]}, {"verse": 10, "start": 70873, "end": 82420, "text": "Y aconteció que estando él sentado a la mesa en casa, he aquí que muchos publicanos y pecadores, que habían venido, se sentaron juntamente a la mesa con Jesús y sus discípulos.", "words": [[0, 70873], [2, 70980], [12, 71660], [16, 71880], [24, 72520], [27, 72820], [35, 73480], [37, 73620], [40, 73740], [45, 74020], [48, 74220], [54, 74820], [57, 75420], [62, 75660], [66, 75820], [73, 76040], [84, 76780], [86, 77090], [97, 77400], [101, 77600], [108, 77760], [116, 78670], [119, 78816], [128, 79296], [139, 79956], [141, 80076], [144, 80136], [149, 80336], [153, 80556], [159, 80936], [161, 81436], [165, 81596]]}, {"verse": 11, "start": 82770, "end": 90501, "text": "Y viendo esto los fariseos, dijeron a sus discípulos: ¿Por qué come vuestro Maestro con los publicanos y pecadores?", "words": [[0, 82770], [2, 82874], [9, 83194], [14, 83594], [18, 83894], [28, 84814], [36, 85674], [38, 85774], [42, 85934], [54, 87129], [59, 87276], [63, 87456], [68, 87716], [76, 88136], [84, 88616], [88, 88836], [92, 88936], [103, 89556], [105, 89716]]}, {"verse": 12, "start": 90781, "end": 98375, "text": "Y oyéndolo Jesús, les dijo: Los que están sanos no tienen necesidad de médico, sino los enfermos.", "words": [[0, 90781], [2, 90982], [11, 91582], [18, 91882], [22, 92262], [28, 93090], [32, 93219], [36, 93359], [42, 93639], [48, 94299], [51, 94539], [58, 94899], [68, 96059], [71, 96239], [79, 96799], [84, 97339], [88, 97579]]}, {"verse": 13, "start": 98725, "end": 109219, "text": "Andad pues, y aprended qué cosa es: Misericordia quiero, y no sacrificio: porque no he venido a llamar justos, sino pecadores a arrepentimiento.", "words": [[0, 98919], [6, 99139], [12, 99339], [14, 99659], [23, 99979], [27, 100299], [32, 100619], [36, 101353], [49, 102100], [57, 102500], [59, 102960], [62, 103080], [74, 104172], [81, 104437], [84, 104657], [87, 104737], [94, 105097], [96, 105197], [103, 105537], [111, 106477], [116, 106757], [126, 107437], [128, 107777]]}, {"verse": 14, "start": 109569, "end": 119150, "text": "Entonces los discípulos de Juan vienen a él, diciendo: ¿Por qué nosotros y los fariseos ayunamos muchas veces, y tus discípulos no ayunan?", "words": [[0, 109569], [9, 110014], [13, 110374], [24, 111014], [27, 111174], [32, 111454], [39, 112094], [41, 112334], [45, 112574], [55, 114000], [60, 114125], [64, 114285], [73, 114785], [75, 115025], [79, 115145], [88, 115845], [97, 116425], [104, 116665], [111, 117065], [113, 117465], [117, 117605], [128, 118265], [131, 118545]]}, {"verse": 15, "start": 119430, "end": 131578, "text": "Y Jesús les dijo: ¿Pueden los que son de bodas tener luto entre tanto que el esposo está con ellos? pero vendrán días cuando el esposo será quitado de ellos, y entonces ayunarán.", "words": [[0, 119430], [2, 119571], [8, 119951], [12, 120431], [18, 121214], [26, 121536], [30, 121656], [34, 121776], [38, 122009], [41, 122243], [47, 122476], [53, 122716], [58, 123216], [64, 123436], [70, 123836], [74, 124076], [77, 124196], [84, 124556], [89, 124736], [93, 125016], [100, 125760], [105, 125905], [113, 126385], [118, 126685], [125, 127385], [128, 127605], [135, 127965], [140, 128245], [148, 128805], [151, 129025], [158, 129345], [160, 129885], [169, 130365]]}, {"verse": 16, "start": 131928, "end": 141388, "text": "Y nadie echa remiendo de tela sin encoger en vestido viejo; porque el tal remiendo tira del vestido, y se hace peor la rotura.", "words": [[0, 131928], [2, 132065], [8, 132365], [13, 132935], [22, 133505], [25, 133705], [30, 134065], [34, 134425], [42, 135105], [45, 135325], [53, 135765], [60, 136586], [67, 136850], [70, 137110], [74, 137310], [83, 138030], [88, 138430], [92, 138630], [101, 139210], [103, 139650], [106, 139790], [111, 140030], [116, 140430], [119, 140610]]}, {"verse": 17, "start": 141738, "end": 156567, "text": "Ni echan vino nuevo en odres viejos: de otra manera los odres se rompen, y el vino se derrama, y se pierden los odres; sino que echan el vino nuevo en odres nuevos, y lo uno y lo otro se conserva juntamente.", "words": [[0, 141738], [3, 141935], [9, 142255], [14, 142715], [20, 143175], [23, 143375], [29, 143575], [37, 144738], [40, 144904], [45, 145084], [52, 145504], [56, 145764], [62, 146184], [65, 146304], [73, 146844], [75, 147344], [78, 147504], [83, 147704], [86, 147924], [95, 148464], [97, 148679], [100, 148799], [108, 149259], [112, 149419], [119, 150333], [124, 150579], [128, 150839], [134, 151319], [137, 151499], [142, 151719], [148, 152179], [151, 152559], [157, 153059], [165, 153499], [167, 153839], [170, 153999], [174, 154299], [176, 154459], [179, 154579], [184, 154819], [187, 155019], [196, 155659]]}, {"verse": 18, "start": 156917, "end": 166734, "text": "Hablando él estas cosas a ellos, he aquí vino un dirigente, y le adoraba, diciendo: Mi hija acaba de morir: pero ven y pon tu mano sobre ella, y vivirá.", "words": [[0, 156917], [9, 157285], [12, 157525], [18, 157725], [24, 158145], [26, 158405], [33, 159065], [36, 159145], [41, 159405], [46, 159745], [49, 159945], [60, 160665], [62, 161145], [65, 161285], [74, 161765], [84, 162805], [87, 162950], [92, 163250], [98, 163430], [101, 163650], [108, 164337], [113, 164482], [117, 164722], [119, 164842], [123, 165042], [126, 165162], [131, 165362], [137, 165682], [143, 165962], [145, 166162]]}, {"verse": 19, "start": 167014, "end": 171231, "text": "Y se levantó Jesús, y le siguió, y sus discípulos.", "words": [[0, 167014], [2, 167158], [5, 167258], [13, 167818], [20, 168238], [22, 168798], [25, 168938], [33, 169518], [35, 169918], [39, 170098]]}, {"verse": 20, "start": 171581, "end": 179549, "text": "Y he aquí una mujer enferma de hemorragia doce años había, llegándose por detrás, tocó la franja de su vestido:", "words": [[0, 171581], [2, 171963], [5, 172103], [10, 172323], [14, 172523], [20, 172803], [28, 173443], [31, 173583], [42, 174133], [47, 174683], [52, 175063], [59, 175523], [70, 176743], [74, 176923], [82, 177503], [87, 178063], [90, 178183], [97, 178623], [100, 178763], [103, 178923]]}, {"verse": 21, "start": 179899, "end": 185102, "text": "Porque decía entre sí: Si toco solamente su vestido, seré salva.", "words": [[0, 179899], [7, 180121], [13, 180601], [19, 181081], [23, 181717], [26, 181897], [31, 182257], [41, 182777], [44, 183197], [53, 184217], [58, 184537]]}, {"verse": 22, "start": 185382, "end": 194726, "text": "Pero Jesús volviéndose, y mirándola, dijo: Confía, hija, tu fe te ha salvado. Y la mujer fue salva desde aquella hora.", "words": [[0, 185382], [5, 185547], [11, 186367], [24, 187187], [26, 187447], [37, 188507], [43, 189354], [51, 190076], [57, 190796], [60, 190916], [63, 191096], [66, 191236], [69, 191316], [78, 192237], [80, 192324], [83, 192424], [89, 192624], [93, 192924], [99, 193384], [105, 193564], [113, 193984]]}, {"verse": 23, "start": 195076, "end": 201541, "text": "Y llegado Jesús a casa del principal, viendo los flautistas, y la gente que hacía bullicio,", "words": [[0, 195076], [2, 195179], [10, 195579], [16, 195879], [18, 196179], [23, 196479], [27, 196719], [38, 197879], [45, 198139], [49, 198399], [61, 199099], [63, 199579], [66, 199699], [72, 199959], [76, 200159], [82, 200499]]}, {"verse": 24, "start": 201891, "end": 207881, "text": "Les dice: Apartaos, que la muchacha no es muerta, sino que duerme. Y se burlaban de él.", "words": [[0, 201941], [4, 202021], [10, 203256], [20, 203776], [24, 203876], [27, 203976], [36, 204416], [39, 204616], [42, 204716], [50, 205336], [55, 205556], [59, 205756], [67, 206543], [69, 206648], [72, 206808], [81, 207348], [84, 207588]]}, {"verse": 25, "start": 208231, "end": 215091, "text": "Y como la gente fue echada fuera, entró, y la tomó de la mano, y se levantó la muchacha.", "words": [[0, 208231], [2, 208360], [7, 208580], [10, 208740], [16, 209080], [20, 209380], [27, 210090], [34, 210800], [41, 211320], [43, 211940], [46, 212060], [51, 212480], [54, 212540], [57, 212700], [63, 213100], [65, 213580], [68, 213720], [76, 214200], [79, 214320]]}, {"verse": 26, "start": 215441, "end": 219083, "text": "Y salió esta fama por toda aquella tierra.", "words": [[0, 215441], [2, 215761], [8, 216241], [13, 216621], [18, 217161], [22, 217341], [27, 217721], [35, 218321]]}, {"verse": 27, "start": 219433, "end": 228267, "text": "Y pasando Jesús de allí, le siguieron dos ciegos, dando voces y diciendo: Ten misericordia de nosotros, Hijo de David.", "words": [[0, 219433], [2, 219537], [10, 219977], [16, 220457], [19, 220757], [25, 221457], [28, 221557], [38, 222117], [42, 222357], [50, 223457], [56, 223717], [62, 224457], [64, 224697], [74, 225618], [78, 225740], [91, 226520], [94, 226640], [104, 227480], [109, 227640], [112, 227820]]}, {"verse": 28, "start": 228547, "end": 237939, "text": "Y llegado a la casa, vinieron a él los ciegos; y Jesús les dice: ¿Creéis que puedo hacer esto? Ellos dicen: Sí, Señor.", "words": [[0, 228547], [2, 228654], [10, 229074], [12, 229174], [15, 229254], [21, 229634], [30, 230534], [32, 230694], [35, 230894], [39, 231074], [47, 232038], [49, 232183], [55, 232543], [59, 232923], [65, 233700], [73, 234127], [77, 234247], [83, 234487], [89, 234787], [95, 235559], [101, 236101], [108, 236960], [112, 237388]]}, {"verse": 29, "start": 238219, "end": 244229, "text": "Entonces tocó los ojos de ellos, diciendo: Conforme a vuestra fe os sea hecho.", "words": [[0, 238219], [9, 238823], [14, 239403], [18, 239583], [23, 239883], [26, 240183], [33, 240503], [43, 241676], [52, 242260], [54, 242340], [62, 242620], [65, 242900], [68, 243180], [72, 243560]]}, {"verse": 30, "start": 244579, "end": 252728, "text": "Y los ojos de ellos fueron abiertos. Y Jesús les advirtió firmemente, diciendo: Mirad que nadie lo sepa.", "words": [[0, 244579], [2, 244840], [6, 245000], [11, 245280], [14, 245500], [20, 245720], [27, 246040], [37, 247229], [39, 247504], [45, 247924], [49, 248464], [58, 249164], [70, 250204], [80, 251175], [86, 251582], [90, 251737], [96, 251977], [99, 252197]]}, {"verse": 31, "start": 253078, "end": 257383, "text": "Pero ellos salidos, divulgaron su fama por toda aquella tierra.", "words": [[0, 253078], [5, 253222], [11, 253502], [20, 254202], [31, 255262], [34, 255422], [39, 255822], [43, 256002], [48, 256242], [56, 256682]]}, {"verse": 32, "start": 257733, "end": 262464, "text": "Y saliendo ellos, he aquí, le trajeron un hombre mudo, endemoniado.", "words": [[0, 257733], [2, 257984], [11, 258504], [18, 258764], [21, 259024], [27, 259704], [30, 259784], [39, 260404], [42, 260504], [49, 260744], [55, 261633]]}, {"verse": 33, "start": 262814, "end": 271903, "text": "Y echado fuera el demonio, el mudo habló; y la gente se maravillaba, diciendo: Nunca ha sido vista cosa semejante en Israel.", "words": [[0, 262814], [2, 263069], [9, 263469], [15, 263689], [18, 263949], [27, 264789], [30, 264909], [35, 265269], [42, 266097], [44, 266218], [47, 266338], [53, 266638], [56, 266918], [69, 267778], [79, 269021], [85, 269467], [88, 269587], [93, 269747], [99, 270027], [104, 270427], [114, 271147], [117, 271287]]}, {"verse": 34, "start": 272183, "end": 277754, "text": "Pero los fariseos decían: Por el príncipe de los demonios echa fuera los demonios.", "words": [[0, 272183], [5, 272347], [9, 272587], [18, 273387], [26, 274427], [30, 274571], [33, 274671], [42, 275251], [45, 275371], [49, 275491], [58, 275991], [63, 276491], [69, 276711], [73, 276951]]}, {"verse": 35, "start": 278034, "end": 291288, "text": "Y rodeaba Jesús por todas las ciudades y aldeas, enseñando en las sinagogas de ellos, y predicando el evangelio del reino, y sanando toda enfermedad y toda dolencia en el pueblo.", "words": [[0, 278034], [2, 278218], [10, 278918], [16, 279318], [20, 279718], [26, 280038], [30, 280298], [39, 280938], [41, 281078], [49, 281818], [59, 282698], [62, 282818], [66, 282938], [76, 283678], [79, 283838], [86, 284118], [88, 284578], [99, 285378], [102, 285538], [112, 286118], [116, 286318], [123, 287183], [125, 287288], [133, 287808], [138, 288128], [149, 289048], [151, 289188], [156, 289408], [165, 290308], [168, 290448], [171, 290588]]}, {"verse": 36, "start": 291638, "end": 299952, "text": "Y al ver las multitudes, tuvo compasión de ellas; porque estaban desamparadas y dispersas como ovejas que no tienen pastor.", "words": [[0, 291638], [2, 291761], [5, 291901], [9, 292101], [13, 292321], [25, 292961], [30, 293241], [40, 293981], [43, 294181], [50, 294945], [57, 295245], [65, 295585], [78, 296565], [80, 296725], [90, 297565], [95, 298025], [102, 298565], [106, 298825], [109, 298985], [116, 299245]]}, {"verse": 37, "start": 300302, "end": 306369, "text": "Entonces dice a sus discípulos: A la verdad la cosecha es mucha, pero los obreros pocos.", "words": [[0, 300302], [9, 300847], [14, 301487], [16, 301827], [20, 302007], [32, 303127], [34, 303237], [37, 303337], [44, 303797], [47, 304047], [55, 304297], [58, 304417], [65, 304817], [70, 305017], [74, 305197], [82, 305677]]}, {"verse": 38, "start": 306719, "end": 311884, "text": "Rogad, pues, al Señor de la cosecha, que envíe obreros a su cosecha.", "words": [[0, 306975], [7, 307265], [13, 307505], [16, 308205], [22, 308505], [25, 308685], [28, 308805], [37, 309405], [41, 309825], [47, 310305], [55, 310925], [57, 311045], [60, 311185]]}]}