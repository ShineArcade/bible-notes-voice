{"book": "PSA", "chapter": 69, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 253849, "verses": [{"verse": 1, "start": 300, "end": 9530, "text": "Al Músico principal: sobre Sosannim: Salmo de David. SÁLVAME, oh Dios, porque las aguas han entrado hasta el alma.", "words": [[0, 300], [3, 484], [10, 984], [21, 2163], [27, 2447], [37, 3298], [43, 3569], [46, 3841], [53, 5734], [62, 6114], [65, 6494], [71, 7174], [78, 7334], [82, 7614], [88, 7994], [92, 8134], [100, 8674], [106, 8834], [109, 9014]]}, {"verse": 2, "start": 9980, "end": 17949, "text": "Estoy hundido en cieno profundo, donde no hay pie: he venido a abismos de aguas, y la corriente me ha anegado.", "words": [[0, 9980], [6, 10367], [14, 10847], [17, 11027], [23, 11407], [33, 11967], [39, 12467], [42, 12767], [46, 12927], [51, 13667], [54, 13794], [61, 14194], [63, 14374], [71, 14794], [74, 14934], [81, 15514], [83, 15934], [86, 16054], [96, 16654], [99, 16954], [102, 17488]]}, {"verse": 3, "start": 18399, "end": 26700, "text": "Cansado estoy de llamar; mi garganta se ha enronquecido; han desfallecido mis ojos esperando a mi Dios.", "words": [[0, 18399], [8, 18960], [14, 19200], [17, 19440], [25, 20318], [28, 20618], [37, 20885], [40, 21151], [43, 21418], [57, 23048], [61, 23348], [74, 24188], [78, 24368], [83, 24688], [93, 25208], [95, 25528], [98, 25608]]}, {"verse": 4, "start": 27150, "end": 41012, "text": "Se han aumentado más que los cabellos de mi cabeza los que me aborrecen sin causa; se han fortalecido mis enemigos, los que me destruyen sin por qué: he venido pues a pagar lo que no he tomado.", "words": [[0, 27150], [3, 27297], [7, 27457], [17, 28177], [21, 28437], [25, 28657], [29, 28817], [38, 29397], [41, 29477], [44, 29597], [51, 30597], [55, 30657], [59, 30817], [62, 30957], [72, 31537], [76, 31737], [83, 32851], [86, 33180], [90, 33320], [102, 34260], [106, 34440], [116, 35460], [120, 35820], [124, 35960], [127, 36100], [137, 36820], [141, 37060], [145, 37380], [150, 38170], [153, 38275], [160, 38675], [165, 38915], [167, 39135], [173, 39435], [176, 39835], [180, 39975], [183, 40215], [186, 40355]]}, {"verse": 5, "start": 41462, "end": 45473, "text": "Dios, tú sabes mi locura; y mis delitos no te son ocultos.", "words": [[0, 41462], [6, 41707], [9, 41947], [15, 42207], [18, 42487], [26, 43317], [28, 43426], [32, 43566], [40, 44066], [43, 44286], [46, 44446], [50, 44686]]}, {"verse": 6, "start": 45923, "end": 55782, "text": "No sean avergonzados por mi causa los que te esperan, oh Señor Jehová de los ejércitos; no sean confusos por mí los que te buscan, oh Dios de Israel.", "words": [[0, 45923], [3, 46050], [8, 46330], [21, 47250], [25, 47490], [28, 47670], [34, 48050], [38, 48290], [42, 48430], [45, 48530], [54, 49040], [57, 49550], [63, 49950], [70, 50550], [73, 50650], [77, 50810], [88, 52116], [91, 52221], [96, 52461], [105, 53121], [109, 53328], [112, 53534], [116, 53741], [120, 53861], [123, 53981], [131, 54341], [134, 54701], [139, 54901], [142, 55121]]}, {"verse": 7, "start": 56232, "end": 62075, "text": "Porque por amor de ti he sufrido afrenta; confusión ha cubierto mi rostro.", "words": [[0, 56232], [7, 56496], [11, 56776], [16, 57036], [19, 57296], [22, 57516], [25, 57756], [33, 58356], [42, 59570], [52, 60397], [55, 60597], [64, 61157], [67, 61337]]}, {"verse": 8, "start": 62525, "end": 67883, "text": "He sido extrañado de mis hermanos, y extraño a los hijos de mi madre.", "words": [[0, 62525], [3, 62632], [8, 62932], [18, 63912], [21, 64092], [25, 64232], [35, 65252], [37, 65432], [45, 66212], [47, 66472], [51, 66652], [57, 66952], [60, 67152], [63, 67272]]}, {"verse": 9, "start": 68333, "end": 74887, "text": "Porque me consumió el celo de tu casa; y los denuestos de los que te vituperaban, cayeron sobre mí.", "words": [[0, 68333], [7, 68558], [10, 68758], [19, 69558], [22, 69818], [27, 70278], [30, 70378], [33, 70558], [39, 71385], [41, 71615], [45, 71775], [55, 72395], [58, 72515], [62, 72615], [66, 72755], [69, 72915], [82, 73615], [90, 74215], [96, 74475]]}, {"verse": 10, "start": 75337, "end": 80462, "text": "Y lloré afligiendo con ayuno mi alma; y esto me ha sido por afrenta.", "words": [[0, 75337], [2, 75463], [8, 75983], [19, 76883], [23, 77103], [29, 77503], [32, 77763], [38, 78630], [40, 78747], [45, 78947], [48, 79147], [51, 79247], [56, 79467], [60, 79727]]}, {"verse": 11, "start": 80912, "end": 86055, "text": "Puse además saco por mi vestido; y vine a serles por proverbio.", "words": [[0, 80912], [5, 81194], [12, 81454], [17, 82074], [21, 82274], [24, 82454], [33, 83521], [35, 83854], [40, 84054], [42, 84434], [49, 84814], [53, 85094]]}, {"verse": 12, "start": 86505, "end": 94648, "text": "Hablaban contra mí los que se sentaban a la puerta, y se burlaban de mí en sus canciones de los bebedores de sidra.", "words": [[0, 86505], [9, 86928], [16, 87308], [19, 87588], [23, 87908], [27, 88068], [30, 88208], [39, 88828], [41, 88928], [44, 89028], [52, 90018], [54, 90308], [57, 90508], [66, 91108], [69, 91348], [72, 91528], [75, 91828], [79, 92148], [89, 93008], [92, 93228], [96, 93348], [106, 93888], [109, 94298]]}, {"verse": 13, "start": 95098, "end": 106033, "text": "Pero yo enderezaba mi oración a ti, oh Jehová, al tiempo de tu buena voluntad: oh Dios, por la multitud de tu misericordia, por la verdad de tu salvación, óyeme.", "words": [[0, 95098], [5, 95245], [8, 95545], [19, 96345], [22, 96525], [30, 96945], [32, 97145], [36, 97355], [39, 97565], [47, 98085], [50, 98265], [57, 98545], [60, 98805], [63, 98945], [69, 99165], [79, 101295], [82, 101295], [88, 101295], [92, 101656], [95, 101836], [104, 102456], [107, 102636], [110, 102776], [124, 103776], [128, 103856], [131, 104016], [138, 104276], [141, 104536], [144, 104676], [155, 105496]]}, {"verse": 14, "start": 106483, "end": 114446, "text": "Sácame del lodo, y no sea yo sumergido: sea yo libertado de los que me aborrecen, y del profundo de las aguas.", "words": [[0, 106483], [7, 106967], [11, 107247], [17, 107627], [19, 107727], [22, 107907], [26, 108087], [29, 108367], [40, 109601], [44, 109818], [47, 110038], [57, 110758], [60, 110918], [64, 111018], [68, 111178], [71, 111318], [82, 112018], [84, 112478], [88, 112638], [97, 113318], [100, 113518], [104, 113698]]}, {"verse": 15, "start": 114896, "end": 122011, "text": "No me anegue el ímpetu de las aguas, ni me trague la hondura, ni el pozo cierre sobre mí su boca.", "words": [[0, 114896], [3, 115080], [6, 115380], [13, 115680], [16, 115940], [23, 116520], [26, 116680], [30, 116880], [37, 117920], [40, 118260], [43, 118420], [50, 118740], [53, 119230], [62, 119720], [65, 119860], [68, 119980], [73, 120320], [80, 120740], [86, 120980], [89, 121220], [92, 121400]]}, {"verse": 16, "start": 122461, "end": 129420, "text": "Óyeme, Jehová, porque apacible es tu misericordia; mírame conforme a la multitud de tus misericordias.", "words": [[0, 122781], [7, 123101], [15, 123421], [22, 123621], [31, 124381], [34, 124561], [37, 124621], [51, 126102], [58, 126407], [67, 126707], [69, 127007], [72, 127107], [81, 127727], [84, 127967], [88, 128127]]}, {"verse": 17, "start": 129870, "end": 135560, "text": "Y no escondas tu rostro de tu siervo; porque estoy angustiado; apresúrate, óyeme.", "words": [[0, 129870], [2, 129987], [5, 130127], [14, 130687], [17, 130827], [24, 131327], [27, 131447], [30, 131607], [38, 132534], [45, 132718], [51, 132958], [63, 134129], [75, 134828]]}, {"verse": 18, "start": 136010, "end": 140695, "text": "Acércate a mi alma, redímela: líbrame a causa de mis enemigos.", "words": [[0, 136010], [9, 136630], [11, 136810], [14, 136930], [20, 137637], [30, 138846], [38, 139086], [40, 139226], [46, 139526], [49, 139786], [53, 139886]]}, {"verse": 19, "start": 141145, "end": 147965, "text": "Tú sabes mi afrenta, y mi confusión, y mi deshonra: delante de ti están todos mis enemigos.", "words": [[0, 141145], [3, 141252], [9, 141511], [12, 141752], [21, 142592], [23, 142752], [26, 142872], [37, 143712], [39, 143972], [42, 144457], [52, 145188], [60, 145788], [63, 145948], [66, 146188], [72, 146448], [78, 146848], [82, 147128]]}, {"verse": 20, "start": 148415, "end": 158570, "text": "La afrenta ha quebrantado mi corazón, y estoy acongojado: y esperé quien se compadeciese de mí, y no lo hubo: y consoladores, y ninguno hallé.", "words": [[0, 148415], [3, 148565], [11, 149245], [14, 149405], [26, 150225], [29, 150405], [38, 150905], [40, 151385], [46, 151625], [58, 152884], [60, 153030], [67, 153510], [73, 153710], [76, 154240], [89, 154770], [92, 154990], [96, 155150], [98, 155330], [101, 155470], [104, 155630], [110, 156352], [112, 156457], [126, 157337], [128, 157697], [136, 158160]]}, {"verse": 21, "start": 159020, "end": 164140, "text": "Me pusieron además hiel por comida, y en mi sed me dieron a beber vinagre.", "words": [[0, 159020], [3, 159109], [12, 159629], [19, 160139], [24, 160649], [28, 160909], [36, 161429], [38, 161709], [41, 161889], [44, 162089], [48, 162409], [51, 162669], [58, 163029], [60, 163149], [66, 163349]]}, {"verse": 22, "start": 164590, "end": 169531, "text": "Sea su mesa delante de ellos por lazo, y lo que es para bien por tropiezo.", "words": [[0, 164590], [4, 164833], [7, 165073], [12, 165393], [20, 165913], [23, 166113], [29, 166293], [33, 166533], [39, 167033], [41, 167473], [44, 167613], [48, 167773], [51, 167933], [56, 168113], [61, 168333], [65, 168593]]}, {"verse": 23, "start": 169981, "end": 176075, "text": "Sean oscurecidos sus ojos para ver, y haz siempre titubear sus lomos.", "words": [[0, 169981], [5, 170421], [17, 171521], [21, 171821], [26, 172121], [31, 172441], [36, 172741], [38, 173161], [42, 173341], [50, 174001], [59, 175041], [63, 175261]]}, {"verse": 24, "start": 176525, "end": 181283, "text": "Derrama sobre ellos tu ira, y el furor de tu enojo los alcance.", "words": [[0, 176525], [8, 177059], [14, 177359], [20, 177679], [23, 177999], [28, 178859], [30, 179039], [33, 179179], [39, 179579], [42, 179739], [45, 179899], [51, 180279], [55, 180459]]}, {"verse": 25, "start": 181733, "end": 186914, "text": "Sea su palacio asolado: en sus tiendas no haya habitante.", "words": [[0, 181733], [4, 182018], [7, 182258], [15, 182908], [24, 183857], [27, 183963], [31, 184103], [39, 184723], [42, 185103], [47, 185323]]}, {"verse": 26, "start": 187364, "end": 192489, "text": "Porque persiguieron al que tú heriste; y cuentan del dolor de los que tú llagaste.", "words": [[0, 187534], [7, 187744], [20, 188144], [23, 188304], [27, 188464], [30, 188982], [39, 189770], [41, 189873], [49, 190393], [53, 190593], [59, 190973], [62, 191193], [66, 191313], [70, 191493], [73, 192020]]}, {"verse": 27, "start": 192939, "end": 197193, "text": "Pon maldad sobre su maldad, y no entren en tu justicia.", "words": [[0, 192939], [4, 193083], [11, 193623], [17, 194043], [20, 194263], [28, 194883], [30, 195323], [33, 195503], [40, 195823], [43, 196083], [46, 196243]]}, {"verse": 28, "start": 197643, "end": 202074, "text": "Sean raídos del libro de los vivientes, y no sean escritos con los justos.", "words": [[0, 197643], [5, 197865], [12, 198445], [16, 198605], [22, 198925], [25, 199105], [29, 199225], [40, 199785], [42, 200225], [45, 200345], [50, 200585], [59, 201105], [63, 201305], [67, 201485]]}, {"verse": 29, "start": 202524, "end": 207397, "text": "Y yo afligido y dolorido, tu salvación, oh Dios, me defenderá.", "words": [[0, 202524], [2, 202669], [5, 202869], [14, 203629], [16, 203729], [26, 204749], [29, 204829], [40, 205989], [43, 206129], [49, 206509], [52, 206629]]}, {"verse": 30, "start": 207847, "end": 212913, "text": "Alabaré yo el nombre de Dios con cántico, lo ensalzaré con alabanza.", "words": [[0, 208037], [8, 208263], [11, 208490], [14, 208650], [21, 209030], [24, 209230], [29, 209490], [33, 209790], [42, 210930], [45, 211010], [55, 211810], [59, 211950]]}, {"verse": 31, "start": 213363, "end": 219426, "text": "Y agradará a Jehová más que sacrificio de buey, o becerro que echa cuernos y uñas.", "words": [[0, 213363], [2, 213527], [11, 214167], [13, 214407], [20, 214867], [24, 215047], [28, 215457], [39, 215867], [42, 216307], [48, 216747], [50, 217187], [58, 217627], [62, 217837], [67, 218047], [75, 218607], [77, 218767]]}, {"verse": 32, "start": 219876, "end": 225713, "text": "Lo verán los humildes, y se gozarán; buscad a Dios, y vivirá vuestro corazón.", "words": [[0, 219876], [3, 220024], [9, 220324], [13, 220484], [23, 221344], [25, 221724], [28, 221904], [37, 223004], [44, 223489], [46, 223589], [52, 223829], [54, 224189], [61, 224629], [69, 224969]]}, {"verse": 33, "start": 226163, "end": 231982, "text": "Porque Jehová oye a los necesitados, y no menosprecia a sus prisioneros.", "words": [[0, 226163], [7, 226425], [14, 227005], [18, 227345], [20, 227505], [24, 227605], [37, 228605], [39, 229165], [42, 229365], [54, 230265], [56, 230545], [60, 230725]]}, {"verse": 34, "start": 232432, "end": 238478, "text": "Alábenlo los cielos y la tierra, los mares, y todo lo que se mueve en ellos.", "words": [[0, 232777], [9, 233157], [13, 233337], [20, 233897], [22, 234017], [25, 234157], [33, 235097], [37, 235177], [44, 235737], [46, 236137], [51, 236477], [54, 236777], [58, 236917], [61, 237097], [67, 237677], [70, 237897]]}, {"verse": 35, "start": 238928, "end": 246960, "text": "Porque Dios guardará a Sion, y reedificará las ciudades de Judá; y habitarán allí, y la poseerán.", "words": [[0, 238928], [7, 239173], [12, 239453], [21, 239913], [23, 240373], [29, 240833], [31, 241365], [43, 241897], [47, 242429], [56, 242961], [59, 243493], [65, 244428], [67, 244648], [77, 245188], [83, 245528], [85, 245868], [88, 245988]]}, {"verse": 36, "start": 247410, "end": 253449, "text": "Y la descendencia de sus siervos la heredará, y los que aman su nombre habitarán en ella.", "words": [[0, 247410], [2, 247513], [5, 247633], [18, 248593], [21, 248733], [25, 248893], [33, 249573], [36, 250013], [46, 250753], [48, 251193], [52, 251333], [56, 251493], [61, 251673], [64, 251933], [71, 252213], [81, 252793], [84, 252913]]}]}