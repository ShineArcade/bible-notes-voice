{"book": "GEN", "chapter": 18, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 288251, "verses": [{"verse": 1, "start": 300, "end": 7903, "text": "Y le apareció Jehová en el valle de Mamre, estando él sentado a la puerta de su tienda en el calor del día.", "words": [[0, 300], [2, 464], [5, 584], [14, 1204], [21, 1724], [24, 1864], [27, 2004], [33, 2264], [36, 2864], [43, 3464], [51, 4004], [54, 4224], [62, 4844], [64, 4944], [67, 5044], [74, 5344], [77, 5624], [80, 5824], [87, 6324], [90, 6484], [93, 6624], [99, 7004], [103, 7284]]}, {"verse": 2, "start": 8253, "end": 20364, "text": "Y alzó sus ojos y miró, y he aquí tres varones que estaban junto a él: y cuando los vio, salió corriendo de la puerta de su tienda a recibirlos, y se inclinó hacia la tierra,", "words": [[0, 8253], [2, 8358], [7, 8698], [11, 8878], [16, 9158], [18, 9398], [24, 10198], [26, 10428], [29, 10658], [34, 10918], [39, 11318], [47, 12018], [51, 12218], [59, 12498], [65, 12878], [67, 13058], [71, 13619], [73, 13722], [80, 13922], [84, 14162], [89, 14442], [95, 14842], [105, 15422], [108, 15582], [111, 15682], [118, 15982], [121, 16242], [124, 16382], [131, 16782], [133, 16922], [145, 17782], [147, 18202], [150, 18362], [158, 19142], [164, 19382], [167, 19642]]}, {"verse": 3, "start": 20714, "end": 26690, "text": "Y dijo: Señor, si ahora he hallado gracia en tus ojos, te ruego que no pases de tu siervo.", "words": [[0, 20714], [2, 20843], [8, 21565], [15, 22512], [18, 22612], [24, 22872], [27, 23032], [35, 23372], [42, 23792], [45, 23852], [49, 23992], [55, 24812], [58, 24892], [64, 25172], [68, 25352], [71, 25512], [77, 25892], [80, 26012], [83, 26132]]}, {"verse": 4, "start": 27040, "end": 32265, "text": "Que se traiga ahora un poco de agua, y lavad vuestros pies; y recostaos debajo de un árbol,", "words": [[0, 27040], [4, 27119], [7, 27239], [14, 27599], [20, 27799], [23, 27939], [28, 28119], [31, 28319], [37, 28599], [39, 28919], [45, 29239], [54, 29659], [60, 30366], [62, 30712], [72, 31092], [79, 31492], [82, 31652], [85, 31732]]}, {"verse": 5, "start": 32615, "end": 42387, "text": "Y traeré un bocado de pan, y recobrad fuerzas; después pasaréis: porque por eso habéis pasado cerca de vuestro siervo. Y ellos dijeron: Haz así como has dicho.", "words": [[0, 32615], [2, 32721], [9, 33121], [12, 33221], [19, 33601], [22, 33741], [27, 34041], [29, 34398], [38, 34756], [47, 35715], [55, 35956], [65, 37001], [72, 37165], [76, 37385], [80, 37545], [87, 37845], [94, 38205], [100, 38465], [103, 38705], [111, 38985], [119, 39806], [121, 39972], [127, 40152], [136, 41145], [140, 41327], [144, 41547], [149, 41747], [153, 41927]]}, {"verse": 6, "start": 42667, "end": 52945, "text": "Entonces Abraham fue de prisa a la tienda a Sara, y le dijo: Toma pronto tres medidas de harina fina, amasa y haz panes cocidos debajo del rescoldo.", "words": [[0, 42667], [9, 43152], [17, 43832], [21, 44232], [24, 44372], [30, 44912], [32, 45132], [35, 45212], [42, 45572], [44, 45932], [50, 46292], [52, 46497], [55, 46637], [61, 47376], [66, 47634], [73, 47894], [78, 48274], [86, 48694], [89, 48894], [96, 49174], [102, 49874], [108, 50294], [110, 50581], [114, 50867], [120, 51154], [128, 51694], [135, 52094], [139, 52274]]}, {"verse": 7, "start": 53225, "end": 61799, "text": "Y corrió Abraham a las vacas, y tomó un becerro tierno y bueno, y lo dio al mozo, y se dio este prisa a prepararlo.", "words": [[0, 53225], [2, 53345], [9, 53825], [17, 54505], [19, 54745], [23, 54905], [30, 55665], [32, 55845], [37, 56225], [40, 56365], [48, 56945], [55, 57545], [57, 57645], [64, 58005], [66, 58240], [69, 58400], [73, 58560], [76, 58740], [82, 59200], [84, 59900], [87, 60060], [91, 60280], [96, 60460], [102, 60880], [104, 61020]]}, {"verse": 8, "start": 62149, "end": 72703, "text": "Tomó también mantequilla y leche, y el becerro que había preparado, y lo puso delante de ellos; y él estaba junto a ellos debajo del árbol; y comieron.", "words": [[0, 62149], [5, 62453], [13, 62713], [25, 63593], [27, 63713], [34, 64093], [36, 64693], [39, 64853], [47, 65413], [51, 65553], [57, 65813], [68, 66573], [70, 66973], [73, 67113], [78, 67493], [86, 67973], [89, 68173], [96, 69016], [98, 69328], [101, 69488], [108, 69768], [114, 70128], [116, 70368], [122, 70548], [129, 71008], [133, 71228], [140, 71888], [142, 72013]]}, {"verse": 9, "start": 73053, "end": 79386, "text": "Y le dijeron: ¿Dónde está Sara tu mujer? Y él respondió: Aquí en la tienda.", "words": [[0, 73053], [2, 73173], [5, 73253], [14, 74319], [21, 74632], [26, 74978], [31, 75325], [34, 75525], [41, 76395], [43, 76587], [46, 76707], [57, 77891], [62, 78371], [65, 78571], [68, 78711]]}, {"verse": 10, "start": 79736, "end": 91692, "text": "Entonces dijo: De cierto volveré a ti según el tiempo de la vida, y he aquí, tendrá un hijo Sara tu mujer. Y Sara escuchaba a la puerta de la tienda, que estaba detrás de él.", "words": [[0, 79736], [9, 80321], [15, 81454], [18, 81660], [25, 81866], [33, 82506], [35, 82607], [38, 82767], [44, 83066], [47, 83327], [54, 83666], [57, 83846], [60, 83967], [66, 84607], [68, 84666], [71, 84806], [77, 85586], [84, 86187], [87, 86366], [92, 86706], [97, 86986], [100, 87126], [107, 87853], [109, 87964], [114, 88204], [124, 88924], [126, 89064], [129, 89164], [136, 89424], [139, 89704], [142, 89824], [150, 90224], [154, 90424], [161, 90724], [168, 91184], [171, 91344]]}, {"verse": 11, "start": 92042, "end": 99190, "text": "Y Abraham y Sara eran ancianos, de edad avanzada: Sara ya había dejado de menstruar.", "words": [[0, 92042], [2, 92342], [10, 92642], [12, 93022], [17, 93402], [22, 93802], [32, 95062], [35, 95202], [40, 95522], [50, 96691], [55, 96997], [58, 97277], [64, 97637], [71, 98217], [74, 98377]]}, {"verse": 12, "start": 99540, "end": 107859, "text": "Se rio, pues, Sara entre sí, diciendo: ¿Después que he envejecido tendré deleite, siendo también mi señor ya viejo?", "words": [[0, 99709], [3, 99909], [8, 100109], [14, 100729], [19, 101069], [25, 101329], [29, 102129], [39, 103039], [48, 103439], [52, 103779], [55, 103959], [66, 104679], [73, 105220], [82, 105762], [89, 106044], [97, 106484], [100, 106704], [106, 107044], [109, 107304]]}, {"verse": 13, "start": 108139, "end": 116377, "text": "Entonces Jehová dijo a Abraham: ¿Por qué se ha reído Sara diciendo: Será cierto que he de parir siendo ya vieja?", "words": [[0, 108139], [9, 109124], [16, 109724], [21, 109904], [23, 110084], [32, 111148], [37, 111252], [41, 111472], [44, 111672], [47, 111812], [53, 112132], [58, 112412], [68, 113701], [73, 114050], [80, 114310], [84, 114610], [87, 114770], [90, 114850], [96, 115230], [103, 115530], [106, 115790]]}, {"verse": 14, "start": 116597, "end": 124380, "text": "¿Hay para Dios alguna cosa difícil? Al tiempo señalado volveré a ti, según el tiempo de la vida, y Sara tendrá un hijo.", "words": [[0, 116597], [5, 116801], [10, 117001], [15, 117221], [22, 117581], [27, 117901], [36, 119124], [39, 119258], [46, 119558], [55, 120218], [63, 120738], [65, 120798], [69, 121198], [75, 121418], [78, 121598], [85, 121858], [88, 122018], [91, 122118], [97, 122618], [99, 122838], [104, 123118], [111, 123618], [114, 123738]]}, {"verse": 15, "start": 124660, "end": 133393, "text": "Entonces Sara negó diciendo: No me reí; porque tuvo miedo. Y él dijo: No es así, sino que te has reído.", "words": [[0, 124660], [9, 125315], [14, 126005], [19, 126465], [29, 127330], [32, 127557], [35, 127637], [40, 128380], [47, 128582], [52, 128842], [59, 129859], [61, 130047], [64, 130207], [70, 130926], [73, 131108], [76, 131368], [81, 131688], [86, 131948], [90, 132148], [93, 132328], [97, 132528]]}, {"verse": 16, "start": 133673, "end": 141194, "text": "Y los varones se levantaron de allí, y miraron hacia Sodoma: y Abraham iba con ellos acompañándolos.", "words": [[0, 133673], [2, 133835], [6, 133955], [14, 134375], [17, 134555], [28, 135115], [31, 135315], [37, 135575], [39, 136075], [47, 136635], [53, 137015], [61, 138046], [63, 138194], [71, 138614], [75, 139174], [79, 139454], [85, 139654]]}, {"verse": 17, "start": 141544, "end": 145621, "text": "Y Jehová dijo: ¿Encubriré yo a Abraham lo que voy a hacer,", "words": [[0, 141544], [2, 141889], [9, 142268], [15, 142779], [26, 143401], [29, 143601], [31, 143861], [39, 144161], [42, 144361], [46, 144481], [50, 144661], [52, 144861]]}, {"verse": 18, "start": 145971, "end": 153076, "text": "Habiendo de ser Abraham una nación grande y fuerte, y habiendo de ser benditas en él todas las naciones de la tierra?", "words": [[0, 145971], [9, 146317], [12, 146477], [16, 146697], [24, 147057], [28, 147417], [35, 147797], [42, 148217], [44, 148337], [52, 149097], [54, 149317], [63, 149617], [66, 149797], [70, 149957], [79, 150557], [82, 150757], [85, 150877], [91, 151157], [95, 151477], [104, 151917], [107, 152117], [110, 152217]]}, {"verse": 19, "start": 153426, "end": 167197, "text": "Porque yo lo he conocido, sé que mandará a sus hijos y a su casa después de sí, que guarden el camino de Jehová, haciendo justicia y juicio, para que haga venir Jehová sobre Abraham lo que ha hablado acerca de él.", "words": [[0, 153426], [7, 153591], [10, 153811], [13, 153951], [16, 154051], [26, 155131], [29, 155351], [33, 155491], [41, 155911], [43, 156051], [47, 156211], [53, 156551], [55, 156731], [57, 156771], [60, 156891], [65, 157211], [73, 157591], [76, 157791], [80, 158071], [84, 158511], [92, 159011], [95, 159111], [102, 159431], [105, 159651], [113, 160391], [122, 160771], [131, 161631], [133, 161731], [141, 162803], [146, 162963], [150, 163143], [155, 163323], [161, 163583], [168, 164163], [174, 164403], [182, 165075], [185, 165218], [189, 165398], [192, 165558], [200, 165958], [207, 166278], [210, 166618]]}, {"verse": 20, "start": 167477, "end": 176921, "text": "Entonces Jehová le dijo: Por cuanto el clamor de Sodoma y Gomorra se aumenta más y más, y el pecado de ellos se ha agravado en extremo,", "words": [[0, 167477], [9, 168124], [16, 169104], [19, 169164], [25, 169908], [29, 170052], [36, 170352], [39, 170492], [46, 170932], [49, 171072], [56, 171532], [58, 171612], [66, 172152], [69, 172572], [77, 173072], [81, 173372], [83, 173492], [88, 173752], [90, 173967], [93, 174087], [100, 174507], [103, 174707], [109, 174967], [112, 175447], [115, 175587], [124, 176067], [127, 176187]]}, {"verse": 21, "start": 177271, "end": 184847, "text": "Descenderé ahora, y veré si han consumado su obra según el clamor que ha venido hasta mí; y si no, lo sabré.", "words": [[0, 177271], [11, 177968], [18, 178308], [20, 178648], [25, 178988], [28, 179248], [32, 179408], [42, 180088], [45, 180268], [50, 180548], [56, 180888], [59, 181108], [66, 181568], [70, 181708], [73, 181828], [80, 182188], [86, 182428], [90, 183220], [92, 183360], [95, 183520], [99, 183900], [102, 184100]]}, {"verse": 22, "start": 185127, "end": 192122, "text": "Y se apartaron de allí los varones, y fueron hacia Sodoma: pero Abraham estaba aún delante de Jehová.", "words": [[0, 185127], [2, 185255], [5, 185355], [15, 185935], [18, 186115], [23, 186335], [27, 186535], [36, 187055], [38, 187515], [45, 187795], [51, 188095], [59, 189114], [64, 189278], [72, 189918], [79, 190473], [83, 190913], [91, 191353], [94, 191553]]}, {"verse": 23, "start": 192472, "end": 197125, "text": "Y se acercó Abraham y dijo: ¿Destruirás también al justo con el impío?", "words": [[0, 192472], [2, 192790], [5, 192870], [12, 193450], [20, 194030], [22, 194230], [28, 194959], [40, 195498], [48, 195718], [51, 195938], [57, 196158], [61, 196418], [64, 196518]]}, {"verse": 24, "start": 197475, "end": 204830, "text": "Quizá hay cincuenta justos dentro de la ciudad: ¿destruirás también y no perdonarás al lugar por cincuenta justos que estén dentro de él?", "words": [[0, 197475], [6, 197779], [10, 197959], [20, 198139], [27, 198779], [34, 198979], [37, 199219], [40, 199319], [48, 200111], [60, 200692], [68, 201072], [70, 201372], [73, 201492], [84, 202092], [87, 202192], [93, 202412], [97, 202672], [107, 202932], [114, 203632], [118, 203732], [124, 204032], [131, 204312], [134, 204532]]}, {"verse": 25, "start": 205180, "end": 216430, "text": "Lejos de ti el hacer tal, que hagas morir al justo con el impío, y que sea el justo tratado como el impío; nunca tal hagas. El juez de toda la tierra, ¿no ha de hacer lo que es justo?", "words": [[0, 205180], [6, 205501], [9, 205701], [12, 205921], [15, 206181], [21, 206481], [26, 207241], [30, 207421], [36, 207701], [42, 208001], [45, 208101], [51, 208361], [55, 208601], [58, 208721], [65, 209161], [67, 209316], [71, 209416], [75, 209596], [78, 209776], [84, 209996], [92, 210496], [97, 210676], [100, 210776], [107, 211567], [113, 211912], [117, 212092], [124, 212839], [127, 212929], [132, 213249], [135, 213369], [140, 213549], [143, 213729], [151, 214529], [155, 214849], [158, 215009], [161, 215089], [167, 215429], [170, 215609], [174, 215729], [177, 215889]]}, {"verse": 26, "start": 216710, "end": 226202, "text": "Entonces respondió Jehová: Si hallo en Sodoma cincuenta justos dentro de la ciudad, perdonaré a todo este lugar por amor de ellos.", "words": [[0, 216710], [9, 217338], [19, 218343], [27, 219186], [30, 219431], [36, 219681], [39, 219801], [46, 220161], [56, 220521], [63, 221361], [70, 221601], [73, 221881], [76, 221981], [84, 222841], [94, 223521], [96, 223781], [101, 224021], [106, 224361], [112, 224701], [116, 225001], [121, 225241], [124, 225461]]}, {"verse": 27, "start": 226482, "end": 233195, "text": "Y Abraham replicó y dijo: He aquí ahora que he comenzado a hablar a mi Señor, aunque soy polvo y ceniza:", "words": [[0, 226482], [2, 226646], [10, 227086], [18, 228066], [20, 228186], [26, 228922], [29, 229059], [34, 229239], [40, 229479], [44, 229759], [47, 229859], [57, 230499], [59, 230579], [66, 230779], [68, 230919], [71, 231019], [78, 231799], [85, 231939], [89, 232179], [95, 232579], [97, 232659]]}, {"verse": 28, "start": 233545, "end": 242529, "text": "Quizá faltarán de cincuenta justos cinco: ¿destruirás por aquellos cinco toda la ciudad? Y dijo: No la destruiré, si hallo allí cuarenta y cinco.", "words": [[0, 233545], [6, 233829], [15, 234309], [18, 234519], [28, 234729], [35, 235344], [42, 236127], [54, 236672], [58, 236832], [67, 237112], [73, 237492], [78, 237772], [81, 237932], [89, 238668], [91, 238797], [97, 239519], [100, 239704], [103, 239804], [114, 240424], [117, 240684], [123, 240944], [128, 241276], [137, 241609], [139, 241942]]}, {"verse": 29, "start": 242809, "end": 251283, "text": "Y volvió a hablarle, y dijo: Quizá se hallarán allí cuarenta. Y respondió: No lo haré por amor de los cuarenta.", "words": [[0, 242809], [2, 242954], [9, 243374], [11, 243494], [21, 244294], [23, 244714], [29, 245459], [35, 245899], [38, 246119], [47, 246612], [52, 247106], [62, 247844], [64, 247991], [75, 248999], [78, 249226], [81, 249386], [86, 249666], [90, 249806], [95, 250006], [98, 250186], [102, 250306]]}, {"verse": 30, "start": 251563, "end": 260075, "text": "Y dijo: No se enoje ahora mi Señor, si hablo: quizá se hallarán allí treinta. Y respondió: No lo haré si hallo allí treinta.", "words": [[0, 251563], [2, 251692], [8, 252414], [11, 252630], [14, 252830], [20, 253210], [26, 253410], [29, 253570], [36, 254110], [39, 254210], [46, 255020], [52, 255250], [55, 255370], [64, 255730], [69, 256125], [78, 256754], [80, 256901], [91, 257909], [94, 258047], [97, 258187], [102, 258567], [105, 258707], [111, 258987], [116, 259407]]}, {"verse": 31, "start": 260355, "end": 270493, "text": "Y dijo: He aquí ahora que he emprendido el hablar a mi Señor: quizá se hallarán allí veinte. No la destruiré, respondió, por amor de los veinte.", "words": [[0, 260355], [2, 260484], [8, 261261], [11, 261341], [16, 261561], [22, 261821], [26, 262101], [29, 262181], [40, 262681], [43, 262781], [50, 263021], [52, 263141], [55, 263241], [62, 264254], [68, 264504], [71, 264624], [80, 265004], [85, 265204], [93, 266015], [96, 266237], [99, 266377], [110, 267738], [121, 268799], [125, 268975], [130, 269195], [133, 269455], [137, 269595]]}, {"verse": 32, "start": 270773, "end": 281457, "text": "Y volvió a decir: No se enoje ahora mi Señor, si hablo solamente una vez: quizá se hallarán allí diez. No la destruiré, respondió, por amor de los diez.", "words": [[0, 270773], [2, 270878], [9, 271298], [11, 271378], [18, 272115], [21, 272237], [24, 272397], [30, 272677], [36, 272957], [39, 273037], [46, 273757], [49, 273857], [55, 274137], [65, 274397], [69, 274817], [74, 275639], [80, 275829], [83, 275929], [92, 276269], [97, 276664], [103, 277233], [106, 277454], [109, 277594], [120, 278956], [131, 280016], [135, 280183], [140, 280423], [143, 280683], [147, 280823]]}, {"verse": 33, "start": 281737, "end": 287851, "text": "Y Jehová se fue, luego que acabó de hablar a Abraham: y Abraham se volvió a su lugar.", "words": [[0, 281853], [2, 282003], [9, 282153], [12, 282303], [17, 283203], [23, 283443], [27, 283683], [33, 284103], [36, 284203], [43, 284483], [45, 284803], [54, 285739], [56, 285858], [64, 286198], [67, 286538], [74, 287038], [76, 287138], [79, 287278]]}]}