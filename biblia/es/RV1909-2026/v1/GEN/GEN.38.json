{"book": "GEN", "chapter": 38, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 286682, "verses": [{"verse": 1, "start": 300, "end": 9438, "text": "Y aconteció en aquel tiempo, que Judá se apartó de sus hermanos, y se fue a un varón adulamita, que se llamaba Hira.", "words": [[0, 300], [2, 682], [12, 1102], [15, 1242], [21, 1542], [29, 1962], [33, 2482], [38, 3002], [41, 3302], [48, 3762], [51, 3882], [55, 4042], [65, 4962], [67, 5162], [70, 5302], [74, 5542], [76, 5802], [79, 6022], [85, 6462], [96, 7302], [100, 7822], [103, 7962], [111, 8716]]}, {"verse": 2, "start": 9888, "end": 17868, "text": "Y vio allí Judá la hija de un hombre cananeo, el cual se llamaba Súa; y la tomó, y entró a ella:", "words": [[0, 9888], [2, 10010], [6, 10310], [11, 10700], [16, 11090], [19, 11320], [24, 11550], [27, 11710], [30, 11870], [37, 12150], [46, 13330], [49, 13410], [54, 13630], [57, 13870], [65, 14350], [70, 15374], [72, 15537], [75, 15617], [81, 16117], [83, 16737], [89, 17237], [91, 17337]]}, {"verse": 3, "start": 18318, "end": 22709, "text": "La cual concibió, y parió un hijo; y llamó su nombre Er.", "words": [[0, 18318], [3, 18442], [8, 18602], [18, 19422], [20, 19562], [26, 19942], [29, 20242], [35, 21083], [37, 21363], [43, 21683], [46, 21823], [53, 22291]]}, {"verse": 4, "start": 23159, "end": 28587, "text": "Y concibió otra vez, y parió un hijo, y llamó su nombre Onán.", "words": [[0, 23159], [2, 23286], [11, 23946], [16, 24226], [21, 24686], [23, 25306], [29, 25686], [32, 25906], [38, 26186], [40, 26786], [46, 27106], [49, 27286], [56, 27966]]}, {"verse": 5, "start": 29037, "end": 35907, "text": "Y volvió a concebir, y parió un hijo, y llamó su nombre Sela. Y estaba en Quezib cuando lo parió.", "words": [[0, 29037], [2, 29167], [9, 29547], [11, 29627], [21, 30347], [23, 30567], [29, 30927], [32, 31127], [38, 31447], [40, 31987], [46, 32287], [49, 32447], [56, 32930], [62, 33659], [64, 33763], [71, 34023], [74, 34373], [81, 34723], [88, 35143], [91, 35403]]}, {"verse": 6, "start": 36357, "end": 41308, "text": "Y Judá tomó mujer para su primogénito Er, la cual se llamaba Tamar.", "words": [[0, 36357], [2, 36622], [7, 36922], [12, 37262], [18, 37602], [23, 37902], [26, 38102], [38, 38942], [42, 39502], [45, 39622], [50, 39882], [53, 40142], [61, 40622]]}, {"verse": 7, "start": 41758, "end": 48371, "text": "Y Er, el primogénito de Judá, fue malo a los ojos de Jehová, y le quitó Jehová la vida.", "words": [[0, 41758], [2, 41992], [6, 42262], [9, 42422], [21, 43262], [24, 43682], [30, 44102], [34, 44262], [39, 44922], [41, 45122], [45, 45262], [50, 45582], [53, 45782], [61, 46282], [63, 46702], [66, 46862], [72, 47302], [79, 47702], [82, 47762]]}, {"verse": 8, "start": 48821, "end": 57015, "text": "Entonces Judá dijo a Onán: Únete a la mujer de tu hermano, cumple con tu deber de cuñado y da descendencia a tu hermano.", "words": [[0, 48821], [9, 49351], [14, 50111], [19, 50631], [21, 50831], [27, 51624], [33, 51989], [35, 52089], [38, 52149], [44, 52369], [47, 52589], [50, 52729], [59, 53529], [66, 53849], [70, 54029], [73, 54169], [79, 54409], [82, 54589], [89, 55109], [91, 55329], [94, 55449], [107, 56229], [109, 56349], [112, 56449]]}, {"verse": 9, "start": 57365, "end": 69321, "text": "Y sabiendo Onán que la descendencia no había de ser suya, sucedía que cuando entraba a la mujer de su hermano vertía en tierra, por no dar descendencia a su hermano.", "words": [[0, 57365], [2, 57510], [11, 57990], [16, 58730], [20, 59150], [23, 59290], [36, 60170], [39, 60370], [45, 60590], [48, 60750], [52, 60970], [58, 61850], [66, 62530], [70, 62710], [77, 62970], [85, 63300], [87, 63630], [90, 63750], [96, 64050], [99, 64270], [102, 64430], [110, 64890], [117, 65490], [120, 65770], [128, 66850], [132, 66994], [135, 67194], [139, 67474], [152, 68434], [154, 68594], [157, 68654]]}, {"verse": 10, "start": 69771, "end": 75288, "text": "Y desagradó ante los ojos de Jehová lo que hacía, y también quitó a él la vida.", "words": [[0, 69771], [2, 69893], [12, 70633], [17, 70893], [21, 71093], [26, 71493], [29, 71753], [36, 72233], [39, 72353], [43, 72533], [50, 73013], [52, 73473], [60, 73753], [66, 74333], [68, 74433], [71, 74593], [74, 74773]]}, {"verse": 11, "start": 75738, "end": 90661, "text": "Y Judá dijo a Tamar su nuera: Quédate viuda en casa de tu padre, hasta que crezca Sela mi hijo; porque dijo: Que quizá no muera él también como sus hermanos. Y se fue Tamar, y se quedó en casa de su padre.", "words": [[0, 75738], [2, 75867], [7, 76347], [12, 76747], [14, 76927], [20, 77247], [23, 77447], [30, 78318], [38, 78653], [44, 79093], [47, 79253], [52, 79473], [55, 79673], [58, 79793], [65, 80153], [71, 80653], [75, 80993], [82, 81333], [87, 81673], [90, 81893], [96, 82826], [103, 82996], [109, 83766], [113, 83867], [119, 84267], [122, 84407], [128, 84707], [131, 84847], [139, 85147], [144, 85427], [148, 85607], [158, 87509], [160, 87634], [163, 87734], [167, 87914], [174, 88434], [176, 88954], [179, 89074], [185, 89374], [188, 89474], [193, 89734], [196, 89954], [199, 90094]]}, {"verse": 12, "start": 91111, "end": 104804, "text": "Y pasaron muchos días, y murió la hija de Súa, mujer de Judá; y Judá se consoló, y subía a los trasquiladores de sus ovejas a Timnat, él y su amigo Hira el adulamita.", "words": [[0, 91111], [2, 91216], [10, 91636], [17, 91916], [23, 92356], [25, 92976], [31, 93356], [34, 93516], [39, 93896], [42, 93996], [47, 94676], [53, 94916], [56, 95136], [62, 95933], [64, 96100], [69, 96480], [72, 96600], [81, 97820], [83, 98080], [89, 98600], [91, 98780], [95, 98940], [110, 99780], [113, 99980], [117, 100160], [124, 100700], [126, 101320], [134, 101940], [137, 102200], [139, 102400], [142, 102540], [148, 103020], [153, 103500], [156, 103680]]}, {"verse": 13, "start": 105254, "end": 112136, "text": "Y avisaron a Tamar, diciendo: He aquí tu suegro sube a Timnat a esquilar sus ovejas.", "words": [[0, 105254], [2, 105401], [11, 105981], [13, 106141], [20, 106521], [30, 107943], [33, 108033], [38, 108233], [41, 108593], [48, 108953], [53, 109353], [55, 109493], [62, 110033], [64, 110473], [73, 111053], [77, 111627]]}, {"verse": 14, "start": 112586, "end": 128098, "text": "Entonces quitó ella de sobre sí los vestidos de su viudez, y se cubrió con un velo, y se tapó, y se puso a la puerta de las aguas que están junto al camino de Timnat; porque veía que había crecido Sela, y ella no era dada a él por mujer.", "words": [[0, 112586], [9, 113034], [15, 113634], [20, 113874], [23, 114034], [29, 114314], [32, 114614], [36, 115054], [45, 115554], [48, 115714], [51, 115987], [59, 116261], [61, 116534], [64, 116694], [71, 117194], [75, 117414], [78, 117594], [84, 117974], [86, 118114], [89, 118234], [95, 118996], [97, 119096], [100, 119216], [105, 119576], [107, 119656], [110, 119716], [117, 120036], [120, 120276], [124, 120436], [130, 120816], [134, 120936], [140, 121196], [146, 121456], [149, 121736], [156, 122036], [159, 122545], [167, 123287], [174, 123471], [179, 123931], [183, 124091], [189, 124291], [197, 124811], [203, 125271], [205, 125671], [210, 125891], [213, 126151], [217, 126331], [222, 126771], [224, 127011], [227, 127211], [231, 127471]]}, {"verse": 15, "start": 128548, "end": 134035, "text": "Y la vio Judá, y la tuvo por ramera, porque había ella cubierto su rostro.", "words": [[0, 128548], [2, 128670], [5, 128790], [9, 128990], [15, 129470], [17, 130210], [20, 130330], [25, 130590], [29, 131010], [37, 131430], [44, 132010], [50, 132310], [55, 132570], [64, 133110], [67, 133330]]}, {"verse": 16, "start": 134485, "end": 146057, "text": "Y se apartó del camino hacia ella, y le dijo: Vamos, pues, ahora me acostaré contigo; porque no sabía que era su nuera; y ella dijo: ¿Qué me has de dar, si entras a mí?", "words": [[0, 134485], [2, 134877], [5, 135017], [12, 135577], [16, 135737], [23, 136077], [29, 136377], [35, 136837], [37, 137117], [40, 137217], [46, 138001], [53, 138224], [59, 138804], [65, 138944], [68, 139104], [77, 139484], [86, 140439], [93, 140602], [96, 140842], [102, 141262], [106, 141482], [110, 141722], [113, 141942], [120, 142894], [122, 143060], [127, 143240], [133, 144108], [138, 144252], [141, 144492], [145, 144672], [148, 144812], [153, 145052], [156, 145312], [163, 145612], [165, 145752]]}, {"verse": 17, "start": 146407, "end": 154786, "text": "Él respondió: Yo te enviaré del ganado un cabrito de las cabras. Y ella dijo: Me has de dar prenda hasta que lo envíes.", "words": [[0, 146407], [3, 146573], [14, 147653], [17, 147778], [20, 147958], [28, 148398], [32, 148538], [39, 148958], [42, 149098], [50, 149498], [53, 149638], [57, 149778], [65, 150750], [67, 150912], [72, 151112], [78, 151952], [81, 152152], [85, 152352], [88, 152572], [92, 152792], [99, 153412], [105, 153712], [109, 153912], [112, 154389]]}, {"verse": 18, "start": 155136, "end": 169004, "text": "Entonces él dijo: ¿Qué prenda te daré? Ella respondió: Tu anillo, y tu manto, y tu bastón que tienes en tu mano. Y él se los dio, y entró a ella, la cual concibió de él.", "words": [[0, 155136], [9, 155701], [12, 156261], [18, 157069], [23, 157283], [30, 157533], [33, 157713], [39, 158418], [44, 158644], [55, 159825], [58, 159905], [66, 160385], [68, 160565], [71, 160725], [78, 161225], [80, 161625], [83, 161765], [90, 162325], [94, 162465], [101, 162785], [104, 163045], [107, 163165], [113, 164045], [115, 164210], [118, 164370], [121, 164550], [125, 164770], [130, 165090], [132, 165750], [138, 166370], [140, 166570], [146, 167410], [149, 167510], [154, 167710], [163, 168390], [166, 168530]]}, {"verse": 19, "start": 169454, "end": 176783, "text": "Y se levantó, y se fue: y se quitó el velo de sobre sí, y se vistió las ropas de su viudez.", "words": [[0, 169454], [2, 169620], [5, 169700], [14, 170500], [16, 170960], [19, 171100], [24, 171862], [26, 171987], [29, 172087], [35, 172507], [38, 172627], [43, 172927], [46, 173087], [52, 173407], [56, 174327], [58, 174407], [61, 174567], [68, 175067], [72, 175247], [78, 175687], [81, 176075], [84, 176463]]}, {"verse": 20, "start": 177233, "end": 185846, "text": "Y Judá envió el cabrito de las cabras por mano de su amigo el adulamita, para que tomase la prenda de mano de la mujer; pero no la halló.", "words": [[0, 177233], [2, 177359], [7, 177679], [13, 177999], [16, 178139], [24, 178599], [27, 178759], [31, 178899], [38, 179339], [42, 179559], [47, 179819], [50, 180039], [53, 180199], [59, 180539], [62, 180699], [73, 181379], [78, 182079], [82, 182239], [89, 182679], [92, 182819], [99, 183239], [102, 183359], [107, 183559], [110, 183719], [113, 183819], [120, 184619], [125, 184764], [128, 185084], [131, 185492]]}, {"verse": 21, "start": 186296, "end": 196701, "text": "Y preguntó a los hombres de aquel lugar, diciendo: ¿Dónde está la ramera de las aguas junto al camino? Y ellos le dijeron: No ha estado aquí ramera.", "words": [[0, 186296], [2, 186420], [11, 187140], [13, 187300], [17, 187460], [25, 187860], [28, 188060], [34, 188380], [41, 188720], [51, 190799], [58, 191059], [63, 191299], [66, 191569], [73, 191839], [76, 191979], [80, 192159], [86, 192519], [92, 192679], [95, 192879], [103, 193717], [105, 193901], [111, 194121], [114, 194301], [123, 195250], [126, 195453], [129, 195573], [136, 195873], [141, 196253]]}, {"verse": 22, "start": 197051, "end": 205840, "text": "Entonces él se volvió a Judá, y dijo: No la he hallado; y también los hombres del lugar dijeron: Aquí no ha estado ramera.", "words": [[0, 197051], [9, 198195], [12, 198575], [15, 198835], [22, 199315], [24, 199595], [30, 199875], [32, 200055], [38, 200805], [41, 200950], [44, 201090], [47, 201230], [56, 202051], [58, 202158], [66, 202398], [70, 202618], [78, 202938], [82, 203158], [88, 203458], [97, 204405], [102, 204764], [105, 204944], [108, 205004], [115, 205224]]}, {"verse": 23, "start": 206190, "end": 213766, "text": "Y Judá dijo: Que se lo quede, para que no seamos menospreciados: he aquí yo he enviado este cabrito, y tú no la hallaste.", "words": [[0, 206190], [2, 206494], [7, 206833], [13, 207445], [17, 207505], [20, 207585], [23, 207725], [30, 208085], [35, 208425], [39, 208565], [42, 208685], [49, 209085], [65, 210474], [68, 210474], [73, 210778], [76, 211098], [79, 211198], [87, 211638], [92, 211838], [101, 212358], [103, 212798], [106, 212978], [109, 213251], [112, 213525]]}, {"verse": 24, "start": 214116, "end": 227247, "text": "Y acaeció que al cabo de unos tres meses fue dado aviso a Judá, diciendo: Tamar tu nuera ha fornicado, y aun cierto está preñada de las fornicaciones. Y Judá dijo: Sacadla, y sea quemada.", "words": [[0, 214116], [2, 214221], [10, 214781], [14, 215101], [17, 215181], [22, 215461], [25, 215661], [30, 215781], [35, 216061], [41, 216701], [45, 216781], [50, 217081], [56, 217541], [58, 217681], [64, 218421], [74, 219461], [80, 219746], [83, 219886], [89, 220266], [92, 220666], [103, 221066], [105, 221286], [109, 221426], [116, 221886], [121, 222166], [129, 222786], [132, 222926], [136, 223644], [151, 224594], [153, 224898], [158, 225237], [164, 226015], [173, 226275], [175, 226475], [179, 226595]]}, {"verse": 25, "start": 227597, "end": 242126, "text": "Y ella, cuando la sacaban, envió a decir a su suegro: Del varón cuyas son estas cosas, estoy encinta: y dijo más: Mira ahora de quién son estas cosas, el anillo, y el manto, y el bastón.", "words": [[0, 227597], [2, 227781], [8, 228081], [15, 228521], [18, 228961], [27, 229401], [33, 230421], [35, 230661], [41, 231001], [43, 231301], [46, 231461], [54, 232475], [58, 232535], [64, 232995], [70, 233455], [74, 233635], [80, 233855], [87, 234375], [93, 235111], [102, 236129], [104, 236268], [109, 236508], [114, 237402], [119, 237602], [125, 237902], [128, 238082], [134, 238262], [138, 238582], [144, 238802], [151, 239642], [154, 239742], [162, 240242], [164, 240522], [167, 240642], [174, 241102], [176, 241322], [179, 241442]]}, {"verse": 26, "start": 242476, "end": 251988, "text": "Entonces Judá los reconoció, y dijo: Más justa es que yo, por cuanto no la he dado a Sela mi hijo. Y nunca más la conoció.", "words": [[0, 242476], [9, 243153], [14, 243863], [18, 244143], [29, 244843], [31, 245043], [37, 245855], [41, 246112], [47, 246452], [50, 246552], [54, 246672], [58, 246912], [62, 247172], [69, 247432], [72, 247712], [75, 247872], [78, 247972], [83, 248172], [85, 248442], [90, 248712], [93, 248872], [99, 250329], [101, 250454], [107, 250714], [111, 250954], [114, 251194]]}, {"verse": 27, "start": 252438, "end": 257092, "text": "Y aconteció que al tiempo del parir, he aquí había dos en su vientre.", "words": [[0, 252438], [2, 252716], [12, 253356], [16, 253536], [19, 253696], [26, 253996], [30, 254276], [37, 254956], [40, 255116], [45, 255536], [51, 255776], [55, 256056], [58, 256296], [61, 256725]]}, {"verse": 28, "start": 257542, "end": 268220, "text": "Y sucedió, cuando paría, que sacó la mano el uno, y la partera tomó y ató a su mano un hilo escarlata, diciendo: Este salió primero.", "words": [[0, 257542], [2, 257683], [11, 258383], [18, 258663], [25, 260023], [29, 260103], [34, 260443], [37, 260543], [42, 260723], [45, 260943], [50, 261243], [52, 261743], [55, 261863], [63, 262243], [68, 262723], [70, 262863], [74, 263243], [76, 263443], [79, 263603], [84, 263983], [87, 264363], [92, 264743], [103, 265483], [113, 266711], [118, 266962], [124, 267362]]}, {"verse": 29, "start": 268570, "end": 279274, "text": "Pero fue que volviendo él a meter la mano, he aquí su hermano salió; y ella dijo: ¡Cómo te has abierto paso! Y llamó su nombre Fares.", "words": [[0, 268570], [5, 268712], [9, 268932], [13, 269112], [23, 269712], [26, 269912], [28, 270032], [34, 270272], [37, 270512], [43, 271082], [46, 271652], [51, 271872], [54, 272112], [62, 272552], [69, 273435], [71, 273600], [76, 273780], [82, 274649], [88, 274826], [91, 275006], [95, 275166], [103, 275566], [109, 277227], [111, 277350], [117, 277690], [120, 277850], [127, 278530]]}, {"verse": 30, "start": 279724, "end": 286282, "text": "Y después salió su hermano, el que tenía en su mano el hilo escarlata, y llamó su nombre Zara.", "words": [[0, 279724], [2, 279831], [10, 280071], [16, 280571], [19, 280771], [28, 281691], [31, 281871], [35, 281991], [41, 282311], [44, 282511], [47, 282671], [52, 282971], [55, 283251], [60, 283491], [71, 284671], [73, 284751], [79, 285071], [82, 285191], [89, 285754]]}]}