{"book": "LUK", "chapter": 18, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 327897, "verses": [{"verse": 1, "start": 300, "end": 7660, "text": "Y LES PROPUSO también una parábola sobre que es necesario orar siempre, y no desanimarse,", "words": [[0, 300], [2, 442], [6, 562], [14, 1202], [22, 1582], [26, 2022], [35, 2641], [41, 3002], [45, 3282], [48, 3462], [58, 4361], [63, 4982], [72, 5442], [74, 5922], [77, 6082]]}, {"verse": 2, "start": 8110, "end": 14043, "text": "Diciendo: Había un juez en una ciudad, el cual ni temía a Dios, ni respetaba a hombre.", "words": [[0, 8110], [10, 9258], [16, 9323], [19, 9388], [24, 9453], [27, 9753], [31, 9913], [39, 10313], [42, 10673], [47, 10893], [50, 11213], [56, 11653], [58, 11873], [64, 12093], [67, 12653], [77, 13313], [79, 13513]]}, {"verse": 3, "start": 14493, "end": 23251, "text": "Había también en aquella ciudad una viuda, la cual venía a él diciendo: Hazme justicia de mi adversario.", "words": [[0, 14493], [6, 14802], [14, 15242], [17, 15682], [25, 16102], [32, 16482], [36, 16862], [43, 17802], [46, 18022], [51, 18242], [57, 18782], [59, 19002], [62, 19242], [72, 20350], [78, 20766], [87, 21506], [90, 21686], [93, 21786]]}, {"verse": 4, "start": 23601, "end": 30183, "text": "Y él no quiso por algún tiempo; pero después de esto dijo dentro de sí: Aunque ni temo a Dios, ni tengo respeto a hombre,", "words": [[0, 23601], [2, 23761], [5, 23901], [8, 24061], [14, 24421], [18, 24641], [24, 24901], [32, 25904], [37, 26279], [45, 26619], [48, 26819], [53, 27059], [58, 27379], [65, 27939], [68, 28239], [72, 28886], [79, 29109], [82, 29329], [87, 29709], [89, 29749], [95, 29831], [98, 29912], [104, 29994], [112, 30076], [114, 30157]]}, {"verse": 5, "start": 30633, "end": 37656, "text": "Sin embargo, porque esta viuda me es molesta, le haré justicia, para que al fin no venga y me muela.", "words": [[0, 32032], [4, 32192], [13, 32692], [20, 32912], [25, 33152], [31, 33452], [34, 33632], [37, 33712], [46, 34592], [49, 34712], [54, 34892], [64, 35712], [69, 35992], [73, 36152], [76, 36272], [80, 36472], [83, 36632], [89, 36972], [91, 37072], [94, 37172]]}, {"verse": 6, "start": 38006, "end": 41912, "text": "Y dijo el Señor: Oíd lo que dice el juez injusto.", "words": [[0, 38006], [2, 38130], [7, 38430], [10, 38570], [17, 39561], [21, 39973], [24, 40253], [28, 40393], [33, 40673], [36, 40873], [41, 41153]]}, {"verse": 7, "start": 42362, "end": 48706, "text": "¿Y Dios no hará justicia a sus escogidos, que claman a él día y noche, aunque sea paciente con ellos?", "words": [[0, 42362], [3, 42490], [8, 42810], [11, 43530], [16, 43710], [25, 44250], [27, 44430], [31, 44550], [42, 45190], [46, 45330], [53, 45560], [55, 45790], [58, 45970], [62, 46210], [64, 46390], [71, 47010], [78, 47190], [82, 47490], [91, 47990], [95, 48230]]}, {"verse": 8, "start": 49156, "end": 55821, "text": "Os digo que los defenderá pronto. Pero cuando venga el Hijo del hombre, ¿hallará fe en la tierra?", "words": [[0, 49156], [3, 49279], [8, 49579], [12, 49739], [16, 49899], [26, 50479], [34, 51486], [39, 51630], [46, 51890], [52, 52330], [55, 52450], [60, 52670], [64, 52830], [72, 53570], [81, 54210], [84, 54510], [87, 54830], [90, 54990]]}, {"verse": 9, "start": 56271, "end": 63743, "text": "Y dijo también a unos que confiaban de sí como justos, y menospreciaban a los otros, esta parábola:", "words": [[0, 56271], [2, 56382], [7, 56662], [15, 57122], [17, 57502], [22, 57722], [26, 57922], [36, 58622], [39, 58862], [42, 59022], [47, 59302], [55, 60202], [57, 60802], [72, 61402], [74, 61522], [78, 61702], [85, 62062], [90, 62802]]}, {"verse": 10, "start": 64193, "end": 70924, "text": "Dos hombres subieron al templo a orar: el uno fariseo, el otro recaudador de impuestos.", "words": [[0, 64193], [4, 64399], [12, 64839], [21, 65559], [24, 65759], [31, 66193], [33, 66626], [39, 67306], [42, 67486], [46, 67646], [55, 68726], [58, 68826], [63, 69026], [74, 69826], [77, 70006]]}, {"verse": 11, "start": 71374, "end": 83758, "text": "El fariseo, en pie, oraba consigo de esta manera: Dios, te doy gracias, que no soy como los otros hombres, ladrones, injustos, adúlteros, ni aun como este recaudador de impuestos;", "words": [[0, 71374], [3, 71512], [12, 72152], [15, 72312], [20, 72992], [26, 73672], [34, 74132], [37, 74472], [42, 74652], [50, 75542], [56, 75708], [59, 75888], [63, 76108], [72, 76868], [76, 76928], [79, 77108], [83, 77348], [88, 77568], [92, 77768], [98, 78008], [107, 78908], [117, 79748], [127, 80608], [138, 81548], [141, 81748], [145, 81948], [150, 82268], [155, 82488], [166, 83128], [169, 83288]]}, {"verse": 12, "start": 84208, "end": 88466, "text": "Ayuno dos veces a la semana, doy diezmos de todo lo que poseo.", "words": [[0, 84649], [6, 85109], [10, 85289], [16, 85549], [18, 85769], [21, 85829], [29, 86669], [33, 86869], [41, 87249], [44, 87429], [49, 87589], [52, 87769], [56, 87889]]}, {"verse": 13, "start": 88816, "end": 101436, "text": "Pero el recaudador de impuestos estando lejos no quería ni aun alzar los ojos al cielo, sino que se golpeaba el pecho, diciendo: Dios, ten misericordia de mí, pecador.", "words": [[0, 88816], [5, 89038], [8, 89238], [19, 89918], [22, 90158], [32, 90738], [40, 91238], [46, 91938], [49, 92378], [56, 92778], [59, 93178], [63, 93478], [69, 94158], [73, 94518], [78, 94918], [81, 95198], [88, 95738], [93, 96278], [97, 96478], [100, 96618], [109, 97218], [112, 97418], [119, 98158], [129, 99179], [135, 99426], [139, 99646], [152, 100406], [155, 100526], [159, 100866]]}, {"verse": 14, "start": 101786, "end": 113360, "text": "Os digo que este descendió a su casa justificado, a diferencia del otro; porque cualquiera que se enaltece, será humillado; y el que se humilla, será enaltecido.", "words": [[0, 101786], [3, 101910], [8, 102230], [12, 102490], [17, 102710], [27, 103430], [29, 103570], [32, 103690], [37, 104030], [50, 105370], [52, 105590], [63, 105930], [67, 106490], [73, 107288], [80, 107512], [91, 108172], [95, 108352], [98, 108512], [108, 109272], [113, 109592], [124, 110894], [126, 111055], [129, 111155], [133, 111295], [136, 111475], [145, 111895], [150, 112235]]}, {"verse": 15, "start": 113810, "end": 120093, "text": "Y traían a él los niños para que los tocase; lo cual viendo los discípulos les reprendían.", "words": [[0, 113810], [2, 113914], [9, 114454], [11, 114634], [14, 114834], [18, 115014], [24, 115454], [29, 115834], [33, 116014], [37, 116134], [45, 117254], [48, 117361], [53, 117521], [60, 117841], [64, 118061], [75, 118821], [79, 119201]]}, {"verse": 16, "start": 120543, "end": 129127, "text": "Pero Jesús llamándolos, dijo: Dejad los niños venir a mí, y no los impidáis; porque de tales es el reino de Dios.", "words": [[0, 120543], [5, 120688], [11, 121328], [24, 121968], [30, 122772], [36, 123352], [40, 123512], [46, 123892], [52, 124272], [54, 124452], [58, 124632], [60, 125052], [63, 125212], [67, 125800], [77, 126657], [84, 126881], [87, 127101], [93, 127401], [96, 127741], [99, 127941], [105, 128361], [108, 128521]]}, {"verse": 17, "start": 129577, "end": 136507, "text": "De cierto os digo, que cualquiera que no reciba el reino de Dios como un niño, no entrará en él.", "words": [[0, 129577], [3, 129763], [10, 130083], [13, 130463], [19, 130743], [23, 131303], [34, 131923], [38, 132063], [41, 132243], [48, 132803], [51, 132943], [57, 133303], [60, 133463], [65, 133703], [70, 134023], [73, 134263], [79, 134643], [82, 135263], [90, 135923], [93, 136103]]}, {"verse": 18, "start": 136957, "end": 142862, "text": "Y le preguntó un dirigente, diciendo: Maestro bueno, ¿qué haré para poseer la vida eterna?", "words": [[0, 136957], [2, 137064], [5, 137164], [14, 137684], [17, 137764], [28, 138444], [38, 139794], [46, 140275], [53, 140995], [58, 141115], [63, 141375], [68, 141535], [75, 141995], [78, 142095], [83, 142275]]}, {"verse": 19, "start": 143212, "end": 148908, "text": "Y Jesús le dijo: ¿Por qué me llamas bueno? ninguno hay bueno sino sólo Dios.", "words": [[0, 143212], [2, 143337], [8, 143737], [11, 144137], [17, 144954], [22, 145098], [26, 145238], [29, 145378], [36, 145758], [43, 146614], [51, 147120], [55, 147260], [61, 147580], [66, 147840], [71, 148200]]}, {"verse": 20, "start": 149358, "end": 160400, "text": "Los mandamientos sabes: No matarás: No adulterarás: No hurtarás: No dirás falso testimonio: Honra a tu padre y a tu madre.", "words": [[0, 149358], [4, 149483], [17, 150103], [24, 151272], [27, 151421], [36, 152512], [39, 153645], [52, 155107], [55, 155492], [65, 156178], [68, 156178], [74, 156178], [80, 156618], [92, 157810], [98, 158313], [100, 158513], [103, 158633], [109, 159073], [111, 159533], [113, 159633], [116, 159773]]}, {"verse": 21, "start": 160850, "end": 164973, "text": "Y él dijo: Todas estas cosas he guardado desde mi juventud.", "words": [[0, 160850], [2, 161167], [5, 161327], [11, 162133], [17, 162271], [23, 162611], [29, 163051], [32, 163391], [41, 163871], [47, 164091], [50, 164311]]}, {"verse": 22, "start": 165323, "end": 176657, "text": "Y Jesús, oído esto, le dijo: Aún te falta una cosa: vende todo lo que tienes, y da a los pobres, y tendrás tesoro en el cielo; y ven, sígueme.", "words": [[0, 165323], [2, 165445], [9, 165845], [14, 166525], [20, 167225], [23, 167365], [29, 168271], [33, 168494], [36, 168694], [42, 168994], [46, 169234], [52, 170038], [58, 170424], [63, 170724], [66, 170944], [70, 171044], [78, 171424], [80, 171924], [83, 172144], [85, 172264], [89, 172364], [97, 172984], [99, 173364], [107, 173824], [114, 174304], [117, 174424], [120, 174544], [127, 175389], [129, 175572], [134, 176032]]}, {"verse": 23, "start": 177107, "end": 182907, "text": "Entonces él, oídas estas cosas, se puso muy triste, porque era muy rico.", "words": [[0, 177107], [9, 177665], [13, 178085], [19, 178645], [25, 178885], [32, 179625], [35, 179885], [40, 180205], [44, 180565], [52, 181125], [59, 181745], [63, 182005], [67, 182285]]}, {"verse": 24, "start": 183357, "end": 193157, "text": "Y viendo Jesús que se había entristecido mucho, dijo: ¡Con cuánta dificultad entrarán en el reino de Dios los que tienen riquezas!", "words": [[0, 183357], [2, 183479], [9, 183739], [15, 184219], [19, 184739], [22, 184899], [28, 185559], [41, 186219], [48, 186859], [54, 187720], [59, 187869], [66, 188449], [77, 189349], [86, 190109], [89, 190329], [92, 190509], [98, 190909], [101, 191049], [106, 191329], [110, 191769], [114, 191909], [121, 192569]]}, {"verse": 25, "start": 193607, "end": 200905, "text": "Porque más fácil cosa es entrar un camello por el ojo de una aguja, que un rico entrar en el reino de Dios.", "words": [[0, 193607], [7, 193832], [11, 194012], [17, 194412], [22, 194852], [25, 195132], [32, 195572], [35, 195832], [43, 196312], [47, 196552], [50, 196672], [54, 196972], [57, 197092], [61, 197272], [68, 197892], [72, 198372], [75, 198532], [80, 198792], [87, 199312], [90, 199672], [93, 199832], [99, 200192], [102, 200312]]}, {"verse": 26, "start": 201355, "end": 204580, "text": "Y los que lo oían, dijeron: ¿Y quién podrá ser salvo?", "words": [[0, 201355], [2, 201461], [6, 201601], [10, 201761], [13, 201961], [19, 202441], [28, 203244], [31, 203369], [37, 203569], [43, 203969], [47, 204069]]}, {"verse": 27, "start": 204930, "end": 210928, "text": "Y él les dijo: Lo que es imposible para con los hombres, posible es para Dios.", "words": [[0, 204930], [2, 205112], [5, 205312], [9, 205672], [15, 206594], [18, 206737], [22, 206897], [25, 207057], [35, 207897], [40, 208137], [44, 208357], [48, 208537], [57, 209177], [65, 209897], [68, 210137], [73, 210337]]}, {"verse": 28, "start": 211378, "end": 217571, "text": "Entonces Pedro dijo: He aquí, nosotros hemos dejado las posesiones nuestras, y te hemos seguido.", "words": [[0, 211378], [9, 211919], [15, 212479], [21, 213453], [24, 213543], [30, 213783], [39, 214083], [45, 214563], [52, 215063], [56, 215203], [67, 215763], [77, 216243], [79, 216663], [82, 216823], [88, 216983]]}, {"verse": 29, "start": 217921, "end": 228581, "text": "Y él les dijo: De cierto os digo, que nadie hay que haya dejado casa, padres, o hermanos, o mujer, o hijos, por el reino de Dios,", "words": [[0, 217921], [2, 218103], [5, 218303], [9, 218663], [15, 219585], [18, 219813], [25, 220093], [28, 220553], [34, 220833], [38, 221093], [44, 221473], [48, 221913], [52, 222133], [57, 222373], [64, 222893], [70, 223793], [78, 224153], [80, 224793], [90, 225493], [92, 225673], [99, 226053], [101, 226333], [108, 226693], [112, 227273], [115, 227453], [121, 227873], [124, 228053]]}, {"verse": 30, "start": 229031, "end": 235919, "text": "Que no haya de recibir mucho más en este tiempo, y en la era venidera la vida eterna.", "words": [[0, 229031], [4, 229113], [7, 229313], [12, 229553], [15, 229753], [23, 230153], [29, 230613], [33, 230933], [36, 231133], [41, 231353], [49, 231793], [51, 232353], [54, 232493], [57, 232653], [61, 232873], [70, 233553], [73, 233673], [78, 233893]]}, {"verse": 31, "start": 236369, "end": 246792, "text": "Y Jesús, tomando a los doce, les dijo: He aquí subimos a Jerusalén, y serán cumplidas todas las cosas que fueron escritas por los profetas, del Hijo del hombre.", "words": [[0, 236369], [2, 236369], [9, 236369], [17, 236791], [19, 236891], [23, 237031], [29, 237791], [33, 237911], [39, 238809], [42, 238889], [47, 239109], [55, 239689], [57, 239849], [68, 240569], [70, 241069], [76, 241449], [86, 242149], [92, 242429], [96, 242729], [102, 243009], [106, 243229], [113, 243489], [122, 244109], [126, 244329], [130, 244489], [140, 245149], [144, 245829], [149, 246129], [153, 246309]]}, {"verse": 32, "start": 247242, "end": 254226, "text": "Porque será entregado a los gentiles, y será objeto de burlas, e injuriado, y escupido.", "words": [[0, 247242], [7, 247445], [12, 247825], [22, 248805], [24, 248885], [28, 248985], [38, 249705], [40, 250225], [45, 250505], [52, 251125], [55, 251365], [63, 251925], [65, 252225], [76, 253145], [78, 253365]]}, {"verse": 33, "start": 254676, "end": 260274, "text": "Y después que le hayan azotado, le matarán: pero al tercer día resucitará.", "words": [[0, 254676], [2, 254947], [10, 255187], [14, 255367], [17, 255487], [23, 255917], [32, 256347], [35, 256487], [44, 257488], [49, 257912], [52, 258152], [59, 258452], [63, 258912]]}, {"verse": 34, "start": 260724, "end": 269303, "text": "Pero ellos nada de estas cosas entendían, y esta palabra les era encubierta, y no entendían lo que se decía.", "words": [[0, 260724], [5, 260886], [11, 261606], [16, 261946], [19, 262166], [25, 262386], [31, 262826], [42, 264126], [44, 264366], [49, 264586], [57, 264966], [61, 265506], [65, 265746], [77, 266586], [79, 267186], [82, 267366], [92, 268046], [95, 268246], [99, 268386], [102, 268526]]}, {"verse": 35, "start": 269753, "end": 276949, "text": "Y aconteció que acercándose él a Jericó, un ciego estaba sentado junto al camino mendigando;", "words": [[0, 269753], [2, 269897], [12, 270617], [16, 270897], [28, 271797], [31, 272157], [33, 272397], [41, 273637], [44, 273797], [50, 274257], [57, 274537], [65, 275177], [71, 275397], [74, 275637], [81, 276326]]}, {"verse": 36, "start": 277399, "end": 281492, "text": "El cual cuando oyó la gente que pasaba, preguntó qué era aquello.", "words": [[0, 277399], [3, 277584], [8, 277844], [15, 278204], [19, 278604], [22, 278704], [28, 278984], [32, 279164], [40, 279804], [49, 280224], [53, 280364], [57, 280744]]}, {"verse": 37, "start": 281942, "end": 284435, "text": "Y le dijeron que pasaba Jesús nazareno.", "words": [[0, 281942], [2, 282050], [5, 282150], [13, 282630], [17, 282770], [24, 283210], [30, 283470]]}, {"verse": 38, "start": 284885, "end": 290575, "text": "Entonces dio voces, diciendo: Jesús, Hijo de David, ten misericordia de mí.", "words": [[0, 284885], [9, 285503], [13, 286083], [20, 286563], [30, 287559], [37, 288108], [42, 288328], [45, 288448], [52, 288908], [56, 289368], [69, 290148], [72, 290288]]}, {"verse": 39, "start": 290925, "end": 302926, "text": "Y los que iban delante, le reprendían para que callase; pero él clamaba mucho más: Hijo de David, ten misericordia de mí.", "words": [[0, 290925], [2, 291047], [6, 291207], [10, 291407], [15, 291667], [24, 292117], [27, 292567], [38, 293307], [43, 293607], [47, 293827], [56, 295021], [61, 295167], [64, 295427], [72, 295987], [78, 296327], [83, 297259], [88, 297516], [91, 297656], [98, 298216], [102, 298336], [115, 299136], [118, 299276]]}, {"verse": 40, "start": 303276, "end": 309287, "text": "Jesús entonces parándose, mandó traerle a sí: y como él llegó, le preguntó,", "words": [[0, 303276], [6, 303563], [15, 304463], [26, 305123], [32, 305443], [40, 305811], [42, 306179], [46, 306812], [48, 307076], [53, 307316], [56, 307536], [63, 308416], [66, 308476]]}, {"verse": 41, "start": 309737, "end": 314656, "text": "Diciendo: ¿Qué quieres que te haga? Y él dijo: Señor, que vea.", "words": [[0, 309737], [10, 310821], [15, 310926], [23, 311246], [27, 311426], [30, 311606], [36, 312446], [38, 312763], [41, 312923], [47, 313729], [54, 314035], [58, 314235]]}, {"verse": 42, "start": 315006, "end": 319925, "text": "Y Jesús le dijo: Recobra la vista, tu fe te ha hecho salvo.", "words": [[0, 315006], [2, 315130], [8, 315530], [11, 315930], [17, 316747], [25, 317272], [28, 317472], [35, 318352], [38, 318592], [41, 318792], [44, 318972], [47, 319092], [53, 319292]]}, {"verse": 43, "start": 320375, "end": 327497, "text": "Y enseguida vio, y le seguía, glorificando a Dios: y todo el pueblo como lo vio, dio a Dios alabanza.", "words": [[0, 320375], [2, 320501], [12, 321021], [17, 321361], [19, 321501], [22, 321601], [30, 322161], [43, 323021], [45, 323141], [51, 323940], [53, 324047], [58, 324247], [61, 324447], [68, 324807], [73, 325087], [76, 325287], [81, 325887], [85, 326147], [87, 326367], [92, 326944]]}]}