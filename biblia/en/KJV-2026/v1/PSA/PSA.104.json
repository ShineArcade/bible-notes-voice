{"book": "PSA", "chapter": 104, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 202366, "verses": [{"verse": 1, "start": 300, "end": 6684, "text": "Bless the LORD, O my soul. O LORD my God, you are very great; you are clothed with honour and majesty.", "words": [[0, 300], [6, 548], [10, 828], [16, 1208], [18, 1268], [21, 1448], [27, 2322], [29, 2402], [34, 2762], [37, 2862], [42, 3342], [46, 3442], [50, 3542], [55, 3822], [62, 4611], [66, 4737], [70, 4927], [78, 5117], [83, 5437], [90, 5757], [94, 5977]]}, {"verse": 2, "start": 7134, "end": 12388, "text": "Who cover yourself with light as with a garment: who stretch out the heavens like a curtain:", "words": [[0, 7134], [4, 7215], [10, 7495], [19, 7895], [24, 8175], [30, 8435], [33, 8755], [38, 8915], [40, 8995], [49, 10292], [53, 10397], [61, 10717], [65, 10997], [69, 11177], [77, 11437], [82, 11737], [84, 11877]]}, {"verse": 3, "start": 12838, "end": 20391, "text": "Who lays the beams of his chambers in the waters: who makes the clouds his chariot: who walks upon the wings of the wind:", "words": [[0, 12838], [4, 13154], [9, 13414], [13, 13674], [19, 14034], [22, 14294], [26, 14434], [35, 14874], [38, 15134], [42, 15214], [50, 16145], [54, 16255], [60, 16455], [64, 16675], [71, 17055], [75, 17315], [84, 18259], [88, 18366], [94, 18666], [99, 19026], [103, 19246], [109, 19526], [112, 19766], [116, 19906]]}, {"verse": 4, "start": 20841, "end": 24800, "text": "Who makes his angels spirits; his ministers a flaming fire:", "words": [[0, 20841], [4, 20950], [10, 21170], [14, 21410], [21, 21750], [30, 22863], [34, 22990], [44, 23490], [46, 23730], [54, 24110]]}, {"verse": 5, "start": 25250, "end": 29413, "text": "Who laid the foundations of the earth, that it should not be removed for ever.", "words": [[0, 25250], [4, 25347], [9, 25567], [13, 25767], [25, 26347], [28, 26667], [32, 26827], [39, 27087], [44, 27547], [47, 27667], [54, 27867], [58, 28107], [61, 28327], [69, 28704], [73, 29081]]}, {"verse": 6, "start": 29863, "end": 34230, "text": "You covered it with the deep as with a garment: the waters stood above the mountains.", "words": [[0, 29863], [4, 29957], [12, 30277], [15, 30457], [20, 30637], [24, 30757], [29, 31037], [32, 31277], [37, 31407], [39, 31537], [48, 32389], [52, 32555], [59, 32755], [65, 33095], [71, 33395], [75, 33575]]}, {"verse": 7, "start": 34680, "end": 38953, "text": "At your rebuke they fled; at the voice of your thunder they hasted away.", "words": [[0, 34736], [3, 34826], [8, 34986], [15, 35506], [20, 35646], [26, 36523], [29, 36650], [33, 36770], [39, 37070], [42, 37250], [47, 37390], [55, 37910], [60, 38010], [67, 38430]]}, {"verse": 8, "start": 39403, "end": 44720, "text": "They go up by the mountains; they go down by the valleys to the place which you have founded for them.", "words": [[0, 39403], [5, 39497], [8, 39697], [11, 39877], [14, 40077], [18, 40197], [29, 41113], [34, 41199], [37, 41399], [42, 41659], [45, 41899], [49, 42039], [57, 42419], [60, 42699], [64, 42839], [70, 43099], [76, 43359], [80, 43579], [85, 43699], [93, 44039], [97, 44279]]}, {"verse": 9, "start": 45170, "end": 50166, "text": "You have set a bound that they may not pass over; that they turn not again to cover the earth.", "words": [[0, 45170], [4, 45294], [9, 45454], [13, 45634], [15, 45734], [21, 46054], [26, 46334], [31, 46514], [35, 46674], [39, 46874], [44, 47134], [50, 47968], [55, 48091], [60, 48251], [65, 48571], [69, 48831], [75, 49231], [78, 49391], [84, 49671], [88, 49871]]}, {"verse": 10, "start": 50616, "end": 54086, "text": "He sends the springs into the valleys, which run among the hills.", "words": [[0, 50616], [3, 50698], [9, 50978], [13, 51238], [21, 51618], [26, 51918], [30, 52078], [39, 52778], [45, 52938], [49, 53178], [55, 53378], [59, 53618]]}, {"verse": 11, "start": 54536, "end": 59906, "text": "They give drink to every beast of the field: the wild donkeys quench their thirst.", "words": [[0, 54536], [5, 54776], [10, 54976], [16, 55276], [19, 55476], [25, 55796], [31, 56176], [34, 56356], [38, 56476], [45, 57606], [49, 57681], [54, 57981], [62, 58541], [69, 59061], [75, 59261]]}, {"verse": 12, "start": 60356, "end": 65726, "text": "By them shall the fowls of the heaven have their habitation, which sing among the branches.", "words": [[0, 60356], [3, 60713], [8, 60993], [14, 61313], [18, 61493], [24, 62053], [27, 62173], [31, 62313], [38, 62533], [43, 62813], [49, 62993], [61, 63933], [67, 64213], [72, 64533], [78, 64813], [82, 65013]]}, {"verse": 13, "start": 66176, "end": 71246, "text": "He waters the hills from his chambers: the earth is satisfied with the fruit of your works.", "words": [[0, 66176], [3, 66283], [10, 66583], [14, 66883], [20, 67123], [25, 67403], [29, 67583], [39, 68591], [43, 68679], [49, 68939], [52, 69159], [62, 69639], [67, 69939], [71, 70079], [77, 70299], [80, 70459], [85, 70579]]}, {"verse": 14, "start": 71696, "end": 78639, "text": "He causes the grass to grow for the cattle, and herb for the service of man: that he may bring forth food out of the earth;", "words": [[0, 71696], [3, 71760], [10, 72140], [14, 72380], [20, 72640], [23, 72880], [28, 73120], [32, 73300], [36, 73420], [44, 73800], [48, 74260], [53, 74520], [57, 74680], [61, 74780], [69, 75080], [72, 75280], [77, 76098], [82, 76220], [85, 76360], [89, 76540], [95, 76840], [101, 77140], [106, 77580], [110, 77880], [113, 78040], [117, 78160]]}, {"verse": 15, "start": 79089, "end": 86703, "text": "And wine that makes glad the heart of man, and oil to make his face to shine, and bread which strengthens man’s heart.", "words": [[0, 79089], [4, 79255], [9, 79636], [14, 79895], [20, 80155], [25, 80555], [29, 80776], [35, 81055], [38, 81195], [43, 81595], [47, 82015], [51, 82295], [54, 82535], [59, 82735], [63, 82955], [68, 83255], [71, 83455], [78, 84295], [82, 84496], [88, 84815], [94, 85155], [106, 85855], [112, 86315]]}, {"verse": 16, "start": 87153, "end": 92346, "text": "The trees of the LORD are full of sap; the cedars of Lebanon, which he has planted;", "words": [[0, 87153], [4, 87213], [10, 87553], [13, 87793], [17, 87913], [22, 88233], [26, 88493], [31, 88753], [34, 88893], [39, 89728], [43, 89816], [50, 90296], [53, 90436], [62, 91256], [68, 91416], [71, 91556], [75, 91716]]}, {"verse": 17, "start": 92796, "end": 97949, "text": "Where the birds make their nests: as for the stork, the fir trees are her house.", "words": [[0, 92796], [6, 92944], [10, 93084], [16, 93424], [21, 93764], [27, 93964], [34, 94957], [37, 95160], [41, 95340], [45, 95460], [52, 96140], [56, 96220], [60, 96420], [66, 96860], [70, 97160], [74, 97320]]}, {"verse": 18, "start": 98399, "end": 103432, "text": "The high hills are a refuge for the wild goats; and the rocks for the rock badgers.", "words": [[0, 98399], [4, 98539], [9, 98799], [15, 99059], [19, 99279], [21, 99399], [28, 99739], [32, 100119], [36, 100219], [41, 100479], [48, 101521], [52, 101638], [56, 101738], [62, 102118], [66, 102358], [70, 102458], [75, 102738]]}, {"verse": 19, "start": 103882, "end": 108039, "text": "He appointed the moon for seasons: the sun knows his going down.", "words": [[0, 103882], [3, 104007], [13, 104407], [17, 104627], [22, 104887], [26, 105107], [35, 106171], [39, 106249], [43, 106549], [49, 106869], [53, 107089], [59, 107369]]}, {"verse": 20, "start": 108489, "end": 113556, "text": "You make darkness, and it is night: in which all the beasts of the forest do creep forth.", "words": [[0, 108489], [4, 108579], [9, 108739], [19, 109219], [23, 109519], [26, 109639], [29, 109779], [36, 110572], [39, 110700], [45, 110860], [49, 111140], [53, 111300], [60, 111560], [63, 111800], [67, 111920], [74, 112300], [77, 112640], [83, 112920]]}, {"verse": 21, "start": 114006, "end": 117826, "text": "The young lions roar after their prey, and seek their food from God.", "words": [[0, 114006], [4, 114112], [10, 114292], [16, 114692], [21, 115112], [27, 115492], [33, 115692], [39, 116092], [43, 116312], [48, 116492], [54, 116732], [59, 117012], [64, 117252]]}, {"verse": 22, "start": 118276, "end": 123500, "text": "The sun arises, they gather themselves together, and lay them down in their dens.", "words": [[0, 118276], [4, 118420], [8, 118700], [16, 119180], [21, 119500], [28, 119860], [39, 120360], [49, 120960], [53, 121600], [57, 121820], [62, 122040], [67, 122360], [70, 122600], [76, 122740]]}, {"verse": 23, "start": 123950, "end": 127573, "text": "Man goes forth to his work and to his labour until the evening.", "words": [[0, 123950], [4, 124158], [9, 124458], [15, 124818], [18, 125038], [22, 125218], [27, 125518], [31, 125758], [34, 125858], [38, 126118], [45, 126378], [51, 126718], [55, 126918]]}, {"verse": 24, "start": 128023, "end": 135356, "text": "O LORD, how manifold are your works! in wisdom have you made them all: the earth is full of your riches.", "words": [[0, 128154], [2, 128324], [8, 128664], [12, 128764], [21, 129344], [25, 129684], [30, 129844], [37, 130889], [40, 131036], [47, 131456], [52, 131856], [56, 132016], [61, 132256], [66, 132516], [71, 133361], [75, 133448], [81, 133708], [84, 133948], [89, 134228], [92, 134428], [97, 134588]]}, {"verse": 25, "start": 135806, "end": 143471, "text": "So is this great and wide sea, in which are things creeping innumerable, both small and great beasts.", "words": [[0, 135806], [3, 136010], [6, 136230], [11, 136450], [17, 136870], [21, 137050], [26, 137410], [31, 138270], [34, 138450], [40, 138650], [44, 138810], [51, 139110], [60, 139610], [73, 141070], [78, 141210], [84, 141770], [88, 142310], [94, 142650]]}, {"verse": 26, "start": 143921, "end": 148821, "text": "There go the ships: there is that leviathan, whom you have made to play in it.", "words": [[0, 143921], [6, 144139], [9, 144419], [13, 144579], [20, 145537], [26, 145680], [29, 145900], [34, 146120], [45, 146880], [50, 147320], [54, 147540], [59, 147740], [64, 147960], [67, 148140], [72, 148460], [75, 148620]]}, {"verse": 27, "start": 149271, "end": 153896, "text": "These wait all upon you; that you may give them their food in due season.", "words": [[0, 149271], [6, 149517], [11, 149837], [15, 150077], [20, 150337], [25, 151111], [30, 151221], [34, 151401], [38, 151581], [43, 151861], [48, 152041], [54, 152241], [59, 152521], [62, 152741], [66, 152921]]}, {"verse": 28, "start": 154346, "end": 159090, "text": "That you give them they gather: you open your hand, they are filled with good.", "words": [[0, 154346], [5, 154492], [9, 154652], [14, 154932], [19, 155172], [24, 155372], [32, 156346], [36, 156512], [41, 156792], [46, 157032], [52, 157712], [57, 157872], [61, 157992], [68, 158272], [73, 158572]]}, {"verse": 29, "start": 159540, "end": 165887, "text": "You hide your face, they are troubled: you take away their breath, they die, and return to their dust.", "words": [[0, 159540], [4, 159667], [9, 159947], [14, 160167], [20, 160927], [25, 161047], [29, 161167], [39, 162064], [43, 162169], [48, 162409], [53, 162649], [59, 162869], [67, 163589], [72, 163749], [77, 164469], [81, 164549], [88, 164949], [91, 165169], [97, 165329]]}, {"verse": 30, "start": 166337, "end": 171356, "text": "You send forth your spirit, they are created: and you renew the face of the earth.", "words": [[0, 166337], [4, 166482], [9, 166762], [15, 167062], [20, 167302], [28, 168102], [33, 168302], [37, 168482], [46, 169547], [50, 169675], [54, 169815], [60, 170135], [64, 170375], [69, 170655], [72, 170875], [76, 170995]]}, {"verse": 31, "start": 171806, "end": 177441, "text": "The glory of the LORD shall endure for ever: the LORD shall rejoice in his works.", "words": [[0, 171806], [4, 172098], [10, 172498], [13, 172718], [17, 172858], [22, 173178], [28, 173458], [35, 173911], [39, 174364], [45, 175064], [49, 175315], [54, 175595], [60, 175875], [68, 176315], [71, 176635], [75, 176815]]}, {"verse": 32, "start": 177891, "end": 182616, "text": "He looks on the earth, and it trembles: he touches the hills, and they smoke.", "words": [[0, 177891], [3, 177969], [9, 178169], [12, 178409], [16, 178569], [23, 178849], [27, 179289], [30, 179409], [40, 180507], [43, 180591], [51, 180911], [55, 181191], [62, 181491], [66, 181831], [71, 181991]]}, {"verse": 33, "start": 183066, "end": 189040, "text": "I will sing to the LORD as long as I live: I will sing praise to my God while I have my being.", "words": [[0, 183066], [2, 183192], [7, 183332], [12, 183592], [15, 183772], [19, 183892], [24, 184112], [27, 184312], [32, 184532], [35, 184712], [37, 184852], [43, 185743], [45, 185907], [50, 186067], [55, 186367], [62, 186747], [65, 187067], [68, 187247], [72, 187587], [78, 187847], [80, 188067], [85, 188267], [88, 188467]]}, {"verse": 34, "start": 189490, "end": 193800, "text": "My meditation of him shall be sweet: I will be glad in the LORD.", "words": [[0, 189490], [3, 189675], [14, 190215], [17, 190575], [21, 190735], [27, 190995], [30, 191175], [37, 192007], [39, 192367], [44, 192507], [47, 192647], [52, 192987], [55, 193227], [59, 193347]]}, {"verse": 35, "start": 194250, "end": 201966, "text": "Let the sinners be consumed out of the earth, and let the wicked be no more. Bless the LORD, O my soul. Praise the LORD.", "words": [[0, 194250], [4, 194413], [8, 194593], [16, 194893], [19, 195193], [28, 195633], [32, 195913], [35, 196053], [39, 196173], [46, 196673], [50, 197013], [54, 197213], [58, 197373], [65, 197633], [68, 197873], [71, 198093], [77, 198934], [83, 199158], [87, 199438], [93, 199818], [95, 199838], [98, 200018], [104, 200920], [111, 201144], [115, 201424]]}]}