{"book": "LUK", "chapter": 15, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 222965, "verses": [{"verse": 1, "start": 300, "end": 4613, "text": "Then drew near to him all the tax collectors and sinners to hear him.", "words": [[0, 300], [5, 580], [10, 880], [15, 1140], [18, 1360], [22, 1540], [26, 1920], [30, 2080], [34, 2420], [45, 2980], [49, 3280], [57, 3680], [60, 4000], [65, 4220]]}, {"verse": 2, "start": 5063, "end": 10713, "text": "And the Pharisees and scribes murmured, saying, This man receives sinners, and eats with them.", "words": [[0, 5063], [4, 5370], [8, 5490], [18, 6210], [22, 6330], [30, 6990], [40, 7730], [48, 8617], [53, 8751], [57, 8884], [66, 9204], [75, 9684], [79, 10144], [84, 10324], [89, 10524]]}, {"verse": 3, "start": 11063, "end": 14083, "text": "¶ And he spoke this parable to them, saying,", "words": [[2, 11063], [6, 11186], [9, 11306], [15, 11586], [20, 11866], [28, 12366], [31, 12546], [37, 12926]]}, {"verse": 4, "start": 14333, "end": 23933, "text": "What man of you, having a hundred sheep, if he lose one of them, does not leave the ninety and nine in the wilderness, and go after that which is lost, until he find it?", "words": [[0, 14333], [5, 14535], [9, 14835], [12, 15015], [17, 15435], [24, 15675], [26, 15875], [34, 16135], [41, 16515], [44, 16875], [47, 16995], [52, 17235], [56, 17495], [59, 17595], [65, 18075], [70, 18195], [74, 18435], [80, 18715], [84, 18875], [91, 19175], [95, 19375], [100, 19615], [103, 19795], [107, 19875], [119, 20824], [123, 20949], [126, 21149], [132, 21409], [137, 21709], [143, 21969], [146, 22169], [152, 22569], [158, 23109], [161, 23309], [166, 23629]]}, {"verse": 5, "start": 24383, "end": 27851, "text": "And when he has found it, he lays it on his shoulders, rejoicing.", "words": [[0, 24383], [4, 24506], [9, 24646], [12, 24806], [16, 24986], [22, 25326], [26, 25646], [29, 25766], [34, 26006], [37, 26166], [40, 26286], [44, 26406], [55, 27146]]}, {"verse": 6, "start": 28301, "end": 36573, "text": "And when he comes home, he calls together his friends and neighbours, saying to them, Rejoice with me; for I have found my sheep which was lost.", "words": [[0, 28301], [4, 28501], [9, 28701], [12, 28861], [18, 29081], [24, 29661], [27, 29741], [33, 30001], [42, 30401], [46, 30601], [54, 30981], [58, 31491], [70, 32001], [77, 32281], [80, 32481], [86, 33061], [94, 33601], [99, 33781], [103, 34390], [107, 34483], [109, 34703], [114, 34843], [120, 35103], [123, 35303], [129, 35583], [135, 35823], [139, 36003]]}, {"verse": 7, "start": 37023, "end": 45554, "text": "I say to you, that likewise joy shall be in heaven over one sinner that repents, more than over ninety and nine just persons, which need no repentance.", "words": [[0, 37023], [2, 37163], [6, 37423], [9, 37563], [14, 38123], [19, 38283], [28, 38623], [32, 39083], [38, 39343], [41, 39503], [44, 39663], [51, 39843], [56, 40123], [60, 40423], [67, 40743], [72, 40943], [81, 41803], [86, 41963], [91, 42123], [96, 42303], [103, 42643], [107, 42823], [112, 43083], [117, 43303], [126, 43783], [132, 44303], [137, 44543], [140, 44743]]}, {"verse": 8, "start": 46004, "end": 54784, "text": "¶ Either what woman having ten pieces of silver, if she lose one piece, does not light a lamp, and sweep the house, and seek diligently till she find it?", "words": [[2, 46004], [9, 46263], [14, 46543], [20, 46863], [27, 47143], [31, 47503], [38, 47883], [41, 48063], [49, 48763], [52, 49143], [56, 49283], [61, 49523], [65, 49803], [72, 50543], [77, 50683], [81, 50883], [87, 51083], [89, 51223], [95, 51523], [99, 51863], [105, 52083], [109, 52303], [116, 52623], [120, 53083], [125, 53303], [136, 53823], [141, 54103], [145, 54263], [150, 54583]]}, {"verse": 9, "start": 55134, "end": 63662, "text": "And when she has found it, she calls her friends and her neighbours together, saying, Rejoice with me; for I have found the piece which I had lost.", "words": [[0, 55134], [4, 55258], [9, 55418], [13, 55618], [17, 55798], [23, 56138], [27, 56598], [31, 56738], [37, 57038], [41, 57238], [49, 57598], [53, 57938], [57, 58158], [68, 58378], [78, 59078], [86, 59841], [94, 60435], [99, 60635], [103, 61341], [107, 61450], [109, 61610], [114, 61730], [120, 62030], [124, 62280], [130, 62530], [136, 62790], [138, 63010], [142, 63150]]}, {"verse": 10, "start": 63962, "end": 70084, "text": "Likewise, I say to you, there is joy in the presence of the angels of God over one sinner that repents.", "words": [[0, 63962], [10, 64545], [12, 64625], [16, 64845], [19, 65025], [24, 65645], [30, 65805], [33, 65965], [37, 66345], [40, 66565], [44, 66645], [53, 66945], [56, 67205], [60, 67345], [67, 67725], [70, 67905], [74, 68205], [79, 68545], [83, 68845], [90, 69205], [95, 69445]]}, {"verse": 11, "start": 70434, "end": 74058, "text": "¶ And he said, A certain man had two sons:", "words": [[2, 70434], [6, 70569], [9, 70709], [15, 72168], [17, 72258], [25, 72498], [29, 72838], [33, 73118], [37, 73358]]}, {"verse": 12, "start": 74408, "end": 81770, "text": "And the younger of them said to his father, Father, give me the portion of goods that falls to me. And he divided to them his living.", "words": [[0, 74408], [4, 74534], [8, 74634], [16, 74874], [19, 75114], [24, 75274], [29, 75514], [32, 75694], [36, 75834], [44, 76621], [52, 77006], [57, 77416], [60, 77596], [64, 77736], [72, 78096], [75, 78316], [81, 78616], [86, 78856], [92, 79156], [95, 79376], [99, 79963], [103, 80089], [106, 80169], [114, 80569], [117, 80809], [122, 81049], [126, 81269]]}, {"verse": 13, "start": 82070, "end": 90837, "text": "And not many days after the younger son gathered all together, and took his journey into a far country, and there wasted his substance with riotous living.", "words": [[0, 82070], [4, 82195], [8, 82395], [13, 82675], [18, 82995], [24, 83395], [28, 83555], [36, 83815], [40, 84175], [49, 84575], [53, 84895], [63, 85315], [67, 85835], [72, 86015], [76, 86195], [84, 86575], [89, 86835], [91, 87035], [95, 87275], [104, 87715], [108, 88235], [114, 88355], [121, 88735], [125, 88975], [135, 89455], [140, 89775], [148, 90335]]}, {"verse": 14, "start": 91287, "end": 97644, "text": "And when he had spent all, there arose a mighty famine in that land; and he began to be in want.", "words": [[0, 91287], [4, 91431], [9, 91611], [12, 91811], [16, 91931], [22, 92151], [27, 93071], [33, 93251], [39, 93651], [41, 93831], [48, 94111], [55, 94571], [58, 94911], [63, 95131], [69, 95922], [73, 96068], [76, 96188], [82, 96488], [85, 96708], [88, 96928], [91, 97108]]}, {"verse": 15, "start": 98094, "end": 104332, "text": "And he went and joined himself to a citizen of that country; and he sent him into his fields to feed swine.", "words": [[0, 98094], [4, 98236], [7, 98356], [12, 98576], [16, 98836], [23, 99096], [31, 99556], [34, 99756], [36, 99876], [44, 100196], [47, 100416], [52, 100596], [61, 101459], [65, 101575], [68, 101675], [73, 101955], [77, 102155], [82, 102475], [86, 102695], [93, 103095], [96, 103355], [101, 103595]]}, {"verse": 16, "start": 104682, "end": 110366, "text": "And he would gladly have filled his belly with the husks that the swine did eat: and no man gave to him.", "words": [[0, 104682], [4, 104819], [7, 104939], [13, 105099], [20, 105539], [25, 105799], [32, 106039], [36, 106259], [42, 106559], [47, 106799], [51, 106939], [57, 107359], [62, 107499], [66, 107659], [72, 108019], [76, 108179], [81, 108948], [85, 109085], [88, 109265], [92, 109525], [97, 109805], [100, 110025]]}, {"verse": 17, "start": 110816, "end": 118339, "text": "And when he came to himself, he said, How many hired servants of my father’s have bread enough and to spare, and I perish with hunger!", "words": [[0, 110816], [4, 110934], [9, 111074], [12, 111214], [17, 111434], [20, 111634], [29, 112234], [32, 112314], [38, 112968], [42, 113101], [47, 113361], [53, 113721], [62, 114141], [65, 114401], [68, 114581], [77, 114921], [82, 115191], [88, 115461], [95, 115761], [99, 116121], [102, 116321], [109, 116881], [113, 117161], [115, 117281], [122, 117661], [127, 117921]]}, {"verse": 18, "start": 118789, "end": 125299, "text": "I will arise and go to my father, and will say to him, Father, I have sinned against heaven, and before you,", "words": [[0, 118789], [2, 118926], [7, 119086], [13, 119446], [17, 119886], [20, 120046], [23, 120206], [26, 120326], [34, 120646], [38, 121206], [43, 121366], [47, 121586], [50, 121726], [55, 122226], [63, 122806], [65, 123046], [70, 123226], [77, 123406], [85, 123666], [93, 124106], [97, 124586], [104, 124886]]}, {"verse": 19, "start": 125749, "end": 129849, "text": "And am no more worthy to be called your son: make me as one of your hired servants.", "words": [[0, 125749], [4, 125873], [7, 126033], [10, 126173], [15, 126373], [22, 126693], [25, 126833], [28, 126973], [35, 127193], [40, 127353], [45, 128089], [50, 128248], [53, 128428], [56, 128548], [60, 128688], [63, 128768], [68, 128888], [74, 129148]]}, {"verse": 20, "start": 130149, "end": 139349, "text": "And he arose, and came to his father. But when he was yet a great way off, his father saw him, and had compassion, and ran, and fell on his neck, and kissed him.", "words": [[0, 130149], [4, 130307], [7, 130447], [14, 130727], [18, 131127], [23, 131347], [26, 131547], [30, 131707], [38, 132518], [42, 132623], [47, 132743], [50, 132883], [54, 133043], [58, 133183], [60, 133303], [66, 133543], [70, 133743], [75, 134403], [79, 134563], [86, 134903], [90, 135243], [95, 135503], [99, 135883], [103, 136043], [115, 136603], [119, 136923], [124, 137263], [128, 137543], [133, 137743], [136, 137923], [140, 138063], [146, 138383], [150, 138743], [157, 138983]]}, {"verse": 21, "start": 139699, "end": 146260, "text": "And the son said to him, Father, I have sinned against heaven, and in your sight, and am no more worthy to be called your son.", "words": [[0, 139699], [4, 139827], [8, 139947], [12, 140227], [17, 140527], [20, 140727], [25, 141344], [33, 141783], [35, 141863], [40, 142023], [47, 142443], [55, 142563], [63, 142943], [67, 143383], [70, 143483], [75, 143603], [82, 143943], [86, 144223], [89, 144503], [92, 144643], [97, 144823], [104, 145143], [107, 145303], [110, 145403], [117, 145643], [122, 145823]]}, {"verse": 22, "start": 146610, "end": 155746, "text": "But the father said to his servants, Bring forth the best robe, and put it on him; and put a ring on his hand, and shoes on his feet:", "words": [[0, 146610], [4, 146698], [8, 146838], [15, 147118], [20, 147458], [23, 147638], [27, 147798], [37, 150654], [43, 150873], [49, 151173], [53, 151413], [58, 151653], [64, 151973], [68, 152273], [72, 152453], [75, 152573], [78, 152793], [83, 153431], [87, 153534], [91, 153674], [93, 153794], [98, 153994], [101, 154114], [105, 154234], [111, 154494], [115, 154794], [121, 155054], [124, 155234], [128, 155354]]}, {"verse": 23, "start": 156196, "end": 160404, "text": "And bring here the fatted calf, and kill it; and let us eat, and be merry:", "words": [[0, 156196], [4, 156322], [10, 156522], [15, 156722], [19, 156862], [26, 157182], [32, 157522], [36, 157962], [41, 158242], [45, 158843], [49, 158929], [53, 159069], [56, 159249], [61, 159529], [65, 159829], [68, 159989]]}, {"verse": 24, "start": 160854, "end": 166914, "text": "For this my son was dead, and is alive again; he was lost, and is found. And they began to be merry.", "words": [[0, 160854], [4, 160938], [9, 161158], [12, 161358], [16, 161618], [20, 161798], [26, 162098], [30, 162498], [33, 162618], [39, 162898], [46, 163685], [49, 163753], [53, 163933], [59, 164313], [63, 164533], [66, 164653], [73, 165504], [77, 165642], [82, 165762], [88, 166102], [91, 166262], [94, 166362]]}, {"verse": 25, "start": 167214, "end": 173940, "text": "Now his elder son was in the field: and as he came and drew near to the house, he heard music and dancing.", "words": [[0, 167214], [4, 167516], [8, 167796], [14, 168076], [18, 168436], [22, 168656], [25, 168796], [29, 168896], [36, 169722], [40, 170029], [43, 170309], [46, 170469], [51, 170749], [55, 170949], [60, 171149], [65, 171309], [68, 171449], [72, 171569], [79, 172169], [82, 172329], [88, 172549], [94, 172949], [98, 173269]]}, {"verse": 26, "start": 174390, "end": 178046, "text": "And he called one of the servants, and asked what these things meant.", "words": [[0, 174390], [4, 174526], [7, 174626], [14, 174926], [18, 175166], [21, 175266], [25, 175386], [35, 175726], [39, 176506], [45, 176786], [50, 176966], [56, 177206], [63, 177526]]}, {"verse": 27, "start": 178396, "end": 186400, "text": "And he said to him, Your brother is come; and your father has killed the fatted calf, because he has received him safe and sound.", "words": [[0, 178396], [4, 178562], [7, 178702], [12, 178982], [15, 179202], [20, 180579], [25, 180722], [33, 181022], [36, 181282], [42, 182065], [46, 182188], [51, 182288], [58, 182548], [62, 182788], [69, 183048], [73, 183228], [80, 183488], [86, 184108], [94, 184308], [97, 184568], [101, 184748], [110, 185128], [114, 185348], [119, 185668], [123, 185868]]}, {"verse": 28, "start": 186700, "end": 192402, "text": "And he was angry, and would not go in: therefore came his father out, and entreated him.", "words": [[0, 186700], [4, 186831], [7, 186971], [11, 187151], [18, 187631], [22, 188211], [28, 188411], [32, 188611], [35, 188871], [39, 189589], [49, 189926], [54, 190266], [58, 190486], [65, 190766], [70, 191146], [74, 191586], [84, 192026]]}, {"verse": 29, "start": 192752, "end": 203628, "text": "And he answering said to his father, Lo, these many years do I serve you, neither transgressed I at any time your commandment: and yet you never gave me a kid, that I might make merry with my friends:", "words": [[0, 192752], [4, 192912], [7, 193092], [17, 193632], [22, 193972], [25, 194172], [29, 194312], [37, 195347], [41, 195537], [47, 195537], [52, 195777], [58, 196017], [61, 196217], [63, 196357], [69, 196617], [74, 197177], [82, 197357], [95, 198177], [97, 198397], [100, 198597], [104, 198757], [109, 199037], [114, 199197], [127, 200146], [131, 200250], [135, 200390], [139, 200550], [145, 200770], [150, 201030], [153, 201210], [155, 201350], [160, 201590], [165, 201990], [167, 202110], [173, 202270], [178, 202510], [184, 202750], [189, 202930], [192, 203070]]}, {"verse": 30, "start": 204078, "end": 209729, "text": "But as soon as this your son was come, which has devoured your living with harlots, you have killed for him the fatted calf.", "words": [[0, 204078], [4, 204180], [7, 204300], [12, 204520], [15, 204640], [20, 204820], [25, 205060], [29, 205320], [33, 205500], [39, 205980], [45, 206160], [49, 206300], [58, 206760], [63, 206880], [70, 207140], [75, 207380], [84, 208060], [88, 208160], [93, 208280], [100, 208560], [104, 208780], [108, 208920], [112, 209060], [119, 209360]]}, {"verse": 31, "start": 210079, "end": 215183, "text": "And he said to him, Son, you are ever with me, and all that I have is yours.", "words": [[0, 210079], [4, 210213], [7, 210333], [12, 210573], [15, 210793], [20, 211433], [25, 212093], [29, 212654], [33, 212814], [38, 213074], [43, 213354], [47, 213574], [51, 213914], [55, 214054], [60, 214194], [62, 214314], [67, 214534], [70, 214654]]}, {"verse": 32, "start": 215633, "end": 222565, "text": "It was meet that we should make merry, and be glad: for this your brother was dead, and is alive again; and was lost, and is found.", "words": [[0, 215633], [3, 215752], [7, 215962], [12, 216172], [17, 216372], [20, 216512], [27, 216672], [32, 216892], [39, 217232], [43, 217572], [46, 217692], [52, 218479], [56, 218576], [61, 218796], [66, 218976], [74, 219216], [78, 219456], [84, 219716], [88, 220056], [91, 220176], [97, 220416], [104, 221197], [108, 221346], [112, 221506], [118, 221786], [122, 222066], [125, 222186]]}]}