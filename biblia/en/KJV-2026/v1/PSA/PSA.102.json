{"book": "PSA", "chapter": 102, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 151320, "verses": [{"verse": 1, "start": 300, "end": 3899, "text": "Hear my prayer, O LORD, and let my cry come to you.", "words": [[0, 300], [5, 467], [8, 727], [16, 1367], [18, 1487], [24, 2127], [28, 2227], [32, 2387], [35, 2607], [39, 3047], [44, 3367], [47, 3567]]}, {"verse": 2, "start": 4349, "end": 11967, "text": "Hide not your face from me in the day when I am in trouble; incline your ear to me: in the day when I call answer me speedily.", "words": [[0, 4349], [5, 4566], [9, 4826], [14, 5006], [19, 5306], [24, 5566], [27, 5766], [30, 5866], [34, 5986], [38, 6226], [43, 6426], [45, 6606], [48, 6706], [51, 6806], [60, 7670], [68, 8178], [73, 8358], [77, 8558], [80, 8778], [84, 9373], [87, 9546], [91, 9646], [95, 9906], [100, 10106], [102, 10266], [107, 10586], [114, 11066], [117, 11286]]}, {"verse": 3, "start": 12417, "end": 16910, "text": "For my days are consumed like smoke, and my bones are burned as a hearth.", "words": [[0, 12417], [4, 12536], [7, 12736], [12, 13036], [16, 13256], [25, 13776], [30, 14116], [37, 14736], [41, 15076], [44, 15236], [50, 15616], [54, 15816], [61, 16156], [64, 16376], [66, 16496]]}, {"verse": 4, "start": 17360, "end": 22138, "text": "My heart is stricken, and withered like grass; so that I forget to eat my bread.", "words": [[0, 17360], [3, 17486], [9, 17766], [12, 17926], [22, 18426], [26, 18686], [35, 19086], [40, 19286], [47, 20318], [50, 20458], [55, 20598], [57, 20698], [64, 20978], [67, 21198], [71, 21398], [74, 21598]]}, {"verse": 5, "start": 22588, "end": 26347, "text": "By reason of the voice of my groaning my bones cleave to my skin.", "words": [[0, 22588], [3, 22693], [10, 23013], [13, 23213], [17, 23333], [23, 23613], [26, 23833], [29, 23993], [38, 24533], [41, 24653], [47, 24993], [54, 25513], [57, 25633], [60, 25813]]}, {"verse": 6, "start": 26797, "end": 31007, "text": "I am like a pelican of the wilderness: I am like an owl of the desert.", "words": [[0, 26797], [2, 26921], [5, 27021], [10, 27181], [12, 27321], [20, 27781], [23, 27961], [27, 28081], [39, 29109], [41, 29322], [44, 29462], [49, 29662], [52, 29822], [56, 30142], [59, 30342], [63, 30462]]}, {"verse": 7, "start": 31457, "end": 34921, "text": "I watch, and am as a sparrow alone upon the house top.", "words": [[0, 31457], [2, 31607], [9, 31987], [13, 32167], [16, 32487], [19, 32687], [21, 32827], [29, 33307], [35, 33627], [40, 33887], [44, 34167], [50, 34367]]}, {"verse": 8, "start": 35371, "end": 41262, "text": "My enemies reproach me all the day; and they that are mad against me are sworn against me.", "words": [[0, 35371], [3, 35521], [11, 35901], [20, 36581], [23, 36741], [27, 37021], [31, 37201], [36, 37965], [40, 38124], [45, 38284], [50, 38484], [54, 38604], [58, 38924], [66, 39264], [69, 39624], [73, 40064], [79, 40404], [87, 40844]]}, {"verse": 9, "start": 41712, "end": 45911, "text": "For I have eaten ashes like bread, and mingled my drink with weeping,", "words": [[0, 41712], [4, 41818], [6, 41998], [11, 42178], [17, 42458], [23, 42918], [28, 43278], [35, 43678], [39, 44058], [47, 44538], [50, 44738], [56, 45058], [61, 45298]]}, {"verse": 10, "start": 46361, "end": 51927, "text": "Because of your indignation and your wrath: for you have lifted me up, and cast me down.", "words": [[0, 46361], [8, 46783], [11, 47003], [16, 47143], [28, 48003], [32, 48283], [37, 48443], [44, 49291], [48, 49399], [52, 49579], [57, 49799], [64, 50099], [67, 50359], [71, 50619], [75, 50859], [80, 51139], [83, 51379]]}, {"verse": 11, "start": 52377, "end": 56630, "text": "My days are like a shadow that declines; and I am withered like grass.", "words": [[0, 52377], [3, 52525], [8, 52785], [12, 52985], [17, 53165], [19, 53285], [26, 53645], [31, 53885], [41, 54991], [45, 55139], [47, 55319], [50, 55439], [59, 55779], [64, 55999]]}, {"verse": 12, "start": 57080, "end": 62113, "text": "But you, O LORD, shall endure for ever; and your remembrance to all generations.", "words": [[0, 57080], [4, 57203], [9, 57583], [11, 57663], [17, 58303], [23, 58463], [30, 58857], [34, 59251], [40, 59872], [44, 59993], [49, 60113], [61, 60593], [64, 60893], [68, 61133]]}, {"verse": 13, "start": 62563, "end": 68882, "text": "You shall arise, and have mercy upon Zion: for the time to favour her, yes, the set time, is come.", "words": [[0, 62563], [4, 62690], [10, 62910], [17, 63350], [21, 63610], [26, 63790], [32, 64190], [37, 64510], [43, 65584], [47, 65669], [51, 65789], [56, 66009], [59, 66239], [66, 66469], [71, 66849], [76, 67329], [80, 67429], [84, 67669], [90, 68009], [93, 68369]]}, {"verse": 14, "start": 69332, "end": 73489, "text": "For your servants take pleasure in her stones, and favour the dust of it.", "words": [[0, 69332], [4, 69464], [9, 69584], [18, 69984], [23, 70324], [32, 70764], [35, 71004], [39, 71164], [47, 71624], [51, 72074], [58, 72524], [62, 72744], [67, 73044], [70, 73224]]}, {"verse": 15, "start": 73939, "end": 79328, "text": "So the heathen shall fear the name of the LORD, and all the kings of the earth your glory.", "words": [[0, 73939], [3, 74277], [7, 74437], [15, 74897], [21, 75117], [26, 75457], [30, 75657], [35, 75937], [38, 76057], [42, 76197], [48, 76877], [52, 77077], [56, 77297], [60, 77457], [66, 77717], [69, 77957], [73, 78097], [79, 78357], [84, 78637]]}, {"verse": 16, "start": 79778, "end": 83254, "text": "When the LORD shall build up Zion, he shall appear in his glory.", "words": [[0, 79778], [5, 79884], [9, 80024], [14, 80244], [20, 80484], [26, 80784], [29, 80944], [35, 81724], [38, 81804], [44, 82004], [51, 82264], [54, 82544], [58, 82684]]}, {"verse": 17, "start": 83704, "end": 87613, "text": "He will regard the prayer of the destitute, and not despise their prayer.", "words": [[0, 83704], [3, 83818], [8, 83998], [15, 84398], [19, 84598], [26, 84918], [29, 85058], [33, 85178], [44, 85818], [48, 86078], [52, 86278], [60, 86958], [66, 87098]]}, {"verse": 18, "start": 88063, "end": 94303, "text": "This shall be written for the generation to come: and the people which shall be created shall praise the LORD.", "words": [[0, 88063], [5, 88193], [11, 88433], [14, 88613], [22, 88953], [26, 89193], [30, 89313], [41, 89873], [44, 90113], [50, 90976], [54, 91085], [58, 91205], [65, 91485], [71, 91745], [77, 92025], [80, 92205], [88, 92785], [94, 93105], [101, 93505], [105, 93785]]}, {"verse": 19, "start": 94753, "end": 100261, "text": "For he has looked down from the height of his sanctuary; from heaven did the LORD behold the earth;", "words": [[0, 94753], [4, 94856], [7, 95016], [11, 95176], [18, 95376], [23, 95696], [28, 95916], [32, 96116], [39, 96296], [42, 96436], [46, 96556], [57, 97772], [62, 97933], [69, 98353], [73, 98653], [77, 98853], [82, 99113], [89, 99513], [93, 99833]]}, {"verse": 20, "start": 100711, "end": 105109, "text": "To hear the groaning of the prisoner; to loose those that are appointed to death;", "words": [[0, 100711], [3, 100814], [8, 101014], [12, 101174], [21, 101654], [24, 101814], [28, 101934], [38, 102868], [41, 103031], [47, 103231], [53, 103551], [58, 103811], [62, 103971], [72, 104351], [75, 104611]]}, {"verse": 21, "start": 105559, "end": 110655, "text": "To declare the name of the LORD in Zion, and his praise in Jerusalem;", "words": [[0, 105559], [3, 105659], [11, 106039], [15, 106319], [20, 106659], [23, 106839], [27, 106999], [32, 107319], [35, 107519], [41, 107959], [45, 108839], [49, 109039], [56, 109459], [59, 109759]]}, {"verse": 22, "start": 111105, "end": 115448, "text": "When the people are gathered together, and the kingdoms, to serve the LORD.", "words": [[0, 111105], [5, 111252], [9, 111392], [16, 111672], [20, 111892], [29, 112292], [39, 112752], [43, 113252], [47, 113372], [57, 113772], [60, 114312], [66, 114652], [70, 114872]]}, {"verse": 23, "start": 115898, "end": 119659, "text": "He weakened my strength in the way; he shortened my days.", "words": [[0, 115898], [3, 116012], [12, 116392], [15, 116652], [24, 117092], [27, 117352], [31, 117452], [36, 118240], [39, 118321], [49, 118661], [52, 119041]]}, {"verse": 24, "start": 120109, "end": 126397, "text": "I said, O my God, take me not away in the midst of my days: your years are throughout all generations.", "words": [[0, 120109], [2, 120253], [8, 120443], [10, 120633], [13, 120833], [18, 121273], [23, 121373], [26, 121593], [30, 121793], [35, 122093], [38, 122253], [42, 122333], [48, 122573], [51, 122793], [54, 122993], [60, 123868], [65, 124015], [71, 124375], [75, 124635], [86, 124955], [90, 125355]]}, {"verse": 25, "start": 126847, "end": 131848, "text": "Of old have you laid the foundation of the earth: and the heavens are the work of your hands.", "words": [[0, 126847], [3, 126988], [7, 127288], [12, 127508], [16, 127628], [21, 127848], [25, 128028], [36, 128568], [39, 128848], [43, 128968], [50, 129772], [54, 129881], [58, 130001], [66, 130261], [70, 130521], [74, 130641], [79, 130881], [82, 131061], [87, 131181]]}, {"verse": 26, "start": 132298, "end": 141619, "text": "They shall perish, but you shall endure: yes, all of them shall grow old like a garment; as a vesture shall you change them, and they shall be changed:", "words": [[0, 132298], [5, 132400], [11, 132620], [19, 133080], [23, 133620], [27, 133800], [33, 134020], [41, 134943], [46, 135253], [50, 135433], [53, 135573], [58, 135773], [64, 136013], [69, 136293], [73, 136673], [78, 136913], [80, 137033], [89, 137958], [92, 138122], [94, 138242], [102, 138682], [108, 138942], [112, 139122], [119, 139442], [125, 140062], [129, 140262], [134, 140482], [140, 140742], [143, 140902]]}, {"verse": 27, "start": 142069, "end": 145530, "text": "But you are the same, and your years shall have no end.", "words": [[0, 142069], [4, 142329], [8, 142529], [12, 142689], [16, 142849], [22, 143489], [26, 143829], [31, 144029], [37, 144229], [43, 144509], [48, 144769], [51, 144989]]}, {"verse": 28, "start": 145980, "end": 150920, "text": "The children of your servants shall continue, and their seed shall be established before you.", "words": [[0, 145980], [4, 146099], [13, 146439], [16, 146639], [21, 146759], [30, 147199], [36, 147499], [46, 148399], [50, 148679], [56, 148819], [61, 149139], [67, 149399], [70, 149559], [82, 150099], [89, 150479]]}]}