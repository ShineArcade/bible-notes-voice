{"book": "PSA", "chapter": 22, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 210230, "verses": [{"verse": 1, "start": 300, "end": 12007, "text": "Al Músico principal, sobre Ajelet-sahar: Salmo de David. DIOS mío, Dios mío, ¿por qué me has dejado? ¿ por qué estás lejos de mi salvación, y de las palabras de mi clamor?", "words": [[0, 300], [3, 446], [10, 906], [21, 1546], [27, 2453], [41, 3551], [47, 4009], [50, 4169], [57, 4965], [62, 5253], [67, 5733], [72, 5873], [77, 6497], [82, 6637], [86, 6777], [89, 6917], [93, 7017], [101, 7939], [103, 7939], [107, 8060], [111, 8260], [117, 8500], [123, 9100], [126, 9260], [129, 9360], [140, 10080], [142, 10500], [145, 10600], [149, 10740], [158, 11080], [161, 11320], [164, 11664]]}, {"verse": 2, "start": 12357, "end": 18056, "text": "Dios mío, clamo de día, y no oyes; y de noche, y no hay para mí silencio.", "words": [[0, 12357], [5, 12582], [10, 13082], [16, 13442], [19, 13622], [24, 13942], [26, 14162], [29, 14342], [35, 15470], [37, 15611], [40, 15731], [47, 16071], [49, 16451], [52, 16631], [56, 16831], [61, 17071], [64, 17271]]}, {"verse": 3, "start": 18406, "end": 23192, "text": "Pero tú eres santo, tú que habitas entre las alabanzas de Israel.", "words": [[0, 18406], [5, 18568], [8, 18828], [13, 19048], [20, 19993], [23, 20313], [27, 20493], [35, 21093], [41, 21453], [45, 21733], [55, 22393], [58, 22493]]}, {"verse": 4, "start": 23542, "end": 28575, "text": "En ti esperaron nuestros padres: esperaron, y tú los libraste.", "words": [[0, 23542], [3, 23709], [6, 24049], [16, 24929], [25, 25169], [33, 26281], [44, 26925], [46, 27185], [49, 27445], [53, 28037]]}, {"verse": 5, "start": 28925, "end": 33932, "text": "Clamaron a ti, y fueron librados: confiaron en ti, y no se avergonzaron.", "words": [[0, 28925], [9, 29369], [11, 29509], [15, 29709], [17, 29889], [24, 30149], [34, 31357], [44, 31923], [47, 32113], [51, 32303], [53, 32563], [56, 32703], [59, 32883]]}, {"verse": 6, "start": 34282, "end": 40284, "text": "Mas yo soy gusano, y no hombre; deshonra de los hombres, y desecho del pueblo.", "words": [[0, 34333], [4, 34654], [7, 34914], [11, 35154], [19, 35814], [21, 36134], [24, 36314], [32, 37373], [41, 37723], [44, 37863], [48, 38003], [57, 38443], [59, 38963], [67, 39523], [71, 39643]]}, {"verse": 7, "start": 40634, "end": 47567, "text": "Todos los que me ven, escarnecen de mí; estiran los labios, menean la cabeza, diciendo:", "words": [[0, 40634], [6, 40878], [10, 41198], [14, 41398], [17, 41558], [22, 42248], [33, 42938], [36, 43138], [40, 43720], [48, 44130], [52, 44330], [60, 45370], [67, 45850], [70, 45990], [78, 46490]]}, {"verse": 8, "start": 47767, "end": 52595, "text": "Se encomienda a Jehová, líbrelo; sálvele, puesto que en él se complacía.", "words": [[0, 47767], [3, 47973], [14, 48263], [16, 48553], [24, 49293], [33, 50208], [42, 50788], [49, 51088], [53, 51328], [56, 51468], [59, 51588], [62, 51748]]}, {"verse": 9, "start": 52875, "end": 59575, "text": "Pero tú eres el que me sacó del vientre, el que me hizo estar confiado desde que estaba a los pechos de mi madre.", "words": [[0, 52875], [5, 53020], [8, 53240], [13, 53480], [16, 53660], [20, 53780], [23, 53920], [28, 54280], [32, 54420], [41, 55380], [44, 55640], [48, 55800], [51, 55940], [56, 56220], [62, 56480], [71, 57180], [77, 57400], [81, 57640], [88, 57940], [90, 58160], [94, 58280], [101, 58720], [104, 58860], [107, 58980]]}, {"verse": 10, "start": 59925, "end": 66433, "text": "Sobre ti fui echado desde la matriz: desde el vientre de mi madre, tú eres mi Dios.", "words": [[0, 59925], [6, 60168], [9, 60428], [13, 60628], [20, 61188], [26, 61708], [29, 61948], [37, 62888], [43, 63151], [46, 63391], [54, 63871], [57, 63971], [60, 64131], [67, 65111], [70, 65371], [75, 65591], [78, 65791]]}, {"verse": 11, "start": 66783, "end": 72328, "text": "No te alejes de mí, porque la angustia está cerca; porque no hay quien ayude.", "words": [[0, 66783], [3, 67063], [6, 67203], [13, 67623], [16, 67803], [20, 68303], [27, 68583], [30, 68763], [39, 69283], [44, 69443], [51, 70347], [58, 70732], [61, 70972], [65, 71152], [71, 71492]]}, {"verse": 12, "start": 72678, "end": 77417, "text": "Me han rodeado muchos toros; fuertes toros de Basán me han cercado.", "words": [[0, 72678], [3, 72805], [7, 72965], [15, 73585], [22, 73845], [29, 74869], [37, 75393], [43, 75833], [46, 75953], [52, 76353], [55, 76513], [59, 76613]]}, {"verse": 13, "start": 77767, "end": 82129, "text": "Abrieron sobre mí su boca, como león que arrebata y ruge.", "words": [[0, 77767], [9, 78291], [15, 78571], [18, 78811], [21, 78991], [27, 79851], [32, 80231], [37, 80671], [41, 80991], [50, 81311], [52, 81743]]}, {"verse": 14, "start": 82479, "end": 92216, "text": "Me he derramado como aguas, y todos mis huesos se descoyuntaron: mi corazón fue como cera, derritiéndose en medio de mis entrañas.", "words": [[0, 82479], [3, 82798], [6, 82938], [16, 83498], [21, 83738], [28, 84538], [30, 84818], [36, 85158], [40, 85718], [47, 86298], [50, 86518], [65, 87830], [68, 87976], [76, 88356], [80, 88656], [85, 88896], [91, 89716], [105, 90556], [108, 90696], [114, 90916], [117, 91116], [121, 91216]]}, {"verse": 15, "start": 92566, "end": 99712, "text": "Se secó como un tiesto mi vigor, y mi lengua se pegó a mi paladar; y me has puesto en el polvo de la muerte.", "words": [[0, 92566], [3, 92687], [8, 93127], [13, 93327], [16, 93467], [23, 94047], [26, 94167], [33, 94767], [35, 95007], [38, 95127], [45, 95607], [48, 95767], [53, 96167], [55, 96267], [58, 96718], [67, 97363], [69, 97488], [72, 97588], [76, 97728], [83, 98008], [86, 98268], [89, 98388], [95, 98868], [98, 98968], [101, 99088]]}, {"verse": 16, "start": 100062, "end": 106515, "text": "Porque perros me han rodeado, me ha cercado cuadrilla de malignos: horadaron mis manos y mis pies.", "words": [[0, 100062], [7, 100307], [14, 100987], [17, 101247], [21, 101367], [30, 102067], [33, 102127], [36, 102507], [44, 102887], [54, 103267], [57, 103407], [67, 104725], [77, 105055], [81, 105255], [87, 105615], [89, 105855], [93, 106015]]}, {"verse": 17, "start": 106865, "end": 111291, "text": "Contar puedo todos mis huesos; ellos miran, me observan.", "words": [[0, 106865], [7, 107306], [13, 107826], [19, 108306], [23, 108606], [31, 109493], [37, 109782], [44, 110242], [47, 110402]]}, {"verse": 18, "start": 111641, "end": 115963, "text": "Partieron entre sí mis vestidos, y sobre mi ropa echaron suertes.", "words": [[0, 111641], [10, 112340], [16, 112660], [19, 112960], [23, 113160], [33, 113760], [35, 113980], [41, 114220], [44, 114440], [49, 114820], [57, 115180]]}, {"verse": 19, "start": 116313, "end": 120832, "text": "Mas tú, Jehová, no te alejes; fortaleza mía, apresúrate para mi ayuda.", "words": [[0, 116313], [4, 116538], [8, 116763], [16, 116988], [19, 117213], [22, 117453], [30, 118364], [40, 118963], [45, 119403], [56, 119903], [61, 120143], [64, 120303]]}, {"verse": 20, "start": 121182, "end": 125141, "text": "Libra de la espada mi alma; del poder del perro mi única.", "words": [[0, 121182], [6, 121608], [9, 121708], [12, 121808], [19, 122288], [22, 122388], [28, 123152], [32, 123317], [38, 123617], [42, 123930], [48, 124244], [51, 124557]]}, {"verse": 21, "start": 125491, "end": 130565, "text": "Sálvame de la boca del león, y óyeme librándome de los cuernos de los búfalos.", "words": [[0, 125491], [8, 125958], [11, 126138], [14, 126238], [19, 126458], [23, 126698], [29, 127218], [31, 127758], [37, 128138], [48, 128818], [51, 128978], [55, 129118], [63, 129598], [66, 129698], [70, 129798]]}, {"verse": 22, "start": 130915, "end": 136067, "text": "Anunciaré tu nombre a mis hermanos: en medio de la congregación te alabaré.", "words": [[0, 130915], [10, 131552], [13, 131732], [20, 132032], [22, 132172], [26, 132272], [36, 133538], [39, 133919], [45, 134239], [48, 134419], [51, 134519], [64, 135299], [67, 135499]]}, {"verse": 23, "start": 136417, "end": 145443, "text": "Los que teméis a Jehová, alabadle; glorificadle, descendencia toda de Jacob; y temed de él, vosotros, descendencia toda de Israel.", "words": [[0, 136417], [4, 136547], [8, 136687], [15, 137027], [17, 137167], [25, 137835], [35, 139268], [49, 139898], [62, 140798], [67, 141038], [70, 141258], [77, 142068], [79, 142263], [85, 142493], [88, 142713], [92, 142833], [102, 143353], [115, 144233], [120, 144473], [123, 144733]]}, {"verse": 24, "start": 145793, "end": 156068, "text": "Porque no menospreció ni abominó la aflicción del pobre, ni de él escondió su rostro; sino que cuando clamó a él, le oyó.", "words": [[0, 145793], [7, 146015], [10, 146575], [22, 147135], [25, 147415], [33, 148315], [36, 148735], [46, 149455], [50, 149635], [57, 150095], [60, 150695], [63, 150895], [66, 151235], [75, 151875], [78, 152035], [86, 152921], [91, 153341], [95, 153541], [102, 154011], [108, 154481], [110, 154661], [114, 155157], [117, 155653]]}, {"verse": 25, "start": 156418, "end": 163123, "text": "De ti será mi alabanza en la grande congregación; mis votos pagaré delante de los que le temen.", "words": [[0, 156418], [3, 156585], [6, 156805], [11, 157085], [14, 157345], [23, 158145], [26, 158605], [29, 158765], [36, 159145], [50, 160643], [54, 160791], [60, 161131], [67, 161591], [75, 162011], [78, 162171], [82, 162311], [86, 162431], [89, 162551]]}, {"verse": 26, "start": 163473, "end": 170968, "text": "Comerán los pobres, y serán saciados: alabarán a Jehová los que le buscan: vivirá vuestro corazón para siempre.", "words": [[0, 163473], [8, 163837], [12, 163997], [20, 164517], [22, 164737], [28, 165077], [38, 166184], [47, 166836], [49, 167089], [56, 167343], [60, 167596], [64, 167696], [67, 167836], [75, 168721], [82, 169186], [90, 169486], [98, 169886], [103, 170226]]}, {"verse": 27, "start": 171318, "end": 180300, "text": "Se acordarán, y se volverán a Jehová todos los confines de la tierra; y se humillarán delante de ti todas las familias de las naciones.", "words": [[0, 171318], [3, 171481], [14, 172261], [16, 172461], [19, 172621], [28, 173161], [30, 173261], [37, 173681], [43, 173961], [47, 174301], [56, 174901], [59, 175061], [62, 175161], [70, 176121], [72, 176351], [75, 176491], [86, 177211], [94, 177631], [97, 177771], [100, 177991], [106, 178351], [110, 178671], [119, 179271], [122, 179371], [126, 179511]]}, {"verse": 28, "start": 180650, "end": 185451, "text": "Porque de Jehová es el reino; y él se enseñoreará de las naciones.", "words": [[0, 180650], [7, 180851], [10, 181031], [17, 181531], [20, 181751], [23, 181951], [30, 182845], [32, 183037], [35, 183177], [38, 183377], [50, 184257], [53, 184377], [57, 184537]]}, {"verse": 29, "start": 185801, "end": 198466, "text": "Comerán y adorarán todos los poderosos de la tierra: se postrarán delante de él todos los que descienden al polvo, si bien ninguno puede conservar la vida a su propia alma.", "words": [[0, 185801], [8, 186370], [10, 186810], [19, 187470], [25, 187770], [29, 188050], [39, 188610], [42, 188750], [45, 188850], [53, 189701], [56, 189845], [66, 190585], [74, 191065], [77, 191265], [80, 191465], [86, 191885], [90, 192585], [94, 192765], [105, 193325], [108, 193545], [115, 194365], [118, 194565], [123, 194865], [131, 195705], [137, 195945], [147, 196645], [150, 196805], [155, 197085], [157, 197345], [160, 197485], [167, 197865]]}, {"verse": 30, "start": 198816, "end": 204109, "text": "La posteridad le servirá; será ella contada por una generación de Jehová.", "words": [[0, 198816], [3, 198986], [14, 199906], [17, 200226], [26, 201192], [31, 201523], [36, 201663], [44, 202283], [48, 202523], [52, 202683], [63, 203343], [66, 203483]]}, {"verse": 31, "start": 204459, "end": 209830, "text": "Vendrán, y anunciarán al pueblo que nazca, su justicia que él hizo.", "words": [[0, 204459], [9, 205086], [11, 205646], [22, 206406], [25, 206526], [32, 206806], [36, 207126], [43, 207646], [46, 208106], [55, 208826], [59, 209026], [62, 209226]]}]}