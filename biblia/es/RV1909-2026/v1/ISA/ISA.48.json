{"book": "ISA", "chapter": 48, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 210718, "verses": [{"verse": 1, "start": 300, "end": 15918, "text": "Oid esto, casa de Jacob, que os llamáis del nombre de Israel, los que salieron de las aguas de Judá, los que juran en el nombre de Jehová, y hacen memoria del Dios de Israel, mas no en verdad ni en justicia:", "words": [[0, 300], [4, 743], [10, 1323], [15, 1503], [18, 1763], [25, 2563], [29, 2783], [32, 2963], [40, 3623], [44, 4003], [51, 4443], [54, 4703], [62, 5923], [66, 6103], [70, 6263], [79, 6703], [82, 6883], [86, 7043], [92, 7423], [95, 7523], [101, 8303], [105, 8383], [109, 8523], [115, 9063], [118, 9283], [121, 9443], [128, 9803], [131, 9983], [139, 10862], [141, 11022], [147, 11282], [155, 11902], [159, 12162], [164, 12502], [167, 12682], [175, 13582], [179, 13882], [182, 14002], [185, 14102], [192, 14482], [195, 14942], [198, 15102]]}, {"verse": 2, "start": 16368, "end": 24487, "text": "Porque de la santa ciudad se nombran, y en el Dios de Israel confían: su nombre, Jehová de los ejércitos.", "words": [[0, 16368], [7, 16589], [10, 16749], [13, 16889], [19, 17149], [26, 17729], [29, 17869], [38, 18629], [40, 19169], [43, 19309], [46, 19449], [51, 19709], [54, 19869], [61, 20269], [70, 21593], [73, 21751], [81, 22691], [88, 23251], [91, 23331], [95, 23491]]}, {"verse": 3, "start": 24787, "end": 32758, "text": "Lo que pasó, ya antes lo dije; y de mi boca salió; lo publiqué, lo hice rápidamente, y vino a ser.", "words": [[0, 24787], [3, 24909], [7, 25049], [13, 25369], [16, 25649], [22, 26249], [25, 26349], [31, 27413], [33, 27531], [36, 27651], [39, 27771], [44, 28031], [51, 29242], [54, 29348], [64, 30448], [67, 30548], [72, 30788], [85, 31588], [87, 31988], [92, 32188], [94, 32408]]}, {"verse": 4, "start": 33455, "end": 38914, "text": "Porque conozco que eres duro, y nervio de hierro tu cerviz, y tu frente de metal,", "words": [[0, 33455], [7, 33674], [15, 34274], [19, 34434], [24, 34654], [30, 35154], [32, 35374], [39, 35874], [42, 35994], [49, 36434], [52, 36734], [60, 37034], [62, 37614], [65, 37734], [72, 38034], [75, 38274]]}, {"verse": 5, "start": 39586, "end": 50916, "text": "Te lo dije ya hace días; antes que viniese te lo enseñé, porque no dijeses: Mi ídolo lo hizo, mis estatuas de escultura y de fundición mandaron estas cosas.", "words": [[0, 39586], [3, 39663], [6, 39783], [11, 40043], [14, 40363], [19, 40643], [25, 41794], [31, 42095], [35, 42315], [43, 42715], [46, 42895], [49, 43035], [57, 43575], [64, 43975], [67, 44445], [76, 45462], [79, 45666], [85, 45966], [88, 46146], [94, 46866], [98, 46966], [107, 47586], [110, 47686], [120, 48286], [122, 48466], [125, 48586], [135, 49166], [144, 49986], [150, 50206]]}, {"verse": 6, "start": 51591, "end": 60370, "text": "Lo oíste, lo viste todo; ¿y no lo anunciaréis vosotros? Ahora pues te he hecho oír nuevas y ocultas cosas que tú no sabías.", "words": [[0, 51591], [3, 51739], [10, 52379], [13, 52569], [19, 52759], [25, 53820], [28, 53946], [31, 54086], [34, 54226], [46, 54766], [56, 56086], [62, 56390], [67, 56650], [70, 56970], [73, 57150], [79, 57350], [83, 57550], [90, 57930], [92, 58170], [100, 58730], [106, 59030], [110, 59310], [113, 59550], [116, 59670]]}, {"verse": 7, "start": 61078, "end": 69693, "text": "Ahora han sido creadas, no en días pasados; ni antes de este día las habías oído, porque no digas: He aquí que yo lo sabía.", "words": [[0, 61078], [6, 61338], [10, 61538], [15, 61758], [24, 62358], [27, 62778], [30, 62958], [35, 63138], [44, 64482], [47, 64643], [53, 64963], [56, 65183], [61, 65363], [65, 65703], [69, 65863], [76, 66243], [82, 66623], [89, 66923], [92, 67183], [99, 68253], [102, 68333], [107, 68633], [111, 68873], [114, 69013], [117, 69133]]}, {"verse": 8, "start": 70393, "end": 83291, "text": "Sí, nunca lo habías oído, ni nunca lo habías conocido; ciertamente no se abrió antes tu oreja; porque sabía que desleal habías de desobedecer, por tanto te llamé rebelde desde el vientre.", "words": [[0, 70393], [4, 70639], [10, 70919], [13, 71179], [20, 71459], [26, 71839], [29, 72279], [35, 72599], [38, 72779], [45, 73039], [55, 74282], [67, 75002], [70, 75222], [73, 75382], [79, 75682], [85, 75902], [88, 76162], [95, 77167], [102, 77371], [108, 77871], [112, 78031], [120, 78651], [127, 79131], [130, 79351], [143, 80691], [147, 80851], [153, 81331], [156, 81431], [162, 81751], [170, 82291], [176, 82491], [179, 82711]]}, {"verse": 9, "start": 83968, "end": 89794, "text": "Por amor de mi nombre dilataré mi furor, y para alabanza mía te daré largas, para no talarte.", "words": [[0, 83968], [4, 84104], [9, 84344], [12, 84544], [15, 84664], [22, 85024], [31, 85604], [34, 85724], [41, 86244], [43, 86564], [48, 86784], [57, 87384], [61, 87724], [64, 87844], [69, 88124], [77, 88764], [82, 89107], [85, 89451]]}, {"verse": 10, "start": 90483, "end": 95941, "text": "He aquí te he purificado, y no como a plata; te he escogido en horno de aflicción.", "words": [[0, 90533], [3, 90623], [8, 91143], [11, 91243], [14, 91343], [26, 92103], [28, 92503], [31, 92643], [36, 92743], [38, 92843], [45, 94067], [48, 94191], [51, 94291], [60, 94751], [63, 94871], [69, 95151], [72, 95251]]}, {"verse": 11, "start": 96647, "end": 103496, "text": "Por mí, por amor de mí lo haré, para que no sea manchado mi nombre, y mi honra no la daré a otro.", "words": [[0, 96647], [4, 96806], [8, 97426], [12, 97646], [17, 97866], [20, 98066], [23, 98226], [26, 98386], [32, 99006], [37, 99206], [41, 99366], [44, 99486], [48, 99706], [57, 100246], [60, 100386], [68, 101006], [70, 101226], [73, 101386], [79, 101706], [82, 101866], [85, 102006], [90, 102346], [92, 102446]]}, {"verse": 12, "start": 104230, "end": 111560, "text": "Óyeme, Jacob, y tú, Israel, llamado de mí: Yo mismo, yo el primero, yo también el postrero.", "words": [[0, 104597], [7, 105003], [14, 105410], [16, 105550], [20, 106050], [28, 106790], [36, 107150], [39, 107450], [43, 108290], [46, 108420], [53, 108960], [56, 109120], [59, 109300], [68, 110240], [71, 110320], [79, 110620], [82, 110860]]}, {"verse": 13, "start": 112244, "end": 120057, "text": "Mi mano fundó también la tierra, y mi mano derecha midió los cielos con el palmo; al llamarlos yo, aparecieron juntamente.", "words": [[0, 112244], [3, 112361], [8, 112621], [14, 113021], [22, 113261], [25, 113521], [33, 114241], [35, 114301], [38, 114421], [43, 114661], [51, 115141], [57, 115561], [61, 115701], [68, 116141], [72, 116301], [75, 116461], [82, 117537], [85, 117617], [95, 118097], [99, 118557], [111, 119157]]}, {"verse": 14, "start": 120750, "end": 131486, "text": "Juntaos todos vosotros, y oíd. ¿Quién hay entre ellos que anuncie estas cosas? Jehová lo amó, el cual ejecutará su voluntad en Babilonia, y su brazo en los caldeos.", "words": [[0, 121003], [8, 121283], [14, 121563], [24, 122263], [26, 122563], [31, 123576], [38, 123776], [42, 123896], [48, 124156], [54, 124396], [58, 124666], [66, 124936], [72, 125256], [79, 126447], [86, 126846], [89, 126946], [94, 127586], [97, 127666], [102, 127846], [112, 128426], [115, 128566], [124, 129086], [127, 129166], [138, 129766], [140, 130166], [143, 130326], [149, 130666], [152, 130746], [156, 130866]]}, {"verse": 15, "start": 132220, "end": 137749, "text": "Yo, yo hablé, y le llamé, y le traje; por tanto será prosperado su camino.", "words": [[0, 132220], [4, 132836], [7, 132976], [14, 133496], [16, 133676], [19, 133776], [26, 134256], [28, 134476], [31, 134556], [38, 135668], [42, 135789], [48, 136049], [53, 136389], [64, 137009], [67, 137149]]}, {"verse": 16, "start": 138447, "end": 150982, "text": "Acercaos a mí, oíd esto; desde el principio no hablé en escondido; desde que la cosa se hizo, estuve allí: y ahora el Señor Jehová me envió, y su espíritu.", "words": [[0, 138447], [9, 139133], [11, 139253], [15, 139633], [19, 139913], [25, 140949], [31, 141152], [34, 141312], [44, 141752], [47, 141972], [53, 142312], [56, 142392], [67, 144254], [73, 144476], [77, 144716], [80, 144856], [85, 145156], [88, 145396], [94, 145996], [101, 146376], [107, 147434], [109, 147580], [115, 147780], [118, 147980], [124, 148220], [131, 148760], [134, 148900], [141, 149380], [143, 150100], [146, 150240]]}, {"verse": 17, "start": 151432, "end": 162105, "text": "Así ha dicho Jehová, Redentor tuyo, el Santo de Israel: Yo Jehová Dios tuyo, que te enseña provechosamente, que te encamina por el camino que andas.", "words": [[0, 151432], [4, 151735], [7, 151875], [13, 152115], [21, 152615], [30, 153235], [36, 154195], [39, 154315], [45, 154895], [48, 155404], [56, 156163], [59, 156405], [66, 156925], [71, 157105], [77, 157745], [81, 158185], [84, 158325], [91, 158725], [108, 159545], [112, 160105], [115, 160245], [124, 160705], [128, 160885], [131, 160985], [138, 161225], [142, 161525]]}, {"verse": 18, "start": 162782, "end": 171171, "text": "¡Ojalá miraras tú a mis mandamientos! sería entonces tu paz como un río, y tu justicia como las ondas del mar.", "words": [[0, 162782], [7, 163582], [15, 164002], [18, 164242], [20, 164382], [24, 164482], [38, 165886], [44, 166311], [53, 166731], [56, 167111], [60, 167391], [65, 167671], [68, 167851], [73, 168611], [75, 168771], [78, 168911], [87, 169511], [92, 169751], [96, 169951], [102, 170451], [106, 170671]]}, {"verse": 19, "start": 171855, "end": 182376, "text": "Sería como la arena tu descendencia, y los renuevos de tus entrañas como las pedrezuelas de ella; nunca su nombre sería cortado, ni raído de mi presencia.", "words": [[0, 171855], [6, 172241], [11, 172461], [14, 172641], [20, 172921], [23, 173121], [37, 173961], [39, 174321], [43, 174461], [52, 175081], [55, 175241], [59, 175381], [68, 176041], [73, 176341], [77, 176811], [89, 177281], [92, 177441], [98, 178379], [104, 178806], [107, 178986], [114, 179286], [120, 179646], [129, 180566], [132, 180946], [138, 181326], [141, 181446], [144, 181546]]}, {"verse": 20, "start": 183061, "end": 196664, "text": "Salid de Babilonia, huid de entre los caldeos; dad nuevas de esto con voz de alegría, publicadlo, llevadlo hasta lo postrero de la tierra: decid: Redimió Jehová a Jacob su siervo.", "words": [[0, 183061], [6, 183479], [9, 183599], [20, 184559], [25, 184899], [28, 185059], [34, 185239], [38, 185419], [47, 186763], [51, 186947], [58, 187307], [61, 187607], [66, 187847], [70, 188047], [74, 188327], [77, 188487], [86, 189287], [98, 190407], [107, 190947], [113, 191227], [116, 191367], [125, 191867], [128, 191987], [131, 192107], [139, 193498], [146, 194279], [154, 194764], [161, 195304], [163, 195464], [169, 195964], [172, 196064]]}, {"verse": 21, "start": 197245, "end": 206515, "text": "Y no tuvieron sed cuando los llevó por los desiertos; les hizo correr agua de la piedra; cortó la peña, y corrieron aguas.", "words": [[0, 197245], [2, 197373], [5, 197513], [14, 197973], [18, 198353], [25, 198673], [29, 198993], [35, 199413], [39, 199553], [43, 199673], [54, 200993], [58, 201158], [63, 201578], [70, 202058], [75, 202458], [78, 202618], [81, 202738], [89, 203676], [95, 204100], [98, 204220], [104, 204740], [106, 205160], [116, 205720]]}, {"verse": 22, "start": 206815, "end": 210318, "text": "No hay paz para los malos, dijo Jehová.", "words": [[0, 206815], [3, 206974], [7, 207074], [11, 207374], [16, 207654], [20, 207814], [27, 209327], [32, 209837]]}]}