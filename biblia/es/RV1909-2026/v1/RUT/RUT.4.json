{"book": "RUT", "chapter": 4, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 208634, "verses": [{"verse": 1, "start": 300, "end": 12415, "text": "Y Booz subió a la puerta y se sentó allí: y he aquí pasaba aquel pariente del cual había Booz hablado, y le dijo: Eh, fulano, ven acá y siéntate. Y él vino, y se sentó.", "words": [[0, 300], [2, 471], [7, 681], [13, 1601], [15, 1741], [18, 1821], [25, 2081], [27, 2361], [30, 2481], [36, 2901], [42, 3355], [44, 3505], [47, 3655], [52, 3935], [59, 4515], [65, 4815], [74, 5315], [78, 5575], [83, 5795], [89, 6105], [94, 6415], [103, 7115], [105, 7215], [108, 7315], [114, 7969], [118, 8234], [126, 9094], [130, 9214], [134, 9494], [136, 9734], [146, 10644], [148, 10828], [151, 10968], [157, 11308], [159, 11592], [162, 11732]]}, {"verse": 2, "start": 12765, "end": 20660, "text": "Entonces él tomó diez varones de los ancianos de la ciudad, y dijo: Sentaos aquí. Y ellos se sentaron.", "words": [[0, 12765], [9, 13385], [12, 13985], [17, 14305], [22, 14625], [30, 15265], [33, 15445], [37, 15565], [46, 16245], [49, 16365], [52, 16465], [60, 16825], [62, 17205], [68, 17850], [76, 18292], [82, 18984], [84, 19187], [90, 19507], [93, 19807]]}, {"verse": 3, "start": 21010, "end": 28684, "text": "Luego dijo al pariente: Noemí, que ha vuelto del campo de Moab, vende una parte de las tierras que tuvo nuestro hermano Elimelec;", "words": [[0, 21010], [6, 21406], [11, 21726], [14, 21906], [24, 22802], [31, 23264], [35, 23304], [38, 23424], [45, 23764], [49, 23924], [55, 24244], [58, 24444], [64, 25014], [70, 25584], [74, 25704], [80, 25984], [83, 26164], [87, 26324], [95, 26724], [99, 26904], [104, 27104], [112, 27344], [120, 28034]]}, {"verse": 4, "start": 29034, "end": 48090, "text": "Y yo decidí hacértelo saber, y decirte que la compres delante de los que están aquí sentados, y delante de los ancianos de mi pueblo. Si tú quieres redimir, redime; y si no quieres redimir, decláramelo para que yo lo sepa: porque no hay otro que redima sino tú, y yo después de ti. Y él respondió: Yo redimiré.", "words": [[0, 29034], [2, 29150], [5, 29310], [12, 29830], [22, 30330], [29, 30730], [31, 31210], [39, 31770], [43, 31910], [46, 32210], [54, 32510], [62, 32930], [65, 33090], [69, 33230], [73, 33410], [79, 33650], [84, 33890], [94, 34570], [96, 35010], [104, 35430], [107, 35590], [111, 35730], [120, 36270], [123, 36430], [126, 36550], [134, 37283], [137, 37422], [140, 37582], [148, 37862], [157, 38782], [165, 39608], [167, 39696], [170, 39796], [173, 39916], [181, 40376], [190, 40836], [202, 41376], [207, 41596], [211, 41736], [214, 41856], [217, 41956], [223, 42648], [230, 42812], [233, 42972], [237, 43112], [242, 43292], [246, 43612], [253, 43932], [258, 44072], [262, 44392], [264, 44812], [267, 44912], [275, 45172], [278, 45452], [282, 45992], [284, 46174], [287, 46314], [298, 47556], [301, 47846]]}, {"verse": 5, "start": 48370, "end": 60872, "text": "Entonces replicó Booz: El mismo día que compres las tierras de mano de Noemí, has de tomar también a Ruth moabita, mujer del difunto, para que restaures el nombre del muerto sobre su posesión.", "words": [[0, 48370], [9, 48910], [17, 49784], [23, 50801], [26, 50925], [32, 51145], [36, 51405], [40, 51565], [48, 51945], [52, 52085], [60, 52445], [63, 52605], [68, 52805], [71, 52965], [78, 53495], [82, 54025], [85, 54145], [91, 54425], [99, 54765], [101, 55105], [106, 55445], [115, 56485], [121, 56745], [125, 56985], [134, 57855], [139, 58003], [143, 58143], [153, 58683], [156, 58863], [163, 59143], [167, 59303], [174, 59703], [180, 59943], [183, 60123]]}, {"verse": 6, "start": 61152, "end": 70058, "text": "Y respondió el pariente: No puedo redimir por mi parte, porque echaría a perder mi heredad: redime tú usando de mi derecho, porque yo no podré redimir.", "words": [[0, 61152], [2, 61507], [12, 61897], [15, 62017], [25, 63069], [28, 63212], [34, 63452], [42, 63912], [46, 64112], [49, 64272], [56, 64912], [63, 65072], [71, 65552], [73, 65592], [80, 65812], [83, 66052], [92, 66747], [99, 67114], [102, 67374], [109, 67754], [112, 67994], [115, 68074], [124, 68474], [131, 68794], [134, 68974], [137, 69074], [143, 69414]]}, {"verse": 7, "start": 70338, "end": 85077, "text": "Había ya de largo tiempo esta costumbre en Israel en la redención o contrato, que para la confirmación de cualquier negocio, el uno se quitaba el zapato y lo daba a su compañero: y este era el testimonio en Israel.", "words": [[0, 70338], [6, 70681], [9, 70901], [12, 71021], [18, 71261], [25, 71701], [30, 72001], [40, 72701], [43, 72861], [50, 73281], [53, 73701], [56, 73901], [66, 74581], [68, 74841], [78, 75541], [82, 75981], [87, 76201], [90, 76361], [103, 77201], [106, 77401], [116, 77641], [125, 79036], [128, 79200], [132, 79380], [135, 79560], [143, 80020], [146, 80360], [153, 80700], [155, 80800], [158, 80920], [163, 81220], [165, 81280], [168, 81420], [179, 82599], [181, 82764], [186, 83024], [190, 83324], [193, 83504], [204, 84144], [207, 84264]]}, {"verse": 8, "start": 85427, "end": 91109, "text": "Entonces el pariente dijo a Booz: Tómalo tú. Y descalzó su zapato.", "words": [[0, 85427], [9, 85933], [12, 86253], [21, 86753], [26, 87113], [28, 87551], [34, 88190], [41, 88676], [45, 89287], [47, 89431], [56, 90231], [59, 90371]]}, {"verse": 9, "start": 91459, "end": 103369, "text": "Y Booz dijo a los ancianos y a todo el pueblo: Vosotros sois hoy testigos de que he adquirido todas las cosas que fueron de Elimelec, y todo lo que fue de Quelión y de Mahlón, de mano de Noemí;", "words": [[0, 91459], [2, 91949], [7, 92469], [12, 92689], [14, 92829], [18, 92929], [27, 93569], [29, 93729], [31, 93789], [36, 94009], [39, 94189], [47, 95003], [56, 95306], [61, 95646], [65, 95986], [74, 96586], [77, 96826], [81, 96966], [84, 97086], [94, 97626], [100, 97886], [104, 98206], [110, 98526], [114, 98766], [121, 99026], [124, 99472], [134, 99918], [136, 100001], [141, 100221], [144, 100421], [148, 100561], [152, 100761], [155, 101061], [163, 101361], [165, 101461], [168, 101751], [176, 102041], [179, 102421], [184, 102641], [187, 102821]]}, {"verse": 10, "start": 103719, "end": 117801, "text": "Y que también tomo por mi mujer a Ruth moabita, mujer de Mahlón, para restaurar el nombre del difunto sobre su heredad, para que el nombre del muerto no se borre de entre sus hermanos y de la puerta de su lugar. Vosotros sois hoy testigos.", "words": [[0, 103719], [2, 103808], [6, 103888], [14, 104208], [19, 104628], [23, 104788], [26, 104908], [32, 105308], [34, 105708], [39, 106108], [48, 106508], [54, 106768], [57, 107148], [65, 107528], [70, 107928], [80, 108528], [83, 108628], [90, 108888], [94, 109088], [102, 109608], [108, 109868], [111, 110088], [120, 110875], [125, 111014], [129, 111194], [132, 111314], [139, 111574], [143, 111754], [150, 112174], [153, 112394], [156, 112574], [162, 112994], [165, 113114], [171, 113334], [175, 113534], [184, 114214], [186, 114354], [189, 114454], [192, 114554], [199, 114854], [202, 115054], [205, 115194], [212, 115862], [221, 116383], [226, 116803], [230, 117003]]}, {"verse": 11, "start": 118081, "end": 134714, "text": "Y dijeron todos los del pueblo que estaban a la puerta con los ancianos: Testigos somos. Jehová haga a la mujer que entra en tu casa como a Raquel y a Lea, las cuales dos edificaron la casa de Israel; y tú seas ilustre en Efrata, y seas de renombre en Belén;", "words": [[0, 118081], [2, 118182], [10, 118682], [16, 118982], [20, 119262], [24, 119442], [31, 119802], [35, 120042], [43, 120322], [45, 120522], [48, 120602], [55, 120862], [59, 121142], [63, 121302], [73, 123276], [82, 123486], [89, 124317], [96, 124786], [101, 125026], [103, 125166], [106, 125246], [112, 125526], [116, 125766], [122, 126006], [125, 126166], [128, 126286], [133, 126586], [138, 126906], [140, 127046], [147, 127386], [149, 127546], [151, 127606], [156, 128326], [160, 128426], [167, 128686], [171, 128986], [182, 129746], [185, 129886], [190, 130146], [193, 130326], [201, 131117], [203, 131242], [206, 131362], [211, 131602], [219, 131969], [222, 132335], [230, 132702], [232, 133102], [237, 133422], [240, 133602], [249, 134122], [252, 134242]]}, {"verse": 12, "start": 135064, "end": 141439, "text": "Y de la simiente que Jehová te dé de esta moza, sea tu casa como la de Fares, el hijo que Tamar dio a Judá.", "words": [[0, 135064], [2, 135173], [5, 135273], [8, 135393], [17, 135833], [21, 135993], [28, 136413], [31, 136493], [34, 136673], [37, 136773], [42, 136993], [48, 137793], [52, 138033], [55, 138233], [60, 138513], [65, 138813], [68, 138953], [71, 139053], [78, 139853], [81, 140013], [86, 140213], [90, 140373], [96, 140733], [100, 140913], [102, 141073]]}, {"verse": 13, "start": 141719, "end": 150678, "text": "Booz pues tomó a Ruth, y ella fue su mujer; y luego que se unió a ella, Jehová le dio que concibiese y pariese un hijo.", "words": [[0, 141982], [5, 142282], [10, 142682], [15, 142962], [17, 143102], [23, 143942], [25, 144062], [30, 144242], [34, 144482], [37, 144662], [44, 145523], [46, 145629], [52, 145849], [56, 146109], [59, 146289], [64, 146729], [66, 146889], [72, 147569], [79, 148009], [82, 148109], [86, 148309], [90, 148469], [101, 149169], [103, 149329], [111, 149809], [114, 150189]]}, {"verse": 14, "start": 151028, "end": 159943, "text": "Y las mujeres decían a Noemí: Alabado sea Jehová, que hizo que no te faltase hoy pariente, cuyo nombre será celebrado en Israel.", "words": [[0, 151028], [2, 151111], [6, 151231], [14, 151651], [21, 152551], [23, 152791], [30, 153547], [38, 154047], [42, 154287], [50, 154807], [54, 154987], [59, 155267], [63, 155447], [66, 155607], [69, 155727], [77, 156267], [81, 156447], [91, 157287], [96, 157787], [103, 158127], [108, 158487], [118, 159127], [121, 159267]]}, {"verse": 15, "start": 160293, "end": 168957, "text": "El cual será restaurador de tu alma, y el que sustentará tu vejez; pues que tu nuera, la cual te ama y te vale más que siete hijos, le ha parido.", "words": [[0, 160293], [3, 160437], [8, 160637], [13, 161147], [25, 161657], [28, 161777], [31, 161937], [37, 162257], [39, 162617], [42, 162697], [46, 162797], [57, 163477], [60, 163637], [67, 164387], [72, 164564], [76, 164684], [79, 165094], [86, 165504], [89, 165604], [94, 165784], [97, 166044], [101, 166264], [103, 166484], [106, 166624], [111, 166824], [115, 167064], [119, 167224], [125, 167484], [132, 168184], [135, 168304], [138, 168444]]}, {"verse": 16, "start": 169237, "end": 173256, "text": "Y tomando Noemí el hijo, lo puso en su regazo, y lo crio.", "words": [[0, 169237], [2, 169339], [10, 169819], [16, 170319], [19, 170479], [25, 170779], [28, 171139], [33, 171499], [36, 171599], [39, 171759], [47, 172359], [49, 172574], [52, 172714]]}, {"verse": 17, "start": 173476, "end": 183902, "text": "Y las vecinas diciendo, A Noemí ha nacido un hijo, le pusieron nombre; y le llamaron Obed. Este es padre de Isaí, padre de David.", "words": [[0, 173476], [2, 173603], [6, 173803], [14, 174323], [24, 175423], [26, 175663], [32, 176043], [35, 176403], [42, 176863], [45, 177083], [51, 177843], [54, 177943], [63, 178443], [71, 179349], [73, 179493], [76, 179593], [85, 180132], [91, 180952], [96, 181201], [99, 181341], [105, 181701], [108, 181841], [114, 182661], [120, 183221], [123, 183321]]}, {"verse": 18, "start": 184252, "end": 189204, "text": "Y estas son las generaciones de Fares: Fares engendró a Hezrón;", "words": [[0, 184252], [2, 184353], [8, 184533], [12, 184833], [16, 185033], [29, 185753], [32, 185933], [39, 186781], [45, 187385], [54, 188185], [56, 188694]]}, {"verse": 19, "start": 189554, "end": 194632, "text": "Y Hezrón engendró a Ram, y Ram engendró a Aminadab;", "words": [[0, 189554], [2, 190087], [9, 190621], [18, 191154], [20, 191674], [25, 192194], [27, 192661], [31, 193127], [40, 193594], [42, 193754]]}, {"verse": 20, "start": 194982, "end": 200194, "text": "Y Aminadab engendró a Naasón, y Naasón engendró a Salmón;", "words": [[0, 194982], [2, 195339], [11, 195729], [20, 196409], [22, 196879], [30, 197349], [32, 197949], [39, 198549], [48, 199249], [50, 199429]]}, {"verse": 21, "start": 200194, "end": 204298, "text": "Y Salmón engendró a Booz, y Booz engendró a Obed;", "words": [[0, 200194], [2, 200414], [9, 200934], [18, 201594], [20, 201915], [26, 202236], [28, 202513], [33, 202789], [42, 203509], [44, 203649]]}, {"verse": 22, "start": 204648, "end": 208234, "text": "Y Obed engendró a Isaí, e Isaí engendró a David.", "words": [[0, 204763], [2, 204909], [7, 205056], [16, 205796], [18, 205916], [24, 206246], [26, 206576], [31, 207236], [40, 207756], [42, 207856]]}]}