{"book": "PSA", "chapter": 135, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 123645, "verses": [{"verse": 1, "start": 300, "end": 5831, "text": "Aleluya. ALABAD el nombre de Jehová; alabadle, siervos de Jehová;", "words": [[0, 709], [9, 1495], [16, 1695], [19, 1895], [26, 2255], [29, 2435], [37, 3544], [47, 3934], [55, 4874], [58, 5154]]}, {"verse": 2, "start": 6181, "end": 11231, "text": "Los que estáis en la casa de Jehová, en los atrios de la casa de nuestro Dios.", "words": [[0, 6181], [4, 6289], [8, 6429], [15, 6809], [18, 6949], [21, 7069], [26, 7329], [29, 7549], [37, 8329], [40, 8549], [44, 8689], [51, 9329], [54, 9669], [57, 9789], [62, 10069], [65, 10289], [73, 10469]]}, {"verse": 3, "start": 11581, "end": 18538, "text": "Alabad a JAH, porque es bueno Jehová: cantad salmos a su nombre, porque es agradable.", "words": [[0, 11884], [7, 12229], [9, 12574], [14, 12919], [21, 13139], [24, 13419], [30, 13950], [38, 14680], [45, 15285], [52, 15885], [54, 16025], [57, 16185], [65, 16605], [72, 17045], [75, 17445]]}, {"verse": 4, "start": 18888, "end": 24350, "text": "Porque JAH ha escogido a Jacob para sí, a Israel por posesión suya.", "words": [[0, 18888], [7, 19362], [11, 19872], [14, 20092], [23, 20732], [25, 20872], [31, 21172], [36, 21672], [40, 21992], [42, 22372], [49, 22832], [53, 23092], [62, 23752]]}, {"verse": 5, "start": 24700, "end": 30474, "text": "Porque yo sé que Jehová es grande, y el Señor nuestro, mayor que todos los dioses.", "words": [[0, 24700], [7, 24924], [10, 25164], [13, 25364], [17, 25524], [24, 25964], [27, 26064], [35, 26544], [37, 27244], [40, 27384], [46, 27744], [55, 28304], [61, 28804], [65, 29064], [71, 29384], [75, 29664]]}, {"verse": 6, "start": 30824, "end": 37290, "text": "Todo lo que quiso Jehová, ha hecho en los cielos y en la tierra, en las mares y en todos los abismos.", "words": [[0, 30824], [5, 30987], [8, 31267], [12, 31407], [18, 31727], [26, 32267], [29, 32387], [35, 32627], [3