{"book": "GEN", "chapter": 18, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 269188, "verses": [{"verse": 1, "start": 300, "end": 6192, "text": "And the LORD appeared to him in the plains of Mamre: and he sat in the tent door in the heat of the day;", "words": [[0, 300], [4, 422], [8, 562], [13, 782], [22, 1102], [25, 1382], [29, 1562], [32, 1802], [36, 1922], [43, 2282], [46, 2522], [53, 3501], [57, 3629], [60, 3749], [64, 3989], [67, 4229], [71, 4329], [76, 4569], [81, 4889], [84, 5149], [88, 5289], [93, 5489], [96, 5609], [100, 5729]]}, {"verse": 2, "start": 6642, "end": 17238, "text": "And he lift up his eyes and looked, and, lo, three men stood by him: and when he saw them, he ran to meet them from the tent door, and bowed himself toward the ground,", "words": [[0, 6642], [4, 6765], [7, 6885], [12, 7065], [15, 7305], [19, 7465], [24, 7785], [28, 7985], [36, 8725], [41, 8925], [45, 9545], [51, 9825], [55, 10145], [61, 10425], [64, 10745], [69, 11393], [73, 11555], [78, 11695], [81, 11895], [85, 12175], [91, 12755], [94, 12895], [98, 13155], [101, 13375], [106, 13555], [111, 13855], [116, 14075], [120, 14255], [125, 14495], [131, 14835], [135, 15375], [141, 15735], [149, 15955], [156, 16435], [160, 16675]]}, {"verse": 3, "start": 17688, "end": 22923, "text": "And said, My Lord, if now I have found favour in your sight, pass not away, please, from your servant:", "words": [[0, 17688], [4, 18037], [10, 18605], [13, 18725], [19, 19045], [22, 19065], [26, 19245], [28, 19425], [33, 19525], [39, 19745], [46, 19965], [49, 20185], [54, 20265], [61, 20745], [66, 20925], [70, 21145], [76, 21525], [84, 22145], [89, 22225], [94, 22365]]}, {"verse": 4, "start": 23373, "end": 27740, "text": "Let a little water, please, be fetched, and wash your feet, and rest yourselves under the tree:", "words": [[0, 23373], [4, 23536], [6, 23656], [13, 23796], [20, 24156], [28, 24476], [31, 24736], [40, 25276], [44, 25396], [49, 25656], [54, 25776], [60, 25996], [64, 26296], [69, 26536], [80, 26876], [86, 27196], [90, 27376]]}, {"verse": 5, "start": 28090, "end": 37959, "text": "And I will fetch a morsel of bread, and comfort your hearts; after that you shall pass on: for therefore are you come to your servant. And they said, So do, as you have said.", "words": [[0, 28090], [4, 28214], [6, 28334], [11, 28494], [17, 28714], [19, 28874], [26, 29254], [29, 29414], [36, 29734], [40, 30034], [48, 30354], [53, 30574], [61, 31436], [67, 31657], [72, 32017], [76, 32137], [82, 32297], [87, 32517], [91, 33321], [95, 33615], [105, 33955], [109, 34215], [113, 34335], [118, 34555], [121, 34715], [126, 34815], [135, 35679], [139, 35824], [144, 35944], [150, 36244], [153, 36504], [157, 37124], [160, 37244], [164, 37404], [169, 37524]]}, {"verse": 6, "start": 38409, "end": 46168, "text": "And Abraham hastened into the tent to Sarah, and said, Make ready quickly three measures of fine meal, knead it, and make cakes upon the hearth.", "words": [[0, 38409], [4, 38754], [12, 39154], [21, 39794], [26, 39994], [30, 40154], [35, 40374], [38, 40574], [45, 40894], [49, 41174], [55, 41927], [60, 42087], [66, 42347], [74, 42687], [80, 42987], [89, 43267], [92, 43487], [97, 43707], [103, 44247], [109, 44447], [113, 44627], [117, 44987], [122, 45127], [128, 45407], [133, 45687], [137, 45887]]}, {"verse": 7, "start": 46518, "end": 53832, "text": "And Abraham ran to the herd, and fetched a calf tender and good, and gave it to a young man; and he hasted to dress it.", "words": [[0, 46518], [4, 46619], [12, 47079], [16, 47559], [19, 47759], [23, 47879], [29, 48199], [33, 48739], [41, 49159], [43, 49219], [48, 49519], [55, 49879], [59, 50159], [65, 50459], [69, 50959], [74, 51179], [77, 51319], [80, 51459], [82, 51579], [88, 51779], [93, 52629], [97, 52774], [100, 52874], [107, 53214], [110, 53354], [116, 53574]]}, {"verse": 8, "start": 54282, "end": 62538, "text": "And he took butter, and milk, and the calf which he had dressed, and set it before them; and he stood by them under the tree, and they did eat.", "words": [[0, 54282], [4, 54410], [7, 54510], [12, 54690], [20, 55090], [24, 55570], [30, 55870], [34, 56410], [38, 56530], [43, 56790], [49, 57050], [52, 57210], [56, 57370], [65, 57670], [69, 58040], [73, 58410], [76, 58530], [83, 58790], [89, 59516], [93, 59645], [96, 59785], [102, 60005], [105, 60265], [110, 60465], [116, 60685], [120, 60865], [126, 61505], [130, 61685], [135, 61825], [139, 62045]]}, {"verse": 9, "start": 62988, "end": 68356, "text": "¶ And they said to him, Where is Sarah your wife? And he said, Behold, in the tent.", "words": [[2, 62988], [6, 63143], [11, 63263], [16, 63503], [19, 63703], [24, 64303], [30, 64603], [33, 64883], [39, 65343], [44, 65443], [50, 66388], [54, 66534], [57, 66654], [63, 66934], [71, 67594], [74, 67794], [78, 67914]]}, {"verse": 10, "start": 68806, "end": 79808, "text": "And he said, I will certainly return to you according to the time of life; and, lo, Sarah your wife shall have a son. And Sarah heard it in the tent door, which was behind him.", "words": [[0, 68806], [4, 68950], [7, 69070], [13, 69350], [15, 69550], [20, 69730], [30, 70170], [37, 70650], [40, 70930], [44, 71090], [54, 71470], [57, 71850], [61, 71950], [66, 72270], [69, 72410], [75, 73258], [80, 73405], [84, 74045], [90, 74665], [95, 74805], [100, 75105], [106, 75425], [111, 75665], [113, 75765], [118, 76595], [122, 76719], [128, 77059], [134, 77399], [137, 77579], [140, 77779], [144, 77879], [149, 78119], [155, 78459], [161, 78779], [165, 78979], [172, 79359]]}, {"verse": 11, "start": 80258, "end": 87140, "text": "Now Abraham and Sarah were old and well stricken in age; and it ceased to be with Sarah after the manner of women.", "words": [[0, 80258], [4, 80443], [12, 80963], [16, 81303], [22, 81603], [27, 81863], [31, 82283], [35, 82523], [40, 82743], [49, 83243], [52, 83403], [57, 84274], [61, 84403], [64, 84503], [71, 84743], [74, 85003], [77, 85103], [82, 85303], [88, 85643], [94, 86043], [98, 86223], [105, 86503], [108, 86703]]}, {"verse": 12, "start": 87590, "end": 95888, "text": "Therefore Sarah laughed within herself, saying, After I have grown old shall I have pleasure, my lord being old also?", "words": [[0, 87590], [10, 88100], [16, 88320], [24, 88720], [31, 89020], [40, 89680], [48, 91035], [54, 91315], [56, 91595], [61, 91795], [67, 92095], [71, 92795], [77, 92935], [79, 93135], [84, 93295], [94, 94155], [97, 94275], [102, 94515], [108, 94835], [112, 95235]]}, {"verse": 13, "start": 96238, "end": 103045, "text": "And the LORD said to Abraham, Why did Sarah laugh, saying, Shall I of a surety bear a child, which am old?", "words": [[0, 96238], [4, 96368], [8, 96508], [13, 96728], [18, 97008], [21, 97228], [30, 98130], [34, 98275], [38, 98375], [44, 98655], [51, 99135], [59, 99835], [65, 100155], [67, 100365], [70, 100575], [72, 100815], [79, 101055], [84, 101275], [86, 101415], [93, 102095], [99, 102235], [102, 102375]]}, {"verse": 14, "start": 103495, "end": 111631, "text": "Is any thing too hard for the LORD? At the time appointed I will return to you, according to the time of life, and Sarah shall have a son.", "words": [[0, 103495], [3, 103667], [7, 103873], [13, 104080], [17, 104360], [22, 104620], [26, 104780], [30, 104880], [36, 105939], [39, 106086], [43, 106186], [48, 106446], [58, 106866], [60, 107086], [65, 107226], [72, 107626], [75, 107826], [80, 107986], [90, 108346], [93, 108586], [97, 108706], [102, 108946], [105, 109106], [111, 109926], [115, 110046], [121, 110346], [127, 110546], [132, 110766], [134, 110886]]}, {"verse": 15, "start": 111981, "end": 118406, "text": "Then Sarah denied, saying, I laughed not; for she was afraid. And he said, No; but you did laugh.", "words": [[0, 111981], [5, 112200], [11, 112540], [19, 112900], [27, 113560], [29, 113760], [37, 114040], [42, 114866], [46, 114972], [50, 115152], [54, 115332], [62, 116229], [66, 116333], [69, 116453], [75, 116813], [79, 117511], [83, 117615], [87, 117755], [91, 117975]]}, {"verse": 16, "start": 118856, "end": 124388, "text": "¶ And the men rose up from there, and looked toward Sodom: and Abraham went with them to bring them on the way.", "words": [[2, 118856], [6, 118980], [10, 119060], [14, 119280], [19, 119520], [22, 119740], [27, 119920], [34, 120160], [38, 120480], [45, 120740], [52, 121000], [59, 121896], [63, 122005], [71, 122385], [76, 122705], [81, 122965], [86, 123145], [89, 123325], [95, 123525], [100, 123685], [103, 123825], [107, 123945]]}, {"verse": 17, "start": 124838, "end": 128865, "text": "And the LORD said, Shall I hide from Abraham that thing which I do;", "words": [[0, 124838], [4, 124946], [8, 125046], [13, 125226], [19, 125990], [25, 126173], [27, 126333], [32, 126593], [37, 126793], [45, 127233], [50, 127553], [56, 127813], [62, 127993], [64, 128153]]}, {"verse": 18, "start": 129315, "end": 135858, "text": "Seeing that Abraham shall surely become a great and mighty nation, and all the nations of the earth shall be blessed in him?", "words": [[0, 129315], [7, 129594], [12, 129814], [20, 130194], [26, 130514], [33, 130834], [40, 131154], [42, 131314], [48, 131654], [52, 131794], [59, 132054], [67, 132954], [71, 133214], [75, 133434], [79, 133574], [87, 133874], [90, 134114], [94, 134234], [100, 134394], [106, 134574], [109, 134714], [117, 135014], [120, 135214]]}, {"verse": 19, "start": 136308, "end": 148986, "text": "For I know him, that he will command his children and his household after him, and they shall keep the way of the LORD, to do justice and judgment; that the LORD may bring upon Abraham that which he has spoken of him.", "words": [[0, 136308], [4, 136422], [6, 136562], [11, 136782], [16, 137042], [21, 137682], [24, 137822], [29, 137942], [37, 138262], [41, 138482], [50, 138922], [54, 139222], [58, 139402], [68, 139782], [74, 140142], [79, 140702], [83, 141062], [88, 141182], [94, 141322], [99, 141502], [103, 141702], [107, 141842], [110, 141962], [114, 142082], [120, 142342], [123, 142642], [126, 142802], [134, 143222], [138, 143582], [148, 144772], [153, 144872], [157, 144992], [162, 145232], [166, 145432], [172, 145672], [177, 145952], [185, 147092], [190, 147212], [196, 147392], [199, 147552], [203, 147712], [210, 148052], [213, 148292]]}, {"verse": 20, "start": 149336, "end": 156711, "text": "And the LORD said, Because the cry of Sodom and Gomorrah is great, and because their sin is very grievous;", "words": [[0, 149336], [4, 149465], [8, 149585], [13, 149785], [19, 151126], [27, 151307], [31, 151507], [35, 151787], [38, 151947], [44, 152447], [48, 152817], [57, 153187], [60, 153707], [67, 154027], [71, 154527], [79, 154787], [85, 155007], [89, 155327], [92, 155527], [97, 155747]]}, {"verse": 21, "start": 157161, "end": 165072, "text": "I will go down now, and see whether they have done altogether according to the cry of it, which is come to me; and if not, I will know.", "words": [[0, 157161], [2, 157285], [7, 157405], [10, 157545], [15, 157825], [20, 158125], [24, 158785], [28, 158985], [36, 159245], [41, 159445], [46, 159585], [51, 159805], [62, 160305], [72, 160765], [75, 160985], [79, 161125], [83, 161345], [86, 161565], [90, 161965], [96, 162105], [99, 162245], [104, 162425], [107, 162585], [111, 163509], [115, 163644], [118, 163744], [123, 164144], [125, 164244], [130, 164384]]}, {"verse": 22, "start": 165422, "end": 171247, "text": "And the men turned their faces from there, and went toward Sodom: but Abraham stood yet before the LORD.", "words": [[0, 165422], [4, 165561], [8, 165681], [12, 165881], [19, 166161], [25, 166401], [31, 166781], [36, 167101], [43, 167421], [47, 167681], [52, 167931], [59, 168181], [66, 169104], [70, 169208], [78, 169648], [84, 169948], [88, 170208], [95, 170568], [99, 170768]]}, {"verse": 23, "start": 171697, "end": 175990, "text": "¶ And Abraham drew near, and said, Will you also destroy the righteous with the wicked?", "words": [[2, 171697], [6, 171827], [14, 172207], [19, 172547], [25, 172787], [29, 173007], [35, 173695], [40, 173796], [44, 173956], [49, 174196], [57, 174676], [61, 174856], [71, 175216], [76, 175476], [80, 175576]]}, {"verse": 24, "start": 176440, "end": 182840, "text": "Perhaps there are fifty righteous within the city: will you also destroy and not spare the place for the fifty righteous that are in it?", "words": [[0, 176440], [8, 176722], [14, 177002], [18, 177102], [24, 177342], [34, 177762], [41, 178082], [45, 178262], [51, 178956], [56, 179078], [60, 179218], [65, 179458], [73, 179958], [77, 180218], [81, 180418], [87, 180718], [91, 180878], [97, 181118], [101, 181318], [105, 181468], [111, 181618], [121, 181958], [126, 182258], [130, 182398], [133, 182558]]}, {"verse": 25, "start": 183290, "end": 193938, "text": "That be far from you to do after this manner, to slay the righteous with the wicked: and that the righteous should be as the wicked, that be far from you: Shall not the Judge of all the earth do right?", "words": [[0, 183290], [5, 183448], [8, 183588], [12, 183908], [17, 184108], [21, 184268], [24, 184408], [27, 184628], [33, 185008], [38, 185268], [46, 185788], [49, 186028], [54, 186428], [58, 186548], [68, 186888], [73, 187188], [77, 187288], [85, 187983], [89, 188126], [94, 188246], [98, 188386], [108, 188726], [115, 189146], [118, 189366], [121, 189646], [125, 189786], [133, 190066], [138, 190426], [141, 190586], [145, 190866], [150, 191086], [155, 191690], [161, 191886], [165, 192146], [169, 192346], [175, 192546], [178, 192726], [182, 193006], [186, 193146], [192, 193426], [195, 193706]]}, {"verse": 26, "start": 194288, "end": 201820, "text": "And the LORD said, If I find in Sodom fifty righteous within the city, then I will spare all the place for their sakes.", "words": [[0, 194288], [4, 194417], [8, 194537], [13, 194737], [19, 196078], [22, 196215], [24, 196375], [29, 196695], [32, 196835], [38, 197165], [44, 197495], [54, 197935], [61, 198275], [65, 198455], [71, 199135], [76, 199395], [78, 199535], [83, 199675], [89, 199935], [93, 200215], [97, 200355], [103, 200615], [107, 200815], [113, 200975]]}, {"verse": 27, "start": 202170, "end": 208917, "text": "And Abraham answered and said, Behold now, I have taken upon me to speak to the Lord, which am but dust and ashes:", "words": [[0, 202170], [4, 202295], [12, 202655], [21, 203115], [25, 203375], [31, 203992], [38, 204525], [43, 204645], [45, 204825], [50, 204925], [56, 205205], [61, 205465], [64, 205705], [67, 205845], [73, 206125], [76, 206325], [80, 206445], [86, 207085], [92, 207245], [95, 207365], [99, 207585], [104, 207985], [108, 208245]]}, {"verse": 28, "start": 209267, "end": 219389, "text": "Perhaps there shall lack five of the fifty righteous: will you destroy all the city for lack of five? And he said, If I find there forty and five, I will not destroy it.", "words": [[0, 209267], [8, 209547], [14, 209867], [20, 210087], [25, 210467], [30, 210907], [33, 211227], [37, 211347], [43, 211627], [54, 212752], [59, 212878], [63, 212998], [71, 213358], [75, 213658], [79, 213818], [84, 214038], [88, 214278], [93, 214518], [96, 214758], [102, 215596], [106, 215731], [109, 215831], [115, 216091], [118, 216191], [120, 216311], [125, 216651], [131, 216911], [137, 217171], [141, 217351], [147, 218071], [149, 218231], [154, 218391], [158, 218611], [166, 218991]]}, {"verse": 29, "start": 219839, "end": 228792, "text": "And he spoke to him yet again, and said, Perhaps there shall be forty found there. And he said, I will not do it for forty’s sake.", "words": [[0, 219839], [4, 219955], [7, 220095], [13, 220375], [16, 220615], [20, 220855], [24, 221095], [31, 221735], [35, 221815], [41, 222598], [49, 222910], [55, 223170], [61, 223350], [64, 223550], [70, 223870], [76, 224190], [83, 224872], [87, 225007], [90, 225147], [96, 226605], [98, 226711], [103, 226831], [107, 227051], [110, 227331], [113, 227471], [117, 227651], [125, 228151]]}, {"verse": 30, "start": 229142, "end": 239954, "text": "And he said to him, Oh let not the Lord be angry, and I will speak: Perhaps there shall thirty be found there. And he said, I will not do it, if I find thirty there.", "words": [[0, 229142], [4, 229268], [7, 229368], [12, 229588], [15, 229788], [20, 230440], [23, 230760], [27, 230840], [31, 231040], [35, 231260], [40, 231380], [43, 231540], [50, 232100], [54, 232180], [56, 232300], [61, 232420], [68, 233189], [76, 233411], [82, 233691], [88, 233941], [95, 234191], [98, 234371], [104, 234591], [111, 235352], [115, 235487], [118, 235627], [124, 237085], [126, 237211], [131, 237391], [135, 237591], [138, 237831], [142, 238271], [145, 238391], [147, 238531], [152, 238831], [159, 239131]]}, {"verse": 31, "start": 240304, "end": 251839, "text": "And he said, Behold now, I have taken upon me to speak to the Lord: Perhaps there shall be twenty found there. And he said, I will not destroy it for twenty’s sake.", "words": [[0, 240304], [4, 240439], [7, 240579], [13, 242037], [20, 242451], [25, 242711], [27, 242951], [32, 243091], [38, 243411], [43, 243691], [46, 243951], [49, 244111], [55, 244371], [58, 244571], [62, 244691], [68, 245397], [76, 245618], [82, 245878], [88, 246078], [91, 246238], [98, 246538], [104, 246838], [111, 247593], [115, 247727], [118, 247867], [124, 249326], [126, 249448], [131, 249568], [135, 249808], [143, 250248], [146, 250488], [150, 250798], [159, 251108]]}, {"verse": 32, "start": 252189, "end": 262221, "text": "And he said, Oh let not the Lord be angry, and I will speak yet but this once: Perhaps ten shall be found there. And he said, I will not destroy it for ten’s sake.", "words": [[0, 252189], [4, 252313], [7, 252433], [13, 252873], [16, 253213], [20, 253313], [24, 253573], [28, 253853], [33, 254093], [36, 254333], [43, 254893], [47, 254973], [49, 255113], [54, 255253], [60, 255493], [64, 256033], [68, 256113], [73, 256333], [79, 257295], [87, 257635], [91, 258035], [97, 258315], [100, 258495], [106, 258775], [113, 259532], [117, 259637], [120, 259757], [126, 260037], [128, 260157], [133, 260317], [137, 260557], [145, 261037], [148, 261217], [152, 261397], [158, 261817]]}, {"verse": 33, "start": 262671, "end": 268788, "text": "And the LORD went his way, as soon as he had left communing with Abraham: and Abraham returned to his place.", "words": [[0, 262671], [4, 262798], [8, 262918], [13, 263118], [18, 263338], [22, 263538], [27, 263858], [30, 264118], [35, 264298], [38, 264418], [41, 264538], [45, 264658], [50, 264818], [60, 265318], [65, 265458], [74, 266661], [78, 266961], [86, 267461], [95, 267861], [98, 268101], [102, 268241]]}]}