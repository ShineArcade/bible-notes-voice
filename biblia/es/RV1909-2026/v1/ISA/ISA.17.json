{"book": "ISA", "chapter": 17, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 150020, "verses": [{"verse": 1, "start": 300, "end": 6723, "text": "Carga de Damasco. He aquí que Damasco dejó de ser ciudad, y será montón de ruina.", "words": [[0, 300], [6, 514], [9, 774], [18, 1821], [21, 1940], [26, 2180], [30, 2340], [38, 2880], [43, 3240], [46, 3360], [50, 3560], [58, 4120], [60, 4980], [65, 5240], [72, 5880], [75, 6040]]}, {"verse": 2, "start": 7023, "end": 14768, "text": "Las ciudades de Aroer desamparadas, en majadas se volverán; dormirán allí, y no habrá quien los espante.", "words": [[0, 7023], [4, 7164], [13, 7724], [16, 8034], [22, 8344], [36, 9304], [39, 9764], [47, 10304], [50, 10484], [60, 11762], [69, 12268], [75, 12568], [77, 13108], [80, 13248], [86, 13688], [92, 13808], [96, 14008]]}, {"verse": 3, "start": 15343, "end": 27010, "text": "Y cesará el socorro de Efraín, y el reino de Damasco; y lo que quede de Siria, será como la gloria de los hijos de Israel, dice Jehová de los ejércitos.", "words": [[0, 15343], [2, 15512], [9, 16132], [12, 16332], [20, 16972], [23, 17212], [31, 17952], [33, 18472], [36, 18612], [42, 19032], [45, 19172], [54, 20226], [56, 20506], [59, 20646], [63, 20766], [69, 21106], [72, 21456], [79, 21806], [84, 22246], [89, 22526], [92, 22706], [99, 23146], [102, 23266], [106, 23406], [112, 23746], [115, 23926], [123, 24576], [128, 25226], [135, 25746], [138, 25826], [142, 25966]]}, {"verse": 4, "start": 27310, "end": 33665, "text": "Y será que en aquel tiempo la gloria de Jacob se atenuará, y se enflaquecerá la grasa de su carne.", "words": [[0, 27310], [2, 27445], [7, 27665], [11, 27925], [14, 28045], [20, 28365], [27, 28645], [30, 28925], [37, 29305], [40, 29425], [46, 29765], [49, 30065], [59, 31065], [61, 31325], [64, 31485], [77, 32325], [80, 32425], [86, 32805], [89, 32945], [92, 33085]]}, {"verse": 5, "start": 34377, "end": 43358, "text": "Y será como cuando el segador recoge la mies, y con su brazo siega las espigas: será también como el que recoge espigas en el valle de Refaim.", "words": [[0, 34377], [2, 34495], [7, 34715], [12, 35015], [19, 35335], [22, 35645], [30, 35955], [37, 36395], [40, 36715], [46, 37035], [48, 37355], [52, 37535], [55, 37695], [61, 38175], [67, 38655], [71, 38835], [80, 40144], [85, 40348], [93, 40768], [98, 41068], [101, 41188], [105, 41288], [112, 41708], [120, 42208], [123, 42328], [126, 42448], [132, 42648], [135, 43003]]}, {"verse": 6, "start": 43974, "end": 57362, "text": "Y quedarán en él rebuscos, como cuando sacuden el olivo, dos o tres granos en la punta del ramo, cuatro o cinco en sus ramas fructíferas, dice Jehová Dios de Israel.", "words": [[0, 43974], [2, 44098], [11, 44618], [14, 44738], [17, 44918], [27, 46138], [32, 46438], [39, 46738], [47, 47298], [50, 47808], [57, 48318], [61, 48638], [63, 48798], [68, 49158], [75, 49518], [78, 49738], [81, 49878], [87, 50258], [91, 50438], [97, 51358], [104, 51818], [106, 52218], [112, 52698], [115, 52978], [119, 53118], [125, 53578], [138, 54969], [143, 55398], [150, 55958], [155, 56158], [158, 56538]]}, {"verse": 7, "start": 57812, "end": 64917, "text": "En aquel día mirará el hombre a su Hacedor, y sus ojos contemplarán al Santo de Israel.", "words": [[0, 57812], [3, 57937], [9, 58277], [13, 58497], [20, 59097], [23, 59377], [30, 59737], [32, 59937], [35, 60097], [44, 60737], [46, 61437], [50, 61597], [55, 61997], [68, 63297], [71, 63437], [77, 63857], [80, 64117]]}, {"verse": 8, "start": 65367, "end": 75145, "text": "Y no mirará a los altares que hicieron sus manos, ni mirará a lo que hicieron sus dedos, ni a los bosques, ni a las imágenes del sol.", "words": [[0, 65367], [2, 65509], [5, 65669], [12, 66269], [14, 66549], [18, 66669], [26, 67349], [30, 67509], [39, 68029], [43, 68229], [50, 68689], [53, 69349], [60, 69869], [62, 70109], [65, 70249], [69, 70409], [78, 71069], [82, 71369], [89, 72169], [92, 72349], [94, 72469], [98, 72629], [107, 73169], [110, 73589], [112, 73669], [116, 73789], [125, 74309], [129, 74569]]}, {"verse": 9, "start": 75595, "end": 88438, "text": "En aquel día las ciudades de su fortaleza serán como los frutos que quedan en los pimpollos y en las ramas, las cuales fueron dejadas a causa de los hijos de Israel; y habrá desolación.", "words": [[0, 75595], [3, 75734], [9, 76114], [13, 76294], [17, 76514], [26, 77154], [29, 77294], [32, 77454], [42, 78174], [48, 78554], [53, 78774], [57, 78974], [64, 79474], [68, 79694], [75, 80174], [78, 80354], [82, 80494], [92, 81314], [94, 81454], [97, 81554], [101, 82005], [108, 82757], [112, 82883], [119, 83223], [126, 83603], [134, 84303], [136, 84503], [142, 84863], [145, 85103], [149, 85223], [155, 85523], [158, 85723], [166, 86774], [168, 86895], [174, 87215]]}, {"verse": 10, "start": 88888, "end": 101054, "text": "Porque te olvidaste del Dios de tu salvación, y no te acordaste de la roca de tu fortaleza; por tanto plantarás plantas hermosas, y sembrarás sarmiento extraño.", "words": [[0, 88888], [7, 89075], [10, 89255], [20, 89955], [24, 90235], [29, 90595], [32, 90815], [35, 90975], [46, 91735], [48, 92235], [51, 92415], [54, 92575], [64, 93275], [67, 93495], [70, 93615], [75, 94055], [78, 94215], [81, 94375], [92, 95638], [96, 95743], [102, 96423], [112, 97123], [120, 97603], [130, 98403], [132, 98723], [142, 99503], [152, 100183]]}, {"verse": 11, "start": 101504, "end": 112819, "text": "El día que las plantas, las harás crecer, y harás que tu simiente brote de mañana; pero la cosecha será arrebatada en el día del coger, y del dolor desesperado.", "words": [[0, 101504], [3, 101629], [7, 101829], [11, 101969], [15, 102129], [24, 102809], [28, 103169], [34, 103489], [42, 104109], [44, 104669], [50, 104949], [54, 105029], [57, 105339], [66, 105649], [72, 106009], [75, 106149], [83, 107109], [88, 107369], [91, 107549], [99, 108069], [104, 108739], [115, 109409], [118, 109549], [121, 109709], [125, 109949], [129, 110129], [136, 110649], [138, 111089], [142, 111289], [148, 111649]]}, {"verse": 12, "start": 113269, "end": 123343, "text": "¡Ay! multitud de muchos pueblos que harán ruido como estruendo del mar: y murmullo de naciones hará alboroto como murmurio de muchas aguas.", "words": [[0, 113269], [5, 113953], [14, 114481], [17, 114661], [24, 114841], [32, 115521], [36, 115661], [42, 115921], [48, 116321], [53, 116561], [63, 117181], [67, 117381], [72, 118161], [74, 118305], [83, 118985], [86, 119065], [95, 119705], [100, 120245], [109, 120945], [114, 121225], [123, 122025], [126, 122145], [133, 122405]]}, {"verse": 13, "start": 123793, "end": 138720, "text": "Los pueblos harán estrépito a manera de ruido de grandes aguas: pero Dios le reprenderá, y huirá lejos; será ahuyentado como el tamo de los montes delante del viento, y como el polvo delante del torbellino.", "words": [[0, 123793], [4, 123881], [12, 124321], [18, 124641], [28, 125301], [30, 125381], [37, 125651], [40, 125921], [46, 126281], [49, 126441], [57, 126761], [64, 127975], [69, 128157], [74, 128417], [77, 128657], [89, 129597], [91, 130077], [97, 130497], [104, 131503], [109, 132109], [120, 132749], [125, 133009], [128, 133209], [133, 133629], [136, 133729], [140, 133849], [147, 134449], [155, 134889], [159, 135149], [167, 135729], [169, 136129], [174, 136389], [177, 136569], [183, 137089], [191, 137569], [195, 137809]]}, {"verse": 14, "start": 139170, "end": 149620, "text": "Al tiempo de la tarde he aquí turbación; y antes de la mañana ya no es. Esta es la parte de los que nos pisotean, y la suerte de los que nos saquean.", "words": [[0, 139170], [3, 139460], [10, 139780], [13, 139980], [16, 140120], [22, 140490], [25, 140860], [30, 141140], [41, 142361], [43, 142545], [49, 142805], [52, 142985], [55, 143085], [62, 143425], [65, 143645], [68, 143865], [72, 144722], [77, 145030], [80, 145170], [83, 145310], [89, 145710], [92, 145930], [96, 146050], [100, 146190], [104, 146330], [114, 147090], [116, 147630], [119, 147750], [126, 148290], [129, 148430], [133,