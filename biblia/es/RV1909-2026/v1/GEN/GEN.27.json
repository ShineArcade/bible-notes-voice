{"book": "GEN", "chapter": 27, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 394640, "verses": [{"verse": 1, "start": 300, "end": 14426, "text": "Y aconteció que cuando hubo Isaac envejecido, y sus ojos se oscurecieron quedando sin vista, llamó a Esaú, su hijo el mayor, y le dijo: Mi hijo. Y él respondió: Aquí estoy.", "words": [[0, 300], [2, 419], [12, 1119], [16, 1339], [23, 1599], [28, 2139], [34, 2539], [46, 3659], [48, 4239], [52, 4399], [57, 4739], [60, 5039], [73, 5839], [82, 6299], [86, 6519], [93, 7399], [99, 8019], [101, 8179], [107, 9039], [110, 9179], [115, 9439], [118, 9639], [125, 10559], [127, 10659], [130, 10779], [136, 11483], [139, 11682], [145, 12332], [147, 12514], [150, 12654], [161, 13649], [166, 13872]]}, {"verse": 2, "start": 14706, "end": 18740, "text": "Y él dijo: He aquí ya soy viejo, no sé el día de mi muerte:", "words": [[0, 14706], [2, 14895], [5, 15055], [11, 15773], [14, 15933], [19, 16293], [22, 16393], [26, 16573], [33, 17393], [36, 17473], [39, 17653], [42, 17793], [46, 17933], [49, 18073], [52, 18173]]}, {"verse": 3, "start": 19090, "end": 25101, "text": "Toma, pues, ahora tus armas, tu bolsa de flechas y tu arco, y sal al campo, y cázame algo;", "words": [[0, 19090], [6, 19358], [12, 19578], [18, 19938], [22, 20178], [29, 21018], [32, 21058], [38, 21438], [41, 21538], [49, 21978], [51, 22098], [54, 22258], [60, 22638], [62, 22978], [66, 23198], [69, 23398], [76, 23778], [78, 24198], [85, 24618]]}, {"verse": 4, "start": 25451, "end": 31582, "text": "Y hazme un guisado, como yo gusto, y tráemelo, y comeré; para que te bendiga mi alma antes que muera.", "words": [[0, 25451], [2, 25578], [8, 25858], [11, 25998], [20, 26498], [25, 26778], [28, 26998], [35, 27378], [37, 27718], [47, 28298], [49, 28578], [57, 29346], [62, 29490], [66, 29610], [69, 29750], [77, 30170], [80, 30330], [85, 30570], [91, 30930], [95, 31110]]}, {"verse": 5, "start": 31862, "end": 39580, "text": "Y Rebeca estaba oyendo, cuando hablaba Isaac a Esaú su hijo: y se fue Esaú al campo para cazar lo que había de traer.", "words": [[0, 31862], [2, 32119], [9, 32419], [16, 32679], [24, 33199], [31, 33459], [39, 34019], [45, 34299], [47, 34769], [52, 35239], [55, 35379], [61, 36094], [63, 36182], [66, 36282], [70, 36642], [75, 37002], [78, 37362], [84, 37722], [89, 38042], [95, 38362], [98, 38502], [102, 38642], [108, 38862], [111, 39062]]}, {"verse": 6, "start": 39930, "end": 48749, "text": "Entonces Rebeca habló a Jacob su hijo, diciendo: He aquí yo he oído a tu padre que hablaba con Esaú tu hermano, diciendo:", "words": [[0, 39930], [9, 41033], [16, 41773], [22, 42233], [24, 42313], [30, 42653], [33, 42973], [39, 43233], [49, 44232], [52, 44388], [57, 44923], [60, 45083], [63, 45223], [68, 45463], [70, 45603], [73, 45703], [79, 46003], [83, 46243], [91, 46683], [95, 46973], [100, 47263], [103, 47363], [112, 47963]]}, {"verse": 7, "start": 49099, "end": 54317, "text": "Tráeme caza, y hazme un guisado, para que coma, y te bendiga delante de Jehová antes que yo muera.", "words": [[0, 49290], [7, 49516], [13, 49743], [15, 50063], [21, 50323], [24, 50343], [33, 50823], [38, 51083], [42, 51243], [48, 51563], [50, 51803], [53, 51943], [61, 52323], [69, 52703], [72, 52973], [79, 53243], [85, 53543], [89, 53723], [92, 53843]]}, {"verse": 8, "start": 54667, "end": 58718, "text": "Ahora pues, hijo mío, obedece a mi voz en lo que te mando;", "words": [[0, 54667], [6, 54927], [12, 55587], [17, 55707], [22, 56567], [30, 57127], [32, 57227], [35, 57327], [39, 57607], [42, 57787], [45, 57867], [49, 57987], [52, 58127]]}, {"verse": 9, "start": 59068, "end": 67224, "text": "Ve ahora al ganado, y tráeme de allí dos buenos cabritos de las cabras, y haré de ellos comidas para tu padre, como él gusta;", "words": [[0, 59068], [3, 59208], [9, 59468], [12, 59688], [20, 60228], [22, 60728], [29, 61228], [32, 61388], [37, 61688], [41, 62048], [48, 62428], [57, 63008], [60, 63188], [64, 63348], [72, 63888], [74, 64123], [79, 64403], [82, 64483], [88, 64723], [96, 65203], [101, 65483], [104, 65663], [111, 66003], [116, 66463], [119, 66663]]}, {"verse": 10, "start": 67574, "end": 72291, "text": "Y tú las llevarás a tu padre, y comerá, para que te bendiga antes de su muerte.", "words": [[0, 67574], [2, 67688], [5, 67828], [9, 68028], [18, 68568], [20, 68668], [23, 68788], [30, 69128], [32, 69413], [40, 69953], [45, 70293], [49, 70473], [52, 70593], [60, 71093], [66, 71373], [69, 71573], [72, 71693]]}, {"verse": 11, "start": 72571, "end": 79111, "text": "Y Jacob dijo a Rebeca su madre: He aquí, Esaú mi hermano es hombre velloso, y yo lampiño:", "words": [[0, 72571], [2, 72735], [8, 73035], [13, 73460], [15, 73660], [22, 74080], [25, 74280], [32, 75076], [35, 75214], [41, 75674], [46, 76094], [49, 76174], [57, 76734], [60, 76894], [67, 77214], [76, 77874], [78, 78294], [81, 78454]]}, {"verse": 12, "start": 79461, "end": 85304, "text": "Quizá me palpará mi padre, y me tendrá por burlador, y traeré sobre mí maldición y no bendición.", "words": [[0, 79461], [6, 79787], [9, 79887], [17, 80367], [20, 80447], [27, 80787], [29, 81167], [32, 81287], [39, 81627], [43, 81957], [53, 82287], [55, 82747], [62, 83167], [68, 83367], [71, 83607], [81, 84187], [83, 84427], [86, 84567]]}, {"verse": 13, "start": 85584, "end": 94306, "text": "Y su madre respondió: Hijo mío, sobre mí tu maldición: solamente obedece a mi voz, y ve y tráemelos.", "words": [[0, 85584], [2, 85689], [5, 85809], [11, 86209], [22, 87524], [27, 87809], [32, 88489], [38, 88749], [41, 89069], [44, 89269], [55, 90500], [65, 91224], [73, 91884], [75, 92024], [78, 92144], [83, 92584], [85, 92904], [88, 93124], [90, 93304]]}, {"verse": 14, "start": 94586, "end": 102013, "text": "Entonces él fue, y tomó, y los trajo a su madre: y su madre hizo guisados, como su padre gustaba.", "words": [[0, 94586], [9, 95312], [12, 95532], [17, 95832], [19, 96212], [25, 96522], [27, 96832], [31, 97142], [37, 97452], [39, 97592], [42, 97712], [49, 98469], [51, 98590], [54, 98710], [60, 98990], [65, 99350], [75, 100110], [80, 100610], [83, 100790], [89, 101130]]}, {"verse": 15, "start": 102363, "end": 110316, "text": "Y tomó Rebeca los vestidos de Esaú su hijo mayor, los preciosos, que ella tenía en casa, y vistió a Jacob su hijo menor:", "words": [[0, 102363], [2, 102487], [7, 102827], [14, 103167], [18, 103347], [27, 103747], [30, 104017], [35, 104287], [38, 104427], [43, 104627], [50, 105467], [54, 105587], [65, 106587], [69, 106827], [74, 107027], [80, 107367], [83, 107547], [89, 108367], [91, 108427], [98, 108787], [100, 108947], [106, 109187], [109, 109527], [114, 109767]]}, {"verse": 16, "start": 110666, "end": 117982, "text": "E le hizo vestir sobre sus manos, y sobre la nuca donde no tenía vello, las pieles de los cabritos de las cabras;", "words": [[0, 110745], [2, 110855], [5, 110935], [10, 111255], [17, 111775], [23, 112055], [27, 112255], [34, 112695], [36, 112955], [42, 113195], [45, 113395], [50, 113715], [56, 113895], [59, 114155], [65, 114565], [72, 114975], [76, 115395], [83, 116075], [86, 116195], [90, 116335], [99, 116895], [102, 117095], [106, 117235]]}, {"verse": 17, "start": 118332, "end": 123217, "text": "Y entregó los guisados y el pan que había preparado, en mano de Jacob su hijo.", "words": [[0, 118332], [2, 118473], [10, 118993], [14, 119153], [23, 119673], [25, 119913], [28, 120053], [32, 120333], [36, 120553], [42, 120793], [53, 121473], [56, 121633], [61, 121853], [64, 122033], [70, 122353], [73, 122713]]}, {"verse": 18, "start": 123567, "end": 130466, "text": "Y él fue a su padre, y dijo: Padre mío: y él respondió: Aquí estoy, ¿quién eres, hijo mío?", "words": [[0, 123567], [2, 123729], [5, 123869], [9, 124069], [11, 124229], [14, 124349], [21, 125049], [23, 125451], [29, 126009], [35, 126289], [40, 126932], [42, 127114], [45, 127254], [56, 128249], [61, 128468], [68, 129408], [75, 129648], [81, 129808], [86, 130048]]}, {"verse": 19, "start": 130746, "end": 141005, "text": "Y Jacob dijo a su padre: Yo soy Esaú tu primogénito; he hecho como me dijiste: levántate ahora, y siéntate, y come de mi caza, para que me bendiga tu alma.", "words": [[0, 130990], [2, 131270], [8, 131550], [13, 131950], [15, 132050], [18, 132190], [25, 133013], [28, 133156], [32, 133429], [37, 133703], [40, 133976], [53, 135096], [56, 135219], [62, 135419], [67, 135639], [70, 135779], [79, 136603], [89, 137145], [96, 137465], [98, 137665], [108, 138205], [110, 138445], [115, 138665], [118, 138805], [121, 139035], [127, 139265], [132, 139785], [136, 139925], [139, 140025], [147, 140425], [150, 140605]]}, {"verse": 20, "start": 141285, "end": 151892, "text": "Entonces Isaac dijo a su hijo: ¿Cómo es que la hallaste tan pronto, hijo mío? Y él respondió: Porque Jehová tu Dios hizo que se encontrase delante de mí.", "words": [[0, 141285], [9, 141746], [15, 142526], [20, 143366], [22, 143606], [25, 143746], [31, 144437], [37, 144641], [40, 144861], [44, 145001], [47, 145161], [56, 145541], [60, 145741], [68, 146301], [73, 146421], [78, 147161], [80, 147343], [83, 147483], [94, 148478], [101, 148707], [108, 149267], [111, 149367], [116, 149927], [121, 150127], [125, 150327], [128, 150447], [139, 151027], [147, 151447], [150, 151607]]}, {"verse": 21, "start": 152172, "end": 159196, "text": "E Isaac dijo a Jacob: Acércate ahora, y te palparé, hijo mío, para saber si eres mi hijo Esaú, o no.", "words": [[0, 152461], [2, 152787], [8, 153114], [13, 153554], [15, 153674], [22, 154450], [31, 154968], [38, 155308], [40, 155448], [43, 155568], [52, 156108], [57, 156288], [62, 156688], [67, 157128], [73, 157428], [76, 157668], [81, 157868], [84, 158068], [89, 158378], [95, 158688], [97, 158908]]}, {"verse": 22, "start": 159476, "end": 168502, "text": "Y Jacob se acercó a su padre Isaac; y él le palpó, y dijo: La voz es la voz de Jacob, pero las manos, las manos de Esaú.", "words": [[0, 159476], [2, 159637], [8, 159877], [11, 160177], [18, 160717], [20, 160817], [23, 160957], [29, 161317], [36, 162220], [38, 162387], [41, 162607], [44, 162967], [51, 163627], [53, 163867], [59, 164580], [62, 164678], [66, 164938], [69, 165118], [72, 165298], [76, 165498], [79, 165618], [86, 166238], [91, 166358], [95, 166558], [102, 167278], [106, 167398], [112, 167718], [115, 167958]]}, {"verse": 23, "start": 168782, "end": 175885, "text": "Y no le conoció, porque sus manos eran vellosas como las manos de Esaú: y le bendijo.", "words": [[0, 168782], [2, 168923], [5, 169083], [8, 169243], [17, 170243], [24, 170763], [28, 171003], [34, 171423], [39, 172093], [48, 172763], [53, 173163], [57, 173343], [63, 173703], [66, 173983], [72, 174874], [74, 174998], [77, 175098]]}, {"verse": 24, "start": 176235, "end": 181408, "text": "Y dijo: ¿Eres tú mi hijo Esaú? Y Jacob respondió: Yo soy.", "words": [[0, 176235], [2, 176566], [8, 177332], [14, 177573], [17, 177873], [20, 177953], [25, 178213], [31, 179053], [33, 179218], [39, 179518], [50, 180756], [53, 180978]]}, {"verse": 25, "start": 181688, "end": 192175, "text": "Y dijo: Acércamela, y comeré de la caza de mi hijo, para que te bendiga mi alma; y él se la acercó, y comió: le trajo también vino, y bebió.", "words": [[0, 181688], [2, 182019], [8, 182785], [20, 183529], [22, 183789], [29, 184189], [32, 184249], [35, 184429], [40, 184609], [43, 184789], [46, 184909], [52, 185209], [57, 185749], [61, 185889], [64, 186009], [72, 186389], [75, 186549], [81, 187253], [83, 187414], [86, 187574], [89, 187754], [92, 187914], [100, 188634], [102, 188874], [109, 189784], [112, 189891], [118, 190251], [126, 190571], [132, 191111], [134, 191551]]}, {"verse": 26, "start": 192525, "end": 197251, "text": "Y le dijo Isaac su padre: Acércate ahora, y bésame, hijo mío.", "words": [[0, 192525], [2, 192691], [5, 192941], [10, 193191], [16, 193771], [19, 193991], [26, 194821], [35, 195339], [42, 195679], [44, 195939], [52, 196679], [57, 196799]]}, {"verse": 27, "start": 197531, "end": 209029, "text": "Y él se llegó, y le besó; y olió Isaac el olor de sus vestidos, y le bendijo, y dijo: Mira, el olor de mi hijo como el olor del campo que Jehová ha bendecido:", "words": [[0, 197531], [2, 197735], [5, 197915], [8, 198135], [15, 198455], [17, 198770], [20, 199116], [26, 199627], [28, 199853], [33, 200113], [39, 200553], [42, 200973], [47, 201313], [50, 201433], [54, 201633], [64, 202373], [66, 202613], [69, 202713], [78, 203613], [80, 203893], [86, 204656], [92, 204899], [95, 205139], [100, 205419], [103, 205559], [106, 205719], [111, 205979], [116, 206359], [119, 206559], [124, 206859], [128, 207019], [134, 207439], [138, 207779], [145, 208119], [148, 208239]]}, {"verse": 28, "start": 209379, "end": 215431, "text": "Dios, pues, te dé del rocío del cielo, y de lo mejor de la tierra, y abundancia de trigo y de mosto.", "words": [[0, 209379], [6, 209598], [12, 209958], [15, 210398], [18, 210598], [22, 210758], [28, 211178], [32, 211298], [39, 211778], [41, 212058], [44, 212158], [47, 212258], [53, 212538], [56, 212698], [59, 212798], [67, 213178], [69, 213518], [80, 214138], [83, 214318], [89, 214718], [91, 214818], [94, 214918]]}, {"verse": 29, "start": 215781, "end": 225957, "text": "Te sirvan pueblos, y naciones se inclinen a ti: sé señor de tus hermanos, y se inclinen a ti los hijos de tu madre: malditos los que te maldigan, y benditos los que te bendigan.", "words": [[0, 215781], [3, 215865], [10, 216225], [19, 216725], [21, 216825], [30, 217165], [33, 217505], [42, 217925], [44, 218025], [48, 218568], [51, 218826], [57, 219186], [60, 219366], [64, 219506], [74, 220146], [76, 220286], [79, 220426], [88, 220906], [90, 220986], [93, 221126], [97, 221286], [103, 221586], [106, 221806], [109, 221926], [116, 222612], [125, 223058], [129, 223238], [133, 223418], [136, 223538], [146, 224058], [148, 224338], [157, 224838], [161, 225018], [165, 225198], [168, 225318]]}, {"verse": 30, "start": 226237, "end": 239046, "text": "Y aconteció, luego que hubo Isaac acabado de bendecir a Jacob, y apenas había salido Jacob de delante de Isaac su padre, que Esaú su hermano vino de su caza.", "words": [[0, 226237], [2, 226405], [13, 227125], [19, 227385], [23, 227725], [28, 228125], [34, 228545], [42, 229365], [45, 229545], [54, 230165], [56, 230325], [63, 230765], [65, 231425], [72, 231965], [78, 232445], [85, 233005], [91, 233445], [94, 233685], [102, 234125], [105, 234305], [111, 234945], [114, 235045], [121, 236185], [125, 236432], [130, 236678], [133, 236925], [141, 237705], [146, 238125], [149, 238325], [152, 238694]]}, {"verse": 31, "start": 239396, "end": 248130, "text": "E hizo él también guisados, y trajo a su padre, y le dijo: Levántese mi padre, y coma de la caza de su hijo, para que me bendiga tu alma.", "words": [[0, 239396], [2, 239534], [7, 239814], [10, 240034], [18, 240354], [28, 241014], [30, 241214], [36, 241514], [38, 241614], [41, 241714], [48, 242654], [50, 242894], [53, 243014], [59, 243756], [69, 244296], [72, 244456], [79, 244796], [81, 245056], [86, 245336], [89, 245476], [92, 245636], [97, 245796], [100, 245976], [103, 246136], [109, 246416], [114, 246876], [118, 246996], [121, 247116], [129, 247516], [132, 247676]]}, {"verse": 32, "start": 248410, "end": 256562, "text": "Entonces Isaac su padre le dijo: ¿Quién eres tú? Y él dijo: Yo soy tu hijo, tu primogénito, Esaú.", "words": [[0, 248410], [9, 248897], [15, 250077], [18, 250297], [24, 250917], [27, 251017], [33, 251805], [40, 252016], [45, 252196], [49, 252816], [51, 253004], [54, 253164], [60, 253883], [63, 254069], [67, 254269], [70, 254489], [76, 255049], [79, 255109], [92, 256009]]}, {"verse": 33, "start": 256842, "end": 269445, "text": "Y se estremeció Isaac con grande estremecimiento, y dijo: ¿Quién es el que vino aquí, que cazó, y me trajo, y comí de todo antes que vinieses? Yo le bendije, y será bendito.", "words": [[0, 256842], [2, 257110], [5, 257230], [16, 258290], [22, 258850], [26, 259335], [33, 259795], [50, 260955], [52, 261475], [58, 262260], [65, 262471], [68, 262631], [71, 262751], [75, 262891], [80, 263111], [86, 263651], [90, 263951], [96, 264251], [98, 264451], [101, 264571], [108, 265291], [110, 265311], [115, 265731], [118, 265871], [123, 266091], [129, 266491], [133, 266771], [143, 267713], [146, 267857], [149, 267997], [158, 268457], [160, 268577], [165, 268777]]}, {"verse": 34, "start": 269725, "end": 278976, "text": "Como Esaú oyó las palabras de su padre, clamó con una muy grande y muy amarga exclamación, y le dijo: Bendíceme también a mí, padre mío.", "words": [[0, 269725], [5, 269953], [10, 270553], [14, 270973], [18, 271113], [27, 271493], [30, 271733], [33, 271873], [40, 272493], [46, 273113], [50, 273313], [54, 273533], [58, 273773], [65, 274173], [67, 274333], [71, 274493], [78, 275033], [91, 275853], [93, 276133], [96, 276233], [102, 277235], [112, 277535], [120, 277795], [122, 278035], [126, 278395], [132, 278635]]}, {"verse": 35, "start": 279256, "end": 283233, "text": "Y él dijo: Vino tu hermano con engaño, y tomó tu bendición.", "words": [[0, 279256], [2, 279445], [5, 279605], [11, 280323], [16, 280561], [19, 280781], [27, 281241], [31, 281361], [39, 281881], [41, 282161], [46, 282461], [49, 282541]]}, {"verse": 36, "start": 283513, "end": 295459, "text": "Y él respondió: Bien llamaron su nombre Jacob, que ya me ha engañado dos veces; se alzó con mi primogenitura, y he aquí ahora ha tomado mi bendición. Y dijo: ¿No has guardado bendición para mí?", "words": [[0, 283513], [2, 283695], [5, 283835], [16, 284830], [21, 285072], [30, 285472], [33, 285652], [40, 285892], [47, 286532], [51, 286592], [54, 286772], [57, 286892], [60, 286972], [69, 287412], [73, 287572], [80, 288498], [83, 288644], [88, 288964], [92, 289104], [95, 289224], [110, 290004], [112, 290484], [115, 290584], [120, 290824], [126, 290964], [129, 291104], [136, 291604], [139, 291724], [150, 292696], [152, 293027], [158, 293794], [162, 293934], [166, 294014], [175, 294394], [185, 294874], [190, 295094]]}, {"verse": 37, "start": 295739, "end": 308130, "text": "Isaac respondió y dijo a Esaú: He aquí yo le he puesto por señor tuyo, y le he dado por siervos a todos sus hermanos: de trigo y de vino le he provisto: ¿qué, pues, te haré a ti ahora, hijo mío?", "words": [[0, 295739], [6, 296191], [16, 297096], [18, 297316], [23, 297636], [25, 297736], [31, 298508], [34, 298648], [39, 299128], [42, 299228], [45, 299368], [48, 299448], [55, 299688], [59, 299928], [65, 300128], [71, 300628], [73, 301088], [76, 301228], [79, 301308], [84, 301488], [88, 301768], [96, 302148], [98, 302328], [104, 302528], [108, 302768], [118, 303667], [121, 303807], [127, 304187], [129, 304267], [132, 304387], [137, 304587], [140, 304787], [143, 304927], [153, 305822], [159, 305940], [165, 306220], [168, 306560], [173, 306820], [175, 306880], [178, 307000], [185, 307480], [190, 307640]]}, {"verse": 38, "start": 308410, "end": 317850, "text": "Y Esaú respondió a su padre: ¿No tienes más que una sola bendición, padre mío? bendíceme también a mí, padre mío. Y alzó Esaú su voz, y lloró.", "words": [[0, 308410], [2, 308714], [7, 309054], [17, 309614], [19, 309714], [22, 309814], [29, 310601], [33, 310724], [40, 310984], [44, 311224], [48, 311384], [52, 311524], [57, 311784], [68, 312524], [74, 312784], [79, 313682], [89, 313942], [97, 314222], [99, 314422], [103, 314502], [109, 314742], [114, 315547], [116, 315689], [121, 316159], [126, 316629], [129, 316769], [134, 317049], [136, 317309]]}, {"verse": 39, "start": 318200, "end": 326874, "text": "Entonces Isaac su padre habló y le dijo: He aquí será tu habitación en lo mejor de la tierra, y del rocío de los cielos de arriba;", "words": [[0, 318200], [9, 318817], [15, 319757], [18, 319857], [24, 320377], [30, 320777], [32, 320977], [35, 321097], [41, 321883], [44, 321973], [49, 322233], [54, 322473], [57, 322693], [68, 323313], [71, 323453], [74, 323553], [80, 323853], [83, 323973], [86, 324073], [94, 324513], [96, 324973], [100, 325153], [106, 325593], [109, 325713], [113, 325853], [120, 326233], [123, 326353]]}, {"verse": 40, "start": 327224, "end": 334557, "text": "Y por tu espada vivirás, y a tu hermano servirás: y sucederá cuando te fortalezcas, que descargarás su yugo de tu cerviz.", "words": [[0, 327224], [2, 327345], [6, 327505], [9, 327705], [16, 328125], [25, 328725], [27, 328925], [29, 329005], [32, 329125], [40, 329545], [50, 330516], [52, 330618], [61, 331198], [68, 331378], [71, 331598], [84, 332378], [88, 332543], [100, 333203], [103, 333403], [108, 333703], [111, 333823], [114, 334218]]}, {"verse": 41, "start": 334837, "end": 346238, "text": "Y aborreció Esaú a Jacob por la bendición con que le había bendecido, y dijo en su corazón: Llegarán los días del luto de mi padre, y yo mataré a Jacob mi hermano.", "words": [[0, 334837], [2, 334959], [12, 335589], [17, 336219], [19, 336419], [25, 336779], [29, 337199], [32, 337339], [42, 337959], [46, 338519], [50, 338719], [53, 338879], [59, 339139], [70, 340419], [72, 340519], [77, 340839], [80, 340999], [83, 341139], [92, 342084], [101, 342548], [105, 342728], [110, 342988], [114, 343268], [119, 343608], [122, 343728], [125, 343848], [132, 344208], [134, 344413], [137, 344593], [144, 345033], [146, 345133], [152, 345633], [155, 345713]]}, {"verse": 42, "start": 346518, "end": 358960, "text": "Y fueron dichas a Rebeca las palabras de Esaú su hijo mayor: y ella envió y llamó a Jacob su hijo menor, y le dijo: He aquí, Esaú tu hermano se consuela acerca de ti con la idea de matarte.", "words": [[0, 346518], [2, 346639], [9, 346919], [16, 347439], [18, 347579], [25, 347959], [29, 348119], [38, 348539], [41, 348929], [46, 349319], [49, 349419], [54, 349659], [61, 350458], [63, 350636], [68, 350856], [74, 351356], [76, 351556], [82, 351916], [84, 351996], [90, 352636], [93, 352756], [98, 352956], [105, 353516], [107, 353536], [110, 353656], [116, 354384], [119, 354444], [125, 354784], [130, 355124], [133, 355324], [141, 355824], [144, 355944], [153, 356544], [160, 356864], [163, 357184], [166, 357384], [170, 357644], [173, 357784], [178, 358004], [181, 358184]]}, {"verse": 43, "start": 359310, "end": 365298, "text": "Ahora pues, hijo mío, obedece a mi voz; levántate, y huye a Labán mi hermano, a Harán;", "words": [[0, 359310], [6, 359609], [12, 360189], [17, 360329], [22, 360909], [30, 361369], [32, 361489], [35, 361569], [40, 362288], [51, 362954], [53, 363214], [58, 363474], [60, 363704], [66, 363934], [69, 364014], [78, 364634], [80, 364990]]}, {"verse": 44, "start": 365648, "end": 370169, "text": "Y mora con él algunos días, hasta que el enojo de tu hermano se mitigue;", "words": [[0, 365648], [2, 365748], [7, 366048], [11, 366248], [14, 366408], [22, 366788], [28, 367668], [34, 367908], [38, 368128], [41, 368288], [47, 368628], [50, 368768], [53, 368888], [61, 369348], [64, 369468]]}, {"verse": 45, "start": 370519, "end": 381795, "text": "Hasta que se aplaque la ira de tu hermano contra ti, y se olvide de lo que le has hecho: yo enviaré entonces, y te traeré de allá: ¿por qué seré privada de vosotros ambos en un día?", "words": [[0, 370519], [6, 370719], [10, 370879], [13, 371039], [21, 371499], [24, 371659], [28, 371919], [31, 372019], [34, 372159], [42, 372619], [49, 372919], [53, 373219], [55, 373699], [58, 373839], [65, 374299], [68, 374419], [71, 374539], [75, 374659], [78, 374799], [82, 374999], [89, 375689], [92, 375876], [100, 376336], [110, 376756], [112, 377191], [115, 377331], [122, 377811], [125, 377871], [131, 378548], [136, 378651], [140, 378891], [145, 379251], [153, 379731], [156, 379891], [165, 380411], [171, 380851], [174, 381111], [177, 381251]]}, {"verse": 46, "start": 382075, "end": 394240, "text": "Y dijo Rebeca a Isaac: Fastidio tengo de mi vida, a causa de las hijas de Het. Si Jacob toma mujer de las hijas de Het, como estas, de las hijas de esta tierra, ¿para qué quiero la vida?", "words": [[0, 382075], [2, 382217], [7, 382490], [14, 382764], [16, 383037], [23, 384544], [32, 384844], [38, 385084], [41, 385264], [44, 385404], [50, 386004], [52, 386104], [58, 386364], [61, 386584], [65, 386724], [71, 387124], [74, 387464], [79, 387952], [82, 388116], [88, 388396], [93, 388716], [99, 389016], [102, 389216], [106, 389356], [112, 389716], [115, 389946], [120, 390176], [125, 390476], [132, 391196], [135, 391236], [139, 391356], [145, 391756], [148, 391876], [153, 392036], [161, 393036], [167, 393236], [171, 393396], [178, 393676], [181, 393816]]}]}