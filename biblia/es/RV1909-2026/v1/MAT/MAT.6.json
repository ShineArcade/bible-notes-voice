{"book": "MAT", "chapter": 6, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 300066, "verses": [{"verse": 1, "start": 300, "end": 11436, "text": "Mirad que no hagáis vuestra justicia delante de los hombres, para ser vistos de ellos: de otra manera no tendréis recompensa de vuestro Padre que está en los cielos.", "words": [[0, 300], [6, 784], [10, 949], [13, 1169], [20, 1709], [28, 2209], [37, 2889], [45, 3329], [48, 3469], [52, 3609], [61, 4029], [66, 4609], [70, 4809], [77, 5249], [80, 5429], [87, 6044], [90, 6176], [95, 6376], [102, 7096], [105, 7176], [114, 7776], [125, 8956], [128, 9156], [136, 9556], [142, 10056], [146, 10216], [151, 10456], [154, 10656], [158, 10776]]}, {"verse": 2, "start": 11786, "end": 26686, "text": "Cuando pues haces limosna, no toques trompeta delante de ti, como hacen los hipócritas en las sinagogas y en las plazas, para ser elogiados por los hombres: de cierto os digo, que ya tienen su recompensa.", "words": [[0, 11786], [7, 12030], [12, 12390], [18, 12930], [27, 14150], [30, 14430], [37, 14870], [46, 15630], [54, 16070], [57, 16250], [61, 16870], [66, 17130], [72, 17490], [76, 17670], [87, 18650], [90, 18890], [94, 19050], [104, 19810], [106, 19950], [109, 20070], [113, 20170], [121, 20810], [126, 21210], [130, 21510], [140, 22250], [144, 22490], [148, 22650], [157, 23486], [160, 23691], [167, 24051], [170, 24411], [176, 24811], [180, 25311], [183, 25511], [190, 25871], [193, 26151]]}, {"verse": 3, "start": 27036, "end": 31994, "text": "Pero cuando tú haces limosna, no sepa tu izquierda lo que hace tu derecha;", "words": [[0, 27036], [5, 27604], [12, 28024], [15, 28264], [21, 28604], [30, 29184], [33, 29764], [38, 30104], [41, 30284], [51, 30884], [54, 31044], [58, 31204], [63, 31424], [66, 31644]]}, {"verse": 4, "start": 31994, "end": 38832, "text": "Para que sea tu limosna en secreto: y tu Padre que ve en secreto, él te recompensará en público.", "words": [[0, 32124], [5, 32304], [9, 32464], [13, 32624], [16, 32824], [24, 33284], [27, 33364], [36, 34252], [38, 34378], [41, 34478], [47, 35171], [51, 35265], [54, 35359], [57, 35453], [66, 36593], [69, 37026], [72, 37460], [85, 37893], [88, 38013]]}, {"verse": 5, "start": 39182, "end": 54184, "text": "Y cuando ores, no seas como los hipócritas; porque ellos aman el orar en las sinagogas, y en las esquinas de las calles en pie, para ser vistos de los hombres: de cierto os digo, que ya tienen su pago.", "words": [[0, 39182], [2, 39292], [9, 39552], [15, 40312], [18, 40552], [23, 40952], [28, 41252], [32, 41916], [44, 42751], [51, 42993], [57, 43293], [62, 43713], [65, 44033], [70, 44373], [73, 44533], [77, 44713], [88, 45613], [90, 46133], [93, 46293], [97, 46473], [106, 47153], [109, 47313], [113, 47453], [120, 47873], [123, 48053], [128, 48373], [133, 48953], [137, 49193], [144, 49773], [147, 49893], [151, 50033], [160, 51018], [163, 51161], [170, 51501], [173, 51981], [179, 52321], [183, 52821], [186, 53001], [193, 53281], [196, 53521]]}, {"verse": 6, "start": 54534, "end": 66056, "text": "Pero tú, cuando ores, entra en tu habitación, y cerrada tu puerta, ora a tu Padre que está en secreto; y tu Padre que ve en secreto, te recompensará en público.", "words": [[0, 54534], [5, 54678], [9, 54918], [16, 55158], [22, 55758], [28, 56278], [31, 56518], [34, 56658], [46, 57298], [48, 57533], [56, 58013], [59, 58233], [67, 58993], [71, 59373], [73, 59693], [76, 59813], [82, 60253], [86, 60673], [91, 60853], [94, 61033], [103, 61899], [105, 62024], [108, 62124], [114, 62644], [118, 62764], [121, 62964], [124, 63084], [133, 64184], [136, 64404], [149, 65264], [152, 65384]]}, {"verse": 7, "start": 66406, "end": 74568, "text": "Y orando, no uséis repeticiones sin sentido, como los Gentiles; que piensan que por su palabrería serán oídos.", "words": [[0, 66406], [2, 66566], [10, 66946], [13, 67286], [19, 67866], [32, 68866], [36, 69186], [45, 69726], [50, 70046], [54, 70206], [64, 71269], [68, 71578], [76, 72198], [80, 72358], [84, 72611], [87, 72865], [98, 73118], [104, 73938]]}, {"verse": 8, "start": 74918, "end": 84084, "text": "No os hagáis, pues, semejantes a ellos; porque vuestro Padre sabe de qué cosas tenéis necesidad, antes que vosotros le pidáis.", "words": [[0, 74918], [3, 75246], [6, 75606], [14, 76146], [20, 76486], [31, 77546], [33, 77746], [40, 78523], [47, 78727], [55, 79127], [61, 79427], [66, 79847], [69, 80067], [73, 80267], [79, 80647], [86, 81227], [97, 82067], [103, 82447], [107, 82667], [116, 83147], [119, 83347]]}, {"verse": 9, "start": 84434, "end": 90949, "text": "Vosotros pues, oraréis así: Padre nuestro que estás en los cielos, santificado sea tu nombre.", "words": [[0, 84434], [9, 84978], [15, 85258], [23, 86018], [28, 86741], [34, 87113], [42, 87333], [46, 87753], [52, 87953], [55, 88193], [59, 88353], [67, 89093], [79, 89833], [83, 90073], [86, 90273]]}, {"verse": 10, "start": 91299, "end": 97503, "text": "Venga tu reino. Sea hecha tu voluntad, como en el cielo, así también en la tierra.", "words": [[0, 91538], [6, 91808], [9, 91848], [16, 92736], [20, 93060], [26, 93520], [29, 93720], [39, 94420], [44, 94700], [47, 94900], [50, 95020], [57, 95820], [61, 96020], [69, 96480], [72, 96660], [75, 96800]]}, {"verse": 11, "start": 97853, "end": 100735, "text": "Danos hoy nuestro pan de cada día.", "words": [[0, 97853], [6, 98292], [10, 98732], [18, 99192], [22, 99652], [25, 99872], [30, 100092]]}, {"verse": 12, "start": 101085, "end": 106997, "text": "Y perdónanos nuestras deudas, como también nosotros perdonamos a nuestros deudores.", "words": [[0, 101085], [2, 101192], [13, 101892], [22, 102432], [30, 103372], [35, 103592], [43, 104052], [52, 104652], [63, 105592], [65, 105752], [74, 105912]]}, {"verse": 13, "start": 107347, "end": 117191, "text": "Y no nos metas en tentación, sino líbranos del mal: porque tuyo es el reino, y el poder, y la gloria, por todos los siglos. Amén.", "words": [[0, 107347], [2, 107474], [5, 107594], [9, 107754], [15, 108194], [18, 108354], [29, 109134], [34, 109354], [43, 110254], [47, 110514], [52, 111279], [59, 111487], [64, 111987], [67, 112107], [70, 112267], [77, 112847], [79, 113307], [82, 113447], [89, 113847], [91, 114147], [94, 114307], [102, 114787], [106, 115027], [112, 115347], [116, 115607], [124, 116659]]}, {"verse": 14, "start": 117541, "end": 124011, "text": "Porque si perdonáis a los hombres sus ofensas, os perdonará también a vosotros vuestro Padre celestial.", "words": [[0, 117541], [7, 117723], [10, 117903], [20, 118523], [22, 118643], [26, 118783], [34, 119163], [38, 119423], [47, 120403], [50, 120703], [60, 121423], [68, 121823], [70, 122043], [79, 122483], [87, 122863], [93, 123243]]}, {"verse": 15, "start": 124361, "end": 130530, "text": "Pero si no perdonáis a los hombres sus ofensas, tampoco vuestro Padre os perdonará vuestras ofensas.", "words": [[0, 124361], [5, 124505], [8, 124665], [11, 124825], [21, 125405], [23, 125525], [27, 125645], [35, 126005], [39, 126245], [48, 127165], [56, 127485], [64, 128025], [70, 128365], [73, 128585], [83, 129205], [92, 129625]]}, {"verse": 16, "start": 130880, "end": 143723, "text": "Y cuando ayunáis, no seáis como los hipócritas, sombríos; porque ellos desfiguran sus rostros para parecer a los hombres que ayunan: de cierto os digo, que ya tienen su pago.", "words": [[0, 130880], [2, 131024], [9, 131264], [18, 132224], [21, 132344], [27, 132804], [32, 133064], [36, 133244], [48, 134278], [58, 135473], [65, 135735], [71, 136155], [82, 136895], [86, 137135], [94, 137835], [99, 138355], [107, 138815], [109, 138995], [113, 139155], [121, 139455], [125, 139695], [133, 140558], [136, 140701], [143, 141041], [146, 141521], [152, 141861], [156, 142361], [159, 142541], [166, 142821], [169, 143061]]}, {"verse": 17, "start": 144073, "end": 147873, "text": "Pero tú, cuando ayunas, unge tu cabeza y lava tu rostro;", "words": [[0, 144073], [5, 144219], [9, 144459], [16, 144699], [24, 145199], [29, 145699], [32, 145839], [39, 146319], [41, 146859], [46, 147019], [49, 147259]]}, {"verse": 18, "start": 148223, "end": 157729, "text": "Para no parecer a los hombres que ayunas, sino a tu Padre que está en secreto: y tu Padre que ve en secreto, te recompensará en público.", "words": [[0, 148223], [5, 148503], [8, 148893], [16, 149283], [18, 149403], [22, 149563], [30, 149903], [34, 150163], [42, 150863], [47, 151243], [49, 151503], [52, 151623], [58, 152003], [62, 152223], [67, 152443], [70, 152603], [79, 153572], [81, 153697], [84, 153797], [90, 154317], [94, 154437], [97, 154637], [100, 154757], [109, 155857], [112, 156077], [125, 156937], [128, 157057]]}, {"verse": 19, "start": 158079, "end": 165736, "text": "No os hagáis tesoros en la tierra, donde la polilla y el óxido corrompen, y donde ladrones entran a robar;", "words": [[0, 158079], [3, 158284], [6, 158484], [13, 158824], [21, 159524], [24, 159644], [27, 159784], [35, 160204], [41, 160764], [44, 161024], [52, 161504], [54, 161664], [57, 161764], [63, 162184], [74, 162944], [76, 163384], [82, 163624], [91, 164264], [98, 165004], [100, 165164]]}, {"verse": 20, "start": 166086, "end": 175042, "text": "Pero haceos tesoros en el cielo, donde ni polilla ni óxido corrompen, y donde ladrones no entran a robar:", "words": [[0, 166086], [5, 166550], [12, 167050], [20, 167790], [23, 167970], [26, 168110], [33, 169170], [39, 169610], [42, 169990], [50, 170670], [53, 170890], [59, 171430], [70, 172150], [72, 172370], [78, 172670], [87, 173470], [90, 173910], [97, 174310], [99, 174450]]}, {"verse": 21, "start": 175392, "end": 179343, "text": "Porque donde esté vuestro tesoro, allí estará vuestro corazón.", "words": [[0, 175392], [7, 175576], [13, 175836], [18, 176156], [26, 176536], [34, 177376], [39, 177856], [46, 178336], [54, 178696]]}, {"verse": 22, "start": 179693, "end": 187020, "text": "La lámpara del cuerpo es el ojo: así que, si tu ojo es bueno, todo tu cuerpo estará lleno de luz:", "words": [[0, 179693], [3, 179848], [11, 180388], [15, 180588], [22, 181048], [25, 181468], [28, 181808], [33, 182384], [37, 182589], [42, 183069], [45, 183329], [48, 183529], [52, 183809], [55, 183949], [62, 184749], [67, 184929], [70, 185189], [77, 185529], [84, 186069], [90, 186389], [93, 186509]]}, {"verse": 23, "start": 187370, "end": 197363, "text": "Pero si tu ojo es maligno, todo tu cuerpo estará en tinieblas. Así que, si la luz que en ti hay es tinieblas, ¿cuántas serán las mismas tinieblas?", "words": [[0, 187370], [5, 187514], [8, 187734], [11, 187914], [15, 188194], [18, 188314], [27, 189314], [32, 189474], [35, 189734], [42, 190054], [49, 190554], [52, 191110], [63, 191822], [67, 192114], [72, 192314], [75, 192514], [78, 192674], [82, 192914], [86, 193154], [89, 193334], [92, 193514], [96, 193794], [99, 194134], [110, 195334], [119, 195874], [125, 196174], [129, 196314], [136, 196654]]}, {"verse": 24, "start": 197713, "end": 211335, "text": "Ninguno puede servir a dos señores; porque o aborrecerá al uno y amará al otro, o se llegará al uno y menospreciará al otro: no podéis servir a Dios y a las riquezas.", "words": [[0, 197713], [8, 198162], [14, 198382], [21, 198782], [23, 198982], [27, 199142], [36, 200120], [43, 200522], [45, 201002], [56, 201942], [59, 202182], [63, 202462], [65, 202722], [71, 203062], [74, 203382], [80, 204142], [82, 204442], [85, 204582], [93, 205022], [96, 205342], [100, 205662], [102, 206452], [116, 207242], [119, 207562], [125, 208295], [128, 208463], [135, 208943], [142, 209443], [144, 209743], [149, 209963], [151, 210303], [153, 210383], [157, 210503]]}, {"verse": 25, "start": 211685, "end": 225057, "text": "Por tanto os digo: No os preocupéis por vuestra vida, qué habéis de comer, o qué habéis de beber; ni por vuestro cuerpo, qué habéis de vestir: ¿no es la vida más que el alimento, y el cuerpo que el vestido?", "words": [[0, 211685], [4, 211878], [10, 212104], [13, 212331], [19, 213087], [22, 213315], [25, 213455], [36, 214235], [40, 214455], [48, 214855], [54, 215515], [58, 215635], [65, 215995], [68, 216135], [75, 216415], [77, 216735], [81, 216915], [88, 217295], [91, 217435], [98, 218262], [101, 218362], [105, 218602], [113, 219002], [121, 219442], [125, 219862], [132, 220282], [135, 220422], [143, 221295], [147, 221484], [150, 221604], [153, 221744], [158, 221944], [162, 222144], [166, 222344], [169, 222484], [179, 222944], [181, 223244], [184, 223424], [191, 223944], [195, 224224], [198, 224344]]}, {"verse": 26, "start": 225407, "end": 237189, "text": "Mirad las aves del cielo, que no siembran, ni siegan, ni recogen en graneros; y vuestro Padre celestial las alimenta. ¿No sois vosotros mucho mejores que ellas?", "words": [[0, 225407], [6, 225774], [10, 225914], [15, 226274], [19, 226454], [26, 226794], [30, 227034], [33, 227194], [43, 228034], [46, 228554], [54, 229074], [57, 229314], [65, 230074], [68, 230254], [78, 231293], [80, 231391], [88, 231731], [94, 232151], [104, 232791], [108, 233171], [118, 234303], [122, 234411], [127, 234851], [136, 235571], [142, 235871], [150, 236291], [154, 236531]]}, {"verse": 27, "start": 237539, "end": 243289, "text": "Pero ¿quién de vosotros podrá, preocupándose, añadir a su estatura un codo?", "words": [[0, 237539], [5, 237661], [12, 238141], [15, 238241], [24, 238641], [31, 239101], [46, 240661], [53, 241281], [55, 241381], [58, 241541], [67, 242021], [70, 242221]]}, {"verse": 28, "start": 243639, "end": 251726, "text": "Y por el vestido ¿por qué os preocupáis? Observad los lirios del campo, cómo crecen; no trabajan ni hilan;", "words": [[0, 243639], [2, 243639], [6, 243804], [9, 243944], [17, 244606], [22, 244729], [26, 245029], [29, 245209], [41, 246545], [50, 247127], [54, 247307], [61, 247597], [65, 247887], [72, 248647], [77, 248907], [85, 249864], [88, 250071], [97, 250831], [100, 251071]]}, {"verse": 29, "start": 252076, "end": 257405, "text": "Pero os digo, que ni aun Salomón con toda su gloria fue vestido así como uno de ellos.", "words": [[0, 252076], [5, 252220], [8, 252400], [14, 252660], [18, 252970], [21, 253280], [25, 253540], [33, 254280], [37, 254460], [42, 254740], [45, 255000], [52, 255380], [56, 255600], [64, 256040], [68, 256200], [73, 256480], [77, 256680], [80, 256860]]}, {"verse": 30, "start": 257755, "end": 268464, "text": "Y si la hierba del campo que hoy es, y mañana es echada en el horno, Dios la viste así, ¿no hará mucho más a vosotros, hombres de poca fe?", "words": [[0, 257755], [2, 257879], [5, 257999], [8, 258159], [15, 258619], [19, 258779], [25, 259259], [29, 259519], [33, 259739], [37, 260619], [39, 260699], [46, 261019], [49, 261279], [56, 261659], [59, 261799], [62, 261919], [69, 262699], [74, 263019], [77, 263339], [83, 263659], [88, 264479], [92, 264879], [97, 265159], [103, 265419], [107, 265779], [109, 265959], [119, 266819], [127, 267399], [130, 267719], [135, 268059]]}, {"verse": 31, "start": 268814, "end": 274706, "text": "No os preocupéis pues, diciendo: ¿Qué comeremos, o qué beberemos, o con qué nos vestiremos?", "words": [[0, 268814], [3, 269101], [6, 269361], [17, 270141], [23, 270741], [33, 271761], [38, 271855], [49, 272435], [51, 272795], [55, 272955], [66, 273515], [68, 273895], [72, 274135], [76, 274315], [80, 274510]]}, {"verse": 32, "start": 275056, "end": 283342, "text": "Porque los Gentiles buscan todas estas cosas: que vuestro Padre celestial sabe que necesitáis todas estas cosas.", "words": [[0, 275713], [7, 275993], [11, 276173], [20, 276673], [27, 277113], [33, 277393], [39, 277713], [46, 278707], [50, 278962], [58, 279322], [64, 279742], [74, 280302], [79, 280682], [83, 280922], [94, 281942], [100, 282242], [106, 282602]]}, {"verse": 33, "start": 283692, "end": 291325, "text": "Pero buscad primeramente el reino de Dios y su justicia, y todas estas cosas os serán añadidas.", "words": [[0, 283692], [5, 283859], [12, 284359], [25, 285139], [28, 285319], [34, 285719], [37, 285859], [42, 286159], [44, 286619], [47, 286779], [57, 287459], [59, 288199], [65, 288479], [71, 288779], [77, 289279], [80, 289939], [86, 290379]]}, {"verse": 34, "start": 291675, "end": 299666, "text": "Así que, no os preocupéis por el día de mañana; que el día de mañana traerá su fatiga: basta al día su afán.", "words": [[0, 291675], [4, 291965], [9, 292185], [12, 292405], [15, 292605], [26, 293285], [30, 293505], [33, 293645], [37, 293805], [40, 293945], [48, 294780], [52, 294903], [55, 295083], [59, 295323], [62, 295463], [69, 295943], [76, 296643], [79, 296803], [87, 297878], [93, 298324], [96, 298624], [100, 298984], [103, 299084]]}]}