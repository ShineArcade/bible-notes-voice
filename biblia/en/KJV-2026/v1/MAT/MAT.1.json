{"book": "MAT", "chapter": 1, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 192415, "verses": [{"verse": 1, "start": 300, "end": 5076, "text": "The book of the generation of Jesus Christ, the son of David, the son of Abraham.", "words": [[0, 300], [4, 388], [9, 568], [12, 728], [16, 828], [27, 1368], [30, 1628], [36, 1928], [44, 2808], [48, 2888], [52, 3148], [55, 3248], [62, 3908], [66, 4008], [70, 4228], [73, 4348]]}, {"verse": 2, "start": 5526, "end": 11764, "text": "Abraham begot Isaac; and Isaac begot Jacob; and Jacob begot Judas and his brethren;", "words": [[0, 5526], [8, 5988], [14, 6408], [21, 7273], [25, 7395], [31, 7695], [37, 8115], [44, 8982], [48, 9102], [54, 9402], [60, 9842], [66, 10182], [70, 10462], [74, 10602]]}, {"verse": 3, "start": 12214, "end": 19466, "text": "And Judas begot Phares and Zara of Thamar; and Phares begot Esrom; and Esrom begot Aram;", "words": [[0, 12214], [4, 12523], [10, 12863], [16, 13353], [23, 13843], [27, 14173], [32, 14503], [35, 14937], [43, 15610], [47, 15853], [54, 16133], [60, 16808], [67, 17707], [71, 18043], [77, 18413], [83, 18963]]}, {"verse": 4, "start": 19915, "end": 26164, "text": "And Aram begot Aminadab; and Aminadab begot Naasson; and Naasson begot Salmon;", "words": [[0, 19915], [4, 20233], [9, 20583], [15, 21318], [25, 22295], [29, 22641], [38, 23021], [44, 23618], [53, 24453], [57, 24777], [65, 25137], [71, 25537]]}, {"verse": 5, "start": 26614, "end": 33199, "text": "And Salmon begot Booz of Rachab; and Booz begot Obed of Ruth; and Obed begot Jesse;", "words": [[0, 26614], [4, 26761], [11, 27161], [17, 27721], [22, 28281], [25, 28757], [33, 29459], [37, 29719], [42, 29979], [48, 30379], [53, 30739], [56, 30899], [62, 31748], [66, 31885], [71, 32165], [77, 32605]]}, {"verse": 6, "start": 33649, "end": 39473, "text": "And Jesse begot David the king; and David the king begot Solomon of her that had been the wife of Urias;", "words": [[0, 33649], [4, 33779], [10, 34039], [16, 34499], [22, 34779], [26, 34979], [32, 35758], [36, 35884], [42, 36164], [46, 36324], [51, 36544], [57, 36924], [65, 37344], [68, 37624], [72, 37804], [77, 37984], [81, 38124], [86, 38284], [90, 38404], [95, 38604], [98, 38764]]}, {"verse": 7, "start": 39923, "end": 46155, "text": "And Solomon begot Roboam; and Roboam begot Abia; and Abia begot Asa;", "words": [[0, 39923], [4, 40069], [12, 40489], [18, 41148], [26, 42043], [30, 42489], [37, 42966], [43, 43444], [49, 44165], [53, 44310], [58, 44950], [64, 45589]]}, {"verse": 8, "start": 46605, "end": 52885, "text": "And Asa begot Josaphat; and Josaphat begot Joram; and Joram begot Ozias;", "words": [[0, 46605], [4, 46750], [8, 47130], [14, 47816], [24, 48736], [28, 49119], [37, 49539], [43, 49999], [50, 50952], [54, 51232], [60, 51672], [66, 52279]]}, {"verse": 9, "start": 53335, "end": 59679, "text": "And Ozias begot Joatham; and Joatham begot Achaz; and Achaz begot Ezekias;", "words": [[0, 53335], [4, 53639], [10, 53979], [16, 54537], [25, 55342], [29, 55735], [37, 56135], [43, 56730], [50, 57624], [54, 57785], [60, 58245], [66, 58999]]}, {"verse": 10, "start": 60129, "end": 67738, "text": "And Ezekias begot Manasses; and Manasses begot Amon; and Amon begot Josias;", "words": [[0, 60129], [4, 60271], [12, 60975], [18, 61678], [28, 62619], [32, 63015], [41, 63425], [47, 64232], [53, 65283], [57, 65780], [62, 66320], [68, 67061]]}, {"verse": 11, "start": 68188, "end": 74324, "text": "And Josias begot Jechonias and his brethren, about the time they were carried away to Babylon:", "words": [[0, 68188], [4, 68351], [11, 68931], [17, 69531], [27, 70131], [31, 70311], [35, 70471], [45, 70911], [51, 71451], [55, 71691], [60, 71971], [65, 72171], [70, 72311], [78, 72651], [83, 72951], [86, 73151]]}, {"verse": 12, "start": 74774, "end": 81476, "text": "And after they were brought to Babylon, Jechonias begot Salathiel; and Salathiel begot Zorobabel;", "words": [[0, 74774], [4, 74936], [10, 75236], [15, 75416], [20, 75576], [28, 75836], [31, 76016], [40, 76726], [50, 77436], [56, 78119], [67, 79032], [71, 79582], [81, 80162], [87, 80847]]}, {"verse": 13, "start": 81926, "end": 89057, "text": "And Zorobabel begot Abiud; and Abiud begot Eliakim; and Eliakim begot Azor;", "words": [[0, 81926], [4, 82369], [14, 82849], [20, 83462], [27, 84334], [31, 84683], [37, 85073], [43, 85717], [52, 86597], [56, 87218], [64, 87878], [70, 88338]]}, {"verse": 14, "start": 89507, "end": 95940, "text": "And Azor begot Sadoc; and Sadoc begot Achim; and Achim begot Eliud;", "words": [[0, 89507], [4, 89708], [9, 90188], [15, 90910], [22, 91932], [26, 92470], [32, 93014], [38, 93557], [45, 94325], [49, 94587], [55, 94887], [61, 95448]]}, {"verse": 15, "start": 96390, "end": 102184, "text": "And Eliud begot Eleazar; and Eleazar begot Matthan; and Matthan begot Jacob;", "words": [[0, 96390], [4, 96737], [10, 97117], [16, 97698], [25, 98532], [29, 98846], [37, 99196], [43, 99761], [52, 100565], [56, 100852], [64, 101182], [70, 101562]]}, {"verse": 16, "start": 102634, "end": 108872, "text": "And Jacob begot Joseph the husband of Mary, of whom was born Jesus, who is called Christ.", "words": [[0, 102634], [4, 102806], [10, 103186], [16, 103686], [23, 104086], [27, 104326], [35, 104626], [38, 104886], [44, 105626], [47, 105826], [52, 106026], [56, 106266], [61, 106606], [68, 107666], [72, 107746], [75, 107866], [82, 108186]]}, {"verse": 17, "start": 109322, "end": 123425, "text": "So all the generations from Abraham to David are fourteen generations; and from David until the carrying away into Babylon are fourteen generations; and from the carrying away into Babylon to Christ are fourteen generations.", "words": [[0, 109322], [3, 109462], [7, 109742], [11, 109902], [23, 110442], [28, 110782], [36, 111222], [39, 111542], [45, 111902], [49, 112282], [58, 112662], [71, 114086], [75, 114215], [80, 114375], [86, 114735], [92, 115035], [96, 115255], [105, 115595], [110, 115935], [115, 116195], [123, 116635], [127, 117065], [136, 117495], [149, 118892], [153, 119033], [158, 119193], [162, 119333], [171, 119713], [176, 120033], [181, 120293], [189, 120693], [192, 121093], [199, 121553], [203, 121903], [212, 122253]]}, {"verse": 18, "start": 123875, "end": 133794, "text": "¶ Now the birth of Jesus Christ was in this way: When as his mother Mary was espoused to Joseph, before they came together, she was found with child of the Holy Spirit.", "words": [[2, 123875], [6, 124098], [10, 124278], [16, 124498], [19, 124678], [25, 124958], [32, 125378], [36, 125758], [39, 125958], [44, 126198], [49, 126999], [54, 127186], [57, 127306], [61, 127446], [68, 127746], [73, 128126], [77, 128366], [86, 128926], [89, 129106], [97, 129506], [104, 129926], [109, 130186], [114, 130446], [124, 131366], [128, 131486], [132, 131646], [138, 131926], [143, 132166], [149, 132526], [152, 132766], [156, 132886], [161, 133106]]}, {"verse": 19, "start": 134244, "end": 141528, "text": "Then Joseph her husband, being a just man, and not willing to make her a public example, was minded to put her away privately.", "words": [[0, 134244], [5, 134473], [12, 135013], [16, 135053], [25, 135733], [31, 135933], [33, 136093], [38, 136233], [43, 136593], [47, 137113], [51, 137273], [59, 137513], [62, 137713], [67, 137913], [71, 138073], [73, 138153], [80, 138433], [89, 139333], [93, 139613], [100, 139933], [103, 140153], [107, 140333], [111, 140513], [116, 140773]]}, {"verse": 20, "start": 141978, "end": 155367, "text": "But while he thought on these things, behold, the angel of the Lord appeared to him in a dream, saying, Joseph, you son of David, fear not to take to you Mary your wife: for that which is conceived in her is of the Holy Spirit.", "words": [[0, 141978], [4, 142121], [10, 142361], [13, 142541], [21, 142821], [24, 143001], [30, 143201], [38, 144001], [46, 144901], [50, 144961], [56, 145341], [59, 145521], [63, 145641], [68, 145841], [77, 146221], [80, 146441], [84, 146621], [87, 146741], [89, 146841], [96, 147181], [104, 148798], [112, 149054], [116, 149314], [120, 149594], [123, 149714], [130, 150294], [135, 150474], [139, 150674], [142, 150854], [147, 151054], [150, 151214], [154, 151474], [159, 151734], [164, 151954], [170, 152704], [174, 152784], [179, 152944], [185, 153164], [188, 153304], [198, 153684], [201, 153924], [205, 154064], [208, 154284], [211, 154384], [215, 154484], [220, 154744]]}, {"verse": 21, "start": 155817, "end": 162210, "text": "And she shall bring forth a son, and you shall call his name JESUS: for he shall save his people from their sins.", "words": [[0, 155817], [4, 155955], [8, 156115], [14, 156335], [20, 156555], [26, 156815], [28, 157035], [33, 157695], [37, 157955], [41, 158095], [47, 158275], [52, 158495], [56, 158715], [61, 158995], [68, 159990], [72, 160097], [75, 160237], [81, 160417], [86, 160757], [90, 160937], [97, 161257], [102, 161477], [108, 161677]]}, {"verse": 22, "start": 162560, "end": 168816, "text": "Now all this was done, that it might be fulfilled which was spoken of the Lord by the prophet, saying,", "words": [[0, 162560], [4, 162763], [8, 163083], [13, 163303], [17, 163463], [23, 164303], [28, 164483], [31, 164603], [37, 164803], [40, 165043], [50, 165763], [56, 165903], [60, 166083], [67, 166463], [70, 166663], [74, 166803], [79, 167043], [82, 167303], [86, 167443], [95, 168103]]}, {"verse": 23, "start": 169266, "end": 178895, "text": "Behold, a virgin shall be with child, and shall bring forth a son, and they shall call his name Emmanuel, which being interpreted is, God with us.", "words": [[0, 169266], [8, 169762], [10, 169802], [17, 170122], [23, 170442], [26, 170642], [31, 170822], [38, 171882], [42, 171922], [48, 172142], [54, 172422], [60, 172702], [62, 172922], [67, 173782], [71, 173862], [76, 173962], [82, 174142], [87, 174382], [91, 174622], [96, 174902], [106, 176122], [112, 176302], [118, 176602], [130, 177222], [134, 177582], [138, 178162], [143, 178442]]}, {"verse": 24, "start": 179345, "end": 186003, "text": "Then Joseph being raised from sleep did as the angel of the Lord had bidden him, and took to him his wife:", "words": [[0, 179345], [5, 179553], [12, 180133], [18, 180333], [25, 180713], [30, 180993], [36, 181853], [40, 181993], [43, 182173], [47, 182353], [53, 182673], [56, 182893], [60, 183033], [65, 183273], [69, 183513], [76, 183873], [81, 184073], [85, 184573], [90, 184813], [93, 185013], [97, 185193], [101, 185373]]}, {"verse": 25, "start": 186453, "end": 192015, "text": "And knew her not till she had brought forth her firstborn son: and he called his name JESUS.", "words": [[0, 186453], [4, 186616], [9, 186856], [13, 187036], [17, 187316], [22, 187596], [26, 187796], [30, 187976], [38, 188196], [44, 188536], [48, 188736], [58, 189376], [63, 190334], [67, 190459], [70, 190559], [77, 190839], [81, 191039], [86, 191279]]}]}