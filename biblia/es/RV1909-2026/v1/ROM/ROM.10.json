{"book": "ROM", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 150566, "verses": [{"verse": 1, "start": 300, "end": 6361, "text": "Hermanos, ciertamente la voluntad de mi corazón y mi oración a Dios sobre Israel, es para salvación.", "words": [[0, 518], [10, 778], [22, 1418], [25, 1558], [34, 2078], [37, 2198], [40, 2278], [48, 2718], [50, 2978], [53, 3078], [61, 3578], [63, 3778], [68, 3958], [74, 4298], [82, 4758], [85, 5338], [90, 5558]]}, {"verse": 2, "start": 6811, "end": 11981, "text": "Porque yo les doy testimonio que tienen celo de Dios, pero no conforme al conocimiento.", "words": [[0, 6811], [7, 7011], [10, 7191], [14, 7331], [18, 7571], [29, 8171], [33, 8271], [40, 8571], [45, 9051], [48, 9151], [54, 9951], [59, 10191], [62, 10391], [71, 10971], [74, 11051]]}, {"verse": 3, "start": 12431, "end": 19938, "text": "Porque ignorando la justicia de Dios, y procurando establecer la suya propia, no se han sujetado a la justicia de Dios.", "words": [[0, 12431], [7, 12671], [17, 13291], [20, 13431], [29, 14011], [32, 14151], [38, 14431], [40, 15051], [51, 15591], [62, 16211], [65, 16371], [70, 16691], [78, 17011], [81, 17631], [84, 17811], [88, 17971], [97, 18591], [99, 18671], [102, 18751], [111, 19251], [114, 19391]]}, {"verse": 4, "start": 20388, "end": 24399, "text": "Porque el fin de la ley es Cristo, para justicia a todo aquel que cree.", "words": [[0, 20388], [7, 20616], [10, 20756], [14, 20936], [17, 21076], [20, 21176], [24, 21396], [27, 21716], [35, 22036], [40, 22396], [49, 23076], [51, 23296], [56, 23456], [62, 23816], [66, 23916]]}, {"verse": 5, "start": 24849, "end": 30756, "text": "Porque Moisés describe la justicia que es por la ley: Que el hombre que haga estas cosas, vivirá por ellas.", "words": [[0, 24849], [7, 25053], [14, 25433], [23, 25973], [26, 26153], [35, 26713], [39, 26873], [42, 27033], [46, 27193], [49, 27353], [54, 28002], [58, 28098], [61, 28218], [68, 28418], [72, 28658], [77, 28858], [83, 29098], [90, 29538], [97, 30078], [101, 30238]]}, {"verse": 6, "start": 31206, "end": 39032, "text": "Pero la justicia que es por la fe dice así: No digas en tu corazón: ¿Quién subirá al cielo? (esto es, para traer abajo a Cristo:)", "words": [[0, 31206], [5, 31332], [8, 31452], [17, 32032], [21, 32192], [24, 32332], [28, 32472], [31, 32632], [34, 32832], [39, 33052], [44, 33852], [47, 33989], [53, 34329], [56, 34449], [59, 34529], [68, 35487], [75, 35687], [82, 36087], [85, 36167], [92, 36929], [98, 37212], [102, 37372], [107, 37592], [113, 37972], [119, 38232], [121, 38452]]}, {"verse": 7, "start": 39482, "end": 44316, "text": "O, ¿quién descenderá al abismo? (esto es, para volver a traer a Cristo de los muertos.)", "words": [[0, 39482], [3, 39647], [10, 39947], [21, 40607], [24, 40727], [32, 41587], [38, 41867], [42, 42047], [47, 42247], [54, 42527], [56, 42707], [62, 43007], [64, 43107], [71, 43347], [74, 43547], [78, 43647]]}, {"verse": 8, "start": 44766, "end": 52345, "text": "Pero ¿qué dice? Cercana está la palabra, en tu boca y en tu corazón. Esta es la palabra de fe, la cual predicamos:", "words": [[0, 44766], [5, 44909], [10, 45069], [16, 46029], [24, 46524], [29, 46764], [32, 46904], [41, 47324], [44, 47564], [47, 47704], [52, 48044], [54, 48244], [57, 48324], [60, 48464], [69, 49486], [74, 49771], [77, 49951], [80, 50071], [88, 50411], [91, 50611], [95, 51131], [98, 51291], [103, 51491]]}, {"verse": 9, "start": 52795, "end": 60490, "text": "Que si confiesas con tu boca que Jesús es el Señor, y creyeres en tu corazón que Dios le levantó de los muertos, serás salvo.", "words": [[0, 52795], [4, 52954], [7, 53094], [17, 53754], [21, 53934], [24, 54094], [29, 54394], [33, 54594], [39, 54894], [42, 55114], [45, 55254], [52, 55694], [54, 56134], [63, 56614], [66, 56814], [69, 56914], [77, 57374], [81, 57634], [86, 57874], [89, 58094], [97, 58574], [100, 58674], [104, 58794], [113, 59344], [119, 59894]]}, {"verse": 10, "start": 60940, "end": 66212, "text": "Porque con el corazón se cree para justicia; pero con la boca se hace confesión para salvación.", "words": [[0, 60940], [7, 61141], [11, 61341], [14, 61441], [22, 61881], [25, 62101], [30, 62341], [35, 62561], [45, 63662], [50, 63799], [54, 63999], [57, 64119], [62, 64359], [65, 64579], [70, 64719], [80, 65279], [85, 65479]]}, {"verse": 11, "start": 66662, "end": 71227, "text": "Porque la Escritura dice: Todo aquel que en él cree, no será avergonzado.", "words": [[0, 66662], [7, 66843], [10, 67003], [20, 67503], [26, 68323], [31, 68467], [37, 68867], [41, 68967], [44, 69107], [47, 69227], [53, 69527], [56, 70087], [61, 70687]]}, {"verse": 12, "start": 71677, "end": 79005, "text": "Porque no hay diferencia de judío y de griego: porque el mismo que es Señor de todos, rico es para con todos los que le invocan:", "words": [[0, 71677], [7, 71854], [10, 72074], [14, 72214], [25, 72654], [28, 72914], [34, 73334], [36, 73454], [39, 73574], [47, 74444], [54, 74623], [57, 74763], [63, 75023], [67, 75263], [70, 75463], [76, 75703], [79, 75923], [86, 76583], [91, 76983], [94, 77223], [99, 77443], [103, 77643], [109, 77923], [113, 78083], [117, 78283], [120, 78383]]}, {"verse": 13, "start": 79455, "end": 82639, "text": "Porque todo aquel que invoque el nombre del Señor, será salvo.", "words": [[0, 79455], [7, 79635], [12, 79895], [18, 80275], [22, 80375], [30, 80775], [33, 80915], [40, 81175], [44, 81355], [51, 81715], [56, 82055]]}, {"verse": 14, "start": 83089, "end": 91995, "text": "¿Cómo, pues invocarán a aquel en el cual no han creído? ¿y cómo creerán a aquel de quien no han oído? ¿y cómo oirán sin haber quien les predique?", "words": [[0, 83089], [7, 83293], [12, 83633], [22, 84493], [24, 84573], [30, 84993], [33, 85133], [36, 85273], [41, 85473], [44, 85733], [48, 85873], [56, 86802], [59, 86907], [64, 87167], [72, 87767], [74, 87887], [80, 88187], [83, 88307], [89, 88507], [92, 88767], [96, 88887], [102, 89678], [105, 89778], [110, 90038], [116, 90478], [120, 90638], [126, 90858], [132, 91118], [136, 91338]]}, {"verse": 15, "start": 92445, "end": 102207, "text": "¿Y cómo predicarán si no son enviados? Como está escrito: ¡Cuán hermosos son los pies de los que anuncian el evangelio de la paz, de los que anuncian el evangelio de los bienes!", "words": [[0, 92445], [3, 92529], [8, 92729], [19, 93409], [22, 93569], [25, 93689], [29, 93889], [39, 94933], [44, 95112], [49, 95312], [58, 96196], [64, 96378], [73, 96898], [77, 97058], [81, 97218], [86, 97498], [89, 97718], [93, 97858], [97, 98018], [106, 98458], [109, 98558], [119, 99078], [122, 99158], [125, 99278], [130, 99738], [133, 100038], [137, 100178], [141, 100298], [150, 100738], [153, 100818], [163, 101358], [166, 101418], [170, 101558]]}, {"verse": 16, "start": 102657, "end": 108982, "text": "Pero no todos obedecen al evangelio; pues Isaías dice: Señor, ¿quién ha creído a nuestro anuncio?", "words": [[0, 102657], [5, 102798], [8, 102958], [14, 103218], [23, 103838], [26, 103998], [37, 104981], [42, 105144], [49, 105724], [55, 106625], [62, 107502], [69, 107602], [72, 107742], [79, 108022], [81, 108122], [89, 108262]]}, {"verse": 17, "start": 109432, "end": 113080, "text": "Luego la fe es por el oír; y el oír por la palabra de Dios.", "words": [[0, 109432], [6, 109650], [9, 109830], [12, 110070], [15, 110350], [19, 110550], [22, 110670], [27, 111386], [29, 111507], [32, 111587], [36, 111807], [40, 111967], [43, 112087], [51, 112407], [54, 112587]]}, {"verse": 18, "start": 113530, "end": 121892, "text": "Pero digo: ¿No han oído? Antes bien, por toda la tierra ha salido la fama de ellos, y hasta los confines del mundo las palabras de ellos.", "words": [[0, 113530], [5, 113668], [11, 114416], [15, 114573], [19, 114693], [25, 115451], [31, 115738], [37, 116018], [41, 116298], [46, 116518], [49, 116718], [56, 117078], [59, 117378], [66, 117758], [69, 117878], [74, 118198], [77, 118318], [84, 118598], [86, 119118], [92, 119298], [96, 119498], [105, 119978], [109, 120178], [115, 120438], [119, 120718], [128, 121118], [131, 121378]]}, {"verse": 19, "start": 122342, "end": 135712, "text": "Pero digo: ¿No ha conocido esto Israel? Primeramente Moisés dice: Yo os provocaré a celos con gente que no es mía; con gente insensata os provocaré a ira.", "words": [[0, 122342], [5, 122484], [11, 123229], [15, 123588], [18, 123708], [27, 124288], [32, 124588], [40, 125440], [53, 126083], [60, 126463], [66, 127453], [69, 127756], [72, 128036], [82, 128563], [84, 129089], [90, 129616], [94, 129916], [100, 130296], [104, 130576], [107, 130756], [110, 130936], [115, 131952], [119, 132109], [125, 132409], [135, 133129], [138, 133389], [148, 134029], [150, 134169]]}, {"verse": 20, "start": 136012, "end": 143644, "text": "E Isaías con osadía dice: fui hallado de los que no me buscaban; me manifesté a los que no preguntaban por mí.", "words": [[0, 136012], [2, 136137], [9, 136544], [13, 136950], [20, 137357], [26, 138118], [30, 138277], [38, 138757], [41, 138897], [45, 139037], [49, 139217], [52, 139357], [55, 139477], [65, 140827], [68, 140911], [78, 141591], [80, 141791], [84, 141931], [88, 142071], [91, 142191], [103, 142831], [107, 143071]]}, {"verse": 21, "start": 143944, "end": 150166, "text": "Pero acerca de Israel dice: Todo el día extendí mis manos a un pueblo rebelde y contradictor.", "words": [[0, 143944], [5, 144086], [12, 144406], [15, 144666], [22, 144986], [28, 145889], [33, 146029], [36, 146249], [40, 146469], [48, 147069], [52, 147169], [58, 147509], [60, 147829], [63, 147949], [70, 148229], [78, 148909], [80, 149069]]}]}