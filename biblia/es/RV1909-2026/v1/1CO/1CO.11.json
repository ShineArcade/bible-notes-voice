{"book": "1CO", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 227349, "verses": [{"verse": 1, "start": 300, "end": 3426, "text": "Sed imitadores de mí, así como yo de Cristo.", "words": [[0, 473], [4, 653], [15, 1173], [18, 1413], [22, 2033], [26, 2233], [31, 2533], [34, 2693], [37, 2833]]}, {"verse": 2, "start": 3876, "end": 12225, "text": "Y os alabo, hermanos, que en todo os acordáis de mí, y retenéis las instrucciones mías, de la manera que os enseñé.", "words": [[0, 3876], [2, 3975], [5, 4115], [12, 4435], [22, 5095], [26, 5375], [29, 5555], [34, 5735], [37, 6015], [46, 6475], [49, 6655], [53, 6875], [55, 7475], [64, 7995], [68, 8135], [82, 8795], [88, 9395], [91, 9715], [94, 9835], [101, 10095], [105, 10355], [108, 10475]]}, {"verse": 3, "start": 12675, "end": 21363, "text": "Pero quiero que sepáis, que Cristo es la cabeza de todo varón; y el varón es la cabeza de la mujer; y Dios la cabeza de Cristo.", "words": [[0, 12675], [5, 12812], [12, 13112], [16, 13272], [24, 13832], [28, 14252], [35, 14712], [38, 14972], [41, 15092], [48, 15492], [51, 15712], [56, 15872], [63, 16699], [65, 16827], [68, 16927], [74, 17267], [77, 17387], [80, 17487], [87, 17867], [90, 18047], [93, 18147], [100, 18937], [102, 19083], [107, 19283], [110, 19483], [117, 19823], [120, 20023]]}, {"verse": 4, "start": 21813, "end": 26211, "text": "Todo varón que ora o profetiza cubierta la cabeza, deshonra su cabeza.", "words": [[0, 21813], [5, 21977], [11, 22397], [15, 22557], [19, 22797], [21, 22977], [31, 23577], [40, 24137], [43, 24257], [51, 24677], [60, 25437], [63, 25597]]}, {"verse": 5, "start": 26661, "end": 34673, "text": "Pero toda mujer que ora o profetiza no cubierta su cabeza, deshonra su cabeza; porque lo mismo es que si se afeitara la cabeza.", "words": [[0, 26661], [5, 26803], [10, 27023], [16, 27403], [20, 27683], [24, 27923], [26, 28063], [36, 28703], [39, 28903], [48, 29443], [51, 29563], [59, 30463], [68, 30903], [71, 31063], [79, 31924], [86, 32104], [89, 32244], [95, 32544], [98, 32884], [102, 33104], [105, 33264], [108, 33604], [117, 33944], [120, 34024]]}, {"verse": 6, "start": 35123, "end": 43478, "text": "Porque si la mujer no se cubre, córtese también el cabello: y si es vergonzoso para la mujer cortarse el cabello o afeitarse la cabeza, cúbrase.", "words": [[0, 35123], [7, 35288], [10, 35428], [13, 35548], [19, 35788], [22, 36048], [25, 36208], [32, 37088], [40, 37468], [48, 37808], [51, 37968], [60, 38781], [62, 38876], [65, 38976], [68, 39136], [79, 39716], [84, 39956], [87, 40076], [93, 40296], [102, 40856], [105, 40976], [113, 41396], [115, 41536], [125, 42036], [128, 42156], [136, 42896]]}, {"verse": 7, "start": 43928, "end": 50541, "text": "Porque el varón no ha de cubrir la cabeza, porque es imagen y gloria de Dios: pero la mujer es gloria del varón.", "words": [[0, 43928], [7, 44132], [10, 44272], [16, 44572], [19, 44752], [22, 44872], [25, 44972], [32, 45312], [35, 45412], [43, 46172], [50, 46472], [53, 46652], [60, 47032], [62, 47332], [69, 47712], [72, 47852], [78, 48644], [83, 48783], [86, 48903], [92, 49223], [95, 49463], [102, 49843], [106, 50023]]}, {"verse": 8, "start": 50991, "end": 54007, "text": "Porque el varón no es de la mujer, sino la mujer del varón.", "words": [[0, 50991], [7, 51208], [10, 51348], [16, 51648], [19, 51848], [22, 51968], [25, 52068], [28, 52188], [35, 52748], [40, 52928], [43, 53088], [49, 53348], [53, 53528]]}, {"verse": 9, "start": 54457, "end": 59514, "text": "Porque tampoco el varón fue creado por causa de la mujer, sino la mujer por causa del varón.", "words": [[0, 54457], [7, 54637], [15, 54957], [18, 55237], [24, 55557], [28, 55717], [35, 56197], [39, 56397], [45, 56617], [48, 56837], [51, 56937], [58, 57257], [63, 57817], [66, 57997], [72, 58277], [76, 58557], [82, 58777], [86, 59057]]}, {"verse": 10, "start": 59964, "end": 65397, "text": "Por lo cual, la mujer debe tener señal de autoridad sobre su cabeza, por causa de los ángeles.", "words": [[0, 59964], [4, 60092], [7, 60192], [13, 60472], [16, 60652], [22, 60952], [27, 61292], [33, 61612], [39, 62072], [42, 62152], [52, 62672], [58, 62932], [61, 63132], [69, 63552], [73, 64132], [79, 64392], [82, 64592], [86, 64672]]}, {"verse": 11, "start": 65847, "end": 69537, "text": "Pero ni el varón sin la mujer, ni la mujer sin el varón, en el Señor.", "words": [[0, 65847], [5, 65992], [8, 66152], [11, 66272], [17, 66592], [21, 66772], [24, 66912], [31, 67432], [34, 67532], [37, 67652], [43, 67872], [47, 68132], [50, 68272], [57, 68712], [60, 68932], [63, 69032]]}, {"verse": 12, "start": 69987, "end": 75472, "text": "Porque como la mujer es del varón, así también el varón es por la mujer: pero todo de Dios.", "words": [[0, 69987], [7, 70211], [12, 70491], [15, 70611], [21, 70931], [24, 71131], [28, 71271], [35, 72011], [39, 72251], [47, 72651], [50, 72871], [56, 73171], [59, 73291], [63, 73491], [66, 73591], [73, 74348], [78, 74490], [83, 74750], [86, 74990]]}, {"verse": 13, "start": 75922, "end": 80202, "text": "Juzgad vosotros mismos: ¿es apropiado orar la mujer a Dios no cubierta?", "words": [[0, 75922], [7, 76353], [16, 76813], [24, 77765], [28, 77926], [38, 78426], [43, 78706], [46, 78806], [52, 79046], [54, 79206], [59, 79386], [62, 79546]]}, {"verse": 14, "start": 80652, "end": 85899, "text": "La misma naturaleza ¿no os enseña que al hombre sea deshonroso dejarse crecer el cabello?", "words": [[0, 80652], [3, 80749], [9, 81009], [20, 81849], [24, 82069], [27, 82269], [34, 82809], [38, 82989], [41, 83149], [48, 83349], [52, 83649], [63, 84369], [71, 84809], [78, 85189], [81, 85329]]}, {"verse": 15, "start": 86349, "end": 92752, "text": "Por el contrario, a la mujer dejarse crecer el cabello le es honroso; porque en lugar de velo le es dado el cabello.", "words": [[0, 86349], [4, 86475], [7, 86575], [18, 87215], [20, 87295], [23, 87375], [29, 87615], [37, 88175], [44, 88535], [47, 88675], [55, 89115], [58, 89295], [61, 89730], [70, 90408], [77, 90635], [80, 90775], [86, 90995], [89, 91255], [94, 91535], [97, 91665], [100, 91795], [105, 92035], [108, 92195]]}, {"verse": 16, "start": 93202, "end": 99706, "text": "Con todo eso, si alguno parece ser contencioso, nosotros no tenemos tal costumbre, ni las iglesias de Dios.", "words": [[0, 93202], [4, 93324], [9, 93544], [14, 93964], [17, 94064], [24, 94464], [31, 94744], [35, 95044], [48, 96224], [57, 96544], [60, 96904], [68, 97244], [72, 97504], [83, 98164], [86, 98464], [90, 98664], [99, 99124], [102, 99264]]}, {"verse": 17, "start": 100156, "end": 105381, "text": "Pero os doy esta instrucción sin alabaros, porque os reunís no para lo mejor, sino para lo peor.", "words": [[0, 100156], [5, 100313], [8, 100473], [12, 100733], [17, 100913], [29, 101493], [33, 101673], [43, 102413], [50, 102573], [53, 102773], [60, 103193], [63, 103373], [68, 103573], [71, 103733], [78, 104373], [83, 104533], [88, 104793], [91, 104953]]}, {"verse": 18, "start": 105831, "end": 112026, "text": "Porque lo primero, cuando os juntáis en la iglesia, oigo que hay entre vosotros divisiones; y en parte lo creo.", "words": [[0, 105831], [7, 106016], [10, 106176], [19, 106616], [26, 106796], [29, 107036], [37, 107456], [40, 107576], [43, 107676], [52, 108536], [57, 108716], [61, 108916], [65, 109076], [71, 109276], [80, 109736], [92, 110899], [94, 111039], [97, 111119], [103, 111379], [106, 111599]]}, {"verse": 19, "start": 112476, "end": 118923, "text": "Porque preciso es que haya entre vosotros aun bandos, para que los que son probados se manifiesten entre vosotros.", "words": [[0, 112476], [7, 112681], [15, 113121], [18, 113421], [22, 113581], [27, 113781], [33, 114061], [42, 114621], [46, 114861], [54, 115461], [59, 115981], [63, 116141], [67, 116261], [71, 116421], [75, 116601], [84, 117121], [87, 117321], [99, 117961], [105, 118161]]}, {"verse": 20, "start": 119373, "end": 123486, "text": "Cuando pues os juntáis en uno, esto no es comer la cena del Señor:", "words": [[0, 119373], [7, 119582], [12, 119836], [15, 120089], [23, 120589], [26, 120769], [31, 121489], [36, 121709], [39, 121909], [42, 122009], [48, 122249], [51, 122429], [56, 122689], [60, 122869]]}, {"verse": 21, "start": 123936, "end": 130053, "text": "Porque cada uno toma antes para comer su propia cena; y el uno tiene hambre, y el otro está embriagado.", "words": [[0, 123936], [7, 124120], [12, 124380], [16, 124620], [21, 124980], [27, 125300], [32, 125540], [38, 125800], [41, 126040], [48, 126260], [54, 127159], [56, 127277], [59, 127377], [63, 127517], [69, 127817], [77, 128297], [79, 128697], [82, 128817], [87, 129037], [92, 129277]]}, {"verse": 22, "start": 130503, "end": 141203, "text": "Pues qué, ¿no tenéis casas en que comáis y bebáis? ¿o menospreciáis la iglesia de Dios, y avergonzáis a los que no tienen? ¿Qué os diré? ¿os alabaré? En esto no os alabo.", "words": [[0, 130503], [5, 130650], [10, 130870], [14, 130990], [21, 131370], [27, 131830], [30, 131990], [34, 132110], [41, 132590], [43, 132750], [51, 133677], [54, 134094], [68, 134554], [71, 134694], [79, 135054], [82, 135234], [88, 135534], [90, 135914], [102, 136554], [104, 136714], [108, 136834], [112, 136954], [115, 137094], [123, 137864], [128, 137976], [131, 138076], [137, 139105], [141, 139399], [150, 139937], [153, 140075], [158, 140315], [161, 140595], [164, 140755]]}, {"verse": 23, "start": 141653, "end": 148352, "text": "Porque yo recibí del Señor lo que también os he enseñado: Que el Señor Jesús, la noche que fue entregado, tomó pan;", "words": [[0, 141653], [7, 141845], [10, 142025], [17, 142505], [21, 142585], [27, 142925], [30, 143145], [34, 143265], [42, 143585], [45, 143825], [48, 143945], [58, 144941], [62, 145025], [65, 145105], [71, 145325], [78, 146045], [81, 146145], [87, 146345], [91, 146525], [95, 146705], [106, 147665], [111, 147925]]}, {"verse": 24, "start": 148802, "end": 158550, "text": "Y habiendo dado gracias, lo partió, y dijo: Tomad, comed: esto es mi cuerpo que por vosotros es partido: haced esto en memoria de mí.", "words": [[0, 148802], [2, 148926], [11, 149226], [16, 149446], [25, 150186], [28, 150266], [36, 150726], [38, 150966], [44, 152073], [51, 152411], [58, 152991], [63, 153269], [66, 153489], [69, 153669], [76, 154029], [80, 154309], [84, 154529], [93, 155109], [96, 155289], [105, 156366], [111, 156945], [116, 157465], [119, 157605], [127, 158065], [130, 158225]]}, {"verse": 25, "start": 158850, "end": 170534, "text": "Asimismo tomó también la copa, después de haber cenado, diciendo: Esta copa es el nuevo pacto en mi sangre: haced esto todas las veces que bebáis, en memoria de mí.", "words": [[0, 159149], [9, 159479], [14, 159859], [22, 160079], [25, 160299], [31, 160939], [39, 161179], [42, 161419], [48, 161539], [56, 162359], [66, 163303], [71, 163582], [76, 164102], [79, 164202], [82, 164382], [88, 164622], [94, 165242], [97, 165342], [100, 165522], [108, 166613], [114, 166803], [119, 167303], [125, 167763], [129, 168143], [135, 168463], [139, 168663], [147, 169243], [150, 169583], [158, 170043], [161, 170223]]}, {"verse": 26, "start": 170834, "end": 177485, "text": "Porque todas las veces que coméis este pan, y bebéis esta copa, la muerte del Señor anunciáis hasta que venga.", "words": [[0, 170834], [7, 171041], [13, 171281], [17, 171581], [23, 171901], [27, 172121], [34, 172541], [39, 172801], [44, 173141], [46, 173421], [53, 173801], [58, 174061], [64, 174901], [67, 174961], [74, 175261], [78, 175481], [84, 175821], [94, 176621], [100, 176841], [104, 177021]]}, {"verse": 27, "start": 177935, "end": 185707, "text": "De manera que, cualquiera que coma este pan o beba esta copa del Señor indignamente, será culpado del cuerpo y de la sangre del Señor.", "words": [[0, 177935], [3, 178030], [10, 178250], [15, 178530], [26, 179050], [30, 179210], [35, 179490], [40, 179810], [44, 180210], [46, 180490], [51, 180710], [56, 180930], [61, 181370], [65, 181490], [71, 181810], [85, 182650], [90, 183170], [98, 183710], [102, 183870], [109, 184230], [111, 184510], [114, 184590], [117, 184710], [124, 185050], [128, 185250]]}, {"verse": 28, "start": 186157, "end": 191530, "text": "Por tanto, pruébese cada uno a sí mismo, y coma así de aquel pan, y beba de aquella copa.", "words": [[0, 186157], [4, 186283], [11, 186683], [20, 187243], [25, 187483], [29, 187763], [31, 187943], [34, 188043], [41, 188423], [43, 188783], [48, 189063], [52, 189363], [55, 189503], [61, 189783], [66, 190003], [68, 190383], [73, 190663], [76, 190763], [84, 191083]]}, {"verse": 29, "start": 191980, "end": 198322, "text": "Porque el que come y bebe indignamente, juicio come y bebe para sí, no discerniendo el cuerpo del Señor.", "words": [[0, 191980], [7, 192160], [10, 192280], [14, 192400], [19, 192740], [21, 192960], [26, 193180], [40, 194220], [47, 194780], [52, 195140], [54, 195360], [59, 195660], [64, 195860], [68, 196540], [71, 196620], [84, 197280], [87, 197400], [94, 197620], [98, 197860]]}, {"verse": 30, "start": 198772, "end": 203347, "text": "Por lo cual hay muchos enfermos y debilitados entre vosotros; y muchos duermen.", "words": [[0, 198772], [4, 198873], [7, 199033], [12, 199213], [16, 199393], [23, 199613], [32, 200333], [34, 200473], [46, 201093], [52, 201373], [62, 202443], [64, 202528], [71, 202748]]}, {"verse": 31, "start": 203797, "end": 208145, "text": "Que si nos examinásemos a nosotros mismos, cierto no seríamos juzgados.", "words": [[0, 203797], [4, 203875], [7, 203995], [11, 204115], [24, 204975], [26, 205115], [35, 205355], [43, 206415], [50, 206815], [53, 206895], [62, 207335]]}, {"verse": 32, "start": 208595, "end": 213979, "text": "Pero siendo juzgados, somos castigados del Señor, para que no seamos condenados con el mundo.", "words": [[0, 208595], [5, 208739], [12, 209059], [22, 209699], [28, 210039], [39, 210509], [43, 210979], [50, 211319], [55, 211939], [59, 212079], [62, 212199], [69, 212579], [80, 213159], [84, 213319], [87, 213479]]}, {"verse": 33, "start": 214429, "end": 219600, "text": "Así, que, hermanos míos, cuando os juntáis a comer, esperaos unos a otros.", "words": [[0, 214429], [5, 214674], [10, 214934], [19, 215314], [25, 216034], [32, 216174], [35, 216374], [43, 216814], [45, 216914], [52, 217614], [61, 218274], [66, 218634], [68, 219034]]}, {"verse": 34, "start": 220050, "end": 226949, "text": "Si alguno tiene hambre, coma en su casa, porque no os juntéis para juicio. Las demás cosas ordenaré cuando llegue.", "words": [[0, 220050], [3, 220196], [10, 220576], [16, 220816], [24, 221436], [29, 221636], [32, 221816], [35, 221936], [41, 222576], [48, 222856], [51, 223116], [54, 223236], [62, 223656], [67, 223896], [75, 224795], [79, 224914], [85, 225174], [91, 225574], [100, 226174], [107, 226354]]}]}