{"book": "MAT", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 226009, "verses": [{"verse": 1, "start": 300, "end": 3022, "text": "No juzguéis, para que no seáis juzgados.", "words": [[0, 300], [3, 489], [13, 1109], [18, 1409], [22, 1569], [25, 1749], [31, 2169]]}, {"verse": 2, "start": 3472, "end": 10628, "text": "Porque con el juicio con que juzgáis, seréis juzgados; y con la medida con que medís, os volverán a medir.", "words": [[0, 3472], [7, 3654], [11, 3914], [14, 4034], [21, 4414], [25, 4634], [29, 4814], [38, 5394], [45, 6194], [55, 7344], [57, 7452], [61, 7612], [64, 7772], [71, 8092], [75, 8352], [79, 8852], [86, 9352], [89, 9492], [98, 10052], [100, 10112]]}, {"verse": 3, "start": 11078, "end": 16649, "text": "Y ¿por qué miras la paja que está en el ojo de tu hermano, y no notas la viga que está en tu ojo?", "words": [[0, 11078], [2, 11222], [7, 11422], [11, 11662], [17, 12122], [20, 12242], [25, 12602], [29, 12782], [34, 12962], [37, 13102], [40, 13202], [44, 13442], [47, 13562], [50, 13682], [59, 14502], [61, 14702], [64, 14842], [70, 15222], [73, 15372], [78, 15522], [82, 15742], [87, 15902], [90, 16022], [93, 16182]]}, {"verse": 4, "start": 17099, "end": 24201, "text": "O ¿cómo dirás a tu hermano: Espera, echaré de tu ojo la mota, y he aquí la viga en tu ojo?", "words": [[0, 17099], [2, 17202], [8, 17462], [14, 17942], [16, 18042], [19, 18142], [28, 19094], [36, 20118], [43, 20578], [46, 20698], [49, 20918], [53, 21238], [56, 21418], [62, 22238], [64, 22478], [67, 22638], [72, 22938], [75, 23138], [80, 23338], [83, 23498], [86, 23698]]}, {"verse": 5, "start": 24651, "end": 32469, "text": "¡Hipócrita! echa primero la viga de tu ojo, y entonces verás bien para sacar la paja del ojo de tu hermano.", "words": [[0, 24651], [12, 25906], [17, 26114], [25, 26474], [28, 26724], [33, 26974], [36, 27174], [39, 27334], [44, 27794], [46, 28454], [55, 28914], [61, 29794], [66, 30034], [71, 30354], [77, 30634], [80, 30914], [85, 31174], [89, 31374], [93, 31654], [96, 31774], [99, 31894]]}, {"verse": 6, "start": 32919, "end": 42814, "text": "No deis lo santo a los perros, ni echéis vuestras perlas delante de los cerdos; porque no las pisoteen con sus pies, y vuelvan y os despedacen.", "words": [[0, 32919], [3, 33104], [8, 33377], [11, 33651], [17, 33924], [19, 34044], [23, 34164], [31, 34844], [34, 35144], [41, 35564], [50, 36024], [57, 36504], [65, 36964], [68, 37124], [72, 37264], [80, 38309], [87, 38533], [90, 38793], [94, 38993], [103, 39793], [107, 39973], [111, 40233], [117, 40513], [119, 40993], [127, 41573], [129, 41763], [132, 41953]]}, {"verse": 7, "start": 43264, "end": 48979, "text": "Pedid, y se os dará; buscad, y hallaréis; llamad, y se os abrirá.", "words": [[0, 43264], [7, 43630], [9, 43850], [12, 44010], [15, 44150], [21, 45190], [29, 45470], [31, 46080], [42, 46930], [50, 47516], [52, 47976], [55, 48116], [58, 48575]]}, {"verse": 8, "start": 49429, "end": 55799, "text": "Porque cualquiera que pide, recibe; y el que busca, halla; y al que llama, se abrirá.", "words": [[0, 49429], [7, 49632], [18, 50212], [22, 50352], [28, 50692], [36, 51746], [38, 51873], [41, 51973], [45, 52113], [52, 52867], [59, 53880], [61, 53988], [64, 54128], [68, 54448], [75, 54768], [78, 55299]]}, {"verse": 9, "start": 56249, "end": 61244, "text": "¿Qué hombre hay de vosotros, a quien si su hijo le pide pan, le dará una piedra?", "words": [[0, 56249], [5, 56371], [12, 56691], [16, 56931], [19, 57071], [29, 57671], [31, 57951], [37, 58111], [40, 58351], [43, 58531], [48, 58751], [51, 58951], [56, 59211], [61, 59571], [64, 60111], [69, 60391], [73, 60511]]}, {"verse": 10, "start": 61694, "end": 65064, "text": "¿Y si le pide un pez, le dará una serpiente?", "words": [[0, 61694], [3, 61800], [6, 61900], [9, 62040], [14, 62300], [17, 62440], [22, 63040], [25, 63520], [30, 63820], [34, 63920]]}, {"verse": 11, "start": 65514, "end": 76695, "text": "Pues si vosotros, siendo malos, sabéis dar buenas dádivas a vuestros hijos, ¿cuánto más vuestro Padre que está en los cielos, dará buenas cosas a los que le piden?", "words": [[0, 65514], [5, 65681], [8, 65841], [18, 66321], [25, 66581], [32, 67461], [39, 68221], [43, 68481], [50, 68821], [58, 69441], [60, 69641], [69, 70041], [76, 70901], [84, 71381], [88, 71601], [96, 72001], [102, 72341], [106, 72581], [111, 72801], [114, 72921], [118, 73041], [126, 73621], [131, 74381], [138, 74821], [144, 75321], [146, 75581], [150, 75681], [154, 75821], [157, 75961]]}, {"verse": 12, "start": 77145, "end": 87739, "text": "Así que, todas las cosas que quisierais que los hombres hiciesen con vosotros, así también haced vosotros con ellos; porque esta es la ley y los profetas.", "words": [[0, 77145], [4, 77441], [9, 77661], [15, 77941], [19, 78241], [25, 78641], [29, 78901], [40, 79541], [44, 79741], [48, 79921], [56, 80321], [65, 81161], [69, 81381], [79, 82381], [83, 82581], [91, 83021], [97, 83521], [106, 84101], [110, 84361], [117, 85171], [124, 85395], [129, 85755], [132, 85955], [135, 86095], [139, 86395], [141, 86815], [145, 86935]]}, {"verse": 13, "start": 88189, "end": 98682, "text": "Entrad por la puerta estrecha: porque ancha es la puerta, y espacioso el camino que lleva a perdición, y muchos son los que entran por ella.", "words": [[0, 88406], [7, 88666], [11, 89286], [14, 89466], [21, 89786], [31, 90903], [38, 91188], [44, 91508], [47, 91868], [50, 91988], [58, 92408], [60, 93098], [70, 93788], [73, 94028], [80, 94348], [84, 94628], [90, 94908], [92, 95068], [103, 95708], [105, 96508], [112, 96808], [116, 97208], [120, 97408], [124, 97608], [131, 98008], [135, 98228]]}, {"verse": 14, "start": 99132, "end": 106349, "text": "Porque estrecha es la puerta, y angosto el camino que lleva a la vida, y pocos son los que la hallan.", "words": [[0, 99132], [7, 99354], [16, 99874], [19, 100034], [22, 100174], [30, 101194], [32, 101454], [40, 102054], [43, 102134], [50, 102454], [54, 102694], [60, 102834], [62, 102974], [65, 103174], [71, 103934], [73, 104174], [79, 104854], [83, 105074], [87, 105254], [91, 105454], [94, 105634]]}, {"verse": 15, "start": 106799, "end": 115681, "text": "Y guardaos de los falsos profetas, que vienen a vosotros con vestidos de ovejas, pero de dentro son lobos rapaces.", "words": [[0, 106799], [2, 107151], [11, 107541], [14, 107761], [18, 107881], [25, 108401], [35, 108901], [39, 109121], [46, 109461], [48, 109661], [57, 110221], [61, 110841], [70, 111321], [73, 111461], [81, 112401], [86, 112501], [89, 112701], [96, 113161], [100, 113761], [106, 114751]]}, {"verse": 16, "start": 116131, "end": 122619, "text": "Por sus frutos los conoceréis. ¿Se cogen uvas de los espinos, o higos de los cardos?", "words": [[0, 116131], [4, 116398], [8, 116598], [15, 117538], [19, 117738], [31, 119032], [35, 119175], [41, 119575], [46, 120015], [49, 120155], [53, 120275], [62, 120895], [64, 121275], [70, 121675], [73, 121795], [77, 121895]]}, {"verse": 17, "start": 123069, "end": 129102, "text": "Así, todo buen árbol lleva buenos frutos; pero el árbol malo lleva malos frutos.", "words": [[0, 123069], [5, 123247], [10, 123547], [15, 123847], [21, 124227], [27, 124487], [34, 124927], [42, 126195], [47, 126482], [50, 126682], [56, 127042], [61, 127582], [67, 127802], [73, 128302]]}, {"verse": 18, "start": 129552, "end": 135363, "text": "No puede el buen árbol llevar malos frutos, ni el árbol malo llevar frutos buenos.", "words": [[0, 129552], [3, 129703], [9, 130043], [12, 130283], [17, 130463], [23, 130923], [30, 131203], [36, 131783], [44, 132803], [47, 132903], [50, 133083], [56, 133443], [61, 133883], [68, 134083], [75, 134723]]}, {"verse": 19, "start": 135813, "end": 140220, "text": "Todo árbol que no lleva buen fruto, se corta y se echa en el fuego.", "words": [[0, 135813], [5, 135975], [11, 136515], [15, 136715], [18, 136895], [24, 137155], [29, 137455], [36, 138055], [39, 138215], [45, 138815], [47, 138935], [50, 139075], [55, 139355], [58, 139495], [61, 139635]]}, {"verse": 20, "start": 140670, "end": 143708, "text": "Así que, por sus frutos los conoceréis.", "words": [[0, 140670], [4, 140912], [9, 141092], [13, 141332], [17, 141532], [24, 142132], [28, 142672]]}, {"verse": 21, "start": 144158, "end": 154341, "text": "No todo el que me dice: Señor, Señor, entrará en el reino de los cielos: sino el que hace la voluntad de mi Padre que está en los cielos.", "words": [[0, 144158], [3, 144304], [8, 144644], [11, 144864], [15, 144984], [18, 145124], [24, 145907], [31, 146847], [38, 147667], [46, 148367], [49, 148587], [52, 148727], [58, 149167], [61, 149287], [65, 149427], [73, 150388], [78, 150693], [81, 150873], [85, 151013], [90, 151393], [93, 151613], [102, 152193], [105, 152313], [108, 152453], [114, 152973], [118, 153093], [123, 153293], [126, 153433], [130, 153553]]}, {"verse": 22, "start": 154791, "end": 165843, "text": "Muchos me dirán en aquel día: Señor, Señor, ¿no profetizamos en tu nombre, y en tu nombre lanzamos demonios, y en tu nombre hicimos muchos milagros?", "words": [[0, 154791], [7, 155139], [10, 155419], [16, 155759], [19, 155879], [25, 156239], [30, 157028], [37, 157612], [44, 158512], [48, 158672], [61, 159672], [64, 159912], [67, 160092], [75, 160572], [77, 161072], [80, 161212], [83, 161392], [90, 161752], [99, 162412], [109, 163312], [111, 163552], [114, 163672], [117, 163832], [124, 164132], [132, 164612], [139, 164932]]}, {"verse": 23, "start": 166293, "end": 173168, "text": "Y entonces les declararé: Nunca os conocí; apartaos de mí, hacedores de maldad.", "words": [[0, 166293], [2, 166478], [11, 167038], [15, 167658], [26, 168929], [32, 169395], [35, 169515], [43, 170849], [52, 171169], [55, 171369], [59, 171869], [69, 172369], [72, 172589]]}, {"verse": 24, "start": 173618, "end": 183120, "text": "Cualquiera, pues, que me oye estas palabras, y las hace, le compararé a un hombre prudente, que edificó su casa sobre la roca;", "words": [[0, 173618], [12, 174242], [18, 174882], [22, 174982], [25, 175162], [29, 175502], [35, 175742], [45, 176282], [47, 177002], [51, 177182], [57, 178102], [60, 178222], [70, 178882], [72, 178982], [75, 179142], [82, 179422], [92, 180142], [96, 180722], [104, 181442], [107, 181582], [112, 181922], [118, 182322], [121, 182522]]}, {"verse": 25, "start": 183570, "end": 194021, "text": "Y descendió lluvia, y vinieron ríos, y soplaron vientos, y golpearon aquella casa; y no cayó: porque estaba fundada sobre la roca.", "words": [[0, 183570], [2, 183674], [12, 184194], [20, 184734], [22, 185254], [31, 185674], [37, 186394], [39, 186914], [48, 187434], [57, 187994], [59, 188514], [69, 189134], [77, 189494], [83, 190591], [85, 190811], [88, 191031], [94, 191531], [101, 191733], [108, 192093], [116, 192773], [122, 193093], [125, 193353]]}, {"verse": 26, "start": 194471, "end": 204051, "text": "Y cualquiera que me oye estas palabras, y no las hace, le compararé a un hombre insensato, que edificó su casa sobre la arena;", "words": [[0, 194471], [2, 194594], [13, 195174], [17, 195374], [20, 195574], [24, 195894], [30, 196174], [40, 196734], [42, 197314], [45, 197454], [49, 197674], [55, 198454], [58, 198574], [68, 199314], [70, 199454], [73, 199614], [80, 199914], [91, 201194], [95, 201694], [103, 202274], [106, 202414], [111, 202754], [117, 203154], [120, 203414]]}, {"verse": 27, "start": 204501, "end": 214056, "text": "Y descendió lluvia, y vinieron ríos, y soplaron vientos, y golpearon aquella casa; y cayó, y fue grande su ruina.", "words": [[0, 204501], [2, 204605], [12, 205125], [20, 205665], [22, 206185], [31, 206605], [37, 207325], [39, 207845], [48, 208365], [57, 208925], [59, 209445], [69, 210065], [77, 210425], [83, 211339], [85, 211697], [91, 212217], [93, 212737], [97, 212877], [104, 213197], [107, 213477]]}, {"verse": 28, "start": 214506, "end": 220316, "text": "Y aconteció que, como Jesús acabó estas palabras, la gente se admiraba de su enseñanza;", "words": [[0, 214506], [2, 214685], [12, 215405], [17, 215585], [22, 215845], [28, 216165], [34, 216745], [40, 216905], [50, 217865], [53, 218085], [59, 218365], [62, 218625], [71, 219165], [74, 219305], [77, 219445]]}, {"verse": 29, "start": 220766, "end": 225609, "text": "Porque les enseñaba como quien tiene autoridad, y no como los escribas.", "words": [[0, 220766], [7, 221066], [11, 221246], [20, 221906], [25, 222146], [31, 222426], [37, 222806], [48, 223566], [50, 224126], [53, 224266], [58, 224546], [62, 224766]]}]}