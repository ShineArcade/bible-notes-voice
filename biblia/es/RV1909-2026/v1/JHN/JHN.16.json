{"book": "JHN", "chapter": 16, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 251468, "verses": [{"verse": 1, "start": 300, "end": 4381, "text": "Estas cosas os he hablado, para que no os escandalicéis.", "words": [[0, 300], [6, 617], [12, 1057], [15, 1357], [18, 1677], [27, 2197], [32, 2437], [36, 2597], [39, 2897], [42, 3097]]}, {"verse": 2, "start": 4731, "end": 12183, "text": "Os echarán de las sinagogas; y aun viene la hora, cuando cualquiera que os mate pensará que rinde servicio a Dios.", "words": [[0, 4838], [3, 4978], [11, 5398], [14, 5478], [18, 5658], [29, 6726], [31, 6852], [35, 7032], [41, 7412], [44, 7632], [50, 7832], [57, 8132], [68, 8912], [72, 9092], [75, 9192], [80, 9552], [88, 10432], [92, 10682], [98, 10932], [107, 11492], [109, 11712]]}, {"verse": 3, "start": 12533, "end": 17094, "text": "Y estas cosas os harán, porque no conocen al Padre ni a mí.", "words": [[0, 12533], [2, 12696], [8, 12936], [14, 13436], [17, 13701], [24, 14501], [31, 14861], [34, 15081], [42, 15641], [45, 15761], [51, 16341], [54, 16661], [56, 16781]]}, {"verse": 4, "start": 17444, "end": 26872, "text": "Pero os he dicho esto, para que cuando llegue la hora, os acordéis de que yo os lo había dicho. Esto no os lo dije al principio, porque yo estaba con vosotros.", "words": [[0, 17444], [5, 17608], [8, 17868], [11, 18088], [17, 18328], [23, 18728], [28, 19193], [32, 19353], [39, 19573], [46, 20113], [49, 20233], [55, 20493], [58, 20933], [67, 21373], [70, 21693], [74, 21813], [77, 22073], [80, 22313], [83, 22493], [89, 22713], [96, 23576], [101, 23782], [104, 23912], [107, 24042], [110, 24302], [115, 24582], [118, 24722], [129, 25242], [136, 25522], [139, 25722], [146, 25902], [150, 26182]]}, {"verse": 5, "start": 27222, "end": 32350, "text": "Pero ahora voy al que me envió; y ninguno de vosotros me pregunta: ¿Adónde vas?", "words": [[0, 27222], [5, 27346], [11, 27646], [15, 27866], [18, 28026], [22, 28186], [25, 28326], [32, 29080], [34, 29183], [42, 29623], [45, 29743], [54, 30223], [57, 30403], [67, 31529], [75, 31739]]}, {"verse": 6, "start": 32700, "end": 38653, "text": "Antes, porque os he hablado estas cosas, tristeza ha llenado vuestro corazón.", "words": [[0, 32700], [7, 33097], [14, 33537], [17, 33837], [20, 33977], [28, 34437], [34, 34677], [41, 35557], [50, 36677], [53, 36977], [61, 37477], [69, 37857]]}, {"verse": 7, "start": 39003, "end": 49328, "text": "Pero yo os digo la verdad: Os conviene que yo me vaya: porque si yo no fuese, el Consolador no vendría a vosotros; pero si me voy, os le enviaré.", "words": [[0, 39003], [5, 39147], [8, 39447], [11, 39747], [16, 40067], [19, 40287], [27, 41133], [30, 41278], [39, 41758], [43, 41898], [46, 42078], [49, 42218], [55, 43057], [62, 43240], [65, 43480], [68, 43700], [71, 43820], [78, 44580], [81, 44920], [92, 45600], [95, 45800], [103, 46320], [105, 46440], [115, 47392], [120, 47538], [123, 47758], [126, 47918], [131, 48118], [134, 48358], [137, 48578]]}, {"verse": 8, "start": 49678, "end": 55056, "text": "Y cuando él venga, convencerá al mundo de pecado, de justicia y de juicio:", "words": [[0, 49678], [2, 49780], [9, 50020], [12, 50260], [19, 50760], [30, 51640], [33, 51780], [39, 52000], [42, 52260], [50, 53180], [53, 53240], [62, 54020], [64, 54300], [67, 54400]]}, {"verse": 9, "start": 55406, "end": 58901, "text": "De pecado ciertamente, por cuanto no creen en mí;", "words": [[0, 55406], [3, 55552], [10, 56032], [23, 56832], [27, 57112], [34, 57572], [37, 57912], [43, 58392], [46, 58512]]}, {"verse": 10, "start": 59251, "end": 63374, "text": "Y de justicia, por cuanto voy al Padre, y no me veréis más;", "words": [[0, 59251], [2, 59556], [5, 59656], [15, 60716], [19, 60856], [26, 61176], [30, 61456], [33, 61596], [40, 62096], [42, 62256], [45, 62376], [48, 62516], [55, 62856]]}, {"verse": 11, "start": 63724, "end": 67672, "text": "Y de juicio, por cuanto el príncipe de este mundo es juzgado.", "words": [[0, 63724], [2, 63832], [5, 63932], [13, 64432], [17, 64932], [24, 65252], [27, 65472], [36, 66272], [39, 66432], [44, 66612], [50, 66872], [53, 67052]]}, {"verse": 12, "start": 68022, "end": 72684, "text": "Aún tengo muchas cosas que deciros, pero ahora no las podéis sobrellevar.", "words": [[0, 68022], [4, 68246], [10, 68626], [17, 68906], [23, 69266], [27, 69506], [36, 70306], [41, 70446], [47, 70826], [50, 71266], [54, 71426], [61, 71786]]}, {"verse": 13, "start": 73034, "end": 84746, "text": "Pero cuando venga el Espíritu de verdad, él os guiará a toda la verdad; porque no hablará de sí mismo, sino que hablará todo lo que oiga, y os hará saber las cosas que han de venir.", "words": [[0, 73034], [5, 73178], [12, 73398], [18, 73898], [21, 74078], [30, 74798], [33, 74898], [41, 75378], [44, 75558], [47, 75698], [54, 76198], [56, 76358], [61, 76598], [64, 76858], [72, 77634], [79, 77856], [82, 78156], [90, 78836], [93, 78976], [96, 79136], [103, 79816], [108, 80036], [112, 80256], [120, 80676], [125, 80936], [128, 81196], [132, 81516], [138, 81836], [140, 82143], [143, 82449], [148, 82756], [154, 83076], [158, 83336], [164, 83676], [168, 83936], [172, 84116], [175, 84236]]}, {"verse": 14, "start": 85096, "end": 90262, "text": "Él me glorificará: porque tomará de lo mío, y os lo hará saber.", "words": [[0, 85096], [3, 85479], [6, 85719], [19, 86948], [26, 87170], [33, 87770], [36, 87910], [39, 88070], [44, 88930], [46, 89110], [49, 89270], [52, 89470], [57, 89750]]}, {"verse": 15, "start": 90612, "end": 97618, "text": "Todo lo que tiene el Padre, mío es: por eso dije que tomará de lo mío, y os lo hará saber.", "words": [[0, 90612], [5, 90776], [8, 91036], [12, 91176], [18, 91536], [21, 91796], [28, 92616], [32, 93116], [36, 93831], [40, 93935], [44, 94155], [49, 94455], [53, 94635], [60, 95075], [63, 95215], [66, 95355], [71, 96035], [73, 96255], [76, 96455], [79, 96735], [84, 97055]]}, {"verse": 16, "start": 97968, "end": 104176, "text": "Un poquito, y no me veréis; y otra vez un poquito, y me veréis: porque yo voy al Padre.", "words": [[0, 97968], [3, 98154], [12, 98534], [14, 98994], [17, 99114], [20, 99234], [28, 100156], [30, 100416], [35, 100576], [39, 100816], [42, 100976], [51, 101356], [53, 101636], [56, 101756], [64, 102672], [71, 102856], [74, 103096], [78, 103276], [81, 103496]]}, {"verse": 17, "start": 104526, "end": 114947, "text": "Entonces dijeron algunos de sus discípulos unos a otros: ¿Qué es esto que nos dice: Un poquito, y no me veréis; y otra vez un poquito, y me veréis: y, porque yo voy al Padre?", "words": [[0, 104526], [9, 104933], [17, 105633], [25, 105873], [28, 106093], [32, 106233], [43, 106893], [48, 107153], [50, 107413], [57, 108282], [62, 108420], [65, 108580], [70, 108820], [74, 109020], [78, 109160], [84, 109878], [87, 110034], [96, 110334], [98, 110594], [101, 110694], [104, 110814], [112, 111588], [114, 111729], [119, 111869], [123, 112109], [126, 112269], [135, 112609], [137, 112789], [140, 112889], [148, 113652], [151, 113753], [158, 113973], [161, 114173], [165, 114313], [168, 114453]]}, {"verse": 18, "start": 115227, "end": 120345, "text": "Decían pues: ¿Qué es esto que dice: Un poquito? No entendemos lo que habla.", "words": [[0, 115227], [7, 115773], [13, 116537], [18, 116659], [21, 116879], [26, 117119], [30, 117299], [36, 118011], [39, 118174], [48, 118967], [51, 119110], [62, 119650], [65, 119830], [69, 119950]]}, {"verse": 19, "start": 120625, "end": 131944, "text": "Y conoció Jesús que le querían preguntar, y les dijo: ¿Preguntáis entre vosotros de esto que dije: Un poquito, y no me veréis, y otra vez un poquito, y me veréis?", "words": [[0, 120625], [2, 120770], [10, 121450], [16, 121750], [20, 122130], [23, 122270], [31, 122670], [42, 123410], [44, 123570], [48, 123710], [54, 124577], [66, 125363], [72, 125823], [81, 126443], [84, 126663], [89, 126883], [93, 127117], [99, 127572], [102, 128212], [111, 128572], [113, 128812], [116, 128912], [119, 129052], [127, 129532], [129, 129772], [134, 129972], [138, 130272], [141, 130452], [150, 130832], [152, 131112], [155, 131252]]}, {"verse": 20, "start": 132294, "end": 145019, "text": "De cierto, de cierto os digo, que vosotros lloraréis y lamentaréis, y el mundo se alegrará: pero aunque vosotros estaréis tristes, vuestra tristeza se tornará en gozo.", "words": [[0, 132294], [3, 132497], [11, 132997], [14, 133117], [21, 133517], [24, 133797], [30, 134057], [34, 134292], [43, 134872], [53, 135952], [55, 136332], [68, 137212], [70, 137732], [73, 137832], [79, 138132], [82, 138412], [92, 139448], [97, 139632], [104, 140052], [113, 140652], [122, 141272], [131, 142252], [139, 142552], [148, 143272], [151, 143552], [159, 144132], [162, 144432]]}, {"verse": 21, "start": 145369, "end": 157658, "text": "La mujer cuando pare, tiene dolor, porque es venida su hora; pero después que ha parido un niño, ya no se acuerda de la angustia, por el gozo de que haya nacido un hombre en el mundo.", "words": [[0, 145369], [3, 145488], [9, 145748], [16, 146068], [22, 146548], [28, 147308], [35, 147828], [42, 148568], [45, 148748], [52, 149168], [55, 149408], [61, 150063], [66, 150210], [74, 150530], [78, 150750], [81, 150890], [88, 151210], [91, 151370], [97, 152310], [100, 152710], [103, 152850], [106, 152990], [114, 153410], [117, 153510], [120, 153630], [130, 154250], [134, 154555], [137, 154715], [142, 155135], [145, 155315], [149, 155435], [154, 155695], [161, 156235], [164, 156495], [171, 156815], [174, 156995], [177, 157115]]}, {"verse": 22, "start": 158008, "end": 169070, "text": "También, pues, vosotros ahora ciertamente tenéis tristeza; pero otra vez os veré, y se gozará vuestro corazón, y nadie quitará de vosotros vuestro gozo.", "words": [[0, 158008], [9, 158478], [15, 159318], [24, 159718], [30, 160018], [42, 160758], [49, 161278], [59, 162404], [64, 162571], [69, 162831], [73, 163131], [76, 163431], [82, 163731], [84, 164471], [87, 164631], [94, 165071], [102, 165451], [111, 165891], [113, 166576], [119, 166896], [127, 167556], [130, 167656], [139, 168136], [147, 168536]]}, {"verse": 23, "start": 169420, "end": 178292, "text": "Y aquel día no me preguntaréis nada. De cierto, de cierto os digo, que todo cuanto pidáis al Padre en mi nombre, os lo dará.", "words": [[0, 169420], [2, 169521], [8, 169821], [12, 170041], [15, 170301], [18, 170421], [31, 171121], [37, 172200], [40, 172456], [48, 172712], [51, 172968], [58, 173224], [61, 173444], [67, 174224], [71, 174484], [76, 174784], [83, 175084], [90, 175684], [93, 175904], [99, 176424], [102, 176564], [105, 176684], [113, 177064], [116, 177624], [119, 177824]]}, {"verse": 24, "start": 178642, "end": 185766, "text": "Hasta ahora nada habéis pedido en mi nombre: pedid, y recibiréis, para que vuestro gozo sea cumplido.", "words": [[0, 178642], [6, 178936], [12, 179216], [17, 179536], [24, 180096], [31, 180556], [34, 180676], [37, 180816], [45, 181774], [52, 181944], [54, 182244], [66, 183084], [71, 183584], [75, 183784], [83, 184344], [88, 184664], [92, 184924]]}, {"verse": 25, "start": 186116, "end": 196174, "text": "Estas cosas os he hablado en lenguaje figurado: la hora viene cuando ya no os hablaré en lenguaje figurado, sino que os hablaré claramente del Padre.", "words": [[0, 186116], [6, 186421], [12, 186701], [15, 187301], [18, 187541], [26, 187981], [29, 188061], [38, 188541], [48, 189595], [51, 189742], [56, 189942], [62, 190302], [69, 190622], [72, 190982], [75, 191182], [78, 191382], [86, 191962], [89, 192142], [98, 192702], [108, 193642], [113, 193822], [117, 194042], [120, 194202], [128, 194662], [139, 195282], [143, 195482]]}, {"verse": 26, "start": 196524, "end": 203414, "text": "Aquel día pediréis en mi nombre: y no os digo, que yo rogaré al Padre por vosotros;", "words": [[0, 196524], [6, 196868], [10, 197028], [19, 197648], [22, 197848], [25, 198008], [33, 199618], [35, 199761], [38, 199961], [41, 200161], [47, 200521], [51, 200786], [54, 201026], [61, 201806], [64, 201926], [70, 202366], [74, 202546]]}, {"verse": 27, "start": 203764, "end": 210362, "text": "Pues el mismo Padre os ama, porque vosotros me amasteis, y habéis creído que yo salí de Dios.", "words": [[0, 203764], [5, 203908], [8, 204108], [14, 204368], [20, 204888], [23, 205028], [28, 205788], [35, 206168], [44, 206708], [47, 206928], [57, 207748], [59, 208088], [66, 208408], [73, 208908], [77, 209108], [80, 209268], [85, 209668], [88, 209748]]}, {"verse": 28, "start": 210712, "end": 216262, "text": "Salí del Padre, y he venido al mundo: otra vez dejo el mundo, y voy al Padre.", "words": [[0, 210712], [5, 211139], [9, 211259], [16, 211679], [18, 212014], [21, 212114], [28, 212494], [31, 212634], [38, 213406], [43, 213732], [47, 213972], [52, 214532], [55, 214632], [62, 214972], [64, 215252], [68, 215432], [71, 215632]]}, {"verse": 29, "start": 216612, "end": 221715, "text": "Le dicen sus discípulos: He aquí, ahora hablas claramente, y no usas lenguaje figurado.", "words": [[0, 216612], [3, 216737], [9, 216997], [13, 217317], [25, 218451], [28, 218604], [34, 218824], [40, 219044], [47, 219444], [59, 220024], [61, 220304], [64, 220444], [69, 220724], [78, 221124]]}, {"verse": 30, "start": 222065, "end": 228704, "text": "Ahora entendemos que sabes todas las cosas, y no necesitas que nadie te pregunte: en esto creemos que has salido de Dios.", "words": [[0, 222065], [6, 222282], [17, 222802], [21, 222962], [27, 223202], [33, 223422], [37, 223702], [44, 224062], [46, 224522], [49, 224662], [59, 225202], [63, 225362], [69, 225602], [72, 225782], [82, 226591], [85, 226861], [90, 227061], [98, 227501], [102, 227631], [106, 227761], [113, 228121], [116, 228241]]}, {"verse": 31, "start": 228984, "end": 231619, "text": "Les respondió Jesús: ¿Ahora creéis?", "words": [[0, 228984], [4, 229374], [14, 229764], [21, 230622], [28, 230844]]}, {"verse": 32, "start": 231969, "end": 242131, "text": "He aquí, la hora viene, y ha venido, que seréis esparcidos cada uno por su parte, y me dejaréis solo: pero no estoy solo, porque el Padre está conmigo.", "words": [[0, 232022], [3, 232112], [9, 232332], [12, 232552], [17, 232752], [24, 233132], [26, 233452], [29, 233572], [37, 234052], [41, 234392], [48, 234832], [59, 235432], [64, 235712], [68, 236052], [72, 236292], [75, 236452], [82, 236812], [84, 237272], [87, 237412], [96, 237952], [102, 238808], [107, 238972], [110, 239152], [116, 239392], [122, 239872], [129, 240432], [132, 240612], [138, 240992], [143, 241392]]}, {"verse": 33, "start": 242481, "end": 251068, "text": "Estas cosas os he hablado, para que en mí tengáis paz. En el mundo tendréis aflicción: pero confiad, yo he vencido al mundo.", "words": [[0, 242481], [6, 242726], [12, 243086], [15, 243366], [18, 243626], [27, 244066], [32, 244326], [36, 244561], [39, 244796], [42, 245031], [50, 245266], [55, 246024], [58, 246164], [61, 246284], [67, 246584], [76, 247244], [87, 248391], [92, 248553], [101, 249653], [104, 249773], [107, 249853], [115, 250293], [118, 250493]]}]}