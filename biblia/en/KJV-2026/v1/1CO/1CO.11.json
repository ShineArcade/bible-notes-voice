2298], [38, 102458], [43, 103158], [48, 103298], [53, 103478], [59, 103678], [63, 103818], [72, 104178], [76, 104638], [79, 104758], [84, 104998], [93, 105438], [99, 105758]]}, {"verse": 20, "start": 106596, "end": 110782, "text": "When you come together therefore into one place, this is not to eat the Lord’s supper.", "words": [[0, 106596], [5, 106719], [9, 106839], [14, 106999], [23, 107739], [33, 107859], [38, 108039], [42, 108319], [49, 109059], [54, 109199], [57, 109359], [61, 109619], [64, 109819], [68, 109979], [72, 110119], [79, 110439]]}, {"verse": 21, "start": 111232, "end": 116596, "text": "For in eating every one takes before other his own supper: and one is hungry, and another is drunken.", "words": [[0, 111232], [4, 111334], [7, 111464], [14, 111697], [20, 111931], [24, 112164], [30, 112564], [37, 112904], [43, 113204], [47, 113424], [51, 113604], [59, 114382], [63, 114504], [67, 114644], [70, 114804], [78, 115144], [82, 115544], [90, 115804], [93, 116004]]}, {"verse": 22, "start": 117046, "end": 127791, "text": "What? have you not houses to eat and to drink in? or do you despise the church of God, and shame them that have not? What shall I say to you? shall I praise you in this? I praise you not.", "words": [[0, 117046], [6, 117813], [11, 117951], [15, 118111], [19, 118271], [26, 118631], [29, 118891], [33, 119111], [37, 119311], [40, 119471], [46, 119751], [50, 120385], [53, 120484], [56, 120624], [60, 120704], [68, 121224], [72, 121344], [79, 121604], [82, 121744], [87, 122064], [91, 122304], [97, 122584], [102, 122784], [107, 122964], [112, 123064], [117, 123808], [122, 123948], [128, 124128], [130, 124268], [134, 124468], [137, 124668], [142, 125207], [148, 125372], [150, 125512], [157, 125772], [161, 125972], [164, 126092], [170, 126805], [172, 126925], [179, 127185], [183, 127365]]}, {"verse": 23, "start": 128241, "end": 135222, "text": "For I have received of the Lord that which also I delivered to you, That the Lord Jesus the same night in which he was betrayed took bread:", "words": [[0, 128241], [4, 128411], [6, 128751], [11, 128931], [20, 129311], [23, 129511], [27, 129651], [32, 129871], [37, 130071], [43, 130251], [48, 130691], [50, 130931], [60, 131231], [63, 131491], [68, 131931], [73, 132091], [77, 132211], [82, 132411], [88, 132971], [92, 133051], [97, 133271], [103, 133511], [106, 133711], [112, 133891], [115, 133991], [119, 134151], [128, 134671], [133, 134791]]}, {"verse": 24, "start": 135672, "end": 144167, "text": "And when he had given thanks, he broke it, and said, Take, eat: this is my body, which is broken for you: this do in remembrance of me.", "words": [[0, 135672], [4, 135779], [9, 135919], [12, 136079], [16, 136199], [22, 136399], [30, 137219], [33, 137279], [39, 137559], [43, 137839], [47, 138159], [53, 138903], [59, 139102], [64, 139967], [69, 140108], [72, 140248], [75, 140428], [81, 140828], [87, 141048], [90, 141188], [97, 141508], [101, 141828], [106, 142518], [111, 142688], [114, 142894], [117, 143101], [129, 143501], [132, 143781]]}, {"verse": 25, "start": 144467, "end": 154824, "text": "After the same manner also he took the cup, after supper, saying, This cup is the new testament in my blood: this do you, as often as you drink it, in remembrance of me.", "words": [[0, 144467], [6, 144744], [10, 144924], [15, 145204], [22, 145484], [27, 146164], [30, 146264], [35, 146484], [39, 146684], [44, 146964], [50, 147484], [58, 147944], [66, 148815], [71, 149001], [75, 149341], [78, 149541], [82, 149681], [86, 149841], [96, 150241], [99, 150541], [102, 150721], [109, 151490], [114, 151689], [117, 151929], [122, 152369], [125, 152609], [131, 152909], [134, 153089], [138, 153209], [144, 153469], [148, 153669], [151, 153829], [163, 154209], [166, 154489]]}, {"verse": 26, "start": 155124, "end": 160332, "text": "For as often as you eat this bread, and drink this cup, you do show the Lord’s death till he come.", "words": [[0, 155124], [4, 155248], [7, 155388], [13, 155628], [16, 155868], [20, 156008], [24, 156168], [29, 156328], [36, 156648], [40, 157028], [46, 157288], [51, 157508], [56, 158168], [60, 158248], [63, 158448], [68, 158728], [72, 158908], [79, 159308], [85, 159508], [90, 159788], [93, 160088]]}, {"verse": 27, "start": 160782, "end": 167945, "text": "Therefore whoever shall eat this bread, and drink this cup of the Lord, unworthily, shall be guilty of the body and blood of the Lord.", "words": [[0, 160782], [10, 161426], [18, 161726], [24, 162106], [28, 162386], [33, 162606], [40, 162946], [44, 163326], [50, 163526], [55, 163766], [59, 163966], [62, 164066], [66, 164226], [72, 164486], [84, 165366], [90, 165806], [93, 165966], [100, 166226], [103, 166486], [107, 166606], [112, 166886], [116, 167106], [122, 167326], [125, 167466], [129, 167586]]}, {"verse": 28, "start": 168395, "end": 172669, "text": "But let a man examine himself, and so let him eat of that bread, and drink of that cup.", "words": [[0, 168395], [4, 168529], [8, 168709], [10, 168789], [14, 168969], [22, 169169], [31, 169709], [35, 170149], [38, 170329], [42, 170529], [46, 170649], [50, 170789], [53, 170909], [58, 171089], [65, 171349], [69, 171729], [75, 171989], [78, 172149], [83, 172329]]}, {"verse": 29, "start": 173119, "end": 179713, "text": "For he that eats and drinks unworthily, eats and drinks damnation to himself, not discerning the Lord’s body.", "words": [[0, 173119], [4, 173245], [7, 173445], [12, 173685], [17, 173925], [21, 174145], [28, 174465], [40, 175245], [45, 175825], [49, 176065], [56, 176445], [66, 177065], [69, 177285], [78, 178105], [82, 178285], [93, 178785], [97, 178945], [104, 179265]]}, {"verse": 30, "start": 180163, "end": 183795, "text": "For this cause many are weak and sickly among you, and many sleep.", "words": [[0, 180163], [4, 180239], [9, 180499], [15, 180839], [20, 181159], [24, 181379], [29, 181599], [33, 181779], [40, 182159], [46, 182339], [51, 182659], [55, 183039], [60, 183299]]}, {"verse": 31, "start": 184245, "end": 187147, "text": "For if we would judge ourselves, we should not be judged.", "words": [[0, 184245], [4, 184368], [7, 184568], [10, 184728], [16, 184888], [22, 185148], [33, 185908], [36, 186008], [43, 186168], [47, 186408], [50, 186588]]}, {"verse": 32, "start": 187597, "end": 192423, "text": "But when we are judged, we are chastened of the Lord, that we should not be condemned with the world.", "words": [[0, 187597], [4, 187702], [9, 187882], [12, 188082], [16, 188182], [24, 188722], [27, 188822], [31, 188902], [41, 189482], [44, 189622], [48, 189722], [54, 190202], [59, 190422], [62, 190602], [69, 190762], [73, 191022], [76, 191202], [86, 191522], [91, 191822], [95, 191922]]}, {"verse": 33, "start": 192873, "end": 196583, "text": "Therefore, my brethren, when you come together to eat, wait for one another.", "words": [[0, 192873], [11, 193310], [14, 193390], [24, 194090], [29, 194170], [33, 194290], [38, 194510], [47, 194850], [50, 195050], [55, 195570], [60, 195810], [64, 195990], [68, 196170]]}, {"verse": 34, "start": 197033, "end": 204909, "text": "And if any man hunger, let him eat at home; that you come not together to condemnation. And the rest will I set in order when I come.", "words": [[0, 197033], [4, 197157], [7, 197257], [11, 197457], [15, 197657], [23, 198337], [27, 198457], [31, 198617], [35, 198837], [38, 199057], [44, 199768], [49, 199877], [53, 199997], [58, 200197], [62, 200357], [71, 200697], [74, 200837], [88, 201942], [92, 202122], [96, 202222], [101, 202562], [106, 202842], [108, 202982], [112, 203342], [115, 203682], [121, 203942], [126, 204282], [128, 204462]]}]}