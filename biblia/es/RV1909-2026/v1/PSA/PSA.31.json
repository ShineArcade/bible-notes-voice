{"book": "PSA", "chapter": 31, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 195619, "verses": [{"verse": 1, "start": 300, "end": 10515, "text": "Al Músico principal: Salmo de David. EN ti, oh Jehová, he esperado; no sea yo confundido para siempre: líbrame en tu justicia.", "words": [[0, 300], [3, 480], [10, 960], [21, 2163], [27, 2641], [30, 2801], [37, 3645], [40, 3831], [44, 4151], [47, 4471], [55, 5231], [58, 5391], [68, 6442], [71, 6602], [75, 6796], [78, 6989], [89, 7669], [94, 7889], [103, 9087], [111, 9287], [114, 9487], [117, 9687]]}, {"verse": 2, "start": 10965, "end": 19498, "text": "Inclina a mí tu oído, líbrame pronto; sé para mí roca de fortaleza, por casa fuerte para salvarme.", "words": [[0, 11435], [8, 11905], [10, 12005], [13, 12145], [16, 12325], [22, 13005], [30, 13685], [38, 14793], [41, 15001], [46, 15201], [49, 15381], [54, 15781], [57, 15921], [68, 16661], [72, 16861], [77, 17041], [84, 17441], [89, 17721]]}, {"verse": 3, "start": 19948, "end": 26168, "text": "Porque tú eres mi roca y mi castillo; y por tu nombre me guiarás, y me encaminarás.", "words": [[0, 19948], [7, 19948], [10, 19948], [15, 20208], [18, 20628], [23, 21168], [25, 21408], [28, 21548], [38, 22636], [40, 22733], [44, 22893], [47, 23093], [54, 23453], [57, 23933], [66, 24673], [68, 24993], [71, 25133]]}, {"verse": 4, "start": 26618, "end": 31943, "text": "Me sacarás de la red que han escondido para mí; porque tú eres mi fortaleza.", "words": [[0, 26618], [3, 26747], [11, 27307], [14, 27407], [17, 27527], [21, 27747], [25, 28027], [29, 28147], [39, 28747], [44, 28967], [48, 29718], [55, 29925], [58, 30225], [63, 30585], [66, 30945]]}, {"verse": 5, "start": 32393, "end": 38315, "text": "En tu mano encomiendo mi espíritu: tú me has redimido, oh Jehová, Dios de verdad.", "words": [[0, 32393], [3, 32562], [6, 32682], [11, 32982], [22, 33642], [25, 33862], [35, 34911], [38, 34995], [41, 35155], [45, 35315], [55, 36015], [58, 36235], [66, 37015], [71, 37255], [74, 37615]]}, {"verse": 6, "start": 38765, "end": 44982, "text": "Aborrecí a los que esperan en vanidades ilusorias; mas yo en Jehová he esperado.", "words": [[0, 39105], [9, 39445], [11, 39705], [15, 39845], [19, 40005], [27, 40585], [30, 40845], [40, 41345], [51, 42863], [55, 43091], [58, 43431], [61, 43611], [68, 43931], [71, 44251]]}, {"verse": 7, "start": 45432, "end": 53045, "text": "Me gozaré y alegraré en tu misericordia; porque has visto mi aflicción; has conocido mi alma en las angustias.", "words": [[0, 45432], [3, 45632], [10, 46192], [12, 46332], [21, 46952], [24, 47092], [27, 47192], [41, 48670], [48, 48830], [52, 48990], [58, 49170], [61, 49390], [72, 50457], [76, 50598], [85, 51238], [88, 51438], [93, 51718], [96, 51878], [100, 52018]]}, {"verse": 8, "start": 53495, "end": 59261, "text": "Y no me encerraste en mano del enemigo; hiciste estar mis pies en anchura.", "words": [[0, 53495], [2, 53620], [5, 53780], [8, 53940], [19, 54860], [22, 55100], [27, 55440], [31, 55700], [40, 56867], [48, 57394], [54, 57694], [58, 57914], [63, 58214], [66, 58434]]}, {"verse": 9, "start": 59711, "end": 68280, "text": "Ten misericordia de mí, oh Jehová, que estoy en angustia: se han consumido de pesar mis ojos, mi alma, y mis entrañas.", "words": [[0, 59711], [4, 59875], [17, 60775], [20, 60935], [24, 61262], [27, 61588], [35, 61915], [39, 61975], [45, 62235], [48, 62435], [58, 63525], [61, 63692], [65, 63832], [75, 64612], [78, 64752], [84, 65032], [88, 65352], [94, 66232], [97, 66332], [103, 66632], [105, 67192], [109, 67332]]}, {"verse": 10, "start": 68730, "end": 79520, "text": "Porque mi vida se va gastando de dolor, y mis años de suspirar: se ha enflaquecido mi fuerza a causa de mi iniquidad, y mis huesos se han consumido.", "words": [[0, 68730], [7, 68917], [10, 69117], [15, 69397], [18, 69577], [21, 69717], [30, 70277], [33, 70437], [40, 70817], [42, 71297], [46, 71517], [51, 71797], [54, 71997], [64, 73024], [67, 73192], [70, 73352], [83, 74132], [86, 74312], [93, 74732], [95, 75112], [101, 75412], [104, 75692], [107, 75872], [118, 76672], [120, 77112], [124, 77332], [131, 78152], [134, 78452], [138, 78612]]}, {"verse": 11, "start": 79970, "end": 90350, "text": "De todos mis enemigos he sido deshonra, y de mis vecinos en gran manera, y horror a mis conocidos: los que me veían fuera, huían de mí.", "words": [[0, 79970], [3, 80114], [9, 80354], [13, 80634], [22, 81254], [25, 81434], [30, 82004], [40, 82574], [42, 83014], [45, 83154], [49, 83294], [57, 83854], [60, 84074], [65, 84314], [73, 84814], [75, 85454], [82, 85754], [84, 86034], [88, 86194], [99, 87537], [103, 87643], [107, 87803], [110, 87963], [116, 88423], [123, 88823], [129, 89843], [132, 90063]]}, {"verse": 12, "start": 90800, "end": 96805, "text": "He sido olvidado de su corazón como un muerto: he venido a ser como un vaso perdido.", "words": [[0, 90800], [3, 90921], [8, 91201], [17, 91981], [20, 92161], [23, 92321], [31, 92821], [36, 92971], [39, 93121], [47, 94176], [50, 94300], [57, 94740], [59, 94880], [63, 95120], [68, 95360], [71, 95580], [76, 96020]]}, {"verse": 13, "start": 97255, "end": 106933, "text": "Porque he oído afrenta de muchos; miedo por todas partes, cuando consultaban juntos contra mí, e ideaban quitarme la vida.", "words": [[0, 97255], [7, 97518], [10, 97798], [15, 98138], [23, 98758], [26, 98878], [34, 100002], [40, 100363], [44, 100603], [50, 100903], [58, 101883], [65, 102103], [77, 102923], [84, 103243], [91, 103703], [95, 103983], [97, 104603], [105, 105123], [114, 105723], [117, 105843]]}, {"verse": 14, "start": 107383, "end": 112526, "text": "Mas yo en ti confié, oh Jehová: yo dije: Dios mío eres tú.", "words": [[0, 107383], [4, 107383], [7, 107574], [10, 107754], [13, 107934], [21, 108504], [24, 109074], [32, 110170], [35, 110502], [41, 111134], [46, 111454], [50, 111874], [55, 112014]]}, {"verse": 15, "start": 112976, "end": 119721, "text": "En tu mano están mis tiempos: líbrame de la mano de mis enemigos, y de mis perseguidores.", "words": [[0, 112976], [3, 113160], [6, 113320], [11, 113580], [17, 113840], [21, 114080], [30, 115428], [38, 115728], [41, 115888], [44, 116028], [49, 116288], [52, 116468], [56, 116628], [66, 117288], [68, 117468], [71, 117608], [75, 117828]]}, {"verse": 16, "start": 120171, "end": 125453, "text": "Haz resplandecer tu rostro sobre tu siervo: sálvame por tu misericordia.", "words": [[0, 120488], [4, 120842], [17, 121195], [20, 121415], [27, 122015], [33, 122255], [36, 122475], [44, 123405], [52, 123927], [56, 124227], [59, 124367]]}, {"verse": 17, "start": 125903, "end": 134822, "text": "No sea yo avergonzado, oh Jehová, ya que te he invocado; sean avergonzados los impíos, estén mudos en el profundo.", "words": [[0, 125903], [3, 126028], [7, 126268], [10, 126528], [23, 127115], [26, 127701], [34, 128288], [37, 128528], [41, 128728], [44, 128908], [47, 129028], [57, 130088], [62, 130435], [75, 131475], [79, 131695], [87, 132715], [93, 133115], [99, 133655], [102, 133795], [105, 133915]]}, {"verse": 18, "start": 135272, "end": 142433, "text": "Enmudezcan los labios mentirosos, que hablan contra el justo cosas duras, con soberbia y menosprecio.", "words": [[0, 135645], [11, 136055], [15, 136255], [22, 136715], [34, 137555], [38, 137935], [45, 138335], [52, 138655], [55, 138835], [61, 139055], [67, 139475], [74, 140335], [78, 140655], [87, 141315], [89, 141555]]}, {"verse": 19, "start": 142883, "end": 153073, "text": "¡Cuán grande es tu bien, que has guardado para los que te temen, que has obrado para los que esperan en ti, delante de los hijos de los hombres!", "words": [[0, 142883], [6, 143226], [13, 143726], [16, 143986], [19, 144086], [25, 144866], [29, 145106], [33, 145286], [42, 145946], [47, 146186], [51, 146386], [55, 146546], [58, 146706], [65, 147466], [69, 147886], [73, 148086], [80, 148606], [85, 148946], [89, 149166], [93, 149326], [101, 150046], [104, 150206], [108, 150546], [116, 151406], [119, 151566], [123, 151706], [129, 152066], [132, 152206], [136, 152326]]}, {"verse": 20, "start": 153523, "end": 163749, "text": "Los esconderás en el secreto de tu rostro de las arrogancias del hombre: los pondrás en un tabernáculo a cubierto de contención de lenguas.", "words": [[0, 153523], [4, 153668], [15, 154688], [18, 154868], [21, 155008], [29, 155608], [32, 155728], [35, 155888], [42, 156528], [45, 156668], [49, 157178], [61, 157688], [65, 157928], [73, 159151], [77, 159311], [85, 159831], [88, 160031], [91, 160191], [103, 160751], [105, 161311], [114, 161871], [117, 162031], [128, 162711], [131, 162891]]}, {"verse": 21, "start": 164199, "end": 170744, "text": "Bendito Jehová, porque ha hecho maravillosa su misericordia para conmigo en ciudad fuerte.", "words": [[0, 164199], [8, 164787], [16, 165587], [23, 165947], [26, 166147], [32, 166407], [44, 167547], [47, 167747], [60, 168727], [65, 168907], [73, 169487], [76, 169607], [83, 169907]]}, {"verse": 22, "start": 171194, "end": 180140, "text": "Y decía yo en mi premura: Cortado soy de delante de tus ojos: pero tú oíste la voz de mis ruegos, cuando a ti clamaba.", "words": [[0, 171194], [2, 171488], [8, 171868], [11, 172188], [14, 172308], [17, 172488], [26, 173951], [34, 174325], [38, 174698], [41, 174758], [49, 175278], [52, 175438], [56, 175578], [62, 176540], [67, 176684], [70, 176944], [76, 177424], [79, 177564], [83, 177764], [86, 177904], [90, 178024], [98, 178644], [105, 179124], [107, 179344], [110, 179775]]}, {"verse": 23, "start": 180590, "end": 188736, "text": "Amad a Jehová todos vosotros sus santos: a los fieles guarda Jehová, y paga abundantemente al que obra con soberbia.", "words": [[0, 180743], [5, 180929], [7, 181116], [14, 181656], [20, 181816], [29, 182339], [33, 182863], [41, 183609], [43, 183829], [47, 183949], [54, 184369], [61, 184769], [69, 185389], [71, 185629], [76, 186069], [91, 187089], [94, 187269], [98, 187429], [103, 187709], [107, 187929]]}, {"verse": 24, "start": 189186, "end": 195219, "text": "Esforzaos todos vosotros los que esperáis en Jehová, y tome vuestro corazón aliento.", "words": [[0, 189558], [10, 189968], [16, 190328], [25, 191008], [29, 191228], [33, 191408], [42, 191888], [45, 192048], [53, 192888], [55, 193068], [60, 193508], [68, 193968], [76, 194368]]}]}