{"book": "ROM", "chapter": 9, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 222997, "verses": [{"verse": 1, "start": 300, "end": 5732, "text": "I say the truth in Christ, I lie not, my conscience also bearing me witness in the Holy Spirit,", "words": [[0, 300], [2, 440], [6, 640], [10, 800], [16, 1060], [19, 1240], [27, 1940], [29, 2060], [33, 2240], [38, 2880], [41, 3060], [52, 3420], [57, 3840], [65, 4200], [68, 4400], [76, 4640], [79, 4880], [83, 4980], [88, 5140]]}, {"verse": 2, "start": 6182, "end": 9540, "text": "That I have great heaviness and continual sorrow in my heart.", "words": [[0, 6182], [5, 6284], [7, 6424], [12, 6624], [18, 6904], [28, 7364], [32, 7584], [42, 8144], [49, 8544], [52, 8924], [55, 9084]]}, {"verse": 3, "start": 9990, "end": 15409, "text": "For I could wish that myself were accursed from Christ for my brethren, my kinsmen according to the flesh:", "words": [[0, 9990], [4, 10087], [6, 10227], [12, 10407], [17, 10727], [22, 10907], [29, 11347], [34, 11607], [43, 12067], [48, 12307], [55, 12667], [59, 12927], [62, 13087], [72, 13787], [75, 13907], [83, 14367], [93, 14607], [96, 14847], [100, 14927]]}, {"verse": 4, "start": 15859, "end": 24394, "text": "Who are Israelites; to whom pertains the adoption, and the glory, and the covenants, and the giving of the law, and the service of God, and the promises;", "words": [[0, 15859], [4, 16012], [8, 16152], [20, 17406], [23, 17501], [28, 17641], [37, 18041], [41, 18161], [51, 18601], [55, 19201], [59, 19301], [66, 19641], [70, 20081], [74, 20181], [85, 20721], [89, 21081], [93, 21201], [100, 21381], [103, 21561], [107, 21661], [112, 21961], [116, 22341], [120, 22461], [128, 22681], [131, 22901], [136, 23181], [140, 23581], [144, 23681]]}, {"verse": 5, "start": 24844, "end": 31581, "text": "Whose are the fathers, and of whom as concerning the flesh Christ came, who is over all, God blessed for ever. Amen.", "words": [[0, 24844], [6, 25008], [10, 25168], [14, 25308], [23, 25608], [27, 26148], [30, 26268], [35, 26468], [38, 26688], [49, 27088], [53, 27268], [59, 27488], [66, 27708], [72, 28568], [76, 28628], [79, 28815], [84, 29001], [89, 29188], [93, 29888], [101, 30221], [105, 30555], [111, 31141]]}, {"verse": 6, "start": 32031, "end": 37459, "text": "Not as though the word of God has taken none effect. For they are not all Israel, which are of Israel:", "words": [[0, 32031], [4, 32191], [7, 32351], [14, 32471], [18, 32591], [23, 32771], [26, 32891], [30, 33111], [34, 33291], [40, 33531], [45, 33791], [53, 34615], [57, 34736], [62, 34936], [66, 35056], [70, 35256], [74, 35576], [82, 36276], [88, 36416], [92, 36616], [95, 36856]]}, {"verse": 7, "start": 37909, "end": 44108, "text": "Neither, because they are the seed of Abraham, are they all children: but, In Isaac shall your seed be called.", "words": [[0, 37909], [9, 38428], [17, 38668], [22, 38908], [26, 38988], [30, 39108], [35, 39348], [38, 39488], [47, 40088], [51, 40148], [56, 40308], [60, 40448], [70, 41376], [75, 42062], [78, 42228], [84, 42608], [90, 42928], [95, 43088], [100, 43368], [103, 43568]]}, {"verse": 8, "start": 44655, "end": 51879, "text": "That is, They which are the children of the flesh, these are not the children of God: but the children of the promise are counted for the seed.", "words": [[0, 44655], [5, 44843], [9, 45003], [14, 45183], [20, 45383], [24, 45543], [28, 45663], [37, 46023], [40, 46243], [44, 46343], [51, 46963], [57, 47343], [61, 47523], [65, 47723], [69, 47923], [78, 48203], [81, 48363], [86, 49117], [90, 49214], [94, 49334], [103, 49674], [106, 49854], [110, 49954], [118, 50294], [122, 50614], [130, 51034], [134, 51294], [138, 51414]]}, {"verse": 9, "start": 52329, "end": 57710, "text": "For this is the word of promise, At this time will I come, and Sara shall have a son.", "words": [[0, 52329], [4, 52450], [9, 52850], [12, 53230], [16, 53370], [21, 53630], [24, 53770], [33, 54647], [36, 54770], [41, 54970], [46, 55250], [51, 55430], [53, 55570], [59, 56110], [63, 56340], [68, 56570], [74, 56810], [79, 57030], [81, 57110]]}, {"verse": 10, "start": 58230, "end": 64016, "text": "And not only this; but when Rebecca also had conceived by one, even by our father Isaac;", "words": [[0, 58230], [4, 58350], [8, 58490], [13, 58670], [19, 59537], [23, 59666], [28, 59846], [36, 60266], [41, 60806], [45, 61086], [55, 61506], [58, 61786], [63, 62406], [68, 62706], [71, 62966], [75, 63086], [82, 63386]]}, {"verse": 11, "start": 64466, "end": 74181, "text": "(For the children being not yet born, neither having done any good or evil, that the purpose of God according to election might stand, not of works, but of him that calls;)", "words": [[0, 64466], [5, 64561], [9, 64681], [18, 65001], [24, 65281], [28, 65521], [32, 65721], [38, 66401], [46, 66641], [53, 66941], [58, 67241], [62, 67601], [67, 67841], [70, 68041], [76, 68801], [81, 68961], [85, 69101], [93, 69441], [96, 69681], [100, 69881], [110, 70201], [113, 70421], [122, 70761], [128, 71041], [135, 71881], [139, 71981], [142, 72141], [149, 72959], [153, 73067], [156, 73187], [160, 73387], [165, 73607]]}, {"verse": 12, "start": 74631, "end": 78786, "text": "It was said to her, The elder shall serve the younger.", "words": [[0, 74631], [3, 74741], [7, 74901], [12, 75201], [15, 75381], [20, 75970], [24, 76056], [30, 76356], [36, 76696], [42, 77016], [46, 77196]]}, {"verse": 13, "start": 79370, "end": 83418, "text": "As it is written, Jacob have I loved, but Esau have I hated.", "words": [[0, 79370], [3, 79591], [6, 79731], [9, 79871], [18, 80730], [24, 80958], [29, 81158], [31, 81278], [38, 81958], [42, 82038], [47, 82558], [52, 82738], [54, 82878]]}, {"verse": 14, "start": 83941, "end": 88333, "text": "What shall we say then? Is there unrighteousness with God? God forbid.", "words": [[0, 83941], [5, 84079], [11, 84259], [14, 84399], [18, 84619], [24, 85368], [27, 85499], [33, 85669], [49, 86549], [54, 86749], [59, 87522], [63, 87765]]}, {"verse": 15, "start": 88783, "end": 95873, "text": "For he says to Moses, I will have mercy on whom I will have mercy, and I will have compassion on whom I will have compassion.", "words": [[0, 88783], [4, 88894], [7, 89034], [12, 89254], [15, 89454], [22, 90285], [24, 90433], [29, 90573], [34, 90753], [40, 91153], [43, 91493], [48, 91693], [50, 91873], [55, 92013], [60, 92173], [67, 93033], [71, 93113], [73, 93253], [78, 93373], [83, 93513], [94, 94013], [97, 94293], [102, 94513], [104, 94713], [109, 94853], [114, 95493]]}, {"verse": 16, "start": 96405, "end": 100999, "text": "So then it is not of him that wills, nor of him that runs, but of God that shows mercy.", "words": [[0, 96405], [3, 96501], [8, 96661], [11, 96741], [14, 96881], [18, 97041], [21, 97181], [25, 97361], [30, 97601], [37, 97961], [41, 98321], [44, 98481], [48, 98581], [53, 98781], [59, 99461], [63, 99581], [66, 99701], [70, 99921], [75, 100121], [81, 100341]]}, {"verse": 17, "start": 101449, "end": 110192, "text": "For the scripture says to Pharaoh, Even for this same purpose have I raised you up, that I might show my power in you, and that my name might be declared throughout all the earth.", "words": [[0, 101449], [4, 101542], [8, 101622], [18, 101882], [23, 102142], [26, 102282], [35, 103067], [40, 103292], [44, 103452], [49, 103612], [54, 103952], [62, 104332], [67, 104532], [69, 104652], [76, 104932], [80, 105112], [84, 105672], [89, 105832], [91, 105952], [97, 106132], [102, 106372], [105, 106552], [111, 106852], [114, 107112], [119, 107592], [123, 107732], [128, 107872], [131, 108012], [136, 108252], [142, 108472], [145, 108612], [154, 109012], [165, 109332], [169, 109672], [173, 109832]]}, {"verse": 18, "start": 110776, "end": 115648, "text": "Therefore has he mercy on whom he will have mercy, and whom he will he hardens.", "words": [[0, 110776], [10, 111293], [14, 111453], [17, 111613], [23, 111993], [26, 112373], [31, 112613], [34, 112813], [39, 112973], [44, 113133], [51, 113513], [55, 114053], [60, 114293], [63, 114533], [68, 114733], [71, 114953]]}, {"verse": 19, "start": 116098, "end": 121041, "text": "You will say then to me, Why does he yet find fault? For who has resisted his will?", "words": [[0, 116098], [4, 116216], [9, 116336], [13, 116536], [18, 116716], [21, 116916], [25, 117396], [29, 117676], [34, 117956], [37, 118176], [41, 118336], [46, 118556], [53, 119415], [57, 119545], [61, 119705], [65, 119905], [74, 120485], [78, 120605]]}, {"verse": 20, "start": 121491, "end": 128813, "text": "No but, O man, who are you that reply against God? Shall the thing formed say to him that formed it, Why have you made me thus?", "words": [[0, 121570], [3, 121650], [8, 121830], [10, 122010], [15, 122710], [19, 122850], [23, 122990], [27, 123170], [32, 123350], [38, 123710], [46, 124030], [51, 124856], [57, 125073], [61, 125273], [67, 125533], [74, 125793], [78, 126073], [81, 126233], [85, 126393], [90, 126553], [97, 126853], [101, 127253], [105, 127513], [110, 127773], [114, 127893], [119, 128153], [122, 128293]]}, {"verse": 21, "start": 129263, "end": 135395, "text": "Has not the potter power over the clay, of the same lump to make one vessel to honour, and another to dishonour?", "words": [[0, 129339], [4, 129429], [8, 129629], [12, 129849], [19, 130069], [25, 130509], [30, 130829], [34, 131009], [40, 131209], [43, 131629], [47, 131769], [52, 132069], [57, 132369], [60, 132589], [65, 132809], [69, 133089], [76, 133409], [79, 133649], [87, 133889], [91, 134289], [99, 134609], [102, 135024]]}, {"verse": 22, "start": 135845, "end": 142625, "text": "What if God, willing to show his wrath, and to make his power known, endured with much longsuffering the vessels of wrath fitted to destruction:", "words": [[0, 135845], [5, 135988], [8, 136088], [13, 136288], [21, 136528], [24, 136728], [29, 136928], [33, 137048], [40, 137708], [44, 137928], [47, 138048], [52, 138208], [56, 138348], [62, 138608], [69, 139188], [77, 139408], [82, 139668], [87, 139948], [101, 140588], [105, 140748], [113, 141008], [116, 141268], [122, 141508], [129, 141748], [132, 141928]]}, {"verse": 23, "start": 143075, "end": 149325, "text": "And that he might make known the riches of his glory on the vessels of mercy, which he had before prepared to glory,", "words": [[0, 143075], [4, 143192], [9, 143292], [12, 143412], [18, 143632], [23, 143932], [29, 144272], [33, 144552], [40, 144932], [43, 145192], [47, 145332], [53, 145712], [56, 145952], [60, 146072], [68, 146352], [71, 146572], [78, 146892], [84, 147472], [87, 147652], [91, 147912], [98, 148172], [107, 148672], [110, 148852]]}, {"verse": 24, "start": 149775, "end": 154210, "text": "Even us, whom he has called, not of the Jews only, but also of the Gentiles?", "words": [[0, 149775], [5, 150036], [9, 150336], [14, 150496], [17, 150636], [21, 150756], [29, 151356], [33, 151516], [36, 151656], [40, 151756], [45, 151976], [51, 152756], [55, 152956], [60, 153216], [63, 153356], [67, 153456]]}, {"verse": 25, "start": 154660, "end": 162215, "text": "As he says also in Osee, I will call them my people, which were not my people; and her beloved, which was not beloved.", "words": [[0, 154660], [3, 154804], [6, 154924], [11, 155144], [16, 155464], [19, 155844], [25, 156480], [27, 156603], [32, 156743], [37, 157003], [42, 157203], [45, 157383], [53, 158103], [59, 158223], [64, 158403], [68, 158643], [71, 158883], [79, 160010], [83, 160135], [87, 160275], [96, 161015], [102, 161135], [106, 161295], [110, 161535]]}, {"verse": 26, "start": 162742, "end": 171247, "text": "And it shall come to pass, that in the place where it was said to them, You are not my people; there shall they be called the children of the living God.", "words": [[0, 162742], [4, 162922], [7, 163082], [13, 163302], [18, 163582], [21, 163742], [27, 164322], [32, 164562], [35, 164702], [39, 164822], [45, 165142], [51, 165442], [54, 165562], [58, 165722], [63, 165922], [66, 166082], [72, 166651], [76, 166788], [80, 166888], [84, 167088], [87, 167328], [95, 168409], [101, 168605], [107, 168845], [112, 169025], [115, 169165], [122, 169425], [126, 169665], [135, 170045], [138, 170365], [142, 170505], [149, 170725]]}, {"verse": 27, "start": 171697, "end": 178966, "text": "Esaias also cries concerning Israel, Though the number of the children of Israel be as the sand of the sea, a remnant shall be saved:", "words": [[0, 171697], [7, 172256], [12, 172616], [18, 172936], [29, 173516], [37, 174356], [44, 174536], [48, 174676], [55, 174916], [58, 175096], [62, 175196], [71, 175536], [74, 175736], [81, 176056], [84, 176236], [87, 176356], [91, 176496], [96, 176716], [99, 176856], [103, 176956], [108, 177306], [110, 177656], [118, 178036], [124, 178356], [127, 178516]]}, {"verse": 28, "start": 179416, "end": 185142, "text": "For he will finish the work, and cut it short in righteousness: because a short work will the Lord make upon the earth.", "words": [[0, 179416], [4, 179540], [7, 179720], [12, 179900], [19, 180160], [23, 180380], [29, 180640], [33, 181000], [37, 181240], [40, 181380], [46, 181580], [49, 181720], [64, 182745], [72, 182948], [74, 183108], [80, 183288], [85, 183608], [90, 183828], [94, 183988], [99, 184188], [104, 184448], [109, 184708], [113, 184928]]}, {"verse": 29, "start": 185592, "end": 193080, "text": "And as Esaias said before, Unless the Lord of Sabaoth had left us a seed, we had been as Sodoma, and been made like to Gomorrha.", "words": [[0, 185592], [4, 185737], [7, 186007], [14, 186277], [19, 186597], [27, 187357], [34, 187637], [38, 187857], [43, 188017], [46, 188157], [54, 188657], [58, 188777], [63, 188997], [66, 189157], [68, 189257], [74, 189937], [77, 190037], [81, 190257], [86, 190597], [89, 190937], [97, 191277], [101, 191717], [106, 191897], [111, 192157], [116, 192377], [119, 192757]]}, {"verse": 30, "start": 193530, "end": 201375, "text": "What shall we say then? That the Gentiles, which followed not after righteousness, have attained to righteousness, even the righteousness which is of faith.", "words": [[0, 193530], [5, 193709], [11, 193909], [14, 194049], [18, 194269], [24, 194987], [29, 195161], [33, 195301], [43, 195781], [49, 196001], [58, 196661], [62, 196921], [68, 197241], [83, 198221], [88, 198361], [97, 198661], [100, 198861], [115, 199741], [120, 199901], [124, 200061], [138, 200441], [144, 200821], [147, 200961], [150, 201061]]}, {"verse": 31, "start": 201825, "end": 206654, "text": "But Israel, which followed after the law of righteousness, has not attained to the law of righteousness.", "words": [[0, 201825], [4, 201944], [12, 202304], [18, 202644], [27, 202964], [33, 203384], [37, 203564], [41, 203744], [44, 203864], [59, 204284], [63, 204824], [67, 205044], [76, 205404], [79, 205604], [83, 205724], [87, 205884], [90, 206004]]}, {"verse": 32, "start": 207104, "end": 213911, "text": "Why? Because they sought it not by faith, but as it were by the works of the law. For they stumbled at that stumblingstone;", "words": [[0, 207104], [5, 207761], [13, 207994], [18, 208194], [25, 208474], [28, 208594], [32, 208734], [35, 208954], [42, 209294], [46, 209734], [49, 209974], [52, 210094], [57, 210274], [60, 210434], [64, 210574], [70, 210794], [73, 210974], [77, 211074], [82, 211747], [86, 211840], [91, 212020], [100, 212460], [103, 212840], [108, 213400]]}, {"verse": 33, "start": 214361, "end": 222374, "text": "As it is written, Behold, I lay in Sion a stumblingstone and rock of offence: and whoever believes on him shall not be ashamed.", "words": [[0, 214361], [3, 214523], [6, 214643], [9, 214763], [18, 215551], [26, 216015], [28, 216095], [32, 216275], [35, 216535], [40, 216795], [42, 217285], [57, 217775], [61, 218015], [66, 218315], [69, 218750], [78, 219720], [82, 219824], [90, 220084], [99, 220544], [102, 220824], [106, 221004], [112, 221264], [116, 221484], [119, 221684]]}]}