{"book": "GEN", "chapter": 20, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 160294, "verses": [{"verse": 1, "start": 300, "end": 7986, "text": "And Abraham journeyed from there toward the south country, and dwelled between Kadesh and Shur, and sojourned in Gerar.", "words": [[0, 300], [4, 448], [12, 868], [22, 1528], [27, 1708], [33, 2008], [40, 2328], [44, 2568], [50, 2808], [59, 3868], [63, 3948], [71, 4268], [79, 4568], [86, 5088], [90, 5388], [96, 6248], [100, 6468], [110, 7248], [113, 7655]]}, {"verse": 2, "start": 8436, "end": 15816, "text": "And Abraham said of Sarah his wife, She is my sister: and Abimelech king of Gerar sent, and took Sarah.", "words": [[0, 8436], [4, 8559], [12, 8979], [17, 9379], [20, 9539], [26, 9840], [30, 10080], [36, 10892], [40, 11056], [43, 11216], [46, 11356], [54, 12222], [58, 12694], [68, 13194], [73, 13494], [76, 13904], [82, 14314], [88, 14534], [92, 14974], [97, 15174]]}, {"verse": 3, "start": 16266, "end": 26421, "text": "But God came to Abimelech in a dream by night, and said to him, Behold, you are but a dead man, for the woman which you have taken; for she is a man’s wife.", "words": [[0, 16266], [4, 16389], [8, 16669], [13, 16969], [16, 17169], [26, 17829], [29, 17909], [31, 18029], [37, 18329], [40, 18609], [47, 19249], [51, 19309], [56, 19569], [59, 19809], [64, 20420], [72, 20730], [76, 21030], [80, 21230], [84, 21410], [86, 21530], [91, 21710], [96, 22550], [100, 22830], [104, 22930], [110, 23170], [116, 23410], [120, 23570], [125, 23710], [132, 24859], [136, 24957], [140, 25157], [143, 25277], [145, 25377], [151, 25717]]}, {"verse": 4, "start": 26771, "end": 32299, "text": "But Abimelech had not come near her: and he said, Lord, will you slay also a righteous nation?", "words": [[0, 26771], [4, 27188], [14, 27638], [18, 27738], [22, 27898], [27, 28138], [32, 28398], [37, 29018], [41, 29164], [44, 29244], [50, 29937], [56, 30336], [61, 30416], [65, 30536], [70, 30896], [75, 31046], [77, 31196], [87, 31616]]}, {"verse": 5, "start": 32749, "end": 40916, "text": "Said he not to me, She is my sister? and she, even she herself said, He is my brother: in the integrity of my heart and innocency of my hands have I done this.", "words": [[0, 32749], [5, 32949], [8, 33089], [12, 33249], [15, 33409], [19, 33689], [23, 33809], [26, 33949], [29, 34089], [37, 34912], [41, 35037], [46, 35197], [51, 35477], [55, 35677], [63, 36037], [69, 36497], [72, 36657], [75, 36777], [78, 36937], [87, 37628], [90, 37745], [94, 37825], [104, 38225], [107, 38485], [110, 38605], [116, 38865], [120, 39225], [130, 39585], [133, 39685], [136, 39785], [142, 40065], [147, 40205], [149, 40285], [154, 40485]]}, {"verse": 6, "start": 41266, "end": 51306, "text": "And God said to him in a dream, Yes, I know that you did this in the integrity of your heart; for I also withheld you from sinning against me: therefore I did not let you touch her.", "words": [[0, 41266], [4, 41400], [8, 41660], [13, 41980], [16, 42220], [20, 42400], [23, 42580], [25, 42700], [32, 43634], [37, 43940], [39, 43980], [44, 44140], [49, 44280], [53, 44420], [57, 44560], [62, 44760], [65, 44900], [69, 44980], [79, 45340], [82, 45580], [87, 45680], [94, 46692], [98, 46788], [100, 46928], [105, 47188], [114, 47568], [118, 47688], [123, 47848], [131, 48248], [139, 48508], [143, 49507], [153, 49908], [155, 49988], [159, 50088], [163, 50228], [167, 50408], [171, 50488], [177, 50728]]}, {"verse": 7, "start": 51756, "end": 63890, "text": "Now therefore restore the man his wife; for he is a prophet, and he shall pray for you, and you shall live: and if you restore her not, know that you shall surely die, you, and all that are yours.", "words": [[0, 51756], [4, 51910], [14, 52370], [22, 52770], [26, 53050], [30, 53270], [34, 53490], [40, 54505], [44, 54608], [47, 54748], [50, 54888], [52, 54968], [61, 55608], [65, 55748], [68, 55828], [74, 55988], [79, 56248], [83, 56448], [88, 56788], [92, 56888], [96, 57008], [102, 57168], [108, 58131], [112, 58247], [115, 58387], [119, 58527], [127, 58947], [131, 59087], [136, 59827], [141, 60107], [146, 60327], [150, 60427], [156, 60607], [163, 60907], [168, 61647], [173, 62367], [177, 62488], [181, 62727], [186, 62887], [190, 63007]]}, {"verse": 8, "start": 64240, "end": 73451, "text": "Therefore Abimelech rose early in the morning, and called all his servants, and told all these things in their ears: and the men were greatly afraid.", "words": [[0, 64240], [10, 64830], [20, 65440], [25, 65720], [31, 66200], [34, 66400], [38, 66480], [47, 67320], [51, 67380], [58, 67680], [62, 68040], [66, 68240], [76, 69160], [80, 69240], [85, 69480], [89, 69820], [95, 70020], [102, 70380], [105, 70600], [111, 70760], [117, 71695], [121, 71839], [125, 71939], [129, 72119], [134, 72319], [142, 72679]]}, {"verse": 9, "start": 73901, "end": 85910, "text": "Then Abimelech called Abraham, and said to him, What have you done to us? and what have I offended you, that you have brought on me and on my kingdom a great sin? you have done deeds to me that ought not to be done.", "words": [[0, 73901], [5, 74083], [15, 74803], [22, 75143], [31, 75723], [35, 76183], [40, 76423], [43, 76643], [48, 77309], [53, 77430], [58, 77550], [62, 77650], [67, 77850], [70, 78030], [74, 78744], [78, 78968], [83, 79168], [88, 79308], [90, 79448], [99, 79788], [104, 80088], [109, 80548], [113, 80708], [118, 80808], [126, 81008], [129, 81188], [132, 81388], [136, 81708], [139, 81848], [142, 82008], [150, 82268], [152, 82548], [158, 82788], [163, 83569], [167, 83663], [172, 83783], [177, 83983], [183, 84203], [186, 84443], [189, 84563], [194, 84723], [200, 85023], [204, 85263], [207, 85463], [210, 85563]]}, {"verse": 10, "start": 86260, "end": 90624, "text": "And Abimelech said to Abraham, What did you see, that you have done this thing?", "words": [[0, 86260], [4, 86423], [14, 87123], [19, 87303], [22, 87523], [31, 88415], [36, 88561], [40, 88721], [44, 88841], [49, 89121], [54, 89521], [58, 89681], [63, 89861], [68, 90061], [73, 90261]]}, {"verse": 11, "start": 90974, "end": 97570, "text": "And Abraham said, Because I thought, Surely the fear of God is not in this place; and they will slay me for my wife’s sake.", "words": [[0, 90974], [4, 91114], [12, 91534], [18, 92396], [26, 92629], [28, 92809], [37, 93049], [44, 93449], [48, 93629], [53, 93889], [56, 94009], [60, 94249], [63, 94409], [67, 94609], [70, 94749], [75, 94969], [82, 95739], [86, 95865], [91, 95985], [96, 96125], [101, 96465], [104, 96545], [108, 96725], [111, 96885], [118, 97245]]}, {"verse": 12, "start": 98020, "end": 105058, "text": "And yet indeed she is my sister; she is the daughter of my father, but not the daughter of my mother; and she became my wife.", "words": [[0, 98020], [4, 98142], [8, 98402], [15, 98782], [19, 98902], [22, 99002], [25, 99162], [33, 100024], [37, 100180], [40, 100320], [44, 100460], [53, 100760], [56, 100960], [59, 101100], [67, 101720], [71, 102020], [75, 102300], [79, 102520], [88, 102820], [91, 103000], [94, 103140], [102, 103835], [106, 103958], [110, 104078], [117, 104378], [120, 104678]]}, {"verse": 13, "start": 105508, "end": 116755, "text": "And it came to pass, when God caused me to wander from my father’s house, that I said to her, This is your kindness which you shall show to me; at every place where we shall come, say of me, He is my brother.", "words": [[0, 105508], [4, 105612], [7, 105732], [12, 105872], [15, 106032], [21, 106812], [26, 107032], [30, 107322], [37, 107612], [40, 107792], [43, 107992], [50, 108192], [55, 108392], [58, 108572], [67, 109012], [74, 109252], [79, 109732], [81, 109852], [86, 110052], [89, 110212], [94, 110392], [99, 110792], [102, 110972], [107, 111132], [116, 111512], [122, 111772], [126, 111892], [132, 112032], [137, 112212], [140, 112352], [144, 112924], [147, 113097], [153, 113277], [159, 113617], [165, 113817], [168, 113957], [174, 114117], [180, 114737], [184, 114917], [187, 115077], [191, 115717], [194, 115877], [197, 116117], [200, 116277]]}, {"verse": 14, "start": 117105, "end": 125974, "text": "And Abimelech took sheep, and oxen, and menservants, and womenservants, and gave them to Abraham, and restored him Sarah his wife.", "words": [[0, 117105], [4, 117269], [14, 117989], [19, 118149], [26, 119089], [30, 119189], [36, 120069], [40, 120529], [53, 120989], [57, 121509], [72, 122029], [76, 122389], [81, 122589], [86, 122829], [89, 122989], [98, 123989], [102, 124149], [111, 124569], [115, 124989], [121, 125269], [125, 125449]]}, {"verse": 15, "start": 126424, "end": 131410, "text": "And Abimelech said, Behold, my land is before you: dwell where it pleases you.", "words": [[0, 126424], [4, 126936], [14, 127486], [20, 128305], [28, 128751], [31, 128851], [36, 129131], [39, 129291], [46, 129591], [51, 130222], [57, 130487], [63, 130667], [66, 130807], [74, 131127]]}, {"verse": 16, "start": 131760, "end": 144185, "text": "And to Sarah he said, Behold, I have given your brother a thousand pieces of silver: behold, he is to you a covering of the eyes, to all that are with you, and with all other: thus she was reproved.", "words": [[0, 131760], [4, 131926], [7, 132066], [13, 132466], [16, 132546], [22, 134019], [30, 134593], [32, 134693], [37, 134853], [43, 135053], [48, 135253], [56, 135553], [58, 135813], [67, 136153], [74, 136493], [77, 136713], [85, 137543], [93, 138302], [96, 138422], [99, 138562], [102, 138702], [106, 138862], [108, 139042], [117, 139402], [120, 139602], [124, 139762], [130, 140042], [133, 140502], [137, 140682], [142, 140842], [146, 140942], [151, 141122], [156, 141342], [160, 141662], [165, 141842], [169, 142042], [176, 142671], [181, 142934], [185, 143274], [189, 143454]]}, {"verse": 17, "start": 144535, "end": 153245, "text": "¶ So Abraham prayed to God: and God healed Abimelech, and his wife, and his maidservants; and they bore children.", "words": [[2, 144535], [5, 144715], [13, 145195], [20, 145615], [23, 145835], [28, 146685], [32, 146847], [36, 147147], [43, 147547], [54, 148487], [58, 148827], [62, 148987], [68, 149347], [72, 149707], [76, 150264], [90, 151066], [94, 151213], [99, 151333], [104, 151553]]}, {"verse": 18, "start": 153695, "end": 159894, "text": "For the LORD had fast closed up all the wombs of the house of Abimelech, because of Sarah Abraham’s wife.", "words": [[0, 153695], [4, 153784], [8, 153904], [13, 154164], [17, 154384], [22, 154704], [29, 155064], [32, 155364], [36, 155584], [40, 155744], [46, 156224], [49, 156324], [53, 156444], [59, 156684], [62, 157134], [73, 157584], [81, 158064], [84, 158284], [90, 158604], [100, 159344]]}]}